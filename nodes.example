# ~/.mesh/nodes — node-local config (gitignored)
# Source by bootstrap.sh and mesh-* scripts at runtime.
# Copy to ~/.mesh/nodes and fill in YOUR values.
# Every variable has a safe default or is optional.

# ---- bootstrap ----
# MESH_PEER=""                  # IP of an existing mesh node to pull knowledge from (empty = first node)
# MESH_REPO_URL="https://github.com/genaforvena/lte-workstation"
# MESH_REPO="$HOME/lte-workstation"

# ---- tailscale ----
# TS_AUTHKEY=""                 # one-time auth key (optional; interactive login if empty)
# TS_TAGS="tag:lte-node"       # advertise tags

# ---- phone (body node) ----
# PHONE_IP=""                  # e.g. 100.64.0.3
# PHONE_USER="u0_a386"         # Termux SSH user
# PHONE_SSH_PORT=8022

# ---- nodes (mesh topology) ----
# Format: space-separated "label:user@ts-ip" entries on ONE line. "local" = this node (no IP).
# Read by mesh-peer-addr (resolution), mesh-verify, mesh-conn, mesh-organs, mesh-breath, etc.
# The genome carries NO hardcoded IPs — every node IP lives HERE, so the genome plants on any mesh.
# Example (generic CGNAT IPs — replace with YOUR nodes):
# MESH_NODES="laptop:local server:you@100.64.0.2 phone:u0_aXX@100.64.0.3 router:root@100.64.0.4"

# ---- VPN egress (scoped) — all node-local, read by mesh-fix-egress / vpn-health ----
# VPN_EGRESS_HOST=""               # Tailscale IP of the node offering VPN egress (e.g. 100.64.0.2)
# VPN_EGRESS_IFACE="wg-egress"     # WireGuard interface name
# VPN_SRC_CONF="$HOME/path/to/provider.conf"   # provider config (source of keys/endpoint)
# VPN_EGRESS_ADDR="10.x.x.x/32"    # this client's address on the VPN
# VPN_EGRESS_IP=""                 # expected egress public IP (informational verify only)

# ---- voice / audio ----
# BOSE_NODE=""                 # user@ip for Bose speaker output
# BOSE_DEV="plughw:1,0"       # ALSA device

# ---- genius-loci (ambient) ----
# GL_PHONE_IP=""               # phone IP for torch indicator
# GL_PHONE_USER="u0_a386"
# GL_VOICE_B_HOST=""           # second voice node IP

# ---- telegram watchdog ----
# TG_WATCHDOG_HOST=""          # node to check Telegram connectivity on

# ---- snapshot / gossip ----
# SNAP_PEER=""                 # neighbour to gossip scrollback to
# SNAP_USER="imozerov"
# SNAP_LINES=400
# SNAP_KEEP=5

# ---- heartbeat ----
# HB_PEER=""                   # neighbour to send heartbeat to
# HB_USER="imozerov"

# ---- reboot-survival ----
# MESH_VERIFY_SKIP=""          # space-separated labels NOT reboot-managed (released/hand-started
#                               nodes) — resolvable peers but skipped in mesh-verify (no false gap)
