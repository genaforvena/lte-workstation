#!/usr/bin/env bash
# mesh-lan-newdevice — security awareness: alert when a NEW/unknown device joins the home LAN.
#
# mesh-lan-presence shows who's on the LAN NOW; this is the stateful DELTA. It learns the known
# devices (a bounded MAC baseline, not a DB) and EDGE-TRIGGERS [lan-new-device] when an unseen MAC
# first appears — e.g. an unknown phone joining the WiFi while the operator is away = a real intrusion
# signal. Reads the always-on router's DHCP leases (Tailscale-independent, READ-ONLY). Same
# stateful-filter pattern as mesh-presence-delta, at the LAN level — it catches WiFi/wired devices
# BLE presence can't see. First run seeds the baseline silently (existing devices are KNOWN, not new).
#
#   mesh-lan-newdevice          poll; alert on a newly-seen device (seeds baseline silently on 1st run)
#   mesh-lan-newdevice --status list known devices + current leases
#   mesh-lan-newdevice --forget  reset the baseline (re-seed on next run)
#   mesh-lan-newdevice --niche   constructed-niche reading: how much of the sensed space the
#                                baseline has absorbed, and how much of it anything still corroborates
#   mesh-lan-newdevice --test   smoke test
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
ROUTER="${MESH_ROUTER:-$(mesh-peer-addr router 2>/dev/null || mesh-peer-addr GL-MT3000 2>/dev/null)}"
RUSER="${MESH_ROUTER_USER:-root}"
KNOWN="${MESH_LAN_KNOWN:-$HOME/.mesh/.lan-known-macs}"
UNCONFIRMED="${MESH_LAN_UNCONFIRMED:-$HOME/.mesh/.lan-unconfirmed}"
# The identity this sense keys on (a MAC) is not the identity it claims to watch (a HOST joining the
# LAN). A MAC-TRANSLATING PROXY collapses several hosts onto one address: an 802.11 station cannot
# bridge a second MAC, so VirtualBox rewrites a bridged VM's frames to the host NIC's MAC. Measured on
# mesh-home 2026-07-15: 192.168.8.214 (iMac) and 192.168.8.242 (ilya's VM) are TWO reachable hosts with
# DIFFERENT sshd banners behind ONE Apple MAC 7c:c3:a1:a5:20:d7 — and the baseline held 7 entries for 9
# lease rows, so the VM was already INSIDE a baseline it could never move: structurally un-alertable,
# forever, in an INTRUSION sense (chat-review/lan-newdevice-baseline-keys-mac-only-so-proxied-hosts-are-invisible).
# So we ALSO baseline each MAC's host MULTIPLICITY (its rows here). Why multiplicity and not the (mac,ip)
# pair: pair-keying alerts on every DHCP re-lease (a known device routinely gets a new IP) — that turns a
# security sense into a noise source, which is very likely WHY it keys on MAC today. The discriminator is
# CONCURRENCY, and a count captures it exactly: a proxied host appears ALONGSIDE its neighbours in the same
# read (count GROWS); a re-lease moves one IP and the old one VANISHES in that same read (count HOLDS).
PAIRS="${MESH_LAN_KNOWN_PAIRS:-$HOME/.mesh/.lan-known-pairs}"
# THE BASELINE IS A CONSTRUCTED NICHE AND NOTHING DECAYS IT (niche-construction review 2026-08-29).
# Fogarty & Wade, "Niche construction in quantitative traits: heritability and response to selection",
# Proc R Soc B 289:20220401 (2022), eq. 3.1, write the constructed resource's contribution to the
# current phenotype as a sum over past generations discounted by mu^tau, with M1 = sum_{tau=1..n} mu^tau
# the cumulative weight of inherited environment. mu is the PERSISTENCE of what the organism built.
# In this organ mu = 1 EXACTLY and it is structural, not measured: --allow appends, a PROMOTE appends,
# and NO code path ever removes a single entry from $KNOWN (--forget is a total reset, which is an
# operator decision, not decay). So M1 grows without bound — every device this sense has ever decided
# to trust it still trusts, and the trusted set can only ever grow toward the whole LAN.
# WHY THAT MATTERS HERE AND NOT IN A GENERIC CACHE: this is an INTRUSION sense whose alarm is an EDGE.
# A baseline that only accumulates converges on silence, and silence is exactly what "no intrusion"
# looks like. The file already documents this failure on the SPACE axis (a proxied host was
# "structurally un-alertable, forever"); mu = 1 re-creates it on the TIME axis, where a device seen
# 30 times in April is still trusted in August with nothing corroborating it.
# The mesh rule one ring out is [[a-saturated-level-is-not-a-state]]: publish the two opposing RATES,
# never the level alone. Here v_dec is ZERO BY CONSTRUCTION, so residence time tau = N/v_dec is
# unbounded, and until --niche below nothing measured any of it. Fogarty & Wade add what that rule
# does not: with a heritable constructed environment the definitions of "normal" that COINCIDE
# without niche construction come apart (their h1/h2/h3), so the sense must say WHICH it means.
# "Known device" has three non-equivalent readings here and the code used only the first:
#   baselined      — in $KNOWN (what every decision in this file actually tests)
#   present        — in $KNOWN and in the current read
#   corroborated   — in $KNOWN and actually seen within the corroboration window
# --niche publishes all three plus the coverage that says whether the third is even answerable yet.
LASTSEEN="${MESH_LAN_LASTSEEN:-$HOME/.mesh/.lan-lastseen}"
NICHE_WINDOW_DAYS="${MESH_LAN_NICHE_WINDOW_DAYS:-14}"
# The liveness beat is a REAL artifact mesh-reflex-health ages (scripts/mesh-reflex-health:103). It MUST
# be overridable so --test can never touch the file a watchdog reads for liveness — a dry run that writes
# the liveness log forges the very evidence it exists to check (the mesh-guardian trap, 09f7914).
BEAT="${MESH_LAN_BEAT:-$HOME/.mesh/.lan-newdevice.beat}"
# --status is the path actually SCHEDULED (mesh-perimeter --edge calls it every 45m, read-only
# by design); the bare/default invocation below (the one that self-learns on first sight) has no
# cron entry of its own, so a device that only ever gets OBSERVED via --status never got promoted
# — proven live: MAC c0:18:85:47:10:78 (Huawei B570e) sat unbaselined 3+ weeks, re-firing
# mesh-perimeter's NETWORK=ALERT every 45m (chat-review/lan-newdevice-baseline-never-updated).
# So the promote-after-repeated-sightings logic below runs from --status too, not just the
# unscheduled default path.
# mesh-perimeter --edge (the only actual caller of --status) cadences ~45m -> ~32 runs/day;
# default RUNS gives the operator roughly a day of visibility on the board before auto-silencing,
# DAYS is the outer bound for a slower/irregular cadence.
PROMOTE_RUNS="${MESH_LAN_PROMOTE_RUNS:-30}"
PROMOTE_DAYS="${MESH_LAN_PROMOTE_DAYS:-3}"
SSH=(ssh -o BatchMode=yes -o ConnectTimeout=8 -o StrictHostKeyChecking=accept-new)

# A locally-administered MAC (bit 0x02 of the first octet) is a PRIVACY-RANDOMIZED address —
# iOS "Private Wi-Fi Address" / Android randomization rotate these, so a KNOWN phone keeps
# reappearing as a brand-new MAC. An unknown LAA address is therefore far more likely a
# return of a known device than a genuine intrusion → lower severity, so the security sense
# doesn't cry wolf every rotation. A globally-unique (OUI-registered) unknown MAC keeps the
# stronger wording. (Same insight as mesh-novelty excluding randomized BLE MACs.)
# record_seen LASTSEEN NOW LEASES — stamp every CURRENTLY-observed MAC with now, keep every other
# row untouched. This is the only new write on the hot path and it touches no file any decision reads:
# the ledger informs --niche and nothing else, so a corrupt or absent ledger can never change whether
# a device alerts. First line is "#born <epoch>" — the ledger's BIRTH, which mtime cannot give (mtime
# is the last write, i.e. the writer's heartbeat, not the age of the evidence). Without a birth stamp
# a young ledger's silence is indistinguishable from a device's absence, which is the whole trap this
# measurement exists to avoid reproducing.
record_seen(){
  local lf="$1" now="$2" leases="$3" tmp born lsrc
  [ -n "$lf" ] || return 0
  # A first run has no ledger, and awk over a missing file fails the whole pipeline under pipefail —
  # which would mean the ledger could never be CREATED, so coverage would stay unknown forever and
  # this measurement would be permanently, quietly inert.
  lsrc="$lf"; [ -f "$lsrc" ] || lsrc=/dev/null
  born="$(awk '/^#born /{print $2; exit}' "$lsrc" 2>/dev/null)"
  [ -n "${born:-}" ] || born="$now"
  tmp="$lf.tmp.$$"
  { printf '#born %s\n' "$born"
    # current sightings FIRST so the dedupe below keeps the freshest stamp for a MAC
    printf '%s\n' "$leases" | awk 'NF>=2 && $2 ~ /:/ {print tolower($2), "'"$now"'"}' | sort -u
    awk '/^#/{next} NF>=2{print tolower($1), $2}' "$lsrc" 2>/dev/null
  } | awk '/^#/{print; next} !seen[$1]++' > "$tmp" 2>/dev/null && mv "$tmp" "$lf"
}

# niche_measure KNOWN LASTSEEN WINDOW_DAYS NOW [LEASES] — the constructed-niche reading. PURE (reads
# only), so --test asserts every branch. Prints one "key=value ..." line.
#
# THE COVERAGE TERM IS NOT DECORATION. A baselined MAC with no ledger row is UNKNOWN, never stale:
# the ledger is a bounded history that starts empty, so before it has run a full window its silence
# is amnesia, not absence ([[absence-from-a-bounded-cache-is-unknown-never-down]]). Those MACs are
# counted in their OWN bucket (na=), never folded into inherited=, and while coverage is short of the
# window the verdict ABSTAINS rather than accusing the baseline of holding ghosts.
niche_measure(){
  local knownf="$1" lf="$2" wdays="$3" now="$4" leases="${5:-}"
  local n born age win cor inh na present state cov
  win=$(( wdays * 86400 ))
  local ksrc="$knownf"; [ -f "$ksrc" ] || ksrc=/dev/null
  n="$(awk 'NF{c++} END{print c+0}' "$ksrc" 2>/dev/null)"
  born="$(awk '/^#born /{print $2; exit}' "$lf" 2>/dev/null)"
  if [ -z "$born" ]; then
    age=0; cov="unknown(no-ledger)"
  else
    age=$(( now - born ))
    [ "$age" -ge "$win" ] && cov="full" || cov="partial:${age}s/${win}s"
  fi
  # A MISSING ledger must still yield na=<all baselined>, never a bare 0 for every bucket: awk
  # given a nonexistent file exits with no output, `read` then leaves all three empty, and the line
  # would print corroborated=0 inherited=0 na=0 for a baseline of 13 — three zeros that read as a
  # measurement and are actually the absence of one.
  local lsrc="$lf"; [ -f "$lsrc" ] || lsrc=/dev/null
  read -r cor inh na <<<"$(awk -v now="$now" -v win="$win" '
      FILENAME==ARGV[1] { if (!/^#/ && NF>=2) ts[tolower($1)]=$2; next }
      NF { m=tolower($1)
           if (!(m in ts))            { na++ }
           else if (now - ts[m] <= win) { cor++ }
           else                       { inh++ } }
      END { printf "%d %d %d", cor+0, inh+0, na+0 }' "$lsrc" "$ksrc" 2>/dev/null)"
  # NO LEASES SUPPLIED IS NOT present=0. --niche is a pure local read and is normally called with no
  # observation at all; printing 0 there states that none of the baselined devices is on the LAN,
  # which is a strong claim made out of an absent measurement. It renders na.
  present=na
  [ -n "$leases" ] && present="$(printf '%s\n' "$leases" \
    | awk -v K="$ksrc" 'BEGIN{while((getline l < K)>0){gsub(/[ \t\r]/,"",l); if(l!="") k[tolower(l)]=1}}
        NF>=2 && tolower($2) in k {p[tolower($2)]=1} END{print length(p)+0}' 2>/dev/null)"
  # v_dec is zero BY CONSTRUCTION, so it is stated with its reason and never as a measured zero that
  # a reader could mistake for a quiet interval.
  # THREE WORDS BECAUSE THERE ARE THREE REMEDIES, and na must never wear a clean one: a baselined MAC
  # the ledger has never seen is not evidence of a healthy niche, it is an entry nothing accounts for.
  #   UNKNOWN        — the ledger is younger than the window; wait, do not act
  #   RATCHETED      — >=1 entry is observed-ABSENT past the window; review those entries
  #   UNDER-OBSERVED — none stale, but >=1 entry has no observation at all since the ledger began
  #   CORROBORATED   — every baselined entry was actually seen inside the window
  if   [ "$cov" != full ];      then state="UNKNOWN"
  elif [ "${inh:-0}" -gt 0 ];   then state="RATCHETED"
  elif [ "${na:-0}" -gt 0 ];    then state="UNDER-OBSERVED"
  else                               state="CORROBORATED"
  fi
  printf 'state=%s baselined=%s present=%s corroborated=%s inherited=%s na=%s coverage=%s window=%sd mu=1.000 v_dec=0/day residence=unbounded' \
    "$state" "$n" "$present" "${cor:-0}" "${inh:-0}" "${na:-0}" "$cov" "$wdays"
}

is_laa() { local o="${1%%:*}"; [ -n "$o" ] && (( (16#$o & 2) != 0 )) 2>/dev/null; }

# Occupancy-gate the intrusion SEVERITY: a globally-unique unknown MAC is a very different signal
# depending on whether anyone is home. Read the household state at ALERT time and let it MODULATE the
# wording — AWAY (home unoccupied) escalates to a HIGH intrusion candidate; ASLEEP (everyone asleep,
# nobody plausibly adding a device) is elevated; ACTIVE (household awake, most likely the operator
# adding a device) de-escalates to a routine log; UNCERTAIN keeps the pre-existing default wording.
# FAIL-OPEN, honest-fusion ([[fusion-tools-distinguish-empty-from-failed]]): an unreachable/absent
# household sense → UNCERTAIN → current default, NEVER a faked all-clear that suppresses a real alert.
# The [lan-new-device] marker still fires in EVERY case (detection/vocab unchanged) — occupancy only
# contextualizes the severity, it never silently drops a new-device event (a genuine intrusion while
# the household is ACTIVE must still surface, just framed as lower-priority).
occupancy_state(){
  [ -n "${MESH_LAN_OCC_STATE:-}" ] && { printf '%s' "$MESH_LAN_OCC_STATE"; return; }   # test/override hook
  command -v mesh-household-state >/dev/null 2>&1 || { printf 'UNCERTAIN'; return; }
  local s
  s="$(mesh-household-state --json 2>/dev/null | sed -n 's/.*"state": *"\([^"]*\)".*/\1/p')"
  case "$s" in ACTIVE|ASLEEP|AWAY) printf '%s' "$s" ;; *) printf 'UNCERTAIN' ;; esac
}
# occ_render OCC HOST MAC IP SRCNOTE → the full [lan-new-device] message for a globally-unique new MAC,
# severity-worded by occupancy. Pure (no side effects) so --test can assert every branch deterministically.
occ_render(){
  local occ="$1" host="$2" mac="$3" ip="$4" sn="$5" sev ctx
  case "$occ" in
    AWAY)   sev="(HIGH — possible intrusion) "; ctx="home UNOCCUPIED (household=AWAY) — a new globally-unique device while nobody's home is a real intrusion candidate. Investigate." ;;
    ASLEEP) sev="(elevated) ";                  ctx="household ASLEEP — a new device joining while everyone's asleep is unusual; verify it's expected." ;;
    ACTIVE) sev="(routine) ";                   ctx="household ACTIVE (awake at home) — most likely an expected device being added; logged, not alarmed." ;;
    *)      sev="";                             ctx="globally-unique MAC, never seen before. If unexpected while you're away, investigate." ;;
  esac
  printf '[lan-new-device] %sNEW device on the home LAN: %s (%s, %s) — %s%s' \
    "$sev" "${host:-?}" "$mac" "${ip:-?}" "$ctx" "$sn"
}

# Convert `ip neigh` output → DHCP-lease-shaped lines ("0 <mac> <ip> ?") so the SAME baseline +
# alarm parser handles both sources. Finds the lladdr field (robust to column order).
# SCOPE FILTER (2026-09-02 flood): the ARP fallback reads the kernel neigh table, which also holds
# NON-LAN neighbours — when the router is down the route toward it resolves via the CGNAT uplink,
# so `ip neigh` fills with forwarded tailnet flows (measured: ONE MAC b0:8b:cf:1b:77:c0 with 141
# concurrent 100.74.205.x, posting 11 [lan-new-device] lines in 10 s). Those are forwarded flows,
# not LAN devices. Drop them here — plus link-local + multicast, never LAN members — so EVERY
# consumer of this population (both the --status and the default paths) stays silent on them instead
# of learning/flooding. DHCP-source leases are untouched: the router's own table is authoritative.
# (IPv6 link-local/multicast never reach the filter — the IPv4 regex below already drops them.)
neigh_to_leases(){ awk '{ mac=""; for(i=1;i<=NF;i++) if($i=="lladdr") mac=$(i+1);
    if(mac=="" || $1 !~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/) next;
    split($1, o, ".");
    if(o[1]==100 && o[2]>=64 && o[2]<=127) next;   # RFC6598/CGNAT 100.64/10
    if(o[1]==169 && o[2]==254) next;               # link-local 169.254/16
    if(o[1]>=224 && o[1]<=239) next;               # multicast 224.0.0.0/4
    print "0", tolower(mac), $1, "?" }'; }

# track_unconfirmed MAC KNOWN_FILE UNCONFIRMED_FILE NOW_EPOCH — for a currently-seen MAC that is
# NOT (yet) in the baseline: records/updates its sighting, and once it's been seen on
# PROMOTE_RUNS separate calls OR has persisted PROMOTE_DAYS since first sighting, promotes it
# (clears its tracking row, then appends to KNOWN_FILE) instead of leaving it to alert forever.
# Prints one of NEW / PERSISTENT / PROMOTED. Pure file I/O only (no mesh-chat) so --test is
# deterministic.
#
# THE ORDER OF THE TWO WRITES IS THE SECURITY PROPERTY, not a style choice (2026-08-21). A promote
# touches TWO files and cannot be atomic across them, and this function runs under a timeout that
# fires ROUTINELY on this node: mesh-perimeter --edge calls `timeout 30 mesh-lan-newdevice --status`
# and its own header records the budget kill landing on 19 of 40 log edges before it was raised.
# Append-then-purge commits TRUST FIRST, so a SIGTERM in the window between the two statements
# leaves the MAC permanently baselined, its tracking row orphaned, and the caller's
# [lan-baseline-promote] board post never reached — and it is UNRECOVERABLE, because the caller's
# loop `continue`s on any MAC already in KNOWN, so this function is never called for it again.
# That is not hypothetical: 78:8a:86:fc:48:16 sits in .lan-known-macs AND in .lan-unconfirmed at
# count=8 (first seen 2026-07-17T19:24:14Z) with zero lan-baseline-promote posts from this node in
# the durable board store — the promote branch's own signature is ABSENT on a MAC everyone assumed
# it had promoted. Purge-then-append inverts the failure: a tear drops the tracking row, the device
# re-enters as NEW next run, and it keeps ALERTING. A security baseline must fail CLOSED.
track_unconfirmed(){
  local mac="$1" knownf="$2" unconf="$3" now="$4" firstseen count age
  mac="$(printf '%s' "$mac" | tr 'A-F' 'a-f')"
  local row
  row="$(awk -v m="$mac" 'tolower($1)==m{f=$2; c=$3} END{if(f!="") print f, c}' "$unconf" 2>/dev/null)"
  if [ -z "$row" ]; then
    printf '%s %s 1\n' "$mac" "$now" >> "$unconf"
    printf 'NEW'; return
  fi
  firstseen="$(awk '{print $1}' <<<"$row")"; count="$(awk '{print $2}' <<<"$row")"
  count=$((count + 1)); age=$((now - firstseen))
  if [ "$count" -ge "$PROMOTE_RUNS" ] || [ "$age" -ge $((PROMOTE_DAYS * 86400)) ]; then
    awk -v m="$mac" 'tolower($1)!=m' "$unconf" 2>/dev/null > "$unconf.tmp"; mv "$unconf.tmp" "$unconf"
    grep -qixF "$mac" "$knownf" 2>/dev/null || echo "$mac" >> "$knownf"
    printf 'PROMOTED'; return
  fi
  { awk -v m="$mac" 'tolower($1)!=m' "$unconf" 2>/dev/null; printf '%s %s %s\n' "$mac" "$firstseen" "$count"; } > "$unconf.tmp"
  mv "$unconf.tmp" "$unconf"
  printf 'PERSISTENT'
}

# torn_promotes KNOWN_FILE UNCONFIRMED_FILE — a MAC in BOTH files is the SIGNATURE of a promote that
# was killed between its two writes (see the order note above). Prints one such MAC per line with its
# tracking row, newline-separated; silent when the two files are consistent. Pure (reads only), so
# --test asserts it deterministically and the CALLER owns the voice.
#
# Why a reconciler and not just the ordering fix: the ordering fix protects FUTURE promotes. It
# cannot undo a tear already on disk, and a torn MAC is exactly the one nobody will ever look at
# again — it reads as an ordinary baselined device. Healing is deliberately NOT a demotion: pulling
# a MAC back out of the baseline re-arms an alarm on a device nobody has identified, which is a
# decision for a human, not a side effect of a cleanup. This ANNOUNCES and clears the orphan row so
# the decision becomes possible; it never touches KNOWN_FILE.
torn_promotes(){
  local knownf="$1" unconf="$2"
  [ -f "$knownf" ] && [ -f "$unconf" ] || return 0
  awk 'NR==FNR{k[tolower($1)]=1; next} tolower($1) in k {print tolower($1), $2, $3}' "$knownf" "$unconf" 2>/dev/null
}

# heal_torn_promote MAC UNCONFIRMED_FILE — drop the orphan tracking row (KNOWN is left ALONE).
heal_torn_promote(){
  local mac unconf="$2"
  mac="$(printf '%s' "$1" | tr 'A-F' 'a-f')"
  [ -f "$unconf" ] || return 0
  awk -v m="$mac" 'tolower($1)!=m' "$unconf" 2>/dev/null > "$unconf.tmp" && mv "$unconf.tmp" "$unconf"
}

# classify_multiplicity MAC IP NCONCURRENT PAIRS_FILE → KNOWN | SEED | NEWHOST | REBIND
#   KNOWN   this exact (mac,ip) is already baselined — nothing to say.
#   SEED    first time we've tracked IPs for this MAC (incl. the MAC-only→pair migration) — learn silently.
#   NEWHOST the MAC presents MORE concurrent hosts than its baseline → a host arrived behind the proxy.
#   REBIND  an unbaselined IP, but the host count did NOT grow → the same host moved (DHCP re-lease/roam).
# The count comparison is the whole point (see PAIRS above): it fires on GROWTH, never on a MOVE. Pure
# (file read only, no side effects) so --test can assert every branch deterministically.
classify_multiplicity(){
  local mac ip nconc pf nbase
  mac="$(printf '%s' "$1" | tr 'A-F' 'a-f')"; ip="$2"; nconc="$3"; pf="$4"
  awk -v m="$mac" -v i="$ip" 'tolower($1)==m && $2==i{found=1} END{exit !found}' "$pf" 2>/dev/null \
    && { printf 'KNOWN'; return; }
  nbase="$(awk -v m="$mac" 'tolower($1)==m{n++} END{print n+0}' "$pf" 2>/dev/null)"
  [ "${nbase:-0}" -eq 0 ] && { printf 'SEED'; return; }
  [ "$nconc" -gt "$nbase" ] && { printf 'NEWHOST'; return; }
  printf 'REBIND'
}

# record_pair MAC IP PAIRS_FILE [replace] — learn a (mac,ip). `replace` drops the MAC's other rows
# (the REBIND case: the host MOVED, so its old IP must not linger and inflate the baseline count —
# a stale row would mask the next genuine arrival by making the count look already-grown).
record_pair(){
  local mac ip pf mode
  mac="$(printf '%s' "$1" | tr 'A-F' 'a-f')"; ip="$2"; pf="$3"; mode="${4:-add}"
  touch "$pf" 2>/dev/null || return 0
  if [ "$mode" = replace ]; then
    awk -v m="$mac" 'tolower($1)!=m' "$pf" > "$pf.tmp" 2>/dev/null && mv "$pf.tmp" "$pf"
  fi
  awk -v m="$mac" -v i="$ip" 'tolower($1)==m && $2==i{found=1} END{exit !found}' "$pf" 2>/dev/null \
    || printf '%s %s\n' "$mac" "$ip" >> "$pf"
}

# newhosts_aggregate_render COUNT LIST SRCNOTE → the SINGLE per-run [lan-new-device] board line
# for hosts found behind already-baselined MACs. ONE line per run no matter how many (mac,ip) pairs
# are new (2026-09-02: N new IPs behind one MAC posted N board lines in 10 s from inside the read
# loop; the run already accumulated the aggregate in newhost_out but printed it stdout-only). Keeps
# the [lan-new-device] marker + the proxy wording (mesh-newdevice-voice/mesh-awaydigest/mesh-digest
# match on the marker) but states the mechanism ONCE. Pure, so --test asserts it. (The single-host
# newhost_render below stays as the wording reference; the loop no longer posts per-host.)
newhosts_aggregate_render(){
  local n="$1" list="$2" sn="$3"
  printf '[lan-new-device] NEW HOST(S) behind an ALREADY-KNOWN MAC: %s new this run —%s One MAC carrying several hosts = a MAC-translating proxy (e.g. VirtualBox bridging a VM onto a Wi-Fi station, which cannot carry a second MAC), so MAC-keying alone could never see these hosts. NOT a DHCP re-lease: that moves an IP without growing the count. Verify these hosts are expected.%s' \
    "$n" "$list" "$sn"
}

# newhost_render MAC IP NCONC NBASE SRCNOTE → the [lan-new-device] message for a host found behind an
# already-baselined MAC. Keeps the established marker (it IS a new device on the LAN, and
# mesh-newdevice-voice/mesh-awaydigest already consume that vocab) but words the proxy mechanism, since
# "a MAC you already trust" reads as a contradiction without it. Pure, so --test asserts it.
newhost_render(){
  printf '[lan-new-device] NEW HOST behind an ALREADY-KNOWN MAC: %s now presents %s concurrent IPs (baseline %s); newest is %s. One MAC is carrying several hosts — a MAC-translating proxy (e.g. VirtualBox bridging a VM onto a Wi-Fi station, which cannot carry a second MAC), so MAC-keying alone could never see this host. NOT a DHCP re-lease: that moves an IP without growing the count. Verify this host is expected.%s' \
    "$1" "$3" "$4" "${2:-?}" "$5"
}

# LAN-side fallback observation (Tailscale-INDEPENDENT): when the router DHCP read fails (e.g. the
# router's Tailscale is offline — a recurring SPOF), observe the LAN from THIS node, which sits on it.
# A gentle ARP sweep makes LAN devices resolve, then `ip neigh` yields their MACs. Less authoritative
# than DHCP (no hostnames; only L2-reachable devices) — so callers label it + cap confidence — but the
# security sense is no longer BLIND whenever Tailscale to the router flaps (cf. egress-via-router-lan).
lan_arp_observe(){
  command -v ip >/dev/null 2>&1 || return 0
  local myip subnet i
  # Route toward the CONFIGURED router, not a literal. The hardcoded 192.168.8.1 here happened to be
  # this node's gateway, so it was invisible — but on any node with a different LAN the route lookup
  # falls through to the hostname -I guess, and where that guess picks a non-LAN private address
  # (docker0/tailscale-adjacent/second NIC) the sweep runs against the WRONG /24 and `ip neigh` yields
  # nothing. That is the silent-fallback shape: the sense returns empty, exits 0, and its beat freezes
  # forever while cron stays green — indistinguishable from a genuinely dark LAN. $ROUTER is the same
  # value the DHCP path above already trusts, so this is one source of truth, not a new dependency.
  myip="$(ip -4 route get "${ROUTER:-192.168.8.1}" 2>/dev/null | grep -oE 'src [0-9.]+' | awk '{print $2}')"
  [ -n "$myip" ] || myip="$(hostname -I 2>/dev/null | tr ' ' '\n' | grep -E '^(192\.168|10\.|172\.)' | head -1)"
  [ -n "$myip" ] || return 0
  subnet="${myip%.*}"
  # BOUND the active sweep with its OWN timeout so a slow/loaded sweep can never make the caller's
  # outer timeout kill this process BEFORE the `ip neigh` read below — that read is what yields the
  # leases and (upstream) refreshes the liveness beat, so a sweep truncated by the outer budget
  # would leave the beat STALE while the LAN is perfectly observable (the kernel neigh table is
  # already populated). Measured 2026-07-29: a ~10h beat-stale [reflex-stale] with presence +
  # gateway-identity co-frozen, root-caused to chronic user-slice OOM (14 memcg oom-kills/boot) —
  # under that pressure the 254-ping fork-storm is exactly what fails; the single `ip neigh` fork is
  # far likelier to survive, so reaching it unconditionally keeps the beat honest. The full sweep is
  # still attempted (detection completeness for a silent new device is unchanged) — only its runtime
  # is capped. A genuine no-LAN (no route → myip empty) already returned above, so honest staleness
  # when the sense truly can't observe is preserved.
  timeout "${MESH_LAN_ARP_SWEEP_S:-12}" bash -c \
    'for i in $(seq 1 254); do ping -c1 -W1 "'"$subnet"'.$i" >/dev/null 2>&1 & done; wait' 2>/dev/null
  ip neigh show 2>/dev/null | grep -F "$subnet." | neigh_to_leases | sort -u
}

if [ "${1:-}" = --test ]; then
  command -v ssh >/dev/null 2>&1 || { echo "smoke-test: FAIL (no ssh)"; exit 1; }
  command -v awk >/dev/null 2>&1 || { echo "smoke-test: FAIL (no awk)"; exit 1; }
  mkdir -p "$HOME/.mesh" 2>/dev/null || { echo "smoke-test: FAIL (no ~/.mesh)"; exit 1; }
  [ -n "$ROUTER" ] || { echo "smoke-test: n/a (no router in ~/.mesh/nodes — nothing to watch)"; exit 2; }
  # THE SUITE MUST NOT WRITE THE REAL LAST-SEEN LEDGER, and this snapshot is taken HERE — before any
  # arm runs — because the arms that drive the real script through run_status() come long before the
  # niche block. Placed with the niche arms it measured only its own section and passed while the
  # leak had already happened one screen up: a gate downstream of the thing it guards.
  # The leak is real and dated: on 2026-08-29 run_status() sandboxed KNOWN, PAIRS, UNCONFIRMED and
  # BEAT but not LASTSEEN, so this suite's fixture MACs — which are REAL LAN MACs, reused as
  # fixtures — landed in the live ledger, where --niche would have read them back as genuine
  # corroboration of devices nothing had observed. A state file added to a tool sits OUTSIDE
  # whatever override set the harness already carries and nothing announces the omission, so assert
  # the real path instead of trusting the list. [[a-new-state-file-is-outside-the-suites-sandbox-env]]
  _rl="$HOME/.mesh/.lan-lastseen"
  if [ -f "$_rl" ]; then _rlb="$(md5sum < "$_rl")"; else _rlb=absent; fi
  # neigh_to_leases: ip-neigh line → DHCP-lease shape ("0 <mac> <ip> ?") so the shared parser works
  r="$(printf '192.168.8.55 dev wlp0s20f3 lladdr AA:BB:CC:DD:EE:FF REACHABLE\n' | neigh_to_leases)"
  [ "$r" = "0 aa:bb:cc:dd:ee:ff 192.168.8.55 ?" ] || { echo "smoke-test: FAIL (neigh_to_leases: '$r')"; exit 1; }
  r="$(printf '192.168.8.1 dev eth0 FAILED\n' | neigh_to_leases)"   # no lladdr → dropped
  [ -z "$r" ] || { echo "smoke-test: FAIL (neigh_to_leases should drop no-lladdr: '$r')"; exit 1; }
  # SCOPE FILTER (2026-09-02 flood: 1 MAC, 141 CGNAT IPs → 11 board lines in 10 s) — non-LAN
  # neighbours are forwarded flows, not devices, and must never enter the host population.
  r="$(printf '100.74.205.17 dev enp42s0 lladdr B0:8B:CF:1B:77:C0 REACHABLE\n' | neigh_to_leases)"
  [ -z "$r" ] || { echo "smoke-test: FAIL (neigh_to_leases kept RFC6598 CGNAT: '$r')"; exit 1; }
  r="$(printf '100.127.9.9 dev enp42s0 lladdr b0:8b:cf:1b:77:c0 STALE\n' | neigh_to_leases)"
  [ -z "$r" ] || { echo "smoke-test: FAIL (neigh_to_leases kept CGNAT top edge 100.127.x: '$r')"; exit 1; }
  r="$(printf '169.254.5.6 dev enp42s0 lladdr aa:bb:cc:dd:ee:01 REACHABLE\n' | neigh_to_leases)"
  [ -z "$r" ] || { echo "smoke-test: FAIL (neigh_to_leases kept link-local: '$r')"; exit 1; }
  r="$(printf '224.0.0.251 dev enp42s0 lladdr 01:00:5e:00:00:fb REACHABLE\n' | neigh_to_leases)"
  [ -z "$r" ] || { echo "smoke-test: FAIL (neigh_to_leases kept multicast: '$r')"; exit 1; }
  r="$(printf '239.255.255.250 dev enp42s0 lladdr 01:00:5e:7f:ff:fa REACHABLE\n' | neigh_to_leases)"
  [ -z "$r" ] || { echo "smoke-test: FAIL (neigh_to_leases kept multicast top edge: '$r')"; exit 1; }
  r="$(printf '100.128.0.1 dev enp42s0 lladdr b0:8b:cf:1b:77:c0 REACHABLE\n' | neigh_to_leases)"
  [ "$r" = "0 b0:8b:cf:1b:77:c0 100.128.0.1 ?" ] || { echo "smoke-test: FAIL (neigh_to_leases dropped 100.128.x, just ABOVE the /10: '$r')"; exit 1; }
  r="$(printf '100.63.9.9 dev enp42s0 lladdr b0:8b:cf:1b:77:c0 REACHABLE\n' | neigh_to_leases)"
  [ "$r" = "0 b0:8b:cf:1b:77:c0 100.63.9.9 ?" ] || { echo "smoke-test: FAIL (neigh_to_leases dropped 100.63.x, just BELOW the /10: '$r')"; exit 1; }
  # aggregate render: ONE board line per run, marker + proxy wording kept, count + list carried
  m="$(newhosts_aggregate_render 2 ' aa:bb:cc:dd:ee:01 (192.168.8.9) [2 vs baseline 1]; aa:bb:cc:dd:ee:01 (192.168.8.10) [3 vs baseline 2];' '')"
  printf '%s' "$m" | grep -q '\[lan-new-device\]' || { echo "smoke-test: FAIL (aggregate lost the marker: '$m')"; exit 1; }
  printf '%s' "$m" | grep -q '2 new this run' || { echo "smoke-test: FAIL (aggregate lost the count: '$m')"; exit 1; }
  printf '%s' "$m" | grep -q '192.168.8.9.*192.168.8.10' || { echo "smoke-test: FAIL (aggregate lost a host: '$m')"; exit 1; }
  printf '%s' "$m" | grep -q 'behind an ALREADY-KNOWN MAC' || { echo "smoke-test: FAIL (aggregate lost the proxy wording: '$m')"; exit 1; }
  # occupancy-gated severity (additive): AWAY→HIGH, ASLEEP→elevated, ACTIVE→routine, UNCERTAIN→default
  m="$(occ_render AWAY host aa:bb:cc:dd:ee:ff 192.168.8.9 '')"
  printf '%s' "$m" | grep -q 'HIGH — possible intrusion' || { echo "smoke-test: FAIL (AWAY not HIGH: '$m')"; exit 1; }
  m="$(occ_render ASLEEP host aa:bb:cc:dd:ee:ff 192.168.8.9 '')"
  printf '%s' "$m" | grep -q 'elevated' || { echo "smoke-test: FAIL (ASLEEP not elevated: '$m')"; exit 1; }
  m="$(occ_render ACTIVE host aa:bb:cc:dd:ee:ff 192.168.8.9 '')"
  printf '%s' "$m" | grep -q 'routine' || { echo "smoke-test: FAIL (ACTIVE not routine: '$m')"; exit 1; }
  m="$(occ_render UNCERTAIN host aa:bb:cc:dd:ee:ff 192.168.8.9 '')"
  printf '%s' "$m" | grep -q 'If unexpected while' || { echo "smoke-test: FAIL (UNCERTAIN not default: '$m')"; exit 1; }
  # fail-open: no override + no household sense on PATH → UNCERTAIN, never a faked state
  s="$(PATH=/nonexistent occupancy_state)"
  [ "$s" = UNCERTAIN ] || { echo "smoke-test: FAIL (fail-open not UNCERTAIN: '$s')"; exit 1; }
  # persistent-unconfirmed promote: sandboxed tmp files, never the real baseline/tracking
  tmpd="$(mktemp -d)"; tk="$tmpd/known"; tu="$tmpd/unconf"; : > "$tk"; : > "$tu"
  v="$(track_unconfirmed aa:bb:cc:dd:ee:01 "$tk" "$tu" 1000)"
  [ "$v" = NEW ] || { echo "smoke-test: FAIL (1st sighting not NEW: '$v')"; exit 1; }
  v="$(track_unconfirmed aa:bb:cc:dd:ee:01 "$tk" "$tu" 1100)"
  [ "$v" = PERSISTENT ] || { echo "smoke-test: FAIL (2nd sighting, young+low-count, not PERSISTENT: '$v')"; exit 1; }
  grep -qixF aa:bb:cc:dd:ee:01 "$tk" && { echo "smoke-test: FAIL (PERSISTENT must not promote yet)"; exit 1; }
  # age-based promote: firstseen far enough in the past
  now=$(( $(awk '{print $2}' "$tu") + PROMOTE_DAYS * 86400 + 10 ))
  v="$(track_unconfirmed aa:bb:cc:dd:ee:01 "$tk" "$tu" "$now")"
  [ "$v" = PROMOTED ] || { echo "smoke-test: FAIL (aged-out sighting not PROMOTED: '$v')"; exit 1; }
  grep -qixF aa:bb:cc:dd:ee:01 "$tk" || { echo "smoke-test: FAIL (PROMOTED didn't append to baseline)"; exit 1; }
  grep -qi aa:bb:cc:dd:ee:01 "$tu" && { echo "smoke-test: FAIL (PROMOTED left a stale tracking row)"; exit 1; }
  # count-based promote (distinct mac): PROMOTE_RUNS calls, all fresh timestamps (no age trigger)
  mac2=aa:bb:cc:dd:ee:02; t=2000
  for _ in $(seq 1 "$PROMOTE_RUNS"); do v="$(track_unconfirmed "$mac2" "$tk" "$tu" "$t")"; t=$((t+1)); done
  [ "$v" = PROMOTED ] || { echo "smoke-test: FAIL (count threshold not PROMOTED: '$v')"; exit 1; }
  # ---- TORN PROMOTE: the promote is two writes under a timeout that fires; the ORDER decides which
  # way a tear fails, and the reconciler is the only thing that can see a tear already on disk. ----
  # (1) the write ORDER must be purge-then-append, so a kill between them fails CLOSED (device stays
  #     unbaselined and keeps alerting) instead of OPEN (silently trusted forever). Observe the REAL
  #     function: drive one promote and compare the two files' NANOSECOND mtimes. Re-running the two
  #     writes here by hand would be a gate that rebuilds its own subject and can never fail.
  tmpd2="$(mktemp -d)"; tk3="$tmpd2/known"; tu3="$tmpd2/unconf"; : > "$tk3"
  printf 'aa:bb:cc:dd:ee:04 1000 8\n' > "$tu3"
  # mtimes are NOT the observable here: measured on this fs the two writes land in the SAME
  # nanosecond bucket under the reverted order, so an mtime compare ties and passes — a gate that
  # cannot go red. Interpose on the two statements' EXTERNAL commands instead: the purge runs `mv`,
  # the append runs `grep`, so the recorded call order IS the write order, deterministically.
  _ob="$tmpd2/bin"; mkdir -p "$_ob"
  for _c in mv grep; do
    printf '#!/bin/sh\nprintf "%%s\\n" %s >> "$ORDERLOG"\nexec %s "$@"\n' "$_c" "$(command -v "$_c")" > "$_ob/$_c"
    chmod +x "$_ob/$_c"
  done
  ORDERLOG="$tmpd2/order"; : > "$ORDERLOG"; export ORDERLOG
  v="$(PATH="$_ob:$PATH" track_unconfirmed aa:bb:cc:dd:ee:04 "$tk3" "$tu3" $((1000 + PROMOTE_DAYS*86400 + 10)))"
  [ "$v" = PROMOTED ] || { echo "smoke-test: FAIL (order fixture did not promote: '$v')"; rm -rf "$tmpd2"; exit 1; }
  _ord="$(tr '\n' ' ' < "$ORDERLOG")"
  case "$_ord" in
    "") echo "smoke-test: FAIL (the mv/grep interposers recorded NOTHING — the write-order gate observed nothing and must not pass silently)"; rm -rf "$tmpd2"; exit 1 ;;
    mv\ grep*) ;;
    *) echo "smoke-test: FAIL (promote write order was '$_ord', want the purge (mv) BEFORE the baseline append (grep): append-first means a timeout between the two writes confers permanent trust and loses the announcement — it fails OPEN)"; rm -rf "$tmpd2"; exit 1 ;;
  esac
  # (2) torn_promotes must SEE a MAC that is in both files, and report its tracking row
  printf 'aa:bb:cc:dd:ee:05\n' > "$tk3"; printf 'aa:bb:cc:dd:ee:05 1784316254 8\n' > "$tu3"
  t="$(torn_promotes "$tk3" "$tu3")"
  [ "$t" = "aa:bb:cc:dd:ee:05 1784316254 8" ] \
    || { echo "smoke-test: FAIL (torn_promotes missed a MAC present in BOTH files: '$t')"; rm -rf "$tmpd2"; exit 1; }
  # (3) it must NOT cry wolf on consistent files — a baselined MAC with no tracking row is normal
  printf 'aa:bb:cc:dd:ee:05\n' > "$tk3"; : > "$tu3"
  t="$(torn_promotes "$tk3" "$tu3")"
  [ -z "$t" ] || { echo "smoke-test: FAIL (torn_promotes fired on consistent files: '$t')"; rm -rf "$tmpd2"; exit 1; }
  # (4) healing clears the orphan row and LEAVES THE BASELINE ALONE — a demotion re-arms an alarm on
  #     an unidentified device and is a human decision, never a cleanup side effect
  printf 'aa:bb:cc:dd:ee:05\n' > "$tk3"; printf 'aa:bb:cc:dd:ee:05 1784316254 8\naa:bb:cc:dd:ee:06 1 1\n' > "$tu3"
  heal_torn_promote aa:bb:cc:dd:ee:05 "$tu3"
  grep -qi aa:bb:cc:dd:ee:05 "$tu3" && { echo "smoke-test: FAIL (heal left the orphan tracking row)"; rm -rf "$tmpd2"; exit 1; }
  grep -qixF aa:bb:cc:dd:ee:05 "$tk3" || { echo "smoke-test: FAIL (heal DEMOTED the MAC — the baseline must be left alone)"; rm -rf "$tmpd2"; exit 1; }
  grep -qi aa:bb:cc:dd:ee:06 "$tu3" || { echo "smoke-test: FAIL (heal dropped an unrelated tracking row)"; rm -rf "$tmpd2"; exit 1; }
  rm -rf "$tmpd2"
  rm -rf "$tmpd"
  # --allow: idempotent baseline append against a sandboxed KNOWN, never the real file
  tk2="$(mktemp -u)"; : > "$tk2"
  MESH_LAN_KNOWN="$tk2" "$0" --allow AA:BB:CC:DD:EE:03 >/dev/null
  MESH_LAN_KNOWN="$tk2" "$0" --allow aa:bb:cc:dd:ee:03 >/dev/null
  n="$(grep -cix aa:bb:cc:dd:ee:03 "$tk2")"
  [ "$n" = 1 ] || { echo "smoke-test: FAIL (--allow not idempotent: $n rows)"; rm -f "$tk2"; exit 1; }
  rm -f "$tk2"
  # ---- multiplicity keying (proxied hosts) — pure branches ----
  tp="$(mktemp -d)"; pf="$tp/pairs"; printf '7c:c3:a1:a5:20:d7 192.168.8.214\n' > "$pf"
  v="$(classify_multiplicity 7c:c3:a1:a5:20:d7 192.168.8.214 1 "$pf")"
  [ "$v" = KNOWN ] || { echo "smoke-test: FAIL (baselined pair not KNOWN: '$v')"; rm -rf "$tp"; exit 1; }
  v="$(classify_multiplicity 7c:c3:a1:a5:20:d7 192.168.8.242 2 "$pf")"     # concurrent with .214 → growth
  [ "$v" = NEWHOST ] || { echo "smoke-test: FAIL (2nd concurrent host not NEWHOST: '$v')"; rm -rf "$tp"; exit 1; }
  v="$(classify_multiplicity 7c:c3:a1:a5:20:d7 192.168.8.242 1 "$pf")"     # .214 gone → a MOVE, not growth
  [ "$v" = REBIND ] || { echo "smoke-test: FAIL (DHCP re-lease not REBIND: '$v')"; rm -rf "$tp"; exit 1; }
  v="$(classify_multiplicity de:ad:be:ef:00:01 192.168.8.9 1 "$pf")"       # no rows for this mac yet
  [ "$v" = SEED ] || { echo "smoke-test: FAIL (untracked mac not SEED: '$v')"; rm -rf "$tp"; exit 1; }
  rm -rf "$tp"
  # ---- multiplicity keying — the REAL script, end-to-end, asserting the BOARD ARTIFACT ----
  # MESH_DIR sandboxes the real mesh-chat's log, so this gate drives the REAL sink yet can never write
  # the board a human reads (the mesh-guardian forged-liveness trap, 09f7914); MESH_LAN_BEAT likewise
  # keeps it off the beat mesh-reflex-health ages. MESH_CHAT_DEDUPE=0 so the no-refire assertions test
  # OUR edge-trigger and not mesh-chat's suppression — a gate that passes because the SINK deduped
  # asserts nothing about the sense.
  td="$(mktemp -d)"; lf="$td/leases"
  run_status(){ MESH_DIR="$td" MESH_ROUTER=192.168.8.1 MESH_LAN_LEASES_FILE="$lf" \
      MESH_LAN_KNOWN="$td/known" MESH_LAN_KNOWN_PAIRS="$td/pairs" MESH_LAN_UNCONFIRMED="$td/unconf" \
      MESH_LAN_BEAT="$td/beat" MESH_LAN_LASTSEEN="$td/lastseen" \
      MESH_CHAT_TARGETS="" MESH_CHAT_SELFDERIVE=0 MESH_CHAT_DEDUPE=0 \
      "$0" --status 2>/dev/null; }
  nposts(){ local n; n="$(grep -c 'lan-new-device' "$td/chat.log" 2>/dev/null)"; printf '%s' "${n:-0}"; }
  printf '7c:c3:a1:a5:20:d7\n80:56:f2:a7:90:61\n' > "$td/known"
  # 1) migration/seed run: the CURRENT topology is the baseline, never an alert
  printf '0 7c:c3:a1:a5:20:d7 192.168.8.214 imac\n0 80:56:f2:a7:90:61 192.168.8.130 tv\n' > "$lf"
  run_status >/dev/null
  [ "$(nposts)" = 0 ] || { echo "smoke-test: FAIL (pair-seed run alerted on pre-existing topology: $(nposts))"; rm -rf "$td"; exit 1; }
  [ -f "$td/beat" ] || { echo "smoke-test: FAIL (MESH_LAN_BEAT override not honoured — the gate would forge the real liveness beat)"; rm -rf "$td"; exit 1; }
  # 2) a re-seen (mac,ip) stays silent
  run_status >/dev/null
  [ "$(nposts)" = 0 ] || { echo "smoke-test: FAIL (re-seen (mac,ip) alerted: $(nposts))"; rm -rf "$td"; exit 1; }
  # 3) THE FALSE-POSITIVE EDGE — a DHCP re-lease moves the TV .130→.131. Count holds at 1, so it must
  #    stay silent: pair-keying without this would alert on every routine re-lease and turn a security
  #    sense into a noise source (very likely why the baseline keys on MAC today).
  printf '0 7c:c3:a1:a5:20:d7 192.168.8.214 imac\n0 80:56:f2:a7:90:61 192.168.8.131 tv\n' > "$lf"
  run_status >/dev/null
  [ "$(nposts)" = 0 ] || { echo "smoke-test: FAIL (DHCP re-lease alerted — the noise regression this design exists to avoid: $(nposts))"; rm -rf "$td"; exit 1; }
  grep -q '80:56:f2:a7:90:61 192.168.8.131' "$td/pairs" || { echo "smoke-test: FAIL (rebind didn't relearn the moved ip)"; rm -rf "$td"; exit 1; }
  [ "$(grep -c '^80:56:f2:a7:90:61' "$td/pairs")" = 1 ] || { echo "smoke-test: FAIL (rebind left a stale row — an inflated count masks the next genuine arrival)"; rm -rf "$td"; exit 1; }
  # 4) THE FIND (measured live on mesh-home): a 2nd host proxied behind the baselined iMac MAC — the
  #    case that was structurally un-alertable — must fire exactly one [lan-new-device].
  printf '0 7c:c3:a1:a5:20:d7 192.168.8.214 imac\n0 7c:c3:a1:a5:20:d7 192.168.8.242 ilya\n0 80:56:f2:a7:90:61 192.168.8.131 tv\n' > "$lf"
  out="$(run_status)"
  [ "$(nposts)" = 1 ] || { echo "smoke-test: FAIL (2nd host behind a baselined MAC didn't fire exactly one [lan-new-device]: $(nposts))"; rm -rf "$td"; exit 1; }
  grep -q 'behind an ALREADY-KNOWN MAC' "$td/chat.log" || { echo "smoke-test: FAIL (alert lacks the proxy wording)"; rm -rf "$td"; exit 1; }
  printf '%s' "$out" | grep -q '192.168.8.242' || { echo "smoke-test: FAIL (--status stdout doesn't name the proxied host)"; rm -rf "$td"; exit 1; }
  # 5) now baselined → edge-triggered, no re-fire every 15m
  run_status >/dev/null
  [ "$(nposts)" = 1 ] || { echo "smoke-test: FAIL (baselined pair re-fired — edge-trigger broken: $(nposts))"; rm -rf "$td"; exit 1; }
  # 6) AGGREGATION — TWO new concurrent hosts behind the baselined MAC in ONE run post exactly ONE
  #    board line (2026-09-02: N pairs → N lines in 10 s), while stdout still names every host.
  printf 'b0:8b:cf:1b:77:c0 100.74.205.200\n' >> "$td/pairs"   # planted CGNAT row: the purge must drop it
  printf '0 7c:c3:a1:a5:20:d7 192.168.8.214 imac\n0 7c:c3:a1:a5:20:d7 192.168.8.242 ilya\n0 7c:c3:a1:a5:20:d7 192.168.8.243 vm2\n0 7c:c3:a1:a5:20:d7 192.168.8.244 vm3\n0 80:56:f2:a7:90:61 192.168.8.131 tv\n' > "$lf"
  out="$(run_status)"
  [ "$(nposts)" = 2 ] || { echo "smoke-test: FAIL (2 new hosts in one run posted $(( $(nposts) - 1 )) board lines, want exactly 1 aggregate)"; rm -rf "$td"; exit 1; }
  printf '%s' "$out" | grep -q '192.168.8.243' || { echo "smoke-test: FAIL (aggregate run stdout lost .243)"; rm -rf "$td"; exit 1; }
  printf '%s' "$out" | grep -q '192.168.8.244' || { echo "smoke-test: FAIL (aggregate run stdout lost .244)"; rm -rf "$td"; exit 1; }
  tail -1 "$td/chat.log" | grep -q '2 new this run' || { echo "smoke-test: FAIL (aggregate board line lacks the count: $(tail -1 "$td/chat.log") )"; rm -rf "$td"; exit 1; }
  grep -q '100.74.205.200' "$td/pairs" && { echo "smoke-test: FAIL (pairs purge left a planted CGNAT row — the inflated nbase would mask the next genuine arrival)"; rm -rf "$td"; exit 1; }
  grep -q '7c:c3:a1:a5:20:d7 192.168.8.244' "$td/pairs" || { echo "smoke-test: FAIL (pairs purge dropped a genuine LAN row)"; rm -rf "$td"; exit 1; }
  rm -rf "$td"
  # 7) THE FLOOD, END-TO-END OVER THE ARP PATH — router DHCP dead (ssh fails), route toward the
  #    router resolving via the CGNAT uplink, neigh table full of forwarded CGNAT flows behind ONE
  #    already-baselined MAC. Must post ZERO board lines (honest "can't assess"), not N.
  td3="$(mktemp -d)"; mkdir -p "$td3/bin"
  printf '#!/bin/sh\nexit 1\n' > "$td3/bin/ssh"; chmod +x "$td3/bin/ssh"
  printf '#!/bin/sh\nexit 0\n' > "$td3/bin/ping"; chmod +x "$td3/bin/ping"
  { printf '#!/bin/sh\nif [ "$1" = "-4" ]; then\n'
    printf '  echo "192.168.8.1 via 100.76.0.1 dev enp42s0 src 100.74.205.200"\n'
    printf 'else\n'
    printf '  printf "100.74.205.96 dev enp42s0 lladdr b0:8b:cf:1b:77:c0 REACHABLE\\n"\n'
    printf '  printf "100.74.205.97 dev enp42s0 lladdr b0:8b:cf:1b:77:c0 REACHABLE\\n"\n'
    printf '  printf "100.74.205.98 dev enp42s0 lladdr b0:8b:cf:1b:77:c0 REACHABLE\\n"\n'
    printf 'fi\n'; } > "$td3/bin/ip"; chmod +x "$td3/bin/ip"
  printf 'b0:8b:cf:1b:77:c0\n' > "$td3/known"
  printf 'b0:8b:cf:1b:77:c0 100.74.205.1\n' > "$td3/pairs"
  out="$(PATH="$td3/bin:$PATH" MESH_DIR="$td3" MESH_ROUTER=192.168.8.1 \
      MESH_LAN_KNOWN="$td3/known" MESH_LAN_KNOWN_PAIRS="$td3/pairs" MESH_LAN_UNCONFIRMED="$td3/unconf" \
      MESH_LAN_BEAT="$td3/beat" MESH_LAN_LASTSEEN="$td3/lastseen" MESH_LAN_ARP_SWEEP_S=5 \
      MESH_CHAT_TARGETS="" MESH_CHAT_SELFDERIVE=0 MESH_CHAT_DEDUPE=0 \
      "$0" --status 2>/dev/null)"
  n3="$(grep -c 'lan-new-device' "$td3/chat.log" 2>/dev/null || echo 0)"
  [ "$n3" = 0 ] || { echo "smoke-test: FAIL (CGNAT neigh population posted $n3 board lines — the 2026-09-02 flood, unfixed)"; rm -rf "$td3"; exit 1; }
  printf '%s' "$out" | grep -q "can't assess" \
    || { echo "smoke-test: FAIL (all-CGNAT ARP population should read can't-assess, got: '$out')"; rm -rf "$td3"; exit 1; }
  rm -rf "$td3"
  # ---- CONSTRUCTED NICHE (niche-construction review 2026-08-29, Fogarty & Wade Proc R Soc B
  # 289:20220401 eq. 3.1): the baseline is an inherited environment with mu = 1, and the reading
  # about it must ABSTAIN until it has the history to speak. Every arm here is on the pure
  # functions, so none of it touches the real baseline, ledger or board. ----
  tn="$(mktemp -d)"; nk="$tn/known"; nl="$tn/ls"
  printf 'aa:bb:cc:00:00:01\naa:bb:cc:00:00:02\naa:bb:cc:00:00:03\n' > "$nk"
  W=14; NOW=$(( 100 * 86400 ))
  # (1) NO LEDGER: every baselined MAC is na (UNKNOWN), never inherited, and the verdict abstains.
  #     The bug this catches is silent: awk over a nonexistent file prints nothing, `read` leaves the
  #     buckets empty, and three defaulted zeros render as a measurement of a healthy baseline.
  r="$(niche_measure "$nk" "$nl" "$W" "$NOW")"
  case "$r" in *"na=3"*) ;; *) echo "smoke-test: FAIL (no ledger must put all 3 baselined MACs in na=, got: $r)"; rm -rf "$tn"; exit 1 ;; esac
  case "$r" in *"inherited=0"*) ;; *) echo "smoke-test: FAIL (no ledger must never accuse the baseline of holding ghosts: $r)"; rm -rf "$tn"; exit 1 ;; esac
  case "$r" in *"state=UNKNOWN"*) ;; *) echo "smoke-test: FAIL (no ledger must abstain: $r)"; rm -rf "$tn"; exit 1 ;; esac
  # (2) record_seen stamps the CURRENT read and mints a born stamp exactly once.
  record_seen "$nl" "$NOW" "0 AA:BB:CC:00:00:01 192.168.8.5 h1"
  grep -q '^#born ' "$nl" || { echo "smoke-test: FAIL (record_seen minted no #born stamp — ledger age is unmeasurable and coverage can never be earned)"; rm -rf "$tn"; exit 1; }
  b1="$(awk '/^#born /{print $2}' "$nl")"
  grep -qi '^aa:bb:cc:00:00:01 ' "$nl" || { echo "smoke-test: FAIL (record_seen did not stamp the observed MAC)"; rm -rf "$tn"; exit 1; }
  # (3) THE BORN STAMP MUST NOT MOVE. If a later run re-mints it, ledger age resets every run,
  #     coverage never reaches full, and the reading abstains forever while looking well-behaved.
  record_seen "$nl" $(( NOW + 86400 )) "0 AA:BB:CC:00:00:01 192.168.8.5 h1"
  [ "$(awk '/^#born /{print $2}' "$nl")" = "$b1" ] \
    || { echo "smoke-test: FAIL (#born moved on a later run — coverage can never mature)"; rm -rf "$tn"; exit 1; }
  # (4) A MAC that is NOT in the current read keeps its OLD stamp — record_seen must not refresh
  #     something it did not observe, which would make every baselined MAC eternally corroborated
  #     and the whole reading vacuous.
  printf '#born %s\naa:bb:cc:00:00:02 1\n' "$b1" > "$nl"
  record_seen "$nl" "$NOW" "0 AA:BB:CC:00:00:01 192.168.8.5 h1"
  [ "$(awk '$1=="aa:bb:cc:00:00:02"{print $2}' "$nl")" = 1 ] \
    || { echo "smoke-test: FAIL (record_seen refreshed a MAC absent from the read — corroboration would be self-granted)"; rm -rf "$tn"; exit 1; }
  # (5) YOUNG LEDGER + a genuinely stale MAC: coverage is partial, so the verdict ABSTAINS. This is
  #     the bounded-cache rule: the ledger's silence is amnesia until it has run a full window.
  printf '#born %s\naa:bb:cc:00:00:01 %s\naa:bb:cc:00:00:02 1\naa:bb:cc:00:00:03 %s\n' \
    $(( NOW - 3 * 86400 )) "$NOW" "$NOW" > "$nl"
  r="$(niche_measure "$nk" "$nl" "$W" "$NOW")"
  case "$r" in *"coverage=partial:"*) ;; *) echo "smoke-test: FAIL (a ledger younger than the window must render partial: $r)"; rm -rf "$tn"; exit 1 ;; esac
  case "$r" in *"state=UNKNOWN"*) ;; *) echo "smoke-test: FAIL (partial coverage must abstain, never accuse: $r)"; rm -rf "$tn"; exit 1 ;; esac
  # (6) MATURE ledger, everything corroborated → CORROBORATED, inherited=0.
  printf '#born %s\naa:bb:cc:00:00:01 %s\naa:bb:cc:00:00:02 %s\naa:bb:cc:00:00:03 %s\n' \
    $(( NOW - 40 * 86400 )) "$NOW" "$NOW" "$NOW" > "$nl"
  r="$(niche_measure "$nk" "$nl" "$W" "$NOW")"
  case "$r" in *"state=CORROBORATED"*"inherited=0"*) ;; *) echo "smoke-test: FAIL (mature+all-seen must be CORROBORATED with inherited=0: $r)"; rm -rf "$tn"; exit 1 ;; esac
  # (7) MATURE ledger, one MAC not seen inside the window → RATCHETED, and it lands in inherited=,
  #     which is the whole point: trust the baseline still confers with nothing behind it.
  printf '#born %s\naa:bb:cc:00:00:01 %s\naa:bb:cc:00:00:02 %s\naa:bb:cc:00:00:03 %s\n' \
    $(( NOW - 40 * 86400 )) "$NOW" "$NOW" $(( NOW - 30 * 86400 )) > "$nl"
  r="$(niche_measure "$nk" "$nl" "$W" "$NOW")"
  case "$r" in *"state=RATCHETED"*) ;; *) echo "smoke-test: FAIL (a baselined MAC unseen for 30d under full coverage must RATCHET: $r)"; rm -rf "$tn"; exit 1 ;; esac
  case "$r" in *"inherited=1"*) ;; *) echo "smoke-test: FAIL (the unseen MAC must be counted inherited: $r)"; rm -rf "$tn"; exit 1 ;; esac
  # (8) UNDER FULL COVERAGE a baselined MAC with NO ledger row is STILL na, never inherited —
  #     a mature ledger does not make a never-observed MAC into an observed absence.
  printf '#born %s\naa:bb:cc:00:00:01 %s\naa:bb:cc:00:00:02 %s\n' \
    $(( NOW - 40 * 86400 )) "$NOW" "$NOW" > "$nl"
  r="$(niche_measure "$nk" "$nl" "$W" "$NOW")"
  case "$r" in *"na=1"*) ;; *) echo "smoke-test: FAIL (a baselined MAC with no ledger row must stay na under full coverage: $r)"; rm -rf "$tn"; exit 1 ;; esac
  case "$r" in *"inherited=0"*) ;; *) echo "smoke-test: FAIL (never-observed must not be folded into observed-absent: $r)"; rm -rf "$tn"; exit 1 ;; esac
  # (9a) na must not wear a clean word: full coverage, nothing stale, but one entry never observed.
  r="$(niche_measure "$nk" "$nl" "$W" "$NOW")"
  case "$r" in *"state=UNDER-OBSERVED"*) ;; *) echo "smoke-test: FAIL (an entry nothing has ever observed must not read CORROBORATED: $r)"; rm -rf "$tn"; exit 1 ;; esac
  # (9b) present with NO observation supplied is na, never 0 — 0 would claim none of the baselined
  #      devices is on the LAN, a strong claim minted out of an absent measurement.
  case "$r" in *"present=na"*) ;; *) echo "smoke-test: FAIL (present must render na when no leases were supplied: $r)"; rm -rf "$tn"; exit 1 ;; esac
  # (9) present= counts only BASELINED MACs in the current read (an unbaselined one is not "present
  #     in the niche" — it is exactly what the alarm path is for).
  r="$(niche_measure "$nk" "$nl" "$W" "$NOW" "0 aa:bb:cc:00:00:01 192.168.8.5 h1
0 de:ad:be:ef:00:99 192.168.8.6 stranger")"
  case "$r" in *"present=1"*) ;; *) echo "smoke-test: FAIL (present= must count baselined MACs only: $r)"; rm -rf "$tn"; exit 1 ;; esac
  if [ -f "$_rl" ]; then _rla="$(md5sum < "$_rl")"; else _rla=absent; fi
  [ "$_rlb" = "$_rla" ] \
    || { echo "smoke-test: FAIL (the suite WROTE the real last-seen ledger $_rl — a fixture MAC in the live ledger reads back as genuine corroboration; add MESH_LAN_LASTSEEN to run_status()'s override set)"; rm -rf "$tn"; exit 1; }
  rm -rf "$tn"
  echo "smoke-test: ok (neigh-parse: 2 + scope-filter: 7 + aggregate-render: 4 + occupancy-gate: 5 + unconfirmed-promote: 5 + torn-promote: 6 + allow-idempotent: 1 + multiplicity-pure: 4 + multiplicity-artifact: 16 + arp-flood-e2e: 2 + constructed-niche: 15 assertions)"; exit 0
fi

if [ "${1:-}" = --allow ]; then
  mac="${2:-}"
  [ -n "$mac" ] || { echo "usage: mesh-lan-newdevice --allow <mac>"; exit 1; }
  mac="$(printf '%s' "$mac" | tr 'A-F' 'a-f')"
  mkdir -p "$(dirname "$KNOWN")" 2>/dev/null
  : > "${KNOWN}.lock.$$" 2>/dev/null; rm -f "${KNOWN}.lock.$$" 2>/dev/null
  touch "$KNOWN" 2>/dev/null
  grep -qixF "$mac" "$KNOWN" 2>/dev/null || echo "$mac" >> "$KNOWN"
  if [ -f "$UNCONFIRMED" ]; then
    awk -v m="$mac" 'tolower($1)!=m' "$UNCONFIRMED" > "$UNCONFIRMED.tmp" 2>/dev/null && mv "$UNCONFIRMED.tmp" "$UNCONFIRMED"
  fi
  echo "baseline: $mac confirmed + appended (idempotent)"
  exit 0
fi

if [ "${1:-}" = --niche ]; then
  # Deliberately BEFORE the router gate: this reads local state only, so a node whose router is
  # unreachable can still answer how much of its own sensed space it has consumed. Exit 0 always —
  # it is a reading, not a verdict on the LAN.
  # NO touch of $KNOWN here: a reading that moves a file's mtime is not a reading. niche_measure
  # tolerates the file being absent.
  echo "niche: $(niche_measure "$KNOWN" "$LASTSEEN" "$NICHE_WINDOW_DAYS" "$(date +%s)")"
  echo "  baselined     = in $KNOWN — what EVERY trust decision in this file actually tests"
  echo "  corroborated  = baselined AND seen within ${NICHE_WINDOW_DAYS}d (ledger $LASTSEEN)"
  echo "  inherited     = baselined, ledger says NOT seen in the window — trust with nothing behind it"
  echo "  na            = baselined, no ledger row at all — UNKNOWN, never counted as inherited"
  echo "  mu=1.000      = structural: no code path removes a single baseline entry (--forget is a"
  echo "                  total reset, not decay), so the constructed niche only accumulates."
  echo "                  Fogarty & Wade, Proc R Soc B 289:20220401 (2022), eq. 3.1 / M1."
  exit 0
fi
[ "${1:-}" = --forget ] && { rm -f "$KNOWN"; echo "baseline forgotten — next run re-seeds"; exit 0; }
[ -n "$ROUTER" ] || { echo "no router in ~/.mesh/nodes — nothing to watch on this node"; exit 0; }
mkdir -p "$HOME/.mesh"

# DHCP lease line: <expiry> <mac> <ip> <hostname> <client-id>
# MESH_LAN_LEASES_FILE substitutes the OBSERVATION (the LAN itself — genuinely uncontrollable from a
# test, and the only reason it exists) so --test can drive the REAL script's REAL keying/alert path
# against a fixture topology. It stubs the source, never the logic under test; the live source paths
# below stay exercised by every real run.
if [ -n "${MESH_LAN_LEASES_FILE:-}" ]; then
  leases="$(cat "$MESH_LAN_LEASES_FILE" 2>/dev/null)"
  LAN_SRC="file"
else
leases="$(timeout 12 "${SSH[@]}" "$RUSER@$ROUTER" 'cat /tmp/dhcp.leases 2>/dev/null' </dev/null 2>/dev/null)"
LAN_SRC="dhcp"
if [ -z "$leases" ]; then
  # Router DHCP unreachable → Tailscale-independent LAN-side fallback (see lan_arp_observe).
  leases="$(lan_arp_observe)"
  LAN_SRC="arp"
fi
fi
[ -n "$leases" ] || { echo "router DHCP + LAN ARP both unreachable — can't assess (not an alarm)"; exit 0; }
# liveness heartbeat: this silent-on-no-news reflex has no other per-run artifact, so prove it
# actually OBSERVED the LAN this run (router reachable + leases read) for mesh-reflex-health. Placed
# AFTER the lease read so a router outage (watch silently non-functional) lets the beat go stale.
: > "$BEAT"
# Stamp the last-seen ledger from the SAME observation the alarm path is about to use, on both the
# --status and default paths (--status is the only one actually cronned, via mesh-perimeter --edge).
# Placed after the beat and before any decision: it feeds --niche only, so nothing here can change
# whether a device alerts.
record_seen "$LASTSEEN" "$(date +%s)" "$leases"

if [ "${1:-}" = --status ]; then
  echo "known LAN devices: $(wc -l < "$KNOWN" 2>/dev/null || echo 0)"
  echo "source: $LAN_SRC$([ "$LAN_SRC" = arp ] && echo ' (router DHCP unreachable — LAN-side ARP fallback)')"
  echo "--- current leases (host / ip / mac) ---"
  printf '%s\n' "$leases" | awk '{printf "  %-22s %-15s %s\n", $4, $3, $2}'
  # This is the path mesh-perimeter --edge actually calls every 45m (read-only by design) — the
  # default/bare invocation below that self-learns on first sight has no cron entry of its own, so
  # unconfirmed-device tracking + promotion has to happen here or it never happens at all.
  if [ -f "$KNOWN" ] || [ -n "$leases" ]; then
    touch "$KNOWN" 2>/dev/null
    now="$(date +%s)"; promoted=""
    unconfirmed_out=""
    # RECONCILE FIRST: a MAC in both KNOWN and UNCONFIRMED is a promote torn by the budget kill —
    # trust was committed and the announcement was lost. Say it now, loudly, and clear the orphan
    # row. Never demote here (see torn_promotes): re-arming an alarm on an unidentified device is a
    # human decision, and this line is what makes that decision possible instead of invisible.
    torn_out=""
    while read -r tmac tfirst tcount; do
      [ -n "$tmac" ] || continue
      heal_torn_promote "$tmac" "$UNCONFIRMED"
      torn_out+="  $tmac — TORN PROMOTE: baselined with no announcement (first seen $(date -u -d "@${tfirst:-0}" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo '?'), count ${tcount:-?}); tracking row cleared, baseline left ALONE"$'\n'
    done < <(torn_promotes "$KNOWN" "$UNCONFIRMED")
    if [ -n "$torn_out" ]; then
      echo "--- torn promote(s) reconciled (trust was conferred, the alert never spoke) ---"
      printf '%s' "$torn_out"
      command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="lan-watch@$(hostname)" \
        mesh-chat "[lan-baseline-torn-promote] $(printf '%s' "$torn_out" | awk '{print $1}' | tr '\n' ' ')— these MAC(s) are in the LAN baseline but were NEVER announced: the promote was killed between its two writes (mesh-perimeter's timeout on --status), so trust was committed and [lan-baseline-promote] was lost. Tracking rows cleared; the baseline was NOT changed. If any of these is not yours, demote it deliberately with an explicit decision — it is silently trusted right now." >/dev/null 2>&1
    fi
    newhost_out=""
    newhost_n=0; newhost_list=""
    # PURGE non-LAN scopes from the multiplicity baseline (the same scopes neigh_to_leases drops at
    # the source). The 2026-09-02 flood LEARNED CGNAT rows into PAIRS (record_pair on every NEWHOST),
    # and a stale inflated nbase masks the next GENUINE arrival behind the same MAC (the count can
    # never grow past it → misclassified REBIND → silent — the exact stale-row blindness record_pair's
    # `replace` mode already guards against). $KNOWN is deliberately NOT touched here: that file is
    # TRUST, and demotion is a human decision — PAIRS rows are multiplicity accounting only.
    if [ -f "$PAIRS" ]; then
      awk '{ ip=$2; n=split(ip, o, ".");
        if(n!=4){print; next}
        if(o[1]==100 && o[2]>=64 && o[2]<=127) next;
        if(o[1]==169 && o[2]==254) next;
        if(o[1]>=224 && o[1]<=239) next;
        print }' "$PAIRS" > "$PAIRS.tmp" 2>/dev/null && mv "$PAIRS.tmp" "$PAIRS"
    fi
    # MAC-only→pair migration: the FIRST run under multiplicity-keying takes the CURRENT topology as
    # the baseline, silently. Without this, mesh-home's pre-existing .214+.242-behind-one-MAC would
    # read as growth (1→2) and alert on a VM that has been there all along — the same silent-seed
    # doctrine the DHCP→ARP fallback merge below already follows for the same reason.
    pairs_seeded=0
    if [ ! -f "$PAIRS" ]; then
      printf '%s\n' "$leases" | awk 'NF>=2{print tolower($2), $3}' | sort -u > "$PAIRS" 2>/dev/null
      pairs_seeded=1
    fi
    while read -r mac ip; do
      [ -n "$mac" ] || continue
      if grep -qixF "$mac" "$KNOWN" 2>/dev/null; then
        # A baselined MAC used to `continue` here — and THAT was the blind spot: it retired the MAC
        # from scrutiny, so a second host proxied behind it was never examined at all. Keep watching
        # its host COUNT (see PAIRS at the top for why a count and not the (mac,ip) pair).
        [ "$pairs_seeded" = 1 ] && continue
        nconc="$(printf '%s\n' "$leases" | awk -v m="$mac" 'NF>=2 && tolower($2)==m{print $3}' | sort -u | wc -l)"
        nbase="$(awk -v m="$mac" 'tolower($1)==m{n++} END{print n+0}' "$PAIRS" 2>/dev/null)"
        case "$(classify_multiplicity "$mac" "$ip" "$nconc" "$PAIRS")" in
          NEWHOST)
            record_pair "$mac" "$ip" "$PAIRS"
            newhost_out+="  $mac ($ip) — NEW HOST behind a baselined MAC ($nconc concurrent IPs vs baseline $nbase)"$'\n'
            # ACCUMULATE ONLY — the single board post for the whole run goes out after the loop
            # (2026-09-02: this branch posted per (mac,ip) pair → 11 lines in 10 s for one MAC).
            newhost_n=$((newhost_n + 1))
            newhost_list+=" $mac ($ip) [$nconc vs baseline $nbase];"
            ;;
          REBIND) record_pair "$mac" "$ip" "$PAIRS" replace ;;
          SEED)   record_pair "$mac" "$ip" "$PAIRS" ;;
        esac
        continue
      fi
      verdict="$(track_unconfirmed "$mac" "$KNOWN" "$UNCONFIRMED" "$now")"
      case "$verdict" in
        NEW)        unconfirmed_out+="  $mac ($ip) — new, first seen this run"$'\n' ;;
        PERSISTENT) unconfirmed_out+="  $mac ($ip) — persistent unconfirmed (below promote threshold)"$'\n' ;;
        PROMOTED)   unconfirmed_out+="  $mac ($ip) — PROMOTED to baseline this run"$'\n'; promoted+=" $mac" ;;
      esac
    done < <(printf '%s\n' "$leases" | awk 'NF>=2{print $2, $3}' | sort -u)
    if [ -n "$unconfirmed_out" ]; then
      echo "--- unconfirmed (seen, not yet baselined) ---"
      printf '%s' "$unconfirmed_out"
    fi
    if [ -n "$newhost_out" ]; then
      echo "--- new host(s) behind a known MAC (proxied — MAC-keying is blind to these) ---"
      printf '%s' "$newhost_out"
      # ONE aggregated board line per run (mirrors the stdout summary above), never one per pair.
      src_note=""
      [ "$LAN_SRC" = arp ] && src_note=" [via LAN ARP fallback — router DHCP unreachable, no hostname, lower confidence]"
      command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="lan-watch@$(hostname)" \
        mesh-chat "$(newhosts_aggregate_render "$newhost_n" "$newhost_list" "$src_note")" >/dev/null 2>&1
    fi
    if [ -n "$promoted" ]; then
      command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="lan-watch@$(hostname)" \
        mesh-chat "[lan-baseline-promote] auto-confirmed after repeated sightings/age threshold:$promoted — perimeter's NETWORK axis should stop ALERTing on these now" >/dev/null 2>&1
    fi
  fi
  exit 0
fi

# first run: seed the baseline silently — existing devices are KNOWN, not intrusions
if [ ! -f "$KNOWN" ]; then
  printf '%s\n' "$leases" | awk 'NF>=2{print $2}' | sort -u > "$KNOWN"
  echo "seeded baseline: $(wc -l < "$KNOWN") known device(s) (no alerts on first run)"
  exit 0
fi

# First ARP-FALLBACK reconciliation: the ARP view is a DIFFERENT population than the DHCP-seeded
# baseline (static-IP devices, L2-only reachables). On the FIRST fallback, MERGE current ARP MACs
# into the baseline SILENTLY (no alert) so the DHCP↔ARP discrepancy doesn't flood [lan-new-device];
# only devices appearing AFTER this fallback baseline is established are real intrusion signals.
ARP_SEEDED="$HOME/.mesh/.lan-arp-seeded"
if [ "$LAN_SRC" = arp ] && [ ! -f "$ARP_SEEDED" ]; then
  merged=0
  while read -r mac; do
    [ -n "$mac" ] || continue
    grep -qixF "$mac" "$KNOWN" 2>/dev/null && continue
    echo "$mac" >> "$KNOWN"; merged=$((merged + 1))
  done < <(printf '%s\n' "$leases" | awk 'NF>=2{print $2}')
  : > "$ARP_SEEDED"
  echo "LAN ARP fallback first run: merged $merged previously-unseen MAC(s) into baseline silently (router DHCP unreachable; no false alerts on the DHCP↔ARP population discrepancy)"
  exit 0
fi

new=0
while read -r mac host ip; do
  [ -n "$mac" ] || continue
  grep -qixF "$mac" "$KNOWN" 2>/dev/null && continue   # already known
  echo "$mac" >> "$KNOWN"                               # learn it (alert once)
  [ -f "$UNCONFIRMED" ] && { awk -v m="$mac" 'tolower($1)!=m' "$UNCONFIRMED" > "$UNCONFIRMED.tmp" 2>/dev/null && mv "$UNCONFIRMED.tmp" "$UNCONFIRMED"; }
  new=$((new + 1))
  src_note=""
  [ "$LAN_SRC" = arp ] && src_note=" [via LAN ARP fallback — router DHCP unreachable, no hostname, lower confidence]"
  if is_laa "$mac"; then
    msg="[lan-new-device] (low) private/rotating MAC joined the LAN: ${host:-?} ($mac, ${ip:-?}) — locally-administered address (iOS/Android Wi-Fi randomization), most likely a KNOWN device with a new random MAC, not a newcomer. Only suspicious if you expected no one.${src_note}"
  else
    # globally-unique unknown MAC = the real intrusion candidate → occupancy-gate the severity
    msg="$(occ_render "$(occupancy_state)" "$host" "$mac" "$ip" "$src_note")"
  fi
  command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="lan-watch@$(hostname)" \
    mesh-chat "$msg" >/dev/null 2>&1
done < <(printf '%s\n' "$leases" | awk 'NF>=4{print $2, $4, $3}')
# silent when nothing new (the baseline file proves it ran) — only speak on a real new device
[ "$new" -gt 0 ] && echo "$new new device(s) alerted"
# Immune watcher: after every LAN check, also scan for unapproved SSH keys + new TS nodes
command -v mesh-immune-watcher >/dev/null 2>&1 && mesh-immune-watcher --check >/dev/null 2>&1
exit 0
