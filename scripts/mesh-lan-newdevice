#!/usr/bin/env bash
# mesh-lan-newdevice — security awareness: alert when a NEW/unknown device joins the home LAN.
#
# mesh-lan-presence shows who's on the LAN NOW; this is the stateful DELTA. It learns the known
# devices (a bounded MAC baseline, not a DB) and EDGE-TRIGGERS [lan-new-device] when an unseen MAC
# first appears — e.g. an unknown phone joining the WiFi while the operator is away = a real intrusion
# signal. Reads the always-on router's DHCP leases (Tailscale-independent, READ-ONLY). Same
# stateful-filter pattern as mesh-presence-delta, at the LAN level — it catches WiFi/wired devices
# BLE presence can't see. First run seeds the baseline silently (existing devices are KNOWN, not new).
#
#   mesh-lan-newdevice          poll; alert on a newly-seen device (seeds baseline silently on 1st run)
#   mesh-lan-newdevice --status list known devices + current leases
#   mesh-lan-newdevice --forget  reset the baseline (re-seed on next run)
#   mesh-lan-newdevice --test   smoke test
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
ROUTER="${MESH_ROUTER:-$(mesh-peer-addr router 2>/dev/null || mesh-peer-addr GL-MT3000 2>/dev/null)}"
RUSER="${MESH_ROUTER_USER:-root}"
KNOWN="${MESH_LAN_KNOWN:-$HOME/.mesh/.lan-known-macs}"
UNCONFIRMED="${MESH_LAN_UNCONFIRMED:-$HOME/.mesh/.lan-unconfirmed}"
# The identity this sense keys on (a MAC) is not the identity it claims to watch (a HOST joining the
# LAN). A MAC-TRANSLATING PROXY collapses several hosts onto one address: an 802.11 station cannot
# bridge a second MAC, so VirtualBox rewrites a bridged VM's frames to the host NIC's MAC. Measured on
# mesh-home 2026-07-15: 192.168.8.214 (iMac) and 192.168.8.242 (ilya's VM) are TWO reachable hosts with
# DIFFERENT sshd banners behind ONE Apple MAC 7c:c3:a1:a5:20:d7 — and the baseline held 7 entries for 9
# lease rows, so the VM was already INSIDE a baseline it could never move: structurally un-alertable,
# forever, in an INTRUSION sense (chat-review/lan-newdevice-baseline-keys-mac-only-so-proxied-hosts-are-invisible).
# So we ALSO baseline each MAC's host MULTIPLICITY (its rows here). Why multiplicity and not the (mac,ip)
# pair: pair-keying alerts on every DHCP re-lease (a known device routinely gets a new IP) — that turns a
# security sense into a noise source, which is very likely WHY it keys on MAC today. The discriminator is
# CONCURRENCY, and a count captures it exactly: a proxied host appears ALONGSIDE its neighbours in the same
# read (count GROWS); a re-lease moves one IP and the old one VANISHES in that same read (count HOLDS).
PAIRS="${MESH_LAN_KNOWN_PAIRS:-$HOME/.mesh/.lan-known-pairs}"
# The liveness beat is a REAL artifact mesh-reflex-health ages (scripts/mesh-reflex-health:103). It MUST
# be overridable so --test can never touch the file a watchdog reads for liveness — a dry run that writes
# the liveness log forges the very evidence it exists to check (the mesh-guardian trap, 09f7914).
BEAT="${MESH_LAN_BEAT:-$HOME/.mesh/.lan-newdevice.beat}"
# --status is the path actually SCHEDULED (mesh-perimeter --edge calls it every 45m, read-only
# by design); the bare/default invocation below (the one that self-learns on first sight) has no
# cron entry of its own, so a device that only ever gets OBSERVED via --status never got promoted
# — proven live: MAC c0:18:85:47:10:78 (Huawei B570e) sat unbaselined 3+ weeks, re-firing
# mesh-perimeter's NETWORK=ALERT every 45m (chat-review/lan-newdevice-baseline-never-updated).
# So the promote-after-repeated-sightings logic below runs from --status too, not just the
# unscheduled default path.
# mesh-perimeter --edge (the only actual caller of --status) cadences ~45m -> ~32 runs/day;
# default RUNS gives the operator roughly a day of visibility on the board before auto-silencing,
# DAYS is the outer bound for a slower/irregular cadence.
PROMOTE_RUNS="${MESH_LAN_PROMOTE_RUNS:-30}"
PROMOTE_DAYS="${MESH_LAN_PROMOTE_DAYS:-3}"
SSH=(ssh -o BatchMode=yes -o ConnectTimeout=8 -o StrictHostKeyChecking=accept-new)

# A locally-administered MAC (bit 0x02 of the first octet) is a PRIVACY-RANDOMIZED address —
# iOS "Private Wi-Fi Address" / Android randomization rotate these, so a KNOWN phone keeps
# reappearing as a brand-new MAC. An unknown LAA address is therefore far more likely a
# return of a known device than a genuine intrusion → lower severity, so the security sense
# doesn't cry wolf every rotation. A globally-unique (OUI-registered) unknown MAC keeps the
# stronger wording. (Same insight as mesh-novelty excluding randomized BLE MACs.)
is_laa() { local o="${1%%:*}"; [ -n "$o" ] && (( (16#$o & 2) != 0 )) 2>/dev/null; }

# Occupancy-gate the intrusion SEVERITY: a globally-unique unknown MAC is a very different signal
# depending on whether anyone is home. Read the household state at ALERT time and let it MODULATE the
# wording — AWAY (home unoccupied) escalates to a HIGH intrusion candidate; ASLEEP (everyone asleep,
# nobody plausibly adding a device) is elevated; ACTIVE (household awake, most likely the operator
# adding a device) de-escalates to a routine log; UNCERTAIN keeps the pre-existing default wording.
# FAIL-OPEN, honest-fusion ([[fusion-tools-distinguish-empty-from-failed]]): an unreachable/absent
# household sense → UNCERTAIN → current default, NEVER a faked all-clear that suppresses a real alert.
# The [lan-new-device] marker still fires in EVERY case (detection/vocab unchanged) — occupancy only
# contextualizes the severity, it never silently drops a new-device event (a genuine intrusion while
# the household is ACTIVE must still surface, just framed as lower-priority).
occupancy_state(){
  [ -n "${MESH_LAN_OCC_STATE:-}" ] && { printf '%s' "$MESH_LAN_OCC_STATE"; return; }   # test/override hook
  command -v mesh-household-state >/dev/null 2>&1 || { printf 'UNCERTAIN'; return; }
  local s
  s="$(mesh-household-state --json 2>/dev/null | sed -n 's/.*"state": *"\([^"]*\)".*/\1/p')"
  case "$s" in ACTIVE|ASLEEP|AWAY) printf '%s' "$s" ;; *) printf 'UNCERTAIN' ;; esac
}
# occ_render OCC HOST MAC IP SRCNOTE → the full [lan-new-device] message for a globally-unique new MAC,
# severity-worded by occupancy. Pure (no side effects) so --test can assert every branch deterministically.
occ_render(){
  local occ="$1" host="$2" mac="$3" ip="$4" sn="$5" sev ctx
  case "$occ" in
    AWAY)   sev="(HIGH — possible intrusion) "; ctx="home UNOCCUPIED (household=AWAY) — a new globally-unique device while nobody's home is a real intrusion candidate. Investigate." ;;
    ASLEEP) sev="(elevated) ";                  ctx="household ASLEEP — a new device joining while everyone's asleep is unusual; verify it's expected." ;;
    ACTIVE) sev="(routine) ";                   ctx="household ACTIVE (awake at home) — most likely an expected device being added; logged, not alarmed." ;;
    *)      sev="";                             ctx="globally-unique MAC, never seen before. If unexpected while you're away, investigate." ;;
  esac
  printf '[lan-new-device] %sNEW device on the home LAN: %s (%s, %s) — %s%s' \
    "$sev" "${host:-?}" "$mac" "${ip:-?}" "$ctx" "$sn"
}

# Convert `ip neigh` output → DHCP-lease-shaped lines ("0 <mac> <ip> ?") so the SAME baseline +
# alarm parser handles both sources. Finds the lladdr field (robust to column order).
neigh_to_leases(){ awk '{ mac=""; for(i=1;i<=NF;i++) if($i=="lladdr") mac=$(i+1);
    if(mac!="" && $1 ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/) print "0", tolower(mac), $1, "?" }'; }

# track_unconfirmed MAC KNOWN_FILE UNCONFIRMED_FILE NOW_EPOCH — for a currently-seen MAC that is
# NOT (yet) in the baseline: records/updates its sighting, and once it's been seen on
# PROMOTE_RUNS separate calls OR has persisted PROMOTE_DAYS since first sighting, promotes it
# (appends to KNOWN_FILE, clears its tracking row) instead of leaving it to alert forever. Prints
# one of NEW / PERSISTENT / PROMOTED. Pure file I/O only (no mesh-chat) so --test is deterministic.
track_unconfirmed(){
  local mac="$1" knownf="$2" unconf="$3" now="$4" firstseen count age
  mac="$(printf '%s' "$mac" | tr 'A-F' 'a-f')"
  local row
  row="$(awk -v m="$mac" 'tolower($1)==m{f=$2; c=$3} END{if(f!="") print f, c}' "$unconf" 2>/dev/null)"
  if [ -z "$row" ]; then
    printf '%s %s 1\n' "$mac" "$now" >> "$unconf"
    printf 'NEW'; return
  fi
  firstseen="$(awk '{print $1}' <<<"$row")"; count="$(awk '{print $2}' <<<"$row")"
  count=$((count + 1)); age=$((now - firstseen))
  if [ "$count" -ge "$PROMOTE_RUNS" ] || [ "$age" -ge $((PROMOTE_DAYS * 86400)) ]; then
    grep -qixF "$mac" "$knownf" 2>/dev/null || echo "$mac" >> "$knownf"
    awk -v m="$mac" 'tolower($1)!=m' "$unconf" 2>/dev/null > "$unconf.tmp"; mv "$unconf.tmp" "$unconf"
    printf 'PROMOTED'; return
  fi
  { awk -v m="$mac" 'tolower($1)!=m' "$unconf" 2>/dev/null; printf '%s %s %s\n' "$mac" "$firstseen" "$count"; } > "$unconf.tmp"
  mv "$unconf.tmp" "$unconf"
  printf 'PERSISTENT'
}

# classify_multiplicity MAC IP NCONCURRENT PAIRS_FILE → KNOWN | SEED | NEWHOST | REBIND
#   KNOWN   this exact (mac,ip) is already baselined — nothing to say.
#   SEED    first time we've tracked IPs for this MAC (incl. the MAC-only→pair migration) — learn silently.
#   NEWHOST the MAC presents MORE concurrent hosts than its baseline → a host arrived behind the proxy.
#   REBIND  an unbaselined IP, but the host count did NOT grow → the same host moved (DHCP re-lease/roam).
# The count comparison is the whole point (see PAIRS above): it fires on GROWTH, never on a MOVE. Pure
# (file read only, no side effects) so --test can assert every branch deterministically.
classify_multiplicity(){
  local mac ip nconc pf nbase
  mac="$(printf '%s' "$1" | tr 'A-F' 'a-f')"; ip="$2"; nconc="$3"; pf="$4"
  awk -v m="$mac" -v i="$ip" 'tolower($1)==m && $2==i{found=1} END{exit !found}' "$pf" 2>/dev/null \
    && { printf 'KNOWN'; return; }
  nbase="$(awk -v m="$mac" 'tolower($1)==m{n++} END{print n+0}' "$pf" 2>/dev/null)"
  [ "${nbase:-0}" -eq 0 ] && { printf 'SEED'; return; }
  [ "$nconc" -gt "$nbase" ] && { printf 'NEWHOST'; return; }
  printf 'REBIND'
}

# record_pair MAC IP PAIRS_FILE [replace] — learn a (mac,ip). `replace` drops the MAC's other rows
# (the REBIND case: the host MOVED, so its old IP must not linger and inflate the baseline count —
# a stale row would mask the next genuine arrival by making the count look already-grown).
record_pair(){
  local mac ip pf mode
  mac="$(printf '%s' "$1" | tr 'A-F' 'a-f')"; ip="$2"; pf="$3"; mode="${4:-add}"
  touch "$pf" 2>/dev/null || return 0
  if [ "$mode" = replace ]; then
    awk -v m="$mac" 'tolower($1)!=m' "$pf" > "$pf.tmp" 2>/dev/null && mv "$pf.tmp" "$pf"
  fi
  awk -v m="$mac" -v i="$ip" 'tolower($1)==m && $2==i{found=1} END{exit !found}' "$pf" 2>/dev/null \
    || printf '%s %s\n' "$mac" "$ip" >> "$pf"
}

# newhost_render MAC IP NCONC NBASE SRCNOTE → the [lan-new-device] message for a host found behind an
# already-baselined MAC. Keeps the established marker (it IS a new device on the LAN, and
# mesh-newdevice-voice/mesh-awaydigest already consume that vocab) but words the proxy mechanism, since
# "a MAC you already trust" reads as a contradiction without it. Pure, so --test asserts it.
newhost_render(){
  printf '[lan-new-device] NEW HOST behind an ALREADY-KNOWN MAC: %s now presents %s concurrent IPs (baseline %s); newest is %s. One MAC is carrying several hosts — a MAC-translating proxy (e.g. VirtualBox bridging a VM onto a Wi-Fi station, which cannot carry a second MAC), so MAC-keying alone could never see this host. NOT a DHCP re-lease: that moves an IP without growing the count. Verify this host is expected.%s' \
    "$1" "$3" "$4" "${2:-?}" "$5"
}

# LAN-side fallback observation (Tailscale-INDEPENDENT): when the router DHCP read fails (e.g. the
# router's Tailscale is offline — a recurring SPOF), observe the LAN from THIS node, which sits on it.
# A gentle ARP sweep makes LAN devices resolve, then `ip neigh` yields their MACs. Less authoritative
# than DHCP (no hostnames; only L2-reachable devices) — so callers label it + cap confidence — but the
# security sense is no longer BLIND whenever Tailscale to the router flaps (cf. egress-via-router-lan).
lan_arp_observe(){
  command -v ip >/dev/null 2>&1 || return 0
  local myip subnet i
  myip="$(ip -4 route get 192.168.8.1 2>/dev/null | grep -oE 'src [0-9.]+' | awk '{print $2}')"
  [ -n "$myip" ] || myip="$(hostname -I 2>/dev/null | tr ' ' '\n' | grep -E '^(192\.168|10\.|172\.)' | head -1)"
  [ -n "$myip" ] || return 0
  subnet="${myip%.*}"
  for i in $(seq 1 254); do ping -c1 -W1 "$subnet.$i" >/dev/null 2>&1 & done; wait 2>/dev/null
  ip neigh show 2>/dev/null | grep -F "$subnet." | neigh_to_leases | sort -u
}

if [ "${1:-}" = --test ]; then
  command -v ssh >/dev/null 2>&1 || { echo "smoke-test: FAIL (no ssh)"; exit 1; }
  command -v awk >/dev/null 2>&1 || { echo "smoke-test: FAIL (no awk)"; exit 1; }
  mkdir -p "$HOME/.mesh" 2>/dev/null || { echo "smoke-test: FAIL (no ~/.mesh)"; exit 1; }
  [ -n "$ROUTER" ] || { echo "smoke-test: n/a (no router in ~/.mesh/nodes — nothing to watch)"; exit 2; }
  # neigh_to_leases: ip-neigh line → DHCP-lease shape ("0 <mac> <ip> ?") so the shared parser works
  r="$(printf '192.168.8.55 dev wlp0s20f3 lladdr AA:BB:CC:DD:EE:FF REACHABLE\n' | neigh_to_leases)"
  [ "$r" = "0 aa:bb:cc:dd:ee:ff 192.168.8.55 ?" ] || { echo "smoke-test: FAIL (neigh_to_leases: '$r')"; exit 1; }
  r="$(printf '192.168.8.1 dev eth0 FAILED\n' | neigh_to_leases)"   # no lladdr → dropped
  [ -z "$r" ] || { echo "smoke-test: FAIL (neigh_to_leases should drop no-lladdr: '$r')"; exit 1; }
  # occupancy-gated severity (additive): AWAY→HIGH, ASLEEP→elevated, ACTIVE→routine, UNCERTAIN→default
  m="$(occ_render AWAY host aa:bb:cc:dd:ee:ff 192.168.8.9 '')"
  printf '%s' "$m" | grep -q 'HIGH — possible intrusion' || { echo "smoke-test: FAIL (AWAY not HIGH: '$m')"; exit 1; }
  m="$(occ_render ASLEEP host aa:bb:cc:dd:ee:ff 192.168.8.9 '')"
  printf '%s' "$m" | grep -q 'elevated' || { echo "smoke-test: FAIL (ASLEEP not elevated: '$m')"; exit 1; }
  m="$(occ_render ACTIVE host aa:bb:cc:dd:ee:ff 192.168.8.9 '')"
  printf '%s' "$m" | grep -q 'routine' || { echo "smoke-test: FAIL (ACTIVE not routine: '$m')"; exit 1; }
  m="$(occ_render UNCERTAIN host aa:bb:cc:dd:ee:ff 192.168.8.9 '')"
  printf '%s' "$m" | grep -q 'If unexpected while' || { echo "smoke-test: FAIL (UNCERTAIN not default: '$m')"; exit 1; }
  # fail-open: no override + no household sense on PATH → UNCERTAIN, never a faked state
  s="$(PATH=/nonexistent occupancy_state)"
  [ "$s" = UNCERTAIN ] || { echo "smoke-test: FAIL (fail-open not UNCERTAIN: '$s')"; exit 1; }
  # persistent-unconfirmed promote: sandboxed tmp files, never the real baseline/tracking
  tmpd="$(mktemp -d)"; tk="$tmpd/known"; tu="$tmpd/unconf"; : > "$tk"; : > "$tu"
  v="$(track_unconfirmed aa:bb:cc:dd:ee:01 "$tk" "$tu" 1000)"
  [ "$v" = NEW ] || { echo "smoke-test: FAIL (1st sighting not NEW: '$v')"; exit 1; }
  v="$(track_unconfirmed aa:bb:cc:dd:ee:01 "$tk" "$tu" 1100)"
  [ "$v" = PERSISTENT ] || { echo "smoke-test: FAIL (2nd sighting, young+low-count, not PERSISTENT: '$v')"; exit 1; }
  grep -qixF aa:bb:cc:dd:ee:01 "$tk" && { echo "smoke-test: FAIL (PERSISTENT must not promote yet)"; exit 1; }
  # age-based promote: firstseen far enough in the past
  now=$(( $(awk '{print $2}' "$tu") + PROMOTE_DAYS * 86400 + 10 ))
  v="$(track_unconfirmed aa:bb:cc:dd:ee:01 "$tk" "$tu" "$now")"
  [ "$v" = PROMOTED ] || { echo "smoke-test: FAIL (aged-out sighting not PROMOTED: '$v')"; exit 1; }
  grep -qixF aa:bb:cc:dd:ee:01 "$tk" || { echo "smoke-test: FAIL (PROMOTED didn't append to baseline)"; exit 1; }
  grep -qi aa:bb:cc:dd:ee:01 "$tu" && { echo "smoke-test: FAIL (PROMOTED left a stale tracking row)"; exit 1; }
  # count-based promote (distinct mac): PROMOTE_RUNS calls, all fresh timestamps (no age trigger)
  mac2=aa:bb:cc:dd:ee:02; t=2000
  for _ in $(seq 1 "$PROMOTE_RUNS"); do v="$(track_unconfirmed "$mac2" "$tk" "$tu" "$t")"; t=$((t+1)); done
  [ "$v" = PROMOTED ] || { echo "smoke-test: FAIL (count threshold not PROMOTED: '$v')"; exit 1; }
  rm -rf "$tmpd"
  # --allow: idempotent baseline append against a sandboxed KNOWN, never the real file
  tk2="$(mktemp -u)"; : > "$tk2"
  MESH_LAN_KNOWN="$tk2" "$0" --allow AA:BB:CC:DD:EE:03 >/dev/null
  MESH_LAN_KNOWN="$tk2" "$0" --allow aa:bb:cc:dd:ee:03 >/dev/null
  n="$(grep -cix aa:bb:cc:dd:ee:03 "$tk2")"
  [ "$n" = 1 ] || { echo "smoke-test: FAIL (--allow not idempotent: $n rows)"; rm -f "$tk2"; exit 1; }
  rm -f "$tk2"
  # ---- multiplicity keying (proxied hosts) — pure branches ----
  tp="$(mktemp -d)"; pf="$tp/pairs"; printf '7c:c3:a1:a5:20:d7 192.168.8.214\n' > "$pf"
  v="$(classify_multiplicity 7c:c3:a1:a5:20:d7 192.168.8.214 1 "$pf")"
  [ "$v" = KNOWN ] || { echo "smoke-test: FAIL (baselined pair not KNOWN: '$v')"; rm -rf "$tp"; exit 1; }
  v="$(classify_multiplicity 7c:c3:a1:a5:20:d7 192.168.8.242 2 "$pf")"     # concurrent with .214 → growth
  [ "$v" = NEWHOST ] || { echo "smoke-test: FAIL (2nd concurrent host not NEWHOST: '$v')"; rm -rf "$tp"; exit 1; }
  v="$(classify_multiplicity 7c:c3:a1:a5:20:d7 192.168.8.242 1 "$pf")"     # .214 gone → a MOVE, not growth
  [ "$v" = REBIND ] || { echo "smoke-test: FAIL (DHCP re-lease not REBIND: '$v')"; rm -rf "$tp"; exit 1; }
  v="$(classify_multiplicity de:ad:be:ef:00:01 192.168.8.9 1 "$pf")"       # no rows for this mac yet
  [ "$v" = SEED ] || { echo "smoke-test: FAIL (untracked mac not SEED: '$v')"; rm -rf "$tp"; exit 1; }
  rm -rf "$tp"
  # ---- multiplicity keying — the REAL script, end-to-end, asserting the BOARD ARTIFACT ----
  # MESH_DIR sandboxes the real mesh-chat's log, so this gate drives the REAL sink yet can never write
  # the board a human reads (the mesh-guardian forged-liveness trap, 09f7914); MESH_LAN_BEAT likewise
  # keeps it off the beat mesh-reflex-health ages. MESH_CHAT_DEDUPE=0 so the no-refire assertions test
  # OUR edge-trigger and not mesh-chat's suppression — a gate that passes because the SINK deduped
  # asserts nothing about the sense.
  td="$(mktemp -d)"; lf="$td/leases"
  run_status(){ MESH_DIR="$td" MESH_ROUTER=192.168.8.1 MESH_LAN_LEASES_FILE="$lf" \
      MESH_LAN_KNOWN="$td/known" MESH_LAN_KNOWN_PAIRS="$td/pairs" MESH_LAN_UNCONFIRMED="$td/unconf" \
      MESH_LAN_BEAT="$td/beat" MESH_CHAT_TARGETS="" MESH_CHAT_SELFDERIVE=0 MESH_CHAT_DEDUPE=0 \
      "$0" --status 2>/dev/null; }
  nposts(){ local n; n="$(grep -c 'lan-new-device' "$td/chat.log" 2>/dev/null)"; printf '%s' "${n:-0}"; }
  printf '7c:c3:a1:a5:20:d7\n80:56:f2:a7:90:61\n' > "$td/known"
  # 1) migration/seed run: the CURRENT topology is the baseline, never an alert
  printf '0 7c:c3:a1:a5:20:d7 192.168.8.214 imac\n0 80:56:f2:a7:90:61 192.168.8.130 tv\n' > "$lf"
  run_status >/dev/null
  [ "$(nposts)" = 0 ] || { echo "smoke-test: FAIL (pair-seed run alerted on pre-existing topology: $(nposts))"; rm -rf "$td"; exit 1; }
  [ -f "$td/beat" ] || { echo "smoke-test: FAIL (MESH_LAN_BEAT override not honoured — the gate would forge the real liveness beat)"; rm -rf "$td"; exit 1; }
  # 2) a re-seen (mac,ip) stays silent
  run_status >/dev/null
  [ "$(nposts)" = 0 ] || { echo "smoke-test: FAIL (re-seen (mac,ip) alerted: $(nposts))"; rm -rf "$td"; exit 1; }
  # 3) THE FALSE-POSITIVE EDGE — a DHCP re-lease moves the TV .130→.131. Count holds at 1, so it must
  #    stay silent: pair-keying without this would alert on every routine re-lease and turn a security
  #    sense into a noise source (very likely why the baseline keys on MAC today).
  printf '0 7c:c3:a1:a5:20:d7 192.168.8.214 imac\n0 80:56:f2:a7:90:61 192.168.8.131 tv\n' > "$lf"
  run_status >/dev/null
  [ "$(nposts)" = 0 ] || { echo "smoke-test: FAIL (DHCP re-lease alerted — the noise regression this design exists to avoid: $(nposts))"; rm -rf "$td"; exit 1; }
  grep -q '80:56:f2:a7:90:61 192.168.8.131' "$td/pairs" || { echo "smoke-test: FAIL (rebind didn't relearn the moved ip)"; rm -rf "$td"; exit 1; }
  [ "$(grep -c '^80:56:f2:a7:90:61' "$td/pairs")" = 1 ] || { echo "smoke-test: FAIL (rebind left a stale row — an inflated count masks the next genuine arrival)"; rm -rf "$td"; exit 1; }
  # 4) THE FIND (measured live on mesh-home): a 2nd host proxied behind the baselined iMac MAC — the
  #    case that was structurally un-alertable — must fire exactly one [lan-new-device].
  printf '0 7c:c3:a1:a5:20:d7 192.168.8.214 imac\n0 7c:c3:a1:a5:20:d7 192.168.8.242 ilya\n0 80:56:f2:a7:90:61 192.168.8.131 tv\n' > "$lf"
  out="$(run_status)"
  [ "$(nposts)" = 1 ] || { echo "smoke-test: FAIL (2nd host behind a baselined MAC didn't fire exactly one [lan-new-device]: $(nposts))"; rm -rf "$td"; exit 1; }
  grep -q 'NEW HOST behind an ALREADY-KNOWN MAC' "$td/chat.log" || { echo "smoke-test: FAIL (alert lacks the proxy wording)"; rm -rf "$td"; exit 1; }
  printf '%s' "$out" | grep -q '192.168.8.242' || { echo "smoke-test: FAIL (--status stdout doesn't name the proxied host)"; rm -rf "$td"; exit 1; }
  # 5) now baselined → edge-triggered, no re-fire every 15m
  run_status >/dev/null
  [ "$(nposts)" = 1 ] || { echo "smoke-test: FAIL (baselined pair re-fired — edge-trigger broken: $(nposts))"; rm -rf "$td"; exit 1; }
  rm -rf "$td"
  echo "smoke-test: ok (neigh-parse: 2 + occupancy-gate: 5 + unconfirmed-promote: 5 + allow-idempotent: 1 + multiplicity-pure: 4 + multiplicity-artifact: 10 assertions)"; exit 0
fi

if [ "${1:-}" = --allow ]; then
  mac="${2:-}"
  [ -n "$mac" ] || { echo "usage: mesh-lan-newdevice --allow <mac>"; exit 1; }
  mac="$(printf '%s' "$mac" | tr 'A-F' 'a-f')"
  mkdir -p "$(dirname "$KNOWN")" 2>/dev/null
  : > "${KNOWN}.lock.$$" 2>/dev/null; rm -f "${KNOWN}.lock.$$" 2>/dev/null
  touch "$KNOWN" 2>/dev/null
  grep -qixF "$mac" "$KNOWN" 2>/dev/null || echo "$mac" >> "$KNOWN"
  if [ -f "$UNCONFIRMED" ]; then
    awk -v m="$mac" 'tolower($1)!=m' "$UNCONFIRMED" > "$UNCONFIRMED.tmp" 2>/dev/null && mv "$UNCONFIRMED.tmp" "$UNCONFIRMED"
  fi
  echo "baseline: $mac confirmed + appended (idempotent)"
  exit 0
fi

[ "${1:-}" = --forget ] && { rm -f "$KNOWN"; echo "baseline forgotten — next run re-seeds"; exit 0; }
[ -n "$ROUTER" ] || { echo "no router in ~/.mesh/nodes — nothing to watch on this node"; exit 0; }
mkdir -p "$HOME/.mesh"

# DHCP lease line: <expiry> <mac> <ip> <hostname> <client-id>
# MESH_LAN_LEASES_FILE substitutes the OBSERVATION (the LAN itself — genuinely uncontrollable from a
# test, and the only reason it exists) so --test can drive the REAL script's REAL keying/alert path
# against a fixture topology. It stubs the source, never the logic under test; the live source paths
# below stay exercised by every real run.
if [ -n "${MESH_LAN_LEASES_FILE:-}" ]; then
  leases="$(cat "$MESH_LAN_LEASES_FILE" 2>/dev/null)"
  LAN_SRC="file"
else
leases="$(timeout 12 "${SSH[@]}" "$RUSER@$ROUTER" 'cat /tmp/dhcp.leases 2>/dev/null' </dev/null 2>/dev/null)"
LAN_SRC="dhcp"
if [ -z "$leases" ]; then
  # Router DHCP unreachable → Tailscale-independent LAN-side fallback (see lan_arp_observe).
  leases="$(lan_arp_observe)"
  LAN_SRC="arp"
fi
fi
[ -n "$leases" ] || { echo "router DHCP + LAN ARP both unreachable — can't assess (not an alarm)"; exit 0; }
# liveness heartbeat: this silent-on-no-news reflex has no other per-run artifact, so prove it
# actually OBSERVED the LAN this run (router reachable + leases read) for mesh-reflex-health. Placed
# AFTER the lease read so a router outage (watch silently non-functional) lets the beat go stale.
: > "$BEAT"

if [ "${1:-}" = --status ]; then
  echo "known LAN devices: $(wc -l < "$KNOWN" 2>/dev/null || echo 0)"
  echo "source: $LAN_SRC$([ "$LAN_SRC" = arp ] && echo ' (router DHCP unreachable — LAN-side ARP fallback)')"
  echo "--- current leases (host / ip / mac) ---"
  printf '%s\n' "$leases" | awk '{printf "  %-22s %-15s %s\n", $4, $3, $2}'
  # This is the path mesh-perimeter --edge actually calls every 45m (read-only by design) — the
  # default/bare invocation below that self-learns on first sight has no cron entry of its own, so
  # unconfirmed-device tracking + promotion has to happen here or it never happens at all.
  if [ -f "$KNOWN" ] || [ -n "$leases" ]; then
    touch "$KNOWN" 2>/dev/null
    now="$(date +%s)"; promoted=""
    unconfirmed_out=""
    newhost_out=""
    # MAC-only→pair migration: the FIRST run under multiplicity-keying takes the CURRENT topology as
    # the baseline, silently. Without this, mesh-home's pre-existing .214+.242-behind-one-MAC would
    # read as growth (1→2) and alert on a VM that has been there all along — the same silent-seed
    # doctrine the DHCP→ARP fallback merge below already follows for the same reason.
    pairs_seeded=0
    if [ ! -f "$PAIRS" ]; then
      printf '%s\n' "$leases" | awk 'NF>=2{print tolower($2), $3}' | sort -u > "$PAIRS" 2>/dev/null
      pairs_seeded=1
    fi
    while read -r mac ip; do
      [ -n "$mac" ] || continue
      if grep -qixF "$mac" "$KNOWN" 2>/dev/null; then
        # A baselined MAC used to `continue` here — and THAT was the blind spot: it retired the MAC
        # from scrutiny, so a second host proxied behind it was never examined at all. Keep watching
        # its host COUNT (see PAIRS at the top for why a count and not the (mac,ip) pair).
        [ "$pairs_seeded" = 1 ] && continue
        nconc="$(printf '%s\n' "$leases" | awk -v m="$mac" 'NF>=2 && tolower($2)==m{print $3}' | sort -u | wc -l)"
        nbase="$(awk -v m="$mac" 'tolower($1)==m{n++} END{print n+0}' "$PAIRS" 2>/dev/null)"
        case "$(classify_multiplicity "$mac" "$ip" "$nconc" "$PAIRS")" in
          NEWHOST)
            record_pair "$mac" "$ip" "$PAIRS"
            newhost_out+="  $mac ($ip) — NEW HOST behind a baselined MAC ($nconc concurrent IPs vs baseline $nbase)"$'\n'
            src_note=""
            [ "$LAN_SRC" = arp ] && src_note=" [via LAN ARP fallback — router DHCP unreachable, no hostname, lower confidence]"
            command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="lan-watch@$(hostname)" \
              mesh-chat "$(newhost_render "$mac" "$ip" "$nconc" "$nbase" "$src_note")" >/dev/null 2>&1
            ;;
          REBIND) record_pair "$mac" "$ip" "$PAIRS" replace ;;
          SEED)   record_pair "$mac" "$ip" "$PAIRS" ;;
        esac
        continue
      fi
      verdict="$(track_unconfirmed "$mac" "$KNOWN" "$UNCONFIRMED" "$now")"
      case "$verdict" in
        NEW)        unconfirmed_out+="  $mac ($ip) — new, first seen this run"$'\n' ;;
        PERSISTENT) unconfirmed_out+="  $mac ($ip) — persistent unconfirmed (below promote threshold)"$'\n' ;;
        PROMOTED)   unconfirmed_out+="  $mac ($ip) — PROMOTED to baseline this run"$'\n'; promoted+=" $mac" ;;
      esac
    done < <(printf '%s\n' "$leases" | awk 'NF>=2{print $2, $3}' | sort -u)
    if [ -n "$unconfirmed_out" ]; then
      echo "--- unconfirmed (seen, not yet baselined) ---"
      printf '%s' "$unconfirmed_out"
    fi
    if [ -n "$newhost_out" ]; then
      echo "--- new host(s) behind a known MAC (proxied — MAC-keying is blind to these) ---"
      printf '%s' "$newhost_out"
    fi
    if [ -n "$promoted" ]; then
      command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="lan-watch@$(hostname)" \
        mesh-chat "[lan-baseline-promote] auto-confirmed after repeated sightings/age threshold:$promoted — perimeter's NETWORK axis should stop ALERTing on these now" >/dev/null 2>&1
    fi
  fi
  exit 0
fi

# first run: seed the baseline silently — existing devices are KNOWN, not intrusions
if [ ! -f "$KNOWN" ]; then
  printf '%s\n' "$leases" | awk 'NF>=2{print $2}' | sort -u > "$KNOWN"
  echo "seeded baseline: $(wc -l < "$KNOWN") known device(s) (no alerts on first run)"
  exit 0
fi

# First ARP-FALLBACK reconciliation: the ARP view is a DIFFERENT population than the DHCP-seeded
# baseline (static-IP devices, L2-only reachables). On the FIRST fallback, MERGE current ARP MACs
# into the baseline SILENTLY (no alert) so the DHCP↔ARP discrepancy doesn't flood [lan-new-device];
# only devices appearing AFTER this fallback baseline is established are real intrusion signals.
ARP_SEEDED="$HOME/.mesh/.lan-arp-seeded"
if [ "$LAN_SRC" = arp ] && [ ! -f "$ARP_SEEDED" ]; then
  merged=0
  while read -r mac; do
    [ -n "$mac" ] || continue
    grep -qixF "$mac" "$KNOWN" 2>/dev/null && continue
    echo "$mac" >> "$KNOWN"; merged=$((merged + 1))
  done < <(printf '%s\n' "$leases" | awk 'NF>=2{print $2}')
  : > "$ARP_SEEDED"
  echo "LAN ARP fallback first run: merged $merged previously-unseen MAC(s) into baseline silently (router DHCP unreachable; no false alerts on the DHCP↔ARP population discrepancy)"
  exit 0
fi

new=0
while read -r mac host ip; do
  [ -n "$mac" ] || continue
  grep -qixF "$mac" "$KNOWN" 2>/dev/null && continue   # already known
  echo "$mac" >> "$KNOWN"                               # learn it (alert once)
  [ -f "$UNCONFIRMED" ] && { awk -v m="$mac" 'tolower($1)!=m' "$UNCONFIRMED" > "$UNCONFIRMED.tmp" 2>/dev/null && mv "$UNCONFIRMED.tmp" "$UNCONFIRMED"; }
  new=$((new + 1))
  src_note=""
  [ "$LAN_SRC" = arp ] && src_note=" [via LAN ARP fallback — router DHCP unreachable, no hostname, lower confidence]"
  if is_laa "$mac"; then
    msg="[lan-new-device] (low) private/rotating MAC joined the LAN: ${host:-?} ($mac, ${ip:-?}) — locally-administered address (iOS/Android Wi-Fi randomization), most likely a KNOWN device with a new random MAC, not a newcomer. Only suspicious if you expected no one.${src_note}"
  else
    # globally-unique unknown MAC = the real intrusion candidate → occupancy-gate the severity
    msg="$(occ_render "$(occupancy_state)" "$host" "$mac" "$ip" "$src_note")"
  fi
  command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="lan-watch@$(hostname)" \
    mesh-chat "$msg" >/dev/null 2>&1
done < <(printf '%s\n' "$leases" | awk 'NF>=4{print $2, $4, $3}')
# silent when nothing new (the baseline file proves it ran) — only speak on a real new device
[ "$new" -gt 0 ] && echo "$new new device(s) alerted"
# Immune watcher: after every LAN check, also scan for unapproved SSH keys + new TS nodes
command -v mesh-immune-watcher >/dev/null 2>&1 && mesh-immune-watcher --check >/dev/null 2>&1
exit 0
