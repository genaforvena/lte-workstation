#!/usr/bin/env bash
# reflex-cadence: 23 * * * *
# reflex-args: --cron
# mesh-doctor — comprehensive "is the mesh actually WORKING, not just UP?" self-diagnostic.
#
# Born from a session of finding "UP-but-broken" bugs by hand. mesh-supervise says a loop is UP;
# mesh-doctor checks it actually FUNCTIONS. It codifies every failure class found the hard way:
#   - egress regressed off the clean router-LAN path        (silent SPOF return)
#   - a declared organ that can't be exercised (hollow)     (camera: device but no tool)
#   - an organ whose default path is broken                 (mic: default alsa dev down)
#   - a reflex that ERRORS every run while showing UP       (mind-watch: malformed cron)
#   - a tool that HANGS on a dead hardcoded peer            (mesh-find/presence-fuse: no ConnectTimeout)
#   - a malformed cron line (env-var parsed as command)
#   - a tool whose --test smoke check fails
#
#   mesh-doctor            run all checks; human report; exit = number of FAILs (0 = healthy)
#   mesh-doctor --quiet    only WARN/FAIL lines + summary (for cron/alerting)
#   mesh-doctor --test     smoke test
#   mesh-doctor --sediment report-only: do this node's environment-side config knobs still regulate
#                          anything? (~/.mesh/nodes: UNREAD / REDUNDANT / ACTIVE · canonical vs
#                          alternative vs unactualized against the committed nodes.example)
#   mesh-doctor --nontrivial [N] report-only: are our own `--test`s TRIVIAL machines? Runs a rotated
#                          sample of N tools' --test three times and classifies the exit-code sequence
#                          (TRIVIAL / EIGEN / UNSTABLE) with a self-write discriminator (rc 3 on a finding)
#   mesh-doctor --exclusion report-only: do the READERS of one sense agree on when it is too old?
#                          Each reader carries its own max-age integer and nothing compares them
#                          (SPLIT / UNSATISFIABLE / AGREED / SINGLE-READER; rc 3 on a finding)
#   mesh-doctor --supersede report-only, the REVERSE direction of every freshness check we own: which
#                          state artifacts were computed BEFORE a knob their producer reads changed?
#                          (CURRENT / SUPERSEDED / UNKNOWN-CURRENT / INDEPENDENT; rc 3 on a finding)
# umwelt-ok: this file's own `.mesh/.doctor-*-state` strings are internal debounce bookkeeping (the
# orphan/umwelt-check confirm-across-2-runs state), not a sense's declared output — self-contained
# by design, not a producer the umwelt check below should judge itself against.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
Q=0; CRON=0

# A `# reflex-cadence:` header whose value declares an UNSCHEDULED intent (none/off/manual/on-demand)
# is a self-declaration of intentional-unwired — the same meaning as `# orphan-ok:`, expressed via the
# cadence convention (reflex-cadence is often PROSE: `none`/`off`/`on-demand`, not a cron — see the
# autowire/cadence handling). Returns 0 if $1 carries such a header. A REAL cron value (e.g.
# `*/5 * * * *`) is deliberately NOT matched: a tool that DECLARES a schedule but lacks its crontab
# line stays a genuine orphan (the orphan WARN must still catch that).
cadence_is_ondemand(){ grep -Eiq '^#[[:space:]]*reflex-cadence:[[:space:]]*(none|off|manual|on-?demand)([^a-z0-9]|$)' "$1" 2>/dev/null; }

# canon_section: extract the ONE section of CLAUDE.md that declares intent — "On-demand canon
# (intentionally unwired — NOT orphans)" — from $1 (a CLAUDE.md path). Every reader of the canon
# rule must go through this, so there is a single definition of WHERE intent is declared.
canon_section(){ awk '/On-demand canon/,/^## Capabilities/' "$1" 2>/dev/null; }

# canon_declares: does the canon section text $2 name tool $1 as intentionally-unwired? Matches the
# backticked name bare (`name`) or with inline args (`name <device>`). ONLY $2 is consulted — never
# a whole CLAUDE.md. The tooling catalog says what a tool IS; only the canon says it is deliberately
# unwired, and a check that cannot tell those apart exempts a tool for being DOCUMENTED.
canon_declares(){ printf '%s\n' "$2" | grep -Eq "\`$(printf '%s' "$1" | sed 's/[.]/\\./g')(\`| )" 2>/dev/null; }

# invoked_by_other: does ANY comment-stripped script in corpus dir $2, OTHER than tool $1's own copy,
# invoke $1 as a standalone token ($3 = the token regex)? Returns 0 if so.
#
# NO PIPE, DELIBERATELY. The old form was:
#   grep -lE "$tok" "$DIR"/* | grep -Fxqv "$DIR/$name" && found=1
# and this file runs under `set -uo pipefail` (:22). `grep -q` exits at the FIRST non-own-path line,
# closing the pipe while `grep -l` is still scanning hundreds of files — upstream dies of SIGPIPE
# (PIPESTATUS=141 0), pipefail promotes 141 to the pipeline's rc, and `&& found=1` never fires. So
# the check could only ever answer "not invoked", and the answer INVERTED with popularity: the more
# scripts invoked a tool, the earlier the first match, the more of the corpus was left to scan, the
# more certainly it SIGPIPE'd. Measured on the live 555-file corpus: mesh-chat (127 invokers) was
# misread "not invoked" 10/10 runs, while mesh-trace (40) and mesh-tell (29) came out right 10/10.
# The 2026-06-13 "RANDOM false orphans / flakes under system load" note above blamed O(n²) subprocess
# flake and pre-stripped the corpus to fix it; that reduced the scan time and so the SIGPIPE window,
# which is why the flake got better but never went away. --exclude drops the tool's own file inside
# the ONE grep, so there is no second stage to race with.
invoked_by_other(){ local _inv; _inv=$(grep -lE "$3" --exclude="$1" "$2"/* 2>/dev/null || true); [ -n "$_inv" ]; }

# umwelt_slug: the state artifact tool $1 declares as its OWN output — the basename under `.mesh/`.
# TWO naming conventions are live in the genome and BOTH must be seen: `.mesh/.foo.state` and
# `.mesh/.foo-state`. The check read only the first for its whole life, so most of the emitter
# population (measured 2026-08-10: 64 tools seen, 210 after this fix) — including BOTH of the
# dead-vehicle cases the 2026-06-20 biosemiotics review verified
# by hand (mesh-diskio `.diskio-state`, mesh-wifi-quality `.wifi-quality-state`) — was invisible to
# the very check meant to catch them. A LEADING DOT stays required: `.mesh/vote-state/<topic>.json`
# is a DIRECTORY, and matching it made mesh-vote read as an emitter with no reader.
# Only DECLARATION lines are consulted — a line-initial assignment (optionally `local`/`export`/
# `declare`/`readonly`) or a comment. A `.mesh/...state` string in ordinary text is prose, not an
# output: mesh-interpret embeds a whole fake doctor-warn board line ("~/.mesh/.foo-state mtime is 9
# DAYS old") in a prompt fixture, and reading it as that tool's declared artifact invented a dead
# vehicle out of an example. Anchoring the assignment at line start is load-bearing — the same
# fixture line ends `with rc=0`, so a floating `NAME=` match resurrects it.
# On such a line the slug is taken after a `/` OR after an opening quote, not only after a literal
# `.mesh/`: the mesh dir is routinely already in a variable (`STATE="$MESH_DIR/.reclaim-mode.state"`,
# python `STATE = os.path.join(MESHDIR, ".witness-analyze.state")`). Requiring `.mesh/` meant those
# were seen only when some COMMENT happened to spell the path out — mesh-witness-analyze's did, in a
# docstring, and the tool's visibility to this check rested on that accident.
umwelt_slug(){
  grep -E '^[[:space:]]*(#|((local|export|readonly|declare)[[:space:]]+(-[a-zA-Z]+[[:space:]]+)?)*[A-Za-z_][A-Za-z0-9_]*[[:space:]]*=)' "$1" 2>/dev/null \
    | grep -E '(\.mesh/|MESH[A-Z_]*)' \
    | grep -oP '(?<=[/"'"'"'])\.[A-Za-z0-9_.-]*(\.state|-state)\b' | head -1
}

# um_body: tool source with comments stripped, `${VAR}` normalised to `$VAR`, AND the tool's own
# `--test` block removed. A read of the live state inside --test is the TEST inspecting its sandbox
# (mesh-heat-source and mesh-battery-energy both `stat` their live artifact there purely to assert
# the fixture did NOT stamp it) — counting that would let a write-only sense earn a temporal
# interpretant from its own harness, the "test forges the evidence it exists to check" shape.
# THREE OPENERS, NOT ONE — and the terminator is a property of the OPENER (2026-08-18).
# The first version knew only `if/elif … --test … then` (→ bare `fi`) and the case arm `--test)`
# (→ bare `;;`). Measured over the live corpus that day: **49 tools** open their smoke test with a
# BRACE GROUP — `[ "${1:-}" = --test ] && {` … `}` (mesh-node-power, mesh-land, mesh-restore,
# mesh-operator-home, mesh-situation, …) and **7 more** behind a MODE dispatch
# (`--test) MODE=test ;;` … later `if [ "$MODE" = "test" ]; then`, e.g. mesh-activity,
# mesh-proximity). Neither form matched, so for 56 tools um_body returned the ENTIRE `--test`
# block as if it were production code — the exact inversion of this function's purpose, and it
# fed both `um_self_reads` (which is the load-bearing half of the umwelt check) and --supersede's
# knob-dependency scan. Verified two ways on mesh-node-power: its sandbox writes at :98/:102/:104
# survived un-stripped, and the tool was consequently scored a CO-WRITER of another tool's
# `.conservation-state` when it only ever READS it.
#
# The brace-group form is closed by BRACE DEPTH, not by a line pattern: mesh-land ends its test with
# `echo "smoke-test: ok"; exit 0; }` — the `}` is the tail of a code line, and the block is full of
# `|| { echo FAIL; exit 1; }` one-liners, so neither "a bare `}`" nor "a line ending in `}`" can
# find the edge. Net depth is robust to both (a one-liner is balanced on its own line) and to the
# balanced `{}` of embedded awk programs and `${…}` expansions.
#
# The MODE form was wrong in BOTH directions at once. `--test) MODE=test ;;` matched the case-arm
# opener, so intest went high on an ARG-PARSE line and stayed high until the next bare `;;` —
# eating innocent parse arms — while the real test body further down was never recognised at all.
# A one-line arm (`;;` on the same line) is arg parsing and now opens nothing.
#
# So: derive the terminator FROM the opener (`&& {` → a column-0 `}` · `then` / if-form → a
# column-0 `fi` · case arm → a bare `;;`) instead of accepting any of them for any block. The
# column-0 requirement on `fi`/`}` is deliberate and unchanged from the original: a nested `fi`
# inside the test block must not end it. The `&& {` branch additionally requires a bracket
# COMPARISON on the line (`[ … = … ]`), so a line that merely RUNS another tool's --test
# (`mesh-lid --test && {`) is not mistaken for this tool's own block.
um_body(){
  sed -e 's/#.*//' -e 's/\${\([A-Za-z_][A-Za-z0-9_]*\)}/$\1/g' "$1" 2>/dev/null | awk '
    # net depth of SHELL GROUP braces on a line. Counting every { and } would never close: `${1:-}`
    # is balanced but `$\{` is not a group, an awk program `\047{print}\047` is not shell at all, and a
    # regex class `[{]` is neither. So: skip single-quoted spans (that is where awk/sed programs
    # live), require an opening `{` to be preceded by something other than `$` and followed by
    # whitespace/EOL, and a closing `}` to be preceded by whitespace or `;`.
    function braces(s,   i,c,q,prev,nxt,o,cl,L) {
      o=0; cl=0; q=0; dq=0; L=length(s)
      for (i=1;i<=L;i++) {
        c=substr(s,i,1)
        # double-quoted spans FIRST: an apostrophe inside one ("the bit\047s contract") is not a
        # quote opener, and treating it as one swallowed the rest of the line — including the `}`
        # that closed the group — which is exactly how a whole file got over-stripped.
        if (c=="\"" && !q) { dq=!dq; continue }
        if (dq) continue
        if (c=="\047") { q=!q; continue }
        if (q) continue
        prev=(i>1)?substr(s,i-1,1):" "
        nxt=(i<L)?substr(s,i+1,1):" "
        if (c=="{" && prev!="$" && (nxt==" "||nxt=="\t"||i==L)) o++
        else if (c=="}" && (prev==" "||prev==";"||prev=="\t")) cl++
      }
      return o-cl
    }
    !intest {
      isopen = 0
      if ($0 ~ /--test/) isopen = 1
      else if ($0 ~ /\[+[[:space:]]*"?\$\{?MODE\}?"?[[:space:]]*=[[:space:]]*"?test"?/) isopen = 1
      # a ONE-LINE construct opens nothing: `--test) MODE=test ;;` is arg parsing, and
      # `if [ "$1" = --test ] || [ "$SANDBOX" = 1 ]; then LOCK=...; fi` is a sandbox knob. Both were
      # read as block openers (the `;;` case by the original code too), and because their terminator
      # is on the same line the block then ran to the next unrelated `fi`/`;;` — over-stripping the
      # whole file (mesh-gpu-lid, mesh-turbo-lid, mesh-convexity, mesh-ss-clients, mesh-forage).
      if (isopen && $0 !~ /;;[[:space:]]*$/ && $0 !~ /;[[:space:]]*fi[[:space:]]*$/ && $0 !~ /[[:space:]]fi[[:space:]]*$/) {
        if ($0 ~ /&&[[:space:]]*\{[[:space:]]*$/ && $0 ~ /\[[^]]*=[^]]*test/) { intest=1; term="depth"; depth=1; next }
        if ($0 ~ /^[[:space:]]*(if|elif)/ && $0 ~ /then[[:space:]]*$/)          { intest=1; term="fi"; next }
        if ($0 ~ /^[[:space:]]*(if|elif)[^;]*--test/)                           { intest=1; term="fi"; next }
        if ($0 ~ /^[[:space:]]*[^)|]*--test\)/)                                { intest=1; term=";;"; next }
      }
    }
    intest && term == "fi" && /^fi[[:space:]]*$/           { intest=0; next }
    intest && term == "depth" {
      depth += braces($0)
      if (depth <= 0) { intest=0 }
      next
    }
    intest && term == ";;" && /^[[:space:]]*;;[[:space:]]*$/ { intest=0; next }
    !intest { print }'
}

# um_self_reads <file> <slug>: does the tool CONSUME its own state artifact — is the interpretant
# its own FUTURE RUN? Peirce's infinite semiosis: a sign's interpretant may be the same system at a
# later time, so edge/debounce/rate-baseline state (written now, read back next run to answer
# "changed?") closes a real loop and is NOT a dead vehicle. The 2026-06-20 review's crude scan had
# no such rule and over-counted 12 of 33 by its own admission; measured here 2026-08-10 it excludes
# 49 of 62 candidates. It is the load-bearing half of the check, not a refinement. (Both figures are
# that day's answer on a live, growing corpus — the CLAIM is the gate; re-derive, never quote.)
#
# Occurrence-level classification, NOT a line grep: `[ -f "$STATE" ] && prev="$(cut -d'|' -f1
# "$STATE")"` mentions the var twice, once as a bare test and once as a real read, and a line-level
# `reader-cmd .* $VAR` regex both mis-fires on `cat foo > "$STATE"` and dies on the `|` inside
# `-d'|'`. So each occurrence is judged by what immediately precedes it: `>`/`>>` = write (skip),
# `<` = read, otherwise a reader command word earlier on the line = read. A bare `[ -f "$STATE" ]`
# is deliberately NOT a read — existence is not content.
#
# Var names are matched CASE-INSENSITIVELY against every name assigned from the slug (incl. under
# `local`/`export`/`declare`), and the scan follows ONE level of function indirection: the genome's
# convention hands the state path to a helper — `read_prev_label "$STATE"` in mesh-mesh-state,
# `load_nudge_state "$STATE_FILE"` in mesh-sweep-rollcall-proposes — and the actual read happens on
# that helper's `local f="$1"`. A grep cannot follow a parameter, so a same-file function whose body
# read-positions its own `$1` marks every call site that receives the state path as consumption.
# Both misses were REAL false dead-vehicles before this leg existed. Depth stays at one: deeper
# chains fall through to a WARN, and `# umwelt-ok:` remains the explicit hatch.
um_self_reads(){
  um_body "$1" | awk -v slug="$2" '
    function readpos(line, tok,   i, pre, rest, lt) {
      rest = line; lt = tolower(tok)
      while ((i = index(tolower(rest), lt)) > 0) {
        pre = substr(rest, 1, i - 1); rest = substr(rest, i + length(tok))
        if (pre ~ />>?[[:space:]]*"?[[:space:]]*$/) continue
        if (pre ~ /<[[:space:]]*"?[[:space:]]*$/) return 1
        if (pre ~ RD) return 1
        if (nfr && pre ~ ("(^|[^A-Za-z0-9_-])(" FR ")[[:space:]]+[\"'"'"']?$")) return 1
      }
      return 0
    }
    BEGIN { RD = "(^|[^A-Za-z0-9_-])(cat|head|tail|grep|egrep|awk|sed|cut|tr|wc|jq|sort|uniq|tac|stat|read|mapfile|readarray|source|open)([^A-Za-z0-9_-]|$)" }
    { L[NR] = $0
      if (index($0, slug) > 0 &&
          match($0, /^[[:space:]]*(local[[:space:]]+|export[[:space:]]+|readonly[[:space:]]+|declare[[:space:]]+-?[a-zA-Z]*[[:space:]]+)*[A-Za-z_][A-Za-z0-9_]*[[:space:]]*=/)) {
        v = substr($0, RSTART, RLENGTH); sub(/[[:space:]]*=$/, "", v); sub(/^.*[[:space:]]/, "", v)
        vars[tolower(v)] = 1
      }
      # same-file function bodies, for the one-level parameter hop. A ONE-LINER (`f(){ ...; }`)
      # closes on its own line: without this, infn stays set and the next function-with-a-real-read
      # gets attributed to it, so a write-only helper inherits a read it never does.
      if (!infn && match($0, /^[[:space:]]*[A-Za-z_][A-Za-z0-9_-]*[[:space:]]*\(\)/)) {
        fname = substr($0, RSTART, RLENGTH); sub(/[[:space:]]*\(\)$/, "", fname); sub(/^[[:space:]]*/, "", fname)
        if ($0 ~ /\}[[:space:]]*$/) { FB[fname] = $0 } else { infn = 1; FB[fname] = "" }
      } else if (infn) {
        if ($0 ~ /^[[:space:]]*}[[:space:]]*$/) infn = 0; else FB[fname] = FB[fname] "\n" $0
      } }
    END {
      # a helper "reads its argument" if its body read-positions $1 or a local bound to $1
      for (fn in FB) {
        nb = split(FB[fn], B, "\n"); delete pv; np = 0
        for (b = 1; b <= nb; b++)
          if (match(B[b], /(local|declare)[[:space:]]+[A-Za-z_][A-Za-z0-9_]*="?\$1/)) {
            pvn = substr(B[b], RSTART, RLENGTH); sub(/="?\$1$/, "", pvn); sub(/^.*[[:space:]]/, "", pvn)
            pv[++np] = "$" pvn
          }
        for (b = 1; b <= nb; b++) {
          if (readpos(B[b], "$1")) { fr[fn] = 1; break }
          for (p = 1; p <= np; p++) if (readpos(B[b], pv[p])) { fr[fn] = 1; break }
          if (fn in fr) break
        }
      }
      FR = ""; for (fn in fr) { FR = FR (FR == "" ? "" : "|") fn; nfr++ }
      for (n = 1; n <= NR; n++) {
        if (readpos(L[n], slug)) exit 0
        for (v in vars) {
          if (readpos(L[n], "$" v)) exit 0
          if (tolower(L[n]) ~ ("open\\([[:space:]]*" v "[,)]")) exit 0
        }
      }
      exit 1
    }'
}

# src_not_exec: $1 is a genome SOURCE script that SHOULD be executable but isn't — a shebang (#!) file
# lacking the +x bit. A committed non-+x source is a latent landmine: it won't run as ./scripts/<t>, and
# if its --test re-execs "$0" it fails rc=126 FROM SOURCE while the deployed (+x) copy passes — the exact
# false-green that landed mesh-display-link (chat-review/source-exec-gate 2026-06-25). Returns 0 (offending)
# only for a shebang file without +x; non-script files and +x scripts return 1 (fine).
src_not_exec(){ case "$(head -1 "$1" 2>/dev/null)" in '#!'*) [ ! -x "$1" ] ;; *) return 1 ;; esac; }

# minds_declared_off <card_file> <restore_env_file> → rc 0 iff the node is deliberately minds-off:
# EITHER the card lacks a minds: engine (blanked/absent — mesh-roll-call's node_minds_off() shape)
# OR restore.env's own MESH_MIND_CHANNELS is empty/'none'. `mesh-card --refresh` regenerates
# `minds:` from INSTALLED BINARIES, so a node that's deliberately minds-driving-OFF via restore.env
# (binaries still present) can never clear a card-only gate — chat-review/doctor-autonomy-check-
# minds-off-cryolf 2026-07-08: Default-string's card read 'minds: claude opencode ollama' forever
# despite MESH_MIND_CHANNELS=none since 2026-06-17, so the (previously ungated) autonomy-critical
# cron check below false-FAILed twice on the board ('autonomy can die silently') for a node that was
# never meant to run those crons. KEEP IN SYNC with mesh-roll-call's node_minds_off().
minds_declared_off(){
  local card="$1" renv="$2" line val
  if [ -f "$renv" ]; then
    line="$(grep -E '^[[:space:]]*(export[[:space:]]+)?MESH_MIND_CHANNELS=' "$renv" 2>/dev/null | tail -1)"
    if [ -n "$line" ]; then
      val="$(printf '%s' "$line" | sed -E 's/^[[:space:]]*(export[[:space:]]+)?MESH_MIND_CHANNELS=//; s/[[:space:]]*(#.*)?$//; s/^"//; s/"$//; s/^'"'"'//; s/'"'"'$//')"
      case "$val" in ''|none|NONE|None) return 0 ;; esac
    fi
  fi
  [ -f "$card" ] || return 1
  grep -iE '^[[:space:]]*minds:' "$card" 2>/dev/null | grep -qwE 'claude|opencode|gemini|codex' && return 1
  return 0
}

# filter_failed_units: drop session-*.scope/run-*.scope lines from `systemctl --failed` output — systemd-
# logind/run accounting scopes left FAILED when an SSH/root session ends abruptly (transient, cosmetic,
# not a real service defect; verified live: all 7 current IdeaPad failed units are this class right now).
# Unfiltered, this check would cry-wolf on every node's normal session churn (chat-review/wire-systemd-
# failed-units, knowledge/capability-systemd-failed-units-20260704.md). Reads unit names from stdin, one
# per line (e.g. `systemctl --failed --no-legend | awk '{print $2}'` — field 1 is the leading UTF-8
# bullet systemctl always prints before the unit name, even non-interactively).
filter_failed_units(){ grep -vE '^(session|run)-[^[:space:]]+\.scope$'; }

# _sc_mem_pressure_high: is this node genuinely memory-starved RIGHT NOW? Reads /proc/pressure/memory's
# 'some' avg10 (PSI — % of the last 10s at least one task stalled on memory), overridable via
# MESH_DOCTOR_MEMPRESSURE_FILE for testability; threshold via MESH_DOCTOR_MEMPRESSURE_AVG10 (default
# 10.0). No readable PSI file (older kernel, /proc/pressure not mounted) → can't assess via PSI, falls
# through to _sc_mem_exhausted below (never MORE eager to hold back a real FAIL than either check alone).
_sc_mem_pressure_high(){
  local f="${MESH_DOCTOR_MEMPRESSURE_FILE:-/proc/pressure/memory}" thresh="${MESH_DOCTOR_MEMPRESSURE_AVG10:-10.0}" avg10
  if [ -r "$f" ]; then
    avg10=$(awk '/^some/{for(i=1;i<=NF;i++) if ($i ~ /^avg10=/) { sub(/^avg10=/,"",$i); print $i }}' "$f" 2>/dev/null)
    if [ -n "$avg10" ] && awk -v v="$avg10" -v t="$thresh" 'BEGIN{exit !(v+0 >= t+0)}'; then
      return 0
    fi
  fi
  _sc_mem_exhausted
}

# _sc_should_skip_cron_for_pressure: TOP-LEVEL pre-flight gate for the --cron branch (chat-review/
# doctor-no-preflight-mempressure-gate, 2026-07-08) — refuse to even START the unthrottled --test
# fan-out (below) when the node is already genuinely memory-starved, instead of launching it and
# letting individual _sc_confirm_tool calls defer to na one-by-one while the fan-out itself keeps
# worsening the pressure. Three minds hand-diagnosed + hand-killed this exact condition today
# (senses 14:11Z, health 14:23Z, minds 15:57Z) before the tool learned to refuse on its own. Reuses
# the existing PSI/swap helper unchanged; only CRON (automated) runs are gated — an interactive run
# is the operator deliberately asking, so it always proceeds.
_sc_should_skip_cron_for_pressure(){ [ "${CRON:-0}" = 1 ] && _sc_mem_pressure_high; }

# _sc_mem_exhausted: swap-exhaustion-without-PSI-refault (chat-review/doctor-swap-exhaustion-no-psi-
# stall, 2026-07-08) — PSI avg10 only rises on ACTIVE refault/thrash; a node fully swapped-out but not
# currently faulting reads ~0 PSI stall even while a fork-heavy --test reliably ENOMEMs (health's live
# evidence: mesh-note3-desk FAIL(real) x2 at SwapFree 98.4% full / swap 22MB free, avg10=0.05 — nowhere
# near the 10.0 threshold). SHARES mesh-resource-guard's NODE-PRESSURE band: SwapFree < swap_pct% of
# SwapTotal, OR MemAvailable < avail_pct% of MemTotal. Overridable via MESH_DOCTOR_MEMINFO_FILE for
# testability; a swapless node (SwapTotal=0) never trips the swap leg (would be a permanent false hit).
# "Mirrors mesh-resource-guard" is what this comment USED to say, with the numbers held inline in BOTH
# scripts — a comment is not a channel to the reader (the two copies could rot apart and the doctor
# would defer on a band the guard no longer alerts on). The calibration is now ONE row:
# scripts/uxn/threshold-ledger `node-pressure mem=10 swap=5`, read by both. Env order preserved
# (MESH_DOCTOR_* > ledger > inline); a missing/corrupt ledger degrades to the old inline numbers.
_ledger_const(){ # <gate> <k> <fallback> — resolve a calibrated constant, naturals-only
  local repo="${MESH_REPO:-$HOME/lte-workstation}" led v=""
  led="${MESH_THRESHOLD_LEDGER:-$repo/scripts/uxn/threshold-ledger}"
  [ -f "$led" ] && [ -x "$repo/scripts/uxn/mesh-sexpr-gate" ] \
    && v="$(MESH_SEXPR_GATES="$led" "$repo/scripts/uxn/mesh-sexpr-gate" --const "$1" "$2" 2>/dev/null)"
  case "$v" in ''|*[!0-9]*) v="$3" ;; esac
  printf '%s\n' "$v"
}
_sc_mem_exhausted(){
  local f="${MESH_DOCTOR_MEMINFO_FILE:-/proc/meminfo}"
  local swap_pct="${MESH_DOCTOR_SWAPFREE_PCT:-$(_ledger_const node-pressure swap 5)}"
  local avail_pct="${MESH_DOCTOR_MEMAVAIL_PCT:-$(_ledger_const node-pressure mem 10)}"
  [ -r "$f" ] || return 1
  awk -v sp="$swap_pct" -v ap="$avail_pct" '
    /^SwapTotal:/ {st=$2} /^SwapFree:/ {sf=$2}
    /^MemTotal:/  {mt=$2} /^MemAvailable:/ {ma=$2}
    END {
      if (st > 0 && (sf/st*100) < sp) exit 0
      if (mt > 0 && (ma/mt*100) < ap) exit 0
      exit 1
    }' "$f"
}

# _sc_confirm_tool <tool_path> <deadline_epoch> — post-storm serial-confirm for ONE survivor. Echoes
# pass|na|unassessed|fail; side effects (sm_na/sm_unassessed/sm_fail/_theater_check) are the caller's
# job (call-site globals). na = the tool DECLARED not-applicable (rc=2) or the node is mem-pressured
# (honest deferral, re-tried next pass); unassessed = doctor RAN OUT OF TIME (budget spent or a
# truncated-window timeout) — it is NOT a property of the tool and must NOT read as "no hardware".
# rc=1 gets ONE extra quiet retry before being trusted as real (chat-review/doctor-serialconfirm-rc1-
# no-rescue, 2026-07-08): a heavy/fixture-multi-python --test (mesh-chat's lock-sleep suite, mesh-
# note3-desk) can itself flake under residual load even in the "quiet" re-run, and doctor's own health
# caught this rotating a false FAIL(real) run-to-run (.doctor-fails: different tool each run). Mirrors
# the existing rc=124 rescue: a genuine break fails twice, a flake clears on the second attempt.
# A repeat rc=1/124 under genuine memory pressure is a DIFFERENT failure class than a CPU storm-flake:
# unlike CPU load, swap-thrash ENOMEMs BOTH the storm run and the "quiet" re-run, so the retry above
# can't rescue it — health proved this live (mesh-note3-desk: rc=0 x3 standalone AND under 8-core
# saturation, yet FAIL(real) at both 07:28Z and 08:28Z with swap 99.7% full). Gate the final verdict on
# PSI before crying FAIL(real): genuinely defer to na (chat-review/doctor-storm-victim-mempressure-retry).
# TMPDIR FENCE around every child --test (2026-08-16, senses; board task mesh-home-wordlist-temp-
# producer). This sweep is the mesh's single largest /tmp producer and nothing knew it: ~9.2k
# `tmp.XXXXXXXXXX` files were standing in mesh-home's /tmp, and their mtime histogram put 330/286/79
# of the zero-byte class at minutes 37/38/39 — i.e. inside THIS reflex's window (cron minute 37).
# ~1 tool in 11 mktemps inside its own --test without removing it; multiply by ~600 tools x 24 runs
# a day and the sweep mints thousands of files a day it never reads again. The tmp-guard swept them
# honestly at the 3-day floor, so the leak was BOUNDED but permanent, and invisible: the debris is
# indistinguishable from ambient churn once it lands in the shared /tmp.
#
# Two duties, deliberately separate, because deleting the debris silently would ABSORB the fault:
#   _fence_tmpdir — give the child its own TMPDIR under the sweep's scratch, so the residue lands
#                   where doctor already `rm -rf`s (the amplification stops).
#   _fence_reap   — COUNT what it left before removing it, so the per-tool leak becomes a named WARN
#                   its owner can fix instead of a number nobody can attribute.
# HONEST LIMIT: this fences $TMPDIR only. A --test that hardcodes `/tmp/foo.XXXX` escapes it
# entirely and is neither stopped nor counted — the WARN says "TMPDIR residue", never "/tmp
# residue", so it cannot be read as coverage it does not have. The limit is structural and stays;
# what changed is that no live instance is left to hide in it — the 82 hardcoded templates across
# 29 tools (mesh-roll-call's `/tmp/mrc-test.XXXXXX` was the named one) now read
# `mktemp "${TMPDIR:-/tmp}"/…`, identical when TMPDIR is unset and fence-visible when it is not
# (task:doctor-test-tmpdir-cleanup-traps). Detector for a regression, since this census cannot see
# one:  grep -nE 'mktemp( -[A-Za-z]+)* /tmp/' scripts/mesh-*  — a hit is a tool opting out of the
# fence, and it will read as a CLEAN tool here, not a leaking one.
# The count is appended, not overwritten: a tool re-run by the flake guard and again by the serial
# confirm leaks once per attempt, and the report is the sum, not the last one.
# The fence is a LOAN of $TMPDIR, not a reassignment: the serial-confirm caller runs in doctor's own
# shell (no subshell), so exporting a dir that _fence_reap then deletes would leave DOCTOR pointed at a
# path that no longer exists — every later mktemp of its own would fail. Reap restores the prior value
# (and unsets it again if there was none), so the fence cannot outlive the child it was built for.
_fence_tmpdir(){   # <root> <tag> — export a private TMPDIR for the child about to run
  _FENCE_PREV_TMPDIR="${TMPDIR-}"; _FENCE_PREV_SET=$([ -n "${TMPDIR+x}" ] && echo 1 || echo 0)
  TMPDIR="$1/td.$2"; mkdir -p "$TMPDIR" 2>/dev/null || return 1
  TMP="$TMPDIR"; TEMP="$TMPDIR"; export TMPDIR TMP TEMP
}
_fence_reap(){     # <root> <tag> — append the child's residue count, remove the fence, give TMPDIR back
  local n
  n=$(find "$1/td.$2" -mindepth 1 -maxdepth 1 2>/dev/null | wc -l)
  [ "${n:-0}" -gt 0 ] && printf '%s\n' "$n" >> "$1/res.$2"
  rm -rf "$1/td.$2" 2>/dev/null
  if [ "${_FENCE_PREV_SET:-0}" = 1 ]; then TMPDIR="$_FENCE_PREV_TMPDIR"; TMP="$TMPDIR"; TEMP="$TMPDIR"; export TMPDIR TMP TEMP
  else unset TMPDIR TMP TEMP; fi
  return 0
}
_fence_escape_scan(){ # <scripts-dir> — space-separated basenames whose mktemp opts OUT of the fence
  # The pattern is CONCATENATED, never written whole: a detector that greps the genome for its own
  # literal would name ITSELF on every run (doctrine: "the gate that greps its own source"). Comments
  # are stripped for the same reason — this file's own prose discusses the shape it hunts.
  awk -v p='mktemp( +-[A-Za-z]+)* +/' '
      { l=$0; sub(/#.*/,"",l)
        if (l ~ p "tmp/") { f=FILENAME; sub(/.*\//,"",f); if (!(f in seen)) { seen[f]=1; print f } } }
    ' "$1"/mesh-* 2>/dev/null | tr '\n' ' '
}
_fence_report(){   # <root> — "<count>\t<tool>" per tool that left TMPDIR debris, worst first (the
                   # caller renders ONE warn from this; a line per tool would bury the FAILs)
  local f b n
  for f in "$1"/res.*; do
    [ -e "$f" ] || continue
    b="${f##*/res.}"
    n=$(awk '{s+=$1} END{print s+0}' "$f")
    [ "${n:-0}" -gt 0 ] && printf '%s\t%s\n' "$n" "$b"
  done | sort -rn
}

_sc_confirm_tool(){
  local t="$1" deadline="$2" rc _rem _sc_to attempt
  for attempt in 1 2; do
    _rem=$(( deadline - $(date +%s) ))
    if [ "$_rem" -lt 5 ]; then echo unassessed; return; fi   # budget spent → doctor ran out of time, NOT "no hardware"
    _sc_to=$_rem; [ "$_sc_to" -gt 60 ] && _sc_to=60
    [ -n "${_SM_TMP:-}" ] && _fence_tmpdir "$_SM_TMP" "$(basename "$t")"
    MESH_TEST_SANDBOX=1 timeout "$_sc_to" "$t" --test >/dev/null 2>&1; rc=$?
    [ -n "${_SM_TMP:-}" ] && _fence_reap "$_SM_TMP" "$(basename "$t")"
    [ "$rc" = 0 ] && { echo pass; return; }
    [ "$rc" = 2 ] && { echo na; return; }
    # timed out under a TRUNCATED (budget-limited) window → we rushed it, so unassessed not a cry-wolf
    # FAIL; only a full-60s-window timeout falls through to fail below (that one IS a real failure).
    [ "$rc" = 124 ] && [ "$_sc_to" -lt 60 ] && { echo unassessed; return; }
    [ "$rc" = 1 ] && [ "$attempt" = 1 ] && continue   # storm-flake guard: one more quiet attempt
    if { [ "$rc" = 1 ] || [ "$rc" = 124 ]; } && _sc_mem_pressure_high; then echo na; return; fi
    echo fail; return
  done
}

# _link_up: cheap uplink probe for the smoke-phase LINK BRACKET (chat-review/doctor-smoke-verdict-
# straddles-link-outage, 2026-07-16). The post-storm serial confirm rescues LOAD-starvation but
# re-confirms an OUTAGE: a sweep straddling an uplink drop re-runs net-touching survivors while the
# link is STILL down and stamps them '(real)' — live 20:25Z: six tools (card doctor health
# model-watch revert-catch ss-config) alarmed 'mesh UP-but-BROKEN' inside the 20:23:39→20:26:47
# outage, all six 0-FAIL at 19:25. On a ~14min-flapping sole uplink this re-manufactures false
# FAIL/RECOVERED flaps indefinitely. Probe = route present + one ping (2 attempts: a single lost
# packet on the flappy dongle must NOT read as an outage — false "down" is the masking direction).
# MESH_DOCTOR_LINK_STATE=up|down forces the verdict for testability (same override style as
# MESH_DOCTOR_MEMPRESSURE_FILE; a forced verdict, not a parsed fixture — the parse here is trivial).
_link_up(){
  case "${MESH_DOCTOR_LINK_STATE:-}" in up) return 0;; down) return 1;; esac
  ip route get 1.1.1.1 >/dev/null 2>&1 || return 1
  ping -c1 -W2 1.1.1.1 >/dev/null 2>&1 && return 0
  ping -c1 -W2 1.1.1.1 >/dev/null 2>&1
}

# _sm_apply_link_bracket <pre_ok> <post_ok> — final-lane decision for still-failing smoke survivors.
# ANY bracket down → the whole sm_fail set moves to sm_link_na ('n/a — sweep straddled a link
# outage'), never '(real)'. Deliberately COARSE (all survivors, not a per-tool net-touching
# classifier): during an outage the verdict is unassessable in general — even "local" --tests
# consult tailscale/peers — and a source-grep classifier would be a heuristic pretending to be a
# fact. The residual mask (a genuinely-broken local tool failing during an outage) re-fails on the
# next healthy pass an hour later; a false '(real)' storm trains alarm-blindness NOW, which is the
# larger damage. Sets sm_fail/sm_link_na (call-site globals) — extracted so --test drives the REAL
# classifier, and the live path stays one call.
_sm_apply_link_bracket(){
  [ -n "$sm_fail" ] || return 0
  { [ "$1" = 1 ] && [ "$2" = 1 ]; } && return 0
  sm_link_na="$sm_fail"; sm_fail=""
}

# ---- self-asserting gate detector (doctrine: "the gate that greps its own source", f798133) ----
# A gate shaped `grep -q PAT <the script itself>` ALWAYS finds at least one hit: the grep line that
# carries PAT. So it asserts its own text and can never fail — deleting the code it claims to guard
# still leaves it green (mesh-land's self-heal push, 1969a5d). Detector: run PAT against the grep
# LINE ALONE; a match means vacuous. The 19 survivors in the 2026-07-15 sweep pass only by escaping
# metachars (pattern-as-written != pattern-as-matched) — an accident of quoting, not a design.
# Emits one line per gate: "V <tool>:<lineno>" vacuous | "G <tool>:<lineno>" pattern does not self-match.
selfgrep_scan(){
  python3 - "$1" <<'PY'
import re, subprocess, sys, os, glob
gate = re.compile(r"""grep\s+-[a-zA-Z]*q[a-zA-Z]*\s+(?:-e\s+)?(?=['"])""")
tail = re.compile(r"""[^|;)]*?"\$0\"""")

def read_pattern(line, i):
    """Read the whole pattern WORD at i: a run of ADJACENT quoted chunks, shell-concatenated.
    `'\[ "$peer_rc" = 3'" ]"` is ONE pattern (`\[ "$peer_rc" = 3 ]`), not the first chunk — and
    reading only the first chunk called every deliberately-concatenated gate vacuous (measured
    2026-07-24: mesh-mind-compact:590 and mesh-presence-fuse:351 both read V while a mutation
    proved each one goes red). An unquoted fragment ($var, a bare word) stops the scan: we cannot
    know its value, and stopping keeps the old conservative reading."""
    out = []
    n = len(line)
    while i < n and not line[i].isspace():
        if line[i] == "'":
            j = line.find("'", i + 1)
            if j < 0:
                return None, i
            out.append(line[i + 1:j]); i = j + 1
        elif line[i] == '"':
            j = i + 1; buf = []
            while j < n and line[j] != '"':
                if line[j] == '\\' and j + 1 < n:
                    buf.append(line[j + 1]); j += 2; continue
                buf.append(line[j]); j += 1
            if j >= n:
                return None, i
            out.append(''.join(buf)); i = j + 1
        else:
            break
    return ''.join(out), i
# split-fragment idiom: pattern "${_a}${_b}" where _a/_b are single-quoted string assignments in
# the same file — expand before the self-match test, else every DESIGNED non-self-matching concat
# gate (mesh-dispatch _ro_a/_tk_a, 2026-07-24 conversions) counts as vacuous forever and the
# ratchet's V-count means nothing. Unexpandable ${…} stays raw (conservative: usually reads V).
frag = re.compile(r"([A-Za-z_][A-Za-z_0-9]*)='([^']*)'")
ref = re.compile(r"\$\{([A-Za-z_][A-Za-z_0-9]*)\}")
for f in sorted(glob.glob(os.path.join(sys.argv[1], '*'))):
    if not os.path.isfile(f):
        continue
    try:
        lines = open(f, errors='replace').read().split('\n')
    except Exception:
        continue
    frags = {}
    for ln in lines:
        for fm in frag.finditer(ln):
            if fm.group(1) not in frags:
                frags[fm.group(1)] = fm.group(2)
    for i, line in enumerate(lines, 1):
        if line.lstrip().startswith('#'):   # a comment is not a gate
            continue
        m = gate.search(line)
        if not m:
            continue
        raw, after = read_pattern(line, m.end())
        if not raw or not tail.match(line[after:]):
            continue
        pat = ref.sub(lambda r: frags.get(r.group(1), r.group(0)), raw)
        flag = '-qE' if ('-qE' in line or '-Eq' in line) else '-q'
        try:
            r = subprocess.run(['grep', flag, '--', pat], input=line, text=True,
                               capture_output=True, timeout=5)
        except Exception:
            continue
        print(('V ' if r.returncode == 0 else 'G ') + '%s:%d' % (os.path.basename(f), i))
PY
}

# ---- systemctl-show multi-property + --value detector (systemctl-show-multi-property-returns-systemd-
# order-not-yours, 2026-07-27) ----
# `systemctl show -p A -p B -p C` returns the properties in SYSTEMD'S OWN order, not the order you asked
# in (verified on this node: `-p CPUUsageNSec -p MemoryPeak -p MemoryCurrent` prints Memory* first,
# CPUUsageNSec LAST; reversing the request changes nothing). WITHOUT --value each line is `KEY=val`, so
# a KEY= parse is safe. WITH --value the names are STRIPPED, so a caller that zips its own requested
# list against the bare-value lines mislabels the values silently — 971763409000 CPU-nanoseconds read
# as a MemoryCurrent byte count (the balanced-txn-is-not-a-correctly-named-one shape, on a scalar).
# The fix is a CONVENTION, filed before the first multi-property caller exists (all current call sites
# are single -p): one property per call, OR drop --value and parse KEY= from the output. This flags the
# dangerous combination at the source — `systemctl … show …` carrying --value AND 2+ requested
# properties (either repeated `-p X -p Y` or a comma-list `-p X,Y`). A `# systemctl-order-ok:` header/
# inline note on the line suppresses it for a deliberate systemd-order-aware caller.
# Emits one line per offending site: "<tool>:<lineno>".
systemctl_show_scan(){
  python3 - "$1" <<'PY'
import re, sys, os, glob
pflag = re.compile(r'(?:-p|--property)[= ]+([A-Za-z0-9_,]+)')
for f in sorted(glob.glob(os.path.join(sys.argv[1], '*'))):
    if not os.path.isfile(f):
        continue
    try:
        lines = open(f, errors='replace').read().split('\n')
    except Exception:
        continue
    for i, line in enumerate(lines, 1):
        if line.lstrip().startswith('#'):
            continue
        if 'systemctl' not in line or 'show' not in line or '--value' not in line:
            continue
        if 'systemctl-order-ok' in line:
            continue
        props = 0
        for m in pflag.finditer(line):
            props += m.group(1).count(',') + 1
        if props >= 2:
            print('%s:%d' % (os.path.basename(f), i))
PY
}

# ---- absence-reads-as-FAIL detector (absence-reads-as-fail-detector, 2026-08-19) ----
# A tool that renders an ABSENT / unreachable / timed-out input as a NEGATIVE READING manufactures
# the alarm it exists to report: the probe's FAILURE path and a genuinely bad measurement land in
# the SAME branch and print the SAME verdict word, so "FAIL" no longer distinguishes "the thing is
# broken" from "I could not look". The honest rendering is n/a + exit 2 (mesh-cam-light:190 is the
# model: an absent frame prints UNKNOWN and exits 2, never "dark"). Until now such sites were only
# ever found ONE AT A TIME — mesh-land reported a timed-out --test as a test FAILURE (fixed
# 2026-08-19), mesh-link-heal's 55-min blind spot was the n/a-fails-GREEN inverse.
#
# Two rules, both REPORT-ONLY, and a site counts only when the absent path and the negative path
# reach the same verdict word — the task's own bar, not "this line looks risky":
#   A  a command substitution whose failure arm yields a literal (`X="$(probe || echo 0)"`, or the
#      same thing reached THROUGH an arithmetic expansion, `age=$(( now - $(stat … || echo 0) ))`)
#      where that literal decidably enters a RANGE branch (-lt/-gt/-le/-ge/!=) that emits an alarm
#      word. A range arm is reachable by a real bad reading too — that is the collapse. A POINT
#      arm (`[ "$x" = na ]`) is the honest separation and is never flagged; so is any file that
#      gives the literal its own branch anywhere, or whose arm says n/a/UNKNOWN/exit 2.
#   T  a timeout(1) wrapper whose rc drives a verdict in a file that never mentions 124. rc=124 is
#      the KILL — a statement about our patience, not about the tool — and folding it into the
#      same arm as the tool's own non-zero rc is one word for two states.
# Deliberately NOT flagged (each was a measured false-positive class, not a guess): a config default
# (`X=${MESH_X:-900}`), an EDGE test whose rhs IS the alarm word (`[ "$prev" != DEAD ]` — the
# negative reading is the one value that does not enter, so nothing collapses), a `&&` conjunction
# we cannot decide, anything inside a --test block or a test-* harness (a smoke test's FAIL is a
# TEST verdict), and any line/arm carrying `absence-ok`.
# Emits: "A <tool>:<defline> <var>=<lit> -> :<branchline> [<op> <rhs>] <VERDICT>" and
#        "T <tool>:<line> timeout -> :<line> <VERDICT> (rc=124 is a state, not a verdict)".
absence_scan(){
  python3 - "$1" <<'PYEOF'
import re, sys, os, glob

ALARM = re.compile(r'\b(FAIL(?:ED|ING)?|DOWN|DEAD|BROKEN|CRIT(?:ICAL)?|ALARM|ALERT|STALE|WEDGED?|DEGRADED|STARV\w*|OFFLINE|LOST|BAD|RED)\b')
HONEST = re.compile(r'(\bn/a\b|\bNA\b|\bna\b|UNKNOWN|unknown|unassessed|UNASSESSED|absent|ABSENT|BLIND|blind|skip|SKIP|exit 2|return 2)')
ASSIGN = re.compile(r'(?:^|[;&|(}{]|\s)([A-Za-z_][A-Za-z_0-9]*)=(?:"?)\$\(')
DEFAULTED = re.compile(r'(?:^|[;&|(}{]|\s)([A-Za-z_][A-Za-z_0-9]*)=(?:"?)\$\{([A-Za-z_][A-Za-z_0-9]*):-([^}]*)\}')
# The verdict must be EMITTED (echoed/logged/notified), not merely NAMED inside the test expression:
# `[ "$prev" != DEAD ]` mentions DEAD while deciding an EDGE, and counting that made every
# state-file edge-detector a finding (5 of the first 15 rows).
EMIT_STRIP = re.compile(r'\[\[?.*?\]\]?')
EMIT = re.compile(r'(?:echo|printf|log|notify|say|mesh-chat|state|exit|verdict|warn|fail)\b[^\n]*')
COND = re.compile(r'\[\[?\s*"?\$\{?(\w+)\}?"?\s*(-lt|-le|-gt|-ge|-eq|-ne|!=|==|=)\s*"?([^]\s"]+)"?\s*\]')

def close_paren(s, i):
    """i points at '(' of $( ; return index just past matching ')' or -1."""
    d = 0
    n = len(s)
    while i < n:
        if s[i] == '(':
            d += 1
        elif s[i] == ')':
            d -= 1
            if d == 0:
                return i
        i += 1
    return -1

FB = re.compile(r'\|\|\s*(?:echo|printf)\s+(?:"([^"]*)"|\'([^\']*)\'|(\S+))\s*$')

ARITH = re.compile(r'(?:^|[;&|(}{]|\s)([A-Za-z_][A-Za-z_0-9]*)=\$\(\(')
NOWISH = re.compile(r'\$\(date\s[^)]*\)|\$\{?(?:now|NOW|_now|ts|TS|epoch)\}?\b')


def arith_fallback(line, now):
    """[(var, value)] for `X=$(( … $(probe || echo LIT) … ))`: substitute the fallback, a clock read
    for NOW, and evaluate. Undecidable (any $ left) → nothing, so the reading is never invented."""
    out = []
    for m in ARITH.finditer(line):
        op = line.find('$((', m.end() - 3)
        cp = close_paren(line, op + 1)
        if cp < 0:
            continue
        expr = line[op + 3:cp - 1]
        inner = None
        j = expr.find('$(')
        while j >= 0:
            k = close_paren(expr, j + 1)
            if k < 0:
                break
            fm = FB.search(expr[j + 2:k].strip())
            if fm:
                inner = (j, k, fm.group(1) or fm.group(2) or fm.group(3) or '')
                break
            j = expr.find('$(', j + 1)
        if not inner:
            continue
        j, k, lit = inner
        expr = expr[:j] + lit + expr[k + 1:]
        expr = NOWISH.sub(str(now), expr)
        if '$' in expr or not re.fullmatch(r'[-+*/%() 0-9]+', expr.strip()):
            continue
        try:
            out.append((m.group(1), str(int(eval(expr, {'__builtins__': {}})))))
        except Exception:
            pass
    return out


def fallbacks(lines, now=None):
    if now is None:
        now = int(__import__('time').time())
    """[(lineno, var, literal)] — a command substitution whose FAILURE path yields a literal."""
    out = []
    for i, line in enumerate(lines, 1):
        if line.lstrip().startswith('#'):
            continue
        for m in ASSIGN.finditer(line):
            var = m.group(1)
            op = line.find('$(', m.end() - 2)
            if op < 0:
                continue
            cp = close_paren(line, op + 1)
            if cp < 0:
                continue
            inner = line[op + 2:cp]
            fm = FB.search(inner.strip())
            if not fm:
                continue
            lit = fm.group(1) or fm.group(2) or fm.group(3) or ''
            out.append((i, var, lit.strip()))
        for v, val in arith_fallback(line, now):
            out.append((i, v, val))
        for m in DEFAULTED.finditer(line):
            # A CONFIG default (`X=${MESH_X:-900}`) is not an absence fallback: the inner name is
            # an env knob, not a probe. Only count it when the inner name was itself filled from a
            # command substitution earlier in THIS file — i.e. the :- really is the probe's failure arm.
            if probed(lines, i, m.group(2)):
                out.append((i, m.group(1), m.group(3).strip()))
    return out


def probed(lines, upto, name):
    pat = re.compile(r'(?:^|[;&|(}{]|\s)' + re.escape(name) + r'=(?:"?)\$\(')
    return any(pat.search(l) for l in lines[:upto] if not l.lstrip().startswith('#'))

def truth(lit, op, rhs):
    """Does the FALLBACK literal satisfy this condition? None = undecidable."""
    if op in ('-lt', '-le', '-gt', '-ge', '-eq', '-ne'):
        try:
            a, b = int(lit), int(rhs)
        except ValueError:
            return None
        return {'-lt': a < b, '-le': a <= b, '-gt': a > b,
                '-ge': a >= b, '-eq': a == b, '-ne': a != b}[op]
    if '$' in rhs:
        return None
    if op in ('=', '=='):
        return lit == rhs
    if op == '!=':
        return lit != rhs
    return None

# A point-equality branch keyed on the literal is the HONEST separation: absence gets its own arm.
# Only DECLARED (the whole-file scan) needs this — a `=`/`-eq` arm is entered by the fallback ONLY
# when its rhs IS the literal, which is precisely what DECLARED looks for, so there is no second
# per-branch skip to make: one would be code no mutation could drive red.
POINT = ('=', '==', '-eq')

def body_of(lines, idx, line):
    """Text the branch executes: rest of line after the test, plus a then-block."""
    seg = line
    if line.rstrip().endswith('then'):
        buf = [line]
        for j in range(idx, min(idx + 6, len(lines))):
            nxt = lines[j]
            if re.match(r'\s*(fi|else|elif)\b', nxt):
                break
            buf.append(nxt)
        seg = '\n'.join(buf)
    return seg

TEST_IN = re.compile(r'(?:^|[;\s])--test\)|\[\s*"?\$\{?1\}?"?\s*=\s*"?--test'
                     r'|^\s*[A-Za-z_0-9]*_?(?:do_|smoke_?)?tests?\(\)')
TEST_OUT = re.compile(r'^\s*;;\s*$|^\}\s*$|^\s*esac\s*$|^fi\s*$')


def test_lines(lines):
    """1-based line numbers inside a --test / smoke-test block."""
    inside, out = False, set()
    for i, line in enumerate(lines, 1):
        if not inside and TEST_IN.search(line):
            inside = True
        if inside:
            out.add(i)
            if TEST_OUT.match(line):
                inside = False
    return out


LITINT = re.compile(r'(?:^|[;&|(}{]|\s)([A-Za-z_][A-Za-z_0-9]*)="?(?:\$\{[A-Za-z_][A-Za-z_0-9]*:-)?(-?[0-9]+)\}?"?\s*(?:$|[;#])')


def int_consts(lines):
    """NAME -> integer literal, for resolving a `$THRESHOLD` right-hand side. Ambiguous (assigned
    twice with different values, or ever assigned non-literally) → dropped, so an unresolved rhs
    stays undecidable rather than being guessed."""
    seen, bad = {}, set()
    for line in lines:
        if line.lstrip().startswith('#'):
            continue
        for m in LITINT.finditer(line):
            n, v = m.group(1), m.group(2)
            if n in seen and seen[n] != v:
                bad.add(n)
            seen[n] = v
        for m in re.finditer(r'(?:^|[;&|(}{]|\s)([A-Za-z_][A-Za-z_0-9]*)=(?!.*^)', line):
            pass
    for m in [x for x in seen if x in bad]:
        seen.pop(m, None)
    return seen


TMO = re.compile(r'(?:^|[;&|(`$]|\s)timeout\s+(?:-\S+\s+)*[0-9]+[smhd]?\s')


def timeout_rows(base, lines, tl, src):
    """timeout(1) kills with rc=124 — a state, not a verdict. A caller that funnels that rc into the
    same arm as the tool's OWN non-zero rc reports 'the tool failed' when the truth is 'we did not
    wait long enough' (mesh-land carried exactly this until 2026-08-19). A file that never mentions
    124 anywhere cannot be distinguishing it. Only flagged where the rc actually drives a verdict:
    captured into a variable, or an `||` arm on the same line that emits an alarm word."""
    if re.search(r'\b124\b', src):
        return []
    out = []
    for i, line in enumerate(lines, 1):
        if line.lstrip().startswith('#') or i in tl or not TMO.search(line):
            continue
        if 'absence-ok' in line or 'smoke-test' in line:
            continue        # a self-test's FAIL is a TEST verdict, not a claim about the node
        verdict, at = None, i
        # (a) the rc is branched on RIGHT THERE: `timeout N cmd || <emit>`
        if '||' in line:
            tail = line.split('||', 1)[1]
            a = ALARM.search(EMIT_STRIP.sub(' ', tail))
            if a and not HONEST.search(tail):
                verdict = a.group(1)
        # (b) the rc is captured, then a later `!= 0` / `-ne 0` arm emits the verdict. Both the kill
        #     (124) and the tool's OWN non-zero rc enter that arm — one word for two states.
        if not verdict:
            cap = re.search(r'(?:^|[;\s])(?:local\s+)?(\w+)=\$\?', line) or \
                  (re.match(r'\s*(?:local\s+)?(\w+)=\$\?', lines[i]) if i < len(lines) else None)
            if cap:
                rcv = cap.group(1)
                for j, ln in enumerate(lines[i:min(i + 25, len(lines))], i + 1):
                    if ln.lstrip().startswith('#') or j in tl:
                        continue
                    if not re.search(r'\$\{?' + re.escape(rcv) + r'\}?"?\s*(?:!=|-ne)\s*"?0', ln) \
                       and not re.search(r'\$\{?' + re.escape(rcv) + r'\}?"?\s*(?:=|-eq)\s*"?0"?\s*\]\s*\|\|', ln):
                        continue
                    body = body_of(lines, j, ln)
                    if 'smoke-test' in body:
                        break
                    a = None
                    for e in EMIT.finditer(EMIT_STRIP.sub(' ', body)):
                        a = ALARM.search(e.group(0))
                        if a:
                            break
                    if a and not HONEST.search(body):
                        verdict, at = a.group(1), j
                    break
        if verdict:
            out.append('T %s:%d timeout -> :%d %s (rc=124 is a state, not a verdict)'
                       % (base, i, at, verdict))
    return out


def scan(root):
    rows = []
    for f in sorted(glob.glob(os.path.join(root, '*'))):
        if not os.path.isfile(f) or os.path.basename(f).startswith('test-'):
            continue        # test-* IS the harness canon: its whole body is test verdicts
        try:
            lines = open(f, errors='replace').read().split('\n')
        except Exception:
            continue
        base = os.path.basename(f)
        src = '\n'.join(lines)
        tl = test_lines(lines)
        consts = int_consts(lines)
        rows += timeout_rows(base, lines, tl, src)
        seen_rows = set()
        for defln, var, lit in fallbacks(lines):
            if not lit or lit in ('', '""'):
                continue
            # DECLARED: the literal gets a branch of its own anywhere in the file → honest separation.
            declared = False
            for m in COND.finditer(src):
                if m.group(1) == var and m.group(2) in POINT and m.group(3) == lit:
                    declared = True
            if re.search(r'^\s*[\'"]?' + re.escape(lit) + r'[\'"]?\s*\)', src, re.M):
                declared = True
            if declared:
                continue
            if defln in tl:
                continue
            for i, line in enumerate(lines[defln:], defln + 1):
                if line.lstrip().startswith('#') or i in tl:
                    continue
                for m in COND.finditer(line):
                    if m.group(1) != var:
                        continue
                    op, rhs = m.group(2), m.group(3)
                    rm = re.fullmatch(r'\$\{?([A-Za-z_][A-Za-z_0-9]*)\}?', rhs)
                    if rm:
                        rhs = consts.get(rm.group(1), rhs)
                    if op == '!=' and ALARM.search(rhs):
                        continue           # `[ "$prev" != DEAD ]` is an EDGE: the NEGATIVE reading
                        # (DEAD) is the one value that does NOT enter, so nothing collapses — only
                        # the current probe can put DEAD on the wire. Absence re-announces, it does
                        # not manufacture. (This arm was the whole false-positive class: 5 of 15.)
                    t = truth(lit, op, rhs)
                    if t is not True:
                        continue
                    if re.search(r'\]\s*&&\s*(\[|!)', line):
                        continue        # a CONJUNCTION we cannot decide: absence alone ≠ the verdict.
                        # A DISJUNCTION (`||`) is the opposite — the fallback alone reaches the arm.
                    body = body_of(lines, i, line)
                    if 'smoke-test' in body or 'fail=1' in body:
                        continue
                    if 'absence-ok' in body or 'absence-ok' in lines[defln - 1]:
                        continue
                    emitted = EMIT_STRIP.sub(' ', body)
                    a = None
                    for e in EMIT.finditer(emitted):
                        a = ALARM.search(e.group(0))
                        if a:
                            break
                    if not a:
                        continue
                    if HONEST.search(body):
                        continue
                    key = (base, i, var)
                    if key in seen_rows:
                        break
                    seen_rows.add(key)
                    rows.append('A %s:%d %s=%s -> :%d [%s %s] %s'
                                % (base, defln, var, lit, i, op, rhs, a.group(1)))
                    break
    return rows

for _r in scan(sys.argv[1]):
    print(_r)
PYEOF
}

ERRPAT='not found|traceback|syntax error|unbound variable|: line [0-9]+:|command not found'
# MTIME BOUND on the untimestamped branch (2026-07-15, health's find): the heal-aware rule above has NO
# TIME BOUND — an unhealed untimestamped error at the END of the window counts FOREVER. That is fine for
# a chatty reflex, but an `--edge`/conditional-write reflex only appends on a band CHANGE, so no clean
# line may follow for DAYS and the FAIL is permanent AND unhealable. Live: interruptibility.log is 2
# lines, BOTH errors, from 2026-07-14T22:35 — the bug was fixed 12.7h earlier in 29ce219 and the reflex
# has run ~60× since (11-59/12) writing nothing, because it is now quiet. Doctor still called them
# "recent". A permanent red trains us to ignore doctor, which is the real damage.
# THE PROVABLE BOUND: no line can postdate the mtime of the file it lives in. So if the FILE's mtime is
# older than the cutoff, no line in it — timestamped or not — is recent, and "recent" is simply FALSE.
# WHY THIS DOES NOT TRADE A FALSE-FAIL FOR A FALSE-GREEN (the tradeoff health flagged as a design call,
# and the reason to make it deliberately): a reflex that is broken NOW re-emits its stderr into this same
# log every run, which REFRESHES the mtime — so an ongoing break always lands inside the cutoff and still
# FAILs. The bound can only ever silence an error that has stopped being produced. The residual case —
# broke AND stopped running entirely — has an old mtime too, but it is not "UP but broken"; it is
# not-wired, which is the orphan/cron checks' axis (source+crontab based, not mtime), not this one.
# NOTE health's suggested pairing ("pair the bound with a staleness assertion — that's reflex-health's
# axis") does NOT hold and must not be relied on: mesh-reflex-health classes conditional-write reflexes
# @cond → "mtime is NOT liveness at ANY threshold → NOT WATCHABLE, excluded outright" (:41-43), and
# interruptibility is not in it at all. Exactly this class is excluded there, for exactly this reason —
# so there is no staleness watcher to hand off to, and pretending otherwise would be the silent-fallback
# shape. mtime is a bound on RECENCY here, never a claim about liveness.
# Extracted so --test drives the real counter against fixture logs with real mtimes.
count_recent_errors(){ # $1=logfile $2=now_epoch → echoes the count of RECENT error-lines
  local lg="$1" ne="$2" cutoff=$(( $2 - 1200 )) i last_clean=-1 errs=0 ets eep mt
  local -a _tl
  mapfile -t _tl < <(tail -20 "$lg" 2>/dev/null)
  mt=$(stat -c %Y "$lg" 2>/dev/null || echo "$ne")
  # index of the LAST clean (non-error) line — a heal marker: anything before it has recovered
  for ((i=0; i<${#_tl[@]}; i++)); do
    printf '%s' "${_tl[$i]}" | grep -qiE "$ERRPAT" || last_clean=$i
  done
  for ((i=0; i<${#_tl[@]}; i++)); do
    printf '%s' "${_tl[$i]}" | grep -qiE "$ERRPAT" || continue   # not an error line
    ets=$(printf '%s' "${_tl[$i]}" | grep -oE '[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}' | head -1)
    if [ -n "$ets" ]; then
      eep=$(date -d "${ets}Z" +%s 2>/dev/null || echo "$ne")
      [ "$eep" -ge "$cutoff" ] && errs=$((errs+1))             # timestamped → age by its own ts (unchanged)
    else
      [ "$i" -gt "$last_clean" ] && [ "$mt" -ge "$cutoff" ] && errs=$((errs+1))   # untimestamped → unhealed AND the file itself is recent
    fi
  done
  printf '%s' "$errs"
}
# Extracted so --test drives the real tracked/untracked scoping against fixture dirs (chat-review/
# doctor-execbit-fails-on-untracked-source). $1=genome-root $2=bin-dir → echoes space-joined basenames of
# shebang-but-non-+x files that are genuine LANDMINES: committed (git-tracked) genome sources + ANY deployed
# bin tool. An UNTRACKED genome source (write→not-yet-chmod→not-yet-commit) is normal mid-dev, NOT a landmine
# — hard-FAILing it pages the operator on a WIP file whose deployed +x copy is healthy (live 2026-07-18 01:40
# on mesh-egress-tunnel, household asleep). The softer source-exec-gate WARN below still surfaces untracked
# non-+x sources without paging; the committed case stays a FAIL (won't run as ./scripts/<t>; $0-reexec
# false-green) and is also caught by mesh-land's non-+x strand.
exec_bit_landmines(){
  local groot="$1" bindir="$2" f tracked="" out=""
  [ -d "$groot/.git" ] && tracked="$(git -C "$groot" ls-files scripts/ 2>/dev/null)"
  for f in "$groot"/scripts/* "$bindir"/mesh-*; do
    [ -f "$f" ] || continue
    # only check files with a shebang — plain data/scripts, README, .md, etc. are fine
    head -1 "$f" 2>/dev/null | grep -q '^#!' || continue
    [ -x "$f" ] && continue
    # a genome SOURCE that isn't git-tracked is mid-dev, not a landmine — skip (WARN-only via source-exec-gate)
    case "$f" in
      "$groot"/scripts/*)
        printf '%s\n' "$tracked" | grep -qxF "scripts/$(basename "$f")" || continue ;;
    esac
    out="$out $(basename "$f")"
  done
  echo $out
}
# src_has <fixed-string> — the file MINUS its own gate lines. `grep -q '<literal>' "$0"` always
# matches the grep line itself, so such a gate asserts its own text and can never fail (the
# self-grep class, 1969a5d). Dropping every line that mentions src_has leaves a corpus the
# assertion is not part of. Here-string, never `sed | grep -q`: under pipefail grep -q's early exit
# SIGPIPEs the producer, and a MATCH then reports as a failure. Source text is weaker than an
# artifact — used only where the claim has no observable output of its own.
src_has(){ grep -qF -- "$1" <<< "$(grep -vF 'src_has' "$0")"; }
smoke_test(){
  have(){ command -v "$1" >/dev/null 2>&1 || { echo "smoke-test: FAIL (no $1)"; exit 1; }; }
  for dep in bash ip tailscale curl python3 grep sed tr timeout mesh-supervise; do
    have "$dep"
  done
  card="${MESH_CARD:-$HOME/.mesh-card}"
  [ -r "$card" ] || { echo "smoke-test: FAIL (no readable card: $card)"; exit 1; }
  ip route get 1.1.1.1 >/dev/null 2>&1 || { echo "smoke-test: FAIL (ip route get failed)"; exit 1; }
  tailscale debug prefs 2>/dev/null | python3 -c 'import json,sys; json.load(sys.stdin)' >/dev/null 2>&1 \
    || { echo "smoke-test: FAIL (tailscale prefs not parseable)"; exit 1; }
  mesh-supervise --status >/dev/null 2>&1 || { echo "smoke-test: FAIL (mesh-supervise --status failed)"; exit 1; }
  grep -Eq '^[[:space:]]*(senses|actuators):' "$card" \
    || { echo "smoke-test: FAIL (card missing senses/actuators)"; exit 1; }
  # orphan-check: a `# reflex-cadence: none|on-demand` header must read as intentional-unwired, while
  # a REAL cron cadence must NOT (else a tool that should be scheduled would hide from the orphan WARN).
  _td="$(mktemp -d)"
  printf '#!/usr/bin/env bash\n# reflex-cadence: none (on-demand — manual only)\n' > "$_td/ondemand"
  printf '#!/usr/bin/env bash\n# reflex-cadence: */5 * * * *\n'                     > "$_td/scheduled"
  cadence_is_ondemand "$_td/ondemand"  || { echo "smoke-test: FAIL (reflex-cadence:none not honored as intentional-unwired)"; rm -rf "$_td"; exit 1; }
  cadence_is_ondemand "$_td/scheduled" && { echo "smoke-test: FAIL (real cron cadence wrongly read as on-demand)"; rm -rf "$_td"; exit 1; }
  # canon-scope: a tool named ONLY in the TOOLING CATALOG must stay a candidate orphan; only the
  # On-demand-canon section exempts it. Driven against a fixture CLAUDE.md carrying BOTH shapes —
  # the pre-fix whole-file grep passes the canon assert and FAILS the catalog one (that is the
  # falsification: revert canon_declares to grep the whole file and this goes red).
  _tc="$(mktemp -d)"
  { printf '## Mesh tooling (`~/.local/bin/`)\n\n- **Liveness:** `mesh-catalogued-only` · `mesh-in-canon`\n\n'
    printf '## On-demand canon (intentionally unwired — NOT orphans)\n\n- **Manual:** `mesh-in-canon`\n\n'
    printf '## Capabilities (self-declared, opt-in by consumers)\n\n- `mesh-below-canon`\n'; } > "$_tc/CLAUDE.md"
  _cs="$(canon_section "$_tc/CLAUDE.md")"
  canon_declares mesh-in-canon        "$_cs" || { echo "smoke-test: FAIL (canon entry not honored as intentional-unwired)"; rm -rf "$_tc" "$_td"; exit 1; }
  canon_declares mesh-catalogued-only "$_cs" && { echo "smoke-test: FAIL (a TOOLING-CATALOG mention exempted a tool from the orphan check — catalog is not a declaration of intent)"; rm -rf "$_tc" "$_td"; exit 1; }
  canon_declares mesh-below-canon     "$_cs" && { echo "smoke-test: FAIL (canon_section overran its end anchor into ## Capabilities)"; rm -rf "$_tc" "$_td"; exit 1; }
  rm -rf "$_tc"
  # invocation-check under pipefail: a WIDELY-invoked tool must read as invoked. The fixture is
  # sized to reproduce the real failure deterministically, not incidentally — the old
  # `grep -l | grep -Fxqv` form needs the first match to land EARLY with a lot of corpus left to
  # scan, so `grep -q` exits and SIGPIPEs the upstream while it is still writing. 400 callers named
  # aaa-* (sorted first) + 400 non-callers named zzz-* after them do exactly that: verified 10/10
  # red on the old form, 10/10 green on this one, on this node. A 2-file fixture would pass against
  # BOTH and gate nothing.
  _ti="$(mktemp -d)"
  printf '#!/usr/bin/env bash\necho i am the tool\n' > "$_ti/mesh-fixture-tool"
  for _i in $(seq 1 400); do printf '#!/usr/bin/env bash\nmesh-fixture-tool --run\n' > "$_ti/aaa-caller-$_i"; done
  for _i in $(seq 1 400); do printf '#!/usr/bin/env bash\necho unrelated\n'          > "$_ti/zzz-quiet-$_i"; done
  printf '#!/usr/bin/env bash\necho nobody calls me\n' > "$_ti/mesh-fixture-lonely"
  _ft="(^|[^A-Za-z0-9_-])mesh-fixture-tool([^A-Za-z0-9_-]|\$)"
  _fl="(^|[^A-Za-z0-9_-])mesh-fixture-lonely([^A-Za-z0-9_-]|\$)"
  invoked_by_other mesh-fixture-tool   "$_ti" "$_ft" \
    || { echo "smoke-test: FAIL (invocation check missed a tool invoked by 400 others — pipefail+SIGPIPE: the more callers a tool has, the more surely it reads as an orphan)"; rm -rf "$_ti" "$_td"; exit 1; }
  invoked_by_other mesh-fixture-lonely "$_ti" "$_fl" \
    && { echo "smoke-test: FAIL (invocation check called an uninvoked tool invoked — self-match: it counted the tool's own file)"; rm -rf "$_ti" "$_td"; exit 1; }
  rm -rf "$_ti"
  # source-exec-gate: src_not_exec flags a shebang script lacking +x, ignores +x scripts and non-scripts
  printf '#!/usr/bin/env bash\necho hi\n' > "$_td/noexec"; chmod 644 "$_td/noexec"
  printf '#!/usr/bin/env bash\necho hi\n' > "$_td/yesexec"; chmod 755 "$_td/yesexec"
  printf 'plain data, no shebang\n'       > "$_td/plain";  chmod 644 "$_td/plain"
  src_not_exec "$_td/noexec"  || { echo "smoke-test: FAIL (src_not_exec missed a non-+x shebang script)"; rm -rf "$_td"; exit 1; }
  src_not_exec "$_td/yesexec" && { echo "smoke-test: FAIL (src_not_exec flagged a +x script)"; rm -rf "$_td"; exit 1; }
  src_not_exec "$_td/plain"   && { echo "smoke-test: FAIL (src_not_exec flagged a non-script)"; rm -rf "$_td"; exit 1; }
  rm -rf "$_td"
  # selfgrep-detector fixture: a gate whose pattern matches its own grep line is VACUOUS; one whose
  # pattern is escaped (as-written != as-matched) is genuine. Both shapes are REAL gate lines, not
  # descriptions of them — a fixture that only asserted the regex would be the same class of bug.
  # The gate line is assembled from $_gq so THIS file never carries the literal shape — otherwise the
  # fleet scan below counts mesh-doctor's own fixtures as live vacuous gates (it did: 35 of 54, not
  # 33 of 52). The files written are still real gate lines; only doctor's source is kept clean.
  _tsg="$(mktemp -d)"; _gq='grep -q'
  printf '#!/usr/bin/env bash\n%s '"'"'idle_tick'"'"' "$0" || exit 1\n'      "$_gq" > "$_tsg/vacuous-gate"
  printf '#!/usr/bin/env bash\n%s '"'"'idle_tick "\\$id"'"'"' "$0" || exit 1\n' "$_gq" > "$_tsg/genuine-gate"
  _sgf="$(selfgrep_scan "$_tsg")"
  [ "$(printf '%s\n' "$_sgf" | grep -c '^V vacuous-gate:2$')" = 1 ] \
    || { echo "smoke-test: FAIL (selfgrep detector missed a self-matching gate: '$_sgf')"; rm -rf "$_tsg"; exit 1; }
  [ "$(printf '%s\n' "$_sgf" | grep -c '^G genuine-gate:2$')" = 1 ] \
    || { echo "smoke-test: FAIL (selfgrep detector called an escaped-pattern gate vacuous: '$_sgf')"; rm -rf "$_tsg"; exit 1; }
  # split-fragment idiom (designed non-self-matching): _a='x'; _b='y'; grep -qF "${_a}${_b}" — the
  # expanded pattern matches the real line elsewhere but not the gate line itself → must read G.
  # And a COMMENT quoting a gate shape is not a gate → must produce no row at all.
  printf '#!/usr/bin/env bash\nidle_tick real_line_target\n_a=%s; _b=%s\n%sF "${_a}${_b}" "$0" || exit 1\n' \
    "'idle_tick real_'" "'line_target'" "$_gq" > "$_tsg/concat-gate"
  printf '#!/usr/bin/env bash\n# the old gate was: %s '"'"'idle_tick'"'"' "$0" || exit 1\n' "$_gq" > "$_tsg/comment-only"
  _sgf="$(selfgrep_scan "$_tsg")"
  [ "$(printf '%s\n' "$_sgf" | grep -c '^G concat-gate:4$')" = 1 ] \
    || { echo "smoke-test: FAIL (selfgrep detector called a split-fragment concat gate vacuous: '$_sgf')"; rm -rf "$_tsg"; exit 1; }
  # ADJACENT-QUOTE concat (the OTHER designed non-self-matching idiom, and the one the extractor
  # used to miss): `grep -q 'a b'" c" "$0"` is ONE pattern "a b c", but reading only the first
  # quoted chunk tested "a b" — which IS on the gate line — so every such gate read V forever.
  # Live cost, measured 2026-07-24: mesh-mind-compact:590 and mesh-presence-fuse:351 both carried
  # a comment saying "pattern via concatenation so this line never self-matches", both were RIGHT
  # (a mutation drove each red), and both sat in the ratchet's V-count as phantom debt.
  printf '#!/usr/bin/env bash\nidle_tick "$id" now\n%s %s%s "$0" || exit 1\n' \
    "$_gq" "'idle_tick \"\$id\"'" '" now"' > "$_tsg/adjacent-gate"
  _sgf="$(selfgrep_scan "$_tsg")"
  [ "$(printf '%s\n' "$_sgf" | grep -c '^G adjacent-gate:3$')" = 1 ] \
    || { echo "smoke-test: FAIL (selfgrep detector called an adjacent-quote concat gate vacuous: '$_sgf')"; rm -rf "$_tsg"; exit 1; }
  printf '%s\n' "$_sgf" | grep -q 'comment-only' \
    && { echo "smoke-test: FAIL (selfgrep detector counted a comment as a gate: '$_sgf')"; rm -rf "$_tsg"; exit 1; }
  rm -rf "$_tsg"
  # systemctl-show detector fixture (systemctl-show-multi-property-returns-systemd-order-not-yours):
  # the DANGEROUS line is `systemctl show` carrying --value AND 2+ requested properties. RED-first
  # falsification per the filing: two -p + --value MUST flag, one -p must NOT; the comma-list form
  # `-p A,B` is the same trap and must flag; 2+ -p WITHOUT --value is safe (KEY= labels present) and
  # must NOT; a `# systemctl-order-ok:` note suppresses a deliberate caller.
  # --value is spliced in via $_vf so mesh-doctor's OWN source never carries the full flagged shape on
  # one line — else the main-body scan counts these fixtures as live call sites (the selfgrep $_gq trick,
  # :445). The temp files still get the real dangerous line after printf expands it; only the source is kept clean.
  _tsc2="$(mktemp -d)"; _vf='--value'
  printf '#!/usr/bin/env bash\nsystemctl --user show foo.service -p CPUUsageNSec -p MemoryCurrent %s\n' "$_vf" > "$_tsc2/two-p-value"
  printf '#!/usr/bin/env bash\nsystemctl --user show foo.service -p CPUUsageNSec,MemoryCurrent %s\n'     "$_vf" > "$_tsc2/comma-value"
  printf '#!/usr/bin/env bash\npid=$(systemctl --user show -p MainPID %s "$svc")\n'                      "$_vf" > "$_tsc2/one-p-value"
  printf '#!/usr/bin/env bash\nsystemctl --user show foo.service -p CPUUsageNSec -p MemoryCurrent\n'            > "$_tsc2/two-p-novalue"
  printf '#!/usr/bin/env bash\nsystemctl show foo -p A -p B %s  # systemctl-order-ok: parsed by KEY\n'    "$_vf" > "$_tsc2/declared"
  _scf="$(systemctl_show_scan "$_tsc2")"
  printf '%s\n' "$_scf" | grep -q '^two-p-value:2$' \
    || { echo "smoke-test: FAIL (systemctl-show detector missed 2+ -p with --value: '$_scf')"; rm -rf "$_tsc2"; exit 1; }
  printf '%s\n' "$_scf" | grep -q '^comma-value:2$' \
    || { echo "smoke-test: FAIL (systemctl-show detector missed the comma-list one-flag two-property form: '$_scf')"; rm -rf "$_tsc2"; exit 1; }
  printf '%s\n' "$_scf" | grep -q '^one-p-value:' \
    && { echo "smoke-test: FAIL (systemctl-show detector flagged a safe single -p --value: '$_scf')"; rm -rf "$_tsc2"; exit 1; }
  printf '%s\n' "$_scf" | grep -q '^two-p-novalue:' \
    && { echo "smoke-test: FAIL (systemctl-show detector flagged 2+ -p WITHOUT --value — KEY= labels make it safe: '$_scf')"; rm -rf "$_tsc2"; exit 1; }
  printf '%s\n' "$_scf" | grep -q '^declared:' \
    && { echo "smoke-test: FAIL (systemctl-show detector ignored a # systemctl-order-ok: suppression: '$_scf')"; rm -rf "$_tsc2"; exit 1; }
  rm -rf "$_tsc2"
  # absence-reads-as-FAIL fixture (absence-reads-as-fail-detector): RED-FIRST, both rules, and every
  # refusal class the detector claims. The `||` is spliced in via $_af so mesh-doctor's OWN source
  # never carries a flaggable assignment shape — otherwise the fleet scan counts these fixtures as
  # live sites (the $_gq / $_vf trick above). The files written are real shell, only the source is kept clean.
  _tab="$(mktemp -d)"; _af='||'
  printf '#!/usr/bin/env bash\nage="$(curl -s "$u" 2>/dev/null %s echo 999)"\n[ "$age" -gt 300 ] && echo "link: STALE (no beacon)"\n' "$_af" > "$_tab/acollapse"
  printf '#!/usr/bin/env bash\nage=$(( $(date +%%s) - $(stat -c %%%%Y "$f" 2>/dev/null %s echo 0) ))\n[ "$age" -gt 900 ] && echo "beacon: DEAD"\n' "$_af" > "$_tab/aarith"
  printf '#!/usr/bin/env bash\nage="$(curl -s "$u" 2>/dev/null %s echo na)"\n[ "$age" = na ] && { echo "probe unreachable"; exit 2; }\n[ "$age" -gt 300 ] && echo "link: STALE"\n' "$_af" > "$_tab/ahonest"
  printf '#!/usr/bin/env bash\nage="$(curl -s "$u" 2>/dev/null %s echo 999)"\n[ "$age" -gt 300 ] && { echo "link: n/a — beacon absent, not STALE" >&2; exit 2; }\n' "$_af" > "$_tab/ahonest3"
  printf '#!/usr/bin/env bash\nLEASE_S="${MESH_LEASE_S:-900}"\n[ "$LEASE_S" -gt 600 ] && echo "lease: BAD"\n'                                        > "$_tab/aconfig"
  printf '#!/usr/bin/env bash\nprev="$(cat "$S" 2>/dev/null %s echo OK)"\n[ "$prev" != DEAD ] && echo "went DEAD"\n' "$_af"                          > "$_tab/aedge"
  printf '#!/usr/bin/env bash\nage="$(curl -s "$u" 2>/dev/null %s echo 999)"  # absence-ok: 999 is a sentinel the caller re-reads\n[ "$age" -gt 300 ] && echo "link: STALE"\n' "$_af" > "$_tab/adeclared"
  printf '#!/usr/bin/env bash\nage="$(curl -s "$u" 2>/dev/null %s echo 999)"\n[ "$age" -gt 300 ] && echo "link: STALE"  # absence-ok: 999 handled upstream\n' "$_af" > "$_tab/adeclared2"
  printf '#!/usr/bin/env bash\nSZ="$(stat -c %%s "$f" 2>/dev/null %s echo 0)"\nif [ "$SZ" -lt 20000 ] %s [ "$rc" != 0 ]; then echo "pull: FAIL ($SZ B)"; fi\n' "$_af" "$_af" > "$_tab/adisj"
  printf '#!/usr/bin/env bash\nage="$(curl -s "$u" 2>/dev/null %s echo 999)"\n[ "$age" -gt 300 ] && [ "$live" = 1 ] && echo "link: STALE"\n' "$_af" > "$_tab/aconj"
  printf '#!/usr/bin/env bash\ntimeout 10 ssh "$peer" mesh-probe; rc=$?\nif [ "$rc" != 0 ]; then\n  echo "peer: DOWN"\nfi\n'                          > "$_tab/tcollapse"
  printf '#!/usr/bin/env bash\ntimeout 10 ssh "$peer" mesh-probe; rc=$?\nif [ "$rc" != 0 ]; then\n  echo "peer: n/a — unreachable, DOWN not asserted"; exit 2\nfi\n' > "$_tab/thonest2"
  printf '#!/usr/bin/env bash\ntimeout 10 ssh "$peer" mesh-probe; rc=$?\nif [ "$rc" = 124 ]; then\n  echo "peer: n/a — timed out"; exit 2\nelif [ "$rc" != 0 ]; then\n  echo "peer: DOWN"\nfi\n' > "$_tab/thonest"
  _abf="$(absence_scan "$_tab")"
  _abfail(){ echo "smoke-test: FAIL ($1: '$_abf')"; rm -rf "$_tab"; exit 1; }
  printf '%s\n' "$_abf" | grep -q '^A acollapse:2 age=999 -> :3 \[-gt 300\] STALE$' \
    || _abfail "absence detector missed the plain fallback collapse"
  printf '%s\n' "$_abf" | grep -q '^A aarith:2 age=' \
    || _abfail "absence detector missed the fallback reached THROUGH an arithmetic expansion"
  printf '%s\n' "$_abf" | grep -q '^T tcollapse:2 timeout -> :3 DOWN' \
    || _abfail "absence detector missed a timeout rc folded into the tool's own failure arm"
  printf '%s\n' "$_abf" | grep -q '^A adisj:2 SZ=0 -> :3' \
    || _abfail "absence detector skipped a DISJUNCTION — with || the fallback alone reaches the arm"
  printf '%s\n' "$_abf" | grep -q 'aconj' && _abfail "absence detector flagged an undecidable && conjunction"
  printf '%s\n' "$_abf" | grep -q 'ahonest:'  && _abfail "absence detector flagged a POINT arm — that IS the honest separation"
  printf '%s\n' "$_abf" | grep -q 'ahonest3'  && _abfail "absence detector flagged an arm that renders n/a + exit 2 (the correct shape)"
  printf '%s\n' "$_abf" | grep -q 'aconfig'   && _abfail "absence detector flagged a config default (an env knob is not a probe)"
  printf '%s\n' "$_abf" | grep -q 'aedge'     && _abfail "absence detector flagged an EDGE test whose rhs is the alarm word"
  printf '%s\n' "$_abf" | grep -q 'adeclared' && _abfail "absence detector ignored an absence-ok on the DEFINITION line"
  printf '%s\n' "$_abf" | grep -q 'adeclared2' && _abfail "absence detector ignored an absence-ok on the BRANCH line"
  printf '%s\n' "$_abf" | grep -q 'thonest:'  && _abfail "absence detector flagged a caller that DOES distinguish rc=124"
  printf '%s\n' "$_abf" | grep -q 'thonest2'  && _abfail "absence detector flagged a timeout arm that renders n/a + exit 2"
  rm -rf "$_tab"
  # error-recency fixture: drives the REAL counter against REAL mtimes (touch -d), because the mtime IS
  # the mechanism — a fixture that stubbed stat would assert nothing about the bound it exists to prove.
  # The load-bearing pair is stale-unhealed vs fresh-unhealed: identical BYTES, opposite verdicts, so the
  # only thing that can move them apart is the file's mtime.
  _te="$(mktemp -d)"; _tenow=$(date -u +%s)
  _mkerr(){ printf '%s\n' "$2" > "$_te/$1"; touch -d "@$3" "$_te/$1"; }
  _mkerr stale-unhealed  'mesh-foo: line 197: $7: unbound variable' $(( _tenow - 45000 ))   # 12.5h old, --edge quiet since
  _mkerr fresh-unhealed  'mesh-foo: line 197: $7: unbound variable' $(( _tenow - 60 ))      # erroring right now
  printf 'mesh-foo: line 197: $7: unbound variable\nok: band steady\n' > "$_te/healed"; touch -d "@$_tenow" "$_te/healed"
  printf '%s\n' "$(date -u -d @$(( _tenow - 45000 )) +%FT%TZ) something: command not found" > "$_te/stale-ts"; touch -d "@$_tenow" "$_te/stale-ts"
  printf '%s\n' "$(date -u -d @$(( _tenow - 60 )) +%FT%TZ) something: command not found" > "$_te/fresh-ts"; touch -d "@$_tenow" "$_te/fresh-ts"
  _e_fail(){ echo "smoke-test: FAIL (count_recent_errors: $1)"; rm -rf "$_te"; exit 1; }
  [ "$(count_recent_errors "$_te/stale-unhealed" "$_tenow")" = 0 ] \
    || _e_fail "counted an UNHEALED untimestamped error in a 12.5h-STALE file as 'recent' — the permanent unhealable FAIL (interruptibility.log, 2026-07-15)"
  [ "$(count_recent_errors "$_te/fresh-unhealed" "$_tenow")" = 1 ] \
    || _e_fail "the mtime bound swallowed an ONGOING break — a live error refreshes mtime and MUST still fire"
  [ "$(count_recent_errors "$_te/healed" "$_tenow")" = 0 ] \
    || _e_fail "counted an untimestamped error that a later clean line healed (the 2026-06-17 rule regressed)"
  [ "$(count_recent_errors "$_te/stale-ts" "$_tenow")" = 0 ] \
    || _e_fail "timestamped aging regressed — an old ts line must not count"
  [ "$(count_recent_errors "$_te/fresh-ts" "$_tenow")" = 1 ] \
    || _e_fail "timestamped aging regressed — a recent ts line must count"
  # RUN STAMP (2026-08-11). Two claims, both driven end-to-end through the REAL --cron path (the
  # memory-pressure preflight, which reaches note() and exits without the slow fan-out — a stub that
  # called note() in a subshell would assert a copy, not the shipped emitter):
  #   (i)  a quiet/cron line carries an ISO-8601 UTC stamp, so a doctor.log reader can DATE it — the
  #        whole point (health read an aged-out FAIL as live on 2026-08-11 and built a design gap on it);
  #   (ii) the stamp is a PREFIX only — the text after it is byte-identical to the pre-stamp format, so
  #        a consumer keyed on the message body (mesh-dash, mesh-pulse) is untouched.
  _ts="$(mktemp -d)"; mkdir -p "$_ts/.mesh"
  printf 'some avg10=99.00 avg60=99.00 avg300=99.00 total=1\nfull avg10=99.00 avg60=99.00 avg300=99.00 total=1\n' > "$_ts/pressure-high"
  _tsout="$(HOME="$_ts" MESH_DOCTOR_MEMPRESSURE_FILE="$_ts/pressure-high" timeout 20 "$0" --cron 2>/dev/null | head -1)"
  _ts_plain="$(printf '%s' "$_tsout" | sed 's/\x1b\[[0-9;]*m//g')"
  _tsfail(){ echo "smoke-test: FAIL (run-stamp: $1)"; rm -rf "$_ts" "$_te"; exit 1; }
  printf '%s' "$_ts_plain" | grep -qE '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z  NOTE ' \
    || _tsfail "a --cron line reached doctor.log with no ISO-8601 stamp — the log stays undateable: '$_ts_plain'"
  printf '%s' "$_ts_plain" | grep -q 'NOTE node under memory pressure' \
    || _tsfail "the stamp displaced/mangled the message body — consumers key on the text: '$_ts_plain'"
  # the stamp must be THIS run's clock, not a constant or a fossil: parse it back and bound the skew.
  _tsval="$(printf '%s' "$_ts_plain" | grep -oE '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z')"
  _tsep="$(date -u -d "$_tsval" +%s 2>/dev/null || echo 0)"
  [ "$_tsep" -gt $(( _tenow - 120 )) ] && [ "$_tsep" -lt $(( _tenow + 120 )) ] \
    || _tsfail "the stamp is not this run's clock (parsed '$_tsval') — a constant stamp dates nothing"
  # (iii) the payoff for the machine reader too: a stamped doctor line is now aged by its OWN ts, so an
  #       old finding cannot ride a fresh file mtime. Same bytes, opposite verdicts, only the ts moves.
  printf '%s  \033[31mFAIL\033[0m mesh-foo: line 12: boom\n' "$(date -u -d @$(( _tenow - 45000 )) +%FT%TZ)" > "$_ts/old.log"; touch -d "@$_tenow" "$_ts/old.log"
  printf '%s  \033[31mFAIL\033[0m mesh-foo: line 12: boom\n' "$(date -u -d @$(( _tenow - 60 ))    +%FT%TZ)" > "$_ts/new.log"; touch -d "@$_tenow" "$_ts/new.log"
  [ "$(count_recent_errors "$_ts/old.log" "$_tenow")" = 0 ] \
    || _tsfail "a stamped-but-OLD doctor line still counted — stamping must make it age by its own ts"
  [ "$(count_recent_errors "$_ts/new.log" "$_tenow")" = 1 ] \
    || _tsfail "a stamped and RECENT doctor line stopped counting — the stamp must not hide a live break"
  rm -rf "$_ts"
  rm -rf "$_te"
  # interpretant-check fixtures. These drive the REAL umwelt_slug/um_self_reads the check calls —
  # the old block re-implemented the slug grep inline and so asserted a COPY of the detector, which
  # is why the narrow `.x.state`-only regex survived for months with a green test while both hand-
  # verified dead vehicles (`.diskio-state`, `.wifi-quality-state`) sat outside it.
  _tu="$(mktemp -d)"
  _uf(){ echo "smoke-test: FAIL (interpretant: $1)"; rm -rf "$_tu"; exit 1; }
  printf '#!/usr/bin/env bash\nSTATE="${X_STATE:-$HOME/.mesh/.fixture-a.state}"\nprintf x > "$STATE"\n' > "$_tu/producer-consumed"
  printf '#!/usr/bin/env bash\ncat "$HOME/.mesh/.fixture-a.state"\n'                                    > "$_tu/reader"
  printf '#!/usr/bin/env bash\nSTATE="${Y_STATE:-$HOME/.mesh/.fixture-b.state}"\nprintf x > "$STATE"\n' > "$_tu/producer-orphan"
  printf '#!/usr/bin/env bash\n# umwelt-ok: manual --state only, by design\nSTATE="${Z_STATE:-$HOME/.mesh/.fixture-c.state}"\n' > "$_tu/producer-declared"
  # BOTH live naming conventions, and the mesh-dir-in-a-variable form
  printf '#!/usr/bin/env bash\nSTATE="$HOME/.mesh/.fixture-d-state"\nprintf x > "$STATE"\n'             > "$_tu/producer-dash"
  printf '#!/usr/bin/env bash\nMESH_DIR="$HOME/.mesh"\nSTATE="$MESH_DIR/.fixture-e-state"\nprintf x > "$STATE"\n' > "$_tu/producer-meshvar"
  # prose that merely NAMES a state path is not a declaration
  printf '#!/usr/bin/env bash\nmsg="SIGNAL LINE (board):\ndoctor-warn: mesh-foo ~/.mesh/.fixture-p-state mtime is 9 DAYS old, rc=0"\necho "$msg"\n' > "$_tu/producer-prose"
  # self-consumption shapes: plain read-back, read only inside --test, one-level function hop
  printf '#!/usr/bin/env bash\nSTATE="$HOME/.mesh/.fixture-s-state"\nprev="$(cat "$STATE" 2>/dev/null)"\nprintf x > "$STATE"\n' > "$_tu/producer-self"
  printf '#!/usr/bin/env bash\nSTATE="$HOME/.mesh/.fixture-t-state"\nif [ "${1:-}" = --test ]; then\n  stat -c %%s "$STATE"\n  exit 0\nfi\nprintf x > "$STATE"\n' > "$_tu/producer-testread"
  printf '#!/usr/bin/env bash\nSTATE="$HOME/.mesh/.fixture-h-state"\nload_it() {\n  local f="$1"\n  read -r v < "$f"\n}\nload_it "$STATE"\nprintf x > "$STATE"\n' > "$_tu/producer-fnhop"
  [ "$(umwelt_slug "$_tu/producer-consumed")" = ".fixture-a.state" ] || _uf "slug extraction broke on the .x.state form"
  [ "$(umwelt_slug "$_tu/producer-dash")"     = ".fixture-d-state" ] || _uf "slug extraction misses the .x-state form — the majority naming convention"
  [ "$(umwelt_slug "$_tu/producer-meshvar")"  = ".fixture-e-state" ] || _uf "slug extraction misses a mesh dir held in a variable"
  [ -z "$(umwelt_slug "$_tu/producer-prose")" ]                      || _uf "a state path named in prose was read as a declared output"
  slug_a=$(umwelt_slug "$_tu/producer-consumed"); slug_b=$(umwelt_slug "$_tu/producer-orphan")
  grep -lF "$slug_a" "$_tu"/* 2>/dev/null | grep -vFx "$_tu/producer-consumed" >/dev/null \
    || _uf "missed a real reader for $slug_a"
  grep -lF "$slug_b" "$_tu"/* 2>/dev/null | grep -vFx "$_tu/producer-orphan" >/dev/null \
    && _uf "phantom reader for $slug_b"
  grep -Eq '^#[[:space:]]*umwelt-ok:' "$_tu/producer-declared" || _uf "umwelt-ok header not honored"
  # a comment is not a channel: the reader scan runs on the comment-stripped corpus
  printf '#!/usr/bin/env bash\n# see also $HOME/.mesh/.fixture-b.state for the old shape\n' > "$_tu/commenter"
  _us="$(mktemp -d)"; for _g in "$_tu"/*; do sed 's/#.*//' "$_g" > "$_us/$(basename "$_g")"; done
  grep -lF "$slug_b" "$_us"/* 2>/dev/null | grep -vFx "$_us/producer-orphan" >/dev/null \
    && { rm -rf "$_us"; _uf "a comment naming the slug counted as a reader"; }
  grep -lF "$slug_a" "$_us"/* 2>/dev/null | grep -vFx "$_us/producer-consumed" >/dev/null \
    || { rm -rf "$_us"; _uf "stripping comments lost a real code reader"; }
  rm -rf "$_us"
  # the temporal interpretant: self-consumption by a future run is NOT a dead vehicle
  um_self_reads "$_tu/producer-self"  "$(umwelt_slug "$_tu/producer-self")"  || _uf "missed a plain read-back — every debounce/edge sense would flag"
  um_self_reads "$_tu/producer-fnhop" "$(umwelt_slug "$_tu/producer-fnhop")" || _uf "missed a read one function hop away (the local f=\$1 convention)"
  um_self_reads "$_tu/producer-orphan" "$slug_b"                             && _uf "a write-only producer read as self-consuming"
  um_self_reads "$_tu/producer-testread" "$(umwelt_slug "$_tu/producer-testread")" \
    && _uf "a read inside --test earned a temporal interpretant — the harness forging the evidence"
  # ── um_body's THREE openers (2026-08-18). Measured that day: 49 tools open their smoke test with
  # a brace group and 7 behind a MODE dispatch — 56 whose whole --test block was fed to the checks
  # above as production code. Each fixture below reads its OWN state inside the block, so a leak
  # shows up as a forged temporal interpretant (the same assertion producer-testread makes for the
  # one form that always worked), and each also asserts the PRODUCTION half survived — an
  # over-stripping fix that ate the file would otherwise pass every strip assertion.
  printf '#!/usr/bin/env bash\nSTATE="$HOME/.mesh/.fixture-br-state"\n[ "${1:-}" = --test ] && {\n  stat -c %%s "$STATE"\n  [ 1 = 1 ] || { echo "smoke-test: FAIL (inner one-liner)"; exit 1; }\n  echo "smoke-test: ok"; exit 0; }\nprintf x > "$STATE"\n' > "$_tu/producer-braceform"
  printf '#!/usr/bin/env bash\nSTATE="$HOME/.mesh/.fixture-md-state"\nMODE=run\ncase "${1:-}" in\n  --test) MODE=test ;;\n  --json) MODE=json ;;\nesac\nif [ "$MODE" = "test" ]; then\n  stat -c %%s "$STATE"\n  exit 0\nfi\nprintf x > "$STATE"\n' > "$_tu/producer-modeform"
  printf '#!/usr/bin/env bash\nSTATE="$HOME/.mesh/.fixture-ol-state"\nif [ "${1:-}" = --test ]; then LOCKF=/tmp/sandbox.lock; fi\nprev="$(cat "$STATE" 2>/dev/null)"\nprintf x > "$STATE"\n' > "$_tu/producer-oneline"
  printf '#!/usr/bin/env bash\nSTATE="$HOME/.mesh/.fixture-ap-state"\n[ "${1:-}" = --test ] && {\n  [ 1 = 1 ] || { echo "smoke-test: FAIL (the bit\047s own contract must hold)"; exit 1; }\n  echo "smoke-test: ok"; exit 0; }\nprev="$(cat "$STATE" 2>/dev/null)"\nprintf x > "$STATE"\n' > "$_tu/producer-apostrophe"
  um_self_reads "$_tu/producer-braceform" "$(umwelt_slug "$_tu/producer-braceform")" \
    && _uf "brace-group --test block leaked into the body (49 tools open this way) — a read inside it forged a temporal interpretant"
  um_body "$_tu/producer-braceform" | grep -q 'printf x' \
    || _uf "stripping the brace-group block ate the production write after it"
  um_self_reads "$_tu/producer-modeform" "$(umwelt_slug "$_tu/producer-modeform")" \
    && _uf "MODE-dispatch --test block leaked into the body (7 tools dispatch this way)"
  um_body "$_tu/producer-modeform" | grep -q -- '--json) MODE=json' \
    || _uf "the one-line \`--test)\` ARG-PARSE arm was read as a block opener and swallowed its sibling arms"
  um_self_reads "$_tu/producer-oneline" "$(umwelt_slug "$_tu/producer-oneline")" \
    || _uf "a one-line \`if [ \$1 = --test ]; then ...; fi\` sandbox knob was read as a block opener — the rest of the file over-stripped"
  um_self_reads "$_tu/producer-apostrophe" "$(umwelt_slug "$_tu/producer-apostrophe")" \
    || _uf "an apostrophe inside a double-quoted string in the test block broke brace-depth — the block never closed and ate the file"
  rm -rf "$_tu"; unset -f _uf
  # minds_declared_off (chat-review/doctor-autonomy-check-minds-off-cryolf): a card that still lists
  # binaries (mesh-card --refresh auto-detects them) must NOT block a restore.env-declared minds-off
  # node from reading as HANDS-OFF; a normal mind-on node (no restore.env override) must be unaffected.
  _tm="$(mktemp -d)"
  printf '  minds: claude opencode ollama\n' > "$_tm/card-on"
  printf '  minds:\n'                        > "$_tm/card-blank"
  printf 'MESH_MIND_CHANNELS="minds genome"\n' > "$_tm/renv-full"
  printf 'MESH_MIND_CHANNELS=none\n'           > "$_tm/renv-none"
  minds_declared_off "$_tm/card-on" "$_tm/renv-full" \
    && { echo "smoke-test: FAIL (minds_declared_off: mind-on card + non-empty restore.env wrongly read as OFF)"; rm -rf "$_tm"; exit 1; }
  minds_declared_off "$_tm/card-on" "$_tm/renv-none" \
    || { echo "smoke-test: FAIL (minds_declared_off: restore.env MESH_MIND_CHANNELS=none must read OFF even with binaries on the card)"; rm -rf "$_tm"; exit 1; }
  minds_declared_off "$_tm/card-blank" "$_tm/does-not-exist" \
    || { echo "smoke-test: FAIL (minds_declared_off: blanked card with no restore.env must still read OFF)"; rm -rf "$_tm"; exit 1; }
  minds_declared_off "$_tm/card-on" "$_tm/does-not-exist" \
    && { echo "smoke-test: FAIL (minds_declared_off: mind-on card with no restore.env wrongly read as OFF)"; rm -rf "$_tm"; exit 1; }
  rm -rf "$_tm"
  # systemd failed-units filter: session-*/run-*.scope accounting noise dropped, a real .service/.timer kept
  _su="$(printf 'session-c14948.scope\nrun-r99.scope\nfoo.service\nbar.timer\n' | filter_failed_units)"
  printf '%s\n' "$_su" | grep -qF 'session-c14948.scope' && { echo "smoke-test: FAIL (filter_failed_units kept a session scope)"; exit 1; }
  printf '%s\n' "$_su" | grep -qF 'run-r99.scope'        && { echo "smoke-test: FAIL (filter_failed_units kept a run scope)"; exit 1; }
  printf '%s\n' "$_su" | grep -qF 'foo.service'          || { echo "smoke-test: FAIL (filter_failed_units dropped a real failed service)"; exit 1; }
  printf '%s\n' "$_su" | grep -qF 'bar.timer'            || { echo "smoke-test: FAIL (filter_failed_units dropped a real failed timer)"; exit 1; }
  # sandbox-sweep regression guard (doctor-smoke-sandbox-net): every child --test invocation must
  # carry the MESH_TEST_SANDBOX=1 export (3 sweep sites + camera/link-flap/lid capability probes),
  # or a future edit silently reopens the outbound-leak window this closes.
  _sb=$(grep -cE 'MESH_TEST_SANDBOX=1 (timeout|mesh-)' "$0" 2>/dev/null)
  [ "${_sb:-0}" -ge 6 ] || { echo "smoke-test: FAIL (child --test sites missing MESH_TEST_SANDBOX=1 export: found $_sb, want >=6)"; exit 1; }
  # TMPDIR fence (board task mesh-home-wordlist-temp-producer, 2026-08-16). Driven against a stub that
  # REALLY leaks — a bare `mktemp` with no cleanup, the exact idiom found in ~1 tool in 11 — so the gate
  # asserts the behaviour, not the presence of the words. Three separable claims, each able to go red on
  # its own: the child's mktemp lands INSIDE the fence (not in the shared /tmp), the residue is COUNTED
  # before removal, and the fence dir is GONE afterwards. A fence that quietly deleted without counting
  # would still pass a "no debris" check — that is the absorb-the-fault shape this splits apart.
  _tf="$(mktemp -d)"
  printf '#!/usr/bin/env bash\nmktemp >/dev/null 2>&1\nexit 0\n' > "$_tf/leaky"; chmod +x "$_tf/leaky"
  printf '#!/usr/bin/env bash\nexit 0\n' > "$_tf/clean"; chmod +x "$_tf/clean"
  ( _fence_tmpdir "$_tf" leaky && "$_tf/leaky" ) >/dev/null 2>&1
  # ...the subshell exported TMPDIR only for itself, so re-derive the path the same way the caller does
  _tfn=$(find "$_tf/td.leaky" -mindepth 1 -maxdepth 1 2>/dev/null | wc -l)
  [ "${_tfn:-0}" -eq 1 ] || { echo "smoke-test: FAIL (_fence_tmpdir did not redirect the child's mktemp into the fence: found $_tfn, want 1)"; rm -rf "$_tf"; exit 1; }
  _fence_reap "$_tf" leaky
  [ -d "$_tf/td.leaky" ] && { echo "smoke-test: FAIL (_fence_reap left the fence dir behind — the debris survives the sweep)"; rm -rf "$_tf"; exit 1; }
  _tfr="$(_fence_report "$_tf")"
  printf '%s\n' "$_tfr" | grep -q '^1	leaky$' || { echo "smoke-test: FAIL (_fence_report did not name the leaking tool: got '$_tfr')"; rm -rf "$_tf"; exit 1; }
  # ...and a tool that leaks nothing must NOT be named: a report that flags everyone names no one.
  ( _fence_tmpdir "$_tf" clean && "$_tf/clean" ) >/dev/null 2>&1
  _fence_reap "$_tf" clean
  # ...asserted at BOTH filters, because they are redundant and a check that only reads the outer one
  # is vacuous against a mutation of the inner: reap must not open a residue file for a clean tool,
  # AND the report must not name it. Mutating either alone turns exactly one of these two red.
  [ -e "$_tf/res.clean" ] && { echo "smoke-test: FAIL (_fence_reap opened a residue file for a tool that leaked nothing)"; rm -rf "$_tf"; exit 1; }
  _fence_report "$_tf" | grep -q 'clean$' && { echo "smoke-test: FAIL (_fence_report named a tool that left nothing)"; rm -rf "$_tf"; exit 1; }
  # ...and the report's own filter is driven by a HAND-WRITTEN residue file, not by reap's output. Via
  # reap it can never see a zero (reap declines to open the file), so a leg that only runs the pair
  # asserts nothing about the report — measured: mutating the report guard alone left the test green.
  # Reach past the producer and hand it the input it is supposed to reject.
  printf '0\n' > "$_tf/res.zerofix"
  _fence_report "$_tf" | grep -q 'zerofix$' && { echo "smoke-test: FAIL (_fence_report emitted a zero-count row — a WARN that names a tool and no leak)"; rm -rf "$_tf"; exit 1; }
  printf '0\n2\n' > "$_tf/res.zerofix"
  [ "$(_fence_report "$_tf" | awk '$2=="zerofix"{print $1}')" = 2 ] || { echo "smoke-test: FAIL (_fence_report dropped a real leak that shared a file with a zero row)"; rm -rf "$_tf"; exit 1; }
  rm -f "$_tf/res.zerofix"
  # ...counts ACCUMULATE across the flake-guard/serial-confirm re-runs of the same tool, so a tool that
  # leaks once per attempt is not reported as leaking once total.
  for _ti in 1 2 3; do ( _fence_tmpdir "$_tf" leaky && "$_tf/leaky" ) >/dev/null 2>&1; _fence_reap "$_tf" leaky; done
  _tfr="$(_fence_report "$_tf" | awk '$2=="leaky"{print $1}')"
  [ "${_tfr:-0}" -eq 4 ] || { echo "smoke-test: FAIL (_fence_report overwrote instead of accumulating per-attempt residue: got '$_tfr', want 4)"; rm -rf "$_tf"; exit 1; }
  # ...and the loan is GIVEN BACK. The serial-confirm call site is not in a subshell, so a fence left
  # exported would point doctor's own mktemps at the dir reap just deleted. Assert against a live write.
  TMPDIR="$_tf/host" TMP="$_tf/host" TEMP="$_tf/host"; export TMPDIR TMP TEMP; mkdir -p "$_tf/host"
  _fence_tmpdir "$_tf" restore; _fence_reap "$_tf" restore
  # ${TMPDIR-} not $TMPDIR: under `set -u` a fence that unsets instead of restoring would abort the
  # whole --test on the assertion LINE, which is red for the wrong reason and prints no verdict.
  [ "${TMPDIR-}" = "$_tf/host" ] || { echo "smoke-test: FAIL (_fence_reap did not restore TMPDIR: left '${TMPDIR-<unset>}')"; rm -rf "$_tf"; exit 1; }
  mktemp >/dev/null 2>&1 || { echo "smoke-test: FAIL (mktemp broken after the fence — TMPDIR points at a deleted dir)"; rm -rf "$_tf"; exit 1; }
  unset TMPDIR TMP TEMP
  rm -rf "$_tf"
  # FENCE-ESCAPE DETECTOR (task:doctor-test-tmpdir-cleanup-traps). Four legs, each the others' RED:
  # a hardcoded template is NAMED · the ${TMPDIR:-/tmp} form is NOT · the same literal in a COMMENT is
  # NOT (else this file, whose prose spells the shape out, would name itself every hour) · and the
  # detector does not name a file merely for containing the word mktemp.
  _fe="$(mktemp -d)"
  printf '%s\n' '#!/bin/sh' 'd="$(mktemp -d /tmp/leaky-XXXXXX)"'          > "$_fe/mesh-esc-bad"
  printf '%s\n' '#!/bin/sh' 'd="$(mktemp -d "${TMPDIR:-/tmp}"/ok-XXXXXX)"' > "$_fe/mesh-esc-good"
  printf '%s\n' '#!/bin/sh' '# never write mktemp -d /tmp/foo.XXXX here'   > "$_fe/mesh-esc-comment"
  printf '%s\n' '#!/bin/sh' 'x="$(mktemp)"; rm -f "$x"'                    > "$_fe/mesh-esc-plain"
  # ONE exact-set assertion, not four ordered cases: with `case` the first mismatch short-circuits, so
  # a coarse detector that names three fixtures reports only the first and the other legs read as
  # untested. The expected set is the whole verdict, and the message prints what was actually named.
  _fer="$(_fence_escape_scan "$_fe" | tr -s ' ' | sed 's/^ *//; s/ *$//')"
  [ "$_fer" = "mesh-esc-bad" ] || {
    echo "smoke-test: FAIL (fence-escape detector named '$_fer', want exactly 'mesh-esc-bad' — a hardcoded /tmp template must be named; the \${TMPDIR:-/tmp} form, the same literal inside a COMMENT, and a plain \$(mktemp) must not)"
    rm -rf "$_fe"; exit 1; }
  rm -rf "$_fe"
  # serial-confirm deadline guard (mesh-doctor-serial-confirm-hang, 2026-07-04): the post-storm re-run
  # phase MUST stay time-bounded or a down-phone storm hangs the WHOLE doctor >120s (dash can't refresh).
  src_has '_sc_deadline=' || { echo "smoke-test: FAIL (serial-confirm phase missing _sc_deadline budget — doctor can hang >120s under an unreachable phone)"; exit 1; }
  # serial-confirm rc=1 rescue (chat-review/doctor-serialconfirm-rc1-no-rescue, 2026-07-08): a storm-
  # flake rc=1 must get ONE extra quiet retry before FAIL(real); a genuine repeat rc=1 stays FAIL.
  _tsc="$(mktemp -d)"
  cat > "$_tsc/flaky-once" <<EOF
#!/usr/bin/env bash
c="$_tsc/flake-count"
n=\$(cat "\$c" 2>/dev/null || echo 0); n=\$((n+1)); echo "\$n" > "\$c"
[ "\$n" -ge 2 ] && exit 0 || exit 1
EOF
  printf '#!/usr/bin/env bash\nexit 1\n' > "$_tsc/always-fails"
  chmod +x "$_tsc/flaky-once" "$_tsc/always-fails"
  _dl=$(( $(date +%s) + 60 ))
  # meminfo-healthy pins _sc_mem_exhausted's fallback check so these fixtures are isolated from
  # THIS node's own live meminfo (which may genuinely be swap-exhausted right now, e.g. under a
  # real NODE-PRESSURE episode) — without the override, a real-world exhausted node would flip
  # the expected 'fail' verdicts below into 'na' and the test would lie about what it's checking.
  printf 'MemTotal:       8000000 kB\nMemAvailable:   6000000 kB\nSwapTotal:      8000000 kB\nSwapFree:       6000000 kB\n' > "$_tsc/meminfo-healthy"
  [ "$(MESH_DOCTOR_MEMINFO_FILE="$_tsc/meminfo-healthy" _sc_confirm_tool "$_tsc/flaky-once" "$_dl")" = pass ] \
    || { echo "smoke-test: FAIL (serial-confirm did not rescue a storm-flake rc=1 that clears on retry)"; rm -rf "$_tsc"; exit 1; }
  [ "$(MESH_DOCTOR_MEMINFO_FILE="$_tsc/meminfo-healthy" _sc_confirm_tool "$_tsc/always-fails" "$_dl")" = fail ] \
    || { echo "smoke-test: FAIL (serial-confirm wrongly rescued a genuine repeat rc=1 failure)"; rm -rf "$_tsc"; exit 1; }
  # UNASSESSED split (doctor-timeout-na-mislabeled-no-hardware, 2026-07-31): a --test doctor could not
  # FINISH (budget spent, or a truncated-window timeout) must read 'unassessed', NEVER 'na' — a timeout
  # and an absent organ are different claims, and merging them let mesh-pace's 90s gate hide in the 'no
  # hardware' list for weeks. RED before the split: both these returned 'na'. Both fixtures are INSTANT
  # (a past deadline / a self-declared exit 124) — no sleep, so the assertion can't itself go slow-green.
  _dl_spent=$(( $(date +%s) - 1 ))   # deadline already passed → _rem<5 → budget-spent path
  [ "$(MESH_DOCTOR_MEMINFO_FILE="$_tsc/meminfo-healthy" _sc_confirm_tool "$_tsc/always-fails" "$_dl_spent")" = unassessed ] \
    || { echo "smoke-test: FAIL (budget-spent must read 'unassessed', not 'na' — a timeout is not absent hardware)"; rm -rf "$_tsc"; exit 1; }
  printf '#!/usr/bin/env bash\nexit 124\n' > "$_tsc/times-out"; chmod +x "$_tsc/times-out"
  _dl_near=$(( $(date +%s) + 10 ))   # _rem=10 → _sc_to=10<60 → rc=124 under a TRUNCATED window
  [ "$(MESH_DOCTOR_MEMINFO_FILE="$_tsc/meminfo-healthy" _sc_confirm_tool "$_tsc/times-out" "$_dl_near")" = unassessed ] \
    || { echo "smoke-test: FAIL (truncated-window timeout must read 'unassessed', not 'na')"; rm -rf "$_tsc"; exit 1; }
  # mem-pressure gate (chat-review/doctor-storm-victim-mempressure-retry, 2026-07-08): a repeat rc=1
  # under genuine PSI memory pressure must defer to na, never FAIL(real) — CPU-storm-flake handling
  # above is unchanged (low pressure still fails a genuine repeat rc=1).
  printf 'some avg10=45.00 avg60=30.00 avg300=10.00 total=123456\nfull avg10=20.00 avg60=15.00 avg300=5.00 total=1234\n' > "$_tsc/pressure-high"
  printf 'some avg10=0.00 avg60=0.00 avg300=0.00 total=0\nfull avg10=0.00 avg60=0.00 avg300=0.00 total=0\n'                > "$_tsc/pressure-low"
  [ "$(MESH_DOCTOR_MEMPRESSURE_FILE="$_tsc/pressure-high" MESH_DOCTOR_MEMINFO_FILE="$_tsc/meminfo-healthy" _sc_confirm_tool "$_tsc/always-fails" "$_dl")" = na ] \
    || { echo "smoke-test: FAIL (serial-confirm did not defer to na under high PSI memory pressure)"; rm -rf "$_tsc"; exit 1; }
  [ "$(MESH_DOCTOR_MEMPRESSURE_FILE="$_tsc/pressure-low" MESH_DOCTOR_MEMINFO_FILE="$_tsc/meminfo-healthy" _sc_confirm_tool "$_tsc/always-fails" "$_dl")" = fail ] \
    || { echo "smoke-test: FAIL (serial-confirm wrongly deferred a genuine repeat rc=1 under low PSI pressure)"; rm -rf "$_tsc"; exit 1; }
  # swap-exhaustion-without-PSI-refault gate (chat-review/doctor-swap-exhaustion-no-psi-stall,
  # 2026-07-08): low PSI avg10 alone must not force a FAIL(real) when SwapFree/MemAvailable are
  # themselves exhausted — the exact gap health caught live (mesh-note3-desk, swap 98.4% full, avg10=0.05).
  printf 'MemTotal:       8000000 kB\nMemAvailable:   6000000 kB\nSwapTotal:      8000000 kB\nSwapFree:         100000 kB\n' > "$_tsc/meminfo-swap-exhausted"
  [ "$(MESH_DOCTOR_MEMPRESSURE_FILE="$_tsc/pressure-low" MESH_DOCTOR_MEMINFO_FILE="$_tsc/meminfo-swap-exhausted" _sc_confirm_tool "$_tsc/always-fails" "$_dl")" = na ] \
    || { echo "smoke-test: FAIL (serial-confirm did not defer to na under swap-exhaustion with low PSI)"; rm -rf "$_tsc"; exit 1; }
  # top-level --cron preflight gate (chat-review/doctor-no-preflight-mempressure-gate, 2026-07-08):
  # a CRON run under genuine pressure must skip the fan-out entirely; a healthy CRON run, or ANY
  # interactive (non-CRON) run regardless of pressure, must never be gated (operator asked, proceed).
  CRON=1 MESH_DOCTOR_MEMPRESSURE_FILE="$_tsc/pressure-high" MESH_DOCTOR_MEMINFO_FILE="$_tsc/meminfo-healthy" _sc_should_skip_cron_for_pressure \
    || { echo "smoke-test: FAIL (--cron preflight did not gate under high PSI pressure)"; rm -rf "$_tsc"; exit 1; }
  CRON=1 MESH_DOCTOR_MEMPRESSURE_FILE="$_tsc/pressure-low" MESH_DOCTOR_MEMINFO_FILE="$_tsc/meminfo-healthy" _sc_should_skip_cron_for_pressure \
    && { echo "smoke-test: FAIL (--cron preflight wrongly gated a healthy node)"; rm -rf "$_tsc"; exit 1; }
  CRON=0 MESH_DOCTOR_MEMPRESSURE_FILE="$_tsc/pressure-high" MESH_DOCTOR_MEMINFO_FILE="$_tsc/meminfo-healthy" _sc_should_skip_cron_for_pressure \
    && { echo "smoke-test: FAIL (non-CRON run was wrongly gated by the --cron-only preflight)"; rm -rf "$_tsc"; exit 1; }
  # ledger-resolution gate (uxn gates-as-data: the node-pressure band is ONE row shared with
  # mesh-resource-guard). Drives the REAL _sc_mem_exhausted against ONE meminfo fixture — 20%
  # MemAvailable, swap comfortable — under three different ledgers, so only the resolution can
  # move the verdict. A gate that merely greps for 'node-pressure' in this file would assert its
  # own text (the self-grep class); this one can only pass if the ledger read actually feeds the
  # threshold. Env > ledger > inline is asserted in that order, plus the fail-open floor.
  printf 'MemTotal:       8000000 kB\nMemAvailable:   1600000 kB\nSwapTotal:      8000000 kB\nSwapFree:       6000000 kB\n' > "$_tsc/meminfo-avail20"
  printf 'node-pressure | apct spct hasswap | mem=30 swap=5 | (if (< apct mem) 1 0)\n' > "$_tsc/ledger-mem30"
  MESH_THRESHOLD_LEDGER="$_tsc/ledger-mem30" MESH_DOCTOR_MEMINFO_FILE="$_tsc/meminfo-avail20" _sc_mem_exhausted \
    || { echo "smoke-test: FAIL (ledger mem=30 did not reach _sc_mem_exhausted — 20% avail read as healthy, so the node-pressure row is not wired)"; rm -rf "$_tsc"; exit 1; }
  MESH_THRESHOLD_LEDGER="$_tsc/nonexistent-ledger" MESH_DOCTOR_MEMINFO_FILE="$_tsc/meminfo-avail20" _sc_mem_exhausted \
    && { echo "smoke-test: FAIL (missing ledger did not fail-open to the inline 10% floor — 20% avail wrongly read as exhausted)"; rm -rf "$_tsc"; exit 1; }
  MESH_DOCTOR_MEMAVAIL_PCT=30 MESH_THRESHOLD_LEDGER="$_tsc/nonexistent-ledger" MESH_DOCTOR_MEMINFO_FILE="$_tsc/meminfo-avail20" _sc_mem_exhausted \
    || { echo "smoke-test: FAIL (MESH_DOCTOR_MEMAVAIL_PCT env override did not win over the ledger/inline default)"; rm -rf "$_tsc"; exit 1; }
  rm -rf "$_tsc"
  # link-bracket gate (chat-review/doctor-smoke-verdict-straddles-link-outage, 2026-07-16): a sweep
  # straddling an uplink outage must land still-failing survivors in the outage n/a lane, never
  # 'FAIL (real)'. Drives the REAL probe (forced verdict override) and the REAL classifier
  # (call-site globals), all bracket combinations; healthy-link must leave a real FAIL a FAIL.
  MESH_DOCTOR_LINK_STATE=down _link_up \
    && { echo "smoke-test: FAIL (link probe ignored forced-down override)"; exit 1; }
  MESH_DOCTOR_LINK_STATE=up _link_up \
    || { echo "smoke-test: FAIL (link probe ignored forced-up override)"; exit 1; }
  sm_fail=" mesh-fixture-a mesh-fixture-b"; sm_link_na=""
  _sm_apply_link_bracket 1 1
  [ "$sm_fail" = " mesh-fixture-a mesh-fixture-b" ] && [ -z "$sm_link_na" ] \
    || { echo "smoke-test: FAIL (healthy-link bracket must leave a real FAIL a FAIL)"; exit 1; }
  _sm_apply_link_bracket 0 1
  [ -z "$sm_fail" ] && [ "$sm_link_na" = " mesh-fixture-a mesh-fixture-b" ] \
    || { echo "smoke-test: FAIL (pre-bracket-down survivors must classify to the link-outage n/a lane, not '(real)')"; exit 1; }
  sm_fail=" mesh-fixture-c"; sm_link_na=""
  _sm_apply_link_bracket 1 0
  [ -z "$sm_fail" ] && [ "$sm_link_na" = " mesh-fixture-c" ] \
    || { echo "smoke-test: FAIL (post-bracket-down survivors must classify to the link-outage n/a lane)"; exit 1; }
  sm_fail=""; sm_link_na=""
  _sm_apply_link_bracket 0 0
  [ -z "$sm_fail" ] && [ -z "$sm_link_na" ] \
    || { echo "smoke-test: FAIL (empty survivor set must stay empty under a down bracket)"; exit 1; }
  # exec-bit landmine scoping (chat-review/doctor-execbit-fails-on-untracked-source): drive exec_bit_landmines
  # against a fixture git repo. An UNTRACKED non-+x source must NOT be flagged (mid-dev — hard-FAILing it
  # pages the operator); a COMMITTED non-+x source AND a deployed non-+x tool MUST be; a +x script must not.
  # RED against the old glob (it flagged every scripts/*, so the untracked assertion below failed).
  _xd="$(mktemp -d)"
  mkdir -p "$_xd/g/scripts" "$_xd/bin"
  git -C "$_xd/g" init -q >/dev/null 2>&1
  printf '#!/bin/bash\n' > "$_xd/g/scripts/mesh-committed-nox"                        # committed non-+x → landmine
  git -C "$_xd/g" add scripts/mesh-committed-nox >/dev/null 2>&1
  git -C "$_xd/g" -c user.email=t@t -c user.name=t commit -qm x >/dev/null 2>&1
  printf '#!/bin/bash\n' > "$_xd/g/scripts/mesh-wip-nox"                              # untracked non-+x → mid-dev, NOT a landmine
  printf '#!/bin/bash\n' > "$_xd/g/scripts/mesh-ok"; chmod +x "$_xd/g/scripts/mesh-ok"  # +x → fine
  printf '#!/bin/bash\n' > "$_xd/bin/mesh-deployed-nox"                               # deployed non-+x → landmine
  _lm=" $(exec_bit_landmines "$_xd/g" "$_xd/bin") "
  rm -rf "$_xd"
  case "$_lm" in *" mesh-committed-nox "*) : ;; *) echo "smoke-test: FAIL (exec-bit: committed non-+x source not flagged:$_lm)"; exit 1 ;; esac
  case "$_lm" in *" mesh-deployed-nox "*)  : ;; *) echo "smoke-test: FAIL (exec-bit: deployed non-+x tool not flagged:$_lm)"; exit 1 ;; esac
  case "$_lm" in *" mesh-wip-nox "*) echo "smoke-test: FAIL (exec-bit: UNTRACKED WIP source flagged as landmine — would page operator:$_lm)"; exit 1 ;; esac
  case "$_lm" in *" mesh-ok "*) echo "smoke-test: FAIL (exec-bit: +x script wrongly flagged:$_lm)"; exit 1 ;; esac
  # flock-skip visibility gate (doctor-cron-hang misdiagnosis, 2026-07-23): a --cron run that yields
  # to an already-running doctor must SAY SO on stdout (→ doctor.log) — the silent exit 0 was
  # indistinguishable from a completed run and left .doctor-fails frozen with no visible reason.
  # Drives the REAL script re-invoked under a temp HOME whose lock a holder subshell already owns;
  # if the skip path ever goes silent again (or stops exiting 0) this fails loud. A broken holder
  # race fails loud too: the child would start a real sweep and hit the 6s timeout (rc=124).
  _tl=$(mktemp -d); mkdir -p "$_tl/.mesh"
  ( exec 9>"$_tl/.mesh/.doctor.lock"; flock 9; sleep 8 ) & _tlpid=$!
  sleep 0.3
  _tlout="$(HOME="$_tl" timeout 6 "$0" --cron 2>/dev/null)"; _tlrc=$?
  kill "$_tlpid" 2>/dev/null; wait "$_tlpid" 2>/dev/null
  case "$_tlout" in *skipped*) : ;; *) echo "smoke-test: FAIL (lock-held --cron skip was silent — no 'skipped' line on stdout)"; rm -rf "$_tl"; exit 1 ;; esac
  [ "$_tlrc" = 0 ] || { echo "smoke-test: FAIL (lock-held --cron skip rc=$_tlrc, want 0)"; rm -rf "$_tl"; exit 1; }
  rm -rf "$_tl"

  # ── --sediment (environment-side support structures) ──────────────────────────────────────────
  # Every leg drives the REAL script (`"$0" --sediment`) against a fixture node-config, never a
  # helper in-process: the classifier being right proves nothing if the flag is not wired to it.
  _sd="$(mktemp -d)"; mkdir -p "$_sd/bin"
  cat > "$_sd/nodes" <<'EOSDN'
A_ACTIVE=zzactivezz
B_COMMENTONLY=zzcommentzz
C_ABSENT=zzabsentzz
D_REDUNDANT=zzdfltzz
E_DIVERGENT=zzminezz
F_BARE=zzdfltzz
G_TWODEFS=zzdfltzz
H_MULTI=zzdfltzz; export H_TAIL=zztailzz
# I_DISABLED=zzoffzz
EOSDN
  cat > "$_sd/example" <<'EOSDE'
A_ACTIVE=
# D_REDUNDANT=
V_VIRTUAL=
EOSDE
  cat > "$_sd/bin/fixture-reader" <<'EOSDR'
#!/usr/bin/env bash
x="$A_ACTIVE"
# B_COMMENTONLY appears ONLY in this full-line comment — prose, not a read
d="${D_REDUNDANT:-zzdfltzz}"
e="${E_DIVERGENT:-zzdfltzz}"
f="${F_BARE:-zzdfltzz}"; g="$F_BARE"
h="${G_TWODEFS:-zzdfltzz}"; i="${G_TWODEFS:-zzotherzz}"
j="${H_MULTI:-zzdfltzz}"
EOSDR
  : > "$_sd/cron"
  _sdrun(){ MESH_DOCTOR_NODES="$_sd/nodes" MESH_DOCTOR_NODES_EXAMPLE="$_sd/example" \
            MESH_DOCTOR_SEDIMENT_SCAN="$_sd/bin" MESH_DOCTOR_REFLEX_CRON="$_sd/cron" \
            MESH_DOCTOR_SEDIMENT_NOCRONTAB=1 "$0" --sediment 2>&1; }
  _sdo="$(_sdrun)"; _sdrc=$?
  _sdf(){ echo "smoke-test: FAIL (--sediment: $1)"; printf '%s\n' "$_sdo" | sed 's/^/    /'; rm -rf "$_sd"; exit 1; }
  # s1: a knob read by real code is ACTIVE — never listed as UNREAD
  printf '%s' "$_sdo" | grep -q 'A_ACTIVE' && _sdf "A_ACTIVE has a live reader and must not be listed at all"
  # s2: a knob named ONLY inside a full-line comment is UNREAD — the comment-mention rule
  printf '%s' "$_sdo" | grep -qE 'B_COMMENTONLY +[a-z]+ +prose-mentions=[1-9]' \
    || _sdf "a knob mentioned only in a full-line comment must read UNREAD with its prose mention counted"
  # s3: a knob named nowhere is UNREAD with zero prose mentions
  printf '%s' "$_sdo" | grep -qE 'C_ABSENT +[a-z]+ +prose-mentions=0' \
    || _sdf "a knob named nowhere must read UNREAD prose-mentions=0"
  # s4: every reference defaulted, one default, equal to the value → REDUNDANT (and a COMMENTED
  # declaration in nodes.example still declares it: canonical, not alternative)
  printf '%s' "$_sdo" | grep -qE 'D_REDUNDANT +canonical +reads=' \
    || _sdf "a knob whose only reader defaults to its own value must read REDUNDANT/canonical"
  # s5: default present but DIFFERENT from the set value → the knob does work → not REDUNDANT
  printf '%s' "$_sdo" | grep -q 'E_DIVERGENT' && _sdf "a knob whose value differs from the reader default must not be listed"
  # s6: one bare \$K reference keeps it ACTIVE even though a default matches (set -u conservatism)
  printf '%s' "$_sdo" | grep -q 'F_BARE' && _sdf "a bare-referenced knob must stay ACTIVE, not REDUNDANT"
  # s7: two distinct defaults → one of them is not the value → ACTIVE
  printf '%s' "$_sdo" | grep -q 'G_TWODEFS' && _sdf "two distinct defaults must not yield REDUNDANT"
  # s8: `K=v; export OTHER=w` on one line — the value ends at the `;`, else the compare silently fails
  printf '%s' "$_sdo" | grep -q 'H_MULTI' \
    || _sdf "a value followed by a second statement on the same line must still compare equal (REDUNDANT)"
  # s9: a commented-out assignment is DISABLED, not a knob this node sets; and a key declared in
  # nodes.example but unset here is an unactualized virtuality
  printf '%s' "$_sdo" | grep -qE 'knobs set: 8 \(canonical 2 · alternative 6\) · disabled-in-place: 1 · unactualized in nodes.example: 1' \
    || _sdf "census wrong — want 8 set (2 canonical/6 alternative), 1 disabled-in-place, 1 unactualized"
  # s10: the verdicts partition the knobs that are set
  printf '%s' "$_sdo" | grep -qE 'verdicts: ACTIVE 4 · REDUNDANT 2 · UNREAD 2' \
    || _sdf "verdict census wrong — want ACTIVE 4 · REDUNDANT 2 · UNREAD 2"
  # s11: NO VALUE IS EVER PRINTED — this report names a node's secret-adjacent config surface
  printf '%s' "$_sdo" | grep -q 'zz[a-z]*zz' && _sdf "a value from the node config leaked into the report"
  [ "$_sdrc" = 0 ] || _sdf "a clean report must exit 0, got $_sdrc"
  # s12: both edges of the runtime-name-construction caveat — silent without the idiom, loud with it
  printf '%s' "$_sdo" | grep -q 'caveat: runtime name construction' \
    && _sdf "the name-construction caveat fired on a fixture that has no \${!}/eval/printf -v"
  printf '\nv="${!A_ACTIVE}"\n' >> "$_sd/bin/fixture-reader"
  _sdrun | grep -q 'caveat: runtime name construction' \
    || _sdf "the name-construction caveat must fire once \${!var} is present — UNREAD understates there"
  # s13: no readable node config is an honest n/a about THIS node, not an empty green report
  rm -f "$_sd/nodes"
  _sdo="$(_sdrun)"; _sdrc=$?
  [ "$_sdrc" = 2 ] || _sdf "a missing node config must exit 2 (honest n/a), got $_sdrc"
  printf '%s' "$_sdo" | grep -q 'n/a' || _sdf "the n/a exit must SAY it is n/a"
  rm -rf "$_sd"

  # ── --supersede (change-anchored supersession) ────────────────────────────────────────────────
  # Every leg drives the REAL script against a fixture config + fixture producers + fixture artifact
  # dir, and the load-bearing legs assert a TRANSITION IN VERDICT across a config edit — a pass that
  # only ever printed CURRENT would satisfy any static assertion.
  _ss="$(mktemp -d)"; mkdir -p "$_ss/bin" "$_ss/art" "$_ss/st"
  cat > "$_ss/nodes" <<'EOSSN'
MESH_ZZ_WATCHED=zzoldzz
MESH_ZZ_OTHER=zzotherzz
EOSSN
  # producer A reads the watched knob · B reads only the other · C names the watched knob ONLY in a
  # comment and inside its own --test block (both stripped by um_body → not a read)
  printf '#!/usr/bin/env bash\nSTATE="$HOME/.mesh/.zz-a.state"\nx="${MESH_ZZ_WATCHED:-d}"\n' > "$_ss/bin/mesh-zz-a"
  printf '#!/usr/bin/env bash\nSTATE="$HOME/.mesh/.zz-b.state"\nx="${MESH_ZZ_OTHER:-d}"\n' > "$_ss/bin/mesh-zz-b"
  printf '#!/usr/bin/env bash\nSTATE="$HOME/.mesh/.zz-c.state"\n# MESH_ZZ_WATCHED is named here in prose only\nif [ "${1:-}" = --test ]; then\n  y="$MESH_ZZ_WATCHED"\nfi\n' > "$_ss/bin/mesh-zz-c"
  # a CONSUMER that also declares zz-a's artifact (the mesh-dash/.climate-state shape): it must not
  # own the row, and the artifact must be judged ONCE
  printf '#!/usr/bin/env bash\nROW="$HOME/.mesh/.zz-a.state"\nx="${MESH_ZZ_OTHER:-d}"\n' > "$_ss/bin/mesh-aa-dash"
  : > "$_ss/art/.zz-a.state"; : > "$_ss/art/.zz-b.state"; : > "$_ss/art/.zz-c.state"
  _ssrun(){ MESH_DOCTOR_NODES="$_ss/nodes" MESH_DOCTOR_SUPERSEDE_SCAN="$_ss/bin" \
            MESH_DOCTOR_SUPERSEDE_ARTIFACTS="$_ss/art" MESH_DOCTOR_SUPERSEDE_STATE="$_ss/st" \
            "$0" --supersede 2>&1; }
  _ssf(){ echo "smoke-test: FAIL (--supersede: $1)"; printf '%s\n' "$_sso" | sed 's/^/    /'; rm -rf "$_ss"; exit 1; }
  _sso="$(_ssrun)"; _ssrc=$?
  # p1: the FIRST run has no prior snapshot — it may not accuse anything, and it must say so
  [ "$_ssrc" = 0 ] || _ssf "a baseline run must exit 0 (nothing can be superseded yet), got $_ssrc"
  printf '%s' "$_sso" | grep -q 'BASELINE RUN' || _ssf "the first run must declare itself a baseline"
  printf '%s' "$_sso" | grep -q 'SUPERSEDED 0' || _ssf "a baseline run accused something with no ledger to accuse from"
  # p2: a run with NO config change records no transition and still accuses nothing — AND, now that
  # coverage has opened, an artifact written after it is certifiable. CURRENT must be REACHABLE: if
  # the coverage stamp were re-read as "now" each run, nothing could ever be newer than it and the
  # pass could only ever answer "I cannot tell", which is not an answer.
  sleep 1; touch "$_ss/art/.zz-a.state" "$_ss/art/.zz-b.state"
  _sso="$(_ssrun)"; _ssrc=$?
  printf '%s' "$_sso" | grep -qE 'ledger: .* — 0 transition' || _ssf "an unchanged config must record no transition"
  printf '%s' "$_sso" | grep -qE 'verdicts: CURRENT 2 ·' \
    || _ssf "an artifact written after coverage opened must be certified CURRENT (coverage stamp not pinned?)"
  [ "$_ssrc" = 0 ] || _ssf "an unchanged config must exit 0, got $_ssrc"
  # the stamp is a real line in the ledger, written ONCE, and it is the line coverage is read from
  [ "$(grep -c 'COVERAGE-OPEN' "$_ss/st/config-transitions.log" 2>/dev/null)" = 1 ] \
    || _ssf "the ledger must carry exactly one COVERAGE-OPEN stamp"
  head -1 "$_ss/st/config-transitions.log" 2>/dev/null | grep -q 'COVERAGE-OPEN' \
    || _ssf "the coverage stamp must be the ledger's FIRST line — that is where cover_from is read"
  # and coverage does not slide: the same instant is reported a second later (a sliding fallback
  # would move with the clock and could never certify anything)
  _sso2="$(sleep 1; _ssrun)"
  [ "$(printf '%s' "$_sso"  | sed -n 's/.*coverage begins \([^ ]*\).*/\1/p')" \
  = "$(printf '%s' "$_sso2" | sed -n 's/.*coverage begins \([^ ]*\).*/\1/p')" ] \
    || _ssf "coverage slid between two runs — it must be pinned in the ledger, not re-read as now"
  # p3: THE MECHANISM — age every artifact past the edit, then change the watched knob and touch
  # nothing. The artifact whose producer reads that knob flips to SUPERSEDED; rc goes 3.
  touch -d '-1 hour' "$_ss/art/.zz-a.state" "$_ss/art/.zz-b.state" "$_ss/art/.zz-c.state"
  sed -i 's/zzoldzz/zznewzz/' "$_ss/nodes"
  _sso="$(_ssrun)"; _ssrc=$?
  [ "$_ssrc" = 3 ] || _ssf "a real supersession must exit 3, got $_ssrc"
  printf '%s' "$_sso" | grep -qE 'mesh-zz-a +\.zz-a\.state .*MESH_ZZ_WATCHED changed' \
    || _ssf "the artifact whose producer reads the changed knob must be named SUPERSEDED with the knob"
  # p4: the producer that reads only the UNCHANGED knob is not swept into the accusation
  printf '%s' "$_sso" | grep -q 'mesh-zz-b' && _ssf "a producer reading no changed knob must not be accused"
  # p4b: an artifact is judged ONCE and the row names its WRITER — a consumer that merely declares the
  # same state string (four declarers, three artifacts) must not own the row or double-count it
  printf '%s' "$_sso" | grep -qE 'producers declaring a state artifact: 4 · distinct artifacts: 3 · present here: 3' \
    || _ssf "a second declarer of one artifact must collapse to one row (census wrong)"
  printf '%s' "$_sso" | grep -q 'mesh-aa-dash' && _ssf "a consumer declaring the artifact must not own the row"
  [ "$(printf '%s' "$_sso" | grep -c '\.zz-a\.state')" = 1 ] || _ssf "the artifact was judged more than once"
  # p5: a knob named only in a comment or inside the producer's own --test block is NOT a read
  printf '%s' "$_sso" | grep -q 'mesh-zz-c' && _ssf "a comment/--test-block mention was counted as a dependency"
  # p6: THE REFUSAL TO CERTIFY — zz-b has no changed knob, and it is STILL not CURRENT, because it
  # predates the ledger: an unwatched knob may have moved before coverage opened. UNKNOWN-CURRENT is
  # the paper's third state and this is the leg that proves we do not fabricate a clean bill.
  printf '%s' "$_sso" | grep -qE 'UNKNOWN-CURRENT 1 ' \
    || _ssf "an artifact predating the ledger must read UNKNOWN-CURRENT, not CURRENT"
  printf '%s' "$_sso" | grep -qE 'verdicts: CURRENT 0 ·' || _ssf "nothing here is certifiable — CURRENT must be 0"
  # p7: re-running the producer (touching its artifact) clears it — the verdict is temporal, not sticky
  touch "$_ss/art/.zz-a.state"
  _sso="$(_ssrun)"; _ssrc=$?
  [ "$_ssrc" = 0 ] || _ssf "an artifact re-written after the transition must clear (rc 0), got $_ssrc"
  printf '%s' "$_sso" | grep -q 'SUPERSEDED 0' || _ssf "a touched artifact must leave the SUPERSEDED set"
  # p8: NO VALUE, old or new, is ever printed — ~/.mesh/nodes is secret-adjacent
  printf '%s' "$_sso" | grep -q 'zz[a-z]*zz' && _ssf "a config value leaked into the report"
  # p9: nor stored — the ledger and snapshot carry salted digests only
  grep -rq 'zz[a-z]*zz' "$_ss/st" 2>/dev/null && _ssf "a config value was written to the snapshot/ledger"
  [ -s "$_ss/st/config-transitions.log" ] || _ssf "the transition ledger must exist and be non-empty after a real change"
  # p10: no readable node config is an honest n/a about THIS node, not an empty green report
  rm -f "$_ss/nodes"; _sso="$(_ssrun)"; _ssrc=$?
  [ "$_ssrc" = 2 ] || _ssf "a missing node config must exit 2 (honest n/a), got $_ssrc"
  printf '%s' "$_sso" | grep -q 'n/a' || _ssf "the n/a exit must SAY it is n/a"
  rm -rf "$_ss"

  # ── --exclusion (do the readers of one sense agree on when it is too old?) ────────────────────
  # Every leg drives the REAL `"$0" --exclusion` against a fixture corpus. The classes are each
  # other's RED: an AGREED artifact and a SPLIT one differ only in the integers, so a pass that
  # printed everything (or nothing) fails on the opposite leg.
  local _ex; _ex="$(mktemp -d)"; mkdir -p "$_ex/bin"
  _exf(){ echo "smoke-test: FAIL (--exclusion: $1)"; printf '%s\n' "$_exo" | sed 's/^/    /'; rm -rf "$_ex"; exit 1; }
  # ── .zx.state: a producer on a 30-min cadence + three readers (600s · 2100s · no bound at all)
  cat > "$_ex/bin/mesh-zx-src" <<'EOEXA'
#!/usr/bin/env bash
# reflex-cadence: 6-59/30 * * * *
ZX_STATE="$HOME/.mesh/.zx.state"
ZX_EVERY=120
printf '%s\n' "$v" > "$ZX_STATE"
EOEXA
  cat > "$_ex/bin/mesh-zx-r1" <<'EOEXB'
#!/usr/bin/env bash
# a comment line, so this file's body line numbers and its REAL line numbers differ
ZX_STATE="$HOME/.mesh/.zx.state"
if [ "${1:-}" = --test ]; then
  age=$(( $(date +%s) - $(stat -c %Y "$ZX_STATE") )); [ "$age" -le 77 ] && echo t
  exit 0
fi
age=$(( $(date +%s) - $(stat -c %Y "$ZX_STATE" 2>/dev/null || echo 0) ))
[ "$age" -le 600 ] && v="$(cat "$ZX_STATE")"
EOEXB
  cat > "$_ex/bin/mesh-zx-r2" <<'EOEXC'
#!/usr/bin/env bash
ZXR_STATE="$HOME/.mesh/.zx.state"
ZXR_MAXAGE="${MESH_ZXR_MAXAGE:-2100}"
ZXR_HOME_STALE_MIN="${MESH_ZXR_HOME_STALE_MIN:-2}"
a=$(( $(date +%s) - $(stat -c %Y "$ZXR_STATE") )); [ "$a" -le "$ZXR_MAXAGE" ] && echo ok
EOEXC
  printf '#!/usr/bin/env bash\nZ3="$HOME/.mesh/.zx.state"\nv="$(cat "$Z3" 2>/dev/null)"\necho "$v"\n' > "$_ex/bin/mesh-zx-r3"
  # a bound named as a RHYTHM is a cadence, not a max-age — refused (conservative: under-reports)
  cat > "$_ex/bin/mesh-zx-r5" <<'EOEXR5'
#!/usr/bin/env bash
Z5="$HOME/.mesh/.zx.state"
a=$(( $(date +%s) - $(stat -c %Y "$Z5") )); [ "$a" -le "${ZX5_POLL_INTERVAL:-120}" ] && echo ok
EOEXR5
  # a mention in a comment AND inside the file's own --test block is not a read at either place
  cat > "$_ex/bin/mesh-zx-r4" <<'EOEXD'
#!/usr/bin/env bash
# reads $HOME/.mesh/.zx.state when older than 45 seconds — prose only
if [ "${1:-}" = --test ]; then
  Q="$HOME/.mesh/.zx.state"
  q=$(( $(date +%s) - $(stat -c %Y "$Q") )); [ "$q" -le 45 ] && echo t
fi
EOEXD
  # ── .zy.state: two readers that AGREE (900s both) — not a finding
  printf '#!/usr/bin/env bash\nZY_STATE="$HOME/.mesh/.zy.state"\nprintf x > "$ZY_STATE"\n' > "$_ex/bin/mesh-zy-src"
  for _n in 1 2; do
    printf '#!/usr/bin/env bash\nS="$HOME/.mesh/.zy.state"\na=$(( $(date +%%s) - $(stat -c %%Y "$S") )); [ "$a" -le 900 ] && echo ok\n' \
      > "$_ex/bin/mesh-zy-r$_n"
  done
  # ── .zu.state: 30 MINUTES on one side, 1800 seconds on the other — AGREED only if the unit lands
  printf '#!/usr/bin/env bash\nZU_STATE="$HOME/.mesh/.zu.state"\nprintf x > "$ZU_STATE"\n' > "$_ex/bin/mesh-zu-src"
  cat > "$_ex/bin/mesh-zu-r1" <<'EOEXE'
#!/usr/bin/env bash
ZUX_STATE="$HOME/.mesh/.zu.state"
ZUX_STALE_MIN="${MESH_ZUX_STALE_MIN:-30}"
EOEXE
  printf '#!/usr/bin/env bash\nS="$HOME/.mesh/.zu.state"\na=$(( $(date +%%s) - $(stat -c %%Y "$S") )); [ "$a" -le 1800 ] && echo ok\n' \
    > "$_ex/bin/mesh-zu-r2"
  # ── .zc.state: a 5-min producer read at 900s — LOOSER than the cadence, so NOT unsatisfiable
  printf '#!/usr/bin/env bash\n# reflex-cadence: */5 * * * *\nZC_STATE="$HOME/.mesh/.zc.state"\nprintf x > "$ZC_STATE"\n' > "$_ex/bin/mesh-zc-src"
  printf '#!/usr/bin/env bash\nS="$HOME/.mesh/.zc.state"\na=$(( $(date +%%s) - $(stat -c %%Y "$S") )); [ "$a" -le 900 ] && echo ok\n' \
    > "$_ex/bin/mesh-zc-r1"
  # ── .zn.state: every reader unbounded — a lead, never a finding
  printf '#!/usr/bin/env bash\nZN_STATE="$HOME/.mesh/.zn.state"\nprintf x > "$ZN_STATE"\n' > "$_ex/bin/mesh-zn-src"
  printf '#!/usr/bin/env bash\nS="$HOME/.mesh/.zn.state"\nv="$(cat "$S")"\n' > "$_ex/bin/mesh-zn-r1"
  printf '#!/usr/bin/env bash\nS2="$HOME/.mesh/.zn.state"\nw="$(cat "$S2")"\n' > "$_ex/bin/mesh-zn-r2"
  chmod +x "$_ex/bin"/mesh-*
  _exrun(){ MESH_DOCTOR_EXCLUSION_SCAN="$_ex/bin" "$0" --exclusion 2>&1; }
  _exo="$(_exrun)"; _exrc=$?

  # p1 THE MECHANISM: one artifact, two different exclusion predicates → SPLIT, rc 3
  [ "$_exrc" = 3 ] || _exf "a real predicate split must exit 3, got $_exrc"
  printf '%s' "$_exo" | grep -qE '^  \.zx\.state .*600s\.\.2100s' \
    || _exf "the split artifact must name the band between the tightest and the loosest reader"
  printf '%s' "$_exo" | grep -q 'mesh-zx-r1=600s@' || _exf "the 600s reader must be named with its bound"
  printf '%s' "$_exo" | grep -q 'mesh-zx-r2=2100s@' || _exf "the name-pair reader (ZXR_STATE/ZXR_MAXAGE) must resolve to 2100s"
  # p2 THE WRITER IS NOT A READER — its own 120s write rhythm is not an exclusion predicate, and
  # counting it would both widen the band and invent a disagreement that does not exist
  printf '%s' "$_exo" | grep -q 'mesh-zx-src=' && _exf "the producer was counted among its own readers"
  printf '%s' "$_exo" | grep -q '120s' && _exf "a write rhythm (ZX_EVERY) was read as an exclusion predicate"
  # p3 UNSATISFIABLE: 600s against a 30-min producer — it must expire while the producer is healthy
  printf '%s' "$_exo" | grep -qE 'UNSATISFIABLE' || _exf "a bound below the producer cadence must be reported"
  printf '%s' "$_exo" | grep -qE '\.zx\.state +mesh-zx-r1@[0-9]+ bound 600s < producer cadence 1800s' \
    || _exf "the unsatisfiable row must name the reader, its bound and the producer's cadence"
  printf '%s' "$_exo" | grep -q '~66% of every cycle' || _exf "the unsatisfiable row must quantify the false-stale share"
  # p4 AGREEMENT IS NOT A FINDING — the same shape with equal integers must stay out of the SPLIT set
  printf '%s' "$_exo" | grep -q '\.zy\.state' && _exf "two readers that agree were reported as a split"
  # p5 A LOOSER BOUND THAN THE CADENCE IS FINE — UNSATISFIABLE must not be always-on
  printf '%s' "$_exo" | grep -q '\.zc\.state' && _exf "a bound LOOSER than the producer cadence was called unsatisfiable"
  # p6 UNIT: 30 (minutes, by name) and 1800 (seconds) are the SAME predicate — if the minute is read
  # as a second this artifact becomes a 30s..1800s split, which is the loudest possible false finding
  printf '%s' "$_exo" | grep -q '\.zu\.state' && _exf "a _MIN-named bound was not normalised to seconds (30 vs 1800 split)"
  # p7 a comment mention and a mention inside the file's OWN --test block are not reads
  printf '%s' "$_exo" | grep -q 'mesh-zx-r4' && _exf "a comment/--test-block mention was counted as a reader"
  printf '%s' "$_exo" | grep -q '45s' && _exf "a bound from inside a --test block leaked into the report"
  # p8 UNBOUNDED IS A LEAD, NEVER A FINDING: the all-unbounded artifact is counted and not accused,
  # and the unbounded reader of a split artifact is still listed as evidence
  printf '%s' "$_exo" | grep -qE 'NO-BOUND-EXTRACTED [1-9]' || _exf "an artifact whose readers carry no extractable bound must be counted"
  printf '%s' "$_exo" | grep -q '^  \.zn\.state' && _exf "an all-unbounded artifact was reported as a finding"
  printf '%s' "$_exo" | grep -q 'mesh-zx-r3=unbounded@' || _exf "an unbounded reader must still be listed as evidence on a split row"
  # p8b A RHYTHM IS NOT A PREDICATE: `${ZX5_POLL_INTERVAL:-120}` states how often something runs, not
  # how old the bytes may be — reading it as a bound is how a WRITE cadence becomes a false predicate
  printf '%s' "$_exo" | grep -q 'mesh-zx-r5=unbounded@' || _exf "a rhythm-named constant was read as an exclusion predicate"
  # p8c the name-pair rule binds only through freshness vocabulary: ZXR_HOME_STALE_MIN shares the
  # prefix but names something else, and admitting it would put a 120s bound on this artifact
  printf '%s' "$_exo" | grep -q '120s' && _exf "a name-pair with a non-freshness segment was bound to the artifact"
  # p9 THE CITATION MUST NAME THE FILE A HUMAN OPENS — r1's bound sits at a REAL line the stripped
  # body does not share (its --test block is removed before the scan)
  _exln="$(grep -n 'age" -le 600' "$_ex/bin/mesh-zx-r1" | cut -d: -f1)"
  printf '%s' "$_exo" | grep -q "mesh-zx-r1=600s@$_exln" \
    || _exf "the citation must be the RAW file line ($_exln), not the stripped body's"
  # p10 a corpus with no disagreement at all is a clean rc 0 — the report must be able to say nothing
  rm -f "$_ex/bin/mesh-zx-"* "$_ex/bin/mesh-zn-"*
  _exo="$(_exrun)"; _exrc=$?
  [ "$_exrc" = 0 ] || _exf "a corpus with no split and no unsatisfiable bound must exit 0, got $_exrc"
  printf '%s' "$_exo" | grep -q 'SPLIT 0' || _exf "a clean corpus must report SPLIT 0"
  # p11 no corpus is an honest n/a about THIS node, not an empty green report
  rm -rf "$_ex/bin"; _exo="$(_exrun)"; _exrc=$?
  [ "$_exrc" = 2 ] || _exf "a missing tool corpus must exit 2 (honest n/a), got $_exrc"
  printf '%s' "$_exo" | grep -q 'n/a' || _exf "the n/a exit must SAY it is n/a"
  rm -rf "$_ex"

  # ── --nontrivial (trivial vs non-trivial machines among our own --test verdicts) ───────────────
  # Every leg drives the REAL `"$0" --nontrivial` against a fixture toolset. The four classes are
  # each other's RED: collapse the classifier in any direction and one of them fails.
  local _nt; _nt="$(mktemp -d)"; mkdir -p "$_nt/bin" "$_nt/home/.mesh"
  _ntf(){ echo "smoke-test: FAIL (--nontrivial: $1)"; printf '%s\n' "$_nto" | sed 's/^/    /'; rm -rf "$_nt"; exit 1; }
  # a TRIVIAL machine: rc is a function of the input alone, and it owns no state.
  printf '#!/bin/sh\n[ "$1" = --test ] && exit 0\nexit 0\n' > "$_nt/bin/mesh-zt-plain"
  # a NON-TRIVIAL machine of the EIGEN shape: the first --test succeeds and LAYS DOWN the state that
  # makes every later one exit 2. This is the machine the whole mode exists to name — a single run's
  # verdict here is a fact about whether the test had run before, not about the code.
  printf '#!/bin/sh\nS="$HOME/.mesh/.zt-eigen-state"\nif [ "$1" = --test ]; then\n  [ -f "$S" ] && exit 2\n  echo x > "$S"; exit 0\nfi\nexit 0\n' > "$_nt/bin/mesh-zt-eigen"
  # UNSTABLE: no stable pair at all.
  printf '#!/bin/sh\nS="$HOME/.mesh/.zt-flap-count"\nif [ "$1" = --test ]; then\n  n=$(cat "$S" 2>/dev/null); case "$n" in ""|*[!0-9]*) n=0;; esac\n  n=$((n+1)); echo "$n" > "$S"\n  [ $((n %% 2)) = 0 ] && exit 1\n  exit 0\nfi\nexit 0\n' > "$_nt/bin/mesh-zt-flap"
  # TRIVIAL*: constant rc, but it rewrites its own memory every run — the class a pass/fail column
  # cannot show, and the one mesh-guardian was in when its gate read the PREVIOUS run's line.
  printf '#!/bin/sh\nS="$HOME/.mesh/.zt-quiet-count"\nif [ "$1" = --test ]; then\n  n=$(cat "$S" 2>/dev/null); case "$n" in ""|*[!0-9]*) n=0;; esac\n  echo $((n+1)) > "$S"; exit 0\nfi\nexit 0\n' > "$_nt/bin/mesh-zt-quiet"
  # the PARENT of longer siblings. Its --test touches a file the SIBLING owns (`.zt-quiet-count`) —
  # standing in for the ordinary case of another reflex writing during the parent's measurement
  # window, which is the only way name-prefix attribution can go wrong. Without the subtraction the
  # parent is charged with it; a fixture where no sibling file MOVES during the parent's runs makes
  # this leg vacuous, which is how it first shipped (the subtraction mutant stayed green).
  printf '#!/bin/sh\n[ "$1" = --test ] && { : > "$HOME/.mesh/.zt-quiet-count"; exit 0; }\nexit 0\n' > "$_nt/bin/mesh-zt"
  chmod +x "$_nt/bin"/mesh-zt*
  _ntrun(){ rm -f "$_nt/home/.mesh/.doctor-nontrivial-cursor"; HOME="$_nt/home" MESH_DOCTOR_NONTRIVIAL_BIN="$_nt/bin" "$0" --nontrivial "${1:-9}" 2>&1; }
  rm -f "$_nt/home/.mesh"/.zt-*
  local _nto _ntrc; _nto="$(_ntrun)"; _ntrc=$?
  # n1) the EIGEN machine is NAMED as one. A classifier that reads only the last run, or that requires
  #     all three to differ, calls this TRIVIAL and the mode reports a clean genome.
  printf '%s' "$_nto" | grep -qE '^  EIGEN +mesh-zt-eigen +rc 0→2→2' \
    || _ntf "a test that passes once and then exits 2 forever was not classified EIGEN — the first-run transition is the whole signal"
  # n2) …and the trivial one is NOT swept in with it (the over-fire direction).
  printf '%s' "$_nto" | grep -qE '^  TRIVIAL +mesh-zt-plain +rc 0,0,0' \
    || _ntf "a genuinely trivial test was not classified TRIVIAL — the mode manufactures findings"
  # n3) UNSTABLE is a THIRD answer, not EIGEN: rc2 != rc3 means no fixed point was reached, so this
  #     is nondeterminism or a moving input, and calling it EIGEN would assert an internal state.
  printf '%s' "$_nto" | grep -qE '^  UNSTABLE +mesh-zt-flap' \
    || _ntf "an alternating test was not classified UNSTABLE — a flap read as a settled eigenvalue is a false attribution to internal state"
  # n4) TRIVIAL* — the constant-verdict machine that still writes its own memory. Without this class
  #     the report says TRIVIAL and the reader concludes the verdict is a fact about the code.
  printf '%s' "$_nto" | grep -qE '^  TRIVIAL\* +mesh-zt-quiet .*self-write:yes' \
    || _ntf "a test with a constant rc that rewrites its own ~/.mesh state was reported as plain TRIVIAL — the constancy is a fact about the current state, and that must be visible"
  # n5) SIBLING SUBTRACTION: `.zt-eigen-state` is prefix-matched by the parent name `zt` too. If the
  #     longer sibling does not subtract it, mesh-zt is charged with writes it never made — the
  #     accusation direction, and the reason the boundary is decided against the population.
  printf '%s' "$_nto" | grep -qE '^  TRIVIAL +mesh-zt +rc 0,0,0$' \
    || _ntf "the parent tool was charged with its longer sibling's state writes (or annotated at all) — name-prefix attribution must subtract the sibling"
  printf '%s' "$_nto" | grep -qE '^  [A-Z*]+ +mesh-zt +.*self-write:yes' \
    && _ntf "the parent tool read self-write:yes off a file its longer sibling owns — a manufactured accusation"
  # n6) rc 3 on a finding — the mode is consumed by exit code, not only by eye.
  [ "$_ntrc" = 3 ] || _ntf "a population containing EIGEN/UNSTABLE must exit 3 (finding), got $_ntrc"
  # n7) …and rc 0 with NO finding on an all-trivial population: a mode that always returns 3 says
  #     nothing. Driven on a bin holding only the trivial tool.
  mkdir -p "$_nt/bin2"; cp "$_nt/bin/mesh-zt-plain" "$_nt/bin2/"; chmod +x "$_nt/bin2/mesh-zt-plain"
  local _nto2 _ntrc2; _nto2="$(rm -f "$_nt/home/.mesh/.doctor-nontrivial-cursor"; HOME="$_nt/home" MESH_DOCTOR_NONTRIVIAL_BIN="$_nt/bin2" "$0" --nontrivial 9 2>&1)"; _ntrc2=$?
  [ "$_ntrc2" = 0 ] || { _nto="$_nto2"; _ntf "an all-trivial population must exit 0, got $_ntrc2 — a verdict that cannot come back clean is not a verdict"; }
  # n8) NO SILENT CAP: the sample line must count honestly, and a sample larger than the population
  #     must be the population — "sampled 5 of 3 · -2 not sampled" is a report that stopped counting.
  printf '%s' "$_nto" | grep -qE 'sampled 5 of 5 tool\(s\).*0 tool\(s\) not sampled' \
    || _ntf "the sample line does not count the population honestly (want 'sampled 5 of 5 … 0 not sampled')"
  # n9) BLINDNESS IS SAID, NOT SCORED: a tool no ~/.mesh file is named after must read UNKNOWN, never
  #     the string 'self-write:no' — an empty match set digests identically to "nothing moved".
  mkdir -p "$_nt/bin3"
  printf '#!/bin/sh\nS="$HOME/.mesh/unrelated-name"\nif [ "$1" = --test ]; then\n  [ -f "$S" ] && exit 2\n  echo x > "$S"; exit 0\nfi\nexit 0\n' > "$_nt/bin3/mesh-zt-nameless"
  chmod +x "$_nt/bin3/mesh-zt-nameless"; rm -f "$_nt/home/.mesh/unrelated-name"
  local _nto3; _nto3="$(rm -f "$_nt/home/.mesh/.doctor-nontrivial-cursor"; HOME="$_nt/home" MESH_DOCTOR_NONTRIVIAL_BIN="$_nt/bin3" "$0" --nontrivial 9 2>&1)"
  printf '%s' "$_nto3" | grep -q 'self-write:unknown' \
    || { _nto="$_nto3"; _ntf "a tool owning no name-matching artifact must read self-write:unknown — reporting 'no' turns a blind probe into a clean bill"; }
  # …and the refusal is asserted against the ROW, not the report: the standing legend line itself
  # contains the string "self-write:no", so a whole-output grep here is satisfied by boilerplate and
  # can never fail ([[a-substring-gate-on-a-composite-artifact-is-satisfied-by-a-neighbouring-field]]
  # — met on the first run of this very leg).
  printf '%s' "$_nto3" | grep -qE '^  [A-Z*]+ +mesh-.*self-write:no ' \
    && { _nto="$_nto3"; _ntf "a blind discriminator reported 'no' on a tool row"; }
  # n10) THE INSTRUMENT PRINTS ITS OWN BIAS. EIGEN is a first-run transition, so on a node whose
  #      tests have all run the mode is biased toward TRIVIAL. A report that hides that reads as a
  #      census of trivial machines (the observer is inside what it measures — the whole point).
  printf '%s' "$_nto" | grep -q 'blind spot: EIGEN is the FIRST-run transition' \
    || _ntf "the report does not print its own bias toward TRIVIAL"
  rm -rf "$_nt"
  echo "  ok: --nontrivial (EIGEN named, TRIVIAL not swept in, UNSTABLE kept distinct, TRIVIAL* self-write visible, sibling subtraction, rc 3/0 both reachable, honest sample count, blindness says unknown, bias printed)"

  echo "smoke-test: ok (deps + card + reflex-cadence on-demand classifier + canon-scope (catalog mention != intent) + invocation-check vs pipefail+SIGPIPE (400-caller fixture) + source-exec-gate + exec-bit tracked/untracked scoping + systemd failed-units filter + smoke-sweep MESH_TEST_SANDBOX export present at all $_sb child --test sites + serial-confirm deadline bounded + serial-confirm rc=1 storm-flake rescue + child --test TMPDIR fence (redirects · counts before removing · removes · accumulates per attempt · clean tool unnamed at both filters · gives TMPDIR back) + fence-escape detector (hardcoded /tmp named · \${TMPDIR:-/tmp} not · comment not · plain mktemp not) + swap-exhaustion-without-PSI-refault gate + cron-preflight mempressure gate + node-pressure ledger resolution (env>ledger>inline, 3-case, fail-open) + smoke link-bracket outage n/a lane + lock-held cron skip says-why + cron run-stamp (ISO prefix, this-run clock, body intact, ages by own ts) + --sediment env-side knobs (comment-mention != read · REDUNDANT only when every ref is defaulted, one default, equal · bare-ref and two-default conservatism · value ends at the semicolon · census/verdict partition · NO value ever printed · name-construction caveat both edges · missing config = exit 2 n/a) + --supersede change-anchored (baseline run accuses nothing · unchanged config records no transition · a knob change flips the reading producer's artifact to SUPERSEDED rc=3 · a producer of the unchanged knob is not swept in · comment/--test mention is not a read · a touched artifact clears · pre-ledger artifact is UNKNOWN-CURRENT not CURRENT · no value printed OR stored · missing config = exit 2 n/a) + --exclusion reader-predicate divergence (two bounds on one artifact = SPLIT rc=3 · writer excluded, its write rhythm is not a predicate · bound < producer cadence = UNSATISFIABLE with its false-stale share · a looser bound is not · agreement is not a finding · _MIN normalised to seconds · rhythm-named and non-vocabulary name-pairs refused · comment/--test mention is not a read · unbounded is a lead, never a finding · citations are RAW file lines · clean corpus rc 0 · no corpus = exit 2 n/a))"; exit 0
}
# ── --sediment — the ENVIRONMENT-SIDE support structures ────────────────────────────────────────
# LITERATURE (live review, genome, 2026-08-15; enactivism & 4E). Pérez-Verdugo & Barandiaran, "The
# Equilibration of Technical Objects: Uncovering Normative Layers of Sensorimotor Engagement",
# *Topoi* 45(2):331-342 (2025), doi:10.1007/s11245-025-10259-4 (open access, read in full).
# Their thesis: a scheme is held up by support structures BOTH agent-sided and environment-sided,
# so equilibration "can take place through agent-sided transformations, but also -- and this has
# been less explored -- through transformations of the environment itself" (technical behaviour).
# The transformed object then "survive[s] the interaction that [it was] intended to regulate, while
# retaining in [its] structure the effects of the transformations [it has] undergone" -- a norm
# SEDIMENTED in material structure, still regulating whoever encounters it next, long after the
# perturbation and the agent that answered it are gone (their QWERTY case: the typebar-clash
# constraint that produced the layout went away; the layout did not).
#
# The mesh has instruments for the AGENT-SIDE sediment only -- a tool nothing invokes (this file's
# own orphan check), an enablement edge nothing exercises (mesh-closure --enacted), a cadence
# nothing runs (mesh-reflex-health --routine-fit). It has none for the environment side, and
# ~/.mesh/nodes is the mesh's largest technical object: hand-transformed by past operators and
# minds to keep schemes working, sourced by ~150 tools, surviving every reboot and every /clear,
# each line carrying in its comment the perturbation it answered. Nothing has ever asked whether
# those knobs still regulate anything.
#
# Report-only, on-demand, never edits the file. Verdicts per knob SET in the file:
#   UNREAD     no reference in any scanned surface -> a sedimented norm regulating nothing.
#              A LEAD, NOT A VERDICT: a reader on a peer node, in a unit this node does not carry,
#              or built by runtime name construction is invisible to a literal-name scan (the
#              caveat line names when that idiom is present).
#   REDUNDANT  read, but EVERY reference is `${K:-D}`/`${K:=D}` with ONE distinct D, and D equals
#              the value set here -> the transformation does no work; deleting it changes nothing.
#              Conservative BOTH ways: one bare `$K` reference keeps it ACTIVE (under `set -u` an
#              unset name is a crash, so a bare reader makes the knob load-bearing at its default),
#              and two distinct defaults keep it ACTIVE (one of them is not the value).
#   ACTIVE     everything else.
# Second axis, from the same paper's canonical/alternative distinction (a use is canonical when the
# encountering agent's network resembles the one the object was designed to regulate): a knob also
# declared in the committed `nodes.example` is CANONICAL; one only on this node is an ALTERNATIVE
# use of the config object -- descriptive, NOT a fault (the paper's whole point is that technical
# objects stay multistable); one declared in nodes.example and not set here is an unactualized
# VIRTUALITY ("the object is designed to regulate virtual (as in non-actual) uses").
#
# A COMMENT MENTION IS NOT A READ -- the same rule mesh-closure --enacted had to learn: a knob named
# only in prose is a support whose stability does not depend on exercise. Full-line comments are
# stripped from the reader corpus before counting.
#
# NEVER PRINTS A VALUE. ~/.mesh/nodes is the node's secret-adjacent surface (peer IPs, chat ids,
# device serials) and this report can reach a human, a log, or the board; the verdicts need names
# and counts only. `--sediment` is the one mesh-doctor lane that reads that file for its KEYS.
sediment_report(){
  local nodes example genome scan corpus_all corpus_code td rc=0
  genome="${MESH_GENOME:-$HOME/lte-workstation}"
  nodes="${MESH_DOCTOR_NODES:-$HOME/.mesh/nodes}"
  example="${MESH_DOCTOR_NODES_EXAMPLE:-$genome/nodes.example}"
  scan="${MESH_DOCTOR_SEDIMENT_SCAN:-$genome/scripts:$HOME/.local/bin:$HOME/.config/systemd/user}"
  if [ ! -r "$nodes" ]; then
    echo "mesh-doctor --sediment: n/a — no readable node config at $nodes (this node sediments no environment-side knobs)"
    return 2
  fi
  td="$(mktemp -d)" || return 2
  : > "$td/all"
  local d f
  local IFS=:
  for d in $scan; do
    unset IFS
    [ -d "$d" ] || { [ -r "$d" ] && cat -- "$d" >> "$td/all" 2>/dev/null; IFS=:; continue; }
    while IFS= read -r f; do cat -- "$f" >> "$td/all" 2>/dev/null; done \
      < <(find "$d" -maxdepth 2 -type f 2>/dev/null)
    IFS=:
  done
  unset IFS
  for f in "${MESH_DOCTOR_REFLEX_CRON:-$HOME/.mesh/reflexes.cron}"; do
    [ -r "$f" ] && cat -- "$f" >> "$td/all" 2>/dev/null
  done
  [ -n "${MESH_DOCTOR_SEDIMENT_NOCRONTAB:-}" ] || crontab -l >> "$td/all" 2>/dev/null
  # runtime name construction, measured on the WHOLE corpus before it is narrowed — a built name is
  # precisely what does not name a key literally, so on the narrowed corpus this always reads 0.
  local n_ind; n_ind="$(grep -avE '^[[:space:]]*#' "$td/all" 2>/dev/null \
                        | grep -acE '\$\{!|\beval\b|printf -v')"
  # the file's own lines are not readers of themselves
  local nblob; nblob="$(cat -- "$nodes" 2>/dev/null)"

  # keys SET here (active assignments), and keys DISABLED in place (commented-out assignments)
  local set_keys dis_keys
  set_keys="$(sed -E 's/[[:space:]]+#.*$//' "$nodes" 2>/dev/null \
    | grep -oE '^[[:space:]]*(export[[:space:]]+)?[A-Za-z_][A-Za-z0-9_]*=' \
    | sed -E 's/^[[:space:]]*(export[[:space:]]+)?//; s/=$//' | sort -u)"
  dis_keys="$(grep -oE '^[[:space:]]*#[[:space:]]*(export[[:space:]]+)?[A-Za-z_][A-Za-z0-9_]*=' "$nodes" 2>/dev/null \
    | sed -E 's/^[[:space:]]*#[[:space:]]*(export[[:space:]]+)?//; s/=$//' | sort -u)"

  # narrow the corpus to lines naming ANY of this node's knobs, ONCE, before the per-key passes.
  # The scan surface here is ~130MB (the deployed ~/.local/bin carries binaries too): four greps
  # per key over that is ~20s and a whole-corpus `sort -u` another 7s, while narrowing first costs
  # 0.05s and leaves ~1k lines to dedupe. Counts are identical by construction — a line naming no
  # key contributes 0 to every per-key count.
  local alt; alt="$(printf '%s\n' "$set_keys" | paste -sd'|' -)"
  if [ -n "$alt" ]; then
    grep -aE "\\b($alt)\\b" "$td/all" > "$td/hits" 2>/dev/null
  else
    : > "$td/hits"
  fi
  # code = the READER corpus: full-line comments stripped (a mention in prose is not a read), then
  # DEDUPED — the scan covers both the genome and the deployed ~/.local/bin copy of every tool (a
  # knob may be read by a deployed-only tool), so without this every reference counts twice and the
  # printed reads= misstates how many places consult the knob.
  grep -avE '^[[:space:]]*#' "$td/hits" 2>/dev/null | sort -u > "$td/code"
  sort -u "$td/hits" -o "$td/all"

  local n_set=0 n_canon=0 n_alt=0 n_active=0 n_unread=0 n_redundant=0
  local unread_lines="" redundant_lines="" k val defs ndef occ_all occ_def bare canon
  for k in $set_keys; do
    n_set=$((n_set + 1))
    canon=alternative
    grep -qE "^[[:space:]]*#?[[:space:]]*(export[[:space:]]+)?$k=" "$example" 2>/dev/null \
      && { canon=canonical; n_canon=$((n_canon + 1)); } || n_alt=$((n_alt + 1))
    # last assignment wins (the file is sourced top-to-bottom)
    # value extraction. A `;` ends the assignment ONLY outside quotes: `A=x; export A` and
    # `A=x; B=y` are both one line here, and taking the whole tail as the value silently defeats
    # the REDUNDANT comparison (MESH_VPN_NODE read as "phaedra; export MESH_VPN_PUBIP=..." — found
    # by the first live run). Quoted values are taken to their closing quote; bare ones stop at `;`.
    # An unquoted `#` inside a value is eaten with the comment; that can only mis-compare, and a
    # mis-compare falls to ACTIVE, never to a false REDUNDANT.
    val="$(printf '%s\n' "$nblob" | sed -E 's/[[:space:]]+#.*$//' \
      | grep -E "^[[:space:]]*(export[[:space:]]+)?$k=" | tail -1 \
      | sed -E "s/^[[:space:]]*(export[[:space:]]+)?$k=//" \
      | sed -E 's/^"([^"]*)".*$/\1/; t; s/^'"'"'([^'"'"']*)'"'"'.*$/\1/; t; s/[[:space:]]*;.*$//' \
      | sed -E 's/[[:space:]]+$//')"
    # an ASSIGNMENT is a write, not a read — `K=x` in a script (a fixture pinning it, a tool
    # exporting its own fallback) is not the world consulting this file's value. Subtracting it is
    # what lets a knob whose only real reader is `${K:-D}` reach the REDUNDANT verdict at all.
    occ_all=$(( $(grep -aoE "\\b$k\\b" "$td/code" 2>/dev/null | wc -l) \
              - $(grep -aoE "\\b$k=" "$td/code" 2>/dev/null | wc -l) ))
    if [ "$occ_all" -le 0 ]; then
      n_unread=$((n_unread + 1))
      unread_lines="$unread_lines  $(printf '%-30s %-11s prose-mentions=%s' "$k" "$canon" \
        "$(grep -acE "\\b$k\\b" "$td/all" 2>/dev/null)")
"
      continue
    fi
    occ_def="$(grep -aoE "\\\$\\{$k:[-=]" "$td/code" 2>/dev/null | wc -l)"
    bare=$((occ_all - occ_def))
    defs="$(grep -aoE "\\\$\\{$k:[-=][^}]*\\}" "$td/code" 2>/dev/null \
      | sed -E "s/^\\\$\\{$k:[-=]//; s/\\}\$//; s/^\"(.*)\"\$/\1/" | sort -u)"
    ndef="$(printf '%s' "$defs" | grep -c . 2>/dev/null)"
    if [ "$bare" -eq 0 ] && [ "$ndef" -eq 1 ] && [ "$defs" = "$val" ]; then
      n_redundant=$((n_redundant + 1))
      redundant_lines="$redundant_lines  $(printf '%-30s %-11s reads=%s (all defaulted · one distinct default · equal to the set value)' "$k" "$canon" "$occ_all")
"
    else
      n_active=$((n_active + 1))
    fi
  done

  # unactualized virtuality: declared in the committed example, not set on this node
  local n_virtual=0 ek
  if [ -r "$example" ]; then
    for ek in $(grep -oE '^[[:space:]]*#?[[:space:]]*(export[[:space:]]+)?[A-Za-z_][A-Za-z0-9_]*=' "$example" 2>/dev/null \
                | sed -E 's/^[[:space:]]*#?[[:space:]]*(export[[:space:]]+)?//; s/=$//' | sort -u); do
      printf '%s\n' "$set_keys" | grep -qx "$ek" || n_virtual=$((n_virtual + 1))
    done
  fi

  echo "=== environment-side sediment: $nodes @ $(date -u +%Y-%m-%dT%H:%M:%SZ) ==="
  echo "scanned for readers: $scan + reflexes.cron + crontab (full-line comments stripped: a mention is not a read)"
  echo "knobs set: $n_set (canonical $n_canon · alternative $n_alt) · disabled-in-place: $(printf '%s' "$dis_keys" | grep -c .) · unactualized in nodes.example: $n_virtual"
  echo "verdicts: ACTIVE $n_active · REDUNDANT $n_redundant · UNREAD $n_unread"
  if [ "$n_unread" -gt 0 ]; then
    echo "UNREAD — no reader in the scanned surfaces (a LEAD, not a verdict):"
    printf '%s' "$unread_lines"
  fi
  if [ "$n_redundant" -gt 0 ]; then
    echo "REDUNDANT — read, but the transformation does no work (deleting it changes nothing):"
    printf '%s' "$redundant_lines"
  fi
  [ "$n_ind" -gt 0 ] && echo "caveat: runtime name construction (\${!var} / eval / printf -v) is present on $n_ind line(s) of the scanned corpus — a knob whose name is BUILT cannot be seen by a literal-name scan, so UNREAD understates."
  echo "values are never printed by this report."
  rm -rf "$td"
  return $rc
}

# ── --supersede — WHICH DERIVED ARTIFACT WAS COMPUTED UNDER A KNOB THAT HAS SINCE CHANGED? ──────
# LITERATURE (live review, genome, 2026-08-17; relevance realization & the frame problem — the angle
# the task asked for: an OPERATIONAL mechanism, not philosophy). Haofei Sun & Lin He, "When Memory
# Updates but Behavior Does Not: Repairing Implicit Stale Dependencies in Personalized Agent
# Responses", arXiv:2608.01619v1, 3 Aug 2026 (read in full at arxiv.org/html/2608.01619). Their
# definition is the whole transfer: a product `d` DEPENDS on attribute `a` if changing the current
# value of `a` would alter d's substance — "whether or not d mentions a". They measure what that
# costs: verification anchored on the PRODUCT's own stated premises recovers 0.44–1.0 of stale
# premises when the dependency is stated, and collapses to 0.06–0.38 when it is merely implied, and
# the bottleneck is EXTRACTION, not judgement (few-shot prompting made implicit recall WORSE,
# 0.38→0.13). Their fix is not a better forward check, it is a second pass in the OPPOSITE
# DIRECTION — the "Temporal Role": for each CHANGED ATTRIBUTE, ask whether each product's substance
# still aligns with the current value. That pass, isolated by a matched control that kept the
# evidence and the budget and removed only the transition machinery, is where their gain lives
# (implicit-policy adaptation 53:6; the control adds a non-significant +0.6).
#
# WHY IT LANDS HERE, AND WHY IT IS NOT ALREADY EMBODIED. The frame problem's second horn — after
# something changes, WHICH of my other states must be re-derived — is exactly what the RR literature
# names and declines to operationalize (Jaeger, Riedl, Djedovic, Vervaeke & Walsh, "Naturalizing
# relevance realization", Front. Psychol. 2024, argue the relevance relation cannot be pre-enumerated
# at all). The engineering answer in this paper is not to enumerate it: it is to INVERT THE SCAN
# DIRECTION, so the dependency never has to be declared. Every freshness instrument the mesh owns
# runs the forward direction and is artifact-anchored: mtime against a cadence-derived lease
# (eff_maxage/mesh-reflex-health), declared-vs-enacted routine (--routine-fit), repo-vs-deployed
# drift (mesh-sync-tools), knob-has-a-reader (--sediment, directly above). All of them ask "is this
# thing itself late/absent/unread". NONE asks the reverse question, and a state file is the purest
# case of an unstated dependency in the mesh: it records a verdict and never records the threshold
# that produced it. Such a file is fresh by mtime, on-cadence, honest in content, and computed under
# a configuration that no longer holds — indistinguishable from a correct one at every surface we
# have. Measured before writing this: 23 of 90 state artifacts under ~/.mesh predate the last edit
# of ~/.mesh/nodes, and no tool in the genome compares an artifact's mtime to its config's.
#
# WHAT MAKES THE VERDICT SOUND — and it is the liveness-touch convention that does it. A change-gated
# reflex rewrites its state only when the VALUE changes, so content-mtime alone could never say
# whether it had re-evaluated; `mesh-state-touch` on every successful eval decouples ran-live from
# value-changed, and that touch is precisely the evidence this pass needs: mtime AFTER a transition
# means the reflex evaluated under the new knob and (perhaps) found the same answer. Where a producer
# does NOT touch, mtime-before-transition is genuinely ambiguous — it may have run and declined to
# write — so SUPERSEDED is a LEAD, never a verdict, in the same sense as UNREAD above.
#
# PROVENANCE, AND THE REFUSAL TO CERTIFY. The paper only repairs on a VERIFIED transition (old→new
# both quoted from evidence, t_new > t_old) and otherwise fails open; unverified repair costs them an
# 80% false-invalidation rate against 3%. Our evidence is a salted digest pair in an append-only
# ledger (~/.mesh/config-transitions.log) written by this pass itself — enough to prove a knob is not
# what it was, never enough to disclose what it is (the same secret-adjacent surface --sediment
# refuses to print; the salt is node-local and 0600). The consequence is a hard honesty rule: an
# artifact older than the ledger's own first line CANNOT be certified — a knob may have moved before
# we were watching — so it reads UNKNOWN-CURRENT, the paper's third state, never CURRENT. On a node
# that has never run this, that is every artifact, and the first run says so instead of issuing a
# clean bill of health it has no basis for.
#
# BOUNDARIES. (1) Report-only, on-demand, no repair: reconciling means re-running someone else's
# reflex, which belongs to that reflex. (2) The dependency edge is SYNTACTIC — the knob's literal
# name in the producer's body, --test block stripped (um_body) — so it understates exactly where
# --sediment does (a name that is BUILT is invisible) and overstates where a knob is read on a branch
# never taken. (3) It compares a CONFIG to an ARTIFACT, not a config to behaviour: a producer that
# rewrites every tick clears itself on its next run, so a standing SUPERSEDED line is a statement
# about the change-gated family. Artifact:
# docs/reviews/rr-frame-problem-ramification-change-anchored-supersession-doctor-2026-08-17.md
supersede_report(){
  local nodes scan mdir sdir snap ledger saltf salt td now iso rc=0
  nodes="${MESH_DOCTOR_NODES:-$HOME/.mesh/nodes}"
  scan="${MESH_DOCTOR_SUPERSEDE_SCAN:-${MESH_GENOME:-$HOME/lte-workstation}/scripts}"
  mdir="${MESH_DOCTOR_SUPERSEDE_ARTIFACTS:-$HOME/.mesh}"
  sdir="${MESH_DOCTOR_SUPERSEDE_STATE:-$HOME/.mesh}"
  snap="$sdir/.doctor-config-snapshot"; ledger="$sdir/config-transitions.log"; saltf="$sdir/.doctor-config-salt"
  if [ ! -r "$nodes" ]; then
    echo "mesh-doctor --supersede: n/a — no readable node config at $nodes (no knobs to supersede anything)"
    return 2
  fi
  [ -d "$sdir" ] || mkdir -p "$sdir" 2>/dev/null || return 2
  if [ ! -s "$saltf" ]; then
    ( umask 077; head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n' > "$saltf" ) 2>/dev/null || return 2
  fi
  salt="$(cat "$saltf" 2>/dev/null)"; [ -n "$salt" ] || return 2
  td="$(mktemp -d)" || return 2
  now="$(date -u +%s)"; iso="$(date -u -d "@$now" +%Y-%m-%dT%H:%M:%SZ)"

  # ── snapshot: KEY → salted digest of its value. The value never leaves this line. ──
  # Same assignment grammar as --sediment (last assignment wins; value ends at an unquoted `;`).
  local nblob; nblob="$(sed -E 's/[[:space:]]+#.*$//' "$nodes" 2>/dev/null)"
  local k val
  printf '%s\n' "$nblob" \
    | grep -oE '^[[:space:]]*(export[[:space:]]+)?[A-Za-z_][A-Za-z0-9_]*=' \
    | sed -E 's/^[[:space:]]*(export[[:space:]]+)?//; s/=$//' | sort -u > "$td/keys"
  : > "$td/snap"
  while IFS= read -r k; do
    [ -n "$k" ] || continue
    val="$(printf '%s\n' "$nblob" | grep -E "^[[:space:]]*(export[[:space:]]+)?$k=" | tail -1 \
      | sed -E "s/^[[:space:]]*(export[[:space:]]+)?$k=//" \
      | sed -E 's/^"([^"]*)".*$/\1/; t; s/^'"'"'([^'"'"']*)'"'"'.*$/\1/; t; s/[[:space:]]*;.*$//' \
      | sed -E 's/[[:space:]]+$//')"
    printf '%s %s\n' "$k" "$(printf '%s%s' "$salt" "$val" | sha256sum | cut -c1-12)" >> "$td/snap"
  done < "$td/keys"
  unset val

  # ── transitions: diff this snapshot against the last, append VERIFIED old→new pairs ──
  # Three verbs, all of them real transitions: `changed` (digest moved), `set` (a knob that did not
  # exist now does — the reader stops taking its default), `unset` (it stops — the reader resumes it).
  local baseline=0 n_new=0
  if [ ! -s "$snap" ]; then baseline=1; fi
  if [ "$baseline" = 0 ]; then
    local key old new
    while read -r key old; do
      new="$(awk -v k="$key" '$1==k{print $2}' "$td/snap")"
      if [ -z "$new" ]; then
        printf '%s %s %s unset %s -> -\n' "$iso" "$now" "$key" "$old" >> "$td/tx"; n_new=$((n_new+1))
      elif [ "$new" != "$old" ]; then
        printf '%s %s %s changed %s -> %s\n' "$iso" "$now" "$key" "$old" "$new" >> "$td/tx"; n_new=$((n_new+1))
      fi
    done < "$snap"
    while read -r key new; do
      awk -v k="$key" '$1==k{f=1} END{exit !f}' "$snap" \
        || { printf '%s %s %s set - -> %s\n' "$iso" "$now" "$key" "$new" >> "$td/tx"; n_new=$((n_new+1)); }
    done < "$td/snap"
  fi
  # COVERAGE OPENS ONCE, AND IS PINNED IN THE LEDGER. It must not be re-read as "now" on every run:
  # the fallback then slides forward with the clock, no artifact is ever newer than it, and CURRENT
  # becomes unreachable — a check that can only ever say "I cannot tell" is not a check. The baseline
  # run stamps the moment watching began; every later run inherits it from the ledger's first line.
  [ "$baseline" = 1 ] && printf '%s %s COVERAGE-OPEN - -> -\n' "$iso" "$now" >> "$td/tx"
  if [ -s "$td/tx" ]; then ( umask 077; cat "$td/tx" >> "$ledger" ) 2>/dev/null; fi
  ( umask 077; cp "$td/snap" "$snap" ) 2>/dev/null

  # coverage: nothing before the ledger's FIRST line can be certified — we were not watching.
  local cover_from cover_iso n_tx n_open
  cover_from="$(awk 'NR==1{print $2; exit}' "$ledger" 2>/dev/null)"
  [ -n "${cover_from:-}" ] || cover_from="$now"      # ledger unwritable → certify nothing this run
  cover_iso="$(date -u -d "@$cover_from" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)"
  n_tx="$(grep -c . "$ledger" 2>/dev/null)"; [ -n "$n_tx" ] || n_tx=0
  n_open="$(grep -c 'COVERAGE-OPEN' "$ledger" 2>/dev/null)"; [ -n "$n_open" ] || n_open=0
  n_tx=$((n_tx - n_open))                            # the coverage stamp is not a transition
  # last transition epoch per knob (the coverage stamp names no knob and is excluded)
  awk '$3 != "COVERAGE-OPEN" { t[$3]=$2 } END { for (k in t) print k, t[k] }' "$ledger" 2>/dev/null | sort > "$td/lastch"

  # ── the reverse pass: for each producer's declared artifact, which knobs does it read? ──
  local alt; alt="$(paste -sd'|' - < "$td/keys")"
  local n_prod=0 n_art=0 n_cur=0 n_sup=0 n_unk=0 n_ind=0 sup_lines=""
  local f base slug art amtime deps d dch worst worstk
  : > "$td/map"
  for f in "$scan"/mesh-*; do
    [ -f "$f" ] || continue
    base="${f##*/}"; case "$base" in *.*) continue;; esac
    slug="$(umwelt_slug "$f")"; [ -n "$slug" ] || continue
    n_prod=$((n_prod+1))
    printf '%s\t%s\n' "$slug" "$base" >> "$td/map"
  done
  # ONE ROW PER ARTIFACT, and the row must name the tool that WRITES it. umwelt_slug reports the state
  # string a tool DECLARES, which a consumer also does: mesh-dash names `.climate-state` in the row it
  # renders, and attributing the artifact to the dash both mis-names the owner and counts the artifact
  # twice. Where a declarer's own name is the artifact's stem (mesh-climate ↔ .climate-state) it wins;
  # otherwise the first declarer stands and the row is a lead about the ARTIFACT, not about that tool.
  sort -u "$td/map" | awk -F'\t' '
    { stem=$1; sub(/^\./,"",stem); sub(/[.-]state$/,"",stem)
      t=$2; sub(/^mesh-/,"",t)
      if (!($1 in best) || t == stem) best[$1]=$2 }
    END { for (s in best) print s "\t" best[s] }' | sort > "$td/own"
  local n_decl; n_decl="$(grep -c . "$td/own" 2>/dev/null)"; [ -n "$n_decl" ] || n_decl=0
  while IFS="$(printf '\t')" read -r slug base; do
    [ -n "$slug" ] || continue
    f="$scan/$base"
    art="$mdir/$slug"; [ -f "$art" ] || continue
    n_art=$((n_art+1))
    amtime="$(stat -c %Y "$art" 2>/dev/null)"; [ -n "$amtime" ] || continue
    # a knob is READ by this producer when its name occurs outside an assignment (`K=` is a write,
    # the same rule --sediment applies) and outside the --test block and comments (um_body).
    deps=""
    if [ -n "$alt" ]; then
      deps="$(um_body "$f" | grep -aoE "\\b($alt)\\b=?" 2>/dev/null | sort | uniq -c \
        | awk '{ n = $1; key = $2; if (key ~ /=$/) { sub(/=$/,"",key); n = -n } c[key] += n }
                END { for (key in c) if (c[key] > 0) print key }')"
    fi
    if [ -z "$deps" ]; then n_ind=$((n_ind+1)); continue; fi
    worst=0; worstk=""
    for d in $deps; do
      dch="$(awk -v k="$d" '$1==k{print $2}' "$td/lastch")"
      [ -n "$dch" ] || continue
      [ "$dch" -gt "$worst" ] && { worst="$dch"; worstk="$d"; }
    done
    if [ "$worst" -gt "$amtime" ]; then
      n_sup=$((n_sup+1))
      sup_lines="$sup_lines  $(printf '%-26s %-26s written %s · %s changed %s' "$base" "$slug" \
        "$(date -u -d "@$amtime" +%Y-%m-%dT%H:%MZ)" "$worstk" "$(date -u -d "@$worst" +%Y-%m-%dT%H:%MZ)")
"
    elif [ "$amtime" -lt "$cover_from" ]; then
      n_unk=$((n_unk+1))
    else
      n_cur=$((n_cur+1))
    fi
  done < "$td/own"

  echo "=== config supersession: derived artifacts vs knob transitions @ $iso ==="
  echo "(Sun & He, arXiv:2608.01619, Aug 2026 — a product depends on an attribute if changing it"
  echo " would alter the product's substance, WHETHER OR NOT the product mentions it. Artifact-anchored"
  echo " freshness cannot see that dependency; this is the reverse pass, from the change side.)"
  if [ "$baseline" = 1 ]; then
    echo "BASELINE RUN — no prior snapshot. $(grep -c . "$td/keys" 2>/dev/null) knobs recorded; no transition can be claimed yet."
  fi
  echo "ledger: $ledger — $n_tx transition(s), coverage begins $cover_iso (+$n_new this run)"
  echo "producers declaring a state artifact: $n_prod · distinct artifacts: $n_decl · present here: $n_art"
  echo "verdicts: CURRENT $n_cur · SUPERSEDED $n_sup · UNKNOWN-CURRENT $n_unk · INDEPENDENT $n_ind (reads no knob this node sets)"
  if [ "$n_sup" -gt 0 ]; then
    echo "SUPERSEDED — the artifact predates a change to a knob its producer reads (a LEAD, not a verdict:"
    echo "a producer that does not mesh-state-touch may have run and declined to rewrite):"
    printf '%s' "$sup_lines"
    rc=3
  fi
  [ "$n_unk" -gt 0 ] && echo "UNKNOWN-CURRENT $n_unk — written before the ledger opened; a knob may have moved unwatched, so they are NOT certified CURRENT."
  echo "values are never printed or stored by this report (knob digests are salted, node-local, 0600)."
  rm -rf "$td"
  return $rc
}

# cron_stride: the SHORTEST interval (seconds) a 5-field cron spec can fire at, or empty when this
# pass cannot tell. Deliberately partial — `*/N`, `A-B/N`, `*`, and a fixed minute under `*` hours are
# the forms the genome's `# reflex-cadence:` headers actually use; anything else returns empty and the
# UNSATISFIABLE check is simply not run for that producer. A GUESSED cadence would manufacture the
# finding it is supposed to detect.
cron_stride(){
  local spec="$1" m h
  case "$spec" in ''|*[Nn]one*|*[Oo]ff*|*manual*|*demand*) return 0;; esac
  set -- $spec
  [ $# -ge 5 ] || return 0
  m="$1"; h="$2"
  case "$m" in
    \*) printf 60 ;;
    */*) printf '%s' "$(( ${m##*/} * 60 ))" ;;
    *,*) return 0 ;;
    *[!0-9]*) return 0 ;;
    *) case "$h" in \*) printf 3600 ;; */*) printf '%s' "$(( ${h##*/} * 3600 ))" ;; *) return 0 ;; esac ;;
  esac
}

# ── --exclusion — DO THE READERS OF ONE SENSE AGREE ON WHEN IT IS TOO OLD? ──────────────────────
# LITERATURE (live review, genome, 2026-08-19; distributed-systems coordination — gossip / CRDTs /
# eventual consistency, entered from the angle the task named: a CROSS-DOMAIN transfer into a
# distributed SENSOR mesh). Ryan Gillespie, "Byzantine Accountability Without Consensus: Strong
# Eventual Consistency for Non-Associative, Stochastic, Robust Aggregation", arXiv:2607.10305,
# submitted 11 Jul 2026 (read at arxiv.org/abs/2607.10305). ACFA splits a robust aggregator in two:
# an EVIDENCE layer (a content-addressed OR-Set of signed contributions + a grow-only set of
# equivocation proofs) and an AGGREGATION layer that is a deterministic pure function over the
# converged state. The sentence this mode is built on is the one about what replicas must agree on:
# nodes need agreement on **the set of contributions and the EXCLUSION PREDICATE** — never on
# operation ordering. The reason it must be agreed is the paper's other half: robust aggregation is
# non-associative and DISCONTINUOUS, so "an ulp-scale perturbation can flip the selected subset,
# moving the output by a non-vanishing amount". Two replicas that exclude different members do not
# get a slightly different answer; they get a different answer.
#
# THE TRANSFER. A mesh sense publishes ONE artifact (`~/.mesh/.<x>.state`) that many organs read, and
# each reader decides for itself when that artifact is too old to use — an exclusion predicate, one
# per reader, expressed as a bare integer in that reader's own source. Nothing publishes it, nothing
# compares them, and the producer (which is the only party that knows its own cadence) does not state
# one. So the mesh routinely holds, at the same instant, from the same bytes, two contradictory
# verdicts about whether a sense is live — and the contradiction is invisible at every surface we
# have, because each reader is internally consistent and honest.
#
# WHY IT IS NOT ALREADY EMBODIED. The mesh knows the SINGLE-reader version of this (doctrine: "a lease
# must exceed its producer's cadence", mesh-bruno's `MESH_BRUNO_LEASE_WIFI=600` against a 600s
# producer, found by hand, fixed by deferring to the producer's own definition). It has never looked
# ACROSS readers. Every freshness instrument we own is one-sided: mesh-reflex-health judges a producer
# against its cadence, --supersede (directly above) judges an artifact against a knob transition,
# mesh-sync-tools judges deployed against repo. None of them can see two readers disagreeing, because
# each reader is judged alone — which is exactly ACFA's point: the divergence is not in the evidence,
# it is in the predicate applied to it.
#
# WHAT IT REPORTS.
#   SPLIT          ≥2 readers of one artifact, ≥2 distinct bounds. In the band between the tightest
#                  and the loosest, the mesh believes the sense is both live and dead. FINDING.
#   UNSATISFIABLE  a reader's bound is SHORTER than the producer's own declared cadence: it must read
#                  STALE on a perfectly healthy sense for (1 − bound/cadence) of every cycle. FINDING.
#   AGREED/SINGLE  the readers concur (or there is only one). Not a finding.
# The writer is excluded from the reader set on purpose: a producer's own interval constant is a WRITE
# cadence, not an exclusion predicate, and counting it invents disagreements that do not exist.
#
# BOUNDARIES, and they are load-bearing. (1) Extraction is SYNTACTIC over the comment-stripped,
# --test-stripped body (um_body's corpus rule), and it is deliberately conservative — four forms only:
# an age computed from the artifact and compared to a literal/`${K:-N}`/known constant; a
# freshness-named helper call carrying the bound as an argument; a constant whose NAME pairs with the
# artifact variable's prefix (`OPHOME_STATE` ↔ `OPHOME_MAXAGE`); and `-mmin` (×60). Anything else
# reads UNBOUNDED, which is a LEAD, not a claim: the reader may make no liveness claim at all, or may
# make one this pass cannot see. An UNBOUNDED reader is therefore NEVER a finding.
# (2) A bare integer in shell carries no unit. `_MIN`-suffixed names in a freshness context are read
# as MINUTES and the row prints the raw literal beside the normalised seconds so the inference is
# visible and checkable; a name ending EVERY/INTERVAL/PERIOD/CADENCE is a write rhythm and is refused.
# (3) The row cites file:line for every bound so the finding is an ARTIFACT, not a claim — a reader
# can go look. (4) Report-only. Which bound is RIGHT is a question about that sense's meaning and
# belongs to its organ; naming the disagreement does not answer it.
# Artifact: docs/reviews/distributed-systems-acfa-exclusion-predicate-divergence-doctor-2026-08-19.md
exclusion_report(){
  local scan td now iso rc=0
  scan="${MESH_DOCTOR_EXCLUSION_SCAN:-${MESH_GENOME:-$HOME/lte-workstation}/scripts}"
  [ -d "$scan" ] || { echo "mesh-doctor --exclusion: n/a — no readable tool corpus at $scan"; return 2; }
  td="$(mktemp -d)" || return 2
  now="$(date -u +%s)"; iso="$(date -u -d "@$now" +%Y-%m-%dT%H:%M:%SZ)"

  # corpus: every genome tool, body-only (comments + its own --test block stripped by um_body)
  local f base n_tools=0
  : > "$td/arts"
  for f in "$scan"/mesh-*; do
    [ -f "$f" ] || continue; base="${f##*/}"; case "$base" in *.*) continue;; esac
    um_body "$f" > "$td/b.$base"; n_tools=$((n_tools+1))
    # LINE NUMBERS MUST NAME THE FILE A HUMAN OPENS, not this pass's stripped copy. um_body only ever
    # DELETES whole lines from the comment-stripped, `${V}`→`$V`-normalised text, so the body is a
    # SUBSEQUENCE of it and a two-pointer walk recovers the map exactly. Without this every citation
    # in the report points at a line that does not exist in the tool — a finding nobody can check.
    sed -e 's/#.*//' -e 's/\${\([A-Za-z_][A-Za-z0-9_]*\)}/$\1/g' "$f" > "$td/c.$base"
    awk 'NR==FNR{ b[++nb]=$0; next } { if (k < nb && $0 == b[k+1]) { k++; print FNR } }' \
      "$td/b.$base" "$td/c.$base" > "$td/m.$base"
    local s; s="$(umwelt_slug "$f")"; [ -n "$s" ] && printf '%s\n' "$s" >> "$td/arts"
  done
  sort -u "$td/arts" -o "$td/arts"
  [ -s "$td/arts" ] || { echo "mesh-doctor --exclusion: n/a — no tool in $scan declares a state artifact"; rm -rf "$td"; return 2; }

  : > "$td/hits"
  for f in "$td"/b.*; do base="${f##*/b.}"
    awk -v base="$base" '
      function lhs(s,   nm) {
        if (!match(s, /^[ \t]*(local[ \t]+|export[ \t]+|readonly[ \t]+)?[A-Za-z_][A-Za-z0-9_]*=/)) return ""
        nm = substr(s, RSTART, RLENGTH); sub(/^[ \t]*/, "", nm)
        sub(/^(local|export|readonly)[ \t]+/, "", nm); sub(/=$/, "", nm); return nm
      }
      # a bare integer carries no unit: only a freshness-named _MIN is minutes, and a write rhythm
      # (EVERY/INTERVAL/PERIOD/CADENCE/SLEEP) is not an exclusion predicate at all.
      function unitof(nm) {
        return (nm ~ /(^|_)(MIN|MINS|MINUTES)$/ && nm ~ /STALE|FRESH|AGE|ABS|LOOKBACK|WINDOW|GAP|LEASE|MAX/) ? 60 : 1
      }
      function isrhythm(nm) { return (nm ~ /(EVERY|INTERVAL|PERIOD|CADENCE|SLEEP|TICK)/) }
      function resolve(x,   nm, n) {
        gsub(/^[ \t"]+|[ \t"\)\];]+$/, "", x)
        if (x ~ /^[0-9]+$/) return x + 0
        if (match(x, /^\$\{[A-Za-z_][A-Za-z0-9_]*:-[0-9]+\}$/)) {
          nm = x; sub(/^\$\{/, "", nm); sub(/:-.*/, "", nm)
          if (isrhythm(nm)) return 0
          n = x; sub(/.*:-/, "", n); sub(/\}$/, "", n)
          return (n + 0) * unitof(nm)
        }
        if (match(x, /^\$\{?[A-Za-z_][A-Za-z0-9_]*\}?$/)) {
          nm = x; gsub(/[${}]/, "", nm)
          if (isrhythm(nm)) return 0
          if (nm in konst) return konst[nm]
        }
        return 0
      }
      # every segment after the shared prefix must be freshness vocabulary and one of them must name
      # AGE itself: OPHOME_MAXAGE and RS_FRESH_MAX bind to their artifact, OP_HOME_STALE_MIN does not.
      function pairok(suf,   n, p, i, core) {
        n = split(suf, p, "_"); core = 0
        for (i = 1; i <= n; i++) {
          if (p[i] !~ /^(MAXAGE|MAX|AGE|STALE|FRESH|TTL|LEASE|LIMIT|S|SEC|SECS|MIN|MINS)$/) return 0
          if (p[i] ~ /^(MAXAGE|AGE|STALE|FRESH|TTL|LEASE)$/) core = 1
        }
        return core
      }
      function keep(a, v, ln, why) {
        if (v <= 0) return
        if (BEST[a] == "" || v + 0 < BEST[a] + 0) { BEST[a] = v; BESTL[a] = ln; BESTE[a] = why }
      }
      function takecmp(a, s, ln, mult, why,   t, m, x, v) {
        t = s
        while (match(t, /-(le|lt|ge|gt)[ \t]+[^ \t]+/)) {
          m = substr(t, RSTART, RLENGTH); t = substr(t, RSTART + RLENGTH)
          x = m; sub(/^-(le|lt|ge|gt)[ \t]+/, "", x)
          v = resolve(x); if (v > 0) keep(a, v * mult, ln, why)
        }
      }
      function istok(a, s,   i, n, p) {
        if (index(s, arts[a])) return 1
        n = split(vs[a], p, " ")
        for (i = 1; i <= n; i++) if (p[i] != "" && index(s, "$" p[i])) return 1
        return 0
      }
      # a WRITE is a redirection into the artifact (or a liveness touch of it) — the token is preceded,
      # past quotes and spaces, by `>`. The writer is the producer; its own constants are not
      # exclusion predicates.
      function iswrite(a, s,   i, n, p, pos, j, c) {
        if (s ~ /mesh-state-touch/ && istok(a, s)) return 1
        if (s ~ /(^|[;&| \t])mv[ \t]/ && istok(a, s)) return 1
        n = split(vs[a], p, " ")
        for (i = 0; i <= n; i++) {
          if (i == 0) pos = index(s, arts[a])
          else { if (p[i] == "") continue; pos = index(s, "$" p[i]) }
          if (pos == 0) continue
          for (j = pos - 1; j >= 1; j--) {
            c = substr(s, j, 1)
            if (c == " " || c == "\t" || c == "\"" || c == "{" || c == "$") continue
            return (c == ">") ? 1 : 0
          }
        }
        return 0
      }
      NR == FNR { arts[++na] = $0; next }
      { L[FNR] = $0 }
      END {
        for (i = 1; i <= FNR; i++) {                      # constants, one level, last wins
          nm = lhs(L[i]); if (nm == "") continue
          rest = substr(L[i], index(L[i], nm "=") + length(nm) + 1)
          gsub(/[ \t]*$/, "", rest)
          if (rest ~ /^"?[0-9]+"?;?$/) { v = rest; gsub(/[^0-9]/, "", v)
            if (v + 0 > 0 && !isrhythm(nm)) { konst[nm] = (v + 0) * unitof(nm); kraw[nm] = v + 0; KL[nm] = i } }
          else if (match(rest, /^"?\$\{[A-Za-z_][A-Za-z0-9_]*:-[0-9]+\}"?;?$/)) {
            v = resolve(rest)                             # already unit-normalised by the inner name
            w = rest; sub(/.*:-/, "", w); sub(/[^0-9].*$/, "", w)
            if (v > 0 && !isrhythm(nm)) { konst[nm] = (v == w + 0) ? v * unitof(nm) : v; kraw[nm] = w + 0; KL[nm] = i }
          }
        }
        for (a = 1; a <= na; a++) {                       # variables holding each artifact
          vs[a] = ""
          for (i = 1; i <= FNR; i++) if (index(L[i], arts[a])) {
            if (!(a in FIRST)) FIRST[a] = i
            nm = lhs(L[i]); if (nm != "" && index(" " vs[a] " ", " " nm " ") == 0) vs[a] = vs[a] " " nm
          }
        }
        for (a = 1; a <= na; a++) {
          if (!(a in FIRST)) continue
          wr = 0
          nvv = split(vs[a], pv, " ")
          for (q = 1; q <= nvv; q++) {                    # (D) name-pair
            if (pv[q] == "" || pv[q] !~ /_/) continue
            pfx = pv[q]; sub(/_[A-Za-z0-9]+$/, "", pfx)
            if (length(pfx) < 2) continue
            for (kn in konst) {
              if (kn == pv[q]) continue
              if (index(kn, pfx "_") != 1) continue
              if (!pairok(substr(kn, length(pfx) + 2))) continue
              keep(a, konst[kn], KL[kn], "name-pair:" kn)
            }
          }
          for (i = 1; i <= FNR; i++) {
            s = L[i]
            if (!istok(a, s)) continue
            if (iswrite(a, s)) wr = 1
            if (s ~ /(stale|fresh|_age|age_|expired)/ && match(s, /[ \t]+[0-9]+[ \t")|;]*$/)) {   # (C)
              v = substr(s, RSTART, RLENGTH); gsub(/[^0-9]/, "", v)
              if (v + 0 >= 30) keep(a, v + 0, i, "helper-arg")
            }
            if (s ~ /%Y|-mmin|-newermt/) {                # (A/B) an age computed FROM this artifact
              g = lhs(s); mult = (s ~ /-mmin/) ? 60 : 1
              takecmp(a, s, i, mult, "inline")
              for (j = i + 1; j <= i + 8 && j <= FNR; j++) {
                if (g == "" || L[j] !~ ("\\$\\{?" g "[^A-Za-z0-9_]")) continue
                takecmp(a, L[j], j, 1, "age-cmp")
              }
            }
          }
          printf "%s\t%s\t%s\t%s\t%s\t%s\n", arts[a], base, (BEST[a] == "" ? "?" : BEST[a]), \
            (BEST[a] == "" ? FIRST[a] : BESTL[a]), (BEST[a] == "" ? "-" : BESTE[a]), (wr ? "W" : "R")
        }
      }' "$td/arts" "$f" \
    | awk -F'\t' -v mapf="$td/m.$base" 'BEGIN{ while ((getline ln < mapf) > 0) m[++n]=ln }
        { $4 = ($4 in m || ($4+0) <= n) ? m[$4+0] : "b" $4; print }' OFS='\t' >> "$td/hits"
  done

  # ── ownership: the WRITER owns the artifact; a lone writer wins, else the stem-matching declarer ──
  awk -F'\t' '$6=="W"{ n[$1]++; w[$1]=$2 }
              { seen[$1]=1
                stem=$1; sub(/^\./,"",stem); sub(/[.-]state$/,"",stem)
                t=$2; sub(/^mesh-/,"",t); if (t == stem) sm[$1]=$2 }
              END{ for (a in seen) print a "\t" (n[a]==1 ? w[a] : (a in sm ? sm[a] : "-")) }' "$td/hits" | sort > "$td/owner"

  # ── per artifact: readers (writer excluded), their bounds, the verdict ──
  local n_art=0 n_split=0 n_unsat=0 n_agreed=0 n_single=0 n_unb=0 n_bound=0 n_none=0
  local split_lines="" unsat_lines="" art owner cad ostride
  while IFS="$(printf '\t')" read -r art owner; do
    [ -n "$art" ] || continue
    local rows bounds nb ndistinct mn mx
    rows="$(awk -F'\t' -v a="$art" -v o="$owner" '$1==a && $2!=o { print $2 "\t" $3 "\t" $4 "\t" $5 }' "$td/hits" | sort)"
    [ -n "$rows" ] || continue
    n_art=$((n_art+1))
    bounds="$(printf '%s\n' "$rows" | awk -F'\t' '$2!="?"{print $2}' | sort -n)"
    nb="$(printf '%s\n' "$rows" | awk -F'\t' '$2=="?"' | grep -c . )"
    n_unb=$((n_unb + nb))
    ndistinct="$(printf '%s\n' "$bounds" | grep -c . )"
    [ "$ndistinct" -gt 0 ] && n_bound=$((n_bound + ndistinct))
    local uniqn; uniqn="$(printf '%s\n' "$bounds" | grep . | sort -un | grep -c .)"
    mn="$(printf '%s\n' "$bounds" | grep . | head -1)"; mx="$(printf '%s\n' "$bounds" | grep . | tail -1)"
    # the producer's own declared cadence — the only party that knows how often the bytes can move
    ostride=""
    if [ "$owner" != "-" ] && [ -f "$scan/$owner" ]; then
      cad="$(grep -m1 -E '^#[[:space:]]*reflex-cadence:' "$scan/$owner" 2>/dev/null | sed -E 's/^#[[:space:]]*reflex-cadence:[[:space:]]*//')"
      ostride="$(cron_stride "$cad")"
    fi
    local rowtxt; rowtxt="$(printf '%s\n' "$rows" | awk -F'\t' '{printf " %s=%s@%s", $1, ($2=="?"?"unbounded":$2 "s"), $3}')"
    if [ "${uniqn:-0}" -ge 2 ]; then
      n_split=$((n_split+1))
      split_lines="$split_lines  $(printf '%-24s [%s%s] %ss..%ss over %s reader(s), %s unbounded:%s' \
        "$art" "$owner" "$([ -n "$ostride" ] && printf ' cadence %ss' "$ostride")" "$mn" "$mx" "$ndistinct" "$nb" "$rowtxt")
"
    elif [ "${uniqn:-0}" = 1 ] && [ "$ndistinct" -ge 2 ]; then n_agreed=$((n_agreed+1))
    elif [ "${uniqn:-0}" = 1 ]; then n_single=$((n_single+1))
    else n_none=$((n_none+1))
    fi
    if [ -n "$ostride" ] && [ -n "$mn" ] && [ "$mn" -lt "$ostride" ] 2>/dev/null; then
      n_unsat=$((n_unsat+1))
      local tightest pct
      tightest="$(printf '%s\n' "$rows" | awk -F'\t' -v b="$mn" '$2==b{print $1 "@" $3; exit}')"
      pct=$(( (ostride - mn) * 100 / ostride ))
      unsat_lines="$unsat_lines  $(printf '%-24s %s bound %ss < producer cadence %ss (%s) → reads STALE on a healthy sense ~%s%% of every cycle' \
        "$art" "$tightest" "$mn" "$ostride" "$owner" "$pct")
"
    fi
  done < "$td/owner"

  echo "=== exclusion predicates: do the readers of one sense agree on when it is too old? @ $iso ==="
  echo "(Gillespie, arXiv:2607.10305, Jul 2026 — replicas must agree on the contribution SET and the"
  echo " EXCLUSION PREDICATE, never on ordering; a discontinuous aggregate under two predicates is two"
  echo " answers, not a close pair. Here: one artifact, one reader's integer each, nothing comparing them.)"
  echo "corpus: $scan · tools $n_tools · artifacts with ≥1 non-writer reader: $n_art · bounds extracted: $n_bound · unbounded reads: $n_unb (LEADS, never findings)"
  echo "verdicts: SPLIT $n_split · UNSATISFIABLE $n_unsat · AGREED $n_agreed · SINGLE-READER $n_single · NO-BOUND-EXTRACTED $n_none"
  if [ "$n_split" -gt 0 ]; then
    echo "SPLIT — one sense, several exclusion predicates: inside the band the mesh holds both verdicts at once"
    printf '%s' "$split_lines"
    rc=3
  fi
  if [ "$n_unsat" -gt 0 ]; then
    echo "UNSATISFIABLE — a bound shorter than the producer's own cadence expires while the producer is healthy"
    printf '%s' "$unsat_lines"
    rc=3
  fi
  echo "extraction is syntactic over the --test-stripped body; a reader with no extractable bound is UNBOUNDED,"
  echo "which is a LEAD (it may make no liveness claim at all), never a finding. Every bound cites file@line."
  rm -rf "$td"
  return $rc
}


# ── --nontrivial: TRIVIAL vs NON-TRIVIAL MACHINES, applied to the mesh's own tests ─────────────
# LITERATURE 2026-08-18 (live review, second-order cybernetics). Von Foerster's sharpest measuring
# instrument is a classification of the thing being measured: a TRIVIAL machine's output depends only
# on its input — "not influenced by previous operations", analytically determinable, predictable — and
# a NON-TRIVIAL machine's output depends also on an internal state its own operation changes, which
# makes it analytically INDETERMINABLE from outside by input/output testing. The live restatement of
# the same point, in the evaluation idiom: "prompting and evaluation are constitutive interventions,
# not neutral observations" (Rebecca L. Johnson, "Measuring the Machine: Evaluating Generative AI as
# Pluralist Sociotechnical Systems", arXiv:2604.20545, 2026-04-22); the observer-inside-the-system
# frame is current (Elshatlawy/Rickles/Arsiwalla, "Towards a Generalized Theory of Observers",
# arXiv:2504.16225, rev. 2026-01-07), and Richards (Systems Research 13:3, 1996) extends the
# distinction into a taxonomy of non-trivial machines.
#
# THE MESH READS EVERY `--test` AS A TRIVIAL MACHINE. mesh-doctor runs them hourly, mesh-land gates
# landing on them, autowire gates wiring on them — and each reads ONE run's exit code as if it were a
# function of the code under test alone. But mesh tools carry state by design (debounce, edge gates,
# change-gated writes, liveness touch), and a `--test` that touches that state is a non-trivial
# machine: its verdict can be a function of whether it has ALREADY RUN. The mesh has met this one
# tool at a time and never as a class — mesh-guardian's gate once passed by reading the PREVIOUS
# run's line (09f7914), and doctrine's answer was "fresh artifact per direction" for that tool.
# Nothing measures how many others are the same shape.
#
# THE MEASUREMENT is the classification itself, run three times: rc1,rc2,rc3.
#   TRIVIAL   all three equal — the only class where a single run's verdict means what it looks like.
#   EIGEN     rc1 differs, rc2==rc3 — the verdict settles into a fixed point only AFTER the test has
#             run once. That is the non-trivial machine exactly: the first observation changed it.
#   UNSTABLE  no stable pair — nondeterministic, or an input moving under the test.
# THE AXIS IS THE EXIT CODE, deliberately: rc is the signal doctor/mesh-land/autowire actually
# consume. A test whose TEXT drifts while rc holds is invisible here, and that is a stated limit of
# this instrument, not an all-clear.
#
# AND A NON-TRIVIAL VERDICT IS NOT YET AN ACCUSATION. Three causes produce the same sequence: the
# tool's own state (actionable), nondeterminism, and THE WORLD MOVING (an organ that was reachable on
# run 1 and gone by run 2 — measured live on the first 24-tool sample: mesh-body-power read 0→2→2
# because the phone left, not because the test remembered anything). So each non-trivial row carries
# the discriminator: did the tool's OWN `~/.mesh` artifacts change across the runs? self-write=yes
# points inside the tool; self-write=no says the cause is outside it and names that rather than
# accusing. Distinct from mesh-test-forgery, which asks whether a dry-run FORGES liveness evidence in
# a durable log; this asks whether the test's own VERDICT is a function of its prior run.
#
# ROTATION, NOT A CENSUS: three runs per tool is three times the side effects, so this is on-demand
# and samples N per invocation from a persisted cursor. The unsampled remainder is PRINTED — a silent
# cap reads as "covered everything".
nontrivial_report(){
  local bin="${MESH_DOCTOR_NONTRIVIAL_BIN:-$HOME/.local/bin}"
  local n="${1:-8}"; case "$n" in ''|*[!0-9]*) n=8 ;; esac
  local tmo="${MESH_DOCTOR_NONTRIVIAL_TIMEOUT:-40}"
  local cur="$HOME/.mesh/.doctor-nontrivial-cursor"
  local cands; cands="$(grep -l -- '--test' "$bin"/mesh-* 2>/dev/null | while read -r f; do
      [ -x "$f" ] && basename "$f"; done | LC_ALL=C sort)"
  local total; total="$(printf '%s\n' "$cands" | grep -c .)"
  [ "${total:-0}" -gt 0 ] || { echo "mesh-doctor --nontrivial: n/a — no executable tool carrying a --test under $bin"; return 2; }
  local start; start="$(cat "$cur" 2>/dev/null)"; case "$start" in ''|*[!0-9]*) start=0 ;; esac
  [ "$start" -ge "$total" ] && start=0
  # the wrap must never hand back the SAME tool twice in one run: a sample larger than the population
  # is the population, and "sampled 5 of 3 · -2 not sampled" is a report that has stopped counting.
  [ "$n" -gt "$total" ] && n="$total"
  # take n from the cursor, wrapping — a rotation sweeps the whole population across invocations.
  local pick; pick="$(printf '%s\n' "$cands" | { tail -n "+$((start+1))"; printf '%s\n' "$cands"; } | grep . | head -n "$n")"
  local picked; picked="$(printf '%s\n' "$pick" | grep -c .)"
  echo "=== --nontrivial: trivial vs non-trivial machines among this node's own --test verdicts ==="
  echo "sampled $picked of $total tool(s) carrying a --test [cursor $start; rotation, NOT a census — $((total - picked)) tool(s) not sampled this run]"
  local shorts; shorts="$(printf '%s\n' "$cands" | sed 's/^mesh-//')"
  local ntriv=0 neig=0 nuns=0 nself=0 nstate=0
  local t rc1 rc2 rc3 d0 d1 d3 self klass
  while read -r t <&4; do
    [ -n "$t" ] || continue
    d0="$(_nt_digest "$t" "$shorts")"
    timeout "$tmo" "$bin/$t" --test </dev/null >/dev/null 2>&1; rc1=$?
    d1="$(_nt_digest "$t" "$shorts")"
    timeout "$tmo" "$bin/$t" --test </dev/null >/dev/null 2>&1; rc2=$?
    timeout "$tmo" "$bin/$t" --test </dev/null >/dev/null 2>&1; rc3=$?
    d3="$(_nt_digest "$t" "$shorts")"
    # THE COUNT IS TAKEN AT BOTH ENDS, and this is not a detail: a file the test CREATES is the exact
    # self-write being hunted, and the pre-run count for it is 0. Reading blindness off the pre-state
    # alone called every created-during-the-test artifact "no artifact is named after this tool" —
    # the first draft of this did exactly that and rendered every fixture UNKNOWN while the fixtures
    # were writing state on every run.
    local nmatch="${d0%% *}"; [ "${nmatch:-0}" = 0 ] && nmatch="${d3%% *}"
    if [ "${nmatch:-0}" = 0 ]; then self=unknown
    elif [ "$d0" = "$d1" ] && [ "$d1" = "$d3" ]; then self=no
    else self=yes; fi
    if [ "$rc1" = "$rc2" ] && [ "$rc2" = "$rc3" ]; then klass=TRIVIAL
    elif [ "$rc2" = "$rc3" ];                        then klass=EIGEN
    else                                                  klass=UNSTABLE; fi
    case "$klass" in
      TRIVIAL) ntriv=$((ntriv+1)) ;;
      EIGEN)   neig=$((neig+1)); [ "$self" = yes ] && nself=$((nself+1)) ;;
      *)       nuns=$((nuns+1)); [ "$self" = yes ] && nself=$((nself+1)); : ;;
    esac
    if [ "$klass" = TRIVIAL ] && [ "$self" = yes ]; then
      # THE CLASS MOST AT RISK, and the one a pass/fail column cannot show: the verdict is constant
      # RIGHT NOW, but the test writes the tool's own memory as it runs, so that constancy is a
      # property of the current state and not of the code. mesh-guardian's gate was exactly this
      # before it went wrong (09f7914) — it read the PREVIOUS run's line and was green either way.
      nstate=$((nstate+1))
      printf '  %-9s %-28s rc %s,%s,%s · self-write:yes — constant NOW, but the test rewrites the tool'"'"'s own ~/.mesh state, so this constancy is a fact about the current state, not about the code\n' "TRIVIAL*" "$t" "$rc1" "$rc2" "$rc3"
    elif [ "$klass" = TRIVIAL ]; then
      printf '  %-9s %-28s rc %s,%s,%s\n' "$klass" "$t" "$rc1" "$rc2" "$rc3"
    else
      printf '  %-9s %-28s rc %s→%s→%s · self-write:%s — %s\n' "$klass" "$t" "$rc1" "$rc2" "$rc3" "$self" \
        "$(case "$self" in
             yes) echo "the tool rewrote its OWN ~/.mesh state across the runs, so the verdict may be a function of having already run" ;;
             no)  echo "nothing the tool owns changed, so the cause is OUTSIDE it (an organ or the clock moved) — not an accusation against the test" ;;
             *)   echo "no ~/.mesh artifact is named after this tool, so the discriminator is BLIND here — this is not evidence that nothing was written" ;;
           esac)"
    fi
  done 4<<< "$pick"
  echo "$(( (start + picked) % total ))" > "$cur" 2>/dev/null || true
  echo "summary: $ntriv TRIVIAL (of which $nstate self-writing) · $neig EIGEN · $nuns UNSTABLE · $nself of the EIGEN/UNSTABLE rows self-wrote"
  echo "a TRIVIAL row with self-write:no is the only one whose single-run verdict is a function of the code alone; every other row is read as one by doctor, mesh-land and autowire regardless."
  # THE INSTRUMENT'S OWN BLIND SPOT, printed beside its answer (the observer is inside what it
  # measures): EIGEN is the FIRST-run transition, and on a long-lived node every test has already run,
  # so its state is already there and the machine now reads TRIVIAL. This report is therefore BIASED
  # TOWARD TRIVIAL and a TRIVIAL row is evidence about the machine FROM ITS CURRENT STATE, never from
  # a pristine one. That is why the self-write column, not the class, is the column to act on.
  echo "blind spot: EIGEN is the FIRST-run transition, and on this node every test has run before — its state is already laid down, so it now reads TRIVIAL. This sample is biased toward TRIVIAL; the self-write column, not the class, is what survives that bias."
  [ $((neig + nuns)) -gt 0 ] && return 3
  return 0
}
# _nt_digest: "<match-count> <digest>" over the ~/.mesh artifacts this tool plausibly OWNS.
# ATTRIBUTION BY NAME IS WEAK AND BOTH OF ITS ERRORS ARE REAL, so both are handled rather than hidden:
#  · TOO WIDE — a bare `*act*` matched 39 files on this node (activity, compact, …), so ANY other
#    reflex writing during the three runs would manufacture a self-write against mesh-act. The match
#    is PREFIX-ANCHORED at a non-alphanumeric boundary, which alone kills that case (`act` is not
#    followed by a boundary in `activity`).
#  · THE HYPHEN IS THE HARD ONE, and getting it wrong breaks the discriminator in whichever direction
#    you pick. Refuse `-` as a boundary and `.fx-eigen-state` stops matching `fx-eigen` — i.e. the
#    mesh's DOMINANT state-file convention `.<tool>-state` goes blind, which is how the first draft
#    of this shipped (every fixture read `unknown`). Accept `-` and `activity` swallows
#    `.activity-tempo-state`, an accusation against a parent for its child's writes
#    ([[a-hyphen-boundary-containment-lets-a-child-slug-close-its-parent]]). Neither rule is right,
#    because the question is not textual: `-` is a boundary EXCEPT where a LONGER TOOL in this very
#    candidate set claims the name. So the boundary accepts `-`, and any file that a longer sibling
#    tool also matches is subtracted — decided against the population, not guessed from the string.
#  · EMPTY — a tool no ~/.mesh file is named after digests to a constant, byte-identical to
#    "measured, nothing moved". The COUNT rides out with the digest so the caller says UNKNOWN, never
#    NO ([[na-must-be-a-claim-about-the-node]]).
# And even a true hit proves a touch, not a writer: mtime names no pid. `mesh-fswriter` is the probe
# that can actually attribute one ([[mtime-proves-a-touch-not-a-sign-relation]]).
_nt_digest(){
  local short="${1#mesh-}" allshorts="${2:-}" names sib
  names="$(find "$HOME/.mesh" -maxdepth 1 -printf '%f %s %T@\n' 2>/dev/null \
           | grep -E "^\\.?$short([^a-z0-9]|[[:space:]])")"
  # subtract every file a LONGER sibling tool claims (mesh-activity must not own mesh-activity-tempo's)
  while read -r sib; do
    case "$sib" in "$short"-*) : ;; *) continue ;; esac
    names="$(printf '%s\n' "$names" | grep -vE "^\\.?$sib([^a-z0-9]|[[:space:]])")"
  done <<< "$allshorts"
  names="$(printf '%s\n' "$names" | grep .)"
  printf '%s %s' "$(printf '%s\n' "$names" | grep -c .)" "$(printf '%s' "$names" | md5sum | cut -d' ' -f1)"
}

[ "${1:-}" = --quiet ] && Q=1
[ "${1:-}" = --cron ] && { Q=1; CRON=1; }   # quiet + post to board only if something FAILs
[ "${1:-}" = --sediment ] && { sediment_report; exit $?; }
[ "${1:-}" = --supersede ] && { supersede_report; exit $?; }
[ "${1:-}" = --exclusion ] && { exclusion_report; exit $?; }
[ "${1:-}" = --nontrivial ] && { nontrivial_report "${2:-}"; exit $?; }
[ "${1:-}" = --test ] && smoke_test
# Cap AUTOMATED runs to ONE at a time. The health-monitor stream + cron fire mesh-doctor --quiet
# faster than a run completes under load → pile-up (observed 10 concurrent, load 17.5 → thermal).
# flock -n: if another doctor holds the lock, SKIP this automated run (the running one covers it) —
# nonblocking so callers never QUEUE (a wait-lock would delay alerts). Interactive runs are unlocked.
# { exec ...; } 2>/dev/null — the brace group SCOPES the stderr suppression to the exec itself
# (fd9 still persists). A bare `exec 9>file 2>/dev/null` permanently redirected the WHOLE script's
# stderr to /dev/null on quiet runs, eating every later error and any bash -x trace — which is how
# the 2026-07-23 "doctor hangs after gh output" misdiagnosis was born (the trace died here, not at
# the alleged hang; the real cause was an 8h node outage 00:37→08:37).
if [ "$Q" = 1 ] && { exec 9>"$HOME/.mesh/.doctor.lock"; } 2>/dev/null; then
  # Say WHY we skip (else-branch-says-why doctrine): a silent exit 0 here is indistinguishable in
  # doctor.log from a completed run, and .doctor-fails mtime freezes with no visible reason.
  flock -n 9 2>/dev/null || { echo "mesh-doctor: skipped — another automated doctor holds $HOME/.mesh/.doctor.lock"; exit 0; }
fi
FAIL=0; WARN=0; FAILS=""
# RUN STAMP (2026-08-11) — a quiet/cron run's stdout is APPENDED to ~/.mesh/doctor.log, and until now
# every line it wrote was UNDATEABLE: 5408 lines, `grep -cE '[0-9]{4}-[0-9]{2}-[0-9]{2}T'` = 0, no run
# boundary either. A reader (mind, dash, watchdog) grepping that log gets a finding it cannot place in
# time — and it will read a long-healed line as live. That is not hypothetical: on 2026-08-11 the health
# lane read `media-scene.log: 1 recent error-lines` out of doctor.log at 20:02Z, concluded a live FAIL,
# and derived a design gap from it ("the untimestamped-error heal never fires for --edge logs"). The
# line was emitted inside the 20-minute window after an 18:21Z crash-write and had already aged out;
# count_recent_errors on that very file returned 0 live, and a full doctor run printed "no error-spam in
# operational reflex logs". The gate was correct — its LOG could not say when it had spoken. Acting on
# that report would have loosened a guard that was working.
# ONE stamp per run (not per line) on purpose: shared across a run's lines it doubles as the run
# BOUNDARY the log never had, so a reader can both date a finding and group it with its run.
# Interactive output is untouched — empty RUN_TS reproduces the previous format byte-for-byte.
RUN_TS=""; [ "$Q" = 1 ] && RUN_TS="$(date -u +%FT%TZ)"
pass(){ [ "$Q" = 1 ] || printf '  \033[32mPASS\033[0m %s\n' "$1"; }
warn(){ WARN=$((WARN+1)); printf '%s  \033[33mWARN\033[0m %s\n' "$RUN_TS" "$1"; }
note(){ printf '%s  \033[36mNOTE\033[0m %s\n' "$RUN_TS" "$1"; }   # always-visible (even -q) but UNCOUNTED: structural/by-design facts, not actionable WARNs
fail(){ FAIL=$((FAIL+1)); FAILS="${FAILS:+$FAILS; }$1"; printf '%s  \033[31mFAIL\033[0m %s\n' "$RUN_TS" "$1"; }
hdr(){ [ "$Q" = 1 ] || printf '\n== %s ==\n' "$1"; }
# refuse the unthrottled fan-out below on a genuinely thrashing node — defer, don't grind (see
# _sc_should_skip_cron_for_pressure above for why this is a NOTE, not a FAIL/WARN, and cron-only).
if _sc_should_skip_cron_for_pressure; then
  note "node under memory pressure — deferring full --cron scan (no fan-out) until it drains"
  exit 0
fi

hdr "egress integrity (clean router-LAN, no SPOF)"
dev=$(ip route get 1.1.1.1 2>/dev/null | grep -oP 'dev \K\S+')
xid=$(tailscale debug prefs 2>/dev/null | python3 -c 'import json,sys;print(json.load(sys.stdin).get("ExitNodeID") or "")' 2>/dev/null)
case "$dev" in tailscale*|wg*|Gtcld*) fail "egress rides $dev (overlay/VPN) — should be LAN" ;; "") warn "egress dev unknown" ;; *) pass "egress dev=$dev (LAN)";; esac
[ -z "$xid" ] && pass "no exit-node (no SPOF)" || fail "exit-node set ($xid) — SPOF risk"
code=$(curl -s -m8 -o /dev/null -w '%{http_code}' https://api.anthropic.com/v1/messages 2>/dev/null)
{ [ "$code" = 405 ] || [ "$code" = 401 ]; } && pass "Anthropic reachable ($code)" || fail "Anthropic $code (geo-blocked/down?)"

hdr "organs FUNCTIONAL (not just declared — hollow/broken-default)"
card="${MESH_CARD:-$HOME/.mesh-card}"
for o in $(grep -E '^[[:space:]]*(senses|actuators):' "$card" 2>/dev/null | sed 's/^[^:]*://' | tr ' ' '\n' | grep -vE '^\(none\)$|^$'); do
  case "$o" in
    mic)   mic_err=/tmp/.doc-mic.err; mic_dev=""
           # Probe EVERY capture device, not just plughw:0,0 — the working mic may be a USB card at
           # index 1+ while card 0 is a dummy (ds 2026-06-12). Mirrors mesh-card's mic_real.
           mic_devs=$(arecord -l 2>/dev/null | sed -n 's/^card \([0-9]\+\): .*device \([0-9]\+\):.*/\1,\2/p')
           mic_cap(){ local d; : >"$mic_err"; for d in $mic_devs; do
                        flock -w 12 /tmp/.mesh-mic.lock timeout 5 arecord -d 1 -D "plughw:$d" -f S16_LE -r 16000 /tmp/.doc-mic.wav >/dev/null 2>>"$mic_err" && [ -s /tmp/.doc-mic.wav ] && { mic_dev=$d; return 0; }
                      done; return 1; }
           # busy ≠ broken: a continuous capture (voice agent / organ exercise) holds the device. Retry
           # once; if STILL failing because the device is busy/in-use, that's WARN (in use), not FAIL.
           if mic_cap; then pass "mic captures (plughw:$mic_dev)"
           elif sleep 3 && mic_cap; then warn "mic capture ok on RETRY (device was busy)"
           elif grep -qiE 'busy|in use|resource busy' "$mic_err" 2>/dev/null; then warn "mic in use (busy — a voice agent/capture holds it), not broken"
           else fail "mic declared but CAPTURE fails"; fi; rm -f "$mic_err"
           timeout 5 arecord -d 1 /tmp/.doc-mic2.wav >/dev/null 2>&1 && [ -s /tmp/.doc-mic2.wav ] || warn "mic DEFAULT device broken/busy (use -D plughw:N,M)"; rm -f /tmp/.doc-mic*.wav ;;
    ble)   bluetoothctl show 2>/dev/null | grep -q 'Powered: yes' && pass "ble powered" || fail "ble declared but not powered" ;;
    wifi)  nmcli -t radio wifi 2>/dev/null | grep -q enabled && pass "wifi enabled" || fail "wifi declared but disabled" ;;
    camera) # /dev/video0 is single-owner: mesh-cam-watch (active on this node) grabs it continuously, so
            # a single mesh-camera --test collides → v4l2 "resource busy" → FAIL → the 0→1 flap that
            # cry-wolfs the [doctor] alert (observed 04:33, then 05:21→05:24). Like the mic check above,
            # a CONTENDED capture device is busy, not broken: retry across cam-watch's poll gaps. A camera
            # that captures on ANY try works; one that fails EVERY try over ~6s is a genuine hollow.
            if ! command -v mesh-camera >/dev/null 2>&1; then fail "camera declared but capture path missing (hollow)"
            else
              cam_ok=0
              for _try in 1 2 3 4; do
                MESH_TEST_SANDBOX=1 mesh-camera --test >/dev/null 2>&1 && { cam_ok=1; break; }
                [ "$_try" -lt 4 ] && sleep 2
              done
              # POSITIVE-EVIDENCE fallback (busy-by-use ≠ broken): if our retries all lost the race for
              # the single-owner /dev/video0 but mesh-cam-watch is ACTIVELY capturing from it, the camera
              # demonstrably WORKS — a live capture is happening now. cam-watch rewrites cam-prev.jpg every
              # poll, so a fresh (<60s, non-empty) cam-prev.jpg IS that proof. A hard FAIL then requires
              # BOTH our 4× capture losing AND no other live capture = a genuine hollow. Closes the
              # operator-visible [check] camera flap at ROOT (observed 00:46:42), not by widening retries.
              # NB: no `systemctl --user is-active` gate here — it silently fails under sessionless
              # cron (no DBus, [[cron-env-systemctl-user-bus-gap]]) and would re-introduce the false
              # 'camera hollow' FAIL this branch exists to close. A fresh non-empty cam-prev.jpg <60s
              # IS the proof cam-watch is live; the systemctl check was redundant.
              if [ "$cam_ok" != 1 ] \
                 && [ -n "$(find "$HOME/.mesh/cam-prev.jpg" -mmin -1 -size +0c 2>/dev/null)" ]; then
                cam_ok=2
              fi
              case "$cam_ok" in
                1) pass "camera capture works (mesh-camera)" ;;
                2) pass "camera capture works (mesh-cam-watch live capture: cam-prev.jpg fresh <60s — busy-by-use, not broken)" ;;
                *) fail "camera declared but capture path missing (hollow)" ;;
              esac
            fi ;;
    power) command -v mesh-power >/dev/null 2>&1 && mesh-power --check >/dev/null 2>&1 && pass "power sense ok" || warn "power check nonzero (battery?)" ;;
    link-flap) command -v mesh-link-flap >/dev/null 2>&1 && MESH_TEST_SANDBOX=1 mesh-link-flap --test >/dev/null 2>&1 && pass "link flap readable" || fail "link-flap declared but probe fails" ;;
    lid) command -v mesh-lid >/dev/null 2>&1 && MESH_TEST_SANDBOX=1 mesh-lid --test >/dev/null 2>&1 && pass "lid switch readable" || fail "lid declared but sensor probe fails" ;;
    speaker) aplay -l 2>/dev/null | grep -q '^card' && pass "speaker device present" || fail "speaker declared, no device" ;;
    notify) # Match mesh-notify's real capability: it auto-detects DISPLAY from the first X
            # socket when the probe's own env lacks it (agents run displayless in tmux/SSH while
            # the graphical session is live). Without this, the WARN flaps with the doctor's env.
            disp="${DISPLAY-}"; [ -z "$disp" ] && [ -z "${WAYLAND_DISPLAY-}" ] && for s in /tmp/.X11-unix/X*; do [ -e "$s" ] && { disp=":${s##*/X}"; break; }; done
            if command -v notify-send >/dev/null 2>&1 && [ -S "/run/user/$(id -u)/bus" ] && { [ -n "$disp" ] || [ -n "${WAYLAND_DISPLAY-}" ]; }; then pass "notify (notify-send+DBUS+DISPLAY)"; else warn "notify declared but NO display (truly headless node)"; fi ;;
    *) pass "$o declared" ;;
  esac
done

hdr "reflexes RUNNING CLEAN (UP-but-broken: errors in logs)"
mesh-supervise --status 2>/dev/null | grep -q DOWN && fail "a supervised loop is DOWN" || pass "all supervised loops UP"
log_fail=0
# RECENCY BOUND (2026-06-13): count an error only if it's actually RECENT. Without this, a single
# benign one-shot (e.g. a torn-read during a deploy) lingers in the last-20-lines window for HOURS,
# pinning a permanent false FAIL that masks a genuinely-new error (alarm fatigue). Errors carry an
# ISO-8601 ts prefix → age them out past the window. An UNtimestamped error (bash stderr like
# "mesh-foo: line 171: syntax error" carries no ts) can't be aged by time, so it used to be counted
# forever — pinning a permanent FAIL long after the reflex healed (the room-sense cry-wolf, swept
# manually 2× 2026-06-17: a 18:00 torn-deploy corrupt line lingered in tail-20 for hours though
# every later run was clean). HEAL-AWARE fix (2026-06-17): an untimestamped error is treated as
# HEALED — and not counted — when a CLEAN (non-error) line appears AFTER it in the window, i.e. the
# reflex produced good output since. Conservative: if the error is the LAST line(s) with no clean
# line after, it still FAILs (a genuinely-ongoing break is never silenced).
now_epoch=$(date -u +%s)
for lg in "$HOME"/.mesh/*.log; do
  case "$(basename "$lg")" in chaos.log|telos.log|chat.log|traces.log|voice-in.log|textin.log|queue-tend.log|generate.log|feed.log|digest.log|mesh.log) continue;; esac   # board/convo + digest/summary + idea-loop logs QUOTE errors legitimately (a [verify] post; an idea/task/done text like "fix the syntax error in X"; digest.log compiles chat quotes) — not operational breaks
  errs=$(count_recent_errors "$lg" "$now_epoch")
  [ "${errs:-0}" -gt 0 ] && { fail "$(basename "$lg"): $errs recent error-lines (UP but broken?)"; log_fail=1; }
done; [ "$log_fail" -eq 0 ] && pass "no error-spam in operational reflex logs"

hdr "cron well-formed (no env-var-as-command, key reflexes present)"
# Read the crontab ONCE. Re-running `crontab -l` per-check races concurrent crontab access
# (multi-agent node): a transient empty read on one check = false "MISSING" cry-wolf (seen
# 2026-06-12 13:42Z mesh-tick + 18:31Z mesh-supervise, both verified-intact). Capturing it once
# AND distinguishing unreadable-from-missing closes that. If the read FAILS (rc≠0), say so —
# don't silently treat an unreadable crontab as "every reflex missing".
CRONTAB="$(crontab -l 2>/dev/null)"; cron_rc=$?
if [ "$cron_rc" -ne 0 ] && [ -z "$CRONTAB" ]; then
  # `crontab -l` exits 1 for BOTH "no crontab" and a transient read error — retry once to tell them apart.
  sleep 1; CRONTAB="$(crontab -l 2>/dev/null)"; cron_rc=$?
fi
if [ "$cron_rc" -ne 0 ] && [ -z "$CRONTAB" ]; then
  warn "crontab unreadable (no crontab, or transient read error) — cron checks SKIPPED, not failed"
else
  printf '%s\n' "$CRONTAB" | grep -qE 'bin/[A-Z_]+=' && fail "malformed cron (path prepended to an env-var → runs as command)" || pass "no malformed env-var cron lines"
  # DUPLICATE cron lines (e.g. homeostasis ×3, 2026-06-12) — the same job scheduled 2+ times burns
  # redundant runs (wasted cycles, re-inflated queues, extra heat). The env-var/reflex-present
  # checks above are blind to exact-dup lines, so a recurring dup would PASS unflagged.
  #
  # 2-CONSECUTIVE-CHECK GATE (mirrors the orphan gate below; mesh-doctor-torn-read class): a dup can
  # appear TRANSIENTLY — a brief two-writer crontab read-modify-write race ((crontab -l; echo NEW) |
  # crontab -) momentarily doubles a line until the next mesh-reflexes --apply / autowire dedupe pass
  # heals it (autowire is add-idempotent + --apply dedupes every pass, so no dup PERSISTS by design).
  # A single-check sighting is therefore cry-wolf on the operator-visible health line (seen 2026-06-20:
  # mesh-psi 21:31 + mesh-situation 23:31, both self-cleared, crontab clean by next check). So WARN only
  # when the SAME dup'd job survives 2 consecutive checks: a transient clears before the next check and
  # stays silent; a real standing dup (dedupe broken) survives and WARNs. State = the set of dup'd names.
  DUPCRON_STATE="$HOME/.mesh/.doctor-dupcron-state"
  dup_lines=$(printf '%s\n' "$CRONTAB" | grep -vE '^[[:space:]]*(#|$)' | sort | uniq -d)
  curr_dups=$(printf '%s\n' "$dup_lines" | grep -oE 'mesh-[a-z-]+' | sort -u | tr '\n' ' ')
  prev_dups=""; [ -f "$DUPCRON_STATE" ] && prev_dups=$(cat "$DUPCRON_STATE" 2>/dev/null || echo "")
  printf '%s\n' $curr_dups | grep -v '^$' | sort -u > "$DUPCRON_STATE" 2>/dev/null   # persist for next run
  confirmed_dups=""
  for d in $curr_dups; do case " $prev_dups " in *" $d "*) confirmed_dups="$confirmed_dups $d" ;; esac; done
  confirmed_dups=$(printf '%s' "$confirmed_dups" | sed 's/^ *//')
  if [ -n "$confirmed_dups" ]; then
    dup_n=$(echo $confirmed_dups | wc -w)
    warn "duplicate cron line(s): $dup_n job(s) scheduled 2+ times, confirmed 2+ checks — $confirmed_dups(redundant runs)"
  elif [ -n "${curr_dups// /}" ]; then
    pass "no persistent duplicate cron (transient: $curr_dups— not confirmed across 2 checks)"
  else
    pass "no duplicate cron lines"
  fi
  # AUTONOMY-CRITICAL crons: tick (wakes the mind — mesh-tick OR the converged mesh-channels @hb driver),
  # mind-keepalive (resurrects a DEAD mind — mesh-mind-keepalive OR mesh-channel-keepalive), supervise
  # (restarts dead loops). Accept either name (regex) so the 2026-06-17 channel-convergence — which folded
  # the tick into mesh-channels @hb — doesn't false-FAIL "autonomy can die". Any missing = FAIL.
  # Post-2026-06-21: cron mind-poking (mesh-tick/mesh-channels) was RETIRED for the closed-loop consume
  # model, and supervise + channel-keepalive moved OUT of cron into the systemd mesh-liveness-loop.service
  # (drives mesh-consume-all=tick-replacement | channel-keepalive | supervise WITHOUT cron). Detect it via
  # its heartbeat freshness — NOT systemctl --user (doctor runs in a sessionless cron, no DBus). A fresh HB
  # means all three autonomy functions are driven, so a cron-ONLY check would false-FAIL "autonomy can die"
  # while autonomy is in fact healthy. Accept it as an equivalent durable driver.
  liveness_fresh=0; _hb="$HOME/.mesh/.liveness-loop.heartbeat"
  if [ -f "$_hb" ] && [ "$(( $(date +%s) - $(stat -c %Y "$_hb" 2>/dev/null || echo 0) ))" -lt 600 ] 2>/dev/null; then liveness_fresh=1; fi
  # HANDS-OFF gate (chat-review/doctor-autonomy-check-minds-off-cryolf): this loop had NO minds-off
  # exemption at all — a deliberately minds-driving-OFF node (card OR restore.env declared) still got
  # judged against autonomy-critical crons it was never meant to run, false-FAILing "autonomy can die
  # silently". mirrors mesh-roll-call's card-authoritative gate, extended with the restore.env signal.
  if minds_declared_off "$card" "$HOME/.mesh/restore.env"; then
    pass "minds declared OFF (card lacks a minds: engine, or restore.env MESH_MIND_CHANNELS=none) — autonomy-critical cron checks skipped"
  else
  for r in 'mesh-tick|mesh-channels' 'mesh-mind-keepalive|mesh-channel-keepalive' mesh-supervise; do
    if printf '%s\n' "$CRONTAB" | grep -qE "$r"; then pass "cron has $r (autonomy-critical)"
    elif [ "$liveness_fresh" = 1 ]; then pass "$r driven by mesh-liveness-loop.service (autonomy-critical; post-2026-06-21 consume-model, heartbeat fresh)"
    else
      # MISS on an autonomy-critical reflex: the rc=1 retry above only catches an EMPTY/error read; a
      # TORN read during a concurrent `| crontab -` rewrite returns a PARTIAL table at rc=0 (some lines,
      # the critical one missing) → false "MISSING" cry-wolf on the one signal that must stay trustworthy
      # (seen 2026-06-13). Re-read fresh once; FAIL only if STILL missing on a clean read AND liveness dead.
      sleep 1
      if crontab -l 2>/dev/null | grep -qE "$r"; then pass "cron has $r (autonomy-critical; confirmed on re-read — first read was torn)"
      else fail "cron MISSING $r AND mesh-liveness-loop stale — autonomy can die silently"; fi
    fi
  done
  fi
  # organ-keepalive also moved to mesh-liveness-loop.service (TASKS, every 600s) post-2026-06-21 — same
  # as supervise/channel-keepalive — so accept a fresh liveness heartbeat as an equivalent driver here too.
  if printf '%s\n' "$CRONTAB" | grep -q 'mesh-organ-keepalive'; then pass "cron has mesh-organ-keepalive"
  elif [ "$liveness_fresh" = 1 ]; then pass "mesh-organ-keepalive driven by mesh-liveness-loop.service (heartbeat fresh)"
  else warn "cron missing mesh-organ-keepalive AND mesh-liveness-loop stale"; fi
  # chat-sync fleet assert (chat-review/ds-chatsync-dead-board-starved): a mind-node's card declaring
  # minds: implies it must be feeding the shared board, or every mind on it runs weeks board-blind and
  # silently invisible to the rest of the fleet — live 2026-07-06: ds's chat-sync cron line sat
  # commented "OFF-mind-2026-06-17" for 19 days despite its OWN card still declaring 4 engines (6 ds
  # minds ran the whole time with zero visibility into the shared board, and the fleet had zero
  # visibility into them). Card-authoritative gate mirrors node_minds_off (mesh-roll-call) — a
  # HANDS-OFF node (no minds: engine) is correctly exempt, this is not a universal chat-sync mandate.
  if grep -iE '^[[:space:]]*minds:' "$card" 2>/dev/null | grep -qwE 'claude|opencode|gemini|codex'; then
    if command -v mesh-chat-sync >/dev/null 2>&1; then
      if printf '%s\n' "$CRONTAB" | grep -qE '(^|[[:space:]/])mesh-chat-sync([[:space:]]|$)'; then
        _cs_log="$HOME/.mesh/chat-sync.log"
        if [ -f "$_cs_log" ] && [ "$(( $(date +%s) - $(stat -c %Y "$_cs_log" 2>/dev/null || echo 0) ))" -lt 3600 ] 2>/dev/null; then
          pass "chat-sync wired + fresh (card declares minds, board feed alive)"
        else
          fail "card declares minds but chat-sync.log is STALE/missing (>1h) — this node may be running board-blind"
        fi
      else
        fail "card declares minds but chat-sync is NOT wired in cron — this node is board-blind (fleet can't see it, it can't see the fleet)"
      fi
    else
      warn "card declares minds but mesh-chat-sync tool absent — can't feed the shared board"
    fi
  fi
fi
pgrep -x cron >/dev/null 2>&1 || pgrep -x crond >/dev/null 2>&1 && pass "cron daemon running" || fail "cron daemon DOWN — no timers fire, autonomy dead"

hdr "hang risks (mesh-* SSH a peer with NO ConnectTimeout)"
risky=""
for t in "$HOME"/.local/bin/mesh-*; do
  # a REAL ssh COMMAND (not a comment, not "*ssh*" case-pattern, not "over ssh" in an echo):
  # ssh followed by an option (-), a quoted/var arg ("/$), or a user@host token
  grep -qE '^[^#]*ssh +(-|"|\$|[[:alnum:]_.-]+@)' "$t" 2>/dev/null || continue
  grep -q 'ConnectTimeout' "$t" 2>/dev/null && continue    # file uses ConnectTimeout somewhere → treat as safe
  name="$(basename "$t")"
  # Skip static scanners whose ssh patterns are only in test here-docs, not executed
  case "$name" in mesh-topology-leak-check) continue ;; esac
  risky="$risky $name"
done
risky=$(echo $risky)
[ -z "$risky" ] && pass "no untimed peer-SSH (all ssh-ing tools set ConnectTimeout)" || warn "untimed peer-SSH — hangs on a dead peer:$risky"

hdr "tools PARSE (committed-but-broken — runs even without --test)"
pe=""
for t in "$HOME"/.local/bin/mesh-*; do
  case "$(head -1 "$t" 2>/dev/null)" in
    *python*) python3 -m py_compile "$t" 2>/dev/null || pe="$pe $(basename "$t")" ;;
    *bash*|*/sh) bash -n "$t" 2>/dev/null || pe="$pe $(basename "$t")" ;;
  esac
done
[ -z "$pe" ] && pass "all deployed tools parse" || fail "WON'T PARSE (broken):$pe"
# bash -n above is BLIND to python EMBEDDED in a bash tool (python3 -c '...') — that class ran
# dead-but-green for days (mesh-github-watch f-string, mesh-study indentation, 2026-06-12).
if command -v mesh-pyparse >/dev/null 2>&1; then
  ep="$(mesh-pyparse "$HOME/.local/bin" 2>/dev/null | grep "WON'T COMPILE")"
  [ -z "$ep" ] && pass "embedded python in bash tools compiles" || fail "EMBEDDED python broken (dead-but-green):"$'\n'"$ep"
fi

hdr "source exec bit (committed non-+x → run-from-source / \$0-reexec false-green)"
# A genome SOURCE script committed without +x is a latent landmine: it won't run as ./scripts/<t>, and a
# --test that re-execs "$0" fails rc=126 FROM SOURCE while the deployed (+x) copy passes — so a source-green
# verification (or mesh-land's candidate --test) can be FOOLED (the exact case that bit mesh-display-link,
# chat-review/source-exec-gate 2026-06-25). Lint the genome scripts/ dir; the deployed-+x-too case is the
# precise false-green signature, called out so the WARN points straight at it.
_rscripts="${MESH_REPO:-$HOME/lte-workstation}/scripts"
nox=""
if [ -d "$_rscripts" ]; then
  for s in "$_rscripts"/mesh-* "$_rscripts"/*.sh; do
    [ -f "$s" ] || continue
    src_not_exec "$s" || continue
    name="$(basename "$s")"
    [ -x "$HOME/.local/bin/$name" ] && name="$name(deployed-+x→false-green)"
    nox="$nox $name"
  done
fi
nox=$(echo $nox)
[ -z "$nox" ] && pass "all genome source scripts are executable (source-green can't be fooled by a non-+x \$0)" \
              || warn "source NOT executable — chmod +x (run-from-source / \$0-reexec can false-green):$nox"

hdr "self-asserting gates (a self-grep whose pattern matches its own line)"
# 33 of 52 self-grep gates were vacuous when this was swept (2026-07-15, f798133) — too many to fix in
# one pass, so this is a RATCHET, not a pass/fail: the baseline only ever moves DOWN. A sweep that
# removes vacuous gates tightens the baseline permanently; a new one pushes the count above it and
# FAILs. That is what "cannot come back" means here — the debt is visible as a WARN and the regrowth
# is a FAIL, without a hardcoded number that ages out. Source-text scan by nature (the class IS a
# source-text bug); the ARTIFACT it protects is the count itself, asserted against the live tree.
_sgb="${MESH_SELFGREP_BASELINE_FILE:-$HOME/.mesh/.selfgrep-baseline}"
if [ -d "$_rscripts" ]; then
  _sg="$(selfgrep_scan "$_rscripts" 2>/dev/null)"
  if [ -z "$_sg" ]; then
    warn "self-grep scan produced nothing — detector broken or scripts/ unreadable ($_rscripts)"
  else
    _sgv=$(printf '%s\n' "$_sg" | grep -c '^V ' || true)
    _sgt=$(printf '%s\n' "$_sg" | grep -c '^[VG] ' || true)
    _sgp=$(cat "$_sgb" 2>/dev/null | tr -dc '0-9')
    _sgtop=$(printf '%s\n' "$_sg" | sed -n 's/^V \([^:]*\):.*/\1/p' | sort | uniq -c | sort -rn \
             | head -4 | awk '{printf "%s(%s) ", $2, $1}')
    if [ -z "$_sgp" ]; then
      printf '%s\n' "$_sgv" > "$_sgb" 2>/dev/null
      warn "self-grep baseline seeded at $_sgv vacuous of $_sgt — these gates assert their own text: $_sgtop"
    elif [ "$_sgv" -gt "$_sgp" ]; then
      fail "VACUOUS self-grep gates REGREW: $_sgv (baseline $_sgp) of $_sgt — a gate that greps its own source can never fail: $_sgtop"
    elif [ "$_sgv" -lt "$_sgp" ]; then
      printf '%s\n' "$_sgv" > "$_sgb" 2>/dev/null
      pass "self-grep ratchet tightened: $_sgv vacuous of $_sgt (was $_sgp) — baseline pinned down"
      [ "$_sgv" -gt 0 ] && warn "$_sgv vacuous self-grep gate(s) remain (of $_sgt): $_sgtop"
    elif [ "$_sgv" -gt 0 ]; then
      warn "$_sgv vacuous self-grep gate(s) of $_sgt at baseline — assert the ARTIFACT, not the source text: $_sgtop"
    else
      pass "no vacuous self-grep gates ($_sgt self-grep gate(s), all assert something other than themselves)"
    fi
  fi
fi

hdr "systemctl show --value + multi-property (systemd returns its own order, not yours)"
# `systemctl show -p A -p B --value` yields bare values in SYSTEMD's order — a positional zip against the
# requested list mislabels them silently (CPU-nanoseconds read as a memory byte count). Zero instances at
# filing (2026-07-27); one property per call, or drop --value and parse KEY=. See systemctl_show_scan.
if [ -d "$_rscripts" ]; then
  _sc2="$(systemctl_show_scan "$_rscripts" 2>/dev/null)"
  if [ -n "$_sc2" ]; then
    warn "systemctl show --value with 2+ properties (systemd reorders → positional zip mislabels values): $(printf '%s' "$_sc2" | tr '\n' ' ')"
  else
    pass "no systemctl show --value multi-property call sites (single -p or KEY= parse everywhere)"
  fi
fi

hdr "absence rendered as a NEGATIVE READING (the probe's failure arm and a bad measurement share a verdict)"
# REPORT-ONLY by design (the task's own "report-only first"): every row is a site where an ABSENT or
# TIMED-OUT input reaches the same verdict word as a real bad reading, so the word stops distinguishing
# "broken" from "could not look". No ratchet yet — the class has never been swept, so a baseline would
# pin debt whose size nobody has agreed on. Fix a row by giving absence its OWN arm: n/a + exit 2
# (mesh-cam-light:190), or by naming rc=124 separately. `absence-ok` on the line suppresses a
# deliberate one. See absence_scan for the two rules and the false-positive classes it refuses.
if [ -d "$_rscripts" ]; then
  _ab="$(absence_scan "$_rscripts" 2>/dev/null)"
  if [ -n "$_ab" ]; then
    _abn=$(printf '%s\n' "$_ab" | grep -c '^[AT] ' || true)
    warn "$_abn site(s) render absence as a negative reading (absent path and bad reading → the SAME verdict word): $(printf '%s' "$_ab" | tr '\n' ' ')"
  else
    pass "no site renders an absent/timed-out input as a negative reading (A+T rules clean across $_rscripts)"
  fi
fi

hdr "tool smoke tests (--test, node-aware)"
# A hardware-sense tool failing --test is n/a (WARN) on a node that LACKS that hardware (per the card);
# a real FAIL only where the node HAS it. Non-hardware tools always FAIL if broken (real bugs surface).
declared=" $(grep -E '^[[:space:]]*(senses|actuators):' "$card" 2>/dev/null | sed 's/^[^:]*://' | tr '\n' ' ') "
needs_cap(){ case "$1" in
  mesh-presence|mesh-presence-trends|mesh-presence-fuse|mesh-find) echo ble ;;
  mesh-wifiscan) echo wifi ;;
  mesh-audio|mesh-ear|mesh-hear) echo mic ;;
  mesh-lid) echo lid ;;
  mesh-notify) echo notify ;;
  mesh-camera|mesh-see) echo camera ;;
  mesh-volume) echo volume ;;
  mesh-transcribe|mesh-transcribe-organ) echo whisper ;;   # need a whisper.cpp install, not hardware
  mesh-tts) echo piper ;;                                   # needs piper (TTS engine), not just a speaker
  mesh-say|mesh-voice-tx|mesh-blessyou) echo speaker ;;
  mesh-therm|mesh-sensorium) echo thermal ;;
  mesh-therm-ambient) echo bleak ;;
  # Phone-SSH-dependent tools: when the phone is unreachable each --test spends 6-17s reaching its honest
  # exit-2, and under the parallel smoke STORM they exceed `timeout 12` → rc=124 → the full retry ladder
  # (~70s each) → the WHOLE doctor hangs >120s (health saw exactly this 2026-07-04, phone down: the smoke
  # section alone was 84s). The _phone_up pre-check below does ONE shared probe; listing a phone-only tool
  # here short-circuits it to n/a with NO subshell — collapsing the storm to the non-phone tools.
  # KEEP THIS LIST COMPLETE as phone senses are added — the 07-04 hang was drift: 16 phone senses had been
  # minted (mesh-gyro/mag/baro/grip/step/gravity/rotation-vector/body-load/body-thermal/motion-type/
  # cell-info/call/sms-monitor/sms-rx/wifi-link/audio-energy) without being listed. ONLY list PHONE-ONLY
  # tools (honest exit-2 when the phone is down); a tool with a node-side fallback (e.g. mesh-activity-tempo's
  # phone-free wifi path, mesh-wifi-motion is node-side too) must classify by its own run, not be blanket-n/a'd
  # here, or its working local path is hidden (hollow-sense) — mesh-activity-tempo was measured phone-n/a
  # only because BOTH phone AND wifi tape were down, so it is deliberately NOT listed. Every ADDED entry
  # was verified against per-tool --test timing under a down phone (each exited 2 = genuinely phone-gated).
  # DE-LISTED 2026-08-04 (board task:mesh-card): `mesh-card-watchdog` sat right here, between
  # `mesh-call` and `mesh-cell-info` — ALPHABETICAL drift, not a capability claim. It reads this
  # node's OWN card and touches no phone: measured the same day, `mesh-card-watchdog --test` →
  # `smoke-test: ok` rc=0 in 11.0s with the phone irrelevant, while EVERY recent doctor run listed
  # it under "--test n/a here (no hardware)". So the one hourly check that could have caught the
  # card ageing 11 days was rendering the watchdog not-applicable — precisely the hollow-sense the
  # paragraph above forbids, committed against the very rule it states. The lesson is narrower than
  # "keep the list complete": a name-keyed n/a list is a CLAIM ABOUT EACH NAME, and sorted insertion
  # is how a claim gets made by adjacency instead of by measurement. An entry here must be earned by
  # watching that tool exit 2 with the phone down; `mesh-card-watchdog` never could — it has no
  # phone path to fail. Before adding a name, run its --test with the phone down and read the rc.
  mesh-act|mesh-audio-energy|mesh-baro|mesh-body-context|mesh-body-load|mesh-body-motion|\
mesh-body-power|mesh-body-thermal|mesh-call|mesh-cell-info|mesh-gravity|\
mesh-grip|mesh-gyro|mesh-light|mesh-location|mesh-mag|mesh-motion-type|mesh-operator-home|\
mesh-operator-state|mesh-organ|mesh-phone-convo|mesh-phone-ear|mesh-phone-sensors|\
mesh-rotation-vector|mesh-room-sense|mesh-sms|mesh-sms-monitor|mesh-sms-rx|mesh-step|\
mesh-tamper|mesh-wifi-link|mesh-wifi-motion) echo phone ;;
  # Phone-watch: needs adb on PATH (ADB-over-WiFi sshd watchdog). VPS nodes without adb → n/a.
  mesh-phone-watch) echo adb ;;
  # TG-infrastructure tools: require bot token at ~/.config/remote-access/env. VPS nodes
  # without the token should n/a (WARN), not FAIL — reduces phaedra doctor noise.
  mesh-tg|mesh-voice-rx) echo telegram ;;
  mesh-tg-roz) echo telegram ;;
  # GitHub-watch: needs gh CLI + auth. VPS nodes without gh → n/a, not FAIL.
  mesh-github-watch) echo github ;;
  # Genome-sync: needs git repo with origin remote. Leaf nodes → n/a, not FAIL.
  mesh-genome-sync) echo genome ;;
  *) echo "" ;; esac; }
# have_cap: a declared-on-the-card sense/actuator, OR a node-local OPTIONAL DEPENDENCY (a model/engine
# a node may not have provisioned). The latter keeps an un-provisioned node (e.g. a NL VPS without
# whisper/piper) from reporting a real FAIL for a capability it simply hasn't installed — that's n/a,
# not breakage. Mirrors the existing thermal special-case.
have_cap(){
  case "$1" in
    thermal)  [ -d /sys/class/thermal/thermal_zone0 ]; return ;;
    whisper)  [ -x "$HOME/.mesh/whispercpp/main" ]; return ;;
    piper)    [ -x "$HOME/.mesh/piper/piper/piper" ]; return ;;
    phone)    [ "${_phone_up:-0}" = 1 ]; return ;;
    adb)      command -v adb >/dev/null 2>&1; return ;;
    bleak)    python3 -c 'import bleak' >/dev/null 2>&1; return ;;
    telegram) [ -f "$HOME/.config/remote-access/env" ] && grep -q '^BOT_TOKEN=' "$HOME/.config/remote-access/env" 2>/dev/null; return ;;
    # >/dev/null too: gh prints its auth report to STDOUT, and this call runs outside any command
    # substitution — the raw report (7 lines, token shape included) leaked into doctor.log every
    # sweep, right at the fan-out start, reading like "the run died at the gh check" (2026-07-23).
    github)   command -v gh >/dev/null 2>&1 && timeout 10 gh auth status >/dev/null 2>&1; return ;;
    genome)   [ -d "$HOME/lte-workstation/.git" ] && git -C "$HOME/lte-workstation" remote get-url origin >/dev/null 2>&1 \
              && { url=$(git -C "$HOME/lte-workstation" remote get-url ideapad 2>/dev/null) && [ -d "$url" ]; } 2>/dev/null; return ;;
  esac
  printf '%s' "$declared" | grep -qw "$1"
}
# A tool that can't even be EXEC'd on this host is n/a here, not a real FAIL: e.g. a
# phone-resident Termux script (#!/data/data/com.termux/files/usr/bin/sh) whose interpreter
# only exists on the Android body. Such a tool isn't broken on this node — it simply doesn't
# run on this node. (rc=127 "required file not found" is the symptom; pre-checking the shebang
# interpreter is unambiguous, vs a 127 a working tool might emit from its own command-not-found.)
_runnable_here(){
  local shb interp
  shb="$(head -1 "$1" 2>/dev/null)"
  case "$shb" in '#!'*) interp="${shb#\#!}";; *) return 0;; esac  # no shebang → let the shell try
  set -- $interp
  if [ "$(basename "$1")" = env ]; then command -v "$2" >/dev/null 2>&1; else [ -x "$1" ]; fi
}
# Phone pre-check: one probe shared across ALL phone-SSH-dependent tool tests.
# Two optimisations in one:
#  1. When phone is DOWN: marks all phone tools n/a → skips 12 × 6s = 72s of ConnectTimeout waits.
#  2. When phone is UP: exports PHONE_IP so each tool's mesh-phone-ip call uses the cached IP
#     directly (skips the ~4s multi-candidate probe) → cuts each phone --test from ~5s to ~2s,
#     saving ~36s across 12 tools even when the phone is reachable.
_phone_up=0; _phone_ip=""
# Real SSH reachability, NOT mesh-phone-ip: the latter returns a CACHED/stale LAN IP with rc=0 even when
# the phone's sshd is dead (false-green), so _phone_up read 1 while the phone was genuinely unreachable.
# That made the THEATER GATE below false-fire on a phone sense whose stale state was actually CORRECT (it
# honestly couldn't read the offline phone — the mesh-body-power false-theater, 2026-06-20), AND defeated
# the n/a latency skip (all 12 phone --tests still burned their 6s ConnectTimeout). The senses already use
# phone_reachable_ip for exactly this reason (mesh-mag/grip --test). Needs PHONE_LAN_IPS (node-local, from
# ~/.mesh/nodes) for the LAN-fallback path so a LAN-only-reachable phone still reads _phone_up=1.
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes"
source "$HOME/.local/bin/mesh-patterns.sh" 2>/dev/null || true
if command -v phone_reachable_ip >/dev/null 2>&1; then
  _phone_ip="$(timeout 14 phone_reachable_ip 2>/dev/null || true)"
else
  _phone_ip="$(timeout 10 mesh-phone-ip 2>/dev/null || true)"   # fallback if mesh-patterns.sh absent
fi
if [ -n "$_phone_ip" ]; then _phone_up=1; export PHONE_IP="$_phone_ip"; fi

# SMOKE-TEST THEATER GATE (opt-in, default-inert). A passing --test only proves the tool RUNS and
# (post-d021798) that its input is REACHABLE — it cannot prove the tool is actually PRODUCING. A sense
# can stay reachable yet silently stop emitting (pipeline broke, parser drifted) and its --test still
# goes green for days (the baro hollow-green incident, 2026-06-20). To close that structural gap a tool
# OPTS IN by declaring, in its header:  # doctor-artifact: <path> <ttl_sec> [<reach_gate>]
# After its --test PASSES, we check the SUCCESS-ONLY artifact's freshness — but ONLY when the input is
# reachable, so a legitimately-absent artifact (phone offline → no reading) is NEVER a false theater
# (the exact false-fail hazard chat-review flagged). reach_gate: 'phone' (gate on the shared _phone_up
# probe above) or 'local'/'' (input always available → always check). Undeclared tools → zero change.
# This is a WARN (advisory), never a FAIL — it does not perturb the exit=#FAILs contract.
_theater_check(){
  local tool="$1" name="$2" line path ttl gate now age
  line="$(grep -m1 '^# doctor-artifact:' "$tool" 2>/dev/null)" || return 0
  [ -n "$line" ] || return 0
  # shellcheck disable=SC2086
  set -- ${line#\# doctor-artifact:}
  path="${1:-}"; ttl="${2:-}"; gate="${3:-local}"
  [ -n "$path" ] && [ -n "$ttl" ] || return 0
  path="${path/\$HOME/$HOME}"; path="${path/#\~/$HOME}"
  case "$gate" in
    phone) [ "${_phone_up:-0}" = 1 ] || return 0 ;;   # input unreachable → stale is expected, not theater
    *)     : ;;                                        # local/unknown → input always available
  esac
  now="$(date +%s)"
  if [ -f "$path" ]; then
    age=$(( now - $(stat -c %Y "$path" 2>/dev/null || echo "$now") ))
    [ "$age" -gt "$ttl" ] && sm_theater="$sm_theater $name(${path##*/}:${age}s>${ttl}s)"
  else
    sm_theater="$sm_theater $name(${path##*/}:absent)"   # reachable but never produced → hollow
  fi
}
sm_fail=""; sm_na=""; sm_theater=""; sm_link_na=""; sm_unassessed=""
# LINK BRACKET, pre-storm read (see _link_up above): capture uplink state BEFORE the fan-out so a
# sweep that STARTS inside an outage is already known-straddled at verdict time.
_link_pre=1; _link_up || _link_pre=0
# PARALLEL smoke loop: launch all --test checks concurrently (the serial version accumulated
# ~5-10s × N=180 tools = 120s+ under a down phone). Results go to per-tool files; retries run
# inside each subshell so slow/flaky tools don't block others.
# Unthrottled fan-out is intentional (wall-clock = slowest single tool, not the sum) — no concurrency
# cap here; the pile-up risk is instead in the SERIAL confirm below, which is bounded by a deadline
# (MESH_DOCTOR_SC_BUDGET). (A prior comment claimed a $_SM_LIMIT cap that was never implemented.)
_SM_TMP="$(mktemp -d)"
for t in "$HOME"/.local/bin/mesh-*; do
  grep -q -- '--test' "$t" 2>/dev/null || continue
  b=$(basename "$t")
  # Short-circuit n/a tools immediately (no subshell) to avoid even the launch overhead.
  cap=$(needs_cap "$b")
  if [ -n "$cap" ] && ! have_cap "$cap"; then
    printf '2\n' > "$_SM_TMP/$b"; continue
  fi
  # Foreign-host tool (interpreter absent here, e.g. a phone Termux script) → n/a, not FAIL.
  if ! _runnable_here "$t"; then printf '2\n' > "$_SM_TMP/$b"; continue; fi
  (
    # Close the doctor lock fd (9) before running any tool's --test. A --test that
    # daemonizes (e.g. mesh-voice-rx relaunching its poller) would otherwise INHERIT
    # the lock fd, escape the timeout, and hold flock forever — silently freezing every
    # future doctor run via flock -n (root-caused 2026-06-25: doctor sat ~90m behind a
    # stuck mesh-voice-rx holding fd9). 2>/dev/null: fd9 is unopened on non-quiet runs.
    exec 9>&- 2>/dev/null
    # Private TMPDIR for this child (see _fence_tmpdir above): its --test leaks land here, get
    # counted, and die with $_SM_TMP instead of accreting in the shared /tmp for three days.
    _fence_tmpdir "$_SM_TMP" "$b"
    # CONVENTION: exit 2 from --test = "n/a (capability not available on this node)".
    # MESH_TEST_SANDBOX=1 (chat-review/doctor-smoke-sandbox-net): doctor-level outbound suppression —
    # the primitives themselves (mesh-chat real-board posts, mesh-tg sends) honor it, so a future
    # tool's self-sandboxing bug can't leak board/TG side-effects from a smoke sweep. Defense-in-depth
    # on top of, not a replacement for, each tool's own --test sandboxing. HONEST LIMIT: raw ssh/scp
    # outbound is NOT centrally suppressible (system binaries; PATH-stubbing is defeated by tools'
    # own `export PATH=~/.local/bin:` prepend) — SSH hygiene stays each tool's own --test duty.
    MESH_TEST_SANDBOX=1 timeout 12 "$t" --test >/dev/null 2>&1; rc=$?
    if [ "$rc" != 0 ] && [ "$rc" != 2 ]; then
      # FLAKE GUARD: a --test that queries a live service can fail transiently. Retry with
      # escalating backoff+timeout (2026-06-13: two attempts; tighter first window tolerates
      # brief spikes, longer second clears sustained load).
      for _bt in "5 20" "8 25"; do
        sleep "${_bt% *}"; MESH_TEST_SANDBOX=1 timeout "${_bt#* }" "$t" --test >/dev/null 2>&1; rc=$?
        { [ "$rc" = 0 ] || [ "$rc" = 2 ]; } && break
      done
    fi
    _fence_reap "$_SM_TMP" "$b"
    printf '%d\n' "$rc" > "$_SM_TMP/$b"
  ) &
done
wait  # all tests run in parallel; wall-clock = slowest tool (~5s), not sum (~49s serial)

# Process results serially (pure in-memory, no I/O waits)
# BOUNDED SERIAL-CONFIRM DEADLINE (2026-07-04, health saw mesh-doctor hang >120s under a down phone):
# the re-run below rescues load-starved slow tools, but with N phone-SSH --tests all timing out (rc=124)
# under an unreachable phone, an UNBOUNDED "timeout 60 per survivor" pile-up ran the whole doctor past
# 120s → the dash could no longer refresh live doctor at all. Cap the aggregate phase at
# MESH_DOCTOR_SC_BUDGET (60s — still fits ONE genuinely-slow legit re-run, e.g. mesh-heartbeat 22-51s).
# Each re-run's window is clamped to the budget remaining; once it's spent, a still-unconfirmed survivor
# is classified n/a ("couldn't assess in the time budget"), NOT FAIL — an unassessable tool is honestly-
# unknown, never a faked failure verdict. Semantics are UNCHANGED when the budget is ample: the only path
# that still reaches sm_fail via timeout is a FULL-60s-window timeout (a tool that can't pass even with
# the generous window IS a real problem — "FAIL (real) means real" preserved). A genuinely-broken tool
# fails FAST at rc=1 well inside budget, so it is still caught; only repeat-timeouts hit the deadline.
_sc_deadline=$(( $(date +%s) + ${MESH_DOCTOR_SC_BUDGET:-60} ))
for t in "$HOME"/.local/bin/mesh-*; do
  grep -q -- '--test' "$t" 2>/dev/null || continue
  b=$(basename "$t")
  rc="$(cat "$_SM_TMP/$b" 2>/dev/null || echo 1)"
  [ "$rc" = 0 ] && { _theater_check "$t" "$b"; continue; }
  [ "$rc" = 2 ] && { sm_na="$sm_na $b"; continue; }
  # POST-STORM SERIAL CONFIRM (2026-06-20, reproduced against reality): the parallel storm above STARVES
  # slow --tests — e.g. mesh-heartbeat --test runs real mesh-health (peer SSH probes; each offline peer
  # adds a ConnectTimeout) and takes 22-51s in isolation, so it times out under load and the in-subshell
  # retries (≤25s, run under that SAME load) can't clear it → false "FAIL (real)" that cry-wolfs the
  # [doctor] alert. Now that the storm has drained, re-run each survivor ONCE serially in the quiet with
  # a generous window: a load-starved tool passes here, a genuinely broken one fails again. This is what
  # makes "FAIL (real)" actually mean real (same principle as the camera retry above).
  if _runnable_here "$t"; then
    case "$(_sc_confirm_tool "$t" "$_sc_deadline")" in
      pass)       _theater_check "$t" "$b"; continue ;;
      na)         sm_na="$sm_na $b"; continue ;;
      unassessed) sm_unassessed="$sm_unassessed $b"; continue ;;
      fail) : ;;   # fall through to cap/sm_fail below
    esac
  fi
  cap=$(needs_cap "$b")
  if [ -n "$cap" ] && ! have_cap "$cap"; then sm_na="$sm_na $b"; else sm_fail="$sm_fail $b"; fi
done
# Per-tool TMPDIR residue (see the fence block above). ONE line, not one per tool: when this census
# was born it named 74 tools at once, and a WARN each would have put a permanent +74 on a summary
# that reads "1 FAIL, 14 WARN" — a standing backlog rendered as hourly alarms is how a real FAIL
# stops being visible. The debris is already fenced and removed, so nothing here is an incident: it
# is a hygiene census, and a census wants a COUNT plus the worst offenders, with the total stated so
# the three names cannot read as all of them. That backlog was drained tool-side
# (task:doctor-test-tmpdir-cleanup-traps): each leaker re-execs its --test once under a private
# TMPDIR it removes from the parent, so this line is now expected to be ABSENT and any reappearance
# is a NEW leaker, not the old crowd. Do not re-derive the "74" as a live figure — the count that
# matters is whatever _fence_report returns this run. Full ranking on demand: run the tools' --test
# under a private TMPDIR yourself.
_fr_all="$(_fence_report "$_SM_TMP")"
_fr_n=$(printf '%s' "$_fr_all" | grep -c . )
if [ "${_fr_n:-0}" -gt 0 ]; then
  _fr_top="$(printf '%s\n' "$_fr_all" | head -3 | awk '{printf "%s%s %s", (NR>1?", ":""), $2, $1}')"
  warn "tmp leak: $_fr_n tool(s) left files in TMPDIR during --test (fenced+removed by doctor; worst: $_fr_top — those tools want a cleanup trap)"
fi
rm -rf "$_SM_TMP"
# FENCE-ESCAPE census — the one shape the residue count above is STRUCTURALLY BLIND TO. That count
# can only see debris that lands in $TMPDIR; a tool whose --test hardcodes `mktemp /tmp/…` opts out
# of the fence, leaks into the shared /tmp where it is indistinguishable from ambient churn, and
# then reads here as a perfectly CLEAN tool. So the escape needs its own detector, and it has to be
# a source scan: the opt-out IS a piece of text. (Only half the usual "source text is never
# behaviour" caveat applies — the text does not prove the line RUNS, but a hardcoded template that
# never runs is still a fence the next caller falls out of.)
_esc_files=""
_esc_dir="${MESH_GENOME:-$HOME/lte-workstation}/scripts"
[ -d "$_esc_dir" ] && _esc_files="$(_fence_escape_scan "$_esc_dir")"
[ -n "${_esc_files// /}" ] && warn "tmp fence escape: hardcoded /tmp mktemp template in: ${_esc_files% } (write it \"\${TMPDIR:-/tmp}\"/… so the sweep's fence can catch AND count the debris — as written it is neither stopped nor counted, and the tool reads clean above)"
# LINK BRACKET, at-verdict read + lane decision: any bracket down → survivors are unassessable
# ('n/a — sweep straddled a link outage'), never '(real)'.
_link_post=1; _link_up || _link_post=0
_sm_apply_link_bracket "$_link_pre" "$_link_post"
[ -z "$sm_fail" ] && pass "all applicable --test smoke checks pass" || fail "smoke-test FAIL (real):$sm_fail"
[ -n "$sm_link_na" ] && note "--test n/a — sweep straddled a link outage (uplink bracket down pre=$_link_pre post=$_link_post; survivors re-assessed next pass, never '(real)'):$sm_link_na"
[ -n "$sm_na" ] && note "--test n/a here (no hardware / tool declared not-applicable on this node):$sm_na"
# UNASSESSED ≠ n/a: a --test doctor could not FINISH inside its ${MESH_DOCTOR_SC_BUDGET:-60}s serial-confirm
# budget is not an innocent hardware gap — it is a gate that has never been assessed, hiding in plain sight
# (mesh-pace --test ran 90s and sat in the 'no hardware' list every hourly pass while doctor printed 0 FAIL,
# 2026-07-31). WARN, don't note: a permanently-unassessable gate must surface, not blend into an absence.
[ -n "$sm_unassessed" ] && warn "--test UNASSESSED (exceeded the ${MESH_DOCTOR_SC_BUDGET:-60}s serial-confirm budget — too slow to reach, NOT absent hardware; this gate has never been assessed):$sm_unassessed"
[ -n "$sm_theater" ] && warn "smoke-test THEATER (--test green but success-artifact stale/absent while input reachable — sense not producing):$sm_theater"

hdr "tool runtime-safe (printf+wc-l empty-input anti-pattern)"
# BUG CLASS (2026-06-16, phaedra verify-against-reality): printf '%s\n' "$var" | wc -l miscounts
# empty input as 1 (printf emits one newline even when $var is empty). The correct pattern is
# awk 'NF{c++} END{print c+0}' (counts non-blank lines like grep -c ., always exits 0).
# Tools that guard the pipeline with [ -n "$var" ] are safe by guard; others are WARNed.
# GUARD-AWARE (2026-06-20, verify-against-reality): the old check WARNed every file containing the
# pattern, ignoring its own "safe by guard" rule → 2 PERMANENT false WARNs (mesh-reflexes:150,
# mesh-sensor-log:121, both provably empty-unreachable). Now suppress a site when EITHER:
#   SAFE-1  it is a difference of two counts — $((..wc -l) - $(..wc -l)) — the off-by-one cancels.
#   SAFE-2  the counted var is guarded by an enclosing [ -n/-z "$var" ] within the preceding block.
# Candidate detection is unchanged (faithful to the original printf '%s\n' .. wc -l matcher); only
# real, unguarded sites survive, reported as file:line so the WARN pinpoints the actual bug.
wc_l_bugs=""
for _bt in "$HOME"/.local/bin/mesh-* "$HOME"/lte-workstation/scripts/mesh-*; do
  [ -f "$_bt" ] || continue
  _bn=$(basename "$_bt")
  while IFS= read -r _ml; do
    [ -n "$_ml" ] || continue
    _lno="${_ml%%:*}"; _ltext="${_ml#*:}"
    # SAFE-1: difference of two counts cancels the empty off-by-one.
    case "$_ltext" in *'wc -l)'*-*'wc -l'*) continue;; esac
    # SAFE-2: counted var guarded by an enclosing [ -n/-z "$var" ] within the block above.
    _wcvar=$(printf '%s\n' "$_ltext" | grep -oE '\$[A-Za-z_][A-Za-z0-9_]*"?[[:space:]]*\|[[:space:]]*wc' | grep -oE '[A-Za-z_][A-Za-z0-9_]*' | head -1)
    if [ -n "$_wcvar" ]; then
      _wclo=$(( _lno > 12 ? _lno - 12 : 1 ))
      sed -n "${_wclo},${_lno}p" "$_bt" 2>/dev/null | grep -qE "[-][nz][[:space:]]+\"?\\\$$_wcvar\\b" && continue
    fi
    wc_l_bugs="$wc_l_bugs $_bn:$_lno"
  done <<EOF
$(grep -n "printf '%s\\\\n'" "$_bt" 2>/dev/null | grep 'wc -l' | grep -vE '^[0-9]+:[[:space:]]*#')
EOF
done
wc_l_bugs="$(printf '%s' "$wc_l_bugs" | tr ' ' '\n' | sort -u | tr '\n' ' ' | sed 's/ $//')"
[ -z "$wc_l_bugs" ] && pass "no printf+wc-l empty-input anti-pattern" \
  || warn "printf+\\\\n-empty-input fragile (empty var → spurious newline → wc-l miscounts by 1; note: guard with [ -n \"\$var\" ] makes it safe):${wc_l_bugs}"

hdr "orphan check (unwired scripts — not in crontab/systemd/supervise/CLAUDE.md/other scripts)"
GENOME="${MESH_GENOME:-$HOME/lte-workstation}"
orphans=""
# Pre-strip comments from every script ONCE. The old invocation-scan ran sed|grep for EACH tool
# against EACH script — ~O(n²) ≈ 20k subprocesses — which flakes under system load: a transient
# sed/grep failure reads as 'no match' → RANDOM false orphans (verified 2026-06-13: even with the
# flock serialize, concurrent runs gave differing bogus orphan lists). One sed pass per file here;
# a single grep per tool below (~286 subprocesses total).
STRIP_DIR="$(mktemp -d)"
for g in "$GENOME"/scripts/*; do
  [ -f "$g" ] || continue
  sed 's/#.*//' "$g" 2>/dev/null > "$STRIP_DIR/$(basename "$g")"
done
# THE CANON SECTION IS THE ONLY PART OF CLAUDE.md THAT DECLARES INTENT. Hoisted out of the loop
# (it was re-awk'd per tool for the glob path) so the bare-name path below can share ONE definition
# — the two paths reading different scopes WAS the bug this block now carries a gate for.
CANON=$(canon_section "$GENOME"/CLAUDE.md)
for f in "$GENOME"/scripts/*; do
  [ -f "$f" ] || continue
  name=$(basename "$f")
  case "$name" in *.md|.gitkeep|*.example) continue ;; esac   # docs/templates not tools
  found=""
  # NAME AS A STANDALONE TOKEN, not a substring: a bare `grep -Fq "$name"` counted a LONGER tool
  # whose name CONTAINS this one (mesh-tg ⊂ mesh-tg-update, mesh-organ ⊂ mesh-organs, mesh-therm ⊂
  # mesh-therm-watch, mesh-hear ⊂ mesh-heartbeat, mesh-voice ⊂ mesh-voice-rx) as "wired" in
  # crontab/systemd/supervise → a genuinely-decayed tool could hide behind a longer one's wiring
  # (the 2026-06-12 substring-false-wiring [task]). Token-bound every wiring check. (re_name/tok are
  # reused by the cross-script invocation check below.)
  re_name=$(printf '%s' "$name" | sed 's/[.[]/\\&/g')
  tok="(^|[^A-Za-z0-9_-])${re_name}([^A-Za-z0-9_-]|$)"
  crontab -l 2>/dev/null | grep -Eq "$tok" 2>/dev/null && found=1
  grep -Eq "$tok" ~/.config/systemd/user/*.service 2>/dev/null && found=1
  [ -f ~/.mesh/supervise.list ] && grep -Eq "$tok" ~/.mesh/supervise.list 2>/dev/null && found=1
  # match the backticked canon name whether bare (`name`) OR with inline args (`name <device>`);
  # the old bare-only `grep -Fq "\`$name\`"` falsely flagged e.g. `mesh-find <device>` as orphan.
  # SCOPED TO $CANON, NOT ALL OF CLAUDE.md: a mention in the TOOLING CATALOG is a description of
  # what a tool IS, never a declaration that it is deliberately unwired — but the old whole-file
  # grep could not tell the two apart, so cataloguing a tool silently exempted it from the orphan
  # check forever. That hid mesh-genome-sync's total death for 3 days (the anti-SPOF mirrors sat
  # 133-1813 commits stale; fb85906) and 26 more tools read as intentional on this node purely
  # because the catalog names them. The glob path below ALWAYS scoped correctly — the asymmetry
  # between two readers of one rule was the whole bug.
  canon_declares "$name" "$CANON" && found=1
  # check glob and brace patterns from canon (e.g. test-*, mesh-card-watchdog.{sh,service,timer})
  if [ -z "$found" ]; then
    while IFS= read -r glob; do
      [ -z "$glob" ] && continue
      # strip backticks and evaluate brace expansions
      pat="${glob#\`}"; pat="${pat%\`}"
      for expanded in $(eval "echo $pat" 2>/dev/null); do
        case "$name" in $expanded) found=1; break 2 ;; esac
      done
    done < <(printf '%s\n' "$CANON" | grep -oP '\S+(\*|{[^}]+})' | grep -v '\*\*' || true)
  fi
  if [ -z "$found" ]; then
    # Match an INVOCATION, not a mere mention: the same token regex ($tok), over the comment-stripped
    # corpus (so a comment mention or a longer tool name as substring doesn't falsely mark it
    # "wired"). One grep across all pre-stripped files; a match in ANY file other than the tool's
    # OWN = genuinely wired.
    invoked_by_other "$name" "$STRIP_DIR" "$tok" && found=1
  fi
  # `# orphan-ok: <why>` header → the tool DECLARES itself intentionally-unwired (the CLAUDE.md
  # doctrine's per-tool escape hatch, alongside the On-demand-canon list). Honor it so a tool can
  # self-document "deliberately not wired, here's why" inline instead of editing CLAUDE.md — keeps the
  # orphan WARN meaning "built to be wired but isn't" without drowning in intended-unwired tools.
  [ -z "$found" ] && grep -Eq '^#[[:space:]]*orphan-ok:' "$f" 2>/dev/null && found=1
  # ...and a `# reflex-cadence: none|off|manual|on-demand` self-declaration counts the same (a tool
  # that documents itself as deliberately unscheduled is not a built-but-unwired orphan).
  [ -z "$found" ] && cadence_is_ondemand "$f" && found=1
  [ -z "$found" ] && orphans="$orphans $name"
done
rm -rf "$STRIP_DIR"

# PERSISTENT ORPHAN STATE: only warn after 2+ consecutive unwired checks (chat-review/orphan-churn-stabilization)
ORPHAN_STATE="$HOME/.mesh/.doctor-orphans-state"
prev_orphans=""; [ -f "$ORPHAN_STATE" ] && prev_orphans=$(cat "$ORPHAN_STATE" 2>/dev/null || echo "")
# Normalize to space-separated words for set comparison
curr_set=$(printf '%s\n' $orphans | sort -u | tr '\n' ' ')
prev_set=$(printf '%s\n' $prev_orphans | sort -u | tr '\n' ' ')
# Persist current state for next run
printf '%s\n' $orphans | sort -u > "$ORPHAN_STATE" 2>/dev/null

# Confirm orphans: present in BOTH previous and current run (2-consecutive threshold)
confirmed_orphans=""
for o in $curr_set; do
  case " $prev_set " in *" $o "*) confirmed_orphans="$confirmed_orphans $o" ;; esac
done

# EMITTED STATE (separate from ORPHAN_STATE, which holds the raw set for the 2-check gate):
# tracks the confirmed set we last WARNed about, so a STABLE backlog stops re-dumping every check.
EMITTED_STATE="$HOME/.mesh/.doctor-orphans-emitted"
if [ -z "$confirmed_orphans" ]; then
  [ -z "$curr_set" ] && pass "0 orphans — all scripts wired or in canon" || pass "0 persistent orphans — transient orphans ($curr_set) not confirmed across 2 checks"
  : > "$EMITTED_STATE" 2>/dev/null
else
  # De-noise (chat-review/doctor-orphan-dump-condense): a stable 50-strong orphan backlog dumped
  # 50 WARN lines EVERY check, drowning health output. Collapse to ONE summary WARN; name ONLY the
  # orphans that CHANGED since last emission (new/resolved, capped). Stable text is byte-identical
  # run-to-run so NEW-WARN detectors (mesh-tick) don't false-fire on an unchanged backlog; the full
  # list stays one `cat ~/.mesh/.doctor-orphans-state` away.
  conf_set=$(printf '%s\n' $confirmed_orphans | sort -u | tr '\n' ' ')
  emitted_set=""; [ -f "$EMITTED_STATE" ] && emitted_set=$(tr '\n' ' ' < "$EMITTED_STATE" 2>/dev/null)
  new_orphans=""; for o in $conf_set; do case " $emitted_set " in *" $o "*) ;; *) new_orphans="$new_orphans $o";; esac; done
  gone_orphans=""; for o in $emitted_set; do case " $conf_set " in *" $o "*) ;; *) gone_orphans="$gone_orphans $o";; esac; done
  n=$(echo $conf_set | wc -w)
  _cap(){ local c; c=$(echo $1 | wc -w); [ "$c" -gt 8 ] && echo "$c" || echo "${1# }"; }
  if [ -n "${new_orphans// /}" ] || [ -n "${gone_orphans// /}" ]; then
    delta=""
    [ -n "${new_orphans// /}" ]  && delta="$delta +new:$(_cap "$new_orphans")"
    [ -n "${gone_orphans// /}" ] && delta="$delta -resolved:$(_cap "$gone_orphans")"
    warn "orphans: $n unwired+non-canon, confirmed 2+ checks —$delta (full list: cat ~/.mesh/.doctor-orphans-state)"
  else
    warn "orphans: $n unwired+non-canon, confirmed 2+ checks (stable) — full list: cat ~/.mesh/.doctor-orphans-state"
  fi
  printf '%s\n' $conf_set | tr ' ' '\n' | grep -v '^$' > "$EMITTED_STATE" 2>/dev/null
fi

# UMWELT CHECK (LITERATURE, live review 2026-07-04: biosemiotics — sign and meaning in living
# systems, angle=a concrete METRIC this area uses to measure itself). Distinct from the orphan check
# above: orphan asks "does this TOOL run at all" (wired into cron/systemd/canon); this asks "does
# anything else ever READ what it produces". A tool can be perfectly wired (not an orphan — it fires
# on schedule, writes its STATE file every run) and still be functionally inert to the mesh: nobody
# else's script ever references that state file, so its signal never closes a loop back into any
# other reflex/decision. Ay & Löhr, "The Umwelt of an Embodied Agent -- A Measure-Theoretic
# Definition" (arXiv:1603.08389, formalising von Uexküll's Funktionskreis) define an agent's Umwelt
# as the σ-algebra of world-events that are part of its OWN closed sensorimotor loop — a strict
# SUBALGEBRA of everything an external observer could distinguish. A state file nobody in the mesh
# ever reads is real data (an external observer / operator `cat`-ing it by hand could see it) but
# sits OUTSIDE the mesh's own Umwelt in this strict sense: Merkwelt (perception) with no Wirkwelt
# (effect) — it never feeds any other sense, fusion tool, or decision. This is a live gap: no
# existing check (mesh-doctor's orphan check, mesh-vitality's production check, mesh-autowire's
# cron-integration check) asks whether a state PRODUCER has any CONSUMER; all three ask about the
# tool's own liveness/wiring, never its output's downstream use. `# umwelt-ok: <why>` is the escape
# hatch (mirrors `# orphan-ok:`) for a state file that is intentionally manual/operator-`--state`-only.
# Two DISTINCT consumption paths count as closing the loop, so both are checked: (a) another script
# reads the STATE FILE PATH directly, or (b) another script INVOKES the tool by name (token-bound,
# comment-stripped — same convention the orphan check above uses) and consumes its live stdout
# instead (e.g. mesh-wifi-contention calls `mesh-airtime`, never touches `.airtime.state`). Checking
# only (a) over-flags every fusion-by-invocation sense as a false umwelt-gap.
#
# INTERPRETANT (third consumption path, 2026-08-10 — knowledge/review-biosemiotics-interpretant-
# gap-2026-06-20.md). Peirce's sign is TRIADIC: a representamen stands for an object TO AN
# INTERPRETANT, and with no interpretant there is no sign, only a physical mark. Paths (a) and (b)
# are both EXTERNAL interpretants. The third is TEMPORAL: Peirce's infinite semiosis lets the
# interpretant be the same system at a later time, so a tool that reads its own state back next run
# (edge/debounce/rate baseline) HAS closed a loop. Without that exclusion the check is a
# noise-generator — the review's own hand scan flagged 12/33 and disowned the number for exactly
# this reason. Measured on the live corpus 2026-08-10: 210 declared emitters → 62 with no external
# interpretant → 49 of those self-consume → 13 real dead vehicles. WARN-only either way; the
# distinction is what makes the WARN mean something. (A growing corpus moves every one of those
# numbers — the CLAIM is the gate; re-derive, never quote. The 159/39/27/12 that stood here until
# 20:40 was a mid-development count that outlived its corpus by one edit.)
hdr "interpretant check (state producers with no reader, no invoker and no self-consumption)"
umwelt_orphans=""; umwelt_self=""
UM_STRIP="$(mktemp -d)"
for g in "$GENOME"/scripts/*; do
  [ -f "$g" ] || continue
  sed 's/#.*//' "$g" 2>/dev/null > "$UM_STRIP/$(basename "$g")"
done
for f in "$GENOME"/scripts/*; do
  [ -f "$f" ] || continue
  name=$(basename "$f")
  case "$name" in *.md|.gitkeep|*.example) continue ;; esac
  # a tool's OWN default-declared state slug: the literal `.mesh/.slug.state` / `.mesh/.slug-state`
  # path in its `STATE="${X_STATE:-$HOME/.mesh/.slug-state}"`-style default (see umwelt_slug).
  slug=$(umwelt_slug "$f")
  [ -z "$slug" ] && continue
  grep -Eq '^#[[:space:]]*umwelt-ok:' "$f" 2>/dev/null && continue
  # READER SCAN RUNS ON THE COMMENT-STRIPPED CORPUS, not the raw files. It used to grep the raw
  # tree, so a state path merely NAMED in someone's comment counted as a reader — and this very
  # block proved it: documenting `.diskio-state` and `.wifi-quality-state` in the comment above (the
  # two dead vehicles the review verified BY HAND) made mesh-doctor itself their "reader" and
  # silenced both. A comment is not a channel; only the invoke scan was stripped, and one corpus
  # must serve both.
  hit=$(grep -lF "$slug" "$UM_STRIP"/* 2>/dev/null | grep -vFx "$UM_STRIP/$name")
  if [ -z "$hit" ]; then
    re_name=$(printf '%s' "$name" | sed 's/[.[]/\\&/g')
    tok="(^|[^A-Za-z0-9_-])${re_name}([^A-Za-z0-9_-]|$)"
    # SAME pipefail+SIGPIPE trap as the orphan check (see invoked_by_other): this site read
    # `grep -l | grep -Fxqv ... || umwelt_orphans=...`, so a 141 from the killed upstream took the
    # ||-branch and booked a WIDELY-INVOKED tool as an umwelt gap. One definition, both call sites.
    if ! invoked_by_other "$name" "$UM_STRIP" "$tok"; then
      if um_self_reads "$f" "$slug"; then umwelt_self="$umwelt_self $name"
      else umwelt_orphans="$umwelt_orphans $name"; fi
    fi
  fi
done
rm -rf "$UM_STRIP"
n_self=$(echo $umwelt_self | wc -w)
self_note=""
[ "$n_self" -gt 0 ] && self_note=" (+$n_self self-consuming — temporal interpretant, not flagged)"

# Same 2-consecutive-check debounce + delta-only emission as the orphan check above (a stable
# backlog must not re-dump every run and false-fire NEW-WARN detectors like mesh-tick).
UMWELT_STATE="$HOME/.mesh/.doctor-umwelt-state"
prev_umwelt=""; [ -f "$UMWELT_STATE" ] && prev_umwelt=$(cat "$UMWELT_STATE" 2>/dev/null || echo "")
curr_uset=$(printf '%s\n' $umwelt_orphans | sort -u | tr '\n' ' ')
prev_uset=$(printf '%s\n' $prev_umwelt | sort -u | tr '\n' ' ')
printf '%s\n' $umwelt_orphans | sort -u > "$UMWELT_STATE" 2>/dev/null
confirmed_umwelt=""
for o in $curr_uset; do
  case " $prev_uset " in *" $o "*) confirmed_umwelt="$confirmed_umwelt $o" ;; esac
done
UMWELT_EMITTED="$HOME/.mesh/.doctor-umwelt-emitted"
if [ -z "$confirmed_umwelt" ]; then
  [ -z "$curr_uset" ] && pass "0 dead sign-vehicles — every state producer has an interpretant$self_note" || pass "0 persistent dead sign-vehicles — transient ($curr_uset) not confirmed across 2 checks$self_note"
  : > "$UMWELT_EMITTED" 2>/dev/null
else
  conf_uset=$(printf '%s\n' $confirmed_umwelt | sort -u | tr '\n' ' ')
  emitted_uset=""; [ -f "$UMWELT_EMITTED" ] && emitted_uset=$(tr '\n' ' ' < "$UMWELT_EMITTED" 2>/dev/null)
  new_umwelt=""; for o in $conf_uset; do case " $emitted_uset " in *" $o "*) ;; *) new_umwelt="$new_umwelt $o";; esac; done
  gone_umwelt=""; for o in $emitted_uset; do case " $conf_uset " in *" $o "*) ;; *) gone_umwelt="$gone_umwelt $o";; esac; done
  nu=$(echo $conf_uset | wc -w)
  _capu(){ local c; c=$(echo $1 | wc -w); [ "$c" -gt 8 ] && echo "$c" || echo "${1# }"; }
  if [ -n "${new_umwelt// /}" ] || [ -n "${gone_umwelt// /}" ]; then
    ud=""
    [ -n "${new_umwelt// /}" ]  && ud="$ud +new:$(_capu "$new_umwelt")"
    [ -n "${gone_umwelt// /}" ] && ud="$ud -resolved:$(_capu "$gone_umwelt")"
    warn "dead sign-vehicles: $nu state producer(s) — no reader, no invoker, no self-consumption — confirmed 2+ checks —$ud$self_note (full list: cat ~/.mesh/.doctor-umwelt-state)"
  else
    warn "dead sign-vehicles: $nu state producer(s) — no reader, no invoker, no self-consumption — confirmed 2+ checks (stable)$self_note — full list: cat ~/.mesh/.doctor-umwelt-state"
  fi
  printf '%s\n' $conf_uset | tr ' ' '\n' | grep -v '^$' > "$UMWELT_EMITTED" 2>/dev/null
fi

hdr "inverse-orphan check (cron/supervise-wired tools that are MISSING from genome scripts/)"
tmp_inv="$(mktemp)"; trap 'rm -f "$tmp_inv"' EXIT
{
  crontab -l 2>/dev/null | grep -oP '(?<=/bin/)mesh-[-a-z0-9]+' || true
  [ -f ~/.mesh/supervise.list ] && awk -F'|' '{gsub(/^[ \t]+|[ \t]+$/,"",$3); print $3}' ~/.mesh/supervise.list 2>/dev/null | grep -oP 'mesh-[-a-z0-9]+' || true
} | sort -u | while read -r tool; do
  [ -z "$tool" ] && continue
  [ -f "$GENOME/scripts/$tool" ] || echo "$tool"
done > "$tmp_inv"
inv_orphans=$(tr '\n' ' ' < "$tmp_inv")
if [ -z "${inv_orphans// /}" ]; then
  pass "0 inverse-orphans — every wired tool exists in genome"
else
  for o in $inv_orphans; do warn "inverse-orphan: $o (wired but UNGENOMED — a fresh plant runs its cron with no tool)"; done
fi

hdr "genome topology-clean (no hardcoded tailnet IPs — plantability)"
TOPOLOGY_LEAK=""
# the documented placeholder IPs (from nodes.example) are NOT leaks — they're the generic examples
# tools/tests reference on purpose. Build the allowlist from nodes.example so it stays in sync.
EXAMPLE_IPS="$(grep -oE '100\.[0-9]+\.[0-9]+\.[0-9]+' "$GENOME/nodes.example" 2>/dev/null | sort -u | tr '\n' '|' | sed 's/|$//')"
for f in "$GENOME"/scripts/*; do
  [ -f "$f" ] || continue
  b=$(basename "$f")
  # chaos tools INTENTIONALLY plant a CGNAT IP to verify this very guard fires — exempt them
  # (a chaos drill that tests a guard must contain the pattern the guard catches). mesh-sessions is
  # the same class: it's the remote-login SOURCE classifier, so its --test MUST embed CGNAT IPs
  # spanning the 100.64–100.127 boundary to prove classify_src maps the whole Tailscale range to MESH
  # (and 100.63/100.128 to FOREIGN) — those fixtures are the contract, not a runtime topology leak.
  case "$b" in mesh-peer-addr|nodes.example|mesh-chaos-doctor|mesh-chaos-verify|mesh-sessions) continue ;; esac
  # ONE grep per file (not a bash line-loop) — replaces O(N×lines) subprocess forks with O(N).
  # The bash while-read-printf-grep loop took ~86s for 205 scripts (2026-06-15).
  # PCRE lookbehind/lookahead:
  #   (?<!@)      — exclude user@ip (@ immediately before the IP)
  #   (?!\d|/\d)  — exclude CIDR (ip/NN) and prevent backtrack to shorter last-octet
  #                 (without this, [0-9]+ on '56/24' backtracks to '5', making lookahead pass)
  # Post-filter: drop X.X.0.0 network bases and documented example IPs.
  # Strip full-comment lines first: an IP in a `#` comment (e.g. mesh-room-sense documenting WHY it
  # deliberately does NOT use a resolved Tailscale IP) is documentation, never a runtime dependency.
  # Only `^[[:space:]]*#` lines are dropped, so a trailing comment on a real code line still trips.
  ip=$(grep -vE '^[[:space:]]*#' "$f" 2>/dev/null \
    | grep -oP '(?<!@)100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\.[0-9]+\.[0-9]+(?!\d|/\d)' 2>/dev/null \
    | grep -v '\.0\.0$' \
    | { [ -n "$EXAMPLE_IPS" ] && grep -vxE "$EXAMPLE_IPS" || cat; } \
    | head -1)
  [ -n "$ip" ] && TOPOLOGY_LEAK="$TOPOLOGY_LEAK $b:$ip"
done
if [ -z "$TOPOLOGY_LEAK" ]; then
  pass "0 topology leaks — no hardcoded tailnet IPs in scripts/"
else
  for leak in $TOPOLOGY_LEAK; do warn "topology leak: $leak (hardcoded IP — use env var / config instead)"; done
fi

hdr "exec-bit guard (shebang present → must be executable)"
GENOME="${MESH_GENOME:-$HOME/lte-workstation}"
# LANDMINES only: committed (git-tracked) genome sources + ANY deployed ~/.local/bin tool. An untracked WIP
# source in scripts/ is mid-dev and must NOT hard-FAIL/page (chat-review/doctor-execbit-fails-on-untracked-
# source) — the source-exec-gate WARN above still surfaces it. Scoping lives in exec_bit_landmines() so --test
# drives the tracked/untracked split against fixtures. (node-join-*/test-* still covered — the glob is scripts/*.)
exec_fail="$(exec_bit_landmines "$GENOME" "$HOME/.local/bin")"
[ -z "$exec_fail" ] && pass "all shebang scripts are executable" || fail "NOT EXECUTABLE (shebang but no +x):$exec_fail"

hdr "systemd failed-units (crashed .service/.timer — logind/run scope noise filtered)"
# (chat-review/wire-systemd-failed-units, knowledge/capability-systemd-failed-units-20260704.md): systemd's
# own failed-unit ledger is a software-health axis no other check reads — a crashed service/timer would be
# invisible mesh-wide otherwise. Fail-open (NOTE, not FAIL/WARN) on a non-systemd node.
if command -v systemctl >/dev/null 2>&1; then
  sd_sys="$(systemctl --failed --no-legend 2>/dev/null | awk '{print $2}' | filter_failed_units)"
  sd_usr="$(systemctl --user --failed --no-legend 2>/dev/null | awk '{print $2}' | filter_failed_units)"
  sd_real="$(printf '%s\n%s\n' "$sd_sys" "$sd_usr" | sed '/^$/d')"
  if [ -z "$sd_real" ]; then
    pass "0 real failed systemd units (session/run scopes filtered)"
  else
    fail "systemd unit(s) FAILED: $(printf '%s' "$sd_real" | tr '\n' ' ' | cut -c1-160)"
  fi
else
  note "systemd not present on this node — failed-units check n/a"
fi

hdr "local-mind failover (geo-block+quota-immune inference reachable?)"
# The mesh's failover mind (qwen on the shared host) must stay reachable or a future geo-block/quota
# outage has NO fallback — discovered only at the worst time. Check the SAME transport mesh-local-mind
# uses: this node's local ollama, else SSH to the shared host's localhost API. ConnectTimeout'd so it
# can't hang doctor. WARN not FAIL — it's resilience, not the primary path (absence = degradation).
lm_where=""
if curl -sf -m4 http://localhost:11434/api/tags 2>/dev/null | grep -q '"name"'; then
  lm_where="local"
else
  lm_peer="$(mesh-peer-addr default-string 2>/dev/null || mesh-peer-addr ds 2>/dev/null || true)"
  if [ -n "$lm_peer" ] && timeout 12 ssh -o BatchMode=yes -o ConnectTimeout=6 "${MESH_PEER_USER:-imozerov}@$lm_peer" 'curl -sf -m6 http://localhost:11434/api/tags' </dev/null 2>/dev/null | grep -q '"name"'; then
    lm_where="$lm_peer via SSH"
  fi
fi
[ -n "$lm_where" ] && pass "local-mind failover reachable ($lm_where)" \
  || warn "local-mind failover UNREACHABLE — a geo-block/quota outage would have NO fallback (check shared-host ollama + SSH)"

hdr "summary"
printf '%s%smesh-doctor: %d FAIL, %d WARN\n' "$RUN_TS" "${RUN_TS:+  }" "$FAIL" "$WARN"
# cron mode: EDGE-TRIGGERED board alerts — post only on a STATE CHANGE, never re-spam an unchanged
# state. A FAIL that self-resolves now posts a RECOVERED signal, so the board never strands a stale
# "[doctor] N FAIL" with no resolution — which made a verify stream wrongly conclude a fixed FAIL
# "was not addressed" (2026-06-12). New/changed FAIL → alert; FAIL→0 → recovered; steady → silent.
# Latest-only snapshot for the health pane + self-feed to read cheaply (no re-run): current
# FAIL/WARN counts + the named failing checks, one per line. Overwritten each run (not appended),
# so its mtime = last-run (liveness) and its body = current verdict — the doctor analogue of the
# senses .state files the sensorium roll-call reads.
if [ "$CRON" = 1 ]; then
  { printf '%s FAIL=%s WARN=%s\n' "$(date -u +%FT%TZ)" "$FAIL" "$WARN"
    [ -n "$FAILS" ] && printf '%s\n' "$FAILS" | tr ';' '\n' | sed 's/^ *//;/^$/d'
  } > "$HOME/.mesh/.doctor-fails" 2>/dev/null || true
fi
if [ "$CRON" = 1 ] && command -v mesh-chat >/dev/null 2>&1; then
  state="$HOME/.mesh/.doctor-cron-state"
  last=$(cat "$state" 2>/dev/null); case "$last" in ''|*[!0-9]*) last=0;; esac
  if [ "$FAIL" != "$last" ]; then
    if [ "$FAIL" -gt 0 ]; then
      # Name the failing checks INLINE on the board (not just a count) so a board-reading mind can act
      # without an SSH round-trip to re-run mesh-doctor (chat-review/doctor-inline-fails 2026-06-15).
      MESH_WHO="doctor@$(hostname)" mesh-chat "[doctor] $FAIL FAIL, $WARN WARN — $(printf '%s' "$FAILS" | cut -c1-200) — mesh UP-but-BROKEN; run 'mesh-doctor' for full detail." >/dev/null 2>&1
      # ALSO alert the away operator's phone (roadmap #3 "health→phone on FAIL"). Edge-triggered (this
      # whole block fires only on a state change), flake-guarded upstream → no spam. Names the checks.
      command -v mesh-tg >/dev/null 2>&1 && mesh-tg "🚨 mesh-doctor ($(hostname)): $FAIL FAIL — mesh UP but BROKEN. $(printf '%s' "$FAILS" | cut -c1-220). Run mesh-doctor." >/dev/null 2>&1
    elif [ "$last" -gt 0 ]; then
      MESH_WHO="doctor@$(hostname)" mesh-chat "[doctor] RECOVERED — 0 FAIL (was $last); $WARN WARN remain (n/a capabilities, not broken)." >/dev/null 2>&1
      command -v mesh-tg >/dev/null 2>&1 && mesh-tg "✅ mesh-doctor ($(hostname)): RECOVERED — 0 FAIL (was $last)." >/dev/null 2>&1
    fi
    echo "$FAIL" > "$state" 2>/dev/null || true
  fi
fi
exit "$FAIL"
