#!/usr/bin/env bash
# mesh-budget — ONE ceiling surface for the whole node's spend, written as a REFUSAL, not a report
# (operator 2026-08-21: «имеет смысл ставить какой-то бюджет на вообще всё, задача потратить минимум»).
#
# THREE AXES, and they were in THREE different states when this was written (measured 2026-08-21, the
# reason the shape below is delegate-two-build-one rather than three new ceilings):
#
#   frames  — NOTHING counted them. `grep -rlniE 'frames_per_hour|frame_count|MAX_FRAMES' scripts/`
#             returned zero. Five openers (mesh-bruno-watch/mesh-eye/mesh-light/mesh-misha-wake via
#             mesh-cam-lock, plus mesh-cam-watch/mesh-imac-cam/mesh-phone-capture) each carry their OWN
#             cooldown, which bounds one organ's cadence and says nothing about the AGGREGATE. The only
#             honest ceiling in the mesh was IMAC_CAM_COOLDOWN=450s, set after 45s ate a day of Groq in
#             2.4h — a per-organ knob standing in for a node budget. THIS TOOL COUNTS AND CAPS IT.
#   gpu     — counted, but only CUMULATIVELY: mesh-gpu-ledger reads the driver's post-mortem accounting
#             ring (total ms since the mode was enabled). A cumulative counter is not a rate, and the
#             ring EVICTS (~4000 entries) so it also goes DOWN. THIS TOOL SAMPLES IT AND DELTAS THE
#             WINDOW (reset ⇒ that interval is unknown, never a fabricated 0 — see BLINDNESS below).
#   paid    — ALREADY CAPPED, and better than this task's wording assumed. MESH_LABOR_BUDGET_USD=900 per
#             rolling 5h is armed in ~/.mesh/restore.env; mesh-labor prices the window ($510.39/$900 =
#             57% at the moment of writing) and mesh-pace's hard-$-cap branch HOLDS every paced lane
#             when spent>=cap, with a double-entry decision ledger and a fail-open discipline. So this
#             tool DOES NOT MINT A SECOND PAID CEILING — a second authority over one axis in a second
#             unit is the two-copies-rot trap, and the one that bites is whichever is consulted first.
#             The paid axis here is a READ-THROUGH: we render and gate on THEIR number, never our own.
#             mesh-labor --propose-cap stays the way that cap is revised. (Its turn-denominated caps,
#             MESH_LABOR_BUDGET_TURNS / _WINDOW_BUDGET_TURNS, exist and are deliberately unset.)
#
# A BUDGET IS A REFUSAL. --gate is the whole point; --status is only so a human can see it. The refusal
# is LOUD and NAMES THREE THINGS: its own word, what did not happen, and the arithmetic that stopped it:
#
#   mesh-budget: REFUSED UNSHOT — did not shoot a frame for 'bruno-watch': frames 41/40 in the last 1h
#                (cap FRAMES_PER_HOUR in ~/.mesh/budget.conf)
#
# ONE WORD PER AXIS, so a log grep says WHICH ceiling bit without parsing prose: UNSHOT (frames) ·
# UNSPUN (gpu) · UNASKED (paid). The words are asserted DISTINCT in --test — a shared word would make
# three ceilings indistinguishable in exactly the artifact you would read to tune them.
#
# THE CAPS SHIP UNSET, ON PURPOSE (operator: «цифры назначать только после суток измерения — потолок
# раньше измерения это гадание»). An unset cap renders `unset(measuring Xh/24h)` and the gate ALLOWS.
# It never renders as ∞ and never invents a number. --propose REFUSES to propose until 24h of coverage
# exists, then prints a measured proposal for the OPERATOR to arm — it does not arm anything itself.
#
# BLINDNESS IS NOT ZERO, AND FAIL-OPEN IS NOT SILENT. An accumulator that cannot testify renders `na`,
# never 0 (a 0 from a broken meter is a fabricated calm, and on a BUDGET it would read as "spend
# nothing yet" — the most expensive possible lie). The gate then ALLOWS (a budget that wedges the node
# when its own meter breaks is worse than no budget) but says so on stderr and books a `blind` row, so
# the fail-open is rare and LOUD rather than a plausible constant.
#
#   mesh-budget                       status: spent BESIDE cap, all three axes
#   mesh-budget --gate <axis> [--why TAG] [--cost N]
#                                     rc 0 = allow (silent; a frames grant is RECORDED), rc 3 = REFUSED
#   mesh-budget --spend frames [N] [--why TAG]   record consumption without asking (post-hoc counting)
#   mesh-budget --sample              cron: book the gpu cumulative counter so the window can be delta'd
#   mesh-budget --propose             measured cap proposals; REFUSES before 24h of coverage
#   mesh-budget --dash                compact block for a data pane
#   mesh-budget --json                machine-readable
#   mesh-budget --test                RED-first
#
# Env: MESH_DIR · MESH_BUDGET_CONF · MESH_BUDGET_LOG · MESH_BUDGET_GPU_BIN (default mesh-gpu-ledger)
#      MESH_BUDGET_LABOR_BIN (default mesh-labor) · MESH_BUDGET_FRAMES_PER_HOUR · MESH_BUDGET_GPU_MIN_PER_DAY
#      MESH_BUDGET_NOW (ISO, --test only)
#
# reflex-cadence: 3-59/5 * * * *
# reflex-args: --sample
set -uo pipefail
# HOME is resolved BEFORE it is used: `set -u` + an env with no HOME (a bare `exec -c`, some service
# managers) killed this at the PATH line, one line above its own fallback.
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
export PATH="$HOME/.local/bin:$PATH"
MESH="${MESH_DIR:-$HOME/.mesh}"
CONF="${MESH_BUDGET_CONF:-$MESH/budget.conf}"
# The LEDGER is deliberately NOT ~/.mesh/budget.log: mesh-autowire redirects a wired reflex's stdout to
# $HOME/.mesh/<tool>.log, so a ledger under that name would have every cron run's chatter appended into
# the very tape the delta walk parses — the run-log and the artifact must not be one file.
LOG="${MESH_BUDGET_LOG:-$MESH/budget-ledger.log}"
GPU_BIN="${MESH_BUDGET_GPU_BIN:-mesh-gpu-ledger}"
LABOR_BIN="${MESH_BUDGET_LABOR_BIN:-mesh-labor}"
LOG_MAX=200000; LOG_KEEP=100000

ts(){ echo "${MESH_BUDGET_NOW:-$(date -u +%Y-%m-%dT%H:%M:%SZ)}"; }
# window start as an ISO string — ISO-8601 UTC sorts lexicographically, so no epoch math is needed.
win_start(){ # <seconds>
  local now; now="$(ts)"
  date -u -d "$now - $1 seconds" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null \
    || date -u -r $(( $(date -u -d "$now" +%s 2>/dev/null || date -u +%s) - $1 )) +%Y-%m-%dT%H:%M:%SZ
}
iso2epoch(){ date -u -d "$1" +%s 2>/dev/null || echo 0; }

# ---- axis table (the one place a word, a window and a verb are bound together) -----------------
axis_window(){ case "$1" in frames) echo 3600;; gpu) echo 86400;; paid) echo 18000;; *) echo 0;; esac; }
axis_unit(){   case "$1" in frames) echo frame;;  gpu) echo gpu-min;; paid) echo usd;;   *) echo unit;; esac; }
axis_word(){   case "$1" in frames) echo UNSHOT;; gpu) echo UNSPUN;; paid) echo UNASKED;; *) echo UNBUDGETED;; esac; }
axis_verb(){   case "$1" in
  frames) echo "did not shoot a frame";;
  gpu)    echo "did not run the GPU job";;
  paid)   echo "did not spend a paid mind turn";;
  *)      echo "did not act";; esac; }
axis_capsrc(){ case "$1" in
  frames) echo "FRAMES_PER_HOUR in $CONF";;
  gpu)    echo "GPU_MIN_PER_DAY in $CONF";;
  paid)   echo "MESH_LABOR_BUDGET_USD (mesh-labor/mesh-pace — NOT ours)";;
  *)      echo "unknown";; esac; }

conf_get(){ # <KEY> -> value or empty. grep-parsed, never sourced.
  [ -f "$CONF" ] || return 0
  sed -n "s/^[[:space:]]*$1=[\"']*\([0-9.]*\)[\"']*.*/\1/p" "$CONF" | tail -1
}
ensure_conf(){
  [ -f "$CONF" ] && return 0
  mkdir -p "$MESH" 2>/dev/null
  cat > "$CONF" <<'EOC'
# mesh-budget caps. UNSET = still measuring; the gate allows and says so. NEVER guess a number here:
# run `mesh-budget --propose` after 24h of coverage and arm what it measured (operator 2026-08-21:
# «цифры назначать только после суток измерения — потолок раньше измерения это гадание»).
# The PAID axis is deliberately absent from this file: its cap is MESH_LABOR_BUDGET_USD in
# ~/.mesh/restore.env, enforced by mesh-pace. Adding it here would mint a second authority.
FRAMES_PER_HOUR=
GPU_MIN_PER_DAY=
EOC
}

# cap for an axis. echoes the number, or empty when unset. paid delegates (handled in spend_paid).
axis_cap(){
  case "$1" in
    frames) [ -n "${MESH_BUDGET_FRAMES_PER_HOUR:-}" ] && { echo "$MESH_BUDGET_FRAMES_PER_HOUR"; return; }; conf_get FRAMES_PER_HOUR ;;
    gpu)    [ -n "${MESH_BUDGET_GPU_MIN_PER_DAY:-}" ] && { echo "$MESH_BUDGET_GPU_MIN_PER_DAY"; return; }; conf_get GPU_MIN_PER_DAY ;;
    paid)   echo "" ;;
  esac
}

book(){ # <row...>  append one ledger row
  mkdir -p "$MESH" 2>/dev/null
  printf '%s %s\n' "$(ts)" "$*" >> "$LOG"
  local n; n="$(wc -l < "$LOG" 2>/dev/null || echo 0)"
  if [ "$n" -gt "$LOG_MAX" ] 2>/dev/null; then tail -n "$LOG_KEEP" "$LOG" > "$LOG.tmp" && mv -f "$LOG.tmp" "$LOG"; fi
}

# ---- accumulators. Each echoes "<spent> <coverage_h> <note>"; rc 0 = counted, 2 = BLIND ----------
spend_frames(){
  local start; start="$(win_start 3600)"
  [ -f "$LOG" ] || { echo "0 0 no-ledger-yet"; return 0; }   # no grants booked = genuinely none taken
  awk -v s="$start" -v now="$(ts)" '
    $2=="grant" && $3=="axis=frames" && $1>=s { c=split($0,f," "); for(i=1;i<=c;i++) if(f[i]~/^cost=/){split(f[i],g,"=");n+=g[2]+0} }
    NR==1 { first=$1 }
    END{ note = (first>s) ? "LOWER BOUND (mesh-cam-lock openers only); ledger starts " first : "LOWER BOUND: counts only captures routed through mesh-cam-lock"
         printf "%d %s %s\n", n+0, "full", note }' "$LOG"
}
# WHY A LOWER BOUND, SAID OUT LOUD: mesh-cam-lock is the chokepoint for the LOCAL device, and the four
# openers that use it (bruno-watch, eye, light, misha-wake) are counted exactly. mesh-cam-watch, the
# iMac camera and the phone cameras do NOT pass through it, so they are invisible here. A frames figure
# that did not say so would be read as the node's whole frame spend and would size the cap too low.
# Route a new opener through mesh-cam-lock, or have it call `mesh-budget --spend frames`, to be counted.
spend_gpu(){
  local start; start="$(win_start 86400)"
  [ -f "$LOG" ] || { echo "na 0 no-samples"; return 2; }
  # baseline = the last sample BEFORE the window, so the first partial interval is not silently dropped.
  # A DECREASE is the driver ring evicting: that interval's work is UNKNOWN — count 0 for it and flag
  # the reset, never a negative and never a fabricated total.
  local out; out="$(awk -v s="$start" '
    # KEY ON THE FIELD NAME, not merely on the row being a sample: this tape carries two sample kinds
    # (gpu_ms and paid_usd) and a blind split of field 3 read a 511.62 paid row as a GPU counter of 511,
    # then differenced it against the real 10.8M-ms counter and published 180.2 gpu-min derived from a
    # dollar figure. Caught by a LIVE read, not by the suite: every stub ledger held only one kind.
    $2=="sample" && $3 ~ /^gpu_ms=/ { split($3,a,"="); v=a[2]+0
      if($1 < s){ pre=v; prets=$1; next }
      if(havep){ if(v>=prev) sum+=v-prev; else resets++ }
      else if(pre!=""){ if(v>=pre) sum+=v-pre; else resets++; covfrom=s }
      else covfrom=$1
      prev=v; havep=1; n++
    }
    END{ if(n==0 && pre=="") { print "BLIND no-samples"; exit }
         # A DELTA NEEDS TWO POINTS. One in-window sample with no pre-window baseline is not "0 gpu-min
         # spent" — it is "we have not measured an interval yet", and printing 0 there is the fabricated
         # calm this whole tool is written against (it renders on the panel as a budget with room).
         if(pre=="" && n<2) { print "BLIND single-sample-cannot-delta"; exit }
         if(pre!="" && n<1) { print "BLIND no-in-window-sample"; exit }
         printf "%d %s %d\n", sum+0, covfrom, resets+0 }' "$LOG")"
  case "$out" in
    BLIND*) echo "na 0 ${out#BLIND }"; return 2 ;;
  esac
  local ms cf resets covh
  ms="$(echo "$out" | awk '{print $1}')"; cf="$(echo "$out" | awk '{print $2}')"; resets="$(echo "$out" | awk '{print $3}')"
  covh="$(awk -v a="$(iso2epoch "$cf")" -v b="$(iso2epoch "$(ts)")" 'BEGIN{ d=(b-a)/3600; if(d<0)d=0; printf "%.1f", d }')"
  awk -v ms="$ms" -v c="$covh" -v r="$resets" 'BEGIN{ printf "%.1f %s %s\n", ms/60000.0, c, (r>0? "ring-reset×" r " (those intervals uncounted)" : "ok") }'
}
# The paid meter is EXPENSIVE: `mesh-labor --json` measured 46.7s on this node (it prices the whole
# 5h token flow through the hledger journal). A gate that costs 47s is not a gate — mesh-cam-lock would
# pay it per frame. So the paid axis is read from the SAMPLED CACHE that --sample books on its cron, and
# the LEASE (900s) is deliberately 3x the sampler's cadence (5 min): a lease shorter than its producer's
# period goes stale between two healthy samples and manufactures blindness, exactly the false-negative
# this timeout already produced once. Past the lease the row is NOT served as current — it reads BLIND,
# because a stale $-figure presented as the live one is the fabricated-calm shape on the costliest axis.
PAID_TTL="${MESH_BUDGET_PAID_TTL:-900}"
spend_paid_live(){ # the real meter call. Slow by nature — only --sample and --test pay it.
  # CRON DOES NOT SOURCE restore.env. The armed cap lives there as MESH_LABOR_BUDGET_USD, so the
  # SAMPLER (a cron reflex) saw no cap and booked `paid_cap=unset` while an interactive run of the same
  # command booked `paid_cap=900` — the panel then flipped between "57% of $900" and "report-only" every
  # 5 minutes, i.e. the ceiling DISAPPEARED from the budget on the sampler's cadence. Seen live in the
  # ledger (08:34 cap=900 · 08:38 cap=unset). Resolve it the way mesh-pace does, but narrowly: import
  # only this one knob, and only when the environment did not already carry it, so a caller (or --test)
  # that sets it explicitly still wins and nothing else from restore.env leaks into this process.
  if [ -z "${MESH_LABOR_BUDGET_USD:-}" ] && [ -f "$HOME/.mesh/restore.env" ]; then
    local _cap; _cap="$(sed -n 's/^[[:space:]]*export[[:space:]]*MESH_LABOR_BUDGET_USD=["'"'"']*\([0-9.]*\).*/\1/p' "$HOME/.mesh/restore.env" | tail -1)"
    [ -n "$_cap" ] && export MESH_LABOR_BUDGET_USD="$_cap"
  fi
  local j; j="$(timeout 120 "$LABOR_BIN" --json 2>/dev/null)"
  local sp cp st
  sp="$(printf '%s' "$j" | sed -n 's/.*"spent":\([0-9.]*\).*/\1/p')"
  cp="$(printf '%s' "$j" | sed -n 's/.*"cap":\([0-9.]*\).*/\1/p')"
  st="$(printf '%s' "$j" | sed -n 's/.*"state":"\([a-z-]*\)".*/\1/p')"
  [ -n "$sp" ] || { echo "na 0 labor-meter-unreadable"; return 2; }
  echo "$sp ${cp:-unset} ${st:-unknown}"
}
spend_paid(){ # READ-THROUGH the cache: mesh-labor owns this number AND its cap. We never store a cap.
  [ -f "$LOG" ] || { echo "na 0 no-paid-sample-yet"; return 2; }
  local row; row="$(grep ' sample paid_usd=' "$LOG" 2>/dev/null | tail -1)"
  [ -n "$row" ] || { echo "na 0 no-paid-sample-yet"; return 2; }
  local age; age=$(( $(iso2epoch "$(ts)") - $(iso2epoch "$(echo "$row" | awk '{print $1}')") ))
  if [ "$age" -gt "$PAID_TTL" ] 2>/dev/null; then echo "na 0 paid-sample-stale-${age}s>${PAID_TTL}s"; return 2; fi
  echo "$row" | sed -n 's/.*paid_usd=\([0-9.]*\) paid_cap=\([0-9.a-z]*\) paid_state=\([a-z-]*\).*/\1 \2 \3/p' \
    | grep -q . || { echo "na 0 paid-sample-unparseable"; return 2; }
  echo "$row" | sed -n 's/.*paid_usd=\([0-9.]*\) paid_cap=\([0-9.a-z]*\) paid_state=\([a-z-]*\).*/\1 \2 \3/p'
}

# ---- the gate ------------------------------------------------------------------------------------
do_gate(){
  local axis="${1:-}" why="unnamed" cost=1; shift || true
  while [ $# -gt 0 ]; do case "$1" in --why) why="${2:-unnamed}"; shift 2;; --cost) cost="${2:-1}"; shift 2;; *) shift;; esac; done
  case "$axis" in frames|gpu|paid) ;; *) echo "mesh-budget: unknown axis '$axis' (frames|gpu|paid)" >&2; return 2;; esac
  ensure_conf
  local word verb; word="$(axis_word "$axis")"; verb="$(axis_verb "$axis")"

  if [ "$axis" = paid ]; then
    local r sp cp st; r="$(spend_paid)"; local rc=$?
    sp="$(echo "$r" | awk '{print $1}')"; cp="$(echo "$r" | awk '{print $2}')"; st="$(echo "$r" | awk '{print $3}')"
    if [ "$rc" != 0 ]; then
      echo "mesh-budget: ALLOW BLIND paid — the labour meter could not testify ($st); NOT counted, NOT capped" >&2
      book "blind axis=paid why=$why reason=$st"; return 0
    fi
    case "$st" in over|OVER)
      echo "mesh-budget: REFUSED $word — $verb for '$why': paid \$$sp/\$$cp in the last 5h (cap $(axis_capsrc paid))" >&2
      book "refuse axis=paid word=$word why=$why spent=$sp cap=$cp"; return 3 ;;
    esac
    return 0
  fi

  local r spent covh note cap
  if [ "$axis" = frames ]; then r="$(spend_frames)"; else r="$(spend_gpu)"; fi
  local rc=$?
  spent="$(echo "$r" | awk '{print $1}')"; covh="$(echo "$r" | awk '{print $2}')"; note="$(echo "$r" | cut -d' ' -f3-)"
  if [ "$rc" != 0 ]; then
    echo "mesh-budget: ALLOW BLIND $axis — the accumulator could not testify ($note); spend reads na, NOT 0" >&2
    book "blind axis=$axis why=$why reason=$note"; return 0
  fi
  cap="$(axis_cap "$axis")"
  if [ -z "$cap" ]; then
    [ "$axis" = frames ] && book "grant axis=frames why=$why cost=$cost cap=unset spent=$spent"
    return 0
  fi
  if awk -v s="$spent" -v c="$cap" -v k="$cost" 'BEGIN{exit !(s+k > c)}'; then
    local w; w="$(axis_window "$axis")"
    echo "mesh-budget: REFUSED $word — $verb for '$why': $axis $spent/$cap in the last $((w/3600))h (cap $(axis_capsrc "$axis"))" >&2
    book "refuse axis=$axis word=$word why=$why spent=$spent cap=$cap cost=$cost"
    return 3
  fi
  [ "$axis" = frames ] && book "grant axis=frames why=$why cost=$cost cap=$cap spent=$spent"
  return 0
}

do_spend(){ # post-hoc record (an organ that took a frame without asking)
  local axis="${1:-frames}" n="${2:-1}" why="unnamed"; shift 2 2>/dev/null || shift $# 
  while [ $# -gt 0 ]; do case "$1" in --why) why="${2:-unnamed}"; shift 2;; *) shift;; esac; done
  case "$axis" in frames) ;; *) echo "mesh-budget: --spend only records the frames axis (gpu/paid have their own accumulators)" >&2; return 2;; esac
  case "$n" in ''|*[!0-9]*) why="$n"; n=1;; esac
  book "grant axis=frames why=$why cost=$n cap=$(axis_cap frames) spent=post-hoc"
}

do_sample(){
  local out ms
  out="$(timeout 60 "$GPU_BIN" --json 2>/dev/null)"
  ms="$(printf '%s' "$out" | sed -n 's/.*"total_ms":\([0-9]*\).*/\1/p')"
  # ONE BLIND AXIS MUST NOT BLIND THE OTHER. The first version returned here on an unreadable GPU
  # counter and never reached the paid sample — so a driver with accounting mode reset would have
  # silently stopped the $-cache too, and the paid axis would have aged past its lease and read BLIND
  # for a reason that had nothing to do with the labour meter. Book what each accumulator can testify
  # to, independently, and carry the worst rc out.
  local rc=0
  if [ -z "$ms" ]; then
    book "blind axis=gpu why=sample reason=$(printf '%s' "$out" | sed -n 's/.*"reason":"\([a-z-]*\)".*/\1/p' | head -1)-or-unreadable"
    echo "mesh-budget --sample: gpu accumulator UNREADABLE — booked a blind row (never a 0)" >&2
    rc=2
  else
    book "sample gpu_ms=$ms"
    echo "mesh-budget --sample: gpu_ms=$ms booked"
  fi
  do_sample_paid || rc=2
  return $rc
}
do_sample_paid(){
  local r rc; r="$(spend_paid_live)"; rc=$?
  if [ "$rc" != 0 ]; then
    book "blind axis=paid why=sample reason=$(echo "$r" | cut -d' ' -f3-)"
    echo "mesh-budget --sample: labour meter UNREADABLE — booked a blind row (never a \$0)" >&2
    return 2
  fi
  book "sample paid_usd=$(echo "$r" | awk '{print $1}') paid_cap=$(echo "$r" | awk '{print $2}') paid_state=$(echo "$r" | awk '{print $3}')"
  echo "mesh-budget --sample: paid=\$$(echo "$r" | awk '{print $1}')/\$$(echo "$r" | awk '{print $2}') booked"
}

fmt_axis(){ # <axis> -> "spent | cap | note"  (the panel line body)
  local axis="$1" r rc spent covh note cap
  if [ "$axis" = paid ]; then
    r="$(spend_paid)"; rc=$?
    if [ "$rc" != 0 ]; then printf 'na / na  (BLIND: %s)' "$(echo "$r" | cut -d' ' -f3-)"; return; fi
    local sp cp st; sp="$(echo "$r" | awk '{print $1}')"; cp="$(echo "$r" | awk '{print $2}')"; st="$(echo "$r" | awk '{print $3}')"
    if [ "$cp" = unset ] || [ "$cp" = 0 ]; then printf '$%s / unset (mesh-labor report-only)' "$sp"
    else printf '$%s / $%s  %s%%  [mesh-labor·mesh-pace enforce]' "$sp" "$cp" "$(awk -v a="$sp" -v b="$cp" 'BEGIN{printf "%.0f", (b>0? a*100/b : 0)}')"; fi
    return
  fi
  if [ "$axis" = frames ]; then r="$(spend_frames)"; else r="$(spend_gpu)"; fi
  rc=$?
  spent="$(echo "$r" | awk '{print $1}')"; covh="$(echo "$r" | awk '{print $2}')"; note="$(echo "$r" | cut -d' ' -f3-)"
  if [ "$rc" != 0 ]; then printf 'na / %s  (BLIND: %s — na, never 0)' "$(cap_render "$axis")" "$note"; return; fi
  printf '%s / %s%s' "$spent" "$(cap_render "$axis")" "$([ "$note" = ok ] || printf '  (%s)' "$note")"
}
cap_render(){
  local cap; cap="$(axis_cap "$1")"
  if [ -n "$cap" ]; then echo "$cap"; else echo "unset(measuring $(coverage_h "$1")h/24h)"; fi
}
coverage_h(){ # how long have we been measuring this axis at all
  [ -f "$LOG" ] || { echo 0.0; return; }
  local first; first="$(awk -v a="$1" '$2=="sample"||$2=="grant"||$2=="blind"{ if($3=="axis=" a || ($2=="sample" && a=="gpu")){print $1; exit} }' "$LOG")"
  [ -n "$first" ] || { echo 0.0; return; }
  awk -v a="$(iso2epoch "$first")" -v b="$(iso2epoch "$(ts)")" 'BEGIN{ d=(b-a)/3600; if(d<0)d=0; printf "%.1f", d }'
}

do_status(){
  ensure_conf
  echo "budget — a REFUSAL, not a report. cap BESIDE spend; each axis refuses in its own word."
  printf '  %-7s %-11s %-6s %s\n' AXIS WORD WINDOW 'SPENT / CAP'
  printf '  %-7s %-11s %-6s %s\n' frames UNSHOT 1h  "$(fmt_axis frames)"
  printf '  %-7s %-11s %-6s %s\n' gpu    UNSPUN 24h "$(fmt_axis gpu)"
  printf '  %-7s %-11s %-6s %s\n' paid   UNASKED 5h "$(fmt_axis paid)"
  # grep -c already PRINTS 0 when it matches nothing and exits 1; a `|| echo 0` on top of that emits a
  # second line and splits the summary across two rows (seen live).
  local nr; nr="$(grep -c ' refuse axis=' "$LOG" 2>/dev/null)"; nr="${nr:-0}"
  echo "  refusals booked: $nr · ledger $LOG · caps $CONF (paid's cap is mesh-labor's, not ours)"
}
do_dash(){
  printf 'frames %s · UNSHOT\n' "$(fmt_axis frames)"
  printf 'gpu    %s · UNSPUN\n' "$(fmt_axis gpu)"
  printf 'paid   %s · UNASKED\n' "$(fmt_axis paid)"
  local r; r="$(grep ' refuse axis=' "$LOG" 2>/dev/null | tail -1)"
  [ -n "$r" ] && printf 'last refusal: %s\n' "$r"
  return 0
}
do_json(){
  local f g p; f="$(spend_frames)"; g="$(spend_gpu)"; p="$(spend_paid)"
  printf '{"frames":{"spent":%s,"cap":"%s","word":"UNSHOT","window_h":1},' \
    "$(echo "$f" | awk '{print ($1=="na"?"null":$1)}')" "$(axis_cap frames)"
  printf '"gpu":{"spent":%s,"cap":"%s","word":"UNSPUN","window_h":24},' \
    "$(echo "$g" | awk '{print ($1=="na"?"null":$1)}')" "$(axis_cap gpu)"
  printf '"paid":{"spent":%s,"cap":"%s","word":"UNASKED","window_h":5,"authority":"mesh-labor"}}\n' \
    "$(echo "$p" | awk '{print ($1=="na"?"null":$1)}')" "$(echo "$p" | awk '{print $2}')"
}

do_propose(){
  ensure_conf
  echo "mesh-budget --propose — REPORT ONLY. Nothing is armed here; the operator arms $CONF."
  local a
  for a in frames gpu; do
    local cov; cov="$(coverage_h "$a")"
    if awk -v c="$cov" 'BEGIN{exit !(c < 24)}'; then
      echo "  $a: REFUSED to propose — only ${cov}h of 24h measured. A cap before measurement is a guess."
      continue
    fi
    if [ "$a" = frames ]; then
      # worst REAL hour observed, +20% headroom (mesh-labor --propose-cap's idiom, one pricer per axis)
      local mx; mx="$(awk '$2=="grant" && $3=="axis=frames"{ h=substr($1,1,13); c=0; n=split($0,f," ");
             for(i=1;i<=n;i++) if(f[i]~/^cost=/){split(f[i],g,"=");c=g[2]+0}; s[h]+=c }
           END{ for(k in s) if(s[k]>m) m=s[k]; print m+0 }' "$LOG")"
      echo "  frames: worst measured hour = $mx → FRAMES_PER_HOUR=$(awk -v m="$mx" 'BEGIN{printf "%d", int(m*1.2)+1}')  (max×1.2)"
    else
      local mx; mx="$(awk '$2=="sample" && $3 ~ /^gpu_ms=/ { d=substr($1,1,10); split($3,a,"="); v=a[2]+0
             if(prev!="" && v>=prev) s[d]+=v-prev; prev=v }
           END{ for(k in s) if(s[k]>m) m=s[k]; printf "%.1f", m/60000.0 }' "$LOG")"
      echo "  gpu: worst measured day = ${mx} gpu-min → GPU_MIN_PER_DAY=$(awk -v m="$mx" 'BEGIN{printf "%d", int(m*1.2)+1}')  (max×1.2)"
    fi
  done
  echo "  paid: NOT proposed here — that cap is MESH_LABOR_BUDGET_USD; use \`mesh-labor --propose-cap\`."
}

# ---- test -----------------------------------------------------------------------------------------
do_test(){
  local td; td="$(mktemp -d)"; trap 'rm -rf "$td"' RETURN
  local fail=0 o rc
  run(){ MESH_DIR="$td" MESH_BUDGET_CONF="$td/budget.conf" MESH_BUDGET_LOG="$td/budget.log" \
         MESH_BUDGET_GPU_BIN="$td/gpu" MESH_BUDGET_LABOR_BIN="$td/labor" "$@"; }
  cat > "$td/gpu" <<'EOF'
#!/usr/bin/env bash
[ -n "${GPU_MS:-}" ] && { echo "{\"status\":\"OK\",\"organs\":{},\"total_ms\":$GPU_MS}"; exit 0; }
echo '{"status":"UNKNOWN","reason":"empty-accounted-list-mode-reset"}'; exit 2
EOF
  cat > "$td/labor" <<'EOF'
#!/usr/bin/env bash
[ "${LABOR_BROKEN:-0}" = 1 ] && exit 1
# mirrors mesh-labor: the cap comes from MESH_LABOR_BUDGET_USD, and an UNSET knob emits no cap key
# at all (which is exactly how the live cron sample lost it).
cap="${LCAP:-${MESH_LABOR_BUDGET_USD:-}}"
if [ -n "$cap" ]; then echo "{\"window_h\":5,\"usd\":{\"spent\":${LSPENT:-10},\"cap\":$cap,\"state\":\"${LSTATE:-ok}\"},\"total\":48}"
else echo "{\"window_h\":5,\"usd\":{\"spent\":${LSPENT:-10},\"state\":\"${LSTATE:-ok}\"},\"total\":48}"; fi
EOF
  chmod +x "$td/gpu" "$td/labor"

  # GATE 1 — an UNSET cap ALLOWS and never invents a number. (A budget that guessed would be worse
  # than none: the operator's rule is measure-then-cap.)
  run bash "$0" --gate frames --why g1 >/dev/null 2>&1; rc=$?
  o="$(run bash "$0" --dash 2>/dev/null | head -1)"
  if [ "$rc" = 0 ] && printf '%s' "$o" | grep -q 'unset(measuring'; then
    echo "  ✓ GATE1 unset-cap: gate ALLOWS and renders unset(measuring …) — no invented ceiling"
  else echo "  ✗ GATE1 unset-cap: rc=$rc dash='$o'"; fail=1; fi

  # GATE 2 — RED: with a cap ARMED BELOW the spend, the gate REFUSES, exits 3, and the refusal NAMES
  # what did not happen + the arithmetic. (Break the cap → this goes green-when-it-should-be-red.)
  o="$(MESH_BUDGET_FRAMES_PER_HOUR=1 run bash "$0" --gate frames --why bruno-watch 2>&1)"; rc=$?
  if [ "$rc" = 3 ] && printf '%s' "$o" | grep -q 'REFUSED UNSHOT' \
     && printf '%s' "$o" | grep -q "did not shoot a frame for 'bruno-watch'" \
     && printf '%s' "$o" | grep -qE 'frames [0-9]+/1'; then
    echo "  ✓ GATE2 refusal: rc=3 + word + what-it-didn't-do + spent/cap  ($(printf '%s' "$o" | head -c 90)…)"
  else echo "  ✗ GATE2 refusal: rc=$rc out='$o'"; fail=1; fi

  # GATE 3 — a refusal that fires must not also be COUNTED as a grant (a refused frame was not taken).
  local before after
  before="$(grep -c 'grant axis=frames' "$td/budget.log" 2>/dev/null || echo 0)"
  MESH_BUDGET_FRAMES_PER_HOUR=1 run bash "$0" --gate frames --why g3 >/dev/null 2>&1
  after="$(grep -c 'grant axis=frames' "$td/budget.log" 2>/dev/null || echo 0)"
  if [ "$before" = "$after" ]; then echo "  ✓ GATE3 refused≠spent: a refusal books no grant (spend stays honest)"
  else echo "  ✗ GATE3 refused≠spent: grants $before→$after"; fail=1; fi

  # GATE 4 — the three words are DISTINCT (a shared word makes three ceilings one line in the log).
  local w1 w2 w3; w1="$(axis_word frames)"; w2="$(axis_word gpu)"; w3="$(axis_word paid)"
  if [ "$w1" != "$w2" ] && [ "$w2" != "$w3" ] && [ "$w1" != "$w3" ]; then
    echo "  ✓ GATE4 distinct words: $w1/$w2/$w3"
  else echo "  ✗ GATE4 distinct words: $w1/$w2/$w3 collide"; fail=1; fi

  # GATE 5 — BLIND accumulator ⇒ spend renders `na`, NEVER 0, the gate allows, and the fail-open is LOUD.
  o="$(run bash "$0" --gate gpu --why g5 2>&1)"; rc=$?
  local d j; d="$(run bash "$0" --dash 2>/dev/null | sed -n 2p)"
  # assert the ACCUMULATOR's own answer, not just the renderer's literal: --json carries the raw value,
  # so a spend_gpu that started returning 0-on-blind is caught here. (The dash line alone was NOT a gate
  # — fmt_axis prints the word "na" unconditionally on rc!=0, so a 0-returning accumulator survived it.)
  j="$(run bash "$0" --json 2>/dev/null)"
  if [ "$rc" = 0 ] && printf '%s' "$o" | grep -q 'ALLOW BLIND gpu' && printf '%s' "$d" | grep -q 'na /' \
     && printf '%s' "$j" | grep -q '"gpu":{"spent":null' && ! printf '%s' "$j" | grep -q '"gpu":{"spent":0'; then
    echo "  ✓ GATE5 blind≠zero: gpu with no samples reads na/null (never 0) in BOTH renderers, allows, and SAYS SO"
  else echo "  ✗ GATE5 blind≠zero: rc=$rc gate='$o' dash='$d' json='$j'"; fail=1; fi

  # GATE 6 — gpu window math: positive deltas SUM; a ring RESET (counter goes DOWN) contributes 0 and is
  #   FLAGGED, never a negative and never a fabricated total.
  : > "$td/budget.log"
  local n1 n2 n3
  n1="$(date -u -d '-90 minutes' +%Y-%m-%dT%H:%M:%SZ)"; n2="$(date -u -d '-60 minutes' +%Y-%m-%dT%H:%M:%SZ)"
  n3="$(date -u -d '-30 minutes' +%Y-%m-%dT%H:%M:%SZ)"
  { echo "$n1 sample gpu_ms=1000000"; echo "$n2 sample gpu_ms=1600000"; echo "$n3 sample gpu_ms=100000"; } > "$td/budget.log"
  o="$(run bash "$0" --dash 2>/dev/null | sed -n 2p)"
  # 600000ms = 10.0 gpu-min from the first delta; the reset interval adds nothing but must be named.
  if printf '%s' "$o" | grep -q '10\.0 /' && printf '%s' "$o" | grep -q 'ring-reset'; then
    echo "  ✓ GATE6 gpu-window: deltas summed (10.0 gpu-min), ring reset counted 0 AND flagged"
  else echo "  ✗ GATE6 gpu-window: got '$o'"; fail=1; fi

  # GATE 6b — ONE SAMPLE IS NOT A MEASUREMENT. A single in-window sample with no earlier baseline must
  #   read BLIND, not 0.0: a delta needs two points, and a 0 there renders on the panel as a budget with
  #   room to spend. (Found live: the tool's own first sample printed `gpu 0.0 / unset`.)
  : > "$td/budget.log"
  echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) sample gpu_ms=5000000" >> "$td/budget.log"
  o="$(run bash "$0" --json 2>/dev/null)"; d="$(run bash "$0" --dash 2>/dev/null | sed -n 2p)"
  if printf '%s' "$o" | grep -q '"gpu":{"spent":null' && printf '%s' "$d" | grep -q 'single-sample-cannot-delta'; then
    echo "  ✓ GATE6b one-sample≠zero: a lone sample reads BLIND (a delta needs two points)"
  else echo "  ✗ GATE6b one-sample≠zero: json='$o' dash='$d'"; fail=1; fi

  # GATE 6c — and TWO samples DO measure (so 6b is not passing because the axis is simply always blind).
  #   Written in CHRONOLOGICAL order: the ledger is an append tape and the delta walk trusts that order,
  #   so an out-of-order write reads as a counter going backwards (i.e. a ring reset).
  { echo "$(date -u -d '-10 minutes' +%Y-%m-%dT%H:%M:%SZ) sample gpu_ms=4400000"
    echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) sample gpu_ms=5000000"; } > "$td/budget.log"
  d="$(run bash "$0" --dash 2>/dev/null | sed -n 2p)"
  printf '%s' "$d" | grep -q '10\.0 /' \
    && echo "  ✓ GATE6c two-samples: the pair deltas to 10.0 gpu-min (6b is not vacuous)" \
    || { echo "  ✗ GATE6c two-samples: got '$d'"; fail=1; }

  # GATE 6e — TWO SAMPLE KINDS, ONE TAPE. A paid_usd row must never be read as a gpu counter. (Found
  #   live, not here: the suite's stub ledgers only ever held one kind, so the walk's blind split($3)
  #   looked correct until a real ledger interleaved a $511.62 paid row with the 10.8M-ms gpu counter
  #   and published 180.2 gpu-min derived from the dollars.)
  { echo "$(date -u -d '-20 minutes' +%Y-%m-%dT%H:%M:%SZ) sample gpu_ms=4400000"
    echo "$(date -u -d '-10 minutes' +%Y-%m-%dT%H:%M:%SZ) sample paid_usd=511.62 paid_cap=900 paid_state=ok"
    echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) sample gpu_ms=5000000"; } > "$td/budget.log"
  d="$(run bash "$0" --dash 2>/dev/null | sed -n 2p)"
  if printf '%s' "$d" | grep -q '10\.0 /' && ! printf '%s' "$d" | grep -q 'ring-reset'; then
    echo "  ✓ GATE6e mixed-tape: an interleaved paid row is ignored by the gpu walk (still 10.0 gpu-min)"
  else echo "  ✗ GATE6e mixed-tape: a paid row polluted the gpu delta — '$d'"; fail=1; fi

  # GATE 6d — the frames figure must DECLARE that it is a lower bound (it sees only mesh-cam-lock
  #   openers; a complete-looking number would size the cap too low).
  : > "$td/budget.log"; run bash "$0" --gate frames --why g6d >/dev/null 2>&1
  o="$(run bash "$0" --status 2>/dev/null)"
  if printf '%s' "$o" | grep -q 'LOWER BOUND'; then
    echo "  ✓ GATE6d frames-coverage: the count declares itself a lower bound, not the whole spend"
  else echo "  ✗ GATE6d frames-coverage: coverage caveat missing — status was: $(printf '%s' "$o" | sed -n 3p)"; fail=1; fi

  # GATE 7 — the PAID axis is a READ-THROUGH of mesh-labor's own numbers (via the sampled cache): an
  #   over-cap reading refuses UNASKED, and we never write a paid cap of our own into the conf.
  : > "$td/budget.log"
  echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) sample paid_usd=950 paid_cap=900 paid_state=over" >> "$td/budget.log"
  o="$(run bash "$0" --gate paid --why dispatch 2>&1)"; rc=$?
  if [ "$rc" = 3 ] && printf '%s' "$o" | grep -q 'REFUSED UNASKED' && printf '%s' "$o" | grep -q '950/\$900'; then
    echo "  ✓ GATE7a paid read-through: over-cap ⇒ REFUSED UNASKED on mesh-labor's own numbers"
  else echo "  ✗ GATE7a paid read-through: rc=$rc out='$o'"; fail=1; fi
  if grep -qiE '^[[:space:]]*(PAID|USD|MOVES)[A-Z_]*=' "$td/budget.conf" 2>/dev/null; then
    echo "  ✗ GATE7b one-authority: budget.conf minted a paid cap — that is mesh-labor's axis"; fail=1
  else echo "  ✓ GATE7b one-authority: no paid cap in budget.conf (MESH_LABOR_BUDGET_USD stays the only one)"; fi

  # GATE 8 — a BROKEN labour meter is BLIND, not \$0 (a 0 from a dead meter reads as 'spend nothing yet').
  : > "$td/budget.log"
  LABOR_BROKEN=1 run bash "$0" --sample >/dev/null 2>&1
  o="$(run bash "$0" --gate paid --why g8 2>&1)"; rc=$?
  if [ "$rc" = 0 ] && printf '%s' "$o" | grep -q 'ALLOW BLIND paid' && grep -q 'blind axis=paid' "$td/budget.log" \
     && ! grep -q 'paid_usd=0' "$td/budget.log"; then
    echo "  ✓ GATE8 meter-broken≠\$0: blind row booked, loud, fail-open (never a fabricated \$0)"
  else echo "  ✗ GATE8 meter-broken≠\$0: rc=$rc out='$o' log=$(cat "$td/budget.log")"; fail=1; fi

  # GATE 8b — THE LEASE. A cached reading OLDER than PAID_TTL is NOT served as the live one: a stale
  #   \$-figure wearing the current label is the fabricated-calm shape on the axis that costs money.
  #   (The lease is 900s = 3x the --sample cadence, so a healthy sampler never trips this.)
  : > "$td/budget.log"
  echo "$(date -u -d '-2 hours' +%Y-%m-%dT%H:%M:%SZ) sample paid_usd=10 paid_cap=900 paid_state=ok" >> "$td/budget.log"
  o="$(run bash "$0" --gate paid --why g8b 2>&1)"; rc=$?
  d="$(run bash "$0" --dash 2>/dev/null | sed -n 3p)"
  if [ "$rc" = 0 ] && printf '%s' "$o" | grep -q 'paid-sample-stale' && printf '%s' "$d" | grep -q 'na / na'; then
    echo "  ✓ GATE8b lease: a 2h-old paid sample reads BLIND, never as the current \$ figure"
  else echo "  ✗ GATE8b lease: rc=$rc gate='$o' dash='$d'"; fail=1; fi
  # and the same row INSIDE the lease is served (else the gate above would pass for the wrong reason)
  : > "$td/budget.log"
  echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) sample paid_usd=10 paid_cap=900 paid_state=ok" >> "$td/budget.log"
  d="$(run bash "$0" --dash 2>/dev/null | sed -n 3p)"
  printf '%s' "$d" | grep -q '\$10 / \$900' \
    && echo "  ✓ GATE8c lease: a fresh paid sample IS served (the stale gate above is not vacuous)" \
    || { echo "  ✗ GATE8c lease: fresh sample not served — '$d'"; fail=1; }

  # GATE 8d — CRON ENVIRONMENT. The armed cap lives in restore.env, which cron does not source; a
  #   sampler that loses it books `paid_cap=unset` and the ceiling vanishes from the panel on the
  #   sampler's own cadence (seen live). The knob must be resolved from the file when the env lacks it.
  #   Driven with `env -u` against a stub restore.env, so this asserts the RESOLUTION, not the node.
  : > "$td/budget.log"; mkdir -p "$td/home/.mesh"
  echo 'export MESH_LABOR_BUDGET_USD=777' > "$td/home/.mesh/restore.env"
  HOME="$td/home" MESH_DIR="$td" MESH_BUDGET_CONF="$td/budget.conf" MESH_BUDGET_LOG="$td/budget.log" \
    MESH_BUDGET_GPU_BIN="$td/gpu" MESH_BUDGET_LABOR_BIN="$td/labor" \
    env -u MESH_LABOR_BUDGET_USD bash "$0" --sample >/dev/null 2>&1
  if grep -q 'paid_cap=777' "$td/budget.log"; then
    echo "  ✓ GATE8d cron-env: the armed cap is resolved from restore.env when the environment lacks it"
  else echo "  ✗ GATE8d cron-env: cap lost under a cron-like env — $(grep paid_usd "$td/budget.log")"; fail=1; fi
  # GATE 8e — and note WHAT that run proved besides: the gpu stub above is BLIND, so this also asserts
  #   a blind gpu accumulator does not abort the sampler before it books the paid one (it did, at first).
  if grep -q 'blind axis=gpu' "$td/budget.log" && grep -q 'sample paid_usd=' "$td/budget.log"; then
    echo "  ✓ GATE8e independent-axes: a blind gpu counter still lets the paid meter be sampled"
  else echo "  ✗ GATE8e independent-axes: one blind axis blinded the other — $(cat "$td/budget.log")"; fail=1; fi

  # GATE 9 — --propose REFUSES before 24h of coverage (a cap earlier than the measurement is a guess).
  o="$(run bash "$0" --propose 2>&1)"
  if printf '%s' "$o" | grep -q 'REFUSED to propose' && printf '%s' "$o" | grep -q 'of 24h measured'; then
    echo "  ✓ GATE9 propose-gate: refuses to name a number before 24h of coverage"
  else echo "  ✗ GATE9 propose-gate: got '$o'"; fail=1; fi

  # GATE 10 — --sample against a BLIND gpu organ books a `blind` row, never `gpu_ms=0`.
  : > "$td/budget.log"
  run bash "$0" --sample >/dev/null 2>&1
  if grep -q 'blind axis=gpu' "$td/budget.log" && ! grep -q 'gpu_ms=0' "$td/budget.log"; then
    echo "  ✓ GATE10 sample-blind: unreadable organ books a blind row, not a zero sample"
  else echo "  ✗ GATE10 sample-blind: $(cat "$td/budget.log")"; fail=1; fi
  GPU_MS=4242 LSPENT=77 LCAP=900 LSTATE=ok run bash "$0" --sample >/dev/null 2>&1
  if grep -q 'sample gpu_ms=4242' "$td/budget.log" && grep -q 'sample paid_usd=77 paid_cap=900 paid_state=ok' "$td/budget.log"; then
    echo "  ✓ GATE10b sample-real: one sample books BOTH accumulators (gpu counter + paid meter)"
  else echo "  ✗ GATE10b sample-real: $(cat "$td/budget.log")"; fail=1; fi

  # GATE 11 — REAL READ, not a stub: this node's live labour meter must parse, else honest n/a (exit 2).
  local real; real="$(spend_paid_live)"; rc=$?
  if [ "$rc" = 0 ]; then
    echo "  ✓ GATE11 real-read: live mesh-labor parses — paid \$$(echo "$real" | awk '{print $1}')/\$$(echo "$real" | awk '{print $2}') ($(echo "$real" | awk '{print $3}'))"
  else
    echo "  ⚠ GATE11 real-read: no labour meter on this node — honest n/a (exit 2)"
    rm -rf "$td"; trap - RETURN
    [ "$fail" = 0 ] && exit 2 || { echo "mesh-budget --test: FAIL"; exit 1; }
  fi

  [ "$fail" = 0 ] && { echo "mesh-budget --test: PASS"; return 0; } || { echo "mesh-budget --test: FAIL"; return 1; }
}

case "${1:---status}" in
  --status|"") do_status ;;
  --gate)   shift; do_gate "$@" ;;
  --spend)  shift; do_spend "$@" ;;
  --sample) do_sample ;;
  --dash)   do_dash ;;
  --json)   do_json ;;
  --propose) do_propose ;;
  --test)   do_test ;;
  -h|--help) sed -n '1,60p' "$0" ;;
  *) echo "usage: mesh-budget [--status|--gate <axis>|--spend frames N|--sample|--dash|--json|--propose|--test]" >&2; exit 2 ;;
esac
