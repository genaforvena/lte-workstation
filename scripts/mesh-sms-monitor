#!/usr/bin/env bash
# mesh-sms-monitor — civil defense / emergency SMS sense reading the phone BODY (Redmi 10) OVER SSH.
# It runs FROM a mesh node (ssh -p 8022 u0_a380@$(mesh-phone-ip)), NOT on the phone — the parsing is
# python3, which the phone does not have. Do not re-classify it as a Termux-resident tool.
# reflex-cadence: 3-58/5 * * * *
# Polls termux-sms-list for new messages from government/emergency senders (RSCHS, 112)
# and posts [sms-alert] to the board. Offset-tracked on SMS _id so only new messages fire.
# Privacy: ONLY emergency senders are posted to board; personal/bank/operator SMS stay on phone.
#
#   mesh-sms-monitor        one poll pass (for cron wiring)
#   mesh-sms-monitor --test  smoke test: phone reachable + termux-sms-list available (exit 2=n/a)
#
# Wiring: */5 * * * * (5-min lag; CDS alerts are broadcast, not sub-minute critical)
# Exit: 0 = ok (new alerts posted or nothing new); 2 = phone unreachable / n/a
#
# Government/emergency senders tracked:
#   RSCHS  — Russian Civil Defense System (civil air/drone danger alerts, Nizhny region)
#   112    — emergency services broadcast
#   МЧС    — Ministry of Emergency Situations (Russian: Министерство чрезвычайных ситуаций)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes"

MESH="$HOME/.mesh"; mkdir -p "$MESH"
OFFSET="$MESH/.sms-monitor-last-id"
HOST="$(hostname)"
SMS_LIMIT="${MESH_SMS_MONITOR_LIMIT:-100}"

phone_ip(){ mesh-phone-ip 2>/dev/null || { echo "phone unreachable" >&2; exit 2; }; }
phone_ssh(){ ssh -p "${PHONE_SSH_PORT:-8022}" -o StrictHostKeyChecking=no -o ConnectTimeout=10 \
              "${PHONE_USER:-u0_a380}@$(phone_ip)" "$@" 2>/dev/null; }

if [ "${1:-}" = "--test" ]; then
  phone_ssh "echo ok" >/dev/null 2>&1 || { echo "smoke-test: n/a (phone unreachable)"; exit 2; }
  phone_ssh "command -v termux-sms-list >/dev/null 2>&1" \
    || { echo "smoke-test: FAIL (termux-sms-list not on phone)"; exit 1; }
  echo "smoke-test: ok (phone reachable, termux-sms-list available)"; exit 0
fi

# Fetch SMS list from phone (JSON array); parse on IdeaPad since phone has no python3
raw="$(phone_ssh "termux-sms-list -l ${SMS_LIMIT} 2>/dev/null")" || exit 2
[ -z "$raw" ] && exit 2

last_id=0
[ -f "$OFFSET" ] && last_id="$(cat "$OFFSET" 2>/dev/null || echo 0)"

# First run: seed offset silently (don't flood board with historical alerts)
if [ "$last_id" -eq 0 ]; then
  max_id="$(python3 -c "
import sys,json
try: d=json.load(sys.stdin); print(max((int(m.get('_id',0)) for m in d),default=0))
except: print(0)
" <<< "$raw" 2>/dev/null || echo 0)"
  printf '%s\n' "${max_id:-0}" > "$OFFSET"
  exit 0
fi

# Parse for new emergency-sender messages with _id > last_id
# python3 <(script) args <<< data: process substitution for script, here-string for data
# (python3 - args <<'EOF' <<< data is broken: last heredoc wins, JSON fed as source → NameError)
alerts="$(python3 <(cat <<'PYEOF'
import sys, json, re
last_id = int(sys.argv[1])
# Primary: named emergency sender. In practice (Nizhny region, 2026-06-15) all civil-defense
# alerts arrive with empty sender '' — sender-only filter was a no-op. Body-pattern is the
# real signal; sender match kept as forward-compat if carrier ever adds a named sender field.
GOV_RE = re.compile(r'^(RSCHS|112|МЧС|EMERCOM|ГО\s*ЧС|Civil\s*Defense)$', re.IGNORECASE)
# Body-pattern: civil defense alert keywords (drone-mode/warning/emergency). Anchored to avoid
# matching promotional SMS that happen to mention "внимание" (e.g. bank offers).
BODY_RE = re.compile(
    r'беспилотн|РСЧС|режим.*угроз|угроз.*режим|внимание.*территори|территори.*введен|'
    r'отменен.*режим|Civil\s*Defense|Emergency\s*Alert',
    re.IGNORECASE)
try: msgs = json.load(sys.stdin)
except: sys.exit(0)
for m in sorted(msgs, key=lambda x: int(x.get('_id',0))):
    mid = int(m.get('_id', 0))
    if mid <= last_id: continue
    addr = (m.get('address') or m.get('number') or '').strip()
    body = (m.get('body') or '').replace('\r','').replace('\n',' ')[:300]
    if not GOV_RE.match(addr) and not BODY_RE.search(body): continue
    rcv  = m.get('received','?')
    print(f"{mid}|{addr}|{rcv}|{body}")
PYEOF
) "$last_id" <<< "$raw")"

[ -z "$alerts" ] && exit 0

new_max="$last_id"
while IFS='|' read -r mid addr rcv body; do
  [ -n "$mid" ] || continue
  MESH_WHO="sms-monitor@${HOST}" mesh-chat "[sms-alert] $addr @ $rcv — $body" >/dev/null 2>&1 || true
  printf '%s  sms-monitor@%s  ::  [sms-alert] %s @ %s — %s\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$HOST" "$addr" "$rcv" "$body" >> "$MESH/traces.log" 2>/dev/null || true
  [ "$mid" -gt "$new_max" ] && new_max="$mid"
done <<< "$alerts"

[ "$new_max" -gt "$last_id" ] && printf '%s\n' "$new_max" > "$OFFSET"
exit 0
