#!/usr/bin/env bash
# mesh-usb — USB-ATTACH sense: what is PHYSICALLY plugged into this host's USB bus.
#   The USB host controller perceives device attach/removal — a real-world physical
#   signal (operator plugs in a phone, thumb drive, yubikey, audio dongle) that the
#   mesh was blind to. Complements mesh-lan-newdevice (LAN arrivals) and
#   mesh-presence (BLE proximity): a third arrival channel, the WIRED one.
#   Reads /sys/bus/usb/devices/*/{product,idVendor,idProduct,removable,speed},
#   EXCLUDES the controllers' own root hubs (Linux Foundation, vid 1d6b), and splits
#   real devices by the kernel's `removable` attribute into INTERNAL (fixed — soldered:
#   camera, fingerprint, builtin BT) vs PERIPHERAL (removable — the operator physically
#   attached it). Interface dirs (e.g. 1-5:1.0) carry no `product` file → ignored.
# HONEST: exit 2 (BLIND) when /sys/bus/usb is absent — a VM / container with no USB
#   passthrough cannot perceive the bus; we report BLIND, never a faked "0 devices /
#   all-clear" from an unreadable bus (the honest-exit contract: exit 2 = cannot
#   assess, never fabricated). A genuinely empty bus (dir present, no peripherals) is
#   a real exit-0 reading and is reported distinctly.
# orphan-ok: on-demand inventory query (like mesh-find / mesh-lan-newdevice's scan) —
#   pulled when asked or by a fusion consumer, not a scheduled reflex. Stateless
#   (no change-gated artifact), so no mesh-state-touch needed.
# Modes: (none) human read · --json · --list (STABLE machine interface: the raw TSV
#   <product>\t<vid:pid>\t<removable>\t<speed> lines — consumed by mesh-usb-events'
#   delta layer; treat the 4-column shape as a consumer contract) · --test
set -u

ROOT_HUB_VID="1d6b"   # Linux Foundation — the controllers' own root hubs, not peripherals

usb_dir() { echo "${MESH_USB_DIR:-/sys/bus/usb/devices}"; }

# scan_devices — emit one TSV line per real (non-root-hub) USB device:
#   <name>\t<vid:pid>\t<removable>\t<speed-mbps>
# Reads MESH_USB_DIR live so --test can point it at a fixture.
scan_devices() {
  local dir d prod vid pid rem spd
  dir="$(usb_dir)"
  for d in "$dir"/*/; do
    [ -e "$d/product" ] || continue            # only device nodes present a product string
    vid=$(cat "$d/idVendor" 2>/dev/null)
    [ "$vid" = "$ROOT_HUB_VID" ] && continue    # skip the controllers' own root hubs
    prod=$(cat "$d/product" 2>/dev/null)
    pid=$(cat "$d/idProduct" 2>/dev/null)
    rem=$(cat "$d/removable" 2>/dev/null); rem="${rem:-unknown}"
    spd=$(cat "$d/speed" 2>/dev/null)
    printf '%s\t%s:%s\t%s\t%s\n' "${prod:-?}" "$vid" "$pid" "$rem" "${spd:-?}"
  done
}

# --- portable logic self-test (no real USB bus needed: runs against a fixture) ----
if [ "${1:-}" = "--test" ]; then
  tmp=$(mktemp -d)
  # a removable peripheral
  mkdir -p "$tmp/2-1"; printf 'Kingston DataTraveler' >"$tmp/2-1/product"
  echo 0951 >"$tmp/2-1/idVendor"; echo 1666 >"$tmp/2-1/idProduct"
  echo removable >"$tmp/2-1/removable"; echo 5000 >"$tmp/2-1/speed"
  # a fixed internal device
  mkdir -p "$tmp/1-5"; printf 'Integrated Camera' >"$tmp/1-5/product"
  echo 174f >"$tmp/1-5/idVendor"; echo 118d >"$tmp/1-5/idProduct"
  echo fixed >"$tmp/1-5/removable"; echo 480 >"$tmp/1-5/speed"
  # a root hub (MUST be excluded)
  mkdir -p "$tmp/usb1"; printf 'xHCI Host Controller' >"$tmp/usb1/product"
  echo 1d6b >"$tmp/usb1/idVendor"; echo 0002 >"$tmp/usb1/idProduct"; echo unknown >"$tmp/usb1/removable"
  # an interface dir (no product → MUST be ignored)
  mkdir -p "$tmp/1-5:1.0"
  fail=""
  out=$(MESH_USB_DIR="$tmp" scan_devices)
  n=$(printf '%s\n' "$out" | grep -c .)
  [ "$n" = 2 ] || fail="$fail expected-2-devices-got-$n"
  printf '%s\n' "$out" | grep -q 'Kingston DataTraveler' || fail="$fail missing-peripheral"
  printf '%s\n' "$out" | grep -q 'Integrated Camera'     || fail="$fail missing-internal"
  printf '%s\n' "$out" | grep -q 'xHCI'                  && fail="$fail root-hub-not-excluded"
  perip=$(printf '%s\n' "$out" | awk -F'\t' '$3=="removable"' | grep -c .)
  [ "$perip" = 1 ] || fail="$fail expected-1-peripheral-got-$perip"
  # --list: stable TSV interface — same lines, 4 tab-separated columns
  lout=$(MESH_USB_DIR="$tmp" bash "$0" --list)
  [ "$lout" = "$out" ] || fail="$fail list-differs-from-scan"
  lcols=$(printf '%s\n' "$lout" | awk -F'\t' 'NF!=4{bad=1} END{print bad+0}')
  [ "$lcols" = 0 ] || fail="$fail list-not-4-columns"
  # absent bus → BLIND exit 2 (the honest-exit contract; --list inherits it)
  MESH_USB_DIR="$tmp/nonexistent" bash "$0" >/dev/null 2>&1
  [ $? -eq 2 ] || fail="$fail absent-bus-not-exit2"
  MESH_USB_DIR="$tmp/nonexistent" bash "$0" --list >/dev/null 2>&1
  [ $? -eq 2 ] || fail="$fail list-absent-bus-not-exit2"
  rm -rf "$tmp"
  if [ -n "$fail" ]; then echo "smoke-test: FAIL ($fail )"; exit 1; fi
  echo "smoke-test: ok (2 real devices parsed, root hub excluded, 1 peripheral classified, --list stable TSV, absent-bus→exit2 both modes)"
  exit 0
fi

# --- availability: the honest exit-2 gate -----------------------------------------
DIR="$(usb_dir)"
if [ ! -d "$DIR" ]; then
  echo "mesh-usb: BLIND — no USB bus at $DIR (VM/container without USB passthrough) — NOT '0 devices'"
  exit 2
fi

# --- stable machine interface (the delta layer's input) --------------------------
if [ "${1:-}" = "--list" ]; then
  scan_devices
  exit 0
fi

devs="$(scan_devices)"
total=$(printf '%s\n' "$devs" | grep -c .)
periph=$(printf '%s\n' "$devs" | awk -F'\t' '$3=="removable"' | grep -c .)
internal=$(printf '%s\n' "$devs" | awk -F'\t' '$3=="fixed"' | grep -c .)
other=$(( total - periph - internal ))

# --- json -------------------------------------------------------------------------
if [ "${1:-}" = "--json" ]; then
  printf '{"total":%s,"peripheral":%s,"internal":%s,"other":%s,"devices":[' "$total" "$periph" "$internal" "$other"
  first=1
  printf '%s\n' "$devs" | while IFS=$'\t' read -r name vidpid rem spd; do
    [ -n "$name" ] || continue
    [ "$first" = 1 ] || printf ','
    first=0
    printf '{"name":"%s","id":"%s","removable":"%s","speed_mbps":"%s"}' \
      "$(echo "$name" | sed 's/"/\\"/g')" "$vidpid" "$rem" "$spd"
  done
  printf ']}\n'
  exit 0
fi

# --- one-shot human read ----------------------------------------------------------
echo "usb: $total device(s) on the bus — ${periph} peripheral(removable) · ${internal} internal(fixed)$([ "$other" -gt 0 ] && echo " · ${other} other")"
printf '%s\n' "$devs" | while IFS=$'\t' read -r name vidpid rem spd; do
  [ -n "$name" ] || continue
  tag=$rem; [ "$rem" = removable ] && tag="PERIPHERAL"; [ "$rem" = fixed ] && tag="internal"
  echo "  • $name [$vidpid] ${tag} ${spd}Mbps"
done
exit 0
