#!/usr/bin/env bash
# mesh-usb — USB-ATTACH sense: what is PHYSICALLY plugged into this host's USB bus.
#   The USB host controller perceives device attach/removal — a real-world physical
#   signal (operator plugs in a phone, thumb drive, yubikey, audio dongle) that the
#   mesh was blind to. Complements mesh-lan-newdevice (LAN arrivals) and
#   mesh-presence (BLE proximity): a third arrival channel, the WIRED one.
#   Reads /sys/bus/usb/devices/*/{product,idVendor,idProduct,removable,speed},
#   EXCLUDES the controllers' own root hubs (Linux Foundation, vid 1d6b), and splits
#   real devices by the kernel's `removable` attribute into INTERNAL (fixed — soldered:
#   camera, fingerprint, builtin BT) vs PERIPHERAL (removable — the operator physically
#   attached it). Interface dirs (e.g. 1-5:1.0) carry no `product` file → ignored.
# HONEST: exit 2 (BLIND) when /sys/bus/usb is absent — a VM / container with no USB
#   passthrough cannot perceive the bus; we report BLIND, never a faked "0 devices /
#   all-clear" from an unreadable bus (the honest-exit contract: exit 2 = cannot
#   assess, never fabricated). A genuinely empty bus (dir present, no peripherals) is
#   a real exit-0 reading and is reported distinctly.
#
# ── THE AGE AXIS (2026-08-17) ────────────────────────────────────────────────────────
# present/absent is too coarse for a WEDGING device. A dongle that died and re-enumerated
# reads exactly as present as one that has been up since boot, so every wedge consumer
# (mesh-hw-fault-watch, mesh-usb-events, the health dash) saw a green bus through an
# outage. The kernel already carries the missing bit: power/runtime_active_time +
# power/runtime_suspended_time, both in MILLISECONDS, summing to how long THIS device
# node has existed. Verified on this node 2026-08-17: hub 1-2 sums to 18118.1s against
# /proc/uptime 18119.4s (3s), while the uplink 1-2.3 read 5001.8s — a device 3.6h younger
# than its own hub, i.e. it re-enumerated mid-uptime. Corroborated by a second surface
# (idVendor mtime, 17:02:55.667 vs the age-derived 17:02:56).
#   So: age= per device, banded against node uptime —
#     since-boot   age within AGE_BOOT_TOL of uptime — the device the node booted with
#     reenum       materially younger than the node — it re-enumerated after boot (WEDGE)
#     fresh-reenum younger than AGE_FRESH_SEC — it re-enumerated within the last minutes
#     na           power/runtime_*_time absent/unreadable (CONFIG_PM off) — NEVER 0
#   The uplink is identified from /sys/class/net/*/device resolving under a usbN path —
#   deliberately NOT from the default route, which is the artifact a wedge DELETES
#   (mesh-link-heal printed n/a through the whole 16:04→17:03Z outage for exactly that
#   reason, 5a04e4f). A device that is gone renders ABSENT, which is not a healthy read.
#
# ── THE BT LEG, AND WHY `hciconfig -a` IS REFUSED ────────────────────────────────────
# The uplink here is a COMBO chip: 1-2.3:1.0 + :1.1 are btusb, 1-2.3:1.2 is rtw_8822bu —
# one USB device, two stacks. That makes the BT half a SECOND, INDEPENDENT VANTAGE on the
# same silicon, and it is the passive way to settle the open wedge hypothesis (wifi-only
# fault vs whole-device fault) without touching the radio.
#   PINNED: bare `hciconfig <dev>`. It is an HCIGETDEVINFO ioctl against kernel-cached
#   stats. `-a` is REFUSED because it additionally issues Read Local Name / Class of
#   Device / Local Version — HCI commands AT THE CONTROLLER — and the controller we are
#   polling is the one that is faulting. Driving wedged silicon to take its temperature is
#   the "a real hardware test leg is an attack" rule. Same reason we never reach for the
#   discovery path (mesh-bt-census's scan actively drives the radio).
#   COST FIGURES ARE UNATTRIBUTABLE, and this header will not quote one. The commands
#   counter has a THIRD-PARTY WRITER — bluetoothd is live on this node and the controller
#   has been observed UP RUNNING INQUIRY — so a measured +3 across an `-a` call and a +0
#   across a bare call are both single samples of a bursty background (health measured
#   978→980 in 2s then 998/998/998 flat then +4, issuing nothing at all). You cannot
#   cost-attribute your own call on a counter someone else is writing. The pin rests on
#   FIRST PRINCIPLES — ioctl-on-cached-stats vs commands-on-the-wire — not on that data.
#   (a) hci0 down / absent / unreadable renders `na`, NEVER 0. A zero on a fault axis is a
#       fabricated all-clear.
#   (b) every counter read is STAMPED with the device age, because the counters are
#       since-hci0-up and a USB reset zeroes them. errors:0 over a 1.4h-old device says
#       nothing whatsoever about a 3.6h-old outage; `covers<=` names that ceiling inline so
#       a consumer cannot mistake the narrow claim for the wide one.
#
# orphan-ok: on-demand inventory query (like mesh-find / mesh-lan-newdevice's scan) —
#   pulled when asked or by a fusion consumer, not a scheduled reflex. Stateless
#   (no change-gated artifact), so no mesh-state-touch needed.
# Modes: (none) human read · --json · --list (STABLE machine interface: the raw TSV
#   <product>\t<vid:pid>\t<removable>\t<speed> lines — consumed by mesh-usb-events'
#   delta layer; treat the 4-column shape as a consumer contract; the age axis is
#   deliberately NOT bolted on here, it has its own mode) · --age · --bt ·
#   --xhci [busid] (the host controller's own verdict; defaults to the uplink) · --test
set -u

ROOT_HUB_VID="1d6b"   # Linux Foundation — the controllers' own root hubs, not peripherals
AGE_BOOT_TOL="${MESH_USB_AGE_BOOT_TOL:-120}"    # s: within this of uptime ⇒ present since boot
AGE_FRESH_SEC="${MESH_USB_AGE_FRESH_SEC:-300}"  # s: younger than this ⇒ just re-enumerated

usb_dir() { echo "${MESH_USB_DIR:-/sys/bus/usb/devices}"; }
net_dir() { echo "${MESH_USB_NET_DIR:-/sys/class/net}"; }
bt_dir()  { echo "${MESH_USB_BT_DIR:-/sys/class/bluetooth}"; }
hci_dev() { echo "${MESH_USB_HCI_DEV:-hci0}"; }

# _walk_devices — the ONE place the root-hub filter and the "product file ⇒ device node"
# rule live. Emits: <busid>\t<vid>\t<pid>\t<removable>\t<speed>\t<product>
_walk_devices() {
  local dir d prod vid pid rem spd
  dir="$(usb_dir)"
  for d in "$dir"/*/; do
    [ -e "$d/product" ] || continue            # only device nodes present a product string
    vid=$(cat "$d/idVendor" 2>/dev/null)
    [ "$vid" = "$ROOT_HUB_VID" ] && continue    # skip the controllers' own root hubs
    prod=$(cat "$d/product" 2>/dev/null)
    pid=$(cat "$d/idProduct" 2>/dev/null)
    rem=$(cat "$d/removable" 2>/dev/null); rem="${rem:-unknown}"
    spd=$(cat "$d/speed" 2>/dev/null)
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$(basename "$d")" "$vid" "$pid" "$rem" "${spd:-?}" "${prod:-?}"
  done
}

# scan_devices — the STABLE 4-column consumer contract (mesh-usb-events diffs on it).
scan_devices() {
  _walk_devices | awk -F'\t' '{printf "%s\t%s:%s\t%s\t%s\n", $6, $2, $3, $4, $5}'
}

# ── age ───────────────────────────────────────────────────────────────────────────────
# node_uptime_sec — integer seconds, or `na`. NEVER 0: an unreadable clock is blindness.
node_uptime_sec() {
  local u
  u="${MESH_USB_UPTIME:-}"
  [ -n "$u" ] || u=$(cut -d' ' -f1 /proc/uptime 2>/dev/null)
  case "$u" in ''|*[!0-9.]*) echo na; return ;; esac
  awk -v u="$u" 'BEGIN{printf "%d", u}'
}

# device_age_sec <busid> — integer seconds this device node has existed, or `na`.
# active+suspended are MILLISECONDS. A missing/garbage read is `na`, never 0 — a zero here
# would read as "just re-enumerated", the loudest possible fabricated alarm.
device_age_sec() {
  local d a s
  d="$(usb_dir)/$1"
  a=$(cat "$d/power/runtime_active_time" 2>/dev/null)
  s=$(cat "$d/power/runtime_suspended_time" 2>/dev/null)
  case "$a" in ''|*[!0-9]*) echo na; return ;; esac
  case "$s" in ''|*[!0-9]*) echo na; return ;; esac
  echo $(( (a + s) / 1000 ))
}

# age_band <age_sec> <uptime_sec>
age_band() {
  local a="$1" u="$2"
  [ "$a" = na ] && { echo na; return; }
  [ "$u" = na ] && { echo na; return; }
  if [ "$a" -ge $(( u - AGE_BOOT_TOL )) ]; then echo since-boot
  elif [ "$a" -lt "$AGE_FRESH_SEC" ];     then echo fresh-reenum
  else                                          echo reenum
  fi
}

fmt_age() { awk -v s="$1" 'BEGIN{ if(s=="na"){print "na"; exit} printf "%.1fh", s/3600 }'; }

# _busid_from_syspath — pull the deepest usb devpath component out of a resolved sysfs
# path and strip any interface suffix (1-2.3:1.2 → 1-2.3).
_busid_from_syspath() {
  local b
  b=$(printf '%s' "$1" | tr '/' '\n' | grep -E '^[0-9]+-[0-9]+(\.[0-9]+)*(:[0-9]+\.[0-9]+)?$' | tail -1)
  printf '%s' "${b%%:*}"
}

# uplink_ref — "<busid>\t<ifname>" for the first net interface whose device resolves under
# a usbN path. Route-INDEPENDENT on purpose (see the header): the wedge deletes the route.
uplink_ref() {
  local n real busid
  for n in "$(net_dir)"/*; do
    [ -e "$n/device" ] || continue
    real="$(readlink -f "$n/device" 2>/dev/null)" || continue
    case "$real" in *"/usb"*) ;; *) continue ;; esac
    busid="$(_busid_from_syspath "$real")"
    [ -n "$busid" ] && { printf '%s\t%s\n' "$busid" "$(basename "$n")"; return 0; }
  done
  return 1
}

# bt_ref — "<busid>" of the USB device carrying the pinned hci device, or non-zero.
bt_ref() {
  local p real busid
  p="$(bt_dir)/$(hci_dev)"
  [ -e "$p" ] || return 1
  real="$(readlink -f "$p" 2>/dev/null)" || return 1
  case "$real" in *"/usb"*) ;; *) return 1 ;; esac
  busid="$(_busid_from_syspath "$real")"
  [ -n "$busid" ] || return 1
  printf '%s\n' "$busid"
}

# uplink_line — the banded one-liner every wedge consumer reads instead of present/absent.
uplink_line() {
  local ref busid ifn age up band when
  up="$(node_uptime_sec)"
  if ! ref="$(uplink_ref)"; then
    if [ -n "${MESH_USB_UPLINK_ID:-}" ]; then
      echo "uplink: ABSENT — pinned $MESH_USB_UPLINK_ID not enumerated on the bus (node up $(fmt_age "$up")) — NOT healthy"
    else
      echo "uplink: na — no USB-attached net interface on this node (uplink is not on the bus)"
    fi
    return
  fi
  busid="${ref%%	*}"; ifn="${ref##*	}"
  age="$(device_age_sec "$busid")"
  band="$(age_band "$age" "$up")"
  case "$band" in
    since-boot) echo "uplink: $ifn @$busid — up $(fmt_age "$age") of the node's $(fmt_age "$up") — SINCE-BOOT" ;;
    na)         echo "uplink: $ifn @$busid — age na (power/runtime_*_time unreadable) — cannot assess, NOT clear" ;;
    *)          when=$(awk -v a="$age" 'BEGIN{printf "%d", a}')
                when=$(date -u -d "@$(( $(date +%s) - when ))" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)
                echo "uplink: $ifn @$busid — up $(fmt_age "$age") of the node's $(fmt_age "$up") — ${band^^} (re-enumerated ${when:-?}, the node did not) — NOT healthy" ;;
  esac
}

# bt_line — the SECOND vantage on the same silicon. Bare read only; n/a never 0.
# Exit 0 when a counter set was read, 2 when the axis is honestly blind.
bt_line() {
  local dev busid age up band out state rxe txe ev cmd
  dev="$(hci_dev)"; up="$(node_uptime_sec)"
  command -v "${MESH_USB_HCI_CMD:-hciconfig}" >/dev/null 2>&1 || {
    echo "bt: $dev na — hciconfig absent (counters unreadable, NOT 0)"; return 2; }
  # PINNED BARE — no -a, ever. See the header: -a issues HCI commands at a faulting controller.
  out="$("${MESH_USB_HCI_CMD:-hciconfig}" "$dev" 2>/dev/null)" || {
    echo "bt: $dev na — hciconfig read failed (counters unreadable, NOT 0)"; return 2; }
  [ -n "$out" ] || { echo "bt: $dev na — no such controller (counters unreadable, NOT 0)"; return 2; }
  state=$(printf '%s\n' "$out" | awk '/UP|DOWN/{gsub(/^[ \t]+|[ \t]+$/,""); print; exit}')
  case "$state" in *UP*) ;; *)
    echo "bt: $dev na — controller ${state:-DOWN} (counters are since-up and this one is not up; NOT 0)"
    return 2 ;;
  esac
  rxe=$(printf '%s\n' "$out" | awk '/RX bytes/{for(i=1;i<=NF;i++) if($i ~ /^errors:/){sub(/errors:/,"",$i); print $i; exit}}')
  txe=$(printf '%s\n' "$out" | awk '/TX bytes/{for(i=1;i<=NF;i++) if($i ~ /^errors:/){sub(/errors:/,"",$i); print $i; exit}}')
  ev=$(printf  '%s\n' "$out" | awk '/events:/{for(i=1;i<=NF;i++) if($i ~ /^events:/){sub(/events:/,"",$i); print $i; exit}}')
  cmd=$(printf '%s\n' "$out" | awk '/commands:/{for(i=1;i<=NF;i++) if($i ~ /^commands:/){sub(/commands:/,"",$i); print $i; exit}}')
  for v in rxe txe ev cmd; do
    eval "case \"\$$v\" in ''|*[!0-9]*) $v=na ;; esac"
  done
  # (b) STAMP: the counters cannot speak to anything older than the device.
  if busid="$(bt_ref)"; then
    age="$(device_age_sec "$busid")"; band="$(age_band "$age" "$up")"
    echo "bt: $dev @$busid $state rx_errors=$rxe tx_errors=$txe events=$ev commands=$cmd — dev-age $(fmt_age "$age") band=$band, counters since-device-up so they cover<=$(fmt_age "$age") of the node's $(fmt_age "$up")"
  else
    echo "bt: $dev (no USB parent) $state rx_errors=$rxe tx_errors=$txe events=$ev commands=$cmd — dev-age na, counter coverage UNKNOWN"
  fi
  return 0
}

# ── THE xHCI ENDPOINT-CONTEXT LEG (2026-08-18) ───────────────────────────────────────
# Every dongle sense we had was SYMPTOM-SIDE: dmesg's `-71` (mesh-hw-fault-watch), the age
# axis above, PHY quality (mesh-wifi-rf --phy). All of them observe the DRIVER's complaint.
# None can say what the HOST CONTROLLER thinks. /sys/kernel/debug/usb/xhci/<pci>/devices/
# <slot>/{slot-context,ep-context,epNN/{dequeue,enqueue}} can, and it SEPARATES the two
# wedge hypotheses five USB-path moves failed to separate:
#   an ep State halted/error        → DEVICE-STALL   (clear-halt/reset-ep; a re-plug is overkill)
#   all running, deq FROZEN, backlog→ LINK-WEDGE     (host queued, device not completing)
#   slot State != configured        → DE-ENUMERATED  (re-enumeration, not endpoint surgery)
#   else                            → CLEAN
# Cost: small reads of DMA-mapped HOST MEMORY — no USB traffic is generated, so unlike an
# `hciconfig -a` or a scan this cannot poke the wedged silicon ("a real hardware test leg
# is an attack when the device is wedged").
#   SLOT ↔ DEVICE IS NOT STABLE. The slot is assigned at enumeration and this dongle's path
#   has moved five times (1-5 → 1-6 → 1-2.4 → 1-3 → 1-2.3). We resolve by reading
#   devices/*/name and matching the device's CURRENT busid — never a hardcoded slot, the
#   same discipline as mesh-wifi-rf globbing phy* because "the phy index MOVES".
#   BACKLOG = enqueue − dequeue, the kernel's own monotone pointer pair: queued-but-
#   uncompleted TRBs (16 B each). Nonzero backlog ALONE IS NOT A WEDGE — a busy ring is
#   supposed to have one; the wedge is backlog that persists while the dequeue does not
#   move. Both conditions are required, and the gate proves the distinction on a fixture
#   where the backlog is nonzero at BOTH samples but the dequeue advances (→ CLEAN).
#   AND DIRECTION IS THE THIRD CONDITION — the brief's stated rule ("all running with a
#   frozen dequeue and nonzero backlog ⇒ link/silicon wedge") is UNDIRECTED, and on its
#   very first live run against this healthy uplink it returned LINK-WEDGE: ep02 (Int IN)
#   and ep04 (Bulk IN) sat at backlog 1 and 2 TRBs with a frozen dequeue while every
#   host→device ring was drained and three rings were advancing. That is not a fault, it
#   is what an armed receive ring LOOKS like — the driver posts RX buffers in advance and
#   the dequeue only moves when the device has something to send, so a quiet IN endpoint
#   is PERMANENTLY backlogged-and-frozen by construction. Calibrated against the live
#   corpus rather than the assumed model (the mesh's own "calibrate a derived axis against
#   the REAL corpus" rule), the wedge condition is host→device only: an OUT or Ctrl ring
#   whose backlog will not drain is the host holding work the device is not taking, which
#   is also the direction the observed fault reports (`rtw_usb_reg_sec: usb WRITE 1 fail,
#   status: -71`). IN-side backlog is reported and explicitly labelled ARMED, never
#   counted as a wedge; the device-wide advance count is printed beside the verdict so a
#   partial stall (one ring frozen while others still complete) is distinguishable from a
#   whole-device silence. Both directions are gated, and the IN gate was seen RED against
#   the undirected rule this leg shipped with for its first thirty minutes.
#   THE WINDOW IS PUBLISHED IN THE READING. Two samples XHCI_GAP s apart is TWO INSTANTS,
#   not an interval: a ring drained at both says nothing about the milliseconds between
#   them ("a sense whose window is narrower than its cadence reports a sample, not a
#   state"). The only interval claim we are entitled to is "did the pointer move", so the
#   advance count is printed as such and the caveat is printed in full, every run.
#   na CARRIES THE ERRNO, never 0 and never a default. Under this node's lockdown=integrity
#   a debugfs read can EPERM even for root, and to a `2>/dev/null` reader that is
#   INDISTINGUISHABLE from "no such feature" (the silent-fallback shape). Predictor from
#   the brief: mode != 0444 in debugfs ⇒ the read EPERMs whoever you are. We therefore
#   never gate on [ -r ]: we ATTEMPT the read and report what the kernel said.
#   portsc IS DELIBERATELY NOT TOUCHED — the link-state register is 0644 and EPERMs to
#   root here (census: 0444 readable 161/161, 0644 readable 0/22). The endpoint-state axis
#   is the better one anyway: it names WHICH endpoint and HOW MUCH backlog.
#   PRIVILEGE: the reads need root via `sudo -n`, exactly like mesh-wifi-rf's phy/coex
#   lane. This node grants `mesh-home ALL=(ALL) NOPASSWD:ALL` — there is NO scoped
#   phy/coex sudoers line to extend (the task assumed one); nothing was added or
#   duplicated. Asserted reachable from a NON-LOGIN context (systemd transient unit,
#   env -i, no tty) 2026-08-18, which is the claim that matters for a cron/reflex caller
#   ("a transient systemd unit runs without ~/.local/bin on PATH").
XHCI_GAP="${MESH_USB_XHCI_GAP:-3}"          # s between the two samples
XHCI_TIMEOUT="${MESH_USB_XHCI_TIMEOUT:-5}"  # s cap on a single privileged read
xhci_root() { echo "${MESH_USB_XHCI_DIR:-/sys/kernel/debug/usb/xhci}"; }
# `-` not `:-` on purpose: a fixture sets it EMPTY to drive the same code path unprivileged.
XSUDO="${MESH_USB_XHCI_SUDO-sudo -n}"

_errno_of() {  # <text> → errno token. Text, because that is all the shell is given.
  case "$1" in
    *"Operation not permitted"*|*Operation_not_permitted*) echo EPERM ;;
    *"Permission denied"*|*Permission_denied*)             echo EACCES ;;
    *"No such file"*|*No_such_file*)                       echo ENOENT ;;
    *"password is required"*|*"a terminal is required"*)    echo ESUDO ;;
    *"Invalid argument"*)                                  echo EINVAL ;;
    *) echo EUNKNOWN ;;
  esac
}

_xrun() {  # <cap_s> <sh-script> [args...] — run under the (possibly empty) privilege prefix
  local cap="$1"; shift
  local script="$1"; shift
  if [ -n "$XSUDO" ]; then timeout "$cap" $XSUDO sh -c "$script" _ "$@" 2>&1
  else                     timeout "$cap" sh -c "$script" _ "$@" 2>&1; fi
}

# xhci_slot_dir <busid> — the slot dir whose devices/*/name IS this busid.
# rc 0 = found (path on stdout) · 1 = enumerated nowhere · 3 = no xhci debugfs · 4 = unreadable
xhci_slot_dir() {
  local out rc
  out="$(_xrun "$XHCI_TIMEOUT" '
    root="$1"; want="$2"
    [ -d "$root" ] || { echo "__NOROOT__"; exit 3; }
    for f in "$root"/*/devices/*/name; do
      [ -e "$f" ] || continue
      n=$(cat "$f" 2>/dev/null)
      if [ "$n" = "$want" ]; then printf "%s\n" "${f%/name}"; exit 0; fi
    done
    echo "__NOTFOUND__"; exit 1
  ' "$(xhci_root)" "$1")"; rc=$?
  case "$out" in
    __NOROOT__)   return 3 ;;
    __NOTFOUND__) return 1 ;;
  esac
  # A bare rc≠0 with no marker is sudo/timeout failing — NOT "the device is not there".
  if [ "$rc" != 0 ] || [ -z "$out" ]; then printf '%s' "$out"; return 4; fi
  printf '%s' "$out"; return 0
}

# xhci_dump <slotdir> — two samples of slot-context, ep-context and every ring pointer.
# Every read reports its OWN rc and the kernel's own message, so a per-file EPERM survives
# to the parser instead of collapsing into an empty string.
xhci_dump() {
  _xrun $(( XHCI_GAP + XHCI_TIMEOUT + 5 )) '
    d="$1"; gap="$2"; n=0
    while [ "$n" -lt 2 ]; do
      n=$((n+1))
      printf "SAMPLE %s %s\n" "$n" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
      o=$(cat "$d/slot-context" 2>&1); rc=$?
      printf "SLOT %s %s\n" "$rc" "$(printf "%s" "$o" | head -1)"
      o=$(cat "$d/ep-context" 2>&1); rc=$?
      printf "EPCTX %s\n" "$rc"
      printf "%s\n" "$o" | sed "s/^/EPCTXLINE /"
      for e in "$d"/ep[0-9]*; do
        [ -d "$e" ] || continue
        b=${e##*/}
        dq=$(cat "$e/dequeue" 2>&1); drc=$?
        eq=$(cat "$e/enqueue" 2>&1); erc=$?
        printf "EP %s %s %s %s %s\n" "$b" "$drc" \
          "$(printf "%s" "$dq" | head -1 | tr " " "_")" "$erc" \
          "$(printf "%s" "$eq" | head -1 | tr " " "_")"
      done
      [ "$n" -lt 2 ] && sleep "$gap"
    done
  ' "$1" "$XHCI_GAP"
}

# xhci_backlog_watch <slotdir> <secs> — poll every ring for <secs> and echo
# "<max_out_backlog_trb> <max_in_backlog_trb>", or `na na`.
# SPLIT BY DIRECTION ON PURPOSE. The verdict above fires on host→device backlog only, so
# that is the axis the (d) leg has to see move — and it is the only one where "nonzero" is
# informative: an IN ring on THIS node reads backlog 1-2 TRB while completely idle (armed
# receive buffers), so a leg that watched every direction at once would pass on a bus with
# no traffic at all. That would be a gate agreeing with the resting reading, which is the
# exact failure the requirement exists to prevent.
xhci_backlog_watch() {
  local out
  out="$(_xrun $(( $2 + XHCI_TIMEOUT + 5 )) '
    d="$1"; secs="$2"; end=$(( $(date +%s) + secs ))
    cat "$d/ep-context" 2>/dev/null | sed "s/^/T /"
    while [ "$(date +%s)" -lt "$end" ]; do
      for e in "$d"/ep[0-9]*; do
        [ -d "$e" ] || continue
        printf "B %s %s %s\n" "${e##*/}" "$(cat "$e/dequeue" 2>/dev/null)" "$(cat "$e/enqueue" 2>/dev/null)"
      done
      sleep 0.1
    done
  ' "$1" "$2")"
  printf '%s\n' "$out" | awk -v SEG="${MESH_USB_XHCI_SEG_TRBS:-256}" '
    function h2d(s,  i,c,v,n){ sub(/^0[xX]/,"",s); v=0; n=length(s); if(n==0) return -1
      for(i=1;i<=n;i++){ c=tolower(substr(s,i,1))
        if(c>="0"&&c<="9") v=v*16+(c-"0")
        else if(index("abcdef",c)>0) v=v*16+(index("abcdef",c)+9)
        else return -1 }
      return v-(v%16) }
    $1=="T"{ k++; ty=""
      for(i=2;i<=NF;i++) if($i=="Type"){ ty=$(i+1); if($(i+2)=="IN"||$(i+2)=="OUT") ty=ty"-"$(i+2) }
      dir[sprintf("ep%02d",k-1)] = (ty ~ /-OUT$/ || ty=="Ctrl") ? "out" : "in"; next }
    # same rule as the verdict: a difference wider than one ring segment is two allocations,
    # not a backlog. Counting it would let a cross-segment artifact PASS this gate.
    $1=="B" && NF==4 { d=h2d($3); e=h2d($4); if(d<0||e<0) next
      seen=1; b=(e-d)/16
      if(b>0 && b<=SEG){ if(dir[$2]=="out"){ if(b>mo) mo=b } else { if(b>mi) mi=b } } }
    END{ if(!seen) print "na na"; else printf "%d %d\n", mo+0, mi+0 }'
}

# xhci_verdict <ctx> — PURE parser: dump on stdin → the reading on stdout.
# Pure on purpose, so the verdict logic is gated against canned dumps (halted / frozen /
# advancing / de-enumerated / EPERM) that no live bus would hand us on demand.
# rc 0 = a reading · 2 = honestly blind.
xhci_verdict() {
  awk -v ctx="$1" -v gap="$XHCI_GAP" -v SEG="${MESH_USB_XHCI_SEG_TRBS:-256}" '
  function errof(t){
    if(t ~ /Operation not permitted|Operation_not_permitted/) return "EPERM"
    if(t ~ /Permission denied|Permission_denied/)             return "EACCES"
    if(t ~ /No such file|No_such_file/)                       return "ENOENT"
    if(t ~ /password is required|terminal is required/)       return "ESUDO"
    if(t ~ /Invalid argument/)                                return "EINVAL"
    return "EUNKNOWN"
  }
  function h2d(s,  i,c,v,n){          # mawk has no strtonum; addresses are < 2^53 so this is exact
    sub(/^0[xX]/,"",s); v=0; n=length(s)
    if(n==0) return -1
    for(i=1;i<=n;i++){
      c=tolower(substr(s,i,1))
      if(c>="0"&&c<="9") v=v*16+(c-"0")
      else if(index("abcdef",c)>0) v=v*16+(index("abcdef",c)+9)
      else return -1
    }
    return v - (v % 16)               # mask the low nibble: DCS/cycle bits are not address
  }
  $1=="SAMPLE"{ s=$2; ts[s]=$3; next }
  $1=="SLOT"{ slotrc[s]=$2; l=$0; sub(/^SLOT [0-9]+ ?/,"",l); slottxt[s]=l
              if($2==0 && match(l,/State [a-z]+/)) slotstate[s]=substr(l,RSTART+6,RLENGTH-6)
              next }
  $1=="EPCTX"{ epctxrc[s]=$2; k=0; next }
  $1=="EPCTXLINE"{ if(epctxrc[s]!=0) next
    k++; st=""; ty=""
    for(i=2;i<=NF;i++){
      if($i=="State") st=$(i+1)
      if($i=="Type"){ ty=$(i+1); if($(i+2)=="IN"||$(i+2)=="OUT") ty=ty"-"$(i+2) }
    }
    e=sprintf("ep%02d",k-1); epstate[s,e]=st; eptype[s,e]=ty; next }
  $1=="EP"{ e=$2; if(!(e in seen)){ seen[e]=1; eps[++ne]=e }
            drc[s,e]=$3; dv[s,e]=$4; erc[s,e]=$5; ev[s,e]=$6; next }
  END{
    if(!(1 in ts) || !(2 in ts)){
      printf "xhci: %s na(ESTREAM: fewer than 2 samples returned) — cannot assess, NOT clear\n", ctx
      exit 2 }
    if(slotrc[1]!=0 && slotrc[2]!=0){
      printf "xhci: %s na(%s: slot-context unreadable) — cannot assess, NOT clear [%s]\n", \
             ctx, errof(slottxt[1]), slottxt[1]; exit 2 }
    if(epctxrc[1]!=0 && epctxrc[2]!=0){
      printf "xhci: %s na(%s: ep-context unreadable) — cannot assess, NOT clear\n", \
             ctx, errof(slottxt[1]); exit 2 }
    ss = (2 in slotstate) ? slotstate[2] : slotstate[1]
    if(ss=="") ss="na"
    nrun=0; nstall=0; noth=0; ndis=0; nadv=0; nbl=0; nwedge=0; nna=0; narmed=0
    stalled=""; wedged=""; detail=""
    for(i=1;i<=ne;i++){
      e=eps[i]
      st=((2 SUBSEP e) in epstate)?epstate[2,e]:epstate[1,e]
      if(st=="") st="na"
      ty=((2 SUBSEP e) in eptype)?eptype[2,e]:eptype[1,e]
      if(ty=="") ty="?"
      if(st=="disabled"){ ndis++; continue }           # not configured: nothing to say about it
      if(st=="running") nrun++; else if(st=="halted"||st=="error"){ nstall++; stalled=stalled" "e }
      else noth++
      # backlog — na WITH the errno whenever a pointer could not be read; never 0
      bad=""
      if(drc[1,e]!=0) bad=errof(dv[1,e]); else if(erc[1,e]!=0) bad=errof(ev[1,e])
      else if(drc[2,e]!=0) bad=errof(dv[2,e]); else if(erc[2,e]!=0) bad=errof(ev[2,e])
      if(bad!=""){
        nna++
        detail=detail sprintf("  %s %-8s State=%s backlog=na(%s: ring pointer unreadable)\n", e, ty, st, bad)
        continue }
      d1=h2d(dv[1,e]); e1=h2d(ev[1,e]); d2=h2d(dv[2,e]); e2=h2d(ev[2,e])
      if(d1<0||e1<0||d2<0||e2<0){
        nna++
        detail=detail sprintf("  %s %-8s State=%s backlog=na(EPARSE: unparseable pointer)\n", e, ty, st)
        continue }
      # THE PRESENCE OF A BACKLOG AND ITS SIZE ARE DIFFERENT CLAIMS, and only the first is
      # always knowable. enqueue−dequeue is a TRB count ONLY while both pointers are in the
      # same ring segment; across segments (separate DMA allocations) the difference is an
      # address gap with no TRB meaning — measured live under a 400 MB transfer, an IN ring
      # produced a "backlog" of 87301 TRB, which is not a backlog, it is two allocations.
      # So: outstanding work = deq != enq (always sound); the SIZE is printed only when it
      # lands inside a segment, and renders `xseg` otherwise. Never invent the magnitude.
      b1=e1-d1; b2=e2-d2
      pres1=(d1!=e1); pres2=(d2!=e2)
      bl1=(b1>0 && b1<=SEG*16)?sprintf("%d",b1/16):(b1==0?"0":"xseg")
      bl2=(b2>0 && b2<=SEG*16)?sprintf("%d",b2/16):(b2==0?"0":"xseg")
      adv=(d1!=d2)||(e1!=e2); if(adv) nadv++
      frozen=(d1==d2)
      note=(adv?"ring ADVANCED":"pointers unchanged")
      # DIRECTION IS THE WHOLE VERDICT. host→device (OUT/Ctrl) backlog that will not drain
      # is the wedge; device→host (IN) backlog is the receive ring ARMED and waiting, which
      # is its normal resting state. See the header: the brief`s undirected rule read
      # LINK-WEDGE off a perfectly healthy uplink on its first live run.
      out_dir = (ty ~ /-OUT$/ || ty=="Ctrl")
      if(pres1 && pres2){
        nbl++
        if(frozen && st=="running"){
          if(out_dir){ nwedge++; wedged=wedged" "e }
          else       { narmed++; note=note" (IN ring ARMED — waiting on the device, not a wedge)" }
        }
      }
      detail=detail sprintf("  %s %-8s State=%-7s deq %s→%s  backlog %s→%s trb  %s\n", \
        e, ty, st, dv[1,e], dv[2,e], bl1, bl2, note)
    }
    if(nrun==0 && nstall==0 && nna>0){
      printf "xhci: %s na(ring pointers unreadable on every endpoint) — cannot assess, NOT clear\n", ctx
      exit 2 }
    if(ss!="configured"){ v="DE-ENUMERATED"
      gloss=sprintf("slot State=%s ≠ configured — the controller has already dropped this device; the remedy is re-enumeration, not endpoint surgery", ss) }
    else if(nstall>0){ v="DEVICE-STALL"
      gloss=sprintf("endpoint(s)%s halted/error — the DEVICE stalled (or blew its CErr budget); clear-halt/reset-endpoint, a re-plug is overkill", stalled) }
    else if(nwedge>0){ v="LINK-WEDGE"
      gloss=sprintf("host→device endpoint(s)%s running with a FROZEN dequeue and nonzero backlog at BOTH samples — the host queued work the device is not completing: link/silicon side, this is the re-plug case%s", \
        wedged, (nadv>0 ? sprintf(", though %d other ring(s) DID advance, so the device is not wholly silent — a partial stall", nadv) : ", and NOTHING advanced anywhere on this device")) }
    else { v="CLEAN"
      gloss=sprintf("no halted/error endpoint, no host→device ring both backlogged and frozen%s", \
        (narmed>0 ? sprintf(" (%d IN ring(s) carry a resting backlog — armed receive buffers, the normal state of a device with nothing to say)", narmed) : "")) }
    printf "xhci: %s — slot State=%s · %d ep(s) live of %d (%d running, %d halted/error, %d other, %d ring-unreadable), %d disabled · %d ring(s) advanced, %d with backlog (%d of them armed IN) — verdict=%s (%s)\n", \
      ctx, ss, nrun+nstall+noth, ne, nrun, nstall, noth, nna, ndis, nadv, nbl, narmed, v, gloss
    printf "  window: 2 samples %ss apart (%s .. %s) — every backlog figure is an INSTANT reading at those two moments, NOT a claim about the interval between them; the advance count is the only interval claim here.\n", \
      gap, ts[1], ts[2]
    printf "%s", detail
    exit 0
  }'
}

# xhci_line [busid] — resolve, sample, judge. Defaults to the uplink. rc 0 read / 2 blind.
xhci_line() {
  local busid ref out rc slotdir hc slot ctx dump
  busid="${1:-}"
  if [ -z "$busid" ]; then
    if ref="$(uplink_ref)"; then busid="${ref%%	*}"
    else echo "xhci: na — no USB-attached net interface to resolve (the uplink is not on this bus)"; return 2; fi
  fi
  out="$(xhci_slot_dir "$busid")"; rc=$?
  case "$rc" in
    0) slotdir="$out" ;;
    3) echo "xhci: na(ENOENT: no xhci debugfs at $(xhci_root)) — no endpoint contexts on this host (debugfs unmounted, non-xHCI, or not Linux); NOT a clean reading"; return 2 ;;
    1) echo "xhci: $busid na(ENODEV: no slot under $(xhci_root) whose devices/*/name is $busid) — the device is not enumerated on any xHCI slot; NOT a clean reading"; return 2 ;;
    *) echo "xhci: $busid na($(_errno_of "$out"): slot resolution unreadable) — [$(printf '%s' "$out" | head -1)]"; return 2 ;;
  esac
  hc="$(basename "$(dirname "$(dirname "$slotdir")")")"
  slot="$(basename "$slotdir")"
  ctx="$busid @HC $hc slot $slot"
  dump="$(xhci_dump "$slotdir")"; rc=$?
  case "$dump" in
    *"SAMPLE 1 "*) ;;
    *) echo "xhci: $ctx na($(_errno_of "$dump"): context dump failed rc=$rc) — [$(printf '%s' "$dump" | head -1)]"; return 2 ;;
  esac
  printf '%s\n' "$dump" | xhci_verdict "$ctx"
}

# --- portable logic self-test (no real USB bus needed: runs against a fixture) ----
if [ "${1:-}" = "--test" ]; then
  tmp=$(mktemp -d)
  # a removable peripheral — present since boot (age ≈ uptime)
  mkdir -p "$tmp/2-1/power"; printf 'Kingston DataTraveler' >"$tmp/2-1/product"
  echo 0951 >"$tmp/2-1/idVendor"; echo 1666 >"$tmp/2-1/idProduct"
  echo removable >"$tmp/2-1/removable"; echo 5000 >"$tmp/2-1/speed"
  echo 17000000 >"$tmp/2-1/power/runtime_active_time"; echo 1000000 >"$tmp/2-1/power/runtime_suspended_time"
  # a fixed internal device — no power/ dir at all (CONFIG_PM off) → age na
  mkdir -p "$tmp/1-5"; printf 'Integrated Camera' >"$tmp/1-5/product"
  echo 174f >"$tmp/1-5/idVendor"; echo 118d >"$tmp/1-5/idProduct"
  echo fixed >"$tmp/1-5/removable"; echo 480 >"$tmp/1-5/speed"
  # THE UPLINK — a combo dongle that re-enumerated mid-uptime (1.4h into an 5.0h node)
  mkdir -p "$tmp/1-2.3/power"; printf 'RTL8822BU' >"$tmp/1-2.3/product"
  echo 0bda >"$tmp/1-2.3/idVendor"; echo b82c >"$tmp/1-2.3/idProduct"
  echo removable >"$tmp/1-2.3/removable"; echo 480 >"$tmp/1-2.3/speed"
  echo 5001786 >"$tmp/1-2.3/power/runtime_active_time"; echo 0 >"$tmp/1-2.3/power/runtime_suspended_time"
  # a root hub (MUST be excluded)
  mkdir -p "$tmp/usb1"; printf 'xHCI Host Controller' >"$tmp/usb1/product"
  echo 1d6b >"$tmp/usb1/idVendor"; echo 0002 >"$tmp/usb1/idProduct"; echo unknown >"$tmp/usb1/removable"
  # an interface dir (no product → MUST be ignored)
  mkdir -p "$tmp/1-5:1.0"
  # fixture net dir: wlan0 → .../usb1/1-2.3/1-2.3:1.2 (an INTERFACE path, as the kernel gives it)
  mkdir -p "$tmp/net/wlan0" "$tmp/sys/pci/usb1/1-2.3/1-2.3:1.2"
  ln -s "$tmp/sys/pci/usb1/1-2.3/1-2.3:1.2" "$tmp/net/wlan0/device"
  # fixture bluetooth dir: hci0 → .../usb1/1-2.3/1-2.3:1.0/bluetooth/hci0 (same device, other stack)
  mkdir -p "$tmp/bt" "$tmp/sys/pci/usb1/1-2.3/1-2.3:1.0/bluetooth/hci0"
  ln -s "$tmp/sys/pci/usb1/1-2.3/1-2.3:1.0/bluetooth/hci0" "$tmp/bt/hci0"
  # fixture hciconfig stubs. Each RECORDS ITS ARGV — that is how we assert the -a pin
  # behaviourally instead of grepping our own source (a self-matching grep asserts nothing).
  cat >"$tmp/hci-up" <<STUB
#!/usr/bin/env bash
printf '%s\n' "\$*" >>"$tmp/hci.argv"
cat <<'EOF'
hci0:	Type: Primary  Bus: USB
	BD Address: 00:13:25:AC:CD:1B  ACL MTU: 1021:8  SCO MTU: 255:16
	UP RUNNING
	RX bytes:501386 acl:0 sco:0 events:5067 errors:7
	TX bytes:30568 acl:0 sco:0 commands:1153 errors:0
EOF
STUB
  cat >"$tmp/hci-down" <<STUB
#!/usr/bin/env bash
printf '%s\n' "\$*" >>"$tmp/hci.argv"
cat <<'EOF'
hci0:	Type: Primary  Bus: USB
	BD Address: 00:13:25:AC:CD:1B  ACL MTU: 1021:8  SCO MTU: 255:16
	DOWN
	RX bytes:0 acl:0 sco:0 events:0 errors:0
	TX bytes:0 acl:0 sco:0 commands:0 errors:0
EOF
STUB
  chmod +x "$tmp/hci-up" "$tmp/hci-down"

  # `env`, not a bare assignment prefix: callers pass their OWN VAR=val prefixes (the
  # hciconfig stub), and a shell-function prefix would take those as the command name.
  fx() { env MESH_USB_DIR="$tmp" MESH_USB_NET_DIR="$tmp/net" MESH_USB_BT_DIR="$tmp/bt" \
             MESH_USB_UPTIME=18119 "$@"; }

  fail=""
  out=$(MESH_USB_DIR="$tmp" scan_devices)
  n=$(printf '%s\n' "$out" | grep -c .)
  [ "$n" = 3 ] || fail="$fail expected-3-devices-got-$n"
  printf '%s\n' "$out" | grep -q 'Kingston DataTraveler' || fail="$fail missing-peripheral"
  printf '%s\n' "$out" | grep -q 'Integrated Camera'     || fail="$fail missing-internal"
  printf '%s\n' "$out" | grep -q 'xHCI'                  && fail="$fail root-hub-not-excluded"
  perip=$(printf '%s\n' "$out" | awk -F'\t' '$3=="removable"' | grep -c .)
  [ "$perip" = 2 ] || fail="$fail expected-2-peripherals-got-$perip"
  # --list: stable TSV interface — same lines, 4 tab-separated columns. The age axis must
  # NOT have leaked into it (mesh-usb-events:167 hard-fails on NF!=4).
  lout=$(MESH_USB_DIR="$tmp" bash "$0" --list)
  [ "$lout" = "$out" ] || fail="$fail list-differs-from-scan"
  lcols=$(printf '%s\n' "$lout" | awk -F'\t' 'NF!=4{bad=1} END{print bad+0}')
  [ "$lcols" = 0 ] || fail="$fail list-not-4-columns"
  # absent bus → BLIND exit 2 (the honest-exit contract; --list inherits it)
  MESH_USB_DIR="$tmp/nonexistent" bash "$0" >/dev/null 2>&1
  [ $? -eq 2 ] || fail="$fail absent-bus-not-exit2"
  MESH_USB_DIR="$tmp/nonexistent" bash "$0" --list >/dev/null 2>&1
  [ $? -eq 2 ] || fail="$fail list-absent-bus-not-exit2"

  # ── age: units, banding, and the na-never-0 contract ────────────────────────────────
  a=$(MESH_USB_DIR="$tmp" device_age_sec 1-2.3)
  [ "$a" = 5001 ] || fail="$fail age-ms-to-s-wrong($a)"          # 5001786ms → 5001s, not 5001786
  a2=$(MESH_USB_DIR="$tmp" device_age_sec 1-5)
  [ "$a2" = na ] || fail="$fail missing-power-dir-not-na($a2)"   # NEVER 0
  a3=$(MESH_USB_DIR="$tmp" device_age_sec no-such-device)
  [ "$a3" = na ] || fail="$fail absent-device-not-na($a3)"
  [ "$(age_band 5001 18119)"  = reenum ]       || fail="$fail band-reenum-missed"
  [ "$(age_band 18000 18119)" = since-boot ]   || fail="$fail band-since-boot-missed"
  [ "$(age_band 120 18119)"   = fresh-reenum ] || fail="$fail band-fresh-missed"
  [ "$(age_band na 18119)"    = na ]           || fail="$fail band-na-missed"
  [ "$(age_band 5001 na)"     = na ]           || fail="$fail band-na-uptime-missed"

  # ── GATE 1: a device far younger than the node must NOT render as a healthy uplink ──
  ul=$(fx bash "$0" --age)
  printf '%s\n' "$ul" | awk -F'\t' '$1=="1-2.3" && $5=="reenum" && $6=="uplink"' | grep -q . \
    || fail="$fail age-mode-uplink-not-banded-reenum"
  ulh=$(fx bash "$0" | grep '^uplink:')
  case "$ulh" in
    *SINCE-BOOT*)     fail="$fail young-uplink-rendered-since-boot" ;;
    *REENUM*"NOT healthy"*) ;;
    *)                fail="$fail young-uplink-not-flagged[$ulh]" ;;
  esac
  printf '%s\n' "$ulh" | grep -q "up 1.4h of the node's 5.0h" \
    || fail="$fail uplink-line-missing-of-the-nodes-phrasing"
  # the inverse: a device as old as the node MUST read since-boot (a band that only ever
  # says "unhealthy" is as useless as one that only ever says "ok")
  echo 18100000 >"$tmp/1-2.3/power/runtime_active_time"
  ulh2=$(fx bash "$0" | grep '^uplink:')
  case "$ulh2" in *SINCE-BOOT*) ;; *) fail="$fail old-uplink-not-since-boot[$ulh2]" ;; esac
  echo 5001786 >"$tmp/1-2.3/power/runtime_active_time"
  # uplink not enumerated at all → ABSENT, never a quiet pass
  ula=$(MESH_USB_DIR="$tmp" MESH_USB_NET_DIR="$tmp/emptynet" MESH_USB_BT_DIR="$tmp/bt" \
        MESH_USB_UPTIME=18119 MESH_USB_UPLINK_ID=0bda:b82c bash "$0" | grep '^uplink:')
  case "$ula" in *ABSENT*"NOT healthy"*) ;; *) fail="$fail absent-uplink-not-flagged[$ula]" ;; esac

  # ── GATE 2: BT leg — bare form PINNED, down hci0 → na NEVER 0, age stamp present ─────
  : >"$tmp/hci.argv"
  bt=$(fx MESH_USB_HCI_CMD="$tmp/hci-up" bash "$0" --bt); btrc=$?
  [ "$btrc" = 0 ] || fail="$fail bt-up-rc$btrc"
  printf '%s\n' "$bt" | grep -q 'rx_errors=7'  || fail="$fail bt-rx-errors-not-parsed"
  printf '%s\n' "$bt" | grep -q 'commands=1153' || fail="$fail bt-commands-not-parsed"
  printf '%s\n' "$bt" | grep -q 'band=reenum'  || fail="$fail bt-missing-age-stamp"      # (b)
  printf '%s\n' "$bt" | grep -q 'cover<=1.4h'  || fail="$fail bt-missing-coverage-ceiling"
  # behavioural -a pin: the stub recorded exactly what we invoked it with.
  argv=$(cat "$tmp/hci.argv")
  [ "$argv" = "hci0" ] || fail="$fail hci-argv-not-bare[$argv]"
  case "$argv" in *-a*) fail="$fail hci-dash-a-issued" ;; esac
  # down controller → na, and NOT the zeros the stub is printing
  : >"$tmp/hci.argv"
  btd=$(fx MESH_USB_HCI_CMD="$tmp/hci-down" bash "$0" --bt); btdrc=$?
  [ "$btdrc" = 2 ] || fail="$fail bt-down-not-exit2($btdrc)"
  printf '%s\n' "$btd" | grep -q 'na'          || fail="$fail bt-down-not-na"
  printf '%s\n' "$btd" | grep -qE '(rx_errors|errors)=0' && fail="$fail bt-down-rendered-zero"  # (a)
  [ "$(cat "$tmp/hci.argv")" = "hci0" ] || fail="$fail hci-down-argv-not-bare"
  # hciconfig absent entirely → na exit 2, still never 0
  btm=$(fx MESH_USB_HCI_CMD="$tmp/no-such-hciconfig" bash "$0" --bt); btmrc=$?
  [ "$btmrc" = 2 ] || fail="$fail bt-missing-cmd-not-exit2($btmrc)"
  printf '%s\n' "$btm" | grep -q 'na' || fail="$fail bt-missing-cmd-not-na"
  printf '%s\n' "$btm" | grep -qE '=0( |$)' && fail="$fail bt-missing-cmd-rendered-zero"
  # --json carries the axis
  js=$(fx bash "$0" --json)
  printf '%s\n' "$js" | grep -q '"age_band":"reenum"' || fail="$fail json-missing-age-band"
  printf '%s\n' "$js" | grep -q '"age_sec":"na"'      || fail="$fail json-missing-na-age"

  # ── GATE 3: the xHCI leg. The verdict parser is PURE, so every branch is driven by a
  # canned dump — a live bus will not halt an endpoint or freeze a ring on request, and a
  # leg only ever exercised against the live reading is a leg that only ever agrees with it.
  mkdump() {  # <slotstate> <ep02state> <ep02type> <deq1> <enq1> <deq2> <enq2>
    local n t="$3"
    for n in 1 2; do
      if [ "$n" = 1 ]; then echo "SAMPLE 1 2026-08-18T01:00:00Z"; else echo "SAMPLE 2 2026-08-18T01:00:03Z"; fi
      echo "SLOT 0 0x00000000fe2c0000: RS 00003 high-speed Ctx Entries 16 MEL 0 us Port# 6/0 [TT Slot 0 Port# 0 TTT 0 Intr 0] Addr 5 State $1"
      echo "EPCTX 0"
      echo "EPCTXLINE 0x00000000fe2c0020: State running mult 1 max P. Streams 0 interval 125 us max ESIT payload 0 CErr 3 Type Ctrl burst 0 maxp 64 deq 00000000fe2b81e1 avg trb len 8"
      echo "EPCTXLINE 0x00000000fe2c0040: State disabled mult 1 max P. Streams 0 interval 125 us max ESIT payload 0 CErr 0 Type INVALID burst 0 maxp 0 deq 0000000000000000 avg trb len 0"
      echo "EPCTXLINE 0x00000000fe2c0060: State $2 mult 1 max P. Streams 0 interval 125 us max ESIT payload 0 CErr 3 Type $t burst 0 maxp 512 deq 00000000fdb8c001 avg trb len 0"
      echo "EP ep00 0 0x00000000fe2b81e0 0 0x00000000fe2b81e0"
      if [ "$n" = 1 ]; then echo "EP ep02 0 $4 0 $5"; else echo "EP ep02 0 $6 0 $7"; fi
    done
  }
  D0=0x00000000fdb8cde0; D1=0x00000000fdb8ce60; E0=0x00000000fdb8ce20; E1=0x00000000fdb8cea0

  # drained ring, pointers still → CLEAN
  v=$(mkdump configured running "Bulk OUT" "$D0" "$D0" "$D0" "$D0" | xhci_verdict "fx"); vrc=$?
  [ "$vrc" = 0 ] || fail="$fail xhci-clean-rc$vrc"
  case "$v" in *"verdict=CLEAN"*) ;; *) fail="$fail xhci-drained-not-clean" ;; esac
  case "$v" in *"0 ring(s) advanced, 0 with backlog"*) ;; *) fail="$fail xhci-drained-counts" ;; esac
  # THE NON-VACUITY GATE: backlog nonzero at BOTH samples but the dequeue ADVANCES — a busy
  # ring, not a wedge. A leg that called any backlog a wedge would fire on healthy traffic.
  v=$(mkdump configured running "Bulk OUT" "$D0" "$E0" "$D1" "$E1" | xhci_verdict "fx")
  case "$v" in *"verdict=CLEAN"*) ;; *) fail="$fail xhci-busy-advancing-misjudged[$v]" ;; esac
  case "$v" in *"backlog 4→4 trb"*) ;; *) fail="$fail xhci-backlog-arith-wrong" ;; esac   # 0x40/16
  case "$v" in *"1 ring(s) advanced, 1 with backlog"*) ;; *) fail="$fail xhci-advance-count" ;; esac
  # host→device backlog, dequeue FROZEN → LINK-WEDGE
  v=$(mkdump configured running "Bulk OUT" "$D0" "$E0" "$D0" "$E0" | xhci_verdict "fx")
  case "$v" in *"verdict=LINK-WEDGE"*) ;; *) fail="$fail xhci-frozen-out-backlog-not-wedge[$v]" ;; esac
  case "$v" in *"endpoint(s) ep02"*) ;; *) fail="$fail xhci-wedge-does-not-name-the-ep" ;; esac
  case "$v" in *"NOTHING advanced anywhere"*) ;; *) fail="$fail xhci-wedge-missing-silence-corroboration" ;; esac
  # THE DIRECTION GATE — the same pointers on an IN endpoint are an ARMED receive ring, the
  # resting state of a healthy device with nothing to say. Calling it a wedge is the false
  # positive the brief's undirected rule produced on this node's first live run.
  v=$(mkdump configured running "Bulk IN" "$D0" "$E0" "$D0" "$E0" | xhci_verdict "fx")
  case "$v" in *"verdict=CLEAN"*) ;; *) fail="$fail xhci-armed-IN-ring-called-a-wedge[$v]" ;; esac
  case "$v" in *"armed receive buffers"*) ;; *) fail="$fail xhci-armed-IN-not-explained" ;; esac
  v=$(mkdump configured running "Int IN" "$D0" "$E0" "$D0" "$E0" | xhci_verdict "fx")
  case "$v" in *"verdict=CLEAN"*) ;; *) fail="$fail xhci-armed-int-IN-called-a-wedge" ;; esac
  # …and Ctrl counts as host→device: a frozen, backlogged control ring IS a stall
  v=$(mkdump configured running "Ctrl" "$D0" "$E0" "$D0" "$E0" | xhci_verdict "fx")
  case "$v" in *"verdict=LINK-WEDGE"*) ;; *) fail="$fail xhci-frozen-ctrl-not-wedge" ;; esac
  # a halted endpoint outranks everything below it → DEVICE-STALL
  v=$(mkdump configured halted "Bulk OUT" "$D0" "$E0" "$D0" "$E0" | xhci_verdict "fx")
  case "$v" in *"verdict=DEVICE-STALL"*) ;; *) fail="$fail xhci-halted-not-stall" ;; esac
  case "$v" in *"clear-halt"*) ;; *) fail="$fail xhci-stall-missing-remedy" ;; esac
  v=$(mkdump configured error "Bulk OUT" "$D0" "$E0" "$D0" "$E0" | xhci_verdict "fx")
  case "$v" in *"verdict=DEVICE-STALL"*) ;; *) fail="$fail xhci-error-state-not-stall" ;; esac
  # a halted IN endpoint is still a stall — the direction rule must NOT leak into this leg
  v=$(mkdump configured halted "Bulk IN" "$D0" "$D0" "$D0" "$D0" | xhci_verdict "fx")
  case "$v" in *"verdict=DEVICE-STALL"*) ;; *) fail="$fail xhci-halted-IN-not-stall" ;; esac
  # slot no longer configured outranks the endpoints → DE-ENUMERATED
  v=$(mkdump addressed running "Bulk OUT" "$D0" "$E0" "$D0" "$E0" | xhci_verdict "fx")
  case "$v" in *"verdict=DE-ENUMERATED"*) ;; *) fail="$fail xhci-slot-not-deenum" ;; esac
  # a pointer gap wider than one ring segment is TWO ALLOCATIONS, not a backlog: the size
  # must render `xseg` rather than a fabricated TRB count — while still counting as
  # outstanding work, because deq != enq is sound whatever the addresses are.
  v=$(mkdump configured running "Bulk OUT" "$D0" 0x00000000ff000000 "$D0" 0x00000000ff000000 | xhci_verdict "fx")
  case "$v" in *"backlog xseg→xseg"*) ;; *) fail="$fail xhci-cross-segment-magnitude-invented[$v]" ;; esac
  case "$v" in *"verdict=LINK-WEDGE"*) ;; *) fail="$fail xhci-cross-segment-not-outstanding-work" ;; esac
  # the window caveat is PUBLISHED in every reading, not just the interesting ones
  v=$(mkdump configured running "Bulk OUT" "$D0" "$D0" "$D0" "$D0" | xhci_verdict "fx")
  case "$v" in *"window: 2 samples"*"NOT a claim about the interval"*) ;; *) fail="$fail xhci-window-not-published" ;; esac
  # (b) an unreadable slot-context renders na WITH the errno and exit 2 — never a default
  v=$( { echo "SAMPLE 1 t1"; echo "SLOT 1 cat: /sys/kernel/debug/usb/xhci/x/devices/05/slot-context: Operation not permitted";
         echo "EPCTX 1"; echo "SAMPLE 2 t2"; echo "SLOT 1 cat: Operation not permitted"; echo "EPCTX 1"; } \
       | xhci_verdict "fx"); vrc=$?
  [ "$vrc" = 2 ] || fail="$fail xhci-eperm-not-exit2($vrc)"
  case "$v" in *"na(EPERM"*) ;; *) fail="$fail xhci-eperm-not-errno[$v]" ;; esac
  case "$v" in *"verdict=CLEAN"*|*"backlog=0"*) fail="$fail xhci-eperm-rendered-a-verdict" ;; esac
  # a per-endpoint pointer EPERM renders na(EPERM) for THAT ring — not 0, not a wedge
  v=$( { mkdump configured running "Bulk OUT" "$D0" "$E0" "$D0" "$E0" \
         | sed 's|^EP ep02 0 .*|EP ep02 1 cat:_.../dequeue:_Operation_not_permitted 1 cat:_.../enqueue:_Operation_not_permitted|'; } \
       | xhci_verdict "fx")
  case "$v" in *"ep02"*"backlog=na(EPERM"*) ;; *) fail="$fail xhci-ep-eperm-not-na[$v]" ;; esac
  case "$v" in *"verdict=LINK-WEDGE"*) fail="$fail xhci-unreadable-ring-called-a-wedge" ;; esac
  # a truncated dump is blindness, never a reading
  v=$(mkdump configured running "Bulk OUT" "$D0" "$D0" "$D0" "$D0" | sed -n '1,7p' | xhci_verdict "fx"); vrc=$?
  [ "$vrc" = 2 ] || fail="$fail xhci-one-sample-not-exit2($vrc)"
  case "$v" in *"na(ESTREAM"*) ;; *) fail="$fail xhci-one-sample-not-na" ;; esac

  # ── GATE 4: end-to-end against a fixture debugfs tree — resolution, reads, dispatch.
  # The dongle sits at slot 07 and a DECOY sits at the historical slot 05, so anything that
  # hardcodes 05 (the slot the brief happened to measure) reads the wrong device.
  mkdir -p "$tmp/xhci/0000:02:00.0/devices/05" "$tmp/xhci/0000:02:00.0/devices/07/ep00" \
           "$tmp/xhci/0000:02:00.0/devices/07/ep02"
  echo "1-9"   >"$tmp/xhci/0000:02:00.0/devices/05/name"
  echo "1-2.3" >"$tmp/xhci/0000:02:00.0/devices/07/name"
  X7="$tmp/xhci/0000:02:00.0/devices/07"
  echo "0x00000000fe2c0000: RS 00003 high-speed Ctx Entries 16 MEL 0 us Port# 6/0 [TT Slot 0 Port# 0 TTT 0 Intr 0] Addr 5 State configured" >"$X7/slot-context"
  { echo "0x00000000fe2c0020: State running mult 1 max P. Streams 0 interval 125 us max ESIT payload 0 CErr 3 Type Ctrl burst 0 maxp 64 deq 00000000fe2b81e1 avg trb len 8"
    echo "0x00000000fe2c0040: State disabled mult 1 max P. Streams 0 interval 125 us max ESIT payload 0 CErr 0 Type INVALID burst 0 maxp 0 deq 0000000000000000 avg trb len 0"
    echo "0x00000000fe2c0060: State running mult 1 max P. Streams 0 interval 125 us max ESIT payload 0 CErr 3 Type Bulk OUT burst 0 maxp 512 deq 00000000fdb8c001 avg trb len 0"; } >"$X7/ep-context"
  echo "$D0" >"$X7/ep00/dequeue"; echo "$D0" >"$X7/ep00/enqueue"
  echo "$D0" >"$X7/ep02/dequeue"; echo "$E0" >"$X7/ep02/enqueue"
  xfx() { env MESH_USB_DIR="$tmp" MESH_USB_NET_DIR="$tmp/net" MESH_USB_BT_DIR="$tmp/bt" \
              MESH_USB_UPTIME=18119 MESH_USB_XHCI_DIR="$tmp/xhci" MESH_USB_XHCI_SUDO= \
              MESH_USB_XHCI_GAP=0 "$@"; }
  xe=$(xfx bash "$0" --xhci 1-2.3); xerc=$?
  [ "$xerc" = 0 ] || fail="$fail xhci-e2e-rc$xerc"
  case "$xe" in *"slot 07"*) ;; *) fail="$fail xhci-slot-not-resolved-by-name[$xe]" ;; esac
  case "$xe" in *"slot 05"*|*1-9*) fail="$fail xhci-resolved-the-decoy-slot" ;; esac
  case "$xe" in *"@HC 0000:02:00.0"*) ;; *) fail="$fail xhci-hc-not-reported" ;; esac
  # static fixture ⇒ dequeue frozen with a live backlog ⇒ the wedge verdict, end to end
  case "$xe" in *"verdict=LINK-WEDGE"*) ;; *) fail="$fail xhci-e2e-verdict[$xe]" ;; esac
  # no busid ⇒ the target is the UPLINK, resolved from the net fixture, not an argument
  xu=$(xfx bash "$0" --xhci)
  case "$xu" in *"1-2.3 @HC"*"slot 07"*) ;; *) fail="$fail xhci-default-target-not-uplink[$xu]" ;; esac
  # a device on no slot ⇒ na(ENODEV) exit 2, never a quiet pass
  xn=$(xfx bash "$0" --xhci 9-9); xnrc=$?
  [ "$xnrc" = 2 ] || fail="$fail xhci-unenumerated-not-exit2($xnrc)"
  case "$xn" in *"na(ENODEV"*) ;; *) fail="$fail xhci-unenumerated-not-na[$xn]" ;; esac
  # (c) no xhci debugfs at all ⇒ na(ENOENT) exit 2 — the phones and the router land here
  xa=$(env MESH_USB_DIR="$tmp" MESH_USB_NET_DIR="$tmp/net" MESH_USB_XHCI_DIR="$tmp/no-xhci" \
           MESH_USB_XHCI_SUDO= MESH_USB_XHCI_GAP=0 bash "$0" --xhci 1-2.3); xarc=$?
  [ "$xarc" = 2 ] || fail="$fail xhci-absent-debugfs-not-exit2($xarc)"
  case "$xa" in *"na(ENOENT"*) ;; *) fail="$fail xhci-absent-debugfs-not-na[$xa]" ;; esac
  case "$xa" in *"verdict="*) fail="$fail xhci-absent-debugfs-rendered-a-verdict" ;; esac

  rm -rf "$tmp"

  # ── REAL-READ GATE (a fixture-driven gate cannot cover the live path) ───────────────
  real_note="no live bus"
  if [ -d "$(usb_dir)" ]; then
    rup=$(node_uptime_sec)
    [ "$rup" != na ] || fail="$fail live-uptime-na"
    if rref="$(uplink_ref)"; then
      rbus="${rref%%	*}"; rage="$(device_age_sec "$rbus")"
      [ "$rage" != na ] || fail="$fail live-uplink-age-na(power/runtime_*_time unreadable)"
      case "$rage" in ''|*[!0-9]*) ;; *) [ "$rage" -gt 0 ] || fail="$fail live-uplink-age-zero" ;; esac
      rband="$(age_band "$rage" "$rup")"
      case "$rband" in since-boot|reenum|fresh-reenum) ;; *) fail="$fail live-band-bogus($rband)" ;; esac
      real_note="live uplink ${rref##*	}@$rbus age=$(fmt_age "$rage") band=$rband of node $(fmt_age "$rup")"
    else
      real_note="live bus, no USB-attached net iface (uplink axis n/a here)"
    fi
    # bare hci read on the REAL controller: rc 0 (counters) or 2 (honest na). Never a zero.
    rbt=$(bt_line); rbtrc=$?
    case "$rbtrc" in
      0) printf '%s\n' "$rbt" | grep -q 'cover<=' || fail="$fail live-bt-missing-coverage-stamp"
         real_note="$real_note; live bt read ok" ;;
      2) printf '%s\n' "$rbt" | grep -q 'na' || fail="$fail live-bt-blind-not-na"
         real_note="$real_note; live bt n/a (honest)" ;;
      *) fail="$fail live-bt-rc$rbtrc" ;;
    esac
  fi

  # ── REAL-READ GATE, xHCI half ───────────────────────────────────────────────────────
  xhci_note="no xhci debugfs"; xhci_here=0
  xprobe="$(xhci_slot_dir __probe__)"; xprc=$?
  case "$xprc" in
    3) xhci_here=0 ;;                        # (c): no endpoint contexts on this host
    1) xhci_here=1 ;;                        # root readable, that busid simply is not there
    4) xhci_here=0; xhci_note="xhci debugfs present but UNREADABLE ($(_errno_of "$xprobe")) — sudo -n did not land" ;;
    *) xhci_here=1 ;;
  esac
  if [ "$xhci_here" = 1 ]; then
    rx="$(xhci_line)"; rxrc=$?
    case "$rxrc" in
      0) printf '%s\n' "$rx" | grep -q 'verdict=' || fail="$fail live-xhci-no-verdict"
         printf '%s\n' "$rx" | grep -q 'window: 2 samples' || fail="$fail live-xhci-window-not-published"
         printf '%s\n' "$rx" | grep -qE 'verdict=(CLEAN|LINK-WEDGE|DEVICE-STALL|DE-ENUMERATED)' \
           || fail="$fail live-xhci-bogus-verdict"
         xhci_note="live: $(printf '%s\n' "$rx" | head -1 | sed 's/^xhci: //')" ;;
      2) printf '%s\n' "$rx" | grep -q 'na(' || fail="$fail live-xhci-blind-without-errno"
         xhci_note="live xhci n/a (honest): $(printf '%s\n' "$rx" | head -1)" ;;
      *) fail="$fail live-xhci-rc$rxrc" ;;
    esac
    # (d) THE BACKLOG LEG MUST BE SEEN NONZERO. A host→device ring is drained at rest, so a
    # leg that never watches one under load is `a-gate-can-be-vacuous-because-the-live-
    # reading-agrees`. This drives REAL traffic over the uplink and FAILS if the axis the
    # wedge verdict keys on never moves. OPT-IN — MESH_USB_XHCI_TRAFFIC=<shell command>
    # (a command, not a URL: what counts as "a large transfer over the uplink" is the
    # node's business — an scp to a peer here, a curl elsewhere) — because mesh-doctor runs
    # every --test hourly and a self-test must not mint traffic on a metered, wedging link.
    if [ -n "${MESH_USB_XHCI_TRAFFIC:-}" ]; then
      tslot="$(xhci_slot_dir "$(uplink_ref | cut -f1)")" || fail="$fail traffic-slot-unresolved"
      if [ -n "${tslot:-}" ]; then
        # An EQUAL CONTROL WINDOW first, driven by nothing. On a node with ambient load the
        # host→device axis is already nonzero at rest — measured here — so "nonzero under
        # traffic" does not by itself discriminate, and a leg that only reported the driven
        # number would look like proof while proving nothing. Both windows are published;
        # the assertion is only the vacuity FLOOR (a driven zero means the axis is dead),
        # and the control is reported so a reader can see for themselves whether the driven
        # traffic actually moved it.
        cmax="$(xhci_backlog_watch "$tslot" "${MESH_USB_XHCI_TRAFFIC_SECS:-12}")"
        ( sh -c "$MESH_USB_XHCI_TRAFFIC" >/dev/null 2>&1 & )
        tmax="$(xhci_backlog_watch "$tslot" "${MESH_USB_XHCI_TRAFFIC_SECS:-12}")"
        tout="${tmax%% *}"; tin="${tmax##* }"; cout="${cmax%% *}"; cin="${cmax##* }"
        case "$tout" in
          ''|*[!0-9]*) fail="$fail traffic-backlog-unreadable($tmax)" ;;
          0)           fail="$fail traffic-host-to-device-backlog-never-nonzero(the wedge axis was never seen to move)" ;;
          *)           xhci_note="$xhci_note; backlog max host→device/IN: control ${cout}/${cin}trb vs driven ${tout}/${tin}trb over ${MESH_USB_XHCI_TRAFFIC_SECS:-12}s each" ;;
        esac
      fi
    fi
  fi

  if [ -n "$fail" ]; then echo "smoke-test: FAIL ($fail )"; exit 1; fi
  base="3 devices, root hub excluded, --list still 4-col; age ms→s + na-never-0 + 4 bands; young uplink flagged NOT healthy, old one since-boot, absent one ABSENT; bt bare-pinned argv=hci0, down→na exit2 not 0, age-stamped with cover<=; xhci verdicts driven on canned dumps (drained→CLEAN, backlogged-but-ADVANCING→CLEAN, backlogged+FROZEN→LINK-WEDGE, halted/error→DEVICE-STALL, slot≠configured→DE-ENUMERATED, EPERM→na+errno exit2, 1-sample→na), slot resolved by name past a decoy at the historical slot 05; $real_note; $xhci_note"
  if [ "$xhci_here" != 1 ]; then
    echo "smoke-test: n/a — every portable gate passed, but this host exposes no xHCI endpoint contexts ($xhci_note), so the wedge leg is unassessable here ($base)"
    exit 2
  fi
  echo "smoke-test: ok ($base)"
  exit 0
fi

# --- availability: the honest exit-2 gate -----------------------------------------
DIR="$(usb_dir)"
if [ ! -d "$DIR" ]; then
  echo "mesh-usb: BLIND — no USB bus at $DIR (VM/container without USB passthrough) — NOT '0 devices'"
  exit 2
fi

# --- stable machine interface (the delta layer's input) --------------------------
if [ "${1:-}" = "--list" ]; then
  scan_devices
  exit 0
fi

# --- the BT half: second vantage on the combo silicon ----------------------------
if [ "${1:-}" = "--bt" ]; then
  bt_line
  exit $?
fi

# --- the controller's own view: xHCI endpoint contexts ---------------------------
# Deliberately NOT folded into the default read or --json: it costs a privileged read
# plus a XHCI_GAP-second window, and neither of those belongs in an inventory query.
if [ "${1:-}" = "--xhci" ]; then
  xhci_line "${2:-}"
  exit $?
fi

UPTIME_SEC="$(node_uptime_sec)"
UPLINK_BUS=""
if _ref="$(uplink_ref)"; then UPLINK_BUS="${_ref%%	*}"; fi

# --- the age axis: machine TSV ----------------------------------------------------
# <busid>\t<vid:pid>\t<age_sec>\t<uptime_sec>\t<band>\t<role>\t<name>
if [ "${1:-}" = "--age" ]; then
  _walk_devices | while IFS=$'\t' read -r busid vid pid rem spd prod; do
    [ -n "$busid" ] || continue
    age="$(device_age_sec "$busid")"
    printf '%s\t%s:%s\t%s\t%s\t%s\t%s\t%s\n' \
      "$busid" "$vid" "$pid" "$age" "$UPTIME_SEC" "$(age_band "$age" "$UPTIME_SEC")" \
      "$([ "$busid" = "$UPLINK_BUS" ] && echo uplink || echo -)" "$prod"
  done
  exit 0
fi

devs="$(scan_devices)"
total=$(printf '%s\n' "$devs" | grep -c .)
periph=$(printf '%s\n' "$devs" | awk -F'\t' '$3=="removable"' | grep -c .)
internal=$(printf '%s\n' "$devs" | awk -F'\t' '$3=="fixed"' | grep -c .)
other=$(( total - periph - internal ))

# --- json -------------------------------------------------------------------------
if [ "${1:-}" = "--json" ]; then
  printf '{"total":%s,"peripheral":%s,"internal":%s,"other":%s,"uptime_sec":"%s","devices":[' \
    "$total" "$periph" "$internal" "$other" "$UPTIME_SEC"
  first=1
  while IFS=$'\t' read -r busid vid pid rem spd prod; do
    [ -n "$busid" ] || continue
    age="$(device_age_sec "$busid")"
    [ "$first" = 1 ] || printf ','
    first=0
    printf '{"bus":"%s","name":"%s","id":"%s:%s","removable":"%s","speed_mbps":"%s","age_sec":"%s","age_band":"%s","role":"%s"}' \
      "$busid" "$(echo "$prod" | sed 's/"/\\"/g')" "$vid" "$pid" "$rem" "$spd" \
      "$age" "$(age_band "$age" "$UPTIME_SEC")" \
      "$([ "$busid" = "$UPLINK_BUS" ] && echo uplink || echo -)"
  done < <(_walk_devices)
  printf '],"uplink":"%s","bt":"%s"}\n' \
    "$(uplink_line | sed 's/"/\\"/g')" "$(bt_line | sed 's/"/\\"/g')"
  exit 0
fi

# --- one-shot human read ----------------------------------------------------------
echo "usb: $total device(s) on the bus — ${periph} peripheral(removable) · ${internal} internal(fixed)$([ "$other" -gt 0 ] && echo " · ${other} other") — node up $(fmt_age "$UPTIME_SEC")"
while IFS=$'\t' read -r busid vid pid rem spd prod; do
  [ -n "$busid" ] || continue
  tag=$rem; [ "$rem" = removable ] && tag="PERIPHERAL"; [ "$rem" = fixed ] && tag="internal"
  age="$(device_age_sec "$busid")"; band="$(age_band "$age" "$UPTIME_SEC")"
  echo "  • $prod [$vid:$pid] @$busid ${tag} ${spd}Mbps age=$(fmt_age "$age")($band)$([ "$busid" = "$UPLINK_BUS" ] && echo ' ←UPLINK')"
done < <(_walk_devices)
uplink_line
bt_line
exit 0
