#!/usr/bin/env bash
# mesh-usb — USB-ATTACH sense: what is PHYSICALLY plugged into this host's USB bus.
#   The USB host controller perceives device attach/removal — a real-world physical
#   signal (operator plugs in a phone, thumb drive, yubikey, audio dongle) that the
#   mesh was blind to. Complements mesh-lan-newdevice (LAN arrivals) and
#   mesh-presence (BLE proximity): a third arrival channel, the WIRED one.
#   Reads /sys/bus/usb/devices/*/{product,idVendor,idProduct,removable,speed},
#   EXCLUDES the controllers' own root hubs (Linux Foundation, vid 1d6b), and splits
#   real devices by the kernel's `removable` attribute into INTERNAL (fixed — soldered:
#   camera, fingerprint, builtin BT) vs PERIPHERAL (removable — the operator physically
#   attached it). Interface dirs (e.g. 1-5:1.0) carry no `product` file → ignored.
# HONEST: exit 2 (BLIND) when /sys/bus/usb is absent — a VM / container with no USB
#   passthrough cannot perceive the bus; we report BLIND, never a faked "0 devices /
#   all-clear" from an unreadable bus (the honest-exit contract: exit 2 = cannot
#   assess, never fabricated). A genuinely empty bus (dir present, no peripherals) is
#   a real exit-0 reading and is reported distinctly.
#
# ── THE AGE AXIS (2026-08-17) ────────────────────────────────────────────────────────
# present/absent is too coarse for a WEDGING device. A dongle that died and re-enumerated
# reads exactly as present as one that has been up since boot, so every wedge consumer
# (mesh-hw-fault-watch, mesh-usb-events, the health dash) saw a green bus through an
# outage. The kernel already carries the missing bit: power/runtime_active_time +
# power/runtime_suspended_time, both in MILLISECONDS, summing to how long THIS device
# node has existed. Verified on this node 2026-08-17: hub 1-2 sums to 18118.1s against
# /proc/uptime 18119.4s (3s), while the uplink 1-2.3 read 5001.8s — a device 3.6h younger
# than its own hub, i.e. it re-enumerated mid-uptime. Corroborated by a second surface
# (idVendor mtime, 17:02:55.667 vs the age-derived 17:02:56).
#   So: age= per device, banded against node uptime —
#     since-boot   age within AGE_BOOT_TOL of uptime — the device the node booted with
#     reenum       materially younger than the node — it re-enumerated after boot (WEDGE)
#     fresh-reenum younger than AGE_FRESH_SEC — it re-enumerated within the last minutes
#     na           power/runtime_*_time absent/unreadable (CONFIG_PM off) — NEVER 0
#   The uplink is identified from /sys/class/net/*/device resolving under a usbN path —
#   deliberately NOT from the default route, which is the artifact a wedge DELETES
#   (mesh-link-heal printed n/a through the whole 16:04→17:03Z outage for exactly that
#   reason, 5a04e4f). A device that is gone renders ABSENT, which is not a healthy read.
#
# ── THE BT LEG, AND WHY `hciconfig -a` IS REFUSED ────────────────────────────────────
# The uplink here is a COMBO chip: 1-2.3:1.0 + :1.1 are btusb, 1-2.3:1.2 is rtw_8822bu —
# one USB device, two stacks. That makes the BT half a SECOND, INDEPENDENT VANTAGE on the
# same silicon, and it is the passive way to settle the open wedge hypothesis (wifi-only
# fault vs whole-device fault) without touching the radio.
#   PINNED: bare `hciconfig <dev>`. It is an HCIGETDEVINFO ioctl against kernel-cached
#   stats. `-a` is REFUSED because it additionally issues Read Local Name / Class of
#   Device / Local Version — HCI commands AT THE CONTROLLER — and the controller we are
#   polling is the one that is faulting. Driving wedged silicon to take its temperature is
#   the "a real hardware test leg is an attack" rule. Same reason we never reach for the
#   discovery path (mesh-bt-census's scan actively drives the radio).
#   COST FIGURES ARE UNATTRIBUTABLE, and this header will not quote one. The commands
#   counter has a THIRD-PARTY WRITER — bluetoothd is live on this node and the controller
#   has been observed UP RUNNING INQUIRY — so a measured +3 across an `-a` call and a +0
#   across a bare call are both single samples of a bursty background (health measured
#   978→980 in 2s then 998/998/998 flat then +4, issuing nothing at all). You cannot
#   cost-attribute your own call on a counter someone else is writing. The pin rests on
#   FIRST PRINCIPLES — ioctl-on-cached-stats vs commands-on-the-wire — not on that data.
#   (a) hci0 down / absent / unreadable renders `na`, NEVER 0. A zero on a fault axis is a
#       fabricated all-clear.
#   (b) every counter read is STAMPED with the device age, because the counters are
#       since-hci0-up and a USB reset zeroes them. errors:0 over a 1.4h-old device says
#       nothing whatsoever about a 3.6h-old outage; `covers<=` names that ceiling inline so
#       a consumer cannot mistake the narrow claim for the wide one.
#
# orphan-ok: on-demand inventory query (like mesh-find / mesh-lan-newdevice's scan) —
#   pulled when asked or by a fusion consumer, not a scheduled reflex. Stateless
#   (no change-gated artifact), so no mesh-state-touch needed.
# Modes: (none) human read · --json · --list (STABLE machine interface: the raw TSV
#   <product>\t<vid:pid>\t<removable>\t<speed> lines — consumed by mesh-usb-events'
#   delta layer; treat the 4-column shape as a consumer contract; the age axis is
#   deliberately NOT bolted on here, it has its own mode) · --age · --bt · --test
set -u

ROOT_HUB_VID="1d6b"   # Linux Foundation — the controllers' own root hubs, not peripherals
AGE_BOOT_TOL="${MESH_USB_AGE_BOOT_TOL:-120}"    # s: within this of uptime ⇒ present since boot
AGE_FRESH_SEC="${MESH_USB_AGE_FRESH_SEC:-300}"  # s: younger than this ⇒ just re-enumerated

usb_dir() { echo "${MESH_USB_DIR:-/sys/bus/usb/devices}"; }
net_dir() { echo "${MESH_USB_NET_DIR:-/sys/class/net}"; }
bt_dir()  { echo "${MESH_USB_BT_DIR:-/sys/class/bluetooth}"; }
hci_dev() { echo "${MESH_USB_HCI_DEV:-hci0}"; }

# _walk_devices — the ONE place the root-hub filter and the "product file ⇒ device node"
# rule live. Emits: <busid>\t<vid>\t<pid>\t<removable>\t<speed>\t<product>
_walk_devices() {
  local dir d prod vid pid rem spd
  dir="$(usb_dir)"
  for d in "$dir"/*/; do
    [ -e "$d/product" ] || continue            # only device nodes present a product string
    vid=$(cat "$d/idVendor" 2>/dev/null)
    [ "$vid" = "$ROOT_HUB_VID" ] && continue    # skip the controllers' own root hubs
    prod=$(cat "$d/product" 2>/dev/null)
    pid=$(cat "$d/idProduct" 2>/dev/null)
    rem=$(cat "$d/removable" 2>/dev/null); rem="${rem:-unknown}"
    spd=$(cat "$d/speed" 2>/dev/null)
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$(basename "$d")" "$vid" "$pid" "$rem" "${spd:-?}" "${prod:-?}"
  done
}

# scan_devices — the STABLE 4-column consumer contract (mesh-usb-events diffs on it).
scan_devices() {
  _walk_devices | awk -F'\t' '{printf "%s\t%s:%s\t%s\t%s\n", $6, $2, $3, $4, $5}'
}

# ── age ───────────────────────────────────────────────────────────────────────────────
# node_uptime_sec — integer seconds, or `na`. NEVER 0: an unreadable clock is blindness.
node_uptime_sec() {
  local u
  u="${MESH_USB_UPTIME:-}"
  [ -n "$u" ] || u=$(cut -d' ' -f1 /proc/uptime 2>/dev/null)
  case "$u" in ''|*[!0-9.]*) echo na; return ;; esac
  awk -v u="$u" 'BEGIN{printf "%d", u}'
}

# device_age_sec <busid> — integer seconds this device node has existed, or `na`.
# active+suspended are MILLISECONDS. A missing/garbage read is `na`, never 0 — a zero here
# would read as "just re-enumerated", the loudest possible fabricated alarm.
device_age_sec() {
  local d a s
  d="$(usb_dir)/$1"
  a=$(cat "$d/power/runtime_active_time" 2>/dev/null)
  s=$(cat "$d/power/runtime_suspended_time" 2>/dev/null)
  case "$a" in ''|*[!0-9]*) echo na; return ;; esac
  case "$s" in ''|*[!0-9]*) echo na; return ;; esac
  echo $(( (a + s) / 1000 ))
}

# age_band <age_sec> <uptime_sec>
age_band() {
  local a="$1" u="$2"
  [ "$a" = na ] && { echo na; return; }
  [ "$u" = na ] && { echo na; return; }
  if [ "$a" -ge $(( u - AGE_BOOT_TOL )) ]; then echo since-boot
  elif [ "$a" -lt "$AGE_FRESH_SEC" ];     then echo fresh-reenum
  else                                          echo reenum
  fi
}

fmt_age() { awk -v s="$1" 'BEGIN{ if(s=="na"){print "na"; exit} printf "%.1fh", s/3600 }'; }

# _busid_from_syspath — pull the deepest usb devpath component out of a resolved sysfs
# path and strip any interface suffix (1-2.3:1.2 → 1-2.3).
_busid_from_syspath() {
  local b
  b=$(printf '%s' "$1" | tr '/' '\n' | grep -E '^[0-9]+-[0-9]+(\.[0-9]+)*(:[0-9]+\.[0-9]+)?$' | tail -1)
  printf '%s' "${b%%:*}"
}

# uplink_ref — "<busid>\t<ifname>" for the first net interface whose device resolves under
# a usbN path. Route-INDEPENDENT on purpose (see the header): the wedge deletes the route.
uplink_ref() {
  local n real busid
  for n in "$(net_dir)"/*; do
    [ -e "$n/device" ] || continue
    real="$(readlink -f "$n/device" 2>/dev/null)" || continue
    case "$real" in *"/usb"*) ;; *) continue ;; esac
    busid="$(_busid_from_syspath "$real")"
    [ -n "$busid" ] && { printf '%s\t%s\n' "$busid" "$(basename "$n")"; return 0; }
  done
  return 1
}

# bt_ref — "<busid>" of the USB device carrying the pinned hci device, or non-zero.
bt_ref() {
  local p real busid
  p="$(bt_dir)/$(hci_dev)"
  [ -e "$p" ] || return 1
  real="$(readlink -f "$p" 2>/dev/null)" || return 1
  case "$real" in *"/usb"*) ;; *) return 1 ;; esac
  busid="$(_busid_from_syspath "$real")"
  [ -n "$busid" ] || return 1
  printf '%s\n' "$busid"
}

# uplink_line — the banded one-liner every wedge consumer reads instead of present/absent.
uplink_line() {
  local ref busid ifn age up band when
  up="$(node_uptime_sec)"
  if ! ref="$(uplink_ref)"; then
    if [ -n "${MESH_USB_UPLINK_ID:-}" ]; then
      echo "uplink: ABSENT — pinned $MESH_USB_UPLINK_ID not enumerated on the bus (node up $(fmt_age "$up")) — NOT healthy"
    else
      echo "uplink: na — no USB-attached net interface on this node (uplink is not on the bus)"
    fi
    return
  fi
  busid="${ref%%	*}"; ifn="${ref##*	}"
  age="$(device_age_sec "$busid")"
  band="$(age_band "$age" "$up")"
  case "$band" in
    since-boot) echo "uplink: $ifn @$busid — up $(fmt_age "$age") of the node's $(fmt_age "$up") — SINCE-BOOT" ;;
    na)         echo "uplink: $ifn @$busid — age na (power/runtime_*_time unreadable) — cannot assess, NOT clear" ;;
    *)          when=$(awk -v a="$age" 'BEGIN{printf "%d", a}')
                when=$(date -u -d "@$(( $(date +%s) - when ))" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)
                echo "uplink: $ifn @$busid — up $(fmt_age "$age") of the node's $(fmt_age "$up") — ${band^^} (re-enumerated ${when:-?}, the node did not) — NOT healthy" ;;
  esac
}

# bt_line — the SECOND vantage on the same silicon. Bare read only; n/a never 0.
# Exit 0 when a counter set was read, 2 when the axis is honestly blind.
bt_line() {
  local dev busid age up band out state rxe txe ev cmd
  dev="$(hci_dev)"; up="$(node_uptime_sec)"
  command -v "${MESH_USB_HCI_CMD:-hciconfig}" >/dev/null 2>&1 || {
    echo "bt: $dev na — hciconfig absent (counters unreadable, NOT 0)"; return 2; }
  # PINNED BARE — no -a, ever. See the header: -a issues HCI commands at a faulting controller.
  out="$("${MESH_USB_HCI_CMD:-hciconfig}" "$dev" 2>/dev/null)" || {
    echo "bt: $dev na — hciconfig read failed (counters unreadable, NOT 0)"; return 2; }
  [ -n "$out" ] || { echo "bt: $dev na — no such controller (counters unreadable, NOT 0)"; return 2; }
  state=$(printf '%s\n' "$out" | awk '/UP|DOWN/{gsub(/^[ \t]+|[ \t]+$/,""); print; exit}')
  case "$state" in *UP*) ;; *)
    echo "bt: $dev na — controller ${state:-DOWN} (counters are since-up and this one is not up; NOT 0)"
    return 2 ;;
  esac
  rxe=$(printf '%s\n' "$out" | awk '/RX bytes/{for(i=1;i<=NF;i++) if($i ~ /^errors:/){sub(/errors:/,"",$i); print $i; exit}}')
  txe=$(printf '%s\n' "$out" | awk '/TX bytes/{for(i=1;i<=NF;i++) if($i ~ /^errors:/){sub(/errors:/,"",$i); print $i; exit}}')
  ev=$(printf  '%s\n' "$out" | awk '/events:/{for(i=1;i<=NF;i++) if($i ~ /^events:/){sub(/events:/,"",$i); print $i; exit}}')
  cmd=$(printf '%s\n' "$out" | awk '/commands:/{for(i=1;i<=NF;i++) if($i ~ /^commands:/){sub(/commands:/,"",$i); print $i; exit}}')
  for v in rxe txe ev cmd; do
    eval "case \"\$$v\" in ''|*[!0-9]*) $v=na ;; esac"
  done
  # (b) STAMP: the counters cannot speak to anything older than the device.
  if busid="$(bt_ref)"; then
    age="$(device_age_sec "$busid")"; band="$(age_band "$age" "$up")"
    echo "bt: $dev @$busid $state rx_errors=$rxe tx_errors=$txe events=$ev commands=$cmd — dev-age $(fmt_age "$age") band=$band, counters since-device-up so they cover<=$(fmt_age "$age") of the node's $(fmt_age "$up")"
  else
    echo "bt: $dev (no USB parent) $state rx_errors=$rxe tx_errors=$txe events=$ev commands=$cmd — dev-age na, counter coverage UNKNOWN"
  fi
  return 0
}

# --- portable logic self-test (no real USB bus needed: runs against a fixture) ----
if [ "${1:-}" = "--test" ]; then
  tmp=$(mktemp -d)
  # a removable peripheral — present since boot (age ≈ uptime)
  mkdir -p "$tmp/2-1/power"; printf 'Kingston DataTraveler' >"$tmp/2-1/product"
  echo 0951 >"$tmp/2-1/idVendor"; echo 1666 >"$tmp/2-1/idProduct"
  echo removable >"$tmp/2-1/removable"; echo 5000 >"$tmp/2-1/speed"
  echo 17000000 >"$tmp/2-1/power/runtime_active_time"; echo 1000000 >"$tmp/2-1/power/runtime_suspended_time"
  # a fixed internal device — no power/ dir at all (CONFIG_PM off) → age na
  mkdir -p "$tmp/1-5"; printf 'Integrated Camera' >"$tmp/1-5/product"
  echo 174f >"$tmp/1-5/idVendor"; echo 118d >"$tmp/1-5/idProduct"
  echo fixed >"$tmp/1-5/removable"; echo 480 >"$tmp/1-5/speed"
  # THE UPLINK — a combo dongle that re-enumerated mid-uptime (1.4h into an 5.0h node)
  mkdir -p "$tmp/1-2.3/power"; printf 'RTL8822BU' >"$tmp/1-2.3/product"
  echo 0bda >"$tmp/1-2.3/idVendor"; echo b82c >"$tmp/1-2.3/idProduct"
  echo removable >"$tmp/1-2.3/removable"; echo 480 >"$tmp/1-2.3/speed"
  echo 5001786 >"$tmp/1-2.3/power/runtime_active_time"; echo 0 >"$tmp/1-2.3/power/runtime_suspended_time"
  # a root hub (MUST be excluded)
  mkdir -p "$tmp/usb1"; printf 'xHCI Host Controller' >"$tmp/usb1/product"
  echo 1d6b >"$tmp/usb1/idVendor"; echo 0002 >"$tmp/usb1/idProduct"; echo unknown >"$tmp/usb1/removable"
  # an interface dir (no product → MUST be ignored)
  mkdir -p "$tmp/1-5:1.0"
  # fixture net dir: wlan0 → .../usb1/1-2.3/1-2.3:1.2 (an INTERFACE path, as the kernel gives it)
  mkdir -p "$tmp/net/wlan0" "$tmp/sys/pci/usb1/1-2.3/1-2.3:1.2"
  ln -s "$tmp/sys/pci/usb1/1-2.3/1-2.3:1.2" "$tmp/net/wlan0/device"
  # fixture bluetooth dir: hci0 → .../usb1/1-2.3/1-2.3:1.0/bluetooth/hci0 (same device, other stack)
  mkdir -p "$tmp/bt" "$tmp/sys/pci/usb1/1-2.3/1-2.3:1.0/bluetooth/hci0"
  ln -s "$tmp/sys/pci/usb1/1-2.3/1-2.3:1.0/bluetooth/hci0" "$tmp/bt/hci0"
  # fixture hciconfig stubs. Each RECORDS ITS ARGV — that is how we assert the -a pin
  # behaviourally instead of grepping our own source (a self-matching grep asserts nothing).
  cat >"$tmp/hci-up" <<STUB
#!/usr/bin/env bash
printf '%s\n' "\$*" >>"$tmp/hci.argv"
cat <<'EOF'
hci0:	Type: Primary  Bus: USB
	BD Address: 00:13:25:AC:CD:1B  ACL MTU: 1021:8  SCO MTU: 255:16
	UP RUNNING
	RX bytes:501386 acl:0 sco:0 events:5067 errors:7
	TX bytes:30568 acl:0 sco:0 commands:1153 errors:0
EOF
STUB
  cat >"$tmp/hci-down" <<STUB
#!/usr/bin/env bash
printf '%s\n' "\$*" >>"$tmp/hci.argv"
cat <<'EOF'
hci0:	Type: Primary  Bus: USB
	BD Address: 00:13:25:AC:CD:1B  ACL MTU: 1021:8  SCO MTU: 255:16
	DOWN
	RX bytes:0 acl:0 sco:0 events:0 errors:0
	TX bytes:0 acl:0 sco:0 commands:0 errors:0
EOF
STUB
  chmod +x "$tmp/hci-up" "$tmp/hci-down"

  # `env`, not a bare assignment prefix: callers pass their OWN VAR=val prefixes (the
  # hciconfig stub), and a shell-function prefix would take those as the command name.
  fx() { env MESH_USB_DIR="$tmp" MESH_USB_NET_DIR="$tmp/net" MESH_USB_BT_DIR="$tmp/bt" \
             MESH_USB_UPTIME=18119 "$@"; }

  fail=""
  out=$(MESH_USB_DIR="$tmp" scan_devices)
  n=$(printf '%s\n' "$out" | grep -c .)
  [ "$n" = 3 ] || fail="$fail expected-3-devices-got-$n"
  printf '%s\n' "$out" | grep -q 'Kingston DataTraveler' || fail="$fail missing-peripheral"
  printf '%s\n' "$out" | grep -q 'Integrated Camera'     || fail="$fail missing-internal"
  printf '%s\n' "$out" | grep -q 'xHCI'                  && fail="$fail root-hub-not-excluded"
  perip=$(printf '%s\n' "$out" | awk -F'\t' '$3=="removable"' | grep -c .)
  [ "$perip" = 2 ] || fail="$fail expected-2-peripherals-got-$perip"
  # --list: stable TSV interface — same lines, 4 tab-separated columns. The age axis must
  # NOT have leaked into it (mesh-usb-events:167 hard-fails on NF!=4).
  lout=$(MESH_USB_DIR="$tmp" bash "$0" --list)
  [ "$lout" = "$out" ] || fail="$fail list-differs-from-scan"
  lcols=$(printf '%s\n' "$lout" | awk -F'\t' 'NF!=4{bad=1} END{print bad+0}')
  [ "$lcols" = 0 ] || fail="$fail list-not-4-columns"
  # absent bus → BLIND exit 2 (the honest-exit contract; --list inherits it)
  MESH_USB_DIR="$tmp/nonexistent" bash "$0" >/dev/null 2>&1
  [ $? -eq 2 ] || fail="$fail absent-bus-not-exit2"
  MESH_USB_DIR="$tmp/nonexistent" bash "$0" --list >/dev/null 2>&1
  [ $? -eq 2 ] || fail="$fail list-absent-bus-not-exit2"

  # ── age: units, banding, and the na-never-0 contract ────────────────────────────────
  a=$(MESH_USB_DIR="$tmp" device_age_sec 1-2.3)
  [ "$a" = 5001 ] || fail="$fail age-ms-to-s-wrong($a)"          # 5001786ms → 5001s, not 5001786
  a2=$(MESH_USB_DIR="$tmp" device_age_sec 1-5)
  [ "$a2" = na ] || fail="$fail missing-power-dir-not-na($a2)"   # NEVER 0
  a3=$(MESH_USB_DIR="$tmp" device_age_sec no-such-device)
  [ "$a3" = na ] || fail="$fail absent-device-not-na($a3)"
  [ "$(age_band 5001 18119)"  = reenum ]       || fail="$fail band-reenum-missed"
  [ "$(age_band 18000 18119)" = since-boot ]   || fail="$fail band-since-boot-missed"
  [ "$(age_band 120 18119)"   = fresh-reenum ] || fail="$fail band-fresh-missed"
  [ "$(age_band na 18119)"    = na ]           || fail="$fail band-na-missed"
  [ "$(age_band 5001 na)"     = na ]           || fail="$fail band-na-uptime-missed"

  # ── GATE 1: a device far younger than the node must NOT render as a healthy uplink ──
  ul=$(fx bash "$0" --age)
  printf '%s\n' "$ul" | awk -F'\t' '$1=="1-2.3" && $5=="reenum" && $6=="uplink"' | grep -q . \
    || fail="$fail age-mode-uplink-not-banded-reenum"
  ulh=$(fx bash "$0" | grep '^uplink:')
  case "$ulh" in
    *SINCE-BOOT*)     fail="$fail young-uplink-rendered-since-boot" ;;
    *REENUM*"NOT healthy"*) ;;
    *)                fail="$fail young-uplink-not-flagged[$ulh]" ;;
  esac
  printf '%s\n' "$ulh" | grep -q "up 1.4h of the node's 5.0h" \
    || fail="$fail uplink-line-missing-of-the-nodes-phrasing"
  # the inverse: a device as old as the node MUST read since-boot (a band that only ever
  # says "unhealthy" is as useless as one that only ever says "ok")
  echo 18100000 >"$tmp/1-2.3/power/runtime_active_time"
  ulh2=$(fx bash "$0" | grep '^uplink:')
  case "$ulh2" in *SINCE-BOOT*) ;; *) fail="$fail old-uplink-not-since-boot[$ulh2]" ;; esac
  echo 5001786 >"$tmp/1-2.3/power/runtime_active_time"
  # uplink not enumerated at all → ABSENT, never a quiet pass
  ula=$(MESH_USB_DIR="$tmp" MESH_USB_NET_DIR="$tmp/emptynet" MESH_USB_BT_DIR="$tmp/bt" \
        MESH_USB_UPTIME=18119 MESH_USB_UPLINK_ID=0bda:b82c bash "$0" | grep '^uplink:')
  case "$ula" in *ABSENT*"NOT healthy"*) ;; *) fail="$fail absent-uplink-not-flagged[$ula]" ;; esac

  # ── GATE 2: BT leg — bare form PINNED, down hci0 → na NEVER 0, age stamp present ─────
  : >"$tmp/hci.argv"
  bt=$(fx MESH_USB_HCI_CMD="$tmp/hci-up" bash "$0" --bt); btrc=$?
  [ "$btrc" = 0 ] || fail="$fail bt-up-rc$btrc"
  printf '%s\n' "$bt" | grep -q 'rx_errors=7'  || fail="$fail bt-rx-errors-not-parsed"
  printf '%s\n' "$bt" | grep -q 'commands=1153' || fail="$fail bt-commands-not-parsed"
  printf '%s\n' "$bt" | grep -q 'band=reenum'  || fail="$fail bt-missing-age-stamp"      # (b)
  printf '%s\n' "$bt" | grep -q 'cover<=1.4h'  || fail="$fail bt-missing-coverage-ceiling"
  # behavioural -a pin: the stub recorded exactly what we invoked it with.
  argv=$(cat "$tmp/hci.argv")
  [ "$argv" = "hci0" ] || fail="$fail hci-argv-not-bare[$argv]"
  case "$argv" in *-a*) fail="$fail hci-dash-a-issued" ;; esac
  # down controller → na, and NOT the zeros the stub is printing
  : >"$tmp/hci.argv"
  btd=$(fx MESH_USB_HCI_CMD="$tmp/hci-down" bash "$0" --bt); btdrc=$?
  [ "$btdrc" = 2 ] || fail="$fail bt-down-not-exit2($btdrc)"
  printf '%s\n' "$btd" | grep -q 'na'          || fail="$fail bt-down-not-na"
  printf '%s\n' "$btd" | grep -qE '(rx_errors|errors)=0' && fail="$fail bt-down-rendered-zero"  # (a)
  [ "$(cat "$tmp/hci.argv")" = "hci0" ] || fail="$fail hci-down-argv-not-bare"
  # hciconfig absent entirely → na exit 2, still never 0
  btm=$(fx MESH_USB_HCI_CMD="$tmp/no-such-hciconfig" bash "$0" --bt); btmrc=$?
  [ "$btmrc" = 2 ] || fail="$fail bt-missing-cmd-not-exit2($btmrc)"
  printf '%s\n' "$btm" | grep -q 'na' || fail="$fail bt-missing-cmd-not-na"
  printf '%s\n' "$btm" | grep -qE '=0( |$)' && fail="$fail bt-missing-cmd-rendered-zero"
  # --json carries the axis
  js=$(fx bash "$0" --json)
  printf '%s\n' "$js" | grep -q '"age_band":"reenum"' || fail="$fail json-missing-age-band"
  printf '%s\n' "$js" | grep -q '"age_sec":"na"'      || fail="$fail json-missing-na-age"

  rm -rf "$tmp"

  # ── REAL-READ GATE (a fixture-driven gate cannot cover the live path) ───────────────
  real_note="no live bus"
  if [ -d "$(usb_dir)" ]; then
    rup=$(node_uptime_sec)
    [ "$rup" != na ] || fail="$fail live-uptime-na"
    if rref="$(uplink_ref)"; then
      rbus="${rref%%	*}"; rage="$(device_age_sec "$rbus")"
      [ "$rage" != na ] || fail="$fail live-uplink-age-na(power/runtime_*_time unreadable)"
      case "$rage" in ''|*[!0-9]*) ;; *) [ "$rage" -gt 0 ] || fail="$fail live-uplink-age-zero" ;; esac
      rband="$(age_band "$rage" "$rup")"
      case "$rband" in since-boot|reenum|fresh-reenum) ;; *) fail="$fail live-band-bogus($rband)" ;; esac
      real_note="live uplink ${rref##*	}@$rbus age=$(fmt_age "$rage") band=$rband of node $(fmt_age "$rup")"
    else
      real_note="live bus, no USB-attached net iface (uplink axis n/a here)"
    fi
    # bare hci read on the REAL controller: rc 0 (counters) or 2 (honest na). Never a zero.
    rbt=$(bt_line); rbtrc=$?
    case "$rbtrc" in
      0) printf '%s\n' "$rbt" | grep -q 'cover<=' || fail="$fail live-bt-missing-coverage-stamp"
         real_note="$real_note; live bt read ok" ;;
      2) printf '%s\n' "$rbt" | grep -q 'na' || fail="$fail live-bt-blind-not-na"
         real_note="$real_note; live bt n/a (honest)" ;;
      *) fail="$fail live-bt-rc$rbtrc" ;;
    esac
  fi

  if [ -n "$fail" ]; then echo "smoke-test: FAIL ($fail )"; exit 1; fi
  echo "smoke-test: ok (3 devices, root hub excluded, --list still 4-col; age ms→s + na-never-0 + 4 bands; young uplink flagged NOT healthy, old one since-boot, absent one ABSENT; bt bare-pinned argv=hci0, down→na exit2 not 0, age-stamped with cover<=; $real_note)"
  exit 0
fi

# --- availability: the honest exit-2 gate -----------------------------------------
DIR="$(usb_dir)"
if [ ! -d "$DIR" ]; then
  echo "mesh-usb: BLIND — no USB bus at $DIR (VM/container without USB passthrough) — NOT '0 devices'"
  exit 2
fi

# --- stable machine interface (the delta layer's input) --------------------------
if [ "${1:-}" = "--list" ]; then
  scan_devices
  exit 0
fi

# --- the BT half: second vantage on the combo silicon ----------------------------
if [ "${1:-}" = "--bt" ]; then
  bt_line
  exit $?
fi

UPTIME_SEC="$(node_uptime_sec)"
UPLINK_BUS=""
if _ref="$(uplink_ref)"; then UPLINK_BUS="${_ref%%	*}"; fi

# --- the age axis: machine TSV ----------------------------------------------------
# <busid>\t<vid:pid>\t<age_sec>\t<uptime_sec>\t<band>\t<role>\t<name>
if [ "${1:-}" = "--age" ]; then
  _walk_devices | while IFS=$'\t' read -r busid vid pid rem spd prod; do
    [ -n "$busid" ] || continue
    age="$(device_age_sec "$busid")"
    printf '%s\t%s:%s\t%s\t%s\t%s\t%s\t%s\n' \
      "$busid" "$vid" "$pid" "$age" "$UPTIME_SEC" "$(age_band "$age" "$UPTIME_SEC")" \
      "$([ "$busid" = "$UPLINK_BUS" ] && echo uplink || echo -)" "$prod"
  done
  exit 0
fi

devs="$(scan_devices)"
total=$(printf '%s\n' "$devs" | grep -c .)
periph=$(printf '%s\n' "$devs" | awk -F'\t' '$3=="removable"' | grep -c .)
internal=$(printf '%s\n' "$devs" | awk -F'\t' '$3=="fixed"' | grep -c .)
other=$(( total - periph - internal ))

# --- json -------------------------------------------------------------------------
if [ "${1:-}" = "--json" ]; then
  printf '{"total":%s,"peripheral":%s,"internal":%s,"other":%s,"uptime_sec":"%s","devices":[' \
    "$total" "$periph" "$internal" "$other" "$UPTIME_SEC"
  first=1
  while IFS=$'\t' read -r busid vid pid rem spd prod; do
    [ -n "$busid" ] || continue
    age="$(device_age_sec "$busid")"
    [ "$first" = 1 ] || printf ','
    first=0
    printf '{"bus":"%s","name":"%s","id":"%s:%s","removable":"%s","speed_mbps":"%s","age_sec":"%s","age_band":"%s","role":"%s"}' \
      "$busid" "$(echo "$prod" | sed 's/"/\\"/g')" "$vid" "$pid" "$rem" "$spd" \
      "$age" "$(age_band "$age" "$UPTIME_SEC")" \
      "$([ "$busid" = "$UPLINK_BUS" ] && echo uplink || echo -)"
  done < <(_walk_devices)
  printf '],"uplink":"%s","bt":"%s"}\n' \
    "$(uplink_line | sed 's/"/\\"/g')" "$(bt_line | sed 's/"/\\"/g')"
  exit 0
fi

# --- one-shot human read ----------------------------------------------------------
echo "usb: $total device(s) on the bus — ${periph} peripheral(removable) · ${internal} internal(fixed)$([ "$other" -gt 0 ] && echo " · ${other} other") — node up $(fmt_age "$UPTIME_SEC")"
while IFS=$'\t' read -r busid vid pid rem spd prod; do
  [ -n "$busid" ] || continue
  tag=$rem; [ "$rem" = removable ] && tag="PERIPHERAL"; [ "$rem" = fixed ] && tag="internal"
  age="$(device_age_sec "$busid")"; band="$(age_band "$age" "$UPTIME_SEC")"
  echo "  • $prod [$vid:$pid] @$busid ${tag} ${spd}Mbps age=$(fmt_age "$age")($band)$([ "$busid" = "$UPLINK_BUS" ] && echo ' ←UPLINK')"
done < <(_walk_devices)
uplink_line
bt_line
exit 0
