#!/usr/bin/env bash
# orphan-ok: on-demand HONESTY meta-sense — queried when a radio sense reads empty, to tell
#            "empty environment" from "radio off". Wire a reflex-cadence per node if a stream needs it.
# mesh-rfkill — EMBODIED meta-SENSE: are this node's wireless radios (wlan / bluetooth) actually ON,
# or soft/hard-BLOCKED? A real-world signal the hardware exposes but the mesh did not sense yet.
# Source: /sys/class/rfkill/rfkill*/{type,soft,hard} (kernel rfkill subsystem). Always local, no SSH.
#
# WHY IT MATTERS (honest-fusion, the load-bearing reason): the mesh's radio senses — mesh-presence
# (BLE), mesh-tamper, mesh-wifi-motion, mesh-wifi-link — all read "0 / nothing" when their radio is
# BLOCKED, indistinguishable from a genuinely empty environment. A blocked bluetooth radio makes
# mesh-presence report n=0 that LOOKS like "empty room" but is really "radio off". This sense makes that
# blindness VISIBLE so a downstream fusion can render UNKNOWN instead of a faked all-clear absence.
#
# HONEST sense (memory fusion-tools-distinguish-empty-from-failed): a node with NO rfkill subsystem
# (a VM/container with no radios, or rfkill absent) is UNREACHABLE for this sense → exit 2, NEVER a
# faked "all radios live". hard-block dominates soft (a hard block is the physical/airplane switch).
#
#   mesh-rfkill          one-shot: 'radios: wlan=<state> bluetooth=<state> — <note>' (exit 0) or unreachable (exit 2)
#   mesh-rfkill --json   {radios:{<type>:<state>,...}, any_blocked, ts}
#   mesh-rfkill --test   pure classify truth-table + honest-unreachable→exit2 (needs no radio hardware)
#
# Read-only (observes; never toggles a radio). Exit 0 = real reading (state in the TEXT, sense
# convention); exit 2 = no rfkill subsystem on this node (honest UNKNOWN, never a faked all-unblocked).
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"

RFKILL_GLOB="${MESH_RFKILL_GLOB:-/sys/class/rfkill/rfkill*}"

# pure classifier (falsifiable, no I/O): classify_radio <soft> <hard> → UNBLOCKED|SOFT-BLOCKED|HARD-BLOCKED
# hard-block (physical/airplane switch) dominates soft-block; non-1 values are treated as not-blocked
# only when explicitly "0" — anything unparseable is treated as blocked-unknown to avoid a faked all-clear.
classify_radio() {
  local soft="$1" hard="$2"
  if [ "$hard" = 1 ]; then echo "HARD-BLOCKED"; return; fi
  if [ "$soft" = 1 ]; then echo "SOFT-BLOCKED"; return; fi
  if [ "$soft" = 0 ] && [ "$hard" = 0 ]; then echo "UNBLOCKED"; return; fi
  echo "UNKNOWN"   # unreadable soft/hard → never silently "UNBLOCKED"
}

# worse_state <a> <b> → the more-blocked of two states (for per-type aggregation across adapters)
worse_state() {
  local a="$1" b="$2"
  for s in HARD-BLOCKED SOFT-BLOCKED UNKNOWN UNBLOCKED; do
    [ "$a" = "$s" ] && { echo "$a"; return; }
    [ "$b" = "$s" ] && { echo "$b"; return; }
  done
  echo "UNKNOWN"
}

if [ "${1:-}" = --test ]; then
  _f=0
  [ "$(classify_radio 0 0)" = UNBLOCKED ]    || { echo "  FAIL: 0/0→UNBLOCKED"; _f=1; }
  [ "$(classify_radio 1 0)" = SOFT-BLOCKED ] || { echo "  FAIL: soft→SOFT-BLOCKED"; _f=1; }
  [ "$(classify_radio 0 1)" = HARD-BLOCKED ] || { echo "  FAIL: hard→HARD-BLOCKED"; _f=1; }
  [ "$(classify_radio 1 1)" = HARD-BLOCKED ] || { echo "  FAIL: hard dominates soft"; _f=1; }
  [ "$(classify_radio '' '')" = UNKNOWN ]    || { echo "  FAIL: unreadable→UNKNOWN (never faked UNBLOCKED)"; _f=1; }
  [ "$(worse_state UNBLOCKED SOFT-BLOCKED)" = SOFT-BLOCKED ] || { echo "  FAIL: aggregate keeps the worse state"; _f=1; }
  [ "$(worse_state UNBLOCKED UNBLOCKED)" = UNBLOCKED ]       || { echo "  FAIL: both clear→UNBLOCKED"; _f=1; }
  # honest-unreachable: no rfkill subsystem (glob matches nothing) must exit 2, never fake all-unblocked
  MESH_RFKILL_GLOB='/nonexistent/rfkill/__none__' "$0" >/dev/null 2>&1
  [ "$?" -eq 2 ] || { echo "  FAIL: no-rfkill-subsystem must exit 2 (honest UNKNOWN, not faked all-live)"; _f=1; }
  [ "$_f" = 0 ] || { echo "smoke-test: FAIL"; exit 1; }
  echo "smoke-test: ok (classify truth-table 5 + aggregate 2 + honest-unreachable→exit2)"; exit 0
fi

ts="$(date -u +%FT%TZ)"
declare -A TYPE_STATE=()
found=0
for d in $RFKILL_GLOB; do
  [ -d "$d" ] || continue
  [ -r "$d/type" ] || continue
  typ="$(cat "$d/type" 2>/dev/null)"; [ -n "$typ" ] || continue
  soft="$(cat "$d/soft" 2>/dev/null)"; hard="$(cat "$d/hard" 2>/dev/null)"
  st="$(classify_radio "${soft:-}" "${hard:-}")"
  if [ -n "${TYPE_STATE[$typ]:-}" ]; then
    TYPE_STATE[$typ]="$(worse_state "${TYPE_STATE[$typ]}" "$st")"
  else
    TYPE_STATE[$typ]="$st"
  fi
  found=$((found+1))
done

if [ "$found" -eq 0 ]; then
  echo "radios: UNREACHABLE — no rfkill subsystem on this node (no radios / VM / rfkill absent) — UNKNOWN, not faked"
  exit 2
fi

# Build summary + honest blindness note for any blocked radio class
summary=""; any_blocked=0; blind_note=""
for typ in $(printf '%s\n' "${!TYPE_STATE[@]}" | sort); do
  st="${TYPE_STATE[$typ]}"
  summary="${summary:+$summary }$typ=$st"
  case "$st" in
    UNBLOCKED) : ;;
    *) any_blocked=1
       case "$typ" in
         bluetooth) blind_note="${blind_note:+$blind_note; }bluetooth $st → BLE senses (mesh-presence/mesh-tamper) read radio-off, NOT 'empty'" ;;
         wlan)      blind_note="${blind_note:+$blind_note; }wlan $st → wifi senses (mesh-wifi-motion/mesh-wifi-link) read radio-off, NOT 'no signal'" ;;
         *)         blind_note="${blind_note:+$blind_note; }$typ $st (radio blind)" ;;
       esac ;;
  esac
done

case "${1:-}" in
  --json)
    j=""; for typ in $(printf '%s\n' "${!TYPE_STATE[@]}" | sort); do j="${j:+$j,}\"$typ\":\"${TYPE_STATE[$typ]}\""; done
    printf '{"radios":{%s},"any_blocked":%s,"ts":"%s"}\n' "$j" "$any_blocked" "$ts"
    ;;
  *)
    if [ "$any_blocked" -eq 1 ]; then
      printf 'radios: %s — %s\n' "$summary" "$blind_note"
    else
      printf 'radios: %s — all radios live (wlan+bluetooth senses are seeing, not blind)\n' "$summary"
    fi
    ;;
esac
exit 0
