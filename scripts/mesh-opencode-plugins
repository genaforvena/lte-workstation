#!/usr/bin/env bash
# mesh-opencode-plugins — deploy the genome's opencode plugins to the live dir.
#
# WHY A DEPLOY STEP: .opencode/ is gitignored as node-local (see .gitignore), so the
# mesh's opencode ports (handoff/session-restore, stop-check/idle, rtk/tool-before,
# compact/compaction-context) cannot live there as genome. Their source of truth is
# the TRACKED opencode-plugins/ dir beside this script; this copies it into the
# node's live project plugin dir. Same shape as mesh-sync-tools (scripts/ → ~/.local/bin).
#
#   mesh-opencode-plugins            copy opencode-plugins/*.ts → <repo>/.opencode/plugin/
#   mesh-opencode-plugins --test     sandbox round-trip (copy → byte-identical, no extras)
#
# Runs on demand (after a genome pull) and from mesh-restore. Never deletes the
# node's own local plugins (e.g. compact-submit.ts) — add-only + overwrite of the
# four genome-owned names.
# orphan-ok: on-demand deploy + restore-time glue — not a cron reflex.
set -uo pipefail

OWNED="mesh-handoff.ts mesh-stop-check.ts mesh-rtk.ts mesh-compact.ts"
SRC_DIR="$(cd -- "$(dirname -- "$0")/../opencode-plugins" 2>/dev/null && pwd)"
REPO="${MESH_REPO:-$HOME/lte-workstation}"
DST_DIR="${MESH_OPENCODE_PLUGIN_DST:-$REPO/.opencode/plugin}"

_deploy() { # $1=src $2=dst
  local src="$1" dst="$2" n=0 f
  [ -d "$src" ] || { echo "mesh-opencode-plugins: no source dir $src" >&2; return 1; }
  mkdir -p "$dst" || { echo "mesh-opencode-plugins: cannot create $dst" >&2; return 1; }
  for f in $OWNED; do
    [ -r "$src/$f" ] || { echo "mesh-opencode-plugins: missing source $src/$f" >&2; return 1; }
    cp "$src/$f" "$dst/$f" || return 1
    n=$((n + 1))
  done
  echo "mesh-opencode-plugins: deployed $n plugin(s) $src → $dst"
}

_test() {
  local rc=0 td; td="$(mktemp -d)" || { echo "opencode-plugins-test: FAIL (mktemp)"; exit 1; }
  trap 'rm -rf "${td:-}"' EXIT
  local n; n="$(ls "$SRC_DIR"/mesh-*.ts 2>/dev/null | wc -l)"
  [ "$n" = 4 ] || { echo "opencode-plugins-test: FAIL (expected 4 tracked mesh-*.ts, got $n)"; rc=1; }
  _deploy "$SRC_DIR" "$td/live" >/dev/null 2>&1 || { echo "opencode-plugins-test: FAIL (deploy to sandbox failed)"; rc=1; }
  local f
  for f in $OWNED; do
    cmp -s "$SRC_DIR/$f" "$td/live/$f" || { echo "opencode-plugins-test: FAIL ($f not byte-identical after deploy)"; rc=1; }
  done
  # add-only: a node-local plugin beside the owned names must survive a deploy
  printf '// local\n' > "$td/live/compact-submit.ts"
  _deploy "$SRC_DIR" "$td/live" >/dev/null 2>&1
  [ -f "$td/live/compact-submit.ts" ] || { echo "opencode-plugins-test: FAIL (deploy clobbered a node-local plugin)"; rc=1; }
  [ "$rc" = 0 ] && echo "opencode-plugins-test: ok (4 tracked plugins deploy byte-identical; node-local files kept)"
  return "$rc"
}

case "${1:-}" in
  --test) _test; exit $? ;;
  -h|--help) sed -n '2,/^set -uo/p' "$0" | sed 's/^# \?//p'; exit 0 ;;
  "") _deploy "$SRC_DIR" "$DST_DIR"; exit $? ;;
  *) echo "usage: mesh-opencode-plugins [--test]" >&2; exit 2 ;;
esac
