#!/usr/bin/env python3
"""Read-only, aggregate comparison of cleaner shadow intents and legacy outcomes."""
from __future__ import annotations

import argparse
from datetime import datetime, timezone
import json
import os
from pathlib import Path
import re
import sys


REQUEST = re.compile(r"wake requested top-pain cleaner for entry (\d+)\Z")
TASK_OPEN = re.compile(r"cleaner task-ledger epoch=\d+ status=open\Z")
LOG = re.compile(r"(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ) cleaner: (.*)\Z")
COUNTS = (
    "shadow_observation_requests", "shadow_task_open_requests",
    "legacy_change", "legacy_surprise", "legacy_deaf", "legacy_task_retry",
    "legacy_self_pick", "legacy_refractory", "legacy_busy", "legacy_refused",
    "legacy_delivered", "legacy_predicted_hold", "legacy_no_candidate_hold",
    "legacy_unchanged", "legacy_staffing_hold", "legacy_pace_hold",
    "legacy_refractory_bypass", "legacy_pace_admitted", "legacy_dry_idle",
)


def fail(reason: str) -> int:
    print(json.dumps({"status": "UNKNOWN", "reason": reason, "authority": "legacy"}, sort_keys=True))
    return 2


def utc(value: str) -> datetime:
    if not re.fullmatch(r"\d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ", value):
        raise ValueError("UTC seconds required")
    result = datetime.fromisoformat(value.replace("Z", "+00:00"))
    if result.strftime("%Y-%m-%dT%H:%M:%SZ") != value:
        raise ValueError("invalid UTC timestamp")
    return result


def feed_entries(path: Path):
    core = os.environ.get("MESH_MISHE_CORE")
    if core:
        sys.path.insert(0, str(Path(core) / "src"))
    try:
        from mishe_tauftauf.feed import parse_feed
    except ModuleNotFoundError:
        selected = Path(os.environ.get("MESH_MISHE_PYTHON", str(Path.home() / ".mesh/venvs/mishe-tauftauf/bin/python")))
        # A venv Python may symlink the system binary; resolving both paths
        # would erase the distinct import environment and suppress the retry.
        if selected.is_file() and selected != Path(sys.executable):
            os.execv(str(selected), [str(selected), str(Path(__file__).resolve()), *sys.argv[1:]])
        raise
    return parse_feed(path.read_bytes())


def legacy_kind(message: str) -> str | None:
    if message.startswith("change detected [") and message.endswith("] — waking"):
        return "legacy_change"
    if message.startswith("SURPRISE (") and message.endswith(" — waking"):
        return "legacy_surprise"
    if message.startswith("deaf-guard — ") and " — waking anyway [" in message:
        return "legacy_deaf"
    if message.startswith("exact-owner task still eligible after ") and message.endswith(" — retrying owner prompt"):
        return "legacy_task_retry"
    if message.startswith("autonomous self-pick cadence due (") and message.endswith("; asking mind to select bounded charter work"):
        return "legacy_self_pick"
    if message.startswith("refractory — ") and message.endswith("holding (retry next pass)"):
        return "legacy_refractory"
    if message.startswith("mind busy (") and message.endswith(" — skip wake (will re-invite next pass)"):
        return "legacy_busy"
    if message.startswith("mesh-tell REFUSED — "):
        return "legacy_refused"
    if message.startswith("WOKE mind") and message.endswith(" to consume its stream"):
        return "legacy_delivered"
    if message.startswith("change fully PREDICTED — wake held ("):
        return "legacy_predicted_hold"
    if message == "predicted change held — no exact-owner task candidate (deaf-guard suppressed)":
        return "legacy_no_candidate_hold"
    if message == "pane unchanged — no wake (droplet held)":
        return "legacy_unchanged"
    if message.startswith("autonomous self-pick held — staffing census "):
        return "legacy_staffing_hold"
    if message.startswith("autonomous self-pick held — mesh-pace is unavailable") or message.startswith("autonomous self-pick held by mesh-pace ("):
        return "legacy_pace_hold"
    if message.startswith("refractory bypass — "):
        return "legacy_refractory_bypass"
    if message.startswith("autonomous self-pick admitted by mesh-pace ("):
        return "legacy_pace_admitted"
    if message == "idle (dry — no wake)":
        return "legacy_dry_idle"
    return None


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--start", required=True, help="inclusive UTC second")
    parser.add_argument("--end", required=True, help="exclusive UTC second; must be in the past")
    parser.add_argument("--feed", type=Path, default=Path.home() / ".mesh/mishe-tauftauf/feed")
    parser.add_argument("--legacy-log", type=Path, default=Path.home() / ".mesh/pane-consume.log")
    args = parser.parse_args()
    try:
        start, end = utc(args.start), utc(args.end)
        if not start < end <= datetime.now(timezone.utc):
            return fail("interval")
    except ValueError:
        return fail("interval")
    counts = {key: 0 for key in COUNTS}
    try:
        entries = feed_entries(args.feed)
        by_sequence = {entry.sequence: entry for entry in entries}
        for entry in entries:
            if entry.source != "mishe-tauftauf":
                continue
            # A damaged cleaner request-like receipt is not a zero count.
            if not entry.body.startswith("wake requested top-pain cleaner"):
                continue
            match = REQUEST.fullmatch(entry.body)
            if match is None:
                return fail("feed-request")
            when = datetime.fromisoformat(entry.timestamp.replace("Z", "+00:00"))
            if not start <= when < end:
                continue
            stimulus = by_sequence.get(int(match.group(1)))
            if stimulus is None or stimulus.sequence >= entry.sequence:
                return fail("feed-reference")
            if stimulus.source == "observation/cleaner":
                counts["shadow_observation_requests"] += 1
            elif stimulus.source == "observation/cleaner-task" and TASK_OPEN.fullmatch(stimulus.body):
                counts["shadow_task_open_requests"] += 1
            else:
                return fail("feed-source")
        with args.legacy_log.open(encoding="utf-8") as stream:
            for line in stream:
                if " cleaner:" not in line:
                    continue
                found = LOG.fullmatch(line.rstrip("\n"))
                if found is None:
                    return fail("legacy-format")
                when = utc(found.group(1))
                if not start <= when < end:
                    continue
                kind = legacy_kind(found.group(2))
                if kind is None:
                    return fail("legacy-event")
                counts[kind] += 1
    except (OSError, UnicodeError, ValueError, ImportError):
        return fail("input")
    print(json.dumps({"status": "PASS", "authority": "legacy", "start_inclusive": args.start,
                      "end_exclusive": args.end, "counts": counts,
                      "comparison": "contemporaneous-counts-only"}, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
