#!/usr/bin/env bash
# orphan-ok: on-demand ACTUATOR — fired by a mind/consumer when it has something to say to the
#   operator's desk. Never scheduled: an actuator on a cadence is a nagging machine, not a reach.
# mesh-imac-notify — the iMac's VISUAL (and opt-in audible) actuator over the SSH organ.
#   The iMac (iMac-Rozalia, macOS 10.13.6, the macsocks client) sits on the operator's DESK, a
#   distinct room from the Note3 and the GPU node. Every mesh-imac-* tool before this one was a
#   SENSE; this is the outward half.
#
# THE GATE IS THE SCREEN, NOT THE SSH (health@ 2026-08-29, {#de200e71} adversarial verify).
#   The commissioning task said "gate on iMac SSH reachability". That contract is REFUTED and this
#   tool deliberately does not implement it. macOS wakes on an RTC alarm (DarkWake) far enough to
#   accept the ssh AND return osascript rc=0 WITH THE SCREEN OFF AND NOBODY THERE — measured. So
#   ssh rc, OSA rc and a notification-store row can all three agree while no human is present, and
#   not one of them separates that case. The gate is therefore:
#       screen UNLOCKED  AND  display AWAKE  AND  session ON CONSOLE
#   read from Quartz CGSessionCopyCurrentDictionary (CGSSessionScreenIsLocked,
#   kCGSSessionOnConsoleKey) + ioreg IODisplayWrangler CurrentPowerState. All three verified live
#   on the subject 2026-08-29T14:2xZ. Gate closed ⇒ rc 2, and NOTHING is fired.
#
# THE HEALTH CHECK IS THE STORE'S `presented` BIT, NOT OUR OWN EXIT CODE.
#   The poster identity is com.apple.scripteditor2 — the title says mesh, the attribution says
#   Script Editor — and the operator has never made a notification decision about it (no entry in
#   com.apple.ncprefs.plist, a real absence: 129 bundle ids enumerate). ONE toggle in System
#   Preferences and every mesh alert afterwards dies SILENTLY at rc=0 with presented=0 — which is
#   exactly the 5-of-85 rows already sitting in that database. So after firing we go to the Mac's
#   OWN store (getconf DARWIN_USER_DIR + com.apple.notificationcenter/db2/db, table `record` JOIN
#   `app`) and require a FRESH row past a pre-fire watermark with presented=1. presented is
#   DISCRIMINATING and was checked to be so rather than assumed: 80 ones / 5 zeros across 85 rows.
#
# WHAT IS NOT ESTABLISHED, and must not be inherited into any consumer's docs: that a notification
#   through this path was SEEN BY A PERSON. presented=1 means Notification Center presented it.
#   Both prior drives (13:42Z, 14:07Z) landed inside a 61-minute continuous SCREEN LOCK. Nobody has
#   yet demonstrated this path reaching an unlocked screen with the operator in front of it — which
#   is precisely why the gate above exists, and why this tool says `delivered`, never `seen`.
#
# THE AUDIBLE LEG IS OPT-IN, GATE-BOUND, AND CARRIED AS UNVERIFIED.
#   `say` is per-call opt-in (--say), never the default, and it fires ONLY above a volume floor.
#   --force relaxes the gate for the NOTIFICATION only; it can NEVER relax it for audio — sound at
#   a dark locked desk is the startling case the commissioning task forbids, so the audio leg has
#   no override at all. The TTS engine is listed and output volume reads 56, but TTS-engine-listed
#   is not TTS-HEARD: no one has ever driven sound out of this machine from the mesh. This leg is
#   UNVERIFIED by design, not proven-by-adjacency to the notification leg.
#
# Output:
#   [imac-notify] state=DELIVERED|NA|REFUSED|MUTED|UNCONFIRMED gate=<why> presented=0|1|na osa_rc=<n>
#                 say=fired|skipped:<why>|off vol=<n> rec=<rec_id|->
#
# Exit codes (honest-exit contract — a closed gate is never a faked success):
#   0 = fired AND the Mac's own store confirms a fresh presented=1 row
#   1 = caller error (no message, unknown flag)
#   2 = n/a — gate closed (locked / display asleep / off console) or iMac unreachable. NOTHING fired.
#   3 = REFUSED — it fired and the OSASCRIPT rc was non-zero (the false-OK the task named)
#   4 = UNCONFIRMED — OSA rc=0 but the store shows no fresh presented=1 row (the silent-death case)
#
# Usage:
#   mesh-imac-notify "text"                     benign default: a display notification
#   mesh-imac-notify --title "mesh" "text"
#   mesh-imac-notify --say "text"               ALSO speak it (gate-bound, above the volume floor)
#   mesh-imac-notify --force "text"             fire past a closed gate (notification ONLY)
#   mesh-imac-notify --probe                    read the gate; fire nothing; rc 0 open / 2 closed
#   mesh-imac-notify --json | --test
#
# Routing: card actuator `imac-notify` -> mesh-organ maps the name to this tool by its default
#   rule. PLACE-BOUND: it is a point in the operator's room, never fungible with another node's
#   notifier.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

IMAC_HOST="${MESH_IMAC_HOST:-ilya@192.168.8.214}"
TIMEOUT="${MESH_IMAC_NOTIFY_TIMEOUT:-25}"
VOL_FLOOR="${MESH_IMAC_SAY_MIN_VOL:-20}"
# The store-write lag MEASURED on the subject 2026-08-29T14:3xZ: 5s, 5s, 5s (n=3, tight). This
# constant is the provenance of the window below, and `--test` gates the window against it — the
# first cut polled 4s, UNDER the lag, and would have rendered every genuine delivery a failure.
# If you re-measure the lag, change BOTH: a window calibrated against a number nobody re-derived
# is a constant that has outlived its reader.
MEASURED_LAG_S=5
CONFIRM_S="${MESH_IMAC_NOTIFY_CONFIRM_S:-15}"   # >= 2x MEASURED_LAG_S
VOICE="${MESH_IMAC_SAY_VOICE:-}"

MODE=text; TITLE="mesh"; MSG=""; SAY=0; FORCE=0; PROBE=0
ARGV_ALL=" $* "   # snapshot: the loop below shifts $* away entirely
while [ $# -gt 0 ]; do
  case "$1" in
    --json)  MODE=json ;;
    --title) TITLE="${2:-}"; shift ;;
    --say)   SAY=1 ;;
    --voice) VOICE="${2:-}"; shift ;;
    --min-volume) VOL_FLOOR="${2:-}"; shift ;;
    --force) FORCE=1 ;;
    --probe) PROBE=1 ;;
    --confirm-window) printf '%s %s\n' "$CONFIRM_S" "$MEASURED_LAG_S"; exit 0 ;;
    --test)  ;;   # handled below
    --) shift; MSG="$*"; break ;;
    -*) echo "mesh-imac-notify: unknown flag '$1'" >&2; exit 1 ;;
    *)  MSG="${MSG:+$MSG }$1" ;;
  esac
  shift
done

emit() { # <state> <gate> <presented> <osa_rc> <say> <vol> <rec>
  if [ "$MODE" = json ]; then
    printf '{"state":"%s","gate":"%s","presented":"%s","osa_rc":"%s","say":"%s","vol":"%s","rec":"%s","host":"%s","ts":"%s"}\n' \
      "$1" "$2" "$3" "$4" "$5" "$6" "$7" "$IMAC_HOST" "$(date -u +%FT%TZ)"
  else
    printf '[imac-notify] state=%s gate=%s presented=%s osa_rc=%s say=%s vol=%s rec=%s\n' \
      "$1" "$2" "$3" "$4" "$5" "$6" "$7"
  fi
}

# ---- the remote script -------------------------------------------------------------------------
# Built as one ssh call so the gate is read, the shot is fired and the store is checked without a
# window in which the operator's screen state can change between them. Payloads travel BASE64 —
# base64's alphabet contains no single quote, so single-quoting them here is total, and the message
# never passes through AppleScript's own string escaping (osascript's `on run argv` form takes it
# as an ARGUMENT; verified live against embedded quotes and backslashes).
build_remote() { # <msg_b64> <title_b64> <say> <force> <probe> <vol_floor> <voice_b64> <confirm_s>
  cat <<REMOTE
set -u
MSG_B64='$1'; TITLE_B64='$2'; WANT_SAY=$3; FORCE=$4; PROBE=$5; VOL_FLOOR=$6; VOICE_B64='$7'; CONFIRM_S=${8:-15}
d64() { printf '%s' "\$1" | base64 -D 2>/dev/null || printf '%s' "\$1" | base64 --decode 2>/dev/null; }

# --- THE GATE: screen state, never ssh reachability -------------------------------------------
G="\$(python -c '
import Quartz
d = Quartz.CGSessionCopyCurrentDictionary() or {}
print("%s %s" % (d.get("CGSSessionScreenIsLocked", 0), d.get("kCGSSessionOnConsoleKey", 0)))
' 2>/dev/null)"
LOCKED="\$(printf '%s' "\$G" | awk '{print \$1}')"
CONSOLE="\$(printf '%s' "\$G" | awk '{print \$2}')"
PWR="\$(ioreg -n IODisplayWrangler -r -d 1 2>/dev/null | sed -n 's/.*"CurrentPowerState"=\([0-9]*\).*/\1/p' | head -1)"
VOL="\$(osascript -e 'output volume of (get volume settings)' 2>/dev/null)"
case "\$VOL" in ''|*[!0-9]*) VOL=-1 ;; esac

# An UNREADABLE gate is a CLOSED gate. A python that did not run, an ioreg that said nothing —
# each renders here as blindness, and blindness must never open a door onto the operator's desk.
GATE=open
[ -z "\$LOCKED" ] || [ -z "\$CONSOLE" ] && GATE=unreadable-session
[ -z "\$PWR" ] && GATE=unreadable-display
[ "\$GATE" = open ] && [ "\$LOCKED" = True ] && GATE=screen-locked
[ "\$GATE" = open ] && [ "\$CONSOLE" != True ] && GATE=off-console
[ "\$GATE" = open ] && [ "\$PWR" -lt 4 ] 2>/dev/null && GATE=display-asleep

echo "GATE=\$GATE"; echo "LOCKED=\$LOCKED"; echo "CONSOLE=\$CONSOLE"; echo "PWR=\$PWR"; echo "VOL=\$VOL"
[ "\$PROBE" = 1 ] && exit 0

if [ "\$GATE" != open ] && [ "\$FORCE" != 1 ]; then echo "FIRED=0"; exit 0; fi

MSG="\$(d64 "\$MSG_B64")"; TITLE="\$(d64 "\$TITLE_B64")"

# --- watermark BEFORE the shot: the store row we later demand must be one this call caused ------
DB="\$(getconf DARWIN_USER_DIR)com.apple.notificationcenter/db2/db"
WM="\$(sqlite3 "\$DB" 'select coalesce(max(delivered_date),0) from record;' 2>/dev/null)"
[ -n "\$WM" ] || WM=0
echo "WM=\$WM"

# --- fire. OSA rc is captured APART from the ssh rc — a live ssh to a machine that refused the
#     AppleScript is the false OK this tool exists to refuse. ------------------------------------
OSA_ERR="\$(osascript -e 'on run argv
display notification (item 1 of argv) with title (item 2 of argv)
end run' "\$MSG" "\$TITLE" 2>&1)"; OSA_RC=\$?
echo "FIRED=1"; echo "OSA_RC=\$OSA_RC"; echo "OSA_ERR=\$OSA_ERR"

# --- the audible leg: opt-in, floor-bound, and NO --force override --------------------------
SAY=off
if [ "\$WANT_SAY" = 1 ]; then
  if [ "\$GATE" != open ]; then SAY="skipped:gate-\$GATE"
  elif [ "\$VOL" -lt "\$VOL_FLOOR" ] 2>/dev/null; then SAY="skipped:vol-\$VOL-below-floor-\$VOL_FLOOR"
  else
    VOICE="\$(d64 "\$VOICE_B64")"
    if [ -n "\$VOICE" ]; then say -v "\$VOICE" -- "\$MSG" 2>/dev/null; else say -- "\$MSG" 2>/dev/null; fi
    SAY_RC=\$?
    [ "\$SAY_RC" = 0 ] && SAY=fired || SAY="refused:rc\$SAY_RC"
  fi
fi
echo "SAY=\$SAY"

# --- the health check: the Mac's OWN store, joined to the poster's bundle id, past the watermark.
#     Polled, because the store write lags the AppleScript return. -------------------------------
PRESENTED=na; REC=-
i=0
while [ \$i -lt \$CONFIRM_S ]; do
  R="\$(sqlite3 "\$DB" "select r.rec_id||'|'||r.presented from record r join app a on a.app_id=r.app_id where a.identifier='com.apple.scripteditor2' and r.delivered_date > \$WM order by r.rec_id desc limit 1;" 2>/dev/null)"
  if [ -n "\$R" ]; then
    REC="\$(printf '%s' "\$R" | cut -d'|' -f1)"
    PRESENTED="\$(printf '%s' "\$R" | cut -d'|' -f2)"
    break
  fi
  i=\$((i+1)); sleep 1
done
echo "PRESENTED=\$PRESENTED"; echo "REC=\$REC"
REMOTE
}

b64() { printf '%s' "$1" | base64 | tr -d '\n'; }

# THE ONE SEAM. The test replaces THIS and nothing else, so every arm below drives the SHIPPING
# parser, classifier and exit-code map rather than a second private copy of them.
remote_call() {
  if [ -n "${MESH_IMAC_NOTIFY_FIXTURE:-}" ]; then printf '%s\n' "$MESH_IMAC_NOTIFY_FIXTURE"; return 0; fi
  local script
  script="$(build_remote "$(b64 "$MSG")" "$(b64 "$TITLE")" "$SAY" "$FORCE" "$PROBE" "$VOL_FLOOR" "$(b64 "$VOICE")" "$CONFIRM_S")"
  printf '%s' "$script" | timeout "$TIMEOUT" ssh -o BatchMode=yes -o ConnectTimeout=8 \
    -o StrictHostKeyChecking=accept-new "$IMAC_HOST" 'sh -s' 2>/dev/null
}

run() {
  [ "$PROBE" = 1 ] || [ -n "$MSG" ] || { echo "mesh-imac-notify: no message (usage: mesh-imac-notify \"text\")" >&2; exit 1; }
  local out
  out="$(remote_call)" || {
    emit NA unreachable na na off - -
    echo "imac-notify: iMac unreachable ($IMAC_HOST) — actuator dark, nothing fired" >&2; return 2; }

  local gate fired osa presented rec say vol
  gate="$(printf '%s\n' "$out" | sed -n 's/^GATE=//p' | head -1)"
  fired="$(printf '%s\n' "$out" | sed -n 's/^FIRED=//p' | head -1)"
  osa="$(printf '%s\n' "$out" | sed -n 's/^OSA_RC=//p' | head -1)"
  presented="$(printf '%s\n' "$out" | sed -n 's/^PRESENTED=//p' | head -1)"
  rec="$(printf '%s\n' "$out" | sed -n 's/^REC=//p' | head -1)"
  say="$(printf '%s\n' "$out" | sed -n 's/^SAY=//p' | head -1)"
  vol="$(printf '%s\n' "$out" | sed -n 's/^VOL=//p' | head -1)"
  [ -n "$gate" ] || { emit NA no-gate-read na na off "${vol:--}" -
    echo "imac-notify: gate unreadable — treated as CLOSED, nothing fired" >&2; return 2; }

  if [ "$PROBE" = 1 ]; then
    emit "$([ "$gate" = open ] && echo GATE-OPEN || echo NA)" "$gate" na na off "${vol:--}" -
    [ "$gate" = open ] && return 0 || return 2
  fi
  if [ "${fired:-0}" != 1 ]; then
    emit NA "$gate" na na off "${vol:--}" -
    return 2
  fi
  if [ "${osa:-1}" != 0 ]; then
    emit REFUSED "$gate" "${presented:-na}" "${osa:-?}" "${say:-off}" "${vol:--}" "${rec:--}"
    printf '%s\n' "$out" | sed -n 's/^OSA_ERR=/imac-notify: osascript refused: /p' >&2
    return 3
  fi
  if [ "${presented:-na}" = 0 ]; then
    # the row EXISTS and Notification Center declined to show it — a decision, not a delay
    emit MUTED "$gate" 0 "$osa" "${say:-off}" "${vol:--}" "${rec:--}"
    echo "imac-notify: the Mac took the alert and did NOT present it (rec ${rec:--}, presented=0) — the poster com.apple.scripteditor2 is muted in Notification Center. rc=0 would have hidden this." >&2
    return 4
  fi
  if [ "${presented:-na}" != 1 ]; then
    # no row at all inside the window — blind, which is NOT the same claim as muted
    emit UNCONFIRMED "$gate" "${presented:-na}" "$osa" "${say:-off}" "${vol:--}" "${rec:--}"
    echo "imac-notify: osascript rc=0 but no store row appeared within ${CONFIRM_S}s (measured lag is 5s) — delivery UNCONFIRMED, not proven failed" >&2
    return 5
  fi
  emit DELIVERED "$gate" "$presented" "$osa" "${say:-off}" "${vol:--}" "${rec:--}"
  return 0
}

# ---- Smoke test --------------------------------------------------------------------------------
# The gate arms are driven against FIXTURE remote output (the parser is the thing under test), and
# ONE live arm proves the reach is real rather than a parser talking to itself. No arm ever fires
# audio: an actuator's test must not actuate at the operator's desk.
case "$ARGV_ALL" in *" --test "*)
  fail=0
  say_fail() { echo "  FAIL: $*"; fail=1; }

  # -- parser arms: each fixture is what the remote script would have printed ---------------------
  # Drive the real run() with the ssh leg replaced, so the arms test the SHIPPING parser and not a
  # copy of it (n private copies of one predicate are all green and none is complete).
  _drive() { # <fixture-text> [flags...] -> prints "state|rc"
    local fx="$1"; shift
    local o rc
    o="$(MESH_IMAC_NOTIFY_FIXTURE="$fx" "$0" "$@" fixture-msg 2>/dev/null)"; rc=$?
    printf '%s|%s' "$(printf '%s' "$o" | sed -n 's/.*state=\([A-Z-]*\).*/\1/p')" "$rc"
  }

  echo "-- gate arms (nothing fires)"
  # 1. locked screen -> NA rc2, and FIRED must be absent
  r="$(_drive 'GATE=screen-locked
LOCKED=True
CONSOLE=True
PWR=4
VOL=56
FIRED=0')"
  [ "$r" = "NA|2" ] || say_fail "locked screen should be NA|2, got $r"

  # 2. display asleep -> NA rc2
  r="$(_drive 'GATE=display-asleep
LOCKED=False
CONSOLE=True
PWR=1
VOL=56
FIRED=0')"
  [ "$r" = "NA|2" ] || say_fail "display asleep should be NA|2, got $r"

  # 3. THE DARKWAKE CASE the whole tool exists for: ssh fine, OSA fine, store row present — but the
  #    screen is off. Gating on ssh reachability (the commissioning contract) would have FIRED here.
  r="$(_drive 'GATE=display-asleep
LOCKED=False
CONSOLE=True
PWR=0
VOL=56
FIRED=0')"
  [ "$r" = "NA|2" ] || say_fail "darkwake should be NA|2, got $r"

  # 4. an UNREADABLE gate is a CLOSED gate, never an open one
  r="$(_drive 'GATE=unreadable-session
LOCKED=
CONSOLE=
PWR=4
VOL=56
FIRED=0')"
  [ "$r" = "NA|2" ] || say_fail "unreadable gate should be NA|2, got $r"

  echo "-- outcome arms"
  # 5. the FALSE OK: osascript refused while ssh was perfectly happy
  r="$(_drive 'GATE=open
LOCKED=False
CONSOLE=True
PWR=4
VOL=56
WM=1
FIRED=1
OSA_RC=1
OSA_ERR=execution error
SAY=off
PRESENTED=na
REC=-')"
  [ "$r" = "REFUSED|3" ] || say_fail "osa refusal should be REFUSED|3, got $r"

  # 6. THE SILENT DEATH: rc=0 and no fresh presented row. Must NOT be green.
  r="$(_drive 'GATE=open
LOCKED=False
CONSOLE=True
PWR=4
VOL=56
WM=1
FIRED=1
OSA_RC=0
SAY=off
PRESENTED=na
REC=-')"
  [ "$r" = "UNCONFIRMED|5" ] || say_fail "no fresh store row should be UNCONFIRMED|5 (blind), got $r"

  # 7. presented=0 is the MUTED case — a decision by Notification Center, not a delay. It must
  #    carry a DIFFERENT word and code from arm 6: collapsing them makes blind and quiet identical.
  r="$(_drive 'GATE=open
LOCKED=False
CONSOLE=True
PWR=4
VOL=56
WM=1
FIRED=1
OSA_RC=0
SAY=off
PRESENTED=0
REC=1400')"
  [ "$r" = "MUTED|4" ] || say_fail "presented=0 should be MUTED|4 (distinct from blind), got $r"

  # 8. the only green: fired, rc 0, fresh row, presented=1
  r="$(_drive 'GATE=open
LOCKED=False
CONSOLE=True
PWR=4
VOL=56
WM=1
FIRED=1
OSA_RC=0
SAY=off
PRESENTED=1
REC=1400')"
  [ "$r" = "DELIVERED|0" ] || say_fail "full success should be DELIVERED|0, got $r"

  echo "-- the audible leg never overrides the gate"
  # 9. --say --force at a LOCKED desk: --force may relax the notification, never the audio.
  #    (the remote script decides this; the arm pins that the wire carries a skip, not a fire)
  _rs="$(build_remote "$(b64 hi)" "$(b64 t)" 1 1 0 20 "$(b64 '')" 15)"
  printf '%s' "$_rs" | grep -q 'if \[ "\$GATE" != open \]; then SAY="skipped:gate' \
    || say_fail "audio leg lost its unconditional gate check"
  printf '%s' "$_rs" | grep -q 'WANT_SAY' || say_fail "audio leg is not opt-in"

  echo "-- the REMOTE gate classifier itself (fixtures above inject GATE= already-decided;"
  echo "   these run the real remote script under sh with the three organs stubbed)"
  # Without this block the gate logic — the entire point of the tool — is asserted nowhere: every
  # arm above is handed a GATE= verdict someone else reached.
  _gd="$(mktemp -d)"; trap 'rm -rf "$_gd"' EXIT
  _gate() { # <locked> <console> <pwr> [--vol N] -> the GATE= the remote script computes
    mkdir -p "$_gd/bin"
    printf '#!/bin/sh\necho "%s %s"\n' "$1" "$2" > "$_gd/bin/python"
    # the real ioreg prints the key IN QUOTES; a stub that drops them makes every arm vacuous
    printf '#!/bin/sh\nprintf %s\\n %s\n' "'%s'" "'\"CurrentPowerState\"=$3'" > "$_gd/bin/ioreg"
    printf '#!/bin/sh\necho %s\n' "${4:-56}" > "$_gd/bin/osascript"
    chmod +x "$_gd/bin"/*
    PATH="$_gd/bin:/usr/bin:/bin" sh -c "$(build_remote "$(b64 x)" "$(b64 t)" 0 0 1 20 "$(b64 '')" 15)" \
      2>/dev/null | sed -n 's/^GATE=//p' | head -1
  }
  # a blank python (organ unreadable) must NOT read as open
  r="$(_gate '' '' 4)";        [ "$r" = unreadable-session ] || say_fail "blind session should be unreadable-session, got '$r'"
  r="$(_gate True True 4)";    [ "$r" = screen-locked ]      || say_fail "locked should be screen-locked, got '$r'"
  r="$(_gate False False 4)";  [ "$r" = off-console ]        || say_fail "off-console should be off-console, got '$r'"
  r="$(_gate False True 0)";   [ "$r" = display-asleep ]     || say_fail "darkwake pwr=0 should be display-asleep, got '$r'"
  r="$(_gate False True 1)";   [ "$r" = display-asleep ]     || say_fail "pwr=1 should be display-asleep, got '$r'"
  r="$(_gate False True 4)";   [ "$r" = open ]               || say_fail "unlocked+console+awake should be open, got '$r'"
  # ...and `open` must be REACHABLE, or every arm above passes vacuously against a constant
  [ "$(_gate False True 4)" = open ] || say_fail "the gate can never read open — every closed arm is vacuous"

  echo "-- payload safety"
  # 10. quoting-hostile message survives base64 + osascript argv (no AppleScript escaping at all)
  _hostile='he said "x" \ and $(rm -rf /) `id` '"'"'q'"'"''
  [ "$(printf '%s' "$_hostile" | base64 | tr -d '\n' | base64 -d)" = "$_hostile" ] \
    || say_fail "base64 round-trip lost the hostile payload"
  printf '%s' "$(build_remote "$(b64 "$_hostile")" "$(b64 t)" 0 0 0 20 "$(b64 '')" 15)" \
    | grep -q 'rm -rf' && say_fail "hostile payload reached the remote script as TEXT, not base64"

  echo "-- the confirm window is calibrated against the MEASURED lag, not a taste"
  # Read the SHIPPING default out of the running tool (not grepped from the source, and not pasted
  # here) so this arm cannot pass by agreeing with a copy of itself.
  _cw="$("$0" --confirm-window)"; _win="${_cw%% *}"; _lag="${_cw##* }"
  [ -n "$_win" ] && [ -n "$_lag" ] || say_fail "--confirm-window printed nothing"
  [ "$_lag" -ge 1 ] 2>/dev/null || say_fail "the measured lag has no value to calibrate against"
  [ "$_win" -ge $(( _lag * 2 )) ] 2>/dev/null \
    || say_fail "confirm window ${_win}s is under 2x the measured ${_lag}s store lag — every genuine delivery would read as a failure"

  echo "-- unreachable host: an actuator that cannot be reached is n/a, never delivered"
  # Driven against a REAL unroutable address (TEST-NET-1) with a real short timeout — no stub, so
  # this exercises the genuine ssh-failure path including the timeout, not a mocked return code.
  o="$(MESH_IMAC_HOST=nobody@192.0.2.1 MESH_IMAC_NOTIFY_TIMEOUT=4 "$0" unreachable-arm 2>/dev/null)"; rc=$?
  [ "$rc" = 2 ] || say_fail "unreachable host should be rc 2, got $rc"
  printf '%s' "$o" | grep -q 'state=NA' || say_fail "unreachable host should render NA, got: $o"
  printf '%s' "$o" | grep -q 'gate=unreachable' || say_fail "unreachable host should name the gate, got: $o"

  echo "-- live arm: the reach is real (reads the gate, fires NOTHING)"
  if out="$("$0" --probe 2>&1)"; then
    printf '  live: %s (gate OPEN)\n' "$out"
  else
    rc=$?
    case "$rc" in
      2) printf '  live: %s (gate closed or host dark — rc 2, honest n/a)\n' "$out" ;;
      *) say_fail "live --probe returned rc=$rc: $out" ;;
    esac
    # rc 2 is a PASS: it is the contract. A gate that can only ever read `open` would be the
    # faked all-clear this tool is built to refuse.
  fi

  [ "$fail" = 0 ] && echo "mesh-imac-notify --test: PASS" || echo "mesh-imac-notify --test: FAIL"
  exit "$fail"
;; esac


run
