#!/usr/bin/env bash
# mesh-textin — the channel-agnostic TEXT→ACT core: let the operator drive minds by TEXT,
# over ANY channel, even when tmux/SSH is down. Watches the operator text channel
# (~/.mesh/voice-in.log — fed by mesh-voice-rx over Telegram now; by SMS/email bridges later)
# and ROUTES explicit commands to a mind's pane via mesh-tell.
#
# This is the "text over any channel" survival core (operator's global direction): the channel
# is fungible (Telegram/SMS/email all just append a line); the ACTION layer is here, one place.
#
# Routing is OPT-IN by prefix so ordinary operator messages never trigger anything:
#   @<window> <text>   -> mesh-tell <window> "<text>"      e.g.  @claude check egress
#   @<node>:<win> <t>  -> mesh-tell --node <node> <win>     e.g.  @ds:shell uptime
# Plain messages (no @prefix) are left for the steward's judgment — never auto-run.
#
#   mesh-textin            watch the channel, route new commands (run as a loop / reflex)
#   mesh-textin --once     process only lines on stdin, one pass for testing
#
# Safety: voice-in.log is operator-ONLY (mesh-voice-rx filters to CHAT_ID), so every line here is
# already the operator. Routing to a pane is exactly what the steward does by hand. A persisted
# byte offset in ~/.mesh/.textin-offset prevents history replay on restart: we resume from the last
# processed byte, not from the top of the file.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
MESH="$HOME/.mesh"; LOG="$MESH/voice-in.log"; OUT="$MESH/textin.log"; BEAT="$MESH/mesh-textin.beat"
STATE="$MESH/.textin-offset"
mkdir -p "$MESH"; touch "$LOG"
ts(){ date -u +%FT%TZ; }
NODEMAP_DS="${MESH_PEER_DS:-}"   # set MESH_PEER_DS in ~/.mesh/nodes (plantability: no hardcoded IP)
log_bytes(){ wc -c < "$LOG" 2>/dev/null | tr -d '[:space:]'; }
save_offset(){ local next="$1" tmp="$STATE.$$"; printf '%s\n' "$next" > "$tmp" && mv -f "$tmp" "$STATE"; }
load_offset(){
  local size saved
  size="$(log_bytes)"
  if [ -s "$STATE" ]; then
    saved="$(tr -d '[:space:]' < "$STATE" 2>/dev/null || true)"
    case "$saved" in
      ''|*[!0-9]*) saved="$size" ;;
    esac
    [ "$saved" -gt "$size" ] && saved="$size"
  else
    saved="$size"
  fi
  printf '%s' "$saved"
}

# scrub fail-safe, resolved PER CALL (daemon outlives deploys): mask via mesh-log-scrub
# when present, raw otherwise — never lose the line. (Fixed from a self-referential
# `command -v _sc` + `_sc(){ _sc; }` recursion in the first version.)
_sc(){ command -v mesh-log-scrub >/dev/null 2>&1 && mesh-log-scrub || cat; }

STEWARD_WIN="${MESH_STEWARD_WIN:-plan}"   # 2026-06-13: steward mind lives in the 'plan' data-channel

route(){ # $1 = raw operator message
  local msg="$1"
  case "$msg" in
    /roz\ *|/roz)                  # slash command: /roz <message> — route to Rozalia's mind
      local roz_msg="${msg#/roz }"; roz_msg="${roz_msg#/roz}"
      roz_msg="$(printf '%s' "$roz_msg" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
      echo "$(ts) CMD /roz <- $roz_msg" | _sc >>"$OUT"
      if [ -n "$roz_msg" ]; then
        # Log to roz-in.log (data pane)
        printf '%s  Rozalia: %s\n' "$(ts)" "$roz_msg" >> "$HOME/.mesh/roz-in.log"
        # Feed to tg-roz mind — reply via mesh-tg to operator
        mesh-tell "tg-roz" "Rozalia says (via operator): $roz_msg — respond in Russian, warm and brief. Then: mesh-tg \"↩︎ Розалия: <your reply>\"" >/dev/null 2>&1
        echo "$(ts) ROUTED /roz to tg-roz" | _sc >>"$OUT"
      else
        command -v mesh-tg >/dev/null 2>&1 && mesh-tg "usage: /roz <message from Rozalia>" >/dev/null 2>&1
      fi
      return 0 ;;
    /mesh-tv\ *|/mesh-tv|/meshtv\ *|/meshtv)  # slash command: /meshtv or /mesh-tv <url|pause|play|stop|status>
      local arg="${msg#/mesh-tv }"; arg="${arg#/meshtv }"; arg="${arg#/mesh-tv}"; arg="${arg#/meshtv}"
      arg="$(printf '%s' "$arg" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
      echo "$(ts) CMD /meshtv <- $arg" | _sc >>"$OUT"
      if [ -n "$arg" ]; then
        result="$(mesh-tv "$arg" 2>&1)"
        rc=$?
        if [ $rc -eq 0 ]; then
          command -v mesh-tg >/dev/null 2>&1 && mesh-tg "📺 $result" >/dev/null 2>&1
        else
          command -v mesh-tg >/dev/null 2>&1 && mesh-tg "📺 mesh-tv failed: $result" >/dev/null 2>&1
        fi
      else
        command -v mesh-tg >/dev/null 2>&1 && mesh-tg "usage: /meshtv <youtube-url|pause|play|stop|status>" >/dev/null 2>&1
      fi
      return 0 ;;
    @*) : ;;                       # routable command — handled below
    *)
      # plain operator message: NOT routed to a mind here. The TG CHANNEL (mesh-channel-tg → the
      # 'tg' window mind) is the SINGLE operator-comms voice (operator 2026-06-14: "it is for tg
      # channel ONLY!"). Previously this WOKE the steward in the 'plan' window too, so the planner
      # AND the tg-mind both answered the operator → DUPLICATE replies (the Danny-message-×3 bug).
      # mesh-textin now only handles EXPLICIT routing (/roz, /meshtv, @win); plain messages are
      # owned by the tg-mind. We just LOG so the trail is intact.
      echo "$(ts) PLAIN (owned by tg-channel/tg-mind, not routed here) <- $msg" | _sc >>"$OUT"
      return 0 ;;
  esac
  local head rest target node win
  head="${msg%% *}"; rest="${msg#* }"
  [ "$head" = "$rest" ] && rest=""          # no args
  target="${head#@}"                        # strip @
  case "$target" in
    ds:*)  node="$NODEMAP_DS"; win="${target#ds:}" ;;
    *:*)   node="${target%%:*}"; win="${target#*:}" ;;   # user@ip:win (must be full)
    *)     node=""; win="$target" ;;                     # local window
  esac
  [ -n "$rest" ] || { echo "$(ts) SKIP empty-cmd for @$target" | _sc >>"$OUT"; return 0; }
  if [ -n "$node" ]; then
    if mesh-tell --node "$node" "$win" "$rest" >/dev/null 2>&1; then
      echo "$(ts) ROUTED @$node:$win <- $rest" | _sc >>"$OUT"
    else
      echo "$(ts) ROUTE-FAILED @$node:$win <- $rest (node unreachable or pane gone)" | _sc >>"$OUT"
    fi
  else
    if mesh-tell "$win" "$rest" >/dev/null 2>&1; then
      echo "$(ts) ROUTED @$win <- $rest" | _sc >>"$OUT"
    else
      echo "$(ts) ROUTE-FAILED @$win <- $rest (pane '$win' gone?)" | _sc >>"$OUT"
    fi
  fi
  # text-OUT: close the loop — after the pane acts, capture its result and reply to the operator
  # over the same channel (so commands are useful even when SSH/tmux is unreachable). Backgrounded
  # so the watch loop never blocks. Heuristic: settle, then send the pane's fresh tail.
  ( sleep 5
    local cap="" raw=""
    if [ -n "$node" ]; then
      # Keep the REMOTE command minimal — just capture the pane. Filtering (drop-blank + tail) runs
      # LOCALLY, so there's no fragile nested-regex-in-double-quotes on the ssh line (was a flagged
      # quoting hazard). And propagate the failure: tell the operator if the pane can't be read,
      # instead of swallowing the error into a silent empty reply.
      if raw=$(ssh -o BatchMode=yes -o ConnectTimeout=8 "$node" "pidx=\$(tmux list-panes -t \$(hostname):$win -F '#{pane_top} #{pane_index}' 2>/dev/null | sort -n | tail -1 | awk '{print \$2}'); tmux capture-pane -t \$(hostname):$win\${pidx:+.\$pidx} -p" 2>/dev/null); then
        cap=$(printf '%s\n' "$raw" | grep -v '^[[:space:]]*$' | tail -8)
      else
        command -v mesh-tg >/dev/null 2>&1 && \
          mesh-tg "↩︎ @$target: couldn't read the pane ($node unreachable or window gone)" >/dev/null 2>&1
      fi
    else
      local pidx
      pidx=$(tmux list-panes -t "$(hostname):$win" -F '#{pane_top} #{pane_index}' 2>/dev/null | sort -n | tail -1 | awk '{print $2}')
      cap=$(tmux capture-pane -t "$(hostname):$win${pidx:+.$pidx}" -p 2>/dev/null | grep -v '^[[:space:]]*$' | tail -8)
    fi
    [ -n "$cap" ] && command -v mesh-tg >/dev/null 2>&1 && \
      mesh-tg "↩︎ @$target result:"$'\n'"$cap" >/dev/null 2>&1
  ) &
}

extract(){ # strip "HH:MM:SSZ  TEXT  " / "  VOICE  " prefix -> raw message
  printf '%s' "$1" | sed -E 's/^[0-9:]+Z[[:space:]]+(TEXT|VOICE)[[:space:]]+//'
}

if [ "${1:-}" = --test ]; then
  [ -f "$LOG" ] && [ -f "$OUT" ] && echo "smoke-test: ok" && exit 0 || { echo "smoke-test: FAIL"; exit 1; }
fi
if [ "${1:-}" = --once ]; then
  # test mode: read lines fed on stdin (or do nothing) — used by the test harness
  while IFS= read -r line; do route "$(extract "$line")"; done
  exit 0
fi
# Atomic singleton guard for the long-running watcher. Do not use pgrep here:
# launches via `bash -lc mesh-textin` contain the same name in the parent command
# line, so a process-name guard can reject every legitimate start.
exec 9>"$MESH/.mesh-textin.lock"
if ! flock -n 9; then
  # A duplicate start bouncing off the live singleton is NORMAL (every smoke-test /
  # keepalive launch lands here). Stay SILENT — logging it spammed textin.log with
  # fake "restart storm" noise and triggered a false 'operator text-in lossy' alarm.
  exit 0
fi
# Banner AFTER the lock: only the process that actually becomes the watcher logs it,
# so a "watching" line now means a REAL (re)start, never a --test/--once/bounce. The
# banner used to sit above the --test early-exit, so every smoke-check forged one.
echo "$(ts) [mesh-textin] watching $LOG (route /roz /meshtv @win commands; plain msgs owned by tg-channel/tg-mind, NOT routed to a mind here)" | _sc >>"$OUT"
# Resume from the last processed byte rather than replaying history. If the log has shrunk since the
# last run, clamp to EOF and continue from there.
offset="$(load_offset)"
save_offset "$offset"
start_byte=$((offset + 1))
# NO liveness beat: mesh-textin is an event-WAITER; the supervisor's wedged-check only runs if a
# .beat file exists, so we publish none.
tail -c +"$start_byte" -F "$LOG" 2>/dev/null | while IFS= read -r line; do
  route "$(extract "$line")" || true
  offset=$((offset + $(printf '%s' "$line" | wc -c | tr -d '[:space:]') + 1))
  save_offset "$offset"
done
