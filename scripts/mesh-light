    [ "$(printf '%s' "$_wnd" | awk '{print $2}')" = stale ] || { echo "  FAIL: direct-failure must keep primary token 'stale' (got: $_wnd)"; _f=1; }
    printf '%s' "$_wnd" | grep -q 'no-device' || { echo "  FAIL: absent device must name sub-reason 'no-device' (got: $_wnd)"; _f=1; }
