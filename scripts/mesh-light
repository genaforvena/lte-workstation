    rm -rf "$_wd"
    unset MESH_CAM_LIGHT_DIRECT
    # --- LIVE real-read gate (verification principle: a real hardware read must produce data). Only
    # when the real device exists AND is accessible; an inaccessible/absent camera is an honest n/a
