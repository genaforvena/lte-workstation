#!/usr/bin/env bash
# reflex-cadence: 9-59/10 * * * *
# reflex-args: --edge
# doctor-artifact: $HOME/.mesh/.light-state 2400 phone
#   ^ smoke-theater gate (mesh-doctor): .light-state is rewritten on EVERY successful read (not only on
#     a verdict change), so phone-reachable + state >2400s stale ⟹ the sense is silently not producing
#     despite a green --test. Phone offline → gate skips (no false-fail). See mesh-doctor _theater_check.
# mesh-light — the mesh's ambient-light sense for the body phone.
# Reads the phone's tmd2755_l sensor (0-65535 lux) and classifies into 5 levels.
#
# Levels (with hysteresis bands to prevent flapping):
#   DARK     0-2 lux    pitch black, no light source
#   DIM      3-30 lux   TV glow, nightlight, very low ambient
#   MODERATE 31-150 lux typical room lighting, evening
#   LIT      151-600 lux well-lit room, office lighting
#   BRIGHT   600+ lux   direct sunlight, very bright
#
# Hysteresis: each level transition has a dead-band. Once in DARK, must rise
# above the DARK→DIM threshold (5 lux) to leave. Once in BRIGHT, must fall
# below the BRIGHT→LIT threshold (400 lux) to leave. This prevents oscillation
# when the lux reading hovers at a boundary.
#
#   mesh-light          one check; edge-trigger on level change
#   mesh-light --status print current lux/level, no alarm
#   mesh-light --edge   emit only on state change
#   mesh-light --json   machine-readable {level, lux, ts, prev, stable_s, delta, velocity, change_class,
#                       direction, source, coarse, webcam_reason?}
#   mesh-light --webcam node-webcam COARSE level (phone-independent fallback; exit 2 if no usable frame.
#                       Feeder frame stale/missing → tries ONE direct fswebcam grab (via=direct) before
#                       giving up; env MESH_CAM_LIGHT_DIRECT=0 disables, MESH_CAM_LIGHT_DEV=/dev/video0)
#   mesh-light --test   smoke test (exit 2 = n/a, phone unreachable)
#
# Webcam fallback (coverage when the phone — the lux sensor — is offline): the lux sensor is on the body
# phone, so the precise axis dies (exit 2) whenever the phone drops. This node has its OWN webcam
# (mesh-cam-watch keeps ~/.mesh/cam-prev.jpg fresh), so the text/--edge paths fall back to a COARSE
# ambient level read from the live frame's mean luma — honest-degraded, never a faked lux. Guards below.
#
# Beacon fallback (2026-07-07, ranked ABOVE webcam): the phone ALSO pushes its lux to phaedra's
# loc-collector (:8092 → phone-track.log) every ~10-15min, independent of sshd — proven live through
# the 2026-07-07 sshd outage. On SSH failure the freshest beacon record (younger than the sense's own
# 2400s cutoff) yields a REAL-lux classification tagged source=beacon (JSON: source=beacon +
# source_age_s; text: "beacon-derived"). Stale/absent beacon falls through to webcam, then honest
# OFFLINE — the state line then names BOTH failures ("OFFLINE <ts> beacon=<reason> webcam=<reason>").
#
# Enrichment: transition tracking + rate-of-change
#   State file .light-state: current level (existing); on honest n/a it holds "OFFLINE <ts>",
#     plus " webcam=<no-frame|stale|covered|no-pil|unreadable>" when the webcam fallback also
#     failed with a classified reason (2026-07-05 — consumers read field 1, unaffected)
#   State file .light-transitions: prev_level|prev_lux|prev_ts|change_count
#   State file .light-velocity: last3_lux|last3_ts|smoothed_lux
#   Output includes: prev (previous level), stable_s (seconds since last change),
#   delta (lux change since last reading — positive=brighter, negative=darker).
#   NEW: velocity (lux/second rate of change), smoothed (3-sample moving avg),
#   change_class (GRADUAL|SUDDEN|STABLE — velocity-based classification).
#   Velocity lets consumers distinguish sunset drift from a light switch.
#
# Exit codes (honest-exit contract):
#   0 = level assessed (precise phone lux, OR a coarse webcam-derived level when the phone is offline)
#   2 = cannot read: phone unreachable AND no usable webcam frame — never faked. --webcam names the
#       SPECIFIC reason (no-frame|stale|covered|no-pil|unreadable) so a blocked lens reads distinctly
#       from a dead feeder from a missing dep (each needs a different fix).
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes"

STATE="$HOME/.mesh/.light-state"
WEBCAM_NA=""   # set by _webcam_fallback when the webcam fallback fails with a classified reason
BEACON_NA=""   # set by _beacon_fallback when the beacon fallback fails with a classified reason
# Beacon fallback (2026-07-07, knowledge/capability-beacon-fallback-phone-senses-20260707.md):
# the phone pushes telemetry (incl. its OWN tmd2755 lux) to phaedra's loc-collector every ~10-15min
# INDEPENDENTLY of sshd — the push path stayed live through the 2026-07-07 sshd outage while this
# sense sat OFFLINE. On SSH failure, tail the freshest phone-track.log record; if younger than the
# sense's own staleness cutoff, classify from it tagged source=beacon (REAL lux, coarser cadence,
# right sensor). Ranked ABOVE the webcam tier: beacon is the phone's own light sensor; webcam is a
# different room's proxy luma. A stale/absent beacon is an honest fall-through, never a faked read.
BEACON_HOST="${MESH_LIGHT_BEACON_HOST:-root@100.94.116.17}"          # phaedra (loc-collector :8092)
BEACON_LOG="${MESH_LIGHT_BEACON_LOG:-/root/.mesh/phone-track.log}"
BEACON_MAX_AGE="${MESH_LIGHT_BEACON_MAX_AGE:-2400}"                  # = the sense's doctor-artifact staleness cutoff
OFFLINEFILE="$HOME/.mesh/.light-offline"
# light_dwell enrichment (2026-06-28): the existing 1-field state only captures the CURRENT
# classification, not how long the light level has been held. The new additive fields 2+3 are
# `<dwell_s>|<changes_24h>` — seconds-since-last-level-change and count of level changes in
# the last 24h. Captures "lights have been DIM for 2h" vs "just transitioned to DIM" — distinct
# from the per-classify verdict (which is just "what is it now?"). A user grepping `dwell_s=`
# gets the dwell band without breaking the 1-field reader.
LIGHT_LOG="$HOME/.mesh/.light-events"  # one line per level change: epoch|level
# classify_dwell <seconds> → echoes "BAND|seconds". Pure, offline-testable.
# Bands (FALSIFIABLE: change the 5/60/1800 thresholds → tests flip):
#   TRANSITION  0–5s   — just changed
#   RECENT     5–60s  — recently changed
#   STABLE     1–30m  — level held for a while
#   CHRONIC    30m+   — long-stable light level
#   NEVER      no reading on record
classify_dwell() {
  local s="${1:-}"
  if [ -z "$s" ] || ! [ "$s" -ge 0 ] 2>/dev/null; then echo "NEVER|no reading on record"; return; fi
  if   [ "$s" -lt 5 ];    then echo "TRANSITION|${s}s (just changed)"; return; fi
  if   [ "$s" -lt 60 ];   then echo "RECENT|${s}s (under 1m)"; return; fi
  if   [ "$s" -lt 1800 ]; then echo "STABLE|$((s/60))m (under 30m)"; return; fi
  echo "CHRONIC|$((s/60))m (long-stable)"
}

# read_prev_level <state_file> → prints just the LEVEL token from STATE, defaulting to UNKNOWN
# when missing/empty. STATE holds "LEVEL|dwell_s=N|changes_24h=N" (additive light_dwell fields,
# 2026-06-28) or a legacy bare LEVEL — cut -d'|' -f1 handles both, and a non-pipe value (e.g. the
# "OFFLINE <ts>" marker) passes through unchanged (still won't match a classify() case branch,
# which is the existing/intended honest-snap behavior for that marker).
# FIDELITY FIX (2026-07-04 sense-enrichment audit): a raw `cat "$STATE"` fed classify() the WHOLE
# multi-field string post-dwell-enrichment, which never matched DARK/DIM/MODERATE/LIT/BRIGHT and
# silently fell through to the non-hysteretic snap classifier on EVERY run — defeating the tool's
# headline hysteresis feature — and the same contaminated value broke --edge's unchanged-dedup
# (`[ "$level" = "$prev" ]` can never be true against a 3-field string), so --edge fired on every
# cron tick regardless of a real level change.
read_prev_level() {
  local v
  v="$(cut -d'|' -f1 "$1" 2>/dev/null)"
  [ -n "$v" ] && printf '%s\n' "$v" || echo UNKNOWN
}

classify() {
  local l=$1 p=$2
  case "$p" in
    DARK)     [ "$l" -gt 5   ] && { echo DIM;     return; }; echo DARK;;
    DIM)      [ "$l" -lt 3   ] && { echo DARK;    return; }
              [ "$l" -gt 30  ] && { echo MODERATE; return; }; echo DIM;;
    MODERATE) [ "$l" -lt 15  ] && { echo DIM;     return; }
              [ "$l" -gt 150 ] && { echo LIT;     return; }; echo MODERATE;;
    LIT)      [ "$l" -lt 80  ] && { echo MODERATE;return; }
              [ "$l" -gt 600 ] && { echo BRIGHT;  return; }; echo LIT;;
    BRIGHT)   [ "$l" -lt 400 ] && { echo LIT;     return; }; echo BRIGHT;;
    *)        if   [ "$l" -le 2   ]; then echo DARK
              elif [ "$l" -le 30  ]; then echo DIM
              elif [ "$l" -le 150 ]; then echo MODERATE
              elif [ "$l" -le 600 ]; then echo LIT
              else echo BRIGHT; fi;;
  esac
}

classify_velocity_dir() {
  python3 - "$1" <<'PY'
import sys
try:
    v=float(sys.argv[1])
except Exception:
    print("FLAT")
    raise SystemExit(0)
if v > 0.1:
    print("BRIGHTENING")
elif v < -0.1:
    print("DARKENING")
else:
    print("FLAT")
PY
}

# --- Webcam fallback (node-local light coverage when the phone — the lux sensor — is offline) ---
# HONESTY GUARDS (why this can NOT manufacture a false reading):
#   * Freshness: a frame older than CAM_LIGHT_TTL is not a current reading → cannot-assess (rc 2).
#   * Flat-field: a covered lens / blank frame is a near-constant field (stddev≈0) carrying NO ambient
#     light info — it must NOT read as DARK. stddev < FLAT_STDDEV → cannot-assess (rc 2), not a faked DARK.
#     (Observed live 2026-06-25: the IdeaPad lens was capped → mean 17, stddev 0.4 → correctly UNKNOWN.)
#   * JPEG-noise trap (fidelity 2026-07-06, memory jpeg-destroys-pixel-noise-variance): the feeder frame
#     is JPEG, which CRUSHES per-pixel sensor noise — so a genuinely DIM real scene can drop below
#     FLAT_STDDEV and get falsely called `covered` (a false cannot-assess that blanks the light axis).
#     The flat-field verdict now needs BOTH low per-pixel stddev AND low LOW-FREQUENCY spatial structure
#     (STRUCT_FLOOR): the frame is block-averaged to 8×8 (BOX = per-block mean) and the stddev of those
#     block means — large-scale luma structure JPEG preserves — must also be near-zero. sd<FLAT but
#     struct>=STRUCT_FLOOR ⟹ a real scene JPEG merely flattened → recover via the luma bands, don't fake
#     covered. Still conservative toward cannot-assess: struct in [0,floor) with sd<FLAT stays `covered`.
#   * Coarse-only: webcam AGC makes absolute luma an unreliable lux proxy, so we emit only DARK/
#     DIM/TWILIGHT/LIT (coarse bands), never the precise 5-level lux scale, and never a numeric lux.
CAM_FRAME="${MESH_CAM_FRAME:-$HOME/.mesh/cam-prev.jpg}"
CAM_LIGHT_TTL="${MESH_CAM_LIGHT_TTL:-180}"       # frame older than this (s) → not a current reading
FLAT_STDDEV="${MESH_CAM_LIGHT_FLAT:-3}"          # luma stddev below this → flat field (covered/blank) → cannot assess
STRUCT_FLOOR="${MESH_CAM_LIGHT_STRUCT:-1.0}"     # 8x8 block-mean stddev below this (WITH sd<FLAT) → covered; above → real low-freq structure (JPEG-flattened scene) → recover via luma
DARK_MAX="${MESH_CAM_LIGHT_DARK_MAX:-40}"         # mean luma < this (with real variance) → DARK
TWILIGHT_MIN="${MESH_CAM_LIGHT_TWILIGHT_MIN:-80}" # mean luma >= this → TWILIGHT (mid-brightness)
LIT_MIN="${MESH_CAM_LIGHT_LIT_MIN:-110}"          # mean luma >= this → LIT; between twilight/lit → TWILIGHT

# DIRECT one-shot capture fallback (coverage 2026-07-05): the feeder frame (mesh-cam-watch →
# cam-prev.jpg) is a SINGLE POINT OF FAILURE for the whole webcam path — feeder dead ⟹ light sense
# dead even though the camera itself works. Found live 2026-07-05: the operator's desktop session
# ended → logind handed the seat device ACLs to gdm → the feeder daemon (still "active (running)")
# got EACCES on every grab for 19h, and mesh-light mis-blamed it as "cam feeder stalled". When the
# feeder frame is missing/stale, try ONE direct fswebcam grab before giving up — and when that also
# fails, name the REAL fault (no-access ≠ no-device ≠ capture-fail) instead of blaming the feeder.
# Consent: same organ/consent envelope as the always-on mesh-cam-watch reflex; only fires when the
# feeder is already dead (frame stale ⟹ no device contention). Frame goes to .light-direct.jpg
# (same privacy class as cam-prev.jpg, node-local, never sent). Tests set MESH_CAM_LIGHT_DIRECT=0.
DIRECT_FRAME="$HOME/.mesh/.light-direct.jpg"
# direct_capture → 0 (fresh frame written to $DIRECT_FRAME) | 1 + echoes a specific reason token.
direct_capture() {
  [ "${MESH_CAM_LIGHT_DIRECT:-1}" = 1 ] || { echo "direct-disabled (MESH_CAM_LIGHT_DIRECT=0)"; return 1; }
  local dev="${MESH_CAM_LIGHT_DEV:-/dev/video0}"
  [ -e "$dev" ] || { echo "no-device ($dev absent)"; return 1; }
  { [ -r "$dev" ] && [ -w "$dev" ]; } || { echo "no-access (cannot open $dev — seat/device ACL lost? check getfacl $dev)"; return 1; }
  command -v fswebcam >/dev/null 2>&1 || { echo "no-tool (fswebcam not installed)"; return 1; }
  if timeout "${MESH_CAM_LIGHT_DIRECT_TIMEOUT:-20}" fswebcam -q -d "$dev" -r 320x240 \
       -S "${MESH_CAM_LIGHT_WARMUP:-6}" --no-banner "$DIRECT_FRAME.tmp" >/dev/null 2>&1 \
     && [ -s "$DIRECT_FRAME.tmp" ]; then
    mv "$DIRECT_FRAME.tmp" "$DIRECT_FRAME"; return 0
  fi
  rm -f "$DIRECT_FRAME.tmp" 2>/dev/null
  echo "capture-fail ($dev present+accessible but the grab failed — busy/wedged?)"; return 1
}

# webcam_light <frame> → prints "LEVEL mean=.. stddev=.." + returns 0 on a usable coarse reading;
# returns 2 (cannot assess) — NEVER a fabricated level. On a cannot-assess it now prints a DISTINCT
# REASON line "n/a <reason> (...)" so the caller can surface WHICH failure mode this is instead of an
# opaque lump (fidelity 2026-06-27): the five cannot-assess conditions are physically DIFFERENT states —
#   no-frame   the cam feeder never produced a frame (mesh-cam-watch absent/never ran)
#   stale      a frame exists but is older than the TTL (feeder stalled) — not a CURRENT reading
#   covered    the lens is physically BLOCKED/blank (flat field, stddev<FLAT) — the camera WORKS, it is
#              obstructed; a real, detectable tamper/privacy state, NOT "the sense is broken"
#   no-pil     python PIL/Pillow missing (dependency gap, not a hardware state)
#   unreadable a frame is present but not a decodable image (corrupt/truncated capture)
# All still exit 2 (covered is never emitted as a faked DARK), but a consumer/operator reading the reason
# can tell "someone covered the camera" from "the feeder died" from "a dep is missing" — each needs a
# different fix. The SUCCESS line ("LEVEL mean=.. stddev=..") is byte-identical for existing levels; the
# degraded webcam path now has one more honest mid-band (`TWILIGHT`) instead of collapsing all mid-luma
# values into `DIM`.
webcam_light() {
  local f="$1" now mt age via="" dreason res rc
  now="$(date +%s)"; mt="$(stat -c %Y "$f" 2>/dev/null || echo 0)"; age=$(( now - mt ))
  if [ ! -f "$f" ] || [ "$age" -lt 0 ] || [ "$age" -gt "$CAM_LIGHT_TTL" ]; then
    # feeder frame unusable → ONE direct grab before giving up (direct_capture above). On success the
    # analysis below runs on the fresh direct frame; the success line gains a trailing "via=direct"
    # (field 1 = LEVEL unchanged, existing awk-consumers unaffected). On failure keep the existing
    # primary reason token (no-frame|stale — consumer contract) + append the direct sub-reason, which
    # names the REAL fault (a no-access there means the feeder is a victim, not the culprit).
    if dreason="$(direct_capture)"; then
      f="$DIRECT_FRAME"; via=" via=direct"
    elif [ ! -f "$1" ]; then
      echo "n/a no-frame (no webcam frame at $1 — cam feeder absent/never ran; direct capture also failed: ${dreason})"; return 2
    else
      echo "n/a stale (frame ${age}s old > ${CAM_LIGHT_TTL}s TTL — feeder not producing; direct capture also failed: ${dreason})"; return 2
    fi
  fi
  res="$(MCL_FLAT="$FLAT_STDDEV" MCL_STRUCT="$STRUCT_FLOOR" MCL_DARK="$DARK_MAX" MCL_TWILIGHT="$TWILIGHT_MIN" MCL_LIT="$LIT_MIN" python3 - "$f" <<'PY'
import sys, os
try:
    from PIL import Image, ImageStat
except Exception:
    print("n/a no-pil (python PIL/Pillow not installed — cannot read frame luma)"); sys.exit(2)
FLAT=float(os.environ["MCL_FLAT"]); STRUCT=float(os.environ["MCL_STRUCT"]); DARK=float(os.environ["MCL_DARK"]); TWILIGHT=float(os.environ["MCL_TWILIGHT"]); LIT=float(os.environ["MCL_LIT"])
try:
    im=Image.open(sys.argv[1]).convert("L"); st=ImageStat.Stat(im)
    mean=st.mean[0]; sd=st.stddev[0]
    # low-frequency spatial structure: block-average to 8x8 (per-block MEAN) and take the stddev of the
    # block means. Averaging kills per-pixel noise + JPEG blocking, retaining only LARGE-SCALE luma
    # variation — the part of a real scene JPEG preserves. A blocked/blank lens is uniform in space too
    # (struct≈0); a JPEG-flattened dim scene keeps struct>0. Distinguishes covered from real-but-flat.
    try:    small=im.resize((8, 8), Image.Resampling.BOX)
    except Exception: small=im.resize((8, 8))    # older Pillow: default filter still block-averages down
    struct=ImageStat.Stat(small).stddev[0]
except Exception:
    print("n/a unreadable (frame present but not a decodable image — corrupt/truncated capture)"); sys.exit(2)
if sd < FLAT and struct < STRUCT:
    # flat in BOTH per-pixel (sd) AND low-freq structure (struct) → genuinely blocked/blank lens carrying
    # NO ambient-light info → covered, NOT a faked DARK. If sd<FLAT but struct>=STRUCT the frame HAS real
    # large-scale structure JPEG merely flattened the per-pixel noise of → fall through to the luma bands.
    print("n/a covered (lens blocked/blank — flat field mean=%.1f stddev=%.1f<%.1f struct=%.2f<%.2f, no ambient-light info)" % (mean, sd, FLAT, struct, STRUCT)); sys.exit(2)
if mean < DARK:
    lvl = "DARK"
elif mean >= LIT:
    lvl = "LIT"
elif mean >= TWILIGHT:
    lvl = "TWILIGHT"
else:
    lvl = "DIM"
print("%s mean=%.1f stddev=%.1f" % (lvl, mean, sd)); sys.exit(0)
PY
)"; rc=$?
  printf '%s%s\n' "$res" "$([ "$rc" = 0 ] && printf '%s' "$via")"
  return "$rc"
}

# _webcam_fallback: called at each phone-unreachable point. Emits a COARSE webcam level (refreshing the
# light axis so it isn't dead while the phone is offline) and exits 0; RETURNS only if the webcam can't
# help either, so the caller proceeds to the honest exit 2. JSON gets the same coarse path, but marked
# source=webcam/coarse=true so downstream consumers can distinguish it from a precise phone read.
# (Defined up here, above the --test block, so the offline-reason regression can exercise it.)
_webcam_fallback() {
  local wout lvl prevw reason
  if ! wout="$(webcam_light "$CAM_FRAME")"; then
    # Webcam couldn't assess either. Keep its CLASSIFIED reason (field 2 of the "n/a <reason> (…)"
    # failure line: no-frame|stale|covered|no-pil|unreadable) in WEBCAM_NA so the caller's OFFLINE
    # state write names WHY the fallback failed too — "OFFLINE <ts> webcam=covered" (shutter closed,
    # operator's hands) needs a physically different fix from "webcam=no-frame" (dead feeder), and
    # the bare OFFLINE lumped them (dash showed OFFLINE for 19h while the real state was 'covered').
    # Consumer-safe: the OFFLINE line was ALREADY multi-field prose ("OFFLINE <ts>"), and every
    # reader takes field 1 (awk $1 / %%|* / fst→sensorium shows the line verbatim) or collapses
    # non-vocab to UNREACHABLE — swept all 9 .light-state consumers 2026-07-05.
    WEBCAM_NA="$(printf '%s' "$wout" | awk '{print $2}')"
    return 0
  fi
  lvl="${wout%% *}"
  reason="${wout#* }"
  prevw="$(read_prev_level "$STATE")"
  printf '%s\n' "$lvl" > "$STATE"
  mesh-state-touch "$STATE"
  [ "$MODE" = edge ] && [ "$lvl" = "$prevw" ] && exit 0
  if [ "$MODE" = json ]; then
    emit_light_json "$lvl" null "$TS" "$prevw" null null null null null COARSE FLAT webcam true "$reason"
  else
    echo "[room-${lvl,,}] $lvl (webcam-derived, coarse — phone offline; ${wout#* })"
  fi
  exit 0
}

# beacon_read → the freshest phone-track.log JSON line from phaedra (or the test fixture).
# Empty output = push path unreachable/empty. Kept separate from the parse so --test can inject.
beacon_read() {
  if [ -n "${MESH_LIGHT_BEACON_FIXTURE:-}" ]; then printf '%s' "$MESH_LIGHT_BEACON_FIXTURE"; return 0; fi
  timeout 8 ssh -o BatchMode=yes -o ConnectTimeout=5 "$BEACON_HOST" "tail -1 $BEACON_LOG" </dev/null 2>/dev/null
}

# beacon_lux <json_line> <max_age> → "LUX AGE" (rc 0) or "n/a <reason> (…)" (rc 2), reason ∈
# unreachable|unparseable|no-lux|stale — same classified-failure shape as webcam_light, so the
# OFFLINE state write can name WHY this tier couldn't help. Freshness is judged against the
# record's own ts (phaedra receive time; tailnet NTP) vs local now — never trusts a stale push.
beacon_lux() {
  local line="$1" max_age="$2"
  [ -n "$line" ] || { echo "n/a unreachable (no beacon record — phaedra/push-log unreachable or empty)"; return 2; }
  local out
  out="$(printf '%s' "$line" | BEACON_MAX="$max_age" python3 -c 'import json,sys,os,time
try:
    d,_=json.JSONDecoder().raw_decode(sys.stdin.read().strip())
except Exception:
    print("n/a unparseable (beacon record is not valid JSON)"); sys.exit(2)
ts=d.get("ts"); lux=d.get("lux")
try:
    age=int(time.time())-int(ts)
except Exception:
    print("n/a unparseable (beacon record has no usable ts)"); sys.exit(2)
if lux is None or str(lux)=="":
    print("n/a no-lux (beacon record carries no lux field — sensor read failed phone-side)"); sys.exit(2)
try:
    lux=int(float(lux))
except Exception:
    print("n/a no-lux (beacon lux unparseable: %r)" % (lux,)); sys.exit(2)
maxa=int(os.environ["BEACON_MAX"])
if age>maxa or age<0:
    print("n/a stale (beacon %ds old > %ds cutoff — push path also gone quiet)" % (age,maxa)); sys.exit(2)
print("%d %d" % (lux,age)); sys.exit(0)' 2>/dev/null)"; local rc=$?
  printf '%s\n' "$out"
  return "$rc"
}

# _beacon_fallback: called at each phone-unreachable point, BEFORE _webcam_fallback. On a fresh
# beacon record it classifies the REAL lux (full hysteresis vs prev level) and exits 0 tagged
# source=beacon; on any classified failure it sets BEACON_NA and RETURNS so the caller tries the
# webcam tier. Deliberately does NOT touch the transition/velocity state files: a ~10-15min-cadence
# secondary source would corrupt the velocity/delta axes computed for the 10-min pull cadence —
# level + state freshness only, never a faked pull-cadence enrichment.
_beacon_fallback() {
  local bout lux age lvl prevb
  if ! bout="$(beacon_lux "$(beacon_read)" "$BEACON_MAX_AGE")"; then
    BEACON_NA="$(printf '%s' "$bout" | awk '{print $2}')"
    return 0
  fi
  lux="${bout%% *}"; age="${bout#* }"
  prevb="$(read_prev_level "$STATE")"
  lvl="$(classify "$lux" "$prevb")"
  printf '%s\n' "$lvl" > "$STATE"
  mesh-state-touch "$STATE"
  [ "$MODE" = edge ] && [ "$lvl" = "$prevb" ] && exit 0
  if [ "$MODE" = json ]; then
    emit_light_json "$lvl" "$lux" "$TS" "$prevb" null null null null null STABLE FLAT beacon false "" "$age"
  else
    echo "[room-${lvl,,}] $lvl (beacon-derived — phone SSH down; push-beacon lux=$lux age=${age}s via phaedra)"
  fi
  exit 0
}

emit_light_json() {
  local level="$1" lux="$2" ts="$3" prev="$4" stable_s="$5" delta="$6" changes="$7" velocity="$8" smoothed="$9" change_class="${10}" direction="${11}" source="${12:-phone}" coarse="${13:-false}" webcam_reason="${14:-}" source_age="${15:-}"
  LEVEL="$level" LUX="$lux" TS="$ts" PREV="$prev" STABLE_S="$stable_s" DELTA="$delta" CHANGES="$changes" \
    VELOCITY="$velocity" SMOOTHED="$smoothed" CHANGE_CLASS="$change_class" DIRECTION="$direction" \
    SOURCE="$source" COARSE="$coarse" WEBCAM_REASON="$webcam_reason" SOURCE_AGE="$source_age" python3 - <<'PY'
import json, os
def num(v):
    if v in ("", "null", None):
        return None
    try:
        return float(v) if any(c in str(v) for c in ".eE") else int(v)
    except Exception:
        return None
rec = {
    "level": os.environ["LEVEL"],
    "lux": num(os.environ["LUX"]),
    "ts": os.environ["TS"],
    "prev": os.environ["PREV"],
    "stable_s": num(os.environ["STABLE_S"]),
    "delta": num(os.environ["DELTA"]),
    "changes": num(os.environ["CHANGES"]),
    "velocity": num(os.environ["VELOCITY"]),
    "smoothed": num(os.environ["SMOOTHED"]),
    "change_class": os.environ["CHANGE_CLASS"],
    "direction": os.environ["DIRECTION"],
    "source": os.environ["SOURCE"],
    "coarse": os.environ["COARSE"].lower() == "true",
}
if os.environ.get("WEBCAM_REASON"):
    rec["webcam_reason"] = os.environ["WEBCAM_REASON"]
if os.environ.get("SOURCE_AGE"):
    rec["source_age_s"] = num(os.environ["SOURCE_AGE"])
print(json.dumps(rec, separators=(",", ":")))
PY
}

# ─── Note 3 craft-room light vantage (2026-07-07) ────────────────────────────
# A SECOND-room light sense, INDEPENDENT of the body phone. The Note 3 (SM-N900,
# Android 5.0, no Termux) sits in the CRAFT ROOM off the ds node's USB adb; its
# MAX88922 android.sensor.light reads LIVE via `dumpsys sensorservice` through the
# SAME adb→ds relay baro/temp use (MESH_BARO_ADB_NODE + MESH_BARO_ADB_SERIAL). The
# body phone (Redmi) + this node's webcam are a DIFFERENT room, so this adds a genuine
# per-room light/occupancy vantage — room-level, not a duplicate of the body sense.
# HONEST-DEGRADE: adb body unreachable OR no light line ⟹ that room reads UNKNOWN
# (rc 2), never a faked level. Separate state file (.light-craft-state) so it NEVER
# clobbers the body-phone .light-state. On-change caveat: android.sensor.light is an
# on-change sensor, but the Note3's display auto-brightness listener keeps it firing,
# so `last=<lux,…>` tracks the room live (unlike the listener-less SHTC1 temp). lux=0
# is a VALID dark reading (matches the beacon path), not a no-listener na.
CRAFT_STATE="$HOME/.mesh/.light-craft-state"
CRAFT_ROOM="${MESH_NOTE3_LIGHT_ROOM:-craft}"
NOTE3_ADB_NODE="${MESH_NOTE3_LIGHT_ADB_NODE:-${MESH_NOTE3_ADB_NODE:-${MESH_BARO_ADB_NODE:-}}}"
NOTE3_ADB_SERIAL="${MESH_NOTE3_ADB_SERIAL:-${MESH_BARO_ADB_SERIAL:-}}"

# note3_dumpsys → raw `dumpsys sensorservice` from the Note3 via the adb→ds relay
# (empty on failure). Mirrors mesh-baro's adb_dumpsys: local adb OR ssh→remote adb.
note3_dumpsys() {
  local ser=""; [ -n "$NOTE3_ADB_SERIAL" ] && ser="-s $NOTE3_ADB_SERIAL"
  if [ "$NOTE3_ADB_NODE" = local ]; then
    timeout 20 adb $ser shell dumpsys sensorservice 2>/dev/null
  else
    timeout 25 ssh -o BatchMode=yes -o ConnectTimeout=8 -o StrictHostKeyChecking=accept-new \
      "$NOTE3_ADB_NODE" "adb $ser shell dumpsys sensorservice 2>/dev/null" </dev/null 2>/dev/null
  fi
}

# note3_light_lux — parse a dumpsys dump on stdin → android.sensor.light values[0] as
# an integer lux (rc 0), or empty + rc 1 when the light line is absent/unparseable.
# Pure/offline-testable. FALSIFIABLE: the --test parse fixtures pin the regex + fields.
NOTE3_LIGHT_PY='
import sys, re
txt = sys.stdin.read()
lux = None
for line in txt.splitlines():
    if "android.sensor.light" in line and "last=<" in line:
        m = re.search(r"last=<\s*([-\d.]+)", line)
        if m:
            lux = float(m.group(1)); break
if lux is None or lux < 0:
    sys.exit(1)
print(int(lux))
'
note3_light_lux() { python3 -c "$NOTE3_LIGHT_PY" 2>/dev/null; }

# note3_craft_read [emit] — read+classify the craft-room light via the adb→ds relay,
# write CRAFT_STATE (mtime=liveness on EVERY successful read, per liveness-touch), and
# (when $1=emit) print a room-tagged line. rc 0 = level assessed; rc 2 = honest UNKNOWN
# (unconfigured, adb body unreachable, or no light line) — never a faked level. Uses the
# SAME classify() + hysteresis as the body sense, keyed off CRAFT_STATE's own prev level.
note3_craft_read() {
  local emit="${1:-}" ts dump lux prev level
  ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  if [ -z "$NOTE3_ADB_NODE" ]; then
    [ "$emit" = emit ] && echo "craft-room light UNCONFIGURED (set MESH_NOTE3_ADB_NODE / MESH_BARO_ADB_NODE in ~/.mesh/nodes — not an alarm)" >&2
    return 2
  fi
  dump="$(note3_dumpsys)"
  if [ -z "$dump" ]; then
    printf 'UNKNOWN %s reason=adb-unreachable room=%s\n' "$ts" "$CRAFT_ROOM" > "$CRAFT_STATE"
    mesh-state-touch "$CRAFT_STATE"
    [ "$emit" = emit ] && echo "[craft-room-unknown] craft-room light UNKNOWN (Note3 adb body unreachable via ${NOTE3_ADB_NODE} — not an alarm)" >&2
    return 2
  fi
  lux="$(printf '%s' "$dump" | note3_light_lux)"
  if [ -z "${lux:-}" ]; then
    printf 'UNKNOWN %s reason=no-light-line room=%s\n' "$ts" "$CRAFT_ROOM" > "$CRAFT_STATE"
    mesh-state-touch "$CRAFT_STATE"
    [ "$emit" = emit ] && echo "[craft-room-unknown] craft-room light UNKNOWN (Note3 reachable but no android.sensor.light reading — sensor absent/detached, not an alarm)" >&2
    return 2
  fi
  prev="$(read_prev_level "$CRAFT_STATE")"
  level="$(classify "$lux" "$prev")"
  printf '%s|room=%s|lux=%s\n' "$level" "$CRAFT_ROOM" "$lux" > "$CRAFT_STATE"
  mesh-state-touch "$CRAFT_STATE"
  if [ "$emit" = emit ]; then
    printf '[craft-room-%s] %s — %s-room ambient light %s lux (Note3 via %s)\n' \
      "${level,,}" "$level" "$CRAFT_ROOM" "$lux" "$NOTE3_ADB_NODE"
  fi
  return 0
}

if [ "${1:-}" = --test ]; then
  command -v python3 >/dev/null 2>&1 || { echo "smoke-test: FAIL (no python3)"; exit 1; }
  command -v mesh-phone-ip >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-phone-ip)"; exit 1; }
  mkdir -p "$HOME/.mesh" 2>/dev/null || { echo "smoke-test: FAIL (no ~/.mesh)"; exit 1; }
  # Dry-run: exercise classify() against synthetic lux values — 24 assertions covering
  # all 5 levels × hysteresis branches. FALSIFIABLE: break a threshold → assertion FAILs.
  _f=0
  # UNKNOWN (first-run, no hysteresis — snap)
  [ "$(classify 0   UNKNOWN)" = DARK    ] || { echo "  FAIL: classify 0 UNKNOWN"; _f=1; }
  [ "$(classify 2   UNKNOWN)" = DARK    ] || { echo "  FAIL: classify 2 UNKNOWN"; _f=1; }
  [ "$(classify 3   UNKNOWN)" = DIM     ] || { echo "  FAIL: classify 3 UNKNOWN"; _f=1; }
  [ "$(classify 30  UNKNOWN)" = DIM     ] || { echo "  FAIL: classify 30 UNKNOWN"; _f=1; }
  [ "$(classify 31  UNKNOWN)" = MODERATE ] || { echo "  FAIL: classify 31 UNKNOWN"; _f=1; }
  [ "$(classify 150 UNKNOWN)" = MODERATE ] || { echo "  FAIL: classify 150 UNKNOWN"; _f=1; }
  [ "$(classify 151 UNKNOWN)" = LIT      ] || { echo "  FAIL: classify 151 UNKNOWN"; _f=1; }
  [ "$(classify 600 UNKNOWN)" = LIT      ] || { echo "  FAIL: classify 600 UNKNOWN"; _f=1; }
  [ "$(classify 601 UNKNOWN)" = BRIGHT   ] || { echo "  FAIL: classify 601 UNKNOWN"; _f=1; }
  # DARK hysteresis: must rise above 5 to leave
  [ "$(classify 0   DARK)" = DARK     ] || { echo "  FAIL: classify 0 DARK → stays DARK"; _f=1; }
  [ "$(classify 5   DARK)" = DARK     ] || { echo "  FAIL: classify 5 DARK → stays DARK (not >5)"; _f=1; }
  [ "$(classify 6   DARK)" = DIM      ] || { echo "  FAIL: classify 6 DARK → DIM (rose above 5)"; _f=1; }
  # DIM hysteresis: fall below 3 → DARK; rise above 30 → MODERATE
  [ "$(classify 2   DIM)"  = DARK     ] || { echo "  FAIL: classify 2 DIM → DARK"; _f=1; }
  [ "$(classify 15  DIM)"  = DIM      ] || { echo "  FAIL: classify 15 DIM → stays DIM"; _f=1; }
  [ "$(classify 31  DIM)"  = MODERATE ] || { echo "  FAIL: classify 31 DIM → MODERATE"; _f=1; }
  # MODERATE hysteresis: fall below 15 → DIM; rise above 150 → LIT
  [ "$(classify 14  MODERATE)" = DIM      ] || { echo "  FAIL: classify 14 MODERATE → DIM"; _f=1; }
  [ "$(classify 100 MODERATE)" = MODERATE ] || { echo "  FAIL: classify 100 MODERATE → stays MODERATE"; _f=1; }
  [ "$(classify 151 MODERATE)" = LIT      ] || { echo "  FAIL: classify 151 MODERATE → LIT"; _f=1; }
  # LIT hysteresis: fall below 80 → MODERATE; rise above 600 → BRIGHT
  [ "$(classify 79  LIT)"  = MODERATE ] || { echo "  FAIL: classify 79 LIT → MODERATE"; _f=1; }
  [ "$(classify 300 LIT)"  = LIT      ] || { echo "  FAIL: classify 300 LIT → stays LIT"; _f=1; }
  [ "$(classify 601 LIT)"  = BRIGHT   ] || { echo "  FAIL: classify 601 LIT → BRIGHT"; _f=1; }
  # BRIGHT hysteresis: must fall below 400 to leave
  [ "$(classify 400 BRIGHT)" = BRIGHT   ] || { echo "  FAIL: classify 400 BRIGHT → stays BRIGHT (not <400)"; _f=1; }
  [ "$(classify 399 BRIGHT)" = LIT      ] || { echo "  FAIL: classify 399 BRIGHT → LIT (fell below 400)"; _f=1; }
  [ "$(classify 999 BRIGHT)" = BRIGHT   ] || { echo "  FAIL: classify 999 BRIGHT → stays BRIGHT"; _f=1; }
  # --- Webcam-fallback tests (phone-INDEPENDENT → run BEFORE the phone gate so they execute even when
  # the phone is offline, which is exactly when the fallback matters). FALSIFIABLE: synthetic grayscale
  # frames exercise the flat-field guard, the luma→level bands, and the TTL-staleness cut. ---
  if python3 -c 'import PIL' 2>/dev/null; then
    # Gate the direct one-shot capture OFF for the fixture assertions (testing hygiene: a --test must
    # not fire real hardware side-effects from synthetic stale/missing fixtures). The direct path gets
    # its own assertions + a live real-read gate below.
    export MESH_CAM_LIGHT_DIRECT=0
    _wd="$(mktemp -d)"
    python3 - "$_wd" <<'PY'
import sys, os, random
from PIL import Image
d=sys.argv[1]
Image.new("L",(64,64),17).save(os.path.join(d,"flat.jpg"))   # covered lens: constant field, stddev 0
random.seed(1)
def noisy(mean,spread,name):                                  # real scene variance around a mean luma
    im=Image.new("L",(64,64)); px=im.load()
    for y in range(64):
        for x in range(64):
            px[x,y]=int(max(0,min(255,mean+random.randint(-spread,spread))))
    im.save(os.path.join(d,name))
noisy(25,12,"dark.jpg"); noisy(70,20,"dim.jpg"); noisy(95,8,"twilight.jpg"); noisy(160,30,"lit.jpg")
# JPEG-noise trap fixture (jpeg-destroys-pixel-noise-variance): a real dim scene reduced to a faint
# LARGE-SCALE luma gradient (22..28) — global per-pixel stddev ~1.7 < FLAT (3), so the old sd-only
# guard would falsely call it 'covered'. But it carries genuine low-freq structure (block-mean stddev
# well above STRUCT_FLOOR), which JPEG preserves → the struct check must recover it as DARK, not blank
# the axis. Gradient (not per-pixel noise) so JPEG can't crush the discriminating signal.
gim=Image.new("L",(64,64)); gpx=gim.load()
for y in range(64):
    for x in range(64):
        gpx[x,y]=22+(x*6)//64            # 22..28 horizontal gradient: low global variance, real structure
gim.save(os.path.join(d,"structured_dim.jpg"))
PY
    # flat-field (covered lens): cannot-assess AND the reason must be DISTINCTLY "covered" (a real blocked
    # camera, not a generic failure) — never a faked DARK. FALSIFIABLE: drop the reason token → this fails.
    _wflat="$(webcam_light "$_wd/flat.jpg")"; [ $? -eq 2 ] || { echo "  FAIL: flat-field frame (covered lens) must be cannot-assess, not a faked DARK"; _f=1; }
    [ "$(printf '%s' "$_wflat" | awk '{print $2}')" = covered ] || { echo "  FAIL: covered lens must report reason 'covered' distinctly (got: $_wflat)"; _f=1; }
    # JPEG-noise trap (fidelity 2026-07-06): a faint-gradient dim scene has sd<FLAT (per-pixel noise
    # JPEG-crushed) but real low-freq structure → the struct check must RECOVER it as DARK, not blank
    # the axis as 'covered'. FALSIFIABLE: drop the `&& struct<STRUCT` clause → this reads 'covered' → fails.
    _wstruct="$(webcam_light "$_wd/structured_dim.jpg")"; _wsrc=$?
    [ "$_wsrc" -eq 0 ] || { echo "  FAIL: structured dim scene (real low-freq structure, sd<FLAT) must assess, not be a false 'covered' (got: $_wstruct)"; _f=1; }
    [ "$(printf '%s' "$_wstruct" | awk '{print $1}')" = DARK ] || { echo "  FAIL: JPEG-flattened structured dim scene should read DARK via the struct rescue (got: $_wstruct)"; _f=1; }
    [ "$(webcam_light "$_wd/dark.jpg" | awk '{print $1}')" = DARK ] || { echo "  FAIL: low-luma frame with variance should read DARK"; _f=1; }
    [ "$(webcam_light "$_wd/dim.jpg"  | awk '{print $1}')" = DIM  ] || { echo "  FAIL: lower mid-luma frame should read DIM"; _f=1; }
    [ "$(webcam_light "$_wd/twilight.jpg" | awk '{print $1}')" = TWILIGHT ] || { echo "  FAIL: upper mid-luma frame should read TWILIGHT"; _f=1; }
    [ "$(webcam_light "$_wd/lit.jpg"  | awk '{print $1}')" = LIT  ] || { echo "  FAIL: high-luma frame should read LIT"; _f=1; }
    # stale frame: cannot-assess AND the reason must be DISTINCTLY "stale" (feeder stalled, not covered).
    touch -d '-1 hour' "$_wd/lit.jpg"; _wstale="$(webcam_light "$_wd/lit.jpg")"; [ $? -eq 2 ] || { echo "  FAIL: stale (>TTL) frame must be cannot-assess, not a current reading"; _f=1; }
    [ "$(printf '%s' "$_wstale" | awk '{print $2}')" = stale ] || { echo "  FAIL: stale frame must report reason 'stale' distinctly (got: $_wstale)"; _f=1; }
    # missing frame: cannot-assess AND the reason must be DISTINCTLY "no-frame" (feeder absent, not covered).
    _wmiss="$(webcam_light "$_wd/does-not-exist.jpg")"; [ $? -eq 2 ] || { echo "  FAIL: missing frame must be cannot-assess"; _f=1; }
    [ "$(printf '%s' "$_wmiss" | awk '{print $2}')" = no-frame ] || { echo "  FAIL: missing frame must report reason 'no-frame' distinctly (got: $_wmiss)"; _f=1; }
    # --- Direct one-shot capture fallback (2026-07-05). FALSIFIABLE: each failure mode must carry its
    # DISTINCT sub-reason (a no-access ≠ no-device ≠ disabled), and the primary token stays stable. ---
    # 1. gated off → reason carries direct-disabled (proves the test gate itself is honest, not a skip)
    printf '%s' "$_wstale" | grep -q 'direct-disabled' || { echo "  FAIL: gated-off stale must name 'direct-disabled' (got: $_wstale)"; _f=1; }
    # 2. enabled + device absent → sub-reason no-device, primary token still 'stale'
    touch -d '-1 hour' "$_wd/dark.jpg"
    _wnd="$(MESH_CAM_LIGHT_DIRECT=1 MESH_CAM_LIGHT_DEV="$_wd/no-such-video-dev" webcam_light "$_wd/dark.jpg")"
