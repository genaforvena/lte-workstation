#!/usr/bin/env bash
# mesh-light — the mesh's ambient-light sense for the body phone.
# Reads the phone's tmd2755_l sensor once and classifies the room state as DARK or LIT.
# Edge-triggered: emits only on a state change when --edge is used.
#
#   mesh-light          one check; edge-trigger [room-dark]/[room-lit]
#   mesh-light --status print current lux/state, no alarm
#   mesh-light --edge   emit only on state change
#   mesh-light --test   smoke test
#
# Threshold: MESH_LIGHT_MIN (default 3 lux). Registry-resolved phone (~/.mesh/nodes / mesh-peer-addr).
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes"
THRESH="${MESH_LIGHT_MIN:-3}"
STATE="$HOME/.mesh/.light-state"

if [ "${1:-}" = --test ]; then
  command -v ssh >/dev/null 2>&1 || { echo "smoke-test: FAIL (no ssh)"; exit 1; }
  command -v python3 >/dev/null 2>&1 || { echo "smoke-test: FAIL (no python3)"; exit 1; }
  mkdir -p "$HOME/.mesh" 2>/dev/null || { echo "smoke-test: FAIL (no ~/.mesh)"; exit 1; }
  echo "smoke-test: ok"; exit 0
fi

pip="$(mesh-phone-ip 2>/dev/null)" || { echo "phone unreachable — can't read ambient light (not an alarm)"; exit 2; }

j="$(timeout 12 ssh -p "${PHONE_SSH_PORT:-8022}" -o BatchMode=yes -o ConnectTimeout=6 "${PHONE_USER:-u0_a386}@$pip" 'timeout 6 termux-sensor -s tmd2755_l -n 1' </dev/null 2>/dev/null)"
[ -n "$j" ] || { echo "phone unreachable — can't read ambient light (not an alarm)"; exit 2; }  # exit 2 = n/a (match siblings + CLAUDE.md contract; empty≠failed). Returns before edge-emit → no spurious alarm.

lux="$(printf '%s' "$j" | python3 -c 'import json,sys
try:
    d=json.load(sys.stdin)
    x=d.get("tmd2755_l", {})
    vals=x.get("values") if isinstance(x, dict) else None
    if vals:
        print(int(float(vals[0])))
    else:
        print("")
except Exception:
    print("")' 2>/dev/null)"
[ -n "${lux:-}" ] || { echo "light parse failed (not an alarm)"; exit 2; }  # no valid reading = n/a, not success

if [ "${1:-}" = --status ]; then
  if [ "$lux" -lt "$THRESH" ]; then
    echo "room light: ${lux} lux DARK"
  else
    echo "room light: ${lux} lux LIT"
  fi
  exit 0
fi

prev="$(cat "$STATE" 2>/dev/null || echo UNKNOWN)"
state="LIT"
tag="[room-lit]"
if [ "$lux" -lt "$THRESH" ]; then
  state="DARK"
  tag="[room-dark]"
fi

if [ "$state" = "DARK" ]; then
  echo DARK > "$STATE"
else
  echo LIT > "$STATE"
fi

if [ "${1:-}" = --edge ] && [ "$prev" = "$state" ]; then
  exit 0
fi

echo "$tag ${state} — ambient light ${lux} lux (threshold ${THRESH})"
