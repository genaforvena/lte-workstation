    _rdev="${MESH_CAM_LIGHT_DEV:-/dev/video0}"
    if [ -e "$_rdev" ] && [ -r "$_rdev" ] && [ -w "$_rdev" ] && command -v fswebcam >/dev/null 2>&1; then
      _wlive="$(MESH_CAM_LIGHT_DIRECT=1 webcam_light /nonexistent-feeder-frame.jpg)"; _wlrc=$?
      if [ "$_wlrc" = 0 ]; then
        printf '%s' "$_wlive" | grep -qE '^(DARK|DIM|TWILIGHT|LIT) mean=.* via=direct$' \
          || { echo "  FAIL: live direct capture rc=0 but malformed reading (got: $_wlive)"; _f=1; }
      else
        # rc=2 is still a PASS if it names a classified honest outcome: capture-fail (grab failed,
        # busy/wedged) OR covered/no-pil/unreadable (the grab WORKED — produced a real frame — but the
