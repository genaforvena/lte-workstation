#!/usr/bin/env bash
# reflex-cadence: 9-59/10 * * * *
# reflex-args: --edge
# doctor-artifact: $HOME/.mesh/.light-state 2400 phone
#   ^ smoke-theater gate (mesh-doctor): .light-state is rewritten on EVERY successful read (not only on
#     a verdict change), so phone-reachable + state >2400s stale ⟹ the sense is silently not producing
#     despite a green --test. Phone offline → gate skips (no false-fail). See mesh-doctor _theater_check.
# mesh-light — the mesh's ambient-light sense for the body phone.
# Reads the phone's tmd2755_l sensor (0-65535 lux) and classifies into 5 levels.
#
# Levels (with hysteresis bands to prevent flapping):
#   DARK     0-2 lux    pitch black, no light source
#   DIM      3-30 lux   TV glow, nightlight, very low ambient
#   MODERATE 31-150 lux typical room lighting, evening
#   LIT      151-600 lux well-lit room, office lighting
#   BRIGHT   600+ lux   direct sunlight, very bright
#
# Hysteresis: each level transition has a dead-band. Once in DARK, must rise
# above the DARK→DIM threshold (5 lux) to leave. Once in BRIGHT, must fall
# below the BRIGHT→LIT threshold (400 lux) to leave. This prevents oscillation
# when the lux reading hovers at a boundary.
#
#   mesh-light          one check; edge-trigger on level change
#   mesh-light --status print current lux/level, no alarm
#   mesh-light --edge   emit only on state change
#   mesh-light --json   machine-readable {level, lux, ts, prev, stable_s, delta, velocity, change_class, direction}
#   mesh-light --webcam node-webcam COARSE level (phone-independent fallback; exit 2 if no usable frame)
#   mesh-light --test   smoke test (exit 2 = n/a, phone unreachable)
#
# Webcam fallback (coverage when the phone — the lux sensor — is offline): the lux sensor is on the body
# phone, so the precise axis dies (exit 2) whenever the phone drops. This node has its OWN webcam
# (mesh-cam-watch keeps ~/.mesh/cam-prev.jpg fresh), so the text/--edge paths fall back to a COARSE
# ambient level read from the live frame's mean luma — honest-degraded, never a faked lux. Guards below.
#
# Enrichment: transition tracking + rate-of-change
#   State file .light-state: current level (existing)
#   State file .light-transitions: prev_level|prev_lux|prev_ts|change_count
#   State file .light-velocity: last3_lux|last3_ts|smoothed_lux
#   Output includes: prev (previous level), stable_s (seconds since last change),
#   delta (lux change since last reading — positive=brighter, negative=darker).
#   NEW: velocity (lux/second rate of change), smoothed (3-sample moving avg),
#   change_class (GRADUAL|SUDDEN|STABLE — velocity-based classification).
#   Velocity lets consumers distinguish sunset drift from a light switch.
#
# Exit codes (honest-exit contract):
#   0 = level assessed (precise phone lux, OR a coarse webcam-derived level when the phone is offline)
#   2 = cannot read: phone unreachable AND no usable webcam frame — never faked. --webcam names the
#       SPECIFIC reason (no-frame|stale|covered|no-pil|unreadable) so a blocked lens reads distinctly
#       from a dead feeder from a missing dep (each needs a different fix).
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes"

STATE="$HOME/.mesh/.light-state"
OFFLINEFILE="$HOME/.mesh/.light-offline"
# light_dwell enrichment (2026-06-28): the existing 1-field state only captures the CURRENT
# classification, not how long the light level has been held. The new additive fields 2+3 are
# `<dwell_s>|<changes_24h>` — seconds-since-last-level-change and count of level changes in
# the last 24h. Captures "lights have been DIM for 2h" vs "just transitioned to DIM" — distinct
# from the per-classify verdict (which is just "what is it now?"). A user grepping `dwell_s=`
# gets the dwell band without breaking the 1-field reader.
LIGHT_LOG="$HOME/.mesh/.light-events"  # one line per level change: epoch|level
# classify_dwell <seconds> → echoes "BAND|seconds". Pure, offline-testable.
# Bands (FALSIFIABLE: change the 5/60/1800 thresholds → tests flip):
#   TRANSITION  0–5s   — just changed
#   RECENT     5–60s  — recently changed
#   STABLE     1–30m  — level held for a while
#   CHRONIC    30m+   — long-stable light level
#   NEVER      no reading on record
classify_dwell() {
  local s="${1:-}"
  if [ -z "$s" ] || ! [ "$s" -ge 0 ] 2>/dev/null; then echo "NEVER|no reading on record"; return; fi
  if   [ "$s" -lt 5 ];    then echo "TRANSITION|${s}s (just changed)"; return; fi
  if   [ "$s" -lt 60 ];   then echo "RECENT|${s}s (under 1m)"; return; fi
  if   [ "$s" -lt 1800 ]; then echo "STABLE|$((s/60))m (under 30m)"; return; fi
  echo "CHRONIC|$((s/60))m (long-stable)"
}

classify() {
  local l=$1 p=$2
  case "$p" in
    DARK)     [ "$l" -gt 5   ] && { echo DIM;     return; }; echo DARK;;
    DIM)      [ "$l" -lt 3   ] && { echo DARK;    return; }
              [ "$l" -gt 30  ] && { echo MODERATE; return; }; echo DIM;;
    MODERATE) [ "$l" -lt 15  ] && { echo DIM;     return; }
              [ "$l" -gt 150 ] && { echo LIT;     return; }; echo MODERATE;;
    LIT)      [ "$l" -lt 80  ] && { echo MODERATE;return; }
              [ "$l" -gt 600 ] && { echo BRIGHT;  return; }; echo LIT;;
    BRIGHT)   [ "$l" -lt 400 ] && { echo LIT;     return; }; echo BRIGHT;;
    *)        if   [ "$l" -le 2   ]; then echo DARK
              elif [ "$l" -le 30  ]; then echo DIM
              elif [ "$l" -le 150 ]; then echo MODERATE
              elif [ "$l" -le 600 ]; then echo LIT
              else echo BRIGHT; fi;;
  esac
}

classify_velocity_dir() {
  python3 - "$1" <<'PY'
import sys
try:
    v=float(sys.argv[1])
except Exception:
    print("FLAT")
    raise SystemExit(0)
if v > 0.1:
    print("BRIGHTENING")
elif v < -0.1:
    print("DARKENING")
else:
    print("FLAT")
PY
}

# --- Webcam fallback (node-local light coverage when the phone — the lux sensor — is offline) ---
# HONESTY GUARDS (why this can NOT manufacture a false reading):
#   * Freshness: a frame older than CAM_LIGHT_TTL is not a current reading → cannot-assess (rc 2).
#   * Flat-field: a covered lens / blank frame is a near-constant field (stddev≈0) carrying NO ambient
#     light info — it must NOT read as DARK. stddev < FLAT_STDDEV → cannot-assess (rc 2), not a faked DARK.
#     (Observed live 2026-06-25: the IdeaPad lens was capped → mean 17, stddev 0.4 → correctly UNKNOWN.)
#   * Coarse-only: webcam AGC makes absolute luma an unreliable lux proxy, so we emit only DARK/DIM/LIT
#     (3 defensible bands), never the precise 5-level lux scale, and never a numeric lux.
CAM_FRAME="${MESH_CAM_FRAME:-$HOME/.mesh/cam-prev.jpg}"
CAM_LIGHT_TTL="${MESH_CAM_LIGHT_TTL:-180}"   # frame older than this (s) → not a current reading
FLAT_STDDEV="${MESH_CAM_LIGHT_FLAT:-3}"      # luma stddev below this → flat field (covered/blank) → cannot assess
DARK_MAX="${MESH_CAM_LIGHT_DARK_MAX:-40}"    # mean luma < this (with real variance) → DARK
LIT_MIN="${MESH_CAM_LIGHT_LIT_MIN:-110}"     # mean luma >= this → LIT; between → DIM

# webcam_light <frame> → prints "LEVEL mean=.. stddev=.." + returns 0 on a usable coarse reading;
# returns 2 (cannot assess) — NEVER a fabricated level. On a cannot-assess it now prints a DISTINCT
# REASON line "n/a <reason> (...)" so the caller can surface WHICH failure mode this is instead of an
# opaque lump (fidelity 2026-06-27): the five cannot-assess conditions are physically DIFFERENT states —
#   no-frame   the cam feeder never produced a frame (mesh-cam-watch absent/never ran)
#   stale      a frame exists but is older than the TTL (feeder stalled) — not a CURRENT reading
#   covered    the lens is physically BLOCKED/blank (flat field, stddev<FLAT) — the camera WORKS, it is
#              obstructed; a real, detectable tamper/privacy state, NOT "the sense is broken"
#   no-pil     python PIL/Pillow missing (dependency gap, not a hardware state)
#   unreadable a frame is present but not a decodable image (corrupt/truncated capture)
# All still exit 2 (covered is never emitted as a faked DARK), but a consumer/operator reading the reason
# can tell "someone covered the camera" from "the feeder died" from "a dep is missing" — each needs a
# different fix. The SUCCESS line ("LEVEL mean=.. stddev=..") is byte-identical (the --webcam parse +
# every existing grep are invariant); only the previously-opaque failure path gains the reason token.
webcam_light() {
  local f="$1" now mt age
  [ -f "$f" ] || { echo "n/a no-frame (no webcam frame at $f — cam feeder absent/never ran)"; return 2; }
  now="$(date +%s)"; mt="$(stat -c %Y "$f" 2>/dev/null || echo 0)"; age=$(( now - mt ))
  { [ "$age" -ge 0 ] && [ "$age" -le "$CAM_LIGHT_TTL" ]; } \
    || { echo "n/a stale (frame ${age}s old > ${CAM_LIGHT_TTL}s TTL — cam feeder stalled, not a current reading)"; return 2; }
  MCL_FLAT="$FLAT_STDDEV" MCL_DARK="$DARK_MAX" MCL_LIT="$LIT_MIN" python3 - "$f" <<'PY'
import sys, os
try:
    from PIL import Image, ImageStat
except Exception:
    print("n/a no-pil (python PIL/Pillow not installed — cannot read frame luma)"); sys.exit(2)
FLAT=float(os.environ["MCL_FLAT"]); DARK=float(os.environ["MCL_DARK"]); LIT=float(os.environ["MCL_LIT"])
try:
    im=Image.open(sys.argv[1]).convert("L"); st=ImageStat.Stat(im)
    mean=st.mean[0]; sd=st.stddev[0]
except Exception:
    print("n/a unreadable (frame present but not a decodable image — corrupt/truncated capture)"); sys.exit(2)
if sd < FLAT:
    # lens physically blocked/blank → a flat field carries NO ambient-light info → covered, NOT a faked DARK
    print("n/a covered (lens blocked/blank — flat field mean=%.1f stddev=%.1f < %.1f, no ambient-light info)" % (mean, sd, FLAT)); sys.exit(2)
lvl = "DARK" if mean < DARK else ("LIT" if mean >= LIT else "DIM")
print("%s mean=%.1f stddev=%.1f" % (lvl, mean, sd)); sys.exit(0)
PY
}

if [ "${1:-}" = --test ]; then
  command -v python3 >/dev/null 2>&1 || { echo "smoke-test: FAIL (no python3)"; exit 1; }
  command -v mesh-phone-ip >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-phone-ip)"; exit 1; }
  mkdir -p "$HOME/.mesh" 2>/dev/null || { echo "smoke-test: FAIL (no ~/.mesh)"; exit 1; }
  # Dry-run: exercise classify() against synthetic lux values — 24 assertions covering
  # all 5 levels × hysteresis branches. FALSIFIABLE: break a threshold → assertion FAILs.
  _f=0
  # UNKNOWN (first-run, no hysteresis — snap)
  [ "$(classify 0   UNKNOWN)" = DARK    ] || { echo "  FAIL: classify 0 UNKNOWN"; _f=1; }
  [ "$(classify 2   UNKNOWN)" = DARK    ] || { echo "  FAIL: classify 2 UNKNOWN"; _f=1; }
  [ "$(classify 3   UNKNOWN)" = DIM     ] || { echo "  FAIL: classify 3 UNKNOWN"; _f=1; }
  [ "$(classify 30  UNKNOWN)" = DIM     ] || { echo "  FAIL: classify 30 UNKNOWN"; _f=1; }
  [ "$(classify 31  UNKNOWN)" = MODERATE ] || { echo "  FAIL: classify 31 UNKNOWN"; _f=1; }
  [ "$(classify 150 UNKNOWN)" = MODERATE ] || { echo "  FAIL: classify 150 UNKNOWN"; _f=1; }
  [ "$(classify 151 UNKNOWN)" = LIT      ] || { echo "  FAIL: classify 151 UNKNOWN"; _f=1; }
  [ "$(classify 600 UNKNOWN)" = LIT      ] || { echo "  FAIL: classify 600 UNKNOWN"; _f=1; }
  [ "$(classify 601 UNKNOWN)" = BRIGHT   ] || { echo "  FAIL: classify 601 UNKNOWN"; _f=1; }
  # DARK hysteresis: must rise above 5 to leave
  [ "$(classify 0   DARK)" = DARK     ] || { echo "  FAIL: classify 0 DARK → stays DARK"; _f=1; }
  [ "$(classify 5   DARK)" = DARK     ] || { echo "  FAIL: classify 5 DARK → stays DARK (not >5)"; _f=1; }
  [ "$(classify 6   DARK)" = DIM      ] || { echo "  FAIL: classify 6 DARK → DIM (rose above 5)"; _f=1; }
  # DIM hysteresis: fall below 3 → DARK; rise above 30 → MODERATE
  [ "$(classify 2   DIM)"  = DARK     ] || { echo "  FAIL: classify 2 DIM → DARK"; _f=1; }
  [ "$(classify 15  DIM)"  = DIM      ] || { echo "  FAIL: classify 15 DIM → stays DIM"; _f=1; }
  [ "$(classify 31  DIM)"  = MODERATE ] || { echo "  FAIL: classify 31 DIM → MODERATE"; _f=1; }
  # MODERATE hysteresis: fall below 15 → DIM; rise above 150 → LIT
  [ "$(classify 14  MODERATE)" = DIM      ] || { echo "  FAIL: classify 14 MODERATE → DIM"; _f=1; }
  [ "$(classify 100 MODERATE)" = MODERATE ] || { echo "  FAIL: classify 100 MODERATE → stays MODERATE"; _f=1; }
  [ "$(classify 151 MODERATE)" = LIT      ] || { echo "  FAIL: classify 151 MODERATE → LIT"; _f=1; }
  # LIT hysteresis: fall below 80 → MODERATE; rise above 600 → BRIGHT
  [ "$(classify 79  LIT)"  = MODERATE ] || { echo "  FAIL: classify 79 LIT → MODERATE"; _f=1; }
  [ "$(classify 300 LIT)"  = LIT      ] || { echo "  FAIL: classify 300 LIT → stays LIT"; _f=1; }
  [ "$(classify 601 LIT)"  = BRIGHT   ] || { echo "  FAIL: classify 601 LIT → BRIGHT"; _f=1; }
  # BRIGHT hysteresis: must fall below 400 to leave
  [ "$(classify 400 BRIGHT)" = BRIGHT   ] || { echo "  FAIL: classify 400 BRIGHT → stays BRIGHT (not <400)"; _f=1; }
  [ "$(classify 399 BRIGHT)" = LIT      ] || { echo "  FAIL: classify 399 BRIGHT → LIT (fell below 400)"; _f=1; }
  [ "$(classify 999 BRIGHT)" = BRIGHT   ] || { echo "  FAIL: classify 999 BRIGHT → stays BRIGHT"; _f=1; }
  # --- Webcam-fallback tests (phone-INDEPENDENT → run BEFORE the phone gate so they execute even when
  # the phone is offline, which is exactly when the fallback matters). FALSIFIABLE: synthetic grayscale
  # frames exercise the flat-field guard, the luma→level bands, and the TTL-staleness cut. ---
  if python3 -c 'import PIL' 2>/dev/null; then
    _wd="$(mktemp -d)"
    python3 - "$_wd" <<'PY'
import sys, os, random
from PIL import Image
d=sys.argv[1]
Image.new("L",(64,64),17).save(os.path.join(d,"flat.jpg"))   # covered lens: constant field, stddev 0
random.seed(1)
def noisy(mean,spread,name):                                  # real scene variance around a mean luma
    im=Image.new("L",(64,64)); px=im.load()
    for y in range(64):
        for x in range(64):
            px[x,y]=int(max(0,min(255,mean+random.randint(-spread,spread))))
    im.save(os.path.join(d,name))
noisy(25,12,"dark.jpg"); noisy(70,20,"dim.jpg"); noisy(160,30,"lit.jpg")
PY
    # flat-field (covered lens): cannot-assess AND the reason must be DISTINCTLY "covered" (a real blocked
    # camera, not a generic failure) — never a faked DARK. FALSIFIABLE: drop the reason token → this fails.
    _wflat="$(webcam_light "$_wd/flat.jpg")"; [ $? -eq 2 ] || { echo "  FAIL: flat-field frame (covered lens) must be cannot-assess, not a faked DARK"; _f=1; }
    [ "$(printf '%s' "$_wflat" | awk '{print $2}')" = covered ] || { echo "  FAIL: covered lens must report reason 'covered' distinctly (got: $_wflat)"; _f=1; }
    [ "$(webcam_light "$_wd/dark.jpg" | awk '{print $1}')" = DARK ] || { echo "  FAIL: low-luma frame with variance should read DARK"; _f=1; }
    [ "$(webcam_light "$_wd/dim.jpg"  | awk '{print $1}')" = DIM  ] || { echo "  FAIL: mid-luma frame should read DIM"; _f=1; }
    [ "$(webcam_light "$_wd/lit.jpg"  | awk '{print $1}')" = LIT  ] || { echo "  FAIL: high-luma frame should read LIT"; _f=1; }
    # stale frame: cannot-assess AND the reason must be DISTINCTLY "stale" (feeder stalled, not covered).
    touch -d '-1 hour' "$_wd/lit.jpg"; _wstale="$(webcam_light "$_wd/lit.jpg")"; [ $? -eq 2 ] || { echo "  FAIL: stale (>TTL) frame must be cannot-assess, not a current reading"; _f=1; }
    [ "$(printf '%s' "$_wstale" | awk '{print $2}')" = stale ] || { echo "  FAIL: stale frame must report reason 'stale' distinctly (got: $_wstale)"; _f=1; }
    # missing frame: cannot-assess AND the reason must be DISTINCTLY "no-frame" (feeder absent, not covered).
    _wmiss="$(webcam_light "$_wd/does-not-exist.jpg")"; [ $? -eq 2 ] || { echo "  FAIL: missing frame must be cannot-assess"; _f=1; }
    [ "$(printf '%s' "$_wmiss" | awk '{print $2}')" = no-frame ] || { echo "  FAIL: missing frame must report reason 'no-frame' distinctly (got: $_wmiss)"; _f=1; }
    rm -rf "$_wd"
  fi
  # Real SSH reachability probe — NOT mesh-phone-ip (returns cached IP exit 0 when
  # offline → false-green). phone_reachable_ip (mesh-patterns.sh) does a real ConnectTimeout=3 SSH.
  source "$HOME/.local/bin/mesh-patterns.sh" 2>/dev/null || true
  phone_reachable_ip >/dev/null 2>&1 || { echo "smoke-test: n/a (phone unreachable — light sense unavailable)"; [ "$_f" = 0 ] && exit 2; exit 1; }
  [ "$_f" = 0 ] || { echo "smoke-test: FAIL (classify() hysteresis drifted — thresholds wrong)"; exit 1; }
  # Transition tracking test: simulate state file, verify delta/stable_s computation
  mkdir -p "$HOME/.mesh" 2>/dev/null || true
  _ts="$HOME/.mesh/.light-transitions.test"
  printf 'LIT|400|1000|3\n' > "$_ts"
  IFS='|' read -r _pl _plux _pts _pc < "$_ts"
  [ "$_pl" = "LIT" ] || { echo "  FAIL: transition prev_level should be LIT (got $_pl)"; _f=1; }
  [ "$_plux" = "400" ] || { echo "  FAIL: transition prev_lux should be 400 (got $_plux)"; _f=1; }
  [ "$_pc" = "3" ] || { echo "  FAIL: transition change_count should be 3 (got $_pc)"; _f=1; }
  rm -f "$_ts"
  # Velocity test: simulate velocity state file, verify smoothing + velocity classification
  _tv="$HOME/.mesh/.light-velocity.test"
  _tnow=$(date +%s)
  # Simulate 3 readings: 100, 200, 300 over 10 seconds each → velocity should be high (SUDDEN)
  printf '200|%d|100|%d|300|%d\n' "$((_tnow-10))" "$((_tnow-20))" "$_tnow" > "$_tv"
  _smooth=$(( (300 + 200 + 100) / 3 ))  # = 200
  [ "$_smooth" = "200" ] || { echo "  FAIL: smoothed lux should be 200 (got $_smooth)"; _f=1; }
  # Velocity direction helper: positive / negative / near-zero are distinguished explicitly.
  [ "$(classify_velocity_dir 10)" = BRIGHTENING ] || { echo "  FAIL: positive velocity should be BRIGHTENING"; _f=1; }
  [ "$(classify_velocity_dir -10)" = DARKENING ] || { echo "  FAIL: negative velocity should be DARKENING"; _f=1; }
  [ "$(classify_velocity_dir 0.01)" = FLAT ] || { echo "  FAIL: near-zero velocity should be FLAT"; _f=1; }
  rm -f "$_tv"
  [ "$_f" = 0 ] || { echo "smoke-test: FAIL (velocity tracking: assertions failed)"; exit 1; }
  # --- light_dwell enrichment tests (FALSIFIABLE: change the 5/60/1800 thresholds → these flip) ---
  _df=0
  # TRANSITION: 0s
  r="$(classify_dwell 0)"
  echo "$r" | grep -q '^TRANSITION' || { echo "  FAIL dwell TRANSITION 0s: got=$r"; _df=1; }
  # TRANSITION: 4s
  r="$(classify_dwell 4)"
  echo "$r" | grep -q '^TRANSITION' || { echo "  FAIL dwell TRANSITION 4s: got=$r"; _df=1; }
  # RECENT: 5s (boundary)
  r="$(classify_dwell 5)"
  echo "$r" | grep -q '^RECENT' || { echo "  FAIL dwell RECENT 5s: got=$r"; _df=1; }
  # RECENT: 59s
  r="$(classify_dwell 59)"
  echo "$r" | grep -q '^RECENT' || { echo "  FAIL dwell RECENT 59s: got=$r"; _df=1; }
  # STABLE: 60s (boundary)
  r="$(classify_dwell 60)"
  echo "$r" | grep -q '^STABLE' || { echo "  FAIL dwell STABLE 60s: got=$r"; _df=1; }
  # STABLE: 29 min
  r="$(classify_dwell 1740)"
  echo "$r" | grep -q '^STABLE' || { echo "  FAIL dwell STABLE 1740s: got=$r"; _df=1; }
  # CHRONIC: 30 min (boundary)
  r="$(classify_dwell 1800)"
  echo "$r" | grep -q '^CHRONIC' || { echo "  FAIL dwell CHRONIC 1800s: got=$r"; _df=1; }
  # CHRONIC: 24h
  r="$(classify_dwell 86400)"
  echo "$r" | grep -q '^CHRONIC' || { echo "  FAIL dwell CHRONIC 86400s: got=$r"; _df=1; }
  # NEVER: empty
  r="$(classify_dwell '')"
  [ "$r" = "NEVER|no reading on record" ] || { echo "  FAIL dwell NEVER: got=$r"; _df=1; }
  [ "$_df" = 0 ] || { echo "smoke-test: FAIL (light_dwell assertions)"; exit 1; }
  echo "smoke-test: ok (classify: 24 + transition: 3 + velocity: 5 + webcam-fallback: 9 + light_dwell: 9 assertions)"; exit 0
fi

MODE=text
[ "${1:-}" = --json ] && MODE=json
EDGE=0
if [ "${1:-}" = --edge ]; then EDGE=1; MODE=edge; fi

# --webcam: explicit node-webcam COARSE light reading (phone-independent). Honest exit 2 when the frame
# is missing/stale/flat/unreadable — never a faked level. Probes the fallback path directly.
if [ "${1:-}" = --webcam ]; then
  if wout="$(webcam_light "$CAM_FRAME")"; then
    lvl="${wout%% *}"; echo "[room-${lvl,,}] $lvl (webcam-derived, coarse; ${wout#* })"; exit 0
  fi
  # webcam_light now names the SPECIFIC cannot-assess reason (no-frame|stale|covered|no-pil|unreadable);
  # surface it verbatim instead of the old opaque lump so the operator knows which fix this needs.
  echo "webcam light ${wout:-n/a unknown (no reason from probe)} — NOT faked" >&2; exit 2
fi

# _webcam_fallback: called at each phone-unreachable point. Emits a COARSE webcam level (refreshing the
# light axis so it isn't dead while the phone is offline) and exits 0; RETURNS only if the webcam can't
# help either, so the caller proceeds to the honest exit 2. json mode stays precise-only (no coarse path).
_webcam_fallback() {
  case "$MODE" in json) return 0;; esac
  local wout lvl prevw
  wout="$(webcam_light "$CAM_FRAME")" || return 0
  lvl="${wout%% *}"
  prevw="$(cat "$STATE" 2>/dev/null || echo UNKNOWN)"
  printf '%s\n' "$lvl" > "$STATE"
  [ "$MODE" = edge ] && [ "$lvl" = "$prevw" ] && exit 0
  echo "[room-${lvl,,}] $lvl (webcam-derived, coarse — phone offline; ${wout#* })"
  exit 0
}

TS=$(date -u +%Y-%m-%dT%H:%M:%SZ)

pip="$(mesh-phone-ip 2>/dev/null)" || {
    _webcam_fallback   # phone down → try the node webcam; exits 0 if it yields a coarse reading
    if [ ! -f "$OFFLINEFILE" ]; then echo "phone unreachable — can't read ambient light (not an alarm)"; touch "$OFFLINEFILE"; fi
    printf 'OFFLINE %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$STATE"
    mesh-state-touch "$STATE"
    exit 2
}
rm -f "$OFFLINEFILE"

# -d 500 -n 2: tmd2755_l needs at least one poll cycle before the first value arrives;
# -n 1 races the driver and the process exits with only cleanup messages, no JSON.
# No inner timeout wrapper: wrapping in `timeout` sends SIGTERM to termux-sensor, which
# prints its cleanup messages to STDOUT, not stderr — polluting the JSON stream. The outer
# SSH timeout (14s) is sufficient; termux-sensor with -n 2 self-terminates cleanly after 2 samples.
# 2>/dev/null in the remote command: suppresses SIGTERM cleanup noise from termux-sensor stderr.
j="$(timeout 14 ssh -p "${PHONE_SSH_PORT:-8022}" -o BatchMode=yes -o ConnectTimeout=6 "${PHONE_USER:-u0_a380}@$pip" 'termux-sensor -s tmd2755_l -d 500 -n 2 2>/dev/null' </dev/null 2>/dev/null)"
[ -n "$j" ] || { _webcam_fallback; if [ ! -f "$OFFLINEFILE" ]; then echo "phone unreachable — can't read ambient light (not an alarm)"; touch "$OFFLINEFILE"; fi; printf 'OFFLINE %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$STATE"; mesh-state-touch "$STATE"; exit 2; }

# raw_decode: parse only the FIRST JSON object — with -n 2 we get two objects back-to-back;
# json.load() would fail on the second. raw_decode() stops after the first complete object.
lux="$(printf '%s' "$j" | python3 -c 'import json,sys
try:
    data=sys.stdin.read().strip()
    d,_=json.JSONDecoder().raw_decode(data)
    x=d.get("tmd2755_l", {})
    vals=x.get("values") if isinstance(x, dict) else None
    if vals:
        print(int(float(vals[0])))
    else:
        print("")
except Exception:
    print("")' 2>/dev/null)"
[ -n "${lux:-}" ] || { _webcam_fallback; echo "light parse failed (not an alarm)"; exit 2; }

prev="$(cat "$STATE" 2>/dev/null || echo UNKNOWN)"

# classify() is defined at the top of the script for --test access (identical).
# This is the same function, re-declared so the main flow doesn't depend on
# the top-level definition surviving bash's sequential parse:
classify() {  # duplicated intentionally — first copy is for --test (exits before here)
  local l=$1 p=$2
  case "$p" in
    DARK)     [ "$l" -gt 5   ] && { echo DIM;     return; }; echo DARK;;
    DIM)      [ "$l" -lt 3   ] && { echo DARK;    return; }
              [ "$l" -gt 30  ] && { echo MODERATE; return; }; echo DIM;;
    MODERATE) [ "$l" -lt 15  ] && { echo DIM;     return; }
              [ "$l" -gt 150 ] && { echo LIT;     return; }; echo MODERATE;;
    LIT)      [ "$l" -lt 80  ] && { echo MODERATE;return; }
              [ "$l" -gt 600 ] && { echo BRIGHT;  return; }; echo LIT;;
    BRIGHT)   [ "$l" -lt 400 ] && { echo LIT;     return; }; echo BRIGHT;;
    *)        if   [ "$l" -le 2   ]; then echo DARK
              elif [ "$l" -le 30  ]; then echo DIM
              elif [ "$l" -le 150 ]; then echo MODERATE
              elif [ "$l" -le 600 ]; then echo LIT
              else echo BRIGHT; fi;;
  esac
}

level="$(classify "$lux" "$prev")"
tag="[room-${level,,}]"

# Write state (always, for edge tracking) — additive 5th/6th fields: dwell_s + changes_24h
NOW_EPOCH=$(date +%s)
prev_level_ts=""
[ -f "$LIGHT_LOG" ] && prev_level_ts="$(tail -n 1 "$LIGHT_LOG" 2>/dev/null | cut -d'|' -f1)"
dwell_s=0
if [ -n "$prev_level_ts" ] && [ "$prev_level_ts" -gt 0 ] 2>/dev/null; then
  dwell_s=$(( NOW_EPOCH - prev_level_ts ))
fi
# Log this reading (idempotent on same-level consecutive runs — only logs a TRUE transition)
prev_logged_level=""
[ -f "$LIGHT_LOG" ] && prev_logged_level="$(tail -n 1 "$LIGHT_LOG" 2>/dev/null | cut -d'|' -f2)"
if [ "$level" != "$prev_logged_level" ]; then
  printf '%s|%s\n' "$NOW_EPOCH" "$level" >> "$LIGHT_LOG"
fi
# Count changes in last 24h (pruning on the fly)
LIGHT_LOG="$HOME/.mesh/.light-events"
_light_cutoff=$(( NOW_EPOCH - 86400 ))
changes_24h=0
if [ -f "$LIGHT_LOG" ]; then
  _tmp_lc="$LIGHT_LOG.tmp.$$"
  : > "$_tmp_lc"
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    _ts="$(printf '%s' "$line" | cut -d'|' -f1)"
    [ "$_ts" -ge "$_light_cutoff" ] 2>/dev/null && printf '%s\n' "$line" >> "$_tmp_lc"
  done < "$LIGHT_LOG"
  mv -f "$_tmp_lc" "$LIGHT_LOG" 2>/dev/null || rm -f "$_tmp_lc"
  changes_24h="$(wc -l < "$LIGHT_LOG" 2>/dev/null | tr -d ' ')"
fi
printf '%s|dwell_s=%s|changes_24h=%s\n' "$level" "$dwell_s" "$changes_24h" > "$STATE"
mesh-state-touch "$STATE"

# --- Transition tracking ---
TRANS_STATE="$HOME/.mesh/.light-transitions"
NOW_EPOCH=$(date +%s)
prev_level="$prev"
prev_lux=""
prev_ts=""
change_count=0
stable_s=0
lux_delta=0

if [ -f "$TRANS_STATE" ]; then
  IFS='|' read -r prev_level prev_lux prev_ts change_count < "$TRANS_STATE"
  # Compute seconds since last change
  if [ -n "$prev_ts" ] && [ "$prev_ts" -eq "$prev_ts" ] 2>/dev/null; then
    stable_s=$(( NOW_EPOCH - prev_ts ))
  fi
  # Compute lux delta
  if [ -n "$prev_lux" ] && [ "$prev_lux" -eq "$prev_lux" ] 2>/dev/null; then
    lux_delta=$(( lux - prev_lux ))
  fi
fi

# If level changed, update transition state
if [ "$level" != "$prev_level" ]; then
  change_count=$(( ${change_count:-0} + 1 ))
  printf '%s|%s|%s|%s\n' "$level" "$lux" "$NOW_EPOCH" "$change_count" > "$TRANS_STATE"
  stable_s=0
fi

# --- Rate-of-change (lux velocity) + smoothed lux ---
# Tracks last 3 readings for a moving average (smoothed lux) and computes velocity
# (lux/second) to classify change type: GRADUAL (<5 lux/s), SUDDEN (>=5 lux/s), STABLE (0).
# State file .light-velocity: lux1|ts1|lux2|ts2|lux3|ts3
VEL_STATE="$HOME/.mesh/.light-velocity"
velocity=0.0
smoothed_lux="$lux"
change_class="STABLE"
velocity_dir="FLAT"

if [ -f "$VEL_STATE" ]; then
  IFS='|' read -r v_l1 v_t1 v_l2 v_t2 v_l3 v_t3 < "$VEL_STATE" 2>/dev/null || true
  # Build array of valid previous readings (backwards in time)
  _vl=(); _vt=()
  [ -n "$v_l3" ] && [ "$v_l3" -eq "$v_l3" ] 2>/dev/null && _vl+=("$v_l3") && _vt+=("$v_t3")
  [ -n "$v_l2" ] && [ "$v_l2" -eq "$v_l2" ] 2>/dev/null && _vl+=("$v_l2") && _vt+=("$v_t2")
  [ -n "$v_l1" ] && [ "$v_l1" -eq "$v_l1" ] 2>/dev/null && _vl+=("$v_l1") && _vt+=("$v_t1")
  # Smoothed lux: average of all valid readings (including current)
  _sum=$lux; _cnt=1
  for v in "${_vl[@]}"; do _sum=$((_sum + v)); _cnt=$((_cnt + 1)); done
  smoothed_lux=$((_sum / _cnt))
  # Velocity: lux/sec from oldest valid reading to current
  if [ ${#_vl[@]} -gt 0 ] && [ -n "${_vt[0]}" ] && [ "$_vt[0]" -eq "$_vt[0]" ] 2>/dev/null; then
    _dt=$(( NOW_EPOCH - _vt[0] ))
    if [ "$_dt" -gt 0 ]; then
      _dl=$(( lux - _vl[0] ))
      # Use python for fractional division
      velocity="$(python3 -c "print(round(${_dl}/${_dt}, 2))" 2>/dev/null || echo "0")"
      # Classify change
      _abs_vel="${velocity#-}"
      velocity_dir="$(classify_velocity_dir "$velocity")"
      if [ "$_abs_vel" = "0" ] || [ "$_abs_vel" = "0.0" ]; then
        change_class="STABLE"
      elif python3 -c "exit(0 if abs(${velocity}) < 5 else 1)" 2>/dev/null; then
        change_class="GRADUAL"
      else
        change_class="SUDDEN"
      fi
    fi
  fi
  # Shift window: drop oldest, append current
  printf '%s|%s|%s|%s|%s|%s\n' "${_vl[${#_vl[@]}-1]:-}" "${_vt[${#_vt[@]}-1]:-}" \
    "${_vl[${#_vl[@]}-2]:-}" "${_vt[${#_vt[@]}-2]:-}" "$lux" "$NOW_EPOCH" > "$VEL_STATE"
else
  # First reading — seed the velocity window
  printf '|||%s|%s|%s\n' "" "" "$lux" "$NOW_EPOCH" > "$VEL_STATE"
fi

case "$MODE" in
  json)
    printf '{"level":"%s","lux":%s,"ts":"%s","prev":"%s","stable_s":%s,"delta":%s,"changes":%s,"velocity":%s,"smoothed":%s,"change_class":"%s","direction":"%s"}\n' \
      "$level" "$lux" "$TS" "${prev_level:-UNKNOWN}" "${stable_s:-0}" "${lux_delta:-0}" "${change_count:-0}" \
      "${velocity:-0}" "${smoothed_lux:-$lux}" "${change_class:-STABLE}" "${velocity_dir:-FLAT}"
    ;;
  edge)
    # Only emit when level changes vs previous
    [ "$level" = "$prev" ] && exit 0
    printf '%s %s — ambient light %s lux (delta=%s, stable=%ss, changes=%s, velocity=%s lux/s [%s %s])\n' \
      "$tag" "$level" "$lux" "${lux_delta:-0}" "${stable_s:-0}" "${change_count:-0}" \
      "${velocity:-0}" "${change_class:-STABLE}" "${velocity_dir:-FLAT}"
    ;;
  *)
    printf '%s %s — ambient light %s lux (prev=%s, delta=%s, stable=%ss, velocity=%s lux/s [%s %s])\n' \
      "$tag" "$level" "$lux" "${prev_level:-UNKNOWN}" "${lux_delta:-0}" "${stable_s:-0}" \
      "${velocity:-0}" "${change_class:-STABLE}" "${velocity_dir:-FLAT}"
    ;;
esac
