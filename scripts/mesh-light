  _rpf2="$(mktemp)"; printf 'BRIGHT|dwell_s=120|changes_24h=1\n' > "$_rpf2"
  [ "$(classify 450 "$(read_prev_level "$_rpf2")")" = BRIGHT ] || { echo "  FAIL: contaminated STATE must still hysteresis-hold BRIGHT at 450 lux (got $(classify 450 "$(read_prev_level "$_rpf2")"))"; _rp=1; }
  rm -f "$_rpf2"
  [ "$_rp" = 0 ] || { echo "smoke-test: FAIL (read_prev_level regression assertions)"; exit 1; }
  # --- OFFLINE-reason regression (phone-INDEPENDENT): when the webcam fallback fails with a
  # classified reason, the caller's OFFLINE state write must carry it as a 3rd field
  # ("OFFLINE <ts> webcam=<reason>") — the bare 2-field OFFLINE lumped "shutter covered" with
  # "dead feeder" for 19h on 2026-07-05. Subshell: _webcam_fallback exits 0 on webcam SUCCESS,
  # which must not kill the test runner; the /nonexistent frame + direct-disabled fixture makes
  # failure (no-frame) deterministic. FALSIFIABLE: drop the WEBCAM_NA capture → this fails. ---
  _wna_out="$(
    CAM_FRAME=/nonexistent-feeder-frame-$$.jpg
    MESH_CAM_LIGHT_DIRECT=0
    WEBCAM_NA=""
    _webcam_fallback
    printf 'OFFLINE TESTTS%s\n' "${WEBCAM_NA:+ webcam=$WEBCAM_NA}"
  )"
  [ "$_wna_out" = "OFFLINE TESTTS webcam=no-frame" ] \
    || { echo "  FAIL: OFFLINE state write should carry webcam=no-frame reason (got: $_wna_out)"; _f=1; }
  # --- beacon fallback (phone-INDEPENDENT; fixture-injected — --test never SSHes to phaedra).
  # FALSIFIABLE: change BEACON_MAX_AGE handling / the reason tokens / the source tag → these fail. ---
  _bnow=$(date +%s)
  _bo="$(beacon_lux "{\"ts\": $((_bnow-120)), \"lux\": \"250\"}" 2400)" \
    && [ "${_bo%% *}" = 250 ] || { echo "  FAIL: fresh beacon should parse lux 250 (got: $_bo)"; _f=1; }
  # lux=0 is a VALID dark reading (live 2026-07-07 record carried lux:"0"), not a missing field
  _bo="$(beacon_lux "{\"ts\": $((_bnow-60)), \"lux\": \"0\"}" 2400)" \
    && [ "${_bo%% *}" = 0 ] || { echo "  FAIL: beacon lux=0 must be a valid reading (got: $_bo)"; _f=1; }
  _bo="$(beacon_lux "{\"ts\": $((_bnow-3000)), \"lux\": \"5\"}" 2400)" \
    && { echo "  FAIL: 3000s-old beacon must not pass a 2400s cutoff"; _f=1; } \
    || { printf '%s' "$_bo" | grep -q '^n/a stale' || { echo "  FAIL: old beacon reason should be 'stale' (got: $_bo)"; _f=1; }; }
  _bo="$(beacon_lux "{\"ts\": $((_bnow-60)), \"lux\": null}" 2400)" \
    && { echo "  FAIL: null lux must not pass"; _f=1; } \
    || { printf '%s' "$_bo" | grep -q '^n/a no-lux' || { echo "  FAIL: null lux reason should be 'no-lux' (got: $_bo)"; _f=1; }; }
  _bo="$(beacon_lux "not json at all" 2400)" \
    && { echo "  FAIL: garbage must not pass"; _f=1; } \
    || { printf '%s' "$_bo" | grep -q '^n/a unparseable' || { echo "  FAIL: garbage reason should be 'unparseable' (got: $_bo)"; _f=1; }; }
  _bo="$(beacon_lux "" 2400)" \
    && { echo "  FAIL: empty record must not pass"; _f=1; } \
    || { printf '%s' "$_bo" | grep -q '^n/a unreachable' || { echo "  FAIL: empty record reason should be 'unreachable' (got: $_bo)"; _f=1; }; }
  # end-to-end success: fresh fixture → classified level, source=beacon wording, STATE written (subshell:
  # _beacon_fallback exits 0 on success, sandboxed STATE)
  _bfs="$(
    STATE="$(mktemp)"; MODE=text; TS=TESTTS
    MESH_LIGHT_BEACON_FIXTURE="{\"ts\": $((_bnow-100)), \"lux\": \"250\"}"
    _beacon_fallback
    echo "NOT-REACHED"
  )"
  printf '%s' "$_bfs" | grep -q '^\[room-lit\] LIT (beacon-derived' \
    || { echo "  FAIL: fresh-beacon fallback should emit [room-lit] LIT beacon-derived (got: $_bfs)"; _f=1; }
  # end-to-end fall-through: stale fixture → BEACON_NA carries the classified reason for the OFFLINE line
  _bna_out="$(
    STATE="$(mktemp)"; MODE=text; TS=TESTTS
    MESH_LIGHT_BEACON_FIXTURE="{\"ts\": $((_bnow-9000)), \"lux\": \"250\"}"
    BEACON_NA=""
    _beacon_fallback
    printf 'OFFLINE TESTTS%s\n' "${BEACON_NA:+ beacon=$BEACON_NA}"
  )"
  [ "$_bna_out" = "OFFLINE TESTTS beacon=stale" ] \
    || { echo "  FAIL: stale beacon should fall through with BEACON_NA=stale (got: $_bna_out)"; _f=1; }
  # JSON emitter: beacon source carries source=beacon + source_age_s
  _bj="$(emit_light_json DIM 17 2026-07-07T00:00:00Z MODERATE null null null null null STABLE FLAT beacon false "" 498)"
  python3 - "$_bj" <<'PY' || { echo "  FAIL: beacon JSON emitter malformed ($_bj)"; _f=1; }
import json, sys
d = json.loads(sys.argv[1])
assert d["source"] == "beacon"
assert d["source_age_s"] == 498
assert d["level"] == "DIM"
PY
  # --- Note3 craft-room light: pure parse-fixtures (phone-INDEPENDENT — the craft read
  # goes to ds/Note3, not the body phone, so these run regardless of body reachability).
  # FALSIFIABLE: break the regex/field → these fail. A MAX88922 light line yields
  # values[0] lux; lux=0 is a valid dark reading; an absent light line yields rc 1
  # (→ honest UNKNOWN, never a faked level). ---
  _clx="$(printf '%s\n' 'MAX88922 RGB Sensor| Maxim| v1 |android.sensor.light| 0x1 | type=5 | last=<12.1, 5087.1, 0.0, 208>' | note3_light_lux)"
  [ "$_clx" = 12 ] || { echo "  FAIL: craft light parse should extract 12 lux from values[0]=12.1 (got '$_clx')"; _f=1; }
  _clx0="$(printf '%s\n' 'MAX88922 RGB Sensor| |android.sensor.light| last=<0.0, 0.0, 0.0, 0>' | note3_light_lux)"
  [ "$_clx0" = 0 ] || { echo "  FAIL: craft light lux=0 must be a valid dark reading (got '$_clx0')"; _f=1; }
  _clnrc="$(printf '%s\n' 'LPS25H Barometer| android.sensor.pressure| last=<981.8, 0, 0, 0>' | note3_light_lux; echo "rc=$?")"
  echo "$_clnrc" | grep -q '^rc=1$' || { echo "  FAIL: no light line must yield empty + rc 1 (→ UNKNOWN), got '$_clnrc'"; _f=1; }
  # --- LIVE craft-room read gate (verification principle: a real read must produce data).
  # Only when the Note3 adb relay is configured AND reachable; an unreachable body is an
  # honest n/a here (never a FAIL — mesh-land treats the tool's own exit 2 as a pass, so
  # the craft-room UNKNOWN path never blocks landing). ---
  if [ -n "$NOTE3_ADB_NODE" ]; then
    _cdump="$(note3_dumpsys)"
    if [ -n "$_cdump" ]; then
      _clive="$(printf '%s' "$_cdump" | note3_light_lux)"
      { [ -n "$_clive" ] && [ "$_clive" -ge 0 ] 2>/dev/null; } \
        || { echo "  FAIL: Note3 adb reachable but no live android.sensor.light lux (got '$_clive')"; _f=1; }
    fi
  fi
  # Real SSH reachability probe — NOT mesh-phone-ip (returns cached IP exit 0 when
  # offline → false-green). phone_reachable_ip (mesh-patterns.sh) does a real ConnectTimeout=3 SSH.
  source "$HOME/.local/bin/mesh-patterns.sh" 2>/dev/null || true
  phone_reachable_ip >/dev/null 2>&1 || { echo "smoke-test: n/a (phone unreachable — light sense unavailable)"; [ "$_f" = 0 ] && exit 2; exit 1; }
  [ "$_f" = 0 ] || { echo "smoke-test: FAIL (classify() hysteresis drifted — thresholds wrong)"; exit 1; }
  # Transition tracking test: simulate state file, verify delta/stable_s computation
  mkdir -p "$HOME/.mesh" 2>/dev/null || true
  _ts="$HOME/.mesh/.light-transitions.test"
  printf 'LIT|400|1000|3\n' > "$_ts"
  IFS='|' read -r _pl _plux _pts _pc < "$_ts"
  [ "$_pl" = "LIT" ] || { echo "  FAIL: transition prev_level should be LIT (got $_pl)"; _f=1; }
  [ "$_plux" = "400" ] || { echo "  FAIL: transition prev_lux should be 400 (got $_plux)"; _f=1; }
  [ "$_pc" = "3" ] || { echo "  FAIL: transition change_count should be 3 (got $_pc)"; _f=1; }
  rm -f "$_ts"
  # Velocity test: simulate velocity state file, verify smoothing + velocity classification
  _tv="$HOME/.mesh/.light-velocity.test"
  _tnow=$(date +%s)
  # Simulate 3 readings: 100, 200, 300 over 10 seconds each → velocity should be high (SUDDEN)
  printf '200|%d|100|%d|300|%d\n' "$((_tnow-10))" "$((_tnow-20))" "$_tnow" > "$_tv"
  _smooth=$(( (300 + 200 + 100) / 3 ))  # = 200
  [ "$_smooth" = "200" ] || { echo "  FAIL: smoothed lux should be 200 (got $_smooth)"; _f=1; }
  # Velocity direction helper: positive / negative / near-zero are distinguished explicitly.
  [ "$(classify_velocity_dir 10)" = BRIGHTENING ] || { echo "  FAIL: positive velocity should be BRIGHTENING"; _f=1; }
  [ "$(classify_velocity_dir -10)" = DARKENING ] || { echo "  FAIL: negative velocity should be DARKENING"; _f=1; }
  [ "$(classify_velocity_dir 0.01)" = FLAT ] || { echo "  FAIL: near-zero velocity should be FLAT"; _f=1; }
  rm -f "$_tv"
  # JSON emitter guard: live phone path stays structured; webcam fallback is explicitly marked coarse.
  _j="$(emit_light_json DIM 17 2026-06-30T00:00:00Z MODERATE 12 -3 5 0.25 18 GRADUAL BRIGHTENING phone false)"
  python3 - "$_j" <<'PY' || { echo "  FAIL: live JSON emitter malformed"; _f=1; }
import json, sys
d = json.loads(sys.argv[1])
assert d["level"] == "DIM"
assert d["source"] == "phone"
assert d["coarse"] is False
assert d["change_class"] == "GRADUAL"
PY
  _wj="$(emit_light_json DIM null 2026-06-30T00:00:00Z MODERATE null null null null null COARSE FLAT webcam true "webcam-derived mean=70.0 stddev=20.0")"
  python3 - "$_wj" <<'PY' || { echo "  FAIL: webcam JSON emitter malformed"; _f=1; }
import json, sys
d = json.loads(sys.argv[1])
assert d["source"] == "webcam"
assert d["coarse"] is True
assert d["change_class"] == "COARSE"
assert d["webcam_reason"].startswith("webcam-derived")
assert d["lux"] is None
PY
  [ "$_f" = 0 ] || { echo "smoke-test: FAIL (velocity tracking: assertions failed)"; exit 1; }
  # --- light_dwell enrichment tests (FALSIFIABLE: change the 5/60/1800 thresholds → these flip) ---
  _df=0
  # TRANSITION: 0s
  r="$(classify_dwell 0)"
  echo "$r" | grep -q '^TRANSITION' || { echo "  FAIL dwell TRANSITION 0s: got=$r"; _df=1; }
  # TRANSITION: 4s
  r="$(classify_dwell 4)"
  echo "$r" | grep -q '^TRANSITION' || { echo "  FAIL dwell TRANSITION 4s: got=$r"; _df=1; }
  # RECENT: 5s (boundary)
  r="$(classify_dwell 5)"
  echo "$r" | grep -q '^RECENT' || { echo "  FAIL dwell RECENT 5s: got=$r"; _df=1; }
  # RECENT: 59s
  r="$(classify_dwell 59)"
  echo "$r" | grep -q '^RECENT' || { echo "  FAIL dwell RECENT 59s: got=$r"; _df=1; }
  # STABLE: 60s (boundary)
  r="$(classify_dwell 60)"
  echo "$r" | grep -q '^STABLE' || { echo "  FAIL dwell STABLE 60s: got=$r"; _df=1; }
  # STABLE: 29 min
  r="$(classify_dwell 1740)"
  echo "$r" | grep -q '^STABLE' || { echo "  FAIL dwell STABLE 1740s: got=$r"; _df=1; }
  # CHRONIC: 30 min (boundary)
  r="$(classify_dwell 1800)"
  echo "$r" | grep -q '^CHRONIC' || { echo "  FAIL dwell CHRONIC 1800s: got=$r"; _df=1; }
  # CHRONIC: 24h
  r="$(classify_dwell 86400)"
  echo "$r" | grep -q '^CHRONIC' || { echo "  FAIL dwell CHRONIC 86400s: got=$r"; _df=1; }
  # NEVER: empty
  r="$(classify_dwell '')"
  [ "$r" = "NEVER|no reading on record" ] || { echo "  FAIL dwell NEVER: got=$r"; _df=1; }
  [ "$_df" = 0 ] || { echo "smoke-test: FAIL (light_dwell assertions)"; exit 1; }
  echo "smoke-test: ok (classify: 24 + transition: 3 + velocity: 5 + webcam-fallback: 16 incl direct-capture + live-gate + offline-reason + beacon-fallback: 9 + craft-light: 3 + live-gate + light_dwell: 9 + read_prev_level: 4 assertions)"; exit 0
fi

MODE=text
[ "${1:-}" = --json ] && MODE=json
EDGE=0
if [ "${1:-}" = --edge ]; then EDGE=1; MODE=edge; fi

# --webcam: explicit node-webcam COARSE light reading (phone-independent). Honest exit 2 when the frame
# is missing/stale/flat/unreadable — never a faked level. Probes the fallback path directly.
# --status: READ-ONLY, print current level+age from STATE file only (no phone SSH, no writes)
# Memory: status-read-shares-write-path-mutates — reading state should never mutate it.
if [ "${1:-}" = --status ]; then
  if [ -f "$STATE" ]; then
    state_val="$(cat "$STATE" 2>/dev/null || echo '')"
    level="$(printf '%s' "$state_val" | cut -d'|' -f1)"
    # State format: LEVEL|dwell_s=N|changes_24h=N or just LEVEL or "OFFLINE <ts> [webcam=reason]"
    if [ -n "$level" ]; then
      printf '%s\n' "$state_val"
      exit 0
    fi
  fi
  echo "UNKNOWN (no state)" >&2
  exit 2
fi

if [ "${1:-}" = --webcam ]; then
  if wout="$(webcam_light "$CAM_FRAME")"; then
    lvl="${wout%% *}"; echo "[room-${lvl,,}] $lvl (webcam-derived, coarse; ${wout#* })"; exit 0
  fi
  # webcam_light now names the SPECIFIC cannot-assess reason (no-frame|stale|covered|no-pil|unreadable);
  # surface it verbatim instead of the old opaque lump so the operator knows which fix this needs.
  echo "webcam light ${wout:-n/a unknown (no reason from probe)} — NOT faked" >&2; exit 2
fi

# --craft: Note 3 CRAFT-ROOM light vantage (second room, via the adb→ds relay). Reads,
# classifies (same hysteresis), writes .light-craft-state, emits a room-tagged line.
# rc 2 = honest UNKNOWN (adb body unreachable / no light line) — never a faked level.
if [ "${1:-}" = --craft ]; then
  note3_craft_read emit; exit $?
fi
# --craft-status: READ-ONLY — print .light-craft-state verbatim, no adb read, no writes
# (status-read-shares-write-path-mutates: a dash poll must never mutate the sense).
if [ "${1:-}" = --craft-status ]; then
  if [ -f "$CRAFT_STATE" ]; then cat "$CRAFT_STATE"; exit 0; fi
  echo "UNKNOWN (no craft-room state)" >&2; exit 2
fi

TS=$(date -u +%Y-%m-%dT%H:%M:%SZ)

# Craft-room piggyback: the SCHEDULED body run (cron: --edge, reflex-args above) also
# refreshes the Note3 craft-room vantage, so it gets cadence from the SAME reflex entry
# (one cron line, two rooms) without a second wiring. Best-effort + fully DECOUPLED from
# the body phone's reachability (its own adb→ds SSH) — placed BEFORE the phone read so it
# still refreshes even when the body phone is offline, and a craft failure NEVER blocks
# the body read (honest UNKNOWN is written to CRAFT_STATE, rc swallowed).
if [ "$MODE" = edge ] && [ -n "$NOTE3_ADB_NODE" ]; then
  note3_craft_read >/dev/null 2>&1 || true
fi

pip="$(mesh-phone-ip 2>/dev/null)" || {
    _beacon_fallback   # phone SSH down → freshest push-beacon lux first (real sensor); exits 0 on a fresh record
    _webcam_fallback   # then the node webcam (coarse room proxy); exits 0 if it yields a coarse reading
    if [ ! -f "$OFFLINEFILE" ]; then echo "phone unreachable — can't read ambient light (not an alarm)"; touch "$OFFLINEFILE"; fi
    printf 'OFFLINE %s%s%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "${BEACON_NA:+ beacon=$BEACON_NA}" "${WEBCAM_NA:+ webcam=$WEBCAM_NA}" > "$STATE"
    mesh-state-touch "$STATE"
    exit 2
}
rm -f "$OFFLINEFILE"

# -d 500 -n 2: tmd2755_l needs at least one poll cycle before the first value arrives;
# -n 1 races the driver and the process exits with only cleanup messages, no JSON.
# No inner timeout wrapper: wrapping in `timeout` sends SIGTERM to termux-sensor, which
# prints its cleanup messages to STDOUT, not stderr — polluting the JSON stream. The outer
# SSH timeout (14s) is sufficient; termux-sensor with -n 2 self-terminates cleanly after 2 samples.
# 2>/dev/null in the remote command: suppresses SIGTERM cleanup noise from termux-sensor stderr.
j="$(timeout 14 ssh -p "${PHONE_SSH_PORT:-8022}" -o BatchMode=yes -o ConnectTimeout=6 "${PHONE_USER:-u0_a380}@$pip" 'termux-sensor -s tmd2755_l -d 500 -n 2 2>/dev/null' </dev/null 2>/dev/null)"
[ -n "$j" ] || { _beacon_fallback; _webcam_fallback; if [ ! -f "$OFFLINEFILE" ]; then echo "phone unreachable — can't read ambient light (not an alarm)"; touch "$OFFLINEFILE"; fi; printf 'OFFLINE %s%s%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "${BEACON_NA:+ beacon=$BEACON_NA}" "${WEBCAM_NA:+ webcam=$WEBCAM_NA}" > "$STATE"; mesh-state-touch "$STATE"; exit 2; }

# raw_decode: parse only the FIRST JSON object — with -n 2 we get two objects back-to-back;
# json.load() would fail on the second. raw_decode() stops after the first complete object.
lux="$(printf '%s' "$j" | python3 -c 'import json,sys
try:
    data=sys.stdin.read().strip()
    d,_=json.JSONDecoder().raw_decode(data)
    x=d.get("tmd2755_l", {})
    vals=x.get("values") if isinstance(x, dict) else None
    if vals:
        print(int(float(vals[0])))
    else:
        print("")
except Exception:
    print("")' 2>/dev/null)"
[ -n "${lux:-}" ] || { _beacon_fallback; _webcam_fallback; echo "light parse failed (not an alarm)"; exit 2; }

prev="$(read_prev_level "$STATE")"

# classify() is defined at the top of the script for --test access (identical).
# This is the same function, re-declared so the main flow doesn't depend on
# the top-level definition surviving bash's sequential parse:
classify() {  # duplicated intentionally — first copy is for --test (exits before here)
  local l=$1 p=$2
  case "$p" in
    DARK)     [ "$l" -gt 5   ] && { echo DIM;     return; }; echo DARK;;
    DIM)      [ "$l" -lt 3   ] && { echo DARK;    return; }
              [ "$l" -gt 30  ] && { echo MODERATE; return; }; echo DIM;;
    MODERATE) [ "$l" -lt 15  ] && { echo DIM;     return; }
              [ "$l" -gt 150 ] && { echo LIT;     return; }; echo MODERATE;;
    LIT)      [ "$l" -lt 80  ] && { echo MODERATE;return; }
              [ "$l" -gt 600 ] && { echo BRIGHT;  return; }; echo LIT;;
    BRIGHT)   [ "$l" -lt 400 ] && { echo LIT;     return; }; echo BRIGHT;;
    *)        if   [ "$l" -le 2   ]; then echo DARK
              elif [ "$l" -le 30  ]; then echo DIM
              elif [ "$l" -le 150 ]; then echo MODERATE
              elif [ "$l" -le 600 ]; then echo LIT
              else echo BRIGHT; fi;;
  esac
}

level="$(classify "$lux" "$prev")"
tag="[room-${level,,}]"

# Write state (always, for edge tracking) — additive 5th/6th fields: dwell_s + changes_24h
NOW_EPOCH=$(date +%s)
prev_level_ts=""
[ -f "$LIGHT_LOG" ] && prev_level_ts="$(tail -n 1 "$LIGHT_LOG" 2>/dev/null | cut -d'|' -f1)"
dwell_s=0
if [ -n "$prev_level_ts" ] && [ "$prev_level_ts" -gt 0 ] 2>/dev/null; then
  dwell_s=$(( NOW_EPOCH - prev_level_ts ))
fi
# Log this reading (idempotent on same-level consecutive runs — only logs a TRUE transition)
prev_logged_level=""
[ -f "$LIGHT_LOG" ] && prev_logged_level="$(tail -n 1 "$LIGHT_LOG" 2>/dev/null | cut -d'|' -f2)"
if [ "$level" != "$prev_logged_level" ]; then
  printf '%s|%s\n' "$NOW_EPOCH" "$level" >> "$LIGHT_LOG"
fi
# Count changes in last 24h (pruning on the fly)
LIGHT_LOG="$HOME/.mesh/.light-events"
_light_cutoff=$(( NOW_EPOCH - 86400 ))
changes_24h=0
if [ -f "$LIGHT_LOG" ]; then
  _tmp_lc="$LIGHT_LOG.tmp.$$"
  : > "$_tmp_lc"
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    _ts="$(printf '%s' "$line" | cut -d'|' -f1)"
    [ "$_ts" -ge "$_light_cutoff" ] 2>/dev/null && printf '%s\n' "$line" >> "$_tmp_lc"
  done < "$LIGHT_LOG"
  mv -f "$_tmp_lc" "$LIGHT_LOG" 2>/dev/null || rm -f "$_tmp_lc"
  changes_24h="$(wc -l < "$LIGHT_LOG" 2>/dev/null | tr -d ' ')"
fi
printf '%s|dwell_s=%s|changes_24h=%s\n' "$level" "$dwell_s" "$changes_24h" > "$STATE"
mesh-state-touch "$STATE"

# --- Transition tracking ---
TRANS_STATE="$HOME/.mesh/.light-transitions"
NOW_EPOCH=$(date +%s)
prev_level="$prev"
prev_lux=""
prev_ts=""
change_count=0
stable_s=0
lux_delta=0

if [ -f "$TRANS_STATE" ]; then
  IFS='|' read -r prev_level prev_lux prev_ts change_count < "$TRANS_STATE"
  # Compute seconds since last change
  if [ -n "$prev_ts" ] && [ "$prev_ts" -eq "$prev_ts" ] 2>/dev/null; then
    stable_s=$(( NOW_EPOCH - prev_ts ))
  fi
  # Compute lux delta
  if [ -n "$prev_lux" ] && [ "$prev_lux" -eq "$prev_lux" ] 2>/dev/null; then
    lux_delta=$(( lux - prev_lux ))
  fi
fi

# If level changed, update transition state
if [ "$level" != "$prev_level" ]; then
  change_count=$(( ${change_count:-0} + 1 ))
  printf '%s|%s|%s|%s\n' "$level" "$lux" "$NOW_EPOCH" "$change_count" > "$TRANS_STATE"
  stable_s=0
fi

# --- Rate-of-change (lux velocity) + smoothed lux ---
# Tracks last 3 readings for a moving average (smoothed lux) and computes velocity
# (lux/second) to classify change type: GRADUAL (<5 lux/s), SUDDEN (>=5 lux/s), STABLE (0).
# State file .light-velocity: lux1|ts1|lux2|ts2|lux3|ts3
VEL_STATE="$HOME/.mesh/.light-velocity"
velocity=0.0
smoothed_lux="$lux"
change_class="STABLE"
velocity_dir="FLAT"

if [ -f "$VEL_STATE" ]; then
  IFS='|' read -r v_l1 v_t1 v_l2 v_t2 v_l3 v_t3 < "$VEL_STATE" 2>/dev/null || true
  # Build array of valid previous readings (backwards in time)
  _vl=(); _vt=()
  [ -n "$v_l3" ] && [ "$v_l3" -eq "$v_l3" ] 2>/dev/null && _vl+=("$v_l3") && _vt+=("$v_t3")
  [ -n "$v_l2" ] && [ "$v_l2" -eq "$v_l2" ] 2>/dev/null && _vl+=("$v_l2") && _vt+=("$v_t2")
  [ -n "$v_l1" ] && [ "$v_l1" -eq "$v_l1" ] 2>/dev/null && _vl+=("$v_l1") && _vt+=("$v_t1")
  # Smoothed lux: average of all valid readings (including current)
  _sum=$lux; _cnt=1
  for v in "${_vl[@]}"; do _sum=$((_sum + v)); _cnt=$((_cnt + 1)); done
  smoothed_lux=$((_sum / _cnt))
  # Velocity: lux/sec from oldest valid reading to current
  if [ ${#_vl[@]} -gt 0 ] && [ -n "${_vt[0]}" ] && [ "$_vt[0]" -eq "$_vt[0]" ] 2>/dev/null; then
    _dt=$(( NOW_EPOCH - _vt[0] ))
    if [ "$_dt" -gt 0 ]; then
      _dl=$(( lux - _vl[0] ))
      # Use python for fractional division
      velocity="$(python3 -c "print(round(${_dl}/${_dt}, 2))" 2>/dev/null || echo "0")"
      # Classify change
      _abs_vel="${velocity#-}"
      velocity_dir="$(classify_velocity_dir "$velocity")"
      if [ "$_abs_vel" = "0" ] || [ "$_abs_vel" = "0.0" ]; then
        change_class="STABLE"
      elif python3 -c "exit(0 if abs(${velocity}) < 5 else 1)" 2>/dev/null; then
        change_class="GRADUAL"
      else
        change_class="SUDDEN"
      fi
    fi
  fi
  # Shift window: drop oldest, append current
  printf '%s|%s|%s|%s|%s|%s\n' "${_vl[${#_vl[@]}-1]:-}" "${_vt[${#_vt[@]}-1]:-}" \
    "${_vl[${#_vl[@]}-2]:-}" "${_vt[${#_vt[@]}-2]:-}" "$lux" "$NOW_EPOCH" > "$VEL_STATE"
else
  # First reading — seed the velocity window
  printf '|||%s|%s|%s\n' "" "" "$lux" "$NOW_EPOCH" > "$VEL_STATE"
fi

case "$MODE" in
  json)
    emit_light_json "$level" "$lux" "$TS" "${prev_level:-UNKNOWN}" "${stable_s:-0}" "${lux_delta:-0}" "${change_count:-0}" \
      "${velocity:-0}" "${smoothed_lux:-$lux}" "${change_class:-STABLE}" "${velocity_dir:-FLAT}" phone false
    ;;
  edge)
    # Only emit when level changes vs previous
    [ "$level" = "$prev" ] && exit 0
    printf '%s %s — ambient light %s lux (delta=%s, stable=%ss, changes=%s, velocity=%s lux/s [%s %s])\n' \
      "$tag" "$level" "$lux" "${lux_delta:-0}" "${stable_s:-0}" "${change_count:-0}" \
      "${velocity:-0}" "${change_class:-STABLE}" "${velocity_dir:-FLAT}"
    ;;
  *)
    printf '%s %s — ambient light %s lux (prev=%s, delta=%s, stable=%ss, velocity=%s lux/s [%s %s])\n' \
      "$tag" "$level" "$lux" "${prev_level:-UNKNOWN}" "${lux_delta:-0}" "${stable_s:-0}" \
      "${velocity:-0}" "${change_class:-STABLE}" "${velocity_dir:-FLAT}"
    ;;
esac
