#!/usr/bin/env bash
# reflex-cadence: 9-59/10 * * * *
# reflex-args: --edge
# mesh-light — the mesh's ambient-light sense for the body phone.
# Reads the phone's tmd2755_l sensor once and classifies room DARK or LIT.
# Hysteresis: DARK→LIT requires lux > UPPER; LIT→DARK requires lux < LOWER.
# Edge-triggered: emits only on state change when --edge is used.
#
#   mesh-light          one check; edge-trigger [room-dark]/[room-lit]
#   mesh-light --status print current lux/state, no alarm
#   mesh-light --edge   emit only on state change
#   mesh-light --test   smoke test (exit 2 = n/a, phone unreachable)
#
# Thresholds: MESH_LIGHT_LOWER (default 2 lux, LIT→DARK), MESH_LIGHT_UPPER
# (default 5 lux, DARK→LIT). Set MESH_LIGHT_MIN for a single fixed threshold
# (no hysteresis — both LOWER and UPPER equal it).
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes"

if [ -n "${MESH_LIGHT_MIN:-}" ]; then
  LOWER="$MESH_LIGHT_MIN"
  UPPER="$MESH_LIGHT_MIN"
else
  LOWER="${MESH_LIGHT_LOWER:-2}"
  UPPER="${MESH_LIGHT_UPPER:-5}"
fi

STATE="$HOME/.mesh/.light-state"
OFFLINEFILE="$HOME/.mesh/.light-offline"

if [ "${1:-}" = --test ]; then
  command -v ssh >/dev/null 2>&1 || { echo "smoke-test: FAIL (no ssh)"; exit 1; }
  command -v python3 >/dev/null 2>&1 || { echo "smoke-test: FAIL (no python3)"; exit 1; }
  command -v mesh-phone-ip >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-phone-ip)"; exit 1; }
  mkdir -p "$HOME/.mesh" 2>/dev/null || { echo "smoke-test: FAIL (no ~/.mesh)"; exit 1; }
  mesh-phone-ip >/dev/null 2>&1 || { echo "smoke-test: n/a (phone unreachable — light sense unavailable)"; exit 2; }
  echo "smoke-test: ok"; exit 0
fi

pip="$(mesh-phone-ip 2>/dev/null)" || {
    if [ ! -f "$OFFLINEFILE" ]; then echo "phone unreachable — can't read ambient light (not an alarm)"; touch "$OFFLINEFILE"; fi
    exit 2
}
rm -f "$OFFLINEFILE"

j="$(timeout 12 ssh -p "${PHONE_SSH_PORT:-8022}" -o BatchMode=yes -o ConnectTimeout=6 "${PHONE_USER:-u0_a386}@$pip" 'timeout 6 termux-sensor -s tmd2755_l -n 1' </dev/null 2>/dev/null)"
[ -n "$j" ] || { if [ ! -f "$OFFLINEFILE" ]; then echo "phone unreachable — can't read ambient light (not an alarm)"; touch "$OFFLINEFILE"; fi; exit 2; }

lux="$(printf '%s' "$j" | python3 -c 'import json,sys
try:
    d=json.load(sys.stdin)
    x=d.get("tmd2755_l", {})
    vals=x.get("values") if isinstance(x, dict) else None
    if vals:
        print(int(float(vals[0])))
    else:
        print("")
except Exception:
    print("")' 2>/dev/null)"
[ -n "${lux:-}" ] || { echo "light parse failed (not an alarm)"; exit 2; }

prev="$(cat "$STATE" 2>/dev/null || echo UNKNOWN)"

# Hysteresis classification: hold state in the band between LOWER and UPPER
if [ "$prev" = "DARK" ]; then
  if [ "$lux" -gt "$UPPER" ]; then
    state="LIT"
  else
    state="DARK"
  fi
elif [ "$prev" = "LIT" ]; then
  if [ "$lux" -lt "$LOWER" ]; then
    state="DARK"
  else
    state="LIT"
  fi
else
  # UNKNOWN or first run — use single threshold at midpoint
  if [ "$lux" -le "$(( (LOWER + UPPER) / 2 ))" ]; then
    state="DARK"
  else
    state="LIT"
  fi
fi

tag="[room-${state,,}]"

if [ "${1:-}" = --status ]; then
  echo "room light: ${lux} lux ${state} (hysteresis ${LOWER}-${UPPER} lux)"
  exit 0
fi

if [ "$state" = "DARK" ]; then
  echo DARK > "$STATE"
else
  echo LIT > "$STATE"
fi

if [ "${1:-}" = --edge ] && [ "$prev" = "$state" ]; then
  exit 0
fi

echo "$tag ${state} — ambient light ${lux} lux (hysteresis ${LOWER}-${UPPER})"
