#!/usr/bin/env python3
"""mesh-phi — phi-accrual failure detector (Hayashibara et al.; used in Cassandra/Akka).

Replaces hand-tuned fixed timeouts with an ADAPTIVE suspicion level. It learns the distribution
of observed heartbeat inter-arrival times and outputs phi = -log10(P(a beat is later than the
current elapsed gap)). phi rises as the gap grows beyond what history says is normal — so a mesh
breathing every 2min and one breathing every 10min are both judged against THEIR OWN rhythm, no
threshold to retune when cadence drifts (the bug we kept hitting).

  mesh-phi <hist-file> <beat_epoch> <now_epoch>
    -> prints "COLDSTART" (｢<3 samples, caller falls back to fixed MAX_AGE) or a phi value (e.g. 0.31).
       Maintains <hist-file> (rolling window of observed distinct beat times). Suspect when phi >= ~8.
"""
import sys, math

def main():
    if len(sys.argv) < 4:
        print("COLDSTART"); return
    hist_file, beat, now = sys.argv[1], int(sys.argv[2]), int(sys.argv[3])
    try:
        hist = [int(x) for x in open(hist_file).read().split() if x.strip()]
    except OSError:
        hist = []
    # record a genuinely NEW beat (dedupe: only append when the stamp advanced)
    if not hist or beat > hist[-1]:
        hist.append(beat)
    hist = hist[-20:]                       # rolling window
    try:
        with open(hist_file, "w") as f: f.write("\n".join(map(str, hist)))
    except OSError:
        pass
    if len(hist) < 3:                       # not enough to model the distribution yet
        print("COLDSTART"); return
    intervals = [hist[i+1] - hist[i] for i in range(len(hist)-1)]
    mu = sum(intervals) / len(intervals)
    var = sum((x - mu) ** 2 for x in intervals) / len(intervals)
    sd = max(var ** 0.5, max(1.0, 0.1 * mu))   # floor sd: avoid div0 and phi exploding on tiny jitter
    elapsed = now - hist[-1]
    z = (elapsed - mu) / sd
    p_later = 1.0 - 0.5 * (1 + math.erf(z / math.sqrt(2)))   # P(interval > elapsed), normal approx
    p_later = min(max(p_later, 1e-12), 1.0)
    phi = -math.log10(p_later)
    print(f"{phi:.2f}")

def smoke_test():
    # golden matrix through the PRODUCTION main(): a regression here either marks healthy
    # nodes suspect (false alarms) or never suspects a dead one (the silent-death blind spot)
    import tempfile, io, contextlib, os
    fails = []
    def run(*argv):
        buf = io.StringIO(); old = sys.argv
        sys.argv = ["mesh-phi"] + [str(a) for a in argv]
        try:
            with contextlib.redirect_stdout(buf): main()
        finally:
            sys.argv = old
        return buf.getvalue().strip()
    with tempfile.TemporaryDirectory() as td:
        h = os.path.join(td, "hist")
        if run(h, 1000, 1060) != "COLDSTART": fails.append("no COLDSTART at 1 sample")
        if run(h, 1060, 1120) != "COLDSTART": fails.append("no COLDSTART at 2 samples")
        for b in (1120, 1180, 1240): run(h, b, b + 60)        # learn a 60s rhythm
        ontime = run(h, 1240, 1300)                            # on-rhythm: 60s elapsed
        try: ok = float(ontime) < 1.0
        except ValueError: ok = False
        if not ok: fails.append("on-rhythm phi not low: " + ontime)
        late = run(h, 1240, 1840)                              # 10x late: must be suspect
        try: ok = float(late) >= 8.0
        except ValueError: ok = False
        if not ok: fails.append("10x-late phi below suspect threshold: " + late)
        n = len(open(h).read().split())
        if n != 5: fails.append("dedupe/rolling-window broken: %d entries (want 5)" % n)
    if fails:
        print("smoke-test: FAIL (" + "; ".join(fails) + ")"); sys.exit(1)
    print("smoke-test: ok"); sys.exit(0)

if __name__ == "__main__":
    if sys.argv[1:2] == ["--test"]:
        smoke_test()
    main()
