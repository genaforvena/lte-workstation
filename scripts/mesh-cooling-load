#!/usr/bin/env bash
# orphan-ok: on-demand local cooling-load sense — sysfs cooling-device state is a real hardware
#   signal the node could perceive but did not yet interpret as a dedicated sense. This reads the
#   local thermal cooling devices (/sys/class/thermal/cooling_device*/{type,cur_state,max_state})
#   and classifies the strongest cooling effort. Minimal on-demand organ by design.
# mesh-cooling-load — local cooling-device utilization sense.
#
# Why this is new:
#   mesh-therm reports temperatures, mesh-cpufreq reports CPU clocking, and mesh-therm-watch reports
#   hot/cool alerts. None of those interpret the cooling controller itself: how hard the kernel is
#   asking the system to cool. That control signal is distinct from temperature and frequency.
#
# Classification:
#   OFFLINE   no readable cooling_device entries
#   IDLE      all devices at cur_state=0
#   ACTIVE    at least one device engaged, strongest ratio < 50%
#   CLAMPED   strongest ratio >= 50%
#   SATURATED strongest ratio >= 90%
#
#   mesh-cooling-load          one compact line
#   mesh-cooling-load --json    machine-readable JSON
#   mesh-cooling-load --test    synthetic fixture smoke test + real-read gate
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

PS="${MESH_THERMAL_DIR:-/sys/class/thermal}"

classify_cooling() {
  awk -v cur="$1" -v max="$2" 'BEGIN{
    if (max <= 0) { print "OFFLINE|invalid max_state"; exit }
    if (cur <= 0) { print "IDLE|all cooling devices idle"; exit }
    ratio = (cur / max) * 100.0
    if (ratio >= 90.0) { print "SATURATED|cooling clamp near max (" cur "/" max ")"; exit }
    if (ratio >= 50.0) { print "CLAMPED|cooling effort high (" cur "/" max ")"; exit }
    print "ACTIVE|cooling engaged (" cur "/" max ")"
  }'
}

read_cooling() {
  local best_type="" best_cur=0 best_max=0 best_ratio=0 seen=0
  local d ty cur max ratio
  for d in "$PS"/cooling_device*; do
    [ -d "$d" ] || continue
    [ -r "$d/type" ] || continue
    [ -r "$d/cur_state" ] || continue
    [ -r "$d/max_state" ] || continue
    ty="$(cat "$d/type" 2>/dev/null | tr -d '\n')"
    cur="$(cat "$d/cur_state" 2>/dev/null)"
    max="$(cat "$d/max_state" 2>/dev/null)"
    [ -n "$ty" ] || continue
    [ -n "$cur" ] || continue
    [ -n "$max" ] || continue
    [ "$max" -gt 0 ] 2>/dev/null || continue
    seen=1
    ratio="$(awk -v c="$cur" -v m="$max" 'BEGIN{printf "%.3f", (c/m)*100.0}')"
    if [ -z "$best_type" ] || awk -v r="$ratio" -v b="$best_ratio" 'BEGIN{exit !(r>b)}'; then
      best_ratio="$ratio"; best_type="$ty"; best_cur="$cur"; best_max="$max"
    fi
  done
  [ "$seen" = 1 ] || return 1
  printf '%s\t%s\t%s\t%s\n' "$best_type" "$best_cur" "$best_max" "$best_ratio"
}

if [ "${1:-}" = --test ]; then
  command -v awk >/dev/null 2>&1 || { echo "smoke-test: FAIL (no awk)"; exit 1; }
  command -v mktemp >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mktemp)"; exit 1; }
  td="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
  trap 'rm -rf "$td"' EXIT
  mkdir -p "$td/cooling_device0" "$td/cooling_device1" "$td/cooling_device2"
  printf 'Processor\n' > "$td/cooling_device0/type"
  printf '0\n' > "$td/cooling_device0/cur_state"
  printf '10\n' > "$td/cooling_device0/max_state"
  printf 'TCC Offset\n' > "$td/cooling_device1/type"
  printf '6\n' > "$td/cooling_device1/cur_state"
  printf '63\n' > "$td/cooling_device1/max_state"
  printf 'intel_powerclamp\n' > "$td/cooling_device2/type"
  printf '0\n' > "$td/cooling_device2/cur_state"
  printf '100\n' > "$td/cooling_device2/max_state"
  got="$(MESH_THERMAL_DIR="$td" "$0" --json 2>/dev/null || true)"
  printf '%s\n' "$got" | grep -q '"label":"ACTIVE"' || {
    echo "smoke-test: FAIL (fixture should be ACTIVE: $got)"; exit 1; }
  printf '%s\n' "$got" | grep -q '"top_type":"TCC Offset"' || {
    echo "smoke-test: FAIL (fixture top device missing: $got)"; exit 1; }
  printf '%s\n' "$got" | grep -q '"top_ratio":9.524' || {
    echo "smoke-test: FAIL (fixture ratio wrong: $got)"; exit 1; }
  mkdir -p "$td/idle/cooling_device0"
  printf 'Processor\n' > "$td/idle/cooling_device0/type"
  printf '0\n' > "$td/idle/cooling_device0/cur_state"
  printf '10\n' > "$td/idle/cooling_device0/max_state"
  got="$(MESH_THERMAL_DIR="$td/idle" "$0" --json 2>/dev/null || true)"
  printf '%s\n' "$got" | grep -q '"label":"IDLE"' || {
    echo "smoke-test: FAIL (idle fixture should be IDLE: $got)"; exit 1; }
  if [ ! -r /sys/class/thermal/cooling_device0/cur_state ]; then
    echo "smoke-test: n/a (no readable cooling_device sysfs on this node)"; exit 2
  fi
  real="$(env -u MESH_THERMAL_DIR "$0" --json 2>/dev/null)" || { echo "smoke-test: FAIL (real read failed)"; exit 1; }
  printf '%s\n' "$real" | grep -q '"label":"' || { echo "smoke-test: FAIL (real read malformed: $real)"; exit 1; }
  echo "smoke-test: ok (fixture classifier + real cooling-device read)"
  exit 0
fi

MODE=text
[ "${1:-}" = --json ] && MODE=json

if ! [ -r /sys/class/thermal/cooling_device0/cur_state ]; then
  echo "cooling-load: UNREACHABLE — no readable cooling_device sysfs" >&2
  exit 2
fi

readout="$(read_cooling)" || {
  echo "cooling-load: UNREACHABLE — no readable cooling_device entries" >&2
  exit 2
}

IFS=$'\t' read -r top_type top_cur top_max top_ratio <<<"$readout"

label_reason="$(classify_cooling "$top_cur" "$top_max")"
label="${label_reason%%|*}"
reason="${label_reason#*|}"
ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

if [ "$MODE" = json ]; then
  printf '{"label":"%s","reason":"%s","top_type":"%s","top_cur":%s,"top_max":%s,"top_ratio":%s,"ts":"%s"}\n' \
    "$label" "$reason" "$top_type" "$top_cur" "$top_max" "$top_ratio" "$ts"
else
  printf '[cooling-load] %s — %s | top=%s %s/%s (%.1f%%)\n' \
    "$label" "$reason" "$top_type" "$top_cur" "$top_max" "$top_ratio"
fi
