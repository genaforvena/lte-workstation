#!/usr/bin/env python3
"""mesh-model-resolve — which model does each consumer ACTUALLY load right now.

THIS TOOL EXISTS BECAUSE A MAP LIED. mesh-model-watch:93-98 hardcodes
  "stt": ("openai/whisper-large-v3-turbo", ...)
and rendered exactly that at 10:16Z 2026-07-15 — while mesh-room-transcribe.service had
been stopped since 09:46 and gigaam was the live STT organ. Same family as the 33/52
vacuous self-grep gates and [ -x "$BIN" ]-is-not-"it runs": a DECLARATION IS NEVER AN
OBSERVATION.

EXECUTE THE CONSUMER'S OWN SELECTION CODE — DO NOT RE-DERIVE IT. This is the rule that
makes this tool different from the map it replaces. mesh-voice-rx picks its model with
_best_model(); mesh-note3-say picks its voice with pick_voice(); mesh-face-recognize
picks its backend with resolve_backend(). A resolver that RE-IMPLEMENTS those ladders is
just a second map, and a second map drifts from the first exactly as silently. So we run
THEIR functions: import the module in a subprocess, or extract the shell function and
execute it. When the consumer's code changes, our answer changes with it, for free. When
we cannot find their selector, that is UNKNOWN — never our own guess at what they meant.

UNKNOWN, NEVER A DEFAULT. If a consumer's model cannot be determined, this says UNKNOWN.
It must never fall back to a declared value: a plausible-but-wrong model name is worse
than an honest gap, because it is indistinguishable from a real reading.

AN ORGAN IS NOT ONE MODEL. STT has ~8 consumers; gigaam replaced whisper in ONE (the room
ear, 09:46). Rows are per CONSUMER for that reason.

STDLIB ONLY. System python3 on this node has no numpy.
"""
import json
import os
import re
import subprocess
import sys
from pathlib import Path

HOME = Path.home()
MESH = HOME / ".mesh"
# The deployed tools are what RUN. Resolve against ~/.local/bin, not the genome checkout:
# a genome edit that is not deployed yet must not change this tool's answer.
BIN = Path(os.environ.get("MESH_BIN_DIR", HOME / ".local/bin"))


def _sh(cmd, **kw):
    return subprocess.run(cmd, capture_output=True, text=True, timeout=30, **kw)


# A SELECTOR'S ANSWER IS CODE **AND** ENVIRONMENT — executing the code in the wrong env is
# still a guess. Caught live 2026-07-15: mesh-note3-say:38 sources ~/.mesh/nodes, which
# exports MESH_PIPER_VOICE=ru_RU-irina-medium.onnx; running pick_voice() without that env
# returned ru_RU-ruslan-medium.onnx — a plausible, WRONG model name, the exact failure this
# tool exists to kill. Worse, the answer then depended on OUR caller: mesh-dash sources
# nodes, so the pane read irina while the bare tool read ruslan. An observation that
# changes with who is asking is not an observation.
#
# So resolve in the env a consumer ACTUALLY runs under — a clean env (cron/systemd/a mind
# pane), plus that consumer's OWN config sourcing — never the ambient env of whoever
# invoked us. An interactive override (MESH_PIPER_VOICE=x mesh-note3-say) is a one-shot,
# not the standing answer, and is deliberately not reported here.
CLEAN_ENV = {"HOME": str(HOME), "PATH": f"{BIN}:/usr/local/bin:/usr/bin:/bin", "LANG": "C.UTF-8"}


def _own_config_sourcing(body):
    """Return the tool's OWN `. ~/.mesh/nodes` line, if it has one. Read from the tool, not
    assumed for it: a consumer that does not source nodes must not be resolved as if it did."""
    m = re.search(r"^\s*\[ -f \"\$HOME/\.mesh/nodes\" \].*$", body, re.M)
    return m.group(0) if m else ""


def _unit_active(unit):
    return _sh(["systemctl", "--user", "is-active", unit]).stdout.strip() == "active"


def _unit_env(unit, key):
    """Read a unit's Environment= for key. Returns None if unreadable — never a guess."""
    p = _sh(["systemctl", "--user", "show", unit, "-p", "Environment"])
    if p.returncode != 0:
        return None
    m = re.search(rf"(?:^|\s){re.escape(key)}=(\S+)", p.stdout)
    return m.group(1) if m else None


def _py_funcs(tool, names, call, preamble=""):
    """Extract named functions VERBATIM from a deployed python tool and execute `call`.

    NOT an import. Importing mesh-voice-rx runs its module-level singleton lock (:125,
    sys.exit(0) when another instance holds it) and opens ~/.mesh/voice-in.log with a
    scrubber subprocess. So an import-based resolver dies silently while the daemon is up
    — and STEALS THE LOCK from the daemon while it is down. A resolver must never perturb
    the thing it observes. Extracting the selector runs their ladder with none of their
    world.

    A function we cannot find is UNKNOWN — never our own re-implementation of it.
    """
    src = BIN / tool
    if not src.exists():
        return None, f"{tool} not deployed"
    body = src.read_text(errors="ignore")
    chunks = []
    for n in names:
        m = re.search(rf"^def {re.escape(n)}\(.*?(?=^\S|\Z)", body, re.S | re.M)
        if not m:
            return None, f"{tool} has no {n}() — its selector was renamed or removed"
        chunks.append(m.group(0))
    code = preamble + "\n" + "\n".join(chunks) + "\n" + call
    p = _sh([sys.executable, "-c", code], env=CLEAN_ENV)
    if p.returncode != 0:
        first = (p.stderr.strip().splitlines() or ["(no stderr)"])[-1]
        return None, f"{tool}:{names[-1]}() failed: {first[:120]}"
    out = p.stdout.strip()
    if not out:
        return None, f"{tool}:{names[-1]}() produced nothing"
    return out, f"{tool}:{names[-1]}() (its own ladder, executed)"


def _py_attr(tool, attr):
    """Import a deployed python mesh tool in a SUBPROCESS and print one module attribute.

    ONLY safe for tools with no import-time side effects — see _py_funcs for why that is
    not a given. Subprocess so a tool that dies on import yields UNKNOWN here rather than
    taking the pane down.
    """
    src = BIN / tool
    if not src.exists():
        return None, f"{tool} not deployed"
    code = (
        "import importlib.util,importlib.machinery\n"
        f"s=importlib.util.spec_from_file_location('t',{str(src)!r},"
        f"loader=importlib.machinery.SourceFileLoader('t',{str(src)!r}))\n"
        "m=importlib.util.module_from_spec(s)\n"
        "s.loader.exec_module(m)\n"
        f"v=getattr(m,{attr!r},None)\n"
        "print('' if v is None else v)\n"
    )
    p = _sh([sys.executable, "-c", code], env=CLEAN_ENV)
    if p.returncode != 0:
        first = (p.stderr.strip().splitlines() or ["(no stderr)"])[-1]
        return None, f"{tool} import failed: {first[:120]}"
    out = p.stdout.strip()
    if not out:
        return None, f"{tool} has no {attr} — its selector was renamed or removed"
    return out, f"{tool}.{attr} (its own selector, executed)"


def _sh_func(tool, func):
    """Extract a shell function from a deployed tool and EXECUTE it. Its ladder, not ours."""
    src = BIN / tool
    if not src.exists():
        return None, f"{tool} not deployed"
    body = src.read_text(errors="ignore")
    m = re.search(rf"^{re.escape(func)}\(\) \{{.*?^\}}", body, re.S | re.M)
    if not m:
        return None, f"{tool} has no {func}() — its selector was renamed or removed"
    cfg = _own_config_sourcing(body)
    p = _sh(["bash", "-c", f"set -u\n{cfg}\n{m.group(0)}\n{func}"], env=CLEAN_ENV)
    out = p.stdout.strip()
    if p.returncode != 0 or not out:
        return None, f"{tool}:{func}() produced nothing (rc={p.returncode})"
    how = f"{tool}:{func}() executed"
    how += " with its own ~/.mesh/nodes config" if cfg else " (sources no node config)"
    return out, how


def resolve_room_ear():
    """The room ear: which of the two transcriber units is ACTIVE decides the model.
    The units Conflicts= each other, so 'both active' is structurally impossible — but if
    systemd ever reports it, that is a real defect and must not resolve to one of them."""
    gig, tra = _unit_active("mesh-room-gigaam.service"), _unit_active("mesh-room-transcribe.service")
    if gig and tra:
        return ("stt", "room-ear", "UNKNOWN", "BOTH transcriber units active — transcript is doubling")
    if gig:
        m = _unit_env("mesh-room-gigaam.service", "GIGAAM_MODEL")
        if not m:
            # the unit is authoritative when it sets it; absent, the tool's own default is
            # the real answer — read it from the tool, do not repeat the literal here.
            m, _ = _py_attr("mesh-room-gigaam", "MODEL")
            if not m:
                return ("stt", "room-ear", "UNKNOWN", "gigaam active, model undeterminable")
            return ("stt", "room-ear", f"gigaam-{m}", "mesh-room-gigaam.service active, tool default")
        return ("stt", "room-ear", f"gigaam-{m}", "mesh-room-gigaam.service active, unit GIGAAM_MODEL")
    if tra:
        m = _unit_env("mesh-room-transcribe.service", "OH_MODEL")
        if not m:
            return ("stt", "room-ear", "UNKNOWN", "transcribe unit active, OH_MODEL unreadable")
        return ("stt", "room-ear", Path(m).name, "mesh-room-transcribe.service OH_MODEL")
    return ("stt", "room-ear", "UNKNOWN", "no transcriber unit active — the ear is deaf")


def resolve_voice_rx():
    """mesh-voice-rx picks with its own _best_model() ladder; MODEL holds the result.
    We execute the module and read MODEL — so a change to that ladder changes this row."""
    v, how = _py_funcs(
        "mesh-voice-rx", ["_model_override", "_best_model"], "print(_best_model())",
        "import os\nfrom pathlib import Path\nHOME=Path.home()\nMESH=HOME/'.mesh'\n",
    )
    if not v:
        return ("stt", "voice-rx", "UNKNOWN", how)
    name = Path(v).name
    note = how
    # Surfacing the ladder's own miss is the POINT of observing instead of declaring: the
    # ladder greps the exact name ggml-large-v3-turbo.bin, the file on disk is -q5_0, so it
    # falls to base while a bigger model sits right there unused.
    md = MESH / "whispercpp" / "models"
    if name == "ggml-base.bin" and (md / "ggml-large-v3-turbo-q5_0.bin").exists():
        note += " — LADDER MISSES large-v3-turbo-q5_0 on disk (exact-name match)"
    if not Path(v).exists():
        note += " — NAMED BUT ABSENT ON DISK"
    return ("stt", "voice-rx", name, note)


def resolve_face_recognize():
    """Vision is a two-backend decision made at CALL time (mesh-face-recognize:268
    resolve_backend: auto -> local if ollama_ready() else groq). Reporting one model name
    would be a declaration; we execute their resolver, then name the model THAT backend
    uses — and both model names are read from the tool, not repeated here."""
    src = BIN / "mesh-face-recognize"
    if not src.exists():
        return ("vision", "face-recognize", "UNKNOWN", "mesh-face-recognize not deployed")
    code = (
        "import importlib.util,importlib.machinery\n"
        f"s=importlib.util.spec_from_file_location('t',{str(src)!r},"
        f"loader=importlib.machinery.SourceFileLoader('t',{str(src)!r}))\n"
        "m=importlib.util.module_from_spec(s)\n"
        "s.loader.exec_module(m)\n"
        "b=m.resolve_backend()\n"
        "print(b)\n"
        "print(m.LOCAL_MODEL if b=='local' else (m.MODEL if b=='groq' else ''))\n"
    )
    p = _sh([sys.executable, "-c", code], env=CLEAN_ENV)
    if p.returncode != 0:
        first = (p.stderr.strip().splitlines() or ["(no stderr)"])[-1]
        return ("vision", "face-recognize", "UNKNOWN", f"resolve_backend failed: {first[:100]}")
    lines = p.stdout.strip().splitlines()
    if len(lines) < 2 or not lines[1]:
        return ("vision", "face-recognize", "UNKNOWN",
                f"backend={lines[0] if lines else '?'} — no usable model")
    backend, model = lines[0], lines[1]
    return ("vision", "face-recognize", model,
            f"mesh-face-recognize.resolve_backend() -> {backend} (executed)")


def resolve_note3_say():
    """mesh-note3-say picks with pick_voice(): MESH_PIPER_VOICE, else a ru ladder over
    ~/.local/share/piper-voices. We execute that function."""
    v, how = _sh_func("mesh-note3-say", "pick_voice")
    if not v:
        return ("tts", "note3-say", "UNKNOWN", how)
    if not Path(v).exists():
        return ("tts", "note3-say", "UNKNOWN", f"{how} -> {v}, which does not exist")
    return ("tts", "note3-say", Path(v).name, how)


RESOLVERS = [resolve_room_ear, resolve_voice_rx, resolve_face_recognize, resolve_note3_say]


def resolve_all():
    rows = []
    for fn in RESOLVERS:
        try:
            rows.append(fn())
        except Exception as e:
            # a resolver that throws yields UNKNOWN — never a default, never a crash that
            # takes the whole pane down
            rows.append(("?", fn.__name__.replace("resolve_", "").replace("_", "-"),
                         "UNKNOWN", f"resolver raised: {type(e).__name__}: {e}"))
    return rows


def run_test():
    f = 0
    rows = resolve_all()
    if len(rows) != len(RESOLVERS):
        print(f"  FAIL: {len(rows)} rows for {len(RESOLVERS)} resolvers"); f = 1
    for organ, consumer, model, how in rows:
        if not model:
            print(f"  FAIL: {consumer} produced an empty model — must be UNKNOWN, never blank"); f = 1
        if not how:
            print(f"  FAIL: {consumer} produced no provenance — every row must say HOW it knows"); f = 1
        if organ == "?":
            print(f"  FAIL: {consumer} resolver raised: {how}"); f = 1

    # THE ANTI-MAP GATE. Every row must track the LIVE system. Concretely for the room ear:
    # the unit that is actually active decides, and a literal planted where an observation
    # belongs must be NAMED. This is the gate that would have caught mesh-model-watch.
    ear = [r for r in rows if r[1] == "room-ear"]
    if not ear:
        print("  FAIL: no room-ear row"); f = 1
    else:
        ear = ear[0]
        gig, tra = _unit_active("mesh-room-gigaam.service"), _unit_active("mesh-room-transcribe.service")
        if gig and not tra and not ear[2].startswith("gigaam"):
            print(f"  FAIL: gigaam unit is ACTIVE but room-ear resolved to {ear[2]} — the map lied again"); f = 1
        if tra and not gig and ear[2].startswith("gigaam"):
            print(f"  FAIL: transcribe unit is active but room-ear resolved to gigaam"); f = 1
        if not gig and not tra and ear[2] != "UNKNOWN":
            print(f"  FAIL: NO transcriber unit is active but room-ear resolved to {ear[2]} — a default leaked in"); f = 1
        else:
            print(f"  live read ok: room-ear -> {ear[2]} ({ear[3]})")

    # THE EXECUTED-SELECTOR GATE. The whole design rests on running the CONSUMER's own
    # selector; if a selector is renamed we must go UNKNOWN, not silently substitute our
    # own idea of the ladder. Assert both: it resolves now, AND a wrong selector name
    # yields UNKNOWN rather than a plausible answer.
    # ...and it must gate THE ROW, not a private re-run of the selector. First cut of this
    # gate re-executed _best_model() under its own correct name and asserted THAT — so
    # renaming the name resolve_voice_rx() actually uses left the row UNKNOWN and the test
    # GREEN. UNKNOWN is only honest when it is a claim about the NODE; when our own probe
    # is broken it launders a regression into a capability gap. So: run the selector as an
    # INDEPENDENT CONTROL, and if the control resolves, the row must resolve and AGREE.
    pre = "import os\nfrom pathlib import Path\nHOME=Path.home()\nMESH=HOME/'.mesh'\n"
    ctrl, how = _py_funcs("mesh-voice-rx", ["_model_override", "_best_model"],
                          "print(_best_model())", pre)
    row = ([r for r in rows if r[1] == "voice-rx"] or [None])[0]
    if not row:
        print("  FAIL: no voice-rx row"); f = 1
    elif ctrl:
        if row[2] == "UNKNOWN":
            print(f"  FAIL: voice-rx's selector RESOLVES to {Path(ctrl).name} but the row says "
                  f"UNKNOWN ({row[3]}) — our probe is broken, the node is fine"); f = 1
        elif row[2] != Path(ctrl).name:
            print(f"  FAIL: row says {row[2]}, their own selector says {Path(ctrl).name}"); f = 1
        else:
            print(f"  live read ok: voice-rx -> {row[2]} (row agrees with their executed selector)")
    else:
        print(f"  n/a: voice-rx selector not executable here ({how}) — row must be UNKNOWN")
        if row[2] != "UNKNOWN":
            print(f"  FAIL: selector unreadable but row claims {row[2]} — a default leaked in"); f = 1
    bad, how = _py_funcs("mesh-voice-rx", ["_best_model_THAT_DOES_NOT_EXIST"], "print(1)", pre)
    if bad is not None:
        print(f"  FAIL: a nonexistent selector returned {bad!r} — a default leaked in"); f = 1
    elif "renamed or removed" not in how:
        print(f"  FAIL: nonexistent selector gave the wrong reason: {how}"); f = 1
    bad, how = _sh_func("mesh-note3-say", "pick_voice_NOPE")
    if bad is not None:
        print(f"  FAIL: a nonexistent shell selector returned {bad!r} — a default leaked in"); f = 1

    # THE ORACLE GATE — the only one here that can catch a WRONG answer rather than an
    # unstable or missing one. Everything above re-executes the selector the same way the
    # resolver does, so a resolver that executes it wrongly agrees with itself and passes:
    # dropping note3-say's config sourcing yields ruslan, and every other gate stays GREEN.
    # So check against an INDEPENDENT MECHANISM: trace the real tool running its real code
    # in a clean env (--test is read-only) and read the VOICE= it actually assigns. If our
    # row and the tool's own execution disagree, we are the ones who are wrong.
    row = ([r for r in rows if r[1] == "note3-say"] or [None])[0]
    p = _sh(["bash", "-x", str(BIN / "mesh-note3-say"), "--test"], env=CLEAN_ENV)
    m = re.findall(r"^\+ VOICE=(\S+)$", p.stderr, re.M)
    if not m:
        print("  n/a: could not trace mesh-note3-say's own VOICE= (organ absent?) — oracle skipped")
    elif not row:
        print("  FAIL: no note3-say row"); f = 1
    else:
        truth = Path(m[-1]).name
        if row[2] != truth:
            print(f"  FAIL: row says {row[2]} but the TOOL ITSELF loads {truth} — we executed its "
                  f"selector in the wrong environment"); f = 1
        else:
            print(f"  oracle ok: note3-say -> {truth} (matches the traced tool's own VOICE=)")

    # THE CALLER-ENV GATE. An observation that changes with who is asking is not an
    # observation. This shipped BROKEN: pick_voice() ran without mesh-note3-say's own
    # ~/.mesh/nodes sourcing, so the bare tool read ruslan while mesh-dash — which sources
    # nodes before calling — read irina off the same node, same second. The pane was right
    # by accident and the tool was wrong on its own.
    poisoned = dict(os.environ)
    poisoned["MESH_PIPER_VOICE"] = "/tmp/a-voice-that-does-not-exist.onnx"
    poisoned["MESH_WHISPER_MODEL"] = "ggml-a-model-that-does-not-exist.bin"
    saved = dict(os.environ)
    try:
        os.environ.update(poisoned)
        again = resolve_all()
    finally:
        os.environ.clear(); os.environ.update(saved)
    for a, b in zip(rows, again):
        if a[2] != b[2]:
            print(f"  FAIL: {a[1]} resolved to {a[2]!r} but {b[2]!r} under a poisoned caller env "
                  f"— the answer follows the CALLER, not the consumer"); f = 1
    if rows == again:
        print("  caller-env ok: a poisoned MESH_PIPER_VOICE/MESH_WHISPER_MODEL changed nothing")

    # NEVER PERTURB. Reading must not touch the artifacts the consumers own — the
    # test-that-writes-the-artifact trap, one step earlier. voice-rx's lock is the sharp
    # one: an import-based resolver acquires it and locks the real daemon out.
    lock, log = MESH / ".voice-rx.lock", MESH / "voice-in.log"
    before = [(p.exists(), p.stat().st_mtime if p.exists() else 0) for p in (lock, log)]
    resolve_all()
    after = [(p.exists(), p.stat().st_mtime if p.exists() else 0) for p in (lock, log)]
    if before != after:
        print(f"  FAIL: resolving PERTURBED the system — lock/log changed {before} -> {after}"); f = 1

    print("smoke-test: ok" if f == 0 else "smoke-test: FAIL")
    return f


if __name__ == "__main__":
    if sys.argv[1:2] == ["--test"]:
        sys.exit(run_test())
    rows = resolve_all()
    if "--json" in sys.argv:
        print(json.dumps([dict(zip(("organ", "consumer", "model", "how"), r)) for r in rows],
                         ensure_ascii=False))
    else:
        for organ, consumer, model, how in rows:
            print(f"{organ}\t{consumer}\t{model}\t{how}")
