#!/usr/bin/env bash
# orphan-ok: on-demand ACTUATOR — the audible half of the iMac reach, spoken only when a caller
#   explicitly asks for sound at the operator's desk. Never scheduled.
# mesh-imac-say — speak a message at the iMac (and post the accompanying notification).
#
# This is a THIN alias, not a second implementation: it execs mesh-imac-notify --say, so the
# screen-state gate, the OSA-rc/presented-bit health check and every exit code are literally the
# same code. Two names exist because the CALL SITE reads differently — `mesh-imac-say` is a caller
# declaring it wants sound — while a second copy of the gate would be a second thing to get wrong.
#
# THE AUDIO LEG IS GATE-BOUND WITH NO OVERRIDE AND IS CARRIED AS UNVERIFIED.
#   --force can relax the gate for the notification; it can NEVER relax it for sound. Audio at a
#   dark or locked desk is the startling case, so the say leg fires only with the screen unlocked,
#   the display awake, the session on console, AND output volume at or above the floor
#   (MESH_IMAC_SAY_MIN_VOL, default 20; the machine reads 56).
#   No one has yet driven sound out of this machine from the mesh — the TTS engine is listed and
#   the volume is audible, but engine-listed is not TTS-HEARD. Treat a `say=fired` as "the command
#   returned 0", never as "the operator heard it", until someone at the desk confirms once.
#
# Usage:  mesh-imac-say "text" [--voice V] [--min-volume N] [--title T] [--json]
#         mesh-imac-say --test     # delegates to mesh-imac-notify --test (one gate, one suite)
# Exit codes: identical to mesh-imac-notify (0 delivered · 2 n/a · 3 refused · 4 unconfirmed).
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
_n="$(command -v mesh-imac-notify || echo "$(dirname "$0")/mesh-imac-notify")"
[ -x "$_n" ] || { echo "mesh-imac-say: mesh-imac-notify not found — the say leg has no implementation of its own, by design" >&2; exit 2; }
case " $* " in *" --test "*) exec "$_n" --test ;; esac
exec "$_n" --say "$@"
