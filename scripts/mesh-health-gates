#!/usr/bin/env bash
# orphan-ok: invoked by mesh-land --check as an independent integration gate
# mesh-health-gates — bounded integration checks kept out of mesh-doctor's node-health path.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"

REPO="${MESH_REPO:-$HOME/lte-workstation}"
FAIL=0
UNKNOWN=0
say(){ printf 'mesh-health-gates: %s\n' "$*"; }
fail(){ FAIL=$((FAIL + 1)); say "FAIL $*"; }
unknown(){ UNKNOWN=$((UNKNOWN + 1)); say "UNKNOWN $*"; }
run_gate(){
  local name="$1" seconds="$2"; shift 2
  local out rc
  say "RUN $name timeout=${seconds}s"
  if ! command -v "$1" >/dev/null 2>&1; then unknown "$name unavailable ($1)"; return; fi
  out="$(timeout --foreground "${seconds}s" "$@" 2>&1)"; rc=$?
  case "$rc" in
    0) say "PASS $name" ;;
    124) unknown "$name timeout after ${seconds}s" ;;
    1) fail "$name: $(printf '%s' "$out" | tr '\n' ' ' | cut -c1-240)" ;;
    *) unknown "$name refused rc=$rc: $(printf '%s' "$out" | tr '\n' ' ' | cut -c1-180)" ;;
  esac
}

if [ -r "$HOME/.mesh/chat.log" ]; then
  run_gate "board-shape" 30 mesh-board-lint < <(tail -n 200 "$HOME/.mesh/chat.log")
else
  unknown "board-shape unreadable ~/.mesh/chat.log"
fi

_new_scripts="$(git -C "$REPO" ls-files --others --exclude-standard -- scripts/ 2>/dev/null | head -20)"
for _ns in $_new_scripts; do
  case "$_ns" in *.sh|mesh-*)
    run_gate "substrate:$_ns" 20 mesh-substrate-lint "$REPO/$_ns"
    run_gate "tmux:$_ns" 20 mesh-tmux-lint "$REPO/$_ns"
    run_gate "quality:$_ns" 20 mesh-test-quality-gate --tool "$REPO/$_ns"
    ;;
  esac
done

# Receipts are node-local evidence since 2026-09-16 (see mesh-evidence-dir), so `git status` no
# longer sees them. Gate the receipts written in the last day from the evidence root, and keep the
# legacy in-repo paths for anything not yet migrated. These paths are ABSOLUTE — no $REPO join.
_ev_receipts="${MESH_EVIDENCE_ROOT:-${MESH_DIR:-$HOME/.mesh}/evidence}/receipts"
_new_receipts="$( { git -C "$REPO" status --short -- task-receipts/ docs/task-receipts/ 2>/dev/null | awk '{print $2}' | sed "s|^|$REPO/|"; find "$_ev_receipts" -maxdepth 1 -type f -name '*.md' -newermt '-1 day' 2>/dev/null; } | head -20)"
for _nr in $_new_receipts; do
  [ -f "$_nr" ] || continue
  run_gate "receipt:$_nr" 20 mesh-receipt-gate "$_nr"
done

run_gate "doctrine" 30 mesh-doctrine-lint --repo "$REPO"
run_gate "pane-ownership" 120 mesh-pane-check

if [ -r "$HOME/.mesh/clear-log.jsonl" ] && [ -r "$HOME/.mesh/chat.log" ] && command -v mesh-claim-freshness >/dev/null 2>&1; then
  run_gate "claim-freshness" 30 mesh-claim-freshness --board <(tail -n 200 "$HOME/.mesh/chat.log") --clear "$HOME/.mesh/clear-log.jsonl"
else
  say "SKIP claim-freshness — clear log, board, or gate is not configured/readable"
fi

if [ -n "${MESH_DIALOG_LOG:-}" ] && [ -r "$MESH_DIALOG_LOG" ] && [ -r "$HOME/.mesh/chat.log" ]; then
  run_gate "relay" 30 mesh-relay-lint --dialog "$MESH_DIALOG_LOG" --board "$HOME/.mesh/chat.log"
else
  say "SKIP relay — dialog log or board is not configured/readable"
fi

say "summary FAIL=$FAIL UNKNOWN=$UNKNOWN"
[ "$FAIL" -eq 0 ] && [ "$UNKNOWN" -eq 0 ] || exit 1
exit 0
