#!/usr/bin/env bash
# reflex-cadence: */10 * * * *
# reflex-args: --edge
# mesh-ccp-runtime — AMD CCP/PSP security-processor runtime state sense.
#
# Reads the PCI security-processor function's driver binding and kernel runtime-PM state.
# This is a hardware-backed availability signal that the mesh did not previously publish:
# READY means a real AMD ccp/psp function is present, bound, and active; SUSPENDED means the
# same hardware is present but runtime power management has suspended it. A missing function,
# missing binding, or unreadable runtime_status is UNKNOWN (exit 2), never a fabricated READY.
#
#   mesh-ccp-runtime          one live reading
#   mesh-ccp-runtime --json   machine-readable reading
#   mesh-ccp-runtime --edge   emit only when the verdict changes
#   mesh-ccp-runtime --test   fixture parser + REAL PCI runtime-state read
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME="$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6)"
export HOME

MESH="${MESH_DIR:-$HOME/.mesh}"
ROOT="${MESH_CCP_ROOT:-/sys/bus/pci/devices}"
STATE="${MESH_CCP_STATE:-$MESH/.ccp-runtime.state}"
[ "${MESH_TEST_SANDBOX:-0}" = 1 ] && STATE="${TMPDIR:-/tmp}/.ccp-runtime.state.sandbox.$$"

read_snapshot() {
  local root="$1" d driver status count=0 active=0 suspended=0 rows=""
  shopt -s nullglob
  for d in "$root"/*; do
    [ -d "$d" ] || continue
    driver="$(readlink -f "$d/driver" 2>/dev/null || true)"
    case "${driver##*/}" in ccp|psp) ;; *) continue ;; esac
    status="$(tr -d '[:space:]' <"$d/power/runtime_status" 2>/dev/null || true)"
    case "$status" in
      active) active=$((active + 1));;
      suspended) suspended=$((suspended + 1));;
      *) continue;;
    esac
    count=$((count + 1))
    rows="${rows}${rows:+,}${d##*/}:${driver##*/}:${status}"
  done
  shopt -u nullglob
  [ "$count" -gt 0 ] || return 2
  if [ "$active" -gt 0 ] && [ "$suspended" -gt 0 ]; then
    printf 'MIXED|%s|%s|%s|%s\n' "$count" "$active" "$suspended" "$rows"
  elif [ "$active" -gt 0 ]; then
    printf 'READY|%s|%s|%s|%s\n' "$count" "$active" "$suspended" "$rows"
  else
    printf 'SUSPENDED|%s|%s|%s|%s\n' "$count" "$active" "$suspended" "$rows"
  fi
}

if [ "${1:-}" = --test ]; then
  td="$(mktemp -d)" || exit 1
  trap 'rm -rf "$td"' EXIT
  mkdir -p "$td/drivers/ccp" "$td/drivers/psp"
  mkdir -p "$td/0000:2d:00.1/power" "$td/0000:2d:00.2/power"
  ln -s "$td/drivers/ccp" "$td/0000:2d:00.1/driver"
  ln -s "$td/drivers/psp" "$td/0000:2d:00.2/driver"
  printf 'active\n' >"$td/0000:2d:00.1/power/runtime_status"
  printf 'suspended\n' >"$td/0000:2d:00.2/power/runtime_status"
  fixture="$(MESH_CCP_ROOT="$td" MESH_CCP_STATE="$td/state" MESH_DIR="$td/mesh" "$0" --json 2>/dev/null)" || {
    echo "smoke-test: FAIL (fixture read: $fixture)"; exit 1;
  }
  printf '%s\n' "$fixture" | grep -q '"verdict":"MIXED"' || { echo "smoke-test: FAIL (fixture verdict: $fixture)"; exit 1; }
  printf '%s\n' "$fixture" | grep -q '"devices":2' || { echo "smoke-test: FAIL (fixture count: $fixture)"; exit 1; }
  mkdir -p "$td/empty"
  MESH_CCP_ROOT="$td/empty" MESH_CCP_STATE="$td/empty-state" "$0" --json >/dev/null 2>&1
  rc=$?
  [ "$rc" -eq 2 ] || { echo "smoke-test: FAIL (unreachable fixture rc=$rc, want 2)"; exit 1; }
  live="$(MESH_TEST_SANDBOX=1 "$0" --json 2>/dev/null)"; lrc=$?
  if [ "$lrc" -eq 2 ]; then
    echo "smoke-test: n/a (no live ccp/psp runtime-status source)"; exit 2
  fi
  [ "$lrc" -eq 0 ] || { echo "smoke-test: FAIL (live read rc=$lrc: $live)"; exit 1; }
  printf '%s\n' "$live" | grep -Eq '"verdict":"(READY|SUSPENDED|MIXED)"' || {
    echo "smoke-test: FAIL (live verdict missing: $live)"; exit 1;
  }
  printf '%s\n' "$live" | grep -Eq '"devices":[1-9][0-9]*' || {
    echo "smoke-test: FAIL (live device count missing: $live)"; exit 1;
  }
  echo "smoke-test: ok (fixture MIXED + unreachable exit-2 + REAL CCP/PSP runtime read: $live)"
  exit 0
fi

json=0; edge=0
for arg in "$@"; do
  case "$arg" in --json) json=1;; --edge) edge=1;; esac
done
reading="$(read_snapshot "$ROOT" 2>/dev/null)" || {
  echo "mesh-ccp-runtime: UNKNOWN — no readable ccp/psp PCI runtime_status" >&2
  exit 2
}
IFS='|' read -r verdict devices active suspended rows <<<"$reading"
mkdir -p "$(dirname "$STATE")" 2>/dev/null || exit 1
previous="$(sed -n '1s/|.*//p' "$STATE" 2>/dev/null || true)"
printf '%s|devices=%s|active=%s|suspended=%s|functions=%s\n' \
  "$verdict" "$devices" "$active" "$suspended" "$rows" >"$STATE" || exit 1
mesh-state-touch "$STATE" >/dev/null 2>&1 || {
  echo "mesh-ccp-runtime: could not refresh live state" >&2; exit 1;
}
ts="$(date -u +%FT%TZ)"
if [ "$json" -eq 1 ]; then
  printf '{"verdict":"%s","devices":%s,"active":%s,"suspended":%s,"functions":"%s","ts":"%s"}\n' \
    "$verdict" "$devices" "$active" "$suspended" "$rows" "$ts"
elif [ "$edge" -eq 1 ] && [ "$previous" = "$verdict" ]; then
  exit 0
else
  printf '[ccp-runtime] %s — devices=%s active=%s suspended=%s functions=%s @ %s\n' \
    "$verdict" "$devices" "$active" "$suspended" "$rows" "$ts"
fi
