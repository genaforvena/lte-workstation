#!/usr/bin/env bash
# mesh-health — the network-change verification artifact.
# Run before AND after any substrate edit (routing, DNS, exit-node, firewall).
# A pass/fail on every online tag:lte-node is the proof that you haven't broken anything.
#
# Usage:
#   mesh-health           # check all nodes once
#   mesh-health --watch   # re-run every 10 s (live monitoring)
#   mesh-health --test    smoke test
set -euo pipefail
if [ "${1:-}" = --test ]; then
  fail=0
  command -v tailscale >/dev/null 2>&1 || { echo "  FAIL: no tailscale"; fail=1; }
  command -v ssh >/dev/null 2>&1 || { echo "  FAIL: no ssh"; fail=1; }
  command -v python3 >/dev/null 2>&1 || { echo "  FAIL: no python3"; fail=1; }
  command -v ping >/dev/null 2>&1 || { echo "  FAIL: no ping"; fail=1; }
  command -v curl >/dev/null 2>&1 || { echo "  FAIL: no curl"; fail=1; }
  # tailscale self-parse
  out="$(tailscale status --json 2>/dev/null | python3 -c 'import json,sys; d=json.load(sys.stdin); me=d.get("Self",{}); print((me.get("HostName") or "") + "|" + ((me.get("TailscaleIPs") or [""])[0]))' 2>/dev/null)" \
    || { echo "  FAIL: tailscale status parse failed"; fail=1; }
  case "$out" in
    *'|100.'*) echo "  ok: self parsed ($out)" ;;
    *) echo "  FAIL: bad self status parse: $out"; fail=1 ;;
  esac
  # dry-run check_self: verify internet probe (ping or curl to 1.1.1.1) works
  if ping -c 1 -W 3 1.1.1.1 >/dev/null 2>&1; then
    echo "  ok: internet reachable (ping 1.1.1.1)"
  elif curl -s -o /dev/null -m 6 https://1.1.1.1 2>/dev/null; then
    echo "  ok: internet reachable (curl 1.1.1.1)"
  else
    echo "  FAIL: no internet (ping+curl both failed)"; fail=1
  fi
  # dry-run check_self output format
  _host="$(hostname)"; _ip="$(tailscale ip -4 2>/dev/null || echo '?')"
  _line="$(printf 'PASS  %-32s %s (self)\n' "$_host" "$_ip")"
  printf '%s' "$_line" | grep -qE '^PASS  .+  (100\.|\[?[0-9a-f:]+).+\(self\)$' \
    && echo "  ok: check_self output format valid" \
    || { echo "  FAIL: check_self format unexpected ($_line)"; fail=1; }
  # node list parse dry-run: verify tailscale peer JSON gives the expected structure
  _ncount="$(tailscale status --json 2>/dev/null | python3 -c 'import json,sys; d=json.load(sys.stdin); print(sum(1 for p in d.get("Peer",{}).values() if "tag:lte-node" in (p.get("Tags") or [])))' 2>/dev/null || echo 0)"
  echo "  ok: $(hostname) sees $_ncount tag:lte-node peer(s)"
  # live=reachable: the off-tailnet LAN-fallback primitives (operator 2026-06-19)
  if ping -c 1 -W 2 127.0.0.1 >/dev/null 2>&1; then
    echo "  ok: LAN-fallback ping primitive works (live=reachable, not tailscale-only)"
  else
    echo "  FAIL: LAN-fallback ping primitive broken"; fail=1
  fi
  _t=""
  for e in "GL-MT3000:192.168.8.1" "Redmi:192.168.8.9"; do
    if [ "${e%%:*}" = "GL-MT3000" ]; then _t="${e#*:}"; fi
  done
  [ "$_t" = "192.168.8.1" ] && echo "  ok: MESH_LAN_FALLBACK Host:ip parse" || { echo "  FAIL: fallback parse ($_t)"; fail=1; }
  [ "$fail" = 0 ] && echo "smoke-test: ok" && exit 0 || { echo "smoke-test: FAIL"; exit 1; }
fi
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes"

SSH=(-o StrictHostKeyChecking=no -o ConnectTimeout=8 -o BatchMode=yes -o LogLevel=ERROR)

# live = REACHABLE, not merely tailscale-online (operator 2026-06-19: "live means reachable, not
# only tailscale. we are moving away from tailscale, but gradually"). A node whose tailscaled is
# down is NOT dead if it still answers on a node-local LAN path — branding it OFFLINE is a
# false-dead signal. The genome stays IP-free: candidate LAN IPs come from node-local config
# (MESH_LAN_FALLBACK="Host:lan-ip ..." and, for the phone body, PHONE_LAN_IPS).
lan_fallback_ips(){
    local host="$1" entry
    for entry in ${MESH_LAN_FALLBACK:-}; do
        [ "${entry%%:*}" = "$host" ] || continue
        printf '%s\n' "${entry#*:}"
    done
}
reachable_off_tailnet(){
    # echo the first candidate LAN ip that answers a fast ping; non-zero if none do
    local ip
    for ip in "$@"; do
        [ -n "$ip" ] || continue
        ping -c 1 -W 2 "$ip" >/dev/null 2>&1 && { printf '%s\n' "$ip"; return 0; }
    done
    return 1
}

ssh_user_for(){
    local ip="$1" default_user="${2:-$(whoami)}"
    local entry
    for entry in ${MESH_NODES:-}; do
        local label="${entry%%:*}" userhost="${entry#*:}"
        [ "${userhost#*@}" = "$ip" ] || continue
        printf '%s\n' "${userhost%%@*}"
        return 0
    done
    printf '%s\n' "$default_user"
}

check_self() {
    local ip
    ip=$(tailscale ip -4 2>/dev/null || echo '?')
    # robust internet probe: a SINGLE ping (-c 1) false-FAILs on one dropped packet, and ICMP is
    # often deprioritized while TCP/HTTP works (ds: curl 301 OK but ping flaked → false [health-fail]
    # for a node running the operator's foxible, 2026-06-12). 2 packets OR a TCP/HTTPS fallback; FAIL
    # only if both miss.
    if ping -c 2 -W 3 1.1.1.1 >/dev/null 2>&1 || curl -s -o /dev/null -m 6 https://1.1.1.1 2>/dev/null; then
        printf 'PASS  %-32s %s (self)\n' "$(hostname)" "$ip"
    else
        printf 'FAIL  %-32s %s (self) — no internet\n' "$(hostname)" "$ip"
    fi
}

check_linux() {
    local host="$1" ip="$2"
    local r user
    user=$(ssh_user_for "$ip" "${SSH_USER:-$(whoami)}")
    r=$(ssh "${SSH[@]}" "${user}@$ip" 'ping -c 2 -W 3 1.1.1.1 >/dev/null 2>&1 || curl -s -o /dev/null -m 6 https://1.1.1.1 2>/dev/null && echo ok || echo fail' </dev/null 2>/dev/null) \
        || r=unreachable
    case "$r" in
        ok)          printf 'PASS  %-32s %s\n' "$host" "$ip" ;;
        fail)        printf 'FAIL  %-32s %s — no internet\n' "$host" "$ip" ;;
        unreachable) printf 'SKIP  %-32s %s — SSH unreachable\n' "$host" "$ip" ;;
    esac
}

check_android() {
    local host="$1" ip="$2"
    local r
    r=$(ssh "${SSH[@]}" -p "${PHONE_SSH_PORT:-8022}" "${PHONE_USER:-u0_a380}@$ip" 'ping -c 2 1.1.1.1 >/dev/null 2>&1 || curl -s -o /dev/null -m 6 https://1.1.1.1 2>/dev/null && echo ok || echo fail' </dev/null 2>/dev/null) \
        || r=unreachable
    case "$r" in
        ok)          printf 'PASS  %-32s %s (android)\n' "$host" "$ip" ;;
        fail)        printf 'FAIL  %-32s %s (android) — no internet\n' "$host" "$ip" ;;
        unreachable) printf 'SKIP  %-32s %s (android) — SSH unreachable\n' "$host" "$ip" ;;
    esac
}

run_once() {
    echo "=== mesh-health $(date -u +%Y-%m-%dT%H:%M:%SZ) ==="
    check_self

    # Output: tab-separated os|host|ip|online to handle hostnames with spaces
    set +o pipefail  # read exits 1 at EOF, don't kill the pipeline
    tailscale status --json | python3 -c "
import json, sys
d = json.load(sys.stdin)
peers = {}
for p in d.get('Peer', {}).values():
    if 'tag:lte-node' in (p.get('Tags') or []):
        host = p.get('HostName', '?')
        score = (bool(p.get('Online')), bool(p.get('Active')))
        if host not in peers or score > peers[host][0]:
            peers[host] = (score, p)
for host, (_, p) in sorted(peers.items()):
    os_ = p.get('OS', 'linux')
    ip = p['TailscaleIPs'][0]
    online = p.get('Online', False)
    print(f'{os_}\t{host}\t{ip}\t{online}')
" | while IFS=$'\t' read -r os host ip online; do
        if [[ "$online" != "True" ]]; then
            # tailscale says offline — but live = reachable. Try a node-local LAN path before
            # declaring it dead. Phone body also gets its PHONE_LAN_IPS candidates.
            cand=$(lan_fallback_ips "$host")
            if [[ "$os" == "android" || "$host" == Redmi* ]]; then
                cand="$cand ${PHONE_LAN_IPS:-}"
            fi
            if lanip=$(reachable_off_tailnet $cand); then
                printf 'LAN   %-32s %s — reachable off-tailnet (tailscaled down)\n' "$host" "$lanip"
            else
                printf 'OFFLINE %-32s %s\n' "$host" "$ip"
            fi
            continue
        fi
        if [[ "$os" == "android" ]]; then
            check_android "$host" "$ip"
        else
            check_linux "$host" "$ip"
        fi
    done
    set -o pipefail
    echo ""
}

if [[ "${1:-}" == "--watch" ]]; then
    while true; do run_once; sleep 10; done
else
    run_once
fi
