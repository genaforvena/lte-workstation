#!/usr/bin/env bash
# mesh-health — the network-change verification artifact.
# Run before AND after any substrate edit (routing, DNS, exit-node, firewall).
# A pass/fail on every online tag:lte-node is the proof that you haven't broken anything.
#
# Usage:
#   mesh-health           # check all nodes once
#   mesh-health --watch   # re-run every 10 s (live monitoring)
set -euo pipefail

SSH=(-o StrictHostKeyChecking=no -o ConnectTimeout=8 -o BatchMode=yes -o LogLevel=ERROR)

check_self() {
    local ip
    ip=$(tailscale ip -4 2>/dev/null || echo '?')
    if ping -c 1 -W 3 1.1.1.1 >/dev/null 2>&1; then
        printf 'PASS  %-32s %s (self)\n' "$(hostname)" "$ip"
    else
        printf 'FAIL  %-32s %s (self) — no internet\n' "$(hostname)" "$ip"
    fi
}

check_linux() {
    local host="$1" ip="$2"
    local r
    r=$(ssh "${SSH[@]}" "imozerov@$ip" 'ping -c 1 -W 3 1.1.1.1 >/dev/null 2>&1 && echo ok || echo fail' 2>/dev/null) \
        || r=unreachable
    case "$r" in
        ok)          printf 'PASS  %-32s %s\n' "$host" "$ip" ;;
        fail)        printf 'FAIL  %-32s %s — no internet\n' "$host" "$ip" ;;
        unreachable) printf 'SKIP  %-32s %s — SSH unreachable\n' "$host" "$ip" ;;
    esac
}

check_android() {
    local host="$1" ip="$2"
    local r
    r=$(ssh "${SSH[@]}" -p 8022 "u0_a386@$ip" 'ping -c 1 1.1.1.1 >/dev/null 2>&1 && echo ok || echo fail' 2>/dev/null) \
        || r=unreachable
    case "$r" in
        ok)          printf 'PASS  %-32s %s (android)\n' "$host" "$ip" ;;
        fail)        printf 'FAIL  %-32s %s (android) — no internet\n' "$host" "$ip" ;;
        unreachable) printf 'SKIP  %-32s %s (android) — SSH unreachable\n' "$host" "$ip" ;;
    esac
}

run_once() {
    echo "=== mesh-health $(date -u +%Y-%m-%dT%H:%M:%SZ) ==="
    check_self

    # Output: tab-separated os|host|ip|online to handle hostnames with spaces
    tailscale status --json | python3 -c "
import json, sys
d = json.load(sys.stdin)
for p in d.get('Peer', {}).values():
    if 'tag:lte-node' in (p.get('Tags') or []):
        os_ = p.get('OS', 'linux')
        host = p.get('HostName', '?')
        ip = p['TailscaleIPs'][0]
        online = p.get('Online', False)
        print(f'{os_}\t{host}\t{ip}\t{online}')
" | while IFS=$'\t' read -r os host ip online; do
        if [[ "$online" != "True" ]]; then
            printf 'OFFLINE %-32s %s\n' "$host" "$ip"
            continue
        fi
        if [[ "$os" == "android" ]]; then
            check_android "$host" "$ip"
        else
            check_linux "$host" "$ip"
        fi
    done
    echo ""
}

if [[ "${1:-}" == "--watch" ]]; then
    while true; do run_once; sleep 10; done
else
    run_once
fi
