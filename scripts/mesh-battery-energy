#!/usr/bin/env bash
# reflex-cadence: */13 * * * *
# mesh-battery-energy — raw battery energy reservoir sense.
#
# WHY THIS IS NEW: mesh-battery reports battery capacity/health, mesh-battery-voltage reports
# voltage, and mesh-node-power derives energy_remaining internally. Nothing exposes the raw
# kernel reservoir signal as its own first-class sense. This tool reads the direct remaining
# energy/charge source so the mesh can see the battery's actual stored energy as a live input.
#
# Honest contract: no readable energy_now/charge_now source -> exit 2, never a fabricated reading.
#
#   mesh-battery-energy          one-line state
#   mesh-battery-energy --json   machine-readable JSON
#   mesh-battery-energy --test   smoke test (fixtures + live reachability gate)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

# MESH_TEST_SANDBOX=1 diverts BOTH live artifacts to throwaways — pre-fix, --test's three synthetic-
# fixture "$0" invokes stamped ~/.mesh/.battery-energy-state with forged MID/Charging verdicts (and a
# batteryless run would drop the real OFFLINEFILE). Task test-live-writes 2026-07-20, bruno-forgery class.
STATE="$HOME/.mesh/.battery-energy-state"
OFFLINEFILE="$HOME/.mesh/.battery-energy-offline"
if [ "${MESH_TEST_SANDBOX:-0}" = 1 ]; then
  STATE="${TMPDIR:-/tmp}/.battery-energy-state.sandbox.$$"
  OFFLINEFILE="${TMPDIR:-/tmp}/.battery-energy-offline.sandbox.$$"
fi
PS_DIR="${MESH_POWER_SUPPLY_DIR:-/sys/class/power_supply}"

read_trim() { cat "$1" 2>/dev/null | tr -d '\n' || true; }

discover_battery() {
  local d
  for d in "$PS_DIR"/*/; do
    [ -d "$d" ] || continue
    [ "$(read_trim "${d}type")" = Battery ] || continue
    [ -r "${d}energy_now" ] || [ -r "${d}charge_now" ] || continue
    printf '%s' "${d%/}"
    return 0
  done
  return 1
}

classify_pct() {
  local pct="${1:-}"
  case "$pct" in
    ''|*[!0-9.]* ) echo UNKNOWN; return ;;
  esac
  awk -v p="$pct" 'BEGIN{
    if (p >= 80) print "HIGH";
    else if (p >= 40) print "MID";
    else if (p >= 15) print "LOW";
    else print "CRITICAL";
  }'
}

format_wh() {
  awk -v u="${1:-}" 'BEGIN{ if (u=="" || u !~ /^[0-9]+$/) exit 1; printf "%.2f", u/1000000 }'
}

if [ "${1:-}" = --test ]; then
  fail=0
  # TEST-SANDBOX (task test-live-writes 2026-07-20): sandbox every self-invoke's state/offline write.
  export MESH_TEST_SANDBOX=1
  _live_state="$HOME/.mesh/.battery-energy-state"
  _live_off="$HOME/.mesh/.battery-energy-offline"
  _live_sig="$(stat -c '%Y %s' "$_live_state" 2>/dev/null || echo absent);$(stat -c '%Y %s' "$_live_off" 2>/dev/null || echo absent)"
  [ "$(classify_pct 85)" = HIGH ] || { echo "  FAIL HIGH boundary"; fail=1; }
  [ "$(classify_pct 50)" = MID ] || { echo "  FAIL MID boundary"; fail=1; }
  [ "$(classify_pct 20)" = LOW ] || { echo "  FAIL LOW boundary"; fail=1; }
  [ "$(classify_pct 10)" = CRITICAL ] || { echo "  FAIL CRITICAL boundary"; fail=1; }
  [ "$(classify_pct abc)" = UNKNOWN ] || { echo "  FAIL UNKNOWN boundary"; fail=1; }

  td="$(mktemp -d)"
  trap 'rm -rf "$td"' EXIT
  mkdir -p "$td/BAT0"
  printf 'Battery\n' > "$td/BAT0/type"
  printf '20820000\n' > "$td/BAT0/energy_now"
  printf '35300000\n' > "$td/BAT0/energy_full_design"
  printf 'Discharging\n' > "$td/BAT0/status"
  got="$(MESH_POWER_SUPPLY_DIR="$td" bash "$0" 2>/dev/null || true)"
  printf '%s\n' "$got" | grep -q '\[battery-energy\]' || { echo "  FAIL live fixture output"; fail=1; }
  printf '%s\n' "$got" | grep -q 'source=.*/energy_now' || { echo "  FAIL live fixture source selection"; fail=1; }
  printf '%s\n' "$got" | grep -q 'MID' || { echo "  FAIL live fixture band"; fail=1; }

  mkdir -p "$td/BAT1"
  printf 'Battery\n' > "$td/BAT1/type"
  printf '7710000\n' > "$td/BAT1/charge_now"
  printf '18000000\n' > "$td/BAT1/charge_full_design"
  printf '8465000\n' > "$td/BAT1/voltage_now"
  printf 'Charging\n' > "$td/BAT1/status"
  got2="$(MESH_POWER_SUPPLY_DIR="$td" bash "$0" 2>/dev/null || true)"
  printf '%s\n' "$got2" | grep -q 'source=.*/energy_now\|source=.*/charge_now' || { echo "  FAIL fallback source selection"; fail=1; }
  td2="$(mktemp -d)"
  mkdir -p "$td2/BAT0"
  printf 'Battery\n' > "$td2/BAT0/type"
  printf '7710000\n' > "$td2/BAT0/charge_now"
  printf '18000000\n' > "$td2/BAT0/charge_full_design"
  printf '8465000\n' > "$td2/BAT0/voltage_now"
  printf 'Charging\n' > "$td2/BAT0/status"
  got3="$(MESH_POWER_SUPPLY_DIR="$td2" bash "$0" 2>/dev/null || true)"
  printf '%s\n' "$got3" | grep -q 'source=.*/charge_now' || { echo "  FAIL charge_now fallback"; fail=1; }
  rm -rf "$td2"

  # sandbox honesty gate — before BOTH exits, so it fires on batteryless nodes too. Falsify: drop
  # the MESH_TEST_SANDBOX diversion at the STATE/OFFLINEFILE assignment → the fixture invokes move it.
  _live_sig2="$(stat -c '%Y %s' "$_live_state" 2>/dev/null || echo absent);$(stat -c '%Y %s' "$_live_off" 2>/dev/null || echo absent)"
  [ "$_live_sig2" = "$_live_sig" ] || { echo "smoke-test: FAIL (--test stamped a LIVE artifact: '$_live_sig' → '$_live_sig2')"; exit 1; }
  bat="$(discover_battery 2>/dev/null || true)"
  [ -n "$bat" ] || { echo "smoke-test: n/a (no readable battery energy source on this node); classify-logic ok"; exit 2; }
  [ -r "$bat/energy_now" ] || [ -r "$bat/charge_now" ] || { echo "smoke-test: FAIL (battery path lost energy/charge source: $bat)"; exit 1; }
  echo "smoke-test: ok (classify + fixture read + live reservoir source exists)"
  exit 0
fi

JSON=0
[ "${1:-}" = --json ] && JSON=1

bat="$(discover_battery 2>/dev/null || true)"
[ -n "$bat" ] || {
  [ -f "$OFFLINEFILE" ] || { echo "battery-energy: UNREACHABLE — no readable battery reservoir source" >&2; : > "$OFFLINEFILE"; }
  exit 2
}
rm -f "$OFFLINEFILE" 2>/dev/null || true

source_path=""
raw=""
raw_unit=""
design=""
status=""
capacity=""
voltage_now=""

if [ -r "$bat/energy_now" ]; then
  source_path="$bat/energy_now"
  raw_unit="uWh"
  raw="$(read_trim "$source_path")"
  [ -r "$bat/energy_full_design" ] && design="$(read_trim "$bat/energy_full_design")"
elif [ -r "$bat/charge_now" ]; then
  source_path="$bat/charge_now"
  raw_unit="uAh"
  raw="$(read_trim "$source_path")"
  [ -r "$bat/charge_full_design" ] && design="$(read_trim "$bat/charge_full_design")"
  [ -r "$bat/voltage_now" ] && voltage_now="$(read_trim "$bat/voltage_now")"
else
  [ -f "$OFFLINEFILE" ] || { echo "battery-energy: UNREACHABLE — reservoir source unreadable" >&2; : > "$OFFLINEFILE"; }
  exit 2
fi

[ -n "$raw" ] || { echo "battery-energy: UNREACHABLE — empty reservoir read" >&2; exit 2; }
[ -r "$bat/status" ] && status="$(read_trim "$bat/status")"
[ -r "$bat/capacity" ] && capacity="$(read_trim "$bat/capacity")"

pct=""
if [ -n "$design" ] && [ "${design:-0}" -gt 0 ] 2>/dev/null; then
  pct="$(awk -v r="$raw" -v d="$design" 'BEGIN{ printf "%.0f", (r * 100) / d }')"
elif [ -n "$capacity" ] && [ "$capacity" -ge 0 ] 2>/dev/null; then
  pct="$capacity"
fi

band="$(classify_pct "$pct")"
if [ "$raw_unit" = uWh ]; then
  wh="$(format_wh "$raw")" || { echo "battery-energy: UNREACHABLE — invalid reservoir '$raw'" >&2; exit 2; }
else
  [ -n "$voltage_now" ] || { echo "battery-energy: UNREACHABLE — charge_now without voltage_now" >&2; exit 2; }
  wh="$(awk -v c="$raw" -v v="$voltage_now" 'BEGIN{ if(c=="" || v=="" || c !~ /^[0-9]+$/ || v !~ /^[0-9]+$/) exit 1; printf "%.2f", (c * v) / 1000000000000 }')" \
    || { echo "battery-energy: UNREACHABLE — invalid charge_now/voltage_now pair" >&2; exit 2; }
fi
ts="$(date -u +%FT%TZ)"
reason="raw reservoir source=${source_path} status=${status:-unknown}"

printf '%s|source=%s|raw=%s|pct=%s|status=%s|%s\n' \
  "$band" "$source_path" "$raw" "${pct:-unknown}" "${status:-unknown}" "$reason" > "$STATE"

if [ "$JSON" = 1 ]; then
  printf '{"band":"%s","source":"%s","raw":%s,"raw_wh":%s,"pct":%s,"status":"%s","capacity":%s,"ts":"%s"}\n' \
    "$band" "$source_path" "$raw" "$wh" "${pct:-null}" "${status:-unknown}" "${capacity:-null}" "$ts"
  exit 0
fi

printf '[battery-energy] %s — %sWh remaining (%s%% of design) source=%s status=%s\n' \
  "$band" "$wh" "${pct:-unknown}" "$source_path" "${status:-unknown}"
