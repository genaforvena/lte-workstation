#!/usr/bin/env bash
# reflex-cadence: */13 * * * *
# mesh-battery-energy — raw battery energy reservoir sense.
#
# WHY THIS IS NEW: mesh-battery reports battery capacity/health, mesh-battery-voltage reports
# voltage, and mesh-node-power derives energy_remaining internally. Nothing exposes the raw
# kernel reservoir signal as its own first-class sense. This tool reads the direct remaining
# energy/charge source so the mesh can see the battery's actual stored energy as a live input.
#
# Honest contract: no readable energy_now/charge_now source -> exit 2, never a fabricated reading.
#
# PIII5 (Perez Rios TOP, restated in Systems 13(9):749, 2025-08-29) — "communication channels
# incomplete ... the same will happen if the design and choice of the SENSORS at the emission points
# ... are inadequate." This sense used to emit `pct` under TWO different denominators depending on
# which sysfs file happened to exist -- raw/energy_full_design (Beer's A/P, wear-CONTAMINATED) or the
# kernel `capacity` attribute (A/C, wear-FREE) -- with nothing in the output naming which. On a cell
# at 60% health the two disagree by exactly the wear factor and the A/P path can NEVER emit HIGH:
# the top band is structurally unreachable, so the algedonic alarm fires early and silently. The fix
# is the missing TRANSDUCER, not a new threshold: read capability (energy_full/charge_full), band on
# actuality/capability, publish A/P and C/P as their own fields, and NAME the reference in every
# rendering (`ref=`) so a bare number can never cross the boundary again.
#
#   mesh-battery-energy          one-line state
#   mesh-battery-energy --json   machine-readable JSON
#   mesh-battery-energy --test   smoke test (fixtures + live reachability gate)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

# MESH_TEST_SANDBOX=1 diverts BOTH live artifacts to throwaways — pre-fix, --test's three synthetic-
# fixture "$0" invokes stamped ~/.mesh/.battery-energy-state with forged MID/Charging verdicts (and a
# batteryless run would drop the real OFFLINEFILE). Task test-live-writes 2026-07-20, bruno-forgery class.
STATE="$HOME/.mesh/.battery-energy-state"
OFFLINEFILE="$HOME/.mesh/.battery-energy-offline"
if [ "${MESH_TEST_SANDBOX:-0}" = 1 ]; then
  STATE="${TMPDIR:-/tmp}/.battery-energy-state.sandbox.$$"
  OFFLINEFILE="${TMPDIR:-/tmp}/.battery-energy-offline.sandbox.$$"
fi
PS_DIR="${MESH_POWER_SUPPLY_DIR:-/sys/class/power_supply}"

read_trim() { cat "$1" 2>/dev/null | tr -d '\n' || true; }

discover_battery() {
  local d
  for d in "$PS_DIR"/*/; do
    [ -d "$d" ] || continue
    [ "$(read_trim "${d}type")" = Battery ] || continue
    [ -r "${d}energy_now" ] || [ -r "${d}charge_now" ] || continue
    printf '%s' "${d%/}"
    return 0
  done
  return 1
}

classify_pct() {
  local pct="${1:-}"
  case "$pct" in
    ''|*[!0-9.]* ) echo UNKNOWN; return ;;
  esac
  awk -v p="$pct" 'BEGIN{
    if (p >= 80) print "HIGH";
    else if (p >= 40) print "MID";
    else if (p >= 15) print "LOW";
    else print "CRITICAL";
  }'
}

format_wh() {
  awk -v u="${1:-}" 'BEGIN{ if (u=="" || u !~ /^[0-9]+$/) exit 1; printf "%.2f", u/1000000 }'
}

# Beer's index triple at the emission point: actuality (A, *_now), capability (C, *_full — what this
# cell can hold TODAY), potentiality (P, *_full_design — what it could hold new). pct_of A C = A/C
# (productivity, the reserve actually drawable); pct_of A P = A/P (performance); pct_of C P = C/P
# (the wear axis). Every caller must carry the reference forward — see PIII5 note in the header.
pct_of() {
  awk -v n="${1:-}" -v d="${2:-}" 'BEGIN{
    if (n=="" || d=="" || n !~ /^[0-9]+$/ || d !~ /^[0-9]+$/ || d+0 <= 0) exit 1
    printf "%.0f", (n*100)/d
  }'
}

if [ "${1:-}" = --test ]; then
  # tmp fence — task:doctor-test-tmpdir-cleanup-traps. Re-exec the smoke test ONCE under a private
  # TMPDIR and remove it from the PARENT, so the cleanup cannot be lost to the test's own `exit 1`
  # and cannot be clobbered by an EXIT trap the test sets for itself. A nested --test inherits the
  # guard var and skips its own fence (it is already inside one).
  if [ -z "${MESH_TEST_TMPD:-}" ]; then
    MESH_TEST_TMPD="$(mktemp -d)" || { echo "smoke-test: FAIL (tmp fence: mktemp -d)"; exit 1; }
    trap 'rm -rf "$MESH_TEST_TMPD"' EXIT INT HUP TERM
    export MESH_TEST_TMPD TMPDIR="$MESH_TEST_TMPD" TMP="$MESH_TEST_TMPD" TEMP="$MESH_TEST_TMPD"
    _fence_rc=0; "$0" "$@" || _fence_rc=$?; exit "$_fence_rc"
  fi
  fail=0
  # TEST-SANDBOX (task test-live-writes 2026-07-20): sandbox every self-invoke's state/offline write.
  export MESH_TEST_SANDBOX=1
  _live_state="$HOME/.mesh/.battery-energy-state"
  _live_off="$HOME/.mesh/.battery-energy-offline"
  _live_sig="$(stat -c '%Y %s' "$_live_state" 2>/dev/null || echo absent);$(stat -c '%Y %s' "$_live_off" 2>/dev/null || echo absent)"
  [ "$(classify_pct 85)" = HIGH ] || { echo "  FAIL HIGH boundary"; fail=1; }
  [ "$(classify_pct 50)" = MID ] || { echo "  FAIL MID boundary"; fail=1; }
  [ "$(classify_pct 20)" = LOW ] || { echo "  FAIL LOW boundary"; fail=1; }
  [ "$(classify_pct 10)" = CRITICAL ] || { echo "  FAIL CRITICAL boundary"; fail=1; }
  [ "$(classify_pct abc)" = UNKNOWN ] || { echo "  FAIL UNKNOWN boundary"; fail=1; }

  td="$(mktemp -d)"
  trap 'rm -rf "$td"' EXIT
  mkdir -p "$td/BAT0"
  printf 'Battery\n' > "$td/BAT0/type"
  printf '20820000\n' > "$td/BAT0/energy_now"
  printf '35300000\n' > "$td/BAT0/energy_full_design"
  printf 'Discharging\n' > "$td/BAT0/status"
  got="$(MESH_POWER_SUPPLY_DIR="$td" bash "$0" 2>/dev/null || true)"
  printf '%s\n' "$got" | grep -q '\[battery-energy\]' || { echo "  FAIL live fixture output"; fail=1; }
  printf '%s\n' "$got" | grep -q 'source=.*/energy_now' || { echo "  FAIL live fixture source selection"; fail=1; }
  printf '%s\n' "$got" | grep -q 'MID' || { echo "  FAIL live fixture band"; fail=1; }

  mkdir -p "$td/BAT1"
  printf 'Battery\n' > "$td/BAT1/type"
  printf '7710000\n' > "$td/BAT1/charge_now"
  printf '18000000\n' > "$td/BAT1/charge_full_design"
  printf '8465000\n' > "$td/BAT1/voltage_now"
  printf 'Charging\n' > "$td/BAT1/status"
  got2="$(MESH_POWER_SUPPLY_DIR="$td" bash "$0" 2>/dev/null || true)"
  printf '%s\n' "$got2" | grep -q 'source=.*/energy_now\|source=.*/charge_now' || { echo "  FAIL fallback source selection"; fail=1; }
  td2="$(mktemp -d)"
  mkdir -p "$td2/BAT0"
  printf 'Battery\n' > "$td2/BAT0/type"
  printf '7710000\n' > "$td2/BAT0/charge_now"
  printf '18000000\n' > "$td2/BAT0/charge_full_design"
  printf '8465000\n' > "$td2/BAT0/voltage_now"
  printf 'Charging\n' > "$td2/BAT0/status"
  got3="$(MESH_POWER_SUPPLY_DIR="$td2" bash "$0" 2>/dev/null || true)"
  printf '%s\n' "$got3" | grep -q 'source=.*/charge_now' || { echo "  FAIL charge_now fallback"; fail=1; }
  rm -rf "$td2"

  # --- PIII5 transducer legs (2026-08-25 review). Each one is RED against the pre-fix tool. ---
  # (a) A WORN cell exposing BOTH energy_full and energy_full_design. A/C = 17.0/20.0 = 85 (HIGH);
  #     A/P = 17.0/35.3 = 48 (MID). Pre-fix the design branch was taken FIRST and emitted 48 as
  #     `pct` with no reference named, so the band was MID and HIGH was unreachable on this cell.
  td3="$(mktemp -d)"
  mkdir -p "$td3/BAT0"
  printf 'Battery\n' > "$td3/BAT0/type"
  printf '17000000\n' > "$td3/BAT0/energy_now"
  printf '20000000\n' > "$td3/BAT0/energy_full"
  printf '35300000\n' > "$td3/BAT0/energy_full_design"
  printf 'Discharging\n' > "$td3/BAT0/status"
  got4="$(MESH_POWER_SUPPLY_DIR="$td3" bash "$0" 2>/dev/null || true)"
  printf '%s\n' "$got4" | grep -q '^\[battery-energy\] HIGH ' || { echo "  FAIL worn-cell band is not A/C-referenced (got: $got4)"; fail=1; }
  printf '%s\n' "$got4" | grep -q '85% ref=full' || { echo "  FAIL worn-cell pct/ref (got: $got4)"; fail=1; }
  printf '%s\n' "$got4" | grep -q 'wear=57%' || { echo "  FAIL wear axis C/P not published (got: $got4)"; fail=1; }
  j4="$(MESH_POWER_SUPPLY_DIR="$td3" bash "$0" --json 2>/dev/null || true)"
  echo "$j4" | jq -e '.pct_ref=="full" and .pct_capability==85 and .pct_design==48 and .wear_pct==57' >/dev/null 2>&1 \
    || { echo "  FAIL json triple A/C, A/P, C/P (got: $j4)"; fail=1; }
  rm -rf "$td3"

  # (b) design ONLY — the A/P fallback is legitimate but is a DIFFERENT quantity, so it must be
  #     labelled, never emitted bare. Falsify: drop band_note / the ref= field and this goes red.
  td4="$(mktemp -d)"
  mkdir -p "$td4/BAT0"
  printf 'Battery\n' > "$td4/BAT0/type"
  printf '17000000\n' > "$td4/BAT0/energy_now"
  printf '35300000\n' > "$td4/BAT0/energy_full_design"
  printf 'Discharging\n' > "$td4/BAT0/status"
  got5="$(MESH_POWER_SUPPLY_DIR="$td4" bash "$0" 2>/dev/null || true)"
  printf '%s\n' "$got5" | grep -q 'ref=design' || { echo "  FAIL design-only reference not named (got: $got5)"; fail=1; }
  printf '%s\n' "$got5" | grep -q 'note=design-referenced' || { echo "  FAIL design-referenced band carries no wear-contamination note (got: $got5)"; fail=1; }
  printf '%s\n' "$got5" | grep -q 'wear=na' || { echo "  FAIL wear must render na, never 0, with no capability read (got: $got5)"; fail=1; }
  rm -rf "$td4"

  # (c) kernel `capacity` attribute present ALONGSIDE design. capacity is A/C — the same quantity as
  #     pct_cap by a second transducer — so it must BEAT the design branch. Pre-fix, design won and
  #     the two A/C-vs-A/P readings were indistinguishable in the output.
  td5="$(mktemp -d)"
  mkdir -p "$td5/BAT0"
  printf 'Battery\n' > "$td5/BAT0/type"
  printf '17000000\n' > "$td5/BAT0/energy_now"
  printf '35300000\n' > "$td5/BAT0/energy_full_design"
  printf '85\n' > "$td5/BAT0/capacity"
  printf 'Discharging\n' > "$td5/BAT0/status"
  got6="$(MESH_POWER_SUPPLY_DIR="$td5" bash "$0" 2>/dev/null || true)"
  printf '%s\n' "$got6" | grep -q '85% ref=capacity-attr' || { echo "  FAIL capacity-attr must outrank the design denominator (got: $got6)"; fail=1; }
  printf '%s\n' "$got6" | grep -q '^\[battery-energy\] HIGH ' || { echo "  FAIL capacity-attr band (got: $got6)"; fail=1; }
  rm -rf "$td5"

  # (d) NO rendering may emit a bare pct. Every live path names its reference — human line, STATE
  #     row and JSON alike; the STATE row is where a later reader would otherwise inherit the
  #     unlabelled number.
  td6="$(mktemp -d)"
  mkdir -p "$td6/BAT0"
  printf 'Battery\n' > "$td6/BAT0/type"
  printf '17000000\n' > "$td6/BAT0/energy_now"
  printf '20000000\n' > "$td6/BAT0/energy_full"
  printf 'Discharging\n' > "$td6/BAT0/status"
  # the child sandboxes STATE under its own $$, so hand it a private TMPDIR and read what it wrote
  _sd="$(mktemp -d)"
  MESH_POWER_SUPPLY_DIR="$td6" TMPDIR="$_sd" bash "$0" >/dev/null 2>&1 || true
  _srow="$(cat "$_sd"/.battery-energy-state.sandbox.* 2>/dev/null || true)"
  printf '%s\n' "$_srow" | grep -q 'pct=85|ref=full|wear=na' \
    || { echo "  FAIL STATE row does not carry the reference (got: $_srow)"; fail=1; }
  rm -rf "$td6" "$_sd"

  # sandbox honesty gate — before BOTH exits, so it fires on batteryless nodes too. Falsify: drop
  # the MESH_TEST_SANDBOX diversion at the STATE/OFFLINEFILE assignment → the fixture invokes move it.
  _live_sig2="$(stat -c '%Y %s' "$_live_state" 2>/dev/null || echo absent);$(stat -c '%Y %s' "$_live_off" 2>/dev/null || echo absent)"
  if [ "$_live_sig2" != "$_live_sig" ]; then
    # HONESTY-GATE ATTRIBUTION (memory a-sandbox-honesty-gate-cannot-separate-a-leak-from-a-collision):
    # a moved live artifact has TWO causes and ONE sample cannot separate them — a leaking sandbox,
    # or a CONCURRENT live writer (this reflex's own cron tick, or any other tool that writes the
    # same path) stamping it inside the test window. The single-sample form blamed the test and went
    # red with nothing wrong (mesh-node-health 2026-08-15, mesh-sound-reflex c5779d6); mesh-land and
    # mesh-doctor both consume this verdict, so a false red BLOCKS LANDING. No lock covers this
    # write path, so attribute by REPEATING: a real leak moves the artifact on EVERY attempt, a
    # collision does not repeat. Drive both directions — leak twice must still FAIL, leak once must
    # print the note and pass.
    if [ -n "${MESH_HONESTY_RETRY:-}" ]; then echo "smoke-test: FAIL (--test stamped a LIVE artifact: '$_live_sig' → '$_live_sig2' — moved on BOTH attempts, a real sandbox leak, not a concurrent-writer collision)"; exit 1; fi
    _hr_a="$(stat -c '%Y %s' "$_live_state" 2>/dev/null || echo absent);$(stat -c '%Y %s' "$_live_off" 2>/dev/null || echo absent)"
    MESH_HONESTY_RETRY=1 "$0" --test >/dev/null 2>&1
    _hr_b="$(stat -c '%Y %s' "$_live_state" 2>/dev/null || echo absent);$(stat -c '%Y %s' "$_live_off" 2>/dev/null || echo absent)"
    [ "$_hr_b" = "$_hr_a" ] || { echo "smoke-test: FAIL (--test stamped a LIVE artifact: '$_live_sig' → '$_live_sig2' — moved on BOTH attempts, a real sandbox leak, not a concurrent-writer collision)"; exit 1; }
    echo "  note: a LIVE artifact moved during attempt 1 but NOT during the re-run — attributed to a concurrent live writer, not a sandbox leak"
  fi
  bat="$(discover_battery 2>/dev/null || true)"
  # THE FAIL GATE. This harness set `fail=0`, had 20 assertions setting `fail=1`, and NEVER READ IT —
  # so all 20 were decorative. It sits BEFORE the n/a exit deliberately: that line CLAIMS
  # "classify-logic ok", and on this battery-less node a deliberately false classify_pct assertion
  # printed "FAIL HIGH boundary" and still exited 2 wearing that sentence, which autowire reads as
  # SKIP rather than RED. A vacuous assertion is worse than an absent one — it is a claim. (Sibling
  # of the same defect fixed in mesh-rhythm-state the same day, {#b52ae274}.)
  [ "$fail" = 0 ] || { echo "smoke-test: FAIL ($fail assertion group(s) above went red)"; exit 1; }
  [ -n "$bat" ] || { echo "smoke-test: n/a (no readable battery energy source on this node); classify-logic ok"; exit 2; }
  [ -r "$bat/energy_now" ] || [ -r "$bat/charge_now" ] || { echo "smoke-test: FAIL (battery path lost energy/charge source: $bat)"; exit 1; }
  echo "smoke-test: ok (classify + fixture read + live reservoir source exists)"
  exit 0
fi

JSON=0
[ "${1:-}" = --json ] && JSON=1

bat="$(discover_battery 2>/dev/null || true)"
[ -n "$bat" ] || {
  [ -f "$OFFLINEFILE" ] || { echo "battery-energy: UNREACHABLE — no readable battery reservoir source" >&2; : > "$OFFLINEFILE"; }
  exit 2
}
rm -f "$OFFLINEFILE" 2>/dev/null || true

source_path=""
raw=""
raw_unit=""
design=""
full=""
status=""
capacity=""
voltage_now=""

if [ -r "$bat/energy_now" ]; then
  source_path="$bat/energy_now"
  raw_unit="uWh"
  raw="$(read_trim "$source_path")"
  [ -r "$bat/energy_full_design" ] && design="$(read_trim "$bat/energy_full_design")"
  [ -r "$bat/energy_full" ] && full="$(read_trim "$bat/energy_full")"
elif [ -r "$bat/charge_now" ]; then
  source_path="$bat/charge_now"
  raw_unit="uAh"
  raw="$(read_trim "$source_path")"
  [ -r "$bat/charge_full_design" ] && design="$(read_trim "$bat/charge_full_design")"
  [ -r "$bat/charge_full" ] && full="$(read_trim "$bat/charge_full")"
  [ -r "$bat/voltage_now" ] && voltage_now="$(read_trim "$bat/voltage_now")"
else
  [ -f "$OFFLINEFILE" ] || { echo "battery-energy: UNREACHABLE — reservoir source unreadable" >&2; : > "$OFFLINEFILE"; }
  exit 2
fi

[ -n "$raw" ] || { echo "battery-energy: UNREACHABLE — empty reservoir read" >&2; exit 2; }
[ -r "$bat/status" ] && status="$(read_trim "$bat/status")"
[ -r "$bat/capacity" ] && capacity="$(read_trim "$bat/capacity")"

# TRANSDUCER SELECTION (PIII5). The reference is chosen by QUANTITY, not by which file exists:
# capability-relative first (pct_cap, then the kernel's own `capacity` attribute — the SAME A/C
# quantity by a second transducer), and only then the design-relative A/P, which is a DIFFERENT
# quantity and is therefore labelled loudly. The old order took `design` first, so a cell that
# exposed both silently emitted A/P under the same field name as A/C.
pct_cap=""
pct_design=""
wear=""
[ -n "$full" ] && pct_cap="$(pct_of "$raw" "$full" 2>/dev/null || true)"
[ -n "$design" ] && pct_design="$(pct_of "$raw" "$design" 2>/dev/null || true)"
[ -n "$full" ] && [ -n "$design" ] && wear="$(pct_of "$full" "$design" 2>/dev/null || true)"

pct=""
pct_ref="none"
if [ -n "$pct_cap" ]; then
  pct="$pct_cap"; pct_ref="full"
elif [ -n "$capacity" ] && [ "$capacity" -ge 0 ] 2>/dev/null; then
  pct="$capacity"; pct_ref="capacity-attr"
elif [ -n "$pct_design" ]; then
  pct="$pct_design"; pct_ref="design"
fi

band="$(classify_pct "$pct")"
# A design-referenced band is a LOWER bound on the real reserve and its top rung is unreachable on a
# worn cell (a-guard-above-every-reachable-value-is-unobservable). Never let it pass as an A/C band.
band_note=""
[ "$pct_ref" = design ] && band_note=" note=design-referenced(A/P) — wear-contaminated, HIGH unreachable on a worn cell"
wear_disp="na"
[ -n "$wear" ] && wear_disp="${wear}%"
if [ "$raw_unit" = uWh ]; then
  wh="$(format_wh "$raw")" || { echo "battery-energy: UNREACHABLE — invalid reservoir '$raw'" >&2; exit 2; }
else
  [ -n "$voltage_now" ] || { echo "battery-energy: UNREACHABLE — charge_now without voltage_now" >&2; exit 2; }
  wh="$(awk -v c="$raw" -v v="$voltage_now" 'BEGIN{ if(c=="" || v=="" || c !~ /^[0-9]+$/ || v !~ /^[0-9]+$/) exit 1; printf "%.2f", (c * v) / 1000000000000 }')" \
    || { echo "battery-energy: UNREACHABLE — invalid charge_now/voltage_now pair" >&2; exit 2; }
fi
ts="$(date -u +%FT%TZ)"
reason="raw reservoir source=${source_path} status=${status:-unknown}"

printf '%s|source=%s|raw=%s|pct=%s|ref=%s|wear=%s|status=%s|%s\n' \
  "$band" "$source_path" "$raw" "${pct:-unknown}" "$pct_ref" "${wear:-na}" "${status:-unknown}" "$reason" > "$STATE"

if [ "$JSON" = 1 ]; then
  printf '{"band":"%s","source":"%s","raw":%s,"raw_wh":%s,"pct":%s,"pct_ref":"%s","pct_capability":%s,"pct_design":%s,"wear_pct":%s,"capability":%s,"design":%s,"status":"%s","capacity":%s,"ts":"%s"}\n' \
    "$band" "$source_path" "$raw" "$wh" "${pct:-null}" "$pct_ref" "${pct_cap:-null}" "${pct_design:-null}" \
    "${wear:-null}" "${full:-null}" "${design:-null}" "${status:-unknown}" "${capacity:-null}" "$ts"
  exit 0
fi

printf '[battery-energy] %s — %sWh remaining (%s%% ref=%s) wear=%s source=%s status=%s%s\n' \
  "$band" "$wh" "${pct:-unknown}" "$pct_ref" "$wear_disp" \
  "$source_path" "${status:-unknown}" "$band_note"
