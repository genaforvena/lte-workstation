#!/usr/bin/env bash
# reflex-cadence: 2-59/3 * * * *
# reflex-args: --edge
# mesh-screen-state — SCREEN POWER sense: reads /sys/class/backlight/intel_backlight/bl_power
# and brightness to report whether the IdeaPad's display is active and how bright.
# Source: kernel backlight sysfs — local only, zero SSH, zero deps.
#
# bl_power values (kernel FB_BLANK_* constants):
#   0 = UNBLANK  (screen on, backlit)
#   1 = VSYNC    (DPMS standby)
#   2 = HSYNC    (DPMS suspend)
#   4 = POWERDOWN (DPMS off / display blanked)
#
# Verdicts:
#   OFF     bl_power ≠ 0        → display DPMS-blanked; operator away or screen idle
#   DIM     bl_power=0, <30%    → screen on at low brightness (battery-saver / reading)
#   NORMAL  bl_power=0, 30-80%  → standard work brightness
#   BRIGHT  bl_power=0, >80%    → high brightness (sunlit room, presentations)
#
#   mesh-screen-state            one-shot reading
#   mesh-screen-state --json     machine-readable
#   mesh-screen-state --edge     emit only on verdict change (2-consecutive debounce)
#   mesh-screen-state --test     smoke test
#
# Exit codes:
#   0  = verdict assessed (OFF is a real reading — not an error)
#   2  = backlight sysfs absent (VM, headless node, external-only display)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

MESH="${MESH_SCREEN_MESH:-$HOME/.mesh}"
STATE="${MESH_SCREEN_STATE:-$MESH/.screen-state.state}"
BL="${MESH_BACKLIGHT_PATH:-/sys/class/backlight/intel_backlight}"

_r() { cat "$1" 2>/dev/null || true; }

classify_screen() {
  local power="$1" bright="$2" maxb="$3"
  [ -n "$power" ] || return 2
  [ -n "$bright" ] || return 2
  [ -n "$maxb"  ] || return 2
  [ "$maxb" -gt 0 ] 2>/dev/null || return 2
  if [ "$power" != "0" ]; then
    echo "OFF"; return 0
  fi
  # pct = brightness * 100 / max_brightness (integer arithmetic)
  local pct=$(( bright * 100 / maxb ))
  if   [ "$pct" -gt 80 ]; then echo "BRIGHT"
  elif [ "$pct" -ge 30 ]; then echo "NORMAL"
  else                         echo "DIM"
  fi
  return 0
}

if [ "${1:-}" = --test ]; then
  fail=0
  # Classification assertions (FALSIFIABLE: change any threshold → assertion fails)
  [ "$(classify_screen 4  96000 96000)" = "OFF"    ] || { echo "  FAIL: bl_power=4 → OFF";    fail=1; }
  [ "$(classify_screen 1  96000 96000)" = "OFF"    ] || { echo "  FAIL: bl_power=1 → OFF";    fail=1; }
  [ "$(classify_screen 2  50000 96000)" = "OFF"    ] || { echo "  FAIL: bl_power=2 → OFF";    fail=1; }
  [ "$(classify_screen 0  96000 96000)" = "BRIGHT" ] || { echo "  FAIL: 100% → BRIGHT";       fail=1; }
  [ "$(classify_screen 0  81000 100000)" = "BRIGHT" ] || { echo "  FAIL: 81% → BRIGHT";         fail=1; }
  [ "$(classify_screen 0  80000 100000)" = "NORMAL" ] || { echo "  FAIL: 80% → NORMAL";        fail=1; }
  [ "$(classify_screen 0  50000 100000)" = "NORMAL" ] || { echo "  FAIL: 50% → NORMAL";        fail=1; }
  [ "$(classify_screen 0  30000 100000)" = "NORMAL" ] || { echo "  FAIL: 30% → NORMAL";        fail=1; }
  [ "$(classify_screen 0  29999 100000)" = "DIM"   ] || { echo "  FAIL: 29.9% → DIM";         fail=1; }
  [ "$(classify_screen 0      0 100000)" = "DIM"   ] || { echo "  FAIL: 0% → DIM";            fail=1; }
  # exit 2: empty or zero max
  classify_screen "" 96000 96000; rc=$?
  [ "$rc" = 2 ] || { echo "  FAIL: empty power → return 2 (got $rc)"; fail=1; }
  classify_screen 0 96000 0; rc=$?
  [ "$rc" = 2 ] || { echo "  FAIL: max=0 → return 2 (got $rc)"; fail=1; }
  [ "$fail" = 0 ] || { echo "smoke-test: FAIL"; exit 1; }
  # Live sysfs availability
  if [ ! -f "$BL/bl_power" ] || [ ! -f "$BL/brightness" ] || [ ! -f "$BL/max_brightness" ]; then
    echo "smoke-test: n/a (backlight sysfs absent at $BL — VM/headless node)"; exit 2
  fi
  live_power="$(_r "$BL/bl_power")"
  live_bright="$(_r "$BL/brightness")"
  live_max="$(_r "$BL/max_brightness")"
  live_verdict="$(classify_screen "$live_power" "$live_bright" "$live_max")" || { echo "smoke-test: n/a (classify returned n/a)"; exit 2; }
  echo "smoke-test: ok (11 classify assertions; live bl_power=$live_power bright=$live_bright/$live_max → $live_verdict)"; exit 0
fi

# --- Availability gate ---
if [ ! -f "$BL/bl_power" ] || [ ! -f "$BL/brightness" ] || [ ! -f "$BL/max_brightness" ]; then
  echo "screen-state: backlight sysfs absent — VM or headless node" >&2
  exit 2
fi

bl_power="$(_r "$BL/bl_power")"
brightness="$(_r "$BL/brightness")"
max_brightness="$(_r "$BL/max_brightness")"

verdict="$(classify_screen "$bl_power" "$brightness" "$max_brightness")" || exit 2

pct=0
[ "$max_brightness" -gt 0 ] 2>/dev/null && pct=$(( brightness * 100 / max_brightness ))

TS=$(date -u +%H:%M:%SZ)
mkdir -p "$MESH" 2>/dev/null || true

MODE=text; [ "${1:-}" = --json ] && MODE=json
EDGE=0;    [ "${1:-}" = --edge ] && EDGE=1

if [ "$MODE" = json ]; then
  printf '{"verdict":"%s","bl_power":%s,"brightness_pct":%d,"ts":"%s"}\n' \
    "$verdict" "$bl_power" "$pct" "$TS"
  exit 0
fi

if [ "$EDGE" = 1 ]; then
  PENDING="${STATE%.state}.pending"
  confirmed="$(cat "$STATE" 2>/dev/null || true)"
  pending_line="$(cat "$PENDING" 2>/dev/null || true)"
  pending="${pending_line%%:*}"; pcount="${pending_line##*:}"; pcount="${pcount:-0}"

  if [ -z "$confirmed" ]; then
    printf '%s\n' "$verdict" > "$STATE"; rm -f "$PENDING"
  elif [ "$verdict" = "$confirmed" ]; then
    rm -f "$PENDING"
    touch "$STATE" 2>/dev/null || true   # mtime = last-run
  elif [ "$verdict" = "$pending" ]; then
    pcount=$(( pcount + 1 ))
    if [ "$pcount" -ge 2 ]; then
      printf '%s\n' "$verdict" > "$STATE"; rm -f "$PENDING"
      printf '[screen-state] %s — bl_power=%s bright=%d%%\n' "$verdict" "$bl_power" "$pct"
    else
      printf '%s:%d\n' "$verdict" "$pcount" > "$PENDING"
    fi
  else
    printf '%s:1\n' "$verdict" > "$PENDING"
  fi
  exit 0
fi

printf '[screen-state] %s — bl_power=%s bright=%d%%\n' "$verdict" "$bl_power" "$pct"
