#!/usr/bin/env bash
# reflex-cadence: 2-59/3 * * * *
# reflex-args: --edge
# mesh-screen-state — SCREEN POWER sense: reads /sys/class/backlight/intel_backlight/bl_power
# and brightness to report whether the IdeaPad's display is active and how bright.
# Source: kernel backlight sysfs — local only, zero SSH, zero deps.
#
# bl_power values (kernel FB_BLANK_* constants):
#   0 = UNBLANK  (screen on, backlit)
#   1 = VSYNC    (DPMS standby)
#   2 = HSYNC    (DPMS suspend)
#   4 = POWERDOWN (DPMS off / display blanked)
#
# Verdicts:
#   OFF     bl_power ≠ 0        → display DPMS-blanked; operator away or screen idle
#   DIM     bl_power=0, <30%    → screen on at low brightness (battery-saver / reading)
#   NORMAL  bl_power=0, 30-80%  → standard work brightness
#   BRIGHT  bl_power=0, >80%    → high brightness (sunlit room, presentations)
#
#   mesh-screen-state            one-shot reading
#   mesh-screen-state --json     machine-readable
#   mesh-screen-state --edge     emit only on verdict change (2-consecutive debounce)
#   mesh-screen-state --test     smoke test
#
# Exit codes:
#   0  = verdict assessed (OFF is a real reading — not an error)
#   2  = no backlight-bearing display: desktop/external monitor, VM, or headless. A claim about the
#        NODE (no such organ here), NOT a failed read — mesh-room-sense keys screen_absent on this
#        rc and must not report it as degraded perception. See CLAUDE.local.md (mind-home = desktop).
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

MESH="${MESH_SCREEN_MESH:-$HOME/.mesh}"
STATE="${MESH_SCREEN_STATE:-$MESH/.screen-state.state}"
BL="${MESH_BACKLIGHT_PATH:-/sys/class/backlight/intel_backlight}"

_r() { cat "$1" 2>/dev/null || true; }

classify_screen() {
  local power="$1" bright="$2" maxb="$3"
  [ -n "$power" ] || return 2
  [ -n "$bright" ] || return 2
  [ -n "$maxb"  ] || return 2
  [ "$maxb" -gt 0 ] 2>/dev/null || return 2
  if [ "$power" != "0" ]; then
    echo "OFF"; return 0
  fi
  # pct = brightness * 100 / max_brightness (integer arithmetic)
  local pct=$(( bright * 100 / maxb ))
  if   [ "$pct" -gt 80 ]; then echo "BRIGHT"
  elif [ "$pct" -ge 30 ]; then echo "NORMAL"
  else                         echo "DIM"
  fi
  return 0
}

if [ "${1:-}" = --test ]; then
  fail=0
  # Classification assertions (FALSIFIABLE: change any threshold → assertion fails)
  [ "$(classify_screen 4  96000 96000)" = "OFF"    ] || { echo "  FAIL: bl_power=4 → OFF";    fail=1; }
  [ "$(classify_screen 1  96000 96000)" = "OFF"    ] || { echo "  FAIL: bl_power=1 → OFF";    fail=1; }
  [ "$(classify_screen 2  50000 96000)" = "OFF"    ] || { echo "  FAIL: bl_power=2 → OFF";    fail=1; }
  [ "$(classify_screen 0  96000 96000)" = "BRIGHT" ] || { echo "  FAIL: 100% → BRIGHT";       fail=1; }
  [ "$(classify_screen 0  81000 100000)" = "BRIGHT" ] || { echo "  FAIL: 81% → BRIGHT";         fail=1; }
  [ "$(classify_screen 0  80000 100000)" = "NORMAL" ] || { echo "  FAIL: 80% → NORMAL";        fail=1; }
  [ "$(classify_screen 0  50000 100000)" = "NORMAL" ] || { echo "  FAIL: 50% → NORMAL";        fail=1; }
  [ "$(classify_screen 0  30000 100000)" = "NORMAL" ] || { echo "  FAIL: 30% → NORMAL";        fail=1; }
  [ "$(classify_screen 0  29999 100000)" = "DIM"   ] || { echo "  FAIL: 29.9% → DIM";         fail=1; }
  [ "$(classify_screen 0      0 100000)" = "DIM"   ] || { echo "  FAIL: 0% → DIM";            fail=1; }
  # exit 2: empty or zero max
  classify_screen "" 96000 96000; rc=$?
  [ "$rc" = 2 ] || { echo "  FAIL: empty power → return 2 (got $rc)"; fail=1; }
  classify_screen 0 96000 0; rc=$?
  [ "$rc" = 2 ] || { echo "  FAIL: max=0 → return 2 (got $rc)"; fail=1; }

  # --- Edge time-debounce assertions (the hollow-stale fix): a sustained DIM↔NORMAL flap must
  # commit within CEIL instead of freezing the committed state forever ---
  _t=$(mktemp -d) || { echo "  FAIL: mktemp"; fail=1; }
  if [ -n "$_t" ]; then
    _ds() { MESH_SCREEN_STATE="$_t/.screen-state.state" MESH_SCREEN_DEBOUNCE_S="$1" \
            MESH_BACKLIGHT_PATH="$_t/bl" "$0" --edge >/dev/null 2>&1; }
    mkdir -p "$_t/bl"; printf '96000\n' > "$_t/bl/max_brightness"
    set_bl() { printf '%s\n' "$1" > "$_t/bl/bl_power"; printf '%s\n' "$2" > "$_t/bl/brightness"; }
    # seed confirmed=OFF
    printf 'OFF\n' > "$_t/.screen-state.state"
    # flap NORMAL(31%) then DIM(29%) with CEIL=0 → sustained disagreement commits the LIVE reading
    set_bl 0 29760; _ds 0                              # 31% → NORMAL, age>=0 → commit
    [ "$(cat "$_t/.screen-state.state")" = "NORMAL" ] || { echo "  FAIL: flap NORMAL did not commit (got $(cat "$_t/.screen-state.state"))"; fail=1; }
    set_bl 0 27840; _ds 0                              # 29% → DIM, commit (tracks reality, not first-seen)
    [ "$(cat "$_t/.screen-state.state")" = "DIM" ] || { echo "  FAIL: flap DIM did not commit (got $(cat "$_t/.screen-state.state"))"; fail=1; }
    # transient suppression: high CEIL, one divergent tick must NOT commit yet (stays confirmed)
    printf 'OFF\n' > "$_t/.screen-state.state"; rm -f "$_t/.screen-state.pending"
    set_bl 0 96000; _ds 99999                          # BRIGHT once, CEIL huge → pending, not committed
    [ "$(cat "$_t/.screen-state.state")" = "OFF" ] || { echo "  FAIL: single transient committed early (got $(cat "$_t/.screen-state.state"))"; fail=1; }
    [ -f "$_t/.screen-state.pending" ] || { echo "  FAIL: transient left no pending"; fail=1; }
    rm -rf "$_t"
  fi

  [ "$fail" = 0 ] || { echo "smoke-test: FAIL"; exit 1; }
  # Live sysfs availability
  if [ ! -f "$BL/bl_power" ] || [ ! -f "$BL/brightness" ] || [ ! -f "$BL/max_brightness" ]; then
    echo "smoke-test: n/a (no backlight at $BL — this node has no screen-power organ)"; exit 2
  fi
  live_power="$(_r "$BL/bl_power")"
  live_bright="$(_r "$BL/brightness")"
  live_max="$(_r "$BL/max_brightness")"
  live_verdict="$(classify_screen "$live_power" "$live_bright" "$live_max")" || { echo "smoke-test: n/a (classify returned n/a)"; exit 2; }
  echo "smoke-test: ok (11 classify assertions; live bl_power=$live_power bright=$live_bright/$live_max → $live_verdict)"; exit 0
fi

# --- Availability gate ---
if [ ! -f "$BL/bl_power" ] || [ ! -f "$BL/brightness" ] || [ ! -f "$BL/max_brightness" ]; then
  echo "screen-state: no backlight at $BL — desktop/external monitor, VM, or headless node: this node has no screen-power organ" >&2
  exit 2
fi

bl_power="$(_r "$BL/bl_power")"
brightness="$(_r "$BL/brightness")"
max_brightness="$(_r "$BL/max_brightness")"

verdict="$(classify_screen "$bl_power" "$brightness" "$max_brightness")" || exit 2

pct=0
[ "$max_brightness" -gt 0 ] 2>/dev/null && pct=$(( brightness * 100 / max_brightness ))

TS=$(date -u +%H:%M:%SZ)
mkdir -p "$MESH" 2>/dev/null || true

MODE=text; [ "${1:-}" = --json ] && MODE=json
EDGE=0;    [ "${1:-}" = --edge ] && EDGE=1

if [ "$MODE" = json ]; then
  printf '{"verdict":"%s","bl_power":%s,"brightness_pct":%d,"ts":"%s"}\n' \
    "$verdict" "$bl_power" "$pct" "$TS"
  exit 0
fi

if [ "$EDGE" = 1 ]; then
  # TIME-DEBOUNCED commit (2026-06-25): the old "2-consecutive-IDENTICAL" debounce FROZE the
  # committed .state stale-AND-WRONG whenever the live verdict flapped between two values without
  # ever repeating — the real failure mode is brightness straddling the 30% DIM/NORMAL boundary
  # (auto-brightness wobble), so consecutive samples land DIM,NORMAL,DIM,… , pcount never reaches
  # 2, .state stays pinned at a now-false "OFF" and goes hollow to every reader (operator-focus
  # then reads scr=UNREACHABLE → DEGRADED). Fix: debounce on DISAGREEMENT DURATION, not identical
  # repeats. Record when the live verdict first diverged from the confirmed one; once it has stayed
  # diverged for >= CEIL, commit the CURRENT live reading (whichever side of the boundary it is on).
  # This still suppresses a single-tick transient (< CEIL) yet can never freeze stale, and the
  # committed value tracks reality instead of an arbitrary first-seen verdict. PENDING now carries
  # "verdict:first_seen_epoch" (was "verdict:count") — internal to this tool, no external consumer.
  PENDING="${STATE%.state}.pending"
  CEIL="${MESH_SCREEN_DEBOUNCE_S:-480}"   # commit a sustained change after this long
  now=$(date +%s)
  confirmed="$(cat "$STATE" 2>/dev/null || true)"
  pending_line="$(cat "$PENDING" 2>/dev/null || true)"
  pfirst="${pending_line##*:}"

  if [ -z "$confirmed" ]; then
    printf '%s\n' "$verdict" > "$STATE"; rm -f "$PENDING"
  elif [ "$verdict" = "$confirmed" ]; then
    rm -f "$PENDING"
    mesh-state-touch "$STATE" 2>/dev/null || true   # agreement → liveness heartbeat via shared primitive (chat-review/state-touch-adoption; mtime = last-run)
  else
    # live verdict disagrees with the committed state — keep first-seen across flapping verdicts
    case "$pfirst" in
      ''|*[!0-9]*) pfirst=$now ;;        # no/invalid prior disagreement → start the clock now
    esac
    age=$(( now - pfirst ))
    if [ "$age" -ge "$CEIL" ]; then
      printf '%s\n' "$verdict" > "$STATE"; rm -f "$PENDING"
      printf '[screen-state] %s — bl_power=%s bright=%d%% (debounced %ds)\n' "$verdict" "$bl_power" "$pct" "$age"
    else
      printf '%s:%d\n' "$verdict" "$pfirst" > "$PENDING"
    fi
  fi
  exit 0
fi

printf '[screen-state] %s — bl_power=%s bright=%d%%\n' "$verdict" "$bl_power" "$pct"
