#!/usr/bin/env python3
# mesh-verify-table — the verify window's data pane: a rolling 'tool | result | age' table built from
# the [verify] posts ALREADY on the board. No new write-side: the deferred 2026-06-15 design wanted the
# verify mind to write a separate verify-results.log first; but every [verify] post already carries
# 'mesh-<tool>: exit 0/1, <result>' with a timestamp, so we just fold the board — newest post per tool
# wins. Serves the operator's data-pane-completeness doctrine (the verify window should show what's
# verified, how fresh, and what FAILED, so its mind acts from the pane).
#
#   mesh-verify-table            print the table (FAILED first, then most-stale → freshest)
#   mesh-verify-table --watch    refresh loop for a dedicated pane
#   mesh-verify-table --test     smoke
import re, time, os, calendar, sys

LOG = os.path.expanduser("~/.mesh/chat.log")

def collect():
    now = time.time(); latest = {}
    if not os.path.exists(LOG): return now, latest
    with open(LOG, errors="replace") as f:
        for line in f:
            if "[verify]" not in line: continue
            m = re.match(r"(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ)", line)
            t = re.search(r"\[verify\]\s+(mesh-[a-z0-9-]+)", line)
            if not (m and t): continue
            try: ep = calendar.timegm(time.strptime(m.group(1), "%Y-%m-%dT%H:%M:%SZ"))
            except Exception: continue
            tool = t.group(1); rest = line.split("[verify]", 1)[1].lower()
            # N/A is checked BEFORE FAIL: 'exit 2' is the genome-wide "not applicable"
            # convention (TV off, phone offline, dep/node absent), NOT a failure. Without
            # this branch the FAIL regex 'exit [1-9]' swallows 'exit 2' and paints every
            # honestly-n/a tool red (the mesh-tv false-FAIL, 2026-06-17). n/a != failed.
            if re.search(r"exit 0|\bpass\b|✓|real (output|verdict|diff|data|gps|multi)|verdict ok|verdict pass|verdict healthy", rest):       res = "PASS"
            elif re.search(r"\bexit 2\b|\bn/?a\b|not applicable|not a .{0,14}node|unreachable|offline", rest): res = "N/A"
            elif re.search(r"exit [1-9]|(?<![-\w])fail\b|✗|\berror\b", rest):                                 res = "FAIL"
            else:                                                                                     res = "?"
            if tool not in latest or ep > latest[tool][0]: latest[tool] = (ep, res)
    return now, latest

def age(now, ep):
    s = int(now - ep)
    return f"{s//60}m" if s < 3600 else (f"{s//3600}h" if s < 86400 else f"{s//86400}d")

def render():
    now, latest = collect()
    print(f"== verify results · {len(latest)} tools · {time.strftime('%H:%MZ', time.gmtime(now))} ==")
    if not latest:
        print("  (no [verify] posts on the board yet)"); return
    fails = [t for t, (e, r) in latest.items() if r == "FAIL"]
    # FAILED first; then oldest→freshest so the most-stale (re-verify candidates) sit near the top
    order = sorted(latest.items(), key=lambda kv: (kv[1][1] != "FAIL", kv[1][0]))
    for tool, (ep, res) in order[:16]:
        icon = "✗" if res == "FAIL" else ("✓" if res == "PASS" else "·")
        print(f"  {icon} {tool:24} {res:4} {age(now, ep):>5} ago")
    if fails: print(f"  ⚠ FAILED: {', '.join(fails)}")
    stale = [t for t, (e, r) in latest.items() if now - e > 3600]
    if stale: print(f"  stale >1h: {len(stale)} ({', '.join(stale[:5])}{'…' if len(stale) > 5 else ''})")

if __name__ == "__main__":
    a = sys.argv[1] if len(sys.argv) > 1 else ""
    if a == "--test":
        # Real dry-run of the LOAD-BEARING parser (collect()'s timestamp + tool + PASS/FAIL regexes).
        # The old test asserted isinstance(latest, dict) — ALWAYS true (collect() inits latest={}), so it
        # could never FAIL even if the board [verify] format drifted and the table silently rendered NOTHING
        # (green-but-dead data pane). Feed synthetic board lines through the REAL collect() and assert the
        # parser extracts the tool name AND classifies PASS vs FAIL. FAILs iff a regex drifts from the
        # actual [verify] post shape — the one thing that would hollow out this pane.
        import tempfile
        fail = 0
        sample = (
            "2026-06-15T12:00:00Z  who@node  ::  [verify] mesh-foo: exit 0, real output\n"
            "2026-06-15T12:01:00Z  who@node  ::  [verify] mesh-bar: exit 1, error seen\n"
            "2026-06-15T12:02:00Z  who@node  ::  [done] mesh-baz: not a verify line\n"
            "2026-06-15T12:03:00Z  who@node  ::  [verify] mesh-tv: exit 2, n/a (TV unreachable)\n"
            "2026-06-15T12:04:00Z  who@node  ::  [verify] mesh-vitality --check: verify-fails=1 stranded=0 — verdict OK\n"
        )
        with tempfile.NamedTemporaryFile("w", suffix=".log", delete=False) as tf:
            tf.write(sample); LOG = tf.name
        try:
            now, latest = collect()
        finally:
            os.unlink(LOG)
        if latest.get("mesh-foo", (0, "?"))[1] != "PASS":
            print(f"  FAIL: PASS [verify] line did not parse to mesh-foo=PASS (got {latest.get('mesh-foo')})"); fail = 1
        if latest.get("mesh-bar", (0, "?"))[1] != "FAIL":
            print(f"  FAIL: FAIL [verify] line did not parse to mesh-bar=FAIL (got {latest.get('mesh-bar')})"); fail = 1
        if "mesh-baz" in latest:
            print("  FAIL: a non-[verify] line leaked into the table"); fail = 1
        if latest.get("mesh-tv", (0, "?"))[1] != "N/A":
            print(f"  FAIL: 'exit 2' n/a line mis-classified (got {latest.get('mesh-tv')}, want N/A — exit 2 != FAIL)"); fail = 1
        if latest.get("mesh-vitality", (0, "?"))[1] != "PASS":
            print(f"  FAIL: 'verify-fail' metric caused false FAIL (got {latest.get('mesh-vitality')}, want PASS)"); fail = 1
        if fail:
            print("smoke-test: FAIL (board-[verify] parser drifted — pane would silently show nothing)"); sys.exit(1)
        print(f"  ok: parser extracted {len(latest)} tools from synthetic board, PASS/FAIL/N-A classified correctly")
        print("smoke-test: ok"); sys.exit(0)
    elif a == "--watch":
        import subprocess
        while True:
            os.system("clear"); render(); time.sleep(int(os.environ.get("MESH_VERIFY_REFRESH", "30")))
    else:
        render()
