#!/usr/bin/env bash
# orphan-ok: invoked ON-DEMAND by the plan mind at the end of a tick (not cron-wired) — it prints the
#   plan mind's terse status line so the idle yield is one scannable line, not a paragraph. No cadence
#   by design: it has no value on a timer (it only means something right after a plan tick).
# mesh-plan-idle — emit the PLANNER's one-line idle status, structured + scannable.
#
# Operator 2026-06-20 (task chat-review/plan-idle-condense): "plan mind idle posts 5-10 lines every
# tick (~50% board volume); condense to 1-line '[idle] plan: strand=clean tree=sync open=N(...)';
# full summary on state change/[done] only." This is the durable form of that fix — a helper the plan
# mind runs so the idle line is consistently terse instead of prose, surviving restart/compaction.
#
#   mesh-plan-idle              print:  [idle] plan: strand=<…> tree=<…> open=N(<slugs>)
#   mesh-plan-idle --post       print AND post it to the board via mesh-chat
#   mesh-plan-idle --test       smoke (deps + computed line shape; no board post)
#
# Three honest, read-only fields:
#   strand= clean | op-active:N     N genuine operator VOICE asks in the last window (voice-in.log) — the
#                                   tg-mind's lane; planner just shows awareness. NOT board-sourced: on a
#                                   single-handle node a chat-mind [task] is indistinguishable from an
#                                   operator ask, so board-strand falsely fired (the strand=4 chat-review case).
#   tree=   sync | dirty | ahead    genome git: dirty=uncommitted, ahead=unpushed, sync=clean+pushed
#   open=   N(<slug,slug,…>)        open board [task] slugs (task minus done/taking/dispatch) in lookback
#
# A SUBSTANTIVE tick (real artifact, [done], correction, handoff) still gets its own full marker —
# this is only for the otherwise-content-free idle yield, the board's single largest noise source.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

CHATLOG="${CA_LOG:-$HOME/.mesh/chat.log}"
GENOME="${MESH_GENOME:-$HOME/lte-workstation}"
LOOKBACK="${MESH_PLAN_IDLE_LINES:-400}"
VOICEIN="${MESH_VOICE_IN:-$HOME/.mesh/voice-in.log}"   # genuine operator input (VOICE-tagged)
STRAND_WIN_MIN="${MESH_PLAN_STRAND_MIN:-30}"           # "recent" window for operator asks

open_tasks(){ # open [task] slugs = task-slugs minus any done/taking/dispatch slug, in lookback
  local tb; tb="$(tail -n "$LOOKBACK" "$CHATLOG" 2>/dev/null)"
  local tasks done
  tasks="$(printf '%s\n' "$tb" | grep -oE '\[task\] [a-z][a-z0-9-]*/[a-z0-9-]+' | sed 's/\[task\] //' | sort -u)"
  done="$(printf '%s\n' "$tb" | grep -oE '\[(done|taking|dispatch)\][^]]*[a-z][a-z0-9-]*/[a-z0-9-]+' \
          | grep -oE '[a-z][a-z0-9-]*/[a-z0-9-]+' | sort -u)"
  comm -23 <(printf '%s\n' "$tasks") <(printf '%s\n' "$done") | grep -v '^$'
}

op_strand(){ # RECENT operator voice asks (genuine operator input, tg-mind's lane — the planner just
  # shows awareness). The board can't source this: on a single-handle node EVERY post is OP@, so a
  # chat-mind [task] is indistinguishable from an operator ask (it falsely read strand=4 off chat-review
  # tasks). voice-in.log VOICE lines ARE genuine operator input. ISO-UTC timestamps sort lexically =
  # chronologically, so a string >= cutoff is a clean recency test (no per-line date calls). Echo the
  # count when >0, else empty (=clean).
  [ -f "$VOICEIN" ] || return 0
  local cutoff n; cutoff="$(date -u -d "-${STRAND_WIN_MIN} min" +%FT%TZ 2>/dev/null)" || return 0
  n="$(tail -n 300 "$VOICEIN" 2>/dev/null | grep -F VOICE | awk -v c="$cutoff" '$1 >= c {k++} END{print k+0}')"
  [ "${n:-0}" -gt 0 ] 2>/dev/null && echo "$n"
}

tree_state(){ # genome git: dirty (uncommitted) > ahead (unpushed) > sync
  [ -d "$GENOME/.git" ] || { echo "n/a"; return; }
  if [ -n "$(git -C "$GENOME" status --porcelain 2>/dev/null)" ]; then echo dirty; return; fi
  local ahead
  ahead="$(git -C "$GENOME" rev-list --count '@{u}..HEAD' 2>/dev/null || echo 0)"
  [ "${ahead:-0}" -gt 0 ] 2>/dev/null && { echo ahead; return; }
  echo sync
}

build_line(){
  local ot os tree opN
  ot="$(open_tasks)"; os="$(op_strand)"; tree="$(tree_state)"
  opN="$(printf '%s\n' "$ot" | grep -c . )"
  local opslugs strand
  opslugs="$(printf '%s' "$ot" | paste -sd, - )"
  if [ -z "$os" ]; then strand=clean    # no recent operator voice asks
  else strand="op-active:$os"; fi       # N operator voice lines in the window (tg-mind handling)
  if [ "$opN" -gt 0 ]; then
    echo "[idle] plan: strand=$strand tree=$tree open=$opN($opslugs)"
  else
    echo "[idle] plan: strand=$strand tree=$tree open=0"
  fi
}

case "${1:-}" in
  --test)
    command -v git >/dev/null 2>&1 || { echo "smoke-test: FAIL (no git)"; exit 1; }
    [ -r "$CHATLOG" ] || echo "smoke-test: note (chatlog $CHATLOG not readable — open=0 expected)"
    line="$(build_line)"
    printf '%s' "$line" | grep -qE '^\[idle\] plan: strand=[^ ]+ tree=(sync|dirty|ahead|n/a) open=[0-9]' \
      || { echo "smoke-test: FAIL (malformed line: $line)"; exit 1; }
    # synthetic board: open task minus resolved → open= must include foo, exclude resolved bar
    tmp="$(mktemp)"; printf '%s\n' \
      "2026-06-21T00:00:00Z  op@h  ::  [task] chat-review/foo: do a thing (owner: plan)" \
      "2026-06-21T00:01:00Z  genome@h  ::  [task] senses/bar: other thing" \
      "2026-06-21T00:02:00Z  genome@h  ::  [done] senses/bar: shipped" > "$tmp"
    sl="$(CHATLOG="$tmp" build_line)"; rm -f "$tmp"
    printf '%s' "$sl" | grep -q 'open=1(chat-review/foo)' || { echo "smoke-test: FAIL (open-task reconcile: $sl)"; exit 1; }
    printf '%s' "$sl" | grep -q 'senses/bar' && { echo "smoke-test: FAIL (resolved task not filtered: $sl)"; exit 1; }
    # strand sources from voice-in.log recency, NOT the board (board can't tell operator from mind on a
    # single-handle node). A FUTURE-dated VOICE line is always "recent" → op-active; an old one → clean.
    vtmp="$(mktemp)"
    printf '%s\n' "2999-01-01T00:00:00Z  VOICE  operator asks something" > "$vtmp"
    printf '%s' "$(VOICEIN="$vtmp" op_strand)" | grep -qx 1 || { echo "smoke-test: FAIL (recent voice ask not counted)"; rm -f "$vtmp"; exit 1; }
    printf '%s\n' "2000-01-01T00:00:00Z  VOICE  stale ask" > "$vtmp"
    [ -z "$(VOICEIN="$vtmp" op_strand)" ] || { echo "smoke-test: FAIL (stale voice ask counted as strand)"; rm -f "$vtmp"; exit 1; }
    rm -f "$vtmp"
    echo "smoke-test: ok (live: $line)"
    exit 0;;
  --post)
    line="$(build_line)"
    command -v mesh-chat >/dev/null 2>&1 && mesh-chat "$line" >/dev/null 2>&1
    echo "$line";;
  ""|--print) build_line;;
  *) echo "usage: mesh-plan-idle [--post|--print|--test]"; exit 0;;
esac
