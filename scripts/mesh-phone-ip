#!/usr/bin/env bash
# mesh-phone-ip — probe-based phone IP resolver. Returns the first IP that actually
# ACCEPTS an SSH connection on PHONE_SSH_PORT. Fixes the dead-LAN-fallback bug:
# mesh-peer-addr always returns the TS IP; when sshd is killed by MIUI on that IP,
# callers fail even when the phone is reachable on LAN. This script PROBES each
# candidate before returning, so callers just do:
#
#   pip="$(mesh-phone-ip 2>/dev/null)" || { echo "phone unreachable" >&2; exit 2; }
#
# Candidate order: PHONE_IP (if set) → mesh-peer-addr Redmi → PHONE_LAN_IPS → ADB tunnel
# ADB tunnel: if all network paths fail but ADB is connected, sets up
#   adb forward tcp:PORT tcp:PORT  (phone-local sshd reachable as 127.0.0.1:PORT)
# MIUI firewalls port 8022 externally but ADB is a system daemon MIUI can't block.
# Probe timeout: 3s per candidate (ConnectTimeout) → 4s wall-clock per try.
#
#   mesh-phone-ip        → prints resolved IP, exit 0; exit 2 if all fail
#   mesh-phone-ip --test smoke test (deps only, no probe)
#
# Honest-exit: exit 2 = phone unreachable on all known IPs (not a generic error).
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes" 2>/dev/null || true

PORT="${PHONE_SSH_PORT:-8022}"
PUSER="${PHONE_USER:-u0_a380}"

if [ "${1:-}" = --test ]; then
  command -v ssh >/dev/null 2>&1 || { echo "smoke-test: FAIL (no ssh)"; exit 1; }
  command -v mesh-peer-addr >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-peer-addr)"; exit 1; }
  echo "smoke-test: ok"; exit 0
fi

_probe() {
  local ip="$1"
  [ -n "$ip" ] || return 1
  timeout 4 ssh -p "$PORT" -o BatchMode=yes -o ConnectTimeout=3 \
    -o StrictHostKeyChecking=accept-new "${PUSER}@${ip}" 'echo ok' </dev/null >/dev/null 2>&1
}

# Build candidate list in priority order
candidates="${PHONE_IP:-}"
_ts="$(mesh-peer-addr Redmi 2>/dev/null || mesh-peer-addr redmi 2>/dev/null || true)"
[ -n "$_ts" ] && candidates="$candidates $_ts"
candidates="$candidates ${PHONE_LAN_IPS:-}"

for ip in $candidates; do
  [ -n "$ip" ] || continue
  if _probe "$ip"; then
    echo "$ip"
    exit 0
  fi
done

# ADB tunnel fallback: MIUI can firewall 8022 from LAN while ADB (system daemon) still works.
# Set up adb forward tcp:PORT tcp:PORT → callers SSH to 127.0.0.1:PORT and reach phone sshd.
if command -v adb >/dev/null 2>&1; then
  _adb_dev="$(adb devices 2>/dev/null | awk '/^192\.168\./{print $1; exit}')"
  if [ -n "$_adb_dev" ]; then
    adb -s "$_adb_dev" forward "tcp:${PORT}" "tcp:${PORT}" >/dev/null 2>&1 || true
    if _probe "127.0.0.1"; then
      echo "127.0.0.1"
      exit 0
    fi
  fi
fi

exit 2
