#!/usr/bin/env bash
# mesh-phone-ip — probe-based phone IP resolver (sources mesh-patterns.sh for core function).
# Returns the first IP that actually ACCEPTS an SSH connection on PHONE_SSH_PORT. ADB tunnel
# is the last live-probe fallback. If the known phone is temporarily offline, returns a cached or
# registry last-known IP so dependent tools can degrade honestly instead of treating the phone as
# unknown.
#
# Candidate order: PHONE_IP (if set) → phone_reachable_ip (TS→LAN) → ADB tunnel
#
#   mesh-phone-ip        → prints an IP (resolved OR last-known guess), exit 0; exit 2 only when
#                          the phone is unknown to this node entirely (no cache, no registry).
#   mesh-phone-ip --test smoke test (deps only, no probe)
#
# Exits: 0 = live IP resolved, or known phone emitted from cache/registry; 2 = genuinely unknown.
#
# EXIT 0 IS NOT A REACHABILITY CLAIM — it means resolved-OR-last-known. This resolver deliberately
# emits a cached/registry guess with exit 0 when the phone is offline (paths 4 and 5 below), so leaf
# senses can attempt the SSH and exit 2 honestly on their own. The "this is a guess" signal exists
# ONLY on stderr ("phone offline — ..."), and the canonical consumer idiom `$(mesh-phone-ip 2>/dev/null)`
# throws that away — so rc alone can never tell you the phone is up. Live proof: served 192.168.8.146
# with exit 0 while SSH to it gave "No route to host".
#   - Leaf phone sense (mesh-light/mesh-tamper/mesh-body-motion/…): fine to use rc as-is. You SSH
#     anyway and exit 2 when it fails; the guess costs you one timeout, and the answer stays honest.
#   - FUSION tool pre-gating N phone senses on "is the phone up?": do NOT gate on this rc — it never
#     goes false, so the gate never skips and you pay every stall it was written to avoid
#     (mesh-activity-tempo: 27s→11s once fixed). Do ONE fast probe yourself:
#       timeout 6 ssh -o ConnectTimeout=4 -o BatchMode=yes -p "${PHONE_SSH_PORT:-8022}" \
#         "${PHONE_USER:-u0_a380}@$ip" true   # phone_ok=1 only if this ACCEPTS
#     Worked examples: mesh-activity-light:181, mesh-desk-state:256, mesh-doctor:783.
# Full rationale: ~/.mesh/knowledge/phone-ip-exit0-is-not-reachability.md
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes" 2>/dev/null || true
# source phone_reachable_ip from canonical patterns lib
. "${MESH_PATTERNS:-$HOME/.local/bin/mesh-patterns.sh}" 2>/dev/null || \
  . "$(dirname "$0")/mesh-patterns.sh" 2>/dev/null || true

PORT="${PHONE_SSH_PORT:-8022}"
PUSER="${PHONE_USER:-u0_a380}"
STATE_FILE="$HOME/.mesh/phone-ip.state"
CACHE_TTL="${MESH_PHONE_IP_CACHE_TTL:-900}"
# A negative/offline guess is honored only briefly so a returning phone reconnects fast instead of
# being pinned to a dead IP for the whole positive TTL (the stale-Tailscale-IP poison bug: an offline
# registry guess got cached and served as "fresh" for 900s, SSHing every sensor to a dead address).
OFFLINE_TTL="${MESH_PHONE_IP_OFFLINE_TTL:-120}"

# cache_ip <ip> [status] — write IP + timestamp + status (ok|offline) to the state file. Default ok.
# Only a verified-reachable IP is written 'ok'; an offline registry/cache guess is written 'offline'
# so the fast path treats it as a short-lived negative cache, never a trusted positive answer.
cache_ip() { printf '%s\t%s\t%s\n' "$(date -u +%s)" "$1" "${2:-ok}" > "$STATE_FILE"; }

if [ "${1:-}" = --test ]; then
  command -v ssh >/dev/null 2>&1 || { echo "smoke-test: FAIL (no ssh)"; exit 1; }
  command -v mesh-peer-addr >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-peer-addr)"; exit 1; }

  _scr="${BASH_SOURCE[0]}"; _ret=0
  _state_bak=""
  if [ -f "$STATE_FILE" ]; then
    _state_bak="$(mktemp)"
    cp "$STATE_FILE" "$_state_bak"
  fi
  _restore_state() {
    if [ -n "$_state_bak" ] && [ -f "$_state_bak" ]; then
      mkdir -p "$(dirname "$STATE_FILE")"
      cp "$_state_bak" "$STATE_FILE"
      rm -f "$_state_bak"
    else
      rm -f "$STATE_FILE"
    fi
  }
  trap _restore_state EXIT

  # 1) PHONE_IP env override returns that IP immediately
  _d1="$(mktemp -d)"; mkdir -p "$_d1/home/.mesh"
  _out="$(HOME="$_d1/home" PHONE_IP=10.0.0.1 bash "$_scr" 2>/dev/null)" || _ret=1
  [ "$_out" = "10.0.0.1" ] || { echo "  FAIL: PHONE_IP override (got '${_out:-}')"; _ret=1; }
  rm -rf "$_d1"

  # 2) All paths fail, no cached state → exit 2 (genuinely unreachable, per convention)
  _d="$(mktemp -d)"
  mkdir -p "$_d/home/.mesh" "$_d/home/.local/bin"
  printf '%s\n' 'phone_reachable_ip() { return 2; }' > "$_d/mp.sh"
  printf '#!/bin/sh\nexit 1\n' > "$_d/home/.local/bin/adb"; chmod +x "$_d/home/.local/bin/adb"
  HOME="$_d/home" PHONE_IP="" PHONE_TS_IP="" PHONE_LAN_IPS="" MESH_PATTERNS="$_d/mp.sh" bash "$_scr" >/dev/null 2>/dev/null; _ec=$?
  [ "$_ec" = 2 ] || { echo "  FAIL: no-cache all-fail should exit 2 (got $_ec)"; _ret=1; }
  rm -rf "$_d"

  # 3) phone_reachable_ip cascade — mock patterns return a fake IP (ADB mocked absent)
  _d2="$(mktemp -d)"
  mkdir -p "$_d2/home/.mesh"
  printf '%s\n' 'phone_reachable_ip() { echo "192.168.1.100"; return 0; }' > "$_d2/mp.sh"
  printf '#!/bin/sh\nexit 1\n' > "$_d2/adb"; chmod +x "$_d2/adb"
  _out2="$(HOME="$_d2/home" PATH="$_d2:$PATH" PHONE_IP="" MESH_PATTERNS="$_d2/mp.sh" bash "$_scr" 2>/dev/null)" || true
  [ "$_out2" = "192.168.1.100" ] || { echo "  FAIL: phone_reachable_ip cascade (got '${_out2:-}')"; _ret=1; }
  rm -rf "$_d2"

  # 4) Cached state fallback: all paths fail but state file exists → exit 0 with cached IP
  _d3="$(mktemp -d)"
  mkdir -p "$_d3/home/.mesh" "$_d3/home/.local/bin"
  printf '%s\n' 'phone_reachable_ip() { return 2; }' > "$_d3/mp.sh"
  printf '%s\t%s\n' "$(date -u +%s)" "192.168.1.200" > "$_d3/home/.mesh/phone-ip.state"
  # Mock adb as disconnected (get-state fails) so we reach cached fallback
  printf '#!/bin/sh\nexit 1\n' > "$_d3/home/.local/bin/adb"; chmod +x "$_d3/home/.local/bin/adb"
  _out3="$(HOME="$_d3/home" PHONE_IP="" PHONE_TS_IP="" PHONE_LAN_IPS="" MESH_PATTERNS="$_d3/mp.sh" bash "$_scr" 2>/dev/null)" || true
  [ "$_out3" = "192.168.1.200" ] || { echo "  FAIL: cached-state fallback (got '${_out3:-}')"; _ret=1; }
  rm -rf "$_d3"

  # 5) Registry fallback: known phone but no live path/cache → exit 0 with a last-known candidate.
  # LAN-first (Tailscale IP, often offline, is last) — so the guess is the more-likely-live LAN IP.
  _d4="$(mktemp -d)"
  mkdir -p "$_d4/home/.mesh" "$_d4/home/.local/bin"
  printf '%s\n' 'phone_reachable_ip() { return 2; }' > "$_d4/mp.sh"
  printf '#!/bin/sh\nexit 1\n' > "$_d4/home/.local/bin/adb"; chmod +x "$_d4/home/.local/bin/adb"
  _out4="$(HOME="$_d4/home" PHONE_IP="" PHONE_TS_IP="100.64.0.3" PHONE_LAN_IPS="192.168.1.201 192.168.1.202" MESH_PATTERNS="$_d4/mp.sh" bash "$_scr" 2>/dev/null)" || true
  [ "$_out4" = "192.168.1.201" ] || { echo "  FAIL: registry fallback should be LAN-first (got '${_out4:-}')"; _ret=1; }
  rm -rf "$_d4"

  # 6) Poison regression: a STALE offline-status cache must NOT be served — it must fall through to a
  # live probe. (The bug: a dead Tailscale IP got cached 'fresh' and pinned every sensor to it for
  # 900s.) Here phone_reachable_ip returns a live LAN IP; a 10-min-old offline cache must be ignored.
  _d5="$(mktemp -d)"
  mkdir -p "$_d5/home/.mesh"
  printf '%s\n' 'phone_reachable_ip() { echo "192.168.5.50"; return 0; }' > "$_d5/mp.sh"
  printf '%s\t%s\t%s\n' "$(( $(date -u +%s) - 600 ))" "100.64.0.3" "offline" > "$_d5/home/.mesh/phone-ip.state"
  _out5="$(HOME="$_d5/home" PHONE_IP="" MESH_PATTERNS="$_d5/mp.sh" bash "$_scr" 2>/dev/null)" || true
  [ "$_out5" = "192.168.5.50" ] || { echo "  FAIL: stale offline cache pinned instead of re-probing (got '${_out5:-}')"; _ret=1; }
  rm -rf "$_d5"

  # 7) A FRESH offline cache IS honored briefly (avoid hammering probes when genuinely down).
  _d6="$(mktemp -d)"
  mkdir -p "$_d6/home/.mesh" "$_d6/home/.local/bin"
  printf '%s\n' 'phone_reachable_ip() { return 2; }' > "$_d6/mp.sh"
  printf '#!/bin/sh\nexit 1\n' > "$_d6/home/.local/bin/adb"; chmod +x "$_d6/home/.local/bin/adb"
  printf '%s\t%s\t%s\n' "$(date -u +%s)" "192.168.6.60" "offline" > "$_d6/home/.mesh/phone-ip.state"
  _out6="$(HOME="$_d6/home" PATH="$_d6/home/.local/bin:$PATH" PHONE_IP="" MESH_PATTERNS="$_d6/mp.sh" bash "$_scr" 2>/dev/null)" || true
  [ "$_out6" = "192.168.6.60" ] || { echo "  FAIL: fresh offline cache should be honored briefly (got '${_out6:-}')"; _ret=1; }
  rm -rf "$_d6"

  [ "$_ret" = 0 ] && { echo "smoke-test: ok"; exit 0; } || exit 1
fi

# 1. PHONE_IP env override (fast path, no probe)
if [ -n "${PHONE_IP:-}" ]; then
  cache_ip "$PHONE_IP"
  echo "$PHONE_IP"
  exit 0
fi

# Fresh cache fast path: avoid spending every verifier tick on slow offline SSH probes.
# A POSITIVE (status=ok) cache short-circuits for the full CACHE_TTL — it holds a verified-reachable
# IP. A negative (status=offline) cache is honored only for the short OFFLINE_TTL, so a phone that
# came back is re-probed within ~2min instead of being pinned to a dead IP for 900s.
if [ -f "$STATE_FILE" ]; then
  read -r _cache_ts _cached_ip _cache_st < "$STATE_FILE" 2>/dev/null || _cached_ip=
  _cache_st="${_cache_st:-ok}"
  _now="$(date -u +%s)"
  _ttl="$CACHE_TTL"; [ "$_cache_st" = offline ] && _ttl="$OFFLINE_TTL"
  if [ -n "${_cached_ip:-}" ] && [ -n "${_cache_ts:-}" ] \
    && [ $(( _now - _cache_ts )) -le "$_ttl" ] 2>/dev/null; then
    if [ "$_cache_st" = ok ]; then echo "phone IP (cached ok) ${_cached_ip}" >&2
    else echo "phone offline — cached fallback ${_cached_ip} (re-probe in ${OFFLINE_TTL}s)" >&2; fi
    echo "$_cached_ip"
    exit 0
  fi
fi

# 2. TS→LAN probe via canonical function
if type phone_reachable_ip >/dev/null 2>&1; then
  if pip="$(phone_reachable_ip 2>/dev/null)"; then
    cache_ip "$pip"; echo "$pip"; exit 0
  fi
else
  # fallback: inline probe if patterns lib not loaded
  _ts="$(mesh-peer-addr Redmi 2>/dev/null || mesh-peer-addr redmi 2>/dev/null || true)"
  for _ip in $_ts ${PHONE_LAN_IPS:-}; do
    [ -n "$_ip" ] || continue
    if timeout 4 ssh -p "$PORT" -o BatchMode=yes -o ConnectTimeout=3 \
      -o StrictHostKeyChecking=accept-new "${PUSER}@${_ip}" 'echo ok' </dev/null >/dev/null 2>&1; then
      cache_ip "$_ip"; echo "$_ip"; exit 0
    fi
  done
fi

# 3. ADB tunnel fallback: MIUI can firewall 8022 from LAN while ADB (system daemon) still works.
# NOTE: use adb get-state (not adb devices) — Android 13 wireless debug shows empty `adb devices`
# while adb is fully functional (see mesh-phone-watch eccae4a for the same fix).
if command -v adb >/dev/null 2>&1; then
  if adb get-state >/dev/null 2>&1; then
    adb forward "tcp:${PORT}" "tcp:${PORT}" >/dev/null 2>&1 || true
    if timeout 4 ssh -p "$PORT" -o BatchMode=yes -o ConnectTimeout=3 \
      -o StrictHostKeyChecking=accept-new "${PUSER}@127.0.0.1" 'echo ok' </dev/null >/dev/null 2>&1; then
      cache_ip "127.0.0.1"; echo "127.0.0.1"; exit 0
    fi
  fi
fi

# 4. Cached-state fallback: phone was reachable before, now likely on cellular (expected).
# Only serve a LAST-GOOD (status=ok) cache here; a stale offline guess must fall through to the
# registry so we don't re-serve a dead IP we already know failed.
if [ -f "$STATE_FILE" ]; then
  read -r _ts _cached_ip _cst < "$STATE_FILE" 2>/dev/null || _cached_ip=
  if [ -n "${_cached_ip:-}" ] && [ "${_cst:-ok}" = ok ]; then
    echo "phone offline — returning last-good IP ${_cached_ip}" >&2
    echo "$_cached_ip"
    exit 0
  fi
fi

# 5. Registry fallback: the phone is known to this node, but no live probe currently accepts SSH.
# LAN-first (the often-offline Tailscale IP last) since this node is moving off Tailscale, and cache
# the guess as 'offline' so the fast path re-probes it shortly rather than trusting it for 900s.
for _known_ip in ${PHONE_LAN_IPS:-} ${PHONE_TS_IP:-}; do
  [ -n "$_known_ip" ] || continue
  echo "phone offline — returning registry IP ${_known_ip}" >&2
  cache_ip "$_known_ip" offline
  echo "$_known_ip"
  exit 0
done

echo "phone unreachable — no cached/registry state (genuinely unknown)" >&2
exit 2
