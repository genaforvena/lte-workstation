#!/usr/bin/env bash
# mesh-url-watch — LLM-free reflex: detect video URLs in operator Telegram messages → play on TV.
#
# Watches ~/.mesh/voice-in.log for new TEXT lines. Triggers on either:
#   - a "/meshtv <url>" command (explicit — any http(s) URL), or
#   - a bare video URL (YouTube/youtu.be/vimeo/rutube — convenience, operator's first ask).
# Plays it via mesh-tv-dlna (no-phone DLNA push to the Bravia, verified 2026-06-14 PLAYING).
# Uses a line-offset state file to process only new lines (no re-runs on old content).
#
#   mesh-url-watch        run one pass (for cron wiring)
#   mesh-url-watch --test smoke test (no side effects)
#
# Wiring: cron every minute (minute-lag acceptable; operator posts URL → plays within ~1 min)
# Exit: 0 = ok; 2 = n/a (no voice-in.log or mesh-tv-dlna).
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes"

LOG="$HOME/.mesh/voice-in.log"
OFFSET_FILE="$HOME/.mesh/.url-watch-offset"
HOST="$(hostname)"

if [ "${1:-}" = "--test" ]; then
  [ -f "$LOG" ] || { echo "smoke-test: n/a (no voice-in.log)"; exit 2; }
  command -v mesh-tv-dlna >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-tv-dlna)"; exit 1; }
  echo "smoke-test: ok (voice-in.log present, mesh-tv-dlna available)"; exit 0
fi

[ -f "$LOG" ] || exit 2
command -v mesh-tv-dlna >/dev/null 2>&1 || exit 2

# Read offset (number of lines already processed)
offset=0
[ -f "$OFFSET_FILE" ] && offset="$(cat "$OFFSET_FILE" 2>/dev/null || echo 0)"
total="$(wc -l < "$LOG" 2>/dev/null || echo 0)"

# Save new offset immediately (even if nothing to do — avoids re-processing on next run)
printf '%s\n' "$total" > "$OFFSET_FILE"

[ "$total" -le "$offset" ] && exit 0

# Process new lines only
new_lines="$(tail -n +"$((offset + 1))" "$LOG" 2>/dev/null)"
[ -z "$new_lines" ] && exit 0

# Find TEXT lines with video URLs
while IFS= read -r line; do
  # Only process TEXT messages (not VOICE transcriptions — those may mention URLs verbally)
  printf '%s' "$line" | grep -qE '^[0-9]{2}:[0-9]{2}:[0-9]{2}Z  TEXT  ' || continue
  # /meshtv control verb (pause/resume/stop/play) — playback control, no URL
  verb="$(printf '%s' "$line" | grep -oiE '/meshtv +(pause|resume|stop|play)\b' | grep -oiE '(pause|resume|stop|play)$' | head -1 | tr 'A-Z' 'a-z')"
  if [ -n "$verb" ]; then
    MESH_WHO="url-watch@${HOST}" mesh-chat "[url-watch] operator → TV control: $verb" 2>/dev/null || true
    mesh-tv-dlna "$verb" 2>/dev/null &
    continue
  fi
  # Extract URL: "/meshtv <url>" accepts any http(s); a bare message accepts known video hosts
  if printf '%s' "$line" | grep -qiE '/meshtv'; then
    url="$(printf '%s' "$line" | grep -oE 'https?://[^ ]+' | head -1)"
  else
    url="$(printf '%s' "$line" | grep -oE 'https?://(www\.)?(youtube\.com|youtu\.be|vimeo\.com|rutube\.ru)/[^ ]+' | head -1)"
  fi
  [ -z "$url" ] && continue
  # DEDUP: skip a URL identical to the last one fired <120s ago. The TG path can log the same operator
  # message twice (dual getUpdates poller — see tg-dual-poller-409), which otherwise fires two concurrent
  # mesh-tv-dlna runs of the same video and makes it restart. (2026-06-15 operator switch-bug report.)
  DEDUP_FILE="$HOME/.mesh/.url-watch-lastfired"
  nowsec="$(date +%s)"; lf_url=""; lf_t=0
  if [ -f "$DEDUP_FILE" ]; then lf_url="$(sed -n 1p "$DEDUP_FILE" 2>/dev/null)"; lf_t="$(sed -n 2p "$DEDUP_FILE" 2>/dev/null || echo 0)"; fi
  if [ "$url" = "$lf_url" ] && [ "$((nowsec - ${lf_t:-0}))" -lt 120 ]; then
    continue
  fi
  printf '%s\n%s\n' "$url" "$nowsec" > "$DEDUP_FILE"
  # Fire mesh-tv-dlna (no-phone DLNA push to the Bravia)
  t="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  printf '%s  mesh-url-watch@%s  ::  [url-watch] URL from TG → mesh-tv-dlna: %s\n' "$t" "$HOST" "$url" >> "$HOME/.mesh/traces.log"
  MESH_WHO="url-watch@${HOST}" mesh-chat "[url-watch] operator sent URL → playing on TV: $url" 2>/dev/null || true
  mesh-tv-dlna "$url" 2>/dev/null &
done <<< "$new_lines"

wait
