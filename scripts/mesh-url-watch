#!/usr/bin/env bash
# mesh-url-watch — LLM-free reflex: detect video URLs in operator Telegram messages → play on TV.
#
# Watches ~/.mesh/voice-in.log for new TEXT lines. Triggers on either:
#   - a "/meshtv <url>" command (explicit — any http(s) URL), or
#   - a bare video URL (YouTube/youtu.be/vimeo/rutube — convenience, operator's first ask).
# Plays it via mesh-tv-dlna (no-phone DLNA push to the Bravia, verified 2026-06-14 PLAYING).
# Uses a line-offset state file to process only new lines (no re-runs on old content).
#
#   mesh-url-watch        run one pass (for cron wiring)
#   mesh-url-watch --test smoke test (no side effects)
#
# Wiring: cron every minute (minute-lag acceptable; operator posts URL → plays within ~1 min)
# reflex-cadence: * * * * *
# Exit: 0 = ok; 2 = n/a (no voice-in.log or mesh-tv-dlna).
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes"

LOG="$HOME/.mesh/voice-in.log"
OFFSET_FILE="$HOME/.mesh/.url-watch-offset"
QUEUE_FILE="$HOME/.mesh/.tv-queue"
HOST="$(hostname)"

# A voice-in.log TEXT line. mesh-voice-rx stamps FULL ISO-8601 ('2026-06-17T18:16:26Z  TEXT  ...');
# older lines used a bare 'HH:MM:SSZ  TEXT  ...'. Accept BOTH (optional date prefix) so a producer
# format change never silently blinds this reflex again — the 2026-06-17 cross-sense-vocab break that
# left every operator /mesh-tv URL stranded. ONE source of truth, used by the loop AND --test.
TEXT_RE='^([0-9]{4}-[0-9]{2}-[0-9]{2}T)?[0-9]{2}:[0-9]{2}:[0-9]{2}Z  TEXT  '

# Return current TV transport state (PLAYING/STOPPED/UNKNOWN/...) quickly; "" = TV unreachable.
_tv_state() { mesh-tv-dlna status 2>/dev/null | grep -oE 'PLAYING|STOPPED|PAUSED_PLAYBACK|NO_MEDIA_PRESENT|UNKNOWN' | head -1 || echo ""; }

# Dequeue and play the head of the queue (only if TV is not currently playing).
_flush_queue() {
  [ -f "$QUEUE_FILE" ] || return 0
  local next; next="$(head -1 "$QUEUE_FILE" 2>/dev/null)"; [ -n "$next" ] || return 0
  local st; st="$(_tv_state)"
  [ "$st" = "PLAYING" ] && return 0  # still going — leave queue
  # Remove head atomically and play
  local tmp; tmp="$(mktemp)"; tail -n +2 "$QUEUE_FILE" > "$tmp" 2>/dev/null; mv "$tmp" "$QUEUE_FILE"
  [ -s "$QUEUE_FILE" ] || rm -f "$QUEUE_FILE"
  MESH_WHO="url-watch@${HOST}" mesh-chat "[url-watch] TV idle — playing queued URL: $next" 2>/dev/null || true
  printf '%s  mesh-url-watch@%s  ::  [url-watch] flushed queue → mesh-tv-dlna: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$HOST" "$next" >> "$HOME/.mesh/traces.log"
  mesh-tv-dlna "$next" 2>/dev/null &
}

if [ "${1:-}" = "--test" ]; then
  [ -f "$LOG" ] || { echo "smoke-test: n/a (no voice-in.log)"; exit 2; }
  command -v mesh-tv-dlna >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-tv-dlna)"; exit 1; }
  # Falsifiable dry-run (NO cast — never calls mesh-tv-dlna): exercise the two load-bearing regexes
  # against a synthetic FULL-ISO operator line. Was 'files present' only — hollow, it passed even when
  # the matcher was blind to the current log format (the bug that stranded every /mesh-tv URL). This
  # FAILs if TEXT_RE stops matching full-ISO, or the URL extractor stops pulling the youtube link.
  _l='2026-06-17T18:16:26Z  TEXT  /mesh-tv https://m.youtube.com/watch?v=TESTvid01'
  printf '%s' "$_l" | grep -qE "$TEXT_RE" \
    || { echo "smoke-test: FAIL (TEXT_RE blind to full-ISO voice-in line — reflex would skip every URL)"; exit 1; }
  _u="$(printf '%s' "$_l" | grep -oE 'https?://[^ ]+' | head -1)"
  [ "$_u" = "https://m.youtube.com/watch?v=TESTvid01" ] \
    || { echo "smoke-test: FAIL (URL not extracted from /mesh-tv line: got '${_u:-empty}')"; exit 1; }
  # legacy short-timestamp lines must still match (back-compat)
  printf '%s' '18:16:26Z  TEXT  /mesh-tv https://youtu.be/x' | grep -qE "$TEXT_RE" \
    || { echo "smoke-test: FAIL (TEXT_RE dropped legacy HH:MM:SSZ format)"; exit 1; }
  # a VOICE line mentioning a URL must NOT match (we only act on TEXT)
  printf '%s' '2026-06-17T18:16:26Z  VOICE  play https://youtu.be/x' | grep -qE "$TEXT_RE" \
    && { echo "smoke-test: FAIL (TEXT_RE matched a VOICE line — would act on speech)"; exit 1; }
  echo "smoke-test: ok (full-ISO+legacy TEXT match, URL extraction, VOICE-exclusion verified)"; exit 0
fi

[ -f "$LOG" ] || exit 2
command -v mesh-tv-dlna >/dev/null 2>&1 || exit 2

# Read offset (number of lines already processed)
offset=0
[ -f "$OFFSET_FILE" ] && offset="$(cat "$OFFSET_FILE" 2>/dev/null || echo 0)"
total="$(wc -l < "$LOG" 2>/dev/null || echo 0)"

# Truncation-safe marker (operator hardening item #2): if the log SHRANK, it was rotated/truncated out
# from under us — the old absolute-count offset now points past the end (offset > total), which would make
# total <= offset forever (silent event-loop death). Reset to 0 and say so on the board — never silent.
if [ "$total" -lt "$offset" ]; then
  command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="mesh-url-watch@$(hostname)" \
    mesh-chat "[note] mesh-url-watch: voice-in.log shrank (marker was $offset, now $total lines) — marker reset to 0 (log rotated/truncated); re-processing from the top." >/dev/null 2>&1
  offset=0
  total="$(wc -l < "$LOG" 2>/dev/null || echo 0)"   # re-read: the [note] is now IN the log
fi

# Save new offset immediately (even if nothing to do — avoids re-processing on next run)
printf '%s\n' "$total" > "$OFFSET_FILE"

[ "$total" -le "$offset" ] && { _flush_queue; exit 0; }
_flush_queue  # also flush on entry even when there are new lines (TV may have finished)

# Process new lines only
new_lines="$(tail -n +"$((offset + 1))" "$LOG" 2>/dev/null)"
[ -z "$new_lines" ] && exit 0

# Find TEXT lines with video URLs
while IFS= read -r line; do
  # Only process TEXT messages (not VOICE transcriptions — those may mention URLs verbally)
  printf '%s' "$line" | grep -qE "$TEXT_RE" || continue
  # /meshtv or /mesh-tv control verb (pause/resume/stop/play) — playback control, no URL
  verb="$(printf '%s' "$line" | grep -oiE '/mesh-?tv +(pause|resume|stop|play)\b' | grep -oiE '(pause|resume|stop|play)$' | head -1 | tr 'A-Z' 'a-z')"
  if [ -n "$verb" ]; then
    MESH_WHO="url-watch@${HOST}" mesh-chat "[url-watch] operator → TV control: $verb" 2>/dev/null || true
    mesh-tv-dlna "$verb" 2>/dev/null &
    continue
  fi
  # Extract URL: "/meshtv" or "/mesh-tv <url>" accepts any http(s); a bare message accepts known video hosts
  if printf '%s' "$line" | grep -qiE '/mesh-?tv'; then
    url="$(printf '%s' "$line" | grep -oE 'https?://[^ ]+' | head -1)"
  else
    url="$(printf '%s' "$line" | grep -oE 'https?://(www\.)?(youtube\.com|youtu\.be|vimeo\.com|rutube\.ru)/[^ ]+' | head -1)"
  fi
  [ -z "$url" ] && continue
  # DEDUP: skip a URL identical to the last one fired <600s ago. The TG dual-getUpdates poller
  # (tg-dual-poller-409) re-delivers the same message 2–5 min later; 120s was too short and let the
  # second delivery through → same URL queued → "restart" when prior video ended. (2026-06-15 bug.)
  DEDUP_FILE="$HOME/.mesh/.url-watch-lastfired"
  nowsec="$(date +%s)"; lf_url=""; lf_t=0
  if [ -f "$DEDUP_FILE" ]; then lf_url="$(sed -n 1p "$DEDUP_FILE" 2>/dev/null)"; lf_t="$(sed -n 2p "$DEDUP_FILE" 2>/dev/null || echo 0)"; fi
  if [ "$url" = "$lf_url" ] && [ "$((nowsec - ${lf_t:-0}))" -lt 600 ]; then
    continue
  fi
  printf '%s\n%s\n' "$url" "$nowsec" > "$DEDUP_FILE"
  # Check TV state: queue if playing, play immediately if idle (don't interrupt current video)
  tv_st="$(_tv_state)"
  t="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  if [ "$tv_st" = "PLAYING" ]; then
    # Guard: don't enqueue if this URL is already waiting — avoids restart when a dual-poller
    # delivery sneaks past the dedup (e.g. re-sent URL after >600s) and the video is still playing.
    if [ -f "$QUEUE_FILE" ] && grep -qxF "$url" "$QUEUE_FILE" 2>/dev/null; then
      continue
    fi
    printf '%s\n' "$url" >> "$QUEUE_FILE"
    printf '%s  mesh-url-watch@%s  ::  [url-watch] URL queued (TV PLAYING): %s\n' "$t" "$HOST" "$url" >> "$HOME/.mesh/traces.log"
    MESH_WHO="url-watch@${HOST}" mesh-chat "[url-watch] TV playing — URL queued, will play when done: $url" 2>/dev/null || true
  else
    printf '%s  mesh-url-watch@%s  ::  [url-watch] URL from TG → mesh-tv-dlna: %s\n' "$t" "$HOST" "$url" >> "$HOME/.mesh/traces.log"
    MESH_WHO="url-watch@${HOST}" mesh-chat "[url-watch] operator sent URL → playing on TV: $url" 2>/dev/null || true
    mesh-tv-dlna "$url" 2>/dev/null &
  fi
done <<< "$new_lines"

wait
