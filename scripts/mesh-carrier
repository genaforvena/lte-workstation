#!/usr/bin/env bash
# reflex-cadence: */10 * * * *
# reflex-args: --edge
# mesh-carrier — the NIC'S PHYSICAL-LINK sense.
# Reads the kernel's carrier bit and carrier_changes counter for the first non-loopback
# interface with a readable sysfs carrier file. This is distinct from Wi-Fi RSSI and route
# reachability: it tells whether the link layer itself is currently asserted and whether it
# has flapped since the driver registered the interface.
#
#   mesh-carrier          one live reading
#   mesh-carrier --json   machine-readable reading
#   mesh-carrier --edge   emit only when the value changes
#   mesh-carrier --test   classifier fixtures + REAL sysfs read
#
# Honest contract: no readable carrier file is UNKNOWN and exits 2. No default interface,
# link state, or flap count is invented.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6)
export HOME

MESH="${MESH_DIR:-$HOME/.mesh}"
STATE="${MESH_CARRIER_STATE:-$MESH/.carrier-state}"
SYS_NET="${MESH_CARRIER_SYS_NET:-/sys/class/net}"

classify_carrier() {
  local carrier="$1" changes="$2" iface="$3"
  case "$carrier:$changes" in
    1:*[0-9]) printf 'LINK_UP|%s carrier_changes=%s' "$iface" "$changes" ;;
    0:*[0-9]) printf 'LINK_DOWN|%s carrier_changes=%s' "$iface" "$changes" ;;
    *) printf 'UNKNOWN|%s carrier=%s carrier_changes=%s' "$iface" "$carrier" "$changes" ;;
  esac
}

read_carrier() {
  local root="$1" iface dir carrier changes
  for dir in "$root"/*; do
    [ -d "$dir" ] || continue
    iface="${dir##*/}"
    [ "$iface" != lo ] || continue
    [ -r "$dir/carrier" ] || continue
    [ -r "$dir/carrier_changes" ] || continue
    carrier="$(tr -d '[:space:]' < "$dir/carrier" 2>/dev/null)"
    changes="$(tr -d '[:space:]' < "$dir/carrier_changes" 2>/dev/null)"
    case "$carrier:$changes" in
      0:[0-9]*|1:[0-9]*) printf '%s\t%s\t%s\n' "$iface" "$carrier" "$changes"; return 0 ;;
    esac
  done
  return 1
}

if [ "${1:-}" = --test ]; then
  fail=0
  [ "$(classify_carrier 1 0 eth0)" = 'LINK_UP|eth0 carrier_changes=0' ] || fail=1
  [ "$(classify_carrier 0 7 wlan0)" = 'LINK_DOWN|wlan0 carrier_changes=7' ] || fail=1
  [[ "$(classify_carrier x nope eth0)" == UNKNOWN\|* ]] || fail=1
  [ "$fail" = 0 ] || { echo 'smoke-test: FAIL (classifier)'; exit 1; }
  tuple="$(read_carrier "$SYS_NET" 2>/dev/null)" || {
    echo "smoke-test: n/a (no readable non-loopback carrier under $SYS_NET)"
    exit 2
  }
  iface="${tuple%%$'\t'*}"
  rest="${tuple#*$'\t'}"; carrier="${rest%%$'\t'*}"; changes="${rest##*$'\t'}"
  [[ "$carrier" =~ ^[01]$ && "$changes" =~ ^[0-9]+$ ]] || {
    echo "smoke-test: FAIL (live carrier read malformed: $tuple)"; exit 1;
  }
  echo "smoke-test: ok (classifier + REAL carrier read: $iface carrier=$carrier carrier_changes=$changes)"
  exit 0
fi

tuple="$(read_carrier "$SYS_NET" 2>/dev/null)" || {
  mkdir -p "$MESH" 2>/dev/null || true
  printf 'UNKNOWN|no readable non-loopback carrier under %s\n' "$SYS_NET" > "$STATE"
  mesh-state-touch "$STATE"
  echo "mesh-carrier: no readable non-loopback carrier under $SYS_NET — not an alarm" >&2
  exit 2
}
iface="${tuple%%$'\t'*}"
rest="${tuple#*$'\t'}"; carrier="${rest%%$'\t'*}"; changes="${rest##*$'\t'}"
result="$(classify_carrier "$carrier" "$changes" "$iface")"
label="${result%%|*}"; reason="${result#*|}"
previous=""
[ -r "$STATE" ] && previous="$(head -1 "$STATE" 2>/dev/null)"
printf '%s\n' "$result" > "$STATE"
mesh-state-touch "$STATE"

if [ "${1:-}" = --edge ] && [ "$previous" = "$result" ]; then
  exit 0
fi
ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
if [ "${1:-}" = --json ]; then
  printf '{"label":"%s","interface":"%s","carrier":%s,"carrier_changes":%s,"reason":"%s","ts":"%s"}\n' \
    "$label" "$iface" "$carrier" "$changes" "$reason" "$ts"
else
  printf '[carrier-%s] %s — %s\n' "$(printf '%s' "$label" | tr '[:upper:]' '[:lower:]')" "$label" "$reason"
fi
