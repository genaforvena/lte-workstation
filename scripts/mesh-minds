#!/usr/bin/env python3
"""mesh-minds — sense, live, where minds and senses are on the mesh.

A *mind* here is a RUNNING agent process (claude/opencode/codex/gemini/...), not merely an
installed binary: the map shows the engines that are ALIVE on each node, detected by process
(pgrep), so an unused installed binary is not miscounted and a running mind whose bin dir is off
the non-interactive PATH is not missed. claude is tagged (npm) if its running exe is the node/npm
wrapper rather than the native ELF (operator hard rule: native claude always).
The TERMUX-SENSES column reports only phone/termux-api senses (battery/camera/mic/location);
it is NOT the full sense map — linux nodes carry ble/wifi/mic/camera/etc as organs. For the
complete organ/sense picture use mesh-organs (this tool's focus is the MINDS map).
There is no fixed "mind node": mind is a capability, not a host.

This is pure live sensing. Nothing is stored, no registry is maintained — the
mesh is re-perceived from scratch on every call. That is the whole point: the
skeleton senses; it does not coordinate.

Usage:  mesh-minds            # human table
        mesh-minds --json     # machine-readable (for other minds to consume)
"""
import json, os, subprocess, sys, getpass, time, concurrent.futures

import signal

# SIGTERM MUST UNWIND, or every `finally` below is decorative. Python's DEFAULT SIGTERM disposition
# terminates the interpreter WITHOUT running finally blocks, TemporaryDirectory.__exit__ or atexit,
# so a correct-looking cleanup never executes — and the signal is routine here, not hypothetical:
# GNU `timeout` without --foreground signals the whole PROCESS GROUP, which is how mesh-doctor's
# hourly --test sweep reaches this process. sys.exit() from a handler raises SystemExit in the MAIN
# THREAD, and that is what makes try/finally unwind. SIGKILL stays uncatchable — that half is
# mesh-tmp-guard's age sweep, never this. Class + population: mesh-tmp-guard --unwind-scan.
for _sig in (signal.SIGTERM, signal.SIGHUP):
    signal.signal(_sig, lambda _s, _f: sys.exit(128 + _s))


# --test is handled by smoke_test() at the bottom (after the node/probe functions it exercises
# are defined) so the gate can assert the real attached-node path, not just the tailscale base.

def _source_nodes():
    """Ingest ~/.mesh/nodes into os.environ. The file is written in bash-SOURCE syntax
    (`VAR=val; export VAR   # comment`, optional leading `export `, quoted values) but we
    parse it naively — so mirror bash assignment semantics instead of grabbing the raw RHS:
    honor quotes, strip an inline ` #` comment, and stop an UNQUOTED value at the first `;`
    (the statement separator). Without this the trailing `; export VAR  # note` tail gets
    swallowed into the value — e.g. PHONE_USER became 'u0_a380; export PHONE_USER  # ...',
    which ssh rejects as 'remote username contains invalid characters' (the phone went dark)."""
    import shlex
    p = os.path.expanduser("~/.mesh/nodes")
    if not os.path.exists(p): return
    with open(p) as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith("#"): continue
            if line.startswith("export "): line = line[7:].lstrip()
            if "=" not in line: continue
            k, rest = line.split("=", 1)
            k = k.strip()
            if not k or k in os.environ: continue
            quoted = rest.strip()[:1] in ('"', "'")
            try:
                toks = shlex.split(rest, comments=True)   # honors quotes, drops ` #` comment
                v = toks[0] if toks else ""
            except ValueError:
                v = rest.split(" #", 1)[0].strip().strip('"').strip("'")
            if not quoted:
                v = v.split(";", 1)[0]                     # bash: unquoted value ends at `;`
            os.environ[k] = v

_source_nodes()

# Interactive AGENT minds only — the engines that drive a mind channel. ollama/llm are local
# INFERENCE backends (a serving daemon / one-shot CLI), not agentic minds, so they are deliberately
# excluded from the minds map (a running `ollama serve` is a relay backend, not a mind on a node).
AGENTS = ["claude", "opencode", "codex", "gemini", "aider"]


def _user_by_ip():
    """Map ts-ip -> ssh user from the MESH_NODES registry ("label:user@ip ...").
    Peers carry per-node users (phaedra=root, ilya=ilya, router=root); without this
    we'd hardcode the local user and fail auth on every peer that isn't us."""
    m = {}
    for tok in (os.environ.get("MESH_NODES", "") or "").split():
        spec = tok.split(":", 1)[-1]          # drop the label
        if "@" in spec:
            user, ip = spec.split("@", 1)
            if user and ip:
                m[ip] = user
    return m


def _label_by_ip():
    """Map ts-ip -> registry LABEL from MESH_NODES ("label:user@ip ...")."""
    m = {}
    for tok in (os.environ.get("MESH_NODES", "") or "").split():
        if ":" not in tok:
            continue
        label, spec = tok.split(":", 1)
        ip = spec.split("@", 1)[-1] if "@" in spec else spec
        if label and ip:
            m[ip] = label
    return m


def _role_by_label():
    """Map registry LABEL -> role from MESH_ROLES ("label:role ..."). A node whose
    role is anything but 'mind' is HANDS-OFF for minds (card-capability rule, operator
    2026-06-15): its agent BINARIES may be installed for the operator's own use, but the
    mesh must not treat them as mesh minds. Default role is 'mind'."""
    m = {}
    for tok in (os.environ.get("MESH_ROLES", "") or "").split():
        if ":" in tok:
            label, role = tok.split(":", 1)
            if label:
                m[label] = role
    return m

USER_BY_IP = _user_by_ip()
LABEL_BY_IP = _label_by_ip()
ROLE_BY_LABEL = _role_by_label()


def role_of(node):
    """Resolve a node's mesh role. An explicit role on the record wins (a transport-attached
    organ node is declared 'sense' so the mesh is HANDS-OFF minds on it). Otherwise try the
    MESH_NODES label for its ip, then match the hostname against a MESH_ROLES label
    (case-insensitive). Unknown -> 'mind' (the permissive default)."""
    if node.get("role"):
        return node["role"]
    label = LABEL_BY_IP.get(node.get("ip", ""))
    if label and label in ROLE_BY_LABEL:
        return ROLE_BY_LABEL[label]
    host = (node.get("host") or "").lower()
    for lbl, role in ROLE_BY_LABEL.items():
        if lbl.lower() == host or (lbl.lower() in host and len(lbl) > 3):
            return role
    return "mind"
# Fallback resolves even when $USER is unset (cron/mesh-tell/supervise): getpass
# reads the passwd db, so we never emit a bare "@ip" that ssh rejects (rc=255).
DEFAULT_USER = os.environ.get("USER") or getpass.getuser()

# probe runs in the remote (or local) shell; brace param-expansion works in sh/bash/dash.
# MINDS = what is actually RUNNING (live mind processes), not what is merely installed: a node
# carries agent binaries (claude/gemini/codex/opencode) for many reasons, but the minds map must
# show the engines that are ALIVE — `command -v` reported installed noise (e.g. an unused gemini)
# and missed running minds whose bin dir wasn't on the non-interactive login PATH (opencode/codex).
# For claude we also resolve the running exe and tag (npm) if it is NOT the native ELF binary
# (operator hard rule: native claude always, never the npm/node wrapper).
PROBE = r'''
m=""
for a in ''' + " ".join(AGENTS) + r'''; do
  pid=$(pgrep -x "$a" 2>/dev/null | head -1)
  [ -n "$pid" ] || continue
  lbl="$a"
  if [ "$a" = claude ]; then
    exe=$(readlink -f "/proc/$pid/exe" 2>/dev/null)
    case "$exe" in
      *node_modules*|*/node) lbl="claude(npm)" ;;
    esac
  fi
  m="$m $lbl"
done
echo "MINDS:$m"
s=""
for nb in battery:termux-battery-status camera:termux-camera-photo mic:termux-microphone-record location:termux-location; do
  n=${nb%%:*}; b=${nb#*:}; command -v "$b" >/dev/null 2>&1 && s="$s $n"
done
echo "SENSES:$s"
# ORGANS — real sense hardware on the node (honest per-node, not assumed): a node is COMPOSITE —
# even a "mind" node carries senses + compute, and a LAN-only box (the iMac) is a rich sense source.
# OS-aware: cheap /dev+/sys on Linux, networksetup/system_profiler on macOS (Darwin).
o=""
if [ "$(uname 2>/dev/null)" = Darwin ]; then
  hw=$(networksetup -listallhardwareports 2>/dev/null)
  printf '%s' "$hw" | grep -qi "Wi-Fi"     && o="$o wifi"
  # BLE requires Bluetooth 4.0+ hardware; old Macs have BT 2.1 for keyboard/mouse only.
  system_profiler SPBluetoothDataType 2>/dev/null | grep -qi "Low Energy Supported: Yes" && o="$o ble"
  system_profiler SPCameraDataType 2>/dev/null | grep -qi camera     && o="$o cam"
  system_profiler SPAudioDataType  2>/dev/null | grep -qi microphone && o="$o mic"
else
  [ -d /sys/class/bluetooth ] && [ -n "$(ls /sys/class/bluetooth 2>/dev/null)" ] && o="$o ble"
  for w in /sys/class/net/*/wireless; do [ -e "$w" ] && { o="$o wifi"; break; }; done
  ls /dev/video0 >/dev/null 2>&1 && o="$o cam"
  ls /dev/snd/pcmC*c >/dev/null 2>&1 && o="$o mic"
fi
echo "ORGANS:$o"
# ACTUATORS — ways the node can ACT on the world (operator 2026-06-19: a speaker we can speak
# THROUGH is node info too, as much as a mic). These are the other half of cross-validation: an
# actuator on one node drives a sensor on another (speaker→mic, torch→cam). OS-aware, cheap.
ac=""
if [ "$(uname 2>/dev/null)" = Darwin ]; then
  command -v say >/dev/null 2>&1 && ac="$ac voice"          # macOS built-in TTS
  system_profiler SPAudioDataType 2>/dev/null | grep -qi "output" && ac="$ac speaker"
else
  command -v termux-tts-speak >/dev/null 2>&1 && ac="$ac voice"     # android/termux actuators
  command -v termux-vibrate   >/dev/null 2>&1 && ac="$ac vibrate"
  command -v termux-torch     >/dev/null 2>&1 && ac="$ac torch"
  command -v termux-sms-send  >/dev/null 2>&1 && ac="$ac sms"
  command -v termux-infrared-transmit >/dev/null 2>&1 && ac="$ac ir"
  ls /dev/snd/pcmC*p >/dev/null 2>&1 && ac="$ac speaker"           # linux audio-OUT (playback)
  { command -v espeak >/dev/null 2>&1 || command -v spd-say >/dev/null 2>&1; } && ac="$ac voice"
fi
echo "ACTUATORS:$ac"
'''

SSH = ["-o", "BatchMode=yes", "-o", "ConnectTimeout=8", "-o", "StrictHostKeyChecking=no"]


def mesh_nodes():
    out = subprocess.run(["tailscale", "status", "--json"], capture_output=True, text=True).stdout
    d = json.loads(out)
    nodes = []
    me = d.get("Self", {})
    nodes.append({"host": me.get("HostName"), "ip": (me.get("TailscaleIPs") or ["?"])[0],
                  "online": True, "os": me.get("OS"), "self": True})
    best = {}
    for p in d.get("Peer", {}).values():
        if "tag:lte-node" not in (p.get("Tags") or []):
            continue
        host = p.get("HostName")
        rec = {"host": host, "ip": p["TailscaleIPs"][0],
               "online": p.get("Online"), "os": p.get("OS"), "self": False,
               "lastseen": p.get("LastSeen", "")}
        cur = best.get(host)
        if cur is None:
            best[host] = rec
        elif rec["online"] and not cur["online"]:
            best[host] = rec
        elif rec["online"] == cur["online"] and rec["lastseen"] > cur["lastseen"]:
            best[host] = rec
    for rec in best.values():
        rec.pop("lastseen", None)
        nodes.append(rec)
    _resolve_phone_lan(nodes)
    _resolve_lan_present(nodes)
    _merge_lan_nodes(nodes)
    have_hosts = {(n.get("host") or "").lower() for n in nodes}
    # MERGE transport-ATTACHED nodes (operator 2026-07-06 node-def-any-transport: a node is
    # anything touched over ANY transport, not just Tailscale/LAN). A device reached over a
    # non-IP transport (ADB/USB/BLE/serial) THROUGH a gateway node — e.g. the Note 3, whose
    # barometer+camera hang off ds over USB-adb — has no own IP; its senses are DECLARED and its
    # liveness IS the freshness of the artifacts its organs relay onto this node. Without this it
    # surfaced only as a hand-coded reading row, never as a first-class DEVICES entry.
    for an in _attached_nodes():
        if an["host"].lower() in have_hosts:
            continue
        nodes.append(an)
    return nodes


def _merge_lan_nodes(nodes):
    """MERGE LAN / off-Tailscale registry nodes (operator 2026-06-19: a node is defined by
    reachability on ANY path, not Tailscale membership — the iMac is a rich sense source reachable
    only over LAN, and was invisible because it isn't a tag:lte-node peer). Any MESH_NODES entry
    whose ip isn't already represented is added; the probe confirms reach.

    An off-tailnet BODY is represented by its RESOLVED LAN address too (`lan_ip`), so its own
    registry entry does not mint a SECOND row for one physical device — the host-label dedup
    cannot see it ("Redmi 10" from tailscale vs "Redmi" in the registry never matched, so the
    phone was drawn twice: live under the dead TS address, and again offline as a LAN node probed
    on port 22 as a generic host rather than 8022/Termux)."""
    have_ips = {n["ip"] for n in nodes} | {n["lan_ip"] for n in nodes if n.get("lan_ip")}
    have_hosts = {(n.get("host") or "").lower() for n in nodes}
    for tok in (os.environ.get("MESH_NODES", "") or "").split():
        if ":" not in tok:
            continue
        label, spec = tok.split(":", 1)
        if spec == "local":
            continue
        ip = spec.split("@", 1)[-1] if "@" in spec else spec
        if not ip or ip in have_ips or label.lower() in have_hosts:
            continue
        nodes.append({"host": label, "ip": ip, "online": True, "os": None,
                      "self": False, "lan_only": True})
    return nodes


def _resolve_phone_lan(nodes, resolver=None):
    """Resolve the LIVE address of an android BODY that has drifted OFF Tailscale (DHCP) while
    still serving sensors over LAN — its peer entry keeps a TS address that no longer answers
    (measured 2026-08-17: Redmi 10 / 100.103.99.16, online:false, LastSeen 2026-06-26, 100% ping
    loss). Resolved ONCE here rather than inside probe() so the address the node is actually
    reachable at is a property of the RECORD: probe() dials it, the row publishes it on success,
    and the LAN-registry merge dedups against it. Sets `lan_ip` only; never mutates `ip` (an
    unreachable phone must not claim a LAN address it did not answer on)."""
    def _mesh_phone_ip():
        r = subprocess.run(["mesh-phone-ip"], capture_output=True, text=True, timeout=12)
        return (r.stdout.strip().splitlines() or [""])[0].strip() if r.returncode == 0 else ""
    resolver = resolver or _mesh_phone_ip
    for rec in nodes:
        if rec.get("os") != "android" or rec.get("self") or rec.get("online"):
            continue
        try:
            cand = resolver()
        except Exception:
            cand = ""
        if cand and cand != rec["ip"]:
            rec["lan_ip"] = cand
    return nodes


# How hard a LAN-presence probe tries before it is allowed to say "not there". Env-overridable so
# a node on a steadier uplink can spend less, and so the --test can drive the loop without sleeping.
PRESENCE_TRIES  = max(1, int(os.environ.get("MESH_PRESENCE_TRIES", "3")))
PRESENCE_GAP_S  = float(os.environ.get("MESH_PRESENCE_GAP_S", "1.5"))


def _resolve_lan_present(nodes, resolver=None, pinger=None):
    """Mark a NON-phone node that left Tailscale but is still ANSWERING on the LAN.

    `_resolve_phone_lan` above exists because "the phone drifts OFF Tailscale (DHCP) while still
    serving sensors over LAN — its peer entry keeps a TS address that no longer answers". That
    sentence describes the ROUTER verbatim, and the router was excluded by one line: the resolver
    is gated `os != "android"` and dials `mesh-phone-ip`. Measured 2026-08-22 on mesh-home:
    GL-MT3000 / 100.105.241.84 reads online:false, LastSeen 2026-06-19T07:11:27Z, 100% ping loss
    — while 192.168.8.1 answers ICMP at 0% loss and HTTP 200, holds ARP 94:83:c4:68:07:66 on
    wlxbcec43434a22, and IS this node's LAN gateway. The senses harvest, which delegates to this
    prober so there are not two that drift, therefore printed `GL-MT3000  offline` for two months
    about the device carrying its own LAN.

    `offline` is a claim that the device is NOT THERE. The true state is "there, but not
    enumerable over our transport" — and this census already has that word: `unreach`, which is
    what `online and not reached` renders (Redmi 10 wears it today). Being unable to execute on a
    device is a property of OUR transport, not evidence of its absence; collapsing the two is the
    blindness-as-absence failure, and here it silently ran the reach count that the harvest's
    drop-corroborated verdict is computed from.

    The address is NOT guessed: `mesh-peer-addr` is the mesh's one resolver and already applies
    MESH_LAN_FALLBACK ("GL-MT3000:192.168.8.1", added by the operator on 2026-06-19 — the very day
    the router left the tailnet). Five tools consult it; this prober was the one that did not.

    Sets `online` + `lan_ip` ONLY. `reached` is left entirely to the probe, so a router whose SSH
    is dead stays reached:false and enumerates no senses — the row claims presence, never
    capability."""
    def _peer_addr(host):
        r = subprocess.run(["mesh-peer-addr", host], capture_output=True, text=True, timeout=20)
        return (r.stdout.strip().splitlines() or [""])[0].strip() if r.returncode == 0 else ""

    def _ping(ip):
        # TWO packets, not one. `-c 1` makes a single lost datagram the whole evidence base for a
        # verdict word that means "the device is NOT THERE"; `-c 2` returns 0 on either reply.
        return subprocess.run(["ping", "-c", "2", "-W", "2", ip],
                              capture_output=True, timeout=12).returncode == 0

    resolver = resolver or _peer_addr
    pinger = pinger or _ping
    for rec in nodes:
        host = rec.get("host") or ""
        if rec.get("self") or rec.get("online") or rec.get("os") == "android" or not host:
            continue
        try:
            cand = resolver(host)
        except Exception:
            cand = ""
        # A resolver that hands back the same dead TS address has told us nothing — mesh-peer-addr
        # says so out loud ("returning ts addr as a guess") and a guess must not become a verdict.
        if not cand or cand == rec.get("ip"):
            continue
        # RETRY — a presence probe is not a one-packet question on a flapping uplink (2026-08-22).
        # `mesh-minds --json` was measured rendering GL-MT3000 `online:false` with NO lan_ip at
        # 18:52Z and `online:true, lan_present:true` at 19:01Z, nine minutes apart, while the router
        # answered ICMP 0% loss / tcp22 / tcp80 throughout and `ping -c1 -W2 192.168.8.1` scored
        # 30/30 by hand. Nothing about the router changed; OUR sole uplink (the RTL8822BU dongle)
        # went dark 53 times on that day alone, 50-170s a time per `mesh-link-heal`'s RECOVERED
        # tape. A probe issued into one of those windows collapses the row from `unreach` (there,
        # not enumerable over our transport) straight back to `offline` (not there) — the exact
        # verdict this whole function exists to prevent, restored by a transient in OUR OWN radio.
        # probe() one screen down already learned this for the SSH leg (`attempts = 2 if android`,
        # 2026-07-07: a dozing phone drops the FIRST connection and a single-attempt probe reads
        # that as offline). The lesson was applied to the SSH transport and never to the ICMP one.
        # The retry lives HERE, not inside _ping, so the injected test `pinger` is what gets called
        # repeatedly: a retry buried in the default helper is bypassed by every stub, so the fixture
        # could assert nothing about the real path.
        # HONEST BOUND, not a cure: this widens the evidence from one datagram to ~PRESENCE_TRIES
        # spaced attempts, so it clears packet loss and sub-10s micro-flaps. A 60s dark window still
        # renders `offline`, because from inside one we genuinely cannot tell absence from our own
        # blindness — that separation needs a verdict word the renderer does not yet have.
        up = False
        for _attempt in range(PRESENCE_TRIES):
            try:
                up = pinger(cand)
            except Exception:
                up = False
            if up:
                break
            if _attempt + 1 < PRESENCE_TRIES:
                time.sleep(PRESENCE_GAP_S)
        if up:
            rec["lan_ip"] = cand
            rec["lan_present"] = True
            rec["online"] = True
    return nodes


def _finalize_reach(n, probe_ip, lan_phone):
    """Settle a probed node's liveness AND its published address.

    A LAN/off-Tailscale node has no tailscale liveness signal — its reachability IS the probe (we
    optimistically marked it online to attempt one; correct that to the real result).

    And a phone reached over LAN is published AT THE ADDRESS THAT ANSWERED. Keeping the dead TS
    address on an `online` row makes the whole row a lie no display can qualify: the state column
    is a claim about a live device, the IP column names something 100% unreachable, and anyone who
    copies it (ssh, ping, --json consumer) reaches nothing. Only on `reached` — an unreachable
    phone keeps its TS address, where an `offline` row makes no liveness claim about it."""
    if (n.get("lan_only") or lan_phone) and not n.get("lan_present"):
        n["online"] = n["reached"]
    if lan_phone and n["reached"]:
        n["ip"] = probe_ip
    return n


def _attached_nodes():
    """Parse MESH_ATTACHED_NODES (~/.mesh/nodes) into transport-attached node records. Format is
    space-separated tokens, one per node:
        label|transport|senses_csv|freshspec_csv[|actuators_csv]
    where each freshspec is  path:ttl_seconds . The node carries no IP (reached via its gateway's
    transport); probe() derives reach from artifact freshness rather than SSH.

    The 5th field is OPTIONAL and additive — a 4-field token keeps parsing exactly as before, with
    an empty actuator set. It exists because an attached node had NO WAY to declare an actuator at
    all: the SSH probe's ACTUATORS: block only runs on nodes we can log into, so every ADB/USB/BLE
    organ node was hard-coded actuator-less. That is a FALSE ABSENCE, not a fact about the device —
    mesh-sense-map's ACTIVE lane (actuator on one node -> sensor on another) consequently rendered
    "(no actuator->sensor pair across 2 devices yet)" on a mesh where the Note 3 speaks through
    `mesh-note3-say` (feature android.hardware.audio.output) and carries a flash
    (android.hardware.camera.flash), with this node holding the mic and cam. A whole cross-check
    lane read structurally empty because the DECLARATION FORMAT could not say the word.

    Declare only what is verified on the device (`adb shell pm list features`), never what the
    hardware "should" have — a declared actuator is a claim mesh-sense-map turns into a proposed
    cross-check."""
    out = []
    for tok in (os.environ.get("MESH_ATTACHED_NODES", "") or "").split():
        parts = tok.split("|")
        if len(parts) < 4:
            continue
        label, transport, senses_csv, fresh_csv = parts[0], parts[1], parts[2], parts[3]
        act_csv = parts[4] if len(parts) > 4 else ""
        senses = [s for s in senses_csv.split(",") if s]
        actuators = [a for a in act_csv.split(",") if a]
        freshspecs = []
        for fs in fresh_csv.split(","):
            if ":" not in fs:
                continue
            path, ttl = fs.rsplit(":", 1)
            try:
                freshspecs.append((os.path.expanduser(path), int(ttl)))
            except ValueError:
                continue
        if not label:
            continue
        out.append({"host": label, "ip": "-", "online": True, "os": None, "self": False,
                    "role": "sense", "attached": True, "transport": transport,
                    "declared_senses": senses, "declared_actuators": actuators,
                    "freshspecs": freshspecs})
    return out


def _attached_probe(node):
    """Reach an attached node from its relayed artifacts: reached iff at least one freshspec is
    within its ttl; online (aging but present) iff any artifact exists at all; else offline. No
    SSH — an unreachable/stale organ renders honestly offline, never a faked reading."""
    import time
    now = time.time()
    any_exist = fresh = False
    for path, ttl in node.get("freshspecs", []):
        try:
            age = now - os.path.getmtime(path)
            any_exist = True
            if age < ttl:
                fresh = True
        except OSError:
            pass
    node["senses"] = list(node.get("declared_senses", []))
    # Declared actuators travel with the senses. Gated on `reached` the same way the RENDERERS gate
    # senses: an unreachable organ must not advertise a way to act on the world.
    node["actuators"] = list(node.get("declared_actuators", [])) if fresh else []
    node["reached"] = fresh
    node["online"] = fresh or any_exist
    return node


def probe(node):
    n = dict(node, minds=[], senses=[], organs=[], actuators=[], reached=False, role=role_of(node))
    # Transport-attached node (ADB/USB/BLE via a gateway): no SSH probe — senses are DECLARED and
    # liveness is the freshness of the artifacts its organs relay onto this node.
    if node.get("attached"):
        return _attached_probe(n)
    # The phone drifts OFF Tailscale (DHCP) but stays LAN-reachable — its Tailscale entry reads
    # online:false while it is in fact serving sensors over LAN. `lan_ip` (resolved once by
    # _resolve_phone_lan) carries the live address, so an off-tailnet-but-LAN-present BODY is
    # probed, not rendered dark across the whole fusion layer.
    lan_phone = bool(node.get("lan_ip")) and not node["online"]
    probe_ip = node.get("lan_ip") or node["ip"]
    if not node["online"] and not lan_phone:
        return n
    try:
        # run through a LOGIN shell (bash -ls reads the probe from stdin) so the
        # full interactive PATH is loaded — otherwise non-interactive ssh misses
        # agents installed under ~/.local, nvm, etc.
        if node["self"]:
            cmd = ["bash", "-ls"]
        elif node["os"] == "android":
            phone_port = os.environ.get("PHONE_SSH_PORT", "8022")
            phone_user = os.environ.get("PHONE_USER", "u0_a380")
            cmd = ["ssh", "-p", phone_port, *SSH, f"{phone_user}@{probe_ip}", "bash -ls"]
        else:
            user = USER_BY_IP.get(node["ip"], DEFAULT_USER)
            cmd = ["ssh", *SSH, f"{user}@{node['ip']}", "bash -ls"]
        # A dozing Android phone commonly drops/times-out the FIRST SSH — the attempt itself wakes
        # the radio — and answers a retry; a single-attempt probe reads that as offline, so the only
        # embodied node flaps dark for a whole cache cycle (2026-07-07: Redmi online at 03:04, dark
        # in the 03:30 refresh, sshd answering fine at 03:42; same class as the mag/gyro -n 2 race).
        attempts = 2 if node["os"] == "android" else 1
        for _ in range(attempts):
            try:
                r = subprocess.run(cmd, input=PROBE, capture_output=True, text=True, timeout=20)
            except Exception:
                continue
            for line in r.stdout.splitlines():
                if line.startswith("MINDS:"):
                    n["minds"] = line[6:].split(); n["reached"] = True
                elif line.startswith("SENSES:"):
                    n["senses"] = line[7:].split()
                elif line.startswith("ORGANS:"):
                    n["organs"] = line[7:].split()
                elif line.startswith("ACTUATORS:"):
                    n["actuators"] = line[10:].split()
            if n["reached"]:
                break
    except Exception:
        pass
    return _finalize_reach(n, probe_ip, lan_phone)


def capabilities(r):
    """A node is COMPOSITE — it offers a SET of capability classes, not one role (operator
    2026-06-19: 'a node shouldn't have a role'). Derive the set honestly from what we actually
    probed: compute (any reached node is a computer), senses (real organs/termux senses found),
    minds (mesh runs minds here AND an engine is alive). The MESH_ROLES 'compute' tag is NOT the
    node's identity — it is only a minds-participation OFF switch, so a minds-off node still
    truthfully shows compute + whatever senses it has."""
    caps = []
    has_senses = bool(r.get("organs") or r.get("senses"))
    if r.get("mesh_mind") and r.get("minds"):
        caps.append("minds")
    if has_senses:
        caps.append("senses")
    if r.get("actuators"):
        caps.append("actuators")
    # compute only if we actually reached + ran a shell on it — a transport-attached organ node
    # (reach = relayed-artifact freshness, no login) offers senses, NOT compute to the mesh.
    if r.get("reached") and not r.get("attached"):
        caps.append("compute")
    return caps


def smoke_test():
    import shutil, tempfile, time
    if not shutil.which('ssh'):
        print("smoke-test: FAIL (ssh missing)"); sys.exit(1)
    if not shutil.which('tailscale'):
        print("smoke-test: FAIL (tailscale missing)"); sys.exit(1)
    try:
        out = subprocess.run(["tailscale", "status", "--json"], capture_output=True, text=True, check=True).stdout
        d = json.loads(out)
        me = d.get("Self", {})
        host = me.get("HostName", "")
        ip = (me.get("TailscaleIPs") or [""])[0]
        if not host or not ip.startswith("100."):
            print(f"smoke-test: FAIL (bad self peer base: {host}|{ip})"); sys.exit(1)
    except Exception as e:
        print(f"smoke-test: FAIL (tailscale parse failed: {e})"); sys.exit(1)
    # OFF-TAILNET BODY gate (2026-08-17): one physical phone, ONE row, published at the address
    # that answered. Drives the real functions with a stub resolver — no phone required.
    saved_nodes = os.environ.get("MESH_NODES")
    os.environ["MESH_NODES"] = "Redmi:u0_a380@192.168.8.146 imac:ilya@192.168.8.214"
    try:
        peer = {"host": "Redmi 10", "ip": "100.103.99.16", "online": False,
                "os": "android", "self": False}
        _resolve_phone_lan([peer], resolver=lambda: "192.168.8.146")
        if peer.get("lan_ip") != "192.168.8.146":
            print(f"smoke-test: FAIL (off-tailnet phone lan_ip unresolved: {peer.get('lan_ip')})"); sys.exit(1)
        # (a) the registry entry for the SAME device must not mint a second row; an unrelated LAN
        #     node still must (else the dedup would be a blanket suppressor, not a dedup).
        merged = _merge_lan_nodes([dict(peer)])
        dupes = [n for n in merged if n["ip"] == "192.168.8.146"]
        if dupes:
            print(f"smoke-test: FAIL (off-tailnet phone drawn twice: {[n['host'] for n in merged]})"); sys.exit(1)
        if not any(n["ip"] == "192.168.8.214" for n in merged):
            print(f"smoke-test: FAIL (unrelated LAN node lost to dedup: {[n['ip'] for n in merged]})"); sys.exit(1)
        # (b) reached over LAN -> online AND published at the answering address, never the dead TS one
        got = _finalize_reach(dict(peer, reached=True, online=False), "192.168.8.146", True)
        if not (got["online"] and got["ip"] == "192.168.8.146"):
            print(f"smoke-test: FAIL (live phone published dead/offline: {got['ip']}|{got['online']})"); sys.exit(1)
        # (c) NOT reached -> offline, and it must not claim the LAN address it never answered on
        got = _finalize_reach(dict(peer, reached=False, online=False), "192.168.8.146", True)
        if got["online"] or got["ip"] != "100.103.99.16":
            print(f"smoke-test: FAIL (unreached phone claims reach: {got['ip']}|{got['online']})"); sys.exit(1)

        # OFF-TAILNET NON-PHONE (the router, 2026-08-22): present on the LAN, not enumerable over
        # our transport. `offline` claims the device is NOT THERE; the honest word is `unreach`,
        # which the harvest renders from online=True/reached=False. Stub resolver+pinger — no
        # router required.
        rtr = {"host": "GL-MT3000", "ip": "100.105.241.84", "online": False, "os": "linux",
               "self": False}
        _resolve_lan_present([rtr], resolver=lambda h: "192.168.8.1", pinger=lambda ip: True)
        if not (rtr.get("online") and rtr.get("lan_present") and rtr.get("lan_ip") == "192.168.8.1"):
            print(f"smoke-test: FAIL (LAN-present router still dark: {rtr})"); sys.exit(1)
        if rtr.get("reached"):
            print("smoke-test: FAIL (presence was promoted to reach — a pingable router is not an enumerable one)"); sys.exit(1)
        # (e) a LAN address that does NOT answer must change nothing — presence is the PING, not
        #     the map entry (a declared fallback is not a reachable host).
        rtr2 = {"host": "GL-MT3000", "ip": "100.105.241.84", "online": False, "os": "linux",
                "self": False}
        _resolve_lan_present([rtr2], resolver=lambda h: "192.168.8.1", pinger=lambda ip: False)
        if rtr2.get("online") or rtr2.get("lan_present"):
            print(f"smoke-test: FAIL (unpingable LAN addr claimed presence: {rtr2})"); sys.exit(1)
        # (e2) A FLAKY probe is not an absent device (2026-08-22). Every pinger stub in this
        #      fixture is a CONSTANT — `lambda ip: True` / `lambda ip: False` — so the alphabet
        #      could not express the one case that actually bit: a device that is there, on a link
        #      that drops the first packet. Measured live: `mesh-minds --json` rendered GL-MT3000
        #      `online:false` at 18:52Z and `online:true, lan_present:true` at 19:01Z with the
        #      router answering ICMP/tcp22/tcp80 the whole time, because our own uplink went dark
        #      53 times that day. A constant stub can never fail on that, which is why the leg is
        #      written as a CALL COUNTER, not another lambda: it asserts BOTH that the retry
        #      happens and that it is BOUNDED, so "retry until it answers" cannot pass here either.
        calls = {"n": 0}
        def _flaky(ip):
            calls["n"] += 1
            return calls["n"] >= 2          # drops the first packet, answers the second
        rtr_f = {"host": "GL-MT3000", "ip": "100.105.241.84", "online": False, "os": "linux",
                 "self": False}
        _saved_gap = globals()["PRESENCE_GAP_S"]; globals()["PRESENCE_GAP_S"] = 0.0
        try:
            _resolve_lan_present([rtr_f], resolver=lambda h: "192.168.8.1", pinger=_flaky)
            if not (rtr_f.get("online") and rtr_f.get("lan_present")):
                print(f"smoke-test: FAIL (a device that answered the SECOND packet read as absent: "
                      f"{rtr_f} after {calls['n']} attempt(s) — the presence probe is not retrying)")
                sys.exit(1)
            if calls["n"] != 2:
                print(f"smoke-test: FAIL (retry did not stop on the first success: {calls['n']} calls)")
                sys.exit(1)
            # and the retry must stay BOUNDED — a never-answering address may not be probed forever,
            # nor may the retry manufacture presence out of one.
            dead = {"n": 0}
            def _never(ip):
                dead["n"] += 1
                return False
            rtr_d = {"host": "GL-MT3000", "ip": "100.105.241.84", "online": False, "os": "linux",
                     "self": False}
            _resolve_lan_present([rtr_d], resolver=lambda h: "192.168.8.1", pinger=_never)
            if rtr_d.get("online") or rtr_d.get("lan_present"):
                print(f"smoke-test: FAIL (retry manufactured presence from a dead address: {rtr_d})")
                sys.exit(1)
            if dead["n"] != PRESENCE_TRIES:
                print(f"smoke-test: FAIL (presence retry unbounded/miscounted: {dead['n']} calls, "
                      f"PRESENCE_TRIES={PRESENCE_TRIES})")
                sys.exit(1)
        finally:
            globals()["PRESENCE_GAP_S"] = _saved_gap
        # (f) a resolver echoing the dead TS address has told us nothing — never a verdict.
        rtr3 = {"host": "GL-MT3000", "ip": "100.105.241.84", "online": False, "os": "linux",
                "self": False}
        _resolve_lan_present([rtr3], resolver=lambda h: "100.105.241.84", pinger=lambda ip: True)
        if rtr3.get("online") or rtr3.get("lan_present"):
            print(f"smoke-test: FAIL (ts-addr guess accepted as LAN presence: {rtr3})"); sys.exit(1)
        # (g) the phone lane is untouched: android stays with _resolve_phone_lan, and a node
        #     already online is never re-probed.
        ph = {"host": "Redmi 10", "ip": "100.103.99.16", "online": False, "os": "android",
              "self": False}
        up = {"host": "phaedra", "ip": "100.94.116.17", "online": True, "os": "linux",
              "self": False}
        _resolve_lan_present([ph, up], resolver=lambda h: "192.168.8.9", pinger=lambda ip: True)
        if ph.get("lan_present") or up.get("lan_present"):
            print(f"smoke-test: FAIL (lan-present lane claimed android/already-online: {ph}|{up})"); sys.exit(1)
        # (h) and the presence must SURVIVE finalize — the lan_only/lan_phone collapse
        #     (online = reached) is exactly what would erase it.
        got = _finalize_reach(dict(rtr, reached=False, lan_only=True), "192.168.8.1", False)
        if not got["online"]:
            print("smoke-test: FAIL (finalize collapsed LAN presence into reach)"); sys.exit(1)
        got = _finalize_reach({"host": "x", "ip": "1.2.3.4", "reached": False, "online": True,
                               "lan_only": True}, "1.2.3.4", False)
        if got["online"]:
            print("smoke-test: FAIL (finalize no longer collapses a plain lan_only node)"); sys.exit(1)
    finally:
        if saved_nodes is None:
            os.environ.pop("MESH_NODES", None)
        else:
            os.environ["MESH_NODES"] = saved_nodes
    # attached-node gate: a declared organ node with a FRESH relayed artifact must parse into a
    # reached, sense-bearing, HANDS-OFF-minds node; a STALE one must render present-but-not-reached.
    # BOTH files are minted inside the try. A with-statement arms its cleanup only once __enter__
    # has RETURNED, so creating either one before the try leaves it stranded by a TERM landing in
    # the gap, with the finally that would remove it not yet reachable.
    fresh_path = stale_path = None
    try:
        with tempfile.NamedTemporaryFile(prefix="mm-attach-", delete=False) as tf:
            fresh_path = tf.name
        stale_path = fresh_path + ".stale"
        open(stale_path, "w").close()
        os.utime(stale_path, (time.time() - 99999, time.time() - 99999))
        os.environ["MESH_ATTACHED_NODES"] = f"probe3|adb-via-test|climate,cam|{fresh_path}:3600,{stale_path}:60"
        attached = _attached_nodes()
        if len(attached) != 1:
            print(f"smoke-test: FAIL (attached parse count={len(attached)})"); sys.exit(1)
        p = probe(attached[0])
        if not (p["reached"] and "climate" in p["senses"] and p["role"] == "sense"):
            print(f"smoke-test: FAIL (fresh attached not reached/sense: {p['reached']},{p['senses']},{p['role']})"); sys.exit(1)
        caps = capabilities(p)
        if "senses" not in caps or "compute" in caps:   # attached organ = senses, NOT compute (no login)
            print(f"smoke-test: FAIL (attached caps wrong: {caps})"); sys.exit(1)
        # 4-field token (no actuators field) must still parse AND must claim NO actuator — the
        # backward-compat half of the additive 5th field.
        if p["actuators"]:
            print(f"smoke-test: FAIL (4-field attached invented actuators: {p['actuators']})"); sys.exit(1)
        # 5-field token: the declared actuators must SURVIVE onto the probed record. Without this
        # leg the whole ACTIVE cross-check lane in mesh-sense-map is structurally unreachable for
        # every transport-attached node, and renders a false "(no actuator->sensor pair)".
        os.environ["MESH_ATTACHED_NODES"] = f"probe3|adb-via-test|climate,cam|{fresh_path}:3600|speaker,torch"
        a = probe(_attached_nodes()[0])
        if not (a["reached"] and set(a["actuators"]) == {"speaker", "torch"}):
            print(f"smoke-test: FAIL (attached actuators dropped: reached={a['reached']} act={a['actuators']})"); sys.exit(1)
        if "actuators" not in capabilities(a):
            print(f"smoke-test: FAIL (attached actuator node not classed as actuators: {capabilities(a)})"); sys.exit(1)
        # ...and an UNREACHED attached node must NOT advertise a way to act on the world (a declared
        # actuator on a stale organ is exactly the faked all-clear the fusion doctrine forbids).
        os.environ["MESH_ATTACHED_NODES"] = f"probe3|adb-via-test|climate|{stale_path}:60|speaker,torch"
        u = probe(_attached_nodes()[0])
        if u["reached"] or u["actuators"]:
            print(f"smoke-test: FAIL (stale attached advertised actuators: reached={u['reached']} act={u['actuators']})"); sys.exit(1)
        # all-stale variant must be present (online) but NOT reached
        os.environ["MESH_ATTACHED_NODES"] = f"probe3|adb-via-test|climate|{stale_path}:60"
        s = probe(_attached_nodes()[0])
        if s["reached"] or not s["online"]:
            print(f"smoke-test: FAIL (stale attached should be online-not-reached: {s['reached']},{s['online']})"); sys.exit(1)
    finally:
        for pth in (fresh_path, stale_path):
            if not pth: continue
            try: os.unlink(pth)
            except OSError: pass
        os.environ.pop("MESH_ATTACHED_NODES", None)
    print("smoke-test: ok"); sys.exit(0)


def main():
    nodes = mesh_nodes()
    with concurrent.futures.ThreadPoolExecutor(max_workers=8) as ex:
        results = list(ex.map(probe, nodes))
    # a node is a MESH mind only if its role is 'mind'; a 'compute'/'sense'/etc node may have
    # agent binaries installed for the operator's own use, but the mesh is HANDS-OFF them.
    for r in results:
        r["mesh_mind"] = (r.get("role", "mind") == "mind")
    for r in results:
        r["caps"] = capabilities(r)
    if "--json" in sys.argv[1:]:
        print(json.dumps(results, indent=2)); return
    w = max((len(r["host"] or "?") for r in results), default=4)
    # COMPOSITE view — a node is the SET of what it offers, not a single role. CAPS = capability
    # classes (minds/senses/compute); MINDS = which engines are alive; SENSES = which organs.
    print(f"{'NODE':<{w}}  {'IP':<15} {'STATE':<8} {'CAPABILITIES':<24} {'MINDS':<22} {'SENSES':<18} ACTUATORS")
    for r in results:
        if not r["online"]:
            state = "offline"
        elif not r["reached"]:
            state = "online?*"   # online per tailscale but unreachable for probe
        else:
            state = "online"
        tag = "*" if r["self"] else " "
        bins = " ".join(r["minds"])
        if r["mesh_mind"]:
            minds_col = bins or "-"
        else:
            # minds-participation OFF here (MESH_ROLES) — the mesh does not run minds on this node;
            # any agent binaries are the operator's own. NOT a statement that the node is single-use.
            minds_col = f"off-mesh ({bins})" if bins else "off-mesh"
        caps_col = "·".join(r["caps"]) or "-"
        senses_col = " ".join(r.get("organs", []) + r.get("senses", [])) or "-"
        act_col = " ".join(r.get("actuators", [])) or "-"
        print(f"{(r['host'] or '?'):<{w}}{tag} {r['ip']:<15} {state:<8} {caps_col:<24} "
              f"{minds_col:<22} {senses_col:<18} {act_col}")
    print("\n* = this node / online?* = up per tailscale but not reachable for a live probe")
    print("A node is COMPOSITE — CAPABILITIES is the SET it offers, not a role. Every reached node is "
          "compute; senses = real organs found; minds only where the mesh runs them.")
    print("'off-mesh' = minds-participation OFF here (MESH_ROLES) — the node is still compute/senses, "
          "the mesh just doesn't drive minds on it. Full organ map: mesh-organs")


if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] == '--test':
        smoke_test()
    main()
