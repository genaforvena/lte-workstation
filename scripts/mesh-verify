#!/usr/bin/env bash
# mesh-verify — the VERIFIER's mechanical hands ($0, no inference). Checks REAL state by artifact,
# not by claim, and prints a PASS/FAIL table. The smart verifier (a claude in the 'verifier' window)
# reads this output + ~/.mesh/PLAN.md + the conversation, and maintains the living plan on top of it.
#
# Right now its focus is the invariant the operator cares about most: every node SURVIVES A REBOOT
# (power off -> power on -> the node revives itself reflexively). It probes each node for the four
# things that must be true for that, plus reflex liveness.
#
#   mesh-verify            audit all nodes -> table on stdout
#   mesh-verify --reboot   only the reboot-survival columns (pre-flight before a power-cycle test)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
if [ "${1:-}" = "--test" ]; then
  for x in date sed grep ip tailscale curl python3 ssh timeout bash; do
    command -v "$x" >/dev/null 2>&1 || { echo "smoke-test: FAIL (no $x)"; exit 1; }
  done
  for t in mesh-selfcare mesh-restore mesh-conn mesh-revive mesh-snapshot mesh-chat; do
    command -v "$t" >/dev/null 2>&1 || { echo "smoke-test: FAIL (no $t)"; exit 1; }
  done
  [ -d "$HOME/.mesh" ] && [ -w "$HOME/.mesh" ] || { echo "smoke-test: FAIL (no writable ~/.mesh)"; exit 1; }
  tailscale status >/dev/null 2>&1 || { echo "smoke-test: FAIL (tailscale status unavailable)"; exit 1; }
  ip route get 1.1.1.1 >/dev/null 2>&1 || { echo "smoke-test: FAIL (no route query)"; exit 1; }
  # Artifact test: run the reboot-survival probe locally (no SSH, no curl) to verify the probe
  # bash is syntactically valid and produces the expected output format. Catches the hollow class
  # where the probe script has a bug but the deps-only test still passes.
  _probe_out="$(export PATH="$HOME/.local/bin:$PATH"; bash -lc '
    export PATH="$HOME/.local/bin:$PATH"
    reb=$(crontab -l 2>/dev/null | grep -q "@reboot.*mesh-restore" && echo Y || echo n)
    tools=Y; for t in mesh-restore mesh-selfcare mesh-conn; do command -v $t >/dev/null 2>&1 || tools=n; done
    echo "reboot=$reb tools=$tools"
  ' 2>/dev/null)" || { echo "smoke-test: FAIL (local probe errored — bash or PATH broken)"; exit 1; }
  printf '%s' "$_probe_out" | grep -qE 'reboot=[Yn]' || { echo "smoke-test: FAIL (probe produced no reboot= field — output format broken)"; exit 1; }
  echo "smoke-test: ok (local probe: $_probe_out)"; exit 0
fi
# node list from ~/.mesh/nodes (MESH_NODES="label:target ...", target=local or user@host); no
# hardcoded IPs, so this plants on any mesh. No config / empty -> just this node (single-node mesh).
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes"
NODES=()
unreach=0
set -f                                        # (review fix #10) split MESH_NODES WITHOUT glob expansion
for _e in ${MESH_NODES:-}; do NODES+=("${_e%%:*} ${_e#*:}"); done
set +f
[ ${#NODES[@]} -eq 0 ] && NODES=("$(hostname) local")
run(){ # run a snippet on a node (local or remote)
  local tgt="$1" snip="$2"
  if [ "$tgt" = local ]; then bash -lc "$snip" 2>/dev/null
  else timeout 25 ssh -o StrictHostKeyChecking=accept-new -o BatchMode=yes -o ConnectTimeout=8 "$tgt" "bash -lc '$snip'" 2>/dev/null; fi
}
PROBE='
export PATH="$HOME/.local/bin:$PATH"
ling=$(loginctl show-user "$(whoami)" 2>/dev/null | grep -qi "Linger=yes" && echo Y || echo n)
reb=$(crontab -l 2>/dev/null | grep -q "@reboot.*mesh-restore" && echo Y || echo n)
cron=$(systemctl is-active cron 2>/dev/null | grep -qx active && echo Y || systemctl is-active cronie 2>/dev/null | grep -qx active && echo Y || echo n)
tools=Y; for t in mesh-restore mesh-selfcare mesh-conn mesh-revive mesh-snapshot mesh-chat; do command -v $t >/dev/null 2>&1 || tools=n; done
sess=$(tmux has-session -t "$(hostname)" 2>/dev/null && echo Y || echo n)
sc=$(mesh-selfcare --once 2>/dev/null | grep -o "tg=[A-Za-z]* inet=[A-Za-z]* mesh=[A-Za-z]*" | head -1)
echo "linger=$ling reboot=$reb cron=$cron tools=$tools session=$sess conn=[${sc:-?}]"
'
echo "=== mesh-verify: reboot-survival + reflexes ($(date -u +%FT%H:%MZ)) ==="
printf "%-15s %-8s %-8s %-7s %-7s %-9s %s\n" NODE LINGER @REBOOT CRON TOOLS SESSION CONNECTIVITY
allpass=1
for entry in "${NODES[@]}"; do
  label="${entry%% *}"; tgt="${entry##* }"
  out="$(run "$tgt" "$PROBE")"
  # UNREACHABLE = can't ASSESS (node down) — track separately from a real ≠Y config gap,
  # else a dead peer reads as "fix your reboot config" forever (false [gap] loop, 2026-06-11).
  if [ -z "$out" ]; then printf "%-15s %s\n" "$label" "UNREACHABLE"; unreach=$((unreach+1)); continue; fi
  ling=$(sed -n 's/.*linger=\([A-Za-z]*\).*/\1/p' <<<"$out")
  reb=$(sed -n 's/.*reboot=\([A-Za-z]*\).*/\1/p' <<<"$out")
  cron=$(sed -n 's/.*cron=\([A-Za-z]*\).*/\1/p' <<<"$out")
  tools=$(sed -n 's/.*tools=\([A-Za-z]*\).*/\1/p' <<<"$out")
  sess=$(sed -n 's/.*session=\([A-Za-z]*\).*/\1/p' <<<"$out")
  conn=$(sed -n 's/.*conn=\(\[[^]]*\]\).*/\1/p' <<<"$out")
  # MESH_VERIFY_SKIP = labels intentionally NOT reboot-managed (e.g. a released VM that's started by
  # hand). Show their state but don't fail the verdict — they're resolvable peers, not active mesh
  # nodes. Stops the false [gap] from ilya's expected @reboot=n (re-added to MESH_NODES for resolution).
  case " ${MESH_VERIFY_SKIP:-} " in *" $label "*)
    printf "%-15s %-8s %-8s %-7s %-7s %-9s %s\n" "$label" "$ling" "$reb" "$cron" "$tools" "$sess" "(released — not reboot-checked)"
    continue ;;
  esac
  printf "%-15s %-8s %-8s %-7s %-7s %-9s %s\n" "$label" "$ling" "$reb" "$cron" "$tools" "$sess" "$conn"
  for v in "$ling" "$reb" "$cron" "$tools"; do [ "$v" = Y ] || allpass=0; done
done
echo

egress_integrity() {
  local fail=0 dev enid country http_code
  dev=$(ip route get 1.1.1.1 2>/dev/null | grep -oP 'dev \K\S+' | head -1)
  enid=$(tailscale debug prefs 2>/dev/null | python3 -c "
import json,sys
try: d=json.load(sys.stdin)
except: sys.exit(1)
print(d.get('ExitNodeID',''))
" 2>/dev/null)
  # Use ifconfig.co (same source as mesh-egress-health) so MESH_EGRESS_ISO works consistently
  # across both tools; ip-api.com was returning a different country for the same IP (e.g. CA
  # vs US for phaedra's datacenter block — GeoIP disagreement 2026-06-15).
  local _eg_j; _eg_j="$(curl -s --max-time 8 https://ifconfig.co/json 2>/dev/null)"
  country="$(printf '%s' "$_eg_j" | python3 -c 'import sys,json;print(json.load(sys.stdin).get("country_iso",""))' 2>/dev/null)"
  http_code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 8 https://api.anthropic.com/v1/messages 2>/dev/null)
  echo "=== egress-integrity ($(hostname)) ==="
  if [ -z "$dev" ]; then
    printf "  %-30s FAIL  (no route)\n" "egress-dev (LAN, not TS/WG)"
    fail=1
  elif [ "$dev" = tailscale0 ] || [[ "$dev" == wg* ]]; then
    printf "  %-30s FAIL  (dev %s)\n" "egress-dev (LAN, not TS/WG)" "$dev"
    fail=1
  else
    printf "  %-30s PASS  (dev %s)\n" "egress-dev (LAN, not TS/WG)" "$dev"
  fi
  if [ -z "$enid" ] || [ "$enid" = null ]; then
    printf "  %-30s PASS  (none)\n" "no-exit-node"
  else
    printf "  %-30s FAIL  (%s)\n" "no-exit-node" "$enid"
    fail=1
  fi
  # Exit-node PROVIDER reboot-survival: if this node ADVERTISES an exit node (offers 0.0.0.0/0),
  # IPv4 forwarding must be PERSISTED, else it reverts to 0 on reboot and the offered route
  # SILENTLY breaks for every consumer. mesh-doctor misses this (forwarding is ON at runtime →
  # 0 FAIL); only a reboot-survival check catches the runtime-on-but-not-persisted gap.
  local advex fwd_rt
  advex=$(tailscale debug prefs 2>/dev/null | python3 -c "
import json,sys
try: d=json.load(sys.stdin)
except: sys.exit(1)
print('1' if '0.0.0.0/0' in (d.get('AdvertiseRoutes') or []) else '0')
" 2>/dev/null)
  if [ "$advex" = 1 ]; then
    fwd_rt=$(cat /proc/sys/net/ipv4/ip_forward 2>/dev/null)
    if grep -rhqE '^[[:space:]]*net\.ipv4\.ip_forward[[:space:]]*=[[:space:]]*1' /etc/sysctl.conf /etc/sysctl.d/ 2>/dev/null; then
      if [ "$fwd_rt" = 1 ]; then
        printf "  %-30s PASS  (runtime=1, persisted)\n" "exit-provider ip_forward"
      else
        printf "  %-30s FAIL  (persisted but runtime=%s — apply: sysctl --system)\n" "exit-provider ip_forward" "${fwd_rt:-?}"
        fail=1
      fi
    elif [ "$fwd_rt" = 1 ]; then
      printf "  %-30s FAIL  (runtime=1 but NOT persisted → reverts to 0 on reboot, exit silently breaks)\n" "exit-provider ip_forward"
      fail=1
    else
      printf "  %-30s FAIL  (runtime=%s, not persisted — exit-node already broken)\n" "exit-provider ip_forward" "${fwd_rt:-?}"
      fail=1
    fi
  fi
  local ccheck acheck _expect_iso="${MESH_EGRESS_ISO:-NL}"
  [ "$country" = "$_expect_iso" ] && ccheck=PASS || { ccheck=FAIL; fail=1; }
  [ "$http_code" = 405 ] && acheck=PASS || { acheck=FAIL; fail=1; }
  printf "  %-30s %s  (country=%s)\n" "country-is-${_expect_iso}" "$ccheck" "${country:-?}"
  printf "  %-30s %s  (api.anthropic.com=%s)\n" "anthropic-reachable" "$acheck" "${http_code:-?}"
  if [ "$fail" = 0 ]; then
    echo "VERDICT: all egress-integrity checks PASS"
  else
    echo "VERDICT: egress-integrity VIOLATED — one or more checks FAIL"
  fi
  echo
  return "$fail"
}

egress_ok=1
egress_integrity && egress_ok=1 || egress_ok=0
if [ "$allpass" = 1 ]; then
  if [ "${unreach:-0}" -gt 0 ]; then echo "VERDICT: ✅ every REACHABLE node will revive itself after a power-cycle ($unreach node(s) UNREACHABLE — can't assess, not a config gap)."
  else echo "VERDICT: ✅ every node will revive itself after a power-cycle."; fi
else echo "VERDICT: ⚠ at least one REACHABLE node is NOT reboot-safe (a column ≠ Y above) — fix before the power test."; fi
[ "$egress_ok" = 0 ] && exit 1
exit 0
