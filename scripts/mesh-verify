#!/usr/bin/env bash
# mesh-verify — the VERIFIER's mechanical hands ($0, no inference). Checks REAL state by artifact,
# not by claim, and prints a PASS/FAIL table. The smart verifier (a claude in the 'verifier' window)
# reads this output + ~/.mesh/PLAN.md + the conversation, and maintains the living plan on top of it.
#
# Right now its focus is the invariant the operator cares about most: every node SURVIVES A REBOOT
# (power off -> power on -> the node revives itself reflexively). It probes each node for the four
# things that must be true for that, plus reflex liveness.
#
#   mesh-verify            audit all nodes -> table on stdout
#   mesh-verify --reboot   only the reboot-survival columns (pre-flight before a power-cycle test)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
# node list from ~/.mesh/nodes (MESH_NODES="label:target ...", target=local or user@host); no
# hardcoded IPs, so this plants on any mesh. No config / empty -> just this node (single-node mesh).
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes"
NODES=()
for _e in ${MESH_NODES:-}; do NODES+=("${_e%%:*} ${_e#*:}"); done
[ ${#NODES[@]} -eq 0 ] && NODES=("$(hostname) local")
run(){ # run a snippet on a node (local or remote)
  local tgt="$1" snip="$2"
  if [ "$tgt" = local ]; then bash -lc "$snip" 2>/dev/null
  else timeout 25 ssh -o StrictHostKeyChecking=accept-new -o BatchMode=yes -o ConnectTimeout=8 "$tgt" "bash -lc '$snip'" 2>/dev/null; fi
}
PROBE='
export PATH="$HOME/.local/bin:$PATH"
ling=$(loginctl show-user "$(whoami)" 2>/dev/null | grep -qi "Linger=yes" && echo Y || echo n)
reb=$(crontab -l 2>/dev/null | grep -q "@reboot.*mesh-restore" && echo Y || echo n)
cron=$(systemctl is-active cron 2>/dev/null | grep -qx active && echo Y || systemctl is-active cronie 2>/dev/null | grep -qx active && echo Y || echo n)
tools=Y; for t in mesh-restore mesh-selfcare mesh-conn mesh-revive mesh-snapshot mesh-chat; do command -v $t >/dev/null 2>&1 || tools=n; done
sess=$(tmux has-session -t "$(hostname)" 2>/dev/null && echo Y || echo n)
sc=$(mesh-selfcare --once 2>/dev/null | grep -o "tg=[A-Za-z]* inet=[A-Za-z]* mesh=[A-Za-z]*" | head -1)
echo "linger=$ling reboot=$reb cron=$cron tools=$tools session=$sess conn=[${sc:-?}]"
'
echo "=== mesh-verify: reboot-survival + reflexes ($(date -u +%FT%H:%MZ)) ==="
printf "%-15s %-8s %-8s %-7s %-7s %-9s %s\n" NODE LINGER @REBOOT CRON TOOLS SESSION CONNECTIVITY
allpass=1
for entry in "${NODES[@]}"; do
  label="${entry%% *}"; tgt="${entry##* }"
  out="$(run "$tgt" "$PROBE")"
  if [ -z "$out" ]; then printf "%-15s %s\n" "$label" "UNREACHABLE"; allpass=0; continue; fi
  ling=$(sed -n 's/.*linger=\([A-Za-z]*\).*/\1/p' <<<"$out")
  reb=$(sed -n 's/.*reboot=\([A-Za-z]*\).*/\1/p' <<<"$out")
  cron=$(sed -n 's/.*cron=\([A-Za-z]*\).*/\1/p' <<<"$out")
  tools=$(sed -n 's/.*tools=\([A-Za-z]*\).*/\1/p' <<<"$out")
  sess=$(sed -n 's/.*session=\([A-Za-z]*\).*/\1/p' <<<"$out")
  conn=$(sed -n 's/.*conn=\(\[[^]]*\]\).*/\1/p' <<<"$out")
  printf "%-15s %-8s %-8s %-7s %-7s %-9s %s\n" "$label" "$ling" "$reb" "$cron" "$tools" "$sess" "$conn"
  for v in "$ling" "$reb" "$cron" "$tools"; do [ "$v" = Y ] || allpass=0; done
done
echo
if [ "$allpass" = 1 ]; then echo "VERDICT: ✅ every reachable node will revive itself after a power-cycle."
else echo "VERDICT: ⚠ at least one node is NOT reboot-safe (a column ≠ Y above) — fix before the power test."; fi