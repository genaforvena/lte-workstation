#!/usr/bin/env bash
# mesh-report — a node's OWN daily account of itself, as ARTIFACT not claim ($0, no inference).
# Each node writes its own report independently (decentralized) and leaves a one-line pointer
# (~/.mesh/report-latest.txt) the steward collects to tell the operator where to look.
#   mesh-report          write today's report + pointer, print it
#   mesh-report --test   smoke test (report substrate + selfcare dependency)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
if [ "${1:-}" = "--test" ]; then
  # tmp fence — task:doctor-test-tmpdir-cleanup-traps. Re-exec the smoke test ONCE under a private
  # TMPDIR and remove it from the PARENT, so the cleanup cannot be lost to the test's own `exit 1`
  # and cannot be clobbered by an EXIT trap the test sets for itself. A nested --test inherits the
  # guard var and skips its own fence (it is already inside one).
  if [ -z "${MESH_TEST_TMPD:-}" ]; then
    MESH_TEST_TMPD="$(mktemp -d)" || { echo "smoke-test: FAIL (tmp fence: mktemp -d)"; exit 1; }
    trap 'rm -rf "$MESH_TEST_TMPD"' EXIT INT HUP TERM
    export MESH_TEST_TMPD TMPDIR="$MESH_TEST_TMPD" TMP="$MESH_TEST_TMPD" TEMP="$MESH_TEST_TMPD"
    _fence_rc=0; "$0" "$@" || _fence_rc=$?; exit "$_fence_rc"
  fi
  for x in date hostname mkdir grep sed tail find basename xargs tr cut whoami; do
    command -v "$x" >/dev/null 2>&1 || { echo "smoke-test: FAIL (no $x)"; exit 1; }
  done
  command -v mesh-selfcare >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-selfcare)"; exit 1; }
  [ -d "$HOME/.mesh" ] && [ -w "$HOME/.mesh" ] || { echo "smoke-test: FAIL (no writable ~/.mesh)"; exit 1; }
  mesh-selfcare --test >/dev/null 2>&1 || { echo "smoke-test: FAIL (mesh-selfcare --test failed)"; exit 1; }
  # dry-run: generate a report to a temp dir and verify the format
  TMP="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
  trap 'rm -rf "$TMP"' EXIT
  MESH="$TMP" DAY="$(date -u +%Y-%m-%d)" HOST="test-host" REPO="$TMP/norepo" \
    DIR="$TMP/reports" F="$TMP/reports/$DAY.md" \
    bash -c '
    mkdir -p "$DIR" "$MESH/knowledge"
    SCOUT="$(mesh-selfcare --once 2>/dev/null)" || SCOUT=""
    {
      echo "# $HOST"; echo
      echo "## alive"
      printf "%s\n" "${SCOUT:-  (none)}"
      echo "## what changed today"
      echo "  commits:"; echo "    (none)"
    } > "$F"
    echo "$HOST | $F | conn:[] | written $(date -u +%H:%MZ)" > "$MESH/report-latest.txt"
    '
  [ -f "$TMP/report-latest.txt" ] || { echo "smoke-test: FAIL (no pointer)"; exit 1; }
  [ -f "$TMP/reports/$(date -u +%Y-%m-%d).md" ] || { echo "smoke-test: FAIL (no report file)"; exit 1; }
  grep -q "^# test-host" "$TMP/reports/$(date -u +%Y-%m-%d).md" || { echo "smoke-test: FAIL (bad header)"; exit 1; }
  echo "smoke-test: ok (deps + mesh-selfcare + report format)"
  exit 0
fi
MESH="$HOME/.mesh"; DIR="$MESH/reports"; mkdir -p "$DIR"
DAY="$(date -u +%Y-%m-%d)"; F="$DIR/$DAY.md"; HOST="$(hostname)"; REPO="$HOME/lte-workstation"
SCOUT="$(mesh-selfcare --once 2>/dev/null)"   # run self-care ONCE (conn checks are slow on tg=DOWN nodes)
{
  echo "# $HOST — daily report $DAY (UTC)"; echo
  echo "## alive & self-care"
  printf '%s\n' "${SCOUT:-  (self-care unavailable)}" | sed 's/^/  /'
  echo "  loops: $(tmux list-windows -t "$HOST" -F '#{window_name}' 2>/dev/null | tr '\n' ' ')"
  echo "  reboot-safe: $(loginctl show-user "$(whoami)" 2>/dev/null | grep -qi Linger=yes && echo 'linger✓' || echo 'linger✗') $(crontab -l 2>/dev/null | grep -q '@reboot.*mesh-restore' && echo '@reboot✓' || echo '@reboot✗')"
  echo
  echo "## what changed today"
  if [ -d "$REPO/.git" ]; then
    echo "  commits:"; ( cd "$REPO" && git log --since="$DAY 00:00" --pretty='    • %s' 2>/dev/null | head -15 ) | grep . || echo "    • (none)"
  fi
  echo "  knowledge changed:"; find "$MESH/knowledge" -name '*.md' -newermt "$DAY 00:00" 2>/dev/null | xargs -rn1 basename 2>/dev/null | sed 's/^/    • /' | grep . || echo "    • (none)"
  echo "  my chat marks:"; grep -aE '\[done\]|\[task\]|\[news\]|\[gap\]' "$MESH/chat.log" 2>/dev/null | grep -a "$HOST" | tail -6 | tr -cd '\11\12\15\40-\176\200-\377' | sed 's/  ::  / /;s/^/    • /' | cut -c1-140 | grep -a . || echo "    • (none)"
  echo "  recent traces:"; tail -5 "$MESH/traces.log" 2>/dev/null | sed 's/^/    • /' | grep . || echo "    • (none)"
} > "$F"
SC="$(printf '%s' "$SCOUT" | grep -o 'tg=[A-Za-z]* inet=[A-Za-z]* mesh=[A-Za-z]*' | head -1)"
NC="$(cd "$REPO" 2>/dev/null && git log --since="$DAY 00:00" --oneline 2>/dev/null | wc -l | tr -d ' ')"
echo "$HOST | $F | conn:[${SC:-?}] commits-today:${NC:-0} | written $(date -u +%H:%MZ)" > "$MESH/report-latest.txt"
cat "$F"
