#!/usr/bin/env bash
# reflex-cadence: */10 * * * *
# reflex-args: --edge
# mesh-acpi-event — chassis ACPI-event sense.
# Reads the kernel's ACPI:Event hardware IRQ counter and joins it with the number of
# currently enabled ACPI wake sources. This exposes firmware-visible chassis activity
# without pretending to identify which source fired.
#
# Honest contract: 0 means both live inputs were read; 2 means unavailable or malformed.
# State is written on every successful run, including stable QUIET, so mtime is liveness.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

MESH="${MESH_DIR:-$HOME/.mesh}"
STATE="${MESH_ACPI_STATE:-$MESH/.acpi-event.state}"
IRQ_PATH="${MESH_ACPI_INTERRUPTS:-/proc/interrupts}"
WAKE_PATH="${MESH_ACPI_WAKEUP:-/proc/acpi/wakeup}"

acpi_irq_total() {
  awk '/ACPI:Event/ {
    n=0
    for (i=2; i<=NF && $i ~ /^[0-9]+$/; i++) n += $i
    print n; found=1; exit
  }
  END { if (!found) exit 2 }' "$IRQ_PATH" 2>/dev/null
}

wake_enabled() {
  awk 'NR > 1 && $3 == "*enabled" { n++ } END { if (NR < 2) exit 2; print n+0 }' \
    "$WAKE_PATH" 2>/dev/null
}

if [ "${1:-}" = --test ]; then
  td="$(mktemp -d)"
  trap 'rm -rf "$td"' EXIT
  printf 'CPU0 CPU1\n  9: 4 3 ACPI:Event\n' >"$td/interrupts"
  printf 'Device S-state Status Sysfs node\nLID0 S3 *enabled pci:lid\nPWRB S3 *disabled pci:pwr\n' >"$td/wakeup"
  got_irq="$(IRQ_PATH="$td/interrupts" acpi_irq_total)"
  got_wake="$(WAKE_PATH="$td/wakeup" wake_enabled)"
  [ "$got_irq" = 7 ] || { echo "smoke-test: FAIL (fixture IRQ total=$got_irq)"; exit 1; }
  [ "$got_wake" = 1 ] || { echo "smoke-test: FAIL (fixture enabled=$got_wake)"; exit 1; }
  live_irq="$(acpi_irq_total 2>/dev/null)" || live_irq=""
  live_wake="$(wake_enabled 2>/dev/null)" || live_wake=""
  if ! [[ "$live_irq" =~ ^[0-9]+$ && "$live_wake" =~ ^[0-9]+$ ]]; then
    echo "smoke-test: n/a (live ACPI:Event or wakeup input unavailable)"
    exit 2
  fi
  echo "smoke-test: ok (fixture parser + REAL ACPI IRQ=$live_irq wakeup inventory=$live_wake)"
  exit 0
fi

irq="$(acpi_irq_total 2>/dev/null)" || { echo "mesh-acpi-event: ACPI:Event IRQ unavailable — n/a" >&2; exit 2; }
wake="$(wake_enabled 2>/dev/null)" || { echo "mesh-acpi-event: ACPI wakeup inventory unavailable — n/a" >&2; exit 2; }

mkdir -p "$(dirname "$STATE")" 2>/dev/null || true
prev_irq=""; prev_label=""
if [ -r "$STATE" ]; then
  prev_irq="$(awk -F= '$1=="irq"{print $2}' "$STATE" 2>/dev/null)"
  prev_label="$(awk -F= '$1=="label"{print $2}' "$STATE" 2>/dev/null)"
fi
case "$prev_irq" in ''|*[!0-9]*) delta=0 ;; *) delta=$((irq - prev_irq)); [ "$delta" -ge 0 ] || delta=0 ;; esac
if [ "$delta" -gt 0 ] && [ "$wake" -gt 0 ]; then label=EVENT
elif [ "$wake" -gt 0 ]; then label=QUIET
else label=UNCOVERED
fi

printf 'irq=%s\nwake_enabled=%s\ndelta=%s\nlabel=%s\nts=%s\n' \
  "$irq" "$wake" "$delta" "$label" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >"$STATE"
mesh-state-touch "$STATE" 2>/dev/null || true

if [ "${1:-}" = --edge ] && [ "$label" = "$prev_label" ]; then exit 0; fi
printf '[acpi-%s] wake_enabled=%s irq_delta=%s irq_total=%s\n' \
  "$(printf '%s' "$label" | tr '[:upper:]' '[:lower:]')" "$wake" "$delta" "$irq"
