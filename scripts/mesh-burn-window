#!/usr/bin/env bash
# orphan-ok: on-demand advisory — consumers (minds-allocation, mesh-generate, any heavy job)
#            call it AT THE MOMENT they are about to burn compute; the answer is only meaningful
#            then, so it is deliberately NOT cron-wired. Writes .burn-window.state every run for a
#            dash to surface; state mtime is always fresh (no change-gating → no false-STALE).
#
# mesh-burn-window — CROSS-SENSE FUSION: "is NOW a good window to run heavy / hot background
# compute?" One verdict no single sensor gives, folding the NODE's capacity with the OPERATOR's
# PHYSICAL consideration — the axis the existing resource tools miss.
#
# THE GAP (audited 2026-07-10): mesh-stress / mesh-resource-guard / mesh-mode all decide "shed?"
# from NODE state alone (thermal, PSI, load, minds). None of them know the operator is sitting a
# metre away in a silent room where spinning the CPU to 98°C = an audible, hot intrusion. This node's
# recurring pain is exactly that: minds cooking the IdeaPad while the operator relaxes nearby. The
# missing signal is the FOOTPRINT one — does burning compute right now COST the operator's comfort?
#
# INPUTS (all read from existing state files — zero re-sensing, cheap to call often):
#   NODE capacity     cpu-throttle.state ($2 THROTTLING|NOMINAL) + .psi.state (CALM|BUSY|STALLED)
#                     + .swap-rate.state ($1 NONE|LIGHT|MODERATE|HEAVY) + .cpu-avgfreq.state
#   OPERATOR use      .kbd-activity.state (IDLE|LIGHT|TYPING) + .screen-state.state (OFF|DIM|NORMAL|BRIGHT)
#   OPERATOR presence .op-home.state (HOME|AWAY|UNCERTAIN) + .room-sense.state ($1 PRESENT|EMPTY|UNCERTAIN)
#   ROOM acoustics    .ambient-level (SILENCE|QUIET|MODERATE|LOUD|CLIPPING)
#
# VERDICTS (the FREE-RUN vs CONSIDERATE split is the genuine synergy — a JOINT pattern that fires on a
# COMBINATION no single input reaches, not a max-selector of the loudest axis):
#   HOLD        node can't take load — throttling OR memory pressure (psi STALLED / swap HEAVY). Node safety.
#   YIELD       operator is ACTIVELY at this node (kbd TYPING or screen NORMAL/BRIGHT) — leave foreground free.
#   CONSIDERATE node ok, operator PRESENT & idle, room QUIET → burn GENTLY: fan-heat would intrude on a
#               silent occupied room. (fires only on present ∧ quiet — neither alone triggers it)
#   FREE-RUN    node ok AND (operator AWAY  OR  room noisy enough to mask the footprint) → ideal burn window.
#
# HONEST-DEGRADE ([[fusion-tools-distinguish-empty-from-failed]]): a MISSING or STALE input renders that
# axis UNKNOWN and appends "(partial)" — never silently counted as favorable. If NODE-capacity itself is
# UNKNOWN we cannot certify safety, so FREE-RUN is capped to CONSIDERATE(partial). An unreachable input is
# visibly different from a genuine calm read — the reason line names every UNKNOWN axis.
#
#   mesh-burn-window            fold → one verdict + reason line
#   mesh-burn-window --json     machine-readable {verdict, partial, axes, reason, ts}
#   mesh-burn-window --edge     emit ONLY on verdict change (post to stdout for a consumer/board)
#   mesh-burn-window --test     assert the joint rules + a live read yields a valid verdict
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

M="$HOME/.mesh"
STATE="$M/.burn-window.state"
FRESH_S="${BURN_WINDOW_FRESH_S:-900}"   # an input older than this is UNKNOWN, not trusted-stale
NOW="${BURN_WINDOW_NOW:-$(date +%s)}"

# read_fresh <file> <field-index> — echo the value if the file is fresh, else UNKNOWN.
# field-index 0 = whole first line (trimmed); N = Nth whitespace/pipe field of the first line.
read_fresh() {
  local f="$1" idx="${2:-0}" mt line
  [ -r "$f" ] || { echo UNKNOWN; return; }
  mt=$(stat -c %Y "$f" 2>/dev/null || echo 0)
  [ $(( NOW - mt )) -le "$FRESH_S" ] || { echo UNKNOWN; return; }
  line=$(head -n1 "$f" 2>/dev/null)
  if [ "$idx" -eq 0 ]; then
    echo "${line%%[|	 ]*}" | tr -d ' \t' ; return   # first token up to space/tab/pipe
  fi
  # split on both whitespace and '|'
  echo "$line" | tr '|' ' ' | awk -v n="$idx" '{print $n}'
}

# classify <throttle> <psi> <swap> <avgfreq> <kbd> <screen> <ophome> <roomsense> <ambient>
# echoes: "<VERDICT>\t<partial 0|1>\t<reason>"
classify() {
  local thr="$1" psi="$2" swap="$3" freq="$4" kbd="$5" scr="$6" home="$7" room="$8" amb="$9"
  local partial=0 unk=()

  # --- NODE capacity ---
  local node="OK"
  [ "$thr" = UNKNOWN ] && { partial=1; unk+=("node-throttle"); }
  if [ "$thr" = THROTTLING ] || [ "$psi" = STALLED ] || [ "$swap" = HEAVY ]; then
    node="HOT"
  elif [ "$psi" = BUSY ] || [ "$swap" = MODERATE ] || { [ "$freq" != NOMINAL ] && [ "$freq" != UNKNOWN ]; }; then
    node="WARM"
  fi

  # --- OPERATOR active use of THIS node ---
  local active=0
  [ "$kbd" = TYPING ] && active=1
  { [ "$scr" = NORMAL ] || [ "$scr" = BRIGHT ]; } && active=1

  # --- OPERATOR physical presence ---
  local present=0
  [ "$room" = PRESENT ] && present=1
  [ "$home" = HOME ] && present=1
  [ "$room" = UNKNOWN ] && [ "$home" = UNKNOWN ] && { partial=1; unk+=("presence"); }

  # --- ROOM acoustics: is it quiet enough that fan/heat would be noticed? ---
  local quiet=0
  { [ "$amb" = SILENCE ] || [ "$amb" = QUIET ]; } && quiet=1
  [ "$amb" = UNKNOWN ] && { partial=1; unk+=("acoustics"); quiet=1; }  # unknown → assume noticeable (conservative)

  local verdict reason
  if [ "$node" = HOT ]; then
    verdict=HOLD;        reason="node HOT (throttle=$thr psi=$psi swap=$swap) — shed, do not add load"
  elif [ "$active" -eq 1 ]; then
    verdict=YIELD;       reason="operator active at node (kbd=$kbd screen=$scr) — leave foreground free"
  elif [ "$present" -eq 1 ] && [ "$quiet" -eq 1 ]; then
    verdict=CONSIDERATE; reason="operator present in a quiet room (room=$room home=$home ambient=$amb) — burn gently, footprint audible"
  else
    verdict=FREE-RUN;    reason="node $node, operator not disturbed (present=$present ambient=$amb) — ideal burn window"
  fi

  # can't certify safety without node-capacity → never a clean FREE-RUN
  if [ "$verdict" = FREE-RUN ] && [ "$thr" = UNKNOWN ]; then
    verdict=CONSIDERATE; reason="node-capacity UNKNOWN — cannot certify safe; $reason"
  fi

  [ "$partial" -eq 1 ] && reason="$reason [partial: ${unk[*]}]"
  printf '%s\t%s\t%s' "$verdict" "$partial" "$reason"
}

fold() {
  local thr psi swap freq kbd scr home room amb
  thr=$(read_fresh  "$M/cpu-throttle.state" 2)
  psi=$(read_fresh  "$M/.psi.state" 0)
  swap=$(read_fresh "$M/.swap-rate.state" 1)
  freq=$(read_fresh "$M/.cpu-avgfreq.state" 0)
  kbd=$(read_fresh  "$M/.kbd-activity.state" 0)
  scr=$(read_fresh  "$M/.screen-state.state" 0)
  home=$(read_fresh "$M/.op-home.state" 0)
  room=$(read_fresh "$M/.room-sense.state" 1)
  amb=$(read_fresh  "$M/.ambient-level" 0)
  local axes="throttle=$thr psi=$psi swap=$swap freq=$freq kbd=$kbd screen=$scr home=$home room=$room ambient=$amb"
  # 4 tab fields — verdict, partial, reason, axes (reason carries no tabs, so this parses cleanly)
  printf '%s\t%s' "$(classify "$thr" "$psi" "$swap" "$freq" "$kbd" "$scr" "$home" "$room" "$amb")" "$axes"
}

emit_state() {  # <verdict> <partial> <axes> — always rewrite (mtime = liveness)
  printf '%s|partial=%s|%s\n' "$1" "$2" "$3" > "$STATE" 2>/dev/null || true
  command -v mesh-state-touch >/dev/null 2>&1 && mesh-state-touch "$STATE" >/dev/null 2>&1 || true
}

case "${1:-}" in
  --test)
    fail() { echo "FAIL: $1"; exit 1; }
    got() { classify "$@" | cut -f1; }
    # HOLD: throttling dominates everything
    [ "$(got THROTTLING CALM LIGHT NOMINAL TYPING BRIGHT HOME PRESENT SILENCE)" = HOLD ] || fail "throttling must be HOLD"
    [ "$(got NOMINAL STALLED LIGHT NOMINAL IDLE OFF AWAY EMPTY LOUD)" = HOLD ] || fail "psi STALLED must be HOLD"
    # YIELD: operator typing on a cool node
    [ "$(got NOMINAL CALM LIGHT NOMINAL TYPING OFF HOME PRESENT LOUD)" = YIELD ] || fail "typing must be YIELD"
    [ "$(got NOMINAL CALM LIGHT NOMINAL IDLE NORMAL HOME PRESENT LOUD)" = YIELD ] || fail "bright screen must be YIELD"
    # THE JOINT RULE: present + quiet → CONSIDERATE; flip room to LOUD (present held) → FREE-RUN
    [ "$(got NOMINAL CALM LIGHT NOMINAL IDLE OFF HOME PRESENT QUIET)" = CONSIDERATE ] || fail "present+quiet must be CONSIDERATE"
    [ "$(got NOMINAL CALM LIGHT NOMINAL IDLE OFF HOME PRESENT LOUD)" = FREE-RUN ] || fail "present+loud must be FREE-RUN (footprint masked)"
    # flip presence away (quiet held) → FREE-RUN : proves BOTH axes are required, not one
    [ "$(got NOMINAL CALM LIGHT NOMINAL IDLE OFF AWAY EMPTY QUIET)" = FREE-RUN ] || fail "away+quiet must be FREE-RUN"
    # HONEST-DEGRADE: node-capacity UNKNOWN can never be a clean FREE-RUN
    v=$(got UNKNOWN CALM LIGHT NOMINAL IDLE OFF AWAY EMPTY LOUD)
    [ "$v" = CONSIDERATE ] || fail "unknown throttle must cap FREE-RUN→CONSIDERATE (got $v)"
    classify UNKNOWN CALM LIGHT NOMINAL IDLE OFF AWAY EMPTY LOUD | grep -q 'partial: node-throttle' || fail "unknown input must be flagged partial"
    # LIVE READ: the real fold must produce a valid verdict token from actual state
    live=$(fold | cut -f1)
    case "$live" in HOLD|YIELD|CONSIDERATE|FREE-RUN) ;; *) fail "live fold produced invalid verdict '$live'";; esac
    echo "PASS (joint-rule + honest-degrade asserted; live verdict=$live)"
    exit 0 ;;
  --json)
    IFS=$'\t' read -r v p r ax < <(fold); emit_state "$v" "$p" "$ax"
    printf '{"verdict":"%s","partial":%s,"axes":"%s","reason":"%s","ts":%s}\n' \
      "$v" "$p" "$ax" "$(echo "$r" | sed 's/"/\\"/g')" "$NOW" ;;
  --edge)
    IFS=$'\t' read -r v p r ax < <(fold)
    prev=$(cut -d'|' -f1 "$STATE" 2>/dev/null || echo "")
    emit_state "$v" "$p" "$ax"
    [ "$v" != "$prev" ] && echo "[burn-window] $v — $r" ;;
  *)
    IFS=$'\t' read -r v p r ax < <(fold); emit_state "$v" "$p" "$ax"
    echo "$v — $r" ;;
esac
