#!/usr/bin/env bash
# reflex-cadence: */5 * * * *
# mesh-nic-multicast — live network multicast exposure from kernel NIC counters.
#
# Signal: the physical interfaces' cumulative multicast-frame counters.  This is a
# real radio/wire observation that the mesh did not previously publish as its own
# sense: zero is a genuine quiet reading, while a missing interface/counter is
# UNKNOWN.  It is deliberately not inferred from bytes, drops, or link state.
#
# Exit 0 = at least one physical interface yielded a valid counter; exit 2 = no
# physical interface/counter was readable.  The counter is cumulative since the
# interface appeared, so this tool reports observed frames, not a made-up rate.
#
# It also publishes the independent rx_nohandler axis: frames received by a
# hardware-backed netdev for which the kernel found no protocol handler.  This
# is not inferred from multicast, bytes, drops, link state, or TCP behavior.
set -u
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME="$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6)"
export HOME

ROOT="${MESH_NIC_MULTICAST_ROOT:-/sys/class/net}"
STATE="${MESH_NIC_MULTICAST_STATE:-$HOME/.mesh/.nic-multicast.state}"
NOHANDLER_STATE="${MESH_NIC_RX_NOHANDLER_STATE:-$HOME/.mesh/.nic-rx-nohandler.state}"

read_snapshot() {
  local root="$1" iface path value total=0 count=0
  shopt -s nullglob
  for path in "$root"/*/statistics/multicast; do
    iface="${path#"$root"/}"; iface="${iface%%/*}"
    [ "$iface" != lo ] || continue
    # A /device symlink identifies a hardware-backed netdev; wireless is the
    # explicit fallback for drivers that do not expose the device symlink.
    [ -e "$root/$iface/device" ] || [ -d "$root/$iface/wireless" ] || continue
    value="$(tr -d '[:space:]' <"$path" 2>/dev/null)" || continue
    case "$value" in ''|*[!0-9]*) continue ;; esac
    total=$((total + value)); count=$((count + 1))
  done
  shopt -u nullglob
  [ "$count" -gt 0 ] || return 2
  printf '%s|%s\n' "$count" "$total"
}

read_nohandler_snapshot() {
  local root="$1" iface path value total=0 count=0
  shopt -s nullglob
  for path in "$root"/*/statistics/rx_nohandler; do
    iface="${path#"$root"/}"; iface="${iface%%/*}"
    [ "$iface" != lo ] || continue
    [ -e "$root/$iface/device" ] || [ -d "$root/$iface/wireless" ] || continue
    value="$(tr -d '[:space:]' <"$path" 2>/dev/null)" || continue
    case "$value" in ''|*[!0-9]*) continue ;; esac
    total=$((total + value)); count=$((count + 1))
  done
  shopt -u nullglob
  [ "$count" -gt 0 ] || return 2
  printf '%s|%s\n' "$count" "$total"
}

classify() {
  case "$1" in
    ''|*[!0-9]*) printf 'UNKNOWN|malformed multicast counter\n'; return 2 ;;
    0) printf 'QUIET|no multicast frames observed in cumulative counters\n' ;;
    *) printf 'ACTIVE|multicast frames observed in cumulative counters\n' ;;
  esac
}

classify_nohandler() {
  case "$1" in
    ''|*[!0-9]*) printf 'UNKNOWN|malformed rx_nohandler counter\n'; return 2 ;;
    0) printf 'QUIET|no unhandled frames observed in cumulative counters\n' ;;
    *) printf 'UNHANDLED|unhandled frames observed in cumulative counters\n' ;;
  esac
}

if [ "${1:-}" = --test ]; then
  td="$(mktemp -d)" || exit 1
  trap 'rm -rf "$td"' EXIT
  mkdir -p "$td/net/enp-test/statistics" "$td/net/wlan-test/statistics" "$td/net/lo/statistics" "$td/device-target"
  ln -s "$td/device-target" "$td/net/enp-test/device"
  mkdir -p "$td/net/wlan-test/wireless"
  printf '7\n' >"$td/net/enp-test/statistics/multicast"
  printf '5\n' >"$td/net/wlan-test/statistics/multicast"
  printf '3\n' >"$td/net/enp-test/statistics/rx_nohandler"
  printf '4\n' >"$td/net/wlan-test/statistics/rx_nohandler"
  printf '999\n' >"$td/net/lo/statistics/multicast"
  snap="$(read_snapshot "$td/net")" || { echo 'smoke-test: FAIL (fixture read)'; exit 1; }
  [ "$snap" = '2|12' ] || { echo "smoke-test: FAIL (fixture snapshot=$snap)"; exit 1; }
  [ "$(classify 0 | cut -d'|' -f1)" = QUIET ] || { echo 'smoke-test: FAIL (QUIET classifier)'; exit 1; }
  [ "$(classify 12 | cut -d'|' -f1)" = ACTIVE ] || { echo 'smoke-test: FAIL (ACTIVE classifier)'; exit 1; }
  nsnap="$(read_nohandler_snapshot "$td/net")" || { echo 'smoke-test: FAIL (rx_nohandler fixture read)'; exit 1; }
  [ "$nsnap" = '2|7' ] || { echo "smoke-test: FAIL (rx_nohandler snapshot=$nsnap)"; exit 1; }
  [ "$(classify_nohandler 0 | cut -d'|' -f1)" = QUIET ] || { echo 'smoke-test: FAIL (rx_nohandler QUIET classifier)'; exit 1; }
  [ "$(classify_nohandler 7 | cut -d'|' -f1)" = UNHANDLED ] || { echo 'smoke-test: FAIL (rx_nohandler UNHANDLED classifier)'; exit 1; }
  if read_snapshot "$td/missing" >/dev/null 2>&1; then
    echo 'smoke-test: FAIL (missing root read succeeded)'; exit 1
  fi
  live="$(MESH_NIC_MULTICAST_ROOT="$ROOT" MESH_NIC_MULTICAST_STATE="$td/live.state" "$0" --json 2>/dev/null)"; rc=$?
  if [ "$rc" -eq 0 ]; then
    printf '%s' "$live" | grep -q '"frames":[0-9]' || { echo "smoke-test: FAIL (live artifact=$live)"; exit 1; }
    printf '%s' "$live" | grep -q '"rx_nohandler":[0-9]' || { echo "smoke-test: FAIL (live rx_nohandler artifact=$live)"; exit 1; }
  elif [ "$rc" -eq 2 ]; then
    printf '%s' "$live" | grep -q 'UNKNOWN' || { echo "smoke-test: FAIL (rc=2 artifact=$live)"; exit 1; }
  else
    echo "smoke-test: FAIL (real read rc=$rc artifact=$live)"; exit 1
  fi
  echo "smoke-test: ok (fixture parsers + REAL multicast and rx_nohandler reads: ${live:-UNKNOWN})"
  exit 0
fi

case "${1:-}" in ''|--json) ;; *) echo "usage: $0 [--json|--test]" >&2; exit 2 ;; esac
snapshot="$(read_snapshot "$ROOT")" || {
  echo "mesh-nic-multicast: UNKNOWN — no physical interface with readable multicast counter under $ROOT" >&2
  exit 2
}
nohandler_snapshot="$(read_nohandler_snapshot "$ROOT")" || {
  echo "mesh-nic-multicast: UNKNOWN — no physical interface with readable rx_nohandler counter under $ROOT" >&2
  exit 2
}
interfaces="${snapshot%%|*}"
frames="${snapshot#*|}"
nohandler_interfaces="${nohandler_snapshot%%|*}"
nohandler_frames="${nohandler_snapshot#*|}"
verdict="$(classify "$frames")"
label="${verdict%%|*}"
reason="${verdict#*|}"
nohandler_verdict="$(classify_nohandler "$nohandler_frames")"
nohandler_label="${nohandler_verdict%%|*}"
nohandler_reason="${nohandler_verdict#*|}"
mkdir -p "$(dirname "$STATE")" 2>/dev/null || exit 1
printf '%s|interfaces=%s|frames=%s|ts=%s\n' "$label" "$interfaces" "$frames" "$(date -u +%FT%TZ)" >"$STATE" || exit 1
printf '%s|interfaces=%s|rx_nohandler=%s|ts=%s\n' "$nohandler_label" "$nohandler_interfaces" "$nohandler_frames" "$(date -u +%FT%TZ)" >"$NOHANDLER_STATE" || exit 1
mesh-state-touch "$STATE" >/dev/null 2>&1 || { echo 'mesh-nic-multicast: UNKNOWN — could not stamp live state' >&2; exit 1; }
mesh-state-touch "$NOHANDLER_STATE" >/dev/null 2>&1 || { echo 'mesh-nic-multicast: UNKNOWN — could not stamp live rx_nohandler state' >&2; exit 1; }
if [ "${1:-}" = --json ]; then
  printf '{"verdict":"%s","interfaces":%s,"frames":%s,"reason":"%s","rx_nohandler_verdict":"%s","rx_nohandler_interfaces":%s,"rx_nohandler":%s,"rx_nohandler_reason":"%s","ts":"%s"}\n' \
    "$label" "$interfaces" "$frames" "$reason" "$nohandler_label" "$nohandler_interfaces" "$nohandler_frames" "$nohandler_reason" "$(date -u +%FT%TZ)"
else
  printf '[nic-multicast] %s — interfaces=%s frames=%s (%s)\n' "$label" "$interfaces" "$frames" "$reason"
  printf '[nic-rx-nohandler] %s — interfaces=%s rx_nohandler=%s (%s)\n' "$nohandler_label" "$nohandler_interfaces" "$nohandler_frames" "$nohandler_reason"
fi
