#!/usr/bin/env bash
# reflex-cadence: */5 * * * *
# reflex-args: --json
# doctor-artifact: $HOME/.mesh/.nic-rx-nohandler.state 1800 sys
# mesh-nic-multicast — kernel NIC rx_nohandler sense.
# Reads cumulative frames received by a hardware-backed netdev for which the
# kernel found no protocol handler. Zero is real; absent/malformed sysfs is
# unreachable (exit 2), never a fabricated value.
set -u
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME="$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6)"
export HOME
ROOT="${MESH_NIC_MULTICAST_ROOT:-/sys/class/net}"
STATE="${MESH_NIC_RX_NOHANDLER_STATE:-$HOME/.mesh/.nic-rx-nohandler.state}"
read_snapshot() {
  local root="$1" iface path value total=0 count=0
  shopt -s nullglob
  for path in "$root"/*/statistics/rx_nohandler; do
    iface="${path#"$root"/}"; iface="${iface%%/*}"
    [ "$iface" != lo ] || continue
    [ -e "$root/$iface/device" ] || [ -d "$root/$iface/wireless" ] || continue
    value="$(tr -d '[:space:]' <"$path" 2>/dev/null)" || continue
    case "$value" in ''|*[!0-9]*) continue ;; esac
    total=$((total + value)); count=$((count + 1))
  done
  shopt -u nullglob
  [ "$count" -gt 0 ] || return 2
  printf '%s|%s\n' "$count" "$total"
}
classify() {
  case "$1" in
    ''|*[!0-9]*) printf 'UNKNOWN|malformed rx_nohandler counter\n'; return 2 ;;
    0) printf 'QUIET|no unhandled frames observed in cumulative counter\n' ;;
    *) printf 'UNHANDLED|unhandled frames observed in cumulative counter\n' ;;
  esac
}
if [ "${1:-}" = --test ]; then
  td="$(mktemp -d)" || exit 1; trap 'rm -rf "$td"' EXIT
  mkdir -p "$td/net/enp-test/statistics" "$td/net/wlan-test/statistics" "$td/device-target"
  ln -s "$td/device-target" "$td/net/enp-test/device"; mkdir -p "$td/net/wlan-test/wireless"
  printf '3\n' >"$td/net/enp-test/statistics/rx_nohandler"; printf '4\n' >"$td/net/wlan-test/statistics/rx_nohandler"
  snap="$(read_snapshot "$td/net")" || { echo 'smoke-test: FAIL (fixture read)'; exit 1; }
  [ "$snap" = '2|7' ] || { echo "smoke-test: FAIL (fixture snapshot=$snap)"; exit 1; }
  [ "$(classify 0 | cut -d'|' -f1)" = QUIET ] || { echo 'smoke-test: FAIL (QUIET classifier)'; exit 1; }
  [ "$(classify 7 | cut -d'|' -f1)" = UNHANDLED ] || { echo 'smoke-test: FAIL (UNHANDLED classifier)'; exit 1; }
  if read_snapshot "$td/missing" >/dev/null 2>&1; then echo 'smoke-test: FAIL (missing root read succeeded)'; exit 1; fi
  live="$(MESH_NIC_MULTICAST_ROOT="$ROOT" MESH_NIC_RX_NOHANDLER_STATE="$td/live.state" "$0" --json 2>/dev/null)"; rc=$?
  if [ "$rc" -eq 0 ]; then
    printf '%s' "$live" | grep -q '"rx_nohandler":[0-9]' || { echo "smoke-test: FAIL (live artifact=$live)"; exit 1; }
  elif [ "$rc" -eq 2 ]; then
    printf '%s' "$live" | grep -q 'UNKNOWN' || { echo "smoke-test: FAIL (rc=2 artifact=$live)"; exit 1; }
  else echo "smoke-test: FAIL (real read rc=$rc artifact=$live)"; exit 1; fi
  echo "smoke-test: ok (fixture parser + REAL rx_nohandler read: ${live:-UNKNOWN})"; exit 0
fi
case "${1:-}" in ''|--json) ;; *) echo "usage: $0 [--json|--test]" >&2; exit 2 ;; esac
snapshot="$(read_snapshot "$ROOT")" || { echo "mesh-nic-multicast: UNKNOWN — no hardware-backed rx_nohandler counter under $ROOT" >&2; exit 2; }
interfaces="${snapshot%%|*}"; frames="${snapshot#*|}"; verdict="$(classify "$frames")"; label="${verdict%%|*}"; reason="${verdict#*|}"
mkdir -p "$(dirname "$STATE")" 2>/dev/null || exit 1; ts="$(date -u +%FT%TZ)"
printf '%s|interfaces=%s|rx_nohandler=%s|ts=%s\n' "$label" "$interfaces" "$frames" "$ts" >"$STATE" || exit 1
mesh-state-touch "$STATE" >/dev/null 2>&1 || { echo 'mesh-nic-multicast: UNKNOWN — could not stamp live state' >&2; exit 1; }
if [ "${1:-}" = --json ]; then
  printf '{"verdict":"%s","interfaces":%s,"rx_nohandler":%s,"reason":"%s","ts":"%s"}\n' "$label" "$interfaces" "$frames" "$reason" "$ts"
else printf '[nic-rx-nohandler] %s — interfaces=%s rx_nohandler=%s (%s)\n' "$label" "$interfaces" "$frames" "$reason"; fi
