#!/usr/bin/env python3
"""Read-only per-mind coordination load report from board and TURN evidence."""
import argparse, datetime as dt, json, os, re, subprocess
from collections import defaultdict

TASK_RE = re.compile(r"(?:\[task\]|\[taking\]|\[done\]|\[rejected\])\s+([^\s:]+(?:/[^\s:]+)*)")
OWNER_RE = re.compile(r"owner:\s*([A-Za-z0-9_-]+)")
ARTIFACT_RE = re.compile(r"artifact=([^\s;]+)")

def stamp(value):
    return dt.datetime.fromisoformat(value.replace("Z", "+00:00"))

def mind_from_prefix(line):
    m = re.match(r"[^ ]+\s+([^@ ]+)(?:@|\s)", line)
    return m.group(1) if m else "unknown"

def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--cutoff", required=True)
    ap.add_argument("--output", required=True)
    args = ap.parse_args()
    cutoff = stamp(args.cutoff)
    mesh = os.environ.get("MESH", os.path.join(os.environ.get("HOME", "/tmp"), ".mesh"))
    repo = os.environ.get("MESH_HLEDGER_REPO", os.path.abspath(os.path.join(os.path.dirname(__file__), "..")))
    board = os.environ.get("MESH_CHAT_LOG", os.path.join(mesh, "chat.log"))
    spend = os.environ.get("MESH_SPEND_LOG", os.path.join(mesh, "spend.log"))
    tasks = {}
    minds = set()
    replay_available = False
    try:
        raw = subprocess.check_output(["mesh-task", "replay", "--json"], text=True, stderr=subprocess.DEVNULL)
        replay = json.loads(raw)
        for data in replay.values():
            chain = data.get("data", data)
            for step in chain.get("steps", []):
                ident = step.get("id")
                if not ident: continue
                started = step.get("started") or step.get("dispatched_at") or args.cutoff
                try: first = stamp(started)
                except ValueError: first = cutoff
                finished = step.get("finished")
                try: terminal = stamp(finished) if finished else None
                except ValueError: terminal = None
                tasks[ident] = {"owner": step.get("owner"), "first": first, "terminal": terminal,
                                "takes": 1 if step.get("status") in ("active", "claimed", "running") else 0,
                                "done": 1 if step.get("status") == "done" else 0,
                                "evidence": 1 if step.get("status") == "done" and step.get("artifact") else 0}
                if step.get("owner"): minds.add(step["owner"])
        replay_available = True
    except (OSError, subprocess.CalledProcessError, json.JSONDecodeError):
        pass
    effort = defaultdict(int)
    tagged_by_mind = defaultdict(set)
    effort_tagged = 0
    effort_total = 0
    unknown = 0
    if not os.path.isfile(board):
        unknown += 1
    else:
        with open(board, encoding="utf-8", errors="replace") as fh:
            for line in fh:
                m = re.match(r"([^ ]+)", line)
                if not m:
                    continue
                try: when = stamp(m.group(1))
                except ValueError: continue
                if when > cutoff: continue
                mind = mind_from_prefix(line)
                marker = re.search(r"\[(task|taking|done|rejected)\]", line)
                ident = TASK_RE.search(line)
                if not marker or not ident: continue
                task_id, kind = ident.group(1), marker.group(1)
                if replay_available and task_id not in tasks: continue
                row = tasks.setdefault(task_id, {"owner": None, "first": when, "terminal": None,
                                                 "takes": 0, "done": 0, "evidence": 0})
                row["first"] = min(row["first"], when)
                owner = OWNER_RE.search(line)
                if owner: row["owner"] = owner.group(1)
                elif kind == "task" and row["owner"] is None: row["owner"] = mind
                if row["owner"]: minds.add(row["owner"])
                if kind == "taking": row["takes"] += 1
                elif kind in ("done", "rejected"):
                    row["terminal"] = when; row["done"] += kind == "done"
                    if kind == "done" and (ARTIFACT_RE.search(line) or "artifact" in line): row["evidence"] = 1
    if not os.path.isfile(spend):
        unknown += 1
    else:
        with open(spend, encoding="utf-8", errors="replace") as fh:
            for line in fh:
                parts = line.split()
                if len(parts) < 3 or parts[1] != "turn": continue
                try: when = stamp(parts[0])
                except ValueError: continue
                if when > cutoff: continue
                effort_total += 1
                tag = next((p[5:] for p in parts[7:] if p.startswith("task:")), None)
                if tag and tag in tasks and tasks[tag]["owner"]:
                    owner = tasks[tag]["owner"]
                    effort[owner] += 1; effort_tagged += 1; tagged_by_mind[owner].add(tag)
    lines = [f"report=mesh-load read_only=true cutoff={args.cutoff}"]
    for mind in sorted(minds):
        owned = [(tid, row) for tid, row in tasks.items() if row["owner"] == mind]
        def age(row): return int(((row["terminal"] or cutoff) - row["first"]).total_seconds())
        task_count = len(owned)
        done = sum(1 for _, row in owned if row["done"])
        evidence = sum(row["evidence"] for _, row in owned)
        reopens = sum(max(0, row["takes"] - 1) for _, row in owned)
        # A task with no explicitly tagged TURN is uncovered, not zero effort.
        unattributed = sum(1 for tid, _ in owned if tid not in tagged_by_mind[mind])
        lines.append(f"mind={mind} tasks={task_count} effort_turns={effort[mind]} age_seconds={max((age(r) for _, r in owned), default=0)} rework_reopen={reopens} completion={done}/{task_count} outcome_evidence={evidence}/{done} unattributed={unattributed} unknown={unknown}")
    lines.append(f"coverage=task_owner={sum(1 for r in tasks.values() if r['owner'])}/{len(tasks)} effort_task_attribution={effort_tagged}/{effort_total} outcome_evidence={sum(r['evidence'] for r in tasks.values())}/{sum(1 for r in tasks.values() if r['done'])}")
    lines.append("load_signal=compare effort_turns, task volume, age, completion and attribution; volume is not quality")
    os.makedirs(os.path.dirname(os.path.abspath(args.output)), exist_ok=True)
    with open(args.output, "w", encoding="utf-8") as fh: fh.write("\n".join(lines) + "\n")
    print(f"mesh-hledger-mind-load: wrote {args.output} cutoff={args.cutoff}")

if __name__ == "__main__": main()
