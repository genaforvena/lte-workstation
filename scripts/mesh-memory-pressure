#!/usr/bin/env bash
# reflex-cadence: */5 * * * *
# mesh-memory-pressure — Linux PSI memory-pressure signal.
#
# This reads the kernel's live pressure-stall-information stream, which describes time that
# tasks were delayed by memory contention. It is a distinct signal from load average and from
# the disk/DRAM throughput senses: pressure is the joint scheduler-visible consequence of
# reclaim, swapping, and contention, not a single capacity counter.
#
# Honest contract:
#   0 = a valid live PSI read was classified and written to STATE
#   2 = /proc/pressure/memory is unreachable or malformed; no reading is invented
#
#   mesh-memory-pressure          one classified line
#   mesh-memory-pressure --json   machine-readable live reading
#   mesh-memory-pressure --test   classifier fixtures + REAL /proc read gate
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"

MESH="${MESH_DIR:-$HOME/.mesh}"
STATE="$MESH/.memory-pressure-state"
PROC_PRESSURE="${MESH_MEMORY_PRESSURE_PROC:-/proc/pressure/memory}"
mkdir -p "$MESH" 2>/dev/null || true

# classify_pressure <some_avg10> <full_avg10> -> LABEL|reason
# A high full-stall share is more severe than some-stall time because all runnable
# tasks were delayed. Inputs are decimal percentages as emitted by PSI.
classify_pressure() {
  local some="${1:-}" full="${2:-}"
  awk -v some="$some" -v full="$full" 'BEGIN {
    if (some !~ /^[0-9]+([.][0-9]+)?$/ || full !~ /^[0-9]+([.][0-9]+)?$/) {
      print "UNKNOWN|invalid PSI averages"; exit
    }
    if (full >= 5)       print "CRITICAL|full=" full "% some=" some "%"
    else if (some >= 20) print "HIGH|full=" full "% some=" some "%"
    else if (some >= 5)  print "ELEVATED|full=" full "% some=" some "%"
    else                 print "CALM|full=" full "% some=" some "%"
  }'
}

read_psi() {
  local line some full
  [ -r "$PROC_PRESSURE" ] || return 2
  line="$(cat "$PROC_PRESSURE" 2>/dev/null)" || return 2
  some="$(printf '%s\n' "$line" | awk '$1=="some" {for(i=2;i<=NF;i++) if($i ~ /^avg10=/){sub(/^avg10=/,"",$i); print $i; exit}}')"
  full="$(printf '%s\n' "$line" | awk '$1=="full" {for(i=2;i<=NF;i++) if($i ~ /^avg10=/){sub(/^avg10=/,"",$i); print $i; exit}}')"
  [ -n "$some" ] && [ -n "$full" ] || return 2
  printf '%s|%s|%s\n' "$some" "$full" "$line"
}

if [ "${1:-}" = --test ]; then
  command -v awk >/dev/null 2>&1 || { echo "smoke-test: FAIL (awk unavailable)"; exit 1; }
  [ "$(classify_pressure 0.00 0.00)" = "CALM|full=0.00% some=0.00%" ] || exit 1
  [ "$(classify_pressure 5.00 0.00)" = "ELEVATED|full=0.00% some=5.00%" ] || exit 1
  [ "$(classify_pressure 20.00 0.00)" = "HIGH|full=0.00% some=20.00%" ] || exit 1
  [ "$(classify_pressure 1.00 5.00)" = "CRITICAL|full=5.00% some=1.00%" ] || exit 1
  printf '%s\n' "$(classify_pressure bad 0.00)" | grep -q '^UNKNOWN|' || exit 1
  live="$(read_psi 2>/dev/null || true)"
  [ -n "$live" ] || { echo "smoke-test: n/a (no readable /proc/pressure/memory); classifier ok"; exit 2; }
  IFS='|' read -r some full raw <<< "$live"
  [ -n "$some" ] && [ -n "$full" ] && [ -n "$raw" ] || { echo "smoke-test: FAIL (live PSI parse incomplete)"; exit 1; }
  echo "smoke-test: ok (classifier + REAL memory PSI read some_avg10=$some full_avg10=$full)"
  exit 0
fi

live="$(read_psi 2>/dev/null || true)"
if [ -z "$live" ]; then
  printf 'UNREACHABLE|source=%s|ts=%s\n' "$PROC_PRESSURE" "$(date -u +%FT%TZ)" > "$STATE"
  mesh-state-touch "$STATE" 2>/dev/null || true
  echo "mesh-memory-pressure: UNREACHABLE — no valid live PSI memory read from $PROC_PRESSURE" >&2
  exit 2
fi

IFS='|' read -r some full raw <<< "$live"
result="$(classify_pressure "$some" "$full")"
label="${result%%|*}"
reason="${result#*|}"
ts="$(date -u +%FT%TZ)"
# State is written on every successful run: mtime means ran-live and content is the value.
printf 'label=%s|some_avg10=%s|full_avg10=%s|source=%s|ts=%s\n' \
  "$label" "$some" "$full" "$PROC_PRESSURE" "$ts" > "$STATE"

if [ "${1:-}" = --json ]; then
  printf '{"label":"%s","some_avg10":%s,"full_avg10":%s,"source":"%s","ts":"%s"}\n' \
    "$label" "$some" "$full" "$PROC_PRESSURE" "$ts"
else
  printf '[memory-pressure-%s] %s — some avg10=%s%% full avg10=%s%% (%s)\n' \
    "$(printf '%s' "$label" | tr '[:upper:]' '[:lower:]')" "$label" "$some" "$full" "$reason"
fi
exit 0
