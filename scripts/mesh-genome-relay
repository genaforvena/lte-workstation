#!/usr/bin/env bash
# mesh-genome-relay — RELAY a credential-less peer's landed commits into the genome, THROUGH A GATE.
# reflex-cadence: 17 */6 * * *
# reflex-args: --report
# ONLY --report is wired. It is read-only (fetch + diff-tree + a log line) and its whole point is that
# a peer diverging behind a dead push lane was invisible for 39 days. --apply moves the shared ref and
# stays a hand's decision — a relay that pushed on a timer is the blind pipe this tool exists to refuse.
#
#   mesh-genome-relay                 # --report: what each peer is holding, and the verdict per commit
#   mesh-genome-relay --apply         # relay only the RELAYABLE prefix, then push
#   mesh-genome-relay --peer phaedra  # one peer
#   mesh-genome-relay --test
#
# WHY THIS EXISTS (task phaedra-has-no-push-credential-1228-failures-0-successes-39-days, incident):
# phaedra's git origin carries no credential.helper and no /root/.git-credentials, so every push since
# 2026-07-21T20:48Z died rc=128 "could not read Username" — 1228 failed, 0 succeeded over 39 days. Its
# autopoiesis output never reaches the genome and it re-diverges forever. Two remedies were on the
# table: (B) put a GitHub PAT on phaedra — a PUBLIC-FACING ROOT BOX whose fail2ban is actively banning
# repeat offenders — or (A) relay from a node that already holds a working credential and an ssh remote
# to the peer. (A), because the token stays on one box.
#
# WHY IT IS A GATE AND NOT A PIPE — and this is MEASURED, not a worry (2026-08-30):
# phaedra's ONE unpushed commit, the exact first thing a blind relay would have pushed, is
#   6e7a7826 "mesh-land: land 1 settled stream fix(es): -scripts/mesh-observer-effect"
#   scripts/mesh-observer-effect | 677 -------------------------------------------
# a deletion of a 677-line tool that is ALIVE in origin/main and documented in CLAUDE.md. phaedra is 30
# commits BEHIND; the file was last touched in origin 33 minutes AFTER phaedra minted that deletion.
# Nothing about the commit is malformed — it parses, it is somebody's real landed work — so form gates
# cannot see it. Note what this says about the incident itself: the missing credential is what PREVENTED
# that harm for 39 days, and remedy (B) would have let phaedra push it unattended.
#
# THE GATES, each keyed on CONTENT PROVENANCE against origin/main, never on form:
#   DELETES-LIVE-PATH  the commit deletes a path origin/main still has → a stale tree's absence is not
#                      a decision to remove; the measured case above.
#   REVERTS-NEWER      the commit touches a path origin/main changed AFTER the commit's own parent →
#                      the peer edited an older copy, so relaying it silently reverts newer work.
#   MERGE              a merge commit cannot be replayed onto origin/main by this tool.
# A commit that fails ANY gate stops the relay AT that commit: the ones behind it may depend on it, so
# a gate that skipped and carried on would relay a tree nobody ever had.
set -uo pipefail
GENOME="${MESH_GENOME:-$HOME/lte-workstation}"
LOG="${MESH_RELAY_LOG:-$HOME/.mesh/genome-relay.log}"
PEERS="${MESH_RELAY_PEERS:-phaedra}"
MODE=report; ONLY=""
while [ $# -gt 0 ]; do
  case "$1" in
    --report) MODE=report ;;
    --apply)  MODE=apply ;;
    --peer)   ONLY="${2:-}"; shift ;;
    --test)   MODE=test ;;
    -h|--help) sed -n '2,40p' "$0"; exit 0 ;;
    *) echo "mesh-genome-relay: unknown arg '$1'" >&2; exit 2 ;;
  esac; shift
done

# gate_commit <repo> <sha> <base-ref> → prints "OK" or "HELD:<reason>"; never mutates anything.
gate_commit(){
  local repo="$1" sha="$2" base="$3" p n path older
  n="$(git -C "$repo" rev-list --no-walk --count --merges "$sha" 2>/dev/null || echo 0)"
  [ "${n:-0}" -eq 0 ] || { printf 'HELD:MERGE'; return; }
  p="$(git -C "$repo" rev-parse "$sha^" 2>/dev/null)" || { printf 'HELD:NO-PARENT'; return; }
  # DELETES-LIVE-PATH — a path this commit removes that the base ref still carries.
  while IFS= read -r path; do
    [ -n "$path" ] || continue
    git -C "$repo" cat-file -e "$base:$path" 2>/dev/null && { printf 'HELD:DELETES-LIVE-PATH(%s)' "$path"; return; }
  done < <(git -C "$repo" diff-tree --no-commit-id --name-only --diff-filter=D -r "$sha" 2>/dev/null)
  # REVERTS-NEWER — a path this commit writes that the base changed after this commit's own parent.
  while IFS= read -r path; do
    [ -n "$path" ] || continue
    older="$(git -C "$repo" rev-list --count "$p".."$base" -- "$path" 2>/dev/null || echo 0)"
    [ "${older:-0}" -eq 0 ] || { printf 'HELD:REVERTS-NEWER(%s,+%s)' "$path" "$older"; return; }
  done < <(git -C "$repo" diff-tree --no-commit-id --name-only --diff-filter=ACMR -r "$sha" 2>/dev/null)
  printf 'OK'
}

relay_peer(){
  local peer="$1" repo="$GENOME" base ahead sha verdict subj held=0 n=0 relayable=()
  git -C "$repo" remote get-url "$peer" >/dev/null 2>&1 || { echo "  $peer: NO REMOTE in $repo — nothing to relay from"; return 2; }
  timeout 120 git -C "$repo" fetch -q "$peer" 2>/dev/null || { echo "  $peer: FETCH FAILED (peer unreachable) — UNKNOWN, not empty"; return 2; }
  timeout 120 git -C "$repo" fetch -q origin 2>/dev/null || { echo "  $peer: could not refresh origin/main — refusing to judge provenance against a stale base"; return 2; }
  base=origin/main
  ahead="$(git -C "$repo" rev-list --reverse "$base..$peer/main" 2>/dev/null)"
  [ -n "$ahead" ] || { echo "  $peer: nothing ahead of $base"; return 0; }
  while IFS= read -r sha; do
    [ -n "$sha" ] || continue
    n=$((n+1))
    subj="$(git -C "$repo" log -1 --format=%s "$sha")"
    verdict="$(gate_commit "$repo" "$sha" "$base")"
    printf '  %s %-12s %s\n' "$(git -C "$repo" rev-parse --short "$sha")" "$verdict" "${subj:0:96}"
    case "$verdict" in
      OK) [ "$held" -eq 0 ] && relayable+=("$sha") ;;
      *)  held=1 ;;
    esac
  done <<< "$ahead"
  echo "  $peer: $n ahead · ${#relayable[@]} relayable prefix · held=$held"
  printf '%s peer=%s ahead=%s relayable=%s held=%s mode=%s\n' \
    "$(date -u +%FT%TZ)" "$peer" "$n" "${#relayable[@]}" "$held" "$MODE" >> "$LOG" 2>/dev/null || true
  [ "$MODE" = apply ] || return 0
  [ "${#relayable[@]}" -gt 0 ] || { echo "  $peer: nothing relayable — not pushing"; return 0; }
  local wb="relay/$peer-$(date -u +%Y%m%dT%H%M%SZ)"
  git -C "$repo" branch -f "$wb" "$base" >/dev/null 2>&1 || { echo "  $peer: could not mint $wb"; return 1; }
  local ok=1
  for sha in "${relayable[@]}"; do
    git -C "$repo" cherry-pick -x --keep-redundant-commits "$sha" >/dev/null 2>&1 || { ok=0; git -C "$repo" cherry-pick --abort >/dev/null 2>&1; break; }
  done
  [ "$ok" -eq 1 ] || { echo "  $peer: cherry-pick conflicted — NOT pushing, $wb left for a hand"; return 1; }
  echo "  $peer: relayed ${#relayable[@]} commit(s) onto $wb — push it by hand after review"
}

if [ "$MODE" = test ]; then
  e=0; td="$(mktemp -d)"; trap 'rm -rf "$td"' EXIT
  R="$td/r"; mkdir -p "$R"; git -C "$R" init -q -b main 2>/dev/null || { git init -q "$R"; git -C "$R" checkout -q -b main; }
  git -C "$R" config user.email t@t; git -C "$R" config user.name t
  printf 'alive\n' > "$R/live-tool"; printf 'v1\n' > "$R/shared"
  git -C "$R" add -A; git -C "$R" commit -qm base
  BASE="$(git -C "$R" rev-parse HEAD)"
  # the peer branches from BASE (a stale tree), the base ref moves on afterwards
  git -C "$R" checkout -q -b peer
  git -C "$R" rm -q live-tool; git -C "$R" commit -qm 'land: -live-tool'
  DEL="$(git -C "$R" rev-parse HEAD)"
  git -C "$R" checkout -q peer~1 2>/dev/null; git -C "$R" checkout -q -b peer2
  printf 'v1-peer-edit\n' > "$R/shared"; git -C "$R" commit -qam 'peer edits shared from a stale copy'
  REV="$(git -C "$R" rev-parse HEAD)"
  printf 'clean\n' > "$R/newfile"; git -C "$R" add -A; git -C "$R" commit -qm 'peer adds an untouched file'
  CLEAN="$(git -C "$R" rev-parse HEAD)"
  git -C "$R" checkout -q main
  printf 'v2\n' > "$R/shared"; git -C "$R" commit -qam 'base moves shared forward'
  git -C "$R" branch -f basref main
  # ARM 1 — the MEASURED case: a deletion of a path the base still carries is HELD.
  v="$(gate_commit "$R" "$DEL" basref)"
  case "$v" in HELD:DELETES-LIVE-PATH*) ;; *) echo "FAIL: a commit deleting a path the base still has was not HELD (got '$v') — the phaedra 677-line deletion would have been relayed"; e=$((e+1));; esac
  # ARM 2 — a commit written against an older copy of a path the base has since changed is HELD.
  v="$(gate_commit "$R" "$REV" basref)"
  case "$v" in HELD:REVERTS-NEWER*) ;; *) echo "FAIL: a commit editing a path the base changed after its parent was not HELD (got '$v') — relaying it reverts newer work"; e=$((e+1));; esac
  # ARM 3 — CONTROL: a commit touching nothing the base moved is RELAYABLE. Without this the gates
  # could be holding everything and both arms above would still be green.
  v="$(gate_commit "$R" "$CLEAN" basref)"
  [ "$v" = OK ] || { echo "FAIL: a clean commit touching no contended path was HELD (got '$v') — the gate holds everything and arms 1-2 prove nothing"; e=$((e+1)); }
  # ARM 4 — an unreachable/undeclared peer is UNKNOWN (rc 2), never 'nothing to relay'.
  out="$(MESH_GENOME="$R" relay_peer nosuchpeer 2>&1)"; rc=$?
  [ "$rc" -eq 2 ] && printf '%s' "$out" | grep -q 'NO REMOTE' \
    || { echo "FAIL: an undeclared peer did not render UNKNOWN rc=2 (rc=$rc, out='$out') — a missing remote must not read as 'nothing ahead'"; e=$((e+1)); }
  [ "$e" -eq 0 ] && echo "smoke: ok (4 assertions)" || echo "smoke: FAIL ($e fail(s))"
  exit $([ "$e" -eq 0 ] && echo 0 || echo 1)
fi

echo "=== mesh-genome-relay · $(date -u +%FT%TZ) · mode=$MODE ==="
rc=0
for p in ${ONLY:-$PEERS}; do relay_peer "$p" || rc=$?; done
exit "$rc"
