[Unit]
Description=mesh liveness supervisor loop — folds the liveness crons into one always-on loop (operator 2026-06-21 plan A: kill cron, closed loop). Keeps session/minds/consume-drivers/organs alive; supervised here so it is a LOOP, not a crontab schedule.
After=default.target

[Service]
Type=simple
ExecStart=%h/.local/bin/mesh-liveness-loop
Restart=always
RestartSec=5
# the loop self-caps each task at 110s; give the unit room
TimeoutStopSec=20

[Install]
WantedBy=default.target
