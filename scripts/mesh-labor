#!/usr/bin/env bash
# mesh-labor — a git-versioned DOUBLE-ENTRY ledger of the mesh's LABOR-TIME, on a rolling 5h budget.
#
# Operator premise (2026-07-24): "можно иметь бюджет 5-ти часовой (по примеру claude code) на инференс
# и компьют… считаем-то не деньги-деньги, а труд (по-марксистски)… hledger мы вставили очень наивно."
# Right. mesh-ledger books DOLLARS (imputed market value) and mesh-promises books OBLIGATIONS; both are
# real, but neither is the thing the mesh actually SPENDS. What the mesh spends is LABOUR-TIME — mind
# turns of compute — and it spends it against a rolling 5-hour envelope exactly like Claude Code's limit.
# This tool is the third hledger axis: the unit of account is a TURN, not a dollar.
#
# THE MARXIST UNIT (why TURN): a `turn` is one provider round-trip ≈ one quantum of quota/credit
# (mesh-spend's own definition). It is the mesh's ABSTRACT labour — genome's coding, tg's talking, a
# sense's classifying all reduce to the same fungible TURN in the ledger, the way concrete labours
# reduce to abstract socially-necessary labour-time. The rolling 5h window is the working period; the
# budget cap is the length of that period's available labour-power. We account labour, and we price it
# in nothing but itself.
#
# THE BOARD IS THE JOURNAL (source of truth; the hledger repo is a materialized, tamper-evident view):
#   LABOUR EXPENDED  ~/.mesh/spend.log — each line `<ts> turn <window> <engine> <prov> <tier> <model>`
#                    is ONE turn (mesh-spend samples a rising edge into WORKING per window). This IS the
#                    labour log already; --feed replays it into double entry.
#   WORK STRUCTURE   ~/.mesh/chat.log — the board's `[task]`/`[done]` say WHAT the labour was for.
#                    --branch <slug> intersects a task's open interval with its owner-window's turns:
#                    "how much labour did this branch cost the mesh" — the operator's "на борде можно считать".
#
# CHART (commodity TURN, never mixed with the USD ledger or the PROMISE ledger — separate repo):
#   expenses:labour:<prov>:<window>   (Dr, labour expended by a mind)
#   assets:budget:<prov>              (Cr, drawdown of that provider's labour-power)
#   Each feed = ONE transaction; per-commodity it MUST sum to zero, so a feeder bug that miscounts any
#   leg unbalances the txn and `hledger check` catches it with NO oracle — the same error-detecting-code
#   payoff as mesh-ledger. Every feed tagged  window:<startISO>..<endISO>  → idempotent + auditable.
#
# THE ROLLING 5h BUDGET (the Claude-Code reframe — the headline view):
#   PRIMARY AXIS = INFERENCE (imputed USD), since 2026-07-27 (board task labor-budget-inference): the
#   headline number is the DOLLAR value of the last-5h token flow — mesh-spend --tokens per-model counts
#   priced through mesh-ledger's ONE rate table via `mesh-ledger --price-window` (never a second pricer
#   or a copied rate table here — two copies rot). TURNs stay as SECONDARY axes: the per-window labour
#   table (windows = accounts) and the double-entry journal remain TURN-denominated, because tokens
#   cannot be attributed per-window (JSONL is per-model) while turns can.
#   Cap = MESH_LABOR_BUDGET_USD ($ per rolling 5h, across providers). UNSET → report-only (honest: an
#   invented cap is a faked constant); set it to arm the limit. Derive a proposal with --propose-cap
#   (measured 5h burn history from the ledger's booked feeds) and get OPERATOR APPROVAL before arming.
#   NO dispatch gate consumes the $ axis yet — --availability stays TURN/FIFO by design.
#
#   mesh-labor                 --budget (default): rolling 5h INFERENCE $ budget + TURN table
#   mesh-labor --feed          replay spend.log since the last feed into the journal (idempotent), commit
#   mesh-labor --balance       hledger bal expenses:labour (labour by provider/window, all-time)
#   mesh-labor --branch <slug> labour a board task cost: its owner-window's turns over its open interval
#   mesh-labor --availability  per-window remaining TURN = the routing denominator (score = relevance ×
#                              availability). [--json] for the selector. No cap armed ⇒ null ⇒ FIFO.
#   mesh-labor --propose-cap   derive a proposed $ cap from measured 5h burn history (ledger feeds);
#                              REPORT ONLY — post as [fyi], operator approves before anything arms
#   mesh-labor --register      hledger register of the labour journal (the searchable log)
#   mesh-labor --coupling      participatory-sense-making read: is the minds' labour COUPLED (interaction
#                              has autonomy) or PARALLEL monologues? Cross-recurrence of window turn-series.
#   mesh-labor --check         hledger parity + replay-vs-balance AGREEMENT (the gate)
#   mesh-labor --dash          compact pane summary (for a data window)
#   mesh-labor --json          machine-readable rolling-window budget
#   mesh-labor --test          RED-first: parity gate SEEN to reject an unbalanced txn + budget math
#
# Env: MESH_LABOR_DIR (default ~/.mesh/labour)  MESH_SPEND_LOG (default ~/.mesh/spend.log)
#      MESH_CHAT_LOG (default ~/.mesh/chat.log)  MESH_LABOR_WINDOW_H (rolling window, default 5)
#      MESH_LABOR_BUDGET_USD (rolling $ cap, the PRIMARY axis; unset/0 → report-only)
#      MESH_LABOR_LEDGER_BIN (default mesh-ledger — the pricer; stub knob for --test, since PATH
#        stubs cannot shadow a mesh tool: this script prepends ~/.local/bin to PATH at load)
#      MESH_LABOR_BUDGET_TURNS (per-prov rolling cap; unset/0 → report-only)
#      MESH_LABOR_WINDOW_BUDGET_TURNS (per-WINDOW cap for --availability; unset/0 → FIFO fallback)
#      MESH_LABOR_LOOKBACK_H (first-feed backfill, default = window)
# reflex-cadence: 19 * * * *
# reflex-args: --feed
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
MESH="$HOME/.mesh"
LABOR_DIR="${MESH_LABOR_DIR:-$MESH/labour}"
SPEND_LOG="${MESH_SPEND_LOG:-$MESH/spend.log}"
CHAT_LOG="${MESH_CHAT_LOG:-$MESH/chat.log}"
WATERMARK="$LABOR_DIR/.watermark"
STATE="$MESH/.labor-state"
WINDOW_H="${MESH_LABOR_WINDOW_H:-5}"
LOOKBACK_H="${MESH_LABOR_LOOKBACK_H:-$WINDOW_H}"
BUDGET_TURNS="${MESH_LABOR_BUDGET_TURNS:-0}"
# rolling $ cap (the INFERENCE budget axis). Unset/0 → report-only; never invent a cap.
BUDGET_USD="${MESH_LABOR_BUDGET_USD:-0}"
LEDGER_BIN="${MESH_LABOR_LEDGER_BIN:-mesh-ledger}"
LEDGER_JOURNAL_DIR="${MESH_LEDGER_DIR:-$MESH/ledger}"
# per-WINDOW rolling cap (the account budget the coordination game routes against). Unset/0 →
# report-only: WITHOUT an armed cap there is no budget-based availability, so the routing selector
# MUST fall back to FIFO (the design fail-safe), never invent a fraction.
WINDOW_BUDGET_TURNS="${MESH_LABOR_WINDOW_BUDGET_TURNS:-0}"
RESTORE_ENV="${MESH_RESTORE_ENV:-$MESH/restore.env}"

have(){ command -v "$1" >/dev/null 2>&1; }
git_labor(){ git -C "$LABOR_DIR" -c user.name='mesh-labor' -c user.email='noreply@mesh' "$@"; }
main_journal(){ echo "$LABOR_DIR/mesh.journal"; }
year_journal(){ echo "$LABOR_DIR/$(date -u +%Y).journal"; }
epoch(){ date -u -d "$1" +%s 2>/dev/null || echo 0; }
now_iso(){ date -u +%Y-%m-%dT%H:%M:%SZ; }

ensure_repo(){
  mkdir -p "$LABOR_DIR"
  [ -d "$LABOR_DIR/.git" ] || git_labor init -q 2>/dev/null
  local yr; yr="$(date -u +%Y)"; local yj="$LABOR_DIR/$yr.journal"
  [ -f "$yj" ] || : > "$yj"
  { echo "; mesh-labour — double-entry LABOUR-TIME ledger (commodity TURN, auto-maintained). Do not hand-edit feeds."
    echo "commodity TURN"
    for f in "$LABOR_DIR"/[0-9][0-9][0-9][0-9].journal; do [ -f "$f" ] && echo "include $(basename "$f")"; done
  } > "$(main_journal)"
}
touch_state(){ mkdir -p "$MESH"; now_iso > "$STATE" 2>/dev/null || true; }

# ---- turn-stream parse: emit `<epoch> <prov> <window>` for spend.log lines in (lo_s, hi_s]. ----
turns_between(){  # argv: lo_epoch hi_epoch  (lo exclusive, hi inclusive; lo<0 → no lower bound)
  local lo="$1" hi="$2"
  [ -f "$SPEND_LOG" ] || return 0
  awk -v lo="$lo" -v hi="$hi" '
    $2=="turn" && NF>=6 {
      ts=$1; win=$3; prov=$5;
      # ISO ts (minute granularity, Z) -> epoch via gsub to fields
      # 2026-07-24T11:35Z
      yr=substr(ts,1,4); mo=substr(ts,6,2); dy=substr(ts,9,2); hh=substr(ts,12,2); mm=substr(ts,15,2);
      es=mktime(yr" "mo" "dy" "hh" "mm" 00");
      # mktime is LOCAL; correct to UTC by subtracting the local offset
      es-=OFFSET;
      if (es<=lo && lo>=0) next;
      if (es>hi) next;
      print es" "prov" "win;
    }' OFFSET="$(date +%z | awk '{s=substr($0,1,1); h=substr($0,2,2); m=substr($0,4,2); o=(h*3600+m*60); print (s=="-")?-o:o}')" "$SPEND_LOG"
}

# ============================ FEED ============================
do_feed(){
  have hledger || { echo "mesh-labor --feed: hledger not installed" >&2; exit 2; }
  ensure_repo
  local now now_s wm wm_s
  now="$(now_iso)"; now_s="$(date -u +%s)"
  if [ -f "$WATERMARK" ]; then wm="$(cat "$WATERMARK")"; wm_s="$(epoch "$wm")"; else
    wm_s=$(( now_s - LOOKBACK_H*3600 )); wm="$(date -u -d "@$wm_s" +%Y-%m-%dT%H:%M:%SZ)"; fi

  # too soon (<1 min) — keep liveness honest, book nothing
  if [ $(( now_s - wm_s )) -lt 60 ]; then touch_state; echo "mesh-labor: too soon (last feed $wm)"; exit 0; fi
  # idempotency: this window already booked?
  if grep -qF "window:$wm.." "$(year_journal)" 2>/dev/null; then
    echo "mesh-labor: window $wm already booked — skip"; touch_state; exit 0; fi

  # aggregate turns in (wm_s, now_s] by prov+window
  local agg; agg="$(turns_between "$wm_s" "$now_s" | awk '{c[$2" "$3]++} END{for(k in c) print c[k], k}')"
  if [ -z "$agg" ]; then
    echo "$now" > "$WATERMARK"; touch_state
    echo "mesh-labor: no turns in window [$wm .. $now]"; exit 0; fi

  # build one balanced txn: Dr expenses:labour:<prov>:<win>, Cr assets:budget:<prov>
  local date_s frag; date_s="$(date -u +%Y-%m-%d)"; frag="$(mktemp)"; trap 'rm -f "$frag"' RETURN
  {
    echo "$date_s * labour feed  ; window:$wm..$now"
    # expense legs (per prov+window)
    printf '%s\n' "$agg" | sort | while read -r n prov win; do
      printf '    expenses:labour:%s:%-12s %6d TURN\n' "$prov" "$win" "$n"
    done
    # budget drawdown legs (per prov, summed) — the balancing Cr
    printf '%s\n' "$agg" | awk '{c[$2]+=$1} END{for(p in c) print c[p], p}' | sort | while read -r n prov; do
      printf '    assets:budget:%-22s %6d TURN\n' "$prov" "-$n"
    done
  } > "$frag"

  # PARITY GATE: check a copy before it touches the journal
  local yj chk; yj="$(year_journal)"; chk="$(mktemp)"
  cat "$yj" "$frag" > "$chk"
  if ! hledger -f "$chk" check 2>/tmp/mesh-labor-check.$$; then
    echo "mesh-labor --feed: REFUSED — feed does not balance (parity gate caught it):" >&2
    cat /tmp/mesh-labor-check.$$ >&2; rm -f "$chk" /tmp/mesh-labor-check.$$; exit 1; fi
  rm -f /tmp/mesh-labor-check.$$
  mv -f "$chk" "$yj"; echo "$now" > "$WATERMARK"; touch_state

  local total; total="$(printf '%s\n' "$agg" | awk '{s+=$1} END{print s+0}')"
  git_labor add -A >/dev/null 2>&1
  git_labor commit -q -m "labour feed [$wm .. $now]: $total TURN" >/dev/null 2>&1
  write_summary
  echo "mesh-labor: booked window [$wm .. $now]  ($total TURN)"
  hledger -f "$(main_journal)" balance expenses:labour --no-total --flat --depth 3 2>/dev/null | tail -12
}

write_summary(){
  local sm="$MESH/.labor-summary"
  local hi lo top; hi="$(date -u +%s)"; lo=$(( hi - $(awk "BEGIN{print int($WINDOW_H*3600)}") ))
  top="$(turns_between "$lo" "$hi" | awk '{c[$3]++} END{m=0; for(w in c) if(c[w]>m){m=c[w]; b=w}; if(b)printf "%s %d", b, m}')"
  { local spent cap topwin topn busiest
    spent="$(rolling_spent_total)"; cap="$WINDOW_BUDGET_TURNS"
    topwin="${top% *}"; topn="${top##* }"
    if [ -n "$top" ] && [ "$cap" -gt 0 ] 2>/dev/null; then
      busiest="busiest ${topwin}=${topn}/${cap} ($(( topn*100/cap ))%)"
    else
      busiest="${top:+busiest ${topwin}=${topn}}"
    fi
    local usd_line usd_rows usd_total
    usd_rows="$(rolling_usd_rows)"; _USD_RC=$?
    if [ "$_USD_RC" = 0 ] && [ -n "$usd_rows" ]; then
      usd_total="$(printf '%s\n' "$usd_rows" | awk '{s+=$1} END{printf "%.2f", s}')"
      if awk "BEGIN{exit !($BUDGET_USD > 0)}" 2>/dev/null; then usd_line="inference: \$$usd_total/\$$BUDGET_USD"
      else usd_line="inference: \$$usd_total (no cap)"; fi
    elif [ "$_USD_RC" = 3 ]; then usd_line="inference: \$0"
    else usd_line="inference: n/a"; fi
    if [ "$cap" -gt 0 ] 2>/dev/null; then
      printf '%s · labour: %s TURN in %sh (window cap %s)%s\n' "$usd_line" "$spent" "$WINDOW_H" "$cap" "${busiest:+  · $busiest}"
    else
      printf '%s · labour: %s TURN in %sh (no cap)%s\n' "$usd_line" "$spent" "$WINDOW_H" "${busiest:+  · $busiest}"
    fi
  } > "$sm" 2>/dev/null || true
}

# ============================ ROLLING BUDGET ============================
rolling_spent_total(){  # total turns in the live [now-window, now]
  local hi lo; hi="$(date -u +%s)"; lo=$(( hi - $(awk "BEGIN{print int($WINDOW_H*3600)}") ))
  turns_between "$lo" "$hi" | wc -l | tr -d ' '
}
# rolling_usd_rows: the INFERENCE axis. Prices the live last-WINDOW_H token flow through mesh-ledger's
# one pricing tract (`--price-window` = same price_py + rate table as its --feed) and parses the
# emitted (unbooked) txn fragment. Emits `<usd> <provider> <model>` per line; empty on rc!=0.
# Distinguish honest states via rc: 0=rows, 3=zero activity (a real $0), else pricer n/a (NOT $0).
# rc travels through the command substitution's EXIT STATUS — capture it as
#   usd_rows="$(rolling_usd_rows)"; _USD_RC=$?
# (a global assigned INSIDE the function would die in the $() subshell — the silent-fallback trap:
# every failure would read as rc=0.)
_USD_RC=0
rolling_usd_rows(){
  local out rc
  out="$("$LEDGER_BIN" --price-window "$WINDOW_H" 2>/dev/null)"; rc=$?
  [ "$rc" = 0 ] || return "$rc"
  printf '%s\n' "$out" | awk '
    $1 ~ /^expenses:inference:/ {
      amt=$2; sub(/^\$/,"",amt)
      n=split($1,a,":")
      print amt, a[3], a[4]
    }'
  return 0
}
do_budget(){
  local hi lo; hi="$(date -u +%s)"; lo=$(( hi - $(awk "BEGIN{print int($WINDOW_H*3600)}") ))
  local rows; rows="$(turns_between "$lo" "$hi")"
  local total; total="$(printf '%s\n' "$rows" | grep -c . )"
  echo "mesh-labour · rolling ${WINDOW_H}h budget · $(now_iso) · $(hostname)"
  # ── PRIMARY AXIS: INFERENCE (imputed USD via mesh-ledger rates over mesh-spend --tokens) ──
  local usd_rows usd_total
  usd_rows="$(rolling_usd_rows)"; _USD_RC=$?
  echo "── INFERENCE (imputed USD — the budget axis) ──"
  if [ "$_USD_RC" = 0 ] && [ -n "$usd_rows" ]; then
    usd_total="$(printf '%s\n' "$usd_rows" | awk '{s+=$1} END{printf "%.4f", s}')"
    if awk "BEGIN{exit !($BUDGET_USD > 0)}" 2>/dev/null; then
      local remain burn proj
      remain="$(awk "BEGIN{r=$BUDGET_USD-$usd_total; printf \"%.4f\", (r<0)?0:r}")"
      burn="$(awk "BEGIN{printf \"%.4f\", $usd_total/$WINDOW_H}")"
      if awk "BEGIN{exit !($usd_total >= $BUDGET_USD)}"; then proj="EXHAUSTED"
      elif awk "BEGIN{exit !($burn > 0)}"; then proj="~$(awk "BEGIN{printf \"%.1f\", $remain/$burn}")h left"
      else proj="—"; fi
      printf 'spent: $%s / cap $%s / remain $%s · burn $%s/h · %s\n' \
        "$usd_total" "$BUDGET_USD" "$remain" "$burn" "$proj"
    else
      printf 'spent: $%s in %sh · burn $%s/h · cap: (none — report-only; set MESH_LABOR_BUDGET_USD to arm)\n' \
        "$usd_total" "$WINDOW_H" "$(awk "BEGIN{printf \"%.4f\", $usd_total/$WINDOW_H}")"
    fi
    printf '%s\n' "$usd_rows" | sort -rn | awk '{printf "  %-10s %-28s $%s\n", $2, $3, $1}'
  elif [ "$_USD_RC" = 3 ]; then
    echo "spent: \$0.0000 (zero billable activity in window)"
  else
    echo "n/a — pricer unavailable ($LEDGER_BIN --price-window rc=$_USD_RC); NOT \$0"
  fi
  # ── SECONDARY AXIS: labour TURNs per window (windows = accounts; tokens have no window) ──
  echo "── labour (TURN — secondary) ──"
  if [ "$WINDOW_BUDGET_TURNS" -gt 0 ] 2>/dev/null; then
    echo "cap: $WINDOW_BUDGET_TURNS TURN / window / ${WINDOW_H}h"
  else
    echo "cap: (none — report-only; set MESH_LABOR_WINDOW_BUDGET_TURNS to arm a rolling limit)"
  fi
  printf '%s\n' "$(printf '%0.s─' $(seq 1 64))"
  printf '%-12s %8s %8s %9s %10s  %s\n' WINDOW SPENT CAP REMAIN 'BURN/h' PROJECTION
  # per-window — windows are the accounts (board-as-game: ОКНА=счета); provider is an
  # implementation detail of which engine a window runs on, not the thing being budgeted.
  printf '%s\n' "$rows" | grep . | awk '{c[$3]++} END{for(w in c) print c[w], w}' | sort -rn | while read -r n win; do
    local burn proj remain
    burn="$(awk "BEGIN{printf \"%.0f\", $n/$WINDOW_H}")"
    if [ "$WINDOW_BUDGET_TURNS" -gt 0 ] 2>/dev/null; then
      remain=$(( WINDOW_BUDGET_TURNS - n )); [ "$remain" -lt 0 ] && remain=0
      if [ "$n" -ge "$WINDOW_BUDGET_TURNS" ]; then proj="EXHAUSTED"
      elif [ "$burn" -gt 0 ]; then proj="~$(awk "BEGIN{printf \"%.1f\", $remain/$burn}")h left"
      else proj="—"; fi
      printf '%-12s %8d %8d %9d %10d  %s\n' "$win" "$n" "$WINDOW_BUDGET_TURNS" "$remain" "$burn" "$proj"
    else
      printf '%-12s %8d %8s %9s %10d  %s\n' "$win" "$n" "—" "—" "$burn" "—"
    fi
  done
  printf '%s\n' "$(printf '%0.s─' $(seq 1 64))"
  printf 'total: %s TURN expended in the last %sh\n' "$total" "$WINDOW_H"
  # by-provider breakdown (which engine carried the labour — secondary, billing-tier detail)
  echo "── by provider ──"
  printf '%s\n' "$rows" | grep . | awk '{c[$2]++} END{for(p in c) print c[p], p}' | sort -rn | \
    awk '{printf "  %-12s %5d TURN\n", $2, $1}'
}

# ============================ AVAILABILITY (the routing denominator) ============================
# roster_windows: the accounts the game can route to = the node's mind-channel set (restore.env),
# so a roster window with ZERO turns reads as fully AVAILABLE (genuinely idle), not absent. A window
# NOT in the roster is n/a to the game, never a silent 0.
roster_windows(){
  local set=""
  if [ -f "$RESTORE_ENV" ]; then
    set="$(grep -E '^[[:space:]]*(export[[:space:]]+)?MESH_MIND_CHANNELS=' "$RESTORE_ENV" 2>/dev/null \
      | tail -1 | sed -E 's/^[^=]*=//; s/^["'\'']//; s/["'\'']$//')"
  fi
  [ -n "$set" ] || set="${MESH_MIND_CHANNELS:-}"
  printf '%s\n' "$set" | tr ' ' '\n' | grep -v '^$'
}
# --availability [--json]: per-window remaining TURN over the rolling window = the account balance
# vs its budget. This is the ONLY hledger quantity the task-routing selector consumes; relevance
# (task-text vs the window's top-pane) is the one non-hledger factor, combined externally as
# score = relevance × availability. Fail-safe: no cap armed ⇒ no availability fraction ⇒ FIFO.
do_availability(){
  local as_json=0; [ "${1:-}" = "--json" ] && as_json=1
  local hi lo; hi="$(date -u +%s)"; lo=$(( hi - $(awk "BEGIN{print int($WINDOW_H*3600)}") ))
  local rows; rows="$(turns_between "$lo" "$hi")"
  # per-window spent (only windows that spent appear here; roster fills in the idle ones at 0)
  local spent_kv; spent_kv="$(printf '%s\n' "$rows" | grep . | awk '{c[$3]++} END{for(w in c) print w, c[w]}')"
  local roster; roster="$(roster_windows)"
  # union of roster + windows-seen, so an off-roster spender is still surfaced (flagged)
  local seen; seen="$(printf '%s\n' "$roster"; printf '%s\n' "$spent_kv" | awk '{print $1}')"
  seen="$(printf '%s\n' "$seen" | grep -v '^$' | sort -u)"
  local cap="$WINDOW_BUDGET_TURNS"
  spent_of(){ printf '%s\n' "$spent_kv" | awk -v w="$1" '$1==w{print $2; f=1} END{if(!f)print 0}'; }
  in_roster(){ printf '%s\n' "$roster" | grep -qxF "$1"; }
  if [ "$as_json" = 1 ]; then
    printf '{"window_h":%s,"cap_turns":%s,"fifo_fallback":%s,"windows":{' \
      "$WINDOW_H" "$cap" "$([ "$cap" -gt 0 ] 2>/dev/null && echo false || echo true)"
    local n=0 w s r a
    for w in $seen; do
      s="$(spent_of "$w")"
      if [ "$cap" -gt 0 ] 2>/dev/null; then
        r=$(( cap - s )); [ "$r" -lt 0 ] && r=0
        a="$(awk "BEGIN{printf \"%.3f\", $r/$cap}")"
      else r="null"; a="null"; fi
      [ "$n" -gt 0 ] && printf ','; n=1
      printf '"%s":{"spent":%s,"remain":%s,"avail":%s,"roster":%s}' \
        "$w" "$s" "$r" "$a" "$(in_roster "$w" && echo true || echo false)"
    done
    printf '}}\n'; return
  fi
  echo "mesh-labour · availability · rolling ${WINDOW_H}h · $(now_iso) · $(hostname)"
  if [ "$cap" -gt 0 ] 2>/dev/null; then
    echo "per-window cap: $cap TURN / ${WINDOW_H}h  (availability = remain/cap ∈ [0,1])"
  else
    echo "per-window cap: (none) — availability UNDEFINED; routing MUST fall back to FIFO (design fail-safe)"
    echo "  arm with MESH_LABOR_WINDOW_BUDGET_TURNS=<n> to route by budget"
  fi
  printf '%s\n' "$(printf '%0.s─' $(seq 1 56))"
  printf '%-12s %7s %8s %7s  %s\n' WINDOW SPENT REMAIN AVAIL NOTE
  local w s r a note
  for w in $seen; do
    s="$(spent_of "$w")"; note=""; in_roster "$w" || note="off-roster"
    if [ "$cap" -gt 0 ] 2>/dev/null; then
      r=$(( cap - s )); [ "$r" -lt 0 ] && r=0
      a="$(awk "BEGIN{printf \"%.2f\", $r/$cap}")"
      printf '%-12s %7d %8d %7s  %s\n' "$w" "$s" "$r" "$a" "$note"
    else
      printf '%-12s %7d %8s %7s  %s\n' "$w" "$s" "—" "—" "$note"
    fi
  done | sort -k2 -rn
  printf '%s\n' "$(printf '%0.s─' $(seq 1 56))"
  echo "note: availability is the hledger half of routing (score = relevance × availability);"
  echo "      relevance (task-text vs a window's top-pane) is the one non-hledger factor."
}

do_json(){
  local hi lo; hi="$(date -u +%s)"; lo=$(( hi - $(awk "BEGIN{print int($WINDOW_H*3600)}") ))
  local rows; rows="$(turns_between "$lo" "$hi")"
  local total; total="$(printf '%s\n' "$rows" | grep -c .)"
  # INFERENCE axis first; state distinguishes a real $0 from pricer-n/a (never faked as 0)
  local usd_rows usd_total usd_state cap_usd_json
  usd_rows="$(rolling_usd_rows)"; _USD_RC=$?
  if [ "$_USD_RC" = 0 ] && [ -n "$usd_rows" ]; then
    usd_total="$(printf '%s\n' "$usd_rows" | awk '{s+=$1} END{printf "%.4f", s}')"; usd_state="ok"
  elif [ "$_USD_RC" = 3 ]; then usd_total="0.0000"; usd_state="zero"
  else usd_total="null"; usd_state="na"; fi
  cap_usd_json="$(awk "BEGIN{print ($BUDGET_USD > 0) ? $BUDGET_USD : \"null\"}" 2>/dev/null || echo null)"
  printf '{"window_h":%s,"usd":{"spent":%s,"cap":%s,"state":"%s","models":{' \
    "$WINDOW_H" "$usd_total" "$cap_usd_json" "$usd_state"
  [ "$usd_state" = ok ] && printf '%s\n' "$usd_rows" | \
    awk '{k=$2":"$3; c[k]+=$1} END{n=0; for(k in c){if(n++)printf ",";printf "\"%s\":%.4f",k,c[k]}}'
  printf '}},"cap_turns":%s,"total":%s,"providers":{' "$BUDGET_TURNS" "$total"
  printf '%s\n' "$rows" | grep . | awk '{c[$2]++} END{n=0; for(p in c){if(n++)printf ",";printf "\"%s\":%d",p,c[p]}}'
  printf '},"windows":{'
  printf '%s\n' "$rows" | grep . | awk '{c[$3]++} END{n=0; for(w in c){if(n++)printf ",";printf "\"%s\":%d",w,c[w]}}'
  printf '}}\n'
}

# ============================ BOARD ATTRIBUTION ============================
# --branch <slug>: labour a board task cost = its owner-window's turns over [task-open .. done/now].
do_branch(){
  local slug="${1:-}"; [ -n "$slug" ] || { echo "usage: mesh-labor --branch <slug>" >&2; exit 2; }
  [ -f "$CHAT_LOG" ] || { echo "no chat.log" >&2; exit 2; }
  # find the opening [task] line matching the slug, its ts + owner-window; and a closing [done] <slug>.
  # Marker MUST be a board-post marker (`:: [task]`/`:: [done]`), never a mere substring — a [verify]/
  # [fyi] line that DISCUSSES "[done]" in prose is not a done post (substring-scan-turns-prose-into-verdict).
  # owner: prefer `owner: <tool>/<window>` clause, else the posting window (col before @).
  local open; open="$(grep -E ':: +\[task\]' "$CHAT_LOG" | grep -iF "$slug" | head -1)"
  [ -n "$open" ] || { echo "mesh-labor --branch: no [task] on the board matching '$slug'"; exit 0; }
  local open_ts owner
  open_ts="$(printf '%s' "$open" | awk '{print $1}')"
  owner="$(printf '%s' "$open" | grep -oE 'owner:[[:space:]]*[^[:space:]]+' | head -1 | sed -E 's#.*/##; s/owner:[[:space:]]*//')"
  [ -n "$owner" ] || owner="$(printf '%s' "$open" | awk '{print $2}' | sed -E 's/@.*//')"
  local close close_ts closed_disp
  close="$(awk -v s="$open_ts" '$1>s' "$CHAT_LOG" | grep -E ':: +\[done\]' | grep -iF "$slug" | head -1)"
  if [ -n "$close" ]; then close_ts="$(printf '%s' "$close" | awk '{print $1}')"; closed_disp="$close_ts"
  else close_ts="$(now_iso)"; closed_disp="<no [done] on the board — open, using now ($close_ts)>"; fi
  local lo hi; lo="$(epoch "$open_ts")"; hi="$(epoch "$close_ts")"
  local n; n="$(turns_between "$(( lo - 1 ))" "$hi" | awk -v w="$owner" '$3==w' | wc -l | tr -d ' ')"
  # A 0 is NO DATA, not "cost nothing", whenever the OWNER-WINDOW wasn't being sampled over the span —
  # the silent-fallback trap. spend.log has no backfill, and until discover's mesh-spend window-map fix
  # (2026-07-24) the sampler iterated a stale default_map (plan/dev/verify/work), so genome/minds/pub/…
  # windows logged ZERO turns however busy they were. Guard on this WINDOW's earliest logged turn, not
  # the global one: a span ending before it (or a window never logged at all) is n/a, not free.
  local win_earliest cost_line
  win_earliest="$(turns_between -1 "$(date -u +%s)" | awk -v w="$owner" '$3==w{print $1; exit}')"
  if [ -z "$win_earliest" ]; then
    cost_line="  labour cost  : n/a — window '$owner' has NO turns in spend.log at all (unsampled: pre-dates discover's window-map fix, or idle); 0 ≠ free"
  elif [ "$n" = 0 ] && [ "$hi" -lt "$win_earliest" ] 2>/dev/null; then
    cost_line="  labour cost  : n/a — span ends before '$owner's earliest logged turn ($(date -u -d "@$win_earliest" +%FT%RZ)); unlogged, not free"
  elif [ "$lo" -lt "$win_earliest" ] 2>/dev/null; then
    cost_line="  labour cost  : $n TURN (PARTIAL — '$owner' first logged $(date -u -d "@$win_earliest" +%FT%RZ), after span open; count is the logged tail only)"
  else
    cost_line="  labour cost  : $n TURN  (owner-window turns over the open interval)"
  fi
  echo "branch: $slug"
  echo "  owner-window : $owner"
  echo "  opened       : $open_ts"
  echo "  closed       : $closed_disp"
  echo "$cost_line"
  echo "  note: interval attribution (owner-window × task-open span), not per-turn tagging — a turn"
  echo "        in the span served this task by proximity, not proof; the honest first-order measure."
}

# ============================ PROPOSE CAP (report-only) ============================
# Derive a proposed rolling-$ cap from MEASURED burn: replay the ledger's booked `inference feed`
# txns (window-tagged, ~hourly) and compute the sliding WINDOW_H-hour sum keyed by each feed's
# window-end. REPORT ONLY — prints a proposal for the operator; arms nothing. A feed whose own
# window exceeds WINDOW_H (downtime catch-up) dumps its whole cost into one bucket and can
# overstate the peak; such feeds are flagged, not silently included as clean.
do_propose_cap(){
  local js; js="$(ls "$LEDGER_JOURNAL_DIR"/[0-9][0-9][0-9][0-9].journal 2>/dev/null)"
  [ -n "$js" ] || { echo "mesh-labor --propose-cap: n/a — no ledger journal in $LEDGER_JOURNAL_DIR (mesh-ledger --feed history is the burn record)"; exit 2; }
  # feed rows: "<end_iso> <start_iso> <usd>"
  local feeds
  feeds="$(cat $js | awk '
    /\* inference feed/ {
      if (infeed && b!="") print b, a, cost
      infeed=1; cost=0; a=""; b=""
      if (match($0, /window:[^ ]+/)) { w=substr($0,RSTART+7,RLENGTH-7); split(w,ab,/\.\./); a=ab[1]; b=ab[2] }
      next
    }
    infeed && $1 ~ /^expenses:inference:/ { amt=$2; sub(/^\$/,"",amt); cost+=amt; next }
    infeed && $1 ~ /^assets:/ { print b, a, cost; infeed=0; b=""; next }
    END { if (infeed && b!="") print b, a, cost }
  ')"
  [ -n "$feeds" ] || { echo "mesh-labor --propose-cap: n/a — journal has no inference feeds yet"; exit 2; }
  local win_s; win_s="$(awk "BEGIN{print int($WINDOW_H*3600)}")"
  # epoch-ize + sliding sum (n^2 over ~hourly feeds — fine)
  local rows; rows="$(printf '%s\n' "$feeds" | while read -r b a c; do
    be="$(epoch "$b")"; ae="$(epoch "$a")"; [ "$be" -gt 0 ] || continue
    echo "$be $ae $c"
  done)"
  local n; n="$(printf '%s\n' "$rows" | grep -c .)"
  local long; long="$(printf '%s\n' "$rows" | awk -v w="$win_s" '$1-$2 > w {n++} END{print n+0}')"
  local sums; sums="$(printf '%s\n' "$rows" | awk -v w="$win_s" '
    {e[NR]=$1; c[NR]=$3}
    END { for(i=1;i<=NR;i++){ s=0; for(j=1;j<=NR;j++) if(e[j]<=e[i] && e[j]>e[i]-w) s+=c[j]; printf "%.4f\n", s } }' | sort -n)"
  local max p95 med span_lo span_hi
  max="$(printf '%s\n' "$sums" | tail -1)"
  p95="$(printf '%s\n' "$sums" | awk '{v[NR]=$1} END{i=int(NR*0.95); if(i<1)i=1; print v[i]}')"
  med="$(printf '%s\n' "$sums" | awk '{v[NR]=$1} END{i=int((NR+1)/2); print v[i]}')"
  span_lo="$(printf '%s\n' "$feeds" | awk '{print $2}' | sort | head -1)"
  span_hi="$(printf '%s\n' "$feeds" | awk '{print $1}' | sort | tail -1)"
  local prop; prop="$(awk "BEGIN{p=$max*1.2; print int(p)+((p>int(p))?1:0)}")"
  echo "mesh-labour · --propose-cap · rolling ${WINDOW_H}h INFERENCE \$ · $(now_iso)"
  echo "history: $n booked inference feed(s), $span_lo .. $span_hi"
  [ "$long" -gt 0 ] && echo "caveat: $long feed(s) span >${WINDOW_H}h (downtime catch-up) — peak may be overstated"
  echo "sliding ${WINDOW_H}h burn: median \$$med · p95 \$$p95 · max \$$max"
  echo "PROPOSED cap: MESH_LABOR_BUDGET_USD=$prop   (max*1.2 rounded up — headroom over the worst measured ${WINDOW_H}h)"
  echo "report-only: NOT armed. Post as [fyi]; operator approves before setting the env (restore.env)."
}

# ============================ CHECK (the gate) ============================
do_check(){
  have hledger || { echo "hledger n/a" >&2; exit 2; }
  ensure_repo
  local mj; mj="$(main_journal)"
  echo "── parity (hledger check) ──"
  if hledger -f "$mj" check 2>&1; then echo "parity: OK (every txn sums to zero per commodity)"; else
    echo "parity: FAIL"; exit 1; fi
  echo "── replay-vs-balance agreement ──"
  # independent recompute: sum expense TURNs from the journal vs from a fresh spend.log replay of the
  # SAME span the journal covers. They need not be identical (feeds lag live turns), but the journal
  # must never EXCEED the total labour ever logged — that would be an over-book.
  local jtotal; jtotal="$(hledger -f "$mj" balance 'expenses:labour' --no-total -N 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="TURN") print $(i-1)}' | tr -d ',' | awk '{s+=$1} END{print s+0}')"
  local logtotal; logtotal="$(turns_between -1 "$(date -u +%s)" | wc -l | tr -d ' ')"
  echo "journal expenses:labour = $jtotal TURN ; spend.log all-time = $logtotal TURN"
  if [ "$jtotal" -le "$logtotal" ] 2>/dev/null; then echo "agreement: OK (journal ≤ log — no over-book)"; else
    echo "agreement: FAIL — journal books more labour than was ever logged"; exit 1; fi
}

do_dash(){
  local sm="$MESH/.labor-summary"
  if [ -s "$sm" ]; then cat "$sm"; else write_summary; cat "$sm" 2>/dev/null; fi
  do_budget 2>/dev/null | sed -n '4,20p'
}

# ============================ TEST (RED-first) ============================
do_coupling(){
  # PARTICIPATORY SENSE-MAKING metric (De Jaegher & Di Paolo, Phenom Cogn Sci 6:485, 2007): the central
  # measurable claim is that in genuine social sense-making the INTERACTION PROCESS ITSELF acquires
  # autonomy — each agent's activity modulates another's, versus parallel independent work merely posted
  # to a shared board. The field's instrument is cross-recurrence quantification (CRQA; e.g. inter-brain
  # coupling in naturalistic interaction, PMC12833299, 2026). mesh-labor already meters each window's
  # labour INDEPENDENTLY — exactly the aggregation-not-interaction blind spot. This is a lightweight
  # directed cross-recurrence over the per-window turn series in spend.log: for active window pairs (x,y),
  # does x's activity in a bin raise y's activity in the NEXT bin above y's own base rate (lag-1 lift)?
  # READ-ONLY, advisory — never books a txn, never escalates. UNKNOWN (never a faked COUPLED) when <2
  # windows are active or the window is too short.
  local now hi lo
  now="${MESH_LABOR_NOW:-$(now_iso)}"
  hi="$(epoch "$now")"; lo="$(( hi - WINDOW_H*3600 ))"
  turns_between "$lo" "$hi" | python3 <(_coupling_py) \
    "${MESH_LABOR_COUPLING_BIN_MIN:-5}" "${MESH_LABOR_COUPLING_MIN_TURNS:-3}" "${MESH_LABOR_COUPLING_FLOOR:-0.25}"
}

# the python core is inline so --coupling and its --test gate share ONE implementation (no drift)
_coupling_py(){ cat <<'PY'
import sys
from collections import defaultdict
bin_s = int(sys.argv[1]) * 60
min_turns = int(sys.argv[2])
floor = float(sys.argv[3])
rows = []
for ln in sys.stdin:
    p = ln.split()
    if len(p) >= 3:
        try: rows.append((int(p[0]), p[2]))
        except ValueError: pass
if not rows:
    print("COUPLING_UNKNOWN frac=0.00 coupling=0.000 windows=0 bins=0"); raise SystemExit
t0 = min(e for e, _ in rows); t1 = max(e for e, _ in rows)
nbins = (t1 - t0) // bin_s + 1
turns = defaultdict(int); bins = defaultdict(set)
for e, w in rows:
    turns[w] += 1; bins[w].add((e - t0) // bin_s)
active = [w for w in bins if turns[w] >= min_turns]
if len(active) < 2 or nbins < 3:
    print("COUPLING_UNKNOWN frac=0.00 coupling=0.000 windows=%d bins=%d" % (len(active), nbins)); raise SystemExit
pairs = []
for x in active:
    ax = bins[x]
    for y in active:
        if x == y: continue
        ay = bins[y]; ry = len(ay) / nbins
        denom = [i for i in ax if i < nbins - 1]
        if not denom: continue
        cond = sum(1 for i in denom if (i + 1) in ay) / len(denom)
        pairs.append(cond - ry)                        # lag-1 directed lift of x on y
if not pairs:
    print("COUPLING_UNKNOWN frac=0.00 coupling=0.000 windows=%d bins=%d" % (len(active), nbins)); raise SystemExit
coupled = [l for l in pairs if l > 0.05]
frac = len(coupled) / len(pairs)
cmean = sum(l for l in pairs if l > 0) / len(pairs)
lab = "COUPLED" if frac >= floor else "PARALLEL"
print("%s frac=%.2f coupling=%.3f windows=%d bins=%d" % (lab, frac, cmean, len(active), nbins))
PY
}

do_test(){
  have hledger || { echo "mesh-labor --test: hledger not installed" >&2; exit 2; }
  local td; td="$(mktemp -d)"; trap 'rm -f /tmp/mesh-labor-t.$$; rm -rf "$td"' RETURN
  local fail=0

  # GATE 1 — parity REJECTS an unbalanced txn (seen RED). A gate you have not seen fail is not a gate.
  cat > "$td/bad.journal" <<'EOF'
commodity TURN
2026-07-24 * bad feed
    expenses:labour:anthropic:tg    5 TURN
    assets:budget:anthropic        -4 TURN
EOF
  if hledger -f "$td/bad.journal" check 2>/dev/null; then
    echo "  ✗ GATE1 parity: an UNBALANCED txn (5 vs -4) PASSED check — gate is dead"; fail=1
  else echo "  ✓ GATE1 parity: unbalanced 5/-4 TURN txn REJECTED (seen red)"; fi

  # ...and ACCEPTS the balanced fix (green after red)
  cat > "$td/good.journal" <<'EOF'
commodity TURN
2026-07-24 * good feed
    expenses:labour:anthropic:tg    5 TURN
    assets:budget:anthropic        -5 TURN
EOF
  if hledger -f "$td/good.journal" check 2>/dev/null; then echo "  ✓ GATE1 parity: balanced 5/-5 ACCEPTED (green)"; else
    echo "  ✗ GATE1 parity: balanced txn REJECTED — gate over-blocks"; fail=1; fi

  # GATE 2 — the turn parser counts a REAL spend.log line, windowed. Assert it reads data, not a stub.
  local sl="$td/spend.log"
  # two turns inside a 1h synthetic window, one outside — parser must return exactly the 2 inside.
  cat > "$sl" <<'EOF'
2026-07-24T10:00Z turn tg claude anthropic paid Opus
2026-07-24T10:30Z turn genome claude anthropic paid Opus
2026-07-24T06:00Z turn tg claude anthropic paid Opus
EOF
  local lo hi cnt
  lo="$(SPEND_LOG="$sl" bash -c 'date -u -d 2026-07-24T09:59Z +%s')"
  hi="$(date -u -d 2026-07-24T11:00Z +%s)"
  cnt="$(SPEND_LOG="$sl" MESH_SPEND_LOG="$sl" bash -c "$(declare -f turns_between); turns_between $lo $hi" | wc -l | tr -d ' ')"
  if [ "$cnt" = 2 ]; then echo "  ✓ GATE2 parser: windowed turn count = 2 (the 2 in-window lines, not the 1 outside)"; else
    echo "  ✗ GATE2 parser: expected 2 in-window turns, got '$cnt' — parser/window broken"; fail=1; fi

  # GATE 3 — budget math: spent≥cap ⇒ EXHAUSTED (the rolling-limit semantics)
  local remain; local n=10 cap=8
  remain=$(( cap - n )); [ "$remain" -lt 0 ] && remain=0
  if [ "$n" -ge "$cap" ] && [ "$remain" = 0 ]; then echo "  ✓ GATE3 budget: spent 10 ≥ cap 8 ⇒ remaining 0 / EXHAUSTED"; else
    echo "  ✗ GATE3 budget: exhaustion math wrong"; fail=1; fi

  # GATE 4 — availability: a ROSTER window that spent NOTHING reads fully available (avail 1.0),
  #          a spender's remain = cap-spent, and an OFF-roster window is flagged (never a silent 0).
  #          Drive the REAL do_availability against a stub spend.log + stub roster (not stub math).
  local ad="$td/avail"; mkdir -p "$ad"
  cat > "$ad/spend.log" <<EOF
$(date -u -d '-1 hour' +%Y-%m-%dT%H:%MZ) turn tg claude anthropic paid Opus
$(date -u -d '-1 hour' +%Y-%m-%dT%H:%MZ) turn tg claude anthropic paid Opus
$(date -u -d '-1 hour' +%Y-%m-%dT%H:%MZ) turn stray opencode zai paid GLM
EOF
  echo 'MESH_MIND_CHANNELS="tg genome witness"' > "$ad/restore.env"
  local ajson
  ajson="$(SPEND_LOG="$ad/spend.log" MESH_SPEND_LOG="$ad/spend.log" MESH_RESTORE_ENV="$ad/restore.env" \
      MESH_LABOR_WINDOW_BUDGET_TURNS=10 MESH_LABOR_WINDOW_H=5 \
      bash "$0" --availability --json 2>/dev/null)"
  # genome & witness are roster, 0 turns → avail 1.000 ; tg spent 2 → remain 8 ; stray is off-roster
  if printf '%s' "$ajson" | grep -q '"genome":{"spent":0,"remain":10,"avail":1.000,"roster":true}' \
     && printf '%s' "$ajson" | grep -q '"tg":{"spent":2,"remain":8,"avail":0.800,"roster":true}' \
     && printf '%s' "$ajson" | grep -q '"stray":{"spent":1,"remain":9,"avail":0.900,"roster":false}'; then
    echo "  ✓ GATE4 availability: idle roster window = 1.000, spender remain=cap-spent, off-roster flagged"
  else
    echo "  ✗ GATE4 availability: routing denominator wrong — got: $ajson"; fail=1; fi

  # ...and the FAIL-SAFE: no cap armed ⇒ availability is null, forcing the FIFO fallback flag.
  local nocap
  nocap="$(SPEND_LOG="$ad/spend.log" MESH_SPEND_LOG="$ad/spend.log" MESH_RESTORE_ENV="$ad/restore.env" \
      MESH_LABOR_WINDOW_BUDGET_TURNS=0 bash "$0" --availability --json 2>/dev/null)"
  if printf '%s' "$nocap" | grep -q '"fifo_fallback":true' && printf '%s' "$nocap" | grep -q '"avail":null'; then
    echo "  ✓ GATE4 fail-safe: no cap ⇒ avail null + fifo_fallback true (never an invented fraction)"
  else
    echo "  ✗ GATE4 fail-safe: expected null availability + fifo flag with no cap — got: $nocap"; fail=1; fi

  # GATE 5 — --balance --rolling: a per-WINDOW (not per-provider) Dr/Cr tree whose trailing
  # checksum is an INDEPENDENT cross-check (turns_between's epoch/mktime math vs
  # independent_window_tally's ISO-string comparison — two genuinely different implementations
  # reading the same $SPEND_LOG), not a tautological recount of the same bucketed rows.
  local rd="$td/rolling"; mkdir -p "$rd"
  cat > "$rd/spend.log" <<EOF
$(date -u -d '-1 hour' +%Y-%m-%dT%H:%MZ) turn tg claude anthropic paid Opus
$(date -u -d '-1 hour' +%Y-%m-%dT%H:%MZ) turn tg claude anthropic paid Opus
$(date -u -d '-1 hour' +%Y-%m-%dT%H:%MZ) turn tg claude anthropic paid Opus
$(date -u -d '-1 hour' +%Y-%m-%dT%H:%MZ) turn genome claude anthropic paid Opus
$(date -u -d '-1 hour' +%Y-%m-%dT%H:%MZ) turn genome claude anthropic paid Opus
$(date -u -d '-1 hour' +%Y-%m-%dT%H:%MZ) turn witness opencode zai paid GLM
EOF
  local rtree
  rtree="$(SPEND_LOG="$rd/spend.log" MESH_SPEND_LOG="$rd/spend.log" MESH_LABOR_WINDOW_H=5 bash "$0" --balance --rolling 2>/dev/null)"
  if printf '%s\n' "$rtree" | grep -qE '^  tg +3$' && printf '%s\n' "$rtree" | grep -qE '^  genome +2$' \
     && printf '%s\n' "$rtree" | grep -qE '^  witness +1$'; then
    echo "  ✓ GATE5 rolling tree: per-window counts correct (tg=3 genome=2 witness=1), no provider nesting"
  else
    echo "  ✗ GATE5 rolling tree: window counts wrong — got: $rtree"; fail=1; fi
  if printf '%s\n' "$rtree" | tail -1 | grep -qE '^ *0$'; then
    echo "  ✓ GATE5 checksum: trailing balance line is 0 (turns_between and independent_window_tally AGREE)"
  else
    echo "  ✗ GATE5 checksum: trailing line is not a bare 0 — got: $(printf '%s\n' "$rtree" | tail -1)"; fail=1; fi

  # GATE 5b — divergence proof: a turn stamped EXACTLY at the lower window boundary must be
  # EXCLUDED (turns_between's own contract: "lo exclusive, hi inclusive"). Mutate a copy of
  # independent_window_tally (flip '>' to '>=', a plausible off-by-one) and show it WRONGLY
  # counts the boundary turn — a real, reproducible divergence on the SAME fixture, proving
  # do_balance_rolling's checksum can actually catch this bug class, not print a constant.
  local lo_fixed hi_fixed lo_ep hi_ep
  lo_fixed="$(date -u -d '-3 hours' +%Y-%m-%dT%H:%MZ)"
  hi_fixed="$(date -u +%Y-%m-%dT%H:%MZ)"
  lo_ep="$(date -u -d "$lo_fixed" +%s)"; hi_ep="$(date -u -d "$hi_fixed" +%s)"
  local bd="$td/boundary"; mkdir -p "$bd"
  printf '%s turn tg claude anthropic paid Opus\n' "$lo_fixed" > "$bd/spend.log"
  local turns_boundary ind_boundary ind_mutated mutated
  turns_boundary="$(SPEND_LOG="$bd/spend.log" bash -c "$(declare -f turns_between); turns_between $lo_ep $hi_ep" | wc -l | tr -d ' ')"
  ind_boundary="$(SPEND_LOG="$bd/spend.log" bash -c "$(declare -f independent_window_tally); independent_window_tally $lo_fixed $hi_fixed" | awk '{s+=$1} END{print s+0}')"
  mutated="$(declare -f independent_window_tally | sed 's/ts>lo/ts>=lo/')"
  ind_mutated="$(SPEND_LOG="$bd/spend.log" bash -c "$mutated; independent_window_tally $lo_fixed $hi_fixed" | awk '{s+=$1} END{print s+0}')"
  if [ "$turns_boundary" = 0 ] && [ "$ind_boundary" = 0 ]; then
    echo "  ✓ GATE5b boundary: a turn exactly AT the lower bound is correctly EXCLUDED by both parsers (exclusive-lo semantics agree)"
  else
    echo "  ✗ GATE5b boundary: exclusive-lo semantics wrong — turns_between=$turns_boundary independent=$ind_boundary (want 0/0)"; fail=1; fi
  if [ "$ind_mutated" != "$ind_boundary" ]; then
    echo "  ✓ GATE5b divergence: a mutated (inclusive-lo) independent tally WRONGLY counts the boundary turn ($ind_mutated vs $ind_boundary) — the cross-check is live"
  else
    echo "  ✗ GATE5b divergence: mutated copy still agreed — fixture doesn't exercise the bug"; fail=1; fi

  # GATE 6 — INFERENCE $ axis: drive the REAL rolling_usd_rows + do_budget through a STUB pricer
  # (env knob MESH_LABOR_LEDGER_BIN — a PATH stub cannot shadow a mesh tool). Asserts the parser
  # reads the priced fragment, the $ math is exact, and pricer-failure renders n/a, never $0.
  local gd="$td/usd"; mkdir -p "$gd"
  cat > "$gd/stub-ledger" <<'EOF'
#!/usr/bin/env bash
# stub mesh-ledger: --price-window emits a fixed priced fragment (2 models, $30.00 total)
case "${1:-}" in
  --price-window)
    cat <<'FRAG'
2026-07-24 * inference feed  ; window:A..B
    expenses:inference:anthropic:claude-opus-5    $25.0000  ; model:claude-opus-5 tier:imputed
    expenses:inference:zai:glm-5-2                $5.0000  ; model:glm-5.2 tier:imputed
    assets:budget:imputed:anthropic                     $-25.0000
    assets:budget:imputed:zai                           $-5.0000
FRAG
    exit 0 ;;
  *) exit 2 ;;
esac
EOF
  chmod +x "$gd/stub-ledger"
  local busd
  busd="$(SPEND_LOG="$td/none" MESH_SPEND_LOG="$td/none" MESH_LABOR_LEDGER_BIN="$gd/stub-ledger" \
      MESH_LABOR_BUDGET_USD=20 bash "$0" --budget 2>/dev/null)"
  if printf '%s\n' "$busd" | grep -qF 'spent: $30.0000 / cap $20 / remain $0.0000' \
     && printf '%s\n' "$busd" | grep -q 'EXHAUSTED'; then
    echo "  ✓ GATE6 usd: stub \$25+\$5 flow reads \$30.0000, cap \$20 ⇒ remain 0 / EXHAUSTED"
  else
    echo "  ✗ GATE6 usd: \$ budget math wrong — got: $(printf '%s\n' "$busd" | sed -n '2,4p')"; fail=1; fi
  local busd2
  busd2="$(SPEND_LOG="$td/none" MESH_SPEND_LOG="$td/none" MESH_LABOR_LEDGER_BIN="$gd/stub-ledger" \
      MESH_LABOR_BUDGET_USD=40 bash "$0" --json 2>/dev/null)"
  if printf '%s' "$busd2" | grep -qF '"usd":{"spent":30.0000,"cap":40,"state":"ok"' \
     && printf '%s' "$busd2" | grep -qF '"anthropic:claude-opus-5":25.0000'; then
    echo "  ✓ GATE6 json: usd axis serialized (spent 30.0000, cap 40, per-model rows)"
  else
    echo "  ✗ GATE6 json: usd JSON wrong — got: $busd2"; fail=1; fi
  # ...and the honest n/a: a FAILING pricer must render n/a, never a fake $0 (silent-fallback rule)
  cat > "$gd/dead-ledger" <<'EOF'
#!/usr/bin/env bash
exit 2
EOF
  chmod +x "$gd/dead-ledger"
  local bna
  bna="$(SPEND_LOG="$td/none" MESH_SPEND_LOG="$td/none" MESH_LABOR_LEDGER_BIN="$gd/dead-ledger" bash "$0" --budget 2>/dev/null)"
  if printf '%s\n' "$bna" | grep -q 'n/a — pricer unavailable' && ! printf '%s\n' "$bna" | grep -q 'spent: \$0.0000'; then
    echo "  ✓ GATE6 n/a: dead pricer renders n/a (rc=2), never a fake \$0"
  else
    echo "  ✗ GATE6 n/a: dead pricer did not render honest n/a — got: $(printf '%s\n' "$bna" | sed -n '2,3p')"; fail=1; fi

  # GATE 7 — coupling: a lag-1 phased pair (B fires the bin after A) reads COUPLED; temporally disjoint
  #          windows read PARALLEL; a lone active window reads UNKNOWN (never a faked COUPLED).
  local cl
  cl="$(printf '%s\n' \
    '2026-07-24T10:00Z turn A claude anthropic paid Opus' '2026-07-24T10:10Z turn A claude anthropic paid Opus' \
    '2026-07-24T10:20Z turn A claude anthropic paid Opus' '2026-07-24T10:30Z turn A claude anthropic paid Opus' \
    '2026-07-24T10:05Z turn B claude anthropic paid Opus' '2026-07-24T10:15Z turn B claude anthropic paid Opus' \
    '2026-07-24T10:25Z turn B claude anthropic paid Opus' '2026-07-24T10:35Z turn B claude anthropic paid Opus' \
    > "$td/cpl.log"; SPEND_LOG="$td/cpl.log" MESH_SPEND_LOG="$td/cpl.log" MESH_LABOR_NOW=2026-07-24T10:40Z \
      MESH_LABOR_WINDOW_H=5 bash "$0" --coupling 2>/dev/null | awk '{print $1}')"
  if [ "$cl" = COUPLED ]; then echo "  ✓ GATE7 coupling: lag-1 phased pair ⇒ COUPLED (interaction has autonomy)"; else
    echo "  ✗ GATE7 coupling: phased pair should read COUPLED, got '$cl'"; fail=1; fi
  cl="$(printf '%s\n' \
    '2026-07-24T10:00Z turn A claude anthropic paid Opus' '2026-07-24T10:05Z turn A claude anthropic paid Opus' \
    '2026-07-24T10:10Z turn A claude anthropic paid Opus' '2026-07-24T10:15Z turn A claude anthropic paid Opus' \
    '2026-07-24T10:45Z turn B claude anthropic paid Opus' '2026-07-24T10:50Z turn B claude anthropic paid Opus' \
    '2026-07-24T10:55Z turn B claude anthropic paid Opus' '2026-07-24T11:00Z turn B claude anthropic paid Opus' \
    > "$td/cpl2.log"; SPEND_LOG="$td/cpl2.log" MESH_SPEND_LOG="$td/cpl2.log" MESH_LABOR_NOW=2026-07-24T11:05Z \
      MESH_LABOR_WINDOW_H=5 bash "$0" --coupling 2>/dev/null | awk '{print $1}')"
  if [ "$cl" = PARALLEL ]; then echo "  ✓ GATE7 coupling: temporally disjoint windows ⇒ PARALLEL"; else
    echo "  ✗ GATE7 coupling: disjoint windows should read PARALLEL, got '$cl'"; fail=1; fi
  cl="$(printf '%s\n' \
    '2026-07-24T10:00Z turn A claude anthropic paid Opus' '2026-07-24T10:10Z turn A claude anthropic paid Opus' \
    '2026-07-24T10:20Z turn A claude anthropic paid Opus' \
    > "$td/cpl3.log"; SPEND_LOG="$td/cpl3.log" MESH_SPEND_LOG="$td/cpl3.log" MESH_LABOR_NOW=2026-07-24T10:25Z \
      MESH_LABOR_WINDOW_H=5 bash "$0" --coupling 2>/dev/null | awk '{print $1}')"
  if [ "$cl" = COUPLING_UNKNOWN ]; then echo "  ✓ GATE7 coupling: lone active window ⇒ UNKNOWN (no faked coupling)"; else
    echo "  ✗ GATE7 coupling: single window should read UNKNOWN, got '$cl'"; fail=1; fi

  [ "$fail" = 0 ] && { echo "mesh-labor --test: PASS"; return 0; } || { echo "mesh-labor --test: FAIL"; return 1; }
}

# ============================ ROLLING BALANCE TREE ============================
# independent_window_tally: a SECOND, independently-implemented rolling-window turn tally used
# only to cross-check do_balance_rolling's checksum. Deliberately does NOT call turns_between or
# reuse epoch/mktime math — it compares zero-padded ISO-8601 timestamp STRINGS lexicographically
# (valid because e.g. '2026-07-24T10:00Z' < '2026-07-24T10:30Z' as plain strings, matching
# numeric/chronological order) against explicit ISO bounds, a different code path from
# turns_between's mktime+OFFSET correction. A real bug in either implementation (an OFFSET sign
# flip, a mktime DST edge case, an off-by-one in the window bound) has real odds of NOT
# reproducing identically in both, so a genuine divergence can surface here — unlike re-summing
# the same already-bucketed rows. Same exclusive-lo/inclusive-hi contract as turns_between.
independent_window_tally(){  # argv: lo_iso hi_iso -> prints "count win" pairs, one per window
  local lo="$1" hi="$2"
  [ -f "$SPEND_LOG" ] || return 0
  awk -v lo="$lo" -v hi="$hi" '
    $2=="turn" && NF>=6 { ts=$1; win=$3; if (ts>lo && ts<=hi) c[win]++ }
    END { for (w in c) print c[w], w }
  ' "$SPEND_LOG"
}
# do_balance_rolling: the double-entry view of the rolling-5h window --budget already tallies:
# same turns_between source, same per-window grouping (windows ARE the accounts), printed as
# Dr/Cr instead of a cap table. The trailing checksum compares turns_between's total against
# independent_window_tally's total — two genuinely separate parsers, not the same bucketed rows
# recounted two ways.
do_balance_rolling(){
  local hi lo; hi="$(date -u +%s)"; lo=$(( hi - $(awk "BEGIN{print int($WINDOW_H*3600)}") ))
  local rows; rows="$(turns_between "$lo" "$hi")"
  local total; total="$(printf '%s\n' "$rows" | grep -c .)"
  printf 'assets:budget            %6d TURN\n' "$(( -total ))"
  printf 'expenses:labour           %6d TURN\n' "$total"
  printf '%s\n' "$rows" | grep . | awk '{c[$3]++} END{for(w in c) print c[w], w}' | sort -rn | \
    awk '{printf "  %-20s %6d\n", $2, $1}'
  local hi_iso lo_iso
  hi_iso="$(date -u +%Y-%m-%dT%H:%MZ)"; lo_iso="$(date -u -d "-${WINDOW_H} hours" +%Y-%m-%dT%H:%MZ)"
  local ind_total; ind_total="$(independent_window_tally "$lo_iso" "$hi_iso" | awk '{s+=$1} END{print s+0}')"
  printf '%s\n' "$(printf '%0.s-' $(seq 1 30))"
  printf '%30d\n' "$(( total - ind_total ))"
}

# ============================ DISPATCH ============================
case "${1:-}" in
  --feed)     do_feed ;;
  --budget|"") do_budget ;;
  --balance)
    if [ "${2:-}" = "--rolling" ]; then
      do_balance_rolling
    else
      ensure_repo; hledger -f "$(main_journal)" balance expenses:labour assets:budget --tree "${@:2}"
    fi ;;
  --register) ensure_repo; hledger -f "$(main_journal)" register "${@:2}" ;;
  --branch)   do_branch "${2:-}" ;;
  --propose-cap) do_propose_cap ;;
  --availability|--avail) do_availability "${2:-}" ;;
  --json)     do_json ;;
  --coupling) do_coupling ;;
  --check)    do_check ;;
  --dash)     do_dash ;;
  --test)     do_test ;;
  -h|--help)  sed -n '1,45p' "$0" | grep -E '^#' | sed 's/^# \{0,1\}//' ;;
  *) echo "mesh-labor: unknown arg '$1' (try --help)" >&2; exit 2 ;;
esac
