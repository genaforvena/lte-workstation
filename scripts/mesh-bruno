#!/usr/bin/env bash
# mesh-bruno — the BRUNO cross-section: a single perspective fusing every signal we
# have about the operator's cat into ONE coarse ACTIVITY read (sleep / active / eat /
# resting), NOT a location. This is the "разрез" the operator asked for (2026-07-06):
# the bruno channel's data pane is not "data in general" but the angle from which we
# look at Bruno. Scope is deliberately activity-not-geometry ([[cat-tracking-scope-is-activity-not-location]]).
#
# Three existing signals, no new capture infra:
#   1. VISION  — mesh-imac-cam-watch's ~/.mesh/imac-cat-log.tsv (Groq vision on the iMac
#                cam near the bed): "Cat visible on the bed" vs "No cat visible".
#   2. ACTIVITY— mesh-wifi-motion --json (device-free RSSI-variance MOTION/STILL axis; its
#                thin_signal hint keeps the axis honest-DEGRADED when anchors < MIN_STABLE).
#   3. TRUTH   — operator's own TG labels in ~/.mesh/voice-in.log ("Бруно спит/ест/активен"):
#                the ground-truth override when fresh.
#
# Honest fusion: an absent/stale input renders its axis UNKNOWN, never a faked all-clear
# ([[fusion-tools-distinguish-empty-from-failed]]). All inputs cold -> STATE=UNKNOWN.
#
# Usage:
#   mesh-bruno            one-shot fused read (human, for the dash)
#   mesh-bruno --json     machine-readable {state, driver, seen, activity, label, ts}
#   mesh-bruno --test     smoke-test (fixtures, no live cam/wifi)
#
# reflex-cadence: */5 * * * *
# Cheap (local file parse + one wifi-motion tape classify) — safe at 5-min cadence to keep
# the bruno dash's cached state fresh; --test is sandboxed (fixtures, no real read).
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"

MESH="$HOME/.mesh"; mkdir -p "$MESH"
# node-local tuning (gitignored) sourced so the SAME defaults reach the cron reflex AND the pane.
# Primary use: MESH_BRUNO_TZ (Bruno's local timezone — the circadian prior keys on it; an unset/wrong
# TZ makes every prediction fire at the wrong local hour → false DIVERGENCE). Absent file = UTC default.
# The file supplies DEFAULTS: an explicitly-passed MESH_BRUNO_* env var (a test fixture, a caller
# override) must WIN over it — sourcing unconditionally clobbered the fixtures' own TZ/state on any
# tuned node, so the --test asserted whatever this node's bruno.env said, not the fixture.
if [ -f "$MESH/bruno.env" ]; then
  _pre="$(env | grep -E '^MESH_BRUNO_[A-Z_]+=' || true)"
  set -a; . "$MESH/bruno.env"; set +a
  while IFS='=' read -r _k _v; do [ -n "$_k" ] && export "$_k=$_v"; done <<< "$_pre"
  unset _pre _k _v
fi
CAMLOG="${MESH_BRUNO_CAMLOG:-$MESH/imac-cat-log.tsv}"
# scene-hold inputs (the cam feeder's own liveness artifacts — see the scene-hold block below):
CAMSTATE="${MESH_BRUNO_CAMSTATE:-$MESH/.imac-cam-watch.state}"    # SEEING/DARK/COVERED/…, mtime re-touched every cycle
CAMMOTION="${MESH_BRUNO_CAMMOTION:-$MESH/.imac-cam-last-motion}"  # epoch of last diff-threshold crossing (any, incl. cooldown-suppressed)
CAM_HOLD_MAX="${MESH_BRUNO_CAM_HOLD_MAX:-300}"  # SEEING mtime older than this = feeder not provably live (producer re-touches ≤120s)
VOICELOG="${MESH_BRUNO_VOICELOG:-$MESH/voice-in.log}"
STATE="${MESH_BRUNO_STATE:-$MESH/bruno.state}"
NOWIFI="${MESH_BRUNO_NOWIFI:-}"   # test hermeticity: skip the mesh-wifi-motion call

# ---- --test: hermetic, fixture-driven (no live cam/wifi/network) ----
if [ "${1:-}" = "--test" ]; then
  f=0
  for d in date grep awk sed; do command -v "$d" >/dev/null 2>&1 || { echo "  FAIL: $d missing"; f=1; }; done
  tmp="$(mktemp -d)"; _t0=$(date +%s)
  # hermetic: no fixture may read the LIVE feeder-liveness artifacts (.imac-cam-watch.state /
  # .imac-cam-last-motion) — on the mind node they exist and are fresh, so an unsandboxed fixture's
  # scene-hold verdict would depend on the node's real camera state (test-child-inherits trap).
  export MESH_BRUNO_CAMSTATE="$tmp/absent-camstate" MESH_BRUNO_CAMMOTION="$tmp/absent-cammotion"
  # voice fixture, three lines exercising the gate:
  #  1. a SHORT real label (oldest);
  #  2. the operator's LONG walk-design paragraph — mentions 'обруно' MID-sentence and is full of
  #     'то есть' (the input that first FALSELY read EATING via a bare 'ест' substring). It must be
  #     REJECTED because it does NOT begin with the cat's name (start-anchor gate), NOT because of length;
  #  3. a real long CONTEXTUAL label with parenthetical context (newest) — this is what the byte-length
  #     gate USED to silently drop; it MUST now be accepted → SLEEPING (the real-read gate for the fix).
  { echo "2026-07-06T10:00:00Z  VOICE  Бруно спит на кровати";
    echo "2026-07-06T17:48:48Z  VOICE  Да, и кстати на прогулке, то есть вот про обруно, то есть если появляется фокус, то есть надо смотреть за бруны в контексте";
    echo "2026-07-06T18:00:00Z  TEXT  Бруно спит на диване в спальне (та же комната, мак+ideapad) — оператор текстом"; } > "$tmp/voice.log"
  echo "2026-07-06T17:00:00Z	Bed and printer. Cat visible on the bed." > "$tmp/cam.log"
  out="$(MESH_BRUNO_VOICELOG="$tmp/voice.log" MESH_BRUNO_CAMLOG="$tmp/cam.log" \
         MESH_BRUNO_STATE="$tmp/state" MESH_BRUNO_NOWIFI=1 "$0" --json 2>/dev/null)"
  case "$out" in *'"label":"SLEEPING"'*) : ;; *) echo "  FAIL: contextual 'Бруно спит на диване (…)' label not accepted → SLEEPING — length-gate regression (got: $out)"; f=1 ;; esac
  case "$out" in *'"label":"EATING"'*) echo "  FAIL: walk-paragraph 'то есть' falsely read as EATING (regression)"; f=1 ;; esac
  case "$out" in *'"seen":"SEEN"'*) : ;; *) echo "  FAIL: cat-visible cam fixture not read as SEEN (real-read gate)"; f=1 ;; esac

  # --- transition-parenthetical misclassification (2026-07-11) ---
  # operator label "сейчас лежит" (now lying = RESTING) was misread as ACTIVE because the
  # parenthetical "(переход: спал→активен→лежит)" contains "активен" → bare token match on the
  # full line. Strip parens before matching + recognize "лежит"→RESTING.
  { echo "2026-07-07T01:14:11Z  TEXT  Бруно: ходил по кровати, сейчас лежит на подушке у окна рядом с ideapad (переход: спал→активен→лежит) — оператор текстом"; } > "$tmp/voice_tr.log"
  out_tr="$(MESH_BRUNO_VOICELOG="$tmp/voice_tr.log" MESH_BRUNO_CAMLOG=/dev/null \
            MESH_BRUNO_STATE="$tmp/state_tr" MESH_BRUNO_NOWIFI=1 "$0" --json 2>/dev/null)"
  case "$out_tr" in *'"label":"RESTING"'*) : ;; *) echo "  FAIL: 'сейчас лежит' with '(переход: …активен…)' paren must read RESTING not ACTIVE (got: $out_tr)"; f=1 ;; esac
  case "$out_tr" in *'"label":"ACTIVE"'*) echo "  FAIL: transition-paren 'активен' still misclassifies as ACTIVE (got: $out_tr)"; f=1 ;; esac

  # --- English resting vocabulary (2026-07-15): operator wrote "Bruno laying, chilling by the window";
  # laying/chilling weren't in the vocab (and the only catch token was inside parens, stripped) -> the
  # fresh label was silently dropped -> hollow calibration channel. Must now classify RESTING.
  { echo "$(date -u +%Y-%m-%dT%H:%M:%SZ)  TEXT  Bruno laying, chilling by the window"; } > "$tmp/voice_en.log"
  out_en="$(MESH_BRUNO_VOICELOG="$tmp/voice_en.log" MESH_BRUNO_CAMLOG=/dev/null \
            MESH_BRUNO_STATE="$tmp/state_en" MESH_BRUNO_NOWIFI=1 "$0" --json 2>/dev/null)"
  case "$out_en" in *'"label":"RESTING"'*) : ;; *) echo "  FAIL: 'Bruno laying, chilling' must classify RESTING (English vocab, got: $out_en)"; f=1 ;; esac

  # --- poke gate: `since` must mean WHEN THE SURPRISE BEGAN, not when we last looked (2026-07-15) ---
  # The state write used to sit OUTSIDE the change check while bruno's cron is */5, so `since` was
  # re-stamped every eval: now-since was ~300s forever and could NEVER reach POKE_REMIND=7200 —
  # the whole "re-remind a stuck wake-kind every 2h" branch was DEAD CODE (verified live: the state
  # file read DIVERGENCE|<7 seconds ago> while the divergence had persisted for hours). With remind
  # dead, the only surviving poke path is prev!=surprise, so a FLAPPING condition became the sole
  # wake source — ~2.4 paid mind-wakes/hour on mesh-home's marginal 5-AP corpus.
  # Mirror image of the liveness-touch convention: there an unconditional write is REQUIRED (mtime =
  # ran-live); here an unconditional write DESTROYS the change-time the logic depends on.
  # The stub goes through MESH_BRUNO_TELL, NOT PATH: this script re-exports
  # PATH="$HOME/.local/bin:$PATH" at startup, so a PATH-prepended stub loses to the real mesh-tell
  # and the dry-run pokes the operator's live window (observed 2026-07-15 — an h3 deep-night fixture
  # surfaced as a real 19:00 reflex message). A test that can reach the real transport is a test that
  # forges the evidence it checks.
  _sp="$tmp/surp.state"; _lp="$tmp/lastpoke"; _tell="$tmp/tell.log"
  printf '#!/bin/sh\necho "$@" >> "%s"\n' "$_tell" > "$tmp/tellstub"; chmod +x "$tmp/tellstub"
  # POKE_DEBOUNCE=0 isolates this test's SUBJECT (the transport + the `since` write). The debounce is
  # asserted separately below; leaving it on here would make these fixtures never poke and the
  # transport assertion would pass/fail for the wrong reason.
  _pokerun(){ MESH_BRUNO_TELL="$tmp/tellstub" MESH_BRUNO_SURP_STATE="$_sp" MESH_BRUNO_LASTPOKE="$_lp" MESH_BRUNO_POKE_LEDGER="$tmp/pl_pokerun" \
      MESH_BRUNO_WIFI_LEASE="$tmp/pokelease" MESH_BRUNO_POKE_DEBOUNCE=0 \
      MESH_BRUNO_VOICELOG=/dev/null MESH_BRUNO_CAMLOG=/dev/null MESH_BRUNO_STATE="$tmp/s_poke" \
      MESH_BRUNO_NOWIFI=1 MESH_BRUNO_HOUR_OVERRIDE="${1:-3}" "$0" >/dev/null 2>&1; }
  _pokerun 3; _s1="$(cut -d'|' -f2 "$_sp" 2>/dev/null)"; _k1="$(cut -d'|' -f1 "$_sp" 2>/dev/null)"
  sleep 2
  _pokerun 3; _s2="$(cut -d'|' -f2 "$_sp" 2>/dev/null)"
  [ -n "$_s1" ] || { echo "  FAIL: poke gate wrote no surprise state (got kind='$_k1')"; f=1; }
  [ "$_s1" = "$_s2" ] || { echo "  FAIL: 'since' must NOT advance while the surprise is UNCHANGED — re-stamping it makes now-since track the eval cadence, so POKE_REMIND can never fire (dead code): $_s1 -> $_s2"; f=1; }
  # ...but a CHANGED surprise must re-stamp, or a new condition inherits the old one's age and
  # re-reminds instantly.
  printf 'CONFIRMED|1\n' > "$_sp"
  _pokerun 3; _s3="$(cut -d'|' -f2 "$_sp" 2>/dev/null)"
  [ "$_s3" != "1" ] || { echo "  FAIL: a CHANGED surprise must re-stamp 'since' (got stale since=$_s3)"; f=1; }
  # --- SAME-KIND DEBOUNCE: a wake kind must PERSIST before it costs a paid mind (2026-07-16) ---
  # The gate poked on the TRANSITION (prev != surprise), so a single eval of a wake kind woke a mind.
  # Measured in bruno.log: SENSE-FAILURE arrives in isolated 1-2 eval dips surrounded by long
  # UNCORROBORATED runs (23, then 8) — the wifi lease briefly ages out between decisive verdicts on
  # mesh-home's marginal 5-AP corpus, then recovers within 5-10min. Each dip = one paid wake at 03:00
  # for a blindness that had already ended before the mind read the message.
  # This is only SAFE now that POKE_REMIND actually works (c2d6d39): debouncing the transition when
  # the remind branch was dead would have left the reflex permanently silent. Order mattered.
  _dbtell="$tmp/db_tell.log"
  printf '#!/bin/sh\necho "$@" >> "%s"\n' "$_dbtell" > "$tmp/dbstub"; chmod +x "$tmp/dbstub"
  _dbsp="$tmp/db_surp.state"
  _dbrun(){ # $1=kind-seed state file contents; echoes the stub log
    : > "$_dbtell"
    printf '%s\n' "$1" > "$_dbsp"
    MESH_BRUNO_TELL="$tmp/dbstub" MESH_BRUNO_SURP_STATE="$_dbsp" MESH_BRUNO_LASTPOKE="$tmp/lp_db" MESH_BRUNO_POKE_LEDGER="$tmp/pl_db" \
      MESH_BRUNO_WIFI_LEASE="$tmp/dblease" MESH_BRUNO_VOICELOG=/dev/null MESH_BRUNO_CAMLOG=/dev/null \
      MESH_BRUNO_STATE="$tmp/s_db" MESH_BRUNO_NOWIFI=1 MESH_BRUNO_HOUR_OVERRIDE=3 \
      MESH_BRUNO_POKE_DEBOUNCE=900 "$0" >/dev/null 2>&1
    cat "$_dbtell" 2>/dev/null; }
  rm -f "$tmp/lp_db"
  # THE REAL FLAP: prev is a NON-wake kind and this eval flips to a wake kind. That TRANSITION is
  # what poked — seeding the same kind would not exercise it (prev==surprise already never pokes).
  out_db1="$(_dbrun "UNCORROBORATED|$(( $(date +%s) - 99999 ))")"
  [ -z "$out_db1" ] || { echo "  FAIL: a wake kind held < POKE_DEBOUNCE must NOT poke — a 5-min blind dip that self-heals is not worth a paid mind (got: $out_db1)"; f=1; }
  # ...and one that has PERSISTED past the debounce must wake
  rm -f "$tmp/lp_db"
  out_db2="$(_dbrun "SENSE-FAILURE|$(( $(date +%s) - 99999 ))")"
  [ -n "$out_db2" ] || { echo "  FAIL: a wake kind sustained past POKE_DEBOUNCE MUST poke — debouncing must not silence a real, persistent condition"; f=1; }
  # a BRAND-NEW wake kind (no prior state) must also debounce, not fire on first sight
  rm -f "$tmp/lp_db" "$_dbsp"; : > "$_dbtell"
  MESH_BRUNO_TELL="$tmp/dbstub" MESH_BRUNO_SURP_STATE="$_dbsp" MESH_BRUNO_LASTPOKE="$tmp/lp_db" MESH_BRUNO_POKE_LEDGER="$tmp/pl_db" \
    MESH_BRUNO_WIFI_LEASE="$tmp/dblease" MESH_BRUNO_VOICELOG=/dev/null MESH_BRUNO_CAMLOG=/dev/null \
    MESH_BRUNO_STATE="$tmp/s_db" MESH_BRUNO_NOWIFI=1 MESH_BRUNO_HOUR_OVERRIDE=3 \
    MESH_BRUNO_POKE_DEBOUNCE=900 "$0" >/dev/null 2>&1
  [ -s "$_dbtell" ] && { echo "  FAIL: a first-sight wake kind must start its debounce clock, not poke immediately (got: $(cat "$_dbtell"))"; f=1; }

  # --- RECURRING episode must respect the per-kind REMIND, not re-poke every episode (2026-07-16) ---
  # The debounce stops a single-dip FLAP. But a CHRONIC condition that oscillates in and out of the
  # wake state (mesh-home post-TV-off: corpus at MIN_STABLE=4, so wifi goes UNCERTAIN for 40min,
  # recovers, re-degrades) produced a SEPARATE sustained episode each cycle — and each reset lastp=0
  # and re-poked, defeating the 2h remind and waking a mind ~hourly for the SAME unactionable state.
  # A wake kind must poke at most once per POKE_REMIND regardless of how many episodes it churns
  # through — the remind is per-KIND, not per-episode. (A DIFFERENT kind is not suppressed: its own
  # ledger entry is empty, so a genuine DIVERGENCE still pokes even right after a SENSE-FAILURE.)
  _led="$tmp/pokeledger"; _dbtell2="$tmp/db2_tell.log"; _dbsp2="$tmp/db2_surp.state"
  printf '#!/bin/sh\necho "$@" >> "%s"\n' "$_dbtell2" > "$tmp/db2stub"; chmod +x "$tmp/db2stub"
  _recrun(){ # $1=state-file seed → runs one eval, appends any poke to $_dbtell2
    printf '%s\n' "$1" > "$_dbsp2"
    MESH_BRUNO_TELL="$tmp/db2stub" MESH_BRUNO_SURP_STATE="$_dbsp2" MESH_BRUNO_POKE_LEDGER="$_led" \
      MESH_BRUNO_LASTPOKE="$tmp/lp2" MESH_BRUNO_WIFI_LEASE="$tmp/declease2" \
      MESH_BRUNO_VOICELOG=/dev/null MESH_BRUNO_CAMLOG=/dev/null MESH_BRUNO_STATE="$tmp/s_rec" \
      MESH_BRUNO_NOWIFI=1 MESH_BRUNO_HOUR_OVERRIDE=3 MESH_BRUNO_POKE_DEBOUNCE=900 MESH_BRUNO_POKE_COOLDOWN=0 "$0" >/dev/null 2>&1; }
  rm -f "$_led" "$tmp/lp2" "$_dbtell2"
  # (a) a sustained SENSE-FAILURE episode pokes once
  _recrun "SENSE-FAILURE|$(( $(date +%s) - 99999 ))|0"
  [ "$(grep -c bruno-reflex "$_dbtell2" 2>/dev/null)" = 1 ] || { echo "  FAIL: first sustained SENSE-FAILURE episode must poke once (got: $(cat "$_dbtell2" 2>/dev/null))"; f=1; }
  # (b) the episode ends: kind flips to UNCORROBORATED (a non-wake) — no poke, ledger keeps SF's stamp
  : > "$_dbtell2"; _recrun "UNCORROBORATED|$(( $(date +%s) - 99999 ))|0"
  [ -s "$_dbtell2" ] && { echo "  FAIL: a non-wake kind must not poke (got: $(cat "$_dbtell2"))"; f=1; }
  # (c) SENSE-FAILURE RECURS and sustains past debounce, still within POKE_REMIND of (a) — must NOT re-poke
  : > "$_dbtell2"; _recrun "SENSE-FAILURE|$(( $(date +%s) - 99999 ))|0"
  [ -s "$_dbtell2" ] && { echo "  FAIL: a recurring SENSE-FAILURE within POKE_REMIND must NOT re-poke — the remind is per-KIND, not per-episode; each episode re-poking is the ~hourly-noise bug (got: $(cat "$_dbtell2"))"; f=1; }
  # (d) a DIFFERENT wake kind (DIVERGENCE) is NOT suppressed by SENSE-FAILURE's recent poke.
  # Owns its OWN fresh label fixture — a test that borrows another test's leftover file breaks when
  # that file's lifetime changes (this assertion silently passed/failed on voice_div.log's absence
  # until instrumented).
  printf '%s  VOICE  Бруно кушает у миски\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$tmp/voice_db_div.log"
  : > "$_dbtell2"; MESH_BRUNO_TELL="$tmp/db2stub" MESH_BRUNO_SURP_STATE="$_dbsp2" MESH_BRUNO_POKE_LEDGER="$_led" \
    MESH_BRUNO_LASTPOKE="$tmp/lp2" MESH_BRUNO_VOICELOG="$tmp/voice_db_div.log" MESH_BRUNO_CAMLOG=/dev/null \
    MESH_BRUNO_STATE="$tmp/s_rec" MESH_BRUNO_NOWIFI=1 MESH_BRUNO_HOUR_OVERRIDE=3 MESH_BRUNO_POKE_DEBOUNCE=0 \
    MESH_BRUNO_POKE_COOLDOWN=0 "$0" >/dev/null 2>&1
  grep -q 'DIVERGENCE' "$_dbtell2" 2>/dev/null || { echo "  FAIL: a genuine DIVERGENCE must still poke even right after a SENSE-FAILURE — per-kind remind must not cross kinds (got: $(cat "$_dbtell2" 2>/dev/null))"; f=1; }

  # the poke must have gone to the STUB, never the real transport — proves the injection actually
  # holds against this script's own PATH re-export (the bug that let a fixture poke the live window)
  [ -s "$_tell" ] || { echo "  FAIL: poke gate never invoked the injected transport — the stub is not on the path the poke really takes"; f=1; }
  grep -q 'bruno-reflex' "$_tell" 2>/dev/null || { echo "  FAIL: injected transport got no bruno-reflex poke (got: $(cat "$_tell" 2>/dev/null))"; f=1; }
  # the --test must never touch the LIVE poke-gate artifacts (mesh-doctor runs it hourly)
  # (an mtime-freshness check on the LIVE bruno-surprise.state used to sit here — but the bruno dash
  # pane re-evals mesh-bruno every 30s, so the live file is legitimately fresh ~17% of the time and
  # the check false-FAILED on pane ticks (observed 2026-07-16 17:43:51, a pane write mid-suite). An
  # assertion a concurrent legitimate writer can trip asserts nothing; the injection-honored claim is
  # carried positively by the "_s1 non-empty" check above — a fixture whose SURP_STATE override were
  # ignored would leave its sandbox file unwritten and fail THERE, deterministically.)

  # --- chat-review/bruno-seen-axis-stale-lockin (2026-07-07) ---
  # (1) an old affirming SEEN row followed by several FRESH "No cat visible" rows must read
  # NOT-IN-FRAME, not SEEN — an old sighting must not outlive fresh negative reads (live bug:
  # seen=SEEN at 9h stale against 6+ consecutive fresh negative reads).
  { echo "2026-07-06T08:00:00Z	Cat visible on the bed.";
    echo "2026-07-07T20:30:00Z	Bed, dark shirt.";
    echo "No cat visible.";
    echo "2026-07-07T20:35:00Z	Empty bed.";
    echo "No cat visible.";
    echo "2026-07-07T20:40:00Z	Empty room, no cat.";
    echo "No cat visible."; } > "$tmp/cam2.log"
  out2="$(MESH_BRUNO_VOICELOG="$tmp/no_voice.log" MESH_BRUNO_CAMLOG="$tmp/cam2.log" \
          MESH_BRUNO_STATE="$tmp/state2" MESH_BRUNO_NOWIFI=1 "$0" --json 2>/dev/null)"
  case "$out2" in *'"seen":"NOT-IN-FRAME"'*) : ;; *) echo "  FAIL: old SEEN row must not outlive fresh negative rows -> NOT-IN-FRAME (got: $out2)"; f=1 ;; esac
  case "$out2" in *'"seen":"SEEN"'*) echo "  FAIL: stale-lockin regression — still reads SEEN off the old row (got: $out2)"; f=1 ;; esac

  # (2) fresh NOT-IN-FRAME + wifi STILL must downgrade to UNKNOWN, never assert RESTING
  # (explicit absence corroborates AGAINST presence, it isn't the same as no-data-at-all)
  # ACT_AGE_OVERRIDE=60 is load-bearing: without an age the wifi lease is UNFRESH and this test
  # passes VACUOUSLY (state=UNKNOWN because nothing is fresh, not because absence corroborates).
  # MESH_BRUNO_WIFI_LEASE sandboxed on EVERY ACT_OVERRIDE fixture below: a decisive injected verdict
  # writes the lease file, and the default is the LIVE .bruno-wifi-lease — mesh-doctor runs this
  # --test hourly, so an unsandboxed fixture forges the node's real wifi evidence on the hour
  # (observed 2026-07-16: live lease stamp 14:22:20 = doctor's 14:23:20 pass minus AGE_OVERRIDE=60,
  # where a real decisive read always stamps a sweep timestamp). Gate at the end of the suite.
  out3="$(MESH_BRUNO_VOICELOG="$tmp/no_voice.log" MESH_BRUNO_CAMLOG="$tmp/cam2.log" MESH_BRUNO_WIFI_LEASE="$tmp/lease3" \
          MESH_BRUNO_STATE="$tmp/state3" MESH_BRUNO_ACT_OVERRIDE=STILL MESH_BRUNO_ACT_AGE_OVERRIDE=60 "$0" --json 2>/dev/null)"
  case "$out3" in *'"state":"UNKNOWN"'*) : ;; *) echo "  FAIL: NOT-IN-FRAME + wifi STILL must be UNKNOWN, not asserted (got: $out3)"; f=1 ;; esac
  case "$out3" in *'"state":"RESTING"'*) echo "  FAIL: NOT-IN-FRAME + wifi STILL must NOT be RESTING (got: $out3)"; f=1 ;; esac

  # (3) no vision history at all (seen=UNKNOWN) + wifi STILL -> RESTING, existing behavior preserved
  : > "$tmp/no_cam.log"
  out4="$(MESH_BRUNO_VOICELOG="$tmp/no_voice.log" MESH_BRUNO_CAMLOG="$tmp/no_cam.log" MESH_BRUNO_WIFI_LEASE="$tmp/lease4" \
          MESH_BRUNO_STATE="$tmp/state4" MESH_BRUNO_ACT_OVERRIDE=STILL MESH_BRUNO_ACT_AGE_OVERRIDE=60 "$0" --json 2>/dev/null)"
  case "$out4" in *'"state":"RESTING"'*) : ;; *) echo "  FAIL: no-vision-history + wifi STILL should still be RESTING (regression, got: $out4)"; f=1 ;; esac

  # --- scene-hold (2026-07-16): a SEEING feeder over an unchanged scene keeps the read live ---
  # The feeder writes CATLOG rows only on motion, so without the hold a healthy motionless camera
  # can never satisfy the cam lease (live: "cam EXPIRED(51m) [fresh=0]" while the daemon captured
  # every 8s, state SEEING) — an unsatisfiable-by-a-healthy-feeder lease.
  _sh_cam="$tmp/sh_cam.log"; _sh_state="$tmp/sh_camstate"; _sh_mot="$tmp/sh_cammotion"
  _sh_row_iso="$(date -u -d "@$(( $(date +%s) - 7200 ))" +%Y-%m-%dT%H:%M:%SZ)"
  printf '%s\tEmpty bed.\nNo cat visible.\n' "$_sh_row_iso" > "$_sh_cam"
  echo SEEING > "$_sh_state"                       # mtime = now → feeder provably live
  echo $(( $(date +%s) - 7300 )) > "$_sh_mot"      # last motion BEFORE the row → scene unchanged since
  _shrun(){ MESH_BRUNO_VOICELOG="$tmp/no_voice.log" MESH_BRUNO_CAMLOG="$_sh_cam" MESH_BRUNO_CAMSTATE="$_sh_state" \
            MESH_BRUNO_CAMMOTION="$_sh_mot" MESH_BRUNO_STATE="$tmp/state_sh" MESH_BRUNO_NOWIFI=1 MESH_BRUNO_NOPOKE=1 \
            MESH_BRUNO_HOUR_OVERRIDE=3 "$0" --json 2>/dev/null; }
  out_sh="$(_shrun)"
  case "$out_sh" in *'"seen_held":1'*) : ;; *) echo "  FAIL: SEEING + no motion since the row must HOLD the read (got: $out_sh)"; f=1 ;; esac
  _sh_a="$(printf '%s' "$out_sh" | grep -oE '"seen_age_s":-?[0-9]+' | cut -d: -f2)"
  { [ -n "$_sh_a" ] && [ "$_sh_a" -lt 300 ]; } || { echo "  FAIL: held seen_age must be the feeder's liveness age (<300s), got ${_sh_a:-?}"; f=1; }
  # (b) motion AFTER the row (classify-cooldown-suppressed) → the scene DID change: no hold
  echo $(( $(date +%s) - 60 )) > "$_sh_mot"
  out_shm="$(_shrun)"
  case "$out_shm" in *'"seen_held":0'*) : ;; *) echo "  FAIL: motion newer than the row must BLOCK the hold — the scene changed unclassified (got: $out_shm)"; f=1 ;; esac
  # (c) a blind eye cannot refute a cat entering: DARK never holds
  echo $(( $(date +%s) - 7300 )) > "$_sh_mot"; echo DARK > "$_sh_state"
  out_shd="$(_shrun)"
  case "$out_shd" in *'"seen_held":0'*) : ;; *) echo "  FAIL: a non-SEEING eye (DARK) must not hold (got: $out_shd)"; f=1 ;; esac
  # (d) a dead daemon stops touching the state file → the hold ages out honestly
  echo SEEING > "$_sh_state"; touch -d '-20 minutes' "$_sh_state"
  out_shs="$(_shrun)"
  case "$out_shs" in *'"seen_held":0'*) : ;; *) echo "  FAIL: a stale SEEING mtime (dead daemon) must not hold (got: $out_shs)"; f=1 ;; esac
  # (e) the hold extends SEEN too — the motionless sleeping cat is the common case; the cam
  # lease must stay FRESH while the camera stares at him
  printf '%s\tCat visible on the bed.\n' "$_sh_row_iso" > "$_sh_cam"
  echo SEEING > "$_sh_state"
  out_shc="$(_shrun)"
  case "$out_shc" in *'"seen":"SEEN"'*) : ;; *) echo "  FAIL: SEEN fixture broken (got: $out_shc)"; f=1 ;; esac
  case "$out_shc" in *'"seen_held":1'*) : ;; *) echo "  FAIL: a motionless SEEN scene must hold too (got: $out_shc)"; f=1 ;; esac
  case "$out_shc" in *'"cam_fresh":1'*) : ;; *) echo "  FAIL: held SEEN must keep the cam lease FRESH (got: $out_shc)"; f=1 ;; esac
  # (f) no motion-stamp artifact at all (feeder predates it) → conservative: no hold
  rm -f "$_sh_mot"
  out_shn="$(_shrun)"
  case "$out_shn" in *'"seen_held":0'*) : ;; *) echo "  FAIL: absent motion stamp must mean NO hold — cannot prove the scene unchanged (got: $out_shn)"; f=1 ;; esac

  # --- predictive layer (2026-07-15): prior + liveness-lease + surprise ---
  # SENSE-FAILURE: every sense cold -> no fresh lease -> surprise SENSE-FAILURE, fresh_observed 0.
  out_sf="$(MESH_BRUNO_VOICELOG=/dev/null MESH_BRUNO_CAMLOG=/dev/null \
            MESH_BRUNO_STATE="$tmp/state_sf" MESH_BRUNO_NOWIFI=1 MESH_BRUNO_HOUR_OVERRIDE=3 MESH_BRUNO_NOPOKE=1 "$0" --json 2>/dev/null)"
  case "$out_sf" in *'"surprise":"SENSE-FAILURE"'*) : ;; *) echo "  FAIL: all senses cold must be SENSE-FAILURE (got: $out_sf)"; f=1 ;; esac
  case "$out_sf" in *'"fresh_observed":0'*) : ;; *) echo "  FAIL: all cold -> fresh_observed must be 0 (got: $out_sf)"; f=1 ;; esac

  # SENSE-ALIVE-NOT-BLIND: a LIVE camera that sees the bed EMPTY is not blindness. A fresh
  # "No cat visible" row (cam SEEING, Bruno merely out of its narrow bed-view) is a real negative
  # observation. cam_fresh gates on SEEN only — correct for the FUSION, since an empty bed cannot
  # assert Bruno's state — but fresh_obs (the blind/not-blind axis) must count the cam as ALIVE, or
  # a working camera is mislabelled "senses blind" and wakes a paid mind. Same gap the thin-signal
  # lease already closed for wifi: an alive-but-uncorroborating axis is UNCORROBORATED, not
  # SENSE-FAILURE. Live 2026-07-17T10:10Z: seen NOT-IN-FRAME age 240s (LEASE_CAM 1800, lease NOT
  # expired) yet fresh_observed 0 → SENSE-FAILURE poked the mind every 5m while the iMac cam
  # captured the empty bed every 8s. (The scene-hold sandbox above keeps this on the row's own age.)
  ts_nif=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  printf '%s\tBed and printer. No cat visible.\n' "$ts_nif" > "$tmp/cam_nif.log"
  out_nif="$(MESH_BRUNO_VOICELOG=/dev/null MESH_BRUNO_CAMLOG="$tmp/cam_nif.log" \
             MESH_BRUNO_STATE="$tmp/state_nif" MESH_BRUNO_NOWIFI=1 MESH_BRUNO_HOUR_OVERRIDE=3 MESH_BRUNO_NOPOKE=1 "$0" --json 2>/dev/null)"
  case "$out_nif" in *'"seen":"NOT-IN-FRAME"'*) : ;; *) echo "  FAIL: a fresh negative cam row must read NOT-IN-FRAME (got: $out_nif)"; f=1 ;; esac
  case "$out_nif" in *'"cam_fresh":0'*) : ;; *) echo "  FAIL: NOT-IN-FRAME must not set cam_fresh — an empty bed cannot assert a SEEN state (got: $out_nif)"; f=1 ;; esac
  case "$out_nif" in *'"fresh_observed":1'*) : ;; *) echo "  FAIL: a LIVE cam reading NOT-IN-FRAME is an ALIVE axis — fresh_observed must be 1, the camera is not blind (got: $out_nif)"; f=1 ;; esac
  case "$out_nif" in *'"surprise":"SENSE-FAILURE"'*) echo "  FAIL: a live camera that sees the bed empty is NOT 'senses blind' — must be UNCORROBORATED, not SENSE-FAILURE (got: $out_nif)"; f=1 ;; esac
  case "$out_nif" in *'"surprise":"UNCORROBORATED"'*) : ;; *) echo "  FAIL: live NOT-IN-FRAME with no other axis must be UNCORROBORATED (got: $out_nif)"; f=1 ;; esac
  # ...but a STALE NOT-IN-FRAME (iMac asleep overnight → cam log frozen, seen_age past LEASE_CAM) is
  # GENUINE blindness and MUST still surface as SENSE-FAILURE — cam_alive requires the row be within
  # its lease, exactly as cam_fresh does. This is the guard that stops the fix from masking real
  # darkness as merely-uncorroborated. (Mutation: drop the `-lt LEASE_CAM` from cam_alive → red here.)
  ts_stale=$(date -u -d '-3 hours' +%Y-%m-%dT%H:%M:%SZ)
  printf '%s\tBed and printer. No cat visible.\n' "$ts_stale" > "$tmp/cam_stale.log"
  out_st="$(MESH_BRUNO_VOICELOG=/dev/null MESH_BRUNO_CAMLOG="$tmp/cam_stale.log" \
            MESH_BRUNO_STATE="$tmp/state_st" MESH_BRUNO_NOWIFI=1 MESH_BRUNO_HOUR_OVERRIDE=3 MESH_BRUNO_NOPOKE=1 "$0" --json 2>/dev/null)"
  case "$out_st" in *'"fresh_observed":0'*) : ;; *) echo "  FAIL: a STALE NOT-IN-FRAME (past LEASE_CAM) is real blindness — fresh_observed must be 0 (got: $out_st)"; f=1 ;; esac
  case "$out_st" in *'"surprise":"SENSE-FAILURE"'*) : ;; *) echo "  FAIL: a stale cam (iMac asleep) must still be SENSE-FAILURE, not masked as UNCORROBORATED (got: $out_st)"; f=1 ;; esac

  # DIVERGENCE: hour 3 circadian predicts SLEEPING; a FRESH label says EATING -> observed != predicted.
  ts_now=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  printf '%s  VOICE  Бруно кушает у миски\n' "$ts_now" > "$tmp/voice_div.log"
  out_dv="$(MESH_BRUNO_VOICELOG="$tmp/voice_div.log" MESH_BRUNO_CAMLOG=/dev/null \
            MESH_BRUNO_STATE="$tmp/state_dv" MESH_BRUNO_NOWIFI=1 MESH_BRUNO_HOUR_OVERRIDE=3 MESH_BRUNO_NOPOKE=1 "$0" --json 2>/dev/null)"
  case "$out_dv" in *'"surprise":"DIVERGENCE"'*) : ;; *) echo "  FAIL: fresh EATING vs predicted SLEEPING must be DIVERGENCE (got: $out_dv)"; f=1 ;; esac
  case "$out_dv" in *'"predicted":"SLEEPING"'*) : ;; *) echo "  FAIL: hour-3 circadian prior must be SLEEPING (got: $out_dv)"; f=1 ;; esac
  case "$out_dv" in *'"state":"EATING"'*) : ;; *) echo "  FAIL: fresh EATING label must drive state EATING (got: $out_dv)"; f=1 ;; esac

  # --- UNCORROBORATED: a mismatch against a proxy that CANNOT SEE THE SUBJECT is not a surprise ---
  # mesh-wifi-motion is by its own header the operator's PEOPLE-sensing (device-free RSSI variance),
  # calibrated for human-scale motion. Bruno is a ~4kg cat: there is no evidence the axis can detect
  # him at all, so a wifi-only "RESTING" means "no human-scale motion in the room" — it reads STILL
  # whether he is asleep or doing zoomies. Waking a mind because that proxy disagrees with the
  # circadian prior is a poke on a question the proxy cannot answer, and "recalibrating" the prior
  # against it would drag it to RESTING regardless of Bruno's true state (an axis whose value is
  # indistinguishable from a constant — the tone-saturation family). The STATE stays RESTING (the
  # long-standing fusion behaviour, still asserted below); only the WAKE is withheld.
  out_un="$(MESH_BRUNO_VOICELOG=/dev/null MESH_BRUNO_CAMLOG=/dev/null MESH_BRUNO_WIFI_LEASE="$tmp/lease_un" \
            MESH_BRUNO_STATE="$tmp/state_un" MESH_BRUNO_ACT_OVERRIDE=STILL MESH_BRUNO_ACT_AGE_OVERRIDE=60 \
            MESH_BRUNO_HOUR_OVERRIDE=3 MESH_BRUNO_NOPOKE=1 "$0" --json 2>/dev/null)"
  case "$out_un" in *'"wifi_fresh":1'*) : ;; *) echo "  FAIL: ACT_AGE_OVERRIDE must make the wifi lease fresh (got: $out_un)"; f=1 ;; esac
  case "$out_un" in *'"state":"RESTING"'*) : ;; *) echo "  FAIL: wifi-only STILL must still FUSE to RESTING — only the wake is withheld (got: $out_un)"; f=1 ;; esac
  case "$out_un" in *'"surprise":"DIVERGENCE"'*) echo "  FAIL: wifi-only RESTING vs predicted SLEEPING must NOT be DIVERGENCE — the axis cannot see a cat, so the mismatch is not evidence (got: $out_un)"; f=1 ;; esac
  case "$out_un" in *'"surprise":"UNCORROBORATED"'*) : ;; *) echo "  FAIL: wifi-only mismatch must be UNCORROBORATED (got: $out_un)"; f=1 ;; esac
  # the PANE must not claim a wake the poke gate will not perform. The renderer used to hardcode
  # `[ "$surprise" = CONFIRMED ] && 'mind sleeps' || '→ wake mind'`, a SECOND copy of the wake rule —
  # so every non-CONFIRMED kind rendered "→ wake mind" while maybe_poke's list (SENSE-FAILURE|
  # DIVERGENCE) stayed silent. A mind reading the pane would act on a wake that never fires. Both
  # now share is_wake(); this asserts the render agrees with the gate.
  out_unh="$(MESH_BRUNO_VOICELOG=/dev/null MESH_BRUNO_CAMLOG=/dev/null MESH_BRUNO_WIFI_LEASE="$tmp/lease_unh" \
             MESH_BRUNO_STATE="$tmp/state_unh" MESH_BRUNO_ACT_OVERRIDE=STILL MESH_BRUNO_ACT_AGE_OVERRIDE=60 \
             MESH_BRUNO_HOUR_OVERRIDE=3 MESH_BRUNO_NOPOKE=1 "$0" 2>/dev/null | grep '^SURPRISE:')"
  case "$out_unh" in *'wake mind'*) echo "  FAIL: pane says '→ wake mind' for UNCORROBORATED, but maybe_poke only wakes on SENSE-FAILURE|DIVERGENCE — the render must share the gate's predicate, not a second copy of it (got: $out_unh)"; f=1 ;; esac
  case "$out_unh" in *'mind sleeps'*) : ;; *) echo "  FAIL: UNCORROBORATED must render as a non-wake (got: $out_unh)"; f=1 ;; esac
  # ...and a real wake kind must still SAY it wakes (guards the opposite drift)
  out_dvh="$(MESH_BRUNO_VOICELOG="$tmp/voice_div.log" MESH_BRUNO_CAMLOG=/dev/null \
             MESH_BRUNO_STATE="$tmp/state_dvh" MESH_BRUNO_NOWIFI=1 MESH_BRUNO_HOUR_OVERRIDE=3 MESH_BRUNO_NOPOKE=1 "$0" 2>/dev/null | grep '^SURPRISE:')"
  case "$out_dvh" in *'wake mind'*) : ;; *) echo "  FAIL: a real DIVERGENCE must render '→ wake mind' (got: $out_dvh)"; f=1 ;; esac

  # --- an INCONCLUSIVE window must not kill an UNEXPIRED lease (2026-07-15) ---
  # wifi_fresh required verdict MOTION|STILL, so a single UNCERTAIN dropped the lease INSTANTLY
  # however fresh the tape was -> fresh_obs=0 -> SENSE-FAILURE "senses blind". That conflates two
  # different claims: the axis is DEAD (tape frozen) vs the axis is ALIVE but this window was
  # inconclusive. On mesh-home's marginal 5-AP corpus (MIN_STABLE=4) the verdict oscillates
  # STILL<->UNCERTAIN every few sweeps, so the reflex flapped into a wake-level SENSE-FAILURE every
  # ~10min while the feeder was provably healthy. A LEASE decays on TIME — the pane's own invariant
  # says "state asserted only while a lease is FRESH" — and an inconclusive read carries NO
  # information, so it cannot refute the STILL observed a minute ago. Only a DECISIVE read re-stamps
  # the lease; an inconclusive one lets the old one keep decaying, and a genuinely dead axis still
  # ages past LEASE_WIFI into an honest SENSE-FAILURE.
  _wl="$tmp/wifi-lease"
  _leaserun(){ MESH_BRUNO_WIFI_LEASE="$_wl" MESH_BRUNO_VOICELOG=/dev/null MESH_BRUNO_CAMLOG=/dev/null \
      MESH_BRUNO_STATE="$tmp/state_lease" MESH_BRUNO_ACT_OVERRIDE="$1" MESH_BRUNO_ACT_AGE_OVERRIDE="$2" \
      MESH_BRUNO_HOUR_OVERRIDE=3 MESH_BRUNO_NOPOKE=1 "$0" --json 2>/dev/null; }
  rm -f "$_wl"
  out_l1="$(_leaserun STILL 60)"
  case "$out_l1" in *'"wifi_fresh":1'*) : ;; *) echo "  FAIL: a decisive STILL must hold the lease (got: $out_l1)"; f=1 ;; esac
  # now an inconclusive window: the unexpired STILL must SURVIVE it
  out_l2="$(_leaserun UNCERTAIN -1)"
  case "$out_l2" in *'"wifi_fresh":1'*) : ;; *) echo "  FAIL: an UNCERTAIN window must NOT kill an unexpired lease — no information cannot refute the last decisive read (got: $out_l2)"; f=1 ;; esac
  case "$out_l2" in *'"surprise":"SENSE-FAILURE"'*) echo "  FAIL: one inconclusive window must not declare 'senses blind' while the tape is fresh (got: $out_l2)"; f=1 ;; esac
  # ...but a lease older than LEASE_WIFI must EXPIRE honestly even though we hold a decisive verdict
  printf 'STILL|%s\n' "$(( $(date +%s) - 99999 ))" > "$_wl"
  out_l3="$(_leaserun UNCERTAIN -1)"
  case "$out_l3" in *'"wifi_fresh":0'*) : ;; *) echo "  FAIL: a decisive verdict older than LEASE_WIFI must EXPIRE — a held lease must never become immortal (got: $out_l3)"; f=1 ;; esac
  case "$out_l3" in *'"surprise":"SENSE-FAILURE"'*) : ;; *) echo "  FAIL: an expired wifi lease with no other axis must be an honest SENSE-FAILURE (got: $out_l3)"; f=1 ;; esac
  # an inconclusive read must NEVER re-stamp the lease (else it is immortal by construction)
  rm -f "$_wl"; _leaserun STILL 60 >/dev/null 2>&1; _t1="$(cut -d'|' -f2 "$_wl" 2>/dev/null)"
  sleep 1; _leaserun UNCERTAIN -1 >/dev/null 2>&1; _t2="$(cut -d'|' -f2 "$_wl" 2>/dev/null)"
  [ "$_t1" = "$_t2" ] || { echo "  FAIL: an inconclusive read re-stamped the lease ($_t1 -> $_t2) — the lease would never expire"; f=1; }

  # --- THE LEASE MUST BE SATISFIABLE BY A HEALTHY FEEDER (2026-07-15) ---------------
  # HERMETIC RUNNER, and it is load-bearing. :25 claims "--test is sandboxed (fixtures, no real read)"
  # — true of the cam/wifi ORGANS, false of node-local TUNING. :33 sources bruno.env under `set -a`,
  # which EXPORTS it into this suite's own environment; every child then inherits mesh-home's
  # MESH_BRUNO_LEASE_WIFI=1500 by plain inheritance — an explicit override of the very default these
  # gates exist to check. (Sandboxing HOME does NOT fix it: the child never needs to re-source the
  # file, it already has the vars. The tell is `"tz":"Europe/Moscow"` — bruno.env's TZ — surviving a
  # HOME sandbox. A gate answered by the environment is not asserting the code: driven through the
  # normal runner these go green here against a restored `:-600`, and red on a node with no such file.)
  # `env -u` strips the inherited override; the sandboxed HOME then stops the child re-sourcing it.
  _lh="$tmp/home"; mkdir -p "$_lh/.mesh"
  _leaserun_h(){ env -u MESH_BRUNO_LEASE_WIFI -u MESH_BRUNO_TZ HOME="$_lh" \
      MESH_BRUNO_WIFI_LEASE="$_wl" MESH_BRUNO_VOICELOG=/dev/null \
      MESH_BRUNO_CAMLOG=/dev/null MESH_BRUNO_STATE="$tmp/state_lease_h" MESH_BRUNO_ACT_OVERRIDE="$1" \
      MESH_BRUNO_ACT_AGE_OVERRIDE="$2" MESH_BRUNO_HOUR_OVERRIDE=3 MESH_BRUNO_NOPOKE=1 \
      "$0" --json 2>/dev/null; }
  # the sandbox must really be free of the node's override, or every assertion below is vacuous
  rm -f "$_wl"; _sanity="$(_leaserun_h STILL 1400)"
  case "$_sanity" in *'"wifi_fresh":1'*) : ;; *) echo "  FAIL: hermetic sandbox broken — a 1400s verdict must be fresh under the derived 1500s default (got: $_sanity)"; f=1 ;; esac
  # Not a threshold taste-test: 900s is DERIVED from the two declared cadences in this genome —
  # mesh-wifiscan's `# reflex-cadence: 6-59/10` (600s between sweeps, so the newest tape line is up to
  # 600s old) plus mesh-bruno's own `# reflex-cadence: */5` (300s between reads of it). A feeder that
  # never misses a single sweep therefore presents a 900s-old verdict routinely. The old default 600
  # EQUALLED the feeder's cadence, so this read was EXPIRED every cycle forever and bruno poked the
  # operator with "senses blind" while the tape was provably on time (14:46: sweeps at :36:01/:46:01,
  # lease read EXPIRED). A lease that a perfectly healthy producer cannot satisfy is not a lease.
  rm -f "$_wl"
  out_sat="$(_leaserun_h STILL 900)"
  case "$out_sat" in *'"wifi_fresh":1'*) : ;; *) echo "  FAIL: LEASE_WIFI must EXCEED wifiscan cadence(600)+bruno sampling(300)=900s — a feeder hitting every sweep must never read EXPIRED (got: $out_sat)"; f=1 ;; esac
  case "$out_sat" in *'"surprise":"SENSE-FAILURE"'*) echo "  FAIL: a healthy on-cadence feeder must not raise 'senses blind' (got: $out_sat)"; f=1 ;; esac
  # ...and the lease DEFERS to the producer's own GAP_LIMIT rather than carrying a second constant:
  # retuning the producer must move the lease with it, or the two definitions of "stale" drift apart.
  rm -f "$_wl"
  out_gap="$(MESH_WIFI_MOTION_GAP_LIMIT=120 _leaserun_h STILL 300)"
  case "$out_gap" in *'"wifi_fresh":0'*) : ;; *) echo "  FAIL: the wifi lease must track mesh-wifi-motion's GAP_LIMIT (tightened to 120s, a 300s verdict must expire) — a hardcoded lease is a second definition of stale (got: $out_gap)"; f=1 ;; esac
  # an explicit MESH_BRUNO_LEASE_WIFI still wins over the derived default (the node-local override
  # hook mesh-home's bruno.env uses today — the fix must not strand it).
  # (set INSIDE the hermetic env, not as a prefix — _leaserun_h's own `env -u` would strip it)
  rm -f "$_wl"
  out_ov="$(env -u MESH_BRUNO_TZ HOME="$_lh" MESH_BRUNO_LEASE_WIFI=99999 MESH_WIFI_MOTION_GAP_LIMIT=120 \
            MESH_BRUNO_WIFI_LEASE="$_wl" MESH_BRUNO_VOICELOG=/dev/null MESH_BRUNO_CAMLOG=/dev/null \
            MESH_BRUNO_STATE="$tmp/state_lease_h" MESH_BRUNO_ACT_OVERRIDE=STILL \
            MESH_BRUNO_ACT_AGE_OVERRIDE=300 MESH_BRUNO_HOUR_OVERRIDE=3 MESH_BRUNO_NOPOKE=1 \
            "$0" --json 2>/dev/null)"
  case "$out_ov" in *'"wifi_fresh":1'*) : ;; *) echo "  FAIL: an explicit MESH_BRUNO_LEASE_WIFI must override the derived default (got: $out_ov)"; f=1 ;; esac

  # --- THE INVARIANT: never assert a state no FRESH lease supports (2026-07-15) ---
  # The pane prints "state asserted only while a lease is FRESH; all expired -> UNKNOWN + wake", but
  # the fusion's wifi branches keyed on act_verdict ALONE with no age check — the label and cam
  # branches check theirs inline, wifi was the one unguarded axis. So an EXPIRED decisive verdict
  # still asserted RESTING while wifi_fresh=0 -> the reflex emitted the self-contradiction
  # "SENSE-FAILURE: all leases expired — senses blind" together with observe=RESTING (live: lease
  # age 1569s vs LEASE_WIFI=1500, fresh_observed=0, state=RESTING). Holding the last decisive verdict
  # (39decb9) turned that latent bug into the ROUTINE state after ~25min of inconclusive reads.
  printf 'STILL|%s\n' "$(( $(date +%s) - 99999 ))" > "$_wl"
  out_inv="$(MESH_BRUNO_WIFI_LEASE="$_wl" MESH_BRUNO_VOICELOG=/dev/null MESH_BRUNO_CAMLOG=/dev/null \
             MESH_BRUNO_STATE="$tmp/state_inv" MESH_BRUNO_ACT_OVERRIDE=UNCERTAIN MESH_BRUNO_ACT_AGE_OVERRIDE=-1 \
             MESH_BRUNO_HOUR_OVERRIDE=3 MESH_BRUNO_NOPOKE=1 "$0" --json 2>/dev/null)"
  case "$out_inv" in *'"wifi_fresh":0'*) : ;; *) echo "  FAIL: fixture must have an EXPIRED wifi lease (got: $out_inv)"; f=1 ;; esac
  case "$out_inv" in *'"state":"RESTING"'*) echo "  FAIL: an EXPIRED lease must NOT assert RESTING — 'all leases expired, senses blind' + observe=RESTING is the pane contradicting its own invariant (got: $out_inv)"; f=1 ;; esac
  case "$out_inv" in *'"state":"UNKNOWN"'*) : ;; *) echo "  FAIL: all leases expired must fuse to UNKNOWN (got: $out_inv)"; f=1 ;; esac
  # and the surprise must not claim blindness while asserting a state
  case "$out_inv" in *'"surprise":"SENSE-FAILURE"'*'"state":"RESTING"'*) echo "  FAIL: SENSE-FAILURE with an asserted state is self-contradictory (got: $out_inv)"; f=1 ;; esac
  # an EXPIRED held lease drove NOTHING — annotating "no live signal" with "[held lease]" describes a
  # lease that supported no claim. The marker exists to qualify an ASSERTION, not to narrate internals.
  case "$out_inv" in *'held lease'*) echo "  FAIL: an expired lease must not be annotated as a held lease — it drove nothing (got: $out_inv)"; f=1 ;; esac

  # --- a MATCH from an incapable proxy is not a confirmation either (2026-07-16) ---
  # 8853fd5 made a wifi-only MISMATCH "UNCORROBORATED, deliberately NOT CONFIRMED — that would assert
  # the prediction was validated (a lie)". But it only touched the mismatch branch: a wifi-only MATCH
  # still claimed CONFIRMED, from the SAME people-sensor that cannot see a cat. Asymmetric, and the
  # asymmetry favours false confidence — the proxy reads STILL whether Bruno rests or does zoomies,
  # so "observed RESTING consistent with predicted RESTING" agrees with the prior BY CONSTRUCTION at
  # every resting hour. A claim that cannot fail is not evidence (the tone-saturation family). Seen
  # live at h8: CONFIRMED, cam dark, label 24h stale, nothing that can see Bruno involved.
  out_cm="$(MESH_BRUNO_VOICELOG=/dev/null MESH_BRUNO_CAMLOG=/dev/null MESH_BRUNO_WIFI_LEASE="$tmp/lease_cm" \
            MESH_BRUNO_STATE="$tmp/state_cm" MESH_BRUNO_ACT_OVERRIDE=STILL MESH_BRUNO_ACT_AGE_OVERRIDE=60 \
            MESH_BRUNO_HOUR_OVERRIDE=8 MESH_BRUNO_NOPOKE=1 "$0" --json 2>/dev/null)"
  case "$out_cm" in *'"predicted":"RESTING"'*) : ;; *) echo "  FAIL: fixture needs an hour whose prior is RESTING (got: $out_cm)"; f=1 ;; esac
  case "$out_cm" in *'"state":"RESTING"'*) : ;; *) echo "  FAIL: fixture needs observed==predicted (got: $out_cm)"; f=1 ;; esac
  case "$out_cm" in *'"surprise":"CONFIRMED"'*) echo "  FAIL: a wifi-only MATCH must NOT be CONFIRMED — the proxy cannot see a cat, so it agrees with the prior by construction; asserting the prediction was validated is the same lie the mismatch branch already refuses (got: $out_cm)"; f=1 ;; esac
  case "$out_cm" in *'"surprise":"UNCORROBORATED"'*) : ;; *) echo "  FAIL: a proxy-only match must read UNCORROBORATED (got: $out_cm)"; f=1 ;; esac

  # CONFIRMED: hour 12 predicts SLEEPING; fresh SLEEPING label -> observed == predicted -> CONFIRMED.
  printf '%s  VOICE  Бруно спит на кровати\n' "$ts_now" > "$tmp/voice_conf.log"
  out_cf="$(MESH_BRUNO_VOICELOG="$tmp/voice_conf.log" MESH_BRUNO_CAMLOG=/dev/null \
            MESH_BRUNO_STATE="$tmp/state_cf" MESH_BRUNO_NOWIFI=1 MESH_BRUNO_HOUR_OVERRIDE=12 MESH_BRUNO_NOPOKE=1 "$0" --json 2>/dev/null)"
  case "$out_cf" in *'"surprise":"CONFIRMED"'*) : ;; *) echo "  FAIL: observed==predicted SLEEPING must be CONFIRMED (got: $out_cf)"; f=1 ;; esac

  # PRIOR-LEARNING: 3 SLEEPING labels at hour 17 (circadian says ACTIVE there) -> learned overrides.
  { echo "2026-07-10T17:05:00Z  VOICE  Бруно спит";
    echo "2026-07-11T17:20:00Z  VOICE  Бруно спит";
    echo "2026-07-12T17:45:00Z  VOICE  Бруно спит"; } > "$tmp/voice_learn.log"
  out_lp="$(MESH_BRUNO_VOICELOG="$tmp/voice_learn.log" MESH_BRUNO_CAMLOG=/dev/null \
            MESH_BRUNO_STATE="$tmp/state_lp" MESH_BRUNO_NOWIFI=1 MESH_BRUNO_TZ=UTC MESH_BRUNO_HOUR_OVERRIDE=17 MESH_BRUNO_NOPOKE=1 "$0" --json 2>/dev/null)"
  case "$out_lp" in *'"predicted":"SLEEPING"'*) : ;; *) echo "  FAIL: 3 SLEEPING labels @h17 must override circadian ACTIVE -> predicted SLEEPING (got: $out_lp)"; f=1 ;; esac
  case "$out_lp" in *'"predict_driver":"learned'*) : ;; *) echo "  FAIL: learned prior must mark driver 'learned' (got: $out_lp)"; f=1 ;; esac

  # PRIOR-LEARNING × TZ: the histogram must bin labels by the SAME local hour the query uses.
  # The original tally used `date -u -d @ep` — the -u OVERRIDES TZ, so labels binned by UTC hour
  # while lhour queried Moscow hour: every label landed 3h off and the calibration channel never
  # converged on any non-UTC node (caught live 2026-07-16: operator's 19:11-MSK EATING label counted
  # under h16). The UTC fixture above cannot see this — both paths agree there by construction.
  # 3 EATING labels stamped 16:xxZ = 19:xx Moscow; query h19 (circadian ACTIVE) must yield learned EATING.
  { echo "2026-07-10T16:05:00Z  VOICE  Бруно кушает";
    echo "2026-07-11T16:20:00Z  VOICE  Бруно кушает";
    echo "2026-07-12T16:45:00Z  VOICE  Бруно кушает"; } > "$tmp/voice_learn_tz.log"
  out_lz="$(MESH_BRUNO_VOICELOG="$tmp/voice_learn_tz.log" MESH_BRUNO_CAMLOG=/dev/null \
            MESH_BRUNO_STATE="$tmp/state_lz" MESH_BRUNO_NOWIFI=1 MESH_BRUNO_TZ=Europe/Moscow MESH_BRUNO_HOUR_OVERRIDE=19 MESH_BRUNO_NOPOKE=1 "$0" --json 2>/dev/null)"
  case "$out_lz" in *'"predicted":"EATING"'*) : ;; *) echo "  FAIL: labels at 16Z=19MSK must bin to local h19 → learned EATING (UTC-binning regression; got: $out_lz)"; f=1 ;; esac

  # --- THIN SIGNAL: an alive-but-thin axis is DEGRADED, never "senses blind" (2026-07-16) ---
  # mesh-wifi-motion emits thin_signal=QUIET|ACTIVE|NONE when anchors < MIN_STABLE — its own hint
  # "for a consumer that down-weights THIN coverage". bruno discarded it, so when the corpus fell to
  # 3 reliable anchors (the Keenetic neighbour AP faded 2026-07-16 ~05:00; decisive-capable windows
  # 100%→5% in a day) every lease starved and the reflex poked SENSE-FAILURE "senses blind" at an
  # axis that was alive and reading a quiet room every 10 minutes.
  # (a) thin QUIET fresh, all else cold → RESTING (room-proxy, uncorroborated), never SENSE-FAILURE
  out_tq="$(MESH_BRUNO_VOICELOG=/dev/null MESH_BRUNO_CAMLOG=/dev/null MESH_BRUNO_WIFI_LEASE="$tmp/lease_tq" \
            MESH_BRUNO_STATE="$tmp/state_tq" MESH_BRUNO_ACT_OVERRIDE=UNCERTAIN MESH_BRUNO_THIN_OVERRIDE=QUIET \
            MESH_BRUNO_THIN_AGE_OVERRIDE=60 MESH_BRUNO_HOUR_OVERRIDE=3 MESH_BRUNO_NOPOKE=1 "$0" --json 2>/dev/null)"
  case "$out_tq" in *'"state":"RESTING"'*) : ;; *) echo "  FAIL: fresh thin-QUIET must fuse to RESTING — same room-proxy claim as wifi-only STILL, 3 anchors instead of 4 (got: $out_tq)"; f=1 ;; esac
  case "$out_tq" in *'"surprise":"SENSE-FAILURE"'*) echo "  FAIL: a fresh thin read is an ALIVE axis — 'senses blind' is false while it reads (got: $out_tq)"; f=1 ;; esac
  case "$out_tq" in *'"surprise":"UNCORROBORATED"'*) : ;; *) echo "  FAIL: thin-QUIET RESTING vs predicted SLEEPING must be UNCORROBORATED — thinner than the proxy that already cannot see a cat (got: $out_tq)"; f=1 ;; esac
  case "$out_tq" in *'"thin_fresh":1'*) : ;; *) echo "  FAIL: fresh thin read must set thin_fresh=1 (got: $out_tq)"; f=1 ;; esac
  # (b) thin ACTIVE: uncorroborated motion asserts NO state (the producer refuses to promote it to
  # MOTION; so do we) — but the axis is alive, so not SENSE-FAILURE, and an unasserted observation
  # must never score the prior as CONFIRMED.
  out_ta="$(MESH_BRUNO_VOICELOG=/dev/null MESH_BRUNO_CAMLOG=/dev/null MESH_BRUNO_WIFI_LEASE="$tmp/lease_ta" \
            MESH_BRUNO_STATE="$tmp/state_ta" MESH_BRUNO_ACT_OVERRIDE=UNCERTAIN MESH_BRUNO_THIN_OVERRIDE=ACTIVE \
            MESH_BRUNO_THIN_AGE_OVERRIDE=60 MESH_BRUNO_HOUR_OVERRIDE=3 MESH_BRUNO_NOPOKE=1 "$0" --json 2>/dev/null)"
  case "$out_ta" in *'"state":"UNKNOWN"'*) : ;; *) echo "  FAIL: thin-ACTIVE must not assert a state — uncorroborated motion is not MOTION (got: $out_ta)"; f=1 ;; esac
  case "$out_ta" in *'"surprise":"SENSE-FAILURE"'*) echo "  FAIL: thin-ACTIVE is an alive axis, not blindness (got: $out_ta)"; f=1 ;; esac
  case "$out_ta" in *'"surprise":"CONFIRMED"'*) echo "  FAIL: observed UNKNOWN must never CONFIRM a prediction — a prior scored against no observation (got: $out_ta)"; f=1 ;; esac
  case "$out_ta" in *'"surprise":"UNCORROBORATED"'*) : ;; *) echo "  FAIL: thin-ACTIVE must read UNCORROBORATED (got: $out_ta)"; f=1 ;; esac
  # ...and the detail must say NOTHING was asserted — "observed UNKNOWN vs predicted X" narrates a
  # comparison with a non-observation (the dedicated state=UNKNOWN branch, not the room-proxy one).
  case "$out_ta" in *'none corroborates a state'*) : ;; *) echo "  FAIL: an unasserted observation must be reported as 'none corroborates a state', not compared against the prior (got: $out_ta)"; f=1 ;; esac
  # (c) thin NONE = nothing observed in the latest sweep — NOT an alive read; all-cold stays SENSE-FAILURE
  out_tn="$(MESH_BRUNO_VOICELOG=/dev/null MESH_BRUNO_CAMLOG=/dev/null MESH_BRUNO_WIFI_LEASE="$tmp/lease_tn" \
            MESH_BRUNO_STATE="$tmp/state_tn" MESH_BRUNO_ACT_OVERRIDE=UNCERTAIN MESH_BRUNO_THIN_OVERRIDE=NONE \
            MESH_BRUNO_THIN_AGE_OVERRIDE=60 MESH_BRUNO_HOUR_OVERRIDE=3 MESH_BRUNO_NOPOKE=1 "$0" --json 2>/dev/null)"
  case "$out_tn" in *'"surprise":"SENSE-FAILURE"'*) : ;; *) echo "  FAIL: thin_signal=NONE reads nothing — it must NOT count as an alive axis (got: $out_tn)"; f=1 ;; esac
  # (d) a thin read older than LEASE_WIFI is expired — a dead feeder must still surface as SENSE-FAILURE
  out_te="$(MESH_BRUNO_VOICELOG=/dev/null MESH_BRUNO_CAMLOG=/dev/null MESH_BRUNO_WIFI_LEASE="$tmp/lease_te" \
            MESH_BRUNO_STATE="$tmp/state_te" MESH_BRUNO_ACT_OVERRIDE=UNCERTAIN MESH_BRUNO_THIN_OVERRIDE=QUIET \
            MESH_BRUNO_THIN_AGE_OVERRIDE=99999 MESH_BRUNO_HOUR_OVERRIDE=3 MESH_BRUNO_NOPOKE=1 "$0" --json 2>/dev/null)"
  case "$out_te" in *'"surprise":"SENSE-FAILURE"'*) : ;; *) echo "  FAIL: an EXPIRED thin read must not keep the axis alive — the thin path must not make blindness unreachable (got: $out_te)"; f=1 ;; esac
  # (e) explicit cam NOT-IN-FRAME downgrades thin-QUIET exactly as it downgrades decisive STILL —
  # absence corroborates against presence on the thin path too, or the two branches drift.
  out_tf="$(MESH_BRUNO_VOICELOG="$tmp/no_voice.log" MESH_BRUNO_CAMLOG="$tmp/cam2.log" MESH_BRUNO_WIFI_LEASE="$tmp/lease_tf" \
            MESH_BRUNO_STATE="$tmp/state_tf" MESH_BRUNO_ACT_OVERRIDE=UNCERTAIN MESH_BRUNO_THIN_OVERRIDE=QUIET \
            MESH_BRUNO_THIN_AGE_OVERRIDE=60 MESH_BRUNO_NOPOKE=1 "$0" --json 2>/dev/null)"
  case "$out_tf" in *'"state":"RESTING"'*) echo "  FAIL: thin-QUIET with cam explicitly NOT-IN-FRAME must NOT assert RESTING (absence corroborates — parity with the decisive STILL branch) (got: $out_tf)"; f=1 ;; esac

  # --- the --test must never touch the LIVE wifi lease (2026-07-16) ---
  # Five ACT_OVERRIDE=STILL fixtures sandboxed neither NOWIFI nor MESH_BRUNO_WIFI_LEASE, so each
  # wrote a decisive fresh-STILL into the node's real .bruno-wifi-lease — and mesh-doctor runs every
  # --test hourly at :23, so the live lease was FORGED on the hour (observed: lease stamp 14:22:20 =
  # doctor's 14:23:20 pass minus AGE_OVERRIDE=60; a real decisive read always stamps a sweep
  # timestamp). bruno then held "wifi STILL" fresh for ~25min past every doctor pass while the real
  # axis was thin-blind — the reflex's own evidence, forged by its own test (guardian/09f7914 family).
  [ -f "$MESH/.bruno-wifi-lease" ] && [ "$(stat -c %Y "$MESH/.bruno-wifi-lease" 2>/dev/null || echo 0)" -ge "$_t0" ] && { echo "  FAIL: --test wrote the LIVE .bruno-wifi-lease — a fixture is forging the decisive-verdict evidence the reflex runs on"; f=1; }

  rm -rf "$tmp"
  [ "$f" = 0 ] && { echo "smoke-test: ok (label gate + EATING-regression + cam real-read + seen-axis stale-lockin fix + STILL-branch NOT-IN-FRAME downgrade + no-vision-STILL preserved + transition-paren RESTING fix + English resting vocab + predict/surprise: SENSE-FAILURE + DIVERGENCE + UNCORROBORATED + CONFIRMED + prior-LEARNING + poke-gate since/transport + thin-signal degraded-not-blind + cam-alive-not-blind(NOT-IN-FRAME) + live-lease hygiene)"; exit 0; } || { echo "smoke-test: FAIL"; exit 1; }
fi

now=$(date +%s)
iso_to_epoch(){ date -u -d "$1" +%s 2>/dev/null || echo 0; }
age_fmt(){ local s=$1; if [ "$s" -lt 0 ]; then echo "?"; elif [ "$s" -lt 90 ]; then echo "${s}s"; \
  elif [ "$s" -lt 5400 ]; then echo "$((s/60))m"; elif [ "$s" -lt 172800 ]; then echo "$((s/3600))h"; \
  else echo "$((s/86400))d"; fi; }

# ── PREDICTIVE LAYER (operator 2026-07-15) ─────────────────────────────────────────
# The bruno channel is a predictive-coding loop, NOT a reactive dump. The top pane carries a PRIOR
# (what we EXPECT Bruno to do at this local hour), the OBSERVED fused state, and a SURPRISE signal
# (prediction error). Reflexes sense the reality stream and wake the mind ONLY on surprise
# (divergence | sense-failure); a CONFIRMED prediction lets it sleep. Goal: predict Bruno 24/7.
# Calibration: the operator reads the pane; if PREDICT/OBSERVE ≠ what Bruno is actually doing, they
# send a label ("Бруно спит/ест/активен") — that both corrects the now-read AND feeds the learned
# prior for that hour (the histogram below). Over time the prediction self-calibrates.
#
# LIVENESS-AS-LEASE: a state is asserted only while at least one sense's LEASE is FRESH. Each sense
# has a max acceptable age; all expired → state UNKNOWN + a SENSE-FAILURE surprise (wake to fix the
# senses, not to narrate). This is the invariant the reflex guards.
BRUNO_TZ="${MESH_BRUNO_TZ:-UTC}"
LEASE_CAM="${MESH_BRUNO_LEASE_CAM:-1800}"    # a sighting stays valid 30m
# A LEASE MUST EXCEED ITS PRODUCER'S CADENCE, or it is unsatisfiable by construction. The old default
# 600 EQUALLED mesh-wifiscan's declared cadence (`6-59/10` = one sweep per 600s): the newest tape line
# ages 0→600s across every cycle, so the lease expired at the END OF EVERY CYCLE, forever, however
# healthy the feeder was — and bruno samples on its own */5 cron while the dash RE-AGES the cached
# verdict against wall-clock, so a legitimate age reaches cadence(600)+sampling(300)=~900s with every
# sweep landing on time. Observed 2026-07-15 14:46: tape lines at :36:01 and :46:01 exactly on cadence,
# LEASES still read `wifi EXPIRED(10m)` → a false SENSE-FAILURE poke against a provably-healthy feeder.
# The default is NOT a padded guess and NOT a second constant: it defers to mesh-wifi-motion's OWN
# GAP_LIMIT — the same var, the same default — i.e. the gap beyond which the PRODUCER itself calls its
# tape discontinuous. "Lease valid" and "tape continuous" are ONE definition of stale, so retuning the
# producer moves the lease with it and the two can never drift apart. A genuinely dead feeder still
# expires it honestly: no sweep → tape frozen → age climbs past the limit → SENSE-FAILURE fires for real.
LEASE_WIFI="${MESH_BRUNO_LEASE_WIFI:-${MESH_WIFI_MOTION_GAP_LIMIT:-1500}}"
LEASE_LABEL="${MESH_BRUNO_LEASE_LABEL:-2700}" # an operator label holds 45m (matches the fusion gate)
LEARN_MIN="${MESH_BRUNO_LEARN_MIN:-3}"       # min labels/hour before the prior is "learned" not "circadian"
# ONE candidate-token list shared by EVERY label grep (fusion filter + learned-prior filter).
# Duplication drifts: a 3rd copy missing English resting vocab silently dropped a fresh operator
# label ("Bruno laying, chilling") → hollow calibration. English: sleep/eat/active/play/rest/chill/lay/lying/lounge.
LABEL_TOKENS='спит|сон|засыпа|sleep|проснул|awake|кушает|поел|жр[ёе]т|покорм|у миски|корм|eat|актив|игра|бегает|active|play|лежит|л[ёе]г|отдых|rest|chill|lay|lying|lounge'
# Overridable so --test drives its OWN poke-gate artifacts. A dry-run that writes the REAL
# bruno-surprise.state / .bruno-lastpoke forges the evidence the gate exists to check: it would plant
# a fake `prev` (making the next live transition read as unchanged → no poke) and stamp lastpoke
# (suppressing a real poke for 25m). mesh-doctor runs every tool's --test hourly, so that corruption
# would be continuous. Same precedent as mesh-guardian's MESH_GUARDIAN_LOG (09f7914).
SURP_STATE_FILE="${MESH_BRUNO_SURP_STATE:-$MESH/bruno-surprise.state}" # current surprise kind — transition-gates the poke
# The poke TRANSPORT must be injectable, not stubbed via PATH: this script does
# `export PATH="$HOME/.local/bin:$PATH"` at line 27, so a test that prepends its own bin is
# OVERRIDDEN by the real mesh-tell and the dry-run fires a REAL poke into the operator's bruno
# window. Observed exactly that 2026-07-15: the --test's HOUR_OVERRIDE=3 fixture surfaced as a live
# "[bruno-reflex: SENSE-FAILURE] ... predict=SLEEPING (@h3, circadian deep-night)" at 19:00 Moscow —
# the test forging the very evidence it exists to check. (Same shape as the forced-PATH-defeats-venv
# -prepends trap.) --test sets MESH_BRUNO_TELL=/bin/true; nothing else may.
TELL="${MESH_BRUNO_TELL:-mesh-tell}"
POKE_COOLDOWN="${MESH_BRUNO_POKE_COOLDOWN:-1500}"  # 25m min between pokes
POKE_REMIND="${MESH_BRUNO_POKE_REMIND:-7200}"      # re-remind a stuck wake-kind every 2h
# A wake kind must HOLD this long before it costs a paid mind. 900s = 3 evals at bruno's */5 cadence:
# long enough to ride out the 1-2-eval SENSE-FAILURE dips this node's marginal wifi corpus produces
# between decisive verdicts, short enough that a real blindness still surfaces inside 15min.
POKE_DEBOUNCE="${MESH_BRUNO_POKE_DEBOUNCE:-900}"
LASTPOKE="${MESH_BRUNO_LASTPOKE:-$MESH/.bruno-lastpoke}"          # global last-poke (cross-kind cooldown floor)
POKE_LEDGER="${MESH_BRUNO_POKE_LEDGER:-$MESH/.bruno-pokeledger}"  # per-kind last-poke (drives the per-kind remind)

# local hour for the circadian prior. HOUR_OVERRIDE is a test hook (deterministic prior); the TZ is
# surfaced on the pane so the operator can correct it (set MESH_BRUNO_TZ).
lhour="${MESH_BRUNO_HOUR_OVERRIDE:-$(TZ="$BRUNO_TZ" date +%H 2>/dev/null | sed 's/^0//')}"; lhour="${lhour:-0}"

circadian_prior(){  # $1 local hour 0..23 -> echoes STATE|conf|driver (cats are crepuscular)
  case "$1" in
    0|1|2|3|4)      echo "SLEEPING|0.70|circadian deep-night" ;;
    5|6)            echo "ACTIVE|0.55|circadian dawn-burst" ;;
    7|8|9)          echo "RESTING|0.50|circadian post-dawn" ;;
    10|11|12|13|14) echo "SLEEPING|0.65|circadian midday-nap" ;;
    15|16)          echo "RESTING|0.50|circadian afternoon" ;;
    17|18|19)       echo "ACTIVE|0.55|circadian dusk-burst" ;;
    20|21)          echo "EATING|0.45|circadian dinner-window" ;;
    22|23)          echo "RESTING|0.50|circadian pre-sleep" ;;
    *)              echo "RESTING|0.40|circadian fallback" ;;
  esac
}

classify_label(){  # $1 = line with parens stripped -> echoes a STATE or "" (shared by fusion + prior)
  # NB: catch tokens must SURVIVE paren-stripping — don't rely on a parenthetical hint (the
  # operator's "Bruno laying, chilling by the window (resting)" had its only catch token inside
  # parens and was silently dropped → fresh label classified as nothing → hollow calibration).
  case "$1" in
    *спит*|*сон*|*засыпа*|*[Ss]leep*|*проснул*|*awake*)              echo "SLEEPING" ;;
    *кушает*|*поел*|*жр[ёе]т*|*покорм*|*"у миски"*|*корм*|*[Ee]at*)  echo "EATING" ;;
    *лежит*|*л[ёе]г*|*отдых*|*[Rr]est*|*[Ll]aying*|*[Ll]ying*|*[Cc]hill*|*[Ll]ounge*)  echo "RESTING" ;;
    *актив*|*игра*|*[Aa]ctive*|*play*|*бегает*)                      echo "ACTIVE" ;;
  esac
}

# LEARNED prior: tally the operator's own labels per LOCAL hour; if the current hour has ≥ LEARN_MIN
# samples, the mode overrides the circadian default. Derived live from voice-in.log (cheap, local) —
# this IS the calibration channel: each label reshapes the prior for that hour going forward.
learned_prior(){  # $1 = local hour -> echoes STATE|n|driver, or "" if too few samples
  [ -s "$VOICELOG" ] || return 0
  local ln ts ep lh m s best="" bestn=0 tot=0
  declare -A cnt
  while IFS= read -r ln; do
    [ -n "$ln" ] || continue
    ts=$(printf '%s\n' "$ln" | grep -oE '^[0-9-]+T[0-9:]+Z'); [ -n "$ts" ] || continue
    ep=$(iso_to_epoch "$ts"); [ "${ep:-0}" -gt 0 ] || continue
    # NO -u here: -u overrides TZ and bins the histogram by UTC hour while lhour queries the
    # node's BRUNO_TZ hour — every label lands offset-hours off and the learned prior never fires.
    lh=$(TZ="$BRUNO_TZ" date -d "@$ep" +%H 2>/dev/null | sed 's/^0//'); lh="${lh:-0}"
    [ "$lh" = "$1" ] || continue
    m=$(printf '%s\n' "$ln" | sed -E 's/\([^)]*\)//g'); s=$(classify_label "$m")
    [ -n "$s" ] || continue
    cnt[$s]=$(( ${cnt[$s]:-0} + 1 ))
  done < <(awk 'NF>=3 && NF<=30 && $3 ~ /^Бруно|^бруно|^[Bb]runo/' "$VOICELOG" \
            | grep -iE "$LABEL_TOKENS")
  for s in "${!cnt[@]}"; do tot=$((tot+${cnt[$s]})); [ "${cnt[$s]}" -gt "$bestn" ] && { bestn=${cnt[$s]}; best=$s; }; done
  [ "${tot:-0}" -ge "$LEARN_MIN" ] && [ -n "$best" ] && echo "$best|$tot|learned@hour$1" || true
}

# THE single wake rule. Both the poke gate and the pane render ask this — never a second copy of the
# literal: the renderer used to hardcode `surprise = CONFIRMED ? sleeps : wake`, so every new
# non-CONFIRMED kind (UNCORROBORATED) announced "→ wake mind" on the pane while maybe_poke stayed
# silent. The pane is what a mind reads to decide whether to act; a render that disagrees with the
# gate is a lie about the reflex's own behaviour. (Same duplication-drifts lesson as the label vocab.)
is_wake(){ case "$1" in SENSE-FAILURE|DIVERGENCE) return 0;; *) return 1;; esac; }

lease_fmt(){ local age=$1 lim=$2;  # -> "Xm left" | "EXPIRED(Ym)" | "none"
  if [ "${age:--1}" -lt 0 ]; then echo "none";
  elif [ "$age" -ge "$lim" ]; then echo "EXPIRED($(age_fmt "$age"))";
  else echo "$(age_fmt $((lim-age))) left"; fi; }

# poke the mind ONLY on a surprise transition (or a long re-remind), never on a confirmed prediction.
# mirrors mesh-sound-reflex's poke(): a cooldown + transition-gate so a persistent condition (cam
# offline) pokes once, not every tick. Human/default invocation only — never under --json/--test.
maybe_poke(){
  [ "${1:-}" = "--json" ] && return 0
  [ "${MESH_BRUNO_NOPOKE:-0}" = 1 ] && return 0
  command -v "$TELL" >/dev/null 2>&1 || return 0
  local prev="" since=0 now2 do_poke=0 wake=0 held=0 klast=0
  IFS='|' read -r prev since < "$SURP_STATE_FILE" 2>/dev/null || true
  since=${since:-0}; now2=$(date +%s)
  # a kind CHANGE starts a fresh episode: its own debounce clock (see below)
  [ "$prev" != "$surprise" ] && since=$now2
  # `since` = when THIS kind's current episode began. It re-stamps ONLY on a kind change, never on a
  # plain eval — the original bug wrote it every eval so now-since tracked the */5 cadence (~300s) and
  # nothing time-based could ever fire.
  printf '%s|%s\n' "$surprise" "$since" > "$SURP_STATE_FILE" 2>/dev/null || true
  is_wake "$surprise" && wake=1
  held=$(( now2 - since ))
  # SAME-KIND DEBOUNCE: a wake kind must PERSIST past POKE_DEBOUNCE before it costs a paid mind — a
  # single-eval dip that self-heals (mesh-home's marginal corpus flickers UNCERTAIN for 5-10min) is
  # not worth a wake. Safe only because the remind below works (c2d6d39).
  if [ "$wake" = 1 ] && [ "$held" -ge "$POKE_DEBOUNCE" ]; then
    # PER-KIND REMIND, not per-episode. A CHRONIC condition oscillates in and out of the wake state
    # (post-TV-off: wifi UNCERTAIN 40min → recover → re-degrade), so it churns through many separate
    # sustained episodes. Keying the remind to the EPISODE re-poked every cycle and woke a mind
    # ~hourly for the SAME unactionable state. The ledger records the last poke PER KIND and survives
    # episode churn, so a kind pokes at most once per POKE_REMIND however many episodes it flaps
    # through. klast=0 (never poked) → now-0 >> REMIND → the first sustained episode still pokes.
    # A DIFFERENT kind has its own (empty) ledger entry, so a real DIVERGENCE is never suppressed by a
    # recent SENSE-FAILURE.
    klast=$(awk -v k="$surprise" '$1==k{v=$2} END{print v+0}' "$POKE_LEDGER" 2>/dev/null); klast=${klast:-0}
    [ "$((now2-klast))" -ge "$POKE_REMIND" ] && do_poke=1
  fi
  [ "$do_poke" = 1 ] || return 0
  # cross-kind cooldown FLOOR: never fire two kinds in the same breath (a single eval can only be one
  # kind, but a rapid kind flip should not double-poke). Distinct from the per-kind remind above.
  local lp_ts; lp_ts=$(cat "$LASTPOKE" 2>/dev/null | tr -dc 0-9); [ -z "$lp_ts" ] && lp_ts=0
  [ "$((now2-lp_ts))" -lt "$POKE_COOLDOWN" ] && return 0
  # record the poke: per-kind ledger (drives remind) + global lastpoke (drives cooldown). The ledger
  # is rewritten with this kind's line updated, all others preserved.
  { grep -v "^$surprise " "$POKE_LEDGER" 2>/dev/null; printf '%s %s\n' "$surprise" "$now2"; } > "$POKE_LEDGER.tmp" 2>/dev/null \
    && mv "$POKE_LEDGER.tmp" "$POKE_LEDGER" 2>/dev/null || true
  echo "$now2" > "$LASTPOKE" 2>/dev/null || true
  "$TELL" bruno "[bruno-reflex: $surprise] $surp_detail. predict=$pred_state (@h$lhour $BRUNO_TZ, $pred_driver) observe=$state. Fix senses or recalibrate prior." >/dev/null 2>&1 || true
}

# --- 1. VISION axis: last cat-visible sighting from the cam log ---------------------
# tsv rows are "<iso>\t<description...>" possibly wrapping onto the next physical line;
# we scan for the newest row whose text says the cat IS visible (and not "no cat").
seen_state="UNKNOWN"; seen_age=-1; seen_desc=""
if [ -s "$CAMLOG" ]; then
  # newest timestamped row overall (freshness of the cam itself)
  last_cam_ts=$(grep -oE '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:]+Z' "$CAMLOG" | tail -1)
  # chat-review/bruno-seen-axis-stale-lockin: the NEWEST row-block (from the last timestamp
  # line to EOF — the description sometimes wraps its "No cat visible" onto the following
  # physical line, so a single-line check on the ts row alone misses it) is checked FIRST. If
  # it reads negative, that overrides ANY older affirming row further back in the log — an old
  # SEEN must not outlive several fresh negative reads (live bug: seen=SEEN at 9h stale against
  # 6+ consecutive fresh "No cat visible" rows). The unbounded affirm-scan below only runs when
  # the newest block is NOT itself a negative read.
  last_ts_lineno=$(grep -nE '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:]+Z' "$CAMLOG" | tail -1 | cut -d: -f1)
  newest_block=""
  [ -n "$last_ts_lineno" ] && newest_block="$(tail -n +"$last_ts_lineno" "$CAMLOG" 2>/dev/null)"
  if [ -n "$newest_block" ] && printf '%s\n' "$newest_block" | grep -qiE 'no cat|not visible|no.*visible|classification failed'; then
    seen_age=$(( now - $(iso_to_epoch "$last_cam_ts") ))
    seen_state="NOT-IN-FRAME"
  else
    # newest row that AFFIRMS a cat (visible/on the bed/…) and is not a "no cat"/failed line
    vis_line=$(grep -iE '^[0-9]{4}-.*(cat|кот|bruno|бруно)' "$CAMLOG" \
               | grep -ivE 'no cat|not visible|no.*visible|classification failed' | tail -1)
    if [ -n "$vis_line" ]; then
      vts=$(echo "$vis_line" | grep -oE '^[0-9-]+T[0-9:]+Z')
      seen_age=$(( now - $(iso_to_epoch "$vts") ))
      seen_desc=$(echo "$vis_line" | sed -E 's/^[0-9T:Z-]+\t?//' | cut -c1-70)
      seen_state="SEEN"
    elif [ -n "$last_cam_ts" ]; then
      # cam is live but reports no cat -> honest "not in frame", with the cam's own freshness
      seen_age=$(( now - $(iso_to_epoch "$last_cam_ts") ))
      seen_state="NOT-IN-FRAME"
    fi
  fi
fi

# --- scene-hold: a SEEING camera over an UNCHANGED scene keeps the last read current ---------
# The feeder is motion-gated: no motion → no new CATLOG row → the row's age measures the last
# CHANGE, not the evidence. A healthy, SEEING, motionless camera could therefore never hold the
# 30m cam lease (live 2026-07-16: "cam EXPIRED(51m) [fresh=0]" while the daemon captured every 8s,
# state SEEING) — an unsatisfiable-by-a-healthy-feeder lease, the same class as the wifi thin-lease
# starve. While (a) the daemon's state file says SEEING and its mtime is fresh (re-touched every
# cycle ≤120s — a dead daemon stops touching and ages out honestly), and (b) no diff-threshold
# crossing happened AFTER the row was written (CAMMOTION is stamped on EVERY crossing, including
# classify-cooldown-suppressed ones; absent file = feeder predates the stamp → NO hold, conservative),
# the scene is provably unchanged and the row's claim — SEEN or NOT-IN-FRAME alike — is the CURRENT
# observation: its effective age is the state file's mtime age. DARK/COVERED never hold: a blind eye
# cannot refute a cat entering. The trigger's sensitivity bounds the claim exactly as it bounds a
# fresh row — no weaker.
seen_held=0
if [ "${seen_age:--1}" -ge 0 ] && [ -f "$CAMSTATE" ] && [ "$(cat "$CAMSTATE" 2>/dev/null)" = "SEEING" ] && [ -f "$CAMMOTION" ]; then
  _cs_age=$(( now - $(stat -c %Y "$CAMSTATE" 2>/dev/null || echo 0) ))
  _row_epoch=$(( now - seen_age ))
  _lm="$(cat "$CAMMOTION" 2>/dev/null || echo 0)"; [[ "$_lm" =~ ^[0-9]+$ ]] || _lm=0
  if [ "$_cs_age" -ge 0 ] && [ "$_cs_age" -lt "$CAM_HOLD_MAX" ] && [ "$_lm" -le "$_row_epoch" ] && [ "$_cs_age" -lt "$seen_age" ]; then
    seen_age=$_cs_age; seen_held=1
  fi
fi

# --- 2. ACTIVITY axis: wifi-motion device-free RSSI ---------------------------------
# thin_sig/thin_age: the producer's OWN degraded-coverage hint (thin_signal=QUIET|ACTIVE|NONE when
# anchors < MIN_STABLE — emitted, per its header, "so a consumer that already down-weights THIN
# coverage isn't discarding real information"). bruno WAS that discarding consumer: when the corpus
# fell to 3 reliable anchors (Keenetic neighbour AP faded 2026-07-16 ~05:00, decisive-capable windows
# 100%→5% in a day) every window read UNCERTAIN, the decisive lease starved, and the reflex poked
# "senses blind" hourly at an axis alive and reading QUIET every 10 minutes. QUIET/ACTIVE is a real
# read of the anchors that DO persist; NONE means nothing was observable — only the former keeps the
# axis alive below.
act_verdict="UNKNOWN"; act_age=-1; act_held=0   # act_held=1 → verdict is a HELD lease, not a fresh read
thin_sig=""; thin_age=-1; thin_n=0
if [ -n "${MESH_BRUNO_ACT_OVERRIDE:-}" ]; then
  # test-only hook (chat-review/bruno-seen-axis-stale-lockin): inject a verdict hermetically,
  # no live mesh-wifi-motion call, so the STILL-branch fusion logic is testable without a real tape.
  # ACT_AGE_OVERRIDE injects the verdict's AGE too — without it act_age stays -1 and wifi_fresh can
  # never be 1, so the wifi-only lease path was untestable. THIN_OVERRIDE/THIN_AGE_OVERRIDE mirror
  # the same hermetic hook for the thin path.
  act_verdict="$MESH_BRUNO_ACT_OVERRIDE"
  act_age="${MESH_BRUNO_ACT_AGE_OVERRIDE:--1}"
  thin_sig="${MESH_BRUNO_THIN_OVERRIDE:-}"
  thin_age="${MESH_BRUNO_THIN_AGE_OVERRIDE:--1}"
  thin_n="${MESH_BRUNO_THIN_N_OVERRIDE:-3}"
elif [ -z "$NOWIFI" ] && command -v mesh-wifi-motion >/dev/null 2>&1; then
  wj=$(timeout 15 mesh-wifi-motion --json 2>/dev/null)
  if [ -n "$wj" ]; then
    act_verdict=$(echo "$wj" | grep -oE '"verdict":"[A-Z]+"' | cut -d'"' -f4)
    am=$(echo "$wj" | grep -oE '"age_s":[0-9]+' | cut -d: -f2)
    [ -n "$am" ] && act_age=$am
    [ -z "$act_verdict" ] && act_verdict="UNKNOWN"
    thin_sig=$(echo "$wj" | grep -oE '"thin_signal":"[A-Z]+"' | cut -d'"' -f4)
    thin_n=$(echo "$wj" | grep -oE '"thin_observed":[0-9]+' | cut -d: -f2); thin_n=${thin_n:-0}
    # the thin read's freshness is the tape's own age — captured HERE, before the held-lease
    # fallback below overwrites act_age with the old decisive verdict's age.
    [ -n "$thin_sig" ] && thin_age=$act_age
  fi
fi

# A LEASE DECAYS ON TIME, NOT ON NO-INFORMATION. wifi_fresh needs a DECISIVE verdict, so an
# UNCERTAIN window used to drop the lease INSTANTLY however fresh the tape was → fresh_obs=0 →
# SENSE-FAILURE "senses blind, cannot observe Bruno". But UNCERTAIN does not mean blind: it means the
# axis is ALIVE and this window was inconclusive (on mesh-home's 5-AP corpus, sitting right on
# wifi-motion's MIN_STABLE=4, that happens every few sweeps — reason=uncorroborated_outlier). An
# inconclusive read carries no information and cannot refute the STILL observed a minute ago, so the
# last DECISIVE verdict keeps decaying on its own clock instead of being killed. Only a decisive read
# re-stamps it — an inconclusive one must never refresh the timestamp, or the lease becomes immortal
# and a genuinely dead axis would never surface. A held verdict still ages past LEASE_WIFI into an
# honest SENSE-FAILURE.
WIFI_LEASE_F="${MESH_BRUNO_WIFI_LEASE:-$MESH/.bruno-wifi-lease}"
# NOWIFI means "this run has NO wifi axis" — it must disable the lease too, or the fallback reaches
# the LIVE .bruno-wifi-lease and a hermetic fixture silently inherits the real radio's last verdict.
# Caught by the poke-gate test: its all-cold fixture stopped producing SENSE-FAILURE once a live
# STILL lease existed on disk. A test that reads a live artifact is not a test of the fixture.
[ -n "$NOWIFI" ] && WIFI_LEASE_F=""
case "${WIFI_LEASE_F:+$act_verdict}" in
  MOTION|STILL)
    [ "${act_age:--1}" -ge 0 ] && printf '%s|%s\n' "$act_verdict" "$(( now - act_age ))" > "$WIFI_LEASE_F" 2>/dev/null || true
    ;;
  *)
    _lv=""; _lt=0
    # 2> BEFORE <: redirections apply left-to-right, so `< file 2>/dev/null` prints the open error
    # before stderr is silenced — leaked "No such file" onto the pane when no lease exists yet.
    IFS='|' read -r _lv _lt 2>/dev/null < "$WIFI_LEASE_F" || true
    if [ -n "${_lv:-}" ] && [ "${_lt:-0}" -gt 0 ]; then
      act_verdict="$_lv"; act_age=$(( now - _lt ))
      act_held=1
    fi
    ;;
esac

# --- 3. GROUND-TRUTH axis: operator's own TG labels ---------------------------------
# A real ground-truth label is a SHORT, deliberate line ("Бруно спит" / "ест" / "активен"),
# NOT a rambling design paragraph that merely happens to mention the cat. Gate #1: line length
# < 80 chars. This is what killed the first cut — the operator's long windows-design message
# said "обруно"/"бруны" AND contained "то есть" ×N, so a bare `ест` substring falsely read
# EATING. Gate #2: eating tokens must be cat-eating words, never a substring of "то есть"/"есть".
lbl_state=""; lbl_age=-1; lbl_raw=""
if [ -s "$VOICELOG" ]; then
  # Gate: a deliberate label BEGINS with "Бруно"/"bruno" (field 3 after the ts+type prefix),
  # so an incidental mid-paragraph mention ("...про обруно...") is rejected; a word-count
  # ceiling (NF<=30) still bars a rambling paragraph that happens to open with the name.
  # Byte-LENGTH is deliberately NOT a gate — Cyrillic is 2 bytes/char, so `length<80` silently
  # dropped real operator labels that merely carried the operator's parenthetical context
  # (fresh unambiguous "Бруно спит на диване (…)" → no-label-logged; a hollow ground-truth axis).
  lline=$(awk 'NF>=3 && NF<=30 && $3 ~ /^Бруно|^бруно|^[Bb]runo/' "$VOICELOG" \
          | grep -iE "$LABEL_TOKENS" \
          | tail -1)
  if [ -n "$lline" ]; then
    lts=$(echo "$lline" | grep -oE '^[0-9-]+T[0-9:]+Z')
    [ -n "$lts" ] && lbl_age=$(( now - $(iso_to_epoch "$lts") ))
    lbl_raw=$(echo "$lline" | sed -E 's/^[0-9T:Z-]+ +(VOICE|TEXT) +//' | cut -c1-60)
    # Strip parenthetical transition/context notes before token-matching: a label like
    # "сейчас лежит ... (переход: спал→активен→лежит)" must classify on the CURRENT assertion
    # ("лежит" = RESTING), not the historical "активен" buried in the parenthetical.
    lmatch=$(echo "$lline" | sed -E 's/\([^)]*\)//g')
    lbl_state=$(classify_label "$lmatch")
  fi
fi

# --- LEASES: computed BEFORE the fusion, because the fusion must OBEY them --------------
# THE INVARIANT (printed on the pane): "state asserted only while a lease is FRESH; all expired ->
# UNKNOWN + wake". It used to be enforced three times over: the label branch inline (<2700), the cam
# branch inline (<1800) — both hardcoded duplicates of LEASE_LABEL/LEASE_CAM — and the wifi branches
# NOT AT ALL. So an EXPIRED decisive wifi verdict still asserted RESTING while wifi_fresh=0, and the
# reflex emitted "SENSE-FAILURE: all leases expired — senses blind" together with observe=RESTING
# (live: lease age 1569s vs LEASE_WIFI 1500). Holding the last decisive verdict (39decb9) made that
# latent contradiction routine. One lease definition now, computed once, obeyed by both the fusion
# and the surprise — a rule enforced in three places is a rule with three chances to drift.
cam_fresh=0;  { [ "$seen_state" = "SEEN" ] && [ "${seen_age:--1}" -ge 0 ] && [ "$seen_age" -lt "$LEASE_CAM" ]; } && cam_fresh=1
# cam LIVENESS (blind-vs-alive) is broader than cam_fresh (SEEN-only, which drives the FUSION): a
# fresh NOT-IN-FRAME row is a working camera reporting the bed is EMPTY — a real negative observation,
# not blindness. It must NOT set cam_fresh (an empty bed cannot assert Bruno's state), but it MUST
# keep fresh_obs>0 so an unobservable-but-not-blind moment reads UNCORROBORATED, never SENSE-FAILURE
# "senses blind". Mirrors the thin-signal lease that keeps wifi's axis alive-but-uncorroborating.
# When the iMac sleeps the cam log goes stale → seen_age exceeds LEASE_CAM → cam_alive=0 → genuine
# blindness still surfaces as SENSE-FAILURE.
cam_alive=$cam_fresh; { [ "$seen_state" = "NOT-IN-FRAME" ] && [ "${seen_age:--1}" -ge 0 ] && [ "$seen_age" -lt "$LEASE_CAM" ]; } && cam_alive=1
wifi_fresh=0; { [ "$act_verdict" = "MOTION" ] || [ "$act_verdict" = "STILL" ]; } && [ "${act_age:--1}" -ge 0 ] && [ "$act_age" -lt "$LEASE_WIFI" ] && wifi_fresh=1
lbl_fresh=0;  [ -n "${lbl_state:-}" ] && [ "${lbl_age:--1}" -ge 0 ] && [ "$lbl_age" -lt "$LEASE_LABEL" ] && lbl_fresh=1
# thin lease: same clock as the decisive one (the tape's own age vs LEASE_WIFI). QUIET|ACTIVE only —
# NONE observed nothing, so it keeps nothing alive; a stale tape expires it and SENSE-FAILURE still
# fires for a genuinely dead feeder.
thin_fresh=0; { [ "$thin_sig" = "QUIET" ] || [ "$thin_sig" = "ACTIVE" ]; } && [ "${thin_age:--1}" -ge 0 ] && [ "$thin_age" -lt "$LEASE_WIFI" ] && thin_fresh=1

# --- FUSE -> one coarse STATE + the signal that drove it ----------------------------
# Priority: a FRESH operator label is authoritative ground truth; else derive from
# vision+activity; else UNKNOWN. We never assert a state no FRESH signal supports.
state="UNKNOWN"; driver="no live signal"
if [ "$lbl_fresh" = 1 ]; then
  state="$lbl_state"; driver="operator label ${lbl_age}s ago"
elif [ "$cam_fresh" = 1 ]; then
  # seen recently: motion axis splits active vs resting
  case "$act_verdict" in
    MOTION) state="ACTIVE";  driver="cam-seen + wifi MOTION" ;;
    STILL)  state="RESTING"; driver="cam-seen + wifi STILL" ;;
    *)      state="PRESENT"; driver="cam-seen ${seen_age}s ago" ;;
  esac
elif [ "$wifi_fresh" = 1 ] && [ "$act_verdict" = "MOTION" ]; then
  state="ACTIVE"; driver="wifi MOTION (cam: $seen_state)"
elif [ "$wifi_fresh" = 1 ] && [ "$act_verdict" = "STILL" ]; then
  if [ "$seen_state" = "NOT-IN-FRAME" ]; then
    # chat-review/bruno-seen-axis-stale-lockin: an explicit cam absence CORROBORATES against
    # presence — it must not be read the same as no-cam-data-at-all. Stillness alone (no vision
    # signal) still means RESTING (unchanged); stillness WITH the cat explicitly not in frame is
    # downgraded to UNKNOWN, never asserted as RESTING.
    state="UNKNOWN"; driver="wifi STILL but cam explicitly NOT-IN-FRAME (absence corroborates, not resting)"
  else
    state="RESTING"; driver="wifi STILL (cam: $seen_state)"
  fi
elif [ "$thin_fresh" = 1 ] && [ "$thin_sig" = "QUIET" ]; then
  # thin-QUIET makes the SAME claim decisive STILL makes ("no human-scale motion in the room"), from
  # 3 steady anchors instead of 4 — a weaker room-proxy, so it fuses last, after every corroborated
  # axis. thin-ACTIVE deliberately asserts NOTHING: the producer refuses to promote it to MOTION
  # (uncorroborated), so we refuse to promote it to ACTIVE — it only keeps the axis alive via
  # thin_fresh so the surprise below reads degraded, not blind.
  if [ "$seen_state" = "NOT-IN-FRAME" ]; then
    state="UNKNOWN"; driver="wifi thin-QUIET but cam explicitly NOT-IN-FRAME (absence corroborates, not resting)"
  else
    state="RESTING"; driver="wifi thin-QUIET (${thin_n} anchors, below corroboration floor; cam: $seen_state)"
  fi
fi

# --- 4. PREDICTION: circadian prior, overridden by the learned label-histogram -------
pred_state="RESTING"; pred_conf="0.40"; pred_driver="circadian fallback"
IFS='|' read -r ps pc pd <<< "$(circadian_prior "$lhour")"
[ -n "${ps:-}" ] && { pred_state=$ps; pred_conf=$pc; pred_driver=$pd; }
# learned_prior emits "STATE|n|driver" (driver may contain spaces) — split only the first two fields:
lp=$(learned_prior "$lhour")
if [ -n "$lp" ]; then
  ls=$(printf '%s\n' "$lp" | cut -d'|' -f1)
  ln=$(printf '%s\n' "$lp" | cut -d'|' -f2)
  ld=$(printf '%s\n' "$lp" | cut -d'|' -f3)
  [ -n "$ls" ] && { pred_state=$ls; pred_conf="0.80"; pred_driver="$ld (n=$ln)"; }
fi

# --- 5. LIVENESS-AS-LEASE: is each sense's evidence still within its lease? ----------
fresh_obs=$(( cam_alive | wifi_fresh | lbl_fresh | thin_fresh ))
# Axes that can actually SEE/IDENTIFY Bruno. The cam resolves a cat in frame; an operator label is
# ground truth. wifi-motion is NEITHER — it is the operator's people-sensing (device-free RSSI
# variance) calibrated for human-scale motion, with no evidence it registers a ~4kg cat. It is still
# a real signal about the ROOM and still fuses into the state below; it just cannot arbitrate a claim
# ABOUT BRUNO, so it must not be the thing that contradicts the prior and wakes a mind.
cat_capable=$(( cam_fresh | lbl_fresh ))

# A HELD verdict must not render as a fresh read: the pane is the mind's evidence, and "wifi STILL"
# meaning "wifi said STILL 12m ago and has been inconclusive since" is a materially different claim
# from "wifi just read STILL". The age is already shown, but the driver must not imply a live read.
[ "${act_held:-0}" = 1 ] && [ "$wifi_fresh" = 1 ] && driver="$driver [held lease — axis inconclusive since]"

# --- 6. SURPRISE: prediction error. Wake the mind on SENSE-FAILURE or DIVERGENCE only --
if [ "$fresh_obs" = 0 ]; then
  surprise="SENSE-FAILURE"; surp_detail="all leases expired — senses blind, cannot observe Bruno"
elif [ "$state" = "UNKNOWN" ]; then
  # an axis is ALIVE (fresh_obs=1) yet nothing could be asserted: thin-ACTIVE (uncorroborated
  # motion), or STILL/thin-QUIET downgraded by an explicit cam NOT-IN-FRAME. This branch used to
  # fall through to CONFIRMED — "observed UNKNOWN consistent with predicted X" scored the prior
  # against no observation at all.
  surprise="UNCORROBORATED"; surp_detail="axes alive but none corroborates a state (wifi: $act_verdict${thin_sig:+, thin-$thin_sig}; cam: $seen_state)"
elif [ "$cat_capable" = 0 ]; then
  # Seen ONLY through the room proxy — and a proxy that cannot see the subject can neither refute NOR
  # CONFIRM a claim about it. The mismatch half of this was already refused (8853fd5: "deliberately
  # NOT CONFIRMED — that would assert the prediction was validated, a lie"), but the MATCH half still
  # said CONFIRMED, which is the same lie wearing the opposite sign. wifi-motion reads STILL whether
  # Bruno rests or does zoomies, so at every resting hour it agrees with the prior BY CONSTRUCTION: a
  # claim that cannot fail is not evidence. Non-wake either way; the difference is what we CLAIM.
  if [ "$state" != "$pred_state" ]; then
    surp_detail="observed $state (wifi room-proxy only) vs predicted $pred_state — no cat-capable axis (cam/label) to test the prior"
  else
    surp_detail="observed $state (wifi room-proxy only) matches predicted $pred_state — but the proxy cannot see a cat, so this is agreement, not confirmation"
  fi
  surprise="UNCORROBORATED"
elif [ "$state" != "UNKNOWN" ] && [ "$state" != "$pred_state" ]; then
  surprise="DIVERGENCE"; surp_detail="observed $state vs predicted $pred_state"
else
  surprise="CONFIRMED"; surp_detail="observed ${state:-UNKNOWN} consistent with predicted $pred_state"
fi

ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)

if [ "${1:-}" = "--json" ]; then
  printf '{"state":"%s","driver":"%s","seen":"%s","seen_age_s":%d,"seen_held":%d,"activity":"%s","activity_age_s":%d,"thin":"%s","thin_age_s":%d,"thin_fresh":%d,"label":"%s","label_age_s":%d,"predicted":"%s","predict_conf":"%s","predict_driver":"%s","local_hour":%d,"tz":"%s","surprise":"%s","surprise_detail":"%s","fresh_observed":%d,"cam_fresh":%d,"wifi_fresh":%d,"label_fresh":%d,"ts":"%s"}\n' \
    "$state" "$driver" "$seen_state" "$seen_age" "${seen_held:-0}" "$act_verdict" "$act_age" "${thin_sig:-none}" "$thin_age" "$thin_fresh" "${lbl_state:-none}" "$lbl_age" \
    "$pred_state" "$pred_conf" "$pred_driver" "$lhour" "$BRUNO_TZ" "$surprise" "$surp_detail" "$fresh_obs" "$cam_fresh" "$wifi_fresh" "$lbl_fresh" "$ts"
else
  echo "PREDICT:  $pred_state (conf $pred_conf, $pred_driver) @ local hour $lhour [$BRUNO_TZ]"
  echo "OBSERVE:  $state   ($driver)"
  echo "SURPRISE: $surprise — $surp_detail   [$(is_wake "$surprise" && echo '→ wake mind' || echo 'mind sleeps')]"
  echo "LEASES:   cam $(lease_fmt "$seen_age" "$LEASE_CAM") [fresh=$cam_fresh] | wifi $(lease_fmt "$act_age" "$LEASE_WIFI") [fresh=$wifi_fresh] | thin $([ -n "$thin_sig" ] && echo "$thin_sig $(lease_fmt "$thin_age" "$LEASE_WIFI")" || echo none) [fresh=$thin_fresh] | label $(lease_fmt "$lbl_age" "$LEASE_LABEL") [fresh=$lbl_fresh]"
  echo "INVARIANT: liveness-as-lease — state asserted only while a lease is FRESH; all expired → UNKNOWN + wake"
  echo "--- evidence ---"
  echo "Bruno — $state   ($driver)"
  _held_sfx=""; [ "${seen_held:-0}" = 1 ] && _held_sfx=" [held: SEEING, no motion since last read]"
  if [ "$seen_state" = "SEEN" ]; then echo "  seen:     $(age_fmt $seen_age) ago — $seen_desc$_held_sfx"
  elif [ "$seen_state" = "NOT-IN-FRAME" ]; then echo "  seen:     not in frame (cam live $(age_fmt $seen_age) ago)$_held_sfx"
  else echo "  seen:     UNKNOWN (cam log cold)"; fi
  if [ "$act_verdict" = "MOTION" ] || [ "$act_verdict" = "STILL" ]; then echo "  activity: wifi $act_verdict ($(age_fmt $act_age) ago)"
  elif [ -n "$thin_sig" ] && [ "$thin_sig" != "NONE" ]; then echo "  activity: wifi thin-$thin_sig (${thin_n} anchors, below corroboration floor, $(age_fmt $thin_age) ago)"
  elif [ "$act_verdict" != "UNKNOWN" ]; then echo "  activity: wifi $act_verdict (inconclusive, $(age_fmt $act_age) ago)"
  else echo "  activity: UNKNOWN (no wifi tape)"; fi
  if [ -n "$lbl_state" ]; then echo "  operator: '$lbl_raw' -> $lbl_state ($(age_fmt $lbl_age) ago)"
  else echo "  operator: no Bruno label logged"; fi
fi

# liveness-touch: mtime = ran-live (always), content = the change-gated state
# ([[reflex-cadence-prose-and-cron-glob]] / state-touch convention).
{ echo "$state|$driver|$ts"; } > "$STATE" 2>/dev/null || true
command -v mesh-state-touch >/dev/null 2>&1 && mesh-state-touch "$STATE" >/dev/null 2>&1 || touch "$STATE" 2>/dev/null || true
# wake the mind only on a surprise transition (cooldown + transition-gated; no-op under --json/--test)
maybe_poke "${1:-}"
exit 0
