#!/usr/bin/env bash
# mesh-bruno — the BRUNO cross-section: a single perspective fusing every signal we
# have about the operator's cat into ONE coarse ACTIVITY read (sleep / active / eat /
# resting), NOT a location. This is the "разрез" the operator asked for (2026-07-06):
# the bruno channel's data pane is not "data in general" but the angle from which we
# look at Bruno. Scope is deliberately activity-not-geometry ([[cat-tracking-scope-is-activity-not-location]]).
#
# Three existing signals, no new capture infra:
#   1. VISION  — mesh-imac-cam-watch's ~/.mesh/imac-cat-log.tsv (Groq vision on the iMac
#                cam near the bed): "Cat visible on the bed" vs "No cat visible".
#   2. ACTIVITY— mesh-wifi-motion --json (device-free RSSI-variance MOTION/STILL axis).
#   3. TRUTH   — operator's own TG labels in ~/.mesh/voice-in.log ("Бруно спит/ест/активен"):
#                the ground-truth override when fresh.
#
# Honest fusion: an absent/stale input renders its axis UNKNOWN, never a faked all-clear
# ([[fusion-tools-distinguish-empty-from-failed]]). All inputs cold -> STATE=UNKNOWN.
#
# Usage:
#   mesh-bruno            one-shot fused read (human, for the dash)
#   mesh-bruno --json     machine-readable {state, driver, seen, activity, label, ts}
#   mesh-bruno --test     smoke-test (fixtures, no live cam/wifi)
#
# reflex-cadence: */5 * * * *
# Cheap (local file parse + one wifi-motion tape classify) — safe at 5-min cadence to keep
# the bruno dash's cached state fresh; --test is sandboxed (fixtures, no real read).
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"

MESH="$HOME/.mesh"; mkdir -p "$MESH"
# node-local tuning (gitignored) sourced so the SAME defaults reach the cron reflex AND the pane.
# Primary use: MESH_BRUNO_TZ (Bruno's local timezone — the circadian prior keys on it; an unset/wrong
# TZ makes every prediction fire at the wrong local hour → false DIVERGENCE). Absent file = UTC default.
[ -f "$MESH/bruno.env" ] && { set -a; . "$MESH/bruno.env"; set +a; }
CAMLOG="${MESH_BRUNO_CAMLOG:-$MESH/imac-cat-log.tsv}"
VOICELOG="${MESH_BRUNO_VOICELOG:-$MESH/voice-in.log}"
STATE="${MESH_BRUNO_STATE:-$MESH/bruno.state}"
NOWIFI="${MESH_BRUNO_NOWIFI:-}"   # test hermeticity: skip the mesh-wifi-motion call

# ---- --test: hermetic, fixture-driven (no live cam/wifi/network) ----
if [ "${1:-}" = "--test" ]; then
  f=0
  for d in date grep awk sed; do command -v "$d" >/dev/null 2>&1 || { echo "  FAIL: $d missing"; f=1; }; done
  tmp="$(mktemp -d)"
  # voice fixture, three lines exercising the gate:
  #  1. a SHORT real label (oldest);
  #  2. the operator's LONG walk-design paragraph — mentions 'обруно' MID-sentence and is full of
  #     'то есть' (the input that first FALSELY read EATING via a bare 'ест' substring). It must be
  #     REJECTED because it does NOT begin with the cat's name (start-anchor gate), NOT because of length;
  #  3. a real long CONTEXTUAL label with parenthetical context (newest) — this is what the byte-length
  #     gate USED to silently drop; it MUST now be accepted → SLEEPING (the real-read gate for the fix).
  { echo "2026-07-06T10:00:00Z  VOICE  Бруно спит на кровати";
    echo "2026-07-06T17:48:48Z  VOICE  Да, и кстати на прогулке, то есть вот про обруно, то есть если появляется фокус, то есть надо смотреть за бруны в контексте";
    echo "2026-07-06T18:00:00Z  TEXT  Бруно спит на диване в спальне (та же комната, мак+ideapad) — оператор текстом"; } > "$tmp/voice.log"
  echo "2026-07-06T17:00:00Z	Bed and printer. Cat visible on the bed." > "$tmp/cam.log"
  out="$(MESH_BRUNO_VOICELOG="$tmp/voice.log" MESH_BRUNO_CAMLOG="$tmp/cam.log" \
         MESH_BRUNO_STATE="$tmp/state" MESH_BRUNO_NOWIFI=1 "$0" --json 2>/dev/null)"
  case "$out" in *'"label":"SLEEPING"'*) : ;; *) echo "  FAIL: contextual 'Бруно спит на диване (…)' label not accepted → SLEEPING — length-gate regression (got: $out)"; f=1 ;; esac
  case "$out" in *'"label":"EATING"'*) echo "  FAIL: walk-paragraph 'то есть' falsely read as EATING (regression)"; f=1 ;; esac
  case "$out" in *'"seen":"SEEN"'*) : ;; *) echo "  FAIL: cat-visible cam fixture not read as SEEN (real-read gate)"; f=1 ;; esac

  # --- transition-parenthetical misclassification (2026-07-11) ---
  # operator label "сейчас лежит" (now lying = RESTING) was misread as ACTIVE because the
  # parenthetical "(переход: спал→активен→лежит)" contains "активен" → bare token match on the
  # full line. Strip parens before matching + recognize "лежит"→RESTING.
  { echo "2026-07-07T01:14:11Z  TEXT  Бруно: ходил по кровати, сейчас лежит на подушке у окна рядом с ideapad (переход: спал→активен→лежит) — оператор текстом"; } > "$tmp/voice_tr.log"
  out_tr="$(MESH_BRUNO_VOICELOG="$tmp/voice_tr.log" MESH_BRUNO_CAMLOG=/dev/null \
            MESH_BRUNO_STATE="$tmp/state_tr" MESH_BRUNO_NOWIFI=1 "$0" --json 2>/dev/null)"
  case "$out_tr" in *'"label":"RESTING"'*) : ;; *) echo "  FAIL: 'сейчас лежит' with '(переход: …активен…)' paren must read RESTING not ACTIVE (got: $out_tr)"; f=1 ;; esac
  case "$out_tr" in *'"label":"ACTIVE"'*) echo "  FAIL: transition-paren 'активен' still misclassifies as ACTIVE (got: $out_tr)"; f=1 ;; esac

  # --- English resting vocabulary (2026-07-15): operator wrote "Bruno laying, chilling by the window";
  # laying/chilling weren't in the vocab (and the only catch token was inside parens, stripped) -> the
  # fresh label was silently dropped -> hollow calibration channel. Must now classify RESTING.
  { echo "$(date -u +%Y-%m-%dT%H:%M:%SZ)  TEXT  Bruno laying, chilling by the window"; } > "$tmp/voice_en.log"
  out_en="$(MESH_BRUNO_VOICELOG="$tmp/voice_en.log" MESH_BRUNO_CAMLOG=/dev/null \
            MESH_BRUNO_STATE="$tmp/state_en" MESH_BRUNO_NOWIFI=1 "$0" --json 2>/dev/null)"
  case "$out_en" in *'"label":"RESTING"'*) : ;; *) echo "  FAIL: 'Bruno laying, chilling' must classify RESTING (English vocab, got: $out_en)"; f=1 ;; esac

  # --- poke gate: `since` must mean WHEN THE SURPRISE BEGAN, not when we last looked (2026-07-15) ---
  # The state write used to sit OUTSIDE the change check while bruno's cron is */5, so `since` was
  # re-stamped every eval: now-since was ~300s forever and could NEVER reach POKE_REMIND=7200 —
  # the whole "re-remind a stuck wake-kind every 2h" branch was DEAD CODE (verified live: the state
  # file read DIVERGENCE|<7 seconds ago> while the divergence had persisted for hours). With remind
  # dead, the only surviving poke path is prev!=surprise, so a FLAPPING condition became the sole
  # wake source — ~2.4 paid mind-wakes/hour on mesh-home's marginal 5-AP corpus.
  # Mirror image of the liveness-touch convention: there an unconditional write is REQUIRED (mtime =
  # ran-live); here an unconditional write DESTROYS the change-time the logic depends on.
  # The stub goes through MESH_BRUNO_TELL, NOT PATH: this script re-exports
  # PATH="$HOME/.local/bin:$PATH" at startup, so a PATH-prepended stub loses to the real mesh-tell
  # and the dry-run pokes the operator's live window (observed 2026-07-15 — an h3 deep-night fixture
  # surfaced as a real 19:00 reflex message). A test that can reach the real transport is a test that
  # forges the evidence it checks.
  _sp="$tmp/surp.state"; _lp="$tmp/lastpoke"; _tell="$tmp/tell.log"
  printf '#!/bin/sh\necho "$@" >> "%s"\n' "$_tell" > "$tmp/tellstub"; chmod +x "$tmp/tellstub"
  _pokerun(){ MESH_BRUNO_TELL="$tmp/tellstub" MESH_BRUNO_SURP_STATE="$_sp" MESH_BRUNO_LASTPOKE="$_lp" \
      MESH_BRUNO_VOICELOG=/dev/null MESH_BRUNO_CAMLOG=/dev/null MESH_BRUNO_STATE="$tmp/s_poke" \
      MESH_BRUNO_NOWIFI=1 MESH_BRUNO_HOUR_OVERRIDE="${1:-3}" "$0" >/dev/null 2>&1; }
  _pokerun 3; _s1="$(cut -d'|' -f2 "$_sp" 2>/dev/null)"; _k1="$(cut -d'|' -f1 "$_sp" 2>/dev/null)"
  sleep 2
  _pokerun 3; _s2="$(cut -d'|' -f2 "$_sp" 2>/dev/null)"
  [ -n "$_s1" ] || { echo "  FAIL: poke gate wrote no surprise state (got kind='$_k1')"; f=1; }
  [ "$_s1" = "$_s2" ] || { echo "  FAIL: 'since' must NOT advance while the surprise is UNCHANGED — re-stamping it makes now-since track the eval cadence, so POKE_REMIND can never fire (dead code): $_s1 -> $_s2"; f=1; }
  # ...but a CHANGED surprise must re-stamp, or a new condition inherits the old one's age and
  # re-reminds instantly.
  printf 'CONFIRMED|1\n' > "$_sp"
  _pokerun 3; _s3="$(cut -d'|' -f2 "$_sp" 2>/dev/null)"
  [ "$_s3" != "1" ] || { echo "  FAIL: a CHANGED surprise must re-stamp 'since' (got stale since=$_s3)"; f=1; }
  # the poke must have gone to the STUB, never the real transport — proves the injection actually
  # holds against this script's own PATH re-export (the bug that let a fixture poke the live window)
  [ -s "$_tell" ] || { echo "  FAIL: poke gate never invoked the injected transport — the stub is not on the path the poke really takes"; f=1; }
  grep -q 'bruno-reflex' "$_tell" 2>/dev/null || { echo "  FAIL: injected transport got no bruno-reflex poke (got: $(cat "$_tell" 2>/dev/null))"; f=1; }
  # the --test must never touch the LIVE poke-gate artifacts (mesh-doctor runs it hourly)
  [ -f "$MESH/bruno-surprise.state" ] && [ "$(stat -c %Y "$MESH/bruno-surprise.state" 2>/dev/null)" -gt "$(( $(date +%s) - 5 ))" ] && { echo "  FAIL: --test wrote the LIVE bruno-surprise.state — forges the gate's own evidence"; f=1; }

  # --- chat-review/bruno-seen-axis-stale-lockin (2026-07-07) ---
  # (1) an old affirming SEEN row followed by several FRESH "No cat visible" rows must read
  # NOT-IN-FRAME, not SEEN — an old sighting must not outlive fresh negative reads (live bug:
  # seen=SEEN at 9h stale against 6+ consecutive fresh negative reads).
  { echo "2026-07-06T08:00:00Z	Cat visible on the bed.";
    echo "2026-07-07T20:30:00Z	Bed, dark shirt.";
    echo "No cat visible.";
    echo "2026-07-07T20:35:00Z	Empty bed.";
    echo "No cat visible.";
    echo "2026-07-07T20:40:00Z	Empty room, no cat.";
    echo "No cat visible."; } > "$tmp/cam2.log"
  out2="$(MESH_BRUNO_VOICELOG="$tmp/no_voice.log" MESH_BRUNO_CAMLOG="$tmp/cam2.log" \
          MESH_BRUNO_STATE="$tmp/state2" MESH_BRUNO_NOWIFI=1 "$0" --json 2>/dev/null)"
  case "$out2" in *'"seen":"NOT-IN-FRAME"'*) : ;; *) echo "  FAIL: old SEEN row must not outlive fresh negative rows -> NOT-IN-FRAME (got: $out2)"; f=1 ;; esac
  case "$out2" in *'"seen":"SEEN"'*) echo "  FAIL: stale-lockin regression — still reads SEEN off the old row (got: $out2)"; f=1 ;; esac

  # (2) fresh NOT-IN-FRAME + wifi STILL must downgrade to UNKNOWN, never assert RESTING
  # (explicit absence corroborates AGAINST presence, it isn't the same as no-data-at-all)
  out3="$(MESH_BRUNO_VOICELOG="$tmp/no_voice.log" MESH_BRUNO_CAMLOG="$tmp/cam2.log" \
          MESH_BRUNO_STATE="$tmp/state3" MESH_BRUNO_ACT_OVERRIDE=STILL "$0" --json 2>/dev/null)"
  case "$out3" in *'"state":"UNKNOWN"'*) : ;; *) echo "  FAIL: NOT-IN-FRAME + wifi STILL must be UNKNOWN, not asserted (got: $out3)"; f=1 ;; esac
  case "$out3" in *'"state":"RESTING"'*) echo "  FAIL: NOT-IN-FRAME + wifi STILL must NOT be RESTING (got: $out3)"; f=1 ;; esac

  # (3) no vision history at all (seen=UNKNOWN) + wifi STILL -> RESTING, existing behavior preserved
  : > "$tmp/no_cam.log"
  out4="$(MESH_BRUNO_VOICELOG="$tmp/no_voice.log" MESH_BRUNO_CAMLOG="$tmp/no_cam.log" \
          MESH_BRUNO_STATE="$tmp/state4" MESH_BRUNO_ACT_OVERRIDE=STILL "$0" --json 2>/dev/null)"
  case "$out4" in *'"state":"RESTING"'*) : ;; *) echo "  FAIL: no-vision-history + wifi STILL should still be RESTING (regression, got: $out4)"; f=1 ;; esac

  # --- predictive layer (2026-07-15): prior + liveness-lease + surprise ---
  # SENSE-FAILURE: every sense cold -> no fresh lease -> surprise SENSE-FAILURE, fresh_observed 0.
  out_sf="$(MESH_BRUNO_VOICELOG=/dev/null MESH_BRUNO_CAMLOG=/dev/null \
            MESH_BRUNO_STATE="$tmp/state_sf" MESH_BRUNO_NOWIFI=1 MESH_BRUNO_HOUR_OVERRIDE=3 MESH_BRUNO_NOPOKE=1 "$0" --json 2>/dev/null)"
  case "$out_sf" in *'"surprise":"SENSE-FAILURE"'*) : ;; *) echo "  FAIL: all senses cold must be SENSE-FAILURE (got: $out_sf)"; f=1 ;; esac
  case "$out_sf" in *'"fresh_observed":0'*) : ;; *) echo "  FAIL: all cold -> fresh_observed must be 0 (got: $out_sf)"; f=1 ;; esac

  # DIVERGENCE: hour 3 circadian predicts SLEEPING; a FRESH label says EATING -> observed != predicted.
  ts_now=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  printf '%s  VOICE  Бруно кушает у миски\n' "$ts_now" > "$tmp/voice_div.log"
  out_dv="$(MESH_BRUNO_VOICELOG="$tmp/voice_div.log" MESH_BRUNO_CAMLOG=/dev/null \
            MESH_BRUNO_STATE="$tmp/state_dv" MESH_BRUNO_NOWIFI=1 MESH_BRUNO_HOUR_OVERRIDE=3 MESH_BRUNO_NOPOKE=1 "$0" --json 2>/dev/null)"
  case "$out_dv" in *'"surprise":"DIVERGENCE"'*) : ;; *) echo "  FAIL: fresh EATING vs predicted SLEEPING must be DIVERGENCE (got: $out_dv)"; f=1 ;; esac
  case "$out_dv" in *'"predicted":"SLEEPING"'*) : ;; *) echo "  FAIL: hour-3 circadian prior must be SLEEPING (got: $out_dv)"; f=1 ;; esac
  case "$out_dv" in *'"state":"EATING"'*) : ;; *) echo "  FAIL: fresh EATING label must drive state EATING (got: $out_dv)"; f=1 ;; esac

  # CONFIRMED: hour 12 predicts SLEEPING; fresh SLEEPING label -> observed == predicted -> CONFIRMED.
  printf '%s  VOICE  Бруно спит на кровати\n' "$ts_now" > "$tmp/voice_conf.log"
  out_cf="$(MESH_BRUNO_VOICELOG="$tmp/voice_conf.log" MESH_BRUNO_CAMLOG=/dev/null \
            MESH_BRUNO_STATE="$tmp/state_cf" MESH_BRUNO_NOWIFI=1 MESH_BRUNO_HOUR_OVERRIDE=12 MESH_BRUNO_NOPOKE=1 "$0" --json 2>/dev/null)"
  case "$out_cf" in *'"surprise":"CONFIRMED"'*) : ;; *) echo "  FAIL: observed==predicted SLEEPING must be CONFIRMED (got: $out_cf)"; f=1 ;; esac

  # PRIOR-LEARNING: 3 SLEEPING labels at hour 17 (circadian says ACTIVE there) -> learned overrides.
  { echo "2026-07-10T17:05:00Z  VOICE  Бруно спит";
    echo "2026-07-11T17:20:00Z  VOICE  Бруно спит";
    echo "2026-07-12T17:45:00Z  VOICE  Бруно спит"; } > "$tmp/voice_learn.log"
  out_lp="$(MESH_BRUNO_VOICELOG="$tmp/voice_learn.log" MESH_BRUNO_CAMLOG=/dev/null \
            MESH_BRUNO_STATE="$tmp/state_lp" MESH_BRUNO_NOWIFI=1 MESH_BRUNO_TZ=UTC MESH_BRUNO_HOUR_OVERRIDE=17 MESH_BRUNO_NOPOKE=1 "$0" --json 2>/dev/null)"
  case "$out_lp" in *'"predicted":"SLEEPING"'*) : ;; *) echo "  FAIL: 3 SLEEPING labels @h17 must override circadian ACTIVE -> predicted SLEEPING (got: $out_lp)"; f=1 ;; esac
  case "$out_lp" in *'"predict_driver":"learned'*) : ;; *) echo "  FAIL: learned prior must mark driver 'learned' (got: $out_lp)"; f=1 ;; esac

  rm -rf "$tmp"
  [ "$f" = 0 ] && { echo "smoke-test: ok (label gate + EATING-regression + cam real-read + seen-axis stale-lockin fix + STILL-branch NOT-IN-FRAME downgrade + no-vision-STILL preserved + transition-paren RESTING fix + English resting vocab + predict/surprise: SENSE-FAILURE + DIVERGENCE + CONFIRMED + prior-LEARNING)"; exit 0; } || { echo "smoke-test: FAIL"; exit 1; }
fi

now=$(date +%s)
iso_to_epoch(){ date -u -d "$1" +%s 2>/dev/null || echo 0; }
age_fmt(){ local s=$1; if [ "$s" -lt 0 ]; then echo "?"; elif [ "$s" -lt 90 ]; then echo "${s}s"; \
  elif [ "$s" -lt 5400 ]; then echo "$((s/60))m"; elif [ "$s" -lt 172800 ]; then echo "$((s/3600))h"; \
  else echo "$((s/86400))d"; fi; }

# ── PREDICTIVE LAYER (operator 2026-07-15) ─────────────────────────────────────────
# The bruno channel is a predictive-coding loop, NOT a reactive dump. The top pane carries a PRIOR
# (what we EXPECT Bruno to do at this local hour), the OBSERVED fused state, and a SURPRISE signal
# (prediction error). Reflexes sense the reality stream and wake the mind ONLY on surprise
# (divergence | sense-failure); a CONFIRMED prediction lets it sleep. Goal: predict Bruno 24/7.
# Calibration: the operator reads the pane; if PREDICT/OBSERVE ≠ what Bruno is actually doing, they
# send a label ("Бруно спит/ест/активен") — that both corrects the now-read AND feeds the learned
# prior for that hour (the histogram below). Over time the prediction self-calibrates.
#
# LIVENESS-AS-LEASE: a state is asserted only while at least one sense's LEASE is FRESH. Each sense
# has a max acceptable age; all expired → state UNKNOWN + a SENSE-FAILURE surprise (wake to fix the
# senses, not to narrate). This is the invariant the reflex guards.
BRUNO_TZ="${MESH_BRUNO_TZ:-UTC}"
LEASE_CAM="${MESH_BRUNO_LEASE_CAM:-1800}"    # a sighting stays valid 30m
LEASE_WIFI="${MESH_BRUNO_LEASE_WIFI:-600}"   # a motion verdict decays in 10m
LEASE_LABEL="${MESH_BRUNO_LEASE_LABEL:-2700}" # an operator label holds 45m (matches the fusion gate)
LEARN_MIN="${MESH_BRUNO_LEARN_MIN:-3}"       # min labels/hour before the prior is "learned" not "circadian"
# ONE candidate-token list shared by EVERY label grep (fusion filter + learned-prior filter).
# Duplication drifts: a 3rd copy missing English resting vocab silently dropped a fresh operator
# label ("Bruno laying, chilling") → hollow calibration. English: sleep/eat/active/play/rest/chill/lay/lying/lounge.
LABEL_TOKENS='спит|сон|засыпа|sleep|проснул|awake|кушает|поел|жр[ёе]т|покорм|у миски|корм|eat|актив|игра|бегает|active|play|лежит|л[ёе]г|отдых|rest|chill|lay|lying|lounge'
# Overridable so --test drives its OWN poke-gate artifacts. A dry-run that writes the REAL
# bruno-surprise.state / .bruno-lastpoke forges the evidence the gate exists to check: it would plant
# a fake `prev` (making the next live transition read as unchanged → no poke) and stamp lastpoke
# (suppressing a real poke for 25m). mesh-doctor runs every tool's --test hourly, so that corruption
# would be continuous. Same precedent as mesh-guardian's MESH_GUARDIAN_LOG (09f7914).
SURP_STATE_FILE="${MESH_BRUNO_SURP_STATE:-$MESH/bruno-surprise.state}" # current surprise kind — transition-gates the poke
LASTPOKE="${MESH_BRUNO_LASTPOKE:-$MESH/.bruno-lastpoke}"
# The poke TRANSPORT must be injectable, not stubbed via PATH: this script does
# `export PATH="$HOME/.local/bin:$PATH"` at line 27, so a test that prepends its own bin is
# OVERRIDDEN by the real mesh-tell and the dry-run fires a REAL poke into the operator's bruno
# window. Observed exactly that 2026-07-15: the --test's HOUR_OVERRIDE=3 fixture surfaced as a live
# "[bruno-reflex: SENSE-FAILURE] ... predict=SLEEPING (@h3, circadian deep-night)" at 19:00 Moscow —
# the test forging the very evidence it exists to check. (Same shape as the forced-PATH-defeats-venv
# -prepends trap.) --test sets MESH_BRUNO_TELL=/bin/true; nothing else may.
TELL="${MESH_BRUNO_TELL:-mesh-tell}"
POKE_COOLDOWN="${MESH_BRUNO_POKE_COOLDOWN:-1500}"  # 25m min between pokes
POKE_REMIND="${MESH_BRUNO_POKE_REMIND:-7200}"      # re-remind a stuck wake-kind every 2h

# local hour for the circadian prior. HOUR_OVERRIDE is a test hook (deterministic prior); the TZ is
# surfaced on the pane so the operator can correct it (set MESH_BRUNO_TZ).
lhour="${MESH_BRUNO_HOUR_OVERRIDE:-$(TZ="$BRUNO_TZ" date +%H 2>/dev/null | sed 's/^0//')}"; lhour="${lhour:-0}"

circadian_prior(){  # $1 local hour 0..23 -> echoes STATE|conf|driver (cats are crepuscular)
  case "$1" in
    0|1|2|3|4)      echo "SLEEPING|0.70|circadian deep-night" ;;
    5|6)            echo "ACTIVE|0.55|circadian dawn-burst" ;;
    7|8|9)          echo "RESTING|0.50|circadian post-dawn" ;;
    10|11|12|13|14) echo "SLEEPING|0.65|circadian midday-nap" ;;
    15|16)          echo "RESTING|0.50|circadian afternoon" ;;
    17|18|19)       echo "ACTIVE|0.55|circadian dusk-burst" ;;
    20|21)          echo "EATING|0.45|circadian dinner-window" ;;
    22|23)          echo "RESTING|0.50|circadian pre-sleep" ;;
    *)              echo "RESTING|0.40|circadian fallback" ;;
  esac
}

classify_label(){  # $1 = line with parens stripped -> echoes a STATE or "" (shared by fusion + prior)
  # NB: catch tokens must SURVIVE paren-stripping — don't rely on a parenthetical hint (the
  # operator's "Bruno laying, chilling by the window (resting)" had its only catch token inside
  # parens and was silently dropped → fresh label classified as nothing → hollow calibration).
  case "$1" in
    *спит*|*сон*|*засыпа*|*[Ss]leep*|*проснул*|*awake*)              echo "SLEEPING" ;;
    *кушает*|*поел*|*жр[ёе]т*|*покорм*|*"у миски"*|*корм*|*[Ee]at*)  echo "EATING" ;;
    *лежит*|*л[ёе]г*|*отдых*|*[Rr]est*|*[Ll]aying*|*[Ll]ying*|*[Cc]hill*|*[Ll]ounge*)  echo "RESTING" ;;
    *актив*|*игра*|*[Aa]ctive*|*play*|*бегает*)                      echo "ACTIVE" ;;
  esac
}

# LEARNED prior: tally the operator's own labels per LOCAL hour; if the current hour has ≥ LEARN_MIN
# samples, the mode overrides the circadian default. Derived live from voice-in.log (cheap, local) —
# this IS the calibration channel: each label reshapes the prior for that hour going forward.
learned_prior(){  # $1 = local hour -> echoes STATE|n|driver, or "" if too few samples
  [ -s "$VOICELOG" ] || return 0
  local ln ts ep lh m s best="" bestn=0 tot=0
  declare -A cnt
  while IFS= read -r ln; do
    [ -n "$ln" ] || continue
    ts=$(printf '%s\n' "$ln" | grep -oE '^[0-9-]+T[0-9:]+Z'); [ -n "$ts" ] || continue
    ep=$(iso_to_epoch "$ts"); [ "${ep:-0}" -gt 0 ] || continue
    lh=$(TZ="$BRUNO_TZ" date -u -d "@$ep" +%H 2>/dev/null | sed 's/^0//'); lh="${lh:-0}"
    [ "$lh" = "$1" ] || continue
    m=$(printf '%s\n' "$ln" | sed -E 's/\([^)]*\)//g'); s=$(classify_label "$m")
    [ -n "$s" ] || continue
    cnt[$s]=$(( ${cnt[$s]:-0} + 1 ))
  done < <(awk 'NF>=3 && NF<=30 && $3 ~ /^Бруно|^бруно|^[Bb]runo/' "$VOICELOG" \
            | grep -iE "$LABEL_TOKENS")
  for s in "${!cnt[@]}"; do tot=$((tot+${cnt[$s]})); [ "${cnt[$s]}" -gt "$bestn" ] && { bestn=${cnt[$s]}; best=$s; }; done
  [ "${tot:-0}" -ge "$LEARN_MIN" ] && [ -n "$best" ] && echo "$best|$tot|learned@hour$1" || true
}

lease_fmt(){ local age=$1 lim=$2;  # -> "Xm left" | "EXPIRED(Ym)" | "none"
  if [ "${age:--1}" -lt 0 ]; then echo "none";
  elif [ "$age" -ge "$lim" ]; then echo "EXPIRED($(age_fmt "$age"))";
  else echo "$(age_fmt $((lim-age))) left"; fi; }

# poke the mind ONLY on a surprise transition (or a long re-remind), never on a confirmed prediction.
# mirrors mesh-sound-reflex's poke(): a cooldown + transition-gate so a persistent condition (cam
# offline) pokes once, not every tick. Human/default invocation only — never under --json/--test.
maybe_poke(){
  [ "${1:-}" = "--json" ] && return 0
  [ "${MESH_BRUNO_NOPOKE:-0}" = 1 ] && return 0
  command -v "$TELL" >/dev/null 2>&1 || return 0
  local prev="" since=0 now2 lp_age do_poke=0 wake=0 restamp=0
  IFS='|' read -r prev since < "$SURP_STATE_FILE" 2>/dev/null || true
  since=${since:-0}; now2=$(date +%s)
  case "$surprise" in SENSE-FAILURE|DIVERGENCE) wake=1;; esac
  if [ "$wake" = 1 ]; then
    if [ "$prev" != "$surprise" ]; then do_poke=1
    elif [ "$((now2-${since:-0}))" -ge "$POKE_REMIND" ]; then do_poke=1; restamp=1; fi; fi
  # `since` means WHEN THIS SURPRISE KIND BEGAN — so re-stamp it ONLY when the kind actually changes
  # (a new condition starts its own clock) or when a remind just fired (restart the POKE_REMIND
  # window). Writing it on every eval — the original bug — made now-since track bruno's */5 cadence
  # (~300s forever), so it could never cross POKE_REMIND=7200 and the whole re-remind branch was dead
  # code; the only surviving wake path was prev!=surprise, which turned a FLAPPING verdict into the
  # sole poke source. The kind itself is recorded on ANY change, wake or not: if a CONFIRMED were
  # dropped here, prev would keep a stale kind and the next flip back would read as "unchanged" and
  # silently skip a real poke.
  if [ "$prev" != "$surprise" ] || [ "$restamp" = 1 ]; then
    printf '%s|%s\n' "$surprise" "$now2" > "$SURP_STATE_FILE" 2>/dev/null || true
  fi
  [ "$do_poke" = 1 ] || return 0
  local lp_ts; lp_ts=$(cat "$LASTPOKE" 2>/dev/null | tr -dc 0-9); [ -z "$lp_ts" ] && lp_ts=0
  local lp_age=$(( now2 - lp_ts ))
  [ "$lp_age" -lt "$POKE_COOLDOWN" ] && return 0
  echo "$now2" > "$LASTPOKE" 2>/dev/null || true
  "$TELL" bruno "[bruno-reflex: $surprise] $surp_detail. predict=$pred_state (@h$lhour $BRUNO_TZ, $pred_driver) observe=$state. Fix senses or recalibrate prior." >/dev/null 2>&1 || true
}

# --- 1. VISION axis: last cat-visible sighting from the cam log ---------------------
# tsv rows are "<iso>\t<description...>" possibly wrapping onto the next physical line;
# we scan for the newest row whose text says the cat IS visible (and not "no cat").
seen_state="UNKNOWN"; seen_age=-1; seen_desc=""
if [ -s "$CAMLOG" ]; then
  # newest timestamped row overall (freshness of the cam itself)
  last_cam_ts=$(grep -oE '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:]+Z' "$CAMLOG" | tail -1)
  # chat-review/bruno-seen-axis-stale-lockin: the NEWEST row-block (from the last timestamp
  # line to EOF — the description sometimes wraps its "No cat visible" onto the following
  # physical line, so a single-line check on the ts row alone misses it) is checked FIRST. If
  # it reads negative, that overrides ANY older affirming row further back in the log — an old
  # SEEN must not outlive several fresh negative reads (live bug: seen=SEEN at 9h stale against
  # 6+ consecutive fresh "No cat visible" rows). The unbounded affirm-scan below only runs when
  # the newest block is NOT itself a negative read.
  last_ts_lineno=$(grep -nE '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:]+Z' "$CAMLOG" | tail -1 | cut -d: -f1)
  newest_block=""
  [ -n "$last_ts_lineno" ] && newest_block="$(tail -n +"$last_ts_lineno" "$CAMLOG" 2>/dev/null)"
  if [ -n "$newest_block" ] && printf '%s\n' "$newest_block" | grep -qiE 'no cat|not visible|no.*visible|classification failed'; then
    seen_age=$(( now - $(iso_to_epoch "$last_cam_ts") ))
    seen_state="NOT-IN-FRAME"
  else
    # newest row that AFFIRMS a cat (visible/on the bed/…) and is not a "no cat"/failed line
    vis_line=$(grep -iE '^[0-9]{4}-.*(cat|кот|bruno|бруно)' "$CAMLOG" \
               | grep -ivE 'no cat|not visible|no.*visible|classification failed' | tail -1)
    if [ -n "$vis_line" ]; then
      vts=$(echo "$vis_line" | grep -oE '^[0-9-]+T[0-9:]+Z')
      seen_age=$(( now - $(iso_to_epoch "$vts") ))
      seen_desc=$(echo "$vis_line" | sed -E 's/^[0-9T:Z-]+\t?//' | cut -c1-70)
      seen_state="SEEN"
    elif [ -n "$last_cam_ts" ]; then
      # cam is live but reports no cat -> honest "not in frame", with the cam's own freshness
      seen_age=$(( now - $(iso_to_epoch "$last_cam_ts") ))
      seen_state="NOT-IN-FRAME"
    fi
  fi
fi

# --- 2. ACTIVITY axis: wifi-motion device-free RSSI ---------------------------------
act_verdict="UNKNOWN"; act_age=-1
if [ -n "${MESH_BRUNO_ACT_OVERRIDE:-}" ]; then
  # test-only hook (chat-review/bruno-seen-axis-stale-lockin): inject a verdict hermetically,
  # no live mesh-wifi-motion call, so the STILL-branch fusion logic is testable without a real tape.
  act_verdict="$MESH_BRUNO_ACT_OVERRIDE"
elif [ -z "$NOWIFI" ] && command -v mesh-wifi-motion >/dev/null 2>&1; then
  wj=$(timeout 15 mesh-wifi-motion --json 2>/dev/null)
  if [ -n "$wj" ]; then
    act_verdict=$(echo "$wj" | grep -oE '"verdict":"[A-Z]+"' | cut -d'"' -f4)
    am=$(echo "$wj" | grep -oE '"age_s":[0-9]+' | cut -d: -f2)
    [ -n "$am" ] && act_age=$am
    [ -z "$act_verdict" ] && act_verdict="UNKNOWN"
  fi
fi

# --- 3. GROUND-TRUTH axis: operator's own TG labels ---------------------------------
# A real ground-truth label is a SHORT, deliberate line ("Бруно спит" / "ест" / "активен"),
# NOT a rambling design paragraph that merely happens to mention the cat. Gate #1: line length
# < 80 chars. This is what killed the first cut — the operator's long windows-design message
# said "обруно"/"бруны" AND contained "то есть" ×N, so a bare `ест` substring falsely read
# EATING. Gate #2: eating tokens must be cat-eating words, never a substring of "то есть"/"есть".
lbl_state=""; lbl_age=-1; lbl_raw=""
if [ -s "$VOICELOG" ]; then
  # Gate: a deliberate label BEGINS with "Бруно"/"bruno" (field 3 after the ts+type prefix),
  # so an incidental mid-paragraph mention ("...про обруно...") is rejected; a word-count
  # ceiling (NF<=30) still bars a rambling paragraph that happens to open with the name.
  # Byte-LENGTH is deliberately NOT a gate — Cyrillic is 2 bytes/char, so `length<80` silently
  # dropped real operator labels that merely carried the operator's parenthetical context
  # (fresh unambiguous "Бруно спит на диване (…)" → no-label-logged; a hollow ground-truth axis).
  lline=$(awk 'NF>=3 && NF<=30 && $3 ~ /^Бруно|^бруно|^[Bb]runo/' "$VOICELOG" \
          | grep -iE "$LABEL_TOKENS" \
          | tail -1)
  if [ -n "$lline" ]; then
    lts=$(echo "$lline" | grep -oE '^[0-9-]+T[0-9:]+Z')
    [ -n "$lts" ] && lbl_age=$(( now - $(iso_to_epoch "$lts") ))
    lbl_raw=$(echo "$lline" | sed -E 's/^[0-9T:Z-]+ +(VOICE|TEXT) +//' | cut -c1-60)
    # Strip parenthetical transition/context notes before token-matching: a label like
    # "сейчас лежит ... (переход: спал→активен→лежит)" must classify on the CURRENT assertion
    # ("лежит" = RESTING), not the historical "активен" buried in the parenthetical.
    lmatch=$(echo "$lline" | sed -E 's/\([^)]*\)//g')
    lbl_state=$(classify_label "$lmatch")
  fi
fi

# --- FUSE -> one coarse STATE + the signal that drove it ----------------------------
# Priority: a FRESH operator label (<45m) is authoritative ground truth; else derive
# from vision+activity; else UNKNOWN. We never assert a state no signal supports.
state="UNKNOWN"; driver="no live signal"
if [ -n "$lbl_state" ] && [ "$lbl_age" -ge 0 ] && [ "$lbl_age" -lt 2700 ]; then
  state="$lbl_state"; driver="operator label ${lbl_age}s ago"
elif [ "$seen_state" = "SEEN" ] && [ "$seen_age" -lt 1800 ]; then
  # seen recently: motion axis splits active vs resting
  case "$act_verdict" in
    MOTION) state="ACTIVE";  driver="cam-seen + wifi MOTION" ;;
    STILL)  state="RESTING"; driver="cam-seen + wifi STILL" ;;
    *)      state="PRESENT"; driver="cam-seen ${seen_age}s ago" ;;
  esac
elif [ "$act_verdict" = "MOTION" ]; then
  state="ACTIVE"; driver="wifi MOTION (cam: $seen_state)"
elif [ "$act_verdict" = "STILL" ]; then
  if [ "$seen_state" = "NOT-IN-FRAME" ]; then
    # chat-review/bruno-seen-axis-stale-lockin: an explicit cam absence CORROBORATES against
    # presence — it must not be read the same as no-cam-data-at-all. Stillness alone (no vision
    # signal) still means RESTING (unchanged); stillness WITH the cat explicitly not in frame is
    # downgraded to UNKNOWN, never asserted as RESTING.
    state="UNKNOWN"; driver="wifi STILL but cam explicitly NOT-IN-FRAME (absence corroborates, not resting)"
  else
    state="RESTING"; driver="wifi STILL (cam: $seen_state)"
  fi
fi

# --- 4. PREDICTION: circadian prior, overridden by the learned label-histogram -------
pred_state="RESTING"; pred_conf="0.40"; pred_driver="circadian fallback"
IFS='|' read -r ps pc pd <<< "$(circadian_prior "$lhour")"
[ -n "${ps:-}" ] && { pred_state=$ps; pred_conf=$pc; pred_driver=$pd; }
# learned_prior emits "STATE|n|driver" (driver may contain spaces) — split only the first two fields:
lp=$(learned_prior "$lhour")
if [ -n "$lp" ]; then
  ls=$(printf '%s\n' "$lp" | cut -d'|' -f1)
  ln=$(printf '%s\n' "$lp" | cut -d'|' -f2)
  ld=$(printf '%s\n' "$lp" | cut -d'|' -f3)
  [ -n "$ls" ] && { pred_state=$ls; pred_conf="0.80"; pred_driver="$ld (n=$ln)"; }
fi

# --- 5. LIVENESS-AS-LEASE: is each sense's evidence still within its lease? ----------
cam_fresh=0;  { [ "$seen_state" = "SEEN" ] && [ "${seen_age:--1}" -ge 0 ] && [ "$seen_age" -lt "$LEASE_CAM" ]; } && cam_fresh=1
wifi_fresh=0; { [ "$act_verdict" = "MOTION" ] || [ "$act_verdict" = "STILL" ]; } && [ "${act_age:--1}" -ge 0 ] && [ "$act_age" -lt "$LEASE_WIFI" ] && wifi_fresh=1
lbl_fresh=0;  [ -n "${lbl_state:-}" ] && [ "${lbl_age:--1}" -ge 0 ] && [ "$lbl_age" -lt "$LEASE_LABEL" ] && lbl_fresh=1
fresh_obs=$(( cam_fresh | wifi_fresh | lbl_fresh ))

# --- 6. SURPRISE: prediction error. Wake the mind on SENSE-FAILURE or DIVERGENCE only --
if [ "$fresh_obs" = 0 ]; then
  surprise="SENSE-FAILURE"; surp_detail="all leases expired — senses blind, cannot observe Bruno"
elif [ "$state" != "UNKNOWN" ] && [ "$state" != "$pred_state" ]; then
  surprise="DIVERGENCE"; surp_detail="observed $state vs predicted $pred_state"
else
  surprise="CONFIRMED"; surp_detail="observed ${state:-UNKNOWN} consistent with predicted $pred_state"
fi

ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)

if [ "${1:-}" = "--json" ]; then
  printf '{"state":"%s","driver":"%s","seen":"%s","seen_age_s":%d,"activity":"%s","activity_age_s":%d,"label":"%s","label_age_s":%d,"predicted":"%s","predict_conf":"%s","predict_driver":"%s","local_hour":%d,"tz":"%s","surprise":"%s","surprise_detail":"%s","fresh_observed":%d,"cam_fresh":%d,"wifi_fresh":%d,"label_fresh":%d,"ts":"%s"}\n' \
    "$state" "$driver" "$seen_state" "$seen_age" "$act_verdict" "$act_age" "${lbl_state:-none}" "$lbl_age" \
    "$pred_state" "$pred_conf" "$pred_driver" "$lhour" "$BRUNO_TZ" "$surprise" "$surp_detail" "$fresh_obs" "$cam_fresh" "$wifi_fresh" "$lbl_fresh" "$ts"
else
  echo "PREDICT:  $pred_state (conf $pred_conf, $pred_driver) @ local hour $lhour [$BRUNO_TZ]"
  echo "OBSERVE:  $state   ($driver)"
  echo "SURPRISE: $surprise — $surp_detail   [$([ "$surprise" = CONFIRMED ] && echo 'mind sleeps' || echo '→ wake mind')]"
  echo "LEASES:   cam $(lease_fmt "$seen_age" "$LEASE_CAM") [fresh=$cam_fresh] | wifi $(lease_fmt "$act_age" "$LEASE_WIFI") [fresh=$wifi_fresh] | label $(lease_fmt "$lbl_age" "$LEASE_LABEL") [fresh=$lbl_fresh]"
  echo "INVARIANT: liveness-as-lease — state asserted only while a lease is FRESH; all expired → UNKNOWN + wake"
  echo "--- evidence ---"
  echo "Bruno — $state   ($driver)"
  if [ "$seen_state" = "SEEN" ]; then echo "  seen:     $(age_fmt $seen_age) ago — $seen_desc"
  elif [ "$seen_state" = "NOT-IN-FRAME" ]; then echo "  seen:     not in frame (cam live $(age_fmt $seen_age) ago)"
  else echo "  seen:     UNKNOWN (cam log cold)"; fi
  if [ "$act_verdict" != "UNKNOWN" ]; then echo "  activity: wifi $act_verdict ($(age_fmt $act_age) ago)"
  else echo "  activity: UNKNOWN (no wifi tape)"; fi
  if [ -n "$lbl_state" ]; then echo "  operator: '$lbl_raw' -> $lbl_state ($(age_fmt $lbl_age) ago)"
  else echo "  operator: no Bruno label logged"; fi
fi

# liveness-touch: mtime = ran-live (always), content = the change-gated state
# ([[reflex-cadence-prose-and-cron-glob]] / state-touch convention).
{ echo "$state|$driver|$ts"; } > "$STATE" 2>/dev/null || true
command -v mesh-state-touch >/dev/null 2>&1 && mesh-state-touch "$STATE" >/dev/null 2>&1 || touch "$STATE" 2>/dev/null || true
# wake the mind only on a surprise transition (cooldown + transition-gated; no-op under --json/--test)
maybe_poke "${1:-}"
exit 0
