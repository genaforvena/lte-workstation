#!/usr/bin/env bash
# mesh-tell — drive an agent that lives in a tmux window by sending it a prompt. THE mesh's way to
# use free inference pools: an agent's pane IS a channel; you send a command into the channel you
# watch. (Agents don't auto-pull [task] from mesh-chat — they're parked at their REPL; this pokes
# them directly.) Watch the result with: tmux capture-pane -t <win> -p
#
#   mesh-tell <window> <prompt...>                  agent in a window on THIS node
#   mesh-tell --node user@ip <window> <prompt...>   agent in a window on a remote node
#   mesh-tell --node <peername> <window> <prompt>   bare peer name, resolved via mesh-peer-addr
#   mesh-tell --peek <window> [--node user@ip]      just show the last lines of that pane
#   mesh-tell --ack <window> <prompt...>            send, then verify the pane RECEIVED it (see below)
#
# --ack (opt-in; mesh-tell-ack 2026-06-24): after the send, briefly poll the target pane and print a
# terse ACK/NO-ACK to STDERR. RECEIVED = the pane left its idle prompt OR shows an engine working
# indicator ('esc to interrupt') within MESH_TELL_ACK_TIMEOUT s (default 4). NO-ACK = still idle —
# the recurring failure mode where a multi-line paste stalls at '❯ paste again to expand' and the
# prompt strands UNSUBMITTED, so the send LOOKS fine (rc=0) but the mind never saw it. The default
# (no --ack) path is unchanged and fast — ACK never blocks the caller unless asked for.
#
# Caveats: the agent must be idle at its prompt (mid-task it may ignore input); free models vary in
# quality — give clear, bounded prompts and REVIEW their output (steward commits, agents don't).
set -uo pipefail

# capture the bottom (MIND) pane's last non-empty lines — shared by --peek and --ack (defined early
# so --test can exercise ack_probe; cap_tail's run/$paneref are resolved at CALL time, always later).
cap_tail(){ run "tmux capture-pane -t \$(hostname):$paneref -p 2>/dev/null | grep -vE '^[[:space:]]*\$' | tail -8"; }

# dead_shell_guard <win> <node> -> stdout: mesh-mind-state's evidence line (only meaningful on refusal);
# rc 0 = safe to send, rc 1 = REFUSED. (chat-review/shed-pane-dead-shell-misclassified 2026-07-07): a
# SHED/killed mind can leave its login shell attached to the pane while the frozen screen still shows
# the last mind frame — blindly send-keys'ing a prompt into it means bash EXECUTES it as a real shell
# command (dangerous, not merely "wedged"). Ask mesh-mind-state (process-truth, not pane text) before
# every send. Fail-open if mesh-mind-state is absent (never block delivery on a missing dependency);
# escape hatch MESH_TELL_ALLOW_SHELL=1 for the rare deliberate raw-shell use. Defined early (same
# reason as cap_tail/ack_probe) so --test can drive it directly.
dead_shell_guard(){
  local win="$1" node="$2" out
  [ "${MESH_TELL_ALLOW_SHELL:-0}" = 1 ] && return 0
  command -v mesh-mind-state >/dev/null 2>&1 || return 0
  if [ "$node" = local ]; then out="$(mesh-mind-state "$win" 2>/dev/null)"
  else out="$(mesh-mind-state "$win" --node "$node" 2>/dev/null)"; fi
  case "$out" in DEAD-SHELL*) printf '%s\n' "$out"; return 1 ;; esac
  return 0
}

# ack_probe <pre-send-tail> → prints RECEIVED|NOACK, rc 0|1. Bounded poll for the engine WORKING state.
# Subtlety (verified on the live claude TUI 2026-06-24): the IDLE footer PERMANENTLY shows the hint
# "· esc to interrupt · ← for agents" — so a bare "esc to interrupt" is NOT a working signal (it would
# false-ACK every claude pane, including a stalled/unsubmitted paste — the very bug we detect). The
# reliable distinguisher is the live WORKING counter: claude's working line ends "(… · esc to
# interrupt)" WITH a closing paren and carries a "Ns ·" timer / "tokens" count, none of which appear at
# idle. We deliberately do NOT treat a mere pane-change as RECEIVED: a stall (box fills with the pasted
# text / "paste again to expand") changes the pane too, and a false-RECEIVED is worse than a
# false-NOACK (it tells the dispatcher "delivered" when the prompt stranded). Conservative by design.
ACK_TIMEOUT="${MESH_TELL_ACK_TIMEOUT:-4}"
ack_probe(){
  local post i n=$(( ACK_TIMEOUT * 2 ))
  for (( i=0; i<n; i++ )); do
    sleep 0.5
    post="$(cap_tail)"
    # WORKING: a live engine counter is on screen (claude/codex/opencode). The closing paren after
    # 'esc to interrupt', a 'Ns ·' elapsed timer, or a 'tokens' count appear ONLY while generating.
    if printf '%s\n' "$post" | grep -qiE 'esc to interrupt\)|esc to stop\)|[0-9]+s ·|[0-9][0-9.]*k? tokens'; then
      echo RECEIVED; return 0
    fi
  done
  echo NOACK; return 1
}

if [ "${1:-}" = --test ]; then
  command -v tmux >/dev/null 2>&1 || { echo "smoke-test: FAIL (no tmux)"; exit 1; }
  command -v base64 >/dev/null 2>&1 || { echo "smoke-test: FAIL (no base64)"; exit 1; }
  command -v hostname >/dev/null 2>&1 || { echo "smoke-test: FAIL (no hostname)"; exit 1; }
  tmux has-session -t "$(hostname)" 2>/dev/null || { echo "smoke-test: FAIL (no tmux session for $(hostname))"; exit 1; }
  # Dry-run: verify base64 round-trip for prompt delivery (core data pipeline)
  _test_prompt="alert(\"test-émoji 🧪\") with | pipes and \$vars"
  _b64=$(printf '%s' "$_test_prompt" | base64 | tr -d '\n')
  _decoded=$(printf '%s' "$_b64" | base64 -d 2>/dev/null)
  [ "$_decoded" = "$_test_prompt" ] || { echo "smoke-test: FAIL (base64 round-trip mismatch)"; exit 1; }
  [ -z "$(printf '%s' "$_b64" | tr -d '[:graph:]')" ] || { echo "smoke-test: FAIL (base64 contains whitespace/newlines)"; exit 1; }

  # ── ACK asserts (mesh-tell-ack 2026-06-24): exercise the REAL ack_probe against a FIXTURE pane on a
  # PRIVATE tmux socket (isolated; killed at the end — never touches the node's append-only session).
  # `cat` echoes typed text via the PTY, so send-keys paints whatever pane state we want to assert on.
  # Three fixtures — the IDLE footer and the operator's STALL both read NO-ACK; only the live WORKING
  # counter reads RECEIVED (the whole point: a stall must NOT false-ACK as delivered).
  af=0
  L="mtellack$$"
  ACK_TIMEOUT=1   # keep the NO-ACK cases ~1s
  tmux -L "$L" new-session -d -s t -x 100 -y 12 cat 2>/dev/null
  tmux -L "$L" new-window  -t t -n w2 cat 2>/dev/null
  tmux -L "$L" new-window  -t t -n w3 cat 2>/dev/null
  # cap_tail override: read the fixture window selected by $PANE (the REAL ack_probe stays under test)
  cap_tail(){ tmux -L "$L" capture-pane -t "$PANE" -p 2>/dev/null | grep -vE '^[[:space:]]*$' | tail -8; }
  # fixture 1 — IDLE: the persistent claude footer hint (bare 'esc to interrupt', no counter) → NO-ACK
  PANE="t:0.0"; tmux -L "$L" send-keys -t "$PANE" '⏵⏵ auto mode on (shift+tab to cycle) · esc to interrupt · ← for agents' 2>/dev/null; sleep 0.3
  [ "$(ack_probe)" = NOACK ] || { echo "  FAIL: ack — idle footer (bare 'esc to interrupt') must read NO-ACK"; af=1; }
  # fixture 2 — WORKING: the live counter line ('(Ns · tokens · esc to interrupt)') → RECEIVED
  PANE="t:w2.0"; tmux -L "$L" send-keys -t "$PANE" '✶ Cogitating… (7s · ↑ 1.4k tokens · esc to interrupt)' 2>/dev/null; sleep 0.3
  [ "$(ack_probe)" = RECEIVED ] || { echo "  FAIL: ack — live working counter must read RECEIVED"; af=1; }
  # fixture 3 — STALL (operator's exact failure): box filled with pasted text + 'paste again to expand',
  # NO working counter → NO-ACK (must NOT false-ACK as delivered — this is the bug the task exists for)
  PANE="t:w3.0"; tmux -L "$L" send-keys -t "$PANE" '❯ run the dispatched ta… ⏎ paste again to expand' 2>/dev/null; sleep 0.3
  [ "$(ack_probe)" = NOACK ] || { echo "  FAIL: ack — a stalled/unsubmitted paste must read NO-ACK (not false-ACK)"; af=1; }
  tmux -L "$L" kill-server 2>/dev/null   # private throwaway socket — safe to kill (not the node session)
  [ "$af" = 0 ] || { echo "smoke-test: FAIL (ack_probe regressed — see asserts above)"; exit 1; }

  # ── LOAD-AWARE ACK WINDOW (chat-review/acktimeout-thermal-blind 2026-07-10): ack_probe must honor a
  # WIDENED ACK_TIMEOUT so a CPU-starved engine that paints its working footer LATE still reads RECEIVED
  # (dispatch() widens the env under measured node stress; the fixed 4s window was discarding real
  # hand-offs as false NO-ACK). Hermetic + deterministic: cap_tail reveals the live counter only on the
  # 6th poll (a footer that lands ~3s late) — poll-count-gated, not wall-clock-gated. A NARROW window
  # (ACK_TIMEOUT=2 → 4 polls) never sees it → NO-ACK; a WIDE window (ACK_TIMEOUT=6 → 12 polls) catches it
  # → RECEIVED. Falsify: hardcode n back to a fixed count and the wide case regresses to NO-ACK.
  # NB: cap_tail runs inside ack_probe's own `post="$(cap_tail)"` command substitution (a subshell), so a
  # shell-var poll counter would be discarded each call — the reveal state must live in a FILE to persist.
  lf=0; _lcnt="$(mktemp)"
  cap_tail(){ local n; n=$(( $(cat "$_lcnt" 2>/dev/null || echo 0) + 1 )); echo "$n" >"$_lcnt"; if [ "$n" -ge 6 ]; then echo '✶ Working… (9s · ↑ 2k tokens · esc to interrupt)'; else echo '⏵⏵ auto mode on (shift+tab to cycle) · esc to interrupt · ← for agents'; fi; }
  echo 0 >"$_lcnt"; ACK_TIMEOUT=2; [ "$(ack_probe)" = NOACK ]    || { echo "  FAIL: ack — narrow window (late footer) must read NO-ACK"; lf=1; }
  echo 0 >"$_lcnt"; ACK_TIMEOUT=6; [ "$(ack_probe)" = RECEIVED ] || { echo "  FAIL: ack — widened window must catch the late footer → RECEIVED"; lf=1; }
  rm -f "$_lcnt"; ACK_TIMEOUT="${MESH_TELL_ACK_TIMEOUT:-4}"   # restore default for any later use
  [ "$lf" = 0 ] || { echo "smoke-test: FAIL (load-aware ACK window regressed)"; exit 1; }

  # ── DEAD-SHELL guard (chat-review/shed-pane-dead-shell-misclassified 2026-07-07) ─────────────────
  # mesh-mind-state is stubbed as a shell function (bash resolves function names before PATH commands
  # — same convention mesh-mind-state's OWN --test uses to stub mesh-chat/mesh-trace) so this is
  # hermetic, no dependency on a live pane in either state.
  gf=0
  mesh-mind-state(){ printf 'DEAD-SHELL\tbare shell — no mind-engine process on this pane'"'"'s tty (shed/killed)\n'; return 8; }
  _g="$(dead_shell_guard fakewin local)"; _grc=$?
  [ "$_grc" -ne 0 ] || { echo "  FAIL: dead_shell_guard must refuse on DEAD-SHELL"; gf=1; }
  case "$_g" in *DEAD-SHELL*) :;; *) echo "  FAIL: guard message missing DEAD-SHELL evidence: $_g"; gf=1;; esac
  mesh-mind-state(){ printf 'IDLE\tready prompt, no turn running\n'; return 0; }
  _g2="$(dead_shell_guard fakewin local)"; _g2rc=$?
  [ "$_g2rc" -eq 0 ] || { echo "  FAIL: dead_shell_guard must allow a healthy IDLE window"; gf=1; }
  # escape hatch: MESH_TELL_ALLOW_SHELL=1 bypasses even a DEAD-SHELL verdict
  mesh-mind-state(){ printf 'DEAD-SHELL\tbare shell\n'; return 8; }
  MESH_TELL_ALLOW_SHELL=1 dead_shell_guard fakewin local >/dev/null \
    || { echo "  FAIL: MESH_TELL_ALLOW_SHELL=1 must bypass the guard"; gf=1; }
  unset -f mesh-mind-state
  [ "$gf" = 0 ] || { echo "smoke-test: FAIL (dead_shell_guard drifted)"; exit 1; }
  # end-to-end: the actual send path must refuse and exit non-zero WITHOUT ever calling tmux send-keys
  # (falsify: remove the guard call and this would instead attempt a real send into a bogus window —
  # harmless here since the window doesn't exist, but the REFUSED message + exit code prove the gate
  # fires before the send, not after a failed one).
  mesh-mind-state(){ printf 'DEAD-SHELL\tbare shell\n'; return 8; }
  export -f mesh-mind-state
  _e2e="$("$0" "mtell-dead-shell-fixture-$$" "would you like some rm -rf" 2>&1)"; _e2erc=$?
  unset -f mesh-mind-state
  case "$_e2e" in *REFUSED*) :;; *) echo "smoke-test: FAIL (end-to-end send did not refuse on DEAD-SHELL: $_e2e)"; exit 1;; esac
  [ "$_e2erc" -ne 0 ] || { echo "smoke-test: FAIL (end-to-end refused send must exit non-zero)"; exit 1; }
  echo "smoke-test: ok (base64 round-trip + 3 ack_probe asserts: idle-footer=NO-ACK, working-counter=RECEIVED, stall=NO-ACK + load-aware ACK window: narrow=NO-ACK, widened catches late footer=RECEIVED + DEAD-SHELL guard: refuses/allows/escape-hatch + end-to-end send refusal)"; exit 0
fi
node=local
ssh_port=""
peek=0
ack=0
# accept leading flags in any order (--node user@ip / --peek / --ack)
while [ $# -gt 0 ]; do
  case "${1:-}" in
    --node) node="$2"; shift 2 ;;
    --peek) peek=1; shift ;;
    --ack)  ack=1; shift ;;
    *) break ;;
  esac
done
win="${1:?usage: mesh-tell [--node user@ip] [--peek|--ack] <window> <prompt>}"; shift || true
prompt="$*"

resolve_node() {
  local name="$1"
  if [[ "$name" == *@* ]]; then
    node="$name"
    return
  fi
  local user peer_addr peer_dns
  case "$name" in
    IdeaPad) user=imozerov ;;
    ilya)    user=ilya ;;
    default-string) user=imozerov ;;
    Redmi|phone)    user=u0_a380; ssh_port=8022 ;;
    router|GL-MT3000) user=root; peer_dns=router ;;
    phaedra) user=root ;;
    *) echo "mesh-tell: unknown peer '$name' (use user@ip for direct SSH)" >&2; exit 1 ;;
  esac
  peer_dns="${peer_dns:-$name}"
  local pa_bin
  pa_bin=$(command -v mesh-peer-addr 2>/dev/null) || pa_bin="$(dirname "$0")/mesh-peer-addr"
  peer_addr=$("$pa_bin" "$peer_dns") || { echo "mesh-tell: mesh-peer-addr failed for '$peer_dns'" >&2; exit 1; }
  node="$user@$peer_addr"
}

[ "$node" != local ] && resolve_node "$node"

run(){ # run a tmux command on the target node
  if [ "$node" = local ]; then bash -c "$1"
  else ssh -o BatchMode=yes -o ConnectTimeout=8 ${ssh_port:+-p "$ssh_port"} "$node" "$1"
  fi
}

# CHANNEL convention: top=DATA (refreshing), bottom=MIND. Drive the BOTTOM pane (largest pane_top) so
# prompts/peeks reach the MIND, never the data pane (sending to the active/data pane was why minds
# silently stopped getting fed — and a refreshing data pane also reads as always-busy to idle checks).
pidx=$(run "tmux list-panes -t \$(hostname):$win -F '#{pane_top} #{pane_index}' 2>/dev/null | sort -n | tail -1 | awk '{print \$2}'")
paneref="$win${pidx:+.$pidx}"

if [ "$peek" = 1 ]; then
  run "tmux capture-pane -t \$(hostname):$paneref -p 2>/dev/null | grep -vE '^[[:space:]]*\$' | tail -15"
  exit 0
fi
[ -n "${prompt// /}" ] || { echo "mesh-tell: empty prompt" >&2; exit 1; }
_dsg_out="$(dead_shell_guard "$win" "$node")" || { echo "mesh-tell: REFUSED — $win @ $node is a bare shell (no mind engine), not a mind prompt: $_dsg_out" >&2; exit 1; }
# the tick sequence — C-u clear stale input, BRACKETED paste, settle, C-m submit (same keys
# mesh-tick presses). Bracketed paste (paste-buffer -p) not send-keys -l: codex's paste-burst
# detector eats a C-m that lands 0.3s after a long key-burst (prompt strands UNSUBMITTED in the
# composer, ticks concatenate — 2026-06-13 window-12 pileup); the bracket close ends the burst
# deterministically. tmux adds brackets only for apps that requested them — plain shells unaffected.
b64=$(printf '%s' "$prompt" | base64 | tr -d '\n')
if run "tmux send-keys -t \$(hostname):$paneref C-u; sleep 0.1; echo $b64 | base64 -d | tmux load-buffer -b mtell\$\$ -; tmux paste-buffer -p -d -b mtell\$\$ -t \$(hostname):$paneref; sleep 0.5; tmux send-keys -t \$(hostname):$paneref C-m"; then
  echo "[told $win @ $node]: ${prompt:0:70}..."
  if [ "$ack" = 1 ]; then
    if [ "$(ack_probe)" = RECEIVED ]; then
      echo "[ack $win @ $node]: RECEIVED — pane left idle / working within ${ACK_TIMEOUT}s" >&2
    else
      echo "[ack $win @ $node]: NO-ACK — pane still idle after ${ACK_TIMEOUT}s; prompt may be UNSUBMITTED (re-peek; multi-line paste-burst stall?)" >&2
    fi
  fi
fi
