#!/usr/bin/env bash
# mesh-tell — drive an agent that lives in a tmux window by sending it a prompt. THE mesh's way to
# use free inference pools: an agent's pane IS a channel; you send a command into the channel you
# watch. (Agents don't auto-pull [task] from mesh-chat — they're parked at their REPL; this pokes
# them directly.) Watch the result with: tmux capture-pane -t <win> -p
#
#   mesh-tell <window> <prompt...>                  agent in a window on THIS node
#   mesh-tell --node user@ip <window> <prompt...>   agent in a window on a remote node
#   mesh-tell --node <peername> <window> <prompt>   bare peer name, resolved via mesh-peer-addr
#   mesh-tell --peek <window> [--node user@ip]      just show the last lines of that pane
#   mesh-tell --ack <window> <prompt...>            send, then verify the pane RECEIVED it (see below)
#   mesh-tell --fresh <window> <prompt...>          park work + gated /clear FIRST, then send verbatim
#   mesh-tell --origin <window> <prompt...>         ORIGIN DISCLOSURE: stamp the prompt with who is
#                                                   driving this mind, so the addressee can weigh the
#                                                   instruction by its source instead of reading every
#                                                   injection with operator authority. Same-line, never
#                                                   a leading newline. Opt-in (MESH_TELL_ORIGIN=1),
#                                                   default OFF; skips slash-commands and ALLOW_SHELL.
#   mesh-tell --replay [-n N] [<window>]            audit-replay the injection log (display-only):
#                                                   every send journals intent BEFORE acting + outcome
#                                                   after (write-ahead) to ~/.mesh/tell-wal.log; a
#                                                   dangling intent renders UNRESOLVED (crashed send)
#   mesh-tell --pane-snapshot <window>|- [chars]   render the NO-ACK evidence snapshot for a pane
#                                                   (or for a capture on stdin) and exit. Display-
#                                                   only seam, so the evidence builder can be
#                                                   driven over a REAL capture in a test.
#   mesh-tell --pressure [<window>]                 ARRIVAL PRESSURE (report-only): per-window
#                                                   inter-arrival rate over the same log — how often
#                                                   each mind is poked, vs a CITED human reference
#                                                   interval. Never gates a send; see the block above
#                                                   wal_pressure for what it does and does not claim.
#   MESH_TELL_WAL_LEVEL=full|redact|minimal|off     how much of a send the WAL keeps (env, or
#                                                   MESH_TELL_WAL_LEVEL= in ~/.mesh/nodes; env wins;
#                                                   default full = today's record). redact keeps the
#                                                   record + a reproducible payload digest, minimal
#                                                   keeps the record alone, off keeps nothing and
#                                                   gives up the write-ahead guarantee. A level
#                                                   CHANGE is journalled in the log itself.
#
# --ack (opt-in; mesh-tell-ack 2026-06-24): after the send, briefly poll the target pane and print a
# terse ACK/NO-ACK to STDERR. RECEIVED = an engine WORKING counter appears within
# MESH_TELL_ACK_TIMEOUT s (default 4), OR — when the counter never paints — the pane CHANGED vs the
# pre-send tail while the composer is empty with no stall marker (submitted, late paint;
# chat-review/ack-noack-is-an-absence-verdict 2026-07-16). NO-ACK = composer still holds our text /
# stall marker / pane unchanged — the failure mode where a multi-line paste stalls at '❯ paste again
# to expand' and the prompt strands UNSUBMITTED, so the send LOOKS fine (rc=0) but the mind never saw
# it; the NO-ACK line carries a flattened pane-tail snapshot as evidence. The default (no --ack) path
# is unchanged and fast — ACK never blocks the caller unless asked for.
#
# --fresh (opt-in; 2026-07-24): wip-commit → gated /clear → wait for the pane to come back → send the
# prompt VERBATIM. For the nudge that OPENS a claim, so the claim is staked from a freshly-/clear-ed
# context (CLAUDE.md: "a claim must come from a freshly /clear-ed mind" — a commitment made from a
# session that has drifted for hours risks being mis-scoped or half-remembered).
#
# It is deliberately NOT the default, and must not become one. mesh-tell is ALSO the self-continuation
# primitive and the tick/keepalive path: clearing on every nudge would drop mid-task working state on
# a cadence, and the handoff only carries what got WRITTEN — the auto-snapshot is explicitly partial.
# The operator rule is about CLAIMS, not about nudges. Wire it into dispatch; leave continuations,
# heartbeats and task-loop wakeups alone.
#
# THE PROMPT IS NEVER DROPPED. mesh-clear is fail-safe-BLOCK by design (it over-blocks ~43% permitted
# on covered clears), so a --fresh that swallowed the nudge on a block would lose the majority of
# dispatches. A block downgrades to a plain send + a LOUD stderr line — never a silent skip, never a
# lost prompt. Same for a remote --node (mesh-clear is node-local): honest n/a, then send.
#
# ORDERING IS LOAD-BEARING. After the /clear the engine restarts the session and the SessionStart hook
# re-injects the handoff; pasting into that window strands the prompt in a composer that is being torn
# down. --fresh waits for the pane to stop WORKING (bounded, MESH_TELL_FRESH_READY_SECS) before the
# send, and never a blind sleep.
#
# Caveats: the agent must be idle at its prompt (mid-task it may ignore input); free models vary in
# quality — give clear, bounded prompts and REVIEW their output (steward commits, agents don't).
set -uo pipefail
# ── --help guard (pub/argv-is-payload-tools-fire-on-help, 2026-07-15) ──────────────────────────────
# argv IS this tool's payload, so the universal discovery gesture WAS the action: `--help` sent the
# literal string '--help' down the send path. Proven live on the operator at 03:18Z (mesh-tg-update
# --help mailed him a commit digest; mesh-tg --help texted him '--help'). The safe way to ask what a
# thing does must not BE the thing — so this comes FIRST, before any dispatch, sandbox gate or config
# read. usage() renders this file's own header block, so it can never drift from the docs above.
usage(){ sed -n '2,/^[^#]/p' "$0" | sed -n 's/^# \?//p'; }
case "${1:-}" in -h|--help) usage; exit 0 ;; esac


# capture the bottom (MIND) pane's last non-empty lines — shared by --peek and --ack (defined early
# so --test can exercise ack_probe; cap_tail's run/$paneref are resolved at CALL time, always later).
cap_tail(){ run "tmux capture-pane -t \$(hostname):$paneref -p 2>/dev/null | grep -vE '^[[:space:]]*\$' | tail -8"; }

# cap_full — the WHOLE bottom pane, blanks and borders included. cap_tail's "non-blank, bottom 8" view
# is the ACK HEURISTIC's window (it only has to find a working counter or a composer marker); an
# EVIDENCE snapshot needs the raw frame, because the composer's position is defined by the box drawn
# around it and by the blank lines cap_tail throws away.
cap_full(){ run "tmux capture-pane -t \$(hostname):$paneref -p 2>/dev/null"; }

# ── NO-ACK evidence snapshot (chat-review/noack-pane-tail-selects-the-tui-footer-and-cuts-by-bytes) ──
# compose_snapshot [<maxchars>] — stdin: a raw pane capture · stdout: ONE flattened evidence line.
#
# The first version of this was `cap_tail | tail -3 | tr '\n' '¦' | tail -c 120` and it carried
# NOTHING. Two independent defects, both measured on the live board (12 [dispatch-noack] lines:
# 9 rendered an EMPTY pane-tail, the other 3 only status-bar fragments like 'nome | ▌…'):
#   (1) `tail -3` selects the engine's bottom CHROME — status bar, permissions hint, update banner,
#       the right-aligned mode indicator — never the composer. The composer is NOT the last thing on
#       screen in any modern TUI; it sits in a box ABOVE four lines of furniture.
#   (2) `tail -c` then spends its budget from the END, and those chrome lines are RIGHT-ALIGNED, so
#       the budget is eaten by their leading alignment PADDING. A byte cut is also wrong on a pane
#       full of box-drawing and CJK-width glyphs: 120 bytes is ~40 characters of ❯/─/✶.
# So: select the composer REGION by its own marker, drop the borders and the chrome, squeeze space
# runs, and cut by CHARACTERS. It NEVER returns whitespace — an empty composer is real evidence but
# useless alone, so it renders as such AND carries the last transcript line above the box, which is
# what actually says what the mind was doing when the prompt failed to land.
#
# Locale: character semantics need a UTF-8 locale, and cron has none. The locale is PROBED (does awk
# see "é" as one unit?) rather than assumed; on a node with no UTF-8 locale the cut falls back to
# bytes and backs off over any trailing continuation byte, so the output is always valid UTF-8.
compose_snapshot(){
  local max="${1:-120}" lc chars=0
  for lc in "${LC_ALL:-}" "${LANG:-}" C.UTF-8 en_US.UTF-8; do
    [ -n "$lc" ] || continue
    if [ "$(LC_ALL="$lc" awk 'BEGIN{print length("é")}' 2>/dev/null)" = 1 ]; then chars=1; break; fi
  done
  [ "$chars" = 1 ] || lc=C
  LC_ALL="$lc" awk -v max="$max" -v chars="$chars" -v nbsp="$(printf ' ')" '
    BEGIN{ CLO=sprintf("%c",128); CHI=sprintf("%c",191); if(max+0<20) max=20 }
    # NBSP is what claude pads its composer marker with, and glibc does not classify it as space —
    # left alone it makes an EMPTY composer read as "holds text".
    function sq(s){ gsub(nbsp," ",s); gsub(/[[:space:]]+/," ",s); sub(/^ /,"",s); sub(/ $/,"",s); return s }
    function blank(s,  t){ t=s; gsub(nbsp,"",t); gsub(/[[:space:]]/,"",t); return (t=="") }
    function border(s,  t){ t=s; gsub(/─|━|═|╌|┄|┈|╭|╮|╰|╯|│/,"",t); gsub(nbsp,"",t); gsub(/[[:space:]]/,"",t);
                            return (t=="" && s ~ /─|━|═/) }
    function trunc(s,  t,c){
      if(length(s)<=max) return s
      t=substr(s,1,max)
      if(!chars){   # byte locale: the cut may land inside a character — back off to a lead byte
        c=substr(s,max+1,1)
        if(c>=CLO && c<=CHI)
          while(length(t)>0){ c=substr(t,length(t),1); t=substr(t,1,length(t)-1); if(!(c>=CLO&&c<=CHI)) break }
      }
      return t "…"
    }
    { raw[NR]=$0 }
    END{
      n=NR; comp=0
      # the composer marker line: FIRST glyph on the line is a prompt marker. Anchored at the start on
      # purpose — ▌ and › also occur INSIDE the status bar ("⧉ genome | ▌░░░ 194k/1M"), which is
      # exactly the fragment the old byte-cut used to ship as evidence.
      for(i=n;i>=1;i--) if(raw[i] ~ /^[[:space:]]*(❯|›|>)/ && raw[i] !~ /─|━|═/){ comp=i; break }
      out=""
      if(comp>0){
        reg=""
        for(i=comp;i<=n;i++){ if(border(raw[i])||blank(raw[i])) break; reg=reg " " raw[i] }
        body=reg; gsub(/❯|›|>/,"",body)
        if(blank(body)){
          tr=""
          for(i=comp-1;i>=1;i--){ if(blank(raw[i])||border(raw[i])) continue; tr=raw[i]; break }
          out="❯(empty) <- " (tr==""?"(no transcript)":sq(tr))
        } else out=sq(reg)
      } else {
        # no composer marker at all (a bare shell, or an engine that draws none): fall back to the last
        # three lines that carry SOMETHING — borders and blanks excluded, so the budget still buys text.
        c=0
        for(i=n;i>=1&&c<3;i--){ if(blank(raw[i])||border(raw[i])) continue; out=sq(raw[i]) (out==""?"":" ¦ " out); c++ }
      }
      if(blank(out)) out="(pane blank)"
      print trunc(out)
    }'
}

# shed_cooldown <win> <node> -> prints resume_epoch if SHED cooldown active, rc 0; else rc 1.
# Source-coupled to channel-keepalive:525 ($HOME/.mesh/.rl-cooldown-<win> = "<resume_epoch>|<qc>"),
# the writer's own state file. Reading the STATE FILE (not the pane banner) is the authoritative
# shed gate: the visible banner channel-keepalive:597 also writes scrolls off the instant anything
# touches the bare shell — chat-review/shed-pane-consumed-while-paused (minds 2026-07-19 10:33) — a
# dispatcher's consume-prompt fell into the shed pane's bare shell, bash ran it as a command, syntax-
# errors pushed the banner out of mesh-mind-state's bottom-8 window, the pane read DEAD-SHELL again
# (defeating the f70b154 banner-grep). The rlmark can't scroll off; it's the writer's truth. Fail-
# open on absent/unreadable/malformed mark (a missing mark = no shed = send proceeds; never block
# delivery on a missing state file). Overridable as a shell function in --test (same convention as
# mesh-mind-state's stubs) for hermetic exercise.
shed_cooldown(){
  local win="$1" node="$2"
  local mark='$HOME/.mesh/.rl-cooldown-'"$1"
  local cmd='[ -f "'"$mark"'" ] || exit 1; r="$(cut -d"|" -f1 "'"$mark"'" 2>/dev/null)"; case "$r" in ""|*[!0-9]*) exit 1 ;; esac; [ "$(date +%s)" -lt "$r" ] && echo "$r"'
  if [ "$node" = local ]; then bash -c "$cmd"
  else ssh -o BatchMode=yes -o ConnectTimeout=8 "$node" "$cmd" 2>/dev/null; fi
}

# dead_shell_guard <win> <node> -> stdout: evidence line (only meaningful on refusal);
# rc 0 = safe to send, rc 1 = REFUSED. (chat-review/shed-pane-dead-shell-misclassified 2026-07-07): a
# SHED/killed mind can leave its login shell attached to the pane while the frozen screen still shows
# the last mind frame — blindly send-keys'ing a prompt into it means bash EXECUTES it as a real shell
# command (dangerous, not merely "wedged"). Ask mesh-mind-state (process-truth, not pane text) before
# every send. Fail-open if mesh-mind-state is absent (never block delivery on a missing dependency);
# escape hatch MESH_TELL_ALLOW_SHELL=1 for the rare deliberate raw-shell use. Defined early (same
# reason as cap_tail/ack_probe) so --test can drive it directly.
dead_shell_guard(){
  local win="$1" node="$2" out _resume _hm
  [ "${MESH_TELL_ALLOW_SHELL:-0}" = 1 ] && return 0
  # SHED-cooldown gate (chat-review/shed-pane-consumed-while-paused, minds 2026-07-19 10:33): a SHED
  # pane IS a bare shell (channel-keepalive killed the engine) — typing a consume-prompt into it makes
  # bash execute it as a shell command, syntax-errors scroll the SHED banner off, mesh-mind-state's
  # banner-grep then misreads DEAD-SHELL (defeating the f70b154 fix that minds 09:31 asked for).
  # Source-coupled to channel-keepalive's rlmark (the writer's state file, not the visible banner) so
  # the gate survives pane churn — the rlmark can't scroll off. Escape hatch MESH_TELL_ALLOW_SHED=1
  # for the rare deliberate send into a shed pane (e.g. manual unshed/recover).
  if [ "${MESH_TELL_ALLOW_SHED:-0}" != 1 ] && _resume="$(shed_cooldown "$win" "$node")" && [ -n "$_resume" ]; then
    _hm="$(date -u -d "@$_resume" '+%H:%MZ' 2>/dev/null || echo '?')"
    printf 'SHED\trate-limit cooldown active until %s — engine killed by channel-keepalive, typing would execute as shell\n' "$_hm"
    return 1
  fi
  command -v mesh-mind-state >/dev/null 2>&1 || return 0
  if [ "$node" = local ]; then out="$(mesh-mind-state "$win" 2>/dev/null)"
  else out="$(mesh-mind-state "$win" --node "$node" 2>/dev/null)"; fi
  # AUTH-DEAD (chat-review/mindstate-loggedout-not-idle) refused too: a LOGGED-OUT pane can't submit a
  # prompt any more than a bare shell can act on one — send-keys'ing into it black-holes (the prompt
  # sits unsubmitted, and could auto-fire once a human re-logs in). Same REFUSE + same escape hatch.
  # RATE-LIMITED also refused (defense-in-depth with the rlmark gate above): catches the case where
  # the rlmark is absent/corrupted/deleted but mesh-mind-state's f70b154 banner-grep still resolves
  # the shed — either gate alone is correct, both together cover each other's gap.
  case "$out" in DEAD-SHELL*|AUTH-DEAD*|RATE-LIMITED*) printf '%s\n' "$out"; return 1 ;; esac
  return 0
}

# ack_probe <pre-send-tail> → prints RECEIVED|NOACK, rc 0|1. Bounded poll for the engine WORKING state.
# Subtlety (verified on the live claude TUI 2026-06-24): the IDLE footer PERMANENTLY shows the hint
# "· esc to interrupt · ← for agents" — so a bare "esc to interrupt" is NOT a working signal (it would
# false-ACK every claude pane, including a stalled/unsubmitted paste — the very bug we detect). The
# reliable distinguisher is the live WORKING counter: claude's working line ends "(… · esc to
# interrupt)" WITH a closing paren and carries a "Ns ·" timer / "tokens" count, none of which appear at
# idle. A mere pane-change alone is still NOT RECEIVED — a stall (box fills with the pasted text /
# "paste again to expand") changes the pane too. But absence-of-counter alone is not NOACK either
# (chat-review/ack-noack-is-an-absence-verdict 2026-07-16: both live [dispatch-noack] "did NOT submit"
# verdicts were FALSE — the prompt had submitted, the counter just painted late/off the 8-line tail).
# After the counter poll times out, arbitrate by the POSITIVE composer evidence vs the pre-send tail:
# pane changed + composer empty + no stall marker can ONLY mean "submitted, late paint" → RECEIVED;
# text held / stall marker = genuinely stranded → NOACK; pane unchanged / no pre-tail given → NOACK
# (conservative default preserved for callers with no pre-send evidence).
# engine_working — reads a pane tail on stdin; rc 0 if it shows an engine MID-TURN. ONE function,
# because this predicate decides two different things (does an ack count as delivered, does a composer
# count as stranded) and it lived as two private copies of one regex; a fix applied to one copy leaves
# the other blind, and both read green.
#
# WHAT IT MUST NOT MATCH: the COMPLETION line. Claude prints a "… for 2m 21s · done 7:51 AM" line the
# moment a turn ENDS, and the old expression carried a bare seconds-middot alternation that this line
# satisfies — so the guard answered "working" at exactly the instant the engine became free. The
# consequence was measured on this node 2026-08-29: --composer printed the held text in its own
# snapshot column while returning CLEAR, and mesh-channel-keepalive's sweep logged held=0 on every
# pass while strands stood. A mind carries a completion line from the end of one turn until the start
# of the next, so the held counter was structurally zero for the whole node.
# THE DISCRIMINATOR IS THE WORD, NOT THE DURATION: a working line carries the interrupt/stop hint with
# its closing paren, or a live token counter. A finished one carries the same seconds and no hint.
engine_working(){
  grep -qiE 'esc to interrupt\)|esc to stop\)|[0-9][0-9.]*k? tokens'
}

ACK_TIMEOUT="${MESH_TELL_ACK_TIMEOUT:-4}"
ack_probe(){
  local pre="${1:-}" post="" i n=$(( ACK_TIMEOUT * 2 ))
  for (( i=0; i<n; i++ )); do
    sleep 0.5
    post="$(cap_tail)"
    # WORKING: a live engine counter is on screen (claude/codex/opencode). The closing paren after
    # 'esc to interrupt', a 'Ns ·' elapsed timer, or a 'tokens' count appear ONLY while generating.
    if printf '%s\n' "$post" | engine_working; then
      echo RECEIVED; return 0
    fi
  done
  if [ -n "$pre" ] && [ "$post" != "$pre" ] && ! composer_holds_text; then
    echo RECEIVED; return 0
  fi
  echo NOACK; return 1
}

# composer_holds_text → rc 0 if the bottom pane's composer STILL carries our just-sent prompt (a
# stranded/unsubmitted paste), rc 1 otherwise. This is the cheap always-on stall guard: after a clean
# submit the composer marker line is EMPTY (the text moved up into the transcript) and/or the engine
# shows its WORKING counter; a stall leaves the pasted text sitting on the '❯' line (often with
# claude's 'paste again to expand' hint). Conservative & no-double-submit BY CONSTRUCTION: we return
# HOLDS only when the composer is non-empty AND the engine is NOT working — a state that can ONLY mean
# "not submitted", so a re-fired C-m can never duplicate an already-delivered prompt. Reuses cap_tail
# (resolved at CALL time, like ack_probe) so --test can drive it against fixtures.
composer_holds_text(){
  # $1 = a pane capture to judge (optional). ladder_settle captures ONCE per poll and hands the SAME
  # frame to this predicate and to its own quiescence compare; two captures a poll apart would let a
  # repaint slip between them and make the two answers be about two different panes. `${1-...}` and
  # not `${1:-...}`: an explicitly EMPTY capture is a real (blind) frame, not a request to re-capture.
  local t; t="${1-$(cap_tail)}"
  # engine WORKING → it was submitted; never re-fire (guards the no-double-submit invariant)
  printf '%s\n' "$t" | engine_working && return 1
  # THE COMPOSER IS THE **LAST** MARKER LINE, AND ONLY THAT LINE (chat-review/a-stranded-composer-
  # outlives-every-ladder-that-would-clear-it). The old expression scanned the whole 8-line tail for
  # ANY '❯ <text>', which is not the composer: claude ECHOES every submitted prompt back into the
  # transcript with the same marker, so a window that had ever run '/clear' matched forever. Measured
  # live 2026-08-29 on tg — composer '❯<NBSP>' (empty), transcript two lines above '❯ /clear' — HOLDS,
  # falsely. In the send path that only cost a stray C-m; under the PERIODIC sweep this predicate now
  # feeds it would have re-driven a healthy idle mind every pass, forever.
  # Same selection rule compose_snapshot already uses: scan UP for the first marker-initial line, and
  # anchor it — '▌' and '›' also occur mid-line in the status bar ('⧉ genome | ▌░░░ 194k/1M').
  # NBSP is what claude pads an EMPTY composer marker with and glibc does not classify it as space,
  # so it is stripped explicitly or every empty composer reads as held.
  _cl="$(printf '%s\n' "$t" | grep -nE '^[[:space:]]*[❯›▌]' | tail -1 | cut -d: -f1)"
  if [ -n "$_cl" ]; then
    _cb="$(printf '%s\n' "$t" | sed -n "${_cl}p" | sed 's/^[[:space:]]*[❯›▌]//' | tr -d '\302\240' | tr -d '[:space:]')"
    # claude's own composer PLACEHOLDER chrome is not held text — it is what an EMPTY composer says
    # when messages are queued (measured on vpn the same hour). One named string, not a growing
    # allowlist: anything unrecognised still reads as held, so this cannot fail toward silence.
    case "$(printf '%s\n' "$t" | sed -n "${_cl}p")" in *'Press up to edit queued messages'*) _cb="" ;; esac
    [ -n "$_cb" ] && return 0
    # THE COMPOSER LINE IS THE VERDICT, AND THE HINT SLOT BELOW THE BOX IS NOT PART OF IT
    # (chat-review/tell-ladder-settle-is-shorter-than-a-paste-accept, second and OPERATIVE root cause).
    # 'paste again to expand' is claude's collapsed-paste hint and it is FOOTER CHROME: it is painted
    # in the bottom hint slot — the line that normally reads '⏵⏵ bypass permissions on …' — two lines
    # BELOW the composer's closing border, and it STAYS there after the paste has been accepted and
    # the composer has gone empty. The old scan asked the whole 8-line tail for that string, so once
    # a mind had been sent one collapsed paste this predicate answered HOLDS for every later frame
    # whatever the composer said. MEASURED on discover 2026-08-29T10:55Z, two frames 1s apart whose
    # last six non-blank lines differ in ONE line: both carry composer '❯ ' (empty) and border, and
    # only the hint slot swaps '⏵⏵ bypass permissions on (shift+tab to cycle)' → 'paste again to
    # expand'. Old predicate: CLEAR then HOLDS. That is why the bounded ladder_settle above did not
    # save the live path either — a wait on an observable cannot help when the observable is sticky:
    # the pane came to REST holding nothing, ladder_settle returned SETTLED-HELD, all three rungs
    # fired into an already-consumed composer and the run ended STRANDED on a delivered prompt. The
    # target mind answered '(2nd delivery)' in the same drive, so the duplication cost is real.
    # So: with a composer marker found and its line empty, the composer holds NOTHING and the footer
    # cannot overrule it. No second hint check is needed here and none is written: a hint rendered ON
    # the composer line is TEXT on that line, so it already made _cb non-empty and returned HOLDS two
    # lines up. A branch for it would be unreachable — and an unreachable branch is a gate arm that
    # can never go red ([[a-green-mutant-means-the-experiment-never-ran]]).
    return 1
  fi
  # NO composer marker anywhere in the tail — an unreadable or unknown layout, not an empty composer.
  # Here the whole-tail hint scan is kept exactly as it was: with nothing better to read, a collapsed
  # paste hint is still the only evidence available, and the conservative direction is HOLDS.
  printf '%s\n' "$t" | grep -qiE 'paste again to expand|paste to expand' && return 0
  return 1
}

# composer_state — the --composer verdict as ONE function, so the flag's dispatch is a single call and
# the gate can drive the SAME code the flag runs. Contract (see the --composer block below for why):
#   stdout "<VERDICT>\t<snapshot>" · rc 3 HOLDS · rc 0 CLEAR · rc 2 BLIND.
# Reads cap_full/composer_holds_text at CALL time (the file's standing convention) so --test can point
# them at a fixture pane without the verdict logic itself being re-implemented anywhere.
composer_state(){
  local raw snap
  raw="$(cap_full)"
  # BLIND is a THIRD outcome, never folded into CLEAR: an unreadable pane is not evidence that a
  # strand ended, and a sweep that clears its streak on a blind read launders every strand through
  # one bad capture ([[a-collapsed-reason-makes-blind-and-quiet-identical]]).
  if [ -z "${raw//[[:space:]]/}" ]; then
    printf 'BLIND\t(pane unreadable: %s @ %s)\n' "${paneref:-?}" "${node:-?}"; return 2
  fi
  snap="$(printf '%s\n' "$raw" | compose_snapshot "${MESH_TELL_COMPOSER_CHARS:-160}")"
  if composer_holds_text; then printf 'HOLDS\t%s\n' "$snap"; return 3
  else                         printf 'CLEAR\t%s\n' "$snap"; return 0
  fi
}

# ── ladder_settle — THE BOUNDED WAIT ON AN OBSERVABLE THAT EACH RUNG IS JUDGED AFTER ────────────────
# This used to be `sleep 0.4`, and that constant is the whole of chat-review/tell-ladder-settle-is-
# shorter-than-a-paste-accept. MEASURED END TO END 2026-08-29T09:57Z, witness → health, a ~1500-char
# prompt: tell-wal.log carries ONE intent (09:57:36Z) and ONE sent (09:57:38Z), so the entire
# three-rung ladder ran inside 2 seconds; stdout printed re-fire2, then re-fire3, then STRANDED. The
# pane 25s later held EXACTLY ONE copy of the message under '❯ Press up to edit queued messages', and
# health was working on it 45s later. The prompt was DELIVERED, exactly once, and the terminal verdict
# was FALSE — and STRANDED is the one verdict callers trust to mean not-delivered, so a caller acting
# on it re-sends and duplicates work into a mind that already holds the prompt queued.
#
# composer_holds_text was NOT wrong. During those 400ms the composer genuinely still held the pasted
# text; the predicate answered correctly about a state that is merely TRANSIENT. The ladder was asking
# a SETTLED question of an UNSETTLED pane. Nor could the queued-placeholder branch inside
# composer_holds_text save it — that branch renders exactly this composer empty, but the placeholder is
# painted only AFTER the engine accepts the paste, i.e. after a 0.4s ladder has already given up. On
# the live path it is unreachable; only its FIXTURE arm, where the placeholder is ALREADY painted, ever
# reaches it. [[a-fixture-driven-gate-cannot-cover-the-live-path]], exactly.
#
# So the wait is on OBSERVABLES with a cap, never on a constant, and it returns THREE outcomes because
# there are three states and the middle one has no verdict to give:
#   rc 0  DELIVERED     — the composer stopped holding text: a working counter painted, the composer
#                         went empty, or the queued placeholder appeared. Definitive; the ladder ends.
#   rc 3  SETTLED-HELD  — the pane STOPPED CHANGING while the composer still holds text. Only here is
#                         "still holds the ORIGINAL text" a claim about the PANE rather than about our
#                         own impatience: a rung may fire, and past the last rung it is STRANDED.
#   rc 1  UNSETTLED     — the cap elapsed with the pane still repainting. We do not know, and
#                         rendering not-knowing as STRANDED is the defect being fixed. Never terminal.
# Quiescence needs MESH_TELL_LADDER_STABLE consecutive unchanged frames (default 2), not one: a single
# 250ms still frame occurs mid-ingest on a big paste, and treating it as settled re-fires a C-m into a
# composer the engine is about to consume — the escalation that made the measured incident noisy.
# MESH_TELL_LADDER_SETTLE is now the POLL INTERVAL (it was the entire fixed settle) and
# MESH_TELL_LADDER_SETTLE_MAX the cap. Interval 0 collapses to a single poll with the stable
# requirement clamped to it — that is how the gate drives the ladder without paying wall-clock, and it
# is why the gate must stub cap_tail/cap_full as well as run().
ladder_settle(){
  local iv="${MESH_TELL_LADDER_SETTLE:-0.25}" cap="${MESH_TELL_LADDER_SETTLE_MAX:-8}"
  local n i prev cur stable=0 req="${MESH_TELL_LADDER_STABLE:-2}"
  n="$(awk -v c="$cap" -v v="$iv" 'BEGIN{ if(v+0<=0){print 1;exit} n=int(c/v+0.5); if(n<2)n=2; if(n>400)n=400; print n }')"
  [ "$req" -gt "$n" ] && req="$n"
  prev="$(cap_tail)"
  for (( i=0; i<n; i++ )); do
    sleep "$iv"
    cur="$(cap_tail)"
    # ONE frame answers both questions. Ask the predicate about the SAME capture the quiescence
    # compare uses — two captures a poll apart let a repaint slip between them, and the two answers
    # would then be about two different panes.
    composer_holds_text "$cur" || return 0
    if [ "$cur" = "$prev" ]; then
      stable=$((stable+1)); [ "$stable" -ge "$req" ] && return 3
    else
      stable=0; prev="$cur"
    fi
  done
  return 1
}

# ── stall_ladder — THE THREE-RUNG RE-FIRE, AS A FUNCTION (chat-review/a-stranded-composer-outlives-
# every-ladder-that-would-clear-it). It used to be inline in the send path, which made it unreachable
# to --test: every gate could only re-implement the decision by hand beside it, and a rung deleted from
# the real path would still pass ([[testing-the-parts-is-not-testing-the-wiring]]). As a function the
# suite drives THIS code with run()/composer_holds_text overridden, so rung ORDER, the guard on each
# rung, and the final STRANDED line are all falsifiable. Uses the send path's own $win/$node/$paneref/
# $b64 — same variables, same bytes, no second copy of the key sequence anywhere.
# EVERY rung is now guarded by ladder_settle (above), never by a fixed sleep, and its three-way rc is
# what the case below dispatches on.
stall_ladder(){
  local _st rung=0 _snap
  while :; do
    ladder_settle; _st=$?
    # DELIVERED — the engine took the paste. Nothing to heal, nothing to announce.
    [ "$_st" = 0 ] && return 0
    if [ "$_st" = 1 ]; then
      # UNSETTLED. We do NOT escalate and we do NOT declare. Escalating into a pane that is actively
      # repainting is precisely how the measured incident re-pasted into an already-consumed composer,
      # and a strand claim here would be the false verdict this whole block exists to stop being. The
      # backstop is unchanged and named on purpose: mesh-channel-keepalive's periodic --composer sweep
      # re-examines the pane long after this process is gone, with the pane finally at rest.
      echo "[UNSETTLED $win @ $node]: composer still non-empty after ${MESH_TELL_LADDER_SETTLE_MAX:-8}s, but the pane never stopped repainting — the engine is still ingesting, so this is NOT a strand verdict and no rung was fired (rung $rung); the --composer sweep re-checks it at rest" >&2
      return 0
    fi
    # rc 3 — SETTLED and still HELD. The pane is at rest holding text: a rung is warranted.
    case "$rung" in
      # ── STALL RE-FIRE (chat-review/meshtell-no-resubmit-on-stall): the bracketed-paste + C-m usually
      # submits, but a multi-line paste occasionally strands in the composer ('paste again to expand' /
      # text left on the ❯ line) and the mind then silently stops (blank prompt = dead mind). One cheap
      # always-on check: if the composer STILL holds our text and the engine is NOT working, re-fire a
      # single C-m. Safe: we C-u-cleared then pasted OUR text (held text is ours), the dead_shell_guard
      # above already proved this is a real mind composer (not a bare shell), and composer_holds_text is
      # false the instant a real submit lands → can't double-submit.
      0) run "tmux send-keys -t \$(hostname):$paneref C-m"
         echo "[re-fire $win @ $node]: composer held text after submit — re-sent one C-m (paste-burst stall)" >&2 ;;
      # ESCALATION (meshtell-copymode-wedge-guard): if the composer STILL holds our text after the C-m,
      # the pane is likely wedged in copy-mode (the C-m was EATEN, not a paste-burst). One bounded round:
      # cancel the mode, C-u-clear the stranded text, re-paste, C-m. Safe by the same invariant as the
      # C-m re-fire — composer_holds_text guards it, we C-u+re-paste OUR own text, and it goes false the
      # instant a real submit lands, so no double-submit. cancel FIRST so the C-u/paste/C-m that follow
      # reach the composer instead of the copy-mode cursor.
      1) run "tmux send-keys -t \$(hostname):$paneref -X cancel 2>/dev/null; tmux send-keys -t \$(hostname):$paneref C-u; sleep 0.1; echo $b64 | base64 -d | tmux load-buffer -b mtell\$\$ -; tmux paste-buffer -p -d -b mtell\$\$ -t \$(hostname):$paneref; sleep 0.5; tmux send-keys -t \$(hostname):$paneref C-m"
         echo "[re-fire2 $win @ $node]: composer still held after C-m — copy-mode cancel + re-paste + C-m (wedge escalation)" >&2 ;;
      # RUNG 3 — AN ENGINE THAT EATS C-m WHILE pane_in_mode READS 0 (chat-review/a-stranded-composer-
      # outlives-every-ladder-that-would-clear-it). The two rungs above name exactly two causes:
      # paste-burst stall, and the tmux copy-mode wedge. A THIRD state was measured on vpn 2026-08-29
      # and is neither: tmux display-message pane_in_mode read 0, `send-keys -X cancel` then C-m was
      # eaten twice by hand, and the engine was demonstrably alive (pane_pid's claude child in Sl+ on
      # ep_poll, mesh-mind-state answering IDLE, ready prompt). So neither existing verb can reach it.
      #
      # The mechanism this rung addresses is the one that FITS that evidence rather than a third guess:
      # an UNTERMINATED BRACKETED PASTE. Rungs 1-2 both deliver via `paste-buffer -p`, which wraps the
      # payload in ESC[200~ … ESC[201~. If the closing bracket is lost (a truncated write, a pane
      # resize mid-paste, an engine that re-enters paste mode on its own), the TUI stays in paste
      # ACCUMULATION and swallows every subsequent key — C-m included — into the pending paste, while
      # tmux's own pane_in_mode stays 0 (that flag is about tmux's copy-mode, a different layer) and
      # the process sits idle on its event loop. That is precisely the triple witness measured.
      # So: send the paste TERMINATOR alone, then C-m. On a TUI that is NOT mid-paste, ESC[201~ is a
      # well-formed CSI sequence with no meaning and is discarded — it cannot submit, clear or corrupt
      # a composer, which is why it is safe to fire blind on a pane already proven stuck twice.
      # -H takes hex bytes (tmux >= 2.4): 1b 5b 32 30 31 7e = ESC [ 2 0 1 ~.
      2) run "tmux send-keys -t \$(hostname):$paneref -H 1b 5b 32 30 31 7e 2>/dev/null; sleep 0.2; tmux send-keys -t \$(hostname):$paneref C-m"
         echo "[re-fire3 $win @ $node]: composer still held after re-paste — sent the bracketed-paste terminator + C-m (unterminated-paste rung)" >&2 ;;
      # AND IF THAT FAILS, SAY SO. A ladder whose last rung fails silently is why this class went
      # unswept for 55 minutes: the send exits 0, the caller reads '[told]', and the strand is
      # invisible until a human reads the pane. The line below is the ONLY thing that distinguishes
      # "delivered" from "stranded past every rung we have", and mesh-channel-keepalive's sweep is
      # what re-examines the pane after this process is gone. It is reachable ONLY from rc 3 — a pane
      # at REST still holding the text — never from the cap, and it now carries the composer's own
      # content, so a reader can see whether what is stranded is in fact the ORIGINAL prompt.
      *) _snap="$(cap_full | compose_snapshot "${MESH_TELL_COMPOSER_CHARS:-160}")"
         echo "[STRANDED $win @ $node]: composer STILL holds the prompt after all three rungs (paste-burst · copy-mode · unterminated-paste) and the pane is at REST — this prompt is UNSUBMITTED and no rung reached it; the mind reads IDLE but is holding work it cannot start · composer: ${_snap}" >&2
         return 0 ;;
    esac
    rung=$((rung+1))
  done
}

# ── WRITE-AHEAD injection log (STUDY write-ahead log 2026-07-20) ────────────────────────────────────
# Every send is journalled to $MESH_TELL_WAL (default ~/.mesh/tell-wal.log): the INTENT line lands
# BEFORE any guard runs or key is pressed, the OUTCOME (sent/refused) after — so a crash/kill mid-send
# leaves a dangling intent, which --replay renders UNRESOLVED. That ordering is the point: the log can
# never claim less than what was attempted. Replay is DISPLAY-ONLY audit (never re-injects — blindly
# re-firing old prompts into minds is the double-dispatch bug, not a feature). Fields (tab-separated):
# ts · pid · phase · who · node · win · b64(prompt). Prompt travels base64 (same payload the send
# uses) so multi-line prompts stay one log line. WAL path read at CALL time, not load time (a test's
# env assignment must bind — the export-vs-load-time-global trap).
#
# ── LOGGING LEVEL (STUDY write-ahead log 2026-08-15) ────────────────────────────────────────────────
# `MESH_TELL_WAL_LEVEL`, or `MESH_TELL_WAL_LEVEL=` in ~/.mesh/nodes (env wins), default `full`:
#
#   full     ts·pid·phase·who·node·win·b64(prompt) — today's record, unchanged. THE DEFAULT.
#   redact   same record, payload replaced by `r:<sha256[0:8]>:<b64len>` — the audit trail and the
#            ORDERING survive; the prompt text does not. This node's live log is 1.5MB of verbatim
#            prompts in 2026 lines; a mind is routinely handed tokens, paths and operator text, and
#            the WAL retains all of it for 4000 lines. The digest still answers "was THIS the prompt
#            that was sent?" (hash the candidate and compare) — it only stops answering "what was it".
#   minimal  same record, payload `-`. Ordering-only audit, nothing derived from the content at all.
#   off      no records. The write-ahead guarantee is GONE at this level: a crash mid-send leaves no
#            dangling intent, so nothing can be reconstructed. Deliberately the loudest to choose.
#
# The level only ever thins the PAYLOAD COLUMN — never the record, never the ordering. `intent`
# still lands before any guard at every level except `off`; a level cannot make the log claim less
# than what was attempted while it is still writing at all.
#
# TWO RULES KEEP A THINNED LOG FROM READING AS A QUIET ONE:
#  1. A level CHANGE is journalled in the log itself (phase `level`, `<from>-><to>`), exactly once,
#     at the moment it happens — so a gap or a payload-less stretch is always explained IN the
#     artifact, not only in whatever env the reader happens to have. `off` writes that one marker
#     and then nothing: the log SAYS where it stopped. (The marker carries `-` for pid/node/win so
#     it can never be matched as an outcome by the pid+win join in wal_replay.)
#  2. --replay renders a thinned payload as an explicit «redacted …» / «no payload retained», never
#     as an empty column — an empty column is indistinguishable from an empty prompt, which is the
#     silent-fallback shape this doctrine keeps meeting.
# An UNRECOGNISED level is a loud stderr warning and falls back to `full`: the fail-safe direction
# for a journal is MORE evidence, never less (mesh-load-gate's documented asymmetry, same reasoning).
# The `-` and `r:` sentinels are outside the base64 alphabet, so they can never collide with a real
# payload.
_wal_lv=""
wal_level(){ # resolved at CALL time (see above), cached per PROCESS
  [ -n "$_wal_lv" ] && { printf '%s' "$_wal_lv"; return 0; }
  local lv="${MESH_TELL_WAL_LEVEL:-}" src=env cfg="${MESH_TELL_NODES:-$HOME/.mesh/nodes}"
  if [ -z "$lv" ] && [ -r "$cfg" ]; then
    lv="$(sed -nE 's/^[[:space:]]*(export[[:space:]]+)?MESH_TELL_WAL_LEVEL=["'"'"']?([A-Za-z]+).*/\2/p' "$cfg" | tail -1)"
    src="$cfg"
  fi
  [ -n "$lv" ] || { lv=full; src=default; }
  case "$lv" in
    full|redact|minimal|off) : ;;
    *) echo "mesh-tell: unrecognised WAL level '$lv' (from $src) — journalling at FULL" >&2; lv=full ;;
  esac
  _wal_lv="$lv"; printf '%s' "$lv"
}
wal_mark_level(){ # <wal> <level> — journal a level CHANGE into the log, once, when it happens
  local wal="$1" lv="$2" side="$1.level" prev=""
  [ -r "$side" ] && prev="$(cat -- "$side" 2>/dev/null)"
  [ "$prev" = "$lv" ] && return 0
  # a first-ever run at the DEFAULT level is not a change and needs no announcement; every other
  # transition does, including the first run at a non-default level.
  if [ -n "$prev" ] || [ "$lv" != full ]; then
    printf '%s\t-\t%s\t%s\t-\t-\t%s\n' "$(date -u +%FT%TZ)" level "${MESH_WHO:-$(id -un)}" \
      "${prev:-unset}->$lv" >> "$wal" 2>/dev/null
  fi
  printf '%s' "$lv" > "$side" 2>/dev/null
}
wal_append(){ # wal_append <phase> <win> <node> <b64|->
  local wal="${MESH_TELL_WAL:-$HOME/.mesh/tell-wal.log}" lv payload="${4:--}"
  mkdir -p "${wal%/*}" 2>/dev/null
  lv="$(wal_level)"
  wal_mark_level "$wal" "$lv"
  [ "$lv" = off ] && return 0
  case "$lv" in
    redact)  [ "$payload" = - ] || payload="r:$(printf '%s' "$payload" | sha256sum 2>/dev/null | cut -c1-8):${#payload}" ;;
    minimal) payload=- ;;
  esac
  # retention (intent-only, once per invocation): >4000 lines → keep 2000. flock -n: a concurrent
  # trimmer skips; a concurrent appender can lose its line to the mv window — rare, accepted for audit.
  if [ "$1" = intent ] && [ -f "$wal" ] && [ "$(wc -l < "$wal")" -gt 4000 ]; then
    ( flock -n 9 && tail -n 2000 "$wal" > "$wal.tmp.$$" && mv "$wal.tmp.$$" "$wal" ) 9>>"$wal" 2>/dev/null
  fi
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$(date -u +%FT%TZ)" "$$" "$1" "${MESH_WHO:-$(id -un)}" "$3" "$2" "$payload" >> "$wal" 2>/dev/null
}
wal_replay(){ # wal_replay [-n N] [<win>] — audit view: one line per intent, outcome or UNRESOLVED
  local wal="${MESH_TELL_WAL:-$HOME/.mesh/tell-wal.log}" n=20 win="" ts pid phase who node w b64 out txt
  local lv lastmark
  while [ $# -gt 0 ]; do case "$1" in -n) n="${2:?-n needs a count}"; shift 2;; *) win="$1"; shift;; esac; done
  lv="$(wal_level)"
  # An ABSENT log is a different claim at each level, and the difference is the whole point of
  # announcing it: at `off` there is nothing to read BY CONFIGURATION, and reporting that as a bare
  # "no injection log" would let a deliberately silenced journal read as a node that sent nothing.
  if [ ! -s "$wal" ]; then
    if [ "$lv" = off ]; then
      echo "mesh-tell: WAL level=off — this node journals no sends; an empty log at $wal is a CONFIGURATION, not evidence that nothing was injected" >&2
    else
      echo "mesh-tell: no injection log at $wal" >&2
    fi
    return 1
  fi
  # the log's OWN last recorded level — the reader's env is not necessarily the writer's
  lastmark="$(awk -F'\t' '$3=="level"{v=$7; t=$1} END{if(v!="") print v" @ "t}' "$wal")"
  [ "$lv" = full ] && [ -z "$lastmark" ] || \
    echo "level: $lv${lastmark:+ (last recorded change in the log: $lastmark)}"
  awk -F'\t' -v w="$win" '$3=="intent" && (w=="" || $6==w)' "$wal" | tail -n "$n" | \
  while IFS=$'\t' read -r ts pid phase who node w b64; do
    # outcome = first non-intent record of the SAME pid+win at/after the intent's ts (pid alone is
    # reusable across the log's lifetime; win narrows the collision to same-pid-same-win — accepted).
    # `level` markers carry `-` for pid AND win, so they can never be joined here as an outcome.
    out="$(awk -F'\t' -v p="$pid" -v ww="$w" -v t="$ts" '$2==p && $6==ww && $3!="intent" && $1>=t {print $3; exit}' "$wal")"
    # a THINNED payload is rendered as an explicit claim, never as an empty column — an empty column
    # is indistinguishable from an empty prompt. `-` and `r:` are outside the base64 alphabet.
    case "$b64" in
      -)   txt='«no payload retained (level=minimal)»' ;;
      r:*) txt="«redacted (level=redact) ${b64#r:}»" ;;
      # awk, not tr: tr is byte-wise and truncates the multibyte '¦' to its lead byte (mojibake)
      *)   txt="$(printf '%s' "$b64" | base64 -d 2>/dev/null | awk 'NR>1{printf "¦"} {printf "%s",$0}' | cut -c1-100)" ;;
    esac
    printf '%s  %-14s %-16s %-10s %s\n' "$ts" "$w@$node" "$who" "${out:-UNRESOLVED}" "$txt"
  done
}
# ── ARRIVAL PRESSURE — VARIETY OVERFLOW AT THE RECEIVING MIND ─────────────────────────────────────
# review-second-order-cyb-variety-overflow-2026-08-15 (LIVE literature).
#
# SOURCE: Brett Neese & Sofia Penabaz-Wiley, *The Requisite Variety of Presence: A Cybernetic
# Intervention in Knowledge Work's Attention Crisis*, **Enacting Cybernetics 3(1): Article 2**
# (18 Nov 2025, doi:10.58695/ec.20 — read in full). Ashby + Beer applied to the "hyperactive hive
# mind workflow": unstructured, unscheduled arrivals into a worker's channel. Its named mechanism is
# **VARIETY OVERFLOW** — "an excess of incoming information without corresponding mechanisms for
# effective filtering" — and the criterion it leans on is Glanville's (2009, p.70) corollary to
# Ashby: "the variety of the controller and the controlled must, for effective control to take place,
# be the same." Overflow is when that parity breaks in the arrivals' favour: "unstructured messages
# arrive faster than humans can process them", so homeostatic maintenance becomes impossible. Its
# empirical anchor is the field figure it quotes: workers "interrupted every 15 minutes by email and
# every 18 minutes via instant message" (Iqbal & Horvitz 2007). Its intervention (the `buddylist`
# case) is a RECEIVER-DECLARED presence signal that SENDERS read — attenuation at the source rather
# than absorption at the sink.
#
# THE GAP THIS FILLS: the mesh regulates the sender's side of every send — deliverability (--ack),
# freshness (--fresh), a dead/shed pane (dead_shell_guard), dispatch's idle/thermal/pace holds — and
# it measures the OPERATOR's interruptibility exhaustively (mesh-interruptibility fuses 8 senses to
# answer "may the mesh speak to the human?"). Nothing has ever asked the same question about a MIND.
# tell-wal.log has journalled every arrival at every mind pane since 2026-07-20, and its ONLY reader
# is --replay, which shows the last N sends one at a time — a per-send audit view that can never
# surface a RATE. So the arrival stream existed, in full, and the question was never put to it.
#
# WHAT IT REPORTS (report-only — this never gates, delays or reorders a send):
#   arr          completed arrivals (`sent` records) at that window in the log's span. An `intent`
#                with no outcome is NOT an arrival (nothing reached the pane); consecutive records
#                sharing pid+win within 60s are ONE invocation (a retry is not a second interruption).
#   med_gap_min  median inter-arrival gap. Median, not mean: one overnight silence would otherwise
#                launder a day of 2-minute pokes into a calm average.
#   burst<5m     share of gaps under 5 min — the arrivals that land inside the previous one's turn.
#   pressure     paced | overflow-risk | n-a  (n-a below MIN_N arrivals — a verdict off 2 gaps is a
#                sample, not a rate).
#
# THREE HONESTY CONSTRAINTS, each a doctrine failure this axis could otherwise walk into:
#  1. `level=off` renders n/a, NEVER a calm zero. At that level the node journals nothing, so an
#     empty log is a CONFIGURATION — the silent-fallback shape (a default indistinguishable from a
#     success). `redact`/`minimal` thin only the PAYLOAD column, so timing survives and pressure is
#     fully readable at those levels; they are reported, not refused.
#  2. The reference interval is CITED, not tuned. 15 min is Iqbal & Horvitz's measured human figure
#     as quoted by the paper, printed in the output beside its citation so it can never be read as a
#     mesh-calibrated threshold that somebody may "adjust". The span and n come from the log itself
#     (which is a SLIDING window — trimmed at 4000 lines → 2000), so no figure here is reproducible;
#     the CLAIM is the gate, the number is only its current answer.
#  3. It claims ARRIVAL PRESSURE, not goal interference. The WAL records what was injected and when,
#     never what the mind was doing when it landed — an arrival at an idle pane is a feed, not an
#     interruption. Naming the wider claim would be a sub-axis standing in for a verdict.
#
# LIVE ON mesh-home AT LANDING (12.0d, 994 arrivals): genome med 10.0 min / burst 24% —
# OVERFLOW-RISK, i.e. the mesh's busiest mind is poked at a shorter interval than the human
# knowledge workers whose attention crisis the paper is about. sound 30.0 · health 60.5 · everything
# else paced. HELD (deliberately not built): the receiver-declared attenuator itself — buddylist's
# half of the paper. A mind publishing "hold non-incident sends" would change what gets delivered,
# and the mesh has no measurement of that pressure to weigh it against until this axis has run.
# PEAK-LOAD CORRECTION (live review 2026-08-19, VSM / supervisory-cybernetics angle):
# Telukunta, Lilis & Baron, "The CASE Framework: A Multi-Disciplinary Control Architecture for
# Governing Enterprise Agentic AI", arXiv:2608.10153 (10 Aug 2026), Layer 3 "supervisory cybernetics
# for human-agent teams". It restates Ashby/Beer as an ENGINEERED CHANNEL with measured capacity —
# ineq. (4) H(O) ≥ H(A) − H(A|O), ineq. (5) V_human × G ≥ V_agents — and adds the constraint this
# axis was missing, verbatim: "with the inequality required to hold at peak variety, not average
# load", because "agent behavioral variety grows combinatorially with agent count, tool access, and
# autonomy level, while human cognitive variety is fixed".
#
# THE GAP IT FILLS (measured, not inferred): the verdict was a function of the MEDIAN GAP ALONE
# (`mg<ref ? overflow-risk : paced`). The burst<5m column was computed, printed, and never read by
# the band — decorative. So a pane poked eight times inside twenty minutes and then left alone for
# hours reads PACED: the median averages the burst away, which is precisely the "average load"
# reading CASE says an oversight channel may not be sized by. Live at landing (tell-wal, 2641 lines):
# adint med 62.3 min → PACED, while its tightest sustained 8-arrival run ran at 2.68 min/arrival;
# wake med 45.2 / burst 39% → PACED, peak 4.30; senses 31.8 → PACED, peak 10.95; sound 30.0 → PACED,
# peak 12.85. Four of thirteen windows carried a calm verdict over a burst below the cited reference,
# and one of them (wake) had a 39% burst share sitting in the row saying so.
#
# THE PEAK LEG ADDS NO NEW THRESHOLD — this is the point. It asks the SAME cited 15-min question
# (Iqbal & Horvitz, as quoted by Neese & Penabaz-Wiley) over the SAME minimum sample the median leg
# already requires (MIN_N), just positioned at the tightest sustained run instead of the middle. A
# single tight PAIR cannot move it (a retry storm is not a rate), and the verdict NAMES which leg
# fired — overflow-risk(med) is a chronic pace, overflow-risk(peak) is a burst, and they are
# different findings that a bare max-fold would efface. Still report-only: nothing gates a send.
PRESSURE_REF_MIN="${MESH_TELL_PRESSURE_REF_MIN:-15}"    # cited (Iqbal & Horvitz 2007), not tuned
PRESSURE_BURST_MIN="${MESH_TELL_PRESSURE_BURST_MIN:-5}"
PRESSURE_MIN_N="${MESH_TELL_PRESSURE_MIN_N:-8}"
wal_pressure(){ # wal_pressure [<win>] — report-only per-window arrival pressure over the log's span
  local wal="${MESH_TELL_WAL:-$HOME/.mesh/tell-wal.log}" win="${1:-}" lv
  lv="$(wal_level)"
  if [ "$lv" = off ]; then
    echo "mesh-tell: WAL level=off — this node journals no sends, so arrival pressure is n/a, NOT calm (an empty log at this level is a CONFIGURATION, not evidence that no mind was interrupted)" >&2
    return 2
  fi
  if [ ! -s "$wal" ]; then
    echo "mesh-tell: no injection log at $wal — arrival pressure n/a" >&2
    return 2
  fi
  awk -F'\t' -v only="$win" -v ref="$PRESSURE_REF_MIN" -v burst="$PRESSURE_BURST_MIN" \
             -v minn="$PRESSURE_MIN_N" -v lv="$lv" -v wal="$wal" '
    # epoch from YYYY-MM-DDTHH:MM:SSZ without gawk mktime (mawk is the default awk here)
    function ep(s,   y,mo,d,h,mi,se,a,ye,m2,days){
      y=substr(s,1,4)+0; mo=substr(s,6,2)+0; d=substr(s,9,2)+0
      h=substr(s,12,2)+0; mi=substr(s,15,2)+0; se=substr(s,18,2)+0
      if (y<1970 || mo<1 || mo>12) return -1
      a=int((14-mo)/12); ye=y+4800-a; m2=mo+12*a-3
      days=d+int((153*m2+2)/5)+365*ye+int(ye/4)-int(ye/100)+int(ye/400)-32045
      return (days-2440588)*86400 + h*3600 + mi*60 + se
    }
    function med(w,   i,c,A,t,j){
      c=ng[w]; for(i=1;i<=c;i++) A[i]=G[w,i]
      for(i=2;i<=c;i++){ t=A[i]; j=i-1; while(j>=1 && A[j]>t){A[j+1]=A[j]; j--} A[j+1]=t }
      if (c%2) return A[int(c/2)+1]
      return (A[c/2]+A[c/2+1])/2
    }
    # PEAK LOAD (CASE 2026 Layer 3, inequality 5): the TIGHTEST SUSTAINED run — the shortest span
    # holding minn consecutive arrivals, rendered as its effective inter-arrival gap. It reuses the
    # two numbers the median leg already uses (minn samples, the cited ref) and adds NO constant: the
    # same criterion, asked at peak instead of at the middle. A single tight PAIR cannot move it —
    # minn arrivals must stay inside the run — so this is a rate, not an outlier.
    function peak(w,   i,sp,best){
      best=-1
      if (n[w] < minn) return -1
      for (i=1; i+minn-1<=n[w]; i++){ sp=(T[w,i+minn-1]-T[w,i])/60/(minn-1); if (best<0 || sp<best) best=sp }
      return best
    }
    $3=="sent" && $6!="-" && (only=="" || $6==only) {
      t=ep($1); w=$6
      if (t<0) next
      # one mesh-tell invocation = one arrival: a same-pid record seconds later is a retry, not a
      # second interruption. (Measured 0 such pairs in the live log — the guard is for the shape.)
      if ((w in lastt) && $2==lastpid[w] && t-lastt[w] < 60) { lastt[w]=t; next }
      n[w]++; T[w,n[w]]=t
      if (w in lastt) { g=(t-lastt[w])/60; k=++ng[w]; G[w,k]=g; if (g<burst) b[w]++ }
      lastt[w]=t; lastpid[w]=$2
      if (gmin==0 || t<gmin) gmin=t
      if (t>gmax) gmax=t
      tot++
    }
    END{
      if (tot==0) { print "mesh-tell: injection log holds no completed sends — arrival pressure n/a" > "/dev/stderr"; exit 3 }
      printf "tell-wal: %.1fd window · %d arrival(s) · level=%s · %s\n", (gmax-gmin)/86400, tot, lv, wal
      print  "  span/n come from the log, which is a SLIDING window (trimmed at 4000 lines to 2000): a current answer, not a reproducible population."
      printf "  reference %d min = the field interval at which knowledge workers were interrupted by email (Iqbal & Horvitz 2007), quoted in\n", ref
      print  "  Neese & Penabaz-Wiley 2025, Enacting Cybernetics 3(1):2 doi:10.58695/ec.20. A CITED anchor — not a mesh-tuned threshold."
      print  "  CLAIM: arrival pressure AT the pane. NOT goal interference — the WAL never recorded what the mind was doing when the prompt landed."
      printf "  peak%d_gap_min = the tightest SUSTAINED run: shortest span holding %d consecutive arrivals, as an effective gap. Requisite variety is\n", minn, minn
      print  "  required to hold AT PEAK, not at average load (Telukunta, Lilis & Baron, CASE, arXiv:2608.10153, 10 Aug 2026, ineq. 5) — same n, same cited reference."
      printf "\n  %-12s %5s %12s %12s %9s  %s\n", "win", "arr", "med_gap_min", "peak" minn "_gap_min", "burst<" burst "m", "pressure"
      m=0; for (w in n) K[++m]=w
      for (i=2;i<=m;i++){ kt=K[i]; j=i-1; while(j>=1 && n[K[j]]<n[kt]){K[j+1]=K[j]; j--} K[j+1]=kt }
      for (i=1;i<=m;i++){
        w=K[i]
        if (n[w] < minn) { printf "  %-12s %5d %12s %12s %9s  %s\n", w, n[w], "n-a", "n-a", "n-a", "n-a (<" minn " arrivals)"; continue }
        mg=med(w); bp=100*b[w]/ng[w]; pk=peak(w)
        # A MAX FOLD MUST NAME ITS WINNER: chronic (median) and burst (peak) are different claims
        # about the same pane, and a bare "overflow-risk" would efface which one fired.
        lo=(mg<ref); hi=(pk>=0 && pk<ref)
        if (lo && hi)      v="overflow-risk(med+peak)"
        else if (lo)       v="overflow-risk(med)"
        else if (hi)       v="overflow-risk(peak)"
        else if (pk<0)     v="paced(med; peak blind)"
        else               v="paced"
        printf "  %-12s %5d %12.1f %12s %8.0f%%  %s\n", w, n[w], mg, (pk<0 ? "n-a" : sprintf("%.1f", pk)), bp, v
      }
    }' "$wal"
}
# --replay/--pressure dispatch HERE, before the send path can read them as a window name
# (argv-is-payload: the pre-fix code ran `mesh-tell --replay -n 5 <win>` as a SEND to a window
# called '--replay').
case "${1:-}" in
  --replay)   shift; wal_replay   "$@"; exit $? ;;
  --pressure) shift; wal_pressure "$@"; exit $? ;;
  # --pane-snapshot exposes the NO-ACK evidence builder ALONE, so it can be driven over a REAL pane
  # capture instead of a hand-written fixture. `-` reads a capture on stdin (that is how another
  # tool's --test drives it against its own throwaway tmux server); a window name captures that
  # window's mind pane on this node. Display-only: it sends nothing and touches no state.
  --pane-snapshot)
    shift
    case "${1:--}" in
      -|"") compose_snapshot "${2:-120}" ;;
      *)    _psw="$1"
            _psi=$(tmux list-panes -t "$(hostname):$_psw" -F '#{pane_top} #{pane_index}' 2>/dev/null | sort -n | tail -1 | awk '{print $2}')
            tmux capture-pane -t "$(hostname):$_psw${_psi:+.$_psi}" -p 2>/dev/null | compose_snapshot "${2:-120}" ;;
    esac
    exit $? ;;
esac

if [ "${1:-}" = --test ]; then
  # tmp fence — task:doctor-test-tmpdir-cleanup-traps. Re-exec the smoke test ONCE under a private
  # TMPDIR and remove it from the PARENT, so the cleanup cannot be lost to the test's own `exit 1`
  # and cannot be clobbered by an EXIT trap the test sets for itself. A nested --test inherits the
  # guard var and skips its own fence (it is already inside one).
  if [ -z "${MESH_TEST_TMPD:-}" ]; then
    MESH_TEST_TMPD="$(mktemp -d)" || { echo "smoke-test: FAIL (tmp fence: mktemp -d)"; exit 1; }
    trap 'rm -rf "$MESH_TEST_TMPD"' EXIT INT HUP TERM
    export MESH_TEST_TMPD TMPDIR="$MESH_TEST_TMPD" TMP="$MESH_TEST_TMPD" TEMP="$MESH_TEST_TMPD"
    _fence_rc=0; "$0" "$@" || _fence_rc=$?; exit "$_fence_rc"
  fi
  command -v tmux >/dev/null 2>&1 || { echo "smoke-test: FAIL (no tmux)"; exit 1; }
  command -v base64 >/dev/null 2>&1 || { echo "smoke-test: FAIL (no base64)"; exit 1; }
  command -v hostname >/dev/null 2>&1 || { echo "smoke-test: FAIL (no hostname)"; exit 1; }
  tmux has-session -t "$(hostname)" 2>/dev/null || { echo "smoke-test: FAIL (no tmux session for $(hostname))"; exit 1; }

  # ── FIXTURE SOCKET HYGIENE (chat-review/test-tmux-fixture-leaks-server-on-timeout 2026-07-17) ──────
  # The ack + re-fire fixtures below spawn DETACHED tmux servers on PRIVATE sockets (mtellack$$/mtellrf$$)
  # and free them only on the happy path (kill-server at each block's end). Under mesh-doctor's parallel
  # smoke STORM this --test blows timeout 12 → SIGTERM lands mid-fixture → bash skips the tail cleanup on
  # an unhandled fatal signal → the detached server (its OWN daemon, outside our process tree) is
  # immortal; the leak accreted to 22 live servers + 353 stale sockets on this node. Two guards:
  #  (1) a TRAP that reaps every socket THIS run created, on EXIT/TERM/INT — EXIT ALONE is insufficient
  #      (bash runs the EXIT trap on a TERM only when TERM is itself trapped), so name all three.
  #  (2) reap-on-entry: drain ALREADY-leaked fixtures from prior storm-killed runs (the socket name embeds
  #      the creator $$) whose pid is DEAD; a pid still alive = a concurrent doctor/hand run → leave it.
  # ── WAL SANDBOX (STUDY write-ahead log 2026-07-20): every child "$0" invocation below would append
  # to the REAL injection log — a --test must never write the artifact a human/auditor reads (the
  # forged-evidence trap, 09f7914). Point the whole test run at a throwaway log; assert at the end that
  # no record written by THIS RUN reached the real one (leg 4 below — and see there for why the assert
  # is per-RECORD and not the byte compare it used to be).
  export MESH_TELL_WAL="$(mktemp)"
  # Run-unique sender identity, exported so EVERY child of this test stamps it into whatever log it
  # ends up writing. This is what makes a leaked record self-attributing: a live send can never carry
  # it. The origin legs override MESH_WHO with values they assert on, so name those here too — one
  # list, read by both the legs and the leak scan, so the alphabet cannot drift from the patterns.
  _wal_self_who="mtell-selftest-$$"
  export MESH_WHO="$_wal_self_who"
  _wal_who_origin=TESTWHO
  _wal_who_other=OTHERSENDER
  _wal_test_whos="$_wal_self_who $_wal_who_origin $_wal_who_other"
  _wal_real="$HOME/.mesh/tell-wal.log"
  _wal_real_sz="$({ wc -c < "$_wal_real"; } 2>/dev/null || echo 0)"
  _wal_t0="$(date -u +%FT%TZ)"

  _fx_socks=""
  _fx_dir="/tmp/tmux-$(id -u)"
  _fx_reap_mine(){ local s; for s in $_fx_socks; do tmux -L "$s" kill-server 2>/dev/null; rm -f "$_fx_dir/$s"; done; }
  trap _fx_reap_mine EXIT TERM INT
  _fx_track(){ _fx_socks="$_fx_socks $1"; }   # call right after each private new-session
  if [ -d "$_fx_dir" ]; then
    for _fx_pfx in mtellack mtellrf mtellsnap; do
      for _fx_f in "$_fx_dir/$_fx_pfx"*; do
        [ -S "$_fx_f" ] || continue
        _fx_pid="${_fx_f##*/$_fx_pfx}"
        case "$_fx_pid" in ''|*[!0-9]*) continue;; esac
        kill -0 "$_fx_pid" 2>/dev/null && continue
        tmux -L "${_fx_f##*/}" kill-server 2>/dev/null; rm -f "$_fx_f"
      done
    done
  fi

  # Dry-run: verify base64 round-trip for prompt delivery (core data pipeline)
  _test_prompt="alert(\"test-émoji 🧪\") with | pipes and \$vars"
  _b64=$(printf '%s' "$_test_prompt" | base64 | tr -d '\n')
  _decoded=$(printf '%s' "$_b64" | base64 -d 2>/dev/null)
  [ "$_decoded" = "$_test_prompt" ] || { echo "smoke-test: FAIL (base64 round-trip mismatch)"; exit 1; }
  [ -z "$(printf '%s' "$_b64" | tr -d '[:graph:]')" ] || { echo "smoke-test: FAIL (base64 contains whitespace/newlines)"; exit 1; }

  # ── ACK asserts (mesh-tell-ack 2026-06-24): exercise the REAL ack_probe against a FIXTURE pane on a
  # PRIVATE tmux socket (isolated; killed at the end — never touches the node's append-only session).
  # `cat` echoes typed text via the PTY, so send-keys paints whatever pane state we want to assert on.
  # Three fixtures — the IDLE footer and the operator's STALL both read NO-ACK; only the live WORKING
  # counter reads RECEIVED (the whole point: a stall must NOT false-ACK as delivered).
  af=0
  L="mtellack$$"
  ACK_TIMEOUT=1   # keep the NO-ACK cases ~1s
  tmux -L "$L" new-session -d -s t -x 100 -y 12 cat 2>/dev/null; _fx_track "$L"
  tmux -L "$L" new-window  -t t -n w2 cat 2>/dev/null
  tmux -L "$L" new-window  -t t -n w3 cat 2>/dev/null
  tmux -L "$L" new-window  -t t -n w4 cat 2>/dev/null
  # cap_tail override: read the fixture window selected by $PANE (the REAL ack_probe stays under test)
  cap_tail(){ tmux -L "$L" capture-pane -t "$PANE" -p 2>/dev/null | grep -vE '^[[:space:]]*$' | tail -8; }
  _idle_footer='⏵⏵ auto mode on (shift+tab to cycle) · esc to interrupt · ← for agents'
  # fixture 1 — IDLE-UNCHANGED: the persistent claude footer hint (bare 'esc to interrupt', no counter),
  # pane IDENTICAL to the pre-send tail → NO-ACK even under composer-state arbitration (nothing landed).
  PANE="t:0.0"; tmux -L "$L" send-keys -t "$PANE" "$_idle_footer" 2>/dev/null; sleep 0.3
  [ "$(ack_probe "$(cap_tail)")" = NOACK ] || { echo "  FAIL: ack — idle footer, pane unchanged vs pre-send tail must read NO-ACK"; af=1; }
  # fixture 2 — WORKING: the live counter line ('(Ns · tokens · esc to interrupt)') → RECEIVED
  PANE="t:w2.0"; tmux -L "$L" send-keys -t "$PANE" '✶ Cogitating… (7s · ↑ 1.4k tokens · esc to interrupt)' 2>/dev/null; sleep 0.3
  [ "$(ack_probe)" = RECEIVED ] || { echo "  FAIL: ack — live working counter must read RECEIVED"; af=1; }
  # fixture 3 — STALL (operator's exact failure): box filled with pasted text + 'paste again to expand',
  # NO working counter → NO-ACK even though the pane CHANGED vs the pre-send tail (held text is the
  # positive stranded evidence; a pane-change alone must never ACK — this is the bug the task exists for)
  PANE="t:w3.0"; tmux -L "$L" send-keys -t "$PANE" '❯ run the dispatched ta… ⏎ paste again to expand' 2>/dev/null; sleep 0.3
  [ "$(ack_probe "$_idle_footer")" = NOACK ] || { echo "  FAIL: ack — a stalled/unsubmitted paste must read NO-ACK (not false-ACK)"; af=1; }
  # fixture 4 — LATE PAINT (chat-review/ack-noack-is-an-absence-verdict): the prompt DID submit — text
  # moved up into the transcript, composer back to a bare '❯' — but the WORKING counter never painted
  # inside the poll window (CPU-starved render / sub-window turn; both live [dispatch-noack] verdicts
  # 2026-07-16 were this class and both were FALSE). Pane changed vs pre-send tail + composer empty +
  # no stall marker → RECEIVED. Falsify: an ack_probe that ignores its <pre-send-tail> arg reads NOACK.
  PANE="t:w4.0"
  tmux -L "$L" send-keys -t "$PANE" '● taking the dispatched task — reading mesh-tell now' C-m 2>/dev/null; sleep 0.3
  tmux -L "$L" send-keys -t "$PANE" '❯' 2>/dev/null; sleep 0.3
  [ "$(ack_probe "$_idle_footer")" = RECEIVED ] || { echo "  FAIL: ack — submitted-but-late-paint (pane changed, composer empty, no stall) must read RECEIVED"; af=1; }
  tmux -L "$L" kill-server 2>/dev/null   # private throwaway socket — safe to kill (not the node session)
  [ "$af" = 0 ] || { echo "smoke-test: FAIL (ack_probe regressed — see asserts above)"; exit 1; }

  # ── LOAD-AWARE ACK WINDOW (chat-review/acktimeout-thermal-blind 2026-07-10): ack_probe must honor a
  # WIDENED ACK_TIMEOUT so a CPU-starved engine that paints its working footer LATE still reads RECEIVED
  # (dispatch() widens the env under measured node stress; the fixed 4s window was discarding real
  # hand-offs as false NO-ACK). Hermetic + deterministic: cap_tail reveals the live counter only on the
  # 6th poll (a footer that lands ~3s late) — poll-count-gated, not wall-clock-gated. A NARROW window
  # (ACK_TIMEOUT=2 → 4 polls) never sees it → NO-ACK; a WIDE window (ACK_TIMEOUT=6 → 12 polls) catches it
  # → RECEIVED. Falsify: hardcode n back to a fixed count and the wide case regresses to NO-ACK.
  # NB: cap_tail runs inside ack_probe's own `post="$(cap_tail)"` command substitution (a subshell), so a
  # shell-var poll counter would be discarded each call — the reveal state must live in a FILE to persist.
  lf=0; _lcnt="$(mktemp)"
  cap_tail(){ local n; n=$(( $(cat "$_lcnt" 2>/dev/null || echo 0) + 1 )); echo "$n" >"$_lcnt"; if [ "$n" -ge 6 ]; then echo '✶ Working… (9s · ↑ 2k tokens · esc to interrupt)'; else echo '⏵⏵ auto mode on (shift+tab to cycle) · esc to interrupt · ← for agents'; fi; }
  echo 0 >"$_lcnt"; ACK_TIMEOUT=2; [ "$(ack_probe)" = NOACK ]    || { echo "  FAIL: ack — narrow window (late footer) must read NO-ACK"; lf=1; }
  echo 0 >"$_lcnt"; ACK_TIMEOUT=6; [ "$(ack_probe)" = RECEIVED ] || { echo "  FAIL: ack — widened window must catch the late footer → RECEIVED"; lf=1; }
  rm -f "$_lcnt"; ACK_TIMEOUT="${MESH_TELL_ACK_TIMEOUT:-4}"   # restore default for any later use
  [ "$lf" = 0 ] || { echo "smoke-test: FAIL (load-aware ACK window regressed)"; exit 1; }

  # ── STALL RE-FIRE (chat-review/meshtell-no-resubmit-on-stall): a stranded paste (composer still
  # holds our text) must trigger exactly ONE C-m retry; a WORKING or empty composer must NOT (else the
  # retry would double-submit or fire on every tick). Three fixtures on a PRIVATE socket (one window
  # each, isolated from the node session), then a REAL observable: a stalled 'cat' pane whose text has
  # NOT been submitted — run the retry, drop a sentinel, and prove the sentinel landed on a NEW line
  # (the C-m advanced cat's cursor). Falsify: drop the `composer_holds_text && ... C-m` and the
  # sentinel appends to the same line as the stall text → assertion fails.
  rf=0; L2="mtellrf$$"
  tmux -L "$L2" new-session -d -s t -x 100 -y 12 cat 2>/dev/null; _fx_track "$L2"
  tmux -L "$L2" new-window -t t -n wk cat 2>/dev/null
  tmux -L "$L2" new-window -t t -n em cat 2>/dev/null
  tmux -L "$L2" new-window -t t -n ob cat 2>/dev/null
  cap_tail(){ tmux -L "$L2" capture-pane -t "$RFPANE" -p 2>/dev/null | grep -vE '^[[:space:]]*$' | tail -8; }
  # fixture 1 — STALL: pasted text still on the ❯ line + expand hint → HOLDS (would re-fire)
  RFPANE="t:0.0"; tmux -L "$L2" send-keys -t "$RFPANE" '❯ run the dispatched task now ⏎ paste again to expand' 2>/dev/null; sleep 0.2
  composer_holds_text || { echo "  FAIL: re-fire — stalled composer (text on ❯) must read HOLDS-TEXT"; rf=1; }
  # fixture 2 — WORKING: live engine counter → NOT held (re-firing would double-submit)
  RFPANE="t:wk.0"; tmux -L "$L2" send-keys -t "$RFPANE" '✶ Working… (3s · ↑ 1k tokens · esc to interrupt)' 2>/dev/null; sleep 0.2
  composer_holds_text && { echo "  FAIL: re-fire — a WORKING pane must NOT read HOLDS-TEXT (would double-submit)"; rf=1; }
  # fixture 3 — EMPTY composer: a bare '❯' marker with no trailing text → NOT held (no spurious re-fire
  # every tick). (Sent alone: chaining footer+Enter+❯ makes `cat` re-echo the buffered line and doubles
  # it onto the ❯ line — a fixture artifact, not the real idle state.)
  RFPANE="t:em.0"; tmux -L "$L2" send-keys -t "$RFPANE" '❯' 2>/dev/null; sleep 0.2
  composer_holds_text && { echo "  FAIL: re-fire — an empty ❯ composer must NOT read HOLDS-TEXT (would fire every tick)"; rf=1; }
  # TRANSCRIPT ECHO is not the composer (chat-review/a-stranded-composer-outlives-every-ladder-that-
  # would-clear-it). claude echoes every SUBMITTED prompt back with the same '❯' marker, so the tail
  # of a healthy window carries old marker lines above an empty composer. Measured live on tg:
  # composer '❯'+NBSP, transcript '❯ /clear' two lines up → the pre-fix predicate said HOLDS forever.
  # Under the periodic sweep this predicate feeds, that is a re-drive into a healthy mind every pass.
  tmux -L "$L2" new-window -t t -n ec cat 2>/dev/null
  RFPANE="t:ec.0"
  tmux -L "$L2" send-keys -t "$RFPANE" '❯ /clear' C-m 2>/dev/null; sleep 0.2
  tmux -L "$L2" send-keys -t "$RFPANE" "❯$(printf '\302\240')" 2>/dev/null; sleep 0.2
  composer_holds_text && { echo "  FAIL: re-fire — an EMPTY composer under a transcript ECHO of a past prompt must NOT read HOLDS-TEXT"; rf=1; }
  # …and the same pane WITH real text in the composer must still read HOLDS: the fix must not have
  # bought its silence by going blind (a guard that can never fire is not a guard).
  tmux -L "$L2" send-keys -t "$RFPANE" 'still unsubmitted' 2>/dev/null; sleep 0.2
  composer_holds_text || { echo "  FAIL: re-fire — real text in the composer under a transcript echo must still read HOLDS-TEXT"; rf=1; }
  # claude's queued-messages PLACEHOLDER is what an EMPTY composer says, not held text (measured on
  # vpn the same hour). Falsify: drop the placeholder case → this arm reads HOLDS.
  tmux -L "$L2" new-window -t t -n ph cat 2>/dev/null
  RFPANE="t:ph.0"; tmux -L "$L2" send-keys -t "$RFPANE" "❯$(printf '\302\240')Press up to edit queued messages" 2>/dev/null; sleep 0.2
  composer_holds_text && { echo "  FAIL: re-fire — the queued-messages placeholder is an EMPTY composer, not held text"; rf=1; }
  # ── THE COLLAPSED-PASTE HINT IS FOOTER CHROME, NOT COMPOSER STATE ─────────────────────────────
  # Every fixture above puts 'paste again to expand' ON the composer line, which is the one place the
  # live pane does NOT put it — [[a-fixture-driven-gate-cannot-cover-the-live-path]] again, and the
  # reason a suite this large stayed green through the measured false STRANDED. These four frames are
  # VERBATIM captures from discover 2026-08-29T10:55Z, taken by a 0.25s sampler running beside a real
  # >1KB send: claude paints the hint in the bottom slot (where '⏵⏵ bypass permissions on …' lives),
  # two lines BELOW the composer's closing border, and leaves it there after the paste is accepted.
  # The pair CHROME/HINT differs in exactly ONE line — the hint slot — and the old predicate answered
  # CLEAR then HOLDS for the same empty composer. Falsify by restoring the whole-tail scan: the two
  # empty-composer arms go red. The two held arms are the control — narrowing must not buy silence.
  _cf(){ printf '%s\n' "● busy-drill2 ack" "$2" \
      "                                      ✘ Auto-update failed · Run claude doctor" \
      "────────────────────────────────────────────────────────────────────────────────" \
      "$1" \
      "────────────────────────────────────────────────────────────────────────────────" \
      "  mesh-home@mesh-home:/home/mesh-home/lte-workstation | Op5:hg | ⧉ discover |…" \
      "  $3"; }
  _HINT='paste again to expand'; _CHROME='⏵⏵ bypass permissions on (shift+tab to cycle) · ← for agents'
  _DONE='✻ Cogitated for 4s · done 10:55 AM'; _SPIN='· Mulling…'
  composer_holds_text "$(_cf "❯ " "$_DONE" "$_CHROME")" \
    && { echo "  FAIL: hint-slot — an empty composer with the NORMAL footer must read CLEAR (control arm)"; rf=1; }
  composer_holds_text "$(_cf "❯ " "$_SPIN" "$_HINT")" \
    && { echo "  FAIL: hint-slot — an empty composer whose FOOTER still carries the collapsed-paste hint read HOLDS; the hint is chrome two lines below the box and survives the accepted paste, so this is the live false STRANDED"; rf=1; }
  composer_holds_text "$(_cf "❯ Press up to edit queued messages" "$_SPIN" "$_HINT")" \
    && { echo "  FAIL: hint-slot — the queued placeholder under a sticky hint footer read HOLDS; this is the verbatim composer the false STRANDED line printed"; rf=1; }
  composer_holds_text "$(_cf "❯ [Pasted text #9]" "$_DONE" "$_HINT")" \
    || { echo "  FAIL: hint-slot — a composer really holding a collapsed paste must still read HOLDS (the narrowing must not go blind)"; rf=1; }
  composer_holds_text "$(_cf "❯ run the dispatched task now ⏎ paste again to expand" "$_DONE" "$_CHROME")" \
    || { echo "  FAIL: hint-slot — the hint ON the composer line must still read HOLDS"; rf=1; }
  # …and with NO composer marker at all the whole-tail scan is unchanged: nothing better to read, so
  # the conservative direction stands.
  composer_holds_text "$(printf '%s\n' 'some pane with no marker at all' '  paste again to expand')" \
    || { echo "  FAIL: hint-slot — with no composer marker the whole-tail hint scan must still read HOLDS"; rf=1; }
  # ── THE COMPLETION LINE IS NOT A WORKING LINE ────────────────────────────────────────────────
  # Every arm above drives a tail carrying a spinner or nothing, which is exactly why a green suite
  # and a blind predicate coexisted through a fix written for this very fault. These arms drive the
  # line a mind shows the REST of the time: the one it prints when a turn ENDS. Real captures, three
  # shapes of it, all carrying the seconds-middot the old expression keyed on.
  for _dl in 'Sauteed for 2m 21s · done 7:51 AM' 'Baked for 11m 56s · done 8:21 AM' 'Churned for 3s · done 8:33 AM'; do
    printf '%s\n' "$_dl" | engine_working \
      && { echo "  FAIL: re-fire — a COMPLETION line read as WORKING ('$_dl'); the engine is FREE there, and calling it busy makes every stranded composer read CLEAR"; rf=1; }
  done
  # …and the guard must not have bought that by going blind: the real working line still reads WORKING.
  # (A predicate that can never say yes is not a fix, it is the opposite failure wearing the same green.)
  for _wl in '✶ Working… (3s · ↑ 1k tokens · esc to interrupt)' '✶ Cogitating… (7s · ↑ 1.4k tokens · esc to interrupt)' 'thinking (12s · esc to stop)'; do
    printf '%s\n' "$_wl" | engine_working \
      || { echo "  FAIL: re-fire — a live WORKING line no longer reads WORKING ('$_wl'); re-firing into a busy engine double-submits"; rf=1; }
  done
  # THE WHOLE POINT, end to end: a composer holding text UNDER a completion line must read HOLDS.
  # This is the state the node was actually in — a finished turn, a stranded prompt — and the state
  # the sweep counted as held=0 on every pass.
  tmux -L "$L2" new-window -t t -n dn cat 2>/dev/null
  RFPANE="t:dn.0"
  tmux -L "$L2" send-keys -t "$RFPANE" 'Churned for 3s · done 8:33 AM' C-m 2>/dev/null; sleep 0.2
  tmux -L "$L2" send-keys -t "$RFPANE" '❯ run the dispatched task now' 2>/dev/null; sleep 0.2
  composer_holds_text || { echo "  FAIL: re-fire — a composer holding text under a COMPLETION line must read HOLDS; this is the live state the sweep scored held=0"; rf=1; }
  # and the same pane with the composer EMPTY under the same completion line must NOT read HOLDS.
  tmux -L "$L2" new-window -t t -n dn2 cat 2>/dev/null
  RFPANE="t:dn2.0"
  tmux -L "$L2" send-keys -t "$RFPANE" 'Churned for 3s · done 8:33 AM' C-m 2>/dev/null; sleep 0.2
  tmux -L "$L2" send-keys -t "$RFPANE" "❯$(printf '\302\240')" 2>/dev/null; sleep 0.2
  composer_holds_text && { echo "  FAIL: re-fire — an EMPTY composer under a completion line must NOT read HOLDS (it would re-drive an idle mind every sweep)"; rf=1; }
  # observable: a real stalled cat pane — text NOT submitted (no trailing Enter). Run the actual retry
  # decision + send, then a sentinel; the sentinel must sit on a LINE BELOW the stall text.
  RFPANE="t:ob.0"; tmux -L "$L2" send-keys -t "$RFPANE" '❯ run the dispatched task now ⏎ paste again to expand' 2>/dev/null; sleep 0.2
  composer_holds_text && tmux -L "$L2" send-keys -t "$RFPANE" C-m 2>/dev/null
  tmux -L "$L2" send-keys -t "$RFPANE" 'SENTINEL_RF' 2>/dev/null; sleep 0.2
  _sl=$(tmux -L "$L2" capture-pane -t "$RFPANE" -p | grep -n 'paste again to expand' | head -1 | cut -d: -f1)
  _snl=$(tmux -L "$L2" capture-pane -t "$RFPANE" -p | grep -n 'SENTINEL_RF' | head -1 | cut -d: -f1)
  { [ -n "$_sl" ] && [ -n "$_snl" ] && [ "$_snl" -gt "$_sl" ]; } || { echo "  FAIL: re-fire — retry C-m did not submit (sentinel not on a new line: stall=$_sl sent=$_snl)"; rf=1; }
  # ── RUNG 3: THE UNTERMINATED-PASTE TERMINATOR (chat-review/a-stranded-composer-outlives-every-
  # ladder-that-would-clear-it). Two arms, on the SAME fixture socket, both REAL observables:
  #  (a) the terminator byte sequence is DELIVERABLE and INERT on a pane that is not mid-paste — it
  #      must not submit, clear or corrupt a composer, because rung 3 fires blind on a stuck pane.
  #  (b) after the terminator, a C-m DOES submit — i.e. the rung ends in a working submit, not in a
  #      pane wedged by our own escape sequence.
  # Falsify (a): send C-m instead of the terminator → the stall line is submitted before the sentinel
  # and the same-line assertion fails.
  tmux -L "$L2" new-window -t t -n r3 cat 2>/dev/null
  RFPANE="t:r3.0"; tmux -L "$L2" send-keys -t "$RFPANE" '❯ a prompt nobody submitted' 2>/dev/null; sleep 0.2
  tmux -L "$L2" send-keys -t "$RFPANE" -H 1b 5b 32 30 31 7e 2>/dev/null; sleep 0.3
  tmux -L "$L2" send-keys -t "$RFPANE" 'TERMINL_INERT' 2>/dev/null; sleep 0.2
  _t3a=$(tmux -L "$L2" capture-pane -t "$RFPANE" -p | grep -c 'a prompt nobody submitted.*TERMINL_INERT')
  [ "${_t3a:-0}" -ge 1 ] || { echo "  FAIL: rung3 — the bracketed-paste terminator was NOT inert: it moved the line (it must never submit or clear a composer)"; rf=1; }
  tmux -L "$L2" send-keys -t "$RFPANE" C-m 2>/dev/null; sleep 0.2
  tmux -L "$L2" send-keys -t "$RFPANE" 'AFTER_TERM' 2>/dev/null; sleep 0.2
  _t3l=$(tmux -L "$L2" capture-pane -t "$RFPANE" -p | grep -n 'TERMINL_INERT' | head -1 | cut -d: -f1)
  _t3n=$(tmux -L "$L2" capture-pane -t "$RFPANE" -p | grep -n 'AFTER_TERM' | head -1 | cut -d: -f1)
  { [ -n "$_t3l" ] && [ -n "$_t3n" ] && [ "$_t3n" -gt "$_t3l" ]; } || { echo "  FAIL: rung3 — C-m after the terminator did not submit (line=$_t3l after=$_t3n): the rung would leave the pane wedged by our own escape"; rf=1; }

  # ── --composer VERDICTS (the predicate mesh-channel-keepalive's sweep asks). Driven over the SAME
  # composer_state() the flag dispatches to, with cap_full/cap_tail pointed at real fixture panes — so
  # a verdict here is the verdict the sweep gets. The end-to-end BLIND arm below proves the FLAG is
  # actually wired to it; without that pair a gate could be green while --composer was never parsed.
  cap_full(){ tmux -L "$L2" capture-pane -t "$RFPANE" -p 2>/dev/null; }
  RFPANE="t:0.0"      # the STALL fixture from above
  _cv="$(composer_state)"; _cr=$?
  [ "$_cr" = 3 ] || { echo "  FAIL: --composer — a stranded composer must be HOLDS/rc 3 (got rc $_cr: $_cv)"; rf=1; }
  case "$_cv" in HOLDS*run\ the\ dispatched\ task*) :;; *) echo "  FAIL: --composer — HOLDS must carry the STRANDED TEXT as its snapshot (got: $_cv)"; rf=1;; esac
  RFPANE="t:wk.0"     # the WORKING fixture
  _cv="$(composer_state)"; _cr=$?
  [ "$_cr" = 0 ] || { echo "  FAIL: --composer — a WORKING pane must be CLEAR/rc 0, never a strand (got rc $_cr: $_cv)"; rf=1; }
  # BLIND must not be reachable from an empty CAPTURE only — assert the word AND that it is not CLEAR.
  cap_full(){ printf ''; }
  _cv="$(composer_state)"; _cr=$?
  [ "$_cr" = 2 ] || { echo "  FAIL: --composer — an unreadable pane must be BLIND/rc 2, never CLEAR (got rc $_cr: $_cv)"; rf=1; }
  case "$_cv" in BLIND*) :;; *) echo "  FAIL: --composer — an unreadable pane must render the word BLIND (got: $_cv)"; rf=1;; esac
  unset -f cap_full
  tmux -L "$L2" kill-server 2>/dev/null

  # ── THE LADDER ITSELF, DRIVEN (chat-review/a-stranded-composer-outlives-every-ladder-that-would-
  # clear-it). Not the decision re-implemented beside it — stall_ladder() is CALLED, with run() and
  # the two CAPTURE seams stubbed, so what is asserted is the shipped code path. run() records every
  # command it is handed; cap_tail replays a scripted FRAME sequence and composer_holds_text a
  # scripted verdict sequence — two independent scripts, because the whole of chat-review/tell-ladder-
  # settle-is-shorter-than-a-paste-accept lives in their DISAGREEMENT: a composer that holds text while
  # the pane is still repainting is not the same state as one that holds text on a pane at rest, and a
  # fixture with only the verdict axis cannot tell them apart. Five arms:
  #  L1 a composer that clears after the first C-m → EXACTLY one rung fires (no gratuitous escalation).
  #  L2 a composer that never clears on a STILL pane → all THREE rungs fire, IN ORDER, and the
  #     terminator's hex bytes reach tmux — this is the arm a deleted rung 3 fails.
  #  L3 the same, and the ladder ENDS with the STRANDED line: a rung that fails silently is the older
  #     defect, so "no rung reached it" must still be said out loud.
  #  L4 THE MEASURED FALSE VERDICT: the composer holds while the pane REPAINTS, then the engine takes
  #     the paste. ZERO rungs, and no STRANDED. Under the old fixed `sleep 0.4` this exact fixture
  #     fired rung 1 on its first look and walked the whole ladder to a false STRANDED — which is the
  #     witness→health send of 2026-08-29T09:57Z, whose prompt was delivered exactly once.
  #  L5 a pane that NEVER stops repainting: the cap elapses → UNSETTLED, zero rungs, and NOT STRANDED.
  #     Not-knowing must be its own word; rendering it as a strand is the thing being fixed.
  # Frames/verdicts pop one per call and the LAST frame repeats forever, so a one-line frames file is
  # a pane at rest and a many-line one is a pane in motion.
  ll=0; _lcmds="${MESH_TEST_TMPD:-/tmp}/ladder.cmds"; _lseq="${MESH_TEST_TMPD:-/tmp}/ladder.seq"
  _lfr="${MESH_TEST_TMPD:-/tmp}/ladder.frames"
  win=vpn; node=local; paneref="vpn.1"; b64="$(printf 'x' | base64)"
  run(){ printf '%s\n' "$1" >> "$_lcmds"; }
  # verdicts are consumed one per call, in order; an exhausted list answers "clear" (rc 1)
  composer_holds_text(){ local v; v="$(head -1 "$_lseq" 2>/dev/null)"; sed -i '1d' "$_lseq" 2>/dev/null; [ "$v" = hold ]; }
  # frames are consumed one per call, but the LAST one repeats (a pane that stopped changing).
  cap_tail(){ local f; f="$(head -1 "$_lfr" 2>/dev/null)"
              [ "$(wc -l < "$_lfr" 2>/dev/null || echo 0)" -gt 1 ] && sed -i '1d' "$_lfr"
              printf '%s\n' "$f"; }
  cap_full(){ printf '❯ the stranded prompt\n'; }
  # 10 polls of 0.01s: enough resolution for a transient, ~0.1s of wall-clock per drive.
  _LS(){ MESH_TELL_LADDER_SETTLE=0.01 MESH_TELL_LADDER_SETTLE_MAX=0.1 stall_ladder 2>&1; }
  # L1 — a STILL pane, held through one rung, then the engine takes it: one rung, and NOT the terminator.
  printf 'still\n' > "$_lfr"; printf 'hold\nhold\nclear\n' > "$_lseq"; : > "$_lcmds"
  _l1="$(_LS)"
  [ "$(grep -c . "$_lcmds")" = 1 ] || { echo "  FAIL: ladder — a composer that clears after rung 1 must not escalate ($(grep -c . "$_lcmds") commands sent)"; ll=1; }
  grep -q '1b 5b 32 30 31 7e' "$_lcmds" && { echo "  FAIL: ladder — rung 3 fired on a composer that had already cleared"; ll=1; }
  # L2 — a STILL pane that never clears: three rungs, in order, terminator present.
  printf 'still\n' > "$_lfr"; printf 'hold\nhold\nhold\nhold\nhold\nhold\nhold\nhold\n' > "$_lseq"; : > "$_lcmds"
  _l2="$(_LS)"
  [ "$(grep -c . "$_lcmds")" = 3 ] || { echo "  FAIL: ladder — a never-clearing composer on a pane at REST must drive all THREE rungs (got $(grep -c . "$_lcmds"))"; ll=1; }
  _r1=$(grep -n 'C-m$' "$_lcmds" | head -1 | cut -d: -f1)
  _r2=$(grep -n 'paste-buffer' "$_lcmds" | head -1 | cut -d: -f1)
  _r3=$(grep -n '1b 5b 32 30 31 7e' "$_lcmds" | head -1 | cut -d: -f1)
  { [ -n "$_r1" ] && [ -n "$_r2" ] && [ -n "$_r3" ] && [ "$_r1" -lt "$_r2" ] && [ "$_r2" -lt "$_r3" ]; } \
    || { echo "  FAIL: ladder — rung ORDER is not C-m → re-paste → paste-terminator (got $_r1/$_r2/$_r3)"; ll=1; }
  # L3 — the last word. A ladder that exhausts itself in silence is the older defect.
  case "$_l2" in *"STILL holds the prompt after all three rungs"*) :;; *) echo "  FAIL: ladder — a composer stranded past every rung on a pane at REST must SAY so (got: $_l2)"; ll=1;; esac
  case "$_l2" in *"composer: "*"stranded prompt"*) :;; *) echo "  FAIL: ladder — the STRANDED line must carry the composer's own content, so a reader can see whether what is held is the ORIGINAL prompt (got: $_l2)"; ll=1;; esac
  case "$_l1" in *"STILL holds the prompt after all three rungs"*) echo "  FAIL: ladder — a prompt that SUBMITTED must never be announced as stranded"; ll=1;; *) :;; esac
  # L4 — THE MEASURED FALSE VERDICT. Pane REPAINTING while the composer still holds (the engine is
  # ingesting a >1KB paste), then the paste is accepted. Falsify by restoring a fixed settle — a
  # single look answers "holds" and rung 1 fires on a prompt that was about to be delivered.
  printf 'ingest-a\ningest-b\ningest-c\ningest-d\n' > "$_lfr"; printf 'hold\nhold\nclear\n' > "$_lseq"; : > "$_lcmds"
  _l4="$(_LS)"
  [ "$(grep -c . "$_lcmds")" = 0 ] || { echo "  FAIL: ladder — a composer that still holds while the pane is REPAINTING is a paste being ingested, not a strand: no rung may fire (got $(grep -c . "$_lcmds") commands: $(tr '\n' '|' < "$_lcmds"))"; ll=1; }
  case "$_l4" in *STRANDED*) echo "  FAIL: ladder — a prompt DELIVERED after the engine finished ingesting was announced STRANDED (got: $_l4)"; ll=1;; *) :;; esac
  case "$_l4" in *UNSETTLED*) echo "  FAIL: ladder — a paste that WAS accepted inside the cap must end silent, not UNSETTLED (got: $_l4)"; ll=1;; *) :;; esac
  # L5 — the cap elapses on a pane that never stops repainting. UNSETTLED is its own word: no rung
  # (escalating into a repainting pane is how the measured incident re-pasted into a consumed
  # composer) and emphatically no STRANDED (we do not know, and STRANDED means not-delivered).
  : > "$_lfr"; for _f in $(seq 1 40); do printf 'churn-%s\n' "$_f" >> "$_lfr"; done
  : > "$_lseq"; for _f in $(seq 1 40); do printf 'hold\n' >> "$_lseq"; done
  : > "$_lcmds"
  _l5="$(_LS)"
  [ "$(grep -c . "$_lcmds")" = 0 ] || { echo "  FAIL: ladder — a pane still repainting at the cap must not be escalated into (got $(grep -c . "$_lcmds") commands)"; ll=1; }
  case "$_l5" in *UNSETTLED*) :;; *) echo "  FAIL: ladder — a settle cap that elapsed on a repainting pane must SAY so; silence is indistinguishable from delivery (got: $_l5)"; ll=1;; esac
  case "$_l5" in *STRANDED*) echo "  FAIL: ladder — an UNSETTLED pane must never be announced STRANDED: that is the false not-delivered verdict callers act on (got: $_l5)"; ll=1;; *) :;; esac
  unset -f run composer_holds_text cap_tail cap_full _LS
  [ "$ll" = 0 ] || { echo "smoke-test: FAIL (stall ladder regressed — see asserts above)"; exit 1; }
  [ "$rf" = 0 ] || { echo "smoke-test: FAIL (stall re-fire / rung3 / --composer regressed — see asserts above)"; exit 1; }

  # ── --composer IS WIRED (end-to-end, the REAL script, no overrides). A window that cannot exist on
  # this node's session gives a deterministic BLIND: it proves the flag is parsed, the dispatch is
  # reached before the empty-prompt refusal, and the rc/word contract survives the whole argv path.
  # This is the leg that a "the function is fine but the flag was never wired" regression fails.
  _cw="mtell-nosuch-window-$$"
  _ce="$("$0" --composer "$_cw" 2>/dev/null)"; _cerc=$?
  [ "$_cerc" = 2 ] || { echo "smoke-test: FAIL (--composer not wired: a nonexistent window must exit 2 BLIND, got rc $_cerc: $_ce)"; exit 1; }
  case "$_ce" in BLIND*) :;; *) echo "smoke-test: FAIL (--composer not wired: expected a BLIND line, got '$_ce')"; exit 1;; esac

  # ── NO-ACK EVIDENCE SNAPSHOT (chat-review/noack-pane-tail-selects-the-tui-footer-and-cuts-by-bytes) ─
  # Driven over REAL tmux panes, never a hand-written pane string: the defect being fixed lives in the
  # SELECTION (which lines of a real frame get picked) and in the CUT (bytes vs characters, against a
  # frame whose bottom lines are right-aligned padding), and a fixture that hands the builder a tidy
  # composer line cannot see either. Panes are rendered by `cat <frame>; sleep` — not send-keys into
  # `cat`, whose echo duplicates every line and scrolls the transcript the empty-composer arm needs.
  # The frame is the live claude TUI's own shape: transcript · box border · '❯' + NBSP · box border ·
  # status bar (which itself carries '▌', the glyph the old byte-cut used to ship as "evidence") ·
  # permissions hint · right-aligned update banner · right-aligned mode indicator.
  sf=0; Ls="mtellsnap$$"; _sd="$(mktemp -d)"
  _snap_frame(){   # $1=file $2=width $3=composer-line
    local w="$2" bar=""; local i=0
    while [ "$i" -lt $((w-4)) ]; do bar="$bar─"; i=$((i+1)); done
    { printf '%s\n' '● landed the fix and deployed it'
      printf '\n'
      printf '%s\n' "$bar"
      printf '%s\n' "$3"
      printf '%s\n' "$bar"
      printf '%s\n' '  mesh-home@mesh-home:/home/mesh-home/lte-workstation | Op5:hg | ⧉ genome | ▌░░░ 194k/1M'
      printf '%s\n' '  ⏵⏵ bypass permissions on · 1 shell · ← for agents'
      printf '%*s\n' $((w-40)) '✔ Update installed · Restart to update'
      printf '%*s\n' $((w-4))  '/rc'
    } >"$1"
  }
  _snap_frame "$_sd/empty" 100 "❯ $(printf ' ')"          # claude pads its marker with a NBSP, not a space
  _snap_frame "$_sd/held"  100 '❯ run the dispatched task now ⏎ paste again to expand'
  _snap_frame "$_sd/wide"  160 "❯ $(printf ' ')"
  printf '\n\n\n' >"$_sd/blank"
  tmux -L "$Ls" new-session -d -s t -x 100 -y 18 "cat $_sd/empty; sleep 60" 2>/dev/null; _fx_track "$Ls"
  tmux -L "$Ls" new-window -t t -n held  "cat $_sd/held;  sleep 60" 2>/dev/null
  tmux -L "$Ls" new-window -t t -n blank "cat $_sd/blank; sleep 60" 2>/dev/null
  # the WIDE arm gets its OWN session: windows in one session share its size, and the whole point of
  # this arm is a frame wide enough that the old byte-cut lands entirely inside right-alignment padding.
  tmux -L "$Ls" new-session -d -s wide -x 160 -y 18 "cat $_sd/wide; sleep 60" 2>/dev/null
  sleep 0.6
  _snap_of(){ tmux -L "$Ls" capture-pane -t "$1" -p 2>/dev/null | compose_snapshot "${2:-120}"; }
  # the OLD builder, verbatim, over the SAME real capture — the arm that must be seen to FAIL
  _snap_old(){ tmux -L "$Ls" capture-pane -t "$1" -p 2>/dev/null | grep -vE '^[[:space:]]*$' | tail -8 | tail -3 | tr '\n' '¦' | tail -c 120; }
  _nonspace(){ printf '%s' "$1" | tr -d '[:space:]¦'; }

  # (a) HELD composer — the actual NO-ACK case: the snapshot must carry the STRANDED PROMPT, which is
  # the one thing that makes the verdict diagnosable, and none of the chrome the old cut shipped.
  _sh="$(_snap_of t:held.0)"
  case "$_sh" in *'run the dispatched task now'*) :;;
    *) echo "  FAIL: snapshot — a held composer must carry the stranded prompt text (got: [$_sh])"; sf=1;; esac
  case "$_sh" in *'Update installed'*|*'/rc'*|*'Op5:hg'*|*'bypass permissions'*)
    echo "  FAIL: snapshot — evidence must be the COMPOSER, not the TUI footer/status bar (got: [$_sh])"; sf=1;; esac
  # (b) EMPTY composer — real evidence, but useless alone: it must SAY empty and carry the last
  # transcript line. This is the 9-of-12 case; an empty field is what made those verdicts undiagnosable.
  _se="$(_snap_of t:0.0)"
  [ -n "$(_nonspace "$_se")" ] || { echo "  FAIL: snapshot — must never render whitespace-only (empty-composer pane)"; sf=1; }
  case "$_se" in *'empty'*) :;; *) echo "  FAIL: snapshot — an empty composer must say so (got: [$_se])"; sf=1;; esac
  case "$_se" in *'landed the fix and deployed it'*) :;;
    *) echo "  FAIL: snapshot — an empty composer must carry the last transcript line (got: [$_se])"; sf=1;; esac
  # (c) THE CONTROL ARM — the old selection over the same REAL wide capture carries essentially nothing
  # (measured live: 9 of 12 board lines rendered an empty pane-tail). If this ever stops failing, the
  # fixture has stopped reproducing the defect and arms (a)/(b) are proving nothing.
  _ow="$(_snap_old wide:0.0)"; _nw="$(_snap_of wide:0.0)"
  if [ "$(printf '%s' "$(_nonspace "$_ow")" | wc -c)" -gt 4 ]; then
    echo "  FAIL: snapshot — CONTROL: the old bottom-3/byte-cut builder must still render (near-)nothing on a wide real pane, else this fixture no longer reproduces the defect (old: [$_ow])"; sf=1
  fi
  case "$_nw" in *'landed the fix and deployed it'*) :;;
    *) echo "  FAIL: snapshot — the new builder must recover real evidence from the same wide pane the old one blanked (got: [$_nw])"; sf=1;; esac
  # (d) BLANK pane — a capture with nothing in it (an absent window renders this too) must be an
  # explicit claim, not an empty field indistinguishable from "the builder silently produced nothing".
  _sb="$(_snap_of t:blank.0)"
  [ -n "$(_nonspace "$_sb")" ] || { echo "  FAIL: snapshot — a blank pane must render an explicit claim, not an empty field"; sf=1; }
  # (e) CUT BY CHARACTERS, and the output must stay valid UTF-8. A 120-BYTE cut of a pane full of
  # box-drawing and cyrillic keeps ~40 glyphs and can split the last one; assert the char count.
  _slong="$(printf '❯ ')$(for _i in $(seq 1 40); do printf 'мир❯'; done)"
  _sc="$(printf '%s\n' "$_slong" | compose_snapshot 40)"
  _scn="$(printf '%s' "$_sc" | LC_ALL=C.UTF-8 awk '{print length($0)}' 2>/dev/null)"
  [ "$_scn" = 41 ] || { echo "  FAIL: snapshot — must cut by CHARACTERS (40 + the ellipsis = 41, got $_scn: [$_sc])"; sf=1; }
  printf '%s' "$_sc" | iconv -f UTF-8 -t UTF-8 >/dev/null 2>&1 \
    || { echo "  FAIL: snapshot — a truncated snapshot must remain valid UTF-8 (got: [$_sc])"; sf=1; }
  # (f) the --pane-snapshot seam is what another tool's --test drives; it must render the same thing.
  _ss="$(tmux -L "$Ls" capture-pane -t t:held.0 -p 2>/dev/null | "$0" --pane-snapshot -)"
  [ "$_ss" = "$_sh" ] || { echo "  FAIL: snapshot — --pane-snapshot must render what the send path renders (seam: [$_ss] vs [$_sh])"; sf=1; }
  tmux -L "$Ls" kill-server 2>/dev/null; rm -rf "$_sd"
  [ "$sf" = 0 ] || { echo "smoke-test: FAIL (NO-ACK evidence snapshot regressed — see asserts above)"; exit 1; }

  # ── COPY-MODE WEDGE GUARD (meshtell-copymode-wedge-guard) ────────────────────────────────────────
  # A pane in tmux copy-mode EATS send-keys — C-u/paste/C-m drive the copy-cursor, not the process — so
  # the prompt strands and the C-m re-fire is a no-op (health-pane wedge 2026-07-24). The pre-inject
  # `send-keys -X cancel` exits the mode. Assert the load-bearing fact deterministically (the mode flag),
  # then that key DELIVERY to the pane's `cat` resumes after the cancel. RED-first: at entry the pane is
  # in mode (in_mode=1, the wedged state); the guard is what flips it to 0 — break `cancel` and this REDs.
  cm=0; Lc="mtellcm$$"
  tmux -L "$Lc" new-session -d -s t -x 100 -y 12 cat 2>/dev/null; _fx_track "$Lc"
  CMPANE="t:0.0"
  tmux -L "$Lc" copy-mode -t "$CMPANE" 2>/dev/null; sleep 0.2
  # entry = the WEDGED state (in_mode=1): send-keys here would be eaten, the bug the guard fixes.
  [ "$(tmux -L "$Lc" display-message -p -t "$CMPANE" '#{pane_in_mode}')" = 1 ] \
    || { echo "  FAIL: copy-mode — fixture pane did not enter copy-mode (wedge premise)"; cm=1; }
  # THE GUARD (the exact verb mesh-tell prepends to the inject): cancel exits the mode →
  tmux -L "$Lc" send-keys -t "$CMPANE" -X cancel 2>/dev/null; sleep 0.2
  [ "$(tmux -L "$Lc" display-message -p -t "$CMPANE" '#{pane_in_mode}')" = 0 ] \
    || { echo "  FAIL: copy-mode — send-keys -X cancel did not exit the mode (guard no-op → prompt strands)"; cm=1; }
  # delivery restored: keys now reach the pane's process (cat echoes the submitted line); eaten while wedged.
  tmux -L "$Lc" send-keys -t "$CMPANE" -l 'DELIVERED_AFTER_CANCEL' 2>/dev/null
  tmux -L "$Lc" send-keys -t "$CMPANE" C-m 2>/dev/null; sleep 0.3
  tmux -L "$Lc" capture-pane -t "$CMPANE" -p 2>/dev/null | grep -q 'DELIVERED_AFTER_CANCEL' \
    || { echo "  FAIL: copy-mode — keys did NOT reach the process after -X cancel (guard ineffective)"; cm=1; }
  # the guard is a harmless no-op on a NORMAL (already-cancelled) pane — never fatal.
  tmux -L "$Lc" send-keys -t "$CMPANE" -X cancel 2>/dev/null || true
  tmux -L "$Lc" kill-server 2>/dev/null
  [ "$cm" = 0 ] || { echo "smoke-test: FAIL (copy-mode wedge guard regressed — see asserts above)"; exit 1; }

  # ── DEAD-SHELL guard (chat-review/shed-pane-dead-shell-misclassified 2026-07-07) ─────────────────
  # mesh-mind-state is stubbed as a shell function (bash resolves function names before PATH commands
  # — same convention mesh-mind-state's OWN --test uses to stub mesh-chat/mesh-trace) so this is
  # hermetic, no dependency on a live pane in either state.
  gf=0
  mesh-mind-state(){ printf 'DEAD-SHELL\tbare shell — no mind-engine process on this pane'"'"'s tty (shed/killed)\n'; return 8; }
  _g="$(dead_shell_guard fakewin local)"; _grc=$?
  [ "$_grc" -ne 0 ] || { echo "  FAIL: dead_shell_guard must refuse on DEAD-SHELL"; gf=1; }
  case "$_g" in *DEAD-SHELL*) :;; *) echo "  FAIL: guard message missing DEAD-SHELL evidence: $_g"; gf=1;; esac
  # AUTH-DEAD (chat-review/mindstate-loggedout-not-idle): a logged-out pane must be refused too — a send
  # into it black-holes exactly like a bare shell. Falsify: drop AUTH-DEAD* from the guard's case → allows.
  mesh-mind-state(){ printf 'AUTH-DEAD\tNot logged in · Please run /login\n'; return 9; }
  _ga="$(dead_shell_guard fakewin local)"; _garc=$?
  [ "$_garc" -ne 0 ] || { echo "  FAIL: dead_shell_guard must refuse on AUTH-DEAD (logged-out pane)"; gf=1; }
  case "$_ga" in *AUTH-DEAD*) :;; *) echo "  FAIL: guard message missing AUTH-DEAD evidence: $_ga"; gf=1;; esac
  mesh-mind-state(){ printf 'IDLE\tready prompt, no turn running\n'; return 0; }
  _g2="$(dead_shell_guard fakewin local)"; _g2rc=$?
  [ "$_g2rc" -eq 0 ] || { echo "  FAIL: dead_shell_guard must allow a healthy IDLE window"; gf=1; }
  # escape hatch: MESH_TELL_ALLOW_SHELL=1 bypasses even a DEAD-SHELL verdict
  mesh-mind-state(){ printf 'DEAD-SHELL\tbare shell\n'; return 8; }
  MESH_TELL_ALLOW_SHELL=1 dead_shell_guard fakewin local >/dev/null \
    || { echo "  FAIL: MESH_TELL_ALLOW_SHELL=1 must bypass the guard"; gf=1; }
  unset -f mesh-mind-state
  [ "$gf" = 0 ] || { echo "smoke-test: FAIL (dead_shell_guard drifted)"; exit 1; }
  # end-to-end: the actual send path must refuse and exit non-zero WITHOUT ever calling tmux send-keys
  # (falsify: remove the guard call and this would instead attempt a real send into a bogus window —
  # harmless here since the window doesn't exist, but the REFUSED message + exit code prove the gate
  # fires before the send, not after a failed one).
  mesh-mind-state(){ printf 'DEAD-SHELL\tbare shell\n'; return 8; }
  export -f mesh-mind-state
  _e2e="$("$0" "mtell-dead-shell-fixture-$$" "would you like some rm -rf" 2>&1)"; _e2erc=$?
  unset -f mesh-mind-state
  case "$_e2e" in *REFUSED*) :;; *) echo "smoke-test: FAIL (end-to-end send did not refuse on DEAD-SHELL: $_e2e)"; exit 1;; esac
  [ "$_e2erc" -ne 0 ] || { echo "smoke-test: FAIL (end-to-end refused send must exit non-zero)"; exit 1; }

  # ── SHED-COOLDOWN gate (chat-review/shed-pane-consumed-while-paused, minds 2026-07-19 10:33) ─────
  # Uses a REAL rlmark file at $HOME/.mesh/.rl-cooldown-<win> (the exact path/writer channel-
  # keepalive:525 uses), not a function stub — so the test exercises the REAL shed_cooldown (local
  # bash -c branch + cut/date logic), not a parallel mock that could drift from the implementation.
  # The bug it prevents: a SHED pane's engine was killed by channel-keepalive → typing a consume-prompt
  # into the bare shell → bash runs it as a command → syntax-errors scroll the SHED banner off →
  # mesh-mind-state's f70b154 banner-grep returns DEAD-SHELL again. The rlmark is the writer's truth.
  sf=0
  _shedwin="mtell-shed-unit-$$"
  _shedmark="$HOME/.mesh/.rl-cooldown-$_shedwin"
  # fixture 1 — ACTIVE cooldown (resume in the future): dead_shell_guard REFUSES with SHED evidence,
  #   even when mesh-mind-state says IDLE — proves the SHED gate fires BEFORE the mind-state check.
  echo "$(( $(date +%s) + 1800 ))|1" > "$_shedmark"
  mesh-mind-state(){ printf 'IDLE\tready prompt\n'; return 0; }
  _sh="$(dead_shell_guard "$_shedwin" local)"; _shrc=$?
  [ "$_shrc" -ne 0 ] || { echo "  FAIL: SHED guard must refuse on active cooldown even when mesh-mind-state says IDLE"; sf=1; }
  case "$_sh" in *SHED*) :;; *) echo "  FAIL: guard message missing SHED evidence: $_sh"; sf=1;; esac
  # fixture 2 — EXPIRED cooldown (resume in the past) + IDLE: must NOT refuse on SHED grounds.
  echo "$(( $(date +%s) - 60 ))|1" > "$_shedmark"
  _sh2="$(dead_shell_guard "$_shedwin" local)"; _sh2rc=$?
  [ "$_sh2rc" -eq 0 ] || { echo "  FAIL: expired SHED cooldown + IDLE must allow send (got: $_sh2)"; sf=1; }
  # fixture 3 — escape hatch: MESH_TELL_ALLOW_SHED=1 bypasses even an active cooldown.
  echo "$(( $(date +%s) + 1800 ))|1" > "$_shedmark"
  MESH_TELL_ALLOW_SHED=1 dead_shell_guard "$_shedwin" local >/dev/null \
    || { echo "  FAIL: MESH_TELL_ALLOW_SHED=1 must bypass the SHED gate"; sf=1; }
  # fixture 4 — absent rlmark: must NOT refuse on SHED grounds (fail-open on missing state file).
  rm -f "$_shedmark"
  _sh4="$(dead_shell_guard "$_shedwin" local)"; _sh4rc=$?
  [ "$_sh4rc" -eq 0 ] || { echo "  FAIL: absent rlmark must fail-open (no SHED refuse), got: $_sh4"; sf=1; }
  # fixture 5 — RATE-LIMITED defense-in-depth: even when shed_cooldown is INACTIVE (no rlmark), a
  #   RATE-LIMITED verdict from mesh-mind-state's f70b154 banner-grep must still refuse.
  mesh-mind-state(){ printf 'RATE-LIMITED\t--- SHED until 14:32Z (rate-limit wall, shed #1) ---\n'; return 6; }
  _rl="$(dead_shell_guard "$_shedwin" local)"; _rlrc=$?
  [ "$_rlrc" -ne 0 ] || { echo "  FAIL: RATE-LIMITED verdict must refuse (defense-in-depth with rlmark gate)"; sf=1; }
  case "$_rl" in *RATE-LIMITED*) :;; *) echo "  FAIL: guard message missing RATE-LIMITED evidence: $_rl"; sf=1;; esac
  unset -f mesh-mind-state
  rm -f "$_shedmark"
  [ "$sf" = 0 ] || { echo "smoke-test: FAIL (SHED-cooldown gate drifted)"; exit 1; }

  # ── WAL injection log (STUDY write-ahead log 2026-07-20) ──────────────────────────────────────────
  # The coordinator's sends were traceless — no record of WHAT was injected into WHICH mind, so a
  # rogue/duplicated dispatch could never be audited post-hoc. WAL semantics: the INTENT is appended
  # BEFORE any guard/send acts, the OUTCOME (sent/refused) after — a crash mid-send leaves an
  # intent with no outcome, which --replay renders as UNRESOLVED (that dangling line IS the audit
  # evidence an injection was attempted). Legs seen RED-first against the pre-WAL code.
  wlf=0
  # leg 1 — unit round-trip: intent+sent for a window replays with the DECODED prompt + sent outcome
  wal_append intent "walunit-$$" local "$(printf 'replay me\nline2' | base64 | tr -d '\n')"
  wal_append sent   "walunit-$$" local -
  _rp="$("$0" --replay -n 5 "walunit-$$")"
  case "$_rp" in *'replay me¦line2'*) :;; *) echo "  FAIL: WAL replay must decode the logged prompt (got: $_rp)"; wlf=1;; esac
  case "$_rp" in *sent*) :;; *) echo "  FAIL: WAL replay must show the sent outcome (got: $_rp)"; wlf=1;; esac
  # leg 2 — UNRESOLVED: an intent with NO outcome line (crashed/killed mid-send) must be flagged, not
  # silently rendered like a completed send. Falsify: a replay that ignores outcome matching shows blank.
  wal_append intent "walunres-$$" local "$(printf 'stranded' | base64)"
  _rp2="$("$0" --replay -n 5 "walunres-$$")"
  case "$_rp2" in *UNRESOLVED*) :;; *) echo "  FAIL: WAL replay must flag an outcome-less intent UNRESOLVED (got: $_rp2)"; wlf=1;; esac
  # leg 3 — WRITE-AHEAD ordering (the semantics that make it a WAL, not a receipt): the DEAD-SHELL
  # e2e above drove the REAL send path to a refusal — its intent line must exist AND precede its
  # refused line in the log. Falsify: move the intent append below dead_shell_guard → intent absent.
  _ew="mtell-dead-shell-fixture-$$"
  _wi="$(awk -F'\t' -v w="$_ew" '$3=="intent"  && $6==w {print NR; exit}' "$MESH_TELL_WAL")"
  _wr="$(awk -F'\t' -v w="$_ew" '$3=="refused" && $6==w {print NR; exit}' "$MESH_TELL_WAL")"
  { [ -n "$_wi" ] && [ -n "$_wr" ] && [ "$_wi" -lt "$_wr" ]; } \
    || { echo "  FAIL: write-ahead ordering — refused e2e send must log intent BEFORE refusal (intent=$_wi refused=$_wr)"; wlf=1; }
  # ── WAL LOGGING LEVELS (STUDY write-ahead log 2026-08-15) ───────────────────────────────────────
  # Every leg drives a REAL send in a CHILD process — not wal_append in-process — because the level
  # is resolved once and cached per process: an in-process leg would silently test the FIRST level
  # it ever saw and go green for all four. Each child sends to a window that does not exist, so
  # dead_shell_guard refuses and the run journals intent+refused without needing a tmux fixture.
  _lvd="$(mktemp -d)"; _lvw="mtell-level-fixture-$$"
  # the same payload shape leg 3 uses: dead_shell_guard REFUSES it, so each child produces a real
  # intent+outcome pair. (A benign payload to a missing window exits 0 having journalled only the
  # intent — pre-existing behaviour, and exactly the dangling-intent case --replay calls UNRESOLVED.)
  _lvtext='would you like some rm -rf'
  # …and the same DEAD-SHELL stub, exported into the child: that verdict is what makes the guard
  # refuse, so every level fixture produces an intent AND its outcome.
  mesh-mind-state(){ printf 'DEAD-SHELL\tbare shell\n'; return 8; }
  export -f mesh-mind-state
  printf '# fixture node config\n' > "$_lvd/nodes"
  # <level> [extra env assignments...] → returns the log path it wrote
  _lvrun(){ local lv="$1"; shift
    rm -f "$_lvd/w" "$_lvd/w.level"
    env MESH_TELL_WAL="$_lvd/w" MESH_TELL_NODES="$_lvd/nodes" MESH_TELL_WAL_LEVEL="$lv" "$@" \
      "$0" "$_lvw" "$_lvtext" >/dev/null 2>"$_lvd/err" || true
  }
  _lvfield(){ awk -F'\t' -v w="$_lvw" '$3=="intent" && $6==w {print $7; exit}' "$_lvd/w"; }
  # leg 5 — redact: the record and its ordering survive, the prompt text does not; the digest is a
  # REPRODUCIBLE identity (hash the candidate b64 and compare), not a placeholder.
  _lvrun redact
  _lvp="$(_lvfield)"
  _lvexp="r:$(printf '%s' "$(printf '%s' "$_lvtext" | base64 | tr -d '\n')" | sha256sum | cut -c1-8):$(printf '%s' "$_lvtext" | base64 | tr -d '\n' | wc -c)"
  [ "$_lvp" = "$_lvexp" ] || { echo "  FAIL: WAL level=redact must journal the reproducible digest (want $_lvexp, got $_lvp)"; wlf=1; }
  grep -qF -- "$_lvtext" "$_lvd/w" && { echo "  FAIL: WAL level=redact leaked the prompt text into the log"; wlf=1; }
  grep -q "$(printf '%s' "$_lvtext" | base64 | tr -d '\n')" "$_lvd/w" && { echo "  FAIL: WAL level=redact left the b64 payload in the log"; wlf=1; }
  # leg 6 — the ORDERING invariant a level must never break: intent still precedes the outcome
  _lvi="$(awk -F'\t' -v w="$_lvw" '$3=="intent"  && $6==w {print NR; exit}' "$_lvd/w")"
  _lvr="$(awk -F'\t' -v w="$_lvw" '$3=="refused" && $6==w {print NR; exit}' "$_lvd/w")"
  { [ -n "$_lvi" ] && [ -n "$_lvr" ] && [ "$_lvi" -lt "$_lvr" ]; } \
    || { echo "  FAIL: a thinned level broke write-ahead ordering (intent=$_lvi refused=$_lvr) — a level may thin the payload, never the record"; wlf=1; }
  # leg 7 — minimal: payload gone entirely, record still there
  _lvrun minimal
  [ "$(_lvfield)" = "-" ] || { echo "  FAIL: WAL level=minimal must journal the record with an empty payload (got: $(_lvfield))"; wlf=1; }
  # leg 8 — off: NO send record at all, and EXACTLY ONE level marker saying so (a gap in the log
  # must be explained IN the log, else a silenced journal reads as a node that sent nothing)
  _lvrun off
  [ -z "$(_lvfield)" ] || { echo "  FAIL: WAL level=off journalled a send record"; wlf=1; }
  [ "$(awk -F'\t' '$3=="level"' "$_lvd/w" | wc -l)" = 1 ] \
    || { echo "  FAIL: WAL level=off must leave exactly one level marker explaining the silence (got $(awk -F'\t' '$3=="level"' "$_lvd/w" | wc -l))"; wlf=1; }
  # the marker's OWN fields, asserted at the writer (leg 9 asserts the reader): pid and win must be
  # `-`, which is what makes it unjoinable by the pid+win outcome lookup.
  [ "$(awk -F'\t' '$3=="level"{print $2"/"$6; exit}' "$_lvd/w")" = "-/-" ] \
    || { echo "  FAIL: a level marker must carry '-' for pid and win (got $(awk -F'\t' '$3=="level"{print $2"/"$6; exit}' "$_lvd/w")) — anything else can be joined as an outcome"; wlf=1; }
  # leg 9 — a level marker must never be joinable as an OUTCOME: it carries `-` for pid and win, so
  # an intent with no real outcome stays UNRESOLVED even with a marker sitting after it.
  _lvrun minimal
  printf '%s\t-\tlevel\ttester\t-\t-\tminimal->full\n' "$(date -u +%FT%TZ)" >> "$_lvd/w"
  awk -F'\t' -v w="$_lvw" '$3=="refused" && $6==w {next} {print}' "$_lvd/w" > "$_lvd/w2"; mv "$_lvd/w2" "$_lvd/w"
  case "$(MESH_TELL_WAL="$_lvd/w" MESH_TELL_NODES="$_lvd/nodes" "$0" --replay -n 5 "$_lvw")" in
    *UNRESOLVED*) :;;
    *) echo "  FAIL: a level marker was joined as an outcome — an outcome-less intent must stay UNRESOLVED"; wlf=1;;
  esac
  # leg 10 — replay renders a thinned payload as an explicit claim, never as an empty column
  _lvrun redact
  _lvrp="$(MESH_TELL_WAL="$_lvd/w" MESH_TELL_NODES="$_lvd/nodes" "$0" --replay -n 5 "$_lvw")"
  case "$_lvrp" in *redacted*) :;; *) echo "  FAIL: --replay must render a redacted payload as «redacted …», not blank (got: $_lvrp)"; wlf=1;; esac
  case "$_lvrp" in *'level: '*) :;; *) echo "  FAIL: --replay must announce a non-default level (got: $_lvrp)"; wlf=1;; esac
  # …and the MINIMAL rendering needs its own assert: a leg that only covers `redact` leaves the other
  # thinned branch free to render blank — which is the exact failure this rule exists to prevent.
  # (Found by a surviving mutant that blanked this branch while every other leg stayed green.)
  _lvrun minimal
  case "$(MESH_TELL_WAL="$_lvd/w" MESH_TELL_NODES="$_lvd/nodes" "$0" --replay -n 5 "$_lvw")" in
    *'no payload retained'*) :;;
    *) echo "  FAIL: --replay must render a payload-less record as an explicit claim, not a blank column"; wlf=1;;
  esac
  # leg 11 — an UNRECOGNISED level falls back to FULL (a journal fails toward MORE evidence) and SAYS
  # so on stderr. Both halves: a silent fallback to full is the shape this doctrine keeps meeting.
  _lvrun bogus-level
  [ "$(_lvfield)" = "$(printf '%s' "$_lvtext" | base64 | tr -d '\n')" ] \
    || { echo "  FAIL: an unrecognised WAL level must fall back to FULL journalling (got: $(_lvfield))"; wlf=1; }
  grep -q 'unrecognised WAL level' "$_lvd/err" \
    || { echo "  FAIL: an unrecognised WAL level must warn loudly on stderr, not fall back silently"; wlf=1; }
  # leg 12 — the CONFIGURATION half: the level is settable per node in ~/.mesh/nodes, not only by env
  printf 'MESH_TELL_WAL_LEVEL=minimal\n' >> "$_lvd/nodes"
  rm -f "$_lvd/w" "$_lvd/w.level"
  env -u MESH_TELL_WAL_LEVEL MESH_TELL_WAL="$_lvd/w" MESH_TELL_NODES="$_lvd/nodes" "$0" "$_lvw" "$_lvtext" >/dev/null 2>&1 || true
  [ "$(_lvfield)" = "-" ] || { echo "  FAIL: MESH_TELL_WAL_LEVEL in the node config must set the level (got: $(_lvfield))"; wlf=1; }
  # leg 13 — env WINS over the node config (a one-off run must be able to override the node default)
  _lvrun full
  [ "$(_lvfield)" = "$(printf '%s' "$_lvtext" | base64 | tr -d '\n')" ] \
    || { echo "  FAIL: MESH_TELL_WAL_LEVEL in the env must override the node config (got: $(_lvfield))"; wlf=1; }
  # leg 14 — THE DEFAULT IS UNCHANGED: no env, no config key → the same 7-field b64 record as before
  # this feature existed, and NO level marker on a fresh log (the default announces nothing).
  : > "$_lvd/nodes"; rm -f "$_lvd/w" "$_lvd/w.level"
  env -u MESH_TELL_WAL_LEVEL MESH_TELL_WAL="$_lvd/w" MESH_TELL_NODES="$_lvd/nodes" "$0" "$_lvw" "$_lvtext" >/dev/null 2>&1 || true
  [ "$(_lvfield)" = "$(printf '%s' "$_lvtext" | base64 | tr -d '\n')" ] \
    || { echo "  FAIL: the DEFAULT level must journal the full b64 payload exactly as before (got: $(_lvfield))"; wlf=1; }
  [ "$(awk -F'\t' '$3=="level"' "$_lvd/w" | wc -l)" = 0 ] \
    || { echo "  FAIL: the default level must write no marker on a fresh log (silence is the default, not an event)"; wlf=1; }
  unset -f mesh-mind-state
  rm -rf "$_lvd"

  # leg 4 — sandbox honesty: no record written by THIS RUN may reach the REAL injection log.
  #
  # SIZE WAS THE WRONG OBSERVABLE, and this file is the worst possible place for it: mesh-tell is the
  # most-invoked tool on a mind node — every dispatch poke, keepalive and self-continuation appends to
  # the same log WHILE this test runs. A before/after byte compare therefore has two causes and cannot
  # name which one moved it (a-sandbox-honesty-gate-cannot-separate-a-leak-from-a-collision, the shape
  # 75c81a8 hit in mesh-node-health). Measured 2026-08-16: the gate went red at +1241 bytes with
  # nothing wrong — the appended records were live sends to the `witness` pane from the board dispatch
  # that had just assigned this very audit — then passed with delta=0 on the two immediately following
  # runs. mesh-land and mesh-doctor both consume this gate, so that false red STRANDED the tool.
  #
  # Attribute per RECORD instead of by volume: this run exports a run-unique MESH_WHO, so a leaked
  # record NAMES the run that wrote it and a concurrent live send never can — a single sample now
  # decides, with no re-run and no probabilistic tie-break. Scanning by content also survives the
  # log's own retention trim (>4000 lines → keep 2000), which a byte offset would not: a live send
  # that trims mid-test would leave the tail-from-offset read pointing into the middle of a record.
  # Time-scope it to this run so a leak an EARLIER run left behind (its records carry the fixed
  # TESTWHO/OTHERSENDER, not our pid-stamped sentinel) cannot fail us forever for someone else's bug.
  _wal_real_sz2="$({ wc -c < "$_wal_real"; } 2>/dev/null || echo 0)"
  _wal_leaked="$(awk -F'\t' -v t0="$_wal_t0" -v whos=" $_wal_test_whos " \
    '$1 >= t0 && index(whos, " " $4 " ") { print $3 "/" $6 " (who=" $4 ")" }' "$_wal_real" 2>/dev/null | head -3)"
  if [ -n "$_wal_leaked" ]; then
    echo "  FAIL: --test wrote the REAL injection log — record(s) attributable to this run: $(printf '%s' "$_wal_leaked" | tr '\n' ' ')"; wlf=1
  elif [ "$_wal_real_sz2" != "$_wal_real_sz" ]; then
    # Not swallowed: the pass PRINTS why the movement was attributed elsewhere, so a reader is never
    # told "nothing happened" when the artifact did in fact move.
    echo "  note: real injection log moved ($_wal_real_sz → $_wal_real_sz2 bytes) but no record carries this run's sender ($_wal_self_who) — concurrent live sends, not a sandbox leak"
  fi
  [ "$wlf" = 0 ] || { echo "smoke-test: FAIL (WAL injection log regressed — see asserts above)"; exit 1; }

  # ── ARRIVAL PRESSURE (review-second-order-cyb-variety-overflow-2026-08-15) ──────────────────────
  # Fixtures are SYNTHETIC WALs with hand-placed timestamps, so each leg pins one property of the
  # rate rather than whatever the live log happens to hold today. Every leg was seen RED first
  # against a deliberately broken copy (see the doc's mutant table).
  prf=0
  _prd="$(mktemp -d)"
  # _prgen <file> <win> <count> <gap_sec> [dupe] — `sent` records gap_sec apart, one distinct pid
  # each (a fresh pid per arrival is what the live log looks like). dupe=1 adds a SECOND record with
  # the SAME pid 5s later: the retry shape the collapse rule exists to absorb.
  _prgen(){ local f="$1" w="$2" c="$3" gap="$4" dupe="${5:-}" i t base=1785000000
    : > "$f"
    for i in $(seq 1 "$c"); do
      t=$(( base + (i-1)*gap ))
      printf '%s\t%d\tsent\ttester\tlocal\t%s\t-\n' "$(date -u -d "@$t" +%FT%TZ)" "$((5000+i))" "$w" >> "$f"
      [ "$dupe" = 1 ] && printf '%s\t%d\tsent\ttester\tlocal\t%s\t-\n' "$(date -u -d "@$((t+5))" +%FT%TZ)" "$((5000+i))" "$w" >> "$f"
    done
  }
  _prrun(){ env MESH_TELL_WAL="$1" MESH_TELL_NODES="$_prd/nodes" "${@:2}"; }
  printf '# fixture node config\n' > "$_prd/nodes"
  # leg 1 — OVERFLOW band: arrivals every 5 min (under the 15-min cited reference).
  _prgen "$_prd/fast" fastwin 12 300
  _p1="$(env MESH_TELL_WAL="$_prd/fast" MESH_TELL_NODES="$_prd/nodes" "$0" --pressure 2>&1)"
  case "$_p1" in *fastwin*overflow-risk*) :;; *) echo "  FAIL: 5-min arrivals must read overflow-risk against a 15-min reference (got: $_p1)"; prf=1;; esac
  case "$_p1" in *"5.0"*) :;; *) echo "  FAIL: median gap of 5-min arrivals must be 5.0 (got: $_p1)"; prf=1;; esac
  # leg 2 — PACED band: the same count, arriving hourly. Falsify a band that ignores the reference.
  _prgen "$_prd/slow" slowwin 12 3600
  _p2="$(env MESH_TELL_WAL="$_prd/slow" MESH_TELL_NODES="$_prd/nodes" "$0" --pressure 2>&1)"
  case "$_p2" in *slowwin*paced*) :;; *) echo "  FAIL: hourly arrivals must read paced (got: $_p2)"; prf=1;; esac
  case "$_p2" in *overflow*) echo "  FAIL: hourly arrivals must NOT read overflow-risk (got: $_p2)"; prf=1;; *) :;; esac
  # leg 3 — MIN_N: 4 arrivals is a sample, not a rate. A verdict here would be the narrow-window
  # shape (a number computed off 3 gaps read as a state).
  _prgen "$_prd/few" fewwin 4 300
  _p3="$(env MESH_TELL_WAL="$_prd/few" MESH_TELL_NODES="$_prd/nodes" "$0" --pressure 2>&1)"
  case "$_p3" in *fewwin*n-a*) :;; *) echo "  FAIL: below MIN_N arrivals must render n-a, never a band (got: $_p3)"; prf=1;; esac
  case "$_p3" in *overflow*) echo "  FAIL: a 4-arrival window must not be given an overflow verdict (got: $_p3)"; prf=1;; *) :;; esac
  # leg 4 — a RETRY is not a second interruption: same pid 5s later must collapse. Falsify by
  # dropping the collapse rule → arr doubles and the hourly window flips to overflow-risk.
  _prgen "$_prd/dupe" dupewin 12 3600 1
  _p4="$(env MESH_TELL_WAL="$_prd/dupe" MESH_TELL_NODES="$_prd/nodes" "$0" --pressure 2>&1)"
  case "$_p4" in *dupewin*paced*) :;; *) echo "  FAIL: same-pid retries must collapse to one arrival, leaving the window paced (got: $_p4)"; prf=1;; esac
  printf '%s' "$_p4" | grep -qE 'dupewin +12 ' \
    || { echo "  FAIL: same-pid retries must not be counted as separate arrivals (expected arr=12; got: $_p4)"; prf=1; }
  # leg 5 — an `intent` with no outcome NEVER reached the pane, so it is not an arrival. A log of
  # nothing but dangling intents must render n/a on stderr, not a zero-pressure window list.
  : > "$_prd/intents"
  for _pi in $(seq 1 12); do
    printf '%s\t%d\tintent\ttester\tlocal\tintentwin\t-\n' "$(date -u -d "@$((1785000000+_pi*300))" +%FT%TZ)" "$((6000+_pi))" >> "$_prd/intents"
  done
  _p5="$(env MESH_TELL_WAL="$_prd/intents" MESH_TELL_NODES="$_prd/nodes" "$0" --pressure 2>&1)"; _p5rc=$?
  case "$_p5" in *intentwin*) echo "  FAIL: a dangling intent was counted as an arrival (got: $_p5)"; prf=1;; *) :;; esac
  [ "$_p5rc" -ne 0 ] || { echo "  FAIL: a log with no completed sends must exit non-zero (n/a), not 0 (got rc=$_p5rc)"; prf=1; }
  # leg 6 — SILENT-FALLBACK GATE: at level=off the node journals nothing, so pressure is n/a and
  # NEVER a calm reading. Drive it against a POPULATED fast log: a level check that only fires on an
  # empty file would go green here while reporting a stale rate as current.
  _p6="$(env MESH_TELL_WAL="$_prd/fast" MESH_TELL_NODES="$_prd/nodes" MESH_TELL_WAL_LEVEL=off "$0" --pressure 2>&1)"; _p6rc=$?
  case "$_p6" in *fastwin*) echo "  FAIL: level=off must not report a window's pressure — an unjournalled node has no rate (got: $_p6)"; prf=1;; *) :;; esac
  case "$_p6" in *"NOT calm"*) :;; *) echo "  FAIL: level=off must say n/a explicitly, so a silenced journal cannot read as an uninterrupted mind (got: $_p6)"; prf=1;; esac
  [ "$_p6rc" -ne 0 ] || { echo "  FAIL: level=off must exit non-zero, not 0 (got rc=$_p6rc)"; prf=1; }
  # leg 7 — a THINNED payload still carries the timing: redact/minimal must remain fully readable
  # (they thin the payload column only), the opposite direction from leg 6.
  _p7="$(env MESH_TELL_WAL="$_prd/fast" MESH_TELL_NODES="$_prd/nodes" MESH_TELL_WAL_LEVEL=minimal "$0" --pressure 2>&1)"
  case "$_p7" in *fastwin*overflow-risk*) :;; *) echo "  FAIL: level=minimal thins the payload, not the record — pressure must stay readable (got: $_p7)"; prf=1;; esac
  # leg 8 — the window filter selects, and the report NAMES its cited reference so the 15 cannot be
  # re-read as a mesh-tuned threshold somebody may quietly retune.
  cat "$_prd/slow" >> "$_prd/fast"
  _p8="$(env MESH_TELL_WAL="$_prd/fast" MESH_TELL_NODES="$_prd/nodes" "$0" --pressure slowwin 2>&1)"
  case "$_p8" in *fastwin*) echo "  FAIL: --pressure <win> must report only that window (got: $_p8)"; prf=1;; *) :;; esac
  case "$_p8" in *slowwin*) :;; *) echo "  FAIL: --pressure <win> dropped the window it was asked for (got: $_p8)"; prf=1;; esac
  case "$_p8" in *"Iqbal & Horvitz"*) :;; *) echo "  FAIL: the reference interval must be printed with its citation (got: $_p8)"; prf=1;; esac
  # ── PEAK LOAD (review-vsm-case-peak-not-average-2026-08-19) ────────────────────────────────────
  # leg 9 — a window whose MEDIAN is calm but whose tightest SUSTAINED run of MIN_N arrivals is
  # under the cited reference must read overflow-risk(PEAK). This is the live shape the leg exists
  # for (adint at landing: med 62.3 → paced, peak8 2.68). RED before the fix: the pre-CASE verdict
  # was `mg<ref ? overflow-risk : paced` and rendered this fixture `paced`.
  : > "$_prd/bursty"; _pb=1785000000
  for _pi in $(seq 0 7); do printf '%s\t%d\tsent\ttester\tlocal\tburstwin\t-\n' \
    "$(date -u -d "@$((_pb+_pi*120))" +%FT%TZ)" "$((7000+_pi))" >> "$_prd/bursty"; done
  for _pi in $(seq 1 8); do printf '%s\t%d\tsent\ttester\tlocal\tburstwin\t-\n' \
    "$(date -u -d "@$((_pb+840+_pi*10800))" +%FT%TZ)" "$((7100+_pi))" >> "$_prd/bursty"; done
  _p9="$(env MESH_TELL_WAL="$_prd/bursty" MESH_TELL_NODES="$_prd/nodes" "$0" --pressure 2>&1)"
  printf '%s' "$_p9" | grep -qE 'burstwin +16 +180\.0' \
    || { echo "  FAIL: the burst fixture must be MEDIAN-CALM (med 180.0 over 16 arrivals) — otherwise this leg proves nothing about the peak (got: $_p9)"; prf=1; }
  printf '%s' "$_p9" | grep -q 'burstwin.*overflow-risk(peak)' \
    || { echo "  FAIL: 8 arrivals 2 min apart inside a median-calm window must read overflow-risk(peak) — a burst may not be averaged away (got: $_p9)"; prf=1; }
  # leg 10 — the MAX FOLD NAMES ITS WINNER: chronic pace and burst are different findings. The
  # median-driven fixture must say (med…), the burst-driven one must NOT claim a chronic pace.
  printf '%s' "$_p1" | grep -q 'fastwin.*overflow-risk(med' \
    || { echo "  FAIL: a 5-min chronic pace must name the median leg as the winner (got: $_p1)"; prf=1; }
  printf '%s' "$_p9" | grep -q 'burstwin.*overflow-risk(med' \
    && { echo "  FAIL: a median-calm window must not be reported as a chronic-pace overflow (got: $_p9)"; prf=1; }
  # leg 11 — the peak is a RATE, not an outlier: ONE tight pair inside an otherwise hourly window
  # must NOT flip the verdict. RED against a peak implemented as the minimum single gap.
  _prgen "$_prd/pair" pairwin 12 3600
  printf '%s\t%d\tsent\ttester\tlocal\tpairwin\t-\n' \
    "$(date -u -d "@$((1785000000+5*3600+90))" +%FT%TZ)" 7999 >> "$_prd/pair"
  sort -o "$_prd/pair" "$_prd/pair"
  _p11="$(env MESH_TELL_WAL="$_prd/pair" MESH_TELL_NODES="$_prd/nodes" "$0" --pressure 2>&1)"
  printf '%s' "$_p11" | grep -q 'pairwin.*paced' \
    || { echo "  FAIL: a single 90s pair among hourly arrivals is an outlier, not a peak rate — the window must stay paced (got: $_p11)"; prf=1; }
  rm -rf "$_prd"
  [ "$prf" = 0 ] || { echo "smoke-test: FAIL (arrival-pressure axis regressed — see asserts above)"; exit 1; }

  # ── --fresh gate (2026-07-24) ───────────────────────────────────────────────────────────────────
  # Drives the REAL e2e path with STUB mesh-clear/mesh-wip-commit/mesh-mind-state on PATH. The target
  # window does not exist, so dead_shell_guard refuses at the send — which is exactly the evidence
  # wanted: the refusal proves the run REACHED the send after the clear stage, and the WAL (which the
  # stub also writes into) records the ORDER, not just the fact.
  ff=0
  _fsdir="$(mktemp -d)"; _fswin="mtell-fresh-fixture-$$"
  cat > "$_fsdir/mesh-wip-commit" <<EOF
#!/usr/bin/env bash
printf 'STUB\tWIP\n' >> "$MESH_TELL_WAL"; exit 0
EOF
  cat > "$_fsdir/mesh-mind-state" <<'EOF'
#!/usr/bin/env bash
printf '%s\tstub\n' "${STUB_MIND_STATE:-IDLE}"; exit 0
EOF
  # $STUB_CLEAR_RC decides PASS(0)/BLOCK(1) per leg; the stub journals into the SAME WAL so its line
  # is ordered against the send's intent line — an ordering artifact, not two independent facts.
  cat > "$_fsdir/mesh-clear" <<EOF
#!/usr/bin/env bash
printf 'STUB\tCLEAR\t%s\n' "\$*" >> "$MESH_TELL_WAL"; exit \${STUB_CLEAR_RC:-0}
EOF
  chmod +x "$_fsdir"/mesh-*
  _fspath="$_fsdir:$PATH"

  # leg 1 — BLOCKED clear must STILL DELIVER. The prompt is never dropped: mesh-clear is fail-safe
  # BLOCK and over-blocks, so swallowing the nudge here would lose most dispatches.
  : > "$MESH_TELL_WAL"
  _fo="$(PATH="$_fspath" STUB_CLEAR_RC=1 "$0" --fresh "$_fswin" "the nudge text verbatim" 2>&1)"
  case "$_fo" in *UNCLEARED*) :;; *) echo "  FAIL: blocked mesh-clear did not announce the UNCLEARED downgrade: $_fo"; ff=1;; esac
  # the send was REACHED — evidenced by its own write-ahead intent line carrying the payload, not by
  # an absence of complaint. (The prompt cannot land in a fixture window that does not exist; what is
  # being asserted is that the block did not abort the delivery path.)
  _f1i="$(awk -F'\t' -v w="$_fswin" '$3=="intent" && $6==w {print $7; exit}' "$MESH_TELL_WAL")"
  { [ -n "$_f1i" ] && [ "$(printf '%s' "$_f1i" | base64 -d 2>/dev/null)" = "the nudge text verbatim" ]; } \
    || { echo "  FAIL: blocked mesh-clear SWALLOWED the send — no intent journalled for the nudge (the prompt was dropped, not downgraded)"; ff=1; }

  # leg 2 — ORDERING: the clear stage must be journalled BEFORE the send's intent. Falsify by moving
  # the --fresh block below `wal_append intent` → the intent line lands first and this goes red.
  : > "$MESH_TELL_WAL"
  PATH="$_fspath" STUB_CLEAR_RC=0 "$0" --fresh "$_fswin" "ordered nudge" >/dev/null 2>&1
  _fc="$(awk -F'\t' '$2=="CLEAR" {print NR; exit}' "$MESH_TELL_WAL")"
  _fi="$(awk -F'\t' -v w="$_fswin" '$3=="intent" && $6==w {print NR; exit}' "$MESH_TELL_WAL")"
  { [ -n "$_fc" ] && [ -n "$_fi" ] && [ "$_fc" -lt "$_fi" ]; } \
    || { echo "  FAIL: --fresh ordering — the /clear must precede the send (clear=$_fc intent=$_fi)"; ff=1; }
  _fw="$(awk -F'\t' '$2=="WIP" {print NR; exit}' "$MESH_TELL_WAL")"
  { [ -n "$_fw" ] && [ -n "$_fc" ] && [ "$_fw" -lt "$_fc" ]; } \
    || { echo "  FAIL: --fresh must park work (wip-commit) BEFORE the clear (wip=$_fw clear=$_fc)"; ff=1; }
  # the clear must name the window. (--auto is GONE: mesh-clear no longer re-gates an extraction against a
  # model — it writes the handoff itself and clears, 2026-07-24 — so passing it would exit 2 as an unknown
  # flag and every --fresh nudge would silently deliver UNCLEARED.)
  grep -q "CLEAR.*$_fswin" "$MESH_TELL_WAL" \
    || { echo "  FAIL: --fresh did not invoke mesh-clear <win>"; ff=1; }
  grep -q "CLEAR.*--auto" "$MESH_TELL_WAL" \
    && { echo "  FAIL: --fresh passed --auto — mesh-clear rejects it as an unknown flag (rc 2) and the clear never happens"; ff=1; }

  # leg 2-RED — WITHOUT --fresh, mesh-clear must NEVER be invoked. This is the falsifier that keeps
  # --fresh opt-in: without it, a tool that always clears passes every leg above.
  : > "$MESH_TELL_WAL"
  PATH="$_fspath" "$0" "$_fswin" "plain nudge" >/dev/null 2>&1
  grep -q 'STUB	CLEAR' "$MESH_TELL_WAL" \
    && { echo "  FAIL: a plain mesh-tell invoked mesh-clear — every tick/continuation would clear its target"; ff=1; }

  # leg 3 — the readiness wait is BOUNDED. A pane stuck WORKING must fall through with a loud line,
  # never hang the caller (a nudge path that can block forever is worse than a stranded paste).
  : > "$MESH_TELL_WAL"
  _t0=$(date +%s)
  _fo3="$(PATH="$_fspath" STUB_CLEAR_RC=0 STUB_MIND_STATE=WORKING MESH_TELL_FRESH_READY_SECS=2 \
          "$0" --fresh "$_fswin" "bounded wait" 2>&1)"
  _el=$(( $(date +%s) - _t0 ))
  case "$_fo3" in *"still WORKING after 2s"*) :;; *) echo "  FAIL: an unready pane did not report the bounded-wait fall-through: $_fo3"; ff=1;; esac
  [ "$_el" -lt 20 ] || { echo "  FAIL: --fresh readiness wait was not bounded (${_el}s for a 2s budget)"; ff=1; }

  # leg 4 — remote is an honest n/a, and STILL delivers. A silent skip here would read as a clear
  # that never happened ([[na-must-be-a-claim-about-the-node]]).
  : > "$MESH_TELL_WAL"
  _fo4="$(PATH="$_fspath" "$0" --fresh --node "nobody@203.0.113.1" "$_fswin" "remote nudge" 2>&1)"
  case "$_fo4" in *"n/a on a remote node"*) :;; *) echo "  FAIL: remote --fresh did not declare n/a: $_fo4"; ff=1;; esac
  grep -q 'STUB	CLEAR' "$MESH_TELL_WAL" \
    && { echo "  FAIL: remote --fresh invoked the node-local mesh-clear"; ff=1; }

  # leg 5 — an EMPTY prompt must refuse BEFORE clearing. Clearing a mind and then finding nothing to
  # say destroys a context for no delivery.
  : > "$MESH_TELL_WAL"
  PATH="$_fspath" STUB_CLEAR_RC=0 "$0" --fresh "$_fswin" "   " >/dev/null 2>&1
  grep -q 'STUB	CLEAR' "$MESH_TELL_WAL" \
    && { echo "  FAIL: --fresh cleared the window for an EMPTY prompt"; ff=1; }

  rm -rf "$_fsdir"
  [ "$ff" = 0 ] || { echo "smoke-test: FAIL (--fresh gate regressed — see asserts above)"; exit 1; }

  # ── ORIGIN DISCLOSURE legs ──────────────────────────────────────────────────────────────────────
  # Asserted on the WAL's intent payload, which is the EXACT byte string handed to the pane (b64 is
  # computed after the stamp, deliberately, so the log cannot disagree with what the mind read).
  # Every leg DRIVES the real script; none inspects origin_stamp in isolation — a pure-function leg
  # would pass while the stamp was never wired into the send (the mesh-load-gate E9 lesson).
  of=0
  _odecode(){ # _odecode <winname> → the decoded intent payload for that window
    awk -F'\t' -v w="$1" '$3=="intent" && $6==w {print $7; exit}' "$MESH_TELL_WAL" | base64 -d 2>/dev/null
  }
  # o1 — DEFAULT OFF: byte-identical to the caller's prompt. This is the leg that protects every wired
  # keepalive/dispatch/self-continuation line from a disclosure nobody asked for yet.
  _ow="mtell-origin-off-$$"; : > "$MESH_TELL_WAL"
  MESH_WHO="$_wal_who_origin" "$0" "$_ow" 'hello world' >/dev/null 2>&1
  [ "$(_odecode "$_ow")" = 'hello world' ] \
    || { echo "  FAIL: origin disclosure must be OFF by default (got: '$(_odecode "$_ow")')"; of=1; }
  # o2 — --origin stamps WHO, and stays on ONE line. The line count is not a stylistic assert: this
  # file's stall class is the multi-line paste stranding in the composer, so a stamp that added a
  # line would trade provenance for lost prompts.
  _ow2="mtell-origin-on-$$"; : > "$MESH_TELL_WAL"
  MESH_WHO="$_wal_who_origin" "$0" --origin "$_ow2" 'hello world' >/dev/null 2>&1
  _od2="$(_odecode "$_ow2")"
  case "$_od2" in '[via TESTWHO@'*'] hello world') :;; *) echo "  FAIL: --origin must stamp [via WHO@host] (got: '$_od2')"; of=1;; esac
  [ "$(printf '%s' "$_od2" | wc -l)" = 0 ] \
    || { echo "  FAIL: --origin stamp must not add a line (multi-line paste is this file's stall class)"; of=1; }
  # o3 — a SLASH-COMMAND is never stamped: it must reach the engine as the first token or it is prose.
  _ow3="mtell-origin-slash-$$"; : > "$MESH_TELL_WAL"
  MESH_WHO="$_wal_who_origin" "$0" --origin "$_ow3" '/clear' >/dev/null 2>&1
  [ "$(_odecode "$_ow3")" = '/clear' ] \
    || { echo "  FAIL: --origin must NOT stamp a slash-command (got: '$(_odecode "$_ow3")')"; of=1; }
  # o4 — a deliberate BARE-SHELL send is never stamped: there a prefix is a syntax error, not a sentence.
  _ow4="mtell-origin-shell-$$"; : > "$MESH_TELL_WAL"
  MESH_WHO="$_wal_who_origin" MESH_TELL_ALLOW_SHELL=1 "$0" --origin "$_ow4" 'git pull && echo x' >/dev/null 2>&1
  [ "$(_odecode "$_ow4")" = 'git pull && echo x' ] \
    || { echo "  FAIL: --origin must NOT stamp an ALLOW_SHELL send (got: '$(_odecode "$_ow4")')"; of=1; }
  # o5 — the stamp carries the SENDER's identity, not a constant. Falsify: hardcode the stamp → both
  # o2 and this leg cannot hold at once.
  _ow5="mtell-origin-who-$$"; : > "$MESH_TELL_WAL"
  MESH_WHO="$_wal_who_other" "$0" --origin "$_ow5" 'x' >/dev/null 2>&1
  case "$(_odecode "$_ow5")" in '[via OTHERSENDER@'*) :;; *) echo "  FAIL: stamp must carry MESH_WHO (got: '$(_odecode "$_ow5")')"; of=1;; esac
  [ "$of" = 0 ] || { echo "smoke-test: FAIL (origin disclosure regressed — see asserts above)"; exit 1; }

  rm -f "$MESH_TELL_WAL"
  echo "smoke-test: ok (base64 round-trip + 4 ack_probe asserts: idle-unchanged=NO-ACK, working-counter=RECEIVED, stall=NO-ACK, late-paint-submitted=RECEIVED + load-aware ACK window: narrow=NO-ACK, widened catches late footer=RECEIVED + stall re-fire: stall=HOLDS/working+empty=not-held/transcript-echo-is-not-the-composer/real-text-under-an-echo-still-HOLDS/queued-placeholder-is-empty/collapsed-paste-hint-is-FOOTER-chrome(empty-composer-CLEAR-with-and-without-it,real-hold-still-HOLDS,no-marker-keeps-whole-tail-scan)/observable-C-m-submits/COMPLETION-line-is-not-WORKING(3 shapes)/live-WORKING-line-still-is(3 shapes)/held-composer-under-a-completion-line-is-HOLDS/empty-one-under-it-is-not + rung3 unterminated-paste: terminator-is-inert-on-a-live-pane/C-m-after-it-still-submits + --composer: stranded=HOLDS-rc3-carrying-the-text/working=CLEAR-rc0/unreadable=BLIND-rc2-never-CLEAR/flag-wired-end-to-end + stall ladder DRIVEN (settle=bounded-wait-on-an-observable): cleared-after-rung1-does-not-escalate/never-clears-on-a-pane-at-REST-drives-all-three-in-order/exhausted-ladder-says-STRANDED-carrying-the-composer/a-submitted-prompt-never-does/REPAINTING-pane-that-then-accepts-the-paste-fires-NO-rung-and-is-not-STRANDED/cap-elapsed-while-still-repainting=UNSETTLED-not-STRANDED-and-no-escalation + NO-ACK evidence snapshot (real panes): held-composer-carries-the-stranded-prompt/empty-composer-says-so-and-carries-the-transcript/CONTROL-old-byte-cut-still-blanks-a-wide-pane/blank-pane-is-an-explicit-claim/cut-by-characters-and-valid-UTF-8/--pane-snapshot-seam-matches + copy-mode wedge guard: in-mode→cancel-exits→delivery-restored + DEAD-SHELL guard: refuses/allows/escape-hatch + end-to-end send refusal + SHED-cooldown gate: active-refuses/expired-allows/ALLOW_SHED-bypasses/absent-fails-open/RATE-LIMITED-defense-in-depth + WAL: replay-decodes/sent-outcome/UNRESOLVED-dangling-intent/intent-precedes-refusal/real-log-untouched + WAL levels: redact-digest-reproducible-and-text-gone/ordering-survives-thinning/minimal-empty/off-writes-only-its-marker/marker-never-joins-as-outcome/replay-renders-thinned-explicitly/unknown-level-falls-back-to-FULL-and-warns/node-config-sets-it/env-overrides-config/default-byte-identical-and-markerless + arrival pressure: overflow-band/paced-band/below-MIN_N-is-n-a/same-pid-retry-collapses/dangling-intent-is-not-an-arrival/level-off-is-n-a-not-calm/minimal-stays-readable/window-filter-and-cited-reference/PEAK-burst-not-averaged-away/max-fold-names-its-winner/single-pair-is-not-a-peak-rate + origin disclosure: default-off-byte-identical/stamps-WHO-same-line/slash-command-skipped/ALLOW_SHELL-skipped/carries-sender + --fresh: blocked-clear-still-delivers/wip→clear→send ordering/plain-tell-never-clears/bounded-readiness-wait/remote-n-a/empty-prompt-refuses-before-clearing)"; exit 0
fi
node=local
ssh_port=""
peek=0
composer=0
ack=0
fresh=0
# accept leading flags in any order (--node user@ip / --peek / --ack / --fresh / --origin)
while [ $# -gt 0 ]; do
  case "${1:-}" in
    --node) node="$2"; shift 2 ;;
    --peek) peek=1; shift ;;
    --composer) composer=1; shift ;;
    --ack)  ack=1; shift ;;
    --fresh) fresh=1; shift ;;
    --origin) MESH_TELL_ORIGIN=1; export MESH_TELL_ORIGIN; shift ;;
    *) break ;;
  esac
done
win="${1:?usage: mesh-tell [--node user@ip] [--peek|--composer|--ack|--fresh|--origin] <window> <prompt>}"; shift || true
prompt="$*"

resolve_node() {
  local name="$1"
  if [[ "$name" == *@* ]]; then
    node="$name"
    return
  fi
  local user peer_addr peer_dns
  case "$name" in
    IdeaPad) user=imozerov ;;
    ilya)    user=ilya ;;
    default-string) user=imozerov ;;
    Redmi|phone)    user=u0_a380; ssh_port=8022 ;;
    router|GL-MT3000) user=root; peer_dns=router ;;
    phaedra) user=root ;;
    *) echo "mesh-tell: unknown peer '$name' (use user@ip for direct SSH)" >&2; exit 1 ;;
  esac
  peer_dns="${peer_dns:-$name}"
  local pa_bin
  pa_bin=$(command -v mesh-peer-addr 2>/dev/null) || pa_bin="$(dirname "$0")/mesh-peer-addr"
  peer_addr=$("$pa_bin" "$peer_dns") || { echo "mesh-tell: mesh-peer-addr failed for '$peer_dns'" >&2; exit 1; }
  node="$user@$peer_addr"
}

[ "$node" != local ] && resolve_node "$node"

run(){ # run a tmux command on the target node
  if [ "$node" = local ]; then bash -c "$1"
  else ssh -o BatchMode=yes -o ConnectTimeout=8 ${ssh_port:+-p "$ssh_port"} "$node" "$1"
  fi
}

# CHANNEL convention: top=DATA (refreshing), bottom=MIND. Drive the BOTTOM pane (largest pane_top) so
# prompts/peeks reach the MIND, never the data pane (sending to the active/data pane was why minds
# silently stopped getting fed — and a refreshing data pane also reads as always-busy to idle checks).
pidx=$(run "tmux list-panes -t \$(hostname):$win -F '#{pane_top} #{pane_index}' 2>/dev/null | sort -n | tail -1 | awk '{print \$2}'")
paneref="$win${pidx:+.$pidx}"

if [ "$peek" = 1 ]; then
  run "tmux capture-pane -t \$(hostname):$paneref -p 2>/dev/null | grep -vE '^[[:space:]]*\$' | tail -15"
  exit 0
fi

# ── --composer: EXPOSE THE STALL PREDICATE ITSELF (chat-review/a-stranded-composer-outlives-every-
# ladder-that-would-clear-it) ───────────────────────────────────────────────────────────────────────
# A stranded composer OUTLIVES the process that stranded it. Both stall rungs below live inside the
# send path, guarded by composer_holds_text immediately after the paste, so they can only ever fire in
# the seconds after a delivery; a prompt that survives them survives forever, and nothing sweeps for
# it. Measured 2026-08-29: vpn held 'take the 13:57Z third-table-52-build-pathway finding' unsubmitted
# for ~55 minutes while mesh-mind-state answered IDLE, ready prompt — the SAME word a healthy resting
# mind wears — which is why the digest listed that task unclaimed for two consecutive rounds.
#
# The periodic sweep that closes it lives in mesh-channel-keepalive (it already walks every channel and
# already owns the debounce/cooldown/giveup discipline). What it must NOT do is carry its own private
# copy of this predicate: a guard whose predicate is not the PARSER'S OWN predicate is not a guard on
# that parser ([[a-lint-that-tests-a-different-predicate-than-the-parser-is-blind]],
# [[n-private-copies-of-one-predicate-are-all-green-and-none-is-complete]]). So the sweep asks THIS
# function, over this file's own cap_tail/paneref/run — the same bytes, the same remote path.
#
# Output: one line, "<VERDICT>\t<composer snapshot>". VERDICT and rc are two renderings of one read:
#   HOLDS (rc 3) — composer carries text and the engine is NOT working: it can ONLY be unsubmitted.
#   CLEAR (rc 0) — composer empty, or the engine is working (submitted; nothing to sweep either way).
#   BLIND (rc 2) — the pane could not be read at all. NOT folded into CLEAR: an unreadable pane is not
#                  evidence that a strand ended, and a sweep that clears its streak on a blind read
#                  launders every strand through one bad capture.
# Display-only: it sends no key and writes no state, so it is safe at any cadence and on any pane.
if [ "$composer" = 1 ]; then
  composer_state; exit $?
fi
[ -n "${prompt// /}" ] || { echo "mesh-tell: empty prompt" >&2; exit 1; }

# ── --fresh: park work, gated /clear, wait for the pane, THEN fall through to the normal send ──────
# Runs AFTER the empty-prompt check on purpose: clearing a mind and then discovering there was
# nothing to say would destroy a context for no delivery.
FRESH_READY_SECS="${MESH_TELL_FRESH_READY_SECS:-30}"
_fresh_ready() { # wait for the cleared pane to come back; bounded, never a blind sleep
  local i=0 st
  sleep 2                                   # let the /clear itself land before sampling
  while [ "$i" -lt "$FRESH_READY_SECS" ]; do
    st="$(mesh-mind-state "$win" 2>/dev/null | head -1 | cut -f1)"
    # not-WORKING is the ready edge: the SessionStart handoff restore runs as WORKING, so this also
    # waits out the restore instead of pasting into it.
    [ "$st" = WORKING ] || return 0
    sleep 1; i=$((i+1))
  done
  return 1
}
if [ "$fresh" = 1 ]; then
  if [ "$node" != local ]; then
    # honest n/a — mesh-clear is node-local. Say so; never let a silent skip read as a fresh clear.
    echo "mesh-tell --fresh: n/a on a remote node ($node) — mesh-clear is node-local; sending WITHOUT a clear" >&2
  else
    # P1 of the crash-proof chain: a /clear keeps the worktree, but park the dirty work anyway so the
    # window this nudge is about to re-task cannot lose it to a later reboot/OOM.
    command -v mesh-wip-commit >/dev/null 2>&1 && mesh-wip-commit >/dev/null 2>&1 || true
    if command -v mesh-clear >/dev/null 2>&1 && mesh-clear "$win"; then
      _fresh_ready || echo "mesh-tell --fresh: pane '$win' still WORKING after ${FRESH_READY_SECS}s — sending anyway (the stall re-fire below covers a stranded paste)" >&2
    else
      # THE PROMPT IS NEVER DROPPED. A blocked clear is loud and the nudge still lands.
      echo "mesh-tell --fresh: mesh-clear BLOCKED or absent for '$win' — delivering the prompt UNCLEARED (a dropped nudge is worse than a drifted context)" >&2
    fi
  fi
fi
# ── ORIGIN DISCLOSURE (2026-08-14, literature: hostile scaffolding) ───────────────────────────────
# The WAL above records `who` — and writes it where only an AUDITOR looks. The pane gets the payload
# VERBATIM, so the mind being driven cannot tell apart: its own self-continuation, another mind's
# nudge, a cron reflex, and the operator. CLAUDE.md ranks operator instruction above skills and above
# default behaviour, so an injected line that INVOKES the operator ("оператор просил дважды…", live in
# the WAL 23:10:47Z from who=job@mesh-home into `sound`) is read with an authority its actual sender
# does not have — and the one field that would settle it was captured, then filed away from the reader.
#
# Timms & Spurrett (Philosophical Papers 52(1), doi:10.1080/05568641.2023.2231652) define hostile
# scaffolding as structure that "depends on the same capacities of an agent to make cognitive use of
# external structure as in benign cases, but that undermines or exploits the user while serving the
# interests of another agent" — shaping cognition "in the interest of others, not of the scaffolded
# person". The capacity mesh-tell rides is the one that makes the channel work at all: a mind treats
# what appears at its prompt as addressed to it and acts on it. Disclosure does not weaken that
# capacity; it prices it. (The 4E failure mode this comes from: Spurrett, Colombetti & Sutton, Topoi
# 44(2):345-351, doi:10.1007/s11245-025-10167-7 — situated/extended-cognition treatments "tend to be
# optimistic and apolitical, focusing mostly on the benefits of external cognitive resources".)
#
# OPT-IN and default OFF (--origin / MESH_TELL_ORIGIN=1). This is THE self-continuation, keepalive and
# dispatch primitive; a default-on rewrite of what every mind reads is not a change to make without the
# steward. Two hard SKIPs, because a stamp that breaks the channel is worse than no stamp:
#   - a payload whose first non-space char is `/` — a slash-command must reach the engine as the first
#     token or it is prose, not a command.
#   - MESH_TELL_ALLOW_SHELL=1 — the deliberate send into a BARE SHELL, where a prefix is a syntax error
#     rather than a sentence (the default path can't hit this: dead_shell_guard REFUSES such panes).
# SAME-LINE by construction, never a leading newline: this file's own stall class is the multi-line
# paste stranding at 'paste again to expand', so a disclosure that added a line would buy provenance
# with lost prompts. Applied BEFORE b64 so the WAL still journals the EXACT bytes the pane receives.
origin_stamp(){ # → prints the stamp, or nothing when disclosure is off/unsafe
  [ "${MESH_TELL_ORIGIN:-0}" = 1 ] || return 0
  [ "${MESH_TELL_ALLOW_SHELL:-0}" = 1 ] && return 0
  case "${1#"${1%%[![:space:]]*}"}" in /*) return 0 ;; esac
  printf '[via %s@%s] ' "${MESH_WHO:-$(id -un)}" "$(hostname 2>/dev/null || echo '?')"
}
prompt="$(origin_stamp "$prompt")$prompt"
# b64 computed here (not at the paste site) so the WAL intent journals the EXACT payload the send
# will use; the intent lands BEFORE dead_shell_guard — write-ahead, the guard's verdict is an outcome.
b64=$(printf '%s' "$prompt" | base64 | tr -d '\n')
wal_append intent "$win" "$node" "$b64"
_dsg_out="$(dead_shell_guard "$win" "$node")" || { wal_append refused "$win" "$node" -; echo "mesh-tell: REFUSED — $win @ $node ($_dsg_out)" >&2; exit 1; }
# the tick sequence — C-u clear stale input, BRACKETED paste, settle, C-m submit (same keys
# mesh-tick presses). Bracketed paste (paste-buffer -p) not send-keys -l: codex's paste-burst
# detector eats a C-m that lands 0.3s after a long key-burst (prompt strands UNSUBMITTED in the
# composer, ticks concatenate — 2026-06-13 window-12 pileup); the bracket close ends the burst
# deterministically. tmux adds brackets only for apps that requested them — plain shells unaffected.
# pre-send tail: ack_probe's arbitration evidence (pane-changed vs this) — captured BEFORE the paste
# touches the pane, only when --ack will consume it (the default path stays capture-free and fast).
pre_tail=""; [ "$ack" = 1 ] && pre_tail="$(cap_tail)"
# COPY-MODE WEDGE GUARD (meshtell-copymode-wedge-guard): a pane in tmux copy/view-mode EATS send-keys —
# C-u/paste/C-m drive the copy-mode cursor, NOT the engine, so the prompt strands and the C-m re-fire
# below is a no-op verb for this class (the health-pane wedge 2026-07-24: two bare C-m no-ops, Escape
# = exit-mode recovered). `send-keys -X cancel` first, UNCONDITIONALLY: it exits any mode so the keys
# reach the mind, and it is a harmless no-op error (2>/dev/null) on a normal pane — never submits or
# clears a composer. Must be inline in the run string (the pane lives on $node, possibly remote).
if run "tmux send-keys -t \$(hostname):$paneref -X cancel 2>/dev/null; tmux send-keys -t \$(hostname):$paneref C-u; sleep 0.1; echo $b64 | base64 -d | tmux load-buffer -b mtell\$\$ -; tmux paste-buffer -p -d -b mtell\$\$ -t \$(hostname):$paneref; sleep 0.5; tmux send-keys -t \$(hostname):$paneref C-m"; then
  echo "[told $win @ $node]: ${prompt:0:70}..."
  wal_append sent "$win" "$node" -
  stall_ladder
  if [ "$ack" = 1 ]; then
    if [ "$(ack_probe "$pre_tail")" = RECEIVED ]; then
      echo "[ack $win @ $node]: RECEIVED — pane left idle / working within ${ACK_TIMEOUT}s" >&2
    else
      # carry the final pane tail as evidence (chat-review/ack-noack-is-an-absence-verdict): a NO-ACK
      # verdict with no snapshot is undiagnosable post-hoc. The COMPOSER region, ~120 characters —
      # never the bottom N lines and never a byte cut (chat-review/noack-pane-tail-selects-the-tui-
      # footer-and-cuts-by-bytes: that shipped 9 empty snapshots out of 12).
      _snap="$(cap_full | compose_snapshot 120)"
      echo "[ack $win @ $node]: NO-ACK — composer holds text / pane unchanged after ${ACK_TIMEOUT}s; prompt may be UNSUBMITTED (re-peek) pane-tail: ${_snap}" >&2
    fi
  fi
fi
