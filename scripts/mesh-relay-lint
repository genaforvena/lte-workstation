#!/usr/bin/env bash
# orphan-ok: on-demand check tool, pulled by hand/doctor, never cron-wired
# mesh-relay-lint — ARM 3: unrelayed-dialog check.
#
# Given a TG/dialog log and chat.log (file args), dialog markers in the last
# T hours (default 24, $MESH_RELAY_HOURS) with no same-window
# [fyi]/[design]/[done] relay verdict UNRELAYED (rc 1); SKIP rc 2 when either
# file missing/unreadable.
#
# Dialog marker = non-empty line in dialog log with a timestamp within window.
# Window attribution = token after timestamp: "<win>@<host>" or "[<win>]" or
# bare "<win>"; matched case-insensitively against the relay post's author
# field ("  user@win  ::  [fyi]...") or a "window: <win>" mention in body.
#
#   mesh-relay-lint --dialog FILE --board FILE [--hours N] | --test
set -uo pipefail
HOURS="${MESH_RELAY_HOURS:-24}"

usage(){ echo "usage: mesh-relay-lint --dialog FILE --board FILE [--hours N] | --test" >&2; }
cutoff_epoch(){ date -u -d "$1 hours ago" +%s 2>/dev/null || date -u -v-"$1"H +%s; }
ts_epoch(){ date -u -d "$1" +%s 2>/dev/null || echo ""; }

dialog_windows(){
  local f="$1" cutoff="$2" ln ts w ep
  while IFS= read -r ln || [ -n "$ln" ]; do
    [ -n "$(echo "$ln" | tr -d '[:space:]')" ] || continue
    ts="$(echo "$ln" | grep -aoE '[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z?' | head -n1)"
    [ -n "$ts" ] || continue
    ep="$(ts_epoch "$ts")"; [ -n "$ep" ] || continue
    [ "$ep" -ge "$cutoff" ] || continue
    # window token: prefer [win], else second field user@win/win@host
    w="$(echo "$ln" | grep -aoE '\[[a-zA-Z0-9_.-]+\]' | head -n1 | tr -d '[]')"
    if [ -z "$w" ]; then
      w="$(echo "$ln" | awk '{print $2}' | sed 's/@.*//; s/[^a-zA-Z0-9_.-]//g')"
      echo "$ln" | awk '{print $2}' | grep -q '@' || w="$(echo "$ln" | awk '{print $2}' | sed 's/[^a-zA-Z0-9_.-]//g')"
    fi
    [ -n "$w" ] || continue
    echo "$w" | tr '[:upper:]' '[:lower:]'
  done < "$f" | sort -u
}

board_has_relay(){
  local board="$1" win="$2"
  grep -aiE '\[(fyi|design|done)\]' "$board" 2>/dev/null | grep -ai "$win" | grep -q .
}

check(){
  local dlg="$1" board="$2" hours="$3"
  [ -r "$dlg" ] || { echo "SKIP unreadable dialog log: $dlg"; return 2; }
  [ -r "$board" ] || { echo "SKIP unreadable board: $board"; return 2; }
  local cutoff; cutoff="$(cutoff_epoch "$hours")"
  local wins; wins="$(dialog_windows "$dlg" "$cutoff")"
  [ -n "$wins" ] || { echo "relay-lint: clean (no dialog markers in last ${hours}h)"; return 0; }
  local bad=0 w
  while IFS= read -r w || [ -n "$w" ]; do
    [ -n "$w" ] || continue
    if board_has_relay "$board" "$w"; then echo "RELAYED: $w"
    else echo "UNRELAYED: dialog from '$w' in last ${hours}h with no [fyi]/[design]/[done] relay"; bad=1; fi
  done <<<"$wins"
  [ "$bad" = 1 ] && return 1
  echo "relay-lint: clean"; return 0
}

if [ "${1:-}" = --test ]; then
  d="$(mktemp -d)"; trap 'rm -rf "$d"' EXIT
  pass=0; fail=0; ok(){ pass=$((pass+1)); }; bad(){ echo "FAIL: $1"; fail=$((fail+1)); }
  now="$(date -u +%Y-%m-%dT%H:%M:%SZ)"; old="$(date -u -d '30 hours ago' +%Y-%m-%dT%H:%M:%SZ)"
  printf '%s tg@mesh-home :: operator asks about vpn\n' "$now" > "$d/dlg.log"
  printf '%s tg@mesh-home :: [fyi] tg: answered operator vpn question\n' "$now" > "$d/board-ok.log"
  printf '%s health@mesh-home :: [done] health: disk fixed\n' "$now" > "$d/board-no.log"
  "$0" --dialog "$d/dlg.log" --board "$d/board-ok.log" >/dev/null 2>&1; [ $? = 0 ] && ok || bad "relayed dialog must rc=0"
  out="$("$0" --dialog "$d/dlg.log" --board "$d/board-no.log" 2>&1)"; rc=$?
  { [ "$rc" = 1 ] && grep -q 'UNRELAYED' <<<"$out"; } && ok || bad "unrelayed dialog must rc=1 (rc=$rc: $out)"
  printf '%s tg@mesh-home :: old question\n' "$old" > "$d/dlg-old.log"
  "$0" --dialog "$d/dlg-old.log" --board "$d/board-no.log" >/dev/null 2>&1; [ $? = 0 ] && ok || bad "stale dialog outside window must rc=0"
  "$0" --dialog "$d/missing" --board "$d/board-no.log" >/dev/null 2>&1; [ $? = 2 ] && ok || bad "missing dialog must rc=2"
  "$0" --dialog "$d/dlg.log" --board "$d/missing" >/dev/null 2>&1; [ $? = 2 ] && ok || bad "missing board must rc=2"
  echo "mesh-relay-lint --test: $pass passed, $fail failed"
  [ "$fail" = 0 ]; exit $?
fi

DLG=""; BOARD=""; H="$HOURS"
while [ $# -gt 0 ]; do
  case "$1" in
    --dialog) DLG="${2:-}"; shift 2;;
    --board) BOARD="${2:-}"; shift 2;;
    --hours) H="${2:-}"; shift 2;;
    -h|--help) usage; exit 0;;
    *) echo "mesh-relay-lint: unknown arg $1" >&2; usage; exit 2;;
  esac
done
[ -n "$DLG" ] && [ -n "$BOARD" ] || { usage; exit 2; }
check "$DLG" "$BOARD" "$H"
