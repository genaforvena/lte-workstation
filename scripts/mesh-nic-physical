#!/usr/bin/env bash
# reflex-cadence: */5 * * * *
# reflex-args: --edge
# doctor-artifact: $HOME/.mesh/.nic-physical.state 900 sys
# mesh-nic-physical — physical NIC carrier/error relation sense.
#
# Reads two kernel views of the same physical interface:
#   carrier            — is the PHY currently reporting link up?
#   tx_carrier_errors  — cumulative transmit failures attributed to the carrier
#
# The joint reading distinguishes a live link with a recorded physical fault from a
# merely down link. Missing or malformed sysfs is UNKNOWN (exit 2), never a fake clear.
# The cumulative counters are boot-scoped history; they are published, not treated as
# a current rate.
set -uo pipefail
export PATH="${HOME:-/root}/.local/bin:$PATH"

ROOT="${MESH_NIC_PHYSICAL_ROOT:-/sys/class/net}"
STATE="${MESH_NIC_PHYSICAL_STATE:-${HOME:-/root}/.mesh/.nic-physical.state}"

read_physical() {
  local d iface carrier errors changes
  shopt -s nullglob
  for d in "$ROOT"/*; do
    [ -d "$d" ] || continue
    iface="${d##*/}"
    [ "$iface" != lo ] || continue
    [ -e "$d/device" ] || [ -d "$d/wireless" ] || continue
    [ -r "$d/carrier" ] || continue
    [ -r "$d/statistics/tx_carrier_errors" ] || continue
    [ -r "$d/carrier_changes" ] || continue
    carrier="$(tr -d '[:space:]' < "$d/carrier" 2>/dev/null)"
    errors="$(tr -d '[:space:]' < "$d/statistics/tx_carrier_errors" 2>/dev/null)"
    changes="$(tr -d '[:space:]' < "$d/carrier_changes" 2>/dev/null)"
    case "$carrier:$errors:$changes" in
      0:[0-9]*:[0-9]*|1:[0-9]*:[0-9]*)
        printf '%s\t%s\t%s\t%s\n' "$iface" "$carrier" "$errors" "$changes"
        shopt -u nullglob
        return 0
        ;;
    esac
  done
  shopt -u nullglob
  return 2
}

classify() {
  local carrier="$1" errors="$2"
  case "$carrier:$errors" in
    1:0)   printf 'UP-CLEAN|carrier up and tx_carrier_errors=0' ;;
    1:[1-9]*) printf 'UP-CARRIER-FAULT|carrier up with tx_carrier_errors=%s' "$errors" ;;
    0:0)   printf 'DOWN-CLEAN|carrier down and tx_carrier_errors=0' ;;
    0:[1-9]*) printf 'DOWN-CARRIER-FAULT|carrier down with tx_carrier_errors=%s' "$errors" ;;
    *)     printf 'UNKNOWN|malformed carrier/error relation' ;;
  esac
}

if [ "${1:-}" = --test ]; then
  td="$(mktemp -d)" || { echo 'smoke-test: FAIL (mktemp)'; exit 1; }
  trap 'rm -rf "$td"' EXIT
  mkdir -p "$td/enp-test/device" "$td/enp-test/statistics" "$td/wlan-test/wireless" "$td/wlan-test/statistics"
  printf '1\n' > "$td/enp-test/carrier"
  printf '0\n' > "$td/enp-test/statistics/tx_carrier_errors"
  printf '4\n' > "$td/enp-test/carrier_changes"
  printf '1\n' > "$td/wlan-test/carrier"
  printf '7\n' > "$td/wlan-test/statistics/tx_carrier_errors"
  printf '9\n' > "$td/wlan-test/carrier_changes"
  [ "$(classify 1 0)" = 'UP-CLEAN|carrier up and tx_carrier_errors=0' ] || { echo 'smoke-test: FAIL (clean relation)'; exit 1; }
  [ "$(classify 1 7)" = 'UP-CARRIER-FAULT|carrier up with tx_carrier_errors=7' ] || { echo 'smoke-test: FAIL (fault relation)'; exit 1; }
  [ "$(classify 0 7)" = 'DOWN-CARRIER-FAULT|carrier down with tx_carrier_errors=7' ] || { echo 'smoke-test: FAIL (down fault relation)'; exit 1; }
  [ "$(classify x y)" = 'UNKNOWN|malformed carrier/error relation' ] || { echo 'smoke-test: FAIL (unknown relation)'; exit 1; }
  fixture="$(MESH_NIC_PHYSICAL_ROOT="$td" MESH_NIC_PHYSICAL_STATE="$td/state" "$0" --json 2>/dev/null)" || {
    echo "smoke-test: FAIL (fixture executable read: $fixture)"; exit 1;
  }
  printf '%s\n' "$fixture" | grep -q '"iface":"enp-test"' || {
    echo "smoke-test: FAIL (fixture read selected wrong interface: $fixture)"; exit 1;
  }
  printf '%s\n' "$fixture" | grep -q '"label":"UP-CLEAN"' || {
    echo "smoke-test: FAIL (fixture relation artifact: $fixture)"; exit 1;
  }
  real="$(read_physical 2>/dev/null)" || { echo 'smoke-test: n/a (no readable physical NIC carrier/error tuple)'; exit 2; }
  echo "smoke-test: ok (4 relation cases + REAL sysfs read: iface=${real%%$'\t'*})"
  exit 0
fi

raw="$(read_physical 2>/dev/null)" || {
  echo "nic-physical: UNKNOWN — no readable physical carrier/error tuple under $ROOT" >&2
  exit 2
}
IFS=$'\t' read -r iface carrier errors changes <<< "$raw"
result="$(classify "$carrier" "$errors")"
label="${result%%|*}"
reason="${result#*|}"
old=""
[ -r "$STATE" ] && old="$(sed -n '1s/|.*//p' "$STATE" 2>/dev/null)"
mkdir -p "$(dirname "$STATE")" || exit 1
printf '%s|iface=%s|carrier=%s|tx_carrier_errors=%s|carrier_changes=%s|ts=%s\n' \
  "$label" "$iface" "$carrier" "$errors" "$changes" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$STATE" || exit 1
mesh-state-touch "$STATE" >/dev/null 2>&1 || {
  echo 'nic-physical: UNKNOWN — could not stamp live state' >&2
  exit 1
}

if [ "${1:-}" = --json ]; then
  printf '{"label":"%s","iface":"%s","carrier":%s,"tx_carrier_errors":%s,"carrier_changes":%s,"reason":"%s","ts":"%s"}\n' \
    "$label" "$iface" "$carrier" "$errors" "$changes" "$reason" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
else
  line="[nic-physical] $label — iface=$iface carrier=$carrier tx_carrier_errors=$errors carrier_changes=$changes | $reason"
  if [ "${1:-}" = --edge ]; then
    [ "$old" = "$label" ] && exit 0
  fi
  printf '%s\n' "$line"
fi
