#!/usr/bin/env bash
# mesh-autopoiesis-verify — verify the CLAIMED autopoiesis loop against real artifacts.
#
# The codebase declares a self-production loop (CLAUDE.md):
#   "reflex-health=lanes fire · vitality=they produce · fitness=sound ·
#    needs=goals self-derived · autowire=products integrate"
# + two production lanes: CODEBASE (mesh-generate → mesh-feed → genome) +
#                          PERCEPTION (mesh-sense-evolve).
#
# This tool verifies EACH CLAIM with a real observable artifact — not with the claim itself.
# The verification principle: "Not 'the camera works.' A non-zero JPEG on disk."
#
# Checks (one per declared claim):
#   LANES FIRE    — feed.log + sense-evolve.log fresh AND both wired in cron/reflexes.cron
#   THEY PRODUCE  — commits in last 24 h ≥ MIN AND vitality.log updated ≤ 2 h
#   SOUND         — fitness.log exists AND HEAD passes bash -n AND fitness is wired
#   GOALS DERIVED — mesh-needs wired + ideas-queue has deficit-driven items
#   INTEGRATED    — mesh-autowire wired + autowire.log recent + reflexes.cron has entries
#
# Verdict per claim: VERIFIED | PARTIAL | ABSENT | UNWIRED
# Overall:           ALL-VERIFIED | PARTIAL | DEGRADED
# Edge-triggered [autopoiesis-ok]/[autopoiesis-degraded] on the board.
#
#   mesh-autopoiesis-verify           check + edge-trigger on the board
#   mesh-autopoiesis-verify --check   read-only report (no board post)
#   mesh-autopoiesis-verify --test    smoke test
# reflex-cadence: 0 * * * *
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
M="$HOME/.mesh"
REPO="$HOME/lte-workstation"
STATE="$M/.autopoiesis-verify-state"
ts(){ date -u +%FT%TZ; }
now=$(date +%s)

# ── thresholds ──────────────────────────────────────────────────────────────
MIN_COMMITS="${MESH_APV_MIN_COMMITS:-2}"   # commits/24 h before "they produce" is ABSENT
MAX_FEED_AGE=600                           # 10 min  — feed.log must be fresher than this
MAX_SENSE_AGE=1500                         # 25 min  — sense-evolve.log
MAX_VITAL_AGE=7200                         # 2 h     — vitality.log
MAX_FIT_AGE=1800                           # 30 min  — fitness.log (runs */9)
MAX_WIRE_AGE=3600                          # 1 h     — autowire.log (runs */30)

# ── helpers ─────────────────────────────────────────────────────────────────
# artifact_age <path>  →  seconds since last modification, or 999999 if missing
artifact_age(){
  local f="$1"
  [ -f "$f" ] || { echo 999999; return; }
  local mt; mt=$(stat -c %Y "$f" 2>/dev/null || echo 0)
  echo $(( now - mt ))
}

# in_cron <pattern>  →  0 if pattern found in crontab OR reflexes.cron, else 1
in_cron(){
  { crontab -l 2>/dev/null; cat "$M/reflexes.cron" 2>/dev/null; } \
    | grep -qE "$1"
}

# claim_status <label> <verdict> <detail>  →  print one row
claim_status(){
  local icon
  case "$2" in
    VERIFIED) icon="✓";;
    PARTIAL)  icon="~";;
    *)        icon="✗";;
  esac
  printf "  %s %-12s %-10s %s\n" "$icon" "$1" "$2" "$3"
}

# ── smoke test ───────────────────────────────────────────────────────────────
if [ "${1:-}" = --test ]; then
  # required external commands
  for dep in stat date grep awk; do
    command -v "$dep" >/dev/null 2>&1 || { echo "smoke-test: FAIL (no $dep)"; exit 1; }
  done

  # use a temp dir as both the scratch area and a stand-in for $M
  td=$(mktemp -d); trap 'rm -rf "$td"' EXIT
  M="$td"   # override M so in_cron reads td/reflexes.cron; no real ~/.mesh needed

  # artifact_age returns 999999 for a missing file
  age=$(artifact_age "$td/nonexistent")
  [ "$age" -ge 999999 ] || { echo "smoke-test: FAIL (artifact_age missing: got $age)"; exit 1; }

  # artifact_age returns a small number for a just-touched file
  touch "$td/fresh"
  age=$(artifact_age "$td/fresh")
  [ "$age" -le 5 ] || { echo "smoke-test: FAIL (artifact_age fresh: got $age)"; exit 1; }

  # in_cron finds a pattern in reflexes.cron (crontab -l may fail; only the file path matters here)
  printf '*/10 * * * * mesh-feed\n' > "$td/reflexes.cron"
  in_cron 'mesh-feed' || { echo "smoke-test: FAIL (in_cron missed reflexes.cron entry)"; exit 1; }

  # claim_status produces a line with the expected icon
  line=$(claim_status LANES VERIFIED "test")
  printf '%s' "$line" | grep -q '✓' || { echo "smoke-test: FAIL (claim_status VERIFIED icon missing)"; exit 1; }
  line=$(claim_status LANES ABSENT "test")
  printf '%s' "$line" | grep -q '✗' || { echo "smoke-test: FAIL (claim_status ABSENT icon missing)"; exit 1; }
  line=$(claim_status LANES PARTIAL "test")
  printf '%s' "$line" | grep -q '~' || { echo "smoke-test: FAIL (claim_status PARTIAL icon missing)"; exit 1; }

  # thresholds are sensible
  [ "$MIN_COMMITS" -ge 1 ] 2>/dev/null || { echo "smoke-test: FAIL (MIN_COMMITS not a positive int: $MIN_COMMITS)"; exit 1; }
  [ "$MAX_FEED_AGE" -gt 0 ] 2>/dev/null || { echo "smoke-test: FAIL (MAX_FEED_AGE not positive)"; exit 1; }

  echo "smoke-test: ok"; exit 0
fi

CHECK=0; [ "${1:-}" = --check ] && CHECK=1

# ────────────────────────────────────────────────────────────────────────────
# CLAIM 1 — LANES FIRE
#   artifact: feed.log (codebase lane) + sense-evolve.log (perception lane)
#   wired:    mesh-feed + mesh-sense-evolve in cron/reflexes.cron
# ────────────────────────────────────────────────────────────────────────────
feed_age=$(artifact_age "$M/feed.log")
sense_age=$(artifact_age "$M/sense-evolve.log")
feed_wired=0;  in_cron 'mesh-feed'        && feed_wired=1
sense_wired=0; in_cron 'mesh-sense-evolve' && sense_wired=1

lanes_v=ABSENT
lanes_detail=""
if   [ "$feed_wired" = 1 ] && [ "$sense_wired" = 1 ] \
  && [ "$feed_age"  -lt "$MAX_FEED_AGE" ]  \
  && [ "$sense_age" -lt "$MAX_SENSE_AGE" ]; then
  lanes_v=VERIFIED
  lanes_detail="feed=${feed_age}s sense=${sense_age}s both wired"
elif [ "$feed_wired" = 1 ] || [ "$sense_wired" = 1 ]; then
  lanes_v=PARTIAL
  lanes_detail="feed_wired=$feed_wired(${feed_age}s) sense_wired=$sense_wired(${sense_age}s)"
else
  lanes_detail="feed_wired=$feed_wired sense_wired=$sense_wired feed=${feed_age}s sense=${sense_age}s"
fi

# ────────────────────────────────────────────────────────────────────────────
# CLAIM 2 — THEY PRODUCE
#   artifact: commits in last 24 h (real git log) + vitality.log freshness
# ────────────────────────────────────────────────────────────────────────────
commits24=0
if [ -d "$REPO/.git" ]; then
  commits24=$(git -C "$REPO" log --oneline --since=24.hours 2>/dev/null | wc -l | tr -d ' ')
  commits24="${commits24:-0}"
fi
vital_age=$(artifact_age "$M/vitality.log")

produce_v=ABSENT
produce_detail=""
if [ "$commits24" -ge "$MIN_COMMITS" ] && [ "$vital_age" -lt "$MAX_VITAL_AGE" ]; then
  produce_v=VERIFIED
  produce_detail="commits24=${commits24} vitality=${vital_age}s"
elif [ "$commits24" -ge "$MIN_COMMITS" ] || [ "$vital_age" -lt "$MAX_VITAL_AGE" ]; then
  produce_v=PARTIAL
  produce_detail="commits24=${commits24}(need≥${MIN_COMMITS}) vitality=${vital_age}s(max=${MAX_VITAL_AGE})"
else
  produce_detail="commits24=${commits24}(need≥${MIN_COMMITS}) vitality=${vital_age}s(max=${MAX_VITAL_AGE})"
fi

# ────────────────────────────────────────────────────────────────────────────
# CLAIM 3 — SOUND (fitness)
#   artifact: fitness.log freshness + HEAD passes bash -n + wired in cron
# ────────────────────────────────────────────────────────────────────────────
fit_age=$(artifact_age "$M/fitness.log")
fit_wired=0; in_cron 'mesh-fitness' && fit_wired=1

head_ok=0
if [ -d "$REPO/.git" ]; then
  head_sha=$(git -C "$REPO" rev-parse HEAD 2>/dev/null || true)
  if [ -n "${head_sha:-}" ]; then
    changed_tools=$(git -C "$REPO" show --no-patch --name-only --format= HEAD 2>/dev/null \
      | grep -E 'scripts/mesh-' || true)
    head_ok=1
    while IFS= read -r tf; do
      [ -z "$tf" ] && continue
      f="$REPO/$tf"
      [ -f "$f" ] && bash -n "$f" 2>/dev/null || { head_ok=0; break; }
    done <<< "$changed_tools"
  fi
fi

sound_v=ABSENT
sound_detail=""
if [ "$fit_wired" = 1 ] && [ "$fit_age" -lt "$MAX_FIT_AGE" ] && [ "$head_ok" = 1 ]; then
  sound_v=VERIFIED
  sound_detail="fitness=${fit_age}s wired HEAD-bash-n=ok"
elif [ "$fit_wired" = 1 ] || [ "$fit_age" -lt "$MAX_FIT_AGE" ]; then
  sound_v=PARTIAL
  sound_detail="fit_wired=$fit_wired fitness=${fit_age}s(max=${MAX_FIT_AGE}) head-ok=$head_ok"
else
  sound_detail="fit_wired=$fit_wired fitness=${fit_age}s(max=${MAX_FIT_AGE}) head-ok=$head_ok"
fi

# ────────────────────────────────────────────────────────────────────────────
# CLAIM 4 — GOALS SELF-DERIVED (needs)
#   artifact: mesh-needs wired + ideas-queue has deficit-injected items
# ────────────────────────────────────────────────────────────────────────────
needs_wired=0; in_cron 'mesh-needs' && needs_wired=1
Q="$M/ideas-queue"
deficit_items=0
[ -f "$Q" ] && deficit_items=$(grep -cE '^\[[ ~]\].*(VERIFY FIX|REFLEX REPAIR|DECAY REVIEW)' "$Q" 2>/dev/null || true)
open_items=0
[ -f "$Q" ] && open_items=$(grep -cE '^\[ \]' "$Q" 2>/dev/null || true)

goals_v=ABSENT
goals_detail=""
if [ "$needs_wired" = 1 ] && [ "$deficit_items" -gt 0 ]; then
  goals_v=VERIFIED
  goals_detail="wired deficit-tasks=$deficit_items open-total=$open_items"
elif [ "$needs_wired" = 1 ] && [ "$open_items" -gt 0 ]; then
  goals_v=PARTIAL
  goals_detail="wired but deficit-tasks=$deficit_items (open=$open_items — may be forage-only)"
elif [ "$needs_wired" = 1 ]; then
  goals_v=PARTIAL
  goals_detail="wired queue-empty or no deficit items yet"
else
  goals_detail="needs_wired=$needs_wired deficit-tasks=$deficit_items"
fi

# ────────────────────────────────────────────────────────────────────────────
# CLAIM 5 — PRODUCTS INTEGRATE (autowire)
#   artifact: mesh-autowire wired + autowire.log fresh + reflexes.cron has entries
# ────────────────────────────────────────────────────────────────────────────
wire_wired=0; in_cron 'mesh-autowire' && wire_wired=1
wire_age=$(artifact_age "$M/autowire.log")
reflex_entries=0
[ -f "$M/reflexes.cron" ] && reflex_entries=$(grep -cvE '^[[:space:]]*(#|$)' "$M/reflexes.cron" 2>/dev/null || true)

integrate_v=ABSENT
integrate_detail=""
if [ "$wire_wired" = 1 ] && [ "$wire_age" -lt "$MAX_WIRE_AGE" ] && [ "$reflex_entries" -gt 0 ]; then
  integrate_v=VERIFIED
  integrate_detail="wired autowire=${wire_age}s reflexes-entries=$reflex_entries"
elif [ "$wire_wired" = 1 ] || [ "$reflex_entries" -gt 0 ]; then
  integrate_v=PARTIAL
  integrate_detail="wire_wired=$wire_wired autowire=${wire_age}s(max=${MAX_WIRE_AGE}) reflex-entries=$reflex_entries"
else
  integrate_detail="wire_wired=$wire_wired autowire=${wire_age}s reflex-entries=$reflex_entries"
fi

# ────────────────────────────────────────────────────────────────────────────
# OVERALL VERDICT
# ────────────────────────────────────────────────────────────────────────────
verdicts=("$lanes_v" "$produce_v" "$sound_v" "$goals_v" "$integrate_v")
degraded=0; partial=0
for v in "${verdicts[@]}"; do
  case "$v" in ABSENT|UNWIRED) degraded=$(( degraded + 1 ));; PARTIAL) partial=$(( partial + 1 ));; esac
done

if   [ "$degraded" -eq 0 ] && [ "$partial" -eq 0 ]; then overall=ALL-VERIFIED
elif [ "$degraded" -gt 0 ];                          then overall=DEGRADED
else                                                      overall=PARTIAL
fi

# ────────────────────────────────────────────────────────────────────────────
# REPORT
# ────────────────────────────────────────────────────────────────────────────
ts_now=$(ts)
report_hdr="autopoiesis-verify $overall | $(hostname) $ts_now"
echo "$report_hdr"
claim_status "LANES-FIRE"  "$lanes_v"     "$lanes_detail"
claim_status "THEY-PRODUCE" "$produce_v"  "$produce_detail"
claim_status "SOUND"       "$sound_v"     "$sound_detail"
claim_status "GOALS-DERIVED" "$goals_v"  "$goals_detail"
claim_status "INTEGRATED"  "$integrate_v" "$integrate_detail"

[ "$CHECK" = 1 ] && { [ "$overall" = ALL-VERIFIED ] && exit 0 || exit 1; }

# ────────────────────────────────────────────────────────────────────────────
# EDGE-TRIGGER (non-check mode only)
# ────────────────────────────────────────────────────────────────────────────
prev_overall=$(cat "$STATE" 2>/dev/null || echo "")
echo "$overall" > "$STATE"

if [ "$overall" != ALL-VERIFIED ] && [ "$prev_overall" = ALL-VERIFIED ]; then
  # transition: ok → degraded/partial
  details="lanes=$lanes_v produce=$produce_v sound=$sound_v goals=$goals_v integrate=$integrate_v"
  command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="autopoiesis-verify@$(hostname)" \
    mesh-chat "[autopoiesis-degraded] self-production loop has unverified claims: $details — check mesh-autopoiesis-verify --check for artifact evidence." >/dev/null 2>&1
elif [ "$overall" = ALL-VERIFIED ] && [ "$prev_overall" != ALL-VERIFIED ] && [ -n "$prev_overall" ]; then
  # transition: degraded/partial → ok
  command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="autopoiesis-verify@$(hostname)" \
    mesh-chat "[autopoiesis-ok] all self-production loop claims now verified by real artifacts | $(hostname) $ts_now" >/dev/null 2>&1
fi

[ "$overall" = ALL-VERIFIED ] && exit 0 || exit 1
