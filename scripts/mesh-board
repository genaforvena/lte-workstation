#!/usr/bin/env python3
"""Query the hledger-backed coordination board.

The promises journal is the queue.  chat.log remains the event source that
mesh-promises materializes, but dispatch consumers do not replay prose.
"""
from __future__ import annotations

import os
import re
import subprocess
import sys
from functools import lru_cache
from pathlib import Path


MESH = Path(os.environ.get("MESH_DIR", str(Path.home() / ".mesh")))
JOURNAL = Path(os.environ.get("MESH_PROMISE_JOURNAL", str(MESH / "promises" / "promises.journal")))
CHAT = Path(os.environ.get("MESH_CHAT_LOG", str(MESH / "chat.log")))


@lru_cache(maxsize=1)
def live_windows() -> set[str]:
    """Return the tmux window names currently able to receive a task."""
    try:
        result = subprocess.run(["tmux", "list-windows", "-a", "-F", "#{window_name}"],
                                text=True, capture_output=True, check=False)
    except OSError:
        return set()
    if result.returncode:
        return set()
    return {line.strip().lower() for line in result.stdout.splitlines() if line.strip()}


def fail(message: str, code: int = 2) -> "NoReturn":
    print(f"mesh-board: {message}", file=sys.stderr)
    raise SystemExit(code)


def hledger(*args: str) -> str:
    if not JOURNAL.is_file():
        fail(f"promise journal is unavailable: {JOURNAL}")
    try:
        result = subprocess.run(["hledger", "-f", str(JOURNAL), *args], text=True,
                                capture_output=True, check=False)
    except OSError as exc:
        fail(f"hledger is unavailable: {exc}")
    if result.returncode:
        fail(result.stderr.strip() or f"hledger failed with rc={result.returncode}", 1)
    return result.stdout


def balances() -> list[tuple[str, int]]:
    rows = []
    for line in hledger("balance", "liabilities:promises", "--flat", "--no-total", "-N").splitlines():
        match = re.match(r"^\s*(-?\d+)\s+PROMISE\s+(.+?)\s*$", line)
        if match and int(match.group(1)) > 0:
            rows.append((match.group(2), int(match.group(1))))
    return rows


@lru_cache(maxsize=1)
def board_lines_by_timestamp() -> dict[str, list[str]]:
    """Read one source snapshot per CLI query, without a persistent index."""
    result: dict[str, list[str]] = {}
    try:
        with CHAT.open(errors="replace") as source:
            for line in source:
                stamp = line.partition(" ")[0]
                result.setdefault(stamp, []).append(line.rstrip("\n"))
    except OSError:
        pass
    return result


def board_task_fields(timestamp: str) -> dict[str, str]:
    """Recover route and original task lead from the source board event.

    The journal's ``owner:`` field is the accounting debtor (usually the poster), not
    necessarily the requested destination.  Keep this lookup keyed by the journal's
    opened timestamp so the dispatch queue can preserve a route such as ``job: ...``
    without guessing from unrelated board prose.
    """
    if not timestamp or not CHAT.is_file():
        return {}
    try:
        for line in board_lines_by_timestamp().get(timestamp, []):
            if not line.startswith(timestamp + " ") or " ::  " not in line:
                continue
            raw_body = line.split(" ::  ", 1)[1]
            addressed = re.findall(r"\[@([^\]\s]+)\]\s+", raw_body)
            task_body = re.sub(r"^(?:\[@[^\]\s]+\]\s+)*\[task\]\s+", "", raw_body)
            if task_body == raw_body:
                continue
            fields = {"lead": task_body.split(" ; task:", 1)[0].strip()}
            if addressed:
                fields["route"] = addressed[-1].lower()
            match = re.match(r"([A-Za-z][A-Za-z0-9_-]*):\s+", task_body)
            candidate = match.group(1).lower() if match else ""
            explicit_owner = re.search(r"\bowner:\s*[A-Za-z][A-Za-z0-9./_+-]*", task_body, re.I)
            if not addressed and not explicit_owner and candidate not in live_windows():
                fields["unassigned"] = "1"
            if not fields.get("route"):
                fields["route"] = candidate if candidate in live_windows() else ""
            elif fields["route"] not in live_windows():
                fields["route"] = ""
            return fields
    except OSError:
        return {}
    return {}


def board_route(timestamp: str) -> str:
    return board_task_fields(timestamp).get("route", "")


def metadata() -> dict[str, dict[str, str]]:
    result: dict[str, dict[str, str]] = {}
    current: dict[str, str] = {}
    for line in hledger("print", "liabilities:promises").splitlines() + [""]:
        if line and not line[0].isspace():
            current = {}
            task = re.search(r"(?:^|[ ;])task:([^ ,]+)", line)
            owner = re.search(r"(?:^|[ ;])owner:([^ ,]+)", line)
            prio = re.search(r"(?:^|[ ;])(?:prio|priority):(incident|normal)", line)
            opened = re.search(r"promise opened:\s*([^ ;]+)", line)
            if task:
                current["slug"] = task.group(1)
            elif opened:
                current["slug"] = opened.group(1)
            if owner:
                current["owner"] = owner.group(1)
            current["lead"] = line.split("*", 1)[-1].strip()
            opened_ts = re.search(r"opened:(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ)", line)
            if opened_ts:
                fields = board_task_fields(opened_ts.group(1))
                current["route"] = fields.get("route", "")
                current["unassigned"] = fields.get("unassigned", "")
                if fields.get("lead"):
                    current["lead"] = fields["lead"]
            if prio:
                current["prio"] = prio.group(1)
        elif not line and current.get("slug"):
            result.setdefault(current["slug"], current)
            current = {}
    return result


def open_rows() -> list[dict[str, str]]:
    meta = metadata()
    human_owners = set((os.environ.get("MESH_HUMAN_OWNERS") or "steward operator").split())
    rows = []
    for account, amount in balances():
        bits = account.split(":")
        if len(bits) < 4:
            continue
        owner, slug = bits[-2], bits[-1]
        item = dict(meta.get(slug, {}))
        debtor = item.get("owner", "")
        destination = ("-" if item.get("unassigned") == "1" else
                       debtor if debtor in human_owners else item.get("route") or owner)
        item.update(owner=destination, slug=slug, amount=str(amount),
                    prio=item.get("prio", "normal"), lead=item.get("lead", slug))
        rows.append(item)
    return rows


def main(argv: list[str]) -> None:
    if not argv or argv[0] in ("-h", "--help"):
        print("usage: mesh-board available --json | open [--dispatch] | count | owes <owner> | task <slug> | incidents")
        return
    command = argv[0]
    if command == "available" and argv[1:] == ["--json"]:
        tool = Path(__file__).with_name("mesh-staffing")
        result = subprocess.run([sys.executable, str(tool), "--json"], text=True)
        raise SystemExit(result.returncode)
    rows = open_rows()
    if command == "count" and len(argv) == 1:
        print(sum(int(row["amount"]) for row in rows))
    elif command == "open" and argv[1:] == ["--dispatch"]:
        for row in rows:
            print("\t".join(row.get(k, "") for k in ("owner", "slug", "prio", "lead")))
    elif command == "open" and len(argv) == 1:
        for row in rows:
            print(f"{row['owner']}\t{row['slug']}\t{row['prio']}\t{row['lead']}")
    elif command == "owes" and len(argv) == 2:
        for row in rows:
            if row["owner"] == argv[1]:
                print(f"{row['slug']}\t{row['prio']}\t{row['lead']}")
    elif command == "task" and len(argv) == 2:
        for row in rows:
            if row["slug"] == argv[1]:
                print("\t".join(row.get(k, "") for k in ("owner", "slug", "prio", "lead", "amount")))
    elif command == "incidents" and len(argv) == 1:
        for row in rows:
            if row["prio"] == "incident":
                print(f"{row['owner']}\t{row['slug']}\t{row['lead']}")
    else:
        fail("invalid arguments (use --help)")


if __name__ == "__main__":
    main(sys.argv[1:])
