#!/usr/bin/env python3
"""Query the hledger-backed coordination board.

The promises journal is the queue.  chat.log remains the event source that
mesh-promises materializes, but dispatch consumers do not replay prose.
"""
from __future__ import annotations

import os
import re
import subprocess
import sys
from pathlib import Path


MESH = Path(os.environ.get("MESH_DIR", str(Path.home() / ".mesh")))
JOURNAL = Path(os.environ.get("MESH_PROMISE_JOURNAL", str(MESH / "promises" / "promises.journal")))


def fail(message: str, code: int = 2) -> "NoReturn":
    print(f"mesh-board: {message}", file=sys.stderr)
    raise SystemExit(code)


def hledger(*args: str) -> str:
    if not JOURNAL.is_file():
        fail(f"promise journal is unavailable: {JOURNAL}")
    try:
        result = subprocess.run(["hledger", "-f", str(JOURNAL), *args], text=True,
                                capture_output=True, check=False)
    except OSError as exc:
        fail(f"hledger is unavailable: {exc}")
    if result.returncode:
        fail(result.stderr.strip() or f"hledger failed with rc={result.returncode}", 1)
    return result.stdout


def balances() -> list[tuple[str, int]]:
    rows = []
    for line in hledger("balance", "liabilities:promises", "--flat", "--no-total", "-N").splitlines():
        match = re.match(r"^\s*(-?\d+)\s+PROMISE\s+(.+?)\s*$", line)
        if match and int(match.group(1)) > 0:
            rows.append((match.group(2), int(match.group(1))))
    return rows


def metadata() -> dict[str, dict[str, str]]:
    result: dict[str, dict[str, str]] = {}
    current: dict[str, str] = {}
    for line in hledger("print", "liabilities:promises").splitlines() + [""]:
        if line and not line[0].isspace():
            current = {}
            task = re.search(r"(?:^|[ ;])task:([^ ,]+)", line)
            owner = re.search(r"(?:^|[ ;])owner:([^ ,]+)", line)
            prio = re.search(r"(?:^|[ ;])prio:(incident|normal)", line)
            opened = re.search(r"promise opened:\s*([^ ;]+)", line)
            if task:
                current["slug"] = task.group(1)
            elif opened:
                current["slug"] = opened.group(1)
            if owner:
                current["owner"] = owner.group(1)
            if prio:
                current["prio"] = prio.group(1)
            current["lead"] = line.split("*", 1)[-1].strip()
        elif not line and current.get("slug"):
            result.setdefault(current["slug"], current)
            current = {}
    return result


def open_rows() -> list[dict[str, str]]:
    meta = metadata()
    rows = []
    for account, amount in balances():
        bits = account.split(":")
        if len(bits) < 4:
            continue
        owner, slug = bits[-2], bits[-1]
        item = dict(meta.get(slug, {}))
        item.update(owner=owner, slug=slug, amount=str(amount),
                    prio=item.get("prio", "normal"), lead=item.get("lead", slug))
        rows.append(item)
    return rows


def main(argv: list[str]) -> None:
    if not argv or argv[0] in ("-h", "--help"):
        print("usage: mesh-board open [--dispatch] | count | owes <owner> | task <slug> | incidents")
        return
    command = argv[0]
    rows = open_rows()
    if command == "count" and len(argv) == 1:
        print(sum(int(row["amount"]) for row in rows))
    elif command == "open" and argv[1:] == ["--dispatch"]:
        for row in rows:
            print("\t".join(row.get(k, "") for k in ("owner", "slug", "prio", "lead")))
    elif command == "open" and len(argv) == 1:
        for row in rows:
            print(f"{row['owner']}\t{row['slug']}\t{row['prio']}\t{row['lead']}")
    elif command == "owes" and len(argv) == 2:
        for row in rows:
            if row["owner"] == argv[1]:
                print(f"{row['slug']}\t{row['prio']}\t{row['lead']}")
    elif command == "task" and len(argv) == 2:
        for row in rows:
            if row["slug"] == argv[1]:
                print("\t".join(row.get(k, "") for k in ("owner", "slug", "prio", "lead", "amount")))
    elif command == "incidents" and len(argv) == 1:
        for row in rows:
            if row["prio"] == "incident":
                print(f"{row['owner']}\t{row['slug']}\t{row['lead']}")
    else:
        fail("invalid arguments (use --help)")


if __name__ == "__main__":
    main(sys.argv[1:])
