#!/usr/bin/env bash
# mesh-overview — all mesh state in one compact view (<5s, no slow probes).
# Reads cached .state files + live tmux/tailscale — never SSH or BLE scans.
#
#   mesh-overview          compact summary (situaton · fleet · minds · senses)
#   mesh-overview --json   machine-readable (subset)
#   mesh-overview --test   smoke test
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
MESH="$HOME/.mesh"

[ "${1:-}" = --test ] && {
  command -v tmux >/dev/null 2>&1 || { echo "smoke-test: FAIL (no tmux)"; exit 1; }
  [ -d "$MESH" ] || { echo "smoke-test: FAIL (no ~/.mesh)"; exit 1; }
  echo "smoke-test: ok"; exit 0
}

TS="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
HOST="$(hostname)"

# ── helpers ──────────────────────────────────────────────────────────────────
_state(){ cat "$MESH/${1}" 2>/dev/null | head -1 | tr -d '\n' || printf '?'; }
_age(){  # seconds since file mtime, or "?" if missing
  local f="$MESH/${1}"; [ -f "$f" ] || { printf '?'; return; }
  printf '%ds' "$(( $(date +%s) - $(stat -c %Y "$f" 2>/dev/null || echo 0) ))"
}
_stale(){ # prints " [Xm stale]" if older than $2 seconds
  local f="$MESH/${1}"; [ -f "$f" ] || { printf ' [missing]'; return; }
  local age; age=$(( $(date +%s) - $(stat -c %Y "$f" 2>/dev/null || echo 0) ))
  [ "$age" -gt "${2:-300}" ] && printf ' [%dm stale]' "$(( age / 60 ))" || true
}

# ── SITUATION ──────────────────────────────────────────────────────────────
sit="$(_state .situation.state)"
per="$(awk -F'\t' '{print $2"/"$3"/"$4"/"$5}' "$MESH/.perimeter.state" 2>/dev/null || echo '?')"
per_age="$(_stale .perimeter.state 900)"
sit_icon="✓"; case "$sit" in WATCH) sit_icon="⚠";; ALERT) sit_icon="!";; esac

# ── FLEET ──────────────────────────────────────────────────────────────────
ts_json="$(tailscale status --json 2>/dev/null || echo '{}')"
fleet_lines=""
self_ip="$(tailscale ip 2>/dev/null | head -1)"
self_temp="$(awk -F'[=°]' '/x86_pkg_temp:/{print $2}' "$MESH/therm.log" 2>/dev/null | tail -1)"
[ -z "$self_temp" ] && self_temp="$(awk '{n=split($0,a,/max=/); if(n>1){sub(/°C.*/,"",a[2]); print a[2]; exit}}' "$MESH/therm.log" 2>/dev/null | tail -1)"
load="$(awk '{print $1}' /proc/loadavg 2>/dev/null)"

self_temp_c="$(tail -1 "$MESH/therm.log" 2>/dev/null | grep -oE 'max=[0-9.]+' | grep -oE '[0-9.]+' | head -1)"
# Self line
fleet_lines+="  ✓ ${HOST}  ${self_temp_c:--}°C  load=${load:--}"$'\n'

# Peers from tailscale (all lte-node tagged)
fleet_lines+="$(printf '%s' "$ts_json" | python3 -c "
import json, sys
d=json.load(sys.stdin)
seen = {}
for p in d.get('Peer',{}).values():
    name = p.get('HostName','?')
    online = p.get('Online', False)
    ip = (p.get('TailscaleIPs') or [''])[0]
    icon = '✓' if online else '✗'
    # deduplicate: if same name, keep online over offline
    if name in seen:
        if online: seen[name] = (icon, ip, online)
    else:
        seen[name] = (icon, ip, online)
for name,(icon,ip,online) in sorted(seen.items(), key=lambda x: (not x[1][2], x[0])):
    print(f'  {icon} {name:<34} {\"online\" if online else \"offline\"}  {ip}')
" 2>/dev/null || true)"

# ── MINDS ──────────────────────────────────────────────────────────────────
minds_summary="$(mesh-mind-control 2>/dev/null | python3 -c "
import sys, re
working, idle, limited, dead = [], [], [], []
for line in sys.stdin:
    m = re.match(r'  (\S+)\s+\S+\s+(\S.*?)\s{2,}', line)
    if not m: continue
    win, state = m.group(1), m.group(2).strip()
    if 'WORKING' in state: working.append(win)
    elif 'IDLE' in state: idle.append(win)
    elif 'RATE' in state or 'LIMITED' in state: limited.append(win)
    elif 'DEAD' in state: dead.append(win)
parts = []
if working: parts.append('WORKING:' + ','.join(working))
if idle: parts.append(f'{len(idle)}-idle')
if limited: parts.append('RATE-LIMITED:' + ','.join(limited))
if dead: parts.append('DEAD:' + ','.join(dead))
print('  '.join(parts) if parts else '(no minds)')
" 2>/dev/null || echo '?')"

pool_line="$(mesh-mind-control 2>/dev/null | grep 'Idle.*ready' | sed 's/.*: *//' | head -1)"
spend_line="$(mesh-mind-control 2>/dev/null | grep 'Spend' | head -1 | sed 's/^  *//')"

# ── SENSES ──────────────────────────────────────────────────────────────────
household="$(_state .household.state)$(_stale .household.state 600)"
op_home="$(_state .op-home.state)$(_stale .op-home.state 600)"
room="$(_state .room-sense.state)$(_stale .room-sense.state 600)"
ambient="$(_state .ambient-clock.state)$(_stale .ambient-clock.state 600)"
hw_health="$(_state .hw-health.state)"

# BLE named devices from last presence scan (extract non-? non-MAC names)
ble_named="$(tail -n 1 "$MESH/presence.log" 2>/dev/null | python3 -c "
import sys, re
line = sys.stdin.read()
m = re.search(r'devices=\[(.+)\]', line)  # greedy: last ] closes the devices array
if not m: sys.exit(0)
inner = m.group(1)
# split on boundaries between entries: 'name rssi|mac|' pattern
parts = re.split(r'\s+(?=-?\d+\|[0-9A-Fa-f:]{17}\|)', inner)
names = []
for p in parts:
    fields = p.split('|', 2)
    if len(fields) >= 3:
        name = fields[2].strip()
        if name and name != '?' and not re.match(r'^[0-9A-Fa-f:]{17}$', name):
            names.append(name)
print(', '.join(names) if names else '')
" 2>/dev/null || echo '')"
ble_ts="$(_stale presence.log 600)"

# ── OUTPUT ──────────────────────────────────────────────────────────────────
if [ "${1:-}" = --json ]; then
  printf '{"ts":"%s","host":"%s","situation":"%s","household":"%s","op_home":"%s","room":"%s"}\n' \
    "$TS" "$HOST" "$sit" "$household" "$op_home" "$room"
  exit 0
fi

printf '=== MESH OVERVIEW · %s · %s ===\n' "$HOST" "$TS"
printf '%s SITUATION: %-8s | perimeter=%s%s\n' "$sit_icon" "$sit" "$per" "$per_age"
echo ""
echo "FLEET:"
printf '%s\n' "$fleet_lines"
echo "MINDS:"
printf '  %s\n' "${minds_summary:-?}"
[ -n "$pool_line" ] && printf '  pool: %s\n' "$pool_line"
[ -n "$spend_line" ] && printf '  %s\n' "$spend_line"
echo ""
echo "SENSES:"
printf '  household=%-12s | operator_home=%-10s | room=%s\n' "$household" "$op_home" "$room"
printf '  ambient=%-12s  | hw_health=%s\n' "$ambient" "$hw_health"
printf '  ble: %s%s\n' "${ble_named:-none}" "$ble_ts"
