#!/usr/bin/env bash
# orphan-ok: on-demand paired Note 3 orientation × gyroscope reading; no cadence or temporal corpus yet
# mesh-note3-posture-rotation — simultaneous posture and rotation-rate instrument.
#
# Joins the Note 3 HAL orientation (type 3) and gyroscope (type 4) events from one sensorcat
# listener. The pair distinguishes a fixed tilted posture from rotation through that posture;
# neither angle nor angular velocity says that alone. This first version publishes raw paired
# evidence and an instantaneous relation. The relation uses explicit geometric/rate bands, does not
# claim sustained stability, and publishes the thresholds with the reading.
#
#   mesh-note3-posture-rotation          one live paired sample
#   mesh-note3-posture-rotation --json   machine-readable pair
#   mesh-note3-posture-rotation --test   fixture checks plus a real paired HAL read
#
# Exit 2 means the body, either event, freshness, or pair alignment is unavailable. No stale or
# single-axis value is passed off as a joint reading. This on-demand instrument writes no state.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME="$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6)"
export HOME
[ -f "$HOME/.mesh/nodes" ] && [ -z "${MESH_SKIP_NODES_SOURCE:-}" ] && . "$HOME/.mesh/nodes"

NOTE3_ADB_NODE="${MESH_NOTE3_ADB_NODE:-${MESH_BARO_ADB_NODE:-}}"
NOTE3_ADB_SERIAL="${MESH_NOTE3_ADB_SERIAL:-${MESH_BARO_ADB_SERIAL:-}}"
MAX_SKEW_MS="${MESH_NOTE3_PAIR_MAX_SKEW_MS:-250}"
MAX_AGE_MS="${MESH_NOTE3_PAIR_MAX_AGE_MS:-2000}"

parse_pair() {
  local pair_raw
  pair_raw="$(cat)" || return 2
  PAIR_RAW="$pair_raw" python3 - "$MAX_SKEW_MS" "$MAX_AGE_MS" <<'PY'
import json, math, os, sys

max_skew_ms, max_age_ms = map(float, sys.argv[1:3])
records = {}
uptime = None
for line in os.environ["PAIR_RAW"].splitlines():
    line = line.strip().replace("\r", "")
    if line.startswith("UPTIME="):
        try:
            uptime = float(line[7:].split()[0])
        except (ValueError, IndexError):
            pass
        continue
    p = line.split("|")
    if len(p) != 7 or p[0] != "SENSOR" or p[2] not in ("3", "4"):
        continue
    try:
        axes = [float(x) for x in p[3:6]]
        tick = int(p[6])
    except ValueError:
        continue
    if not all(math.isfinite(x) for x in axes) or tick <= 0:
        continue
    records[p[2]] = (axes, tick)

if uptime is None or "3" not in records or "4" not in records:
    print("UNKNOWN|why=missing-or-malformed-paired-event", file=sys.stderr)
    sys.exit(2)
(az, pitch, roll), orient_tick = records["3"]
(gx, gy, gz), gyro_tick = records["4"]
skew_ms = abs(orient_tick - gyro_tick) / 1e6
age_ms = (uptime * 1e9 - max(orient_tick, gyro_tick)) / 1e6
if age_ms < 0 or age_ms > max_age_ms:
    print("UNKNOWN|why=stale-or-future-hal-event", file=sys.stderr)
    sys.exit(2)
if skew_ms > max_skew_ms:
    print("UNKNOWN|why=paired-events-outside-skew", file=sys.stderr)
    sys.exit(2)

result = {
    "orientation_deg": {"azimuth": az, "pitch": pitch, "roll": roll},
    "angular_velocity_rad_s": {"x": gx, "y": gy, "z": gz,
                               "magnitude": math.sqrt(gx*gx + gy*gy + gz*gz)},
    "posture_rotation_relation": (
        ("UPRIGHTISH" if math.hypot(pitch, roll) <= 30.0 else "TILTED") + "_" +
        ("LOW_RATE" if math.sqrt(gx*gx + gy*gy + gz*gz) <= 0.05 else "ROTATING")
    ),
    "relation_thresholds": {"tilt_deg": 30.0, "angular_rate_rad_s": 0.05},
    "coverage": "1/1 paired sample",
    "pair_skew_ms": round(skew_ms, 3),
    "pair_age_ms": round(age_ms, 3),
    "hal_ticks_ns": {"orientation": orient_tick, "gyroscope": gyro_tick},
    "source": "Note 3 sensorcat HAL types 3+4",
}
print(json.dumps(result, separators=(",", ":")))
PY
}

read_live() {
  local serial="" remote out
  [ -n "$NOTE3_ADB_SERIAL" ] && serial="-s $NOTE3_ADB_SERIAL"
  remote="/data/local/tmp/sensorcat --secs 3 3 4; echo UPTIME=\$(cat /proc/uptime)"
  if [ "$NOTE3_ADB_NODE" = local ]; then
    mesh-note3-tool-install sensorcat >/dev/null 2>&1 || return 2
    timeout 25 adb $serial shell "$remote" 2>/dev/null
  elif [ -n "$NOTE3_ADB_NODE" ]; then
    timeout 35 ssh -o BatchMode=yes -o ConnectTimeout=8 -o StrictHostKeyChecking=accept-new \
      "$NOTE3_ADB_NODE" "adb $serial shell '$remote'" </dev/null 2>/dev/null
  else
    return 2
  fi
}

if [ "${1:-}" = --test ]; then
  td="$(mktemp -d)" || { echo 'mesh-note3-posture-rotation --test: FAIL (mktemp)' >&2; exit 1; }
  trap 'rm -rf "$td"' EXIT
  cat >"$td/pair" <<'EOF'
SENSOR|Orientation Sensor|3|348.1|-41.5|-62.3|45500350144989
SENSOR|MPU6500 Gyroscope Sensor|4|0.001|0.004|0.009|45500355187280
UPTIME=45501.0 0.00
EOF
  fixture="$(parse_pair <"$td/pair")" || { echo 'mesh-note3-posture-rotation --test: FAIL (valid pair rejected)' >&2; exit 1; }
  printf '%s\n' "$fixture" | python3 -c 'import json,sys; d=json.load(sys.stdin); assert d["coverage"] == "1/1 paired sample" and d["hal_ticks_ns"]["orientation"] != d["hal_ticks_ns"]["gyroscope"] and d["pair_skew_ms"] < 250 and d["posture_rotation_relation"] == "TILTED_LOW_RATE" and d["relation_thresholds"] == {"tilt_deg":30.0,"angular_rate_rad_s":0.05}' \
    || { echo 'mesh-note3-posture-rotation --test: FAIL (paired artifact fields)' >&2; exit 1; }
  cat >"$td/rotating" <<'EOF'
SENSOR|Orientation Sensor|3|12|8|4|45500350144989
SENSOR|MPU6500 Gyroscope Sensor|4|0.2|0.2|0.2|45500355187280
UPTIME=45501.0 0.00
EOF
  rotating="$(parse_pair <"$td/rotating")" || { echo 'mesh-note3-posture-rotation --test: FAIL (valid rotating pair rejected)' >&2; exit 1; }
  printf '%s\n' "$rotating" | python3 -c 'import json,sys; d=json.load(sys.stdin); assert d["posture_rotation_relation"] == "UPRIGHTISH_ROTATING"' \
    || { echo 'mesh-note3-posture-rotation --test: FAIL (orientation×rotation relation)' >&2; exit 1; }
  grep -v 'Gyroscope' "$td/pair" >"$td/missing"
  if parse_pair <"$td/missing" >/dev/null 2>&1; then echo 'mesh-note3-posture-rotation --test: FAIL (single axis accepted)' >&2; exit 1; fi
  sed 's/45501.0/45510.0/' "$td/pair" >"$td/stale"
  if parse_pair <"$td/stale" >/dev/null 2>&1; then echo 'mesh-note3-posture-rotation --test: FAIL (stale pair accepted)' >&2; exit 1; fi
  live="$(read_live 2>/dev/null)" || { echo 'mesh-note3-posture-rotation --test: n/a (Note 3 HAL pair unreachable; exit 2)' >&2; exit 2; }
  live_pair="$(printf '%s\n' "$live" | parse_pair)" || { echo 'mesh-note3-posture-rotation --test: n/a (no fresh aligned orientation+gyro pair; exit 2)' >&2; exit 2; }
  echo "mesh-note3-posture-rotation --test: PASS (joint relation fixtures + real paired HAL event: $live_pair)"
  exit 0
fi

json=0
case "${1:-}" in '' ) ;; --json) json=1 ;; *) echo 'usage: mesh-note3-posture-rotation [--json|--test]' >&2; exit 1 ;; esac
raw="$(read_live 2>/dev/null)" || { echo 'mesh-note3-posture-rotation: UNKNOWN — Note 3 HAL unreachable' >&2; exit 2; }
pair="$(printf '%s\n' "$raw" | parse_pair)" || { echo 'mesh-note3-posture-rotation: UNKNOWN — no fresh aligned orientation+gyro pair' >&2; exit 2; }
if [ "$json" -eq 1 ]; then
  printf '%s\n' "$pair"
else
  printf '%s\n' "$pair" | python3 -c 'import json,sys; d=json.load(sys.stdin); o=d["orientation_deg"]; g=d["angular_velocity_rad_s"]; print("[note3-posture-rotation] relation={posture_rotation_relation} orientation=(az={az:.1f},pitch={pitch:.1f},roll={roll:.1f})deg angular_velocity=({x:.4f},{y:.4f},{z:.4f})rad/s |g|={magnitude:.4f}rad/s coverage={coverage} skew={pair_skew_ms}ms age={pair_age_ms}ms".format(**o, **g, **d))'
fi
