#!/usr/bin/env python3
"""Read-only census of windows eligible to receive a Ledger-backed task."""
from __future__ import annotations

import datetime as dt
import json
import os
import re
import subprocess
import sys
from pathlib import Path


FIELDS = ("window", "role", "live", "protected", "open_promises", "open_holds",
          "eligible", "reason", "observed_at")
REASONS = ("not-live", "communication-window", "human-owned",
           "protected-role-or-substrate", "open-hold", "already-owned-work")


def fail(message: str, code: int = 2) -> None:
    print(f"mesh-staffing: {message}", file=sys.stderr)
    raise SystemExit(code)


def run(argv: list[str], label: str) -> str:
    try:
        p = subprocess.run(argv, text=True, capture_output=True, check=False, timeout=8)
    except (OSError, subprocess.TimeoutExpired) as exc:
        fail(f"{label} unreadable: {exc}")
    if p.returncode:
        fail(f"{label} unreadable (rc={p.returncode}): {p.stderr.strip()}")
    return p.stdout


def live_windows() -> set[str]:
    # A fixture may provide the exact census output, but the live path is tmux itself.
    override = os.environ.get("MESH_STAFFING_LIVE_WINDOWS")
    if override is not None:
        return {x for x in override.split() if x}
    session = os.environ.get("MESH_STAFFING_TMUX_SESSION", subprocess.getoutput("hostname"))
    out = run(["tmux", "list-windows", "-t", session, "-F", "#{window_name} #{window_panes}"], "tmux census")
    rows = set()
    for line in out.splitlines():
        bits = line.split()
        if len(bits) != 2 or not bits[0] or not bits[1].isdigit():
            fail("tmux census returned an invalid row")
        # A channel window has the top data pane and bottom mind pane.
        if int(bits[1]) >= 2:
            rows.add(bits[0].lower())
    return rows


def charter(window: str) -> tuple[str, bool, bool]:
    root = Path(os.environ.get("MESH_STAFFING_CHARTER_DIR", str(Path.home() / ".mesh" / "charter")))
    path = root / f"{window}.md"
    try:
        text = path.read_text()
    except OSError as exc:
        fail(f"charter for {window} unreadable: {exc}")
    role_match = re.search(r"(?im)^\s*role\s*:\s*(\S.*)\s*$", text)
    if role_match:
        role = role_match.group(1).strip()
    else:
        # Window names may themselves contain hyphens (for example tg-roz). Match the
        # heading delimiter separately instead of treating every hyphen as a name boundary.
        heading = re.search(r"(?m)^#\s+.+?\s+—\s+(.+)$", text)
        if not heading:
            heading = re.search(r"(?m)^#\s+.+?\s+-\s+(.+)$", text)
        role = heading.group(1).strip() if heading else ""
    if not role:
        fail(f"charter for {window} has no role")
    def flag(name: str, default: bool = False) -> bool:
        m = re.search(rf"(?im)^\s*{re.escape(name)}\s*:\s*(true|false|yes|no|1|0)\s*$", text)
        return default if not m else m.group(1).lower() in {"true", "yes", "1"}
    protected = flag("protected") or window in {"genome", "vpn"}
    human = flag("human-owned") or flag("human_owned") or window == "human"
    if window in {"tg", "tg-roz"}:
        role = "communication"
    return role, protected, human


def ledger() -> tuple[dict[str, int], dict[str, int]]:
    binary = os.environ.get("MESH_STAFFING_PROMISES_BIN", "mesh-promises")
    raw = run([binary, "--json"], "Ledger census")
    try:
        data = json.loads(raw)
    except json.JSONDecodeError as exc:
        fail(f"Ledger census is not JSON: {exc}")
    if not isinstance(data, dict) or not isinstance(data.get("open"), list) or not isinstance(data.get("holds"), list):
        fail("Ledger census is missing open/holds lists")
    promises: dict[str, int] = {}
    holds: dict[str, int] = {}
    for row in data["open"]:
        if not isinstance(row, dict) or not isinstance(row.get("owner"), str):
            fail("Ledger census contains an invalid promise row")
        owner = row["owner"].lower()
        promises[owner] = promises.get(owner, 0) + 1
    for row in data["holds"]:
        if not isinstance(row, dict) or not isinstance(row.get("taker"), str):
            fail("Ledger census contains an invalid hold row")
        taker = row["taker"].lower()
        holds[taker] = holds.get(taker, 0) + 1
    return promises, holds


def census() -> dict[str, object]:
    observed = dt.datetime.now(dt.timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")
    live = live_windows()
    promises, holds = ledger()
    rows = []
    for window in sorted(live):
        role, protected, human = charter(window)
        if window not in live:
            eligible, reason = False, "not-live"
        elif window in {"tg", "tg-roz"}:
            eligible, reason = False, "communication-window"
        elif human:
            eligible, reason = False, "human-owned"
        elif protected:
            eligible, reason = False, "protected-role-or-substrate"
        elif holds.get(window, 0):
            eligible, reason = False, "open-hold"
        elif promises.get(window, 0):
            eligible, reason = False, "already-owned-work"
        else:
            eligible, reason = True, "eligible"
        rows.append({"window": window, "role": role, "live": True, "protected": protected,
                     "open_promises": promises.get(window, 0), "open_holds": holds.get(window, 0),
                     "eligible": eligible, "reason": reason, "observed_at": observed})
    return {"observed_at": observed, "windows": rows}


def main(argv: list[str]) -> None:
    if argv == ["--json"]:
        print(json.dumps(census(), sort_keys=True))
        return
    if argv == ["--help"] or not argv:
        print("usage: mesh-staffing --json")
        return
    fail("invalid arguments (use --help)")


if __name__ == "__main__":
    main(sys.argv[1:])
