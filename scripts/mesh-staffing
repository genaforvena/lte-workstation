#!/usr/bin/env python3
"""Read-only census of windows eligible to receive a Ledger-backed task."""
from __future__ import annotations

import datetime as dt
import json
import os
import re
import subprocess
import sys
from pathlib import Path


FIELDS = ("window", "role", "live", "protected", "open_promises", "open_holds",
          "active_promises", "active_holds", "leaked_promises", "leaked_holds",
          "eligible", "reason", "observed_at")
REASONS = ("not-live", "communication-window", "human-owned",
           "protected-role-or-substrate", "open-hold", "already-owned-work",
           "eligible", "eligible-with-leaks")


def fail(message: str, code: int = 2) -> None:
    print(f"mesh-staffing: {message}", file=sys.stderr)
    raise SystemExit(code)


def run(argv: list[str], label: str, accepted: tuple[int, ...] = (0,)) -> str:
    try:
        p = subprocess.run(argv, text=True, capture_output=True, check=False, timeout=8)
    except (OSError, subprocess.TimeoutExpired) as exc:
        fail(f"{label} unreadable: {exc}")
    if p.returncode not in accepted:
        fail(f"{label} unreadable (rc={p.returncode}): {p.stderr.strip()}")
    return p.stdout


def live_windows() -> set[str]:
    # A fixture may provide the exact census output, but the live path is tmux itself.
    override = os.environ.get("MESH_STAFFING_LIVE_WINDOWS")
    if override is not None:
        return {x for x in override.split() if x}
    session = os.environ.get("MESH_STAFFING_TMUX_SESSION", subprocess.getoutput("hostname"))
    out = run(["tmux", "list-windows", "-t", session, "-F", "#{window_name} #{window_panes}"], "tmux census")
    rows = set()
    for line in out.splitlines():
        bits = line.split()
        if len(bits) != 2 or not bits[0] or not bits[1].isdigit():
            fail("tmux census returned an invalid row")
        # A channel window has the top data pane and bottom mind pane.
        if int(bits[1]) >= 2:
            rows.add(bits[0].lower())
    return rows


def charter(window: str) -> tuple[str, bool, bool]:
    root = Path(os.environ.get("MESH_STAFFING_CHARTER_DIR", str(Path.home() / ".mesh" / "charter")))
    path = root / f"{window}.md"
    try:
        text = path.read_text()
    except OSError as exc:
        fail(f"charter for {window} unreadable: {exc}")
    role_match = re.search(r"(?im)^\s*role\s*:\s*(\S.*)\s*$", text)
    if role_match:
        role = role_match.group(1).strip()
    else:
        # Window names may themselves contain hyphens (for example tg-roz). Match the
        # heading delimiter separately instead of treating every hyphen as a name boundary.
        heading = re.search(r"(?m)^#\s+.+?\s+—\s+(.+)$", text)
        if not heading:
            heading = re.search(r"(?m)^#\s+.+?\s+-\s+(.+)$", text)
        role = heading.group(1).strip() if heading else ""
    if not role:
        fail(f"charter for {window} has no role")
    def flag(name: str, default: bool = False) -> bool:
        m = re.search(rf"(?im)^\s*{re.escape(name)}\s*:\s*(true|false|yes|no|1|0)\s*$", text)
        return default if not m else m.group(1).lower() in {"true", "yes", "1"}
    protected = flag("protected") or window in {"genome", "vpn"}
    human = flag("human-owned") or flag("human_owned") or window == "human"
    if window in {"tg", "tg-roz"}:
        role = "communication"
    return role, protected, human


def ledger() -> tuple[dict[str, int], dict[str, int]]:
    # Canonical source is the task ledger (`mesh-task audit`, one row per unfinished
    # chain), not the retired promises replay. The promises view counted ancient board
    # prose as live obligations and took >8s to replay a 40M+ chat.log, which left this
    # census unreadable and dispatch admission blind. Mapping (parity with the old gate
    # shape: a window actively working is ineligible; queued-but-unclaimed work stays
    # visible without being confused with busyness):
    #   RUNNING (live lease = claimed, at work) ............ active hold
    #   OVERDUE (lease expired, needs recovery) ............. leaked hold
    #   QUEUED / OPEN_UNOWNED (offered, awaiting take) ...... active promise
    #   BLOCKED (parked on an external event, not owned effort; the old view aged these
    #     into leaks after 24h — steady-state equivalent) ... leaked promise
    # Terminal rows (DONE/REJECTED/HELD_REJECTED) are settled and skipped. An
    # unrecognized non-terminal status counts as an active promise (fail toward
    # ineligibility, never toward silent dispatch).
    binary = os.environ.get("MESH_STAFFING_TASK_BIN", "mesh-task")
    raw = run([binary, "audit"], "Task census", accepted=(0,))
    promises: dict[str, int] = {}
    active_promises: dict[str, int] = {}
    leaked_promises: dict[str, int] = {}
    holds: dict[str, int] = {}
    active_holds: dict[str, int] = {}
    leaked_holds: dict[str, int] = {}
    for line in raw.splitlines():
        bits = line.split()
        if len(bits) < 3:
            fail(f"Task census returned an invalid row: {line!r}")
        status, owner = bits[0], bits[1].lower()
        if status in ("DONE", "REJECTED", "HELD_REJECTED"):
            continue
        elif status == "RUNNING":
            holds[owner] = holds.get(owner, 0) + 1
            active_holds[owner] = active_holds.get(owner, 0) + 1
        elif status == "OVERDUE":
            holds[owner] = holds.get(owner, 0) + 1
            leaked_holds[owner] = leaked_holds.get(owner, 0) + 1
        elif status in ("QUEUED", "OPEN_UNOWNED"):
            promises[owner] = promises.get(owner, 0) + 1
            active_promises[owner] = active_promises.get(owner, 0) + 1
        elif status == "BLOCKED":
            promises[owner] = promises.get(owner, 0) + 1
            leaked_promises[owner] = leaked_promises.get(owner, 0) + 1
        else:
            promises[owner] = promises.get(owner, 0) + 1
            active_promises[owner] = active_promises.get(owner, 0) + 1
    return promises, active_promises, leaked_promises, holds, active_holds, leaked_holds


def census() -> dict[str, object]:
    observed = dt.datetime.now(dt.timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")
    live = live_windows()
    promises, active_promises, leaked_promises, holds, active_holds, leaked_holds = ledger()
    rows = []
    for window in sorted(live):
        role, protected, human = charter(window)
        if window not in live:
            eligible, reason = False, "not-live"
        elif window in {"tg", "tg-roz"}:
            eligible, reason = False, "communication-window"
        elif human:
            eligible, reason = False, "human-owned"
        elif protected:
            eligible, reason = False, "protected-role-or-substrate"
        elif active_holds.get(window, 0):
            eligible, reason = False, "open-hold"
        elif active_promises.get(window, 0):
            eligible, reason = False, "already-owned-work"
        else:
            has_leaks = leaked_promises.get(window, 0) or leaked_holds.get(window, 0)
            eligible, reason = True, "eligible-with-leaks" if has_leaks else "eligible"
        rows.append({"window": window, "role": role, "live": True, "protected": protected,
                     "open_promises": promises.get(window, 0), "open_holds": holds.get(window, 0),
                     "active_promises": active_promises.get(window, 0),
                     "active_holds": active_holds.get(window, 0),
                     "leaked_promises": leaked_promises.get(window, 0),
                     "leaked_holds": leaked_holds.get(window, 0),
                     "eligible": eligible, "reason": reason, "observed_at": observed})
    return {"observed_at": observed, "windows": rows}


def main(argv: list[str]) -> None:
    if argv == ["--json"]:
        print(json.dumps(census(), sort_keys=True))
        return
    if argv == ["--help"] or not argv:
        print("usage: mesh-staffing --json")
        return
    fail("invalid arguments (use --help)")


if __name__ == "__main__":
    main(sys.argv[1:])
