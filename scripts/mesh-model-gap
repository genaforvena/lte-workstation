#!/usr/bin/env python3
# orphan-ok: on-demand report. Wire it only once someone reads it regularly enough to notice it
# going stale — a cron'd report nobody reads is a log that talks to itself (cf. mesh-guardian).
"""mesh-model-gap — which organ runs a model its own bench says it should not.

THE LOOP: mesh-model-watch searches (the CLOCK), mesh-model-bench measures (the RULER),
mesh-model-resolve observes (the EYE), and this REPORTS the gap between what a consumer runs and
what it could run. Nothing here changes a consumer. That is deliberate, and it is not timidity —
see WHY THIS DOES NOT SWAP.

WHY THIS DOES NOT SWAP. It was specced as an auto-swapper that rewrites each consumer's model
ladder. Building it falsified the premise: ON THIS NODE NO LADDER IS LIVE. Every STT/TTS consumer
is pinned by env, and the pin outranks the ladder —

    mesh-note3-say   -> MESH_PIPER_VOICE   in ~/.mesh/nodes            (irina)
    mesh-voice-rx    -> MESH_WHISPER_MODEL in ~/.config/remote-access/env (ggml-large-v3-turbo-q5_0.bin)

so the ladders the swapper would have rewritten are DEAD CODE, and every swap would have been a
no-op the gate reverted. The decisions live in the pins.

And a pin is a HUMAN DECISION that this tool cannot read the reason for:

  - irina is the operator's EAR. He A/B'd her live 2026-07-14 and reversed his own first
    instruction after hearing ruslan. No metric overrules that; round-trip WER cannot hear.
  - ggml-base was ARITHMETIC — "large-v3-turbo = ~150s for a 17s note, OVER the timeout" — and
    the arithmetic was done on IdeaPad, a thermally-throttled 2-core node. On mesh-home (16
    cores) the real number is 15.04s, 10x off, against a 240s timeout. The pin migrated with the
    config file on 2026-07-14 and its premise died with the hardware.
    RESOLVED 2026-07-15: reported here, the operator read it and approved, and a HUMAN edited the
    pin to ggml-large-v3-turbo-q5_0.bin. That is the loop working as specced — the tool named the
    file and the number, the human supplied the judgement. The irina line above is what the same
    report looks like when the answer is NO, and it still stands.

Both are one line in a config file. They are indistinguishable to a program, and swapping the
first would be vandalism while swapping the second is a 2.6x accuracy win. THAT is why this
reports and a human decides.

DOMINANCE, NOT "BETTER". This ranks nothing on taste. It reports one un-arguable relation: model
X DOMINATES incumbent Y when X is better on EVERY measured axis (accuracy AND wall-clock). There
is no tradeoff to have an opinion about, so no judgement is being smuggled in. Anything merely
more-accurate-but-slower is a TRADEOFF and is reported as one, with both numbers, for a human.

A tool that started ranking models by "quality" would be lying, exactly as mesh-model-watch's
header says of itself. This one only subtracts.

STDLIB ONLY. System python3 on this node has no numpy.
"""
import os
import re
import subprocess
import sys
from pathlib import Path

HOME = Path.home()
MESH = HOME / ".mesh"
LEDGER = MESH / "model-bench.log"
BIN = Path(os.environ.get("MESH_BIN_DIR", HOME / ".local/bin"))

# Which runtime can each benched model actually be loaded BY. Keyed to mesh-model-bench's
# STT_CANDIDATES. A model absent here is INELIGIBLE everywhere — unknown loadability is never
# assumed loadable.
MODEL_RUNTIME = {
    "whisper-tiny": ("whisper-ggml", "ggml-tiny.bin"),
    "whisper-base": ("whisper-ggml", "ggml-base.bin"),
    "whisper-large-v3-turbo-q5_0": ("whisper-ggml", "ggml-large-v3-turbo-q5_0.bin"),
    "gigaam-v2_ctc": ("gigaam-torch", "v2_ctc"),
}
# What each consumer can load, and where its choice ACTUALLY comes from. The pin path is the
# point of this table: it is the file a human must edit, and naming it is most of this report's
# value. `pin=None` means the ladder really is the live surface.
CONSUMERS = {
    ("stt", "voice-rx"): {
        "runtime": "whisper-ggml",
        "pin": "MESH_WHISPER_MODEL in ~/.config/remote-access/env",
        "pin_kind": "arithmetic",   # a number, and re-measurable — see module docstring
    },
    ("stt", "room-ear"): {
        "runtime": "gigaam-torch",
        "pin": "GIGAAM_MODEL in mesh-room-gigaam.service",
        "pin_kind": "arithmetic",
    },
    ("tts", "note3-say"): {
        "runtime": "piper-onnx",
        "pin": "MESH_PIPER_VOICE in ~/.mesh/nodes",
        "pin_kind": "taste",        # THE OPERATOR'S EAR. Never propose against this.
    },
}


def read_ledger(path=None):
    """Latest row per (organ, consumer, model). FACTS ONLY — ranking happens at read time.

    `path=None` then resolve, NOT `path=LEDGER`: a default arg binds at DEF time and silently
    pins the module-load value, ignoring every later reassignment (caught by --test 2026-07-15).

    LATEST SUPERSEDES, NEVER MIN. The ledger is append-only and a re-bench must WIN, or a
    corrected measurement can never displace the wrong one it corrects. This is not theoretical:
    it holds gigaam at 0.61s (timer started after model load — a 4.63s call) AND at 4.63s (fixed,
    dafaf8d). A `min(wall)` reader would quote 0.61s forever and resurrect a headline that was
    already retracted once. Taking the min of an accuracy column is the same trap wearing a
    different hat: it cherry-picks the luckiest run instead of reporting the last honest one.
    """
    path = path or LEDGER
    rows = {}
    if not path.exists():
        return []
    for ln in path.read_text().splitlines():
        p = ln.split("\t")
        if len(p) < 9:
            continue
        try:
            r = {"ts": p[0], "organ": p[1], "consumer": p[2], "model": p[3], "fixture": p[4],
                 "wall": float(p[5]), "dur": float(p[6]), "wer": float(p[7]), "status": p[8]}
        except ValueError:
            continue
        # ts is ISO-8601 Z, so lexical order IS chronological order.
        k = (r["organ"], r["consumer"], r["model"], r["fixture"])
        if k not in rows or r["ts"] >= rows[k]["ts"]:
            rows[k] = r
    return list(rows.values())


def candidates_for(organ, consumer, runtime, rows):
    """Benched models this consumer can actually LOAD. read-ok only.

    An EMPTY row is a BROKEN organ, not a fast one. It must never enter a comparison: it would
    show up as wer=0.0 in ~0s and dominate everything on both axes — a dead organ crowned exactly
    because it produced nothing. Same shape as the whisper rpath bug, where empty stdout read as
    "no transcript" instead of "the binary did not load".
    """
    out = []
    for r in rows:
        if r["organ"] != organ or r["status"] != "read-ok":
            continue
        if MODEL_RUNTIME.get(r["model"], (None,))[0] != runtime:
            continue
        if r["consumer"] not in (consumer, "-"):
            continue
        out.append(r)
    return out


def dominates(a, b):
    """True when `a` beats `b` on EVERY axis: strictly better on one, no worse on any.

    The whole point of this relation is that it needs no weights. The moment you weight accuracy
    against latency you have invented a preference and hidden it in a tool — and the right weight
    differs per consumer (15s is nothing for a Telegram note and fatal for a room ear). Dominance
    is the only comparison that is true regardless of the weight.
    """
    better_any = a["wer"] < b["wer"] or a["wall"] < b["wall"]
    worse_none = a["wer"] <= b["wer"] and a["wall"] <= b["wall"]
    return better_any and worse_none


def incumbent_of(organ, consumer):
    """What mesh-model-resolve says this consumer NOW loads, or None.

    Resolve executes the CONSUMER'S OWN selector. We never re-derive it: a re-derivation is a
    second map, and mesh-model-resolve exists precisely because the first map lied (it hardcoded
    whisper-large-v3-turbo while gigaam was the live organ). UNKNOWN, never a default — a
    plausible-but-wrong incumbent is worse than an honest gap, being indistinguishable from a
    real reading.
    """
    try:
        r = subprocess.run([str(BIN / "mesh-model-resolve")], capture_output=True, text=True,
                           timeout=120)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if r.returncode != 0:
        return None
    for ln in r.stdout.splitlines():
        p = ln.split("\t")
        if len(p) >= 3 and p[0] == organ and p[1] == consumer:
            return p[2]
    return None


def model_of_file(fileref):
    """Map whatever resolve reported back to a benched model name, or None.

    RESOLVE'S GRANULARITY IS PER-CONSUMER, because it executes each consumer's OWN selector and
    reports what that selector yields — which is the whole point of it, and the cost of it. It
    says `ggml-base.bin` for voice-rx (whose ladder yields a FILE) and `gigaam-v2_ctc` for
    room-ear (whose unit names a MODEL). Matching only on the file ref silently failed every
    name-shaped answer, so the room ear read UNBENCHED while its rows sat in the ledger — an
    honest-looking gap that was really a lookup bug. Found by RUNNING it; no unit test had the
    shape.

    UNKNOWN, never a guess: an unrecognised ref returns None and the caller reports UNBENCHED.
    """
    for name, (_rt, ref) in MODEL_RUNTIME.items():
        if fileref in (name, ref) or Path(fileref).name in (name, ref):
            return name
    return None


def analyse(rows=None):
    """One finding per consumer. Returns list of dicts; never raises on a missing organ."""
    rows = read_ledger() if rows is None else rows
    out = []
    for (organ, consumer), meta in sorted(CONSUMERS.items()):
        f = {"organ": organ, "consumer": consumer, "pin": meta["pin"],
             "pin_kind": meta["pin_kind"]}
        inc_file = incumbent_of(organ, consumer)
        if inc_file is None:
            f.update(status="UNKNOWN", detail="resolve could not read this consumer")
            out.append(f); continue
        f["incumbent_file"] = inc_file
        inc_model = model_of_file(inc_file)
        cands = candidates_for(organ, consumer, meta["runtime"], rows)
        if not cands:
            f.update(status="UNBENCHED",
                     detail=f"no benched {meta['runtime']} candidate — this organ has no number, "
                            f"so nothing can be said about it")
            out.append(f); continue
        inc_row = next((r for r in cands if r["model"] == inc_model), None)
        if inc_row is None:
            f.update(status="UNBENCHED",
                     detail=f"incumbent {inc_file} is not in the ledger — bench it before "
                            f"comparing anything to it")
            out.append(f); continue
        f["incumbent"] = inc_model
        f["inc_wer"], f["inc_wall"] = inc_row["wer"], inc_row["wall"]

        dom = [r for r in cands if dominates(r, inc_row)]
        better = [r for r in cands if r["wer"] < inc_row["wer"] and r not in dom]
        f["dominators"] = [(r["model"], r["wer"], r["wall"]) for r in
                           sorted(dom, key=lambda r: (r["wer"], r["wall"]))]
        f["tradeoffs"] = [(r["model"], r["wer"], r["wall"]) for r in
                          sorted(better, key=lambda r: (r["wer"], r["wall"]))]
        if dom:
            f.update(status="DOMINATED",
                     detail=f"{f['dominators'][0][0]} is better on EVERY axis")
        elif better:
            f.update(status="TRADEOFF",
                     detail=f"{f['tradeoffs'][0][0]} is more accurate but slower — a human picks")
        else:
            f.update(status="OK", detail="incumbent is on the pareto front")
        out.append(f)
    return out


def render(findings):
    n_act = 0
    for f in findings:
        tag = f["status"]
        head = f"{tag:<10} {f['organ']}/{f['consumer']}"
        if tag in ("UNKNOWN", "UNBENCHED"):
            print(f"{head}\n           {f['detail']}")
            continue
        print(f"{head}  runs {f.get('incumbent', f['incumbent_file'])} "
              f"(wer={f['inc_wer']:.3f}, {f['inc_wall']:.2f}s)")
        for m, w, s in f.get("dominators", []):
            print(f"           DOMINATED BY  {m}: wer={w:.3f} ({w/f['inc_wer']:.1f}x better), "
                  f"{s:.2f}s — better on every axis, no tradeoff to weigh")
            n_act += 1
        for m, w, s in f.get("tradeoffs", []):
            print(f"           more accurate {m}: wer={w:.3f} vs {f['inc_wer']:.3f}, "
                  f"but {s:.2f}s vs {f['inc_wall']:.2f}s — a human weighs this")
            n_act += 1
        if f["status"] != "OK":
            kind = f["pin_kind"]
            note = ("THE OPERATOR'S EAR — do not propose against it"
                    if kind == "taste" else "a number: re-measure it before trusting it")
            print(f"           the choice lives in: {f['pin']}  [{kind}: {note}]")
    return n_act


# ---------------------------------------------------------------------------- test

def run_test():
    """Asserts the RELATIONS, on rows whose right answer is hand-checkable.

    Does not touch the real ledger or any real consumer: a --test that writes the artifact a
    human reads for liveness forges the evidence it exists to check (mesh-guardian, 09f7914).
    """
    f = 0
    base = {"organ": "stt", "consumer": "voice-rx", "model": "whisper-base", "fixture": "fx",
            "wall": 1.06, "wer": 0.812, "status": "read-ok", "ts": "2026-07-15T21:04:40Z"}
    giga = {**base, "model": "gigaam-v2_ctc", "wall": 4.63, "wer": 0.312,
            "ts": "2026-07-15T21:04:45Z"}
    turbo = {**base, "model": "whisper-large-v3-turbo-q5_0", "wall": 15.04, "wer": 0.250,
             "ts": "2026-07-15T21:05:00Z"}

    # THE DOMINANCE GATE, on the exact numbers that produced a false headline. gigaam is more
    # accurate AND slower, so it does NOT dominate base. If this ever reads True, the tool is
    # re-inventing the flattering claim the bench's timing bug already made once (dafaf8d).
    if dominates(giga, base):
        print("  FAIL: gigaam (4.63s/0.312) 'dominates' base (1.06s/0.812) — it is SLOWER; "
              "this is the retracted headline coming back"); f = 1
    if dominates(base, giga):
        print("  FAIL: base 'dominates' gigaam — it is far less accurate"); f = 1

    # The warm number DOES dominate — which is why it must never be in this column.
    giga_warm = {**giga, "wall": 0.61}
    if not dominates(giga_warm, base):
        print("  FAIL: gigaam-warm (0.61s/0.312) should dominate base on both axes"); f = 1

    # THE LATEST-SUPERSEDES GATE. The real ledger holds BOTH gigaam rows; a min() reader quotes
    # 0.61s forever and the correction never lands.
    import tempfile
    td = Path(tempfile.mkdtemp(prefix="model-gap-test-"))
    try:
        led = td / "ledger.log"
        led.write_text(
            "2026-07-15T11:48:53Z\tstt\tvoice-rx\tgigaam-v2_ctc\tfx\t0.61\t18.00\t0.312\tread-ok\n"
            "2026-07-15T21:04:45Z\tstt\tvoice-rx\tgigaam-v2_ctc\tfx\t4.63\t18.00\t0.312\tread-ok\n")
        got = read_ledger(led)
        if len(got) != 1:
            print(f"  FAIL: two rows for one model should collapse to the latest, got {len(got)}"); f = 1
        elif got[0]["wall"] != 4.63:
            print(f"  FAIL: read_ledger returned wall={got[0]['wall']} — the SUPERSEDED 0.61s "
                  f"row won; a corrected measurement can never displace the error it fixes"); f = 1
    finally:
        import shutil
        shutil.rmtree(td, ignore_errors=True)

    # THE EMPTY GATE. A broken organ returns nothing in no time — wer=0.0 at 0.0s dominates
    # everything on both axes and gets crowned for producing NOTHING.
    dead = {**base, "model": "whisper-tiny", "wall": 0.01, "wer": 0.0, "status": "EMPTY"}
    cands = candidates_for("stt", "voice-rx", "whisper-ggml", [base, giga, turbo, dead])
    if any(c["model"] == "whisper-tiny" for c in cands):
        print("  FAIL: an EMPTY (broken-organ) row entered the comparison — it would dominate "
              "everything by producing nothing"); f = 1

    # THE RUNTIME GATE, on the case that will exist the day gigaam v3 lands: the INELIGIBLE model
    # is the best one. Today large-turbo happens to beat gigaam, so a dead filter still yields the
    # right answer for the whisper query — luck, not a gate. Invert it and the filter matters.
    giga_best = {**giga, "wer": 0.100}
    cands = candidates_for("stt", "voice-rx", "whisper-ggml", [base, giga_best, turbo])
    if any(MODEL_RUNTIME[c["model"]][0] != "whisper-ggml" for c in cands):
        print("  FAIL: a model voice-rx CANNOT LOAD (torch, in ~/.venv-ai) entered its whisper "
              "candidate set"); f = 1

    # Pareto: turbo is most accurate and slowest -> nothing dominates it.
    if [r for r in [base, giga, turbo] if dominates(r, turbo)]:
        print("  FAIL: something 'dominates' the most accurate model"); f = 1

    # THE GRANULARITY GATE. resolve answers in whatever shape the consumer's own selector yields:
    # a FILE for voice-rx (ggml-base.bin), a MODEL NAME for room-ear (gigaam-v2_ctc). Matching
    # only file refs read the live room ear as UNBENCHED while its rows sat in the ledger — a
    # lookup bug wearing an honest gap's clothes. Both shapes must resolve.
    for ref, want in [("ggml-base.bin", "whisper-base"),
                      ("/home/x/.mesh/whispercpp/models/ggml-base.bin", "whisper-base"),
                      ("gigaam-v2_ctc", "gigaam-v2_ctc"),
                      ("v2_ctc", "gigaam-v2_ctc")]:
        if model_of_file(ref) != want:
            print(f"  FAIL: model_of_file({ref!r}) -> {model_of_file(ref)!r}, want {want!r} — a "
                  f"resolve answer this tool cannot map reads as UNBENCHED, hiding a real gap"); f = 1
    if model_of_file("some-model-nobody-benched") is not None:
        print("  FAIL: an unknown ref resolved to a model — UNKNOWN must never become a guess"); f = 1

    print("smoke-test: ok" if f == 0 else "smoke-test: FAIL")
    return f


def main():
    args = sys.argv[1:]
    if args[:1] == ["--test"]:
        return run_test()
    findings = analyse()
    if args[:1] == ["--json"]:
        import json
        print(json.dumps(findings, ensure_ascii=False, indent=1))
        return 0
    n = render(findings)
    print(f"\n{n} adoption gap(s). This tool reports; a human decides — the choices live in "
          f"config pins, and no program can tell an ear from an arithmetic error.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
