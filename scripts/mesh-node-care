#!/usr/bin/env bash
# mesh-node-care — steward-side HARDWARE CARE for EVERY declared node, as one edge-triggered reflex.
#
# Operator 2026-06-17: "this kind of care — temp, that the cooler is OK, that everything works —
# should be a reflex for ANY declared node, always monitoring/alerting." This sweeps the fleet from
# the steward: for each node it SSHes in, reads the REAL max thermal-zone temp + load + disk + mem
# (real sensors over SSH — unlike mesh-hw-health's remote LOAD-PROXY, which cannot see a dead cooler),
# applies the dead-cooler signature (HOT cpu at LOW load = heat not leaving the die, the ds-2026-06-14
# fault), and posts to the board ONLY on a per-node state CHANGE (edge-triggered → healthy nodes are
# silent). It never touches any node's minds — pure observation.
#
# Per-node verdict: OK | HOT (load-heat, warn) | COOLER-FAULT (hot-at-low-load, hardware) |
#                   DISK | MEM | UNREACHABLE
#
# Fleet list: MESH_CARE_NODES in ~/.mesh/nodes ("label=sshaddr ..."; sshaddr 'local' = this node).
# Default covers the known Linux fleet. Router/phone have their own watchers (router-watch/body-power).
#
# reflex-cadence: */5 * * * *
set -u

. "$HOME/.local/bin/mesh-patterns.sh" 2>/dev/null || true   # weather_field (weather-consumers-phase2)
command -v weather_field >/dev/null 2>&1 || weather_field(){ echo UNKNOWN; }
MESH="$HOME/.mesh"
[ -f "$MESH/nodes" ] && . "$MESH/nodes" 2>/dev/null || true
# Default = verified-reachable Linux fleet. ilya omitted (its Tailscale-SSH user mapping rejects a
# bare user@ → permanent false UNREACHABLE = noise); add it via MESH_CARE_NODES once its addr is known.
NODES="${MESH_CARE_NODES:-ideapad=local default-string=imozerov@100.125.157.75 phaedra=root@100.94.116.17}"
STATEDIR="$MESH/node-care"; mkdir -p "$STATEDIR"
LOG="$MESH/node-care.log"

# thresholds
TEMP_HOT="${MESH_CARE_TEMP_HOT:-85}"      # cpu temp considered hot (ENTRY line)
TEMP_HYST="${MESH_CARE_TEMP_HYST:-6}"     # Schmitt-trigger band: once HOT/COOLER-FAULT, exit only
                                          # below (line - HYST). Stops the flat-threshold flap — ds
                                          # oscillating 83↔86C posted 4 [node-hot]/[node-ok] lines in
                                          # 42min (2026-07-05); the 2-read debounce can't help when the
                                          # oscillation period exceeds the debounce window.
COOLER_T="${MESH_CARE_COOLER_TEMP:-80}"   # hot threshold for the dead-cooler check (ENTRY line)
COOLER_L="${MESH_CARE_COOLER_LOAD:-0.40}" # norm-load BELOW which hot=cooler-fault (not load-heat)
DISK_MAX="${MESH_CARE_DISK_MAX:-90}"
MEM_MAX="${MESH_CARE_MEM_MAX:-92}"
# TWO DIFFERENT BUDGETS, deliberately not one. PROBE_T caps the liveness read that runs every 5 min
# for every node — polled, so it stays tight. RECOV_T caps the forensic RECOVERY CAPTURE, which
# fires at most once per node per freeze and is the only record that event will ever have; paying
# 60s once is not the same kind of cost. They were 12 and 14 — near-identical, and the 14 severed
# 2 of 15 real phaedra captures.
PROBE_T="${MESH_CARE_PROBE_TIMEOUT:-12}"
RECOV_T="${MESH_CARE_RECOVERY_TIMEOUT:-60}"

ts() { date -u +%Y-%m-%dT%H:%MZ; }

# The RECOVERY-CAPTURE payload, emitted as text so it can be run over ssh on the remote target AND
# driven locally by --test against a stubbed dmesg (a source-grep gate would assert nothing).
#
# Why the reader is PICKED and the failure is NAMED: a bare `dmesg 2>/dev/null` under
# kernel.dmesg_restrict=1 fails "read kernel buffer failed: Operation not permitted" (rc=1) and the
# redirect renders it as an EMPTY section under its own heading — `dmesg 2>/dev/null | grep -c`
# returns 0 whether the ring is empty or the read was REFUSED. This file is the ONE forensic artifact
# that exists to name a freeze, and the board tells a steward to diagnose from it, so an empty section
# reads as "no kernel evidence of a cause". Same shape as the 2026-06-24 ds fault that a narrow
# thermal grep hid — burned by a FILTER then, by a PERMISSION now. Idiom copied from
# mesh-hw-fault-watch (`sudo -n dmesg` + an explicit BLIND path); mesh-heartbeat:72 documents the
# same dmesg_restrict emptiness. UNREADABLE and HOLLOW are DISTINCT: refused-read vs a genuinely
# empty ring are different facts about the node and must not collapse into one blank section.
# ORDER MATTERS: uptime (free) → dmesg (a ring read, cheap and bounded) → journalctl -b -1 (a disk
# journal walk, the expensive and unbounded one). The whole grab is under a wall-clock cap, so
# whatever runs LAST is what a truncation eats — and the kernel ring is the evidence this block
# exists to collect. Measured: 2 of 15 phaedra captures (2026-07-15 01:40Z/10:20Z) end immediately
# after the '-- prev-boot errors --' heading with BOTH dmesg headings absent, i.e. the old order
# spent the budget on the journal and lost the ring. Ends with a COMPLETION SENTINEL so truncation
# is detected from the artifact itself, not inferred from an exit code that may not survive the pipe.
recovery_payload() { cat <<'RPAYLOAD'
echo "-- uptime --"; uptime
DM=""; DMESG_OUT=""; DMESG_ERR=""
if dmesg >/dev/null 2>&1; then DM="dmesg"; DMESG_OUT="$(dmesg 2>/dev/null)"
elif sudo -n dmesg >/dev/null 2>&1; then DM="sudo -n dmesg"; DMESG_OUT="$(sudo -n dmesg 2>/dev/null)"
else DMESG_ERR="$(dmesg 2>&1 >/dev/null | tail -1)"
fi
if [ -z "$DM" ]; then
  echo "-- dmesg: UNREADABLE (dmesg_restrict / no sudo -n) — ABSENCE OF EVIDENCE, NOT EVIDENCE OF ABSENCE --"
  echo "   reader error: ${DMESG_ERR:-(dmesg absent or produced no error text)}"
  echo "   the kernel ring was NOT captured — do not read this as 'no kernel cause'. Use the"
  echo "   prev-boot journalctl section below, and re-grab with: sudo dmesg (or set dmesg_restrict=0)."
elif [ -z "$DMESG_OUT" ]; then
  echo "-- dmesg: HOLLOW (read via '$DM' SUCCEEDED, ring is genuinely EMPTY) --"
  echo "   this is a real read of an empty buffer, not a refused one."
else
  echo "-- dmesg device/bus/thermal errors (read via '$DM') --"
  printf '%s\n' "$DMESG_OUT" | grep -iE "thermal|throttl|panic|oops|hardware error|mce|firmware|iwlwifi|bluetooth|btusb| hci|pcieport|pci.*aer| aer |xhci|usb [0-9].*(reset|error|disconnect)|ath[0-9]k|rtw|brcm|i915.*(hang|reset)|watchdog" | tail -40
  echo "-- dmesg full tail (read via '$DM') (do NOT pre-filter: a narrow thermal grep hid the ds wifi/bt-module fault, 2026-06-24) --"
  printf '%s\n' "$DMESG_OUT" | tail -80
fi
echo "-- prev-boot errors --"; journalctl -b -1 -p err --no-pager 2>/dev/null | tail -40
echo "-- CAPTURE COMPLETE --"
RPAYLOAD
}

# Completeness verdict for one capture → echoes the marker to append ("" = complete). Read off the
# ARTIFACT (the sentinel); the rc only NAMES the cause. rc alone is the weaker test — the outer
# 2>/dev/null eats ssh's "Killed by signal" notice, and a stream severed mid-flight can still exit 0.
capture_verdict() { # $1=capture file  $2=ssh rc  $3=addr
  grep -q '^-- CAPTURE COMPLETE --$' "$1" 2>/dev/null && return 0
  case "$2" in
    124) echo "-- CAPTURE TRUNCATED: ssh killed by the ${RECOV_T}s cap before the grab finished. Evidence above is PARTIAL — this is NOT 'no kernel cause found'. Re-grab by hand: ssh $3 'sudo dmesg | tail -200'. --" ;;
    0)   echo "-- CAPTURE TRUNCATED: stream ended without the completion sentinel although ssh exited 0 (connection dropped mid-stream). PARTIAL — absence below is not evidence of absence. --" ;;
    *)   echo "-- CAPTURE FAILED: ssh to $3 exited rc=$2 (connect/auth/link) — NO kernel evidence was collected for this recovery. --" ;;
  esac
}

# Pure classifier — dry-runnable by --test (the decision boundary is the tool's reason to exist).
# $6 = PREVIOUS committed verdict (the Schmitt-trigger memory): when already HOT/COOLER-FAULT the
# temperature EXIT line drops to (entry - TEMP_HYST), so a node hovering at the entry threshold holds
# its state through the hysteresis band instead of flapping every degree. Cold-start / 5-arg calls
# (prev empty) use the plain entry lines — backward-compatible.
classify() { # $1=maxt °C  $2=load  $3=nproc  $4=disk%  $5=mem%  $6=prev_committed  $7=cooling-actuation (local only)
  local t="$1" l="$2" n="$3" d="$4" m="$5" prev="${6:-}" cool="${7:-}" norm
  [ -z "$t" ] && { echo UNREACHABLE; return; }
  [ "$t" = n/a ] && { echo OK; return; }   # no thermal zones = not hot
  norm=$(awk -v l="$l" -v n="$n" 'BEGIN{if(n<1)n=1; printf "%.2f", l/n}')
  # dead cooler: hot die while barely loaded → heat not leaving. Hysteresis: hold below the entry
  # line only when already in COOLER-FAULT.
  local cool_line="$COOLER_T"; [ "$prev" = COOLER-FAULT ] && cool_line=$(( COOLER_T - TEMP_HYST ))
  if awk -v t="$t" -v ct="$cool_line" -v nm="$norm" -v cl="$COOLER_L" 'BEGIN{exit !(t>=ct && nm<cl)}'; then
    # COOLING-LOAD GATE (nodecare-coolerfault-ignores-cooling-load, discover→health baton 2026-07-10):
    # the hot-at-low-load signature is only a REAL cooler fault if the cooling devices are actually
    # pegged near max (heat cannot leave the die). $7 carries mesh-cooling-load's actuation state for
    # the LOCAL entry (SATURATED/ACTIVE/IDLE/OFFLINE); remote entries pass empty (they read their own
    # /sys, not ours). ACTIVE/IDLE = cooling working → the heat is genuine ambient/transient load-heat,
    # NOT a hardware fault → fall through to the normal HOT/OK path. SATURATED = cooling pegged while
    # still hot → confirmed COOLER-FAULT. OFFLINE/unreadable/absent → keep the SUSPECT heuristic
    # honestly (we cannot rule a dead cooler out with no actuation read) — never a fake OK.
    case "$cool" in
      SATURATED)   echo COOLER-FAULT; return ;;
      ACTIVE|IDLE) : ;;                          # cooling working → not a fault; fall through
      *)           echo COOLER-FAULT; return ;;  # OFFLINE/unknown/empty → honest heuristic fallback
    esac
  fi
  # HOT with Schmitt-trigger: enter at >=TEMP_HOT; once HOT, hold until t drops below TEMP_HOT-HYST.
  local hot_line="$TEMP_HOT"; [ "$prev" = HOT ] && hot_line=$(( TEMP_HOT - TEMP_HYST ))
  awk -v t="$t" -v h="$hot_line" 'BEGIN{exit !(t>=h)}' && { echo HOT; return; }
  [ "${d:-0}" -gt "$DISK_MAX" ] 2>/dev/null && { echo DISK; return; }
  [ "${m:-0}" -gt "$MEM_MAX" ]  2>/dev/null && { echo MEM; return; }
  echo OK
}

# Resolve the board SUBJECT for a fleet entry. A LOCAL probe measures whichever host RUNS the reflex,
# so its subject MUST be this host's own name, never the map key (nodecare-local-label-hostname): the
# shipped 'ideapad=local' default otherwise makes ds/phaedra board their OWN hardware verdict as
# 'ideapad' — a fabricated subject that would send a fixer to the wrong physical box. Matches the WHO
# (node-care@$(hostname)). $2 = host name for a local entry (a param so --test can stub it); empty
# host falls back to the map key so the subject is never blank.
resolve_label() { # $1=entry (key=addr)  $2=hostname-for-local
  local key="${1%%=*}" addr="${1#*=}" host="${2-$(hostname -s 2>/dev/null || hostname)}"
  if [ "$addr" = local ]; then printf '%s' "${host:-$key}"; else printf '%s' "$key"; fi
}

# _link_up: local-uplink bracket for the remote UNREACHABLE path (chat-review/node-care-unreachable-
# lacks-local-link-bracket, 2026-07-17). A single-attempt ssh probe read during THIS node's own
# blackout says nothing about the peer — and on the ~14min-flapping sole uplink one ~3min blackout
# straddles two 5-min raws, so the 2-read debounce PROMOTES self-blindness into a committed
# [node-down] libel (live 04:28:15Z: 'phaedra unreachable' = mesh-home's own 04:22:46→04:25:50
# outage; phaedra's uptime ran continuous). Retry-once alone cannot survive a 3-min blackout — the
# bracket can. Probe = doctor's 100ca38 pattern: route present + ping, 2 attempts (a single lost
# packet on the flappy dongle must NOT read as link-down — false "down" is the masking direction).
# MESH_NODECARE_LINK_STATE=up|down forces the verdict for testability.
_link_up(){
  case "${MESH_NODECARE_LINK_STATE:-}" in up) return 0;; down) return 1;; esac
  ip route get 1.1.1.1 >/dev/null 2>&1 || return 1
  ping -c1 -W2 1.1.1.1 >/dev/null 2>&1 && return 0
  ping -c1 -W2 1.1.1.1 >/dev/null 2>&1
}

# outdoor_forensics <verdict> [weather-state-file] — weather-consumers-phase2 (2026-07-07),
# capability-weather-thermal-forecast-20260705.md: correlate "this node is hot" against "it's hot
# OUTSIDE today", turning a bare temp reading into a forensic line a steward doesn't have to look
# up separately. Prints ' (HOT because NN°C outside today)' for a THERMAL verdict (HOT/COOLER-FAULT)
# when the local weather sense has a fresh today_max_c; prints nothing otherwise — never for a
# non-thermal verdict (a correlation nobody asked), never when weather_field renders UNKNOWN
# (honest-fusion: absent/stale weather is never fabricated into a claimed outdoor temp). ONLY valid
# for the addr=local entry: the weather sense's coordinates are wherever THIS reflex itself runs
# (~/.mesh/weather.env), not any node it merely SSHes into — a remote entry may be a different city
# entirely (phaedra is a VPS with no claimed location), so callers must gate this to local only.
outdoor_forensics() {
  local verdict="$1" wf="${2:-}" out
  case "$verdict" in HOT|COOLER-FAULT) : ;; *) return 0 ;; esac
  out="$(weather_field today_max_c "$wf")"
  case "$out" in UNKNOWN|'') return 0 ;; esac
  printf ' (HOT because %s°C outside today)' "$out"
}

if [ "${1:-}" = "--test" ]; then
  fail=0
  [ "$(classify 90 1.0 4 50 50)" = COOLER-FAULT ] || { echo "FAIL hot@lowload"; fail=1; }
  [ "$(classify 90 7.0 4 50 50)" = HOT ]          || { echo "FAIL hot@highload"; fail=1; }
  [ "$(classify 60 1.0 4 95 50)" = DISK ]         || { echo "FAIL disk"; fail=1; }
  [ "$(classify 60 1.0 4 50 95)" = MEM ]          || { echo "FAIL mem"; fail=1; }
  [ "$(classify 60 1.0 4 50 50)" = OK ]           || { echo "FAIL ok"; fail=1; }
  [ "$(classify '' '' '' '' '')" = UNREACHABLE ]  || { echo "FAIL unreach"; fail=1; }
  # Schmitt-trigger hysteresis (nodecare-hot-hysteresis): once HOT, hold through the 79..85 band.
  [ "$(classify 84 7.0 4 50 50 OK)"  = OK ]  || { echo "FAIL hyst-enter (84<85 from OK must stay OK)"; fail=1; }
  [ "$(classify 86 7.0 4 50 50 OK)"  = HOT ] || { echo "FAIL hyst-enter (86>=85 from OK must go HOT)"; fail=1; }
  [ "$(classify 80 7.0 4 50 50 HOT)" = HOT ] || { echo "FAIL hyst-hold (80 in-band from HOT must hold HOT)"; fail=1; }
  [ "$(classify 78 7.0 4 50 50 HOT)" = OK ]  || { echo "FAIL hyst-exit (78<79 from HOT must exit OK)"; fail=1; }
  # The load-boundary case: hot-at-low-load stays COOLER-FAULT, and holds through its own band.
  [ "$(classify 76 0.1 4 50 50 COOLER-FAULT)" = COOLER-FAULT ] || { echo "FAIL hyst-cool-hold (76>=74 from COOLER-FAULT holds)"; fail=1; }
  [ "$(classify 73 0.1 4 50 50 COOLER-FAULT)" = OK ]           || { echo "FAIL hyst-cool-exit (73<74 from COOLER-FAULT exits)"; fail=1; }
  # COOLING-LOAD GATE (nodecare-coolerfault-ignores-cooling-load): the hot-at-low-load signature is
  # only a real cooler fault when cooling is SATURATED. $7 = mesh-cooling-load actuation (local only).
  # (a) real dead cooler (cooling pegged, still hot) → COOLER-FAULT still caught (regression guard).
  [ "$(classify 90 1.0 4 50 50 '' SATURATED)" = COOLER-FAULT ] || { echo "FAIL coolgate-saturated (dead cooler must still alarm)"; fail=1; }
  # (b) today's false alarm: hot+low-load but cooling only ACTIVE(9.5%) → HOT, NOT COOLER-FAULT.
  #     Falsify by reverting the gate → this returns COOLER-FAULT and the assert trips.
  [ "$(classify 90 1.0 4 50 50 '' ACTIVE)"    = HOT ]          || { echo "FAIL coolgate-active (working cooler must be HOT not fault)"; fail=1; }
  [ "$(classify 90 1.0 4 50 50 '' IDLE)"      = HOT ]          || { echo "FAIL coolgate-idle (idle cooler must be HOT not fault)"; fail=1; }
  # (c) cooling actuation OFFLINE/unreadable/absent → fall back to the current heuristic honestly
  #     (keep SUSPECT COOLER-FAULT; never a fake OK). Empty $7 = the backward-compatible 6-arg path.
  [ "$(classify 90 1.0 4 50 50 '' OFFLINE)"   = COOLER-FAULT ] || { echo "FAIL coolgate-offline (unreadable → keep suspect heuristic)"; fail=1; }
  [ "$(classify 90 1.0 4 50 50 '')"           = COOLER-FAULT ] || { echo "FAIL coolgate-absent (no cooling arg → heuristic preserved)"; fail=1; }
  # THE flap fixture: an 83<->86C alternating read at high load must produce AT MOST ONE transition
  # (OK->HOT), never bounce back to OK — 83 lands in the 79..85 hold band. Reverting the hysteresis
  # (flat 85 line) makes 83 read OK every other pass → 5 transitions → this trips.
  _prev=OK; _trans=0
  for _t in 83 86 83 86 83 86; do
    _v=$(classify "$_t" 7.0 4 50 50 "$_prev")
    [ "$_v" != "$_prev" ] && _trans=$((_trans+1))
    _prev="$_v"
  done
  [ "$_trans" -le 1 ] || { echo "FAIL hyst-flap (83<->86 produced $_trans transitions, expected <=1)"; fail=1; }
  # nodecare-local-label-hostname: a LOCAL probe's board subject = the RUNNING host, never the map key.
  # Falsify: the pre-fix code labeled a local entry "${entry%%=*}" → 'ideapad' on ANY host → the first
  # assert (local entry under a stubbed non-ideapad host must NOT read 'ideapad') trips.
  [ "$(resolve_label 'ideapad=local' 'ds-box')" = ds-box ]                          || { echo "FAIL local-label (local entry must take the running host name, not map key 'ideapad')"; fail=1; }
  [ "$(resolve_label 'ideapad=local' 'ds-box')" != ideapad ]                        || { echo "FAIL local-label (local probe must NOT fabricate the map key as subject)"; fail=1; }
  [ "$(resolve_label 'default-string=imozerov@100.125.157.75' 'ds-box')" = default-string ] || { echo "FAIL remote-label (a remote entry keeps its map key, not the local host)"; fail=1; }
  [ -n "$(resolve_label 'ideapad=local' '')" ]                                      || { echo "FAIL local-label empty-host (subject must never be blank)"; fail=1; }
  [ "$(resolve_label 'ideapad=local' '')" = ideapad ]                               || { echo "FAIL local-label empty-host must fall back to the map key"; fail=1; }
  # outdoor_forensics (weather-consumers-phase2): thermal verdict + fresh weather → forensic suffix;
  # non-thermal verdict, stale/absent weather, or malformed content → nothing, ever.
  _ofd="$(mktemp -d)"
  printf 'OK 2026-07-07T10:00:00Z now_c=25.0 today_max_c=34.0 peak_hour=15 thermal_day=1 thresh_c=28\n' > "$_ofd/fresh"
  [ "$(outdoor_forensics HOT "$_ofd/fresh")" = " (HOT because 34.0°C outside today)" ] \
    || { echo "FAIL outdoor-forensics-hot (got: $(outdoor_forensics HOT "$_ofd/fresh"))"; fail=1; }
  [ "$(outdoor_forensics COOLER-FAULT "$_ofd/fresh")" = " (HOT because 34.0°C outside today)" ] \
    || { echo "FAIL outdoor-forensics-coolerfault"; fail=1; }
  [ -z "$(outdoor_forensics OK "$_ofd/fresh")" ] \
    || { echo "FAIL outdoor-forensics-ok-verdict (a non-thermal verdict must never get the suffix)"; fail=1; }
  [ -z "$(outdoor_forensics DISK "$_ofd/fresh")" ] \
    || { echo "FAIL outdoor-forensics-disk-verdict"; fail=1; }
  [ -z "$(outdoor_forensics HOT "$_ofd/no-such-file")" ] \
    || { echo "FAIL outdoor-forensics-absent-weather (must be silent, never a fabricated correlation)"; fail=1; }
  touch -d '-4 hours' "$_ofd/fresh"
  [ -z "$(outdoor_forensics HOT "$_ofd/fresh")" ] \
    || { echo "FAIL outdoor-forensics-stale-weather (>TTL must render UNKNOWN, never the last-good outdoor temp)"; fail=1; }
  rm -rf "$_ofd"
  # LINK BRACKET (chat-review/node-care-unreachable-lacks-local-link-bracket, 2026-07-17): a remote
  # UNREACHABLE read taken while THIS node's own uplink is down is a claim about us, not the peer —
  # it must not advance the debounce or post; a genuine dead peer with the link UP must still commit.
  # Full-pass drive (not a classifier unit): sandboxed HOME (own STATEDIR/log/chat), stub ssh
  # (exit 255 — transport-dead either way, the raws are indistinguishable; only the bracket differs),
  # stub mesh-chat capturing posts, forced link verdict via MESH_NODECARE_LINK_STATE.
  _lbd="$(mktemp -d)"; mkdir -p "$_lbd/bin" "$_lbd/home/.mesh/node-care"
  printf '#!/usr/bin/env bash\nexit 255\n' > "$_lbd/bin/ssh"
  printf '#!/usr/bin/env bash\necho "$*" >> "$MESH_TEST_CHATLOG"\n' > "$_lbd/bin/mesh-chat"
  chmod +x "$_lbd/bin/ssh" "$_lbd/bin/mesh-chat"
  echo OK > "$_lbd/home/.mesh/node-care/peer.state"; echo OK > "$_lbd/home/.mesh/node-care/peer.raw"
  _lbrun(){ HOME="$_lbd/home" PATH="$_lbd/bin:$PATH" MESH_TEST_CHATLOG="$_lbd/chat.log" \
            MESH_CARE_NODES="peer=stub@192.0.2.1" MESH_NODECARE_LINK_STATE="$1" bash "$0" >/dev/null 2>&1; }
  _lbrun down; _lbrun down
  [ "$(cat "$_lbd/home/.mesh/node-care/peer.raw" 2>/dev/null)" = OK ] \
    || { echo "FAIL link-bracket-hold-raw (a self-blind pass must not write an UNREACHABLE raw)"; fail=1; }
  [ "$(cat "$_lbd/home/.mesh/node-care/peer.state" 2>/dev/null)" = OK ] \
    || { echo "FAIL link-bracket-hold-committed (two self-blind passes must not commit [node-down])"; fail=1; }
  grep -q 'node-down' "$_lbd/chat.log" 2>/dev/null \
    && { echo "FAIL link-bracket-hold-post (self-blind passes must post NOTHING)"; fail=1; }
  _lbrun up; _lbrun up
  [ "$(cat "$_lbd/home/.mesh/node-care/peer.state" 2>/dev/null)" = UNREACHABLE ] \
    || { echo "FAIL link-bracket-honest-down (link-up + dead peer x2 must still commit UNREACHABLE)"; fail=1; }
  grep -q 'node-down' "$_lbd/chat.log" 2>/dev/null \
    || { echo "FAIL link-bracket-honest-post (link-up + dead peer must still post [node-down])"; fail=1; }
  rm -rf "$_lbd"

  # RECOVERY-CAPTURE dmesg readability (node-care-recovery-capture-dmesg-legs-are-unprivileged).
  # Drives the REAL payload text through sh against a stubbed dmesg/sudo — a source-grep for
  # "sudo -n" would assert its own text, never the behaviour. Each case asserts the artifact a
  # steward would actually open, and the four cases are mutually exclusive by construction.
  _rpd="$(mktemp -d)"; mkdir -p "$_rpd/bin"
  _rp_run(){ PATH="$_rpd/bin:$PATH" sh -s <<< "$(recovery_payload)" 2>/dev/null; }
  # (1) REFUSED both ways (dmesg_restrict=1, no NOPASSWD) → explicit UNREADABLE, never a blank section
  printf '#!/bin/sh\necho "dmesg: read kernel buffer failed: Operation not permitted" >&2\nexit 1\n' > "$_rpd/bin/dmesg"
  printf '#!/bin/sh\nexit 1\n' > "$_rpd/bin/sudo"; chmod +x "$_rpd/bin/dmesg" "$_rpd/bin/sudo"
  _rp="$(_rp_run)"
  case "$_rp" in *"dmesg: UNREADABLE"*) ;; *) echo "FAIL rpayload-refused-unmarked (a refused dmesg must emit UNREADABLE, not an empty section)"; fail=1 ;; esac
  case "$_rp" in *"Operation not permitted"*) ;; *) echo "FAIL rpayload-refused-no-reason (the reader's own error must reach \$rec)"; fail=1 ;; esac
  case "$_rp" in *"dmesg full tail"*) echo "FAIL rpayload-refused-empty-heading (no dmesg heading may render with nothing under it)"; fail=1 ;; esac
  # (2) sudo -n rescues it → the sections exist AND name the reader that produced them
  printf '#!/bin/sh\n[ "$1" = -n ] && shift\ncase "$1" in dmesg) echo "kernel: mce: Hardware Error: CPU 0"; exit 0;; esac\nexit 1\n' > "$_rpd/bin/sudo"
  _rp="$(_rp_run)"
  case "$_rp" in *"read via 'sudo -n dmesg'"*) ;; *) echo "FAIL rpayload-sudo-path (sudo -n dmesg must be tried and named when bare dmesg is refused)"; fail=1 ;; esac
  case "$_rp" in *"Hardware Error"*) ;; *) echo "FAIL rpayload-sudo-content (the sudo-read ring must reach both sections)"; fail=1 ;; esac
  # (3) readable but genuinely EMPTY ring → HOLLOW, a DIFFERENT fact from refused
  printf '#!/bin/sh\nexit 0\n' > "$_rpd/bin/dmesg"
  _rp="$(_rp_run)"
  case "$_rp" in *"dmesg: HOLLOW"*) ;; *) echo "FAIL rpayload-hollow (an empty ring read successfully must not report UNREADABLE)"; fail=1 ;; esac
  case "$_rp" in *"dmesg: UNREADABLE"*) echo "FAIL rpayload-hollow-mislabelled (an empty ring is not a refused read)"; fail=1 ;; esac
  # (4) ordinary readable node → unchanged behaviour, both sections, filter still applied
  printf '#!/bin/sh\necho "kernel: thermal thermal_zone0: critical temperature reached"\necho "kernel: benign chatter line"\n' > "$_rpd/bin/dmesg"
  _rp="$(_rp_run)"
  case "$_rp" in *"read via 'dmesg'"*) ;; *) echo "FAIL rpayload-plain-reader (an unrestricted node must use bare dmesg)"; fail=1 ;; esac
  case "$_rp" in *"critical temperature"*) ;; *) echo "FAIL rpayload-plain-filter (the error filter must still surface a thermal hit)"; fail=1 ;; esac
  case "$_rp" in *"benign chatter"*) ;; *) echo "FAIL rpayload-plain-fulltail (the unfiltered tail must still carry non-matching lines — the 2026-06-24 lesson)"; fail=1 ;; esac
  # ORDER: the ring must be collected BEFORE the journal walk, so a truncation eats the expensive
  # unbounded read and not the evidence this block exists for (the 2026-07-15 loss shape).
  _rp="$(_rp_run)"
  _dl="$(printf '%s\n' "$_rp" | grep -n '^-- dmesg' | head -1 | cut -d: -f1)"
  _jl="$(printf '%s\n' "$_rp" | grep -n '^-- prev-boot errors' | head -1 | cut -d: -f1)"
  [ -n "$_dl" ] && [ -n "$_jl" ] && [ "$_dl" -lt "$_jl" ] \
    || { echo "FAIL rpayload-order (dmesg must precede journalctl -b -1: a truncation eats whatever runs last)"; fail=1; }
  case "$_rp" in *"-- CAPTURE COMPLETE --"*) ;; *) echo "FAIL rpayload-sentinel (a finished grab must end with the completion sentinel)"; fail=1 ;; esac
  rm -rf "$_rpd"

  # CAPTURE COMPLETENESS verdict (node-care-recovery-capture-silently-truncates-under-load).
  # Reproduces the two real 2026-07-15 losses: a file that ends after a heading, with no sentinel.
  _cv="$(mktemp)"
  printf -- '-- uptime --\n 01:40:11 up 32 days, load average: 7.64\n-- prev-boot errors --\n' > "$_cv"
  [ -n "$(capture_verdict "$_cv" 124 peer)" ] || { echo "FAIL cv-truncated-silent (a sentinel-less capture killed by the cap must NOT verdict complete)"; fail=1; }
  case "$(capture_verdict "$_cv" 124 peer)" in *TRUNCATED*"is NOT 'no kernel cause found'"*) ;; *) echo "FAIL cv-truncated-wording (the marker must forbid reading absence as absence of cause)"; fail=1 ;; esac
  case "$(capture_verdict "$_cv" 255 peer)" in *"CAPTURE FAILED"*rc=255*) ;; *) echo "FAIL cv-failed (a dead ssh must be named FAILED with its rc, not TRUNCATED)"; fail=1 ;; esac
  # rc=0 with no sentinel = severed mid-stream: rc alone would call this a clean capture
  case "$(capture_verdict "$_cv" 0 peer)" in *TRUNCATED*"exited 0"*) ;; *) echo "FAIL cv-rc0-severed (sentinel-less + rc=0 must still be TRUNCATED — rc is the weaker test)"; fail=1 ;; esac
  # a COMPLETE capture verdicts clean and stays silent
  printf -- '-- uptime --\n-- dmesg full tail --\nx\n-- prev-boot errors --\n-- CAPTURE COMPLETE --\n' > "$_cv"
  [ -z "$(capture_verdict "$_cv" 0 peer)" ] || { echo "FAIL cv-complete (a sentinel-terminated capture must verdict clean)"; fail=1; }
  rm -f "$_cv"
  # The forensic grab and the 5-min liveness probe are DIFFERENT budgets and must not be collapsed:
  # the probe is polled (stay tight), the capture fires once per freeze and is the only forensic
  # record that event will ever have. Asserted as a relationship, not a magic number.
  [ "$RECOV_T" -gt "$PROBE_T" ] \
    || { echo "FAIL recov-budget (the once-per-freeze capture cap ${RECOV_T}s must exceed the polled probe's ${PROBE_T}s)"; fail=1; }

  [ "$fail" = 0 ] && echo "mesh-node-care --test: OK (6 boundary + 6 hysteresis + 83<->86 flap + 5 cooling-load-gate + 5 local-label + 6 outdoor-forensics + 5 link-bracket + 18 recovery-capture asserts pass)" && exit 0
  echo "mesh-node-care --test: FAIL" && exit 1
fi

# one-shot remote/local probe → "maxt load nproc disk mem up"
PROBE='
  load=$(cut -d" " -f1 /proc/loadavg); nproc=$(nproc 2>/dev/null||echo 1)
  up=$(awk "{printf \"%d\", \$1/60}" /proc/uptime)
  disk=$(df -P / 2>/dev/null|awk "NR==2{gsub(/%/,\"\",\$5);print \$5}")
  mem=$(free 2>/dev/null|awk "/Mem:/{printf \"%d\", \$3/\$2*100}")
  shopt -s nullglob; _tz=(/sys/class/thermal/thermal_zone*/temp); shopt -u nullglob
  if [ "${#_tz[@]}" = 0 ]; then maxt=n/a; else
    maxt=0; for z in "${_tz[@]}"; do t=$(cat "$z" 2>/dev/null||echo 0); [ "$t" -gt "$maxt" ]&&maxt=$t; done
    maxt=$((maxt/1000))
  fi
  echo "$maxt $load $nproc $disk $mem $up"
'

summary=""
for entry in $NODES; do
  addr="${entry#*=}"; label="$(resolve_label "$entry")"   # local → this host's own name, not the map key
  if [ "$addr" = "local" ]; then
    read -r maxt load np disk mem up < <(bash -c "$PROBE" 2>/dev/null)
  else
    read -r maxt load np disk mem up < <(timeout "$PROBE_T" ssh -o BatchMode=yes -o ConnectTimeout=6 -o StrictHostKeyChecking=no "$addr" "$PROBE" 2>/dev/null)
  fi
  # Read the prior COMMITTED verdict FIRST — it is the Schmitt-trigger memory the classifier needs
  # (hysteresis exit line depends on the state currently being emitted).
  sf="$STATEDIR/$label.state"; committed=$(cat "$sf" 2>/dev/null||echo "")
  # LOCAL entry only: read this host's cooling actuation so the classifier can distinguish a real
  # dead-cooler (SATURATED) from hot-ambient load-heat while the cooler works (ACTIVE/IDLE). Remote
  # entries pass empty → classify keeps the pure hot-at-low-load heuristic (they'd read their own /sys).
  cool_state=""
  [ "$addr" = local ] && cool_state="$(mesh-cooling-load 2>/dev/null | awk 'NR==1{print $2}')"
  verdict=$(classify "${maxt:-}" "${load:-}" "${np:-}" "${disk:-}" "${mem:-}" "$committed" "$cool_state")
  # SELF-BLIND HOLD (see _link_up): an UNREACHABLE read on a REMOTE entry while our OWN uplink is
  # down is a claim about this node, not the peer — writing it as a raw would advance the debounce
  # toward a [node-down] libel on pass 2 of our own blackout. Hold raw+committed untouched, post
  # nothing; the next link-up pass resumes honest probing. Local entries unaffected (no link needed).
  # Checked only AFTER a failed probe: a succeeding probe is its own proof of link.
  if [ "$verdict" = UNREACHABLE ] && [ "$addr" != local ] && ! _link_up; then
    echo "$(ts) $label raw=HELD committed=${committed:-} :: local uplink down at probe time — remote read unassessable (self-blind)" >> "$LOG"
    summary="$summary$label:${committed:-UNKNOWN}(held) "
    continue
  fi
  if [ "$verdict" = UNREACHABLE ]; then detail="no SSH/probe"; else
    detail="temp=${maxt}$([ "$maxt" = n/a ] || echo C) load=${load} disk=${disk}% mem=${mem}% up=${up}m"
    # outdoor-temp forensics (weather-consumers-phase2): LOCAL entry only — the weather sense's
    # coordinates are wherever THIS reflex runs, never a remote node it merely SSHes into.
    [ "$addr" = local ] && detail="$detail$(outdoor_forensics "$verdict")"
  fi

  # DEBOUNCE: a new state only COMMITS after 2 consecutive identical raw reads — so a single
  # transient (a brief temp spike under media decode, one dropped SSH) never raises a false alarm.
  # Composes with the hysteresis above: hysteresis keeps the raw verdict stable in the band, debounce
  # still guards a genuine two-read transition.
  rawf="$STATEDIR/$label.raw"; prevraw=$(cat "$rawf" 2>/dev/null||echo ""); echo "$verdict" > "$rawf"
  if [ "$verdict" = "$prevraw" ] || [ -z "$committed" ]; then newc="$verdict"; else newc="$committed"; fi
  echo "$newc" > "$sf"
  echo "$(ts) $label raw=$verdict committed=$newc :: $detail" >> "$LOG"
  summary="$summary$label:$newc "

  if [ "$newc" != "$committed" ] && [ -n "$committed" ]; then
    case "$newc" in
      OK)           msg="[node-ok] $label hardware healthy again :: $detail" ;;
      HOT)          msg="[node-hot] $label HOT (load-heat) :: $detail" ;;
      COOLER-FAULT) msg="[node-cooler-fault] $label hot-cpu-at-low-load signature — SUSPECT cooling, but a non-thermal hardware fault can also read hot (ds 2026-06-24 was a broken wifi/bt module, NOT the cooler). Corroborate with the kernel log before concluding :: $detail" ;;
      DISK)         msg="[node-disk] $label disk pressure :: $detail" ;;
      MEM)          msg="[node-mem] $label memory pressure :: $detail" ;;
      UNREACHABLE)  msg="[node-down] $label unreachable :: $detail" ;;
    esac
    command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="node-care@$(hostname)" mesh-chat "$msg" >/dev/null 2>&1
    echo "$(ts) EDGE: $msg" >> "$LOG"

    # RECOVERY CAPTURE: node came back from a freeze/down → grab last-boot kernel logs + temps so a
    # crash/kernel-panic/overheat cause is caught even unattended (the ds-2026-06-17 freeze case).
    if [ "$committed" = UNREACHABLE ] && [ "$addr" != local ]; then
      rec="$STATEDIR/$label.recovery.log"
      # The capture lands in a temp file FIRST so its completeness can be asserted before it is
      # committed to $rec. Appending straight into $rec ('{ … } >> $rec') takes whatever arrived and
      # can no longer tell a finished grab from a severed one — that is how 2 of 15 phaedra captures
      # became silently-partial files that the board still announced as "kernel logs captured".
      cap="$(mktemp)"; sshrc=0
      timeout "$RECOV_T" ssh -o BatchMode=yes -o ConnectTimeout=6 -o StrictHostKeyChecking=no "$addr" \
        "sh -s" <<< "$(recovery_payload)" > "$cap" 2>/dev/null || sshrc=$?
      # Completeness is read off the ARTIFACT (the sentinel), with the rc only NAMING the cause —
      # rc alone is the weaker test: the outer 2>/dev/null eats ssh's "Killed by signal" notice, and
      # a connection severed mid-stream can still exit 0.
      note="$(capture_verdict "$cap" "$sshrc" "$addr")"
      { echo "==== $(ts) $label recovered ($committed -> $newc) ===="
        cat "$cap"
        [ -n "$note" ] && echo "$note"
      } >> "$rec"
      rm -f "$cap"
      # The board line must carry the same verdict as the file. Telling a steward "kernel logs
      # captured (diagnose)" over a severed capture is the silence one level up: they open it, find
      # no kernel section, and read that as a clean node.
      if [ -z "$note" ]; then bmsg="kernel logs captured to $rec (steward: diagnose)"
      else bmsg="capture INCOMPLETE — ${note#-- }; partial file at $rec (steward: re-grab by hand before concluding)"; fi
      command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="node-care@$(hostname)" \
        mesh-chat "[node-recovered] $label back after freeze — $bmsg" >/dev/null 2>&1
    fi
  fi
done

echo "$(ts) fleet: $summary"
