#!/usr/bin/env bash
# mesh-node-care — steward-side HARDWARE CARE for EVERY declared node, as one edge-triggered reflex.
#
# Operator 2026-06-17: "this kind of care — temp, that the cooler is OK, that everything works —
# should be a reflex for ANY declared node, always monitoring/alerting." This sweeps the fleet from
# the steward: for each node it SSHes in, reads the REAL max thermal-zone temp + load + disk + mem
# (real sensors over SSH — unlike mesh-hw-health's remote LOAD-PROXY, which cannot see a dead cooler),
# applies the dead-cooler signature (HOT cpu at LOW load = heat not leaving the die, the ds-2026-06-14
# fault), and posts to the board ONLY on a per-node state CHANGE (edge-triggered → healthy nodes are
# silent). It never touches any node's minds — pure observation.
#
# Per-node verdict: OK | HOT (load-heat, warn) | COOLER-FAULT (hot-at-low-load, hardware) |
#                   DISK | MEM | UNREACHABLE
#
# Fleet list: MESH_CARE_NODES in ~/.mesh/nodes ("label=sshaddr ..."; sshaddr 'local' = this node).
# Default covers the known Linux fleet. Router/phone have their own watchers (router-watch/body-power).
#
# reflex-cadence: */5 * * * *
set -u

. "$HOME/.local/bin/mesh-patterns.sh" 2>/dev/null || true   # weather_field (weather-consumers-phase2)
command -v weather_field >/dev/null 2>&1 || weather_field(){ echo UNKNOWN; }
MESH="$HOME/.mesh"
[ -f "$MESH/nodes" ] && . "$MESH/nodes" 2>/dev/null || true
# Default = verified-reachable Linux fleet. ilya omitted (its Tailscale-SSH user mapping rejects a
# bare user@ → permanent false UNREACHABLE = noise); add it via MESH_CARE_NODES once its addr is known.
NODES="${MESH_CARE_NODES:-ideapad=local default-string=imozerov@100.125.157.75 phaedra=root@100.94.116.17}"
STATEDIR="$MESH/node-care"; mkdir -p "$STATEDIR"
LOG="$MESH/node-care.log"

# thresholds
TEMP_HOT="${MESH_CARE_TEMP_HOT:-85}"      # cpu temp considered hot (ENTRY line)
TEMP_HYST="${MESH_CARE_TEMP_HYST:-6}"     # Schmitt-trigger band: once HOT/COOLER-FAULT, exit only
                                          # below (line - HYST). Stops the flat-threshold flap — ds
                                          # oscillating 83↔86C posted 4 [node-hot]/[node-ok] lines in
                                          # 42min (2026-07-05); the 2-read debounce can't help when the
                                          # oscillation period exceeds the debounce window.
COOLER_T="${MESH_CARE_COOLER_TEMP:-80}"   # hot threshold for the dead-cooler check (ENTRY line)
COOLER_L="${MESH_CARE_COOLER_LOAD:-0.40}" # norm-load BELOW which hot=cooler-fault (not load-heat)
DISK_MAX="${MESH_CARE_DISK_MAX:-90}"
MEM_MAX="${MESH_CARE_MEM_MAX:-92}"

ts() { date -u +%Y-%m-%dT%H:%MZ; }

# Pure classifier — dry-runnable by --test (the decision boundary is the tool's reason to exist).
# $6 = PREVIOUS committed verdict (the Schmitt-trigger memory): when already HOT/COOLER-FAULT the
# temperature EXIT line drops to (entry - TEMP_HYST), so a node hovering at the entry threshold holds
# its state through the hysteresis band instead of flapping every degree. Cold-start / 5-arg calls
# (prev empty) use the plain entry lines — backward-compatible.
classify() { # $1=maxt °C  $2=load  $3=nproc  $4=disk%  $5=mem%  $6=prev_committed  $7=cooling-actuation (local only)
  local t="$1" l="$2" n="$3" d="$4" m="$5" prev="${6:-}" cool="${7:-}" norm
  [ -z "$t" ] && { echo UNREACHABLE; return; }
  [ "$t" = n/a ] && { echo OK; return; }   # no thermal zones = not hot
  norm=$(awk -v l="$l" -v n="$n" 'BEGIN{if(n<1)n=1; printf "%.2f", l/n}')
  # dead cooler: hot die while barely loaded → heat not leaving. Hysteresis: hold below the entry
  # line only when already in COOLER-FAULT.
  local cool_line="$COOLER_T"; [ "$prev" = COOLER-FAULT ] && cool_line=$(( COOLER_T - TEMP_HYST ))
  if awk -v t="$t" -v ct="$cool_line" -v nm="$norm" -v cl="$COOLER_L" 'BEGIN{exit !(t>=ct && nm<cl)}'; then
    # COOLING-LOAD GATE (nodecare-coolerfault-ignores-cooling-load, discover→health baton 2026-07-10):
    # the hot-at-low-load signature is only a REAL cooler fault if the cooling devices are actually
    # pegged near max (heat cannot leave the die). $7 carries mesh-cooling-load's actuation state for
    # the LOCAL entry (SATURATED/ACTIVE/IDLE/OFFLINE); remote entries pass empty (they read their own
    # /sys, not ours). ACTIVE/IDLE = cooling working → the heat is genuine ambient/transient load-heat,
    # NOT a hardware fault → fall through to the normal HOT/OK path. SATURATED = cooling pegged while
    # still hot → confirmed COOLER-FAULT. OFFLINE/unreadable/absent → keep the SUSPECT heuristic
    # honestly (we cannot rule a dead cooler out with no actuation read) — never a fake OK.
    case "$cool" in
      SATURATED)   echo COOLER-FAULT; return ;;
      ACTIVE|IDLE) : ;;                          # cooling working → not a fault; fall through
      *)           echo COOLER-FAULT; return ;;  # OFFLINE/unknown/empty → honest heuristic fallback
    esac
  fi
  # HOT with Schmitt-trigger: enter at >=TEMP_HOT; once HOT, hold until t drops below TEMP_HOT-HYST.
  local hot_line="$TEMP_HOT"; [ "$prev" = HOT ] && hot_line=$(( TEMP_HOT - TEMP_HYST ))
  awk -v t="$t" -v h="$hot_line" 'BEGIN{exit !(t>=h)}' && { echo HOT; return; }
  [ "${d:-0}" -gt "$DISK_MAX" ] 2>/dev/null && { echo DISK; return; }
  [ "${m:-0}" -gt "$MEM_MAX" ]  2>/dev/null && { echo MEM; return; }
  echo OK
}

# Resolve the board SUBJECT for a fleet entry. A LOCAL probe measures whichever host RUNS the reflex,
# so its subject MUST be this host's own name, never the map key (nodecare-local-label-hostname): the
# shipped 'ideapad=local' default otherwise makes ds/phaedra board their OWN hardware verdict as
# 'ideapad' — a fabricated subject that would send a fixer to the wrong physical box. Matches the WHO
# (node-care@$(hostname)). $2 = host name for a local entry (a param so --test can stub it); empty
# host falls back to the map key so the subject is never blank.
resolve_label() { # $1=entry (key=addr)  $2=hostname-for-local
  local key="${1%%=*}" addr="${1#*=}" host="${2-$(hostname -s 2>/dev/null || hostname)}"
  if [ "$addr" = local ]; then printf '%s' "${host:-$key}"; else printf '%s' "$key"; fi
}

# outdoor_forensics <verdict> [weather-state-file] — weather-consumers-phase2 (2026-07-07),
# capability-weather-thermal-forecast-20260705.md: correlate "this node is hot" against "it's hot
# OUTSIDE today", turning a bare temp reading into a forensic line a steward doesn't have to look
# up separately. Prints ' (HOT because NN°C outside today)' for a THERMAL verdict (HOT/COOLER-FAULT)
# when the local weather sense has a fresh today_max_c; prints nothing otherwise — never for a
# non-thermal verdict (a correlation nobody asked), never when weather_field renders UNKNOWN
# (honest-fusion: absent/stale weather is never fabricated into a claimed outdoor temp). ONLY valid
# for the addr=local entry: the weather sense's coordinates are wherever THIS reflex itself runs
# (~/.mesh/weather.env), not any node it merely SSHes into — a remote entry may be a different city
# entirely (phaedra is a VPS with no claimed location), so callers must gate this to local only.
outdoor_forensics() {
  local verdict="$1" wf="${2:-}" out
  case "$verdict" in HOT|COOLER-FAULT) : ;; *) return 0 ;; esac
  out="$(weather_field today_max_c "$wf")"
  case "$out" in UNKNOWN|'') return 0 ;; esac
  printf ' (HOT because %s°C outside today)' "$out"
}

if [ "${1:-}" = "--test" ]; then
  fail=0
  [ "$(classify 90 1.0 4 50 50)" = COOLER-FAULT ] || { echo "FAIL hot@lowload"; fail=1; }
  [ "$(classify 90 7.0 4 50 50)" = HOT ]          || { echo "FAIL hot@highload"; fail=1; }
  [ "$(classify 60 1.0 4 95 50)" = DISK ]         || { echo "FAIL disk"; fail=1; }
  [ "$(classify 60 1.0 4 50 95)" = MEM ]          || { echo "FAIL mem"; fail=1; }
  [ "$(classify 60 1.0 4 50 50)" = OK ]           || { echo "FAIL ok"; fail=1; }
  [ "$(classify '' '' '' '' '')" = UNREACHABLE ]  || { echo "FAIL unreach"; fail=1; }
  # Schmitt-trigger hysteresis (nodecare-hot-hysteresis): once HOT, hold through the 79..85 band.
  [ "$(classify 84 7.0 4 50 50 OK)"  = OK ]  || { echo "FAIL hyst-enter (84<85 from OK must stay OK)"; fail=1; }
  [ "$(classify 86 7.0 4 50 50 OK)"  = HOT ] || { echo "FAIL hyst-enter (86>=85 from OK must go HOT)"; fail=1; }
  [ "$(classify 80 7.0 4 50 50 HOT)" = HOT ] || { echo "FAIL hyst-hold (80 in-band from HOT must hold HOT)"; fail=1; }
  [ "$(classify 78 7.0 4 50 50 HOT)" = OK ]  || { echo "FAIL hyst-exit (78<79 from HOT must exit OK)"; fail=1; }
  # The load-boundary case: hot-at-low-load stays COOLER-FAULT, and holds through its own band.
  [ "$(classify 76 0.1 4 50 50 COOLER-FAULT)" = COOLER-FAULT ] || { echo "FAIL hyst-cool-hold (76>=74 from COOLER-FAULT holds)"; fail=1; }
  [ "$(classify 73 0.1 4 50 50 COOLER-FAULT)" = OK ]           || { echo "FAIL hyst-cool-exit (73<74 from COOLER-FAULT exits)"; fail=1; }
  # COOLING-LOAD GATE (nodecare-coolerfault-ignores-cooling-load): the hot-at-low-load signature is
  # only a real cooler fault when cooling is SATURATED. $7 = mesh-cooling-load actuation (local only).
  # (a) real dead cooler (cooling pegged, still hot) → COOLER-FAULT still caught (regression guard).
  [ "$(classify 90 1.0 4 50 50 '' SATURATED)" = COOLER-FAULT ] || { echo "FAIL coolgate-saturated (dead cooler must still alarm)"; fail=1; }
  # (b) today's false alarm: hot+low-load but cooling only ACTIVE(9.5%) → HOT, NOT COOLER-FAULT.
  #     Falsify by reverting the gate → this returns COOLER-FAULT and the assert trips.
  [ "$(classify 90 1.0 4 50 50 '' ACTIVE)"    = HOT ]          || { echo "FAIL coolgate-active (working cooler must be HOT not fault)"; fail=1; }
  [ "$(classify 90 1.0 4 50 50 '' IDLE)"      = HOT ]          || { echo "FAIL coolgate-idle (idle cooler must be HOT not fault)"; fail=1; }
  # (c) cooling actuation OFFLINE/unreadable/absent → fall back to the current heuristic honestly
  #     (keep SUSPECT COOLER-FAULT; never a fake OK). Empty $7 = the backward-compatible 6-arg path.
  [ "$(classify 90 1.0 4 50 50 '' OFFLINE)"   = COOLER-FAULT ] || { echo "FAIL coolgate-offline (unreadable → keep suspect heuristic)"; fail=1; }
  [ "$(classify 90 1.0 4 50 50 '')"           = COOLER-FAULT ] || { echo "FAIL coolgate-absent (no cooling arg → heuristic preserved)"; fail=1; }
  # THE flap fixture: an 83<->86C alternating read at high load must produce AT MOST ONE transition
  # (OK->HOT), never bounce back to OK — 83 lands in the 79..85 hold band. Reverting the hysteresis
  # (flat 85 line) makes 83 read OK every other pass → 5 transitions → this trips.
  _prev=OK; _trans=0
  for _t in 83 86 83 86 83 86; do
    _v=$(classify "$_t" 7.0 4 50 50 "$_prev")
    [ "$_v" != "$_prev" ] && _trans=$((_trans+1))
    _prev="$_v"
  done
  [ "$_trans" -le 1 ] || { echo "FAIL hyst-flap (83<->86 produced $_trans transitions, expected <=1)"; fail=1; }
  # nodecare-local-label-hostname: a LOCAL probe's board subject = the RUNNING host, never the map key.
  # Falsify: the pre-fix code labeled a local entry "${entry%%=*}" → 'ideapad' on ANY host → the first
  # assert (local entry under a stubbed non-ideapad host must NOT read 'ideapad') trips.
  [ "$(resolve_label 'ideapad=local' 'ds-box')" = ds-box ]                          || { echo "FAIL local-label (local entry must take the running host name, not map key 'ideapad')"; fail=1; }
  [ "$(resolve_label 'ideapad=local' 'ds-box')" != ideapad ]                        || { echo "FAIL local-label (local probe must NOT fabricate the map key as subject)"; fail=1; }
  [ "$(resolve_label 'default-string=imozerov@100.125.157.75' 'ds-box')" = default-string ] || { echo "FAIL remote-label (a remote entry keeps its map key, not the local host)"; fail=1; }
  [ -n "$(resolve_label 'ideapad=local' '')" ]                                      || { echo "FAIL local-label empty-host (subject must never be blank)"; fail=1; }
  [ "$(resolve_label 'ideapad=local' '')" = ideapad ]                               || { echo "FAIL local-label empty-host must fall back to the map key"; fail=1; }
  # outdoor_forensics (weather-consumers-phase2): thermal verdict + fresh weather → forensic suffix;
  # non-thermal verdict, stale/absent weather, or malformed content → nothing, ever.
  _ofd="$(mktemp -d)"
  printf 'OK 2026-07-07T10:00:00Z now_c=25.0 today_max_c=34.0 peak_hour=15 thermal_day=1 thresh_c=28\n' > "$_ofd/fresh"
  [ "$(outdoor_forensics HOT "$_ofd/fresh")" = " (HOT because 34.0°C outside today)" ] \
    || { echo "FAIL outdoor-forensics-hot (got: $(outdoor_forensics HOT "$_ofd/fresh"))"; fail=1; }
  [ "$(outdoor_forensics COOLER-FAULT "$_ofd/fresh")" = " (HOT because 34.0°C outside today)" ] \
    || { echo "FAIL outdoor-forensics-coolerfault"; fail=1; }
  [ -z "$(outdoor_forensics OK "$_ofd/fresh")" ] \
    || { echo "FAIL outdoor-forensics-ok-verdict (a non-thermal verdict must never get the suffix)"; fail=1; }
  [ -z "$(outdoor_forensics DISK "$_ofd/fresh")" ] \
    || { echo "FAIL outdoor-forensics-disk-verdict"; fail=1; }
  [ -z "$(outdoor_forensics HOT "$_ofd/no-such-file")" ] \
    || { echo "FAIL outdoor-forensics-absent-weather (must be silent, never a fabricated correlation)"; fail=1; }
  touch -d '-4 hours' "$_ofd/fresh"
  [ -z "$(outdoor_forensics HOT "$_ofd/fresh")" ] \
    || { echo "FAIL outdoor-forensics-stale-weather (>TTL must render UNKNOWN, never the last-good outdoor temp)"; fail=1; }
  rm -rf "$_ofd"
  [ "$fail" = 0 ] && echo "mesh-node-care --test: OK (6 boundary + 6 hysteresis + 83<->86 flap + 5 cooling-load-gate + 5 local-label + 6 outdoor-forensics asserts pass)" && exit 0
  echo "mesh-node-care --test: FAIL" && exit 1
fi

# one-shot remote/local probe → "maxt load nproc disk mem up"
PROBE='
  load=$(cut -d" " -f1 /proc/loadavg); nproc=$(nproc 2>/dev/null||echo 1)
  up=$(awk "{printf \"%d\", \$1/60}" /proc/uptime)
  disk=$(df -P / 2>/dev/null|awk "NR==2{gsub(/%/,\"\",\$5);print \$5}")
  mem=$(free 2>/dev/null|awk "/Mem:/{printf \"%d\", \$3/\$2*100}")
  shopt -s nullglob; _tz=(/sys/class/thermal/thermal_zone*/temp); shopt -u nullglob
  if [ "${#_tz[@]}" = 0 ]; then maxt=n/a; else
    maxt=0; for z in "${_tz[@]}"; do t=$(cat "$z" 2>/dev/null||echo 0); [ "$t" -gt "$maxt" ]&&maxt=$t; done
    maxt=$((maxt/1000))
  fi
  echo "$maxt $load $nproc $disk $mem $up"
'

summary=""
for entry in $NODES; do
  addr="${entry#*=}"; label="$(resolve_label "$entry")"   # local → this host's own name, not the map key
  if [ "$addr" = "local" ]; then
    read -r maxt load np disk mem up < <(bash -c "$PROBE" 2>/dev/null)
  else
    read -r maxt load np disk mem up < <(timeout 12 ssh -o BatchMode=yes -o ConnectTimeout=6 -o StrictHostKeyChecking=no "$addr" "$PROBE" 2>/dev/null)
  fi
  # Read the prior COMMITTED verdict FIRST — it is the Schmitt-trigger memory the classifier needs
  # (hysteresis exit line depends on the state currently being emitted).
  sf="$STATEDIR/$label.state"; committed=$(cat "$sf" 2>/dev/null||echo "")
  # LOCAL entry only: read this host's cooling actuation so the classifier can distinguish a real
  # dead-cooler (SATURATED) from hot-ambient load-heat while the cooler works (ACTIVE/IDLE). Remote
  # entries pass empty → classify keeps the pure hot-at-low-load heuristic (they'd read their own /sys).
  cool_state=""
  [ "$addr" = local ] && cool_state="$(mesh-cooling-load 2>/dev/null | awk 'NR==1{print $2}')"
  verdict=$(classify "${maxt:-}" "${load:-}" "${np:-}" "${disk:-}" "${mem:-}" "$committed" "$cool_state")
  if [ "$verdict" = UNREACHABLE ]; then detail="no SSH/probe"; else
    detail="temp=${maxt}$([ "$maxt" = n/a ] || echo C) load=${load} disk=${disk}% mem=${mem}% up=${up}m"
    # outdoor-temp forensics (weather-consumers-phase2): LOCAL entry only — the weather sense's
    # coordinates are wherever THIS reflex runs, never a remote node it merely SSHes into.
    [ "$addr" = local ] && detail="$detail$(outdoor_forensics "$verdict")"
  fi

  # DEBOUNCE: a new state only COMMITS after 2 consecutive identical raw reads — so a single
  # transient (a brief temp spike under media decode, one dropped SSH) never raises a false alarm.
  # Composes with the hysteresis above: hysteresis keeps the raw verdict stable in the band, debounce
  # still guards a genuine two-read transition.
  rawf="$STATEDIR/$label.raw"; prevraw=$(cat "$rawf" 2>/dev/null||echo ""); echo "$verdict" > "$rawf"
  if [ "$verdict" = "$prevraw" ] || [ -z "$committed" ]; then newc="$verdict"; else newc="$committed"; fi
  echo "$newc" > "$sf"
  echo "$(ts) $label raw=$verdict committed=$newc :: $detail" >> "$LOG"
  summary="$summary$label:$newc "

  if [ "$newc" != "$committed" ] && [ -n "$committed" ]; then
    case "$newc" in
      OK)           msg="[node-ok] $label hardware healthy again :: $detail" ;;
      HOT)          msg="[node-hot] $label HOT (load-heat) :: $detail" ;;
      COOLER-FAULT) msg="[node-cooler-fault] $label hot-cpu-at-low-load signature — SUSPECT cooling, but a non-thermal hardware fault can also read hot (ds 2026-06-24 was a broken wifi/bt module, NOT the cooler). Corroborate with the kernel log before concluding :: $detail" ;;
      DISK)         msg="[node-disk] $label disk pressure :: $detail" ;;
      MEM)          msg="[node-mem] $label memory pressure :: $detail" ;;
      UNREACHABLE)  msg="[node-down] $label unreachable :: $detail" ;;
    esac
    command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="node-care@$(hostname)" mesh-chat "$msg" >/dev/null 2>&1
    echo "$(ts) EDGE: $msg" >> "$LOG"

    # RECOVERY CAPTURE: node came back from a freeze/down → grab last-boot kernel logs + temps so a
    # crash/kernel-panic/overheat cause is caught even unattended (the ds-2026-06-17 freeze case).
    if [ "$committed" = UNREACHABLE ] && [ "$addr" != local ]; then
      rec="$STATEDIR/$label.recovery.log"
      { echo "==== $(ts) $label recovered ($committed -> $newc) ===="
        timeout 14 ssh -o BatchMode=yes -o ConnectTimeout=6 -o StrictHostKeyChecking=no "$addr" \
          'echo "-- uptime --"; uptime; echo "-- prev-boot errors --"; journalctl -b -1 -p err --no-pager 2>/dev/null | tail -40; echo "-- dmesg device/bus/thermal errors --"; dmesg 2>/dev/null | grep -iE "thermal|throttl|panic|oops|hardware error|mce|firmware|iwlwifi|bluetooth|btusb| hci|pcieport|pci.*aer| aer |xhci|usb [0-9].*(reset|error|disconnect)|ath[0-9]k|rtw|brcm|i915.*(hang|reset)|watchdog" | tail -40; echo "-- dmesg full tail (do NOT pre-filter: a narrow thermal grep hid the ds wifi/bt-module fault, 2026-06-24) --"; dmesg 2>/dev/null | tail -80' 2>/dev/null
      } >> "$rec"
      command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="node-care@$(hostname)" \
        mesh-chat "[node-recovered] $label back after freeze — kernel logs captured to $rec (steward: diagnose)" >/dev/null 2>&1
    fi
  fi
done

echo "$(ts) fleet: $summary"
