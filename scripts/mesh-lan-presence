#!/usr/bin/env bash
# mesh-lan-presence — the mesh's NETWORK-presence sense, via the always-on router.
#
# The router (GL-MT3000) sees every device on the LAN — DHCP leases + the live ARP table.
# This is a Tailscale-INDEPENDENT view of "who/what is physically on the network right now",
# complementing BLE presence and, crucially, detecting a peer NODE returning to the LAN before
# (or without) Tailscale — useful as a fast, overlay-independent change-trigger.
#
#   mesh-lan-presence            table: host | ip | mac | state(ACTIVE/stale) | mesh-node?
#   mesh-lan-presence --nodes    only known mesh nodes, ACTIVE ones first (for change-detection)
#   mesh-lan-presence --test     smoke test (router reachable + parse works)
#
# ACTIVE = present in the router's ARP table (REACHABLE/STALE/DELAY/PROBE = answered ARP recently).
# A DHCP lease alone is NOT presence (leases persist ~12h after a device leaves) — ARP is the truth.
# OFF-SUBNET HONESTY (2026-09-03, task mesh-lan-presences): our own ARP cache is a view of a
# segment only while one of our live addresses sits inside it. From one L3 hop off the LAN the
# fallback asserts that premise: with no local address in the reported segment it renders UNKNOWN
# (never an empty roster — empty is a positive ABSENT claim), after one parallel ICMP sweep of
# the known IPs, which crosses the hop ARP cannot. A responder renders PRESENT (L3 view).
set -uo pipefail
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes"
ROUTER="${MESH_ROUTER:-$(mesh-peer-addr router 2>/dev/null || mesh-peer-addr GL-MT3000 2>/dev/null)}"; RUSER="${MESH_ROUTER_USER:-root}"
SSH=(ssh -o ConnectTimeout=6 -o StrictHostKeyChecking=accept-new -o BatchMode=yes)
# live = reachable, not tailscale-only: if the router's overlay IP is down but it still answers on LAN,
# fall back to node-local candidates (MESH_LAN_FALLBACK="router:ip GL-MT3000:ip ..."), same contract as mesh-health.
lan_fallback_ip(){
  local host="$1" entry
  for entry in ${MESH_LAN_FALLBACK:-}; do
    [ "${entry%%:*}" = "$host" ] || continue
    printf '%s\n' "${entry#*:}"
  done
}
_router_cmd(){
  if "${SSH[@]}" "$RUSER@$ROUTER" "$@" 2>/dev/null; then return 0; fi
  local ip
  for ip in $(lan_fallback_ip router) $(lan_fallback_ip GL-MT3000); do
    [ -n "$ip" ] || continue
    if "${SSH[@]}" "$RUSER@$ip" "$@" 2>/dev/null; then ROUTER="$ip"; return 0; fi
  done
  return 1
}
# router-INDEPENDENT fallback: when the router is off-tailnet AND its LAN SSH rejects our key
# (so its DHCP+ARP view is unreadable), the LOCAL node's own neighbour table is still a genuine,
# Tailscale-independent LAN-presence read — it sees every peer this node has talked to. We can't
# recover DHCP hostnames without the router, so name only the KNOWN mesh nodes by their LAN IP
# (from MESH_LAN_FALLBACK / PHONE_LAN_IPS / MESH_NODES) and leave the rest as "?". This still
# answers the --nodes question: "is a peer NODE on the LAN right now?"
_node_lan_map(){
  local entry ip
  for entry in ${MESH_LAN_FALLBACK:-}; do printf '%s %s\n' "${entry#*:}" "${entry%%:*}"; done
  for ip in ${PHONE_LAN_IPS:-}; do printf '%s %s\n' "$ip" "Redmi"; done
  for entry in ${MESH_NODES:-}; do
    case "$entry" in *@192.168.*) printf '%s %s\n' "${entry##*@}" "${entry%%:*}";; esac
  done
  for entry in ${MESH_LAN_DEVICES:-}; do
    case "$entry" in *:*) printf '%s %s\n' "${entry#*:}" "${entry%%:*}";; esac
  done
}
# The subnet(s) this fallback claims to report on: /24s of every known LAN IP.
_known_lan_subnets(){
  _node_lan_map | awk '{print $1}' | cut -d. -f1-3 | grep -E '^[0-9]+\.[0-9]+\.[0-9]+$' | sort -u | sed 's/$/.0\/24/'
}
# Premise assert for the ARP fallback (task mesh-lan-presences, 2026-08-30): our own ARP cache is
# a view of a segment ONLY while one of our live addresses sits inside it. ARP never crosses an
# L3 hop, so from off-subnet `ip neigh | grep 192.168.8.` is ZERO by construction — an empty
# table there is instrument blindness, not absence. _off_subnet returns 0 (blind) when NONE of
# our live CIDRs contains ANY known LAN IP; 1 when we share a segment and ARP can see.
# MESH_LAN_PRESENCE_ADDRS overrides the local read (space-separated CIDRs, for --test fixtures);
# MESH_LAN_PRESENCE_KNOWN overrides the known-IP list (space-separated IPs, for --test fixtures).
_off_subnet(){
  local cidrs known
  if [ -n "${MESH_LAN_PRESENCE_ADDRS:-}" ]; then cidrs="${MESH_LAN_PRESENCE_ADDRS:-}"
  else cidrs="$(ip -o -4 addr show 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="inet") print $(i+1)}')"
  fi
  if [ -n "${MESH_LAN_PRESENCE_KNOWN:-}" ]; then known="${MESH_LAN_PRESENCE_KNOWN:-}"
  else known="$(_node_lan_map | awk '{print $1}' | sort -u)"
  fi
  [ -n "$cidrs" ] || return 0
  [ -n "$known" ] || return 1
  # shellcheck disable=SC2086
  { for _c in $cidrs; do printf '%s\n' "$_c"; done; } > /tmp/.mlp-cidrs.$$ 2>/dev/null || return 1
  # shellcheck disable=SC2086
  { for _k in $known; do printf '%s\n' "$_k"; done; } > /tmp/.mlp-known.$$ 2>/dev/null || { rm -f /tmp/.mlp-cidrs.$$; return 1; }
  local rc
  CIDRS_FILE="/tmp/.mlp-cidrs.$$" KNOWN_FILE="/tmp/.mlp-known.$$" python3 -c '
import ipaddress, os
try:
    cidrs = [ipaddress.ip_network(l.strip(), strict=False) for l in open(os.environ["CIDRS_FILE"]) if l.strip()]
    known = [ipaddress.ip_address(l.strip()) for l in open(os.environ["KNOWN_FILE"]) if l.strip()]
except Exception:
    raise SystemExit(0)
for k in known:
    for c in cidrs:
        if k in c:
            raise SystemExit(1)
raise SystemExit(0)
' >/dev/null 2>&1
  rc=$?
  rm -f /tmp/.mlp-cidrs.$$ /tmp/.mlp-known.$$
  return $rc
}
# ICMP leg: works across the L3 hop where ARP cannot (tether/phone-forwarded LAN). One fast
# ping per known IP; prints "ip host" per responder. Pings run in PARALLEL under one bound so
# seven dead hosts cost ~1s, not ~7s sequential timeouts. Callers render these PRESENT.
_icmp_probe(){
  local map ip host out tmp
  map="$(_node_lan_map | sort -u)"
  tmp="$(mktemp -d)"
  # Each ping self-bounds (-W1 per-packet, -w2 overall deadline); the single `wait` below can
  # therefore only cost ~2s, not N sequential timeouts.
  if [ -n "${MESH_LAN_PRESENCE_KNOWN:-}" ]; then
    # shellcheck disable=SC2086
    for ip in ${MESH_LAN_PRESENCE_KNOWN:-}; do
      host="$(printf '%s\n' "$map" | awk -v ip="$ip" '$1==ip{print $2; exit}')"
      # shellcheck disable=SC2016
      { ping -c1 -W1 -w2 -n "$ip" >/dev/null 2>&1 && printf '%s %s\n' "$ip" "${host:-?}" > "$tmp/$ip"; } &
    done
  else
    for ip in $(printf '%s\n' "$map" | awk '{print $1}' | sort -u); do
      host="$(printf '%s\n' "$map" | awk -v ip="$ip" '$1==ip{print $2; exit}')"
      # shellcheck disable=SC2016
      { ping -c1 -W1 -w2 -n "$ip" >/dev/null 2>&1 && printf '%s %s\n' "$ip" "${host:-?}" > "$tmp/$ip"; } &
    done
  fi
  wait 2>/dev/null
  out="$(cat "$tmp"/* 2>/dev/null)"
  rm -rf "$tmp"
  [ -n "$out" ] && printf '%s\n' "$out"
}
_local_lan_raw(){
  local neigh map; neigh="$(ip neigh 2>/dev/null)" || return 1
  [ -n "$neigh" ] || return 1
  map="$(_node_lan_map | sort -u)"
  echo "===LEASES==="
  printf '%s\n' "$neigh" | awk '$1 ~ /^[0-9]+\./ && /lladdr/{print $1, $5}' | while read -r ip mac; do
    [ -n "$mac" ] || continue
    host="$(printf '%s\n' "$map" | awk -v ip="$ip" '$1==ip{print $2; exit}')"
    printf '0 %s %s %s\n' "$mac" "$ip" "${host:-?}"
  done
  echo "===ARP==="
  printf '%s\n' "$neigh"
}
# known mesh nodes by MAC-agnostic hostname substring (for the mesh-node? column)
is_node(){ case "$1" in *IdeaPad*|*efault-string*|ilya|*Redmi*|*MT3000*|*robot*|*rk3308*) return 0;; *) return 1;; esac; }

if [ "${1:-}" = --test ]; then
  # Premise arms FIRST (pure, no network): the ARP fallback is blind off-subnet, so a fixture
  # whose only addresses sit outside the reported segment must read BLIND, and the on-subnet
  # control must read CAN-SEE. These run even where the router is unreachable (exit 2 below).
  MESH_LAN_PRESENCE_ADDRS="100.76.233.148/16 172.17.0.1/16 100.81.222.19/32" \
  MESH_LAN_PRESENCE_KNOWN="192.168.8.1 192.168.8.214" \
    _off_subnet || { echo "smoke-test: FAIL (off-subnet fixture did not read blind — the empty-table bug is back)"; exit 1; }
  MESH_LAN_PRESENCE_ADDRS="192.168.8.50/24 172.17.0.1/16" \
  MESH_LAN_PRESENCE_KNOWN="192.168.8.1 192.168.8.214" \
    _off_subnet && { echo "smoke-test: FAIL (on-subnet control read blind — the fallback would go UNKNOWN on its own LAN)"; exit 1; }
  # LAN presence is a TOPOLOGY capability: it reads the router's lease/ARP table, so it only exists
  # on a node that can reach the router. A node that can't (e.g. a remote VPS) doesn't HAVE this
  # capability — that's n/a (exit 2), not breakage. exit 1 is reserved for router-reachable-but-broken.
  [ -n "$ROUTER" ] || { echo "smoke-test: n/a (no router configured for this node)"; exit 2; }
  _router_cmd true \
    || { echo "smoke-test: n/a (router $ROUTER unreachable from this node — needs LAN/mesh access to the router)"; exit 2; }
  _router_cmd 'cat /tmp/dhcp.leases >/dev/null 2>&1 && ip neigh >/dev/null 2>&1' \
    && { echo "smoke-test: ok"; exit 0; } || { echo "smoke-test: FAIL (router reachable but no leases/arp)"; exit 1; }
fi

# pull leases + ARP from the router in one round-trip; if the router can't be reached AT ALL
# (off-tailnet + LAN SSH refuses our key), fall back to this node's own neighbour table so
# --nodes still reports live=reachable peers instead of a hard "unreachable" error.
_fallback_offsubnet_unknown(){
  # Premise: ARP never crosses an L3 hop. With no live address inside the reported segment(s)
  # our own neigh table cannot see that segment at all — render UNKNOWN, never an empty roster
  # (an empty table is a positive ABSENT claim). An ICMP leg runs first: ping crosses the hop
  # ARP cannot, so a host that answers is genuinely PRESENT even while ARP-blind.
  local subnets icmp ip host node
  subnets="$(_known_lan_subnets | tr '\n' ' ')"
  [ -n "$subnets" ] || subnets="unknown-segment"
  icmp="$(_icmp_probe)"
  if [ -n "$icmp" ]; then
    echo "mesh-lan-presence: router unreachable — ARP-blind here (no local address in ${subnets}); showing ICMP-reachable known hosts (L3 view, no DHCP hostnames)" >&2
    printf '%-26s %-15s %-18s %-8s %s\n' HOST IP MAC STATE MESH-NODE
    printf '%s\n' "$icmp" | while read -r ip host; do
      [ -n "$ip" ] || continue
      node=""; is_node "${host:-?}" && node=node
      case "${1:-}" in --nodes) [ -n "$node" ] || continue ;; esac
      printf '%-26s %-15s %-18s %-8s %s\n' "${host:-?}" "$ip" "?" "PRESENT" "$node"
    done | { [ "${1:-}" = --nodes ] && sort -k4 -r || cat; }
    return 0
  fi
  echo "mesh-lan-presence: router unreachable — UNKNOWN (no local address in ${subnets}; ARP cannot see that segment from here, and no known host answered ICMP)" >&2
  printf '%-26s %-15s %-18s %-8s %s\n' HOST IP MAC STATE MESH-NODE
  printf '%-26s %-15s %-18s %-8s %s\n' "?" "${subnets%% *}" "?" "UNKNOWN" ""
  return 1
}
raw="$(_router_cmd 'echo "===LEASES==="; cat /tmp/dhcp.leases 2>/dev/null; echo "===ARP==="; ip neigh 2>/dev/null')" \
  || { if _off_subnet; then _fallback_offsubnet_unknown "${1:-}"; exit $?; fi
       raw="$(_local_lan_raw)" && echo "mesh-lan-presence: router unreachable — local ARP fallback (known nodes only, no DHCP hostnames)" >&2; } \
  || { echo "mesh-lan-presence: router $ROUTER unreachable and local ARP empty" >&2; exit 1; }

# PRESENT MACs = ARP state genuinely confirms reachability NOW (REACHABLE/DELAY/PROBE).
# STALE = entry exists but unconfirmed (device may have left — residual); not presence.
present_macs="$(printf '%s\n' "$raw" | awk '/===ARP===/{a=1;next} a && /lladdr/ && /REACHABLE|DELAY|PROBE/{print tolower($5)}')"
stale_macs="$(printf '%s\n' "$raw" | awk '/===ARP===/{a=1;next} a && /lladdr/ && /STALE/{print tolower($5)}')"

printf '%-26s %-15s %-18s %-8s %s\n' HOST IP MAC STATE MESH-NODE
printf '%s\n' "$raw" | awk '/===LEASES===/{l=1;next} /===ARP===/{l=0} l && NF>=4{print $2, $3, $4}' \
| while read -r mac ip host; do
    [ -z "$mac" ] && continue
    node=""; is_node "$host" && node=node
    case "${1:-}" in --nodes) [ -n "$node" ] || continue ;; esac
    state=gone
    printf '%s\n' "$stale_macs"   | grep -qiF "$mac" && state=stale
    printf '%s\n' "$present_macs" | grep -qiF "$mac" && state=PRESENT
    printf '%-26s %-15s %-18s %-8s %s\n' "${host:-?}" "$ip" "$mac" "$state" "$node"
  done | { [ "${1:-}" = --nodes ] && sort -k4 -r || cat; }
