#!/usr/bin/env python3
"""mesh-witness — the mesh measuring itself: a continuous ledger of its own vital signs.

Operator 2026-07-06: "окно witness — меш, который меряет сам себя. Не отчёт разово, а
постоянная лента измерений." Not a one-off report — an INSTRUMENT. Every tick the mesh writes
ONE timestamped row of its own scalars to an append-only ledger (~/.mesh/witness.log); the
witness top pane tails that growing tape so you read the mesh's self-measurement as a TIME
SERIES, not a snapshot.

Provenance, not narration (operator's epistemics): every metric is read from an artifact the
mesh ALREADY produced (sense-map cache, mind-state, reflex-health state, the board log, the
sensorium cache, the spend log). witness does not re-probe or re-interpret — it FUSES those
already-imprinted measurements into one honest tape whose generative algorithm is this file,
transparent and independent of any reader. A source that is missing/unreadable renders UNKNOWN
for that metric — never a faked reading (honest-fusion rule).

Cost discipline: ALL the (moderately) expensive reads live in --measure, which a reflex runs on
a cadence. The pane render (--pane / no-arg) only tails the ledger — a pure file read — so the
data pane refreshes cheaply every frame while the measurement itself is throttled to the cron.

Usage:  mesh-witness            # render the ledger pane (cheap: tails witness.log)
        mesh-witness --pane     # same (explicit; the dash mode)
        mesh-witness --measure  # compute one row + append to the ledger (the reflex mode)
        mesh-witness --json      # latest measurement as JSON
        mesh-witness --test      # smoke test

# reflex-cadence: */2 * * * *
# reflex-args: --measure
"""
import json, os, re, subprocess, sys, time
from datetime import datetime, timezone, timedelta

LEDGER = os.path.expanduser("~/.mesh/witness.log")
MESHDIR = os.path.expanduser("~/.mesh")

# cron runs with a stripped PATH that omits ~/.local/bin — without this the subprocess metrics
# (mesh-mind-state / mesh-sensorium and anything THEY shell out to) silently fail → UNKNOWN every
# tick while the pure file-read metrics look fine. Prepend the tool dir so the whole tract resolves.
os.environ["PATH"] = os.path.expanduser("~/.local/bin") + ":" + os.environ.get("PATH", "/usr/bin:/bin")
KEEP_ROWS = 5000          # bound the tape (trim oldest on write)
TAIL_ROWS = 12            # raw rows shown on the pane
SPARK_ROWS = 24           # rows folded into each sparkline
SPARK = "▁▂▃▄▅▆▇█"

# The metric SET the witness measures — (key, human label). Order = ledger + pane order.
METRICS = [
    ("nodes",       "nodes reached"),
    ("minds_live",  "minds live"),
    ("minds_work",  "minds working"),
    ("reflex",      "reflex-health"),
    ("board1h",     "board lines/1h"),
    ("board_age_s", "board pulse (s)"),
    ("senses",      "senses fresh"),
    ("spend1h",     "paid turns/1h"),
]

# Auxiliary fields captured at measure time and stored in the ledger, but NOT trended
# (no sparkline/arrow) — they carry the distribution a scalar metric collapses. Kept out
# of METRICS so the trend tract stays a clean scalar series.
AUX_FIELDS = ("senses_dist",)


# ---- measurement: each reads an already-produced artifact; UNKNOWN on any failure ----

def _read(path):
    try:
        with open(os.path.join(MESHDIR, path)) as f:
            return f.read()
    except OSError:
        return None


def _parse_node_states(txt):
    """Parse the DEVICES section of sense-map.txt -> list of status strings.

    The status is a closed set {online, unreach, offline} appearing as a whole word,
    so we anchor on IT rather than on column gaps. This is immune to two real
    inconsistencies in the cache: (a) hostnames may contain single internal spaces
    ('Redmi 10' was silently dropped by the old \\S+ host regex); (b) the column gap
    between host and status is NOT uniform — most rows use 2+ spaces but at least one
    ('imozerov-IdeaPad-3-15IIL05 online') uses a single space, which breaks a
    split-on-2+-spaces parse. Only the indented rows under '-- DEVICES:' are counted;
    the ACTIVE/PASSIVE cross-check sections have different shapes and must not inflate
    the device count."""
    section = []
    in_dev = False
    for ln in txt.splitlines():
        if re.match(r"--\s*DEVICES", ln):
            in_dev = True
            continue
        if in_dev and re.match(r"--\s", ln):  # next section header ends the block
            break
        if in_dev:
            section.append(ln)
    status_re = re.compile(r"(?:^|\s)(online|unreach|offline)(?=\s|$)")
    states = []
    for ln in section:
        if not ln.startswith((" ", "\t")):
            continue
        m = status_re.search(ln)
        if m:
            states.append(m.group(1))
    return states


def m_nodes():
    """reached/total from the sense-map cache (already harvested by its own reflex)."""
    txt = _read("sense-map.txt")
    if not txt:
        return "UNKNOWN"
    states = _parse_node_states(txt)
    if not states:
        return "UNKNOWN"
    return f"{sum(1 for s in states if s == 'online')}/{len(states)}"


def _mind_stats():
    try:
        out = subprocess.run(["mesh-mind-state", "--stats"], capture_output=True,
                             text=True, timeout=15).stdout
        return out.splitlines()
    except Exception:
        return None


def m_minds():
    """live (not DEAD) / working, from mesh-mind-state (local tmux read)."""
    lines = _mind_stats()
    if lines is None:
        return "UNKNOWN", "UNKNOWN"
    live = work = 0
    for ln in lines:
        if ln.startswith("WINDOW") or not ln.strip():
            continue
        cols = re.split(r"\s{2,}|\t", ln.strip())
        if len(cols) < 2:
            continue
        win, state = cols[0].strip(), cols[1].strip().upper()
        if win in ("bash", "WINDOW"):
            continue
        if state in ("IDLE", "WORKING"):
            live += 1
        if state == "WORKING":
            work += 1
    return str(live), str(work)


def m_reflex():
    """the reflex-health verdict token the reflex-health reflex already wrote (OK/WARN/...)."""
    txt = _read(".reflex-health-state")
    if txt is None:
        return "UNKNOWN"
    return (txt.strip().split() or ["UNKNOWN"])[0][:6] or "UNKNOWN"


def _board_lines():
    try:
        with open(os.path.join(MESHDIR, "chat.log")) as f:
            return f.readlines()
    except OSError:
        return None


def m_board():
    """board throughput last 1h + seconds since the last board line (the coordination pulse)."""
    lines = _board_lines()
    if not lines:
        return "UNKNOWN", "UNKNOWN"
    now = datetime.now(timezone.utc)
    cut = now - timedelta(hours=1)
    n = 0
    last = None
    for ln in lines:
        m = re.match(r"(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d)", ln)
        if not m:
            continue
        t = datetime.fromisoformat(m.group(1)).replace(tzinfo=timezone.utc)
        last = t
        if t > cut:
            n += 1
    age = int((now - last).total_seconds()) if last else "UNKNOWN"
    return str(n), str(age)


def _parse_sense_tags(out):
    """Extract freshness tags from mesh-sensorium --cached output -> list (order preserved).

    A freshness tag is a parenthesized SINGLE status word: fresh/recent/aging/stale/UNKNOWN.
    The cached dump ALSO contains non-tag parens — the header '(CACHED state — the mind runs
    the live probes)', '(mind probes, no cache)' on the LIVE-ONLY line, and numeric '(40)' —
    so a naive '\\(([^)]+)\\)' over-counts (21 vs the true 18) and is an ACTIVE lie, not a fix.

    We match '\\(([a-z]+|UNKNOWN)\\)': the token must be a single all-lowercase word (or the
    literal UNKNOWN) immediately closed by ')'. This rejects multi-token prose and digits,
    admits a future single-word tag class (e.g. 'dead') without silently dropping it, and
    yields the correct 18 against today's cache. (A future MULTI-word tag would still be
    missed — the format contract is single-word; if sensorium changes that, this revisits.)"""
    return re.findall(r"\(([a-z]+|UNKNOWN)\)", out)


def m_senses():
    """fresh/total + the full freshness distribution, from the sensorium cache.

    'total' counts every parenthesized tag (robust to new tag names). The distribution
    string (e.g. '2f/9r/6a/0s/1u') exposes what the single fresh/total fraction collapses:
    a pane reading '2/18' looks alarming, but if those 18 are mostly 'recent' the senses
    are healthy — the fraction alone can't tell you, the distribution can. Returns
    (scalar, dist); either is 'UNKNOWN' on failure."""
    try:
        out = subprocess.run(["mesh-sensorium", "--cached"], capture_output=True,
                             text=True, timeout=15).stdout
    except Exception:
        return "UNKNOWN", "UNKNOWN"
    tags = _parse_sense_tags(out)
    if not tags:
        return "UNKNOWN", "UNKNOWN"
    f = tags.count("fresh"); r = tags.count("recent"); a = tags.count("aging")
    s = tags.count("stale"); u = tags.count("UNKNOWN")
    other = len(tags) - (f + r + a + s + u)  # any future tag class lands here, not silently dropped
    dist = f"{f}f/{r}r/{a}a/{s}s/{u}u" + (f"/{other}o" if other else "")
    return f"{f}/{len(tags)}", dist


def m_spend():
    """paid turns in the last 1h from the spend event log (the mesh's metabolic rate)."""
    txt = _read("spend.log")
    if txt is None:
        return "UNKNOWN"
    cut = datetime.now(timezone.utc) - timedelta(hours=1)
    n = 0
    for ln in txt.splitlines():
        m = re.match(r"(\d{4}-\d\d-\d\dT\d\d:\d\d)Z", ln)
        if m and datetime.fromisoformat(m.group(1)).replace(tzinfo=timezone.utc) > cut:
            n += 1
    return str(n)


def measure():
    """Compute the full metric row. Each field is a scalar or 'x/y' string, or UNKNOWN."""
    minds_live, minds_work = m_minds()
    board1h, board_age = m_board()
    senses, senses_dist = m_senses()
    return {
        "ts": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "nodes": m_nodes(),
        "minds_live": minds_live,
        "minds_work": minds_work,
        "reflex": m_reflex(),
        "board1h": board1h,
        "board_age_s": board_age,
        "senses": senses,
        "senses_dist": senses_dist,
        "spend1h": m_spend(),
    }


def _row_str(row):
    parts = [row["ts"]] + [f"{k}={row.get(k, 'UNKNOWN')}" for k, _ in METRICS]
    # append aux fields (distributions) AFTER the trended scalars, when present
    parts += [f"{k}={row[k]}" for k in AUX_FIELDS if row.get(k) is not None]
    return " ".join(parts)


def do_measure():
    row = measure()
    line = _row_str(row) + "\n"
    # append, then trim the tape to KEEP_ROWS (bounded but continuous)
    try:
        with open(LEDGER, "a") as f:
            f.write(line)
        with open(LEDGER) as f:
            rows = f.readlines()
        if len(rows) > KEEP_ROWS:
            with open(LEDGER, "w") as f:
                f.writelines(rows[-KEEP_ROWS:])
    except OSError as e:
        print(f"mesh-witness: FAIL to write ledger: {e}", file=sys.stderr)
        sys.exit(1)
    print(line, end="")


# ---- pane render: tails the ledger only (cheap) ----

def _parse_row(line):
    out = {}
    toks = line.split()
    if not toks:
        return out
    out["ts"] = toks[0]
    for t in toks[1:]:
        if "=" in t:
            k, v = t.split("=", 1)
            out[k] = v
    return out


def _num(v):
    """numeric lead of a metric value: '6/7'->6, '32'->32, 'OK'/'UNKNOWN'->None."""
    if v is None:
        return None
    m = re.match(r"-?\d+", str(v))
    return int(m.group(0)) if m else None


def _spark(series):
    vals = [v for v in series if v is not None]
    if len(vals) < 2:
        return ""
    lo, hi = min(vals), max(vals)
    if hi == lo:
        return SPARK[0] * len(series)
    out = []
    for v in series:
        if v is None:
            out.append(" ")
        else:
            out.append(SPARK[min(len(SPARK) - 1, int((v - lo) / (hi - lo) * (len(SPARK) - 1)))])
    return "".join(out)


def _arrow(cur, prev):
    a, b = _num(cur), _num(prev)
    if a is None or b is None:
        return " "
    return "↑" if a > b else ("↓" if a < b else "→")


def render_pane():
    lines = ["== witness: the mesh measuring itself — self-measurement ledger =="]
    lines.append(datetime.now().strftime("%a %b %e %I:%M:%S %p %Z %Y"))
    lines.append("")
    try:
        with open(LEDGER) as f:
            rows = [_parse_row(l) for l in f if l.strip()]
    except OSError:
        rows = []
    if not rows:
        lines.append("  (no measurements yet — the reflex runs `mesh-witness --measure` every 2m)")
        lines.append("  bootstrap now:  mesh-witness --measure")
        lines.append("")
        lines.append("-- pane live: %s · this line ticks every frame — frozen = dead render loop --"
                     % datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"))
        return "\n".join(lines)

    latest = rows[-1]
    prev = rows[-2] if len(rows) > 1 else {}
    window = rows[-SPARK_ROWS:]

    # latest reading, each metric with a trend arrow vs the prior row + its sparkline
    lines.append("-- latest measurement (%s) — arrow vs prior row · sparkline over last %d --"
                 % (latest.get("ts", "?"), len(window)))
    for key, label in METRICS:
        cur = latest.get(key, "UNKNOWN")
        arr = _arrow(cur, prev.get(key)) if prev else " "
        spark = _spark([_num(r.get(key)) for r in window])
        line = f"  {label:<16} {cur:<10} {arr}  {spark}"
        # show the freshness distribution inline so '2/18' reads truthfully (mostly recent?)
        if key == "senses":
            dist = latest.get("senses_dist")
            if dist and dist != "UNKNOWN":
                line += f"   [{dist}]"
        lines.append(line)
    # a first-order self-reading: how fresh is the tape itself (witness watching witness)
    try:
        age = int(time.time() - os.path.getmtime(LEDGER))
        lines.append(f"  {'measure age (s)':<16} {age:<10} {'→':<1}  (last row written {age}s ago)")
    except OSError:
        pass
    lines.append("")

    # the raw growing tape — the continuous ledger the operator asked for
    lines.append(f"-- ledger tail (last {min(TAIL_ROWS, len(rows))} of {len(rows)} rows) — {LEDGER} --")
    for r in rows[-TAIL_ROWS:]:
        compact = " ".join(f"{k}={r.get(k)}" for k, _ in METRICS)
        lines.append(f"  {r.get('ts', '?')}  {compact}")
    lines.append("")
    lines.append("-- pane live: %s · this line ticks every frame — frozen = dead render loop --"
                 % datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"))
    return "\n".join(lines)


def _test_node_parse():
    """Fixture-test the device-row parser. Covers TWO real regressions in the cache's
    shape: (a) space-in-hostname ('Redmi 10' was dropped by the old \\S+ regex); (b)
    non-uniform column gap — row 3 uses a SINGLE space between host and status
    ('imozerov-IdeaPad-3-15IIL05 online'), which breaks a split-on-2+-spaces parse.
    Also asserts the section boundary: ACTIVE/PASSIVE cross-check rows must not count."""
    fixture = """-- DEVICES: senses + actuators (harvest from ALL — sensors AND ways to act) --
  ilya                       online   mic | act: speaker
  imozerov-Default-string    online   ble wifi cam mic | act: speaker voice
  imozerov-IdeaPad-3-15IIL05 online   ble wifi cam mic | act: speaker voice
  mac                        online   wifi cam mic | act: voice speaker
  Redmi 10                   offline  ?
  note3                      unreach  ble wifi
  GL-MT3000                  offline  ?
-- ACTIVE cross-checks (actuator on one node -> sensor on another: validate + derive) --
  audio  emit[a, b] -> hear[a, b] — emit a tone -> hear it
-- PASSIVE cross-checks (same sense on >=2 nodes -> multi-vantage) --
  ble   x2 (a, b) — proximity cross-check
"""
    states = _parse_node_states(fixture)
    # 7 devices total: ilya, imozerov-Default-string, imozerov-IdeaPad-3-15IIL05, mac
    # (all online); Redmi 10 (offline), note3 (unreach), GL-MT3000 (offline).
    # Cross-check rows must NOT count.
    if len(states) != 7:
        print(f"smoke-test: FAIL (node parse counted {len(states)} devices, expected 7; "
              f"states={states})"); sys.exit(1)
    if states.count("online") != 4:
        print(f"smoke-test: FAIL (node parse online={states.count('online')}, expected 4; "
              f"states={states})"); sys.exit(1)
    # regression (a): 'Redmi 10' (space in hostname) must be counted, not dropped.
    # regression (b): the single-space 'imozerov-IdeaPad-3-15IIL05 online' row must be
    # counted as online. Both manifest as len(states)==7; the old parsers gave 5 or 6.
    # empty / non-DEVICES text -> empty list (caller renders UNKNOWN)
    if _parse_node_states("") != []:
        print("smoke-test: FAIL (empty parse did not return [])"); sys.exit(1)
    if _parse_node_states("-- SOME OTHER SECTION --\n  foo  online  x\n") != []:
        print("smoke-test: FAIL (non-DEVICES section was parsed)"); sys.exit(1)


def _test_sense_parse():
    """Fixture-test the freshness-tag parser. Guards the latent-denominator lie: a hardcoded
    tag set would silently drop a future tag class (e.g. 'dead') and understate total. The
    robust match-any-parens parse must count it. Also checks distribution arithmetic."""
    fixture = """=== mesh sensorium (CACHED state) @ 2026-07-06T23:23:38Z ===
BODY       motion=OFFLINE (recent) · power=OFFLINE (aging) · prox=UNREACHABLE (recent)
ROOM       room=PRESENT (fresh) · tempo=RESTING (aging) · audio=IDLE (recent) · ctx=SOLO (fresh)
NODE       hw=OK (recent) · organ=DEAD (dead)
"""
    tags = _parse_sense_tags(fixture)
    # 9 tags total: BODY=3 (recent,aging,recent) ROOM=4 (fresh,aging,recent,fresh) NODE=2 (recent,dead).
    if len(tags) != 9:
        print(f"smoke-test: FAIL (sense parse counted {len(tags)} tags, expected 9; tags={tags})")
        sys.exit(1)
    # the latent lie: 'dead' must be in the denominator. A closed-set regex would give 8.
    if "dead" not in tags:
        print("smoke-test: FAIL (exotic 'dead' tag was silently dropped from denominator)")
        sys.exit(1)
    # also asserts the header '(CACHED state ...)' and any numeric '(40)' parens are NOT
    # counted (the any-parens regression that over-counted to 21 against the live cache).
    if any(" " in t or any(c.isdigit() for c in t) for t in tags):
        print(f"smoke-test: FAIL (non-tag prose/digit parens leaked into tags: {tags})")
        sys.exit(1)
    # distribution arithmetic: f=2 r=4 a=2 s=0 u=0 other=1(dead)
    f = tags.count("fresh"); r = tags.count("recent"); a = tags.count("aging")
    s = tags.count("stale"); u = tags.count("UNKNOWN")
    other = len(tags) - (f + r + a + s + u)
    if (f, r, a, s, u, other) != (2, 4, 2, 0, 0, 1):
        print(f"smoke-test: FAIL (sense distribution wrong: f={f} r={r} a={a} s={s} u={u} o={other})")
        sys.exit(1)
    if _parse_sense_tags("") != []:
        print("smoke-test: FAIL (empty sense parse did not return [])"); sys.exit(1)


def smoke_test():
    import tempfile
    global LEDGER
    _test_node_parse()
    _test_sense_parse()
    # measurement must produce every declared key (UNKNOWN allowed, absence not)
    row = measure()
    for key, _ in METRICS:
        if key not in row:
            print(f"smoke-test: FAIL (measure missing metric {key})"); sys.exit(1)
    if not re.match(r"\d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ", row["ts"]):
        print(f"smoke-test: FAIL (bad ts {row['ts']})"); sys.exit(1)
    # append/trim/render round-trip on a sandboxed ledger (no touching the real tape)
    with tempfile.NamedTemporaryFile("w", prefix="witness-test-", delete=False) as tf:
        tmp = tf.name
    LEDGER = tmp
    try:
        do_measure()
        do_measure()
        with open(tmp) as f:
            got = [l for l in f if l.strip()]
        if len(got) != 2:
            print(f"smoke-test: FAIL (expected 2 ledger rows, got {len(got)})"); sys.exit(1)
        pane = render_pane()
        if "self-measurement ledger" not in pane or "ledger tail" not in pane:
            print("smoke-test: FAIL (pane render missing sections)"); sys.exit(1)
        # sparkline/arrow helpers must not choke on UNKNOWN/mixed values
        if _num("6/7") != 6 or _num("OK") is not None or _arrow("5", "3") != "↑":
            print("smoke-test: FAIL (num/arrow helpers)"); sys.exit(1)
    finally:
        try: os.unlink(tmp)
        except OSError: pass
    print("smoke-test: ok"); sys.exit(0)


def main():
    args = sys.argv[1:]
    if "--test" in args:
        smoke_test()
    elif "--measure" in args:
        do_measure()
    elif "--json" in args:
        print(json.dumps(measure(), indent=2))
    else:  # default + --pane : cheap render
        print(render_pane())


if __name__ == "__main__":
    main()
