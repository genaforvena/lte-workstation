#!/usr/bin/env python3
"""mesh-witness — the mesh measuring itself: a continuous ledger of its own vital signs.

Operator 2026-07-06: "окно witness — меш, который меряет сам себя. Не отчёт разово, а
постоянная лента измерений." Not a one-off report — an INSTRUMENT. Every tick the mesh writes
ONE timestamped row of its own scalars to an append-only ledger (~/.mesh/witness.log); the
witness top pane tails that growing tape so you read the mesh's self-measurement as a TIME
SERIES, not a snapshot.

Provenance, not narration (operator's epistemics): every metric is read from an artifact the
mesh ALREADY produced (sense-map cache, mind-state, reflex-health state, the board log, the
sensorium cache, the spend log). witness does not re-probe or re-interpret — it FUSES those
already-imprinted measurements into one honest tape whose generative algorithm is this file,
transparent and independent of any reader. A source that is missing/unreadable renders UNKNOWN
for that metric — never a faked reading (honest-fusion rule).

Cost discipline: ALL the (moderately) expensive reads live in --measure, which a reflex runs on
a cadence. The pane render (--pane / no-arg) only tails the ledger — a pure file read — so the
data pane refreshes cheaply every frame while the measurement itself is throttled to the cron.
One deliberate exception (2026-07-24): the labour tree calls `mesh-labor --balance --rolling`
live on every render — measured ~35ms (a pure spend.log tally, no git/hledger subprocess), cheap
enough per-tick, and required for the rolling-5h window's sub-minute freshness a --measure-cadence
cache can't give.

Usage:  mesh-witness            # render the ledger pane (cheap: tails witness.log)
        mesh-witness --pane     # same (explicit; the dash mode)
        mesh-witness --pane --embed   # the TAPE HALF only, for a fused two-half dash: drops the
                                      # local date line + the pane-live footer (the host dash owns
                                      # both — two footers in one pane is two liveness leases, and
                                      # the reader can't tell which one froze). MESH_WITNESS_TAIL
                                      # sets the ledger-tail row count (default 12) so the half
                                      # fits its share of the pane.
        mesh-witness --measure  # compute one row + append to the ledger (the reflex mode)
        mesh-witness --json      # latest measurement as JSON
        mesh-witness --test      # smoke test

# reflex-cadence: */2 * * * *
# reflex-args: --measure
"""
import json, os, re, shutil, subprocess, sys, time
from datetime import datetime, timezone, timedelta

import signal
# SIGTERM MUST UNWIND, or every `finally` in this file is decorative. Python's DEFAULT SIGTERM
# disposition terminates the interpreter WITHOUT running finally blocks (and without
# TemporaryDirectory.__exit__), so a correct-looking cleanup never runs. The signal is not
# hypothetical: GNU `timeout` — which wraps this tool at its call sites and wraps EVERY `--test` in
# mesh-doctor's hourly sweep and in mesh-autowire — puts its child in its OWN process group and
# signals the GROUP, so this process gets the TERM. sys.exit() from the handler raises SystemExit in
# the main thread, which is what actually unwinds. SIGKILL stays uncatchable; that half is
# mesh-tmp-guard's sweep. Pattern and the measured mechanism: eb5b8e7, scripts/mesh-spend.
for _sig in (signal.SIGTERM, signal.SIGHUP):
    signal.signal(_sig, lambda _s, _f: sys.exit(128 + _s))

# MESH_WITNESS_LEDGER exists so --test can drive the REAL CLI over a seeded tape in a subprocess
# instead of poking module globals in-process: TAIL_ROWS binds at import, so an in-process
# os.environ write can never exercise the env wiring it claims to test (export-does-not-rebind-a-
# load-time-global). Production never sets it.
LEDGER = os.environ.get("MESH_WITNESS_LEDGER") or os.path.expanduser("~/.mesh/witness.log")
MESHDIR = os.path.expanduser("~/.mesh")
# test injection only (mirrors MESH_WITNESS_LEDGER above) — production never sets this, always
# resolves the real mesh-labor off PATH.
LABOR_BIN = os.environ.get("MESH_LABOR_BIN") or "mesh-labor"

# cron runs with a stripped PATH that omits ~/.local/bin — without this the subprocess metrics
# (mesh-mind-state / mesh-sensorium and anything THEY shell out to) silently fail → UNKNOWN every
# tick while the pure file-read metrics look fine. Prepend the tool dir so the whole tract resolves.
os.environ["PATH"] = os.path.expanduser("~/.local/bin") + ":" + os.environ.get("PATH", "/usr/bin:/bin")
KEEP_ROWS = 5000          # bound the tape (trim oldest on write)
# raw rows shown on the pane. Env-tunable because the witness pane is no longer the whole window:
# since the chat/witness merge (2026-07-24) it is the TOP HALF of a fused dash and must give the
# board half its lines back. A caller that owns less pane says so; the standalone render is unchanged.
try:
    TAIL_ROWS = max(1, int(os.environ.get("MESH_WITNESS_TAIL", "12")))
except ValueError:
    TAIL_ROWS = 12
SPARK_ROWS = 24           # rows folded into each sparkline
SPARK = "▁▂▃▄▅▆▇█"
# A GLYPH THAT ALWAYS SPANS ITS FULL RANGE CANNOT SAY "THIS BARELY MOVED" (witness 2026-08-25).
# A window-relative sparkline with no scale draws quiet and violent IDENTICALLY: minds_live
# flapping 13..14 (7% of its own value) painted the whole eight-glyph ramp and read as a regime
# change — witness itself burned a wake measuring a "degradation" that was an axis flapping 2..5
# all day. The failure direction is a FALSE ALARM, which is the expensive one. Two scales fix it,
# by metric class:
#   * a RATIO metric carries its own denominator, so it is drawn on the ABSOLUTE 0..1 scale —
#     free, and strictly more informative than the window-relative one.
#   * an unbounded COUNTER gets a range FLOOR relative to the window's own median magnitude:
#     the ramp is full-scale only once the window's span reaches SPARK_RANGE_FLOOR x that
#     magnitude; below it the glyphs occupy a proportional slice of the ramp, anchored at the
#     bottom so a near-flat series renders continuous with a perfectly flat one.
# SPARK_RANGE_FLOOR = 1.0 is CALIBRATED against this node's live tape, not picked: over 415
# sliding 24-row windows of ~/.mesh/witness.log the span/median ratio ran board_age_s p10=3.04
# (>=1.0 in 100% of windows — the one metric whose full-scale render is CORRECT, and this floor
# never touches it) - minds_work med=2.00 (97%) - spend1h med=0.60 (23%) - board1h med=0.37 (8%)
# - board_posters med=0.33 (6%) - minds_live med=0.00 (2%). Re-derive before re-tuning; a
# floor that flattens board_age_s has broken the instrument in the opposite direction.
SPARK_RANGE_FLOOR = 1.0

# The metric SET the witness measures — (key, human label). Order = ledger + pane order.
METRICS = [
    ("nodes",       "nodes reached"),
    ("minds_live",  "minds live"),
    ("minds_work",  "minds working"),
    ("reflex",      "reflex-health"),
    ("board1h",     "board lines/1h"),
    ("board_age_s", "board pulse (s)"),
    ("board_posters", "board posters/1h"),
    ("senses",      "senses fresh"),
    ("spend1h",     "paid turns/1h"),
]

# Auxiliary fields captured at measure time and stored in the ledger, but NOT trended
# (no sparkline/arrow) — they carry the distribution a scalar metric collapses. Kept out
# of METRICS so the trend tract stays a clean scalar series.
AUX_FIELDS = ("senses_dist", "nodes_age_s")


# ---- measurement: each reads an already-produced artifact; UNKNOWN on any failure ----

def _read(path):
    try:
        with open(os.path.join(MESHDIR, path)) as f:
            return f.read()
    except OSError:
        return None


def _parse_node_states(txt):
    """Parse the DEVICES section of sense-map.txt -> list of status strings.

    The status is a closed set {online, unreach, offline} appearing as a whole word,
    so we anchor on IT rather than on column gaps. This is immune to two real
    inconsistencies in the cache: (a) hostnames may contain single internal spaces
    ('Redmi 10' was silently dropped by the old \\S+ host regex); (b) the column gap
    between host and status is NOT uniform — most rows use 2+ spaces but at least one
    ('imozerov-IdeaPad-3-15IIL05 online') uses a single space, which breaks a
    split-on-2+-spaces parse. Only the indented rows under '-- DEVICES:' are counted;
    the ACTIVE/PASSIVE cross-check sections have different shapes and must not inflate
    the device count."""
    section = []
    in_dev = False
    for ln in txt.splitlines():
        if re.match(r"--\s*DEVICES", ln):
            in_dev = True
            continue
        if in_dev and re.match(r"--\s", ln):  # next section header ends the block
            break
        if in_dev:
            section.append(ln)
    status_re = re.compile(r"(?:^|\s)(online|unreach|offline)(?=\s|$)")
    states = []
    for ln in section:
        if not ln.startswith((" ", "\t")):
            continue
        m = status_re.search(ln)
        if m:
            states.append(m.group(1))
    return states


def _age_s(path):
    """Age of a mesh artifact in whole seconds, or None if it isn't there."""
    try:
        return int(time.time() - os.path.getmtime(os.path.join(MESHDIR, path)))
    except OSError:
        return None


def m_nodes():
    """(reached/total, cache age in seconds) from the sense-map cache.

    The age is not decoration. This reflex samples every 2 min while mesh-sense-map refreshes
    every 10, so FOUR OF EVERY FIVE rows re-publish a value that was read, not re-measured.
    Without the age column, five correlated re-reads of ONE harvest are indistinguishable from
    five independent confirmations of an outage — measured 2026-08-15, every low run in the
    ledger was exactly 5 rows long (12/12) and began at minute = 2 mod 10, i.e. the first tick
    after the producer's cron boundary. nodes_age_s climbing 0→2→4→6→8 across a low run names
    it as one sample; a genuine outage re-reads a FRESH cache at a low value.
    Kept as a separate aux field, NOT folded into the 'x/y' string: mesh-witness-analyze's
    _frac_num and the manifold tract both parse that scalar, and a wider format breaks them."""
    txt = _read("sense-map.txt")
    age = _age_s("sense-map.txt")
    if not txt:
        return "UNKNOWN", age
    states = _parse_node_states(txt)
    if not states:
        return "UNKNOWN", age
    return f"{sum(1 for s in states if s == 'online')}/{len(states)}", age


def _mind_stats():
    try:
        out = subprocess.run(["mesh-mind-state", "--stats"], capture_output=True,
                             text=True, timeout=15).stdout
        return out.splitlines()
    except Exception:
        return None


def m_minds():
    """live (not DEAD) / working, from mesh-mind-state (local tmux read)."""
    lines = _mind_stats()
    if lines is None:
        return "UNKNOWN", "UNKNOWN"
    live = work = 0
    for ln in lines:
        if ln.startswith("WINDOW") or not ln.strip():
            continue
        cols = re.split(r"\s{2,}|\t", ln.strip())
        if len(cols) < 2:
            continue
        win, state = cols[0].strip(), cols[1].strip().upper()
        if win in ("bash", "WINDOW"):
            continue
        if state in ("IDLE", "WORKING"):
            live += 1
        if state == "WORKING":
            work += 1
    return str(live), str(work)


def m_reflex():
    """the reflex-health verdict token the reflex-health reflex already wrote (OK/WARN/...)."""
    txt = _read(".reflex-health-state")
    if txt is None:
        return "UNKNOWN"
    return (txt.strip().split() or ["UNKNOWN"])[0][:6] or "UNKNOWN"


def _board_lines():
    try:
        with open(os.path.join(MESHDIR, "chat.log")) as f:
            return f.readlines()
    except OSError:
        return None


def _board_stats(lines, now=None):
    """Pure: board throughput last 1h + seconds since the last board line (the coordination
    pulse) + DISTINCT POSTING IDENTITIES in that 1h window (a swarm-DENSITY instrument).

    LITERATURE (swarm intelligence & stigmergy, foundational idea applied too loosely, live
    review 2026-07-07): Hunt, Jones & Hauert, "Testing the limits of pheromone stigmergy in
    high-density robot swarms" (Royal Society Open Science 6:190225, 2019, fetched + read in
    full) found that stigmergic coordination through ONE shared medium is assumed to scale
    without limit, but empirically does not: at swarm sizes N=256/324/400 sharing one pheromone
    field, coordination became WORSE than non-interacting random walkers, because "broad patches
    of pheromone are formed... [which] traps a large number of agents within the same region" —
    the shared medium itself saturates and starts hurting once agent-DENSITY on it crosses a
    threshold, not merely once total activity is high. 2025-26 follow-up work on foraging-swarm
    congestion (a shared collection-zone bottleneck, mitigated by spreading entry points rather
    than adding more agents) treats this as the same class of problem: the fix is dispersing
    load across the shared medium, not assuming it always helps to add more voices to it.

    THE MISREAD: this mesh's board (~/.mesh/chat.log) IS that shared medium — every review and
    memory ([[no-fixed-mind-stigmergic-skeleton]], docs/epistemics.md) calls the coordination
    model "stigmergic" as praise, never as a thing with a scaling LIMIT. board1h (line volume)
    and board_age_s (pulse) were already measured, but neither answers the paper's actual
    question: how many DISTINCT voices are posting to the one shared ledger right now? Channel-
    genesis (this mesh growing its own new posting identities — vpn/bruno/witness/sound/capture-
    inuse/motion-corroborate, all born within days) is exactly the "swarm size N is climbing"
    axis the paper warns is not free — line VOLUME can stay flat while POSTER COUNT climbs (more
    voices, same total chatter, if each posts less) or vice versa, and the paper's finding is
    specifically about density/interference, not raw throughput. board_posters is the instrument
    that distinguishes them. Not an actuator (nothing re-routes or disperses postings) — the
    same instrument-before-behavior-change discipline as this mesh's other trend-only metrics
    and the "HELD, steward-gated" pattern this knowledge area's prior reviews already establish.

    `now` is injectable so --test can drive this deterministically without depending on the
    real wall clock (the existing behavior when now=None: real UTC now, matching every other
    caller in this file)."""
    if not lines:
        return "UNKNOWN", "UNKNOWN", "UNKNOWN"
    if now is None:
        now = datetime.now(timezone.utc)
    cut = now - timedelta(hours=1)
    n = 0
    last = None
    posters = set()
    for ln in lines:
        m = re.match(r"(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d)", ln)
        if not m:
            continue
        t = datetime.fromisoformat(m.group(1)).replace(tzinfo=timezone.utc)
        last = t
        if t > cut:
            n += 1
            wm = re.match(r"^\S+\s+(\S+)\s+::\s", ln)
            if wm:
                posters.add(wm.group(1))
    age = int((now - last).total_seconds()) if last else "UNKNOWN"
    return str(n), str(age), str(len(posters))


def m_board():
    """board throughput last 1h + pulse age + distinct posters/1h — see _board_stats for the
    literature grounding of the posters (density) metric."""
    return _board_stats(_board_lines())


def _parse_sense_tags(out):
    """Extract freshness tags from mesh-sensorium --cached output -> list (order preserved).

    A freshness tag is a parenthesized SINGLE status word. The PRODUCER's alphabet
    (mesh-sensorium mark()/bodymark()) is: fresh · recent · aging · **STALE** · — (no state
    file at all). The cached dump ALSO contains non-tag parens — the header '(CACHED state —
    the mind runs the live probes)', '(mind probes, no cache)' on the LIVE-ONLY line, and
    numeric '(40)' — so a naive '\\(([^)]+)\\)' over-counts (21 vs the true 18) and is an
    ACTIVE lie, not a fix.

    **A CONSUMER'S ALPHABET MUST MATCH THE PRODUCER'S — and the bucket most likely to fall
    outside it is the one the producer SHOUTED to mark as important.** This matched
    '\\(([a-z]+|UNKNOWN)\\)' — all-LOWERCASE only — from a57ef36 (the commit that introduced
    the buckets, deliberately emitting '(STALE)' uppercase as "the only state that matters
    for the fusion rule") until 2026-08-17. Every STALE sense was therefore dropped from
    BOTH numerator and denominator, and the failure INVERTS: as senses die the denominator
    shrinks and the ratio RISES. Measured live on this node post-reboot — true state 5 fresh
    / 19 senses with 8 STALE; witness logged '5/11', and two rows earlier the pane read
    **'senses fresh 3/3 ↑' with a full sparkline block while most senses were dead.** The
    old docstring wrote the alphabet as lowercase 'stale' and certified "the correct 18" — a
    number produced by the same broken assumption — and guarded a HYPOTHETICAL future 'dead'
    tag while blind to the real bucket already in the stream. Sibling of memory
    a-guards-alphabet-must-match-its-patterns.

    **THE SECOND SHAPE, and it is the same bug (2026-08-22).** b87da2a gave bodymark() a
    PROVENANCE annotation that REPLACES the freshness bucket when a sense is running on a
    substitute tier: mesh-sensorium:954/955/969/970 render '(<tier>-derived)' or
    '(<tier>-derived <N>m)' — e.g. 'DIM (beacon-derived 3m)'. A single-word regex sees a
    hyphen or a trailing age and drops the sense from BOTH sides of fresh/total, and those
    branches fire EXACTLY when the organ is gone and a fallback is filling in. The live path
    is the one sensorium's own comment describes: phone body dies -> sense goes (STALE) ->
    the beacon fallback engages and writes every cycle -> the sense VANISHES. Measured on the
    shipped regex: 2/4 = 0.500 became 2/3 = 0.667 with the organ still dead. Nothing got
    better and the health number went UP.

    A -derived reading is NOT fresh — it is a degraded sense wearing a substitute's datum —
    so it counts in the denominator and never in the numerator (see m_senses' 'd' bucket).

    We match '[a-z]+-derived( \\d+m)?' FIRST (most specific), then '[A-Za-z]+|—': a single
    word in EITHER case, plus the em-dash absent marker. Header prose ('(CACHED state — the
    mind runs the live probes)', '(mind probes, no cache)') and numerics ('(40)') are still
    rejected — the over-count they cause is an ACTIVE lie, not a fix. Case is PRESERVED here
    (the caller buckets case-insensitively) so a producer-side rename stays visible in the
    raw list instead of being folded away."""
    return re.findall(r"\(([a-z]+-derived(?: \d+m)?|[A-Za-z]+|—)\)", out)


def m_senses():
    """fresh/total + the full freshness distribution, from the sensorium cache.

    'total' counts every parenthesized tag (robust to new tag names). The distribution
    string (e.g. '2f/9r/6a/0s/1u') exposes what the single fresh/total fraction collapses:
    a pane reading '2/18' looks alarming, but if those 18 are mostly 'recent' the senses
    are healthy — the fraction alone can't tell you, the distribution can. Returns
    (scalar, dist); either is 'UNKNOWN' on failure."""
    try:
        out = subprocess.run(["mesh-sensorium", "--cached"], capture_output=True,
                             text=True, timeout=15).stdout
    except Exception:
        return "UNKNOWN", "UNKNOWN"
    tags = _parse_sense_tags(out)
    if not tags:
        return "UNKNOWN", "UNKNOWN"
    # Bucket CASE-INSENSITIVELY: the producer emits '(STALE)' uppercase and 'fresh/recent/
    # aging' lowercase. A case-sensitive count of "stale" reads 0 forever on a node whose
    # senses are all dead — the shape that made the pane render 3/3 ↑ (see _parse_sense_tags).
    low = [t.lower() for t in tags]
    f = low.count("fresh"); r = low.count("recent"); a = low.count("aging")
    s = low.count("stale"); u = low.count("unknown"); n = low.count("—")
    # DERIVED: the sense is alive only because a SUBSTITUTE tier is writing for a dead organ
    # (bodymark's provenance branches). It must sit in the denominator and never in the
    # numerator — counting it fresh, or dropping it, both make a dying sense raise the ratio.
    d = sum(1 for t in low if t.endswith("-derived") or "-derived " in t)
    other = len(tags) - (f + r + a + s + u + n + d)  # any future tag class lands here, not silently dropped
    dist = (f"{f}f/{r}r/{a}a/{s}s/{u}u" + (f"/{n}n" if n else "")
            + (f"/{d}d" if d else "") + (f"/{other}o" if other else ""))
    return f"{f}/{len(tags)}", dist


def m_spend():
    """paid turns in the last 1h from the spend event log (the mesh's metabolic rate)."""
    txt = _read("spend.log")
    if txt is None:
        return "UNKNOWN"
    cut = datetime.now(timezone.utc) - timedelta(hours=1)
    n = 0
    for ln in txt.splitlines():
        m = re.match(r"(\d{4}-\d\d-\d\dT\d\d:\d\d)Z", ln)
        if m and datetime.fromisoformat(m.group(1)).replace(tzinfo=timezone.utc) > cut:
            n += 1
    return str(n)


def measure():
    """Compute the full metric row. Each field is a scalar or 'x/y' string, or UNKNOWN."""
    minds_live, minds_work = m_minds()
    board1h, board_age, board_posters = m_board()
    senses, senses_dist = m_senses()
    nodes, nodes_age = m_nodes()
    return {
        "ts": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "nodes": nodes,
        "nodes_age_s": nodes_age,
        "minds_live": minds_live,
        "minds_work": minds_work,
        "reflex": m_reflex(),
        "board1h": board1h,
        "board_age_s": board_age,
        "board_posters": board_posters,
        "senses": senses,
        "senses_dist": senses_dist,
        "spend1h": m_spend(),
    }


def _row_str(row):
    parts = [row["ts"]] + [f"{k}={row.get(k, 'UNKNOWN')}" for k, _ in METRICS]
    # append aux fields (distributions) AFTER the trended scalars, when present
    parts += [f"{k}={row[k]}" for k in AUX_FIELDS if row.get(k) is not None]
    return " ".join(parts)


def do_measure():
    row = measure()
    line = _row_str(row) + "\n"
    # append, then trim the tape to KEEP_ROWS (bounded but continuous)
    try:
        with open(LEDGER, "a") as f:
            f.write(line)
        with open(LEDGER) as f:
            rows = f.readlines()
        if len(rows) > KEEP_ROWS:
            with open(LEDGER, "w") as f:
                f.writelines(rows[-KEEP_ROWS:])
    except OSError as e:
        print(f"mesh-witness: FAIL to write ledger: {e}", file=sys.stderr)
        sys.exit(1)
    print(line, end="")


# ---- pane render: tails the ledger only (cheap) ----

def _parse_row(line):
    out = {}
    toks = line.split()
    if not toks:
        return out
    out["ts"] = toks[0]
    for t in toks[1:]:
        if "=" in t:
            k, v = t.split("=", 1)
            out[k] = v
    return out


def _num(v):
    """numeric lead of a metric value: '6/7'->6, '32'->32, 'OK'/'UNKNOWN'->None."""
    if v is None:
        return None
    m = re.match(r"-?\d+", str(v))
    return int(m.group(0)) if m else None


def _spark_val(v):
    """trend-significant scalar for the sparkline/arrow tract. Ratio metrics (e.g. nodes
    '5/7') trend on the denominator-aware FRACTION so a '5/7'->'5/6' shift reads as a rise
    (0.71->0.83) instead of being masked flat by a numerator-only read (5->5). Plain scalars
    pass through _num unchanged; non-numeric -> None (blank in sparkline). _num itself stays
    numerator-only (other call sites + its test rely on that)."""
    if v is None:
        return None
    m = re.match(r"(\d+)/(\d+)", str(v))
    if m:
        denom = int(m.group(2))
        return int(m.group(1)) / denom if denom else None
    return _num(v)


def _is_ratio(v):
    """does this RAW ledger value express itself as a fraction ('4/10')? Decided on the raw
    text, because _spark_val has already collapsed it to a float by the time _spark sees it."""
    return v is not None and re.match(r"\d+/\d+", str(v)) is not None


def _spark_median(vals):
    s = sorted(vals)
    n = len(s)
    return s[n // 2] if n % 2 else (s[n // 2 - 1] + s[n // 2]) / 2.0


def _spark(series, absolute=False):
    """render a series as glyphs on a scale that can say "this barely moved" — see the
    SPARK_RANGE_FLOOR note above for why a bare (v-lo)/(hi-lo) cannot. absolute=True draws on
    the fixed 0..1 scale (ratio metrics); otherwise the window-relative scale is widened to at
    least SPARK_RANGE_FLOOR x the window's median magnitude, anchored at lo. A series already
    spanning that much is untouched — byte-identical to the old render."""
    vals = [v for v in series if v is not None]
    if len(vals) < 2:
        return ""
    lo, hi = min(vals), max(vals)
    if absolute:
        lo, hi = 0.0, 1.0
    else:
        floor = SPARK_RANGE_FLOOR * max(abs(_spark_median(vals)), 1.0)
        if hi - lo < floor:
            hi = lo + floor
    if hi <= lo:
        return SPARK[0] * len(series)
    out = []
    for v in series:
        if v is None:
            out.append(" ")
        else:
            idx = int((v - lo) / (hi - lo) * (len(SPARK) - 1))
            out.append(SPARK[max(0, min(len(SPARK) - 1, idx))])
    return "".join(out)


def _arrow(cur, prev):
    a, b = _spark_val(cur), _spark_val(prev)
    if a is None or b is None:
        return " "
    return "↑" if a > b else ("↓" if a < b else "→")


def _labour_tree():
    """Live rolling-5h double-entry labour tree from `mesh-labor --balance --rolling`.

    Returns the tree text (no trailing newline) or None on any failure — the caller renders a
    loud fallback line, never a silently-dropped section."""
    try:
        out = subprocess.run([LABOR_BIN, "--balance", "--rolling"], capture_output=True,
                             text=True, timeout=5).stdout.rstrip("\n")
        return out if out else None
    except Exception:
        return None


def render_pane(embed=False):
    # embed=True → this render is ONE HALF of a host dash (mesh-dash witness). Drop the local date
    # line and the pane-live footer: the host stamps its own, and a pane carrying two liveness-lease
    # footers tells the reader nothing when one of them freezes.
    lines = ["== witness: the mesh measuring itself — self-measurement ledger =="]
    if not embed:
        lines.append(datetime.now().strftime("%a %b %e %I:%M:%S %p %Z %Y"))
    lines.append("")
    try:
        with open(LEDGER) as f:
            rows = [_parse_row(l) for l in f if l.strip()]
    except OSError:
        rows = []
    if not rows:
        lines.append("  (no measurements yet — the reflex runs `mesh-witness --measure` every 2m)")
        lines.append("  bootstrap now:  mesh-witness --measure")
        lines.append("")
        if not embed:
            lines.append("-- pane live: %s · this line ticks every frame — frozen = dead render loop --"
                         % datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"))
        return "\n".join(lines)

    latest = rows[-1]
    prev = rows[-2] if len(rows) > 1 else {}
    window = rows[-SPARK_ROWS:]

    # latest reading, each metric with a trend arrow vs the prior row + its sparkline
    lines.append("-- latest measurement (%s) — arrow vs prior row · sparkline over last %d --"
                 % (latest.get("ts", "?"), len(window)))
    for key, label in METRICS:
        cur = latest.get(key, "UNKNOWN")
        arr = _arrow(cur, prev.get(key)) if prev else " "
        raw = [r.get(key) for r in window]
        # a metric that expresses itself as x/y is drawn on the absolute 0..1 scale
        spark = _spark([_spark_val(v) for v in raw], absolute=any(_is_ratio(v) for v in raw))
        line = f"  {label:<16} {cur:<10} {arr}  {spark}"
        # show the freshness distribution inline so '2/18' reads truthfully (mostly recent?)
        if key == "senses":
            dist = latest.get("senses_dist")
            if dist and dist != "UNKNOWN":
                line += f"   [{dist}]"
        lines.append(line)
    # a first-order self-reading: how fresh is the tape itself (witness watching witness)
    try:
        age = int(time.time() - os.path.getmtime(LEDGER))
        lines.append(f"  {'measure age (s)':<16} {age:<10} {'→':<1}  (last row written {age}s ago)")
    except OSError:
        pass

    # labour ledger — PRIMARY view (operator 2026-07-24: "chat.log as an hledger accounting
    # system that balances itself around labour spent"). Live rolling-5h Dr/Cr tree, not a cached
    # one-liner — see _labour_tree() and the Cost discipline note above for why this is exempted
    # from the pane's usual pure-file-read rule.
    lines.append("")
    lines.append("-- labour ledger (mesh-labor · rolling 5h · self-balancing · `mesh-labor --balance --rolling`) --")
    tree = _labour_tree()
    if tree:
        lines.extend("  " + l for l in tree.splitlines())
    else:
        lines.append("  (labour tree render FAILED — this frame BLIND, not all-clear)")

    # resource ledger — the mesh measuring what it CONSUMES (mesh-ledger, double-entry, parity-checked).
    # Cheap: tails a one-line summary mesh-ledger writes each hourly feed; no live hledger in this render.
    # Footer position (demoted 2026-07-24): labour is now the primary axis on this pane.
    try:
        with open(os.path.expanduser("~/.mesh/.ledger-summary")) as f:
            summ = f.read().strip()
        if summ:
            lines.append("")
            lines.append("-- resource ledger (mesh-ledger · double-entry · `mesh-ledger --dash`) --")
            lines.append("  " + summ)
    except OSError:
        pass

    # promise ledger — the mesh's UNKEPT board obligations (mesh-promises, double-entry leak detector).
    # Cheap: tails the one-line summary + a short leak worklist mesh-promises caches each feed; no live
    # replay here. This is witness's DRIVING surface — a leaked promise is a [task] made and not kept,
    # and driving its owner (pick-up-or-retire) is witness's board duty. Footer position (demoted
    # 2026-07-24): labour is now the primary axis on this pane.
    try:
        with open(os.path.expanduser("~/.mesh/.promises-summary")) as f:
            psumm = f.read().strip()
        if psumm:
            lines.append("")
            lines.append("-- promise ledger (mesh-promises · unkept board obligations · `mesh-promises --report`) --")
            lines.append("  " + psumm)
            try:
                with open(os.path.expanduser("~/.mesh/.promises-leaks")) as f:
                    leaks = f.read().rstrip("\n")
                if leaks:
                    lines.append("  leaked (drive owner: pick-up-or-retire):")
                    lines.append(leaks)
            except OSError:
                pass
    except OSError:
        pass
    lines.append("")

    # the raw growing tape — the continuous ledger the operator asked for
    lines.append(f"-- ledger tail (last {min(TAIL_ROWS, len(rows))} of {len(rows)} rows) — {LEDGER} --")
    for r in rows[-TAIL_ROWS:]:
        compact = " ".join(f"{k}={r.get(k)}" for k, _ in METRICS)
        lines.append(f"  {r.get('ts', '?')}  {compact}")
    if not embed:
        lines.append("")
        lines.append("-- pane live: %s · this line ticks every frame — frozen = dead render loop --"
                     % datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"))
    return "\n".join(lines)


def _test_node_parse():
    """Fixture-test the device-row parser. Covers TWO real regressions in the cache's
    shape: (a) space-in-hostname ('Redmi 10' was dropped by the old \\S+ regex); (b)
    non-uniform column gap — row 3 uses a SINGLE space between host and status
    ('imozerov-IdeaPad-3-15IIL05 online'), which breaks a split-on-2+-spaces parse.
    Also asserts the section boundary: ACTIVE/PASSIVE cross-check rows must not count."""
    fixture = """-- DEVICES: senses + actuators (harvest from ALL — sensors AND ways to act) --
  ilya                       online   mic | act: speaker
  imozerov-Default-string    online   ble wifi cam mic | act: speaker voice
  imozerov-IdeaPad-3-15IIL05 online   ble wifi cam mic | act: speaker voice
  mac                        online   wifi cam mic | act: voice speaker
  Redmi 10                   offline  ?
  note3                      unreach  ble wifi
  GL-MT3000                  offline  ?
-- ACTIVE cross-checks (actuator on one node -> sensor on another: validate + derive) --
  audio  emit[a, b] -> hear[a, b] — emit a tone -> hear it
-- PASSIVE cross-checks (same sense on >=2 nodes -> multi-vantage) --
  ble   x2 (a, b) — proximity cross-check
"""
    states = _parse_node_states(fixture)
    # 7 devices total: ilya, imozerov-Default-string, imozerov-IdeaPad-3-15IIL05, mac
    # (all online); Redmi 10 (offline), note3 (unreach), GL-MT3000 (offline).
    # Cross-check rows must NOT count.
    if len(states) != 7:
        print(f"smoke-test: FAIL (node parse counted {len(states)} devices, expected 7; "
              f"states={states})"); sys.exit(1)
    if states.count("online") != 4:
        print(f"smoke-test: FAIL (node parse online={states.count('online')}, expected 4; "
              f"states={states})"); sys.exit(1)
    # regression (a): 'Redmi 10' (space in hostname) must be counted, not dropped.
    # regression (b): the single-space 'imozerov-IdeaPad-3-15IIL05 online' row must be
    # counted as online. Both manifest as len(states)==7; the old parsers gave 5 or 6.
    # empty / non-DEVICES text -> empty list (caller renders UNKNOWN)
    if _parse_node_states("") != []:
        print("smoke-test: FAIL (empty parse did not return [])"); sys.exit(1)
    if _parse_node_states("-- SOME OTHER SECTION --\n  foo  online  x\n") != []:
        print("smoke-test: FAIL (non-DEVICES section was parsed)"); sys.exit(1)


def _test_sense_parse():
    """Fixture-test the freshness-tag parser + cross-check its alphabet against the PRODUCER.

    Guards two denominator lies. (1) The latent one: a hardcoded tag set silently drops a
    future class (e.g. 'dead') and understates total. (2) The one that WAS LIVE for weeks:
    the producer's '(STALE)' is UPPERCASE and the parser matched '[a-z]+' only, so dying
    senses left the denominator and the ratio ROSE — the pane read '3/3 ↑' on a node whose
    senses were mostly dead. The old version of this very test carried a fixture with
    fresh/recent/aging/dead and **not one STALE**, then asserted s=0 as correct: a fixture
    that omits the failing bucket certifies the failure. Every bucket the producer can emit
    is now in the fixture, and leg 4 asserts the two alphabets cannot drift apart again."""
    fixture = """=== mesh sensorium (CACHED state) @ 2026-07-06T23:23:38Z ===
BODY       motion=OFFLINE (recent) · power=OFFLINE (aging) · prox=UNREACHABLE (recent)
ROOM       room=PRESENT (fresh) · tempo=RESTING (STALE) · audio=IDLE (recent) · ctx=SOLO (fresh)
PRESENCE   n=6 top=LE-Bose Revolve SoundLink pers:3 appl:2 amb:1 (STALE)
NODE       hw=OK (recent) · organ=DEAD (dead) · never-written=? (—)
"""
    tags = _parse_sense_tags(fixture)
    # 11 tags: BODY=3 ROOM=4 PRESENCE=1 NODE=3. Mixed case + the em-dash absent marker.
    if len(tags) != 11:
        print(f"smoke-test: FAIL (sense parse counted {len(tags)} tags, expected 11; tags={tags})")
        sys.exit(1)
    # LEG 1 — the live lie: uppercase STALE must reach the denominator. The old [a-z]+ regex
    # returns 8 here (both STALEs and the (—) dropped), so this leg is red-by-construction
    # against the shipped bug, not a fixture the bug happens to pass.
    if tags.count("STALE") != 2:
        print(f"smoke-test: FAIL (uppercase STALE dropped from denominator: tags={tags})")
        sys.exit(1)
    if "—" not in tags:
        print("smoke-test: FAIL (the '(—)' never-written marker was dropped — a sense with no "
              "state file at all must be in the denominator, never absent from it)")
        sys.exit(1)
    # LEG 2 — the latent lie: 'dead' must be in the denominator. A closed-set regex gives 11.
    if "dead" not in tags:
        print("smoke-test: FAIL (exotic 'dead' tag was silently dropped from denominator)")
        sys.exit(1)
    # also asserts the header '(CACHED state ...)' and any numeric '(40)' parens are NOT
    # counted (the any-parens regression that over-counted to 21 against the live cache).
    if any(" " in t or any(c.isdigit() for c in t) for t in tags):
        print(f"smoke-test: FAIL (non-tag prose/digit parens leaked into tags: {tags})")
        sys.exit(1)
    # LEG 3 — distribution arithmetic THROUGH m_senses' own bucketing rule (case-insensitive):
    # f=2 r=4 a=1 s=2 u=0 n=1(—) other=1(dead). The pre-fix code counted s via the literal
    # "stale" and would report s=0 on this same fixture.
    low = [t.lower() for t in tags]
    f = low.count("fresh"); r = low.count("recent"); a = low.count("aging")
    s = low.count("stale"); u = low.count("unknown"); n = low.count("—")
    other = len(tags) - (f + r + a + s + u + n)
    if (f, r, a, s, u, n, other) != (2, 4, 1, 2, 0, 1, 1):
        print(f"smoke-test: FAIL (sense distribution wrong: f={f} r={r} a={a} s={s} u={u} "
              f"n={n} o={other})")
        sys.exit(1)
    if s == 0:
        print("smoke-test: FAIL (stale bucket read 0 on a fixture containing STALE — the "
              "false-green shape: dying senses must RAISE s, never vanish)")
        sys.exit(1)
    if _parse_sense_tags("") != []:
        print("smoke-test: FAIL (empty sense parse did not return [])"); sys.exit(1)

    # LEG 4 — PRODUCER CONTRACT. The bug was not a bad regex in isolation; it was two files'
    # alphabets drifting apart with nothing reading both. Extract every bucket literal
    # mesh-sensorium can actually emit and assert THIS parser matches each one. Goes red the
    # moment sensorium adds or renames a bucket — the only leg that survives a rename.
    prod = shutil.which("mesh-sensorium")
    if not prod:
        print("  n/a: mesh-sensorium not on PATH — producer-alphabet cross-check skipped")
        return
    try:
        src = open(prod, encoding="utf-8", errors="replace").read()
    except OSError as e:
        print(f"  n/a: cannot read mesh-sensorium ({e}) — cross-check skipped")
        return
    buckets = set(re.findall(r"printf '%s \(([^)]*)\)'", src))
    if not buckets:
        print("smoke-test: FAIL (found no bucket literals in mesh-sensorium — the producer's "
              "emit format changed shape; this cross-check has gone vacuous and must be rewritten)")
        sys.exit(1)
    # A bucket carrying a FORMAT SPECIFIER is not a bucket name — it is a template whose
    # parenthesised text is substituted at RUNTIME (mesh-sensorium:954/955/969/970 pass $ssrc
    # / $src / an age). Asserting the parser matches the literal string '%s' is the wrong fix
    # and leaves the real hole open: what reaches this consumer is '(beacon-derived 3m)', and
    # THAT is what must parse. So split the alphabet and check each half on its own terms.
    literals = {b for b in buckets if "%" not in b}
    templated = {b for b in buckets if "%" in b}
    # Every template needs a declared runtime RENDERING. A new/renamed template lands in
    # `undeclared` and goes red — the drift-detection property leg 4 exists for, kept for the
    # half that a literal comparison cannot cover.
    renderings = {
        "%s":             "beacon-derived",     # $src  = grep -oE '[a-z]+-derived'
        "%s %dm":         "beacon-derived 3m",  # ... plus the substitute datum's own age
        "%s-derived":     "beacon-derived",     # $ssrc = grep -oE 'source=[a-z]+' (tier only)
        "%s-derived %dm": "beacon-derived 3m",
    }
    undeclared = sorted(templated - set(renderings))
    if undeclared:
        print(f"smoke-test: FAIL (producer grew templated bucket(s) with no declared runtime "
              f"rendering: {undeclared} — read the printf's ARGUMENTS in mesh-sensorium to see "
              f"what it actually emits, add the rendered form to `renderings`, and widen "
              f"_parse_sense_tags + m_senses' bucketing to match. Do NOT make the parser match "
              f"the format specifier itself.)")
        sys.exit(1)
    checks = [(b, b) for b in literals] + [(t, renderings[t]) for t in templated]
    missed = sorted({src_b for src_b, rendered in checks
                     if _parse_sense_tags(f"x=v ({rendered})") != [rendered]})
    if missed:
        print(f"smoke-test: FAIL (producer emits bucket(s) this parser cannot see: {missed} — "
              f"each would drop OUT of both numerator and denominator, so dying senses would "
              f"RAISE the ratio. Widen _parse_sense_tags + m_senses' bucketing together.)")
        sys.exit(1)
    print(f"  ok: producer alphabet {sorted(literals)} + templated {sorted(templated)} "
          f"(rendered) fully covered by the parser")

    # LEG 5 — POLARITY, not parsing. A green leg 4 proves the parser MATCHES a tag; it says
    # nothing about which way the number then moves, and this bug's whole signature is the
    # number moving the wrong way. Drive the REAL degradation path sensorium's own comment
    # describes: the phone body dies (sense goes STALE), then the beacon fallback engages and
    # writes every cycle. The organ is dead in BOTH frames — the ratio must not improve.
    # Falsify: restore the single-word regex and this leg reports 0.500 -> 0.667. (Seen red
    # 2026-08-22 against the shipped parser, before the fix.)
    def _frac(o):
        t = _parse_sense_tags(o)
        low = [x.lower() for x in t]
        return low.count("fresh"), len(t)
    organ_dead_stale = ("BODY motion=OFFLINE (STALE) · light=DIM (STALE)\n"
                        "ROOM room=PRESENT (fresh) · ctx=SOLO (fresh)\n")
    organ_dead_fallback = ("BODY motion=OFFLINE (STALE) · light=DIM (beacon-derived 3m)\n"
                           "ROOM room=PRESENT (fresh) · ctx=SOLO (fresh)\n")
    f0, t0 = _frac(organ_dead_stale)
    f1, t1 = _frac(organ_dead_fallback)
    if t1 != t0:
        print(f"smoke-test: FAIL (polarity: a sense that fell back to a substitute tier left "
              f"the DENOMINATOR — {t0} senses became {t1}. A degraded sense must stay counted; "
              f"dropping it is how dying senses raise the ratio.)")
        sys.exit(1)
    if f1 != f0:
        print(f"smoke-test: FAIL (polarity: a '-derived' sense was counted FRESH — numerator "
              f"{f0} became {f1}. It is alive only because a substitute is writing for a dead "
              f"organ; counting it fresh launders the outage.)")
        sys.exit(1)
    if f1 / t1 > f0 / t0:
        print(f"smoke-test: FAIL (polarity INVERTED: the organ is dead in both frames, yet the "
              f"health ratio ROSE {f0}/{t0} -> {f1}/{t1}. This is the whole bug.)")
        sys.exit(1)
    # and the distribution must SAY 'derived' rather than folding it into 'other'
    _low = [x.lower() for x in _parse_sense_tags(organ_dead_fallback)]
    _d = sum(1 for x in _low if x.endswith("-derived") or "-derived " in x)
    if _d != 1:
        print(f"smoke-test: FAIL (derived bucket counted {_d}, expected 1 — m_senses' dist "
              f"would not surface the substitute tier)")
        sys.exit(1)
    print(f"  ok: polarity — organ dead, fallback engaged: {f0}/{t0} -> {f1}/{t1} "
          f"(denominator held, derived not counted fresh)")


def _test_board_parse():
    """Fixture-test _board_stats (swarm-density instrument, board_posters). Injectable `now` so
    this is deterministic regardless of wall-clock time. Fixture lines are in the SAME
    chronological (oldest-first) order the real chat.log is always appended in."""
    now = datetime(2026, 7, 7, 12, 0, 0, tzinfo=timezone.utc)
    old     = (now - timedelta(hours=3)).strftime("%Y-%m-%dT%H:%M:%S") + "Z"
    r3      = (now - timedelta(minutes=30)).strftime("%Y-%m-%dT%H:%M:%S") + "Z"
    r2      = (now - timedelta(minutes=20)).strftime("%Y-%m-%dT%H:%M:%S") + "Z"
    r1      = (now - timedelta(minutes=10)).strftime("%Y-%m-%dT%H:%M:%S") + "Z"
    lines = [
        f"{old}  chat@host    ::  [fyi] outside the 1h window entirely\n",
        f"{r3}  genome@host  ::  [idle] c\n",
        f"{r2}  senses@host  ::  [fyi] b\n",
        f"{r1}  genome@host  ::  [done] a\n",   # same poster as r3 -> distinct-poster count must NOT double-count
    ]
    n, age, posters = _board_stats(lines, now=now)
    if n != "3":
        print(f"smoke-test: FAIL (board_stats 1h line count wrong: {n}, want 3)"); sys.exit(1)
    if posters != "2":
        print(f"smoke-test: FAIL (board_stats distinct posters wrong: {posters}, want 2 [genome,senses] — a repeat poster must not double-count)"); sys.exit(1)
    if age != "600":
        print(f"smoke-test: FAIL (board_stats pulse age wrong: {age}, want 600s [most recent line 10min old])"); sys.exit(1)
    # empty/unreadable board -> UNKNOWN across all three, never a fabricated zero (honest-fusion)
    if _board_stats([], now=now) != ("UNKNOWN", "UNKNOWN", "UNKNOWN"):
        print("smoke-test: FAIL (empty board must render UNKNOWN across all 3 fields, never a fake 0)")
        sys.exit(1)


def smoke_test():
    import tempfile
    global LEDGER
    _test_node_parse()
    _test_sense_parse()
    _test_board_parse()
    # measurement must produce every declared key (UNKNOWN allowed, absence not)
    row = measure()
    for key, _ in METRICS:
        if key not in row:
            print(f"smoke-test: FAIL (measure missing metric {key})"); sys.exit(1)
    if not re.match(r"\d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ", row["ts"]):
        print(f"smoke-test: FAIL (bad ts {row['ts']})"); sys.exit(1)
    # nodes is a RE-READ of a */10 cache at a 2-min cadence: the row must carry the cache's age,
    # or five re-publications of one harvest read as five confirmations (see m_nodes). Drive the
    # age off a real file so the assertion covers the mtime read, not just the plumbing.
    with tempfile.NamedTemporaryFile("w", prefix="witness-agetest-", dir=MESHDIR,
                                     suffix=".txt", delete=False) as af:
        af.write("-- DEVICES: x --\n  a  online  mic\n")
        _agep = af.name
    try:
        got_age = _age_s(os.path.basename(_agep))
        if got_age is None or got_age > 60:
            print(f"smoke-test: FAIL (_age_s on a just-written file returned {got_age})"); sys.exit(1)
        if _age_s("definitely-not-a-real-artifact.txt") is not None:
            print("smoke-test: FAIL (missing artifact must age None, never 0 — a fabricated 0 "
                  "would render every stale re-read as freshly measured)"); sys.exit(1)
    finally:
        os.unlink(_agep)
    if "nodes_age_s" not in row:
        print("smoke-test: FAIL (row has no nodes_age_s — a cache re-read with no age column)")
        sys.exit(1)
    if "nodes_age_s" not in AUX_FIELDS:
        print("smoke-test: FAIL (nodes_age_s measured but not in AUX_FIELDS → never reaches the "
              "ledger, so the row a human reads still cannot tell a re-read from a re-measure)")
        sys.exit(1)
    # append/trim/render round-trip on a sandboxed ledger (no touching the real tape)
    with tempfile.NamedTemporaryFile("w", prefix="witness-test-", delete=False) as tf:
        tmp = tf.name
    LEDGER = tmp
    try:
        do_measure()
        do_measure()
        with open(tmp) as f:
            got = [l for l in f if l.strip()]
        if len(got) != 2:
            print(f"smoke-test: FAIL (expected 2 ledger rows, got {len(got)})"); sys.exit(1)
        pane = render_pane()
        if "self-measurement ledger" not in pane or "ledger tail" not in pane:
            print("smoke-test: FAIL (pane render missing sections)"); sys.exit(1)
        # sparkline/arrow helpers must not choke on UNKNOWN/mixed values
        if _num("6/7") != 6 or _num("OK") is not None or _arrow("5", "3") != "↑":
            print("smoke-test: FAIL (num/arrow helpers)"); sys.exit(1)
        # denominator-aware trend: a '5/7'->'5/6' shift (numerator flat, denominator fell)
        # MUST read as a rise — the numerator-only read masked it as '→'. The own-node-count
        # regression this guards: parse fix 7518998 made the ratio honest, but the sparkline
        # still hid denominator movement behind a flat '5'.
        if _spark_val("5/7") is None or _arrow("5/6", "5/7") != "↑" or _arrow("5/8", "5/7") != "↓":
            print("smoke-test: FAIL (ratio trend not denominator-aware)"); sys.exit(1)
        # --- SCALE CONTRACT (witness 2026-08-25): a glyph that always spans its full range
        # cannot say "this barely moved". RED ARM: pre-fix, a 13,14,13,14 flap (7% of value)
        # rendered "▁█▁█" — the whole ramp, indistinguishable from a collapse. It must now stay
        # off the top glyph, while a series that genuinely traverses its own magnitude must
        # still reach it.
        flap = _spark([13, 14, 13, 14])
        if SPARK[-1] in flap or SPARK[0] not in flap:
            print(f"smoke-test: FAIL (near-degenerate series still paints a cliff: {flap!r})"); sys.exit(1)
        wide = _spark(list(range(0, 15)))
        if SPARK[0] not in wide or SPARK[-1] not in wide:
            print(f"smoke-test: FAIL (a full-magnitude series lost its full ramp: {wide!r})"); sys.exit(1)
        # ratio metrics are drawn on the ABSOLUTE 0..1 scale: a nodes axis flapping 2/10..5/10
        # sits in the low band, while a real collapse 10/10 -> 0/10 still spans the ramp.
        flat_ratio = _spark([0.2, 0.3, 0.2, 0.5], absolute=True)
        if SPARK[-1] in flat_ratio:
            print(f"smoke-test: FAIL (low ratio band rendered as full-scale: {flat_ratio!r})"); sys.exit(1)
        collapse = _spark([1.0, 1.0, 0.0, 0.0], absolute=True)
        if SPARK[0] not in collapse or SPARK[-1] not in collapse:
            print(f"smoke-test: FAIL (ratio collapse lost its full ramp: {collapse!r})"); sys.exit(1)
        # THE OPPOSITE-DIRECTION BREAK: board_age_s legitimately spans its whole window and its
        # full-scale render is CORRECT. Driven over the LIVE tape's own last-24 board_age_s
        # window (not a fixture) against a reference implementation of the OLD renderer — the
        # two must be byte-identical. Unreadable/short tape -> skipped LOUDLY, never silently.
        def _old_spark(series):
            vals = [v for v in series if v is not None]
            if len(vals) < 2:
                return ""
            lo, hi = min(vals), max(vals)
            if hi == lo:
                return SPARK[0] * len(series)
            return "".join(" " if v is None else
                           SPARK[min(len(SPARK) - 1, int((v - lo) / (hi - lo) * (len(SPARK) - 1)))]
                           for v in series)
        live_path = os.path.expanduser("~/.mesh/witness.log")
        try:
            with open(live_path) as f:
                live_rows = [_parse_row(l) for l in f if l.strip()][-SPARK_ROWS:]
        except OSError:
            live_rows = []
        if len(live_rows) >= 2:
            live = [_spark_val(r.get("board_age_s")) for r in live_rows]
            if _spark(live) != _old_spark(live):
                print("smoke-test: FAIL (board_age_s render CHANGED by the scale fix: %r -> %r)"
                      % (_old_spark(live), _spark(live))); sys.exit(1)
        else:
            print("smoke-test: NOTE (live tape unreadable/short — board_age_s unchanged-arm NOT run)")
        # --- EMBED CONTRACT (the fused witness dash consumes this half, 2026-07-24) ---
        # Driven through the REAL CLI in a subprocess over the seeded tape — the in-process
        # render_pane() call above cannot exercise MESH_WITNESS_TAIL at all (TAIL_ROWS binds at
        # import), so a same-process assertion would pass while the env knob was dead.
        env = dict(os.environ, MESH_WITNESS_LEDGER=tmp)
        def _cli(*extra, **kw):
            e = dict(env); e.update(kw.pop("env_add", {}))
            return subprocess.run([sys.executable, os.path.abspath(__file__), "--pane", *extra],
                                  capture_output=True, text=True, env=e, timeout=30).stdout
        plain = _cli()
        emb = _cli("--embed")
        # 1. the half still carries the tape (it is the SAME render, not a stub)
        if "self-measurement ledger" not in emb or "ledger tail" not in emb:
            print("smoke-test: FAIL (--embed dropped the tape itself)"); sys.exit(1)
        # 2. it drops the pane-live footer — two liveness leases in one pane is the defect
        if "pane live:" in emb:
            print("smoke-test: FAIL (--embed still emits a pane-live footer; the host dash owns it)"); sys.exit(1)
        if "pane live:" not in plain:
            print("smoke-test: FAIL (plain --pane lost its pane-live footer)"); sys.exit(1)
        # 3. --embed is SHORTER than plain (footer + local date line gone)
        if len(emb.splitlines()) >= len(plain.splitlines()):
            print("smoke-test: FAIL (--embed not shorter than --pane: %d vs %d lines)"
                  % (len(emb.splitlines()), len(plain.splitlines()))); sys.exit(1)
        # 4. MESH_WITNESS_TAIL actually moves the ledger-tail row count. The seeded tape has 2 rows,
        #    so ask for 1 and assert the header SAYS 1 and exactly 1 row follows — a knob that is
        #    read but ignored would still render "last 2".
        one = _cli(env_add={"MESH_WITNESS_TAIL": "1"})
        if "ledger tail (last 1 of 2 rows)" not in one:
            print("smoke-test: FAIL (MESH_WITNESS_TAIL=1 did not shrink the ledger tail)"); sys.exit(1)
        if len([l for l in one.splitlines() if re.match(r"\s+\d{4}-\d\d-\d\dT", l)]) != 1:
            print("smoke-test: FAIL (MESH_WITNESS_TAIL=1 header said 1 but emitted a different row count)"); sys.exit(1)
        # --- LABOUR TREE (primary view, live `mesh-labor --balance --rolling` call) ---
        # Real spend.log content is environment-dependent (nondeterministic across machines/runs),
        # so this asserts PRESENCE + ordering + the failure fallback, not specific numbers — same
        # convention as the METRICS loop above, which allows UNKNOWN for live-subprocess fields.
        if "labour ledger" not in plain:
            print("smoke-test: FAIL (pane render missing labour ledger section)"); sys.exit(1)
        # promoted ABOVE resource ledger (only checked if that section is present on this machine —
        # its own file may not exist in a bare checkout, and this test must stay hermetic either way)
        if "resource ledger" in plain and plain.index("labour ledger") > plain.index("resource ledger"):
            print("smoke-test: FAIL (labour ledger not promoted above resource ledger)"); sys.exit(1)
        # failure mode: mesh-labor unreachable/erroring must render the loud fallback, never a
        # silently-dropped section. MESH_LABOR_BIN lets the test point at a broken stub without
        # touching the real ~/.local/bin/mesh-labor (same injection idiom as MESH_WITNESS_LEDGER).
        import shutil
        stubdir = tempfile.mkdtemp(prefix="witness-test-stub-")
        try:
            stub = os.path.join(stubdir, "broken-mesh-labor")
            with open(stub, "w") as f:
                f.write("#!/bin/sh\nexit 1\n")
            os.chmod(stub, 0o755)
            broken = _cli(env_add={"MESH_LABOR_BIN": stub})
        finally:
            shutil.rmtree(stubdir, ignore_errors=True)
        if "labour tree render FAILED" not in broken:
            print("smoke-test: FAIL (broken mesh-labor did not trigger the loud labour-tree fallback)"); sys.exit(1)
    finally:
        try: os.unlink(tmp)
        except OSError: pass

    _test_manifold()
    print("smoke-test: ok (+ manifold: PR identity on independent/collinear clouds, collapse detected, "
          "no-change control STABLE against the block-permutation null, constant column dropped, "
          "one-missing-sample column still admitted, INSUFFICIENT floors)"); sys.exit(0)


def _fail(msg):
    print(f"smoke-test: FAIL ({msg})"); sys.exit(1)


def _test_manifold():
    """The manifold read, driven through the REAL manifold()/_pr() on seeded synthetic tapes.

    Globals (not env) are set here on purpose: MANIFOLD_BLOCK/PERMS bind at LOAD time, so an
    os.environ write inside this process could never exercise them (the same rebind trap the
    MESH_WITNESS_LEDGER comment at the top of this file names)."""
    import random, shutil, tempfile
    global MANIFOLD_BLOCK, MANIFOLD_PERMS
    keep_block, keep_perms = MANIFOLD_BLOCK, MANIFOLD_PERMS
    MANIFOLD_BLOCK, MANIFOLD_PERMS = 10, 40
    try:
        # 1. PR identity: independent columns → PR ≈ k ; one shared factor → PR ≈ 1
        rnd = random.Random(7)
        cols = ["a", "b", "c", "d"]
        indep = [{c: rnd.gauss(0, 1) for c in cols} for _ in range(400)]
        pr_i = _pr(indep, cols)
        if not (3.4 <= pr_i <= 4.0):
            _fail(f"PR of 4 independent columns should be ≈4, got {pr_i}")
        coll = []
        for _ in range(400):
            f = rnd.gauss(0, 1)
            coll.append({c: f * (i + 1) + rnd.gauss(0, 0.01) for i, c in enumerate(cols)})
        pr_c = _pr(coll, cols)
        if not (1.0 <= pr_c <= 1.15):
            _fail(f"PR of a 1-factor (collinear) cloud should be ≈1, got {pr_c}")

        def write_tape(path, rows):
            with open(path, "w") as fh:
                for i, r in enumerate(rows):
                    fh.write(f"2026-08-14T00:{i % 60:02d}:00Z " +
                             " ".join(f"{k}={v}" for k, v in r.items()) + "\n")

        tmpd = tempfile.mkdtemp()
        keys = ["nodes", "minds_live", "minds_work", "board1h", "board_age_s", "board_posters",
                "senses", "spend1h"]

        def indep_row(rr):
            return {k: f"{rr.randint(1, 60)}" for k in keys}

        def factor_row(rr):
            f = rr.randint(1, 60)
            return {k: f"{max(1, f + rr.randint(-1, 1))}" for k in keys}

        # 2. COLLAPSE: prior half independent, recent half a single factor
        rr = random.Random(11)
        p = os.path.join(tmpd, "collapse.log")
        write_tape(p, [indep_row(rr) for _ in range(200)] + [factor_row(rr) for _ in range(200)])
        m = manifold(limit_h=400, ledger=p)
        if m["verdict"] != "MANIFOLD-COLLAPSING":
            _fail(f"a cloud collapsing onto one factor must read MANIFOLD-COLLAPSING, got {m}")
        # 3. NO-CHANGE CONTROL — and it must be a control the NULL has to work for. The obvious
        #    version (400 rows from one generator) passed even with the null deleted, because the
        #    10% relative floor alone already suppressed it: an assertion another guard already
        #    covers is not a gate. This fixture is calibrated instead (block=5, n=40, seed 41) so
        #    the halves wobble 21% APART by pure sampling noise — over the floor, inside the null.
        #    Delete the `abs(delta) > p95` test and it reads MANIFOLD-COLLAPSING.
        keep_b, MANIFOLD_BLOCK = MANIFOLD_BLOCK, 5
        rr = random.Random(41)
        p = os.path.join(tmpd, "stable.log")
        write_tape(p, [{k: str(rr.randint(1, 9)) for k in keys} for _ in range(40)])
        m = manifold(limit_h=400, ledger=p)
        MANIFOLD_BLOCK = keep_b
        if m["verdict"] != "MANIFOLD-STABLE":
            _fail(f"noise-only halves must read MANIFOLD-STABLE (the null absorbs them), got {m}")
        if abs(m["delta"]) / m["pr_prior"] < MANIFOLD_MIN_DROP:
            _fail("the no-change control no longer exercises the null (its wobble is under the "
                  f"relative floor: rel={abs(m['delta']) / m['pr_prior']:.3f})")
        # 4. column admission: a constant column is dropped BY NAME; a single missing sample does
        #    NOT cost the column (it costs that one row) — the 100%-parse rule was too brittle live
        rr = random.Random(13)
        rows = [indep_row(rr) for _ in range(400)]
        for r in rows:
            r["minds_work"] = "3"                      # constant
        rows[5]["senses"] = "UNKNOWN"                  # one honest-fusion UNKNOWN
        p = os.path.join(tmpd, "cols.log")
        write_tape(p, rows)
        m = manifold(limit_h=400, ledger=p)
        if not any(d.startswith("minds_work(constant") for d in m["dropped"]):
            _fail(f"a constant column must be dropped by name, got dropped={m['dropped']}")
        if "senses" not in m["cols"]:
            _fail(f"one UNKNOWN sample must not cost the whole column: dropped={m['dropped']}")
        if m["rows"] != m["rows_seen"] - 1:
            _fail(f"exactly the one incomplete row should be dropped: {m['rows']} of {m['rows_seen']}")
        # 5. INSUFFICIENT floors: too few rows, and too few varying columns
        p = os.path.join(tmpd, "short.log")
        write_tape(p, [indep_row(rr) for _ in range(20)])
        if manifold(limit_h=400, ledger=p)["verdict"] != "INSUFFICIENT":
            _fail("a tape shorter than 4 blocks must read INSUFFICIENT")
        rows = [dict.fromkeys(keys, "5") for _ in range(400)]
        for i, r in enumerate(rows):
            r["nodes"] = str(i % 7)                    # only ONE varying column
        p = os.path.join(tmpd, "flat.log")
        write_tape(p, rows)
        m = manifold(limit_h=400, ledger=p)
        if m["verdict"] != "INSUFFICIENT" or m["k"] >= 3:
            _fail(f"fewer than 3 varying columns must read INSUFFICIENT, got {m}")
        shutil.rmtree(tmpd, ignore_errors=True)
    finally:
        MANIFOLD_BLOCK, MANIFOLD_PERMS = keep_block, keep_perms


# ── MANIFOLD DIMENSIONALITY (--manifold, REPORT-ONLY) ────────────────────────────────────────────
# LITERATURE (homeostasis/allostasis — live review 2026-08-14): Kuheli Biswas, Hanna Salman & Naama
# Brenner, *Emergent Homeostasis and Degeneracy From Multi-Dimensional Attractors*, **BioEssays 48(3),
# 2026, doi:10.1002/bies.70116** (abstract read verbatim via the Europe PMC API — Wiley returns 402 and
# the bioRxiv preprint 2025.05.07.652484 returns 403 from this egress). The claim, in their words:
# homeostasis "emerges spontaneously from high-dimensional interactions, creating limiting manifolds in
# phase space… These multi-dimensional attractor manifolds can constrain many components collectively,
# eliminating the need for explicit control of individual variables. The presence of NULL DIRECTIONS on
# a manifold allows for DEGENERATE STATES that can add flexibility while preserving functionality…
# control circuit models can be seen as LOW-DIMENSIONAL PROJECTIONS of a more complex, multi-dimensional
# system." So the measurable is not "each variable near its set point" but the DIMENSIONAL STRUCTURE of
# the state cloud: how many directions carry variation, and whether that number is shrinking.
#
# THE GAP IT NAMES (checked across the homeostasis axes the mesh already has): every one of them is
# either PER-VARIABLE — mesh-algedonic's allostatic_load (rolling mean of the fused scalar), csd
# (variance + lag-1 AC), constrained_disorder (per-axis variability collapse), mesh-stress's reactive
# scope — or POINT-vs-CLOUD: joint_dysregulation's Mahalanobis Dᴹ. None reports the SHAPE of the cloud.
# And Dᴹ is the sharp case: it WHITENS by the window's own covariance, so it presupposes the very
# structure it never reports — if the cloud collapses from six free directions onto two, Σ is simply
# re-estimated on the collapsed cloud and Dᴹ stays comfortably small. **A self-calibrating distance is
# blind to the collapse of the space it calibrates against.** Losing null directions is exactly the loss
# of the degenerate flexibility the paper says preserves function; nothing here could see it.
#
# WHAT IS MEASURED: the PARTICIPATION RATIO of the ledger's own numeric columns —
#     PR = (Σλ)² / Σλ² = trace(R)² / ‖R‖_F² = k² / Σ_ij R_ij²   (R = correlation matrix, trace R = k)
# an eigenvalue-free identity for symmetric R, so it needs no numpy (there is none in the system python
# on this node) and no eigendecomposition. PR ∈ [1, k]: k = the columns vary independently (k free
# directions); 1 = every column is a projection of ONE underlying factor (all null directions gone).
# `occupancy` = PR/k. The verdict compares the PRIOR half of the window against the RECENT half against
# a BLOCK-PERMUTATION null (which rows land in which half is re-drawn in contiguous blocks, preserving
# the tape's autocorrelation — an i.i.d. shuffle would make the null too tight and manufacture drops).
# REPORT-ONLY: it posts nothing, gates nothing, and feeds no state. A collapse here is a claim about the
# mesh's measured variety, and the honest first move is to measure it for a while before acting on it.
MANIFOLD_COLS = [  # (ledger key, column label) — numeric lead via _num ('6/18' → 6)
    ("nodes", "nodes"), ("minds_live", "minds_live"), ("minds_work", "minds_work"),
    ("board1h", "board1h"), ("board_age_s", "board_age"), ("board_posters", "posters"),
    ("senses", "senses"), ("spend1h", "spend1h"),
]
MANIFOLD_H = float(os.environ.get("MESH_WITNESS_MANIFOLD_H", 24))
MANIFOLD_BLOCK = int(os.environ.get("MESH_WITNESS_MANIFOLD_BLOCK", 30))   # ~1h at the 2-min cadence
MANIFOLD_PERMS = int(os.environ.get("MESH_WITNESS_MANIFOLD_PERMS", 100))
MANIFOLD_MIN_DROP = float(os.environ.get("MESH_WITNESS_MANIFOLD_MIN_DROP", 0.10))  # relative floor
MANIFOLD_MIN_PARSE = float(os.environ.get("MESH_WITNESS_MANIFOLD_MIN_PARSE", 0.98))  # column admission


def _pr(rows, cols):
    """Participation ratio of the columns' CORRELATION matrix. rows = list of dicts col->float.

    Returns None when any column has zero variance in this slice (correlation undefined — the caller
    drops such columns up front; this is the second line of defence, never a silent 0)."""
    n = len(rows)
    if n < 2 or len(cols) < 2:
        return None
    means = {c: sum(r[c] for r in rows) / n for c in cols}
    sds = {}
    for c in cols:
        var = sum((r[c] - means[c]) ** 2 for r in rows) / (n - 1)
        if var <= 0:
            return None
        sds[c] = var ** 0.5
    k = len(cols)
    ssq = 0.0
    for i, ci in enumerate(cols):
        for cj in cols[i:]:
            cov = sum((r[ci] - means[ci]) * (r[cj] - means[cj]) for r in rows) / (n - 1)
            rij = cov / (sds[ci] * sds[cj])
            rij = max(-1.0, min(1.0, rij))
            ssq += rij * rij if ci == cj else 2 * rij * rij
    return (k * k) / ssq if ssq > 0 else None


def _block_split(n, half, block, rnd):
    """Re-draw WHICH rows form the 'prior' half, in contiguous blocks of `block` rows, preserving the
    tape's local autocorrelation. Returns a set of row indices assigned to the first half."""
    idx = list(range(0, n, block))
    rnd.shuffle(idx)
    first, taken = set(), 0
    for start in idx:
        if taken >= half:
            break
        blk = range(start, min(start + block, n))
        first.update(blk)
        taken += len(blk)
    return first


def manifold(limit_h=None, ledger=None):
    """Return the manifold-dimensionality reading as a dict (pure enough for --test to drive)."""
    import random
    limit_h = MANIFOLD_H if limit_h is None else limit_h
    path = ledger or LEDGER
    want = max(4 * MANIFOLD_BLOCK, int(limit_h * 30))
    try:
        with open(path) as f:
            lines = f.read().splitlines()[-want:]
    except OSError:
        return {"verdict": "n/a", "reason": "ledger unreadable"}
    parsed = [_parse_row(l) for l in lines]
    parsed = [p for p in parsed if p]
    # column admission: a column must parse on EVERY retained row and actually vary. A dropped column
    # is NAMED with its reason — a silently-dropped column would change k, and k IS the scale of PR.
    # A column is admitted if it parses on at least MANIFOLD_MIN_PARSE of the rows; the few rows that
    # miss an ADMITTED column are then dropped whole, keeping the matrix rectangular. (Requiring 100%
    # was the first version and it was too brittle in exactly the way that matters: ONE row carrying
    # `senses=UNKNOWN` in 5000 — a single honest-fusion UNKNOWN — blinded the whole senses axis for
    # every window containing it, i.e. one missing sample cost a dimension.)
    dropped, keep, raw = [], [], {}
    n_all = len(parsed)
    for key, label in MANIFOLD_COLS:
        vals = [_num(p.get(key)) for p in parsed]
        ok = [v for v in vals if v is not None]
        if n_all == 0 or len(ok) < MANIFOLD_MIN_PARSE * n_all:
            dropped.append(f"{label}(unparsed {n_all - len(ok)}/{n_all})")
            continue
        if len(set(ok)) < 2:
            dropped.append(f"{label}(constant)")
            continue
        keep.append(label)
        raw[label] = vals
    rows = []
    for j in range(n_all):
        rec = {c: raw[c][j] for c in keep}
        if any(v is None for v in rec.values()):
            continue                      # a row missing an admitted column is dropped whole
        rows.append({c: float(v) for c, v in rec.items()})
    n = len(rows)
    out = {"rows": n, "rows_seen": n_all, "k": len(keep), "cols": keep, "dropped": dropped,
           "window_h": limit_h}
    if len(keep) < 3 or n < 4 * MANIFOLD_BLOCK:
        out["verdict"] = "INSUFFICIENT"
        out["reason"] = (f"k={len(keep)} (<3 varying columns)" if len(keep) < 3
                         else f"{n} rows (<{4 * MANIFOLD_BLOCK})")
        return out
    pr_all = _pr(rows, keep)
    half = n // 2
    pr_prior, pr_recent = _pr(rows[:half], keep), _pr(rows[half:], keep)
    if pr_all is None or pr_prior is None or pr_recent is None:
        out["verdict"] = "INSUFFICIENT"
        out["reason"] = "a column is constant within one half (correlation undefined there)"
        return out
    delta = pr_recent - pr_prior
    rnd = random.Random(20260814)          # fixed seed: the verdict must not flap between two reads
    null = []
    for _ in range(MANIFOLD_PERMS):
        first = _block_split(n, half, MANIFOLD_BLOCK, rnd)
        a = [rows[i] for i in range(n) if i in first]
        b = [rows[i] for i in range(n) if i not in first]
        pa, pb = _pr(a, keep), _pr(b, keep)
        if pa is not None and pb is not None:
            null.append(abs(pb - pa))
    null.sort()
    p95 = null[int(0.95 * (len(null) - 1))] if null else None
    out.update({"pr": pr_all, "occupancy": pr_all / len(keep), "pr_prior": pr_prior,
                "pr_recent": pr_recent, "delta": delta, "null_p95": p95, "perms": len(null)})
    rel = abs(delta) / pr_prior if pr_prior else 0.0
    if p95 is None:
        out["verdict"] = "INSUFFICIENT"; out["reason"] = "null could not be built"
    elif abs(delta) > p95 and rel >= MANIFOLD_MIN_DROP:
        out["verdict"] = "MANIFOLD-COLLAPSING" if delta < 0 else "MANIFOLD-OPENING"
    else:
        out["verdict"] = "MANIFOLD-STABLE"
    return out


def render_manifold(m):
    if m.get("verdict") in ("n/a", "INSUFFICIENT"):
        return (f"manifold: {m['verdict']} ({m.get('reason', '')}) "
                f"k={m.get('k', '?')} rows={m.get('rows', '?')}"
                + (f" dropped={','.join(m['dropped'])}" if m.get("dropped") else ""))
    return (f"manifold: {m['verdict']} k={m['k']} PR={m['pr']:.2f} occupancy={m['occupancy']:.2f} "
            f"(prior {m['pr_prior']:.2f} → recent {m['pr_recent']:.2f}, Δ={m['delta']:+.2f}, "
            f"null p95 {m['null_p95']:.2f} over {m['perms']} block-perms) "
            f"rows={m['rows']}/{m['window_h']:g}h cols={','.join(m['cols'])}"
            + (f" dropped={','.join(m['dropped'])}" if m.get("dropped") else ""))


def main():
    args = sys.argv[1:]
    if "--test" in args:
        smoke_test()
    elif "--manifold" in args:
        hrs = None
        for a in args:
            try:
                hrs = float(a)
                break
            except ValueError:
                continue
        m = manifold(hrs)
        print(json.dumps(m, indent=2) if "--json" in args else render_manifold(m))
        sys.exit(0 if m.get("verdict") not in ("n/a",) else 2)
    elif "--measure" in args:
        do_measure()
    elif "--json" in args:
        print(json.dumps(measure(), indent=2))
    else:  # default + --pane : cheap render ( + --embed = the tape half of a fused dash )
        print(render_pane(embed=("--embed" in args)))


if __name__ == "__main__":
    main()
