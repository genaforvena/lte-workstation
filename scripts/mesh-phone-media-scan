#!/usr/bin/env bash
# mesh-phone-media-scan — request MediaStore indexing for one real Redmi media path.
#
# This is an on-demand consumer of the driven `termux-media-scan` edge discovered on the
# Redmi. It is deliberately not a cached sensor: every successful result is the output of
# a fresh SSH command against the supplied path.
#
#   mesh-phone-media-scan <path>         scan one path and print the scan result
#   mesh-phone-media-scan --test         pure dependency checks plus a live real-path scan
#
# Exit codes: 0 = SSH accepted and scan returned non-empty output; 1 = bad local request or
# missing dependency; 2 = phone transport/remote scan unavailable (UNKNOWN, never success).
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

PHONE_PORT="${PHONE_SSH_PORT:-8022}"
PHONE_USER="${PHONE_USER:-u0_a380}"
DEFAULT_PATH="${MESH_MEDIA_SCAN_PATH:-/sdcard/TermuxAudioRecording_2026-06-04_17-31-44.m4a}"

usage() {
  echo "usage: $0 [--test|--help] [PATH]" >&2
}

if [ "${1:-}" = --help ]; then
  usage
  exit 0
fi

path="${1:-$DEFAULT_PATH}"
if [ "${1:-}" = --test ]; then
  path="${MESH_MEDIA_SCAN_TEST_PATH:-$DEFAULT_PATH}"
fi
case "$path" in
  /*) ;;
  *) echo "phone-media-scan: path must be absolute: $path" >&2; exit 1 ;;
esac

if [ "${1:-}" = --test ]; then
  command -v ssh >/dev/null 2>&1 || { echo 'smoke-test: FAIL (no ssh)'; exit 1; }
  command -v mesh-phone-ip >/dev/null 2>&1 || { echo 'smoke-test: FAIL (no mesh-phone-ip)'; exit 1; }
fi

ip=""
if command -v mesh-phone-ip >/dev/null 2>&1; then
  ip="$(timeout 12 mesh-phone-ip 2>/dev/null)" || ip=""
fi
if [ -z "$ip" ]; then
  echo "[phone-media-scan] UNKNOWN path=$path why=transport-unreachable" >&2
  [ "${1:-}" = --test ] && echo 'smoke-test: n/a (Redmi unreachable — no live media scan)' >&2
  exit 2
fi

# Quote the path for the remote shell. The path is intentionally passed as one command argument
# after quoting; no local shell interpolation can turn a path into a second remote command.
remote_quote() {
  printf "'%s'" "${1//\'/\'\\\'\'}"
}
remote_path="$(remote_quote "$path")"
result=""
rc=0
result="$(timeout 25 ssh -p "$PHONE_PORT" -o BatchMode=yes -o ConnectTimeout=6 \
  -o StrictHostKeyChecking=accept-new "${PHONE_USER}@${ip}" \
  "termux-media-scan $remote_path" </dev/null 2>/dev/null)" || rc=$?

if [ "$rc" -ne 0 ]; then
  echo "[phone-media-scan] UNKNOWN path=$path why=transport-or-remote-failure rc=$rc" >&2
  [ "${1:-}" = --test ] && echo "smoke-test: n/a (scan unavailable rc=$rc)" >&2
  exit 2
fi
if [ -z "$result" ]; then
  echo "[phone-media-scan] UNKNOWN path=$path why=empty-scan-result" >&2
  [ "${1:-}" = --test ] && echo 'smoke-test: FAIL (reachable Redmi returned empty scan result)' >&2
  exit 2
fi

printf '[phone-media-scan] path=%s\n%s\n' "$path" "$result"
if [ "${1:-}" = --test ]; then
  echo 'smoke-test: ok (live termux-media-scan returned a non-empty result)' >&2
fi
