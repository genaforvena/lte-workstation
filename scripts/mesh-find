#!/usr/bin/env bash
# mesh-find — locate a BLE device across the mesh
# smoke-test: --test checks mesh-presence reachable
# Scans on every BLE-capable node, compares RSSI to find the closest.
# Query by name substring or MAC prefix.
#
#   mesh-find <query>
#   mesh-find --test
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
PEER_USER="${MESH_PEER_USER:-imozerov}"
# BLE peer resolution — the peer MUST be a BLE-capable node. NOT MESH_PEER: that resolves to the
# router (no BLE radio), so a MESH_PEER peer silently yields an empty scan and mesh-find then reports
# every device "only seen by <self>" / "<router>: not seen" — a HOLLOW cross-mesh find that lies it
# is working. Mirror mesh-presence-fuse (its line 38 documents the same gotcha): resolve a BLE node
# by label via mesh-peer-addr, with explicit overrides; never fall back to the router's MESH_PEER.
PEER_HOST="${MESH_PEER_DS:-${MESH_FIND_PEER:-${MESH_FUSE_PEER:-$(mesh-peer-addr "${MESH_FIND_LABEL:-${MESH_FUSE_LABEL:-default-string}}" 2>/dev/null || true)}}}"
# Router/empty guard (honest-fusion: an unreachable/wrong input renders UNAVAILABLE, never a faked
# all-clear). If the peer resolved to the router or to nothing, degrade to a LABELLED self-only scan
# instead of pretending a BLE-less node is a blind BLE peer.
_rts="${MESH_ROUTER_TS_IP:-}"; _rlan="${MESH_ROUTER_LAN_IP:-192.168.8.1}"
PEER_NO_BLE=""
case "$PEER_HOST" in
  ""|"$_rts"|"$_rlan")
    PEER_NO_BLE="${PEER_HOST:-<unset>}"
    PEER_HOST=""
    ;;
esac
# fast-fail SSH so a DOWN peer degrades to a self-only scan instead of hanging for minutes
SSH_OPTS="-o ConnectTimeout=5 -o BatchMode=yes -o StrictHostKeyChecking=accept-new"
run_search() {
  local self_txt="$1" peer_txt="$2" self_name="$3" peer_name="$4" query="$5"
  declare -A ip_rssi ip_name ds_rssi ds_name all_macs

  while IFS='|' read -r rssi mac name; do
    [ -z "$mac" ] && continue
    ip_rssi["$mac"]="$rssi"
    ip_name["$mac"]="$name"
  done < "$self_txt"

  while IFS='|' read -r rssi mac name; do
    [ -z "$mac" ] && continue
    ds_rssi["$mac"]="$rssi"
    ds_name["$mac"]="$name"
  done < "$peer_txt"

  for mac in "${!ip_rssi[@]}"; do all_macs["$mac"]=1; done
  for mac in "${!ds_rssi[@]}"; do all_macs["$mac"]=1; done

  Q_LC="$(printf '%s' "$query" | tr '[:upper:]' '[:lower:]')"
  matches=0
  for mac in "${!all_macs[@]}"; do
    mac_lc="$(printf '%s' "$mac" | tr '[:upper:]' '[:lower:]')"
    name="${ip_name[$mac]:-${ds_name[$mac]:-?}}"
    name_lc="$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]')"

    match=0
    case "$name_lc" in *"$Q_LC"*) match=1;; esac
    case "$mac_lc" in *"$Q_LC"*) match=1;; esac
    [ "$match" -eq 0 ] && continue

    matches=$((matches + 1))
    ipr="${ip_rssi[$mac]:-}"; dsr="${ds_rssi[$mac]:-}"

    echo "---"
    echo "  device:  $name"
    echo "  mac:     $mac"
    [ -n "$ipr" ] && echo "  $self_name:     RSSI=$ipr" || echo "  $self_name:     not seen"
    [ -n "$dsr" ] && echo "  $peer_name: RSSI=$dsr" || echo "  $peer_name: not seen"

    if [ -n "$ipr" ] && [ -n "$dsr" ]; then
      if [ "$ipr" -gt "$dsr" ]; then
        echo "  → closest: $self_name (RSSI $ipr vs $dsr)"
        echo "  $name: strongest near $self_name ($ipr)"
      else
        echo "  → closest: $peer_name (RSSI $dsr vs $ipr)"
        echo "  $name: strongest near $peer_name ($dsr)"
      fi
    elif [ -n "$ipr" ]; then
      echo "  → only seen by $self_name (RSSI $ipr)"
      echo "  $name: only on $self_name ($ipr)"
    elif [ -n "$dsr" ]; then
      echo "  → only seen by $peer_name (RSSI $dsr)"
      echo "  $name: only on $peer_name ($dsr)"
    fi
  done

  [ "$matches" -eq 0 ] && echo "  No device matching '$query' found on any BLE node."
  echo ""; echo "=== done ==="
}

if [ "${1:-}" = --test ]; then
  command -v mesh-presence >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-presence)"; exit 1; }
  command -v ssh >/dev/null 2>&1 || { echo "smoke-test: FAIL (no ssh)"; exit 1; }
  command -v mktemp >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mktemp)"; exit 1; }
  command -v grep >/dev/null 2>&1 || { echo "smoke-test: FAIL (no grep)"; exit 1; }
  command -v tr >/dev/null 2>&1 || { echo "smoke-test: FAIL (no tr)"; exit 1; }
  [ -n "$PEER_HOST" ] || { echo "smoke-test: FAIL (no BLE peer resolved — MESH_FIND_PEER/MESH_FUSE_LABEL unset and mesh-peer-addr failed; would be self-only)"; exit 1; }
  mesh-presence --test >/dev/null 2>&1 || { echo "smoke-test: FAIL (mesh-presence --test failed)"; exit 1; }
  tmp="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp failed)"; exit 1; }
  trap 'rm -rf "$tmp"' EXIT
  cat > "$tmp/self.txt" <<'EOF'
-42|aa:bb:cc:dd:ee:ff|Bose
EOF
  cat > "$tmp/peer.txt" <<'EOF'
-65|aa:bb:cc:dd:ee:ff|Bose
EOF
  out="$(run_search "$tmp/self.txt" "$tmp/peer.txt" test-self test-peer Bose)"
  printf '%s\n' "$out" | grep -q 'strongest near test-self' || { echo "smoke-test: FAIL (parser/search bad: $out)"; exit 1; }
  echo "smoke-test: ok"; exit 0
fi
Q="${1:-}"; [ -z "$Q" ] && { echo "usage: mesh-find <name|mac>"; exit 1; }
Q_LC="$(printf '%s' "$Q" | tr '[:upper:]' '[:lower:]')"

SELF="$(hostname)"

echo "=== mesh-find @ $(date -u +%Y-%m-%dT%H:%M:%SZ) — query: $Q ==="
if [ -z "$PEER_HOST" ]; then
  # Honest self-only degrade (no BLE peer) — do NOT pretend the router is a blind BLE node.
  echo "  NOTE: no BLE peer (resolved='${PEER_NO_BLE:-<unset>}' — the router has no BLE radio)."
  echo "        Cross-mesh locate UNAVAILABLE — scanning THIS node ($SELF) only."
  echo "        Set MESH_FIND_PEER or MESH_FIND_LABEL to a BLE-capable node for cross-mesh find."
  PEER_NAME="(no BLE peer)"
else
  PEER_NAME="$(ssh $SSH_OPTS "${PEER_USER}@${PEER_HOST}" 'hostname' 2>/dev/null || echo "$PEER_HOST")"
fi
echo ""

# Scan to temp files (robust against process substitution quirks)
TMPDIR="$(mktemp -d)"
trap "rm -rf '$TMPDIR'" EXIT

mesh-presence 10 2>/dev/null | grep -E '^-?[0-9]+\|' > "$TMPDIR/self.txt" || true
: > "$TMPDIR/peer.txt"   # always exists for run_search; filled only when a BLE peer is set
[ -n "$PEER_HOST" ] && ssh $SSH_OPTS "${PEER_USER}@${PEER_HOST}" "\$HOME/.local/bin/mesh-presence 10" 2>/dev/null | grep -E '^-?[0-9]+\|' > "$TMPDIR/peer.txt" || true

run_search "$TMPDIR/self.txt" "$TMPDIR/peer.txt" "$SELF" "$PEER_NAME" "$Q"
