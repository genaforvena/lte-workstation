#!/usr/bin/env bash
# reflex-cadence: */10 * * * *
# reflex-args: --edge
# mesh-vram-watch — the whole-GPU pressure sense for the RTX 3060 (the mesh's SOLE local-inference organ).
# ONE nvidia-smi read, FIVE silent-degrade axes that no other tool watches:
#
#   (A) VRAM pressure   memory.used/total — ollama (moondream, qwen2.5:3b, qwen3.5:0.8b), gigaam +
#                       resemblyzer (venv-ai), moondream vision all contend for 12GB. Nothing watched free VRAM.
#   (B) COMPUTE THROTTLE clocks_event_reasons.active bitmask — a POWER-CAP / THERMAL / VOLTAGE clamp keeps
#                       the GPU "100% GPU" (no spill) at REDUCED clocks → inference silently slows, no alarm.
#   (C) SPILL           ollama ps PROCESSOR column flipping "100% GPU" → any "% CPU" — a warm model fell to
#                       CPU (huge slowdown, still "green"). The gigaam-warm-daemon-degrades failure family.
#   (D) TEMPERATURE     temperature.gpu — a GRADUATED axis that warns on the RAMP toward the ~83C thermal
#                       slowdown and the ~93C hard shutdown, BEFORE the (B) throttle bits ever trip. The
#                       throttle bitmask only speaks once HwThermalSlowdown (0x40) is ALREADY clamping the
#                       clocks; a stuck fan / dust-choked heatsink climbs there silently first. sysfs hwmon
#                       has NO nvidia chip on this node (hwmon0/1=nvme, hwmon2=k10temp) so the zone-scanner
#                       is structurally blind to it — health-verified 2026-07-17: fan-seize was silent-green
#                       to a 98C shutdown on the mind node, nvidia-smi being the ONLY reader of GPU temp.
#   (E) PCIe LINK       pcie.link.{gen,width}.{current,max} — the NEGOTIATED host↔device link geometry. A
#                       card can cleanly renegotiate to a lower gen/width (marginal slot/riser, power event,
#                       BIOS/ASPM change) with ZERO AER errors: the link is stable, just slow, and inference
#                       PCIe bandwidth collapses (Gen4→Gen1 ≈ 8×, x16→x4 = 4×). mesh-pcie-health reads only
#                       the AER error COUNTERS (a rising error RATE) — orthogonal to link geometry, blind to
#                       a clean downshift. No tool read link gen/width. TRAP: gen power-manages DOWN at idle
#                       (ASPM Gen1-idle→Gen4-load is NORMAL) so gen.current<max is keyed ONLY while util>0;
#                       WIDTH does not power-gate — x16→x8/x4 is a REAL fault, keyed always. Discover brief
#                       (health-verified): ~/.mesh/knowledge/capability-gpu-pcie-link-downshift-unsensed-20260717.md
#
# Why new (grep receipt, 2026-07-17): the only tools that touch nvidia-smi read the WRONG field —
# mesh-model-watch:220 reads memory.TOTAL (static sizing) only; mesh-therm:28 names GPU as a COMMENT-only
# known gap; mesh-gpu-activity is the INTEL iGPU (i915 RC6), different silicon. No tool reads used/free,
# the throttle bitmask, or the clock ratio. Discover briefs (health-verified):
#   ~/.mesh/knowledge/capability-dgpu-vram-pressure-unsensed-20260717.md
#   ~/.mesh/knowledge/capability-dgpu-compute-throttle-unsensed-20260717.md
#
# THE CRY-WOLF TRAP THE BRIEFS' NAIVE RULE WALKS INTO (measured live, driver 595.71.05, this card):
#   at TRUE IDLE the bitmask is 0x1 (GpuIdle) NOT 0x0, and the clock ratio is 330/2160 = 15%. So
#   "alarm on any non-0x0 bitmask" fires EVERY idle read, and "warn on ratio < 0.7" fires at every idle
#   downclock. Both are benign. The bitmask carries BENIGN reasons (GpuIdle 0x1, AppClocksSetting 0x2,
#   SyncBoost 0x10, DisplayClockSetting 0x100) that must be MASKED OUT, and the clock-clamp warn MUST be
#   gated on util>50% (a low clock while idle is expected, not a throttle). We alarm only on the BAD bits
#   — SwPowerCap 0x4, HwSlowdown 0x8, SwThermalSlowdown 0x20, HwThermalSlowdown 0x40, HwPowerBrake 0x80.
#   (NB: the filing task's "0x8 = SW_POWER_CAP" mislabels the bit — per NVML 0x8 is HwSlowdown, 0x4 is
#   SwPowerCap; this tool names bits from the NVML definitions, not the task's shorthand.)
#
# Honest contract: no nvidia-smi / unparseable query → exit 2, NEVER a fabricated free% or a green throttle.
# ollama absent → spill axis is UNKNOWN (honest partial), never a fabricated "100% GPU" pass; the VRAM and
# throttle axes still report from nvidia-smi alone.
#
#   mesh-vram-watch          one read → one classified line (aggregate = worst axis)
#   mesh-vram-watch --json   machine-readable
#   mesh-vram-watch --edge   emit only on band change (state still refreshed every success)
#   mesh-vram-watch --test   fixture-backed classifier (RED-first) + real-read gate
#
# UNREACHABLE is a CONDITION, not an event (see offline_announce below): an INSTALLED-but-dead GPU
# re-announces on a backoff with the outage duration and posts [gpu-down] to the board; an ABSENT
# dGPU says so once and stays quiet. MESH_VRAM_OFFLINE_RENOTIFY_S tunes the backoff (default 3600).
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

MESH="${MESH_DIR:-$HOME/.mesh}"
STATE="$MESH/.vram-watch.state"
OFFLINEFILE="$MESH/.vram-watch-offline"
NVSMI="${MESH_VRAM_WATCH_NVSMI:-nvidia-smi}"
OLLAMA="${MESH_VRAM_WATCH_OLLAMA:-ollama}"
mkdir -p "$MESH" 2>/dev/null || true

# thresholds (env-overridable for tuning)
VRAM_CRIT_PCT="${MESH_VRAM_CRIT_PCT:-90}"   # used/total ≥ this → CRITICAL (about to evict / spill)
VRAM_WARN_PCT="${MESH_VRAM_WARN_PCT:-85}"   # used/total ≥ this → WARN (pressure building)
CLK_WARN_PCT="${MESH_VRAM_CLK_WARN_PCT:-70}" # clocks.cur/max < this% WHILE loaded → WARN (silent clamp)
UTIL_LOAD_PCT="${MESH_VRAM_UTIL_LOAD_PCT:-50}" # util ≥ this = "under load" (gate for the clamp warn)
# GPU die temperature (°C). RTX 3060 thermal slowdown ~83C, hard shutdown ~93C — warn on the ramp,
# crit while still BELOW slowdown so a fan-seize is caught before the throttle bits (B) ever trip.
GPU_TEMP_WARN_C="${MESH_VRAM_TEMP_WARN_C:-80}"  # ≥ this → WARN (hot, fan should be ramping)
GPU_TEMP_CRIT_C="${MESH_VRAM_TEMP_CRIT_C:-88}"  # ≥ this → CRITICAL (approaching slowdown/shutdown)

# BENIGN reason bits (idle/config/sync — never a degrade): GpuIdle 0x1, AppClocksSetting 0x2,
# SyncBoost 0x10, DisplayClockSetting 0x100. Everything else in supported(0x1FF) is a real clamp.
THROTTLE_BAD_MASK=$((0x4 | 0x8 | 0x20 | 0x40 | 0x80))   # SwPowerCap|HwSlowdown|SwThermal|HwThermal|HwPowerBrake

# throttle_names <hexmask> → space-joined NVML names of the BAD bits set (empty if none)
throttle_names() {
  local m="$1" dec names=""
  case "$m" in *[!0-9a-fA-FxX]*|'') return 0 ;; esac
  dec=$(( m )) 2>/dev/null || return 0
  (( dec & 0x4 ))  && names+="SW_POWER_CAP "
  (( dec & 0x8 ))  && names+="HW_SLOWDOWN "
  (( dec & 0x20 )) && names+="SW_THERMAL_SLOWDOWN "
  (( dec & 0x40 )) && names+="HW_THERMAL_SLOWDOWN "
  (( dec & 0x80 )) && names+="HW_POWER_BRAKE "
  printf '%s' "${names% }"
}

# parse_nvsmi: reads the CSV line
#   "used, total, util, cur_clk, max_clk, active_mask, temp, gen_cur, gen_max, width_cur, width_max" on stdin,
# emits: used\ttotal\tutil\tcurclk\tmaxclk\tmask\ttemp\tgencur\tgenmax\twidthcur\twidthmax
# (exit 1 if the required numerics are absent)
parse_nvsmi() {
  awk -F',' '
    { for (i=1;i<=NF;i++){ gsub(/^[ \t]+|[ \t]+$/,"",$i) } }
    {
      used=$1; total=$2; util=$3; curclk=$4; maxclk=$5; mask=$6; temp=$7
      gencur=$8; genmax=$9; widthcur=$10; widthmax=$11
      # required numeric fields — temp AND the four link fields too: a card that cannot report its own
      # die temp / PCIe link geometry offers no thermal/link organ (exit 2 upstream), never a fabricated
      # cool reading or a fabricated Gen4-x16.
      if (used ~ /^[0-9]+$/ && total ~ /^[0-9]+$/ && total+0>0 && mask ~ /^0[xX][0-9a-fA-F]+$/ && temp ~ /^[0-9]+$/ \
          && gencur ~ /^[0-9]+$/ && genmax ~ /^[0-9]+$/ && genmax+0>0 \
          && widthcur ~ /^[0-9]+$/ && widthmax ~ /^[0-9]+$/ && widthmax+0>0) {
        printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n", used, total, util, curclk, maxclk, mask, temp, gencur, genmax, widthcur, widthmax
        found=1
      }
    }
    END { if (!found) exit 1 }
  '
}

# spill_state: prints GPU | CPU-SPILL | UNKNOWN by reading `ollama ps`. A data row whose PROCESSOR
# field is not "100% GPU" contains the token CPU (e.g. "48%/52% CPU/GPU", "100% CPU") — model names
# are lowercase/hex and never carry an uppercase CPU token, so a data-row CPU match = a spill.
spill_state() {
  local out
  out="$("$OLLAMA" ps 2>/dev/null)" || { echo UNKNOWN; return; }
  # drop the header line (starts with NAME), keep data rows
  local data
  data="$(printf '%s\n' "$out" | awk 'NR>1 && NF>0')"
  [ -n "$data" ] || { echo GPU; return; }   # nothing resident = nothing spilled
  if printf '%s\n' "$data" | grep -q 'CPU'; then echo CPU-SPILL; else echo GPU; fi
}

sev_rank() { case "$1" in CRITICAL) echo 3 ;; WARN) echo 2 ;; UNKNOWN) echo 1 ;; *) echo 0 ;; esac; }

# classify_all: given the parsed axes + spill, prints "LABEL|reason" for the WORST axis.
classify_all() {
  local used="$1" total="$2" util="$3" curclk="$4" maxclk="$5" mask="$6" spill="$7" temp="$8"
  local gencur="${9:-}" genmax="${10:-}" widthcur="${11:-}" widthmax="${12:-}"
  local best_rank=0 best_label=HEALTHY best_reason="ok"
  consider() { # $1=label $2=reason
    local r; r="$(sev_rank "$1")"
    if [ "$r" -gt "$best_rank" ]; then best_rank="$r"; best_label="$1"; best_reason="$2"; fi
  }

  # (B) throttle bitmask — the BAD bits only
  local dec=0; dec=$(( mask )) 2>/dev/null || dec=0
  if (( dec & THROTTLE_BAD_MASK )); then
    consider CRITICAL "throttle=$(throttle_names "$mask") (mask=$mask, clocks clamped)"
  fi

  # (A) VRAM pressure
  local pct=$(( used * 100 / total ))
  if   [ "$pct" -ge "$VRAM_CRIT_PCT" ]; then consider CRITICAL "vram ${used}/${total}MiB (${pct}%≥${VRAM_CRIT_PCT}%)"
  elif [ "$pct" -ge "$VRAM_WARN_PCT" ]; then consider WARN "vram ${used}/${total}MiB (${pct}%≥${VRAM_WARN_PCT}%)"
  fi

  # (C) spill — a warm model fell to CPU
  case "$spill" in
    CPU-SPILL) consider CRITICAL "ollama SPILL — a model on CPU (silent slowdown)" ;;
    UNKNOWN)   consider UNKNOWN  "spill unknown (ollama unreadable)" ;;
  esac

  # (D) die temperature — graduated, catches a fan-seize ramp BEFORE the throttle bits (B) trip
  if [[ "$temp" =~ ^[0-9]+$ ]]; then
    if   [ "$temp" -ge "$GPU_TEMP_CRIT_C" ]; then consider CRITICAL "gpu ${temp}C (≥${GPU_TEMP_CRIT_C}C — approaching thermal slowdown/shutdown)"
    elif [ "$temp" -ge "$GPU_TEMP_WARN_C" ]; then consider WARN "gpu ${temp}C (≥${GPU_TEMP_WARN_C}C — hot, check fan/airflow)"
    fi
  fi

  # (E) PCIe link geometry — a clean downshift no AER counter can see.
  #   WIDTH does not power-gate: width.current < width.max is ALWAYS a real fault (seating/riser/lane loss).
  #   GEN power-manages down at idle (ASPM): gen.current < gen.max fires ONLY while util>0 (downshift under load).
  if [[ "$widthcur" =~ ^[0-9]+$ && "$widthmax" =~ ^[0-9]+$ ]] && [ "$widthmax" -gt 0 ]; then
    if [ "$widthcur" -lt "$widthmax" ]; then
      consider CRITICAL "pcie width x${widthcur}<x${widthmax} (link downshift — ~$(( widthmax / (widthcur>0?widthcur:1) ))x bw loss, seating/riser?)"
    fi
  fi
  if [[ "$gencur" =~ ^[0-9]+$ && "$genmax" =~ ^[0-9]+$ && "$util" =~ ^[0-9]+$ ]] && [ "$genmax" -gt 0 ]; then
    if [ "$gencur" -lt "$genmax" ] && [ "$util" -gt 0 ]; then
      consider WARN "pcie gen${gencur}<gen${genmax} under load (util=${util}% — link degraded, not idle ASPM)"
    fi
  fi

  # (B') clock clamp UNDER LOAD (util-gated so an idle downclock never fires)
  if [ "${util}" -eq "${util}" ] 2>/dev/null && [ "${maxclk:-0}" -gt 0 ] 2>/dev/null; then
    local ratio=$(( curclk * 100 / maxclk ))
    if [ "$util" -ge "$UTIL_LOAD_PCT" ] && [ "$ratio" -lt "$CLK_WARN_PCT" ]; then
      consider WARN "clock clamped ${curclk}/${maxclk}MHz (${ratio}%<${CLK_WARN_PCT}%) at util=${util}%"
    fi
  fi

  printf '%s|%s\n' "$best_label" "$best_reason"
}

# ---- the organ being DOWN is a CONDITION, not an EVENT ---------------------
# 2026-08-14: the node rebooted into kernel 6.8.0-137 and the nvidia module never loaded. The
# one-shot sentinel below announced ONCE at 12:50Z and the next 43 ticks emitted NOTHING, while
# ollama ran every vision/STT/wake-gate call on CPU for 7h08m. A latch that turns an ongoing
# outage into a single line is the deauth-is-an-event-a-wedge-is-a-condition shape.
#
# Two causes the old code collapsed into one silence, separated here:
#   ABSENT  no nvidia-smi at all → this node simply has no dGPU. Say it ONCE, then stay quiet
#           forever; a per-tick line about a card that was never here is pure noise.
#   DOWN    nvidia-smi is INSTALLED but its query fails → the organ EXISTS and is broken. That is
#           an ongoing incident: re-announce on a backoff and post it to the board, because the
#           cost (all local inference silently on CPU) accrues every minute it holds.
#
# And it must be DATABLE. `.vram-watch.state` cannot date the outage — it is only written on a
# SUCCESSFUL read, so during a real outage its mtime is frozen at the last healthy tick (that is
# honest blindness, not a bug; do NOT touch it here or the freshness would be forged). The
# sentinel is the one artifact that exists across the whole outage, so it carries `since` in its
# own content, falling back to its own mtime for a sentinel written by the pre-fix code.
OFFLINE_RENOTIFY_S="${MESH_VRAM_OFFLINE_RENOTIFY_S:-3600}"   # DOWN re-announce backoff (ABSENT never repeats)

_dur() { # seconds → compact human duration
  local s="${1:-0}"
  if   [ "$s" -ge 3600 ]; then printf '%dh%02dm' $(( s / 3600 )) $(( (s % 3600) / 60 ))
  elif [ "$s" -ge 60   ]; then printf '%dm' $(( s / 60 ))
  else printf '%ds' "$s"; fi
}

offline_announce() { # $1=ABSENT|DOWN  $2=what the read said
  local kind="$1" what="$2"
  local now since kind_prev last down say=0 line
  now="$(date +%s)"
  since=""; kind_prev=""; last=""
  [ -f "$OFFLINEFILE" ] && read -r since kind_prev last < "$OFFLINEFILE" 2>/dev/null
  # a sentinel from the pre-fix code is EMPTY — recover the start from its own mtime, never "now"
  case "$since" in ''|*[!0-9]*) since="$(stat -c %Y "$OFFLINEFILE" 2>/dev/null || echo "$now")" ;; esac
  case "$last"  in ''|*[!0-9]*) last=0 ;; esac
  [ "$kind_prev" = "$kind" ] || last=0        # cause changed → speak the new one
  down=$(( now - since ))
  if   [ "$last" -eq 0 ]; then say=1                                                    # first sighting
  elif [ "$kind" = DOWN ] && [ $(( now - last )) -ge "$OFFLINE_RENOTIFY_S" ]; then say=1 # still down
  fi
  [ "$say" = 1 ] && last="$now"
  printf '%s %s %s\n' "$since" "$kind" "$last" > "$OFFLINEFILE"
  [ "$say" = 1 ] || return 0

  if [ "$kind" = DOWN ]; then
    line="vram-watch: GPU DOWN — $what — down=$(_dur "$down") since $(date -u -d "@$since" +%Y-%m-%dT%H:%M:%SZ). The dGPU organ is INSTALLED, so this is an OUTAGE, not an absence: local inference (ollama/gigaam/vision) is running on CPU until it clears."
    echo "$line" >&2
    command -v mesh-chat >/dev/null 2>&1 &&
      MESH_WHO="vram-watch@$(hostname)" mesh-chat "[gpu-down] $line" >/dev/null 2>&1
  else
    echo "vram-watch: UNREACHABLE — $what (no dGPU organ on this node — said once, not repeated)" >&2
  fi
  return 0
}

# ---- self-test ------------------------------------------------------------
if [ "${1:-}" = --test ]; then
  fail() { echo "smoke-test: FAIL ($1)"; exit 1; }

  # helper: parse a CSV line then classify with a given spill state
  run() { # $1=csv (11 fields: …temp, gen_cur, gen_max, width_cur, width_max) $2=spill  → "LABEL|reason"
    local got
    got="$(printf '%s\n' "$1" | parse_nvsmi)" || { echo "PARSEFAIL"; return; }
    IFS=$'\t' read -r used total util curclk maxclk mask temp gencur genmax widthcur widthmax <<<"$got"
    classify_all "$used" "$total" "$util" "$curclk" "$maxclk" "$mask" "$2" "$temp" "$gencur" "$genmax" "$widthcur" "$widthmax"
  }

  # every fixture carries a 7th field = die temperature °C; benign (≤65) here unless the axis under test.
  # fields 8-11 = pcie gen_cur, gen_max, width_cur, width_max; healthy baseline 4,4,16,16 (Gen4 x16 = max)
  # unless the link axis is under test.
  # control 1: TRUE IDLE — mask=0x1 (GpuIdle), idle downclock 330/2160, util 0, low vram, 100% GPU, cool.
  # The naive "non-0x0 → alarm" / "ratio<0.7 → warn" rule fires here; ours MUST stay HEALTHY.
  out="$(run '6697, 12288, 0, 330, 2160, 0x0000000000000001, 42, 4, 4, 16, 16' GPU)"
  [ "${out%%|*}" = HEALTHY ] || fail "idle (GpuIdle 0x1 + idle downclock) must be HEALTHY, got: $out"

  # control 2: benign display/sync/appclock bits set, still idle → HEALTHY
  out="$(run '3000, 12288, 0, 300, 2160, 0x0000000000000112, 40, 4, 4, 16, 16' GPU)"
  [ "${out%%|*}" = HEALTHY ] || fail "benign bits (AppClocks|SyncBoost|DisplayClock) must be HEALTHY, got: $out"

  # RED 1: SW_POWER_CAP (0x4) → CRITICAL naming the reason
  out="$(run '6000, 12288, 92, 1200, 2160, 0x0000000000000004, 60, 4, 4, 16, 16' GPU)"
  [ "${out%%|*}" = CRITICAL ] || fail "SW_POWER_CAP (0x4) must be CRITICAL, got: $out"
  case "$out" in *SW_POWER_CAP*) : ;; *) fail "throttle alarm must NAME the reason SW_POWER_CAP, got: $out" ;; esac

  # RED 2: HwSlowdown (0x8) — the task's "0x8" case, named correctly as HW_SLOWDOWN
  out="$(run '6000, 12288, 92, 1000, 2160, 0x0000000000000008, 60, 4, 4, 16, 16' GPU)"
  [ "${out%%|*}" = CRITICAL ] || fail "HW_SLOWDOWN (0x8) must be CRITICAL, got: $out"
  case "$out" in *HW_SLOWDOWN*) : ;; *) fail "0x8 must be named HW_SLOWDOWN (NVML), got: $out" ;; esac

  # RED 3: thermal slowdown (0x40 HwThermal) mixed WITH benign GpuIdle 0x1 → CRITICAL, benign bit ignored
  out="$(run '6000, 12288, 88, 1400, 2160, 0x0000000000000041, 60, 4, 4, 16, 16' GPU)"
  [ "${out%%|*}" = CRITICAL ] || fail "HW_THERMAL (0x41=0x40|0x1) must be CRITICAL, got: $out"
  case "$out" in *HW_THERMAL_SLOWDOWN*) : ;; *) fail "0x41 must name HW_THERMAL_SLOWDOWN, got: $out" ;; esac

  # RED 4: VRAM pressure — 11500/12288 = 93% → CRITICAL
  out="$(run '11500, 12288, 10, 1800, 2160, 0x0000000000000000, 55, 4, 4, 16, 16' GPU)"
  [ "${out%%|*}" = CRITICAL ] || fail "vram 93% must be CRITICAL, got: $out"
  case "$out" in *vram*) : ;; *) fail "vram-crit must cite vram, got: $out" ;; esac

  # WARN: VRAM 86% → WARN (not yet critical)
  out="$(run '10600, 12288, 10, 1800, 2160, 0x0000000000000000, 55, 4, 4, 16, 16' GPU)"
  [ "${out%%|*}" = WARN ] || fail "vram 86% must be WARN, got: $out"

  # RED 5: SPILL — clean nvidia-smi but ollama shows a model on CPU → CRITICAL
  out="$(run '3000, 12288, 0, 300, 2160, 0x0000000000000001, 45, 4, 4, 16, 16' CPU-SPILL)"
  [ "${out%%|*}" = CRITICAL ] || fail "ollama CPU spill must be CRITICAL, got: $out"
  case "$out" in *SPILL*) : ;; *) fail "spill alarm must cite SPILL, got: $out" ;; esac

  # RED 6: DIE TEMP — 90C ≥ crit, clean mask, low vram, idle, 100% GPU → CRITICAL from temp ALONE,
  # BEFORE any throttle bit trips (the fan-seize-ramp case the throttle bitmask can't see yet).
  out="$(run '3000, 12288, 0, 300, 2160, 0x0000000000000000, 90, 4, 4, 16, 16' GPU)"
  [ "${out%%|*}" = CRITICAL ] || fail "gpu 90C must be CRITICAL, got: $out"
  case "$out" in *gpu*90C*) : ;; *) fail "temp-crit must cite gpu temp, got: $out" ;; esac

  # WARN: DIE TEMP 82C ≥ warn (< crit) → WARN
  out="$(run '3000, 12288, 0, 300, 2160, 0x0000000000000000, 82, 4, 4, 16, 16' GPU)"
  [ "${out%%|*}" = WARN ] || fail "gpu 82C must be WARN, got: $out"
  case "$out" in *gpu*82C*) : ;; *) fail "temp-warn must cite gpu temp, got: $out" ;; esac

  # control 4: DIE TEMP 65C — warm but below warn → HEALTHY (no cry-wolf on a normal load temp)
  out="$(run '6000, 12288, 92, 1900, 2160, 0x0000000000000000, 65, 4, 4, 16, 16' GPU)"
  [ "${out%%|*}" = HEALTHY ] || fail "gpu 65C (below warn) must be HEALTHY, got: $out"

  # WARN: clock clamped UNDER LOAD — util 92, 1200/2160 = 55% < 70%, no bad bit, low vram, cool → WARN
  out="$(run '6000, 12288, 92, 1200, 2160, 0x0000000000000000, 60, 4, 4, 16, 16' GPU)"
  [ "${out%%|*}" = WARN ] || fail "clock-clamp-under-load must be WARN, got: $out"
  case "$out" in *clamp*) : ;; *) fail "clamp warn must cite clamp, got: $out" ;; esac

  # control 3: SAME low clock ratio but IDLE (util 0) → HEALTHY (idle downclock is not a clamp)
  out="$(run '6000, 12288, 0, 1200, 2160, 0x0000000000000000, 45, 4, 4, 16, 16' GPU)"
  [ "${out%%|*}" = HEALTHY ] || fail "low clock ratio at util=0 must be HEALTHY (idle≠clamp), got: $out"

  # spill UNKNOWN (ollama unreadable) is honest partial, not a green pass and not a crit
  out="$(run '3000, 12288, 0, 300, 2160, 0x0000000000000001, 45, 4, 4, 16, 16' UNKNOWN)"
  [ "${out%%|*}" = UNKNOWN ] || fail "unreadable ollama must be UNKNOWN (honest partial), got: $out"

  # ---- (E) PCIe link geometry ----------------------------------------------
  # RED 7: WIDTH downshift — x16 card renegotiated to x8, clean on every other axis → CRITICAL (always).
  out="$(run '3000, 12288, 0, 300, 2160, 0x0000000000000000, 45, 4, 4, 8, 16' GPU)"
  [ "${out%%|*}" = CRITICAL ] || fail "pcie width x8<x16 must be CRITICAL, got: $out"
  case "$out" in *pcie*width*) : ;; *) fail "width-crit must cite pcie width, got: $out" ;; esac

  # RED 8: GEN downshift UNDER LOAD — gen1<gen4 while util=92 (not idle ASPM) → WARN.
  out="$(run '6000, 12288, 92, 1900, 2160, 0x0000000000000000, 60, 1, 4, 16, 16' GPU)"
  [ "${out%%|*}" = WARN ] || fail "pcie gen1<gen4 under load must be WARN, got: $out"
  case "$out" in *pcie*gen*) : ;; *) fail "gen-warn must cite pcie gen, got: $out" ;; esac

  # THE TRAP (control 5): GEN downshift at IDLE (util=0) is NORMAL ASPM power-management → HEALTHY.
  # A bare gen.current<max alarm would false-fire here every idle second; ours MUST stay quiet.
  out="$(run '3000, 12288, 0, 300, 2160, 0x0000000000000001, 42, 1, 4, 16, 16' GPU)"
  [ "${out%%|*}" = HEALTHY ] || fail "pcie gen1<gen4 at IDLE (util=0, ASPM) must be HEALTHY, got: $out"

  # WIDTH downshift fires EVEN at idle (width does not power-gate) → still CRITICAL.
  out="$(run '3000, 12288, 0, 300, 2160, 0x0000000000000001, 42, 1, 4, 4, 16' GPU)"
  [ "${out%%|*}" = CRITICAL ] || fail "pcie width x4<x16 at idle must STILL be CRITICAL (width≠ASPM), got: $out"

  # garbage nvidia-smi line → parse_nvsmi must reject, never classify garbage
  printf 'no GPU here\n' | parse_nvsmi >/dev/null 2>&1 && fail "garbage nvidia-smi output parsed as valid"

  # a read MISSING the temp field (6 cols, e.g. [N/A] temp) must be REJECTED — no fabricated cool GPU
  printf '3000, 12288, 0, 300, 2160, 0x0000000000000000\n' | parse_nvsmi >/dev/null 2>&1 && fail "6-field line (no temp) must be rejected — temp is required"

  # a read MISSING the four link fields (7 cols, e.g. an older driver) must be REJECTED — no fabricated Gen4-x16
  printf '3000, 12288, 0, 300, 2160, 0x0000000000000000, 45\n' | parse_nvsmi >/dev/null 2>&1 && fail "7-field line (no pcie link) must be rejected — link fields are required"

  # ---- offline announcer: a CONDITION must keep speaking, an ABSENCE must not -----------------
  # Sandboxed: its own MESH dir + a mesh-chat stub on PATH, so the real board is never touched and
  # the posts this asserts are captured rather than swallowed.
  _oz="$(mktemp -d)"; trap 'rm -rf "$_oz"' EXIT
  OFFLINEFILE="$_oz/.vram-watch-offline"
  printf '#!/bin/sh\nprintf "%%s\\n" "$*" >> "%s/chat.posts"\n' "$_oz" > "$_oz/mesh-chat"
  chmod +x "$_oz/mesh-chat"; PATH="$_oz:$PATH"
  _says() { offline_announce "$1" "fixture" 2>>"$_oz/said"; }        # stderr lines = what it announced
  _nsaid() { [ -s "$_oz/said" ] && grep -c . "$_oz/said" || echo 0; }
  _nposted() { [ -s "$_oz/chat.posts" ] && grep -c . "$_oz/chat.posts" || echo 0; }

  # ABSENT: says it once, then NEVER again — a card that was never here is not an incident.
  _says ABSENT; _says ABSENT; _says ABSENT
  [ "$(_nsaid)" = 1 ] || fail "ABSENT must announce exactly ONCE across 3 ticks, got $(_nsaid) line(s)"
  [ "$(_nposted)" = 0 ] || fail "ABSENT must never post to the board (no dGPU is not an outage)"
  case "$(cat "$_oz/said")" in *"not repeated"*) : ;; *) fail "ABSENT line must say it will not repeat: $(cat "$_oz/said")" ;; esac

  # DOWN: the 2026-08-14 shape. First tick speaks; a tick inside the backoff stays quiet; a tick
  # PAST the backoff speaks AGAIN — the outage cannot go silent while it holds.
  rm -f "$_oz/.vram-watch-offline" "$_oz/said" "$_oz/chat.posts"
  MESH_VRAM_OFFLINE_RENOTIFY_S=3600; OFFLINE_RENOTIFY_S=3600
  _says DOWN
  [ "$(_nsaid)" = 1 ] || fail "DOWN must announce on first sighting, got $(_nsaid)"
  [ "$(_nposted)" = 1 ] || fail "DOWN must post [gpu-down] to the board (a log nobody reads is how 7h08m passed unnoticed)"
  case "$(cat "$_oz/chat.posts")" in \[gpu-down\]*) : ;; *) fail "board post must carry the [gpu-down] marker, got: $(cat "$_oz/chat.posts")" ;; esac
  _says DOWN
  [ "$(_nsaid)" = 1 ] || fail "DOWN inside the backoff must stay quiet, got $(_nsaid) line(s)"
  # rewind `since` and `last` past the backoff → the SAME condition must be re-announced
  read -r _os _ok _ol < "$_oz/.vram-watch-offline"
  printf '%s %s %s\n' "$(( _os - 26000 ))" "$_ok" "$(( _ol - 26000 ))" > "$_oz/.vram-watch-offline"
  _says DOWN
  [ "$(_nsaid)" = 2 ] || fail "an ONGOING outage must re-announce past the backoff, got $(_nsaid) line(s)"
  # and every re-announce must be DATABLE — the state file cannot date it, the sentinel must
  case "$(tail -n1 "$_oz/said")" in *"down=7h13m"*) : ;; *) fail "re-announce must carry the outage duration from the sentinel, got: $(tail -n1 "$_oz/said")" ;; esac
  case "$(tail -n1 "$_oz/said")" in *since*) : ;; *) fail "re-announce must name the outage start, got: $(tail -n1 "$_oz/said")" ;; esac

  # a pre-fix EMPTY sentinel must date the outage from its own MTIME, not from now (else every
  # upgrade resets a running outage to zero)
  rm -f "$_oz/.vram-watch-offline" "$_oz/said" "$_oz/chat.posts"
  : > "$_oz/.vram-watch-offline"; touch -d '@'"$(( $(date +%s) - 7200 ))" "$_oz/.vram-watch-offline"
  _says DOWN
  case "$(cat "$_oz/said")" in *"down=2h0"*) : ;; *) fail "empty (pre-fix) sentinel must date from its mtime, got: $(cat "$_oz/said")" ;; esac
  rm -rf "$_oz"; trap - EXIT; OFFLINEFILE="$MESH/.vram-watch-offline"

  # real-read gate: a LIVE nvidia-smi must yield a parseable hex bitmask + numeric used + numeric temp, or exit 2
  if ! command -v "$NVSMI" >/dev/null 2>&1; then
    echo "smoke-test: n/a (no nvidia-smi on this node — no dGPU organ)"; exit 2
  fi
  live="$("$NVSMI" --query-gpu=memory.used,memory.total,utilization.gpu,clocks.current.graphics,clocks.max.graphics,clocks_event_reasons.active,temperature.gpu,pcie.link.gen.current,pcie.link.gen.max,pcie.link.width.current,pcie.link.width.max --format=csv,noheader,nounits 2>/dev/null | parse_nvsmi)" || {
    echo "smoke-test: n/a (nvidia-smi unreadable — no dGPU / driver down)"; exit 2; }
  IFS=$'\t' read -r used total util curclk maxclk mask temp gencur genmax widthcur widthmax <<<"$live"
  case "$used" in ''|*[!0-9]*) fail "live read missing numeric memory.used: $live" ;; esac
  case "$mask" in 0[xX]*) : ;; *) fail "live read missing hex throttle bitmask: $live" ;; esac
  case "$temp" in ''|*[!0-9]*) fail "live read missing numeric temperature.gpu: $live" ;; esac
  case "$widthcur" in ''|*[!0-9]*) fail "live read missing numeric pcie.link.width.current: $live" ;; esac
  case "$widthmax" in ''|*[!0-9]*) fail "live read missing numeric pcie.link.width.max: $live" ;; esac
  echo "smoke-test: ok (idle-benign + 9 RED axes + temp/gen/width warn+trap + clamp-vs-idle + spill-unknown + garbage/no-temp/no-link reject + offline condition-vs-absence (once/backoff/re-announce/mtime-dating/board post) + live read: used=${used}/${total}MiB util=${util}% clk=${curclk}/${maxclk}MHz mask=${mask} temp=${temp}C pcie=gen${gencur}/${genmax}x${widthcur}/${widthmax})"
  exit 0
fi
# ---------------------------------------------------------------------------

JSON=0; EDGE=0
for a in "$@"; do case "$a" in --json) JSON=1 ;; --edge) EDGE=1 ;; esac; done

command -v "$NVSMI" >/dev/null 2>&1 || {
  offline_announce ABSENT "no nvidia-smi binary"
  exit 2
}
LIVE="$("$NVSMI" --query-gpu=memory.used,memory.total,utilization.gpu,clocks.current.graphics,clocks.max.graphics,clocks_event_reasons.active,temperature.gpu,pcie.link.gen.current,pcie.link.gen.max,pcie.link.width.current,pcie.link.width.max --format=csv,noheader,nounits 2>/dev/null | parse_nvsmi)" || {
  offline_announce DOWN "nvidia-smi present but its query failed (driver/module not loaded?)"
  exit 2
}
rm -f "$OFFLINEFILE" 2>/dev/null || true

IFS=$'\t' read -r USED TOTAL UTIL CURCLK MAXCLK MASK TEMP GENCUR GENMAX WIDTHCUR WIDTHMAX <<<"$LIVE"
SPILL="$(spill_state)"
RESULT="$(classify_all "$USED" "$TOTAL" "$UTIL" "$CURCLK" "$MAXCLK" "$MASK" "$SPILL" "$TEMP" "$GENCUR" "$GENMAX" "$WIDTHCUR" "$WIDTHMAX")"
LABEL="${RESULT%%|*}"; REASON="${RESULT#*|}"
PCT=$(( USED * 100 / TOTAL ))
RATIO=0; [ "${MAXCLK:-0}" -gt 0 ] 2>/dev/null && RATIO=$(( CURCLK * 100 / MAXCLK ))
TS="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

PREV_LABEL=""
[ -f "$STATE" ] && PREV_LABEL="$(head -n1 "$STATE" 2>/dev/null | cut -d'|' -f1 | sed 's/^GPU://' || true)"

# state artifact (mesh-stress / mesh-doctor may read the live axis); mtime = liveness (always touched)
printf 'GPU:%s|vram=%s/%sMiB(%s%%)|util=%s%%|clk=%s/%sMHz(%s%%)|temp=%sC|pcie=gen%s/%sx%s/%s|throttle=%s|spill=%s|%s|%s\n' \
  "$LABEL" "$USED" "$TOTAL" "$PCT" "$UTIL" "$CURCLK" "$MAXCLK" "$RATIO" "$TEMP" "$GENCUR" "$GENMAX" "$WIDTHCUR" "$WIDTHMAX" "$MASK" "$SPILL" "$REASON" "$TS" > "$STATE"
mesh-state-touch "$STATE" 2>/dev/null || touch "$STATE" 2>/dev/null || true

if [ "$JSON" = 1 ]; then
  printf '{"label":"%s","vram_used_mib":%s,"vram_total_mib":%s,"vram_pct":%s,"util_pct":%s,"clock_cur_mhz":%s,"clock_max_mhz":%s,"clock_ratio_pct":%s,"temp_c":%s,"pcie_gen_cur":%s,"pcie_gen_max":%s,"pcie_width_cur":%s,"pcie_width_max":%s,"throttle_mask":"%s","throttle_reasons":"%s","spill":"%s","reason":"%s","ts":"%s"}\n' \
    "$LABEL" "$USED" "$TOTAL" "$PCT" "$UTIL" "$CURCLK" "$MAXCLK" "$RATIO" "$TEMP" "$GENCUR" "$GENMAX" "$WIDTHCUR" "$WIDTHMAX" "$MASK" "$(throttle_names "$MASK")" "$SPILL" "$REASON" "$TS"
  exit 0
fi

if [ "$EDGE" = 1 ] && [ "$PREV_LABEL" = "$LABEL" ]; then exit 0; fi

printf '[vram-watch] %s — vram=%s/%sMiB(%s%%) util=%s%% clk=%s/%sMHz(%s%%) temp=%sC pcie=gen%s/%sx%s/%s throttle=%s spill=%s — %s @ %s %s\n' \
  "$LABEL" "$USED" "$TOTAL" "$PCT" "$UTIL" "$CURCLK" "$MAXCLK" "$RATIO" "$TEMP" "$GENCUR" "$GENMAX" "$WIDTHCUR" "$WIDTHMAX" "$MASK" "$SPILL" "$REASON" "$(hostname)" "$TS"
