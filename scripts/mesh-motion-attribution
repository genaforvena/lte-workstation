#!/usr/bin/env bash
# orphan-ok: on-demand fusion verb — queried by a mind/mesh-situation when investigating motion;
#            deliberately not cron-wired (wire later with a reflex-cadence if a stream needs it).
# mesh-motion-attribution — CROSS-SENSE FUSION: is physical motion ATTRIBUTED to a known
# human, or UNATTRIBUTED — and given who-should-be-home, is it benign or security-relevant?
#
# Combines THREE senses that none alone can answer:
#   1. mesh-wifi-motion  — DEVICE-FREE physical-motion radar (node-local RSSI drift; needs no
#                          phone). Answers "is something physically MOVING in the space?"
#   2. mesh-presence      — BLE attribution (personal:N from the same scan). Answers "is a known
#                          human's device (phone/wearable) actually HERE to explain that motion?"
#   3. operator-home      — WiFi/LAN whole-home presence (~/.mesh/.op-home.state). Answers "is the
#                          operator SUPPOSED to be home?" — the context that splits the SAME
#                          unattributed-motion reading into benign vs alarm. (live-found 2026-06-24:
#                          operator HOME + motion + BLE personal=0 is the operator moving deviceless,
#                          NOT an intruder — BLE is ~10m/this-node while WiFi-home spans the house.)
#
# The derived signal no single sensor gives (motion × BLE-attribution × operator-home):
#   MOTION + a personal device present   → ATTRIBUTED   (a known human's device is here & moving)
#   MOTION + 0 personal + operator HOME  → OCCUPANT     (household/operator moving without a carried
#                                          device — benign; BLE just can't see a phone in another room)
#   MOTION + 0 personal + operator AWAY  → UNEXPLAINED  (motion with no one expected home and no
#                                          carried-device explanation — stranger/pet/appliance/RF;
#                                          the real security signal)
#   MOTION + 0 personal + op-home UNKNOWN→ UNATTRIBUTED (motion unexplained AND we can't tell who is
#                                          supposed to be home — honest-neutral, distinct from both)
#   STILL                                → QUIET        (no motion; attribution moot)
#
# HONEST-DEGRADED (the load-bearing rule): an UNREACHABLE input is rendered VISIBLY DIFFERENT from
# a genuine empty, and the tool EXITS 2 — never a silent all-clear, never a faked intruder.
#   - wifi-motion UNCERTAIN / unreachable (can't assess motion)            → verdict UNKNOWN, exit 2
#   - presence adapter unreachable (mesh-presence exit 2) OR presence.log
#     stale (>STALE_LIMIT)  → attribution UNKNOWN → verdict UNKNOWN, exit 2
#   A missing BLE read is NEVER read as "0 personal = unattributed" (a dead scanner must not
#   manufacture an intruder), and a missing motion read is NEVER read as "STILL = all clear".
#   The operator-home axis obeys the same rule: an UNREACHABLE/missing op-home state (UNKNOWN) does
#   NOT collapse unattributed motion into either OCCUPANT (benign) or UNEXPLAINED (alarm) — it stays
#   the distinct neutral UNATTRIBUTED. We never manufacture an intruder from a missing op-home read,
#   nor wave motion through as benign without knowing the operator is actually home.
#
#   mesh-motion-attribution            one-shot fused verdict line
#   mesh-motion-attribution --json     {verdict, motion, motion_intensity, motion_reach,
#                                       personal, presence_reach, operator_home, degraded, reason, ts}
#   mesh-motion-attribution --test     smoke test (deps + derivation truth-table, no live read)
#
# Read-only (no actuators). Exit 0 = real artifact (QUIET/ATTRIBUTED/OCCUPANT/UNEXPLAINED/
# UNATTRIBUTED — the verdict incl. the UNEXPLAINED security signal is in the TEXT, not rc, per sense
# convention); exit 2 = degraded (a sense unreachable → cannot fuse).
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

PRESENCE_LOG="$HOME/.mesh/presence.log"
OP_HOME_STATE="$HOME/.mesh/.op-home.state"
PRESENCE_STALE_LIMIT=${PRESENCE_STALE_LIMIT:-900}   # presence.log older than this → attribution UNKNOWN

# ---- Pure derivation (FALSIFIABLE, no I/O): the heart of the fusion, exercised by --test ----
# derive <motion> <attr_known:0|1> <personal_count> <op_home:HOME|AWAY|UNKNOWN> → "<VERDICT>|<exit>"
#   motion ∈ MOTION|STILL|UNKNOWN ; attr_known=1 means the BLE attribution is trustworthy.
#   Honest-degraded precedence: any UNKNOWN motion/attribution axis → UNKNOWN (exit 2), before any
#   all-clear/alarm. op_home only DISAMBIGUATES the already-unattributed case; UNKNOWN op_home is a
#   distinct neutral (UNATTRIBUTED), never silently benign (OCCUPANT) or alarm (UNEXPLAINED).
derive() {
  local motion="$1" attr_known="$2" pers="${3:-0}" op="${4:-UNKNOWN}"
  if [ "$motion" = "UNKNOWN" ];   then echo "UNKNOWN|2"; return; fi
  if [ "$motion" = "STILL" ];     then echo "QUIET|0";   return; fi   # no motion → attribution moot
  # motion == MOTION from here; attribution must be trustworthy to classify it
  if [ "$attr_known" != "1" ];    then echo "UNKNOWN|2"; return; fi   # motion real but can't attribute
  if [ "${pers:-0}" -ge 1 ] 2>/dev/null; then echo "ATTRIBUTED|0"; return; fi
  # motion + 0 personal devices: operator-home turns the SAME reading benign vs security-relevant
  case "$op" in
    AWAY) echo "UNEXPLAINED|0" ;;   # no one expected home, no carried-device cause → real signal
    HOME) echo "OCCUPANT|0" ;;      # operator home → deviceless household/operator motion (benign)
    *)    echo "UNATTRIBUTED|0" ;;  # op-home UNKNOWN → can't contextualize; honest-neutral, distinct
  esac
}

if [ "${1:-}" = --test ]; then
  command -v mesh-wifi-motion >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-wifi-motion)"; exit 1; }
  command -v mesh-presence   >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-presence)"; exit 1; }
  _f=0
  # Truth table — including the honest-degraded precedence (UNKNOWN never collapses to all-clear/alarm)
  [ "$(derive MOTION  1 2 HOME)"    = "ATTRIBUTED|0" ]   || { echo "  FAIL: MOTION+personal→ATTRIBUTED (BLE explains it regardless of op-home)"; _f=1; }
  [ "$(derive MOTION  1 2 AWAY)"    = "ATTRIBUTED|0" ]   || { echo "  FAIL: MOTION+personal+AWAY→ATTRIBUTED (a present personal device still attributes)"; _f=1; }
  [ "$(derive STILL   1 0 AWAY)"    = "QUIET|0" ]        || { echo "  FAIL: STILL→QUIET (no motion → no alarm even when AWAY)"; _f=1; }
  [ "$(derive STILL   0 0 HOME)"    = "QUIET|0" ]        || { echo "  FAIL: STILL→QUIET even if attr unknown"; _f=1; }
  [ "$(derive MOTION  0 0 AWAY)"    = "UNKNOWN|2" ]      || { echo "  FAIL: MOTION+attr-unknown→UNKNOWN (a dead scanner never manufactures UNEXPLAINED even when AWAY)"; _f=1; }
  [ "$(derive UNKNOWN 1 5 HOME)"    = "UNKNOWN|2" ]      || { echo "  FAIL: motion-unknown→UNKNOWN (never faked all-clear from a dead radar)"; _f=1; }
  # op-home disambiguation of the unattributed case (the 2026-06-24 extension)
  [ "$(derive MOTION  1 0 HOME)"    = "OCCUPANT|0" ]     || { echo "  FAIL: MOTION+0personal+HOME→OCCUPANT (operator moving deviceless = benign, not an intruder)"; _f=1; }
  [ "$(derive MOTION  1 0 AWAY)"    = "UNEXPLAINED|0" ]  || { echo "  FAIL: MOTION+0personal+AWAY→UNEXPLAINED (the real security signal)"; _f=1; }
  [ "$(derive MOTION  1 0 UNKNOWN)" = "UNATTRIBUTED|0" ] || { echo "  FAIL: MOTION+0personal+op-UNKNOWN→UNATTRIBUTED (honest-neutral, distinct from benign/alarm)"; _f=1; }
  [ "$(derive MOTION  1 0)"         = "UNATTRIBUTED|0" ] || { echo "  FAIL: missing op-home arg defaults to UNKNOWN→UNATTRIBUTED (never a faked OCCUPANT/UNEXPLAINED)"; _f=1; }
  [ "$_f" = 0 ] || { echo "smoke-test: FAIL"; exit 1; }
  echo "smoke-test: ok (derivation truth-table: 10 assertions incl. honest-degraded precedence + op-home disambiguation w/ UNKNOWN-neutral)"; exit 0
fi

TS="$(date -u +%FT%TZ)"; NOW="$(date +%s)"

# ---- Axis 1: device-free physical motion (node-local; no phone needed) ----
motion="UNKNOWN"; motion_intensity="NONE"; motion_reach=0
out="$(timeout 14 mesh-wifi-motion 2>/dev/null)" || true
if [ -n "$out" ]; then
  case "$out" in
    *MOTION*)    motion="MOTION"; motion_reach=1 ;;
    *STILL*)     motion="STILL";  motion_reach=1 ;;
    *UNCERTAIN*) motion="UNKNOWN" ;;   # below corroboration floor / thin tape → can't assess (reach=0)
  esac
  case "$out" in *intensity=*) motion_intensity="${out##*intensity=}"; motion_intensity="${motion_intensity%% *}" ;; esac
fi

# ---- Axis 2: BLE attribution (personal-device count), honest about reachability ----
# Use the presence reflex's cached log (same source the dash reads) — cheap, no 12s live scan.
# The line carries attribution=personal:P,appliance:A,ambiguous:M from the SAME scan as n=.
# Reachability rules: log missing OR stale (>limit) → attribution UNKNOWN (never trust an old read);
# a confident fresh n=0 EMPTY line is a real "0 personal", NOT unknown.
personal=0; attr_known=0; presence_reach=0; presence_age="-"
if [ -f "$PRESENCE_LOG" ]; then
  m="$(stat -c %Y "$PRESENCE_LOG" 2>/dev/null || echo "$NOW")"; presence_age=$((NOW-m))
  pl="$(tail -1 "$PRESENCE_LOG" 2>/dev/null)"
  p="$(printf '%s\n' "$pl" | sed -nE 's/.*attribution=personal:([0-9]+),.*/\1/p')"
  if [ "$presence_age" -le "$PRESENCE_STALE_LIMIT" ] && [ -n "$p" ]; then
    personal="$p"; attr_known=1; presence_reach=1
  fi
fi

# ---- Axis 3: operator-home (WiFi/LAN whole-home) — DISAMBIGUATES the unattributed-motion case ----
# Honest about reachability: missing/empty state → UNKNOWN, which the derivation keeps as the neutral
# UNATTRIBUTED (never a silent OCCUPANT/UNEXPLAINED). Normalize anything unexpected to UNKNOWN.
operator_home="UNKNOWN"
[ -f "$OP_HOME_STATE" ] && operator_home="$(head -1 "$OP_HOME_STATE" 2>/dev/null | tr -d '[:space:]')"
case "$operator_home" in HOME|AWAY) : ;; *) operator_home="UNKNOWN" ;; esac

# ---- Fuse ----
res="$(derive "$motion" "$attr_known" "$personal" "$operator_home")"
verdict="${res%%|*}"; rc="${res##*|}"

degraded="none"; reason=""
case "$verdict" in
  UNKNOWN)
    degraded=""
    [ "$motion_reach" = 0 ]   && degraded="${degraded:+$degraded,}wifi-motion:unreachable"
    [ "$presence_reach" = 0 ] && degraded="${degraded:+$degraded,}presence:unreachable"
    reason="cannot fuse — ${degraded} (honest-degraded: not a confident all-clear, not a faked alarm)"
    ;;
  QUIET)        reason="no physical motion (wifi=STILL/$motion_intensity)" ;;
  ATTRIBUTED)   reason="motion (intensity=$motion_intensity) explained by ${personal} personal device(s) present" ;;
  OCCUPANT)
    reason="physical motion (intensity=$motion_intensity), 0 personal devices, but operator HOME → household/operator moving without a carried device (benign; BLE can't see a phone in another room — not a guaranteed all-clear)"
    ;;
  UNEXPLAINED)
    reason="physical motion (intensity=$motion_intensity), 0 personal devices, operator AWAY → no one expected home and no carried-device explanation (security-relevant: stranger/pet/appliance/RF — investigate)"
    ;;
  UNATTRIBUTED)
    reason="physical motion (intensity=$motion_intensity) with 0 personal devices — no carried-device explanation; operator-home UNKNOWN so cannot contextualize (honest-neutral, not benign, not an alarm)"
    ;;
esac

signals="wifi=$motion/$motion_intensity($motion_reach) personal=$personal($presence_reach) op=$operator_home"

case "${1:-}" in
  --json)
    printf '{"verdict":"%s","motion":"%s","motion_intensity":"%s","motion_reach":%d,"personal":%d,"presence_reach":%d,"presence_age_s":"%s","operator_home":"%s","degraded":"%s","reason":"%s","ts":"%s"}\n' \
      "$verdict" "$motion" "$motion_intensity" "$motion_reach" "${personal:-0}" "$presence_reach" \
      "$presence_age" "$operator_home" "$degraded" "$reason" "$TS"
    ;;
  *)
    printf 'motion-attribution: %s — %s | %s\n' "$verdict" "$reason" "$signals"
    ;;
esac
exit "$rc"
