#!/usr/bin/env bash
# mesh-mind-liveness — check every MESH_MIND_CHANNELS window has a live mind attached.
# For each channel window: window present? mind pane classifies live (via mesh-mind-state)?
# Prints per-window STATE ("<win> <STATE>" lines, byte-stable) and posts at most ONE
# roster summary per poll for the silent set (ABSENT window, or DEAD/DEAD-SHELL/
# AUTH-DEAD mind) to the board. RATE-LIMITED/NEEDS-INPUT/WORKING/IDLE count as live.
#
#   mesh-mind-liveness            check all channels, post SILENT ones (rc 1 if any SILENT)
#   mesh-mind-liveness --check    same, dry-run: print, do not post
#   mesh-mind-liveness --test     self-test incl. a real live read of one channel window
#
# reflex-cadence: */15 * * * *
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
MESH="$HOME/.mesh"; mkdir -p "$MESH"
# Throttle: an unchanged silent SET re-posts at most hourly via a single roster
# sentinel keyed on the sorted silent set (mirrors mesh-channel-keepalive's
# odd-sentinel idea, aggregated). A NEW set posts immediately.
# Per-window helpers below are retained for --test fixtures; post mode no longer
# posts per window, so a multi-window absence burst emits exactly one board line.
SENTINEL_DIR="${MESH_MIND_LIVENESS_SENTINEL_DIR:-$MESH}"
sanitize_key() { printf '%s' "$1" | tr -c 'A-Za-z0-9._-' '_'; }

# should_post_roster <sha> — rc 0 iff no fresh roster sentinel exists for this
# exact silent set (missing sentinel, changed set, or age > 3600s).
should_post_roster() {
  local key="$SENTINEL_DIR/.mind-liveness-roster.ts" old="" ts=0 now
  [ ! -f "$key" ] && return 0
  old="$(awk '{print $1}' "$key" 2>/dev/null)"
  ts="$(awk '{print $2}' "$key" 2>/dev/null)"
  [ -n "$ts" ] || ts=0
  [ "$old" != "$1" ] && return 0
  now="$(date +%s)"
  [ "$(( now - ts ))" -gt 3600 ]
}
stamp_post_roster() {
  printf '%s %s\n' "$1" "$(date +%s)" > "$SENTINEL_DIR/.mind-liveness-roster.ts" 2>/dev/null || true
}
# roster_sha <sorted-list> — stable key for the silent set.
roster_sha() {
  if command -v sha1sum >/dev/null 2>&1; then
    printf '%s' "$1" | sha1sum | awk '{print $1}'
  elif command -v md5sum >/dev/null 2>&1; then
    printf '%s' "$1" | md5sum | awk '{print $1}'
  else
    printf '%s' "$1" | cksum | awk '{print $1}'
  fi
}
# Legacy per-window throttle helpers: retained for --test fixtures only.
# Post mode no longer calls them (roster sentinel covers the burst).
# should_post_silent <win> <state> — rc 0 iff no fresh sentinel for this exact
# window+state exists (missing sentinel or age > 3600s).
should_post_silent() {
  local key; key="$SENTINEL_DIR/.mind-liveness-silent-$(sanitize_key "$1")-$(sanitize_key "$2").ts"
  [ ! -f "$key" ] && return 0
  [ "$(( $(date +%s) - $(cat "$key" 2>/dev/null || echo 0) ))" -gt 3600 ]
}
stamp_post_silent() {
  date +%s > "$SENTINEL_DIR/.mind-liveness-silent-$(sanitize_key "$1")-$(sanitize_key "$2").ts" 2>/dev/null || true
}
SESS="$(hostname)"
# shellcheck disable=SC1090
[ -f "$MESH/restore.env" ] && . "$MESH/restore.env"
CHANNELS="${MESH_MIND_CHANNELS:-}"

# is_live_state <state> — rc 0 iff the mesh-mind-state word counts as a live mind.
is_live_state() {
  case "$1" in
    WORKING|IDLE|NEEDS-INPUT|RATE-LIMITED|UNKNOWN) return 0 ;;
    *) return 1 ;;
  esac
}

# classify_window <win> — echo "<win> <STATE>"; rc 0 iff live.
classify_window() {
  local win="$1" state="ABSENT"
  if tmux list-windows -t "$SESS" -F '#W' 2>/dev/null | grep -qx "$win"; then
    state="$(mesh-mind-state "$win" 2>/dev/null | head -n 1 | awk '{print $1}')"
    [ -n "$state" ] || state="UNKNOWN"
  fi
  echo "$win $state"
  is_live_state "$state"
}

run_check() {
  local mode="$1" win line state silent=0 out="" silent_list="" roster="" sha=""
  [ -n "$CHANNELS" ] || { echo "SILENT-SOURCE: MESH_MIND_CHANNELS empty — cannot enumerate minds" >&2; return 2; }
  for win in $CHANNELS; do
    line="$(classify_window "$win")"
    state="${line#* }"
    out+="$line"$'\n'
    if ! is_live_state "$state"; then
      silent=1
      silent_list+="$line"$'\n'
    fi
  done
  if [ "$silent" -ne 0 ] && [ "$mode" = post ]; then
    # One roster summary per poll: "win:STATE" pairs sorted, count + list.
    roster="$(printf '%s' "$silent_list" | LC_ALL=C sort | sed 's/ /:/' | tr '\n' ' ' | sed 's/ $//')"
    sha="$(roster_sha "$roster")"
    if should_post_roster "$sha"; then
      mesh-chat "[mind-silent] $(printf '%s' "$silent_list" | wc -l | tr -d ' ') windows silent: $roster — no live mind attached" >/dev/null 2>&1 || true
      stamp_post_roster "$sha"
    fi
  fi
  printf '%s' "$out"
  return "$silent"
}

case "${1:-}" in
  --test)
    # 1. predicate unit checks (no tmux needed)
    for s in WORKING IDLE NEEDS-INPUT RATE-LIMITED UNKNOWN; do
      is_live_state "$s" || { echo "FAIL: $s should count live" >&2; exit 1; }
    done
    for s in ABSENT DEAD DEAD-SHELL AUTH-DEAD; do
      is_live_state "$s" && { echo "FAIL: $s should count SILENT" >&2; exit 1; }
    done
    # 2. throttle fixtures: unchanged SILENT re-post suppressed, new state posts
    tdir="$(mktemp -d)"; SENTINEL_DIR="$tdir"
    should_post_silent w1 DEAD-SHELL || { echo "FAIL: first sighting must post" >&2; exit 1; }
    stamp_post_silent w1 DEAD-SHELL
    should_post_silent w1 DEAD-SHELL && { echo "FAIL: unchanged second pass must not post" >&2; exit 1; }
    should_post_silent w1 DEAD || { echo "FAIL: changed state must post" >&2; exit 1; }
    should_post_silent w2 DEAD-SHELL || { echo "FAIL: new silent window must post" >&2; exit 1; }
    echo "old -1" > /dev/null; date -d '2 hours ago' +%s > "$tdir/.mind-liveness-silent-w1-DEAD-SHELL.ts" 2>/dev/null \
      || { echo "SKIP throttle-age arm: date -d unsupported"; rm -rf "$tdir"; }
    if [ -d "$tdir" ] && [ -f "$tdir/.mind-liveness-silent-w1-DEAD-SHELL.ts" ]; then
      should_post_silent w1 DEAD-SHELL || { echo "FAIL: hourly sentinel must re-post" >&2; exit 1; }
      rm -rf "$tdir"
    fi
    # 2b. burst regression: 3-window absence burst posts exactly ONE roster line.
    # NOTE: pre-fix per-window code posted 3 mesh-chat lines here (one per window),
    # so the "-eq 1" assertion below FAILS on the old code path and passes with
    # the roster fix. Fixture: CHANNELS="bw1 bw2 bw3", all classify DEAD.
    bdir=""; blog=""
    bdir="$(mktemp -d)"; blog="$bdir/calls.log"; : > "$blog"
    saved_channels="$CHANNELS"; saved_sentinel="$SENTINEL_DIR"
    SENTINEL_DIR="$bdir"; CHANNELS="bw1 bw2 bw3"
    tmux() { printf 'bw1\nbw2\nbw3\n'; return 0; }
    mesh-mind-state() { echo "DEAD"; return 0; }
    mesh-chat() { printf '%s\n' "$*" >> "$blog"; return 0; }
    bout=""; brc=0; bout="$(run_check post)"; brc=$?
    [ "$brc" -eq 1 ] || { echo "FAIL: burst post rc=$brc want 1" >&2; exit 1; }
    [ "$(wc -l < "$blog" | tr -d ' ')" -eq 1 ] || { echo "FAIL: burst must post exactly once (got $(wc -l < "$blog" | tr -d ' ') calls)" >&2; cat "$blog" >&2; exit 1; }
    grep -q '^\[mind-silent\] 3 windows silent:' "$blog" || { echo "FAIL: roster summary must lead with count" >&2; cat "$blog" >&2; exit 1; }
    for bw in bw1 bw2 bw3; do
      grep -q "$bw:DEAD" "$blog" || { echo "FAIL: roster summary missing $bw:DEAD" >&2; cat "$blog" >&2; exit 1; }
      grep -qx "$bw DEAD" <<<"$(printf '%s' "$bout" | sed -n "$(( ${bw#bw} ))p")" || { echo "FAIL: stdout must keep per-window '$bw DEAD' line" >&2; echo "$bout" >&2; exit 1; }
    done
    bout2=""; brc2=0; bout2="$(run_check post)"; brc2=$?
    [ "$brc2" -eq 1 ] || { echo "FAIL: second burst poll rc=$brc2 want 1" >&2; exit 1; }
    [ "$(wc -l < "$blog" | tr -d ' ')" -eq 1 ] || { echo "FAIL: identical second poll must post ZERO more (roster throttle)" >&2; cat "$blog" >&2; exit 1; }
    [ "$bout2" = "$bout" ] || { echo "FAIL: second poll stdout must match first" >&2; exit 1; }
    run_check dry >/dev/null; brc3=$?
    [ "$brc3" -eq 1 ] || { echo "FAIL: --check-equivalent dry rc=$brc3 want 1" >&2; exit 1; }
    [ "$(wc -l < "$blog" | tr -d ' ')" -eq 1 ] || { echo "FAIL: dry-run must never post" >&2; cat "$blog" >&2; exit 1; }
    CHANNELS="bw1 bw2 bw3 bw4"
    tmux() { printf 'bw1\nbw2\nbw3\nbw4\n'; return 0; }
    run_check post >/dev/null; brc4=$?
    [ "$brc4" -eq 1 ] || { echo "FAIL: changed-set poll rc=$brc4 want 1" >&2; exit 1; }
    [ "$(wc -l < "$blog" | tr -d ' ')" -eq 2 ] || { echo "FAIL: new silent set must post immediately (want 2 total)" >&2; cat "$blog" >&2; exit 1; }
    grep -q '^\[mind-silent\] 4 windows silent:' "$blog" || { echo "FAIL: changed-set summary must lead with count 4" >&2; cat "$blog" >&2; exit 1; }
    echo "BURST regression: 1 post first poll, 0 second poll, 0 dry-run — OK"
    unset -f tmux mesh-mind-state mesh-chat
     # 3. real live read: classify at least the genome window on this node
    if tmux list-windows -t "$SESS" -F '#W' 2>/dev/null | grep -qx genome; then
      line="$(classify_window genome)" || true
      echo "REAL live read: $line"
      grep -qE '^genome (WORKING|IDLE|NEEDS-INPUT|RATE-LIMITED|UNKNOWN|DEAD|DEAD-SHELL|AUTH-DEAD|ABSENT)$' <<<"$line" \
        || { echo "FAIL: unexpected classify output: $line" >&2; exit 1; }
    else
      echo "SKIP live read: no genome window on $SESS (rc 2 path)"
      exit 2
    fi
    echo "mesh-mind-liveness --test: PASS"
    ;;
  --check) run_check dry ;;
  *) run_check post ;;
esac
