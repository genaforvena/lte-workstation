#!/usr/bin/env bash
# orphan-ok: on-demand kernel RAID health probe; no safe cadence until a consumer is chosen.
# mesh-md-health — kernel md/RAID topology and state sense from /proc/mdstat.
#
# A readable mdstat with no arrays is a genuine NO-ARRAYS observation, not a fabricated healthy
# value. Missing, unreadable, or structurally malformed procfs is UNREACHABLE and exits 2.
#
#   mesh-md-health       emit one real text artifact
#   mesh-md-health --json
#   mesh-md-health --test  parser fixtures plus a live /proc/mdstat read
set -u
set -o pipefail

MDSTAT="${MESH_MDSTAT_FILE:-/proc/mdstat}"

parse_mdstat() {
  local f="$1" body arrays states
  [ -r "$f" ] || return 2
  body="$(sed -n '1,200p' "$f" 2>/dev/null)" || return 2
  # The kernel file always has this framing, including on hosts with no md arrays.
  printf '%s\n' "$body" | grep -q '^Personalities' || return 2
  printf '%s\n' "$body" | grep -q '^unused devices:' || return 2
  arrays="$(printf '%s\n' "$body" | awk '$1 ~ /^md[0-9]+$/ {n++} END {print n+0}')"
  states="$(printf '%s\n' "$body" | awk '$1 ~ /^md[0-9]+$/ {print $1 ":" $3; found=1} END {if (!found) print "none"}')"
  printf '%s\t%s\n' "$arrays" "$states"
}

emit() {
  local parsed="$1" format="${2:-}" arrays states ts
  IFS=$'\t' read -r arrays states <<<"$parsed"
  ts="$(date -u +%FT%TZ)"
  if [ "$format" = --json ]; then
    printf '{"arrays":%s,"states":"%s","source":"%s","ts":"%s"}\n' \
      "$arrays" "$states" "$MDSTAT" "$ts"
  else
    printf '[md-health] arrays=%s states=%s source=%s ts=%s\n' "$arrays" "$states" "$MDSTAT" "$ts"
  fi
}

if [ "${1:-}" = --test ]; then
  tmp="$(mktemp -d)"
  trap 'rm -rf "$tmp"' EXIT
  cat >"$tmp/empty" <<'EOF'
Personalities : [raid1]
unused devices: <none>
EOF
  cat >"$tmp/array" <<'EOF'
Personalities : [raid1]
md0 : active raid1 sda1[0] sdb1[1]
      123456 blocks [2/2] [UU]
unused devices: <none>
EOF
  printf 'not-mdstat\n' >"$tmp/bad"
  [ "$(parse_mdstat "$tmp/empty" | cut -f1-2)" = $'0\tnone' ] || { echo 'smoke-test: FAIL (honest no-array parse)'; exit 1; }
  [ "$(parse_mdstat "$tmp/array" | cut -f1-2)" = $'1\tmd0:active' ] || { echo 'smoke-test: FAIL (array state parse)'; exit 1; }
  if parse_mdstat "$tmp/bad" >/dev/null 2>&1; then
    echo 'smoke-test: FAIL (malformed fixture accepted)'; exit 1
  fi
  live="$(parse_mdstat "$MDSTAT" 2>/dev/null)" || {
    echo 'smoke-test: n/a (real /proc/mdstat unavailable; parser guards pass)'; exit 2
  }
  echo "smoke-test: ok (no-array + array + malformed guards; live /proc/mdstat arrays=$(printf '%s' "$live" | cut -f1))"
  exit 0
fi

parsed="$(parse_mdstat "$MDSTAT" 2>/dev/null)" || {
  echo "[md-health] UNREACHABLE — unreadable or malformed $MDSTAT (no RAID state invented)" >&2
  exit 2
}
emit "$parsed" "${1:-}"
