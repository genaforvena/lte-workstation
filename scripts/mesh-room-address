#!/usr/bin/env bash
# orphan-ok: on-demand precision gate, called by mesh-room-reflex on a wake candidate (never scheduled).
# mesh-room-address — "does Misha need to REPLY to this?" (operator 2026-07-14: "более умная регулярка
# ... избавиться от ложных срабатываний"; 2026-07-16: "not only check if misha is present, but get the
# CONTEXT if misha needs to reply"). The smarter-regex the operator asked for, now context-aware.
#
# ARCHITECTURE — cheap recall, expensive precision, never deaf:
#   mesh-room-reflex's `миш|misha|миша` regex is a HIGH-RECALL, low-precision trigger: it catches
#   every real address, plus junk. This gate runs ONLY on what that regex already flagged (a handful
#   of times an hour, not the 5s tick), so a ~300ms local call costs nothing at rest. The regex keeps
#   recall; the model supplies precision.
#
# CONTEXT, NOT ONE LINE. Judging a single line makes third-person mentions ("Как думаешь, Миша был
# прав?", "Спроси у Миши потом") look addressed — they carry the name but the reply is owed to a
# HUMAN, not Misha. Measured 2026-07-16 (fixture wakegate-ru-01): every residual false-wake of the
# best model was exactly this class. So the gate takes the RECENT DIALOG on stdin and decides only
# about the LAST (candidate) line, using the earlier lines as context. One line still works (no ctx).
#
# WHY qwen2.5:3b AND NOT qwen3.5. The first 3.5 disqualification was OURS, not the models': the
# invocation carried no think handling, so the thinking channel ate the answer and content came out
# '{}'/ramble → all three read UNPARSED identically (by hand they answer fine). Re-benched
# 2026-07-16 through model_raw WITH --think=false (fixture wakegate-ru-01, n=28, 16 IGNORE):
#   qwen2.5:3b  0 deaf / 6 false / 0.31s warm   ← kept
#   qwen3.5:4b  0 deaf / 5 false / 0.77s warm   (1 false fewer = inside noise at n=16; 2.5x latency)
#   qwen3.5:2b  1 DEAF — disqualified (deafness is the failure the gate exists to prevent)
#   qwen3.5:0.8b 0 deaf / 15 false — wakes on nearly all junk
# So 2.5:3b keeps the pin on latency at equal-within-noise precision; 3.5:4b is the live challenger
# if the fixture grows enough IGNORE lines to resolve a real margin. mesh-model-autoselect owns the
# switch (dominance+margin), never this comment.
#
# FAIL OPEN, ALWAYS (the --window / name path). ollama down, model missing, timeout, unparseable
# output → exit 0 (WAKE). A false wake costs one paid turn; a false SILENCE means the operator asks
# Misha something and is ignored, which is the failure the whole room-mind exists to prevent.
# Deafness is never the safe default.
#
# --ambient MODE — the OPPOSITE failure economics (operator 2026-07-17: "wire the ambient gate with
# gemma4 wired on it"). The name path answers "did someone ADDRESS Misha?" and must never go deaf.
# The ambient path answers "is this UNADDRESSED room chatter worth a PROACTIVE word?" — a look-in the
# mesh volunteers, not a reply it owes. Its whole reason to exist is to STOP spending a paid mind turn
# on appliance announcements and small talk (the robot-vacuum "возвращаюсь на базу для зарядки" storm,
# 2026-07-17). So it FAILS CLOSED: model down/timeout/unparseable → exit 1 (STAY SILENT), the mind is
# NOT poked. But a silent fail-closed is the canonical trap (a default indistinguishable from success),
# so every ambient decision — react, silent, AND gate-error — is logged LOUD to ROOM_AMBIENT_GATE_LOG.
# The name path is untouched and still fails open, so a real address is NEVER gated by this: the mesh
# can lose a proactive comment when gemma4 is down, never a reply to the operator.
#   Ambient model = gemma4:e2b-it-qat (bench wakegate-ru-01 2026-07-17: 0 deaf / read-ok / warm ~0.55s,
#   false-rate below qwen2.5:3b). mesh-model-autoselect owns the switch; never eyeball it — the numbers
#   live in ~/.mesh/model-bench.log / the `models` dash pane.
#
# Exit: 0 = WAKE/REACT (addressed | worth a word | unsure-on-name) · 1 = IGNORE/SILENT.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"; export LC_ALL=C.UTF-8

MODEL_DEFAULT='qwen2.5:3b'
TIMEOUT="${ROOM_ADDRESS_TIMEOUT:-8}"
AMBIENT_MODEL_DEFAULT='gemma4:e2b-it-qat'                 # benched wake-gate winner (2026-07-17)
AMBIENT_TIMEOUT="${ROOM_AMBIENT_TIMEOUT:-20}"            # gemma4 COLD load ~12s (bench) — 8s would cut it
AMBIENT_GATE_LOG="${ROOM_AMBIENT_GATE_LOG:-$HOME/.mesh/room-ambient-gate.log}"

read -r -d '' PROMPT <<'EOF'
Ты — фильтр пробуждения для голосового ассистента по имени Миша (звательные формы: Миша, Миш, Мишань). В комнате идёт живой разговор; микрофон также ловит галлюцинации распознавания речи на тишине.
Ниже последние реплики из комнаты по порядку. Реши ТОЛЬКО про ПОСЛЕДНЮЮ реплику, используя предыдущие как контекст.
ГЛАВНОЕ ПРАВИЛО: если в ПОСЛЕДНЕЙ реплике есть звательное обращение к Мише (Миша/Миш/Мишань — часто выделено запятой: "Миш,", "Ну вот, Миш," "Миша,") — это ВСЕГДА {"wake":true}, даже если дальше идёт жалоба, ремарка или незаконченная мысль. При любом сомнении отвечай {"wake":true} — пропущенное обращение хуже лишнего.
Ответь {"wake":false} ТОЛЬКО когда обращения к Мише в последней реплике нет: люди говорят между собой; о Мише в ТРЕТЬЕМ лице без обращения к нему ("спроси у Миши", "Миша вчера чинил", "как думаешь, Миша прав"); слова, лишь ПОХОЖИЕ на имя (мишка, мишура, Мишель); бессмысленный обрывок STT на тишине.
Примеры:
Разговор:
ПОСЛЕДНЯЯ: "Миша, ты нас слышишь?" -> {"wake":true}
Разговор:
ПОСЛЕДНЯЯ: "Ну вот, Миш, плохо слушать, всё прерывается" -> {"wake":true}
Разговор:
ПОСЛЕДНЯЯ: "Миш, кстати, а ты видишь..." -> {"wake":true}
Разговор:
ПОСЛЕДНЯЯ: "Время" -> {"wake":false}
Разговор:
"Смотри какие мишки на витрине"
ПОСЛЕДНЯЯ: "Да, милые, купим?" -> {"wake":false}
Разговор:
ПОСЛЕДНЯЯ: "Как думаешь, Миша был прав вчера?" -> {"wake":false}
Разговор:
ПОСЛЕДНЯЯ: "Повесь мишуру повыше" -> {"wake":false}
EOF

# The ambient look-in prompt. UNADDRESSED room speech (no name — the name path already handles
# vocatives); decide whether the assistant Misha should VOLUNTEER a word. Bias hard toward silence:
# the room is mostly people talking to each other, appliances announcing themselves, and STT
# hallucinations, and over-commenting is the noise the operator is cutting. Only react on something
# the assistant can actually serve — an open question, a request, a plan it could act on.
read -r -d '' AMBIENT_PROMPT <<'EOF'
Ты — фильтр проактивности для голосового ассистента по имени Миша. В комнате идёт живой разговор между людьми; ассистент СЛУШАЕТ фоном. К Мише сейчас НЕ обращаются по имени (это уже проверено отдельно). Реши, стоит ли Мише ПО СВОЕЙ ИНИЦИАТИВЕ подать голос по поводу услышанного.
Ответь {"react":true} ТОЛЬКО если в репликах есть что-то, что ассистент реально может ОБСЛУЖИТЬ: открытый вопрос, на который Миша знает ответ; просьба или задача, которую он может выполнить; договорённость/напоминание, которое ему стоит подхватить.
Ответь {"react":false} на всё остальное — а это почти всё: люди болтают между собой; объявления бытовой техники и робота-пылесоса ("определение местоположения", "возвращаюсь на базу для зарядки", "уборка завершена"); светская болтовня, шутки, эмоции; обрывки и галлюцинации распознавания речи. Сомневаешься — {"react":false}. Лишняя реплика ассистента раздражает сильнее, чем пропущенная.
Примеры:
Реплики: "чистка пылесосов и влажная уборка завершены возвращаюсь на базу для зарядки" -> {"react":false}
Реплики: "местоположение успешно определено" -> {"react":false}
Реплики: "ну он вот свое всегда вылизывает ха ха да ладно давай пока" -> {"react":false}
Реплики: "слушай а какая завтра погода не помнишь" -> {"react":true}
Реплики: "блин надо не забыть через час позвонить маме" -> {"react":true}
Реплики: "да я вчера кино смотрел норм такое" -> {"react":false}
EOF

# Extract a boolean verdict field robustly: the value may be boolean or a quoted string, with or
# without spaces ({"wake":false} / {"wake": false} / {"wake":"false"}). We look ONLY at the named
# field, not a bare "false" anywhere in prose — a thinking model's reasoning contains both words and
# must not be mined for a verdict. Unparseable (no field at all) is echoed as "" for the caller.
field_value() {   # $1 = field name; stdin: model output; echoes "true" | "false" | ""
  grep -oiE "\"$1\"[[:space:]]*:[[:space:]]*\"?(true|false)" | head -n1 \
    | grep -oiE '(true|false)$' | tr 'A-Z' 'a-z'
}
wake_value() { field_value wake; }   # name path; unchanged contract (caught by caller as fail-open)

# model_raw <model> <prompt>: the ONE invocation the gate makes — every consumer (decide, --test,
# mesh-model-bench's parse probe) must go through it or mirror it exactly, so a fix here is a fix
# everywhere (a rule asserted at one call site is not asserted).
# --think=false is load-bearing: without it a thinking-family model (qwen3.5) spends the turn in the
# thinking channel and the content degenerates to '{}'/ramble → UNPARSED regardless of competence.
# Harmless on non-thinking models (qwen2.5:3b answers identically, verified 2026-07-16).
model_raw() {   # echoes the model's raw one-line output; non-zero on timeout/backend failure
  timeout "$TIMEOUT" ollama run "$1" --think=false --format json "$2" 2>/dev/null | tr -d '\n'
}

# decide: reads the recent dialog on stdin (candidate = LAST non-empty line), returns 0=wake 1=ignore.
decide() {
  local model dialog candidate ctx out v
  model="${ROOM_ADDRESS_MODEL:-$MODEL_DEFAULT}"   # read per call, so a runtime override really lands
  dialog="$(cat)"
  candidate="$(printf '%s\n' "$dialog" | grep -v '^[[:space:]]*$' | tail -n 1)"
  # everything before the candidate = context (last ~6 lines is plenty; the gate is per-episode)
  ctx="$(printf '%s\n' "$dialog" | grep -v '^[[:space:]]*$' | sed '$d' | tail -n 6)"
  [ -n "$candidate" ] || return 0                                     # nothing to judge → wake
  command -v ollama >/dev/null 2>&1 || return 0                       # no ollama → wake
  local q="$PROMPT
Разговор:
$ctx
ПОСЛЕДНЯЯ: \"$candidate\""
  out="$(model_raw "$model" "$q")" || return 0
  v="$(printf '%s' "$out" | wake_value)"
  [ "$v" = false ] && return 1                                        # the ONLY path to silence
  return 0                                                            # true, empty, unparseable → wake
}

# Back-compat single-line: `mesh-room-address "<line>"` judges that one line with no context.
addressed() { printf '%s\n' "$1" | decide; }

# The AMBIENT gate. Reads the fresh room block on stdin, judges the WHOLE block (no single candidate —
# a proactive look-in is about the accumulated speech, not one line). Returns 0=REACT (poke the mind),
# 1=SILENT. FAILS CLOSED (any gate error → silent), the opposite of decide(), and logs every outcome
# LOUD so a broken gate is never mistaken for a quiet room. Each log line: <iso> <verdict> model=<m>
# "<one-line digest of the block>".
gate_log() {   # $1=verdict word, $2=model, $3=digest
  printf '%s %s model=%s "%s"\n' "$(date -Is 2>/dev/null || echo -)" "$1" "$2" "${3:0:120}" >> "$AMBIENT_GATE_LOG" 2>/dev/null || true
}
decide_ambient() {
  local model block digest out v
  local TIMEOUT="$AMBIENT_TIMEOUT"                        # dynamic-scoped into model_raw's call below
  model="${ROOM_AMBIENT_MODEL:-$AMBIENT_MODEL_DEFAULT}"   # read per call so a runtime override lands
  block="$(cat)"
  block="$(printf '%s\n' "$block" | grep -v '^[[:space:]]*$')"   # drop blank lines
  digest="$(printf '%s' "$block" | tr '\n' ' ' | tr -s ' ')"
  [ -n "$block" ] || { gate_log SILENT-empty "$model" ""; return 1; }        # nothing → don't poke
  command -v ollama >/dev/null 2>&1 || { gate_log ERROR-no-ollama "$model" "$digest"; return 1; }
  out="$(model_raw "$model" "$AMBIENT_PROMPT
Реплики: \"$digest\"")" || { gate_log ERROR-backend "$model" "$digest"; return 1; }
  v="$(printf '%s' "$out" | field_value react)"
  case "$v" in
    true)  gate_log REACT  "$model" "$digest"; return 0 ;;
    false) gate_log SILENT "$model" "$digest"; return 1 ;;
    *)     gate_log ERROR-unparsed "$model" "$digest"; return 1 ;;   # fail CLOSED, but LOUD
  esac
}

if [ "${1:-}" = --test ]; then
  f=0
  # capture the list, then grep the variable: `ollama list | grep -q` dies rc=141 under pipefail
  # (grep -q's early exit SIGPIPEs the producer) — and it fails MORE the longer the model list gets.
  olist="$(ollama list 2>/dev/null)"
  if ! command -v ollama >/dev/null 2>&1 || ! grep -q "${MODEL_DEFAULT%%:*}" <<<"$olist"; then
    echo "  n/a: ollama/$MODEL_DEFAULT not present here (exit 2) — the gate fails OPEN, reflex still wakes"
    exit 2
  fi
  # REAL room speech from the 2026-07-14 false-wake storm — must never go deaf on these.
  for s in 'Миша, ты нас слышишь сейчас или нет? По-моему, нет.' \
           'Ага, Миша, вот есть такая интересная к тебе задача. Сейчас...' \
           'Ну вот, Миш, плохо слушать, потому что как-то прерывается всё' \
           'Миш, кстати, а ты видишь...' \
           'Миша, я смотрю, опять транскрипт'; do
    addressed "$s" || { echo "  FAIL: went DEAF on a real address: '$s'"; f=1; }
  done
  for s in 'Время' 'Поехали.' 'КОНЕЦ' 'Компания' 'Играет музыка.' \
           'Время, которое мы не можем сделать, мы можем сделать это.'; do
    addressed "$s" && { echo "  FAIL: woke on junk: '$s'"; f=1; }
  done
  # A real address that only makes sense WITH context (continuation) must still wake — never-deaf.
  printf '%s\n' 'Миш, а посмотри что там' 'по погоде на завтра?' | decide \
    || { echo "  FAIL: went deaf on a context-continued address"; f=1; }
  # THIRD-PERSON PRECISION is BEST-EFFORT, not a gate. Measured 2026-07-16: under the never-deaf
  # constraint, qwen2.5:3b cannot reliably tell "как думаешь, Миша прав?" (third-person, to a human)
  # from an address without risking deafness — and a coin-flip assertion makes a FLAKY gate that
  # teaches you to re-run until green (the stochastic-gate trap). So we REPORT these, never fail on
  # them. The hard gates above are never-deaf + fail-open + parser. When a better non-thinking model
  # lands, re-run the wakegate-ru-01 bench: THAT is where the context window earns its keep.
  tp=0
  printf '%s\n' 'Как думаешь, Миша был прав вчера?' | decide && tp=$((tp+1))
  printf '%s\n' 'Смотри какие мишки на витрине' 'Да, милые, очень' | decide && tp=$((tp+1))
  printf '%s\n' 'Повесь мишуру повыше' | decide && tp=$((tp+1))
  echo "  info: third-person/false-friend false-wakes this run: $tp/3 (best-effort, not gated)"
  # the load-bearing property: a broken backend must WAKE, never silence
  ROOM_ADDRESS_MODEL='no-such-model-xyz' addressed 'Время' \
    || { echo "  FAIL: did not fail OPEN when the model is missing"; f=1; }
  # parser unit-check: a thinking-style wrapper with no wake field must be unparseable → wake
  [ -z "$(printf '%s' 'Thinking... {"reasoning_content":"...false..."}' | wake_value)" ] \
    || { echo "  FAIL: wake_value mined a verdict out of prose (would misread a thinking model)"; f=1; }
  # INVOCATION gate: a THINKING-family model driven through the gate's own model_raw must yield a
  # readable wake field. Without think handling the thinking channel eats the answer and content
  # degenerates to '{}'/ramble → every thinking model reads UNPARSED however competent it is
  # (2026-07-16: all three qwen3.5 disqualified identically; by hand they answer fine). Real read,
  # skipped honestly when no thinking model is pulled here.
  tmodel="$(awk '$1 ~ /^qwen3\.5:/ {print $1}' <<<"$olist" | sort | head -n1)"
  if [ -n "$tmodel" ]; then
    traw="$(TIMEOUT=60 model_raw "$tmodel" 'Ответь строго одним JSON-объектом вида {"wake":true} или {"wake":false}. Обращаются ли к Мише в реплике: "Время"')"
    [ -n "$(printf '%s' "$traw" | wake_value)" ] \
      || { echo "  FAIL: invocation loses the wake field on thinking model $tmodel — raw: ${traw:0:80}"; f=1; }
  else
    echo "  info: no qwen3.5:* pulled — thinking-model invocation gate skipped"
  fi
  [ "$(printf '%s' '{"wake": "false"}' | wake_value)" = false ] \
    || { echo "  FAIL: wake_value cannot read a quoted/ spaced false"; f=1; }

  # ---- AMBIENT gate (--ambient / decide_ambient) : fails CLOSED but LOUD ----
  gl="$(mktemp)"; AMBIENT_GATE_LOG="$gl"
  # the react field parses exactly like wake (quoted/spaced/bare)
  [ "$(printf '%s' '{"react": "false"}' | field_value react)" = false ] \
    || { echo "  FAIL: field_value cannot read a quoted/spaced react:false"; f=1; }
  [ "$(printf '%s' '{"react":true}' | field_value react)" = true ] \
    || { echo "  FAIL: field_value cannot read react:true"; f=1; }
  # LOAD-BEARING: EVERY gate-error path must STAY SILENT (exit 1) AND leave a loud, PATH-SPECIFIC
  # ERROR log line — never a quiet-room-looking silent swallow (the canonical silent-fallback trap).
  # Three distinct paths, each asserted hermetically with a stub `ollama`, so a mutation to any one
  # of the three return-1s goes red (an un-asserted return-1 is not a gate — a blanket grep 'ERROR'
  # would pass against a mutation that broke a DIFFERENT path).
  astub="$(mktemp -d)"
  # (a) backend failure: the model invocation exits non-zero (timeout / model not loaded)
  : > "$gl"; printf '#!/usr/bin/env bash\nexit 1\n' > "$astub/ollama"; chmod +x "$astub/ollama"
  PATH="$astub:$PATH" decide_ambient <<<'робот пылесос возвращается на базу' \
    && { echo "  FAIL: ambient gate did not fail CLOSED on a backend error"; f=1; }
  grep -q 'ERROR-backend' "$gl" || { echo "  FAIL: backend error not logged loud"; f=1; }
  # (b) unparseable output: the model answers but with no react field (garbage / a thinking ramble)
  : > "$gl"; printf '#!/usr/bin/env bash\necho "по-моему да наверное"\n' > "$astub/ollama"; chmod +x "$astub/ollama"
  PATH="$astub:$PATH" decide_ambient <<<'робот пылесос возвращается на базу' \
    && { echo "  FAIL: ambient gate did not fail CLOSED on unparseable output"; f=1; }
  grep -q 'ERROR-unparsed' "$gl" || { echo "  FAIL: unparsed output not logged loud"; f=1; }
  # (c) no ollama at all → command -v fails
  : > "$gl"; PATH='/usr/bin:/bin' decide_ambient <<<'робот пылесос возвращается на базу' \
    && { echo "  FAIL: ambient gate did not fail CLOSED when ollama is absent"; f=1; }
  grep -q 'ERROR-no-ollama' "$gl" || { echo "  FAIL: no-ollama not logged loud"; f=1; }
  # a REACT verdict must POKE (exit 0) and log REACT — the gate is a decision, not a constant "silent"
  : > "$gl"; printf '#!/usr/bin/env bash\necho '\''{"react":true}'\''\n' > "$astub/ollama"; chmod +x "$astub/ollama"
  PATH="$astub:$PATH" decide_ambient <<<'какая завтра погода' \
    || { echo "  FAIL: ambient gate stayed SILENT on an explicit react:true (gate is a constant, not a decision)"; f=1; }
  grep -q 'REACT' "$gl" || { echo "  FAIL: react verdict not logged"; f=1; }
  rm -rf "$astub"
  # empty block → silent + logged, never a poke
  : > "$gl"; decide_ambient <<<'' && { echo "  FAIL: ambient gate poked on an empty block"; f=1; }
  [ -s "$gl" ] || { echo "  FAIL: ambient gate did not log the empty-block silence"; f=1; }
  # INVOCATION on the REAL ambient model: it must run and emit a PARSEABLE react field here (catches
  # the rc=127 / unparsed class). Accuracy (silent-vs-react) is BEST-EFFORT/reported — the
  # wakegate-ru-01 bench is where it is measured, not a flaky unit assertion. Skipped honestly where
  # gemma4 is not pulled.
  if grep -q "$AMBIENT_MODEL_DEFAULT" <<<"$olist"; then
    araw="$(TIMEOUT="$AMBIENT_TIMEOUT" model_raw "$AMBIENT_MODEL_DEFAULT" "$AMBIENT_PROMPT
Реплики: \"робот пылесос возвращается на базу для зарядки\"")"
    [ -n "$(printf '%s' "$araw" | field_value react)" ] \
      || { echo "  FAIL: ambient model $AMBIENT_MODEL_DEFAULT emits no parseable react field — raw: ${araw:0:80}"; f=1; }
    an=0
    : > "$gl"; decide_ambient <<<'чистка пылесосов завершена возвращаюсь на базу для зарядки' || an=$((an+1))
    : > "$gl"; decide_ambient <<<'местоположение успешно определено' || an=$((an+1))
    echo "  info: ambient gate stayed silent on $an/2 appliance-noise samples (best-effort, not gated)"
  else
    echo "  info: $AMBIENT_MODEL_DEFAULT not pulled — ambient invocation gate skipped"
  fi
  rm -f "$gl"

  [ "$f" = 0 ] && echo "  PASS: real corpus + context gate + fail-open (name) + fail-closed-loud (ambient) + parser" || exit 1
  exit 0
fi

[ $# -ge 1 ] || { echo "usage: mesh-room-address \"<line>\"   # or: printf dialog | mesh-room-address --window|--ambient   (exit 0=wake/react 1=ignore/silent)" >&2; exit 0; }
case "$1" in
  --window)  decide ;;                 # name path: is the last line addressed to Misha? (fail OPEN)
  --ambient) decide_ambient ;;         # ambient path: is unaddressed chatter worth a word? (fail CLOSED, loud)
  *)         addressed "$*" ;;
esac
