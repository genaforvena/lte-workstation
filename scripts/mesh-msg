#!/usr/bin/env bash
# mesh-msg — append an EVENT/message to a channel's message tape (operator 2026-06-21: the top pane
# splits into STATE (read-latest, ephemeral) + MESSAGES (push-on-arrival). This is the PRODUCER for the
# messages lane.) Producers of DISCRETE FACTS — an arrival, a new LAN device, a threshold crossing, an
# operator note, a [task] — write here; the paired `mesh-msg-pane <channel>` shows the tape always-visible
# AND pushes each new line to the mind at-least-once (edge-delivery). Unlike STATE (latest-value, history
# is noise), a message is the ONLY copy of its fact — so it is logged to a tape, not a re-derived snapshot.
#
#   mesh-msg <channel> "<text>"     append one event line to ~/.mesh/msg/<channel>.log
#   mesh-msg --test                 smoke
set -uo pipefail
MSGDIR="$HOME/.mesh/msg"

if [ "${1:-}" = --test ]; then
  mkdir -p "$MSGDIR" || { echo "smoke-test: FAIL (msgdir)"; exit 1; }
  t="$MSGDIR/.selftest.log"; : > "$t"
  MSGDIR="$MSGDIR" bash -c 'printf "%s  %s\n" x y >> "'"$t"'"' && [ -s "$t" ] || { echo "smoke-test: FAIL (append)"; exit 1; }
  rm -f "$t"; echo "smoke-test: ok (event-tape producer; pairs with mesh-msg-pane)"; exit 0
fi

ch="${1:?usage: mesh-msg <channel> \"text\"}"; shift || true
text="$*"; [ -n "$text" ] || { echo "mesh-msg: empty message" >&2; exit 1; }
mkdir -p "$MSGDIR"
printf '%s  %s\n' "$(date -u +%FT%TZ)" "$text" >> "$MSGDIR/$ch.log"
