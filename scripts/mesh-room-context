#!/usr/bin/env bash
# reflex-cadence: 2-59/5 * * * *
# reflex-args: --edge
# mesh-room-context — ROOM SOCIAL CONTEXT: fuses ambient-clock (neighbor TV activity) +
# room-sense (local occupancy) + activity-tempo (local activity level) into a single
# room context label no individual sense gives.
#
# ambient-clock alone: "neighbors' TVs are on" — no info about this room.
# room-sense alone:    "someone is in the room" — no activity or social context.
# activity-tempo alone:"the room is BUSTLE" — no occupancy or neighbor context.
# Fused:              "someone is here, active, and neighbors are home too" → ENGAGED
#
# Honest-fusion contract (no silent all-clear):
#   A STALE or MISSING input is rendered in the degraded list and prevents a confident
#   label — the fusion produces "DEGRADED" or suffixes "(no-<axis>)" visibly different
#   from a genuine clean reading. Exit 2 only when ALL inputs are unreachable.
#
# Labels:
#   ENGAGED-ACTIVE  — occupied + activity + neighbors on TVs (socially active room)
#   ENGAGED-QUIET   — occupied + no local activity + neighbors on TVs (occupied but still)
#   SOLO-ACTIVE     — occupied + activity + no neighbor signal
#   SOLO-QUIET      — occupied + still + no neighbor signal
#   PEER-ACTIVE     — empty + neighbors on TVs (proxy activity from neighbors)
#   VACANT          — empty + no activity + no neighbor signal
#   NIGHT-STILL     — empty + late night/quiet hours (NIGHT-QUIET ambient)
#   AMBIGUOUS       — room occupancy uncertain + conflicting/mixed signals
#   DEGRADED:<why>  — one or more inputs stale/unavailable (visibly distinct from clean)
#   Exit 2          — all inputs unreachable
#
# Usage:
#   mesh-room-context            one-shot label
#   mesh-room-context --edge     emit only on label change (for cron)
#   mesh-room-context --json     machine-readable {label, inputs, degraded, ts}
#   mesh-room-context --test     smoke test (synthetic state files, no network)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
MESH="${MESH_DIR:-$HOME/.mesh}"
STATE="$MESH/.room-context.state"

# Staleness thresholds (must exceed the reflex cadence of each input tool):
#   room-sense:       /5  (300s stride) → 1200s (20min)
#   activity-tempo:   /10 (600s stride) → 2100s (35min)
#   ambient-clock:    /10 (600s stride) → 2100s (35min)
ROOM_STALE="${MESH_ROOM_CONTEXT_ROOM_STALE:-1200}"
TEMPO_STALE="${MESH_ROOM_CONTEXT_TEMPO_STALE:-2100}"
AMBIENT_STALE="${MESH_ROOM_CONTEXT_AMBIENT_STALE:-2100}"
# Our own staleness limit (how old can .room-context.state be before we're the stale one):
MINE_STALE="${MESH_ROOM_CONTEXT_STALE:-1800}"

# ---- Helpers ----
_read_state() {
  local f="$1" lim="${2:-1800}"
  [ -f "$f" ] || { echo "MISSING"; return; }
  local mtime age
  mtime="$(stat -c %Y "$f" 2>/dev/null || echo 0)"
  [ "$mtime" -gt 0 ] || { echo "MISSING"; return; }
  age=$(( $(date +%s) - mtime ))
  if [ "$age" -gt "$lim" ]; then
    echo "STALE"
  else
    head -1 "$f" 2>/dev/null || echo "UNREADABLE"
  fi
}

# ---- Smoke test ----
if [ "${1:-}" = --test ]; then
  command -v python3 >/dev/null 2>&1 || { echo "smoke-test: FAIL (no python3)"; exit 1; }
  _f=0

  # Synthetic state directory for hermetic fixtures
  _td="$(mktemp -d)"
  _rc_room="$_td/.room-sense.state"
  _rc_tempo="$_td/.activity-tempo.state"
  _rc_ambient="$_td/.ambient-clock.state"

  # Helper: stamp a state file with content and recent mtime
  _stamp() { printf '%s\n' "$1" > "$2"; touch -d '-1 min' "$2"; }
  _stale() { printf '%s\n' "$1" > "$2"; touch -d '-2 hour' "$2"; }

  # All tests run with MESH_DIR pointing to the temp dir (isolated from real state)
  _run() { MESH_DIR="$_td" "$0" --json 2>/dev/null || true; }

  # ---- Test 1: ENGAGED-ACTIVE (PRESENT + BUSTLE + ACTIVE) ----
  _stamp PRESENT "$_rc_room"; _stamp BUSTLE "$_rc_tempo"; _stamp ACTIVE "$_rc_ambient"
  _out="$(_run)"
  _label="$(printf '%s' "$_out" | python3 -c 'import sys,json; print(json.load(sys.stdin).get("label","?"))' 2>/dev/null)"
  [ "$_label" = "ENGAGED-ACTIVE" ] || { echo "  FAIL: T1 label=ENGAGED-ACTIVE got=$_label"; _f=1; }

  # ---- Test 2: SOLO-QUIET (PRESENT + RESTING + QUIET) ----
  _stamp PRESENT "$_rc_room"; _stamp RESTING "$_rc_tempo"; _stamp QUIET "$_rc_ambient"
  _out="$(_run)"
  _label="$(printf '%s' "$_out" | python3 -c 'import sys,json; print(json.load(sys.stdin).get("label","?"))' 2>/dev/null)"
  [ "$_label" = "SOLO-QUIET" ] || { echo "  FAIL: T2 label=SOLO-QUIET got=$_label"; _f=1; }

  # ---- Test 3: VACANT (EMPTY + SILENT + QUIET) ----
  _stamp EMPTY "$_rc_room"; _stamp SILENT "$_rc_tempo"; _stamp QUIET "$_rc_ambient"
  _out="$(_run)"
  _label="$(printf '%s' "$_out" | python3 -c 'import sys,json; print(json.load(sys.stdin).get("label","?"))' 2>/dev/null)"
  [ "$_label" = "VACANT" ] || { echo "  FAIL: T3 label=VACANT got=$_label"; _f=1; }

  # ---- Test 4: PEER-ACTIVE (EMPTY + SILENT + ACTIVE) ----
  _stamp EMPTY "$_rc_room"; _stamp SILENT "$_rc_tempo"; _stamp ACTIVE "$_rc_ambient"
  _out="$(_run)"
  _label="$(printf '%s' "$_out" | python3 -c 'import sys,json; print(json.load(sys.stdin).get("label","?"))' 2>/dev/null)"
  [ "$_label" = "PEER-ACTIVE" ] || { echo "  FAIL: T4 label=PEER-ACTIVE got=$_label"; _f=1; }

  # ---- Test 5: NIGHT-STILL (EMPTY + SILENT + NIGHT-QUIET) ----
  _stamp EMPTY "$_rc_room"; _stamp SILENT "$_rc_tempo"; _stamp NIGHT-QUIET "$_rc_ambient"
  _out="$(_run)"
  _label="$(printf '%s' "$_out" | python3 -c 'import sys,json; print(json.load(sys.stdin).get("label","?"))' 2>/dev/null)"
  [ "$_label" = "NIGHT-STILL" ] || { echo "  FAIL: T5 label=NIGHT-STILL got=$_label"; _f=1; }

  # ---- Test 6: AMBIGUOUS (UNCERTAIN room) ----
  _stamp UNCERTAIN "$_rc_room"; _stamp BUSTLE "$_rc_tempo"; _stamp ACTIVE "$_rc_ambient"
  _out="$(_run)"
  _label="$(printf '%s' "$_out" | python3 -c 'import sys,json; print(json.load(sys.stdin).get("label","?"))' 2>/dev/null)"
  [ "$_label" = "AMBIGUOUS" ] || { echo "  FAIL: T6 label=AMBIGUOUS got=$_label"; _f=1; }

  # ---- Test 7: STALE input → DEGRADED (room stale) ----
  _stale PRESENT "$_rc_room"; _stamp BUSTLE "$_rc_tempo"; _stamp ACTIVE "$_rc_ambient"
  _out="$(_run)"
  _label="$(printf '%s' "$_out" | python3 -c 'import sys,json; print(json.load(sys.stdin).get("label","?"))' 2>/dev/null)"
  _deg="$(printf '%s' "$_out" | python3 -c 'import sys,json; print(json.load(sys.stdin).get("degraded",""))' 2>/dev/null)"
  [ "$_label" = "DEGRADED" ] || { echo "  FAIL: T7 label=DEGRADED got=$_label"; _f=1; }
  printf '%s' "$_deg" | grep -q 'room-sense' || { echo "  FAIL: T7 degraded should mention room-sense (got: $_deg)"; _f=1; }

  # ---- Test 8: MISSING input → DEGRADED (tempo missing) ----
  _stamp PRESENT "$_rc_room"; rm -f "$_rc_tempo"; _stamp ACTIVE "$_rc_ambient"
  _out="$(_run)"
  _label="$(printf '%s' "$_out" | python3 -c 'import sys,json; print(json.load(sys.stdin).get("label","?"))' 2>/dev/null)"
  [ "$_label" = "DEGRADED" ] || { echo "  FAIL: T8 label=DEGRADED got=$_label"; _f=1; }

  # ---- Test 9: ENGAGED-QUIET (PRESENT + RESTING/SILENT + ACTIVE) ----
  _stamp PRESENT "$_rc_room"; _stamp RESTING "$_rc_tempo"; _stamp ACTIVE "$_rc_ambient"
  _out="$(_run)"
  _label="$(printf '%s' "$_out" | python3 -c 'import sys,json; print(json.load(sys.stdin).get("label","?"))' 2>/dev/null)"
  [ "$_label" = "ENGAGED-QUIET" ] || { echo "  FAIL: T9 label=ENGAGED-QUIET got=$_label"; _f=1; }

  # ---- Test 10: SOLO-ACTIVE (PRESENT + BUSTLE + QUIET) ----
  _stamp PRESENT "$_rc_room"; _stamp BUSTLE "$_rc_tempo"; _stamp QUIET "$_rc_ambient"
  _out="$(_run)"
  _label="$(printf '%s' "$_out" | python3 -c 'import sys,json; print(json.load(sys.stdin).get("label","?"))' 2>/dev/null)"
  [ "$_label" = "SOLO-ACTIVE" ] || { echo "  FAIL: T10 label=SOLO-ACTIVE got=$_label"; _f=1; }

  rm -rf "$_td"
  [ "$_f" = 0 ] || { echo "smoke-test: FAIL"; exit 1; }
  echo "smoke-test: ok (10 fusion assertions)"
  exit 0
fi

# ---- Read input state files ----
room_raw="$(_read_state "$MESH/.room-sense.state" "$ROOM_STALE")"
tempo_raw="$(_read_state "$MESH/.activity-tempo.state" "$TEMPO_STALE")"
ambient_raw="$(_read_state "$MESH/.ambient-clock.state" "$AMBIENT_STALE")"

# Strip the STALE/MISSING marker for the fusion logic; track degraded axes.
# _read_state returns: STALE / MISSING / UNREADABLE for unreachable inputs,
# or the actual label/verdict content. We split:
#   content = the actual label/verdict (or empty if unreachable)
#   degraded = list of unreachable axes (empty = all healthy)
room=""; tempo=""; ambient=""
degraded=""
[ "$room_raw" = "STALE" ] || [ "$room_raw" = "MISSING" ] || [ "$room_raw" = "UNREADABLE" ] && degraded="${degraded}room-sense" || room="$room_raw"
[ "$tempo_raw" = "STALE" ] || [ "$tempo_raw" = "MISSING" ] || [ "$tempo_raw" = "UNREADABLE" ] || [ "$tempo_raw" = "DEGRADED" ] && degraded="${degraded:+$degraded }tempo" || tempo="$tempo_raw"
# DATA-STALE and DATA-WARMUP are explicit degraded labels from ambient-clock (not fresh readings) —
# treat as unreachable so the fusion shows DEGRADED instead of a confident quiet.
[ "$ambient_raw" = "STALE" ] || [ "$ambient_raw" = "MISSING" ] || [ "$ambient_raw" = "UNREADABLE" ] || [ "$ambient_raw" = "DATA-STALE" ] || [ "$ambient_raw" = "DATA-WARMUP" ] && degraded="${degraded:+$degraded }ambient-clock" || ambient="$ambient_raw"

# Exit 2 only when ALL inputs are unreachable
if [ -z "$room" ] && [ -z "$tempo" ] && [ -z "$ambient" ]; then
  echo "mesh-room-context: all inputs unreachable (room=$room_raw tempo=$tempo_raw ambient=$ambient_raw)"
  exit 2
fi

# ---- Fusion logic ----
label=""
reason=""

if [ -n "$degraded" ]; then
  # One or more inputs stale/missing → cannot produce a confident label
  label="DEGRADED"
  reason="unreachable inputs: $degraded"
elif [ "$room" = "UNCERTAIN" ]; then
  label="AMBIGUOUS"
  reason="room occupancy uncertain (room=$room tempo=$tempo ambient=$ambient)"
elif [ "$room" = "PRESENT" ]; then
  if [ "$ambient" = "ACTIVE" ] || [ "$ambient" = "MODERATE" ]; then
    # Occupied + neighbors on TVs
    case "$tempo" in
      BUSTLE|STIR|DARK_BUSTLE) label="ENGAGED-ACTIVE"; reason="occupied, active, neighbors active (room=$room tempo=$tempo ambient=$ambient)" ;;
      RESTING|SILENT)          label="ENGAGED-QUIET";  reason="occupied, still, neighbors active (room=$room tempo=$tempo ambient=$ambient)" ;;
      *)                       label="ENGAGED-ACTIVE"; reason="occupied, neighbors active (room=$room tempo=$tempo ambient=$ambient)" ;;
    esac
  elif [ "$ambient" = "NIGHT-QUIET" ]; then
    # Occupied during nighttime quiet hours
    case "$tempo" in
      BUSTLE|STIR|DARK_BUSTLE) label="SOLO-ACTIVE"; reason="occupied, active, night hours (room=$room tempo=$tempo ambient=$ambient)" ;;
      RESTING|SILENT)          label="SOLO-QUIET";  reason="occupied, still, night hours (room=$room tempo=$tempo ambient=$ambient)" ;;
      *)                       label="SOLO-QUIET";  reason="occupied, night hours (room=$room tempo=$tempo ambient=$ambient)" ;;
    esac
  else
    # QUIET or other — no neighbor signal
    case "$tempo" in
      BUSTLE|STIR|DARK_BUSTLE) label="SOLO-ACTIVE"; reason="solo active (room=$room tempo=$tempo ambient=$ambient)" ;;
      RESTING|SILENT)          label="SOLO-QUIET";  reason="solo quiet (room=$room tempo=$tempo ambient=$ambient)" ;;
      *)                       label="SOLO-QUIET";  reason="solo (room=$room tempo=$tempo ambient=$ambient)" ;;
    esac
  fi
elif [ "$room" = "EMPTY" ]; then
  if [ "$ambient" = "ACTIVE" ] || [ "$ambient" = "MODERATE" ]; then
    label="PEER-ACTIVE"; reason="empty here, neighbors active (room=$room tempo=$tempo ambient=$ambient)"
  elif [ "$ambient" = "NIGHT-QUIET" ]; then
    label="NIGHT-STILL"; reason="night hours, empty (room=$room tempo=$tempo ambient=$ambient)"
  else
    label="VACANT"; reason="vacant, no activity (room=$room tempo=$tempo ambient=$ambient)"
  fi
else
  # Room is empty/unknown but we have at least one signal
  label="DEGRADED"
  reason="unclassifiable (room=$room_raw tempo=$tempo_raw ambient=$ambient_raw)"
fi

# ---- Output ----
case "${1:-}" in
  --json)
    printf '{"label":"%s","reason":"%s","inputs":{"room":"%s","tempo":"%s","ambient":"%s"},"degraded":"%s","ts":"%s"}\n' \
      "$label" "$reason" "$room_raw" "$tempo_raw" "$ambient_raw" "$degraded" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    ;;
  --edge)
    prev="$(cat "$STATE" 2>/dev/null || echo "")"
    if [ "$label" != "$prev" ]; then
      printf '%s\n' "$label" > "$STATE"
      printf '%s — %s\n' "$label" "$reason"
    fi
    mesh-state-touch "$STATE"
    ;;
  *)
    printf '%s — %s\n' "$label" "$reason"
    printf '%s\n' "$label" > "$STATE"
    mesh-state-touch "$STATE"
    ;;
esac
exit 0
