#!/usr/bin/env bash
# reflex-cadence: 2-59/5 * * * *
# reflex-args: --edge
# mesh-room-context — ROOM SOCIAL CONTEXT: fuses ambient-clock (neighbor TV activity) +
# room-sense (local occupancy) + activity-tempo (local activity level) + ambient light
# into a single room context label no individual sense gives.
#
# ambient-clock alone: "neighbors' TVs are on" — no info about this room.
# room-sense alone:    "someone is in the room" — no activity or social context.
# activity-tempo alone:"the room is BUSTLE" — no occupancy or neighbor context.
# light alone:         "the room is dark/bright" — no occupancy or neighbor context.
# Fused:              "someone is here, active, lit/dark, and neighbors are home too" → ENGAGED
#
# Honest-fusion contract (no silent all-clear):
#   A STALE or MISSING input is rendered in the degraded list and prevents a clean
#   all-clear — the fusion produces "DEGRADED" or suffixes "(no-<axis>)" visibly
#   different from a genuine clean reading. Exit 2 only when ALL inputs are unreachable.
#
# Labels:
#   ENGAGED-ACTIVE  — occupied + activity + neighbors on TVs (socially active room)
#   ENGAGED-QUIET   — occupied + no local activity + neighbors on TVs (occupied but still)
#   SOLO-ACTIVE     — occupied + activity + no neighbor signal
#   SOLO-QUIET      — occupied + still + no neighbor signal
#   PEER-ACTIVE     — empty + neighbors on TVs and local tempo is active
#   PEER-QUIET      — empty + neighbors on TVs but local tempo is quiet
#   VACANT          — empty + no activity + no neighbor signal
#   NIGHT-STILL     — empty + late night/quiet hours + dark/dim room
#   AMBIGUOUS       — room occupancy uncertain + conflicting/mixed signals
#   DEGRADED:<why>  — one or more inputs stale/unavailable (visibly distinct from clean)
#   Exit 2          — all inputs unreachable
#
# Secondary derived axis:
#   scene           — a coarse cross-sense mix tag (social-active / vacant-night / degraded / ...)
#
# Usage:
#   mesh-room-context            one-shot label
#   mesh-room-context --edge     emit only on label change (for cron)
#   mesh-room-context --json     machine-readable {label, inputs, degraded, ts}
#   mesh-room-context --test     smoke test (synthetic state files, no network)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
MESH="${MESH_DIR:-$HOME/.mesh}"
STATE="$MESH/.room-context.state"

# Staleness thresholds (must exceed the reflex cadence of each input tool):
#   room-sense:       /5  (300s stride) → 1200s (20min)
#   activity-tempo:   /10 (600s stride) → 2100s (35min)
#   ambient-clock:    /10 (600s stride) → 2100s (35min)
#   light:            /10 (600s stride) → 2100s (35min)
ROOM_STALE="${MESH_ROOM_CONTEXT_ROOM_STALE:-1200}"
TEMPO_STALE="${MESH_ROOM_CONTEXT_TEMPO_STALE:-2100}"
AMBIENT_STALE="${MESH_ROOM_CONTEXT_AMBIENT_STALE:-2100}"
LIGHT_STALE="${MESH_ROOM_CONTEXT_LIGHT_STALE:-2100}"
# Our own staleness limit (how old can .room-context.state be before we're the stale one):
MINE_STALE="${MESH_ROOM_CONTEXT_STALE:-1800}"

# ---- Helpers ----
_read_state() {
  local f="$1" lim="${2:-1800}"
  [ -f "$f" ] || { echo "MISSING"; return; }
  local mtime age
  mtime="$(stat -c %Y "$f" 2>/dev/null || echo 0)"
  [ "$mtime" -gt 0 ] || { echo "MISSING"; return; }
  age=$(( $(date +%s) - mtime ))
  if [ "$age" -gt "$lim" ]; then
    echo "STALE"
  else
    head -1 "$f" 2>/dev/null || echo "UNREADABLE"
  fi
}

# ---- Smoke test ----
if [ "${1:-}" = --test ]; then
  command -v python3 >/dev/null 2>&1 || { echo "smoke-test: FAIL (no python3)"; exit 1; }
  _f=0

  # Synthetic state directory for hermetic fixtures
  _td="$(mktemp -d)"
  _rc_room="$_td/.room-sense.state"
  _rc_tempo="$_td/.activity-tempo.state"
  _rc_ambient="$_td/.ambient-clock.state"
  _rc_light="$_td/.light-state"

  # Helper: stamp a state file with content and recent mtime
  _stamp() { printf '%s\n' "$1" > "$2"; touch -d '-1 min' "$2"; }
  _stale() { printf '%s\n' "$1" > "$2"; touch -d '-2 hour' "$2"; }

  # All tests run with MESH_DIR pointing to the temp dir (isolated from real state)
  _run() { MESH_DIR="$_td" "$0" --json 2>/dev/null || true; }

  # ---- Test 1: ENGAGED-ACTIVE (PRESENT + BUSTLE + ACTIVE) ----
  _stamp PRESENT "$_rc_room"; _stamp BUSTLE "$_rc_tempo"; _stamp ACTIVE "$_rc_ambient"; _stamp LIT "$_rc_light"
  _out="$(_run)"
  _label="$(printf '%s' "$_out" | python3 -c 'import sys,json; print(json.load(sys.stdin).get("label","?"))' 2>/dev/null)"
  _scene="$(printf '%s' "$_out" | python3 -c 'import sys,json; print(json.load(sys.stdin).get("scene","?"))' 2>/dev/null)"
  [ "$_label" = "ENGAGED-ACTIVE" ] || { echo "  FAIL: T1 label=ENGAGED-ACTIVE got=$_label"; _f=1; }
  [ "$_scene" = "social-active" ] || { echo "  FAIL: T1 scene=social-active got=$_scene"; _f=1; }

  # ---- Test 2: SOLO-QUIET (PRESENT + RESTING + QUIET) ----
  _stamp PRESENT "$_rc_room"; _stamp RESTING "$_rc_tempo"; _stamp QUIET "$_rc_ambient"; _stamp DARK "$_rc_light"
  _out="$(_run)"
  _label="$(printf '%s' "$_out" | python3 -c 'import sys,json; print(json.load(sys.stdin).get("label","?"))' 2>/dev/null)"
  [ "$_label" = "SOLO-QUIET" ] || { echo "  FAIL: T2 label=SOLO-QUIET got=$_label"; _f=1; }

  # ---- Test 3: VACANT (EMPTY + SILENT + QUIET) ----
  _stamp EMPTY "$_rc_room"; _stamp SILENT "$_rc_tempo"; _stamp QUIET "$_rc_ambient"; _stamp DARK "$_rc_light"
  _out="$(_run)"
  _label="$(printf '%s' "$_out" | python3 -c 'import sys,json; print(json.load(sys.stdin).get("label","?"))' 2>/dev/null)"
  [ "$_label" = "VACANT" ] || { echo "  FAIL: T3 label=VACANT got=$_label"; _f=1; }

  # ---- Test 4: PEER-ACTIVE (EMPTY + BUSTLE + ACTIVE) ----
  _stamp EMPTY "$_rc_room"; _stamp BUSTLE "$_rc_tempo"; _stamp ACTIVE "$_rc_ambient"; _stamp BRIGHT "$_rc_light"
  _out="$(_run)"
  _label="$(printf '%s' "$_out" | python3 -c 'import sys,json; print(json.load(sys.stdin).get("label","?"))' 2>/dev/null)"
  [ "$_label" = "PEER-ACTIVE" ] || { echo "  FAIL: T4 label=PEER-ACTIVE got=$_label"; _f=1; }

  # ---- Test 5: PEER-QUIET (EMPTY + RESTING + ACTIVE) ----
  _stamp EMPTY "$_rc_room"; _stamp RESTING "$_rc_tempo"; _stamp ACTIVE "$_rc_ambient"; _stamp BRIGHT "$_rc_light"
  _out="$(_run)"
  _label="$(printf '%s' "$_out" | python3 -c 'import sys,json; print(json.load(sys.stdin).get("label","?"))' 2>/dev/null)"
  [ "$_label" = "PEER-QUIET" ] || { echo "  FAIL: T5 label=PEER-QUIET got=$_label"; _f=1; }

  # ---- Test 6: NIGHT-STILL (EMPTY + SILENT + NIGHT-QUIET) ----
  _stamp EMPTY "$_rc_room"; _stamp SILENT "$_rc_tempo"; _stamp NIGHT-QUIET "$_rc_ambient"; _stamp DARK "$_rc_light"
  _out="$(_run)"
  _label="$(printf '%s' "$_out" | python3 -c 'import sys,json; print(json.load(sys.stdin).get("label","?"))' 2>/dev/null)"
  [ "$_label" = "NIGHT-STILL" ] || { echo "  FAIL: T6 label=NIGHT-STILL got=$_label"; _f=1; }

  # ---- Test 7: AMBIGUOUS (UNCERTAIN room) ----
  _stamp UNCERTAIN "$_rc_room"; _stamp BUSTLE "$_rc_tempo"; _stamp ACTIVE "$_rc_ambient"; _stamp LIT "$_rc_light"
  _out="$(_run)"
  _label="$(printf '%s' "$_out" | python3 -c 'import sys,json; print(json.load(sys.stdin).get("label","?"))' 2>/dev/null)"
  [ "$_label" = "AMBIGUOUS" ] || { echo "  FAIL: T7 label=AMBIGUOUS got=$_label"; _f=1; }

  # ---- Test 8: STALE input → DEGRADED (room stale) ----
  _stale PRESENT "$_rc_room"; _stamp BUSTLE "$_rc_tempo"; _stamp ACTIVE "$_rc_ambient"; _stamp LIT "$_rc_light"
  _out="$(_run)"
  _label="$(printf '%s' "$_out" | python3 -c 'import sys,json; print(json.load(sys.stdin).get("label","?"))' 2>/dev/null)"
  _scene="$(printf '%s' "$_out" | python3 -c 'import sys,json; print(json.load(sys.stdin).get("scene","?"))' 2>/dev/null)"
  _deg="$(printf '%s' "$_out" | python3 -c 'import sys,json; print(json.load(sys.stdin).get("degraded",""))' 2>/dev/null)"
  [ "$_label" = "DEGRADED" ] || { echo "  FAIL: T8 label=DEGRADED got=$_label"; _f=1; }
  [ "$_scene" = "degraded" ] || { echo "  FAIL: T8 scene=degraded got=$_scene"; _f=1; }
  printf '%s' "$_deg" | grep -q 'room-sense' || { echo "  FAIL: T8 degraded should mention room-sense (got: $_deg)"; _f=1; }

  # ---- Test 9: MISSING input → DEGRADED (tempo missing) ----
  _stamp PRESENT "$_rc_room"; rm -f "$_rc_tempo"; _stamp ACTIVE "$_rc_ambient"; _stamp LIT "$_rc_light"
  _out="$(_run)"
  _label="$(printf '%s' "$_out" | python3 -c 'import sys,json; print(json.load(sys.stdin).get("label","?"))' 2>/dev/null)"
  case "$_label" in DEGRADED:*) ;; *) echo "  FAIL: T9 label should be visibly degraded got=$_label"; _f=1 ;; esac

  # ---- Test 10: missing light input must be visibly degraded, not cleanly empty ----
  _stamp EMPTY "$_rc_room"; _stamp SILENT "$_rc_tempo"; _stamp QUIET "$_rc_ambient"; rm -f "$_rc_light"
  _out="$(_run)"
  _label="$(printf '%s' "$_out" | python3 -c 'import sys,json; print(json.load(sys.stdin).get("label","?"))' 2>/dev/null)"
  _deg="$(printf '%s' "$_out" | python3 -c 'import sys,json; print(json.load(sys.stdin).get("degraded",""))' 2>/dev/null)"
  case "$_label" in DEGRADED:*) ;; *) echo "  FAIL: T10 missing-light should be visibly degraded got=$_label"; _f=1 ;; esac
  printf '%s' "$_deg" | grep -q 'light' || { echo "  FAIL: T10 degraded should mention light (got: $_deg)"; _f=1; }

  # ---- Test 11: ENGAGED-QUIET (PRESENT + RESTING/SILENT + ACTIVE) ----
  _stamp PRESENT "$_rc_room"; _stamp RESTING "$_rc_tempo"; _stamp ACTIVE "$_rc_ambient"; _stamp LIT "$_rc_light"
  _out="$(_run)"
  _label="$(printf '%s' "$_out" | python3 -c 'import sys,json; print(json.load(sys.stdin).get("label","?"))' 2>/dev/null)"
  [ "$_label" = "ENGAGED-QUIET" ] || { echo "  FAIL: T11 label=ENGAGED-QUIET got=$_label"; _f=1; }

  # ---- Test 12: SOLO-ACTIVE (PRESENT + BUSTLE + QUIET) ----
  _stamp PRESENT "$_rc_room"; _stamp BUSTLE "$_rc_tempo"; _stamp QUIET "$_rc_ambient"; _stamp DARK "$_rc_light"
  _out="$(_run)"
  _label="$(printf '%s' "$_out" | python3 -c 'import sys,json; print(json.load(sys.stdin).get("label","?"))' 2>/dev/null)"
  [ "$_label" = "SOLO-ACTIVE" ] || { echo "  FAIL: T12 label=SOLO-ACTIVE got=$_label"; _f=1; }

  rm -rf "$_td"
  [ "$_f" = 0 ] || { echo "smoke-test: FAIL"; exit 1; }
  echo "smoke-test: ok (12 fusion assertions)"
  exit 0
fi

# ---- Read input state files ----
room_raw="$(_read_state "$MESH/.room-sense.state" "$ROOM_STALE")"
# mesh-room-sense's --edge writes the state line in 3-field additive format: `VERDICT|dwell_s=N|changes_24h=N`
# (fidelity 2026-06-29: occupancy_dwell enrichment). Strip the trailing fields to recover the bare
# verdict so the match-arithmetic below (`[ "$room" = "PRESENT" ]` etc.) still fires. The full raw
# is preserved in `room_full` for diagnostics.
room_full="$room_raw"
room_raw="$(printf '%s' "$room_raw" | cut -d'|' -f1)"
tempo_raw="$(_read_state "$MESH/.activity-tempo.state" "$TEMPO_STALE")"
ambient_raw="$(_read_state "$MESH/.ambient-clock.state" "$AMBIENT_STALE")"
# mesh-ambient-clock's --edge writes the state line in 3-field additive format: `LABEL|dwell_s=N|changes_24h=N`
# (fidelity 2026-06-28: label_dwell enrichment). Strip the trailing fields to recover the bare label
# so the match-arithmetic below (`[ "$ambient" = "MODERATE" ]` etc.) still fires. The full raw is
# preserved in `ambient_full` for diagnostics.
ambient_full="$ambient_raw"
ambient_raw="$(printf '%s' "$ambient_raw" | cut -d'|' -f1)"
light_raw="$(_read_state "$MESH/.light-state" "$LIGHT_STALE")"
light_full="$light_raw"
light_raw="$(printf '%s' "$light_raw" | cut -d'|' -f1)"

_tempo_active() {
  case "${1:-}" in
    BUSTLE|STIR|DARK_BUSTLE) return 0 ;;
  esac
  return 1
}

# Strip the STALE/MISSING marker for the fusion logic; track degraded axes.
# _read_state returns: STALE / MISSING / UNREADABLE for unreachable inputs,
# or the actual label/verdict content. We split:
#   content = the actual label/verdict (or empty if unreachable)
#   degraded = list of unreachable axes (empty = all healthy)
room=""; tempo=""; ambient=""; light=""
degraded=""
[ "$room_raw" = "STALE" ] || [ "$room_raw" = "MISSING" ] || [ "$room_raw" = "UNREADABLE" ] && degraded="${degraded}room-sense" || room="$room_raw"
[ "$tempo_raw" = "STALE" ] || [ "$tempo_raw" = "MISSING" ] || [ "$tempo_raw" = "UNREADABLE" ] || [ "$tempo_raw" = "DEGRADED" ] && degraded="${degraded:+$degraded }tempo" || tempo="$tempo_raw"
# DATA-STALE and DATA-WARMUP are explicit degraded labels from ambient-clock (not fresh readings) —
# treat as unreachable so the fusion shows DEGRADED instead of a confident quiet. `ambient` was already
# extracted (1st field only) above, so we ONLY set degraded here — do NOT re-assign from $ambient_raw
# (which carries the 3-field additive state) or it would clobber the 1-field match-arithmetic.
case "$ambient_raw" in
  STALE|MISSING|UNREADABLE|DATA-STALE|DATA-WARMUP) degraded="${degraded:+$degraded }ambient-clock" ;;
  *) ambient="$ambient_raw" ;;  # healthy: assign the bare 1st-field label for the match-arithmetic
esac
case "$light_raw" in
  STALE|MISSING|UNREADABLE) degraded="${degraded:+$degraded }light" ;;
  *) light="$light_raw" ;;
esac

# Exit 2 only when ALL inputs are unreachable
if [ -z "$room" ] && [ -z "$tempo" ] && [ -z "$ambient" ] && [ -z "$light" ]; then
  echo "mesh-room-context: all inputs unreachable (room=$room_raw tempo=$tempo_raw ambient=$ambient_raw light=$light_raw)"
  exit 2
fi

# ---- Fusion logic ----
label=""
reason=""
scene=""

if [ -n "$degraded" ] && [ -z "$room" ] && [ -z "$tempo" ] && [ -z "$ambient" ] && [ -z "$light" ]; then
  # Everything stale/missing → cannot produce a label at all
  label="DEGRADED"
  reason="unreachable inputs: $degraded"
  scene="degraded"
elif [ "$room" = "UNCERTAIN" ]; then
  label="AMBIGUOUS"
  reason="room occupancy uncertain (room=$room tempo=$tempo ambient=$ambient light=$light)"
  scene="ambiguous"
elif [ "$room" = "PRESENT" ]; then
  if [ "$ambient" = "ACTIVE" ] || [ "$ambient" = "MODERATE" ] || [ "$light" = "LIT" ] || [ "$light" = "BRIGHT" ]; then
    # Occupied + neighbors on TVs
    case "$tempo" in
      BUSTLE|STIR|DARK_BUSTLE) label="ENGAGED-ACTIVE"; reason="occupied, active, neighbors active (room=$room tempo=$tempo ambient=$ambient light=$light)"; scene="social-active" ;;
      RESTING|SILENT)          label="ENGAGED-QUIET";  reason="occupied, still, neighbors active (room=$room tempo=$tempo ambient=$ambient light=$light)"; scene="social-quiet" ;;
      *)                       label="ENGAGED-ACTIVE"; reason="occupied, neighbors active (room=$room tempo=$tempo ambient=$ambient light=$light)"; scene="social-active" ;;
    esac
  elif [ "$ambient" = "NIGHT-QUIET" ] && { [ "$light" = "DARK" ] || [ "$light" = "DIM" ]; }; then
    # Occupied during nighttime quiet hours
    case "$tempo" in
      BUSTLE|STIR|DARK_BUSTLE) label="SOLO-ACTIVE"; reason="occupied, active, night hours (room=$room tempo=$tempo ambient=$ambient light=$light)"; scene="solitary-active" ;;
      RESTING|SILENT)          label="SOLO-QUIET";  reason="occupied, still, night hours (room=$room tempo=$tempo ambient=$ambient light=$light)"; scene="solitary-quiet" ;;
      *)                       label="SOLO-QUIET";  reason="occupied, night hours (room=$room tempo=$tempo ambient=$ambient light=$light)"; scene="solitary-quiet" ;;
    esac
  else
    # QUIET or other — no neighbor signal
    case "$tempo" in
      BUSTLE|STIR|DARK_BUSTLE) label="SOLO-ACTIVE"; reason="solo active (room=$room tempo=$tempo ambient=$ambient light=$light)"; scene="solitary-active" ;;
      RESTING|SILENT)          label="SOLO-QUIET";  reason="solo quiet (room=$room tempo=$tempo ambient=$ambient light=$light)"; scene="solitary-quiet" ;;
      *)                       label="SOLO-QUIET";  reason="solo (room=$room tempo=$tempo ambient=$ambient light=$light)"; scene="solitary-quiet" ;;
    esac
  fi
elif [ "$room" = "EMPTY" ]; then
  if [ "$ambient" = "ACTIVE" ] || [ "$ambient" = "MODERATE" ] || [ "$light" = "BRIGHT" ]; then
    if _tempo_active "$tempo"; then
      label="PEER-ACTIVE"; reason="empty here, neighbors active, local tempo=$tempo (room=$room ambient=$ambient light=$light)"; scene="peer-active"
    elif [ "$tempo" = "RESTING" ] || [ "$tempo" = "SILENT" ]; then
      label="PEER-QUIET"; reason="empty here, neighbors active but local tempo=$tempo (room=$room ambient=$ambient light=$light)"; scene="peer-quiet"
    else
      label="PEER-ACTIVE"; reason="empty here, neighbors active (room=$room tempo=$tempo ambient=$ambient light=$light)"; scene="peer-active"
    fi
  elif [ "$ambient" = "NIGHT-QUIET" ] && { [ "$light" = "DARK" ] || [ "$light" = "DIM" ]; }; then
    label="NIGHT-STILL"; reason="night hours, empty and dark/dim (room=$room tempo=$tempo ambient=$ambient light=$light)"; scene="vacant-night"
  else
    label="VACANT"; reason="vacant, no activity (room=$room tempo=$tempo ambient=$ambient light=$light)"; scene="vacant"
  fi
else
  # Room is empty/unknown but we have at least one signal
  label="DEGRADED"
  reason="unclassifiable (room=$room_raw tempo=$tempo_raw ambient=$ambient_raw light=$light_raw)"
  scene="degraded"
fi

[ -n "$degraded" ] && [ "$label" != "DEGRADED" ] && { reason="missing/unreachable inputs: $degraded; base=$label — $reason"; label="DEGRADED:$label"; scene="degraded"; }

[ -n "$scene" ] || scene="degraded"

# ---- Output ----
case "${1:-}" in
  --json)
    printf '{"label":"%s","scene":"%s","reason":"%s","inputs":{"room":"%s","tempo":"%s","ambient":"%s","light":"%s"},"degraded":"%s","ts":"%s"}\n' \
      "$label" "$scene" "$reason" "$room_raw" "$tempo_raw" "$ambient_raw" "$light_raw" "$degraded" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    ;;
  --edge)
    prev="$(cat "$STATE" 2>/dev/null || echo "")"
    if [ "$label" != "$prev" ]; then
      printf '%s\n' "$label" > "$STATE"
      printf '%s [%s] — %s\n' "$label" "$scene" "$reason"
    fi
    mesh-state-touch "$STATE"
    ;;
  *)
    printf '%s [%s] — %s\n' "$label" "$scene" "$reason"
    printf '%s\n' "$label" > "$STATE"
    mesh-state-touch "$STATE"
    ;;
esac
exit 0
