#!/usr/bin/env bash
# mesh-presence-fuse-stream — feed a mind when a tracked BLE device changes zone
# (which node it's closest to). Cheap reflex, mind on zonal edge.
# reflex-cadence: 19,49 * * * *
#
# Pipeline: mesh-presence-fuse --track <devices> → extract zone changes → edge-dedup → mesh-tell
#
# Config (env vars):
#   MESH_FUSE_PEER=user@host     (required unless MESH_FUSE_LABEL resolves via ~/.mesh/nodes)
#   MESH_FUSE_LABEL=label        (default: default-string)
#   MESH_FUSE_DEVICES="n n ..."  (default: Bose)
#   MESH_FUSE_MIND=target        (default: @idle)
#
# Test:
#   MESH_FUSE_STREAM_TEST_PAYLOAD  inject zone change line to test feed
#   mesh-presence-fuse-stream --test
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
MESH="$HOME/.mesh"
LASTFED="$MESH/.presence-fuse-stream.lastfed"
LOG="$MESH/presence-fuse-stream.log"
mkdir -p "$MESH"
ts(){ date -u +%FT%TZ; }

# SOURCE ~/.mesh/nodes (2026-07-07): the header documents nodes as the config surface but nothing
# sourced it — under cron (empty env) the peer never resolved off-IdeaPad (ds: "no peer
# configured/resolved" every cycle since wiring). Invocation env still WINS over the file.
_env_fp="${MESH_FUSE_PEER:-}"; _env_fl="${MESH_FUSE_LABEL:-}"
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes" 2>/dev/null || true
MESH_FUSE_PEER="${_env_fp:-${MESH_FUSE_PEER:-}}"; MESH_FUSE_LABEL="${_env_fl:-${MESH_FUSE_LABEL:-}}"

PEER="${MESH_FUSE_PEER:-}"
PEER_LABEL="${MESH_FUSE_LABEL:-}"  # set MESH_FUSE_LABEL=<node-label> in ~/.mesh/nodes
DEVICES="${MESH_FUSE_DEVICES:-Bose}"
MIND="${MESH_FUSE_MIND:-@idle}"

resolve_peer() {
  [ -n "$PEER" ] && { printf '%s' "$PEER"; return 0; }
  command -v mesh-peer-addr >/dev/null 2>&1 || return 1
  ip="$(mesh-peer-addr "$PEER_LABEL" 2>/dev/null || true)"
  [ -n "$ip" ] || return 1
  user="${MESH_PEER_USER:-$(whoami)}"
  printf '%s@%s' "$user" "$ip"
}

resolve_idle() {
  local S; S="$(hostname)"
  for w in opencode gemini claude; do
    # CHANNEL convention: top=DATA (refreshing), bottom=MIND — check the BOTTOM pane
    # (largest pane_top), same idiom as mesh-tell, else a refreshing data pane reads
    # as always-busy (or a stable one as idle while the mind below is working).
    local p; p="$(tmux list-panes -t "$S:$w" -F '#{pane_top} #{pane_index}' 2>/dev/null | sort -n | tail -1 | awk '{print $2}')"
    [ -n "$p" ] || continue
    a="$(tmux capture-pane -t "$S:$w.$p" -p 2>/dev/null)"; sleep 1.5
    b="$(tmux capture-pane -t "$S:$w.$p" -p 2>/dev/null)"
    [ -n "$a" ] && [ "$a" = "$b" ] && { printf '%s' "$w"; return 0; }
  done
  return 1
}

# Pull payload: run mesh-presence-fuse and capture zonal lines
pull_payload() {
  if [ -n "${MESH_FUSE_STREAM_TEST_PAYLOAD:-}" ]; then
    printf '%s\n' "$MESH_FUSE_STREAM_TEST_PAYLOAD"
    return 0
  fi

  local args=()
  for d in $DEVICES; do args+=(--track "$d"); done
  peer="$(resolve_peer 2>/dev/null || true)"
  [ -n "$peer" ] || { echo "$(ts) stream[presence-fuse]: no peer configured/resolved" >> "$LOG"; return 0; }
  # Peer goes LAST: flags must precede the bare positional so --track survives the parser.
  # Capture rc + stderr so a FAILED fuse (peer unreachable, parse error, crash) is logged
  # distinctly from a genuine no-zone-change EMPTY — the empty≠failed rule. Previously
  # `... 2>/dev/null | grep || true` made all three indistinguishable, which is exactly
  # how the parser bug hid here unnoticed since inception.
  local out err rc
  err="$(mktemp)"
  out="$(mesh-presence-fuse "${args[@]}" --once "$peer" 2>"$err")"; rc=$?
  if [ "$rc" -ne 0 ]; then
    echo "$(ts) stream[presence-fuse]: fuse FAILED (rc=$rc) peer=$peer$(head -1 "$err" | sed 's/^/ — /')" >> "$LOG"
    rm -f "$err"; return 0
  fi
  rm -f "$err"
  # mesh-presence-fuse prints zonal alerts TIMESTAMP-PREFIXED ("<ts> zonal: ..."), so the
  # old anchored `grep ^zonal:` matched NOTHING even once zonal lines existed — a second,
  # compounding reason this reflex never fed. `grep -oE 'zonal: .*'` strips the timestamp
  # so the payload starts with "zonal: " exactly as prompt_for_payload's `sed 's/^zonal: //'`
  # expects.
  printf '%s\n' "$out" | grep -oE 'zonal: .*' || true
}

# Infer target mind name for the prompt: device name if resolvable
prompt_for_payload() {
  local zone_lines; zone_lines="$(cat)"
  [ -z "$zone_lines" ] && return 1

  local count; count="$(printf '%s\n' "$zone_lines" | awk 'NF{c++} END{print c+0}')"
  local prompt
  if [ "$count" -eq 1 ]; then
    prompt="[zone] $(printf '%s' "$zone_lines" | sed 's/^zonal: //')"
  else
    prompt="[zone] $count devices changed zone: $(printf '%s' "$zone_lines" | paste -sd '; ')"
  fi
  printf '%s' "$prompt"
}

feed_prompt() {
  local target="$1" prompt="$2" prev=""
  prev="$(cat "$LASTFED" 2>/dev/null || true)"
  if [ "$prompt" = "$prev" ]; then
    echo "$(ts) stream[presence-fuse]: unchanged — not re-feeding" >> "$LOG"
    return 0
  fi

  if [ "$target" = "@idle" ]; then
    target="$(resolve_idle 2>/dev/null || true)"
    [ -n "$target" ] || { echo "$(ts) stream[presence-fuse]: no idle worker — holding" >> "$LOG"; return 0; }
  fi

  if mesh-tell "$target" "$prompt" >/dev/null 2>&1; then
    printf '%s' "$prompt" > "$LASTFED"
    echo "$(ts) stream[presence-fuse] → FED $target: ${prompt:0:70}" >> "$LOG"
  else
    echo "$(ts) stream[presence-fuse]: feed to $target failed" >> "$LOG"
    return 1
  fi
}

if [ "${1:-}" = --help ] || [ "${1:-}" = -h ]; then
  echo "Usage: mesh-presence-fuse-stream [--help] [--test] [--eval <payload>]"
  echo ""
  echo "Options:"
  echo "  --help, -h          Show this help message"
  echo "  --test              Smoke-test dependencies (mesh-presence-fuse, mesh-tell)"
  echo "  --eval <payload>   Evaluate payload format (for testing)"
  echo ""
  echo "Configuration (environment variables):"
  echo "  MESH_FUSE_PEER      SSH peer (user@host) or use MESH_FUSE_LABEL"
  echo "  MESH_FUSE_LABEL     Node label for peer resolution (default: default-string)"
  echo "  MESH_FUSE_DEVICES   Comma-separated device names to track (default: Bose)"
  echo "  MESH_FUSE_MIND      Target mind for prompts (default: @idle)"
  echo ""
  echo "File locations:"
  echo "  Logs: ~/.mesh/presence-fuse-stream.log"
  echo "  Last fed: ~/.mesh/.presence-fuse-stream.lastfed"
  echo ""
  echo "The tool feeds zone-change prompts to a mind when tracked BLE devices move between nodes."
  exit 0
fi

if [ "${1:-}" = --test ]; then
  command -v mktemp >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mktemp)"; exit 1; }
  command -v chmod >/dev/null 2>&1 || { echo "smoke-test: FAIL (no chmod)"; exit 1; }
  command -v cat >/dev/null 2>&1 || { echo "smoke-test: FAIL (no cat)"; exit 1; }
  command -v wc >/dev/null 2>&1 || { echo "smoke-test: FAIL (no wc)"; exit 1; }
  command -v grep >/dev/null 2>&1 || { echo "smoke-test: FAIL (no grep)"; exit 1; }

  td="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
  trap 'rm -rf "$td"' EXIT
  home="$td/home"
  mkdir -p "$home/.local/bin" "$home/.mesh" || { echo "smoke-test: FAIL (tmp HOME setup)"; exit 1; }

  cat > "$home/.local/bin/mesh-presence-fuse" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' '2026-06-19T00:00:00Z zonal: Bose|ARRIVED:mock-peer|SELF|-66|-44'
EOF
  chmod +x "$home/.local/bin/mesh-presence-fuse" || { echo "smoke-test: FAIL (stub mesh-presence-fuse chmod)"; exit 1; }

  # FAIL path: missing mesh-tell must be detected by the live code path, not papered over.
  if HOME="$home" PATH="/usr/bin:/bin" MESH_FUSE_PEER="mock-peer@127.0.0.1" MESH_FUSE_MIND="opencode" "$0" >/dev/null 2>"$td/fail.err"; then
    echo "smoke-test: FAIL (normal run passed without mesh-tell)"
    exit 1
  fi
  grep -q 'feed to opencode failed' "$home/.mesh/presence-fuse-stream.log" \
    || { echo "smoke-test: FAIL (missing mesh-tell did not leave a failure artifact in the stream log)"; exit 1; }

  cat > "$home/.local/bin/mesh-tell" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' "$*" >> "$HOME/.mesh/mesh-presence-fuse-stream.test"
exit 0
EOF
  chmod +x "$home/.local/bin/mesh-tell" || { echo "smoke-test: FAIL (stub mesh-tell chmod)"; exit 1; }

  : > "$home/.mesh/mesh-presence-fuse-stream.test" || { echo "smoke-test: FAIL (test artifact not writable)"; exit 1; }
  out="$(HOME="$home" PATH="/usr/bin:/bin" MESH_FUSE_PEER="mock-peer@127.0.0.1" MESH_FUSE_MIND="opencode" "$0" 2>&1)" \
    || { echo "smoke-test: FAIL (dry-run run errored: $out)"; exit 1; }
  prompt="$(cat "$home/.mesh/.presence-fuse-stream.lastfed" 2>/dev/null || true)"
  [ "$prompt" = '[zone] Bose|ARRIVED:mock-peer|SELF|-66|-44' ] \
    || { echo "smoke-test: FAIL (prompt artifact drifted: $prompt)"; exit 1; }
  [ "$(wc -l < "$home/.mesh/mesh-presence-fuse-stream.test")" -eq 1 ] \
    || { echo "smoke-test: FAIL (mesh-tell was not called exactly once)"; exit 1; }
  printf '%s\n' "smoke-test: ok (missing mesh-tell fails; stubbed dry-run feeds one zonal prompt)"
  exit 0
fi

if [ "${1:-}" = --eval ]; then
  shift; printf '%s\n' "${1:-}" | prompt_for_payload || true
  exit 0
fi

payload="$(pull_payload)"
[ -z "$payload" ] && { echo "$(ts) stream[presence-fuse]: nothing to feed" >> "$LOG"; exit 0; }
prompt="$(printf '%s\n' "$payload" | prompt_for_payload || true)"
[ -z "${prompt//[[:space:]]/}" ] && { echo "$(ts) stream[presence-fuse]: no prompt generated" >> "$LOG"; exit 0; }
feed_prompt "$MIND" "$prompt"
