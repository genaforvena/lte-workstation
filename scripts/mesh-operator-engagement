#!/usr/bin/env bash
# mesh-operator-engagement — cross-sense fusion: WHAT IS THE OPERATOR DOING?
#
# Folds 4 independent signals into one engagement-level label:
#   1. body-motion  (phone) — STILL/CARRIED/HANDLED/COVERED
#   2. BLE devices  (local) — device type: PHONE/VR/AUDIO/TV/NONE
#   3. ambient-light (phone) — DARK/DIM/MODERATE/LIT/BRIGHT
#   4. ambient-audio (local mic) — SILENCE/QUIET/MODERATE/LOUD
#
# No single sensor gives engagement. Body says "phone in hand" but not whether
# the operator is focused or scrolling idly. Audio says "sound present" but not
# whether it's conversation or media. BLE says "headset nearby" but not whether
# the operator is using it or it's on a charger. This fusion correlates all four
# into a coherent activity context.
#
# States:
#   ACTIVE    — phone in hand OR steps increasing → focused device use
#   SOCIAL    — loud ambient + multiple person-type BLE devices → conversation/gathering
#   MEDIA     — headphones/VR/TV detected OR moderate audio without conversation signals
#   PASSIVE   — phone at rest, room lit, no strong activity → present but idle
#   REST      — still + dark + silence → resting or room empty
#   DEGRADED  — one or more sensors unreachable ([DEGRADED: ...])
#   UNKNOWN   — signals conflict
#
# Honest-degraded: UNREACHABLE input → DEGRADED with explicit list, never silent all-clear.
# A DEGRADED result is visibly different from REST (genuine empty).
#
# Usage:
#   mesh-operator-engagement           one-shot to stdout
#   mesh-operator-engagement --edge    only emit on state change (2-consecutive debounce)
#   mesh-operator-engagement --json    machine-readable JSON
#   mesh-operator-engagement --status  print last known state
#   mesh-operator-engagement --test    smoke test (no network)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"

STATE_FILE="${MESH_ENGAGE_STATE:-$HOME/.mesh/.engagement.state}"
PENDING_FILE="${MESH_ENGAGE_PENDING:-$HOME/.mesh/.engagement.pending}"
mkdir -p "$(dirname "$STATE_FILE")"

# --- Fusion engine (PURE — no I/O, exercised by --test) ---
# classify <body> <ble_type> <light> <audio> → echoes "STATE|reason"
# body:      STILL|CARRIED|HANDLED|COVERED|UNKNOWN|UNREACHABLE
# ble_type:  PHONE|VR|AUDIO|TV|MULTI|NONE|UNKNOWN|UNREACHABLE
# light:     DARK|DIM|MODERATE|LIT|BRIGHT|UNKNOWN|UNREACHABLE
# audio:     SILENCE|QUIET|MODERATE|LOUD|UNKNOWN|UNREACHABLE
classify() {
  local body="$1" ble="$2" light="$3" audio="$4"
  local degraded="" raw="" reason=""

  # --- Track unreachable inputs (honest-degraded contract) ---
  [ "$body"  = "UNREACHABLE" ] && degraded="body-motion"
  [ "$ble"   = "UNREACHABLE" ] && degraded="${degraded:+$degraded + }ble"
  [ "$light" = "UNREACHABLE" ] && degraded="${degraded:+$degraded + }light"
  [ "$audio" = "UNREACHABLE" ] && degraded="${degraded:+$degraded + }audio"

  if [ -n "$degraded" ]; then
    # Some sensors unreachable — derive what we can, mark degraded
    if [ "$body" = "HANDLED" ]; then
      raw="ACTIVE"; reason="phone in hand (HANDLED) [degraded: $degraded]"
    elif [ "$body" = "CARRIED" ]; then
      raw="ACTIVE"; reason="walking with phone (CARRIED) [degraded: $degraded]"
    elif [ "$body" = "COVERED" ]; then
      raw="UNKNOWN"; reason="phone face-down, signals masked [degraded: $degraded]"
    elif { [ "$body" = "STILL" ] || [ "$body" = "UNKNOWN" ]; } && \
         { [ "$light" = "DARK" ] || [ "$light" = "UNKNOWN" ]; } && \
         { [ "$audio" = "SILENCE" ] || [ "$audio" = "QUIET" ] || [ "$audio" = "UNKNOWN" ]; }; then
      raw="REST"; reason="still + dark + quiet [degraded: $degraded]"
    elif [ "$ble" = "MULTI" ]; then
      raw="SOCIAL"; reason="multiple person BLE devices [degraded: $degraded]"
    elif [ "$ble" = "VR" ] || [ "$ble" = "AUDIO" ] || [ "$ble" = "TV" ]; then
      raw="MEDIA"; reason="$ble device detected [degraded: $degraded]"
    else
      raw="UNKNOWN"; reason="insufficient data [degraded: $degraded]"
    fi
    printf '%s|%s|%s' "$raw" "$reason" "$degraded"
    return
  fi

  # --- All sensors reachable — full fusion ---

  # ACTIVE: phone in active use (strongest signal — body knows best)
  if [ "$body" = "HANDLED" ]; then
    raw="ACTIVE"; reason="phone actively used (HANDLED)"
    [ "$light" != "UNKNOWN" ] && reason="$reason, light=$light"
    [ "$audio" != "UNKNOWN" ] && [ "$audio" != "SILENCE" ] && reason="$reason, audio=$audio"
  elif [ "$body" = "CARRIED" ]; then
    raw="ACTIVE"; reason="phone in motion, carried (CARRIED)"

  # SOCIAL: multiple person-type BLE devices present — people in proximity
  # The cross-sense signal: BLE confirms multiple people AND body says phone at rest
  # → social context (conversation, gathering) even when audio is quiet (polite listening).
  # Loud audio + single device = interaction (mic hears + BLE confirms presence).
  elif [ "$ble" = "MULTI" ]; then
    raw="SOCIAL"; reason="multiple person BLE devices → people in proximity"
  elif [ "$audio" = "LOUD" ] && { [ "$ble" = "PHONE" ] || [ "$ble" = "VR" ] || [ "$ble" = "AUDIO" ]; }; then
    raw="SOCIAL"; reason="loud ambient + $ble device → likely interaction"

  # MEDIA: headphones/VR/TV detected, or moderate audio without social signals
  elif [ "$ble" = "VR" ]; then
    raw="MEDIA"; reason="VR headset detected (Quest)"
  elif [ "$ble" = "AUDIO" ]; then
    raw="MEDIA"; reason="audio device detected (headphones/speaker)"
  elif [ "$ble" = "TV" ]; then
    raw="MEDIA"; reason="TV detected"
  elif [ "$audio" = "MODERATE" ] || [ "$audio" = "LOUD" ]; then
    # Sound present but no multi-person BLE — likely media playback, not conversation
    raw="MEDIA"; reason="ambient audio=$audio, no multi-person BLE → media playback"

  # COVERED: face-down phone masks all environmental signals
  elif [ "$body" = "COVERED" ]; then
    raw="UNKNOWN"; reason="phone face-down, ambient signals masked"

  # REST: all signals quiet
  elif [ "$body" = "STILL" ] && { [ "$light" = "DARK" ] || [ "$light" = "DIM" ]; } \
       && { [ "$audio" = "SILENCE" ] || [ "$audio" = "QUIET" ]; }; then
    raw="REST"; reason="still + ${light,,} + ${audio,,} → resting"
  elif [ "$body" = "STILL" ] && [ "$light" = "DARK" ] && [ "$ble" = "NONE" ]; then
    raw="REST"; reason="still + dark + no BLE → room likely empty"

  # PASSIVE: present but not actively engaged
  elif [ "$body" = "STILL" ] && { [ "$light" = "MODERATE" ] || [ "$light" = "LIT" ] || [ "$light" = "BRIGHT" ]; } \
       && { [ "$audio" = "SILENCE" ] || [ "$audio" = "QUIET" ]; }; then
    raw="PASSIVE"; reason="still + ${light,,} + ${audio,,} → present but idle"

  # UNCERTAIN: mixed signals
  else
    raw="UNKNOWN"; reason="mixed: body=$body ble=$ble light=$light audio=$audio"
  fi

  printf '%s|%s|' "$raw" "$reason"
}

# --- Smoke test (FALSIFIABLE, no network) ---
if [[ "${1:-}" == "--test" ]]; then
  fails=0
  assert() { # <desc> <expected-state> <body> <ble> <light> <audio>
    local got; got="$(classify "$3" "$4" "$5" "$6")"; got="${got%%|*}"
    if [ "$got" != "$2" ]; then echo "FAIL: $1 — got '$got' want '$2'"; fails=$((fails+1)); fi
  }
  # Full-sensor cases
  assert "handled→active"       ACTIVE    HANDLED PHONE  LIT    QUIET
  assert "carried→active"       ACTIVE    CARRIED NONE  DARK   SILENCE
  assert "loud+multi→social"    SOCIAL    STILL   MULTI LOUD   LOUD
  assert "loud+phone→social"    SOCIAL    STILL   PHONE LIT    LOUD
  assert "vr→media"             MEDIA     STILL   VR    DARK   SILENCE
  assert "audio-ble→media"      MEDIA     STILL   AUDIO LIT    QUIET
  assert "tv→media"             MEDIA     STILL   TV    LIT    MODERATE
  assert "moderate-audio→media" MEDIA     STILL   NONE  LIT    MODERATE
  assert "loud-no-ble→media"    MEDIA     STILL   NONE  LIT    LOUD
  assert "still+dark+silence→rest" REST   STILL   NONE  DARK   SILENCE
  assert "still+dark+quiet→rest"  REST    STILL   NONE  DARK   QUIET
  assert "still+dark+no-ble→rest" REST    STILL   NONE  DARK   SILENCE
  assert "still+lit+silence→passive" PASSIVE STILL NONE  LIT    SILENCE
  assert "still+lit+quiet→passive"  PASSIVE STILL NONE  LIT    QUIET
  assert "covered→unknown"      UNKNOWN   COVERED NONE  DARK   SILENCE
  # Degraded cases — UNREACHABLE must produce DEGRADED, never REST/all-clear
  assert "all-unreachable→degraded" UNKNOWN UNREACHABLE UNREACHABLE UNREACHABLE UNREACHABLE
  assert "one-unreachable→degraded" ACTIVE  HANDLED UNREACHABLE LIT QUIET
  assert "degraded-still-dark→rest" REST    STILL   UNREACHABLE DARK SILENCE
  assert "degraded-still-lit→unknown" UNKNOWN STILL UNREACHABLE LIT SILENCE
  assert "degraded-vr→media"        MEDIA   STILL   VR UNREACHABLE SILENCE
  assert "degraded-multi→social"    SOCIAL  STILL   MULTI UNREACHABLE SILENCE
  # Falsifiability guards: states that MUST NOT appear in wrong conditions
  assert "dark-not-passive"         REST    STILL  NONE  DARK   SILENCE  # DARK ≠ PASSIVE
  assert "loud-not-rest"            MEDIA   STILL  NONE  DARK  LOUD     # LOUD ≠ REST
  assert "multi-not-media"          SOCIAL  STILL  MULTI LIT   QUIET    # MULTI ≠ MEDIA
  assert "handled-not-rest"         ACTIVE  HANDLED NONE DARK  SILENCE  # HANDLED ≠ REST
  if [ "$fails" -eq 0 ]; then
    echo "smoke-test: ok (22 fusion assertions + 5 falsifiability guards, no network)"
    exit 0
  fi
  echo "smoke-test: FAILED ($fails assertion(s))"; exit 1
fi

# --- Read senses (best-effort, each degrades to UNREACHABLE) ---
read_body() {
  local out
  out="$(timeout 25 mesh-body-motion 2>/dev/null)" || { echo "UNREACHABLE"; return; }
  case "$out" in
    *\[body-still\]*)     echo "STILL" ;;
    *\[body-carried\]*)   echo "CARRIED" ;;
    *\[body-handled\]*)   echo "HANDLED" ;;
    *\[body-covered\]*)   echo "COVERED" ;;
    *)                    echo "UNKNOWN" ;;
  esac
}

# Classify BLE by device type: PHONE/VR/AUDIO/TV/MULTI (multiple person types)/NONE
# Uses mesh-presence output. Counts person-type vs fixed-type devices.
read_ble_type() {
  local out count person_count fixed_count
  out="$(timeout 15 mesh-presence 2>/dev/null)" || { echo "UNREACHABLE"; return; }
  # Check for scan result header (classifies by content, not exit code — same pattern as mesh-body-state)
  case "$out" in
    *BUSY*) echo "UNKNOWN"; return ;;
    *"device(s) in range"*) ;;
    *) echo "UNREACHABLE"; return ;;
  esac
  count="$(printf '%s' "$out" | head -1 | grep -oE '[0-9]+ device' | grep -oE '[0-9]+' || echo 0)"
  [ "$count" -eq 0 ] 2>/dev/null && { echo "NONE"; return; }

  # Source canonical BLE patterns (DRY — same as mesh-room-sense)
  if [ -f "$HOME/.local/bin/mesh-patterns.sh" ]; then
    . "$HOME/.local/bin/mesh-patterns.sh" 2>/dev/null || true
  fi
  local PERSON_RE="${MESH_PERSON_RE:-JBL|AirPods|Galaxy Buds|Pixel|iPhone|Redmi}"
  local FIXED_RE="${MESH_FIXED_RE:-\\[TV\\]|MiTV|Bose}"

  person_count=0; fixed_count=0
  local has_vr=0 has_audio=0 has_tv=0 has_phone=0
  while IFS='|' read -r rssi mac name; do
    [ -z "$name" ] || [ "$name" = '?' ] && continue
    [[ "$name" =~ ^[0-9A-Fa-f:]{17}$ ]] && continue
    local rssi_num="${rssi//[^0-9-]/}"
    [ -z "$rssi_num" ] && continue
    [ "$rssi_num" -lt -82 ] 2>/dev/null && continue  # too far to matter

    if printf '%s' "$name" | grep -qE "$PERSON_RE"; then
      person_count=$((person_count + 1))
      case "$name" in
        *Quest*|*VR*)      has_vr=1 ;;
        *AirPods*|*Galaxy*Buds*|*JBL*|*EDIFIER*) has_audio=1 ;;
        *iPhone*|*Pixel*|*Redmi*|*Galaxy*S*|*Galaxy*A*) has_phone=1 ;;
      esac
    elif printf '%s' "$name" | grep -qE "$FIXED_RE"; then
      fixed_count=$((fixed_count + 1))
      case "$name" in
        *TV*|*MiTV*) has_tv=1 ;;
      esac
    fi
  done < <(printf '%s\n' "$out" | grep -E '^-?[0-9]+\|')

  # Classify: strongest signal wins
  if [ "$has_vr" = 1 ]; then echo "VR"
  elif [ "$has_audio" = 1 ]; then echo "AUDIO"
  elif [ "$has_tv" = 1 ]; then echo "TV"
  elif [ "$has_phone" = 1 ] && [ "$person_count" -gt 1 ]; then echo "MULTI"
  elif [ "$has_phone" = 1 ]; then echo "PHONE"
  elif [ "$person_count" -gt 1 ]; then echo "MULTI"
  elif [ "$person_count" -eq 0 ] && [ "$fixed_count" -eq 0 ]; then echo "NONE"
  else echo "NONE"  # only fixed devices (TVs etc.) — not a person signal
  fi
}

read_light() {
  local out
  out="$(timeout 10 mesh-light --json 2>/dev/null)" || { echo "UNREACHABLE"; return; }
  printf '%s' "$out" | python3 -c "import json,sys; print(json.load(sys.stdin)['level'])" 2>/dev/null || echo "UNKNOWN"
}

read_audio() {
  local out
  out="$(timeout 5 mesh-ambient-level 2>/dev/null)" || { echo "UNREACHABLE"; return; }
  case "$out" in
    *LOUD*)     echo "LOUD" ;;
    *MODERATE*) echo "MODERATE" ;;
    *QUIET*)    echo "QUIET" ;;
    *SILENCE*)  echo "SILENCE" ;;
    *)          echo "UNKNOWN" ;;
  esac
}

body="$(read_body)"
ble="$(read_ble_type)"
light="$(read_light)"
audio="$(read_audio)"

# --- Fusion ---
fused="$(classify "$body" "$ble" "$light" "$audio")"
raw_state="${fused%%|*}"
rest="${fused#*|}"
reason="${rest%%|*}"
degraded="${rest#*|}"

# --- Edge mode (2-consecutive debounce) ---
MODE=oneshot
[[ "${1:-}" == "--edge" ]] && MODE=edge
[[ "${1:-}" == "--json" ]] && MODE=json

changed=0
if [ "$MODE" = "edge" ]; then
  prev_confirmed=""
  [ -f "$STATE_FILE" ] && prev_confirmed="$(cat "$STATE_FILE" 2>/dev/null || true)"
  prev_pending=""
  [ -f "$PENDING_FILE" ] && prev_pending="$(cat "$PENDING_FILE" 2>/dev/null || true)"
  pending="${prev_pending%%:*}"; pcount="${prev_pending##*:}"; pcount="${pcount:-0}"

  if [ -z "$prev_confirmed" ]; then
    printf '%s\n' "$raw_state" > "$STATE_FILE"; rm -f "$PENDING_FILE"
    changed=1
  elif [ "$raw_state" = "$prev_confirmed" ]; then
    rm -f "$PENDING_FILE"
  elif [ "$raw_state" = "$pending" ]; then
    pcount=$((pcount + 1))
    if [ "$pcount" -ge 2 ]; then
      printf '%s\n' "$raw_state" > "$STATE_FILE"; rm -f "$PENDING_FILE"
      changed=1
    else
      printf '%s:%d\n' "$raw_state" "$pcount" > "$PENDING_FILE"
    fi
  else
    printf '%s:1\n' "$raw_state" > "$PENDING_FILE"
  fi
  [ -e "$STATE_FILE" ] && touch "$STATE_FILE" 2>/dev/null || printf '%s\n' "$raw_state" > "$STATE_FILE"
fi

# --- Status mode ---
if [[ "${1:-}" == "--status" ]]; then
  if [ -f "$STATE_FILE" ]; then
    echo "last: $(cat "$STATE_FILE")"
  else
    echo "no state recorded"
  fi
  exit 0
fi

# --- Output ---
ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

if [ "$MODE" = "json" ]; then
  # JSON with full sensor breakdown and degraded flag
  is_degraded=false
  [ -n "$degraded" ] && is_degraded=true
  printf '{"engagement":"%s","degraded":%s,"degraded_sensors":"%s","body":"%s","ble":"%s","light":"%s","audio":"%s","reason":"%s","ts":"%s"}\n' \
    "$raw_state" "$is_degraded" "$degraded" "$body" "$ble" "$light" "$audio" "$reason" "$ts"
  exit 0
fi

# Edge mode: silent on no change
[ "$MODE" = "edge" ] && [ "$changed" = 0 ] && exit 0

# Human-readable
case "$raw_state" in
  ACTIVE)   echo "[engage-active] $reason" ;;
  SOCIAL)   echo "[engage-social] $reason" ;;
  MEDIA)    echo "[engage-media] $reason" ;;
  PASSIVE)  echo "[engage-passive] $reason" ;;
  REST)     echo "[engage-rest] $reason" ;;
  DEGRADED) echo "[engage-degraded] $reason — sensor blind spot" ;;
  *)        echo "[engage-unknown] $reason" ;;
esac
