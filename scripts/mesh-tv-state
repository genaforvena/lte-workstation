#!/usr/bin/env bash
# reflex-cadence: 3-59/5 * * * *
# reflex-args: --edge
# mesh-tv-state — READ the TV's on/standby bit: a living-room OCCUPANCY axis distinct from BLE/MAC
# presence, and a pre-cast in-use guard for the casters. The Sony Bravia (KDL-42W653A @192.168.8.130)
# answers ScalarWebAPI getPowerStatus UNAUTHENTICATED — {"status":"active"|"standby"} — so on-vs-standby
# is readable with no credential. Discovered 2026-07-12 (discover→health CONFIRMED, both live-probed 2x):
# mesh-tv/mesh-tv-dlna hold the TV WRITE-ONLY (cast + IRCC-pause) and mesh-upnp-census's own header names
# the gap — a standby TV keeps its DHCP lease, so MAC/ARP presence CANNOT tell on from off. This closes it.
#
#   mesh-tv-state            verdict + source     (TV active | TV standby)
#   mesh-tv-state --json     {"tv":"active","ts":...,"prev":"standby","source":"getPowerStatus"}
#   mesh-tv-state --edge     REFLEX: post [tv-power-*] on state change only; wire to */5 cron
#   mesh-tv-state --test     smoke test (exit 2 = n/a: TV off-LAN/unreachable — honest, never faked)
#
# Honest-exit contract (mirrors mesh-light / the sensorium): exit 0 = a real read (active|standby);
# exit 2 = honest n/a (TV unreachable / no parseable status) — NEVER a faked ACTIVE/STANDBY. A consumer
# (mesh-home-state / mesh-household-state living-room axis) opts in by reading the state file or --json;
# an unreachable TV renders that axis UNKNOWN, never a false all-clear (fusion honesty rule).
set -uo pipefail
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
export PATH="$HOME/.local/bin:$PATH"
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes" 2>/dev/null

TV_IP="${MESH_TV_IP:-192.168.8.130}"
TV_STATE="$HOME/.mesh/.tv-power.state"      # "<STATE> <epoch>" — STATE ∈ ACTIVE|STANDBY|UNREACHABLE
TV_TIMEOUT="${MESH_TV_TIMEOUT:-6}"

# classify_status <raw-json-body> → prints ACTIVE|STANDBY|<UPPER-other> and rc 0, or "" + rc 2 on no parse.
# Pure function (no network) so --test can drive it against fixtures. getPowerStatus shape:
# {"id":1,"result":[{"status":"active"}]}. "activating"/"shutting_down" pass through uppercased (rare,
# transient) — a consumer maps anything != STANDBY to "not-off"; we never invent a value we didn't read.
classify_status(){
  printf '%s' "$1" | python3 -c '
import sys, json
try:
    d = json.load(sys.stdin)
    st = d["result"][0]["status"]
    if not isinstance(st, str) or not st: raise ValueError
    print(st.strip().upper())
except Exception:
    sys.exit(2)
' 2>/dev/null
}

# read_power → prints STATE (rc 0 on a real read) or "" (rc 2 honest n/a). Network read isolated here so
# --test can stub it. curl --fail so an HTTP error body is not mis-parsed as a status.
read_power(){
  local body st
  body="$(curl -s --fail --max-time "$TV_TIMEOUT" -X POST "http://$TV_IP/sony/system" \
            -H 'Content-Type: application/json' \
            -d '{"method":"getPowerStatus","id":1,"params":[],"version":"1.0"}' 2>/dev/null)" || return 2
  st="$(classify_status "$body")" || return 2
  printf '%s' "$st"; return 0
}

if [ "${1:-}" = --test ]; then
  command -v python3 >/dev/null 2>&1 || { echo "smoke-test: FAIL (no python3)"; exit 1; }
  command -v curl    >/dev/null 2>&1 || { echo "smoke-test: FAIL (no curl)"; exit 1; }
  tf=0
  # ── classify_status fixtures (hermetic, no network) — the parse contract
  [ "$(classify_status '{"id":1,"result":[{"status":"active"}]}')"  = ACTIVE ]  || { echo "  FAIL: classify active→ACTIVE"; tf=1; }
  [ "$(classify_status '{"id":1,"result":[{"status":"standby"}]}')" = STANDBY ] || { echo "  FAIL: classify standby→STANDBY"; tf=1; }
  # unknown/transient value passes through uppercased (never dropped, never coerced to a phase we didn't read)
  [ "$(classify_status '{"id":1,"result":[{"status":"activating"}]}')" = ACTIVATING ] || { echo "  FAIL: classify passthrough activating→ACTIVATING"; tf=1; }
  # malformed / error bodies must be honest n/a (rc 2), NOT a faked read
  classify_status '{"id":1,"error":[7,"Illegal Request"]}' >/dev/null 2>&1 && { echo "  FAIL: error body must be n/a (rc 2), not a status"; tf=1; }
  classify_status 'not json'                               >/dev/null 2>&1 && { echo "  FAIL: non-json must be n/a (rc 2)"; tf=1; }
  classify_status '{"id":1,"result":[]}'                   >/dev/null 2>&1 && { echo "  FAIL: empty result must be n/a (rc 2)"; tf=1; }
  # ── REAL-READ gate (verification principle — a sense's --test must assert a live hardware read produces
  # data, not just exercise the offline classifier). Reachable TV → a parseable ACTIVE|STANDBY; unreachable
  # → honest exit 2 (mesh-land treats exit 2 as a pass, so this gates the real read WITHOUT blocking landing
  # when the TV is off-LAN). A reachable TV that returns garbage is a HARD fail (hollow sense).
  if live="$(read_power)"; then
    case "$live" in
      ACTIVE|STANDBY|ACTIVATING|*[A-Z]*) echo "smoke-test: ok (classify fixtures + LIVE read: TV=$live @ $TV_IP)"; [ "$tf" = 0 ] || exit 1; exit 0 ;;
      *) echo "smoke-test: FAIL (live read returned non-status '$live' — hollow)"; exit 1 ;;
    esac
  else
    [ "$tf" = 0 ] || { echo "smoke-test: FAIL (classify fixtures regressed)"; exit 1; }
    echo "smoke-test: n/a (classify fixtures ok; TV @ $TV_IP unreachable/off — honest exit 2, not a faked read)"; exit 2
  fi
fi

mode="${1:-}"

now="$(date +%s)"
prev_state=""; prev_ts=""
[ -f "$TV_STATE" ] && read -r prev_state prev_ts < "$TV_STATE" 2>/dev/null

if state="$(read_power)"; then rc=0; else rc=2; state="UNREACHABLE"; fi

# LIVENESS-touch: rewrite the state file EVERY run (mtime = ran-live), content = the change-gated value.
# (Decouples ran-live from value-changed so mtime watchdogs don't misread a long-stable TV as a dead sense.)
printf '%s %s\n' "$state" "$now" > "$TV_STATE"

lc="$(printf '%s' "$state" | tr 'A-Z' 'a-z')"
case "$mode" in
  --json)
    printf '{"tv":"%s","ts":%s,"prev":"%s","source":"getPowerStatus","ip":"%s"}\n' \
      "$lc" "$now" "$(printf '%s' "${prev_state:-none}" | tr 'A-Z' 'a-z')" "$TV_IP"
    ;;
  --edge)
    # post ONLY on a real state CHANGE between two REAL reads (rc 0). Never post on UNREACHABLE (honest
    # n/a is not an event — spamming [tv-power-unreachable] every 5m on a powered-off TV is noise), and
    # never post the cold-start first read. mesh-chat is the board; degrade quietly if absent.
    if [ "$rc" = 0 ] && [ -n "$prev_state" ] && [ "$prev_state" != "UNREACHABLE" ] && [ "$state" != "$prev_state" ]; then
      command -v mesh-chat >/dev/null 2>&1 && \
        mesh-chat "[tv-power-$lc] living-room TV → $lc (was $(printf '%s' "$prev_state" | tr 'A-Z' 'a-z')) @ $TV_IP — occupancy axis" >/dev/null 2>&1 || true
    fi
    ;;
  ""|--once)
    if [ "$rc" = 0 ]; then echo "TV $lc (getPowerStatus @ $TV_IP)"; else echo "TV n/a ($TV_IP unreachable/off — honest, no faked state)"; fi
    ;;
  *)
    echo "usage: mesh-tv-state [--json|--edge|--test]" >&2; exit 1
    ;;
esac
exit "$rc"
