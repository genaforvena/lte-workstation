#!/usr/bin/env bash
# mesh-song-verify — LISTEN to a rendered grind and verify it is still a coherent SONG before it
# ships to the operator. Born 2026-07-24 from his complaint: "неужели вы нормально не можете песню
# вытащить?! ну вы хоть раз сами слушайте и проверяйте что песня (в целом довольно однородная штука)".
#
# The grind reflexes (mesh-guitar-watch, mesh-sound-reflex → mesh-room-music) shipped every render
# BLIND — the operator's reaction was the ONLY quality signal, and he explicitly refuses to be the
# gate ("вы хоть раз САМИ слушайте"). This is that missing self-listen: it measures the candidate
# against its SOURCE on the axes that separate a song from granular soup, and returns a verdict so
# the caller ships the coherent ones and drops the mud.
#
# HIS CRITERION, taken literally — "a song is a fairly HOMOGENEOUS thing":
#   homog     temporal consistency: adjacent-frame chroma cosine (no jarring character jumps) AND
#             loudness not wildly uneven AND no long dead-silence gap. A song holds together.
#   harmfid   pitch-class-profile cosine to the SOURCE — did the grind KEEP the song, or smear it
#             into unrelated texture. (the operator plays a real phrase; a "song extracted" still
#             carries its harmony.)
#   rhythm    beats/s ≥ a fraction of the source's — a song has a pulse; a frozen drone does not.
#   bright    spectral rolloff floor — a c1-250 lowpass render is bass MUD, not a song.
#
# Usage:  mesh-song-verify <source> <candidate>          -> prints "SONG ok|<reason>" + metrics
#         mesh-song-verify --json <source> <candidate>
#         mesh-song-verify --test
# Exit:   0 = ship it (coherent song)   1 = reject (state which axis failed)
#         2 = CANNOT VERIFY (analyzer absent) — HONEST n/a, never a faked pass. The caller decides
#             whether to ship-unverified-loud; this tool never silently green-lights an unheard file.
set -uo pipefail

# thresholds — calibrated 2026-07-24 on the operator's own guitar session (guitar-orig-1802 55s
# source + its 5 shipped grinds: harmfid 0.98–0.999, rolloff 2003–4113Hz, beats/s 1.35–2.10; source
# rolloff 3908Hz beats/s 1.95). Env-tunable so recalibration is a knob, never an edit.
MIN_HARMFID="${SONG_MIN_HARMFID:-0.90}"   # cosine of chroma profile to source (kept the song)
MIN_HOMOG="${SONG_MIN_HOMOG:-0.80}"       # adjacent-frame chroma cosine (temporal consistency)
MAX_SILENT="${SONG_MAX_SILENT:-0.25}"     # max fraction of frames near-silent (no dead gaps)
MIN_ROLLOFF="${SONG_MIN_ROLLOFF:-700}"    # Hz — below this the render is bass mud
MIN_BEAT_FRAC="${SONG_MIN_BEAT_FRAC:-0.45}" # candidate beats/s must be >= this * source beats/s
SONG_PY="${SONG_VERIFY_PY:-$HOME/.venv-ai/bin/python}"

# ── COMPLETING DEFICIENCIES — the third control mechanism (report-only, 2026-08-14) ──────────────
# Live-lit landing, VSM/management-cybernetics lane: Dekkers, R. "On the Origins and Applications of
# the Cybernetic Steady-State Model as Systems-Theoretical Reference Model", *Systems* 13(11):961
# (2025), doi:10.3390/systems13110961, §2.1. The steady-state model is presented there as "a more
# practical extension of ... Beer's viable system model", making explicit what the VSM leaves
# implicit at the boundary zone of a primary process: coding, quality filters, buffers, overflow —
# and THREE control mechanisms, not two. Feedback intervenes UPSTREAM of the point of measurement;
# feedforward intervenes DOWNSTREAM of it; the third, which Dekkers calls **completing deficiencies**,
# is neither: "measuring detects deviations from a standard AFTER the transformation processes, and
# then the flowing elements are brought up to that standard in a separate, complementary process" —
# and only where no such process can reach the standard does the filter "lead to DISCARDING the
# flowing elements".
#
# This tool is the sound lane's OUTPUT-boundary quality filter, and it has only the discard half: a
# render either ships or is thrown away whole, while the correction that does happen (mesh-sound-
# reflex's repellent on the recipe) is pure FEEDBACK — it changes the NEXT grind, never rescues the
# element already produced. Cost is real: every reject is a completed grind (heavy-run slot, minutes
# of CPU) binned. Live first read of ~/.mesh/records.log (2026-08-14, 679 rows, 217 grinds): 10
# unshipped, reasons arrhythmic×5 dead-gaps×4 lost-song×1 — i.e. 4 of 10 discards failed on the ONE
# axis a bounded post-process on the rendered file can actually move (near-silent spans are trimmable;
# smeared harmony and a lost pulse are not), two of them by 4% (silent 0.26 vs the 0.25 line).
# The ledger is a sliding window, so those counts are a re-derivable reading, never a constant.
#
# What lands here is the CLASSIFICATION only — which failed axes are candidates for a complementary
# process and how far past the line each sits. It is report-only by construction: the verdict, the
# exit code and every caller's behaviour are untouched (mesh-sound-reflex:1412 and mesh-guitar-watch
# :249 read the rc and echo the text). A `rework=` tag is a HYPOTHESIS that a trim would clear the
# axis, not a claim that it did — the artifact for that would be the re-verify, and nothing here
# re-verifies anything.
# `-` not `:-`: an explicitly EMPTY SONG_REWORK_AXES must mean "classify nothing", the off-switch the
# --test drives to see this read go red. With `:-` the empty string falls back to the default and the
# knob is a no-op — the gate would then be asserting its own default, never the code path.
REWORK_AXES="${SONG_REWORK_AXES-dead-gaps}"         # axes a bounded post-process on the RENDER can move
REWORK_MAX_SILENT="${SONG_REWORK_MAX_SILENT:-0.50}" # above this, trimming would eat >half the render

JSON=0; [ "${1:-}" = "--json" ] && { JSON=1; shift; }

verify(){
  local src="$1" cand="$2"
  [ -s "$src" ]  || { echo "SONG n/a: source missing ($src)"; return 2; }
  [ -s "$cand" ] || { echo "SONG n/a: candidate missing ($cand)"; return 2; }
  [ -x "$SONG_PY" ] || { echo "SONG n/a: analyzer absent ($SONG_PY) — cannot listen"; return 2; }
  SV_SRC="$src" SV_CAND="$cand" \
  SV_HARMFID="$MIN_HARMFID" SV_HOMOG="$MIN_HOMOG" SV_SILENT="$MAX_SILENT" \
  SV_ROLLOFF="$MIN_ROLLOFF" SV_BEATFRAC="$MIN_BEAT_FRAC" SV_JSON="$JSON" \
  SV_REWORK_AXES="$REWORK_AXES" SV_REWORK_MAX_SILENT="$REWORK_MAX_SILENT" \
  "$SONG_PY" - <<'PY'
import os, sys, json
try:
    import librosa, numpy as np
except Exception as e:
    print(f"SONG n/a: librosa import failed ({e})"); sys.exit(2)

src=os.environ["SV_SRC"]; cand=os.environ["SV_CAND"]
try:
    ys,sr=librosa.load(src,sr=22050,mono=True)
    yc,_ =librosa.load(cand,sr=22050,mono=True)
except Exception as e:
    print(f"SONG n/a: decode failed ({e})"); sys.exit(2)
if len(yc) < sr*0.5:
    print("SONG reject: candidate <0.5s (collapsed render)"); sys.exit(1)

def profile(y):
    ch=librosa.feature.chroma_stft(y=y,sr=sr)
    return ch, ch.mean(axis=1)
chs,ps=profile(ys); chc,pc=profile(yc)
harmfid=float(np.dot(ps,pc)/(np.linalg.norm(ps)*np.linalg.norm(pc)+1e-9))
# temporal consistency: mean adjacent-frame cosine of normalized chroma
cn=chc/(np.linalg.norm(chc,axis=0,keepdims=True)+1e-9)
homog=float(np.mean(np.sum(cn[:,:-1]*cn[:,1:],axis=0))) if cn.shape[1]>1 else 0.0
rms=librosa.feature.rms(y=yc)[0]
silent=float(np.mean(rms < 0.02*(np.max(rms)+1e-9)))
rolloff=float(np.median(librosa.feature.spectral_rolloff(y=yc,sr=sr,roll_percent=0.85)[0]))
def bps(y):
    try:
        _,b=librosa.beat.beat_track(y=y,sr=sr); return len(b)/(len(y)/sr+1e-9)
    except Exception: return 0.0
sbps=bps(ys); cbps=bps(yc)
beatfrac=(cbps/sbps) if sbps>1e-6 else 1.0

H=lambda k:float(os.environ[k])
reasons=[]; axes=[]
def fail(axis, val, thr, over, text):
    # over=True  → the axis fails by being ABOVE the line (silent); margin = how far past it
    # over=False → it fails by being BELOW  the line (harmfid/homog/rolloff/beats)
    reasons.append(text)
    axes.append(dict(axis=axis, value=round(val,3), threshold=thr,
                     margin=round(((val-thr)/thr if over else (thr-val)/thr), 3)))
if harmfid < H("SV_HARMFID"): fail("lost-song",   harmfid, H("SV_HARMFID"), False, f"lost-song(harmfid {harmfid:.3f}<{H('SV_HARMFID'):.2f})")
if homog   < H("SV_HOMOG"):   fail("inhomogeneous",homog,  H("SV_HOMOG"),   False, f"inhomogeneous(homog {homog:.3f}<{H('SV_HOMOG'):.2f})")
if silent  > H("SV_SILENT"):  fail("dead-gaps",   silent,  H("SV_SILENT"),  True,  f"dead-gaps(silent {silent:.2f}>{H('SV_SILENT'):.2f})")
if rolloff < H("SV_ROLLOFF"): fail("mud",         rolloff, H("SV_ROLLOFF"), False, f"mud(rolloff {rolloff:.0f}<{H('SV_ROLLOFF'):.0f}Hz)")
if beatfrac< H("SV_BEATFRAC"):fail("arrhythmic",  beatfrac,H("SV_BEATFRAC"),False, f"arrhythmic(beats {cbps:.2f}={beatfrac:.2f}x src)")
ok = not reasons

# COMPLETING DEFICIENCIES (Dekkers 2025 §2.1 — see the header block): split the failed axes into the
# ones a bounded complementary process could bring up to standard ON THIS RENDER, and the ones where
# the deficiency is in the transformation itself, so the only controls left are feedback/feedforward
# on the recipe and the discard is honest. Only dead-gaps qualifies by default: near-silent spans are
# mechanically removable (ffmpeg silenceremove) whereas no post-process restores harmony (lost-song),
# a pulse (arrhythmic) or unrendered high end (mud). The band matters as much as the axis — trimming
# a render that is MOSTLY silence leaves less than half the material, which is a different artifact,
# not a completed one; hence REWORK_MAX_SILENT. A tag here is a candidate, never a repaired render.
REWORK_AXES=set(x for x in os.environ.get("SV_REWORK_AXES","").split(",") if x)
def reworkable(a):
    if a["axis"] not in REWORK_AXES: return False
    if a["axis"]=="dead-gaps":       return a["value"] <= float(os.environ["SV_REWORK_MAX_SILENT"])
    return True
# PER-AXIS, not per-render: a render can carry a reworkable axis AND a fundamental one at once (the
# --test fixture does — silence both trips dead-gaps and drags homog under its floor). A rework tag
# beside a non-empty fundamental set is not a green light; it says which part of the deficiency a
# complementary process could reach, and it stays true that the OTHER part it cannot.
rework=[a for a in axes if reworkable(a)]
fundamental=[a for a in axes if not reworkable(a)]
HINT={"dead-gaps":"trim-near-silent"}
# margin is always a DISTANCE past the line (never signed): the axes fail in opposite directions
# (silent from above, harmfid/homog/rolloff/beats from below) and a '+4%' that means 'below' on one
# axis and 'above' on the next is two renderings of one word. The reason clause right next to it
# already carries value-vs-threshold, so the tag only has to say how far.
def _tag(lst):
    return " ".join(f"{a['axis']}({a['margin']*100:.0f}% past"
                    + (f", {HINT[a['axis']]}" if a['axis'] in HINT and a in rework else "") + ")"
                    for a in lst) or "none"

metrics=dict(harmfid=round(harmfid,3),homog=round(homog,3),silent=round(silent,3),
             rolloff=round(rolloff),cbps=round(cbps,2),sbps=round(sbps,2),beatfrac=round(beatfrac,2))
if os.environ.get("SV_JSON")=="1":
    print(json.dumps(dict(ok=ok,reasons=reasons,rework=rework,fundamental=fundamental,**metrics)))
else:
    tag="ok" if ok else "reject: "+", ".join(reasons)
    line=(f"SONG {tag} | harmfid={metrics['harmfid']} homog={metrics['homog']} "
          f"silent={metrics['silent']} rolloff={metrics['rolloff']}Hz "
          f"beats={metrics['cbps']}({metrics['beatfrac']}x)")
    # the classification rides at the END of the reject line only — callers echo this text verbatim
    # (mesh-sound-reflex's not-a-song poke, the ledger's `unshipped:` clause), so an OK verdict keeps
    # its exact prior shape and a reject only ever GAINS a trailing clause.
    if not ok: line += f" | rework={_tag(rework)} fundamental={_tag(fundamental)}"
    print(line)
sys.exit(0 if ok else 1)
PY
}

selftest(){
  local tmp rc=0; tmp=$(mktemp -d)
  command -v ffmpeg >/dev/null 2>&1 || { echo "SKIP: ffmpeg absent"; rm -rf "$tmp"; exit 2; }
  [ -x "$SONG_PY" ] || { echo "SKIP real-read: analyzer $SONG_PY absent (exit 2 on a live node)"; rm -rf "$tmp"; exit 2; }
  # SOURCE: a bright, rhythmic 3-partial tone (440/880/1760Hz) with a 3Hz tremolo pulse — a stand-in
  # "song": real harmonic content (rolloff well above the mud floor) and a beat. A pure low sine is
  # legitimately dark, not mud, so it can't serve as the good fixture against a brightness floor.
  ffmpeg -y -f lavfi -i "sine=frequency=440:duration=6" -f lavfi -i "sine=frequency=880:duration=6" \
         -f lavfi -i "sine=frequency=1760:duration=6" \
         -filter_complex "amix=inputs=3:normalize=0,tremolo=f=3:d=0.8" "$tmp/src.wav" >/dev/null 2>&1
  # PASS: same material, lightly sped — keeps harmony, rhythm, brightness
  ffmpeg -y -i "$tmp/src.wav" -af "atempo=1.05" "$tmp/good.wav" >/dev/null 2>&1
  # FAIL(mud): crushed to bass by a hard 200Hz lowpass — the c1-250 soup the operator hears
  ffmpeg -y -i "$tmp/src.wav" -af "lowpass=f=200,lowpass=f=200,volume=3" "$tmp/mud.wav" >/dev/null 2>&1
  # FAIL(lost-song): unrelated white noise — kept none of the source's harmony
  ffmpeg -y -f lavfi -i "anoisesrc=d=6:c=pink:a=0.5" "$tmp/noise.wav" >/dev/null 2>&1
  # FAIL(dead-gaps): the SAME material with its tail replaced by silence — the one reject class whose
  # deficiency a complementary process can complete (trim the dead air). Kept under REWORK_MAX_SILENT
  # (~2.2s of 6s ≈ 0.37) so the rework classification is asserted INSIDE its band, not at an extreme.
  ffmpeg -y -i "$tmp/src.wav" -t 3.8 "$tmp/head.wav" >/dev/null 2>&1
  ffmpeg -y -f lavfi -i "anullsrc=r=44100:cl=mono" -t 2.2 "$tmp/sil.wav" >/dev/null 2>&1
  ffmpeg -y -i "$tmp/head.wav" -i "$tmp/sil.wav" -filter_complex "concat=n=2:v=0:a=1" "$tmp/gaps.wav" >/dev/null 2>&1
  echo "--- good  (must PASS) ---"; verify "$tmp/src.wav" "$tmp/good.wav";  local gr=$?
  echo "--- mud   (must FAIL) ---"; verify "$tmp/src.wav" "$tmp/mud.wav";   local mr=$?
  echo "--- noise (must FAIL) ---"; verify "$tmp/src.wav" "$tmp/noise.wav"; local nr=$?
  # COMPLETING-DEFICIENCIES classification (report-only): a dead-gaps reject must be tagged REWORK
  # (a bounded trim is a candidate to clear it) while the unrelated-noise reject must be tagged
  # FUNDAMENTAL — no post-process on the render restores harmony it never had. Assert the SHIPPED
  # text of both, and that the classification never flips the verdict: rc is still 1 for both.
  echo "--- gaps  (must FAIL, rework) ---"; local gaps_out gapsr noise_out
  gaps_out="$(verify "$tmp/src.wav" "$tmp/gaps.wav")"; gapsr=$?; printf '%s\n' "$gaps_out"
  noise_out="$(verify "$tmp/src.wav" "$tmp/noise.wav")"
  # a gate you have not seen FAIL is not a gate: good accepted (rc 0), mud + unrelated both rejected (rc 1)
  [ "$gr" = 0 ] || { echo "FAIL: faithful render was rejected (rc=$gr)"; rc=1; }
  [ "$mr" = 1 ] || { echo "FAIL: bass-mud render was NOT rejected (rc=$mr) — brightness axis blind"; rc=1; }
  [ "$nr" = 1 ] || { echo "FAIL: unrelated noise was NOT rejected (rc=$nr) — harmfid/homog axis blind"; rc=1; }
  [ "$gapsr" = 1 ] || { echo "FAIL: a mostly-silent render was NOT rejected (rc=$gapsr) — dead-gaps axis blind"; rc=1; }
  case "$gaps_out" in
    *"rework=dead-gaps("*) : ;;
    *) echo "FAIL: dead-gaps reject not classified reworkable (got: $gaps_out) — the completing-deficiencies read is dead"; rc=1 ;;
  esac
  case "$gaps_out" in *"fundamental="*"dead-gaps"*) echo "FAIL: dead-gaps appears in the FUNDAMENTAL set (got: $gaps_out)"; rc=1 ;; esac
  case "$noise_out" in
    *"rework=none"*) : ;;
    *) echo "FAIL: an unrelated-noise (lost-song) reject was offered as reworkable (got: $noise_out) — no trim restores harmony"; rc=1 ;;
  esac
  rm -rf "$tmp"
  [ "$rc" = 0 ] && echo "mesh-song-verify: --test OK (passes faithful, rejects mud + unrelated + dead-gaps — RED seen on 3 axes; completing-deficiencies split: dead-gaps reworkable, lost-song fundamental, verdict unchanged)" \
                || echo "mesh-song-verify: --test FAILED"
  return $rc
}

case "${1:-}" in
  -h|--help) sed -n '2,/^set -uo/p' "$0" | sed -n 's/^# \?//p' | sed '$d'; exit 0 ;;
  --test)    selftest; exit $? ;;
  "")        echo "usage: mesh-song-verify [--json] <source> <candidate>  |  --test" >&2; exit 2 ;;
  *)         [ $# -ge 2 ] || { echo "usage: mesh-song-verify [--json] <source> <candidate>" >&2; exit 2; }
             verify "$1" "$2"; exit $? ;;
esac
