#!/usr/bin/env bash
# mesh-song-verify — LISTEN to a rendered grind and verify it is still a coherent SONG before it
# ships to the operator. Born 2026-07-24 from his complaint: "неужели вы нормально не можете песню
# вытащить?! ну вы хоть раз сами слушайте и проверяйте что песня (в целом довольно однородная штука)".
#
# The grind reflexes (mesh-guitar-watch, mesh-sound-reflex → mesh-room-music) shipped every render
# BLIND — the operator's reaction was the ONLY quality signal, and he explicitly refuses to be the
# gate ("вы хоть раз САМИ слушайте"). This is that missing self-listen: it measures the candidate
# against its SOURCE on the axes that separate a song from granular soup, and returns a verdict so
# the caller ships the coherent ones and drops the mud.
#
# HIS CRITERION, taken literally — "a song is a fairly HOMOGENEOUS thing":
#   homog     temporal consistency: adjacent-frame chroma cosine (no jarring character jumps) AND
#             loudness not wildly uneven AND no long dead-silence gap. A song holds together.
#   harmfid   pitch-class-profile cosine to the SOURCE — did the grind KEEP the song, or smear it
#             into unrelated texture. (the operator plays a real phrase; a "song extracted" still
#             carries its harmony.)
#   rhythm    beats/s ≥ a fraction of the source's — a song has a pulse; a frozen drone does not.
#   bright    spectral rolloff floor — a c1-250 lowpass render is bass MUD, not a song.
#
# Usage:  mesh-song-verify <source> <candidate>          -> prints "SONG ok|<reason>" + metrics
#         mesh-song-verify --json <source> <candidate>
#         mesh-song-verify --test
# Exit:   0 = ship it (coherent song)   1 = reject (state which axis failed)
#         2 = CANNOT VERIFY (analyzer absent) — HONEST n/a, never a faked pass. The caller decides
#             whether to ship-unverified-loud; this tool never silently green-lights an unheard file.
set -uo pipefail

# thresholds — calibrated 2026-07-24 on the operator's own guitar session (guitar-orig-1802 55s
# source + its 5 shipped grinds: harmfid 0.98–0.999, rolloff 2003–4113Hz, beats/s 1.35–2.10; source
# rolloff 3908Hz beats/s 1.95). Env-tunable so recalibration is a knob, never an edit.
MIN_HARMFID="${SONG_MIN_HARMFID:-0.90}"   # cosine of chroma profile to source (kept the song)
MIN_HOMOG="${SONG_MIN_HOMOG:-0.80}"       # adjacent-frame chroma cosine (temporal consistency)
MAX_SILENT="${SONG_MAX_SILENT:-0.25}"     # max fraction of frames near-silent (no dead gaps)
MIN_ROLLOFF="${SONG_MIN_ROLLOFF:-700}"    # Hz — below this the render is bass mud
MIN_BEAT_FRAC="${SONG_MIN_BEAT_FRAC:-0.45}" # candidate beats/s must be >= this * source beats/s
SONG_PY="${SONG_VERIFY_PY:-$HOME/.venv-ai/bin/python}"

JSON=0; [ "${1:-}" = "--json" ] && { JSON=1; shift; }

verify(){
  local src="$1" cand="$2"
  [ -s "$src" ]  || { echo "SONG n/a: source missing ($src)"; return 2; }
  [ -s "$cand" ] || { echo "SONG n/a: candidate missing ($cand)"; return 2; }
  [ -x "$SONG_PY" ] || { echo "SONG n/a: analyzer absent ($SONG_PY) — cannot listen"; return 2; }
  SV_SRC="$src" SV_CAND="$cand" \
  SV_HARMFID="$MIN_HARMFID" SV_HOMOG="$MIN_HOMOG" SV_SILENT="$MAX_SILENT" \
  SV_ROLLOFF="$MIN_ROLLOFF" SV_BEATFRAC="$MIN_BEAT_FRAC" SV_JSON="$JSON" \
  "$SONG_PY" - <<'PY'
import os, sys, json
try:
    import librosa, numpy as np
except Exception as e:
    print(f"SONG n/a: librosa import failed ({e})"); sys.exit(2)

src=os.environ["SV_SRC"]; cand=os.environ["SV_CAND"]
try:
    ys,sr=librosa.load(src,sr=22050,mono=True)
    yc,_ =librosa.load(cand,sr=22050,mono=True)
except Exception as e:
    print(f"SONG n/a: decode failed ({e})"); sys.exit(2)
if len(yc) < sr*0.5:
    print("SONG reject: candidate <0.5s (collapsed render)"); sys.exit(1)

def profile(y):
    ch=librosa.feature.chroma_stft(y=y,sr=sr)
    return ch, ch.mean(axis=1)
chs,ps=profile(ys); chc,pc=profile(yc)
harmfid=float(np.dot(ps,pc)/(np.linalg.norm(ps)*np.linalg.norm(pc)+1e-9))
# temporal consistency: mean adjacent-frame cosine of normalized chroma
cn=chc/(np.linalg.norm(chc,axis=0,keepdims=True)+1e-9)
homog=float(np.mean(np.sum(cn[:,:-1]*cn[:,1:],axis=0))) if cn.shape[1]>1 else 0.0
rms=librosa.feature.rms(y=yc)[0]
silent=float(np.mean(rms < 0.02*(np.max(rms)+1e-9)))
rolloff=float(np.median(librosa.feature.spectral_rolloff(y=yc,sr=sr,roll_percent=0.85)[0]))
def bps(y):
    try:
        _,b=librosa.beat.beat_track(y=y,sr=sr); return len(b)/(len(y)/sr+1e-9)
    except Exception: return 0.0
sbps=bps(ys); cbps=bps(yc)
beatfrac=(cbps/sbps) if sbps>1e-6 else 1.0

H=lambda k:float(os.environ[k])
reasons=[]
if harmfid < H("SV_HARMFID"): reasons.append(f"lost-song(harmfid {harmfid:.3f}<{H('SV_HARMFID'):.2f})")
if homog   < H("SV_HOMOG"):   reasons.append(f"inhomogeneous(homog {homog:.3f}<{H('SV_HOMOG'):.2f})")
if silent  > H("SV_SILENT"):  reasons.append(f"dead-gaps(silent {silent:.2f}>{H('SV_SILENT'):.2f})")
if rolloff < H("SV_ROLLOFF"): reasons.append(f"mud(rolloff {rolloff:.0f}<{H('SV_ROLLOFF'):.0f}Hz)")
if beatfrac< H("SV_BEATFRAC"):reasons.append(f"arrhythmic(beats {cbps:.2f}={beatfrac:.2f}x src)")
ok = not reasons
metrics=dict(harmfid=round(harmfid,3),homog=round(homog,3),silent=round(silent,3),
             rolloff=round(rolloff),cbps=round(cbps,2),sbps=round(sbps,2),beatfrac=round(beatfrac,2))
if os.environ.get("SV_JSON")=="1":
    print(json.dumps(dict(ok=ok,reasons=reasons,**metrics)))
else:
    tag="ok" if ok else "reject: "+", ".join(reasons)
    print(f"SONG {tag} | harmfid={metrics['harmfid']} homog={metrics['homog']} "
          f"silent={metrics['silent']} rolloff={metrics['rolloff']}Hz "
          f"beats={metrics['cbps']}({metrics['beatfrac']}x)")
sys.exit(0 if ok else 1)
PY
}

selftest(){
  local tmp rc=0; tmp=$(mktemp -d)
  command -v ffmpeg >/dev/null 2>&1 || { echo "SKIP: ffmpeg absent"; rm -rf "$tmp"; exit 2; }
  [ -x "$SONG_PY" ] || { echo "SKIP real-read: analyzer $SONG_PY absent (exit 2 on a live node)"; rm -rf "$tmp"; exit 2; }
  # SOURCE: a bright, rhythmic 3-partial tone (440/880/1760Hz) with a 3Hz tremolo pulse — a stand-in
  # "song": real harmonic content (rolloff well above the mud floor) and a beat. A pure low sine is
  # legitimately dark, not mud, so it can't serve as the good fixture against a brightness floor.
  ffmpeg -y -f lavfi -i "sine=frequency=440:duration=6" -f lavfi -i "sine=frequency=880:duration=6" \
         -f lavfi -i "sine=frequency=1760:duration=6" \
         -filter_complex "amix=inputs=3:normalize=0,tremolo=f=3:d=0.8" "$tmp/src.wav" >/dev/null 2>&1
  # PASS: same material, lightly sped — keeps harmony, rhythm, brightness
  ffmpeg -y -i "$tmp/src.wav" -af "atempo=1.05" "$tmp/good.wav" >/dev/null 2>&1
  # FAIL(mud): crushed to bass by a hard 200Hz lowpass — the c1-250 soup the operator hears
  ffmpeg -y -i "$tmp/src.wav" -af "lowpass=f=200,lowpass=f=200,volume=3" "$tmp/mud.wav" >/dev/null 2>&1
  # FAIL(lost-song): unrelated white noise — kept none of the source's harmony
  ffmpeg -y -f lavfi -i "anoisesrc=d=6:c=pink:a=0.5" "$tmp/noise.wav" >/dev/null 2>&1
  echo "--- good  (must PASS) ---"; verify "$tmp/src.wav" "$tmp/good.wav";  local gr=$?
  echo "--- mud   (must FAIL) ---"; verify "$tmp/src.wav" "$tmp/mud.wav";   local mr=$?
  echo "--- noise (must FAIL) ---"; verify "$tmp/src.wav" "$tmp/noise.wav"; local nr=$?
  # a gate you have not seen FAIL is not a gate: good accepted (rc 0), mud + unrelated both rejected (rc 1)
  [ "$gr" = 0 ] || { echo "FAIL: faithful render was rejected (rc=$gr)"; rc=1; }
  [ "$mr" = 1 ] || { echo "FAIL: bass-mud render was NOT rejected (rc=$mr) — brightness axis blind"; rc=1; }
  [ "$nr" = 1 ] || { echo "FAIL: unrelated noise was NOT rejected (rc=$nr) — harmfid/homog axis blind"; rc=1; }
  rm -rf "$tmp"
  [ "$rc" = 0 ] && echo "mesh-song-verify: --test OK (passes faithful, rejects mud + unrelated — RED seen on 2 axes)" \
                || echo "mesh-song-verify: --test FAILED"
  return $rc
}

case "${1:-}" in
  -h|--help) sed -n '2,/^set -uo/p' "$0" | sed -n 's/^# \?//p' | sed '$d'; exit 0 ;;
  --test)    selftest; exit $? ;;
  "")        echo "usage: mesh-song-verify [--json] <source> <candidate>  |  --test" >&2; exit 2 ;;
  *)         [ $# -ge 2 ] || { echo "usage: mesh-song-verify [--json] <source> <candidate>" >&2; exit 2; }
             verify "$1" "$2"; exit $? ;;
esac
