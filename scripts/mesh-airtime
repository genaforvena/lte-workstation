#!/usr/bin/env bash
# orphan-ok: on-demand RF airtime read (measured QBSS beacon load; needs passwordless sudo iw — node-bound; pulled when asked, like mesh-wifi-congestion)
# mesh-airtime — MEASURED RF air busyness: what the neighbor APs themselves say the air is doing.
#
# NEW SIGNAL (no existing sense perceives it): every wifi sense so far infers — wifi-congestion
# COUNTS rival APs (an identity proxy: an idle AP and a saturating AP weigh the same),
# wifi-quality reads OUR link, wifiscan lists SSIDs, wifi-motion watches RSSI variance. None
# reads the QBSS load element neighbor APs broadcast in their beacons: their MEASURED channel
# utilisation (x/255 of airtime observed busy) and their associated STATION COUNT. Two real
# axes nothing else gives:
#   - utilisation  = how busy the air actually is (measurement, not AP-count proxy)
#   - stations     = neighborhood device density (how many clients the visible APs carry)
#
# Radio cost, honestly: the kernel BSS cache ages out in ~30s (live-proven: dump=1 BSS cold,
# 20 after a rescan) — a purely passive read is chronically hollow. Default = try the cache,
# and if hollow do ONE blocking nmcli rescan then re-dump (bounded; brief off-channel blip —
# this radio carries forwarded exit-node traffic, so this is an on-demand pull, not a tight
# loop). --passive forbids the rescan fallback; --fresh forces a rescan first.
#
# Privilege: `iw scan dump` needs NET_ADMIN → runs via `sudo -n iw` (passwordless sudo, the
# mesh-hw-health smartctl precedent). No sudo / no radio / hollow cache → exit 2, never a fake QUIET.
#
# Verdicts (vocab is a contract — consumers grep these tokens); classed on max utilisation
# among REPORTING APs (the air is judged by its busiest measured voice):
#   QUIET         max util < 10%
#   LIGHT         < 30%
#   BUSY          < 60%
#   SATURATED     >= 60%
#   NO-REPORTERS  APs visible but none broadcast QBSS — a GENUINE empty (real scan, no data),
#                 distinct from unreachable; exit 0
#   UNKNOWN       no radio / sudo-iw unavailable / hollow cache (< sanity-min APs) → exit 2
#
#   mesh-airtime            cache read, one bounded rescan fallback if hollow
#   mesh-airtime --passive  cache only, never rescan (may honestly return UNKNOWN|cache=HOLLOW)
#   mesh-airtime --fresh    blocking rescan first (off-channel blip; avoid in tight loops)
#   mesh-airtime --state    print the last written verdict (no fresh eval)
#   mesh-airtime --test     parser+classifier fixtures + a real live read gate
#
# STATE: ~/.mesh/.airtime.state — written unconditionally EVERY run (mtime = liveness).
# exit: 0 = verdict rendered · 2 = honest n/a
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"

# AIRTIME_STATE override wins; else MESH_TEST_SANDBOX=1 diverts the unconditional every-run state
# write to a throwaway — pre-fix, --test's real-read leg (e) stamped the LIVE artifact's mtime every
# doctor smoke storm, forging liveness for a possibly-dead cron (task test-live-writes 2026-07-20).
STATE="${AIRTIME_STATE:-$HOME/.mesh/.airtime.state}"
[ "${MESH_TEST_SANDBOX:-0}" != 1 ] || STATE="${AIRTIME_STATE:-${TMPDIR:-/tmp}/.airtime.state.sandbox.$$}"
SANITY_MIN="${AIRTIME_SANITY_MIN:-3}"   # below this AP count the cache is a stale miss, not ground truth (wifiscan convention)

classify(){ # <max_util_int_pct>
  local u="$1"
  if   [ "$u" -lt 10 ]; then echo QUIET
  elif [ "$u" -lt 30 ]; then echo LIGHT
  elif [ "$u" -lt 60 ]; then echo BUSY
  else echo SATURATED; fi
}

# parse an `iw scan dump` on stdin → "aps reporters umax umean stations b24max b5max" (ints, pct)
parse_dump(){
  awk '
    /^BSS /       { aps++; freq=0 }
    /^\tfreq:/    { freq=$2+0 }
    /station count:/       { sc=$NF+0; stations+=sc }
    /channel utilisation:/ {
      split($NF,a,"/"); if (a[2]+0==0) next
      u=a[1]*100/a[2]; reporters++; usum+=u
      if (u>umax) umax=u
      if (freq>0 && freq<3000) { if (u>b24) b24=u } else if (freq>0) { if (u>b5) b5=u }
    }
    END {
      umean = (reporters>0) ? usum/reporters : 0
      printf "%d %d %d %d %d %d %d\n", aps+0, reporters+0, umax+0, umean+0, stations+0, b24+0, b5+0
    }'
}

render(){ # <aps> <reporters> <umax> <umean> <stations> <b24> <b5> → verdict line; rc 3 = hollow
  local aps="$1" reporters="$2" umax="$3" umean="$4" stations="$5" b24="$6" b5="$7"
  [ "$aps" -lt "$SANITY_MIN" ] && return 3
  if [ "$reporters" -eq 0 ]; then
    echo "NO-REPORTERS|aps=$aps|no AP broadcasts QBSS load here"; return 0
  fi
  echo "$(classify "$umax")|util_max=${umax}%|util_mean=${umean}%|stations=$stations|reporters=$reporters/$aps|b24max=${b24}%|b5max=${b5}%"
}

evaluate(){
  local dump iface aps reporters umax umean stations b24 b5 v
  if [ -n "${AIRTIME_FIXTURE:-}" ]; then
    dump="$(cat "$AIRTIME_FIXTURE" 2>/dev/null)"
    read -r aps reporters umax umean stations b24 b5 <<<"$(printf '%s\n' "$dump" | parse_dump)"
    v="$(render "$aps" "$reporters" "$umax" "$umean" "$stations" "$b24" "$b5")" && { echo "$v"; return 0; }
    echo "UNKNOWN|cache=HOLLOW(aps=$aps<min=$SANITY_MIN)"; return 2
  fi
  iface="$(iw dev 2>/dev/null | awk '/Interface/{print $2; exit}')"
  [ -n "$iface" ] || { echo "UNKNOWN|radio=NONE"; return 2; }
  sudo -n true 2>/dev/null || { echo "UNKNOWN|iw=NO-PRIV(needs passwordless sudo)"; return 2; }
  if [ "${1:-}" = --fresh ]; then
    nmcli dev wifi list --rescan yes >/dev/null 2>&1   # blocking rescan, never a hand-rolled rescan+sleep race
  fi
  dump="$(sudo -n iw dev "$iface" scan dump 2>/dev/null)"
  read -r aps reporters umax umean stations b24 b5 <<<"$(printf '%s\n' "$dump" | parse_dump)"
  if v="$(render "$aps" "$reporters" "$umax" "$umean" "$stations" "$b24" "$b5")"; then echo "$v"; return 0; fi
  # cache hollow — one bounded rescan fallback (kernel BSS entries age out ~30s), unless --passive
  if [ "${1:-}" != --passive ]; then
    nmcli dev wifi list --rescan yes >/dev/null 2>&1
    dump="$(sudo -n iw dev "$iface" scan dump 2>/dev/null)"
    read -r aps reporters umax umean stations b24 b5 <<<"$(printf '%s\n' "$dump" | parse_dump)"
    if v="$(render "$aps" "$reporters" "$umax" "$umean" "$stations" "$b24" "$b5")"; then echo "$v"; return 0; fi
  fi
  echo "UNKNOWN|cache=HOLLOW(aps=$aps<min=$SANITY_MIN)"; return 2
}

if [ "${1:-}" = --state ]; then cat "$STATE" 2>/dev/null || { echo "no state yet" >&2; exit 1; }; exit 0; fi

if [ "${1:-}" = --test ]; then
  T="$(mktemp -d)"; trap 'rm -rf "$T"' EXIT
  # TEST-SANDBOX (task test-live-writes 2026-07-20): leg (e)'s real-read "$0" carried no
  # AIRTIME_STATE override — it stamped the live artifact. Sandbox every self-invoke + prove it.
  export MESH_TEST_SANDBOX=1
  _live_state="$HOME/.mesh/.airtime.state"
  _live_sig="$(stat -c '%Y %s' "$_live_state" 2>/dev/null || echo absent)"
  # (a) parser: canned dump with 2.4G reporter (53/255→20%), 5G reporter (153/255→60%), one silent AP
  cat > "$T/dump" <<'EOF'
BSS aa:aa:aa:aa:aa:aa(on wlp0)
	freq: 2412.0
	 * station count: 4
	 * channel utilisation: 53/255
BSS bb:bb:bb:bb:bb:bb(on wlp0)
	freq: 5180.0
	 * station count: 2
	 * channel utilisation: 153/255
BSS cc:cc:cc:cc:cc:cc(on wlp0)
	freq: 2437.0
EOF
  out="$(AIRTIME_FIXTURE="$T/dump" AIRTIME_STATE="$T/state" "$0")" || { echo "smoke-test: FAIL (fixture rc)"; exit 1; }
  printf '%s' "$out" | grep -q '^SATURATED|util_max=60%|util_mean=40%|stations=6|reporters=2/3|b24max=20%|b5max=60%$' \
    || { echo "smoke-test: FAIL (parse/classify → got '$out')"; exit 1; }
  # (b) APs but zero QBSS reporters → NO-REPORTERS (genuine empty), exit 0
  grep -v 'station count\|utilisation' "$T/dump" > "$T/dump2"
  out="$(AIRTIME_FIXTURE="$T/dump2" AIRTIME_STATE="$T/state" "$0")" && printf '%s' "$out" | grep -q '^NO-REPORTERS|aps=3' \
    || { echo "smoke-test: FAIL (no-reporters → got '$out')"; exit 1; }
  # (c) hollow cache (< sanity-min APs) → UNKNOWN + rc=2, never a fake QUIET
  : > "$T/dump3"
  out="$(AIRTIME_FIXTURE="$T/dump3" AIRTIME_STATE="$T/state" "$0")"; rc=$?
  [ "$rc" = 2 ] && printf '%s' "$out" | grep -q '^UNKNOWN|cache=HOLLOW' \
    || { echo "smoke-test: FAIL (hollow → rc=$rc '$out')"; exit 1; }
  # (d) classifier boundaries
  for pair in "9 QUIET" "10 LIGHT" "29 LIGHT" "30 BUSY" "59 BUSY" "60 SATURATED"; do
    set -- $pair
    got="$(classify "$1")"; [ "$got" = "$2" ] || { echo "smoke-test: FAIL (classify $1 → $got, want $2)"; exit 1; }
  done
  # (e) REAL read: radio+sudo present → must parse real APs (rc=0, aps in the verdict);
  #     absent → honest rc=2 UNKNOWN. Never a malformed line.
  out="$("$0")"; rc=$?
  if iw dev 2>/dev/null | grep -q Interface && sudo -n true 2>/dev/null; then
    if [ "$rc" = 0 ]; then
      printf '%s' "$out" | grep -qE '^(QUIET|LIGHT|BUSY|SATURATED|NO-REPORTERS)\|' \
        || { echo "smoke-test: FAIL (radio+priv present but live read gave '$out' — hollow sense)"; exit 1; }
    elif [ "$rc" = 2 ]; then
      printf '%s' "$out" | grep -q '^UNKNOWN|' \
        || { echo "smoke-test: FAIL (rc=2 but unexpected output '$out')"; exit 1; }
    else
      echo "smoke-test: FAIL (live rc=$rc)"; exit 1
    fi
  else
    [ "$rc" = 2 ] && printf '%s' "$out" | grep -q '^UNKNOWN|' \
      || { echo "smoke-test: FAIL (no radio/priv but got rc=$rc '$out')"; exit 1; }
  fi
  # sandbox honesty gate: no self-invoke above may have touched the live artifact (mtime+size).
  # Falsify: drop the sandbox diversion at the STATE assignment → leg (e) moves the sig.
  _live_sig2="$(stat -c '%Y %s' "$_live_state" 2>/dev/null || echo absent)"
  [ "$_live_sig2" = "$_live_sig" ] || { echo "smoke-test: FAIL (--test stamped the LIVE state $_live_state: '$_live_sig' → '$_live_sig2')"; exit 1; }
  echo "smoke-test: ok"; exit 0
fi

# --- one read: evaluate, write state unconditionally (mtime = ran-live), echo ---
v="$(evaluate "${1:-}")"; rc=$?
printf '%s\n' "$v" > "$STATE.tmp" && mv "$STATE.tmp" "$STATE"
echo "$v"
exit "$rc"
