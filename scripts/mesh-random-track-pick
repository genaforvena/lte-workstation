#!/usr/bin/env python3
"""Draw uniformly until an item is USABLE, logging every rejection.

Rejection is legitimate sampling (uniform over the sub-population meeting a necessary
condition) but only if the reasons are visible — a silent redraw loop is indistinguishable
from cherry-picking. Two necessary conditions:
  · licence permits DERIVATIVES (no -nd) — verified per item, not trusted from the query
  · the item actually contains a downloadable audio file (stubs exist: the first draw,
    00PsEnoughRecordsRadioShow012, had 6 files and none were audio)
"""
import json, random, subprocess, sys, urllib.parse
BASE="https://archive.org/advancedsearch.php"
import os
UNIVERSE=os.environ.get('RTG_UNIVERSE') or 'collection:netlabels AND licenseurl:[* TO *] AND NOT licenseurl:*-nd*'
CAP=9000
def curl(url):
    return subprocess.run(["env","-u","HTTP_PROXY","-u","HTTPS_PROXY","-u","ALL_PROXY",
        "-u","http_proxy","-u","https_proxy","-u","all_proxy","curl","-sL","--max-time","90",url],
        capture_output=True,text=True).stdout
def q(qs,rows=0,start=0,fl=None,sort=None):
    # PAGE, NOT START. advancedsearch.php silently IGNORES `start=` — measured 2026-08-29, offsets
    # 0/409/1441/3000 over one year stratum all returned the identical first document. A draw built
    # on `start` is therefore not uniform at all: it returns the sort-first item of whichever
    # stratum k lands in (~29 reachable items out of 26k), i.e. exactly the "chart wearing a
    # different name" this lane was told to avoid. `page` is 1-based and IS honoured.
    page = (start // rows + 1) if rows else 1
    url=BASE+"?"+urllib.parse.urlencode({"q":qs,"rows":rows,"output":"json","page":page})
    for f in (fl or []): url+="&fl%5B%5D="+f
    if sort: url+="&sort%5B%5D="+urllib.parse.quote(sort)
    return json.loads(curl(url))
years=list(range(1998,2027)); counts=[]
for y in years:
    try: counts.append(q(f'{UNIVERSE} AND addeddate:[{y}-01-01 TO {y}-12-31]')["response"]["numFound"])
    except Exception: counts.append(0)
pool=sum(counts); print(f"pool={pool}",file=sys.stderr)
rejects=[]
for attempt in range(1,int(os.environ.get('RTG_MAXTRY',25))+1):
    k=random.randrange(pool); acc=0
    for y,n in zip(years,counts):
        if acc+n>k:
            off=k-acc; qs=f'{UNIVERSE} AND addeddate:[{y}-01-01 TO {y}-12-31]'
            if n>CAP:
                for m in range(1,13):
                    qm=f'{UNIVERSE} AND addeddate:[{y}-{m:02d}-01 TO {y}-{m:02d}-31]'
                    nm=q(qm)["response"]["numFound"]
                    if off<nm: qs,n=qm,nm; break
                    off-=nm
            off=min(off,CAP-1)
            d=q(qs,rows=1,start=off,fl=["identifier","licenseurl","title","creator","year"],sort="identifier asc")
            docs=d["response"]["docs"]
            if not docs: rejects.append((attempt,"?","empty-page")); break
            doc=docs[0]; ident=doc["identifier"]; lic=doc.get("licenseurl","")
            if "-nd" in lic or not lic:
                rejects.append((attempt,ident,"licence-forbids-derivatives")); break
            md=json.loads(curl(f"https://archive.org/metadata/{ident}") or "{}")
            # SIZE BAND, not just "is audio". Netlabel items include 3-hour DJ sets: one draw picked
            # a 214 MB mp3, which the fetch timeout could not pull and which the O(n^2) grinder would
            # never finish. The operator asked for a TRACK, so out-of-band items are REJECTED and
            # redrawn past (logged), never silently truncated or ground for hours.
            LO, HI = 200_000, 30_000_000
            allaud=[f for f in md.get("files",[]) if f.get("name","").lower().endswith((".mp3",".ogg",".flac",".wav"))]
            auds=[f for f in allaud if LO < int(f.get("size",0) or 0) < HI]
            if not auds:
                why = "no-audio-file" if not allaud else "audio-out-of-size-band(%d files, smallest %dMB)" % (
                    len(allaud), min(int(f.get("size",0) or 0) for f in allaud)//1048576)
                rejects.append((attempt,ident,why)); break
            auds.sort(key=lambda f:int(f.get("size",0)))
            pick=auds[len(auds)//2]
            print(json.dumps({"attempts":attempt,"draw_k":k,"pool":pool,"identifier":ident,
                "licence":lic,"title":doc.get("title"),"creator":doc.get("creator"),
                "year":doc.get("year"),"file":pick["name"],"size":int(pick.get("size",0)),
                "n_audio_files":len(auds),
                "url":f"https://archive.org/download/{ident}/{urllib.parse.quote(pick['name'])}",
                "rejects":rejects}))
            sys.exit(0)
        acc+=n
print(json.dumps({"error":"attempts exhausted","rejects":rejects}),file=sys.stderr); sys.exit(1)
