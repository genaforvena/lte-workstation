#!/usr/bin/env bash
# mesh-quota-react — PRE-wall model downshift for the paid claude windows (the reaction mesh-quota
# deliberately doesn't do: mesh-quota is the read-only truth surface; THIS acts on it).
#
# WHY (operator TG 2026-07-06 14:1x, task quota-react-model-switch): "when a model hits its
# limit/wall, the mesh gives NO reaction; the model could be switched BEFORE hitting the wall".
# The existing reaction chain is all POST-wall and ENGINE-level (channel-keepalive sheds a walled
# claude and relaunches opencode, .quota-fallback mark auto-reverts on reset). Nothing reacts to
# the NEAR-wall signal, and nothing shifts the MODEL (opus→sonnet→haiku) to stretch the session
# window before the hard wall lands. This reflex closes that gap.
#
# PATTERN PROVENANCE (the task's lib-scan deliverable, ideas folded not copied):
#  - LiteLLM router: ordered fallback model-groups (walk down a declared chain under pressure)
#    + per-deployment cooldown (a tripped deployment sits out; we reuse .rl-cooldown-* marks).
#  - Router "usage-based routing" needs a known budget; providers give us none — so the burn-rate
#    trigger is OPERATOR-SET (env), never an invented ceiling (mesh-quota honesty rule).
#
# MECHANICS — one GLOBAL ladder position (the 5h/weekly limits are account-wide, not per-window):
#   pressure = hard wall banner on any paid pane (rl_is_walled, shared shape gate)
#            | near-wall banner on any paid pane (rl_is_nearwall below, same shape discipline)
#            | paid burn ≥ MESH_BURN_SOFT_1H rt/1h (OPT-IN: unset = banner-only, honest default)
#   pressure && rung<max && cooldown elapsed  → rung+1, send "/model <rung-model>" to each paid
#                                               window still running claude (walled/fallback panes
#                                               are keepalive's, not ours)
#   no pressure && rung>0 && recover elapsed  → rung-1 (walk back up one; full reset walks all the
#                                               way up over successive quiet evals)
#   Ladder: MESH_MODEL_LADDER (default "default sonnet haiku"; rung 0 "default" = the operator's
#   own account/session default, so a full recovery restores exactly what the operator chose).
#
#   mesh-quota-react --edge     evaluate + act (cron)
#   mesh-quota-react --status   read-only: rung, model, stamps (no write path — see memory
#                               status-read-shares-write-path-mutates)
#   mesh-quota-react --test     fixture smoke (classifier + ladder decisions; sends dry-run)
#
# reflex-cadence: */5 * * * *
# reflex-args: --edge
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
MESH="$HOME/.mesh"; SESS="${MESH_QUOTA_REACT_SESS:-$(hostname)}"  # env override: test isolation only
STATE="$MESH/.model-ladder"                       # "<rung>|<epoch-of-last-change>"
CLAUDE_WINDOWS="${MESH_CLAUDE_WINDOWS:-minds genome tg}"
LADDER="${MESH_MODEL_LADDER:-default sonnet haiku}"
BURN_SOFT="${MESH_BURN_SOFT_1H:-}"                # paid rt/1h; unset = banner-only (honest)
SHIFT_COOLDOWN="${MESH_SHIFT_COOLDOWN:-1800}"     # min s between successive downshifts
RECOVER_S="${MESH_MODEL_RECOVER_S:-3600}"         # quiet s before walking one rung back up
DRYRUN="${MESH_QUOTA_REACT_DRYRUN:-}"

# shared banner-shape lib (hard wall); inline fallback keeps the tool self-contained
if [ -f "$HOME/.local/bin/mesh-patterns.sh" ]; then . "$HOME/.local/bin/mesh-patterns.sh" 2>/dev/null || true
elif [ -f "$(dirname "$0")/mesh-patterns.sh" ]; then . "$(dirname "$0")/mesh-patterns.sh" 2>/dev/null || true; fi
type rl_is_walled >/dev/null 2>&1 || rl_is_walled(){ grep -qiE 'hit your (usage|session) limit|usage limit reached|too many requests|429|out of credits'; }

# rl_is_nearwall — stdin: pane lines. 0 iff a GENUINE approaching-limit banner is present.
# Same shape discipline as rl_is_walled (banner-shape not keyword, memory rate-limit-banner-shape):
# board-echo lines stripped, prompt-glyph lines dropped, match only on a TERSE line (banners are
# short; a mind's prose about limits is long-form). A HARD wall is NOT near — callers check
# rl_is_walled first; this matches only the pre-wall warning shapes the claude TUI emits
# ("Approaching usage limit · resets at 3am", "You've used 80% of your session limit").
rl_is_nearwall(){
  local txt; txt="$(cat)"
  txt="$(printf '%s\n' "$txt" | grep -vE '^[[:space:]]*[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:Z]+  [^ ]+  ::  ')"
  printf '%s\n' "$txt" | grep -vE '^[[:space:]]*[❯›]' \
    | awk 'length($0)<=120' \
    | grep -qiE 'approaching[^.]*(usage|session|weekly|rate) limit|used [0-9]{2}% of (your|the) (session|usage|weekly)|[0-9]{2}% (of|toward)[^.]*limit'
}

pane_of(){ tmux list-panes -t "$SESS:$1" -F '#{pane_top} #{pane_index}' 2>/dev/null | sort -n | tail -1 | awk '{print $2}'; }
engine_of(){ # $1=win.idx → claude/opencode/... or '-'
  # test-only hook (chat-review/quotareact-keepalive-shed-race): MESH_QR_ENGINE_MOCK is a
  # comma-separated sequence, one value per call, so a fixture can simulate a window that IS
  # claude at detect-time but was shed (killed+relaunched by channel-keepalive) by the time
  # the send loop re-checks the same window a few lines later — a real process-tree fixture
  # can't reproduce that race deterministically. Every call to engine_of runs inside a
  # $(...) command substitution (a subshell), so the call counter must be FILE-backed —
  # a plain shell variable's increment never survives the subshell exit.
  if [ -n "${MESH_QR_ENGINE_MOCK:-}" ]; then
    local cf="${MESH_QR_ENGINE_MOCK_STATE:-$MESH/.qr-engine-mock-call}"
    local i=0; [ -f "$cf" ] && i=$(cat "$cf" 2>/dev/null); [ -n "$i" ] || i=0
    printf '%s' "$((i + 1))" > "$cf"
    local -a _seq; IFS=',' read -ra _seq <<< "$MESH_QR_ENGINE_MOCK"
    local last=$(( ${#_seq[@]} - 1 ))
    [ "$i" -gt "$last" ] && i=$last
    echo "${_seq[$i]}"
    return
  fi
  local pid; pid=$(tmux display -p -t "$SESS:$1" '#{pane_pid}' 2>/dev/null) || { echo '-'; return; }
  local e; e=$(pstree -p "$pid" 2>/dev/null | grep -oE 'claude|opencode|codex|agy|gemini' | head -1)
  echo "${e:--}"
}
units_paid_1h(){ # same unit as mesh-quota burn (spend.log paid lines, rolling 1h)
  local log="${MESH_SPEND_LOG:-$MESH/spend.log}"; [ -f "$log" ] || { echo 0; return; }
  local cut; cut=$(date -u -d '60 minutes ago' +%Y-%m-%dT%H:%M 2>/dev/null) || { echo 0; return; }
  awk -v c="$cut" '$1>c && $6=="paid"{n++} END{print n+0}' "$log"
}

# next_rung — PURE decision (testable): $1=cur $2=pressure(0/1) $3=elapsed-since-change
#             $4=max-rung $5=shift-cooldown $6=recover-s → echoes the new rung
next_rung(){
  local cur=$1 pres=$2 el=$3 max=$4 cd=$5 rec=$6
  if [ "$pres" = 1 ]; then
    [ "$cur" -lt "$max" ] && [ "$el" -ge "$cd" ] && { echo $((cur+1)); return; }
  else
    [ "$cur" -gt 0 ] && [ "$el" -ge "$rec" ] && { echo $((cur-1)); return; }
  fi
  echo "$cur"
}

read_state(){ # → "rung epoch" (defaults 0 + now-on-first-run)
  local r=0 ep=0
  [ -f "$STATE" ] && { r=$(cut -d'|' -f1 "$STATE" 2>/dev/null); ep=$(cut -d'|' -f2 "$STATE" 2>/dev/null); }
  printf '%s' "$r" | grep -qE '^[0-9]+$' || r=0
  printf '%s' "$ep" | grep -qE '^[0-9]+$' || ep=0
  echo "$r $ep"
}

do_send(){ # $1=window $2=model — the ONE outbound choke-point (dry-run gated for tests)
  if [ -n "$DRYRUN" ]; then echo "DRYRUN: mesh-tell $1 /model $2"; return 0; fi
  # chat-review/quotareact-dosend-confirmdialog-falsenegative: capture mesh-tell's OWN delivery
  # result BEFORE calling _confirm_dialog. _confirm_dialog only returns 0 when a "Switch model?"
  # dialog was actually seen+dismissed within its poll window — when /model applies silently (the
  # common case on an idle pane), it falls through with a failed grep as its exit status. Deriving
  # do_send's return from that (the old behavior: no explicit return, so _confirm_dialog's status
  # leaked out as do_send's own) misreported a successful send as "no claude pane" every time no
  # dialog happened to pop up. Dialog-accept stays a fire-and-forget side effect; delivery is the
  # only thing that decides success.
  local rc
  mesh-tell --ack "$1" "/model $2" 2>/dev/null; rc=$?
  [ "$rc" -eq 0 ] || { mesh-tell "$1" "/model $2"; rc=$?; }
  _confirm_dialog "$1"
  return "$rc"
}

# _is_confirm_dialog — stdin: recent pane lines. 0 iff Claude Code's model-switch confirm
# ('Switch model?' / '❯ 1. Yes') is showing — same gate glyph mesh-gate-watch/mesh-patterns.sh use.
_is_confirm_dialog(){ grep -qE 'Switch model\?|❯ 1\. Yes'; }

# _confirm_dialog — poll the target pane ~1s×8 after /model for the confirm dialog and press
# Enter if it appears. Without this, /model can pop the dialog and WEDGE the pane (mind-blocked
# — chat 15:58:20Z: 4+ stalls today, one 16min, incl. the genome pane that would land this fix).
_confirm_dialog(){ # $1=window
  local p; p=$(pane_of "$1"); [ -n "$p" ] || return 0
  local target="$SESS:$1.$p" i
  for i in 1 2 3 4 5 6 7 8; do
    sleep 1
    tmux capture-pane -t "$target" -p 2>/dev/null | awk 'NF' | tail -4 | _is_confirm_dialog \
      && { tmux send-keys -t "$target" Enter; return 0; }
  done
}

edge(){
  mkdir -p "$MESH"
  read -r LAD_ARR <<<""; read -ra LAD_ARR <<<"$LADDER"; local max=$(( ${#LAD_ARR[@]} - 1 ))
  local now; now=$(date +%s)
  local rung ep; read -r rung ep < <(read_state); [ "$ep" = 0 ] && ep=$now
  [ "$rung" -gt "$max" ] && rung=$max
  # ---- sense pressure across the paid panes -------------------------------------------
  local pres=0 why=""
  local w p tail8
  for w in $CLAUDE_WINDOWS; do
    p=$(pane_of "$w"); [ -n "$p" ] || continue
    [ "$(engine_of "$w.$p")" = claude ] || continue   # chat-review/quotareact-pressureloop-no-engine-gate:
    # a dead/non-claude pane's frozen scrollback can false-positive rl_is_walled/nearwall and ratchet
    # the ladder even though the send loop below (already gated) never actually reaches it.
    tail8=$(tmux capture-pane -t "$SESS:$w.$p" -p -S -12 2>/dev/null | grep -vE '^[[:space:]]*$' | tail -8)
    [ -n "$tail8" ] || continue
    if printf '%s\n' "$tail8" | rl_is_walled; then pres=1; why="hard-wall:$w"; break; fi
    if printf '%s\n' "$tail8" | rl_is_nearwall; then pres=1; why="near-wall:$w"; break; fi
  done
  if [ "$pres" = 0 ] && [ -n "$BURN_SOFT" ] && printf '%s' "$BURN_SOFT" | grep -qE '^[0-9]+$'; then
    local b; b=$(units_paid_1h)
    [ "$b" -ge "$BURN_SOFT" ] && { pres=1; why="burn:$b/1h>=$BURN_SOFT"; }
  fi
  # ---- decide + act --------------------------------------------------------------------
  local new; new=$(next_rung "$rung" "$pres" $((now-ep)) "$max" "$SHIFT_COOLDOWN" "$RECOVER_S")
  if [ "$new" != "$rung" ]; then
    local model=${LAD_ARR[$new]} sent=""
    # chat-review/quotareact-keepalive-shed-race: $why (if set) carries "<kind>:<window>" from
    # the detect loop above — the SPECIFIC window whose banner tripped pressure. If THAT window
    # no longer passes engine_of=claude here (mesh-channel-keepalive, a separately-cadenced
    # cron, can shed_mind() it in the gap between the two loops), the empty $sent below is a
    # race, not the original "no claude pane configured at all" bug this gate already fixed.
    local trigger_w=""
    case "$why" in hard-wall:*|near-wall:*) trigger_w="${why#*:}" ;; esac
    local trigger_raced=false
    for w in $CLAUDE_WINDOWS; do
      p=$(pane_of "$w"); [ -n "$p" ] || continue
      if [ "$(engine_of "$w.$p")" != claude ]; then   # fallback/opencode panes are keepalive's
        [ -n "$trigger_w" ] && [ "$w" = "$trigger_w" ] && trigger_raced=true
        continue
      fi
      do_send "$w" "$model" && sent="$sent $w"
    done
    printf '%s|%s\n' "$new" "$now" > "$STATE"
    local dir=down; [ "$new" -lt "$rung" ] && dir=up
    command -v mesh-trace >/dev/null 2>&1 && mesh-trace "quota-react: ladder $dir rung $rung->$new (/model $model ->${sent:- none}) ${why:+trigger=$why}" >/dev/null 2>&1 || true
    local race_note=""
    [ -z "$sent" ] && [ "$trigger_raced" = true ] && race_note=" (trigger window shed mid-cycle by channel-keepalive — race, not a persistent gap)"
    if [ -z "$DRYRUN" ] && command -v mesh-chat >/dev/null 2>&1; then
      MESH_WHO="quota-react@$SESS" mesh-chat "[fyi] quota-react: model ladder $dir rung $rung->$new → /model $model sent to${sent:- no claude pane}${race_note} ${why:+(trigger $why)}; revert is automatic (recover ${RECOVER_S}s quiet → walk up)" >/dev/null || true
    fi
  elif [ -f "$STATE" ]; then
    { command -v mesh-state-touch >/dev/null 2>&1 && mesh-state-touch "$STATE"; } || touch "$STATE"  # liveness-touch: ran-live ≠ value-changed
  else
    printf '%s|%s\n' "$rung" "$now" > "$STATE"   # first run: seed the state file
  fi
}

status(){ # READ-ONLY (no mkdir, no touch, no state write)
  local rung ep; read -r rung ep < <(read_state)
  read -ra LAD_ARR <<<"$LADDER"
  local model="${LAD_ARR[$rung]:-?}" age="never"
  [ "$ep" -gt 0 ] && age="$(( ($(date +%s) - ep) / 60 ))m ago"
  echo "model-ladder: rung $rung/$(( ${#LAD_ARR[@]} - 1 )) (model=$model) · last change $age · ladder: $LADDER"
  echo "triggers: banner(near/hard, always on) · burn ${BURN_SOFT:-unset (opt-in MESH_BURN_SOFT_1H)}"
}

case "${1:-}" in
  --edge) edge ;;
  --status) status ;;
  --_confirm-dialog-poll) _confirm_dialog "${2:-0}" ;;  # internal test hooks, not for operator use
  --_do_send-test) do_send "${2:-x}" "${3:-model}" ;;
  --test)
    # tmp fence — task:doctor-test-tmpdir-cleanup-traps. Re-exec the smoke test ONCE under a private
    # TMPDIR and remove it from the PARENT, so the cleanup cannot be lost to the test's own `exit 1`
    # and cannot be clobbered by an EXIT trap the test sets for itself. A nested --test inherits the
    # guard var and skips its own fence (it is already inside one).
    if [ -z "${MESH_TEST_TMPD:-}" ]; then
      MESH_TEST_TMPD="$(mktemp -d)" || { echo "smoke-test: FAIL (tmp fence: mktemp -d)"; exit 1; }
      trap 'rm -rf "$MESH_TEST_TMPD"' EXIT INT HUP TERM
      export MESH_TEST_TMPD TMPDIR="$MESH_TEST_TMPD" TMP="$MESH_TEST_TMPD" TEMP="$MESH_TEST_TMPD"
      _fence_rc=0; "$0" "$@" || _fence_rc=$?; exit "$_fence_rc"
    fi
    fail(){ echo "smoke-test: FAIL ($1)"; exit 1; }
    # 1) near-wall classifier: banner-shape, not keyword
    printf 'Approaching usage limit · resets at 3am\n' | rl_is_nearwall || fail "real near-banner missed"
    printf "You've used 80%% of your session limit\n" | rl_is_nearwall || fail "percent banner missed"
    printf 'we are approaching usage limit design territory in this long prose line about quota reactions and ladders and thresholds, not a banner\n' | rl_is_nearwall && fail "long prose matched"
    printf '2026-07-06T14:00:00Z  tg@node  ::  approaching usage limit chatter\n' | rl_is_nearwall && fail "board echo matched"
    printf '❯ approaching usage limit test input\n' | rl_is_nearwall && fail "prompt line matched"
    # 2) ladder decisions (pure)
    [ "$(next_rung 0 1 9999 2 1800 3600)" = 1 ] || fail "pressure should shift down"
    [ "$(next_rung 0 1 10 2 1800 3600)" = 0 ]  || fail "cooldown must hold"
    [ "$(next_rung 2 1 9999 2 1800 3600)" = 2 ] || fail "max rung must clamp"
    [ "$(next_rung 2 0 9999 2 1800 3600)" = 1 ] || fail "quiet should recover up"
    [ "$(next_rung 1 0 10 2 1800 3600)" = 1 ]  || fail "recover must wait"
    [ "$(next_rung 0 0 9999 2 1800 3600)" = 0 ] || fail "rung0 quiet must hold"
    # 3) edge is side-effect-safe under DRYRUN + sandbox HOME (no real sends, no real state)
    td=$(mktemp -d) || fail mktemp; trap 'rm -rf "$td"' EXIT
    out=$(HOME="$td" MESH_QUOTA_REACT_DRYRUN=1 MESH_CLAUDE_WINDOWS="" bash "$0" --edge 2>&1) || fail "edge errored: $out"
    printf '%s' "$out" | grep -q 'mesh-tell' && fail "edge sent despite empty window set"
    [ -f "$td/.mesh/.model-ladder" ] || fail "liveness-touch missing on no-change eval"
    out=$(HOME="$td" bash "$0" --status) || fail "status errored"
    printf '%s' "$out" | grep -q 'rung 0' || fail "status must show rung 0: $out"
    # 4) confirm-dialog classifier (pure)
    printf '  Switch model?\n❯ 1. Yes\n  2. No\n' | _is_confirm_dialog || fail "real dialog missed"
    printf 'model-ladder: rung 0/2 (model=default)\n' | _is_confirm_dialog && fail "status line matched"
    printf '❯ some other prompt\n' | _is_confirm_dialog && fail "bare prompt glyph false-matched"
    # 5) DRYRUN stays inert: do_send must never reach _confirm_dialog. _confirm_dialog polls
    #    8×1s if it runs, so a DRYRUN call finishing well under that proves it was skipped.
    out=$(MESH_QUOTA_REACT_DRYRUN=1 timeout 3 bash "$0" --_do_send-test nonexistent-window sonnet 2>&1) \
      || fail "DRYRUN do_send hung/errored — _confirm_dialog was reached: $out"
    printf '%s' "$out" | grep -q 'DRYRUN: mesh-tell nonexistent-window /model sonnet' || fail "DRYRUN do_send output wrong: $out"
    # 6) live poll: dialog-fixture → exactly 1 Enter sent + dialog cleared; no-dialog-fixture → 0 extra keys
    if command -v tmux >/dev/null 2>&1; then
      # PRIVATE TMUX SERVER (chat-review/quotareact-test-sharedtmux-contention): isolate ALL fixture
      # tmux (server + sessions) from the node's DEFAULT/shared server so mesh-doctor's parallel
      # smoke-test storm can't contend on the shared control socket or collide on session names
      # (recurring mesh-quota-react FAIL 4x this session). NOTE the deliberate divergence from the task's
      # "mirror mesh-tell's -L exactly": mesh-tell's test is IN-PROCESS (it overrides cap_tail), so -L on
      # its own tmux calls suffices. THIS test spawns the REAL tool as a SUBPROCESS ('bash "$0" --edge/
      # --_confirm-dialog-poll/--_do_send-test') whose OWN internal tmux calls (pane_of/capture-pane/
      # send-keys) run on the default socket — a bare -L on only the fixture calls would leave that
      # subprocess unable to see the fixture session and break every assert. TMUX_TMPDIR relocates the
      # DEFAULT socket for BOTH the fixtures AND every inheriting subprocess with ONE env var and zero
      # tool-code changes; a final kill-server tears down the private server. mktemp -d per invocation →
      # each concurrent --test gets its OWN server, so identical session names can never collide either.
      # mktemp failure MUST hard-fail here: without an isolated socket the fixtures would land on
      # the node's DEFAULT/shared server (polluting the sensorium) AND the kill-server teardown below
      # would nuke that shared server. Never run these fixtures un-isolated.
      _mqr_td="$(mktemp -d 2>/dev/null)" || _mqr_td=""
      [ -n "$_mqr_td" ] || fail "quota-react tmux fixtures: mktemp -d failed — refusing to run on the shared server"
      export TMUX_TMPDIR="$_mqr_td"
      # `unset TMUX` is LOAD-BEARING: run from INSIDE a pane ($TMUX set — mesh-doctor's smoke-sweep,
      # or a mind running --test in its channel), tmux takes the socket path FROM $TMUX and ignores
      # TMUX_TMPDIR entirely. Without this, every fixture below lands on the node's DEFAULT server and
      # the kill-server teardown nukes the node session + every mind pane (live incident 2026-07-14
      # 23:00Z, 14-window session killed). Under cron $TMUX is unset, which is why this survived
      # --edge runs and only ever detonated when a mind or doctor ran --test from a pane.
      unset TMUX
      _mqr_sock="$_mqr_td/tmux-$(id -u)/default"
      # Teardown on ANY exit — INCLUDING a fail() mid-block (fail=exit 1), which would otherwise skip
      # the inline kill-server at the end and leak the private server. A leaked read-blocked fixture
      # session keeps that server alive, and a lingering server can hold inherited fds — this froze
      # mesh-doctor for 3h on 2026-07-10 (a leaked test-qr2 server held doctor's fd9 → .doctor.lock →
      # every flock -n run exited silently). Guard on OUR PRIVATE SOCKET FILE existing — never on
      # $TMUX_TMPDIR: the env var stays set even when tmux is talking to the DEFAULT socket, which is
      # exactly how the old guard passed while kill-server destroyed the sensorium. The socket path is
      # a real observable; the env var is only a claim.
      # Supersedes the earlier `trap 'rm -rf "$td"'`; clean both here.
      _mqr_cleanup(){
        [ -S "${_mqr_sock:-}" ] && tmux kill-server 2>/dev/null
        [ -n "${_mqr_td:-}" ] && rm -rf "$_mqr_td"
        [ -n "${td:-}" ] && rm -rf "$td"
      }
      trap _mqr_cleanup EXIT
      ts="test-qr-$$"
      tmux new-session -d -s "$ts" -x 80 -y 10 \
        'printf "Switch model?\n❯ 1. Yes\n  2. No\n"; read -r ans; printf "GOT=[%s]\n" "$ans"; sleep 5' 2>/dev/null
      sleep 0.3
      # ISOLATION assert (two real observables): our private server exists (what the kill-server
      # teardown is guarded on), and the fixture is INVISIBLE on the node's default server. Falsify:
      # drop the `unset TMUX` above and run from inside a pane → fixture on the default socket → FAIL.
      [ -S "$_mqr_sock" ] || fail "no private tmux socket at $_mqr_sock — fixtures are NOT isolated"
      env -u TMUX_TMPDIR tmux has-session -t "$ts" 2>/dev/null && \
        fail "fixture session '$ts' is visible on the node's DEFAULT tmux server — not isolated; a kill-server here destroys the sensorium"
      MESH_QUOTA_REACT_SESS="$ts" bash "$0" --_confirm-dialog-poll 0 >/dev/null 2>&1
      sleep 0.3
      out=$(tmux capture-pane -t "$ts:0.0" -p 2>/dev/null)
      tmux kill-session -t "$ts" 2>/dev/null
      printf '%s' "$out" | grep -q 'GOT=\[\]' || fail "dialog-fixture: Enter not delivered (got: $out)"

      ts2="test-qr2-$$"
      tmux new-session -d -s "$ts2" -x 80 -y 10 \
        'printf "no dialog here\n"; read -r ans; printf "GOT=[%s]\n" "$ans"; sleep 5' 2>/dev/null
      sleep 0.3
      MESH_QUOTA_REACT_SESS="$ts2" timeout 3 bash "$0" --_confirm-dialog-poll 0 >/dev/null 2>&1
      out2=$(tmux capture-pane -t "$ts2:0.0" -p 2>/dev/null)
      tmux kill-session -t "$ts2" 2>/dev/null
      printf '%s' "$out2" | grep -q 'GOT=' && fail "no-dialog-fixture: extra key sent (got: $out2)"

      # 7) chat-review/quotareact-pressureloop-no-engine-gate: the pressure loop must skip a pane
      # whose engine isn't claude, same gate the send loop already enforces at do_send-time. Fixture:
      # a bare-shell pane (no claude/opencode/etc in its process tree) printing a near-wall banner;
      # state pre-seeded past cooldown so a false pressure read WOULD ratchet the rung if the gate
      # were missing (live: phaedra's dead genome pane's frozen near-wall scrollback ratcheted
      # rung 0->1->2 while sends hit "no claude pane").
      ts3="test-qr3-$$"
      tmux new-session -d -s "$ts3" -n fakewin -x 80 -y 10 \
        'printf "Approaching usage limit · resets at 3am\n"; sleep 5' 2>/dev/null
      sleep 0.3
      td3=$(mktemp -d) || fail mktemp3
      mkdir -p "$td3/.mesh"
      old=$(( $(date +%s) - 2000 ))
      printf '0|%s\n' "$old" > "$td3/.mesh/.model-ladder"
      out3=$(HOME="$td3" MESH_QUOTA_REACT_SESS="$ts3" MESH_CLAUDE_WINDOWS="fakewin" \
             MESH_QUOTA_REACT_DRYRUN=1 bash "$0" --edge 2>&1)
      tmux kill-session -t "$ts3" 2>/dev/null
      rung3=$(cut -d'|' -f1 "$td3/.mesh/.model-ladder" 2>/dev/null)
      rm -rf "$td3"
      [ "$rung3" = 0 ] || fail "non-claude pane's banner ratcheted the ladder to rung $rung3 (engine gate missing): $out3"

      # 8) chat-review/quotareact-keepalive-shed-race: the send loop's board message must
      # distinguish "the SPECIFIC trigger window was shed mid-cycle (a race with
      # mesh-channel-keepalive)" from "no claude pane at all" (the original, already-fixed
      # gap). Fixture A: a window IS engine=claude at detect-time (mocked engine_of call #1)
      # but flips to non-claude by the time the send loop re-checks the same window (mocked
      # call #2) -> board message must carry the race-specific wording.
      ts4="test-qr4-$$"
      tmux new-session -d -s "$ts4" -n racewin -x 80 -y 10 \
        'printf "Approaching usage limit · resets at 3am\n"; sleep 5' 2>/dev/null
      sleep 0.3
      td4=$(mktemp -d) || fail mktemp4
      mkdir -p "$td4/.mesh"
      old4=$(( $(date +%s) - 2000 ))
      printf '0|%s\n' "$old4" > "$td4/.mesh/.model-ladder"
      # MESH_DIR redirected OFF "$HOME/.mesh" (chat-review/quotareact-test-sandboxed-chat-swallow):
      # mesh-chat's MESH_TEST_SANDBOX defense (doctor exports it around every child --test) swallows
      # any post whose MESH_DIR == "$HOME/.mesh" — HOME-only sandboxing reads as "the real board",
      # so under doctor this fixture's board line never landed and msg4 asserted against "". A
      # redirected MESH_DIR is mesh-chat's own documented self-sandbox escape: the post still lands.
      HOME="$td4" MESH_DIR="$td4/chat-sb" MESH_QUOTA_REACT_SESS="$ts4" MESH_CLAUDE_WINDOWS="racewin" \
        MESH_QR_ENGINE_MOCK="claude,opencode" bash "$0" --edge >/dev/null 2>&1
      tmux kill-session -t "$ts4" 2>/dev/null
      msg4=$(tail -1 "$td4/chat-sb/chat.log" 2>/dev/null)
      rm -rf "$td4"
      printf '%s' "$msg4" | grep -q 'shed mid-cycle by channel-keepalive — race' \
        || fail "race-specific wording missing on trigger-window-shed: $msg4"

      # Fixture B (regression guard): pressure via burn-rate (no per-window trigger at all,
      # why=burn:...) with a configured window that simply has no live pane (pane_of empty,
      # same as CLAUDE_WINDOWS effectively unset — bash's ${VAR:-default} would silently
      # refill a truly EMPTY-string override with the default list) -> sent stays empty for
      # the ORIGINAL reason (no claude pane exists to send to at all), message must keep the
      # plain, generic wording — the race note must not leak in when there was no specific
      # trigger window to have raced.
      td5=$(mktemp -d) || fail mktemp5
      mkdir -p "$td5/.mesh"
      old5=$(( $(date +%s) - 2000 ))
      printf '0|%s\n' "$old5" > "$td5/.mesh/.model-ladder"
      now5=$(date -u +%Y-%m-%dT%H:%M:%SZ)
      printf '%s f2 f3 f4 f5 paid\n' "$now5" > "$td5/.mesh/spend.log"
      # Same MESH_DIR redirect as Fixture A — see the sandboxed-chat-swallow note above.
      HOME="$td5" MESH_DIR="$td5/chat-sb" MESH_QUOTA_REACT_SESS="test-qr5-nosuchsession-$$" MESH_CLAUDE_WINDOWS="noexistwin" \
        MESH_BURN_SOFT_1H=1 bash "$0" --edge >/dev/null 2>&1
      msg5=$(tail -1 "$td5/chat-sb/chat.log" 2>/dev/null)
      rm -rf "$td5"
      printf '%s' "$msg5" | grep -q 'sent to no claude pane (trigger burn:' \
        || fail "regression: burn-trigger generic wording changed/broken: $msg5"
      printf '%s' "$msg5" | grep -q 'shed mid-cycle' \
        && fail "regression: race wording leaked into a non-race (burn-trigger) message: $msg5"

      # 9) chat-review/quotareact-dosend-confirmdialog-falsenegative: do_send's return code must
      # track mesh-tell's OWN delivery result, not whether a confirm-dialog happened to appear.
      # Fixture A: mesh-tell succeeds, target pane never shows the dialog (the common/idle case)
      # -> do_send must return 0. Pre-fix this FAILS: _confirm_dialog polls 8x1s, finds nothing,
      # and its failed grep exit status leaks out as do_send's own return.
      tdmt=$(mktemp -d) || fail mktempmt
      mkdir -p "$tdmt/.local/bin"
      printf '#!/usr/bin/env bash\nexit 0\n' > "$tdmt/.local/bin/mesh-tell"
      chmod +x "$tdmt/.local/bin/mesh-tell"
      ts6="test-qr6-$$"
      tmux new-session -d -s "$ts6" -n sendwin -x 80 -y 10 'printf "no dialog here\n"; sleep 12' 2>/dev/null
      sleep 0.3
      HOME="$tdmt" MESH_QUOTA_REACT_SESS="$ts6" bash "$0" --_do_send-test sendwin sonnet >/dev/null 2>&1
      rc6=$?
      tmux kill-session -t "$ts6" 2>/dev/null
      rm -rf "$tdmt"
      [ "$rc6" -eq 0 ] || fail "do_send must return 0 when mesh-tell succeeds even with no confirm dialog (got rc=$rc6)"

      # Fixture B (regression guard): mesh-tell itself genuinely fails to deliver -> do_send must
      # still return non-zero (proves the fix tracks real delivery, not just "always return 0").
      tdmt2=$(mktemp -d) || fail mktempmt2
      mkdir -p "$tdmt2/.local/bin"
      printf '#!/usr/bin/env bash\nexit 1\n' > "$tdmt2/.local/bin/mesh-tell"
      chmod +x "$tdmt2/.local/bin/mesh-tell"
      HOME="$tdmt2" MESH_QUOTA_REACT_SESS="test-qr7-nosuchsession-$$" bash "$0" --_do_send-test nosendwin sonnet >/dev/null 2>&1
      rc7=$?
      rm -rf "$tdmt2"
      [ "$rc7" -ne 0 ] || fail "do_send must return non-zero when mesh-tell genuinely fails to deliver (got rc=0)"
      # Private-server teardown + tmpdir cleanup is owned by the _mqr_cleanup EXIT trap installed above
      # (fires on success AND on any fail() mid-block); no inline kill-server here — see that comment.
    fi
    echo "smoke-test: ok"; exit 0 ;;
  *) echo "usage: mesh-quota-react [--edge|--status|--test]"; exit 2 ;;
esac
