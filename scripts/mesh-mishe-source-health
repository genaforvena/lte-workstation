#!/usr/bin/env python3
"""Report source-age coverage from trusted pane projections, never private pane text."""
import importlib.machinery
import importlib.util
import os
from pathlib import Path
import re
import subprocess
import sys

ROOT = Path(__file__).resolve().parent
AUDIT_KINDS = {"DONE", "IGNORED", "REJECTED", "DLQ", "HELD_REJECTED", "QUEUED",
               "READY_INDEPENDENT", "OPEN_UNOWNED", "HELD_EXPIRED", "BLOCKED",
               "RUNNING", "OVERDUE"}
loader = importlib.machinery.SourceFileLoader("mishe_project_health", str(ROOT / "mesh-mishe-project"))
spec = importlib.util.spec_from_loader(loader.name, loader)
project = importlib.util.module_from_spec(spec)
loader.exec_module(project)


def check(channels):
    stale, unknown, suspended, ineligible = [], [], [], []
    audit_lines = None
    audit_checked = False
    for channel in channels:
        role = project.CHANNEL_ROLES[channel]
        try:
            result = subprocess.run([str(ROOT / "mesh-mishe-render"), channel, role],
                                    env={**os.environ, "MESH_MISHE_RENDER_SOURCE": "pane"},
                                    text=True, capture_output=True, timeout=4)
            event = project.fleet_projection(channel, result.stdout) if result.returncode == 0 else ""
        except (OSError, subprocess.TimeoutExpired):
            event = ""
        source = "journal" if channel == "witness" else "comments" if channel == "pub" else "cleaner" if channel == "cleaner" else "goal"
        observation = re.search(rf"\b{source}=(fresh|stale|unknown)\b", event)
        if observation and observation.group(1) == "stale" and event.startswith("STATE: RED\n"):
            stale.append(channel)
        elif not observation or observation.group(1) != "fresh":
            unknown.append(channel)
        elif channel in project.SEMANTIC_SOURCES:
            name = project.SEMANTIC_SOURCES[channel]
            semantic = re.search(rf"\bsemantic={name}:(fresh|stale|unknown|suspended)\b", event)
            if semantic and semantic.group(1) == "suspended" and channel == "minds":
                suspended.append(channel)
            elif semantic and semantic.group(1) == "stale" and event.startswith("STATE: RED\n"):
                stale.append(channel)
            elif (channel in ("adint", "haunt", "hire", "wake") and semantic
                  and semantic.group(1) == "unknown" and event.startswith("STATE: UNKNOWN\n")):
                if not audit_checked:
                    audit_checked = True
                    command = os.environ.get("MESH_MISHE_TASK_AUDIT_CMD", str(ROOT / "mesh-task"))
                    try:
                        audit = subprocess.run([command, "audit"], text=True,
                                               capture_output=True, timeout=10)
                        if audit.returncode or len(audit.stdout.encode("utf-8")) > 4_000_000:
                            raise ValueError("task audit unavailable")
                        audit_lines = audit.stdout.splitlines()
                        if not audit_lines or any(
                            line.split("\t", 1)[0] not in AUDIT_KINDS or line.count("\t") < 2
                            for line in audit_lines
                        ):
                            raise ValueError("task audit malformed")
                    except (OSError, ValueError, UnicodeError, subprocess.TimeoutExpired):
                        audit_lines = None
                if audit_lines is not None and not any(
                    line.split("\t", 3)[:2] == ["OVERDUE", channel] for line in audit_lines
                ):
                    # No verified overdue obligation is an eligibility result,
                    # never a fresh business-source observation.
                    ineligible.append(channel)
                else:
                    unknown.append(channel)
            elif not semantic or semantic.group(1) != "fresh":
                unknown.append(channel)
    if stale or unknown:
        print("FAIL source freshness: " + "; ".join(
            item for item in ("stale=" + ",".join(stale) if stale else "",
                             "unknown=" + ",".join(unknown) if unknown else "",
                             "ineligible=" + ",".join(ineligible) if ineligible else "") if item))
        return 1
    print(f"PASS source freshness: {len(channels) - len(suspended) - len(ineligible)} observed channels" +
          (f"; suspended={','.join(suspended)}" if suspended else "") +
          (f"; ineligible={','.join(ineligible)} (no verified overdue obligation; semantic=unknown)"
           if ineligible else ""))
    return 0

if __name__ == "__main__":
    if sys.argv[1:] == ["--test"]:
        result = subprocess.run([sys.executable, "-m", "unittest",
                                 "tests/test-mesh-mishe-fleet-projection.py",
                                 "-k", "source_health"],
                                cwd=ROOT.parent, timeout=10)
        raise SystemExit(result.returncode)
    if len(sys.argv) == 1:
        selected = tuple(project.CHANNEL_ROLES)
    elif sys.argv[1:] == ["--health-pane"]:
        # The health dashboard is rendering its own frame. Sampling itself
        # mid-frame would manufacture an unavailable lease; doctor checks all 17.
        selected = tuple(channel for channel in project.CHANNEL_ROLES if channel != "health")
    elif len(sys.argv) == 3 and sys.argv[1] == "--channel" and sys.argv[2] in project.CHANNEL_ROLES:
        selected = (sys.argv[2],)
    else:
        print("usage: mesh-mishe-source-health [--channel enrolled-role | --health-pane] | --test", file=sys.stderr)
        raise SystemExit(2)
    raise SystemExit(check(selected))
