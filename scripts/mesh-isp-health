#!/usr/bin/env bash
# mesh-isp-health — passive upstream-quality monitor.
#
#   mesh-isp-health         run once: ping 1.1.1.1 + 8.8.8.8, append to log
#   mesh-isp-health --summary  read log, report last-1h + last-24h stats
#   mesh-isp-health --verdict  upstream-down | upstream-ok | upstream-unknown
#
# Log: ~/.mesh/isp-health.log (auto-rotated to ~5000 lines).
# Stats: uptime %, blip count, longest blip, avg latency.
#
# reflex-cadence: */5 * * * *
set -uo pipefail

LOG="${ISP_HEALTH_LOG:-$HOME/.mesh/isp-health.log}"
MAX_LINES=5000
# A verdict is only as live as the probe behind it, and mtime is the liveness signal
# (run_probe appends unconditionally). So create the log without bumping mtime — a plain
# touch here would make every --verdict call refresh its own staleness check away.
mkdir -p "$(dirname "$LOG")"
[ -e "$LOG" ] || : >"$LOG"
# Newest write older than 3 probe cadences = the probe is dead, not the ISP fine.
STALE_AGE="${ISP_HEALTH_STALE_AGE:-900}"

ts() { date -u +%Y-%m-%dT%H:%M:%SZ; }

# --- rotate ------------------------------------------------------------
rotate_log() {
  local lines
  lines=$(wc -l <"$LOG" 2>/dev/null || echo 0)
  if [ "$lines" -gt "$MAX_LINES" ]; then
    tail -n "$MAX_LINES" "$LOG" >"$LOG.tmp" && mv "$LOG.tmp" "$LOG"
  fi
}

# --- probe ---------------------------------------------------------------
run_probe() {
  local tt now t1_lat t2_lat t1_status t2_status avg
  now=$(ts)
  t1_status=FAIL; t2_status=FAIL; avg=-

  if t1_out=$(ping -c 1 -W 3 1.1.1.1 2>/dev/null); then
    t1_lat=$(echo "$t1_out" | awk -F'/' '/^rtt/ {printf "%.1fms", $5}')
    t1_status="OK:${t1_lat:-?}"
  fi
  if t2_out=$(ping -c 1 -W 3 8.8.8.8 2>/dev/null); then
    t2_lat=$(echo "$t2_out" | awk -F'/' '/^rtt/ {printf "%.1fms", $5}')
    t2_status="OK:${t2_lat:-?}"
  fi

  if [ "$t1_status" != FAIL ] || [ "$t2_status" != FAIL ]; then
    if [ "$t1_status" != FAIL ] && [ "$t2_status" != FAIL ]; then
      t1n=$(echo "$t1_lat" | grep -oP '[\d.]+')
      t2n=$(echo "$t2_lat" | grep -oP '[\d.]+')
      avg=$(awk "BEGIN {printf \"%.1fms\", ($t1n+$t2n)/2}")
    elif [ "$t1_status" != FAIL ]; then
      avg="$t1_lat"
    else
      avg="$t2_lat"
    fi
  fi

  printf '%s %s %s avg:%s\n' "$now" "$t1_status" "$t2_status" "$avg" >>"$LOG"
  rotate_log
  echo "$now  $t1_status  $t2_status  avg:$avg"
}

# --- summary --------------------------------------------------------------
summarize() {
  local now cutoff_1h cutoff_24h cutoff_1h_str cutoff_24h_str
  now=$(date -u +%s)
  cutoff_1h=$((now - 3600))
  cutoff_24h=$((now - 86400))
  cutoff_1h_str=$(date -u -d "@$cutoff_1h" +%Y-%m-%dT%H:%M:%SZ)
  cutoff_24h_str=$(date -u -d "@$cutoff_24h" +%Y-%m-%dT%H:%M:%SZ)

  compute_window() {
    local label="$1" cutoff_str="$2"
    awk -v label="$label" -v cutoff="$cutoff_str" '
      BEGIN {
        total = up = blips = longest_blip = cur_blip = lat_cnt = 0
        lat_sum = 0
      }
      NF < 4 { next }
      $1 < cutoff { next }
      {
        total++
        t1 = $2
        t2 = $3
        avg = $4

        if (avg ~ /^avg:[0-9.]+ms$/) {
          gsub(/^avg:/, "", avg)
          gsub(/ms$/, "", avg)
          lat_sum += avg + 0
          lat_cnt++
        }

        if (t1 == "FAIL" && t2 == "FAIL") {
          cur_blip++
          if (cur_blip > longest_blip) longest_blip = cur_blip
        } else {
          up++
          if (cur_blip > 0) {
            blips++
            cur_blip = 0
          }
        }
      }
      END {
        if (cur_blip > 0) blips++
        uptime = (total > 0) ? sprintf("%.1f", (up / total) * 100) : "0.0"
        avg_ms = (lat_cnt > 0) ? sprintf("%.1fms", lat_sum / lat_cnt) : "-"
        printf "  %s\n", label
        printf "    probes: %d\n", total
        printf "    uptime: %s%% (%d/%d)\n", uptime, up, total
        printf "    blips:  %d\n", blips
        printf "    longest-blip: %d runs\n", longest_blip
        printf "    avg-latency: %s\n\n", avg_ms
      }
    ' "$LOG"
  }

  echo "=== mesh-isp-health summary ($(ts)) ==="
  echo "  targets: 1.1.1.1, 8.8.8.8"
  echo
  compute_window "last-1h:" "$cutoff_1h_str"
  compute_window "last-24h:" "$cutoff_24h_str"
}

# --- verdict --------------------------------------------------------------
verdict() {
  local lines both_fail=0 total=0
  local last3 age
  # No data is not an all-clear. An empty or frozen log means nothing was measured, and
  # the honest-fusion rule is that an unreachable input renders UNKNOWN, never a faked ok.
  last3=$(tail -n 3 "$LOG" 2>/dev/null)
  [ -z "$last3" ] && { echo "upstream-unknown"; return; }
  age=$(( $(date -u +%s) - $(stat -c %Y "$LOG" 2>/dev/null || echo 0) ))
  [ "$age" -gt "$STALE_AGE" ] && { echo "upstream-unknown"; return; }
  while read -r line; do
    [ -z "$line" ] && continue
    total=$((total + 1))
    t1=$(echo "$line" | awk '{print $2}')
    t2=$(echo "$line" | awk '{print $3}')
    [ "$t1" = FAIL ] && [ "$t2" = FAIL ] && both_fail=$((both_fail + 1))
  done <<<"$last3"
  if [ "$total" -ge 1 ] && [ "$both_fail" = "$total" ]; then
    echo "upstream-down"
  else
    echo "upstream-ok"
  fi
}

case "${1:-}" in
  --test)
    command -v ping >/dev/null 2>&1 || { echo "smoke-test: FAIL (ping not found)"; exit 1; }
    mkdir -p "$(dirname "$LOG")" 2>/dev/null && touch "$LOG" 2>/dev/null || { echo "smoke-test: FAIL (log dir not writable: $(dirname "$LOG"))"; exit 1; }
    # dry-run: test the verdict() fn against synthetic log fixtures
    _td="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
    trap 'rm -rf "$_td"' EXIT
    # 3 consecutive FAIL → downstream (both targets down)
    printf '%s\n' \
      "2020-01-01T00:00:00Z FAIL FAIL avg:-" \
      "2020-01-01T00:00:01Z FAIL FAIL avg:-" \
      "2020-01-01T00:00:02Z FAIL FAIL avg:-" > "$_td/down.log"
    _v="$(ISP_HEALTH_LOG="$_td/down.log" "$0" --verdict 2>/dev/null)"
    [ "$_v" = "upstream-down" ] || { echo "smoke-test: FAIL (verdict on 3 FAIL: expected upstream-down, got '$_v')"; exit 1; }
    # 2 OK + 1 FAIL → upstream (one target reachable = ok)
    printf '%s\n' \
      "2020-01-01T00:00:00Z OK:5.0ms FAIL avg:-" \
      "2020-01-01T00:00:01Z FAIL FAIL avg:-" \
      "2020-01-01T00:00:02Z OK:5.0ms OK:3.0ms avg:4.0ms" > "$_td/ok.log"
    _v="$(ISP_HEALTH_LOG="$_td/ok.log" "$0" --verdict 2>/dev/null)"
    [ "$_v" = "upstream-ok" ] || { echo "smoke-test: FAIL (verdict on 2 OK + 1 FAIL: expected upstream-ok, got '$_v')"; exit 1; }
    # empty log → upstream-unknown (no data = no verdict, NEVER an all-clear)
    printf '' > "$_td/empty.log"
    _v="$(ISP_HEALTH_LOG="$_td/empty.log" "$0" --verdict 2>/dev/null)"
    [ "$_v" = "upstream-unknown" ] || { echo "smoke-test: FAIL (verdict on empty log: expected upstream-unknown, got '$_v')"; exit 1; }
    # stale log → upstream-unknown: real data, but the probe behind it stopped. mtime is
    # the liveness signal, so a log nothing has written to in >STALE_AGE has no verdict.
    printf '%s\n' \
      "2020-01-01T00:00:00Z OK:5.0ms OK:3.0ms avg:4.0ms" > "$_td/stale.log"
    touch -d '@0' "$_td/stale.log"
    _v="$(ISP_HEALTH_LOG="$_td/stale.log" "$0" --verdict 2>/dev/null)"
    [ "$_v" = "upstream-unknown" ] || { echo "smoke-test: FAIL (verdict on stale log: expected upstream-unknown, got '$_v')"; exit 1; }
    # ...and the staleness check must not be defeated by our own log-create touch: the
    # same content with a FRESH mtime is a live reading again.
    touch "$_td/stale.log"
    _v="$(ISP_HEALTH_LOG="$_td/stale.log" "$0" --verdict 2>/dev/null)"
    [ "$_v" = "upstream-ok" ] || { echo "smoke-test: FAIL (verdict on fresh-mtime log: expected upstream-ok, got '$_v')"; exit 1; }
    rm -rf "$_td"
    trap '' EXIT
    echo "smoke-test: ok (verdict classifier dry-run verified: down/ok/empty/stale)"; exit 0
    ;;
  --summary) summarize ;;
  --verdict) verdict ;;
  *) run_probe ;;
esac
