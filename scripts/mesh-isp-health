#!/usr/bin/env bash
# mesh-isp-health — passive upstream-quality monitor.
#
#   mesh-isp-health         run once: ping 1.1.1.1 + 8.8.8.8, append to log
#   mesh-isp-health --summary  read log, report last-1h + last-24h stats
#
# Log: ~/.mesh/isp-health.log (auto-rotated to ~5000 lines).
# Stats: uptime %, blip count, longest blip, avg latency.
set -uo pipefail

LOG="${ISP_HEALTH_LOG:-$HOME/.mesh/isp-health.log}"
MAX_LINES=5000
mkdir -p "$(dirname "$LOG")"
touch "$LOG"

ts() { date -u +%Y-%m-%dT%H:%M:%SZ; }

# --- rotate ------------------------------------------------------------
rotate_log() {
  local lines
  lines=$(wc -l <"$LOG" 2>/dev/null || echo 0)
  if [ "$lines" -gt "$MAX_LINES" ]; then
    tail -n "$MAX_LINES" "$LOG" >"$LOG.tmp" && mv "$LOG.tmp" "$LOG"
  fi
}

# --- probe ---------------------------------------------------------------
run_probe() {
  local tt now t1_lat t2_lat t1_status t2_status avg
  now=$(ts)
  t1_status=FAIL; t2_status=FAIL; avg=-

  if t1_out=$(ping -c 1 -W 3 1.1.1.1 2>/dev/null); then
    t1_lat=$(echo "$t1_out" | awk -F'/' '/^rtt/ {printf "%.1fms", $5}')
    t1_status="OK:${t1_lat:-?}"
  fi
  if t2_out=$(ping -c 1 -W 3 8.8.8.8 2>/dev/null); then
    t2_lat=$(echo "$t2_out" | awk -F'/' '/^rtt/ {printf "%.1fms", $5}')
    t2_status="OK:${t2_lat:-?}"
  fi

  if [ "$t1_status" != FAIL ] || [ "$t2_status" != FAIL ]; then
    if [ "$t1_status" != FAIL ] && [ "$t2_status" != FAIL ]; then
      t1n=$(echo "$t1_lat" | grep -oP '[\d.]+')
      t2n=$(echo "$t2_lat" | grep -oP '[\d.]+')
      avg=$(awk "BEGIN {printf \"%.1fms\", ($t1n+$t2n)/2}")
    elif [ "$t1_status" != FAIL ]; then
      avg="$t1_lat"
    else
      avg="$t2_lat"
    fi
  fi

  printf '%s %s %s avg:%s\n' "$now" "$t1_status" "$t2_status" "$avg" >>"$LOG"
  rotate_log
  echo "$now  $t1_status  $t2_status  avg:$avg"
}

# --- summary --------------------------------------------------------------
summarize() {
  local now cutoff_1h cutoff_24h
  now=$(date -u +%s)
  cutoff_1h=$((now - 3600))
  cutoff_24h=$((now - 86400))

  compute_window() {
    local label="$1" cutoff="$2"
    local total=0 up=0 blips=0 longest_blip=0 cur_blip=0
    local lat_sum=0 lat_cnt=0

    while read -r line; do
      [ -z "$line" ] && continue
      tstr=$(echo "$line" | awk '{print $1}')
      ts_epoch=$(date -d "$tstr" +%s 2>/dev/null) || continue
      [ "$ts_epoch" -ge "$cutoff" ] || continue
      total=$((total + 1))

      t1=$(echo "$line" | awk '{print $2}')
      t2=$(echo "$line" | awk '{print $3}')
      avg_col=$(echo "$line" | awk '{print $4}')

      # extract latency from avg:NN.Nms
      if echo "$avg_col" | grep -q 'ms$'; then
        val=$(echo "$avg_col" | grep -oP '[\d.]+' | head -1)
        if [ -n "$val" ]; then
          lat_sum=$(awk "BEGIN {printf \"%.1f\", $lat_sum+$val}")
          lat_cnt=$((lat_cnt + 1))
        fi
      fi

      if [ "$t1" = FAIL ] && [ "$t2" = FAIL ]; then
        cur_blip=$((cur_blip + 1))
        [ "$cur_blip" -gt "$longest_blip" ] && longest_blip=$cur_blip
      else
        up=$((up + 1))
        [ "$cur_blip" -gt 0 ] && { blips=$((blips + 1)); cur_blip=0; }
      fi
    done < <(tac "$LOG")

    [ "$cur_blip" -gt 0 ] && blips=$((blips + 1))

    local uptime_pct=0 avg_ms=-
    [ "$total" -gt 0 ] && uptime_pct=$(awk "BEGIN {printf \"%.1f\", ($up/$total)*100}")
    [ "$lat_cnt" -gt 0 ] && avg_ms=$(awk "BEGIN {printf \"%.1fms\", $lat_sum/$lat_cnt}")

    echo "  $label"
    echo "    probes: $total"
    echo "    uptime: ${uptime_pct}% (${up}/${total})"
    echo "    blips:  $blips"
    echo "    longest-blip: ${longest_blip} runs"
    echo "    avg-latency: $avg_ms"
    echo
  }

  echo "=== mesh-isp-health summary ($(ts)) ==="
  echo "  targets: 1.1.1.1, 8.8.8.8"
  echo
  compute_window "last-1h:" "$cutoff_1h"
  compute_window "last-24h:" "$cutoff_24h"
}

# --- verdict --------------------------------------------------------------
verdict() {
  local lines both_fail=0 total=0
  local last3
  last3=$(tail -n 3 "$LOG" 2>/dev/null)
  [ -z "$last3" ] && { echo "upstream-ok"; return; }
  while read -r line; do
    [ -z "$line" ] && continue
    total=$((total + 1))
    t1=$(echo "$line" | awk '{print $2}')
    t2=$(echo "$line" | awk '{print $3}')
    [ "$t1" = FAIL ] && [ "$t2" = FAIL ] && both_fail=$((both_fail + 1))
  done <<<"$last3"
  if [ "$total" -ge 1 ] && [ "$both_fail" = "$total" ]; then
    echo "upstream-down"
  else
    echo "upstream-ok"
  fi
}

case "${1:-}" in
  --summary) summarize ;;
  --verdict) verdict ;;
  *) run_probe ;;
esac