#!/usr/bin/env bash
# mesh-note3-uxn-sense — deploy shim for the Note3's termux-free uxn/sysfs sense lane.
#
# The real tool lives WITH its emulator and ROMs at scripts/uxn/mesh-note3-uxn-sense: it
# resolves bin/uxncli, net-echo.rom and sysfs-serve.rom relative to its own directory, so a
# plain `cp` into ~/.local/bin does not deploy it, it BREAKS it — $HERE then points at
# ~/.local/bin where none of those exist and every dial fails as "listener unreachable",
# which is exit 2, which mesh-land passes. That is not hypothetical: ~/.local/bin held a
# 2026-07-24 flat copy of the sibling mesh-note3-uxn-accel and it had been answering a
# permanent, land-green n/a ever since (measured 2026-08-19). Same class mesh-sync-tools:19
# names for mesh-body-gate. This thin exec is the deploy unit.
#
# reflex-cadence: 6-59/10 * * * *
# reflex-args: --keep
set -eu
REPO="${MESH_REPO:-$HOME/lte-workstation}"
TARGET="$REPO/scripts/uxn/mesh-note3-uxn-sense"
[ -x "$TARGET" ] || { echo "mesh-note3-uxn-sense: n/a — no genome checkout at $TARGET (set MESH_REPO)" >&2; exit 2; }
exec "$TARGET" "$@"
