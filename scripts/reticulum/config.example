# Reticulum config — node mesh-home. Flat topology, transport-enabled (routes for the mesh).
# Generic node config lives in genome (scripts/reticulum/config.example); this is the live instance.
[reticulum]
  enable_transport = True
  share_instance = Yes
  shared_instance_port = 37428
  instance_control_port = 37429
  panic_on_interface_error = No

[logging]
  loglevel = 4

[interfaces]
  # LAN mesh discovery over IPv6 link-local multicast on the wifi NIC.
  [[LAN AutoInterface]]
    type = AutoInterface
    interface_enabled = True
    devices = wlxbcec43434a22

  # TCP ingress so peers (or radio-bridge nodes) can reach this transport node.
  [[TCP Server Interface]]
    type = TCPServerInterface
    interface_enabled = True
    listen_ip = 0.0.0.0
    listen_port = 4242
