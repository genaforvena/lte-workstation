#!/usr/bin/env bash
# mesh-rns-linkcheck — software proof that RNS Links work over TCP transport.
# Spins two throwaway Reticulum instances (server TCPServerInterface <-> client
# TCPClientInterface) on loopback, establishes an E2E Link, round-trips a nonce.
# Exit 0 = verified round-trip; 1 = any failure/timeout. --test is the same run.
#
set -euo pipefail
PY="${RNS_PY:-$HOME/.venv-rns/bin/python}"
PROOF="${RNS_PROOF:-$HOME/.local/lib/reticulum/rns-link-proof.py}"
[ -f "$PROOF" ] || PROOF="$HOME/lte-workstation/scripts/reticulum/rns-link-proof.py"
PORT="${RNS_PROOF_PORT:-45420}"

[ -x "$PY" ] || { echo "n/a: no rns venv at $PY"; exit 2; }
[ -f "$PROOF" ] || { echo "n/a: proof script missing"; exit 2; }

WORK="$(mktemp -d /tmp/rns-linkcheck.XXXXXX)"
SRV="$WORK/server"; CLI="$WORK/client"; mkdir -p "$SRV" "$CLI"
HASHF="$WORK/dest.hash"

cat > "$SRV/config" <<EOF
[reticulum]
  enable_transport = True
  share_instance = No
[logging]
  loglevel = 3
[interfaces]
  [[proof-tcp-server]]
    type = TCPServerInterface
    interface_enabled = True
    listen_ip = 127.0.0.1
    listen_port = $PORT
EOF
cat > "$CLI/config" <<EOF
[reticulum]
  enable_transport = False
  share_instance = No
[logging]
  loglevel = 3
[interfaces]
  [[proof-tcp-client]]
    type = TCPClientInterface
    interface_enabled = True
    target_host = 127.0.0.1
    target_port = $PORT
EOF

cleanup() { [ -n "${SRV_PID:-}" ] && kill "$SRV_PID" 2>/dev/null || true; rm -rf "$WORK"; }
trap cleanup EXIT

"$PY" "$PROOF" server --configdir "$SRV" --port "$PORT" --hashfile "$HASHF" >"$WORK/srv.log" 2>&1 &
SRV_PID=$!
for _ in $(seq 1 50); do [ -s "$HASHF" ] && break; sleep 0.2; done
[ -s "$HASHF" ] || { echo "FAIL: server never wrote dest hash"; cat "$WORK/srv.log"; exit 1; }
HASHHEX="$(tail -1 "$HASHF")"

OUT="$("$PY" "$PROOF" client --configdir "$CLI" --hashhex "$HASHHEX" 2>"$WORK/cli.log")" || { echo "$OUT"; tail -5 "$WORK/cli.log"; exit 1; }
echo "$OUT"
case "$OUT" in *"PROOF OK"*) exit 0;; *) exit 1;; esac
