# Reticulum config — OFF-INTERNET two-node link over the local /24 (TCP-over-LAN).
#
# The ONLY interface is a TCP interface bound to / dialing a LAN IP on the same
# subnet. Same-subnet dest is on-link → the kernel sends it straight over L2 to the
# wifi/switch, never via the default gateway. Cut the default route + tailscale and
# the link keeps running. There is deliberately NO TCP-to-internet and NO transport
# interface here: off-internet by construction, provable by reading this file.
#
# share_instance = No is REQUIRED: without it a second RNS on a host already running
# rnsd attaches to that shared instance and inherits ITS interfaces (incl. any
# internet-facing TCPServer) — which would silently defeat the off-internet claim.
#
# SERVER side (the node that binds), e.g. mesh-home 192.168.8.225:
[reticulum]
  enable_transport = No
  share_instance = No
  panic_on_interface_error = No
[logging]
  loglevel = 3
[interfaces]
  [[LAN TCP Server]]
    type = TCPServerInterface
    interface_enabled = True
    listen_ip = 192.168.8.225
    listen_port = 4343

# CLIENT side (the peer that dials), e.g. ilya 192.168.8.242 — use INSTEAD of the
# server block above, on the peer:
#
# [interfaces]
#   [[LAN TCP Client]]
#     type = TCPClientInterface
#     interface_enabled = True
#     target_host = 192.168.8.225
#     target_port = 4343
#
# ---------------------------------------------------------------------------------
# AutoInterface (link-local IPv6 multicast) is the more radio-like transport and the
# intended shape for the RNode/LoRa lane. It needs matching custom ports to coexist
# with a running rnsd (defaults 29716/42671 are already held):
#
#   [[LAN AutoInterface]]
#     type = AutoInterface
#     interface_enabled = True
#     devices = <nic>            # e.g. wlxbcec43434a22 / enp0s3 — pin to exclude tailscale0/wg
#     group_id = meshoffgrid
#     discovery_port = 29816
#     data_port = 42771
#
# NOTE: bridged-VM-over-wifi APs routinely DROP IPv6 link-local multicast, so
# AutoInterface discovery can silently fail there even though both instances init
# clean. TCP-over-LAN above is the reliable software-proof transport; AutoInterface
# is for wired LAN and the eventual RF interfaces.
