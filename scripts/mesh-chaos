#!/usr/bin/env bash
# mesh-chaos — the CHAOS-REFLEX. Deliberately inject a CONSENTED, SCOPED, RECOVERABLE failure, then
# VERIFY recovery — turning resilience from a hope into a measured fact (chaos engineering / Chaos Monkey).
# Antifragility: a system proves its eternity only by exercising failure. See docs/eternity-and-its-fields.md.
#
# STRICT GUARDRAILS:
#   - OPT-IN ONLY: does nothing unless ~/.mesh/chaos.optin lists allowed experiments (class:target/line).
#   - NEVER substrate: refuses anything touching routing/firewall/VPN/exit-node/DNS/sshd/default-route —
#     those can STRAND a node and need operator-present + dead-man, never autonomous chaos.
#   - VERIFY + ALERT: after injecting, confirm recovery within a timeout; if it does NOT recover, ALERT
#     the operator and STOP (never keep breaking).
#   - KILL-SWITCH: ~/.mesh/chaos.pause halts everything. ONE experiment at a time. Smallest blast radius.
#   - LOG every experiment + outcome to ~/.mesh/chaos.log (the resilience artifact).
#
#   mesh-chaos            run one experiment if opted-in
#   mesh-chaos --dry      pick + print what it WOULD do; inject nothing
#   mesh-chaos --report   show recent chaos results
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
# (review #14) make systemctl --user usable from cron (no session bus otherwise -> silent skips)
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=$XDG_RUNTIME_DIR/bus}"
MESH="$HOME/.mesh"; LOG="$MESH/chaos.log"; OPTIN="$MESH/chaos.optin"; PAUSE="$MESH/chaos.pause"
mkdir -p "$MESH"
stamp(){ date -u +%FT%TZ; }
note(){ echo "$(stamp) $*" >> "$LOG"; }
alert(){ command -v mesh-tg >/dev/null 2>&1 && mesh-tg "🧪⚠️ CHAOS on $(hostname): $*" >/dev/null 2>&1; note "ALERT: $*"; }

# HARD guardrail pattern (defense-in-depth ON TOP of the opt-in allowlist): deny any substrate/
# destructive experiment that could strand or destroy a node. Comprehensive — routing, firewall, every
# VPN/overlay, every network manager, DNS, DHCP, ssh, reboot/shutdown. (review #14: was leaky — missed
# vpn/NetworkManager/dhcp/resolv/netplan; now closed.) Shared by the runtime refusal AND --test
# config validation — one pattern, no drift.
is_denied(){
  local low; low=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')
  case "$low" in
    *route*|*firewall*|*iptables*|*nft*|*ufw*|*wireguard*|*wg-*|*openvpn*|*ipsec*|*vpn*|*tailscale*|*overlay*|\
    *exit-node*|*dns*|*resolv*|*dhcp*|*netplan*|*networkmanager*|*network-manager*|*nmcli*|*networkd*|*netctl*|\
    *netmgr*|*iproute*|*ip-link*|*ip-route*|*ip-addr*|*ssh*|*default*|*reboot*|*shutdown*|*poweroff*|*halt*|*dbus*)
      return 0;;
  esac
  return 1
}

# --- HOT / "robust yet fragile" coverage (READ-ONLY, zero injection) -----------------------------
# Carlson & Doyle, "Complexity and robustness", PNAS 2002 (orig. HOT, Phys. Rev. E 1999): systems
# hardened against designed-for failures grow HYPERSENSITIVE to the UNANTICIPATED. mesh-chaos can
# only inject opted-in targets, so every OTHER live component's recovery is merely ASSUMED, never
# measured. This accounts that gap honestly (untested != robust — it's just unknown). Sets globals
# _REFLEXES/_SERVICES/_OPTIN/_COV/_PHANTOM/_TOTAL/_DRILLED/_UNDRILLED/_PCT.
_coverage() {
  local CRON="$HOME/.mesh/reflexes.cron" e k t r s hit
  mapfile -t _REFLEXES < <(grep -vhE '^[[:space:]]*#|^[[:space:]]*$' "$CRON" 2>/dev/null | grep -oE 'mesh-[a-z0-9-]+' | sort -u)
  mapfile -t _SERVICES < <(systemctl --user list-units --type=service --all 2>/dev/null | grep -oE 'mesh-[a-z0-9-]+\.service' | sort -u)
  mapfile -t _OPTIN    < <(grep -vE '^[[:space:]]*#|^[[:space:]]*$' "$OPTIN" 2>/dev/null)
  unset _COV; declare -gA _COV=(); _PHANTOM=()
  for e in "${_OPTIN[@]:-}"; do
    [ -n "$e" ] || continue
    k="${e%%:*}"; t="${e#*:}"; hit=0
    case "$k" in
      service) for s in "${_SERVICES[@]:-}"; do [ "$s" = "$t" ] && { _COV["$s"]=1; hit=1; }; done;;
      reflex)  for r in "${_REFLEXES[@]:-}"; do case "$r" in *"$t"*) _COV["$r"]=1; hit=1;; esac; done;;
    esac
    [ "$hit" = 0 ] && _PHANTOM+=("$e")
  done
  _TOTAL=$(( ${#_REFLEXES[@]} + ${#_SERVICES[@]} )); _DRILLED=${#_COV[@]}
  _UNDRILLED=$(( _TOTAL - _DRILLED )); _PCT=0; [ "$_TOTAL" -gt 0 ] && _PCT=$(( _DRILLED * 100 / _TOTAL ))
}

# --test: deps + opt-in config validation, ZERO injection. Must run BEFORE the pause/opt-in
# early-exits below — those exit 0 silently, which would make a naive --test falsely pass.
if [ "${1:-}" = --test ]; then
  for d in pgrep ps kill grep; do
    command -v "$d" >/dev/null 2>&1 || { echo "smoke-test: FAIL (no $d)"; exit 1; }
  done
  # alert path is part of the safety design: unrecovered chaos MUST reach the operator
  command -v mesh-tg >/dev/null 2>&1 || { echo "smoke-test: FAIL (mesh-tg missing — unrecovered chaos would alert nobody)"; exit 1; }
  # coverage accounting must be sane (read-only; surfaces the HOT robust-yet-fragile gap)
  _coverage
  case "$_TOTAL" in ''|*[!0-9]*) echo "smoke-test: FAIL (coverage _TOTAL not numeric)"; exit 1;; esac
  [ "$_DRILLED" -le "$_TOTAL" ] || { echo "smoke-test: FAIL (coverage drilled $_DRILLED > total $_TOTAL)"; exit 1; }
  if [ -s "$OPTIN" ]; then
    n=0
    while IFS= read -r line; do
      n=$((n+1))
      case "$line" in
        service:?*|reflex:?*) ;;
        *) echo "smoke-test: FAIL (malformed opt-in entry '$line' — want service:<unit>|reflex:<pattern>)"; exit 1;;
      esac
      is_denied "$line" && { echo "smoke-test: FAIL (SUBSTRATE entry '$line' in opt-in — runtime would refuse it; remove it)"; exit 1; }
    done < <(grep -vE '^\s*#|^\s*$' "$OPTIN")
    echo "smoke-test: ok ($n experiment(s) opted-in, all well-formed + non-substrate)"; exit 0
  fi
  echo "smoke-test: ok (dormant — no opt-in, injects nothing)"; exit 0
fi

[ "${1:-}" = --report ] && { echo "=== chaos.log (recent) ==="; tail -n 20 "$LOG" 2>/dev/null; _coverage; echo "=== coverage: $_DRILLED/$_TOTAL components drilled (${_PCT}%); $_UNDRILLED undrilled = recovery ASSUMED, not measured (HOT robust-yet-fragile). see 'mesh-chaos --coverage' ==="; exit 0; }
if [ "${1:-}" = --coverage ]; then
  _coverage
  echo "=== mesh-chaos COVERAGE — resilience MEASURED vs merely ASSUMED ==="
  echo "real surface : ${#_REFLEXES[@]} reflexes + ${#_SERVICES[@]} live services = $_TOTAL components"
  echo "chaos opt-in : ${#_OPTIN[@]} entr(ies) → effectively drilling $_DRILLED live component(s) = ${_PCT}% measured"
  echo "UNDRILLED    : $_UNDRILLED component(s) — recovery ASSUMED, NOT measured."
  echo "               Carlson & Doyle, 'Complexity and robustness', PNAS 2002: hardening designed-for"
  echo "               failures => hypersensitivity to the unanticipated. Untested != robust, just unknown."
  if [ ${#_PHANTOM[@]} -gt 0 ]; then echo "PHANTOM opt-in (no live target → 0 effective coverage):"; printf '  - %s\n' "${_PHANTOM[@]}"; fi
  echo "undrilled sample (recovery unmeasured — candidates to opt-in for a real recovery drill):"
  { for r in "${_REFLEXES[@]:-}"; do [ -n "$r" ] && [ -z "${_COV[$r]:-}" ] && echo "  reflex:$r"; done
    for s in "${_SERVICES[@]:-}"; do [ -n "$s" ] && [ -z "${_COV[$s]:-}" ] && echo "  service:$s"; done; } | head -12
  exit 0
fi
[ -f "$PAUSE" ] && { note "paused (kill-switch present)"; exit 0; }
[ -s "$OPTIN" ] || { note "no opt-in (~/.mesh/chaos.optin empty/absent) — nothing to do"; exit 0; }
DRY=0; [ "${1:-}" = --dry ] && DRY=1

mapfile -t EXPS < <(grep -vE '^\s*#|^\s*$' "$OPTIN")
[ ${#EXPS[@]} -eq 0 ] && { note "opt-in present but no experiments listed"; exit 0; }
# rotate deterministically (no RNG dependency): pick by wall-clock minute
idx=$(( $(date +%s) / 60 % ${#EXPS[@]} ))
exp="${EXPS[$idx]}"; class="${exp%%:*}"; target="${exp#*:}"

# HARD guardrail: shared deny pattern (see is_denied above the --test block).
if is_denied "$exp"; then
  alert "refused substrate/destructive experiment '$exp' (can strand or destroy a node)"; exit 1
fi

# review #14: recovery FAILED must STOP all future runs (cron must not keep re-breaking an unrecovered
# target). Set the kill-switch + alert. A human clears ~/.mesh/chaos.pause after looking.
fail_stop(){ : > "$PAUSE"; alert "$* — AUTO-PAUSED ($PAUSE set; rm it to resume after a human checks)"; }

case "$class" in
  service)  # SIGTERM the service's main pid; verify systemd brings it back. --user scope ONLY (cannot
    # touch system/root units — limits blast radius). No eval (review #14: injection-safe, quoted target).
    systemctl --user cat "$target" >/dev/null 2>&1 || { note "service $target not found (user scope) — skip"; exit 0; }
    pid=$(systemctl --user show -p MainPID --value "$target" 2>/dev/null)
    [ "${pid:-0}" -gt 0 ] || { note "service $target not running — skip"; exit 0; }
    if [ "$DRY" = 1 ]; then echo "WOULD SIGTERM service $target (pid $pid) and verify systemd auto-restart"; exit 0; fi
    note "EXPERIMENT service:$target — SIGTERM main pid $pid"
    kill -TERM "$pid" 2>/dev/null
    recovered=0; np=""
    for i in $(seq 1 15); do sleep 2
      np=$(systemctl --user show -p MainPID --value "$target" 2>/dev/null)
      if [ "${np:-0}" -gt 0 ] && [ "$np" != "$pid" ]; then recovered=1; break; fi
    done
    if [ "$recovered" = 1 ]; then note "RECOVERED service:$target (new pid $np) — self-heal CONFIRMED ✅"
    else fail_stop "service:$target did NOT auto-restart (add Restart= to the unit) — RESILIENCE GAP"; fi
    ;;
  reflex)  # SIGTERM a named loop; verify a NEW pid returns. Require an UNAMBIGUOUS single match among
    # THIS user's processes (review #14: no substring collateral, own processes only).
    mapfile -t pids < <(pgrep -u "$(id -u)" -f -- "$target" 2>/dev/null)
    [ ${#pids[@]} -eq 0 ] && { note "reflex '$target' not running — skip"; exit 0; }
    [ ${#pids[@]} -gt 1 ] && { alert "reflex:'$target' matches ${#pids[@]} processes — AMBIGUOUS, refusing (make the pattern exact)"; exit 1; }
    pid="${pids[0]}"; cmd=$(ps -o args= -p "$pid" 2>/dev/null | head -c 100)
    if [ "$DRY" = 1 ]; then echo "WOULD SIGTERM reflex '$target' (pid $pid: $cmd) and verify it returns"; exit 0; fi
    note "EXPERIMENT reflex:$target — SIGTERM pid $pid ($cmd)"
    kill -TERM "$pid" 2>/dev/null
    recovered=0
    for i in $(seq 1 15); do sleep 2
      npid=$(pgrep -u "$(id -u)" -f -- "$target" 2>/dev/null | head -1)
      [ -n "$npid" ] && [ "$npid" != "$pid" ] && { recovered=1; break; }
    done
    if [ "$recovered" = 1 ]; then note "RECOVERED reflex:$target (new pid $npid) ✅"
    else fail_stop "reflex:$target did NOT auto-restart — RESILIENCE GAP (no supervisor)"; fi
    ;;
  *) note "unknown experiment class '$class' (want service:|reflex:) — skip"; exit 0;;
esac
