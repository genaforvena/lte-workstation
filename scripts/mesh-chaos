#!/usr/bin/env bash
# mesh-chaos — the CHAOS-REFLEX. Deliberately inject a CONSENTED, SCOPED, RECOVERABLE failure, then
# VERIFY recovery — turning resilience from a hope into a measured fact (chaos engineering / Chaos Monkey).
# Antifragility: a system proves its eternity only by exercising failure. See docs/eternity-and-its-fields.md.
#
# STRICT GUARDRAILS:
#   - OPT-IN ONLY: does nothing unless ~/.mesh/chaos.optin lists allowed experiments (class:target/line).
#   - NEVER substrate: refuses anything touching routing/firewall/VPN/exit-node/DNS/sshd/default-route —
#     those can STRAND a node and need operator-present + dead-man, never autonomous chaos.
#   - VERIFY + ALERT: after injecting, confirm recovery within a timeout; if it does NOT recover, ALERT
#     the operator and STOP (never keep breaking).
#   - KILL-SWITCH: ~/.mesh/chaos.pause halts everything. ONE experiment at a time. Smallest blast radius.
#   - LOG every experiment + outcome to ~/.mesh/chaos.log (the resilience artifact).
#
#   mesh-chaos            run one experiment if opted-in
#   mesh-chaos --dry      pick + print what it WOULD do; inject nothing
#   mesh-chaos --report   show recent chaos results
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
# (review #14) make systemctl --user usable from cron (no session bus otherwise -> silent skips)
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=$XDG_RUNTIME_DIR/bus}"
MESH="$HOME/.mesh"; LOG="$MESH/chaos.log"; OPTIN="$MESH/chaos.optin"; PAUSE="$MESH/chaos.pause"
mkdir -p "$MESH"
stamp(){ date -u +%FT%TZ; }
note(){ echo "$(stamp) $*" >> "$LOG"; }
alert(){ command -v mesh-tg >/dev/null 2>&1 && mesh-tg "🧪⚠️ CHAOS on $(hostname): $*" >/dev/null 2>&1; note "ALERT: $*"; }

# HARD guardrail pattern (defense-in-depth ON TOP of the opt-in allowlist): deny any substrate/
# destructive experiment that could strand or destroy a node. Comprehensive — routing, firewall, every
# VPN/overlay, every network manager, DNS, DHCP, ssh, reboot/shutdown. (review #14: was leaky — missed
# vpn/NetworkManager/dhcp/resolv/netplan; now closed.) Shared by the runtime refusal AND --test
# config validation — one pattern, no drift.
is_denied(){
  local low; low=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')
  case "$low" in
    *route*|*firewall*|*iptables*|*nft*|*ufw*|*wireguard*|*wg-*|*openvpn*|*ipsec*|*vpn*|*tailscale*|*overlay*|\
    *exit-node*|*dns*|*resolv*|*dhcp*|*netplan*|*networkmanager*|*network-manager*|*nmcli*|*networkd*|*netctl*|\
    *netmgr*|*iproute*|*ip-link*|*ip-route*|*ip-addr*|*ssh*|*default*|*reboot*|*shutdown*|*poweroff*|*halt*|*dbus*)
      return 0;;
  esac
  return 1
}

# --- COGNITIVE DOMAIN = the PARTITION of the perturbation space (Beer; Maturana & Varela) --------
# LITERATURE (autopoiesis & biology of cognition — a concrete METRIC the area uses to measure itself):
# Randall Beer, "The Cognitive Domain of a Glider in the Game of Life" (Artificial Life 20(2), 2014)
# + "Characterizing Autopoiesis in the Game of Life" (Artificial Life 26, 2020), operationalizing
# Maturana & Varela's biology of cognition on a concrete self-maintaining pattern. THE EXPERIMENT/METRIC:
# take a self-producing system (the glider), ENUMERATE the space of possible perturbations to it, and
# PARTITION that space into DESTRUCTIVE (the system loses its organization/identity) vs NON-DESTRUCTIVE
# (it absorbs the perturbation and conserves its autopoietic organization). The non-destructive set —
# and the recovery structure within it — IS the operational measure: the system's "cognitive domain" =
# the precise BOUNDARY of environmental interactions it can undergo while remaining itself. The measure
# is the PARTITION/BOUNDARY, not a tally of survivals.
#   GAP HERE: mesh-chaos records each experiment's outcome as an INDEPENDENT pass/fail in chaos.log
#   (RECOVERED / not — a list of points), and --coverage reports a breadth fraction. It never assembles
#   those samples into the destructive↔non-destructive PARTITION — the boundary of the mesh's identity-
#   preserving domain. "All recovered = resilient" conflates "we stayed safely inside the domain" with
#   "we measured the domain"; the domain itself (where recovery STOPS, at what intensity/composition the
#   mesh's organization would not survive) is never the artifact.
#   HONEST MIRROR (principled, not a bug): Beer's full measure REQUIRES finding destructive perturbations
#   to locate the boundary — but this tool's guardrails FORBID executing identity-destroying / substrate
#   perturbations by design (never strand a node). So the mesh can only ever measure a LOWER BOUND on its
#   cognitive domain (confirmed-non-destructive set); the true boundary stays deliberately un-probed.
#   That limit should be NAMED in the artifact, not hidden behind a green "resilient".
#   DISTINCT from the two held blocks already on this file AND from prior autopoiesis reviews:
#     • NOT HOT/undrilled-coverage (below) — that is BREADTH (which components got injected at all);
#       cognitive domain is the SHAPE of the partition for the perturbations we DO inject (where the
#       boundary sits), an orthogonal axis to "did we drill component X".
#     • NOT the correlated-failure tier (further below) — that is DEPTH/convexity (do N simultaneous
#       faults recover jointly); cognitive domain is the destructive↔non-destructive boundary itself,
#       single- or multi-fault.
#     • NOT operational-closure (review-autopoiesis-operational-closure-2026-06-21) — that measures the
#       INTERNAL organization (each constraint produces another, closed loop); this measures the EXTERNAL
#       perturbation domain the organization survives. NOT structural-coupling/anticipation
#       (autopoiesis-structural-coupling-anticipation-gap) — that is the coupling/anticipation dynamic;
#       this is the measured viability-preserving partition. NOT graded-viability (mesh-body-power, one
#       variable's graded distance) NOR ultrastability/trials-to-stable-field (mesh-homeostasis, count of
#       reconfigurations to re-equilibrate) — both are different quantities than the perturbation-space
#       partition that defines the cognitive domain.
#   HELD fix (instrument-first, steward/operator-gated): account chaos.log AS A PARTITION — the confirmed
#   non-destructive set (with intensity/composition where known) vs the deliberately-UNMEASURED destructive
#   boundary (forbidden by guardrails) — and report the mesh's cognitive domain as an explicit LOWER BOUND,
#   never "all recovered = resilient". WHY HELD: the only honest extension is bookkeeping over EXISTING
#   safe outcomes; reaching the actual boundary would require destructive/substrate perturbations the
#   guardrails exist to forbid (self-cut/strand risk) — so the boundary-probing half is NOT a candidate,
#   only the lower-bound partition artifact is. Not shipped (comment-only; 0 behavior change).
#
# --- LOST-NODE / PARTITION: the canonical chaos experiment is forbidden here — drill its RESPONSE, not its CAUSE ---
# TASK-GROUNDED (STUDY byzantine-consensus, 2026-06-22): "simulate a lost node by disconnecting a subset
# of nodes for a duration." Node-loss / network-partition is THE founding chaos experiment — Chaos Monkey
# began by KILLING instances; Jepsen/Byzantine testing PARTITIONS the network to see whether the system
# stays correct (or silently lies) while a node is unreachable. Yet it is the ONE fault class these
# guardrails categorically REFUSE (:8,:39 — *ssh*/*ip-*/*default*/routing): actually disconnecting a node
# STRANDS it and severs the SSH path the mesh is reached through. So node-loss is verified ONLY by REAL
# incidents (ds hardware freezes, the phone going offline) — never by a CONTROLLED, recoverable drill.
# That is a genuine coverage hole, but the literal fix (inject a partition) is correctly forbidden.
#   THE SAFE REFRAME (the Byzantine-honesty half is drillable WITHOUT touching substrate): a "lost node"
#   harms the mesh in two stages — (1) the node stops doing its work, and (2) the mesh's FUSION must
#   NOTICE and degrade HONESTLY (render that node UNKNOWN/partial, never a stale cached all-clear).
#   Stage 2 IS the Byzantine question — "does the system tell the truth when a participant goes silent?" —
#   and it is testable at the OBSERVABILITY layer with ZERO substrate touch: simulate silence by
#   WITHHOLDING a node's heartbeat/freshness for a bounded window (a freshness-clock fault, the benign
#   class mesh-chaos already handles) and assert the fusion/health tools flip that node to UNKNOWN, not
#   "Online". This is exactly the false-all-clear that bit us once — TS Online held True on a FROZEN ds
#   ([[liveness-is-lease-not-cached-status]]) — i.e. the mesh already FAILED an unrun lost-node drill in
#   production. The honest-fusion invariant ([[fusion-tools-distinguish-empty-from-failed]]) is precisely
#   what such a drill would verify, turning a past incident into a repeatable regression check.
#   DISTINCT from the cognitive-domain block above (that bookkeeps the partition of OUTCOMES and declares
#   the substrate boundary un-probeable in general; THIS names ONE specific forbidden fault — node-loss —
#   whose RESPONSE is safely drillable via a freshness proxy even though its CAUSE stays forbidden), from
#   HOT-coverage (breadth of injected components), correlated-failure (multi-fault depth), and
#   fragility-transfer (bystander displacement).
#   HELD fix (instrument-first, steward/operator-gated): add a NON-substrate "silent-node" experiment class
#   — withhold a chosen node's freshness for a bounded window, then VERIFY the fusion tools (mesh-situation/
#   mesh-health/mesh-presence-fuse) render it UNKNOWN within the recovery timeout and ALERT if any keep
#   reporting it healthy (a stale-cache liveness bug). Never cuts the network; reuses the existing opt-in +
#   verify + kill-switch frame. NOT shipped here (comment-only; 0 behavior change) — wiring a new
#   experiment class + its verifier is behavioral, steward/operator-gated.
#
# --- HOT / "robust yet fragile" coverage (READ-ONLY, zero injection) -----------------------------
# Carlson & Doyle, "Complexity and robustness", PNAS 2002 (orig. HOT, Phys. Rev. E 1999): systems
# hardened against designed-for failures grow HYPERSENSITIVE to the UNANTICIPATED. mesh-chaos can
# only inject opted-in targets, so every OTHER live component's recovery is merely ASSUMED, never
# measured. This accounts that gap honestly (untested != robust — it's just unknown). Sets globals
# _REFLEXES/_SERVICES/_OPTIN/_COV/_PHANTOM/_TOTAL/_DRILLED/_UNDRILLED/_PCT.
#
# ── FRAGILITY TRANSFER — the critique of antifragility this reflex cannot see (Taleb, "Antifragile",
# 2012, the ETHICS-of-fragility-transfer chapter: "the antifragility of some comes at the expense of the
# fragility of others"; antifragility, convexity & ruin theory, read-only). The well-cited CRITIQUE of
# the antifragility program: a subsystem's antifragility/robustness measured IN ISOLATION is not a
# system property — gain-from-disorder is frequently PURCHASED by EXPORTING the harm to a COUPLED
# subsystem that absorbs it (Taleb's bankers-gain / taxpayers-absorb; the academic critique that
# component-level convexity ignores system-level fragility displacement). mesh-chaos verifies that the
# DRILLED component recovers (single SIGTERM → that pid returns) and accounts the UNDRILLED ones honestly
# above (HOT). But BOTH axes are about the INJECTED target. NEITHER measures whether the drill's RECOVERY
# DISPLACED fragility onto a NON-injected bystander: a recovery mechanism that retries aggressively, fails
# over by doubling load, or restarts into a thundering-herd hammers a SHARED dependency (the
# .ideas-queue.lock / .chat.lock, the mesh-relay pool, a peer over SSH, the shared CPU/thermal budget) —
# so component X passes every drill (locally robust) while its recovery makes coupled component Y fragile.
# The mesh would then read "100% drilled, all recovered = antifragile" while the fragility was merely
# RELOCATED, not removed — the exact failure Taleb names. DISTINCT from the neighbouring reviews:
# NOT HOT/undrilled-coverage (above — UNANTICIPATED failure TYPES on the injected axis); NOT
# non-ergodicity/repeated-shed ruin (TEMPORAL — one trajectory ruined over many trials); NOT
# dose-fractionation/concentration (the SCHEDULE/magnitude of stress on ONE component); NOT the
# correlated-failure held tier below (many faults IN → joint recovery). Fragility transfer is one fault
# IN → harm OUT, to a coupled bystander, during a NORMAL single drill. HELD (instrument-first,
# behavioral — NOT shipped): during a drill, SAMPLE a small set of shared-dependency health probes
# (lock-wait depth, relay queue latency, peer reachability, load/temp) BEFORE vs DURING the injected
# component's recovery, and flag a drill that recovered the target while degrading a bystander beyond a
# band — "recovered, but displaced fragility to <Y>." Held because the bystander probe-set must be curated
# (which shared deps a given target's recovery can touch) and validated to avoid false displacement
# alarms from unrelated concurrent load; instrument-before-actuator. Source:
# ~/.mesh/knowledge/review-fragility-transfer-coupled-bystander-mesh-chaos-2026-06-21.md
_coverage() {
  local CRON="$HOME/.mesh/reflexes.cron" e k t r s hit
  mapfile -t _REFLEXES < <(grep -vhE '^[[:space:]]*#|^[[:space:]]*$' "$CRON" 2>/dev/null | grep -oE 'mesh-[a-z0-9-]+' | sort -u)
  mapfile -t _SERVICES < <(systemctl --user list-units --type=service --all 2>/dev/null | grep -oE 'mesh-[a-z0-9-]+\.service' | sort -u)
  mapfile -t _OPTIN    < <(grep -vE '^[[:space:]]*#|^[[:space:]]*$' "$OPTIN" 2>/dev/null)
  unset _COV; declare -gA _COV=(); _PHANTOM=()
  for e in "${_OPTIN[@]:-}"; do
    [ -n "$e" ] || continue
    k="${e%%:*}"; t="${e#*:}"; hit=0
    case "$k" in
      service) for s in "${_SERVICES[@]:-}"; do [ "$s" = "$t" ] && { _COV["$s"]=1; hit=1; }; done;;
      reflex)  for r in "${_REFLEXES[@]:-}"; do case "$r" in *"$t"*) _COV["$r"]=1; hit=1;; esac; done;;
    esac
    [ "$hit" = 0 ] && _PHANTOM+=("$e")
  done
  _TOTAL=$(( ${#_REFLEXES[@]} + ${#_SERVICES[@]} )); _DRILLED=${#_COV[@]}
  _UNDRILLED=$(( _TOTAL - _DRILLED )); _PCT=0; [ "$_TOTAL" -gt 0 ] && _PCT=$(( _DRILLED * 100 / _TOTAL ))
}

# --test: deps + opt-in config validation, ZERO injection. Must run BEFORE the pause/opt-in
# early-exits below — those exit 0 silently, which would make a naive --test falsely pass.
if [ "${1:-}" = --test ]; then
  for d in pgrep ps kill grep; do
    command -v "$d" >/dev/null 2>&1 || { echo "smoke-test: FAIL (no $d)"; exit 1; }
  done
  # alert path is part of the safety design: unrecovered chaos MUST reach the operator
  command -v mesh-tg >/dev/null 2>&1 || { echo "smoke-test: FAIL (mesh-tg missing — unrecovered chaos would alert nobody)"; exit 1; }
  # coverage accounting must be sane (read-only; surfaces the HOT robust-yet-fragile gap)
  _coverage
  case "$_TOTAL" in ''|*[!0-9]*) echo "smoke-test: FAIL (coverage _TOTAL not numeric)"; exit 1;; esac
  [ "$_DRILLED" -le "$_TOTAL" ] || { echo "smoke-test: FAIL (coverage drilled $_DRILLED > total $_TOTAL)"; exit 1; }
  # background-rate gate logic (STUDY chaos-engineering): percent-parse + boundary, deterministic (no RNG flake)
  rt="1%"; rt="${rt//[!0-9]/}"; [ "$rt" = 1 ] || { echo "smoke-test: FAIL (rate parse '1%'->'$rt' != 1)"; exit 1; }
  # roll is 1..100; SKIP iff roll > rate. rate=100 never skips (min roll 1 ≯ 100); rate=1 skips a roll of 2.
  [ 1 -gt 100 ] && { echo "smoke-test: FAIL (rate=100 would wrongly skip)"; exit 1; }
  [ 2 -gt 1 ]   || { echo "smoke-test: FAIL (rate=1 should skip a roll of 2)"; exit 1; }
  if [ -s "$OPTIN" ]; then
    n=0
    while IFS= read -r line; do
      n=$((n+1))
      case "$line" in
        service:?*|reflex:?*) ;;
        *) echo "smoke-test: FAIL (malformed opt-in entry '$line' — want service:<unit>|reflex:<pattern>)"; exit 1;;
      esac
      is_denied "$line" && { echo "smoke-test: FAIL (SUBSTRATE entry '$line' in opt-in — runtime would refuse it; remove it)"; exit 1; }
    done < <(grep -vE '^\s*#|^\s*$' "$OPTIN")
    echo "smoke-test: ok ($n experiment(s) opted-in, all well-formed + non-substrate)"; exit 0
  fi
  echo "smoke-test: ok (dormant — no opt-in, injects nothing)"; exit 0
fi

[ "${1:-}" = --report ] && { echo "=== chaos.log (recent) ==="; tail -n 20 "$LOG" 2>/dev/null; _coverage; echo "=== coverage: $_DRILLED/$_TOTAL components drilled (${_PCT}%); $_UNDRILLED undrilled = recovery ASSUMED, not measured (HOT robust-yet-fragile). see 'mesh-chaos --coverage' ==="; exit 0; }
if [ "${1:-}" = --coverage ]; then
  _coverage
  echo "=== mesh-chaos COVERAGE — resilience MEASURED vs merely ASSUMED ==="
  echo "real surface : ${#_REFLEXES[@]} reflexes + ${#_SERVICES[@]} live services = $_TOTAL components"
  echo "chaos opt-in : ${#_OPTIN[@]} entr(ies) → effectively drilling $_DRILLED live component(s) = ${_PCT}% measured"
  echo "UNDRILLED    : $_UNDRILLED component(s) — recovery ASSUMED, NOT measured."
  echo "               Carlson & Doyle, 'Complexity and robustness', PNAS 2002: hardening designed-for"
  echo "               failures => hypersensitivity to the unanticipated. Untested != robust, just unknown."
  if [ ${#_PHANTOM[@]} -gt 0 ]; then echo "PHANTOM opt-in (no live target → 0 effective coverage):"; printf '  - %s\n' "${_PHANTOM[@]}"; fi
  echo "undrilled sample (recovery unmeasured — candidates to opt-in for a real recovery drill):"
  { for r in "${_REFLEXES[@]:-}"; do [ -n "$r" ] && [ -z "${_COV[$r]:-}" ] && echo "  reflex:$r"; done
    for s in "${_SERVICES[@]:-}"; do [ -n "$s" ] && [ -z "${_COV[$s]:-}" ] && echo "  service:$s"; done; } | head -12
  exit 0
fi
[ -f "$PAUSE" ] && { note "paused (kill-switch present)"; exit 0; }
[ -s "$OPTIN" ] || { note "no opt-in (~/.mesh/chaos.optin empty/absent) — nothing to do"; exit 0; }
DRY=0; [ "${1:-}" = --dry ] && DRY=1

# ── BACKGROUND FAILURE RATE (Chaos-Monkey "p% per period"; STUDY chaos-engineering brief 2026-06-11) ──
# By default mesh-chaos fires DETERMINISTICALLY every opted-in run (the wall-clock-minute rotation
# below). A realistic fault model is STOCHASTIC: failures arrive at a low BACKGROUND RATE — most periods
# nothing happens (Netflix's Chaos Monkey injects with a probability PER scheduling window, not every
# tick; cf. Principles of Chaos Engineering, principlesofchaos.org). Opt-in rate gate:
# ~/.mesh/chaos.rate (or $CHAOS_RATE) = an integer PERCENT 0..100. UNSET/0 = today's behavior EXACTLY
# (always proceed → fully backward-compatible, zero change for current users). >0 = roll ONCE per run,
# proceed only with that probability, else log a no-op and exit 0. This can ONLY REDUCE injection
# frequency — the gate sits BEFORE the pick/inject, so it never raises blast radius or touches the
# guardrails (is_denied + opt-in allowlist + verify-recovery still gate every actual fire). --dry
# always previews (bypasses the gate) so the armed experiment stays inspectable. This realizes the
# "1% failure rate" study in OUR mesh: set chaos.rate=1 + an opt-in entry and a cron tick → on average
# 1-in-100 ticks injects one scoped, recoverable, verified failure; most ticks are silent no-ops.
rate="${CHAOS_RATE:-$(cat "$MESH/chaos.rate" 2>/dev/null)}"; rate="${rate//[!0-9]/}"
if [ "$DRY" -eq 0 ] && [ -n "$rate" ] && [ "$rate" -gt 0 ] 2>/dev/null; then
  [ "$rate" -gt 100 ] && rate=100
  roll=$(( (RANDOM % 100) + 1 ))   # 1..100
  if [ "$roll" -gt "$rate" ]; then
    note "rate-gate: skip this period (roll=$roll > rate=${rate}% background failure rate)"; exit 0
  fi
  note "rate-gate: FIRE this period (roll=$roll <= rate=${rate}%)"
fi

# DOSE-CONCENTRATION GAP (Taleb et al., "Working With Convex Responses: Antifragility from Finance
# to Oncology", arXiv:2209.14631, 2022 / pub. 2023 — the RECENT, prescriptive extension of the
# fragility/convexity program): the optimal SCHEDULE of a repeated stressor follows the convexity
# SIGN of the response. For a CONCAVE/fragile response → FRACTIONATE (many small doses, minimize
# variance); for a CONVEX/ANTIFRAGILE response → CONCENTRATE (few LARGE doses) — because a convex
# response is only EXERCISED above a threshold (hormesis): a stream of tiny shocks stays in the
# linear regime and builds/verifies nothing about the nonlinear one. This is DISTINCT from the
# detection angle already embodied (review-antifragility-convexity-detection-gap: measuring whether
# HARM accelerates with magnitude) — this is the DOSING schedule that follows once the response is
# known convex.
# Where it bites HERE: mesh-chaos is the maximally-FRACTIONATED extreme by design — "smallest blast
# radius, ONE experiment at a time" (header), and each experiment is a SINGLE pid (one service/reflex
# SIGTERM, verify that one pid returns). That is correct for SAFETY (don't strand a node). But it
# means the resilience it builds+verifies is only against SINGLE-component, small shocks — while the
# real mesh failures are CONCENTRATED/CORRELATED and large: a node FREEZE drops ALL that node's
# reflexes at once ([[ds-hardware-freeze-and-node-care]]); a thermal spike SHEDS MANY minds
# simultaneously ([[autonomous-dev-thermal-shed-diagnosis]]); an OOM takes several processes together.
# If recovery-capacity is convex in the number of SIMULTANEOUS failures (cascades, restart thundering-
# herd, contention during concurrent recovery — non-additive), single-pid drills verify the linear
# regime and leave the regime where the actual risk lives UNTESTED. The file's own HOT/Carlson-Doyle
# note already says "untested != robust"; this adds that even the TESTED components are tested only
# SINGLY, never in concentrated combination.
# HELD FIX (steward lands — behavioral, and gated HARDER than the default): an escalating-magnitude /
# CORRELATED-failure drill tier — e.g. a multi-target experiment class that fails N opted-in
# components at once and verifies joint recovery — but ONLY under stricter consent + operator-present
# + mesh-dms dead-man (a concentrated dose can strand where a single one cannot), NEVER a loosening of
# the default single-pid safety. Held because (a) it raises blast radius onto the substrate-adjacent
# danger zone the guardrails exist to keep small, and (b) instrument-first: confirm recovery-capacity
# is actually threshold/convex (correlated failures recover WORSE than the sum of singles) before
# concentrating the dose — else fractionated single-pid drilling is already optimal and the tier adds
# only risk. See [[honest-pushback-not-yesman]], docs/eternity-and-its-fields.md.
mapfile -t EXPS < <(grep -vE '^\s*#|^\s*$' "$OPTIN")
[ ${#EXPS[@]} -eq 0 ] && { note "opt-in present but no experiments listed"; exit 0; }
# rotate deterministically (no RNG dependency): pick by wall-clock minute
idx=$(( $(date +%s) / 60 % ${#EXPS[@]} ))
exp="${EXPS[$idx]}"; class="${exp%%:*}"; target="${exp#*:}"

# HARD guardrail: shared deny pattern (see is_denied above the --test block).
if is_denied "$exp"; then
  alert "refused substrate/destructive experiment '$exp' (can strand or destroy a node)"; exit 1
fi

# review #14: recovery FAILED must STOP all future runs (cron must not keep re-breaking an unrecovered
# target). Set the kill-switch + alert. A human clears ~/.mesh/chaos.pause after looking.
fail_stop(){ : > "$PAUSE"; alert "$* — AUTO-PAUSED ($PAUSE set; rm it to resume after a human checks)"; }

case "$class" in
  service)  # SIGTERM the service's main pid; verify systemd brings it back. --user scope ONLY (cannot
    # touch system/root units — limits blast radius). No eval (review #14: injection-safe, quoted target).
    systemctl --user cat "$target" >/dev/null 2>&1 || { note "service $target not found (user scope) — skip"; exit 0; }
    pid=$(systemctl --user show -p MainPID --value "$target" 2>/dev/null)
    [ "${pid:-0}" -gt 0 ] || { note "service $target not running — skip"; exit 0; }
    if [ "$DRY" = 1 ]; then echo "WOULD SIGTERM service $target (pid $pid) and verify systemd auto-restart"; exit 0; fi
    note "EXPERIMENT service:$target — SIGTERM main pid $pid"
    kill -TERM "$pid" 2>/dev/null
    recovered=0; np=""
    for i in $(seq 1 15); do sleep 2
      np=$(systemctl --user show -p MainPID --value "$target" 2>/dev/null)
      if [ "${np:-0}" -gt 0 ] && [ "$np" != "$pid" ]; then recovered=1; break; fi
    done
    if [ "$recovered" = 1 ]; then note "RECOVERED service:$target (new pid $np) — self-heal CONFIRMED ✅"
    else fail_stop "service:$target did NOT auto-restart (add Restart= to the unit) — RESILIENCE GAP"; fi
    ;;
  reflex)  # SIGTERM a named loop; verify a NEW pid returns. Require an UNAMBIGUOUS single match among
    # THIS user's processes (review #14: no substring collateral, own processes only).
    mapfile -t pids < <(pgrep -u "$(id -u)" -f -- "$target" 2>/dev/null)
    [ ${#pids[@]} -eq 0 ] && { note "reflex '$target' not running — skip"; exit 0; }
    [ ${#pids[@]} -gt 1 ] && { alert "reflex:'$target' matches ${#pids[@]} processes — AMBIGUOUS, refusing (make the pattern exact)"; exit 1; }
    pid="${pids[0]}"; cmd=$(ps -o args= -p "$pid" 2>/dev/null | head -c 100)
    if [ "$DRY" = 1 ]; then echo "WOULD SIGTERM reflex '$target' (pid $pid: $cmd) and verify it returns"; exit 0; fi
    note "EXPERIMENT reflex:$target — SIGTERM pid $pid ($cmd)"
    kill -TERM "$pid" 2>/dev/null
    recovered=0
    for i in $(seq 1 15); do sleep 2
      npid=$(pgrep -u "$(id -u)" -f -- "$target" 2>/dev/null | head -1)
      [ -n "$npid" ] && [ "$npid" != "$pid" ] && { recovered=1; break; }
    done
    if [ "$recovered" = 1 ]; then note "RECOVERED reflex:$target (new pid $npid) ✅"
    else fail_stop "reflex:$target did NOT auto-restart — RESILIENCE GAP (no supervisor)"; fi
    ;;
  *) note "unknown experiment class '$class' (want service:|reflex:) — skip"; exit 0;;
esac
