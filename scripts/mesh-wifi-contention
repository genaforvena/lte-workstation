#!/usr/bin/env bash
# orphan-ok: on-demand STA-side RF-contention read (iw station dump tx-retry Δ + ethtool -S rx-duplicate Δ + MCS; node-bound wifi STA, pulled on demand / by a fusion consumer like mesh-airtime / mesh-wifi-congestion)
# mesh-wifi-contention — STA-side RF contention read from OUR OWN link, not the neighborhood.
#
# TWO INDEPENDENT AXES, because on some radios one of them is DEAD:
#
#   TX axis — `iw dev <iface> station dump`: Δtx_retries / Δtx_packets. The standard STA-side
#             contention metric; rises with congestion even when signal (dBm) holds steady.
#   RX axis — `ethtool -S <iface>`: Δrx_duplicates / Δrx_packets. The mirror: a duplicate means
#             the AP retransmitted a frame we already had, i.e. the AP is not hearing our ACKs.
#             Privilege-free, scan-free, monotonic accumulators. No mesh script read this before.
#   plus     beacon loss (hard-fault override) and tx/rx MCS (link adaptation).
#
# **THE TX AXIS IS A HARDWARE CONSTANT ON SOME DRIVERS AND MUST NOT BE FOLDED INTO A VERDICT.**
# rtw88 (mesh-home's SOLE uplink, RTL8822BU 0bda:b82c) NEVER fills tx_retries — 0 across 716k
# lifetime tx packets, in `ethtool -S` AND `iw station dump` at the same instant, while
# tx_retry_failed sits at 6. So Δretries/Δpkts is structurally 0: this tool used to render CLEAR
# on EVERY window, CONTENDED was unreachable, and the only path to CONGESTED was the beacon-loss
# override — on a link simultaneously running rx duplicates and climbing beacon loss.
# A constant is not a reading. When lifetime tx_packets >= TX_PIN_MIN and lifetime tx_retries is
# still 0, the axis is declared PINNED and renders `n/a`, never CLEAR. It un-pins the instant one
# real retry is counted. (doctrine: "a constant outlives its reader".)
#
# **rx_dropped IS NOT LOSS — read it ONLY as the pair with rx_duplicates.** On rtw88 the two move
# by the SAME delta with a constant lifetime gap of 3 (19301 vs 19298), and rx_dropped equals
# `iw station dump`'s `rx drop misc` exactly at the same instant. ~100% of "dropped" IS the dedup —
# the receiver working correctly. A drop-rate alarm on either name alone would sit permanently at
# the duplicate rate and mean nothing about loss. This tool reports the pair and its agreement.
#
# **noise / ch_time* ARE u64(-1) = 18446744073709551615 ON THIS CHIP, NOT NUMBERS.** rtw88
# implements none of the survey/airtime fields. Absolutely they render 1.8e19; DELTA'D THEY ARE
# EXACTLY 0, which reads as a perfectly idle channel — a fabricated calm from a field that never
# had a value. They are string-compared against U64_MAX and rejected as UNSUPPORTED BEFORE any
# arithmetic. (`iw dev <if> survey dump` is empty rc=0 here too: no airtime axis by any path.)
#
# **BOTH signal reads go unset on this chip** — rtw88 renders `iw`'s as a flat `0 [0, 0] dBm`
# (0 dBm is physically impossible for a STA link) and ethtool's as an s8 in an UNSIGNED column.
# **ethtool's `signal` is an s8 rendered UNSIGNED** — 238 means -18 dBm, not 238. Reinterpreted
# (v>127 ? v-256 : v); a raw 0 is "not filled", rendered n/a, never 0 dBm. The primary `signal=`
# stays iw's, which is already signed; `sig_eth=` is the ethtool read for cross-check.
#
# HOW the delta is taken: two samples INTERVAL seconds apart (default 3s), in ONE run —
# self-contained, no cross-run state dependency, no counter-wrap hazard from a stale saved prior.
# Cheap: one iw + one ethtool read each, NO scan, NO off-channel blip.
# Both need no privilege here (verified live — regular user reads them).
#
# Verdicts (vocab is a contract — consumers grep these tokens). Each LIVE axis is classed, then
# folded by MAX SEVERITY with the winner NAMED in `via=` (a bare max effaces which axis spoke):
#   TX band (Δretries/Δpkts):     CLEAR <10%   CONTENDED 10-30%   CONGESTED >=30%
#   RX band (Δdup/Δrx_packets):   CLEAR <1%    CONTENDED 1-5%     CONGESTED >=5%
#     RX band is CALIBRATED on this node's live ambient corpus (2026-08-18, n=11 windows of
#     15-20s): every ambient window landed 0.01-0.75%, so the whole ambient corpus is CLEAR and
#     CONTENDED is REACHABLE (unlike the tx band here). The ratio is LOAD-DEPENDENT — duplicates
#     arrive at a roughly flat rate while rx_packets swings 100x, so a QUIET window inflates it
#     (a 1787-packet/20s idle window read 6.0%). Hence RX_MIN_PKTS: below it the rx axis is n/a,
#     not a reading. Re-derive the band if the corpus moves; do not quote these numbers as fixed.
#   IDLE        both axes too quiet to rate this window — a REAL read (associated, link up); rc 0
#   UNKNOWN     no radio / not associated / counters reset (re-assoc) / EVERY axis structurally
#               n/a (e.g. tx pinned AND no ethtool) — the sense has nothing to say → rc 2
#
#   mesh-wifi-contention          two-sample interval read (default 3s), write state, echo
#   mesh-wifi-contention --state  print the last written verdict (no fresh eval)
#   mesh-wifi-contention --test   parser + delta + classifier fixtures + a real live-read gate
#
# STATE: ~/.mesh/.wifi-contention.state — written unconditionally EVERY run (mtime = liveness).
# exit: 0 = verdict rendered (incl IDLE) · 2 = honest n/a (no radio / not assoc / reset / no axis)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"

STATE="${WIFI_CONTENTION_STATE:-$HOME/.mesh/.wifi-contention.state}"
INTERVAL="${WIFI_CONTENTION_INTERVAL:-3}"        # seconds between the two samples
MIN_PKTS="${WIFI_CONTENTION_MIN_PKTS:-20}"       # below this Δtx_packets the tx axis is too idle to rate
RX_MIN_PKTS="${WIFI_CONTENTION_RX_MIN_PKTS:-2000}" # below this Δrx_packets the dup RATIO is inflated by low volume
TX_PIN_MIN="${WIFI_CONTENTION_TX_PIN_MIN:-10000}"  # lifetime tx_packets above which a still-0 tx_retries means PINNED

U64_MAX=18446744073709551615   # ethtool's "unsupported" in a u64 column — NEVER arithmetic it

classify(){ # <retry_pct_int> → verdict token (TX band)
  local r="$1"
  if   [ "$r" -lt 10 ]; then echo CLEAR
  elif [ "$r" -lt 30 ]; then echo CONTENDED
  else echo CONGESTED; fi
}

classify_rx(){ # <dup_pct_x100 int> → verdict token (RX band: <1% / 1-5% / >=5%, in hundredths)
  local r="$1"
  if   [ "$r" -lt 100 ]; then echo CLEAR
  elif [ "$r" -lt 500 ]; then echo CONTENDED
  else echo CONGESTED; fi
}

sev(){ case "$1" in CLEAR) echo 0;; CONTENDED) echo 1;; CONGESTED) echo 2;; *) echo -1;; esac; }

u64_ok(){ # rc 0 iff the raw string is a usable number (present and not the unsupported sentinel)
  [ -n "${1:-}" ] && [ "$1" != "-" ] && [ "$1" != "$U64_MAX" ]
}

dbm(){ # iw's signal is already signed, but rtw88 renders it 0 when unset — 0 dBm is impossible
  local v="${1:-}"
  case "$v" in ''|-|0) echo "n/a(unset)"; return;; esac
  echo "$v"
}

s8(){ # ethtool renders an s8 UNSIGNED: 238 → -18. raw 0 = not filled → "n/a"
  local v="${1:-}"
  case "$v" in ''|-|*[!0-9]*) echo "n/a"; return;; esac
  [ "$v" = 0 ] && { echo "n/a"; return; }
  [ "$v" -gt 127 ] && { echo $((v-256)); return; }
  echo "$v"
}

# parse ONE `iw station dump` on stdin → "txp txr txf bl txmcs rxmcs sig rxdropmisc assoc"
parse_dump(){
  awk '
    /^[[:space:]]*Station /       { assoc=1 }
    /^[[:space:]]*tx packets:/    { txp=$3+0 }
    /^[[:space:]]*tx retries:/    { txr=$3+0 }
    /^[[:space:]]*tx failed:/     { txf=$3+0 }
    /^[[:space:]]*beacon loss:/   { bl=$3+0 }
    /^[[:space:]]*rx drop misc:/  { rdm=$4+0 }
    /^[[:space:]]*signal:/        { if(sig=="") sig=$2+0 }
    /^[[:space:]]*tx bitrate:/    { for(i=1;i<=NF;i++) if($i ~ /MCS$/){ txmcs=$(i+1)+0; break } }
    /^[[:space:]]*rx bitrate:/    { for(i=1;i<=NF;i++) if($i ~ /MCS$/){ rxmcs=$(i+1)+0; break } }
    END {
      if(!assoc){ print "0 0 0 0 - - 0 0 0"; exit }
      printf "%d %d %d %d %s %s %d %d 1\n", txp, txr, txf, bl, \
             (txmcs==""?"-":txmcs), (rxmcs==""?"-":rxmcs), sig, rdm
    }'
}

# parse ONE `ethtool -S <if>` on stdin → "rxp rxdup rxdrop sig noise chtime chbusy present"
# raw strings, NOT arithmetic'd — the u64(-1) sentinel must survive to the caller intact.
parse_ethtool(){
  awk '
    { gsub(/[:,]/,"") }
    $1=="rx_packets"    { rxp=$2;  seen=1 }
    $1=="rx_duplicates" { dup=$2;  seen=1 }
    $1=="rx_dropped"    { drop=$2; seen=1 }
    $1=="signal"        { sig=$2 }
    $1=="noise"         { noise=$2 }
    $1=="ch_time"       { cht=$2 }
    $1=="ch_time_busy"  { chb=$2 }
    END {
      if(!seen){ print "- - - - - - - 0"; exit }
      printf "%s %s %s %s %s %s %s 1\n", \
        (rxp==""?"-":rxp), (dup==""?"-":dup), (drop==""?"-":drop), \
        (sig==""?"-":sig), (noise==""?"-":noise), (cht==""?"-":cht), (chb==""?"-":chb)
    }'
}

render_delta(){ # "$iw1" "$iw2" "$eth1" "$eth2" → verdict line + rc
  local p1 r1 f1 b1 tm1 rm1 s1 rdm1 as1  p2 r2 f2 b2 tm2 rm2 s2 rdm2 as2
  read -r p1 r1 f1 b1 tm1 rm1 s1 rdm1 as1 <<<"$1"
  read -r p2 r2 f2 b2 tm2 rm2 s2 rdm2 as2 <<<"$2"
  local e1 e2
  e1="${3:-- - - - - - - 0}"; e2="${4:-- - - - - - - 0}"
  local xp1 xd1 xdr1 xs1 xn1 xt1 xb1 ep1  xp2 xd2 xdr2 xs2 xn2 xt2 xb2 ep2
  read -r xp1 xd1 xdr1 xs1 xn1 xt1 xb1 ep1 <<<"$e1"
  read -r xp2 xd2 xdr2 xs2 xn2 xt2 xb2 ep2 <<<"$e2"

  if [ "$as1" != 1 ] || [ "$as2" != 1 ]; then
    echo "UNKNOWN|assoc=NO(not connected to an AP)"; return 2
  fi
  local dpkts=$((p2-p1)) dretr=$((r2-r1)) dbl=$((b2-b1))
  if [ "$dpkts" -lt 0 ] || [ "$dretr" -lt 0 ] || [ "$dbl" -lt 0 ]; then
    echo "UNKNOWN|counters=RESET(re-assoc between samples)"; return 2
  fi

  # ---- TX axis: n/a when the driver PINS it (a constant is not a reading), n/a when too quiet
  local txv="" rp_s life_s
  if [ "$r2" = 0 ] && [ "$p2" -ge "$TX_PIN_MIN" ]; then
    rp_s="n/a(tx-pinned:driver never counts retries over ${p2} lifetime pkts)"; life_s="n/a(pinned)"
  elif [ "$dpkts" -lt "$MIN_PKTS" ]; then
    rp_s="n/a(dpkts=$dpkts<$MIN_PKTS)"; life_s="$(( p2>0 ? r2*100/p2 : 0 ))%"
  else
    local rp=$(( dretr*100/dpkts ))
    txv="$(classify "$rp")"; rp_s="${rp}%"; life_s="$(( p2>0 ? r2*100/p2 : 0 ))%"
  fi

  # ---- RX axis: Δrx_duplicates / Δrx_packets, floored on rx volume (a quiet window inflates it)
  local rxv="" rxp_s="n/a(no-ethtool)" drx=0 ddup=0 ddrop_s="n/a" pair_s="n/a"
  if [ "$ep1" = 1 ] && [ "$ep2" = 1 ] && u64_ok "$xp1" && u64_ok "$xp2" && u64_ok "$xd1" && u64_ok "$xd2"; then
    drx=$((xp2-xp1)); ddup=$((xd2-xd1))
    if [ "$drx" -lt 0 ] || [ "$ddup" -lt 0 ]; then
      rxp_s="n/a(counters reset)"
    elif [ "$drx" -lt "$RX_MIN_PKTS" ]; then
      rxp_s="n/a(rxdpkts=$drx<$RX_MIN_PKTS — ratio inflated at low volume)"
    else
      local rxpct=$(( ddup*10000/drx ))          # hundredths of a percent
      rxv="$(classify_rx "$rxpct")"
      rxp_s="$(awk -v v="$rxpct" 'BEGIN{printf "%.2f%%", v/100}')"
    fi
    # rx_dropped is read ONLY as the PAIR: on rtw88 ~100% of it IS the dedup, not loss.
    if u64_ok "$xdr1" && u64_ok "$xdr2"; then
      local ddrop=$((xdr2-xdr1)); ddrop_s="$ddrop"
      if [ "$ddup" -eq "$ddrop" ]; then pair_s="dedup(Δdrop==Δdup)"
      else pair_s="loss?(Δdrop=$ddrop vs Δdup=$ddup)"; fi
    fi
  fi

  # ---- airtime: u64(-1) is UNSUPPORTED, and delta'd it is 0 — a fabricated idle channel
  local air_s="UNSUPPORTED(u64-1)"
  if [ "$ep1" != 1 ] || [ "$ep2" != 1 ]; then air_s="n/a(no-ethtool)"
  elif u64_ok "$xt1" && u64_ok "$xt2" && u64_ok "$xb1" && u64_ok "$xb2"; then
    local dt=$((xt2-xt1)) db=$((xb2-xb1))
    if [ "$dt" -gt 0 ] && [ "$db" -ge 0 ]; then air_s="$(( db*100/dt ))%busy"; else air_s="n/a(Δch_time=$dt)"; fi
  fi
  local noise_s="UNSUPPORTED(u64-1)"
  [ "$ep2" = 1 ] || noise_s="n/a(no-ethtool)"
  u64_ok "$xn2" && noise_s="${xn2}"

  # ---- fold: MAX severity across the LIVE axes, and NAME the winner
  local v via
  local stx; stx=$(sev "${txv:-}"); local srx; srx=$(sev "${rxv:-}")
  if [ -z "$txv" ] && [ -z "$rxv" ]; then
    case "$rp_s" in
      n/a\(tx-pinned*) v=UNKNOWN; via="axes=NONE(tx=pinned,rx=${rxp_s})" ;;
      *)               v=IDLE;    via="axes=IDLE(tx=${rp_s},rx=${rxp_s})" ;;
    esac
  elif [ "$stx" -ge "$srx" ]; then v="$txv"; via="tx"
  else v="$rxv"; via="rx"; fi
  if [ "$dbl" -gt 0 ]; then v=CONGESTED; via="beaconloss"; fi   # hard link fault trumps every ratio

  echo "$v|via=$via|retry_pct=$rp_s|rxdup_pct=$rxp_s|rxdrop=$ddrop_s($pair_s)|txmcs=$tm2|rxmcs=$rm2|beaconloss=$dbl|retry_life=$life_s|signal=$(dbm "$s2")|sig_eth=$(s8 "$xs2")|noise=$noise_s|airtime=$air_s|dpkts=$dpkts|rxdpkts=$drx"
  [ "$v" = UNKNOWN ] && return 2
  return 0
}

evaluate(){
  local d1 d2 e1 e2 iface
  if [ -n "${WIFI_CONTENTION_FIX1:-}" ] && [ -n "${WIFI_CONTENTION_FIX2:-}" ]; then
    d1="$(parse_dump < "$WIFI_CONTENTION_FIX1")"
    d2="$(parse_dump < "$WIFI_CONTENTION_FIX2")"
    e1="- - - - - - - 0"; e2="- - - - - - - 0"
    [ -n "${WIFI_CONTENTION_ETH1:-}" ] && e1="$(parse_ethtool < "$WIFI_CONTENTION_ETH1")"
    [ -n "${WIFI_CONTENTION_ETH2:-}" ] && e2="$(parse_ethtool < "$WIFI_CONTENTION_ETH2")"
  else
    iface="$(iw dev 2>/dev/null | awk '/Interface/{print $2; exit}')"
    [ -n "$iface" ] || { echo "UNKNOWN|radio=NONE"; return 2; }
    d1="$(iw dev "$iface" station dump 2>/dev/null | parse_dump)"
    e1="$(ethtool -S "$iface" 2>/dev/null | parse_ethtool)"
    sleep "$INTERVAL"
    d2="$(iw dev "$iface" station dump 2>/dev/null | parse_dump)"
    e2="$(ethtool -S "$iface" 2>/dev/null | parse_ethtool)"
  fi
  render_delta "$d1" "$d2" "$e1" "$e2"
}

if [ "${1:-}" = --state ]; then cat "$STATE" 2>/dev/null || { echo "no state yet" >&2; exit 1; }; exit 0; fi

if [ "${1:-}" = --test ]; then
  T="$(mktemp -d)"; trap 'rm -rf "$T"' EXIT
  # two snapshots of the same associated link: +1000 tx_pkts, +200 retries = 20% interval retry
  cat > "$T/s1" <<'EOF'
Station 1e:63:5a:a3:7d:e7 (on wlp0)
    tx packets:	100000
    tx retries:	10000
    tx failed:	0
    beacon loss:	0
    rx drop misc:	500
    signal:  	-66 [-69, -66] dBm
    tx bitrate:	195.1 MBit/s VHT-MCS 2 80MHz short GI VHT-NSS 2
    rx bitrate:	390.0 MBit/s VHT-MCS 4 80MHz short GI VHT-NSS 2
EOF
  cat > "$T/s2" <<'EOF'
Station 1e:63:5a:a3:7d:e7 (on wlp0)
    tx packets:	101000
    tx retries:	10200
    tx failed:	0
    beacon loss:	0
    rx drop misc:	508
    signal:  	-65 [-69, -66] dBm
    tx bitrate:	195.1 MBit/s VHT-MCS 3 80MHz short GI VHT-NSS 2
    rx bitrate:	390.0 MBit/s VHT-MCS 5 80MHz short GI VHT-NSS 2
EOF
  # (a) parser: one dump → exact field row
  got="$(parse_dump < "$T/s2")"
  [ "$got" = "101000 10200 0 0 3 5 -65 508 1" ] || { echo "smoke-test: FAIL (parse → '$got')"; exit 1; }
  # (b) delta: Δpkts=1000 Δretr=200 → 20% CONTENDED via=tx, rc 0
  out="$(WIFI_CONTENTION_FIX1="$T/s1" WIFI_CONTENTION_FIX2="$T/s2" WIFI_CONTENTION_STATE="$T/st" "$0")"; rc=$?
  { [ "$rc" = 0 ] && printf '%s' "$out" | grep -q '^CONTENDED|via=tx|retry_pct=20%|.*|txmcs=3|rxmcs=5|beaconloss=0|'; } \
    || { echo "smoke-test: FAIL (delta → rc=$rc '$out')"; exit 1; }
  # (c) state written unconditionally (mtime = liveness)
  [ -s "$T/st" ] || { echo "smoke-test: FAIL (no state written)"; exit 1; }
  # (d) idle window: Δpkts=5 (<MIN) and no ethtool → IDLE, retry_pct n/a, rc 0 (real read)
  sed 's/101000/100005/; s/10200/10001/' "$T/s2" > "$T/s2idle"
  out="$(WIFI_CONTENTION_FIX1="$T/s1" WIFI_CONTENTION_FIX2="$T/s2idle" WIFI_CONTENTION_STATE="$T/st" "$0")"; rc=$?
  { [ "$rc" = 0 ] && printf '%s' "$out" | grep -q '^IDLE|via=axes=IDLE(tx=n/a(dpkts=5<20),rx=n/a(no-ethtool))|retry_pct=n/a(dpkts=5<20)|'; } \
    || { echo "smoke-test: FAIL (idle → rc=$rc '$out')"; exit 1; }
  # (e) beacon loss in-window forces CONGESTED via=beaconloss even at a low retry ratio
  awk '{ if($0 ~ /beacon loss:/) sub(/0$/,"3"); print }' "$T/s2" > "$T/s2bl"
  out="$(WIFI_CONTENTION_FIX1="$T/s1" WIFI_CONTENTION_FIX2="$T/s2bl" WIFI_CONTENTION_STATE="$T/st" "$0")"
  printf '%s' "$out" | grep -q '^CONGESTED|via=beaconloss|.*beaconloss=3|' \
    || { echo "smoke-test: FAIL (beacon-loss escalation → '$out')"; exit 1; }
  # (f) counters reset (samples reversed → negative Δ) → UNKNOWN, rc 2
  out="$(WIFI_CONTENTION_FIX1="$T/s2" WIFI_CONTENTION_FIX2="$T/s1" WIFI_CONTENTION_STATE="$T/st" "$0")"; rc=$?
  { [ "$rc" = 2 ] && printf '%s' "$out" | grep -q '^UNKNOWN|counters=RESET'; } \
    || { echo "smoke-test: FAIL (reset → rc=$rc '$out')"; exit 1; }
  # (g) not associated (empty dump) → UNKNOWN assoc=NO, rc 2
  : > "$T/empty"
  out="$(WIFI_CONTENTION_FIX1="$T/empty" WIFI_CONTENTION_FIX2="$T/empty" WIFI_CONTENTION_STATE="$T/st" "$0")"; rc=$?
  { [ "$rc" = 2 ] && printf '%s' "$out" | grep -q '^UNKNOWN|assoc=NO'; } \
    || { echo "smoke-test: FAIL (not-assoc → rc=$rc '$out')"; exit 1; }
  # (h) classifier boundaries — both bands
  for pair in "9 CLEAR" "10 CONTENDED" "29 CONTENDED" "30 CONGESTED"; do
    set -- $pair; got="$(classify "$1")"
    [ "$got" = "$2" ] || { echo "smoke-test: FAIL (classify $1 → $got want $2)"; exit 1; }
  done
  for pair in "99 CLEAR" "100 CONTENDED" "499 CONTENDED" "500 CONGESTED"; do
    set -- $pair; got="$(classify_rx "$1")"
    [ "$got" = "$2" ] || { echo "smoke-test: FAIL (classify_rx $1 → $got want $2)"; exit 1; }
  done

  # ---- the rtw88 fixtures: THE regression this tool was rebuilt for ----
  # a REAL rtw88 pair (pinned tx_retries, live rx_duplicates, u64(-1) survey fields, unsigned s8 signal)
  cat > "$T/r1" <<'EOF'
Station bc:ec:43:43:4a:22 (on wlxbcec43434a22)
	tx packets:	716000
	tx retries:	0
	tx failed:	6
	beacon loss:	443
	rx drop misc:	19301
	signal:  	-61 [-61, 0] dBm
	tx bitrate:	86.7 MBit/s MCS 9 short GI
	rx bitrate:	144.4 MBit/s MCS 15 short GI
EOF
  sed 's/716000/720000/; s/rx drop misc:\t19301/rx drop misc:\t19501/' "$T/r1" > "$T/r2"
  cat > "$T/e1" <<'EOF'
NIC statistics:
     rx_packets: 979931
     rx_duplicates: 19298
     rx_dropped: 19301
     tx_packets: 716000
     tx_retry_failed: 6
     tx_retries: 0
     signal: 238
     channel: 0
     noise: 18446744073709551615
     ch_time: 18446744073709551615
     ch_time_busy: 18446744073709551615
EOF
  # +10000 rx packets, +200 duplicates = 2.00% → CONTENDED on the rx band
  sed 's/rx_packets: 979931/rx_packets: 989931/; s/rx_duplicates: 19298/rx_duplicates: 19498/; s/rx_dropped: 19301/rx_dropped: 19501/' "$T/e1" > "$T/e2"
  out="$(WIFI_CONTENTION_FIX1="$T/r1" WIFI_CONTENTION_FIX2="$T/r2" WIFI_CONTENTION_ETH1="$T/e1" WIFI_CONTENTION_ETH2="$T/e2" WIFI_CONTENTION_STATE="$T/st" "$0")"; rc=$?
  # (i) THE GATE: pinned tx + live rx duplicates must NOT read CLEAR. (Seen RED against the
  #     pre-fix tool, which rendered `CLEAR|retry_pct=0%|...` from a hardware constant.)
  printf '%s' "$out" | grep -q '^CLEAR|' \
    && { echo "smoke-test: FAIL (rtw88 pinned tx + 2% rx dupes read CLEAR → '$out')"; exit 1; }
  { [ "$rc" = 0 ] && printf '%s' "$out" | grep -q '^CONTENDED|via=rx|'; } \
    || { echo "smoke-test: FAIL (rtw88 rx leg → rc=$rc '$out')"; exit 1; }
  # (j) the tx axis renders n/a NAMING the pin, never a percentage
  printf '%s' "$out" | grep -q 'retry_pct=n/a(tx-pinned:' \
    || { echo "smoke-test: FAIL (pinned tx axis not rendered n/a → '$out')"; exit 1; }
  printf '%s' "$out" | grep -q 'retry_life=n/a(pinned)' \
    || { echo "smoke-test: FAIL (pinned lifetime ratio not n/a → '$out')"; exit 1; }
  # (k) u64(-1) rejected as UNSUPPORTED before arithmetic — delta'd it is 0, a fabricated idle channel
  printf '%s' "$out" | grep -q 'noise=UNSUPPORTED(u64-1)|airtime=UNSUPPORTED(u64-1)' \
    || { echo "smoke-test: FAIL (u64(-1) not rejected → '$out')"; exit 1; }
  printf '%s' "$out" | grep -qE 'airtime=0%busy|noise=18446744073709551615' \
    && { echo "smoke-test: FAIL (u64(-1) arithmetic'd → '$out')"; exit 1; }
  # (l) ethtool signal is an s8 rendered unsigned: 238 → -18, never 238
  printf '%s' "$out" | grep -q 'sig_eth=-18|' \
    || { echo "smoke-test: FAIL (s8 reinterp → '$out')"; exit 1; }
  # (m) rx_dropped read ONLY as the pair — equal deltas are dedup, not loss
  printf '%s' "$out" | grep -q 'rxdrop=200(dedup(Δdrop==Δdup))' \
    || { echo "smoke-test: FAIL (rx_dropped pair → '$out')"; exit 1; }
  # (n) a REAL loss case (Δdrop > Δdup) must NOT be labelled dedup
  sed 's/rx_dropped: 19501/rx_dropped: 20501/' "$T/e2" > "$T/e2loss"
  out2="$(WIFI_CONTENTION_FIX1="$T/r1" WIFI_CONTENTION_FIX2="$T/r2" WIFI_CONTENTION_ETH1="$T/e1" WIFI_CONTENTION_ETH2="$T/e2loss" WIFI_CONTENTION_STATE="$T/st" "$0")"
  printf '%s' "$out2" | grep -q 'rxdrop=1200(loss?(' \
    || { echo "smoke-test: FAIL (Δdrop>Δdup not flagged → '$out2')"; exit 1; }
  # (o) low rx volume must render the rx axis n/a, NOT the inflated ratio (a 1787-pkt window read 6%)
  sed 's/rx_packets: 989931/rx_packets: 981718/' "$T/e2" > "$T/e2quiet"
  out3="$(WIFI_CONTENTION_FIX1="$T/r1" WIFI_CONTENTION_FIX2="$T/r2" WIFI_CONTENTION_ETH1="$T/e1" WIFI_CONTENTION_ETH2="$T/e2quiet" WIFI_CONTENTION_STATE="$T/st" "$0")"; rc=$?
  printf '%s' "$out3" | grep -q 'rxdup_pct=n/a(rxdpkts=1787<2000' \
    || { echo "smoke-test: FAIL (low-volume rx not n/a → '$out3')"; exit 1; }
  # (p) EVERY axis structurally n/a (tx pinned + rx too quiet) → UNKNOWN rc 2, never a CLEAR
  { [ "$rc" = 2 ] && printf '%s' "$out3" | grep -q '^UNKNOWN|via=axes=NONE(tx=pinned,'; } \
    || { echo "smoke-test: FAIL (all-axes-n/a → rc=$rc '$out3')"; exit 1; }
  # (q) the pin un-sticks the instant ONE real retry is counted (not a permanent verdict)
  sed 's/tx retries:\t0/tx retries:\t50/' "$T/r2" > "$T/r2retr"
  out4="$(WIFI_CONTENTION_FIX1="$T/r1" WIFI_CONTENTION_FIX2="$T/r2retr" WIFI_CONTENTION_ETH1="$T/e1" WIFI_CONTENTION_ETH2="$T/e2" WIFI_CONTENTION_STATE="$T/st" "$0")"
  printf '%s' "$out4" | grep -q 'retry_pct=1%' \
    || { echo "smoke-test: FAIL (pin did not release on a real retry → '$out4')"; exit 1; }

  # (t) iw's signal is 0 when unset on this chip — 0 dBm is impossible, must render n/a not 0
  sed 's/signal:  \t-61 \[-61, 0\] dBm/signal:  \t0 [0, 0] dBm/' "$T/r2" > "$T/r2sig0"
  out5="$(WIFI_CONTENTION_FIX1="$T/r1" WIFI_CONTENTION_FIX2="$T/r2sig0" WIFI_CONTENTION_ETH1="$T/e1" WIFI_CONTENTION_ETH2="$T/e2" WIFI_CONTENTION_STATE="$T/st" "$0")"
  printf '%s' "$out5" | grep -q 'signal=n/a(unset)|' \
    || { echo "smoke-test: FAIL (unset iw signal not n/a → '$out5')"; exit 1; }
  printf '%s' "$out5" | grep -q 'signal=0|' \
    && { echo "smoke-test: FAIL (0 dBm rendered as a value → '$out5')"; exit 1; }

  # (r) REAL read gate: associated STA present → must render a real verdict token (rc 0/2), never hollow
  iface="$(iw dev 2>/dev/null | awk '/Interface/{print $2; exit}')"
  out="$(WIFI_CONTENTION_INTERVAL=1 WIFI_CONTENTION_STATE="$T/st" "$0")"; rc=$?
  if [ -n "$iface" ] && iw dev "$iface" station dump 2>/dev/null | grep -q '^Station '; then
    { [ "$rc" = 0 ] || [ "$rc" = 2 ]; } || { echo "smoke-test: FAIL (live rc=$rc)"; exit 1; }
    printf '%s' "$out" | grep -qE '^(CLEAR|CONTENDED|CONGESTED|IDLE|UNKNOWN)\|' \
      || { echo "smoke-test: FAIL (STA present but live read gave '$out' — hollow sense)"; exit 1; }
    # (s) REAL ethtool gate: where ethtool -S renders the counter block, the rx axis must be
    #     genuinely read (a real number or a NAMED n/a), never silently the no-ethtool default.
    if ethtool -S "$iface" 2>/dev/null | grep -q 'rx_duplicates'; then
      printf '%s' "$out" | grep -q 'rxdup_pct=n/a(no-ethtool)' \
        && { echo "smoke-test: FAIL (ethtool has rx_duplicates but the rx axis read no-ethtool → '$out')"; exit 1; }
      printf '%s' "$out" | grep -qE 'rxdup_pct=([0-9]+\.[0-9]{2}%|n/a\(rxdpkts=)' \
        || { echo "smoke-test: FAIL (live rx axis not rendered → '$out')"; exit 1; }
    fi
  else
    { [ "$rc" = 2 ] && printf '%s' "$out" | grep -q '^UNKNOWN|'; } \
      || { echo "smoke-test: FAIL (no STA but rc=$rc '$out')"; exit 1; }
  fi
  echo "smoke-test: ok"; exit 0
fi

# --- one read: evaluate, write state unconditionally (mtime = ran-live), echo ---
v="$(evaluate)"; rc=$?
printf '%s\n' "$v" > "$STATE.tmp" && mv "$STATE.tmp" "$STATE"
echo "$v"
exit "$rc"
