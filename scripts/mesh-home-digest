#!/usr/bin/env bash
# reflex-cadence: 0 6 * * *
# mesh-home-digest — daily sensor digest: rhythm, presence, anomalies
#
# Reads: ~/.mesh/home-state.log, ~/.mesh/presence.log, ~/.mesh/sensors.log
# Output: one-line digest + board post + optional TG push
#
#   mesh-home-digest              daily digest, post to board
#   mesh-home-digest --json       machine-readable
#   mesh-home-digest --test       smoke test
#   mesh-home-digest --TG         post to operator via TG
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

MESH="$HOME/.mesh"
HS_LOG="$MESH/home-state.log"
PRES_LOG="$MESH/presence.log"
SENS_LOG="$MESH/sensors.log"
DIGEST_DIR="$MESH/digests"
TODAY=$(date -u +%Y-%m-%d)

# --- Test ---
if [ "${1:-}" = --test ]; then
  command -v awk >/dev/null 2>&1 || { echo "smoke-test: FAIL (no awk — all aggregation dead)"; exit 1; }
  td="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
  trap 'rm -rf "$td"' EXIT
  mkdir -p "$td/.mesh"
  t="$(date -u +%Y-%m-%d)"
  # 1) empty-data run must not crash (no logs present). --json so no real board post.
  HOME="$td" MESH_DIR="$td/.mesh" "$0" --json >/dev/null 2>&1 \
    || { echo "smoke-test: FAIL (empty-data run errored)"; exit 1; }
  # 2) FALSIFIABLE dry-run on SYNTHETIC fixtures — exercises all four aggregation awks (rhythm,
  #    device top-N, new-unknown, anomalies). Was: ONLY the empty-data path ran, so every awk block
  #    could be broken and --test still PASSED (echo-ok-grade). Now break ANY block → an assert FAILs.
  printf '%s\n' \
    '[home-state] ACTIVE: fixture one' \
    '[home-state] ACTIVE: fixture two' \
    '[home-state] ACTIVE: fixture three' \
    '[home-state] ASLEEP: fixture sleep' > "$td/.mesh/home-state.log"
  # Line 4 carries BOTH traps of the post-] tail (presence.log format since 2026-06-21), same
  # two-trap fixture as mesh-situation:143-150: a bracket-bearing name ([TV] ...) that a cut at
  # the FIRST ']' would truncate (dropping every device after it), and a trailing-? device the
  # glued tail would render "named" — polluting top_devices AND permanently excluding the MAC
  # from new_unknown.
  printf '%s\n' \
    "${t}T10:00:00Z testhost n=2 devices=[-70|AA:00:00:00:00:01|TestDev -85|BB:00:00:00:00:02|OtherDev]" \
    "${t}T10:05:00Z testhost n=2 devices=[-72|AA:00:00:00:00:01|TestDev -90|CC:00:00:00:00:03|?]" \
    "${t}T10:10:00Z testhost n=1 devices=[-74|AA:00:00:00:00:01|TestDev]" \
    "${t}T10:15:00Z testhost n=3 devices=[-60|AA:00:00:00:00:01|TestDev -65|EE:00:00:00:00:05|[TV] Fixture 5 Series (40) -91|DD:00:00:00:00:04|?] attribution=personal:1,appliance:0,ambiguous:1 unidentified=public:1,random:0,unknown:0" > "$td/.mesh/presence.log"
  printf '%s\n' \
    "${t}T10:00:00Z testhost cpu_temp 94.0" \
    "${t}T10:05:00Z testhost room_sense UNCERTAIN" > "$td/.mesh/sensors.log"
  out="$(HOME="$td" MESH_DIR="$td/.mesh" "$0" --json 2>/dev/null)"
  fail=""
  printf '%s' "$out" | grep -q '"rhythm":"ACTIVE (3/4)"'            || fail="${fail}rhythm "
  printf '%s' "$out" | grep -q '"top_devices":"TestDev(4,avg-69dBm)' || fail="${fail}device-top-N "
  printf '%s' "$out" | grep -q '"scans_today":4'                    || fail="${fail}scans "
  printf '%s' "$out" | grep -q '2 new MAC(s):'                      || fail="${fail}new-unknown-count "
  printf '%s' "$out" | grep -q 'CC:00:00:00:00:03'                  || fail="${fail}new-unknown-CC "
  printf '%s' "$out" | grep -q 'DD:00:00:00:00:04'                  || fail="${fail}new-unknown-tail-DD "
  printf '%s' "$out" | grep -qF 'TV Fixture 5 Series (40)(1,avg-65dBm)' || fail="${fail}bracket-name-truncated "
  case "$out" in *attribution*) fail="${fail}tail-glued-to-name " ;; esac
  printf '%s' "$out" | grep -q 'cpu_high=94'                        || fail="${fail}anomaly-cpu "
  printf '%s' "$out" | grep -q 'room_uncertain=1'                   || fail="${fail}anomaly-room "
  [ -z "$fail" ] || { echo "smoke-test: FAIL (aggregation broken: ${fail}| got: $out)"; exit 1; }

  # 3) late_active: WINDOW-bounded to the writer cadence (pinned here via MESH_HS_STRIDE_MIN=15 →
  #    96 lines/day, so the arithmetic below is host-crontab-independent), not lifetime-cumulative
  #    (chat-review/home-digest-late-night-scope). 200 "old junk" late-night-ACTIVE lines sit outside
  #    the trailing-96 window and must NOT be counted. AND the hour axis must come from the hour=
  #    token, never a default (chat-review/home-digest-late-night-counts-hourless-as-midnight):
  #    an HOUR-LESS line in the real daytime writer shape (what mesh-home-state emitted 09-23h for
  #    its whole life before the unconditional stamp — logs are full of them) must NOT count (the
  #    unmatched-gsub default read it as hour-0 = midnight; watched RED pre-fix at =3), and an
  #    hour=14h daytime line must not count either. Expected: only the 2 real night-ACTIVE lines.
  td3="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
  mkdir -p "$td3/.mesh"
  {
    i=0; while [ "$i" -lt 200 ]; do printf '[home-state] ACTIVE: old junk | hour=3h (night)\n'; i=$((i+1)); done
    i=0; while [ "$i" -lt 92 ]; do printf '[home-state] QUIET_NIGHT: quiet | hour=2h (night)\n'; i=$((i+1)); done
    printf '[home-state] ACTIVE: home active | room-fresh=UNCERTAIN %s ble_named=5 %s several devices active (busy, not necessarily social)\n' '·' '→'
    printf '[home-state] ACTIVE: home active | room-fresh=UNCERTAIN %s hour=14h %s ble_named=5\n' '·' '·'
    printf '[home-state] ACTIVE: recent one | hour=1h (night)\n'
    printf '[home-state] ACTIVE: recent two | hour=4h (night)\n'
  } > "$td3/.mesh/home-state.log"
  printf '%sT10:00:00Z testhost cpu_temp 40.0\n' "$t" > "$td3/.mesh/sensors.log"  # late_active lives inside the [ -f "$SENS_LOG" ] gate
  out3="$(HOME="$td3" MESH_DIR="$td3/.mesh" MESH_HS_STRIDE_MIN=15 "$0" --json 2>/dev/null)"
  printf '%s' "$out3" | grep -q 'late_night_active=2\b' \
    || { echo "smoke-test: FAIL (late_active wrong: want exactly the 2 night-ACTIVE lines — an hour-less or hour=14h daytime line counted as midnight, or the window is unbounded; got: $out3)"; exit 1; }
  echo "smoke-test: ok (rhythm + device-top-N + scans + new-unknown + cpu/room anomalies + late-active windowing verified on synthetic fixtures)"; exit 0
fi

# --- Daily rhythm: dominant state from home-state.log ---
rhythm=""
if [ -f "$HS_LOG" ]; then
  rhythm=$(awk '
    {
      s = $0; p = index(s, "[home-state] "); if (!p) next
      s = substr(s, p + 13); q = index(s, ":"); if (!q) next
      state = substr(s, 1, q - 1)
      count[state]++
      total++
    }
    END {
      if (total == 0) { print "no-data"; exit }
      best = ""; bc = 0
      for (st in count) if (count[st] > bc) { bc = count[st]; best = st }
      printf "%s (%d/%d)", best, bc, total
    }
  ' "$HS_LOG" 2>/dev/null || echo "parse-error")
fi

# --- Named BLE devices: group by name, show top devices by presence ---
named_top=""
scan_today=0
if [ -f "$PRES_LOG" ]; then
  scan_today=$(awk -v d="$TODAY" '{ if (substr($0,1,10)==d) c++ } END { print c+0 }' "$PRES_LOG")

  named_top=$(awk '
    {
      s = $0
      p1 = index(s, "devices=["); p2 = index(s, "closest=[")
      if (p1) d = substr(s, p1 + 9)
      else if (p2) d = substr(s, p2 + 8)
      else next
      # presence.log (since 2026-06-21) appends " attribution=... unidentified=..." AFTER the
      # closing ] — strip the LAST ] + its bracket-free tail, or the tail glues onto the LAST
      # device name. Must be the LAST ]: names carry brackets ([TV] ...), a first-] cut
      # truncates them and drops every device after. Same strip as mesh-situation:266-272.
      sub(/\][^\]]*$/, "", d)
      gsub(/[\[\]]/, "", d)
      # Split entries: each starts with -DIGITS|
      gsub(/-[0-9]+\|/, "\n&", d)
      gsub(/^\n/, "", d)
      n = split(d, entries, "\n")
      for (i = 1; i <= n; i++) {
        split(entries[i], p, "|")
        if (length(p) < 3) continue
        c = substr(entries[i], 1, 1)
        if (c != "-") continue
        mac = p[2]; nm = p[3]
        gsub(/^[ \t]+|[ \t]+$/, "", nm)
        if (nm == "?" || nm == "" || length(nm) < 2) continue
        name_count[nm]++
        name_rssi[nm] += p[1]
        name_n[nm]++
      }
    }
    END {
      n = 0
      for (nm in name_count) { names[n] = nm; counts[n] = name_count[nm]; n++ }
      for (i = 1; i < n; i++) {
        tmp_n = names[i]; tmp_c = counts[i]; j = i - 1
        while (j >= 0 && counts[j] < tmp_c) {
          names[j+1] = names[j]; counts[j+1] = counts[j]; j--
        }
        names[j+1] = tmp_n; counts[j+1] = tmp_c
      }
      limit = (n < 15 ? n : 15)
      for (i = 0; i < limit; i++) {
        nm = names[i]
        avg = int(name_rssi[nm] / name_n[nm])
        if (i > 0) printf " "
        printf "%s(%d,avg%ddBm)", nm, counts[i], avg
      }
    }
  ' "$PRES_LOG" 2>/dev/null)
fi

# --- New unknown devices today (MACs with no name, first appearance) ---
new_unknown=""
if [ -f "$PRES_LOG" ]; then
  new_unknown=$(awk -v today="$TODAY" '
    {
      s = $0; ts = substr(s, 1, 19)
      p1 = index(s, "devices=["); p2 = index(s, "closest=[")
      if (p1) d = substr(s, p1 + 9)
      else if (p2) d = substr(s, p2 + 8)
      else next
      sub(/\][^\]]*$/, "", d)  # strip LAST ] + post-] attribution tail (see top_devices block)
      gsub(/[\[\]]/, "", d)
      gsub(/-[0-9]+\|/, "\n&", d)
      gsub(/^\n/, "", d)
      day = substr(ts, 1, 10)
      n = split(d, entries, "\n")
      for (i = 1; i <= n; i++) {
        split(entries[i], p, "|")
        if (length(p) < 3) continue
        c = substr(entries[i], 1, 1)
        if (c != "-") continue
        mac = p[2]; nm = p[3]
        gsub(/^[ \t]+|[ \t]+$/, "", nm)
        if (nm != "?" && nm != "" && length(nm) >= 2) { named[mac] = 1; continue }  # BUG-FIX: was next (skips rest of the scan line once any named device is seen, undercounting new_unknown); continue = next entry, the intent
        if (day == today) today_macs[mac] = 1
        else past_macs[mac] = 1
      }
    }
    END {
      c = 0
      for (mac in today_macs) {
        if (!past_macs[mac] && !named[mac]) { c++; new[mac] = 1 }
      }
      if (c > 0) {
        printf "%d new MAC(s): ", c
        n = 0
        for (mac in new) { if (n > 0) printf ","; printf "%s", mac; n++; if (n >= 5) break }
      }
    }
  ' "$PRES_LOG" 2>/dev/null)
fi

# --- Anomalies ---
anomalies=""
if [ -f "$SENS_LOG" ]; then
  cpu_high=$(awk -v d="$TODAY" '
    $0 ~ "cpu_temp" && substr($0,1,10)==d {
      split($0, a, " "); t = a[4]+0
      if (t > 80) { count++; if (t > max) max = t }
    }
    END { if (count > 0) printf "cpu_high=%d°C×%d", max, count }
  ' "$SENS_LOG" 2>/dev/null)
  [ -n "$cpu_high" ] && anomalies="${anomalies}${cpu_high} "

  room_fail=$(awk -v d="$TODAY" '
    $0 ~ "room_sense" && substr($0,1,10)==d {
      split($0, a, " ")
      if (a[4] == "EMPTY" || a[4] == "UNCERTAIN") count++
    }
    END { if (count > 0) printf "room_uncertain=%d", count }
  ' "$SENS_LOG" 2>/dev/null)
  [ -n "$room_fail" ] && anomalies="${anomalies}${room_fail} "

  # chat-review/home-digest-late-night-scope (2026-07-01): unlike SENS_LOG, HS_LOG carries no
  # per-line timestamp ("[home-state] ..." only — mesh-awaydigest:189 notes the same gap), so the
  # cpu_high/room_uncertain `substr($0,1,10)==d` date filter can't be mirrored here (it would match
  # zero lines forever, not scope-to-today). Instead bound to the writer's LIVE cron cadence —
  # DERIVED from the crontab (mesh-dash rs_stride_min idiom), never a hardcoded lines/day: the old
  # literal 96 assumed the documented 4-59/15 while the live reflex runs 4-59/5 = 288/day, so the
  # "daily" window was ~8h and phaedra sat at the saturated cap 96 six digests straight — a
  # constant, not an anomaly (chat-review/home-digest-late-night-counts-hourless-as-midnight).
  # MESH_HS_STRIDE_MIN overrides (also how --test pins the window); unparseable cron falls back to
  # the known live stride 5.
  hs_stride="${MESH_HS_STRIDE_MIN:-$(crontab -l 2>/dev/null | grep -m1 'mesh-home-state' | grep -oE '^[0-9*-]+/[0-9]+' | grep -oE '/[0-9]+$' | tr -d /)}"
  case "$hs_stride" in ''|*[!0-9]*|0) hs_stride=5 ;; esac
  late_active=$(tail -n "$(( 1440 / hs_stride ))" "$HS_LOG" 2>/dev/null | awk '
    {
      s = $0; p = index(s, "[home-state] "); if (!p) next
      s = substr(s, p + 13); q = index(s, ":"); if (!q) next
      state = substr(s, 1, q - 1)
      # NO hour= token = time UNKNOWN, never midnight: the unmatched gsub below leaves h_str as the
      # whole line and h_str+0 = 0, so every hour-less line used to pass h<6 and count as late-night
      # (live: all 60 of one whole-day count were daytime lines). Skip, never default.
      if (index(s, "hour=") == 0) next
      h_str = s
      gsub(/.*hour=/, "", h_str); gsub(/h .*/, "", h_str)
      h = h_str + 0
      if (h >= 0 && h < 6 && state != "QUIET_NIGHT" && state != "ASLEEP") count++
    }
    END { if (count > 0) printf "late_night_active=%d", count }
  ' 2>/dev/null)
  [ -n "$late_active" ] && anomalies="${anomalies}${late_active} "
fi

[ -z "$anomalies" ] && anomalies="none"

# --- Build summary ---
digest="home-digest $TODAY: rhythm=${rhythm:-no-data} | top_devices=${named_top:-none} | scans=$scan_today | new_unknown=${new_unknown:-none} | anomalies=$anomalies"

# --- Save artifact ---
mkdir -p "$DIGEST_DIR"
digest_file="$DIGEST_DIR/digest-${TODAY}.txt"
printf '%s\n' "$digest" > "$digest_file"

# --- JSON output ---
if [ "${1:-}" = --json ]; then
  printf '{"date":"%s","rhythm":"%s","top_devices":"%s","scans_today":%d,"new_unknown":"%s","anomalies":"%s","artifact":"%s"}\n' \
    "$TODAY" "$rhythm" "$named_top" "$scan_today" "$new_unknown" "$anomalies" "$digest_file"
  exit 0
fi

# --- Board post ---
MESH_WHO="digest@$(hostname)" ~/.local/bin/mesh-chat "[home-digest] $TODAY: rhythm=${rhythm:-no-data} | top_devices=${named_top:-none} | scans=$scan_today | new_unknown=${new_unknown:-none} | anomalies=$anomalies" 2>/dev/null

# --- TG push (optional) ---
if [ "${1:-}" = --TG ]; then
  mesh-tg "[home-digest] $TODAY

RHYTHM: ${rhythm:-no data}

TOP DEVICES: ${named_top:-none}

SCANS TODAY: $scan_today

ANOMALIES: $anomalies
NEW UNKNOWN: ${new_unknown:-none}" 2>/dev/null
fi

printf '%s\n' "$digest"
