#!/usr/bin/env bash
# mesh-therm — node thermal + power + load snapshot. Homeostasis sensor for the mesh.
# smoke-test: --test asserts a REAL temperature read (see the TWO TIERS note)
#
# Reads sysfs directly (no lm-sensors dependency). Outputs structured one-line or verbose.
#
#   mesh-therm              one-line compact summary
#   mesh-therm --verbose    per-zone detail (name + temp)
#   mesh-therm --response   report-only: each sensor's RESPONSE to the node's own load (g(m))
#   mesh-therm --test       smoke test (0 = real read · 2 = no thermal organ here · 1 = broken)
#
# Exit 0 unless critical temp exceeded (configurable via MESH_THERM_CRIT, default 90°C).
#
# TWO TIERS — thermal_zone AND hwmon (2026-07-15). This read ONLY /sys/class/thermal/thermal_zone*,
# which is an INTEL/ACPI-laptop assumption. AMD desktops expose no thermal_zone at all (mesh-home has
# only cooling_device*); their CPU temp lives in hwmon (k10temp). The loop therefore found zero zones,
# left max_temp at its `max_temp=0` initialiser, and printed "zones=[] max=0°C" — then `[ 0 -gt 90 ]`
# was false, so it exited **0, a success**. mesh-therm-watch greps that max, compares 0<88 and logs
# "therm: ok 0°C": 69/69 identical lines, an ALL-CLEAR rendered out of total blindness while k10temp
# read 50°C the whole time. It also pinned ~/.mesh/.therm-state to a structural OK — a declared
# consumer contract for 8 tools (mesh-stress, mesh-doctor, mesh-therm-regime, mesh-therm-ambient,
# mesh-cpu-throttle, mesh-patterns.sh, mesh-mind-keepalive), so this node's thermal axis could never
# report HOT and mind-keepalive's thermal shed could never fire — on the one node holding a 3060.
# Canonical f51e36d: a default indistinguishable from a success IS one. 0 is the worst possible
# sentinel for a temperature — it is a plausible READING, so nothing downstream can reject it.
#
# max is taken across ALL THREE tiers (unchanged semantics: max = the hottest sensor). Absent readings
# are now n/a, never 0: no organ ⇒ exit 2 (honest n/a — mesh-land passes, autowire skips), never a
# fabricated cold CPU. GPU (nvidia-smi) tier ADDED 2026-07-18 — the 3060 is the hottest part here and
# was invisible to the whole thermal-homeostasis lane (therm-watch/stress/situation); folded into max
# via the same read mesh-vram-watch uses, absent driver contributes nothing (never a faked cold GPU).
set -uo pipefail
CRIT="${MESH_THERM_CRIT:-90}"

# Env-overridable so --test can point the tiers at fixtures instead of the real sysfs tree.
ZONE_GLOB="${MESH_THERM_ZONE_GLOB:-/sys/class/thermal/thermal_zone*}"
HWMON_GLOB="${MESH_THERM_HWMON_GLOB:-/sys/class/hwmon/hwmon*}"
# GPU tier (2026-07-18) — the RTX 3060 is the HOTTEST silicon on this inference node, yet it lived
# in neither sysfs tier (it has no thermal_zone/hwmon temp entry), so max was read off a cool CPU
# while gigaam/ollama/whisper cooked the GPU past its ~83°C slowdown — the fusion understated
# thermal load by exactly the component the node's purpose is designed to stress. Read via the same
# nvidia-smi query mesh-vram-watch already uses (single source). Absent driver ⇒ contributes
# nothing (never a fabricated cold GPU — a plausible-but-fake reading is un-rejectable downstream,
# the f51e36d/max=0 trap). Override lets --test drive a stub or simulate an absent GPU (empty=off).
GPU_CMD="${MESH_THERM_GPU_CMD-nvidia-smi --query-gpu=temperature.gpu --format=csv,noheader,nounits}"

# read_temps → prints "label:millidegrees" per readable sensor, both tiers. Empty output = no organ.
read_temps(){
  local d ty mv h name f lbl
  for d in $ZONE_GLOB; do
    [ -r "$d/temp" ] && [ -r "$d/type" ] || continue
    ty="$(cat "$d/type" 2>/dev/null)"; [ -n "$ty" ] || continue
    mv="$(cat "$d/temp" 2>/dev/null)"; case "$mv" in ''|*[!0-9-]*) continue ;; esac
    printf '%s:%s\n' "$ty" "$mv"
  done
  for h in $HWMON_GLOB; do
    name="$(cat "$h/name" 2>/dev/null)"; [ -n "$name" ] || name=hwmon
    for f in "$h"/temp*_input; do
      [ -r "$f" ] || continue
      mv="$(cat "$f" 2>/dev/null)"; case "$mv" in ''|*[!0-9-]*) continue ;; esac
      lbl="$(cat "${f%_input}_label" 2>/dev/null)"
      printf '%s:%s\n' "$name${lbl:+/$lbl}" "$mv"
    done
  done
  # GPU tier (nvidia-smi, °C → millidegrees). Absent binary or unparseable read ⇒ emit NOTHING,
  # so the node falls to its CPU/nvme sensors rather than a faked cold GPU.
  local g gtemp
  if [ -n "$GPU_CMD" ] && command -v "${GPU_CMD%% *}" >/dev/null 2>&1; then
    g="$($GPU_CMD 2>/dev/null | head -1 | tr -d '[:space:]')"
    case "$g" in ''|*[!0-9-]*) : ;; *) gtemp=$((g*1000)); printf 'gpu:%s\n' "$gtemp" ;; esac
  fi
}

# --- test mode ---
if [ "${1:-}" = --test ]; then
  command -v hostname >/dev/null 2>&1 || { echo "smoke-test: FAIL (no hostname)"; exit 1; }
  command -v cat >/dev/null 2>&1 || { echo "smoke-test: FAIL (no cat)"; exit 1; }
  command -v awk >/dev/null 2>&1 || { echo "smoke-test: FAIL (no awk)"; exit 1; }
  command -v free >/dev/null 2>&1 || { echo "smoke-test: FAIL (no free)"; exit 1; }
  free -b | awk '/^Mem:/{ok=1} END{exit ok?0:1}' || { echo "smoke-test: FAIL (no mem telemetry)"; exit 1; }

  # NB fixtures (a)-(d): MESH_THERM_GPU_CMD="" DISABLES the GPU tier. Without it, THIS node's real
  # nvidia-smi (the 3060) leaks into every fixture — fixture (a)'s "no organ" would pick up a live
  # GPU temp and never reach rc=2. A fixture must isolate the ONE tier it asserts.

  # (a) FIXTURE: no sensor on any tier ⇒ max=n/a + rc=2, and NEVER the string "max=0". This is the
  # regression that let "ok 0°C" exist for 69 straight runs — assert the sentinel is gone, not just
  # that the code path runs.
  _t="$(mktemp -d)"; trap 'rm -rf "$_t"' EXIT
  out="$(MESH_THERM_ZONE_GLOB="$_t/nozone*" MESH_THERM_HWMON_GLOB="$_t/nohw*" MESH_THERM_GPU_CMD="" "$0")"; rc=$?
  [ "$rc" = 2 ] || { echo "smoke-test: FAIL (no organ → want rc=2, got rc=$rc: $out)"; exit 1; }
  printf '%s' "$out" | grep -q 'max=n/a' || { echo "smoke-test: FAIL (no organ → want max=n/a, got: $out)"; exit 1; }
  printf '%s' "$out" | grep -q 'max=0'   && { echo "smoke-test: FAIL (no organ still renders max=0 — the fabricated-cold-CPU regression: $out)"; exit 1; }

  # (b) FIXTURE: hwmon-only node (the AMD/mesh-home shape — zero thermal_zone) is READ, not missed.
  mkdir -p "$_t/hwmon0"; echo k10temp > "$_t/hwmon0/name"; echo 50000 > "$_t/hwmon0/temp1_input"
  out="$(MESH_THERM_ZONE_GLOB="$_t/nozone*" MESH_THERM_HWMON_GLOB="$_t/hwmon*" MESH_THERM_GPU_CMD="" "$0")"; rc=$?
  [ "$rc" = 0 ] || { echo "smoke-test: FAIL (hwmon-only → want rc=0, got rc=$rc: $out)"; exit 1; }
  printf '%s' "$out" | grep -q 'max=50°C' || { echo "smoke-test: FAIL (hwmon tier not read: $out)"; exit 1; }
  printf '%s' "$out" | grep -q 'k10temp:50' || { echo "smoke-test: FAIL (hwmon sensor unlabelled: $out)"; exit 1; }

  # (c) FIXTURE: max spans BOTH sysfs tiers (hottest sensor wins regardless of which tier it came from)
  mkdir -p "$_t/tz0"; echo acpitz > "$_t/tz0/type"; echo 71000 > "$_t/tz0/temp"
  out="$(MESH_THERM_ZONE_GLOB="$_t/tz*" MESH_THERM_HWMON_GLOB="$_t/hwmon*" MESH_THERM_GPU_CMD="" "$0")"
  printf '%s' "$out" | grep -q 'max=71°C' || { echo "smoke-test: FAIL (cross-tier max: $out)"; exit 1; }

  # (d) FIXTURE: CRIT breach still exits 1 (the alarm path survived the refactor)
  echo 99000 > "$_t/hwmon0/temp1_input"
  MESH_THERM_ZONE_GLOB="$_t/nozone*" MESH_THERM_HWMON_GLOB="$_t/hwmon*" MESH_THERM_GPU_CMD="" "$0" >/dev/null; rc=$?
  [ "$rc" = 1 ] || { echo "smoke-test: FAIL (99°C > CRIT → want rc=1, got rc=$rc)"; exit 1; }

  # (f) FIXTURE: GPU tier feeds max. A stub returning 85 (hotter than the 50°C hwmon) must top max
  # AND surface a gpu: zone. This is the whole point of the fix — the hottest silicon reaches max.
  echo 50000 > "$_t/hwmon0/temp1_input"
  out="$(MESH_THERM_ZONE_GLOB="$_t/nozone*" MESH_THERM_HWMON_GLOB="$_t/hwmon*" MESH_THERM_GPU_CMD="echo 85" "$0")"
  printf '%s' "$out" | grep -q 'max=85°C' || { echo "smoke-test: FAIL (GPU tier not folded into max: $out)"; exit 1; }
  printf '%s' "$out" | grep -q 'gpu:85'   || { echo "smoke-test: FAIL (GPU zone absent from output: $out)"; exit 1; }

  # (g) FIXTURE: absent GPU driver contributes NOTHING (no faked cold GPU) — node falls to its CPU
  # sensor, no gpu: zone, no rc/parse damage. The silent-fallback guard: absent ≠ a cold reading.
  out="$(MESH_THERM_ZONE_GLOB="$_t/nozone*" MESH_THERM_HWMON_GLOB="$_t/hwmon*" MESH_THERM_GPU_CMD="" "$0")"; rc=$?
  [ "$rc" = 0 ] || { echo "smoke-test: FAIL (absent GPU → want rc=0 off CPU, got rc=$rc: $out)"; exit 1; }
  printf '%s' "$out" | grep -q 'gpu:' && { echo "smoke-test: FAIL (absent GPU still emitted a gpu: zone — fabricated reading: $out)"; exit 1; }
  printf '%s' "$out" | grep -q 'max=50°C' || { echo "smoke-test: FAIL (absent GPU should fall to CPU max=50: $out)"; exit 1; }

  # (h) FIXTURE: unparseable GPU read (driver present, garbage out) also emits nothing — not a 0.
  out="$(MESH_THERM_ZONE_GLOB="$_t/nozone*" MESH_THERM_HWMON_GLOB="$_t/hwmon*" MESH_THERM_GPU_CMD="echo N/A" "$0")"
  printf '%s' "$out" | grep -q 'gpu:' && { echo "smoke-test: FAIL (garbage GPU read emitted a gpu: zone: $out)"; exit 1; }

  # --- (r) --response: the sensorimotor-environment axis, driven end-to-end against FIXTURE logs.
  # These are FUNCTIONAL legs (they run "$0" --response, not a helper), because a pure-arithmetic
  # leg asserts the regression and not the wiring — the mesh-load-gate E9 lesson.
  _tr="$(mktemp -d)"
  # (r1) IDENTIFIABLE: cpu = 50 + 2*load EXACTLY, disk pinned at 45, max = cpu. A known slope is the
  # only way to prove the estimator; "it printed a number" is not an assertion.
  awk 'BEGIN{for(i=0;i<40;i++){l=0.5+i*0.2; c=50+2*l;
        printf "2026-08-04T00:00:00Z  h  zones=[cpu:%.1f,disk:45.0]  max=%d°C    load=%.2f  mem=10%%\n", c, int(c), l}}' > "$_tr/ok.log"
  out="$(MESH_THERM_LOG="$_tr/ok.log" "$0" --response)"; rc=$?
  [ "$rc" = 0 ] || { echo "smoke-test: FAIL (--response rc=$rc on a valid log)"; rm -rf "$_tr"; exit 1; }
  printf '%s\n' "$out" | grep -qE '1:cpu +slope= *\+2\.000 °C/load +r=\+1\.000' \
    || { echo "smoke-test: FAIL (--response missed the KNOWN slope +2.000/r+1.000 for cpu: $out)"; rm -rf "$_tr"; exit 1; }
  printf '%s\n' "$out" | grep -qE '2:disk .*FLAT — never moved' \
    || { echo "smoke-test: FAIL (--response did not report the constant sensor as FLAT — a never-moving channel must be NAMED, not rendered as slope 0: $out)"; rm -rf "$_tr"; exit 1; }
  printf '%s\n' "$out" | grep -q 'best-coupled sensor: 1:cpu' \
    || { echo "smoke-test: FAIL (--response picked the wrong best-coupled sensor: $out)"; rm -rf "$_tr"; exit 1; }
  printf '%s\n' "$out" | grep -q 'DECOUPLED' \
    && { echo "smoke-test: FAIL (--response flagged DECOUPLED when max IS the coupled channel — false alarm arm: $out)"; rm -rf "$_tr"; exit 1; }
  # (r2) THE LOAD-BEARING LEG — narrow habitat. Same sensor variation, but the MOTOR variable never
  # moves: g(m) is not identifiable and the tool must SAY SO, never print a coefficient fitted to a
  # constant regressor. Deleting this gate is precisely the univariate blindness the axis removes.
  awk 'BEGIN{for(i=0;i<40;i++){printf "2026-08-04T00:00:00Z  h  zones=[cpu:%.1f,disk:45.0]  max=%d°C    load=1.50  mem=10%%\n", 50+i*0.3, int(50+i*0.3)}}' > "$_tr/narrow.log"
  out="$(MESH_THERM_LOG="$_tr/narrow.log" "$0" --response)"
  printf '%s\n' "$out" | grep -q 'UNIDENTIFIED — load support span' \
    || { echo "smoke-test: FAIL (--response fitted a slope to a CONSTANT load — the habitat-support gate is gone: $out)"; rm -rf "$_tr"; exit 1; }
  printf '%s\n' "$out" | grep -q 'slope=' \
    && { echo "smoke-test: FAIL (--response printed a coefficient despite an unidentifiable window: $out)"; rm -rf "$_tr"; exit 1; }
  # (r3) too few samples → UNIDENTIFIED, not a 5-point regression
  head -5 "$_tr/ok.log" > "$_tr/short.log"
  MESH_THERM_LOG="$_tr/short.log" "$0" --response | grep -q 'UNIDENTIFIED — 5 sample' \
    || { echo "smoke-test: FAIL (--response did not refuse a 5-sample window)"; rm -rf "$_tr"; exit 1; }
  # (r4) no history at all ⇒ honest n/a (rc=2), never a fabricated response
  MESH_THERM_LOG="$_tr/does-not-exist.log" "$0" --response >/dev/null 2>&1; rc=$?
  [ "$rc" = 2 ] || { echo "smoke-test: FAIL (--response on a missing log → want rc=2, got rc=$rc)"; rm -rf "$_tr"; exit 1; }
  # (r5) THE DECOUPLING ALARM, positive arm: max is pinned by a HOT sensor that ignores load while a
  # cooler sensor tracks it perfectly — this node's live shape (nvme pins max, k10temp does the work).
  # A gate whose alarm arm is never exercised is not a gate.
  awk 'BEGIN{for(i=0;i<40;i++){l=0.5+i*0.2; c=40+2*l; d=70+(i%2);
        printf "2026-08-04T00:00:00Z  h  zones=[cpu:%.1f,disk:%.1f]  max=%d°C    load=%.2f  mem=10%%\n", c, d, int(d), l}}' > "$_tr/decoupled.log"
  out="$(MESH_THERM_LOG="$_tr/decoupled.log" "$0" --response)"
  printf '%s\n' "$out" | grep -q 'WARN guarded channel DECOUPLED' \
    || { echo "smoke-test: FAIL (--response missed a guarded channel decoupled from the node's own load: $out)"; rm -rf "$_tr"; exit 1; }
  rm -rf "$_tr"

  # (e) REAL READ — the gate that matters. The fixtures above only prove the parser; THIS asserts this
  # node's actual silicon yields a plausible temperature. A thermal sensor reading exactly 0°C is not a
  # cold CPU, it is a blind one (>0 and <150 = a real reading). Honest n/a (rc=2, no organ anywhere) is
  # NOT a failure: mesh-land passes 2 and autowire skips it, so a genuinely sensorless node lands clean
  # without this gate ever fabricating a pass.
  out="$("$0")"; rc=$?
  if [ "$rc" = 2 ]; then
    echo "smoke-test: n/a — no thermal organ on $(hostname) (no readable thermal_zone* or hwmon temp*_input). Parser fixtures (a)-(d) passed."
    exit 2
  fi
  m="$(printf '%s' "$out" | grep -oE 'max=[0-9]+' | head -1 | cut -d= -f2)"
  [ -n "$m" ] || { echo "smoke-test: FAIL (live read has no parseable max=: $out)"; exit 1; }
  [ "$m" -gt 0 ] && [ "$m" -lt 150 ] \
    || { echo "smoke-test: FAIL (live max=${m}°C is not a plausible temperature — sensor is BLIND, not cold: $out)"; exit 1; }
  # GPU real-read gate: where nvidia-smi is present (this node's whole purpose), the GPU MUST appear
  # in the live zones — else the fusion is silently back to CPU-only. Absent driver = honest n/a for
  # the GPU tier only, never a failure (the node still has CPU/nvme sensors).
  gpu_bin="${GPU_CMD%% *}"
  if [ -n "$GPU_CMD" ] && command -v "$gpu_bin" >/dev/null 2>&1; then
    printf '%s' "$out" | grep -q 'gpu:' \
      || { echo "smoke-test: FAIL ($gpu_bin present but no gpu: zone in live read — GPU tier not fused: $out)"; exit 1; }
    echo "smoke-test: ok (live max=${m}°C across $(read_temps | wc -l) sensor(s), GPU tier LIVE)"; exit 0
  fi
  echo "smoke-test: ok (live max=${m}°C across $(read_temps | wc -l) sensor(s), no GPU here)"; exit 0
fi

# --- --response: the node's SENSORIMOTOR ENVIRONMENT, g(m) -------------------------------------
# (literature 2026-08-04, enactivism/4E: Buhrmann, Di Paolo & Barandiaran, "A dynamical systems
# account of sensorimotor contingencies", Front. Psychol. 4:285, doi:10.3389/fpsyg.2013.00285.
# They define the sensorimotor ENVIRONMENT as "the set of sensory states as a function of motor
# variations independently of the agent's internal dynamics" — s = g(m), the motor variable taken
# as INDEPENDENT — and distinguish it from the sensorimotor HABITAT, "the set of possible
# sensorimotor trajectories traveled by a closed-loop agent". Live restatement: arXiv:2510.14227.)
#
# WHY THIS EXISTS. Every thermal reading the mesh takes is UNIVARIATE on s: mesh-therm-watch/
# mesh-stress/mesh-therm-regime threshold on absolute °C, mesh-lease reports FLATLINE, mesh-precision
# reports FROZEN. All of them ask "is the sensor alive / how hot is it". NONE asks the bivariate
# question — does this sensor MOVE WITH THE WORK THIS NODE DOES. A sensor can be alive, jittering,
# and precision-weighted, and still be decoupled from the agent's own action; the guard then watches
# a channel its own compute cannot move. That is the exact shape mesh-therm's own header records at
# the top of this file (a plausible reading that no consumer can reject), one level up: not a fake
# value, a REAL value on the wrong channel.
#
# DATA-FRUGAL: nothing new is measured. ~/.mesh/therm.log already carries the motor variable and the
# sensory variables on the SAME line (`load=` and `zones=[...]`, written by this very tool), so the
# pairing is free. Report-only, exit 0, no state written, no reflex touched.
#
# HONEST ABOUT ITS OWN LIMIT (this is the paper's point, made structural): the log is CLOSED-LOOP
# data — `load` is what the mesh HAPPENED to do, not a commanded sweep. So this estimates g only
# over the HABITAT actually traveled. When that habitat is narrow (the loadavg barely varied in the
# window) the slope is NOT IDENTIFIABLE, and we say UNIDENTIFIED rather than print a number derived
# from no variation. A regression fitted to a constant motor variable is the univariate blindness
# this axis exists to remove, wearing a coefficient.
if [ "${1:-}" = --response ]; then
  LOG="${MESH_THERM_LOG:-$HOME/.mesh/therm.log}"
  [ -r "$LOG" ] || { echo "mesh-therm --response: n/a — no readable thermal history at $LOG"; exit 2; }
  awk -v MINN="${MESH_THERM_RESPONSE_MIN_N:-24}" \
      -v MINSPAN="${MESH_THERM_RESPONSE_MIN_SPAN:-1.0}" \
      -v RATIO="${MESH_THERM_RESPONSE_DECOUPLED_RATIO:-0.5}" \
      -v SRC="$LOG" '
    # FLAT is decided on the EXACT min==max of the raw readings, never on a computed variance:
    # the streaming form SYY-SY^2/n cancels catastrophically for a constant sensor (nvme/Sensor 2
    # sat at 56.9 for 436 rows and came out as a tiny POSITIVE variance), which would print
    # "slope=+0.000 r=+0.000" — a measured response — where the truth is "this sensor never moved".
    # A degenerate channel must be NAMED, not rendered as a well-measured zero.
    function acc(k,x,y){ if(!(k in N)){ ORD[++NK]=k; YMIN[k]=y; YMAX[k]=y; XMIN[k]=x; XMAX[k]=x }
      N[k]++; SX[k]+=x; SY[k]+=y; SXX[k]+=x*x; SYY[k]+=y*y; SXY[k]+=x*y
      if(y<YMIN[k])YMIN[k]=y; if(y>YMAX[k])YMAX[k]=y
      if(x<XMIN[k])XMIN[k]=x; if(x>XMAX[k])XMAX[k]=x }
    {
      if (match($0,/load=[0-9.]+/)==0) next
      ld=substr($0,RSTART+5,RLENGTH-5)+0
      rows++; if(rows==1){lmin=ld;lmax=ld} else {if(ld<lmin)lmin=ld; if(ld>lmax)lmax=ld}
      if (match($0,/zones=\[[^]]*\]/)>0) {
        zb=substr($0,RSTART+7,RLENGTH-8)
        m=split(zb,parts,",")
        for(i=1;i<=m;i++){ p=parts[i]; q=0
          for(j=length(p);j>0;j--) if(substr(p,j,1)==":"){q=j;break}
          if(q==0) continue
          lab=substr(p,1,q-1); val=substr(p,q+1)
          if(val ~ /^-?[0-9]+(\.[0-9]+)?$/) acc(i ":" lab, ld, val+0)
        }
      }
      # the GUARDED channel: max= is what every downstream thermal consumer thresholds on.
      if (match($0,/max=[0-9]+/)>0) acc("max (guarded)", ld, substr($0,RSTART+4,RLENGTH-4)+0)
    }
    END{
      printf "=== thermal response g(m) — sensor vs this node'"'"'s OWN load ===\n"
      if (rows+0 < MINN+0) { printf "UNIDENTIFIED — %d sample(s) in %s, need >= %d\n", rows+0, SRC, MINN+0; exit 0 }
      span = lmax-lmin
      printf "window: n=%d rows  load %.2f..%.2f (span %.2f)  source %s\n", rows, lmin, lmax, span, SRC
      if (span < MINSPAN+0) {
        printf "UNIDENTIFIED — load support span %.2f < %.2f: the motor variable barely varied in this\n", span, MINSPAN+0
        printf "  window, so g(m) is not identifiable from it (habitat too narrow, not a flat response).\n"
        exit 0
      }
      best=""; bestr=0
      for(o=1;o<=NK;o++){ k=ORD[o]; n=N[k]
        if(n<MINN+0){ printf "  %-24s n=%-5d (too few samples)\n", k, n; continue }
        if(YMAX[k]<=YMIN[k]){ printf "  %-24s n=%-5d FLAT — never moved (value=%.1f)\n", k, n, SY[k]/n; continue }
        if(XMAX[k]-XMIN[k] < MINSPAN+0){ printf "  %-24s n=%-5d UNIDENTIFIED (load span %.2f on this sensor'"'"'s rows)\n", k, n, XMAX[k]-XMIN[k]; continue }
        sxx=SXX[k]-SX[k]*SX[k]/n; syy=SYY[k]-SY[k]*SY[k]/n; sxy=SXY[k]-SX[k]*SY[k]/n
        if(sxx<=0||syy<=0){ printf "  %-24s n=%-5d UNIDENTIFIED (degenerate spread)\n", k, n; continue }
        sl=sxy/sxx; r=sxy/sqrt(sxx*syy); if(r>1)r=1; if(r<-1)r=-1
        printf "  %-24s slope=%+7.3f °C/load  r=%+6.3f  n=%d\n", k, sl, r, n
        ar=(r<0?-r:r)
        if(k!="max (guarded)" && ar>bestr){ bestr=ar; best=k; bestslope=sl }
        if(k=="max (guarded)"){ maxr=ar; havemax=1 }
      }
      if(best!=""){ printf "best-coupled sensor: %s (|r|=%.3f, %+.3f °C per unit loadavg)\n", best, bestr, bestslope }
      # The decoupling flag is a RATIO WITHIN THIS DATA, not an invented absolute r: it asks whether
      # the channel the guards watch tracks the node'"'"'s work as well as the best channel available on
      # the same node in the same window. Self-calibrating, so it cannot rot into a dead constant.
      if(havemax && best!="" && maxr < RATIO*bestr){
        printf "WARN guarded channel DECOUPLED: max |r|=%.3f vs best |r|=%.3f (ratio %.2f < %.2f)\n", maxr, bestr, (bestr>0?maxr/bestr:0), RATIO+0
        printf "  — the variable the thermal guards threshold on responds to this node'"'"'s own compute\n"
        printf "    far less than %s does; compute-driven heating is largely invisible to them.\n", best
      }
    }' "$LOG"
  exit 0
fi

HOST="$(hostname)"

# --- collect (both tiers; max_temp stays EMPTY until a real read proves otherwise — never 0) ---
zone_list=(); max_temp=""
while IFS=: read -r ty mv; do
  [ -n "$ty" ] && [ -n "$mv" ] || continue
  d=$((mv/1000)); c=$((mv%1000))
  zone_list+=("${ty}:${d}.${c}")
  if [ -z "$max_temp" ] || [ "$d" -gt "$max_temp" ]; then max_temp=$d; fi
done <<< "$(read_temps)"

battery=""; load=""; mem=""
for d in /sys/class/power_supply/BAT*; do
  [ -d "$d" ] || continue; s="$(cat "$d/status" 2>/dev/null)"; p="$(cat "$d/capacity" 2>/dev/null)"
  [ -n "$p" ] && battery="bat=${p}%(${s})"; break
done
load="$(awk '{printf "load=%.2f", $1}' /proc/loadavg)"
mem="$(free -b | awk '/^Mem:/{printf "mem=%.0f%%", $3/$2*100}')"

if [ "${1:-}" = --verbose ]; then
  echo "=== mesh-therm @ $(date -u +%FT%TZ) — $HOST ==="
  echo "thermal:"; for z in "${zone_list[@]}"; do echo "  $z°C"; done
  echo "cooling: $(for d in /sys/class/thermal/cooling_device*/type; do [ -f "$d" ] && echo "$(cat "$d" 2>/dev/null):$(cat "${d%/type}/cur_state" 2>/dev/null)/$(cat "${d%/type}/max_state" 2>/dev/null)"; done 2>/dev/null | tr '\n' '; ')"
  [ -n "$battery" ] && echo "power: $battery"; echo "system: $load $mem"; echo "crit: ${CRIT}°C"
else
  zones_clean=""
  if [ "${#zone_list[@]}" -gt 0 ]; then
    zones_clean=$(printf '%s,' "${zone_list[@]}")
    zones_clean="${zones_clean%,}"
  fi
  echo "$(date -u +%FT%TZ)  $HOST  zones=[${zones_clean}]  max=${max_temp:-n/a}${max_temp:+°C}  $battery  $load  $mem"
fi

# No readable sensor on either tier ⇒ honest n/a (2). NOT 0/exit-0: consumers grep `max=[0-9]+`, so
# `max=n/a` fails their parse LOUDLY (therm-watch: "max-temp parse failed (not an alarm)") instead of
# passing silently as a cold CPU. An unreadable organ is not a cold one.
[ -n "$max_temp" ] || exit 2
[ "$max_temp" -gt "$CRIT" ] && exit 1 || exit 0
