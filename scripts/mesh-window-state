#!/usr/bin/env bash
# reflex-cadence: 2-59/5 * * * *
# reflex-args: --edge
# mesh-window-state — cross-sense fusion: ROOM MOTION / ALERT SUMMARY.
# Combines 4 security-relevant senses into a single "is the room in motion or alerted?"
# verdict the steward/operator can read at a glance.
#
# Inputs (all best-effort, each independently OFFLINE-able; 2+ missing → DEGRADED):
#   mesh-tamper       .tamper-state        recency=ACTIVE|RECENT|STALE|COLD|NEVER
#   mesh-presence     .presence-state      churn=new:N,gone:N (lines in last 25 scans)
#   mesh-wifi-motion  .wifi-motion-state   STILL|MOTION|UNCERTAIN
#   mesh-body-motion  .body-motion-state   [body-*] tag (recently transitioned?)
#
# No single sensor answers "is the room in motion or alerted right now?" — tamper says SIGNIFICANT_MOTION
# fired, presence says BLE devices came/went, wifi-motion says RSSI multipath changed, body-motion says
# the phone was handled. Each alone could be a flicker; only fused do you have confidence.
#
# Classification (FALSIFIABLE via --test, ordered by severity):
#   ALERT    tamper recency is ACTIVE/RECENT (event in last 30 min) OR body-motion in last 60s
#            → security concern, room was actively disturbed
#   MOTION   presence churn > 0 OR tamper STALE (event in last 2h) OR wifi-motion MOTION
#            → some activity in the recent window
#   QUIET    none of the above — all senses say "no recent event"
#   DEGRADED 2+ inputs unreachable — explicitly missing list, never a confident QUIET
#
# Honest-fusion: an UNREACHABLE input renders visibly distinct from a genuine QUIET:
#   QUIET    = "all 4 senses are healthy AND report no events" (the strong claim)
#   DEGRADED = "couldn't tell — light and ambient-clock are both missing" (the safety rail)
# A consumer reading the state file sees the missing list, never a silent all-clear.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes" 2>/dev/null || true

STATE="$HOME/.mesh/.window-state"
MESH="${MESH_DIR:-$HOME/.mesh}"
STALE_S=600

# stride_from_cronfield <minute-field> → the /N stride in minutes ('' if fixed-minute). Pure.
stride_from_cronfield() { printf '%s' "$1" | grep -oE '/[0-9]+$' | tr -d '/'; }

# mesh-wifi-motion has NO cron of its own — it runs as a CHILD of mesh-room-sense's cron line
# (2-59/15 → effective 15-min stride), so the flat STALE_S=600 gate false-OFFLINEd a LIVE sense on
# every window-state run landing >10min after the last room-sense fire (≥1 in 3 runs, plus the
# :02/:17/:32/:47 write race; found+reproduced 2026-07-03: wifi=OFFLINE at :32:01 vs UNCERTAIN at
# :34:05, same state content, age the only variable). Derive the bound from the live feeder stride
# ×2 (the 7a01b9b derived-threshold idiom, no literal to drift); fall back to mesh-wifi-motion's
# own STALE_LIMIT default (1800s) when the cron line isn't readable (non-cron env, tests).
wifi_stale_s() {
  local stride
  stride="$(stride_from_cronfield "$(crontab -l 2>/dev/null | grep -m1 -E '^[^#]*mesh-room-sense' | awk '{print $1}')")"
  if [ -n "$stride" ] && [ "$stride" -gt 0 ] 2>/dev/null; then echo $((stride * 60 * 2)); else echo 1800; fi
}
WIFI_STALE_S="${MESH_WINDOW_WIFI_STALE:-$(wifi_stale_s)}"

# read_tamper_recency <state> → echoes ACTIVE|RECENT|STALE|COLD|NEVER|OFFLINE
# mesh-tamper writes `<verdict>|<epoch>|<window>|<recency_label>|<events_24h>`.
# We extract field 4 (the recency label).
read_tamper_recency() {
  local f="$1" v now m
  [ -f "$f" ] || { echo "OFFLINE"; return; }
  now=$(date +%s); m=$(stat -c %Y "$f" 2>/dev/null || echo "$now")
  if [ $((now - m)) -gt "$STALE_S" ]; then echo "OFFLINE"; return; fi
  v="$(head -1 "$f" 2>/dev/null | awk -F'|' '{print $4}')"
  [ -n "$v" ] || { echo "OFFLINE"; return; }
  printf '%s' "$v"
}

# read_tamper_attrib <state> → echoes ATTRIBUTED|SUSPECT|AMBIGUOUS|UNKNOWN|NONE|OFFLINE (field 6,
# chat-review/window-state-alert-attrib-gate 2026-07-07). mesh-tamper@26f3677 added field 6
# last_attrib: `<verdict>|<epoch>|<window>|<recency_label>|<events_24h>|<last_attrib>`. A legacy
# 5-field state (pre-26f3677, or any reader that predates this field) has no field 6 → empty →
# UNKNOWN, which classify_window treats as fail-suspicious (keeps ALERT), never fail-quiet.
read_tamper_attrib() {
  local f="$1" v now m
  [ -f "$f" ] || { echo "OFFLINE"; return; }
  now=$(date +%s); m=$(stat -c %Y "$f" 2>/dev/null || echo "$now")
  if [ $((now - m)) -gt "$STALE_S" ]; then echo "OFFLINE"; return; fi
  v="$(head -1 "$f" 2>/dev/null | awk -F'|' '{print $6}')"
  [ -n "$v" ] || { echo "UNKNOWN"; return; }
  printf '%s' "$v"
}

# read_presence_churn <state> → echoes integer count of churn (new+gone from last 25 scans).
# Format: `churn=new:N,gone:N` (additive trailing field). Missing → 0.
read_presence_churn() {
  local f="$1" v now m
  [ -f "$f" ] || { echo "OFFLINE"; return; }
  now=$(date +%s); m=$(stat -c %Y "$f" 2>/dev/null || echo "$now")
  if [ $((now - m)) -gt "$STALE_S" ]; then echo "OFFLINE"; return; fi
  v="$(head -1 "$f" 2>/dev/null | grep -oE 'churn=new:[0-9]+,gone:[0-9]+')"
  [ -n "$v" ] || { echo "0"; return; }
  # Sum the new: and gone: integers
  printf '%s\n' "$v" | grep -oE '[0-9]+' | awk 'BEGIN{s=0} {s+=$1} END{print s}'
}

# read_wifi_motion <state> → echoes STILL|MOTION|UNCERTAIN|OFFLINE
# The state file is PIPE-delimited since the 2026-06-28 dwell enrichment (`STILL|dwell_s=..|...`, no
# whitespace) — the old `awk '{print $1}'` read the WHOLE line, matched nothing, and fell through to
# UNCERTAIN on EVERY run (found 2026-07-03: window-state's wifi input silently pinned UNCERTAIN for 5
# days → its wifi-MOTION path could never fire). Strip at the first '|' — the same back-compat read
# the room-sense / ambient-clock edge readers use; a legacy bare-label file parses identically.
read_wifi_motion() {
  local f="$1" v now m
  [ -f "$f" ] || { echo "OFFLINE"; return; }
  now=$(date +%s); m=$(stat -c %Y "$f" 2>/dev/null || echo "$now")
  # WIFI_STALE_S (feeder-cadence-derived), NOT the flat STALE_S — see the derivation comment above.
  if [ $((now - m)) -gt "$WIFI_STALE_S" ]; then echo "OFFLINE"; return; fi
  v="$(head -1 "$f" 2>/dev/null | cut -d'|' -f1 | awk '{print $1}')"
  case "$v" in
    STILL|MOTION|UNCERTAIN) printf '%s' "$v" ;;
    *) echo "UNCERTAIN" ;;
  esac
}

# read_body_motion <state> → echoes STILL|WALKING|HANDLING|OTHER|OFFLINE
# mesh-body-motion writes `<step>|<[body-*]>|<hyst>|<pending>|<dwell_s>|<changes_24h>`.
read_body_motion() {
  local f="$1" v now m tag
  [ -f "$f" ] || { echo "OFFLINE"; return; }
  now=$(date +%s); m=$(stat -c %Y "$f" 2>/dev/null || echo "$now")
  if [ $((now - m)) -gt "$STALE_S" ]; then echo "OFFLINE"; return; fi
  v="$(head -1 "$f" 2>/dev/null)"
  # mesh-body-motion's phone-unreachable branch (write_offline_state, ccc47..ccc21e1) writes the
  # OFFLINE token in the 6-field pipe schema (`|OFFLINE||||`, tag at field 2) — and it REWRITES that
  # line on every failed poll, so the mtime-staleness gate above never trips for a genuinely offline
  # phone. Recognize that literal token directly (mirrors mesh-body-motion's own convention), else it
  # falls through the bracket-tag grep below to OTHER and classify_window's body-motion DEGRADED gate
  # never fires when the phone IS offline. cut -f2 also matches a bare legacy `OFFLINE` line (no '|' →
  # cut echoes the whole field). (task chat-review/windowstate-offline-literal-not-bracket)
  case "$(printf '%s' "$v" | cut -d'|' -f2)" in OFFLINE) echo "OFFLINE"; return ;; esac
  tag="$(printf '%s' "$v" | grep -oE '\[body-[a-z]+\]' | head -1)"
  case "$tag" in
    '[body-still]') printf 'STILL' ;;
    '[body-walking]') printf 'WALKING' ;;
    '[body-handled]') printf 'HANDLING' ;;
    '[body-carried]') printf 'CARRIED' ;;
    '[body-covered]') printf 'COVERED' ;;
    *) echo "OTHER" ;;
  esac
}

# classify_window <tamper_recency> <churn> <wifi> <body> [attrib] → "LABEL|reason" — pure,
# offline-testable. attrib (field-6 last_attrib, optional — omitted/empty means a legacy 5-field
# tamper-state) only ever DOWNGRADES the tamper ALERT, never upgrades anything else.
classify_window() {
  local tamper="$1" churn="$2" wifi="$3" body="$4" attrib="${5:-}"
  local degraded=""
  [ "$tamper" = "OFFLINE" ] && degraded="${degraded}tamper,"
  [ "$churn" = "OFFLINE" ] && degraded="${degraded}presence,"
  [ "$wifi" = "OFFLINE" ] && degraded="${degraded}wifi-motion,"
  [ "$body" = "OFFLINE" ] && degraded="${degraded}body-motion,"
  degraded="${degraded%,}"
  local degen=0
  [ "$tamper" = "OFFLINE" ] && degen=$((degen+1))
  [ "$churn" = "OFFLINE" ] && degen=$((degen+1))
  [ "$wifi" = "OFFLINE" ] && degen=$((degen+1))
  [ "$body" = "OFFLINE" ] && degen=$((degen+1))
  if [ "$degen" -ge 2 ]; then
    echo "DEGRADED|missing: $degraded (too many senses unreachable for confident verdict)"
    return
  fi
  # ALERT: tamper recent OR body actively in motion (transitioned in last 60s)
  if [ "$tamper" = "ACTIVE" ] || [ "$tamper" = "RECENT" ]; then
    # chat-review/window-state-alert-attrib-gate: ATTRIBUTED (familiar person, per mesh-tamper's
    # own classify_event_attrib) downgrades to MOTION — a familiar pickup isn't a security concern.
    # SUSPECT/AMBIGUOUS/UNKNOWN/OFFLINE (incl. missing field-6 on a legacy 5-field state) all keep
    # ALERT unchanged — fail-suspicious, never fail-quiet on an unrecognized or absent attribution.
    if [ "$attrib" = "ATTRIBUTED" ]; then
      echo "MOTION|tamper=$tamper attrib=ATTRIBUTED (familiar handling)"
      return
    fi
    echo "ALERT|tamper=$tamper (event in last 30min — security concern)"
    return
  fi
  if [ "$body" = "WALKING" ] || [ "$body" = "HANDLING" ] || [ "$body" = "CARRIED" ] || [ "$body" = "COVERED" ]; then
    echo "ALERT|body=$body (body actively in motion)"
    return
  fi
  # MOTION: presence churn OR tamper STALE (event in last 2h) OR wifi motion
  if [ "$churn" -gt 0 ] 2>/dev/null; then
    echo "MOTION|churn=$churn (BLE devices came/went recently)"
    return
  fi
  if [ "$tamper" = "STALE" ]; then
    echo "MOTION|tamper=STALE (event in last 2h)"
    return
  fi
  if [ "$wifi" = "MOTION" ]; then
    echo "MOTION|wifi-motion=MOTION (RSSI multipath changing)"
    return
  fi
  # QUIET: no signals
  echo "QUIET|no recent activity on any sense (tamper=$tamper churn=$churn wifi=$wifi body=$body)"
}

# LITERATURE (2025-2026): post-praxeological / assemmethodology work on assemblages treats non-human
# participation as empirically observable and tracks the consequentiality of materials in situ. This
# helper names the participant that actually made the window verdict happen.
consequential_source() {
  local label="$1" reason="$2"
  case "$label|$reason" in
    ALERT\|tamper=*) echo "tamper" ;;
    ALERT\|body=*) echo "body" ;;
    MOTION\|churn=*) echo "presence" ;;
    MOTION\|tamper=*) echo "tamper" ;;
    MOTION\|wifi-motion=*) echo "wifi-motion" ;;
    DEGRADED\|*) echo "missing" ;;
    QUIET\|*) echo "none" ;;
    *) echo "unknown" ;;
  esac
}

if [ "${1:-}" = --test ]; then
  fail=0
  # ALERT: tamper ACTIVE
  r="$(classify_window ACTIVE 0 STILL STILL)"
  [ "$r" = "ALERT|tamper=ACTIVE (event in last 30min — security concern)" ] || { echo "  FAIL ALERT-tamper: got=$r"; fail=1; }
  # ALERT: tamper RECENT
  r="$(classify_window RECENT 0 STILL STILL)"
  echo "$r" | grep -q '^ALERT' || { echo "  FAIL ALERT-recent: got=$r"; fail=1; }
  # ALERT: body WALKING (takes priority)
  r="$(classify_window NEVER 0 STILL WALKING)"
  echo "$r" | grep -q '^ALERT' || { echo "  FAIL ALERT-walking: got=$r"; fail=1; }
  # ALERT: body HANDLED
  r="$(classify_window NEVER 0 STILL HANDLING)"
  echo "$r" | grep -q '^ALERT' || { echo "  FAIL ALERT-handling: got=$r"; fail=1; }
  # MOTION: churn>0
  r="$(classify_window NEVER 2 STILL STILL)"
  [ "$r" = "MOTION|churn=2 (BLE devices came/went recently)" ] || { echo "  FAIL MOTION-churn: got=$r"; fail=1; }
  # MOTION: tamper STALE
  r="$(classify_window STALE 0 STILL STILL)"
  echo "$r" | grep -q '^MOTION' || { echo "  FAIL MOTION-stale: got=$r"; fail=1; }
  # MOTION: wifi motion
  r="$(classify_window NEVER 0 MOTION STILL)"
  echo "$r" | grep -q '^MOTION' || { echo "  FAIL MOTION-wifi: got=$r"; fail=1; }
  # QUIET: nothing
  r="$(classify_window NEVER 0 STILL STILL)"
  [ "$r" = "QUIET|no recent activity on any sense (tamper=NEVER churn=0 wifi=STILL body=STILL)" ] || { echo "  FAIL QUIET: got=$r"; fail=1; }
  [ "$(consequential_source QUIET 'no recent activity on any sense (tamper=NEVER churn=0 wifi=STILL body=STILL)')" = "none" ] || { echo "  FAIL consequential_source quiet"; fail=1; }
  # DEGRADED: 2 OFFLINE
  r="$(classify_window OFFLINE OFFLINE STILL STILL)"
  echo "$r" | grep -q '^DEGRADED' || { echo "  FAIL DEGRADED 2-offline: got=$r"; fail=1; }
  echo "$r" | grep -q 'tamper' || { echo "  FAIL DEGRADED should list tamper: got=$r"; fail=1; }
  echo "$r" | grep -q 'presence' || { echo "  FAIL DEGRADED should list presence: got=$r"; fail=1; }
  # DEGRADED: 3 OFFLINE
  r="$(classify_window OFFLINE OFFLINE OFFLINE STILL)"
  echo "$r" | grep -q '^DEGRADED' || { echo "  FAIL DEGRADED 3-offline: got=$r"; fail=1; }
  # DEGRADED: all 4 OFFLINE
  r="$(classify_window OFFLINE OFFLINE OFFLINE OFFLINE)"
  echo "$r" | grep -q '^DEGRADED' || { echo "  FAIL DEGRADED 4-offline: got=$r"; fail=1; }
  # 1 missing (single) — should still allow confident verdict. Use ACTIVE tamper + body STILL — ALERT
  # fires on tamper alone (body STILL doesn't matter, the ALERT path is triggered by tamper recency).
  r="$(classify_window ACTIVE 0 STILL STILL)"
  [ "$r" = "ALERT|tamper=ACTIVE (event in last 30min — security concern)" ] || { echo "  FAIL 1-missing + tamper=ACTIVE: got=$r"; fail=1; }
  # NEVER tamper (no events) + quiet → QUIET
  r="$(classify_window NEVER 0 STILL OTHER)"
  [ "$r" = "QUIET|no recent activity on any sense (tamper=NEVER churn=0 wifi=STILL body=OTHER)" ] || { echo "  FAIL NEVER+OTHER: got=$r"; fail=1; }
  # Priority: ALERT (tamper) > MOTION (churn) — even with high churn
  r="$(classify_window ACTIVE 5 STILL STILL)"
  echo "$r" | grep -q '^ALERT' || { echo "  FAIL ALERT-priority-over-MOTION: got=$r"; fail=1; }
  # --- chat-review/window-state-alert-attrib-gate (2026-07-07): mesh-tamper@26f3677 added field-6
  # last_attrib. RECENT/ACTIVE + ATTRIBUTED (familiar person, mesh-tamper's own vocabulary) downgrades
  # to MOTION; everything else (SUSPECT/AMBIGUOUS/UNKNOWN/missing field-6 = legacy 5-field state)
  # keeps ALERT — fail-suspicious, never fail-quiet. Falsify: drop the attrib parse / the ATTRIBUTED
  # check in classify_window and the first two assertions below flip.
  r="$(classify_window RECENT 0 STILL STILL ATTRIBUTED)"
  [ "$r" = "MOTION|tamper=RECENT attrib=ATTRIBUTED (familiar handling)" ] || { echo "  FAIL RECENT+ATTRIBUTED should downgrade to MOTION: got=$r"; fail=1; }
  r="$(classify_window ACTIVE 0 STILL STILL ATTRIBUTED)"
  echo "$r" | grep -q '^MOTION' || { echo "  FAIL ACTIVE+ATTRIBUTED should downgrade to MOTION: got=$r"; fail=1; }
  r="$(classify_window RECENT 0 STILL STILL SUSPECT)"
  echo "$r" | grep -q '^ALERT' || { echo "  FAIL RECENT+SUSPECT must stay ALERT: got=$r"; fail=1; }
  r="$(classify_window RECENT 0 STILL STILL AMBIGUOUS)"
  echo "$r" | grep -q '^ALERT' || { echo "  FAIL RECENT+AMBIGUOUS must stay ALERT: got=$r"; fail=1; }
  r="$(classify_window RECENT 0 STILL STILL UNKNOWN)"
  echo "$r" | grep -q '^ALERT' || { echo "  FAIL RECENT+UNKNOWN must stay ALERT: got=$r"; fail=1; }
  # legacy 5-field state: no attrib arg passed at all (classify_window's own back-compat, not just
  # read_tamper_attrib's) — must still fail-suspicious to ALERT, never silently downgrade.
  r="$(classify_window RECENT 0 STILL STILL)"
  echo "$r" | grep -q '^ALERT' || { echo "  FAIL legacy 5-field RECENT (no attrib) must stay ALERT: got=$r"; fail=1; }
  # consequential_source must still attribute the downgraded MOTION verdict to tamper, not mislabel it
  [ "$(consequential_source MOTION 'tamper=RECENT attrib=ATTRIBUTED (familiar handling)')" = "tamper" ] \
    || { echo "  FAIL consequential_source should name tamper for the attrib-downgraded MOTION"; fail=1; }
  # read_tamper_attrib reader: 6-field state (field 6 present) vs legacy 5-field (no field 6 → UNKNOWN)
  _rat="$(mktemp -d)"
  printf 'SIGNIFICANT_MOTION|%s|30|RECENT|1|ATTRIBUTED\n' "$(date +%s)" > "$_rat/six"
  r="$(read_tamper_attrib "$_rat/six")"
  [ "$r" = "ATTRIBUTED" ] || { echo "  FAIL read_tamper_attrib 6-field: got=$r"; fail=1; rm -rf "$_rat"; }
  printf 'SIGNIFICANT_MOTION|%s|30|RECENT|1\n' "$(date +%s)" > "$_rat/five"
  r="$(read_tamper_attrib "$_rat/five")"
  [ "$r" = "UNKNOWN" ] || { echo "  FAIL read_tamper_attrib legacy 5-field should read UNKNOWN: got=$r"; fail=1; }
  r="$(read_tamper_attrib "$_rat/absent")"
  [ "$r" = "OFFLINE" ] || { echo "  FAIL read_tamper_attrib missing file should read OFFLINE: got=$r"; fail=1; }
  rm -rf "$_rat"
  # --- read_wifi_motion reader fixtures (regression: the readers had NO coverage, so the 2026-06-28
  # pipe-delimited state rewrite silently broke this one — whole-line match fell through to UNCERTAIN
  # on every run for 5 days. These flip if the '|' strip is removed.)
  _rt="$(mktemp -d)"; trap 'rm -rf "$_rt"' EXIT
  printf 'STILL|dwell_s=134|changes_24h=30\n' > "$_rt/piped"
  r="$(read_wifi_motion "$_rt/piped")"
  [ "$r" = "STILL" ] || { echo "  FAIL reader piped-STILL: got=$r"; fail=1; }
  printf 'MOTION|dwell_s=5|changes_24h=2|sub_changes_24h=1|sub_dwell_s=5\n' > "$_rt/piped2"
  r="$(read_wifi_motion "$_rt/piped2")"
  [ "$r" = "MOTION" ] || { echo "  FAIL reader piped-MOTION: got=$r"; fail=1; }
  printf 'MOTION\n' > "$_rt/bare"
  r="$(read_wifi_motion "$_rt/bare")"
  [ "$r" = "MOTION" ] || { echo "  FAIL reader legacy-bare: got=$r"; fail=1; }
  printf 'GARBAGE|x=1\n' > "$_rt/junk"
  r="$(read_wifi_motion "$_rt/junk")"
  [ "$r" = "UNCERTAIN" ] || { echo "  FAIL reader junk→UNCERTAIN: got=$r"; fail=1; }
  r="$(read_wifi_motion "$_rt/absent")"
  [ "$r" = "OFFLINE" ] || { echo "  FAIL reader missing→OFFLINE: got=$r"; fail=1; }
  # --- feeder-cadence staleness fixtures (regression: flat 600s gate vs the 15-min room-sense
  # feeder stride false-OFFLINEd a live sense — these flip if the gate reverts to STALE_S.)
  r="$(stride_from_cronfield '2-59/15')"
  [ "$r" = "15" ] || { echo "  FAIL stride 2-59/15: got=$r"; fail=1; }
  r="$(stride_from_cronfield '*/5')"
  [ "$r" = "5" ] || { echo "  FAIL stride */5: got=$r"; fail=1; }
  r="$(stride_from_cronfield '30')"
  [ -z "$r" ] || { echo "  FAIL stride fixed-minute should be empty: got=$r"; fail=1; }
  printf 'STILL|dwell_s=134|changes_24h=30\n' > "$_rt/aged"
  touch -d '@'"$(( $(date +%s) - 900 ))" "$_rt/aged"
  _save_wstale="$WIFI_STALE_S"
  WIFI_STALE_S=1800
  r="$(read_wifi_motion "$_rt/aged")"
  [ "$r" = "STILL" ] || { echo "  FAIL 900s-old within 1800s bound should parse: got=$r"; fail=1; }
  WIFI_STALE_S=600
  r="$(read_wifi_motion "$_rt/aged")"
  [ "$r" = "OFFLINE" ] || { echo "  FAIL 900s-old beyond 600s bound should OFFLINE: got=$r"; fail=1; }
  WIFI_STALE_S="$_save_wstale"
  # --- read_body_motion reader fixtures (regression: the reader had NO coverage, so mesh-body-motion's
  # ccc21e1 OFFLINE-schema change — the phone-unreachable branch now writes `|OFFLINE||||` (fresh mtime
  # every poll) instead of a bracket tag — silently fell through the bracket grep to OTHER, so
  # classify_window's body-motion DEGRADED gate never fired for a genuinely offline phone. These flip
  # if the field-2==OFFLINE check is removed.)
  _bm="$(mktemp -d)"
  printf '|OFFLINE||||\n' > "$_bm/offline"          # FRESH mtime — mtime-stale gate must NOT be what catches it
  r="$(read_body_motion "$_bm/offline")"
  [ "$r" = "OFFLINE" ] || { echo "  FAIL read_body_motion fresh |OFFLINE||||  must read OFFLINE not OTHER: got=$r"; fail=1; }
  printf 'OFFLINE\n' > "$_bm/bareoffline"           # legacy bare-OFFLINE line (no pipe)
  r="$(read_body_motion "$_bm/bareoffline")"
  [ "$r" = "OFFLINE" ] || { echo "  FAIL read_body_motion bare OFFLINE must read OFFLINE: got=$r"; fail=1; }
  # regression guard: live bracket-tag writes must be unaffected by the new OFFLINE short-circuit
  printf '4210|[body-still]|0||120|3\n' > "$_bm/still"
  r="$(read_body_motion "$_bm/still")"; [ "$r" = "STILL" ] || { echo "  FAIL read_body_motion STILL: got=$r"; fail=1; }
  printf '4211|[body-walking]|2||0|5\n' > "$_bm/walk"
  r="$(read_body_motion "$_bm/walk")"; [ "$r" = "WALKING" ] || { echo "  FAIL read_body_motion WALKING: got=$r"; fail=1; }
  printf '4211|[body-handled]|1||0|5\n' > "$_bm/hand"
  r="$(read_body_motion "$_bm/hand")"; [ "$r" = "HANDLING" ] || { echo "  FAIL read_body_motion HANDLING: got=$r"; fail=1; }
  printf '4211|[body-carried]|1||0|5\n' > "$_bm/carr"
  r="$(read_body_motion "$_bm/carr")"; [ "$r" = "CARRIED" ] || { echo "  FAIL read_body_motion CARRIED: got=$r"; fail=1; }
  printf '4211|[body-covered]|1||0|5\n' > "$_bm/cov"
  r="$(read_body_motion "$_bm/cov")"; [ "$r" = "COVERED" ] || { echo "  FAIL read_body_motion COVERED: got=$r"; fail=1; }
  r="$(read_body_motion "$_bm/absent")"; [ "$r" = "OFFLINE" ] || { echo "  FAIL read_body_motion missing→OFFLINE: got=$r"; fail=1; }
  # a real body-tag line held past STALE_S must still OFFLINE via the mtime gate (unchanged path)
  printf '4210|[body-still]|0||120|3\n' > "$_bm/stale"; touch -d '@'"$(( $(date +%s) - STALE_S - 60 ))" "$_bm/stale"
  r="$(read_body_motion "$_bm/stale")"; [ "$r" = "OFFLINE" ] || { echo "  FAIL read_body_motion stale-mtime→OFFLINE: got=$r"; fail=1; }
  rm -rf "$_bm"
  [ "$fail" = 1 ] && { echo "smoke-test: FAIL"; exit 1; }
  echo "  ok: classify (16 cases: ALERT×4, MOTION×3, QUIET×2, DEGRADED×4, 1-missing, NEVER+OTHER, ALERT-priority)"
  echo "  ok: tamper-attrib gate (10 cases: ATTRIBUTED×2 downgrade, SUSPECT/AMBIGUOUS/UNKNOWN/legacy-no-attrib×4 stay ALERT, consequential_source, read_tamper_attrib×3)"
  echo "  ok: read_wifi_motion (5 cases: piped×2, legacy-bare, junk, missing)"
  echo "  ok: read_body_motion (9 cases: fresh |OFFLINE||||, bare OFFLINE, STILL/WALKING/HANDLING/CARRIED/COVERED tags, missing, stale-mtime)"
  echo "  ok: feeder-cadence staleness (5 cases: stride×3, mtime-gate×2)"
  echo "smoke-test: ok (45 assertions: 16 fusion + 10 tamper-attrib + 5 wifi reader + 9 body reader + 5 cadence-staleness)"
  exit 0
fi

# --- Live read path ---
tamper="$(read_tamper_recency "$MESH/.tamper-state")"
attrib="$(read_tamper_attrib "$MESH/.tamper-state")"
churn="$(read_presence_churn "$MESH/.presence-state")"
wifi="$(read_wifi_motion "$MESH/.wifi-motion-state")"
body="$(read_body_motion "$MESH/.body-motion-state")"

result="$(classify_window "$tamper" "$churn" "$wifi" "$body" "$attrib")"
label="${result%%|*}"
reason="${result#*|}"
conseq="$(consequential_source "$label" "$reason")"

TS=$(date -u +%Y-%m-%dT%H:%M:%SZ)
# Write state + touch liveness on EVERY successful run (mtime = ran-live, content = value-changed)
printf '%s|tamper=%s|churn=%s|wifi=%s|body=%s|consequential=%s|%s\n' \
  "$label" "$tamper" "$churn" "$wifi" "$body" "$conseq" "$reason" > "$STATE"
mesh-state-touch "$STATE"

# --- Output ---
if [ "${1:-}" = --json ]; then
  printf '{"label":"%s","reason":"%s","consequential":"%s","inputs":{"tamper":"%s","churn":%s,"wifi":"%s","body":"%s"},"ts":"%s"}\n' \
    "$label" "$reason" "$conseq" "$tamper" "$churn" "$wifi" "$body" "$TS"
  exit 0
fi
if [ "${1:-}" = --edge ]; then
  prev=""; [ -f "$STATE" ] && read -r prev _ < "$STATE" 2>/dev/null || true
  prev_label="${prev%%|*}"
  [ "$prev_label" = "$label" ] && exit 0
  printf '[window-%s] %s — %s\n' "$(printf '%s' "$label" | tr '[:upper:]' '[:lower:]')" "$label" "$reason"
  exit 0
fi
printf '[window-%s] %s — %s (consequential=%s)\n' \
  "$(printf '%s' "$label" | tr '[:upper:]' '[:lower:]')" "$label" "$reason" "$conseq"
