#!/usr/bin/env bash
# reflex-cadence: */9 * * * *
# reflex-args: --edge
# doctor-artifact: $HOME/.mesh/.bt-link-state 1200
# umwelt-ok: edge reflex — the SENSE output flows to the board via [bt-connected]/[bt-none]/[bt-offline]
#   posts; .bt-link-state is the change-detection SIGNATURE consumed by mesh-audio-path.
# mesh-bt-link — compatibility entrypoint; local BlueZ adapter implementation lives in integrations/.
set -u

self="${BASH_SOURCE[0]}"
case "$self" in
  */*) ;;
  *) self="$(command -v "$self")" || exit 127 ;;
esac

# Resolve installed symlinks back to this repository before selecting the sibling source.
while [ -L "$self" ]; do
  self_dir="$(CDPATH= cd -P "$(dirname "$self")" && pwd)" || exit 1
  link_target="$(readlink "$self")" || exit 1
  case "$link_target" in
    /*) self="$link_target" ;;
    *) self="$self_dir/$link_target" ;;
  esac
done

script_dir="$(CDPATH= cd -P "$(dirname "$self")" && pwd)" || exit 1
implementation="$script_dir/integrations/mesh-bt-link"
if [ ! -x "$implementation" ]; then
  repo_root="${MESH_REPO:-${MESH_GENOME:-$HOME/lte-workstation}}"
  implementation="$repo_root/scripts/integrations/mesh-bt-link"
fi
[ -x "$implementation" ] || {
  printf 'mesh-bt-link: implementation missing or not executable: %s\n' "$implementation" >&2
  exit 127
}
exec "$implementation" "$@"
