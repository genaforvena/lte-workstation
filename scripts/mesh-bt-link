#!/usr/bin/env bash
# reflex-cadence: */9 * * * *
# reflex-args: --edge
# doctor-artifact: $HOME/.mesh/.bt-link-state 1200
# umwelt-ok: edge reflex — the SENSE output flows to the board via [bt-connected]/[bt-none]/[bt-offline]
#   posts; .bt-link-state is the change-detection SIGNATURE (verdict + sorted connected-MAC set) the
#   --edge diff reads (same shape as the doctor's own .doctor-*-state). Line 1 (the verdict) IS a
#   declared output since 2026-07-06: mesh-audio-path consumes it as its LINK axis ("is the BT audio
#   sink live?") to split SINK-DEAD-SUSPECT into link-drop vs mute — loop closed (was a board [task]).
#   Changing the verdict-line vocabulary breaks that reader: grep -rl bt-link scripts/ first.
#   ^ smoke-theater gate (mesh-doctor): .bt-link-state is rewritten on EVERY run — CONNECTED, NONE,
#     AND the OFFLINE (exit 2) path all write STATE before returning, so mtime = ran-live regardless
#     of whether the BT radio is up. No reach-gate: the controller is a fixed local adapter (unlike a
#     roaming phone), so a stale STATE despite the cron line ⟹ the reflex itself is dead → honest WARN.
#     STATE write is UNCONDITIONAL per run, so no mesh-state-touch is needed (that's only for the
#     change-gated subset; --edge here gates only the BOARD post, never the STATE write).
#
# mesh-bt-link — the node's OWN connected Bluetooth PERIPHERALS sense.
#
# WHY THIS IS NEW: the mesh already SCANS the BLE neighbourhood for advertising beacons
# (mesh-presence / mesh-room-sense / mesh-zonemap — "who is nearby") and reads the node's WiFi link
# (mesh-wifi-quality). Nothing reads the node's OWN actively-connected BT peripherals — a distinct
# signal the hardware exposes but no sense taps. A connected AUDIO sink (Bose/headset) means the
# room-audio actuator path (mesh-say/mesh-act/mesh-audio-path) is physically LIVE; a connected HEADSET
# means the operator is likely present + on private audio; a connected INPUT device (kbd/mouse) is a
# hands-on-the-node signal. This is the node's-own-connections complement to the beacon SCAN.
#
# HONEST CONTRACT (the whole point — an unreachable radio must NOT read as a faked all-clear):
#   OFFLINE (exit 2)  bluetoothctl absent | rfkill soft/hard-blocked | bluetoothd down | no controller
#                     | adapter Powered:no  → the sensor is UNREACHABLE; we cannot enumerate anything.
#   NONE   (exit 0)   controller UP + readable, genuinely 0 peripherals connected — a REAL empty,
#                     visibly DISTINCT from OFFLINE (that distinction is the honest-degrade requirement).
#   CONNECTED(exit 0) ≥1 peripheral connected, classified by device Icon (audio/input/display/phone/other).
#
#   mesh-bt-link            one-line verdict → stdout (writes STATE, no board post)
#   mesh-bt-link --json     machine-readable JSON
#   mesh-bt-link --edge     REFLEX: post [bt-connected]/[bt-none]/[bt-offline] to the board ONLY on a
#                           verdict/connected-set CHANGE (2-consecutive not needed — BT connect/disconnect
#                           is a discrete hardware event, not a noisy analog signal)
#   mesh-bt-link --exposure THIS node's OWN pairability posture (see EXPOSURE below)
#   mesh-bt-link --test     smoke test (classifier fixtures + live controller-read gate)
#   mesh-bt-link --forget   reset state (next run re-seeds silently)
#
# EXPOSURE — can an unknown device pair with THIS node right now (2026-08-04, discover→genome baton).
# The Bluetooth-transport twin of `mesh-socket-state --exposure`, which asks the same question of TCP/
# UDP: not "who is out there" but "what will WE answer". Five BT-touching tools and none of them asked
# it — `mesh-rfkill` sees radio on/off only (and does not distinguish "on and closed" from "on and open
# to pairing"), `mesh-bt-census` inquiry-scans OTHER devices, `mesh-presence` scans BLE advertisers,
# `mesh-imac-peripherals` reads ALREADY-paired links, `mesh-ble-heal` heals the scanning direction.
# This tool was the one place already parsing `bluetoothctl show` live — and extracted `Powered:` only.
# The fix is "stop discarding the fields we already read", not a new probe.
#
# HONEST CLASSES — read off the controller's own two flags, nothing inferred beyond them:
#   DISCOVERABLE  Powered:yes + Discoverable:yes — answerable to an INQUIRY SCAN by anyone in radio
#                 range, no prior knowledge of the MAC needed. The PUBLIC-class (wildcard-bind)
#                 equivalent. A DiscoverableTimeout of 0 means it NEVER expires — reported loudly,
#                 because the 180s default self-closes and a 0 does not.
#   PAIRABLE      Powered:yes + Discoverable:no + Pairable:yes — hidden from inquiry scan but STILL
#                 completes a pairing handshake with any peer that has (or guesses) the MAC. The
#                 BOUND-class equivalent: silent, not closed. This is the state the axis exists for —
#                 it looks shut from the outside and is not.
#   CLOSED        Powered:no (radio off ⇒ definitively cannot pair) OR Pairable:no.
#   UNKNOWN       controller readable but did not report Discoverable:/Pairable: — an absent field is
#                 never rendered as a closed door (honest-fusion rule).
#   OFFLINE(2)    bluetoothctl absent | rfkill-blocked | bluetoothd down | no controller — unreadable.
#                 NOTE the deliberate split from the peripheral sense above: there, Powered:no is
#                 OFFLINE (nothing can be enumerated); here it is a real, load-bearing CLOSED answer.
#
# Wiring: the exposure edge rides the EXISTING `--edge` reflex (one cron line per tool — a second
# cadence for the same name would not survive autowire), and is evaluated BEFORE the peripheral
# sense's OFFLINE early-exit, so a powered-down radio still posts its CLOSED verdict.
#
# THE ENUMERATION IS D-BUS TOO (2026-08-04, discover→health→genome baton) — BUT NOT FOR THE REASON
# THE TASK WAS FILED ON, AND THAT CORRECTION IS THE MORE IMPORTANT HALF OF THIS CHANGE.
#
# The filed premise: "this tool's */9 peripheral scan self-inflicts an ~8s PAIRABLE window every 9
# minutes, because bluetoothctl registers a default agent". MEASURED HERE AND FALSE. Sampling
# Adapter1.Pairable at 2.5Hz through 3 interleaved rounds, each invocation fired at a known offset:
#     control (nothing)                 0/16 true      bluetoothctl devices Connected   0/16 true
#     bluetoothctl show                 0/16 true      bluetoothctl info <MAC>          0/16 true
#     bare `bluetoothctl` (stdin held)  9/16 true  ← the only form that flips
# The agent is registered by an INTERACTIVE session, not by the binary. Every call this tool ever
# made passed a subcommand and exited, so it never opened a window at all. The earlier claim that a
# plain `mesh-bt-link` run flipped Pairable (2026-08-04 13:20Z) was CONTAMINATION: round 1 of this
# very experiment reproduced it — a foreign long-lived `bluetoothctl` was alive for all 16 samples of
# the CONTROL window too (16/16 true with nothing fired), which is what a contaminated read looks
# like from the inside. An A/B without a concurrent-process column cannot tell "my probe did this"
# from "something else was already holding it".
#
# THE REAL SOURCE, measured on a live run: `mesh-presence` (cron */10) scans by holding the pipe open
# — `{ echo "scan on"; sleep $WIN; } | bluetoothctl` at mesh-presence:1358 — which IS the interactive
# form. WIN=10, and Pairable measured true for 10.0s of that run, start to finish. `mesh-ble-heal`
# (*/15) uses the same shape. So the mesh does open recurring pairable windows; they belong to the
# BLE SCANNERS, and this tool is not one of them.
#
# WHY THE PORT LANDS ANYWAY — a smaller claim than the task's, and a true one: agent-freedom here was
# an ACCIDENT of argument style, one refactor to an interactive session away from being false, and
# nothing asserted it. It is now structural (org.bluez direct) and GATED (--test drives the whole
# enumeration with a poisoned `bluetoothctl` first on PATH and fails if anything calls it). The port
# also drops 3 subprocess spawns per run and removes the text-interface parse from the offline gate.
# Both reads now go through org.bluez directly: no agent is registered, nothing is mutated.
#   • object paths  ← `busctl tree org.bluez`               (dbus_device_paths)
#   • per-device    ← `busctl get-property … org.bluez.Device1` (device_block → parse_device_block)
#   • powered/up    ← read_posture (already D-Bus-first for the exposure leg — one reader, not two)
# `bluetoothctl` survives ONLY as the fallback for a node without busctl, and a fallback-sourced
# verdict says so out loud: the verdict line carries `[via bluetoothctl]`. Not because that run
# opened a pairable window (measured above: it does not) but because WHICH interface answered is a
# fact about the data — the text path cannot see PairableTimeout, cannot tell an unreadable object
# tree from an empty one, and is the path the no-agent gate does not cover.
#
# WHY NOT `busctl --json=short call … GetManagedObjects` (one call for everything, the obvious shape):
# measured here 2026-08-04 — it renders fine while bluez holds ZERO cached device objects (rc=0, 1782
# bytes) and fails rc=1 with an EMPTY STDERR the moment ANY device object exists (bluez device
# properties include `ManufacturerData a{qv}`, a dict with non-string keys, which systemd's JSON
# writer cannot express). Green on the empty node you develop against, silently dark on exactly the
# node whose peripherals you are trying to enumerate — so the whole-tree JSON call is unusable here,
# and its failure carries no message to tell you why. `busctl tree` + typed get-property does not
# serialise those properties at all, so it is unaffected.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

STATE_DIR="${MESH_STATE_DIR:-$HOME/.mesh}"
STATE="$STATE_DIR/.bt-link-state"
XSTATE="$STATE_DIR/.bt-exposure-state"
BTCTL_TIMEOUT=8

# classify_icon <icon-string> → audio|input|display|phone|other
# Maps the BlueZ device Icon (bluetoothctl `info` → "Icon:") to a coarse peripheral class. Factored out
# so --test can assert the mapping without a radio. Best-effort: an absent/unknown Icon → "other" (the
# count + names are the load-bearing signal; the class is a bonus lens for consumers).
classify_icon() {
  case "$1" in
    audio-*|*headset*|*headphone*|*speaker*) echo "audio" ;;
    input-*|*keyboard*|*mouse*|*gaming*)     echo "input" ;;
    video-*|*display*|*tv*)                  echo "display" ;;
    phone|*phone*)                           echo "phone" ;;
    *)                                       echo "other" ;;
  esac
}

# ---- exposure: THIS node's own pairability posture -----------------------------------------------
# show_text → the raw `bluetoothctl show` output. MESH_BT_SHOW redirects it at a FIXTURE FILE so the
# --test exposure legs drive the REAL parse+classify+edge path end-to-end (a pointed-at file that does
# not exist yields empty ⇒ the OFFLINE branch, which is itself an asserted leg).
show_text() {
  if [ -n "${MESH_BT_SHOW:-}" ]; then
    [ -f "$MESH_BT_SHOW" ] && cat "$MESH_BT_SHOW"
    return 0
  fi
  command -v bluetoothctl >/dev/null 2>&1 || return 0
  timeout "$BTCTL_TIMEOUT" bluetoothctl show 2>/dev/null
}

# read_posture → "powered|discoverable|pairable|disc_timeout|pair_timeout|discovering|source",
# empty on unreadable.
#
# `discovering` is the ATTRIBUTION field (added 2026-08-04 after the enumeration port measured where
# the mesh's pairable windows actually come from). A BLE scan holds an interactive `bluetoothctl`
# open, that registers a default agent, and bluez flips Pairable true for the scan's whole duration
# — so this node goes PAIRABLE for ~10s every 10 minutes because of `mesh-presence`, and again on
# `mesh-ble-heal`'s cadence. Measured here, 40 consecutive 0.4s samples across a scan start and a
# scan end: Pairable and Discovering were IDENTICAL in every sample, never once mixed.
# Without the field, this axis flaps PAIRABLE↔CLOSED on the board a few times a day with no
# attributable cause, and each flap reads exactly like a node that has been left open. WITH it, a
# scan-coincident PAIRABLE says so in its own detail. It is an attribution, NOT a suppression: the
# node really IS pairable during that window and the verdict still says PAIRABLE.
# The inverse is deliberately NOT claimed — Discovering:no + Pairable:yes is reported as a standing
# posture because nothing here has shown another way to hold the window open, not because it is
# proven there is none.
#
# D-BUS FIRST, `bluetoothctl show` as the fallback. Two reasons, both measured 2026-08-04:
#   1. bluez exposes `PairableTimeout` on org.bluez.Adapter1 and `bluetoothctl show` NEVER PRINTS IT.
#      That field is the difference between a pairable window that self-closes and one that does not
#      (live here: 0 = never expires) — on the PAIRABLE class it is the load-bearing half of the
#      verdict, and the text interface simply does not carry it.
#   2. A PROBE CAN MUTATE WHAT IT MEASURES — but only ONE probe shape does, and the 2026-08-04 13:20Z
#      version of this note named the wrong one. CORRECTED by a 3-round interleaved re-measurement
#      with a concurrent-`bluetoothctl` column (see the ENUMERATION block in the header): a
#      bluetoothctl invoked WITH A SUBCOMMAND — `show`, `devices Connected`, `info <MAC>` — never
#      flips Pairable (0/16 true, each form, twice). A bare `bluetoothctl` holding stdin open does
#      (9/16, for exactly the pipe's lifetime), because THAT is what registers the default agent.
#      The original "one `bluetoothctl show` → true ×8" reading was contaminated: a foreign
#      long-lived interactive bluetoothctl was already holding the property true, which the re-run
#      caught red-handed by showing 16/16 true in a CONTROL window with nothing fired. An A/B that
#      does not record what ELSE was touching the measurand cannot attribute the change to the probe.
#      D-Bus stays the primary read regardless — reason 1 alone decides it, and busctl is the only
#      shape that is agent-free BY CONSTRUCTION rather than by argument style.
read_posture() {
  if [ -n "${MESH_BT_POSTURE:-}" ]; then
    [ -f "$MESH_BT_POSTURE" ] && cat "$MESH_BT_POSTURE"
    return 0
  fi
  local pw disc pair pto
  if [ -z "${MESH_BT_SHOW:-}" ] && command -v busctl >/dev/null 2>&1; then
    _prop() { # <name> → the scalar value, empty if unreadable
      timeout "$BTCTL_TIMEOUT" busctl get-property org.bluez /org/bluez/hci0 \
        org.bluez.Adapter1 "$1" 2>/dev/null | awk '{print $2}'
    }
    pw="$(_prop Powered)"; disc="$(_prop Discoverable)"; pair="$(_prop Pairable)"
    if [ -n "$pw" ] && [ -n "$disc" ] && [ -n "$pair" ]; then
      _yn() { case "$1" in true) echo yes ;; false) echo no ;; *) echo "" ;; esac; }
      printf '%s|%s|%s|%s|%s|%s|dbus\n' "$(_yn "$pw")" "$(_yn "$disc")" "$(_yn "$pair")" \
        "$(_prop DiscoverableTimeout)" "$(_prop PairableTimeout)" "$(_yn "$(_prop Discovering)")"
      return 0
    fi
  fi
  # fallback: parse the text interface (no PairableTimeout there — reported as unknown, not as 0).
  # `Discovering:` IS printed by `bluetoothctl show`, so the attribution field survives the fallback.
  local show; show="$(show_text)"
  [ -n "$show" ] || return 0
  printf '%s' "$show" | grep -qiE '^[[:space:]]*Controller|Powered:' || return 0
  printf '%s|%s|%s|%s||%s|bluetoothctl\n' \
    "$(show_field "$show" Powered)" "$(show_field "$show" Discoverable)" \
    "$(show_field "$show" Pairable)" "$(discoverable_timeout_secs "$show")" \
    "$(show_field "$show" Discovering)"
}

# show_field <show-text> <field> → the field's value, or empty if the controller did not report it.
# Anchored with a literal ':' so `Discoverable` never swallows `DiscoverableTimeout`.
show_field() {
  printf '%s\n' "$1" | sed -n "s/^[[:space:]]*$2:[[:space:]]*//p" | head -1
}

# discoverable_timeout_secs <show-text> → the DECIMAL timeout, or empty. bluez prints
# "DiscoverableTimeout: 0x000000b4 (180)" — the parenthesised decimal is the readable one.
discoverable_timeout_secs() {
  local raw; raw="$(show_field "$1" DiscoverableTimeout)"
  case "$raw" in
    *\(*\)*) printf '%s' "$raw" | sed -n 's/.*(\([0-9]\+\)).*/\1/p' ;;
    0x*)     printf '%d' "$raw" 2>/dev/null ;;
    [0-9]*)  printf '%s' "${raw%% *}" ;;
  esac
}

# exposure_offline_reason → reason if the POSTURE is unreadable, else empty.
# Powered:no is deliberately NOT a reason here — it is a real CLOSED verdict (see header).
exposure_offline_reason() {
  local posture="$1"
  if [ -z "${MESH_BT_SHOW:-}${MESH_BT_POSTURE:-}" ]; then
    command -v busctl >/dev/null 2>&1 || command -v bluetoothctl >/dev/null 2>&1 \
      || { echo "neither busctl nor bluetoothctl installed"; return; }
    if command -v rfkill >/dev/null 2>&1 \
       && rfkill list bluetooth 2>/dev/null | grep -qi 'blocked: *yes'; then
      echo "rfkill-blocked (radio off)"; return
    fi
  fi
  [ -n "$posture" ] || { echo "bluetoothd down / no controller (adapter properties unreadable)"; return; }
}

# fmt_timeout <secs> <field-name> → human phrasing. 0 is the loud one: the window never self-closes.
fmt_timeout() {
  case "$1" in
    0)  echo "$2 NEVER EXPIRES (0)" ;;
    "") echo "$2 unreported" ;;
    *)  echo "$2 ${1}s" ;;
  esac
}

# scan_note <discovering> → the attribution clause for an OPEN window, or empty.
# Named separately so the two open classes cannot drift apart on it (both must carry it, or neither).
scan_note() {
  [ "${1:-}" = "yes" ] || return 0
  printf ' — SELF-INFLICTED: a local BLE scan is in flight (Discovering:yes), which holds an interactive bluetoothctl open and with it this window; it closes when the scan does'
}

# classify_exposure <powered> <discoverable> <pairable> <disc-timeout> <pair-timeout> [discovering]
#   → "CLASS|detail". Pure — --test drives it on fixtures and the live path drives the same function.
classify_exposure() {
  local pw="$1" disc="$2" pair="$3" dto="$4" pto="${5:-}" scan="${6:-}"
  if [ "$pw" = "no" ]; then
    echo "CLOSED|radio powered off — cannot pair (Powered:no)"; return
  fi
  # an absent flag must never render as a closed door
  if [ -z "$pw" ] || [ -z "$disc" ] || [ -z "$pair" ]; then
    echo "UNKNOWN|controller readable but did not report Powered/Discoverable/Pairable (powered='$pw' discoverable='$disc' pairable='$pair')"
    return
  fi
  if [ "$disc" = "yes" ]; then
    if [ "$pair" = "yes" ]; then
      echo "DISCOVERABLE|answerable to an INQUIRY SCAN and pairable — $(fmt_timeout "$dto" discoverable-for), $(fmt_timeout "$pto" pairable-for)$(scan_note "$scan")"
    else
      echo "DISCOVERABLE|visible to an INQUIRY SCAN, but Pairable:no — $(fmt_timeout "$dto" discoverable-for)$(scan_note "$scan")"
    fi
    return
  fi
  if [ "$pair" = "yes" ]; then
    echo "PAIRABLE|hidden from inquiry scan but answers a DIRECTED pair request (Discoverable:no Pairable:yes) — $(fmt_timeout "$pto" pairable-for)$(scan_note "$scan")"
    return
  fi
  echo "CLOSED|powered but refuses pairing (Discoverable:no Pairable:no)"
}

# exposure_run <edge?> → print (or, with edge=1, post-on-change) the posture verdict.
# Returns 2 when the posture is UNREADABLE (honest n/a), 0 otherwise — including CLOSED.
exposure_run() {
  local edge="${1:-0}" posture off verdict label detail sig old_sig had=0
  posture="$(read_posture)"
  off="$(exposure_offline_reason "$posture")"
  if [ -n "$off" ]; then
    verdict="OFFLINE|$off"; sig="OFFLINE"
  else
    local pw disc pair dto pto scan src
    IFS='|' read -r pw disc pair dto pto scan src <<< "$posture"
    verdict="$(classify_exposure "$pw" "$disc" "$pair" "$dto" "$pto" "$scan")"
    verdict="$verdict [via $src]"
    # `scan` is DELIBERATELY out of the signature: it moves on every BLE scan start/stop (*/10 and
    # */15 across the mesh's scanners), so folding it in would fire an edge on cadence rather than on
    # a posture change. It attributes the window in the DETAIL; the class is what the edge tracks.
    sig="${verdict%%|*}#${pw},${disc},${pair},${dto},${pto}"
  fi
  label="${verdict%%|*}"; detail="${verdict#*|}"
  [ -f "$XSTATE" ] && { had=1; old_sig="$(sed -n '2p' "$XSTATE" 2>/dev/null)"; }
  # STATE write is unconditional per run — mtime = ran-live, never gated on the value changing
  mkdir -p "$(dirname "$XSTATE")" 2>/dev/null
  printf '%s\n%s\n' "$verdict" "$sig" > "$XSTATE" 2>/dev/null
  if [ "$edge" = 1 ]; then
    if [ "$had" = 1 ] && [ -n "${old_sig:-}" ] && [ "$old_sig" != "$sig" ]; then
      # NOPOST is how --test drives the real edge path without writing to the real board. It suppresses
      # ONLY the mesh-chat call, never the emit the test asserts. A PATH stub cannot do this job here:
      # this script re-prepends $HOME/.local/bin to PATH at load, so the real mesh-chat wins anyway.
      [ "${MESH_BT_TEST_NOPOST:-0}" = 1 ] || { command -v mesh-chat >/dev/null 2>&1 && \
        MESH_WHO="bt-link@$(hostname)" mesh-chat "[bt-exposure] $label — $detail" >/dev/null 2>&1; }
      echo "[bt-exposure] $label — $detail"
    fi
  else
    echo "bt-exposure: $label — $detail"
  fi
  [ "$label" = "OFFLINE" ] && return 2 || return 0
}

# bt_offline_reason → echoes a reason string if the BT sensor is UNREACHABLE, else empty.
# Order: binary absent → radio rfkill-blocked → daemon down → no controller / adapter powered off.
# The controller read is read_posture() — the SAME reader the exposure leg uses, D-Bus-first. It used
# to be its own `bluetoothctl show`, which meant the offline gate alone registered an agent on every
# single run of this reflex, including the runs that then reported "0 peripherals".
bt_offline_reason() {
  command -v busctl >/dev/null 2>&1 || command -v bluetoothctl >/dev/null 2>&1 \
    || { echo "neither busctl nor bluetoothctl installed"; return; }
  if command -v rfkill >/dev/null 2>&1; then
    if rfkill list bluetooth 2>/dev/null | grep -qi 'blocked: *yes'; then
      echo "rfkill-blocked (radio off)"; return
    fi
  fi
  local posture; posture="$(read_posture)"
  if [ -z "$posture" ]; then
    echo "no bluetooth controller / bluetoothd down"; return
  fi
  case "$posture" in
    no\|*) echo "adapter powered off"; return ;;
  esac
  echo ""  # reachable
}

# ---- peripheral enumeration over D-Bus (registers NO agent) --------------------------------------
#
# dbus_device_paths → one `/org/bluez/hciN/dev_*` object path per line.
#   rc 0 + rows   = devices known to bluez
#   rc 0 + NO rows= the object tree was READ and holds no devices (a real, honest empty)
#   rc 1          = the tree is UNREADABLE (no busctl / bluez down / no adapter object)
# That three-way split is load-bearing: an unreadable tree must reach the OFFLINE gate, never fall
# through to "NONE|0 peripherals connected" — a silent 0 here is the faked all-clear.
# MESH_BT_TREE redirects the raw `busctl tree` text at a fixture so the path filter is asserted
# without a radio (a pointed-at file that does not exist ⇒ rc 1 ⇒ the UNREADABLE branch, itself
# an asserted leg).
dbus_device_paths() {
  local tree
  if [ -n "${MESH_BT_TREE:-}" ]; then
    [ -f "$MESH_BT_TREE" ] || return 1
    tree="$(cat "$MESH_BT_TREE")"
  else
    command -v busctl >/dev/null 2>&1 || return 1
    tree="$(timeout "$BTCTL_TIMEOUT" busctl tree org.bluez 2>/dev/null)" || return 1
  fi
  # the ADAPTER object must be present — its absence means we read nothing, not that nothing is there
  printf '%s\n' "$tree" | grep -q '/org/bluez/hci[0-9]' || return 1
  printf '%s\n' "$tree" | grep -o '/org/bluez/hci[0-9][0-9]*/dev_[0-9A-Fa-f_]*' || true
}

# device_block <object-path> → EXACTLY 4 lines in busctl's printed form, in this order:
#   Connected · Address · Alias · Icon
# An ABSENT property is an EMPTY LINE, never a missing one, so line position always carries field
# identity. (Icon is genuinely absent for a device bluez has no class for — asking for four properties
# in ONE busctl call makes the whole call rc=1 and drops a line, which would shift every field up.)
# MESH_BT_DBUS points at a fixture DIR holding one file per path basename with the same 4 lines.
device_block() {
  local p="$1" n v
  if [ -n "${MESH_BT_DBUS:-}" ]; then
    local f="$MESH_BT_DBUS/${p##*/}"
    if [ -f "$f" ]; then sed -n '1,4p' "$f"; else printf '\n\n\n\n'; fi
    return 0
  fi
  for n in Connected Address Alias Icon; do
    v="$(timeout "$BTCTL_TIMEOUT" busctl get-property org.bluez "$p" org.bluez.Device1 "$n" 2>/dev/null | head -1)"
    printf '%s\n' "$v"
  done
}

# busctl_scalar <one busctl property line> → the bare value.
# busctl prints "<type-tag> <value>" and quotes strings: `b true`, `s "Bose Revolve"`, `s ""`.
# A line with no space at all is not a value line (absent property) → empty.
busctl_scalar() {
  local l="$1" v
  case "$l" in *\ *) v="${l#* }" ;; *) v="" ;; esac
  v="${v%\"}"; v="${v#\"}"
  printf '%s' "$v"
}

# parse_device_block <4-line block> → "MAC<TAB>class<TAB>name" iff the device is CONNECTED, else
# nothing. PURE — --test drives it on fixtures and the live path drives this exact function.
# Connected must be the literal `true`: anything else (false, absent, unparseable) is NOT a connection.
parse_device_block() {
  local blk="$1" conn addr alias icon
  conn="$(busctl_scalar "$(printf '%s\n' "$blk" | sed -n '1p')")"
  [ "$conn" = "true" ] || return 0
  addr="$(busctl_scalar "$(printf '%s\n' "$blk" | sed -n '2p')")"
  [ -n "$addr" ] || return 0
  alias="$(busctl_scalar "$(printf '%s\n' "$blk" | sed -n '3p')")"
  icon="$(busctl_scalar "$(printf '%s\n' "$blk" | sed -n '4p')")"
  printf '%s\t%s\t%s\n' "$addr" "$(classify_icon "${icon:-unknown}")" "${alias:-$addr}"
}

# read_connected → prints "MAC<TAB>class<TAB>name" per connected peripheral (may be empty = NONE).
# Uses `bluetoothctl devices Connected` (bluez 5.65+); per device, `info <MAC>` → Icon → classify_icon.
# MESH_BT_DEVICES redirects the device list at a fixture so --test can assert the row filter below
# WITHOUT a radio (that filter is the fix for the 2026-07-06 phantom-peripheral bug, and until now
# nothing asserted it). Under a fixture the per-device Icon lookup is skipped → class "other".
devices_raw() {
  if [ -n "${MESH_BT_DEVICES:-}" ]; then
    [ -f "$MESH_BT_DEVICES" ] && cat "$MESH_BT_DEVICES"
    return 0
  fi
  timeout "$BTCTL_TIMEOUT" bluetoothctl devices Connected 2>/dev/null
}

# read_connected → the enumeration, with its SOURCE as line 1.
#   line 1  "#src=dbus" | "#src=bluetoothctl"
#   line 2+ "MAC<TAB>class<TAB>name" per connected peripheral (may be none = a real empty)
# The source is part of the OUTPUT because the caller runs this in a command substitution — a global
# set inside the subshell cannot reach it — and because WHICH interface answered is itself a fact the
# reader needs: a bluetoothctl-sourced row set was produced by a run that opened a pairable window.
# connected_src/connected_rows are the only two accessors; --test and production use the same pair.
connected_src()  { printf '%s\n' "$1" | sed -n '1s/^#src=//p'; }
connected_rows() { printf '%s\n' "$1" | tail -n +2 | grep . || true; }

read_connected() {
  local paths
  if [ -z "${MESH_BT_DEVICES:-}" ] && paths="$(dbus_device_paths)"; then
    echo "#src=dbus"
    printf '%s\n' "$paths" | while read -r _p; do
      [ -n "$_p" ] || continue
      parse_device_block "$(device_block "$_p")"
    done
    return 0
  fi
  echo "#src=bluetoothctl"
  read_connected_btctl
}

# the legacy text-interface enumeration — kept ONLY as the no-busctl fallback. It does NOT register
# an agent (measured; see the header) — it is demoted for being an unstructured text parse that
# cannot distinguish an unreadable adapter from an empty one, and because it is the one path the
# no-agent gate below cannot cover.
read_connected_btctl() {
  local line mac name icon cls
  devices_raw | while read -r _dev mac name; do
    # only real "Device <MAC> <name>" rows — bluetoothctl also emits controller-status noise lines
    # ("Pairable: yes", "Discovering: yes") that otherwise parse as phantom peripherals (seen live
    # on Default-string 2026-07-06 12:00Z: [bt-connected] n=2 ... "Pairable: yes(other)").
    [ "$_dev" = "Device" ] || continue
    [ -n "$mac" ] || continue
    if [ -n "${MESH_BT_DEVICES:-}" ]; then icon=""
    else icon="$(timeout "$BTCTL_TIMEOUT" bluetoothctl info "$mac" 2>/dev/null | sed -n 's/^[[:space:]]*Icon:[[:space:]]*//p' | head -1)"; fi
    cls="$(classify_icon "${icon:-unknown}")"
    printf '%s\t%s\t%s\n' "$mac" "$cls" "$name"
  done
}

# build_verdict <connected-table> <paired-count> → echoes the verdict line.
#   table = TAB-separated "MAC<TAB>class<TAB>name" rows (may be empty = NONE).
# Defined BEFORE --test so the smoke test dry-runs the exact production builder.
build_verdict() {
  local table="$1"
  if [ -z "$table" ]; then
    echo "NONE|controller up, 0 peripherals connected"
    return
  fi
  local n a i d p o names=""
  n="$(printf '%s\n' "$table" | grep -c .)"
  a="$(printf '%s\n' "$table" | awk -F'\t' '$2=="audio"'   | grep -c .)"
  i="$(printf '%s\n' "$table" | awk -F'\t' '$2=="input"'   | grep -c .)"
  d="$(printf '%s\n' "$table" | awk -F'\t' '$2=="display"' | grep -c .)"
  p="$(printf '%s\n' "$table" | awk -F'\t' '$2=="phone"'   | grep -c .)"
  o="$(printf '%s\n' "$table" | awk -F'\t' '$2=="other"'   | grep -c .)"
  names="$(printf '%s\n' "$table" | awk -F'\t' 'NF{printf "%s(%s) ", $3, $2}' | sed 's/ $//')"
  echo "CONNECTED|n=$n audio=$a input=$i display=$d phone=$p other=$o | $names"
}

# ---- --test -------------------------------------------------------------------------------------
if [ "${1:-}" = "--test" ]; then
  command -v busctl >/dev/null 2>&1 || command -v bluetoothctl >/dev/null 2>&1 \
    || { echo "smoke-test: FAIL (neither busctl nor bluetoothctl)"; exit 1; }
  _f=0
  # classifier contract (the reason the tool has a class lens at all)
  [ "$(classify_icon audio-headset)"   = "audio" ]   || { echo "  FAIL audio-headset→audio";   _f=1; }
  [ "$(classify_icon audio-card)"       = "audio" ]   || { echo "  FAIL audio-card→audio";       _f=1; }
  [ "$(classify_icon input-keyboard)"   = "input" ]   || { echo "  FAIL input-keyboard→input";   _f=1; }
  [ "$(classify_icon input-mouse)"      = "input" ]   || { echo "  FAIL input-mouse→input";      _f=1; }
  [ "$(classify_icon video-display)"    = "display" ] || { echo "  FAIL video-display→display";  _f=1; }
  [ "$(classify_icon phone)"            = "phone" ]   || { echo "  FAIL phone→phone";            _f=1; }
  [ "$(classify_icon '')"               = "other" ]   || { echo "  FAIL empty-icon→other";       _f=1; }
  [ "$(classify_icon weird-thing)"      = "other" ]   || { echo "  FAIL unknown→other";          _f=1; }
  # verdict-builder contract: build_verdict on a fixture connected-table → CONNECTED with tallies;
  # empty table → NONE. (build_verdict is defined above → --test runs the exact production builder.)
  fix="$(printf 'AA:BB\taudio\tBose Revolve\nCC:DD\tinput\tK380\n')"
  v="$(build_verdict "$fix")"
  echo "$v" | grep -q '^CONNECTED|n=2 ' || { echo "  FAIL fixture 2-connected should be CONNECTED n=2: got '$v'"; _f=1; }
  echo "$v" | grep -q 'audio=1' || { echo "  FAIL fixture should tally audio=1: got '$v'"; _f=1; }
  echo "$v" | grep -q 'input=1' || { echo "  FAIL fixture should tally input=1: got '$v'"; _f=1; }
  vn="$(build_verdict "")"
  echo "$vn" | grep -q '^NONE|' || { echo "  FAIL empty table should be NONE: got '$vn'"; _f=1; }
  [ "$_f" = 0 ] || { echo "smoke-test: FAIL (classifier / verdict-builder contract)"; exit 1; }

  # ---- exposure legs (2026-08-04) --------------------------------------------------------------
  # UNIT: the posture classifier, incl. the two states the axis exists for (silent-but-answerable,
  # and never-expiring discoverable) and the absent-field case that must NOT read as a closed door.
  _xf=0
  _c(){ classify_exposure "$1" "$2" "$3" "$4" "${5:-}" "${6:-}" | cut -d'|' -f1; }
  [ "$(_c yes no  yes 180)" = "PAIRABLE" ]     || { echo "  FAIL powered+hidden+pairable→PAIRABLE (got $(_c yes no yes 180))"; _xf=1; }
  [ "$(_c yes no  no  180)" = "CLOSED" ]       || { echo "  FAIL powered+hidden+unpairable→CLOSED"; _xf=1; }
  [ "$(_c no  no  yes 180)" = "CLOSED" ]       || { echo "  FAIL radio off→CLOSED"; _xf=1; }
  [ "$(_c yes yes yes 180)" = "DISCOVERABLE" ] || { echo "  FAIL discoverable→DISCOVERABLE"; _xf=1; }
  [ "$(_c yes yes no  180)" = "DISCOVERABLE" ] || { echo "  FAIL discoverable+unpairable is still DISCOVERABLE"; _xf=1; }
  [ "$(_c yes ''  yes 180)" = "UNKNOWN" ]      || { echo "  FAIL absent Discoverable must be UNKNOWN, never CLOSED"; _xf=1; }
  [ "$(_c yes no  ''  180)" = "UNKNOWN" ]      || { echo "  FAIL absent Pairable must be UNKNOWN, never CLOSED"; _xf=1; }
  [ "$(_c ''  no  yes 180)" = "UNKNOWN" ]      || { echo "  FAIL absent Powered must be UNKNOWN, never CLOSED"; _xf=1; }
  # the scan attribution must never CHANGE a class — it explains a window, it does not close one
  [ "$(_c yes no  yes 180 0 yes)" = "PAIRABLE" ]     || { echo "  FAIL a scan-coincident window must still classify PAIRABLE"; _xf=1; }
  [ "$(_c yes yes yes 180 0 yes)" = "DISCOVERABLE" ] || { echo "  FAIL a scan-coincident window must still classify DISCOVERABLE"; _xf=1; }
  # …and BOTH open classes must carry it (a note on only one is the both-edges failure)
  classify_exposure yes no  yes 180 0 yes | grep -q 'SELF-INFLICTED' \
    || { echo "  FAIL PAIRABLE must carry the scan attribution"; _xf=1; }
  classify_exposure yes yes yes 180 0 yes | grep -q 'SELF-INFLICTED' \
    || { echo "  FAIL DISCOVERABLE must carry the scan attribution too"; _xf=1; }
  classify_exposure yes yes no  180 ''  yes | grep -q 'SELF-INFLICTED' \
    || { echo "  FAIL DISCOVERABLE-but-unpairable must carry the scan attribution too"; _xf=1; }
  # CLOSED is not an open window — blaming a scan for it would be nonsense
  classify_exposure yes no no 180 0 yes | grep -q 'SELF-INFLICTED' \
    && { echo "  FAIL CLOSED must never carry a scan attribution"; _xf=1; }
  # the two timeouts are DISTINCT axes and each must survive into its own class's detail
  classify_exposure yes yes yes 0 180 | grep -q 'discoverable-for NEVER EXPIRES' \
    || { echo "  FAIL DiscoverableTimeout 0 must read as never-expiring"; _xf=1; }
  classify_exposure yes yes yes 180 180 | grep -q 'discoverable-for 180s' \
    || { echo "  FAIL a finite DiscoverableTimeout must read as expiring"; _xf=1; }
  # the live-here case: PAIRABLE with a never-expiring pairable window (bluetoothctl show cannot see it)
  classify_exposure yes no yes 180 0 | grep -q 'pairable-for NEVER EXPIRES' \
    || { echo "  FAIL PairableTimeout 0 must read as never-expiring on the PAIRABLE class"; _xf=1; }
  classify_exposure yes no yes 180 60 | grep -q 'pairable-for 60s' \
    || { echo "  FAIL a finite PairableTimeout must read as expiring"; _xf=1; }
  # an UNREPORTED timeout (the bluetoothctl fallback has no PairableTimeout) must say so, never "0"
  classify_exposure yes no yes 180 '' | grep -q 'pairable-for unreported' \
    || { echo "  FAIL an unreported PairableTimeout must not be rendered as never-expiring"; _xf=1; }

  # FUNCTIONAL: drive "$0" --exposure against a REAL `bluetoothctl show` capture, so the field parse,
  # the hex-timeout decode, the classifier and the edge state all run together on the production path.
  # MESH_STATE_DIR is redirected at a scratch dir — a --test that writes the artifact a reader trusts
  # forges the evidence it exists to check.
  _bx="$(mktemp -d)"
  _mkshow(){ # <discoverable> <pairable> <timeout-hex> <timeout-dec>
    # DiscoverableTimeout is emitted BEFORE Discoverable — the reverse of bluez's own order, on
    # purpose. With the real order a `Discoverable[A-Za-z]*:` prefix-match still passes (head -1 picks
    # the right line by luck), so the anchoring assertion asserts nothing; this ordering makes the
    # prefix-match lose and turns it into a gate that can actually fail.
    { echo "Controller 00:13:25:AC:CD:1B (public)"
      echo "	Name: fixture"
      echo "	Powered: yes"
      echo "	DiscoverableTimeout: $3 ($4)"
      echo "	Discoverable: $1"
      echo "	Pairable: $2"
      echo "	Discovering: ${5:-no}"; } > "$_bx/show"
  }
  _xrun(){ MESH_STATE_DIR="$_bx" MESH_BT_SHOW="$_bx/show" MESH_BT_TEST_NOPOST=1 "$0" "$@"; }
  # the live-on-mesh-home shape the find was filed on: hidden from scan, still answerable
  _mkshow no yes 0x000000b4 180
  _o="$(_xrun --exposure)"
  printf '%s' "$_o" | grep -q '^bt-exposure: PAIRABLE ' \
    || { echo "  FAIL --exposure on a hidden-but-pairable controller: got '$_o'"; _xf=1; }
  # the text fallback has NO PairableTimeout — it must be reported unknown, never assumed
  printf '%s' "$_o" | grep -q 'pairable-for unreported' \
    || { echo "  FAIL the bluetoothctl fallback must report PairableTimeout as unreported: got '$_o'"; _xf=1; }
  printf '%s' "$_o" | grep -q '\[via bluetoothctl\]' \
    || { echo "  FAIL the verdict must name the source it was read from: got '$_o'"; _xf=1; }
  printf '%s' "$_o" | grep -q 'SELF-INFLICTED' \
    && { echo "  FAIL Discovering:no via the text path must not be read as a scan: got '$_o'"; _xf=1; }
  # the attribution must survive the FALLBACK too — `bluetoothctl show` DOES print Discovering, so a
  # busctl-less node still gets the cause, not a bare "this node is open". (A field added on the
  # primary path and quietly dropped on the fallback is the same-signal-two-readers failure.)
  _mkshow no yes 0x000000b4 180 yes
  printf '%s' "$(_xrun --exposure)" | grep -q 'SELF-INFLICTED: a local BLE scan is in flight' \
    || { echo "  FAIL the text fallback must parse Discovering and attribute the window: got '$(_xrun --exposure)'"; _xf=1; }
  _mkshow no yes 0x000000b4 180
  # DiscoverableTimeout must be decoded from the parenthesised DECIMAL, not the 0x string
  _mkshow yes yes 0x0000012c 300
  printf '%s' "$(_xrun --exposure)" | grep -q 'discoverable-for 300s' \
    || { echo "  FAIL hex timeout must decode to its decimal: got '$(_xrun --exposure)'"; _xf=1; }
  # `Discoverable:` must not swallow `DiscoverableTimeout:`
  _mkshow no no 0x00000000 0
  printf '%s' "$(_xrun --exposure)" | grep -q '^bt-exposure: CLOSED ' \
    || { echo "  FAIL Discoverable parse leaked DiscoverableTimeout: got '$(_xrun --exposure)'"; _xf=1; }
  # EDGE: seeds silently, stays silent on an unchanged posture, fires on a real change
  _mkshow no no 0x000000b4 180
  rm -f "$_bx/.bt-exposure-state"
  [ -z "$(_xrun --exposure --edge)" ] || { echo "  FAIL the exposure edge must seed SILENTLY"; _xf=1; }
  [ -z "$(_xrun --exposure --edge)" ] || { echo "  FAIL the exposure edge re-emitted on an UNCHANGED posture"; _xf=1; }
  _mkshow no yes 0x000000b4 180
  printf '%s' "$(_xrun --edge --exposure)" | grep -q '^\[bt-exposure\] PAIRABLE' \
    || { echo "  FAIL the exposure edge missed CLOSED→PAIRABLE (flag order --edge --exposure)"; _xf=1; }
  # D-BUS PATH: the normalized posture record (the source that carries PairableTimeout at all) drives
  # the same classifier — asserted separately from the text fallback, since only this path can be
  # PAIRABLE-with-a-never-expiring-window, the exact live shape on mesh-home the find was filed on.
  printf 'yes|no|yes|180|0|no|dbus\n' > "$_bx/posture"
  _p="$(MESH_STATE_DIR="$_bx" MESH_BT_POSTURE="$_bx/posture" MESH_BT_TEST_NOPOST=1 "$0" --exposure)"
  printf '%s' "$_p" | grep -q '^bt-exposure: PAIRABLE ' \
    || { echo "  FAIL the dbus posture record must classify: got '$_p'"; _xf=1; }
  printf '%s' "$_p" | grep -q 'pairable-for NEVER EXPIRES' \
    || { echo "  FAIL the dbus path must surface PairableTimeout 0: got '$_p'"; _xf=1; }
  printf '%s' "$_p" | grep -q '\[via dbus\]' \
    || { echo "  FAIL the dbus verdict must name its source: got '$_p'"; _xf=1; }
  printf '%s' "$_p" | grep -q 'SELF-INFLICTED' \
    && { echo "  FAIL a PAIRABLE window with NO scan running must not be blamed on a scan: got '$_p'"; _xf=1; }
  # …and the same posture WITH a scan in flight must be attributed, end to end through the real path
  printf 'yes|no|yes|180|0|yes|dbus\n' > "$_bx/posture-scan"
  _p2="$(MESH_STATE_DIR="$_bx" MESH_BT_POSTURE="$_bx/posture-scan" MESH_BT_TEST_NOPOST=1 "$0" --exposure)"
  printf '%s' "$_p2" | grep -q '^bt-exposure: PAIRABLE ' \
    || { echo "  FAIL a scan-coincident window is still really PAIRABLE — attribution is not suppression: got '$_p2'"; _xf=1; }
  printf '%s' "$_p2" | grep -q 'SELF-INFLICTED: a local BLE scan is in flight' \
    || { echo "  FAIL a scan-coincident PAIRABLE must name the scan as the cause: got '$_p2'"; _xf=1; }
  # the edge SIGNATURE must ignore the scan field — otherwise every scan start/stop fires a board post
  printf 'yes|no|yes|180|0|no|dbus\n' > "$_bx/posture"
  MESH_STATE_DIR="$_bx" MESH_BT_POSTURE="$_bx/posture" MESH_BT_TEST_NOPOST=1 "$0" --exposure --edge >/dev/null
  _pe="$(MESH_STATE_DIR="$_bx" MESH_BT_POSTURE="$_bx/posture-scan" MESH_BT_TEST_NOPOST=1 "$0" --exposure --edge)"
  [ -z "$_pe" ] \
    || { echo "  FAIL a BLE scan starting must not fire an exposure EDGE (posture class unchanged): got '$_pe'"; _xf=1; }

  # HONEST DEGRADE: an unreadable controller is exit 2 + OFFLINE, never a fabricated CLOSED
  _o="$(MESH_STATE_DIR="$_bx" MESH_BT_SHOW="$_bx/absent" MESH_BT_TEST_NOPOST=1 "$0" --exposure)"; _rc=$?
  [ "$_rc" = 2 ] || { echo "  FAIL an unreadable controller must exit 2 (got $_rc)"; _xf=1; }
  printf '%s' "$_o" | grep -q 'OFFLINE' \
    || { echo "  FAIL an unreadable controller must read OFFLINE, not a closed door: got '$_o'"; _xf=1; }

  # REGRESSION GUARD for the 2026-07-06 phantom-peripheral bug the read_connected filter fixes: the
  # controller-status lines must never parse as devices. Asserted here for the first time.
  printf 'Pairable: yes\nDiscovering: yes\nDevice AA:BB:CC:DD:EE:FF Bose Revolve\n' > "$_bx/devices"
  _e="$(MESH_BT_DEVICES="$_bx/devices" read_connected)"
  _n="$(connected_rows "$_e" | grep -c . || true)"
  [ "$_n" = 1 ] || { echo "  FAIL controller-status lines parsed as phantom peripherals (rows=$_n, want 1)"; _xf=1; }
  [ "$(connected_src "$_e")" = "bluetoothctl" ] \
    || { echo "  FAIL a text-interface enumeration must declare src=bluetoothctl: got '$(connected_src "$_e")'"; _xf=1; }
  [ "$_xf" = 0 ] || { echo "smoke-test: FAIL (exposure contract)"; exit 1; }

  # ---- D-Bus enumeration legs (2026-08-04) -----------------------------------------------------
  # UNIT: busctl's printed scalar forms, incl. the two that are NOT a value (absent property, and a
  # genuinely empty string). Getting these confused is how an absent Icon becomes a device name.
  [ "$(busctl_scalar 'b true')"          = "true" ]         || { echo "  FAIL busctl_scalar bool";      _xf=1; }
  [ "$(busctl_scalar 's "Bose Revolve"')" = "Bose Revolve" ] || { echo "  FAIL busctl_scalar quoted string"; _xf=1; }
  [ "$(busctl_scalar 's ""')"            = "" ]             || { echo "  FAIL busctl_scalar empty string"; _xf=1; }
  [ "$(busctl_scalar '')"                = "" ]             || { echo "  FAIL busctl_scalar absent property"; _xf=1; }

  # UNIT: parse_device_block. Only `Connected` LITERALLY true is a connection — the field is a bool
  # and a bluez that ever printed anything else must not be read as a live link.
  _blk(){ printf 'b %s\ns "%s"\ns "%s"\n%s\n' "$1" "$2" "$3" "${4:+s \"$4\"}"; }
  _r="$(parse_device_block "$(_blk true AA:BB:CC:DD:EE:FF 'Bose Revolve' audio-headset)")"
  [ "$_r" = "$(printf 'AA:BB:CC:DD:EE:FF\taudio\tBose Revolve')" ] \
    || { echo "  FAIL connected audio device row: got '$_r'"; _xf=1; }
  [ -z "$(parse_device_block "$(_blk false AA:BB:CC:DD:EE:FF 'Bose Revolve' audio-headset)")" ] \
    || { echo "  FAIL a DISCONNECTED device must not be enumerated"; _xf=1; }
  # a device bluez has no class for reports NO Icon property at all — the 4th line is empty. It must
  # classify "other" and KEEP its name, not shift the fields up or vanish.
  _r="$(parse_device_block "$(_blk true 7B:22:2B:51:5E:2B 'Quest 3' '')")"
  [ "$_r" = "$(printf '7B:22:2B:51:5E:2B\tother\tQuest 3')" ] \
    || { echo "  FAIL an Icon-less connected device must still enumerate as other: got '$_r'"; _xf=1; }
  # a connected device whose Address did NOT read must be DROPPED, not emitted with an empty MAC:
  # the --edge change signature is the sorted MAC set, so a blank first column is an unstable member
  # that flaps the signature (and thus the board) on every run.
  [ -z "$(parse_device_block "$(printf 'b true\n\ns "Quest 3"\ns "phone"\n')")" ] \
    || { echo "  FAIL a device with an unreadable Address must be dropped, not emitted with a blank MAC"; _xf=1; }

  # FUNCTIONAL: the whole D-Bus enumeration on a fixture tree + fixture device blocks. 3 known
  # devices, 2 connected — so the leg proves the Connected FILTER, not merely that rows appear.
  mkdir -p "$_bx/dbus"
  { echo "└─ /org"; echo "  └─ /org/bluez"; echo "    └─ /org/bluez/hci0"
    echo "      ├─ /org/bluez/hci0/dev_AA_BB_CC_DD_EE_FF"
    echo "      ├─ /org/bluez/hci0/dev_11_22_33_44_55_66"
    echo "      └─ /org/bluez/hci0/dev_7B_22_2B_51_5E_2B"; } > "$_bx/tree"
  _blk true  AA:BB:CC:DD:EE:FF 'Bose Revolve' audio-headset > "$_bx/dbus/dev_AA_BB_CC_DD_EE_FF"
  _blk false 11:22:33:44:55:66 'K380'         input-keyboard > "$_bx/dbus/dev_11_22_33_44_55_66"
  _blk true  7B:22:2B:51:5E:2B 'Quest 3'      ''             > "$_bx/dbus/dev_7B_22_2B_51_5E_2B"
  _e="$(MESH_BT_TREE="$_bx/tree" MESH_BT_DBUS="$_bx/dbus" read_connected)"
  [ "$(connected_src "$_e")" = "dbus" ] \
    || { echo "  FAIL the D-Bus path must declare src=dbus: got '$(connected_src "$_e")'"; _xf=1; }
  _v="$(build_verdict "$(connected_rows "$_e")")"
  printf '%s' "$_v" | grep -q '^CONNECTED|n=2 ' \
    || { echo "  FAIL D-Bus enumeration must yield the 2 CONNECTED of 3 known devices: got '$_v'"; _xf=1; }
  printf '%s' "$_v" | grep -q 'audio=1' \
    || { echo "  FAIL D-Bus enumeration must classify the audio sink: got '$_v'"; _xf=1; }
  printf '%s' "$_v" | grep -q 'K380' \
    && { echo "  FAIL the DISCONNECTED device leaked into the verdict: got '$_v'"; _xf=1; }

  # An UNREADABLE object tree must reach the OFFLINE gate — NEVER fall through to "0 peripherals".
  # (rc 1 from dbus_device_paths, distinct from rc 0 with no rows below.)
  MESH_BT_TREE="$_bx/no-such-tree" dbus_device_paths >/dev/null 2>&1 \
    && { echo "  FAIL an unreadable object tree must be rc 1, not an empty success"; _xf=1; }
  # …and a tree WITHOUT the adapter object is equally unreadable, not an empty node
  printf '└─ /org\n' > "$_bx/tree-noadapter"
  MESH_BT_TREE="$_bx/tree-noadapter" dbus_device_paths >/dev/null 2>&1 \
    && { echo "  FAIL a tree with no adapter object must be rc 1"; _xf=1; }
  # …while a REAL empty (adapter present, no devices) is rc 0 with no rows — the honest zero
  printf '└─ /org\n  └─ /org/bluez\n    └─ /org/bluez/hci0\n' > "$_bx/tree-empty"
  _p="$(MESH_BT_TREE="$_bx/tree-empty" dbus_device_paths)" && [ -z "$_p" ] \
    || { echo "  FAIL an adapter with no devices must be a rc-0 empty, got rc=$? rows='$_p'"; _xf=1; }

  # the fixture-sourced verdict must also carry its source into the DETAIL, where a reader sees it
  _pv="$(MESH_STATE_DIR="$_bx" MESH_BT_TREE="$_bx/tree" MESH_BT_DBUS="$_bx/dbus" \
         MESH_BT_POSTURE="$_bx/posture" "$0" 2>/dev/null)"
  printf '%s' "$_pv" | grep -q '^CONNECTED|n=2 .*\[via dbus\]' \
    || { echo "  FAIL the D-Bus verdict must name its source in the detail: got '$_pv'"; _xf=1; }
  [ "$_xf" = 0 ] || { echo "smoke-test: FAIL (enumeration contract)"; exit 1; }

  # REAL-READ GATE (verification principle): assert the controller is actually READABLE right now — a
  # real enumeration succeeds (0 or more devices is fine; the point is the read works, not the count).
  # Radio off / blocked / daemon down = honest n/a (exit 2), never a fake green.
  _off="$(bt_offline_reason)"
  if [ -n "$_off" ]; then
    echo "smoke-test: n/a (BT sensor unreachable: $_off — offline-gate + classifier verified, live-read skipped)"; exit 2
  fi
  # controller reachable: prove the LIVE object tree reads (an adapter with no devices is a valid read,
  # and is distinguished from an unreadable one by dbus_device_paths' rc — that is the point).
  dbus_device_paths >/dev/null 2>&1 \
    || { echo "smoke-test: n/a (controller reachable but the org.bluez object tree is unreadable — no busctl?)"; exit 2; }
  _le="$(read_connected)"
  _live_n="$(connected_rows "$_le" | grep -c . || true)"
  _live_src="$(connected_src "$_le")"
  # …and prove the LIVE read really was the D-Bus one. A green fixture leg above says the code is
  # correct; only this says the code is what RAN on this node's actual hardware.
  [ "$_live_src" = "dbus" ] \
    || { echo "smoke-test: n/a (live enumeration fell back to $_live_src — the text interface, not the gated path)"; exit 2; }

  # THE GATE THIS CHANGE EXISTS FOR: a whole LIVE run must reach org.bluez without ever invoking
  # `bluetoothctl`. Asserted by POISONING it — a stub first on PATH that records every call and
  # fails — and driving the child with NO fixtures at all, so every real call site is exercised:
  # the offline gate, the posture read, the object tree, the per-device properties. An earlier
  # draft ran this child on the D-Bus FIXTURES and was very nearly vacuous: the fixture branches
  # return before any live call, so a `bluetoothctl show` planted inside device_block's live loop
  # left it GREEN. A gate must be driven down the path it claims to cover.
  # This turns agent-freedom from an ACCIDENT of argument style (a subcommand-bearing bluetoothctl
  # happens not to register an agent — measured, but nothing held it) into a property a future edit
  # cannot silently drop. A PATH stub works here where it would not for mesh-chat: this script
  # re-prepends $HOME/.local/bin at load, but bluetoothctl lives in /usr/bin, so the stub still wins.
  _pd="$(mktemp -d)"; mkdir -p "$_pd/poison"
  printf '#!/bin/sh\necho "$@" >> "%s"\nexit 1\n' "$_pd/called" > "$_pd/poison/bluetoothctl"
  chmod +x "$_pd/poison/bluetoothctl"
  _pv="$(PATH="$_pd/poison:$PATH" MESH_STATE_DIR="$_pd" "$0" 2>/dev/null)"; _prc=$?
  _pcalled=""; [ -f "$_pd/called" ] && _pcalled="$(tr '\n' ';' < "$_pd/called")"
  rm -rf "$_pd"
  [ -z "$_pcalled" ] \
    || { echo "smoke-test: FAIL (a live run invoked bluetoothctl — the text interface is back on the hot path: $_pcalled)"; exit 1; }
  printf '%s' "$_pv" | grep -qE '^(CONNECTED|NONE)\|.*\[via dbus\]' \
    || { echo "smoke-test: FAIL (live run without bluetoothctl must still produce a real verdict, got rc=$_prc '$_pv')"; exit 1; }
  # REAL-READ GATE for the exposure axis too: the live controller must actually REPORT the two flags
  # this leg judges. A bluez that names neither would render UNKNOWN forever while every fixture leg
  # stayed green — the hollow-sense shape.
  _lp="$(read_posture)"
  printf '%s' "$_lp" | grep -qE '^(yes|no)\|(yes|no)\|(yes|no)\|' \
    || { echo "smoke-test: n/a (controller up but Powered/Discoverable/Pairable unreadable: '$_lp' — exposure leg unassertable here)"; exit 2; }
  # …driven as a CHILD with MESH_STATE_DIR at a scratch dir: calling exposure_run in-process would
  # write the real .bt-exposure-state and re-baseline the edge, suppressing the next genuine change.
  _lxd="$(mktemp -d)"; _lx="$(MESH_STATE_DIR="$_lxd" "$0" --exposure)"; rm -rf "$_lxd"
  echo "smoke-test: ok (classifier + verdict-builder + exposure contract + REAL controller read: ${_live_n} peripheral(s) connected; ${_lx})"; exit 0
fi

[ "${1:-}" = "--forget" ] && { rm -f "$STATE"; echo "bt-link state forgotten — next run re-seeds"; exit 0; }

# Flags, not positional: `--exposure --edge` and `--edge --exposure` must mean the same thing.
MODE=""; EDGE=0; JSON=0; EXPOSURE=0
for _a in "$@"; do
  case "$_a" in
    --edge)     EDGE=1;     MODE="--edge" ;;
    --json)     JSON=1;     MODE="--json" ;;
    --exposure) EXPOSURE=1 ;;
  esac
done

# ---- exposure leg -------------------------------------------------------------------------------
# Evaluated BEFORE the peripheral sense's OFFLINE early-exit, so a powered-down radio still reports
# its (real, load-bearing) CLOSED posture instead of being swallowed by an exit 2.
if [ "$EXPOSURE" = 1 ]; then
  exposure_run "$EDGE"; exit $?
fi
if [ "$EDGE" = 1 ]; then
  exposure_run 1 || true   # rides the existing reflex cadence; never blocks the peripheral sense
fi

# ---- offline gate (honest-degrade) --------------------------------------------------------------
offline="$(bt_offline_reason)"
if [ -n "$offline" ]; then
  verdict="OFFLINE|$offline"
  sig="OFFLINE"
else
  enum="$(read_connected)"
  src="$(connected_src "$enum")"
  table="$(connected_rows "$enum")"
  verdict="$(build_verdict "$table")"
  # name the interface that answered. Appended to the DETAIL only — mesh-audio-path's bt_sink_class
  # keys on the "CONNECTED|"/"NONE|"/"OFFLINE|" prefix and on `audio=[1-9]`, and the change SIGNATURE
  # below is built from the class + MAC set, so this neither breaks that reader nor fires a false edge.
  verdict="$verdict [via ${src:-unknown}]"
  # change signature = verdict class + sorted connected MAC set (so a reorder never false-fires)
  set_sig="$(printf '%s\n' "$table" | awk -F'\t' 'NF{print $1}' | sort | tr '\n' ',')"
  sig="$(printf '%s' "$verdict" | cut -d'|' -f1)#${set_sig}"
fi

# JSON mode
if [ "$MODE" = "--json" ]; then
  label="$(printf '%s' "$verdict" | cut -d'|' -f1)"
  detail="$(printf '%s' "$verdict" | cut -d'|' -f2-)"
  ts="$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo unknown)"
  printf '{"label":"%s","detail":"%s","ts":"%s"}\n' "$label" "$(printf '%s' "$detail" | sed 's/"/\\"/g')" "$ts"
  # still refresh STATE liveness on --json reads too (unconditional-per-run contract)
  old_sig=""; [ -f "$STATE" ] && old_sig="$(sed -n '2p' "$STATE")"
  printf '%s\n%s\n' "$verdict" "$sig" > "$STATE" 2>/dev/null
  [ "$label" = "OFFLINE" ] && exit 2 || exit 0
fi

# read prior signature for change detection (STATE line 1 = verdict, line 2 = signature)
old_sig=""; had_state=0
[ -f "$STATE" ] && { had_state=1; old_sig="$(sed -n '2p' "$STATE")"; }

# write STATE unconditionally (verdict + signature) — mtime = ran-live for the doctor-artifact gate
printf '%s\n%s\n' "$verdict" "$sig" > "$STATE" 2>/dev/null

changed=0
[ "$had_state" = 1 ] && [ -n "$old_sig" ] && [ "$old_sig" != "$sig" ] && changed=1

# --edge: post to board only on a real change (never on first-run seed)
if [ "$MODE" = "--edge" ]; then
  if [ "$changed" = 1 ]; then
    label="$(printf '%s' "$verdict" | cut -d'|' -f1)"
    detail="$(printf '%s' "$verdict" | cut -d'|' -f2- | sed 's/^ *//')"
    case "$label" in
      OFFLINE)   tag="[bt-offline]" ;;
      NONE)      tag="[bt-none]" ;;
      CONNECTED) tag="[bt-connected]" ;;
      *)         tag="[bt-link]" ;;
    esac
    command -v mesh-chat >/dev/null 2>&1 && \
      MESH_WHO="bt-link@$(hostname)" mesh-chat "$tag $detail" >/dev/null 2>&1
  fi
  [ "${verdict%%|*}" = "OFFLINE" ] && exit 2 || exit 0
fi

# default: print verdict
printf '%s\n' "$verdict"
[ "${verdict%%|*}" = "OFFLINE" ] && exit 2 || exit 0
