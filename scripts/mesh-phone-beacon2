#!/data/data/com.termux/files/usr/bin/sh
# mesh phone MULTI-SENSOR beacon — pushes geo + motion + light + wifi + battery to the
# phaedra collector, so the mesh can DERIVE the operator's state through the day
# (home/away, still/walking/driving, dark/lit, asleep/active) — not just dots on a map.
# Deploy ON THE PHONE (Termux). Durable via Termux:Boot (~/.termux/boot/). No python on phone
# → all parsing is grep/sed/awk. Needs: termux-api, location+sensors permission, internet.
#
# 2026-06-19 FIX (the "walk not tracked" bug): the old version called `termux-location -p network`
# FIRST, which ALWAYS returns a cached last-known fix → GPS was never tried → a real walk logged the
# stale HOME location, zero speed, and home WiFi, looking exactly like "phone sat at home". Now:
#   1. GPS FIRST (real position + real speed when moving), network only as a flagged fallback.
#   2. STALE DETECTION — a fix bit-identical to the previous one is a cached repeat, not movement;
#      we push stale=1 so the reader NEVER again mistakes a cached read for "didn't move".
#   3. ADAPTIVE cadence — sample fast while moving, slow while still (battery-kind, dense tracks).
# Background reads still need: Termux location "Allow all the time" + battery-optimisation OFF for
# Termux (operator's hands) — else Android hands back cached values when the screen is off.
COLLECTOR="https://38-49-216-141.sslip.io:8092/loc"
TOKEN="2ea85e3fa4f7c3d63e643d4fa4ab85a3"
FAST="${MESH_BEACON_FAST:-120}"      # seconds between fixes while MOVING
SLOW="${MESH_BEACON_SLOW:-600}"      # seconds between fixes while STILL
LOG="$HOME/.locbeacon.log"
QUEUE="$HOME/.locbeacon.queue"   # buffer-and-forward: failed pushes queued here, flushed later
LIGHT_SENSOR="tmd2755_l"

echo "$(date) beacon2 start fast=${FAST}s slow=${SLOW}s (gps-first + stale-flag + buffer-forward)" >> "$LOG"

jval() { # extract first JSON numeric/string value for key $1 from stdin
  grep -oE "\"$1\"[ ]*:[ ]*\"?[-0-9A-Za-z._:+ -]*\"?" | head -1 | sed -E "s/.*:[ ]*\"?//; s/\"$//"
}

# push_one URL -> 0 on HTTP 200/204. The collector stamps the record with the client capture-time
# (cts=) we embed in the URL, so a DELAYED flush still lands at the right moment on the timeline.
push_one() {
  code=$(curl -s --max-time 25 -o /dev/null -w '%{http_code}' "$1" 2>/dev/null)
  [ "$code" = "200" ] || [ "$code" = "204" ]
}

# flush_queue: try every buffered URL; keep only the ones that still fail.
flush_queue() {
  [ -s "$QUEUE" ] || return 0
  NEWQ="$QUEUE.t"; : > "$NEWQ"; kept=0
  while IFS= read -r q; do
    [ -n "$q" ] || continue
    if push_one "$q"; then :; else echo "$q" >> "$NEWQ"; kept=$((kept+1)); fi
  done < "$QUEUE"
  mv "$NEWQ" "$QUEUE" 2>/dev/null
  echo "$(date) flush: $kept still queued" >> "$LOG"
}

if [ "${1:-}" = "--test" ]; then
  fail=0
  sample='{"latitude":55.1,"longitude":37.2,"provider":"gps","speed":1.25}'
  lat=$(printf '%s' "$sample" | jval latitude)
  prv=$(printf '%s' "$sample" | jval provider)
  spd=$(printf '%s' "$sample" | jval speed)
  [ "$lat" = "55.1" ] && [ "$prv" = "gps" ] && [ "$spd" = "1.25" ] \
    || { echo "FAIL: jval parse drifted (lat=$lat provider=$prv speed=$spd)"; fail=1; }

  td=$(mktemp -d 2>/dev/null || echo "")
  if [ -z "$td" ]; then
    echo "FAIL: mktemp unavailable"; exit 1
  fi
  old_queue="$QUEUE"; old_log="$LOG"
  QUEUE="$td/queue"; LOG="$td/log"
  printf '%s\n' 'https://collector/ok?cts=1' 'https://collector/fail?cts=2' '' > "$QUEUE"
  push_one() {
    case "$1" in
      *'/ok?'*) return 0 ;;
      *) return 1 ;;
    esac
  }
  flush_queue
  kept=$(wc -l < "$QUEUE" 2>/dev/null || echo 99)
  remaining=$(cat "$QUEUE" 2>/dev/null)
  [ "$kept" = "1" ] && [ "$remaining" = "https://collector/fail?cts=2" ] \
    || { echo "FAIL: flush_queue did not retain only failed pushes (kept=$kept remaining=$remaining)"; fail=1; }
  rm -rf "$td"
  QUEUE="$old_queue"; LOG="$old_log"

  [ "$fail" = 0 ] && echo "smoke-test: ok" || exit 1
  exit 0
fi

PREV_LAT=""; PREV_LON=""; PREV_ACC=""

while true; do
  termux-wake-lock 2>/dev/null   # re-acquire EVERY loop — Doze drops the startup-only lock

  # --- location: GPS FIRST (real movement + speed), network as a flagged fallback ---
  GPS_OK=1
  LOC=$(timeout 50 termux-location -p gps -r once 2>/dev/null)
  case "$LOC" in
    *latitude*) ;;
    *) GPS_OK=0; LOC=$(timeout 20 termux-location -p network -r once 2>/dev/null);;
  esac
  LAT=$(printf '%s' "$LOC" | jval latitude)
  LON=$(printf '%s' "$LOC" | jval longitude)
  ACC=$(printf '%s' "$LOC" | jval accuracy)
  SPD=$(printf '%s' "$LOC" | jval speed)
  PRV=$(printf '%s' "$LOC" | jval provider)

  # --- STALE detection: identical lat+lon+acc to the previous fix = cached repeat, not a real fix ---
  STALE=0
  if [ -n "$LAT" ] && [ "$LAT" = "$PREV_LAT" ] && [ "$LON" = "$PREV_LON" ] && [ "$ACC" = "$PREV_ACC" ]; then
    STALE=1
  fi

  # --- distance moved from previous fix (m), haversine in awk (no ^ for portability) ---
  MOVED_M=$(awk -v a1="$PREV_LAT" -v o1="$PREV_LON" -v a2="$LAT" -v o2="$LON" 'BEGIN{
    if(a1==""||a2==""){print -1; exit}
    R=6371000; d2r=3.14159265358979/180;
    la1=a1*d2r; la2=a2*d2r; dla=(a2-a1)*d2r; dlo=(o2-o1)*d2r;
    sdla=sin(dla/2); sdlo=sin(dlo/2);
    h=sdla*sdla + cos(la1)*cos(la2)*sdlo*sdlo;
    print int(2*R*atan2(sqrt(h),sqrt(1-h)))
  }')

  # --- battery ---
  BS=$(termux-battery-status 2>/dev/null)
  BAT=$(printf '%s' "$BS" | jval percentage)
  BST=$(printf '%s' "$BS" | jval status)
  BTMP=$(printf '%s' "$BS" | jval temperature)

  # --- wifi (home/away signal) ---
  WI=$(termux-wifi-connectioninfo 2>/dev/null)
  SSID=$(printf '%s' "$WI" | jval ssid)
  RSSI=$(printf '%s' "$WI" | jval rssi)

  # --- light (lux) ---
  LUX=$(timeout 6 termux-sensor -s "$LIGHT_SENSOR" -n 1 2>/dev/null \
        | tr -d '\n ' | grep -oE '"values":\[[-0-9.]+' | head -1 | grep -oE '[-0-9.]+$')

  # --- motion: RMS magnitude of linear acceleration over 8 samples (gravity excluded) ---
  MOT=$(timeout 8 termux-sensor -s LINEARACCEL -n 8 2>/dev/null \
        | tr -d '\n ' | grep -oE '"values":\[[-0-9.,]+\]' \
        | sed -E 's/"values":\[//; s/\]//' \
        | awk -F, '{m=sqrt($1*$1+$2*$2+$3*$3); s+=m; n++} END{ if(n>0) printf "%.3f", s/n; else printf "" }')

  # --- steps (cumulative, best-effort) ---
  STEPS=$(timeout 6 termux-sensor -s STEP_COUNTER -n 1 2>/dev/null \
          | tr -d '\n ' | grep -oE '"values":\[[-0-9.]+' | head -1 | grep -oE '[0-9]+' | head -1)

  # --- MOVING? real GPS speed >= 0.7 m/s, OR moved > 40 m on a fresh (non-stale) fix, OR motion RMS high ---
  MOVING=0
  if [ "$GPS_OK" = 1 ] && [ -n "$SPD" ]; then
    awk -v s="$SPD" 'BEGIN{exit !(s+0>=0.7)}' 2>/dev/null && MOVING=1
  fi
  if [ "$STALE" = 0 ] && [ "$MOVED_M" -ge 40 ] 2>/dev/null; then MOVING=1; fi
  if [ -n "$MOT" ]; then awk -v m="$MOT" 'BEGIN{exit !(m+0>=0.6)}' 2>/dev/null && MOVING=1; fi

  if [ -n "$LAT" ] && [ -n "$LON" ]; then
    CTS=$(date +%s)   # capture-time — collector stores it generically; mesh-travels uses cts over ts
    URL="${COLLECTOR}?token=${TOKEN}&cts=${CTS}&lat=${LAT}&lon=${LON}&acc=${ACC}&spd=${SPD}&prov=${PRV}"
    URL="${URL}&gps=${GPS_OK}&stale=${STALE}&moved=${MOVED_M}&batt=${BAT}&bst=${BST}&btemp=${BTMP}"
    URL="${URL}&ssid=${SSID}&rssi=${RSSI}&lux=${LUX}&mot=${MOT}&steps=${STEPS}"
    # buffer-and-forward: deliver now if the path works (onVao OFF / home wifi); else QUEUE with its
    # cts so a later flush lands at the right moment. This is why an AWAY walk (onVao up → push
    # times out) is no longer LOST — it delivers when a working path returns.
    if push_one "$URL"; then RESP=ok; flush_queue
    else echo "$URL" >> "$QUEUE"; RESP=queued; tail -3000 "$QUEUE" > "$QUEUE.t" 2>/dev/null && mv "$QUEUE.t" "$QUEUE" 2>/dev/null; fi
    QN=$( [ -f "$QUEUE" ] && wc -l < "$QUEUE" 2>/dev/null || echo 0 )
    echo "$(date) fix gps=$GPS_OK stale=$STALE moved=${MOVED_M}m lat=$LAT lon=$LON acc=$ACC spd=$SPD prov=$PRV bat=$BAT/$BST ssid=$SSID lux=$LUX mot=$MOT move=$MOVING resp=$RESP queued=$QN" >> "$LOG"
    PREV_LAT="$LAT"; PREV_LON="$LON"; PREV_ACC="$ACC"
  else
    echo "$(date) no-fix (location off / no signal) gps=$GPS_OK lux=$LUX mot=$MOT bat=$BAT ssid=$SSID" >> "$LOG"
  fi

  tail -400 "$LOG" > "$LOG.t" 2>/dev/null && mv "$LOG.t" "$LOG" 2>/dev/null

  if [ "$MOVING" = 1 ]; then sleep "$FAST"; else sleep "$SLOW"; fi
done
