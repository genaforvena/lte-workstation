#!/usr/bin/env bash
# mesh-relay — the mesh's METABOLISM: brainless inference router. text → cheapest AVAILABLE pool → text.
# One routable inference surface immune to any single pool's quota/geo-block.
# Pools in preference order (cheapest/fastest first):
#   1. Groq           (free cloud, fast; key in ~/.mesh/groq.env)
#   2. local          (local model via mesh-local-mind over SSH — quota+geo-block immune)
#   3. opencode-free  (free models via opencode: deepseek-v4-flash-free, mimo-v2.5-free, etc.)
#   4. opencode       (OpenCode Go subscription; full paid models)
#   5. claude         (Claude Max subscription; claude -p — most capable, most expensive)
#
#   mesh-relay "<prompt>"                                       auto: cheapest available
#   echo "<prompt>" | mesh-relay
#   mesh-relay --pool groq|local|opencode-free|opencode|claude  force pool
#   mesh-relay --pool heavy "<prompt>"                          skip free tiers → opencode → claude
#   mesh-relay --status                                         which pools are reachable right now
#   mesh-relay --chaos-drill [pools]                            inject a fault (default: groq) → verify fallover holds
#   mesh-relay --chaos-drill --depth                            cumulative-prefix sweep → the POINT OF COMMITMENT
#   mesh-relay --test                                           smoke test
#
# MESH_RELAY_FREE_MODEL: override the opencode free model (default: opencode/deepseek-v4-flash-free)
# MESH_RELAY_CHAOS=<csv pools|all>: chaos fault-injection — force-fail the named pools BEFORE any
#   network/API call, so the auto-fallover chain is exercised on demand (resilience drill; OFF by
#   default). No operator action, no substrate touch, read-only. See --chaos-drill.
#
# MESH_RELAY_ATTEST=1: zero-trust proof-of-inference — emit a tamper-evident receipt per served
#   inference into a hash-linked transparency log, so a consumer can verify WHICH pool produced an
#   output and that it was not altered, WITHOUT trusting this node. OFF by default (read-only). Verify
#   with `mesh-relay-attest verify` / `mesh-relay-attest check "<prompt>" "<output>"`.
#
# Never prints API keys. Read-only inference by default (attestation is the one opt-in side effect).
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -f "$HOME/.mesh/groq.env" ] && . "$HOME/.mesh/groq.env"
GROQ_MODEL="${MESH_GROQ_MODEL:-llama-3.1-8b-instant}"

# --- Load-bearing inference expressions, defined ONCE ---------------------------------------
# These are the request-build / response-parse python the run path executes. Defining them as
# variables (used by BOTH the pool functions AND --test) means the smoke test dry-runs the SAME
# code that ships — no test/code drift. A regression in any of them (an API shape change, a typo
# in the JSON path) bites --test first, instead of silently returning nothing / failing over.
GROQ_REQ_PY='import json,sys; print(json.dumps({"model":sys.argv[1],"messages":[{"role":"user","content":sys.argv[2]}]}))'
GROQ_RESP_PY='
import json, sys
try:
    d = json.load(sys.stdin)
    if "choices" in d: print(d["choices"][0]["message"]["content"], end=""); sys.exit(0)
    sys.exit(1)
except Exception:
    sys.exit(1)'
# `opencode run --format json` emits NDJSON (one event object per line) as of v1.18.18 — it was a
# single JSON object in v1.16.2, and the old `json.load(sys.stdin)` raises "Extra data" on the new
# shape, so the whole opencode/opencode-free leg silently served NOTHING (measured 2026-08-20 on
# opencode 1.18.18). Parse line-by-line and take the first sessionID seen: a single-object body is
# just a one-line stream, so this reads BOTH shapes and cannot regress when upstream flips again.
OC_SESID_PY='
import json,sys
for line in sys.stdin:
    line = line.strip()
    if not line:
        continue
    try:
        d = json.loads(line)
    except Exception:
        continue
    if not isinstance(d, dict):
        continue
    sid = d.get("sessionID") or (d.get("part") or {}).get("sessionID")
    if sid:
        print(sid)
        break
'
OC_EXPORT_PY='
import json,sys
d=json.load(sys.stdin)
for msg in reversed(d.get("messages",[])):
    if msg.get("info",{}).get("role")=="assistant":
        for p in msg.get("parts",[]):
            if p.get("type")=="text" and p.get("text","").strip():
                print(p["text"])
                break
        break
'

# --- chaos fault-injection seam (resilience drills; OFF by default) -------------------------
# Inject faults into relay requests on demand to test mesh resilience without waiting for a real
# outage (chaos engineering: force the fault, verify graceful degradation). MESH_RELAY_CHAOS names
# the pools to force-fail BEFORE any network/API call; each *_infer short-circuits via chaos_kill,
# so the auto-fallover chain gets exercised. Defined here (before --test) so --test dry-runs the
# SAME seam the run path uses — no test/code drift. Read-only, no operator action, no substrate touch.
CHAOS_POOLS="${MESH_RELAY_CHAOS:-}"
chaos_kill() {  # $1=pool name — rc 0 = inject failure (kill this pool now), rc 1 = let it run
  [ -n "$CHAOS_POOLS" ] || return 1
  case ",$CHAOS_POOLS," in
    *,all,*)   : ;;                      # 'all' fails every pool
    *,"$1",*)  : ;;                      # exact CSV membership (no substring bleed: opencode≠opencode-free)
    *)         return 1 ;;
  esac
  echo "mesh-relay: [chaos] fault injected — '$1' pool force-failed (MESH_RELAY_CHAOS=$CHAOS_POOLS)" >&2
  return 0
}

# --- the drill's PURE verdict + answer predicates (paired-assay logic, no network) -------------
# Defined here, before --test, so the smoke test drives the SAME predicates the drill ships — the
# no-test/code-drift rule chaos_kill above already follows. These two are what make the drill's
# control arm assertable without an inference call: the whole VACUOUS/DEGRADED/na/RESILIENT
# distinction is a function of WHICH pool served each arm, and nothing else.
drill_verdict() { # $1=knockout arm's serving pool $2=control arm's serving pool → one verdict word
  if   [ -z "${2:-}" ]; then echo "na"          # no intact baseline → nothing was measured
  elif [ -z "${1:-}" ]; then echo "DEGRADED"    # control served, knockout went dark
  elif [ "$1" = "$2" ]; then echo "VACUOUS"     # same pool both arms → the fault removed nothing
  else echo "RESILIENT"; fi                     # the route actually moved
  return 0
}
# --- the status probe must ask the CONSUMER'S question (found 2026-08-21 by --chaos-drill --depth)
# `--status` probed GET /v1/models with the key and printed "groq: reachable". groq_infer does not
# ask that question — it POSTs a chat completion for GROQ_MODEL. Measured this node: the key is
# valid, /v1/models returns 13 models, and the pinned `llama-3.1-8b-instant` is not one of them
# ("model_not_found"). So the pool had been DARK while status read reachable and metabolism_variety
# counted it as one of four independent absorbers. Reachability ≠ producing, and a probe that
# answers a DIFFERENT question in the same shape (both are a 200 from api.groq.com) is a false
# green. Pure membership predicate so the check is assertable without a network call.
groq_model_ok() { # $1=configured model  $2=space/newline-separated model ids the key can see
  local _m                                   # EXACT membership: a substring match would let
  for _m in $2; do [ "$_m" = "$1" ] && return 0; done   # "gpt-oss-20b" pass on "openai/gpt-oss-20b"
  return 1
}
drill_answer_ok() { # $1=an arm's reply — rc 0 = it contains the default probe's known-good word
  case "$(printf '%s' "${1:-}" | tr 'A-Z' 'a-z')" in *pong*) return 0 ;; *) return 1 ;; esac
}

# --- THE POINT OF COMMITMENT: a one-pool knockout is a DEPTH-1 claim (2026-08-21) -------------
# LITERATURE (information theory of agency — a concrete METRIC the area uses to measure itself):
# Jaineet Shah et al., "Causal Agent Replay: Counterfactual Attribution for LLM-Agent Failures",
# arXiv:2606.08275 (June 2026; code github.com/jaineet17/causal-agent-replay). They attribute a
# multi-step agent failure by re-running the trajectory under a do() at one step, and they name a
# confound that is specific to that design and that we have exactly:
#
#   "Under run-forward, resampling step k also re-rolls EVERY downstream stochastic step. Thus τ_k
#    is a TOTAL effect through a stochastic continuation, and an EARLY irrelevant step shows an
#    effect too, because it re-rolls the genuinely pivotal step downstream."
#
# So the argmax over per-step effects systematically names the EARLIEST step, not the responsible
# one. Their fix is not a bigger sample, it is a different READ of the same sweep — the POINT OF
# COMMITMENT: "the causal locus is the LATEST step whose effect's confidence interval still
# excludes zero — the last point at which re-deciding still rescues the run; beyond it, the
# outcome is committed."
#
# OUR CHAIN IS THE FALLOVER LADDER (groq → local → opencode-free → paid), and --chaos-drill above
# knocks out ONE pool and re-runs the whole ladder forward. That is run-forward, with the same
# confound: killing groq produces the biggest visible change (the route moves) precisely because
# everything downstream is intact — groq looks load-bearing exactly BECAUSE it is the most
# replaceable pool. And a single-pool RESILIENT is a DEPTH-1 claim: a metabolism with one spare
# and a metabolism with four print the identical word. Nothing in the old output separates them.
# The commitment read is the cumulative-PREFIX sweep: remove the first d pools for d = 1,2,3…, and
# report the LAST d that still served. That d IS the redundancy depth, and the pool serving at
# depth d is the one whose removal commits the outcome. `--chaos-drill --depth` runs it.
#
# VACUITY GUARD (the already-dark-pool trap, from the control-arm work above, at prefix scale): a
# dark arm is only evidence about the pool we just removed if that pool is the one that HAD been
# serving. If the previous depth was served by something other than the pool this arm removes, the
# darkness was not caused by our removal — INCONCLUSIVE, never a commitment point.
drill_commitment() { # $1=ladder, fallover order, space-separated
                     # $2=serving pool per arm, space-separated: index 0 = the INTACT control,
                     #    index d = the arm with the first d ladder pools knocked out; "-" = dark
                     # → "<VERDICT> <depth> <pool> <effective-depth> <pools-whose-removal-was-vacuous>"
                     #   depth     = prefix length still served (arms survived)
                     #   effective = of those, the removals that actually took away a SERVING pool.
                     #               An already-dark pool inflates depth and absorbs nothing: the
                     #               VACUOUS trap of the paired drill, at prefix scale. Reporting
                     #               depth alone would sell a dead pool as redundancy.
  local L S n d prev eff vac
  # shellcheck disable=SC2206
  L=($1); S=($2); n=${#L[@]}
  [ "${S[0]:--}" = "-" ] && { echo "na 0 - 0 -"; return 0; }   # no intact baseline → nothing measured
  # the two axes are computed over the SAME relation (did arm d remove what arm d-1 was served by):
  # at the dark arm it decides whether there is a commitment point at all, and over the surviving
  # prefix it decides how many of the absorbed removals were real.
  _eff() { # $1=depth → sets eff/vac over arms 1..$1
    local k; eff=0; vac=""
    k=1; while [ "$k" -le "$1" ]; do
      if [ "${S[$((k-1))]:--}" = "${L[$((k-1))]}" ]; then eff=$((eff+1))
      else vac="${vac:+$vac,}${L[$((k-1))]}"; fi
      k=$((k+1))
    done
    [ -n "$vac" ] || vac="-"
  }
  d=1
  while [ "$d" -le "$n" ]; do
    if [ "${S[$d]:--}" = "-" ]; then
      prev="${S[$((d-1))]}"
      # the arm that went dark is the one that removed L[d-1]; only informative if L[d-1] is what
      # had been serving at the depth before it.
      _eff $((d-1))
      [ "$prev" = "${L[$((d-1))]}" ] || { echo "INCONCLUSIVE $((d-1)) $prev $eff $vac"; return 0; }
      [ "$d" -eq 1 ] && { echo "SINGLE-POINT 0 $prev 0 -"; return 0; }   # zero spare: the alarm
      echo "COMMITTED $((d-1)) $prev $eff $vac"; return 0
    fi
    d=$((d+1))
  done
  _eff "$n"
  echo "UNCOMMITTED $n ${S[$n]:--} $eff $vac"; return 0   # ladder gone and something still served
}

# --- requisite variety of the METABOLISM (Ashby's Law of Requisite Variety; Beer, VSM) ---------
# The metabolism (this router) is a REGULATOR: it keeps the mesh able to think THROUGH disturbances
# (a pool's quota exhaustion, a provider outage, an egress/geo-block). Ashby/Beer: only variety
# absorbs variety — so the metabolism's resilience is NOT "how many pools are listed" but "how many
# INDEPENDENT absorbers are reachable", where independent = do NOT share a failure mode. --status
# lists reachability; it never judges variety, so a cloud MONOCULTURE (several pools, one shared
# uplink) reads as healthy right up until one egress/geo disturbance takes them all at once.
# Two independence axes, both from the pool header: QUOTA (each provider's limit is its own —
# groq≠opencode≠claude → independent quota-absorbers) and EGRESS/GEO (every CLOUD pool rides the SAME
# uplink; one geo-block/egress outage — which THIS node has seen on its phaedra-wg path — fails ALL
# cloud pools together; only `local` is egress-immune). opencode-free + opencode ride ONE subscription
# → ONE independent unit, not two. Report-only, advisory — never changes routing.
#   metabolism-dark         : 0 reachable — the mesh cannot think (honest; --status only implied it)
#   metabolism-monoculture  : 1 independent absorber — any single quota/outage → no inference
#   metabolism-cloud-coupled: >=2 absorbers but ALL cloud — resilient to per-provider quota, yet ONE
#                             egress/geo disturbance fails the whole metabolism together (the variety gap)
#   ok                      : >=2 absorbers spanning BOTH the quota AND the egress independence classes
# Recent live-lit anchor: Miehling et al., "Agentic AI Needs a Systems Theory" (IBM, arXiv:2503.00237,
# 2025), §variety amplification/attenuation — a regulator must match its environment's variety.
metabolism_variety() { # $1=groq $2=local $3=oc-free $4=opencode $5=claude (each 0/1) — report-only, rc 0
  local gr="$1" lo="$2" oc="$4" cl="$5"          # oc-free ($3) shares opencode's subscription — not a unit
  local ocu=$(( oc>0 ? 1 : 0 ))
  local cloud=$(( gr + ocu + cl )) ind=$(( gr + ocu + cl + lo ))
  local names="" verdict human
  [ "$gr" = 1 ] && names="${names:+$names,}groq"
  [ "$ocu" = 1 ] && names="${names:+$names,}opencode"
  [ "$cl" = 1 ] && names="${names:+$names,}claude"
  [ -n "$names" ] || names="none"
  if   [ "$ind" -eq 0 ]; then verdict="metabolism-dark";         human="no reachable pool — the mesh cannot think"
  elif [ "$ind" -eq 1 ]; then verdict="metabolism-monoculture";  human="one absorber — any quota/outage stops inference"
  elif [ "$lo" -eq 0 ];  then verdict="metabolism-cloud-coupled"; human="$cloud cloud absorbers, 0 local — one egress/geo disturbance fails all together"
  else                        verdict="ok";                       human="spans quota + egress independence classes"
  fi
  printf 'metabolism-variety: independent=%d (cloud:%s · local:%s) — %s %s\n' \
    "$ind" "$names" "$([ "$lo" = 1 ] && echo yes || echo no)" "$verdict" "$human"
}

# --- opencode's /tmp cdylib leak: the CALLER's sweep -----------------------------------------
# `opencode` (a Bun binary with a Rust native addon) extracts its cdylib to
# $TMPDIR/.<16-hex>-00000000.so (5576816 B, md5 0f8ce00433bafbb4479eb89e0ea42148) on EVERY
# invocation and never unlinks it — one 5.5MB orphan per call, on a clean exit as well as on a
# timeout, with zero open fds afterwards so nothing else reclaims it. opencode is upstream, not
# ours, so the sweep lives HERE at the only mesh caller (`_oc_extract`, which invokes opencode
# TWICE — run + export — and so mints up to two per relayed inference). Left alone this is
# ~44MB/day on phaedra's mesh-capability-probe cadence, and tmp-guard is structurally blind to it
# there (the files are root-owned → its other-owner skip bucket).
# Snapshot-then-diff, never a blanket glob-and-delete: another process's in-flight `opencode` must
# survive our reap, so we only unlink paths that appeared BETWEEN our own two snapshots.
OC_TMPDIR="${TMPDIR:-/tmp}"
OC_REAPED=0
# Is this path still held by a live process? A dlopen'd cdylib is normally MAPPED with no open fd,
# so /proc/*/maps is the load-bearing check and the fd scan is the belt-and-braces one.
# Honesty gate: if not a single maps file is readable (hidepid, an alien namespace), "no match" is
# a BLIND read, not an absence — report in-use and keep the file rather than delete on a scrape
# that counted zero because it could not look.
# NOTE both scans read their output through a VARIABLE, never a pipe: under this script's
# `set -o pipefail`, `grep`/`ls` over /proc exit non-zero on the hundreds of other-user entries they
# cannot read, and that meaningful non-zero becomes the whole pipeline's verdict — so a grep that
# DID match still reads as "no match" and the held file gets unlinked. Seen red exactly that way
# while writing (c) below.
_oc_so_in_use() {
  local f="$1" p hits fds
  hits="$(grep -lF -- "$f" /proc/[0-9]*/maps 2>/dev/null)"
  [ -n "$hits" ] && return 0
  fds="$(ls -l /proc/[0-9]*/fd/ 2>/dev/null)"
  case "$fds" in *"$f"*) return 0 ;; esac
  for p in /proc/[0-9]*/maps; do [ -r "$p" ] && return 1; done
  return 0
}
_oc_tmp_snapshot() {
  local f
  for f in "$OC_TMPDIR"/.*-00000000.so; do [ -f "$f" ] && printf '%s\n' "$f"; done
  return 0
}
# reap: unlink every .so present now that was absent in the "$1" snapshot and is held by nobody.
# Sets OC_REAPED to the count (the run path needs stdout for the inference answer, so the count is
# a variable, not a print).
_oc_tmp_reap() {
  local before="$1" f
  OC_REAPED=0
  for f in "$OC_TMPDIR"/.*-00000000.so; do
    [ -f "$f" ] || continue
    case "
$before
" in *"
$f
"*) continue ;; esac
    _oc_so_in_use "$f" && continue
    rm -f "$f" 2>/dev/null && OC_REAPED=$((OC_REAPED+1))
  done
  return 0
}

# --- the opencode call itself (defined HERE, before --test, so the smoke test drives the SHIPPED
# function and not a copy — see (6b): calling it from --test while it was still defined BELOW this
# block made the live leg a no-op that could never fail) ---------------------------------------
FREE_MODEL="${MESH_RELAY_FREE_MODEL:-opencode/deepseek-v4-flash-free}"
# opencode run in v1.16.2 does not output response to stdout/stderr — extract from session export
_oc_extract() {
  local prompt="$1" ses_id="" out="" snap
  # snapshot BEFORE the first opencode call and reap after the LAST one, on every exit path —
  # a timed-out `opencode run` (rc=124) leaks exactly like a clean one, so an early `return 1`
  # between the two would leave the orphan the sweep exists to remove.
  snap="$(_oc_tmp_snapshot)"
  # </dev/null on BOTH calls: opencode reads stdin, and inheriting a live-but-empty one (a pipe, an
  # agent pane) makes it exit 0 having written nothing at all — no stdout, no stderr, no session —
  # which reads downstream as "the pool is down" and fails the route over for no reason. Measured
  # here 2026-08-20: identical command, 0 bytes with the inherited stdin, 2419 bytes with </dev/null.
  ses_id="$(timeout 60 opencode run --format json "$prompt" </dev/null 2>/dev/null | python3 -c "$OC_SESID_PY" 2>/dev/null)"
  [ -n "$ses_id" ] && out="$(timeout 10 opencode export "$ses_id" </dev/null 2>/dev/null | python3 -c "$OC_EXPORT_PY" 2>/dev/null)"
  _oc_tmp_reap "$snap"
  [ -n "$out" ] || return 1
  printf '%s\n' "$out"
}

if [ "${1:-}" = --test ]; then
  command -v curl >/dev/null 2>&1 || { echo "smoke-test: FAIL (no curl)"; exit 1; }
  command -v python3 >/dev/null 2>&1 || { echo "smoke-test: FAIL (no python3)"; exit 1; }
  # Dry-run the LOAD-BEARING inference logic with synthetic data — NO network, NO API key.
  # (1) Groq request build — must emit valid JSON carrying the model + the user prompt verbatim.
  req="$(python3 -c "$GROQ_REQ_PY" "test-model" "ping" 2>/dev/null)" \
    || { echo "smoke-test: FAIL (groq request-build errored)"; exit 1; }
  printf '%s' "$req" | python3 -c 'import json,sys; d=json.load(sys.stdin); assert d["model"]=="test-model" and d["messages"][0]["content"]=="ping"' 2>/dev/null \
    || { echo "smoke-test: FAIL (groq request shape drifted: $req)"; exit 1; }
  # (2) Groq response parse — the exact extractor must lift content out of the real API shape...
  got="$(printf '%s' '{"choices":[{"message":{"content":"pong"}}]}' | python3 -c "$GROQ_RESP_PY" 2>/dev/null)"
  [ "$got" = "pong" ] || { echo "smoke-test: FAIL (groq response-parse drifted: got '$got')"; exit 1; }
  # ...and must REJECT an error/garbage body (else a rate-limited call reads as a success).
  if printf '%s' '{"error":"rate_limited"}' | python3 -c "$GROQ_RESP_PY" >/dev/null 2>&1; then
    echo "smoke-test: FAIL (groq parse accepted an error body — would mask a failed call)"; exit 1; fi
  # (3) opencode session-export parse — must return the LAST assistant text part, skipping the user turn.
  oc="$(printf '%s' '{"messages":[{"info":{"role":"user"},"parts":[{"type":"text","text":"hi"}]},{"info":{"role":"assistant"},"parts":[{"type":"text","text":"there"}]}]}' | python3 -c "$OC_EXPORT_PY" 2>/dev/null)"
  [ "$oc" = "there" ] || { echo "smoke-test: FAIL (opencode export-parse drifted: got '$oc')"; exit 1; }
  # (3b) opencode session-id extractor — must read the CURRENT NDJSON event stream AND the legacy
  #      single-object body, and must stay empty on garbage (an empty ses_id is what makes the leg
  #      fail over instead of exporting a session that does not exist).
  nd='{"type":"step_start","sessionID":"ses_A","part":{"sessionID":"ses_A"}}
{"type":"text","sessionID":"ses_A"}'
  sid="$(printf '%s' "$nd" | python3 -c "$OC_SESID_PY" 2>/dev/null)"
  [ "$sid" = "ses_A" ] || { echo "smoke-test: FAIL (opencode NDJSON session-id extract drifted: got '$sid' — this is the shape opencode >=1.18 emits, and json.load() on it serves nothing)"; exit 1; }
  sid="$(printf '%s' '{"sessionID":"ses_B"}' | python3 -c "$OC_SESID_PY" 2>/dev/null)"
  [ "$sid" = "ses_B" ] || { echo "smoke-test: FAIL (opencode legacy single-object session-id extract drifted: got '$sid')"; exit 1; }
  sid="$(printf '%s' 'not json at all' | python3 -c "$OC_SESID_PY" 2>/dev/null)"
  [ -z "$sid" ] || { echo "smoke-test: FAIL (opencode session-id extract invented '$sid' from a garbage body)"; exit 1; }

  # (4) chaos fault-injection seam — the resilience drill's gate. Pure, hermetic (no network).
  CHAOS_POOLS=""     ; chaos_kill groq 2>/dev/null && { echo "smoke-test: FAIL (chaos off but groq killed)"; exit 1; }
  CHAOS_POOLS="groq" ; chaos_kill groq 2>/dev/null || { echo "smoke-test: FAIL (chaos=groq should kill groq)"; exit 1; }
  CHAOS_POOLS="groq" ; chaos_kill local 2>/dev/null && { echo "smoke-test: FAIL (chaos=groq must spare local)"; exit 1; }
  CHAOS_POOLS="all"  ; chaos_kill claude 2>/dev/null || { echo "smoke-test: FAIL (chaos=all should kill every pool)"; exit 1; }
  # exact CSV membership — 'opencode' must NOT force-fail 'opencode-free' (substring-bleed guard)
  CHAOS_POOLS="opencode" ; chaos_kill opencode-free 2>/dev/null && { echo "smoke-test: FAIL (opencode chaos leaked onto opencode-free)"; exit 1; }
  CHAOS_POOLS="groq,opencode-free" ; chaos_kill opencode-free 2>/dev/null || { echo "smoke-test: FAIL (csv member opencode-free should be killed)"; exit 1; }
  CHAOS_POOLS=""     # reset so it can't leak into the route below

  # (4b) THE DRILL'S CONTROL ARM (Lo/Schulz/Jensen/Kurtz 2025, bioRxiv 2025.03.27.645637 — see the
  #      --chaos-drill header). Pure, hermetic: the whole knockout-vs-control distinction is a
  #      function of WHICH pool served each arm, so it is assertable with no inference call.
  #      RED-FIRST: delete the control arm from the drill (or make drill_verdict return RESILIENT
  #      whenever the knockout arm served anything, which is what this drill did before today) and
  #      the VACUOUS + na asserts below go red. That is the point — an endpoint-only drill cannot
  #      tell a real fallover from a fault injected into a pool that was already dark.
  [ "$(drill_verdict local groq)" = RESILIENT ] || { echo "smoke-test: FAIL (drill: a route that MOVED groq→local must read RESILIENT, got '$(drill_verdict local groq)')"; exit 1; }
  [ "$(drill_verdict local local)" = VACUOUS ]  || { echo "smoke-test: FAIL (drill: the SAME pool serving both arms means the injected fault removed nothing — must read VACUOUS, not RESILIENT, got '$(drill_verdict local local)')"; exit 1; }
  [ "$(drill_verdict "" groq)" = DEGRADED ]     || { echo "smoke-test: FAIL (drill: knockout dark while the control served must read DEGRADED, got '$(drill_verdict "" groq)')"; exit 1; }
  [ "$(drill_verdict local "")" = na ]          || { echo "smoke-test: FAIL (drill: no intact baseline means nothing was measured — must read na, got '$(drill_verdict local "")')"; exit 1; }
  [ "$(drill_verdict "" "")" = na ]             || { echo "smoke-test: FAIL (drill: both arms dark is still 'no baseline' (na), never DEGRADED — a metabolism that was already down was not degraded BY the drill)"; exit 1; }
  # the ANSWER axis: non-empty is not correct — a route that holds while the reply degrades is the
  # drill's mechanism column (mesh-capability-probe's own note), and must not pass on emptiness.
  drill_answer_ok "pong"      || { echo "smoke-test: FAIL (drill: the known-good probe reply must pass the answer check)"; exit 1; }
  drill_answer_ok "  PONG! "  || { echo "smoke-test: FAIL (drill: the answer check must be case- and whitespace-tolerant)"; exit 1; }
  drill_answer_ok ""          && { echo "smoke-test: FAIL (drill: an EMPTY reply passed the answer check — non-empty is not correct, and empty is not even non-empty)"; exit 1; }
  drill_answer_ok "I'm sorry, I can't do that" && { echo "smoke-test: FAIL (drill: a served-but-wrong reply passed the answer check — the route held and the OUTPUT did not, which is exactly what this axis exists to catch)"; exit 1; }

  # (4c) THE POINT OF COMMITMENT (arXiv:2606.08275 — see the drill_commitment header). Pure,
  #      hermetic: the verdict is a function of the ladder and which pool served each prefix arm,
  #      so the whole sweep is assertable with no inference call. LADDER = "groq local oc-free".
  #      RED-FIRST, and both directions were driven before this landed:
  #        * delete the vacuity guard (the `$prev` = ladder-pool check) and the INCONCLUSIVE assert
  #          below goes green-as-COMMITTED — i.e. the sweep starts inventing commitment points out
  #          of a pool that died on its own mid-run.
  #        * make drill_commitment report the FIRST dark depth instead of the last served one and
  #          every depth below goes off by one — the argmax-vs-latest error the paper names.
  cm(){ drill_commitment "groq local opencode-free" "$1"; }
  #  control served by groq; -groq still served (local); -groq,local still served (oc-free);
  #  -groq,local,oc-free dark  ⇒ two removals absorbed, commitment on opencode-free.
  [ "$(cm "groq local opencode-free -")" = "COMMITTED 2 opencode-free 2 -" ] || { echo "smoke-test: FAIL (commitment: a ladder that absorbs two removals and dies on the third must read 'COMMITTED 2 opencode-free 2 -', got '$(cm "groq local opencode-free -")')"; exit 1; }
  #  the DEPTH-1 case the plain drill cannot distinguish from the one above: it survives losing
  #  groq and dies losing local. Same single-knockout RESILIENT, half the redundancy.
  [ "$(cm "groq local - -")" = "COMMITTED 1 local 1 -" ] || { echo "smoke-test: FAIL (commitment: one spare must read 'COMMITTED 1 local 1 -' — this is the case a single-pool RESILIENT is blind to, got '$(cm "groq local - -")')"; exit 1; }
  #  zero spare: removing the first pool alone goes dark.
  [ "$(cm "groq - - -")" = "SINGLE-POINT 0 groq 0 -" ] || { echo "smoke-test: FAIL (commitment: no spare at all must read SINGLE-POINT, got '$(cm "groq - - -")')"; exit 1; }
  #  the whole swept ladder removed and something OUTSIDE it still served.
  [ "$(cm "groq local opencode-free claude")" = "UNCOMMITTED 3 claude 3 -" ] || { echo "smoke-test: FAIL (commitment: served after the whole ladder was removed must read UNCOMMITTED, got '$(cm "groq local opencode-free claude")')"; exit 1; }
  #  VACUITY GUARD: depth 1 was served by opencode-free (local was ALREADY dark), then depth 2 —
  #  which removes 'local' — goes dark. Removing an already-dark pool cannot have caused that, so
  #  this is NOT a commitment point. Without the guard this reads 'COMMITTED 1 opencode-free'.
  [ "$(cm "groq opencode-free - -")" = "INCONCLUSIVE 1 opencode-free 1 -" ] || { echo "smoke-test: FAIL (commitment: a dark arm whose removed pool was not the one serving is INCONCLUSIVE, never a commitment point, got '$(cm "groq opencode-free - -")')"; exit 1; }
  #  EFFECTIVE DEPTH: the control was served by 'local', so groq was ALREADY dark and its removal
  #  absorbed nothing. depth 2, but only ONE real spare. This is the live shape measured on
  #  mesh-home 2026-08-21; without the effective column a dead pool is sold as redundancy.
  [ "$(cm "local local opencode-free -")" = "COMMITTED 2 opencode-free 1 groq" ] || { echo "smoke-test: FAIL (commitment: a prefix whose first removal took an ALREADY-DARK pool must not count it as absorbed — expected 'COMMITTED 2 opencode-free 1 groq', got '$(cm "local local opencode-free -")')"; exit 1; }
  # (4d) THE STATUS PROBE'S QUESTION. Pure, hermetic. RED-FIRST: change groq_model_ok's `=` to a
  #      case-glob substring match and the bleed assert goes red; delete the call in --status and
  #      the pool reads "reachable" again while it cannot serve a single token.
  groq_model_ok "openai/gpt-oss-20b" "allam-2-7b openai/gpt-oss-20b qwen/qwen3.6-27b" || { echo "smoke-test: FAIL (groq model check: a model the account DOES offer must pass)"; exit 1; }
  groq_model_ok "llama-3.1-8b-instant" "allam-2-7b openai/gpt-oss-20b qwen/qwen3.6-27b" && { echo "smoke-test: FAIL (groq model check: a model the account does NOT offer must fail — this is the live 2026-08-21 state that read 'reachable' for a pool that could not serve)"; exit 1; }
  groq_model_ok "gpt-oss-20b" "openai/gpt-oss-20b" && { echo "smoke-test: FAIL (groq model check: matched a SUBSTRING of a model id — the request sends the exact string, so only exact membership is evidence)"; exit 1; }
  groq_model_ok "openai/gpt-oss-20b" "" && { echo "smoke-test: FAIL (groq model check: an EMPTY model list is an unreachable endpoint, never a pass)"; exit 1; }
  #  no baseline is still 'nothing was measured', exactly as in the paired drill above.
  [ "$(cm "- - - -")" = "na 0 - 0 -" ] || { echo "smoke-test: FAIL (commitment: a dark control means no baseline (na), got '$(cm "- - - -")')"; exit 1; }

  # (5) requisite-variety verdicts — the metabolism's Ashby/Beer resilience read. Pure, hermetic.
  #     RED-first: comment out any branch in metabolism_variety() and its matching assert goes red.
  v(){ metabolism_variety "$@" | awk '{for(i=1;i<=NF;i++) if($i=="—"){print $(i+1);exit}}'; }
  [ "$(v 0 0 0 0 0)" = "metabolism-dark" ]          || { echo "smoke-test: FAIL (variety: all-down should be metabolism-dark, got '$(v 0 0 0 0 0)')"; exit 1; }
  [ "$(v 1 0 0 0 0)" = "metabolism-monoculture" ]   || { echo "smoke-test: FAIL (variety: groq-only should be monoculture)"; exit 1; }
  [ "$(v 0 1 0 0 0)" = "metabolism-monoculture" ]   || { echo "smoke-test: FAIL (variety: local-only should be monoculture)"; exit 1; }
  [ "$(v 1 0 1 1 1)" = "metabolism-cloud-coupled" ] || { echo "smoke-test: FAIL (variety: all-cloud/no-local should be cloud-coupled)"; exit 1; }
  [ "$(v 1 1 0 0 0)" = "ok" ]                        || { echo "smoke-test: FAIL (variety: groq+local should span both classes → ok)"; exit 1; }
  # opencode-free + opencode share ONE subscription → count as ONE unit: groq+oc-free+oc, no local/claude
  # ⇒ 2 independent absorbers (groq, opencode), all cloud ⇒ cloud-coupled (NOT ok, NOT independent=3)
  [ "$(metabolism_variety 1 0 1 1 0 | grep -oE 'independent=[0-9]')" = "independent=2" ] \
    || { echo "smoke-test: FAIL (variety: opencode-free+opencode must be ONE unit → independent=2)"; exit 1; }

  # (6) opencode /tmp cdylib reaper — the ONLY thing standing between the metabolism and ~44MB/day
  #     of 5.5MB orphans (see the _oc_tmp_reap header). Hermetic: OC_TMPDIR is redirected at a
  #     scratch dir and the decoys are real files, one of them really held open by a real live
  #     process, so the fd/maps gate is exercised and not merely described.
  #     RED-first, each mutation reddening a DIFFERENT half of the sweep (all four driven live):
  #     make _oc_tmp_reap a no-op → (b) red · make _oc_so_in_use always return 1 → (c) red · drop
  #     the snapshot diff (blanket-delete the glob) → (a) red · delete the `_oc_tmp_reap "$snap"`
  #     call from _oc_extract → the LIVE leg (6b) red (NOT these three, which call the reaper
  #     directly — a hermetic fixture cannot see a caller that forgot to call it).
  ocdir="$(mktemp -d)"; _oc_test_rc=0
  ( OC_TMPDIR="$ocdir"
    : > "$ocdir/.aaaaaaaaaaaaaaaa-00000000.so"     # pre-existing: another caller's in-flight run
    : > "$ocdir/keep-me.txt"                        # non-matching name in the same dir
    snap="$(_oc_tmp_snapshot)"
    : > "$ocdir/.bbbbbbbbbbbbbbbb-00000000.so"     # (b) appeared during our run → must be reaped
    : > "$ocdir/.cccccccccccccccc-00000000.so"     # (c) appeared AND is held open → must survive
    sleep 20 < "$ocdir/.cccccccccccccccc-00000000.so" & held=$!
    sleep 0.3
    _oc_tmp_reap "$snap"
    kill "$held" 2>/dev/null
    [ -f "$ocdir/.aaaaaaaaaaaaaaaa-00000000.so" ] || { echo "smoke-test: FAIL (oc-reap: unlinked a .so that PREDATED the run — a blanket glob-delete would eat another process's in-flight cdylib)"; exit 1; }
    [ -f "$ocdir/keep-me.txt" ] || { echo "smoke-test: FAIL (oc-reap: touched a file outside the .<hex>-00000000.so pattern)"; exit 1; }
    [ -f "$ocdir/.bbbbbbbbbbbbbbbb-00000000.so" ] && { echo "smoke-test: FAIL (oc-reap: the .so that APPEARED during the run was left behind — this is the leak, unswept)"; exit 1; }
    [ -f "$ocdir/.cccccccccccccccc-00000000.so" ] || { echo "smoke-test: FAIL (oc-reap: unlinked a .so still HELD OPEN by a live process — the fd gate did not fire)"; exit 1; }
    [ "$OC_REAPED" = 1 ] || { echo "smoke-test: FAIL (oc-reap: count says $OC_REAPED, expected exactly 1 reaped)"; exit 1; }
    exit 0 ) || _oc_test_rc=1
  rm -rf "$ocdir"
  [ "$_oc_test_rc" = 0 ] || exit 1

  # (6b) THE LIVE LEG — opt-in, because it is a real network inference (~15s) and --test is driven
  #      hourly by mesh-doctor. This is the assertion that the reaper is aimed at the REAL writer
  #      and not at a fixture of our own imagination: run the shipped _oc_extract and assert /tmp
  #      gained no .so. MESH_RELAY_TEST_LIVE=1 mesh-relay --test
  if [ "${MESH_RELAY_TEST_LIVE:-0}" = 1 ] && command -v opencode >/dev/null 2>&1; then
    # Two vacuity guards, both learned red here: (i) _oc_extract must EXIST at this point in the
    # file — it used to be defined *below* the --test block, so this leg called a missing function,
    # exited 127 into /dev/null and passed forever; (ii) the call must actually have SERVED, because
    # an opencode that dies in 0.1s extracts no cdylib either, and "no new file" would then be the
    # inference failing, not the sweep working.
    declare -F _oc_extract >/dev/null || { echo "smoke-test: FAIL (oc-reap live: _oc_extract is not defined here — this leg would assert nothing)"; exit 1; }
    live_before="$(_oc_tmp_snapshot | wc -l)"
    live_ans="$(_oc_extract "reply with the single word pong" 2>/dev/null)"
    live_after="$(_oc_tmp_snapshot | wc -l)"
    [ -n "$live_ans" ] || { echo "smoke-test: FAIL (oc-reap live: opencode served nothing, so the leak was never exercised — re-run when the pool is up, do not read this as a clean sweep)"; exit 1; }
    [ "$live_after" -le "$live_before" ] || { echo "smoke-test: FAIL (oc-reap live: a real opencode run left $((live_after-live_before)) orphan .so in $OC_TMPDIR)"; exit 1; }
    # NOTE the FILE COUNTS are the evidence here, never OC_REAPED: _oc_extract ran inside a command
    # substitution, so its OC_REAPED assignment died with that subshell and would print 0 even on a
    # perfect sweep. before==after while the reap-deleted arm goes before+1 IS the artifact.
    echo "smoke-test: live oc leg ok (served; $OC_TMPDIR .so count $live_before -> $live_after)"
  fi

  # Config presence (separate from the logic check above): at least one pool must be reachable to route.
  pools=""
  [ -n "${GROQ_API_KEY:-}" ] && pools="$pools groq"
  command -v mesh-local-mind >/dev/null 2>&1 && pools="$pools local"
  command -v opencode >/dev/null 2>&1 && pools="$pools opencode-free opencode"
  command -v claude >/dev/null 2>&1 && pools="$pools claude"
  [ -n "${pools# }" ] || { echo "smoke-test: FAIL (no inference pool configured)"; exit 1; }
  echo "smoke-test: ok (parse dry-runs + chaos-seam verified; the drill's CONTROL ARM asserts a moved route reads RESILIENT while the SAME pool serving both arms reads VACUOUS not RESILIENT, a dark control is na not DEGRADED, and the answer axis refuses an empty and a served-but-wrong reply; opencode's /tmp cdylib reaper unlinks only what APPEARED and only when nobody holds it; pools:$pools)"; exit 0
fi

# --- Groq pool ---
groq_infer() {
  chaos_kill groq && return 1
  [ -n "${GROQ_API_KEY:-}" ] || return 1
  local prompt="$1" req resp
  req="$(python3 -c "$GROQ_REQ_PY" "$GROQ_MODEL" "$prompt")"
  resp="$(curl -s -m 30 https://api.groq.com/openai/v1/chat/completions \
    -H "Authorization: Bearer $GROQ_API_KEY" -H "Content-Type: application/json" -d "$req" 2>/dev/null)" || return 1
  printf '%s' "$resp" | python3 -c "$GROQ_RESP_PY"
}

# --- local pool (qwen via SSH) ---
local_infer() {
  chaos_kill local && return 1
  command -v mesh-local-mind >/dev/null 2>&1 || return 1
  mesh-local-mind "$1" 2>/dev/null
}

# --- opencode-free pool (free models via opencode: no subscription quota used) ---
opencode_free_infer() {
  chaos_kill opencode-free && return 1
  command -v opencode >/dev/null 2>&1 || return 1
  OPENCODE_MODEL="$FREE_MODEL" _oc_extract "$@"
}

# --- opencode pool (OpenCode Go subscription) ---
opencode_infer() {
  chaos_kill opencode && return 1
  command -v opencode >/dev/null 2>&1 || return 1
  _oc_extract "$@"
}

# --- claude pool (Claude Max subscription via CLI) ---
claude_infer() {
  chaos_kill claude && return 1
  command -v claude >/dev/null 2>&1 || return 1
  local out
  out="$(timeout 60 claude -p "$1" 2>/dev/null)" || return 1
  [ -n "$out" ] && printf '%s\n' "$out" || return 1
}

# --- status ---
if [ "${1:-}" = --status ]; then
  # Capture each probe's result (0/1) as we print, so the requisite-variety read below reuses the
  # SAME reachability --status already measures — no second probe, no new claim. NOTE the honest
  # limit --status has always had: groq is a live network probe; local/opencode/claude are
  # PRESENCE-only (command -v) — so the variety read inherits presence-as-reachable for those three
  # and is a config-topology read, not a live-egress read (the cloud-coupled disturbance it names is
  # exactly the egress axis presence cannot see, so it FLAGS the risk rather than asserting the outage).
  gr=0 lo=0 ocf=0 oc=0 cl=0
  printf 'groq:     '
  if [ -n "${GROQ_API_KEY:-}" ]; then
    _gm="$(curl -sf -m6 https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY" 2>/dev/null \
            | python3 -c 'import json,sys;print(" ".join(m["id"] for m in json.load(sys.stdin).get("data",[])))' 2>/dev/null)"
    if [ -z "$_gm" ]; then echo "key set, unreachable"
    elif groq_model_ok "$GROQ_MODEL" "$_gm"; then gr=1; echo "reachable (serving $GROQ_MODEL)"
    else echo "key ok + endpoint reachable, but GROQ_MODEL '$GROQ_MODEL' is NOT on this account ($(printf '%s' "$_gm" | wc -w) models offered) — the pool CANNOT serve; set MESH_GROQ_MODEL to one of them. Counted as DOWN, because reachable is not serving."; fi
  else echo "no key (~/.mesh/groq.env)"; fi
  printf 'local:    '; if command -v mesh-local-mind >/dev/null 2>&1; then lo=1; echo "present"; else echo "absent"; fi
  printf 'opencode-free: '; if command -v opencode >/dev/null 2>&1; then ocf=1; echo "$FREE_MODEL"; else echo "absent (no opencode)"; fi
  printf 'opencode: '; if command -v opencode >/dev/null 2>&1; then oc=1; opencode --version 2>/dev/null | tr -d '\n'; echo " ($(opencode stats 2>/dev/null | grep -oE '\$[0-9.]+' | head -1 || echo 'subscription'))"; else echo "absent"; fi
  printf 'claude:   '; if command -v claude >/dev/null 2>&1; then cl=1; claude --version 2>/dev/null | head -1; else echo "absent"; fi
  metabolism_variety "$gr" "$lo" "$ocf" "$oc" "$cl"
  exit 0
fi

# --- warm-local: JIT-warm the local fallback model so a failover doesn't pay a cold model-load ---
# Maps the "minimize downtime on failure" brief to our served-model stack: there is no worker CODE to
# compile, but the analogous cost is a COLD MODEL LOAD — and a fallover happens exactly when the primary
# (groq) fails, which is precisely when the local model is most likely evicted/cold. Warming it just-in-time
# (before the primary fully fails, or right after detecting degradation) turns a multi-second cold-start
# fallover into a warm one. Deliberately NOT a 24/7 keep-warm reflex: holding a model resident forever wastes
# the GPU the senses (STT/vision) need — ollama's keep_alive ages it out on its own. On-demand only.
if [ "${1:-}" = --warm-local ]; then
  command -v ollama >/dev/null 2>&1 || { echo "mesh-relay --warm-local: no ollama here (no local pool to warm)" >&2; exit 2; }
  wm="${2:-}"
  [ -n "$wm" ] || wm="$(ollama ps   2>/dev/null | awk 'NR==2{print $1}')"   # already-resident model, if any
  [ -n "$wm" ] || wm="$(ollama list 2>/dev/null | awk 'NR==2{print $1}')"   # else the first installed model
  [ -n "$wm" ] || { echo "mesh-relay --warm-local: no local model installed to warm" >&2; exit 2; }
  t0=$(date +%s%3N)
  printf 'reply with exactly: ok' | timeout 60 ollama run "$wm" >/dev/null 2>&1 \
    || { echo "mesh-relay --warm-local: warm call failed for '$wm' (model down / OOM)" >&2; exit 1; }
  dt=$(( $(date +%s%3N) - t0 ))
  echo "mesh-relay --warm-local: '$wm' warm in ${dt}ms — local fallback resident; a groq-down fallover now skips the cold-start"
  exit 0
fi

# --- chaos-drill: inject a fault and verify the fallover chain still serves the request ---
# Real chaos engineering: force the primary pool(s) to fail, then confirm the mesh's inference
# surface degrades gracefully to a fallback instead of going dark. No operator action; cheap by
# default (only free/local pools are exercised — a drill never silently burns paid quota).
#
# ── THE DRILL HAS A CONTROL ARM (2026-08-19) ────────────────────────────────────────────────
# Lo, Schulz, Jensen & Kurtz, "Experimental Removal of Niche Construction Alters the Pace and
# Mechanisms of Resistance Evolution", bioRxiv 2025.03.27.645637 (posted 2025-04-01, CC-BY).
# They KNOCK OUT a niche-constructing organ — RNAi of the gene the red flour beetle needs to make
# its quinone-rich stink-gland secretion, the "external immunity" it builds into its own flour —
# and then run experimental evolution against Bacillus thuringiensis with the organ and without.
# The headline is what an endpoint assay would have MISSED: "all bacteria-exposed regimes rapidly
# evolved bacterial resistance within only six generations. However, beetles evolving with intact
# niche construction acquired resistance as soon as after three generations." At generation six
# the two arms are indistinguishable. The whole effect of the removed organ lives in two places
# no endpoint reading can reach — a RATE difference (3 vs 6 generations) and a MECHANISM
# difference (RNAseq: "gene expression differed strongly between the selection regimes, revealing
# that the mechanisms underlying resistance were dependent on niche construction"). What makes
# both visible is the DESIGN: a paired assay, knockout arm beside an intact CONTROL arm, read
# BEFORE convergence rather than at it.
#
# This drill was the endpoint-only assay. It injected the fault, watched something answer, and
# printed RESILIENT with a latency that had nothing to compare against. Two consequences:
#   * VACUOUS DRILL — if the injected pool was ALREADY down (an expired groq key, a geo-block, a
#     quota wall), the fault removes nothing, the same fallback that had been serving all along
#     answers, and the drill prints RESILIENT. A green drill that exercised nothing: "a gate you
#     have not seen FAIL is not a gate", reached from the other side. Nothing in the old output
#     could distinguish it from a real fallover.
#   * AN UNANCHORED NUMBER — "served by local in 2100ms" is not a cost. It is a cost only against
#     what the SAME assay costs with the pool intact. The old code compared it instead to a
#     hardcoded 1500ms threshold: a constant calibrated once, and a constant calibrated once rots
#     (mesh-sound-reflex's n=29 medians, +37/+14/+3/+103/+51% adrift by the time anyone looked).
# So: run the assay TWICE — knockout arm first, then the intact control — and report the PAIRED
# result. WHICH pool served each arm is the mechanism axis; Δlatency against this node's own
# control, measured minutes apart, is the rate axis. Honest limits, stated in the output line: the
# arms are SEQUENTIAL and n=1, so Δ carries the moment's network variance and is a paired sample,
# never a rate; and because the knockout arm runs FIRST, any cross-arm warming lands on the
# control, which can only INFLATE Δ, never hide it — a small Δ is trustworthy, a large one may be
# partly load order. Cost: two probe inferences per drill instead of one, on free/local pools.
if [ "${1:-}" = --chaos-drill ]; then
  drill_pools="${2:-groq}"                                   # default: fail the primary (groq)
  prompt="${MESH_RELAY_CHAOS_PROMPT:-Reply with exactly one word: pong}"
  paid_ok="${MESH_RELAY_CHAOS_PAID:-0}"                      # 1 → also allow opencode/claude fallover

  # ONE ARM of the paired assay: the real fallover ladder run under a given fault set. Echoes
  # "served|lat_ms|total_ms|out". Runs in a subshell at every call site, so the CHAOS_POOLS it
  # sets can never leak into the arm that follows it — the control arm must be genuinely intact.
  drill_arm() { # $1 = CHAOS_POOLS for this arm ("" = the intact control)
    CHAOS_POOLS="$1"
    local _p _served="" _out="" _lat=0 _ps _d0
    _d0=$(date +%s%3N)
    for _p in groq local opencode-free $([ "$paid_ok" = 1 ] && echo "opencode claude"); do
      _ps=$(date +%s%3N)                                     # per-pool clock — the served pool's latency IS the downtime
      case "$_p" in
        groq)          _out="$(groq_infer "$prompt")"          && [ -n "$_out" ] && _served=groq          ;;
        local)         _out="$(local_infer "$prompt")"         && [ -n "$_out" ] && _served=local         ;;
        opencode-free) _out="$(opencode_free_infer "$prompt")" && [ -n "$_out" ] && _served=opencode-free ;;
        opencode)      _out="$(opencode_infer "$prompt")"      && [ -n "$_out" ] && _served=opencode      ;;
        claude)        _out="$(claude_infer "$prompt")"        && [ -n "$_out" ] && _served=claude        ;;
      esac
      [ -n "$_served" ] && { _lat=$(( $(date +%s%3N) - _ps )); break; }
    done
    printf '%s|%s|%s|%s\n' "$_served" "$_lat" "$(( $(date +%s%3N) - _d0 ))" \
      "$(printf '%s' "$_out" | tr '\n|' '  ')"
  }

  # --- --depth: the CUMULATIVE-PREFIX sweep → the point of commitment (see drill_commitment) ----
  # One arm per depth: remove the first d pools of the ladder, d = 1,2,3… Stops at the FIRST dark
  # arm — there is nothing to learn below the commitment point, and every arm costs an inference.
  # COST is stated up front because it is the reason this is not the default: 1 control + up to N
  # probe inferences on free/local pools (paid only under MESH_RELAY_CHAOS_PAID=1).
  # WARMING, and which direction it can lie in: the control runs FIRST, so anything it warms (the
  # local model, an opencode session) helps the DEEPER arms serve — the measured depth is therefore
  # OPTIMISTIC, never pessimistic. That is the safe direction: SINGLE-POINT and a shallow depth are
  # the alarm, and warming cannot manufacture them. A deep verdict is the one to distrust.
  if [ "$drill_pools" = --depth ]; then
    ladder="groq local opencode-free"
    [ "$paid_ok" = 1 ] && ladder="$ladder opencode claude"
    nlad=$(printf %s "$ladder" | wc -w)
    echo "[chaos-drill --depth] cumulative-prefix sweep over '$ladder' — up to $((nlad+1)) probe inferences (1 control + one per depth), stopping at the first dark arm..."
    seq_served=""; seq_note=""
    arm="$(drill_arm "")"; IFS='|' read -r d_served _ _ _ <<<"$arm"     # depth 0 = intact control
    seq_served="${d_served:--}"
    if [ -z "$d_served" ]; then
      CHAOS_POOLS=""
      echo "[chaos-drill --depth] n/a — the intact control served NOTHING, so there is no baseline and no prefix below it means anything. The metabolism is down for reasons this sweep did not inject." >&2
      exit 2
    fi
    d=1; pref=""
    while [ "$d" -le "$nlad" ]; do
      pref="$(echo "$ladder" | cut -d' ' -f1-"$d" | tr ' ' ',')"
      arm="$(drill_arm "$pref")"; IFS='|' read -r d_served _ _ _ <<<"$arm"
      seq_served="$seq_served ${d_served:--}"
      seq_note="$seq_note d$d(-$pref)→${d_served:-dark} "
      [ -z "$d_served" ] && break
      d=$((d+1))
    done
    CHAOS_POOLS=""
    read -r cv cdepth cpool ceff cvac <<<"$(drill_commitment "$ladder" "$seq_served")"
    trail="arms: $seq_note| served-by-depth: '$seq_served' (index 0 = intact control, '-' = dark)"
    case "$cv" in
      SINGLE-POINT)
        echo "[chaos-drill --depth] SINGLE-POINT — depth 0: '$cpool' is the ONLY absorber this ladder has. Removing it alone takes the metabolism dark; there is no spare, and a plain --chaos-drill on it would have printed DEGRADED without ever saying the redundancy is zero. $trail" >&2
        exit 1 ;;
      COMMITTED)
        echo "[chaos-drill --depth] COMMITTED at depth $cdepth — the ladder absorbs $cdepth pool removal(s) and commits on '$cpool': it is the LAST pool whose loss still changes whether anything serves. Note which pool this is NOT: the biggest single-knockout effect belongs to '$(echo "$ladder" | cut -d' ' -f1)', which is the most REPLACEABLE pool, not the load-bearing one (arXiv:2606.08275's run-forward confound). EFFECTIVE depth $ceff — removals that actually took away a serving pool$([ "$cvac" = "-" ] || echo " (vacuous, already dark: $cvac — counted in depth, absorbed nothing)"). Depth is optimistic by warming (control ran first), so treat $cdepth as an upper bound. $trail" ;;
      UNCOMMITTED)
        echo "[chaos-drill --depth] UNCOMMITTED — the whole swept ladder ($nlad pools) was removed and '$cpool' still served, so the commitment point lies OUTSIDE this sweep$([ "$paid_ok" = 1 ] || echo " (paid pools are unswept; rerun with MESH_RELAY_CHAOS_PAID=1)"). Depth ≥ $cdepth (effective $ceff$([ "$cvac" = "-" ] || echo ", vacuous: $cvac")). $trail" ;;
      na)
        echo "[chaos-drill --depth] n/a — no intact baseline. $trail" >&2; exit 2 ;;
      *)
        echo "[chaos-drill --depth] INCONCLUSIVE — the arm that went dark removed '$(echo "$ladder" | cut -d' ' -f$((cdepth+1)))', but depth $cdepth had been served by '$cpool'. The darkness was NOT caused by the removal this arm made, so this is not a commitment point — a pool went dark on its own mid-sweep. $trail" >&2
        exit 2 ;;
    esac
    exit 0
  fi

  echo "[chaos-drill] fault injected: '$drill_pools' | PAIRED assay: knockout arm, then the intact CONTROL (free/local$([ "$paid_ok" = 1 ] && echo '+paid') pools)..."
  ko="$(drill_arm "$drill_pools")"                           # knockout arm FIRST (see ordering note above)
  ct="$(drill_arm "")"                                       # intact control arm
  CHAOS_POOLS=""                                             # belt-and-braces: nothing below this drills
  IFS='|' read -r ko_served ko_lat ko_total ko_out <<<"$ko"
  IFS='|' read -r ct_served ct_lat ct_total ct_out <<<"$ct"

  # THE MECHANISM AXIS AT THE OUTPUT. mesh-capability-probe already names this gap in its own
  # header: "--chaos-drill proves the fallover chain HOLDS. Neither proves the served output is
  # CORRECT." A route that holds while the ANSWER degrades is the drill's own RNAseq column — the
  # phenotype label survived, the internals did not. Only assertable on the default probe prompt;
  # an operator-supplied MESH_RELAY_CHAOS_PROMPT has no known-good answer, and is said to be so.
  ans_note=""
  if [ -z "${MESH_RELAY_CHAOS_PROMPT:-}" ]; then
    drill_answer_ok "$ko_out" || ans_note=" · ANSWER-DRIFT: the fallback route held but its reply does not contain the probe word 'pong' (got '${ko_out:-<empty>}') — non-empty is not correct"
    drill_answer_ok "$ct_out" || ans_note="$ans_note · (the CONTROL arm's reply also missed 'pong' — this is the node's baseline, not a knockout effect)"
  else
    ans_note=" · answer unchecked (custom MESH_RELAY_CHAOS_PROMPT has no known-good reply)"
  fi

  case "$(drill_verdict "$ko_served" "$ct_served")" in
    na)
      echo "[chaos-drill] n/a — the intact CONTROL arm served NOTHING, so there is no baseline to price a knockout against (knockout arm: '${ko_served:-nothing}'). The metabolism is down for reasons this drill did not inject; nothing about resilience was measured." >&2
      exit 2 ;;
    DEGRADED)
      echo "[chaos-drill] DEGRADED — '$drill_pools' down AND no free/local fallback served, while the intact control WAS served by '$ct_served' in ${ct_lat}ms" \
           "(paid-only pools remain; rerun with MESH_RELAY_CHAOS_PAID=1 to test paid fallover)" >&2
      exit 1 ;;
    VACUOUS)
      echo "[chaos-drill] VACUOUS — '$drill_pools' was not serving anyway: the CONTROL arm was also served by '$ct_served' (${ct_lat}ms, vs knockout ${ko_lat}ms). The injected fault removed nothing, so this run is NOT evidence that the fallover chain holds.$ans_note" >&2
      exit 2 ;;
    *)
      d=$(( ko_lat - ct_lat ))
      warn=""
      [ "$ko_served" = local ] && [ "$d" -gt "${MESH_RELAY_WARM_MS:-1500}" ] \
        && warn=" — the Δ is dominated by what looks like a COLD model-load; pre-warm with 'mesh-relay --warm-local' (this threshold is an absolute cold-start hint, NOT the drill's verdict, which is the control-anchored Δ above)"
      echo "[chaos-drill] RESILIENT — '$drill_pools' down: route '$ct_served'→'$ko_served', ${ko_lat}ms vs control ${ct_lat}ms (Δ${d}ms; n=1 PAIRED sample, arms sequential and knockout-first, so warming can only inflate Δ — not a rate). ${ko_total}ms incl. failed-pool timeouts. RESILIENT is a DEPTH-1 claim: one spare and four spares print this same word, and the knocked-out pool is the most REPLACEABLE one, not the load-bearing one — 'mesh-relay --chaos-drill --depth' measures the commitment point.$warn$ans_note"
      exit 0 ;;
  esac
fi

# --- zero-trust attestation (opt-in; default OFF keeps the relay read-only + streaming) ---
# MESH_RELAY_ATTEST=1 → every served inference emits a tamper-evident receipt into the hash-linked
# transparency log (mesh-relay-attest). A consumer then verifies WHICH pool produced an output and
# that it was not altered, WITHOUT trusting this node. Off by default: the run path below is unchanged
# and no side effect is written. See mesh-relay-attest for the chain contract + `verify`/`check`.
ATTEST="${MESH_RELAY_ATTEST:-0}"
run_pool() { # $1=pool-name  $2=model-attribution  $3=infer-fn  $4=prompt ; prints output, rc=success
  local name="$1" model="$2" fn="$3" prompt="$4" out
  if [ "$ATTEST" = 1 ] && command -v mesh-relay-attest >/dev/null 2>&1; then
    out="$("$fn" "$prompt")" && [ -n "$out" ] || return 1
    printf '%s\n' "$out"
    mesh-relay-attest record "$name" "$model" "$prompt" "$out" >/dev/null 2>&1 || true
    return 0
  fi
  "$fn" "$prompt"   # default path: stream straight through, no capture, no side effect
}

# --- pick the prompt + optional forced pool ---
POOL=""
if [ "${1:-}" = --pool ]; then POOL="${2:-}"; shift 2; fi
PROMPT="$*"
[ -n "${PROMPT// /}" ] || PROMPT="$(cat)"
[ -n "${PROMPT// /}" ] || { echo "usage: mesh-relay \"<prompt>\"  (or pipe via stdin)" >&2; exit 1; }

# --- route (each pool named with its model attribution for the attestation receipt) ---
case "$POOL" in
  groq)          run_pool groq          "$GROQ_MODEL"           groq_infer          "$PROMPT" && exit 0; echo "mesh-relay: groq failed" >&2; exit 1 ;;
  local)         run_pool local         "local-mind"            local_infer         "$PROMPT" && exit 0; echo "mesh-relay: local failed" >&2; exit 1 ;;
  opencode-free) run_pool opencode-free "$FREE_MODEL"           opencode_free_infer "$PROMPT" && exit 0; echo "mesh-relay: opencode-free failed" >&2; exit 1 ;;
  opencode)      run_pool opencode      "opencode-subscription" opencode_infer      "$PROMPT" && exit 0; echo "mesh-relay: opencode failed" >&2; exit 1 ;;
  claude)        run_pool claude        "claude-cli"            claude_infer        "$PROMPT" && exit 0; echo "mesh-relay: claude failed" >&2; exit 1 ;;
  heavy)
    # Skip free tiers — use subscription-grade inference
    run_pool opencode "opencode-subscription" opencode_infer "$PROMPT" && exit 0
    run_pool claude   "claude-cli"            claude_infer   "$PROMPT" && exit 0
    echo "mesh-relay: heavy pools failed (opencode + claude)" >&2; exit 1 ;;
  "")
    # Auto: cheapest available first
    run_pool groq          "$GROQ_MODEL"           groq_infer          "$PROMPT" && exit 0
    run_pool local         "local-mind"            local_infer         "$PROMPT" && exit 0
    run_pool opencode-free "$FREE_MODEL"           opencode_free_infer "$PROMPT" && exit 0
    run_pool opencode      "opencode-subscription" opencode_infer      "$PROMPT" && exit 0
    run_pool claude        "claude-cli"            claude_infer        "$PROMPT" && exit 0
    echo "mesh-relay: ALL pools failed — no inference available" >&2; exit 1 ;;
  *) echo "mesh-relay: unknown pool '$POOL' (groq|local|opencode-free|opencode|claude|heavy)" >&2; exit 2 ;;
esac
