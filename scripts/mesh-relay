#!/usr/bin/env bash
# mesh-relay — the mesh's METABOLISM: brainless inference router. text → cheapest AVAILABLE pool → text.
# One routable inference surface immune to any single pool's quota/geo-block — a mind (or any script)
# gets an answer as long as ONE pool is up. Pools, in preference order:
#   1. Groq  (fast cloud, generous free tier; key in ~/.mesh/groq.env) — primary
#   2. local mind (qwen via mesh-local-mind over SSH — quota+geo-block IMMUNE) — fallback
# Brainless: no model on the critical path; survives topology churn. (Roadmap #5.)
#
#   mesh-relay "<prompt>"            route to the best available pool, print the answer
#   echo "<prompt>" | mesh-relay
#   mesh-relay --pool groq|local "<prompt>"   force a specific pool
#   mesh-relay --status             which pools are reachable right now
#   mesh-relay --test               smoke test
#
# Never prints the API key. Read-only inference (no side effects).
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -f "$HOME/.mesh/groq.env" ] && . "$HOME/.mesh/groq.env"
GROQ_MODEL="${MESH_GROQ_MODEL:-llama-3.1-8b-instant}"

if [ "${1:-}" = --test ]; then
  command -v curl >/dev/null 2>&1 || { echo "smoke-test: FAIL (no curl)"; exit 1; }
  command -v python3 >/dev/null 2>&1 || { echo "smoke-test: FAIL (no python3)"; exit 1; }
  # At least ONE inference pool must be CONFIGURED, or the relay is HOLLOW — every route fails while
  # smoke stays green (dead-but-green on the geo-block-resilience backbone). Config check only (no
  # network): live reachability is --status's job; a smoke test must not FAIL on a transient offline env.
  pools=""
  [ -n "${GROQ_API_KEY:-}" ] && pools="$pools groq"
  command -v mesh-local-mind >/dev/null 2>&1 && pools="$pools local"
  [ -n "${pools# }" ] || { echo "smoke-test: FAIL (no inference pool configured — relay hollow: no GROQ_API_KEY + no mesh-local-mind)"; exit 1; }
  echo "smoke-test: ok (pools:$pools)"; exit 0
fi

# --- Groq pool: POST to the OpenAI-compatible endpoint, extract the text. Returns 1 on any failure. ---
groq_infer() {
  [ -n "${GROQ_API_KEY:-}" ] || return 1
  local prompt="$1" req resp
  req="$(python3 -c 'import json,sys; print(json.dumps({"model":sys.argv[1],"messages":[{"role":"user","content":sys.argv[2]}]}))' "$GROQ_MODEL" "$prompt")"
  resp="$(curl -s -m 30 https://api.groq.com/openai/v1/chat/completions \
    -H "Authorization: Bearer $GROQ_API_KEY" -H "Content-Type: application/json" -d "$req" 2>/dev/null)" || return 1
  printf '%s' "$resp" | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
    if "choices" in d: print(d["choices"][0]["message"]["content"], end=""); sys.exit(0)
    sys.exit(1)   # error object (rate-limit / bad key) → let the caller fall back
except Exception:
    sys.exit(1)'
}

# --- local pool: the shared local mind (qwen via SSH) — already quota+geo-block immune ---
local_infer() {
  command -v mesh-local-mind >/dev/null 2>&1 || return 1
  mesh-local-mind "$1" 2>/dev/null
}

# --- status ---
if [ "${1:-}" = --status ]; then
  printf 'groq:  '; [ -n "${GROQ_API_KEY:-}" ] && { curl -sf -m6 https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY" >/dev/null 2>&1 && echo reachable || echo "key set, unreachable"; } || echo "no key (~/.mesh/groq.env)"
  printf 'local: '; command -v mesh-local-mind >/dev/null 2>&1 && echo "present" || echo "absent"
  exit 0
fi

# --- pick the prompt + optional forced pool ---
POOL=""
if [ "${1:-}" = --pool ]; then POOL="${2:-}"; shift 2; fi
PROMPT="$*"
[ -n "${PROMPT// /}" ] || PROMPT="$(cat)"
[ -n "${PROMPT// /}" ] || { echo "usage: mesh-relay \"<prompt>\"  (or pipe via stdin)" >&2; exit 1; }

# --- route ---
case "$POOL" in
  groq)  groq_infer "$PROMPT" && exit 0; echo "mesh-relay: groq failed (forced)" >&2; exit 1 ;;
  local) local_infer "$PROMPT" && exit 0; echo "mesh-relay: local mind failed (forced)" >&2; exit 1 ;;
  "")    groq_infer "$PROMPT" && exit 0
         local_infer "$PROMPT" && exit 0
         echo "mesh-relay: ALL pools failed (groq + local) — no inference available" >&2; exit 1 ;;
  *)     echo "mesh-relay: unknown pool '$POOL' (groq|local)" >&2; exit 2 ;;
esac
