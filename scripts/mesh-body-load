#!/usr/bin/env bash
# orphan-ok: on-demand electrical-load probe — the phone body's DISCHARGE/CHARGE RATE (how fast it is
#   burning or taking energy), a third battery axis alongside level (mesh-body-power) and temperature
#   (mesh-body-thermal). Source: termux-battery-status current_average (µA) — RELIABLE (same API as the
#   other body-battery senses; not a flaky termux-sensor). mesh-body-power's header explicitly calls the
#   discharge RATE "the missing adaptive signal" (no projected time-to-empty); this reads it. Operator
#   wires a scheduled axis by replacing this stamp with `# reflex-cadence: <cron>` + mesh-autowire.
# mesh-body-load — the body phone's electrical LOAD sense (charge/discharge rate → usage intensity).
#
# WHY THIS IS NEW: mesh-body-power reads percentage/status (level); mesh-body-thermal reads temperature;
# mesh-battery-rate reads the NODE's sysfs rate. NOTHING interprets the PHONE's current_average — the
# instantaneous draw, which is a usage-intensity signal no level reading gives:
#   IDLE    < 80 mA drain    screen-off / background (a parked phone trickles)
#   LIGHT   80-250 mA        light use (messaging, occasional wake)
#   ACTIVE  250-600 mA       screen-on use (browsing, reading)
#   HEAVY   >= 600 mA        gaming / camera / hotspot / call / nav
#   CHARGING (plugged)       rate-in bands: TRICKLE / CHARGING / FAST-CHARGE
# The rate is ADAPTIVE: a fast drain on a half-full battery = "will die soon under this load" — the
# time-to-empty lead that mesh-body-power notes it lacks. Distinct from a one-shot level snapshot.
#
# Honest-exit contract: phone-unreachable OR a battery read with no current_average → exit 2, never a
# fabricated load (an unread ammeter is NOT "IDLE").
#
#   mesh-body-load           one load line
#   mesh-body-load --json    {load, rate_ma, charging, plugged, status, percentage, ts}
#   mesh-body-load --edge    emit only on load-band change
#   mesh-body-load --test    classify fixtures (offline) + reachability gate (exit 2 = n/a)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes" 2>/dev/null || true
STATE="$HOME/.mesh/.body-load-state"
OFFLINEFILE="$HOME/.mesh/.body-load-offline"

# classify_load <current_average_µA> <plugged> → echoes "BAND|reason" (pure, offline-testable).
# current_average sign is convention-dependent across phones, so magnitude drives the band and the
# plugged/status field (not the sign) drives charge vs discharge — robust.
classify_load() {
  local ua="$1" plugged="$2"
  local ma; ma="$(awk -v u="${ua:-0}" 'BEGIN{ if(u==""){print 0} else {x=(u<0?-u:u); printf "%.1f", x/1000 } }')"
  local charging=0; [ "$plugged" != "UNPLUGGED" ] && [ -n "$plugged" ] && charging=1
  if [ "$charging" = 1 ]; then
    if   awk -v m="$ma" 'BEGIN{exit !(m<100)}';  then echo "TRICKLE|charging slowly (~${ma}mA in)"
    elif awk -v m="$ma" 'BEGIN{exit !(m<1000)}'; then echo "CHARGING|charging (~${ma}mA in)"
    else                                               echo "FAST-CHARGE|charging fast (~${ma}mA in)"; fi
  else
    if   awk -v m="$ma" 'BEGIN{exit !(m<80)}';  then echo "IDLE|low drain (~${ma}mA) - screen-off/background"
    elif awk -v m="$ma" 'BEGIN{exit !(m<250)}'; then echo "LIGHT|light drain (~${ma}mA) - light use"
    elif awk -v m="$ma" 'BEGIN{exit !(m<600)}'; then echo "ACTIVE|active drain (~${ma}mA) - screen-on use"
    else                                             echo "HEAVY|heavy drain (~${ma}mA) - gaming/camera/hotspot/call"; fi
  fi
}

if [ "${1:-}" = --test ]; then
  command -v ssh >/dev/null 2>&1 || { echo "smoke-test: FAIL (no ssh)"; exit 1; }
  command -v awk >/dev/null 2>&1 || { echo "smoke-test: FAIL (no awk)"; exit 1; }
  command -v mesh-phone-ip >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-phone-ip)"; exit 1; }
  _f=0
  b(){ classify_load "$1" "$2" | cut -d'|' -f1; }
  # Discharge bands (unplugged) by magnitude (µA):
  [ "$(b 40000    UNPLUGGED)" = IDLE ]   || { echo "  FAIL: 40mA drain → IDLE"; _f=1; }      # 40mA
  [ "$(b 150000   UNPLUGGED)" = LIGHT ]  || { echo "  FAIL: 150mA drain → LIGHT"; _f=1; }    # 150mA
  [ "$(b 400000   UNPLUGGED)" = ACTIVE ] || { echo "  FAIL: 400mA drain → ACTIVE"; _f=1; }   # 400mA
  [ "$(b 900000   UNPLUGGED)" = HEAVY ]  || { echo "  FAIL: 900mA drain → HEAVY"; _f=1; }    # 900mA
  # Charging bands (plugged):
  [ "$(b 50000    AC)" = TRICKLE ]     || { echo "  FAIL: 50mA in → TRICKLE"; _f=1; }
  [ "$(b 500000    USB)" = CHARGING ]  || { echo "  FAIL: 500mA in → CHARGING"; _f=1; }
  [ "$(b 1500000   WIRELESS)" = FAST-CHARGE ] || { echo "  FAIL: 1500mA in → FAST-CHARGE"; _f=1; }
  # Negative current_average (discharge-sign) still classifies by magnitude:
  [ "$(b -300000  UNPLUGGED)" = ACTIVE ] || { echo "  FAIL: -300mA (signed) → ACTIVE by magnitude"; _f=1; }
  [ "$_f" = 0 ] || { echo "smoke-test: FAIL (classify_load bands)"; exit 1; }
  # reachability gate
  source "$HOME/.local/bin/mesh-patterns.sh" 2>/dev/null || true
  if command -v phone_reachable_ip >/dev/null 2>&1; then
    phone_reachable_ip >/dev/null 2>&1 || { echo "smoke-test: n/a (phone unreachable — load unavailable); classify-logic ok"; exit 2; }
  else
    _pip="$(mesh-phone-ip 2>/dev/null)" || { echo "smoke-test: n/a (phone unreachable); classify-logic ok"; exit 2; }
    timeout 10 ssh -p "${PHONE_SSH_PORT:-8022}" -o BatchMode=yes -o ConnectTimeout=6 \
      -o StrictHostKeyChecking=accept-new "${PHONE_USER:-u0_a380}@$_pip" 'command -v termux-battery-status' </dev/null >/dev/null 2>&1 \
      || { echo "smoke-test: n/a (phone unreachable or no termux-battery-status); classify-logic ok"; exit 2; }
  fi
  echo "smoke-test: ok (8 load-band assertions [IDLE/LIGHT/ACTIVE/HEAVY + TRICKLE/CHARGING/FAST-CHARGE + signed] + reachability)"; exit 0
fi

EDGE=0; JSON=0
for a in "$@"; do case "$a" in --edge) EDGE=1;; --json) JSON=1;; esac; done

pip="$(mesh-phone-ip 2>/dev/null)" || {
  if [ ! -f "$OFFLINEFILE" ]; then echo "phone unreachable — can't read load (not an alarm)" >&2; touch "$OFFLINEFILE"; fi
  exit 2
}
rm -f "$OFFLINEFILE" 2>/dev/null || true

j="$(timeout 15 ssh -p "${PHONE_SSH_PORT:-8022}" -o BatchMode=yes -o ConnectTimeout=6 \
  -o StrictHostKeyChecking=accept-new "${PHONE_USER:-u0_a380}@$pip" 'termux-battery-status' </dev/null 2>/dev/null)"
[ -n "$j" ] || {
  if [ ! -f "$OFFLINEFILE" ]; then echo "phone load SSH failed (not an alarm)" >&2; touch "$OFFLINEFILE"; fi
  exit 2
}

parsed="$(printf '%s' "$j" | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(1)
cur = d.get("current_average")
plugged = d.get("plugged", "UNKNOWN")
status = d.get("status", "UNKNOWN")
pct = d.get("percentage")
print("\t".join(str(x) if x is not None else "" for x in (cur, plugged, status, pct)))
' 2>/dev/null)" || { echo "load parse failed — not a battery JSON (not an alarm)" >&2; exit 2; }
[ -n "$parsed" ] || { echo "load parse failed (not an alarm)" >&2; exit 2; }
cur="${parsed%%$'\t'*}"; rest="${parsed#*$'\t'}"
plugged="${rest%%$'\t'*}"; rest="${rest#*$'\t'}"
status="${rest%%$'\t'*}"; pct="${rest#*$'\t'}"
# HONEST: no current_average in the read → cannot assess rate, NEVER a faked IDLE
[ -n "$cur" ] || { echo "battery read had no current_average — load n/a (not faked)" >&2; exit 2; }

verdict="$(classify_load "$cur" "$plugged")"
band="${verdict%%|*}"; reason="${verdict#*|}"
rate_ma="$(awk -v u="$cur" 'BEGIN{x=(u<0?-u:u); printf "%.0f", x/1000}')"
charging=0; [ "$plugged" != "UNPLUGGED" ] && [ -n "$plugged" ] && charging=1

# Write STATE every run (unconditional → mtime = ran-live, not change-gated).
printf '%s\n' "$band" > "$STATE"
TS="$(date -u +%Y-%m-%dT%H:%MZ)"

if [ "$JSON" = 1 ]; then
  printf '{"load":"%s","rate_ma":%s,"charging":%s,"plugged":"%s","status":"%s","percentage":"%s","ts":"%s"}\n' \
    "$band" "$rate_ma" "$([ "$charging" = 1 ] && echo true || echo false)" "$plugged" "$status" "${pct:-}" "$TS"
  exit 0
fi
if [ "$EDGE" = 1 ]; then
  prev="$(cat "$STATE.prev" 2>/dev/null || true)"; printf '%s\n' "$band" > "$STATE.prev"
  [ "$band" = "$prev" ] && exit 0
fi
printf '[body-load-%s] %s — %s | %s mA, %s/%s (%s%%)\n' \
  "${band,,}" "$band" "$reason" "$rate_ma" "$([ "$charging" = 1 ] && echo charging || echo unplugged)" "${status,,}" "${pct:-?}"
