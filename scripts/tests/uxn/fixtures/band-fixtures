# band-fixtures — healthy value BANDS (name  lo  hi). A value is OK only when lo <= value <= hi.
# Real mesh use of a two-edged boundary gate (a longevity/safety window, not a single threshold):
#   mesh-band-gate --name battery 55 band-fixtures   -> OK  (20 <= 55 <= 80)
#   mesh-band-gate --name battery 92 band-fixtures   -> RED (above the longevity band)
battery   20  80      # Li-ion longevity window (charge 20..80% to slow wear)
nvme-c    20  70      # NVMe healthy operating temperature band (degC)
psi       0   40      # PSI-some pressure band: 0..40 healthy, above = memory/io stall
