#!/usr/bin/env bash
# orphan-ok: on-demand pointer-presence probe, mind/fusion-invoked LIVE (the LIVE-ONLY mind-probe
#   class, like mesh-keypresence/body-context/tamper) — NOT a cron reflex, no per-run cache by design.
# mesh-pointer-presence — PHYSICAL pointer-presence sense: is a human moving the mouse/touchpad on
# THIS node RIGHT NOW? The complement of mesh-keypresence (keyboard). Together they cover the two
# person-only physical-interaction channels; a body reading+scrolling with zero keystrokes still
# drives the pointer, so this catches presence that the keyboard sense (QUIET) misses.
#
# WHY this is a NEW, distinct sense (not covered by the existing perception set):
#   - It is a GOLD person-specific signal (the appliance-vs-person trap, memory appliance-vs-person-
#     fusion-trap): a pointer event can ONLY be produced by a human hand at this physical machine —
#     unlike mic-LOUD / a BLE-device count, which a TV/speaker/appliance fakes.
#   - mesh-keypresence deliberately senses the KEYBOARD ONLY and explicitly DISCLAIMS the pointer:
#     the touchpad/USB-mouse IRQ is shared+contaminated (touchpad shares idma64; the USB mouse rides
#     the shared xhci host-controller IRQ), so the clean /proc/interrupts isolation it uses for the
#     keyboard is IMPOSSIBLE for the pointer. The only device-ISOLATED path is evdev
#     (/dev/input/event* filtered to pointer handlers) — which is exactly what this reads.
#   - It separates PHYSICAL from REMOTE presence: remote SSH/tmux (pts) sessions never emit a local
#     pointer event; only a body at this laptop does.
#
# SOURCE: /dev/input/event* for the POINTER handlers (discovered from /proc/bus/input/devices —
# every block whose `H: Handlers=` names a `mouseN`). We open all pointer evdev nodes for a short
# window and count bytes emitted: any bytes => a real pointer event fired => ACTIVE. Idle => 0 bytes.
#
# PRIVILEGE + HONEST degradation (the no-faked-reading rule):
#   - evdev nodes are root:input mode 0660. A normal user without the `input` group cannot read them
#     (this is exactly why mesh-keypresence avoided evdev). This sense reads them via the `input`
#     group if present, else via passwordless `sudo -n`. If NEITHER works (no input group AND no
#     passwordless sudo) => EXIT 2 "unreachable" — NEVER a fake IDLE.
#   - No pointer device at all (headless VM/server) => EXIT 2 "unreachable", NOT a fake IDLE.
#     Absence-of-hardware must read differently from a real quiet (mesh-land treats exit 2 as a pass).
#   - IDLE means "no pointer event in the sample window" — NOT a claim of human absence (a person can
#     sit still / type without touching the pointer). ACTIVE is the only positive assertion.
#
# Usage:
#   mesh-pointer-presence            sample (default 3s window) -> ACTIVE | IDLE + bytes/events
#   mesh-pointer-presence <seconds>  custom window
#   mesh-pointer-presence --once     alias for a single sample (same as default)
#   mesh-pointer-presence --json     machine-readable line
#   mesh-pointer-presence --test     smoke test (pure classifier + device-parse + REAL-READ gate)
#   exit 0 = real reading · exit 2 = no readable pointer evdev on this node (sense unreachable)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
HOST="$(hostname)"
EVBYTES=24  # sizeof(struct input_event) on 64-bit (16B time64 + u16 type + u16 code + s32 value)

# --- classify_pointer <bytes_in_window>: PURE, offline-testable. Given the byte-count read from the
# pointer evdev node(s) over the window, echo "SOURCE|reason". >0 bytes => a pointer event fired.
classify_pointer() {
  local bytes="${1:-0}"
  case "$bytes" in ''|*[!0-9]*) bytes=0 ;; esac
  if [ "$bytes" -gt 0 ]; then
    echo "ACTIVE|physical pointer input (~$(( bytes / EVBYTES )) evdev event(s), ${bytes}B) — a human hand is on this machine"
  else
    echo "IDLE|no pointer event in window (NOT 'absent' — a person may sit still / type without the mouse)"
  fi
}

# --- pointer_event_nodes <proc-bus-input-devices-text>: echo the pointer /dev/input/eventN paths,
# one per line. A block qualifies iff its `H: Handlers=` line names a `mouseN` (evdev pointer). We
# pull the eventN token from that same Handlers line. Keyboard-only blocks (no mouseN) are excluded.
pointer_event_nodes() {
  awk '
    /^H: Handlers=/ && /mouse[0-9]/ {
      for (i=1;i<=NF;i++) if ($i ~ /^event[0-9]+$/) print "/dev/input/" $i
    }
  ' <<<"$1"
}

# --- read method: how to read the (root:input 0660) evdev nodes as this user. Echo "direct",
# "sudo", or "" (none). Prefer input-group direct read; fall back to passwordless sudo.
read_method() {
  if id -nG 2>/dev/null | tr ' ' '\n' | grep -qx input; then echo direct; return; fi
  if sudo -n true 2>/dev/null; then echo sudo; return; fi
  echo ""
}

# --- sample_pointer_bytes <method> <win> <dev...>: open all pointer nodes in parallel for <win>s,
# echo the SUMMED byte count. Nodes that fail to open contribute 0 (we gate readability separately).
sample_pointer_bytes() {
  local method="$1" win="$2"; shift 2
  local td dev total=0 n
  td="$(mktemp -d "${TMPDIR:-/tmp}/mesh-ptr.XXXXXX")" || { echo 0; return; }
  for dev in "$@"; do
    if [ "$method" = sudo ]; then
      ( sudo -n timeout "$win" cat "$dev" 2>/dev/null | wc -c > "$td/$(basename "$dev")" ) &
    else
      ( timeout "$win" cat "$dev" 2>/dev/null | wc -c > "$td/$(basename "$dev")" ) &
    fi
  done
  wait
  for dev in "$@"; do n="$(cat "$td/$(basename "$dev")" 2>/dev/null || echo 0)"; total=$(( total + n )); done
  rm -rf "$td"
  echo "$total"
}

# --- readable_nodes <method> <dev...>: echo the subset of nodes we can actually OPEN for reading.
# Probe each with a 0.15s open: rc 124 (timeout killed a blocking read) => openable; else not.
readable_nodes() {
  local method="$1"; shift
  local dev rc
  for dev in "$@"; do
    if [ "$method" = sudo ]; then sudo -n timeout 0.15 cat "$dev" >/dev/null 2>&1
    else timeout 0.15 cat "$dev" >/dev/null 2>&1; fi
    rc=$?
    [ "$rc" = 124 ] && echo "$dev"
  done
}

if [ "${1:-}" = --test ]; then
  _f=0
  # (1) PURE classifier — falsifiable: change the >0 rule and these fail.
  [ "$(classify_pointer 0   | cut -d'|' -f1)" = IDLE   ] || { echo "  FAIL: 0 bytes must be IDLE"; _f=1; }
  [ "$(classify_pointer 48  | cut -d'|' -f1)" = ACTIVE ] || { echo "  FAIL: 48 bytes must be ACTIVE"; _f=1; }
  [ "$(classify_pointer 240 | cut -d'|' -f1)" = ACTIVE ] || { echo "  FAIL: 240 bytes must be ACTIVE"; _f=1; }
  classify_pointer 48 | grep -q '~2 evdev event' || { echo "  FAIL: 48B should render ~2 events"; _f=1; }
  # non-numeric input must not crash → treated as 0/IDLE
  [ "$(classify_pointer xx | cut -d'|' -f1)" = IDLE ] || { echo "  FAIL: garbage bytes must degrade to IDLE"; _f=1; }
  # (2) DEVICE-PARSE — synthetic /proc/bus/input/devices: pull ONLY pointer eventN, exclude kbd-only.
  fixture='I: Bus=0011 Vendor=0001 Product=0001
N: Name="AT Translated Set 2 keyboard"
H: Handlers=sysrq kbd event3
I: Bus=0003 Vendor=093a Product=2510
N: Name="PixArt USB Optical Mouse"
H: Handlers=mouse2 event6
I: Bus=0018 Vendor=06cb Product=ce2d
N: Name="Touchpad"
H: Handlers=mouse1 event5'
  got="$(pointer_event_nodes "$fixture" | tr '\n' ',' )"
  [ "$got" = "/dev/input/event6,/dev/input/event5," ] || { echo "  FAIL: pointer-node parse got '$got' (want event6,event5; kbd event3 excluded)"; _f=1; }
  # keyboard-only fixture → no pointer nodes
  [ -z "$(pointer_event_nodes 'H: Handlers=sysrq kbd event3')" ] || { echo "  FAIL: kbd-only must yield no pointer node"; _f=1; }
  [ "$_f" = 0 ] || { echo "smoke-test: FAIL (classifier/parse logic)"; exit 1; }
  # (3) REAL-READ gate (CLAUDE.md: a sensor --test MUST assert a real hardware read produces data).
  #     exit 2 (honest n/a — no pointer / not readable here) is a PASS (mesh-land treats it so); the
  #     ONLY failure is a present+readable device whose sample yields a non-numeric byte count.
  method="$(read_method)"
  mapfile -t _nodes < <(pointer_event_nodes "$(cat /proc/bus/input/devices 2>/dev/null)")
  if [ -z "$method" ] || [ "${#_nodes[@]}" = 0 ]; then
    echo "smoke-test: ok (7 offline assertions) · REAL-READ: n/a — no pointer evdev / no input-group+sudo on $HOST (honest exit-2 class)"; exit 0
  fi
  mapfile -t _rd < <(readable_nodes "$method" "${_nodes[@]}")
  if [ "${#_rd[@]}" = 0 ]; then
    echo "smoke-test: ok (7 offline assertions) · REAL-READ: n/a — pointer evdev present but unreadable on $HOST (honest exit-2 class)"; exit 0
  fi
  live="$(sample_pointer_bytes "$method" 0.4 "${_rd[@]}")"
  case "$live" in ''|*[!0-9]*) echo "  FAIL: REAL-READ produced non-numeric byte count '$live'"; echo "smoke-test: FAIL"; exit 1 ;; esac
  echo "smoke-test: ok (7 offline assertions) · REAL-READ: live sampled ${#_rd[@]} pointer node(s) on $HOST → ${live}B (parseable) — sense is NOT hollow"
  exit 0
fi

JSON=0; WIN=3
for a in "$@"; do
  case "$a" in
    --json) JSON=1 ;;
    --once) WIN=3 ;;
    ''|*[!0-9]*) : ;;
    *) WIN="$a" ;;
  esac
done

nodes_txt="$(cat /proc/bus/input/devices 2>/dev/null)" || { echo "[pointer] UNREACHABLE — /proc/bus/input/devices unreadable on $HOST" >&2; exit 2; }
mapfile -t NODES < <(pointer_event_nodes "$nodes_txt")
if [ "${#NODES[@]}" = 0 ]; then
  echo "[pointer] UNREACHABLE — no pointer device on $HOST (headless / no mouse/touchpad; not 'idle')" >&2
  exit 2
fi
METHOD="$(read_method)"
if [ -z "$METHOD" ]; then
  echo "[pointer] UNREACHABLE — pointer evdev is root:input 0660 and $USER is not in group 'input' nor has passwordless sudo on $HOST (cannot read; not 'idle')" >&2
  exit 2
fi
mapfile -t RD < <(readable_nodes "$METHOD" "${NODES[@]}")
if [ "${#RD[@]}" = 0 ]; then
  echo "[pointer] UNREACHABLE — pointer evdev present but none readable on $HOST (permission; not 'idle')" >&2
  exit 2
fi

bytes="$(sample_pointer_bytes "$METHOD" "$WIN" "${RD[@]}")"
verdict="$(classify_pointer "$bytes")"
source="${verdict%%|*}"; reason="${verdict#*|}"
ts="$(date -u +%FT%TZ)"

if [ "$JSON" = 1 ]; then
  printf '{"source":"%s","bytes":%s,"events":%s,"nodes":%s,"method":"%s","window_s":%s,"reason":"%s","ts":"%s"}\n' \
    "$source" "$bytes" "$(( bytes / EVBYTES ))" "${#RD[@]}" "$METHOD" "$WIN" "$reason" "$ts"
  exit 0
fi
echo "[pointer] $source — $reason (${#RD[@]} pointer node(s), ${WIN}s window, via ${METHOD}) @ $HOST"
exit 0
