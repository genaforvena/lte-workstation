#!/usr/bin/env bash
# reflex-cadence: */5 * * * *
# mesh-cpu-transitions — CPU frequency-transition activity from the kernel's monotonic counters.
#
# Reads every cpufreq policy's stats/total_trans and reports the delta since the last live run.
# This is distinct from mesh-cpufreq's time-in-state residency: it sees how often the governor
# is changing P-states, not where the CPU spent its time. Missing policies, malformed counters,
# reboot resets, and a missing baseline are UNKNOWN; no zero is invented for absent evidence.
#
#   mesh-cpu-transitions        one live transition-delta reading
#   mesh-cpu-transitions --json machine-readable reading
#   mesh-cpu-transitions --test fixture arithmetic + REAL kernel-counter read
#
# Exit codes: 0 = reading produced; 2 = counter organ unreachable or evidence is unknown.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

ROOT="${MESH_CPU_TRANSITIONS_ROOT:-/sys/devices/system/cpu/cpufreq}"
STATE="${MESH_CPU_TRANSITIONS_STATE:-$HOME/.mesh/.cpu-transitions-state}"
BOOT_FILE="${MESH_CPU_TRANSITIONS_BOOT_FILE:-/proc/sys/kernel/random/boot_id}"

read_snapshot() {
  local root="$1" total=0 n=0 f v
  shopt -s nullglob
  local files=("$root"/policy*/stats/total_trans)
  shopt -u nullglob
  for f in "${files[@]}"; do
    [ -r "$f" ] || continue
    v=$(tr -d '[:space:]' <"$f" 2>/dev/null) || continue
    case "$v" in ''|*[!0-9]*) continue;; esac
    total=$((total + v)); n=$((n + 1))
  done
  [ "$n" -gt 0 ] || return 1
  printf '%s|%s\n' "$n" "$total"
}

classify_delta() {
  local delta="$1"
  case "$delta" in
    ''|*[!0-9]*) printf 'UNKNOWN|no valid transition delta';;
    0) printf 'QUIET|no policy transition in interval';;
    *) printf 'ACTIVE|%s policy transitions in interval' "$delta";;
  esac
}

emit() {
  local mode="${1:-text}" boot now snap n total prev_boot prev_total delta verdict reason
  boot=$(tr -d '[:space:]' <"$BOOT_FILE" 2>/dev/null) || boot=""
  snap=$(read_snapshot "$ROOT") || {
    printf '[cpu-transitions] UNKNOWN — no readable cpufreq stats/total_trans under %s\n' "$ROOT" >&2
    return 2
  }
  n=${snap%%|*}; total=${snap#*|}; now=$(date -u +%FT%TZ)
  prev_boot=""; prev_total=""
  if [ -r "$STATE" ]; then
    IFS='|' read -r prev_boot prev_total <"$STATE"
  fi
  delta=""
  if [ -n "$boot" ] && [ "$prev_boot" = "$boot" ] &&
     [[ "$prev_total" =~ ^[0-9]+$ ]] && [ "$total" -ge "$prev_total" ]; then
    delta=$((total - prev_total))
  fi
  if [ -n "$delta" ]; then
    IFS='|' read -r verdict reason < <(classify_delta "$delta")
  else
    verdict=UNKNOWN; reason="no same-boot baseline (first run or counter reset)"
  fi
  mkdir -p "$(dirname "$STATE")" 2>/dev/null || return 1
  # State is deliberately only the boot identity and counter baseline; timestamp belongs in the
  # emitted artifact, not in the field the next run parses.
  printf '%s|%s\n' "$boot" "$total" >"$STATE" || return 1
  if [ "$mode" = json ]; then
    printf '{"verdict":"%s","policies":%s,"total_transitions":%s,"delta":%s,"reason":"%s","ts":"%s"}\n' \
      "$verdict" "$n" "$total" "${delta:-null}" "$reason" "$now"
  else
    printf '[cpu-transitions] %s — policies=%s total=%s delta=%s (%s)\n' \
      "$verdict" "$n" "$total" "${delta:-na}" "$reason"
  fi
  [ "$verdict" = UNKNOWN ] && return 2
  return 0
}

if [ "${1:-}" = --test ]; then
  fail=0
  [ "$(classify_delta 0)" = 'QUIET|no policy transition in interval' ] || fail=1
  [ "$(classify_delta 7)" = 'ACTIVE|7 policy transitions in interval' ] || fail=1
  case "$(classify_delta nope)" in UNKNOWN\|*) :;; *) fail=1;; esac
  td=$(mktemp -d "${TMPDIR:-/tmp}/mesh-cpu-transitions.XXXXXX") || exit 1
  mkdir -p "$td/cpufreq/policy0/stats" "$td/cpufreq/policy1/stats"
  printf '10\n' >"$td/cpufreq/policy0/stats/total_trans"
  printf '20\n' >"$td/cpufreq/policy1/stats/total_trans"
  printf 'boot-test|25\n' >"$td/state"
  printf 'boot-test\n' >"$td/boot"
  out=$(MESH_CPU_TRANSITIONS_ROOT="$td/cpufreq" MESH_CPU_TRANSITIONS_STATE="$td/state" \
        MESH_CPU_TRANSITIONS_BOOT_FILE="$td/boot" "$0" --json 2>/dev/null); rc=$?
  printf '%s' "$out" | grep -q '"delta":5' || fail=1
  printf '%s' "$out" | grep -q '"verdict":"ACTIVE"' || fail=1
  [ "$rc" -eq 0 ] || fail=1
  live=$(MESH_CPU_TRANSITIONS_STATE="$td/live-state" "$0" --json 2>/dev/null); rc=$?
  printf '%s' "$live" | grep -q '"total_transitions":[0-9]' || fail=1
  printf '%s' "$live" | grep -q '"policies":[1-9]' || fail=1
  [ "$rc" -eq 0 ] || [ "$rc" -eq 2 ] || fail=1
  rm -rf "$td"
  if [ "$fail" -eq 0 ]; then
    echo "smoke-test: ok (classifier + fixture delta + REAL cpufreq total_trans read)"
    exit 0
  fi
  echo 'smoke-test: FAIL' >&2
  exit 1
fi

case "${1:-}" in
  --json) emit json;;
  '') emit text;;
  *) echo "usage: mesh-cpu-transitions [--json|--test]" >&2; exit 2;;
esac
