#!/usr/bin/env python3
"""Publish only an enumerated Mesh state, never source pane text."""
import re
import importlib.util
import sys
import hashlib
import hmac
import os
import json
import subprocess
import stat
from pathlib import Path

CHANNEL_ROLES = {name: name for name in (
    "adint", "cleaner", "discover", "genome", "haunt", "hire", "job", "minds",
    "pub", "senses", "sound", "tg", "tg-roz", "vpn", "wake", "witness")}
CHANNEL_ROLES["health"] = "check"

SEMANTIC_SOURCES = {
    "tg": "tg-path", "health": "fleet-health", "genome": "vitality",
    "senses": "sense-map", "minds": "mind-wall", "sound": "archivist",
    "vpn": "vpn-probe",
    "discover": "field-study", "job": "job-liability",
    "adint": "obligations", "hire": "obligations",
    "wake": "obligations", "haunt": "obligations", "tg-roz": "roz-intake",
}

def stage_pane_identity(channel: str, pane: str) -> tuple[str, str] | None:
    """Stage only a keyed identity; the runner binds it to a committed feed sequence."""
    tick = os.environ.get("MESH_MISHE_TICK_ID", "")
    prefix = "MISHE-STATE: UNKNOWN\nMISHE-SOURCE: top-pane\nMISHE-FRESHNESS: FRESH\n"
    if not re.fullmatch(r"[0-9a-f]{32}", tick) or not pane.startswith(prefix):
        return
    body = pane[len(prefix):]
    if channel == "witness":
        body = re.sub(r"\AMISHE-VALUE: journal (?:FRESH|STALE|UNKNOWN)\n", "", body, count=1)
    else:
        source_name = "comments" if channel == "pub" else "cleaner" if channel == "cleaner" else "goal"
        body = re.sub(rf"\AMISHE-VALUE: {source_name} (?:FRESH|STALE|UNKNOWN)\n", "", body, count=1)
        if channel == "cleaner":
            body = re.sub(r"\AMISHE-CLEANER: (?:PASS|REVIEW_REQUIRED)\n", "", body, count=1)
        if channel in SEMANTIC_SOURCES:
            body = re.sub(rf"\AMISHE-SEMANTIC: {SEMANTIC_SOURCES[channel]} "
                          r"(?:FRESH|STALE|UNKNOWN|SUSPENDED)\n", "", body, count=1)
    body, separator, _ = body.partition("\nMISHE-END-PANE\n")
    if not separator or len(body.encode("utf-8")) > 65536:
        return
    helper = Path(__file__).with_name("mesh-pane-consume")
    try:
        result = subprocess.run([str(helper), "--pane-identity", channel], input=body + "\n",
                                text=True, capture_output=True, timeout=1)
        event_id = result.stdout.strip()
        if result.returncode or not re.fullmatch(r"[0-9a-f]{64}", event_id):
            return
        home = Path(os.environ.get("MESH_MISHE_HOME", str(Path.home() / ".mesh/mishe-tauftauf")))
        directory = home / "parity" / "staged"
        directory.mkdir(parents=True, exist_ok=True, mode=0o700)
        target = directory / channel
        temp = directory / f".{channel}.{os.getpid()}"
        temp.write_text(json.dumps({"tick": tick, "event_id": event_id}) + "\n")
        os.chmod(temp, 0o600)
        os.replace(temp, target)
        return event_id, tick
    except (OSError, subprocess.TimeoutExpired):
        return

def stage_projection_stamp(channel: str, identity: tuple[str, str] | None,
                           projection: str) -> None:
    """Privately hash the producer inputs during this original projection."""
    if identity is None:
        return
    home = Path(os.environ.get("MESH_MISHE_HOME", str(Path.home() / ".mesh/mishe-tauftauf")))
    try:
        if not stat.S_ISREG((home / ".fleet-corpus-capture").lstat().st_mode):
            return
    except OSError:
        return
    try:
        path = Path(__file__).with_name("mesh_mishe_provenance.py")
        spec = importlib.util.spec_from_file_location("mesh_mishe_provenance", path)
        if spec is None or spec.loader is None:
            return
        module = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(module)
        repo = Path(os.environ.get("MESH_REPO", str(Path(__file__).resolve().parents[1])))
        event_id, tick = identity
        stamp = module.source_stamp(channel, event_id, tick, home, repo, projection)
        if stamp is not None:
            module.stage_source_stamp(home, stamp)
    except Exception:
        # An unavailable private capture cannot suppress the legacy projection.
        return


def keyed_change(channel: str, pane: str) -> str | None:
    """Opaque stable identity for otherwise unclassified frames, never raw text."""
    path = Path(os.environ.get("MESH_MISHE_HOME", str(Path.home() / ".mesh/mishe-tauftauf"))) / "projection.key"
    try:
        if path.stat().st_mode & 0o077:
            return None
        key = path.read_bytes()
    except OSError:
        return None
    if len(key) != 32:
        return None
    lines = []
    for line in pane.splitlines()[1:]:
        if "ticks every frame" in line or line.startswith("-- pane live "):
            continue
        line = re.sub(r"\b\d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ\b", "<time>", line)
        line = re.sub(r"\b\d\d:\d\d:\d\d(?:Z)?\b", "<clock>", line)
        line = re.sub(r"\b\d+(?:s|m|h|d) ago\b", "<age>", line)
        line = re.sub(r"\b(?:age|source age|dispatch age)=\d+s\b", "age=<age>", line)
        lines.append(line)
    normalized = "\n".join(lines[:512]).encode("utf-8")[:65536]
    return hmac.new(key, channel.encode() + b"\0" + normalized, hashlib.sha256).hexdigest()[:24]


def cleaner_projection(pane: str, previous: str) -> str:
    scan_lines = re.findall(
        r"^cleaner scan=(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ) head=([0-9a-f]{40}) "
        r"candidates=(\d+) held=(\d+) actionable=(\d+) delete=(\d+)(?: .*)?$",
        pane, re.MULTILINE,
    )
    unknown_lines = re.findall(r"^unknowns=(\d+)(?: .*)?$", pane, re.MULTILINE)
    task_lines = re.findall(r"^TASK: (PRESENT|NONE|UNKNOWN)$", pane, re.MULTILINE)
    epoch_lines = re.findall(r"^TASK-EPOCH: (\d+|UNKNOWN)$", pane, re.MULTILINE)
    count_lines = re.findall(r"^TASK-EVENT-COUNT: (\d+|UNKNOWN)$", pane, re.MULTILINE)
    event_lines = re.findall(r"^TASK-EVENTS: ([^\n]+)$", pane, re.MULTILINE)
    if any(len(lines) != 1 for lines in (scan_lines, unknown_lines, task_lines, epoch_lines, count_lines, event_lines)):
        return "STATE: UNKNOWN\n"
    if "UNKNOWN" in (task_lines[0], epoch_lines[0], count_lines[0], event_lines[0]):
        return "STATE: UNKNOWN\n"
    event_count = int(count_lines[0])
    recent = [] if event_lines[0] == "NONE" else event_lines[0].split(",")
    if event_count < len(recent) or len(recent) > 16 or (event_count == 0) != (event_lines[0] == "NONE"):
        return "STATE: UNKNOWN\n"
    previous_epoch = 0
    for item in recent:
        match = re.fullmatch(r"(\d+):(open|active|complete|rejected|blocked)", item)
        if not match or int(match.group(1)) <= previous_epoch:
            return "STATE: UNKNOWN\n"
        previous_epoch = int(match.group(1))
    if previous_epoch != int(epoch_lines[0]):
        return "STATE: UNKNOWN\n"
    prior_epoch = re.findall(r"^TASK-EPOCH: (\d+)$", previous, re.MULTILINE)
    prior_count = re.findall(r"^TASK-EVENT-COUNT: (\d+)$", previous, re.MULTILINE)
    if len(prior_epoch) > 1 or len(prior_count) > 1:
        return "STATE: UNKNOWN\n"
    if len(prior_epoch) == 1 and len(prior_count) == 1:
        if int(epoch_lines[0]) < int(prior_epoch[0]) or event_count < int(prior_count[0]):
            return "STATE: UNKNOWN\n"
    _, head, *values = scan_lines[0]
    try:
        candidates, held, actionable, delete, unknowns = [int(value) for value in (*values, unknown_lines[0])]
    except ValueError:
        return "STATE: UNKNOWN\n"
    if held + actionable > candidates or max(candidates, held, actionable, delete, unknowns) > 100000:
        return "STATE: UNKNOWN\n"
    state = "RED" if delete or unknowns else "INTERMEDIATE" if candidates or held or actionable or task_lines[0] == "PRESENT" else "GREEN"
    return (f"STATE: {state}\n"
            f"CLEANER: candidates={candidates} held={held} actionable={actionable} "
            f"delete={delete} unknowns={unknowns} head={head[:12]} "
            f"task={task_lines[0].lower()} task-epoch={epoch_lines[0]} "
            f"task-event-count={event_count} task-events={event_lines[0]}\n")


def fleet_projection(channel: str, pane: str, previous: str = "") -> str:
    """Project renderer-owned freshness and allowlisted values, never private pane text.

    The renderer alone validates the dashboard lease and witness source timestamp.
    Other sources require a named dashboard/header contract before they can claim
    value freshness; a repaint or a constant healthy value proves neither staleness
    nor a source update.
    """
    roles = CHANNEL_ROLES
    if channel not in roles:
        return "STATE: UNKNOWN\n"
    marker = re.match(r"\AMISHE-STATE: (GREEN|RED|INTERMEDIATE|UNKNOWN)\n"
                      r"MISHE-SOURCE: (top-pane|dashboard|unavailable)\n"
                      r"MISHE-FRESHNESS: (FRESH|STALE|UNKNOWN)\n", pane)
    if marker is None:
        return "STATE: UNKNOWN\n"
    state, source, freshness = marker.groups()
    if (source == "unavailable" and freshness != "UNKNOWN") or (freshness == "STALE" and source != "top-pane"):
        return "STATE: UNKNOWN\n"
    value = "value-coverage=unknown"
    value_state = None
    if channel != "witness" and freshness == "FRESH" and source == "top-pane":
        source_name = "comments" if channel == "pub" else "cleaner" if channel == "cleaner" else "goal"
        trusted_value = re.match(rf"MISHE-VALUE: {source_name} (FRESH|STALE|UNKNOWN)\n", pane[marker.end():])
        if trusted_value:
            value_state = trusted_value.group(1)
            value = f"{source_name}={value_state.lower()} value-coverage=partial"
            if value_state == "STALE":
                state = "RED"
    semantic_value = ""
    if channel in SEMANTIC_SOURCES and freshness == "FRESH" and source == "top-pane":
        remaining = pane[marker.end():]
        if trusted_value:
            remaining = remaining[trusted_value.end():]
            semantic_name = SEMANTIC_SOURCES[channel]
            semantic = re.match(rf"MISHE-SEMANTIC: {semantic_name} (FRESH|STALE|UNKNOWN|SUSPENDED)\n",
                                remaining)
            if semantic:
                semantic_value = f"semantic={semantic_name}:{semantic.group(1).lower()}"
                if semantic.group(1) == "STALE":
                    state = "RED"
                elif semantic.group(1) in ("UNKNOWN", "SUSPENDED"):
                    state = "UNKNOWN"
    issue_fields = []
    if channel == "witness" and freshness == "FRESH" and source == "top-pane":
        # This field is in the renderer-owned header, never found by searching
        # the raw witness task rows or its private chat tail.
        trusted = re.match(r"MISHE-VALUE: journal (FRESH|STALE|UNKNOWN)\n", pane[marker.end():])
        if trusted:
            value = f"journal={trusted.group(1).lower()}"
            if trusted.group(1) == "STALE":
                state = "RED"
            elif trusted.group(1) == "UNKNOWN":
                state = "UNKNOWN"
            elif trusted.group(1) == "FRESH":
                remaining = pane[marker.end() + trusted.end():]
                issues = re.match(r"MISHE-ISSUES: (0|[1-9]\d{0,5}) ([0-9a-f]{16})\n", remaining)
                if issues:
                    count, digest = int(issues.group(1)), issues.group(2)
                    issue_fields = [f"mishe-issues={count}", f"issue-digest={digest}"]
                    if count:
                        state = "RED"
    if freshness == "STALE":
        state = "RED"
    if source == "unavailable" or freshness == "UNKNOWN":
        state = "UNKNOWN"
    if channel == "cleaner":
        if freshness != "FRESH" or source != "top-pane" or value_state != "FRESH":
            return f"STATE: {state}\nOBSERVATION: source={source}/cleaner freshness={freshness.lower()} {value}\n"
        remaining = pane[marker.end():].split("\n", 1)[1] if "\n" in pane[marker.end():] else ""
        status = re.match(r"MISHE-CLEANER: (PASS|REVIEW_REQUIRED)\n", remaining)
        state = "RED" if status and status.group(1) == "REVIEW_REQUIRED" else "UNKNOWN"
        return (f"STATE: {state}\nOBSERVATION: source=top-pane/cleaner freshness=fresh "
                f"{value} review={status.group(1).lower() if status else 'unknown'}\n")
    if freshness != "FRESH":
        return f"STATE: {state}\nOBSERVATION: source={source}/{roles[channel]} freshness={freshness.lower()} {value}\n"
    fields = []
    # The following lines are emitted by fixed dashboard code before each role's
    # private text block. The text block itself is never scanned for a verdict.
    if channel == "tg":
        section = pane.split("-- conversation (last 3 each):", 1)[0]
        lines = re.findall(r"^voice-rx (UP|DOWN|WEDGED|UNKNOWN)\b[^\n]{0,160}"
                           r" \| textin (UP|DOWN|WEDGED|UNKNOWN)\b", section, re.MULTILINE)
        if len(lines) == 1:
            rx, textin = lines[0]
            fields = [f"rx={rx.lower()}", f"textin={textin.lower()}"]
            state = "RED" if "DOWN" in lines[0] or "WEDGED" in lines[0] else "GREEN" if lines[0] == ("UP", "UP") else "UNKNOWN"
    elif channel == "tg-roz":
        section = pane.split("-- conversation (roz-in.log", 1)[0]
        lines = re.findall(r"^roz-channel offset [^\n]{0,100} \| send (ok|BLOCKED: 403 \([^\n]{0,80}\))$", section, re.MULTILINE)
        if len(lines) == 1:
            send = "blocked" if lines[0].startswith("BLOCKED") else "ok"
            fields = [f"send={send}"]
            state = "RED" if send == "blocked" else "UNKNOWN"
    elif channel == "vpn":
        section = pane.split("-- VPN USERS", 1)[0]
        lines = re.findall(r"^  ONLINE \((\d{1,3})\)   OFFLINE \((\d{1,3})\)   total (\d{1,3})$", section, re.MULTILINE)
        if len(lines) == 1:
            online, offline, total = map(int, lines[0])
            if online + offline == total:
                fields = [f"peers-online={online}", f"peers-offline={offline}"]
    elif channel == "job":
        section = pane.split("-- newest 8", 1)[0]
        if section.count("-- pipeline by state --") == 1:
            fields = ["pipeline=present"]
        elif section.count("-- pipeline EMPTY:") == 1:
            fields = ["pipeline=empty"]
    elif channel == "witness":
        section = pane.split("chat.log: showing", 1)[0]
        lines = re.findall(r"^tasks: (\d{1,6}) total · (\d{1,6}) unfinished · (\d{1,6}) rejected · (\d{1,6}) done · "
                           r"\[RUNNING=(\d{1,6}) UNOWNED=(\d{1,6}) QUEUED=(\d{1,6}) BLOCKED=(\d{1,6}) "
                           r"HREJ=(\d{1,6}) HEXP=(\d{1,6})\]$", section, re.MULTILINE)
        if len(lines) == 1:
            values = tuple(map(int, lines[0]))
            total, unfinished, rejected, done, running, unowned, queued, blocked, hrej, hexp = values
            if total == unfinished + rejected + done and unfinished == running + unowned + queued + blocked + hrej + hexp:
                fields = [f"tasks-total={total}", f"tasks-unfinished={unfinished}", f"tasks-unowned={unowned}"]
        fields.extend(issue_fields)
    # A fresh repaint is not evidence that an unregistered source value is fresh.
    if value_state == "STALE" or semantic_value.endswith(":stale"):
        state = "RED"
    if state == "GREEN" and (value == "value-coverage=unknown" or value_state is not None):
        state = "UNKNOWN"
    if not fields and state == "UNKNOWN":
        change = keyed_change(channel, pane)
        if change:
            fields = [f"view-change={change}"]
    safe = " ".join(fields)
    identity = hashlib.sha256(f"{channel}:{state}:{freshness}:{value}:{semantic_value}:{safe}".encode()).hexdigest()[:16]
    return (f"STATE: {state}\nOBSERVATION: source={source}/{roles[channel]} freshness=fresh "
            f"{value}" + (f" {semantic_value}" if semantic_value else "") + f" signal={identity}"
            + (f" {safe}" if safe else "") + "\n")


def main() -> int:
    if len(sys.argv) == 3:
        channel, current_path = "synthetic", sys.argv[2]
    elif len(sys.argv) == 5 and sys.argv[1] == "--channel" and sys.argv[2] in CHANNEL_ROLES:
        channel, current_path = sys.argv[2], sys.argv[4]
    else:
        return 2
    try:
        raw = Path(current_path).read_bytes()
        if len(raw) > 65536:
            print("STATE: UNKNOWN")
            return 0
        pane = raw.decode("utf-8")
    except (OSError, UnicodeError):
        print("STATE: UNKNOWN")
        return 0
    identity = stage_pane_identity(channel, pane) if channel != "synthetic" else None
    if channel == "cleaner":
        try:
            previous_raw = Path(sys.argv[3]).read_bytes()
            if len(previous_raw) > 65536:
                raise ValueError("previous frame too large")
            previous = previous_raw.decode("utf-8")
        except (OSError, UnicodeError, ValueError):
            print("STATE: UNKNOWN")
            return 0
        projection = (fleet_projection(channel, pane, previous) if pane.startswith("MISHE-STATE: ")
                      else cleaner_projection(pane, previous))
        stage_projection_stamp(channel, identity, projection)
        sys.stdout.write(projection)
        return 0
    if channel != "synthetic":
        projection = fleet_projection(channel, pane)
        stage_projection_stamp(channel, identity, projection)
        sys.stdout.write(projection)
        return 0
    states = re.findall(r"^STATE: (GREEN|RED|INTERMEDIATE|UNKNOWN)$", pane, re.MULTILINE)
    print("STATE: " + (states[0] if len(states) == 1 else "UNKNOWN"))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
