#!/usr/bin/env python3
"""Publish only an enumerated Mesh state, never source pane text."""
import re
import sys
from pathlib import Path


def main() -> int:
    if len(sys.argv) != 3:
        return 2
    try:
        raw = Path(sys.argv[2]).read_bytes()
        if len(raw) > 65536:
            print("STATE: UNKNOWN")
            return 0
        pane = raw.decode("utf-8")
    except (OSError, UnicodeError):
        print("STATE: UNKNOWN")
        return 0
    states = re.findall(r"^STATE: (GREEN|RED|INTERMEDIATE|UNKNOWN)$", pane, re.MULTILINE)
    print("STATE: " + (states[0] if len(states) == 1 else "UNKNOWN"))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
