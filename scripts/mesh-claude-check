#!/usr/bin/env bash
# mesh-claude-check — corroborate whether Claude Code ACTUALLY works before any mind escalates a
# "claude/anthropic access is DOWN/disabled" claim to a CRITICAL alarm, an operator message, or a
# node-dormancy action.
#
# Cry-wolf guard (2026-06-14): a single `discover` window's TRANSIENT error text — "your organization
# has disabled Claude subscription access for Claude Code" — was asserted GLOBALLY by a mind, posted as
# a CRITICAL board [exception], and propagated UNVERIFIED: a false operator+Danny alarm went out AND
# IdeaPad was set dormant "until org access fixed" — while claude minds worked the entire time (20 board
# events in the next 30 min; the asserting mind was itself a working claude). A transient single-window
# pane-read is NOT a global capability outage. Corroborate first. (Family of torn-read false-FAILs /
# empty != failed.)
#
#   mesh-claude-check          human report + verdict; exit 0=WORKING 1=DOWN(corroborated) 2=INCONCLUSIVE
#   mesh-claude-check --quiet  just the verdict word
#   mesh-claude-check --test   smoke
#
# WORKING if EITHER signal holds: recent claude-MIND work on the board (within MESH_CLAUDE_WINDOW_MIN,
# default 15) OR a running claude process whose pane is NOT sitting on the access/login error.
# RULE: only a CORROBORATED DOWN (exit 1 — an error pane AND no recent mind work) may legitimately drive
# an operator alarm or a node going dormant. WORKING => any "claude is down" claim is a FALSE FLAG.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

if [ "${1:-}" = --test ]; then
  command -v tmux  >/dev/null 2>&1 || { echo "smoke-test: FAIL (no tmux — pane-scan won't work)"; exit 1; }
  command -v awk   >/dev/null 2>&1 || { echo "smoke-test: FAIL (no awk — board parse won't work)"; exit 1; }
  command -v date  >/dev/null 2>&1 || { echo "smoke-test: FAIL (no date — time-window calc won't work)"; exit 1; }
  LOG2="$HOME/.mesh/chat.log"
  if [ ! -f "$LOG2" ]; then
    echo "smoke-test: ok (no board yet — verdict will be INCONCLUSIVE until minds post)"
  else
    lines=$(wc -l < "$LOG2" 2>/dev/null || echo 0)
    echo "smoke-test: ok (board=${lines}l, tmux=$(tmux -V 2>/dev/null | head -1 || echo present))"
  fi
  exit 0
fi

WIN_MIN="${MESH_CLAUDE_WINDOW_MIN:-15}"
LOG="$HOME/.mesh/chat.log"
QUIET=0; [ "${1:-}" = --quiet ] && QUIET=1

# signal 1 — recent claude-MIND board work (minds doing things, not reflexes posting state)
recent=0
if [ -f "$LOG" ]; then
  cut="$(date -u -d "$WIN_MIN min ago" +%Y-%m-%dT%H:%M 2>/dev/null || echo 0)"
  recent="$(awk -v c="$cut" '$1 > c' "$LOG" 2>/dev/null \
    | grep -ciE '(planner|steward|ilya|work|dev|discover|plan)@|\[(done|taking)\] (planner|steward|ilya|work|dev)' 2>/dev/null || echo 0)"
fi

# signal 2 — a running claude pane sitting on the access/login error (the genuine-down signal)
errre='organization has disabled|disabled Claude subscription|Claude Code.*disabled|Use an Anthropic API key instead|invalid api key|authentication required|please (log|sign) ?in'
err_pane=""
if command -v tmux >/dev/null 2>&1; then
  sess="$(hostname)"
  for w in $(tmux list-windows -t "$sess" -F '#{window_index}' 2>/dev/null); do
    if tmux capture-pane -t "$sess:$w" -p -S -8 2>/dev/null | grep -qiE "$errre"; then err_pane="$err_pane $w"; fi
  done
fi
err_pane="$(echo $err_pane)"

if [ "${recent:-0}" -gt 0 ]; then verdict="WORKING"; rc=0
elif [ -n "$err_pane" ]; then verdict="DOWN"; rc=1
else verdict="INCONCLUSIVE"; rc=2; fi   # idle: no work + no error => can't confirm down (not a failure)

if [ "$QUIET" = 1 ]; then echo "$verdict"; exit $rc; fi
echo "=== mesh-claude-check $(hostname) $(date -u +%H:%MZ) ==="
echo "  recent claude-mind board work (${WIN_MIN}m): ${recent:-0}"
echo "  windows showing an access/login error: ${err_pane:-none}"
echo "  VERDICT: $verdict  (exit $rc — 0=working · 1=down-corroborated · 2=inconclusive/idle)"
[ "$verdict" = WORKING ]      && echo "  -> a 'claude access is down/disabled' claim right now is a FALSE FLAG; do NOT alarm the operator."
[ "$verdict" = DOWN ]         && echo "  -> corroborated down: an error pane AND no recent mind work; escalation is legitimate."
[ "$verdict" = INCONCLUSIVE ] && echo "  -> idle, cannot confirm down; do NOT post a CRITICAL outage from this alone."
exit $rc
