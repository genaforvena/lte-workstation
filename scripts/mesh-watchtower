#!/usr/bin/env bash
# reflex-cadence: 13-59/30 * * * *
# reflex-args: --edge
# mesh-watchtower — the mesh's eye on the OUTSIDE. phaedra is the only node with a PUBLIC IP on
# its own uplink (not behind home NAT), so it senses what no NAT'd home node can:
#   1. KNOCKS    — who is scanning/brute-forcing the mesh's public face (inbound :22 attempts).
#   2. REACH     — external reachability from a CLEAN datacenter vantage. It reaches Anthropic where
#                  the RU-egress home nodes get a 403 geo-block (see memory anthropic-geoblock-403) —
#                  a live "can the mesh see X from the outside" probe + a geo-bypass canary.
#   3. EXPOSURE  — what ports the public IP actually offers to the internet (the attack surface).
#   4. RADIATION — the internet BACKGROUND RADIATION spectrum: a bounded tcpdump sample of
#                  unsolicited inbound SYNs on the public NIC, split by the LIVE listen-port set into
#                  PROBES (closed ports — what scanners *want*: telnet, SMB, proxies; invisible to any
#                  log because the kernel RSTs them) vs SERVICE (open ports — counted only; client
#                  source IPs are NEVER logged: the operator/friends ride :8443/:443, and :22 knockers
#                  are already --knocks territory). The mesh's first packet-level sense (2026-07-04):
#                  auth.log sees only sshd's slice; the wire sees the whole spectrum.
# This is the inverse of the phone: the phone is the eye on the ROOM, watchtower is the eye on the NET.
#
#   mesh-watchtower               one fused line: exposure + knock-count + reach (the mesh text substrate)
#   mesh-watchtower --knocks      inbound scan attempts: total + distinct sources + top talkers
#   mesh-watchtower --reach [H]   external reachability from the public vantage (default H=api.anthropic.com)
#   mesh-watchtower --exposure    ports the public IP listens on (what the internet can reach)
#   mesh-watchtower --radiation [S]  ON-DEMAND (not in the --edge cron): sample S seconds (default 30,
#                                 cap 120) of inbound SYN radiation; exit 2 = BLIND (no tcpdump/iface)
#   mesh-watchtower --raw         the raw gathered facts (the artifact behind the line)
#   mesh-watchtower --edge        emit ONLY on a change: reach up/down, or a knock spike (stream-feedable)
#   mesh-watchtower --test        deps + public-node reachability gate (exit 2 = n/a, node unreachable)
#
# Read-only (observes; never acts). Honest-organ: node-unreachable → exit 2, never a fabricated "all clear".
# Public node: root@<phaedra>. Override WATCHTOWER_NODE / WATCHTOWER_REACH / WATCHTOWER_KNOCK_SPIKE.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
{ "$HOME/.local/bin/mesh-pulse" beat watchtower; } >/dev/null 2>&1 || true  # liveness heartbeat (mesh-pulse): edge reflex is silent-on-no-news → needs an explicit per-run pulse
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes"
STATE="$HOME/.mesh/.watchtower-state"      # holds: <knock_total> <reach_up:0|1>
NODE="${WATCHTOWER_NODE:-}"
SELF_HOSTNAME=$(hostname 2>/dev/null || echo "")
IS_SELF=0
if [ "$SELF_HOSTNAME" = "phaedra" ]; then
  IS_SELF=1
  NODE="local"
elif [ -z "$NODE" ]; then
  peer="$(mesh-peer-addr phaedra 2>/dev/null || true)"
  [ -n "$peer" ] || { echo "public node phaedra unreachable — no watchtower read (n/a)" >&2; exit 2; }
  NODE="root@$peer"
fi
REACH_DEFAULT="${WATCHTOWER_REACH:-api.anthropic.com}"
SPIKE="${WATCHTOWER_KNOCK_SPIKE:-200}"     # new inbound attempts since last read that count as a scan spike

ssh_node(){
  if [ "$IS_SELF" = 1 ]; then
    bash -c "$@" </dev/null 2>/dev/null
  else
    timeout 20 ssh -o BatchMode=yes -o ConnectTimeout=6 -o StrictHostKeyChecking=accept-new "$NODE" "$@" </dev/null 2>/dev/null
  fi
}

# System-4 → adaptation coupling (VSM 3-4 homeostat): the watchtower is the mesh's environmental-
# intelligence sense, but its edge events land only in watchtower.log with no consumer — the classic
# atrophied-System-4 pathology (Perez Rios TOP). Push a reach-canary FLIP (a whole-mesh-affecting
# change) to the coordination board so a mind can ADAPT, instead of burying it. Honest+sandboxed:
# MESH_TEST_SANDBOX or a missing mesh-chat → dry-run only, never a real post (reflex-test-sandbox rule).
wt_board_notify() {
  local line="$1"
  if [ -n "${MESH_TEST_SANDBOX:-}" ] || ! command -v mesh-chat >/dev/null 2>&1; then
    printf 'would-notify: [sense] %s\n' "$line"   # dry-run / mesh-chat absent → fail-open, no side effect
    return 0
  fi
  MESH_WHO="watchtower@$(hostname 2>/dev/null || echo '?')" mesh-chat "[sense] $line" >/dev/null 2>&1 || true
}

# --- RADIATION classifier (pure: TSV in → one line out; testable on fixtures) ---
# RADSYN src ips are tallied ONLY for closed-port probes (scanners); SYNs to open ports are
# counted per-port with no source identity — service clients (operator/friends) stay unnamed.
RAD_PY='
import sys, os
open_ports=set(); syns=[]; iface=None; blind=None
for ln in sys.stdin.read().splitlines():
    f=ln.split("\t")
    if f[0].startswith("BLIND"): blind=f[0]
    elif f[0]=="RADIFACE" and len(f)>=3: iface=f[1]
    elif f[0]=="RADOPEN" and len(f)>=2:
        try: open_ports.add(int(f[1]))
        except: pass
    elif f[0]=="RADSYN" and len(f)>=3:
        try: syns.append((f[1], int(f[2])))
        except: pass
if blind or not iface:
    print("BLIND %s"%(blind or "no-iface")); sys.exit(0)
svc={}; probes={}; srcs={}
for ip,port in syns:
    if port in open_ports: svc[port]=svc.get(port,0)+1
    else:
        probes[port]=probes.get(port,0)+1
        srcs[ip]=srcs.get(ip,0)+1
def top(d,n): return " ".join("%s×%d"%(k,v) for k,v in sorted(d.items(), key=lambda kv:-kv[1])[:n])
print("[radiation] window=%ss iface=%s syn=%d | probes=%d closed-ports[%s] uniq-src=%d top-src[%s] | service=%d open-ports[%s]"%(
    os.environ.get("RADSECS","?"), iface, len(syns), sum(probes.values()), top(probes,5) or "-",
    len(srcs), top(srcs,3) or "-", sum(svc.values()), top(svc,5) or "-"))
'

# rad_gather_run <secs> — run the bounded SYN capture on the public node (root: tcpdump needs it;
# the watchtower node contract is already root@<phaedra>). Own ssh timeout (secs+15) because
# ssh_node's flat 20s would kill any window ≥ 20s. Remote script is single-quote-free (the
# base64-over-arg idiom, same as remote_gather). Read-only sample; -c 400 bounds the capture.
rad_gather_run() {
  local secs="$1" rg rb
  rg='
command -v tcpdump >/dev/null 2>&1 || { printf "BLIND-notcpdump\n"; exit 0; }
IF=$(ip -4 route get 1.1.1.1 2>/dev/null | grep -oE "dev [a-zA-Z0-9.@_-]+" | head -1 | cut -d" " -f2)
PIP=$(ip -4 -o addr show dev "$IF" scope global 2>/dev/null | awk "{print \$4}" | cut -d/ -f1 | head -1)
[ -n "$IF" ] && [ -n "$PIP" ] || { printf "BLIND-noiface\n"; exit 0; }
printf "RADIFACE\t%s\t%s\n" "$IF" "$PIP"
ss -tlnH 2>/dev/null | awk "{print \$4}" | grep -oE "[0-9]+$" | sort -un | while read -r p; do printf "RADOPEN\t%s\n" "$p"; done
timeout "$1" tcpdump -nn -q -i "$IF" -c 400 "tcp[13] & 2 != 0 and tcp[13] & 16 == 0 and dst host $PIP" 2>/dev/null \
  | awk "{print \$3, \$5}" | while read -r s d; do d="${d%:}"; printf "RADSYN\t%s\t%s\n" "${s%.*}" "${d##*.}"; done
exit 0
'
  rb="$(printf '%s' "$rg" | base64 | tr -d '\n')"
  if [ "$IS_SELF" = 1 ]; then
    bash -c "echo $rb | base64 -d | bash -s -- $secs" </dev/null 2>/dev/null
  else
    timeout "$((secs + 15))" ssh -o BatchMode=yes -o ConnectTimeout=6 -o StrictHostKeyChecking=accept-new "$NODE" \
      "echo $rb | base64 -d | bash -s -- $secs" </dev/null 2>/dev/null
  fi
}

if [ "${1:-}" = --test ]; then
  command -v python3 >/dev/null 2>&1 || { echo "smoke-test: FAIL (no python3)"; exit 1; }
  if [ "$IS_SELF" = 0 ]; then
    command -v ssh >/dev/null 2>&1 || { echo "smoke-test: FAIL (no ssh)"; exit 1; }
    command -v mesh-peer-addr >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-peer-addr)"; exit 1; }
  fi
  mkdir -p "$HOME/.mesh" 2>/dev/null || { echo "smoke-test: FAIL (no ~/.mesh)"; exit 1; }
  # --- board-notify assertions (pure/local — run before the node-reachability n/a gate) ---
  _n="$(MESH_TEST_SANDBOX=1 wt_board_notify 'REACH flip test line')"
  case "$_n" in 'would-notify: [sense] REACH flip test line') ;; *) echo "smoke-test: FAIL (notify dry-run: $_n)"; exit 1;; esac
  _n2="$(PATH=/nonexistent wt_board_notify 'x' 2>/dev/null)"; _rc=$?   # mesh-chat absent → fail-open (no crash, dry-run)
  { [ "$_rc" = 0 ] && [ "$_n2" = 'would-notify: [sense] x' ]; } || { echo "smoke-test: FAIL (notify not fail-open rc=$_rc out=$_n2)"; exit 1; }
  grep -q 'wt_board_notify "\$human"' "$0" || { echo "smoke-test: FAIL (reach-flip board-notify not wired in edge block)"; exit 1; }
  # --- radiation classifier assertions (pure fixtures — no network) ---
  _fx="$(printf 'RADIFACE\teth0\t38.49.216.141\nRADOPEN\t22\nRADOPEN\t8443\nRADSYN\t1.2.3.4\t23\nRADSYN\t1.2.3.4\t8080\nRADSYN\t5.6.7.8\t8443\nRADSYN\t9.9.9.9\t23\n' | RADSECS=30 python3 -c "$RAD_PY")"
  case "$_fx" in *"syn=4"*"probes=3"*"uniq-src=2"*"service=1"*) ;; *) echo "smoke-test: FAIL (radiation fixture classify: $_fx)"; exit 1;; esac
  printf '%s' "$_fx" | grep -q '23×2' || { echo "smoke-test: FAIL (radiation top-port tally: $_fx)"; exit 1; }
  printf '%s' "$_fx" | grep -q '5\.6\.7\.8' && { echo "smoke-test: FAIL (radiation leaked a service-client src ip)"; exit 1; }
  _fb="$(printf 'BLIND-notcpdump\n' | python3 -c "$RAD_PY")"
  case "$_fb" in BLIND*) ;; *) echo "smoke-test: FAIL (radiation BLIND fixture: $_fb)"; exit 1;; esac
  ssh_node 'command -v ss >/dev/null && echo ok' | grep -q ok \
    || { echo "smoke-test: n/a (public node $NODE unreachable or missing ss) [+3 board-notify +5 radiation assertions ok]"; exit 2; }
  # --- radiation REAL-READ gate (node reachable): a 2s capture must identify the public NIC and
  # run tcpdump on it (RADIFACE emitted). 0 SYNs in 2s is a valid real reading (radiation is bursty);
  # BLIND (no tcpdump/iface on the node) is an honest n/a, never a fake green. ---
  _rr="$(rad_gather_run 2)"
  if printf '%s' "$_rr" | grep -q '^RADIFACE'; then :
  elif printf '%s' "$_rr" | grep -q '^BLIND'; then
    echo "smoke-test: n/a (radiation BLIND on $NODE: $(printf '%s' "$_rr" | head -1)) [+8 fixture assertions ok]"; exit 2
  else
    echo "smoke-test: FAIL (radiation real-read gave neither RADIFACE nor BLIND: $(printf '%s' "$_rr" | head -c 80))"; exit 1
  fi
  echo "smoke-test: ok (+3 board-notify +5 radiation-fixture assertions, real NIC capture on $NODE)"; exit 0
fi

mode=summary; reach_host="$REACH_DEFAULT"; edge=0; rad_secs=30
prev=""
while [ $# -gt 0 ]; do
  case "$1" in
    --knocks) mode=knocks;;
    --exposure) mode=exposure;;
    --reach) mode=reach; [ -n "${2:-}" ] && case "$2" in --*) ;; *) reach_host="$2"; shift;; esac;;
    --radiation) mode=radiation; case "${2:-}" in [0-9]|[0-9][0-9]|[0-9][0-9][0-9]) rad_secs="$2"; shift;; esac;;
    --raw) mode=raw;;
    --edge) edge=1;;
  esac; shift
done

if [ "$mode" = radiation ]; then
  [ "$rad_secs" -ge 5 ] 2>/dev/null || rad_secs=5
  [ "$rad_secs" -le 120 ] 2>/dev/null || rad_secs=120
  facts="$(rad_gather_run "$rad_secs")"
  [ -n "$facts" ] || { echo "public node $NODE unreachable — no radiation read (n/a)" >&2; exit 2; }
  out="$(printf '%s\n' "$facts" | RADSECS="$rad_secs" python3 -c "$RAD_PY" 2>/dev/null)"
  case "$out" in
    BLIND*) echo "radiation sense blind on $NODE (${out#BLIND }) — no packet vantage (n/a)" >&2; exit 2;;
    '[radiation]'*) printf '%s\n' "$out"; exit 0;;
    *) echo "radiation classify failed: $(printf '%s' "$out" | head -c 80)" >&2; exit 1;;
  esac
fi

# ONE remote gather: exposure + knock tally + outward reach + egress IP.
# Built as a verbatim remote script (no single quotes inside), base64'd over as an ARG so the
# ssh_node </dev/null stdin guard never collides with it, and reach_host is passed as $1.
remote_gather='
printf "EGRESS\t%s\n" "$(curl -s --max-time 6 https://ifconfig.me 2>/dev/null || echo ?)"
ss -tlnH 2>/dev/null | awk "{print \$4}" | grep -E "^(0\.0\.0\.0|\[::\]):" | sort -u | while read -r p; do printf "EXPOSURE\t%s\n" "$p"; done
kt=$(grep -acE "sshd" /var/log/auth.log 2>/dev/null || echo 0); printf "KNOCKTOTAL\t%s\n" "$kt"
grep -aE "sshd" /var/log/auth.log 2>/dev/null | grep -aoE "from [0-9]+\.[0-9]+\.[0-9]+\.[0-9]+" | awk "{print \$2}" | sort | uniq -c | sort -rn | head -5 | while read -r c ip; do printf "KNOCKSRC\t%s\t%s\n" "$c" "$ip"; command -v geoiplookup >/dev/null 2>&1 && { cc=$(geoiplookup "$ip" 2>/dev/null | grep -oE "[A-Z]{2}, " | head -1 | cut -d, -f1); printf "KNOCKGEO\t%s\t%s\n" "$ip" "${cc:-??}"; }; done
r=$(curl -s -o /dev/null -w "%{http_code} %{time_total} %{remote_ip}" --max-time 8 "https://$1" 2>/dev/null || echo "ERR 0 ?")
printf "REACH\t%s\t%s\n" "$1" "$r"
'
b64="$(printf '%s' "$remote_gather" | base64 | tr -d '\n')"
facts="$(ssh_node "echo $b64 | base64 -d | bash -s -- '$reach_host'")"
[ -n "$facts" ] || { echo "public node $NODE unreachable — no watchtower read (n/a)" >&2; exit 2; }
printf '%s' "$facts" | grep -q 'KNOCKTOTAL' || { echo "watchtower gather failed: $(printf '%s' "$facts" | head -c 80)" >&2; exit 1; }

if [ "$mode" = raw ]; then printf '%s\n' "$facts"; exit 0; fi
[ -f "$STATE" ] && read -r prev _ < "$STATE" 2>/dev/null || true

out="$(printf '%s' "$facts" | PREV_KNOCK="${prev:-}" REACH_HOST="$reach_host" MODE="$mode" SPIKE="$SPIKE" python3 -c '
import sys, os
mode=os.environ["MODE"]; reach_host=os.environ["REACH_HOST"]
expo=[]; ktotal=None; ksrc=[]; geo={}; reach=None; egress="?"
for ln in sys.stdin.read().splitlines():
    f=ln.split("\t")
    if f[0]=="EXPOSURE": expo.append(f[1])
    elif f[0]=="KNOCKTOTAL":
        try: ktotal=int(f[1])
        except: ktotal=0
    elif f[0]=="KNOCKSRC" and len(f)>=3: ksrc.append((int(f[1]), f[2]))
    elif f[0]=="KNOCKGEO" and len(f)>=3: geo[f[1]]=f[2]
    elif f[0]=="REACH" and len(f)>=3: reach=f[2]   # "<code> <time> <ip>"
    elif f[0]=="EGRESS": egress=f[1]
rc, rt, rip = (reach.split()+["?","?","?"])[:3] if reach else ("ERR","0","?")
try: rt="%.2f"%float(rt)
except: rt="0"
reach_up = rc.isdigit() and int(rc) < 500 and rc!="000"
prev=os.environ.get("PREV_KNOCK",""); delta=None
if prev.strip() and ktotal is not None:
    try: delta=ktotal-int(prev)
    except: delta=None

if mode=="knocks":
    top=" ".join("%s(%s×%d)"%(ip,geo.get(ip,"?"),c) for c,ip in ksrc[:5])
    d="Δ%+d"%delta if delta is not None else "Δ?"
    print("KNOCKS total=%s (%s) distinct-top5: %s"%(ktotal, d, top or "none"))
elif mode=="exposure":
    print("EXPOSURE public-facing ports: %s"%(", ".join(expo) or "none"))
elif mode=="reach":
    state="REACHABLE" if reach_up else "UNREACHABLE"
    note=" (geo-bypass canary: home nodes get 403 here)" if "anthropic" in reach_host else ""
    print("[watchtower-reach] %s %s → HTTP %s in %ss via %s%s"%(state, reach_host, rc, rt, rip, note))
else:  # summary
    tag="[watchtower-reach-up]" if reach_up else "[watchtower-reach-down]"
    spike=" SCAN-SPIKE!" if (delta is not None and delta>int(os.environ["SPIKE"])) else ""
    loud=ksrc[0] if ksrc else None
    loudtxt=" loudest=%s(%s×%d)"%(loud[1],geo.get(loud[1],"?"),loud[0]) if loud else ""
    d="Δ%+d"%delta if delta is not None else "Δ?"
    print("%s exposes[%s] knocks=%s(%s)%s%s reach(%s)=HTTP%s/%ss egress=%s"%(
        tag, ",".join(expo) or "-", ktotal, d, spike, loudtxt, reach_host, rc, rt, egress))
print("STATEKEY\t%s\t%s"%(ktotal if ktotal is not None else "", 1 if reach_up else 0))
' 2>/dev/null)"

[ -n "$out" ] || { echo "watchtower classify failed (parse)"; exit 1; }
human="$(printf '%s\n' "$out" | grep -v '^STATEKEY')"
key="$(printf '%s\n' "$out" | grep '^STATEKEY' | head -1)"
nk="$(printf '%s' "$key" | cut -f2)"; nr="$(printf '%s' "$key" | cut -f3)"
[ -n "${nk}${nr}" ] && printf '%s %s\n' "$nk" "$nr" > "$STATE"

if [ "$edge" = 1 ] && [ "$mode" = summary ]; then
  # edge: emit only if reach-state flipped or a scan spike occurred
  prev_reach="$(cat "$STATE.reach" 2>/dev/null || echo "")"; echo "$nr" > "$STATE.reach"
  printf '%s\n' "$human" | grep -q 'SCAN-SPIKE' && { printf '%s\n' "$human"; exit 0; }
  if [ "$nr" != "$prev_reach" ]; then
    # reach-canary FLIP → push to the board (only when we have a prior baseline: first run just
    # prints, never replays). Scan-spikes stay log-only above (known-benign key-only-sshd noise).
    [ -n "$prev_reach" ] && wt_board_notify "$human"
    printf '%s\n' "$human"; exit 0
  fi
  # heartbeat: a weekly logrotate on phaedra zeroes KNOCKTOTAL, so the delta-based spike compare
  # goes quiet for as long as it takes fresh knocks to re-cross SPIKE — a day+ of real silence
  # while cron/mesh-pulse both stay green (found 2026-07-05: log dark since Jul4 05:43 despite
  # 48 clean cron runs). Print at least once per HEARTBEAT window so the artifact itself can't
  # go stale independent of the STATE/pulse liveness checks.
  last="$(stat -c %Y "$HOME/.mesh/watchtower.log" 2>/dev/null || echo 0)"
  now="$(date +%s)"
  [ $(( now - last )) -ge "${WATCHTOWER_HEARTBEAT:-3600}" ] && { printf '%s\n' "$human"; exit 0; }
  exit 0
fi
printf '%s\n' "$human"
