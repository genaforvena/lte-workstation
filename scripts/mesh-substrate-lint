#!/usr/bin/env bash
# orphan-ok: on-demand file check invoked by tests/CI with a path argument, never scheduled.
# mesh-substrate-lint — deterministic single-writer lint for substrate mutations.
#
#   mesh-substrate-lint <tool> [...]   check one or more tool files
#   mesh-substrate-lint --test         self-test (fixtures)
#
# Verdicts per file:
#   SKIP (rc 2): no substrate-mutating command present.
#   PASS (rc 0): mutation present AND claim+dms binding AND no live-mutating --test.
#   HOLD (rc 1): mutation without claim+dms binding, or --test mutates live state.
#
# Claim+dms binding = calls `mesh-claim --check` (or mesh-claim take/hold) AND
# references `mesh-dms` — or documents `# substrate-ok: claim+dms via <caller>`
# when the tool is a library sourced by a caller that holds the claim
# (the justification must name the holding caller after `via`).
set -uo pipefail

MUT_RE='ip[[:space:]]+(route|rule|addr)|nft[[:space:]]|iptables|tailscale[[:space:]]+(set|up)|wg-quick|ufw|firewall-cmd'
CLAIM_RE='mesh-claim[[:space:]]+(--check|take|hold)'
SUBSTRATE_OK_RE='#[[:space:]]*substrate-ok:[[:space:]]*claim\+dms[[:space:]]+via[[:space:]]+[A-Za-z0-9_./-]+'

test_section(){
  # Print the --test block: from first line mentioning --test to the next
  # closing `fi` at column 0 after it. Empty when no --test arm exists.
  awk '/--test/{found=1} found{print} found && /^fi/{exit}' "$1" 2>/dev/null
}

lint_one(){
  local f="$1" body
  [ -f "$f" ] || { echo "HOLD missing-file: $f"; return 1; }
  body="$(cat "$f")"
  grep -qE "$MUT_RE" <<<"$body" || { echo "SKIP no-substrate-mutation: $f"; return 2; }
  # (b) --test must not mutate live state: a mutation inside the --test block
  # is allowed only when sandboxed (unshare -n) or against fixtures/tmp files.
  local tsec
  tsec="$(test_section "$f")"
  if [ -n "$tsec" ] && grep -qE "$MUT_RE" <<<"$tsec"; then
    if ! grep -qE 'unshare|fixture|mktemp|TMPDIR|\$d/|table 1[0-9][0-9]' <<<"$tsec"; then
      echo "HOLD test-mutates-live: $f — --test block mutates live state without unshare -n or fixture tables/files"
      return 1
    fi
  fi
  # (a) claim+dms binding.
  local has_claim=1 has_dms=1
  grep -qE "$CLAIM_RE" <<<"$body" && has_claim=0
  # An invocation (not a comment disclaiming it) or the library exemption.
  DMS_INVOKE_RE='mesh-dms([[:space:]]+(-|[0-9])|\$\(mesh-dms|command -v mesh-dms|`mesh-dms)'
  if grep -qE "$DMS_INVOKE_RE" <<<"$body" || grep -qE "$SUBSTRATE_OK_RE" <<<"$body"; then
    has_dms=0
  fi
  if [ "$has_claim" = 0 ] && [ "$has_dms" = 0 ]; then
    echo "PASS: $f"
    return 0
  fi
  local why=""
  [ "$has_claim" != 0 ] && why="${why}no-mesh-claim "
  [ "$has_dms" != 0 ] && why="${why}no-mesh-dms/substrate-ok "
  echo "HOLD unbound-substrate-write (${why% }): $f — mutation without claim+dms binding"
  return 1
}

if [ "${1:-}" = --test ]; then
  d="$(mktemp -d)"; trap 'rm -rf "$d"' EXIT
  # SKIP: no mutation.
  cat > "$d/clean.sh" <<'EOF'
#!/usr/bin/env bash
echo hello
EOF
  # PASS: mutation + claim + dms.
  cat > "$d/good.sh" <<'EOF'
#!/usr/bin/env bash
mesh-claim --check routing >/dev/null || exit 1
mesh-dms 120 "ip route del throw 10.0.0.0/24 table 52" "mesh-card --exit-node-lan" "ip route add throw 10.0.0.0/24 table 52"
ip route add throw 10.0.0.0/24 table 52
EOF
  # PASS via substrate-ok library exemption naming the caller.
  cat > "$d/lib.sh" <<'EOF'
#!/usr/bin/env bash
# substrate-ok: claim+dms via mesh-exit-node-lan-heal
mesh-claim --check routing >/dev/null || exit 1
ip rule add from all lookup 52
EOF
  # HOLD: mutation, no binding.
  cat > "$d/raw.sh" <<'EOF'
#!/usr/bin/env bash
ip route add default via 10.0.0.1
EOF
  # HOLD: claim but no dms.
  cat > "$d/nodms.sh" <<'EOF'
#!/usr/bin/env bash
mesh-claim --check routing >/dev/null || exit 1
iptables -A INPUT -j DROP
EOF
  # HOLD: substrate-ok without naming the caller.
  cat > "$d/noname.sh" <<'EOF'
#!/usr/bin/env bash
# substrate-ok: claim+dms via
mesh-claim take routing >/dev/null || exit 1
ip addr add 10.0.0.5/24 dev eth0
EOF
  # HOLD: --test block mutates live state bare.
  cat > "$d/badtest.sh" <<'EOF'
#!/usr/bin/env bash
mesh-claim --check routing >/dev/null || exit 1
mesh-dms 60 "x" "y" "ip route add throw 10.0.0.0/24 table 52"
ip route add throw 10.0.0.0/24 table 52
if [ "${1:-}" = --test ]; then
  ip route add throw 10.9.9.0/24 table 52
  ip route del throw 10.9.9.0/24 table 52
fi
EOF
  # PASS: --test mutations sandboxed in unshare.
  cat > "$d/sandboxed.sh" <<'EOF'
#!/usr/bin/env bash
mesh-claim --check routing >/dev/null || exit 1
mesh-dms 60 "x" "y" "ip route add throw 10.0.0.0/24 table 52"
ip route add throw 10.0.0.0/24 table 52
if [ "${1:-}" = --test ]; then
  d=$(mktemp -d)
  sudo -n unshare -n ip route add throw 10.9.9.0/24 table 52
  sudo -n unshare -n ip route del throw 10.9.9.0/24 table 52
fi
EOF
  pass=0; fail=0
  ok(){ local desc="$1"; shift; if "$@" >/dev/null 2>&1; then pass=$((pass+1)); else echo "FAIL: $desc"; fail=$((fail+1)); fi; }
  # use explicit rc checks since lint_one returns 0/1/2
  lint_one "$d/clean.sh" >/dev/null 2>&1; [ $? = 2 ] && pass=$((pass+1)) || { echo "FAIL: clean must SKIP rc=2"; fail=$((fail+1)); }
  lint_one "$d/good.sh" >/dev/null 2>&1; [ $? = 0 ] && pass=$((pass+1)) || { echo "FAIL: good must PASS"; fail=$((fail+1)); }
  lint_one "$d/lib.sh" >/dev/null 2>&1; [ $? = 0 ] && pass=$((pass+1)) || { echo "FAIL: substrate-ok library must PASS"; fail=$((fail+1)); }
  lint_one "$d/raw.sh" >/dev/null 2>&1; [ $? = 1 ] && pass=$((pass+1)) || { echo "FAIL: unbound write must HOLD"; fail=$((fail+1)); }
  lint_one "$d/nodms.sh" >/dev/null 2>&1; [ $? = 1 ] && pass=$((pass+1)) || { echo "FAIL: claim-without-dms must HOLD"; fail=$((fail+1)); }
  lint_one "$d/noname.sh" >/dev/null 2>&1; [ $? = 1 ] && pass=$((pass+1)) || { echo "FAIL: substrate-ok without caller must HOLD"; fail=$((fail+1)); }
  out="$(lint_one "$d/badtest.sh" 2>&1)"; rc=$?
  { [ "$rc" = 1 ] && grep -q test-mutates-live <<<"$out"; } && pass=$((pass+1)) || { echo "FAIL: bare --test mutation must HOLD test-mutates-live (rc=$rc: $out)"; fail=$((fail+1)); }
  lint_one "$d/sandboxed.sh" >/dev/null 2>&1; [ $? = 0 ] && pass=$((pass+1)) || { echo "FAIL: sandboxed --test must PASS"; fail=$((fail+1)); }
  echo "mesh-substrate-lint --test: $pass passed, $fail failed"
  [ "$fail" = 0 ]
  exit $?
fi

[ $# -ge 1 ] || { echo "usage: mesh-substrate-lint <tool> [...] | --test" >&2; exit 2; }
overall=0
for f in "$@"; do
  lint_one "$f" || { rc=$?; [ "$rc" = 1 ] && overall=1; [ "$rc" = 2 ] && [ "$overall" = 0 ] && overall=2; }
done
exit "$overall"
