#!/usr/bin/env bash
# mesh-repo-hygiene — repo scan for INTERNAL DOCS that must never land in git.
#
# Reads THE ONE pattern table in scripts/lib/mesh-internal-docs-patterns.sh —
# the same table scripts/mesh-land enforces as its is_internal_evidence deny-list.
# One table, two readers: a pattern added there binds both guards.
#
# Verdicts per tracked-or-present file, repo-relative:
#   violation — matches the internal-docs table (must not be in git)
#   clean     — an ordinary repo file, no verdict against it
#   unknown   — unreadable path (missing file, permission, non-utf8 name):
#               reported, never folded into clean
#
# Usage: mesh-repo-hygiene [--repo DIR] [--staged] | --test | --check
#   default: scan worktree files (git ls-files + untracked docs/health-warning-*)
#   --staged: scan staged paths only (the pre-commit shape; step wire-guard wires it)
#   --test:   both arms — violation fixture must FAIL the scan, clean fixture must PASS
#   --check:  one-line wiring self-report for mesh-doctor
set -u
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
# shellcheck source=lib/mesh-internal-docs-patterns.sh
. "$SELF_DIR/lib/mesh-internal-docs-patterns.sh"

REPO="${MESH_REPO:-${MESH_GENOME:-$HOME/lte-workstation}}"
MODE=worktree
for a in "$@"; do case "$a" in --test) MODE=test;; --check) MODE=check;; --staged) MODE=staged;; --repo) shift;; --repo=*) REPO="${a#--repo=}";;
  -*) echo "unknown flag: $a" >&2; exit 2;; *) REPO="$a";; esac; shift 2>/dev/null || true; done

scan_list(){
  # stdin: repo-relative paths, one per line. stdout: verdict lines.
  local n_clean=0 n_viol=0 n_unk=0 rel
  while IFS= read -r rel; do
    [ -n "$rel" ] || continue
    if [ ! -e "$REPO/$rel" ]; then printf 'unknown\t%s\tunreadable-or-absent\n' "$rel"; n_unk=$((n_unk+1)); continue; fi
    if is_internal_evidence "$REPO/$rel"; then printf 'violation\t%s\tinternal-evidence\n' "$rel"; n_viol=$((n_viol+1)); continue; fi
    printf 'clean\t%s\tok\n' "$rel"; n_clean=$((n_clean+1))
  done
  printf 'counts\tclean=%d\tviolation=%d\tunknown=%d\n' "$n_clean" "$n_viol" "$n_unk"
}

collect_worktree(){
  ( cd "$REPO" && git ls-files; git ls-files --others --exclude-standard -- 'docs/health-warning-*' 'health-warning-*' ) 2>/dev/null | sort -u
}

collect_staged(){
  ( cd "$REPO" && git diff --cached --name-only ) 2>/dev/null
}

run_scan(){
  local list rc=0 out counts
  case "$MODE" in staged) list="$(collect_staged)";; *) list="$(collect_worktree)";; esac
  out="$(printf '%s\n' "$list" | scan_list)"
  printf '%s\n' "$out" | grep -v '^counts' || true
  counts="$(printf '%s\n' "$out" | grep '^counts' || echo "counts	clean=0	violation=0	unknown=0")"
  printf '%s\n' "$counts"
  case "$counts" in *violation=0*) rc=0;; *) rc=1;; esac
  return $rc
}

run_test(){
  local fail=0 t
  t="$(mktemp -d)" || return 1
  # ARM 1 (violation): a health-warning triage write-up MUST scan as violation.
  mkdir -p "$t/docs" && printf '# triage\n' > "$t/docs/health-warning-triage-20260916.md"
  printf '# pub note\n' > "$t/docs/pub-wifi-rf-decay-note-20260919.md"
  printf '# note\n' > "$t/docs/ordinary-note.md"
  REPO="$t" scan_list <<'EOF' >"$t/arm1.out"
docs/health-warning-triage-20260916.md
docs/pub-wifi-rf-decay-note-20260919.md
docs/ordinary-note.md
EOF
  if grep -q '^violation	docs/health-warning-triage-20260916.md' "$t/arm1.out" \
     && grep -q '^violation	docs/pub-wifi-rf-decay-note-20260919.md' "$t/arm1.out" \
     && grep -q '^clean	docs/ordinary-note.md' "$t/arm1.out"; then
    echo "arm-violation: ok (triage=violation, ordinary=clean)"
  else echo "arm-violation: FAIL"; cat "$t/arm1.out"; fail=1; fi
  # ARM 2 (clean): a tree with NO internal docs must scan 0 violations.
  REPO="$t" scan_list <<'EOF' >"$t/arm2.out"
docs/ordinary-note.md
EOF
  if grep -q 'violation=0' "$t/arm2.out" && grep -q '^clean	docs/ordinary-note.md' "$t/arm2.out"; then
    echo "arm-clean: ok (0 violations)"
  else echo "arm-clean: FAIL"; cat "$t/arm2.out"; fail=1; fi
  # SHARED-TABLE proof: both readers resolve the same function from one file.
  if [ "$(grep -c 'health-warning-' "$SELF_DIR/lib/mesh-internal-docs-patterns.sh")" -ge 1 ] \
     && declare -F is_internal_evidence >/dev/null \
     && grep -q 'mesh-internal-docs-patterns' "$SELF_DIR/mesh-land"; then
    echo "arm-shared-table: ok (one table, mesh-land + hygiene)"
  else echo "arm-shared-table: FAIL"; fail=1; fi
  rm -rf "$t"
  [ "$fail" = 0 ] && echo "hygiene --test: GREEN (both arms)" || echo "hygiene --test: RED"
  return $fail
}

case "$MODE" in
  test) run_test;;
  check) echo "mesh-repo-hygiene: wired (table=$SELF_DIR/lib/mesh-internal-docs-patterns.sh)";;
  *) run_scan;;
esac
