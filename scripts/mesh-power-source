#!/usr/bin/env bash
# mesh-power-source — sense: is the node body on AC power or battery?
# Reads /sys/class/power_supply/ADP0/online (or BAT0/status) to determine
# power source. Critical operational signal: a node on battery with dropping
# charge is at risk of shutdown. No existing mesh tool captures this.
#
# Usage:
#   mesh-power-source          one-shot status line
#   mesh-power-source --json   machine-readable
#   mesh-power-source --test   smoke test (no hardware dependency)
#
# Honest-exit contract:
#   0 = verdict produced (may be UNKNOWN if sysfs data is ambiguous)
#   2 = power supply info unreachable (no sysfs, no battery subsystem)
#   Never fakes a reading — ambiguous data → UNKNOWN, not guessed.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"

# --- Discovery: find the AC adapter and battery ---
AC_PATH=""
BAT_PATH=""
for p in /sys/class/power_supply/*/online; do
  [ -r "$p" ] || continue
  # ADP0 typically = AC adapter online status; BAT0 = battery
  base="$(basename "$(dirname "$p")")"
  case "$base" in
    ADP*|ac*|AC*) AC_PATH="$p" ;;
    *) ;;
  esac
done
# If no ADP path matched above, try generic name
[ -z "$AC_PATH" ] && [ -r /sys/class/power_supply/ADP0/online ] && AC_PATH="/sys/class/power_supply/ADP0/online"

for p in /sys/class/power_supply/*/status; do
  [ -r "$p" ] || continue
  base="$(basename "$(dirname "$p")")"
  case "$base" in
    BAT*|bat*) BAT_PATH="$p"; BAT_BASE="$base" ;;
  esac
done

# --- Read ---
TS="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
HOST="$(hostname)"
SOURCE=""
REASON=""

# Try ADP0 first (most definitive)
if [ -n "$AC_PATH" ]; then
  val="$(cat "$AC_PATH" 2>/dev/null)" || true
  if [ "$val" = "1" ]; then
    SOURCE="AC"; REASON="AC adapter online ($AC_PATH=1)"
  elif [ "$val" = "0" ]; then
    SOURCE="BATTERY"; REASON="AC adapter offline ($AC_PATH=0)"
  fi
fi

# Fallback: use battery status to infer
if [ -z "$SOURCE" ] && [ -n "$BAT_PATH" ]; then
  bat_st="$(cat "$BAT_PATH" 2>/dev/null)" || true
  case "$bat_st" in
    Charging) SOURCE="AC"; REASON="battery charging ($BAT_PATH=$bat_st)" ;;
    Discharging) SOURCE="BATTERY"; REASON="battery discharging ($BAT_PATH=$bat_st)" ;;
    Full|Not\ charging)
      # Ambiguous: could be on AC full, or just idle
      SOURCE="AC"; REASON="battery $bat_st (assumed AC)" ;;
    *)
      SOURCE="UNKNOWN"; REASON="battery status unreadable/ambiguous ($BAT_PATH=$bat_st)" ;;
  esac
fi

# Still no source — try ACPI as a last resort
if [ -z "$SOURCE" ]; then
  if command -v acpi >/dev/null 2>&1; then
    acpi_out="$(acpi -a 2>/dev/null)" || true
    if [ -n "$acpi_out" ]; then
      case "$acpi_out" in
        *on-line*) SOURCE="AC"; REASON="acpi reports on-line" ;;
        *off-line*) SOURCE="BATTERY"; REASON="acpi reports off-line" ;;
      esac
    fi
  fi
fi

# Read battery capacity if available (for context)
CAP_MSG=""
for p in /sys/class/power_supply/*/capacity; do
  [ -r "$p" ] || continue
  base="$(basename "$(dirname "$p")")"
  case "$base" in
    BAT*|bat*)
      cap="$(cat "$p" 2>/dev/null)" || true
      [ -n "$cap" ] && CAP_MSG=" (battery $base at $cap%)"
      ;;
  esac
done

# --- Honest-unreachable gate ---
if [ -z "$SOURCE" ]; then
  echo "power-source: UNREACHABLE — no AC adapter or battery info via /sys/class/power_supply/ or acpi" >&2
  exit 2
fi

json_escape() {
  local s="${1-}"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\r'/\\r}"
  s="${s//$'\t'/\\t}"
  printf '%s' "$s"
}

emit_json() {
  printf '{"source":"%s","reason":"%s","ts":"%s"}\n' \
    "$(json_escape "$SOURCE")" \
    "$(json_escape "$REASON$CAP_MSG")" \
    "$(json_escape "$TS")"
}

# --- Output ---
case "${1:-}" in
  --json)
    emit_json
    ;;
  --test)
    # Smoke test: the tool must produce a source name or exit 2 (unreachable is acceptable)
    if [ -z "$SOURCE" ]; then
      echo "smoke-test: n/a (power supply info unreachable — hardware without battery subsystem — honest)"; exit 2
    fi
    if [ "$SOURCE" = "AC" ] || [ "$SOURCE" = "BATTERY" ] || [ "$SOURCE" = "UNKNOWN" ]; then
      json="$(emit_json)"
      if [[ "$json" != *"\"source\":\"$SOURCE\""* ]] ||
         [[ "$json" != *"\"reason\":\""* ]] ||
         [[ "$json" != *"\"ts\":\"20"*Z\"* ]]; then
        echo "smoke-test: FAIL (bad json output: $json)"
        exit 1
      fi
      echo "smoke-test: ok (source=$SOURCE$CAP_MSG)"
      exit 0
    else
      echo "smoke-test: FAIL (unexpected source='$SOURCE')"; exit 1
    fi
    ;;
  *)
    printf '%s  power-source: %s | %s%s\n' "$TS" "$SOURCE" "$REASON" "$CAP_MSG"
    ;;
esac
