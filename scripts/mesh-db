#!/usr/bin/env python3
"""mesh-db — an EPHEMERAL query LENS over the mesh's flat logs (local SQLite, no server, no sudo).

Ethos (operator, 2026-06-10): "the world should be perceived, not stored." So this is NOT a
permanent accumulating archive — it is a *convenience lens*: build a throwaway DB from the CURRENT
logs on demand, ask a question the flat files can't answer easily, then discard it freely
(`rm ~/.mesh/mesh.db`). No auto-ingest cron, no growing store. The logs (themselves bounded/decaying)
remain the source; this is just a momentary way to query live/recent perception in SQL.

SQLite sidesteps the gated snap-PostgreSQL on ilya. Cross-node by ingesting each node's
presence.log (every line self-tagged with its node): "which BLE devices were near BOTH nodes in
the last hour?" — one query. Rebuild it whenever you want; never rely on it persisting.

  mesh-db init                      create ~/.mesh/mesh.db schema
  mesh-db ingest [--peer u@ip ...]  parse local (+peer) presence.log -> rows (idempotent)
  mesh-db q "<SQL>"                 run a query, print rows
  mesh-db recent [mins]             devices seen in the last N min (default 60), per node
  mesh-db both [mins]               devices seen by 2+ nodes recently (cross-node overlap)

Read-only against the mesh; only writes its own DB. INSERT OR IGNORE on (ts,node,mac) = no dupes.
"""
import sys, os, re, sqlite3, subprocess
from pathlib import Path

MESH = Path.home() / ".mesh"; DB = MESH / "mesh.db"; PLOG = MESH / "presence.log"
LINE = re.compile(r'^(\S+)\s+(\S+)\s+n=\d+\s+devices=\[(.*)\]\s*$')
DEV  = re.compile(r'(-?\d+)\|([0-9A-Fa-f:]{17})\|(.*?)(?=(?:\s-?\d+\|[0-9A-Fa-f:]{17}\|)|$)')

def conn():
    c = sqlite3.connect(str(DB)); c.execute("PRAGMA journal_mode=WAL"); return c

def init():
    c = conn()
    c.execute("""CREATE TABLE IF NOT EXISTS presence(
        ts TEXT, node TEXT, mac TEXT, name TEXT, rssi INTEGER,
        PRIMARY KEY (ts, node, mac))""")
    c.execute("CREATE INDEX IF NOT EXISTS idx_presence_mac ON presence(mac)")
    c.execute("CREATE INDEX IF NOT EXISTS idx_presence_ts ON presence(ts)")
    c.commit(); c.close(); print(f"mesh-db: schema ready at {DB}")

def parse(text):
    rows = []
    for ln in text.splitlines():
        m = LINE.match(ln.strip())
        if not m: continue
        ts, node, body = m.group(1), m.group(2), m.group(3)
        for rssi, mac, name in DEV.findall(body):
            rows.append((ts, node, mac.upper(), name.strip() or "?", int(rssi)))
    return rows

def ingest(peers):
    if not DB.exists(): init()
    c = conn(); total = 0
    srcs = [("local", PLOG.read_text() if PLOG.exists() else "")]
    for p in peers:
        out = subprocess.run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=8", p,
                              "cat ~/.mesh/presence.log"], capture_output=True, text=True, timeout=30)
        srcs.append((p, out.stdout))
    for label, text in srcs:
        rows = parse(text)
        before = c.total_changes
        c.executemany("INSERT OR IGNORE INTO presence(ts,node,mac,name,rssi) VALUES(?,?,?,?,?)", rows)
        c.commit()
        print(f"  {label}: {len(rows)} parsed, {c.total_changes - before} new")
        total += c.total_changes - before
    n = c.execute("SELECT COUNT(*) FROM presence").fetchone()[0]
    print(f"mesh-db: +{total} rows, {n} total"); c.close()

def show(sql, params=()):
    c = conn()
    try: cur = c.execute(sql, params)
    except sqlite3.OperationalError as e: sys.exit(f"mesh-db: SQL error: {e}")
    cols = [d[0] for d in cur.description] if cur.description else []
    if cols: print(" | ".join(cols))
    for r in cur.fetchall(): print(" | ".join(str(x) for x in r))
    c.close()

def main():
    a = sys.argv[1:]
    if not a: sys.exit(__doc__)
    cmd = a[0]
    if cmd == "init": init()
    elif cmd == "ingest":
        peers = [a[i+1] for i, x in enumerate(a) if x == "--peer" and i+1 < len(a)]
        ingest(peers)
    elif cmd == "q": show(a[1] if len(a) > 1 else "SELECT 1")
    elif cmd == "recent":
        mins = int(a[1]) if len(a) > 1 else 60
        show("""SELECT node, name, mac, MAX(rssi) best, COUNT(*) hits
                FROM presence WHERE ts > strftime('%Y-%m-%dT%H:%M:%SZ','now',?)
                GROUP BY node, mac ORDER BY node, best DESC""", (f"-{mins} minutes",))
    elif cmd == "both":
        mins = int(a[1]) if len(a) > 1 else 60
        show("""SELECT mac, MAX(name) name, COUNT(DISTINCT node) nodes, GROUP_CONCAT(DISTINCT node) seen_by
                FROM presence WHERE ts > strftime('%Y-%m-%dT%H:%M:%SZ','now',?)
                GROUP BY mac HAVING nodes >= 2 ORDER BY nodes DESC""", (f"-{mins} minutes",))
    else: sys.exit(__doc__)

if __name__ == "__main__":
    main()
