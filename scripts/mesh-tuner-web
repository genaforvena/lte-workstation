#!/usr/bin/env bash
# mesh-tuner-web — the BASS-CLEF PRACTICE PAGE. mesh-tuner detects the played note (numpy YIN) and
# writes a tiny live snapshot to $TUNER_STATE (note/octave/cents/freq); this serves a browser page
# that draws that note ON A REAL STAFF in bass clef, with a cents needle and a built-in metronome —
# so the operator reads it "как с листа" while practising cello. Operator 2026-06-21: "ноты на экране
# у меня в бас-ключе + тюнер какая нотка как играет + метроном".
#
# The page is STATIC + same-origin: it polls /state (this server re-reads the JSON the tuner writes).
# The metronome is pure browser Web Audio — no server audio, no extra deps. Runs anywhere the tuner's
# state file is reachable (normally the mic node, default-string); open it in a browser on the iMac
# (or ds's own screen). Pure-stdlib python (http.server) — nothing to install.
#
#   mesh-tuner-web              serve on 0.0.0.0:$TUNER_WEB_PORT (default 8770)
#   mesh-tuner-web --port N     serve on port N
#   mesh-tuner-web --url        print the reachable URLs (LAN + tailscale) and exit
#   mesh-tuner-web --test       headless smoke: serve on an ephemeral port, GET / and /state, assert
#
# Tunables (env): TUNER_WEB_PORT=8770 · TUNER_WEB_BIND=0.0.0.0 · TUNER_STATE=$MESH/tuner-state.json
# orphan-ok: an ON-DEMAND operator instrument (opened in a browser while practising), not cron-wired.
set -uo pipefail
[ -f "$HOME/.mesh/restore.env" ] && . "$HOME/.mesh/restore.env" 2>/dev/null || true
MESH="${MESH_DIR:-$HOME/.mesh}"
export TUNER_STATE="${TUNER_STATE:-$MESH/tuner-state.json}"
export TUNER_WEB_PORT="${TUNER_WEB_PORT:-8770}"
export TUNER_WEB_BIND="${TUNER_WEB_BIND:-0.0.0.0}"

case "${1:-}" in
  --port) export TUNER_WEB_PORT="${2:?--port needs a number}"; shift 2;;
  --test) : ;;   # pass through to the python (headless smoke)
  --url)
    ip="$(ip -4 -o addr show scope global 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -1)"
    ts="$(tailscale ip -4 2>/dev/null | head -1)"
    echo "tuner page (open in a browser):"
    [ -n "$ip" ] && echo "  LAN:       http://$ip:$TUNER_WEB_PORT/"
    [ -n "$ts" ] && echo "  tailscale: http://$ts:$TUNER_WEB_PORT/"
    echo "  local:     http://127.0.0.1:$TUNER_WEB_PORT/"
    exit 0 ;;
  -h|--help) sed -n '2,20p' "$0"; exit 0 ;;
esac

PY="$(mktemp /tmp/tunerweb-XXXXXX.py)"; trap 'rm -f "$PY"' EXIT
cat > "$PY" <<'PYEOF'
import os, sys, json, time, threading, urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

STATE = os.environ.get("TUNER_STATE", "")
PORT  = int(os.environ.get("TUNER_WEB_PORT", "8770"))
BIND  = os.environ.get("TUNER_WEB_BIND", "0.0.0.0")

PAGE = r"""<!doctype html><html lang="ru"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>меш · тюнер бас-ключ</title>
<style>
 :root{--bg:#0b1220;--ink:#e8eef7;--line:#9fb3c8;--ok:#4ee6c4;--off:#ffcc55;--dim:#46607a}
 *{box-sizing:border-box} html,body{margin:0;height:100%}
 body{background:radial-gradient(120% 90% at 50% 30%,#11223a,#070b13);color:var(--ink);
   font:16px/1.4 -apple-system,Segoe UI,Roboto,sans-serif;display:flex;flex-direction:column;
   align-items:center;gap:14px;padding:18px 12px 30px}
 h1{font-size:15px;font-weight:600;letter-spacing:.12em;color:var(--dim);margin:0;text-transform:uppercase}
 #note{font-size:64px;font-weight:700;line-height:1;letter-spacing:.02em}
 #note small{font-size:24px;color:var(--dim);font-weight:500}
 #freq{color:var(--dim);font-size:14px;margin-top:-6px}
 .card{background:#0d1726cc;border:1px solid #1d2c41;border-radius:16px;padding:16px 18px;
   box-shadow:0 8px 40px #0008;width:min(560px,96vw)}
 .cents{height:34px;position:relative;margin:10px 2px 4px}
 .cents .bar{position:absolute;top:50%;left:0;right:0;height:3px;background:#23364e;border-radius:3px;transform:translateY(-50%)}
 .cents .center{position:absolute;top:50%;left:50%;width:2px;height:22px;background:#3b5a78;transform:translate(-50%,-50%)}
 .cents .mark{position:absolute;top:50%;width:14px;height:14px;border-radius:50%;background:var(--off);
   transform:translate(-50%,-50%);transition:left .07s linear,background .1s}
 #dir{text-align:center;font-size:14px;color:var(--dim);min-height:18px}
 svg{display:block;margin:0 auto;width:min(520px,92vw);height:auto;background:#0a1322;border-radius:12px}
 .metro{display:flex;align-items:center;gap:12px;flex-wrap:wrap;justify-content:center}
 .metro button{background:var(--ok);color:#04231d;border:0;border-radius:10px;padding:10px 18px;
   font-size:16px;font-weight:700;cursor:pointer}
 .metro button.off{background:#27405a;color:#9fb3c8}
 .metro input[type=range]{width:160px} .metro label{color:var(--dim);font-size:13px}
 #bpmv{font-variant-numeric:tabular-nums;font-weight:700;min-width:3ch;display:inline-block}
 .dot{width:12px;height:12px;border-radius:50%;background:#27405a;transition:background .05s}
 .dot.on{background:var(--ok)} .dots{display:flex;gap:8px}
 .idle #note,.idle svg,.idle .cents{opacity:.35}
</style></head>
<body>
 <h1>меш · бас-ключ · виолончель</h1>
 <div class="card" id="board">
  <div style="text-align:center"><span id="note">—</span><div id="freq">сыграй ноту…</div></div>
  <svg id="staff" viewBox="0 0 520 240" aria-label="staff"></svg>
  <div class="cents"><div class="bar"></div><div class="center"></div><div class="mark" id="mark" style="left:50%"></div></div>
  <div id="dir"></div>
 </div>
 <div class="card metro">
  <button id="mbtn" class="off">▶ метроном</button>
  <label>темп <span id="bpmv">72</span></label>
  <input id="bpm" type="range" min="40" max="200" value="72">
  <label>такт <select id="beats"><option>2</option><option>3</option><option selected>4</option><option>6</option></select></label>
  <span class="dots" id="dots"></span>
 </div>
<script>
const NS="http://www.w3.org/2000/svg";
const LET={C:0,D:1,E:2,F:3,G:4,A:5,B:6};
const W=520,H=240,CX=300,MIDY=120,GAP=20; // GAP = distance between adjacent staff lines
// bass-clef: middle line = D3 → staffStep 3*7+1=22. lines at steps 18,20,22,24,26.
function staffStep(letter,oct){return oct*7+LET[letter];}
function yOf(step){return MIDY-(step-22)*(GAP/2);}
const staff=document.getElementById('staff');
function line(x1,y,x2,cls){const l=document.createElementNS(NS,'line');l.setAttribute('x1',x1);l.setAttribute('x2',x2);
  l.setAttribute('y1',y);l.setAttribute('y2',y);l.setAttribute('stroke',cls||'#42607f');l.setAttribute('stroke-width',2);return l;}
function drawStatic(){
  staff.innerHTML='';
  for(let s=18;s<=26;s+=2){const l=line(40,yOf(s),W-30,'#42607f');staff.appendChild(l);}
  // bass clef glyph (F-clef) + its two dots around the F3 line (step24)
  const c=document.createElementNS(NS,'text');c.setAttribute('x',52);c.setAttribute('y',yOf(24)+16);
  c.setAttribute('font-size',66);c.setAttribute('fill','#cfe0f2');c.textContent='𝄢';staff.appendChild(c);
  const g=document.createElementNS(NS,'g');g.setAttribute('id','live');staff.appendChild(g);
}
function ledgers(g,step){ // ledger lines for notes outside the staff
  const xs=CX-26,xe=CX+26;
  if(step<18){for(let e=16;e>=(step%2?step-1:step);e-=2)g.appendChild(line(xs,yOf(e),xe,'#42607f'));}
  if(step>26){for(let e=28;e<=(step%2?step+1:step);e+=2)g.appendChild(line(xs,yOf(e),xe,'#42607f'));}
}
function drawNote(name,oct,inTune){
  const g=document.getElementById('live');g.innerHTML='';
  const letter=name[0],sharp=name.includes('#');
  const step=staffStep(letter,oct),y=yOf(step),col=inTune?'#4ee6c4':'#ffcc55';
  ledgers(g,step);
  const head=document.createElementNS(NS,'ellipse');head.setAttribute('cx',CX);head.setAttribute('cy',y);
  head.setAttribute('rx',12);head.setAttribute('ry',9);head.setAttribute('fill',col);
  head.setAttribute('transform',`rotate(-20 ${CX} ${y})`);g.appendChild(head);
  // stem
  const up=step<22;const st=document.createElementNS(NS,'line');
  st.setAttribute('x1',CX+(up?11:-11));st.setAttribute('x2',CX+(up?11:-11));
  st.setAttribute('y1',y);st.setAttribute('y2',y+(up?-54:54));st.setAttribute('stroke',col);st.setAttribute('stroke-width',2.4);
  g.appendChild(st);
  if(sharp){const a=document.createElementNS(NS,'text');a.setAttribute('x',CX-34);a.setAttribute('y',y+8);
    a.setAttribute('font-size',30);a.setAttribute('fill',col);a.textContent='♯';g.appendChild(a);}
}
drawStatic();

const noteEl=document.getElementById('note'),freqEl=document.getElementById('freq'),
      markEl=document.getElementById('mark'),dirEl=document.getElementById('dir'),board=document.getElementById('board');
async function poll(){
  let s=null;try{s=await (await fetch('/state',{cache:'no-store'})).json();}catch(e){}
  if(!s||s.idle||s.age>1.6){board.classList.add('idle');freqEl.textContent='сыграй ноту…';dirEl.textContent='';return;}
  board.classList.remove('idle');
  const inTune=Math.abs(s.cents)<=6;
  noteEl.innerHTML=s.name+'<small>'+s.octave+'</small>';
  noteEl.style.color=inTune?'#4ee6c4':'#ffcc55';
  freqEl.textContent=s.freq+' Hz';
  const c=Math.max(-50,Math.min(50,s.cents));markEl.style.left=(50+c)+'%';
  markEl.style.background=inTune?'#4ee6c4':'#ffcc55';
  dirEl.textContent=inTune?'✓ чисто':(s.status==='flat'?'♭ ниже — подтяни ВВЕРХ ('+Math.round(s.cents)+'¢)':'♯ выше — опусти ВНИЗ (+'+Math.round(s.cents)+'¢)');
  drawNote(s.name,s.octave,inTune);
}
setInterval(poll,150);poll();

// ---- metronome (Web Audio, browser-local) ----
let actx=null,running=false,beat=0,nextT=0,timer=null;
const bpm=document.getElementById('bpm'),bpmv=document.getElementById('bpmv'),
      beatsSel=document.getElementById('beats'),mbtn=document.getElementById('mbtn'),dots=document.getElementById('dots');
bpm.oninput=()=>bpmv.textContent=bpm.value;
function renderDots(){dots.innerHTML='';for(let i=0;i<+beatsSel.value;i++){const d=document.createElement('span');d.className='dot';dots.appendChild(d);}}
beatsSel.onchange=renderDots;renderDots();
function click(t,accent){const o=actx.createOscillator(),g=actx.createGain();
  o.frequency.value=accent?1500:900;o.connect(g);g.connect(actx.destination);
  g.gain.setValueAtTime(0.0001,t);g.gain.exponentialRampToValueAtTime(accent?0.5:0.3,t+0.001);
  g.gain.exponentialRampToValueAtTime(0.0001,t+0.05);o.start(t);o.stop(t+0.06);}
function sched(){const beats=+beatsSel.value;
  while(nextT<actx.currentTime+0.12){const accent=(beat%beats)===0;click(nextT,accent);
    const idx=beat%beats;setTimeout(()=>{[...dots.children].forEach((d,i)=>d.classList.toggle('on',i===idx));},Math.max(0,(nextT-actx.currentTime)*1000));
    nextT+=60/(+bpm.value);beat++;}}
mbtn.onclick=()=>{
  if(!running){actx=actx||new (window.AudioContext||window.webkitAudioContext)();actx.resume();
    running=true;beat=0;nextT=actx.currentTime+0.06;timer=setInterval(sched,25);
    mbtn.textContent='■ стоп';mbtn.classList.remove('off');}
  else{running=false;clearInterval(timer);[...dots.children].forEach(d=>d.classList.remove('on'));
    mbtn.textContent='▶ метроном';mbtn.classList.add('off');}
};
</script></body></html>"""

def read_state():
    if not STATE or not os.path.exists(STATE):
        return {"idle": True, "age": 999}
    try:
        with open(STATE) as f:
            rec = json.load(f)
        rec["age"] = round(time.time() - float(rec.get("ts", 0)), 2)
        return rec
    except Exception:
        return {"idle": True, "age": 999}

class H(BaseHTTPRequestHandler):
    def _send(self, code, body, ctype):
        b = body.encode() if isinstance(body, str) else body
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(b)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        try: self.wfile.write(b)
        except Exception: pass
    def do_GET(self):
        p = self.path.split("?")[0]
        if p == "/" or p == "/index.html":
            self._send(200, PAGE, "text/html; charset=utf-8")
        elif p == "/state":
            self._send(200, json.dumps(read_state()), "application/json")
        elif p == "/health":
            self._send(200, "ok", "text/plain")
        else:
            self._send(404, "not found", "text/plain")
    def log_message(self, *a):  # quiet
        pass

def serve(bind, port):
    srv = ThreadingHTTPServer((bind, port), H)
    return srv

if len(sys.argv) > 1 and sys.argv[1] == "--test":
    # headless smoke: serve on an ephemeral port, hit / and /state, assert the staff + state plumbing.
    srv = serve("127.0.0.1", 0)
    port = srv.server_address[1]
    t = threading.Thread(target=srv.serve_forever, daemon=True); t.start()
    ok = True
    try:
        home = urllib.request.urlopen("http://127.0.0.1:%d/" % port, timeout=4).read().decode()
        for must in ("staffStep", "бас-ключ", "drawNote", "метроном", "/state"):
            if must not in home:
                print("smoke-test: FAIL (page missing %r)" % must); ok = False
        st = json.loads(urllib.request.urlopen("http://127.0.0.1:%d/state" % port, timeout=4).read().decode())
        if "age" not in st:
            print("smoke-test: FAIL (/state has no age)"); ok = False
    except Exception as e:
        print("smoke-test: FAIL (%s)" % e); ok = False
    finally:
        srv.shutdown()
    print("smoke-test: ok (page + /state served; bass-clef staff + metronome present)" if ok else "smoke-test: FAIL")
    sys.exit(0 if ok else 1)

srv = serve(BIND, PORT)
sys.stderr.write("mesh-tuner-web: serving on http://%s:%d/  (state=%s)\n" % (BIND, PORT, STATE)); sys.stderr.flush()
try:
    srv.serve_forever()
except KeyboardInterrupt:
    pass
PYEOF

exec python3 "$PY" "$@"
