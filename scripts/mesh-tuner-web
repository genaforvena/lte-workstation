   transform:translate(-50%,-50%);transition:left .07s linear,background .1s;z-index:2}
 .cents .jit{position:absolute;top:50%;height:12px;min-width:2px;border-radius:6px;background:#ffcc5533;
   border:1px solid #ffcc5566;transform:translateY(-50%);transition:left .07s linear,width .07s linear;z-index:1}
 .cents .band{position:absolute;top:50%;height:20px;border-radius:4px;background:#4ee6c41a;
   border:1px dashed #4ee6c455;transform:translateY(-50%);z-index:0}
 #dir{text-align:center;font-size:14px;color:var(--dim);min-height:18px}
 #prec{text-align:center;font-size:12px;color:#5b7590;font-variant-numeric:tabular-nums;min-height:16px;margin-top:2px}
 svg{display:block;margin:0 auto;width:min(520px,92vw);height:auto;background:#0a1322;border-radius:12px}
 .metro{display:flex;align-items:center;gap:12px;flex-wrap:wrap;justify-content:center}
 .metro button{background:var(--ok);color:#04231d;border:0;border-radius:10px;padding:10px 18px;
   font-size:16px;font-weight:700;cursor:pointer}
 .metro button.off{background:#27405a;color:#9fb3c8}
 .metro input[type=range]{width:160px} .metro label{color:var(--dim);font-size:13px}
 #bpmv{font-variant-numeric:tabular-nums;font-weight:700;min-width:3ch;display:inline-block}
 .dot{width:12px;height:12px;border-radius:50%;background:#27405a;transition:background .05s}
 .dot.on{background:var(--ok)} .dots{display:flex;gap:8px}
 .idle #note,.idle svg,.idle .cents{opacity:.35}
</style></head>
<body>
 <h1>меш · бас-ключ · виолончель</h1>
 <div class="card" id="board">
  <div style="text-align:center"><span id="note">—</span><div id="freq">сыграй ноту…</div></div>
  <svg id="staff" viewBox="0 0 520 240" aria-label="staff"></svg>
  <div class="cents"><div class="bar"></div><div class="band" id="band"></div><div class="center"></div>
    <div class="jit" id="jit" style="left:50%;width:2px"></div>
    <div class="mark" id="mark" style="left:50%"></div></div>
  <div id="dir"></div>
  <div id="prec"></div>
 </div>
 <div class="card metro">
  <button id="mbtn" class="off">▶ метроном</button>
  <label>темп <span id="bpmv">72</span></label>
  <input id="bpm" type="range" min="40" max="200" value="72">
  <label>такт <select id="beats"><option>2</option><option>3</option><option selected>4</option><option>6</option></select></label>
  <span class="dots" id="dots"></span>
 </div>
<script>
const NS="http://www.w3.org/2000/svg";
const LET={C:0,D:1,E:2,F:3,G:4,A:5,B:6};
const W=520,H=240,CX=300,MIDY=120,GAP=20; // GAP = distance between adjacent staff lines
// bass-clef: middle line = D3 → staffStep 3*7+1=22. lines at steps 18,20,22,24,26.
function staffStep(letter,oct){return oct*7+LET[letter];}
function yOf(step){return MIDY-(step-22)*(GAP/2);}
const staff=document.getElementById('staff');
function line(x1,y,x2,cls){const l=document.createElementNS(NS,'line');l.setAttribute('x1',x1);l.setAttribute('x2',x2);
  l.setAttribute('y1',y);l.setAttribute('y2',y);l.setAttribute('stroke',cls||'#42607f');l.setAttribute('stroke-width',2);return l;}
function drawStatic(){
  staff.innerHTML='';
  for(let s=18;s<=26;s+=2){const l=line(40,yOf(s),W-30,'#42607f');staff.appendChild(l);}
  // bass clef glyph (F-clef) + its two dots around the F3 line (step24)
  const c=document.createElementNS(NS,'text');c.setAttribute('x',52);c.setAttribute('y',yOf(24)+16);
  c.setAttribute('font-size',66);c.setAttribute('fill','#cfe0f2');c.textContent='𝄢';staff.appendChild(c);
  const g=document.createElementNS(NS,'g');g.setAttribute('id','live');staff.appendChild(g);
}
function ledgers(g,step){ // ledger lines for notes outside the staff
  const xs=CX-26,xe=CX+26;
  if(step<18){for(let e=16;e>=(step%2?step-1:step);e-=2)g.appendChild(line(xs,yOf(e),xe,'#42607f'));}
  if(step>26){for(let e=28;e<=(step%2?step+1:step);e+=2)g.appendChild(line(xs,yOf(e),xe,'#42607f'));}
}
function drawNote(name,oct,col){
  const g=document.getElementById('live');g.innerHTML='';
  const letter=name[0],sharp=name.includes('#');
  const step=staffStep(letter,oct),y=yOf(step);
  ledgers(g,step);
  const head=document.createElementNS(NS,'ellipse');head.setAttribute('cx',CX);head.setAttribute('cy',y);
  head.setAttribute('rx',12);head.setAttribute('ry',9);head.setAttribute('fill',col);
  head.setAttribute('transform',`rotate(-20 ${CX} ${y})`);g.appendChild(head);
  // stem
  const up=step<22;const st=document.createElementNS(NS,'line');
  st.setAttribute('x1',CX+(up?11:-11));st.setAttribute('x2',CX+(up?11:-11));
  st.setAttribute('y1',y);st.setAttribute('y2',y+(up?-54:54));st.setAttribute('stroke',col);st.setAttribute('stroke-width',2.4);
  g.appendChild(st);
  if(sharp){const a=document.createElementNS(NS,'text');a.setAttribute('x',CX-34);a.setAttribute('y',y+8);
    a.setAttribute('font-size',30);a.setAttribute('fill',col);a.textContent='♯';g.appendChild(a);}
}
drawStatic();

// ---- PRECISION BLOCK (pure; extracted VERBATIM between these markers and EXECUTED by --test) ----
// A predictive-processing metric carried over from sensorimotor synchronization: a prediction error
// is worth acting on only in proportion to its PRECISION. The tuner hands us one 0.18-0.40 s YIN
// frame at a time and its cents dispersion is nothing like a constant — measured on this very
// detector (docs/reviews/predictive-processing-precision-weighted-cents-tuner-web-2026-08-29.md) it
// runs from 0.005 c at 40 dB SNR to 5.9 c at 6 dB, and a plain +/-30 c vibrato alone contributes
// 3.9 c at the short window. So one frame judged against a fixed band is a coin flip at one end and
// a several-hundred-fold-too-lax pass at the other. The TARGET band stays fixed — it is the
// operator's goal, not a thing to auto-widen — and the VERDICT carries the evidence's own width.
const P = { BAND: 6, WIN_N: 12, WIN_AGE: 3.0, MIN_N: 4 };
function precision(win, band, minN){
  const n = win.length;
  if (n < minN) return {state:'warmup', n:n, need:minN};
  let m=0; for(const c of win) m+=c; m/=n;
  let v=0; for(const c of win) v+=(c-m)*(c-m); v/=(n-1);
  const sd=Math.sqrt(v), se=sd/Math.sqrt(n);
  // the precision weight (this problem's Kalman gain): prior "you are in tune", width `band`;
  // observation = the window mean, width `se`. alpha -> 0 exactly when the reading is noise.
  const alpha = (band*band)/(band*band + se*se);
  const shown = alpha*m;                  // the precision-WEIGHTED prediction error, what we display
  const lo = m-1.96*se, hi = m+1.96*se;   // 95% interval on the true offset
  let state;
  if (hi < -band || lo > band)      state='off';        // decisively outside the band
  else if (lo > -band && hi < band) state='in';         // decisively inside it
  else                              state='undecided';  // this reading cannot resolve the question
  return {state,n,mean:m,sd,se,alpha,shown,lo,hi};
}
// The window holds DISTINCT producer samples. The page polls every 150 ms but mesh-tuner writes a
// few times a second, so the SAME record is re-read repeatedly; counting a re-read as a fresh
// observation drives sd -> 0 and alpha -> 1 — the page would grow maximally confident precisely
// because it looked at one sample many times. Dedupe on the producer's own ts.
let win=[], winMidi=null, lastTs=null;
function pushSample(s){
  if (s.ts===lastTs) return false;
  lastTs=s.ts;
  if (s.midi!==winMidi){ win=[]; winMidi=s.midi; }
  win.push({c:s.cents,t:s.ts});
  while (win.length && win[0].t < s.ts-P.WIN_AGE) win.shift();
  while (win.length > P.WIN_N) win.shift();
  return true;
}
// ---- /PRECISION BLOCK ----

const noteEl=document.getElementById('note'),freqEl=document.getElementById('freq'),
      markEl=document.getElementById('mark'),dirEl=document.getElementById('dir'),board=document.getElementById('board'),
      jitEl=document.getElementById('jit'),bandEl=document.getElementById('band'),precEl=document.getElementById('prec');
const clamp=x=>Math.max(-50,Math.min(50,x));
async function poll(){
  let s=null;try{s=await (await fetch('/state',{cache:'no-store'})).json();}catch(e){}
  if(!s||s.idle||s.age>1.6){board.classList.add('idle');freqEl.textContent='сыграй ноту…';dirEl.textContent='';
    precEl.textContent='';win=[];winMidi=null;lastTs=null;return;}
  board.classList.remove('idle');
  pushSample(s);
  const r=precision(win.map(w=>w.c), P.BAND, P.MIN_N);
  const col = r.state==='in' ? '#4ee6c4' : (r.state==='off' ? '#ffcc55' : '#8fa6bd');
  noteEl.innerHTML=s.name+'<small>'+s.octave+'</small>';
  noteEl.style.color=col;
  freqEl.textContent=s.freq+' Hz';
  // the needle sits on the PRECISION-WEIGHTED offset, never the raw last frame; the pale bar behind
  // it is that reading's own 95% interval, so the noise is VISIBLE instead of drawn with the
  // authority of signal — and the dashed box is the fixed +/-6 c target it is being judged against.
  markEl.style.left=(50+clamp(r.state==='warmup'?s.cents:r.shown))+'%';
  markEl.style.background=col;
  bandEl.style.left=(50-P.BAND)+'%'; bandEl.style.width=(2*P.BAND)+'%';
  if(r.state==='warmup'){ jitEl.style.opacity=0; }
  else { const lo=clamp(r.lo),hi=clamp(r.hi); jitEl.style.opacity=1;
         jitEl.style.left=(50+lo)+'%'; jitEl.style.width=Math.max(0.4,hi-lo)+'%'; }
  dirEl.textContent =
      r.state==='warmup'    ? 'набираю… ('+r.n+'/'+r.need+' кадра)'
    : r.state==='undecided' ? '⟂ не разобрать — разброс чтения ±'+r.sd.toFixed(1)+'¢ шире самого решения'
    : r.state==='in'        ? '✓ чисто'
    : (r.shown<0 ? '♭ ниже — подтяни ВВЕРХ ('+r.shown.toFixed(1)+'¢)'
                 : '♯ выше — опусти ВНИЗ (+'+r.shown.toFixed(1)+'¢)');
  precEl.textContent = r.state==='warmup'
    ? 'σ — · n '+r.n+' · сырой кадр '+s.cents.toFixed(1)+'¢'
    : 'σ '+r.sd.toFixed(2)+'¢ · n '+r.n+' · вес α '+r.alpha.toFixed(2)+' · сырой кадр '+s.cents.toFixed(1)+'¢';
  drawNote(s.name,s.octave,col);
}
setInterval(poll,150);poll();

// ---- metronome (Web Audio, browser-local) ----
let actx=null,running=false,beat=0,nextT=0,timer=null;
const bpm=document.getElementById('bpm'),bpmv=document.getElementById('bpmv'),
      beatsSel=document.getElementById('beats'),mbtn=document.getElementById('mbtn'),dots=document.getElementById('dots');
bpm.oninput=()=>bpmv.textContent=bpm.value;
function renderDots(){dots.innerHTML='';for(let i=0;i<+beatsSel.value;i++){const d=document.createElement('span');d.className='dot';dots.appendChild(d);}}
beatsSel.onchange=renderDots;renderDots();
function click(t,accent){const o=actx.createOscillator(),g=actx.createGain();
  o.frequency.value=accent?1500:900;o.connect(g);g.connect(actx.destination);
  g.gain.setValueAtTime(0.0001,t);g.gain.exponentialRampToValueAtTime(accent?0.5:0.3,t+0.001);
  g.gain.exponentialRampToValueAtTime(0.0001,t+0.05);o.start(t);o.stop(t+0.06);}
function sched(){const beats=+beatsSel.value;
  while(nextT<actx.currentTime+0.12){const accent=(beat%beats)===0;click(nextT,accent);
    const idx=beat%beats;setTimeout(()=>{[...dots.children].forEach((d,i)=>d.classList.toggle('on',i===idx));},Math.max(0,(nextT-actx.currentTime)*1000));
    nextT+=60/(+bpm.value);beat++;}}
mbtn.onclick=()=>{
  if(!running){actx=actx||new (window.AudioContext||window.webkitAudioContext)();actx.resume();
    running=true;beat=0;nextT=actx.currentTime+0.06;timer=setInterval(sched,25);
    mbtn.textContent='■ стоп';mbtn.classList.remove('off');}
  else{running=false;clearInterval(timer);[...dots.children].forEach(d=>d.classList.remove('on'));
    mbtn.textContent='▶ метроном';mbtn.classList.add('off');}
};
</script></body></html>"""

def read_state():
    if not STATE or not os.path.exists(STATE):
        return {"idle": True, "age": 999}
    try:
        with open(STATE) as f:
            rec = json.load(f)
        rec["age"] = round(time.time() - float(rec.get("ts", 0)), 2)
        return rec
    except Exception:
        return {"idle": True, "age": 999}

class H(BaseHTTPRequestHandler):
    def _send(self, code, body, ctype):
        b = body.encode() if isinstance(body, str) else body
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(b)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        try: self.wfile.write(b)
        except Exception: pass
    def do_GET(self):
        p = self.path.split("?")[0]
        if p == "/" or p == "/index.html":
            self._send(200, PAGE, "text/html; charset=utf-8")
        elif p == "/state":
            self._send(200, json.dumps(read_state()), "application/json")
        elif p == "/health":
            self._send(200, "ok", "text/plain")
        else:
            self._send(404, "not found", "text/plain")
    def log_message(self, *a):  # quiet
        pass

def serve(bind, port):
    srv = ThreadingHTTPServer((bind, port), H)
    return srv

if len(sys.argv) > 1 and sys.argv[1] == "--test":
    # headless smoke: serve on an ephemeral port, hit / and /state, assert the staff + state plumbing.
    srv = serve("127.0.0.1", 0)
    port = srv.server_address[1]
    t = threading.Thread(target=srv.serve_forever, daemon=True); t.start()
    ok = True
    try:
        home = urllib.request.urlopen("http://127.0.0.1:%d/" % port, timeout=4).read().decode()
        for must in ("staffStep", "бас-ключ", "drawNote", "метроном", "/state",
                     "precision(", "pushSample(", "не разобрать"):
            if must not in home:
                print("smoke-test: FAIL (page missing %r)" % must); ok = False
        st = json.loads(urllib.request.urlopen("http://127.0.0.1:%d/state" % port, timeout=4).read().decode())
        if "age" not in st:
            print("smoke-test: FAIL (/state has no age)"); ok = False
    except Exception as e:
        print("smoke-test: FAIL (%s)" % e); ok = False
        home = ""
    finally:
        srv.shutdown()

    # ---- precision arms: EXECUTE the page's own logic, never grep for it. The block is sliced out
    # between its markers and run under node with real fixtures, so a mutation of the logic goes red
    # and a comment mentioning the right words cannot pass. No node -> the arms are SKIPPED and the
    # verdict says so; a green that never ran the logic is the thing this is built to prevent.
    B0 = "// ---- PRECISION BLOCK"
    B1 = "// ---- /PRECISION BLOCK ----"
    cov = "logic=UNEXECUTED"
    if ok:
        i, j = home.find(B0), home.find(B1)
        if i < 0 or j < 0 or j <= i:
            print("smoke-test: FAIL (precision block markers missing from the served page)"); ok = False
        else:
            block = home[i:j]
            node = shutil.which("node")
            if not node:
                cov = "logic=UNEXECUTED (no node on PATH)"
            else:
                harness = block + r'''
function fail(m){ console.log("ARM-FAIL "+m); process.exitCode = 1; }
function near(a,b,e){ return Math.abs(a-b) <= e; }
const B = P.BAND, N = P.MIN_N;

// 1. warmup: below MIN_N there is no dispersion, so there is no verdict at all.
{ const r = precision([0.1,-0.1,0.0], B, N);
  if (r.state !== "warmup") fail("1 warmup: got "+r.state);
  if (r.mean !== undefined) fail("1 warmup leaked a verdict field"); }

// 2. clean + in tune -> decisively "in", and the weight is ~1 (nothing to shrink).
{ const r = precision([0.1,0.0,-0.1,0.05,0.0,-0.05,0.1,0.0,0.05,-0.1,0.0,0.05], B, N);
  if (r.state !== "in") fail("2 clean-in: got "+r.state);
  if (!(r.alpha > 0.99)) fail("2 clean-in: alpha "+r.alpha+" should be ~1"); }

// 3. clean + a real 18 c flat -> "off", and the shown error is essentially the real one.
{ const w = [];
  for (let k=0;k<12;k++) w.push(-18 + ((k%3)-1)*0.05);
  const r = precision(w, B, N);
  if (r.state !== "off") fail("3 clean-off: got "+r.state);
  if (!(r.shown < -17.5)) fail("3 clean-off: shown "+r.shown+" should be ~-18"); }

// 4. THE UNDECIDABLE CASE. A 6 dB-SNR-grade window (sd ~5.5 c, the value measured on this very
// detector at C2/G2) sitting right on the band edge cannot be called either way. Before this
// change the page rendered exactly this as a confident word.
{ const w = [6.0,11.5,0.5,9.2,2.8,12.0,-0.4,8.1,3.3,10.6,1.1,7.3];
  const r = precision(w, B, N);
  if (r.state !== "undecided") fail("4 undecidable: got "+r.state+" (lo "+r.lo.toFixed(2)+" hi "+r.hi.toFixed(2)+")");
  if (!(r.sd > 3)) fail("4 undecidable: fixture is not noisy, sd "+r.sd); }

// 5. THE SHRINKAGE. Same mean, more noise -> a SMALLER displayed correction. This is the whole
// transferred claim: a prediction error is acted on in proportion to its precision.
{ const clean = [], noisy = [];
  for (let k=0;k<12;k++){ clean.push(4 + ((k%2)?0.05:-0.05)); noisy.push(4 + ((k%2)?18:-18)); }
  const a = precision(clean, B, N), b = precision(noisy, B, N);
  if (!near(a.mean, b.mean, 1e-9)) fail("5 shrinkage: fixtures do not share a mean");
  if (!(Math.abs(b.shown) < Math.abs(a.shown))) fail("5 shrinkage: noisy shown "+b.shown+" not smaller than clean "+a.shown);
  if (!(b.alpha < 0.6 && a.alpha > 0.99)) fail("5 shrinkage: alphas "+a.alpha+" / "+b.alpha);
  if (!(Math.abs(b.shown) < 0.6*Math.abs(a.shown))) fail("5 shrinkage: not shrunk enough, "+b.shown+" vs "+a.shown);
  if (b.state !== "undecided") fail("5 shrinkage: noisy window should not be decided, got "+b.state); }

// 6. THE RE-READ TRAP. The page polls faster than mesh-tuner writes, so the same record is served
// again and again. Counting a re-read as a fresh observation collapses sd to 0 and alpha to 1 --
// maximum confidence bought by looking at one sample many times.
{ win=[]; winMidi=null; lastTs=null;
  const rec = {ts: 1000.0, midi: 43, cents: 4.0};
  let accepted = 0;
  for (let k=0;k<20;k++) if (pushSample(rec)) accepted++;
  if (accepted !== 1) fail("6 re-read: accepted "+accepted+" copies of one record");
  if (win.length !== 1) fail("6 re-read: window holds "+win.length+" from one record");
  const r = precision(win.map(w=>w.c), B, N);
  if (r.state !== "warmup") fail("6 re-read: one record produced a verdict ("+r.state+")"); }

// 7. a note change empties the window -- the previous note's dispersion is not evidence about this one.
{ win=[]; winMidi=null; lastTs=null;
  for (let k=0;k<8;k++) pushSample({ts:2000.0+k*0.1, midi:43, cents:-20});
  pushSample({ts:2000.8, midi:45, cents:0.2});
  if (win.length !== 1) fail("7 note-change: window kept "+win.length+" samples across a note change");
  if (winMidi !== 45) fail("7 note-change: winMidi "+winMidi); }

// 8. the window is bounded by AGE as well as count -- a sample from a different bow stroke is not
// evidence about this one.
{ win=[]; winMidi=null; lastTs=null;
  pushSample({ts:3000.0, midi:43, cents:-30});
  for (let k=0;k<5;k++) pushSample({ts:3010.0+k*0.2, midi:43, cents:0.1});
  if (win.some(w=>w.t < 3010.0-P.WIN_AGE)) fail("8 age: a stale sample survived the window");
  const r = precision(win.map(w=>w.c), B, N);
  if (r.state !== "in") fail("8 age: stale -30 c sample still steering the verdict ("+r.state+")"); }
if (!process.exitCode) console.log("ARMS-OK");
'''
                wiring = r'''
// ---- arm 9: THE WIRING. Arms 1-8 prove the precision function; they prove nothing about whether
// poll() calls it, or whether its words reach the two lines the operator actually reads. Run the
// page's WHOLE script under a minimal DOM shim, drive it with a fixture series, read the rendered
// text back. Testing the parts is not testing the wiring.
function fail(m){ console.log("ARM-FAIL "+m); process.exitCode = 1; }
const els = {};
function mkEl(){ return { style:{}, _t:"", _h:"",
  set textContent(v){this._t=v;}, get textContent(){return this._t;},
  set innerHTML(v){this._h=v;},   get innerHTML(){return this._h;},
  classList:{ add(){}, remove(){}, toggle(){} }, appendChild(){}, setAttribute(){},
  children:[], onclick:null, oninput:null, onchange:null, value:"72" }; }
global.document = {
  getElementById(id){ return els[id] || (els[id] = mkEl()); },
  createElementNS(){ return mkEl(); }, createElement(){ return mkEl(); } };
global.setInterval = () => 0; global.setTimeout = () => 0; global.clearInterval = () => {};
global.window = {}; global.AudioContext = function(){};
let SERIES = [], SI = 0;
global.fetch = async () => ({ json: async () => SERIES[Math.min(SI++, SERIES.length-1)] });
PAGE_SCRIPT_HERE
async function drive(series){ SERIES = series; SI = 0; els.dir._t=""; els.prec._t="";
  win=[]; winMidi=null; lastTs=null;
  for (let k=0;k<series.length;k++) await poll();
  return { dir: els.dir.textContent, prec: els.prec.textContent, note: els.note.innerHTML }; }
function series(cents, midi){ const t0=Date.now()/1000; return cents.map((c,i)=>
  ({ts:t0+i*0.2, midi:midi, name:"G", octave:2, freq:98.0, cents:c, status:"in", age:0.1})); }
(async () => {
  // a clean, genuinely in-tune series -> the confident word, and the precision line carries sigma/alpha/n
  const a = await drive(series([0.1,0.0,-0.1,0.05,0.0,-0.05,0.1,0.0], 43));
  if (!/чисто/.test(a.dir)) fail("9 wiring: clean series rendered "+JSON.stringify(a.dir));
  if (!/σ/.test(a.prec) || !/α/.test(a.prec)) fail("9 wiring: precision line missing sigma/alpha: "+JSON.stringify(a.prec));
  if (!/n 8/.test(a.prec)) fail("9 wiring: precision line does not carry n: "+JSON.stringify(a.prec));
  // a 6 dB-SNR-grade series sitting on the band edge -> the THIRD word must reach the operator's line
  const b = await drive(series([6.0,11.5,0.5,9.2,2.8,12.0,-0.4,8.1,3.3,10.6,1.1,7.3], 43));
  if (!/не разобрать/.test(b.dir)) fail("9 wiring: noisy series rendered "+JSON.stringify(b.dir));
  // the first samples of a note are a warmup, never a verdict
  const c = await drive(series([0.1,0.0], 43));
  if (!/набираю/.test(c.dir)) fail("9 wiring: two samples rendered "+JSON.stringify(c.dir));
  if (/чисто|ниже|выше|не разобрать/.test(c.dir)) fail("9 wiring: a verdict leaked into warmup: "+JSON.stringify(c.dir));
  // a real, decisive 20 c flat must STILL produce its correction -- the change must not mute the tool
  const d = await drive(series([-20.1,-19.9,-20.0,-20.2,-19.8,-20.0,-20.1,-19.9], 43));
  if (!/ВВЕРХ/.test(d.dir)) fail("9 wiring: a decisive 20 c flat rendered "+JSON.stringify(d.dir));
  if (!/-19\.|-20\./.test(d.dir)) fail("9 wiring: correction magnitude lost: "+JSON.stringify(d.dir));
  if (!process.exitCode) console.log("WIRING-OK");
})();
'''
                i0 = home.find("<script>"); i1 = home.find("</script>")
                wiring = wiring.replace("PAGE_SCRIPT_HERE",
                                        home[i0+len("<script>"):i1].replace("setInterval(poll,150);poll();", ""))
                with tempfile.NamedTemporaryFile("w", suffix=".js", delete=False,
                                                 dir=os.environ.get("TMPDIR", "/tmp")) as f:
                    f.write(harness); jsp = f.name
                with tempfile.NamedTemporaryFile("w", suffix=".js", delete=False,
                                                 dir=os.environ.get("TMPDIR", "/tmp")) as f:
                    f.write(wiring); wjs = f.name
                try:
                    for path, marker, what in ((jsp, "ARMS-OK", "precision arms"),
                                               (wjs, "WIRING-OK", "wiring arm")):
                        r = subprocess.run([node, path], capture_output=True, text=True, timeout=30)
                        out = (r.stdout + r.stderr).strip()
                        if r.returncode != 0 or marker not in out:
                            cov = "logic=executed (%s RED)" % what
                            print("smoke-test: FAIL (%s)\n%s" % (what, out)); ok = False; break
                    else:
                        cov = "logic=executed (8 precision arms + the wiring arm, node %s)" % subprocess.run(
                            [node, "-v"], capture_output=True, text=True).stdout.strip()
                except Exception as e:
                    print("smoke-test: FAIL (node arms: %s)" % e); ok = False
                finally:
                    for f_ in (jsp, wjs):
                        try: os.unlink(f_)
                        except Exception: pass

    print(("smoke-test: ok (page + /state served; bass-clef staff + metronome present) · %s" % cov)
          if ok else "smoke-test: FAIL · %s" % cov)
    sys.exit(0 if ok else 1)

