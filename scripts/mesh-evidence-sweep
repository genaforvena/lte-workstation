#!/usr/bin/env bash
# mesh-evidence-sweep — backstop for the 2026-09-16 move of receipts, audits and chat-range reviews
# out of the genome tree (docs/EVIDENCE-MOVED.md, mesh-evidence-dir).
#
# The WRITERS were repointed, but a task description minted before that date still names the in-repo
# path, so executing it drops one more file into the tree. Measured on 2026-09-16: two such writes
# re-created docs/chat-range-reviews/ AFTER it had been removed and verified absent (medium-74208-74701
# at 18:31, then near-63685-63749) — the reflex's own 15-minute cron keeps minting reviews, so the
# strays keep arriving until the pre-fix chains drain. This is the liveness half of that fix: the
# prompt points at the evidence root, and this makes the OLD spelling land there too.
#
# Safety rules, in order:
#   1. byte-verify before removing anything from the repo (cmp, never a stat);
#   2. NEVER overwrite a differing file that already exists in the evidence root — it is moved aside
#      as <name>.conflict-<utc-stamp> and reported, because a silent overwrite would destroy evidence;
#   3. an identical file is simply removed from the repo: the evidence copy is already the truth;
#   4. only the five corpora below are touched, and only at their exact legacy paths. (`artifacts/` was
#      added 2026-09-16 after a straggler: docs/EVIDENCE-MOVED.md and mesh-evidence-dir both mapped it
#      to the evidence root, but this backstop did not cover it, so `senses` wrote
#      artifacts/sense-liveness-20260916.md back into the tree at 18:21 and nothing drained it.)
#
#   mesh-evidence-sweep --run        sweep (prints one summary line, so the cron log shows liveness)
#   mesh-evidence-sweep --dry-run    report what --run would do, change nothing
#   mesh-evidence-sweep --test
#
# Roots: MESH_REPO (repo tree to clean), MESH_EVIDENCE_ROOT then $MESH_DIR/evidence.
set -u -o pipefail

MESH_DIR_RESOLVED="${MESH_DIR:-$HOME/.mesh}"
EVIDENCE_ROOT="${MESH_EVIDENCE_ROOT:-$MESH_DIR_RESOLVED/evidence}"
REPO="${MESH_REPO:-$HOME/lte-workstation}"

# legacy-repo-dir : node-local-root, relative to the two roots above.
PAIRS=("docs/task-receipts:receipts" "task-receipts:receipts" "docs/audits:audits"
       "docs/chat-range-reviews:chat-range-reviews" "artifacts:artifacts")

usage(){ sed -n '2,24p' "$0" | sed 's/^# \{0,1\}//'; }

sweep(){
    local dry="${1:-}" pair dir dest f b target moved=0 identical=0 conflict=0 kept=0
    for pair in "${PAIRS[@]}"; do
        dir="$REPO/${pair%%:*}"; dest="$EVIDENCE_ROOT/${pair##*:}"
        [ -d "$dir" ] || continue
        for f in "$dir"/*; do
            [ -e "$f" ] || continue
            b="$(basename "$f")"; target="$dest/$b"
            if [ -e "$target" ]; then
                if cmp -s "$f" "$target"; then
                    if [ -n "$dry" ]; then echo "would drop identical copy: ${pair%%:*}/$b (already at $target)"; kept=$((kept+1)); continue; fi
                    rm -f "$f"; identical=$((identical+1)); continue
                fi
                local aside="$target.conflict-$(date -u +%Y%m%dT%H%M%SZ)"
                if [ -n "$dry" ]; then echo "would move aside a DIFFERING file: ${pair%%:*}/$b -> $(basename "$aside")"; conflict=$((conflict+1)); continue; fi
                mkdir -p "$dest"
                mv -n "$f" "$aside" || { echo "mesh-evidence-sweep: could not move $f aside" >&2; return 1; }
                conflict=$((conflict+1)); continue
            fi
            if [ -n "$dry" ]; then echo "would move: ${pair%%:*}/$b -> $dest/$b"; moved=$((moved+1)); continue; fi
            mkdir -p "$dest"
            # copy-then-verify-then-remove: the repo never loses a byte this way
            cp -p "$f" "$target" 2>/dev/null || { echo "mesh-evidence-sweep: could not copy $f" >&2; return 1; }
            cmp -s "$f" "$target" || { echo "mesh-evidence-sweep: copy of $f is not byte-identical; leaving it in the repo" >&2; rm -f "$target"; return 1; }
            rm -f "$f"; moved=$((moved+1))
        done
        [ -n "$dry" ] || rmdir "$dir" 2>/dev/null
    done
    if [ -n "$dry" ]; then echo "evidence-sweep dry-run: moved=$moved identical=$identical conflicts=$conflict"; else echo "evidence-sweep moved=$moved identical=$identical conflicts=$conflict"; fi
    return 0
}

test_self(){
    local fail=0 td
    td="$(mktemp -d)" || { echo "smoke-test: FAIL (no mktemp -d)"; return 1; }
    trap 'rm -rf "$td"' EXIT INT TERM
    MESH_REPO="$td/repo" MESH_EVIDENCE_ROOT="$td/ev" bash -c '
        set -e
        mkdir -p "$MESH_REPO/docs/chat-range-reviews" "$MESH_REPO/docs/task-receipts" \
                 "$MESH_REPO/docs/other" "$MESH_EVIDENCE_ROOT/chat-range-reviews" "$MESH_EVIDENCE_ROOT/receipts"
        mkdir -p "$MESH_REPO/artifacts"
        printf "legacy artifact\n" > "$MESH_REPO/artifacts/legacy.md"
        printf "same\n" > "$MESH_REPO/docs/chat-range-reviews/identical.md"
        printf "same\n" > "$MESH_EVIDENCE_ROOT/chat-range-reviews/identical.md"
        printf "repo version\n" > "$MESH_REPO/docs/chat-range-reviews/conflict.md"
        printf "evidence version\n" > "$MESH_EVIDENCE_ROOT/chat-range-reviews/conflict.md"
        printf "new\n" > "$MESH_REPO/docs/chat-range-reviews/fresh.md"
        printf "keep me\n" > "$MESH_REPO/docs/other/untouched.md"
        printf "receipt\n" > "$MESH_REPO/docs/task-receipts/r.md"
    '
    MESH_REPO="$td/repo" MESH_EVIDENCE_ROOT="$td/ev" "$0" --run > "$td/out" 2>&1 || { echo "smoke-test: FAIL (--run: $(cat "$td/out"))"; return 1; }
    # THREE strays in this fixture (chat-range-reviews/fresh.md, task-receipts/r.md and
    # artifacts/legacy.md): the summary is asserted exactly, so a sweep that skips a corpus or
    # double-counts one is caught here.
    grep -q 'moved=3 identical=1 conflicts=1' "$td/out" \
        || { echo "smoke-test: FAIL (summary wrong: $(cat "$td/out"))"; fail=1; }
    # (1b) the artifacts corpus (root-level, NOT docs/tiny-fleet-artifacts) is swept too, and its
    # emptied legacy dir is gone — the 2026-09-16 straggler that motivated adding it
    [ -f "$td/ev/artifacts/legacy.md" ] && [ ! -e "$td/repo/artifacts/legacy.md" ] \
        || { echo "smoke-test: FAIL (repo-root artifacts/ was not swept to the evidence root)"; fail=1; }
    [ -d "$td/repo/artifacts" ] \
        && { echo "smoke-test: FAIL (emptied artifacts/ legacy dir left behind)"; fail=1; }
    # (1) the fresh stray landed, byte-identical, and is gone from the repo
    cmp -s "$td/repo/docs/chat-range-reviews/fresh.md" "$td/ev/chat-range-reviews/fresh.md" 2>/dev/null \
        && { echo "smoke-test: FAIL (fresh.md still in the repo after a verified move)"; fail=1; }
    [ -f "$td/ev/chat-range-reviews/fresh.md" ] && [ "$(cat "$td/ev/chat-range-reviews/fresh.md")" = new ] \
        || { echo "smoke-test: FAIL (fresh.md did not land in the evidence root intact)"; fail=1; }
    # (2) an identical duplicate is removed from the repo, evidence untouched
    [ -e "$td/repo/docs/chat-range-reviews/identical.md" ] \
        && { echo "smoke-test: FAIL (an identical copy was left in the repo)"; fail=1; }
    # (3) a DIFFERING file is never overwritten: evidence keeps its version, the stray is set aside
    [ "$(cat "$td/ev/chat-range-reviews/conflict.md")" = "evidence version" ] \
        || { echo "smoke-test: FAIL (the evidence copy was overwritten — evidence destroyed)"; fail=1; }
    ls "$td/ev/chat-range-reviews"/conflict.md.conflict-* >/dev/null 2>&1 \
        || { echo "smoke-test: FAIL (the differing repo file was not preserved as .conflict-*)"; fail=1; }
    # (4) the sweep is scoped: an unrelated repo file is untouched
    [ -f "$td/repo/docs/other/untouched.md" ] \
        || { echo "smoke-test: FAIL (the sweep touched a file outside the four corpora)"; fail=1; }
    # (5) a second corpus in the same run, and the emptied dirs are gone
    [ -f "$td/ev/receipts/r.md" ] && [ ! -e "$td/repo/docs/task-receipts/r.md" ] \
        || { echo "smoke-test: FAIL (docs/task-receipts/ was not swept)"; fail=1; }
    [ -d "$td/repo/docs/chat-range-reviews" ] \
        && { echo "smoke-test: FAIL (emptied legacy dir left behind)"; fail=1; }
    # (6) dry-run changes nothing
    mkdir -p "$td/repo/docs/chat-range-reviews"
    printf "dry\n" > "$td/repo/docs/chat-range-reviews/dry.md"
    MESH_REPO="$td/repo" MESH_EVIDENCE_ROOT="$td/ev" "$0" --dry-run > "$td/dry" 2>&1 \
        || { echo "smoke-test: FAIL (--dry-run exited non-zero)"; fail=1; }
    [ -f "$td/repo/docs/chat-range-reviews/dry.md" ] && [ ! -e "$td/ev/chat-range-reviews/dry.md" ] \
        || { echo "smoke-test: FAIL (--dry-run moved a file)"; fail=1; }
    # (7) an absent corpus is not an error (the steady state)
    MESH_REPO="$td/nothing" MESH_EVIDENCE_ROOT="$td/ev" "$0" --run | grep -q 'moved=0 identical=0 conflicts=0' \
        || { echo "smoke-test: FAIL (an absent repo tree must report a clean zero, not fail)"; fail=1; }
    [ "$fail" = 0 ] && { echo "smoke-test: ok (sweep moves + verifies, never overwrites evidence, stays scoped, dry-run inert)"; exit 0; }
    echo "smoke-test: FAIL"; exit 1
}

case "${1:-}" in
    --run)     sweep "" ;;
    --dry-run) sweep dry ;;
    --test)    test_self ;;
    --help|-h|"") usage ;;
    *) echo "mesh-evidence-sweep: unknown argument '$1'" >&2; usage >&2; exit 2 ;;
esac
