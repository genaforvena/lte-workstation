#!/usr/bin/env bash
# reflex-cadence: 3-59/5 * * * *
# mesh-desk-state — cross-sensor DESK OCCUPANCY: fuses iMac WiFi RSSI (mesh-imac-wifi)
# + iMac input recency (mesh-imac-input) + phone body-motion (mesh-body-motion) + phone
# tamper (mesh-tamper) → "is the operator at the desk?" — a signal no single sensor gives.
#
# INPUT axis (2026-07-05, spec ~/.mesh/knowledge/capability-imac-input-idle-20260705.md):
# HIDIdleTime < 120s = keyboard/mouse used at the iMac just now — DIRECT person-specific
# evidence (a TV cannot type) that beats RSSI inference and survives the phone being
# offline. Consent envelope: household occupancy (machine is iMac-Rozalia), not
# operator-specific — reasons say "someone", not "operator", on this axis.
#
# Cross-validation: iMac RSSI MOTION = RF multipath near the iMac (someone walking nearby).
# body-motion = phone being carried/moved. When both agree → HIGH confidence. When they
# contradict → report the contradiction explicitly (NEAR-IMAC vs PHONE-ACTIVE).
# iMac=UNREACHABLE is a REAL signal (iMac off/asleep → operator away from desk), never
# silently collapsed to UNKNOWN.
#
# CAM axis (2026-07-05): mesh-imac-cam-watch's LOCAL artifacts (no extra SSH — the watcher
# loop already runs on this node): .imac-cam-watch.state (SEEING/DARK/FLAT/CAPTURE-FAIL,
# mtime = watcher liveness) + .imac-cam-last-classify (epoch of the last motion-triggered
# classify) + imac-person-log.tsv (who was in frame at that motion: Ilya/Rozalia/Stranger/
# Nobody). A RECOGNIZED PERSON in frame is direct visual evidence — like typing, it beats
# RSSI inference and survives the phone being offline (the all-day PARTIAL-IMAC case this
# axis exists for). Motion with who=Nobody / recognition-failed does NOT upgrade the state
# (a static-cam frame-diff can be light/curtain artifacts — the 2026-07-05 mis-aimed-eye
# lesson); it renders in signals only. A DARK/FLAT/CAPTURE-FAIL lens or a dead watcher
# (cam=STALE) is visibly degraded, never a silent all-clear — and cam=QUIET never claims
# absence (the lens covers one corner of the room, not the room).
# Consent envelope unchanged: same feed + same names mesh-imac-cam-watch already logs.
#
# States:
#   AT-DESK-TYPING    input idle_s<120 → someone at the iMac keyboard (direct, beats RSSI)
#   SEEN-IN-ROOM      cam MOTION with a recognized person in frame (direct visual evidence;
#                     outranks RF/phone inference, only typing beats it)
#   AT-DESK           iMac=STABLE + body=STILL + tamper=QUIET → seated quiet session
#   ACTIVE-CONFIRMED  iMac=MOTION + body=WALKING|CARRIED → both sensors corroborate motion
#   NEAR-IMAC         iMac=MOTION + body=STILL → disturbance near iMac, phone set down
#   PHONE-ACTIVE      iMac=STABLE + body=WALKING|CARRIED|HANDLED → moving, not near iMac
#   STIRRED           tamper=MOVED + no locomotion → brief pickup/disturbance
#   AWAY              iMac=UNREACHABLE → iMac off/asleep; operator away from desk
#   PARTIAL-IMAC      phone=OFFLINE + iMac reachable → partial read, iMac axis only
#   DEGRADED:<which>  both axes available but mixed/unclear
#
# Exit codes (honest-exit contract):
#   0 = reading produced (may be PARTIAL-IMAC when phone offline)
#   2 = BOTH iMac AND phone unreachable — cannot assess at all
#
# Usage:
#   mesh-desk-state          one-shot state
#   mesh-desk-state --json   machine-readable JSON
#   mesh-desk-state --test   smoke test
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

MODE=text; [ "${1:-}" = --json ] && MODE=json

# ---- Smoke test ----
[ "${1:-}" = --test ] && {
  for cmd in mesh-imac-wifi mesh-imac-input mesh-body-motion mesh-tamper mesh-phone-ip mktemp; do
    command -v "$cmd" >/dev/null 2>&1 || { echo "smoke-test: FAIL (no $cmd)"; exit 1; }
  done
  IMAC_HOST="${MESH_IMAC_HOST:-ilya@192.168.8.214}"
  _scr="${BASH_SOURCE[0]}"
  env -i PATH=/tmp/empty HOME="$HOME" /bin/bash "$_scr" --test >/dev/null 2>&1 && {
    echo "smoke-test: FAIL (missing deps should fail)"; exit 1;
  }

  _td="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp failed)"; exit 1; }
  trap 'rm -rf "$_td"' EXIT
  mkdir -p "$_td/bin" "$_td/home/.mesh"

  cat > "$_td/bin/mesh-imac-wifi" <<'EOF'
#!/usr/bin/env bash
case "${SCENARIO:-atdesk}" in
  away)   printf '{"label":"UNREACHABLE","rssi":0,"noise":0,"snr":0,"txrate":0,"swing":0,"n_trend":0,"ssid":"","ts":"%s"}\n' "$(date -u +%FT%TZ)" ;;
  active|near) printf '{"label":"MOTION","rssi":-51,"noise":-97,"snr":46,"txrate":144,"swing":9,"n_trend":4,"ssid":"stub","ts":"%s"}\n' "$(date -u +%FT%TZ)" ;;
  partial|weak|atdesk|stirred|phoneactive) printf '{"label":"STABLE","rssi":-53,"noise":-97,"snr":44,"txrate":144,"swing":0,"n_trend":4,"ssid":"stub","ts":"%s"}\n' "$(date -u +%FT%TZ)" ;;
  *) printf '{"label":"STABLE","rssi":-53,"noise":-97,"snr":44,"txrate":144,"swing":0,"n_trend":4,"ssid":"stub","ts":"%s"}\n' "$(date -u +%FT%TZ)" ;;
esac
EOF
  cat > "$_td/bin/mesh-imac-input" <<'EOF'
#!/usr/bin/env bash
case "${SCENARIO:-atdesk}" in
  typing|typingpartial) echo '[imac-input] idle_s=30 display=on' ;;
  inputdead)            exit 2 ;;
  *)                    echo '[imac-input] idle_s=3600 display=on' ;;
esac
EOF
  cat > "$_td/bin/mesh-body-motion" <<'EOF'
#!/usr/bin/env bash
case "${SCENARIO:-atdesk}" in
  active)      echo '[body-walking] MOVING' ;;
  # hollowphone: the phone ANSWERS ssh (phone_ok=1) but the motion axis produces NOTHING —
  # mesh-body-motion's own honest-exit path (rc=2, message on stderr, empty stdout).
  hollowphone) echo 'phone unreachable — no body-motion read (not a state, n/a)' >&2; exit 2 ;;
  near|stirred|atdesk|partial|weak|away|phoneactive) echo '[body-still] STILL' ;;
  *)           echo '[body-still] STILL' ;;
esac
EOF
  cat > "$_td/bin/mesh-tamper" <<'EOF'
#!/usr/bin/env bash
case "${SCENARIO:-atdesk}" in
  stirred) echo '[body-moved] MOVED' ;;
  *)       echo '[body-quiet] QUIET' ;;
esac
EOF
  cat > "$_td/bin/mesh-phone-ip" <<'EOF'
#!/usr/bin/env bash
case "${SCENARIO:-atdesk}" in partial|typingpartial|camperson|camnobody|camstale) exit 1 ;; esac
echo 192.0.2.55
EOF
  # SSH liveness-probe stub: the phone ACCEPTS (exit 0) for reachable scenarios; for `cachedoffline`
  # mesh-phone-ip still serves a (dead) cached IP but the probe must FAIL (exit 255) — the regression
  # guard for the phone-ip-exit0!=reachable bug (a cached IP must NOT be trusted as reachable).
  cat > "$_td/bin/ssh" <<'EOF'
#!/usr/bin/env bash
[ "${SCENARIO:-atdesk}" = cachedoffline ] && exit 255
exit 0
EOF
  chmod +x "$_td/bin/"* || { echo "smoke-test: FAIL (stub chmod failed)"; exit 1; }

  out="$(PATH="$_td/bin:/usr/bin:/bin" HOME="$_td/home" SCENARIO=atdesk bash "$_scr" 2>&1)" || {
    echo "smoke-test: FAIL (AT-DESK dry-run failed: $out)"; exit 1;
  }
  printf '%s\n' "$out" | grep -q '^\[desk-state\] AT-DESK ' || {
    echo "smoke-test: FAIL (AT-DESK branch not reached: $out)"; exit 1;
  }

  out="$(PATH="$_td/bin:/usr/bin:/bin" HOME="$_td/home" SCENARIO=active bash "$_scr" 2>&1)" || {
    echo "smoke-test: FAIL (ACTIVE-CONFIRMED dry-run failed: $out)"; exit 1;
  }
  printf '%s\n' "$out" | grep -q '^\[desk-state\] ACTIVE-CONFIRMED ' || {
    echo "smoke-test: FAIL (ACTIVE-CONFIRMED branch not reached: $out)"; exit 1;
  }

  out="$(PATH="$_td/bin:/usr/bin:/bin" HOME="$_td/home" SCENARIO=near bash "$_scr" 2>&1)" || {
    echo "smoke-test: FAIL (NEAR-IMAC dry-run failed: $out)"; exit 1;
  }
  printf '%s\n' "$out" | grep -q '^\[desk-state\] NEAR-IMAC ' || {
    echo "smoke-test: FAIL (NEAR-IMAC branch not reached: $out)"; exit 1;
  }

  out="$(PATH="$_td/bin:/usr/bin:/bin" HOME="$_td/home" SCENARIO=partial bash "$_scr" 2>&1)" || {
    echo "smoke-test: FAIL (PARTIAL-IMAC dry-run failed: $out)"; exit 1;
  }
  printf '%s\n' "$out" | grep -q '^\[desk-state\] PARTIAL-IMAC ' || {
    echo "smoke-test: FAIL (PARTIAL-IMAC branch not reached: $out)"; exit 1;
  }

  out="$(PATH="$_td/bin:/usr/bin:/bin" HOME="$_td/home" SCENARIO=away bash "$_scr" 2>&1)" || {
    echo "smoke-test: FAIL (AWAY dry-run failed: $out)"; exit 1;
  }
  printf '%s\n' "$out" | grep -q '^\[desk-state\] AWAY ' || {
    echo "smoke-test: FAIL (AWAY branch not reached: $out)"; exit 1;
  }

  # INPUT axis: fresh keyboard/mouse input is DIRECT evidence — must win over quiet-session inference…
  out="$(PATH="$_td/bin:/usr/bin:/bin" HOME="$_td/home" SCENARIO=typing bash "$_scr" 2>&1)" || {
    echo "smoke-test: FAIL (AT-DESK-TYPING dry-run failed: $out)"; exit 1;
  }
  printf '%s\n' "$out" | grep -q '^\[desk-state\] AT-DESK-TYPING ' || {
    echo "smoke-test: FAIL (AT-DESK-TYPING branch not reached: $out)"; exit 1;
  }

  # …and over the phone-offline PARTIAL degradation (the axis's whole point: survives dead phone)
  out="$(PATH="$_td/bin:/usr/bin:/bin" HOME="$_td/home" SCENARIO=typingpartial bash "$_scr" 2>&1)" || {
    echo "smoke-test: FAIL (typing+phone-offline dry-run failed: $out)"; exit 1;
  }
  printf '%s\n' "$out" | grep -q '^\[desk-state\] AT-DESK-TYPING ' || {
    echo "smoke-test: FAIL (typing must beat PARTIAL-IMAC when phone offline: $out)"; exit 1;
  }

  # input sense dead while iMac reachable: state falls back normally BUT input=UNREACHABLE must
  # render visibly in signals (a dead axis is never a silent all-clear)
  out="$(PATH="$_td/bin:/usr/bin:/bin" HOME="$_td/home" SCENARIO=inputdead bash "$_scr" 2>&1)" || {
    echo "smoke-test: FAIL (inputdead dry-run failed: $out)"; exit 1;
  }
  printf '%s\n' "$out" | grep -q '^\[desk-state\] AT-DESK .*input=UNREACHABLE' || {
    echo "smoke-test: FAIL (dead input axis must render input=UNREACHABLE, not vanish: $out)"; exit 1;
  }

  # REGRESSION: mesh-phone-ip serves a dead CACHED IP (exit 0) but the SSH liveness probe fails → the
  # gate must set phone_ok=0 and NOT stall on body+tamper → PARTIAL-IMAC (iMac STABLE, no motion data).
  # Guards the phone-ip-exit0!=reachable bug fixed 2026-06-25 (a cached IP wrongly trusted as reachable).
  out="$(PATH="$_td/bin:/usr/bin:/bin" HOME="$_td/home" SCENARIO=cachedoffline bash "$_scr" 2>&1)" || {
    echo "smoke-test: FAIL (cached-offline dry-run failed: $out)"; exit 1;
  }
  printf '%s\n' "$out" | grep -q '^\[desk-state\] PARTIAL-IMAC ' || {
    echo "smoke-test: FAIL (cached-offline: dead cached IP must gate phone_ok=0 via SSH probe → PARTIAL-IMAC, got: $out)"; exit 1;
  }

  # REGRESSION (2026-08-17, found by the desk×ambient correlate investigation): the phone ANSWERS
  # the ssh liveness probe (phone_ok=1) but mesh-body-motion produces no read and exits 2 — reachable
  # is not producing. The rc was discarded, body silently stayed UNKNOWN, every body-based branch
  # below fell through, and the sense published DEGRADED:signals — a MIXED-OCCUPANCY verdict for what
  # is really a DEAD AXIS. 15 such rows on 2026-08-15..17 (the sense had never emitted DEGRADED in the
  # prior month). Must read PARTIAL-IMAC — same substance as phone_ok=0 — and must NAME the axis loss.
  out="$(PATH="$_td/bin:/usr/bin:/bin" HOME="$_td/home" SCENARIO=hollowphone bash "$_scr" 2>&1)" || {
    echo "smoke-test: FAIL (hollowphone dry-run failed: $out)"; exit 1;
  }
  printf '%s\n' "$out" | grep -qE '^\[desk-state\] PARTIAL-IMAC(:[a-z-]+)? ' || {
    echo "smoke-test: FAIL (phone reachable + body-motion rc=2 must read PARTIAL-IMAC, not a mixed-signal DEGRADED: $out)"; exit 1;
  }
  printf '%s\n' "$out" | grep -q 'body=NO-READ' || {
    echo "smoke-test: FAIL (a non-producing motion axis must render body=NO-READ in signals, never a bare UNKNOWN: $out)"; exit 1;
  }

  # CAM axis (visual occupancy from mesh-imac-cam-watch's local artifacts):
  # a recognized person in frame must beat the phone-offline PARTIAL degradation…
  printf 'SEEING\n' > "$_td/home/.mesh/.imac-cam-watch.state"
  date +%s > "$_td/home/.mesh/.imac-cam-last-classify"
  printf '2026-07-05T12:00:00Z\tRozalia\n' > "$_td/home/.mesh/imac-person-log.tsv"
  out="$(PATH="$_td/bin:/usr/bin:/bin" HOME="$_td/home" SCENARIO=camperson bash "$_scr" 2>&1)" || {
    echo "smoke-test: FAIL (camperson dry-run failed: $out)"; exit 1;
  }
  printf '%s\n' "$out" | grep -q '^\[desk-state\] SEEN-IN-ROOM .*who=Rozalia' || {
    echo "smoke-test: FAIL (recognized person in frame must yield SEEN-IN-ROOM over PARTIAL-IMAC: $out)"; exit 1;
  }

  # …but motion with who=Nobody must NOT upgrade (frame-diff can be light/curtain artifacts) —
  # it stays PARTIAL-IMAC with the motion visible in signals only
  printf '2026-07-05T12:00:00Z\tNobody\n' > "$_td/home/.mesh/imac-person-log.tsv"
  out="$(PATH="$_td/bin:/usr/bin:/bin" HOME="$_td/home" SCENARIO=camnobody bash "$_scr" 2>&1)" || {
    echo "smoke-test: FAIL (camnobody dry-run failed: $out)"; exit 1;
  }
  printf '%s\n' "$out" | grep -q '^\[desk-state\] PARTIAL-IMAC .*cam=MOTION([0-9]*s,who=Nobody)' || {
    echo "smoke-test: FAIL (who=Nobody motion must stay PARTIAL-IMAC with cam=MOTION(..,who=Nobody) in signals: $out)"; exit 1;
  }

  # …and a dead watcher (stale state mtime) must render cam=STALE, never a silent all-clear
  touch -d '1 hour ago' "$_td/home/.mesh/.imac-cam-watch.state"
  out="$(PATH="$_td/bin:/usr/bin:/bin" HOME="$_td/home" SCENARIO=camstale bash "$_scr" 2>&1)" || {
    echo "smoke-test: FAIL (camstale dry-run failed: $out)"; exit 1;
  }
  printf '%s\n' "$out" | grep -q '^\[desk-state\] PARTIAL-IMAC .*cam=STALE' || {
    echo "smoke-test: FAIL (dead cam-watch loop must render cam=STALE, got: $out)"; exit 1;
  }

  echo "smoke-test: ok (dep gate + synthetic fusion branches incl. INPUT axis + cached-offline reachability-probe regression + CAM axis: person-upgrade / Nobody-no-upgrade / stale-watcher verified)"
  exit 0
}

TS=$(date -u +%H:%M:%SZ)

# ---- Read iMac WiFi (independent of phone) ----
imac_json="$(timeout 12 mesh-imac-wifi --json 2>/dev/null)"; imac_rc=$?
if [ "$imac_rc" = 2 ] || [ -z "$imac_json" ]; then
  imac="UNREACHABLE"
else
  imac="$(printf '%s' "$imac_json" | grep -o '"label":"[^"]*"' | cut -d'"' -f4)"
  [ -n "$imac" ] || imac="UNKNOWN"
fi

# ---- Read iMac input recency (same organ, independent axis; skip the SSH stall when host dark) ----
input="UNREACHABLE"; input_idle=""
if [ "$imac" != "UNREACHABLE" ]; then
  in_out="$(timeout 15 mesh-imac-input 2>/dev/null)" && \
    input_idle="$(printf '%s' "$in_out" | grep -o 'idle_s=[0-9]*' | cut -d= -f2)"
  if [ -n "$input_idle" ]; then
    if [ "$input_idle" -lt "${MESH_DESK_INPUT_FRESH:-120}" ]; then
      input="TYPING(${input_idle}s)"
    else
      input="IDLE(${input_idle}s)"
    fi
  fi
fi

# ---- Phone reachability gate (avoids body+tamper timeout stalls when phone offline) ----
# mesh-phone-ip returns a CACHED / registry last-known IP with exit 0 even when the phone is OFFLINE
# (its documented "degrade honestly" contract), so its exit code means resolved-OR-last-known, NOT
# reachable — gating on it alone never skips the dead senses and eats ~35s of body+tamper SSH stalls,
# the exact stall this gate exists to avoid. So resolve the IP, then VERIFY with one fast SSH liveness
# probe: phone_ok=1 only if the phone truly ACCEPTS. (Same fix + root cause as mesh-activity-tempo
# 2026-06-25; see ~/.mesh/knowledge/phone-ip-exit0-is-not-reachability.md)
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes"
phone_ok=0
if command -v mesh-phone-ip >/dev/null 2>&1; then
  _pip="$(timeout 10 mesh-phone-ip 2>/dev/null)" || _pip=""
  if [ -n "$_pip" ] && timeout 6 ssh -p "${PHONE_SSH_PORT:-8022}" -o BatchMode=yes -o ConnectTimeout=4 \
       -o StrictHostKeyChecking=accept-new "${PHONE_USER:-u0_a380}@$_pip" true </dev/null >/dev/null 2>&1; then
    phone_ok=1
  fi
fi

# ---- Cannot assess at all ----
if [ "$imac" = "UNREACHABLE" ] && [ "$phone_ok" = 0 ]; then
  printf 'desk-state: iMac unreachable + phone offline — cannot assess\n' >&2
  exit 2
fi

# ---- Read iMac CAM axis (local artifacts from mesh-imac-cam-watch — zero SSH cost) ----
# cam=OFF (watcher never deployed) / STALE (watcher loop dead) / DARK|FLAT|CAPTURE-FAIL (lens
# blind) / QUIET (seeing, no recent motion) / MOTION(<age>s[,who=<name>]). Only a recognized
# person upgrades the fused state; everything else is signal-visible context.
CAM_STATE_F="$HOME/.mesh/.imac-cam-watch.state"
CAM_CLASSIFY_F="$HOME/.mesh/.imac-cam-last-classify"
CAM_PERSONLOG="$HOME/.mesh/imac-person-log.tsv"
CAM_FRESH="${MESH_DESK_CAM_FRESH:-360}"    # 3× the watcher's 120s state refresh
CAM_WINDOW="${MESH_DESK_CAM_WINDOW:-300}"  # how recent visual motion must be to fuse
cam="OFF"; cam_who=""; cam_age=""; cam_person=0
if [ -f "$CAM_STATE_F" ]; then
  _now="$(date +%s)"; _cage=$(( _now - $(stat -c %Y "$CAM_STATE_F" 2>/dev/null || echo 0) ))
  _cls="$(cat "$CAM_STATE_F" 2>/dev/null)"
  if [ "$_cage" -gt "$CAM_FRESH" ]; then
    cam="STALE"   # watcher dead — axis honestly absent, distinct from a quiet lens
  else
    case "$_cls" in
      SEEING)
        _lc=0; [ -f "$CAM_CLASSIFY_F" ] && _lc="$(cat "$CAM_CLASSIFY_F" 2>/dev/null || echo 0)"
        case "$_lc" in ''|*[!0-9]*) _lc=0 ;; esac
        cam_age=$(( _now - _lc ))
        if [ "$_lc" -gt 0 ] && [ "$cam_age" -le "$CAM_WINDOW" ]; then
          cam="MOTION(${cam_age}s)"
          # who was in frame at that same motion event (cam-watch appends person-log in the
          # same classify block that stamps CAM_CLASSIFY_F — last line = this event)
          _who="$(tail -n1 "$CAM_PERSONLOG" 2>/dev/null | cut -f2)"
          case "$_who" in
            Ilya|Rozalia|Stranger) cam_who="$_who"; cam_person=1; cam="MOTION(${cam_age}s,who=${_who})" ;;
            Nobody)                cam_who="Nobody"; cam="MOTION(${cam_age}s,who=Nobody)" ;;
          esac
        else
          cam="QUIET"
        fi ;;
      DARK|FLAT|CAPTURE-FAIL) cam="$_cls" ;;
      *) cam="STALE" ;;
    esac
  fi
fi

# ---- Read phone senses (only if phone reachable) ----
body="UNKNOWN"; tamper="UNKNOWN"
if [ "$phone_ok" = 1 ]; then
  # HONEST-EXIT SYMMETRY with the tamper read below (which already branches on rc=2): mesh-body-motion
  # exits 2 for "the phone answered but the motion axis produced NO read" — reachability is not
  # producing. Discarding that rc left body at a bare UNKNOWN, indistinguishable from "read fine, no
  # pattern matched", and the fusion below then reported DEGRADED:signals. NO-READ is that distinction.
  body_out="$(timeout 20 mesh-body-motion 2>/dev/null)"; body_rc=$?
  if printf '%s' "$body_out" | grep -qE '\[body-(walking|carried)\]'; then
    body="MOVING"
  elif printf '%s' "$body_out" | grep -q '\[body-handled\]'; then
    body="HANDLED"
  elif printf '%s' "$body_out" | grep -qE '\[body-(still|covered)\]'; then
    body="STILL"
  elif [ "$body_rc" != 0 ] || [ -z "$body_out" ]; then
    # rc=2 (honest n/a) · rc=124 (timeout 20 fired) · empty stdout — all the same fact: no read.
    body="NO-READ"
  fi

  tamper_out="$(timeout 15 mesh-tamper 2>/dev/null)"; tamper_rc=$?
  if [ "$tamper_rc" = 2 ]; then tamper="UNKNOWN"
  elif printf '%s' "$tamper_out" | grep -q 'body-moved'; then tamper="MOVED"
  elif printf '%s' "$tamper_out" | grep -q 'body-quiet'; then tamper="QUIET"
  fi
fi

# ---- Fusion ----
state=""; reason=""
signals="iMac=${imac} input=${input} body=${body} tamper=${tamper} cam=${cam}"

if [ "$imac" = "UNREACHABLE" ]; then
  # iMac off/asleep is a REAL signal, not just "unknown"
  state="AWAY"; reason="iMac off or asleep — operator away from desk"
elif [ -n "$input_idle" ] && [ "$input_idle" -lt "${MESH_DESK_INPUT_FRESH:-120}" ]; then
  # Direct evidence outranks every inference below (incl. phone-offline PARTIAL): typing is
  # person-specific — a TV can't do it. Household-scoped: "someone", not "operator".
  state="AT-DESK-TYPING"; reason="keyboard/mouse input ${input_idle}s ago — someone at the iMac (direct evidence)"
elif [ "$cam_person" = 1 ]; then
  # Second direct-evidence tier: the lens SAW a person just now. Beats every RF/phone
  # inference below (incl. phone-offline PARTIAL); only typing is more specific (at the
  # keyboard vs in the room). who=Nobody / recognition-failed never reaches here.
  state="SEEN-IN-ROOM"; reason="camera saw ${cam_who} ${cam_age}s ago — visual occupancy (direct evidence)"
elif [ "$phone_ok" = 0 ]; then
  state="PARTIAL-IMAC"; reason="phone offline — iMac=${imac} only, no motion data"
elif [ "$tamper" = "MOVED" ] && [ "$body" != "MOVING" ]; then
  state="STIRRED"; reason="brief physical disturbance (tamper, no sustained locomotion)"
elif [ "$body" = "NO-READ" ]; then
  # The phone ANSWERED (phone_ok=1) but its MOTION axis produced nothing. Every branch below
  # infers from $body, so without this the row falls to DEGRADED:signals — which reads as
  # "the operator is ambiguously at the desk" when the truth is "one axis is dead". Same
  # substance as the phone_ok=0 case above → same state token (consumers key on PARTIAL-IMAC),
  # with a suffix naming WHICH way the phone axis was lost. Kept BELOW the tamper=MOVED branch:
  # a real tamper read still says something, and STIRRED is that something.
  state="PARTIAL-IMAC:phone-hollow"
  reason="phone answers ssh but body-motion produced no read (rc=${body_rc}) — iMac=${imac} only, no motion data"
elif [ "$imac" = "MOTION" ] && [ "$body" = "MOVING" ]; then
  state="ACTIVE-CONFIRMED"; reason="iMac RF disturbance + phone locomotion: both agree — operator active"
elif [ "$imac" = "MOTION" ] && [ "$body" = "HANDLED" ]; then
  state="ACTIVE-CONFIRMED"; reason="iMac RF disturbance + phone handled: corroborated activity"
elif [ "$imac" = "MOTION" ] && [ "$body" = "STILL" ]; then
  state="NEAR-IMAC"; reason="RF disturbance near iMac but phone stationary — phone set down at desk"
elif ( [ "$imac" = "STABLE" ] || [ "$imac" = "WEAK" ] ) && [ "$body" = "MOVING" ]; then
  state="PHONE-ACTIVE"; reason="phone moving but iMac undisturbed — operator away from iMac area"
elif ( [ "$imac" = "STABLE" ] || [ "$imac" = "WEAK" ] ) && [ "$body" = "HANDLED" ]; then
  state="PHONE-ACTIVE"; reason="phone handled but iMac undisturbed — operator near phone, not desk"
elif [ "$imac" = "STABLE" ] && [ "$body" = "STILL" ] && [ "$tamper" = "QUIET" ]; then
  state="AT-DESK"; reason="iMac stable + phone still + no tamper — quiet seated session"
elif [ "$imac" = "WEAK" ] && [ "$body" = "STILL" ]; then
  state="DEGRADED:imac-weak"; reason="iMac SNR low (link unreliable), phone still"
else
  state="DEGRADED:signals"; reason="mixed/insufficient: ${signals}"
fi

# ---- Output ----
imac_ok=true; [ "$imac" = "UNREACHABLE" ] && imac_ok=false
ph_ok=true; [ "$phone_ok" = 0 ] && ph_ok=false

if [ "$MODE" = json ]; then
  printf '{"state":"%s","reason":"%s","signals":"%s","imac_ok":%s,"phone_ok":%s,"cam":"%s","ts":"%s"}\n' \
    "$state" "$reason" "$signals" "$imac_ok" "$ph_ok" "$cam" "$TS"
else
  printf '[desk-state] %s — %s | %s\n' "$state" "$reason" "$signals"
fi
