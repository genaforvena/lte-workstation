#!/usr/bin/env bash
# mesh-claim-verify — close the claim loop: AUTO-RELEASE stale claims whose work is already DONE
# (bus evidence), NUDGE the owner of stale claims that are not. Borrowing #2 from the operator's work
# mesh (guy-fawxible / gf-claim-verify, operator observation 2026-07-11: "8 active claims found, 5
# already done via merged work, none released — claims sit stale forever"), re-derived as OUR tool
# over OUR mesh-chat markers — never their repo/instance.
#
# The gap this closes: mesh-claim gives claim + TTL + liveness, and `mesh-claim --sweep` SURFACES
# newly-stale claims as a [stale] line — but NOTHING checks whether the work is already DONE and
# releases the claim. A mind finishes (posts [done]) yet forgets `mesh-claim --done`, so the claim
# ages into a permanent [stale] cry and blocks re-dispatch of the artifact. This reflex verifies +
# releases, or nudges. It NEVER does the work itself (operator directive: verify/mark or nudge only).
#
# Our markers (see mesh-claim): "[claim] <key> ttl=<sec>", released by "[claim-done]"/"[yield]".
# A STALE claim = one `mesh-claim --list` classifies STALE (owner IDLE/DEAD via mesh-mind-state, or
# past its TTL with the owner's liveness unknowable). We only ever touch STALE claims — a live, tended
# claim is never second-guessed — plus EXPIRED ones (past TTL, owner LIVE), which we NUDGE and never
# release. See claims_to_verify for why the two are not one list.
#
# Per stale claim:
#   1. evidence = a [done]/[interpretation] bus line AFTER the claim's timestamp that names the key —
#      exact key match is strongest; else EVERY key-part >3 chars must match (the gf 2026-07-13
#      hardening: a single partial token like "vast" false-released a claim on an unrelated line).
#   2. evidence  -> `mesh-claim --done <key>` (allowed on a stale claim) + one [note] (transparency,
#                   the release happened in a pane the operator may not be watching).
#   3. no evidence -> `mesh-nudge` the owner window to finish or --yield (LOCAL owners only; a remote
#                   owner can't be injected from here — surfaced, not nudged). Dedup + cooldown so a
#                   still-stale claim isn't re-nudged every tick (the gf-claim-sweep flood we won't repeat).
#
# reflex-cadence: 3-59/10 * * * *
# reflex-args: --once
#
#   mesh-claim-verify --once    one verification pass (cron)
#   mesh-claim-verify --dry     preview verdicts, change nothing (no release, no nudge, no post)
#   mesh-claim-verify --watch   live display for a verifier pane
#   mesh-claim-verify --test    hermetic smoke (pure evidence-match logic; no board/nudge side-effects)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"   # cron PATH gap: we call bare mesh-claim/mesh-nudge/mesh-chat

BOARD="${MESH_CHAT_LOG:-$HOME/.mesh/chat.log}"
HOST="$(hostname)"
SEEN="$HOME/.mesh/.claim-verify-seen"
CLAIM_MIN="${MESH_CLAIM_VERIFY_MIN:-1}"                 # a stale claim younger than this many minutes is skipped (grace)
NUDGE_CD="${MESH_CLAIM_VERIFY_NUDGE_COOLDOWN:-30}"      # minutes between re-nudges of the same key
# A COOLDOWN IS NOT A GIVEUP (chat-review/rate-limited-owner-reads-live {#4cdb7881}). NUDGE_CD only
# spaces the nudges out; nothing above ever STOPS. Live case: hh-browser collected 38 nudges over
# 450 minutes while its owner (job@mesh-home) sat behind a quota wall and could not read one of them —
# a forever loop with no escalation and no reader. Modelled on mesh-channel-keepalive's AUTH_GIVEUP=3:
# after this many nudges on the SAME claim generation, stop poking and say ONE loud thing instead.
NUDGE_GIVEUP="${MESH_CLAIM_VERIFY_NUDGE_GIVEUP:-3}"     # nudges on one claim generation before escalating

INTERVAL="${MESH_CLAIM_VERIFY_INTERVAL:-30}"           # --watch refresh seconds
: "${MESH_WHO:=claim-verify@$HOST}"; export MESH_WHO   # posts/releases attributed to the reflex, not '?'
# load-time touch below runs on EVERY invocation, --test included — divert the seen-file when this IS
# a test ($1) or a test's child (exported flag), so a smoke run can never stamp the live artifact
# (task test-live-writes 2026-07-20). Placed here, not in the --test case: the touch fires first.
if [ "${1:-}" = --test ] || [ "${MESH_TEST_SANDBOX:-0}" = 1 ]; then
  # tmp fence — task:doctor-test-tmpdir-cleanup-traps. Re-exec the test ONCE under a private TMPDIR
  # and remove it from the PARENT, so the cleanup cannot be lost to the test's own `exit 1` and
  # cannot be clobbered by an EXIT trap the test sets. It sits HERE, above the load-time touch and
  # not in the --test case, for the same reason the sandbox diversion does: the touch fires first,
  # so a fence armed at the dispatch is one file too late (measured — it left the sandbox seen-file
  # behind in the caller's TMPDIR while every mktemp was already collected).
  if [ -z "${MESH_TEST_TMPD:-}" ]; then
    MESH_TEST_TMPD="$(mktemp -d)" || { echo "smoke-test: FAIL (tmp fence: mktemp -d)"; exit 1; }
    trap 'rm -rf "$MESH_TEST_TMPD"' EXIT INT HUP TERM
    export MESH_TEST_TMPD TMPDIR="$MESH_TEST_TMPD" TMP="$MESH_TEST_TMPD" TEMP="$MESH_TEST_TMPD"
    _fence_rc=0; "$0" "$@" || _fence_rc=$?; exit "$_fence_rc"
  fi
  SEEN="${TMPDIR:-/tmp}/.claim-verify-seen.sandbox.$$"
fi
mkdir -p "$HOME/.mesh"; touch "$SEEN" 2>/dev/null || true

now_epoch() { date +%s; }
iso_epoch() { date -d "$1" +%s 2>/dev/null || echo 0; }
mins_since() { local e="${1:-0}"; [ "$e" -gt 0 ] 2>/dev/null || { echo 999999; return; }; echo $(( ( $(now_epoch) - e ) / 60 )); }

# --- pure: key -> its matchable parts (>3 chars), split on the artifact-key separators - / : # . ----
key_parts() { printf '%s' "${1:-}" | tr '/:#._-' ' ' | tr ' ' '\n' | awk 'length($0)>3'; }

# --- pure: does <key> have completion evidence among the candidate lines on STDIN? ------------------
# echoes the matching line and returns 0 if yes, returns 1 (no output) if not. Exact key substring is
# the strongest signal; else EVERY key-part >3 chars must appear (progressive AND-filter) so a lone
# partial token can't false-release. If the key has NO part >3 chars, ONLY an exact match counts.
evidence_match() {
  local key="$1" lines; lines="$(cat)"
  [ -n "$lines" ] || return 1
  local hit; hit="$(printf '%s\n' "$lines" | grep -aiF -- "$key" | head -1)"
  [ -n "$hit" ] && { printf '%s\n' "$hit"; return 0; }
  local kw matched=0 rest="$lines"
  while IFS= read -r kw; do
    [ -n "$kw" ] || continue
    matched=1
    rest="$(printf '%s\n' "$rest" | grep -aiF -- "$kw")"
    [ -n "$rest" ] || return 1
  done <<EOF
$(key_parts "$key")
EOF
  [ "$matched" = 1 ] || return 1          # no part >3 chars and no exact hit -> not evidence
  printf '%s\n' "$rest" | head -1
}

# --- board reads -----------------------------------------------------------------------------------
# stale active claims as "key<TAB>who<TAB>state" (owner = the board WHO that posted the [claim]).
#
# TWO LISTS, TWO REMEDIES (mesh-claim task {#b2d997b4}). mesh-claim used to collapse "past TTL" and
# "the owner walked away" into one word, so this reflex received a claim whose owner was measurably
# MID-TURN and ran its release-or-nudge ladder over it. Now:
#   STALE (abandoned)  — unchanged: [done] evidence -> auto-release; else nudge "is the work done?".
#   EXPIRED (owner LIVE, TTL lapsed) — NUDGE ONLY, never released. The evidence matcher is deliberately
#     fuzzy (every key-part >3 chars), which is acceptable against a claim nobody is tending and is the
#     wrong risk entirely against one whose owner is running a turn right now: a false release there
#     hands a second writer live work. mesh-chat's own [done] hook (--force, exact-key) still releases
#     an expired claim the moment its owner actually posts [done], so nothing is stranded by this.
claims_to_verify() {
  mesh-claim --list-stale   2>/dev/null | awk -F'\t' '{ w=$2; sub(/^owner=/,"",w); print $1 "\t" w "\tSTALE" }'
  mesh-claim --list-expired 2>/dev/null | awk -F'\t' '{ w=$2; sub(/^owner=/,"",w); print $1 "\t" w "\tEXPIRED" }'
  # HELD-INCAPABLE (mesh-claim {#4cdb7881}): the owner window is RATE-LIMITED — quota wall / keepalive
  # shed. It is pulled in HERE, deliberately, rather than left out of every list: a claim this reflex
  # never sees is a claim nobody is looking at. It gets NEITHER remedy — no release (the owner did not
  # walk away) and no nudge (it cannot read one; that is precisely the 38-nudge forever loop) — only a
  # surfaced line. Absent from this list the tool would be silently right; present, it is auditably so.
  mesh-claim --list-held-incapable 2>/dev/null | awk -F'\t' '{ w=$2; sub(/^owner=/,"",w); print $1 "\t" w "\tHELD-INCAPABLE" }'
}
# latest [claim] line for <key> -> "ts_iso<TAB>intent" (intent = text after "[claim] <key> ttl=<sec>").
claim_line() {
  local key="$1"
  awk -v key="$key" '
    { i=index($0,"  ::  "); if(i==0) next
      ts=$1; msg=substr($0,i+6); sub(/^[ \t]+/,"",msg)
      if (msg !~ /^\[claim\] /) next
      b=msg; sub(/^\[claim\] /,"",b); k=b; sub(/[ \t].*$/,"",k)
      if (k!=key) next
      intent=b; sub(/^[^ \t]+[ \t]+/,"",intent); sub(/^ttl=[0-9]+[ \t]*/,"",intent)
      last=ts "\t" intent }
    END{ if(last!="") print last }' "$BOARD" 2>/dev/null
}
# completion-evidence lines strictly AFTER <claim_ts> ([done]/[interpretation] markers, body-anchored).
evidence_lines() {
  local claim_ts="$1"
  awk -v ts="$claim_ts" '$1 > ts' "$BOARD" 2>/dev/null \
    | awk '{ i=index($0,"  ::  "); if(i==0) next; m=substr($0,i+6); sub(/^[ \t]+/,"",m)
            if (m ~ /^\[(done|interpretation)\] /) print }'
}

# --- nudge dedup -----------------------------------------------------------------------------------
# SEEN rows are "key<TAB>epoch<TAB>claim_ts<TAB>verb". The claim_ts is what makes the streak a
# property of ONE claim generation: a re-claim (new [claim] line, new ts) starts the count clean, so a
# key that legitimately cycles can never inherit a giveup from a claim that closed months ago. Rows
# written before this field simply carry no generation and match no live claim — the streak restarts
# once, which is the safe direction.
nudge_count() {  # <key> <claim_ts> -> nudges already sent on THIS claim generation
  awk -F'\t' -v k="$1" -v g="$2" '$1==k && $3==g && $4!="giveup"{n++} END{print n+0}' "$SEEN" 2>/dev/null
}
gave_up() {      # <key> <claim_ts> -> 0 if the escalation was already posted for this generation
  [ "$(awk -F'\t' -v k="$1" -v g="$2" '$1==k && $3==g && $4=="giveup"{n++} END{print n+0}' "$SEEN" 2>/dev/null)" -gt 0 ] 2>/dev/null
}
nudge_due() {  # <key> [<claim_ts>] -> 0 due / 1 cooling down
  local key="$1" last
  last="$(awk -F'\t' -v k="$key" '$1==k && $4!="giveup"{v=$2} END{print v}' "$SEEN" 2>/dev/null)"
  [ -n "$last" ] || return 0
  [ "$(mins_since "$last")" -ge "$NUDGE_CD" ]
}
mark_nudged() { printf '%s\t%s\t%s\t%s\n' "$1" "$(now_epoch)" "${2:-}" nudge  >> "$SEEN"; }
mark_gaveup() { printf '%s\t%s\t%s\t%s\n' "$1" "$(now_epoch)" "${2:-}" giveup >> "$SEEN"; }

# owner window if the owner is a LOCAL, injectable mind window (bare "window@thishost"); else "".
# A "user/caller@host" identity (derive_who's reflex/cron form) has a slash and is NOT a tmux window —
# nudging it would send-keys into a non-existent window; treat it as uninjectable (surface, don't nudge).
local_window() {  # <who> -> window | ""
  local who="$1"
  case "$who" in *@*) : ;; *) return 0 ;; esac
  [ "${who##*@}" = "$HOST" ] || return 0
  local win="${who%@*}"
  case "$win" in */*) return 0 ;; esac                 # user/caller identity, not a mind window
  case "$win" in ""|*[!A-Za-z0-9_-]*) return 0 ;; esac
  printf '%s' "$win"
}

# --- one verification pass -------------------------------------------------------------------------
verify_pass() {
  local dry="${1:-0}" n_done=0 n_nudge=0 n_skip=0
  local key who state
  while IFS=$'\t' read -r key who state; do
    [ -n "$key" ] || continue
    state="${state:-STALE}"
    local rec ts intent; rec="$(claim_line "$key")"
    ts="${rec%%$'\t'*}"; intent="${rec#*$'\t'}"; [ "$intent" = "$rec" ] && intent=""
    local age_min; age_min="$(mins_since "$(iso_epoch "$ts")")"
    if [ "$age_min" -lt "$CLAIM_MIN" ]; then n_skip=$((n_skip+1)); continue; fi
    # EXPIRED skips the whole release ladder — see claims_to_verify. It falls straight through to the
    # nudge, which is the remedy the word exists to name.
    # A shed owner is neither released nor nudged — surfaced only, with the reason NAMED so the line
    # cannot be read as an omission. It converts itself: mesh-claim's hold is bounded by arithmetic,
    # so an owner that never comes back ages into STALE and reaches this loop's release ladder then.
    if [ "$state" = HELD-INCAPABLE ]; then
      printf '  \302\267 %-34s HELD-INCAPABLE %sm, owner %s is RATE-LIMITED — not released (it did not walk away), not nudged (it cannot read one)\n' \
        "$key" "$age_min" "$who"
      n_skip=$((n_skip+1)); continue
    fi
    local evidence=""
    [ "$state" = EXPIRED ] || evidence="$(evidence_lines "$ts" | evidence_match "$key")" || evidence=""
    if [ -n "$evidence" ]; then
      printf '  \342\234\223 %-34s DONE  <- %s\n' "$key" "$(printf '%s' "$evidence" | sed 's/.*::  //' | head -c 64)"
      if [ "$dry" = 0 ]; then
        if mesh-claim --done "$key" >/dev/null 2>&1; then
          mesh-chat "[note] claim-verify: auto-released [claim] $key — done evidence: $(printf '%s' "$evidence" | sed 's/.*::  //' | head -c 100)" >/dev/null 2>&1
        fi
      fi
      n_done=$((n_done+1)); continue
    fi
    # no evidence -> nudge the owner (local, injectable), deduped
    local win; win="$(local_window "$who")"
    if [ -z "$win" ]; then
      printf '  \302\267 %-34s %s %sm, owner %s (remote/uninjectable) — surfaced only\n' "$key" "$state" "$age_min" "$who"
      n_skip=$((n_skip+1)); continue
    fi
    # THE GIVEUP, ahead of the cooldown: a cooldown that has already fired NUDGE_GIVEUP times is not
    # spacing a conversation out, it is repeating into a room with nobody in it. Say one loud thing,
    # once per claim generation, and stop — an unanswered nudge streak is evidence about the OWNER
    # (shed, wedged, gone), and the remedy for that is a human or a reallocation, not nudge #39.
    local nudges; nudges="$(nudge_count "$key" "$ts")"
    if [ "$nudges" -ge "$NUDGE_GIVEUP" ] 2>/dev/null; then
      if gave_up "$key" "$ts"; then
        printf '  \302\267 %-34s %s, GAVE UP after %s nudges — already escalated\n' "$key" "$state" "$nudges"
      else
        printf '  \342\232\240 %-34s GIVEUP %s after %s nudges (%s %sm)\n' "$key" "$win" "$nudges" "$state" "$age_min"
        if [ "$dry" = 0 ]; then
          mesh-chat "[fyi] claim-verify: GIVEUP on [claim] $key — $nudges nudges to $who over ${age_min}m and it is still $state. Nudging stops here (cooldown ${NUDGE_CD}m x ${NUDGE_GIVEUP}); the owner is not answering, so this needs a hand: release it (mesh-claim --done $key), hand it back (mesh-claim --yield $key), or re-dispatch the work.${intent:+ Intent: $intent}" >/dev/null 2>&1
          mark_gaveup "$key" "$ts"
        fi
      fi
      n_skip=$((n_skip+1)); continue
    fi
    if ! nudge_due "$key"; then
      printf '  \302\267 %-34s %s, nudged recently — skip\n' "$key" "$state"; n_skip=$((n_skip+1)); continue
    fi
    printf '  \342\206\222 %-34s NUDGE %s (%s %sm)\n' "$key" "$win" "$state" "$age_min"
    if [ "$dry" = 0 ]; then
      # The two words get two MESSAGES. Telling a mind that is mid-turn its claim is "STALE — is the
      # work done?" is the same misreading one layer up, just addressed to the owner instead of to a
      # would-be second writer.
      if [ "$state" = EXPIRED ]; then
        printf 'Your claim "%s" has EXPIRED (%sm old, past its ttl) — but you read LIVE, so nobody is taking it. RENEW it: mesh-claim %s --ttl <sec>. If you are actually finished: mesh-claim --done %s; if you are not going to finish: mesh-claim --yield %s.%s' \
          "$key" "$age_min" "$key" "$key" "$key" "${intent:+ Intent: $intent}" \
          | mesh-nudge "$win" >/dev/null 2>&1 && mark_nudged "$key" "$ts"
      else
        printf 'Your claim "%s" is STALE (%sm old). Is the work done? If yes: mesh-claim --done %s. If not: finish it or hand it back with mesh-claim --yield %s.%s' \
          "$key" "$age_min" "$key" "$key" "${intent:+ Intent: $intent}" \
          | mesh-nudge "$win" >/dev/null 2>&1 && mark_nudged "$key" "$ts"
      fi
    fi
    n_nudge=$((n_nudge+1))
  done <<EOF
$(claims_to_verify)
EOF
  printf '  pass: %d released, %d nudged, %d skipped\n' "$n_done" "$n_nudge" "$n_skip"
}

watch_display() {
  while true; do
    printf '\033[2J\033[H  \033[1mCLAIM VERIFIER\033[0m %s\n\n' "$(date -u +'%Y-%m-%d %H:%M UTC')"
    local pending; pending="$(claims_to_verify)"
    if [ -z "$pending" ]; then printf '  no stale or expired claims — loop closed\n'
    else printf '  STALE / EXPIRED CLAIMS:\n'; verify_pass 1; fi
    printf '\n  recent claim-lifecycle bus lines:\n'
    grep -aE '\[(claim|claim-done|yield|stale|note)\]' "$BOARD" 2>/dev/null | tail -8 \
      | sed 's/  ::  /  /; s/^/  /' | cut -c1-100
    sleep "$INTERVAL"
  done
}

case "${1:-}" in
  --test)
    f=""
    # key_parts: only tokens >3 chars, split on - / : # .
    kp="$(key_parts 'alert:ds-freeze-2026' | tr '\n' ',')"
    case "$kp" in *freeze*) : ;; *) f="$f keyparts-missing-freeze" ;; esac
    case "$kp" in *,ds,*|ds,*|*,ds) f="$f keyparts-kept-short-ds" ;; esac   # 'ds' is 2 chars -> must be dropped
    [ -z "$(key_parts 'ab-cd:ef')" ] || f="$f keyparts-all-short-not-empty"  # no part >3 -> empty
    # evidence_match: exact key wins
    ev="$(printf '%s\n' '2026-07-14T10:00:00Z x  ::  [done] genome: shipped repo/run#42' | evidence_match 'repo/run#42')"
    [ -n "$ev" ] || f="$f ev-exact-miss"
    # evidence_match: ALL parts >3 must match (progressive AND)
    ev2="$(printf '%s\n' 'A  ::  [done] finished the mesh-mag akm09918 two-axis fix' | evidence_match 'mesh-mag-akm09918')"
    [ -n "$ev2" ] || f="$f ev-parts-and-miss"     # parts mesh(>3)+akm09918(>3) BOTH present -> match
    ev3="$(printf '%s\n' 'A  ::  [done] unrelated akm09918 note' | evidence_match 'mesh-mag-akm09918')"
    [ -z "$ev3" ] || f="$f ev-partial-false-release"   # 'mesh' absent -> NOT evidence (the gf 2026-07-13 hardening)
    ev4="$(printf '%s\n' 'A  ::  [done] just chatter about genome' | evidence_match 'genome-x-task')"
    [ -z "$ev4" ] || f="$f ev-partial-genome-only-matched"  # parts genome(>3)+task(>3): 'genome' present, 'task' absent -> NOT evidence
    # local_window: bare local window injectable; reflex identity (slash) and remote are not
    [ "$(local_window "genome@$HOST")" = "genome" ]           || f="$f lw-local"
    [ -z "$(local_window "imozerov/mesh-x@$HOST")" ]          || f="$f lw-slash-identity-not-empty"
    [ -z "$(local_window "genome@otherhost")" ]              || f="$f lw-remote-not-empty"
    [ -z "$(local_window "noatsign")" ]                      || f="$f lw-noat-not-empty"
    # deps present (release + nudge + board)
    command -v mesh-claim >/dev/null 2>&1 || f="$f no-mesh-claim"
    command -v mesh-nudge >/dev/null 2>&1 || f="$f no-mesh-nudge"
    command -v mesh-chat  >/dev/null 2>&1 || f="$f no-mesh-chat"
    # sandbox honesty (task test-live-writes 2026-07-20): a nested self-invoke (any verb crosses the
    # load-time touch) must leave the LIVE seen-file untouched. Retry-once: the live claim-verify cron
    # also touches it — a leak reproduces on both attempts, a cron race cannot (next run is minutes off).
    _cv_live="$HOME/.mesh/.claim-verify-seen"; _cv_ok=0
    for _cv_i in 1 2; do
      _cv_s1="$(stat -c '%y %s' "$_cv_live" 2>/dev/null || echo absent)"
      MESH_TEST_SANDBOX=1 "$0" --sandbox-probe-noverb >/dev/null 2>&1 || true
      _cv_s2="$(stat -c '%y %s' "$_cv_live" 2>/dev/null || echo absent)"
      [ "$_cv_s1" = "$_cv_s2" ] && { _cv_ok=1; break; }
    done
    [ "$_cv_ok" = 1 ] || f="$f nested-invoke-stamped-live-seen-file"

    # --- TWO WORDS, TWO REMEDIES (mesh-claim task {#b2d997b4}) -------------------------------------
    # DRIVEN, not asserted in prose: one pass over a board holding a STALE claim and an EXPIRED one,
    # BOTH with [done]-shaped evidence naming them. The stale one must be RELEASED; the expired one
    # must be NUDGED and never released, because its owner is mid-turn and this reflex's evidence
    # matcher is deliberately fuzzy (every key-part >3 chars) — a false release there hands a second
    # writer live work, which is the failure mesh-claim was fixed to stop, re-entered from the side.
    # Stubs on a fake HOME's .local/bin: this file re-exports $HOME/.local/bin (:36), so the stub
    # wins the PATH race that a bare prepend would lose. Nothing real is called and nothing is posted.
    _cv_d="$(mktemp -d)"; mkdir -p "$_cv_d/.local/bin" "$_cv_d/.mesh"
    cat > "$_cv_d/.local/bin/mesh-claim" <<CVSTUB
#!/bin/sh
case "\$1" in
  --list-stale)   printf 'cvtest/stale-key\towner=genome@$HOST\tSTALE\n' ;;
  --list-expired) printf 'cvtest/expired-key\towner=genome@$HOST\tEXPIRED\n' ;;
  --done)         printf '%s\n' "\$2" >> "$_cv_d/released" ;;
esac
exit 0
CVSTUB
    printf '#!/bin/sh\ncat >> "%s/nudged"\nprintf "WIN=%%s\\n" "\$1" >> "%s/nudged"\nexit 0\n' "$_cv_d" "$_cv_d" > "$_cv_d/.local/bin/mesh-nudge"
    printf '#!/bin/sh\nexit 0\n' > "$_cv_d/.local/bin/mesh-chat"
    chmod +x "$_cv_d/.local/bin/mesh-claim" "$_cv_d/.local/bin/mesh-nudge" "$_cv_d/.local/bin/mesh-chat"
    _cv_ts="$(date -u -d '-30 min' +%FT%TZ)"
    {
      printf '%s  genome@%s  ::  [claim] cvtest/stale-key ttl=60 fix the thing\n'   "$_cv_ts" "$HOST"
      printf '%s  genome@%s  ::  [claim] cvtest/expired-key ttl=60 fix the thing\n' "$_cv_ts" "$HOST"
      printf '%s  genome@%s  ::  [done] genome: cvtest/stale-key — finished\n'      "$(date -u -d '-5 min' +%FT%TZ)" "$HOST"
      printf '%s  genome@%s  ::  [done] genome: cvtest/expired-key — finished\n'    "$(date -u -d '-5 min' +%FT%TZ)" "$HOST"
    } > "$_cv_d/.mesh/chat.log"
    _cv_ob="$BOARD"; _cv_os="$SEEN"; BOARD="$_cv_d/.mesh/chat.log"; SEEN="$_cv_d/seen"
    PATH="$_cv_d/.local/bin:$PATH" verify_pass 0 >/dev/null 2>&1
    BOARD="$_cv_ob"; SEEN="$_cv_os"
    grep -qx 'cvtest/stale-key' "$_cv_d/released" 2>/dev/null \
      || f="$f stale-with-evidence-not-released (the reflex's whole original job)"
    grep -qx 'cvtest/expired-key' "$_cv_d/released" 2>/dev/null \
      && f="$f EXPIRED-claim-auto-released (its owner is mid-turn; the fuzzy evidence matcher must never reach it)"
    grep -q 'EXPIRED' "$_cv_d/nudged" 2>/dev/null \
      || f="$f expired-owner-not-poked-with-the-renew-remedy (the second word needs its own actuator, not just its own name)"
    grep -q 'is STALE' "$_cv_d/nudged" 2>/dev/null \
      && f="$f expired-owner-told-its-claim-is-stale (telling a mind mid-turn its work was abandoned is the same misreading, addressed to the owner)"
    rm -rf "$_cv_d"

    # --- THE THIRD WORD + THE GIVEUP ({#4cdb7881}) -------------------------------------------------
    # Live case: hh-browser, owner job@mesh-home, EXPIRED 360m -> 450m, 38 nudges, owner behind a quota
    # wall the whole time. Two independent defects: the owner's word (mesh-claim's side) and the
    # absence of any stop condition here. Both are driven below over a fresh sandbox.
    _cv_d2="$(mktemp -d)"; mkdir -p "$_cv_d2/.local/bin" "$_cv_d2/.mesh"
    cat > "$_cv_d2/.local/bin/mesh-claim" <<CVSTUB2
#!/bin/sh
case "\$1" in
  --list-stale)          printf 'cvtest/nudge-key\towner=genome@$HOST\tSTALE\n' ;;
  --list-expired)        : ;;
  --list-held-incapable) printf 'cvtest/shed-key\towner=job@$HOST\tHELD-INCAPABLE\n' ;;
  --done)                printf '%s\n' "\$2" >> "$_cv_d2/released" ;;
esac
exit 0
CVSTUB2
    printf '#!/bin/sh\ncat >> "%s/nudged"\nprintf "WIN=%%s\\n" "$1" >> "%s/nudged"\nexit 0\n' "$_cv_d2" "$_cv_d2" > "$_cv_d2/.local/bin/mesh-nudge"
    printf '#!/bin/sh\nprintf "%%s\\n" "$1" >> "%s/posted"\nexit 0\n' "$_cv_d2" > "$_cv_d2/.local/bin/mesh-chat"
    chmod +x "$_cv_d2/.local/bin/mesh-claim" "$_cv_d2/.local/bin/mesh-nudge" "$_cv_d2/.local/bin/mesh-chat"
    _cv_ts2="$(date -u -d '-450 min' +%FT%TZ)"
    {
      printf '%s  genome@%s  ::  [claim] cvtest/nudge-key ttl=60 drive the browser\n' "$_cv_ts2" "$HOST"
      printf '%s  job@%s  ::  [claim] cvtest/shed-key ttl=60 drive the browser\n'     "$_cv_ts2" "$HOST"
    } > "$_cv_d2/.mesh/chat.log"
    _cv_ob2="$BOARD"; _cv_os2="$SEEN"; _cv_ocd="$NUDGE_CD"
    BOARD="$_cv_d2/.mesh/chat.log"; SEEN="$_cv_d2/seen"; NUDGE_CD=0   # cooldown out of the way: the GIVEUP is under test, not the spacing
    : > "$SEEN"
    # NUDGE_GIVEUP+2 passes. Without a giveup this is NUDGE_GIVEUP+2 nudges — the forever loop.
    _cv_p=0; while [ "$_cv_p" -lt $(( NUDGE_GIVEUP + 2 )) ]; do
      PATH="$_cv_d2/.local/bin:$PATH" verify_pass 0 >/dev/null 2>&1; _cv_p=$(( _cv_p + 1 ))
    done
    _cv_nudges="$(grep -c 'WIN=' "$_cv_d2/nudged" 2>/dev/null || echo 0)"
    [ "$_cv_nudges" = "$NUDGE_GIVEUP" ] \
      || f="$f nudge-giveup-not-enforced (a cooldown spaces nudges out, it never STOPS them — $(( NUDGE_GIVEUP + 2 )) passes produced $_cv_nudges nudges, want exactly $NUDGE_GIVEUP; this is the 38-nudge hh-browser loop)"
    [ "$(grep -c 'GIVEUP on \[claim\] cvtest/nudge-key' "$_cv_d2/posted" 2>/dev/null || echo 0)" = 1 ] \
      || f="$f nudge-giveup-not-escalated-exactly-once (the forever loop must become ONE loud line — a silent stop is just a quieter forever loop, and a repeated one is the flood again)"
    # THE SHED CLAIM: neither released nor nudged, and NOT silent.
    grep -qx 'cvtest/shed-key' "$_cv_d2/released" 2>/dev/null \
      && f="$f held-incapable-released (its owner is behind a quota wall, not gone — releasing it hands a second writer live work)"
    grep -q 'cvtest/shed-key' "$_cv_d2/nudged" 2>/dev/null \
      && f="$f held-incapable-nudged (a shed mind cannot read a nudge — this is the no-op loop the giveup exists to end, entered from the other side)"
    _cv_surf="$(PATH="$_cv_d2/.local/bin:$PATH" verify_pass 1 2>/dev/null)"
    case "$_cv_surf" in *cvtest/shed-key*HELD-INCAPABLE*) : ;; *) f="$f held-incapable-invisible (not acted on must not mean unreported: [$_cv_surf])" ;; esac
    case "$_cv_surf" in *RATE-LIMITED*) : ;; *) f="$f held-incapable-reason-unnamed (a skipped line with no reason reads as an omission)" ;; esac
    # a RE-CLAIM starts the streak clean — the giveup is a property of one claim generation, never of
    # the key forever, or a key that legitimately cycles inherits a giveup from a claim long closed.
    printf '%s  genome@%s  ::  [claim] cvtest/nudge-key ttl=60 drive the browser again\n' \
      "$(date -u -d '-10 min' +%FT%TZ)" "$HOST" >> "$_cv_d2/.mesh/chat.log"
    PATH="$_cv_d2/.local/bin:$PATH" verify_pass 0 >/dev/null 2>&1
    [ "$(grep -c 'WIN=' "$_cv_d2/nudged" 2>/dev/null || echo 0)" = "$(( NUDGE_GIVEUP + 1 ))" ] \
      || f="$f giveup-outlives-the-claim-generation (a re-claimed key must be nudgeable again)"
    BOARD="$_cv_ob2"; SEEN="$_cv_os2"; NUDGE_CD="$_cv_ocd"
    rm -rf "$_cv_d2"

    if [ -n "$f" ]; then echo "smoke-test: FAIL ($f )"; exit 1; fi
    echo "smoke-test: ok (key_parts drops <=3-char tokens, evidence_match: exact-key + all-parts-AND, partial-token does NOT false-release, local_window resolves local/strips-tag/rejects-remote, deps present, + TWO WORDS TWO REMEDIES {#b2d997b4}: one driven pass over a board holding a STALE and an EXPIRED claim BOTH carrying [done]-shaped evidence — the stale one is released, the expired one is NEVER released, its owner is poked with the RENEW remedy, and is never told its live work is stale, + THE THIRD WORD AND THE GIVEUP {#4cdb7881}: NUDGE_GIVEUP+2 passes produce exactly NUDGE_GIVEUP nudges and ONE escalation post (a cooldown spaces nudges out, it never stops them — hh-browser took 38), the streak is a property of one claim generation so a re-claim is nudgeable again, and a HELD-INCAPABLE claim is neither released nor nudged yet still SURFACED with its reason named) and is never told its live work is stale)"; exit 0 ;;
  --once)  verify_pass 0 ;;
  --dry)   verify_pass 1 ;;
  --watch) watch_display ;;
  *) echo "usage: mesh-claim-verify [--once|--dry|--watch|--test]" >&2; exit 64 ;;
esac
