#!/usr/bin/env bash
# Render an ephemeral Top Pain. The caller's enrolled roster binds channel to role.
set -euo pipefail
case "${1:-}" in
  synthetic)
    state="${MESH_MISHE_SYNTHETIC_FILE:-${MESH_MISHE_HOME:-$HOME/.mesh/mishe-tauftauf}/synthetic.state}"
    if [ -f "$state" ]; then cat -- "$state"
    else printf 'STATE: UNKNOWN\n'; fi
    ;;
  cleaner|adint|discover|genome|haunt|health|hire|job|minds|pub|senses|sound|tg|tg-roz|vpn|wake|witness)
    channel="$1"
    role="${2:-$channel}"
    case "$role" in
      adint|cleaner|discover|genome|haunt|hire|job|minds|pub|senses|sound|tg|tg-roz|vpn|wake|witness) [ "$role" = "$channel" ] || exit 2 ;;
      check) [ "$channel" = health ] || exit 2 ;;
      *) exit 2 ;;
    esac
    if [ "${MESH_MISHE_RENDER_SOURCE:-dash}" = pane ]; then
      session="${MESH_MISHE_SESSION:-$(hostname)}"
      target="$session:$channel.0"
      metadata="$(tmux display-message -t "$target" -p '#{window_name}|#{pane_index}|#{pane_dead}|#{pane_start_command}' 2>/dev/null)" || metadata=""
      case "$metadata" in
        "$channel|0|0|\"exec "*"/mesh-dash $role\"") : ;;
        *) printf 'MISHE-STATE: UNKNOWN\nMISHE-SOURCE: unavailable\n'; exit 0 ;;
      esac
      valid=0
      for attempt in 1 2 3; do
        captured="$(tmux capture-pane -p -t "$target" 2>/dev/null)" || captured=""
        if printf '%s\n' "$captured" | python3 -c '
import datetime, re, sys
lines = sys.stdin.read().rstrip().splitlines()
if not lines: sys.exit(1)
match = re.fullmatch(r"-- pane live (\d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ) · \d+s · ticks every frame(?: · c=.*)? --", lines[-1])
if not match: sys.exit(1)
try: stamp = datetime.datetime.fromisoformat(match.group(1).replace("Z", "+00:00"))
except ValueError: sys.exit(1)
age = (datetime.datetime.now(datetime.timezone.utc) - stamp).total_seconds()
sys.exit(0 if -5 <= age <= 180 else 1)
'; then
          valid=1
          break
        fi
        [ "$attempt" -eq 3 ] || sleep 0.15
      done
      if [ "$valid" -ne 1 ]; then
        printf 'MISHE-STATE: UNKNOWN\nMISHE-SOURCE: unavailable\n'
        exit 0
      fi
      python3 - "$channel" "${MESH_MISHE_HOME:-$HOME/.mesh/mishe-tauftauf}" <<'PY'
import os
from pathlib import Path
import sys
import time
channel, home = sys.argv[1], Path(sys.argv[2])
if home.is_dir():
    target = home / f'.mesh-mishe-seen-{channel}'
    temp = target.with_name(target.name + f'.{os.getpid()}.tmp')
    with open(temp, 'w', encoding='ascii') as stream:
        stream.write(str(time.time_ns()) + '\n')
        stream.flush()
        os.fsync(stream.fileno())
    os.replace(temp, target)
PY
      printf 'MISHE-STATE: UNKNOWN\nMISHE-SOURCE: top-pane\n%s\n' "$captured"
    else
      if [ "$channel" != cleaner ]; then printf 'MISHE-STATE: UNKNOWN\nMISHE-SOURCE: dashboard\n'; fi
      "${MESH_REPO:-$HOME/lte-workstation}/scripts/mesh-dash" --once "$role" 2>/dev/null
    fi
    if [ "$channel" != cleaner ]; then exit 0; fi
    python3 - "${MESH_MISHE_CHAT_LOG:-$HOME/.mesh/chat.log}" <<'PY'
import re
import sys
from collections import deque

last = 0
state_by_chain = {}
events = deque(maxlen=16)
event_count = 0
invalid_status = False
try:
    with open(sys.argv[1], encoding="utf-8") as stream:
        for index, line in enumerate(stream, 1):
            if "[task-ledger]" not in line:
                continue
            current = re.search(r"/current=i:(\d+)", line)
            chain = re.search(r"/chain=s:([^\s|]+)", line)
            if not current or not chain:
                continue
            owner = f"/steps/{current.group(1)}/owner=s:cleaner"
            if owner not in line:
                state_by_chain.pop(chain.group(1), None)
                continue
            status = re.search(r"(?:^| \| )/status=s:([^\s|]+)", line)
            step_status = re.search(rf"/steps/{current.group(1)}/status=s:([^\s|]+)", line)
            if status is None or status.group(1) not in {"open", "active", "complete", "rejected", "blocked"}:
                invalid_status = True
            else:
                events.append(f"{index}:{status.group(1)}")
            event_count += 1
            state_by_chain[chain.group(1)] = (
                status is not None and status.group(1) in {"open", "active"}
                and step_status is not None and step_status.group(1) in {"open", "queued"}
            )
            last = index
except (OSError, UnicodeError):
    print("TASK: UNKNOWN")
    print("TASK-EPOCH: UNKNOWN")
    print("TASK-EVENT-COUNT: UNKNOWN")
    print("TASK-EVENTS: UNKNOWN")
else:
    if invalid_status:
        print("TASK: UNKNOWN")
        print("TASK-EPOCH: UNKNOWN")
        print("TASK-EVENT-COUNT: UNKNOWN")
        print("TASK-EVENTS: UNKNOWN")
    else:
        print("TASK: PRESENT" if any(state_by_chain.values()) else "TASK: NONE")
        print(f"TASK-EPOCH: {last}")
        print(f"TASK-EVENT-COUNT: {event_count}")
        print("TASK-EVENTS: " + (",".join(events) if events else "NONE"))
PY
    ;;
  *) printf 'mesh-mishe-render: channel not enrolled: %s\n' "${1:-}" >&2; exit 2 ;;
esac
