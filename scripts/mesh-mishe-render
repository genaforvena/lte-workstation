#!/usr/bin/env bash
# Render an ephemeral Top Pain. The caller's enrolled roster binds channel to role.
set -euo pipefail
case "${1:-}" in
  synthetic)
    state="${MESH_MISHE_SYNTHETIC_FILE:-${MESH_MISHE_HOME:-$HOME/.mesh/mishe-tauftauf}/synthetic.state}"
    if [ -f "$state" ]; then cat -- "$state"
    else printf 'STATE: UNKNOWN\n'; fi
    ;;
  cleaner|adint|discover|genome|haunt|health|hire|job|minds|pub|senses|sound|tg|tg-roz|vpn|wake|witness)
    channel="$1"
    role="${2:-$channel}"
    case "$role" in
      adint|cleaner|discover|genome|haunt|hire|job|minds|pub|senses|sound|tg|tg-roz|vpn|wake|witness) [ "$role" = "$channel" ] || exit 2 ;;
      check) [ "$channel" = health ] || exit 2 ;;
      *) exit 2 ;;
    esac
    if [ "${MESH_MISHE_RENDER_SOURCE:-dash}" = pane ]; then
      session="${MESH_MISHE_SESSION:-$(hostname)}"
      target="$session:$channel.0"
      metadata="$(tmux display-message -t "$target" -p '#{window_name}|#{pane_index}|#{pane_dead}|#{pane_start_command}' 2>/dev/null)" || metadata=""
      case "$metadata" in
        "$channel|0|0|\"exec "*"/mesh-dash $role\"") : ;;
        "cleaner|0|0|\"${MESH_REPO:-$HOME/lte-workstation}/scripts/mesh-mishe-cleaner-run watch\"") : ;;
        *) printf 'MISHE-STATE: UNKNOWN\nMISHE-SOURCE: unavailable\nMISHE-FRESHNESS: UNKNOWN\n'; exit 0 ;;
      esac
      freshness=UNKNOWN
      value_marker=""
      for attempt in 1 2 3; do
        captured="$(tmux capture-pane -p -J -t "$target" 2>/dev/null)" || captured=""
        if value_marker="$(printf '%s\n' "$captured" | python3 -c '
import datetime
import re
import os
from pathlib import Path
import stat
import sys
import subprocess
sys.path.insert(0, sys.argv[2])  # Import beside this script, not from fixture MESH_REPO.
from mesh_mishe_sources import SEMANTIC_SOURCES

channel = sys.argv[1]
lines = sys.stdin.read().rstrip().splitlines()
if not lines:
    sys.exit(1)
footer = re.fullmatch(
    r"-- pane live (\d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ) · \d+s · ticks every frame(?: · c=[^\n]{0,40})? --",
    lines[-1],
)
if not footer:
    footer = re.fullmatch(
        r"── pane live: as of (\d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ) · refresh \d+s · this line ticks every frame — frozen = dead render loop ──",
        lines[-1],
    )
if not footer and channel == "cleaner":
    footer = re.fullmatch(
        r"-- pane live (\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d(?:\.\d{1,6})?Z) · refresh 5s · ticks every frame --",
        lines[-1],
    )
if not footer:
    sys.exit(1)
try:
    stamp = datetime.datetime.fromisoformat(footer.group(1).replace("Z", "+00:00"))
except ValueError:
    sys.exit(1)
now = datetime.datetime.now(datetime.timezone.utc)
age = (now - stamp).total_seconds()
if age > 180:
    sys.exit(3)  # A valid, expired renderer lease: sustained loss of repaint.
if age < -5:
    sys.exit(1)

# Trusted field contract: dashboard witness emits, immediately after its fixed
# "WITNESS TASKS" heading and before private rows,
# materialized view: ... · source age=<s>s · authority=explicit task-state events · mtime=<epoch> · MISHE-VALUE: journal <FRESH|STALE|UNKNOWN> <ISO-time|UNKNOWN>
# This is the SOURCE update time, not the repaint time. Extend with a separate
# allowlisted source header/TTL per channel; never infer freshness from pane prose.
valid_journal = False
if channel == "witness":
    boundaries = [index for index, line in enumerate(lines) if line.startswith("chat.log: showing ")]
    trusted_end = boundaries[0] if len(boundaries) == 1 else 0
    headings = [index for index, line in enumerate(lines[:trusted_end])
                if line.startswith("WITNESS TASKS — ")]
    if len(headings) == 1 and headings[0] + 2 < trusted_end:
        source = lines[headings[0] + 1]
        task = lines[headings[0] + 2]
        match = re.fullmatch(
            r"materialized view: [^\n]{1,512} · source age=(-?\d{1,12})s · "
            r"authority=explicit task-state events · mtime=(-?\d{1,12}) · "
            r"MISHE-VALUE: journal (FRESH|STALE|UNKNOWN) "
            r"(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ|UNKNOWN)", source,
        )
        if match and task.startswith("tasks: "):
            if match.group(3) == "UNKNOWN" and match.group(4) == "UNKNOWN":
                print("MISHE-VALUE: journal UNKNOWN")
            elif match.group(3) != "UNKNOWN" and match.group(4) != "UNKNOWN":
                try:
                    source_time = datetime.datetime.fromisoformat(match.group(4).replace("Z", "+00:00"))
                    source_epoch = int(match.group(2))
                    source_age = (now - source_time).total_seconds()
                    pane_age = (stamp - source_time).total_seconds()
                    if (abs(source_time.timestamp() - source_epoch) <= 1
                        and abs(pane_age - int(match.group(1))) <= 5
                        and -5 <= pane_age
                        and -5 <= source_age
                        and ((match.group(3) == "FRESH" and pane_age <= 660)
                             or (match.group(3) == "STALE" and pane_age > 660))):
                        print("MISHE-VALUE: journal " + ("STALE" if source_age > 660 else "FRESH"))
                        valid_journal = source_age <= 660
                except (ValueError, OverflowError):
                    pass
    if valid_journal and len(headings) == 1 and headings[0] + 4 < trusted_end:
        if lines[headings[0] + 3].startswith("next-up: "):
            issues = re.match(
                r"mishe: (0|[1-9]\d{0,5}) unfinished · id=([0-9a-f]{16}|UNKNOWN) · next=",
                lines[headings[0] + 4],
            )
            if issues:
                if issues.group(2) == "UNKNOWN":
                    print("MISHE-ISSUES: UNKNOWN")
                else:
                    print(f"MISHE-ISSUES: {issues.group(1)} {issues.group(2)}")
elif channel == "cleaner":
    # The cleaner pilot reads a matching scan and dry-run settlement; its
    # five-second pane repaint does not imply either producer has run.
    import importlib.machinery
    try:
        repo = Path(os.environ.get("MESH_REPO", str(Path.home() / "lte-workstation")))
        path = repo / "scripts/cleaner/mesh-cleaner-mishe"
        adapter = importlib.machinery.SourceFileLoader("mesh_cleaner_source", str(path)).load_module()
        adapter.snapshot()
        source_files = (adapter.MESH / "cleaner/latest.json",
                        adapter.MESH / "cleaner/settle-latest.json")
        ages = []
        for source_file in source_files:
            info = source_file.stat()
            if not stat.S_ISREG(info.st_mode) or info.st_size == 0:
                raise ValueError("missing cleaner source")
            ages.append(now.timestamp() - info.st_mtime)
        if any(source_age < -5 for source_age in ages):
            raise ValueError("future cleaner source")
        fresh = max(ages) <= 1800
        print("MISHE-VALUE: cleaner " + ("FRESH" if fresh else "STALE"))
        if fresh:
            try:
                adapter.checked()
                print("MISHE-CLEANER: PASS")
            except (OSError, ValueError, KeyError, TypeError):
                print("MISHE-CLEANER: REVIEW_REQUIRED")
    except (OSError, ValueError, KeyError, TypeError):
        print("MISHE-VALUE: cleaner UNKNOWN")
else:
    # The pub pane delegates to mesh-pub-dash, whose external comments/status
    # cache refreshes every 300s. Other dashboard roles refresh their charter
    # goal cache every 60s. Neither timestamp is the renderer repaint lease.
    if channel == "pub":
        source = "comments"
        source_file = Path(os.environ.get("MESH_MISHE_PUB_CACHE",
                                          str(Path.home() / ".mesh/.pub-right.cache")))
        ttl = 900
    else:
        source = "goal"
        source_dir = Path(os.environ.get("MESH_MISHE_GOAL_DIR",
                                         os.environ.get("MESH_DIR", str(Path.home() / ".mesh"))))
        source_file = source_dir / f".goal-{channel}.cache"
        ttl = 300
    try:
        info = source_file.lstat()
        if not stat.S_ISREG(info.st_mode) or info.st_size == 0:
            raise ValueError("missing regular source cache")
        source_age = now.timestamp() - info.st_mtime
        # Other readers can refresh a shared cache between two pane frames;
        # cache freshness is independent of the older captured value text.
        if source_age < -5:
            raise ValueError("future source cache")
        print(f"MISHE-VALUE: {source} " + ("STALE" if source_age > ttl else "FRESH"))
    except (OSError, ValueError):
        print(f"MISHE-VALUE: {source} UNKNOWN")
    # Only mapped periodic successful producers are liveness clocks. Unmapped
    # histories cannot be pronounced stalled merely because no item arrived.
    if channel in SEMANTIC_SOURCES:
        name, filenames, limit = SEMANTIC_SOURCES[channel]
        directory = Path(os.environ.get("MESH_MISHE_SEMANTIC_DIR",
                                        os.environ.get("MESH_DIR", str(Path.home() / ".mesh"))))
        if channel == "minds":
            # The operator-stop sentinel deliberately makes --watch emit no
            # rows; the old wall is not evidence of a failed periodic probe.
            config = Path(os.environ.get("MESH_MISHE_RESTORE_ENV",
                                         str(Path.home() / ".mesh/restore.env")))
            try:
                assignments = [line.strip() for line in config.read_text().splitlines()
                               if line.startswith("export MESH_MIND_CHANNELS=")]
                stopped = bool(assignments and re.match(
                    r"^export MESH_MIND_CHANNELS=\"__operator_stopped__\"(?:\s+#.*)?$",
                    assignments[-1]))
            except OSError:
                stopped = False
        else:
            stopped = False
        if stopped:
            status = "SUSPENDED"
        elif channel == "tg-roz":
            # This event-driven consumer advances a line cursor only after the
            # private input has been dispatched. Quiet input is healthy; a
            # durable unconsumed suffix is not a repaint-age heuristic.
            try:
                source = directory / "tg-strangers.log"
                offset = directory / ".roz-channel.offset"
                source_info = source.lstat()
                offset_info = offset.lstat()
                if (not stat.S_ISREG(source_info.st_mode) or not stat.S_ISREG(offset_info.st_mode)
                    or source_info.st_mtime > now.timestamp() + 5
                    or offset_info.st_mtime > now.timestamp() + 5):
                    raise ValueError("invalid intake files")
                cursor_text = offset.read_text().strip()
                if not cursor_text.isdecimal() or len(cursor_text) > 15:
                    raise ValueError("invalid intake cursor")
                with source.open("rb") as stream:
                    count = sum(chunk.count(b"\n") for chunk in iter(lambda: stream.read(65536), b""))
                if (source.stat().st_mtime_ns != source_info.st_mtime_ns
                    or offset.stat().st_mtime_ns != offset_info.st_mtime_ns
                    or int(cursor_text) > count):
                    raise ValueError("intake changed during read")
                status = ("FRESH" if int(cursor_text) == count else
                          "STALE" if now.timestamp() - offset_info.st_mtime > 120 else "UNKNOWN")
            except (OSError, ValueError, UnicodeError):
                status = "UNKNOWN"
        elif channel in ("adint", "hire", "wake", "haunt"):
            # These lanes have no periodic business-run cadence. An overdue
            # canonical owner task is an actual unsettled obligation; no
            # overdue row does not prove all work in the lane is complete.
            command = os.environ.get(
                "MESH_MISHE_TASK_AUDIT_CMD",
                str(Path(os.environ.get("MESH_REPO", str(Path.home() / "lte-workstation")))
                    / "scripts/mesh-task"),
            )
            try:
                audit = subprocess.run([command, "audit"], capture_output=True,
                                       text=True, timeout=10)
                if audit.returncode or len(audit.stdout) > 4_000_000:
                    raise ValueError("task audit unavailable")
                overdue = re.compile(
                    rf"OVERDUE\t{re.escape(channel)}\t[A-Za-z0-9._/-]{{1,120}}\t"
                    r"lease=\d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ(?: independent_reason=[^\n]{1,160})?"
                )
                status = ("STALE" if any(overdue.fullmatch(row)
                                         for row in audit.stdout.splitlines()) else "UNKNOWN")
            except (OSError, subprocess.TimeoutExpired, ValueError):
                status = "UNKNOWN"
        elif not filenames:
            status = "UNKNOWN"  # No periodic producer: quiet is not a stalled source.
        else:
            try:
                ages = []
                for filename in filenames:
                    info = (directory / filename).lstat()
                    if not stat.S_ISREG(info.st_mode) or (info.st_size == 0 and filename != ".records-tick"):
                        raise ValueError("missing semantic producer")
                    ages.append(now.timestamp() - info.st_mtime)
                if any(age < -5 for age in ages):
                    raise ValueError("future semantic producer")
                status = "STALE" if max(ages) > limit else "FRESH"
            except (OSError, ValueError):
                status = "UNKNOWN"
        print(f"MISHE-SEMANTIC: {name} {status}")
sys.exit(0)
' "$channel" "$(dirname -- "${BASH_SOURCE[0]}")")"; then
          freshness=FRESH
          break
        else
          [ "$?" -eq 3 ] && freshness=STALE || freshness=UNKNOWN
        fi
        [ "$attempt" -eq 3 ] || sleep 0.15
      done
      if [ "$freshness" != FRESH ]; then
        printf 'MISHE-STATE: UNKNOWN\nMISHE-SOURCE: %s\nMISHE-FRESHNESS: %s\n' \
          "$([ "$freshness" = STALE ] && printf top-pane || printf unavailable)" "$freshness"
        exit 0
      fi
      python3 - "$channel" "${MESH_MISHE_HOME:-$HOME/.mesh/mishe-tauftauf}" <<'PY'
import os
from pathlib import Path
import sys
import time
channel, home = sys.argv[1], Path(sys.argv[2])
if home.is_dir():
    target = home / f'.mesh-mishe-seen-{channel}'
    temp = target.with_name(target.name + f'.{os.getpid()}.tmp')
    with open(temp, 'w', encoding='ascii') as stream:
        stream.write(str(time.time_ns()) + '\n')
        stream.flush()
        os.fsync(stream.fileno())
    os.replace(temp, target)
PY
      printf 'MISHE-STATE: UNKNOWN\nMISHE-SOURCE: top-pane\nMISHE-FRESHNESS: FRESH\n'
      [ -z "$value_marker" ] || printf '%s\n' "$value_marker"
      printf '%s\nMISHE-END-PANE\n' "$captured"
    else
      if [ "$channel" != cleaner ]; then printf 'MISHE-STATE: UNKNOWN\nMISHE-SOURCE: dashboard\n'; fi
      "${MESH_REPO:-$HOME/lte-workstation}/scripts/mesh-dash" --once "$role" 2>/dev/null
    fi
    if [ "$channel" != cleaner ]; then exit 0; fi
    python3 - "${MESH_MISHE_CHAT_LOG:-$HOME/.mesh/chat.log}" <<'PY'
import re
import sys
from collections import deque

last = 0
state_by_chain = {}
events = deque(maxlen=16)
event_count = 0
invalid_status = False
try:
    with open(sys.argv[1], encoding="utf-8") as stream:
        for index, line in enumerate(stream, 1):
            if "[task-ledger]" not in line:
                continue
            current = re.search(r"/current=i:(\d+)", line)
            chain = re.search(r"/chain=s:([^\s|]+)", line)
            if not current or not chain:
                continue
            owner = f"/steps/{current.group(1)}/owner=s:cleaner"
            if owner not in line:
                state_by_chain.pop(chain.group(1), None)
                continue
            status = re.search(r"(?:^| \| )/status=s:([^\s|]+)", line)
            step_status = re.search(rf"/steps/{current.group(1)}/status=s:([^\s|]+)", line)
            if status is None or status.group(1) not in {"open", "active", "complete", "rejected", "blocked"}:
                invalid_status = True
            else:
                events.append(f"{index}:{status.group(1)}")
            event_count += 1
            state_by_chain[chain.group(1)] = (
                status is not None and status.group(1) in {"open", "active"}
                and step_status is not None and step_status.group(1) in {"open", "queued"}
            )
            last = index
except (OSError, UnicodeError):
    print("TASK: UNKNOWN")
    print("TASK-EPOCH: UNKNOWN")
    print("TASK-EVENT-COUNT: UNKNOWN")
    print("TASK-EVENTS: UNKNOWN")
else:
    if invalid_status:
        print("TASK: UNKNOWN")
        print("TASK-EPOCH: UNKNOWN")
        print("TASK-EVENT-COUNT: UNKNOWN")
        print("TASK-EVENTS: UNKNOWN")
    else:
        print("TASK: PRESENT" if any(state_by_chain.values()) else "TASK: NONE")
        print(f"TASK-EPOCH: {last}")
        print(f"TASK-EVENT-COUNT: {event_count}")
        print("TASK-EVENTS: " + (",".join(events) if events else "NONE"))
PY
    ;;
  *) printf 'mesh-mishe-render: channel not enrolled: %s\n' "${1:-}" >&2; exit 2 ;;
esac
