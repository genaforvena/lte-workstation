#!/usr/bin/env bash
# Render a synthetic canary. Real channels remain disabled until shadow enrollment.
set -euo pipefail
case "${1:-}" in
  synthetic)
    state="${MESH_MISHE_SYNTHETIC_FILE:-${MESH_MISHE_HOME:-$HOME/.mesh/mishe-tauftauf}/synthetic.state}"
    if [ -f "$state" ]; then cat -- "$state"
    else printf 'STATE: UNKNOWN\n'; fi
    ;;
  cleaner)
    "${MESH_REPO:-$HOME/lte-workstation}/scripts/mesh-dash" --once cleaner
    if task_rows="$(timeout 5 "${MESH_MISHE_TASK_CLI:-$HOME/.local/bin/mesh-task}" queue --dispatch --owner cleaner 2>/dev/null)"; then
      if [ -n "$task_rows" ]; then printf 'TASK: PENDING\n'
      else printf 'TASK: NONE\n'; fi
    else
      printf 'TASK: UNKNOWN\n'
    fi
    task_epoch="$(python3 - "${MESH_MISHE_CHAT_LOG:-$HOME/.mesh/chat.log}" <<'PY'
import re
import sys

last = 0
try:
    with open(sys.argv[1], encoding="utf-8") as stream:
        for index, line in enumerate(stream, 1):
            if "[task-ledger]" not in line:
                continue
            current = re.search(r"/current=i:(\d+)", line)
            if current and f"/steps/{current.group(1)}/owner=s:cleaner" in line:
                last = index
except (OSError, UnicodeError):
    print("UNKNOWN")
else:
    print(last)
PY
)"
    printf 'TASK-EPOCH: %s\n' "$task_epoch"
    ;;
  *) printf 'mesh-mishe-render: channel not enrolled: %s\n' "${1:-}" >&2; exit 2 ;;
esac
