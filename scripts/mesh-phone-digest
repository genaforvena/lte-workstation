#!/usr/bin/env bash
# mesh-phone-digest — once-a-day plain-language summary of what the phone BODY sensed.
#
# Reads the collected roaming track (~/.mesh/phone-track.log, drained from the phone by
# mesh-phone-collect) and folds the last 24h of RAW rows into a short human summary: trips out
# (left-home episodes), time away, steps walked, distinct places (wifi fingerprints away), farthest
# distance from home, battery low point. Operator 2026-06-17 asked for a daily summary ("раз в сутки
# буду показывать сводкой"). RAW collection stays raw (mesh-phone-capture); THIS is the read-side
# digest — no conclusions baked into the data, just a daily readout.
#
# Sends a Russian VOICE note (+text) to the operator via mesh-voice-tx. SILENT if there's no recent
# data (no spam on a quiet/away day). --dry prints the summary without sending.
#
# reflex-cadence: 0 21 * * *
set -u
export PATH="$HOME/.local/bin:$PATH"
LOG="${MESH_PHONE_TRACK:-$HOME/.mesh/phone-track.log}"
HOME_LAT="${MESH_HOME_LAT:-56.3083}"; HOME_LON="${MESH_HOME_LON:-44.0305}"
NOW="$(date -u +%s)"

if [ "${1:-}" = --test ]; then
  command -v jq >/dev/null 2>&1 || { echo "smoke-test: FAIL (no jq)"; exit 1; }
  # Dry-run: feed synthetic NDJSON rows through the parser, validate the digest line
  _td="$(mktemp -d)"
  _t_home="$(date -u -d '2 hours ago' +%Y-%m-%dT%H:%M:%SZ)"
  _t_away="$(date -u -d '1 hour ago' +%Y-%m-%dT%H:%M:%SZ)"
  # Two rows: one home-light, one away-with-steps
  cat > "$_td/track.log" <<-EOF
	{"t":"$_t_home","event":null,"mode":"home","bat":"85","motion":{"steps":0},"wifi":{"top":[{"s":"home-AP"}]},"lat":null,"lon":null}
	{"t":"$_t_away","event":"left-home","mode":"away","bat":"72","motion":{"steps":1250},"wifi":{"top":[{"s":"away-cafe"}]},"lat":"56.310","lon":"44.025"}
	EOF
  _out="$(MESH_PHONE_TRACK="$_td/track.log" "${BASH_SOURCE[0]}" --dry 2>/dev/null)" || { echo "smoke-test: FAIL (dry-run errored)"; rm -rf "$_td"; exit 1; }
  printf '%s\n' "$_out" | grep -qE 'записей 2' || { echo "smoke-test: FAIL (dry-run expected 'записей 2', got: $_out)"; rm -rf "$_td"; exit 1; }
  printf '%s\n' "$_out" | grep -qE 'Выходов из дома' || { echo "smoke-test: FAIL (dry-run expected trip mention, got: $_out)"; rm -rf "$_td"; exit 1; }
  printf '%s\n' "$_out" | grep -qE 'Шагов' || { echo "smoke-test: FAIL (dry-run expected steps mention, got: $_out)"; rm -rf "$_td"; exit 1; }
  rm -rf "$_td"
  echo "smoke-test: ok"; exit 0
fi
[ "${1:-}" = --dry ] && DRY=1 || DRY=0

[ -s "$LOG" ] || { echo "no track log yet"; exit 0; }

# Fold the last 24h of rows into a compact stats object (jq does the date math + haversine).
stats=$(jq -rn --argjson now "$NOW" --argjson hlat "$HOME_LAT" --argjson hlon "$HOME_LON" '
  def hav($la;$lo): ($la-$hlat)*111.0 as $dy | ($lo-$hlon)*63.0 as $dx
                    | (($dy*$dy + $dx*$dx) | sqrt);            # rough km, fine for "how far"
  [ inputs ] as $all
  | [ $all[] | select((.t // "" | try fromdateiso8601 catch 0) >= ($now - 86400)) ] as $r
  | ($r | length) as $n
  | [ $r[] | select(.event=="left-home") ] as $trips
  | [ $r[] | select(.mode=="away") ] as $away
  | [ $r[] | .motion.steps // empty ] as $steps
  | [ $r[] | select(.lat != null) | hav((.lat|tonumber); (.lon|tonumber)) ] as $dists
  | [ $r[] | .wifi.top[0].s // empty | select(. != "") ] as $aps
  | [ $r[] | .bat // empty | select(. != "") | tonumber ] as $bats
  | { n: $n,
      trips: ($trips|length),
      away_n: ($away|length),
      steps: (if ($steps|length)>0 then (($steps|max) - ($steps|min)) else 0 end),
      maxkm: (if ($dists|length)>0 then (($dists|max) | if . < 0.05 then 0 else . end) else 0 end),
      places: ($aps|unique|length),
      batmin: (if ($bats|length)>0 then ($bats|min) else null end) }
  | "n=\(.n) trips=\(.trips) away=\(.away_n) steps=\(.steps) maxkm=\(.maxkm|.*10|round/10) places=\(.places) batmin=\(.batmin)"
' < "$LOG" 2>/dev/null)

# parse the flat stats line
eval "$(printf '%s' "$stats" | tr ' ' '\n' | sed -n 's/^\([a-z]*\)=\(.*\)$/\1=\2/p' | sed 's/^/D_/')"
N="${D_n:-0}"
[ "${N:-0}" -gt 0 ] 2>/dev/null || { echo "no rows in the last 24h — silent"; exit 0; }

# Build a Russian sentence from the numbers (raw readout, no inference)
msg="Сводка за день по телефону: записей ${D_n}."
if [ "${D_trips:-0}" -gt 0 ] 2>/dev/null; then
  msg="$msg Выходов из дома: ${D_trips}, записей в пути: ${D_away}."
else
  msg="$msg Из дома телефон не выходил."
fi
[ "${D_steps:-0}" -gt 0 ] 2>/dev/null && msg="$msg Шагов за день: примерно ${D_steps}."
if [ -n "${D_maxkm:-}" ] && [ "${D_maxkm#-}" != "0" ] && [ "${D_maxkm#-}" != "0.0" ] 2>/dev/null; then
  msg="$msg Дальше всего от дома — около ${D_maxkm} км."
fi
[ "${D_places:-0}" -gt 1 ] 2>/dev/null && msg="$msg Разных мест по wi-fi: ${D_places}."
[ -n "${D_batmin:-}" ] && [ "${D_batmin}" != null ] && msg="$msg Минимальный заряд: ${D_batmin}%."

if [ "$DRY" = 1 ]; then echo "$msg"; exit 0; fi
mesh-voice-tx "$msg" >/dev/null 2>&1 && echo "sent: $msg" || { echo "voice failed, fallback text"; mesh-tg "$msg" >/dev/null 2>&1; }
