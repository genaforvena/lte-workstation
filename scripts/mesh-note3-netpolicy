#!/usr/bin/env bash
# reflex-cadence: 11-59/5 * * * *
# doctor-artifact: $HOME/.mesh/.note3-netpolicy.state 1200 phone
# mesh-note3-netpolicy — Note 3 Android metered-policy context for mobile-link.
set -uo pipefail

SERIAL="${MESH_NOTE3_SERIAL:-4d00553d61ab90b7}"
MESH_DIR="${MESH_DIR:-${HOME:-/tmp}/.mesh}"
EVIDENCE_ROOT="${MESH_EVIDENCE_ROOT:-${HOME:-/tmp}/.mesh/evidence}/note3-netpolicy-20260920"
RAW="${EVIDENCE_ROOT}/netpolicy.raw"
STATE="${MESH_NOTE3_NETPOLICY_STATE:-$MESH_DIR/.note3-netpolicy.state}"
RUNLOG="${MESH_NOTE3_NETPOLICY_RUNLOG:-$MESH_DIR/note3-netpolicy.log}"

now_utc() { date -u +%Y-%m-%dT%H:%M:%SZ; }

parse_dump() {
  awk '
    /^Metered ifaces:/ {
      line=$0; sub(/^Metered ifaces: *\{/, "", line); sub(/\}.*$/, "", line)
      if (line != "") { iface=line; n=split(line, a, /, */); for (i=1; i<=n; i++) if (a[i] != "") ifaces++ }
    }
    /^  NetworkPolicy\[/ {
      if ($0 ~ /cycleDay=[0-9]+/ && $0 ~ /metered=(true|false)/ && $0 ~ /warningBytes=-?[0-9]+/ && $0 ~ /limitBytes=-?[0-9]+/) {
        rows++
        if ($0 ~ /metered=true/) metered++
        if (warning == "") { match($0, /warningBytes=-?[0-9]+/); warning=substr($0, RSTART+13, RLENGTH-13) }
        if (limit == "") { match($0, /limitBytes=-?[0-9]+/); limit=substr($0, RSTART+11, RLENGTH-11) }
      }
    }
    END { if (ifaces > 0 && rows > 0) printf "metered_ifaces=%s|iface_count=%d|policy_rows=%d|metered_policy_rows=%d|warning_bytes=%s|limit_bytes=%s\n", iface, ifaces, rows, metered, warning, limit }
  '
}

unknown() {
  local reason=${1:-unknown} ts=${2:-$(now_utc)}
  printf 'status=UNKNOWN reason=%s observed_at=%s metered_ifaces=unknown policy_rows=unknown warning_bytes=unknown limit_bytes=unknown\n' "$reason" "$ts"
  return 2
}

read_dump() {
  if [ -n "${MESH_NOTE3_NETPOLICY_RAW_OVERRIDE:-}" ]; then
    printf '%s\n' "$MESH_NOTE3_NETPOLICY_RAW_OVERRIDE"
  else
    timeout 20 adb -s "$SERIAL" shell dumpsys netpolicy 2>/dev/null | tr -d '\r'
  fi
}

probe() {
  local ts dump parsed
  ts="$(now_utc)"
  dump="$(read_dump)" || { unknown adb_unreachable "$ts"; return 2; }
  [ -n "$dump" ] || { unknown empty_capture "$ts"; return 2; }
  parsed="$(printf '%s\n' "$dump" | parse_dump)"
  [ -n "$parsed" ] || { unknown malformed_policy_dump "$ts"; return 2; }
  printf 'status=OK observed_at=%s %s\n' "$ts" "$parsed"
}

write_reading() {
  local reading="$1" tmp
  mkdir -p "$(dirname "$STATE")" "$(dirname "$RUNLOG")" "$EVIDENCE_ROOT" || return 1
  tmp="$(mktemp "${STATE}.XXXXXX")" || return 1
  printf '%s\n' "$reading" >"$tmp" && mv -f "$tmp" "$STATE" || { rm -f "$tmp"; return 1; }
  printf '%s %s\n' "$(now_utc)" "$reading" >>"$RUNLOG" || return 1
}

if [ "${1:-}" = --test ]; then
  fixture=$'Restrict background: false\nNetwork policies:\n  NetworkPolicy[NetworkTemplate: matchRule=MOBILE_ALL]: cycleDay=15, warningBytes=2147483648, limitBytes=-1, metered=true\nMetered ifaces: {rmnet0}'
  expected="$(printf '%s\n' "$fixture" | parse_dump)"
  printf '%s\n' "$expected" | grep -q 'metered_ifaces=rmnet0' || { echo 'smoke-test: FAIL (fixture interface parse)'; exit 1; }
  printf '%s\n' "$expected" | grep -q 'policy_rows=1' || { echo 'smoke-test: FAIL (fixture policy parse)'; exit 1; }
  printf '%s\n' "$expected" | grep -q 'warning_bytes=2147483648' || { echo 'smoke-test: FAIL (fixture warning parse)'; exit 1; }
  printf '%s\n' "$expected" | grep -q 'limit_bytes=-1' || { echo 'smoke-test: FAIL (fixture limit parse)'; exit 1; }
  malformed=$'Metered ifaces: {rmnet0}\nNetwork policies:\n  NetworkPolicy[broken]'
  [ -z "$(printf '%s\n' "$malformed" | parse_dump)" ] || { echo 'smoke-test: FAIL (malformed dump accepted)'; exit 1; }
  out="$(probe)"; rc=$?
  case "$rc" in
    0) echo "smoke-test: ok (fixture + LIVE ADB read: $out)"; exit 0 ;;
    2) echo "smoke-test: n/a (fixture parse passed; LIVE ADB unavailable: $out)"; exit 2 ;;
    *) echo "smoke-test: FAIL (live read rc=$rc: $out)"; exit 1 ;;
  esac
fi

reading="$(probe)"; rc=$?
if [ -n "${MESH_NOTE3_NETPOLICY_RAW_OVERRIDE:-}" ]; then
  mkdir -p "$EVIDENCE_ROOT" && printf '%s\n' "$MESH_NOTE3_NETPOLICY_RAW_OVERRIDE" >"$RAW"
elif [ "$rc" -eq 0 ]; then
  mkdir -p "$EVIDENCE_ROOT"
  read_dump >"$RAW" || true
fi
write_reading "$reading" || { echo 'mesh-note3-netpolicy: failed to write state/log' >&2; exit 1; }
printf '%s\n' "$reading"
exit "$rc"
