#!/usr/bin/env bash
# mesh-pane-watch — the PANE-LIVENESS watchdog (operator 2026-06-21, liveness-lease PART 3, mechanism 4).
#
# The render-layer lease completed: a data pane whose --watch render loop DIED sits FROZEN on its last
# frame and CANNOT self-report (it's not running to print UNKNOWN). Nothing watched this before:
# mesh-card-watchdog watches the card, mesh-reflex-health watches artifact freshness — neither watches
# the PANES. This is that watchdog.
#
# Mechanism: a LIVE data pane advances every frame (its header clock / fresh_stamp / refreshing data),
# so its captured content changes between cycles; a DEAD loop repeats byte-for-byte. So: capture each
# 2-pane channel window's DATA pane (.0), hash it, and flag a pane whose hash is IDENTICAL across N
# consecutive cycles (debounced — a momentarily-static frame doesn't trip it) as FROZEN → post once to
# the board for the health mind. Recovery (hash advances again) clears it. Default on any failure =
# say so (UNKNOWN/unwatchable), never a false all-clear.
#
#   mesh-pane-watch            one cycle: check every data pane, flag frozen (edge-triggered)
#   mesh-pane-watch --status   per-pane state, no posting
#   mesh-pane-watch --test     smoke (pure verdict-fn asserts; no tmux needed)
#
# reflex-cadence: */5 * * * *
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
SESS="$(hostname)"
MESH="$HOME/.mesh"; STATEDIR="$MESH/pane-watch"; mkdir -p "$STATEDIR"
CYCLES="${MESH_PANEWATCH_CYCLES:-2}"   # N consecutive identical captures (cycles are reflex-cadence apart) → FROZEN
ts(){ date -u +%FT%TZ; }

# PURE decision (dry-runnable — the reason this tool can be tested without a live tmux):
#   pane_step <prevhash> <curhash> <prevcount> <flagged> <cycles> -> "<newcount> <newflagged> <verdict>"
#   verdict: ok (advancing) | watch (identical, below threshold) | frozen (just crossed) |
#            still-frozen (already flagged) | recovered (advancing after a flag)
pane_step(){
  local ph="$1" ch="$2" pc="$3" fl="$4" cyc="$5" nc v
  if [ "$ch" != "$ph" ]; then
    nc=0
    if [ "$fl" = 1 ]; then v=recovered; fl=0; else v=ok; fi
  else
    nc=$((pc+1))
    if [ "$fl" = 1 ]; then v=still-frozen
    elif [ "$nc" -ge "$cyc" ]; then v=frozen; fl=1
    else v=watch; fi
  fi
  echo "$nc $fl $v"
}

# cause_hint <win> — point the frozen alert at the LIKELY cause, not just the symptom. The common
# stall is a dedicated mesh-<role>-dash whose render loop runs inline `curl`/`ssh`/`wget` every frame:
# on a slow net those block the visible frame long enough to read as FROZEN, then RECOVER when they
# return — the hourly pub flap, root-caused 2026-06-25 (dea4e16, fixed via a bg-refreshed cache).
# Only fire when CONFIDENT: a dedicated per-role dash (whole file IS that render) with inline net calls.
# The generic mesh-dash multiplexes every role's section, so counting its curls would over-attribute —
# skip the hint there rather than emit a false cause.
#
# chat-review/panewatch-cause-hint-stale-diagnosis (2026-07-05): this kept blaming a dash for the
# dea4e16 bug LONG after it was fixed there, for two reasons — (1) the curl/wget/scp/ssh count
# scanned the WHOLE file including comment lines (a postmortem comment describing the old bug, or a
# doc-comment inside the now-backgrounded blocking function, both mention "curl" in prose) and (2) it
# never checked whether the matched calls were already wrapped in the cache+bg-refresh idiom the fix
# itself introduces. Both are fixed below: strip comments before counting, and skip the hint entirely
# when the dash already shows that idiom (a backgrounded subshell `... ) &` alongside an atomic
# tmp-then-mv cache write, e.g. mesh-pub-dash's `( right_block >"$RCACHE.tmp" ... ) &` + `mv
# "$RCACHE.tmp" "$RCACHE"` — the render loop calls the CACHED wrapper, never the blocking one, so a
# real inline curl surviving inside the backgrounded half is no longer "per frame" and no longer a
# cause of a frozen render).
PANEWATCH_DASH_DIR="${PANEWATCH_DASH_DIR:-$HOME/.local/bin}"
cause_hint(){
  local win="$1" dash n code                  # NB: separate line for dash — ${win} isn't set yet
  dash="$PANEWATCH_DASH_DIR/mesh-${win}-dash"  # within the same `local` (bash expands RHS first)
  [ -x "$dash" ] || return 0
  grep -qE 'while *:.*do|--watch|sleep "\$' "$dash" 2>/dev/null || return 0   # has a render loop
  # already fixed: an atomic mv-refreshed cache written from a backgrounded subshell means the
  # render loop no longer blocks on the network call inside it — don't keep blaming a bug it doesn't
  # have (this predates counting anything: a fixed dash gets no hint regardless of curl count).
  grep -qE '\)[[:space:]]*&[[:space:]]*$' "$dash" 2>/dev/null && grep -qE 'mv .*\.tmp' "$dash" 2>/dev/null && return 0
  # count curl/wget/scp/ssh occurrences in CODE only — a full-line comment or a trailing inline
  # comment mentioning "curl" (a postmortem note, a doc-comment) must not inflate the count.
  code=$(grep -vE '^[[:space:]]*#' "$dash" 2>/dev/null | sed 's/#.*$//')
  n=$(printf '%s\n' "$code" | grep -cE '(^|[^-])\b(curl|wget|scp)\b| ssh ')
  [ "${n:-0}" -gt 0 ] || return 0
  printf ' likely cause: %s runs %s inline network call(s) per frame (blocks render on slow net); cache them bg-refreshed (cf. mesh-pub-dash right_cached, dea4e16).' "mesh-${win}-dash" "$n"
}

if [ "${1:-}" = --test ]; then
  fail=0
  # advancing → ok, count resets
  [ "$(pane_step A B 5 0 2)" = "0 0 ok" ]            || { echo "FAIL advancing→ok"; fail=1; }
  # identical, first time, threshold 2 → watch (not yet frozen)
  [ "$(pane_step A A 0 0 2)" = "1 0 watch" ]         || { echo "FAIL identical→watch"; fail=1; }
  # identical, reaches threshold → frozen + flagged
  [ "$(pane_step A A 1 0 2)" = "2 1 frozen" ]        || { echo "FAIL threshold→frozen"; fail=1; }
  # identical while already flagged → still-frozen (no re-post)
  [ "$(pane_step A A 2 1 2)" = "3 1 still-frozen" ]  || { echo "FAIL flagged→still-frozen"; fail=1; }
  # advancing after a flag → recovered, clears flag
  [ "$(pane_step A B 3 1 2)" = "0 0 recovered" ]     || { echo "FAIL recovered"; fail=1; }
  command -v tmux >/dev/null 2>&1 || { echo "smoke-test: FAIL (no tmux)"; exit 1; }
  command -v cksum >/dev/null 2>&1 || { echo "smoke-test: FAIL (no cksum)"; exit 1; }
  # ---- cause_hint (chat-review/panewatch-cause-hint-stale-diagnosis), fully sandboxed ---------------
  cht="$(mktemp -d)"; mkdir -p "$cht/bin"
  # a dash with a REAL inline curl in its render loop, no cache/bg-refresh → hint SHOULD fire
  cat > "$cht/bin/mesh-broken-dash" <<'EOF'
#!/bin/sh
while :; do
  curl -s --max-time 8 http://example.invalid >/dev/null
  sleep 5
done
EOF
  chmod +x "$cht/bin/mesh-broken-dash"
  h="$(PANEWATCH_DASH_DIR="$cht/bin" HOME="$cht" cause_hint broken)"
  printf '%s' "$h" | grep -q 'likely cause' || { echo "FAIL cause_hint: real blocking curl should fire"; fail=1; }
  # same dash, but the curl only appears inside a comment describing a past bug → must NOT fire
  cat > "$cht/bin/mesh-commented-dash" <<'EOF'
#!/bin/sh
# this dash used to run curl inline every frame (fixed long ago, see the postmortem)
while :; do
  echo static
  sleep 5
done
EOF
  chmod +x "$cht/bin/mesh-commented-dash"
  h="$(PANEWATCH_DASH_DIR="$cht/bin" HOME="$cht" cause_hint commented)"
  [ -z "$h" ] || { echo "FAIL cause_hint: comment-only curl mention must not fire ($h)"; fail=1; }
  # same real curl, but wrapped in the atomic mv-refreshed background-cache idiom → must NOT fire
  cat > "$cht/bin/mesh-fixed-dash" <<'EOF'
#!/bin/sh
right_block() { curl -s --max-time 8 http://example.invalid; }
right_cached() {
  ( right_block >"$CACHE.tmp" 2>/dev/null && mv "$CACHE.tmp" "$CACHE" ) &
}
while :; do
  right_cached
  sleep 5
done
EOF
  chmod +x "$cht/bin/mesh-fixed-dash"
  h="$(PANEWATCH_DASH_DIR="$cht/bin" HOME="$cht" cause_hint fixed)"
  [ -z "$h" ] || { echo "FAIL cause_hint: bg-refreshed cache idiom must suppress the hint ($h)"; fail=1; }
  # regression: the REAL, currently-deployed mesh-pub-dash source (the dea4e16 fix itself) must not
  # trigger the hint — this is the exact false-positive that was firing live on 2026-07-04/05.
  if [ -x "$HOME/.local/bin/mesh-pub-dash" ]; then
    h="$(cause_hint pub)"
    [ -z "$h" ] || { echo "FAIL cause_hint: mesh-pub-dash (already fixed by dea4e16) still triggers: $h"; fail=1; }
  else
    echo "  (skip: mesh-pub-dash not installed on this node — regression check needs the deployed file)"
  fi
  rm -rf "$cht"
  [ "$fail" = 0 ] && echo "smoke-test: ok (pane_step frozen/recover state machine verified; cause_hint fires on a real blocking curl, stays silent on a comment-only mention and on the bg-refreshed cache idiom, and does not misdiagnose the real fixed mesh-pub-dash)" && exit 0
  echo "smoke-test: FAIL"; exit 1
fi

STATUS=0; [ "${1:-}" = --status ] && STATUS=1
tmux has-session -t "$SESS" 2>/dev/null || { echo "mesh-pane-watch: no session '$SESS' — nothing to watch"; exit 0; }

post(){ command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="pane-watch@$SESS" mesh-chat "$1" >/dev/null 2>&1; }

# Watch the DATA pane (.0) of each 2-pane channel window (top=data, bottom=mind convention). A
# single-pane window is a shell/mind, not a data pane — skip it (no false 'frozen' on an idle shell).
checked=0; frozen_now=""
while read -r win; do
  [ -n "$win" ] || continue
  np=$(tmux list-panes -t "$SESS:$win" 2>/dev/null | grep -c .)
  [ "${np:-0}" -ge 2 ] || continue                       # only 2-pane channels carry a data pane
  cap=$(tmux capture-pane -p -t "$SESS:$win.0" 2>/dev/null) || continue
  curhash=$(printf '%s' "$cap" | cksum | awk '{print $1}')
  sf="$STATEDIR/$win.state"
  read -r ph pc fl _ < <(cat "$sf" 2>/dev/null); ph="${ph:-}"; pc="${pc:-0}"; fl="${fl:-0}"
  case "$pc$fl" in *[!0-9]*) pc=0; fl=0;; esac
  if [ -z "$ph" ]; then                                  # first sight: record, can't compare yet
    [ "$STATUS" = 1 ] || echo "$curhash 0 0 $(ts)" > "$sf"  # --status is READ-ONLY: never mutate state
    [ "$STATUS" = 1 ] && echo "  NEW    $win (first capture — baseline recorded)"
    checked=$((checked+1)); continue
  fi
  read -r nc nf verdict < <(pane_step "$ph" "$curhash" "$pc" "$fl" "$CYCLES")
  # --status is a READ-ONLY inspector: do NOT persist (a manual check during a freeze→recover would
  # otherwise CONSUME the transition so the cron run never posts [pane-recovered], and back-to-back
  # checks <1 frame apart record a spurious identical-count). Only the cron path advances the state.
  [ "$STATUS" = 1 ] || echo "$curhash $nc $nf $(ts)" > "$sf"
  checked=$((checked+1))
  if [ "$STATUS" = 1 ]; then
    printf '  %-7s %-13s identical=%s flagged=%s\n' "$win" "$verdict" "$nc" "$nf"
    continue
  fi
  case "$verdict" in
    frozen)    frozen_now="$frozen_now $win"
               post "[pane-frozen] $SESS:$win data pane FROZEN — render loop dead (capture unchanged ${nc}× cycles); pane shows a stale last frame it cannot self-report. health-mind: respawn it (tmux respawn-pane -k -t $SESS:$win.0).$(cause_hint "$win")" ;;
    recovered) post "[pane-recovered] $SESS:$win data pane advancing again — render loop alive" ;;
  esac
done < <(tmux list-windows -t "$SESS" -F '#{window_name}' 2>/dev/null)

[ "$STATUS" = 1 ] || echo "$(ts) pane-watch: $checked data pane(s) checked${frozen_now:+ — FROZEN:$frozen_now}"
exit 0
