#!/usr/bin/env bash
# mesh-pane-watch — the PANE-LIVENESS watchdog (operator 2026-06-21, liveness-lease PART 3, mechanism 4).
#
# The render-layer lease completed: a data pane whose --watch render loop DIED sits FROZEN on its last
# frame and CANNOT self-report (it's not running to print UNKNOWN). Nothing watched this before:
# mesh-card-watchdog watches the card, mesh-reflex-health watches artifact freshness — neither watches
# the PANES. This is that watchdog.
#
# Mechanism: a LIVE data pane advances every frame (its header clock / fresh_stamp / refreshing data),
# so its captured content changes between cycles; a DEAD loop repeats byte-for-byte. So: capture each
# 2-pane channel window's DATA pane (.0), hash it, and flag a pane whose hash is IDENTICAL across N
# consecutive cycles (debounced — a momentarily-static frame doesn't trip it) as FROZEN → post once to
# the board for the health mind. Recovery (hash advances again) clears it. Default on any failure =
# say so (UNKNOWN/unwatchable), never a false all-clear.
#
#   mesh-pane-watch            one cycle: check every data pane, flag frozen (edge-triggered)
#   mesh-pane-watch --status   per-pane state, no posting
#   mesh-pane-watch --test     smoke (pure verdict-fn asserts; no tmux needed)
#
# reflex-cadence: */5 * * * *
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
SESS="$(hostname)"
MESH="$HOME/.mesh"; STATEDIR="$MESH/pane-watch"; mkdir -p "$STATEDIR"
CYCLES="${MESH_PANEWATCH_CYCLES:-2}"   # N consecutive identical captures (cycles are reflex-cadence apart) → FROZEN
ts(){ date -u +%FT%TZ; }

# PURE decision (dry-runnable — the reason this tool can be tested without a live tmux):
#   pane_step <prevhash> <curhash> <prevcount> <flagged> <cycles> -> "<newcount> <newflagged> <verdict>"
#   verdict: ok (advancing) | watch (identical, below threshold) | frozen (just crossed) |
#            still-frozen (already flagged) | recovered (advancing after a flag)
pane_step(){
  local ph="$1" ch="$2" pc="$3" fl="$4" cyc="$5" nc v
  if [ "$ch" != "$ph" ]; then
    nc=0
    if [ "$fl" = 1 ]; then v=recovered; fl=0; else v=ok; fi
  else
    nc=$((pc+1))
    if [ "$fl" = 1 ]; then v=still-frozen
    elif [ "$nc" -ge "$cyc" ]; then v=frozen; fl=1
    else v=watch; fi
  fi
  echo "$nc $fl $v"
}

if [ "${1:-}" = --test ]; then
  fail=0
  # advancing → ok, count resets
  [ "$(pane_step A B 5 0 2)" = "0 0 ok" ]            || { echo "FAIL advancing→ok"; fail=1; }
  # identical, first time, threshold 2 → watch (not yet frozen)
  [ "$(pane_step A A 0 0 2)" = "1 0 watch" ]         || { echo "FAIL identical→watch"; fail=1; }
  # identical, reaches threshold → frozen + flagged
  [ "$(pane_step A A 1 0 2)" = "2 1 frozen" ]        || { echo "FAIL threshold→frozen"; fail=1; }
  # identical while already flagged → still-frozen (no re-post)
  [ "$(pane_step A A 2 1 2)" = "3 1 still-frozen" ]  || { echo "FAIL flagged→still-frozen"; fail=1; }
  # advancing after a flag → recovered, clears flag
  [ "$(pane_step A B 3 1 2)" = "0 0 recovered" ]     || { echo "FAIL recovered"; fail=1; }
  command -v tmux >/dev/null 2>&1 || { echo "smoke-test: FAIL (no tmux)"; exit 1; }
  command -v cksum >/dev/null 2>&1 || { echo "smoke-test: FAIL (no cksum)"; exit 1; }
  [ "$fail" = 0 ] && echo "smoke-test: ok (pane_step frozen/recover state machine verified)" && exit 0
  echo "smoke-test: FAIL"; exit 1
fi

STATUS=0; [ "${1:-}" = --status ] && STATUS=1
tmux has-session -t "$SESS" 2>/dev/null || { echo "mesh-pane-watch: no session '$SESS' — nothing to watch"; exit 0; }

post(){ command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="pane-watch@$SESS" mesh-chat "$1" >/dev/null 2>&1; }

# Watch the DATA pane (.0) of each 2-pane channel window (top=data, bottom=mind convention). A
# single-pane window is a shell/mind, not a data pane — skip it (no false 'frozen' on an idle shell).
checked=0; frozen_now=""
while read -r win; do
  [ -n "$win" ] || continue
  np=$(tmux list-panes -t "$SESS:$win" 2>/dev/null | grep -c .)
  [ "${np:-0}" -ge 2 ] || continue                       # only 2-pane channels carry a data pane
  cap=$(tmux capture-pane -p -t "$SESS:$win.0" 2>/dev/null) || continue
  curhash=$(printf '%s' "$cap" | cksum | awk '{print $1}')
  sf="$STATEDIR/$win.state"
  read -r ph pc fl _ < <(cat "$sf" 2>/dev/null); ph="${ph:-}"; pc="${pc:-0}"; fl="${fl:-0}"
  case "$pc$fl" in *[!0-9]*) pc=0; fl=0;; esac
  if [ -z "$ph" ]; then                                  # first sight: record, can't compare yet
    [ "$STATUS" = 1 ] || echo "$curhash 0 0 $(ts)" > "$sf"  # --status is READ-ONLY: never mutate state
    [ "$STATUS" = 1 ] && echo "  NEW    $win (first capture — baseline recorded)"
    checked=$((checked+1)); continue
  fi
  read -r nc nf verdict < <(pane_step "$ph" "$curhash" "$pc" "$fl" "$CYCLES")
  # --status is a READ-ONLY inspector: do NOT persist (a manual check during a freeze→recover would
  # otherwise CONSUME the transition so the cron run never posts [pane-recovered], and back-to-back
  # checks <1 frame apart record a spurious identical-count). Only the cron path advances the state.
  [ "$STATUS" = 1 ] || echo "$curhash $nc $nf $(ts)" > "$sf"
  checked=$((checked+1))
  if [ "$STATUS" = 1 ]; then
    printf '  %-7s %-13s identical=%s flagged=%s\n' "$win" "$verdict" "$nc" "$nf"
    continue
  fi
  case "$verdict" in
    frozen)    frozen_now="$frozen_now $win"
               post "[pane-frozen] $SESS:$win data pane FROZEN — render loop dead (capture unchanged ${nc}× cycles); pane shows a stale last frame it cannot self-report. health-mind: respawn it (tmux respawn-pane -k -t $SESS:$win.0)" ;;
    recovered) post "[pane-recovered] $SESS:$win data pane advancing again — render loop alive" ;;
  esac
done < <(tmux list-windows -t "$SESS" -F '#{window_name}' 2>/dev/null)

[ "$STATUS" = 1 ] || echo "$(ts) pane-watch: $checked data pane(s) checked${frozen_now:+ — FROZEN:$frozen_now}"
exit 0
