#!/bin/bash
# mesh-ctx-pressure — how full are the live mind sessions' context windows (the /compact early-warning).
#
# The minds window's job is orchestration; "who is about to hit their context wall" is exactly the
# signal that says which mind needs a gentle /compact NEXT — it pairs with the dash's "last /compact"
# age line (that says who compacted long ago; this says who is under pressure NOW). Same read the
# statusline uses (tac|grep -m1 the last usage record), fanned over the recently-touched transcripts.
#
# TWO views:
#   1. DISTRIBUTION (always available) — all mesh minds share ONE cwd → ONE project dir, so transcripts
#      are NOT window-labelled. From the transcripts alone we can only report count·max%·over-threshold,
#      and must never invent a window→file mapping we can't prove.
#   2. PER MIND (when present) — the Claude statusline is the ONE place that holds both the window
#      identity (TMUX_PANE) and its own session transcript, so it drops a breadcrumb per render into
#      ~/.mesh/ctx/<window> (`<used> <pct> <cap_lbl>`). We read those to name WHICH mind is under
#      pressure. mtime = liveness: a breadcrumb ages out when its mind stops rendering (idle/dead), so
#      a stale one is marked and a very stale one dropped — never a fabricated per-mind reading.
#
# orphan-ok: on-demand query + minds-dash feeder (called with a timeout from mesh-dash minds)

set -u
PROJ="${MESH_CTX_PROJ:-$HOME/.claude/projects/-home-mesh-home-lte-workstation}"
WINDOW_MIN="${MESH_CTX_WINDOW_MIN:-12}"    # a transcript touched this recently ≈ a live session
WARN_PCT="${MESH_CTX_WARN_PCT:-75}"        # at/over this fraction of the window → wants a compact soon
CTX_DIR="${MESH_CTX_DIR:-$HOME/.mesh/ctx}" # per-window statusline breadcrumbs (overridable for --test)
STALE_MIN="${MESH_CTX_STALE_MIN:-10}"      # breadcrumb older than this → mark its age (mind quiet)
DROP_MIN="${MESH_CTX_DROP_MIN:-60}"        # breadcrumb older than this → drop (mind gone/rebooted)

# window cap per model family; default 1M (this node's minds run opus-4-8[1m])
CAP="${MESH_CTX_CAP:-1000000}"
cap_lbl="1M"; [ "$CAP" -le 200000 ] 2>/dev/null && cap_lbl="200k"

# ---- view 1: distribution over live transcripts ----
distribution() {
  local max=0 n=0 warn=0 f u pct maxpct maxk warn_seg=""
  while IFS= read -r f; do
    [ -r "$f" ] || continue
    u=$(tac "$f" 2>/dev/null | grep -m1 '"usage"' \
      | jq -r '(.message.usage // .usage) | (.input_tokens + (.cache_creation_input_tokens // 0) + (.cache_read_input_tokens // 0))' 2>/dev/null)
    [ -n "$u" ] && [ "$u" -gt 0 ] 2>/dev/null || continue
    n=$((n+1))
    [ "$u" -gt "$max" ] && max=$u
    pct=$(( u * 100 / CAP ))
    [ "$pct" -ge "$WARN_PCT" ] && warn=$((warn+1))
  done < <(find "$PROJ" -name '*.jsonl' -mmin -"$WINDOW_MIN" 2>/dev/null)

  if [ "$n" -eq 0 ]; then
    echo "ctx pressure: no live session transcripts in last ${WINDOW_MIN}m"
    return 0
  fi
  maxpct=$(( max * 100 / CAP ))
  if [ "$max" -ge 1000 ]; then maxk="$(( max / 1000 ))k"; else maxk="$max"; fi
  [ "$warn" -gt 0 ] && warn_seg=" · ⚠ ${warn} over ${WARN_PCT}% (compact soon)"
  echo "ctx pressure: ${n} live · max ${maxk}/${cap_lbl} (${maxpct}%)${warn_seg}"
}

# ---- view 2: per-mind from statusline breadcrumbs ----
# Emits one line "per mind: <win> <pct>% · …" sorted by pressure desc; nothing if no fresh breadcrumbs
# exist (so the distribution line still stands on its own). Never fabricates: a mind with no breadcrumb
# simply isn't listed (e.g. opencode minds, which have no Claude statusline).
per_mind() {
  [ -d "$CTX_DIR" ] || return 0
  local now f win rest used pct cap age mins mark warn_mark rows=""
  now=$(date +%s)
  for f in "$CTX_DIR"/*; do
    [ -r "$f" ] || continue
    win=$(basename "$f")
    rest=$(head -1 "$f" 2>/dev/null)
    used=${rest%% *}; rest=${rest#* }; pct=${rest%% *}; cap=${rest##* }
    [ -n "$pct" ] && [ "$pct" -ge 0 ] 2>/dev/null || continue
    age=$(( now - $(stat -c %Y "$f" 2>/dev/null || echo "$now") ))
    mins=$(( age / 60 ))
    [ "$mins" -ge "$DROP_MIN" ] && continue          # too stale → mind gone; don't show a dead reading
    mark=""; [ "$mins" -ge "$STALE_MIN" ] && mark="(${mins}m)"
    warn_mark=""; [ "$pct" -ge "$WARN_PCT" ] 2>/dev/null && warn_mark="⚠"
    # sort key = pct (zero-padded) so the fullest mind leads; label is what we print
    rows+="$(printf '%03d\t%s %s%%%s%s\n' "$pct" "$win" "$pct" "$warn_mark" "$mark")"$'\n'
  done
  [ -z "$rows" ] && return 0
  local joined
  joined=$(printf '%s' "$rows" | sort -rn | cut -f2- \
    | awk 'NF{ if(seen++) printf " · "; printf "%s", $0 } END{ if(seen) print "" }')
  echo "per mind: ${joined}"
}

# ---- --test: a gate that can actually FAIL (sandbox breadcrumb dir, never the live one) ----
if [ "${1:-}" = "--test" ]; then
  tmp=$(mktemp -d)
  # fresh: a mid-pressure mind and an over-threshold mind; stale-beyond-drop: must NOT appear
  printf '500000 50 1M\n' > "$tmp/genome"
  printf '800000 80 1M\n' > "$tmp/bruno"
  printf '900000 90 1M\n' > "$tmp/ghost"
  touch -d '90 minutes ago' "$tmp/ghost" 2>/dev/null
  out=$(CTX_DIR="$tmp" per_mind)   # subshell inherits the sandbox dir; live ~/.mesh/ctx untouched
  rm -rf "$tmp"
  fail() { echo "test-ctx-pressure: FAIL — $1 (got: '$out')"; exit 1; }
  printf '%s' "$out" | grep -q 'genome 50%'      || fail "fresh mid-pressure mind missing"
  printf '%s' "$out" | grep -q 'bruno 80%⚠'      || fail "over-threshold mind not marked ⚠"
  printf '%s' "$out" | grep -q 'ghost'           && fail "stale-beyond-drop breadcrumb was shown"
  # ordering: the fullest mind (bruno 80) must lead the mid one (genome 50)
  printf '%s' "$out" | grep -q 'bruno.*genome'   || fail "not sorted by pressure desc"
  echo "test-ctx-pressure: ok — '$out'"
  exit 0
fi

distribution
per_mind
