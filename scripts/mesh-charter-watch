#!/usr/bin/env bash
# mesh-charter-watch — restore missing repository-backed live-window charters before staffing fails.
# reflex-cadence: */5 * * * *
# reflex-state: $HOME/.mesh/charter-watch.log
set -euo pipefail

REPO="${MESH_CHARter_WATCH_REPO:-${MESH_REPO:-$HOME/lte-workstation}}"
NODE_HOME="${MESH_CHARter_WATCH_HOME:-$HOME}"
MESH_DIR="$NODE_HOME/.mesh"
CHARTER_DIR="$MESH_DIR/charter"
LOG="${MESH_CHARter_WATCH_LOG:-$MESH_DIR/charter-watch.log}"

iso_now() { date -u +%Y-%m-%dT%H:%M:%SZ; }

windows() {
  if [ -n "${MESH_CHARter_WATCH_WINDOWS+x}" ]; then
    local test_window
    for test_window in $MESH_CHARter_WATCH_WINDOWS; do
      printf '%s\n' "$test_window"
    done
    return 0
  fi
  local session out row name panes
  session="${MESH_CHARter_WATCH_TMUX_SESSION:-$(hostname)}"
  out="$(tmux list-windows -t "$session" -F '#{window_name} #{window_panes}')" || return 1
  while read -r name panes; do
    [ -n "${name:-}" ] && [ "${panes:-0}" -ge 2 ] 2>/dev/null && printf '%s\n' "$name"
  done <<<"$out"
}

post_board() {
  local body="$1"
  if command -v mesh-chat >/dev/null 2>&1; then
    MESH_WHO=witness mesh-chat "[fyi] mesh-charter-watch: $body" >/dev/null 2>&1 || true
  fi
}

atomic_restore() {
  local src="$1" dst="$2" tmp
  mkdir -p -- "$(dirname "$dst")"
  tmp="${dst}.tmp.$$"
  rm -f -- "$tmp"
  cp -- "$src" "$tmp"
  chmod 0644 -- "$tmp"
  mv -f -- "$tmp" "$dst"
}

run_once() {
  local now repo_charter local_charter window source_hash dest_hash
  local repaired=0 blocked=0 skipped=0 result="healthy" staffing_rc=0 staffing_note="not-run"
  now="$(iso_now)"
  mkdir -p -- "$CHARTER_DIR" "$(dirname "$LOG")"

  while read -r window; do
    [ -n "$window" ] || continue
    repo_charter="$REPO/charter/$window.md"
    local_charter="$CHARTER_DIR/$window.md"
    if [ ! -f "$repo_charter" ]; then
      skipped=$((skipped + 1))
      continue
    fi
    if [ -L "$local_charter" ]; then
      blocked=$((blocked + 1))
      printf '%s blocked window=%s reason=destination-symlink\n' "$now" "$window" >>"$LOG"
      continue
    fi
    if [ -e "$local_charter" ] && [ ! -f "$local_charter" ]; then
      blocked=$((blocked + 1))
      printf '%s blocked window=%s reason=destination-not-regular-file\n' "$now" "$window" >>"$LOG"
      continue
    fi
    if [ -f "$local_charter" ]; then
      if cmp -s -- "$repo_charter" "$local_charter"; then
        skipped=$((skipped + 1))
      else
        blocked=$((blocked + 1))
        printf '%s blocked window=%s reason=destination-divergent\n' "$now" "$window" >>"$LOG"
        post_board "blocked divergent charter window=$window; preserved destination=$local_charter"
      fi
      continue
    fi
    atomic_restore "$repo_charter" "$local_charter"
    source_hash="$(sha256sum "$repo_charter" | awk '{print $1}')"
    dest_hash="$(sha256sum "$local_charter" | awk '{print $1}')"
    if [ "$source_hash" != "$dest_hash" ]; then
      blocked=$((blocked + 1))
      printf '%s blocked window=%s reason=post-copy-hash-mismatch source=%s destination=%s\n' "$now" "$window" "$source_hash" "$dest_hash" >>"$LOG"
      continue
    fi
    repaired=$((repaired + 1))
    printf '%s repaired window=%s source=%s destination=%s\n' "$now" "$window" "$source_hash" "$dest_hash" >>"$LOG"
    post_board "repaired missing charter window=$window sha256=$dest_hash"
  done < <(windows)

  if command -v "${MESH_STAFFING_BIN:-mesh-staffing}" >/dev/null 2>&1; then
    staffing_note="$({ "${MESH_STAFFING_BIN:-mesh-staffing}" --json >/dev/null; } 2>&1)" || staffing_rc=$?
    staffing_note="$(printf '%s' "$staffing_note" | head -1 | tr '[:space:]' ' ')"
  else
    staffing_rc=127
    staffing_note="mesh-staffing unavailable"
  fi
  [ "$blocked" -eq 0 ] && [ "$staffing_rc" -eq 0 ] || result="blocked"
  printf '%s run result=%s repaired=%d blocked=%d skipped=%d staffing_rc=%d staffing_note=%s\n' \
    "$now" "$result" "$repaired" "$blocked" "$skipped" "$staffing_rc" "${staffing_note:-ok}" >>"$LOG"
  if [ "$repaired" -gt 0 ]; then
    printf '%s mesh-charter-watch: repaired=%d blocked=%d staffing_rc=%d\n' "$result" "$repaired" "$blocked" "$staffing_rc"
  elif [ "$blocked" -gt 0 ] || [ "$staffing_rc" -ne 0 ]; then
    printf '%s mesh-charter-watch: blocked=%d repaired=%d staffing_rc=%d %s\n' "$result" "$blocked" "$repaired" "$staffing_rc" "${staffing_note:-}" >&2
  else
    printf '%s mesh-charter-watch: healthy repaired=0 blocked=0 staffing_rc=0\n' "$result"
  fi
  [ "$result" = healthy ]
}

run_test() {
  local td out child_rc=0
  td="$(mktemp -d)"
  trap 'rm -rf -- "$td"' RETURN
  mkdir -p "$td/repo/charter" "$td/home/.mesh/charter" "$td/bin"
  printf '%s\n' 'role: adint' >"$td/repo/charter/adint.md"
  printf '%s\n' 'role: genome' >"$td/repo/charter/genome.md"
  printf '%s\n' 'local divergent charter' >"$td/home/.mesh/charter/genome.md"
  cat >"$td/bin/mesh-staffing" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' '{"windows": [{"window": "adint", "eligible": true}]}'
EOF
  cat >"$td/bin/mesh-chat" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' "$*" >>"$MESH_CHARter_WATCH_CHAT_LOG"
EOF
  chmod +x "$td/bin/mesh-staffing" "$td/bin/mesh-chat"
  out="$(PATH="$td/bin:$PATH" MESH_REPO="$td/repo" MESH_CHARter_WATCH_HOME="$td/home" \
    MESH_CHARter_WATCH_LOG="$td/home/.mesh/charter-watch.log" MESH_CHARter_WATCH_WINDOWS='adint genome ghost' \
    MESH_CHARter_WATCH_CHAT_LOG="$td/chat.log" "$0")" || child_rc=$?
  [ "$child_rc" -eq 1 ] || { echo "FAIL: fixture expected a divergent-charter block (rc=$child_rc)"; return 1; }
  cmp -s "$td/repo/charter/adint.md" "$td/home/.mesh/charter/adint.md" || { echo 'FAIL: missing charter not repaired'; return 1; }
  cmp -s <(printf '%s\n' 'local divergent charter') "$td/home/.mesh/charter/genome.md" || { echo 'FAIL: divergent charter overwritten'; return 1; }
  grep -q 'repaired window=adint' "$td/home/.mesh/charter-watch.log" || { echo 'FAIL: repair evidence missing'; return 1; }
  grep -q '^.* run result=blocked ' "$td/home/.mesh/charter-watch.log" || { echo 'FAIL: run row missing'; return 1; }
  grep -q 'repaired missing charter window=adint' "$td/chat.log" || { echo 'FAIL: board evidence missing'; return 1; }
  printf '%s\n' 'missing charter repaired' 'divergent charter preserved' 'run row written' 'PASS'
}

case "${1:-}" in
  --test) run_test ;;
  "") run_once ;;
  *) echo "usage: mesh-charter-watch [--test]" >&2; exit 2 ;;
esac
