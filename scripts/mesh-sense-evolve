#!/usr/bin/env bash
# mesh-sense-evolve — the PERCEPTION-AUTOPOIESIS reflex. The senses channel's mind is supposed to
# KEEP and DEVELOP the senses (operator 2026-06-17: "enriching senses, cross-sensing, etc"). Left
# alone an idle mind does nothing; this reflex GUARANTEES self-production happens: when the senses
# mind is IDLE it injects ONE concrete, rotating sense-development directive so the sensorium keeps
# growing on its own. Honest + non-intrusive:
#   - card-gated (a node that declares no minds is never touched — HANDS-OFF rule)
#   - idle-gated (never interrupts a WORKING / NEEDS-INPUT / RATE-LIMITED / DEAD mind)
#   - throttled (at most one inject per MESH_SENSE_EVOLVE_INT, default 40min — a directive is real
#     work, not a per-cron-tick nudge)
#   - rotating (enrich -> cross-sense -> new-sense -> liveness) so coverage broadens over time
# Sibling of the genome codebase-autopoiesis loop (mesh-generate -> mesh-feed -> genome mind).
#
#   mesh-sense-evolve            inject a directive if the senses mind is idle + throttle elapsed
#   mesh-sense-evolve --force    ignore the throttle (still idle-gated)
#   mesh-sense-evolve --test     smoke test
# reflex-cadence: */15 * * * *
set -uo pipefail
PATH="$HOME/.local/bin:$PATH"
MESH="$HOME/.mesh"
WIN="${MESH_SENSE_WIN:-senses}"
INT="${MESH_SENSE_EVOLVE_INT:-2400}"          # 40 min throttle
MARK="$MESH/.sense-evolve-last"
RR="$MESH/.sense-evolve-rr"
S="$(hostname)"
ts(){ date -u +%FT%TZ; }

# MINT HYGIENE — appended to every directive that can BIRTH a new tool file, so a new sense is born
# doctor-clean. This is the exact gap that bit mesh-display-link: minted, --test-green, [sense]-posted,
# but it landed orphan-flagged + the source was non-+x → a FALSE-GREEN birth the doctor only caught
# after the fact. A new tool is NOT done until mesh-doctor agrees, at mint time.
HYGIENE="MINT HYGIENE — do ALL of this BEFORE you post [sense], if you create a NEW tool file: (1) stamp its header with EITHER '# orphan-ok: <why it is on-demand>' OR '# reflex-cadence: <5-field cron>' (then wire it via mesh-autowire) — never leave it bare or it lands a NEW orphan WARN; (2) chmod +x the source in scripts/ (a non-+x source fails its own --test rc=126); (3) if your sense is CHANGE-GATED (rewrites its STATE/artifact only when the VALUE changes), call 'mesh-state-touch \"\$STATE\"' on EVERY successful run so a long-stable-but-LIVE value cannot decay to a FALSE STALE (mtime = ran-live, content = value-changed) — use the SHARED primitive, never hand-roll a bare touch; (4) run 'mesh-doctor' and confirm it PASSES with NO new orphan WARN. Do NOT post [sense] until mesh-doctor is clean — a sense that fails the doctor is not born, it is a false-green."

# ── LITERATURE (open-ended evolution — a foundational OEE mechanism this reflex did NOT embody) ─────
# Brant & Stanley, "Minimal Criterion Coevolution: A New Approach to Open-Ended Search" (GECCO 2017;
# Jonathan Brant PhD thesis, UCF 2020). MCC's result: sustained open-ended DIVERGENCE needs NO explicit
# novelty measure and NO fitness function — it emerges when TWO populations coevolve, each gated only by
# a MINIMAL CRITERION defined WITH RESPECT TO THE OTHER (agents must solve ≥1 maze; mazes must be solved
# by ≥1 agent). Each side keeps finding new ways to satisfy its reproductive constraint against a moving
# partner → unbounded, unrepeated structure in a single run. Reviewed live 2026-07-11; the current MCC
# reading (arxiv/UCF STARS) matches the 2017/2020 sources — a stable foundational result, not a fad.
#   WHAT WE APPLIED TOO LOOSELY: this reflex (and its sibling genome lane) GENERATES variation then FILTERS
#   it with EXPLICIT objectives — mesh-novelty (Shannon surprise), mesh-fitness (regression revert),
#   mesh-doctor. That is exactly the objective-driven search MCC shows is NOT how nature diverges. And the
#   NEW-SENSE directive (below) mints producers with NO coupling to any consumer → the recurring HOLLOW
#   SENSE (cron-green, artifact nobody reads, decays to stale) — a producer with no reproductive partner.
#   THE MISSING MECHANISM: couple the two populations the mesh already has — SENSES (producers) and
#   FUSIONS/consumers — by a MUTUAL minimal criterion: a sense reproduces iff ≥1 consumer reads it; a
#   fusion reproduces iff it reads ≥1 live sense. No novelty/fitness scoring; the coupling itself drives
#   growth and STRUCTURALLY CANNOT birth a hollow sense (being-consumed IS the survival criterion). Applied
#   below as the COEVOLUTIONARY directive — variation is minted only to CLOSE a producer↔consumer link.

# the rotation — each MUST produce a real artifact, never make-work, honest-degraded on unreachable.
DIRECTIVES=(
"COEVOLUTIONARY MINIMAL-CRITERION (Brant & Stanley, MCC — couple the two populations the mesh already has): treat SENSES (producers) and FUSIONS/consumers as two coevolving populations gated by a MUTUAL minimal criterion — a product survives only if it CLOSES a producer<->consumer link; use NO explicit novelty/fitness scoring, the coupling IS the selection. Do ONE: (a) find a fusion/consumer (mesh-situation / mesh-sensorium / mesh-stress / mesh-ambient-clock / mesh-operator-state) whose input is currently UNKNOWN/absent, and mint the MINIMAL HONEST sense that satisfies exactly that unmet input; OR (b) find a LIVE-but-UNDER-CONSUMED sense (fresh real artifact, but grep -rl shows no fusion reads it) and extend one fusion to consume it. Verify BOTH ends touch a real artifact — the new link is live END-TO-END (exit 2 honest on unreachable, never faked). This structurally cannot birth a hollow sense: being-consumed IS the criterion. Post [sense] naming the closed producer<->consumer link. Do NOT commit. $HYGIENE"
"SENSE ENRICHMENT: pick ONE existing sense (mesh-presence / mesh-light / mesh-body-motion / mesh-wifi-motion / mesh-tamper / mesh-ambient-clock / mesh-room-sense); improve its fidelity OR coverage (a new signal, better classification, debounce, or an honest-degraded path). Verify it still yields a REAL artifact (exit 2 on unreachable, never faked). Post [sense] evidence to chat. Leave changes in the tree; do NOT commit (genome lands)."
"CROSS-SENSE FUSION: combine 2+ existing senses into a richer derived signal no single sensor gives (e.g. motion+light+presence -> room-occupancy; body-motion+BLE -> operator-state). Build or extend the fusion tool; an UNREACHABLE input must render visibly different from a genuine empty (no silent all-clear). Verify with a real read. Post [sense] artifact. Do NOT commit. $HYGIENE"
"NEW SENSE: identify ONE real-world signal the mesh's hardware COULD perceive but does not yet (a termux-* sensor on the phone body, a /sys or /proc reading, a BLE/wifi signal). Wire a minimal HONEST sense for it (exit 2 on unreachable, never fake a reading). Verify one real reading + add a --test. Post [sense] artifact. Do NOT commit. $HYGIENE"
"SENSE LIVENESS: run mesh-reflex-health and probe each sense organ; find ONE sense that is stale / dark / hollow (cron-scheduled + smoke-green but no fresh real artifact); fix it OR honestly mark it decayed. Verify a fresh real artifact afterwards. Post [sense] evidence. Do NOT commit."
)

if [ "${1:-}" = --test ]; then
  command -v tmux >/dev/null 2>&1 || { echo "smoke-test: FAIL (no tmux)"; exit 1; }
  command -v mesh-mind-state >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-mind-state)"; exit 1; }
  command -v mesh-tell >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-tell)"; exit 1; }
  [ "${#DIRECTIVES[@]}" -ge 3 ] || { echo "smoke-test: FAIL (need >=3 rotating directives, have ${#DIRECTIVES[@]})"; exit 1; }
  # rotation must advance and wrap
  td="$(mktemp -d)"; trap 'rm -rf "$td"' EXIT
  i0=$(( $(cat "$td/rr" 2>/dev/null || echo 0) % ${#DIRECTIVES[@]} )); echo $((i0+1)) > "$td/rr"
  i1=$(( $(cat "$td/rr" 2>/dev/null || echo 0) % ${#DIRECTIVES[@]} ))
  [ "$i0" != "$i1" ] || { echo "smoke-test: FAIL (rotation did not advance)"; exit 1; }
  # every directive must carry the honest+artifact contract
  for d in "${DIRECTIVES[@]}"; do
    case "$d" in *"[sense]"*) :;; *) echo "smoke-test: FAIL (directive missing [sense] artifact contract)"; exit 1;; esac
  done
  # mint-hygiene: a directive that can BIRTH a new tool must require a doctor-clean birth — an
  # orphan-ok|reflex-cadence header AND a mesh-doctor PASS gate before [sense] (the display-link gap).
  doc=0
  for d in "${DIRECTIVES[@]}"; do
    case "$d" in
      *orphan-ok*reflex-cadence*mesh-doctor*) doc=$((doc+1)) ;;
    esac
  done
  [ "$doc" -ge 2 ] || { echo "smoke-test: FAIL (mint-hygiene: expect >=2 directives carrying orphan-ok|reflex-cadence + mesh-doctor gate, have $doc)"; exit 1; }
  # mint-hygiene must also steer change-gated senses to the SHARED liveness primitive (state-touch-adoption)
  case "$HYGIENE" in *mesh-state-touch*CHANGE-GATED*|*CHANGE-GATED*mesh-state-touch*) : ;; *) echo "smoke-test: FAIL (mint-hygiene missing mesh-state-touch change-gated liveness clause)"; exit 1 ;; esac
  echo "smoke-test: ok (rotation + [sense] contract + mint-hygiene x$doc + state-touch clause)"; exit 0
fi

FORCE=0; [ "${1:-}" = --force ] && FORCE=1

# card gate: HANDS-OFF a node that declares no minds (operator rule)
grep -qE '^  *minds:.*[a-z]' "$HOME/.mesh-card" 2>/dev/null || { echo "$(ts) card declares no minds — skip" >> "$MESH/sense-evolve.log"; exit 0; }

# the senses window must exist on this node's session
tmux has-session -t "$S" 2>/dev/null || { echo "$(ts) no session" >> "$MESH/sense-evolve.log"; exit 0; }
tmux list-windows -t "$S" -F '#{window_name}' 2>/dev/null | grep -qx "$WIN" || { echo "$(ts) no '$WIN' window — skip" >> "$MESH/sense-evolve.log"; exit 0; }

# idle gate: only inject into an IDLE mind (mesh-mind-state classifies the pane TUI state)
st="$(mesh-mind-state "$WIN" 2>/dev/null | head -1)"; st="${st%%	*}"
case "$st" in
  IDLE*) : ;;
  *) echo "$(ts) $WIN is '$st' (not IDLE) — defer" >> "$MESH/sense-evolve.log"; exit 0 ;;
esac

# throttle: a directive is real work — don't re-inject every cron tick
if [ "$FORCE" != 1 ] && [ -f "$MARK" ]; then
  last=$(cat "$MARK" 2>/dev/null || echo 0); now=$(date +%s)
  [ $(( now - last )) -lt "$INT" ] && { echo "$(ts) throttled ($(( (INT-(now-last))/60 ))min left)" >> "$MESH/sense-evolve.log"; exit 0; }
fi

# pick + advance the rotation
n=${#DIRECTIVES[@]}; rr=$(cat "$RR" 2>/dev/null || echo 0); idx=$(( rr % n ))
echo $(( rr + 1 )) > "$RR"
directive="${DIRECTIVES[$idx]}"

mesh-tell "$WIN" "$directive" >/dev/null 2>&1 \
  && { date +%s > "$MARK"; echo "$(ts) injected directive #$idx -> $WIN: ${directive:0:60}" >> "$MESH/sense-evolve.log"; \
       command -v mesh-trace >/dev/null 2>&1 && MESH_WHO="sense-evolve@$S" mesh-trace "[sense-evolve] $WIN fed a self-development directive (#$idx: ${directive%%:*}) — perception autopoiesis (metabolism tier)." >/dev/null 2>&1; } \
  || echo "$(ts) mesh-tell $WIN failed" >> "$MESH/sense-evolve.log"
