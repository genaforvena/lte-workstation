#!/usr/bin/env bash
# orphan-ok: on-demand Note3 attention read (when was the body last touched?); pulled by a
#            mind or fused on request, not scheduled — stateless stdout fold, no artifact of its own.
# mesh-note3-touchidle — SECONDS-SINCE-LAST-TOUCH on the Note3 body (previously unsensed).
#
# The gap: senses know the Note3's light, climate, motion, radio and screen VIDEO — but nothing
# says when a human last touched it. `dumpsys power` carries mLastUserActivityTime with its own
# device-side "(Xms ago)", plus mWakefulness/mInteractive context. Touch-idleness is the attention
# half of presence: a PRESENT room beside a 3-day-untouched phone is a different state from a
# phone touched 40s ago, and no single existing sensor reports it.
#
# Bands on idle seconds (FALSIFIABLE via --test — move the cuts and the fixtures flip):
#   FRESH     < 300    touched in the last 5 min — someone is (or was just) here
#   RECENT    < 3600   touched within the hour
#   IDLE      < 86400  touched within the day
#   DORMANT   >= 86400  over a day untouched
#
#   mesh-note3-touchidle          one read → `status=OK idle_s=N band=… wakefulness=… interactive=…`
#   mesh-note3-touchidle --test   parser fixtures + one live adb read asserting a numeric artifact
#
# Honest-exit contract: anything that is not a numeric idle off a live adb read renders
# status=UNKNOWN with a NAMED reason (adb_unreachable|empty_capture|no_activity_line|
# malformed_activity) and exits 2 — never a fabricated band. The device prints the age
# itself ("(Xms ago)"), so no clock of ours enters the measurement.
set -uo pipefail

SERIAL="${MESH_NOTE3_SERIAL:-4d00553d61ab90b7}"

# parse_touchidle <dumpsys-power text> → "idle_s wakefulness interactive" (rc 0) or
# "UNKNOWN <reason>" (rc 2). Pure, offline-testable.
parse_touchidle() {
  local text="$1" ago_ms wake inter idle
  ago_ms="$(printf '%s' "$text" | grep -oE 'mLastUserActivityTime=[0-9]+ \([0-9]+ ?ms ago\)' | head -1 | grep -oE '\([0-9]+ ?ms ago\)' | grep -oE '[0-9]+' | head -1)"
  [ -n "$ago_ms" ] || { echo "UNKNOWN no_activity_line"; return 2; }
  wake="$(printf '%s' "$text" | grep -oE '^[[:space:]]*mWakefulness=[A-Za-z]+' | head -1 | cut -d= -f2)"
  inter="$(printf '%s' "$text" | grep -oE '^[[:space:]]*mInteractive=(true|false)' | head -1 | cut -d= -f2)"
  [ -n "$wake" ] && [ -n "$inter" ] || { echo "UNKNOWN malformed_activity"; return 2; }
  idle=$(( ago_ms / 1000 ))
  printf '%s %s %s\n' "$idle" "$wake" "$inter"
}

# classify_idle <idle_s> → FRESH|RECENT|IDLE|DORMANT. Pure, offline-testable.
classify_idle() {
  local s="$1"
  printf '%s' "$s" | grep -qE '^[0-9]+$' || { echo "UNKNOWN"; return 2; }
  if [ "$s" -lt 300 ]; then echo FRESH
  elif [ "$s" -lt 3600 ]; then echo RECENT
  elif [ "$s" -lt 86400 ]; then echo IDLE
  else echo DORMANT; fi
}

unknown() {
  printf 'status=UNKNOWN reason=%s idle_s=unknown band=unknown wakefulness=unknown interactive=unknown\n' "${1:-unknown}"
  return 2
}

live_read() {
  local raw parsed idle wake inter band
  raw="$(adb -s "$SERIAL" shell 'dumpsys power' 2>/dev/null | tr -d '\r')"
  [ -n "$raw" ] || unknown adb_unreachable
  [ -n "$raw" ] || return 2
  parsed="$(parse_touchidle "$raw")" || unknown no_activity_line
  [ -n "${parsed:-}" ] || return 2
  idle="${parsed%% *}"; wake="$(printf '%s' "$parsed" | awk '{print $2}')"; inter="$(printf '%s' "$parsed" | awk '{print $3}')"
  band="$(classify_idle "$idle")" || unknown malformed_activity
  [ -n "${band:-}" ] || return 2
  printf 'status=OK idle_s=%s band=%s wakefulness=%s interactive=%s\n' "$idle" "$band" "$wake" "$inter"
}

if [ "${1:-}" = --test ]; then
  fail=0
  chk() { [ "$2" = "$3" ] || { echo "  FAIL: $1 got=[$2] want=[$3]"; fail=1; }; }
  _fx=$'mWakefulness=Awake\nmInteractive=true\nmLastUserActivityTime=194885762 (436716 ms ago)'
  chk parse-live-shape "$(parse_touchidle "$_fx")" "436 Awake true"
  chk fresh "$(classify_idle 40)" FRESH
  chk fresh-boundary "$(classify_idle 299)" FRESH
  chk recent-lo "$(classify_idle 300)" RECENT
  chk recent-hi "$(classify_idle 3599)" RECENT
  chk idle-lo "$(classify_idle 3600)" IDLE
  chk idle-hi "$(classify_idle 86399)" IDLE
  chk dormant "$(classify_idle 86400)" DORMANT
  chk dormant-big "$(classify_idle 259200)" DORMANT
  parse_touchidle 'mWakefulness=Awake' >/dev/null 2>&1 \
    && { echo "  FAIL: missing activity line must exit 2"; fail=1; }
  parse_touchidle "$_fx" >/dev/null 2>&1 || { echo "  FAIL: valid fixture must parse"; fail=1; }
  classify_idle 'abc' >/dev/null 2>&1 \
    && { echo "  FAIL: non-numeric idle must exit 2"; fail=1; }
  [ "$fail" = 1 ] && { echo "smoke-test: FAIL"; exit 1; }
  out="$(live_read 2>/dev/null)"; rc=$?
  if [ "$rc" = 0 ]; then
    echo "$out" | grep -qE '^status=OK idle_s=[0-9]+ band=(FRESH|RECENT|IDLE|DORMANT) wakefulness=[A-Za-z]+ interactive=(true|false)$' \
      || { echo "  FAIL: live rc=0 without numeric artifact: $out"; exit 1; }
    echo "smoke-test: ok (parser fixtures + live read: $out)"
  elif [ "$rc" = 2 ]; then
    echo "$out" | grep -qE '^status=UNKNOWN reason=[a-z_]+ ' \
      || { echo "  FAIL: rc=2 without named reason: $out"; exit 1; }
    echo "smoke-test: n/a (parser fixtures ok; live adb dark: $out)"
  else
    echo "  FAIL: live read exited $rc (expected 0 or 2)"; exit 1
  fi
  exit 0
fi

live_read
