#!/usr/bin/env python3
"""Check whether one Tiny Fleet matrix run root has concurrent writers."""

from collections import defaultdict
import os
from pathlib import Path
import subprocess
import sys


PROC_ROOT = Path(os.environ.get("MESH_STUDY_DUP_PROC_ROOT", "/proc"))
RUNNER = os.environ.get(
    "MESH_STUDY_DUP_RUNNER",
    str(Path.home() / "tiny-fleet/scripts/run_study_matrix.py"),
)


def main() -> int:
    if sys.argv[1:] == ["--test"]:
        test = Path(__file__).resolve().parents[1] / "tests/test-mesh-study-duplicate-check.py"
        return subprocess.call([sys.executable, str(test)])
    if sys.argv[1:]:
        print("usage: mesh-study-duplicate-check", file=sys.stderr)
        return 2
    by_root: dict[str, list[int]] = defaultdict(list)
    unknown = []
    try:
        entries = list(PROC_ROOT.iterdir())
    except OSError as exc:
        print(f"UNKNOWN Tiny Fleet matrix workers: proc unavailable ({exc})")
        return 2
    for entry in entries:
        if not entry.name.isdecimal():
            continue
        try:
            with (entry / "cmdline").open("rb") as handle:
                raw = handle.read(8193)
        except FileNotFoundError:
            continue  # Process exited during the snapshot.
        except OSError:
            unknown.append(entry.name)
            continue
        if not raw:
            continue
        if len(raw) > 8192:
            # A long unrelated command (for example python -c with an embedded
            # program) says nothing about study ownership. Only a matching
            # runner whose full argv is truncated makes this check UNKNOWN.
            first_two = raw.split(b"\0", 2)
            if (len(first_two) < 2
                    or first_two[1].decode("utf-8", "replace") == RUNNER):
                unknown.append(entry.name)
            continue
        argv = [part.decode("utf-8", "replace") for part in raw.rstrip(b"\0").split(b"\0")]
        if len(argv) < 2 or argv[1] != RUNNER:
            continue
        try:
            index = argv.index("--run-root")
            root = argv[index + 1]
        except (ValueError, IndexError):
            unknown.append(entry.name)
            continue
        if not root.startswith("/") or not root:
            unknown.append(entry.name)
            continue
        by_root[os.path.normpath(root)].append(int(entry.name))
    duplicates = {root: sorted(pids) for root, pids in by_root.items() if len(pids) > 1}
    if duplicates:
        for root, pids in sorted(duplicates.items()):
            print(f"FAIL Tiny Fleet duplicate matrix workers: run_root={root} count={len(pids)} "
                  f"pids={','.join(map(str, pids))}")
        return 1
    if unknown:
        print(f"UNKNOWN Tiny Fleet matrix workers: unreadable or unbound pids={','.join(unknown[:8])}")
        return 2
    print(f"PASS Tiny Fleet matrix single-writer: active={sum(map(len, by_root.values()))} "
          f"roots={len(by_root)}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
