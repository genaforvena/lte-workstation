#!/usr/bin/env python3
# mesh-tv-dlna — play a YouTube/video URL on a DLNA TV (Sony Bravia), NO phone needed.
# Node on the TV's LAN: yt-dlp extracts a direct stream URL → DLNA SetAVTransportURI + Play to the TV's
# MediaRenderer. Built 2026-06-14 (operator: "/meshtv <url> → plays on TV, no phone"). Old Bravia (2013):
# prefer progressive mp4/h264. Verified renderer: KDL-42W653A @ :52323/dmr.xml.
#   mesh-tv-dlna <video-url>
import sys, socket, time, re, subprocess, urllib.request, urllib.parse, xml.etree.ElementTree as ET

def log(*a): print("[mesh-tv-dlna]", *a, flush=True)

# Every HTTP request this tool makes is to the TV on the LOCAL LAN — dmr.xml, the AVTransport SOAP
# control point, the Bravia IRCC endpoint. urllib honours http_proxy/https_proxy from the environment,
# and on a node whose shells are universally proxied (mesh-home, 2026-08-28: three export sites plus
# the tmux global env plus environment.d, so even long-lived units carry it) every one of those LAN
# requests was handed to privoxy → an ssh tunnel → phaedra, which has never heard of 192.168.8.0/24.
# Measured 2026-08-30 the moment SSDP discovery started working again: renderer found at
# http://192.168.8.130:52323/dmr.xml, then `HTTP Error 503: Forwarding failure`. A proxy env is a
# REPLACEMENT, not a fallback ([[a-proxy-env-is-a-replacement-not-a-fallback]]), and NO_PROXY cannot
# be relied on here — the oldest reader on this LAN speaks neither CIDR nor wildcards
# ([[no-proxy-does-not-speak-cidr-or-wildcards]]). So bypass it in code, for this tool's own opener
# only: yt-dlp is a separate process and keeps whatever egress the operator configured.
_DIRECT = urllib.request.build_opener(urllib.request.ProxyHandler({}))
def http_open(req, timeout):
    """Open a LAN URL with the ambient proxy explicitly bypassed."""
    return _DIRECT.open(req, timeout=timeout)

def yt_supports(flag):
    """True iff the installed yt-dlp advertises `flag` in --help. A too-old yt-dlp that
    doesn't know an optional flag we inject dies 'no such option' and downloads nothing —
    so feature-probe the ACTUAL binary, never assume the flag exists. Canonical: the
    apt yt-dlp 2024.04.09 lacked --js-runtimes; node was present so the flag was injected;
    EVERY YouTube cast failed while --version passed clean (fixed 2026-07-17)."""
    try:
        h = subprocess.run(["yt-dlp", "--help"], capture_output=True, text=True, timeout=20)
        return flag in h.stdout
    except Exception:
        return False

def lan_src():
    """The address to pin a multicast socket to: the MAIN table's default-route source, never the
    source `ip route get <group>` reports (that lookup is answered by the exit-node table that is
    doing the swallowing). Empty string when there is no default route — pin nothing, and let the
    guard say so rather than inventing an address."""
    import os as _o
    if "MESH_TV_LAN_SRC" in _o.environ: return _o.environ["MESH_TV_LAN_SRC"]
    try:
        r = subprocess.run(["ip", "route", "show", "default"], capture_output=True, text=True, timeout=5)
        for ln in (r.stdout or "").splitlines():
            f = ln.split()
            if f and f[0] == "default" and "src" in f:
                return f[f.index("src") + 1]
    except Exception:
        pass
    return ""

def mcast_path():
    """The multicast-path blindness guard, asked of the ONE tool that owns the predicate.

    Discovery here is an M-SEARCH to 239.255.255.250 — MULTICAST. On a node consuming a tailscale
    exit node the exit-node table's default swallows 224.0.0.0/4 (its throw set is unicast-only),
    so the query leaves by the tunnel, nobody answers, and this tool used to blame the TV:
    "TV off or not on WiFi" / "TV on + on home WiFi?" — a cause never measured, while the Bravia
    answered 200 on http://192.168.8.130:52323/dmr.xml over unicast in the same minute
    (discover/health {#39af3e18}, verified live 2026-08-30).

    The predicate is NOT reimplemented here. `mesh-upnp-census --mcast-path` is the single entry
    point; a second copy drifts the day one of them is widened. Returns the tool's line, or None
    when the guard itself could not be run — and None must never be reported as "the TV is off":
    an unavailable guard is an unknown, not an all-clear."""
    try:
        r = subprocess.run(["mesh-upnp-census", "--mcast-path"], capture_output=True, text=True, timeout=10)
        line = (r.stdout or "").strip().splitlines()
        return line[0] if r.returncode == 0 and line and line[0].startswith("state=") else None
    except Exception:
        return None

def no_renderer_reason():
    """What to SAY when discovery found nothing. Names the swallowed path when that is what the FIB
    says, an honest unknown when the guard is unavailable, and only in the ok case is 'the TV is off'
    a reading this tool is entitled to."""
    mc = mcast_path()
    if mc is None:
        return ("no DLNA renderer answered, and the multicast-path guard could not be run "
                "(mesh-upnp-census --mcast-path) — cause UNKNOWN; not claiming the TV is off")
    if mc.startswith("state=swallowed"):
        return ("no DLNA renderer answered, and the SSDP query never reached the LAN: " + mc +
                " — this is BLINDNESS, not a TV that is off. A unicast GET of the renderer's own "
                "dmr.xml still works; fix the multicast route, not the TV")
    if mc.startswith("state=ok"):
        return "no DLNA renderer answered down a multicast path that DOES reach the LAN (" + mc + ") — TV off/asleep or not on this LAN"
    return "no DLNA renderer answered, and the multicast path is unattestable: " + mc + " — cause UNKNOWN"

def discover():
    """SSDP → return (location_url) of a MediaRenderer (Bravia/Sony preferred)."""
    msg = b"\r\n".join([b"M-SEARCH * HTTP/1.1", b"HOST:239.255.255.250:1900",
        b'MAN:"ssdp:discover"', b"MX:2", b"ST:urn:schemas-upnp-org:device:MediaRenderer:1", b"", b""])
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM); s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1); s.settimeout(4)
    # PIN the egress interface to the MAIN table's own default-route source. Unpinned, this M-SEARCH
    # follows the FIB, and under a tailscale exit node the FIB sends 224.0.0.0/4 down the tunnel — so
    # the query never reaches the LAN and the TV is blamed for the silence ({#39af3e18}). The address
    # must NOT come from `ip route get 239.255.255.250`: that lookup is answered by the swallowing
    # table and hands back the tunnel's own source (100.81.222.19 here, vs the LAN's 192.168.8.224).
    src = lan_src()
    if src:
        try: s.setsockopt(socket.IPPROTO_IP, socket.IP_MULTICAST_IF, socket.inet_aton(src))
        except OSError as e: log("warn: could not pin multicast egress to", src, "-", e)
    s.sendto(msg, ("239.255.255.250", 1900)); found = {}
    t = time.time()
    while time.time() - t < 4:
        try:
            d, _ = s.recvfrom(2048); txt = d.decode("utf-8", "replace"); loc = ""
            for l in txt.split("\r\n"):
                if l.lower().startswith("location"): loc = l.split(":", 1)[1].strip()
            if loc: found[loc] = txt
        except socket.timeout: break
        except Exception: pass
    # prefer a Bravia/Sony renderer
    for loc, txt in found.items():
        if "bravia" in txt.lower() or "sony" in txt.lower() or "kdl" in (loc+txt).lower(): return loc
    return next(iter(found), None)

def control_url(dmr_loc):
    """Fetch dmr.xml, return (absolute AVTransport control URL, serviceType). Regex-based — UPnP device
    descriptions carry prefixed/namespaced tags (dlna:, pnpx:, df:) that trip a strict XML parser."""
    xml = http_open(dmr_loc, 6).read().decode("utf-8", "replace")
    base = "{0.scheme}://{0.netloc}".format(urllib.parse.urlparse(dmr_loc))
    for m in re.finditer(r"<service\b[^>]*>(.*?)</service>", xml, re.S | re.I):
        blk = m.group(1)
        st = re.search(r"<serviceType[^>]*>([^<]+)</serviceType>", blk, re.I)
        if st and "AVTransport" in st.group(1):
            cu = re.search(r"<controlURL[^>]*>([^<]+)</controlURL>", blk, re.I)
            if cu:
                u = cu.group(1).strip()
                return (u if u.startswith("http") else base + (u if u.startswith("/") else "/" + u)), st.group(1).strip()
    raise RuntimeError("no AVTransport service in dmr.xml")

def soap(ctrl, service_type, action, body):
    env = ('<?xml version="1.0"?>'
        '<s:Envelope xmlns:s="http://schemas.xmlsoap.org/soap/envelope/" '
        's:encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"><s:Body>'
        f'<u:{action} xmlns:u="{service_type}">{body}</u:{action}>'
        '</s:Body></s:Envelope>').encode()
    req = urllib.request.Request(ctrl, env, {
        "Content-Type": 'text/xml; charset="utf-8"',
        "SOAPACTION": f'"{service_type}#{action}"'})
    try:
        return http_open(req, 8).read().decode("utf-8", "replace")
    except urllib.error.HTTPError as e:
        fault = e.read().decode("utf-8", "replace")
        em = re.search(r"<errorDescription>([^<]+)", fault) or re.search(r"<errorCode>([^<]+)", fault)
        raise RuntimeError(f"{action} -> HTTP {e.code}: {em.group(1) if em else fault[:200]}")

def lan_ip():
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try: s.connect(("8.8.8.8", 80)); return s.getsockname()[0]  # any routable IP works; never sends data
    finally: s.close()

# Range-capable HTTP/1.1 server. The old `python3 -m http.server` answered HTTP/1.0 200 to every
# request and IGNORED `Range:` headers (no 206, no Accept-Ranges) — the 2013 Sony Bravia REFUSES
# playback ("cannot play"/"playback impossible") without byte-range seeking. This handler speaks
# HTTP/1.1, answers Range with 206 Partial Content, and advertises the DLNA contentFeatures so the
# TV knows seeking is supported. Launched detached; argv[3] is a pgrep marker only. (fix 2026-06-17)
RANGE_SERVER = r'''
import sys, os, re, http.server, socketserver
PORT = int(sys.argv[1]); DIR = sys.argv[2]; os.chdir(DIR)
DLNA = "DLNA.ORG_OP=01;DLNA.ORG_CI=0;DLNA.ORG_FLAGS=01700000000000000000000000000000"
class H(http.server.SimpleHTTPRequestHandler):
    protocol_version = "HTTP/1.1"
    def _dlna_headers(self, ctype):
        self.send_header("Accept-Ranges", "bytes")
        self.send_header("contentFeatures.dlna.org", DLNA)
        self.send_header("transferMode.dlna.org", "Streaming")
        self.send_header("Content-Type", ctype)
    def _send_file(self, head_only=False):
        path = self.translate_path(self.path)
        if not os.path.isfile(path):
            self.send_error(404, "File not found"); return
        size = os.path.getsize(path); ctype = self.guess_type(path)
        rng = self.headers.get("Range")
        if rng and not head_only:
            m = re.match(r"bytes=(\d+)-(\d*)", rng.strip())
            if m:
                start = int(m.group(1)); end = int(m.group(2)) if m.group(2) else size - 1
                end = min(end, size - 1)
                if start > end:
                    self.send_response(416); self.send_header("Content-Range", f"bytes */{size}")
                    self.send_header("Content-Length", "0"); self.end_headers(); return
                length = end - start + 1
                self.send_response(206); self._dlna_headers(ctype)
                self.send_header("Content-Range", f"bytes {start}-{end}/{size}")
                self.send_header("Content-Length", str(length)); self.end_headers()
                with open(path, "rb") as f:
                    f.seek(start); remaining = length
                    while remaining > 0:
                        chunk = f.read(min(262144, remaining))
                        if not chunk: break
                        try: self.wfile.write(chunk)
                        except (BrokenPipeError, ConnectionResetError): return
                        remaining -= len(chunk)
                return
        self.send_response(200); self._dlna_headers(ctype)
        self.send_header("Content-Length", str(size)); self.end_headers()
        if head_only: return
        with open(path, "rb") as f:
            while True:
                chunk = f.read(262144)
                if not chunk: break
                try: self.wfile.write(chunk)
                except (BrokenPipeError, ConnectionResetError): return
    def do_GET(self):  self._send_file(head_only=False)
    def do_HEAD(self): self._send_file(head_only=True)
    def log_message(self, *a): pass
socketserver.ThreadingTCPServer.allow_reuse_address = True
socketserver.ThreadingTCPServer(("", PORT), H).serve_forever()
'''

def serve(directory, port):
    """Ensure a detached Range-capable HTTP/1.1 server for `directory` is running on `port`. REUSE it
    if already up — killing the server mid-stream is what made switching videos restart/break the one
    already playing (operator 2026-06-15). Only (re)start if nothing serves this exact dir+port."""
    marker = f"meshtv-range {port} {directory}"
    out = subprocess.run(["pgrep", "-f", f"meshtv-range {port} {directory}"],
                         capture_output=True, text=True)
    if out.stdout.strip():
        return                      # already serving this dir — leave the live stream alone
    # first transition: retire any old-style `http.server` AND any stale range server on this port
    subprocess.run(["pkill", "-f", f"http.server.*{port}"], capture_output=True)
    subprocess.run(["pkill", "-f", f"meshtv-range.*{port}"], capture_output=True)
    time.sleep(0.5)
    subprocess.Popen([sys.executable, "-c", RANGE_SERVER, str(port), directory, marker],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    time.sleep(1)

def main():
    if len(sys.argv) < 2: log("usage: mesh-tv-dlna <video-url> | --test | --mcast-reason | status | pause | resume | stop"); sys.exit(1)
    arg = sys.argv[1]

    # Diagnostic + test seam: print the exact sentence this tool would give for "no renderer found",
    # WITHOUT a 4s SSDP wait. It runs the production function and the production subprocess call, so
    # an arm driving it exercises the real PATH lookup and the real wording — the two things that
    # were wrong. Kept as a verb rather than an env knob: an env-only seam can be green while the
    # live call site is broken.
    if arg == "--mcast-reason":
        print(no_renderer_reason()); return

    if arg == "--test":
        # 1. yt-dlp must be installed and respond — the hard runtime dep (never checked otherwise)
        r = subprocess.run(["yt-dlp", "--version"], capture_output=True, text=True)
        if r.returncode != 0:
            print("smoke-test: FAIL (yt-dlp not found or broken — required for video download)")
            sys.exit(1)
        ver = r.stdout.strip()
        # 1b. A too-old yt-dlp that lacks a flag we conditionally inject dies at CAST time, not here —
        # --version passes clean while every YouTube cast fails 'no such option'. Assert the injected
        # flag is real WHEN it would be used (node present), so --test goes red on the stale binary
        # instead of the operator's TV going dark (2024.04.09 lacked --js-runtimes, fixed 2026-07-17).
        node_present = subprocess.run(["sh", "-c", "command -v node"], capture_output=True).returncode == 0
        if node_present and not yt_supports("--js-runtimes"):
            print(f"smoke-test: FAIL (yt-dlp={ver} lacks --js-runtimes, which is injected when node is "
                  f"present → YouTube casts die 'no such option'; upgrade yt-dlp)")
            sys.exit(1)
        # ── MULTICAST-PATH wording arms ({#39af3e18}) ──────────────────────────────────────────
        # The defect was never the exit code (rc=2 is the honest organ-absent code, measured by
        # health 2026-08-30 — an earlier rc=0 reading came from a pipe, where rc is the last stage's).
        # It was the WORDING: "TV off or not on WiFi" named a cause nobody measured. So these arms
        # assert the SENTENCE, under a stubbed guard, one state at a time.
        # The stub lives INSIDE a fake HOME's .local/bin AND is first on PATH, and every arm asserts
        # the stub was REACHED — a fence you cannot see fail is not a fence
        # ([[path-stub-cannot-shadow-a-mesh-tool]]).
        import os, tempfile, shutil
        tmp = tempfile.mkdtemp()
        try:
            binn = os.path.join(tmp, ".local", "bin"); os.makedirs(binn)
            hit = os.path.join(tmp, "hit")
            def stub(line):
                pth = os.path.join(binn, "mesh-upnp-census")
                with open(pth, "w") as fh:
                    fh.write("#!/bin/sh\necho reached >> %s\n%s\n" % (hit, ("echo '%s'" % line) if line else "exit 1"))
                os.chmod(pth, 0o755)
                env = dict(os.environ, HOME=tmp, PATH=binn + os.pathsep + os.environ.get("PATH", ""))
                r = subprocess.run([sys.executable, os.path.abspath(__file__), "--mcast-reason"],
                                   capture_output=True, text=True, timeout=30, env=env)
                return r.stdout.strip()
            bad = []
            SW = ("state=swallowed group=239.255.255.250 dev=tun0 lan_dev=lan0 (the group does NOT "
                  "leave by the LAN device)")
            out = stub(SW)
            if not os.path.exists(hit): bad.append("stub was never reached — the guard call does not go through PATH")
            if "BLINDNESS" not in out or "dev=tun0" not in out:
                bad.append("swallowed path did not produce a BLINDNESS sentence naming the device: %r" % out)
            for w in ("TV off", "not on WiFi", "home WiFi"):
                if w in out: bad.append("swallowed path still blames the TV (%r): %r" % (w, out))
            out = stub("state=ok group=239.255.255.250 dev=lan0 lan_dev=lan0 (the group leaves by the LAN device)")
            if "TV off" not in out:
                bad.append("with a HEALTHY multicast path the tool must be entitled to say the TV is off: %r" % out)
            if "BLINDNESS" in out:
                bad.append("healthy path wrongly reported blindness — the arm above proves nothing if both states say the same thing: %r" % out)
            out = stub("")   # guard itself unrunnable (rc 1)
            if "UNKNOWN" not in out or "TV off" in out:
                bad.append("an unavailable guard must render UNKNOWN, never an all-clear about the TV: %r" % out)
            if bad:
                for b in bad: print("smoke-test: FAIL (%s)" % b)
                sys.exit(1)
        finally:
            shutil.rmtree(tmp, ignore_errors=True)
        # ── PROXY BYPASS for LAN HTTP ({#39af3e18}, second half) ───────────────────────────────
        # Two REAL servers, so the arm and its control differ by exactly one thing: which opener.
        #   origin — bound to this node's own LAN address, answering "origin"
        #   proxy  — a stand-in on 127.0.0.1 answering "PROXIED" to anything
        # With http_proxy pointed at the stand-in, the DEFAULT opener must come back "PROXIED" and
        # http_open() must come back "origin". The first draft bound the origin to 127.0.0.1 and the
        # control arm CAUGHT ITSELF: urllib always bypasses proxies for localhost, so both openers
        # succeeded and the whole arm was vacuous. A node with no default-route src cannot run this
        # and says so — it does not quietly pass.
        import http.server, threading, os as _os
        lsrc = lan_src()
        if not lsrc:
            print("smoke-test: note (LAN HTTP proxy-bypass arm SKIPPED — no default-route src to bind an "
                  "off-loopback origin to; the bypass is unverified on this node, not verified-ok)")
        else:
            def _mk(host, body):
                class _H(http.server.BaseHTTPRequestHandler):
                    def do_GET(self):
                        self.send_response(200); self.send_header("Content-Length", str(len(body)))
                        self.end_headers(); self.wfile.write(body)
                    def log_message(self, *a): pass
                srv = http.server.HTTPServer((host, 0), _H)
                threading.Thread(target=srv.serve_forever, daemon=True).start()
                return srv
            origin = _mk(lsrc, b"origin"); proxy = _mk("127.0.0.1", b"PROXIED")
            url = "http://%s:%d/dmr.xml" % (lsrc, origin.server_address[1])
            keys = ("http_proxy", "HTTP_PROXY", "all_proxy", "ALL_PROXY", "no_proxy", "NO_PROXY")
            saved = {k: _os.environ.get(k) for k in keys}
            try:
                for k in keys: _os.environ.pop(k, None)
                _os.environ["http_proxy"] = "http://127.0.0.1:%d/" % proxy.server_address[1]
                pbad = []
                try:
                    got = http_open(url, 5).read()
                    if got != b"origin":
                        pbad.append("http_open did not bypass the proxy (got %r)" % got)
                except Exception as e:
                    pbad.append("http_open raised while bypassing: %s" % e)
                try:
                    ctl = urllib.request.build_opener().open(url, timeout=5).read()
                except Exception as e:
                    ctl = ("<error %s>" % e).encode()
                if ctl != b"PROXIED":
                    pbad.append("CONTROL: the default opener did NOT go through the proxy (got %r) — this "
                                "environment cannot discriminate, so the bypass arm above is vacuous" % ctl)
                if pbad:
                    for x in pbad: print("smoke-test: FAIL (%s)" % x)
                    sys.exit(1)
            finally:
                for k, v in saved.items():
                    if v is None: _os.environ.pop(k, None)
                    else: _os.environ[k] = v
                origin.shutdown(); proxy.shutdown()
        # ── THE PIN'S SOURCE ({#39af3e18}) ─────────────────────────────────────────────────────
        # lan_src() must be the MAIN table's default-route src. `ip route get 239.255.255.250` is the
        # obvious-looking source and is answered by the table doing the swallowing — it returns the
        # TUNNEL's address, so pinning to it pins to the interface being escaped. On a live-swallowed
        # node the two differ and this arm discriminates; where they agree it says so rather than
        # counting a pass. (The applied-arm below cannot cover this: it overrides the value.)
        def _rt(args, key):
            try:
                rr = subprocess.run(args, capture_output=True, text=True, timeout=5)
                for ln in (rr.stdout or "").splitlines():
                    f = ln.split()
                    if key in f: return f[f.index(key) + 1]
            except Exception: pass
            return ""
        _dsrc = _rt(["ip", "route", "show", "default"], "src")
        _gsrc = _rt(["ip", "route", "get", "239.255.255.250"], "src")
        if _dsrc:
            if lan_src() != _dsrc:
                print("smoke-test: FAIL (lan_src is not the main default route's src: %r vs %r)" % (lan_src(), _dsrc)); sys.exit(1)
            if _gsrc and _gsrc != _dsrc and lan_src() == _gsrc:
                print("smoke-test: FAIL (lan_src took the swallowing table's own src %r)" % _gsrc); sys.exit(1)
            if not _gsrc or _gsrc == _dsrc:
                print("smoke-test: note (default-route src and the group lookup agree here — the "
                      "discriminating half of the pin-source arm cannot run on this node)")
        # ── THE PIN IS APPLIED, not merely computed ({#39af3e18}) ──────────────────────────────
        # A pin that is calculated and never passed to setsockopt leaves discovery following the FIB
        # — i.e. exactly the pre-fix behaviour — while every other arm stays green. Drive discover()
        # with an UNASSIGNABLE source and require the failure to be LOUD: if the value never reaches
        # the socket there is nothing to fail on and the warn never appears. (The narrow arm is the
        # right one: "found nothing on a swallowed node" cannot be asserted, because a genuinely-off
        # TV must still be allowed to answer nothing.)
        import io, contextlib, os as _os2
        _sv = _os2.environ.get("MESH_TV_LAN_SRC")
        _os2.environ["MESH_TV_LAN_SRC"] = "203.0.113.9"      # TEST-NET-3, never assignable here
        _buf = io.StringIO()
        try:
            with contextlib.redirect_stdout(_buf): discover()
        except Exception:
            pass
        finally:
            if _sv is None: _os2.environ.pop("MESH_TV_LAN_SRC", None)
            else: _os2.environ["MESH_TV_LAN_SRC"] = _sv
        if "could not pin multicast egress to 203.0.113.9" not in _buf.getvalue():
            print("smoke-test: FAIL (the multicast pin never reached the socket — an unassignable "
                  "source produced no warn, so discovery is still following the FIB: %r)" % _buf.getvalue()[:200])
            sys.exit(1)
        # 2. SSDP discover — checks LAN reachability to the TV (exit 2 = TV off/not found, not a dep failure)
        loc = discover()
        if not loc:
            print(f"smoke-test: n/a (yt-dlp={ver} ok; {no_renderer_reason()})")
            sys.exit(2)
        print(f"smoke-test: ok (yt-dlp={ver}; renderer={loc}; multicast-path wording swallowed/ok/unavailable asserted; LAN HTTP proxy-bypass driven against a live socket with a failing control arm; multicast pin proven APPLIED via an unassignable source and its SOURCE proven to be the main default route)")
        sys.exit(0)

    log("discovering DLNA TV..."); loc = discover()
    if not loc: log("FAIL:", no_renderer_reason()); sys.exit(2)
    log("renderer:", loc)
    ctrl, stype = control_url(loc); log("AVTransport control:", ctrl)
    # status — query CurrentTransportState (PLAYING/STOPPED/PAUSED_PLAYBACK/NO_MEDIA_PRESENT)
    if arg.lower() == "status":
        try:
            r = soap(ctrl, stype, "GetTransportInfo", "<InstanceID>0</InstanceID>")
            m = re.search(r"<CurrentTransportState>([^<]+)</CurrentTransportState>", r)
            state = m.group(1) if m else "UNKNOWN"
            log("transport state:", state); print(state)
        except Exception as e:
            log("GetTransportInfo failed:", e); print("UNKNOWN"); sys.exit(1)
        return
    # playback control verbs — no download, just a SOAP action against the running media
    VERBS = {"pause": ("Pause", ""), "resume": ("Play", "<Speed>1</Speed>"),
             "play": ("Play", "<Speed>1</Speed>"), "stop": ("Stop", "")}
    if arg.lower() in VERBS:
        action, extra = VERBS[arg.lower()]
        try:
            soap(ctrl, stype, action, "<InstanceID>0</InstanceID>" + extra)
            log(f"✅ {arg} sent to TV"); return
        except RuntimeError as e:
            # the 2013 Bravia rejects DLNA Pause → fall back to Sony IRCC IR emulation.
            # IRCC sends an IR code to the TV as if from the remote control.
            # IRCCCode for Pause: AAAAAQAAAAEAAAANAw== (same as remote pause button).
            if action == "Pause":
                tv_ip = loc.split("/")[2].split(":")[0]   # extract IP from discovered location URL
                log(f"DLNA Pause rejected ({e}) — trying Sony IRCC Pause...")
                ircc_env = f'<?xml version="1.0"?><s:Envelope xmlns:s="http://schemas.xmlsoap.org/soap/envelope/" s:encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"><s:Body><u:X_SendIRCC xmlns:u="urn:schemas-sony-com:service:IRCC:1"><IRCCCode>AAAAAQAAAAEAAAANAw==</IRCCCode></u:X_SendIRCC></s:Body></s:Envelope>'
                ircc_req = urllib.request.Request(f"http://{tv_ip}/IRCC", ircc_env.encode(), {
                    "Content-Type": 'text/xml; charset="utf-8"',
                    "SOAPACTION": '"urn:schemas-sony-com:service:IRCC:1#X_SendIRCC"',
                    "X-Auth-PSK": "0000"})
                try:
                    http_open(ircc_req, 6)
                    log("✅ IRCC Pause sent to TV"); return
                except Exception as ie:
                    log(f"IRCC Pause also failed ({ie}) — use the TV remote or re-send the URL"); sys.exit(4)
            raise
    url = arg
    import os, glob, hashlib
    work = os.path.expanduser("~/.mesh/tv"); os.makedirs(work, exist_ok=True)
    # UNIQUE filename per request. The video already playing keeps streaming from ITS OWN file while the
    # new one downloads (we no longer delete the live file), and the new CurrentURI DIFFERS so the TV
    # actually switches — re-setting the identical URI made the old Bravia restart from zero. This is
    # exactly the operator's ask (2026-06-15): "if playback is still going, keep it until it can switch".
    token = hashlib.sha1(f"{url}:{int(time.time())}".encode()).hexdigest()[:10]
    fname = f"v-{token}.mp4"; fpath = os.path.join(work, fname)
    log("downloading (yt-dlp, mp4/h264 <=720 for old TV — old Bravia can't do HTTPS/DASH)...")
    # MUST download + serve plain HTTP: a 2013 TV cannot fetch a modern HTTPS googlevideo/DASH URL.
    # Progressive formats 22 (720p) / 18 (360p) are the reliable fallback: higher adaptive formats now
    # 403 on the CDN fetch (YouTube anti-bot / yt-dlp JS-runtime deprecation, seen 2026-06-17), but the
    # legacy progressive streams still download without an nsig JS runtime — and 360p plays perfectly on
    # the old Bravia (operator: "playback matters, not resolution"). `--js-runtimes node` enables higher
    # formats when a node runtime is present — but ONLY inject it when the running yt-dlp actually knows
    # the flag (yt_supports probes --help): a stale yt-dlp with node present would otherwise die
    # 'no such option: --js-runtimes' and download nothing (2026-07-17).
    fmt = "best[ext=mp4][vcodec^=avc1][height<=720]/best[ext=mp4][height<=720]/22/18/best[ext=mp4]/best"
    ytcmd = ["yt-dlp", "-f", fmt, "--no-playlist", "-o", fpath, url]
    if subprocess.run(["sh", "-c", "command -v node"], capture_output=True).returncode == 0 and yt_supports("--js-runtimes"):
        ytcmd[1:1] = ["--js-runtimes", "node"]
    dl = subprocess.run(ytcmd, capture_output=True, text=True, timeout=600)
    if not os.path.exists(fpath) or os.path.getsize(fpath) == 0:
        log("FAIL: download produced no file\n", dl.stderr[-400:]); sys.exit(3)
    log(f"downloaded {os.path.getsize(fpath)//1024//1024} MB")
    PORT = 8099; ip = lan_ip(); serve(work, PORT)
    surl = f"http://{ip}:{PORT}/{fname}"; log("serving:", surl)
    surl_x = surl.replace("&", "&amp;")
    meta = ('&lt;DIDL-Lite xmlns="urn:schemas-upnp-org:metadata-1-0/DIDL-Lite/" '
            'xmlns:dc="http://purl.org/dc/elements/1.1/" '
            'xmlns:upnp="urn:schemas-upnp-org:metadata-1-0/upnp/"&gt;'
            '&lt;item id="0" parentID="-1" restricted="1"&gt;&lt;dc:title&gt;mesh-tv&lt;/dc:title&gt;'
            '&lt;upnp:class&gt;object.item.videoItem&lt;/upnp:class&gt;'
            f'&lt;res protocolInfo="http-get:*:video/mp4:DLNA.ORG_OP=01;DLNA.ORG_CI=0;DLNA.ORG_FLAGS=01700000000000000000000000000000"&gt;{surl_x}&lt;/res&gt;'
            '&lt;/item&gt;&lt;/DIDL-Lite&gt;')
    log("SetAVTransportURI...")
    soap(ctrl, stype, "SetAVTransportURI", f"<InstanceID>0</InstanceID><CurrentURI>{surl_x}</CurrentURI><CurrentURIMetaData>{meta}</CurrentURIMetaData>")
    time.sleep(1)
    log("Play...")
    soap(ctrl, stype, "Play", "<InstanceID>0</InstanceID><Speed>1</Speed>")
    log("✅ sent to TV — should be playing")
    # NOW the TV has switched — retire the previous downloads so disk doesn't grow. Keep the file just
    # sent (fpath) and skip anything <30s old (an in-flight concurrent download we mustn't yank).
    now_t = time.time()
    for old in glob.glob(os.path.join(work, "v-*.mp4")) + [os.path.join(work, "now.mp4")]:
        if old == fpath:
            continue
        try:
            if not os.path.exists(old) or now_t - os.path.getmtime(old) > 30:
                os.path.exists(old) and os.remove(old)
        except OSError:
            pass

if __name__ == "__main__":
    try: main()
    except Exception as e: log("ERROR:", e); sys.exit(1)
