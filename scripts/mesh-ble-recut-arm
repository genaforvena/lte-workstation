#!/usr/bin/env bash
# mesh-ble-recut-arm — arm the BLE _ble_hard recut once its corpus precondition is MEASURED, not dated.
# reflex-cadence: 23 * * * *
#
# WHY THIS EXISTS: the board has no defer primitive.
# A [task] whose precondition is "48h from now" was posted to the board on 2026-08-24T22:38Z and
# re-dispatched to its owner 13 seconds later, because mesh-mind-control's scan has no not-before /
# snooze / after: token anywhere in it (grepped 2026-08-24: zero hits). A dated obligation left on the
# board is therefore not deferred, it is re-dispatched every dispatch cycle until its date arrives —
# ~48h of paid mind turns, each of which can only re-derive "too early" and post nothing. An
# obligation whose trigger is a CLOCK belongs to a scheduler, not to a board scan that has no clock in
# it; this tool is that scheduler, and the board task is closed until it fires.
#
# AND THE TRIGGER IS THE CORPUS, NOT THE CALENDAR. "2026-08-27T00:00Z" was itself an assumed band: it
# is 48h after the task was WRITTEN, but the RUN rows that form the residency denominator do not begin
# until mesh-land deploys the tape_ble_rssi run-row fix, which had not landed at that time (the live
# tape held 18 device rows and ZERO RUN rows). So the date could arrive with the window still empty.
# This tool gates on what the corpus actually holds:
#
#   span     = last RUN row - FIRST RUN row  (never the file's mtime, never the device rows)
#   cadence  = the RUN-row writer's OWN DECLARED cadence (mesh-room-sense's `# reflex-cadence:`
#              header), falling back to the smallest observed inter-row gap, and the reading names
#              which source it used
#   coverage = observed RUN rows / (span / cadence) — a span of 48h spanned by two rows is a dead
#              reflex, not a window; a bare span cannot tell those apart
#
# THE CADENCE MUST NOT BE THE MEDIAN OF THE GAPS, and this is the whole trap: a median (or any other
# central statistic) of the observed gaps ADAPTS TO THE HOLES it is supposed to expose. Two rows 49h
# apart have a median gap of 49h, so expected==observed and coverage reads a perfect 1.000; drop two
# of every three runs and the median simply becomes 15min and coverage reads 1.000 again. Both were
# measured going green against the first cut of this file. A coverage denominator has to come from
# OUTSIDE the sample it is judging — the writer's declaration, or at worst the tightest spacing the
# writer ever achieved. The min-gap fallback still has one honest blind spot, asserted in --test
# rather than papered over: it catches a tape that ran and went DARK, but UNIFORM thinning leaves no
# tight gap to compare against and re-reads as a slower writer. That is why every reading names its
# `cadence_src=`; a `measured-min` window is a weaker claim than a `declared` one.
#
# The tape is TAIL-TRIMMED (sliding window, ~5000 rows ≈ 4 days at the observed cadence), so once the
# real first row ages out, `first_run` becomes LATER than the true deploy instant and the span reads
# SHORTER. The gate therefore under-claims as the window slides — it can be late, never early.
#
# State (published in every reading, and rc):
#   undeployed   0 RUN rows — the denominator fix is not live yet. UNKNOWN coverage, never "no runs".
#   accumulating span < need
#   sparse       span ok, coverage below floor — the window exists but the writer was mostly dark
#   armed        gate met, [task] posted this run
#   posted       gate met, already posted (marker present) — idempotent, never a second obligation
set -uo pipefail

TAPE="${MESH_ROOM_BLE_TAPE:-$HOME/.mesh/room-sense-ble-rssi-tape.log}"
MARK="${MESH_BLE_RECUT_MARK:-$HOME/.mesh/.ble-recut-armed}"
NEED_H="${MESH_BLE_RECUT_NEED_H:-48}"
# Coverage floor: NOT a threshold of the classifier this arms (those must come from the live corpus
# via mesh-series-stats --claims, per the task). This is a floor on the WINDOW's own honesty — how
# much of the span the writer was actually awake for — and it is published in the reading either way.
COV_FLOOR="${MESH_BLE_RECUT_COV_FLOOR:-0.5}"
# Where the DECLARED cadence is read from — the writer's own header, never a number typed here.
CAD_SRC_FILE="${MESH_BLE_RECUT_CADENCE_FILE:-$(command -v mesh-room-sense 2>/dev/null || echo "$HOME/lte-workstation/scripts/mesh-room-sense")}"

# NO BACKTICKS IN THIS STRING: mesh-chat command-substitutes them (memory
# mesh-chat-executes-backticks-in-the-message), so a backticked identifier here would be RUN, not
# posted, and the board would carry its output instead of the obligation.
TASK_TEXT='[task] room-sense-ble-hard-on-movement-recut: the BLE residency corpus now holds the window (see fields below). Replace _ble_hard'"'"'s NAME test in mesh-room-sense (the ble_nameless_only leg) with a MOVEMENT/persistence test per MAC: RSSI variance + continuous-residency, residency = seen-runs over RUN rows in the window, degraded RUN rows EXCLUDED from the denominator rather than counted as absence. A device resident and flat for days is furniture whatever it is called. Derive BOTH thresholds from the live corpus with mesh-series-stats --claims and bind the CLAIM, never a quoted constant. owner: mesh-land/senses'

# declared_cadence_min — the RUN-row writer's own `# reflex-cadence:` minute field, as minutes.
# Empty when it cannot be read; the caller then falls back and SAYS so.
declared_cadence_min() {
  local line f n
  [ -r "$CAD_SRC_FILE" ] || return 1
  line="$(grep -m1 -E '^#[[:space:]]*reflex-cadence:' "$CAD_SRC_FILE" 2>/dev/null)" || return 1
  f="$(printf '%s' "$line" | sed -E 's/^#[[:space:]]*reflex-cadence:[[:space:]]*//' | awk '{print $1}')"
  [ -n "$f" ] || return 1
  case "$f" in
    */*) printf '%s' "${f##*/}"; return 0 ;;                 # 2-59/5 -> 5
    '*') printf '1'; return 0 ;;
    *)   n="$(printf '%s' "$f" | tr ',' '\n' | grep -c '')"  # 8,28,48 -> 3 fires/hour -> 20min
         [ "${n:-0}" -gt 0 ] || return 1
         awk -v n="$n" 'BEGIN{printf "%.2f", 60/n}'; return 0 ;;
  esac
}

# read_tape → sets RUN_N SPAN_H CADENCE_M CAD_SRC COV FIRST LAST; rc 2 when no RUN rows exist.
read_tape() {
  RUN_N=0; SPAN_H="na"; CADENCE_M="na"; CAD_SRC="na"; COV="na"; FIRST="na"; LAST="na"
  [ -r "$TAPE" ] || return 2
  local eps
  eps="$(grep -P '\tRUN\t' "$TAPE" 2>/dev/null | cut -f1 \
        | while read -r t; do date -u -d "$t" +%s 2>/dev/null; done)"
  [ -n "$eps" ] || return 2
  RUN_N="$(printf '%s\n' "$eps" | grep -c '')"
  FIRST="$(printf '%s\n' "$eps" | head -1)"
  LAST="$(printf '%s\n' "$eps" | tail -1)"
  local span=$(( LAST - FIRST ))
  FIRST="$(date -u -d "@$FIRST" +%Y-%m-%dT%H:%M:%SZ)"
  LAST="$(date -u -d "@$LAST" +%Y-%m-%dT%H:%M:%SZ)"
  SPAN_H="$(awk -v s="$span" 'BEGIN{printf "%.2f", s/3600}')"
  if CADENCE_M="$(declared_cadence_min)" && [ -n "$CADENCE_M" ]; then
    CAD_SRC="declared"
  elif [ "$RUN_N" -ge 2 ]; then
    # Fallback: the TIGHTEST spacing the writer ever achieved. Not central — a minimum cannot be
    # moved by adding holes, so a sparse window still reads sparse.
    CADENCE_M="$(printf '%s\n' "$eps" | awk 'NR>1{d=$1-p; if(m==""||d<m)m=d} {p=$1} END{if(m==""){print "na"}else{printf "%.2f", m/60}}')"
    CAD_SRC="measured-min"
  else
    CADENCE_M="na"; CAD_SRC="unknown"
  fi
  [ "$CADENCE_M" != "na" ] || return 0
  COV="$(awk -v n="$RUN_N" -v s="$span" -v c="$CADENCE_M" \
    'BEGIN{ if(c+0<=0||s<=0){print "na";exit} e=s/(c*60)+1; printf "%.3f", (e>0)? n/e : 0 }')"
  return 0
}

verdict() {
  local rc
  read_tape; rc=$?
  if [ "$rc" = 2 ]; then STATE="undeployed"; return 0; fi
  if awk -v a="$SPAN_H" -v b="$NEED_H" 'BEGIN{exit !(a+0 < b+0)}'; then STATE="accumulating"; return 0; fi
  if [ "$COV" = "na" ] || awk -v a="$COV" -v b="$COV_FLOOR" 'BEGIN{exit !(a+0 < b+0)}'; then
    STATE="sparse"; return 0; fi
  if [ -e "$MARK" ]; then STATE="posted"; else STATE="armed"; fi
  return 0
}

render() {
  printf '%s ble-recut-arm state=%s run_rows=%s first_run=%s last_run=%s span_h=%s need_h=%s cadence_min=%s cadence_src=%s coverage=%s cov_floor=%s tape=%s\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$STATE" "$RUN_N" "$FIRST" "$LAST" "$SPAN_H" "$NEED_H" "$CADENCE_M" "$CAD_SRC" "$COV" "$COV_FLOOR" "$TAPE"
}

case "${1:-}" in
  --help|-h) sed -n '2,40p' "$0"; exit 0 ;;
  --status)  verdict; render; exit 0 ;;
  --test)    ;;
  "")        ;;
  *) echo "mesh-ble-recut-arm: unknown option '$1'" >&2; exit 64 ;;
esac

if [ "${1:-}" != "--test" ]; then
  verdict
  render
  if [ "$STATE" = "armed" ]; then
    mesh-chat "$TASK_TEXT [corpus: run_rows=$RUN_N span_h=$SPAN_H cadence_min=$CADENCE_M/$CAD_SRC coverage=$COV first_run=$FIRST]" \
      && : > "$MARK"
    mesh-trace "ble-recut armed: span_h=$SPAN_H coverage=$COV run_rows=$RUN_N — recut task posted" 2>/dev/null || true
  fi
  exit 0
fi

# ---------------------------------------------------------------- --test
_f=0
_t="$(mktemp -d)"; trap 'rm -rf "$_t"' EXIT
_mk() { # _mk <file> <n_rows> <start_epoch> <step_sec>
  local f="$1" n="$2" s="$3" st="$4" i
  : > "$f"
  for ((i=0;i<n;i++)); do
    printf '%s\tRUN\tok\t2/1\n' "$(date -u -d "@$((s+i*st))" +%Y-%m-%dT%H:%M:%SZ)" >> "$f"
    printf '%s\tAA:BB:CC:DD:EE:FF\tThing\t-60\n' "$(date -u -d "@$((s+i*st))" +%Y-%m-%dT%H:%M:%SZ)" >> "$f"
  done
}
_now=$(date -u +%s)
# A stand-in for the RUN-row writer's header, so the declared-cadence leg does not depend on
# whichever mesh-room-sense happens to be on this node's PATH.
printf '#!/usr/bin/env bash\n# reflex-cadence: 2-59/5 * * * *\n' > "$_t/writer5"
printf '#!/usr/bin/env bash\n# reflex-cadence: 8,28,48 * * * *\n' > "$_t/writer20"
CAD_SRC_FILE="$_t/writer5"

# arm 1 — no RUN rows at all (device rows only) is UNDEPLOYED, never "the runs did not happen"
TAPE="$_t/a.log"; MARK="$_t/a.mark"
printf '2026-08-24T22:05:13Z\tAA:BB:CC:DD:EE:FF\tThing\t-60\n' > "$TAPE"
verdict
[ "$STATE" = "undeployed" ] && [ "$RUN_N" = 0 ] && [ "$COV" = "na" ] \
  || { echo "  FAIL undeployed: state=$STATE run_rows=$RUN_N coverage=$COV"; _f=1; }
[ -e "$MARK" ] && { echo "  FAIL undeployed: marker written"; _f=1; }

# arm 2 — a short window is ACCUMULATING, and it must not post
TAPE="$_t/b.log"; MARK="$_t/b.mark"
_mk "$TAPE" 12 $((_now-3600)) 300
verdict
[ "$STATE" = "accumulating" ] || { echo "  FAIL accumulating: state=$STATE span_h=$SPAN_H"; _f=1; }

# arm 3 — a 49h SPAN spanned by TWO rows is a dead reflex, not a window: SPARSE, and it must not
#         post. This is the leg a span-only gate cannot go red on, and the leg a MEDIAN-derived
#         cadence cannot go red on either (median gap == the whole span => coverage 1.000).
TAPE="$_t/c.log"; MARK="$_t/c.mark"
_mk "$TAPE" 2 $((_now-50*3600)) $((49*3600))
verdict
[ "$STATE" = "sparse" ] || { echo "  FAIL sparse: state=$STATE span_h=$SPAN_H coverage=$COV"; _f=1; }
awk -v a="$SPAN_H" 'BEGIN{exit !(a+0 >= 48)}' \
  || { echo "  FAIL sparse: span should exceed need, got $SPAN_H"; _f=1; }
awk -v c="$COV" 'BEGIN{exit !(c+0 < 0.01)}' \
  || { echo "  FAIL sparse: two rows over 49h must read near-zero coverage, got $COV"; _f=1; }

# arm 4 — a full, dense 50h window ARMS, cadence taken from the writer's DECLARED header
TAPE="$_t/d.log"; MARK="$_t/d.mark"
_mk "$TAPE" 600 $((_now-50*3600)) 300
verdict
[ "$STATE" = "armed" ] || { echo "  FAIL armed: state=$STATE span_h=$SPAN_H coverage=$COV"; _f=1; }
[ "$CAD_SRC" = "declared" ] || { echo "  FAIL armed: cadence source should be declared, got $CAD_SRC"; _f=1; }
awk -v c="$CADENCE_M" 'BEGIN{exit !(c+0 > 4.9 && c+0 < 5.1)}' \
  || { echo "  FAIL armed: declared cadence should be 5min, got $CADENCE_M"; _f=1; }
awk -v c="$COV" 'BEGIN{exit !(c+0 > 0.9)}' \
  || { echo "  FAIL armed: dense window coverage should be ~1, got $COV"; _f=1; }

# arm 5 — HALF-DARK: two of every three runs missing at the same span reads SPARSE. A median-derived
#         cadence would have re-fitted itself to 15min here and called it a perfect window.
TAPE="$_t/e.log"; MARK="$_t/e.mark"
_mk "$TAPE" 600 $((_now-50*3600)) 300
awk 'NR%6<2' "$TAPE" > "$TAPE.k" && mv "$TAPE.k" "$TAPE"
verdict
[ "$STATE" = "sparse" ] || { echo "  FAIL dark-window: state=$STATE coverage=$COV"; _f=1; }
awk -v c="$COV" 'BEGIN{exit !(c+0 > 0.28 && c+0 < 0.40)}' \
  || { echo "  FAIL dark-window: 1-in-3 coverage should read ~0.33, got $COV"; _f=1; }

# arm 6 — the declared cadence is PARSED, not assumed: a list-form header (3 fires/hour) yields 20min,
#         so a 20-min-cadence writer is not accused of a 4x hole
CAD_SRC_FILE="$_t/writer20"
TAPE="$_t/f.log"; MARK="$_t/f.mark"
_mk "$TAPE" 150 $((_now-50*3600)) 1200
verdict
[ "$STATE" = "armed" ] || { echo "  FAIL list-cadence: state=$STATE cadence=$CADENCE_M coverage=$COV"; _f=1; }
awk -v c="$CADENCE_M" 'BEGIN{exit !(c+0 > 19.9 && c+0 < 20.1)}' \
  || { echo "  FAIL list-cadence: expected 20min, got $CADENCE_M"; _f=1; }

# arm 7 — no declared header reachable → the fallback is the TIGHTEST observed gap, named as such.
#         It catches a tape that RAN and then went dark (min gap survives the hole)...
CAD_SRC_FILE="$_t/nofile"
TAPE="$_t/g.log"; MARK="$_t/g.mark"
_mk "$TAPE" 200 $((_now-50*3600)) 300          # ~16.6h dense, then nothing until the closing row
printf '%s\tRUN\tok\t2/1\n' "$(date -u -d "@$_now" +%Y-%m-%dT%H:%M:%SZ)" >> "$TAPE"
verdict
[ "$CAD_SRC" = "measured-min" ] || { echo "  FAIL fallback: cadence source=$CAD_SRC"; _f=1; }
awk -v c="$CADENCE_M" 'BEGIN{exit !(c+0 > 4.9 && c+0 < 5.1)}' \
  || { echo "  FAIL fallback: tightest gap should be 5min, got $CADENCE_M"; _f=1; }
[ "$STATE" = "sparse" ] || { echo "  FAIL fallback: ran-then-went-dark should be sparse, got $STATE ($COV)"; _f=1; }

# arm 7b — ...and it is BLIND to UNIFORM thinning, which is the honest limit of a min-gap denominator:
#          decimate every tick evenly and there is no tight gap left to compare against, so the same
#          half-dark tape that the DECLARED cadence called sparse (arm 5) arms here. Asserted, not
#          hidden — this is exactly why `cadence_src=` is published in every reading.
TAPE="$_t/e.log"; MARK="$_t/e2.mark"
verdict
[ "$CAD_SRC" = "measured-min" ] && [ "$STATE" = "armed" ] \
  || { echo "  FAIL fallback-blindspot: expected measured-min/armed, got $CAD_SRC/$STATE"; _f=1; }
awk -v c="$CADENCE_M" 'BEGIN{exit !(c+0 > 14.9 && c+0 < 15.1)}' \
  || { echo "  FAIL fallback-blindspot: uniform thinning should re-read as a 15min cadence, got $CADENCE_M"; _f=1; }
CAD_SRC_FILE="$_t/writer5"

# arm 8 — IDEMPOTENCE: the marker turns armed into posted, so a second cron tick mints no second task
TAPE="$_t/d.log"; MARK="$_t/d.mark"; : > "$MARK"
verdict
[ "$STATE" = "posted" ] || { echo "  FAIL idempotent: state=$STATE"; _f=1; }

# arm 9 — an unreadable tape is UNDEPLOYED/UNKNOWN, never an armed post off a missing corpus
TAPE="$_t/nope.log"; MARK="$_t/g.mark"
verdict
[ "$STATE" = "undeployed" ] || { echo "  FAIL missing-tape: state=$STATE"; _f=1; }

# arm 10 — the reading always publishes its coverage terms AND names its cadence source
TAPE="$_t/b.log"; MARK="$_t/b.mark"; verdict
render | grep -q 'run_rows=.*span_h=.*cadence_min=.*cadence_src=.*coverage=.*cov_floor=' \
  || { echo "  FAIL render: coverage terms missing from the reading"; _f=1; }

[ "$_f" = 0 ] || { echo "smoke-test: FAILED"; exit 1; }
echo "smoke-test: ok (11 arms: undeployed-vs-no-runs + accumulating + two-rows-over-49h-sparse + armed-dense-declared-cadence + half-dark-1-in-3-sparse + list-form-cadence-parsed-20min + no-header-falls-back-to-tightest-gap-catches-a-hole + fallback-is-blind-to-uniform-thinning + idempotent-marker + missing-tape-unknown + coverage-terms-and-cadence-source-always-published)"
exit 0
