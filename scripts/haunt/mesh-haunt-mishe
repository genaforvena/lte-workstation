#!/usr/bin/env python3
"""Source-pinned offline haunt replay for an isolated mishe observation site."""
import hashlib
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile

HOOK = Path(sys.argv[0]).absolute()
SITE = Path(os.environ.get("MESH_HAUNT_MISHE_HOME", HOOK.parent.parent if HOOK.parent.name in ("top-pains", "projectors") else Path.home() / ".mesh/mishe-haunt"))
CONTRACT = SITE / "plans/haunt.json"
FAMILIES = ("neutral", "assent", "identity", "provenance")
EXPECTED = {"neutral": "NULL", "assent": "BLIND", "identity": "BLIND", "provenance": "BLIND"}


def digest(raw):
    return hashlib.sha256(raw).hexdigest()


def document(path, maximum):
    if path.is_symlink():
        raise ValueError(f"symlink source: {path}")
    raw = path.read_bytes()
    if not 0 < len(raw) <= maximum:
        raise ValueError(f"source absent or oversized: {path}")
    return raw


def contract():
    cfg = json.loads(document(CONTRACT, 8192))
    if (not isinstance(cfg, dict)
            or set(cfg) != {"version", "repo", "tape", "tape_sha256", "replay_sha256", "code_sha256", "evidence"}
            or cfg["version"] != 1 or not isinstance(cfg["code_sha256"], dict)):
        raise ValueError("invalid pinned replay contract")
    for value in (cfg["tape_sha256"], cfg["replay_sha256"], *cfg["code_sha256"].values()):
        if not isinstance(value, str) or re.fullmatch(r"[a-f0-9]{64}", value) is None:
            raise ValueError("invalid source digest")
    repo = Path(cfg["repo"]).resolve(strict=True)
    code = {f"cryptohaunt/{path.name}" for path in (repo / "cryptohaunt").glob("*.py")}
    code.add("protocol/design-manifest.json")
    if set(cfg["code_sha256"]) != code:
        raise ValueError("replay package differs from frozen code manifest")
    if not isinstance(cfg["tape"], str):
        raise ValueError("invalid tape path")
    tape = repo / cfg["tape"]
    if (tape.resolve(strict=True) != tape or not tape.is_relative_to(repo / "runs")
            or not repo.is_dir()):
        raise ValueError("tape must be a regular file under the repository runs directory")
    evidence = Path(cfg["evidence"])
    if not evidence.is_absolute() or evidence.is_symlink():
        raise ValueError("evidence root must be an absolute non-symlink directory")
    return cfg, repo, tape, evidence


def sources():
    cfg, repo, tape, evidence = contract()
    if digest(document(tape, 2 * 1024 * 1024)) != cfg["tape_sha256"]:
        raise ValueError("tape digest differs from frozen source")
    for name in cfg["code_sha256"]:
        if digest(document(repo / name, 1024 * 1024)) != cfg["code_sha256"][name]:
            raise ValueError(f"replay code digest differs: {name}")
    identity = digest(json.dumps({"tape": cfg["tape_sha256"], "code": cfg["code_sha256"]}, sort_keys=True).encode())
    return cfg, repo, tape, evidence / "reports" / f"{identity}.json", identity


def replay(repo, tape):
    env = dict(os.environ, PYTHONPATH=str(repo), PYTHONDONTWRITEBYTECODE="1")
    result = subprocess.run([sys.executable, "-m", "cryptohaunt", "replay", str(tape)],
                            cwd=repo, env=env, stdin=subprocess.DEVNULL,
                            capture_output=True, timeout=30)
    if result.returncode or result.stderr or not 0 < len(result.stdout) <= 16384:
        raise ValueError(f"offline replay failed: exit={result.returncode}")
    text = result.stdout.decode("utf-8", "strict")
    if "replayed from tape (30 complete rep(s)): derailed" not in text:
        raise ValueError("replay completeness changed")
    verdicts = {}
    for line in text.splitlines():
        fields = line.split()
        if fields and fields[0] in FAMILIES:
            name = fields[0]
            if name in verdicts or len(fields) < 8:
                raise ValueError("duplicate or malformed replay family")
            verdicts[name] = fields[-1]
    if verdicts != EXPECTED:
        raise ValueError(f"replay verdicts differ from frozen BLIND/NULL contract: {verdicts}")
    if not all(f"{name}: " in text for name in FAMILIES):
        raise ValueError("coverage/power explanations missing")
    return text


def packet():
    cfg, repo, tape, target, identity = sources()
    text = replay(repo, tape)
    if digest(text.encode()) != cfg["replay_sha256"]:
        raise ValueError("replay output differs from frozen aggregate")
    if sources()[-1] != identity:
        raise ValueError("sources changed while replaying")
    body = {"version": 1, "identity": identity, "tape_sha256": cfg["tape_sha256"],
            "code_sha256": cfg["code_sha256"], "verdicts": EXPECTED,
            "replay_sha256": digest(text.encode()), "replay": text}
    raw = (json.dumps(body, sort_keys=True, ensure_ascii=False, separators=(",", ":")) + "\n").encode()
    return target, raw, body


def write_immutable(target, raw):
    target.parent.mkdir(parents=True, exist_ok=True)
    if target.is_symlink():
        raise ValueError("report symlink")
    if target.exists():
        if target.read_bytes() != raw:
            raise ValueError("report identity collision")
        return
    fd, temporary = tempfile.mkstemp(prefix=".haunt-", dir=target.parent)
    try:
        with os.fdopen(fd, "wb") as stream:
            stream.write(raw)
            stream.flush()
            os.fsync(stream.fileno())
        try:
            os.link(temporary, target)
        except FileExistsError:
            if target.is_symlink() or target.read_bytes() != raw:
                raise ValueError("report identity collision")
    finally:
        Path(temporary).unlink(missing_ok=True)


def checked(rerun=False):
    cfg, repo, tape, target, identity = sources()
    data = json.loads(document(target, 32768))
    if (not isinstance(data, dict)
            or set(data) != {"version", "identity", "tape_sha256", "code_sha256", "verdicts", "replay_sha256", "replay"}
            or data["version"] != 1 or data["identity"] != identity
            or data["tape_sha256"] != cfg["tape_sha256"] or data["code_sha256"] != cfg["code_sha256"]
            or data["verdicts"] != EXPECTED or not isinstance(data["replay"], str)
            or data["replay_sha256"] != cfg["replay_sha256"]
            or digest(data["replay"].encode()) != data["replay_sha256"]):
        raise ValueError("report is not linked to current sources and verdicts")
    if rerun:
        if replay(repo, tape) != data["replay"] or sources()[-1] != identity:
            raise ValueError("offline replay or source identity differs from archived report")
    return target, data


def render():
    print("DESIRED STATE: pinned offline three-arm replay; no BLIND promoted to a finding")
    try:
        target, data = checked()
        print(f"STATE: PASS; tape_sha256={data['tape_sha256']}; report={target}")
        print("neutral NULL (29% MDE); assent BLIND (48% treatment coverage); identity BLIND (29% treatment coverage); provenance BLIND (0% control coverage)")
        print("NEXT: no provider call or claim; owner must resolve coverage before any H2 conclusion")
    except (OSError, ValueError, KeyError, TypeError, UnicodeError, json.JSONDecodeError) as exc:
        print(f"STATE: UNKNOWN; {type(exc).__name__}: {exc}")
        print("NEXT: inspect pinned source, report, and current owner; do not dispatch a model")
    print("AUTHORITY: read-only offline sidecar; legacy haunt pane, repo, task ledger and provider unchanged")


def project(previous, current):
    lines = Path(current).read_text(encoding="utf-8").splitlines()
    status = [line for line in lines if line.startswith("STATE: ")]
    if len(status) != 1:
        raise ValueError("missing or duplicate state")
    if status[0].startswith("STATE: PASS;"):
        print("haunt offline replay PASS: neutral NULL, three BLIND; no H2 finding")
    else:
        print("haunt offline replay UNKNOWN: pinned source or artifact needs review")


def judge():
    request = sys.stdin.read()
    question = request.splitlines()[0].removeprefix("QUESTION ")
    evidence = request.partition("\n\nEVIDENCE\n")[2]
    if question == "publish":
        value = 1 if ("new probe reports UNKNOWN" in evidence or "haunt offline replay" in evidence) else 0 if "stable reading is unchanged" in evidence else None
    elif question == "relevance":
        value = 1 if ("temperature sensor failed" in evidence or "haunt offline replay" in evidence) else 0 if "unrelated music fixture" in evidence else None
    elif question == "valid-attempt":
        value = 1 if all(item in evidence for item in ("Hypothesis:", "Attempt:", "Expected:", "Check at:")) else 0 if "no observable condition" in evidence else None
    elif question == "continue-observing":
        value = 1 if "expected intermediate value is present" in evidence else 0 if "contradicts the prediction" in evidence else None
    elif question == "prediction-met":
        value = 1 if "Fresh check output equals" in evidence else 0 if "old error" in evidence else None
    elif question == "desired-state-met":
        value = 1 if ("STATE: PASS;" in request or "stdout: reading=42" in evidence) else 0 if "stdout: reading=41" in evidence else None
    else:
        value = None
    print(f"probability {value:.1f}" if value is not None else "unknown outside source-pinned replay")


def main():
    invoked = Path(sys.argv[0])
    mode = "judge" if invoked.name == "judge" else {"top-pains": "render", "projectors": "project"}.get(
        invoked.parent.name, sys.argv[1] if len(sys.argv) > 1 else "")
    if mode == "render":
        render()
    elif mode == "project":
        project(sys.argv[1], sys.argv[2])
    elif mode == "judge":
        judge()
    elif mode == "replay":
        target, raw, body = packet()
        write_immutable(target, raw)
        print(json.dumps({"report": str(target), "identity": body["identity"], "verdicts": body["verdicts"]}, sort_keys=True))
    elif mode == "verify":
        target, data = checked(rerun=True)
        print(json.dumps({"report": str(target), "identity": data["identity"], "verdicts": data["verdicts"]}, sort_keys=True))
    else:
        raise ValueError("usage: mesh-haunt-mishe replay|verify|render|judge")


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, KeyError, TypeError, UnicodeError, json.JSONDecodeError, subprocess.TimeoutExpired) as exc:
        print(f"UNKNOWN haunt offline replay: {type(exc).__name__}: {exc}", file=sys.stderr)
        raise SystemExit(2)
