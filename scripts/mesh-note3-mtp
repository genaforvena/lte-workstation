#!/usr/bin/env bash
# mesh-note3-mtp — read the Note3 internal storage over USB-MTP without leaving a mount behind.
#
# The live path mounts with jmtpfs, inventories the browsable Phone/ tree, records the result in
# a mesh-local evidence artifact, and always unmounts on exit. --test uses a throwaway tree so the
# gate proves the inventory logic without pretending a fixture is a phone read.
set -euo pipefail
export PATH="$HOME/.local/bin:$PATH"

MOUNTPOINT="${MESH_NOTE3_MTP_MOUNTPOINT:-${TMPDIR:-/tmp}/mesh-note3-mtp}"
ARTIFACT=""
ROOT_OVERRIDE=""

usage() {
  echo "usage: $0 [--mountpoint PATH] [--artifact PATH] [--root PATH]"
  echo "       $0 --test"
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --mountpoint) [ "$#" -ge 2 ] || { usage >&2; exit 2; }; MOUNTPOINT="$2"; shift 2 ;;
    --artifact) [ "$#" -ge 2 ] || { usage >&2; exit 2; }; ARTIFACT="$2"; shift 2 ;;
    --root) [ "$#" -ge 2 ] || { usage >&2; exit 2; }; ROOT_OVERRIDE="$2"; shift 2 ;;
    --test)
      td="$(mktemp -d "${TMPDIR:-/tmp}/mesh-note3-mtp-test.XXXXXX")"
      mkdir -p "$td/Phone/DCIM/Camera" "$td/Phone/Music" "$td/Phone/Download"
      : > "$td/Phone/DCIM/Camera/sample.jpg"
      : > "$td/Phone/mesh-voice-20260919.mp3"
      test_rc=0
      MESH_NOTE3_MTP_TEST_ROOT="$td" "$0" --root "$td" --artifact "$td/result.txt" || test_rc=$?
      rm -rf "$td"
      exit "$test_rc"
      ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
  esac
done

stamp() { date -u +%FT%TZ; }

inventory() {
  local root="$1" phone="$1/Phone" dirs dcim_files voice_files
  [ -d "$phone" ] || { echo "mesh-note3-mtp: Phone/ is absent" >&2; return 2; }
  dirs="$(find "$phone" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort)"
  dcim_files="$(find "$phone/DCIM" -type f -printf '%P\t%s\n' 2>/dev/null | sort || true)"
  voice_files="$(find "$phone" -maxdepth 1 -type f -name 'mesh-voice-*.mp3' -printf '%P\t%s\n' | sort)"
  printf 'timestamp=%s\n' "$(stamp)"
  printf 'root=%s\n' "$root"
  printf 'phone_dirs=%s\n' "$(printf '%s\n' "$dirs" | sed '/^$/d' | wc -l)"
  printf 'phone_dir_names=%s\n' "$(printf '%s' "$dirs" | paste -sd, -)"
  printf 'dcim_files=%s\n' "$(printf '%s\n' "$dcim_files" | sed '/^$/d' | wc -l)"
  printf 'dcim_inventory=%s\n' "$(printf '%s' "$dcim_files" | paste -sd, -)"
  printf 'voice_files=%s\n' "$(printf '%s\n' "$voice_files" | sed '/^$/d' | wc -l)"
  printf 'voice_inventory=%s\n' "$(printf '%s' "$voice_files" | paste -sd, -)"
}

if [ -n "$ROOT_OVERRIDE" ]; then
  out="$(inventory "$ROOT_OVERRIDE")"
  printf '%s\n' "$out"
  if [ -n "$ARTIFACT" ]; then mkdir -p "$(dirname -- "$ARTIFACT")"; printf '%s\n' "$out" > "$ARTIFACT"; fi
  if [ -n "${MESH_NOTE3_MTP_TEST_ROOT:-}" ]; then
    printf '%s\n' "$out" | grep -q '^phone_dirs=3$' || { echo 'mesh-note3-mtp: --test wrong Phone/ count' >&2; exit 1; }
    printf '%s\n' "$out" | grep -q '^dcim_files=1$' || { echo 'mesh-note3-mtp: --test wrong DCIM count' >&2; exit 1; }
    printf '%s\n' "$out" | grep -q '^voice_files=1$' || { echo 'mesh-note3-mtp: --test wrong voice count' >&2; exit 1; }
    echo 'mesh-note3-mtp: --test PASS'
  fi
  exit 0
fi

command -v jmtpfs >/dev/null 2>&1 || { echo 'mesh-note3-mtp: jmtpfs unavailable' >&2; exit 2; }
command -v fusermount >/dev/null 2>&1 || { echo 'mesh-note3-mtp: fusermount unavailable' >&2; exit 2; }
command -v mountpoint >/dev/null 2>&1 || { echo 'mesh-note3-mtp: mountpoint unavailable' >&2; exit 2; }
if mountpoint -q "$MOUNTPOINT" 2>/dev/null; then
  echo "mesh-note3-mtp: refusing pre-existing mountpoint $MOUNTPOINT" >&2
  exit 2
fi
mkdir -p "$MOUNTPOINT"
mounted=0
cleanup() {
  if [ "$mounted" -eq 1 ]; then
    fusermount -u "$MOUNTPOINT" >/dev/null 2>&1 || { echo "mesh-note3-mtp: unmount failed for $MOUNTPOINT" >&2; exit 1; }
    mountpoint -q "$MOUNTPOINT" 2>/dev/null && { echo "mesh-note3-mtp: mount remained after unmount" >&2; exit 1; }
  fi
  rmdir "$MOUNTPOINT" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

jmtpfs "$MOUNTPOINT" >/dev/null 2>&1 || { echo 'mesh-note3-mtp: jmtpfs mount failed' >&2; exit 1; }
mounted=1
out="$(inventory "$MOUNTPOINT")"
if [ -z "$ARTIFACT" ]; then
  ARTIFACT="${HOME}/.mesh/evidence/note3-mtp-$(date -u +%Y%m%dT%H%M%SZ).txt"
fi
mkdir -p "$(dirname -- "$ARTIFACT")"
printf '%s\n' "$out" | tee "$ARTIFACT"
echo "mesh-note3-mtp: read artifact=$ARTIFACT"
