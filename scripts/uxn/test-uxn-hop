#!/usr/bin/env bash
# test-uxn-hop — RED-first suite for mesh-uxn-hop (ROM-as-packet pipe stage, uxp1 format).
#
# The claim under test: the CODE travels with the DATA. A hop receives
# "uxp1 <n>\n" + <n rom bytes> + payload, executes the shipped ROM on the payload
# in a fresh empty dir (the file-device sandbox floor), and fails LOUD on any
# malformed packet — never a silent passthrough (the silent-fallback doctrine).
set -u
here="$(cd "$(dirname "$0")" && pwd)"
cd "$here"
[ -x bin/uxncli ] || ./build.sh >/dev/null
[ -f rot13.rom ] || ./bin/uxnasm rot13.tal rot13.rom >/dev/null
rc=0
hop=./mesh-uxn-hop
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

# 1) pack format: exact header (size + declared sha1), exact byte accounting
n=$(wc -c <rot13.rom)
printf 'seven b' | $hop --pack rot13.rom >"$tmp/pkt"
head -1 "$tmp/pkt" | grep -Eq "^uxp1 $n [0-9a-f]{40}\$" || { echo "FAIL: pack header"; rc=1; }
want=$(( $(head -1 "$tmp/pkt" | wc -c) + n + 7 ))
[ "$(wc -c <"$tmp/pkt")" -eq "$want" ] || { echo "FAIL: pack size ($(wc -c <"$tmp/pkt") != $want)"; rc=1; }

# 2) hop executes the SHIPPED rom: output is rot13(payload), computed by the packet's own code
out=$(printf 'Hello, mesh!' | $hop --pack rot13.rom | $hop)
exp=$(printf 'Hello, mesh!' | tr 'A-Za-z' 'N-ZA-Mn-za-m')
[ "$out" = "$exp" ] || { echo "FAIL: hop rot13 (got '$out' want '$exp')"; rc=1; }

# 3) hops compose: rot13 twice through two packets = identity
out=$(printf 'compose me' | $hop --pack rot13.rom | $hop | $hop --pack rot13.rom | $hop)
[ "$out" = 'compose me' ] || { echo "FAIL: double-hop identity (got '$out')"; rc=1; }

# 4) malformed header fails LOUD and leaks NO payload to stdout
out=$(printf 'not a packet at all' | $hop 2>/dev/null); r=$?
{ [ $r -ne 0 ] && [ -z "$out" ]; } || { echo "FAIL: bad header must fail loud w/ empty stdout (rc=$r out='$out')"; rc=1; }

# 5) truncated rom fails LOUD (header claims more bytes than the stream carries)
out=$( { printf 'uxp1 9999\n'; head -c 10 rot13.rom; } | $hop 2>/dev/null); r=$?
{ [ $r -ne 0 ] && [ -z "$out" ]; } || { echo "FAIL: truncated rom must fail loud (rc=$r)"; rc=1; }

# 6) exit-code propagation: shipped rom halting #81 -> hop rc 1; rot13 (#80) -> rc 0
printf '|0100 #81 #0f DEO BRK' >"$tmp/fail.tal"
./bin/uxnasm "$tmp/fail.tal" "$tmp/fail.rom" >/dev/null 2>&1 || { echo "FAIL: could not assemble fail.rom"; rc=1; }
printf '' | $hop --pack "$tmp/fail.rom" | $hop >/dev/null 2>&1; r=$?
[ $r -eq 1 ] || { echo "FAIL: rc propagation (want 1 got $r)"; rc=1; }
printf 'x' | $hop --pack rot13.rom | $hop >/dev/null 2>&1 || { echo "FAIL: healthy hop must exit 0"; rc=1; }

# 7) the shipped rom runs in a FRESH EMPTY dir — caller's cwd stays untouched
#    (uxncli's file device is sandboxed to cwd, file.c file_check_sandbox; the hop
#    must therefore never lend the ROM a cwd that contains anything)
mkdir "$tmp/cage"
( cd "$tmp/cage" && printf 'x' | "$here/mesh-uxn-hop" --pack "$here/rot13.rom" | "$here/mesh-uxn-hop" >/dev/null 2>&1 )
[ -z "$(ls -A "$tmp/cage")" ] || { echo "FAIL: hop dirtied caller cwd: $(ls -A "$tmp/cage")"; rc=1; }

# 8) pack declares the ROM's sha1 in the header — the hash is a shared NAME for the judgment
sha=$(sha1sum rot13.rom | cut -d' ' -f1)
printf 'x' | $hop --pack rot13.rom | head -1 | grep -q "^uxp1 $n $sha\$" \
  || { echo "FAIL: pack header must declare sha1"; rc=1; }

# 9) run-time verification, not claim: a TAMPERED rom (declared hash intact) is REFUSED —
#    the receiver hashes what it actually got, before executing a single byte of it
printf 'x' | $hop --pack rot13.rom >"$tmp/pkt2"
hdrlen=$(head -1 "$tmp/pkt2" | wc -c)
printf 'Z' | dd of="$tmp/pkt2" bs=1 seek="$((hdrlen + 5))" conv=notrunc status=none
out=$($hop <"$tmp/pkt2" 2>"$tmp/err9"); r=$?
{ [ $r -ne 0 ] && [ -z "$out" ] && grep -q 'sha1' "$tmp/err9"; } \
  || { echo "FAIL: tampered rom must be refused pre-exec (rc=$r out='$out')"; rc=1; }

# 10) UXN_HOP_STAMP=1: the verdict is stamped with what the executing site ACTUALLY hashed
out=$(printf 'Hi' | $hop --pack rot13.rom | UXN_HOP_STAMP=1 $hop 2>"$tmp/err10")
[ "$out" = 'Uv' ] || { echo "FAIL: stamp mode must not disturb stdout (got '$out')"; rc=1; }
grep -q "^hop: rom sha1=$sha declared=$sha rc=0\$" "$tmp/err10" \
  || { echo "FAIL: stamp line wrong: $(cat "$tmp/err10")"; rc=1; }

# 11) an UNDECLARED (2-field legacy) header still runs, stamped declared=none — visible, not silent
{ printf 'uxp1 %d\n' "$n"; cat rot13.rom; printf 'Hi'; } | UXN_HOP_STAMP=1 $hop >"$tmp/out11" 2>"$tmp/err11"
[ "$(cat "$tmp/out11")" = 'Uv' ] || { echo "FAIL: legacy header must still run"; rc=1; }
grep -q "^hop: rom sha1=$sha declared=none rc=0\$" "$tmp/err11" \
  || { echo "FAIL: legacy stamp wrong: $(cat "$tmp/err11")"; rc=1; }

# 12) argv-mode packet (uxp1 … argv): payload is delivered to the ROM as ARGV, not stdin —
#     the lane for evaluator ROMs (lisp-eval takes its expression via argv and NAs on stdin).
[ -f lisp-eval.rom ] || { echo "FAIL: no lisp-eval.rom to test argv mode"; rc=1; }
ln=$(wc -c <lisp-eval.rom); lsha=$(sha1sum lisp-eval.rom | cut -d' ' -f1)
printf '(+ 2 3)' | $hop --pack-argv lisp-eval.rom | head -1 | grep -q "^uxp1 $ln $lsha argv\$" \
  || { echo "FAIL: pack-argv header must carry the argv mode token"; rc=1; }
out=$(printf '(+ 2 3)' | $hop --pack-argv lisp-eval.rom | $hop 2>/dev/null)
[ "$out" = '5' ] || { echo "FAIL: argv-mode eval (got '$out' want '5')"; rc=1; }

# 13) argv-mode NA honesty flows through: a domain error is NA + rc 2, never a wrapped verdict
out=$(printf '(/ 1 0)' | $hop --pack-argv lisp-eval.rom | $hop 2>/dev/null); r=$?
{ [ "$out" = 'NA' ] && [ $r -eq 2 ]; } || { echo "FAIL: argv-mode NA (got '$out' rc=$r)"; rc=1; }

# 14) unknown mode token fails LOUD — a receiver too old for the mode must refuse, not
#     silently fall back to stdin delivery (the silent-fallback doctrine)
out=$( { printf 'uxp1 %d %s frobnicate\n' "$n" "$sha"; cat rot13.rom; printf 'x'; } | $hop 2>/dev/null); r=$?
{ [ $r -ne 0 ] && [ -z "$out" ]; } || { echo "FAIL: unknown mode must fail loud (rc=$r out='$out')"; rc=1; }

# 15) the receiver is POSIX sh — the SAME script runs under busybox ash on a body node
#     (Note3, stage 4c). Drive both the good path and the refusal path under plain sh:
#     a bashism in a rarely-taken branch dies 'Bad substitution' instead of refusing loud.
out=$(printf '(+ 2 3)' | $hop --pack-argv lisp-eval.rom | sh $hop 2>/dev/null); r=$?
{ [ "$out" = '5' ] && [ $r -eq 0 ]; } || { echo "FAIL: receiver under sh, good path (rc=$r out='$out')"; rc=1; }
out=$(printf 'nonsense header\njunk' | sh $hop 2>"$tmp/err15"); r=$?
{ [ $r -eq 65 ] && [ -z "$out" ] && grep -q 'bad header' "$tmp/err15"; } \
  || { echo "FAIL: receiver under sh must refuse loud rc=65 (rc=$r err='$(cat "$tmp/err15")')"; rc=1; }

# ---------------------------------------------------------------------------------------
# THE NET LANE (--pack-net / --dial / --serve): the same packet, carried by the emulator's
# own 0xd0 device instead of ssh, into a receiver that is a ROM rather than this script.
# The claim under test is stronger than the pipe lane's: the far side runs NO SHELL, and
# hop-serve REPLACES ITSELF with the arriving ROM — so "it answered" is the only evidence
# that the swap, the surviving socket and the shipped code all worked.
# ---------------------------------------------------------------------------------------
TOK=hop-test-token
P=${UXN_HOP_TEST_PORT:-47321}
export UXN_NET_TIMEOUT=1     # every wait in these legs is one device deadline, not ten
[ -f rot13-net.rom ] || ./bin/uxnasm rot13-net.tal rot13-net.rom >/dev/null
[ -f hop-serve.rom ] || ./bin/uxnasm hop-serve.tal hop-serve.rom >/dev/null
[ -f hop-dial.rom ] || ./bin/uxnasm hop-dial.tal hop-dial.rom >/dev/null

nn=$(wc -c <rot13-net.rom); nsha=$(sha1sum rot13-net.rom | cut -d' ' -f1)

# 16) --pack-net declares the lane AND the token in the header
printf 'x' | UXN_HOP_TOKEN=$TOK $hop --pack-net rot13-net.rom | head -1 \
  | grep -q "^uxp1 $nn $nsha net $TOK\$" || { echo "FAIL: pack-net header shape"; rc=1; }

# 17) no token = no packet and no listener. The token is REQUIRED, never defaulted: a
#     built-in default is a shared secret that is not secret. This also guards the subshell
#     trap — hop_token's exit inside $(…) would kill only the subshell, and the packet would
#     ship with a BLANK token while everything still looked fine.
out=$(printf 'x' | env -u UXN_HOP_TOKEN $hop --pack-net rot13-net.rom 2>"$tmp/err17"); r=$?
{ [ $r -eq 78 ] && [ -z "$out" ] && grep -q 'UXN_HOP_TOKEN' "$tmp/err17"; } \
  || { echo "FAIL: pack-net without a token must refuse loud, produce NOTHING (rc=$r out='$out')"; rc=1; }
out=$(env -u UXN_HOP_TOKEN $hop --serve "tcp:127.0.0.1:$P" 2>"$tmp/err17b"); r=$?
{ [ $r -eq 78 ] && grep -q 'UXN_HOP_TOKEN' "$tmp/err17b"; } \
  || { echo "FAIL: serve without a token must refuse loud (rc=$r)"; rc=1; }

# 18) THE LANES REFUSE EACH OTHER BY NAME, in both directions. A net-lane ROM answers on a
#     socket; run under the pipe receiver it would print into a console nobody reads and the
#     hop would look successful with every answer lost.
out=$(printf 'x' | UXN_HOP_TOKEN=$TOK $hop --pack-net rot13-net.rom | $hop 2>"$tmp/err18"); r=$?
{ [ $r -eq 65 ] && [ -z "$out" ] && grep -q 'NET-lane' "$tmp/err18"; } \
  || { echo "FAIL: pipe receiver must refuse a net packet by name (rc=$r out='$out')"; rc=1; }

# serve_dial <packet-file> <port> -> stdout of the dialer; server stderr in $tmp/serve.err
# NO READINESS PROBE HERE, and that is not laziness: hop-serve has exactly ONE accept, so a
# probe connection IS the caller — it would be accepted, close instantly, and the real packet
# would find nothing listening. The server gets a longer accept deadline instead, which is the
# thing actually being waited on.
serve_dial() {
  UXN_HOP_TOKEN=$TOK UXN_NET_TIMEOUT=3 timeout 25 $hop --serve "tcp:127.0.0.1:$2" >"$tmp/serve.out" 2>"$tmp/serve.err" &
  sp=$!
  sleep 1
  UXN_NET_TIMEOUT=2 timeout 20 $hop --dial "tcp:127.0.0.1:$2" <"$1" 2>"$tmp/dial.err"
  dr=$?
  wait $sp 2>/dev/null
  return $dr
}

# 19) THE LANE, end to end: the answer is computed by a ROM that arrived over the socket,
#     inside an emulator that had no idea what it would be running, with no shell on the
#     receiving side at all.
printf 'Hello, mesh!' | UXN_HOP_TOKEN=$TOK $hop --pack-net rot13-net.rom >"$tmp/pkt.net"
out=$(serve_dial "$tmp/pkt.net" "$P"); r=$?
{ [ "$out" = 'Uryyb, zrfu!' ] && [ $r -eq 0 ] && grep -q 'accepted' "$tmp/serve.err"; } \
  || { echo "FAIL: net lane round trip (rc=$r out='$out' serve='$(head -3 "$tmp/serve.err" | tr '\n' ' ')')"; rc=1; }

# 20) a WRONG TOKEN is refused BEFORE a byte of the ROM is executed. Asserting the stderr
#     line alone would assert a message; the artifact is that the caller gets NA and NOT the
#     transformation — the ROM never ran.
printf 'Hello, mesh!' | UXN_HOP_TOKEN=wrong-token $hop --pack-net rot13-net.rom >"$tmp/pkt.bad"
out=$(serve_dial "$tmp/pkt.bad" "$((P + 1))"); r=$?
{ [ "$out" = 'NA' ] && [ $r -eq 2 ] && grep -q 'token mismatch' "$tmp/serve.err"; } \
  || { echo "FAIL: wrong token must refuse pre-exec (rc=$r out='$out' serve='$(head -3 "$tmp/serve.err" | tr '\n' ' ')')"; rc=1; }

# 21) a PIPE-lane packet sent to a serve node is refused by name — the other direction of 18
printf 'Hello, mesh!' | $hop --pack rot13.rom >"$tmp/pkt.pipe"
out=$(serve_dial "$tmp/pkt.pipe" "$((P + 2))"); r=$?
{ [ "$out" = 'NA' ] && grep -q 'wrong lane' "$tmp/serve.err"; } \
  || { echo "FAIL: serve must refuse a pipe-lane packet (out='$out' serve='$(head -3 "$tmp/serve.err" | tr '\n' ' ')')"; rc=1; }

# 21b) the lane check is load-bearing only against a packet that is otherwise ACCEPTABLE:
#      right token, wrong mode. A bare pipe packet (leg 21) is caught by the missing token
#      first, so it does not prove the mode check does anything. This is the packet the check
#      exists for — the shape a future token-carrying lane would produce.
{ printf 'uxp1 %d %s argv %s\n' "$nn" "$nsha" "$TOK"; cat rot13-net.rom; printf 'Hello, mesh!'; } >"$tmp/pkt.lane"
out=$(serve_dial "$tmp/pkt.lane" "$((P + 7))")
{ [ "$out" = 'NA' ] && grep -q 'wrong lane' "$tmp/serve.err"; } \
  || { echo "FAIL: valid token + wrong lane must be refused by name (out='$out' serve='$(head -3 "$tmp/serve.err" | tr '\n' ' ')')"; rc=1; }

# 22) a TRUNCATED packet never executes: the header claims more ROM than the stream carries,
#     so a receiver that jumped anyway would run a half-copied program off a live socket.
{ printf 'uxp1 %d %s net %s\n' "$((nn + 500))" "$nsha" "$TOK"; cat rot13-net.rom; } >"$tmp/pkt.cut"
out=$(serve_dial "$tmp/pkt.cut" "$((P + 3))")
{ [ "$out" = 'NA' ] && grep -q 'mid-packet' "$tmp/serve.err"; } \
  || { echo "FAIL: truncated packet must refuse (out='$out' serve='$(head -3 "$tmp/serve.err" | tr '\n' ' ')')"; rc=1; }

# 22b) a ROM too big for the staging area is refused BEFORE any of it is read. The copier
#      runs at 8000 and copies 4000->0100, so a ROM past 3f00 would overwrite the staging
#      area it is still being copied FROM — corrupting exactly the ROMs big enough to reach
#      it, and only those. Refusing on the declared size is the cheap end of that.
{ printf 'uxp1 %d %s net %s\n' 20000 "$nsha" "$TOK"; cat rot13-net.rom; } >"$tmp/pkt.big"
out=$(serve_dial "$tmp/pkt.big" "$((P + 8))")
{ [ "$out" = 'NA' ] && grep -q 'size out of range' "$tmp/serve.err"; } \
  || { echo "FAIL: oversize rom must be refused by name (out='$out' serve='$(head -3 "$tmp/serve.err" | tr '\n' ' ')')"; rc=1; }

# 23) RED-first on the RECEIVER ROM's source. Both mutants are the plausible simplification —
#     dropping a check — and each is discriminated by exactly one leg above. The mutation is
#     asserted to be a real edit first: a pattern that silently missed would leave the mutant
#     identical to the original and every leg would pass for the wrong reason.
tal_mutant_red() { # $1=sed script  $2=label  $3=command that must FAIL against the mutant
  sed "$1" hop-serve.tal > "$tmp/mut.tal"
  if cmp -s hop-serve.tal "$tmp/mut.tal"; then
    echo "FAIL: $2: mutation was a no-op (pattern missed — this mutant is NOT being tested)"; rc=1; return
  fi
  ./bin/uxnasm "$tmp/mut.tal" "$tmp/mut.rom" >/dev/null 2>&1 || { echo "FAIL: $2: mutant does not assemble"; rc=1; return; }
  cp hop-serve.rom "$tmp/serve.bak"; cp "$tmp/mut.rom" hop-serve.rom
  if eval "$3" >/dev/null 2>&1; then
    echo "FAIL: $2: the check STILL PASSES against the mutant — that leg does not discriminate it"; rc=1
  else
    echo "  PASS: RED against mutant: $2"
  fi
  cp "$tmp/serve.bak" hop-serve.rom
}
tal_mutant_red 's|;check-token JSR2 #00 EQU ,&badtok JCN|;check-token JSR2 POP|' \
  "token check dropped (any caller may run code)" \
  "out=\$(serve_dial $tmp/pkt.bad $((P + 4))); [ \"\$out\" = 'NA' ]"
# NOT a "mode check dropped" mutant: `match` ADVANCES the cursor on success, so removing the
# lane check also strands the token parse and the packet is refused for the other reason. A
# mutant whose damage is masked by the next check proves nothing — leg 21b asserts that
# property directly instead.
tal_mutant_red 's|#32 LDZ2 #3f00 GTH2 ,&badsize JCN|#32 LDZ2 #3f00 GTH2 POP|' \
  "staging-bound check dropped (a ROM copied over the buffer it is copied from)" \
  "out=\$(serve_dial $tmp/pkt.big $((P + 5))); grep -q 'size out of range' $tmp/serve.err"

# 24) THE LIVE LEG: a real peer over tailscale dials this node's serve port. The dialer there
#     is socat, NOT uxncli — phaedra has no compiler and no emulator pushed to it — which is
#     honest for what this leg claims: the SERVE side over the tailnet. The dial side is
#     claimed by leg 19 and by nothing else, and that gap is stated rather than papered over.
PEER_SSH="${MESH_NET_TEST_PEER:-root@100.94.116.17}"
SELF_IP="${MESH_NET_TEST_SELF_IP:-$(tailscale ip -4 2>/dev/null | head -1)}"
if [ -z "$SELF_IP" ] || ! timeout 15 ssh -n -o StrictHostKeyChecking=no -o ConnectTimeout=8 -o BatchMode=yes "$PEER_SSH" true 2>/dev/null; then
  echo "  n/a: peer $PEER_SSH unreachable (or no tailscale IP here) — the LIVE net-lane leg did NOT run"
else
  UXN_HOP_TOKEN=$TOK UXN_NET_TIMEOUT=15 timeout 60 $hop --serve "tcp:$SELF_IP:$((P + 6))" >/dev/null 2>"$tmp/serve.live" &
  sp=$!
  sleep 1   # again: no probe — a probe connection would consume the single accept
  scp -q -o StrictHostKeyChecking=no -o BatchMode=yes "$tmp/pkt.net" "$PEER_SSH:/tmp/uxn-hop-pkt" 2>/dev/null
  lout=$(timeout 40 ssh -n -o StrictHostKeyChecking=no -o BatchMode=yes "$PEER_SSH" \
    "timeout 25 socat -T8 - TCP:$SELF_IP:$((P + 6)) </tmp/uxn-hop-pkt" 2>/dev/null)
  wait $sp 2>/dev/null
  if [ "$lout" = 'Uryyb, zrfu!' ]; then
    echo "  PASS: LIVE net lane: $PEER_SSH shipped a ROM over tailscale to $SELF_IP:$((P + 6)) and this node's uxncli BECAME it — answered 'Uryyb, zrfu!'"
  else
    echo "FAIL: live net lane (got '$lout' serve='$(head -3 "$tmp/serve.live" | tr '\n' ' ')')"; rc=1
  fi
fi

[ "$rc" = 0 ] && echo "uxn-hop-test: ok" || echo "uxn-hop-test: FAIL"
exit $rc
