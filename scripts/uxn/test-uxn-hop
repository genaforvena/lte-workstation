#!/usr/bin/env bash
# test-uxn-hop — RED-first suite for mesh-uxn-hop (ROM-as-packet pipe stage, uxp1 format).
#
# The claim under test: the CODE travels with the DATA. A hop receives
# "uxp1 <n>\n" + <n rom bytes> + payload, executes the shipped ROM on the payload
# in a fresh empty dir (the file-device sandbox floor), and fails LOUD on any
# malformed packet — never a silent passthrough (the silent-fallback doctrine).
set -u
here="$(cd "$(dirname "$0")" && pwd)"
cd "$here"
[ -x bin/uxncli ] || ./build.sh >/dev/null
[ -f rot13.rom ] || ./bin/uxnasm rot13.tal rot13.rom >/dev/null
rc=0
hop=./mesh-uxn-hop
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

# 1) pack format: exact header, exact byte accounting
n=$(wc -c <rot13.rom)
printf 'seven b' | $hop --pack rot13.rom >"$tmp/pkt"
head -1 "$tmp/pkt" | grep -q "^uxp1 $n\$" || { echo "FAIL: pack header"; rc=1; }
want=$(( $(printf 'uxp1 %d\n' "$n" | wc -c) + n + 7 ))
[ "$(wc -c <"$tmp/pkt")" -eq "$want" ] || { echo "FAIL: pack size ($(wc -c <"$tmp/pkt") != $want)"; rc=1; }

# 2) hop executes the SHIPPED rom: output is rot13(payload), computed by the packet's own code
out=$(printf 'Hello, mesh!' | $hop --pack rot13.rom | $hop)
exp=$(printf 'Hello, mesh!' | tr 'A-Za-z' 'N-ZA-Mn-za-m')
[ "$out" = "$exp" ] || { echo "FAIL: hop rot13 (got '$out' want '$exp')"; rc=1; }

# 3) hops compose: rot13 twice through two packets = identity
out=$(printf 'compose me' | $hop --pack rot13.rom | $hop | $hop --pack rot13.rom | $hop)
[ "$out" = 'compose me' ] || { echo "FAIL: double-hop identity (got '$out')"; rc=1; }

# 4) malformed header fails LOUD and leaks NO payload to stdout
out=$(printf 'not a packet at all' | $hop 2>/dev/null); r=$?
{ [ $r -ne 0 ] && [ -z "$out" ]; } || { echo "FAIL: bad header must fail loud w/ empty stdout (rc=$r out='$out')"; rc=1; }

# 5) truncated rom fails LOUD (header claims more bytes than the stream carries)
out=$( { printf 'uxp1 9999\n'; head -c 10 rot13.rom; } | $hop 2>/dev/null); r=$?
{ [ $r -ne 0 ] && [ -z "$out" ]; } || { echo "FAIL: truncated rom must fail loud (rc=$r)"; rc=1; }

# 6) exit-code propagation: shipped rom halting #81 -> hop rc 1; rot13 (#80) -> rc 0
printf '|0100 #81 #0f DEO BRK' >"$tmp/fail.tal"
./bin/uxnasm "$tmp/fail.tal" "$tmp/fail.rom" >/dev/null 2>&1 || { echo "FAIL: could not assemble fail.rom"; rc=1; }
printf '' | $hop --pack "$tmp/fail.rom" | $hop >/dev/null 2>&1; r=$?
[ $r -eq 1 ] || { echo "FAIL: rc propagation (want 1 got $r)"; rc=1; }
printf 'x' | $hop --pack rot13.rom | $hop >/dev/null 2>&1 || { echo "FAIL: healthy hop must exit 0"; rc=1; }

# 7) the shipped rom runs in a FRESH EMPTY dir — caller's cwd stays untouched
#    (uxncli's file device is sandboxed to cwd, file.c file_check_sandbox; the hop
#    must therefore never lend the ROM a cwd that contains anything)
mkdir "$tmp/cage"
( cd "$tmp/cage" && printf 'x' | "$here/mesh-uxn-hop" --pack "$here/rot13.rom" | "$here/mesh-uxn-hop" >/dev/null 2>&1 )
[ -z "$(ls -A "$tmp/cage")" ] || { echo "FAIL: hop dirtied caller cwd: $(ls -A "$tmp/cage")"; rc=1; }

[ "$rc" = 0 ] && echo "uxn-hop-test: ok" || echo "uxn-hop-test: FAIL"
exit $rc
