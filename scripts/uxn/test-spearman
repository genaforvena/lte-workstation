#!/usr/bin/env bash
# test-spearman — truth table for the Spearman ROM, every assert seen RED before green.
#
# "Seen red" here is not a claim about what a human did once: sections C and D REBUILD the
# ROM from mutated source and require the same truth table to FAIL against each mutant. A
# table that cannot fail is not a table. The three mutants are the three bugs this ROM
# actually had while it was being written:
#   · the domain ceiling moved off 58        (a wrapped sum rendered as a correlation)
#   · the rank-difference guard inverted     (every input answered NA)
#   · the scaling truncated instead of rounding (systematic -1, DIVERGEd on 2/11 windows)
set -eu
here="$(cd "$(dirname "$0")" && pwd)"
cd "$here"
tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT
rc=0
fail(){ echo "  FAIL: $*"; rc=1; }
UXNCLI="${MESH_UXNCLI:-$here/bin/uxncli}"
ASM="$here/bin/uxnasm"
[ -x "$UXNCLI" ] || { echo "spearman-test: n/a — no uxncli (run ./build.sh)"; exit 2; }
[ -x "$ASM" ]    || { echo "spearman-test: n/a — no uxnasm (run ./build.sh)"; exit 2; }

# run <rom> <tokens…> → prints "<out> <rc>"
run(){ local rom="$1"; shift; local o urc; o="$(printf '%s\n' "$@" | "$UXNCLI" "$rom" 2>/dev/null)"; urc=$?; printf '%s %s' "$o" "$urc"; }

# The table. Each row: want-output want-rc tokens…
# n=5 → D=20. The ceiling is 2343: chosen so 2*D + the largest possible d^2 still fits 32
# bits, which is what makes the per-value sum(d^2) <= 2D check a COMPLETE overflow guard.
table(){ cat <<'ROWS'
1000 0 | 5 0 0 0 0 0
-1000 0 | 5 4 2 0 2 4
800 0 | 5 1 1 0 1 1
850 0 | 5 1 0 1 0 1
1000 0 | 58 PERFECT58
-1000 0 | 58 INVERT58
-1000 0 | 59 INVERT59
1000 0 | 2343 PERFECT2343
-1000 0 | 2343 INVERT2343
NA 2 | 2344 0
NA 2 | 1
NA 2 | 0
NA 2 | 5 5 0 0 0 0
NA 2 | 5 9 9 9 9 9
ROWS
}

expand(){ # expand the PERFECT58/INVERT58 macros into real token lists
  case "$1" in
    PERFECT58)   for _ in $(seq 58);   do printf '0 '; done ;;
    PERFECT2343) for _ in $(seq 2343); do printf '0 '; done ;;
    INVERT58)   python3 -c 'n=58
print(" ".join(str(abs((i+1)-(n-i))) for i in range(n)))' ;;
    INVERT59)   python3 -c 'n=59
print(" ".join(str(abs((i+1)-(n-i))) for i in range(n)))' ;;
    INVERT2343) python3 -c 'n=2343
print(" ".join(str(abs((i+1)-(n-i))) for i in range(n)))' ;;
    *) printf '%s ' "$1" ;;
  esac
}

check_table(){ # $1=rom → 0 all rows match, 1 any row differs (prints the first)
  local rom="$1" line want wrc toks got
  while IFS='|' read -r lhs toks; do
    [ -n "${lhs// /}" ] || continue
    set -- $lhs; want="$1"; wrc="$2"
    local args=""
    for t in $toks; do args="$args $(expand "$t")"; done
    got="$(run "$rom" $args)"
    [ "$got" = "$want $wrc" ] || { echo "row '$lhs|$toks': want '$want $wrc', got '$got'"; return 1; }
  done < <(table)
  return 0
}

# --- A. the committed ROM satisfies the table -------------------------------------------
[ -f spearman.rom ] || fail "no spearman.rom (run ./bin/uxnasm spearman.tal spearman.rom)"
msg="$(check_table spearman.rom)" || fail "committed ROM vs truth table: $msg"

# --- B. the committed ROM is the committed SOURCE ----------------------------------------
# A .rom checked in beside a .tal can drift from it silently — the binary is what runs.
"$ASM" spearman.tal "$tmp/rebuilt.rom" >/dev/null 2>&1 || fail "spearman.tal does not assemble"
cmp -s spearman.rom "$tmp/rebuilt.rom" || fail "spearman.rom is NOT what spearman.tal assembles to — the committed binary has drifted from its source"

# --- C. RED on the SOURCE: each mutant must break the table ------------------------------
mutant_red(){ # $1=sed-mutation $2=label
  sed "$1" spearman.tal > "$tmp/mut.tal" || { fail "$2: sed failed"; return; }
  if cmp -s spearman.tal "$tmp/mut.tal"; then fail "$2: mutation was a no-op (pattern missed)"; return; fi
  "$ASM" "$tmp/mut.tal" "$tmp/mut.rom" >/dev/null 2>&1 || { fail "$2: mutant does not assemble"; return; }
  if check_table "$tmp/mut.rom" >/dev/null 2>&1; then
    fail "$2: truth table STILL GREEN against the mutant — the table does not discriminate this"
  fi
}
# domain ceiling 2343 → 2344: the ceiling is set so 2*D + max(d^2) still fits 32 bits, so one
# past it a single accumulation step can wrap and the sum(d^2) <= 2D guard stops being complete.
mutant_red 's/#0927 GTH2/#0928 GTH2/'                    "domain ceiling 2343→2344 (a wrapped sum would render as a correlation)"
# the |d| < n guard inverted — this exact slip made every input answer NA while looking fine
mutant_red 's/#06 LDZ2 #00 LDZ2 LTH2 ,\&v1 JCN/#06 LDZ2 #00 LDZ2 LTH2 #00 EQU ,\&v1 JCN/' "rank-difference guard inverted"   # \& — a bare & in a sed replacement is the whole match
# rounding removed → truncation: costs exactly 1 in the last place on some inputs
mutant_red 's/#12 LDZ2 #0005 LTH2 ,\&noround JCN/#12 LDZ2 #0000 LTH2 ,\&noround JCN/'      "round-to-nearest → truncate"

# --- D. RED on the OVERFLOW REFUSAL specifically -----------------------------------------
# n=2343 with the maximum legal sum (S=2D) must answer -1000, and one more unit of d^2
# than the machine can hold must answer NA — not a wrapped number. Pinned from both sides.
inv="$(expand INVERT2343)"
got="$(run spearman.rom 2343 $inv)"
[ "$got" = "-1000 0" ] || fail "n=2343 at the exact 32-bit sum ceiling (S=2D): want '-1000 0', got '$got'"
got="$(run spearman.rom 2344 $inv 0)"
[ "$got" = "NA 2" ] || fail "n=2344 must refuse, not wrap: want 'NA 2', got '$got'"

# --- E. ROM vs the independent 64-bit twin over random series ----------------------------
# The twin is written in awk floats, not a re-implementation of the ROM's integer scaling,
# so an AGREE is evidence about the arithmetic rather than about a shared mistake.
[ -x ./mesh-spearman ] || fail "no mesh-spearman (the host half owns ranking + the twin)"
agree=0; diverge=0
for seed in 1 2 3 4 5 6 7 8; do
  python3 -c "
import random
random.seed($seed)
n=random.randint(5,58)
for _ in range(n): print(random.randint(0,40), random.randint(0,25))
" > "$tmp/pairs.$seed"
  r="$(./mesh-spearman --pairs "$tmp/pairs.$seed" 2>/dev/null || echo NA)"
  t="$(./mesh-spearman --twin "$tmp/pairs.$seed" ordinal 2>/dev/null || echo NA)"
  if [ -n "$t" ] && [ "$r" = "$t" ]; then agree=$((agree+1)); else diverge=$((diverge+1)); echo "  seed $seed: rom=$r twin=$t"; fi
done
[ "$diverge" -eq 0 ] || fail "ROM and 64-bit twin DIVERGE on $diverge/8 random series"
[ "$agree" -ge 8 ]   || fail "only $agree/8 random series were actually compared — the twin path is not running"

# --- F. the host passes the ROM's refusal through unchanged ------------------------------
# A host that turned NA into a number would re-introduce exactly the silent wrap the ROM
# refuses. Drive a series past the domain and require rc=2 out of the TOOL, not just the ROM.
python3 -c "
import random
random.seed(99)
for _ in range(2400): print(random.randint(0,40), random.randint(0,25))
" > "$tmp/toobig"
if ./mesh-spearman --pairs "$tmp/toobig" >/dev/null 2>&1; then
  fail "mesh-spearman --pairs swallowed the ROM's domain refusal (want rc=2 for n=2400 > 2343)"
fi

# --- G. the double-word CARRIES, driven through the real reduction --------------------
# arith32's own test proves all four carries red against its boundary table. This asks a
# different question: does a missing carry survive all the way to a WRONG CORRELATION?
# It does, and the answer is n-dependent in a way worth writing down. A single lost
# high-word unit is an error of 65536/D in rho, and D grows as n^3 — so at n=200 that is
# 4.9e-2 (screaming), at n=650 it is 1.4e-3 (just visible against the printed 1e-3), and
# at n=2343 it is 3.1e-5, BELOW the resolution the ROM prints. Measured, not reasoned:
# deleting w-sub's borrow changes the answer at n=200 (37 -> 22) and n=650 (-17 -> -18)
# and is INVISIBLE at n=2343 (20 -> 20).
# The lesson is the opposite of the intuition: the max-domain input is the WEAKEST place
# to hunt a carry bug, and an end-to-end test alone would have called this ROM correct.
# That is exactly why test-arith32 exists as a separate boundary table and is the
# authority for carry coverage — this section only pins the end-to-end consequence.
carry_red(){ # $1=sed on arith32.tal  $2=n  $3=label
  cp arith32.tal "$tmp/a32.bak"
  sed "$1" arith32.tal > "$tmp/a32.mut" || { fail "$3: sed failed"; return; }
  if cmp -s arith32.tal "$tmp/a32.mut"; then fail "$3: mutation was a no-op (pattern missed)"; return; fi
  cp "$tmp/a32.mut" arith32.tal
  local built=1
  "$ASM" spearman.tal "$tmp/carry.rom" >/dev/null 2>&1 || built=0
  cp "$tmp/a32.bak" arith32.tal
  [ "$built" = 1 ] || { fail "$3: mutant does not assemble"; return; }
  local base mut
  base="$("$UXNCLI" spearman.rom      < "$tmp/valid$2" 2>/dev/null)"
  mut="$( "$UXNCLI" "$tmp/carry.rom"  < "$tmp/valid$2" 2>/dev/null)"
  [ "$base" != "$mut" ] || fail "$3 at n=$2: the reduction still answers '$base' with this carry deleted"
}
for _n in 200 650; do
  python3 -c "
import random
random.seed(11)
n=$_n
p=list(range(1,n+1)); q=list(range(1,n+1)); random.shuffle(q)
print(n)
for a,b in zip(p,q): print(abs(a-b))
" > "$tmp/valid$_n"
done
carry_red 's|#48 LDZ2 #42 LDZ2 LTH2 #00 SWP|#0000                        |' 650 "w-add low->high carry deleted"
carry_red 's|#42 LDZ2 #46 LDZ2 LTH2 #00 SWP #48 STZ2|#0000 #48 STZ2                          |' 200 "w-sub low->high borrow deleted"
carry_red 's|#58 LDZ2 #48 LDZ2 LTH2 #00 SWP #40 LDZ2 ADD2 #40 STZ2|#40 LDZ2 #40 STZ2                                    |' 650 "w-mul16 low-word carry deleted"

[ "$rc" -eq 0 ] && echo "spearman-test: ok ($( table | grep -c . ) truth-table rows + rom==source + 3 source-mutants RED + 32-bit ceiling pinned both sides + 8 random series vs the 64-bit twin + host passes NA through + 3 double-word carries red through the real reduction)"
exit "$rc"
