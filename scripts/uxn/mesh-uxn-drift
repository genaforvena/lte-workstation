#!/usr/bin/env bash
# mesh-uxn-drift — the drift detector for the uxn EMULATOR binary (bin/uxncli).
#
# WHY THIS EXISTS. The uxn ROMs cannot drift: a .rom is byte-identical on every arch, and
# .gitattributes + mesh-rom-calibrate make that a contract. The net device (0xd0) MOVED the
# drift from the ROM to the EMULATOR — the emulator is now the thing that varies across the
# mesh (x86, armhf on the Note3, aarch64) AND carries a VERSION: net.h's NET_IDENT, bumped
# d001→d002 when stream bind/accept landed and d002→d003 when the datagram listener did,
# compared by ROMs as an ordering (net-listen refuses below d002, a datagram ROM below
# d003). Nothing checked that a COMMITTED/deployed binary identifies at the version its
# own source declares. A binary left un-rebuilt after a NET_IDENT bump answers the OLD step:
# too-old fails CLOSED (net-listen refuses) but byte-identical to a plain refused link — the
# silent-drift hole minds named (03:20 item 2 / 03:21 item iii, 2026-07-24). mesh-sync-tools
# guards ~/.local/bin/mesh-* only; bin/uxncli was under no drift check at all.
#
# WHAT IT ASSERTS. The RUNNING emulator's IDENTIFY word == the version its SOURCE declares.
# expected := #define NET_IDENT in src/devices/net.h ; actual := net-ident.rom run under the
# binary (the device pokes NET_IDENT into the length register; a device-less page reads back
# a zero the ROM wrote — 0000). Re-derived live every run, never a stored pin that rots.
#
# usage:  mesh-uxn-drift            check the local bin/uxncli against the source
#         mesh-uxn-drift --test     RED-first self-test (net-blind + version-skew controls)
# env:    UXN_BIN   override the emulator path (default scripts/uxn/bin/uxncli)
# exit:   0 = binary identifies at the source version (no drift)
#         1 = DRIFT — binary version != source (stale binary; rebuild bin/uxncli)
#         2 = n/a — no source tree or no emulator on this node (honest, never a fake green)
#
# reflex-cadence: 23 */6 * * *
set -eu

here="$(cd "$(dirname "$0")" && pwd)"
NET_H="$here/src/devices/net.h"
ROM="$here/net-ident.rom"
UXNCLI="${UXN_BIN:-$here/bin/uxncli}"

expected_ident(){  # -> "dNNN" (4 lowercase hex), from the source define
  grep -oE '#define[[:space:]]+NET_IDENT[[:space:]]+0x[0-9a-fA-F]{4}' "$NET_H" 2>/dev/null \
    | grep -oiE '0x[0-9a-f]{4}' | head -1 | sed 's/^0[xX]//' | tr 'A-F' 'a-f'
}
actual_ident(){    # -> "dNNN" from the running binary (0000 = no device)
  printf '' | "$1" "$ROM" 2>/dev/null | head -1 | tr -dc '0-9a-fA-F' | tr 'A-F' 'a-f'
}

# core check: takes a binary path, prints a verdict line, returns 0 ok / 1 drift / 2 n/a.
check(){
  local bin="$1" exp act
  [ -f "$NET_H" ] || { echo "mesh-uxn-drift: n/a — no source tree at $NET_H (not a genome checkout)"; return 2; }
  [ -f "$ROM" ]   || { echo "mesh-uxn-drift: n/a — probe ROM missing at $ROM (re-assemble: uxnasm net-ident.tal net-ident.rom)"; return 2; }
  [ -x "$bin" ]   || { echo "mesh-uxn-drift: n/a — no emulator at $bin (nothing built on this node)"; return 2; }
  exp="$(expected_ident)"
  [ -n "$exp" ] || { echo "mesh-uxn-drift: n/a — NET_IDENT not parseable from $NET_H"; return 2; }
  act="$(actual_ident "$bin")"
  if [ "$act" = "$exp" ]; then
    echo "mesh-uxn-drift: OK  — $(basename "$bin") identifies net device $act, source declares $exp (current)"
    return 0
  fi
  if [ "$act" = "0000" ] || [ -z "$act" ]; then
    echo "mesh-uxn-drift: DRIFT — $(basename "$bin") is NET-BLIND (identify '${act:-<empty>}'), source declares $exp — pre-net or stripped binary; rebuild (build.sh / cross-build.sh)" >&2
    return 1
  fi
  # both name device d0 but disagree on the step — the silent version skew this tool exists for.
  echo "mesh-uxn-drift: DRIFT — $(basename "$bin") identifies $act, source declares $exp — binary out of sync with source; rebuild bin/uxncli" >&2
  return 1
}

# --------------------------------------------------------------------------------------------
run_test(){
  local tmp rc=0 CC="${CC:-cc}"
  local SRC=(src/uxncli.c src/uxn.c src/devices/system.c src/devices/console.c \
            src/devices/file.c src/devices/datetime.c)
  tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' RETURN
  cd "$here"

  # 0. the probe ROM must be byte-identical to its source (byte-identity contract, same as
  #    every other .rom). Re-assemble and cmp — a drift detector whose own probe drifted lies.
  if [ -x bin/uxnasm ]; then
    ./bin/uxnasm net-ident.tal "$tmp/reassembled.rom" >/dev/null 2>&1 \
      && cmp -s "$tmp/reassembled.rom" net-ident.rom \
      && echo "  ok: net-ident.rom == uxnasm(net-ident.tal) (byte-identity)" \
      || { echo "  FAIL: net-ident.rom drifted from its source" >&2; rc=1; }
  else
    echo "  skip: no bin/uxnasm — cannot verify probe byte-identity"
  fi

  # 1. GREEN: the real committed binary identifies at the source version.
  if check "$UXNCLI" >/dev/null; then echo "  ok: real bin/uxncli passes (identifies $(actual_ident "$UXNCLI") == source)"
  else echo "  FAIL: real bin/uxncli flagged drift against its own source" >&2; rc=1; fi

  # Build the two RED controls from a copy of the source tree, or skip loudly if no compiler.
  if ! command -v "$CC" >/dev/null 2>&1; then
    echo "  skip: no C compiler ($CC) — cannot build the RED controls on this node (version-skew + net-blind assertions NOT run)"
    echo "uxn-drift-test: ok (probe byte-identity + real-binary green; RED controls skipped — no compiler)"
    return "$rc"
  fi
  cp -r src "$tmp/src"

  # 2. RED — VERSION SKEW (the whole point): a binary built from an OLDER NET_IDENT must be
  #    caught as drift, not read as a healthy device. This is the fail-closed-but-silent case.
  # The skew value is derived DOWN from the source, never typed: a control pinned at a
  # literal quietly becomes the CURRENT version on the next bump, and a "skew" control that
  # matches the source asserts nothing while still printing green.
  local srcexp skew
  srcexp="$(expected_ident)"
  skew="$(printf 'd%03x' "$(( 0x${srcexp#d} - 1 ))")"
  if [ "$skew" = "$srcexp" ] || [ -z "$srcexp" ]; then
    echo "  FAIL: could not derive a skew value below source '$srcexp' — the skew leg would be vacuous" >&2; rc=1
    skew=d001
  fi
  sed -i "s/#define NET_IDENT[[:space:]].*/#define NET_IDENT 0x$skew \/* skew control *\//" "$tmp/src/devices/net.h"
  if (cd "$tmp" && "$CC" -std=c89 -O2 -DNDEBUG -o uxncli-skew \
        src/uxncli.c src/uxn.c src/devices/system.c src/devices/console.c \
        src/devices/file.c src/devices/datetime.c src/devices/net.c -I src >/dev/null 2>&1); then
    if check "$tmp/uxncli-skew" >/dev/null 2>&1; then
      echo "  FAIL: version-skew binary (identifies d001) NOT flagged — the silent-drift hole is open" >&2; rc=1
    else
      echo "  ok: version-skew binary ($skew vs source $srcexp) → DRIFT rc1 (RED-first: the real find)"
    fi
  else
    echo "  skip: version-skew control failed to compile — the skew leg did NOT run" >&2
  fi

  # 3. RED — NET-BLIND: emu_dei's bare fallthrough (return 0) → identify 0000, must be DRIFT.
  cat > "$tmp/src/devices/net.c" <<'C'
#include "../uxn.h"
Uint8 net_dei(Uint8 addr){(void)addr;return 0;}
void net_deo(Uint8 addr){(void)addr;}
C
  cp -r src/devices/net.h "$tmp/src/devices/net.h" 2>/dev/null || true
  if (cd "$tmp" && "$CC" -std=c89 -O2 -DNDEBUG -o uxncli-blind \
        src/uxncli.c src/uxn.c src/devices/system.c src/devices/console.c \
        src/devices/file.c src/devices/datetime.c src/devices/net.c -I src >/dev/null 2>&1); then
    if check "$tmp/uxncli-blind" >/dev/null 2>&1; then
      echo "  FAIL: net-blind binary (identify 0000) NOT flagged as drift" >&2; rc=1
    else
      echo "  ok: net-blind binary (identify 0000) → DRIFT rc1"
    fi
  else
    echo "  skip: net-blind control failed to compile — the blind leg did NOT run" >&2
  fi

  [ "$rc" -eq 0 ] && echo "uxn-drift-test: ok (probe byte-identity + real-binary green + version-skew RED + net-blind RED)"
  return "$rc"
}

case "${1:-}" in
  --test) run_test ;;
  "")     check "$UXNCLI" ;;
  *)      echo "usage: mesh-uxn-drift [--test]   (env UXN_BIN overrides the emulator path)" >&2; exit 2 ;;
esac
