#!/usr/bin/env bash
# mesh-lease-gate — host shim for lease-gate.rom (Uxn pilot, uxn-pilot-gate 2026-07-20).
#
# The GATE LOGIC lives in the 133-byte ROM (portable, byte-identical on every node).
# This shim only (a) resolves a reflex's cadence + declared lease into two integers and
# (b) hands them to the ROM, which computes lease >= 2*cadence and answers OK / RED.
# It is deliberately thin: the invariant it guards is arithmetic, and the ROM owns it.
#
# usage:  mesh-lease-gate <name> [fixtures-file]   # resolve from a "name cad lease" table
#         mesh-lease-gate --pair <cadence> <lease> # gate two raw integers directly
# exit:   0 = green (lease healthy)   1 = RED (lease flaps stale)   2 = usage/unresolved
set -eu
here="$(cd "$(dirname "$0")" && pwd)"
ROM="${MESH_LEASE_ROM:-$here/lease-gate.rom}"
UXNCLI="${MESH_UXNCLI:-$here/bin/uxncli}"
[ -x "$UXNCLI" ] || { echo "mesh-lease-gate: no uxncli — run $here/build.sh" >&2; exit 2; }

if [ "${1:-}" = --pair ]; then
  cad="${2:?cadence}"; lease="${3:?lease}"
else
  name="${1:?usage: mesh-lease-gate <name> [fixtures]}"
  fix="${2:-$here/lease-fixtures}"
  row="$(grep -E "^[[:space:]]*${name}[[:space:]]" "$fix" 2>/dev/null | grep -vE '^\s*#' | head -1)"
  [ -n "$row" ] || { echo "mesh-lease-gate: $name not in $fix" >&2; exit 2; }
  cad="$(printf '%s\n' "$row" | awk '{print $2}')"
  lease="$(printf '%s\n' "$row" | awk '{print $3}')"
fi

urc=0
raw="$("$UXNCLI" "$ROM" "$cad" "$lease" 2>/dev/null)" || urc=$?
verdict="$(printf '%s' "$raw" | tr -d '[:space:]')"
if [ "$verdict" = NA ]; then
  # ROM 16-bit domain n/a (halt #82) — the doctrine fallback: same predicate in
  # 64-bit shell arithmetic, stamped so the row never masquerades as a ROM verdict.
  if [ "$lease" -ge $((2 * cad)) ]; then
    echo "lease-gate: OK   (lease=${lease}s >= 2*cadence=$((2*cad))s; src=inline-fallback, ROM domain NA)"; exit 0
  else
    echo "lease-gate: RED  (lease=${lease}s < 2*cadence=$((2*cad))s — flaps STALE every cycle; src=inline-fallback, ROM domain NA)" >&2; exit 1
  fi
fi
[ "$urc" -eq 0 ] || { echo "mesh-lease-gate: n/a — uxncli failed rc=$urc on ($cad,$lease) (rebuild? $here/build.sh --rom)" >&2; exit 2; }
if [ "$verdict" = OK ]; then
  echo "lease-gate: OK   (lease=${lease}s >= 2*cadence=$((2*cad))s)"; exit 0
else
  echo "lease-gate: RED  (lease=${lease}s < 2*cadence=$((2*cad))s — flaps STALE every cycle)" >&2; exit 1
fi
