( lease-gate.tal — reflex lease-vs-cadence gate, ported from mesh-reflex-health )
( eff_maxage(@auto): a watchdog lease MUST be >= 2x the producer's cadence, )
( else it flaps STALE every cycle while the reflex is perfectly healthy. )
( input  : argv "<cadence-seconds>" "<lease-seconds>" (uxncli feeds them nl-terminated) )
( verdict: prints "OK\n" and halts green iff lease >= 2*cadence, else "RED\n" )
( zero-page vars: cad=00 lease=02 acc=04 tok=06 )

|0100                        ( reset vector )
    ;on-console #10 DEO2     ( install Console/vector )
    BRK

@on-console
    #12 DEI                  ( Console/read -> byte )
    DUP #0a NEQ ,&digit JCN  ( not newline -> accumulate a digit )
    POP                      ( newline: drop it, finalize the token )
    #06 LDZ #00 EQU ,&first JCN
    #04 LDZ2 #02 STZ2        ( 2nd token -> lease = acc )
    ,&decide JMP
    &first
    #04 LDZ2 #00 STZ2        ( 1st token -> cad = acc )
    #0000 #04 STZ2           ( acc = 0 )
    #01 #06 STZ              ( tok = 1 )
    BRK
    &digit
    #30 SUB                  ( byte-'0' -> digit )
    #00 SWP                  ( promote to short )
    #04 LDZ2 #000a MUL2      ( acc*10 )
    ADD2
    #04 STZ2                 ( acc = acc*10 + digit )
    BRK
    &decide
    #00 LDZ2 #0002 MUL2      ( threshold = 2*cad )
    #02 LDZ2                 ( lease )
    GTH2                     ( threshold > lease  -> RED )
    ,&red JCN
    ;ok-str ;emit JSR2
    ,&halt JMP
    &red
    ;red-str ;emit JSR2
    &halt
    #01 #0f DEO              ( System/state = 1 -> exit )
    BRK

@emit ( str* -- )
    &loop
    LDAk #00 EQU ,&done JCN
    LDAk #18 DEO
    INC2 ,&loop JMP
    &done
    POP2
    JMP2r

@ok-str  "OK  0a 00
@red-str "RED 0a 00
