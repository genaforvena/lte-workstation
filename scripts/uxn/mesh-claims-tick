#!/usr/bin/env bash
# reflex-cadence: */15 * * * *
# mesh-claims-tick — the LONGITUDINAL RECORD of the sound-studio's standing claims.
#
# The sound dash already DISPLAYS `mesh-series-stats --claims` live (every frame, 30s) — but that
# pane is EPHEMERAL: it refreshes in place and nothing persists. A claim that drifted yesterday is
# gone today; "did the gate class regress over the last week?" has no numbers to answer from. This
# reflex closes that gap: it snapshots the claims verdict to a DURABLE append-only log every run, so
# the ROM's drift detection (axis moved) and arithmetic agreement (ROM == twin) become a timeline
# instead of a momentary reading.
#
# WHY IT EXISTS: uxn's claim is that a ROM gate is structurally immune to the vacuous/silent-fallback
# bug class. That claim is only measurable if the gate's verdicts are RECORDED over time — a gate you
# have not seen FAIL is not a gate (canon), and a gate whose verdicts were never logged has neither
# failed nor passed, only vanished. This log is the evidence surface: a future "did uxn reduce bugs?"
# has rows to subtract from instead of absence.
#
# WHAT IT LOGS (one append-only line per run → $MESH_CLAIMS_LOG):
#   <ISO-TZ> rows=N act_med=X act_cnt55=N dyn_med=X move_med=X beats_hi=X beats_lo=X verdict=AGREE|DIVERGE|NA
# DIVERGE (ROM != twin on a standing claim) is the INCIDENT signal — the measurement arithmetic the
# grinder keys on is wrong. It posts [chat-review] loudly on onset and [fyi] on recovery, like
# mesh-board-check's class-transition posts. NA (empty corpus) is honest — logged, never faked.
#
# State ($MESH_CLAIMS_STATE) holds the last verdict CLASS; mtime touched every run (liveness-touch
# convention), content rewritten only on class change (never a stale value shown as current).
#
# usage:
#   mesh-claims-tick                 snapshot now → log + state + post on transition
#   mesh-claims-tick --test          red-first suite (fixture-driven: GOOD/DIVERGE/NA)
#   mesh-claims-tick --tail [N]      show the last N longitudinal log lines
#
# Env overrides (for test/sandbox): MESH_CLAIMS_LOG, MESH_CLAIMS_STATE, MESH_SERIES_STATS,
#                                   MESH_CLAIMS_FIXTURE (a file to parse instead of running the tool)
set -u

here="$(cd "$(dirname "$0")" && pwd)"
REPO="${MESH_REPO:-$HOME/lte-workstation}"
SERIES="${MESH_SERIES_STATS:-}"
[ -n "$SERIES" ] || { SERIES="$HOME/.local/bin/mesh-series-stats"; [ -x "$SERIES" ] || SERIES="$REPO/scripts/uxn/mesh-series-stats"; }
LOG="${MESH_CLAIMS_LOG:-$HOME/.mesh/claims-state.log}"
STATE="${MESH_CLAIMS_STATE:-$HOME/.mesh/.claims-tick-state}"

# --- parse_snapshot: read mesh-series-stats --claims output from stdin, emit one compact line ---
# The format is stable (produced by mesh-series-stats's own report() function). Extracts the
# load-bearing numbers a future regression question needs: row count, per-axis medians, the
# act>0.55 count (claim 2 — "can never fire"), the beats means (claim 1), and AGREE/DIVERGE.
# Emits to stdout: "rows=N act_med=X act_cnt55=N dyn_med=X move_med=X beats_hi=X beats_lo=X verdict=V"
# or "rows=0 verdict=NA" on an empty/unparseable corpus.
parse_snapshot(){
  awk '
    BEGIN { verdict="NA"; rows=0; diverge=0; act_med=""; act_cnt55=""; dyn_med=""; move_med=""; beats_hi=""; beats_lo="" }
    # source line: "source: ... (643 rows, mtime ...)"
    /^source:.*rows/ {
      if (match($0, /\(([0-9]+) rows/, m)) rows = m[1] + 0
    }
    /DIVERGE/ { diverge = 1 }
    # "  act: n=643 scale=1000  min=0 max=1 median=0.301  cnt(>=0.55)=24  mean=0.3256  [AGREE]"
    /^[[:space:]]+act:.*median=/ && act_med == "" {
      if (match($0, /median=[0-9.]+/)) act_med = substr($0, RSTART+7, RLENGTH-7)
      if (match($0, /cnt\(>=0\.55\)=[0-9]+/)) act_cnt55 = substr($0, RSTART+12, RLENGTH-12)
    }
    /^[[:space:]]+dyn:.*median=/ && dyn_med == "" {
      if (match($0, /median=[0-9.]+/)) dyn_med = substr($0, RSTART+7, RLENGTH-7)
    }
    /^[[:space:]]+move:.*median=/ && move_med == "" {
      if (match($0, /median=[0-9.]+/)) move_med = substr($0, RSTART+7, RLENGTH-7)
    }
    /beats \[score>=55\].*mean=/ {
      if (match($0, /mean=[0-9.]+/)) beats_hi = substr($0, RSTART+5, RLENGTH-5)
    }
    /beats \[score<55\].*mean=/ {
      if (match($0, /mean=[0-9.]+/)) beats_lo = substr($0, RSTART+5, RLENGTH-5)
    }
    END {
      if (diverge) verdict = "DIVERGE"
      else if (rows > 0 && act_med != "") verdict = "AGREE"
      else verdict = "NA"
      if (verdict == "NA")
        printf "rows=%d verdict=NA\n", rows
      else
        printf "rows=%d act_med=%s act_cnt55=%s dyn_med=%s move_med=%s beats_hi=%s beats_lo=%s verdict=%s\n", \
          rows, act_med, act_cnt55, dyn_med, move_med, beats_hi, beats_lo, verdict
    }
  '
}

case "${1:-}" in
  --tail)
    N="${2:-20}"
    tail -n "$N" "$LOG" 2>/dev/null || echo "(no claims log at $LOG yet)"
    exit 0 ;;
  --test)
    d="$(mktemp -d "${TMPDIR:-/tmp}/claims-tick.XXXXXX")" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
    trap 'rm -rf "$d"' EXIT
    rc=0
    fail(){ echo "smoke-test: FAIL ($*)"; rc=1; }

    # FIXTURE 1 — a GOOD claims output with KNOWN values (from the doctrine-sweep n=643 reading).
    # Every number is load-bearing: if the parser drops or misreads one, the longitudinal record
    # silently carries a wrong value that looks plausible — the silent-fallback shape.
    cat >"$d/good" <<'FIX'
source: /tmp/records.log (643 rows, mtime 2026-07-24T02:54:56Z)  ROM: series-stats.rom
note: records.log is pruned per organ each sweep — n moves both ways; re-derive, never quote

claim 2 — CLAUDE.md: "act never exceeds .544 on real material" (so act>0.55 can never fire)
  act: n=643 scale=1000  min=0 max=1 median=0.301  cnt(>=0.55)=24  mean=0.3256  [AGREE]

claim 3 — CLAUDE.md: "real medians are dyn .265 / act .319 / move .141" (n=29)
  dyn: n=643 scale=1000  min=0 max=1 median=0.134  cnt(>=0.5)=9    mean=0.1608  [AGREE]
  act: n=643 scale=1000  min=0 max=1 median=0.301  cnt(>=0.5)=57   mean=0.3256  [AGREE]
  move: n=643 scale=1000  min=0 max=1 median=0.228  cnt(>=0.5)=57  mean=0.2627  [AGREE]

claim 1 — CLAUDE.md: "score>=55 averages 3.6 beats vs 12.2 for everything else" (n=215)
  beats [score>=55]: n=33 scale=1000  min=1 max=26 median=6  cnt(>=1)=33  mean=6.515  [AGREE]
  beats [score<55]:  n=617 scale=1000  min=1 max=44 median=7  cnt(>=1)=617  mean=9.729  [AGREE]
FIX
    snap="$(parse_snapshot <"$d/good")"
    [ -n "$snap" ] || fail "GOOD fixture produced empty snapshot"
    # assert each known value — a dropped field is a silent wrong record
    printf '%s\n' "$snap" | grep -q 'rows=643'       || fail "rows not extracted: $snap"
    printf '%s\n' "$snap" | grep -q 'act_med=0.301'  || fail "act_med not extracted: $snap"
    printf '%s\n' "$snap" | grep -q 'act_cnt55=24'   || fail "act_cnt55 not extracted: $snap"
    printf '%s\n' "$snap" | grep -q 'dyn_med=0.134'  || fail "dyn_med not extracted: $snap"
    printf '%s\n' "$snap" | grep -q 'move_med=0.228' || fail "move_med not extracted: $snap"
    printf '%s\n' "$snap" | grep -q 'beats_hi=6.515' || fail "beats_hi not extracted: $snap"
    printf '%s\n' "$snap" | grep -q 'beats_lo=9.729' || fail "beats_lo not extracted: $snap"
    printf '%s\n' "$snap" | grep -q 'verdict=AGREE'  || fail "GOOD fixture should verdict AGREE: $snap"
    # MUTANT: corrupt one median → the parser must pick up the WRONG value, not the right one
    # (proves it reads the data, not a constant)
    sed 's/median=0.301/median=0.999/' "$d/good" | parse_snapshot | grep -q 'act_med=0.999' \
      || fail "mutant median not reflected — parser is constant, not data-driven"

    # FIXTURE 2 — DIVERGE (ROM != twin). This is the INCIDENT class; the detector must fire.
    sed 's/\[AGREE\]/[DIVERGE]/' "$d/good" | parse_snapshot | grep -q 'verdict=DIVERGE' \
      || fail "DIVERGE fixture not detected — the arithmetic-wrong signal would pass silently"
    # DIVERGE must win over a present corpus (rows>0) — it is checked first
    sed 's/\[AGREE\]/[DIVERGE]/' "$d/good" | parse_snapshot | grep -qv 'verdict=AGREE' \
      || fail "DIVERGE masked by AGREE — an arithmetic disagreement read as agreement"

    # FIXTURE 3 — NA (empty corpus, the current live state when the studio is between cycles).
    cat >"$d/na" <<'FIX'
source: /tmp/records.log (0 rows, mtime 2026-07-24T06:48:03Z)  ROM: series-stats.rom
note: records.log is pruned per organ each sweep — n moves both ways; re-derive, never quote

claim 2 — CLAUDE.md: "act never exceeds .544 on real material"
  act: n/a — no values

claim 3 — CLAUDE.md: "real medians are dyn .265 / act .319 / move .141"
  dyn: n/a — no values
  act: n/a — no values
  move: n/a — no values

claim 1 — CLAUDE.md: "score>=55 averages 3.6 beats vs 12.2"
  beats [score>=55]: n/a — no values
  beats [score<55]:  n/a — no values
FIX
    snap="$(parse_snapshot <"$d/na")"
    printf '%s\n' "$snap" | grep -q 'rows=0'      || fail "NA fixture should show rows=0: $snap"
    printf '%s\n' "$snap" | grep -q 'verdict=NA'  || fail "NA fixture should verdict NA: $snap"

    # DRIVE THE TOOL END-TO-END against the GOOD fixture in a sandbox — assert the log line LANDS
    # and the state file is TOUCHED. A test that only exercises parse_snapshot asserts the parser,
    # not the write path (the drives-only-stubs canon, 974d864). This runs the real main body.
    MESH_CLAIMS_FIXTURE="$d/good" MESH_CLAIMS_LOG="$d/claims.log" MESH_CLAIMS_STATE="$d/.tick-state" \
      MESH_CLAIMS_SANDBOX=1 "$here/mesh-claims-tick" >/dev/null 2>&1
    [ -s "$d/claims.log" ] || fail "sandbox run wrote no log line — the longitudinal record is hollow"
    head -1 "$d/claims.log" | grep -qE '^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*rows=643.*verdict=AGREE$' \
      || fail "log line malformed: $(head -1 "$d/claims.log")"
    [ -f "$d/.tick-state" ] || fail "state file not created on first run"
    grep -q 'AGREE' "$d/.tick-state" || fail "state file missing the verdict class"

    # run AGAIN — the log must now have TWO lines (append every run, never overwrite the history)
    MESH_CLAIMS_FIXTURE="$d/good" MESH_CLAIMS_LOG="$d/claims.log" MESH_CLAIMS_STATE="$d/.tick-state" \
      MESH_CLAIMS_SANDBOX=1 "$here/mesh-claims-tick" >/dev/null 2>&1
    [ "$(wc -l <"$d/claims.log")" -eq 2 ] || fail "log not append-only — history was overwritten ($(wc -l <"$d/claims.log") lines, want 2)"

    [ "$rc" = 0 ] && echo "smoke-test: ok (GOOD/DIVERGE/NA parse + mutant + sandbox log+state + append-only)"
    exit "$rc" ;;
esac

# --- main ---
sandbox="${MESH_CLAIMS_SANDBOX:-0}"

# get the claims output: from a fixture (test) or by running the real tool
if [ -n "${MESH_CLAIMS_FIXTURE:-}" ] && [ -f "${MESH_CLAIMS_FIXTURE:-}" ]; then
  claims_out="$(cat "$MESH_CLAIMS_FIXTURE")"
else
  [ -x "$SERIES" ] || { echo "claims-tick: n/a — no mesh-series-stats at $SERIES (undeployed)" >&2; exit 2; }
  claims_out="$(MESH_SERIES_STATS="$SERIES" "$SERIES" --claims 2>&1)" || true
fi

snap="$(printf '%s' "$claims_out" | parse_snapshot)"
verdict="$(printf '%s' "$snap" | grep -oE 'verdict=[A-Z]+' | cut -d= -f2)"
[ -n "$verdict" ] && verdict="${verdict:-NA}" || verdict=NA

ts="$(date -u +%FT%TZ)"
logline="$ts $snap"

# APPEND to the longitudinal log — every run, never overwrite (this IS the record)
if [ "$sandbox" != 1 ]; then
  mkdir -p "$(dirname "$LOG")"
  printf '%s\n' "$logline" >>"$LOG"
else
  printf '%s\n' "$logline" >>"$LOG"
fi
echo "$logline"

# STATE: last verdict class, touched every run (liveness), content on change (never stale-shown)
if [ -f "$STATE" ]; then
  prev_cls="$(head -1 "$STATE" 2>/dev/null | cut -d' ' -f1)"
else
  prev_cls=""
fi
if [ "$prev_cls" != "$verdict" ]; then
  printf '%s %s rows=%s\n' "$verdict" "$ts" "$(printf '%s' "$snap" | grep -oE 'rows=[0-9]+' | cut -d= -f2)" >"$STATE"
  # post on CLASS TRANSITION — only the actionable ones, never routine AGREE re-confirmations
  if [ "$sandbox" != 1 ] && command -v mesh-chat >/dev/null 2>&1; then
    case "$verdict" in
      DIVERGE)
        # the measurement arithmetic the grinder keys on is wrong — a defect, not a status
        mesh-chat "[chat-review] claims-tick: ${prev_cls:-first-run}->$verdict — ROM != twin on a standing claim; the sound-studio's score/axis calibration is arithmetically unreliable until fixed. owner: mesh-series-stats/genome" >/dev/null || true ;;
      *)
        # recovery from DIVERGE, or first corpus fill — quieter [fyi], never routine
        [ "${prev_cls:-}" = DIVERGE ] \
          && mesh-chat "[fyi] claims-tick: DIVERGE->$verdict — arithmetic agreement restored ($snap)" >/dev/null || true ;;
    esac
  fi
fi
# liveness-touch: mtime refreshed every run regardless of value change (conditional-write false-STALE canon)
if [ "$sandbox" != 1 ]; then
  command -v mesh-state-touch >/dev/null 2>&1 && mesh-state-touch "$STATE" || touch "$STATE"
fi

case "$verdict" in
  DIVERGE) exit 1 ;;   # arithmetic wrong — a RED for the consuming reflex-health/doctor
  NA)      exit 2 ;;   # honest n/a — empty corpus, not a fake verdict
  *)       exit 0 ;;
esac
