#!/usr/bin/env bash
# test-sexpr-gates — gate for gates-as-DATA stage 1 (uxn-sexpr-customers, 2026-07-23).
#
# CONTRACT: the band gate and the hysteresis gate exist as s-expr DATA lines in ./sexpr-gates —
# NO gate-specific ROM. The one executor is the pinned lisp-eval.rom (the fixed point); the pin
# lives IN the data file (`# evaluator-sha1:`) and mesh-sexpr-gate is marshaling only: resolve
# the row, bind params to NATURALS (a value is data, never code — non-numeric args refused, the
# substitution injection edge), hash-then-execute the evaluator, NA/rc2 passthrough on domain.
#   band-gate x lo hi      → 0 below · 1 in band · 2 above   (richer than band-gate.rom's OK/RED)
#   hyst-gate x lo hi prev → 1 ALERT · 0 CLEAR · prev-valued HOLD — PURE: prev arrives as data.
# Fixture rows use the REAL consumer bands (band-fixtures nvme-c 20..70, battery 20..80) and the
# therm-watch alert/recovery edges — both edges through ONE gate line (both-edges-same-gate).
# RED-first is on the DATA: a template line with one comparison flipped must FAIL the same
# fixtures (proves the rows discriminate the expression, not the evaluator). The evaluator
# itself already has its own mutant gate (test-lisp-eval).
set -u
here="$(cd "$(dirname "$0")" && pwd)"
cd "$here"
[ -x bin/uxncli ] || ./build.sh >/dev/null 2>&1 || { echo "sexpr-gates-test: n/a (no uxncli and toolchain build failed)" >&2; exit 2; }
[ -f lisp-eval.rom ] || { echo "sexpr-gates-test: n/a (no lisp-eval.rom)" >&2; exit 2; }
rc=0
tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT
fail(){ echo "  FAIL: $*"; rc=1; }

[ -x mesh-sexpr-gate ] || { echo "sexpr-gates-test: FAIL (no mesh-sexpr-gate shim)"; exit 1; }
[ -f sexpr-gates ]     || { echo "sexpr-gates-test: FAIL (no sexpr-gates data file)"; exit 1; }

# The pin in the DATA file must name the evaluator actually committed (hash-then-execute's pin
# side; the execute side is asserted below by tamper-refusal).
pin="$(sed -n 's/^# evaluator-sha1:[[:space:]]*\([0-9a-f]\{40\}\).*/\1/p' sexpr-gates | head -1)"
actual="$(sha1sum lisp-eval.rom | cut -d' ' -f1)"
[ -n "$pin" ]           || fail "sexpr-gates carries no '# evaluator-sha1:' pin line"
[ "$pin" = "$actual" ]  || fail "pin $pin != committed lisp-eval.rom $actual"

run(){ # $1=gates-file, rest = shim args → stdout verdict, rc passthrough
  local f="$1"; shift
  MESH_SEXPR_GATES="$f" ./mesh-sexpr-gate "$@" 2>/dev/null
}

# fixture rows: gate args… want  (want NA ⇒ rc must be 2, else rc 0)
fixtures(){ # $1=gates-file → prints failing rows, returns nonzero if any
  local f="$1" bad=0 v urc
  while read -r gate a b c d want; do
    # if/else, NOT `[ … ] && v=$(…) || v=$(…)` — an rc2 assignment would fall through to the
    # 4-arg branch and clobber the verdict (caught RED here 2026-07-23).
    if [ "$d" = - ]; then v="$(run "$f" "$gate" "$a" "$b" "$c")"; urc=$?
    else                  v="$(run "$f" "$gate" "$a" "$b" "$c" "$d")"; urc=$?
    fi
    [ "$v" = "$want" ] || { echo "  row: $gate $a $b $c $d → want $want got '${v:-}' rc=$urc"; bad=1; }
    if [ "$want" = NA ]; then
      [ "$urc" = 2 ] || { echo "  row: $gate $a $b $c $d → NA must be rc2, got rc=$urc"; bad=1; }
    else
      [ "$urc" = 0 ] || { echo "  row: $gate $a $b $c $d → value must be rc0, got rc=$urc"; bad=1; }
    fi
  done <<'ROWS'
band-gate 10 20 70 - 0
band-gate 20 20 70 - 1
band-gate 55 20 70 - 1
band-gate 70 20 70 - 1
band-gate 75 20 70 - 2
band-gate 19 20 80 - 0
band-gate 80 20 80 - 1
band-gate 92 20 80 - 2
band-gate 70000 20 70 - NA
hyst-gate 75 60 70 0 1
hyst-gate 75 60 70 1 1
hyst-gate 55 60 70 1 0
hyst-gate 55 60 70 0 0
hyst-gate 65 60 70 1 1
hyst-gate 65 60 70 0 0
hyst-gate 70 60 70 0 0
hyst-gate 60 60 70 1 1
hyst-gate 70000 60 70 0 NA
ROWS
  return $bad
}

if fixtures sexpr-gates; then
  echo "PASS: committed data lines satisfy the band + hysteresis truth tables"
else
  echo "FAIL: committed sexpr-gates violates the fixture rows"; rc=1
fi

# marshaling honesty: every refusal is rc2 + a WHY on stderr, never a fake number.
na_case(){ # $1=label, rest = env+cmd; want rc2 + non-empty stderr + no verdict on stdout
  local label="$1"; shift
  local out err urc
  out="$("$@" 2>"$tmp/err")" && urc=0 || urc=$?
  err="$(cat "$tmp/err")"
  [ "$urc" = 2 ] && [ -n "$err" ] && [ -z "$out" ] \
    || fail "$label → want rc2+stderr+empty stdout, got rc=$urc out='${out:-}'"
}
na_case "unknown gate"        ./mesh-sexpr-gate no-such-gate 1 2 3
na_case "arity short"         ./mesh-sexpr-gate band-gate 5 20
na_case "arity long"          ./mesh-sexpr-gate band-gate 5 20 70 9
na_case "non-numeric arg"     ./mesh-sexpr-gate band-gate '(+ 1 1)' 20 70
na_case "negative arg"        ./mesh-sexpr-gate band-gate -5 20 70
na_case "absent data file"    env MESH_SEXPR_GATES=/nonexistent ./mesh-sexpr-gate band-gate 5 20 70
na_case "absent evaluator"    env MESH_SEXPR_ROM=/nonexistent/lisp-eval.rom ./mesh-sexpr-gate band-gate 5 20 70

# hash-then-execute: a TAMPERED evaluator under the data file's pin must be refused PRE-exec
# (rc2, no verdict) — the pin is checked against the ROM actually loaded, never trusted.
cp lisp-eval.rom "$tmp/tamper.rom"; printf '\x00' >> "$tmp/tamper.rom"
out="$(MESH_SEXPR_ROM="$tmp/tamper.rom" ./mesh-sexpr-gate band-gate 5 20 70 2>"$tmp/err")" && urc=0 || urc=$?
if [ "$urc" = 2 ] && [ -z "$out" ] && grep -qi mismatch "$tmp/err"; then
  echo "PASS: tampered evaluator under the pin refused pre-exec (rc2, mismatch stated)"
else
  echo "FAIL: tampered evaluator → want rc2+mismatch+no verdict, got rc=$urc out='${out:-}'"; rc=1
fi

# RED-first on the DATA: flip ONE comparison per template; the SAME fixture rows must fail.
sed 's/(<= x hi)/(< x hi)/' sexpr-gates > "$tmp/mut-band"
cmp -s sexpr-gates "$tmp/mut-band" && fail "band mutation did not apply (template drifted?)"
if fixtures "$tmp/mut-band" >/dev/null; then
  echo "FAIL: fixtures passed a band line with <= flipped to < — rows assert nothing"; rc=1
else
  echo "PASS: band data line with <= flipped fails the rows (seen RED)"
fi
sed 's/(> x hi)/(>= x hi)/' sexpr-gates > "$tmp/mut-hyst"
cmp -s sexpr-gates "$tmp/mut-hyst" && fail "hyst mutation did not apply (template drifted?)"
if fixtures "$tmp/mut-hyst" >/dev/null; then
  echo "FAIL: fixtures passed a hyst line with > flipped to >= — rows assert nothing"; rc=1
else
  echo "PASS: hyst data line with > flipped fails the rows (seen RED)"
fi

[ "$rc" = 0 ] && echo "sexpr-gates-test: ok" || echo "sexpr-gates-test: FAIL"
exit $rc
