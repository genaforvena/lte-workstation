( arith32.tal — 32-bit double-word arithmetic on a 16-bit machine. )
(                                                                                        )
( WHY THIS EXISTS: spearman.rom could only reduce a 58-row window; the full series was )
( reduced by the awk twin. That means the ROM was not doing the reduction — the class )
( "reduce a series to a calibrated number" was a demo, not a capability. The ceiling was )
( never the algorithm, it was the word size: sum-of-squares and (n^3-n)/6 both leave 16 )
( bits early. These primitives lift it. )
(                                                                                        )
( REPRESENTATION: a 32-bit value is two shorts in the zero page, HI first then LO, four )
( bytes apart. The register file is fixed [not stack-passed] so the carry logic stays )
( legible — the carry between the low and the high word is the one thing here that must )
( not be silently wrong, and it is asserted from both sides in arith32-test.tal. )
(                                                                                        )
( zero page: A=40/42  B=44/46  t0=48 t1=4a  X=4c Y=4e  t2=50 t3=52 t4=54 t5=56 t6=58 )
(            sv-lo=5a sv-hi=5c )
(                                                                                        )
( CARRY DETECTION is unsigned-wrap detection: a+b wrapped exactly when the result is )
( LESS than either addend. There is no carry flag on this machine, so that comparison IS )
( the carry. Drop it and the high word simply never advances — a silent, plausible, )
( always-too-small answer, which is the failure mode the doctrine names by name. )

@w-add ( -- )   ( A = A + B )
    #42 LDZ2 #46 LDZ2 ADD2 #48 STZ2          ( t0 = Alo + Blo, wrapping )
    #48 LDZ2 #42 LDZ2 LTH2 #00 SWP           ( carry = t0 < Alo ? 1 : 0, as a short )
    #40 LDZ2 #44 LDZ2 ADD2 ADD2 #40 STZ2     ( Ahi = Ahi + Bhi + carry )
    #48 LDZ2 #42 STZ2                        ( Alo = t0 )
    JMP2r

@w-sub ( -- )   ( A = A - B )
    #42 LDZ2 #46 LDZ2 LTH2 #00 SWP #48 STZ2  ( t0 = borrow = Alo < Blo ? 1 : 0 )
    #42 LDZ2 #46 LDZ2 SUB2 #4a STZ2          ( t1 = Alo - Blo, wrapping )
    #40 LDZ2 #44 LDZ2 SUB2 #48 LDZ2 SUB2 #40 STZ2   ( Ahi = Ahi - Bhi - borrow )
    #4a LDZ2 #42 STZ2
    JMP2r

@w-cmp ( -- flag )   ( 1 iff A >= B )
    #40 LDZ2 #44 LDZ2 GTH2 ,&yes JCN
    #40 LDZ2 #44 LDZ2 LTH2 ,&no JCN
    #42 LDZ2 #46 LDZ2 LTH2 ,&no JCN
    &yes #01 JMP2r
    &no  #00 JMP2r

( w-mul16 — the widening multiply the ISA does not have. MUL2 keeps only the low 16 bits, )
( so a 16x16 product is split into four 8x8 partials, each of which cannot overflow a )
( short [255*255 = 65025], and reassembled. The middle term al*bh + ah*bl is SEVENTEEN )
( bits wide, so its own carry is captured too — forgetting it costs exactly 0x10000 and )
( only on some inputs, which is why the test pins a case where that term overflows. )
@w-mul16 ( -- )   ( A = X * Y, both 16-bit )
    #4d LDZ #00 SWP  #4f LDZ #00 SWP  MUL2  #48 STZ2   ( t0 = al*bl )
    #4d LDZ #00 SWP  #4e LDZ #00 SWP  MUL2  #4a STZ2   ( t1 = al*bh )
    #4c LDZ #00 SWP  #4f LDZ #00 SWP  MUL2  #50 STZ2   ( t2 = ah*bl )
    #4c LDZ #00 SWP  #4e LDZ #00 SWP  MUL2  #52 STZ2   ( t3 = ah*bh )
    #4a LDZ2 #50 LDZ2 ADD2 #54 STZ2                    ( t4 = mid = t1 + t2, wrapping )
    #54 LDZ2 #4a LDZ2 LTH2 #00 SWP #56 STZ2            ( t5 = mid's 17th bit )
    #52 LDZ2 #54 LDZ2 #08 SFT2 ADD2 #56 LDZ2 #80 SFT2 ADD2 #40 STZ2
                                                       ( Ahi = t3 + (mid>>8) + (bit17<<8) )
    #48 LDZ2 #54 LDZ2 #00ff AND2 #80 SFT2 ADD2 #58 STZ2  ( t6 = t0 + ((mid&0xff)<<8) )
    #58 LDZ2 #48 LDZ2 LTH2 #00 SWP #40 LDZ2 ADD2 #40 STZ2 ( and ITS carry into Ahi )
    #58 LDZ2 #42 STZ2
    JMP2r

( w-mul32 — A = A * Y. The high word's product only ever lands in the high word [it is )
( already scaled by 2^16], so only its low 16 bits can matter; anything above that has )
( left the 32-bit range and is the caller's domain problem, not a carry to chase. )
@w-mul32 ( -- )
    #42 LDZ2 #5a STZ2                ( save Alo )
    #40 LDZ2 #5c STZ2                ( save Ahi )
    #5a LDZ2 #4c STZ2                ( X = Alo )
    ;w-mul16 JSR2                      ( A = Alo * Y, full 32 bits )
    #5c LDZ2 #4e LDZ2 MUL2 #40 LDZ2 ADD2 #40 STZ2   ( Ahi += (Ahi_saved * Y) low 16 )
    JMP2r

( w-accdigit — the decimal-input step, A = A*10 + digit. Used by every ROM that reads a )
( 32-bit value off the console, and it dogfoods w-mul32 + w-add on every single token. )
@w-accdigit ( digit* -- )
    #46 STZ2                         ( Blo = digit )
    #0000 #44 STZ2                   ( Bhi = 0 )
    #000a #4e STZ2                   ( Y = 10 )
    ;w-mul32 JSR2
    ;w-add JSR2
    JMP2r
