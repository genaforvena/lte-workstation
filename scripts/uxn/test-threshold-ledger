#!/usr/bin/env bash
# test-threshold-ledger — gate for uxn-threshold-ledger (gates-as-data stage 2, 2026-07-23).
#
# CONTRACT: the scattered inline magic-number predicates live as ONE data file
# (./threshold-ledger), 4-field rows `name | params | consts | template` — the calibrated
# CONSTANTS sit in the consts column as k=v pairs, so recalibration is a data-line diff,
# never a script edit. The one executor is the pinned lisp-eval.rom (pin IN the ledger,
# hash-then-execute via mesh-sexpr-gate, which learns consts-substitution + a `--const`
# data-query verb here). mesh-rom-calibrate --ledger drives every fixture row through BOTH
# the ROM path and a native-shell twin (twin structure hardcoded, twin constants read from
# the same consts column — so a recalibration moves both, and DIVERGE isolates expression/
# evaluator drift, with the 16-bit overflow class surfacing as DOMAIN, never a crash).
# Rows v1:
#   clear-fresh  age             fresh=900       1 FRESH · 0 STALE   (mesh-clear budget)
#   load-gate    l1c hour nproc  k=90 q0=1 q1=6  0 SKIP-quiet · 1 PROCEED · 2 SKIP-load
#                                                (thr = nproc*k centi-load = nproc*0.9)
#   lease-margin cad lease       k=2             1 OK · 0 RED        (lease >= k*cad)
# RED-first is on the DATA both ways: a mutated CONST must fail the fixture rows (the want
# column discriminates the numbers), and a mutated TEMPLATE comparison must DIVERGE under
# calibrate (the twin discriminates the expression). Consumers resolve their defaults from
# the ledger (env > ledger > inline fallback): mesh-clear --fresh-budget and
# mesh-load-gate --thresholds are the observable artifacts of that resolution.
set -u
here="$(cd "$(dirname "$0")" && pwd)"
cd "$here"
[ -x bin/uxncli ] || ./build.sh >/dev/null 2>&1 || { echo "threshold-ledger-test: n/a (no uxncli and toolchain build failed)" >&2; exit 2; }
[ -f lisp-eval.rom ] || { echo "threshold-ledger-test: n/a (no lisp-eval.rom)" >&2; exit 2; }
rc=0
tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT
fail(){ echo "  FAIL: $*"; rc=1; }

[ -f threshold-ledger ]   || { echo "threshold-ledger-test: FAIL (no threshold-ledger data file)"; exit 1; }
[ -f threshold-fixtures ] || { echo "threshold-ledger-test: FAIL (no threshold-fixtures)"; exit 1; }

# --- A. pin: the ledger names the evaluator actually committed ---------------------------
pin="$(sed -n 's/^# evaluator-sha1:[[:space:]]*\([0-9a-f]\{40\}\).*/\1/p' threshold-ledger | head -1)"
actual="$(sha1sum lisp-eval.rom | cut -d' ' -f1)"
[ -n "$pin" ]          || fail "threshold-ledger carries no '# evaluator-sha1:' pin line"
[ "$pin" = "$actual" ] || fail "pin $pin != committed lisp-eval.rom $actual"

run(){ # $1=ledger-file, rest = shim args → stdout verdict, rc passthrough
  local f="$1"; shift
  MESH_SEXPR_GATES="$f" ./mesh-sexpr-gate "$@" 2>/dev/null
}

# --- B. --const: the data-query verb consumers resolve their defaults through ------------
v="$(run threshold-ledger --const clear-fresh fresh)" || fail "--const clear-fresh fresh rc!=0"
[ "$v" = 900 ] || fail "--const clear-fresh fresh: want 900, got '$v'"
v="$(run threshold-ledger --const load-gate q1)"; [ "$v" = 6 ] || fail "--const load-gate q1: want 6, got '$v'"
v="$(run threshold-ledger --const load-gate k)";  [ "$v" = 90 ] || fail "--const load-gate k: want 90, got '$v'"
v="$(run threshold-ledger --const lease-margin k)"; [ "$v" = 2 ] || fail "--const lease-margin k: want 2, got '$v'"
run threshold-ledger --const clear-fresh nosuch >/dev/null; [ $? -eq 2 ] || fail "--const unknown const must rc=2"
run threshold-ledger --const nosuch fresh >/dev/null;       [ $? -eq 2 ] || fail "--const unknown gate must rc=2"

# --- C. every fixture row renders its want (NA ⇒ rc must be 2) ---------------------------
fixture_pass(){ # $1=ledger-file → 0 all rows green, 1 any red (prints first red)
  local f="$1" line g want out urc
  while IFS= read -r line; do
    case "$line" in ''|\#*) continue;; esac
    set -- $line
    g="$1"; shift
    want="${!#}"                       # last word
    set -- "${@:1:$(($#-1))}"          # args without want
    out="$(run "$f" "$g" "$@")"; urc=$?
    if [ "$want" = NA ]; then
      [ "$urc" -eq 2 ] && [ "$out" = NA ] || { echo "row '$line': want NA/rc2, got '$out'/rc$urc"; return 1; }
    else
      [ "$urc" -eq 0 ] && [ "$out" = "$want" ] || { echo "row '$line': want $want, got '$out'/rc$urc"; return 1; }
    fi
  done < threshold-fixtures
  return 0
}
msg="$(fixture_pass threshold-ledger)" || fail "fixtures vs committed ledger: $msg"

# --- D. RED on the DATA: a mutated CONST must fail the same fixtures ---------------------
mutant_red(){ # $1=sed-mutation $2=label ("<gate> <what>") — fixtures must go RED against the mutant
  printf '%s\n' "${2%% *}" >> "$tmp/mutated-gates"   # coverage bookkeeping, see the sweep below
  sed "$1" threshold-ledger > "$tmp/mut" || { fail "$2: sed failed"; return; }
  cmp -s threshold-ledger "$tmp/mut" && { fail "$2: mutation was a no-op (pattern missed)"; return; }
  fixture_pass "$tmp/mut" >/dev/null && fail "$2: fixtures still green against mutated ledger — rows do not discriminate the constant"
}
: > "$tmp/mutated-gates"
mutant_red 's/fresh=900/fresh=899/' "clear-fresh fresh 900→899"
mutant_red 's/k=90/k=89/'           "load-gate k 90→89"
mutant_red 's/q1=6/q1=7/'           "load-gate q1 6→7"
mutant_red 's/k=2/k=3/'             "lease-margin k 2→3"
# stage 4a rows — one mutant per gate (patterns chosen unique per line; lo=25 and hi=80
# repeat across rows, so those gates mutate a const that appears nowhere else)
mutant_red 's/u1=300/u1=299/'       "body-thermal u1 300→299 (COOL rise edge)"
mutant_red 's/s2=330/s2=329/'       "body-thermal s2 330→329 (snap NORMAL ceiling)"
mutant_red 's/lo=450/lo=451/'       "host-therm lo 450→451"
mutant_red 's/mid=50/mid=51/'       "swap-pressure mid 50→51"
mutant_red 's/mid=30/mid=31/'       "airtime-busy mid 30→31"
mutant_red 's/hi=70/hi=71/'         "backlight-level hi 70→71"
mutant_red 's/lo=30/lo=31/'         "screen-bright lo 30→31"
mutant_red 's/crit=5 /crit=6 /'     "power-charge crit 5→6"
mutant_red 's/low=25/low=26/'       "battery-charge low 25→26"
mutant_red 's/eol=40/eol=41/'       "battery-wear eol 40→41"
mutant_red 's/floor=50/floor=49/'   "hw-wear-floor 50→49"
mutant_red 's/budget=900/budget=899/' "diary-stale budget 900→899"
mutant_red 's/max=90/max=91/'       "vitals-disk max 90→91"
mutant_red 's/max=95/max=96/'       "vitals-mem max 95→96"
mutant_red 's/max=85/max=86/'       "vitals-temp max 85→86"
mutant_red 's/k=400/k=401/'         "vitals-load k 400→401"
# stage 4b/4c + iter-2 rows. These four were minted WITHOUT mutants (the list is hand-kept, and a
# new row slips in silently) — that drift is what the coverage sweep below now makes impossible.
mutant_red 's/max=92/max=93/'       "tick-therm max 92→93"
mutant_red 's/max=86/max=87/'       "tick-offload max 86→87"
mutant_red 's/act=300/act=301/'     "vpn-peer-fresh act 300→301"
mutant_red 's/mem=10/mem=11/'       "node-pressure mem 10→11"
mutant_red 's/swap=5 /swap=6 /'     "node-pressure swap 5→6"
mutant_red 's/crit=98/crit=99/'     "therm-alarm crit 98→99"

# --- D2. COVERAGE: every ledger row must be proven by SOME mechanism ---------------------
# The mutant list above is hand-kept, so a newly-minted row inherits no RED proof that its
# constants drive anything — exactly how tick-therm/tick-offload/vpn-peer-fresh sat unmutated
# from the day they landed while this test reported a confident count. The count is not the
# assertion; the SET is. A row whose consts nobody mutates is a row whose calibration is
# decorative. Two legitimate homes, so the sweep partitions rather than blanket-demanding:
#   · twin-backed rows  — fixtures in threshold-fixtures ⇒ MUST own a const mutant here
#     (fixture_pass reads that file, so a mutant on any other row would be a silent no-op)
#   · ADMITTED rows     — generated, no independent shell twin, fixtures in admitted-fixtures;
#     their liveness gate is `mesh-gate-admission --recheck`, so the demand is that they
#     actually carry fixtures THERE (disk-free-floor is the live case)
# A row in NEITHER file is covered by nothing at all and fails outright.
_missing=""; _uncovered=""
while IFS='|' read -r _n _rest; do
  _n="$(printf '%s' "$_n" | tr -d '[:space:]')"
  [ -n "$_n" ] || continue
  case "$_n" in \#*) continue ;; esac
  if grep -qE "^$_n[[:space:]]" threshold-fixtures; then
    grep -qx "$_n" "$tmp/mutated-gates" || _missing="$_missing $_n"
  elif ! grep -qE "^$_n[[:space:]]" admitted-fixtures 2>/dev/null; then
    _uncovered="$_uncovered $_n"
  fi
done < <(grep -vE '^[[:space:]]*(#|$)' threshold-ledger)
[ -z "$_missing" ]   || fail "twin-backed ledger row(s) with NO const mutant — their constants are never proven to drive a fixture:$_missing"
[ -z "$_uncovered" ] || fail "ledger row(s) with fixtures in NEITHER threshold-fixtures nor admitted-fixtures — nothing exercises them:$_uncovered"

# --- E. injection + arity on the consts path ---------------------------------------------
run threshold-ledger clear-fresh '(foo)' >/dev/null; [ $? -eq 2 ] || fail "non-natural arg must be refused rc=2 (injection edge)"
run threshold-ledger clear-fresh 1 2 >/dev/null;     [ $? -eq 2 ] || fail "wrong arity must rc=2"

# --- F. calibrate --ledger: ROM vs shell twin over every fixture row, AGREE/DOMAIN only --
cal="$here/mesh-rom-calibrate"
[ -x "$cal" ] || fail "no mesh-rom-calibrate"
out="$(MESH_CAL_SANDBOX=1 MESH_CAL_LOG="$tmp/cal.log" "$cal" --ledger threshold-fixtures 2>&1)"; crc=$?
[ "$crc" -eq 0 ] || fail "calibrate --ledger rc=$crc (want 0 = no DIVERGE): $out"
echo "$out" | grep -q DIVERGE && fail "calibrate --ledger diverged on committed ledger: $out"
echo "$out" | grep -q DOMAIN  || fail "calibrate --ledger shows no DOMAIN row — the 16-bit overflow fixture is missing or mis-handled"
[ -s "$tmp/cal.log" ] || fail "calibrate --ledger wrote nothing to the calibration ledger"

# --- F2. the cron entrypoint (bare invocation) rides the ledger too — fixture rows must
# appear next to the fleet lease pairs, or the daily calibration never sees the ledger ----
out="$(MESH_CAL_SANDBOX=1 MESH_CAL_LOG="$tmp/cal-cron.log" "$cal" 2>&1)"; crc=$?
[ "$crc" -eq 0 ] || fail "bare calibrate rc=$crc: $out"
echo "$out" | grep -q 'predicate=lease-gate'  || fail "bare calibrate lost the fleet lease pass"
echo "$out" | grep -q 'predicate=clear-fresh' || fail "bare calibrate does not ride the threshold ledger — cron never calibrates it"

# --- G. RED on the EXPRESSION: a flipped comparison must DIVERGE under the twin ----------
sed 's/(<= age fresh)/(< age fresh)/' threshold-ledger > "$tmp/mut-expr"
cmp -s threshold-ledger "$tmp/mut-expr" && fail "expr mutation was a no-op"
out="$(MESH_CAL_SANDBOX=1 MESH_CAL_LOG="$tmp/cal2.log" MESH_SEXPR_GATES="$tmp/mut-expr" "$cal" --ledger threshold-fixtures 2>&1)"; crc=$?
[ "$crc" -eq 1 ] || fail "calibrate vs flipped-comparison ledger rc=$crc (want 1 = DIVERGE)"
echo "$out" | grep -q 'DIVERGE' || fail "flipped comparison did not DIVERGE — the twin does not discriminate the expression"
echo "$out" | grep -q 'would-post' || fail "DIVERGE in sandbox must would-post, not stay silent"
# same proof on the stage-4a hysteresis row: widen HOT's recovery edge to <= — the twin must split
sed 's/(< t d3) 2 3/(<= t d3) 2 3/' threshold-ledger > "$tmp/mut-hyst"
cmp -s threshold-ledger "$tmp/mut-hyst" && fail "hyst expr mutation was a no-op"
out="$(MESH_CAL_SANDBOX=1 MESH_CAL_LOG="$tmp/cal3.log" MESH_SEXPR_GATES="$tmp/mut-hyst" "$cal" --ledger threshold-fixtures 2>&1)"; crc=$?
[ "$crc" -eq 1 ] || fail "calibrate vs flipped hyst recovery edge rc=$crc (want 1 = DIVERGE)"
echo "$out" | grep -q 'predicate=body-thermal.*DIVERGE' || fail "hyst expr mutant did not DIVERGE on a body-thermal row"

# --- H. consumer resolution: mesh-clear budget = env > ledger > inline 900 ---------------
mc="$(cd .. && pwd)/mesh-clear"
[ -x "$mc" ] || fail "no ../mesh-clear"
v="$(MESH_THRESHOLD_LEDGER="$here/threshold-ledger" "$mc" --fresh-budget 2>/dev/null)"
[ "$v" = 900 ] || fail "mesh-clear --fresh-budget vs ledger: want 900, got '$v'"
sed 's/fresh=900/fresh=123/' threshold-ledger > "$tmp/recal"
v="$(MESH_THRESHOLD_LEDGER="$tmp/recal" "$mc" --fresh-budget 2>/dev/null)"
[ "$v" = 123 ] || fail "recalibrated ledger (fresh=123) must reach mesh-clear, got '$v'"
v="$(MESH_THRESHOLD_LEDGER="$tmp/absent" "$mc" --fresh-budget 2>/dev/null)"
[ "$v" = 900 ] || fail "absent ledger must fall back to inline 900, got '$v'"
sed 's/fresh=900/fresh=12x/' threshold-ledger > "$tmp/corrupt"
v="$(MESH_THRESHOLD_LEDGER="$tmp/corrupt" "$mc" --fresh-budget 2>/dev/null)"
[ "$v" = 900 ] || fail "corrupt ledger value (12x) must fall back to 900, got '$v'"
v="$(MESH_CLEAR_FRESH_SECS=5 MESH_THRESHOLD_LEDGER="$here/threshold-ledger" "$mc" --fresh-budget 2>/dev/null)"
[ "$v" = 5 ] || fail "explicit env must beat the ledger, got '$v'"

# --- I. consumer resolution: mesh-load-gate thresholds = env > ledger > inline -----------
mlg="$(cd .. && pwd)/mesh-load-gate"
[ -x "$mlg" ] || fail "no ../mesh-load-gate"
np="$(nproc)"
want_thr="$(awk -v n="$np" 'BEGIN{printf "%.1f", n*90/100}')"
v="$(MESH_THRESHOLD_LEDGER="$here/threshold-ledger" "$mlg" --thresholds 2>/dev/null)"
[ "$v" = "thr=$want_thr quiet=1-6 floor=2048" ] || fail "load-gate --thresholds vs ledger: want 'thr=$want_thr quiet=1-6 floor=2048', got '$v'"
sed -e 's/k=90/k=45/' -e 's/q0=1/q0=2/' -e 's/q1=6/q1=7/' -e 's/floor=2048/floor=1024/' threshold-ledger > "$tmp/recal2"
want_thr2="$(awk -v n="$np" 'BEGIN{printf "%.1f", n*45/100}')"
v="$(MESH_THRESHOLD_LEDGER="$tmp/recal2" "$mlg" --thresholds 2>/dev/null)"
[ "$v" = "thr=$want_thr2 quiet=2-7 floor=1024" ] || fail "recalibrated ledger must reach load-gate, got '$v' (want 'thr=$want_thr2 quiet=2-7 floor=1024')"
v="$(MESH_THRESHOLD_LEDGER="$tmp/absent" "$mlg" --thresholds 2>/dev/null)"
want_fb="$(awk -v n="$np" 'BEGIN{printf "%.1f", n*0.9}')"
[ "$v" = "thr=$want_fb quiet=1-6 floor=2048" ] || fail "absent ledger: load-gate must fall back inline (want 'thr=$want_fb quiet=1-6 floor=2048'), got '$v'"
v="$(MESH_LOAD_GATE_MAX=3 MESH_QUIET_HOURS=0-5 MESH_DISK_FLOOR_MB=7777 MESH_THRESHOLD_LEDGER="$here/threshold-ledger" "$mlg" --thresholds 2>/dev/null)"
[ "$v" = "thr=3 quiet=0-5 floor=7777" ] || fail "explicit env must beat the ledger in load-gate, got '$v'"

# The mutant count is COUNTED, never typed: it read "19" while five rows had landed since, which is
# the same hand-kept-list rot the D2 coverage sweep exists to catch. A number in a summary is a claim.
_nmut=$(sort -u "$tmp/mutated-gates" 2>/dev/null | wc -l); _nrow=$(grep -cvE '^[[:space:]]*(#|$)' threshold-ledger)
[ "$rc" -eq 0 ] && echo "threshold-ledger-test: ok (pin + --const + fixtures + $(wc -l < "$tmp/mutated-gates") const-mutants red over $_nmut/$_nrow rows + every row covered (mutant or admitted-fixtures) + injection/arity + calibrate agree/DOMAIN + 2 expr-mutants DIVERGE + both consumers resolve env>ledger>inline)"
exit "$rc"
