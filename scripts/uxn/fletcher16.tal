( fletcher16.tal — a rolling checksum ROM over stdin: two running sums mod 255.        )
(                                                                                        )
( WHY A ROM, when `cksum`/`sha1sum` exist: the point is not the checksum, it is that     )
( the checksum FUNCTION is a byte-identical, pinned, hash-then-execute artifact — the     )
( same ROM on x86, ARM and the phone computes the same digit, so an append-only log's     )
( chain recomputed on ANY node exposes truncation / reorder / a rewritten line. The mesh  )
( has no integrity on its coordination memory today; a pruned window, a clobbered log, a  )
( --test that forged its own liveness line all pass unseen. This makes "append-only"      )
( VERIFIABLE rather than merely conventional.                                             )
(                                                                                        )
( Fletcher-16, not a plain sum: two running sums (s1 += byte; s2 += s1) so REORDER is     )
( caught — swapping two lines changes s2 though the byte-sum is identical. mod 255 (not    )
( 256) so a run of 0x00 still advances the position weight. Threat model is ACCIDENT —     )
( rot, truncation, a clobbered/forged log — not an adversary (that wants a 32-bit FNV,     )
( the buildable next step: arith32.tal already has w-mul32/w-add).                         )
(                                                                                        )
( in  : arbitrary bytes on stdin.                                                         )
( out : 4 hex chars [s2 s1] + newline, halt 0. EOF is Console/type==4 (uxncli).            )
(                                                                                        )
( zero-page: s1=01 s2=02 )

|0100
    #00 #01 STZ             ( s1 = 0 )
    #00 #02 STZ             ( s2 = 0 )
    ;on-console #10 DEO2    ( install Console/vector )
    BRK

@on-console
    #17 DEI #04 NEQ ,&live JCN   ( Console/type != 4 -> a real byte; else fall to EOF )
    ;eof JMP2
    &live
    #12 DEI #00 SWP             ( byte -> short [00 b] )
    #01 LDZ #00 SWP ADD2        ( sum1 = s1 + byte  [0..509] )
    DUP2 #00fe GTH2 ,&m1 JCN    ( sum1 > 254 -> subtract 255 (mod 255) )
    ,&s1done JMP
    &m1 #00ff SUB2
    &s1done
    NIP #01 STZ                 ( s1 = low byte of sum1 )
    #02 LDZ #00 SWP             ( s2 as short )
    #01 LDZ #00 SWP ADD2        ( sum2 = s2 + s1  [0..508] )
    DUP2 #00fe GTH2 ,&m2 JCN
    ,&s2done JMP
    &m2 #00ff SUB2
    &s2done
    NIP #02 STZ                 ( s2 = low byte of sum2 )
    BRK

@eof
    #02 LDZ ;emit-hex JSR2      ( s2 high )
    #01 LDZ ;emit-hex JSR2      ( s1 low )
    #0a #18 DEO                 ( newline )
    #80 #0f DEO                 ( halt, exit 0 )
    BRK

( emit-hex — print one byte as two hex chars )
@emit-hex ( byte -- )
    DUP #04 SFT ;hex-digit JSR2     ( high nibble )
    #0f AND ;hex-digit JSR2         ( low nibble )
    JMP2r

@hex-digit ( nibble -- )
    DUP #0a LTH ,&num JCN
    #0a SUB #61 ADD #18 DEO JMP2r   ( a..f )
    &num #30 ADD #18 DEO JMP2r      ( 0..9 )
