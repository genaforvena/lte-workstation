( hop-serve.tal — the RECEIVING half of the hop's net lane. The far node needs NO SHELL. )
(                                                                                        )
( The pipe lane's receiver is mesh-uxn-hop under sh: it reads a uxp1 packet, hashes the )
( shipped ROM, and runs it under uxncli. This one is the same idea with the shell removed )
( — it is a ROM that receives a ROM. It binds, accepts one caller, reads the packet off )
( the socket, and REPLACES ITSELF with the code that arrived. )
(                                                                                        )
( HOW THE SWAP WORKS, since a program cannot overwrite the ground it is standing on: the )
( packet is staged at 4000, a POSITION-INDEPENDENT copier is relocated to 8000, and the )
( jump goes there. The copier — relative branches, zero-page parameters, an immediate )
( JMP2 — then copies the staged bytes down to 0100 and jumps into them. Nothing of )
( hop-serve is left running; that is the point. )
(                                                                                        )
( THE CONNECTION SURVIVES THE SWAP, and that is what makes the lane work at all: the )
( socket lives in the EMULATOR's device, not in the 64 KB the copier overwrites, and the )
( selected channel lives in the device page. So the arriving ROM wakes up holding a live )
( inbound connection on channel 1 — it reads its payload from there and writes its answer )
( back there. That is the lane's contract, and it is why only mode 'net' is accepted: a )
( ROM packed for the pipe lane answers on the CONSOLE, whose output on this node goes to )
( a terminal the caller cannot see. Accepting it would look like a working hop and drop )
( every answer on the floor. )
(                                                                                        )
( WHAT THIS LANE GIVES UP, said out loud: the sh receiver hashes the ROM it received and )
( refuses on a mismatch. A ROM cannot compute sha1 in a few hundred bytes, so this one )
( CANNOT verify what it is about to run. It therefore demands a shared TOKEN, given to )
( uxncli as argv[2] and carried in the header, so reaching the port is not by itself )
( permission to run code here. That is weaker than ssh's key auth — it is replayable by )
( anyone who sees a packet — and it is why the bind address is always named explicitly, )
( a tailnet address rather than '*'. Trading the receiver's hash for a token is a real )
( downgrade; hiding it would be the fault. )
(                                                                                        )
( ONE PACKET PER INVOCATION, by construction rather than by policy: after the swap there )
( is no hop-serve left to serve a second caller. A supervisor re-runs it. )
(                                                                                        )
( input  : argv[1] = bind address 'tcp:host:port'  ·  argv[2] = the expected token )
( output : nothing of its own — the arriving ROM's, over the socket. )
(          rc 2 + a loud 'hop:' line on stderr for every refusal. rc 3 = no 0xd0 device. )
(                                                                                        )
( zero-page: argn=00 ptr=02 got=04 chunk=06 tries=08 src=10 dst=12 left=14 i=16 hp=30 n=32 )

|0100
    #0000 #d4 DEO2           ( clear the length register: a device-less page reads this back )
    #d0 #da DEO              ( action d0 Identify — only the DEVICE answers )
    #d4 DEI #d0 NEQ ,&nodev JCN
    #d5 DEI #02 LTH ,&nodev JCN   ( serving needs BIND: step 2 or later )
    ;on-console #10 DEO2
    ;addr-buf #02 STZ2
    BRK
    &nodev ;no-dev JMP2

( argv arrives as two runs: address, then token. The separator type is EOA (3) between )
( args and END (4) after the last one — the boundary IS the type, not a byte we scan for. )
@on-console
    #17 DEI #03 EQU ,&eoa JCN
    #17 DEI #04 EQU ,&eoa JCN
    #12 DEI #02 LDZ2 STA
    #02 LDZ2 INC2 #02 STZ2
    BRK
    &eoa
    #00 #02 LDZ2 STA              ( NUL-terminate the argument in place )
    #00 LDZ #00 EQU ,&first JCN
    ;serve JMP2                   ( the token has landed — go )
    &first
    #01 #00 STZ
    ;tok-buf #02 STZ2
    BRK

@serve
    ;tok-buf LDA #00 EQU ,&notok JCN   ( an empty token is not a token )
    #01 #df DEO                        ( SELECT an inbound lane — channel 0 is outbound )
    ;addr-buf #dd DEO2                 ( the low byte of bindaddr IS the bind trigger )
    #03 #08 STZ                        ( three accept waits, each one device deadline )
    &wait
    #da DEI                            ( on an inbound lane this WAITS for a caller )
    DUP #02 EQU ,&go JCN
    DUP #03 EQU ,&go JCN
    #06 EQU ,&again JCN                ( still Bound: the listener is up, nobody called )
    ;nobind JMP2                       ( 4 Unbound / 0 — the bind itself was refused )
    &again
    #08 LDZ #01 SUB #08 STZ
    #08 LDZ #00 EQU ,&nocall JCN
    ,&wait JMP
    &nocall ;nocaller JMP2
    &go POP
    ;header JMP2
    &notok ;notoken JMP2

( The header is read ONE BYTE AT A TIME, deliberately. A bulk read would swallow the )
( front of the payload, and the payload is not ours — it belongs to the ROM we are about )
( to become. recv never returns more than it was asked for, so a length of 1 is the only )
( way to stop exactly on the newline. )
@header
    ;hdr-buf #02 STZ2
    #0000 #16 STZ2
    &l
    #0001 #d4 DEO2
    ;byte-buf #d6 DEO2
    #d4 DEI2 #0001 NEQ2 ,&cut JCN      ( a short read here means the caller vanished )
    ;byte-buf LDA #0a EQU ,&done JCN
    ;byte-buf LDA #02 LDZ2 STA
    #02 LDZ2 INC2 #02 STZ2
    #16 LDZ2 INC2 #16 STZ2
    #16 LDZ2 #0080 EQU2 ,&long JCN     ( a header this long is not one of ours )
    ,&l JMP
    &done
    #00 #02 LDZ2 STA                   ( NUL-terminate the header )
    ;parse JMP2
    &cut ;truncated JMP2
    &long ;toolong JMP2

@parse
    #0000 #30 STZ2
    ;magic-str ;match JSR2 #00 EQU ,&bad JCN
    ;parse-n JSR2                      ( field 2: the rom size, into zp 32 )
    ;skip-field JSR2                   ( field 3: the declared sha1 — see the header note )
    ;mode-str ;match JSR2 #00 EQU ,&badmode JCN
    ;check-token JSR2 #00 EQU ,&badtok JCN
    #32 LDZ2 #0000 EQU2 ,&badsize JCN
    #32 LDZ2 #3f00 GTH2 ,&badsize JCN  ( 0100+n must stay clear of the 4000 staging area )
    ;stage JMP2
    &bad ;badhdr JMP2
    &badmode ;wrongmode JMP2
    &badtok ;badtoken JMP2
    &badsize ;badsz JMP2

( compare a NUL-terminated literal against the header at the cursor; advance both on a )
( match. Returns 1/0 — a literal that runs out has matched. )
@match ( str* -- ok )
    &l
    LDAk #00 EQU ,&yes JCN
    LDAk
    ;hdr-buf #30 LDZ2 ADD2 LDA
    NEQ ,&no JCN
    INC2
    #30 LDZ2 INC2 #30 STZ2
    ,&l JMP
    &yes POP2 #01 JMP2r
    &no POP2 #00 JMP2r

@parse-n ( -- )
    #0000 #32 STZ2
    &l
    ;hdr-buf #30 LDZ2 ADD2 LDA
    DUP #30 LTH ,&end JCN
    DUP #39 GTH ,&end JCN
    #30 SUB #00 SWP
    #32 LDZ2 #000a MUL2 ADD2 #32 STZ2
    #30 LDZ2 INC2 #30 STZ2
    ,&l JMP
    &end POP
    ( step over the ONE separating space, and only if it is there: skip-field's contract )
    ( is "past this field AND its space", so leaving the cursor sitting on the space would )
    ( make the next skip eat the space instead of the sha1 — a silent off-by-one-field that )
    ( surfaces as a bogus 'wrong lane' refusal three checks later. )
    ;hdr-buf #30 LDZ2 ADD2 LDA #20 NEQ ,&nosp JCN
    #30 LDZ2 INC2 #30 STZ2
    &nosp
    JMP2r

@skip-field ( -- )                     ( advance past the field and its one space )
    &l
    ;hdr-buf #30 LDZ2 ADD2 LDA #20 EQU ,&sp JCN
    ;hdr-buf #30 LDZ2 ADD2 LDA #00 EQU ,&end JCN
    #30 LDZ2 INC2 #30 STZ2
    ,&l JMP
    &sp #30 LDZ2 INC2 #30 STZ2
    &end JMP2r

( the rest of the header must equal the token we were started with, exactly )
@check-token ( -- ok )
    #0000 #16 STZ2
    &l
    ;tok-buf #16 LDZ2 ADD2 LDA
    ;hdr-buf #30 LDZ2 ADD2 LDA
    NEQ ,&no JCN
    ;tok-buf #16 LDZ2 ADD2 LDA #00 EQU ,&yes JCN
    #16 LDZ2 INC2 #16 STZ2
    #30 LDZ2 INC2 #30 STZ2
    ,&l JMP
    &yes #01 JMP2r
    &no #00 JMP2r

( read EXACTLY n bytes — the ROM — into the staging area at 4000, and not one byte more )
@stage
    #0000 #04 STZ2
    #03 #08 STZ
    &l
    #32 LDZ2 #04 LDZ2 SUB2 #06 STZ2
    #06 LDZ2 #0400 GTH2 ,&cap JCN
    ,&go JMP
    &cap #0400 #06 STZ2
    &go
    #06 LDZ2 #d4 DEO2
    #4000 #04 LDZ2 ADD2 #d6 DEO2
    #d4 DEI2 #0000 EQU2 ,&slow JCN
    #04 LDZ2 #d4 DEI2 ADD2 #04 STZ2
    #03 #08 STZ
    #04 LDZ2 #32 LDZ2 NEQ2 ,&l JCN
    ;launch JMP2
    &slow
    #da DEI #00 EQU ,&cut JCN          ( the caller closed mid-ROM )
    #08 LDZ #01 SUB #08 STZ
    #08 LDZ #00 EQU ,&cut JCN
    ,&l JMP
    &cut ;truncated JMP2

@launch
    #0000 #10 DEO2               ( drop OUR console vector: after the swap it would point )
                                 ( at overwritten memory, and stdin would eval garbage )
    #0000 #16 STZ2
    &reloc
    ;copier #16 LDZ2 ADD2 LDA
    #8000 #16 LDZ2 ADD2 STA
    #16 LDZ2 INC2 #16 STZ2
    #16 LDZ2 ;copier-end ;copier SUB2 NEQ2 ,&reloc JCN
    #4000 #10 STZ2
    #0100 #12 STZ2
    #32 LDZ2 #14 STZ2
    #8000 JMP2

( position-independent by construction: relative branches, zero-page parameters, and an )
( immediate jump. It is COPIED to 8000 and runs there, because a copier that overwrote )
( itself mid-copy would corrupt exactly the ROMs big enough to reach it — silently. )
@copier
    &l
    #10 LDZ2 LDA #12 LDZ2 STA
    #10 LDZ2 INC2 #10 STZ2
    #12 LDZ2 INC2 #12 STZ2
    #14 LDZ2 #0001 SUB2 #14 STZ2
    #14 LDZ2 #0000 NEQ2 ,&l JCN
    #0100 JMP2
@copier-end

( every refusal names itself on stderr and halts rc 2 — the caller sees an empty answer, )
( which its own ROM reports as NA. A refusal that looked like an answer would be worse. )
@notoken   ;e-notoken   ;die JMP2
@nobind    ;e-nobind    ;die JMP2
@nocaller  ;e-nocaller  ;die JMP2
@truncated ;e-truncated ;die JMP2
@toolong   ;e-toolong   ;die JMP2
@badhdr    ;e-badhdr    ;die JMP2
@wrongmode ;e-wrongmode ;die JMP2
@badtoken  ;e-badtoken  ;die JMP2
@badsz     ;e-badsz     ;die JMP2

@die ( str* -- )
    &l LDAk #00 EQU ,&d JCN
    LDAk #19 DEO INC2 ,&l JMP        ( 19 = stderr )
    &d POP2
    #82 #0f DEO
    BRK

@no-dev
    ;e-nodev
    &l LDAk #00 EQU ,&d JCN
    LDAk #19 DEO INC2 ,&l JMP
    &d POP2
    #83 #0f DEO
    BRK

@magic-str "uxp1 20 00
@mode-str  "net 20 00

@e-notoken   "hop-serve: 20 "no 20 "token 20 "given 20 "(argv[2]) 0a 00
@e-nobind    "hop-serve: 20 "bind 20 "refused 20 "- 20 "see 20 "the 20 "net: 20 "line 20 "above 0a 00
@e-nocaller  "hop-serve: 20 "nobody 20 "called 0a 00
@e-truncated "hop-serve: 20 "caller 20 "vanished 20 "mid-packet 0a 00
@e-toolong   "hop-serve: 20 "header 20 "too 20 "long 0a 00
@e-badhdr    "hop-serve: 20 "not 20 "a 20 "uxp1 20 "packet 0a 00
@e-wrongmode "hop-serve: 20 "wrong 20 "lane 20 "- 20 "this 20 "port 20 "takes 20 "mode 20 "'net' 20 "only 0a 00
@e-badtoken  "hop-serve: 20 "token 20 "mismatch 20 "- 20 "refusing 20 "to 20 "execute 0a 00
@e-badsz     "hop-serve: 20 "rom 20 "size 20 "out 20 "of 20 "range 0a 00
@e-nodev     "hop-serve: 20 "NODEV 20 "- 20 "this 20 "emulator 20 "has 20 "no 20 "0xd0 20 "device 0a 00

@byte-buf $1
@addr-buf $100
@tok-buf  $100
@hdr-buf  $100
