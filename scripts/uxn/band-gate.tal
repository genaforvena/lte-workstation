( band-gate.tal — a THRESHOLD/BOUNDARY gate, a second gate CLASS for the Uxn pilot. )
( Where lease-gate is a single ratio predicate [lease >= 2*cadence], this is a COMPOUND )
( two-edged band: a value is healthy only INSIDE [lo, hi] and RED past EITHER edge. )
( It proves the ROM pattern generalizes beyond one comparison — the same 130-ish-byte, )
( byte-identical-everywhere artifact, a different predicate. Real mesh use: a longevity/ )
( safety band [battery% in 20..80, a thermal window, a healthy PSI range]. )
( input  : argv "<lo>" "<value>" "<hi>"  [uxncli feeds them nl-terminated] )
( verdict: prints "OK\n" iff lo <= value <= hi, else "RED\n"; halts. )
( zero-page: lo=00 val=02 hi=04 acc=06 tok=08 [shorts; tok is a byte] )

|0100                        ( reset vector )
    ;on-console #10 DEO2     ( install Console/vector )
    BRK

@on-console
    #12 DEI                  ( Console/read -> byte )
    DUP #0a NEQ ,&digit JCN  ( not newline -> accumulate a digit )
    POP                      ( newline: drop it, finalize the token )
    #08 LDZ                  ( tok -- )
    DUP #00 EQU ,&t0 JCN     ( tok==0 -> store lo )
    #01 EQU ,&t1 JCN         ( tok==1 -> store val )
    ,&t2 JMP                 ( tok==2 -> store hi + decide )
    &t0
    POP                      ( drop the dup'd tok )
    #06 LDZ2 #00 STZ2        ( lo = acc )
    ,&nextacc JMP
    &t1
    #06 LDZ2 #02 STZ2        ( val = acc )
    ,&nextacc JMP
    &nextacc
    #0000 #06 STZ2           ( acc = 0 )
    #08 LDZ INC #08 STZ      ( tok++ )
    BRK
    &t2
    #06 LDZ2 #04 STZ2        ( hi = acc )
    ,&decide JMP
    &digit
    #30 SUB                  ( byte-'0' -> digit )
    #00 SWP                  ( promote to short )
    #06 LDZ2 #000a MUL2      ( acc*10 )
    ADD2
    #06 STZ2                 ( acc = acc*10 + digit )
    BRK
    &decide
    #00 LDZ2 #02 LDZ2 GTH2   ( lo > val ?  -> below the band, RED )
    ,&red JCN
    #02 LDZ2 #04 LDZ2 GTH2   ( val > hi ?  -> above the band, RED )
    ,&red JCN
    ;ok-str ;emit JSR2
    ,&halt JMP
    &red
    ;red-str ;emit JSR2
    &halt
    #01 #0f DEO              ( System/state = 1 -> exit )
    BRK

@emit ( str* -- )
    &loop
    LDAk #00 EQU ,&done JCN
    LDAk #18 DEO
    INC2 ,&loop JMP
    &done
    POP2
    JMP2r

@ok-str  "OK  0a 00
@red-str "RED 0a 00
