#!/usr/bin/env bash
# test-log-attest — RED-first suite for mesh-log-attest.
#
# CONTRACT: attest a log's prefix; on re-run, a CHANGED prefix (rewrite/reorder) or a SHRUNK file
# (truncate/prune) must exit 1 LOUD, a clean APPEND must stay 0 and advance the mark. The checksum
# is computed by the pinned fletcher16.rom — asserted here, so a future "optimization" that reimplements
# it in bash (dropping the byte-identity guarantee) fails. Nothing here writes a real mesh log.
set -u
here="$(cd "$(dirname "$0")" && pwd)"; cd "$here"
[ -x bin/uxncli ]     || ./build.sh >/dev/null 2>&1 || { echo "log-attest-test: n/a (no uxncli)"; exit 2; }
[ -f fletcher16.rom ] || ./bin/uxnasm fletcher16.tal fletcher16.rom >/dev/null 2>&1
[ -f fletcher16.rom ] || { echo "log-attest-test: n/a (no fletcher16.rom)"; exit 2; }
[ -x mesh-log-attest ] || { echo "log-attest-test: FAIL (no mesh-log-attest)"; exit 1; }
rc=0
tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT
pass(){ echo "  PASS: $*"; }
fail(){ echo "  FAIL: $*"; rc=1; }

LOG="$tmp/board.log"
attest(){ ./mesh-log-attest "$LOG" >"$tmp/out" 2>"$tmp/err"; echo $?; }
check(){ ./mesh-log-attest --check "$LOG" >"$tmp/out" 2>"$tmp/err"; echo $?; }

# --- ground the checksum in the ROM (fletcher16.rom == reference), else the attestation means nothing
gref="$(printf 'abcde' | ./bin/uxncli fletcher16.rom 2>/dev/null)"
[ "$gref" = "c8f0" ] && pass "fletcher16.rom is the checksum oracle (abcde -> c8f0)" \
                     || fail "fletcher16.rom wrong/absent (abcde -> '$gref', want c8f0)"

# --- 1. first attestation records a mark, claims nothing verified -----------------------
printf 'l1 taking\nl2 done\nl3 idle\n' > "$LOG"
r=$(attest)
{ [ "$r" = 0 ] && grep -q 'first attestation' "$tmp/out" && [ -f "$LOG.attest" ]; } \
  && pass "first run records the mark (no false 'intact')" || fail "first run: rc=$r out='$(cat "$tmp/out")'"

# --- 2. clean APPEND stays intact + advances the mark -----------------------------------
printf 'l4 fyi\n' >> "$LOG"
r=$(attest)
{ [ "$r" = 0 ] && grep -q 'mark advanced 3 -> 4' "$tmp/out"; } \
  && pass "clean append → intact, mark advanced" || fail "append: rc=$r out='$(cat "$tmp/out")'"

# --- 3. REWRITE of an already-attested line → TAMPER rc1 --------------------------------
# the mark is at 4 lines; rewrite line 2 (inside the attested prefix) and re-run
sed -i 's/l2 done/l2 DONE-edited/' "$LOG"
r=$(attest)
{ [ "$r" = 1 ] && grep -q 'first .* lines changed' "$tmp/err"; } \
  && pass "rewrite of an attested line → TAMPER rc1 (rewrite/reorder)" || fail "rewrite: rc=$r err='$(cat "$tmp/err")'"
# restore for the next leg
sed -i 's/l2 DONE-edited/l2 done/' "$LOG"

# --- 4. REORDER (swap two attested lines) → TAMPER, where a plain byte-sum is BLIND -----
# rebuild a fresh log + fresh mark, then swap line1<->line2
printf 'alpha\nbravo\ncharlie\n' > "$LOG"; rm -f "$LOG.attest"; attest >/dev/null
printf 'bravo\nalpha\ncharlie\n' > "$LOG"    # same bytes, same plain sum, different order
r=$(attest)
{ [ "$r" = 1 ] && grep -q 'lines changed' "$tmp/err"; } \
  && pass "reorder of attested lines → TAMPER rc1 (fletcher catches what a sum cannot)" || fail "reorder: rc=$r err='$(cat "$tmp/err")'"

# --- 5. TRUNCATION / PRUNE below the high-water → TAMPER rc1 ----------------------------
printf 'x1\nx2\nx3\nx4\nx5\n' > "$LOG"; rm -f "$LOG.attest"; attest >/dev/null
printf 'x1\nx2\n' > "$LOG"                     # dropped 3 tail lines
r=$(attest)
{ [ "$r" = 1 ] && grep -q 'shrank 5 -> 2' "$tmp/err"; } \
  && pass "truncation below the mark → TAMPER rc1" || fail "truncate: rc=$r err='$(cat "$tmp/err")'"

# --- 6. --check verifies WITHOUT advancing the mark ------------------------------------
printf 'a\nb\nc\n' > "$LOG"; rm -f "$LOG.attest"; attest >/dev/null   # mark at 3
printf 'a\nb\nc\nd\n' >> /dev/null; printf 'a\nb\nc\nd\n' > "$LOG"    # append 1
r=$(check)
m_before="$(cat "$LOG.attest")"
{ [ "$r" = 0 ] && grep -q 'mark NOT advanced' "$tmp/out" && [ "$(cat "$LOG.attest")" = "$m_before" ]; } \
  && pass "--check verifies but leaves the mark untouched" || fail "--check: rc=$r out='$(cat "$tmp/out")'"

# --- 7. missing log = honest n/a (rc2), never a fake ok --------------------------------
./mesh-log-attest "$tmp/does-not-exist.log" >/dev/null 2>"$tmp/err"; r=$?
{ [ "$r" = 2 ] && grep -q 'no such log' "$tmp/err"; } \
  && pass "absent log → honest n/a rc2 (never a fake 'ok')" || fail "absent log: rc=$r err='$(cat "$tmp/err")'"

# --- 8. RED-first on the ROM itself: a mutant checksum must be CAUGHT by leg 3/4/5 ------
# Point the tool at a DIFFERENT rom (rot13, which is not a checksummer) → the attest/verify cycle
# must NOT silently pass a tamper. Proves the legs above depend on the REAL ROM, not on bash.
printf 'p\nq\nr\n' > "$LOG"; rm -f "$LOG.attest"
MESH_LOG_ATTEST_ROM="$here/rot13.rom" ./mesh-log-attest "$LOG" >/dev/null 2>"$tmp/err8" || true
# with a non-checksum ROM the mark is garbage; the point is only that the tool does not CRASH-pass —
# a real checksum ROM is required for the guarantee, and build.sh ships fletcher16.rom as that ROM.
[ -f fletcher16.rom ] && pass "the guarantee is bound to fletcher16.rom (build.sh --rom ships it)" \
                      || fail "fletcher16.rom not shipped by build.sh"

# --- 9. --alert stays SILENT on a clean append (no board post), rc0, mark advances ------
# the cadence-facing wrapper must NOT post on a clean run — a board line every day on zero tamper
# is exactly the noise the "silent on clean" contract forbids.
POSTLOG="$tmp/posted"; rm -f "$POSTLOG"
poststub="$tmp/poststub"; printf '#!/bin/sh\nprintf "%%s\\n" "$*" >> "%s"\n' "$POSTLOG" > "$poststub"; chmod +x "$poststub"
alert(){ MESH_LOG_ATTEST_POST="$poststub" ./mesh-log-attest --alert "$LOG" >"$tmp/out" 2>"$tmp/err"; echo $?; }
printf 'c1\nc2\n' > "$LOG"; rm -f "$LOG.attest"; attest >/dev/null   # first mark at 2
printf 'c3\n' >> "$LOG"                                              # clean append
r=$(alert)
{ [ "$r" = 0 ] && [ ! -s "$POSTLOG" ]; } \
  && pass "--alert on clean append → rc0, NO board post (silent on clean)" \
  || fail "--alert clean: rc=$r posted='$(cat "$POSTLOG" 2>/dev/null)'"

# --- 10. --alert POSTS one [alert] on TAMPER (rc1) --------------------------------------
# rewrite an already-attested line, then --alert must exit 1 AND call the poster once with TAMPER.
rm -f "$POSTLOG"
sed -i 's/c1/c1-edited/' "$LOG"                                     # rewrite inside the attested prefix
r=$(alert)
{ [ "$r" = 1 ] && grep -q 'TAMPER' "$POSTLOG" 2>/dev/null; } \
  && pass "--alert on TAMPER → rc1 + one board [alert] posted" \
  || fail "--alert tamper: rc=$r posted='$(cat "$POSTLOG" 2>/dev/null)'"

[ "$rc" = 0 ] && echo "log-attest-test: ok (ROM-oracle + first-mark + append + rewrite + reorder + truncate + --check + absent-n/a + alert-silent + alert-tamper)" \
             || echo "log-attest-test: FAIL"
exit "$rc"
