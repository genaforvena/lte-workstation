#!/usr/bin/env bash
# test-lease-audit — RED-first proof for the LIVE resolver (mesh-lease-audit), not just the ROM.
#
# test-lease-gate already proves the 133-byte ROM does real arithmetic. This proves the AUDIT WIRING
# around it: that the (cadence, lease) it feeds the ROM tracks mesh-reflex-health's REAL eff_maxage
# derivation, so a regression in that derivation flips the audit RED instead of sailing green.
#
# RED-first: we point the audit at a mesh-reflex-health whose eff_maxage multiplier is BROKEN
# (s*1 instead of s*2 — the exact 'a-lease-must-exceed-its-producers-cadence' regression) and watch
# the audit flip from clean(0) to VIOLATION(1) on the same reflex set. Then the real genome must be
# clean (the honest zero — eff_maxage's *2 makes lease<2*cadence unexpressible by design).
set -u
here="$(cd "$(dirname "$0")" && pwd)"
cd "$here"
[ -x bin/uxncli ] || ./build.sh >/dev/null
[ -f lease-gate.rom ] || ./build.sh --rom >/dev/null
rc=0
tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT

# A one-reflex fixture genome: a healthy header (*/10 -> cad 600, so a correct lease is 1200).
mkdir -p "$tmp/scripts"
printf '#!/bin/sh\n# reflex-cadence: */10 * * * *\n:\n' > "$tmp/scripts/mesh-fixture-reflex"

# --- HEALTHY authority: eff_maxage derives lease = cad*2 = 1200 >= 2*600 -> the audit is CLEAN.
cat > "$tmp/rh-good" <<'RH'
#!/usr/bin/env bash
CRON_SRC="${MESH_CRON_SRC:-/dev/null}"
cron_stride_from_fields(){ local min="$1" hr="$2"
  case "$min" in
    \*/[0-9]*)        echo $(( ${min#*/} * 60 ));;
    [0-9]*-*/[0-9]*)  echo $(( ${min##*/} * 60 ));;
    *[,?]*)           echo 0;;
    [0-9]*)           case "$hr" in \*) echo 3600;; \*/[0-9]*) echo $(( ${hr#*/} * 3600 ));; *) echo 86400;; esac;;
    *)                echo 0;;
  esac; }
cron_stride_s(){ local line min hr
  line="$(grep -hwE -- "$1" "$CRON_SRC" 2>/dev/null | grep -vE '^[[:space:]]*#' | head -1)"
  [ -n "$line" ] || { echo 0; return; }
  min="$(printf '%s\n' "$line" | awk '{print $1}')"; hr="$(printf '%s\n' "$line" | awk '{print $2}')"
  cron_stride_from_fields "$min" "$hr"; }
eff_maxage(){ local raw="$1" tool="$2" s
  case "$raw" in @cond) echo skip;; @auto) s="$(cron_stride_s "$tool")"; [ "${s:-0}" -gt 0 ] && echo $((s*2)) || echo skip;; *) echo "$raw";; esac; }
REFLEXES=""
{ [ -n "${MESH_REFLEX_HEALTH_SOURCED:-}" ] && return 0; } 2>/dev/null || :
RH

# --- BROKEN authority: identical BUT eff_maxage multiplies by 1 (the derivation regression). lease
#     = 600 == cad, so lease < 2*cad -> the audit MUST go RED. (only the s*2 -> s*1 differs)
sed 's/echo \$((s\*2))/echo $((s*1))/' "$tmp/rh-good" > "$tmp/rh-bad"

audit(){ MESH_SCRIPTS_DIR="$tmp/scripts" MESH_REFLEX_HEALTH="$1" ./mesh-lease-audit >/dev/null 2>&1; }

# 1) HEALTHY authority over the fixture -> CLEAN (exit 0).
audit "$tmp/rh-good"; good=$?

# 2) BROKEN authority over the SAME fixture -> VIOLATION (exit 1).
audit "$tmp/rh-bad";  bad=$?

if [ "$good" -eq 0 ] && [ "$bad" -eq 1 ]; then
  echo "PASS: healthy eff_maxage -> audit CLEAN(0); broken (s*1) eff_maxage -> audit VIOLATION(1) on the same reflex"
else
  echo "FAIL: expected clean(0)+violation(1), got good=$good bad=$bad"; rc=1
fi

# 3) FALSIFIABLE control: the fixture reflex's cadence really did resolve (audit didn't skip it and
#    pass vacuously). Break the multiplier and demand the RED names our reflex.
if MESH_SCRIPTS_DIR="$tmp/scripts" MESH_REFLEX_HEALTH="$tmp/rh-bad" ./mesh-lease-audit 2>&1 | grep -q 'mesh-fixture-reflex'; then :; else
  echo "FAIL: broken-authority audit did not even name the fixture reflex — it skipped, not gated"; rc=1; fi

# 4) THE HONEST ZERO: the real live genome audits clean against the real mesh-reflex-health.
if ./mesh-lease-audit >/dev/null 2>&1; then
  echo "PASS: live genome audits CLEAN (eff_maxage's *2 makes lease<2*cadence unexpressible — honest zero)"
else
  echo "FAIL: live genome audit reported a violation — investigate (unexpected)"; rc=1; fi

[ "$rc" = 0 ] && echo "lease-audit-test: ok" || echo "lease-audit-test: FAIL"
exit $rc
