#!/usr/bin/env bash
# test-body-gate — RED-first suite for mesh-body-gate (uxn-hop-body-gate, stage 4c).
#
# CONTRACT: the body node gates ITSELF — mesh-body-gate reads the phone's own sysfs value,
# substitutes it into a threshold-ledger row (mesh-sexpr-gate --expr), packs the PINNED
# lisp-eval.rom + expression as an argv packet (mesh-uxn-hop --pack-argv), and the verdict
# is computed ON the body by the byte-identical ROM. The pin chain is end-to-end: ledger
# pin == packed ROM sha1 == receiver-verified sha1 == the stamp that comes back.
#
# Local legs run everywhere; the live leg needs the adb body — absent body = honest rc 2
# (n/a is a claim about the node), never a fake green. NOTHING here writes live state
# (~/.mesh/body-gate.state) — the test-that-writes-the-artifact forgery rule.
set -u
here="$(cd "$(dirname "$0")" && pwd)"
cd "$here"
[ -x bin/uxncli ]    || ./build.sh >/dev/null 2>&1 || { echo "body-gate-test: n/a (no uxncli)"; exit 2; }
[ -f lisp-eval.rom ] || { echo "body-gate-test: n/a (no lisp-eval.rom)"; exit 2; }
rc=0
tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT
fail(){ echo "  FAIL: $*"; rc=1; }

[ -x mesh-body-gate ] || { echo "body-gate-test: FAIL (no mesh-body-gate)"; exit 1; }

# 1) pack-site hash-then-execute: a ROM that mismatches the ledger pin is REFUSED before
#    the body is even dialed. The bogus serial pins the ORDER: were the pack-site check
#    gone, the next refusal would say 'unreachable', not 'refusing to ship' — a mutant
#    neutering the comparison survived the looser 'pin|mismatch' grep via the SECOND pin
#    gate (the execution-site stamp check), caught 2026-07-24.
cp lisp-eval.rom "$tmp/tamper.rom"; printf '\x00' >>"$tmp/tamper.rom"
out="$(MESH_BODY_GATE_ROM="$tmp/tamper.rom" MESH_BODY_ADB_SERIAL=no-such-device \
       MESH_BODY_GATE_STATE="$tmp/state1" ./mesh-body-gate 2>"$tmp/err1")" && r=0 || r=$?
if [ "$r" = 2 ] && [ -z "$out" ] && grep -q 'refusing to ship' "$tmp/err1" && [ ! -s "$tmp/state1" ]; then
  echo "PASS: pinned-ROM mismatch refused at pack site, pre-dial (rc2, no state)"
else
  echo "FAIL: tampered ROM under pin → want rc2+'refusing to ship'+no-state, got rc=$r err='$(head -1 "$tmp/err1" 2>/dev/null)'"; rc=1
fi

# 2) absent body = honest n/a: with adb pointed at a serial that does not exist, rc must be 2
#    LOUD, stdout empty, and the state file untouched (never a fake verdict for a missing body).
out="$(MESH_BODY_ADB_SERIAL=no-such-device MESH_BODY_GATE_STATE="$tmp/state2" \
       ./mesh-body-gate 2>"$tmp/err2")" && r=0 || r=$?
if [ "$r" = 2 ] && [ -z "$out" ] && [ -s "$tmp/err2" ] && [ ! -s "$tmp/state2" ]; then
  echo "PASS: absent body → honest rc2 LOUD, no state"
else
  echo "FAIL: absent body → want rc2+loud+no-state, got rc=$r out='$out' err='$(head -1 "$tmp/err2" 2>/dev/null)'"; rc=1
fi

# 3) live leg (real-read gate): with a body on adb, one full round — the verdicts land in the
#    TEST state file, each line stamps src=rom-body and the sha1 the EXECUTION SITE verified,
#    and that sha1 IS the ledger pin. Values must be real reads (digits), not defaults.
if adb get-state >/dev/null 2>&1; then
  pin="$(./mesh-sexpr-gate --pin 2>/dev/null || MESH_SEXPR_GATES=./threshold-ledger ./mesh-sexpr-gate --pin)"
  out="$(MESH_BODY_GATE_STATE="$tmp/state3" ./mesh-body-gate 2>"$tmp/err3")" && r=0 || r=$?
  if [ "$r" != 0 ]; then
    echo "FAIL: live body present but run rc=$r ($(head -2 "$tmp/err3" | tr '\n' ' '))"; rc=1
  else
    for g in battery-charge body-thermal; do
      line="$(grep " $g " "$tmp/state3" | tail -1)"
      [ -n "$line" ] || { fail "no state line for $g"; continue; }
      case "$line" in
        *" src=rom-body sha1=$pin"*) ;;
        *) fail "$g line lacks src=rom-body sha1=<pin>: $line" ;;
      esac
      v="$(printf '%s\n' "$line" | sed -n 's/.* verdict=\([0-9NA]*\).*/\1/p')"
      case "$v" in [0-9]|NA) ;; *) fail "$g verdict not a digit/NA: '$v' ($line)" ;; esac
    done
    # the value axis is a REAL read: battery cap 0..100 digits from the phone's own sysfs
    cap="$(grep ' battery-charge ' "$tmp/state3" | tail -1 | sed -n 's/.* cap=\([0-9]*\).*/\1/p')"
    { [ -n "$cap" ] && [ "$cap" -ge 0 ] && [ "$cap" -le 100 ]; } \
      || fail "battery cap not a real 0..100 read: '$cap'"
    [ "$rc" = 0 ] && echo "PASS: live body round — real reads, on-body verdicts, pin-stamped ($(grep -c . "$tmp/state3") lines)"
  fi
else
  echo "body-gate-test: live leg n/a (no adb body) — local legs only"
  [ "$rc" = 0 ] && exit 2
fi

# 4) THE SSH TRANSPORT LANE, driven against a REAL remote node — not a stub, and not localhost.
# Why the lane exists: the Note3 speaks adb and has no ssh; every Termux body speaks ssh and has
# its adb ports shut. A gate that names one transport can only reach half the bodies, which is
# what actually blocked cloning this gate onto the next phone. So the seam gets its own live leg.
# HONEST BOUNDARY, stated rather than implied: the remote here is an ordinary POSIX node with no
# battery, so the two sysfs READS are fixtures written on that node — what this leg proves is the
# TRANSPORT (dial, scp, remote exec, stdin, and the stamp stream, which ssh keeps on stderr where
# adb merges it) and the pin chain executing on the far side. It does NOT prove a phone's sensors;
# only a real body does that, and the adb leg above is where that claim lives.
# Unreachable peer / no local cc → honest n/a for THIS leg, never a fake pass.
SSH_BODY="${MESH_BODY_TEST_SSH:-root@100.94.116.17}"
sshb(){ timeout 30 ssh -o BatchMode=yes -o ConnectTimeout=8 -o StrictHostKeyChecking=accept-new "$SSH_BODY" "$@"; }
if ! sshb true </dev/null >/dev/null 2>&1; then
  echo "  n/a: ssh body $SSH_BODY unreachable — the transport leg did NOT run"
else
  _rhome="$(sshb 'printf %s "$HOME"' </dev/null | tr -d '\r')"
  _rdir="$_rhome/.mesh-body"
  sshb "mkdir -p '$_rdir'" </dev/null >/dev/null 2>&1
  # provision the emulator if the body has none — the same cross-build-and-push the real clone does
  if ! sshb "[ -x '$_rdir/uxncli' ]" </dev/null >/dev/null 2>&1; then
    _arch="$(sshb 'uname -m' </dev/null | tr -d '\r')"
    if [ "$_arch" = "$(uname -m)" ] && cc -std=c89 -O2 -static -DNDEBUG -o "$tmp/uxncli.static" \
         src/uxncli.c src/uxn.c src/devices/*.c 2>/dev/null; then
      timeout 90 scp -q -o BatchMode=yes -o StrictHostKeyChecking=accept-new \
        "$tmp/uxncli.static" "$SSH_BODY:$_rdir/uxncli" >/dev/null 2>&1
      sshb "chmod +x '$_rdir/uxncli'" </dev/null >/dev/null 2>&1
    fi
  fi
  if ! sshb "[ -x '$_rdir/uxncli' ]" </dev/null >/dev/null 2>&1; then
    echo "  n/a: ssh body has no uxncli and none could be cross-built for it ($SSH_BODY) — leg did NOT run"
  else
    # cap=7 is below the ledger's crit=15 → verdict 0; t=305 with the seed ladder (p=9, s1=280,
    # s2=330) → verdict 1. Both are computed BY THE ROM ON THE FAR NODE; asserting the exact
    # digits is what separates "the transport moved bytes" from "the far side ran our logic".
    sshb "printf 7 > '$_rdir/cap'; printf 305 > '$_rdir/temp'" </dev/null >/dev/null 2>&1
    out="$(MESH_BODY_SSH="$SSH_BODY" MESH_BODY_CAP_PATH='$HOME/.mesh-body/cap' \
           MESH_BODY_TEMP_PATH='$HOME/.mesh-body/temp' MESH_BODY_GATE_STATE="$tmp/state4" \
           ./mesh-body-gate 2>"$tmp/err4")" && r=0 || r=$?
    if [ "$r" != 0 ]; then
      fail "ssh transport lane: rc=$r ($(head -2 "$tmp/err4" | tr '\n' ' '))"
    else
      _vb="$(grep ' battery-charge ' "$tmp/state4" | tail -1 | sed -n 's/.* verdict=\([0-9]\).*/\1/p')"
      _vt="$(grep ' body-thermal ' "$tmp/state4" | tail -1 | sed -n 's/.* verdict=\([0-9]\).*/\1/p')"
      [ "$_vb" = 0 ] || fail "ssh lane: cap=7 must render battery-charge verdict 0 (CRIT), got '$_vb'"
      [ "$_vt" = 1 ] || fail "ssh lane: t=305 p=9 must render body-thermal verdict 1 (NORMAL), got '$_vt'"
      grep -q " src=rom-body sha1=$pin" "$tmp/state4" \
        || fail "ssh lane: state lines not stamped with the ledger pin $pin"
      [ "$rc" = 0 ] && echo "PASS: ssh transport lane — $SSH_BODY ran the pinned ROM, verdicts 0/1 came back stamped"
    fi
    # the STAMP must be enforced on this lane too: ssh keeps stderr separate, so a lane that
    # dropped the stamp stream would return a verdict nobody verified (it did, on the first run).
    grep -q 'hop: rom sha1=' "$tmp/err4" 2>/dev/null && fail "ssh lane leaked the execution stamp to our stderr instead of demuxing it"
  fi
fi

[ "$rc" = 0 ] && echo "body-gate-test: ok" || echo "body-gate-test: FAIL"
exit $rc
