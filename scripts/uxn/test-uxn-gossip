#!/usr/bin/env bash
# test-uxn-gossip — the gate for gossip.tal: trace rows merged ROM-to-ROM over the step-3
# datagram lane, and the one property that lane makes load-bearing — IDEMPOTENCE UNDER REPLAY.
#
# WHY IDEMPOTENCE IS THE GATE AND NOT A NICETY. A datagram carries no handshake and no
# identity; anyone who can see one can send it again, and the hop lane's token is replayable
# by construction. A receiver that appends what it is handed is therefore a write amplifier
# pointed at its own ledger by whoever felt like replaying, and every consumer downstream
# reads the duplicates as corroboration — the same row from "twice" looks exactly like two
# nodes agreeing. So the assert is never "the row arrived": it is the LEDGER, after a replay,
# holding it exactly once.
#
# THE LIVE LEG CROSSES A REAL NODE BOUNDARY, ROM to ROM: phaedra's own uxncli runs
# net-echo.rom to send the row, mesh-home's runs gossip.rom to receive it, and no shell is
# involved on either end of the wire (ssh only starts the far ROM — the ROW never touches it).
# Unreachable peer → exit 2, honest n/a, never a fake pass.
#
# THE FILE DEVICE SANDBOXES TO THE CWD, which is why every leg runs inside its own temp dir
# with the emulator and the ROM copied in: a ledger path outside the sandbox is refused with
# a count of zero, and that is leg D's subject rather than an accident to work around.
set -u
here="$(cd "$(dirname "$0")" && pwd)"
cd "$here"
rc=0
tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT
fail(){ echo "  FAIL: $*"; rc=1; }
pass(){ echo "  PASS: $*"; }

PEER_IP="${MESH_NET_TEST_PEER_IP:-100.94.116.17}"
PEER_SSH="${MESH_NET_TEST_PEER:-root@$PEER_IP}"
PEER_DIR="${MESH_GOSSIP_PEER_DIR:-/root/.mesh-body/uxn-step3}"
SELF_IP="${MESH_NET_TEST_SELF_IP:-$(tailscale ip -4 2>/dev/null | head -1)}"
GPORT="${MESH_GOSSIP_PORT:-47190}"

./build.sh >/dev/null 2>&1 || { echo "uxn-gossip-test: n/a (toolchain will not build)"; exit 2; }
[ -x bin/uxncli ] || { echo "uxn-gossip-test: n/a (no uxncli)"; exit 2; }

# --- A. the ROM is what its source assembles to -------------------------------------------
# Byte-identity is the lane's contract: a .rom is a pinned artifact and the same bytes run on
# every arch. A gate that tested a stale .rom would be testing a different program.
./bin/uxnasm gossip.tal "$tmp/re.rom" >/dev/null 2>&1
if cmp -s "$tmp/re.rom" gossip.rom; then
  pass "gossip.rom == uxnasm(gossip.tal) (byte-identity)"
else
  fail "gossip.rom drifted from gossip.tal — reassemble (build.sh --rom)"
fi

# run_gossip <dir> <port> <ledger-arg> <rows…> → the ROM's stdout verdict lines
# Starts gossip.rom in its own sandbox dir, sends each row as one datagram, returns what the
# ROM said. The reply to the sender is checked separately in leg B; both must agree, because
# a verdict readable at only one end of the wire is a claim only one side can check.
run_gossip(){
  local dir="$1" port="$2" led="$3"; shift 3
  mkdir -p "$dir"; cp bin/uxncli gossip.rom "$dir/"
  ( cd "$dir" && printf 'udp:127.0.0.1:%s\n%s\n' "$port" "$led" \
      | UXN_NET_TIMEOUT=2 timeout 40 ./uxncli gossip.rom >stdout.txt 2>stderr.txt ) &
  local bg=$!
  sleep 1
  local rows="" r
  for r in "$@"; do rows="$rows$r"$'\n'; done
  printf '%s' "$rows" | python3 -c "
import socket,sys,time
port=int(sys.argv[1])
s=socket.socket(socket.AF_INET,socket.SOCK_DGRAM); s.settimeout(6)
for line in sys.stdin.read().split('\n'):
    if line=='': continue
    s.sendto(line.encode(), ('127.0.0.1',port))
    try: print(s.recvfrom(256)[0].decode())
    except Exception: print('NO-REPLY')
    time.sleep(0.2)
" "$port" > "$dir/replies.txt" 2>/dev/null
  wait $bg 2>/dev/null
  cat "$dir/stdout.txt"
}

# --- B. a replayed row is merged ONCE — the whole contract, asserted on the LEDGER ---------
# Five packets: a row, the same row again, a second row, the first row a third time, and one
# with no id at all. The verdicts are checked at BOTH ends and the artifact is the ledger:
# two lines, in arrival order, no matter how many times anything was replayed.
v="$(run_gossip "$tmp/b" 47191 ledger.txt \
      'a1b2 mesh-home trace one' 'a1b2 mesh-home trace one' 'c3d4 phaedra trace two' \
      'a1b2 mesh-home trace one' 'noid')"
want='new a1b2
dup a1b2
new c3d4
dup a1b2
bad '
if [ "$v" = "$want" ]; then
  pass "replay verdicts on stdout: new/dup/new/dup/bad"
else
  fail "replay verdicts: want '$(printf '%s' "$want" | tr '\n' '|')', got '$(printf '%s' "$v" | tr '\n' '|')'"
fi
rv="$(tr -d '\r' < "$tmp/b/replies.txt")"
wantr='uxn:new a1b2
uxn:dup a1b2
uxn:new c3d4
uxn:dup a1b2
uxn:bad '
if [ "$rv" = "$wantr" ]; then
  pass "the SENDER got the same verdicts, tagged 'uxn:' (both ends agree)"
else
  fail "sender-side verdicts: want '$(printf '%s' "$wantr" | tr '\n' '|')', got '$(printf '%s' "$rv" | tr '\n' '|')'"
fi
led="$(cat "$tmp/b/ledger.txt" 2>/dev/null)"
wantl='a1b2 mesh-home trace one
c3d4 phaedra trace two'
if [ "$led" = "$wantl" ]; then
  pass "THE ARTIFACT: 5 packets, 2 rows in the ledger — the replays amplified nothing"
else
  fail "ledger after replay: want 2 rows, got '$(printf '%s' "$led" | tr '\n' '|')'"
fi

# --- C. an unsearchable ledger REFUSES the merge, it does not guess -----------------------
# The scan window is 16 KB and a larger ledger cannot be searched in one read. Reading that
# as "not seen" would switch idempotence off silently at exactly the size where duplicates
# start to matter, so the ROM answers 'ful' and writes nothing. The artifact is the file's
# size, unchanged — a message alone would only prove it said something.
mkdir -p "$tmp/c"
python3 -c "open('$tmp/c/big.txt','w').write('zz00 filler\n' + 'x'*17000 + '\n')"
sz_before=$(wc -c < "$tmp/c/big.txt")
v="$(run_gossip "$tmp/c" 47192 big.txt 'f1f1 mesh-home over the window')"
sz_after=$(wc -c < "$tmp/c/big.txt")
if [ "$v" = "ful f1f1" ] && [ "$sz_before" = "$sz_after" ]; then
  pass "a ledger past the scan window → 'ful', and the file is byte-for-byte untouched"
else
  fail "over-window ledger: want 'ful f1f1' + unchanged size, got '$v' ($sz_before → $sz_after)"
fi

# --- D. an append that could not land is NEVER reported as merged --------------------------
# The file device sandboxes to the CWD: a path outside it comes back with a warning on stderr
# and a count of zero. Without checking the write result the ROM answers 'new' forever while
# nothing is ever written — a merge that reports success and leaves no artifact, which is the
# silent-fallback shape in its purest form.
v="$(run_gossip "$tmp/d" 47193 /etc/uxn-gossip-should-not-exist.txt 'd1d1 mesh-home outside')"
if [ "$v" = "err d1d1" ] && [ ! -f /etc/uxn-gossip-should-not-exist.txt ]; then
  pass "a sandbox-refused ledger → 'err', never 'new' (and nothing was written)"
else
  fail "blocked ledger: want 'err d1d1' + no file, got '$v'"
fi

# --- E. the dedupe is LINE-ANCHORED: an id inside a row is a different fact ----------------
# 'zz01' appearing as the second field of some other row does not mean this node holds row
# zz01. A substring match would silently drop every row whose id ever appeared in anybody's
# free text — a loss that looks exactly like the row never being sent.
mkdir -p "$tmp/e"
printf 'aa00 mesh-home mentions zz01 in passing\n' > "$tmp/e/ledger.txt"
v="$(run_gossip "$tmp/e" 47194 ledger.txt 'zz01 phaedra the real row')"
n=$(wc -l < "$tmp/e/ledger.txt")
if [ "$v" = "new zz01" ] && [ "$n" = 2 ]; then
  pass "an id mentioned INSIDE another row does not count as held (line-anchored)"
else
  fail "line anchoring: want 'new zz01' + 2 ledger lines, got '$v' + $n lines"
fi

# --- F. RED-first: each mutant of the SOURCE must break a leg above ------------------------
# A gate nobody has seen fail is not a gate, and every mutant here is a plausible
# simplification: drop the dedupe, treat "cannot search" as "not there", trust the write,
# match anywhere instead of at a line start. `sed -z` because two of the edits span lines; a
# pattern that matches nothing is caught and FAILS rather than reading green as a no-op.
mutant_red(){ # $1=sed-z script  $2=label  $3=command that must FAIL against the mutant
  cp gossip.tal "$tmp/g.bak"
  sed -z "$1" gossip.tal > "$tmp/g.mut" || { fail "$2: sed failed"; return; }
  if cmp -s gossip.tal "$tmp/g.mut"; then
    fail "$2: mutation was a no-op (pattern missed — this mutant is NOT being tested)"; return
  fi
  cp "$tmp/g.mut" gossip.tal
  local built=1
  ./bin/uxnasm gossip.tal gossip.rom >/dev/null 2>&1 || built=0
  cp "$tmp/g.bak" gossip.tal
  if [ "$built" = 0 ]; then fail "$2: mutant does not assemble"; ./bin/uxnasm gossip.tal gossip.rom >/dev/null 2>&1; return; fi
  if eval "$3" >/dev/null 2>&1; then
    fail "$2: the check STILL PASSES against the mutant — that leg does not discriminate it"
  else
    pass "RED against mutant: $2"
  fi
  ./bin/uxnasm gossip.tal gossip.rom >/dev/null 2>&1
}
# the dedupe branch never taken: every replay is appended, which is the write amplifier
mutant_red 's|#11 LDZ #00 NEQ ,&dup JCN|#11 LDZ POP #00 #00 NEQ ,\&dup JCN|' \
  "the dedupe check removed (every replay appended)" \
  "v=\$(run_gossip $tmp/m1 47195 ledger.txt 'a1b2 x one' 'a1b2 x one'); [ \"\$(wc -l < $tmp/m1/ledger.txt)\" = 1 ]"
# an unsearchable ledger read as "not seen": the merge proceeds blind, so idempotence
# switches itself off at exactly the size where duplicates begin to matter
mutant_red 's|&full #02 #11 STZ|\&full #00 #11 STZ|' \
  "an over-window ledger treated as 'not seen' (idempotence silently off past 16 KB)" \
  "python3 -c \"open('$tmp/m2/big.txt','w')\" 2>/dev/null; mkdir -p $tmp/m2
   python3 -c \"open('$tmp/m2/big.txt','w').write('zz00 filler\\n' + 'x'*17000 + '\\n')\"
   b=\$(wc -c < $tmp/m2/big.txt)
   v=\$(run_gossip $tmp/m2 47196 big.txt 'f1f1 x over'); a=\$(wc -c < $tmp/m2/big.txt)
   [ \"\$v\" = 'ful f1f1' ] && [ \"\$b\" = \"\$a\" ]"
# the write result unchecked: 'new' for a merge that never touched a file
mutant_red 's|#a2 DEI2 #04 LDZ2 NEQ2 ,&err JCN|#0000 #0000 NEQ2 ,\&err JCN|' \
  "the append result unchecked ('new' for a write that never landed)" \
  "v=\$(run_gossip $tmp/m3 47197 /etc/uxn-gossip-should-not-exist.txt 'd1d1 x outside'); [ \"\$v\" = 'err d1d1' ]"
# the line anchor dropped: the id is looked for anywhere, so a mention becomes a duplicate
mutant_red 's|;scan-buf #08 LDZ2 ADD2 LDA #0a EQU ,&nl2 JCN\n    #08 LDZ2 INC2 #08 STZ2\n    ,&adv JMP\n|;scan-buf #08 LDZ2 ADD2 LDA #0a POP POP #00 #00 NEQ ,\&nl2 JCN\n|' \
  "the line anchor dropped (an id MENTIONED in another row reads as held)" \
  "mkdir -p $tmp/m4; printf 'aa00 mentions zz01 in passing\n' > $tmp/m4/ledger.txt
   v=\$(run_gossip $tmp/m4 47198 ledger.txt 'zz01 x the real row'); [ \"\$v\" = 'new zz01' ]"

# --- G. THE LIVE LEG: a row that ORIGINATED on another node, merged here BY ROM ------------
# phaedra's own uxncli sends it with net-echo.rom; ours receives it with gossip.rom bound on
# this node's TAILSCALE address. ssh starts the far ROM and nothing else — the row itself
# never passes through a shell, which is the whole point of the lane: a node holding only
# uxncli is a participant, not something a node with a shell has to poll on its behalf.
if [ -z "$SELF_IP" ]; then
  echo "  n/a: no tailscale address on this node — the LIVE leg did NOT run"
  [ "$rc" -eq 0 ] && { echo "uxn-gossip-test: n/a (local legs green, live leg needs a tailscale IP)"; exit 2; }
  echo "uxn-gossip-test: FAIL"; exit 1
fi
if ! timeout 15 ssh -n -o StrictHostKeyChecking=no -o ConnectTimeout=8 -o BatchMode=yes "$PEER_SSH" \
      "[ -x $PEER_DIR/uxncli-d003 ] && [ -f $PEER_DIR/net-echo.rom ]" 2>/dev/null; then
  echo "  n/a: peer $PEER_SSH has no step-3 emulator at $PEER_DIR — the LIVE leg did NOT run"
  [ "$rc" -eq 0 ] && { echo "uxn-gossip-test: n/a (local legs green, live leg needs $PEER_SSH:$PEER_DIR)"; exit 2; }
  echo "uxn-gossip-test: FAIL"; exit 1
fi
mkdir -p "$tmp/live"; cp bin/uxncli gossip.rom "$tmp/live/"
( cd "$tmp/live" && printf 'udp:%s:%s\nledger.txt\n' "$SELF_IP" "$GPORT" \
    | UXN_NET_TIMEOUT=6 timeout 90 ./uxncli gossip.rom >stdout.txt 2>stderr.txt ) &
lbg=$!
sleep 1
row="7f3a9c01 phaedra trace hop-lane-token-seen"
for i in 1 2; do
  timeout 30 ssh -n -o StrictHostKeyChecking=no -o BatchMode=yes "$PEER_SSH" \
    "cd $PEER_DIR && printf 'udp:$SELF_IP:$GPORT\n$row\n' | UXN_NET_TIMEOUT=8 ./uxncli-d003 net-echo.rom" \
    >> "$tmp/live/peer.txt" 2>/dev/null
done
wait $lbg 2>/dev/null
v="$(cat "$tmp/live/stdout.txt")"
lv="$(cat "$tmp/live/ledger.txt" 2>/dev/null)"
pr="$(tr -d '\n' < "$tmp/live/peer.txt")"
if [ "$v" = "new 7f3a9c01
dup 7f3a9c01" ] && [ "$lv" = "$row" ] && [ "$pr" = "uxn:new 7f3a9c01uxn:dup 7f3a9c01" ]; then
  pass "LIVE ROM-to-ROM $PEER_IP -> $SELF_IP:$GPORT: the row originated on phaedra, landed in OUR ledger once, and its replay was refused"
else
  fail "live gossip: want new-then-dup + one ledger row, got verdicts '$(printf '%s' "$v" | tr '\n' '|')' ledger '$lv' peer '$pr' err='$(head -1 "$tmp/live/stderr.txt")'"
fi

[ "$rc" -eq 0 ] && echo "uxn-gossip-test: ok (ROM byte-identity + replay merged once, asserted on the ledger and at both ends of the wire + over-window refusal leaves the file untouched + a blocked append never reads as merged + line-anchored dedupe + 4 source-mutants RED + a REAL cross-node row merged by ROM and its replay refused)"
exit "$rc"
