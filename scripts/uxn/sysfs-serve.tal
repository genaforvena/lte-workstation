( sysfs-serve.tal: termux-independent sysfs-over-TCP transport for a phone. )

( A persistent listener for a node whose termux/ssh is gone: it binds a TCP address, )
( and on each caller opens a sysfs file via the FILE device 0xa0, reads its raw bytes, )
( and streams them back over the NET device 0xd0, tagged uxn: . The ROM does NO float )
( math, NO parsing, NO classification — pure byte transport. The caller-side shell parses )
( the payload, e.g. the x,y,z CSV from an accelerometer. )

( BOUNDARY — sense-gate.tal:8-11. This ROM is a CONDUIT, not a measurement. The liveness )
( decision — is the read real, enough axes, fresh — stays in the host shell or a sense-gate, )
( never here. The ROM never touches a sensor's meaning, only its bytes. )

( MUST RUN WITH CWD / so the file-device sandbox file.c:163-174 admits /sys paths. )
( Launch on the phone:  cd / && ./uxncli sysfs-serve.rom )
( Do NOT run under mesh-uxn-hop --serve — its tempdir cwd returns 0 sysfs bytes, silent. )

( input  : stdin line 1 = bind address, e.g. tcp:192.168.8.184:47320 )
(          stdin line 2 = sysfs path,  e.g. /sys/class/sensors/accelerometer_sensor/raw_data )
( output : to each caller: uxn: + the raw file bytes. Persists, re-accepts, forever. )
(          NA    rc 2 — bind refused or listener gone. A claim about the LINK. )
(          NODEV rc 3 — this emulator's 0xd0 device absent or too old. About the BUILD. )

( zero-page: line=00 uriptr=02 pathptr=04 sendlen=06 )

|0100
    #0000 #d4 DEO2           ( clear the length register; a device-less page reads this back 0 )
    #d0 #da DEO              ( action d0 Identify — only the DEVICE answers )
    #d4 DEI #d0 NEQ ,&nodev JCN
    #d5 DEI #02 LTH ,&nodev JCN   ( need BIND so device step must be >= 2 )
    ;on-console #10 DEO2     ( console vector )
    ;uri-buf  #02 STZ2       ( line-1 uri ptr -> uri-buf )
    ;path-buf #04 STZ2       ( line-2 path ptr -> path-buf )
    BRK
    &nodev ;no-dev JMP2

( console: two-line stdin reader. the line flag at zpg 00 picks the buffer. )
@on-console
    #12 DEI
    DUP #0a EQU ,&nl JCN          ( newline marks end of the current line )
    #00 LDZ #00 EQU ,&uri JCN     ( line 0 -> uri buffer ; else path buffer )
    &path
      #04 LDZ2 STA                ( byte -> ram at pathptr )
      #04 LDZ2 INC2 #04 STZ2
      BRK
    &uri
      #02 LDZ2 STA                ( byte -> ram at uriptr )
      #02 LDZ2 INC2 #02 STZ2
      BRK
    &nl
    POP
    #00 LDZ #00 EQU ,&first JCN    ( were we on line 0, the uri? )
      ( second newline: path complete -> serve )
      #00 #04 LDZ2 STA            ( NUL-terminate the path in place )
      ;serve JMP2
    &first
      #00 #02 LDZ2 STA            ( NUL-terminate the uri in place )
      #01 #00 STZ                 ( line flag -> 1: now reading the path )
      ;path-buf #04 STZ2          ( reset path-ptr to path-buf start )
      BRK

( serve: bind the inbound lane, then wait for callers forever. )
@serve
    #01 #df DEO                   ( SELECT inbound lane 1 first — channel 0 is refused )
    ;uri-buf #dd DEO2             ( bindaddr: the low-byte write de IS the bind trigger )
    ( NO bind-success read here: on an inbound lane the state read IS the accept, so a )
    ( check for Bound would consume the first wait and answer Connected the instant a )
    ( caller arrived — reading a healthy bind as a failure. see net-listen.tal:62-65. )
    ;wait JMP2

( wait: the device's deadline, not a spin. re-arms forever. )
@wait
    #da DEI                       ( blocks up to UXN_NET_TIMEOUT for a caller )
    DUP #02 EQU ,&go JCN          ( Connected -> a caller arrived )
    DUP #03 EQU ,&go JCN          ( HasData -> a caller with bytes already waiting )
    #06 EQU ,&again JCN           ( Bound -> listener up, nobody called yet )
    ;na JMP2                      ( Unbound or Disconnected -> the listener itself is gone )
    &again ;wait JMP2
    &go POP ;read-file JMP2

( read-file: open the sysfs path; read its bytes into reply-buf+4, behind the uxn: tag. )
( file device ports: a8/a9 = filename, aa/ab = length, ac/ad = dest, a2/a3 = count. )
( a single DEO2 to a8 or ac writes both bytes AND triggers via the low-byte write. )
( see file.c:330-342. )
@read-file
    ;path-buf #a8 DEO2               ( set filename + trigger open )
    #0040 #aa DEO2                   ( transfer length = 64 bytes — accel CSV is about 18 )
    ;reply-buf #0004 ADD2 #ac DEO2   ( dest = reply-buf+4 ; trigger read, bytes land after tag )
    #a2 DEI2 #0004 ADD2 #06 STZ2     ( sendlen zpg 06 = 4-byte tag + bytes-actually-read )
    ;send JMP2

( send: write the tagged reply, then DRAIN the caller before closing. )
( the drain is required: net_read is non-blocking, so a 0-length recv is ambiguous — )
( EAGAIN leaves state Connected and length 0, peer still alive; only a state leaving )
( Connected means the caller EOF'd. draining the caller's data first also avoids an )
( abortive RST on close — close with unread recv data resets the peer, losing the reply. )
@send
    #06 LDZ2 #d4 DEO2            ( send length = tag + payload )
    ;reply-buf #d8 DEO2          ( send from reply-buf ; low byte d9 triggers send )
    ;drain JMP2

( drain: consume the caller's data until it EOFs, then drop cleanly. )
@drain &loop
    #0100 #d4 DEO2               ( recv up to 256 from caller )
    ;in-buf #d6 DEO2             ( low byte d7 triggers recv )
    #d4 DEI2 #0000 GTH ,&loop JCN   ( got bytes -> discard, keep draining )
    #da DEI #02 EQU ,&loop JCN   ( length 0 + still Connected -> EAGAIN, peer alive, spin )
    ;drop-caller JMP2            ( length 0 + state left Connected -> caller EOF'd -> clean close )

( drop-caller: disconnect the current caller; the inbound lane returns to Bound and the )
( next da DEI re-accepts. the listener is NOT consumed — net.c:135-146. )
@drop-caller
    #00 #da DEO                  ( action 0: disconnect current caller )
    ;wait JMP2

@na
    ;na-str ;emit JSR2
    #82 #0f DEO                  ( halt rc 2 — a claim about the LINK )
    BRK
@no-dev
    ;nodev-str ;emit JSR2
    #83 #0f DEO                  ( halt rc 3 — a claim about THIS EMULATOR )
    BRK

( emit: print the NUL-terminated string at the address on the stack. )
@emit                           ( str* -- )
    &l LDAk #00 EQU ,&d JCN
    LDAk #18 DEO INC2 ,&l JMP
    &d POP2
    JMP2r

@na-str "NA 0a 00
@nodev-str "NODEV 0a 00

( reply-buf: the uxn: tag first — only this ROM can produce those four bytes, so a )
( caller's assert is about the ROM, not a stray echo or its own buffer read back. )
@reply-buf  "uxn 3a $40
@uri-buf   $40
@path-buf  $40
@in-buf    $100
