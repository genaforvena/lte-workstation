#!/usr/bin/env bash
# mesh-lease-audit — run the portable lease-gate.rom over the WHOLE LIVE reflex set (uxn-pilot-gate).
#
# This is the load-bearing resolver the fixtures stand-in (lease-fixtures) only mocked. For every
# reflex that self-declares a `# reflex-cadence:` header in the genome it resolves TWO independent
# integers and hands them to the 134-byte ROM, which owns the `lease >= 2*cadence` verdict:
#
#   cadence ← the reflex's OWN `# reflex-cadence:` header      (source A: the reflex file)
#   lease   ← mesh-reflex-health's eff_maxage derivation       (source B: the watchdog config)
#
# The two sources are genuinely independent — one is what the reflex SAYS it runs at, the other is
# what its liveness watchdog will tolerate — so a disagreement (a lease that drops below 2x the
# declared cadence) is a real regression, not a tautology.
#
# WHY A HEALTHY FLEET AUDITS CLEAN (and that is honest, not a dud). eff_maxage's @auto rule derives
# lease = cadence x 2 BY DESIGN — the maxage-from-cadence machinery (mesh-reflex-health, chat-review
# 2026-06-24) exists precisely to make lease < 2*cadence impossible to express by accident. So on the
# live fleet this audit finds ZERO violations. Its value is a REGRESSION GUARD, not a bug-finder:
#   - the day eff_maxage's `s*2` is edited to `s*1`, EVERY reflex here flips RED (the derivation broke);
#   - the day a watchdog lease is hardcoded to a literal below 2x its cadence (the
#     `a-lease-must-exceed-its-producers-cadence` memory), THAT reflex flips RED.
# Caught by arithmetic in a portable ROM — not by a self-grep that can only see that a string is
# present, never that the number is right (CLAUDE.md, the 33/52 self-matching-gate sweep 1969a5d).
#
# usage:  mesh-lease-audit            # audit the live genome, report clean/violations, exit 0/1
#         mesh-lease-audit --list     # also print every resolved (name cadence lease OK/RED) row
# env:    MESH_SCRIPTS_DIR (default: the genome scripts/ dir two levels up)
#         MESH_REFLEX_HEALTH (default: the mesh-reflex-health next to the genome / on PATH)
set -eu
here="$(cd "$(dirname "$0")" && pwd)"
ROM="${MESH_LEASE_ROM:-$here/lease-gate.rom}"
UXNCLI="${MESH_UXNCLI:-$here/bin/uxncli}"
[ -x "$UXNCLI" ] || { echo "mesh-lease-audit: no uxncli — run $here/build.sh" >&2; exit 2; }
[ -f "$ROM" ]    || { echo "mesh-lease-audit: no $ROM — run $here/build.sh --rom" >&2; exit 2; }

# genome scripts/ dir (this tool lives at scripts/uxn/, reflexes at scripts/*)
SCRIPTS="${MESH_SCRIPTS_DIR:-$(cd "$here/.." && pwd)}"

# Source mesh-reflex-health as the ONE authority for cadence->lease (never duplicate the arithmetic).
RH="${MESH_REFLEX_HEALTH:-}"
[ -n "$RH" ] || RH="$SCRIPTS/mesh-reflex-health"
[ -f "$RH" ] || RH="$(command -v mesh-reflex-health || true)"
[ -n "$RH" ] && [ -f "$RH" ] || { echo "mesh-lease-audit: cannot find mesh-reflex-health (set MESH_REFLEX_HEALTH)" >&2; exit 2; }
# shellcheck disable=SC1090
MESH_REFLEX_HEALTH_SOURCED=1 . "$RH"
command -v cron_stride_from_fields >/dev/null 2>&1 && command -v eff_maxage >/dev/null 2>&1 \
  || { echo "mesh-lease-audit: sourced $RH but eff_maxage/cron_stride_from_fields missing (stale mesh-reflex-health?)" >&2; exit 2; }

# (cad lease) -> OK|RED. The ROM halts #80 (exit 0) whenever it rendered a verdict — verdict is
# TEXT, exit code means "the emulator ran". A nonzero pipeline here is real breakage (missing/old
# ROM, dead emulator) and must be LOUD: the sourced mesh-reflex-health turns pipefail on in this
# shell, so without the || this died silently at the first verdict (caught 2026-07-23 vendor-swap:
# old-convention #01 halt read as exit 1 under modern uxncli's `state & 0x7f`).
rom_verdict(){ "$UXNCLI" "$ROM" "$1" "$2" 2>/dev/null | tr -d '[:space:]' \
  || { echo "mesh-lease-audit: uxncli failed on pair ($1,$2) — rebuild? ($here/build.sh --rom)" >&2; exit 2; }; }

want_list=0; [ "${1:-}" = --list ] && want_list=1

# Synthesize a cron file from the header cadences so eff_maxage's @auto derives the lease from the
# DECLARED cadence via its real code path (a future edit to eff_maxage's multiplier is thus caught,
# not bypassed). One line per reflex: "<5-field header cron> <toolname>".
tmpcron="$(mktemp)"; trap 'rm -f "$tmpcron"' EXIT

checked=0; violations=0; skipped=0; rows=""; redrows=""
for f in "$SCRIPTS"/*; do
  [ -f "$f" ] || continue
  hdr="$(grep -m1 -E '^#[[:space:]]*reflex-cadence:' "$f" 2>/dev/null)" || continue
  [ -n "$hdr" ] || continue
  name="$(basename "$f")"
  # strip everything up to and including the label, keep the cron fields (drop trailing "(every ...)")
  cron="${hdr#*reflex-cadence:}"
  # shellcheck disable=SC2086
  set -- $cron
  [ $# -ge 2 ] || { skipped=$((skipped+1)); continue; }
  min="$1"; hr="$2"
  cad="$(cron_stride_from_fields "$min" "$hr")"
  if [ "${cad:-0}" -le 0 ]; then skipped=$((skipped+1)); continue; fi   # list-cron / un-derivable
  printf '%s %s * * * %s\n' "$min" "$hr" "$name" >> "$tmpcron"
  lease="$(CRON_SRC="$tmpcron" eff_maxage @auto "$name")"
  if [ "$lease" = skip ] || [ "${lease:-0}" -le 0 ]; then skipped=$((skipped+1)); continue; fi
  v="$(rom_verdict "$cad" "$lease")"
  checked=$((checked+1))
  rows="$rows$(printf '%-28s cad=%-6s lease=%-6s %s\n' "$name" "$cad" "$lease" "$v")
"
  if [ "$v" != OK ]; then
    violations=$((violations+1))
    redrows="$redrows$(printf '  RED %-28s cadence=%ss lease=%ss (lease < 2*cadence)\n' "$name" "$cad" "$lease")
"
  fi
done

# ALSO audit any EXPLICIT-LITERAL watchdog lease in mesh-reflex-health's REFLEXES table (e.g.
# lan-newdevice|...|6300|...): those are hand-set numbers, exactly where a bad hardcode would hide.
# cadence for such a row = the tool's DEPLOYED cron stride (eff_maxage's own source), lease = the literal.
if [ -n "${REFLEXES:-}" ]; then
  while IFS='|' read -r rname _art intent rtool; do
    [ -n "$rname" ] || continue
    case "$intent" in ''|@*) continue;; esac   # only explicit numeric literals
    [ "$intent" -eq "$intent" ] 2>/dev/null || continue
    stride="$(cron_stride_s "$rtool")"          # deployed-cron stride for this tool
    [ "${stride:-0}" -gt 0 ] || { skipped=$((skipped+1)); continue; }
    v="$(rom_verdict "$stride" "$intent")"
    checked=$((checked+1))
    rows="$rows$(printf '%-28s cad=%-6s lease=%-6s %s (table literal)\n' "$rname" "$stride" "$intent" "$v")
"
    if [ "$v" != OK ]; then
      violations=$((violations+1))
      redrows="$redrows$(printf '  RED %-28s cadence=%ss lease=%ss (table literal < 2*cadence)\n' "$rname" "$stride" "$intent")
"
    fi
  done <<EOF
$REFLEXES
EOF
fi

[ "$want_list" = 1 ] && printf '%s' "$rows"

if [ "$violations" -gt 0 ]; then
  echo "lease-audit: $violations VIOLATION(s) — a watchdog lease flaps STALE every cycle:" >&2
  printf '%s' "$redrows" >&2
  exit 1
fi
echo "lease-audit: clean — $checked reflex(es) gated, every lease >= 2*cadence (${skipped} un-derivable cadence skipped)"
exit 0
