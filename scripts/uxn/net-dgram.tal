( net-dgram.tal — the step-3 gate ROM for the network device (0xd0): it binds a DATAGRAM. )
(                                                                                        )
( net-echo dials out, net-listen answers a stream; this one answers a DATAGRAM, which is )
( the lane the gossip layer needs: no handshake, no accept, no connection to keep — a )
( packet arrives, the ROM reads it and replies to whoever sent it. It is the smallest )
( program that can prove that path across a real node boundary. )
(                                                                                        )
( input  : one line on stdin — the bind address, colon-separated 'udp:host:port'. The )
(          host is always a NAMED address. There is no any-address form here at all: the )
(          device refuses '*', 0.0.0.0 and :: on a datagram bind, because nothing )
(          handshakes on this lane and uxn's whole authentication story is the tailnet ACL. )
( output : nothing on stdout on success — the answer goes to the SENDER, tagged 'uxn:' + )
(          the bytes received, and the ROM halts rc 0. )
(          "NA" + newline, rc 2 — bind refused, nobody sent, or an empty packet. )
(          "NODEV" + newline, rc 3 — this emulator's 0xd0 device is absent or too old. )
(                                                                                        )
( THE TAG IS THE POINT, same as net-listen: a bare echo would pass against socat, against )
( a stray responder, against the sender reading its own buffer. 'uxn:' can only come from )
( this program, so the sender's assert is about the ROM and not about the port. )
(                                                                                        )
( STEP 3, NOT 2. Identify is compared as an ORDERING — device d0, step >= 03 — because a )
( datagram bind is what arrived in step 3; a step-2 emulator parses 'udp:' perfectly well )
( and then refuses the bind BY NAME, which is the right failure but a confusing one to )
( read as "the far node is down". The ROM asks the emulator what it is, first. )
(                                                                                        )
( POLLING A DATAGRAM LANE IS SAFE, and that is a real difference from net-listen. On an )
( inbound STREAM lane the state read IS the accept, so an extra poll eats the next caller )
( — the bug the sysfs-serve gate was built around. On a datagram lane the state read is a )
( select() and nothing else: it never consumes the packet, so the loop below can ask as )
( many times as it likes. The handle port says which lane kind this is — 0x02xx datagram, )
( 0x01xx an accepted stream — so a ROM never has to guess which rule it is under. )
(                                                                                        )
( zero-page: tries=00 ptr=02 len=04 i=06 got=08 )

|0100
    #0000 #d4 DEO2           ( clear the length register: a device-less page reads this back )
    #d0 #da DEO              ( action d0 Identify — only the DEVICE answers )
    #d4 DEI #d0 NEQ ,&nodev JCN   ( high byte: is this our device at all )
    #d5 DEI #03 LTH ,&nodev JCN   ( low byte: the STEP. The datagram bind arrived in step 3 )
    ;on-console #10 DEO2
    ;uri-buf #02 STZ2        ( the one input line accumulates into the address buffer )
    BRK
    &nodev ;no-dev JMP2

@on-console
    #12 DEI
    DUP #0a EQU ,&nl JCN
    #02 LDZ2 STA             ( byte -> ram[ptr] )
    #02 LDZ2 INC2 #02 STZ2
    BRK
    &nl
    POP
    ;serve JMP2

@serve
    #00 #02 LDZ2 STA         ( NUL-terminate the address in place )
    #01 #df DEO              ( SELECT the lane FIRST — a datagram bind occupies exactly the )
                             ( selected channel, and channel 0 is the outbound lane )
    ;uri-buf #dd DEO2        ( the low byte of the bindaddr port IS the bind trigger )
    #db DEI2 #0000 EQU2 ,&norun JCN  ( the handle is 0 when nothing bound — asked here )
                             ( because it is the ONE read that touches no socket, so a )
                             ( refused bind is caught without spending a wait on it )
    #03 #00 STZ              ( at most three waits, each one device deadline long )
    ;wait JMP2
    &norun ;na JMP2

@wait
    #da DEI                  ( WAITS for a packet — the device's deadline, not a spin )
    DUP #03 EQU ,&go JCN     ( HasData: something is queued )
    #06 EQU ,&again JCN      ( still Bound: the socket is up, nobody sent yet )
    ;na JMP2                 ( Unbound: the socket itself is gone )
    &again
    #00 LDZ #01 SUB #00 STZ
    #00 LDZ #00 EQU ,&spent JCN
    ;wait JMP2
    &spent ;na JMP2
    &go POP ;recv JMP2

@recv
    #0100 #d4 DEO2           ( read up to 256 bytes — a datagram too big for this is )
                             ( DISCARDED by the device and loudly, never delivered short )
    ;in-buf #d6 DEO2         ( the low byte of the read port receives )
    #d4 DEI2 #08 STZ2        ( got = the length the device actually moved )
    #08 LDZ2 #0000 EQU2 ,&empty JCN
    #0000 #06 STZ2
    &cp                      ( copy the payload in behind the tag )
    ;in-buf #06 LDZ2 ADD2 LDA
    ;out-body #06 LDZ2 ADD2 STA
    #06 LDZ2 INC2 #06 STZ2
    #06 LDZ2 #08 LDZ2 NEQ2 ,&cp JCN
    #08 LDZ2 #0004 ADD2 #04 STZ2           ( len = the 4-byte tag + got )
    #04 LDZ2 #d4 DEO2
    ;out-buf #d8 DEO2                      ( goes back to whoever SENT the packet — the )
                                           ( device recorded the sender, the ROM never )
                                           ( names it, and with nothing read there would )
                                           ( be no address and the write would refuse )
    #d4 DEI2 #04 LDZ2 NEQ2 ,&short JCN     ( a SHORT WRITE is not a success )
    #80 #0f DEO              ( halt, exit 0 )
    BRK
    &empty ;na JMP2
    &short ;na JMP2

@na
    ;na-str ;emit JSR2
    #82 #0f DEO              ( halt, exit 2 — a claim about the LINK )
    BRK

@no-dev
    ;nodev-str ;emit JSR2
    #83 #0f DEO              ( halt, exit 3 — a claim about THIS EMULATOR, not the link )
    BRK

( emit: print the NUL-terminated string at the address on the stack. )
@emit                        ( str* -- )
    &l LDAk #00 EQU ,&d JCN
    LDAk #18 DEO INC2 ,&l JMP
    &d POP2
    JMP2r

@na-str "NA 0a 00
@nodev-str "NODEV 0a 00

( the tag is DATA and every buffer after it is a pad, so it goes FIRST — same reason as )
( net-listen: bytes written past the last pad are what sets the ROM's length. )
@out-buf  "uxn 3a          ( the tag: 'uxn:' — four bytes no echo responder can produce )
@out-body $200
@uri-buf  $200
@in-buf   $200
