#!/usr/bin/env bash
# test-band-gate — RED-first proof for the 2nd gate CLASS (a compound boundary band).
#
# Same claim shape as test-lease-gate, a DIFFERENT predicate: a real gate (two comparisons in the
# ROM) catches an out-of-band value that the canonical VACUOUS self-grep gate (asserts a string is
# present in the source) sails green past. And it proves the ROM does BOTH edges, not one — by
# corrupting each comparison in turn and watching a genuinely-bad value wrongly pass.
set -u
here="$(cd "$(dirname "$0")" && pwd)"
cd "$here"
[ -x bin/uxncli ] || ./build.sh >/dev/null
[ -f band-gate.rom ] || ./bin/uxnasm band-gate.tal band-gate.rom >/dev/null
rc=0

# the OLD gate (doctrine's canonical vacuity): grep the source for the band's intent string.
old_selfgrep_gate() { grep -q 'lo <= value <= hi' band-gate.tal && return 0 || return 1; }
# the NEW gate: run the ROM on the actual (lo, value, hi) triple.
rom_gate() { ./mesh-band-gate "$1" "$2" "$3" >/dev/null 2>&1; }

# 1) ROM truth table — band [20,80], BOTH edges INCLUSIVE, RED past either.
rom_gate 20 50 80 || { echo "FAIL: mid-band value should pass"; rc=1; }
rom_gate 20 20 80 || { echo "FAIL: value == lo (inclusive) should pass"; rc=1; }
rom_gate 20 80 80 || { echo "FAIL: value == hi (inclusive) should pass"; rc=1; }
rom_gate 20 19 80 && { echo "FAIL: value just below lo must go RED"; rc=1; }
rom_gate 20 81 80 && { echo "FAIL: value just above hi must go RED"; rc=1; }
rom_gate 20 20 20 || { echo "FAIL: degenerate band [20,20] with value 20 should pass"; rc=1; }

# 2) RED-FIRST: a real out-of-band value where the self-grep stays GREEN but the ROM flips RED.
old_selfgrep_gate; old=$?          # 0 = still green (BLIND to the number)
rom_gate 20 5 80;   new=$?          # 1 = RED (5 < 20, caught)
if [ "$old" -eq 0 ] && [ "$new" -eq 1 ]; then
  echo "PASS: below-band value -> self-grep GREEN (blind), ROM RED (caught)"
else
  echo "FAIL: expected self-grep green ($old) + ROM red ($new) on the out-of-band value"; rc=1
fi

# 3) FALSIFIABLE — prove the ROM does BOTH edges, not a constant or a single comparison. Corrupt
#    each GTH2 in turn and demand a genuinely out-of-band value WRONGLY passes (so the real ROM's
#    RED is real arithmetic). We flip a comparison to its no-op by editing the .tal and reassembling.
tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT
# (a) drop the LOWER-edge check (lo>val): a below-band value must then wrongly pass.
sed 's/#00 LDZ2 #02 LDZ2 GTH2/#00 LDZ2 #02 LDZ2 GTH2 POP #00/' band-gate.tal > "$tmp/lo.tal"
if ./bin/uxnasm "$tmp/lo.tal" "$tmp/lo.rom" >/dev/null 2>&1; then
  v="$(./bin/uxncli "$tmp/lo.rom" 20 5 80 2>/dev/null | tr -d '[:space:]')"
  [ "$v" = OK ] && echo "PASS: lower-edge check disabled -> below-band 5 wrongly OK (real ROM does the lo edge)" \
                || { echo "FAIL: disabling lo edge did not let 5 pass (got '$v') — edge may be dead code"; rc=1; }
else echo "FAIL: could not assemble lo-corrupted ROM"; rc=1; fi
# (b) drop the UPPER-edge check (val>hi): an above-band value must then wrongly pass.
sed 's/#02 LDZ2 #04 LDZ2 GTH2/#02 LDZ2 #04 LDZ2 GTH2 POP #00/' band-gate.tal > "$tmp/hi.tal"
if ./bin/uxnasm "$tmp/hi.tal" "$tmp/hi.rom" >/dev/null 2>&1; then
  v="$(./bin/uxncli "$tmp/hi.rom" 20 99 80 2>/dev/null | tr -d '[:space:]')"
  [ "$v" = OK ] && echo "PASS: upper-edge check disabled -> above-band 99 wrongly OK (real ROM does the hi edge)" \
                || { echo "FAIL: disabling hi edge did not let 99 pass (got '$v') — edge may be dead code"; rc=1; }
else echo "FAIL: could not assemble hi-corrupted ROM"; rc=1; fi

# 4) control: the self-grep really is the blind kind (matches its own literal regardless of numbers).
old_selfgrep_gate || { echo "FAIL: self-grep control should always match its own literal"; rc=1; }

[ "$rc" = 0 ] && echo "band-gate-test: ok" || echo "band-gate-test: FAIL"
exit $rc
