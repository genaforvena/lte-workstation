#!/usr/bin/env bash
# mesh-sexpr-gate — run a gate that exists as an s-expr DATA line (gates-as-data stage 1).
#
# The gate LOGIC lives in ./sexpr-gates as text; the one executor is lisp-eval.rom (the fixed
# point, sha1-pinned inside the data file itself — hash-then-execute: the pin is checked against
# the ROM actually about to run, mismatch refuses pre-exec). This shim is marshaling only:
# resolve the named row, bind its params positionally, substitute token-wise, run the evaluator.
# A value is DATA, never code: every arg must be a bare natural (digits only) — anything else is
# refused rc=2, or textual substitution becomes s-expr injection.
#
# Rows are 3-field (name | params | template) or 4-field (name | params | consts | template,
# the threshold-ledger form): consts are calibrated k=v naturals substituted token-wise before
# param binding, so the NUMBERS live in the data line and recalibration is a data diff.
#
# usage: mesh-sexpr-gate <gate> <args…>    args bind to the row's params in order
#        mesh-sexpr-gate --list            print gate rows (name | params | template)
#        mesh-sexpr-gate --const <gate> <k>  print one calibrated const (pure data read, no ROM
#                                            touched — the verb consumers resolve defaults through)
#        mesh-sexpr-gate --test
# exit:  0 = verdict rendered (the number on stdout; the gate line defines its meaning)
#        2 = honest n/a LOUD on stderr — absent engine/ROM/data/gate, arity, non-natural arg,
#            sha mismatch, or the evaluator's own NA (domain edge: NA passes through on stdout)
# env:   MESH_SEXPR_GATES (data file, default $here/sexpr-gates)
#        MESH_SEXPR_ROM   (evaluator, default $here/lisp-eval.rom)
#        MESH_UXNCLI      (emulator,  default $here/bin/uxncli)
set -u
here="$(cd "$(dirname "$0")" && pwd)"
GATES="${MESH_SEXPR_GATES:-$here/sexpr-gates}"
ROM="${MESH_SEXPR_ROM:-$here/lisp-eval.rom}"
UXNCLI="${MESH_UXNCLI:-$here/bin/uxncli}"

[ "${1:-}" = --test ] && exec "$here/test-sexpr-gates"

[ -f "$GATES" ]  || { echo "mesh-sexpr-gate: n/a — no gate data file at $GATES" >&2; exit 2; }
rows(){ grep -vE '^[[:space:]]*(#|$)' "$GATES"; }
if [ "${1:-}" = --list ]; then rows; exit 0; fi

if [ "${1:-}" = --const ]; then
  g="${2:-}"; k="${3:-}"
  [ -n "$g" ] && [ -n "$k" ] || { echo "usage: mesh-sexpr-gate --const <gate> <k>" >&2; exit 2; }
  row="$(rows | awk -F'|' -v g="$g" '{n=$1; gsub(/[[:space:]]/,"",n)} n==g {print; exit}')"
  [ -n "$row" ] || { echo "mesh-sexpr-gate: n/a — gate '$g' not in $GATES" >&2; exit 2; }
  consts="$(printf '%s\n' "$row" | awk -F'|' 'NF>=4 {print $3}')"
  for kv in $consts; do
    case "$kv" in "$k"=*)
      v="${kv#*=}"
      case "$v" in ''|*[!0-9]*) echo "mesh-sexpr-gate: n/a — const '$k' of '$g' is not a natural: '$v'" >&2; exit 2 ;; esac
      printf '%s\n' "$v"; exit 0 ;;
    esac
  done
  echo "mesh-sexpr-gate: n/a — no const '$k' on gate '$g'" >&2; exit 2
fi

if [ "${1:-}" = --pin ]; then
  # the ONE reader of the pin line: a consumer packing the evaluator for a hop asserts
  # its ROM against this, never re-derives the sed.
  pin="$(sed -n 's/^# evaluator-sha1:[[:space:]]*\([0-9a-f]\{40\}\).*/\1/p' "$GATES" | head -1)"
  [ -n "$pin" ] || { echo "mesh-sexpr-gate: n/a — $GATES carries no '# evaluator-sha1:' pin" >&2; exit 2; }
  printf '%s\n' "$pin"; exit 0
fi

# --expr: print the fully-substituted expression, do NOT eval — the hop-packer's verb
# (the expression travels to a remote evaluator; this path is pure data transform, so it
# needs no local engine/ROM — same row resolution and naturals-only guards as eval).
expr_only=0
if [ "${1:-}" = --expr ]; then expr_only=1; shift; fi

[ $# -ge 1 ]     || { echo "usage: mesh-sexpr-gate [--expr] <gate> <args…>  (see header)" >&2; exit 2; }
if [ "$expr_only" -eq 0 ]; then
  [ -x "$UXNCLI" ] || { echo "mesh-sexpr-gate: n/a — no uxncli at $UXNCLI (run $here/build.sh)" >&2; exit 2; }
  [ -f "$ROM" ]    || { echo "mesh-sexpr-gate: n/a — no evaluator at $ROM" >&2; exit 2; }
fi

gate="$1"; shift
row="$(rows | awk -F'|' -v g="$gate" '{n=$1; gsub(/[[:space:]]/,"",n)} n==g {print; exit}')"
[ -n "$row" ] || { echo "mesh-sexpr-gate: n/a — gate '$gate' not in $GATES" >&2; exit 2; }
params="$(printf '%s\n' "$row" | awk -F'|' '{print $2}')"
# 4-field row (threshold-ledger form): field 3 = calibrated consts, template shifts to field 4.
consts="$(printf '%s\n' "$row" | awk -F'|' 'NF>=4 {print $3}')"
template="$(printf '%s\n' "$row" | awk -F'|' '{print (NF>=4) ? $4 : $3}')"
[ -n "$template" ] || { echo "mesh-sexpr-gate: n/a — malformed row for '$gate' (want name | params | [consts |] template)" >&2; exit 2; }

# hash-then-execute: the pin lives WITH the data lines; verify the ROM we are about to load.
# (--expr loads no ROM — the REMOTE execution site verifies what it runs, hop declared-sha1.)
if [ "$expr_only" -eq 0 ]; then
  pin="$(sed -n 's/^# evaluator-sha1:[[:space:]]*\([0-9a-f]\{40\}\).*/\1/p' "$GATES" | head -1)"
  [ -n "$pin" ] || { echo "mesh-sexpr-gate: n/a — $GATES carries no '# evaluator-sha1:' pin" >&2; exit 2; }
  actual="$(sha1sum -- "$ROM" | cut -d' ' -f1)"
  [ "$pin" = "$actual" ] \
    || { echo "mesh-sexpr-gate: n/a — evaluator sha1 mismatch at $ROM (pinned $pin, actual $actual) — refusing to execute" >&2; exit 2; }
fi

# bind params positionally; token-wise substitution over a paren-padded expression.
set -- "$@"
nparam=0; for p in $params; do nparam=$((nparam + 1)); done
[ $# -eq "$nparam" ] \
  || { echo "mesh-sexpr-gate: n/a — $gate wants $nparam args ($params), got $#" >&2; exit 2; }
expr="$(printf '%s' "$template" | sed 's/(/ ( /g; s/)/ ) /g')"
# consts first: calibrated numbers from the data line, same naturals-only guard as args.
for kv in $consts; do
  ck="${kv%%=*}"; cv="${kv#*=}"
  case "$ck" in ''|*[!a-z0-9_]*) echo "mesh-sexpr-gate: n/a — malformed const '$kv' on '$gate'" >&2; exit 2 ;; esac
  case "$cv" in ''|*[!0-9]*)
    echo "mesh-sexpr-gate: n/a — const '$ck' of '$gate' must be a bare natural, got '$cv' (a value is data, never code)" >&2; exit 2 ;;
  esac
  expr="$(printf '%s\n' "$expr" | awk -v p="$ck" -v v="$cv" '{for(i=1;i<=NF;i++) if($i==p) $i=v; print}')"
done
for p in $params; do
  v="$1"; shift
  case "$v" in ''|*[!0-9]*)
    echo "mesh-sexpr-gate: n/a — arg for '$p' must be a bare natural, got '$v' (a value is data, never code)" >&2; exit 2 ;;
  esac
  expr="$(printf '%s\n' "$expr" | awk -v p="$p" -v v="$v" '{for(i=1;i<=NF;i++) if($i==p) $i=v; print}')"
done

if [ "$expr_only" -eq 1 ]; then printf '%s\n' "$expr"; exit 0; fi

urc=0
raw="$("$UXNCLI" "$ROM" "$expr" 2>/dev/null)" || urc=$?
verdict="$(printf '%s' "$raw" | tr -d '[:space:]')"
if [ "$urc" -ne 0 ]; then
  if [ "$verdict" = NA ]; then
    # the evaluator honestly declined (halt #82: 16-bit domain edge, unbound token, parse) —
    # NA passes through on stdout so a consumer can key its inline fallback on it; rc stays 2.
    printf 'NA\n'
    echo "mesh-sexpr-gate: n/a — evaluator answered NA on $gate ($expr)" >&2
    exit 2
  fi
  echo "mesh-sexpr-gate: n/a — uxncli failed (rc=$urc) on $gate ($expr)" >&2
  exit 2
fi
[ -n "$verdict" ] \
  || { echo "mesh-sexpr-gate: n/a — evaluator rendered no verdict on $gate ($expr) — a mute gate is breakage, never a pass" >&2; exit 2; }
printf '%s\n' "$verdict"
exit 0
