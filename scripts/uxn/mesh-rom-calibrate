#!/usr/bin/env bash
# mesh-rom-calibrate — the ROM-vs-second-implementation calibration ledger.
#
# Doctrine (operator 2026-07-23): the ROM is the mesh's first FIXED POINT — an
# oracle. Run BOTH implementations of a predicate on identical inputs and log
# the pair. Under the same ROM, DISAGREEMENT isolates cleanly (the
# implementations differ — spend that signal loudly); AGREEMENT is weak
# evidence (identical wrongness reads as consensus — log it silently, never
# celebrate it). This keeps the N-version diversity signal alive that ROM
# uniformity would otherwise destroy.
#
# v1 predicate: lease-vs-cadence.
#   rom:   mesh-rom-gate lease-gate <cad> <lease>  (16-bit arithmetic in the ROM)
#   shell: lease >= 2*cad in native 64-bit shell arithmetic — a genuinely
#          different implementation; that difference is the point.
# Known divergence domain: pairs beyond the ROM's 16-bit ints (>= 65536 wraps;
# e.g. lease 67335 reads as 1799). The ledger makes that class VISIBLE.
#
# usage: mesh-rom-calibrate                 # fleet: rows from mesh-lease-audit --list
#        mesh-rom-calibrate --pair C L      # one pair
#        mesh-rom-calibrate --rows FILE     # rows from a file (fixtures/tests)
#        mesh-rom-calibrate --ledger [FIX]  # every threshold-ledger fixture row (default
#                                           # ./threshold-fixtures) through mesh-sexpr-gate
#                                           # vs a native-shell twin: twin STRUCTURE is
#                                           # hardcoded here (the N-version point), twin
#                                           # CONSTANTS read from the ledger's consts column
#                                           # (mesh-sexpr-gate --const) so a recalibration
#                                           # moves both sides and DIVERGE stays what it
#                                           # means — expression/evaluator drift. ROM NA on
#                                           # a 16-bit edge logs DOMAIN (shell 64-bit still
#                                           # answers; that asymmetry is the visible class).
#        mesh-rom-calibrate --test
# exit:  0 all pairs agree · 1 >=1 DIVERGE · 2 honest n/a
# ledger: $MESH_CAL_LOG (default ~/.mesh/rom-calibration.log), one line per pair:
#   <ts> predicate=lease-gate sha1=<rom-sha1> name=<n> cad=<c> lease=<l> rom=<V> shell=<V> AGREE|DIVERGE
set -u
here="$(cd "$(dirname "$0")" && pwd)"
ROM="${MESH_CAL_ROM:-$here/lease-gate.rom}"
LEDGER="${MESH_CAL_LOG:-$HOME/.mesh/rom-calibration.log}"
SANDBOX="${MESH_CAL_SANDBOX:-0}"

[ "${1:-}" = --test ] && exec "$here/test-rom-calibrate"

[ -f "$ROM" ] || { echo "rom-calibrate: n/a — no ROM at $ROM" >&2; exit 2; }
ROM_GATE="${MESH_ROM_GATE:-$(cd "$here/.." && pwd)/mesh-rom-gate}"
[ -x "$ROM_GATE" ] || ROM_GATE="$(command -v mesh-rom-gate || true)"
[ -n "$ROM_GATE" ] && [ -x "$ROM_GATE" ] || { echo "rom-calibrate: n/a — no mesh-rom-gate" >&2; exit 2; }

sha="$(sha1sum "$ROM" | cut -d' ' -f1)"   # hash the fixed point we are about to consult
diverged=0

check_pair() { # name cad lease
  local name="$1" cad="$2" lease="$3"
  local rv rc_rom sv verdict
  rv="$("$ROM_GATE" "$ROM" "$cad" "$lease" 2>/dev/null)"; rc_rom=$?
  if [ "$lease" -ge "$((2 * cad))" ]; then sv=OK; else sv=RED; fi
  if [ "$rc_rom" -ge 2 ] || [ -z "$rv" ]; then
    if [ "$rv" = NA ]; then
      # The ROM honestly declined (out of its int domain, halt #82): a boundary,
      # not an implementation split — log DOMAIN, neither agree nor diverge.
      verdict=DOMAIN
    else
      echo "rom-calibrate: n/a — rom path broke on ($cad,$lease) rc=$rc_rom" >&2; exit 2
    fi
  elif [ "$rv" = "$sv" ]; then verdict=AGREE; else verdict=DIVERGE; diverged=1; fi
  local line
  line="$(date -u +%FT%TZ) predicate=lease-gate sha1=$sha name=$name cad=$cad lease=$lease rom=$rv shell=$sv $verdict"
  printf '%s\n' "$line"
  printf '%s\n' "$line" >>"$LEDGER"
  if [ "$verdict" = DIVERGE ]; then
    # disagreement is the STRONG signal — spend it loudly
    if [ "$SANDBOX" = 1 ]; then
      echo "would-post: [chat-review] rom-calibrate DIVERGE $name ($cad,$lease) rom=$rv shell=$sv"
    elif command -v mesh-chat >/dev/null 2>&1; then
      mesh-chat "[chat-review] rom-calibrate DIVERGE: predicate=lease-gate name=$name cad=$cad lease=$lease rom=$rv shell=$sv sha1=${sha:0:8} — two implementations split on identical inputs; under the same ROM this isolates to the implementations (16-bit domain edge is the known class). owner: mesh-rom-gate/genome" >/dev/null || true
    fi
  fi
}

case "${1:-}" in
  --ledger)
    # a deployed copy (~/.local/bin) has no uxn tree beside it — fall back to the genome checkout
    uxdir="$here"; [ -f "$uxdir/threshold-ledger" ] || uxdir="${MESH_REPO:-$HOME/lte-workstation}/scripts/uxn"
    FIX="${2:-$uxdir/threshold-fixtures}"
    [ -f "$FIX" ] || { echo "rom-calibrate: n/a — no fixtures at $FIX" >&2; exit 2; }
    SEXPR="$uxdir/mesh-sexpr-gate"
    [ -x "$SEXPR" ] || { echo "rom-calibrate: n/a — no mesh-sexpr-gate at $SEXPR" >&2; exit 2; }
    LEDFILE="${MESH_SEXPR_GATES:-$uxdir/threshold-ledger}"
    [ -f "$LEDFILE" ] || { echo "rom-calibrate: n/a — no threshold ledger at $LEDFILE" >&2; exit 2; }
    EROM="${MESH_SEXPR_ROM:-$uxdir/lisp-eval.rom}"
    [ -f "$EROM" ] || { echo "rom-calibrate: n/a — no evaluator at $EROM" >&2; exit 2; }
    esha="$(sha1sum -- "$EROM" | cut -d' ' -f1)"
    tconst(){ MESH_SEXPR_GATES="$LEDFILE" "$SEXPR" --const "$1" "$2" 2>/dev/null; }
    # The shell twin: STRUCTURE hardcoded (a genuinely different implementation — the
    # N-version point), CONSTANTS from the ledger's consts column — recalibration moves
    # both sides, so DIVERGE isolates expression/evaluator drift, never a stale twin.
    twin(){ # gate args… → verdict on stdout, rc1 = no twin for this gate
      case "$1" in
        clear-fresh)
          local fresh; fresh="$(tconst clear-fresh fresh)" || return 1
          if [ "$2" -le "$fresh" ]; then echo 1; else echo 0; fi ;;
        load-gate)
          local k q0 q1
          k="$(tconst load-gate k)" && q0="$(tconst load-gate q0)" && q1="$(tconst load-gate q1)" || return 1
          if [ "$3" -ge "$q0" ] && [ "$3" -lt "$q1" ]; then echo 0
          elif [ "$2" -gt "$((k * $4))" ]; then echo 2
          else echo 1; fi ;;
        lease-margin)
          local k; k="$(tconst lease-margin k)" || return 1
          if [ "$3" -ge "$((k * $2))" ]; then echo 1; else echo 0; fi ;;
        body-thermal)
          # 4-level hysteresis twin (deci-°C, integer): p 0..3 = prev level, else snap.
          local u1 d1 u2 d2 u3 d3 s1 s2 s3
          u1="$(tconst body-thermal u1)" && d1="$(tconst body-thermal d1)" \
            && u2="$(tconst body-thermal u2)" && d2="$(tconst body-thermal d2)" \
            && u3="$(tconst body-thermal u3)" && d3="$(tconst body-thermal d3)" \
            && s1="$(tconst body-thermal s1)" && s2="$(tconst body-thermal s2)" \
            && s3="$(tconst body-thermal s3)" || return 1
          case "$3" in
            0) if [ "$2" -gt "$u1" ]; then echo 1; else echo 0; fi ;;
            1) if [ "$2" -lt "$d1" ]; then echo 0
               elif [ "$2" -gt "$u2" ]; then echo 2; else echo 1; fi ;;
            2) if [ "$2" -lt "$d2" ]; then echo 1
               elif [ "$2" -gt "$u3" ]; then echo 3; else echo 2; fi ;;
            3) if [ "$2" -lt "$d3" ]; then echo 2; else echo 3; fi ;;
            *) if [ "$2" -lt "$s1" ]; then echo 0
               elif [ "$2" -le "$s2" ]; then echo 1
               elif [ "$2" -le "$s3" ]; then echo 2; else echo 3; fi ;;
          esac ;;
        host-therm)
          local lo hi; lo="$(tconst host-therm lo)" && hi="$(tconst host-therm hi)" || return 1
          if [ "$2" -lt "$lo" ]; then echo 0; elif [ "$2" -lt "$hi" ]; then echo 1; else echo 2; fi ;;
        swap-pressure)
          local lo mid hi
          lo="$(tconst swap-pressure lo)" && mid="$(tconst swap-pressure mid)" && hi="$(tconst swap-pressure hi)" || return 1
          if [ "$2" -lt "$lo" ]; then echo 0; elif [ "$2" -lt "$mid" ]; then echo 1
          elif [ "$2" -lt "$hi" ]; then echo 2; else echo 3; fi ;;
        airtime-busy)
          local lo mid hi
          lo="$(tconst airtime-busy lo)" && mid="$(tconst airtime-busy mid)" && hi="$(tconst airtime-busy hi)" || return 1
          if [ "$2" -lt "$lo" ]; then echo 0; elif [ "$2" -lt "$mid" ]; then echo 1
          elif [ "$2" -lt "$hi" ]; then echo 2; else echo 3; fi ;;
        backlight-level)
          local lo hi; lo="$(tconst backlight-level lo)" && hi="$(tconst backlight-level hi)" || return 1
          if [ "$2" -lt "$lo" ]; then echo 0; elif [ "$2" -lt "$hi" ]; then echo 1; else echo 2; fi ;;
        screen-bright)
          local lo hi; lo="$(tconst screen-bright lo)" && hi="$(tconst screen-bright hi)" || return 1
          if [ "$2" -lt "$lo" ]; then echo 0; elif [ "$2" -le "$hi" ]; then echo 1; else echo 2; fi ;;
        power-charge)
          local crit low; crit="$(tconst power-charge crit)" && low="$(tconst power-charge low)" || return 1
          if [ "$2" -lt "$crit" ]; then echo 0; elif [ "$2" -lt "$low" ]; then echo 1; else echo 2; fi ;;
        battery-charge)
          local crit low; crit="$(tconst battery-charge crit)" && low="$(tconst battery-charge low)" || return 1
          if [ "$2" -lt "$crit" ]; then echo 0; elif [ "$2" -lt "$low" ]; then echo 1; else echo 2; fi ;;
        battery-wear)
          local eol aged; eol="$(tconst battery-wear eol)" && aged="$(tconst battery-wear aged)" || return 1
          if [ "$2" -lt "$eol" ]; then echo 0; elif [ "$2" -lt "$aged" ]; then echo 1; else echo 2; fi ;;
        hw-wear-floor)
          local floor; floor="$(tconst hw-wear-floor floor)" || return 1
          if [ "$2" -lt "$floor" ]; then echo 1; else echo 0; fi ;;
        diary-stale)
          local budget; budget="$(tconst diary-stale budget)" || return 1
          if [ "$2" -gt "$budget" ]; then echo 1; else echo 0; fi ;;
        vitals-disk)
          local max; max="$(tconst vitals-disk max)" || return 1
          if [ "$2" -gt "$max" ]; then echo 1; else echo 0; fi ;;
        vitals-mem)
          local max; max="$(tconst vitals-mem max)" || return 1
          if [ "$2" -gt "$max" ]; then echo 1; else echo 0; fi ;;
        vitals-temp)
          local max; max="$(tconst vitals-temp max)" || return 1
          if [ "$2" -gt "$max" ]; then echo 1; else echo 0; fi ;;
        vitals-load)
          local k; k="$(tconst vitals-load k)" || return 1
          if [ "$2" -gt "$((k * $3))" ]; then echo 1; else echo 0; fi ;;
        tick-therm|tick-offload)
          local max; max="$(tconst "$1" max)" || return 1
          if [ "$2" -ge "$max" ]; then echo 1; else echo 0; fi ;;
        vpn-peer-fresh)
          local act idle; act="$(tconst vpn-peer-fresh act)" && idle="$(tconst vpn-peer-fresh idle)" || return 1
          if [ "$2" -lt "$act" ]; then echo 0; elif [ "$2" -lt "$idle" ]; then echo 1; else echo 2; fi ;;
        node-pressure)
          # two independent axes, mem first; the swap leg is SKIPPED outright on a swapless
          # node ($4=0) rather than compared against a zero total.
          local mem swap; mem="$(tconst node-pressure mem)" && swap="$(tconst node-pressure swap)" || return 1
          if [ "$2" -lt "$mem" ]; then echo 1
          elif [ "$4" -eq 0 ]; then echo 0
          elif [ "$3" -lt "$swap" ]; then echo 1
          else echo 0; fi ;;
        therm-alarm)
          # the operator-notification tier: max >= CRIT → 1 (board/operator page), else 0 (trace).
          # Same predicate mesh-therm-watch's therm_tier() computes; consts from the ledger row.
          local crit; crit="$(tconst therm-alarm crit)" || return 1
          if [ "$2" -ge "$crit" ]; then echo 1; else echo 0; fi ;;
        stress-thermal)
          # mesh-stress's raw temp→level band (0 CALM/1 WARM/2 STRESSED/3 CRITICAL). Twin
          # written as a top-down >= ladder to mirror the CONSUMER (mesh-stress assess(), the
          # temp -ge CRIT_C/STRESSED_C/WARM_C chain), not the ROM's bottom-up nested-if — an
          # independent structure, so DIVERGE isolates to expression/evaluator drift.
          local warm stressed crit
          warm="$(tconst stress-thermal warm)" && stressed="$(tconst stress-thermal stressed)" \
            && crit="$(tconst stress-thermal crit)" || return 1
          if [ "$2" -ge "$crit" ]; then echo 3
          elif [ "$2" -ge "$stressed" ]; then echo 2
          elif [ "$2" -ge "$warm" ]; then echo 1
          else echo 0; fi ;;
        *) return 1 ;;
      esac
    }
    n=0
    while IFS= read -r row; do
      case "$row" in ''|\#*) continue ;; esac
      set -- $row
      gate="$1"; shift
      [ $# -ge 2 ] || continue                # need at least one arg + the want column
      args=("${@:1:$(($#-1))}")               # fixture rows end in a want column — both
                                              # implementations answer for themselves here
      rv="$(MESH_SEXPR_GATES="$LEDFILE" "$SEXPR" "$gate" "${args[@]}" 2>/dev/null)"; rc_rom=$?
      sv="$(twin "$gate" "${args[@]}")" \
        || { echo "rom-calibrate: n/a — no shell twin for gate '$gate' (row '$row')" >&2; exit 2; }
      if [ "$rc_rom" -ge 2 ] || [ -z "$rv" ]; then
        if [ "$rv" = NA ]; then verdict=DOMAIN
        else echo "rom-calibrate: n/a — rom path broke on '$row' rc=$rc_rom" >&2; exit 2; fi
      elif [ "$rv" = "$sv" ]; then verdict=AGREE
      else verdict=DIVERGE; diverged=1; fi
      line="$(date -u +%FT%TZ) predicate=$gate sha1=$esha inputs=\"${args[*]}\" rom=$rv shell=$sv $verdict"
      printf '%s\n' "$line"
      printf '%s\n' "$line" >>"$LEDGER"
      if [ "$verdict" = DIVERGE ]; then
        if [ "$SANDBOX" = 1 ]; then
          echo "would-post: [chat-review] rom-calibrate DIVERGE $gate (${args[*]}) rom=$rv shell=$sv"
        elif command -v mesh-chat >/dev/null 2>&1; then
          mesh-chat "[chat-review] rom-calibrate DIVERGE: predicate=$gate inputs='${args[*]}' rom=$rv shell=$sv sha1=${esha:0:8} — ROM expression and shell twin split on identical inputs under shared consts; this isolates to the expression/evaluator. owner: mesh-sexpr-gate/genome" >/dev/null || true
        fi
      fi
      n=$((n + 1))
    done <"$FIX"
    [ "$n" -gt 0 ] || { echo "rom-calibrate: n/a — no parseable fixture rows in $FIX" >&2; exit 2; }
    echo "rom-calibrate: $n ledger rows, diverged=$diverged sha1=$esha"
    ;;
  --pair)
    c="${2:?--pair C L}"; l="${3:?--pair C L}"
    case "$c$l" in *[!0-9]*) echo "rom-calibrate: non-numeric pair" >&2; exit 2 ;; esac
    check_pair adhoc "$c" "$l"
    ;;
  --rows|'')
    if [ "${1:-}" = --rows ]; then
      rows="$(cat "${2:?--rows FILE}")"
    else
      rows="$("$here/mesh-lease-audit" --list 2>/dev/null)" \
        || { echo "rom-calibrate: n/a — mesh-lease-audit --list failed" >&2; exit 2; }
    fi
    [ -n "$rows" ] || { echo "rom-calibrate: n/a — zero rows" >&2; exit 2; }
    n=0
    while IFS= read -r row; do
      name="${row%% *}"
      cad="$(printf '%s\n' "$row" | sed -n 's/.*cad=\([0-9]*\).*/\1/p')"
      lease="$(printf '%s\n' "$row" | sed -n 's/.*lease=\([0-9]*\).*/\1/p')"
      [ -n "$name" ] && [ -n "$cad" ] && [ -n "$lease" ] || continue
      check_pair "$name" "$cad" "$lease"
      n=$((n + 1))
    done <<EOF
$rows
EOF
    [ "$n" -gt 0 ] || { echo "rom-calibrate: n/a — no parseable rows" >&2; exit 2; }
    echo "rom-calibrate: $n pairs, diverged=$diverged sha1=$sha"
    if [ -z "${1:-}" ]; then
      # bare invocation is the cron entrypoint — the threshold ledger rides the same cadence
      # (uxn-threshold-ledger). Its n/a (no uxn tree on this node) must not sink the fleet
      # lease result just rendered — note it LOUD and keep the lease verdict.
      lrc=0; "$0" --ledger || lrc=$?
      if [ "$lrc" -eq 1 ]; then diverged=1
      elif [ "$lrc" -ge 2 ]; then echo "rom-calibrate: note — threshold-ledger pass n/a (rc=$lrc), fleet lease result stands" >&2; fi
    fi
    ;;
  *)
    echo "usage: mesh-rom-calibrate [--pair C L | --rows FILE | --test]" >&2; exit 64
    ;;
esac
exit "$diverged"
