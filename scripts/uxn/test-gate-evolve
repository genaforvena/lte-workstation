#!/usr/bin/env bash
# test-gate-evolve — gate for mesh-gate-evolve (gates-as-data stage 4b, 2026-07-23).
#
# CONTRACT: mesh-gate-evolve is the unattended autopoiesis reflex over the admission harness.
# One run = at most ONE candidate reaches a verdict, and mesh-gate-admission is the ONLY door:
#   drain-first  — the oldest parked *.cand in the candidate dir is --admit'ed and renamed
#                  .cand.admitted / .cand.rejected (the dir is a queue, never a re-try loop)
#   else propose — next goal from the gate-goals rotation → --propose → --admit → rename
#   capacity     — >= MAX admitted rows: proposing stops (bloat guard), drain still runs
#   honest n/a   — generator/env down = rc 2, NO verdict forged, parked candidates stay parked
# The stub relay here RECORDS every call, so "no relay call" is asserted, not assumed.
set -u
here="$(cd "$(dirname "$0")" && pwd)"
cd "$here"
[ -x bin/uxncli ] || ./build.sh >/dev/null 2>&1 || { echo "gate-evolve-test: n/a (no uxncli and toolchain build failed)" >&2; exit 2; }
[ -f lisp-eval.rom ] || { echo "gate-evolve-test: n/a (no lisp-eval.rom)" >&2; exit 2; }
[ -x mesh-gate-evolve ] || { echo "gate-evolve-test: FAIL (no mesh-gate-evolve)"; exit 1; }
rc=0
tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT
fail(){ echo "  FAIL: $*"; rc=1; }

# stub generator: emits a VALID boundary-pinned candidate, logs each prompt it was handed
cat > "$tmp/relay" <<'EOF'
#!/bin/sh
echo "$1" >> "${RELAY_CALLS:?}"
n="${RELAY_NAME:-gen-hot}"
cat <<CAND
row: $n | t | hot=85 | (if (>= t hot) 1 0)
fix: $n 84 0
fix: $n 85 1
fix: $n 86 1
fix: $n 0 0
CAND
EOF
chmod +x "$tmp/relay"

sand(){ # reset sandbox: private ledger/fixtures/adopted/log/cand-dir/goals/state
  cp threshold-ledger "$tmp/ledger"
  cp threshold-fixtures "$tmp/fixtures"
  : > "$tmp/admitted"; : > "$tmp/log"; : > "$tmp/calls"
  rm -rf "$tmp/cands"; mkdir -p "$tmp/cands"
  printf 'goal one: hot band\ngoal two: cold band\n' > "$tmp/goals"
  rm -f "$tmp/state"
}
evolve(){
  MESH_ADMIT_LEDGER="$tmp/ledger" MESH_ADMIT_FIXTURES="$tmp/fixtures" \
  MESH_ADMIT_ADOPTED="$tmp/admitted" MESH_ADMIT_LOG="$tmp/log" \
  MESH_ADMIT_CAND_DIR="$tmp/cands" MESH_ADMIT_RELAY="$tmp/relay" \
  RELAY_CALLS="$tmp/calls" MESH_GATE_GOALS="$tmp/goals" MESH_GATE_STATE="$tmp/state" \
  ./mesh-gate-evolve "$@" 2>"$tmp/err"
}

# --- A. propose→verdict end-to-end: goal from rotation → ADMIT logged, cand renamed -------
sand
out="$(evolve)" || fail "clean propose run rc!=0: $out $(cat "$tmp/err")"
grep -q 'ADMIT name=gen-hot' "$tmp/log" || fail "no ADMIT verdict in admission log after propose run"
sed 's/[[:space:]]*|.*//' "$tmp/ledger" | grep -qx 'gen-hot' || fail "admitted row not in ledger"
grep -q 'goal one' "$tmp/calls" || fail "generator was not handed the first rotation goal"
ls "$tmp/cands"/*.cand >/dev/null 2>&1 && fail "verdict-reached candidate left parked as .cand"
ls "$tmp/cands"/*.cand.admitted >/dev/null 2>&1 || fail "admitted candidate not renamed .cand.admitted"

# --- B. rotation advances: second run hands the generator the SECOND goal -----------------
RELAY_NAME=gen-cold evolve >/dev/null || fail "second propose run rc!=0: $(cat "$tmp/err")"
grep -q 'goal two' "$tmp/calls" || fail "rotation did not advance to the second goal"

# --- C. drain-first: a parked candidate is judged BEFORE any new proposal -----------------
sand
cat > "$tmp/cands/weak.cand" <<'EOF'
row: weak-hot | t | hot=85 | (if (>= t hot) 1 0)
fix: weak-hot 10 0
fix: weak-hot 200 1
EOF
out="$(evolve)" || fail "drain run rc!=0 (a REJECT verdict is still a completed run): $out $(cat "$tmp/err")"
grep -q 'REJECT name=weak-hot' "$tmp/log" || fail "parked weak candidate not rejected via the door"
[ -f "$tmp/cands/weak.cand.rejected" ] || fail "rejected candidate not renamed .cand.rejected"
[ -s "$tmp/calls" ] && fail "drain run called the generator (drain must come first)"

# --- D. capacity: at MAX admitted rows, no new proposal (relay never called) ---------------
sand
for i in 1 2 3 4 5 6 7 8; do echo "# admitted: 2026-07-23T00:0${i}:00Z g$i" >> "$tmp/admitted"; done
out="$(evolve)" || fail "at-capacity run rc!=0: $out $(cat "$tmp/err")"
[ -s "$tmp/calls" ] && fail "at-capacity run still called the generator"
echo "$out" | grep -qi 'capacity' || fail "at-capacity run does not say so (silent skip): '$out'"

# --- E. generator down: honest n/a rc=2, no verdict forged --------------------------------
sand
MESH_ADMIT_RELAY="$tmp/no-such-relay" evolve_rc=0
MESH_ADMIT_LEDGER="$tmp/ledger" MESH_ADMIT_FIXTURES="$tmp/fixtures" \
MESH_ADMIT_ADOPTED="$tmp/admitted" MESH_ADMIT_LOG="$tmp/log" \
MESH_ADMIT_CAND_DIR="$tmp/cands" MESH_ADMIT_RELAY="$tmp/no-such-relay" \
RELAY_CALLS="$tmp/calls" MESH_GATE_GOALS="$tmp/goals" MESH_GATE_STATE="$tmp/state" \
./mesh-gate-evolve >/dev/null 2>&1; erc=$?
[ "$erc" -eq 2 ] || fail "generator-down run must rc=2 (honest n/a), got $erc"
grep -qE 'ADMIT|REJECT' "$tmp/log" && fail "generator-down run forged a verdict line"

[ "$rc" -eq 0 ] && echo "gate-evolve-test: ok"
exit "$rc"
