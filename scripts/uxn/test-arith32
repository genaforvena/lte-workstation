#!/usr/bin/env bash
# test-arith32 — truth table for the 32-bit double-word primitives, with the CARRY proven
# red from every direction it can be dropped.
#
# The carry between the low and the high word is the whole risk of this file. There is no
# carry flag on this machine, so each carry is an explicit unsigned-wrap comparison, and
# deleting one does not crash or even look wrong — it just makes the high word stop
# advancing, producing a smaller, entirely plausible number. That is the silent fallback
# the doctrine forbids by name, so it does not get a "we were careful" comment: section C
# rebuilds the ROM with each carry removed and requires the table to FAIL.
set -eu
here="$(cd "$(dirname "$0")" && pwd)"
cd "$here"
tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT
rc=0
fail(){ echo "  FAIL: $*"; rc=1; }
UXNCLI="${MESH_UXNCLI:-$here/bin/uxncli}"
ASM="$here/bin/uxnasm"
[ -x "$UXNCLI" ] || { echo "arith32-test: n/a — no uxncli (run ./build.sh)"; exit 2; }
[ -x "$ASM" ]    || { echo "arith32-test: n/a — no uxnasm (run ./build.sh)"; exit 2; }

run(){ local rom="$1"; shift; printf '%s\n' "$@" | "$UXNCLI" "$rom" 2>/dev/null; }

# op A B want   — every row is a boundary, not a spot check.
# 0=add 1=sub 2=cmp 3=mul16 4=mul32by16.  M32 = 4294967295 = 0xFFFFFFFF.
table(){ cat <<'ROWS'
0 1 1 00000002
0 65535 1 00010000
0 65535 0 0000FFFF
0 65536 65535 0001FFFF
0 4294967295 1 00000000
0 2147483648 2147483647 FFFFFFFF
1 65536 1 0000FFFF
1 65536 65536 00000000
1 0 1 FFFFFFFF
1 4294967295 4294967295 00000000
2 5 5 00000001
2 4 5 00000000
2 65536 65535 00000001
2 65535 65536 00000000
2 4294967295 4294967294 00000001
3 0 0 00000000
3 255 255 0000FE01
3 256 256 00010000
3 65535 65535 FFFE0001
3 65535 1 0000FFFF
3 40000 40000 5F5E1000
4 1000000 1000 3B9ACA00
4 65536 65536 00000000
4 4294967 1000 FFFFFED8
ROWS
}

check_table(){ # $1=rom → 0 all rows match, 1 any row differs
  local rom="$1" op a b want got
  while read -r op a b want; do
    [ -n "${op:-}" ] || continue
    got="$(run "$rom" "$op" "$a" "$b")"
    [ "$got" = "$want" ] || { echo "op=$op a=$a b=$b: want $want, got $got"; return 1; }
  done < <(table)
  return 0
}

# --- A. the committed ROM satisfies the table -------------------------------------------
[ -f arith32-test.rom ] || fail "no arith32-test.rom (run ./build.sh --rom)"
msg="$(check_table arith32-test.rom)" || fail "committed ROM vs truth table: $msg"

# --- B. the committed ROM is the committed SOURCE ----------------------------------------
"$ASM" arith32-test.tal "$tmp/rebuilt.rom" >/dev/null 2>&1 || fail "arith32-test.tal does not assemble"
cmp -s arith32-test.rom "$tmp/rebuilt.rom" || fail "arith32-test.rom has drifted from arith32-test.tal"

# --- C. RED on every carry ---------------------------------------------------------------
# Each mutation deletes ONE carry and leaves everything else intact. All four must break
# the table; a survivor means the boundary that carry governs is not actually covered.
# ── MUTANTS ARE BUILT IN A SCRATCH TREE, NEVER IN THE GENOME (2026-08-21) ───────────────
# This used to write the mutated source OVER the real arith32.tal, assemble, then copy a backup
# back. Between those two writes sits an assembler call and there is no restoring trap — so a
# run killed in that window (mesh-doctor times out every --test it sweeps, hourly) leaves the
# MUTANT in the genome while the EXIT trap deletes the only backup. It happened: 2026-08-21
# T01:47Z mesh-land landed `#0000` over w-add's carry as a "settled stream fix" (ae9611f) —
# a corrupted file with a quiet mtime is indistinguishable from an edited one. Caught 4h38m
# later by test-series-stats, and only because that harness re-asserts rom==source.
# A test may never write to the tree it is testing.
mutant_red(){ # $1=file $2=sed $3=label
  local src="$tmp/mutsrc"                    # a SCRATCH TREE — never the genome
  rm -rf "$src"; mkdir -p "$src"; cp ./*.tal "$src/" 2>/dev/null || true
  sed "$2" "$1" > "$src/$(basename "$1")" || { fail "$3: sed failed"; return; }
  if cmp -s "$1" "$src/$(basename "$1")"; then fail "$3: mutation was a no-op (pattern missed)"; return; fi
  local built=1
  ( cd "$src" && "$ASM" arith32-test.tal "$tmp/mut.rom" ) >/dev/null 2>&1 || built=0
  [ "$built" = 1 ] || { fail "$3: mutant does not assemble"; return; }
  if check_table "$tmp/mut.rom" >/dev/null 2>&1; then
    fail "$3: truth table STILL GREEN with this carry deleted — the boundary it governs is not covered"
  fi
}
mutant_red arith32.tal 's|#48 LDZ2 #42 LDZ2 LTH2 #00 SWP|#0000                        |' \
  "w-add: low->high carry deleted"
mutant_red arith32.tal 's|#42 LDZ2 #46 LDZ2 LTH2 #00 SWP #48 STZ2|#0000 #48 STZ2                          |' \
  "w-sub: low->high borrow deleted"
mutant_red arith32.tal 's|#54 LDZ2 #4a LDZ2 LTH2 #00 SWP #56 STZ2|#0000 #56 STZ2                          |' \
  "w-mul16: 17th bit of the middle term deleted"
mutant_red arith32.tal 's|#58 LDZ2 #48 LDZ2 LTH2 #00 SWP #40 LDZ2 ADD2 #40 STZ2|#40 LDZ2 #40 STZ2                                    |' \
  "w-mul16: low-word carry into the high word deleted"

# --- D. cross-check against 64-bit arithmetic over random inputs -------------------------
# The table is hand-picked and therefore blind to whatever nobody thought of. This is not.
mism=0; n=0
while read -r op a b want; do
  n=$((n+1))
  got="$(run arith32-test.rom "$op" "$a" "$b")"
  [ "$got" = "$want" ] || { mism=$((mism+1)); [ "$mism" -le 3 ] && echo "  op=$op a=$a b=$b: want $want got $got"; }
done < <(python3 -c '
import random
random.seed(20260724)
M=1<<32
for _ in range(120):
    op=random.choice([0,1,2,3,4])
    if op in (0,1,2):
        a=random.randrange(M); b=random.randrange(M)
        v={0:(a+b)%M, 1:(a-b)%M, 2:int(a>=b)}[op]
    elif op==3:
        a=random.randrange(1<<16); b=random.randrange(1<<16); v=a*b
    else:
        a=random.randrange(M); b=random.randrange(1<<16); v=(a*b)%M
    print(op,a,b,"%08X"%v)
')
[ "$mism" -eq 0 ] || fail "$mism/$n random cross-checks disagree with 64-bit arithmetic"
[ "$n" -ge 120 ]  || fail "only $n random cross-checks ran — the generator is not feeding the ROM"

[ "$rc" -eq 0 ] && echo "arith32-test: ok ($(table | grep -c .) boundary rows + rom==source + 4 carry-deletion mutants RED + $n random rows vs 64-bit)"
exit "$rc"
