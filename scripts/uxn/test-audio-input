#!/usr/bin/env bash
# test-audio-input — gate for audio-in-probe.tal: Varvara audio is OUTPUT-ONLY.
#
# The question this answers, once, so nobody has to guess it again: there is no audio
# INPUT device anywhere in Varvara. The device page map has 16 pages (00 system, 10
# console, 20 screen, 30/40/50/60 audio, 80 controller, 90 mouse, a0 file, c0 datetime,
# d0 reserved, and four blanks) and every one of the four audio pages is a playback
# voice. See docs/varvara-audio-input-2026-08-21.md for the full spec citation.
#
# TWO ARMS, and the suite is worthless without both:
#   ABSENT  — bin/uxncli, whose EMU_SRC deliberately omits the audio device. Every port
#             echoes the ROM's own write. rc=2 (honest n/a), never a fake pass.
#   PRESENT — a throwaway build linking the REAL reference device (src/devices/audio.c,
#             vendored at upstream 43453d7 alongside the rest of src/, and deliberately
#             NOT in EMU_SRC). rc=0, and the buffer the device played from is unchanged.
#
# The PRESENT arm exists because a branch nothing has been seen to take is not a branch:
# on bin/uxncli alone, audio-in-probe.tal's entire device-present path is dead code.
set -u
here="$(cd "$(dirname "$0")" && pwd)"
cd "$here"
[ -x bin/uxncli ] || ./build.sh >/dev/null
rc=0
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
./bin/uxnasm audio-in-probe.tal "$tmp/probe.rom" >/dev/null || { echo "FAIL: probe did not assemble"; exit 1; }

# 0) the vendored-but-unlinked invariant. If audio.c ever joins EMU_SRC, bin/uxncli stops
#    being the ABSENT arm and this suite silently tests one thing twice.
if grep -q 'devices/audio.c' emu-sources; then
	echo "FAIL: emu-sources now links audio.c — the ABSENT arm is gone, re-think this suite"
	rc=1
fi

# 1) ABSENT arm — no audio device on this build.
./bin/uxncli "$tmp/probe.rom" >"$tmp/a.out" 2>&1
r=$?
[ "$r" -eq 2 ] || { echo "FAIL: audio-less build must exit 2 (honest n/a), got rc=$r"; rc=1; }
grep -q 'device: ABSENT' "$tmp/a.out" || { echo "FAIL: audio-less build must identify the device as ABSENT"; rc=1; }
grep -q 'arm3 .*n/a on this build' "$tmp/a.out" || { echo "FAIL: arm3 must render n/a when the device is absent, never a pass"; rc=1; }
# every one of the 16 ports must echo the sentinel — that IS the absence proof
grep -q 'readback: a5 a5 a5 a5 a5 a5 a5 a5 a5 a5 a5 a5 a5 a5 a5 a5' "$tmp/a.out" || {
	echo "FAIL: audio-less readback must be pure echo of our own sentinel"; rc=1; }

# 2) PRESENT arm — link the real reference device and drive the other branch.
# shellcheck disable=SC1091
. ./emu-sources
CC="${CC:-cc}"
# shellcheck disable=SC2086
if $CC -std=c89 -O2 -DNDEBUG -Isrc -o "$tmp/uxncli-audio" audio-probe-emu.c \
	$(echo "$EMU_SRC" | sed 's|src/uxncli.c||') src/devices/audio.c 2>"$tmp/cc.err"; then
	"$tmp/uxncli-audio" "$tmp/probe.rom" >"$tmp/p.out" 2>&1
	r=$?
	[ "$r" -eq 0 ] || { echo "FAIL: audio-wired build must exit 0, got rc=$r"; rc=1; }
	grep -q 'device: PRESENT' "$tmp/p.out" || { echo "FAIL: audio-wired build must identify the device as PRESENT"; rc=1; }
	# the readable surface is exactly 3 of 16 bytes: position* (32,33) and output (34).
	# Everything else echoes. That enumeration is the whole finding — no capture port.
	grep -qE 'readback: a5 a5 [0-9a-f]{2} [0-9a-f]{2} [0-9a-f]{2} a5 a5 a5 a5 a5 a5 a5 a5 a5 a5 a5' "$tmp/p.out" || {
		echo "FAIL: exactly ports 32,33,34 may be computed; all others must echo"
		echo "      got: $(grep readback "$tmp/p.out")"; rc=1; }
	grep -q 'arm3: buffer UNCHANGED' "$tmp/p.out" || { echo "FAIL: playing a note must not write into uxn RAM"; rc=1; }
	grep -q 'RAM-UNCHANGED' "$tmp/p.out" || { echo "FAIL: harness ram checksum must be unchanged across the render"; rc=1; }
	# without this, arm3's UNCHANGED is a fact about silence, not about addr*
	grep -q 'output-buffer NONZERO' "$tmp/p.out" || { echo "FAIL: the device must actually have rendered — arm3 is vacuous otherwise"; rc=1; }
	grep -q 'VACUOUS' "$tmp/p.out" && { echo "FAIL: arm3 reported itself vacuous on the audio-wired build"; rc=1; }
else
	# Not a SKIP. Reaching this line means bin/uxncli exists, so a working host compiler
	# exists too — the audio-wired build failing is a real defect, and calling it "absent
	# toolchain" would end the PRESENT arm green and silent.
	echo "FAIL: the audio-wired arm did not build (cc exists — bin/uxncli was built with it)"
	echo "      $(grep -m1 -E 'error|Error|undefined' "$tmp/cc.err" || tail -1 "$tmp/cc.err")"
	rc=1
fi

# 3) the verdict must survive both arms — it is a statement about the SPEC, not the build.
for f in "$tmp/a.out" "$tmp/p.out"; do
	[ -f "$f" ] || continue
	grep -q 'verdict: NO AUDIO INPUT DEVICE IN VARVARA' "$f" || { echo "FAIL: missing verdict in $f"; rc=1; }
done

[ "$rc" -eq 0 ] && echo "test-audio-input: ok (absent arm rc=2, present arm rc=0, addr* proven read-only)"
exit "$rc"
