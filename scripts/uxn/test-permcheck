#!/usr/bin/env bash
# test-permcheck — truth table for the permutation-checker ROM, every assert seen RED
# before green.
#
# "Seen red" is not a story about what a human did once: section C REBUILDS the ROM from
# mutated source and requires the truth table to FAIL against each mutant. A table that
# cannot fail is not a table. The mutants are the bugs this checker can actually have, each
# a plausible wrong verdict rather than a crash:
#   · the order guard defeated      → an unsorted claim passes as OK
#   · the count check inverted       → a dropped element passes as OK (or a valid perm fails)
#   · the S (sum) moment killed       → {0,5} vs {3,4} (equal sum-of-squares) passes as OK
#   · the Q (sum-sq) moment killed     → {1,4} vs {2,3} (equal sum) passes as OK
# The last two are why BOTH moments exist: neither alone identifies a multiset.
#
# Section E is the artifact: it takes a REAL `sort -n` output and confirms OK, then DROPS,
# DUPLICATES and MUTATES a line and requires the checker to catch each — the sort bugs that
# would otherwise reach series-stats.rom already sorted and be reduced silently.
set -eu
here="$(cd "$(dirname "$0")" && pwd)"
cd "$here"
tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT
rc=0
fail(){ echo "  FAIL: $*"; rc=1; }
UXNCLI="${MESH_UXNCLI:-$here/bin/uxncli}"
ASM="$here/bin/uxnasm"
[ -x "$UXNCLI" ] || { echo "permcheck-test: n/a — no uxncli (run ./build.sh)"; exit 2; }
[ -x "$ASM" ]    || { echo "permcheck-test: n/a — no uxnasm (run ./build.sh)"; exit 2; }

# run <rom> <tokens…> → prints "<out> <rc>"
run(){ local rom="$1"; shift; local o urc; o="$(printf '%s\n' "$@" | "$UXNCLI" "$rom" 2>/dev/null)"; urc=$?; printf '%s %s' "$o" "$urc"; }

# The table. Each row: want-token want-rc | tokens…  (nA, nA orig values, nB, nB sorted values)
table(){ cat <<'ROWS'
OK 0 | 3 1 2 3 3 1 2 3
OK 0 | 3 3 1 2 3 1 2 3
OK 0 | 5 5 3 9 1 9 5 1 3 5 9 9
OK 0 | 0 0
OK 0 | 1 7 1 7
ORDER 1 | 3 1 2 3 3 1 3 2
ORDER 1 | 4 4 3 2 1 4 1 2 4 3
COUNT 1 | 3 1 2 3 2 1 2
COUNT 1 | 2 1 2 3 1 2 2
SUM 1 | 3 1 2 3 3 1 2 4
SUM 1 | 2 1 4 2 2 3
SUM 1 | 2 0 5 2 3 4
SUM 1 | 3 2 2 3 3 2 3 3
NA 2 | 1 10000 1 10000
NA 2 | 2 1 99999 2 1 2
ROWS
}

check_table(){ # $1=rom → 0 all rows match, 1 any row differs (prints the first)
  local rom="$1" lhs toks want wrc got
  while IFS='|' read -r lhs toks; do
    [ -n "${lhs// /}" ] || continue
    set -- $lhs
    want="$1"; wrc="$2"
    got="$(run "$rom" $toks)"
    [ "$got" = "$want $wrc" ] || { echo "row '$lhs|$toks': want '$want $wrc', got '$got'"; return 1; }
  done < <(table)
  return 0
}

# --- A. the committed ROM satisfies the table -------------------------------------------
[ -f permcheck.rom ] || fail "no permcheck.rom (run ./bin/uxnasm permcheck.tal permcheck.rom)"
msg="$(check_table permcheck.rom)" || fail "committed ROM vs truth table: $msg"

# --- B. the committed ROM is the committed SOURCE ----------------------------------------
"$ASM" permcheck.tal "$tmp/rebuilt.rom" >/dev/null 2>&1 || fail "permcheck.tal does not assemble"
cmp -s permcheck.rom "$tmp/rebuilt.rom" || fail "permcheck.rom is NOT what permcheck.tal assembles to — the committed binary has drifted from its source"

# --- C. RED on the SOURCE: each mutant must break the table ------------------------------
mutant_red(){ # $1=sed-mutation $2=label
  sed "$1" permcheck.tal > "$tmp/mut.tal" || { fail "$2: sed failed"; return; }
  if cmp -s permcheck.tal "$tmp/mut.tal"; then fail "$2: mutation was a no-op (pattern missed)"; return; fi
  "$ASM" "$tmp/mut.tal" "$tmp/mut.rom" >/dev/null 2>&1 || { fail "$2: mutant does not assemble"; return; }
  if check_table "$tmp/mut.rom" >/dev/null 2>&1; then
    fail "$2: truth table STILL GREEN against the mutant — the table does not discriminate this"
  fi
}
# val < prev becomes val < val — always false, so the order guard never fires: an unsorted
# claim (row 'ORDER') passes as OK. The check that catches a sorter that did not sort.
mutant_red 's/#24 LDZ2 #0e LDZ2 LTH2 #00 EQU ,\&noorder JCN/#24 LDZ2 #24 LDZ2 LTH2 #00 EQU ,\&noorder JCN/' "order guard defeated"
# nA!=nB test inverted: #00 EQU -> #01 EQU. A dropped element (row 'COUNT') stops failing
# on count; a valid permutation fails on count instead. Either way the table goes non-green.
mutant_red 's/#08 LDZ2 #0a LDZ2 EQU2 #00 EQU ,\&countbad JCN/#08 LDZ2 #0a LDZ2 EQU2 #01 EQU ,\&countbad JCN/' "count check inverted"
# kill the S (sum) moment on BOTH sides symmetrically: B = (0,0) instead of (0,val), so S
# never accumulates and SA==SB==0 always. {0,5} vs {3,4} have equal sum-of-squares, so Q
# does not catch them — row 'SUM | 2 0 5 2 3 4' now reads OK. Proves S is load-bearing.
mutant_red 's/#0000 #44 STZ2 #24 LDZ2 #46 STZ2/#0000 #44 STZ2 #0000 #46 STZ2/g'                 "S (sum) moment killed"
# kill the Q (sum-sq) moment on BOTH sides: square val*0 instead of val*val, so Q==0 always.
# {1,4} vs {2,3} have equal sum, so S does not catch them — row 'SUM | 2 1 4 2 2 3' now reads
# OK. Proves Q is load-bearing and NOT redundant with S.
mutant_red 's/#24 LDZ2 #4c STZ2 #24 LDZ2 #4e STZ2/#24 LDZ2 #4c STZ2 #0000 #4e STZ2/g'           "Q (sum-sq) moment killed"

# --- D. the domain pinned from BOTH sides ------------------------------------------------
# The parser ceiling is only real if the last legal token answers and the first illegal one
# refuses NA rather than wrapping to a small, believable value that then compares equal.
got="$(run permcheck.rom 1 9999 1 9999)"
[ "$got" = "OK 0" ] || fail "the largest legal token must be accepted: got '$got'"
got="$(run permcheck.rom 1 10000 1 10000)"
[ "$got" = "NA 2" ] || fail "one past the largest legal token must refuse, not wrap: got '$got'"

# --- E. the artifact: a REAL sort is OK, and a CORRUPTED sort is caught ------------------
# This is the whole reason the ROM exists: `sort -n` is the untrusted computation and these
# are its accident modes. Original values on the left, the sort's output on the right.
permcheck(){ # <orig-file> <sorted-file> → verdict token
  { wc -l < "$1"; cat "$1"; wc -l < "$2"; cat "$2"; } | "$UXNCLI" permcheck.rom 2>/dev/null
}
for seed in 1 2 3 4 5; do
  python3 -c "
import random
random.seed($seed)
n=random.randint(20,400)
for _ in range(n): print(random.randint(0,9999))
" > "$tmp/orig.$seed"
  sort -n "$tmp/orig.$seed" > "$tmp/sorted.$seed"
  v="$(permcheck "$tmp/orig.$seed" "$tmp/sorted.$seed" || true)"
  [ "$v" = OK ] || fail "seed $seed: a genuine sort -n output is not OK, got '$v'"
  # DROP a line from the sort
  sed '3d' "$tmp/sorted.$seed" > "$tmp/drop.$seed"
  v="$(permcheck "$tmp/orig.$seed" "$tmp/drop.$seed" || true)"
  [ "$v" = COUNT ] || fail "seed $seed: a DROPPED sorted line is not caught (got '$v')"
  # DUPLICATE a line (kept sorted by duplicating an adjacent equal-or-greater slot)
  awk 'NR==2{print; print} {print}' "$tmp/sorted.$seed" | sort -n > "$tmp/dup.$seed"
  v="$(permcheck "$tmp/orig.$seed" "$tmp/dup.$seed" || true)"
  [ "$v" = COUNT ] || fail "seed $seed: a DUPLICATED sorted line is not caught (got '$v')"
  # MUTATE one value but keep the length and re-sort (a scaling/misparse bug)
  awk 'NR==2{$1=($1+7)%10000} {print}' "$tmp/sorted.$seed" | sort -n > "$tmp/mut.$seed"
  v="$(permcheck "$tmp/orig.$seed" "$tmp/mut.$seed" || true)"
  case "$v" in SUM|OK)
    # OK only if the +7 collided back onto an existing value AND kept sums — vanishingly
    # unlikely, but if it happens the multiset genuinely IS unchanged, so OK is correct.
    [ "$v" = SUM ] || echo "  note seed $seed: mutated value re-collided to a true permutation (OK is correct)";;
  *) fail "seed $seed: a MUTATED sorted value is not caught (got '$v')";;
  esac
done

[ "$rc" -eq 0 ] && echo "permcheck-test: ok ($( table | grep -c . ) truth-table rows + rom==source + 4 source-mutants RED + domain pinned both sides + 5 real sorts OK with drop/dup/mutate each caught)"
exit "$rc"
