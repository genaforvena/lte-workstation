#!/usr/bin/env bash
# test-sense-gate — RED-first proof for the STRUCTURAL real-read gate.
#
# The claim: a sense's --test that asserts a STRUCTURAL read (count/fresh/variance)
# catches the hollow-sense failures a green --test sailed past — the mag/gyro driver
# race (0 axes, green 5 days), the frozen HAL cache (age infinite, green), the
# change-gated emitter that never fires (var 0, green 10 days). Each of those is one
# axis of sense-gate; the ROM owns the three-way AND; a 64-bit awk twin cross-checks
# every verdict on identical input so an ordering or comparison bug surfaces as DIVERGE.
set -u
here="$(cd "$(dirname "$0")" && pwd)"
cd "$here"
[ -x bin/uxncli ] || ./build.sh >/dev/null
[ -f sense-gate.rom ] || ./build.sh --rom >/dev/null
rc=0

ROM=./sense-gate.rom
UXNCLI=./bin/uxncli

# --- rom_verdict <min_n> <n> <max_age> <age> <min_var> <var> -> echoes verdict text, sets g_rc
rom_verdict(){
  local out r
  out="$("$UXNCLI" "$ROM" "$1" "$2" "$3" "$4" "$5" "$6" 2>/dev/null)"; r=$?
  g_rc=$r
  printf '%s' "$out" | tr -d '[:space:]'
}

# --- twin_verdict: a GENUINELY different implementation (64-bit awk, no shared code with the ROM).
#     An AGREE here is evidence about the comparisons AND the empty-spec/overflow domain logic,
#     not two readings of one mistake. Output is normalized to match the ROM's text exactly.
twin_verdict(){
  awk -v mn="$1" -v n="$2" -v ma="$3" -v age="$4" -v mv="$5" -v vr="$6" '
    BEGIN {
      if (mn+0 > 65535 || n+0 > 65535 || ma+0 > 65535 || age+0 > 65535 || mv+0 > 65535 || vr+0 > 65535) { print "NA"; exit }
      if (mn == 0 && ma == 0 && mv == 0) { print "NA"; exit }
      if (mn != 0 && n < mn) { print "REDcount"; exit }
      if (ma != 0 && age > ma) { print "REDage"; exit }
      if (mv != 0 && vr < mv) { print "REDvar"; exit }
      print "OK"
    }'
}

# the ROM prints "RED count" with a space; the twin prints "REDcount" (no space). Normalize BOTH
# to a spaceless token so the comparison is about the verdict, not the formatting.
norm(){ printf '%s' "$1" | tr -d '[:space:]'; }

# --- 1) ROM truth table: each verdict polarity on its boundary. -------------------------------
#   boundaries are INCLUSIVE the healthy way: n>=min_n passes, age<=max_age passes, var>=min_var passes.
[ "$(rom_verdict 3 3 60 10 5 10)"  = OK ]         || { echo "FAIL: healthy read should be OK"; rc=1; }
[ "$(rom_verdict 3 2 60 10 5 10)"  = "REDcount" ] || { echo "FAIL: n=2 < min_n=3 must be RED count"; rc=1; }
[ "$(rom_verdict 3 3 60 61 5 10)"  = "REDage" ]   || { echo "FAIL: age=61 > max_age=60 must be RED age"; rc=1; }
[ "$(rom_verdict 3 3 60 10 5 4)"   = "REDvar" ]   || { echo "FAIL: var=4 < min_var=5 must be RED var"; rc=1; }
# inclusive healthy boundaries (== the floor/ceiling passes)
[ "$(rom_verdict 3 3 60 60 5 5)"   = OK ]         || { echo "FAIL: age==max_age and var==min_var are INCLUSIVE — must be OK"; rc=1; }
# count==0 is legal data when min_n==0 (no count requirement)
[ "$(rom_verdict 0 0 60 10 5 10)"  = OK ]         || { echo "FAIL: min_n=0 means no count req — n=0 must still pass"; rc=1; }

# --- 2) the three hollow-sense canons, each caught by its axis --------------------------------
#   mag/gyro driver race: read returns 0 axes; a green --test sailed past for 5 days.
[ "$(rom_verdict 3 0 0 0 0 0)"     = "REDcount" ] || { echo "FAIL: mag driver-race canon (n=0, min_n=3) must be RED count"; rc=1; }
#   frozen HAL cache: value byte-identical forever, age unbounded.
[ "$(rom_verdict 0 0 60 9999 0 0)" = "REDage" ]   || { echo "FAIL: frozen-HAL canon (age=9999 > 60) must be RED age"; rc=1; }
#   change-gated emitter that never fires: var 0.
[ "$(rom_verdict 0 0 0 0 5 0)"     = "REDvar" ]   || { echo "FAIL: dead-emitter canon (var=0, min_var=5) must be RED var"; rc=1; }

# --- 3) RED-FIRST per axis: the FIRST-FAILED-AXIS ORDER (count before age before var) ----------
#   a read broken on count AND age names count first (the cheapest signal wins — an empty read
#   cannot have a meaningful age/var). Mutate to prove each branch is reachable and ordered.
[ "$(rom_verdict 3 0 60 9999 5 0)" = "REDcount" ] || { echo "FAIL: count is checked first — broken on all three names count"; rc=1; }
[ "$(rom_verdict 3 3 60 9999 5 0)" = "REDage" ]   || { echo "FAIL: with count OK, age is checked next"; rc=1; }
[ "$(rom_verdict 3 3 60 10 5 0)"   = "REDvar" ]   || { echo "FAIL: with count+age OK, var is checked last"; rc=1; }

# --- 4) the vacuous-gate contrast: the OLD bash --test that rotted. ---------------------------
#   It asserts "the read returned SOMETHING" (non-empty), which an empty driver-race read fails —
#   but a frozen 3-axis read (the real hollow mode) passes it green. sense-gate catches both.
old_bash_gate(){ [ -n "$1" ]; }                      # "did the read return non-empty text?"
#   frozen 3-axis read (HAL cache stuck): old gate GREEN (blind), sense-gate RED age
frozen_read="0.1 0.2 0.3"                            # 3 plausible axes, never changing
old_bash_gate "$frozen_read"; old=$?                 # 0 = green (BLIND to the freeze)
new="$(rom_verdict 3 3 60 9999 5 0)"                 # age 9999 > 60 + var 0 < 5
[ "$old" -eq 0 ] && [ "$new" = "REDage" ] \
  && echo "PASS: frozen 3-axis read -> old bash gate GREEN (blind), sense-gate RED age (caught)" \
  || { echo "FAIL: expected old green ($old) + sense-gate REDage ($new) on the frozen read"; rc=1; }
#   falsifiability control: the old gate really IS the blind kind
old_bash_gate "$frozen_read" || { echo "FAIL: old gate control should pass any non-empty text"; rc=1; }

# --- 5) the empty-spec refusal: a check that asserts NOTHING must not rubber-stamp. -------------
#   min_n=max_age=min_var=0 = "I was asked for no structural check" -> NA (never a silent OK).
#   rc captured BEFORE any pipe — a pipeline reports the last stage's rc, not uxncli's.
out="$("$UXNCLI" "$ROM" 0 0 0 0 0 0 2>/dev/null)"; r=$?
out="$(printf '%s' "$out" | tr -d '[:space:]')"
[ "$out" = NA ] && [ "$r" -eq 2 ] \
  || { echo "FAIL: empty spec must be NA rc2 (refuse to rubber-stamp), got '$out' rc$r"; rc=1; }
#   but a PARTIAL spec (one floor set) is a real check and verdicts normally
[ "$(rom_verdict 3 3 0 0 0 0)" = OK ] || { echo "FAIL: partial spec (count only) is valid — must verdict OK"; rc=1; }

# --- 6) DOMAIN HONESTY: a token > 65535 overflows the 16-bit parse -> NA rc2, never wrapped. ---
#   a 5-day-stale age (432000s) cannot be represented in 16 bits; it must refuse, not wrap young.
domain_na(){ # asserts NA + rc2 (rc captured BEFORE any pipe — a pipeline reports the last stage's rc)
  local out r
  out="$("$UXNCLI" "$ROM" "$1" "$2" "$3" "$4" "$5" "$6" 2>/dev/null)"; r=$?
  out="$(printf '%s' "$out" | tr -d '[:space:]')"
  [ "$out" = NA ] && [ "$r" -eq 2 ]
}
domain_na 3 3 60 432000 5 10 || { echo "FAIL: age 432000 (5 days) overflows 16-bit — must be NA rc2"; rc=1; }
domain_na 70000 0 0 0 0 0    || { echo "FAIL: min_n 70000 overflows parse — must be NA rc2"; rc=1; }
domain_na 3 3 60 10 5 70000  || { echo "FAIL: var 70000 overflows parse — must be NA rc2"; rc=1; }
#   in-domain boundary still verdicts (65535 is the max representable)
[ "$(rom_verdict 65535 65535 65535 65535 65535 65535)" = OK ] || { echo "FAIL: all-65535 is IN domain — must verdict OK"; rc=1; }

# --- 7) N-VERSION: the 64-bit twin vs the ROM over a fixture sweep (each axis exercised both ways,
#     plus boundaries, partial specs, and out-of-domain). Any disagreement is DIVERGE (loud).
diverged=0; checked=0
while read -r mn n ma age mv vr want; do
  [ -z "${mn:-}" ] && continue
  case "$mn" in \#*) continue;; esac
  rom="$(rom_verdict "$mn" "$n" "$ma" "$age" "$mv" "$vr")"
  twin="$(twin_verdict "$mn" "$n" "$ma" "$age" "$mv" "$vr")"
  rom_n="$(norm "$rom")"; twin_n="$(norm "$twin")"
  checked=$((checked+1))
  if [ "$rom_n" != "$twin_n" ]; then
    echo "DIVERGE on ($mn $n $ma $age $mv $vr): ROM=$rom  twin=$twin"
    diverged=$((diverged+1))
  fi
done <<'FIX'
# min_n n max_age age min_var var
3 3 60 10 5 10
3 0 0 0 0 0
0 0 60 9999 0 0
0 0 0 0 5 0
3 3 60 60 5 5
3 2 60 10 5 10
3 3 60 61 5 10
3 3 60 10 5 4
0 0 0 0 0 0
0 0 60 10 5 10
1 1 1 1 1 1
1 0 1 1 1 1
1 1 1 2 1 1
1 1 1 1 1 0
65535 65535 65535 65535 65535 65535
10 5 100 50 20 30
10 5 100 150 20 30
10 12 100 50 20 5
3 3 0 0 0 0
3 3 30 30 2 2
3 3 30 31 2 2
3 3 30 30 2 1
FIX
[ "$diverged" -eq 0 ] && echo "twin: AGREE on all $checked fixtures (ROM == 64-bit awk)" \
  || { echo "FAIL: $diverged DIVERGENCE(s) — ROM arithmetic disagrees the twin"; rc=1; }

[ "$rc" = 0 ] && echo "sense-gate-test: ok (truth-table + 3 hollow canons + axis-order + vacuous-contrast + empty-spec refusal + domain NA + $checked-fixture twin AGREE)" \
  || echo "sense-gate-test: FAIL"
exit $rc
