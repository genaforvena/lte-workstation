#!/usr/bin/env bash
# mesh-log-attest — make an append-only log's "append-only" VERIFIABLE, not merely conventional.
#
# The mesh's coordination memory (the board ~/.mesh/chat.log, the durable trace) is append-only by
# CONVENTION — nothing checks it. The doctrine's own recurring faults are logs that were rewritten,
# reordered, truncated, or forged: a --test that writes the real liveness log (guardian 09f7914), a
# window that silently drops its corpus, a test re-stamping a live artifact. This tool keeps a
# sidecar attestation over the PREFIX it has already seen and refuses to call a changed prefix "ok".
#
# The verdict is computed BY A PINNED ROM (fletcher16.rom), not by bash: the checksum FUNCTION is the
# byte-identical, hash-then-execute artifact — the same ROM on x86/ARM/phone yields the same digit, so
# an attestation written on one node verifies on any other. Re-implementing the sum in shell would
# throw away the whole point (a drifting second implementation is exactly what the ROM lane exists to
# kill). Fletcher-16 catches change, truncation AND reorder (a plain byte-sum is blind to reorder);
# threat model is ACCIDENT/rot, not an adversary — that wants FNV-32 (arith32.tal has w-mul32/w-add).
#
# usage:
#   mesh-log-attest <logfile>        attest: verify the prior prefix is intact, then advance the mark
#   mesh-log-attest --check <log>     verify only — never advance the mark (read-only audit)
#   mesh-log-attest --test            RED-first suite (test-log-attest)
# exit: 0 intact (mark advanced, or --check clean) · 1 TAMPER (prefix changed/reordered/truncated) ·
#       2 honest n/a (no ROM / no uxncli / missing log) — never a fake "ok" for an unreadable log
# state: <logfile>.attest — "lines=<N> fletcher=<hhhh> ts=<iso>"; the high-water prefix we have verified
# env:  MESH_LOG_ATTEST_ROM · MESH_LOG_ATTEST_CLI
set -u
here="$(cd "$(dirname "$0")" && pwd)"
ROM="${MESH_LOG_ATTEST_ROM:-$here/fletcher16.rom}"
CLI="${MESH_LOG_ATTEST_CLI:-$here/bin/uxncli}"

na(){ echo "mesh-log-attest: n/a — $*" >&2; exit 2; }
[ "${1:-}" = --test ] && exec "$here/test-log-attest"

# --alert <log>: the cadence-facing thin wrapper. Run the DEFAULT attest (so a clean append actually
# ADVANCES the mark — otherwise every run re-reports the same baseline forever and never sees a later
# real tamper), and post ONE board [alert] ONLY on TAMPER (rc=1). Stay SILENT on a clean run (rc=0 —
# the .attest file's mtime is the liveness signal, not a board line) and on honest n/a (rc=2, passed
# through). Poster is overridable (MESH_LOG_ATTEST_POST) so the --test suite asserts the real path
# without touching the live board. Delegates to this same tool's default mode — one verdict source.
if [ "${1:-}" = --alert ]; then
  shift
  POST="${MESH_LOG_ATTEST_POST:-mesh-chat}"
  alog="${1:-}"; [ -n "$alog" ] || na "usage: --alert <logfile>"
  out="$("$0" "$alog" 2>&1)"; arc=$?
  if [ "$arc" = 1 ]; then
    command -v "${POST%% *}" >/dev/null 2>&1 && "$POST" "[alert] mesh-log-attest: TAMPER on $alog — $out" >/dev/null 2>&1 || true
  fi
  exit "$arc"
fi

[ -f "$ROM" ] || na "no checksum ROM at $ROM (run ./build.sh --rom)"
[ -x "$CLI" ] || na "no uxncli at $CLI (run ./build.sh)"

CHECK_ONLY=0
if [ "${1:-}" = --check ]; then CHECK_ONLY=1; shift; fi
LOG="${1:-}"
[ -n "$LOG" ] || na "usage: mesh-log-attest [--check] <logfile>"
[ -f "$LOG" ] || na "no such log: $LOG"
STATE="$LOG.attest"

# fletch <n-lines> — the checksum of the log's first N lines, computed BY THE ROM. head -n preserves
# the file's exact bytes for those lines (including a missing final newline), so the hash is byte-exact.
fletch(){ head -n "$1" -- "$LOG" | "$CLI" "$ROM" 2>/dev/null | tr -d '\r\n'; }
# fletch_all — checksum of the whole current file (the new high-water mark)
fletch_all(){ "$CLI" "$ROM" < "$LOG" 2>/dev/null | tr -d '\r\n'; }

now="$(date -u +%FT%TZ)"
cur_lines="$(wc -l < "$LOG" | tr -d ' ')"

if [ ! -f "$STATE" ]; then
  # first sighting: nothing to verify against — record the mark, do not claim intact
  [ "$CHECK_ONLY" = 1 ] && { echo "mesh-log-attest: $LOG — no prior attestation (nothing to check yet)"; exit 0; }
  h="$(fletch_all)"; [ -n "$h" ] || na "ROM produced no checksum (empty read?)"
  printf 'lines=%s fletcher=%s ts=%s\n' "$cur_lines" "$h" "$now" > "$STATE"
  echo "mesh-log-attest: $LOG — first attestation (lines=$cur_lines fletcher=$h)"
  exit 0
fi

# parse the prior mark
prev_lines="$(sed -n 's/.*lines=\([0-9]*\).*/\1/p' "$STATE")"
prev_fl="$(sed -n 's/.*fletcher=\([0-9a-f]*\).*/\1/p' "$STATE")"
{ [ -n "$prev_lines" ] && [ -n "$prev_fl" ]; } || na "corrupt attestation state $STATE"

# TRUNCATION / PRUNE: the file shrank below the prefix we already attested. For an append-only log
# this is loss; for a deliberately-windowed log (records.log) the caller must not point us at it.
if [ "$cur_lines" -lt "$prev_lines" ]; then
  echo "mesh-log-attest: TAMPER — $LOG shrank $prev_lines -> $cur_lines lines (truncated/pruned below the attested high-water)" >&2
  exit 1
fi

# REWRITE / REORDER: recompute over the SAME prefix (prev_lines) and compare to the frozen checksum.
now_fl="$(fletch "$prev_lines")"
[ -n "$now_fl" ] || na "ROM produced no checksum over the prefix"
if [ "$now_fl" != "$prev_fl" ]; then
  echo "mesh-log-attest: TAMPER — $LOG first $prev_lines lines changed (rewrite/reorder): attested $prev_fl, now $now_fl" >&2
  exit 1
fi

# prefix intact. --check stops here; the default advances the high-water to the whole current file.
added=$(( cur_lines - prev_lines ))
if [ "$CHECK_ONLY" = 1 ]; then
  echo "mesh-log-attest: $LOG — prefix intact ($prev_lines lines verified, +$added since; mark NOT advanced)"
  exit 0
fi
h="$(fletch_all)"; [ -n "$h" ] || na "ROM produced no checksum for the new mark"
printf 'lines=%s fletcher=%s ts=%s\n' "$cur_lines" "$h" "$now" > "$STATE"
echo "mesh-log-attest: $LOG — intact, mark advanced $prev_lines -> $cur_lines lines (+$added)"
exit 0
