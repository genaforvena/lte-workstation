#!/usr/bin/env bash
# test-sysfs-serve — the regression gate for sysfs-serve.rom's ACCEPT/RE-ARM path.
#
# Runs entirely on the host with the host uxncli: no phone, no adb, no sensor. What it
# asserts is the ROM's own contract, which had no harness at all until 2026-08-19 and had
# been silently broken the whole time.
#
# THE BUG THIS EXISTS TO CATCH. sysfs-serve.tal's drain loop ended on
#     #da DEI #02 EQU ,&loop JCN
# and on an inbound lane the STATE port IS an accept: net_chan_state (net.c:494-504) calls
# net_accept_into -- which BLOCKS -- whenever net_fd[c] < 0, and net_read drops the channel
# itself the moment the caller EOFs (net.c:541-544). So every service cycle read the state
# once too often, ACCEPTED THE NEXT CALLER INTO THE PREVIOUS CALLER'S DRAIN LOOP, and
# discarded it unserved. The phone's log filled with "net: accepted: inbound connection"
# while the caller got nothing, which is why it was read for weeks as a flaky link.
#
# SEEN RED, measured, both ROMs against the same fixture on this host, single dial each,
# no retries: the old ROM answered 6 of 12, in a perfect every-other-dial pattern; the
# fixed ROM answered 12 of 12, and 60 of 60 on a longer run. On the Note3 itself the old
# ROM answered 1 of 10 (10 accepts in its log, one payload) and the fixed one 20 of 20.
#
# The second leg asserts the shape the CONSUMERS gate on: a listener whose cwd cannot reach
# the served path answers, promptly and forever, with the tag and ZERO bytes. Reachable is
# not producing, and this proves the ROM really can produce that state -- so a consumer
# gate that asserts reachability instead of payload is asserting nothing.
set -u
HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
UXNCLI="$HERE/bin/uxncli"
UXNASM="$HERE/bin/uxnasm"
fails=0
say(){ printf '%s\n' "$*"; }
bad(){ printf 'FAIL: %s\n' "$*"; fails=$((fails+1)); }

[ -x "$UXNCLI" ] && [ -x "$UXNASM" ] || { say "sysfs-serve-test: n/a — no host uxncli/uxnasm at $HERE/bin (build.sh)"; exit 2; }

TD="$(mktemp -d)"; stop_all(){ for q in ${PIDS:-}; do kill -9 "$q" 2>/dev/null; done; PIDS=""; wait 2>/dev/null; }
trap 'stop_all; rm -rf "$TD"' EXIT
PIDS=""

# --- leg 1: the committed ROM is what the committed source assembles to -------------
"$UXNASM" "$HERE/sysfs-serve.tal" "$TD/rebuilt.rom" >/dev/null 2>&1 \
  || bad "sysfs-serve.tal does not assemble"
if [ -f "$TD/rebuilt.rom" ]; then
    cmp -s "$TD/rebuilt.rom" "$HERE/sysfs-serve.rom" \
      || bad "sysfs-serve.rom is not what sysfs-serve.tal assembles to — the ROM is stale, so every measurement below is about a different program than the source says"
fi

# pick a port nothing is on. a busy port would make the listener die "Address already in
# use" while SOMETHING ELSE answered our dials — a false green of the worst kind.
# TWO ports, not one reused: a listener that has just been killed leaves the address in
# TIME_WAIT, and the ROM does not set SO_REUSEADDR, so the second leg would die "Address
# already in use" while the first leg's socket answered the dials. Caught exactly that here.
free_ports=""
for p in 47611 47613 47617 47619 47623 47629 47631 47639 47641 47643; do
    (exec 3<>"/dev/tcp/127.0.0.1/$p") 2>/dev/null && continue
    free_ports="$free_ports $p"
done
set -- $free_ports
[ $# -ge 2 ] || { say "sysfs-serve-test: n/a — fewer than two free loopback ports in the probe set"; exit 2; }
port="$1"; port2="$2"

dial(){ printf 'tcp:127.0.0.1:%s\nq\n' "$1" | UXN_NET_TIMEOUT=3 "$UXNCLI" "$HERE/net-echo.rom" 2>/dev/null; }

# `( cd X && CMD & echo $! )` does NOT give you CMD's pid -- `A && B & C` parses as
# `(A && B) & C`, so $! is the SUBSHELL's, and the listener outlives every kill aimed at it.
# This harness leaked one uxncli per leg that way until it had squatted its whole port probe
# set and started answering "n/a -- fewer than two free loopback ports": a test that disables
# itself by running. `exec` inside the backgrounded subshell makes the pid the real one.
start(){ # $1 = cwd, $2 = served path (as the ROM will see it), $3 = port
    printf 'tcp:127.0.0.1:%s\n%s\n' "$3" "$2" > "$TD/in.txt"
    ( cd "$1" && exec env UXN_NET_TIMEOUT=3 "$UXNCLI" "$HERE/sysfs-serve.rom" ) \
        < "$TD/in.txt" > "$TD/serve.log" 2>&1 &
    PIDS="$PIDS $!"
    sleep 1
    grep -q 'net: bound' "$TD/serve.log" \
      || { bad "the listener never bound on port $3 (log: $(tr '\n' '|' < "$TD/serve.log"))"; return 1; }
}

# --- leg 2: RE-ARM. every dial, not every other one --------------------------------
printf 'a,b,c\n' > "$TD/fixture"
if start "$TD" fixture "$port"; then
    ok=0; n=12
    for i in $(seq 1 $n); do
        case "$(dial "$port")" in "uxn:a,b,c"*) ok=$((ok+1)) ;; esac
    done
    [ "$ok" -eq "$n" ] || bad "re-arm: only $ok/$n single dials carried the payload — the accept path is eating callers again (the broken ROM scored 6/12 here, alternating)"
    say "sysfs-serve-test: re-arm $ok/$n single dials answered"
    stop_all; sleep 0.3
fi

# --- leg 3: REACHABLE IS NOT PRODUCING ---------------------------------------------
# same ROM, same port, an absolute path the file sandbox cannot admit from this cwd.
if start "$TD" /etc/hostname "$port2"; then
    r="$(dial "$port2")"
    [ "$r" = "uxn:" ] || bad "hollow leg: expected the tag and zero bytes from a sandbox-blocked path, got '$r' — if this ever starts returning data the consumers' zero-byte gate is testing a state that no longer exists"
    say "sysfs-serve-test: hollow leg reproduced — listener answered '${r}' (tag, no payload)"
    stop_all
fi

if [ "$fails" -eq 0 ]; then say "sysfs-serve-test: ok"; exit 0; fi
say "sysfs-serve-test: $fails failure(s)"; exit 1
