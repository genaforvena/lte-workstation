( audio-in-probe.tal — is there ANY path by which external audio enters uxn memory? )
(                                                                                   )
( Varvara device page map has 16 pages and none of them is an audio INPUT:           )
(   00 system   80 controller                                                        )
(   10 console  90 mouse                                                             )
(   20 screen   a0 file                                                              )
(   30 audio0   b0 --        <- 30/40/50/60 are FOUR OUTPUT voices, not in+out       )
(   40 audio1   c0 datetime                                                          )
(   50 audio2   d0 reserved                                                          )
(   60 audio3   e0 --                                                                )
(   70 --       f0 --                                                                )
(                                                                                    )
( Audio device ports 30..3f: vector* 30 | position* 32 | output 34 | -- 35 36 37      )
(   | adsr* 38 | length* 3a | addr* 3c | volume 3e | pitch 3f                         )
( Only THREE are readable and all three describe the note WE started: the playhead    )
( into OUR OWN buffer, and the envelope loudness of OUR OWN note. addr* is read BY    )
( the device, never written by it.                                                    )
(                                                                                    )
( This ROM measures three arms and NAMES which build it measured, because an          )
( audio-less emulator answers arm 3 vacuously.                                        )

|0100

@on-reset ( -> )
	;t-head ;print JSR2

	( ------ arm 1: write a sentinel to every audio port, read all 16 back ------ )
	#30
	&fill
		#a5 OVR DEO
		INC DUP #40 NEQ ,&fill JCN
	POP
	;t-row ;print JSR2
	#30
	&read
		DUP DEI ;emit-hex JSR2
		#20 #18 DEO
		INC DUP #40 NEQ ,&read JCN
	POP
	#0a #18 DEO

	( ------ arm 2: IDENTIFY the device, never trust the build list ------ )
	( 34 is Audio/output, the envelope VU. A real device computes it, so it cannot )
	( return our sentinel. An absent device falls through to uxn.dev[] = pure echo. )
	#34 DEI #a5 EQU ,&absent JCN

	( ---- device PRESENT: arm 3 is live ---- )
	;t-present ;print JSR2
	;play JSR2
	( arm 3 is only worth anything if the device ACTUALLY accepted our buffer:   )
	( an "unchanged buffer" under a device that refused the note is a fact about )
	( silence, not about addr*. Audio/output is the envelope VU and is nonzero    )
	( exactly while a note of ours is live.                                       )
	( NOT position*: a looping sample legitimately wraps the playhead to 0 --     )
	( measured, len 0x10 lands on i%16==0 after 1024 frames, so that predicate     )
	( calls a perfectly live note dead.                                           )
	#34 DEI ,&moved JCN
	;t-vacuous ;print JSR2
	;t-verdict ;print JSR2
	#02 #0f DEO
	BRK
	&moved
	;sum-buf JSR2
	#00 EQU ,&clean JCN
	;t-dirty ;print JSR2
	#01 #0f DEO
	BRK
	&clean
	;t-clean ;print JSR2
	;t-verdict ;print JSR2
	#80 #0f DEO
	BRK

	( ---- device ABSENT: say so, and render arm 3 n/a. Never a fake pass. ---- )
	&absent
	;t-absent ;print JSR2
	;t-verdict ;print JSR2
	#02 #0f DEO
	BRK

( trigger a note reading from ;buf, then spin so a render thread can run )
@play ( -- )
	#0000 #38 DEO2      ( adsr 0000 = no envelope )
	#88 #3e DEO         ( volume, both ears )
	;buf #3c DEO2       ( addr* -> our buffer )
	#0010 #3a DEO2      ( length* = 16 bytes )
	#30 #3f DEO         ( pitch -> start )
	#00
	&outer
		#0000
		&inner INC2 DUP2 #ffff NEQ2 ,&inner JCN
		POP2
		INC DUP #40 NEQ ,&outer JCN
	POP
	JMP2r

( sum the 16 buffer bytes; buf is assembled as zeroes, so a nonzero sum means )
( something outside the ROM wrote into uxn RAM through the audio device.      )
@sum-buf ( -- b )
	#00 STH
	;buf
	&loop
		LDAk STH ADDr
		INC2
		DUP2 ;buf-end NEQ2 ,&loop JCN
	POP2
	STHr
	JMP2r

@emit-hex ( b -- )
	DUP #04 SFT ;emit-nib JSR2
	#0f AND ;emit-nib JSR2
	JMP2r

@emit-nib ( n -- )
	DUP #0a LTH ,&dig JCN
	#57 ADD ,&out JMP
	&dig #30 ADD
	&out #18 DEO
	JMP2r

@print ( str* -- )
	&while
		LDAk #18 DEO
		INC2 LDAk ,&while JCN
	POP2
	JMP2r

@t-head "audio-in-probe: 20 "varvara 20 "audio 20 "page 20 "30 0a 00
@t-row  "ports 20 "30..3f 20 "readback: 20 00
@t-present "device: 20 "PRESENT 20 "(34 20 "is 20 "computed, 20 "not 20 "echo) 0a 00
@t-absent  "device: 20 "ABSENT 20 "-- 20 "every 20 "port 20 "echoed 20 "our 20 "own 20 "write 0a
           "arm3 20 "(does 20 "the 20 "device 20 "write 20 "uxn 20 "RAM?): 20 "n/a 20 "on 20 "this 20 "build 0a 00
@t-vacuous "arm3: 20 "VACUOUS 20 "-- 20 "no 20 "live 20 "note, 20 "device 20 "refused 20 "our 20 "buffer 0a 00
@t-clean "arm3: 20 "buffer 20 "UNCHANGED 20 "after 20 "a 20 "note 20 "-- 20 "addr* 20 "is 20 "read-only 0a 00
@t-dirty "arm3: 20 "buffer 20 "CHANGED 20 "-- 20 "investigate, 20 "this 20 "contradicts 20 "the 20 "spec 0a 00
@t-verdict "verdict: 20 "NO 20 "AUDIO 20 "INPUT 20 "DEVICE 20 "IN 20 "VARVARA 0a 00

@buf $10
@buf-end
