#!/usr/bin/env bash
# test-lease-gate — RED-first proof for the Uxn lease gate (uxn-pilot-gate).
#
# The claim: a REAL gate (arithmetic in the ROM) catches a broken lease that the
# canonical VACUOUS self-grep gate (asserts a string is present in the source) sails
# green past. We break the guarded fix and watch the two gates disagree.
set -u
here="$(cd "$(dirname "$0")" && pwd)"
cd "$here"
[ -x bin/uxncli ] || ./build.sh >/dev/null
rc=0

# --- the OLD gate (the doctrine's canonical vacuity): grep the source for the margin string.
#     It can only answer "the words are present", never "the number is right".
old_selfgrep_gate() { grep -q '2\*cadence' mesh-lease-gate && return 0 || return 1; }

# --- the NEW gate: run the ROM on the actual (cadence, lease) pair.
rom_gate() { ./mesh-lease-gate --pair "$1" "$2" >/dev/null 2>&1; }

# 1) ROM truth table (boundary is INCLUSIVE: lease>=2*cad passes).
rom_gate 900 1800 || { echo "FAIL: healthy 2x lease should pass"; rc=1; }
rom_gate 900 1801 || { echo "FAIL: lease just over 2x should pass"; rc=1; }
rom_gate 900 1799 && { echo "FAIL: lease just under 2x must go RED"; rc=1; }
rom_gate 900 900  && { echo "FAIL: lease==cadence (the real bug) must go RED"; rc=1; }
rom_gate 1800 3600 || { echo "FAIL: hourly-class 2x lease should pass"; rc=1; }

# 2) RED-FIRST: break the guarded fix (a reflex whose lease == its cadence) and prove
#    the ROM gate flips RED on the exact input where the self-grep gate stays GREEN.
#    HEALTHY baseline:
if old_selfgrep_gate && rom_gate 900 1800; then :; else
  echo "FAIL: healthy config — both gates should be green"; rc=1; fi

#    BROKEN (lease dropped to 1x cadence — the memory 'a-lease-must-exceed-cadence' regression):
old_selfgrep_gate; old=$?          # 0 = still green (BLIND to the bug)
rom_gate 900 900;  new=$?          # 1 = RED (CAUGHT the bug)
if [ "$old" -eq 0 ] && [ "$new" -eq 1 ]; then
  echo "PASS: broken lease -> self-grep gate GREEN (blind), ROM gate RED (caught)"
else
  echo "FAIL: expected self-grep green ($old) + ROM red ($new) on the broken lease"; rc=1
fi

# 3) FALSIFIABLE control: assert the self-grep really IS the blind kind (it matches its own
#    intent string regardless of the number), so the contrast above isn't rigged.
old_selfgrep_gate || { echo "FAIL: self-grep control should always match its own literal"; rc=1; }

# 4) DOMAIN HONESTY (2026-07-23, found by mesh-rom-calibrate): the ROM's ints are 16-bit.
#    Out-of-domain input must answer NA + halt #82 (rc 2) — never a wrapped verdict in
#    either direction (67335 used to wrap to 1799 → false RED; 33000/60000 used to wrap
#    the threshold to 464 → false GREEN). In-domain boundary pairs must still verdict.
na_gate() { # cad lease -> asserts NA + rc2 (rc captured BEFORE any pipe — a pipeline reports the last stage's rc)
  local v r
  v="$(./bin/uxncli lease-gate.rom "$1" "$2" 2>/dev/null)"; r=$?
  v="$(printf '%s' "$v" | tr -d '[:space:]')"
  [ "$r" -eq 2 ] && [ "$v" = NA ]
}
na_gate 900 67335   || { echo "FAIL: lease 67335 overflows 16-bit parse — must be NA rc2"; rc=1; }
na_gate 33000 60000 || { echo "FAIL: cad 33000 overflows 2*cad — must be NA rc2 (was false-GREEN)"; rc=1; }
na_gate 86400 172800 || { echo "FAIL: daily pair overflows parse — must be NA rc2"; rc=1; }
rom_gate 32767 65535 || { echo "FAIL: cad 32767 lease 65535 is IN domain (2*32767=65534) — must verdict OK"; rc=1; }
rom_gate 32767 65533 && { echo "FAIL: 65533 < 65534 in-domain — must verdict RED"; rc=1; }

[ "$rc" = 0 ] && echo "lease-gate-test: ok" || echo "lease-gate-test: FAIL"
exit $rc
