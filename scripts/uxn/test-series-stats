#!/usr/bin/env bash
# test-series-stats — truth table for the order-statistics ROM, every assert seen RED
# before green.
#
# "Seen red" is not a claim about what a human did once: section C REBUILDS the ROM from
# mutated source and requires the same truth table to FAIL against each mutant. A table
# that cannot fail is not a table. The mutants are the bugs this ROM can actually have,
# and each one is a plausible-looking wrong answer rather than a crash:
#   · the sortedness guard defeated   → a median computed from unsorted input
#   · the per-token ceiling loosened  → a wrapped value that still prints as a number
#   · rounding → truncation           → off by one in the last place, systematically
#   · the lower median index shifted  → the wrong element for even n only
#   · count >= T weakened to > T      → one short at exactly the boundary
# Section G deletes a double-word carry and requires the SUM to change: the sum is the one
# quantity here that leaves 16 bits, and a lost carry there reads as a smaller, entirely
# believable mean.
set -eu
here="$(cd "$(dirname "$0")" && pwd)"
cd "$here"
tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT
rc=0
fail(){ echo "  FAIL: $*"; rc=1; }
UXNCLI="${MESH_UXNCLI:-$here/bin/uxncli}"
ASM="$here/bin/uxnasm"
[ -x "$UXNCLI" ] || { echo "series-stats-test: n/a — no uxncli (run ./build.sh)"; exit 2; }
[ -x "$ASM" ]    || { echo "series-stats-test: n/a — no uxnasm (run ./build.sh)"; exit 2; }

# run <rom> <tokens…> → prints "<out> <rc>"
run(){ local rom="$1"; shift; local o urc; o="$(printf '%s\n' "$@" | "$UXNCLI" "$rom" 2>/dev/null)"; urc=$?; printf '%s %s' "$o" "$urc"; }

# The table. Each row: want-output want-rc | tokens…  (first token is T, second is n)
# Output is "min max med2 cnt sum mean1000" — med2 is TWICE the median so the even-n case
# is exact rather than rounded, and mean1000 is rounded to the nearest thousandth.
table(){ cat <<'ROWS'
1 5 6 5 15 3000 0 | 0 5 1 2 3 4 5
1 6 7 6 21 3500 0 | 0 6 1 2 3 4 5 6
1 6 7 3 21 3500 0 | 4 6 1 2 3 4 5 6
7 7 14 1 7 7000 0 | 0 1 7
5 5 10 3 15 5000 0 | 0 3 5 5 5
1 2 2 3 4 1333 0 | 0 3 1 1 2
1 2 4 3 5 1667 0 | 0 3 1 2 2
1 9 2 4 12 3000 0 | 0 4 1 1 1 9
1 9 10 4 20 5000 0 | 0 4 1 1 9 9
1 3 4 1 6 2000 0 | 3 3 1 2 3
1 3 4 0 6 2000 0 | 4 3 1 2 3
0 1 0 16 1 63 0 | 0 16 ZERO15 1
9999 9999 19998 2343 23427657 9999000 0 | 0 2343 MAX2343
NA 2 | 0 3 1 3 2
NA 2 | 0 1 10000
NA 2 | 0 0
NA 2 | 0 2344 MAX2344
ROWS
}

expand(){
  case "$1" in
    ZERO15)   for _ in $(seq 15);   do printf '0 '; done ;;
    MAX2343)  for _ in $(seq 2343); do printf '9999 '; done ;;
    MAX2344)  for _ in $(seq 2344); do printf '9999 '; done ;;
    *) printf '%s ' "$1" ;;
  esac
}

check_table(){ # $1=rom → 0 all rows match, 1 any row differs (prints the first)
  local rom="$1" lhs toks want wrc got t args
  while IFS='|' read -r lhs toks; do
    [ -n "${lhs// /}" ] || continue
    # the row's want is everything but the trailing rc
    set -- $lhs
    wrc="${!#}"; want="${lhs% $wrc }"; want="${want%% }"
    args=""
    for t in $toks; do args="$args $(expand "$t")"; done
    got="$(run "$rom" $args)"
    [ "$got" = "$want $wrc" ] || { echo "row '$lhs|$toks': want '$want $wrc', got '$got'"; return 1; }
  done < <(table)
  return 0
}

# --- A. the committed ROM satisfies the table -------------------------------------------
[ -f series-stats.rom ] || fail "no series-stats.rom (run ./bin/uxnasm series-stats.tal series-stats.rom)"
msg="$(check_table series-stats.rom)" || fail "committed ROM vs truth table: $msg"

# --- B. the committed ROM is the committed SOURCE ----------------------------------------
# A .rom checked in beside a .tal can drift from it silently — the binary is what runs.
"$ASM" series-stats.tal "$tmp/rebuilt.rom" >/dev/null 2>&1 || fail "series-stats.tal does not assemble"
cmp -s series-stats.rom "$tmp/rebuilt.rom" || fail "series-stats.rom is NOT what series-stats.tal assembles to — the committed binary has drifted from its source"

# --- C. RED on the SOURCE: each mutant must break the table ------------------------------
mutant_red(){ # $1=sed-mutation $2=label
  sed "$1" series-stats.tal > "$tmp/mut.tal" || { fail "$2: sed failed"; return; }
  if cmp -s series-stats.tal "$tmp/mut.tal"; then fail "$2: mutation was a no-op (pattern missed)"; return; fi
  "$ASM" "$tmp/mut.tal" "$tmp/mut.rom" >/dev/null 2>&1 || { fail "$2: mutant does not assemble"; return; }
  if check_table "$tmp/mut.rom" >/dev/null 2>&1; then
    fail "$2: truth table STILL GREEN against the mutant — the table does not discriminate this"
  fi
}
# v < prev becomes v < v — always false, so the guard never fires and unsorted input is
# accepted. The median it then answers is a real-looking number for a different question.
mutant_red 's/#2a LDZ2 #10 LDZ2 LTH2 #00 EQU ,\&ord JCN/#2a LDZ2 #2a LDZ2 LTH2 #00 EQU ,\&ord JCN/' "sortedness guard defeated"
# the per-token ceiling: 999 → 9999 before the multiply lets a 5-digit token through and wrap
mutant_red 's/#03e7 GTH2/#270f GTH2/'                                     "per-token ceiling loosened (a wrapped value prints as a number)"
# round-to-nearest → truncate: exactly 1 in the last place, systematically low
mutant_red 's/#20 LDZ2 #0005 LTH2 ,\&noround JCN/#20 LDZ2 #0000 LTH2 ,\&noround JCN/' "round-to-nearest → truncate"
# loi = (n-1)/2 → n/2: identical for odd n, wrong element for even n only
mutant_red 's|#04 LDZ2 #0001 SUB2 #0002 DIV2 #16 STZ2|#04 LDZ2 #0002 DIV2 #16 STZ2          |' "lower median index (n-1)/2 → n/2"
# cnt counts v >= T; shifting the comparison by one counts v > T instead
mutant_red 's/#2a LDZ2 #02 LDZ2 LTH2 ,\&nocnt JCN/#2a LDZ2 #02 LDZ2 INC2 LTH2 ,\&nocnt JCN/' "count >= T weakened to > T"

# --- D. the domain pinned from BOTH sides ------------------------------------------------
# The ceiling is only a real ceiling if the last legal input answers and the first illegal
# one refuses. n=2343 of the largest legal token is the worst case the accumulator sees.
got="$(run series-stats.rom 0 2343 $(expand MAX2343))"
[ "$got" = "9999 9999 19998 2343 23427657 9999000 0" ] || fail "n=2343 at the per-token ceiling: want the exact max reduction, got '$got'"
got="$(run series-stats.rom 0 2344 $(expand MAX2344))"
[ "$got" = "NA 2" ] || fail "n=2344 must refuse, not wrap: want 'NA 2', got '$got'"
got="$(run series-stats.rom 0 1 9999)"
[ "$got" = "9999 9999 19998 1 9999 9999000 0" ] || fail "the largest legal token must be accepted: got '$got'"
got="$(run series-stats.rom 0 1 10000)"
[ "$got" = "NA 2" ] || fail "one past the largest legal token must refuse: got '$got'"

# --- E. ROM vs the independent 64-bit twin over random series ----------------------------
# The twin sorts with its own selection sort over the UNSORTED input and accumulates in
# awk floats, so an AGREE is evidence about the arithmetic AND the ordering.
[ -x ./mesh-series-stats ] || fail "no mesh-series-stats (the host half owns sorting + the twin)"
agree=0; diverge=0
for seed in 1 2 3 4 5 6 7 8; do
  python3 -c "
import random
random.seed($seed)
n=random.randint(5,2343)
for _ in range(n): print(random.randint(0,9999))
" > "$tmp/v.$seed"
  sort -n "$tmp/v.$seed" > "$tmp/s.$seed"
  r="$(./mesh-series-stats --values "$tmp/s.$seed" --scale 1 --threshold 5000 2>/dev/null || echo NA)"
  t="$(./mesh-series-stats --twin "$tmp/v.$seed" 1 5000 2>/dev/null || echo NA)"
  if [ -n "$t" ] && [ "$r" = "$t" ]; then agree=$((agree+1)); else diverge=$((diverge+1)); echo "  seed $seed: rom=$r twin=$t"; fi
done
[ "$diverge" -eq 0 ] || fail "ROM and 64-bit twin DIVERGE on $diverge/8 random series"
[ "$agree" -ge 8 ]   || fail "only $agree/8 random series were actually compared — the twin path is not running"

# --- F. the host passes the domain refusal through, and does NOT window silently ---------
# Windowing an over-long series would answer a different question with the same confidence
# — the exact failure spearman.rom had while its ceiling was 58.
python3 -c "
import random
random.seed(99)
for _ in range(2400): print(random.randint(0,9999))
" | sort -n > "$tmp/toobig"
out="$(./mesh-series-stats --values "$tmp/toobig" 2>&1)" && fail "mesh-series-stats swallowed the domain refusal for n=2400 > 2343"
case "$out" in *"NOT silently windowed"*) : ;; *) fail "n=2400 refusal does not say it declined to window: '$out'" ;; esac

# --- G. the double-word carry, driven through the real reduction -------------------------
# The sum is the only quantity here that leaves 16 bits (255 x 9999 = 2,549,745), so
# deleting w-add's carry does not crash — it answers a smaller sum and a smaller, entirely
# believable mean. test-arith32 remains the authority for carry coverage; this pins the
# end-to-end cost.
#
# n=255 IS LOAD-BEARING, not a round number. w-mul16 is reached here only through n*place
# in calc-mean, and its low-word carry fires only for particular n: at n=100 the partials
# do not overflow, the mutant answers identically, and the section reads green against a
# real bug. n=255 x 1000 is a case where they do (t0=59160 plus (mid&0xff)<<8=64768 wraps),
# so the deleted carry costs 65536 in P and the quotient loop takes a different path.
# A carry test is only a test on inputs that CAN carry.
{ echo 0; echo 255; for _ in $(seq 255); do echo 9999; done; } > "$tmp/carryin"
# ── MUTANTS ARE BUILT IN A SCRATCH TREE, NEVER IN THE GENOME (2026-08-21) ───────────────
# This section used to write the mutated source OVER the real arith32.tal, assemble, and copy a
# backup back. Between those two writes there is an assembler call, and there is no trap
# restoring the file — so a run killed in that window (mesh-doctor times out every --test it
# sweeps, hourly) leaves the MUTANT in the genome, while the EXIT trap deletes the only
# backup. It happened: 2026-08-21T01:47Z mesh-land landed `#0000` over w-add's carry
# computation as a "settled stream fix" (ae9611f), because a corrupted file with a quiet
# mtime is indistinguishable from an edited one. The carry-less adder sat committed for
# 4h38m; nothing shipped from it only because no ROM was rebuilt in that window.
# A test may never write to the tree it is testing. The scratch tree is a full copy of the
# .tal set (the include `~arith32.tal` resolves from the assembler's CWD), so the mutant is
# assembled in isolation and an interrupted run can corrupt nothing.
carry_red(){ # $1=sed on arith32.tal $2=label
  local src="$tmp/mutsrc"                    # a SCRATCH TREE — never the genome
  rm -rf "$src"; mkdir -p "$src"; cp ./*.tal "$src/" 2>/dev/null || true
  sed "$1" arith32.tal > "$src/arith32.tal" || { fail "$2: sed failed"; return; }
  if cmp -s arith32.tal "$src/arith32.tal"; then fail "$2: mutation was a no-op (pattern missed)"; return; fi
  local built=1
  ( cd "$src" && "$ASM" series-stats.tal "$tmp/carry.rom" ) >/dev/null 2>&1 || built=0
  [ "$built" = 1 ] || { fail "$2: mutant does not assemble"; return; }
  local base mut
  # || true: a mutant that answers NA halts rc=2, and under set -e that would end the run
  # here instead of being scored as the DIFFERENT answer it is.
  base="$("$UXNCLI" series-stats.rom  < "$tmp/carryin" 2>/dev/null || true)"
  mut="$( "$UXNCLI" "$tmp/carry.rom"  < "$tmp/carryin" 2>/dev/null || true)"
  [ "$base" != "$mut" ] || fail "$2: the reduction still answers '$base' with this carry deleted"
}
carry_red 's|#48 LDZ2 #42 LDZ2 LTH2 #00 SWP|#0000                        |' "w-add low->high carry deleted"
carry_red 's|#42 LDZ2 #46 LDZ2 LTH2 #00 SWP #48 STZ2|#0000 #48 STZ2                          |' "w-sub low->high borrow deleted"
carry_red 's|#58 LDZ2 #48 LDZ2 LTH2 #00 SWP #40 LDZ2 ADD2 #40 STZ2|#40 LDZ2 #40 STZ2                                    |' "w-mul16 low-word carry deleted"

# ── H. THE CLAIM GATE — the host's --claims verdict, driven RED and GREEN ────────────
# Sections A-G prove the ROM's ARITHMETIC. They say nothing about whether a standing doctrine
# claim still holds, and for a month nothing did: `--claims` printed the doctrine number inside
# an echo string and then the ROM-vs-twin verdict, so claim 2 ("act never exceeds .544, so
# act>0.55 can never fire") rendered [AGREE] on a live corpus with cnt(act>=0.55)=133. `DRIFT`
# was named in the tool's header and in the sound dash's legend and implemented nowhere. A gate
# you have not seen FAIL is not a gate — so this section builds a corpus on which every claim is
# TRUE by construction, requires GREEN, then mutates exactly one value and requires the gate to
# go RED naming that claim. The green arm matters as much as the red one: a predicate that
# always fires is no better than one that never does.
HOST="$here/../mesh-series-stats"
if [ ! -x "$HOST" ]; then
  fail "claim-gate: no host at $HOST — --claims is untestable (the tool was deployed-only until 2026-08-24)"
else
  # Build the HOLDS corpus: act symmetric about .319 with max exactly .544 (never >= .55),
  # dyn about .265, move about .141, and the high-score half beat-POOR — the doctrine as written.
  awk 'BEGIN{ n=40
    for (i=0;i<n;i++){ t=(i-(n-1)/2)/((n-1)/2)
      if (i<n/2){ sc=60.0; b=4 } else { sc=50.0; b=12 }
      printf "2026-08-24T20:00Z ear f%06x dur=18.00 win=18.00 cov=1.000 score=%.1f beats=%d [even] dyn=%.3f act=%.3f rich=0.700 move=%.3f cent=1500.0 -> pending\n",
        i, sc, b, 0.265+0.2*t, 0.319+0.225*t, 0.141+0.1*t }
  }' > "$tmp/claims-holds.log"

  cg(){ MESH_REPO="$here/.." MESH_UXN_DIR="$here" MESH_SERIES_ROM="$here/series-stats.rom" \
        MESH_UXNCLI="$UXNCLI" MESH_RECORDS_LOG="$1" "$HOST" --claims 2>&1; }

  out="$(cg "$tmp/claims-holds.log")" && grc=0 || grc=$?
  [ "$grc" -eq 0 ] || fail "claim-gate GREEN arm: rc=$grc on a corpus where every claim is true by construction"
  printf '%s\n' "$out" | grep -qE '=> (REFUTED|DRIFT)' \
    && fail "claim-gate GREEN arm: a claim read REFUTED/DRIFT on the HOLDS corpus"
  [ "$(printf '%s\n' "$out" | grep -c '=> HOLDS')" -eq 5 ] \
    || fail "claim-gate GREEN arm: expected 5 HOLDS verdicts, got $(printf '%s\n' "$out" | grep -c '=> HOLDS')"

  # RED arm — ONE act value lifted past the bound. The mutation is asserted to have LANDED
  # before its red is read as evidence: a sed that missed would leave the green corpus in place
  # and the gate's pass would be scored as a catch.
  sed '1s/act=0.094/act=0.900/' "$tmp/claims-holds.log" > "$tmp/claims-refuted.log"
  if cmp -s "$tmp/claims-holds.log" "$tmp/claims-refuted.log"; then
    fail "claim-gate RED arm: mutation was a no-op (pattern missed) — its red would prove nothing"
  else
    out="$(cg "$tmp/claims-refuted.log")" && rrc=0 || rrc=$?
    [ "$rrc" -eq 1 ] || fail "claim-gate RED arm: rc=$rrc (want 1) with one act value past the .544 bound"
    printf '%s\n' "$out" | grep -q '=> REFUTED: cnt(>=0.55)=1' \
      || fail "claim-gate RED arm: claim 2 did not read REFUTED naming its own counterexample"
  fi

  # MIXTURE arm — a false HOLDS minted by COMPOSITION, the inverse polarity of the RED arm above.
  # Two organs, each internally uniform and each entirely on ONE side of the doctrine median: ear
  # all act=0.10, drop all act=0.50. No row is anywhere near 0.319, yet the pooled split is exactly
  # 0.500/0.500 because the arms are equal-sized, so the pooled band reads z=+0.0 and the gate
  # printed HOLDS with rc=0 (verified by hand on this very fixture, 2026-08-25). The band cannot
  # see it: the band is derived from n, and n is what the mixture moves. dyn and move are given
  # IDENTICAL per-organ distributions centred on their doctrine medians, so this arm also proves
  # the guard DISCRIMINATES — it must fire on act alone and leave the genuinely centred axes HOLDS,
  # or a guard that fires on every multi-organ corpus is no better than one that never fires.
  awk 'BEGIN{ n=20
    split("ear drop", org, " "); split("0.10 0.50", av, " ")
    for (k=1;k<=2;k++) for (i=0;i<n;i++){ t=(i-(n-1)/2)/((n-1)/2)
      if (i<n/2){ sc=60.0; b=4 } else { sc=50.0; b=12 }
      printf "2026-08-24T20:00Z %s f%02d%04x dur=18.00 win=18.00 cov=1.000 score=%.1f beats=%d [even] dyn=%.3f act=%.3f rich=0.700 move=%.3f cent=1500.0 -> pending\n",
        org[k], k, i, sc, b, 0.265+0.2*t, av[k], 0.141+0.1*t }
  }' > "$tmp/claims-mixture.log"
  out="$(cg "$tmp/claims-mixture.log")" && mrc=0 || mrc=$?
  # The pooled predicate must still be SATISFIED on this corpus — that is the whole point. If the
  # pooled line ever stops reading 0.500/0.500 the fixture has drifted and its red proves nothing.
  printf '%s\n' "$out" | grep -q 'cnt(>=0.319)=20' \
    || fail "claim-gate MIXTURE arm: fixture drifted — the pooled split is no longer the 20/20 that made the old gate print HOLDS"
  [ "$mrc" -eq 1 ] || fail "claim-gate MIXTURE arm: rc=$mrc (want 1) on a corpus where the doctrine median splits no organ in half"
  printf '%s\n' "$out" | grep -q '=> MIXTURE: the doctrine median 0.319' \
    || fail "claim-gate MIXTURE arm: act did not read MIXTURE — a pooled HOLDS over two polarized organs is the composition artifact wearing the material's name"
  printf '%s\n' "$out" | grep -qE 'arms: .*(ear|drop) n=20 p=(0.000|1.000) z=[-+]4.5' \
    || fail "claim-gate MIXTURE arm: the MIXTURE verdict did not name its arms with their own n/p/z"
  [ "$(printf '%s\n' "$out" | grep -c '=> HOLDS')" -eq 4 ] \
    || fail "claim-gate MIXTURE arm: expected dyn+move+claim2+claim1 to still HOLD (the guard must discriminate, not fire on any multi-organ corpus), got $(printf '%s\n' "$out" | grep -c '=> HOLDS')"

  # BLIND arm — an empty corpus must render UNKNOWN, never HOLDS. A gate whose no-data path
  # reads as agreement is the silent-green this whole file exists to refuse.
  : > "$tmp/claims-empty.log"
  out="$(cg "$tmp/claims-empty.log")" && brc=0 || brc=$?
  [ "$brc" -eq 2 ] || fail "claim-gate BLIND arm: rc=$brc (want 2) on an empty corpus"
  printf '%s\n' "$out" | grep -q '=> HOLDS' \
    && fail "claim-gate BLIND arm: an empty corpus produced a HOLDS verdict"
  [ "$(printf '%s\n' "$out" | grep -c '=> UNKNOWN')" -eq 5 ] \
    || fail "claim-gate BLIND arm: expected 5 UNKNOWN verdicts on an empty corpus"
fi

[ "$rc" -eq 0 ] && echo "series-stats-test: ok ($( table | grep -c . ) truth-table rows + rom==source + 5 source-mutants RED + the domain pinned both sides + 8 random series vs the 64-bit twin + host refuses to window + 3 double-word carries red through the real reduction + the --claims gate GREEN on a true-by-construction corpus, RED on a landed one-value mutation, MIXTURE on a corpus whose pooled split is a 20/20 composition artifact, and UNKNOWN-never-HOLDS when blind)"
exit "$rc"
