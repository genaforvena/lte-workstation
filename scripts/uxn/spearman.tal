( spearman.tal — Spearman rank correlation as a ROM. rho*1000, integer, no floats. )
( A gate CLASS that REDUCES A SERIES to a single calibrated number. )
(                                                                                        )
( input  : decimal tokens on stdin, newline-terminated — n, then n rank-difference )
(          magnitudes |d|. The HOST owns ranking [and therefore tie handling]; the ROM )
(          owns the formula, the reduction, and its domain. )
( output : rho*1000 as a signed decimal + newline, halt rc 0. )
( domain : 2 <= n <= 2343, every |d| < n, sum(d^2) <= 2*D. Outside → "NA\n" + halt rc 2. )
(                                                                                        )
( THE CEILING WAS THE WORD SIZE, NOT THE ALGORITHM. This ROM used to stop at n=58 and )
( the full series was reduced by the awk twin instead — which meant the ROM was not doing )
( the reduction at all, and "reduce a series" was a demo. Both quantities that overflowed )
( are now double-word [arith32.tal]: sum-of-squares and D=(n^3-n)/6. The new ceiling is )
( 2343, chosen so that 2*D + the largest possible d^2 still fits 32 bits — so a single )
( accumulation step can never wrap, and the sum(d^2) <= 2*D check after every value is )
( then a COMPLETE overflow guard rather than a hopeful one. 58 -> 2343 is 40x, and puts )
( the live 650-record corpus inside the ROM instead of alongside it. )
(                                                                                        )
( rho = 1 - 6*S/(n^3-n) = 1 - S/D, so rho*1000 = 1000 - 1000*S/D. 1000*S does not fit )
( even in 32 bits, so the scaling still runs as three multiply-by-10-MODULO-D steps )
( [&outer/&inner], each holding t < D and adding r < D, so the largest value held is )
( t+r < 2*D. That is what the ceiling is really protecting. )
(                                                                                        )
( zero-page: n=00 acc=06 state=08 cnt=0a q=0c dig=12 a=14 b=16 c=18 outer=1a inner=1c )
(            val=1e started=20 place=22 dig10=24 · 40..5f = arith32.tal's register file )
(            S=60/62  D=64/66  R=68/6a  T=6c/6e  DD=70/72   [all HI/LO double-word] )

|0100                        ( reset vector )
    ;on-console #10 DEO2     ( install Console/vector )
    BRK

@on-console
    #12 DEI                  ( Console/read -> byte )
    DUP #0a NEQ ,&digit JCN  ( not newline -> accumulate a digit )
    POP                      ( newline: drop it, the token is complete )
    #08 LDZ #00 EQU ,&isn JCN
    ;gotval JMP2
    &isn
    ;gotn JMP2
    &digit
    #30 SUB                  ( byte-'0' -> digit )
    #00 SWP                  ( promote to short )
    #06 LDZ2 #000a MUL2      ( acc*10 — n and every |d| are < 2344, so 16 bits is enough )
    ADD2
    #06 STZ2
    BRK

@gotn ( the first token is n )
    #06 LDZ2 #00 STZ2        ( n = acc )
    #0000 #06 STZ2           ( acc = 0 )
    #00 LDZ2 #0002 LTH2 #00 EQU ,&g1 JCN
    ;na JMP2                 ( n < 2: no ranks to correlate )
    &g1
    #00 LDZ2 #0927 GTH2 #00 EQU ,&g2 JCN
    ;na JMP2                 ( n > 2343: past what 32 bits can hold without wrapping )
    &g2
    ;calc-d JSR2
    #0000 #60 STZ2  #0000 #62 STZ2      ( S = 0 )
    #0000 #0a STZ2                      ( cnt = 0 )
    #01 #08 STZ                         ( state = 1: the rest of the tokens are |d| )
    BRK

@gotval ( each subsequent token is one |d| )
    #06 LDZ2 #00 LDZ2 LTH2 ,&v1 JCN
    ;na JMP2                 ( |d| >= n is not a rank difference )
    &v1
    #06 LDZ2 #4c STZ2 #06 LDZ2 #4e STZ2
    ;w-mul16 JSR2            ( A = d*d, full 32 bits — d can reach 2342, d^2 5.5M )
    #60 LDZ2 #44 STZ2 #62 LDZ2 #46 STZ2
    ;w-add JSR2              ( A = d*d + S )
    #40 LDZ2 #60 STZ2 #42 LDZ2 #62 STZ2   ( S = A )
    ( S <= 2D after EVERY value. Because the ceiling guarantees 2D + max(d^2) fits 32 )
    ( bits, no single step can wrap past it — so this check cannot be jumped over. )
    #70 LDZ2 #40 STZ2 #72 LDZ2 #42 STZ2   ( A = DD )
    #60 LDZ2 #44 STZ2 #62 LDZ2 #46 STZ2   ( B = S )
    ;w-cmp JSR2 ,&v2 JCN                  ( DD >= S ? )
    ;na JMP2
    &v2
    #0000 #06 STZ2           ( acc = 0 )
    #0a LDZ2 INC2 #0a STZ2   ( cnt++ )
    #0a LDZ2 #00 LDZ2 EQU2 ,&done JCN
    BRK
    &done
    ;decide JMP2

( D = (n^3-n)/6 = (n-1)*n*(n+1)/6. n^3 leaves 32 bits at n=1626, so it is never formed: )
( exactly one of three consecutive integers is divisible by 3 and at least one is even, )
( so both divisions happen on the 16-bit FACTORS and every partial product divides D. )
@calc-d ( -- )
    #00 LDZ2 #0001 SUB2 #14 STZ2   ( a = n-1 )
    #00 LDZ2 #16 STZ2              ( b = n )
    #00 LDZ2 INC2 #18 STZ2         ( c = n+1 )
    #14 LDZ2 ;mod3 JSR2 #0000 EQU2 ,&d3a JCN
    #16 LDZ2 ;mod3 JSR2 #0000 EQU2 ,&d3b JCN
    #18 LDZ2 #0003 DIV2 #18 STZ2
    ,&two JMP
    &d3a #14 LDZ2 #0003 DIV2 #14 STZ2 ,&two JMP
    &d3b #16 LDZ2 #0003 DIV2 #16 STZ2
    &two
    #14 LDZ2 ;mod2 JSR2 #0000 EQU2 ,&d2a JCN
    #16 LDZ2 ;mod2 JSR2 #0000 EQU2 ,&d2b JCN
    #18 LDZ2 #0002 DIV2 #18 STZ2
    ,&mul JMP
    &d2a #14 LDZ2 #0002 DIV2 #14 STZ2 ,&mul JMP
    &d2b #16 LDZ2 #0002 DIV2 #16 STZ2
    &mul
    #14 LDZ2 #4c STZ2 #16 LDZ2 #4e STZ2
    ;w-mul16 JSR2                  ( A = a*b, widened )
    #18 LDZ2 #4e STZ2
    ;w-mul32 JSR2                  ( A = a*b*c )
    #40 LDZ2 #64 STZ2 #42 LDZ2 #66 STZ2   ( D = A )
    #64 LDZ2 #44 STZ2 #66 LDZ2 #46 STZ2   ( B = D )
    ;w-add JSR2                            ( A = D + D )
    #40 LDZ2 #70 STZ2 #42 LDZ2 #72 STZ2   ( DD = 2D, the validity bound )
    JMP2r

@mod3 ( x* -- x%3* )
    DUP2 #0003 DIV2 #0003 MUL2 SUB2
    JMP2r

@mod2 ( x* -- x%2* )
    DUP2 #0002 DIV2 #0002 MUL2 SUB2
    JMP2r

@decide
    ( R = S; peel off whole multiples of D — S <= 2D so this runs at most twice )
    #60 LDZ2 #68 STZ2 #62 LDZ2 #6a STZ2
    #0000 #0c STZ2                        ( q = 0 )
    &peel
    #68 LDZ2 #40 STZ2 #6a LDZ2 #42 STZ2
    #64 LDZ2 #44 STZ2 #66 LDZ2 #46 STZ2
    ;w-cmp JSR2 #00 EQU ,&peeled JCN      ( R >= D ? )
    ;w-sub JSR2
    #40 LDZ2 #68 STZ2 #42 LDZ2 #6a STZ2   ( R -= D )
    #0c LDZ2 INC2 #0c STZ2                ( q++ )
    ,&peel JMP
    &peeled
    #0003 #1a STZ2                        ( three decimal places to go )
    &outer
    ;mul10mod JSR2                        ( dig = (R*10)/D, R = (R*10)%D )
    #0c LDZ2 #000a MUL2 #12 LDZ2 ADD2 #0c STZ2   ( q = q*10 + dig )
    #1a LDZ2 #0001 SUB2 #1a STZ2
    #1a LDZ2 #0000 NEQ2 ,&outer JCN
    ( ROUND TO NEAREST, not truncate: one more digit decides. Truncating costs exactly 1 )
    ( in the last place and is NOT cosmetic — the 64-bit twin rounds, so a truncating ROM )
    ( DIVERGEd on 2 of 11 live windows [349 vs 348, 20 vs 19]. )
    ;mul10mod JSR2
    #12 LDZ2 #0005 LTH2 ,&noround JCN
    #0c LDZ2 INC2 #0c STZ2
    &noround
    #0c LDZ2 #03e8 GTH2 ,&neg JCN
    #03e8 #0c LDZ2 SUB2 ;print-dec JSR2   ( rho*1000 = 1000 - q, positive )
    ,&fin JMP
    &neg
    #2d #18 DEO                           ( '-' )
    #0c LDZ2 #03e8 SUB2 ;print-dec JSR2   ( q > 1000 -> negative correlation )
    &fin
    #0a #18 DEO
    #80 #0f DEO              ( System/state: halt, exit 0 )
    BRK

( One decimal digit of R/D, by ten conditional additions rather than a 32-bit division: )
( T stays < D and R < D, so the largest value held is T+R < 2D — the same bound the )
( domain ceiling is built around. The count of subtractions IS the digit. )
@mul10mod ( -- ; dig at 12, R updated )
    #0000 #12 STZ2                        ( dig = 0 )
    #0000 #6c STZ2 #0000 #6e STZ2         ( T = 0 )
    #000a #1c STZ2                        ( ten additions = one multiply by 10 )
    &inner
    #6c LDZ2 #40 STZ2 #6e LDZ2 #42 STZ2
    #68 LDZ2 #44 STZ2 #6a LDZ2 #46 STZ2
    ;w-add JSR2                           ( T += R )
    #40 LDZ2 #6c STZ2 #42 LDZ2 #6e STZ2
    #6c LDZ2 #40 STZ2 #6e LDZ2 #42 STZ2
    #64 LDZ2 #44 STZ2 #66 LDZ2 #46 STZ2
    ;w-cmp JSR2 #00 EQU ,&nosub JCN       ( T >= D ? )
    ;w-sub JSR2
    #40 LDZ2 #6c STZ2 #42 LDZ2 #6e STZ2   ( T -= D )
    #12 LDZ2 INC2 #12 STZ2                ( and that carry IS the decimal digit )
    &nosub
    #1c LDZ2 #0001 SUB2 #1c STZ2
    #1c LDZ2 #0000 NEQ2 ,&inner JCN
    #6c LDZ2 #68 STZ2 #6e LDZ2 #6a STZ2   ( R = T, still < D )
    JMP2r

@print-dec ( v* -- )
    #1e STZ2                 ( val = v, v <= 1000 )
    #00 #20 STZ              ( started = 0 — leading-zero suppression )
    #03e8 ;emit-digit JSR2
    #0064 ;emit-digit JSR2
    #000a ;emit-digit JSR2
    #0001 ;emit-digit JSR2
    JMP2r

@emit-digit ( place* -- )
    #22 STZ2
    #1e LDZ2 #22 LDZ2 DIV2 #24 STZ2                       ( d = val/place )
    #1e LDZ2 #24 LDZ2 #22 LDZ2 MUL2 SUB2 #1e STZ2         ( val -= d*place )
    #24 LDZ2 #0000 NEQ2 ,&emit JCN
    #20 LDZ #00 NEQ ,&emit JCN
    #22 LDZ2 #0001 EQU2 ,&emit JCN                        ( the units place always prints )
    JMP2r
    &emit
    #01 #20 STZ
    #24 LDZ2 NIP #30 ADD #18 DEO
    JMP2r

@na
    ;na-str ;emit JSR2
    #82 #0f DEO              ( halt, exit 2 — honest domain n/a, never a wrapped verdict )
    BRK

@emit ( str* -- )
    &loop
    LDAk #00 EQU ,&done JCN
    LDAk #18 DEO
    INC2 ,&loop JMP
    &done
    POP2
    JMP2r

@na-str  "NA 0a 00

~arith32.tal
