( spearman.tal — Spearman rank correlation as a ROM. rho*1000, integer, no floats. )
( A THIRD gate CLASS for the Uxn pilot: lease-gate is one ratio, band-gate is a two-edged )
( band, this one REDUCES A SERIES to a single calibrated number. )
(                                                                                        )
( input  : decimal tokens on stdin, newline-terminated — n, then n rank-difference       )
(          magnitudes |d|. The HOST owns ranking [and therefore tie handling]; the ROM   )
(          owns only the formula and its domain. )
( output : rho*1000 as a signed decimal + newline, halt rc 0.                            )
( domain : 2 <= n <= 58, every |d| < n, sum(d^2) <= 2*D. Outside → "NA\n" + halt rc 2.   )
(                                                                                        )
( WHY 58, exactly — this is the whole point of the spike and it is not a guess. )
( rho = 1 - 6*S/(n^3-n), so with D = (n^3-n)/6 it is rho = 1 - S/D and rho*1000 = )
( 1000 - 1000*S/D. 1000*S does not fit 16 bits, so the scaling is done as three )
( multiply-by-10-MODULO-D steps [&outer/&inner below]: each keeps a running t < D and )
( adds r < D, so the largest value the machine ever holds is t+r < 2*D. That is the )
( real ceiling: D must stay <= 32767. D(58) = 32509 fits; D(59) = 34220 does not. )
( S itself is bounded by 2*D = 65018 at n=58, which is also the last n where the sum )
( of squares fits a short at all. The two limits coincide — 58 is where this machine )
( honestly ends, and past it the ROM says NA rather than a wrapped number. )
( A silent wrap here would look exactly like a real correlation. )
(                                                                                        )
( zero-page: n=00 D=02 S=04 acc=06 state=08 cnt=0a q=0c r=0e t=10 dig=12 )
(            a=14 b=16 c=18 outer=1a inner=1c val=1e started=20 place=22 dig10=24 )

|0100                        ( reset vector )
    ;on-console #10 DEO2     ( install Console/vector )
    BRK

@on-console
    #12 DEI                  ( Console/read -> byte )
    DUP #0a NEQ ,&digit JCN  ( not newline -> accumulate a digit )
    POP                      ( newline: drop it, the token is complete )
    #08 LDZ #00 EQU ,&isn JCN
    ;gotval JMP2
    &isn
    ;gotn JMP2
    &digit
    #30 SUB                  ( byte-'0' -> digit )
    #00 SWP                  ( promote to short )
    #06 LDZ2 #000a MUL2      ( acc*10 )
    ADD2
    #06 STZ2                 ( acc = acc*10 + digit )
    BRK

@gotn ( the first token is n )
    #06 LDZ2 #00 STZ2        ( n = acc )
    #0000 #06 STZ2           ( acc = 0 )
    #00 LDZ2 #0002 LTH2 #00 EQU ,&g1 JCN
    ;na JMP2                 ( n < 2: no ranks to correlate )
    &g1
    #00 LDZ2 #003a GTH2 #00 EQU ,&g2 JCN
    ;na JMP2                 ( n > 58: past this machine's honest domain )
    &g2
    ;calc-d JSR2
    #0000 #04 STZ2           ( S = 0 )
    #0000 #0a STZ2           ( cnt = 0 )
    #01 #08 STZ              ( state = 1: the rest of the tokens are |d| values )
    BRK

@gotval ( each subsequent token is one |d| )
    #06 LDZ2 #00 LDZ2 LTH2 ,&v1 JCN
    ;na JMP2                 ( |d| >= n is not a rank difference )
    &v1
    #06 LDZ2 #06 LDZ2 MUL2   ( d*d — d < n <= 58, so d*d <= 3249, always a short )
    #04 LDZ2 ADD2            ( S + d*d )
    DUP2 #04 LDZ2 LTH2 #00 EQU ,&v2 JCN
    POP2 ;na JMP2            ( the sum WRAPPED — refuse, never render the wrap )
    &v2
    #04 STZ2                 ( S = S + d*d )
    #0000 #06 STZ2           ( acc = 0 )
    #0a LDZ2 INC2 #0a STZ2   ( cnt++ )
    #0a LDZ2 #00 LDZ2 EQU2 ,&done JCN
    BRK
    &done
    ;decide JMP2

( D = (n^3-n)/6 = (n-1)*n*(n+1)/6, computed WITHOUT ever forming n^3 — 58^3 is 195112 )
( and would wrap. Exactly one of three consecutive integers is divisible by 3 and at )
( least one is even, so the /3 and the /2 are applied to the factors BEFORE multiplying )
( and every partial product divides D — it can never exceed it. )
@calc-d ( -- )
    #00 LDZ2 #0001 SUB2 #14 STZ2   ( a = n-1 )
    #00 LDZ2 #16 STZ2              ( b = n )
    #00 LDZ2 INC2 #18 STZ2         ( c = n+1 )
    #14 LDZ2 ;mod3 JSR2 #0000 EQU2 ,&d3a JCN
    #16 LDZ2 ;mod3 JSR2 #0000 EQU2 ,&d3b JCN
    #18 LDZ2 #0003 DIV2 #18 STZ2
    ,&two JMP
    &d3a #14 LDZ2 #0003 DIV2 #14 STZ2 ,&two JMP
    &d3b #16 LDZ2 #0003 DIV2 #16 STZ2
    &two
    #14 LDZ2 ;mod2 JSR2 #0000 EQU2 ,&d2a JCN
    #16 LDZ2 ;mod2 JSR2 #0000 EQU2 ,&d2b JCN
    #18 LDZ2 #0002 DIV2 #18 STZ2
    ,&mul JMP
    &d2a #14 LDZ2 #0002 DIV2 #14 STZ2 ,&mul JMP
    &d2b #16 LDZ2 #0002 DIV2 #16 STZ2
    &mul
    #14 LDZ2 #16 LDZ2 MUL2 #18 LDZ2 MUL2 #02 STZ2
    JMP2r

@mod3 ( x* -- x%3* )
    DUP2 #0003 DIV2 #0003 MUL2 SUB2
    JMP2r

@mod2 ( x* -- x%2* )
    DUP2 #0002 DIV2 #0002 MUL2 SUB2
    JMP2r

@decide
    #04 LDZ2 #02 LDZ2 #0002 MUL2 GTH2 #00 EQU ,&k1 JCN
    ;na JMP2                 ( S > 2D would mean rho < -1 — impossible, so refuse )
    &k1
    #04 LDZ2 #02 LDZ2 DIV2 #0c STZ2                  ( q = S/D, the integer part 0..2 )
    #04 LDZ2 #0c LDZ2 #02 LDZ2 MUL2 SUB2 #0e STZ2    ( r = S - q*D, r < D )
    #0003 #1a STZ2                                   ( three decimal places to go )
    &outer
    #0000 #12 STZ2           ( dig = 0 )
    #0000 #10 STZ2           ( t = 0 )
    #000a #1c STZ2           ( ten additions = one multiply by 10 )
    &inner
    #10 LDZ2 #0e LDZ2 ADD2 #10 STZ2        ( t += r — t < D and r < D, so t+r < 2D )
    #10 LDZ2 #02 LDZ2 LTH2 ,&nosub JCN
    #10 LDZ2 #02 LDZ2 SUB2 #10 STZ2        ( t -= D )
    #12 LDZ2 INC2 #12 STZ2                 ( and that carry IS the decimal digit )
    &nosub
    #1c LDZ2 #0001 SUB2 #1c STZ2
    #1c LDZ2 #0000 NEQ2 ,&inner JCN
    #0c LDZ2 #000a MUL2 #12 LDZ2 ADD2 #0c STZ2   ( q = q*10 + dig )
    #10 LDZ2 #0e STZ2                            ( r = t, still < D )
    #1a LDZ2 #0001 SUB2 #1a STZ2
    #1a LDZ2 #0000 NEQ2 ,&outer JCN
    ( ROUND TO NEAREST, not truncate. One more multiply-by-10-modulo-D produces the )
    ( fourth decimal digit; >=5 rounds q up. Truncating instead costs exactly 1 in the )
    ( last place and it is NOT cosmetic: the twin rounds, so a truncating ROM DIVERGEd )
    ( on 2 of 11 live windows [349 vs 348, 20 vs 19] — a systematic off-by-one that )
    ( would have read as an arithmetic bug in whichever side was checked second. )
    #0000 #12 STZ2
    #0000 #10 STZ2
    #000a #1c STZ2
    &round
    #10 LDZ2 #0e LDZ2 ADD2 #10 STZ2
    #10 LDZ2 #02 LDZ2 LTH2 ,&rnosub JCN
    #10 LDZ2 #02 LDZ2 SUB2 #10 STZ2
    #12 LDZ2 INC2 #12 STZ2
    &rnosub
    #1c LDZ2 #0001 SUB2 #1c STZ2
    #1c LDZ2 #0000 NEQ2 ,&round JCN
    #12 LDZ2 #0005 LTH2 ,&noround JCN
    #0c LDZ2 INC2 #0c STZ2
    &noround
    #0c LDZ2 #03e8 GTH2 ,&neg JCN
    #03e8 #0c LDZ2 SUB2 ;print-dec JSR2     ( rho*1000 = 1000 - q, positive )
    ,&fin JMP
    &neg
    #2d #18 DEO                             ( '-' )
    #0c LDZ2 #03e8 SUB2 ;print-dec JSR2     ( q > 1000 -> negative correlation )
    &fin
    #0a #18 DEO
    #80 #0f DEO              ( System/state: halt, exit 0 )
    BRK

@print-dec ( v* -- )
    #1e STZ2                 ( val = v, v <= 1000 )
    #00 #20 STZ              ( started = 0 — leading-zero suppression )
    #03e8 ;emit-digit JSR2
    #0064 ;emit-digit JSR2
    #000a ;emit-digit JSR2
    #0001 ;emit-digit JSR2
    JMP2r

@emit-digit ( place* -- )
    #22 STZ2
    #1e LDZ2 #22 LDZ2 DIV2 #24 STZ2                       ( d = val/place )
    #1e LDZ2 #24 LDZ2 #22 LDZ2 MUL2 SUB2 #1e STZ2         ( val -= d*place )
    #24 LDZ2 #0000 NEQ2 ,&emit JCN
    #20 LDZ #00 NEQ ,&emit JCN
    #22 LDZ2 #0001 EQU2 ,&emit JCN                        ( the units place always prints )
    JMP2r
    &emit
    #01 #20 STZ
    #24 LDZ2 NIP #30 ADD #18 DEO
    JMP2r

@na
    ;na-str ;emit JSR2
    #82 #0f DEO              ( halt, exit 2 — honest domain n/a, never a wrapped verdict )
    BRK

@emit ( str* -- )
    &loop
    LDAk #00 EQU ,&done JCN
    LDAk #18 DEO
    INC2 ,&loop JMP
    &done
    POP2
    JMP2r

@na-str  "NA 0a 00
