#!/usr/bin/env bash
# test-uxn-route — RED-first suite for route.rom (prefix router: 2-channel demux).
#
# Contract: FIRST input line = the prefix (config travels in-band, canonical text).
# Every following line: starts-with-prefix -> stdout, else -> stderr. EOF with a
# held partial (line shorter than the prefix, no newline) -> stderr (an incomplete
# line never counts as a match). Halts #80 (rc 0).
set -u
here="$(cd "$(dirname "$0")" && pwd)"
cd "$here"
[ -x bin/uxncli ] || ./build.sh >/dev/null
rc=0
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
[ -f route.rom ] || ./bin/uxnasm route.tal route.rom >/dev/null 2>&1

run() { ./bin/uxncli route.rom >"$tmp/out" 2>"$tmp/err"; }

# 1) basic demux: [task] lines -> stdout, others -> stderr; config line echoed NOWHERE
printf '[task]\n[task] fix the gate\n[idle] nothing\n[task] wire it\n[fyi] note\n' | run
r=$?
[ "$r" -eq 0 ] || { echo "FAIL: healthy route must exit 0 (rc=$r)"; rc=1; }
printf '[task] fix the gate\n[task] wire it\n' >"$tmp/want-out"
printf '[idle] nothing\n[fyi] note\n' >"$tmp/want-err"
cmp -s "$tmp/out" "$tmp/want-out" || { echo "FAIL: stdout demux (got: $(cat "$tmp/out" | tr '\n' '|'))"; rc=1; }
cmp -s "$tmp/err" "$tmp/want-err" || { echo "FAIL: stderr demux (got: $(cat "$tmp/err" | tr '\n' '|'))"; rc=1; }

# 2) a line that IS exactly the prefix -> stdout
printf 'abc\nabc\nabd\n' | run
printf 'abc\n' >"$tmp/want-out"; printf 'abd\n' >"$tmp/want-err"
cmp -s "$tmp/out" "$tmp/want-out" || { echo "FAIL: exact-prefix line must hit stdout"; rc=1; }
cmp -s "$tmp/err" "$tmp/want-err" || { echo "FAIL: exact-prefix sibling to stderr"; rc=1; }

# 3) empty prefix (empty first line) -> everything matches -> all stdout, stderr empty
printf '\nalpha\nbeta\n' | run
printf 'alpha\nbeta\n' >"$tmp/want-out"
cmp -s "$tmp/out" "$tmp/want-out" || { echo "FAIL: empty prefix must route all to stdout"; rc=1; }
[ -s "$tmp/err" ] && { echo "FAIL: empty prefix must leave stderr empty"; rc=1; }

# 4) mismatch MID-prefix replays the held bytes intact (no byte loss on the reject path)
printf '[task]\n[tXsk] mangled\n' | run
[ -s "$tmp/out" ] && { echo "FAIL: mid-prefix mismatch leaked to stdout"; rc=1; }
printf '[tXsk] mangled\n' >"$tmp/want-err"
cmp -s "$tmp/err" "$tmp/want-err" || { echo "FAIL: reject path lost held bytes (got: $(cat "$tmp/err"))"; rc=1; }

# 5) EOF holding a partial (shorter than prefix, no newline) -> flushed to stderr
printf '[task]\n[ta' | run
[ -s "$tmp/out" ] && { echo "FAIL: EOF partial leaked to stdout"; rc=1; }
printf '[ta' >"$tmp/want-err"
cmp -s "$tmp/err" "$tmp/want-err" || { echo "FAIL: EOF partial must flush to stderr"; rc=1; }

# 6) the router rides the hop: shipped as a packet, both channels survive the pipe
out=$(printf 'G:\nG:yes\nB:no\n' | ./mesh-uxn-hop --pack route.rom | ./mesh-uxn-hop 2>"$tmp/err")
[ "$out" = 'G:yes' ] || { echo "FAIL: routed-via-hop stdout (got '$out')"; rc=1; }
[ "$(cat "$tmp/err")" = 'B:no' ] || { echo "FAIL: routed-via-hop stderr (got '$(cat "$tmp/err")')"; rc=1; }

[ "$rc" = 0 ] && echo "uxn-route-test: ok" || echo "uxn-route-test: FAIL"
exit $rc
