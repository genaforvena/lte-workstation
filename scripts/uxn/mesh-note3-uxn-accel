#!/usr/bin/env bash
# mesh-note3-uxn-accel — host-side caller for sysfs-serve.rom: dial the note3's uxn
# sysfs listener over TCP, parse the accelerometer CSV, emit "x y z".
#
# This is the SHELL half of the termux-independent sense transport. Per the sense
# boundary (scripts/uxn/sense-gate.tal:8-11) the ROM is a byte conduit (read sysfs,
# write socket, no float math) and THIS shell parses the payload — it does NOT
# classify motion (that stays in mesh-body-motion's classifier). Pure parse.
#
# Prereq: sysfs-serve.rom running on the phone (adb-pushed uxncli, cwd=/ so the file
# sandbox admits /sys): see scripts/uxn/sysfs-serve.tal. If the listener is down this
# exits 2 (honest n/a) — same convention as mesh-mag/mesh-gyro on an unreachable body.
#
#   mesh-note3-uxn-accel              -> "x y z"     (e.g. "-175 -8 -15815")
#   mesh-note3-uxn-accel --json       -> {"x":..,"y":..,"z":..}
#   mesh-note3-uxn-accel --raw        -> the tagged line verbatim ("uxn:-175,-8,-15815")
#   mesh-note3-uxn-accel --test       -> assert a live read yields 3 numeric axes (exit 0/2)
#   IP=.. PORT=.. mesh-note3-uxn-accel -> override target
#
# Exit: 0 = parsed 3 axes · 2 = listener/phone unreachable or <3 axes (honest n/a).
set -eu
HERE="$(cd "$(dirname "$0")" && pwd)"
UXN_CLI="${UXN_CLI:-$HERE/bin/uxncli}"
NET_ECHO="${NET_ECHO:-$HERE/net-echo.rom}"
IP="${IP:-192.168.8.184}"
PORT="${PORT:-47320}"
TAG='uxn:'

raw() {
    # dial the listener; net-echo sends a throwaway payload 'q', the server ignores it
    # and streams 'uxn:' + the sysfs bytes. UXN_NET_TIMEOUT bounds the wait.
    # success is the 'uxn:' TAG, not mere non-empty output: net-echo prints 'NA' on a
    # failed connect, which is non-empty but is failure. retry a few times — a persistent
    # listener can transiently NA a rapid back-to-back dial (accept re-arm window); at
    # real poll cadence it never fires, the retry is honest and visible.
    local out i
    for i in 1 2 3 4; do
        out="$(printf 'tcp:%s:%s\nq\n' "$IP" "$PORT" \
            | UXN_NET_TIMEOUT="${UXN_NET_TIMEOUT:-10}" "$UXN_CLI" "$NET_ECHO" 2>/dev/null || true)"
        case "$out" in "$TAG"*) printf '%s\n' "$out"; return 0 ;; esac
        sleep 0.4
    done
    return 1
}

# strip the 4-byte 'uxn:' tag + trailing CR/LF; echo only the CSV payload, or empty
payload() {
    local line
    line="$(raw)"
    [ -n "$line" ] || return 1
    case "$line" in
        "$TAG"*) line="${line#$TAG}" ;;     # strip leading tag
        *) return 1 ;;                       # not our ROM -> don't trust it
    esac
    # strip trailing \r / whitespace
    line="${line%$'\r'}"; line="${line#"${line%%[![:space:]]*}"}"; line="${line%"${line##*[![:space:]]}"}"
    printf '%s\n' "$line"
}

case "${1:-}" in
    --raw) r="$(raw)" || { echo "n/a — listener at $IP:$PORT unreachable"; exit 2; }
           [ -n "$r" ] || { echo "n/a — empty reply"; exit 2; }; printf '%s\n' "$r"; exit 0 ;;
    --json)
        p="$(payload)" || { echo "n/a — listener at $IP:$PORT unreachable or untagged"; exit 2; }
        IFS=',' read -r x y z _ <<<"$p"
        printf '{"x":%s,"y":%s,"z":%s}\n' "${x:-NaN}" "${y:-NaN}" "${z:-NaN}" ;;
    --test)
        p="$(payload)" || { echo "smoke: ok (parser fixtures); n/a live read (listener at $IP:$PORT unreachable)"; exit 2; }
        # gate: a LIVE read must yield exactly 3 INTEGER axes — the real path, not a stub.
        # <3 axes = the ROM read 0 sysfs bytes (sandbox/cwd wrong) or a parse split.
        IFS=',' read -r x y z rest <<<"$p"
        ok=1
        for v in "$x" "$y" "$z"; do
            [ -n "$v" ] && printf '%s' "$v" | grep -qE '^-?[0-9]+$' || ok=0
        done
        [ -z "$rest" ] || ok=0     # exactly 3 fields, no 4th
        if [ "$ok" = 1 ]; then
            echo "note3-uxn-accel: live read OK — x=$x y=$y z=$z (3 axes via uxn/TCP, no termux)"
            exit 0
        else
            echo "note3-uxn-accel: FAIL — live read did not yield 3 integer axes (got: '$p'); ROM likely read 0 sysfs bytes (cwd != /?) or sysfs path wrong"
            exit 2
        fi ;;
    "" )
        p="$(payload)" || { echo "n/a — listener at $IP:$PORT unreachable or untagged"; exit 2; }
        IFS=',' read -r x y z _ <<<"$p"
        printf '%s %s %s\n' "${x:-NaN}" "${y:-NaN}" "${z:-NaN}" ;;
    *) echo "usage: $0 [--raw|--json|--test]   (env: IP PORT UXN_CLI NET_ECHO)"; exit 64 ;;
esac
