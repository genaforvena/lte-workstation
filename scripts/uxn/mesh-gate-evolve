#!/usr/bin/env bash
# mesh-gate-evolve — the gates-as-data autopoiesis reflex (stage 4b, 2026-07-23).
#
# Stage 3 built the door (mesh-gate-admission); nothing walked through it unattended — the
# never-wired-reflex hole (cc617e5). This is the walker: each run drives at most ONE candidate
# to a verdict, and the admission harness stays the ONLY door (this tool never touches the
# ledger, the adopted fixtures, or the log itself — it only calls --propose/--admit).
#
#   1. drain-first — oldest parked *.cand in the candidate dir → --admit → rename
#                    .cand.admitted / .cand.rejected (the dir is a queue, never a re-try loop;
#                    an unrenamed reject would be re-judged every run forever)
#   2. propose     — only when nothing is parked: next goal from the gate-goals rotation →
#                    --propose (mesh-relay) → --admit → rename. One relay call per run, max.
#   3. capacity    — >= MESH_GATE_MAX admitted rows (default 8): proposing stops, SAYS so
#                    (bloat guard — generated gates must not grow the ledger unboundedly);
#                    drain still runs, a human can raise the cap deliberately.
#
# A REJECT is a completed run (rc 0) — the loop's artifact is a VERDICT in the admission log,
# not an admission. Generator/environment down = rc 2 honest n/a, parked work stays parked.
#
# usage: mesh-gate-evolve            one drain-or-propose cycle
#        mesh-gate-evolve --check    say what the next run WOULD do (no relay call, no verdict)
#        mesh-gate-evolve --test
# exit:  0 verdict reached / at-capacity / nothing to do · 2 honest n/a
# env:   MESH_GATE_GOALS  goal rotation file        (default $here/gate-goals)
#        MESH_GATE_STATE  rotation index state      (default ~/.mesh/gate-evolve.state)
#        MESH_GATE_MAX    admitted-row cap          (default 8)
#        MESH_ADMIT_*     passed through to mesh-gate-admission (see its header)
# orphan-ok: wired via the scripts/mesh-gate-evolve deploy shim (reflex-cadence lives there)
set -u
here="$(cd "$(dirname "$0")" && pwd)"
ADMIT="$here/mesh-gate-admission"
GOALS="${MESH_GATE_GOALS:-$here/gate-goals}"
STATE="${MESH_GATE_STATE:-$HOME/.mesh/gate-evolve.state}"
MAX="${MESH_GATE_MAX:-8}"
CDIR="${MESH_ADMIT_CAND_DIR:-$HOME/.mesh/gate-candidates}"
ADOPTED="${MESH_ADMIT_ADOPTED:-$here/admitted-fixtures}"

[ "${1:-}" = --test ] && exec "$here/test-gate-evolve"
check=0; [ "${1:-}" = --check ] && check=1

na(){ echo "gate-evolve: n/a — $*" >&2; exit 2; }
[ -x "$ADMIT" ] || na "no mesh-gate-admission at $ADMIT"

judge(){ # $1=candidate path → verdict via the door + queue rename; rc 0 verdict / 2 n/a
  local cand="$1" out arc
  out="$("$ADMIT" --admit "$cand" 2>&1)"; arc=$?
  case "$arc" in
    0) mv -- "$cand" "$cand.admitted" ;;
    1) mv -- "$cand" "$cand.rejected" ;;
    *) echo "gate-evolve: admission n/a on $(basename "$cand") — left parked: $out" >&2; exit 2 ;;
  esac
  echo "gate-evolve: $out"
  exit 0
}

# ── 1. drain-first: oldest parked candidate ───────────────────────────────────────────────
parked="$(ls -1tr "$CDIR"/*.cand 2>/dev/null | head -1 || true)"
if [ -n "$parked" ]; then
  [ "$check" = 1 ] && { echo "gate-evolve: would drain parked $(basename "$parked")"; exit 0; }
  judge "$parked"
fi

# ── 2. capacity guard (counted from the adopted-fixtures markers the door writes) ─────────
nadm="$(grep -c '^# admitted:' "$ADOPTED" 2>/dev/null || true)"
if [ "${nadm:-0}" -ge "$MAX" ]; then
  echo "gate-evolve: at capacity ($nadm admitted rows >= MESH_GATE_MAX=$MAX) — not proposing; raise the cap deliberately or drop admitted gates"
  exit 0
fi

# ── 3. propose: next goal from the rotation ───────────────────────────────────────────────
[ -s "$GOALS" ] || na "no goals at $GOALS"
mapfile -t goals < <(grep -vE '^[[:space:]]*(#|$)' "$GOALS")
n="${#goals[@]}"
[ "$n" -gt 0 ] || na "goals file $GOALS carries no goal lines"
idx="$(cat "$STATE" 2>/dev/null || echo 0)"
case "$idx" in ''|*[!0-9]*) idx=0 ;; esac
goal="${goals[$((idx % n))]}"
[ "$check" = 1 ] && { echo "gate-evolve: would propose goal #$((idx % n + 1))/$n: $goal"; exit 0; }
cand="$("$ADMIT" --propose "$goal")" || na "propose failed for goal: $goal"
echo "$((idx + 1))" > "$STATE"
judge "$cand"
