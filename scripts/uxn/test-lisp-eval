#!/usr/bin/env bash
# test-lisp-eval — gate for the micro s-expression evaluator ROM (uxn-lisp-spike, 2026-07-23).
#
# CONTRACT (step 1): the ROM evaluates an expression fed to it as DATA — reader + eval over
# naturals, lazy `if`, and the NA/#82 domain honesty carried over from lease-gate (overflow /
# underflow / div-zero / parse breakage answer NA rc=2, never a wrapped value).
# CONTRACT (step 2): lease-gate expressed AS an s-expr the evaluator runs — the 5-row truth
# table from chibicc-eval/EVAL.md rendered as `(if (>= <lease> (* 2 <cad>)) 1 0)`, plus the
# two calibrate-caught wrap rows (67335 false-RED, 33000/60000 false-GREEN) which must NA.
# RED-first: a rebuild with the >= handler flipped to < must FAIL the same tables — proves
# the tables discriminate, not decorate. Byte-identity with the committed ROM is reported
# as info only (chibicc output may drift a byte across hosts; behavior is the contract).
set -u
here="$(cd "$(dirname "$0")" && pwd)"
cd "$here"
command -v "${CC:-cc}" >/dev/null 2>&1 || { echo "lisp-eval-test: n/a (no host cc)" >&2; exit 2; }
[ -x bin/uxncli ] || ./build.sh >/dev/null 2>&1 || { echo "lisp-eval-test: n/a (toolchain build failed)" >&2; exit 2; }
rc=0
tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT

./cc-rom.sh lisp-eval.c "$tmp/fresh.rom" >/dev/null 2>&1 \
  || { echo "lisp-eval-test: FAIL (cc-rom.sh could not build lisp-eval.rom)"; exit 1; }

run(){ # $1=rom $2=expr → stdout value, rc passthrough
  ./bin/uxncli "$1" "$2" 2>/dev/null
}

# step 1: evaluator core — value rows (want a number) + NA rows (want NA rc2, honest domain)
core(){ # $1=rom → prints FAILing rows, returns nonzero if any
  local rom="$1" bad=0 v urc
  while IFS='|' read -r expr want; do
    v="$(run "$rom" "$expr")"; urc=$?
    [ "$v" = "$want" ] || { echo "  core '$expr' → want '$want' got '${v:-}' rc=$urc"; bad=1; }
    if [ "$want" = NA ]; then
      [ "$urc" = 2 ] || { echo "  core '$expr' → NA must halt #82 (rc2), got rc=$urc"; bad=1; }
    else
      [ "$urc" = 0 ] || { echo "  core '$expr' → value must halt #80 (rc0), got rc=$urc"; bad=1; }
    fi
  done <<'ROWS'
5|5
(+ 1 2)|3
(+ 1 2 3 4)|10
(* 3 (+ 2 2))|12
(- 10 4)|6
(/ 9 2)|4
(< 3 4)|1
(> 3 4)|0
(<= 3 3)|1
(>= 2 3)|0
(= 4 4)|1
(if 1 7 8)|7
(if 0 7 8)|8
(if 1 7 (/ 1 0))|7
(if 0 (/ 1 0) 8)|8
(- 1 2)|NA
(/ 5 0)|NA
(+ 65535 1)|NA
(* 2 33000)|NA
70000|NA
(foo 1)|NA
(+ 1 2|NA
1 2|NA
ROWS
  return $bad
}

# step 2: lease-gate AS DATA — the EVAL.md 5-row table rendered into an s-expr the ROM runs,
# + the two wrap rows the ROM must decline (the exact false verdicts calibrate caught).
gate(){ # $1=rom
  local rom="$1" bad=0 v urc expr
  while read -r cad lease want; do
    expr="(if (>= $lease (* 2 $cad)) 1 0)"
    v="$(run "$rom" "$expr")"; urc=$?
    [ "$v" = "$want" ] || { echo "  gate $cad/$lease → want $want got '${v:-}' rc=$urc"; bad=1; }
  done <<'ROWS'
900 1800 1
900 1799 0
900 1801 1
900 900 0
60 3600 1
900 67335 NA
33000 60000 NA
ROWS
  return $bad
}

if core "$tmp/fresh.rom" && gate "$tmp/fresh.rom"; then
  echo "PASS: fresh ROM evaluates data-fed s-exprs (core + lease-gate-as-s-expr + NA domain)"
else
  echo "FAIL: fresh lisp-eval.rom violates the tables"; rc=1
fi

# The COMMITTED artifact must satisfy the same contract (the ROM in the genome IS the claim).
if [ -f lisp-eval.rom ] && core lisp-eval.rom >/dev/null && gate lisp-eval.rom >/dev/null; then
  echo "PASS: committed lisp-eval.rom satisfies the same tables"
else
  echo "FAIL: committed lisp-eval.rom missing or violates the tables"; rc=1
fi
if cmp -s "$tmp/fresh.rom" lisp-eval.rom; then
  echo "info: fresh build byte-identical with committed ROM"
else
  echo "info: fresh build differs from committed ROM ($(wc -c <"$tmp/fresh.rom")b vs $(wc -c <lisp-eval.rom)b) — allowed, tables are the contract"
fi

# RED-first: flip the >= handler; the SAME tables must fail (a table never seen RED decorates).
sed 's/r = (r >= v)/r = (r < v)/' lisp-eval.c > "$tmp/broken.c"
grep -q 'r = (r < v)' "$tmp/broken.c" || { echo "FAIL: red-first mutation did not apply (source drifted?)"; rc=1; }
./cc-rom.sh "$tmp/broken.c" "$tmp/broken.rom" >/dev/null 2>&1 || { echo "FAIL: mutant rebuild errored (should compile, just answer wrong)"; rc=1; }
if [ -f "$tmp/broken.rom" ] && gate "$tmp/broken.rom" >/dev/null; then
  echo "FAIL: gate table passed a ROM with >= INVERTED — table asserts nothing"; rc=1
else
  echo "PASS: inverted->= ROM fails the gate table (seen RED)"
fi

[ "$rc" = 0 ] && echo "lisp-eval-test: ok" || echo "lisp-eval-test: FAIL"
exit $rc
