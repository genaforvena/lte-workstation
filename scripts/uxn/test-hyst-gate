#!/usr/bin/env bash
# test-hyst-gate — RED-first proof for the 3rd gate CLASS: a hysteresis predicate carrying prior
# state (spec 2026-07-23 §3.4). The both-edges-of-a-signal-need-the-same-gate family — onset and
# recovery must be ONE gate with the RIGHT thresholds (onset at ON, recovery below OFF, HOLD between).
# Corrupt EACH comparison in the C source in turn, rebuild, and demand the truth table breaks — so the
# real ROM's verdict is real arithmetic, not a constant (the CONTRACT is the truth table, not byte
# identity — chibicc-eval/EVAL.md §4). On-demand harness (test-* canon), not cron-wired.
set -u
here="$(cd "$(dirname "$0")" && pwd)"; cd "$here"
[ -x bin/uxncli ] || ./build.sh >/dev/null
rc=0
./cc-rom.sh hyst-gate.c hyst-gate.rom >/dev/null 2>&1 || { echo "hyst-gate-test: FAIL (build hyst-gate.rom)"; exit 1; }

# verdict of the ACTUAL ROM on (value, prev) at therm-watch's real edges on=88 off=83.
hg()  { ../mesh-rom-gate hyst-gate "$1" 88 83 "$2" 2>/dev/null; }

# 1) truth table — onset at value>ON, HOLD in (OFF,ON] iff prev alerted, CLEAR at/below OFF or !prev.
[ "$(hg 90 1)" = ALERT ] || { echo "FAIL: 90>on must ALERT (prev=1)"; rc=1; }
[ "$(hg 90 0)" = ALERT ] || { echo "FAIL: 90>on must ALERT even from CLEAR (onset, prev-independent)"; rc=1; }
[ "$(hg 85 1)" = HOLD  ] || { echo "FAIL: 85 in band + prior ALERT must HOLD (hysteresis)"; rc=1; }
[ "$(hg 85 0)" = CLEAR ] || { echo "FAIL: 85 in band + prior CLEAR must stay CLEAR (no spurious onset)"; rc=1; }
[ "$(hg 88 1)" = HOLD  ] || { echo "FAIL: value==on (not >on) + prev must HOLD, not ALERT"; rc=1; }
[ "$(hg 83 1)" = CLEAR ] || { echo "FAIL: value==off (not >off) must CLEAR — recovery is BELOW off"; rc=1; }
[ "$(hg 80 1)" = CLEAR ] || { echo "FAIL: 80<off must CLEAR"; rc=1; }

# 2) RED-FIRST corrupt-each-comparison: mutate a comparison in the C, rebuild, demand the table breaks.
tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT
mut() { ../mesh-rom-gate "$tmp/m.rom" "$1" 88 83 "$2" 2>/dev/null; }   # verdict of the MUTANT rom
# (a) ONSET edge uses ON: change `value > on` → `value > off`. A value in (off,on] would then WRONGLY
#     ALERT — 85 from CLEAR flips CLEAR→ALERT. Proves onset compares against ON, not OFF.
sed 's/if (value > on)/if (value > off)/' hyst-gate.c > "$tmp/onset.c"
if ./cc-rom.sh "$tmp/onset.c" "$tmp/m.rom" >/dev/null 2>&1; then
  v="$(mut 85 0)"; [ "$v" = ALERT ] \
    && echo "PASS: onset-edge disabled (on→off) → 85 wrongly ALERT (real ROM crosses ON for onset)" \
    || { echo "FAIL: onset mutation left 85 as '$v' not ALERT — onset threshold may be dead code"; rc=1; }
else echo "FAIL: onset mutant did not build"; rc=1; fi
# (b) RECOVERY edge uses OFF: change `value > off` → `value > on`. The band collapses — 85 from ALERT
#     WRONGLY drops to CLEAR (recovery at ON = no hysteresis). Proves recovery compares against OFF.
sed 's/else if (prev \&\& value > off)/else if (prev \&\& value > on)/' hyst-gate.c > "$tmp/recov.c"
if ./cc-rom.sh "$tmp/recov.c" "$tmp/m.rom" >/dev/null 2>&1; then
  v="$(mut 85 1)"; [ "$v" = CLEAR ] \
    && echo "PASS: recovery-edge disabled (off→on) → 85 prev=ALERT wrongly CLEAR (real ROM uses OFF for recovery)" \
    || { echo "FAIL: recovery mutation left 85 prev=1 as '$v' not CLEAR — off threshold may be dead code"; rc=1; }
else echo "FAIL: recovery mutant did not build"; rc=1; fi

[ "$rc" = 0 ] && echo "hyst-gate-test: ok" || echo "hyst-gate-test: FAIL"
exit $rc
