#!/usr/bin/env bash
# test-net-device — gate for the CONNECT-only network device (0xd0), step 1.
#
# THE LIVE LEG IS A REAL TWO-NODE ROUND TRIP (mesh-home -> phaedra over tailscale), not a
# loopback stub. A localhost round trip exercises the same three syscalls and proves
# nothing about addressing, routing or the tailnet — it is the drives-only-stubs trap in
# its purest form: every assert green, the capability never once used. When the far node
# is unreachable this leg exits 2 (honest n/a — a claim about the NODE), never a fake pass.
#
# The device is an EMULATOR change, so leg A asserts the thing that could silently break
# everything else: existing ROMs must be byte-identical after the rebuild. A .rom that
# moved would mean the device leaked into the assembler or the ROMs got re-cut, and
# byte-identity across nodes is the whole basis of the hop lane's hash-then-execute pin.
set -u
here="$(cd "$(dirname "$0")" && pwd)"
cd "$here"
rc=0
tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT
fail(){ echo "  FAIL: $*"; rc=1; }
pass(){ echo "  PASS: $*"; }

PEER_IP="${MESH_NET_TEST_PEER_IP:-100.94.116.17}"
PEER_SSH="${MESH_NET_TEST_PEER:-root@$PEER_IP}"
PORT="${MESH_NET_TEST_PORT:-47101}"

./build.sh >/dev/null 2>&1 || { echo "net-device-test: n/a (toolchain will not build)"; exit 2; }
[ -x bin/uxncli ] || { echo "net-device-test: n/a (no uxncli)"; exit 2; }

# --- A. the emulator change did NOT move any ROM ----------------------------------------
before="$(sha1sum ./*.rom 2>/dev/null | sort)"
./build.sh --rom >/dev/null 2>&1 || fail "build.sh --rom failed"
after="$(sha1sum ./*.rom 2>/dev/null | sort)"
if [ "$before" = "$after" ]; then
  pass "ROM byte-identity holds across the rebuild ($(printf '%s\n' "$after" | grep -c . ) roms)"
else
  fail "a .rom CHANGED across the rebuild — the device leaked into ROM bytes:"
  diff <(printf '%s\n' "$before") <(printf '%s\n' "$after") | head -6
fi

# --- B. an existing ROM still answers identically under the new emulator -----------------
# The device added cases to emu_dei/emu_deo; a mis-placed case would silently divert a
# port an existing ROM uses. spearman is the densest DEI/DEO user in the tree.
got="$(printf '5\n1\n1\n0\n1\n1\n' | ./bin/uxncli spearman.rom 2>/dev/null)"
[ "$got" = "800" ] && pass "spearman.rom unaffected by the new device cases (800)" \
                   || fail "spearman.rom answers '$got' under the new emulator, want 800"

[ -f net-echo.rom ] || ./bin/uxnasm net-echo.tal net-echo.rom >/dev/null 2>&1
[ -f net-echo.rom ] || { echo "net-device-test: FAIL (no net-echo.rom)"; exit 1; }

# runrom <stdin…> → "<stdout>|<rc>" with stderr captured to $tmp/err
runrom(){ local o r; o="$(printf '%b' "$1" | timeout 30 ./bin/uxncli net-echo.rom 2>"$tmp/err")"; r=$?; printf '%s|%s' "$o" "$r"; }

# --- C. a refused connect is NA + LOUD, never a fabricated reply -------------------------
# Port 1 on the loopback has nothing on it; this leg is about the REFUSAL path, which is
# the one place a silent fallback would render "no link" as a plausible empty success.
g="$(runrom 'tcp:127.0.0.1:1\nping\n')"
if [ "$g" = "NA|2" ] && grep -q 'Connection refused' "$tmp/err"; then
  pass "refused connect → NA rc2 + loud stderr"
else
  fail "refused connect → want 'NA|2' + loud, got '$g' err='$(head -1 "$tmp/err")'"
fi

# --- D. an unknown scheme is REFUSED, not silently defaulted to tcp ----------------------
# Guessing the transport is exactly the fallback class that renders a failure as a success.
g="$(runrom 'gopher:127.0.0.1:1\nping\n')"
if [ "$g" = "NA|2" ] && grep -q 'unknown scheme' "$tmp/err"; then
  pass "unknown scheme → refused by name, no silent tcp default"
else
  fail "unknown scheme → want refusal naming it, got '$g' err='$(head -1 "$tmp/err")'"
fi

# --- E. an address with no port is REFUSED ----------------------------------------------
g="$(runrom 'tcp:127.0.0.1\nping\n')"
if [ "$g" = "NA|2" ] && grep -q 'no port in address' "$tmp/err"; then
  pass "address with no port → refused by name"
else
  fail "no-port address → want refusal, got '$g' err='$(head -1 "$tmp/err")'"
fi

# --- F. the connect DEADLINE is real, measured -------------------------------------------
# 192.0.2.1 is RFC5737 TEST-NET-1: routed nowhere, so the handshake black-holes. Without
# the non-blocking connect + select the kernel's SYN ladder sits there for minutes and a
# wedged emulator reads green to everything watching it, because it never returns to say
# otherwise. Asserted as WALL CLOCK — the only evidence that the deadline fired.
t0=$(date +%s)
g="$(UXN_NET_TIMEOUT=2 runrom 'tcp:192.0.2.1:9\nping\n')"
t1=$(date +%s)
el=$((t1 - t0))
if [ "$g" = "NA|2" ] && [ "$el" -le 8 ]; then
  pass "black-holed connect gave up in ${el}s under UXN_NET_TIMEOUT=2 (NA, not a hang)"
else
  fail "black-holed connect: want NA within ~2s, got '$g' after ${el}s"
fi

# --- G. bind is refused LOUDLY — step 1 is connect-only ----------------------------------
# An unimplemented port that answered a plausible state would be an organ declared before
# it was armed. Driven by a throwaway ROM so the gate ROM stays minimal.
cat > "$tmp/bindprobe.tal" <<'TAL'
|0100
    ;addr #dd DEO2           ( low byte of the bindaddr port is the bind trigger )
    #da DEI #30 ADD #18 DEO  ( print the state the device reports as a digit )
    #0a #18 DEO
    #80 #0f DEO
    BRK
@addr "tcp:127.0.0.1:9 00
TAL
if ./bin/uxnasm "$tmp/bindprobe.tal" "$tmp/bindprobe.rom" >/dev/null 2>&1; then
  g="$(timeout 15 ./bin/uxncli "$tmp/bindprobe.rom" 2>"$tmp/err2")"
  if [ "$g" = "4" ] && grep -q 'connect-only' "$tmp/err2"; then
    pass "bind → state 4 Unbound + loud 'connect-only' (never a plausible Bound)"
  else
    fail "bind → want state 4 + loud refusal, got '$g' err='$(head -1 "$tmp/err2")'"
  fi
else
  fail "bind probe ROM does not assemble"
fi

# --- H. RED-first on the SOURCE: each mutant must break a leg above ----------------------
# A gate nobody has seen fail is not a gate. Both mutants are plausible "simplifications"
# — dropping a refusal, dropping a timeout — and each is discriminated by exactly one leg
# above. `sed -z` because both edits span lines; a line-wise pattern silently matches
# nothing and the mutation reads green as a no-op, which is why that case FAILS loudly.
mutant_red(){ # $1=sed-z script  $2=label  $3=command that must FAIL against the mutant
  cp src/devices/net.c "$tmp/net.bak"
  sed -z "$1" src/devices/net.c > "$tmp/net.mut" || { fail "$2: sed failed"; return; }
  if cmp -s src/devices/net.c "$tmp/net.mut"; then
    fail "$2: mutation was a no-op (pattern missed — this mutant is NOT being tested)"; return
  fi
  cp "$tmp/net.mut" src/devices/net.c
  local built=1
  ./build.sh >/dev/null 2>&1 || built=0
  cp "$tmp/net.bak" src/devices/net.c
  if [ "$built" = 0 ]; then fail "$2: mutant does not build"; ./build.sh >/dev/null 2>&1; return; fi
  if eval "$3" >/dev/null 2>&1; then
    fail "$2: the check STILL PASSES against the mutant — that leg does not discriminate it"
  else
    pass "RED against mutant: $2"
  fi
  ./build.sh >/dev/null 2>&1
}
# an unknown scheme silently defaulting to tcp — leg D is the only thing standing between
# a typo'd scheme and a connection the ROM never asked for
mutant_red 's|\t\t\tnet_fail("unknown scheme", scheme);\n\t\t\tfree(s);\n\t\t\treturn EAI_SERVICE;|\t\t\thints.ai_socktype = SOCK_STREAM;|' \
  "unknown scheme silently defaults to tcp" \
  'printf "gopher:127.0.0.1:1\nping\n" | timeout 20 ./bin/uxncli net-echo.rom 2>&1 | grep -q "unknown scheme"'
# the connect deadline removed: select with a NULL timeout waits forever, which is the
# wedge that reads green because it never returns to say otherwise
mutant_red 's|if(select(fd + 1, NULL, \&wf, NULL, \&tv) <= 0) {|if(select(fd + 1, NULL, \&wf, NULL, NULL) <= 0) {|' \
  "connect deadline removed (select blocks forever)" \
  'a=$(date +%s); UXN_NET_TIMEOUT=2 timeout 20 ./bin/uxncli net-echo.rom >/dev/null 2>&1 <<<"tcp:192.0.2.1:9
ping"; b=$(date +%s); [ $((b-a)) -le 8 ]'

# --- I. THE LIVE LEG: a real mesh-home -> peer round trip over tailscale ------------------
# Not localhost. The peer uppercases what it receives, so an OK proves the far node
# actually PROCESSED the bytes — a reachability check would pass on an echo of our own
# buffer, or on a connect nothing was ever written to.
if ! timeout 15 ssh -n -o StrictHostKeyChecking=no -o ConnectTimeout=8 -o BatchMode=yes "$PEER_SSH" true 2>/dev/null; then
  echo "  n/a: peer $PEER_SSH unreachable — the live round trip did NOT run (honest n/a, not a pass)"
  [ "$rc" -eq 0 ] && { echo "net-device-test: n/a (local legs green, live leg needs $PEER_SSH)"; exit 2; }
  echo "net-device-test: FAIL"; exit 1
fi
timeout 70 ssh -n -o StrictHostKeyChecking=no -o BatchMode=yes "$PEER_SSH" \
  "timeout 50 socat TCP-LISTEN:$PORT,bind=$PEER_IP,reuseaddr,fork SYSTEM:'tr a-z A-Z'" >/dev/null 2>&1 &
lpid=$!
timeout 12 bash -c "until (exec 3<>/dev/tcp/$PEER_IP/$PORT) 2>/dev/null; do :; done" 2>/dev/null
g="$(runrom "tcp:$PEER_IP:$PORT\nping-uxn-net\n")"
kill "$lpid" 2>/dev/null
timeout 15 ssh -n -o StrictHostKeyChecking=no -o BatchMode=yes "$PEER_SSH" "pkill -f 'TCP-LISTEN:$PORT'" >/dev/null 2>&1
if [ "$g" = "PING-UXN-NET|0" ]; then
  pass "LIVE round trip $(hostname) -> $PEER_IP:$PORT over tailscale: sent 'ping-uxn-net', far node answered 'PING-UXN-NET'"
else
  fail "live round trip: want 'PING-UXN-NET|0', got '$g' err='$(head -1 "$tmp/err")'"
fi

[ "$rc" -eq 0 ] && echo "net-device-test: ok (ROM byte-identity + existing ROM unaffected + refusal/scheme/port refusals + measured connect deadline + bind refused + 2 source-mutants RED + a REAL two-node round trip)"
exit "$rc"
