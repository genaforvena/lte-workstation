#!/usr/bin/env bash
# mesh-note3-uxn-sense — the KEEPER and the first CONSUMER of the Note3's termux-free
# uxn/sysfs sense lane: it makes the phone-side listener exist, dials it, and gates the
# bytes that come back.
#
# THE CADENCE LIVES ON THE SHIM, not here: mesh-autowire wires DEPLOYED tools and resolves
# each one's genome source as scripts/<name> (mesh-autowire:351), so a header here would be
# invisible to it. scripts/mesh-note3-uxn-sense carries `# reflex-cadence: 6-59/10 * * * *`
# and `# reflex-args: --keep`.
#
# THE LANE. scripts/uxn/sysfs-serve.rom runs on the phone under uxncli with cwd=/, binds
# one TCP address, and on each caller opens ONE configured file through the FILE device
# and streams its raw bytes back tagged "uxn:". No parsing in the ROM (sense-gate.tal:8-11
# boundary) — the meaning is decided here. The Note3 has NO TERMUX AT ALL (checked, not
# assumed: /data/data/com.termux does not exist and no sshd runs), so every read this tool
# makes is termux-independent by construction, which is the whole point of the ROM.
#
#   mesh-note3-uxn-sense            -> "load1 load5 load15"
#   mesh-note3-uxn-sense --raw      -> the tagged line verbatim
#   mesh-note3-uxn-sense --ensure   -> make the listener exist AND answer (adb only)
#   mesh-note3-uxn-sense --keep     -> the reflex: ensure + one gated read + state artifact
#   mesh-note3-uxn-sense --test     -> assert a REAL read (exit 0/1/2). Does NOT ensure.
#
# Exit: 0 = a gated, fresh read
#       1 = the organ is PRESENT and the read is not real (hollow lane, or a dead listener
#           the keeper should have restarted) -- a RED
#       2 = the organ is AWAY (no adb, or the phone is not attached) -- honest n/a
#
# --test DELIBERATELY DOES NOT CALL --ensure. A test that repairs what it measures can
# never be seen fail, and this one has to be seen fail: with the listener stopped and the
# phone still attached it must go RED (1), not n/a (2). "Phone away" and "lane dead on a
# phone that is right here" are different claims and the keeper only answers for the second.
#
# WHY /proc/loadavg AND NOT AN ACCELEROMETER. Measured on this phone 2026-08-19, both ways:
#   * /sys/class/sensors/accelerometer_sensor/raw_data reads -32768,32767,<z> -- x and y are
#     pinned at INT16_MIN/MAX, i.e. the +-2g rails, corroborated through the native HAL
#     (sensorcat: -19.6133|19.6127 m/s2 = 2 * 9.80665). Two of three axes are dead hardware.
#   * EVERY node under /sys/class/sensors is a LATCH, not a stream: light_sensor/raw_data
#     held "10,3,1,376,0,0" bit-identical across 8 reads / 8s, magnetic_sensor/raw_data reads
#     the "-1,-1,-1" driver no-data sentinel, and the accel's z only advances when some HAL
#     listener is enabled. A sequence of those values is not motion and must never be read
#     as motion. (mesh-note3-uxn-accel carries the full measurement and stays deliberately
#     un-cadenced for exactly this reason.)
#   * /proc/loadavg is computed by the kernel ON READ. Measured: 0 identical consecutive
#     pairs in 9 reads 2s apart. It carries THREE numeric axes (1/5/15-minute load), which
#     is what makes it a fair replacement for the 3-axis read this lane was built for, and
#     unlike the sensor hub it cannot serve a stale cache.
#
# THE GATE ASSERTS THE PAYLOAD, NEVER REACHABILITY. The failure this lane is built to hide
# is a listener that is UP and returning ZERO bytes -- which is exactly what a cwd other
# than / produces, silently, because the file device's sandbox then admits no absolute path
# (sysfs-serve.tal:13-15). Reachable-and-empty is the mag/gyro hollow-sense shape. So a
# reply only counts if it parses as loadavg: three floats, a running/total pair, a last-PID,
# and a SECOND read >=2.5s later that DIFFERS from the first.

set -u

HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
UXN_CLI="${UXN_CLI:-$HERE/bin/uxncli}"
NET_ECHO="${NET_ECHO:-$HERE/net-echo.rom}"
ROM_SRC="${ROM_SRC:-$HERE/sysfs-serve.rom}"

IP="${IP:-127.0.0.1}"
PORT="${PORT:-47321}"
SERVE_PATH="${SERVE_PATH:-/proc/loadavg}"
TAG='uxn:'
ADB_SERIAL="${MESH_NOTE3_ADB_SERIAL:-${MESH_BARO_ADB_SERIAL:-4d00553d61ab90b7}}"
PHONE_TMP="${PHONE_TMP:-/data/local/tmp}"
STATE="${STATE:-$HOME/.mesh/.note3-uxn-sense.state}"

# ONE ROM COPY PER PORT, and it is not cosmetic. Two listeners have to coexist (this one and
# mesh-note3-uxn-accel's), the phone's toolbox `ps` prints only the exe and never argv, and
# passing an extra argv to uxncli is not an option -- uxncli.c:59-62 feeds extra arguments
# into the ROM's console, which is the same stream this ROM reads its bind address from, and
# also flips system_boot's sandbox-override flag. So the port has to be in the ROM's own
# FILENAME for /proc/<pid>/cmdline to identify which listener is which.
PHONE_ROM="$PHONE_TMP/uxn-serve-$PORT.rom"
PHONE_IN="$PHONE_TMP/uxn-in-$PORT.txt"
PHONE_LOG="$PHONE_TMP/uxn-serve-$PORT.log"

# EVERY adb call is time-boxed. `adb shell "... &"` does NOT return on its own: adb keeps
# the connection open while the backgrounded child holds the remote shell's stdout, so an
# unbounded spawn hangs the caller forever -- and a keeper that hangs is worse than one that
# fails, because cron then stacks copies of it. Measured here 2026-08-19: --ensure sat past
# 120s on exactly that call.
adb_() { timeout "${ADB_TIMEOUT:-20}" adb -s "$ADB_SERIAL" "$@"; }

# THE ROM'S PATH BUFFER IS 128 BYTES AND ITS CONSOLE READER IS UNBOUNDED (sysfs-serve.tal,
# @path-buf). An over-long path does not error, it runs off the end of the buffer into the
# next one, gets overwritten by the first drain's recv, and every later serve re-opens a
# corrupted filename and returns ZERO bytes -- a listener that is up, reachable, and empty.
# Refuse it here, loudly, instead of shipping that silence to the phone.
[ ${#SERVE_PATH} -le 120 ] || {
    echo "mesh-note3-uxn-sense: refusing SERVE_PATH (${#SERVE_PATH} bytes) — the ROM's path buffer is 128 bytes and its reader does not bound-check; a longer path silently serves zero bytes" >&2
    exit 64; }

phone_here() {
    command -v adb >/dev/null 2>&1 || return 1
    [ "$(adb_ get-state 2>/dev/null)" = "device" ] || return 1
}

# one dial. echoes the tagged line on success, nothing on failure.
dial() {
    local out
    out="$(printf 'tcp:%s:%s\nq\n' "$IP" "$PORT" \
        | UXN_NET_TIMEOUT="${UXN_NET_TIMEOUT:-4}" "$UXN_CLI" "$NET_ECHO" 2>/dev/null)"
    # success is the TAG, not non-empty output: net-echo prints "NA" on a refused connect,
    # which is non-empty and is a failure.
    case "$out" in "$TAG"*) printf '%s\n' "$out"; return 0 ;; esac
    return 1
}

# the payload with the tag and trailing whitespace stripped.
payload() {
    local line i
    for i in 1 2 3; do
        line="$(dial)" && break
        line=""
        sleep 0.3
    done
    [ -n "$line" ] || return 1
    line="${line#$TAG}"
    line="${line%$'\r'}"
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    printf '%s\n' "$line"
}

# gate: is this /proc/loadavg, or is it something a broken lane produced?
# echoes a reason on failure. Structure alone kills the zero-byte read, the wrong-path read
# and any stray echo; the caller adds the freshness leg on top.
gate() {
    local p="$1" l1 l5 l15 rt lastpid rest run tot v
    read -r l1 l5 l15 rt lastpid rest <<<"$p"
    if [ -z "${lastpid:-}" ] || [ -n "${rest:-}" ]; then
        echo "not 5 loadavg fields (got: '$p') — a zero-byte read (cwd != / on the phone?) or the wrong served path"
        return 1
    fi
    for v in "$l1" "$l5" "$l15"; do
        printf '%s' "$v" | grep -qE '^[0-9]+\.[0-9]+$' || {
            echo "load axis '$v' is not a decimal (got: '$p')"; return 1; }
    done
    printf '%s' "$rt" | grep -qE '^[0-9]+/[0-9]+$' || {
        echo "field 4 '$rt' is not running/total (got: '$p')"; return 1; }
    run="${rt%%/*}"; tot="${rt##*/}"
    # the kernel counts the reader itself, so running is never 0 and total never below it.
    [ "$run" -ge 1 ] && [ "$tot" -ge "$run" ] || {
        echo "running/total '$rt' is impossible — the reading process is itself running"; return 1; }
    printf '%s' "$lastpid" | grep -qE '^[0-9]+$' || {
        echo "last-PID '$lastpid' is not an integer (got: '$p')"; return 1; }
    [ "$lastpid" -ge 1 ] || { echo "last-PID $lastpid < 1 (got: '$p')"; return 1; }
    return 0
}

ensure() {
    phone_here || { echo "n/a — note3 $ADB_SERIAL not attached (no adb path)"; return 2; }
    # the forward first: without it a dial cannot even reach a healthy listener.
    adb_ forward "tcp:$PORT" "tcp:$PORT" >/dev/null 2>&1 || {
        echo "n/a — adb forward tcp:$PORT failed"; return 2; }
    # A LIVE LISTENER IS ONE THAT ANSWERS, not one that appears in ps. `ps` cannot tell the
    # two listeners on this phone apart (no argv), and a ROM wedged mid-accept holds its
    # socket open while every read times out. So the probe is a real dial.
    if dial >/dev/null 2>&1; then return 0; fi
    # Not answering. Anything still bound to this port must go first, or the replacement
    # dies "Address already in use" while the OLD process keeps serving into the SAME log
    # -- two processes' lines interleaved is how a bind conflict gets misread as a wedge.
    local pids p cmd
    pids="$(adb_ shell 'ps' 2>/dev/null | tr -d '\r' | grep uxncli | grep -v grep | awk '{print $2}')"
    for p in $pids; do
        cmd="$(adb_ shell "cat /proc/$p/cmdline" 2>/dev/null | tr -d '\0\r')"
        case "$cmd" in *"uxn-serve-$PORT.rom") adb_ shell "su -c 'kill -9 $p'" >/dev/null 2>&1 ;; esac
    done
    adb_ push "$ROM_SRC" "$PHONE_ROM" >/dev/null 2>&1 || {
        echo "n/a — could not push $ROM_SRC to the phone"; return 2; }
    # stdin comes from a FILE, not a pipe: the Note3's /system/bin/sh has no printf, and the
    # ROM needs BOTH lines (bind address, then served path) before it binds.
    # cwd MUST be / -- otherwise the file sandbox admits no absolute path and the ROM streams
    # ZERO bytes with no error at all.
    adb_ shell "echo 'tcp:127.0.0.1:$PORT' > $PHONE_IN; echo '$SERVE_PATH' >> $PHONE_IN; rm -f $PHONE_LOG" >/dev/null 2>&1
    # the spawn itself never returns (see adb_ above), so it is fired with a short deadline
    # and its exit code is meaningless -- the ONLY evidence that counts is the dial below.
    ADB_TIMEOUT=6 adb_ shell "cd / && nohup $PHONE_TMP/uxncli $PHONE_ROM < $PHONE_IN > $PHONE_LOG 2>&1 &" >/dev/null 2>&1
    sleep 1
    # END ON A REAL DIAL. `adb forward` returning 0 is not "the listener serves" -- it
    # succeeds against a phone with nothing bound at all.
    dial >/dev/null 2>&1 || {
        echo "n/a — listener started but does not answer; phone log: $PHONE_LOG"; return 2; }
    return 0
}

# read + gate + freshness. echoes the payload on success; a reason on failure.
# rc 0 ok · 1 present-but-not-real · 2 away
gated_read() {
    local p1 p2 why
    p1="$(payload)" || {
        if phone_here; then
            echo "the note3 is attached but the listener at $IP:$PORT does not answer — the lane is DEAD, not away"
            return 1
        fi
        echo "note3 $ADB_SERIAL not attached"
        return 2
    }
    why="$(gate "$p1")" || { echo "$why"; return 1; }
    # FRESHNESS. Structure cannot see a latch: a stale cache re-served forever parses
    # perfectly. /proc/loadavg is computed on read, so two reads 2.5s apart must differ --
    # measured 0/9 identical pairs at 2s on this phone. One retry, because a single
    # coincidence should not turn a live lane red.
    sleep 2.5
    p2="$(payload)" || { echo "the second read did not come back (lane died mid-test)"; return 1; }
    if [ "$p1" = "$p2" ]; then
        sleep 2.5
        p2="$(payload)" || { echo "the third read did not come back (lane died mid-test)"; return 1; }
    fi
    if [ "$p1" = "$p2" ]; then
        echo "FROZEN — two reads 2.5s apart are byte-identical ('$p1'). /proc/loadavg is computed on read, so this is a latched or replayed payload, not a live one"
        return 1
    fi
    printf '%s\n' "$p2"
    return 0
}

case "${1:-}" in
    --ensure)
        out="$(ensure)"; rc=$?
        [ $rc -eq 0 ] || { echo "$out"; exit $rc; }
        echo "note3-uxn-sense: listener up on $ADB_SERIAL serving $SERVE_PATH, forwarded to $IP:$PORT"
        exit 0 ;;
    --raw)
        r="$(dial)" || { echo "n/a — listener at $IP:$PORT unreachable"; exit 2; }
        printf '%s\n' "$r"; exit 0 ;;
    --keep)
        out="$(ensure)"; rc=$?
        if [ $rc -ne 0 ]; then echo "note3-uxn-sense: $out"; exit $rc; fi
        out="$(gated_read)"; rc=$?
        if [ $rc -ne 0 ]; then echo "note3-uxn-sense: $out"; exit $rc; fi
        read -r l1 l5 l15 _ <<<"$out"
        mkdir -p "$(dirname "$STATE")"
        printf '%s load1=%s load5=%s load15=%s src=%s via=uxn/tcp:%s\n' \
            "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$l1" "$l5" "$l15" "$SERVE_PATH" "$PORT" > "$STATE"
        command -v mesh-state-touch >/dev/null 2>&1 && mesh-state-touch "$STATE" >/dev/null 2>&1
        echo "note3-uxn-sense: $l1 $l5 $l15 (live, gated, via uxn/TCP — no termux, no ssh)"
        exit 0 ;;
    --test)
        # No --ensure here, on purpose: see the header. Stop the listener with the phone
        # still plugged in and this must print FAIL and exit 1.
        out="$(gated_read)"; rc=$?
        case $rc in
            0) read -r l1 l5 l15 rt lastpid <<<"$out"
               echo "note3-uxn-sense: live read OK — load $l1 $l5 $l15 (3 live axes), procs $rt, last-pid $lastpid, from $SERVE_PATH over uxn/TCP with no termux and no ssh on the phone"
               exit 0 ;;
            2) echo "note3-uxn-sense: n/a — $out (organ AWAY, not a dead reflex)"; exit 2 ;;
            *) echo "note3-uxn-sense: FAIL — $out"; exit 1 ;;
        esac ;;
    ""|--read)
        out="$(gated_read)"; rc=$?
        [ $rc -eq 0 ] || { echo "n/a — $out"; exit $rc; }
        read -r l1 l5 l15 _ <<<"$out"
        printf '%s %s %s\n' "$l1" "$l5" "$l15"; exit 0 ;;
    *) echo "usage: $0 [--ensure|--read|--raw|--keep|--test]   (env: IP PORT SERVE_PATH UXN_CLI NET_ECHO)"; exit 64 ;;
esac
