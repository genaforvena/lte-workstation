#!/usr/bin/env bash
# mesh-band-gate — host shim for band-gate.rom (Uxn pilot, 2nd gate CLASS).
#
# A compound BOUNDARY predicate: a value is healthy only INSIDE [lo, hi] and RED past EITHER edge.
# The GATE LOGIC (both comparisons) lives in the byte-identical ROM; this shim is I/O only —
# it marshals three integers in and maps the ROM's OK/RED verdict to exit 0/1.
#
# usage:  mesh-band-gate <lo> <value> <hi>       # gate a raw triple
#         mesh-band-gate --name <val> <fixtures>  # resolve [lo hi] for <name>'s row, gate <val>
# exit:   0 = OK (value within band)   1 = RED (outside band)   2 = usage/unresolved
set -eu
here="$(cd "$(dirname "$0")" && pwd)"
ROM="${MESH_BAND_ROM:-$here/band-gate.rom}"
UXNCLI="${MESH_UXNCLI:-$here/bin/uxncli}"
[ -x "$UXNCLI" ] || { echo "mesh-band-gate: no uxncli — run $here/build.sh" >&2; exit 2; }
[ -f "$ROM" ]    || { echo "mesh-band-gate: no $ROM — run $here/build.sh (assemble band-gate.tal)" >&2; exit 2; }

if [ "${1:-}" = --name ]; then
  name="${2:?name}"; val="${3:?value}"; fix="${4:?fixtures}"
  row="$(grep -E "^[[:space:]]*${name}[[:space:]]" "$fix" 2>/dev/null | grep -vE '^\s*#' | head -1)"
  [ -n "$row" ] || { echo "mesh-band-gate: $name not in $fix" >&2; exit 2; }
  lo="$(printf '%s\n' "$row" | awk '{print $2}')"
  hi="$(printf '%s\n' "$row" | awk '{print $3}')"
else
  lo="${1:?usage: mesh-band-gate <lo> <value> <hi>}"; val="${2:?value}"; hi="${3:?hi}"
fi

verdict="$("$UXNCLI" "$ROM" "$lo" "$val" "$hi" 2>/dev/null | tr -d '[:space:]')"
if [ "$verdict" = OK ]; then
  echo "band-gate: OK   (${lo} <= ${val} <= ${hi})"; exit 0
else
  echo "band-gate: RED  (${val} outside [${lo}, ${hi}])" >&2; exit 1
fi
