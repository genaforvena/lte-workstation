( net-ident.tal — emit the net device's IDENTIFY word as 4 hex chars + newline. )
(                                                                                        )
( THE DRIFT PROBE. The emulator answers action d0 Identify by poking NET_IDENT into the )
( length register (net.h: #define NET_IDENT 0xd002); a device-less page reads back the )
( zero this ROM writes there first. net-echo/net-listen compare that word as an ORDERING )
( so a travelling ROM keeps working across steps — but nothing on the HOST compares the )
( running binary's version against the version its SOURCE declares. A binary left un-rebuilt )
( after a NET_IDENT bump answers the OLD step: too-old fails CLOSED (net-listen refuses) )
( but byte-identical to a plain refused link — the silent-drift hole minds named. )
(                                                                                        )
( This ROM prints the RAW word so a host detector (mesh-uxn-drift) can diff it against the )
( source define. It makes no judgement: "d002" = present-at-step-2, "0000" = no device. )
(                                                                                        )
( output: 4 lowercase hex chars + newline, halt rc 0. )

|0100
    #0000 #d4 DEO2          ( clear the length register: a device-less page reads this back )
    #d0 #da DEO             ( action d0 Identify — only the DEVICE answers )
    #d4 DEI ;emitbyte JSR2  ( high byte: d0 present, or 00 device-less )
    #d5 DEI ;emitbyte JSR2  ( low byte:  the STEP, or 00 )
    #0a #18 DEO             ( newline )
    #80 #0f DEO             ( halt, exit 0 — the word is the output; the host judges it )
    BRK

( emitbyte: print a byte as two lowercase hex nibbles. )
@emitbyte ( b -- )
    DUP #04 SFT ;emitnib JSR2   ( high nibble: b >> 4 )
    #0f AND ;emitnib JSR2       ( low nibble:  b & 0f )
    JMP2r

( emitnib: 0..15 -> ascii hex char, print to console. )
@emitnib ( n -- )
    DUP #0a LTH ,&dig JCN
    #57 ADD ,&out JMP           ( a-f: 0x61 + (n-10) = 0x57 + n )
    &dig #30 ADD                ( 0-9: 0x30 + n )
    &out #18 DEO
    JMP2r
