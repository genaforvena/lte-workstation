#!/usr/bin/env bash
# test-chibicc — the vendor gate for scripts/uxn/chibicc/ (uxn-chibicc-vendor, spec 2026-07-23 §4).
#
# CONTRACT: the vendored compiler rebuilds lease-gate-c.rom from chibicc-eval/lease-gate.c and the
# fresh ROM matches the 5-row truth table (byte-identity with the committed ROM is reported as a
# bonus, never the gate — chibicc output may legitimately drift a byte across hosts; the TRUTH
# TABLE is the contract). RED-first: a copy of the source with the one load-bearing comparison
# flipped (>= → <) must FAIL the same table — proves the table discriminates, not decorates.
# Verdicts run through mesh-rom-gate (the one runner) — this also covers its explicit-path form.
set -u
here="$(cd "$(dirname "$0")" && pwd)"
cd "$here"
command -v "${CC:-cc}" >/dev/null 2>&1 || { echo "chibicc-test: n/a (no host cc)" >&2; exit 2; }
[ -x bin/uxncli ] || ./build.sh >/dev/null 2>&1 || { echo "chibicc-test: n/a (toolchain build failed)" >&2; exit 2; }
ROM_GATE="${MESH_ROM_GATE:-$(cd "$here/.." && pwd)/mesh-rom-gate}"
[ -x "$ROM_GATE" ] || { echo "chibicc-test: FAIL (no mesh-rom-gate at $ROM_GATE)"; exit 1; }
rc=0
tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT

./cc-rom.sh chibicc-eval/lease-gate.c "$tmp/lease-gate-c.rom" >/dev/null 2>&1 \
  || { echo "chibicc-test: FAIL (cc-rom.sh could not rebuild lease-gate-c.rom from vendored chibicc)"; exit 1; }

# The 5-row truth table (chibicc-eval/EVAL.md): boundary inclusive at lease == 2*cadence.
table(){ # $1=rom → prints FAILing rows, returns nonzero if any
  local rom="$1" bad=0 row v want
  while read -r a b want; do
    v="$(MESH_UXN_DIR="$here" "$ROM_GATE" "$rom" "$a" "$b" 2>/dev/null)" || true
    [ "$v" = "$want" ] || { echo "  row $a $b → want $want got '${v:-}'"; bad=1; }
  done <<'ROWS'
900 1800 OK
900 1799 RED
900 1801 OK
900 900 RED
60 3600 OK
ROWS
  return $bad
}

if table "$tmp/lease-gate-c.rom"; then
  echo "PASS: vendored chibicc rebuild matches the 5-row truth table"
else
  echo "FAIL: fresh lease-gate-c.rom violates the truth table"; rc=1
fi

# Byte-identity bonus (informational only — the contract is the table above).
if cmp -s "$tmp/lease-gate-c.rom" chibicc-eval/lease-gate-c.rom; then
  echo "info: byte-identical with the committed chibicc-eval/lease-gate-c.rom"
else
  echo "info: differs from committed ROM ($(wc -c <"$tmp/lease-gate-c.rom")b vs $(wc -c <chibicc-eval/lease-gate-c.rom)b) — allowed, table is the contract"
fi

# RED-first: flip the load-bearing comparison; the SAME table must now fail.
sed 's/lease >= 2 \* cad/lease < 2 * cad/' chibicc-eval/lease-gate.c > "$tmp/broken.c"
grep -q 'lease < 2 \* cad' "$tmp/broken.c" || { echo "FAIL: red-first mutation did not apply (source drifted?)"; rc=1; }
./cc-rom.sh "$tmp/broken.c" "$tmp/broken.rom" >/dev/null 2>&1 || { echo "FAIL: broken-source rebuild errored (should compile, just answer wrong)"; rc=1; }
if [ -f "$tmp/broken.rom" ] && table "$tmp/broken.rom" >/dev/null; then
  echo "FAIL: truth table passed a ROM with the comparison INVERTED — table asserts nothing"; rc=1
else
  echo "PASS: inverted-comparison ROM fails the table (gate seen RED)"
fi

# Vendor pin: the provenance comment in build.sh is a CLAIM; chibicc/VENDOR-MANIFEST is the
# artifact — per-file sha256 under the recorded upstream sha. A silent local patch to the
# vendored compiler (or a lost/added file) must go RED here or "vendored at ba7944d" lies green.
manifest_check(){ # $1=tree-dir → 0 clean, 1 drift (diff on stdout)
  (cd "$1" && find . -type f ! -name VENDOR-MANIFEST -print0 | sort -z | xargs -0 sha256sum) > "$tmp/computed"
  grep -v '^#' "$1/VENDOR-MANIFEST" | diff - "$tmp/computed"
}
if [ -f chibicc/VENDOR-MANIFEST ]; then
  grep -qE '^# upstream: .+ @ [0-9a-f]{40}$' chibicc/VENDOR-MANIFEST \
    || { echo "FAIL: VENDOR-MANIFEST carries no upstream sha line"; rc=1; }
  if manifest_check chibicc >/dev/null; then
    echo "PASS: vendored tree matches VENDOR-MANIFEST (pin holds)"
  else
    echo "FAIL: vendored chibicc tree drifted from VENDOR-MANIFEST — re-pin deliberately or revert:"
    manifest_check chibicc | head -5; rc=1
  fi
  # RED-first: a tampered copy of the tree must fail the same check.
  cp -r chibicc "$tmp/vendor"
  printf '\n' >> "$tmp/vendor/src/codegen.c"
  if manifest_check "$tmp/vendor" >/dev/null; then
    echo "FAIL: manifest check passed a TAMPERED tree — pin asserts nothing"; rc=1
  else
    echo "PASS: tampered vendor copy fails the manifest (pin seen RED)"
  fi
else
  echo "FAIL: no chibicc/VENDOR-MANIFEST — the vendor is unpinned"; rc=1
fi

[ "$rc" = 0 ] && echo "chibicc-test: ok" || echo "chibicc-test: FAIL"
exit $rc
