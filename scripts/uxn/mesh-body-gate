#!/usr/bin/env bash
# mesh-body-gate — the body node gates ITSELF (uxn-hop-body-gate, stage 4c, 2026-07-24).
#
# First real mesh-uxn-hop consumer outside scripts/uxn: reads the phone's OWN sysfs values
# (battery capacity, battery temp deci-°C), substitutes them into threshold-ledger rows
# (mesh-sexpr-gate --expr — the numbers live in the ledger, not here), packs the PINNED
# lisp-eval.rom + expression as an argv packet (mesh-uxn-hop --pack-argv), and runs the
# packet ON the body under busybox sh + the on-device uxncli. The verdict is computed by
# byte-identical fleet logic at the execution site; recalibration is a consts diff in
# threshold-ledger travelling in-band on the next run — the phone is never edited.
#
# Pin chain (hash-then-execute, end to end): ledger `# evaluator-sha1:` == the ROM packed
# here == the sha1 the RECEIVER verifies before executing == the stamp that comes back.
# Any link broken = loud rc 2, never a wrapped verdict.
#
# gates: battery-charge (cap → 0 CRIT · 1 LOW · 2 OK)
#        body-thermal   (t=deci-°C, p=prev verdict → 0 COOL · 1 NORMAL · 2 WARM · 3 HOT;
#                        p seeds from the state file's last body-thermal line, 9 = seed ladder)
#
# usage: mesh-body-gate          one round, verdict lines to stdout + appended to state
#        mesh-body-gate --test   suite (test-body-gate; writes NO live state)
# exit:  0 verdicts rendered · 2 honest n/a LOUD (no adb body / on-device organ absent /
#        hollow read / pin break) — n/a is a claim about the node, never a fake verdict
# state: ~/.mesh/body-gate.state (append every run: mtime IS liveness, content the verdicts)
# env:   MESH_BODY_GATE_ROM · MESH_BODY_GATE_STATE · MESH_BODY_ADB_SERIAL · MESH_BODY_GATE_DIR
#        MESH_BODY_SSH=user@host[:port] — reach the body over SSH instead of adb
#
# TRANSPORT (transport split, 2026-07-24). A body is whatever runs the packet, and the mesh's
# bodies do NOT agree on how to be reached: the Note3 speaks adb and has no ssh at all, while
# every Termux body speaks ssh and has its adb ports shut (the Redmi: sshd up on :8022, 5555/
# 42939/5037 all closed). A gate hardwired to one transport can only ever reach half of them —
# which is why cloning this gate onto the next phone was blocked on the tool, not just on a key.
# The two differ in more than the dial: an Android /system/bin has no POSIX userland, so the adb
# lane bootstraps busybox applets and runs `busybox sh`; an ssh body (Termux, or any POSIX node)
# already has sh/dd/mktemp/sha1sum and must NOT have busybox forced on it.
set -u
here="$(cd "$(dirname "$0")" && pwd)"
ROM="${MESH_BODY_GATE_ROM:-$here/lisp-eval.rom}"
STATE="${MESH_BODY_GATE_STATE:-$HOME/.mesh/body-gate.state}"
LEDGER="${MESH_BODY_GATE_LEDGER:-$here/threshold-ledger}"
D="${MESH_BODY_GATE_DIR:-/data/local/tmp}"

[ "${1:-}" = --test ] && exec "$here/test-body-gate"

na(){ echo "mesh-body-gate: n/a — $*" >&2; exit 2; }

BODY_SSH="${MESH_BODY_SSH:-}"
if [ -n "$BODY_SSH" ]; then
  TRANSPORT=ssh
  case "$BODY_SSH" in *:*) SSH_PORT="${BODY_SSH##*:}"; SSH_DEST="${BODY_SSH%:*}" ;;
                      *)   SSH_PORT=22;                SSH_DEST="$BODY_SSH" ;; esac
  case "$SSH_PORT" in ''|*[!0-9]*) na "MESH_BODY_SSH port is not a number: '$BODY_SSH'" ;; esac
else
  TRANSPORT=adb
fi
SSH_OPTS=(-p "${SSH_PORT:-22}" -o BatchMode=yes -o ConnectTimeout=8 -o StrictHostKeyChecking=accept-new)

adbsh(){
  if [ -n "${MESH_BODY_ADB_SERIAL:-}" ]; then adb -s "$MESH_BODY_ADB_SERIAL" shell "$@"
  else adb shell "$@"; fi
}
adbpush(){
  if [ -n "${MESH_BODY_ADB_SERIAL:-}" ]; then adb -s "$MESH_BODY_ADB_SERIAL" push "$@"
  else adb push "$@"; fi
}
# bodysh/bodypush — the ONE seam the rest of this file talks through. Every call site below used
# to name adb directly; naming a transport at four sites is four places to forget one.
bodysh(){
  case "$TRANSPORT" in
    ssh) timeout 30 ssh "${SSH_OPTS[@]}" "$SSH_DEST" "$@" ;;
    *)   adbsh "$@" ;;
  esac
}
bodypush(){ # <local> <remote>
  case "$TRANSPORT" in
    ssh) timeout 60 scp -P "$SSH_PORT" -o BatchMode=yes -o ConnectTimeout=8 \
           -o StrictHostKeyChecking=accept-new -- "$1" "$SSH_DEST:$2" ;;
    *)   adbpush "$1" "$2" ;;
  esac
}

# pack-site hash-then-execute: the ROM we are about to SHIP must be the ledger's evaluator.
[ -f "$ROM" ] || na "no evaluator ROM at $ROM"
pin="$(MESH_SEXPR_GATES="$LEDGER" "$here/mesh-sexpr-gate" --pin)" || na "no evaluator pin in $LEDGER"
actual="$(sha1sum -- "$ROM" | cut -d' ' -f1)"
[ "$actual" = "$pin" ] || na "ROM/pin mismatch: $ROM is $actual, ledger pins $pin — refusing to ship"

if [ "$TRANSPORT" = ssh ]; then
  command -v ssh >/dev/null || na "no ssh on this node"
  bodysh true </dev/null >/dev/null 2>&1 || na "ssh body '$BODY_SSH' unreachable (key not authorized, or sshd down)"
  # an ssh body's sandbox lives in ITS home, not in Android's /data/local/tmp — resolve it there
  # rather than assuming, so Termux and an ordinary POSIX node both land somewhere writable
  if [ -z "${MESH_BODY_GATE_DIR:-}" ]; then
    D="$(bodysh 'printf %s "$HOME"' </dev/null | tr -d '\r')/.mesh-body"
    [ "$D" != "/.mesh-body" ] || na "ssh body did not report a HOME"
    bodysh "mkdir -p '$D'" </dev/null >/dev/null 2>&1 || na "cannot create $D on the ssh body"
  fi
else
  command -v adb >/dev/null || na "no adb on this node"
  if [ -n "${MESH_BODY_ADB_SERIAL:-}" ]; then
    adb -s "$MESH_BODY_ADB_SERIAL" get-state >/dev/null 2>&1 || na "adb body '$MESH_BODY_ADB_SERIAL' unreachable"
  else
    adb get-state >/dev/null 2>&1 || na "no adb body attached"
  fi
fi

# on-device organs (absence is honest n/a, never a fabricated verdict). The emulator is the only
# thing BOTH transports require; busybox is Android's problem alone.
CLI="${MESH_BODY_UXNCLI:-}"
if [ "$TRANSPORT" = ssh ]; then
  [ -n "$CLI" ] || CLI="$D/uxncli"
  bodysh "[ -x '$CLI' ]" </dev/null >/dev/null 2>&1 \
    || na "ssh body lacks an executable uxncli at $CLI (cross-build for its arch and push it)"
  # a POSIX body already HAS the userland the receiver needs; assert it rather than assume, so a
  # stripped-down box says which tool is missing instead of failing deep inside the receiver
  bodysh "for t in sh dd mktemp sha1sum dirname; do command -v \$t >/dev/null || { echo \$t; exit 1; }; done" \
    </dev/null >/dev/null 2>&1 || na "ssh body lacks POSIX userland (sh/dd/mktemp/sha1sum/dirname)"
  RUNNER="sh mesh-uxn-hop"
else
  [ -n "$CLI" ] || CLI="$D/uxncli-new"
  adbsh "[ -x $D/busybox ] && [ -x $CLI ]" >/dev/null 2>&1 \
    || na "body lacks $D/busybox or $CLI (run scripts/uxn/verify-note3.sh)"
  # the receiver needs POSIX userland (dirname/mktemp/dd/sha1sum) — Android's /system/bin has
  # none of it, so materialize busybox's applets once and run with them on PATH
  adbsh "[ -x $D/bb/sha1sum ] || { $D/busybox mkdir -p $D/bb && $D/busybox --install -s $D/bb; }" >/dev/null 2>&1
  adbsh "[ -x $D/bb/sha1sum ] && [ -x $D/bb/dd ] && [ -x $D/bb/mktemp ]" >/dev/null 2>&1 \
    || na "cannot materialize busybox applets at $D/bb"
  RUNNER="PATH=$D/bb:\$PATH ./busybox sh mesh-uxn-hop"
fi

# the receiver is the SAME POSIX script that runs here — push only when its hash drifts
want="$(sha1sum -- "$here/mesh-uxn-hop" | cut -d' ' -f1)"
if [ "$TRANSPORT" = ssh ]; then SUM="sha1sum"; else SUM="$D/busybox sha1sum"; fi
got="$(bodysh "$SUM $D/mesh-uxn-hop 2>/dev/null" </dev/null | tr -d '\r' | cut -d' ' -f1)"
if [ "$got" != "$want" ]; then
  bodypush "$here/mesh-uxn-hop" "$D/mesh-uxn-hop" >/dev/null 2>&1 || na "cannot push receiver to body"
  got="$(bodysh "$SUM $D/mesh-uxn-hop" </dev/null | tr -d '\r' | cut -d' ' -f1)"
  [ "$got" = "$want" ] || na "receiver on body still drifts after push ($got != $want)"
fi

read_sys(){ # $1=path → trimmed value, empty on failure
  bodysh "cat $1 2>/dev/null" </dev/null | tr -d '\r[:space:]'
}
natural(){ case "${1:-}" in ''|*[!0-9]*) return 1 ;; *) return 0 ;; esac; }

# real reads off the body's own sensors — a reachable phone answering empty is a HOLLOW
# sense, loud n/a, never a default (the silent-fallback doctrine)
# the sysfs paths are overridable because BODIES DISAGREE about them (some Androids expose the
# fuel gauge as .../bms/ or .../battery_0/, not .../battery/) — and an unreadable default would
# otherwise be indistinguishable from a phone with no battery. An override does NOT soften the
# read: whatever path is named must still answer a natural number or the run is a loud n/a.
CAP_PATH="${MESH_BODY_CAP_PATH:-/sys/class/power_supply/battery/capacity}"
TEMP_PATH="${MESH_BODY_TEMP_PATH:-/sys/class/power_supply/battery/temp}"
cap="$(read_sys "$CAP_PATH")"
natural "$cap" || na "hollow battery capacity read from $CAP_PATH: '$cap'"
temp="$(read_sys "$TEMP_PATH")"
natural "$temp" || na "hollow battery temp read from $TEMP_PATH: '$temp'"

# prev thermal verdict from our own state file; 9 = out-of-band → the row's seed ladder
prev="$(grep ' body-thermal ' "$STATE" 2>/dev/null | tail -1 | sed -n 's/.* verdict=\([0-9]\).*/\1/p')"
natural "${prev:-}" || prev=9

run_gate(){ # $1=gate, rest=args → verdict on stdout; asserts the returned stamp == pin
  local gate="$1"; shift
  local expr pkt out verdict stamp
  expr="$(MESH_SEXPR_GATES="$LEDGER" "$here/mesh-sexpr-gate" --expr "$gate" "$@")" \
    || na "cannot build expression for $gate"
  pkt="$(mktemp "${TMPDIR:-/tmp}/body-gate.XXXXXX")"
  printf '%s' "$expr" | "$here/mesh-uxn-hop" --pack-argv "$ROM" >"$pkt" \
    || { rm -f "$pkt"; na "pack failed for $gate"; }
  bodypush "$pkt" "$D/body-gate.pkt" >/dev/null 2>&1 || { rm -f "$pkt"; na "cannot push packet"; }
  rm -f "$pkt"
  # The stamp is written to the execution site's STDERR, and the two transports disagree about
  # where that lands: Android <8 adb merges stderr into stdout (and CRLFs it), ssh keeps them
  # apart — so the ssh lane came back with a verdict and NO stamp, i.e. an untrusted verdict, on
  # its first live run. Merge on the REMOTE side (inside the command) rather than around bodysh,
  # which would fold this node's own ssh chatter into the body's answer. Either way we demux by
  # shape: the verdict is the pure digits/NA line, the stamp the 'hop: rom sha1=…' line.
  # UXN_HOP_CLI must be ABSOLUTE — the receiver cds into its fresh sandbox before exec
  out="$(bodysh "cd $D && TMPDIR=$D UXN_HOP_CLI=$CLI UXN_HOP_STAMP=1 $RUNNER < body-gate.pkt 2>&1" </dev/null | tr -d '\r')"
  verdict="$(printf '%s\n' "$out" | grep -E '^([0-9]+|NA)$' | tail -1)"
  stamp="$(printf '%s\n' "$out" | sed -n 's/^hop: rom sha1=\([0-9a-f]\{40\}\).*/\1/p' | tail -1)"
  [ -n "$stamp" ]        || na "$gate: no execution stamp came back (body ran nothing?): $(printf '%s' "$out" | head -c 120)"
  [ "$stamp" = "$pin" ]  || na "$gate: body executed sha1 $stamp, ledger pins $pin — verdict untrusted"
  [ -n "$verdict" ]      || na "$gate: no verdict from body (a mute gate is breakage): $(printf '%s' "$out" | head -c 120)"
  printf '%s\n' "$verdict"
}

ts="$(date -u +%FT%TZ)"
# na() inside $( ) exits only the subshell — propagate its rc HERE or a refused gate
# would land in the state file as verdict='' (caught RED by test-body-gate leg 3).
v_bat="$(run_gate battery-charge "$cap")"      || exit $?
v_thm="$(run_gate body-thermal "$temp" "$prev")" || exit $?

mkdir -p "$(dirname "$STATE")"
{
  printf '%s battery-charge cap=%s verdict=%s src=rom-body sha1=%s\n' "$ts" "$cap" "$v_bat" "$pin"
  printf '%s body-thermal t=%s p=%s verdict=%s src=rom-body sha1=%s\n' "$ts" "$temp" "$prev" "$v_thm" "$pin"
} | tee -a "$STATE"
exit 0
