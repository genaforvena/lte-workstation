#!/usr/bin/env bash
# test-rom-binary-contract — the uxn lane's byte-identity invariant is a git CONTRACT, not a
# heuristic. Every .rom is a pinned, hash-then-execute artifact (mesh-rom-gate / mesh-rom-
# calibrate / fletcher16 / permcheck all pin a sha1); a CRLF picked up on one node's checkout
# under core.autocrlf would break that sha1 silently. `.gitattributes: *.rom binary` forbids
# any EOL conversion. This gate asserts the contract COVERS every .rom AND still leaves the
# .tal source and .rom.sym symbol table text-diffable (so rom==source drift stays visible).
#
# Section D is the seen-red: it strips the `*.rom binary` line from the working-tree
# .gitattributes and requires a .rom's classification to FALL BACK from `unset` to
# `unspecified` — proving the line is what does the work, not git's content heuristic. A
# trap restores the file even if the run dies mid-mutation.
set -u
here="$(cd "$(dirname "$0")" && pwd)"
repo="$(cd "$here" && git rev-parse --show-toplevel 2>/dev/null)" || { echo "rom-binary-contract-test: n/a — not a git tree"; exit 2; }
cd "$repo"
ga="$repo/.gitattributes"
rc=0
fail(){ echo "  FAIL: $*"; rc=1; }

# attr <name> <path> → git's value for that attribute (unset|set|unspecified|auto)
attr(){ git check-attr "$1" -- "$2" | sed 's/.*: [^:]*: //'; }

# --- A. the contract exists and names the pattern ----------------------------------------
[ -f "$ga" ] || { echo "rom-binary-contract-test: n/a — no .gitattributes at repo root"; exit 2; }
grep -qE '^\*\.rom[[:space:]]+binary' "$ga" || fail ".gitattributes does not carry '*.rom binary'"

# --- B. every tracked .rom is binary (no EOL conversion, no textconv diff) ----------------
n=0
while IFS= read -r f; do
  [ -n "$f" ] || continue
  n=$((n+1))
  t="$(attr text "$f")"; d="$(attr diff "$f")"
  [ "$t" = unset ] || fail "$f: text=$t, want unset (a .rom must be binary — byte-identity is the invariant)"
  [ "$d" = unset ] || fail "$f: diff=$d, want unset"
done < <(git ls-files '*.rom')
[ "$n" -gt 0 ] || fail "no tracked .rom files found — the contract has nothing to cover"

# --- C. the pattern DISCRIMINATES: source + symtab stay text-diffable ---------------------
# A blanket `* binary` would also silence these; the rom==source drift check in every
# test-<name> depends on the .tal and .rom.sym remaining real text.
for f in $(git ls-files '*.tal' '*.rom.sym' | head -8); do
  t="$(attr text "$f")"
  [ "$t" = set ] || fail "$f: text=$t, want set (source/symtab must stay text — a blanket '* binary' would hide drift)"
done

# --- D. seen-red: without the line, a .rom is NOT binary ----------------------------------
rom="$(git ls-files '*.rom' | head -1)"
if [ -n "$rom" ]; then
  before="$(attr text "$rom")"
  [ "$before" = unset ] || fail "precondition: $rom should be 'unset' with the contract in place (got $before)"
  cp "$ga" "$ga.testbak"
  trap 'mv -f "$ga.testbak" "$ga" 2>/dev/null || true' EXIT
  grep -vE '^\*\.rom[[:space:]]+binary' "$ga.testbak" > "$ga"
  after="$(attr text "$rom")"
  mv -f "$ga.testbak" "$ga"; trap - EXIT
  [ "$after" != unset ] || fail "the '*.rom binary' line is VACUOUS — $rom is still 'unset' with it removed (git's heuristic is doing the work, not the contract)"
  # and it must have restored cleanly
  grep -qE '^\*\.rom[[:space:]]+binary' "$ga" || fail "restore failed — .gitattributes no longer carries the line"
fi

[ "$rc" -eq 0 ] && echo "rom-binary-contract-test: ok ($n .rom files binary, source/symtab text-diffable, line seen RED when stripped)"
exit "$rc"
