#!/usr/bin/env bash
# mesh-board-check — the board invariant WATCHER: stage the live board + node set,
# judge them with board-check.rom (the fixed point), stamp the verdict with the
# sha1 the runner ACTUALLY hashed at run time (fixed-point doctrine, operator
# 2026-07-23: a claimed hash is theater — hash-then-execute is the only attest).
#
# Invariants (the ROM owns the arithmetic; this shim is marshaling only):
#   STRUCTURE / MONOTONIC / UNKNOWN-NODE / DOUBLE-TAKING — see board-check.c.
# Verdict text is canon (last line OK n=…/RED v=…/UNKNOWN …), rc mirrors 0/1/2.
# rc 2 is honest n/a (organ absent, input at capacity) — never a fake verdict.
#
# State: $MESH_BOARD_STATE (default ~/.mesh/board-check.state) rewritten on
# verdict-CLASS change only; mtime touched EVERY successful eval (liveness-touch
# convention — mtime is liveness, content is change-gated). Both edges of the
# signal share one gate: any class transition (OK/RED/UNKNOWN, any direction)
# posts one [fyi] board line — RED onset and recovery alike, never just onset.
set -u
here="$(cd "$(dirname "$0")" && pwd)"
REPO="${MESH_REPO:-$HOME/lte-workstation}"
UXN_DIR="${MESH_UXN_DIR:-$REPO/scripts/uxn}"
UXNCLI="${MESH_UXNCLI:-$UXN_DIR/bin/uxncli}"
ROM="${MESH_BOARD_ROM:-$UXN_DIR/board-check.rom}"
LOG="${MESH_BOARD_LOG:-$HOME/.mesh/chat.log}"
STATE="${MESH_BOARD_STATE:-$HOME/.mesh/board-check.state}"
SANDBOX="${MESH_BOARD_SANDBOX:-0}"
TAILN="${MESH_BOARD_TAIL:-40}"
BYTE_CAP=19000   # board-check.c BOARD_CAP=20000; stay under it or the ROM says UNKNOWN

case "${1:-}" in
  --test) exec "$here/test-board-check" ;;
  --tail) TAILN="${2:?--tail needs N}" ;;
  '') : ;;
  *) echo "usage: mesh-board-check [--tail N] [--test]" >&2; exit 64 ;;
esac

[ -x "$UXNCLI" ] || { echo "board-check: n/a — no uxncli at $UXNCLI" >&2; exit 2; }
[ -f "$ROM" ]    || { echo "board-check: n/a — no ROM at $ROM" >&2; exit 2; }
[ -s "$LOG" ]    || { echo "board-check: n/a — no board log at $LOG" >&2; exit 2; }

# Known-host set: names from the node registry + this host + any extras.
hosts="$(sed -n 's/^MESH_NODES="\([^"]*\)".*/\1/p' "$HOME/.mesh/nodes" 2>/dev/null \
          | tr ' ' '\n' | cut -d: -f1 | tr '\n' ' ')"
hosts="$hosts $(hostname) ${MESH_BOARD_EXTRA_HOSTS:-}"
[ -n "${hosts// /}" ] || { echo "board-check: n/a — empty known-host set" >&2; exit 2; }

work="$(mktemp -d "${TMPDIR:-/tmp}/board-check.XXXXXX")"
trap 'rm -rf "$work"' EXIT
printf '%s\n' "$hosts" >"$work/nodes"
# Size to the ROM's buffer: halve N until the staged board fits (huge digest
# lines are legitimate; silently judging a truncated board is not).
n="$TAILN"
while :; do
  tail -n "$n" "$LOG" >"$work/board"
  [ "$(wc -c <"$work/board")" -le "$BYTE_CAP" ] && break
  n=$((n / 2))
  [ "$n" -ge 5 ] || { echo "board-check: n/a — even 5 lines exceed ${BYTE_CAP}B (line bloat?)" >&2; exit 2; }
done

actual="$(sha1sum "$ROM" | cut -d' ' -f1)"   # hash what we are ABOUT to execute
out="$( (cd "$work" && "$UXNCLI" "$ROM") )" || true
verdict="$(printf '%s\n' "$out" | tail -1)"
case "$verdict" in
  OK*)      cls=OK;      rc=0 ;;
  RED*)     cls=RED;     rc=1 ;;
  UNKNOWN*) cls=UNKNOWN; rc=2 ;;
  *)        echo "board-check: n/a — emulator produced no verdict (${out:0:80})" >&2; exit 2 ;;
esac

printf '%s\n' "$out"
echo "board-check: $verdict src=rom sha1=$actual lines=$n log=$LOG"

if [ "$SANDBOX" != 1 ]; then
  prev="$(head -1 "$STATE" 2>/dev/null | cut -d' ' -f1)"
  if [ "$prev" != "$cls" ]; then
    { echo "$cls $(date -u +%FT%TZ) $verdict sha1=$actual"; printf '%s\n' "$out"; } >"$STATE"
    if command -v mesh-chat >/dev/null 2>&1; then
      detail=""
      [ "$cls" = RED ] && detail=" — $(printf '%s\n' "$out" | grep '^RED ' | head -1 | cut -c1-200)"
      mesh-chat "[fyi] board-check: ${prev:-first-run}->$cls ($verdict, sha1=${actual:0:8}, $n lines)$detail" >/dev/null || true
    fi
  fi
  command -v mesh-state-touch >/dev/null 2>&1 && mesh-state-touch "$STATE" || touch "$STATE"
else
  prev="$(head -1 "$STATE" 2>/dev/null | cut -d' ' -f1)"
  [ "$prev" != "$cls" ] && echo "would-post: board-check ${prev:-first-run}->$cls"
  { echo "$cls sandbox"; } >"$STATE" 2>/dev/null || true
fi
exit "$rc"
