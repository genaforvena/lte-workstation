#!/usr/bin/env bash
# mesh-spearman — rank correlation between two columns, decided by a ROM.
#
# The ROM (spearman.tal) owns the formula, the REDUCTION, and its domain: given n and n
# integer rank-difference magnitudes it answers rho*1000, or "NA" rc=2 outside its range.
# Everything statistical that needs sorting — ranking, and therefore tie handling — is the
# HOST's job and stays here, in plain shell/awk.
#
# The ROM used to stop at n<=58, so the full series was reduced by the awk twin and the
# ROM only ever saw a window. That made the twin the real engine. With double-word
# arithmetic (arith32.tal) the ceiling is 2343, the whole corpus fits, and the ROM does
# the reduction it claims to do. The twin remains as an INDEPENDENT check, not a
# stand-in: it is written in 64-bit awk floats rather than re-implementing the ROM's
# integer scaling, so an AGREE is evidence about the arithmetic instead of a shared
# mistake. Same N-version shape as mesh-rom-calibrate.
#
# usage:
#   mesh-spearman --records [--window N]   score= vs beats= from ~/.mesh/records.log
#   mesh-spearman --pairs <file>           two whitespace-separated numeric columns
#   mesh-spearman --sweep <file>           ROM over every disjoint window + twin
#   mesh-spearman --test                   truth table
#
# TIE HANDLING is ordinal (ties broken by input order), NOT midranks, because midranks
# are half-integers and the ROM takes integers. This is a REAL difference, not a rounding
# detail: on the live records corpus ordinal reads rho=0.121 where midrank reads 0.146.
# Both are printed; neither is silently substituted for the other.
set -eu
here="$(cd "$(dirname "$0")" && pwd)"
ROM="${MESH_SPEARMAN_ROM:-$here/spearman.rom}"
UXNCLI="${MESH_UXNCLI:-$here/bin/uxncli}"
RECORDS="${MESH_RECORDS_LOG:-$HOME/.mesh/records.log}"
NMAX=2343                    # the ROM's domain ceiling; asserted against the ROM below

[ "${1:-}" = --test ] && exec "$here/test-spearman"
[ -f "$ROM" ]    || { echo "mesh-spearman: n/a — no ROM at $ROM (run ./build.sh --rom)" >&2; exit 2; }
[ -x "$UXNCLI" ] || { echo "mesh-spearman: n/a — no uxncli at $UXNCLI (run ./build.sh)" >&2; exit 2; }

# rom_rho <pairs-file> → rho*1000 on stdout, rc 0; rc 2 + "NA" when the ROM refuses.
# Ranks both columns ordinally, feeds n and the |d| series to the ROM. The ROM's refusal
# is passed through UNCHANGED — a host that turned NA into a number would be re-introducing
# exactly the silent wrap the ROM exists to refuse.
rom_rho(){
  local f="$1" n
  n=$(grep -cvE '^[[:space:]]*(#|$)' "$f")
  awk '
    /^[[:space:]]*(#|$)/ { next }
    { x[NR]=$1; y[NR]=$2; n++ }
    END {
      for (i=1; i<=NR; i++) { rx[i]=1; ry[i]=1 }
      for (i=1; i<=NR; i++) for (j=1; j<=NR; j++) {
        if (x[j] < x[i] || (x[j]==x[i] && j<i)) rx[i]++
        if (y[j] < y[i] || (y[j]==y[i] && j<i)) ry[i]++
      }
      print n
      for (i=1; i<=NR; i++) { d = rx[i]-ry[i]; print (d<0 ? -d : d) }
    }' "$f" | "$UXNCLI" "$ROM"
}

# twin_rho <pairs-file> <ordinal|midrank> → rho*1000, independently, in 64-bit awk floats.
twin_rho(){
  awk -v mode="$2" '
    /^[[:space:]]*(#|$)/ { next }
    { x[NR]=$1; y[NR]=$2 }
    END {
      n=NR
      if (n < 2) { print "NA"; exit }
      s=0
      for (i=1; i<=n; i++) {
        lx=0; ex=0; ly=0; ey=0
        for (j=1; j<=n; j++) {
          if (mode == "midrank") {
            if (x[j] <  x[i]) lx++;  else if (x[j]==x[i]) ex++
            if (y[j] <  y[i]) ly++;  else if (y[j]==y[i]) ey++
          } else {
            # ordinal: ties broken by input order — the SAME ranking rom_rho feeds the
            # ROM, so a DIVERGE can only be the arithmetic, never a tie-break convention.
            if (x[j] < x[i] || (x[j]==x[i] && j<i)) lx++
            if (y[j] < y[i] || (y[j]==y[i] && j<i)) ly++
          }
        }
        if (mode == "midrank") { rnkx=lx+(ex+1)/2; rnky=ly+(ey+1)/2 }
        else                   { rnkx=lx+1;        rnky=ly+1        }
        d=rnkx-rnky; s+=d*d
      }
      rho = 1 - 6*s/(n*(n*n-1))
      printf "%d\n", (rho >= 0 ? int(rho*1000+0.5) : -int(-rho*1000+0.5))
    }' "$1"
}

pairs_from_records(){ grep -oE 'score=[0-9.]+ beats=[0-9]+' "$RECORDS" | sed 's/score=//; s/beats=//'; }

mode="${1:---records}"
case "$mode" in
  --records)
    win="$NMAX"
    [ "${2:-}" = --window ] && win="${3:?--window needs a count}"
    tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT
    pairs_from_records > "$tmp/all"
    tail -n "$win" "$tmp/all" > "$tmp/win"
    echo "source: $RECORDS  (score= vs beats=)"
    echo "full series n=$(wc -l < "$tmp/all")  twin rho*1000: ordinal=$(twin_rho "$tmp/all" ordinal) midrank=$(twin_rho "$tmp/all" midrank)"
    printf 'ROM window  n=%s  rho*1000=' "$(wc -l < "$tmp/win")"
    rom_rho "$tmp/win" || true
    echo "twin window n=$(wc -l < "$tmp/win")  rho*1000=$(twin_rho "$tmp/win" ordinal) (ordinal — the ranking the ROM was fed)"
    ;;
  --pairs)
    f="${2:?--pairs needs a file}"
    rom_rho "$f"
    ;;
  --twin)
    # the 64-bit side alone, so a caller (the test) can compare the two independently
    # rather than reading one out of the other's formatted output.
    twin_rho "${2:?--twin needs a file}" "${3:-ordinal}"
    ;;
  --sweep)
    f="${2:?--sweep needs a file}"
    tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT
    grep -vE '^[[:space:]]*(#|$)' "$f" > "$tmp/all"
    total=$(wc -l < "$tmp/all"); i=0; w=0
    while [ $((i+NMAX)) -le "$total" ]; do
      sed -n "$((i+1)),$((i+NMAX))p" "$tmp/all" > "$tmp/w"
      r="$(rom_rho "$tmp/w" || true)"; t="$(twin_rho "$tmp/w" ordinal)"
      [ "$r" = "$t" ] && v=AGREE || v=DIVERGE
      printf 'window %-3d rows %4d-%-4d rom=%-6s twin=%-6s %s\n' "$w" $((i+1)) $((i+NMAX)) "$r" "$t" "$v"
      i=$((i+NMAX)); w=$((w+1))
    done
    echo "swept $w window(s) of $NMAX; tail of $((total-i)) row(s) is shorter than a window and was NOT covered"
    ;;
  *) echo "usage: mesh-spearman [--records [--window N] | --pairs <f> | --sweep <f> | --test]" >&2; exit 2 ;;
esac
