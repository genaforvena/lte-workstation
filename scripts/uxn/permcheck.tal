( permcheck.tal — a CHECKER ROM: verify a claimed-sorted stream is a genuine        )
( permutation of the original, in one O(n) streaming pass. The first of the           )
( VERIFY-DON'T-RECOMPUTE class.                                                        )
(                                                                                      )
( WHY, and the exact hole it closes: mesh-series-stats pipes its values through        )
( `sort -n` and feeds the RESULT to series-stats.rom, which verifies the stream is     )
( non-decreasing — and nothing else. A sort that DROPS a line, DUPLICATES one, or a    )
( scaling awk that MISPARSES a value all produce a stream that is still perfectly       )
( sorted; the ROM then reduces a corrupted multiset to a real-looking median/mean and  )
( n comes from `wc -l` of that same corrupted file, so the count never disagrees. That )
( is the doctrine's silent-fallback shape exactly: a plausible number answering a       )
( different question. This ROM is the missing half of "the host owns sorting, the ROM  )
( owns the reduction" — the host's sort is now CHECKED, not trusted.                    )
(                                                                                      )
( THE ASYMMETRY IS THE POINT: sorting is O(n log n); this check is O(n) with a handful )
( of zero-page accumulators — it never holds the array, it STREAMS both sides. Verify  )
( is cheaper than recompute, and the verifier is a pinned, hash-then-execute artifact  )
( byte-identical on x86/ARM/phone (same as fletcher16), so any node can re-check a      )
( sort another node did.                                                               )
(                                                                                      )
( THE FINGERPRINT is two commutative (order-independent) power sums: S = Sum x and      )
( Q = Sum x^2, each a 32-bit accumulator. Two multisets are compared by (count,S,Q).    )
( This is EXACT against the ACCIDENT threat model — the same model fletcher16 names:    )
( rot, truncation, a dropped/duplicated/misparsed element. Any corruption that changes  )
( the count, or the VALUE of up to two elements, moves (S,Q) — because a+b=c+d AND      )
( a^2+b^2=c^2+d^2 forces {a,b}={c,d}. It is NOT an adversarial permutation PROOF (that   )
( wants n power sums or a field fingerprint); a party free to choose >=3 colliding       )
( substitutions could evade it. Accidents cannot. Neither moment is redundant: S alone  )
( misses {1,4} vs {2,3} (equal sum), Q alone misses {0,5} vs {3,4} (equal sum-of-       )
( squares) — the truth table pins both.                                                 )
(                                                                                      )
( Q WRAPS at 32 bits and that is harmless: for values <= 9999 a single element's x^2 <  )
( 1e8 << 2^32, so no in-domain corruption of <=2 elements can make Q's DIFFERENCE a      )
( nonzero multiple of 2^32. Both sides wrap identically, so equality is preserved.       )
(                                                                                      )
( input  : decimal tokens on stdin, newline-terminated:                                 )
(            nA, then nA ORIGINAL values (any order),                                   )
(            nB, then nB CLAIMED-SORTED values (non-decreasing).                        )
(          every value token must be <= 9999 (the parser's ceiling, shared with          )
(          series-stats — a 5-digit token is a host bug, not a datum).                  )
( output : one token + newline, and the halt code carries the verdict:                  )
(            OK    rc 0  — same multiset, and B is sorted                               )
(            ORDER rc 1  — B is not non-decreasing                                      )
(            COUNT rc 1  — nA != nB                                                     )
(            SUM   rc 1  — counts match, sorted, but the multisets differ               )
(            NA    rc 2  — a token exceeded the parser ceiling (honest domain n/a)      )
(                                                                                      )
( zero page: acc=00 state=06 nA=08 nB=0a idx=0c prev=0e                                  )
(            SA=14/16 QA=18/1a SB=1c/1e QB=20/22 val=24                                   )
(            40..5f = arith32.tal's register file                                        )

|0100                        ( reset vector — zero page is already zeroed at boot )
    ;on-console #10 DEO2     ( install Console/vector )
    BRK

@on-console
    #12 DEI                  ( Console/read -> byte )
    DUP #0a EQU ,&nl JCN
    DUP #30 LTH ,&bad JCN    ( a non-digit is a host framing bug )
    DUP #39 GTH ,&bad JCN
    #30 SUB
    #00 SWP                  ( promote to short )
    #00 LDZ2 #03e7 GTH2 ,&over JCN   ( acc > 999 before *10 -> token exceeds 9999 )
    #00 LDZ2 #000a MUL2 ADD2 #00 STZ2
    BRK
    &over POP2 ;na JMP2      ( guard is BEFORE the multiply wraps )
    &bad  POP  ;na JMP2
    &nl   POP  ;token JMP2

@token
    #06 LDZ #00 EQU ,&s0 JCN
    #06 LDZ #01 EQU ,&s1 JCN
    #06 LDZ #02 EQU ,&s2 JCN
    ;got-vB JMP2            ( state 3: reading sorted B values )
    &s0 ;got-nA JMP2
    &s1 ;got-vA JMP2
    &s2 ;got-nB JMP2

@got-nA ( the first token is nA )
    #00 LDZ2 #08 STZ2
    #0000 #00 STZ2
    #0000 #0c STZ2                       ( idx = 0 )
    #08 LDZ2 #0000 EQU2 ,&empty JCN
    #01 #06 STZ                          ( state = 1: read A values )
    BRK
    &empty #02 #06 STZ                   ( nA = 0: skip straight to nB )
    BRK

@got-vA ( accumulate fingerprint A; no order constraint on the original )
    #00 LDZ2 #24 STZ2                    ( val = acc )
    #0000 #00 STZ2
    ;acc-S-A JSR2
    ;acc-Q-A JSR2
    #0c LDZ2 INC2 #0c STZ2               ( idx++ )
    #0c LDZ2 #08 LDZ2 EQU2 ,&doneA JCN
    BRK
    &doneA #02 #06 STZ                   ( all A read -> state 2: read nB )
    BRK

@got-nB ( the token after the A values is nB )
    #00 LDZ2 #0a STZ2
    #0000 #00 STZ2
    #0000 #0c STZ2                       ( idx = 0 )
    #0000 #0e STZ2                       ( prev = 0 )
    #0a LDZ2 #0000 EQU2 ,&empty JCN
    #03 #06 STZ                          ( state = 3: read sorted B values )
    BRK
    &empty ;report JMP2                  ( nB = 0: nothing to read )

@got-vB ( accumulate fingerprint B AND verify non-decreasing )
    #00 LDZ2 #24 STZ2                    ( val = acc )
    #0000 #00 STZ2
    #0c LDZ2 #0000 EQU2 ,&noorder JCN    ( idx == 0 -> no predecessor )
    #24 LDZ2 #0e LDZ2 LTH2 #00 EQU ,&noorder JCN   ( val >= prev -> ok )
    ;fail-order JMP2                      ( val < prev -> not sorted )
    &noorder
    #24 LDZ2 #0e STZ2                     ( prev = val )
    ;acc-S-B JSR2
    ;acc-Q-B JSR2
    #0c LDZ2 INC2 #0c STZ2               ( idx++ )
    #0c LDZ2 #0a LDZ2 EQU2 ,&doneB JCN
    BRK
    &doneB ;report JMP2

( --- the fingerprint accumulators. S += val (32-bit), Q += val*val (32-bit, wraps). --- )
@acc-S-A ( -- )
    #14 LDZ2 #40 STZ2 #16 LDZ2 #42 STZ2   ( A = SA )
    #0000 #44 STZ2 #24 LDZ2 #46 STZ2       ( B = val )
    ;w-add JSR2
    #40 LDZ2 #14 STZ2 #42 LDZ2 #16 STZ2   ( SA = A )
    JMP2r
@acc-Q-A ( -- )
    #24 LDZ2 #4c STZ2 #24 LDZ2 #4e STZ2   ( X = val, Y = val )
    ;w-mul16 JSR2                          ( A = val*val )
    #40 LDZ2 #44 STZ2 #42 LDZ2 #46 STZ2   ( B = A )
    #18 LDZ2 #40 STZ2 #1a LDZ2 #42 STZ2   ( A = QA )
    ;w-add JSR2
    #40 LDZ2 #18 STZ2 #42 LDZ2 #1a STZ2   ( QA = A )
    JMP2r
@acc-S-B ( -- )
    #1c LDZ2 #40 STZ2 #1e LDZ2 #42 STZ2   ( A = SB )
    #0000 #44 STZ2 #24 LDZ2 #46 STZ2       ( B = val )
    ;w-add JSR2
    #40 LDZ2 #1c STZ2 #42 LDZ2 #1e STZ2   ( SB = A )
    JMP2r
@acc-Q-B ( -- )
    #24 LDZ2 #4c STZ2 #24 LDZ2 #4e STZ2   ( X = val, Y = val )
    ;w-mul16 JSR2                          ( A = val*val )
    #40 LDZ2 #44 STZ2 #42 LDZ2 #46 STZ2   ( B = A )
    #20 LDZ2 #40 STZ2 #22 LDZ2 #42 STZ2   ( A = QB )
    ;w-add JSR2
    #40 LDZ2 #20 STZ2 #42 LDZ2 #22 STZ2   ( QB = A )
    JMP2r

@report
    #08 LDZ2 #0a LDZ2 EQU2 #00 EQU ,&countbad JCN   ( nA != nB )
    #14 LDZ2 #1c LDZ2 NEQ2 ,&sumbad JCN             ( SA hi != SB hi )
    #16 LDZ2 #1e LDZ2 NEQ2 ,&sumbad JCN             ( SA lo != SB lo )
    #18 LDZ2 #20 LDZ2 NEQ2 ,&sumbad JCN             ( QA hi != QB hi )
    #1a LDZ2 #22 LDZ2 NEQ2 ,&sumbad JCN             ( QA lo != QB lo )
    ;ok-str ;emit JSR2
    #80 #0f DEO             ( halt, exit 0 )
    BRK
    &countbad ;fail-count JMP2
    &sumbad   ;fail-sum JMP2

@fail-order
    ;order-str ;emit JSR2
    #81 #0f DEO             ( halt, exit 1 )
    BRK
@fail-count
    ;count-str ;emit JSR2
    #81 #0f DEO
    BRK
@fail-sum
    ;sum-str ;emit JSR2
    #81 #0f DEO
    BRK
@na
    ;na-str ;emit JSR2
    #82 #0f DEO             ( halt, exit 2 — honest domain n/a )
    BRK

@emit ( str* -- )
    &loop
    LDAk #00 EQU ,&done JCN
    LDAk #18 DEO
    INC2 ,&loop JMP
    &done
    POP2
    JMP2r

@ok-str    "OK 0a 00
@order-str "ORDER 0a 00
@count-str "COUNT 0a 00
@sum-str   "SUM 0a 00
@na-str    "NA 0a 00

~arith32.tal
