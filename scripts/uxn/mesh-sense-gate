#!/usr/bin/env bash
# mesh-sense-gate — host shim for sense-gate.rom, the STRUCTURAL real-read gate.
#
# The hollow sense's signature is a green --test over a read that is not actually
# producing: 0 axes (driver race), a value frozen since boot (HAL cache), or a
# signal that never moves (dead emitter). Each is one axis of sense-gate.rom — a
# 305-byte ROM that owns the three-way AND and names the first failed axis; this
# shim only MEASURES (counts axes, reads age, computes range) and maps the verdict.
# It is deliberately thin: the structural invariant lives in the byte-identical ROM,
# not in bespoke bash that rots per-sensor (the -n1-raced-green-5-days canon).
#
# usage:
#   mesh-sense-gate --gate <min_n> <n> <max_age> <age> <min_var> <var>
#       gate six raw measured integers. A floor/ceiling of 0 = "no requirement on
#       that axis" (partial spec); ALL three zero = empty spec -> the ROM refuses
#       (NA rc2): a check asserting nothing passes everything.
#   mesh-sense-gate --count <min_n> <read...>
#       the common case (mesh-mag's "read yields 3 axes"): count the whitespace-
#       separated NUMERIC tokens in the read, gate count >= min_n alone.
#   mesh-sense-gate --test
# exit:  0 = OK (real read)   1 = RED <axis> (hollow: named axis failed)   2 = n/a
# env:   MESH_REPO (genome) · MESH_UXN_DIR (ROM+toolchain) · MESH_ROM_GATE (runner)
set -eu
REPO="${MESH_REPO:-$HOME/lte-workstation}"
UXN_DIR="${MESH_UXN_DIR:-$REPO/scripts/uxn}"
GATE="${MESH_ROM_GATE:-$REPO/scripts/mesh-rom-gate}"

# run_verdict <6 ints> -> prints verdict token, exit code is the gate's (0/1/2).
run_verdict(){ "$GATE" sense-gate "$1" "$2" "$3" "$4" "$5" "$6"; }

# the 64-bit inline fallback for the ROM's out-of-domain (NA) case — same predicate,
# native arithmetic, never a wrapped verdict. Mirrors mesh-lease-gate's fallback.
fallback(){ # min_n n max_age age min_var var  ->  echoes verdict, exit 0/1
  awk -v mn="$1" -v n="$2" -v ma="$3" -v age="$4" -v mv="$5" -v vr="$6" '
    BEGIN {
      if (mn != 0 && n+0 < mn)  { print "RED count"; exit 1 }
      if (ma != 0 && age+0 > ma){ print "RED age";   exit 1 }
      if (mv != 0 && vr+0 < mv) { print "RED var";   exit 1 }
      print "OK"; exit 0
    }'
}

gate6(){ # min_n n max_age age min_var var -> verdict text + exit, with NA fallback
  local out r
  r=0; out="$(run_verdict "$@" 2>/dev/null)" || r=$?
  if [ "$r" -eq 2 ] && [ "$(printf '%s' "$out" | tr -d '[:space:]')" = NA ]; then
    fallback "$@" | sed 's/$/  (src=inline-fallback, ROM domain NA)/'
    return "${PIPESTATUS[0]}"
  fi
  printf '%s\n' "$out"
  return "$r"
}

if [ "${1:-}" = --test ]; then
  [ -x "$UXN_DIR/bin/uxncli" ] && [ -f "$UXN_DIR/sense-gate.rom" ] \
    || { (cd "$UXN_DIR" && ./build.sh --rom) >/dev/null 2>&1 || true; }
  rc=0
  # both polarities through the real ROM via the shared runner. r=0;...||r=$? guards the
  # non-zero (RED) cases against set -e aborting before the rc is captured.
  r=0; out="$(gate6 3 3 60 10 5 10)" || r=$?; [ "$r" = 0 ] && [ "$out" = OK ] || { echo "FAIL: healthy -> OK/rc0, got '$out'/rc$r"; rc=1; }
  r=0; out="$(gate6 3 0 0 0 0 0)"    || r=$?; [ "$r" = 1 ] || { echo "FAIL: 0-axes -> RED/rc1, got '$out'/rc$r"; rc=1; }
  # --count: the mesh-mag use case — 3 numeric axes pass, an empty read fails
  r=0; out="$("$0" --count 3 "0.1 0.2 0.3")" || r=$?; [ "$r" = 0 ] || { echo "FAIL: --count 3 on 3 axes -> OK, got rc$r '$out'"; rc=1; }
  r=0; out="$("$0" --count 3 "")" || r=$?;        [ "$r" = 1 ] || { echo "FAIL: --count 3 on empty -> RED (the driver-race canon), got rc$r '$out'"; rc=1; }
  # NA fallback: an out-of-domain age must still verdict via the 64-bit fallback, not crash
  r=0; out="$(gate6 3 3 60 432000 5 10)" || r=$?; [ "$r" = 1 ] || { echo "FAIL: 5-day age via fallback -> RED age/rc1, got '$out'/rc$r"; rc=1; }
  [ "$rc" = 0 ] && echo "smoke-test: ok (OK + RED-count + --count pass/fail + NA-fallback)" || echo "smoke-test: FAIL"
  exit "$rc"
fi

case "${1:-}" in
  --gate)
    [ $# -eq 7 ] || { echo "usage: mesh-sense-gate --gate <min_n> <n> <max_age> <age> <min_var> <var>" >&2; exit 2; }
    gate6 "$2" "$3" "$4" "$5" "$6" "$7"
    ;;
  --count)
    min_n="${2:?usage: --count <min_n> <read...>}"
    shift 2
    read_str="$*"
    # count NUMERIC tokens (a non-numeric stub like "OFFLINE" is not an axis — the
    # driver-race canon returns an empty/garbage stream, not "3 axes")
    n="$(printf '%s\n' "$read_str" | tr -s '[:space:]' '\n' | grep -cE '^-?[0-9]+\.?[0-9]*$' || true)"
    gate6 "$min_n" "$n" 0 0 0 0
    ;;
  *)
    echo "usage: mesh-sense-gate --gate <min_n> <n> <max_age> <age> <min_var> <var> | --count <min_n> <read...> | --test" >&2
    exit 2
    ;;
esac
