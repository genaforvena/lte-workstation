#!/usr/bin/env bash
# test-rom-calibrate — RED-first suite for mesh-rom-calibrate (the ROM-vs-shell
# calibration ledger; operator 2026-07-23: spend the DISAGREEMENT signal).
#
# The DIVERGE fixture is a REAL divergence through the REAL ROM — lease 67335
# wraps the ROM's 16-bit parse to 1799 (< 2*900) while 64-bit shell arithmetic
# says OK — not a mock: the ledger must catch a genuine two-implementation split.
set -u
here="$(cd "$(dirname "$0")" && pwd)"
cd "$here"
[ -x bin/uxncli ] || ./build.sh >/dev/null
[ -f lease-gate.rom ] || { echo "rom-calibrate-test: n/a (no lease-gate.rom)" >&2; exit 2; }
rc=0
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
cal() { MESH_CAL_LOG="$tmp/cal.log" MESH_CAL_SANDBOX=1 "$here/mesh-rom-calibrate" "$@"; }

# 1) agreeing pair: both OK, ledger line AGREE, rc 0
out=$(cal --pair 900 1800); r=$?
{ [ "$r" -eq 0 ] && echo "$out" | grep -q ' rom=OK shell=OK AGREE$'; } \
  || { echo "FAIL: agreeing pair (rc=$r out='$out')"; rc=1; }
grep -q 'cad=900 lease=1800 rom=OK shell=OK AGREE' "$tmp/cal.log" \
  || { echo "FAIL: AGREE not in ledger"; rc=1; }

# 2) agreeing RED pair: both RED is still AGREE (the axis is implementations, not health)
out=$(cal --pair 900 900); r=$?
{ [ "$r" -eq 0 ] && echo "$out" | grep -q ' rom=RED shell=RED AGREE$'; } \
  || { echo "FAIL: agreeing-RED pair (rc=$r out='$out')"; rc=1; }

# 3) out-of-domain pair: the ROM now declines honestly (NA, 2026-07-23 domain fix) —
#    logged DOMAIN, neither agree nor diverge, rc stays 0 (a boundary is not a split)
out=$(cal --pair 900 67335); r=$?
{ [ "$r" -eq 0 ] && echo "$out" | grep -q ' rom=NA shell=OK DOMAIN$'; } \
  || { echo "FAIL: wrap pair must log DOMAIN (rc=$r out='$out')"; rc=1; }
grep -q 'DOMAIN' "$tmp/cal.log" || { echo "FAIL: DOMAIN not in ledger"; rc=1; }

# 3b) DIVERGE path: with the ROM domain-honest, a genuine split needs an injected
#     runner stub (answers RED for a healthy pair). This tests the LEDGER's verdict
#     logic; the ROM-side reality of splits was proven by the pre-fix wrap pair.
printf '#!/usr/bin/env bash\necho RED; exit 1\n' >"$tmp/stubgate"
chmod +x "$tmp/stubgate"
out=$(MESH_ROM_GATE="$tmp/stubgate" cal --pair 900 1800); r=$?
{ [ "$r" -eq 1 ] && echo "$out" | grep -q ' rom=RED shell=OK DIVERGE$' \
    && echo "$out" | grep -q 'would-post:.*DIVERGE'; } \
  || { echo "FAIL: stub divergence (rc=$r out='$out')"; rc=1; }
grep -q 'DIVERGE' "$tmp/cal.log" || { echo "FAIL: DIVERGE not in ledger"; rc=1; }

# 4) every ledger line carries the sha1 of the ROM actually hashed (fixed-point stamp)
sha=$(sha1sum lease-gate.rom | cut -d' ' -f1)
n_lines=$(wc -l <"$tmp/cal.log")
n_sha=$(grep -c "sha1=$sha" "$tmp/cal.log")
[ "$n_lines" -ge 3 ] && [ "$n_sha" -eq "$n_lines" ] \
  || { echo "FAIL: sha1 stamp missing from ledger lines ($n_sha/$n_lines)"; rc=1; }

# 5) fleet mode over a FIXTURE list (not the live genome): parses rows, logs each,
#    aggregates rc (all-agree -> 0)
printf '%s\n' \
'mesh-alpha                   cad=300    lease=600    OK' \
'mesh-beta                    cad=900    lease=1800   OK' \
>"$tmp/rows"
out=$(cal --rows "$tmp/rows"); r=$?
{ [ "$r" -eq 0 ] && [ "$(grep -c 'name=mesh-' "$tmp/cal.log")" -ge 2 ]; } \
  || { echo "FAIL: fleet rows mode (rc=$r out='$out')"; rc=1; }

# 6) honest n/a: missing ROM is rc 2, never a fake verdict
out=$(MESH_CAL_LOG="$tmp/cal.log" MESH_CAL_SANDBOX=1 MESH_CAL_ROM="$tmp/nope.rom" \
      "$here/mesh-rom-calibrate" --pair 900 1800 2>&1); r=$?
[ "$r" -eq 2 ] || { echo "FAIL: missing rom must be rc2 (rc=$r out='$out')"; rc=1; }

# --- verify-sort: the VERIFY-DON'T-RECOMPUTE mode (permcheck.rom as a cheap sort checker) --
if [ -f permcheck.rom ]; then
  vs(){ MESH_CAL_LOG="$tmp/cal.log" MESH_CAL_SANDBOX=1 "$here/mesh-rom-calibrate" --verify-sort "$@"; }
  python3 -c "import random;random.seed(7);v=[random.randint(0,9999) for _ in range(120)];print('\n'.join(map(str,v)))" >"$tmp/vs-nums"

  # 7) a genuine `sort -n` IS a permutation → OK, rc 0, ledger line stamped with permcheck's sha1
  out=$(vs "$tmp/vs-nums"); r=$?
  psha=$(sha1sum permcheck.rom | cut -d' ' -f1)
  { [ "$r" -eq 0 ] && echo "$out" | grep -q "predicate=sort-permcheck sha1=$psha n=120 verdict=OK$"; } \
    || { echo "FAIL: healthy sort must verify OK (rc=$r out='$out')"; rc=1; }

  # 8) a corrupting "sort" that DROPS a line → NOT a permutation → COUNT, rc 1, loud post.
  #    This is the whole point seen RED: a checker that never rejects is not a checker.
  printf '#!/usr/bin/env bash\nsort -n | sed 2d\n' >"$tmp/dropsort"; chmod +x "$tmp/dropsort"
  out=$(MESH_CAL_SORT="$tmp/dropsort" vs "$tmp/vs-nums"); r=$?
  { [ "$r" -eq 1 ] && echo "$out" | grep -q 'verdict=COUNT$' \
      && echo "$out" | grep -q 'would-post:.*sort-permcheck COUNT'; } \
    || { echo "FAIL: a DROPPED line must be caught COUNT rc1 (rc=$r out='$out')"; rc=1; }

  # 9) a corrupting "sort" that MUTATES a value (same length, re-sorted) → SUM, rc 1
  printf '#!/usr/bin/env bash\nawk %sNR==1{$1=($1+1)%%10000} {print}%s | sort -n\n' "'" "'" >"$tmp/mutsort"
  chmod +x "$tmp/mutsort"
  out=$(MESH_CAL_SORT="$tmp/mutsort" vs "$tmp/vs-nums"); r=$?
  { [ "$r" -eq 1 ] && echo "$out" | grep -qE 'verdict=(SUM|COUNT)$'; } \
    || { echo "FAIL: a MUTATED value must be caught (rc=$r out='$out')"; rc=1; }

  # 10) over-ceiling value is honest n/a (rc2), never a wrapped verdict
  printf '1\n2\n10000\n' >"$tmp/vs-over"
  out=$(vs "$tmp/vs-over" 2>&1); r=$?
  [ "$r" -eq 2 ] || { echo "FAIL: verify-sort over-ceiling must be rc2 (rc=$r out='$out')"; rc=1; }
else
  echo "  (verify-sort section skipped — no permcheck.rom)"
fi

[ "$rc" = 0 ] && echo "rom-calibrate-test: ok" || echo "rom-calibrate-test: FAIL"
exit $rc
