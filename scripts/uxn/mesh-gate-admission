#!/usr/bin/env bash
# mesh-gate-admission — generated-gate admission harness (gates-as-data stage 3, 2026-07-23).
#
# The threshold ledger holds calibrated predicates as DATA under a pinned evaluator; stage 3
# lets a GENERATOR (mesh-relay / any mind) propose new gates — but a generated row is a CLAIM,
# and this harness is the only door into the ledger. A candidate file carries the row
# (threshold-ledger 4-field form) plus its OWN fixture rows; admission requires, in order:
#   1. structure     — one `row:` line, name/params/consts well-formed, name not already a gate
#   2. token whitelist — template tokens ⊆ evaluator ops (if + * - / < > <= >= =) ∪ naturals
#                       ∪ the row's params ∪ its const keys; anything else is s-expr injection
#   3. fixtures      — >=2 `fix:` rows, natural args, >=2 distinct wants (a single-want fixture
#                       set discriminates nothing)
#   4. pin           — the target ledger's `# evaluator-sha1:` matches lisp-eval.rom on disk
#                       (hash-then-execute; mismatch is environment n/a rc=2, not a verdict)
#   5. eval          — every candidate fixture renders its want through mesh-sexpr-gate under
#                       the pin (want NA ⇒ the evaluator must honestly decline rc=2)
#   6. compat        — mesh-rom-calibrate --ledger over the COMMITTED fixtures stays green with
#                       the candidate row appended (the append breaks nothing that exists)
#   7. mutants RED   — EVERY derived mutant (each const ±1, each comparison flipped) must FAIL
#                       the candidate's fixtures; a surviving mutant means the fixtures do not
#                       pin the gate's numbers/shape, and a candidate whose mutants pass admits
#                       nothing (the RED-first doctrine applied to generated code)
# adopt  = append the row to the ledger + the fixtures to ./admitted-fixtures + ADMIT log line
# reject = REJECT log line carrying the first failed check's reason; nothing is appended.
# NO candidate touches a consumer until admitted.
#
# usage: mesh-gate-admission --propose "<goal>"     ask the generator (mesh-relay) for a candidate
#                                                   file; scrub to row:/fix:/# lines; NEVER admits
#        mesh-gate-admission --check  <candidate>   dry-run the admission checks (no append, no log)
#        mesh-gate-admission --admit  <candidate>   run the checks, adopt or reject (logged)
#        mesh-gate-admission --recheck              re-drive every admitted fixture row against the
#                                                   live ledger (drift after a recalibration = RED)
#        mesh-gate-admission --test
# exit:  0 admitted / checks green · 1 rejected (reason on stdout + log) · 2 honest n/a
# env:   MESH_ADMIT_LEDGER   target ledger        (default $here/threshold-ledger)
#        MESH_ADMIT_FIXTURES committed fixtures   (default $here/threshold-fixtures)
#        MESH_ADMIT_ADOPTED  admitted fixtures    (default $here/admitted-fixtures)
#        MESH_ADMIT_LOG      admission history    (default ~/.mesh/gate-admission.log)
#        MESH_ADMIT_RELAY    generator command    (default mesh-relay)
#        MESH_ADMIT_CAND_DIR candidate drop dir   (default ~/.mesh/gate-candidates)
# orphan-ok: on-demand admission harness — minds drive it per candidate, never cron
set -u
here="$(cd "$(dirname "$0")" && pwd)"
uxdir="$here"; [ -f "$uxdir/threshold-ledger" ] || uxdir="${MESH_REPO:-$HOME/lte-workstation}/scripts/uxn"
LEDGER="${MESH_ADMIT_LEDGER:-$uxdir/threshold-ledger}"
FIXTURES="${MESH_ADMIT_FIXTURES:-$uxdir/threshold-fixtures}"
ADOPTED="${MESH_ADMIT_ADOPTED:-$uxdir/admitted-fixtures}"
LOG="${MESH_ADMIT_LOG:-$HOME/.mesh/gate-admission.log}"
SEXPR="$uxdir/mesh-sexpr-gate"
CAL="$uxdir/mesh-rom-calibrate"
ROM="${MESH_SEXPR_ROM:-$uxdir/lisp-eval.rom}"
OPS='if + * - / < > <= >= ='

[ "${1:-}" = --test ] && exec "$uxdir/test-gate-admission"

na(){ echo "gate-admission: n/a — $*" >&2; exit 2; }

tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT

# ── --propose: the generator side. Output is UNTRUSTED — scrubbed to candidate lines only,
#    parked in the candidate dir, and never admitted from here (the harness is the door). ──
if [ "${1:-}" = --propose ]; then
  shift; goal="$*"
  [ -n "$goal" ] || na "--propose needs a goal"
  relay="${MESH_ADMIT_RELAY:-mesh-relay}"
  command -v "$relay" >/dev/null 2>&1 || [ -x "$relay" ] || na "no generator at $relay"
  cdir="${MESH_ADMIT_CAND_DIR:-$HOME/.mesh/gate-candidates}"
  mkdir -p "$cdir"
  prompt="Propose ONE calibrated gate for a tiny s-expression evaluator, as exactly these lines and nothing else:
row: <name> | <params> | <k=v consts> | <template>
fix: <name> <args...> <want>   (4 or more fix lines)
Rules: name lowercase-hyphen; params/const-keys lowercase; consts are naturals; template uses ONLY: if + * - / < > <= >= = , parens, naturals, the params, the const keys. 16-bit naturals only (0..65535). Fixtures must include the exact decision boundary from BOTH sides (e.g. threshold-1, threshold, threshold+1) and witness at least two distinct wants. Goal: $goal"
  raw="$("$relay" "$prompt" 2>/dev/null)" || na "generator failed"
  scrubbed="$(printf '%s\n' "$raw" | grep -E '^[[:space:]]*(row|fix):' | sed 's/^[[:space:]]*//')"
  # filename only — deliberately looser than the admission name rule: a malformed generated
  # name must reach --admit and REJECT with a reason, not vanish here as n/a
  name="$(printf '%s\n' "$scrubbed" | sed -n 's/^row:[[:space:]]*\([a-zA-Z][a-zA-Z0-9_-]*\).*/\1/p' | head -1 | tr 'A-Z' 'a-z')"
  [ -n "$name" ] || na "generator output carried no parseable 'row:' line"
  out="$cdir/$name-$(date -u +%Y%m%dT%H%M%SZ).cand"
  { echo "# proposed: $(date -u +%FT%TZ) generator=$relay"
    echo "# goal: $goal"
    printf '%s\n' "$scrubbed"
  } > "$out"
  echo "$out"
  exit 0
fi

# ── --recheck: admitted gates have no shell twin (they are generated — no independent second
#    implementation exists), so their fixtures live outside the calibrate pass; this re-drive
#    is their liveness gate against the CURRENT ledger. ──
if [ "${1:-}" = --recheck ]; then
  [ -s "$ADOPTED" ] || { echo "gate-admission: 0 admitted rows"; exit 0; }
  [ -x "$SEXPR" ] || na "no mesh-sexpr-gate at $SEXPR"
  n=0; bad=0
  while IFS= read -r line; do
    case "$line" in ''|\#*) continue ;; esac
    set -- $line
    g="$1"; shift
    want="${!#}"; set -- "${@:1:$(($#-1))}"
    out="$(MESH_SEXPR_GATES="$LEDGER" "$SEXPR" "$g" "$@" 2>/dev/null)"; urc=$?
    if [ "$want" = NA ]; then ok=$([ "$urc" -eq 2 ] && [ "$out" = NA ] && echo 1 || echo 0)
    else ok=$([ "$urc" -eq 0 ] && [ "$out" = "$want" ] && echo 1 || echo 0); fi
    if [ "$ok" != 1 ]; then echo "RED: admitted row '$line' → '$out' rc=$urc (ledger drifted under an admitted gate — re-admit or drop it)"; bad=1; fi
    n=$((n + 1))
  done <"$ADOPTED"
  [ "$bad" -eq 0 ] && echo "gate-admission: recheck ok ($n admitted rows green)"
  exit "$bad"
fi

verb="${1:-}"; cand="${2:-}"
case "$verb" in --check|--admit) ;; *) echo "usage: mesh-gate-admission --propose <goal> | --check <cand> | --admit <cand> | --recheck | --test" >&2; exit 64 ;; esac
[ -f "$cand" ]   || na "no candidate file at '$cand'"
[ -f "$LEDGER" ] || na "no target ledger at $LEDGER"
[ -x "$SEXPR" ]  || na "no mesh-sexpr-gate at $SEXPR"
[ -f "$ROM" ]    || na "no evaluator at $ROM"

name=""   # set once the row parses; REJECT lines carry it when known
reject(){ # $* = reason → log + stdout, rc 1 (--check logs nothing)
  local reason="$*"
  echo "REJECT: $reason"
  if [ "$verb" = --admit ]; then
    printf '%s REJECT name=%s reason="%s" src=%s\n' "$(date -u +%FT%TZ)" "${name:-unparsed}" "$reason" "$cand" >>"$LOG"
  fi
  exit 1
}

# ── 1. structure ──────────────────────────────────────────────────────────────────────────
nrow="$(grep -c '^row:' "$cand" || true)"
[ "$nrow" = 1 ] || reject "candidate must carry exactly one 'row:' line, found $nrow"
row="$(sed -n 's/^row:[[:space:]]*//p' "$cand" | head -1)"
nf="$(printf '%s\n' "$row" | awk -F'|' '{print NF}')"
[ "$nf" = 4 ] || reject "row must be 4-field 'name | params | consts | template', got $nf fields"
name="$(printf '%s\n' "$row" | awk -F'|' '{gsub(/[[:space:]]/,"",$1); print $1}')"
params="$(printf '%s\n' "$row" | awk -F'|' '{print $2}')"
consts="$(printf '%s\n' "$row" | awk -F'|' '{print $3}')"
template="$(printf '%s\n' "$row" | awk -F'|' '{print $4}')"
case "$name" in [a-z]*) ;; *) reject "bad gate name '$name'" ;; esac
case "$name" in *[!a-z0-9-]*) reject "bad gate name '$name'" ;; esac
grep -vE '^[[:space:]]*(#|$)' "$LEDGER" | awk -F'|' '{gsub(/[[:space:]]/,"",$1); print $1}' | grep -qx "$name" \
  && reject "gate '$name' already exists in the ledger — a generated row cannot shadow a committed one"
for p in $params; do
  case "$p" in [a-z]*) ;; *) reject "bad param '$p'" ;; esac
  case "$p" in *[!a-z0-9_]*) reject "bad param '$p'" ;; esac
done
[ -n "${params// /}" ] || reject "row declares no params"
for kv in $consts; do
  ck="${kv%%=*}"; cv="${kv#*=}"
  [ "$ck" != "$kv" ] || reject "const '$kv' is not k=v"
  case "$ck" in [a-z]*) ;; *) reject "bad const key '$ck'" ;; esac
  case "$ck" in *[!a-z0-9_]*) reject "bad const key '$ck'" ;; esac
  case "$cv" in ''|*[!0-9]*) reject "const '$ck' must be a bare natural, got '$cv'" ;; esac
done
[ -n "${template// /}" ] || reject "row has an empty template"

# ── 2. token whitelist — the injection door stays shut ────────────────────────────────────
toks="$(printf '%s' "$template" | sed 's/(/ /g; s/)/ /g')"
for t in $toks; do
  ok=0
  for o in $OPS; do [ "$t" = "$o" ] && ok=1; done
  case "$t" in *[!a-z0-9_]*) ;; [0-9]*) case "$t" in *[!0-9]*) ;; *) ok=1 ;; esac ;; esac
  for p in $params; do [ "$t" = "$p" ] && ok=1; done
  for kv in $consts; do [ "$t" = "${kv%%=*}" ] && ok=1; done
  [ "$ok" = 1 ] || reject "template token '$t' is not an evaluator op, natural, param, or const key of this row"
done

# ── 3. fixtures ───────────────────────────────────────────────────────────────────────────
nparam=0; for p in $params; do nparam=$((nparam + 1)); done
grep '^fix:' "$cand" | sed 's/^fix:[[:space:]]*//' > "$tmp/fix"
nfix="$(grep -c . "$tmp/fix" || true)"
[ "$nfix" -ge 2 ] || reject "need >=2 fixture rows, got $nfix"
wants="$tmp/wants"; : > "$wants"
while IFS= read -r line; do
  set -- $line
  [ "$1" = "$name" ] || reject "fixture row '$line' names '$1', not '$name'"
  shift
  [ $# -eq $((nparam + 1)) ] || reject "fixture row wants $nparam args + want, got $# words: '$line'"
  want="${!#}"
  case "$want" in NA) ;; ''|*[!0-9]*) reject "fixture want '$want' is neither a natural nor NA" ;; esac
  echo "$want" >>"$wants"
  set -- "${@:1:$(($#-1))}"
  for a in "$@"; do
    case "$a" in ''|*[!0-9]*) reject "fixture arg '$a' must be a bare natural (a value is data, never code)" ;; esac
  done
done <"$tmp/fix"
[ "$(sort -u "$wants" | grep -c .)" -ge 2 ] || reject "fixtures witness a single want value — they discriminate nothing"

# ── 4. pin: hash-then-execute (environment claim, not a candidate verdict) ────────────────
pin="$(sed -n 's/^# evaluator-sha1:[[:space:]]*\([0-9a-f]\{40\}\).*/\1/p' "$LEDGER" | head -1)"
[ -n "$pin" ] || na "target ledger carries no '# evaluator-sha1:' pin"
actual="$(sha1sum -- "$ROM" | cut -d' ' -f1)"
[ "$pin" = "$actual" ] || na "evaluator sha1 mismatch (pinned $pin, actual $actual) — refusing to judge any candidate"

mkcand(){ # $1=row-text → path of a candidate-only ledger under the pin
  local f="$tmp/cand-ledger-$RANDOM"
  { echo "# evaluator-sha1: $pin"; printf '%s\n' "$1"; } > "$f"
  echo "$f"
}
fixture_pass(){ # $1=ledger-file → 0 all candidate fixtures green, 1 first red on stdout
  local f="$1" line want out urc
  while IFS= read -r line; do
    set -- $line
    shift            # gate name
    want="${!#}"; set -- "${@:1:$(($#-1))}"
    out="$(MESH_SEXPR_GATES="$f" "$SEXPR" "$name" "$@" 2>/dev/null)"; urc=$?
    if [ "$want" = NA ]; then
      [ "$urc" -eq 2 ] && [ "$out" = NA ] || { echo "fixture '$line': want NA/rc2, got '$out'/rc$urc"; return 1; }
    else
      [ "$urc" -eq 0 ] && [ "$out" = "$want" ] || { echo "fixture '$line': want $want, got '$out'/rc$urc"; return 1; }
    fi
  done <"$tmp/fix"
  return 0
}

# ── 5. eval: the candidate's own fixtures under the pinned evaluator ──────────────────────
cl="$(mkcand "$row")"
msg="$(fixture_pass "$cl")" || reject "$msg"

# ── 6. compat: committed calibration stays green with the row appended ────────────────────
[ -x "$CAL" ] || na "no mesh-rom-calibrate at $CAL"
[ -f "$FIXTURES" ] || na "no committed fixtures at $FIXTURES"
full="$tmp/full-ledger"
{ cat "$LEDGER"; printf '%s\n' "$row"; } > "$full"
calout="$(MESH_CAL_SANDBOX=1 MESH_CAL_LOG="$tmp/cal.log" MESH_SEXPR_GATES="$full" "$CAL" --ledger "$FIXTURES" 2>&1)" \
  || reject "committed calibration breaks with the row appended: $calout"

# ── 7. mutants RED: every derived mutant must fail the candidate's fixtures ───────────────
mutants="$tmp/mutants"; : > "$mutants"   # desc<TAB>mutated-row
for kv in $consts; do
  ck="${kv%%=*}"; cv="${kv#*=}"
  printf 'const %s=%s→%s\t%s\n' "$ck" "$cv" "$((cv + 1))" \
    "$(printf '%s\n' "$row" | sed "s/$ck=$cv/$ck=$((cv + 1))/")" >>"$mutants"
  [ "$cv" -gt 0 ] && printf 'const %s=%s→%s\t%s\n' "$ck" "$cv" "$((cv - 1))" \
    "$(printf '%s\n' "$row" | sed "s/$ck=$cv/$ck=$((cv - 1))/")" >>"$mutants"
done
ptmpl="$(printf '%s' "$template" | sed 's/(/ ( /g; s/)/ ) /g')"   # paren-padded: ops become bare tokens
ncmp="$(printf '%s\n' "$ptmpl" | tr ' ' '\n' | grep -cE '^(<|>|<=|>=)$' || true)"
i=1
while [ "$i" -le "$ncmp" ]; do
  mtmpl="$(printf '%s\n' "$ptmpl" | awk -v n="$i" '{
    m = 0; out = ""
    for (j = 1; j <= NF; j++) {
      t = $j
      if (t == "<" || t == ">" || t == "<=" || t == ">=") {
        m++
        if (m == n) { if (t == "<") t = "<="; else if (t == "<=") t = "<"; else if (t == ">") t = ">="; else t = ">" }
      }
      out = out (j > 1 ? " " : "") t
    }
    print out
  }')"
  printf 'comparison #%s flipped\t%s | %s | %s | %s\n' "$i" "$name" "$params" "$consts" "$mtmpl" >>"$mutants"
  i=$((i + 1))
done
[ -s "$mutants" ] || reject "no mutants derivable (no consts, no comparisons) — nothing pins this gate, admitting it asserts nothing"
while IFS=$'\t' read -r desc mrow; do
  [ "$mrow" != "$row" ] || reject "mutant generation no-op ($desc) — cannot prove RED"
  ml="$(mkcand "$mrow")"
  if fixture_pass "$ml" >/dev/null; then
    reject "mutant survives ($desc) — the fixtures do not discriminate it; a candidate whose mutants pass admits nothing"
  fi
done <"$mutants"
nmut="$(grep -c . "$mutants")"

# ── all green ─────────────────────────────────────────────────────────────────────────────
if [ "$verb" = --check ]; then
  echo "CHECK ok: $name ($nfix fixtures green, $nmut mutants red, calibration compat green) — dry-run, nothing appended"
  exit 0
fi
ts="$(date -u +%FT%TZ)"
{ echo "# admitted: $ts via mesh-gate-admission (src $(basename "$cand"), evaluator ${pin:0:8})"
  printf '%s\n' "$row"
} >>"$LEDGER"
[ -s "$ADOPTED" ] || cat > "$ADOPTED" <<'EOF'
# admitted-fixtures — fixture rows adopted with each ADMITTED generated gate (`gate args… want`).
# Generated gates have no independent shell twin, so they ride OUTSIDE mesh-rom-calibrate's
# twin pass; `mesh-gate-admission --recheck` is their liveness gate against the live ledger.
EOF
{ echo "# admitted: $ts $name"; cat "$tmp/fix"; } >>"$ADOPTED"
printf '%s ADMIT name=%s sha1=%s fixtures=%s mutants_red=%s row="%s" src=%s\n' \
  "$ts" "$name" "$pin" "$nfix" "$nmut" "$row" "$cand" >>"$LOG"
echo "ADMIT: $name appended to $LEDGER ($nfix fixtures adopted, $nmut mutants seen red)"
exit 0
