#!/usr/bin/env bash
# test-board-check — RED-first suite for board-check.rom (the fixed-point board watcher).
#
# Every invariant is driven to BOTH polarities (a verdict never seen RED is a
# constant, not a gate), UNKNOWN edges are asserted honest (rc=2, never a fake
# OK or RED), and — when a host cc is present — the load-bearing monotonic
# comparison is INVERTED in a source copy and the same fixtures must catch it
# (the table discriminates, not decorates; test-chibicc pattern).
set -u
here="$(cd "$(dirname "$0")" && pwd)"
cd "$here"
[ -x bin/uxncli ] || ./build.sh >/dev/null
[ -f board-check.rom ] || { echo "board-check-test: n/a (no board-check.rom — run cc-rom.sh)" >&2; exit 2; }
rc=0
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
mkdir "$tmp/w"

# run <romfile>: stages $tmp/nodes + $tmp/board into a fresh cwd, runs the ROM.
run() {
  rm -rf "$tmp/w"; mkdir "$tmp/w"
  [ -f "$tmp/nodes" ] && cp "$tmp/nodes" "$tmp/w/nodes"
  [ -f "$tmp/board" ] && cp "$tmp/board" "$tmp/w/board"
  ( cd "$tmp/w" && "$here/bin/uxncli" "${1:-$here/board-check.rom}" )
}

printf 'mesh-home phaedra\n' >"$tmp/nodes"

# 1) clean board -> OK, rc 0, line count right
printf '%s\n' \
'2026-07-23T10:00:00Z  minds@mesh-home  ::  [task] fix-thing: do it' \
'2026-07-23T10:01:00Z  genome@mesh-home  ::  [taking] genome: fix-thing' \
'2026-07-23T10:02:00Z  chat@phaedra  ::  [fyi] all quiet' \
'2026-07-23T10:03:00Z  genome@mesh-home  ::  [done] genome: fix-thing landed abc123' \
>"$tmp/board"
out=$(run); r=$?
{ [ "$r" -eq 0 ] && [ "$out" = 'OK n=4' ]; } || { echo "FAIL: clean board (rc=$r out='$out')"; rc=1; }

# 2) STRUCTURE: a mangled line goes RED and is NAMED in the output
printf '%s\n' \
'2026-07-23T10:00:00Z  minds@mesh-home  ::  [fyi] fine' \
'garbage line with no timestamp' \
>"$tmp/board"
out=$(run); r=$?
{ [ "$r" -eq 1 ] && echo "$out" | grep -q '^RED STRUCTURE: garbage line' && echo "$out" | tail -1 | grep -q '^RED v=1$'; } \
  || { echo "FAIL: structure violation (rc=$r out='$out')"; rc=1; }

# 3) MONOTONIC: timestamp going backwards goes RED
printf '%s\n' \
'2026-07-23T10:05:00Z  minds@mesh-home  ::  [fyi] later' \
'2026-07-23T10:04:59Z  chat@phaedra  ::  [fyi] earlier' \
>"$tmp/board"
out=$(run); r=$?
{ [ "$r" -eq 1 ] && echo "$out" | grep -q '^RED MONOTONIC: 2026-07-23T10:04:59Z'; } \
  || { echo "FAIL: monotonic violation (rc=$r out='$out')"; rc=1; }

# 4) UNKNOWN-NODE: a host not in ./nodes goes RED
printf '%s\n' \
'2026-07-23T10:00:00Z  minds@mesh-home  ::  [fyi] fine' \
'2026-07-23T10:01:00Z  ghost@not-a-node  ::  [fyi] who am i' \
>"$tmp/board"
out=$(run); r=$?
{ [ "$r" -eq 1 ] && echo "$out" | grep -q '^RED UNKNOWN-NODE: .*not-a-node'; } \
  || { echo "FAIL: unknown-node violation (rc=$r out='$out')"; rc=1; }

# 5) DOUBLE-TAKING: same claim text taken twice with no [done] between -> RED
printf '%s\n' \
'2026-07-23T10:00:00Z  genome@mesh-home  ::  [taking] genome: fix-thing' \
'2026-07-23T10:01:00Z  senses@mesh-home  ::  [taking] senses: fix-thing' \
>"$tmp/board"
out=$(run); r=$?
{ [ "$r" -eq 1 ] && echo "$out" | grep -q '^RED DOUBLE-TAKING: .*senses'; } \
  || { echo "FAIL: double-taking violation (rc=$r out='$out')"; rc=1; }

# 6) release semantics: taking -> done -> taking again is CLEAN (no stale holder)
printf '%s\n' \
'2026-07-23T10:00:00Z  genome@mesh-home  ::  [taking] genome: fix-thing' \
'2026-07-23T10:01:00Z  genome@mesh-home  ::  [done] genome: fix-thing landed' \
'2026-07-23T10:02:00Z  senses@mesh-home  ::  [taking] senses: fix-thing' \
>"$tmp/board"
out=$(run); r=$?
{ [ "$r" -eq 0 ] && [ "$out" = 'OK n=3' ]; } || { echo "FAIL: done must release the claim (rc=$r out='$out')"; rc=1; }

# 7) UNKNOWN edges are honest rc=2, never a fake verdict
: >"$tmp/board"
out=$(run); r=$?
{ [ "$r" -eq 2 ] && echo "$out" | grep -q '^UNKNOWN empty board'; } \
  || { echo "FAIL: empty board must be UNKNOWN rc2 (rc=$r out='$out')"; rc=1; }
printf '2026-07-23T10:00:00Z  minds@mesh-home  ::  [fyi] fine\n' >"$tmp/board"
rm -f "$tmp/nodes"
out=$(run); r=$?
{ [ "$r" -eq 2 ] && echo "$out" | grep -q '^UNKNOWN no nodes'; } \
  || { echo "FAIL: missing nodes must be UNKNOWN rc2 (rc=$r out='$out')"; rc=1; }
printf 'mesh-home phaedra\n' >"$tmp/nodes"

# 8) multiple violations all reported, count right
printf '%s\n' \
'2026-07-23T10:05:00Z  minds@mesh-home  ::  [fyi] fine' \
'2026-07-23T10:04:00Z  ghost@not-a-node  ::  [fyi] bad twice' \
>"$tmp/board"
out=$(run); r=$?
{ [ "$r" -eq 1 ] && echo "$out" | tail -1 | grep -q '^RED v=2$'; } \
  || { echo "FAIL: two violations must count v=2 (rc=$r out='$out')"; rc=1; }

# 9) RED-first mutation (needs host cc): invert the monotonic comparison in a
#    source copy; fixture 3 must sail GREEN through the broken ROM — proving the
#    committed fixtures discriminate. Skipped honestly when no cc.
if command -v "${CC:-cc}" >/dev/null 2>&1; then
  sed 's/if (!mem_ge(s, prev_ts, 20)) violation("MONOTONIC", s, len);/if (0) violation("MONOTONIC", s, len);/' \
    board-check.c >"$tmp/broken.c"
  grep -q 'if (0) violation' "$tmp/broken.c" || { echo "FAIL: mutation did not apply (source drifted?)"; rc=1; }
  if ./cc-rom.sh "$tmp/broken.c" "$tmp/broken.rom" >/dev/null 2>&1; then
    printf '%s\n' \
'2026-07-23T10:05:00Z  minds@mesh-home  ::  [fyi] later' \
'2026-07-23T10:04:59Z  chat@phaedra  ::  [fyi] earlier' \
    >"$tmp/board"
    out=$(run "$tmp/broken.rom"); r=$?
    if [ "$r" -eq 0 ]; then
      echo "PASS: gutted MONOTONIC check sails green — fixtures discriminate (gate seen RED)"
    else
      echo "FAIL: mutated ROM still flags monotonic (rc=$r) — mutation test asserts nothing"; rc=1
    fi
  else
    echo "FAIL: broken-source rebuild errored (should compile, just answer wrong)"; rc=1
  fi
else
  echo "skip: no host cc — mutation subtest not run (committed-ROM fixtures still asserted)"
fi

# 10) the WRAPPER end-to-end (it must exercise the thing it wraps — 974d864):
#     real ROM run over a staged fixture log, sha1 stamp present, edge posts on
#     BOTH transitions (OK->RED and RED->OK — both edges, one gate).
wl="$tmp/wrap.log"; ws="$tmp/wrap.state"
wrap() { MESH_BOARD_LOG="$wl" MESH_BOARD_STATE="$ws" MESH_BOARD_SANDBOX=1 \
         MESH_BOARD_EXTRA_HOSTS='mesh-home phaedra' "$here/mesh-board-check"; }
printf '%s\n' \
'2026-07-23T10:00:00Z  minds@mesh-home  ::  [fyi] fine' \
'2026-07-23T10:01:00Z  chat@phaedra  ::  [fyi] also fine' \
>"$wl"
out=$(wrap); r=$?
{ [ "$r" -eq 0 ] && echo "$out" | grep -Eq '^board-check: OK n=2 src=rom sha1=[0-9a-f]{40} '; } \
  || { echo "FAIL: wrapper clean run (rc=$r out='$out')"; rc=1; }
sha_stamped=$(echo "$out" | sed -n 's/.*sha1=\([0-9a-f]*\).*/\1/p' | head -1)
[ "$sha_stamped" = "$(sha1sum board-check.rom | cut -d' ' -f1)" ] \
  || { echo "FAIL: wrapper stamp is not the sha1 of the ROM it ran"; rc=1; }
printf '2026-07-23T09:59:00Z  ghost@nowhere  ::  [fyi] late and alien\n' >>"$wl"
out=$(wrap); r=$?
{ [ "$r" -eq 1 ] && echo "$out" | grep -q 'would-post: board-check OK->RED'; } \
  || { echo "FAIL: wrapper OK->RED edge (rc=$r out='$out')"; rc=1; }
printf '%s\n' \
'2026-07-23T10:00:00Z  minds@mesh-home  ::  [fyi] fine again' \
>"$wl"
out=$(wrap); r=$?
{ [ "$r" -eq 0 ] && echo "$out" | grep -q 'would-post: board-check RED->OK'; } \
  || { echo "FAIL: wrapper RED->OK recovery edge (rc=$r out='$out')"; rc=1; }

[ "$rc" = 0 ] && echo "board-check-test: ok" || echo "board-check-test: FAIL"
exit $rc
