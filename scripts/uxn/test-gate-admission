#!/usr/bin/env bash
# test-gate-admission — gate for uxn-gate-admission (gates-as-data stage 3, 2026-07-23).
#
# CONTRACT: generated candidate gates enter the threshold ledger ONLY through
# ./mesh-gate-admission. A candidate file carries one `row:` (threshold-ledger 4-field form)
# and its own `fix:` rows; admission = structure + token whitelist (the evaluator's op set,
# params, const keys, naturals — nothing else) + eval under the ledger's pinned lisp-eval.rom
# (hash-then-execute inherited from mesh-sexpr-gate) + every candidate fixture green + the
# committed calibration pass still green with the row appended + EVERY derived mutant
# (each const ±1, each comparison flipped) seen RED against the candidate's own fixtures —
# a candidate whose mutants survive admits nothing. Adopt = append row to the ledger +
# fixtures to ./admitted-fixtures + ADMIT line in the admission log; reject = REJECT line
# with the reason. --recheck re-drives every admitted fixture row. NO candidate touches a
# consumer until admitted.
set -u
here="$(cd "$(dirname "$0")" && pwd)"
cd "$here"
[ -x bin/uxncli ] || ./build.sh >/dev/null 2>&1 || { echo "gate-admission-test: n/a (no uxncli and toolchain build failed)" >&2; exit 2; }
[ -f lisp-eval.rom ] || { echo "gate-admission-test: n/a (no lisp-eval.rom)" >&2; exit 2; }
[ -x mesh-gate-admission ] || { echo "gate-admission-test: FAIL (no mesh-gate-admission)"; exit 1; }
rc=0
tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT
fail(){ echo "  FAIL: $*"; rc=1; }

# hermetic sandbox: private copies of ledger + fixtures + admitted + log
sand(){ # reset the sandbox to the committed state
  cp threshold-ledger "$tmp/ledger"
  cp threshold-fixtures "$tmp/fixtures"
  : > "$tmp/admitted"
  : > "$tmp/log"
}
adm(){ # verb + args under the sandbox env
  MESH_ADMIT_LEDGER="$tmp/ledger" MESH_ADMIT_FIXTURES="$tmp/fixtures" \
  MESH_ADMIT_ADOPTED="$tmp/admitted" MESH_ADMIT_LOG="$tmp/log" \
  ./mesh-gate-admission "$@" 2>"$tmp/err"
}

good_candidate(){ # a candidate with boundary-discriminating fixtures — must ADMIT
  cat > "$tmp/good.cand" <<'EOF'
# candidate: cpu-hot — 1 HOT when t >= hot, else 0
row: cpu-hot | t | hot=85 | (if (>= t hot) 1 0)
fix: cpu-hot 84 0
fix: cpu-hot 85 1
fix: cpu-hot 86 1
fix: cpu-hot 0 0
EOF
}

# --- A. ADMIT end-to-end: row appended under the pin, fixtures adopted, log line ---------
sand; good_candidate
out="$(adm --admit "$tmp/good.cand")" || fail "good candidate rc!=0: $out $(cat "$tmp/err")"
sed 's/[[:space:]]*|.*//' "$tmp/ledger" | grep -qx 'cpu-hot' || fail "admitted row not appended to ledger"
grep -q '^cpu-hot 85 1' "$tmp/admitted" || fail "admitted fixtures not adopted"
grep -q 'ADMIT name=cpu-hot' "$tmp/log" || fail "no ADMIT line in admission log"
# the admitted gate must actually run through the standard shim against the mutated ledger
v="$(MESH_SEXPR_GATES="$tmp/ledger" ./mesh-sexpr-gate cpu-hot 90 2>/dev/null)"
[ "$v" = 1 ] || fail "admitted gate does not evaluate through mesh-sexpr-gate (got '$v')"
# committed calibration still green with the admitted row present
out="$(MESH_CAL_SANDBOX=1 MESH_CAL_LOG="$tmp/cal.log" MESH_SEXPR_GATES="$tmp/ledger" ./mesh-rom-calibrate --ledger "$tmp/fixtures" 2>&1)" \
  || fail "calibrate --ledger broke after admit: $out"

# --- B. --recheck: green after admit, RED when the ledger drifts under the admitted rows --
out="$(adm --recheck)" || fail "--recheck rc!=0 after clean admit: $out $(cat "$tmp/err")"
sed -i 's/hot=85/hot=99/' "$tmp/ledger"      # recalibration nobody re-admitted
adm --recheck >/dev/null && fail "--recheck stayed green after admitted-gate drift (must go RED)"

# --- C. REJECT: mutant survives (no boundary fixtures) — reason logged, nothing appended --
sand
cat > "$tmp/weak.cand" <<'EOF'
row: weak-hot | t | hot=85 | (if (>= t hot) 1 0)
fix: weak-hot 10 0
fix: weak-hot 200 1
EOF
adm --admit "$tmp/weak.cand" >/dev/null; arc=$?
[ "$arc" -eq 1 ] || fail "mutant-survivor candidate must rc=1, got $arc"
grep -q 'REJECT name=weak-hot' "$tmp/log" || fail "no REJECT line for mutant survivor"
grep -qi 'mutant' "$tmp/log" || fail "REJECT reason does not name the surviving mutant"
grep -q 'weak-hot' "$tmp/ledger" && fail "rejected candidate leaked into the ledger"

# --- D. REJECT: unknown/unbound token (the injection edge) --------------------------------
sand
cat > "$tmp/tok.cand" <<'EOF'
row: tok-gate | x | k=5 | (if (>= x bogus) 1 0)
fix: tok-gate 1 0
fix: tok-gate 9 1
EOF
adm --admit "$tmp/tok.cand" >/dev/null; arc=$?
[ "$arc" -eq 1 ] || fail "unbound-token candidate must rc=1, got $arc"
grep -qi 'token' "$tmp/log" || fail "REJECT reason does not name the bad token"

# --- E. REJECT: duplicate name (cannot shadow a committed gate) ---------------------------
sand
cat > "$tmp/dup.cand" <<'EOF'
row: clear-fresh | age | fresh=100 | (if (<= age fresh) 1 0)
fix: clear-fresh 100 1
fix: clear-fresh 101 0
EOF
adm --admit "$tmp/dup.cand" >/dev/null; arc=$?
[ "$arc" -eq 1 ] || fail "duplicate-name candidate must rc=1, got $arc"
grep -qi 'REJECT name=clear-fresh.*exist' "$tmp/log" || fail "REJECT reason does not say the name exists"

# --- F. REJECT: degenerate fixtures (single want value discriminates nothing) -------------
sand
cat > "$tmp/deg.cand" <<'EOF'
row: deg-gate | x | k=5 | (if (>= x k) 1 0)
fix: deg-gate 6 1
fix: deg-gate 9 1
EOF
adm --admit "$tmp/deg.cand" >/dev/null; arc=$?
[ "$arc" -eq 1 ] || fail "single-want candidate must rc=1, got $arc"

# --- G. REJECT: red fixture (candidate's own numbers wrong) -------------------------------
sand
cat > "$tmp/red.cand" <<'EOF'
row: red-gate | x | k=5 | (if (>= x k) 1 0)
fix: red-gate 4 1
fix: red-gate 9 0
EOF
adm --admit "$tmp/red.cand" >/dev/null; arc=$?
[ "$arc" -eq 1 ] || fail "red-fixture candidate must rc=1, got $arc"
grep -qi 'fixture' "$tmp/log" || fail "REJECT reason does not cite the red fixture"

# --- H. non-natural fixture arg refused (injection via args) ------------------------------
sand
cat > "$tmp/inj.cand" <<'EOF'
row: inj-gate | x | k=5 | (if (>= x k) 1 0)
fix: inj-gate (+11) 1
fix: inj-gate 1 0
EOF
adm --admit "$tmp/inj.cand" >/dev/null; arc=$?
[ "$arc" -eq 1 ] || fail "non-natural fixture arg must rc=1, got $arc"

# --- I. pin mismatch = environment n/a rc=2, never a verdict on the candidate -------------
sand; good_candidate
sed -i 's/^# evaluator-sha1: ./# evaluator-sha1: 0/' "$tmp/ledger"
adm --admit "$tmp/good.cand" >/dev/null; arc=$?
[ "$arc" -eq 2 ] || fail "pin mismatch must rc=2 (honest n/a), got $arc"

# --- J. --check is a dry-run: verdict without adoption ------------------------------------
sand; good_candidate
adm --check "$tmp/good.cand" >/dev/null || fail "--check on good candidate rc!=0"
grep -q 'cpu-hot' "$tmp/ledger" && fail "--check must not append to the ledger"

# --- K. --propose writes an untrusted candidate file from the generator (stubbed relay) ---
sand
cat > "$tmp/relay-stub" <<'EOF'
#!/usr/bin/env bash
cat <<'CAND'
Some model chatter around the block.
row: disk-floor | free_mb | floor=2048 | (if (>= free_mb floor) 1 0)
fix: disk-floor 2047 0
fix: disk-floor 2048 1
fix: disk-floor 2049 1
more trailing chatter
CAND
EOF
chmod +x "$tmp/relay-stub"
out="$(MESH_ADMIT_RELAY="$tmp/relay-stub" MESH_ADMIT_CAND_DIR="$tmp/cands" adm --propose "disk free floor gate")" \
  || fail "--propose rc!=0: $out $(cat "$tmp/err")"
cf="$(ls "$tmp/cands"/*.cand 2>/dev/null | head -1)"
[ -n "$cf" ] || fail "--propose wrote no candidate file"
if [ -n "$cf" ]; then
  grep -q '^row: disk-floor' "$cf" || fail "candidate file lost the row line"
  grep -q 'chatter' "$cf" && fail "candidate file kept non-candidate chatter (must be scrubbed)"
  adm --admit "$cf" >/dev/null || fail "proposed disk-floor candidate should admit: $(cat "$tmp/err")"
fi

[ "$rc" -eq 0 ] && echo "gate-admission-test: ok (admit e2e + recheck red-on-drift + 6 reject classes + pin n/a + dry-run + propose-scrub)"
exit "$rc"
