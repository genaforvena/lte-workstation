#!/usr/bin/env bash
# mesh-uxn-hop — ROM-as-packet pipe stage: the code travels WITH the data.
#
# packet (uxp1):  "uxp1 <rom_bytes>\n"  +  <rom bytes, raw>  +  <payload…>
#
#   --pack <rom>   stdin = payload  ->  stdout = packet
#   (no args)      stdin = packet   ->  run the shipped ROM on the payload -> stdout
#   --test         run the adjacent test-uxn-hop suite
#
# transport stays ssh/tailscale; this is the mobile-code layer:
#   mesh-uxn-hop --pack filter.rom < text | ssh node mesh-uxn-hop
# The receiving side needs only uxncli + this script — the behavior arrives in-band.
#
# Containment: the ROM executes under the vendored uxncli, whose only devices are
# console/file/datetime, and whose file device is sandboxed to cwd (file.c
# file_check_sandbox — realpath outside cwd is blocked with a loud stderr warning).
# The hop therefore runs uxncli in a FRESH EMPTY tempdir: a hostile ROM has nothing
# to read and nowhere to write. Malformed/truncated packets fail LOUD — never a
# silent passthrough of the raw payload (the silent-fallback doctrine).
set -u
here="$(cd "$(dirname "$0")" && pwd)"

find_cli() {
  [ -n "${UXN_HOP_CLI:-}" ] && { printf '%s\n' "$UXN_HOP_CLI"; return; }
  for c in "$here/bin/uxncli" "$here/uxncli"; do
    [ -x "$c" ] && { printf '%s\n' "$c"; return; }
  done
  command -v uxncli 2>/dev/null || true
}

case "${1:-}" in
  --pack)
    rom="${2:-}"
    [ -n "$rom" ] || { echo "hop: usage: mesh-uxn-hop --pack <rom>" >&2; exit 64; }
    [ -s "$rom" ] || { echo "hop: no such rom (or empty): $rom" >&2; exit 66; }
    n=$(wc -c <"$rom")
    [ "$n" -le 65536 ] || { echo "hop: rom too big ($n > 65536)" >&2; exit 64; }
    printf 'uxp1 %d\n' "$n"
    cat -- "$rom"
    exec cat                       # payload flows straight through
    ;;
  --test)
    exec "$here/test-uxn-hop"
    ;;
  '')
    cli="$(find_cli)"
    [ -n "$cli" ] && [ -x "$cli" ] || { echo "hop: uxncli not found (set UXN_HOP_CLI or put it beside me)" >&2; exit 69; }
    IFS= read -r hdr || { echo "hop: empty stream (no uxp1 header)" >&2; exit 65; }
    case "$hdr" in
      'uxp1 '*) n="${hdr#uxp1 }" ;;
      *) echo "hop: bad header (not uxp1): ${hdr:0:40}" >&2; exit 65 ;;
    esac
    case "$n" in ''|*[!0-9]*) echo "hop: bad rom size: '$n'" >&2; exit 65 ;; esac
    [ "$n" -ge 1 ] && [ "$n" -le 65536 ] || { echo "hop: rom size out of range: $n" >&2; exit 65; }
    work="$(mktemp -d "${TMPDIR:-/tmp}/uxn-hop.XXXXXX")"
    trap 'rm -rf "$work"' EXIT
    # exact byte read off the pipe (head -c may over-consume a nonseekable stream)
    dd bs=1 count="$n" status=none of="$work/shipped.rom"
    got=$(wc -c <"$work/shipped.rom")
    [ "$got" -eq "$n" ] || { echo "hop: truncated rom (header says $n, stream had $got)" >&2; exit 65; }
    mkdir "$work/run"              # fresh EMPTY cwd = the file-device sandbox
    # rom path sits OUTSIDE the run dir: uxncli loads it via system_boot (not the
    # sandboxed file device), so the ROM itself cannot re-read or overwrite it.
    cd "$work/run" && exec_rc=0
    "$cli" "$work/shipped.rom" || exec_rc=$?   # payload continues on our stdin
    exit "$exec_rc"
    ;;
  *)
    echo "usage: mesh-uxn-hop [--pack <rom>] [--test]   (packet on stdin)" >&2
    exit 64
    ;;
esac
