#!/bin/sh
# mesh-uxn-hop — ROM-as-packet pipe stage: the code travels WITH the data.
#
# STRICTLY POSIX sh (test 15): the SAME script is the receiver on body nodes under
# busybox ash (Note3, stage 4c) — a bashism here strands the mobile-code layer at
# the door of exactly the nodes it exists to reach.
#
# packet (uxp1):  "uxp1 <rom_bytes>\n"  +  <rom bytes, raw>  +  <payload…>
#
#   --pack <rom>        stdin = payload  ->  stdout = packet (payload reaches the ROM on stdin)
#   --pack-argv <rom>   same, but header carries the "argv" mode token: the receiver hands the
#                       payload to the ROM as ARGV (text only — $(cat) delivery; NULs don't
#                       survive, trailing newlines are stripped). The lane for evaluator ROMs:
#                       lisp-eval takes its expression via argv and NAs on a bare stdin.
#   --pack-net <rom>    the NET lane (see below): mode "net <token>". The shipped ROM will be
#                       handed a LIVE SOCKET, not a console — it must read and answer there.
#   (no args)           stdin = packet   ->  run the shipped ROM on the payload -> stdout
#   --dial <addr>       stdin = packet   ->  send it over TCP, print what comes back
#   --serve <bindaddr>  bind, accept ONE caller, and become the ROM it sends
#   --test              run the adjacent test-uxn-hop suite
#
# PIPE LANE (--pack/--pack-argv): transport is ssh/tailscale, this is the mobile-code layer:
#   mesh-uxn-hop --pack filter.rom < text | ssh node mesh-uxn-hop
# The receiving side needs only uxncli + this script — the behavior arrives in-band.
#
# NET LANE (--pack-net/--dial/--serve): transport is the emulator's own 0xd0 device, and the
# receiving side needs NO SHELL AT ALL — only `uxncli hop-serve.rom <bindaddr> <token>`:
#   UXN_HOP_TOKEN=… mesh-uxn-hop --pack-net rot13-net.rom < text | \
#   UXN_HOP_TOKEN=… mesh-uxn-hop --dial tcp:100.x.y.z:47311
# hop-serve reads the packet off the socket and REPLACES ITSELF with the ROM that arrived
# (staged at 4000, a position-independent copier relocated to 8000, then a jump to 0100).
# The connection survives that swap because it lives in the DEVICE, not in the 64 KB being
# overwritten — so the arriving ROM wakes holding a live inbound connection on channel 1.
#
# WHAT THE NET LANE GIVES UP, said out loud: the sh receiver above hashes the ROM it received
# and refuses on a mismatch. A ROM cannot compute sha1 in a few hundred bytes, so hop-serve
# CANNOT verify what it is about to run; it demands a shared TOKEN instead (UXN_HOP_TOKEN,
# carried in the header, compared in the ROM), so reaching the port is not by itself
# permission to run code there. That is weaker than ssh key auth and it is replayable by
# anyone who sees a packet — hence: no default token ever, and bind a named tailnet address,
# never '*'. The trade is real; hiding it would be the fault.
#
# Containment: the ROM executes under the vendored uxncli, whose only devices are
# console/file/datetime, and whose file device is sandboxed to cwd (file.c
# file_check_sandbox — realpath outside cwd is blocked with a loud stderr warning).
# The hop therefore runs uxncli in a FRESH EMPTY tempdir: a hostile ROM has nothing
# to read and nowhere to write. Malformed/truncated packets fail LOUD — never a
# silent passthrough of the raw payload (the silent-fallback doctrine).
set -u
here="$(cd "$(dirname "$0")" && pwd)"

find_cli() {
  [ -n "${UXN_HOP_CLI:-}" ] && { printf '%s\n' "$UXN_HOP_CLI"; return; }
  for c in "$here/bin/uxncli" "$here/uxncli"; do
    [ -x "$c" ] && { printf '%s\n' "$c"; return; }
  done
  command -v uxncli 2>/dev/null || true
}

find_rom() {
  for r in "$here/$1" "$here/../$1"; do
    [ -s "$r" ] && { printf '%s\n' "$r"; return; }
  done
}

# The token is REQUIRED and never defaulted: a built-in default token is a shared secret
# that is not secret, i.e. the silent-fallback shape with the security label on.
hop_token() {
  t="${UXN_HOP_TOKEN:-}"
  [ -n "$t" ] || { echo "hop: UXN_HOP_TOKEN is unset — the net lane has no default token" >&2; exit 78; }
  case "$t" in
    *' '*|*'	'*) echo "hop: UXN_HOP_TOKEN must not contain whitespace (it is a header field)" >&2; exit 78 ;;
  esac
  printf '%s\n' "$t"
}

case "${1:-}" in
  --pack|--pack-argv|--pack-net)
    mode=''
    [ "$1" = --pack-argv ] && mode=' argv'
    # NOT `mode=" net $(hop_token)"`: hop_token's exit 78 would kill only the SUBSHELL, the
    # assignment would land empty, and the packet would ship with a blank token. Capture,
    # then check — an abort that only aborts a subshell is not an abort.
    if [ "$1" = --pack-net ]; then
      tok="$(hop_token)" || exit 78
      [ -n "$tok" ] || exit 78
      mode=" net $tok"
    fi
    rom="${2:-}"
    [ -n "$rom" ] || { echo "hop: usage: mesh-uxn-hop $1 <rom>" >&2; exit 64; }
    [ -s "$rom" ] || { echo "hop: no such rom (or empty): $rom" >&2; exit 66; }
    n=$(wc -c <"$rom")
    [ "$n" -le 65536 ] || { echo "hop: rom too big ($n > 65536)" >&2; exit 64; }
    sha=$(sha1sum -- "$rom" | cut -d' ' -f1)
    printf 'uxp1 %d %s%s\n' "$n" "$sha" "$mode"
    cat -- "$rom"
    exec cat                       # payload flows straight through
    ;;
  --dial)
    addr="${2:-}"
    [ -n "$addr" ] || { echo "hop: usage: mesh-uxn-hop --dial tcp:host:port  (packet on stdin)" >&2; exit 64; }
    cli="$(find_cli)"; dial="$(find_rom hop-dial.rom)"
    [ -n "$cli" ] && [ -x "$cli" ] || { echo "hop: uxncli not found (set UXN_HOP_CLI or put it beside me)" >&2; exit 69; }
    [ -n "$dial" ] || { echo "hop: hop-dial.rom not found beside me" >&2; exit 69; }
    exec "$cli" "$dial" "$addr"
    ;;
  --serve)
    addr="${2:-}"
    [ -n "$addr" ] || { echo "hop: usage: mesh-uxn-hop --serve tcp:host:port" >&2; exit 64; }
    tok="$(hop_token)" || exit 78
    cli="$(find_cli)"; serve="$(find_rom hop-serve.rom)"
    [ -n "$cli" ] && [ -x "$cli" ] || { echo "hop: uxncli not found (set UXN_HOP_CLI or put it beside me)" >&2; exit 69; }
    [ -n "$serve" ] || { echo "hop: hop-serve.rom not found beside me" >&2; exit 69; }
    # absolute paths BEFORE the cd: the arriving ROM runs in a fresh empty dir, which is the
    # file device's sandbox floor (file.c file_check_sandbox). It matters more here than in
    # the pipe lane — nothing hashed this ROM, so its reach is the only containment left.
    cli="$(cd "$(dirname "$cli")" && pwd)/$(basename "$cli")"
    serve="$(cd "$(dirname "$serve")" && pwd)/$(basename "$serve")"
    work="$(mktemp -d "${TMPDIR:-/tmp}/uxn-serve.XXXXXX")"
    trap 'rm -rf "$work"' EXIT
    cd "$work" || exit 70
    "$cli" "$serve" "$addr" "$tok" </dev/null
    exit $?
    ;;
  --test)
    exec "$here/test-uxn-hop"
    ;;
  '')
    cli="$(find_cli)"
    [ -n "$cli" ] && [ -x "$cli" ] || { echo "hop: uxncli not found (set UXN_HOP_CLI or put it beside me)" >&2; exit 69; }
    IFS= read -r hdr || { echo "hop: empty stream (no uxp1 header)" >&2; exit 65; }
    case "$hdr" in
      'uxp1 '*) rest="${hdr#uxp1 }" ;;
      *) echo "hop: bad header (not uxp1): $(printf '%.40s' "$hdr")" >&2; exit 65 ;;
    esac
    n="${rest%% *}"
    rest="${rest#"$n"}"; rest="${rest# }"
    declared="${rest%% *}"                              # optional 3rd field: declared sha1
    mode="${rest#"$declared"}"; mode="${mode# }"        # optional 4th field: delivery mode
    case "$n" in ''|*[!0-9]*) echo "hop: bad rom size: '$n'" >&2; exit 65 ;; esac
    [ "$n" -ge 1 ] && [ "$n" -le 65536 ] || { echo "hop: rom size out of range: $n" >&2; exit 65; }
    if [ -n "$declared" ]; then
      case "$declared" in
        *[!0-9a-f]*) echo "hop: bad declared sha1: '$declared'" >&2; exit 65 ;;
      esac
      [ "${#declared}" -eq 40 ] || { echo "hop: bad declared sha1 width: '$declared'" >&2; exit 65; }
    fi
    # unknown mode = refuse LOUD; a receiver too old for a mode must never silently fall
    # back to stdin delivery (the payload would reach the ROM by the WRONG channel).
    case "$mode" in
      ''|argv) ;;
      net|net\ *)
        # A net-lane ROM answers on a SOCKET, and this receiver has none to give it. Running
        # it anyway would look like a working hop while every answer went to a console
        # nobody is reading — the two lanes refuse each other by name, in both directions.
        echo "hop: this is a NET-lane packet: its ROM answers on a socket, and the pipe lane has none. Send it with --dial to a --serve node." >&2; exit 65 ;;
      *) echo "hop: unknown delivery mode: '$mode'" >&2; exit 65 ;;
    esac
    work="$(mktemp -d "${TMPDIR:-/tmp}/uxn-hop.XXXXXX")"
    trap 'rm -rf "$work"' EXIT
    # exact byte read off the pipe (head -c may over-consume a nonseekable stream);
    # no status=none — not POSIX (Android's dd rejects it); stats go to /dev/null, and
    # a short read is caught LOUD by the byte-accounting check just below.
    dd bs=1 count="$n" of="$work/shipped.rom" 2>/dev/null
    got=$(wc -c <"$work/shipped.rom")
    [ "$got" -eq "$n" ] || { echo "hop: truncated rom (header says $n, stream had $got)" >&2; exit 65; }
    # run-time verification, not claim: hash what actually arrived, BEFORE executing it.
    # A declared hash that mismatches = refuse loud. Undeclared = run, but the stamp
    # says so (declared=none) — visible, never silent.
    actual=$(sha1sum "$work/shipped.rom" | cut -d' ' -f1)
    if [ -n "$declared" ] && [ "$actual" != "$declared" ]; then
      echo "hop: rom sha1 mismatch — declared $declared, received $actual; refusing to execute" >&2
      exit 65
    fi
    mkdir "$work/run"              # fresh EMPTY cwd = the file-device sandbox
    # rom path sits OUTSIDE the run dir: uxncli loads it via system_boot (not the
    # sandboxed file device), so the ROM itself cannot re-read or overwrite it.
    cd "$work/run" && exec_rc=0
    if [ "$mode" = argv ]; then
      payload="$(cat)"             # text-only by contract (header doc): NULs lost, trailing \n stripped
      "$cli" "$work/shipped.rom" "$payload" </dev/null || exec_rc=$?
    else
      "$cli" "$work/shipped.rom" || exec_rc=$?   # payload continues on our stdin
    fi
    [ "${UXN_HOP_STAMP:-0}" = 1 ] && \
      echo "hop: rom sha1=$actual declared=${declared:-none} rc=$exec_rc" >&2
    exit "$exec_rc"
    ;;
  *)
    echo "usage: mesh-uxn-hop [--pack|--pack-argv|--pack-net <rom>] [--dial <addr>] [--serve <bindaddr>] [--test]   (packet on stdin)" >&2
    exit 64
    ;;
esac
