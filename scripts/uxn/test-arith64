#!/usr/bin/env bash
# test-arith64 — truth table for the 64-bit quad-word primitives, with EVERY link of the
# carry chain proven red on its own.
#
# arith32 had one carry to lose. This file has three links per chain and two ways to lose
# each one, because a word past the first takes a carry IN as well as producing one OUT and
# either addition can wrap. None of those failures crashes or looks wrong — the high words
# simply stop advancing and the answer comes back smaller, plausible, and occasionally
# right, which is the silent fallback the doctrine forbids by name. So section C rebuilds
# the ROM with each link deleted individually and REQUIRES the table to fail; a link whose
# deletion leaves the table green means the boundary it governs is not covered, and the
# table gets a row rather than the mutant getting an excuse.
set -eu
here="$(cd "$(dirname "$0")" && pwd)"
cd "$here"
tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT
rc=0
fail(){ echo "  FAIL: $*"; rc=1; }
UXNCLI="${MESH_UXNCLI:-$here/bin/uxncli}"
ASM="$here/bin/uxnasm"
[ -x "$UXNCLI" ] || { echo "arith64-test: n/a — no uxncli (run ./build.sh)"; exit 2; }
[ -x "$ASM" ]    || { echo "arith64-test: n/a — no uxnasm (run ./build.sh)"; exit 2; }

run(){ local rom="$1"; shift; printf '%s\n' "$@" | "$UXNCLI" "$rom" 2>/dev/null; }

# op A B want   — every row is a boundary, and the comment names the link it pins.
# 0=add 1=sub 2=cmp 3=mul16 4=mul32.  M64 = 18446744073709551615 = 0xFFFFFFFFFFFFFFFF.
table(){ cat <<'ROWS'
0 1 1 0000000000000002
0 65535 1 0000000000010000
0 4294967295 1 0000000100000000
0 281474976710655 1 0001000000000000
0 18446744073709551615 1 0000000000000000
0 9223372036854775808 9223372036854775807 FFFFFFFFFFFFFFFF
0 4294967295 4294967295 00000001FFFFFFFE
0 281474976710655 281474976710655 0001FFFFFFFFFFFE
1 65536 1 000000000000FFFF
1 0 1 FFFFFFFFFFFFFFFF
1 4294967296 4294967297 FFFFFFFFFFFFFFFF
1 281479271677952 281479271677953 FFFFFFFFFFFFFFFF
1 18446744073709551615 18446744073709551615 0000000000000000
1 281474976710656 1 0000FFFFFFFFFFFF
2 5 5 0000000000000001
2 4 5 0000000000000000
2 65536 65535 0000000000000001
2 65535 65536 0000000000000000
2 4294967296 4294967295 0000000000000001
2 4294967295 4294967296 0000000000000000
2 281474976710656 281474976710655 0000000000000001
2 18446744073709551615 18446744073709551614 0000000000000001
3 0 0 0000000000000000
3 65535 65535 00000000FFFE0001
3 40000 40000 000000005F5E1000
3 4294967295 65535 0000FFFEFFFF0001
3 281474976710655 65535 FFFEFFFFFFFF0001
4 65536 65536 0000000100000000
4 1000000 1000000 000000E8D4A51000
4 4294967295 4294967295 FFFFFFFE00000001
4 4294967295 1 00000000FFFFFFFF
4 123456789 987654321 01B13114FBFF5385
1 65536 131072 FFFFFFFFFFFF0000
1 4294967296 8589934592 FFFFFFFF00000000
3 131075 65535 000000020000FFFD
3 8590131200 65535 00020000FFFD0000
ROWS
}

check_table(){ # $1=rom → 0 all rows match, 1 any row differs
  local rom="$1" op a b want got
  while read -r op a b want; do
    [ -n "${op:-}" ] || continue
    got="$(run "$rom" "$op" "$a" "$b")"
    [ "$got" = "$want" ] || { echo "op=$op a=$a b=$b: want $want, got $got"; return 1; }
  done < <(table)
  return 0
}

# `--table` prints the rows and exits: verify-note3.sh drives the SAME table on the phone,
# and a second copy of it over there is a copy that drifts.
if [ "${1:-}" = --table ]; then table; exit 0; fi

# --- A. the committed ROM satisfies the table -------------------------------------------
[ -f arith64-test.rom ] || fail "no arith64-test.rom (run ./build.sh --rom)"
msg="$(check_table arith64-test.rom)" || fail "committed ROM vs truth table: $msg"

# --- B. the committed ROM is the committed SOURCE ----------------------------------------
"$ASM" arith64-test.tal "$tmp/rebuilt.rom" >/dev/null 2>&1 || fail "arith64-test.tal does not assemble"
cmp -s arith64-test.rom "$tmp/rebuilt.rom" || fail "arith64-test.rom has drifted from arith64-test.tal"

# --- C. RED on every link of every carry chain -------------------------------------------
# Replacement is by LITERAL text and by OCCURRENCE INDEX, not by regex: two of these lines
# are byte-identical to a sibling one word up, and a sed that silently mutated both would
# be testing "delete two carries", which is a weaker claim that always goes red.
mutate(){ # $1=file $2=literal $3=replacement $4=occurrence(1-based) → writes $tmp/mut.src
  python3 - "$1" "$2" "$3" "$4" "$tmp/mut.src" <<'PY'
import sys
src, lit, rep, occ, out = sys.argv[1], sys.argv[2], sys.argv[3], int(sys.argv[4]), sys.argv[5]
s = open(src).read()
n = s.count(lit)
if n < occ:
    sys.exit("pattern found %d time(s), wanted occurrence %d" % (n, occ))
i = -1
for _ in range(occ):
    i = s.index(lit, i + 1)
open(out, "w").write(s[:i] + rep + s[i + len(lit):])
PY
}

mutant_red(){ # $1=literal $2=replacement $3=occurrence $4=label
  cp arith64.tal "$tmp/arith64.tal.bak"
  if ! mutate arith64.tal "$1" "$2" "$3" 2>"$tmp/mut.err"; then
    fail "$4: mutation did not apply ($(cat "$tmp/mut.err"))"; return
  fi
  if cmp -s arith64.tal "$tmp/mut.src"; then fail "$4: mutation was a no-op"; return; fi
  cp "$tmp/mut.src" arith64.tal
  local built=1
  "$ASM" arith64-test.tal "$tmp/mut.rom" >/dev/null 2>&1 || built=0
  cp "$tmp/arith64.tal.bak" arith64.tal
  [ "$built" = 1 ] || { fail "$4: mutant does not assemble"; return; }
  if check_table "$tmp/mut.rom" >/dev/null 2>&1; then
    fail "$4: truth table STILL GREEN with this link deleted — the boundary it governs is not covered"
  fi
}

# q-add: word 0 has one link; words 1 and 2 have two each (own wrap, then carry-in wrap).
mutant_red '#70 LDZ2 #66 LDZ2 LTH2 #00 SWP #78 STZ2' '#0000 #78 STZ2                          ' 1 \
  "q-add: word0 -> word1 carry deleted"
mutant_red '#72 LDZ2 #64 LDZ2 LTH2 #00 SWP #7a STZ2' '#0000 #7a STZ2                          ' 1 \
  "q-add: word1 own-wrap carry deleted"
mutant_red '#74 LDZ2 #72 LDZ2 LTH2 #00 SWP #7a LDZ2 ADD2 #7a STZ2' '#7a LDZ2 #7a STZ2                                    ' 1 \
  "q-add: word1 carry-in wrap deleted (the link arith32 never had)"
mutant_red '#72 LDZ2 #62 LDZ2 LTH2 #00 SWP #7c STZ2' '#0000 #7c STZ2                          ' 1 \
  "q-add: word2 own-wrap carry deleted"
mutant_red '#74 LDZ2 #72 LDZ2 LTH2 #00 SWP #7c LDZ2 ADD2 #7c STZ2' '#7c LDZ2 #7c STZ2                                    ' 1 \
  "q-add: word2 carry-in wrap deleted"
# q-sub: the same three links from the borrow side.
mutant_red '#66 LDZ2 #6e LDZ2 LTH2 #00 SWP #78 STZ2' '#0000 #78 STZ2                          ' 1 \
  "q-sub: word0 -> word1 borrow deleted"
mutant_red '#64 LDZ2 #6c LDZ2 LTH2 #00 SWP #7a STZ2' '#0000 #7a STZ2                          ' 1 \
  "q-sub: word1 own borrow deleted"
mutant_red '#72 LDZ2 #78 LDZ2 LTH2 #00 SWP #7a LDZ2 ADD2 #7a STZ2' '#7a LDZ2 #7a STZ2                                    ' 1 \
  "q-sub: word1 borrow-in underflow deleted"
mutant_red '#62 LDZ2 #6a LDZ2 LTH2 #00 SWP #7c STZ2' '#0000 #7c STZ2                          ' 1 \
  "q-sub: word2 own borrow deleted"
mutant_red '#72 LDZ2 #7a LDZ2 LTH2 #00 SWP #7c LDZ2 ADD2 #7c STZ2' '#7c LDZ2 #7c STZ2                                    ' 1 \
  "q-sub: word2 borrow-in underflow deleted"
# q-mul16: the two interior words carry a 32-bit product's high half forward, and the
# addition of that carry can itself wrap. These two lines are byte-identical, hence the
# occurrence index — deleting both at once would prove less, not more.
mutant_red '#8a LDZ2 #42 LDZ2 LTH2 #00 SWP #40 LDZ2 ADD2 #88 STZ2' '#40 LDZ2 #88 STZ2                                        ' 1 \
  "q-mul16: word1 carry-add wrap deleted"
mutant_red '#8a LDZ2 #42 LDZ2 LTH2 #00 SWP #40 LDZ2 ADD2 #88 STZ2' '#40 LDZ2 #88 STZ2                                        ' 2 \
  "q-mul16: word2 carry-add wrap deleted"
# q-mul32: the partials are only right if each lands at its own word offset.
mutant_red '#0000 #68 STZ2 #40 LDZ2 #6a STZ2 #42 LDZ2 #6c STZ2 #0000 #6e STZ2' '#0000 #68 STZ2 #0000 #6a STZ2 #40 LDZ2 #6c STZ2 #42 LDZ2 #6e STZ2' 1 \
  "q-mul32: the a0*b1 partial placed one word too low"
mutant_red '#40 LDZ2 #68 STZ2 #42 LDZ2 #6a STZ2 #0000 #6c STZ2 #0000 #6e STZ2' '#0000 #68 STZ2 #40 LDZ2 #6a STZ2 #42 LDZ2 #6c STZ2 #0000 #6e STZ2' 1 \
  "q-mul32: the a1*b1 partial placed one word too low"

# --- D. cross-check against arbitrary-precision arithmetic over random inputs -------------
# The table is hand-picked and therefore blind to whatever nobody thought of. This is not.
mism=0; n=0
while read -r op a b want; do
  n=$((n+1))
  got="$(run arith64-test.rom "$op" "$a" "$b")"
  [ "$got" = "$want" ] || { mism=$((mism+1)); [ "$mism" -le 3 ] && echo "  op=$op a=$a b=$b: want $want got $got"; }
done < <(python3 -c '
import random
random.seed(20260819)
M=1<<64
for _ in range(160):
    op=random.choice([0,1,2,3,4])
    if op in (0,1,2):
        # bias hard toward word boundaries: a uniform 64-bit draw almost never carries
        # across a specific word, so a purely uniform generator would test the easy middle.
        def pick():
            k=random.choice([16,32,48,64])
            v=random.randrange(1<<k)
            return random.choice([v, (1<<k)-1, ((1<<k)-1)^v]) % M
        a=pick(); b=pick()
        v={0:(a+b)%M, 1:(a-b)%M, 2:int(a>=b)}[op]
    elif op==3:
        a=random.randrange(M); b=random.randrange(1<<16); v=(a*b)%M
    else:
        a=random.randrange(1<<32); b=random.randrange(1<<32); v=a*b
    print(op,a,b,"%016X"%v)
')
[ "$mism" -eq 0 ] || fail "$mism/$n random cross-checks disagree with arbitrary-precision arithmetic"
[ "$n" -ge 160 ]  || fail "only $n random cross-checks ran — the generator is not feeding the ROM"

[ "$rc" -eq 0 ] && echo "arith64-test: ok ($(table | grep -c .) boundary rows + rom==source + 14 carry-link mutants RED + $n random rows vs arbitrary precision)"
exit "$rc"
