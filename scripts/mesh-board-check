#!/usr/bin/env bash
# mesh-board-check — deploy shim for the uxn board invariant watcher (fixed-point
# lane, operator 2026-07-23: "a board invariant checker… fire it every tick — it
# catches silent dropped directives without an agent having to notice").
#
# The real tool lives WITH its ROM and toolchain at scripts/uxn/mesh-board-check
# ($here-relative ROM/uxncli/test resolution needs the genome dir). This thin exec
# makes it PATH-visible and autowirable (the never-wired-reflex rule, cc617e5).
# Cheap (one emulator boot over ~15KB of text, ~ms); every-10-min is fine.
# reflex-cadence: */10 * * * *
set -eu
REPO="${MESH_REPO:-$HOME/lte-workstation}"
TARGET="$REPO/scripts/uxn/mesh-board-check"
[ -x "$TARGET" ] || { echo "mesh-board-check: n/a — no genome checkout at $TARGET (set MESH_REPO)" >&2; exit 2; }
exec "$TARGET" "$@"
