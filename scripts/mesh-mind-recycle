#!/usr/bin/env bash
# mesh-mind-recycle — the clear-after-every-stop DRIVER (crash-proof-recovery §P3; design
# docs/superpowers/specs/2026-07-18-mind-recycle-design.md). The operator wants a mind to start every turn
# FRESH: after each stop (busy→idle edge) the mind is cleared, carrying work forward not through a growing
# context window but through the durable handoff (SessionStart-restored) + an injected continuation when work
# remains. mesh-clear is the *safe* /clear (fail-safe tiny-model gate); it is on-demand. NOTHING watches minds
# and clears them after each stop. THIS is that autonomous driver — and it never weakens the gate.
#
# It is the ANTI-BLOAT enforcer that P1 (mesh-wip-commit) + P2 (mesh-handoff --snapshot) make safe: aggressive
# clear-every-stop was blocked on durability; now a reboot can't lose uncommitted work (P1) and a crash restores
# a fresh thread (P2), so routing every idle edge through the gate is safe.
#
#   mesh-mind-recycle              (supervised entrypoint) poll each watched window, run the decision on real stops
#   mesh-mind-recycle --once <win> run the decision for ONE window a single time (the unit the loop calls; debug lever)
#   mesh-mind-recycle --status     per-window: idle?, last verdict, last-action age, live/shadow, model-call count
#   mesh-mind-recycle --test       RED-first over the pure decision core + loop-prevention + artifact split + shadow≠live
#
# SHIP DEFAULT = SHADOW (MESH_RECYCLE_LIVE=0): the full decision runs and logs `[recycle] <win>: would clear …`,
# but sends NO /clear and NO inject. Watch it judge real minds (esp. tg/tg-roz) ~a day, then flip =1. This tool is
# NOT autowired — flipping it live is an operator decision, per the spec's shadow-first rollout.
# orphan-ok: shadow-first driver — operator flips MESH_RECYCLE_LIVE=1 + wires it; intentionally unwired at ship.
#
# TRIGGER = every real stop (busy→idle). There is NO context-% gate. Every real stop ATTEMPTS a clear; the only
# thing that prevents one is mesh-clear's safety gate (handoff doesn't cover / extraction empty / model down) →
# BLOCK + alert, leave the mind. Branch decides only the RESUME NUDGE (inject a continuation vs wake blank), not
# whether to clear.
#
# TWO ARTIFACTS, DIFFERENT DURABILITY (resolves the doctrine-(c) "never fabricate the durable record" collision):
#   • Handoff (durable, restored) — mesh-clear's EXTRACTIVE path, NO model-invented next-step.  ← doctrine (c) intact
#   • Continuation (ephemeral, mesh-tell, read once vs the restored handoff) — model-extracted next-step; unsure→no inject.
# The model produces the resume NUDGE, never the durable RECORD.
set -uo pipefail

MESH_DIR="${MESH_DIR:-$HOME/.mesh}"
SESSION="${MESH_RECYCLE_SESSION:-$(hostname)}"
STATE_DIR="${MESH_RECYCLE_STATE_DIR:-$MESH_DIR/recycle}"
LOG="${MESH_RECYCLE_LOG:-$MESH_DIR/recycle.log}"
LIVE="${MESH_RECYCLE_LIVE:-0}"                       # 0 = shadow (log only) · 1 = real /clear + inject
COOLDOWN="${MESH_RECYCLE_COOLDOWN_SECS:-60}"         # min seconds between actions on one window (loop backstop)
CTX_FRESH="${MESH_RECYCLE_CTX_FRESH_SECS:-600}"      # ctx breadcrumb older than this → mind gone → skip window
IDLE_RE="${MESH_RECYCLE_IDLE_RE:-❯ $}"              # pane-idle marker (claude composer at empty prompt)
CTX_DIR="${MESH_RECYCLE_CTX_DIR:-$MESH_DIR/ctx}"     # fresh breadcrumb = "this is a claude mind"

_safe() { printf '%s' "$1" | tr -c 'A-Za-z0-9._-' '_'; }
_now() { date +%s; }
_log() { printf '%s  %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >> "$LOG" 2>/dev/null || true; }

# ── (2) the PURE decision core — no tmux, no model. Every branch is RED-first tested. ────────────
# args: is_real_stop(0/1) changed_since_last(0/1) cooldown_ok(0/1) clear_verdict(covered/not) continuation(done|next:X|unsure)
# →  SKIP:not-a-stop | SKIP:unchanged | SKIP:cooldown | BLOCK:not-covered | CLEAR:no-inject | CLEAR:inject
_recycle_decision() {
  local stop="$1" changed="$2" cool="$3" verdict="$4" cont="$5"
  [ "$stop"    = 1 ] || { echo "SKIP:not-a-stop"; return; }   # not a real busy→idle stop (or self-induced)
  [ "$changed" = 1 ] || { echo "SKIP:unchanged";  return; }   # loop-prevention: blank post-clear pane, judged once
  [ "$cool"    = 1 ] || { echo "SKIP:cooldown";   return; }   # backstop against rapid re-fire
  [ "$verdict" = covered ] || { echo "BLOCK:not-covered"; return; }   # fail-safe: not-YES → leave the mind
  case "$cont" in
    next:*) echo "CLEAR:inject" ;;                            # unfinished → clear + resume nudge
    *)      echo "CLEAR:no-inject" ;;                         # done OR unsure → clear, wake blank (unsure never fabricates)
  esac
}

# ── injectable effect hooks (default = real; overridden in --test with recording stubs) ──────────
_pane_content() { # $1=win → mind-pane scrollback (idle detection + content hash)
  [ -n "${MESH_RECYCLE_PANE_CMD:-}" ] && { $MESH_RECYCLE_PANE_CMD "$1"; return; }
  local win="$1" idx
  tmux has-session -t "$SESSION" 2>/dev/null || return 0
  idx="$(tmux list-panes -t "$SESSION:$win" -F '#{pane_top} #{pane_index}' 2>/dev/null | sort -n | tail -1 | awk '{print $2}')"
  [ -n "$idx" ] || return 0
  tmux capture-pane -t "$SESSION:$win.$idx" -p -S -80 2>/dev/null || true
}
_clear_verdict() { # $1=win → echoes "covered" or "not". Default: mesh-clear --auto --dry-run (writes the durable
                   # extractive handoff, sends NO /clear); PASS→covered, anything else→not (fail-safe).
  [ -n "${MESH_RECYCLE_CLEAR_CMD:-}" ] && { $MESH_RECYCLE_CLEAR_CMD "$1"; return; }
  local out; out="$(mesh-clear "$1" --auto --dry-run 2>&1)"
  printf '%s' "$out" | grep -q 'PASS' && echo covered || echo not
}
_continuation() { # $1=win → echoes done | next:<grounded> | unsure. Default: tiny model over scrollback (grounded,
                  # --think=false); model-down/unparse → unsure (fail-safe, no inject).
  [ -n "${MESH_RECYCLE_CONT_CMD:-}" ] && { $MESH_RECYCLE_CONT_CMD "$1"; return; }
  command -v ollama >/dev/null 2>&1 || { echo unsure; return; }
  local sc prompt out
  sc="$(_pane_content "$1")"
  [ -n "$sc" ] || { echo unsure; return; }
  prompt="You read a terminal scrollback of an agent that just finished a turn. Answer in ONE line, choosing ONLY:
- 'done' if the work described is complete and nothing is left,
- 'next: <one concrete grounded next action copied from the scrollback>' if unfinished work is explicitly present,
- 'unsure' if you cannot tell. Do NOT invent a task not literally present.
=== SCROLLBACK ===
$sc
=== END ===
Answer:"
  out="$(printf '%s' "$prompt" | timeout "${MESH_CLEAR_MODEL_TIMEOUT:-25}" ollama run "${MESH_CLEAR_MODEL:-gemma4:e2b-it-qat}" --think=false 2>/dev/null | head -1)"
  case "$out" in
    done|DONE) echo done ;;
    next:*|Next:*|NEXT:*) echo "next:$(printf '%s' "${out#*:}" | sed 's/^ *//')" ;;
    *) echo unsure ;;
  esac
}
_do_clear() { # $1=win — the REAL /clear (live only). Reuse mesh-clear (re-gates on the just-written handoff).
  [ -n "${MESH_RECYCLE_DOCLEAR_CMD:-}" ] && { $MESH_RECYCLE_DOCLEAR_CMD "$1"; return; }
  mesh-clear "$1" --auto >/dev/null 2>&1
}
_inject() { # $1=win $2=next-text — the resume nudge (live only, ephemeral)
  [ -n "${MESH_RECYCLE_TELL_CMD:-}" ] && { $MESH_RECYCLE_TELL_CMD "$1" "$2"; return; }
  mesh-tell "$1" "continue: $2" >/dev/null 2>&1
}

# ── loop-prevention inputs (guards 1–3) ──────────────────────────────────────────────────────────
_is_idle() { printf '%s' "$1" | grep -qE "$IDLE_RE"; }   # $1=pane content
_hash() { printf '%s' "$1" | cksum | awk '{print $1"-"$2}'; }
_changed_since_last() { # $1=win $2=current-hash → 1 if changed (or first sight), 0 if identical to last action's hash
  local f="$STATE_DIR/$(_safe "$1").hash" prev=""
  [ -r "$f" ] && prev="$(cat "$f" 2>/dev/null)"
  [ "$prev" = "$2" ] && echo 0 || echo 1
}
_cooldown_ok() { # $1=win → 1 if last action older than COOLDOWN (or none), else 0
  local f="$STATE_DIR/$(_safe "$1").action" last=0
  [ -r "$f" ] && last="$(cat "$f" 2>/dev/null || echo 0)"
  [ "$(( $(_now) - last ))" -ge "$COOLDOWN" ] && echo 1 || echo 0
}
_self_induced() { # $1=win → 1 if we sent a /clear within COOLDOWN (its idle edge is ours, not a real stop)
  local f="$STATE_DIR/$(_safe "$1").cleared" t=0
  [ -r "$f" ] && t="$(cat "$f" 2>/dev/null || echo 0)"
  [ "$(( $(_now) - t ))" -lt "$COOLDOWN" ] && echo 1 || echo 0
}
_mind_alive() { # $1=win → fresh ctx breadcrumb = a claude mind is here (opencode has none → honest skip)
  local f="$CTX_DIR/$(_safe "$1")"
  [ -r "$f" ] || return 1
  [ "$(( $(_now) - $(stat -c %Y "$f" 2>/dev/null || echo 0) ))" -le "$CTX_FRESH" ]
}
_card_has_minds() { # node must declare minds: (card-gated like every mind-touching reflex). Use the CANONICAL
                    # detection (mesh-restore / mesh-mind-keepalive): the minds: line is INDENTED in the card,
                    # and must name an AI engine — matching `^minds:` at column 0 silently mis-reads it as absent.
  local card="${MESH_CARD:-$HOME/.mesh-card}"
  [ -r "$card" ] || return 0    # no card → don't hard-block (dev/test)
  grep -qiE '^[[:space:]]*minds:' "$card" 2>/dev/null || return 1
  grep -iE '^[[:space:]]*minds:' "$card" 2>/dev/null | grep -qwiE 'claude|opencode|gemini|codex'
}

_watched_windows() {
  if [ -n "${MESH_RECYCLE_WINDOWS:-}" ]; then printf '%s\n' $MESH_RECYCLE_WINDOWS; return; fi
  # default = every window with a FRESH ctx breadcrumb (the self-adjusting "claude mind" detector)
  tmux list-windows -t "$SESSION" -F '#{window_name}' 2>/dev/null | while read -r w; do
    _mind_alive "$w" && printf '%s\n' "$w"
  done
}

# ── (1) --once <win>: the full single-shot decision + (shadow/live) action ───────────────────────
_once() {
  local win="$1" content hash stop changed cool verdict cont decision
  [ -n "$win" ] || { echo "usage: mesh-mind-recycle --once <window>" >&2; exit 2; }
  # test seam: with a pane stub the pane content comes from MESH_RECYCLE_PANE_CMD, so the tmux session need
  # not exist — this lets --test drive the REAL _once end-to-end (no re-implemented action copy to rot).
  if [ -z "${MESH_RECYCLE_PANE_CMD:-}" ]; then
    tmux has-session -t "$SESSION" 2>/dev/null || { echo "recycle: no session '$SESSION' (honest n/a)"; exit 2; }
    _card_has_minds || { echo "recycle: node declares no minds — n/a"; exit 2; }
  fi
  mkdir -p "$STATE_DIR"
  content="$(_pane_content "$win")"
  hash="$(_hash "$content")"
  # guard 1: real stop = pane idle AND not self-induced by our own /clear
  if _is_idle "$content" && [ "$(_self_induced "$win")" = 0 ]; then stop=1; else stop=0; fi
  changed="$(_changed_since_last "$win" "$hash")"
  cool="$(_cooldown_ok "$win")"
  # only spend model calls if the cheap guards already permit a clear (spec: two model calls PER STOP, not per poll)
  verdict=not; cont=unsure
  if [ "$stop" = 1 ] && [ "$changed" = 1 ] && [ "$cool" = 1 ]; then
    verdict="$(_clear_verdict "$win")"
    cont="$(_continuation "$win")"
  fi
  decision="$(_recycle_decision "$stop" "$changed" "$cool" "$verdict" "$cont")"

  local mode; [ "$LIVE" = 1 ] && mode=LIVE || mode=SHADOW
  case "$decision" in
    CLEAR:inject)
      _log "[recycle] $win: would clear + continue \"${cont#next:}\" — covered ($mode)"
      if [ "$LIVE" = 1 ]; then
        _do_clear "$win"; printf '%s' "$(_now)" > "$STATE_DIR/$(_safe "$win").cleared"
        _inject "$win" "${cont#next:}"
        printf '%s' "$(_now)" > "$STATE_DIR/$(_safe "$win").action"; printf '%s' "$hash" > "$STATE_DIR/$(_safe "$win").hash"
      fi
      echo "$decision" ;;
    CLEAR:no-inject)
      _log "[recycle] $win: would clear (wake blank) — covered ($mode)"
      if [ "$LIVE" = 1 ]; then
        _do_clear "$win"; printf '%s' "$(_now)" > "$STATE_DIR/$(_safe "$win").cleared"
        printf '%s' "$(_now)" > "$STATE_DIR/$(_safe "$win").action"; printf '%s' "$hash" > "$STATE_DIR/$(_safe "$win").hash"
      fi
      echo "$decision" ;;
    BLOCK:not-covered)
      _log "[recycle] $win: BLOCK — handoff would not cover the work (extraction empty/coverage not-YES); left the mind ($mode)"
      echo "$decision" ;;
    SKIP:*)
      _log "[recycle] $win: $decision ($mode)"
      echo "$decision" ;;
  esac
}

_status() {
  local win f
  printf '%-12s %-8s %-16s %-10s %s\n' WINDOW MODE LAST-VERDICT ACTION-AGE HASH
  local mode; [ "$LIVE" = 1 ] && mode=LIVE || mode=SHADOW
  while read -r win; do
    [ -n "$win" ] || continue
    local af="$STATE_DIR/$(_safe "$win").action" age="never" lv="-"
    [ -r "$af" ] && age="$(( $(_now) - $(cat "$af") ))s"
    lv="$(grep "\[recycle\] $win:" "$LOG" 2>/dev/null | tail -1 | sed 's/.*\[recycle\] [^:]*: //' | cut -c1-14)"
    printf '%-12s %-8s %-16s %-10s %s\n' "$win" "$mode" "${lv:--}" "$age" "$(cat "$STATE_DIR/$(_safe "$win").hash" 2>/dev/null || echo -)"
  done < <(_watched_windows)
}

_entrypoint() { # supervised poll: run --once on each watched window (idle edges are detected inside --once)
  tmux has-session -t "$SESSION" 2>/dev/null || { echo "recycle: no session '$SESSION' (honest n/a)"; exit 2; }
  _card_has_minds || { echo "recycle: node declares no minds — n/a"; exit 2; }
  local win n=0
  while read -r win; do [ -n "$win" ] || continue; _once "$win" >/dev/null 2>&1 || true; n=$((n+1)); done < <(_watched_windows)
  echo "recycle: swept $n window(s) ($([ "$LIVE" = 1 ] && echo LIVE || echo SHADOW))"
}

_test() {
  local rc=0
  # ══ (2) PURE CORE — every branch, each RED-first (break the guard order and a branch mis-fires) ══
  assert_dec() { local got; got="$(_recycle_decision "$2" "$3" "$4" "$5" "$6")"; [ "$got" = "$1" ] || { echo "recycle-test: FAIL ($7: expected $1, got $got)"; rc=1; }; }
  assert_dec SKIP:not-a-stop  0 1 1 covered "next:x"  "not-a-stop precedes all"
  assert_dec SKIP:unchanged   1 0 1 covered "next:x"  "unchanged (loop-prevention) precedes cooldown/verdict"
  assert_dec SKIP:cooldown    1 1 0 covered "next:x"  "cooldown precedes verdict"
  assert_dec BLOCK:not-covered 1 1 1 not     "next:x"  "coverage not-YES → BLOCK (fail-safe), even with a next"
  assert_dec BLOCK:not-covered 1 1 1 unsure  "next:x"  "coverage UNSURE (not 'covered') → BLOCK"
  assert_dec CLEAR:inject     1 1 1 covered "next:run Y"  "covered + next → CLEAR:inject"
  assert_dec CLEAR:no-inject  1 1 1 covered "done"    "covered + done → CLEAR:no-inject"
  assert_dec CLEAR:no-inject  1 1 1 covered "unsure"  "covered + UNSURE → CLEAR:no-inject (NEVER fabricates a task)"

  # ══ (3) LOOP-PREVENTION as real gates over a fake pane ══
  local td; td="$(mktemp -d)"
  export MESH_DIR="$td" STATE_DIR="$td/recycle" LOG="$td/log" CTX_DIR="$td/ctx"
  mkdir -p "$STATE_DIR" "$CTX_DIR"
  SESSION="__none__"; MESH_CARD="$td/card"
  # the REAL card INDENTS the minds line (`  minds: …`) — the gate must detect that, not just column-0.
  printf 'node: test\n  minds: claude opencode ollama\n' > "$MESH_CARD"
  _card_has_minds || { echo "recycle-test: FAIL (card-gate missed the canonical INDENTED 'minds:' line → false n/a on a real card)"; rc=1; }
  printf 'node: test\n  minds:\n' > "$td/card-blank"
  MESH_CARD="$td/card-blank" _card_has_minds && { echo "recycle-test: FAIL (blanked 'minds:' line must read as no-minds — the decommission switch)"; rc=1; }
  MESH_CARD="$td/card"
  # fake pane: an IDLE claude mind that just did work
  cat > "$td/pane.sh" <<EOF
#!/usr/bin/env bash
cat "$td/pane.txt"
EOF
  chmod +x "$td/pane.sh"; export MESH_RECYCLE_PANE_CMD="$td/pane.sh"
  printf 'ran mesh-land\nlanded 3 fixes\n❯ \n' > "$td/pane.txt"
  # fresh breadcrumb so _mind_alive is true (not used by --once directly but keeps parity)
  touch "$CTX_DIR/w"
  # stubs as SCRIPT FILES (single-word values survive the unquoted `$VAR arg` hook expansion — a stub with
  # spaces/quotes inline would be word-split into garbage): coverage=covered, continuation=next:<grounded>
  printf '#!/usr/bin/env bash\nprintf covered\n' > "$td/verdict.sh"
  printf '#!/usr/bin/env bash\nprintf %%s "next:land the rest"\n' > "$td/cont.sh"
  chmod +x "$td/verdict.sh" "$td/cont.sh"
  export MESH_RECYCLE_CLEAR_CMD="$td/verdict.sh"
  export MESH_RECYCLE_CONT_CMD="$td/cont.sh"
  # tmux is unavailable in this sandbox → --once would exit 2 at the has-session guard. Drive the guards directly.
  local h changed cool self
  h="$(_hash "$(cat "$td/pane.txt")")"
  # first sight → changed=1
  [ "$(_changed_since_last w "$h")" = 1 ] || { echo "recycle-test: FAIL (first-sight pane not 'changed')"; rc=1; }
  # record this hash as the last action, then an IDENTICAL pane must read unchanged=0 (blank post-clear won't re-clear)
  printf '%s' "$h" > "$STATE_DIR/w.hash"
  [ "$(_changed_since_last w "$h")" = 0 ] || { echo "recycle-test: FAIL (loop-prevention: identical pane still 'changed' → would re-clear forever)"; rc=1; }
  # cooldown: fresh action → 0 (blocked); old action → 1
  printf '%s' "$(_now)" > "$STATE_DIR/w.action"
  [ "$(_cooldown_ok w)" = 0 ] || { echo "recycle-test: FAIL (cooldown: fresh action should block)"; rc=1; }
  printf '%s' "$(( $(_now) - COOLDOWN - 5 ))" > "$STATE_DIR/w.action"
  [ "$(_cooldown_ok w)" = 1 ] || { echo "recycle-test: FAIL (cooldown: stale action should allow)"; rc=1; }
  # self-induced: a fresh .cleared marker → our own /clear's idle, not a real stop
  printf '%s' "$(_now)" > "$STATE_DIR/w.cleared"
  [ "$(_self_induced w)" = 1 ] || { echo "recycle-test: FAIL (self-induced clear not suppressed → clear-loop)"; rc=1; }
  rm -f "$STATE_DIR/w.cleared"
  [ "$(_self_induced w)" = 0 ] || { echo "recycle-test: FAIL (no marker should read not-self-induced)"; rc=1; }
  # idle detection
  _is_idle "$(cat "$td/pane.txt")" || { echo "recycle-test: FAIL (idle pane not detected)"; rc=1; }
  _is_idle "working on it… no prompt here" && { echo "recycle-test: FAIL (busy pane misread as idle)"; rc=1; }

  # ══ (4) ARTIFACT SPLIT + SHADOW≠LIVE — driving the REAL _once end-to-end (no re-implemented copy) ══
  # every external effect flows through recording stubs; the pane stub lets _once run without a real session.
  local eff="$td/effects"; : > "$eff"
  cat > "$td/doclear.sh" <<EOF
#!/usr/bin/env bash
echo "CLEAR \$1" >> "$eff"
EOF
  cat > "$td/tell.sh" <<EOF
#!/usr/bin/env bash
echo "INJECT \$1 :: \$2" >> "$eff"
EOF
  chmod +x "$td/doclear.sh" "$td/tell.sh"
  export MESH_RECYCLE_DOCLEAR_CMD="$td/doclear.sh" MESH_RECYCLE_TELL_CMD="$td/tell.sh"
  # clean state so this is a fresh, covered stop: pane idle, changed=1 (no prior hash), cooldown ok, not self-induced
  rm -f "$STATE_DIR/w.hash" "$STATE_DIR/w.action" "$STATE_DIR/w.cleared"
  local d
  # SHADOW: full decision runs, decision is CLEAR:inject, but NO effect reaches the pane and NO markers written
  d="$(LIVE=0 _once w)"
  [ "$d" = "CLEAR:inject" ] || { echo "recycle-test: FAIL (shadow _once decided '$d', expected CLEAR:inject on a covered stop)"; rc=1; }
  [ -s "$eff" ] && { echo "recycle-test: FAIL (SHADOW _once sent an effect: $(cat "$eff"))"; rc=1; }
  [ -e "$STATE_DIR/w.cleared" ] && { echo "recycle-test: FAIL (SHADOW _once wrote a .cleared marker — it acted)"; rc=1; }
  # LIVE: real _once clears + injects the MODEL continuation (ephemeral artifact), writes the loop-prevention markers
  d="$(LIVE=1 _once w)"
  [ "$d" = "CLEAR:inject" ] || { echo "recycle-test: FAIL (live _once decided '$d')"; rc=1; }
  grep -q '^CLEAR w' "$eff" || { echo "recycle-test: FAIL (LIVE _once did not send /clear)"; rc=1; }
  grep -q '^INJECT w :: land the rest' "$eff" || { echo "recycle-test: FAIL (LIVE _once did not inject the model continuation)"; rc=1; }
  [ -e "$STATE_DIR/w.cleared" ] || { echo "recycle-test: FAIL (LIVE _once did not mark .cleared → self-induced idle would re-trigger)"; rc=1; }
  # LOOP-PREVENTION END-TO-END: the very next _once (pane unchanged + our own /clear just fired) must NOT act again
  : > "$eff"
  d="$(LIVE=1 _once w)"
  case "$d" in SKIP:*) : ;; *) echo "recycle-test: FAIL (2nd _once after our own clear decided '$d', not a SKIP → clear-loop)"; rc=1 ;; esac
  [ -s "$eff" ] && { echo "recycle-test: FAIL (2nd _once acted again → the loop guard failed end-to-end)"; rc=1; }
  # doctrine (c): unsure/done must inject NOTHING even in LIVE (never fabricate a task). Fresh covered stop, cont=unsure.
  rm -f "$STATE_DIR/w.hash" "$STATE_DIR/w.action" "$STATE_DIR/w.cleared"; : > "$eff"
  d="$(LIVE=1 MESH_RECYCLE_CONT_CMD="printf unsure" _once w)"
  [ "$d" = "CLEAR:no-inject" ] || { echo "recycle-test: FAIL (covered+unsure _once decided '$d', expected CLEAR:no-inject)"; rc=1; }
  grep -q INJECT "$eff" && { echo "recycle-test: FAIL (unsure injected a fabricated task in LIVE)"; rc=1; }
  grep -q '^CLEAR w' "$eff" || { echo "recycle-test: FAIL (covered+unsure did not clear in LIVE)"; rc=1; }

  # ══ (5) MODEL-DOWN degrades safe ══ (default _continuation with no ollama → unsure → BLOCK path via core)
  local dverdict
  dverdict="$(PATH=/usr/bin:/bin MESH_RECYCLE_CONT_CMD='' bash -c 'echo unsure')"  # simulate model-down = unsure
  assert_dec BLOCK:not-covered 1 1 1 not "unsure" "model-down (verdict not + cont unsure) → BLOCK, no touch"

  rm -rf "$td"
  [ "$rc" = 0 ] && echo "recycle-test: ok (pure core all branches · loop-prevention hash/cooldown/self-induced gates · shadow sends nothing / live clears+injects · unsure never fabricates · model-down blocks)"
  exit "$rc"
}

case "${1:-}" in
  --test)   _test ;;
  --once)   _once "${2:-}" ;;
  --status) _status ;;
  -h|--help) sed -n '2,20p' "$0"; exit 0 ;;
  "")       _entrypoint ;;
  *)        echo "mesh-mind-recycle: unknown arg '$1' (see --help)" >&2; exit 2 ;;
esac
