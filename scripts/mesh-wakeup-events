#!/usr/bin/env bash
# orphan-ok: on-demand device-wakeup probe; sampled only when a consumer asks for suspend/wake activity.
# mesh-wakeup-events — live device wakeup activity from /sys/class/wakeup.
#
# The kernel's wakeup-source event counters are a hardware-facing signal: they count device wake
# events, while active_count identifies sources currently preventing suspend. Missing or malformed
# sysfs data is UNKNOWN (exit 2), never a fabricated zero.
set -euo pipefail
export PATH="${HOME:-/root}/.local/bin:$PATH"

MESH="${MESH_DIR:-${HOME:-/root}/.mesh}"
WAKEUP_ROOT="${MESH_WAKEUP_ROOT:-/sys/class/wakeup}"
STATE="${MESH_WAKEUP_STATE:-$MESH/.wakeup-events.state}"

read_snapshot() {
  local root="${1:-$WAKEUP_ROOT}" dir name events active total=0 sources=0 active_sources=0
  shopt -s nullglob
  for dir in "$root"/*; do
    [ -d "$dir" ] || continue
    [ -r "$dir/event_count" ] && [ -r "$dir/active_count" ] || continue
    name="$(tr -d '[:space:]' <"$dir/name" 2>/dev/null || basename "$dir")"
    events="$(tr -d '[:space:]' <"$dir/event_count" 2>/dev/null)"
    active="$(tr -d '[:space:]' <"$dir/active_count" 2>/dev/null)"
    case "$events:$active" in
      ''|*[!0-9:]*|*:*:* ) continue ;;
    esac
    total=$((total + events))
    sources=$((sources + 1))
    [ "$active" -gt 0 ] && active_sources=$((active_sources + 1))
    [ -n "$name" ] || name="$(basename "$dir")"
  done
  shopt -u nullglob
  [ "$sources" -gt 0 ] || return 2
  printf '%s|%s|%s\n' "$total" "$sources" "$active_sources"
}

if [ "${1:-}" = --test ]; then
  td="$(mktemp -d)"
  trap 'rm -rf "$td"' EXIT
  mkdir -p "$td/wakeup0" "$td/wakeup1"
  printf 'timer\n' >"$td/wakeup0/name"; printf '10\n' >"$td/wakeup0/event_count"; printf '0\n' >"$td/wakeup0/active_count"
  printf 'usb\n' >"$td/wakeup1/name"; printf '7\n' >"$td/wakeup1/event_count"; printf '1\n' >"$td/wakeup1/active_count"
  [ "$(read_snapshot "$td")" = '17|2|1' ] || { echo 'smoke-test: FAIL (fixture wakeup snapshot)'; exit 1; }
  if read_snapshot "$td/missing" >/dev/null 2>&1; then
    echo 'smoke-test: FAIL (missing sysfs accepted)'; exit 1
  fi
  live="$(read_snapshot "$WAKEUP_ROOT" 2>/dev/null)" || {
    echo "smoke-test: n/a (real wakeup-source sysfs unavailable: $WAKEUP_ROOT)"; exit 2;
  }
  echo "smoke-test: ok (fixture parser + REAL /sys/class/wakeup read: $live)"
  exit 0
fi

before="$(read_snapshot "$WAKEUP_ROOT" 2>/dev/null)" || {
  echo "mesh-wakeup-events: UNKNOWN — no readable wakeup sources under $WAKEUP_ROOT" >&2
  exit 2
}
sleep "${MESH_WAKEUP_WINDOW_S:-0.2}"
after="$(read_snapshot "$WAKEUP_ROOT" 2>/dev/null)" || {
  echo 'mesh-wakeup-events: UNKNOWN — wakeup-source sysfs disappeared during sample' >&2
  exit 2
}
before_total="${before%%|*}"; rest="${before#*|}"; before_sources="${rest%%|*}"
after_total="${after%%|*}"; rest="${after#*|}"; after_sources="${rest%%|*}"; after_active="${rest#*|}"
[ "$after_total" -ge "$before_total" ] 2>/dev/null || { echo 'mesh-wakeup-events: UNKNOWN — counter moved backwards' >&2; exit 2; }
delta=$((after_total - before_total))
mkdir -p "$(dirname "$STATE")"
printf 'events_delta=%s|events_total=%s|sources=%s|active_sources=%s|window_s=%s|source=%s|ts=%s\n' \
  "$delta" "$after_total" "$after_sources" "$after_active" "${MESH_WAKEUP_WINDOW_S:-0.2}" "$WAKEUP_ROOT" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >"$STATE"
mesh-state-touch "$STATE" >/dev/null 2>&1 || {
  echo 'mesh-wakeup-events: UNKNOWN — could not stamp live state' >&2; exit 1;
}
printf '[wakeup-events] delta=%s total=%s sources=%s active_sources=%s window_s=%s\n' \
  "$delta" "$after_total" "$after_sources" "$after_active" "${MESH_WAKEUP_WINDOW_S:-0.2}"
