#!/bin/bash
# mesh-statusline-cache — phase-2 writer for the Claude Code statusline mesh segment.
#
# The statusline (~/.claude/statusline-command.sh) NEVER shells out on the hot path; it only
# `cat`s ~/.mesh/statusline-cache if that file is fresh (<90s). This reflex is the one thing
# allowed to shell out to mesh-spend + read load — it renders a single pre-formatted line the
# statusline appends verbatim. Cadence beats the render's 90s freshness window so the segment
# never blinks out on a healthy node; a dead cron never writes → file ages out → segment simply
# vanishes (honest absence, never a fabricated $0.00 / fake spend). Design review 2026-07-18.
#
# reflex-cadence: * * * * *
# orphan-ok: writer for the statusline mesh segment; cadence above wires it via mesh-autowire

set -u

# Cache path is overridable so --test writes its OWN artifact and never forges the live one
# (a --test that stamps the real liveness file is a forgery — see guardian.log lesson 09f7914).
CACHE="${MESH_STATUSLINE_CACHE:-$HOME/.mesh/statusline-cache}"

render_line() {
  # spend: PAID/FREE unit split from mesh-spend --by-provider (approximate round-trips)
  local spend_seg="" load_seg="" pv
  pv=$(mesh-spend --by-provider 2>/dev/null | grep -E '^\s*PAID' | head -1)
  if [ -n "$pv" ]; then
    # line looks like:  PAID    11  (73%)   FREE     4  (26%)
    local paid free
    paid=$(printf '%s' "$pv" | grep -oE 'PAID[[:space:]]+[0-9]+'  | grep -oE '[0-9]+$')
    free=$(printf '%s' "$pv" | grep -oE 'FREE[[:space:]]+[0-9]+'  | grep -oE '[0-9]+$')
    [ -n "$paid" ] && [ -n "$free" ] && spend_seg="spend ${paid}p/${free}f"
  fi

  # load: 1-min loadavg (bare number; cheap /proc read, no shell-out)
  local l1
  l1=$(awk '{print $1}' /proc/loadavg 2>/dev/null)
  [ -n "$l1" ] && load_seg="load ${l1}"

  # join non-empty segments with " · " — emit nothing if BOTH are empty (statusline then shows no seg)
  local out=""
  for s in "$spend_seg" "$load_seg"; do
    [ -z "$s" ] && continue
    if [ -z "$out" ]; then out="$s"; else out="$out · $s"; fi
  done
  printf '%s' "$out"
}

write_cache() {
  local dest="${1:-$CACHE}"          # explicit dest so --test targets a sandbox, never the live file
  local line; line=$(render_line)
  [ -z "$line" ] && return 1          # nothing to say → do not touch the file (let it age out honestly)
  mkdir -p "$(dirname "$dest")"
  printf '%s\n' "$line" > "$dest"
}

if [ "${1:-}" = "--test" ]; then
  # --test writes a SANDBOX cache, never the live one, then asserts a fresh non-empty shaped line.
  tmp=$(mktemp)
  write_cache "$tmp"
  rc=$?
  if [ $rc -ne 0 ]; then
    # no spend data AND no loadavg is only plausible off-box; loadavg always exists on Linux → real fail
    echo "test-statusline-cache: FAIL — render produced an empty line (no spend, no load)"; rm -f "$tmp"; exit 1
  fi
  content=$(cat "$tmp" 2>/dev/null)
  # assert the REAL path ran: the line must carry at least a load segment (loadavg is always readable here)
  if ! printf '%s' "$content" | grep -qE 'load [0-9]'; then
    echo "test-statusline-cache: FAIL — no live 'load N' segment in cache: '$content'"; rm -f "$tmp"; exit 1
  fi
  # assert freshness the render would accept (<90s) — file must be brand new
  if [ -z "$(find "$tmp" -mmin -1.5 2>/dev/null)" ]; then
    echo "test-statusline-cache: FAIL — written cache is not fresh"; rm -f "$tmp"; exit 1
  fi
  rm -f "$tmp"
  echo "test-statusline-cache: ok — '$content'"
  exit 0
fi

write_cache
