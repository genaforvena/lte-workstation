#!/usr/bin/env bash
# mesh-object-id — camera object-recognition (operator-ask 2026-07-03): point the node cam at an
# object and get it IDENTIFIED — "what IS this?" — not just described (that's mesh-see's scene
# sentence). Capture one still (mesh-camera) → a vision model names the object(s).
#
# Backends, cheapest first (mesh-relay doctrine, but VISION — relay itself is text-only):
#   1. LOCAL ollama qwen3-vl (free, on this node's GPU; frames never leave the house) — DEFAULT
#   2. Groq cloud vision      (only if MESH_VISION_MODEL is a vendor-prefixed id, e.g. meta-llama/…)
#   3. claude -p + Read       (paid quota fallback; the proven mesh-see vision path)
#
# ONE knob picks the model AND the backend: MESH_VISION_MODEL. A bare ollama tag (qwen3-vl:4b-instruct,
# has NO "/") → local GPU; a vendor-prefixed id (meta-llama/…, qwen/…) → Groq cloud. Groq RETIRED all
# llama-4 vision 2026-07-18 (meta-llama/llama-4-scout-17b-16e-instruct → 404 "model does not exist"),
# which is why the default is now the local model instead of the dead scout — a dead-primary silently
# degraded every frame to the paid claude fallback (quota burn) or a blind sense. (senses, 2026-07-18)
#
#   mesh-object-id              consent-gated capture → ID → one line on stdout
#   mesh-object-id <img.jpg>    ID an existing image (no capture, no consent needed)
#   mesh-object-id --ask "..."  extra question about the object (e.g. "what brand?")
#   mesh-object-id --say        also speak the answer (mesh-say)
#   mesh-object-id --chat       also post it to the board ([see] tag)
#   mesh-object-id --novelty    also print historical-NN novelty of this sighting vs the archive
#   mesh-object-id --archive    archive summary (n, span, observer) — no capture, no model call
#   mesh-object-id --test       smoke test (request/parse shape + capture path + a backend + novelty)
#
# ── HISTORICAL-NN NOVELTY, AND WHY THE OBSERVER IS NAMED IN EVERY LINE ─────────────────────────────
# (live-literature review, genome, 2026-08-25;
#  docs/reviews/oee-representation-embodies-the-observer-object-id-2026-08-25.md)
#
# Kumar, Lu, Kirsch, Tang, Stanley, Isola & Ha, "Automating the Search for Artificial Life with
# Foundation Models" (ASAL) — arXiv:2412.17799 (23 Dec 2024, rev 16 May 2025), published in
# *Artificial Life* 31(3):368. Its "Search for Open-Endedness" defines novelty WITHOUT a hand-built
# component partition: embed each frame with a foundation model, and score timestep T by comparing it
# to ALL previous timesteps T' < T — the OE score is ONE MINUS the MAXIMUM similarity to history
# (historical nearest-neighbour novelty, which the paper reports beats variance-based novelty). The
# sentence that decides this file's shape:
#
#   "this formulation outsources the subjectivity of measuring open-endedness to the construction of
#    the representation function, WHICH EMBODIES THE OBSERVER."
#
# So a novelty number without the name of the representation that produced it is not a measurement.
# Every novelty line here carries observer=<model>, and a missing representation renders novelty=na —
# never a string-distance stand-in wearing the same word.
#
# WHY THIS ORGAN. This is the only mesh tool that already runs a vision-language foundation model on
# real frames, and it used the model to emit a NAME and then threw the observation away entirely:
# no archive, so the node could never answer "have I seen this before?". And a naive archive keyed on
# the answer STRING is worse than none — "a mug", "a white ceramic mug" and "white mug on a desk" are
# one object in three phrasings, so byte-exact keying reports novelty 1.000 forever and manufactures
# open-endedness out of PHRASING (a-byte-exact-dedupe-cannot-express-the-same-performance).
#
# MEASURED HERE, not assumed (2026-08-25, all-minilm:latest on this node's GPU, 1-cos):
#   'a mug' vs 'a white ceramic mug'        novelty 0.256
#   'a mug' vs 'white mug on a desk'        novelty 0.280
#   'a bicycle' vs 'a bike leaning on a wall' novelty 0.392
#   'a mug' vs 'a black office chair'       novelty 0.719
#   'a mug' vs 'a bicycle'                  novelty 0.814
# Byte-exact keying scores 1.000 on ALL FIVE, so the separation is a measurement, not a claim. It is
# also n=5 HAND pairs, not a corpus: the paraphrase band (0.26-0.39) and the distinct band (0.72-0.81)
# do not overlap here but the bike pair is close enough that ONE global threshold is not safe yet.
# Hence: the raw novelty is always published; NEW_AT is a PROVISIONAL knob, and the --test arm asserts
# the RELATION (paraphrase < distinct), never a constant, so it cannot rot
# (calibrate-a-derived-axis-against-the-live-corpus).
#
# The VISUAL observer ASAL actually used is NOT available here and that is measured, not assumed:
# llmvision/glimpse-v1 (family clip) is pulled locally, and BOTH /api/embed and the legacy
# /api/embeddings return an EMPTY embeddings array for an image on this ollama. So the observer in use
# is LINGUISTIC — it sees only what the VLM chose to say, which is strictly weaker than seeing the
# frame. That weakness is named in the output rather than hidden: observer=<model> is the whole point.
#
# Camera-busy honesty: mesh-cam-watch polls the lens ~1.5s; a capture can hit "device busy".
# We retry between its polls, then fall back to cam-watch's OWN fresh baseline frame
# (~/.mesh/cam-prev.jpg, if <120s old) — a real recent frame, no device fight.
# PRIVACY (matches mesh-see/mesh-eye): prompt forbids identifying/describing any person; capture
# is consent-gated on ~/.mesh/consent camera=yes. Owned/authorized nodes only.
# orphan-ok: on-demand perceptual query (operator-ask 2026-07-03) — pulled when asked, not scheduled
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -f "$HOME/.mesh/groq.env" ] && . "$HOME/.mesh/groq.env"
VMODEL="${MESH_VISION_MODEL:-qwen3-vl:4b-instruct}"     # bare tag → local ollama; vendor/id → Groq
OLLAMA_URL="${MESH_OLLAMA_URL:-http://localhost:11434}"
VISION_NUM_CTX="${MESH_VISION_NUM_CTX:-8192}"           # full-res frame ~4.1k tok > ollama default 4096
OUT="$HOME/.mesh/cam/object-id.jpg"
PREV="$HOME/.mesh/cam-prev.jpg"          # mesh-cam-watch's rolling baseline (fallback frame)
CONSENT="$HOME/.mesh/consent"
PREV_MAX_AGE=120
ARCHIVE="${MESH_OBJECT_ID_ARCHIVE:-$HOME/.mesh/object-id-archive.jsonl}"   # the memory this organ never had
OBSERVER="${MESH_OBJECT_ID_OBSERVER:-all-minilm:latest}"                   # the representation function = the observer
NEW_AT="${MESH_OBJECT_ID_NEW_AT:-0.55}"                                    # PROVISIONAL, see the measured bands above
ARCHIVE_MAX="${MESH_OBJECT_ID_ARCHIVE_MAX:-2000}"

# A REFUSAL IS NOT A SIGHTING, AND THE ARCHIVE MUST NOT SCORE ONE (found LIVE, 2026-08-25, running
# this tool on two real dark frames: both returned "Cannot identify due to extreme darkness and
# blurriness." and the second scored novelty=0.000 "seen-before" — the node reporting RECOGNITION of a
# frame it could not see, and n counting blindnesses as observations. a-blindness-sentinel-fused-as-a-
# reading.) The prompt already had to ask for a refusal; it now asks for a DETERMINISTIC one, so the
# predicate below keys on a token WE specified rather than on a phrase list that would invert the
# first time the model rewords itself (a-prescribed-phrase-list-can-invert-on-the-live-corpus). The
# token is stripped before stdout, so the human/--say/--chat contract is unchanged.
#
# THE SENTINEL INSTRUCTION CHANGES THE MODEL'S WILLINGNESS TO REFUSE, NOT ONLY ITS FORMATTING —
# measured, and it cost a real capability before it was caught. The first wording ("if the image is
# too dark, blurry, or empty to identify anything, begin with $BLIND_TOKEN") made qwen3-vl refuse
# ~/.mesh/cam/bruno-imac-now.jpg, a frame it had answered MINUTES EARLIER under the original prompt
# with "bed, nightstand, humidifier, dumbbell, yoga mat bag, exercise equipment". Offering an easy
# exit is not a neutral formatting change: it lowers the bar for taking it, and a novelty archive fed
# by a newly timid eye would record blindness where the world was legible. The wording now asks for
# partial identification explicitly and makes the token a LAST resort, re-verified against that same
# frame as the control.
BLIND_TOKEN="UNIDENTIFIABLE"
BASE_PROMPT="Identify the main object(s) in this image. Name each plainly (and brand/model if clearly readable). Even in a dim, grainy or partial image, name whatever objects you CAN make out — a partial identification is wanted. Do NOT identify, name, or describe any person's appearance, clothing, or face. ONLY if you can make out no object at all, begin your answer with the single word $BLIND_TOKEN. Answer in ONE short line."

# request build: JSON with the prompt + the image file base64-inlined as a data URL
REQ_PY='
import base64,json,sys
b64=base64.b64encode(open(sys.argv[2],"rb").read()).decode()
print(json.dumps({"model":sys.argv[1],"messages":[{"role":"user","content":[
 {"type":"text","text":sys.argv[3]},
 {"type":"image_url","image_url":{"url":"data:image/jpeg;base64,"+b64}}]}],"max_tokens":150}))
'
# response parse: content or die — an error body must NOT parse (would mask a failed call)
RESP_PY='
import json,sys
d=json.load(sys.stdin)
print(d["choices"][0]["message"]["content"].strip())
'
# ollama (local GPU) request: model + prompt + image base64-inlined in the images[] array
OLLAMA_REQ_PY='
import base64,json,sys
b64=base64.b64encode(open(sys.argv[2],"rb").read()).decode()
print(json.dumps({"model":sys.argv[1],"prompt":sys.argv[3],"images":[b64],
 "stream":False,"options":{"temperature":0.0,"num_ctx":int(sys.argv[4])}}))
'
# ollama response parse: "response" or die — an error body ({"error":...}, no "response") must NOT parse
OLLAMA_RESP_PY='
import json,sys
d=json.load(sys.stdin)
print(d["response"].strip())
'

# ── the observer + the archive (ASAL historical-NN novelty) ───────────────────────────────────────
# EMBED_PY: ask ollama for the representation. An EMPTY embeddings array is a FAILURE, not a vector —
# that is exactly what llmvision/glimpse-v1 returns for an image here, and treating it as a zero
# vector would make every sighting maximally similar to every other (novelty pinned at 0.000, an
# organ that has gone blind reporting perfect familiarity).
EMBED_PY='
import json,sys,urllib.request
model,url,text=sys.argv[1],sys.argv[2],sys.argv[3]
req=urllib.request.Request(url+"/api/embed",
    data=json.dumps({"model":model,"input":text}).encode(),
    headers={"Content-Type":"application/json"})
d=json.load(urllib.request.urlopen(req,timeout=30))
v=(d.get("embeddings") or [None])[0]
if not v: sys.exit(1)
print(json.dumps(v))
'
# NOVELTY_PY: ASAL Search-for-Open-Endedness, transferred verbatim in form — compare this observation
# to ALL PRIOR ones and score 1 - max(similarity). Prints "<novelty> <nn_ts> <nn_answer>".
# NO HISTORY IS NOT MAXIMAL NOVELTY. The first sighting has nothing to be novel AGAINST; scoring it
# 1.000 would mint a discovery out of an empty archive, and scoring it 0.000 would claim familiarity
# nobody has. It renders na, the same three-way discipline the ceiling tier uses.
NOVELTY_PY='
import json,math,sys
vec=json.loads(sys.argv[1]); path=sys.argv[2]; obs=sys.argv[3]
def cos(a,b):
    d=sum(x*y for x,y in zip(a,b))
    na=math.sqrt(sum(x*x for x in a)); nb=math.sqrt(sum(y*y for y in b))
    return d/(na*nb) if na and nb else 0.0
best=-2.0; bt=""; ba=""
try: rows=open(path,encoding="utf-8").read().splitlines()
except OSError: rows=[]
for ln in rows:
    try: r=json.loads(ln)
    except Exception: continue
    # an embedding from a DIFFERENT observer is not comparable — two representation spaces are not one
    # space, and silently mixing them would compute a distance that means nothing.
    if r.get("observer")!=obs: continue
    if r.get("kind")=="blind": continue   # a refusal is not a neighbour: recognising one blind frame
                                          # in another is not recognition, it is two failures agreeing
    e=r.get("emb")
    if not e or len(e)!=len(vec): continue
    c=cos(vec,e)
    if c>best: best,bt,ba=c,r.get("ts",""),r.get("answer","")
if best<-1: print("na\t\t"); sys.exit(0)
print("%.3f\t%s\t%s"%(1.0-best,bt,ba))
'

embed(){ # <text> -> JSON vector on stdout, rc!=0 if the observer is unavailable
  python3 -c "$EMBED_PY" "$OBSERVER" "$OLLAMA_URL" "$1" 2>/dev/null
}

ARCHIVE_PY='
import json,os,sys
path,ts,ans,vec,nov,obs,cap,kind=sys.argv[1:9]
row={"ts":ts,"answer":ans,"observer":obs,"kind":kind,
     "novelty":(None if nov in ("na","") else float(nov)),
     "emb":(json.loads(vec) if vec else None)}
os.makedirs(os.path.dirname(path) or ".",exist_ok=True)
with open(path,"a",encoding="utf-8") as f: f.write(json.dumps(row)+"\n")
try: cap=int(cap)
except ValueError: cap=2000
lines=open(path,encoding="utf-8").read().splitlines()
if len(lines)>cap:
    open(path,"w",encoding="utf-8").write("\n".join(lines[-cap:])+"\n")
'
# bounded: keep the most recent ARCHIVE_MAX rows. Trimming SHRINKS the history novelty is scored
# against, so a long-absent object can read novel again after a trim — bounded memory is a real limit,
# not a free one, and --archive publishes n so a reader can see the horizon it is speaking from.
archive_append(){ # <ts> <answer> <vecjson> <novelty> [kind]
  python3 -c "$ARCHIVE_PY" "$ARCHIVE" "$1" "$2" "$3" "$4" "$OBSERVER" "$ARCHIVE_MAX" "${5:-sighting}" 2>/dev/null || true
}

cam_consent(){ grep -qiE '^[[:space:]]*camera[[:space:]]*=[[:space:]]*(yes|true|1)' "$CONSENT" 2>/dev/null; }

groq_id(){  # <img> <prompt> -> answer on stdout, rc!=0 on any failure
  [ -n "${GROQ_API_KEY:-}" ] || return 1
  local req; req="$(mktemp)" || return 1
  python3 -c "$REQ_PY" "$VMODEL" "$1" "$2" > "$req" 2>/dev/null || { rm -f "$req"; return 1; }
  curl -s -m 45 https://api.groq.com/openai/v1/chat/completions \
    -H "Authorization: Bearer $GROQ_API_KEY" -H "Content-Type: application/json" \
    -d @"$req" 2>/dev/null | python3 -c "$RESP_PY" 2>/dev/null
  local rc=$?; rm -f "$req"; return $rc
}

ollama_id(){  # <img> <prompt> -> answer on stdout, rc!=0 on any failure (local GPU, free)
  local req; req="$(mktemp)" || return 1
  python3 -c "$OLLAMA_REQ_PY" "$VMODEL" "$1" "$2" "$VISION_NUM_CTX" > "$req" 2>/dev/null || { rm -f "$req"; return 1; }
  curl -s -m 90 "$OLLAMA_URL/api/generate" \
    -H "Content-Type: application/json" -d @"$req" 2>/dev/null | python3 -c "$OLLAMA_RESP_PY" 2>/dev/null
  local rc=$?; rm -f "$req"; return $rc
}

# route by the shape of MESH_VISION_MODEL: vendor-prefixed id (has "/") → Groq cloud; bare tag → local GPU.
vision_id(){ case "$VMODEL" in */*) groq_id "$1" "$2" ;; *) ollama_id "$1" "$2" ;; esac; }

claude_id(){  # <img> <prompt> — mesh-see's proven vision path (quota fallback)
  command -v claude >/dev/null 2>&1 || return 1
  (cd /tmp && timeout 120 claude -p "Read the image at $1. $2 Output only the answer line." \
     --allowedTools Read 2>/dev/null) | grep -a . | tail -1 | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' | grep .
}

capture(){  # -> echoes the frame path used, rc!=0 if no real frame obtainable
  local i
  for i in 1 2 3 4 5; do
    mesh-camera "$OUT" >/dev/null 2>&1 && [ -s "$OUT" ] && { echo "$OUT"; return 0; }
    sleep 2
  done
  # device held (cam-watch polls it) → use its own baseline frame if fresh
  if [ -s "$PREV" ]; then
    local age=$(( $(date +%s) - $(stat -c %Y "$PREV") ))
    [ "$age" -le "$PREV_MAX_AGE" ] && { echo "$PREV"; return 0; }
  fi
  return 1
}

SUMMARY_PY='
import json,sys,collections
path=sys.argv[1]
try: rows=[json.loads(l) for l in open(path,encoding="utf-8") if l.strip()]
except OSError: rows=[]
if not rows:
    print("[object-id archive] empty — this node has never recorded a sighting"); sys.exit(2)
obs=collections.Counter(r.get("observer") or "none" for r in rows)
scored=[r["novelty"] for r in rows if isinstance(r.get("novelty"),float)]
noemb=sum(1 for r in rows if not r.get("emb"))
blind=sum(1 for r in rows if r.get("kind")=="blind")
print("[object-id archive] n=%d sightings=%d blind=%d span=%s..%s observers=%s scored=%d unscored=%d (no representation)"
      % (len(rows), len(rows)-blind, blind, rows[0].get("ts","?"), rows[-1].get("ts","?"),
         ",".join("%s:%d"%kv for kv in obs.most_common()), len(scored), noemb))
if scored:
    ss=sorted(scored)
    print("  novelty  min=%.3f  median=%.3f  max=%.3f" % (ss[0], ss[len(ss)//2], ss[-1]))
for r in rows[-5:]:
    n=r.get("novelty")
    print("  %s  novelty=%s  %s" % (r.get("ts","?"), ("na" if n is None else "%.3f"%n), (r.get("answer") or "")[:70]))
'
if [ "${1:-}" = --archive ]; then
  python3 -c "$SUMMARY_PY" "$ARCHIVE"; exit $?
fi

if [ "${1:-}" = --test ]; then
  # (1) request build — valid JSON, right model, prompt verbatim, image inlined as data-URL
  tf="$(mktemp --suffix=.jpg)"; printf 'notarealjpeg' > "$tf"
  req="$(python3 -c "$REQ_PY" "test-model" "$tf" "ping-prompt" 2>/dev/null)" \
    || { echo "smoke-test: FAIL (vision request-build errored)"; rm -f "$tf"; exit 1; }
  rm -f "$tf"
  printf '%s' "$req" | python3 -c '
import json,sys
d=json.load(sys.stdin); assert d["model"]=="test-model"
c=d["messages"][0]["content"]
assert c[0]["text"]=="ping-prompt" and c[1]["image_url"]["url"].startswith("data:image/jpeg;base64,")
' 2>/dev/null || { echo "smoke-test: FAIL (vision request shape drifted: ${req:0:120})"; exit 1; }
  # (2) response parse — content extracted; an error body must be REJECTED
  got="$(printf '%s' '{"choices":[{"message":{"content":"a mug"}}]}' | python3 -c "$RESP_PY" 2>/dev/null)"
  [ "$got" = "a mug" ] || { echo "smoke-test: FAIL (vision response-parse drifted: got '$got')"; exit 1; }
  if printf '%s' '{"error":{"message":"rate_limited"}}' | python3 -c "$RESP_PY" >/dev/null 2>&1; then
    echo "smoke-test: FAIL (parse accepted an error body — would mask a failed call)"; exit 1; fi
  # (2b) LOCAL ollama request/parse — the default backend. images[] inlined; error body REJECTED.
  tf="$(mktemp --suffix=.jpg)"; printf 'notarealjpeg' > "$tf"
  oreq="$(python3 -c "$OLLAMA_REQ_PY" "test-tag" "$tf" "ping-prompt" 4242 2>/dev/null)" \
    || { echo "smoke-test: FAIL (ollama request-build errored)"; rm -f "$tf"; exit 1; }
  rm -f "$tf"
  printf '%s' "$oreq" | python3 -c '
import json,sys
d=json.load(sys.stdin); assert d["model"]=="test-tag" and d["prompt"]=="ping-prompt"
assert d["images"] and d["options"]["num_ctx"]==4242 and d["stream"] is False
' 2>/dev/null || { echo "smoke-test: FAIL (ollama request shape drifted: ${oreq:0:120})"; exit 1; }
  ogot="$(printf '%s' '{"response":"a mug"}' | python3 -c "$OLLAMA_RESP_PY" 2>/dev/null)"
  [ "$ogot" = "a mug" ] || { echo "smoke-test: FAIL (ollama response-parse drifted: got '$ogot')"; exit 1; }
  if printf '%s' '{"error":"model not found"}' | python3 -c "$OLLAMA_RESP_PY" >/dev/null 2>&1; then
    echo "smoke-test: FAIL (ollama parse accepted an error body — a dead model would fake an answer)"; exit 1; fi
  # (2c) RED-first: the RETIRED Groq id must yield EMPTY, never a fake/stale line. Drive the exact
  # retired id through the routing+parse the tool uses (case → groq path → RESP_PY on the live 404
  # body) and assert vision_id returns nothing — a dead primary fails LOUD (empty→claude), never a
  # confident "sees nothing". Skipped only if there is no key to make the live call.
  if [ -n "${GROQ_API_KEY:-}" ]; then
    tf="$(mktemp --suffix=.jpg)"; printf 'notarealjpeg' > "$tf"
    dead="$(VMODEL='meta-llama/llama-4-scout-17b-16e-instruct'; \
            req="$(python3 -c "$REQ_PY" "$VMODEL" "$tf" "$BASE_PROMPT" 2>/dev/null)"; \
            curl -s -m 30 https://api.groq.com/openai/v1/chat/completions \
              -H "Authorization: Bearer $GROQ_API_KEY" -H "Content-Type: application/json" \
              -d "$req" 2>/dev/null | python3 -c "$RESP_PY" 2>/dev/null)"
    rm -f "$tf"
    [ -z "$dead" ] || { echo "smoke-test: FAIL (retired Groq id parsed to a NON-empty answer '$dead' — a dead model is faking a read)"; exit 1; }
  fi
  # (3) a vision backend must exist. Default is LOCAL: for a bare-tag model the ollama server must be
  # reachable AND the model pulled; a vendor/id needs a Groq key; claude is the last-resort fallback.
  backend_ok=0
  case "$VMODEL" in
    */*) [ -n "${GROQ_API_KEY:-}" ] && backend_ok=1 ;;
    *)   if curl -s -m 3 "$OLLAMA_URL/api/tags" 2>/dev/null \
              | python3 -c "import json,sys; b='${VMODEL%%:*}'; n=[m.get('name','') for m in json.load(sys.stdin).get('models',[])]; sys.exit(0 if any(x=='$VMODEL' or x.split(':',1)[0]==b for x in n) else 1)" 2>/dev/null; then
           backend_ok=1; fi ;;
  esac
  if [ "$backend_ok" = 0 ]; then
    command -v claude >/dev/null 2>&1 && backend_ok=1
  fi
  [ "$backend_ok" = 1 ] || { echo "smoke-test: FAIL (no vision backend for '$VMODEL': ollama/model absent, no Groq key, no claude)"; exit 1; }
  # (4) a real frame source must exist — an object-ID sense with no camera is hollow
  if ! mesh-camera --test >/dev/null 2>&1 && [ ! -s "$PREV" ]; then
    echo "smoke-test: FAIL (no frame source: mesh-camera --test failed and no cam-watch baseline)"; exit 1; fi
  # ── (5) NOVELTY / THE OBSERVER (2026-08-25 review). Pure arms first, then one LIVE relational arm.
  na_="$(mktemp -d)"; arc="$na_/arc.jsonl"
  # (5a) NO HISTORY IS NOT MAXIMAL NOVELTY. An empty archive must render na — never 1.000 (which would
  # mint a discovery out of nothing) and never 0.000 (which would claim familiarity nobody has).
  v1='[1,0,0]'
  r="$(python3 -c "$NOVELTY_PY" "$v1" "$arc" "obs-A" 2>/dev/null | cut -f1)"
  [ "$r" = na ] || { echo "smoke-test: FAIL (empty archive must score na, got '$r')"; rm -rf "$na_"; exit 1; }
  # (5b) ASAL's score is 1 - MAX similarity over ALL prior rows, not the mean and not the last:
  # a near-identical row anywhere in history must pull novelty down even with distant rows present.
  printf '%s\n' '{"ts":"T1","answer":"far","observer":"obs-A","novelty":null,"emb":[0,1,0]}' \
                 '{"ts":"T2","answer":"near","observer":"obs-A","novelty":null,"emb":[1,0,0]}' \
                 '{"ts":"T3","answer":"far2","observer":"obs-A","novelty":null,"emb":[0,0,1]}' > "$arc"
  IFS=$'\t' read -r r nts nans <<EOF3
$(python3 -c "$NOVELTY_PY" "$v1" "$arc" "obs-A" 2>/dev/null)
EOF3
  [ "$r" = "0.000" ] || { echo "smoke-test: FAIL (historical-NN must be 1-MAX sim = 0.000 against an identical prior row, got '$r')"; rm -rf "$na_"; exit 1; }
  [ "$nans" = "near" ] || { echo "smoke-test: FAIL (must name the nearest neighbour 'near', got '$nans')"; rm -rf "$na_"; exit 1; }
  # (5c) TWO REPRESENTATION SPACES ARE NOT ONE SPACE. Rows from a different observer must be INVISIBLE
  # to the score — mixing them computes a distance between coordinates that mean different things.
  r="$(python3 -c "$NOVELTY_PY" "$v1" "$arc" "obs-B" 2>/dev/null | cut -f1)"
  [ "$r" = na ] || { echo "smoke-test: FAIL (a foreign observer's rows must not be scored against, got '$r')"; rm -rf "$na_"; exit 1; }
  # (5d) AN EMPTY EMBEDDING IS A FAILURE, NOT A ZERO VECTOR. This is the live shape: glimpse-v1
  # returns {"embeddings":[]} for an image on this ollama. Treating it as a vector would pin novelty
  # and make a blind organ report perfect familiarity — so embed() must exit non-zero, and the caller
  # must render na with observer=none rather than fall back to comparing strings.
  if python3 -c "$EMBED_PY" "definitely-not-a-model:9" "$OLLAMA_URL" "x" >/dev/null 2>&1; then
    echo "smoke-test: FAIL (embed() accepted a bogus observer — a missing representation must fail loud)"; rm -rf "$na_"; exit 1; fi
  # (5e) LIVE, RELATIONAL — the whole point of the transfer, asserted as an ORDER and never as a
  # constant, so it cannot rot as the observer model changes (calibrate-a-derived-axis-against-the-
  # live-corpus). A byte-exact archive scores 1.000 on BOTH pairs; a representation must not.
  if pv="$(embed 'a white ceramic mug')" && [ -n "$pv" ]; then
    printf '%s\n' '{"ts":"T1","answer":"a mug","observer":"'"$OBSERVER"'","novelty":null,"emb":'"$(embed 'a mug')"'}' > "$arc"
    para="$(python3 -c "$NOVELTY_PY" "$pv" "$arc" "$OBSERVER" 2>/dev/null | cut -f1)"
    dv="$(embed 'a bicycle')"
    dist="$(python3 -c "$NOVELTY_PY" "$dv" "$arc" "$OBSERVER" 2>/dev/null | cut -f1)"
    awk -v a="$para" -v b="$dist" 'BEGIN{exit !(a+0 < b+0)}' \
      || { echo "smoke-test: FAIL (observer '$OBSERVER' does not discriminate: paraphrase novelty $para must be < distinct-object novelty $dist — a byte-exact key scores 1.000 on both)"; rm -rf "$na_"; exit 1; }
    echo "  observer $OBSERVER discriminates: paraphrase=$para < distinct=$dist"
  else
    echo "  novelty live-arm SKIPPED: observer '$OBSERVER' unreachable (pure arms 5a-5d passed)"
  fi
  # (5f) THE PROMPT AND THE PREDICATE ARE ONE CONTRACT. The blind cut keys on $BLIND_TOKEN; if the
  # prompt stops ASKING for it, every unidentifiable frame silently re-enters the archive as a
  # sighting and the 0.000 "seen-before" bug returns. Asserted against the live BASE_PROMPT variable —
  # the string the model actually receives — never against source text, which a comment could satisfy.
  case "$BASE_PROMPT" in
    *"$BLIND_TOKEN"*) : ;;
    *) echo "smoke-test: FAIL (BASE_PROMPT no longer asks for the '$BLIND_TOKEN' sentinel the blind cut keys on — refusals would archive as sightings)"; rm -rf "$na_"; exit 1 ;;
  esac
  # (5g) A BLIND ROW IS NOT A NEIGHBOUR. Two frames the model could not read are two failures agreeing,
  # not a recognition — the exact live bug this arm was written from (novelty=0.000 "seen-before" on a
  # second dark frame). With ONLY a blind row in history the score must be na, not 0.000.
  printf '%s\n' '{"ts":"T1","answer":"too dark","observer":"obs-A","kind":"blind","novelty":null,"emb":[1,0,0]}' > "$arc"
  r="$(python3 -c "$NOVELTY_PY" "$v1" "$arc" "obs-A" 2>/dev/null | cut -f1)"
  [ "$r" = na ] || { echo "smoke-test: FAIL (a blind row must not be scored as a neighbour — got '$r', the live 0.000 seen-before bug)"; rm -rf "$na_"; exit 1; }
  # (5h) THE SENTINEL MUST NEVER REACH STDOUT. It leaked once (the cut sat AFTER the echo, and a
  # hand-listed separator class missed the em-dash the model actually emitted), so both halves are
  # gated: the token is removed, and so is whatever punctuation followed it.
  for probe in "${BLIND_TOKEN} — image too dark and blurry" "${BLIND_TOKEN}: nothing visible" "${BLIND_TOKEN}"; do
    stripped="$(printf '%s' "$probe" | sed "s/^$BLIND_TOKEN//" | sed 's/^[^[:alnum:]]*//')"
    case "$stripped" in
      *"$BLIND_TOKEN"*) echo "smoke-test: FAIL (sentinel survived the strip: '$probe' -> '$stripped')"; rm -rf "$na_"; exit 1 ;;
    esac
    case "$stripped" in
      [[:alnum:]]*|'') : ;;
      *) echo "smoke-test: FAIL (punctuation leaked after the strip: '$probe' -> '$stripped')"; rm -rf "$na_"; exit 1 ;;
    esac
  done
  rm -rf "$na_"
  echo "smoke-test: ok"; exit 0
fi

# --- args ---
ASK=""; IMG=""; SAY=0; CHAT=0; NOV=0
while [ $# -gt 0 ]; do
  case "$1" in
    --ask)  ASK="${2:-}"; shift 2 ;;
    --say)  SAY=1; shift ;;
    --chat) CHAT=1; shift ;;
    --novelty) NOV=1; shift ;;
    -*)     echo "mesh-object-id: unknown flag $1" >&2; exit 1 ;;
    *)      IMG="$1"; shift ;;
  esac
done
PROMPT="$BASE_PROMPT"; [ -n "$ASK" ] && PROMPT="$PROMPT Additional question: $ASK"

if [ -n "$IMG" ]; then
  [ -s "$IMG" ] || { echo "mesh-object-id: image not found or empty: $IMG" >&2; exit 1; }
else
  cam_consent || { echo "mesh-object-id: REFUSED — capture is consent-gated (~/.mesh/consent camera=yes)" >&2; exit 1; }
  IMG="$(capture)" || { echo "mesh-object-id: no frame (capture busy/failing and no fresh cam-watch baseline)" >&2; exit 1; }
fi

ans="$(vision_id "$IMG" "$PROMPT")" || ans=""
[ -n "$ans" ] || ans="$(claude_id "$IMG" "$PROMPT")" || true
[ -n "$ans" ] || { echo "mesh-object-id: all vision backends failed (${VMODEL} + claude)" >&2; exit 1; }

ts_now="$(date -u +%FT%TZ)"
# BLIND-FRAME CUT, made before anything is scored. The token is OUR OWN contract with the model (see
# BASE_PROMPT), so this predicate and the prompt cannot drift apart the way a phrase list would — and
# --test asserts the live BASE_PROMPT still asks for it, keyed on the VARIABLE the model actually
# receives rather than on source text.
kind=sighting
case "$ans" in
  "$BLIND_TOKEN"*) kind=blind
                   # strip the token AND whatever punctuation the model chose to follow it with. A
                   # hand-listed character class missed the em-dash the model actually emitted and
                   # leaked "UNIDENTIFIABLE —" into stdout, so this cuts any leading run that is not
                   # alphanumeric rather than enumerating separators (an-enumerated-alphabet-is-a-
                   # copy-that-rots).
                   ans="$(printf '%s' "$ans" | sed "s/^$BLIND_TOKEN//" | sed 's/^[^[:alnum:]]*//')"
                   [ -n "$ans" ] || ans="could not identify anything in the frame" ;;
esac

# STDOUT CONTRACT UNCHANGED: line 1 is still the bare answer, WITH the sentinel already stripped —
# this cut has to happen BEFORE the echo, not after, or the token leaks to the human line and to
# --say/--chat, which is the contract the strip exists to preserve.
echo "$ans"

# ARCHIVE ALWAYS (the memory this organ never had), SCORE ALWAYS, PRINT on --novelty. Scoring on
# every run is what makes the archive comparable at all: a row written without a representation can
# never be scored against later, so skipping the embed on non---novelty runs would silently punch
# holes in the very history the score is taken over.
vec=""
[ "$kind" = sighting ] && { vec="$(embed "$ans")" || vec=""; }
if [ -n "$vec" ]; then
  IFS=$'\t' read -r nov nn_ts nn_ans <<EOF2
$(python3 -c "$NOVELTY_PY" "$vec" "$ARCHIVE" "$OBSERVER" 2>/dev/null)
EOF2
  [ -n "${nov:-}" ] || nov=na
else
  # THE OBSERVER IS THE MEASURE (ASAL). With no representation function there is no novelty — not a
  # degraded one, and emphatically not a string comparison wearing the word. na, and say WHY.
  nov=na; nn_ts=""; nn_ans=""
fi
archive_append "$ts_now" "$ans" "$vec" "$nov" "$kind"

if [ "$NOV" = 1 ]; then
  if [ "$nov" = na ]; then
    if [ "$kind" = blind ]; then
      printf 'novelty=na (blind frame — nothing identified, so there is nothing to be novel) observer=%s\n' "$OBSERVER"
    elif [ -n "$vec" ]; then
      printf 'novelty=na (no prior sighting under this observer) observer=%s\n' "$OBSERVER"
    else
      printf 'novelty=na (no representation function — observer %s unavailable) observer=none\n' "$OBSERVER"
    fi
  else
    verdict=$(awk -v n="$nov" -v t="$NEW_AT" 'BEGIN{print (n>=t)?"NEW":"seen-before"}')
    printf 'novelty=%s %s observer=%s nearest=%s (%s)\n' \
      "$nov" "$verdict" "$OBSERVER" "$(printf '%s' "${nn_ans:-?}" | head -c 60)" "${nn_ts:-?}"
  fi
fi

[ "$SAY"  = 1 ] && command -v mesh-say  >/dev/null 2>&1 && mesh-say  "$ans" >/dev/null 2>&1
[ "$CHAT" = 1 ] && command -v mesh-chat >/dev/null 2>&1 && mesh-chat "[see] object-id: $ans" >/dev/null 2>&1
exit 0
