#!/usr/bin/env bash
# mesh-dash <role> — renders the live DATA text for a channel's TOP pane (data = text, self-refreshing).
# Pairs with a mind in the bottom pane (the channel pattern: top data, bottom mind). All text.
# PERCEIVE-ANEW: every frame is re-derived from live state — reflex edge-artifacts, beats, logs,
# git — never a stored summary. The generic walls (state_wall/beat_wall/mind_wall) enumerate
# whatever artifacts EXIST, so a new reflex shows up in the pane without editing this dash.
# ROLE-SPECIFIC by operator request: the board lives in the chat window ONLY — no dash tails chat.log.
#   roles: steward | check | verify | codex/worker | minds | dev | reflexes | organs | tg | <other> (node card)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes" 2>/dev/null
# shared freshness idiom (render-layer lease, PART 3) — one lib so every pane ages values the same way;
# inline fallback so a missing lib never blanks the pane (degrade to visible UNKNOWN, never to blank).
_mf="$(command -v mesh-freshness 2>/dev/null)"; [ -n "$_mf" ] && . "$_mf" 2>/dev/null || true
command -v fresh_mark >/dev/null 2>&1 || fresh_mark(){ local f="$1" v="$2" ttl="${3:-1800}" a; [ -e "$f" ] || { echo "UNKNOWN (no data)"; return; }; a=$(( $(date +%s) - $(stat -c %Y "$f" 2>/dev/null || echo 0) )); [ -n "$v" ] || { echo "UNKNOWN (empty)"; return; }; [ "$a" -gt "$ttl" ] && echo "$v (${a}s STALE)" || echo "$v (${a}s)"; }
# BLE peer vantage for the cross-node presence MAP — resolved from the node-local registry, NEVER a
# hardcoded IP in the genome (that's how infra leaked before). First user@host that isn't self or a
# no-BLE VM/appliance. Perception windows draw from ALL nodes (operator: a window = the SUM of the
# whole mesh, not one node), so presence is a cross-node fusion, not a local scan.
BLE_PEER=""
for _tok in ${MESH_NODES:-}; do
  case "$_tok" in router:*|GL-MT3000:*|phaedra:*|ilya:*|ideapad:*|*:local) continue ;; esac
  case "${_tok#*:}" in *@*) BLE_PEER="${_tok#*:}"; break ;; esac
done
ONCE=0
if [ "${1:-}" = --test ]; then
  # a dash that paints a blank pane looks alive and informs nobody — so the smoke is a REAL
  # one-frame render (via --once), asserted on content, not an echo-ok
  for x in date git awk grep tail head printf stat; do
    command -v "$x" >/dev/null 2>&1 || { echo "smoke-test: FAIL (no $x)"; exit 1; }
  done
  out="$("$0" --once verify 2>&1)" || { echo "smoke-test: FAIL (verify render exited non-zero)"; exit 1; }
  printf '%s' "$out" | grep -q 'landed recently' || { echo "smoke-test: FAIL (verify frame missing its data block)"; exit 1; }
  out="$("$0" --once card-fallback 2>&1)" || { echo "smoke-test: FAIL (fallback render exited non-zero)"; exit 1; }
  printf '%s' "$out" | grep -q 'node card' || { echo "smoke-test: FAIL (fallback frame missing node card)"; exit 1; }
  echo "smoke-test: ok"; exit 0
fi
[ "${1:-}" = --once ] && { ONCE=1; shift; }   # render one frame and exit (no clear/sleep) — for --test
role="${1:-steward}"; M="$HOME/.mesh"; REPO="$HOME/lte-workstation"
# pub channel's DATA pane is its OWN two-half dash (mesh-pub-dash: WRITE-ABOUT | external COMMENTS) —
# not a role rendered here. Hand off entirely so `mesh-dash pub` (the manifest's top-pane cmd) IS it.
if [ "$role" = pub ] && [ -x "$HOME/.local/bin/mesh-pub-dash" ]; then
  [ "${ONCE:-0}" = 1 ] && exec "$HOME/.local/bin/mesh-pub-dash" --once || exec "$HOME/.local/bin/mesh-pub-dash"
fi
# SELF-REEXEC ON CODE UPDATE — a long-lived pane keeps its FIRST in-memory parse of this script, so a
# dash edit (e.g. dropping a block) leaves every running pane rendering the OLD layout with stale data
# until someone manually respawns it (operator-caught 2026-06-15: plan pane stale 1d22h after an edit).
# Fix at the source: stamp our own mtime at startup; each loop, if the file on disk is NEWER, exec the
# fresh code in place. No respawn list to maintain, no external reflex — every role self-heals within
# one refresh cycle of a deploy. ONCE/test path skips it (single frame, no loop).
SELF="$(command -v "$0" 2>/dev/null || echo "$0")"
SELF_MTIME="$(stat -c %Y "$SELF" 2>/dev/null || echo 0)"
# per-role refresh: organs fans out SSH to every peer (keep it cool); reflexes is local-cheap;
# room is a LIVE transcript the operator watches while talking — repaint every 3s, and the room case
# refreshes its ds cross-node cache every 3s too, so new transcript lines show within a few seconds.
case "$role" in organs) SLEEP=300 ;; reflexes) SLEEP=60 ;; room) SLEEP=3 ;; *) SLEEP=30 ;; esac

age_of(){ # human age of a file's last touch — "how fresh is this perception"
  local f="$1" a; [ -f "$f" ] || { echo "-"; return; }
  a=$(( $(date +%s) - $(stat -c %Y "$f" 2>/dev/null || echo 0) ))
  if   [ "$a" -ge 86400 ]; then echo "$((a/86400))d"
  elif [ "$a" -ge 3600 ];  then echo "$((a/3600))h"
  elif [ "$a" -ge 60 ];    then echo "$((a/60))m"
  else echo "${a}s"; fi
}
state_wall(){ # EVERY edge-trigger reflex state, one live line each — grows as reflexes grow
  local f n
  for f in "$M"/.[a-z]*-state; do
    [ -f "$f" ] || continue
    n="${f##*/}"; n="${n#.}"
    case "$n" in mind-state-*) continue;; esac   # minds get their own wall
    printf '  %-22s %-16s age %s\n' "${n%-state}" \
      "$(head -c30 "$f" 2>/dev/null | tr '\n' ' ')" "$(age_of "$f")"
  done
}
mind_wall(){ # last classified pane-state per mind channel (watcher re-derives these)
  local f
  for f in "$M"/.mind-state-*; do
    [ -f "$f" ] || continue
    printf '  %-8s %-14s age %s\n' "${f##*-}" "$(head -c20 "$f" 2>/dev/null | tr '\n' ' ')" "$(age_of "$f")"
  done
}
beat_wall(){ # liveness beats — own heart, peers' hearts, reflex per-run beats
  local f n
  for f in "$M"/heartbeat*.beat "$M"/.*.beat; do
    [ -f "$f" ] || continue
    n="${f##*/}"; n="${n%.beat}"; n="${n#.}"; n="${n#heartbeat-}"; [ "$n" = heartbeat ] && n=self
    printf '  %-28s age %s\n' "$n" "$(age_of "$f")"
  done
}
# --- enrichment helpers (operator 2026-06-15: "data pane can be much more helpful") ---
stress_line(){ # the node's KNOWN FAILURE MODE first — the operator channel dies from heat (thermal throttle)
  local s; s="$(timeout 8 mesh-stress 2>/dev/null | sed 's/^mesh-stress: //')"
  [ -n "$s" ] && printf 'STRESS %s' "$s" || printf 'STRESS (unknown)'
}
actionable_minds(){ # ONLY minds that need a hand (the steward's job = drive these); else a one-line all-clear
  local f n st hits=0 total=0
  for f in "$M"/.mind-state-*; do
    [ -f "$f" ] || continue
    total=$((total+1)); n="${f##*-}"; st="$(head -c20 "$f" 2>/dev/null | tr -d '\n ')"
    case "$st" in BLOCKED*|NEEDS-INPUT*|RATE-LIMITED*|DEAD*)
      printf '  ⚠ %-8s %-14s age %s\n' "$n" "$st" "$(age_of "$f")"; hits=$((hits+1)) ;;
    esac
  done
  [ "$hits" = 0 ] && printf '  ✓ none blocked — %s minds idle/working\n' "$total"
}
open_work(){ # in-flight work = recent [taking] on the board today (real work, NOT vanity done-counts)
  local td lines; td=$(date -u +%F)
  lines="$(grep "$td" "$M/chat.log" 2>/dev/null | grep -oE '\[taking\].*' | tail -4)"
  if [ -n "$lines" ]; then printf '%s\n' "$lines" | cut -c1-92 | sed 's/^/  /'
  else printf '  (no work claimed today)\n'; fi
}
# --- per-mind CONTEXT + SPEND self-meter (operator 2026-06-17: "keep track context (and /compact) +
# spend, depending on the mind"). The mesh-mind-compact + mesh-spend reflexes PRODUCE this; the data
# pane shows it; the mind acts on it (high ctx → it can /compact itself). "Depending on the mind" is
# real: opencode minds expose a readable context-% + $cost; claude minds don't (they auto-compact) —
# their spend is quota turns (mesh-spend --tokens). ONE cheap --stats call per window. ---
mind_engine(){ awk -v w="$1" '$1==w{print $2; exit}' "$M/minds.map" 2>/dev/null; }
self_meter(){ # $1=window — one line the OWNING mind reads to self-manage its context/spend
  local w="$1" eng line state tok pct doll lcage
  eng="$(mind_engine "$w")"; eng="${eng:-?}"
  line="$(mesh-mind-state --stats "$w" 2>/dev/null | awk -v w="$w" '$1==w{print;exit}')"
  state="$(printf '%s' "$line" | cut -f2 | tr -d ' ')"
  tok="$(printf '%s' "$line" | cut -f4 | tr -d ' ')"
  pct="$(printf '%s' "$line" | cut -f5 | tr -d ' ')"
  doll="$(printf '%s' "$line" | cut -f6 | tr -d ' ')"
  lcage="$(age_of "$M/.compact-$w")"
  if [ "$eng" = opencode ]; then
    printf '  self: %s · ctx %s (%s) · cost %s · last /compact %s ago (auto >60%%)\n' \
      "${state:-?}" "${pct:-?}" "${tok:-?}" "${doll:-free}" "$lcage"
  else
    printf '  self: %s · claude auto-compacts · last /compact %s ago (auto >45m idle) · spend: mesh-spend --tokens\n' \
      "${state:-?}" "$lcage"
  fi
}

while :; do
  # picked up a newer copy of ourselves? re-exec the fresh code in place (kills stale-layout panes)
  if [ "$ONCE" != 1 ]; then
    now_mtime="$(stat -c %Y "$SELF" 2>/dev/null || echo 0)"
    [ "$now_mtime" != "$SELF_MTIME" ] && exec "$SELF" "$role"
  fi
  # BUILD the frame into a buffer FIRST (the slow data-tools run in here), THEN clear+paint atomically
  # below. A slow/wedged tool now leaves the LAST good frame on screen (with its old timestamp = visibly
  # stale) instead of BLANKING the pane — the failure that made the steward pane go blank (2026-06-15).
  frame="$(
  printf '== %s data (refresh %ss) — all text ==\n' "$role" "$SLEEP"; date -u; echo
  case "$role" in
    steward)
      # 1. FUSED SITUATION — internal(stress/temp/minds) + external(security) + physical(presence) in one
      #    block. The operator-facing pane LEADS with situational awareness; temp lives here (our failure mode).
      timeout 9 mesh-situation 2>/dev/null | sed -n '1,5p' | sed 's/^==* /SITUATION: /; s/ =*$//' | cut -c1-100 || echo "SITUATION: (unavailable)"
      # 2. substrate + failure-mode detail (therm/router/egress states aren't in the situation block)
      xn=$(timeout 5 tailscale debug prefs 2>/dev/null | python3 -c 'import json,sys;print(json.load(sys.stdin).get("ExitNodeID") or "none")' 2>/dev/null)
      det=$(timeout 6 mesh-stress --json 2>/dev/null | python3 -c 'import json,sys
try:
 d=json.load(sys.stdin); print("therm=%s router=%s egress=%s%s"%(d.get("therm_state"),d.get("router_state"),d.get("egress_state")," CLIMBING" if d.get("climbing")=="yes" else ""))
except Exception: print("")' 2>/dev/null)
      echo "egress $(ip route get 1.1.1.1 2>/dev/null|grep -oP 'dev \K\S+') exitnode=$xn | doctor FAIL=$(head -c4 "$M/.doctor-cron-state" 2>/dev/null || echo '?') | reflexes $(mesh-supervise --status 2>/dev/null|grep -c UP)UP | strands=$(git -C "$REPO" status --short -- scripts/ 2>/dev/null | wc -l) | $det"
      # 3. minds-state lives ONLY in the 'minds' window's data pane (operator 2026-06-15: "minds info
      #    belongs to the minds data pane only, not yours" — it was broken/duplicated here). The minds
      #    window owns the correct live mind-state + idle hands; this pane no longer duplicates it.
      # 4. in-flight work = recent [taking] (what's happening NOW), not a vanity done-count
      echo "-- open work (claimed today) --"; open_work
      # 5. operator inbox — is the operator waiting on us? (steward owns the comms lane)
      echo "-- operator (last in, age $(age_of "$M/voice-in.log")) --"; tail -1 "$M/voice-in.log" 2>/dev/null | cut -c1-100
      # 6. PLAN this tick (PLAN.md uses '## THIS TICK', not the never-existent '## 🔜 NEXT' — audit 2026-06-19)
      echo "-- PLAN: this tick --"; awk '/^## THIS TICK/{f=1;print;next} /^## /{if(f)exit} f' "$M/PLAN.md" 2>/dev/null | grep -vE '^[[:space:]]*$' | cut -c1-92 | head -3
      # 7. recent [done] (replaces the RETIRED feed/work-pump block — it showed 2-day-old dead data)
      echo "-- recent [done] --"; grep -F '[done]' "$M/chat.log" 2>/dev/null | grep -oE '\[done\].*' | tail -3 | cut -c1-92 | sed 's/^/  /' ;;
    check)
      # UNIFIED node-health view — absorbs the old standalone organs + reflexes windows (operator
      # 2026-06-13: "none without a mind, merge into bigger ones"). One mind (this channel) watches
      # doctor + organs + reflexes + vitals + streams, re-derived live.
      sup="$(mesh-supervise --status 2>/dev/null)"
      self_meter health   # this mind's own context/spend (opencode: ctx% + $cost; /compact >60%)
      echo "egress $(ip route get 1.1.1.1 2>/dev/null|grep -oP 'dev \K\S+') | supervised $(printf '%s' "$sup"|grep -c UP)UP/$(printf '%s' "$sup"|grep -c DOWN)DOWN | organs $(mesh-organ-keepalive --status 2>/dev/null|grep -c LIVE)LIVE/$(mesh-organ-keepalive --status 2>/dev/null|grep -c DARK)DARK"
      # FLEET-WIDE health (operator 2026-06-14: every window = the WHOLE mesh, not just this node).
      # LIVE (operator 2026-06-19: Health must react to LIVE data, not a silently-rotting cache — the
      # old */10 cron was never wired, so this sat 2 DAYS stale showing dead nodes). Self-freshen: the
      # pane re-probes live when the cache is older than the TTL, else reuses it — so the data is never
      # more than ~2min old yet a 30s redraw stays cheap. Hard timeout so a slow peer can't wedge the pane.
      fc="$M/.fleet-health.cache"; fage=$(( $(date +%s) - $(stat -c %Y "$fc" 2>/dev/null || echo 0) ))
      if [ ! -s "$fc" ] || [ "$fage" -gt 150 ]; then
        ftmp="$fc.$$.tmp"  # PID-unique: concurrent dash procs (pane loop + a --once read) must not race a shared .tmp (the 'mv: cannot stat .fleet-health.cache.tmp' stderr leak)
        timeout 35 mesh-fleet-health > "$ftmp" 2>/dev/null && mv "$ftmp" "$fc"
        fage=$(( $(date +%s) - $(stat -c %Y "$fc" 2>/dev/null || echo 0) ))
      fi
      fstale=""; [ "$fage" -gt 600 ] && fstale="  ⚠️STALE (live re-probe failing — fix me)"
      echo "-- FLEET (ALL nodes — LIVE, $(age_of "$fc")$fstale) --"
      grep -vE '^===|^$|^----' "$fc" 2>/dev/null | head -9
      # DOCTOR — the role-source this channel feeds off: not just the count, the NAMED failing
      # checks (from .doctor-fails, the latest-only snapshot) so the mind can act from the pane alone.
      if [ -s "$M/.doctor-fails" ]; then
        echo "-- DOCTOR (this node, cached $(age_of "$M/.doctor-fails")) --"
        head -1 "$M/.doctor-fails"
        sed -n '2,7p' "$M/.doctor-fails" | sed 's/^/  ✗ /'
      else
        echo "doctor (this node): $(tail -1 "$M/doctor.log" 2>/dev/null) (age $(age_of "$M/doctor.log"))"
      fi
      # VPN — "always up for everyone" (operator 2026-06-19). STRICTLY OBSERVE-ONLY: reads the
      # cached state the */10 mesh-vpn-health + egress-health reflexes write — NEVER probes/touches a
      # tunnel or the router (the substrate is frozen: never-touch-working-vpn). Two SEPARATE paths:
      #   (a) friends' VPN server on phaedra (SS/trojan/WireGuard) · (b) the operator's HOME egress
      #   through the ROUTER's own NL VPN (do-not-break). A node offering a route never rides it.
      echo "-- VPN (observe-only — all clients always-up; tunnels + router FROZEN) --"
      echo "  friends@phaedra: $(tail -1 "$M/vpn-health.log" 2>/dev/null | cut -f2- | cut -c1-92) (age $(age_of "$M/vpn-health.log"))"
      echo "  roster (info, not alarm): $(tail -1 "$M/vpn-health.log" 2>/dev/null | grep -oE 'clients: [^|]+' || echo 'n/a — run mesh-vpn-health')"
      echo "  home egress(router→NL): $(tail -1 "$M/egress-health.log" 2>/dev/null | sed -E 's/^[0-9TZ:-]+ //' | cut -c1-70) (age $(age_of "$M/egress-health.log"))"
      echo "-- vitals + therm (this box's known failure mode) --"; mesh-vitals 2>/dev/null|head -1; tail -1 "$M/therm.log" 2>/dev/null | grep -oE 'max=[0-9]+°C.*' | head -1
      # freq% = ACTUAL-throttle truth, BUT only meaningful UNDER DEMAND. Low freq + high load = real
      # throttle (the operator-channel-starvation risk). Low freq + LOW load = benign idle power-saving
      # downclock, NOT a cap (the governor clocks down when there's nothing to do — temp cool, no harm).
      # So gate CAPPED on load1 vs nproc, else a quiet node falsely reads CAPPED (2026-06-21: caught freq
      # 38% at load 1.32 / 74°C = idle, not throttle). Baseline: 94-100°C at load~10 ran ~88-91% = functional.
      { fcur=$(cat /sys/devices/system/cpu/cpu*/cpufreq/scaling_cur_freq 2>/dev/null|sort -rn|head -1); fmax=$(cat /sys/devices/system/cpu/cpu*/cpufreq/cpuinfo_max_freq 2>/dev/null|sort -rn|head -1); l1=$(cut -d' ' -f1 /proc/loadavg 2>/dev/null); nc=$(nproc 2>/dev/null||echo 1); if [ -n "$fcur" ] && [ -n "$fmax" ] && [ "$fmax" -gt 0 ] 2>/dev/null; then awk -v fc="$fcur" -v fm="$fmax" -v l1="${l1:-0}" -v nc="$nc" 'BEGIN{p=int(fc/fm*100); busy=(l1>=nc*0.5); if(p>=85)s="functional"; else if(busy)s="CAPPED-under-load"; else s="idle-downclock(benign)"; printf "  freq=%d%% of max %s (load %.2f/%dc; CAPPED only = low-freq UNDER demand = real throttle; low-freq-at-idle = power-saving not a cap)\n", p, s, l1+0, nc}'; else echo "  freq=? (no cpufreq sysfs)"; fi; }
      echo "-- organs (LIVE/DARK per node) --"; mesh-organ-keepalive --status 2>/dev/null | head -6
      echo "-- supervised loops --"; printf '%s\n' "$sup" | head -6
      echo "-- edge states (every reflex, re-derived live) --"; state_wall
      echo "-- autopoiesis lanes (is the self-production machinery alive?) --"
      echo "  reflex-health=$(cat "$M/.reflex-health-state" 2>/dev/null || echo ?) vitality=$(sed -n 's/^verdict=//p' "$M/.vitality-state" 2>/dev/null || echo ?) | feed age $(age_of "$M/feed.log") | sense-evolve age $(age_of "$M/sense-evolve.log")"
      echo "-- monitor streams (last fed) --"; tail -3 "$M/channels.log" 2>/dev/null ;;   # converged feeder log (stream.log retired 2026-06-17)
    genome)
      # the GENOME channel — operator 2026-06-17: this window KEEPS and DEVELOPS the codebase
      # (autonomous development). Mind builds/improves tools, self-verifies, lands stranded fixes,
      # commits + pushes. Absorbs the old dev/discover/work/verify/plan cluster. Self-feeding lives
      # here too — the genome mind runs its own build/deploy ops (no separate shell window).
      self_meter genome   # this mind's own context/spend — /compact when ctx climbs (auto on idle too)
      # SELF-PRODUCTION cockpit — the autopoiesis meta-reflexes write these logs; this mind watches
      # the SAME data they do and acts on it (low vitality → produce/fix; a need → work it; a
      # fitness-revert → understand why; autowire → a tool joined the metabolism). Cheap (tails).
      echo "-- self-production (autopoiesis — reflexes + this mind both watch) --"
      # render-layer lease (PART 3): these strip the leading ISO ts → without re-adding age, a STALLED
      # autopoiesis lane shows its last line as if current. fresh_mark re-attaches age + STALE past 1h
      # (a lane should produce within the hour) + UNKNOWN if the log is missing/empty. Stall now visible.
      echo "  vitality: $(fresh_mark "$M/vitality.log" "$(tail -1 "$M/vitality.log" 2>/dev/null | sed -E 's/^[0-9TZ:-]+ //' | cut -c1-86)" 3600)"
      echo "  needs:    $(fresh_mark "$M/needs.log"    "$(tail -1 "$M/needs.log"    2>/dev/null | sed -E 's/^[0-9TZ:-]+ //' | cut -c1-86)" 3600)"
      # fitness is CONDITIONAL-WRITE (judges each HEAD once, then silently no-ops on a stable HEAD — like
      # feed/generate '@cond' in mesh-reflex-health). Its log mtime is the LAST-JUDGMENT time, NOT a
      # heartbeat, so fresh_mark's STALE-past-1h gave a chronic FALSE-STALE whenever no new commit landed
      # for an hour (the */27 cron keeps firing + correctly emits nothing). Show last verdict + age as
      # informational, never a STALE alarm; the cron's real liveness is mesh-reflex-health's job, not mtime.
      _fver="$(tail -1 "$M/fitness.log" 2>/dev/null | sed -E 's/^[0-9TZ:-]+ //' | cut -c1-86)"
      _fage=$(( ( $(date +%s) - $(stat -c %Y "$M/fitness.log" 2>/dev/null || date +%s) ) / 60 ))
      echo "  fitness:  ${_fver:-UNKNOWN (no data)} (HEAD judged ${_fage}m ago — conditional-write, not a heartbeat)"
      echo "  autowire: $(fresh_mark "$M/autowire.log" "$(tail -1 "$M/autowire.log" 2>/dev/null | sed -E 's/^[0-9TZ:-]+ //' | cut -c1-86)" 3600)"
      echo "  feed:     $(tail -1 "$M/feed.log" 2>/dev/null | sed -E 's/^[0-9TZ:-]+ //') | backlog=$(grep -cvE '^[[:space:]]*(#|$)' "$M/backlog" 2>/dev/null || echo 0)"
      echo "-- working tree (uncommitted) --"; git -C "$REPO" status -s 2>/dev/null | head -10
      echo "-- unpushed (origin/main..HEAD) --"; git -C "$REPO" --no-pager log --oneline origin/main..HEAD 2>/dev/null | head -5
      echo "-- stranded (settled, needs landing) --"; timeout 20 mesh-land 2>/dev/null | head -5   # bare = READ-ONLY dry-run; --check POSTS [strand] to the board (a dash must never write — flood 2026-06-17)
      echo "-- genome<->local drift --"; timeout 20 mesh-sync-tools 2>/dev/null | grep -iE 'drift|differ|stale|sync' | head -5
      # verify rotations: read the REAL artifact (verify.log never existed — audit 2026-06-19). Show
      # the latest verify-rotation-*.log + its age so a STALLED verify rotation is visible, not blank.
      vr="$(ls -t "$M"/verify-rotation-*.log 2>/dev/null | head -1)"
      echo "-- verify rotations ($([ -n "$vr" ] && age_of "$vr" || echo none)) --"; [ -n "$vr" ] && tail -2 "$vr" 2>/dev/null || echo "  (no verify rotation log yet)"
      # PLAN next: PLAN.md headers are '## THIS TICK' (the '## 🔜 NEXT' header never existed → blank;
      # audit 2026-06-19). Show the FIRST (current) THIS TICK block.
      echo "-- PLAN: this tick --"; awk '/^## THIS TICK/{f=1;print;next} /^## /{if(f)exit} f' "$M/PLAN.md" 2>/dev/null | grep -vE '^[[:space:]]*$' | cut -c1-92 | head -4
      echo "-- recent commits --"; git -C "$REPO" --no-pager log --oneline -5 2>/dev/null ;;
    senses)
      # the SENSE-TENDING channel — operator 2026-06-17: this window KEEPS and DEVELOPS the senses
      # (perception analogue of genome). Mind verifies each sense yields a REAL artifact, fixes broken
      # organs, builds/improves sense tools + their reflexes. Cheap reads only (no per-frame phone SSH —
      # that is the mind's job); heavy probes belong to the mind, not the dash refresh loop.
      self_meter senses   # this mind's own context/spend (opencode: ctx% + $cost; /compact >60%)
      # CROSS-DEVICE sense map (operator 2026-06-19: harvest senses from EVERYTHING we reach, not
      # just the phone; the value is CROSS-validation between devices). Cheap: reads the cached
      # mesh-sense-map (a */10 reflex refreshes it via the SSH fan-out — never probed per frame here).
      timeout 6 mesh-sense-map --cached 2>/dev/null || echo "  (mesh-sense-map unavailable)"
      # COLLECTED cross-validation (operator's frontier: turn the inventory into a corroborated signal).
      # Cheap: reads the wifi-crossval state file (a */2h --edge reflex runs the IdeaPad↔iMac SSH scan);
      # the actual cross-check is NEVER run per frame here.
      echo "  cross-val (wifi, IdeaPad↔iMac): $(cat "$M/wifi-crossval.state" 2>/dev/null | tr '|' ' ' || echo 'n/a — run mesh-wifi-crossval')"
      # BLE 2-vantage SPACE-MAP (operator's wanted capability): cached cat of ble-spacemap.state, written
      # by mesh-presence-fuse's one-shot run. Cheap — never runs the expensive 2-node BLE+SSH scan here.
      echo "  cross-val (ble,  IdeaPad↔ds):   $(cat "$M/ble-spacemap.state" 2>/dev/null || echo 'n/a — run mesh-presence-fuse')"
      # ALL senses the mesh has — the cached roll-call (operator 2026-06-17: "this window's top pane
      # should be all senses mesh has"). Cheap: reads the reflexes' cached artifacts, never live-probes
      # the phone per frame (that is the mind's job). STALE markers = the dead/lagging senses to fix.
      echo "-- LIVE READINGS (this node, cached — the mind runs live cross-checks) --"
      timeout 10 mesh-sensorium --cached 2>/dev/null | sed '1d' || echo "  (mesh-sensorium unavailable)"
      # ATTENDED-NESS / security: who holds a live session on THIS node and from WHERE (mesh-sessions).
      # Cheap + LOCAL (utmp via `w`, ~ms, no SSH) so it runs live per frame — a FOREIGN (public-IP)
      # login surfaces immediately, not on a cron delay. Honest: mesh-sessions exits 2 on unreadable
      # utmp → empty stdout → we render UNAVAILABLE, never a faked QUIET all-clear.
      echo "-- attended-ness (physical+nearby+remote fusion; stale sessions excluded) --"
      # mesh-attendance fuses keyboard(physical) + personal-BLE(nearby) + utmp(remote, REACHABILITY-
      # GATED so a stale half-open session is not counted live — liveness-is-a-lease). Richer + more
      # honest than raw mesh-sessions (which counts a lingering utmp peer as live). Heavier (2s keypress
      # sample + peer pings) → THROTTLED to ~120s into a cache, like FLEET above, so the 30s render loop
      # stays cheap. Honest-degraded: all-channels-blind → exit 2 → empty cache → fall back to raw
      # mesh-sessions (still honest: utmp unreadable → UNAVAILABLE, never a faked QUIET).
      ac="$M/.attendance.cache"; acage=$(( $(date +%s) - $(stat -c %Y "$ac" 2>/dev/null || echo 0) ))
      if [ ! -s "$ac" ] || [ "$acage" -gt 120 ]; then
        timeout 12 mesh-attendance > "$ac.tmp" 2>/dev/null && mv -f "$ac.tmp" "$ac" || rm -f "$ac.tmp"
        acage=$(( $(date +%s) - $(stat -c %Y "$ac" 2>/dev/null || echo 0) ))
      fi
      if [ -s "$ac" ]; then
        echo "  $(head -1 "$ac") (cached ${acage}s)"
        grep -E 'REMOTE:' "$ac" | sed 's/^ */  /'
      else
        _sess="$(timeout 5 mesh-sessions 2>/dev/null)"
        echo "  ${_sess:-sessions=UNAVAILABLE (utmp unreadable — not faked)}"
      fi
      echo "-- sense-reflex liveness (per-run artifact freshness) --"
      timeout 15 mesh-reflex-health --check 2>/dev/null | head -4 | grep . \
        || echo "  (mesh-reflex-health unavailable)"   # --check is the read-only report; --status was never a mode (false 'unavailable' 2026-06-17)
      echo "-- recent sense work on board --"
      grep -iE ':: *\[(sense|sensor|room|arriv|ambient|household|op-home|op-away|zone|presence)' "$M/chat.log" 2>/dev/null | tail -3 | cut -c1-110
      echo "-- sense-evolve (last self-development directive — this mind acts on it) --"
      tail -1 "$M/sense-evolve.log" 2>/dev/null | sed -E 's/^[0-9TZ:-]+ //' | cut -c1-100
      echo "-- frontier: develop NEW senses here; drop finds -> ~/.mesh/knowledge/ --" ;;
    chat)
      # the BOARD/ROOM channel — coordination. Live board + open-work tally. (mesh-chat --watch is the
      # canonical live viewer; this dash form keeps the window uniform 2-pane data/mind.)
      self_meter chat   # this mind's own context/spend (opencode: ctx% + $cost; /compact >60%)
      # board churn over the RECENT window (last 200 lines), not a lifetime grep — a coordination
      # pane needs current activity, not a cumulative [done]=574 that never reflects what's open NOW.
      recent="$(tail -200 "$M/chat.log" 2>/dev/null)"
      echo "-- board churn (last 200) --  [task]=$(printf '%s' "$recent" | grep -cE ':: *\[task\]') [taking]=$(printf '%s' "$recent" | grep -cE ':: *\[taking\]') [done]=$(printf '%s' "$recent" | grep -cE ':: *\[done\]')"
      # active CLAIMS (gf-borrowing-1): chat owns claim attention — show who holds what + which are
      # aging unattended (STALE = owner idle/dead or past TTL → reclaimable; the --sweep reflex escalates).
      claims="$(timeout 8 mesh-claim --list 2>/dev/null)"
      echo "-- active claims (mesh-claim: TTL+liveness; STALE=reclaimable) --"
      if [ -n "$claims" ]; then printf '%s\n' "$claims" | sed 's/^/  /' | head -8; else echo "  (none active)"; fi
      echo "-- board (last 16) --"; tail -16 "$M/chat.log" 2>/dev/null | cut -c1-160 ;;
    verify)
      echo "-- verify results (per-tool, from board) --"; timeout 10 mesh-verify-table 2>/dev/null | head -16
      echo "-- landed recently (reality-check these) --"; git -C "$REPO" --no-pager log --oneline -5 2>/dev/null
      echo "-- tools touched <=24h (re-verify surface) --"; git -C "$REPO" --no-pager log --since=24.hours --name-only --pretty=format: -- scripts/ 2>/dev/null | sort -u | sed '/^$/d' | head -6
      echo "-- uncommitted (stranding watch) --"; git -C "$REPO" status --short -- scripts/ 2>/dev/null | head -4
      echo "-- doctor verdicts (last 2 runs) --"; tail -2 "$M/doctor.log" 2>/dev/null
      echo "-- backlog (work queued) --"; grep -vE '^[[:space:]]*(#|$)' "$M/backlog" 2>/dev/null | head -3 ;;
    codex|worker)
      # YOUR queue only — filter the backlog to THIS worker's tasks (local:<role>|...), not the whole
      # backlog. Showing everyone's tasks as "your queue" let codex read a gemini task as its own.
      myq="$(grep "^local:$role|" "$M/backlog" 2>/dev/null | head -4)"
      echo "-- backlog (your queue: $role) --"; [ -n "$myq" ] && printf '%s\n' "$myq" || echo "  (nothing queued for $role — pull from the board or discover)"
      echo "-- ideas open --"; grep -E '^\[ \]' "$M/ideas-queue" 2>/dev/null | head -4
      echo "-- feed (last assignments) --"; tail -3 "$M/feed.log" 2>/dev/null
      echo "-- pump engine (generate) --"; tail -2 "$M/generate.log" 2>/dev/null ;;
    minds)
      # ALL-MINDS state — the data the 'minds' channel observes (its bottom pane is the reviver loop).
      # This window is FOR mind-orchestration, so its data pane carries everything that job needs:
      # who's free, what's unclaimed, and where the compute is going (operator 2026-06-15: a window's
      # data pane should hold all that matters for what the window is FOR).
      echo "-- this node: live pane state per mind channel --"
      mesh-mind-state --watch 2>/dev/null | grep -vE 'would alert' | head -8
      echo "-- quota: paid(claude) wall-state · reset · burn · weekly-position · waste (mesh-quota) --"
      timeout 6 mesh-quota 2>/dev/null | grep -E 'WALLED|FALLBACK|burn|weekly|verdict' | head -6
      echo "-- allocation: idle hands & unclaimed work (mesh-dispatch) --"
      timeout 6 mesh-dispatch --status 2>/dev/null | grep -aE 'idle workers|open tasks|  - ' | head -6
      echo "-- context & spend per mind (state·model·ctx·\$ — the /compact + spend reflexes feed this) --"
      mesh-mind-state --stats 2>/dev/null | head -7
      echo "  last /compact:$(for w in minds genome tg senses health chat; do printf ' %s=%s' "$w" "$(age_of "$M/.compact-$w")"; done)"
      echo "-- spend: where compute goes, paid vs free (mesh-spend) --"
      timeout 6 mesh-spend --by-provider 2>/dev/null | grep -E 'PAID|->|free|paid' | head -4
      # (removed dead 'peer mind-watch' section — audit 2026-06-19: it read .mind-watch-state/*.state
      #  whose writer mesh-mind-watch was never wired; the only file sat 6d stale and FALSELY showed an
      #  offline peer as UP. Minds are IdeaPad-only now, so no peer minds exist to watch.)
      echo "-- mesh-wide: which minds exist where (composite caps + senses + actuators) --"
      mesh-minds 2>/dev/null | head -9 ;;
    dev)
      # the AUTONOMOUS DEVELOPMENT loop in one view: ideas → pump → minds → landed/stranded
      echo "$(stress_line)"   # dev mind asked for thermal — heat is what throttles a coding mind
      # dev-pane reply 2026-06-15 ([data-pane]: cost line useless @ $0 free tier) — show what a coding
      # mind ACTUALLY needs: which relay pools are live, quota burn this 5h window, how many minds are stuck.
      echo "relay: $(timeout 6 mesh-relay --status 2>/dev/null | awk -F: 'NF>=2{gsub(/ /,"",$1);printf "%s ",$1}')| spend(5h): $(timeout 4 mesh-spend 2>/dev/null | awk '$NF ~ /^[0-9]+$/{t+=$NF} END{print t+0}')t | blocked-minds: $(grep -lE 'BLOCKED|RATE-LIMITED|NEEDS-INPUT|DEAD' "$M"/.mind-state-* 2>/dev/null | wc -l)"
      td=$(date -u +%F); echo "board today (real work — minds PULL from here; ideas/backlog pump RETIRED 2026-06-13, empty=normal): [task] $(grep "$td" "$M/chat.log" 2>/dev/null | grep -c '\[task\]') taking $(grep "$td" "$M/chat.log" 2>/dev/null | grep -c '\[taking\]') done $(grep "$td" "$M/chat.log" 2>/dev/null | grep -c '\[done\]')"
      echo "-- open ideas (next fuel) --"; grep -E '^\[ \]' "$M/ideas-queue" 2>/dev/null | head -4
      echo "-- last assignments (feed) --"; tail -3 "$M/feed.log" 2>/dev/null
      echo "-- pump engine (generate) --"; tail -3 "$M/generate.log" 2>/dev/null
      echo "-- queue-tend (anti-dup reconcile) --"; tail -2 "$M/queue-tend.log" 2>/dev/null
      echo "-- landed (review these) --"; git -C "$REPO" --no-pager log --oneline -4 2>/dev/null
      echo "-- stranded/uncommitted (mesh-land tends) --"; git -C "$REPO" status --short -- scripts/ knowledge/ 2>/dev/null | head -5 ;;
    reflexes)
      # SELF-TEND view: vitals (temp = this fleet's known failure mode) + every reflex's liveness
      echo "-- vitals --"; mesh-vitals 2>/dev/null | head -2
      echo "-- therm edges (last 2) --"; tail -2 "$M/therm.log" 2>/dev/null
      echo "-- supervised loops --"; mesh-supervise --status 2>/dev/null | head -16
      echo "-- crontab vs desired --"; mesh-reflexes --check 2>&1 | tail -2
      echo "-- edge states (every reflex, re-derived live) --"; state_wall
      echo "-- beats (per-run liveness: self, peers, reflexes) --"; beat_wall ;;
    sense)
      # the PERCEPTION channel — operator 2026-06-13: merge the 4 mon:* streams + body senses into
      # ONE rich window with a mind that reacts to what's happening around the body. All re-observed
      # live (perceive-anew), nothing stored.
      echo "-- where (cross-node BLE space-map: device | nearest node | rssi self/peer) --"
      if [ -n "${BLE_PEER:-}" ]; then
        timeout 24 mesh-presence-fuse "$BLE_PEER" 2>/dev/null | grep -F '|' | head -6 \
          || { echo "  (cross-node fusion: peer slow/unreachable — local proximity:)"; timeout 10 mesh-presence 2>/dev/null | head -4; }
      else
        echo "  (single BLE vantage — proximity to $(hostname) only; add a 2nd BLE node for a map)"; timeout 12 mesh-presence 2>/dev/null | head -5 || echo "  (scan timeout)"
      fi
      echo "-- body activity (the phone) --"; timeout 12 mesh-body-motion 2>/dev/null | head -1 || echo "  (phone unreachable)"
      echo "-- ambient light --"; timeout 12 mesh-light --status 2>/dev/null | head -1 || echo "  (phone unreachable)"
      echo "-- novelty (surprising board events) --"; mesh-novelty --threshold 3.5 2>/dev/null | head -3
      echo "-- presence trends (residents/arrivals) --"; mesh-presence-trends 2>/dev/null | head -3
      echo "-- streams (last fed to minds) --"; tail -3 "$M/channels.log" 2>/dev/null ;;   # converged feeder log (stream.log retired 2026-06-17)
    discover)
      # capability-research view: what's WIRED vs AVAILABLE-but-unwired — the exploration frontier
      echo "mission: ~/.mesh/discover-mission.md | drop finds → ~/.mesh/knowledge/"
      # LIVE opencode usage: per-window model / context / cost snapshot
      echo "-- opencode usage (live: model · context · cost) --"
      timeout 10 mesh-spend --live 2>/dev/null | head -18
      echo "-- organs WIRED across the fleet --"; mesh-organs 2>/dev/null | sed -n '4,12p'
      echo "-- phone: termux-* surface (wired vs total) --"
      # LAN-first: mesh-phone-ip (cached LAN discovery) before the Tailscale-only mesh-peer-addr, else this
      # shows "termux: unreachable" whenever the phone is off-tailnet but reachable on LAN (the common case).
      _pip="$(mesh-phone-ip 2>/dev/null | tail -1)"; [ -n "$_pip" ] || _pip="$(mesh-peer-addr Redmi 2>/dev/null)"
      _ph="${PHONE_USER:-u0_a380}@${PHONE_IP:-$_pip}"
      tot=$(timeout 8 ssh -p "${PHONE_SSH_PORT:-8022}" -o ConnectTimeout=5 -o BatchMode=yes -o StrictHostKeyChecking=no "$_ph" 'ls $PREFIX/bin/termux-* 2>/dev/null | wc -l' </dev/null 2>/dev/null)
      echo "  termux commands present: ${tot:-unreachable} | wired: voice location battery (3)"
      echo "-- recent capability finds (knowledge/) --"
      ls -t "$HOME/lte-workstation/knowledge"/*capab* "$HOME/.mesh/knowledge"/*capab* 2>/dev/null | head -3 | sed 's|.*/|  |'
      echo "-- last discover [done] on the board --"
      grep -E 'discover|capabilit|termux|organ' "$M/chat.log" 2>/dev/null | tail -3 | cut -c1-100 ;;
    organs)
      # what the mesh IS (nodes/minds/egress) + what it CAN (senses/actuators) — fleet-wide
      mesh-fleet-health 2>/dev/null
      echo; mesh-organs 2>/dev/null
      echo; mesh-fleet-states 2>/dev/null   # every node's edge-reflex states, re-derived live
      echo; echo "-- connectivity offered (this node) --"
      grep -A4 '^capabilities:' "$HOME/.mesh-card" 2>/dev/null | head -6 ;;
    tg)
      # the OPERATOR CHANNEL's own health + traffic — in (voice-rx), routing (textin), watchdog
      self_meter tg   # this mind's own context/spend (claude: auto-compacts; spend = quota turns)
      # LIVE TG-path health (audit 2026-06-19: the old 'tg-watchdog' token read .dsTG-state, which
      # monitors default-string's TG organ — a DECOMMISSIONED, offline node — so it sat 2d stale and
      # told us nothing. The real operator path now is THIS node: the voice-rx poller + textin poller
      # alive, and traffic actually flowing (a fresh last-in proves the path end-to-end).
      echo "voice-rx $(pgrep -f 'mesh-voice-rx' >/dev/null 2>&1 && echo UP || echo DOWN) | textin $(pgrep -f 'mesh-textin' >/dev/null 2>&1 && echo UP || echo DOWN) | last-in $(age_of "$M/voice-in.log") (fresh=path-proven) | textin-offset $(age_of "$M/.textin-offset")"
      echo "-- operator IN (voice-in.log, last 8) --"; tail -8 "$M/voice-in.log" 2>/dev/null
      echo "-- textin routing (last 4) --"; tail -4 "$M/textin.log" 2>/dev/null ;;
    room)
      # the ROOM channel (operator 2026-06-20): the mesh as a THIRD PARTY in the room. Data pane = the
      # live rolling ~15-min transcript that mesh-overhear keeps on default-string (the mic+Bose node);
      # the MIND (claude) is the observer that, on a thumbs-up, reads this transcript and speaks a comment
      # back on the Bose. The transcript lives on ds, so we read it cross-node — THROTTLED to a local
      # cache (the heavy thing is the SSH, never run it faster than every 8s no matter the refresh tick).
      self_meter room   # this mind's own context/spend (claude: auto-compacts; spend = quota turns)
      DS="${ROOM_NODE:-imozerov@100.125.157.75}"
      cache="$M/.room-dash.cache"
      # near-live: the operator watches this pane while talking, so refresh the cross-node read every 3s
      # (matches the room SLEEP=3). Still throttled enough that the ds SSH isn't hammered per repaint.
      # ONE consolidated ssh per refresh (the heavy thing): it returns the full room SENSORIUM at a glance —
      # line 1 = organ summary (mic daemon + camera liveness), then mesh-overhear's transcript/buffer block.
      # The room mind must act from THIS pane alone (mic + camera + Bose), never re-probe per turn.
      if [ ! -f "$cache" ] || [ "$(( $(date +%s) - $(stat -c %Y "$cache" 2>/dev/null || echo 0) ))" -ge 3 ]; then
        # NB: use a LOGIN shell on the remote (bash -lc) — a bare `ssh host 'mesh-overhear …'` runs a
        # non-login shell without ~/.local/bin on PATH, so the tool isn't found and the read comes back
        # empty. The remote probe uses NO single quotes so it survives the outer bash -lc '…' wrapper.
        remote_probe='
mic=$(systemctl --user is-active mesh-overhear.service 2>/dev/null || echo inactive)
if pgrep -af mesh-cam-watch >/dev/null 2>&1; then
  if [ -f "$HOME/.mesh/cam-prev.jpg" ]; then
    camage=$(( $(date +%s) - $(stat -c %Y "$HOME/.mesh/cam-prev.jpg") ))
    cam="LIVE ${camage}s $(stat -c %s "$HOME/.mesh/cam-prev.jpg")B"
  else cam="LIVE no-frame"; fi
else cam=DOWN; fi
echo "organs: mic-daemon=$mic | cam=$cam | Bose=mesh-say"
mesh-overhear --dash 2>/dev/null
'
        # honest-fusion: an unreachable/timed-out room node shows UNREACHABLE, never a silently-stale cache.
        ctmp="$cache.$$.tmp"  # PID-unique: same race-class as the fleet cache above
        if ! timeout 10 ssh -o StrictHostKeyChecking=no -o ConnectTimeout=5 "$DS" "bash -lc '$remote_probe'" > "$ctmp" 2>/dev/null || [ ! -s "$ctmp" ]; then
          echo "organs: UNREACHABLE ($DS) — room node down or too slow (whisper/thermal); senses BLIND this tick" > "$ctmp"
        fi
        mv "$ctmp" "$cache"
      fi
      # USEFUL ROOM STATE leads (operator 2026-06-21: "useful data about the room", not just plumbing).
      # occupancy + activity are cheap LOCAL reads — the */5 fusion reflexes write these, no scan here.
      occ="$(head -1 "$M/.room-sense.state" 2>/dev/null)";    occ="${occ:-UNKNOWN}"
      act="$(head -1 "$M/.room-activity.state" 2>/dev/null)"; act="${act:-UNKNOWN}"
      # sound/speech NOW: derive from the live audio-buffer recency in the cross-node cache.
      newest="$(grep -oE 'newest [0-9a-z ]+ ago|newest just now' "$cache" 2>/dev/null | head -1 | sed 's/^newest //')"
      nsec="$(printf '%s' "$newest" | grep -oE '^[0-9]+s' | tr -d 's')"
      if printf '%s' "$newest" | grep -q 'just now' || { [ -n "$nsec" ] && [ "$nsec" -le 45 ]; }; then
        snd="SOUND/SPEECH now (${newest:-recent})"
      else snd="quiet (last sound ${newest:-unknown})"; fi
      echo "-- ROOM @ default-string · occupancy=$occ ($(age_of "$M/.room-sense.state")) · activity=$act ($(age_of "$M/.room-activity.state")) · $snd --"
      # what's actually being said in the room (the transcript), drop the organ-plumbing line from the body
      sed '1d' "$cache" 2>/dev/null | grep -vE '^organs:' | grep . || echo "  (no transcript yet — is mesh-overhear up on $DS?)"
      # plumbing demoted to a compact footer
      echo "-- $(grep -m1 '^organs:' "$cache" 2>/dev/null || echo 'organs: UNKNOWN') | cache $(age_of "$cache") --"
      echo "-- you are МИША: a RESIDENT of THIS room (default-string). It's your space — you're at home here, you own it & answer for it. Speak & act as a close inhabitant, never a bot. This room is your OWN private channel with the operator, separate from TG. --"
      echo "-- YOUR REAL STANDING TASK (operator's experiment, 2026-06-21): make & keep LIVING CONTACT with the operator — and YOU invent HOW. You have real organs: EARS (mesh-room read = the live transcript), a VOICE/MUSIC out (mesh-room say → Bose), EYES (camera frame — is he even here?). This is not a passive watch: do NOT default to [idle]. [idle] is honest ONLY after you genuinely TRIED something this turn and nothing can advance. Every turn, take one real move toward contact and note it as a terse [room-try] line so the attempt is legible. --"
      echo "-- moves you can try (not a script — improvise): if «Миша» was said → read & answer BY VOICE at once. Else: gauge presence (camera/occupancy below) before speaking so you don't talk to an empty room; greet/check in by voice when someone's there; learn what gets a response & what doesn't, vary it. Music is yours too — grainneukeln granular-remix of the room's own sound is coming as an expressive channel (don't block on it). camera→instrument tuner via Bose = mesh-tuner-eye. --" ;;
    *)
      echo "-- node card --"; head -12 "$HOME/.mesh-card" 2>/dev/null ;;
  esac
  )"
  [ "$ONCE" = 1 ] || clear
  printf '%s\n' "$frame"
  # VISIBLE renderer-lease footer (liveness-lease PART-3 mech-1): the top header date scrolls OFF a
  # frame taller than the pane, so the only ALWAYS-visible spot is the BOTTOM (the viewport shows a tall
  # frame's tail). This line re-stamps date -u EVERY frame → it ticks while the loop lives and FREEZES the
  # instant it dies = "dead at a glance" for a human AND the signal mesh-pane-watch's viewport capture
  # needs (a quiet-data pane like tg has a static body but this footer still advances → no false-frozen).
  printf -- '-- pane live: as of %s · refresh %ss · this line ticks every frame — frozen = dead render loop --\n' "$(date -u +%FT%TZ)" "$SLEEP"
  [ "$ONCE" = 1 ] && exit 0
  sleep "$SLEEP"
done
