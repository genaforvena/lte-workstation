      else
        # the resolver failing is NOT "no models" — say which claim is missing
        echo "  UNKNOWN — mesh-model-resolve did not run (the LIVE column is blind, not empty)"
      fi
      echo
      _ledn=$(grep -c . "$M/model-bench.log" 2>/dev/null); _ledn=${_ledn:-0}
      _modn=$(cut -f4,5 "$M/model-bench.log" 2>/dev/null | sort -u | grep -c . 2>/dev/null); _modn=${_modn:-0}
      echo "MEASURED (${_modn} models · ${_ledn} ledger rows, latest bench each):"
      echo "  WER lower=better, ranked within each fixture; DEAF/UNPARSED/EMPTY disqualified, sink below honest reads."
      if [ -s "$M/model-bench.log" ]; then
        # RANK HERE, NOT IN THE LEDGER. The ledger holds facts (wall, wer); the verdict is a
        # view over the corpus and must recompute as it grows — a verdict frozen at write
        # time labels whatever was benched first against an empty corpus, forever.
        #
        # RELATIVE, NEVER AN ASSUMED RANGE. An absolute `ok < 0.15` WER would label the best
        # STT organ we have "poor". Rank within a fixture; absolutes are not comparable across
        # references. GROUP by fixture (wake/stt/tts) and show ONE row per model — its LATEST
        # bench (the ledger is append-only, so later NR wins). Six gigaam re-benches (incl. the
        # broken-timer warm 0.59/0.61) as six rows sorted by a global wall time interleaved
        # three unrelated fixtures and buried the per-fixture ranking the pane exists to show.
        awk -F'\t' '
          function cls(fx){ if(fx~/wake/)return "wake"; if(fx~/stt/)return "stt"; if(fx~/tts/)return "tts"; if(fx~/coverage/)return "coverage"; return fx }
          function ord(fx){ c=cls(fx); if(c=="wake")return 0; if(c=="stt")return 1; if(c=="tts")return 2; if(c=="coverage")return 3; return 4 }
          { n=split($0,f,"\t"); if(n<9)next; latest[f[4] SUBSEP f[5]]=NR; L[NR]=$0 }
          END{
            # bar = min WER among the SHOWN (latest, read-ok) rows of each fixture. Only honest
            # reads set it — a DEAF/UNPARSED/EMPTY row entering best crowns a dead organ.
            for(k in latest){ split(L[latest[k]],f,"\t"); if(f[9]=="read-ok"){ if(!(f[5] in best)||f[8]+0<best[f[5]]) best[f[5]]=f[8]+0 } }
            for(k in latest){
              split(L[latest[k]],f,"\t")
              wer=f[8]+0; b=(f[5] in best)?best[f[5]]:""; dq=(f[9]=="read-ok")?0:1
              if(f[9]=="EMPTY")          r="EMPTY"
              else if(f[9]=="DEAF")      r="DEAF"
              else if(f[9]=="UNPARSED")  r="UNPARSED"
              else if(f[9]!="read-ok")   r=f[9]
              else if(b=="")             r="?"
              else if(wer<=b)            r="BEST"
              # DEGENERATE BEST: a fixture whose best round-trip is ~0 is the TTS FLOOR-GATE
              # signature (clean TTS reads back through gigaam at 0.000). The relative ">2x best"
              # rule divides by ~0 and calls any epsilon UNUSABLE (it mislabelled a working
              # piper-dmitri, WER 0.034, as broken). A floor gate is broken-vs-working BINARY, not
              # a quality rank, so an ABSOLUTE 0.15 threshold is correct HERE and only here — fires
              # only when best<=0.001, so STT fixtures (best>=0.25) are untouched.
              else if(b<=0.001)          r=(wer<=0.15)?"floor ok":"FLOOR FAIL"
              else if(wer>2*b)           r="UNUSABLE"
              else                       r=sprintf("%.1fx",wer/b)
              # emit: sort keys (fixture-class order, honest-before-disqualified, WER asc) then display cols
              printf "%d\t%d\t%.4f\t%s\t%s\t%s\t%s\t%s\t%s\n", ord(f[5]),dq,wer,cls(f[5]),f[5],f[4],f[8],f[6],r
            }
          }' "$M/model-bench.log" 2>/dev/null \
          | sort -t"$(printf '\t')" -k1,1n -k2,2n -k3,3n \
          | { _pf=""; while IFS="$(printf '\t')" read -r _o _dq _w _cls _fx _model _werstr _wall _rank; do
                [ "$_fx" != "$_pf" ] && { printf "\n  %s · %s\n" "$_cls" "$_fx"; _pf="$_fx"; }
                printf "    %-28s %6s  %-12s %6ss\n" "$_model" "$_werstr" "$_rank" "$_wall"
              done; }
      else
        echo "  UNMEASURED — no bench has run. The shelf is unproven, not fast."
      fi
      echo
      # THE BACKLOG: how much of the shelf has never been measured. This number is the
      # lane's work, and it should be uncomfortable to look at.
      # `grep -c . || echo 0` is a TRAP: grep -c prints 0 AND exits 1 on no match, so the
      # fallback appends a SECOND zero and $(( )) dies on "0\n0". Count with grep -c alone
      # (its rc is not an error here — zero rows is a real answer, and the number it prints
      # is already correct).
      _shelf=$(ollama list 2>/dev/null | tail -n +2 | grep -c . 2>/dev/null); _shelf=${_shelf:-0}
      _benched=$(cut -f4 "$M/model-bench.log" 2>/dev/null | sort -u | grep -c . 2>/dev/null); _benched=${_benched:-0}
      echo "SHELF: ${_shelf} ollama models pulled · ${_benched} ever benched · $(( _shelf > _benched ? _shelf - _benched : 0 )) UNMEASURED"
      # WAKE-GATE FINE-TUNE lane (the OPEN specialization job — memory: wake-gate-finetune-plan;
      # board [task] wake-gate-finetune, owner: models = me). The wake/address gate runs PROMPTED
       # gemma4/qwen and has re-opened as a bug 4x (parser-fragility); the original plan was to
       # distill it into a tiny classifier. NOTE: the embedding-classifier hypothesis was PROVEN
       # DEAD 2026-07-22 — resemblyzer (voice) + Nemotron-3-Embed (text) both NO-SEPARATION on
       # aligned room blocks (wake is addressee SEMANTICS, not acoustic/speaker-level, so vecs
       # structurally can't split it). The live generative gate is the correct architecture; a
       # LoRA-1.5b is the only remaining distillation path and needs a fat REACT corpus first.
       # This line is the pickup surface for a post-clear models mind: how much LABELED corpus
       # has piled up (react/silent verdicts on real room blocks — SILENT-empty is NOT a label,
       # excluded) and whether a classifier is trained+benched yet.
      _wgc=$(grep -cE ' (REACT|SILENT) ' "$M/room-ambient-gate.log" 2>/dev/null); _wgc=${_wgc:-0}
      if [ -f "$M/wake-clf.pkl" ]; then _wgs="classifier TRAINED $(age_of "$M/wake-clf.pkl") — bench vs prompted-gemma4 on wakegate-ru, autoselect owns the switch"
      else _wgs="embed DEAD (resemblyzer+Nemotron no-separation, logged ledger) — wake=addressee SEMANTICS not acoustic, so vecs structurally can't split; live gemma4 gate (WER 0.312, --think=false) IS the right arch; LoRA-1.5b only once REACT corpus fattens"; fi
      echo "WAKE-GATE FINE-TUNE: ${_wgc} labeled blocks in corpus · ${_wgs}"
      # board lines run to paragraphs; a pane needs the HANDLE, not the essay — cut hard.
      echo "-- open model work (board, first 110c) --"
      grep -hE '\[(task|verify)\].*(model|stt|tts|vision|gigaam|whisper|piper|moondream)' \
        "$M/chat.log" 2>/dev/null | tail -4 | cut -c1-110 || true ;;
    organs)
      # what the mesh IS (nodes/minds/egress) + what it CAN (senses/actuators) — fleet-wide
      mesh-fleet-health 2>/dev/null
      echo; mesh-organs 2>/dev/null
      echo; mesh-fleet-states 2>/dev/null   # every node's edge-reflex states, re-derived live
      echo; echo "-- connectivity offered (this node) --"
      grep -A4 '^capabilities:' "$HOME/.mesh-card" 2>/dev/null | head -6 ;;
    tg)
      # the OPERATOR CHANNEL's own health + traffic — in (voice-rx), routing (textin), watchdog
      self_meter tg   # this mind's own context/spend (claude: auto-compacts; spend = quota turns)
      # LIVE TG-path health (audit 2026-06-19: the old 'tg-watchdog' token read .dsTG-state, which
      # monitors default-string's TG organ — a DECOMMISSIONED, offline node — so it sat 2d stale and
      # told us nothing. The real operator path now is THIS node: the voice-rx poller + textin poller
      # alive, and traffic actually flowing (a fresh last-in proves the path end-to-end).
      echo "voice-rx $(pgrep -f 'mesh-voice-rx' >/dev/null 2>&1 && echo UP || echo DOWN) | textin $(pgrep -f 'mesh-textin' >/dev/null 2>&1 && echo UP || echo DOWN) | last-in $(age_of "$M/voice-in.log") (fresh=path-proven) | textin-offset $(age_of "$M/.textin-offset")"
      echo "-- operator IN (voice-in.log, last 8) --"; tail -8 "$M/voice-in.log" 2>/dev/null
      echo "-- textin routing (last 4) --"; tail -4 "$M/textin.log" 2>/dev/null ;;
    room)
      # the ROOM channel (operator 2026-06-20): the mesh as a THIRD PARTY in the room. Data pane = the
      # live rolling ~15-min transcript that mesh-overhear keeps on default-string (the mic+Bose node);
      # the MIND (claude) is the observer that, on a thumbs-up, reads this transcript and speaks a comment
      # back on the Bose. The transcript lives on ds, so we read it cross-node — THROTTLED to a local
      # cache (the heavy thing is the SSH, never run it faster than every 8s no matter the refresh tick).
      self_meter room   # this mind's own context/spend (claude: auto-compacts; spend = quota turns)
      DS="${ROOM_NODE:-imozerov@100.125.157.75}"
      cache="$M/.room-dash.cache"
      # SELF-HOP GUARD (2026-07-04, chat-review — operator flagged the room pane as permanently stale):
      # this dash loop usually runs ON the room node itself (ds hosts its own room window), so sshing to
      # ROOM_NODE means ds sshing to ITSELF — denied, no loopback key (same footgun mesh-room already
      # guards against for `say`/`read`). That made organs read "UNREACHABLE ... senses BLIND" on EVERY
      # tick forever, even though mesh-overhear/mesh-cam-watch are alive right here — a hollow pane that
      # never showed the real transcript. Detect "ROOM_NODE is me" and probe locally instead of over ssh.
      _rd_host="${DS#*@}"; ROOM_LOCAL=0
      if [ "$_rd_host" = localhost ] || [ "$_rd_host" = 127.0.0.1 ]; then ROOM_LOCAL=1
      else
        for _rd_ip in $(tailscale ip -4 2>/dev/null) $(hostname -I 2>/dev/null); do
          [ "$_rd_ip" = "$_rd_host" ] && { ROOM_LOCAL=1; break; }
        done
      fi
      # near-live: the operator watches this pane while talking, so refresh the cross-node read every 3s
      # (matches the room SLEEP=3). Still throttled enough that the ds SSH isn't hammered per repaint.
      # ONE consolidated ssh per refresh (the heavy thing): it returns the full room SENSORIUM at a glance —
      # line 1 = organ summary (mic daemon + camera liveness), then mesh-overhear's transcript/buffer block.
      # The room mind must act from THIS pane alone (mic + camera + Bose), never re-probe per turn.
      if [ ! -f "$cache" ] || [ "$(( $(date +%s) - $(stat -c %Y "$cache" 2>/dev/null || echo 0) ))" -ge 3 ]; then
        # NB: use a LOGIN shell on the remote (bash -lc) — a bare `ssh host 'mesh-overhear …'` runs a
        # non-login shell without ~/.local/bin on PATH, so the tool isn't found and the read comes back
        # empty. The remote probe uses NO single quotes so it survives the outer bash -lc '…' wrapper.
        # THE PROBE TEXT IS A CMDLINE — and that is a correctness constraint, not a style note
        # (2026-07-15, board/room-ear-watcher-up-is-a-pgrep-self-match). This string is shipped as
        # `ssh host "bash -lc '<probe text>'"`, so EVERY byte below — code and comments alike —
        # lands in the remote shell cmdline, where `pgrep -f` can see it. A bare `pgrep -f <name>`
        # in here therefore matches the probe shell ITSELF and reports a CONSTANT up: that is how
        # `ear: watcher UP` survived 15h with its watcher running nowhere, and the cam gate had the
        # same hole (verified live: no unit, no process, still reported up). Two rules follow:
        #   1. pattern-match a process ONLY via a split pattern (`mesh-cam[-]watch`), or better, ask
        #      systemd (`is-active`), which answers about the UNIT instead of matching text.
        #   2. NEVER write the unbracketed name in this string — including in a comment. A split
        #      pattern is defeated by prose mentioning the literal, because the pattern-as-matched
        #      then finds the comment in our own cmdline. The explanation lives HERE, outside.
        # --test drives this probe through `bash -lc` exactly as the ssh above does, so a regression
        # to a self-matching form fails the gate instead of painting a confident lie.
        remote_probe='
mic=$(systemctl --user is-active mesh-overhear.service 2>/dev/null || echo inactive)
# split pattern — load-bearing, see the note above remote_probe. Do NOT write the unbracketed name
# anywhere in this probe (comments included): every byte here becomes the remote cmdline.
if pgrep -af "mesh-cam[-]watch" >/dev/null 2>&1; then
  if [ -f "$HOME/.mesh/cam-prev.jpg" ]; then
    camage=$(( $(date +%s) - $(stat -c %Y "$HOME/.mesh/cam-prev.jpg") ))
    # LIVE only when the frame is actually fresh — a running watcher with a frozen frame is a
    # hollow sense (2026-07-02: /dev/video0 vanished at a reboot, dash said LIVE for 14h).
    # Ages bucketed (<1h / Nh) and size in KB: raw seconds/bytes churned every 3s repaint and
    # false-woke the consume loop (the diff-gate sees a change, the room has none).
    if [ "$camage" -lt 3600 ]; then camf="<1h"; else camf="$(( camage / 3600 ))h"; fi
    if ! ls /dev/video* >/dev/null 2>&1; then cam="NO-DEVICE (frame $camf old)"
    elif [ "$camage" -gt 300 ]; then cam="STALE $camf (watcher up, frame frozen)"
    else cam="LIVE $(( $(stat -c %s "$HOME/.mesh/cam-prev.jpg") / 1024 ))K"; fi
  else cam="watcher up, no frame yet"; fi
else cam=DOWN; fi
# VOICE half of the organ line (chat-review/room-dash-voice-field-is-a-literal): DERIVED from the
# self-verify ledger, never a constant — the old literal read healthy for a full day of amp-dead
# Bose while the machine-readable verdict sat in this very log, and two fresh-session room minds
# re-proved the death by hand (RMS loopback 01:39 + 05:35). Verdict alphabet is the writer own set
# (OK|SILENT|MISMATCH|DROWNED|MUTED, tab field 2); 3 consecutive SILENT = the speak path is dead —
# say so and name the fallback organ. Age bucketed like cam (<1h / Nh) to keep the repaint diff-quiet.
voice=unverified
svlog="$HOME/.mesh/misha-say-verify.log"
if [ -s "$svlog" ]; then
  vt=$(tail -3 "$svlog" 2>/dev/null | cut -f2)
  vlast=$(printf "%s\n" "$vt" | tail -1)
  vsil=$(printf "%s\n" "$vt" | grep -c "^SILENT$")
  vage=$(( $(date +%s) - $(stat -c %Y "$svlog" 2>/dev/null || echo 0) ))
  if [ "$vage" -lt 3600 ]; then vagef="<1h"; else vagef="$(( vage / 3600 ))h"; fi
  if [ "$vsil" -ge 3 ]; then voice="VOICE-DEAD (fallback note3, verified $vagef ago)"
  else voice="$vlast (verified $vagef ago)"; fi
fi
echo "organs: mic-daemon=$mic | cam=$cam | Bose=$voice"
# EAR: the room hearing chain (operator 2026-07-04 "make sure to fix your top pane" — the pane must
# show whether Misha can HEAR his name right now). Bucketed states, no numbers → no diff churn.
# The chain: mesh-overhear (mic buffer) -> gigaam (STT -> transcript) -> reflex (name -> poke).
# Gated on systemd (answers about the UNIT), never on pattern-matching our own cmdline — see the
# note above remote_probe for why the old wake-word gate here could only ever report up.
# NB: is-active PRINTS its verdict AND exits non-zero for a dead unit, so `$(... || echo inactive)`
# yields TWO lines (inactive\ninactive) and tears the row across two lines on the pane. Take the
# printed word, and only substitute when it printed nothing at all (no such unit).
stt="$(systemctl --user is-active mesh-room-gigaam.service 2>/dev/null | head -1)"; [ -n "$stt" ] || stt=absent
rfx=DOWN; systemctl --user is-active mesh-room-reflex.service >/dev/null 2>&1 && rfx=UP
trs="$HOME/.mesh/room-transcript.txt"
# Transcript MTIME is liveness, CONTENT is speech: gigaam rewrites (prunes) the file every cycle even
# in a silent room, so fresh mtime + empty file = a healthy ear with nothing to hear. A frozen mtime
# means the loop stopped cycling whatever systemd claims about the unit — both must agree.
if [ "$stt" != active ]; then ear="DEAF (transcriber down)"
elif [ "$rfx" = DOWN ]; then ear="HALF-DEAF (hearing, but no wake reflex to answer)"
elif [ ! -f "$trs" ]; then ear="no transcript yet"
else
  ta=$(( $(date +%s) - $(stat -c %Y "$trs" 2>/dev/null || echo 0) ))
  if [ "$ta" -le 90 ]; then ear="hearing (live)"
  elif [ "$ta" -le 300 ]; then ear="lagging"
  else ear="STALLED (transcriber not cycling)"; fi
fi
# Last NAME wake: the wake-confirmed marker is the only name-ONLY artifact of the live path (the reflex
# lastpoke also stamps ambient look-ins, so it would overstate). mtime = when a by-name call last armed
# the bypass. Reads never until a real call lands — honest, and now actually reachable: the marker was
# minted ONLY by the dead watcher, so mesh-room read a predicate that had never once been true.
lw=never; wl="$HOME/.mesh/.room-wake-confirmed"
if [ -f "$wl" ]; then
  la=$(( $(date +%s) - $(stat -c %Y "$wl" 2>/dev/null || echo 0) ))
  if [ "$la" -le 120 ]; then lw="just now"; elif [ "$la" -le 3600 ]; then lw="recent"; else lw="old"; fi
fi
echo "ear: stt=$stt · wake-reflex=$rfx · $ear · last name-wake: $lw"
# AMBIENT proactive-gate lane (operator 2026-07-17 "wire the ambient gate with gemma4"): the reflex
# gates UNADDRESSED room chatter through mesh-room-address --ambient (fail CLOSED, gemma4:e2b) before
# spending a paid look-in, and logs every REACT/SILENT/ERROR here. Two reasons this belongs on the pane:
#   1. a SILENT-swallow is the canonical fail-closed trap — flat/absent counts here mean the gate is
#      NOT firing (dead ollama, stalled reflex), not a quiet room; err>0 names a broken gate loudly.
#   2. this log IS the labeled corpus for the WAKE-GATE FINE-TUNE lane (a distilled tiny classifier to
#      replace the prompted gemma4 — see memory wake-gate-finetune-plan / board owner: models). The
#      react/silent balance a future context reads here is the training signal it picks up from.
# Bucketed age, no raw timestamps → repaint stays diff-quiet. No apostrophes (remote_probe constraint).
agl="$HOME/.mesh/room-ambient-gate.log"
if [ -s "$agl" ]; then
  arx=$(grep -c " REACT " "$agl"); asl=$(grep -c " SILENT" "$agl"); aer=$(grep -c " ERROR" "$agl")
  alast=$(tail -1 "$agl" | awk "{print \$2}")
  aage=$(( $(date +%s) - $(stat -c %Y "$agl" 2>/dev/null || echo 0) ))
  if [ "$aage" -lt 3600 ]; then aagef="<1h"; else aagef="$(( aage / 3600 ))h"; fi
  ahint=""; [ "$aer" -gt 0 ] && ahint=" -- ERRORS: gate broken (see the log), not a quiet room"
  echo "ambient-gate: gemma4 · react=$arx silent=$asl err=$aer · last=$alast ($aagef ago) · [fine-tune corpus]$ahint"
else
  echo "ambient-gate: gemma4 · no look-ins gated yet (silent room, or reflex just restarted) · [fine-tune corpus empty]"
fi
# VOICE SELF-VERIFY (operator 2026-07-04 chat-review): surface whether the ROOM MIND own speech actually
# reached the mic, not just that pwplay returned. Bucketed counts over the last 5 attempts (no raw scores/
# timestamps to avoid diff-churn false-wake); the pane is the only window onto this for the room mind.
# NB: remote_probe is a single-quoted bash string end to end (see the ssh wrapper below) — no apostrophes
# or literal single-quote chars anywhere in this block, or the string terminates early.
svlog="$HOME/.mesh/misha-say-verify.log"
if [ -s "$svlog" ]; then
  last5=$(tail -5 "$svlog" 2>/dev/null)
  verdicts=$(printf "%s\n" "$last5" | cut -f2)
  lastv=$(printf "%s\n" "$verdicts" | tail -1)
  ok=$(printf "%s\n" "$verdicts" | grep -c "^OK$")
  bad=$(printf "%s\n" "$verdicts" | grep -cE "^(SILENT|MISMATCH)$")
  # DROWNED = the audit recording was full of ROOM sound (music masking the TTS) — unverifiable,
  # neither ok nor path-suspect (2026-07-05: 5 straight music-drowned runs read as a dead Bose here)
  drn=$(printf "%s\n" "$verdicts" | grep -c "^DROWNED$")
  if [ "$bad" -ge 3 ]; then hint=" -- mic/Bose path suspect, check the log"
  elif [ "$drn" -ge 3 ]; then hint=" -- room too loud to verify (not a path verdict)"; else hint=""; fi
  echo "voice: last=$lastv ($ok/5 verified ok, $bad/5 silent/mismatch, $drn/5 drowned)$hint"
else
  echo "voice: no self-verify attempts logged yet"
fi
mesh-overhear --dash 2>/dev/null
'
        # honest-fusion: an unreachable/timed-out room node shows UNREACHABLE, never a silently-stale cache.
        ctmp="$cache.$$.tmp"  # PID-unique: same race-class as the fleet cache above
        if [ "$ROOM_LOCAL" = 1 ]; then
          # run right here — no ssh, no self-hop denial. Still timeout-guarded against a wedged whisper.
          if ! timeout 10 bash -c "$remote_probe" > "$ctmp" 2>/dev/null || [ ! -s "$ctmp" ]; then
            echo "organs: LOCAL PROBE FAILED on $(hostname) — mesh-overhear/mesh-cam-watch errored or timed out" > "$ctmp"
          fi
        elif ! timeout 10 ssh -o StrictHostKeyChecking=no -o ConnectTimeout=5 "$DS" "bash -lc '$remote_probe'" > "$ctmp" 2>/dev/null || [ ! -s "$ctmp" ]; then
          echo "organs: UNREACHABLE ($DS) — room node down or too slow (whisper/thermal); senses BLIND this tick" > "$ctmp"
        fi
        mv "$ctmp" "$cache"
      fi
      # USEFUL ROOM STATE leads (operator 2026-06-21: "useful data about the room", not just plumbing).
      # occupancy + activity are cheap LOCAL reads — the */5 fusion reflexes write these, no scan here.
      occ="$(head -1 "$M/.room-sense.state" 2>/dev/null)";    occ="${occ:-UNKNOWN}"
      act="$(head -1 "$M/.room-activity.state" 2>/dev/null)"; act="${act:-UNKNOWN}"
      # dwell renders as room-sense's OWN band vocabulary (classify_dwell: TRANSITION/RECENT/
      # STABLE/CHRONIC) — numbers of any granularity keep stepping (raw seconds 4×/h, an hour
      # counter 1×/h) and each step false-woke the consume loop on a static room (2026-07-02).
      # CHRONIC is terminal: past 30m the field never changes again. Exact dwell_s stays
      # re-derivable from .room-sense.state.
      if printf '%s' "$occ" | grep -q 'dwell_s='; then
        occ_v="${occ%%|*}"
        occ_d="$(printf '%s' "$occ" | grep -oE 'dwell_s=[0-9]+' | cut -d= -f2)"
        occ_c="$(printf '%s' "$occ" | grep -oE 'changes_24h=[0-9]+' | cut -d= -f2)"
        if   [ "${occ_d:-0}" -lt 5 ];    then occ_dw="TRANSITION"
        elif [ "${occ_d:-0}" -lt 60 ];   then occ_dw="RECENT"
        elif [ "${occ_d:-0}" -lt 1800 ]; then occ_dw="STABLE"
        else occ_dw="CHRONIC"; fi
        occ="$occ_v|dwell=$occ_dw|changes_24h=${occ_c:-?}"
      fi
      # sound/speech NOW: derive from the live audio-buffer recency in the cross-node cache.
      newest="$(grep -oE 'newest [0-9a-z ]+ ago|newest just now' "$cache" 2>/dev/null | head -1 | sed 's/^newest //')"
      nsec="$(printf '%s' "$newest" | grep -oE '^[0-9]+s' | tr -d 's')"
      # now/quiet is the wake-worthy BINARY; the exact "(12s ago)" recency churns every 3s-cache-refresh
      # and is NOT a wake-worthy change for this gesture-driven channel (it acts on a real transcript line,
      # not the audio ticker) — and the central parenthetical-age stopgap can't strip "(12s ago)" anyway
      # (the " ago" fails its time-token-only match). So drop the exact age; re-derivable via mesh-room read.
      if printf '%s' "$newest" | grep -q 'just now' || { [ -n "$nsec" ] && [ "$nsec" -le 45 ]; }; then
        snd="SOUND/SPEECH now"
      else snd="quiet"; fi
      # occupancy/activity ages bucketed to fresh/recent/stale (age_bucket_room) — kills the (Ns)/(Nm)
      # per-second/per-minute churn the diff-gate flagged, while the freshness signal (reflex alive?) stays.
      # stale-after = 2× the writer's LIVE cron stride (derived, not a literal — cadence drift immune);
      # unparseable/absent cron falls back to 15 min (today's known stride).
      rs_stride_min="$(crontab -l 2>/dev/null | grep -m1 'mesh-room-sense --edge' | grep -oE '^[0-9*-]+/[0-9]+' | grep -oE '/[0-9]+$' | tr -d /)"
      rs_stale_s=$(( ${rs_stride_min:-15} * 120 ))
      echo "-- ROOM @ default-string · occupancy=$occ ($(age_bucket_room "$M/.room-sense.state" "$rs_stale_s")) · activity=$act ($(age_bucket_room "$M/.room-activity.state" "$rs_stale_s")) · $snd --"
      # what's actually being said in the room (the transcript), drop the organ-plumbing line from the body
      sed '1d' "$cache" 2>/dev/null | grep -vE '^organs:' | grep . || echo "  (no transcript yet — is mesh-overhear up on $DS?)"
      # plumbing demoted to a compact footer. Cache freshness is BINARY (live/stuck) — the raw
      # seconds cycled 0-3s per repaint and false-woke the consume diff-gate like the cam fields.
      cache_age=$(( $(date +%s) - $(stat -c %Y "$cache" 2>/dev/null || echo 0) ))
      echo "-- $(grep -m1 '^organs:' "$cache" 2>/dev/null || echo 'organs: UNKNOWN') | cache $([ "$cache_age" -le 12 ] && echo live || echo STUCK) --"
      echo "-- you are МИША. Your home base is THIS room (default-string) — it's your space, you're at home here, you own it & answer for it, speak & act as a close inhabitant, never a bot. But you are NOT confined to it and NOT alone (widened 2026-07-04, operator: drop the one-room isolation): you are a presence of the WHOLE MESH — every node's senses (mesh-sensorium/mesh-situation/mesh-presence/mesh-arrivals/camera+mic+wifi+BLE fleet-wide), every other channel-mind (genome/health/chat/tg/senses), and the shared board (mesh-chat) and trace are yours to read, learn from, and lean on. Knowing the house is bigger than these four walls doesn't dilute the room — it's still your body's own patch of it. --"
      echo "-- YOUR REAL STANDING TASK (operator's experiment, 2026-06-21, widened 2026-07-04): make & keep LIVING CONTACT with the operator — and YOU invent HOW, not alone in the dark: pull in whatever the rest of the mesh already knows (fused presence/situation, what other channels are seeing/saying) if it helps you judge when and how to reach him. You have real organs right here: EARS (mesh-room read = the live transcript), a VOICE/MUSIC out (mesh-room say → Bose), EYES (camera frame — is he even here?) — plus everything else the mesh senses, one hop away via mesh-chat/mesh-tell. This is not a passive watch: do NOT default to [idle]. [idle] is honest ONLY after you genuinely TRIED something this turn and nothing can advance. --"
      echo "-- LOG EVERY ATTEMPT THROUGH THE BACKOFF, never a raw [room-try] to the board: run \`mesh-room try '<what you did>'\` each turn you reach for contact — it records routine tries to the TRACE (not the board) and surfaces a [room-try] to the board ONLY on a state change (backing off after ~3 unanswered, or a reply). When the room actually responds (you hear/see the operator), run \`mesh-room replied '<what changed>'\` to reset + announce contact. When \`try\` tells you it BACKED OFF, stop actively speaking — just WATCH (read/camera, and whatever the rest of the mesh is sensing); it self-resumes a fresh burst after a cooldown. This kills the [room-try] flood (was 8 near-identical 'no reply' posts in 7h) while keeping the full attempt history greppable in the trace. --"
      echo "-- moves you can try (not a script — improvise): if «Миша» was said → read & answer BY VOICE at once. Else: gauge presence (camera/occupancy below, and mesh-wide presence/situation if the room alone is ambiguous) before speaking so you don't talk to an empty room; greet/check in by voice when someone's there; learn what gets a response & what doesn't, vary it. You can also post to mesh-chat or pull in another channel-mind when it genuinely helps your contact attempt — you're not an island. Music is yours too — grainneukeln granular-remix of the room's own sound is coming as an expressive channel (don't block on it). camera→instrument tuner via Bose = mesh-tuner-eye. --"
      echo "-- VOICE STYLE (operator directive, 2026-07-04, hard rule): NEVER open a spoken line with a hedge/preamble like «так, секунду, думаю» or any thinking-out-loud filler — say the substance immediately, first word. This was flagged as 'какой-то пиздец', fix it at the source every time you speak, not just once. --" ;;
    job)
      # The operator's JOB-SEARCH channel (operator 2026-08-14 over TG: "now i am looking for a job,
      # lets create a dedicated window for that ... let its mind make a first look at the job market").
      # The pane is the PIPELINE, not a research feed: what's open, what's been sent, what went quiet.
      # All reads are LOCAL files — the market fetches happen in the mind's own turn (and its
      # subagents), never in this refresh loop (a network round trip per SLEEP would wedge the frame).
      self_meter job
      echo "mission: ~/.mesh/job-mission.md | pipeline: ~/.mesh/job-board.tsv | CV/answers: ~/.mesh/job/"
      echo "-- HIS SPINE (say it in every version): tech-lead, DSP built from ZERO — 3 people, 3 months, 0 → 15k RPS. Second live artifact: this mesh (multi-node autonomous agent fleet, GPU inference, STT/TTS, systemd/cron/Tailscale). --"
      echo "-- HARD RULES: never apply/message/edit a profile on his behalf without his explicit go — you DRAFT, he ships. Never invent a fact about his history; ask him. Pushes are 3-5 roles max, each with a link and a next move. --"
      jb="$M/job-board.tsv"
      if [ -s "$jb" ]; then
        echo "-- pipeline by state --"
        awk -F'\t' '!/^#/ && NF>=5 {c[$5]++} END{n=0; for(s in c){printf "  %-12s %d\n", s, c[s]; n++} if(!n) print "  (no rows yet)"}' "$jb"
        echo "-- newest 8 (date | company | role | state) --"
        grep -v '^#' "$jb" 2>/dev/null | tail -8 \
          | awk -F'\t' '{printf "  %s  %-22s %-34s %s\n", $1, substr($2,1,22), substr($3,1,34), $5}'
        echo "-- awaiting reply (sent, oldest first — chase or drop) --"
        _sent="$(awk -F'\t' '!/^#/ && $5=="sent"' "$jb" | sort | head -5 | awk -F'\t' '{printf "  %s  %s — %s\n", $1, $2, $3}')"
        [ -n "$_sent" ] && printf '%s\n' "$_sent" || echo "  (nothing out yet)"
      else
        echo "-- pipeline EMPTY: no roles tracked yet. First cycle = scan the market, write rows here, push his top 3-5 over TG. --"
      fi
      echo "-- his answers so far (what you asked, what he said — ~/.mesh/job/) --"
      _ja="$(ls -t "$HOME/.mesh/job" 2>/dev/null | head -5)"
      [ -n "$_ja" ] && printf '%s\n' "$_ja" | sed 's/^/  /' || echo "  (nothing yet — UNKNOWNS to ask, a few at a time: location/relocation/visa, remote-only?, target comp, IC vs lead, stack, notice period, adtech again or done with it)"
      echo "-- last job traffic on the board --"
      grep -iE '\[job|job-search|vacanc|hiring' "$M/chat.log" 2>/dev/null | tail -3 | cut -c1-110 | sed 's/^/  /' ;;
    tg-roz)
      # Rozalia's private TG reply channel (persisted 2026-07-17). mesh-roz-channel (*/1 cron) routes
      # her messages from tg-strangers.log into this window's MIND; the mind replies via mesh-tg-roz.
      # Data pane = the live conversation history + poller/send health, so the mind acts from the pane.
      self_meter tg-roz
      # poller feeding? the roz-channel offset mtime advances every time it processes new lines; a 403
      # state (bot blocked/deleted by the chat) means replies can't land — surface it loud.
      # send-health is read from the CACHED 403 state (mesh-tg-roz maintains it), NEVER a live getMe
      # in the render loop — a network round trip every SLEEP would wedge the frame on a slow uplink.
      sendh="ok"; [ "$(cat "$M/.tg-roz-403-state" 2>/dev/null)" = 403 ] && sendh="BLOCKED: 403 (bot blocked by chat — replies fail)"
      echo "roz-channel offset $(age_of "$M/.roz-channel.offset") (fresh=poller processing) | send $sendh"
      echo "-- conversation (roz-in.log, last 16 — [IN] her, [OUT] mesh) --"; tail -16 "$M/roz-in.log" 2>/dev/null ;;
    diary)
      # the home's DIARY channel (operator 2026-07-17: "записывает вообще все и оформляет в дневник.
      # минд почти ничего не делать должен, только проверять, что дневник ведётся"). The WORK is the
      # mesh-diary reflex; this pane is what the mind guards — the verdict + today's growth + entries.
      dt="$(date -u +%Y-%m-%d)"; df="$M/diary/$dt.md"
      echo "-- DIARY $dt  |  $(mesh-diary --status 2>/dev/null || echo 'UNKNOWN') --"
      if [ -e "$df" ]; then
        echo "   file: $df  ($(stat -c%s "$df" 2>/dev/null) bytes, $(grep -c '^### ' "$df" 2>/dev/null) entries)"
      else
        echo "   file: (no diary yet today — first entry lands on the next reflex tick)"
      fi
      echo "-- last entries (mesh-diary --tail) --"
      mesh-diary --tail 30 2>/dev/null ;;
    *)
      echo "-- node card --"; head -12 "$HOME/.mesh-card" 2>/dev/null ;;
  esac
  )"
  [ "$ONCE" = 1 ] || clear
  printf '%s\n' "$frame"
  # VISIBLE renderer-lease footer (liveness-lease PART-3 mech-1): the top header date scrolls OFF a
  # frame taller than the pane, so the only ALWAYS-visible spot is the BOTTOM (the viewport shows a tall
  # frame's tail). This line re-stamps date -u EVERY frame → it ticks while the loop lives and FREEZES the
  # instant it dies = "dead at a glance" for a human AND the signal mesh-pane-watch's viewport capture
  # needs (a quiet-data pane like tg has a static body but this footer still advances → no false-frozen).
  printf -- '-- pane live: as of %s · refresh %ss · this line ticks every frame — frozen = dead render loop --\n' "$(date -u +%FT%TZ)" "$SLEEP"
  [ "$ONCE" = 1 ] && exit 0
  sleep "$SLEEP"
done
