#!/usr/bin/env bash
# mesh-dash <role> — renders the live DATA text for a channel's TOP pane (data = text, self-refreshing).
# Pairs with a mind in the bottom pane (the channel pattern: top data, bottom mind). All text.
# PERCEIVE-ANEW: every frame is re-derived from live state — reflex edge-artifacts, beats, logs,
# git — never a stored summary. The generic walls (state_wall/beat_wall/mind_wall) enumerate
# whatever artifacts EXIST, so a new reflex shows up in the pane without editing this dash.
# ROLE-SPECIFIC by operator request: the board lives in the chat window ONLY — no dash tails chat.log.
#   roles: steward | check | verify | codex/worker | minds | dev | reflexes | organs | tg | models | <other> (node card)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
# ONE name for the cached mesh-pace dispatch row: the minds frame writes/reads it and --test asserts
# from it, and $M is not bound until the role dispatch (below the --test block). A second spelling of
# this path would make the test's cache arm silently n/a forever the day the body's path changed.
PACE_CACHE="$HOME/.mesh/.pace-dispatch.cache"
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes" 2>/dev/null
# shared freshness idiom (render-layer lease, PART 3) — one lib so every pane ages values the same way;
# inline fallback so a missing lib never blanks the pane (degrade to visible UNKNOWN, never to blank).
_mf="$(command -v mesh-freshness 2>/dev/null)"; [ -n "$_mf" ] && . "$_mf" 2>/dev/null || true
command -v fresh_mark >/dev/null 2>&1 || fresh_mark(){ local f="$1" v="$2" ttl="${3:-1800}" a; [ -e "$f" ] || { echo "UNKNOWN (no data)"; return; }; a=$(( $(date +%s) - $(stat -c %Y "$f" 2>/dev/null || echo 0) )); [ -n "$v" ] || { echo "UNKNOWN (empty)"; return; }; [ "$a" -gt "$ttl" ] && echo "$v (${a}s STALE)" || echo "$v (${a}s)"; }
# BLE peer vantage for the cross-node presence MAP — resolved from the node-local registry, NEVER a
# hardcoded IP in the genome (that's how infra leaked before). First user@host that isn't self or a
# no-BLE VM/appliance. Perception windows draw from ALL nodes (operator: a window = the SUM of the
# whole mesh, not one node), so presence is a cross-node fusion, not a local scan.
BLE_PEER=""
for _tok in ${MESH_NODES:-}; do
  case "$_tok" in router:*|GL-MT3000:*|phaedra:*|ilya:*|ideapad:*|*:local) continue ;; esac
  case "${_tok#*:}" in *@*) BLE_PEER="${_tok#*:}"; break ;; esac
done
ONCE=0
if [ "${1:-}" = --test ]; then
  # a dash that paints a blank pane looks alive and informs nobody — so the smoke is a REAL
  # one-frame render (via --once), asserted on content, not an echo-ok
  for x in date git awk grep tail head printf stat; do
    command -v "$x" >/dev/null 2>&1 || { echo "smoke-test: FAIL (no $x)"; exit 1; }
  done
  out="$("$0" --once verify 2>&1)" || { echo "smoke-test: FAIL (verify render exited non-zero)"; exit 1; }
  printf '%s' "$out" | grep -q 'landed recently' || { echo "smoke-test: FAIL (verify frame missing its data block)"; exit 1; }
  out="$("$0" --once card-fallback 2>&1)" || { echo "smoke-test: FAIL (fallback render exited non-zero)"; exit 1; }
  printf '%s' "$out" | grep -q 'node card' || { echo "smoke-test: FAIL (fallback frame missing node card)"; exit 1; }
  # THE FUSED WITNESS PANE MUST CARRY BOTH HALVES (chat→witness merge, 2026-07-24). A merge that
  # silently renders one half is exactly how a lane dies green: the mind keeps working, the surface
  # it needs is simply gone, and nothing anywhere says so. Asserted on a REAL one-frame render.
  _w="$("$0" --once witness 2>&1)" || { echo "smoke-test: FAIL (witness render exited non-zero)"; exit 1; }
  printf '%s' "$_w" | grep -q 'board churn' \
    || { echo "smoke-test: FAIL (fused witness frame lost its BOARD half — the merged mind's coordination surface is gone)"; exit 1; }
  if command -v mesh-witness >/dev/null 2>&1; then
    printf '%s' "$_w" | grep -q 'self-measurement ledger' \
      || { echo "smoke-test: FAIL (fused witness frame lost its TAPE half — mesh-witness is installed, so this is a regression, not honest absence)"; exit 1; }
  else
    printf '%s' "$_w" | grep -q 'mesh-witness NOT INSTALLED' \
      || { echo "smoke-test: FAIL (mesh-witness absent, yet the tape half neither renders nor SAYS it is unavailable — a missing half must announce itself, never just vanish)"; exit 1; }
  fi
  # exactly ONE pane-live footer: the tape half is embedded (--embed) precisely so the pane carries a
  # single liveness lease. Two footers and a frozen render is unreadable — which one died?
  _pl="$(printf '%s\n' "$_w" | grep -c 'pane live')"
  [ "$_pl" = 1 ] || { echo "smoke-test: FAIL (fused witness frame has $_pl pane-live footers, want exactly 1 — the tape half must be rendered with --embed)"; exit 1; }
  # `chat` is an ALIAS of the merged role, not a dead name: tmux is append-only, so a pre-merge chat
  # window keeps rendering until reboot and must show the merged surface — never fall through to the
  # generic node-card fallback, which would look like a fine pane while showing none of its data.
  _c="$("$0" --once chat 2>&1)"
  printf '%s' "$_c" | grep -q 'board churn' \
    || { echo "smoke-test: FAIL (role 'chat' no longer renders the merged surface — a surviving pre-merge pane would silently degrade to the card fallback)"; exit 1; }
  # THE ROOM PROBE MUST NOT MATCH ITSELF (2026-07-15, board/room-ear-watcher-up-is-a-pgrep-self-match).
  # Drive the probe the way the dash really drives it — `bash -lc "<probe text>"`, so the pattern lands
  # in a live cmdline — and assert the cam gate reports DOWN when no cam watcher exists. Under the old
  # bare `pgrep -af <name>` this FAILS (the probe shell matches itself → "watcher up, no frame yet"),
  # which is the whole point: it is the behaviour that was broken, not the source text. Sandbox HOME so
  # no real frame can satisfy it. NB: this sits ABOVE the mesh-pace exit-2 below on purpose — a gate
  # placed under a prerequisite guard is silent on exactly the nodes it should speak for.
  _probe="$(sed -n "/^        remote_probe='/,/^'$/p" "$0" | sed "1s/.*remote_probe='//; \$d")"
  if [ -z "$_probe" ]; then echo "smoke-test: FAIL (room probe not extractable — the self-match gate would assert nothing)"; exit 1; fi
  if pgrep -af "mesh-cam[-]watch" >/dev/null 2>&1; then
    echo "smoke-test: note (a real cam watcher runs here — cam=DOWN assertion unrenderable, self-match gate skipped)"
  else
    _hm="$(mktemp -d)"; mkdir -p "$_hm/.mesh"
    _pout="$(HOME="$_hm" bash -lc "$_probe" 2>/dev/null)"
    rm -rf "$_hm"
    printf '%s' "$_pout" | grep -q 'cam=DOWN' \
      || { echo "smoke-test: FAIL (room probe: no cam watcher runs, yet the probe does not report cam=DOWN — a pattern is matching the probe cmdline itself)"; exit 1; }
    # The ear row must be built from the organ gates (not a resurrected wake-word pgrep) AND must be
    # ONE COMPLETE LINE. Both halves are regressions that really happened: `is-active` prints its
    # verdict and ALSO exits non-zero, so `$(is-active || echo inactive)` yielded "inactive\ninactive"
    # and tore the row in two on the live pane — the room mind reads this row, and half a row is a
    # worse lie than no row. Assert the whole shape, on a single line.
    printf '%s' "$_pout" | grep -qE '^ear: stt=[a-z-]+ · wake-reflex=(UP|DOWN) · .+ · last name-wake: (never|just now|recent|old)$' \
      || { echo "smoke-test: FAIL (room probe: ear row is not one complete line built from the organ gates — got: $(printf '%s' "$_pout" | grep -A1 '^ear:' | head -2 | tr '\n' '/'))"; exit 1; }
  fi
  # VOICE FIELD IS DERIVED, NEVER A LITERAL (chat-review/room-dash-voice-field-is-a-literal): three
  # verify-ledger states must render THREE DIFFERENT strings in the organ line — under the old
  # constant Bose=mesh-say all three read identically healthy while the amp had been dead a day and
  # the verdict sat unread in the log (two room minds re-proved the death by hand in one night).
  # Sandbox HOME per state, driven through bash -lc exactly like the live ssh. Watched RED pre-fix
  # on all three lanes.
  _vh="$(mktemp -d)"; mkdir -p "$_vh/.mesh"
  _vrun(){ HOME="$_vh" bash -lc "$_probe" 2>/dev/null | grep '^organs:'; }
  printf '2026-07-17T00:00:01\tSILENT\t0.00\ttest\t\n2026-07-17T00:10:01\tSILENT\t0.00\ttest\t\n2026-07-17T00:20:01\tSILENT\t0.00\ttest\t\n' > "$_vh/.mesh/misha-say-verify.log"
  _vout="$(_vrun)"
  printf '%s' "$_vout" | grep -q 'Bose=VOICE-DEAD (fallback note3' \
    || { echo "smoke-test: FAIL (room probe: a 3x-SILENT verify tail does not render VOICE-DEAD — the voice organ field is a constant again; got: $_vout)"; exit 1; }
  printf '2026-07-17T00:00:01\tSILENT\t0.00\ttest\t\n2026-07-17T00:10:01\tOK\t0.62\ttest\t\n' > "$_vh/.mesh/misha-say-verify.log"
  _vout="$(_vrun)"
  printf '%s' "$_vout" | grep -q 'Bose=OK (verified' \
    || { echo "smoke-test: FAIL (room probe: an OK verify tail does not render the OK verdict in the organ line; got: $_vout)"; exit 1; }
  rm -f "$_vh/.mesh/misha-say-verify.log"
  _vout="$(_vrun)"
  printf '%s' "$_vout" | grep -q 'Bose=unverified' \
    || { echo "smoke-test: FAIL (room probe: an absent verify log does not render unverified — absence must be its own third string, never a healthy default; got: $_vout)"; exit 1; }
  rm -rf "$_vh"

  # the allocation block must render the dispatch GATE, not just idle/open counts — a frame that
  # shows hands+work and hides the governor holding them is why every mind hand-probed mesh-pace.
  # Asserted against a REAL minds frame (never the source text), in CACHE-ONLY mode: mesh-pace --status
  # measured 22.6-24.0s on 2026-08-10, so any test that pays that scan (the old failure-branch probe, or
  # a cold-cache render) burns ~28s of mesh-land's `timeout 30` and strands the dash on latency alone.
  # The cached row IS the discriminator the expensive probe used to be: row present + gate line missing
  # = regression (FAIL); no cached row = nothing to assert yet (exit 2, honest n/a — the live pane
  # refreshes it every 150s, so on any node with a minds pane this arm is the real one).
  out="$(MESH_DASH_FAST=1 MESH_DASH_PACE_CACHE_ONLY=1 "$0" --once minds 2>&1)" || { echo "smoke-test: FAIL (minds render exited non-zero)"; exit 1; }
  if printf '%s' "$out" | grep -qE '^  gate: dispatch (HELD|READY)'; then
    # the NUMBER must be the right column. The READY branch used to print eff_gap (the requirement)
    # labelled "elapsed"; assert the rendered elapsed against last_age from the same cached row, so a
    # revert to $3 goes red instead of quietly re-mislabelling a line minds read to explain a hold.
    if printf '%s' "$out" | grep -qE '^  gate: dispatch READY'; then
      _pel="$(printf '%s' "$out" | sed -nE 's/^  gate: dispatch READY — ([0-9]+)m elapsed.*/\1/p' | head -1)"
      _pwant="$(awk '$1=="dispatch"{printf "%d", $2/60}' "$PACE_CACHE" 2>/dev/null)"
      [ -n "$_pel" ] && [ -n "$_pwant" ] && [ "$_pel" = "$_pwant" ] \
        || { echo "smoke-test: FAIL (dispatch READY renders '${_pel:-?}m elapsed' but the cached row's last_age is ${_pwant:-?}m — wrong column, the requirement is not the elapsed)"; exit 1; }
    fi
  elif [ -s "$PACE_CACHE" ] && awk '$1=="dispatch"{f=1} END{exit !f}' "$PACE_CACHE"; then
    echo "smoke-test: FAIL (minds frame missing the dispatch pace gate — a cached dispatch row exists, so the line is renderable)"; exit 1
  else
    echo "smoke-test: n/a (no cached mesh-pace dispatch row — gate line unassertable, not regressed)"; exit 2
  fi
  # the division-of-labour axis must render mesh-forage's OUTPUT, not just its (unconditional) header
  # echo — assert a jq-PRODUCED line ('intended J=' or the empty-board fallback), which is silent if
  # the mesh-forage|jq pipe breaks or is mis-wired. Guarded on mesh-forage/jq: skipped where the axis
  # is honestly unrenderable, never a false green. (Same REAL-frame discipline as the gate above.)
  if command -v mesh-forage >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
    printf '%s' "$out" | grep -qE '^  (intended J=|no owner-assigned \[task\]s)' \
      || { echo "smoke-test: FAIL (minds frame missing the division-of-labour axis — mesh-forage output not wired into the pane)"; exit 1; }
  fi
  echo "smoke-test: ok"; exit 0
fi
[ "${1:-}" = --once ] && { ONCE=1; shift; }   # render one frame and exit (no clear/sleep) — for --test
role="${1:-steward}"; M="$HOME/.mesh"; REPO="$HOME/lte-workstation"
# pub channel's DATA pane is its OWN two-half dash (mesh-pub-dash: WRITE-ABOUT | external COMMENTS) —
# not a role rendered here. Hand off entirely so `mesh-dash pub` (the manifest's top-pane cmd) IS it.
if [ "$role" = pub ] && [ -x "$HOME/.local/bin/mesh-pub-dash" ]; then
  [ "${ONCE:-0}" = 1 ] && exec "$HOME/.local/bin/mesh-pub-dash" --once || exec "$HOME/.local/bin/mesh-pub-dash"
fi
# witness channel: NOTE — this used to hand the whole pane off to `mesh-witness --pane` here, before
# any helper is defined. Since the chat→witness merge (operator 2026-07-24) the witness pane is a
# TWO-HALF dash (tape ABOVE, board BELOW) and the board half needs self_meter/mesh-claim, so the role
# now renders through the normal case dispatch below. The blank-pane guard the old loop existed for
# (phaedra witness blank-pane flaps, 2026-07-08) is kept in kind, not in form: the main loop captures
# the whole frame into a var BEFORE `clear`, and the witness case emits its section headers
# unconditionally — so a hung/erroring mesh-witness degrades to a header with an ERROR line under it,
# never to the visible blank a bare clear-then-render raced into.
# SELF-REEXEC ON CODE UPDATE — a long-lived pane keeps its FIRST in-memory parse of this script, so a
# dash edit (e.g. dropping a block) leaves every running pane rendering the OLD layout with stale data
# until someone manually respawns it (operator-caught 2026-06-15: plan pane stale 1d22h after an edit).
# Fix at the source: stamp our own mtime at startup; each loop, if the file on disk is NEWER, exec the
# fresh code in place. No respawn list to maintain, no external reflex — every role self-heals within
# one refresh cycle of a deploy. ONCE/test path skips it (single frame, no loop).
SELF="$(command -v "$0" 2>/dev/null || echo "$0")"
SELF_MTIME="$(stat -c %Y "$SELF" 2>/dev/null || echo 0)"
# per-role refresh: organs fans out SSH to every peer (keep it cool); reflexes is local-cheap;
# room is a LIVE transcript the operator watches while talking — repaint every 3s, and the room case
# refreshes its ds cross-node cache every 3s too, so new transcript lines show within a few seconds.
# witness keeps the 15s cadence its bespoke loop had before the chat merge — the tape is a live
# measurement stream and the whole point of the channel is reading it AS it moves; the board half's
# one expensive read (mesh-claim) is cache-throttled to 60s inside the role so the faster repaint
# costs nothing extra.
case "$role" in organs) SLEEP=300 ;; reflexes) SLEEP=60 ;; room) SLEEP=3 ;; witness|chat) SLEEP=15 ;; *) SLEEP=30 ;; esac

age_of(){ # human age of a file's last touch — "how fresh is this perception"
  local f="$1" a; [ -f "$f" ] || { echo "-"; return; }
  a=$(( $(date +%s) - $(stat -c %Y "$f" 2>/dev/null || echo 0) ))
  if   [ "$a" -ge 86400 ]; then echo "$((a/86400))d"
  elif [ "$a" -ge 3600 ];  then echo "$((a/3600))h"
  elif [ "$a" -ge 60 ];    then echo "$((a/60))m"
  else echo "${a}s"; fi
}
age_bucket(){ # COARSE freshness bucket — a top pane shows fresh/stale, not an exact second-by-second age
  # that re-renders (and re-wakes the consuming mind) every frame (operator 2026-06-25 top-pane rule).
  local f="$1" m; [ -f "$f" ] || { echo "-"; return; }
  m=$(( ( $(date +%s) - $(stat -c %Y "$f" 2>/dev/null || echo 0) ) / 60 ))
  if   [ "$m" -lt 30 ];  then echo "<30m"
  elif [ "$m" -lt 60 ];  then echo "30-60m"
  elif [ "$m" -lt 180 ]; then echo "1-3h"
  else echo "3h+"; fi
}
age_bucket_room(){ # FINE freshness bucket for ROOM senses — fresh/recent/stale carries the live
  # "did the reflex stall?" signal yet kills the per-second/per-minute (Ns)/(Nm) churn that re-woke
  # the room mind every frame (operator 2026-06-25: top-pane liveness is the room block's own job).
  # $2 = stale-after seconds, judged against the WRITER's real cron stride — the old hardcoded 600s
  # assumed a */5 stride while the fusion crons run 2-59/15, branding a healthy reflex "stale" for
  # the last third of every cycle (age-vs-cadence mislabel, 2026-07-02).
  local f="$1" stale_after="${2:-600}" s; [ -f "$f" ] || { echo "-"; return; }
  s=$(( $(date +%s) - $(stat -c %Y "$f" 2>/dev/null || echo 0) ))
  if   [ "$s" -lt 120 ]; then echo "fresh"
  elif [ "$s" -lt "$stale_after" ]; then echo "recent"
  else echo "stale"; fi
}
state_wall(){ # EVERY edge-trigger reflex state, one live line each — grows as reflexes grow
  local f n
  for f in "$M"/.[a-z]*-state; do
    [ -f "$f" ] || continue
    n="${f##*/}"; n="${n#.}"
    case "$n" in mind-state-*) continue;; esac   # minds get their own wall
    printf '  %-22s %-16s age %s\n' "${n%-state}" \
      "$(head -c30 "$f" 2>/dev/null | tr '\n' ' ')" "$(age_of "$f")"
  done
}
mind_wall(){ # last classified pane-state per mind channel (watcher re-derives these)
  local f
  for f in "$M"/.mind-state-*; do
    [ -f "$f" ] || continue
    printf '  %-8s %-14s age %s\n' "${f##*-}" "$(head -c20 "$f" 2>/dev/null | tr '\n' ' ')" "$(age_of "$f")"
  done
}
beat_wall(){ # liveness beats — own heart, peers' hearts, reflex per-run beats
  local f n
  for f in "$M"/heartbeat*.beat "$M"/.*.beat; do
    [ -f "$f" ] || continue
    n="${f##*/}"; n="${n%.beat}"; n="${n#.}"; n="${n#heartbeat-}"; [ "$n" = heartbeat ] && n=self
    printf '  %-28s age %s\n' "$n" "$(age_of "$f")"
  done
}
# --- enrichment helpers (operator 2026-06-15: "data pane can be much more helpful") ---
stress_line(){ # the node's KNOWN FAILURE MODE first — the operator channel dies from heat (thermal throttle)
  local s; s="$(timeout 8 mesh-stress 2>/dev/null | sed 's/^mesh-stress: //')"
  [ -n "$s" ] && printf 'STRESS %s' "$s" || printf 'STRESS (unknown)'
}
actionable_minds(){ # ONLY minds that need a hand (the steward's job = drive these); else a one-line all-clear
  local f n st hits=0 total=0
  for f in "$M"/.mind-state-*; do
    [ -f "$f" ] || continue
    total=$((total+1)); n="${f##*-}"; st="$(head -c20 "$f" 2>/dev/null | tr -d '\n ')"
    case "$st" in BLOCKED*|NEEDS-INPUT*|RATE-LIMITED*|DEAD*)
      printf '  ⚠ %-8s %-14s age %s\n' "$n" "$st" "$(age_of "$f")"; hits=$((hits+1)) ;;
    esac
  done
  [ "$hits" = 0 ] && printf '  ✓ none blocked — %s minds idle/working\n' "$total"
}
open_work(){ # in-flight work = recent [taking] on the board today (real work, NOT vanity done-counts)
  local td lines; td=$(date -u +%F)
  lines="$(grep "$td" "$M/chat.log" 2>/dev/null | grep -oE '\[taking\].*' | tail -4)"
  if [ -n "$lines" ]; then printf '%s\n' "$lines" | cut -c1-92 | sed 's/^/  /'
  else printf '  (no work claimed today)\n'; fi
}
# --- per-mind CONTEXT + SPEND self-meter (operator 2026-06-17: "keep track context (and /compact) +
# spend, depending on the mind"). The mesh-mind-compact + mesh-spend reflexes PRODUCE this; the data
# pane shows it; the mind acts on it (high ctx → it can /compact itself). "Depending on the mind" is
# real: opencode minds expose a readable context-% + $cost; claude minds don't (they auto-compact) —
# their spend is quota turns (mesh-spend --tokens). ONE cheap --stats call per window. ---
mind_engine(){ awk -v w="$1" '$1==w{print $2; exit}' "$M/minds.map" 2>/dev/null; }
self_meter(){ # $1=window — one line the OWNING mind reads to self-manage its context/spend
  local w="$1" eng line state tok pct doll lcage
  eng="$(mind_engine "$w")"; eng="${eng:-?}"
  line="$(mesh-mind-state --stats "$w" 2>/dev/null | awk -v w="$w" '$1==w{print;exit}')"
  state="$(printf '%s' "$line" | cut -f2 | tr -d ' ')"
  tok="$(printf '%s' "$line" | cut -f4 | tr -d ' ')"
  pct="$(printf '%s' "$line" | cut -f5 | tr -d ' ')"
  doll="$(printf '%s' "$line" | cut -f6 | tr -d ' ')"
  lcage="$(age_of "$M/.compact-$w")"
  # mind_engine reads ~/.mesh/minds.map — an artifact NO tool on this node writes (checked
  # 2026-07-24: absent entirely), so eng was "?" for EVERY window and every opencode channel
  # (senses/health/witness/discover/sound/vpn/tg-roz) got told "claude auto-compacts" while its
  # real ctx% sat unread in the very --stats line above. Fall back to the LIVE reading we already
  # hold: mesh-mind-state renders a real PCT ("3%") for opencode panes and a literal "?" for
  # claude ones, so a parseable PCT IS the opencode branch. The map still wins when it exists.
  # NOTE the quoting: an unquoted ? in a case pattern is a GLOB (any single char), not the literal
  # "?" this fallback is keyed on.
  case "$eng" in
    '?'|"") case "$pct" in [0-9]*%) eng=opencode ;; esac ;;
  esac
  if [ "$eng" = opencode ]; then
    printf '  self: %s · ctx %s (%s) · cost %s · last /clear %s ago (auto >60%%)\n' \
      "${state:-?}" "${pct:-?}" "${tok:-?}" "${doll:-free}" "$lcage"
  else
    printf '  self: %s · claude auto-compacts · last /clear %s ago (auto >45m idle) · spend: mesh-spend --tokens\n' \
      "${state:-?}" "$lcage"
  fi
}

while :; do
  # picked up a newer copy of ourselves? re-exec the fresh code in place (kills stale-layout panes)
  if [ "$ONCE" != 1 ]; then
    now_mtime="$(stat -c %Y "$SELF" 2>/dev/null || echo 0)"
    [ "$now_mtime" != "$SELF_MTIME" ] && exec "$SELF" "$role"
  fi
  # BUILD the frame into a buffer FIRST (the slow data-tools run in here), THEN clear+paint atomically
  # below. A slow/wedged tool now leaves the LAST good frame on screen (with its old timestamp = visibly
  # stale) instead of BLANKING the pane — the failure that made the steward pane go blank (2026-06-15).
  frame="$(
  printf '== %s data (refresh %ss) — all text ==\n' "$role" "$SLEEP"; date -u; echo
  case "$role" in
    steward)
      # 1. FUSED SITUATION — internal(stress/temp/minds) + external(security) + physical(presence) in one
      #    block. The operator-facing pane LEADS with situational awareness; temp lives here (our failure mode).
      timeout 9 mesh-situation 2>/dev/null | sed -n '1,5p' | sed 's/^==* /SITUATION: /; s/ =*$//' | cut -c1-100 || echo "SITUATION: (unavailable)"
      # 2. substrate + failure-mode detail (therm/router/egress states aren't in the situation block)
      xn=$(timeout 5 tailscale debug prefs 2>/dev/null | python3 -c 'import json,sys;print(json.load(sys.stdin).get("ExitNodeID") or "none")' 2>/dev/null)
      det=$(timeout 6 mesh-stress --json 2>/dev/null | python3 -c 'import json,sys
try:
 d=json.load(sys.stdin); print("therm=%s router=%s egress=%s%s"%(d.get("therm_state"),d.get("router_state"),d.get("egress_state")," CLIMBING" if d.get("climbing")=="yes" else ""))
except Exception: print("")' 2>/dev/null)
      echo "egress $(ip route get 1.1.1.1 2>/dev/null|grep -oP 'dev \K\S+') exitnode=$xn | doctor FAIL=$(head -c4 "$M/.doctor-cron-state" 2>/dev/null || echo '?') | reflexes $(mesh-supervise --status 2>/dev/null|grep -c UP)UP | strands=$(git -C "$REPO" status --short -- scripts/ 2>/dev/null | wc -l) | $det"
      # 3. minds-state lives ONLY in the 'minds' window's data pane (operator 2026-06-15: "minds info
      #    belongs to the minds data pane only, not yours" — it was broken/duplicated here). The minds
      #    window owns the correct live mind-state + idle hands; this pane no longer duplicates it.
      # 4. in-flight work = recent [taking] (what's happening NOW), not a vanity done-count
      echo "-- open work (claimed today) --"; open_work
      # 5. operator inbox — is the operator waiting on us? (steward owns the comms lane)
      echo "-- operator (last in, age $(age_of "$M/voice-in.log")) --"; tail -1 "$M/voice-in.log" 2>/dev/null | cut -c1-100
      # 6. PLAN this tick (PLAN.md uses '## THIS TICK', not the never-existent '## 🔜 NEXT' — audit 2026-06-19)
      echo "-- PLAN: this tick --"; awk '/^## THIS TICK/{f=1;print;next} /^## /{if(f)exit} f' "$M/PLAN.md" 2>/dev/null | grep -vE '^[[:space:]]*$' | cut -c1-92 | head -3
      # 7. recent [done] (replaces the RETIRED feed/work-pump block — it showed 2-day-old dead data)
      echo "-- recent [done] --"; grep -F '[done]' "$M/chat.log" 2>/dev/null | grep -oE '\[done\].*' | tail -3 | cut -c1-92 | sed 's/^/  /' ;;
    clear)
      # THE CLEAR WINDOW (operator 2026-07-18): every /clear, so clears get fixed by numbers not blind.
      # /compact is retired; /clear is the sole context lever. This pane = when cleared · ctx% at clear ·
      # handoff freshness · reason. Ledger written by mesh-mind-compact (task-boundary reflex) + mesh-clear.
      echo "== CLEAR-LOG — every /clear (when · ctx · handoff coverage) =="
      timeout 8 mesh-clear-log --stats 2>/dev/null || echo "  (clear-log unavailable)"
      echo; echo "-- recent clears --"
      timeout 8 mesh-clear-log --tail 12 2>/dev/null | cut -c1-118 || echo "  (none)" ;;
    check)
      # UNIFIED node-health view — absorbs the old standalone organs + reflexes windows (operator
      # 2026-06-13: "none without a mind, merge into bigger ones"). One mind (this channel) watches
      # doctor + organs + reflexes + vitals + streams, re-derived live.
      sup="$(mesh-supervise --status 2>/dev/null)"
      # retry once on a transient empty read — else the count flips to a phantom 0UP/0DOWN
      # full-outage (intermittent torn read of the supervise state, observed 2026-06-25)
      [ -z "$sup" ] && { sleep 1; sup="$(mesh-supervise --status 2>/dev/null)"; }
      self_meter health   # this mind's own context/spend (opencode: ctx% + $cost; /compact >60%)
      echo "egress $(ip route get 1.1.1.1 2>/dev/null|grep -oP 'dev \K\S+') | supervised $(printf '%s' "$sup"|grep -c UP)UP/$(printf '%s' "$sup"|grep -c DOWN)DOWN | organs $(mesh-organ-keepalive --status 2>/dev/null|grep -c LIVE)LIVE/$(mesh-organ-keepalive --status 2>/dev/null|grep -c DARK)DARK"
      # FLEET-WIDE health (operator 2026-06-14: every window = the WHOLE mesh, not just this node).
