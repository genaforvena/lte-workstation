import json,sys,time,calendar
try: d=json.load(sys.stdin)
except Exception:
    print('  (tailscale status unreadable)'); sys.exit(0)
now=time.time()
def humb(n):
    n=float(n or 0)
    for u in ('B','KB','MB','GB','TB'):
        if n<1024: return ('%dB'%int(n)) if u=='B' else ('%.1f%s'%(n,u))
        n/=1024.0
    return '%.1fPB'%n
def humt(iso):
    if not iso or iso.startswith('0001'): return 'never'
    try: t=calendar.timegm(time.strptime(iso[:19],'%Y-%m-%dT%H:%M:%S'))
    except Exception: return '?'
    s=now-t
    if s<0: return 'now'
    if s<3600: return '%dm'%(int(s)//60)
    if s<86400: return '%dh'%(int(s)//3600)
    return '%dd'%(int(s)//86400)
peers=[]
sf=d.get('Self') or {}
if sf: sf=dict(sf); sf['_self']=True; peers.append(sf)
for k,p in (d.get('Peer') or {}).items():
    p=dict(p); p['_self']=False; peers.append(p)
on=[p for p in peers if p.get('Online')]
off=[p for p in peers if not p.get('Online')]
on.sort(key=lambda p:p.get('HostName',''))
off.sort(key=lambda p:p.get('LastSeen') or '',reverse=True)
print('  ONLINE (%d)   OFFLINE (%d)   total %d'%(len(on),len(off),len(peers)))
for p in on:
    nm=(p.get('HostName') or '?')[:18]
    ip0=(p.get('TailscaleIPs') or ['?'])[0]
    os0=(p.get('OS') or '?')[:7]
