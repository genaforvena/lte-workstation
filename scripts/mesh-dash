#!/usr/bin/env bash
# mesh-dash <role> — renders the live DATA text for a channel's TOP pane (data = text, self-refreshing).
# Pairs with a mind in the bottom pane (the channel pattern: top data, bottom mind). All text.
# PERCEIVE-ANEW: every frame is re-derived from live state — reflex edge-artifacts, beats, logs,
# git — never a stored summary. The generic walls (state_wall/beat_wall/mind_wall) enumerate
# whatever artifacts EXIST, so a new reflex shows up in the pane without editing this dash.
# ROLE-SPECIFIC by operator request: the board lives in the chat window ONLY — no dash tails chat.log.
#   roles: steward | check | verify | codex/worker | minds | dev | reflexes | organs | tg | <other> (node card)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes" 2>/dev/null
# BLE peer vantage for the cross-node presence MAP — resolved from the node-local registry, NEVER a
# hardcoded IP in the genome (that's how infra leaked before). First user@host that isn't self or a
# no-BLE VM/appliance. Perception windows draw from ALL nodes (operator: a window = the SUM of the
# whole mesh, not one node), so presence is a cross-node fusion, not a local scan.
BLE_PEER=""
for _tok in ${MESH_NODES:-}; do
  case "$_tok" in router:*|GL-MT3000:*|phaedra:*|ilya:*|ideapad:*|*:local) continue ;; esac
  case "${_tok#*:}" in *@*) BLE_PEER="${_tok#*:}"; break ;; esac
done
ONCE=0
if [ "${1:-}" = --test ]; then
  # a dash that paints a blank pane looks alive and informs nobody — so the smoke is a REAL
  # one-frame render (via --once), asserted on content, not an echo-ok
  for x in date git awk grep tail head printf stat; do
    command -v "$x" >/dev/null 2>&1 || { echo "smoke-test: FAIL (no $x)"; exit 1; }
  done
  out="$("$0" --once verify 2>&1)" || { echo "smoke-test: FAIL (verify render exited non-zero)"; exit 1; }
  printf '%s' "$out" | grep -q 'landed recently' || { echo "smoke-test: FAIL (verify frame missing its data block)"; exit 1; }
  out="$("$0" --once card-fallback 2>&1)" || { echo "smoke-test: FAIL (fallback render exited non-zero)"; exit 1; }
  printf '%s' "$out" | grep -q 'node card' || { echo "smoke-test: FAIL (fallback frame missing node card)"; exit 1; }
  echo "smoke-test: ok"; exit 0
fi
[ "${1:-}" = --once ] && { ONCE=1; shift; }   # render one frame and exit (no clear/sleep) — for --test
role="${1:-steward}"; M="$HOME/.mesh"; REPO="$HOME/lte-workstation"
# per-role refresh: organs fans out SSH to every peer (keep it cool); reflexes is local-cheap
case "$role" in organs) SLEEP=300 ;; reflexes) SLEEP=60 ;; *) SLEEP=30 ;; esac

age_of(){ # human age of a file's last touch — "how fresh is this perception"
  local f="$1" a; [ -f "$f" ] || { echo "-"; return; }
  a=$(( $(date +%s) - $(stat -c %Y "$f" 2>/dev/null || echo 0) ))
  if   [ "$a" -ge 86400 ]; then echo "$((a/86400))d"
  elif [ "$a" -ge 3600 ];  then echo "$((a/3600))h"
  elif [ "$a" -ge 60 ];    then echo "$((a/60))m"
  else echo "${a}s"; fi
}
state_wall(){ # EVERY edge-trigger reflex state, one live line each — grows as reflexes grow
  local f n
  for f in "$M"/.[a-z]*-state; do
    [ -f "$f" ] || continue
    n="${f##*/}"; n="${n#.}"
    case "$n" in mind-state-*) continue;; esac   # minds get their own wall
    printf '  %-22s %-16s age %s\n' "${n%-state}" \
      "$(head -c30 "$f" 2>/dev/null | tr '\n' ' ')" "$(age_of "$f")"
  done
}
mind_wall(){ # last classified pane-state per mind channel (watcher re-derives these)
  local f
  for f in "$M"/.mind-state-*; do
    [ -f "$f" ] || continue
    printf '  %-8s %-14s age %s\n' "${f##*-}" "$(head -c20 "$f" 2>/dev/null | tr '\n' ' ')" "$(age_of "$f")"
  done
}
beat_wall(){ # liveness beats — own heart, peers' hearts, reflex per-run beats
  local f n
  for f in "$M"/heartbeat*.beat "$M"/.*.beat; do
    [ -f "$f" ] || continue
    n="${f##*/}"; n="${n%.beat}"; n="${n#.}"; n="${n#heartbeat-}"; [ "$n" = heartbeat ] && n=self
    printf '  %-28s age %s\n' "$n" "$(age_of "$f")"
  done
}
# --- enrichment helpers (operator 2026-06-15: "data pane can be much more helpful") ---
stress_line(){ # the node's KNOWN FAILURE MODE first — the operator channel dies from heat (thermal throttle)
  local s; s="$(timeout 8 mesh-stress 2>/dev/null | sed 's/^mesh-stress: //')"
  [ -n "$s" ] && printf 'STRESS %s' "$s" || printf 'STRESS (unknown)'
}
actionable_minds(){ # ONLY minds that need a hand (the steward's job = drive these); else a one-line all-clear
  local f n st hits=0 total=0
  for f in "$M"/.mind-state-*; do
    [ -f "$f" ] || continue
    total=$((total+1)); n="${f##*-}"; st="$(head -c20 "$f" 2>/dev/null | tr -d '\n ')"
    case "$st" in BLOCKED*|NEEDS-INPUT*|RATE-LIMITED*|DEAD*)
      printf '  ⚠ %-8s %-14s age %s\n' "$n" "$st" "$(age_of "$f")"; hits=$((hits+1)) ;;
    esac
  done
  [ "$hits" = 0 ] && printf '  ✓ none blocked — %s minds idle/working\n' "$total"
}
open_work(){ # in-flight work = recent [taking] on the board today (real work, NOT vanity done-counts)
  local td lines; td=$(date -u +%F)
  lines="$(grep "$td" "$M/chat.log" 2>/dev/null | grep -oE '\[taking\].*' | tail -4)"
  if [ -n "$lines" ]; then printf '%s\n' "$lines" | cut -c1-92 | sed 's/^/  /'
  else printf '  (no work claimed today)\n'; fi
}

while :; do
  [ "$ONCE" = 1 ] || clear
  printf '== %s data (refresh %ss) — all text ==\n' "$role" "$SLEEP"; date -u; echo
  case "$role" in
    steward)
      # 1. FUSED SITUATION — internal(stress/temp/minds) + external(security) + physical(presence) in one
      #    block. The operator-facing pane LEADS with situational awareness; temp lives here (our failure mode).
      timeout 9 mesh-situation 2>/dev/null | sed -n '1,5p' | sed 's/^==* /SITUATION: /; s/ =*$//' | cut -c1-100 || echo "SITUATION: (unavailable)"
      # 2. substrate + failure-mode detail (therm/router/egress states aren't in the situation block)
      xn=$(tailscale debug prefs 2>/dev/null | python3 -c 'import json,sys;print(json.load(sys.stdin).get("ExitNodeID") or "none")' 2>/dev/null)
      det=$(timeout 6 mesh-stress --json 2>/dev/null | python3 -c 'import json,sys
try:
 d=json.load(sys.stdin); print("therm=%s router=%s egress=%s%s"%(d.get("therm_state"),d.get("router_state"),d.get("egress_state")," CLIMBING" if d.get("climbing")=="yes" else ""))
except Exception: print("")' 2>/dev/null)
      echo "egress $(ip route get 1.1.1.1 2>/dev/null|grep -oP 'dev \K\S+') exitnode=$xn | doctor FAIL=$(head -c4 "$M/.doctor-cron-state" 2>/dev/null || echo '?') | reflexes $(mesh-supervise --status 2>/dev/null|grep -c UP)UP | strands=$(git -C "$REPO" status --short -- scripts/ 2>/dev/null | wc -l) | $det"
      # 3. minds-state lives ONLY in the 'minds' window's data pane (operator 2026-06-15: "minds info
      #    belongs to the minds data pane only, not yours" — it was broken/duplicated here). The minds
      #    window owns the correct live mind-state + idle hands; this pane no longer duplicates it.
      # 4. in-flight work = recent [taking] (what's happening NOW), not a vanity done-count
      echo "-- open work (claimed today) --"; open_work
      # 5. operator inbox — is the operator waiting on us? (steward owns the comms lane)
      echo "-- operator (last in, age $(age_of "$M/voice-in.log")) --"; tail -1 "$M/voice-in.log" 2>/dev/null | cut -c1-100
      # 6. PLAN next (crisp)
      echo "-- PLAN: next --"; awk '/^## 🔜 NEXT/{f=1;next} /^## /{f=0} f' "$M/PLAN.md" 2>/dev/null | grep -vE '^[[:space:]]*$' | cut -c1-92 | head -3
      # 7. recent [done] (replaces the RETIRED feed/work-pump block — it showed 2-day-old dead data)
      echo "-- recent [done] --"; grep -F '[done]' "$M/chat.log" 2>/dev/null | grep -oE '\[done\].*' | tail -3 | cut -c1-92 | sed 's/^/  /' ;;
    check)
      # UNIFIED node-health view — absorbs the old standalone organs + reflexes windows (operator
      # 2026-06-13: "none without a mind, merge into bigger ones"). One mind (this channel) watches
      # doctor + organs + reflexes + vitals + streams, re-derived live.
      sup="$(mesh-supervise --status 2>/dev/null)"
      echo "egress $(ip route get 1.1.1.1 2>/dev/null|grep -oP 'dev \K\S+') | supervised $(printf '%s' "$sup"|grep -c UP)UP/$(printf '%s' "$sup"|grep -c DOWN)DOWN | organs $(mesh-organ-keepalive --status 2>/dev/null|grep -c LIVE)LIVE/$(mesh-organ-keepalive --status 2>/dev/null|grep -c DARK)DARK"
      # FLEET-WIDE health (operator 2026-06-14: every window = the WHOLE mesh, not just this node).
      # Cached by a slow cron (mesh-fleet-health, */10) so the dash stays cheap — no per-frame SSH fanout.
      echo "-- FLEET (ALL nodes — cached $(age_of "$M/.fleet-health.cache")) --"
      grep -vE '^===|^$' "$M/.fleet-health.cache" 2>/dev/null | head -9
      echo "doctor (this node): $(tail -1 "$M/doctor.log" 2>/dev/null) (age $(age_of "$M/doctor.log"))"
      echo "-- vitals + therm (this box's known failure mode) --"; mesh-vitals 2>/dev/null|head -1; tail -1 "$M/therm.log" 2>/dev/null | grep -oE 'max=[0-9]+°C.*' | head -1
      echo "-- organs (LIVE/DARK per node) --"; mesh-organ-keepalive --status 2>/dev/null | head -6
      echo "-- supervised loops --"; printf '%s\n' "$sup" | head -6
      echo "-- edge states (every reflex, re-derived live) --"; state_wall
      echo "-- monitor streams (last fed) --"; tail -3 "$M/stream.log" 2>/dev/null ;;
    verify)
      echo "-- verify results (per-tool, from board) --"; timeout 10 mesh-verify-table 2>/dev/null | head -16
      echo "-- landed recently (reality-check these) --"; git -C "$REPO" --no-pager log --oneline -5 2>/dev/null
      echo "-- tools touched <=24h (re-verify surface) --"; git -C "$REPO" --no-pager log --since=24.hours --name-only --pretty=format: -- scripts/ 2>/dev/null | sort -u | sed '/^$/d' | head -6
      echo "-- uncommitted (stranding watch) --"; git -C "$REPO" status --short -- scripts/ 2>/dev/null | head -4
      echo "-- doctor verdicts (last 2 runs) --"; tail -2 "$M/doctor.log" 2>/dev/null
      echo "-- backlog (work queued) --"; grep -vE '^[[:space:]]*(#|$)' "$M/backlog" 2>/dev/null | head -3 ;;
    codex|worker)
      # YOUR queue only — filter the backlog to THIS worker's tasks (local:<role>|...), not the whole
      # backlog. Showing everyone's tasks as "your queue" let codex read a gemini task as its own.
      myq="$(grep "^local:$role|" "$M/backlog" 2>/dev/null | head -4)"
      echo "-- backlog (your queue: $role) --"; [ -n "$myq" ] && printf '%s\n' "$myq" || echo "  (nothing queued for $role — pull from the board or discover)"
      echo "-- ideas open --"; grep -E '^\[ \]' "$M/ideas-queue" 2>/dev/null | head -4
      echo "-- feed (last assignments) --"; tail -3 "$M/feed.log" 2>/dev/null
      echo "-- pump engine (generate) --"; tail -2 "$M/generate.log" 2>/dev/null ;;
    minds)
      # ALL-MINDS state — the data the 'minds' channel observes (its bottom pane is the reviver loop).
      # This window is FOR mind-orchestration, so its data pane carries everything that job needs:
      # who's free, what's unclaimed, and where the compute is going (operator 2026-06-15: a window's
      # data pane should hold all that matters for what the window is FOR).
      echo "-- this node: live pane state per mind channel --"
      mesh-mind-state --watch 2>/dev/null | grep -vE 'would alert' | head -8
      echo "-- allocation: idle hands & unclaimed work (mesh-dispatch) --"
      timeout 6 mesh-dispatch --status 2>/dev/null | grep -E 'idle workers|open tasks|  - ' | head -6
      echo "-- spend: where compute goes, paid vs free (mesh-spend) --"
      timeout 6 mesh-spend --by-provider 2>/dev/null | grep -E 'PAID|->|free|paid' | head -4
      echo "-- peer mind-watch (phi-accrual verdicts) --"
      for f in "$M"/.mind-watch-state/*.state; do
        [ -f "$f" ] || continue
        printf '  %-28s %-6s age %s\n' "$(basename "$f" .state)" "$(head -c12 "$f" 2>/dev/null)" "$(age_of "$f")"
      done
      echo "-- mesh-wide: which minds exist where --"
      mesh-minds 2>/dev/null | head -8 ;;
    dev)
      # the AUTONOMOUS DEVELOPMENT loop in one view: ideas → pump → minds → landed/stranded
      echo "$(stress_line)"   # dev mind asked for thermal — heat is what throttles a coding mind
      # dev-pane reply 2026-06-15 ([data-pane]: cost line useless @ $0 free tier) — show what a coding
      # mind ACTUALLY needs: which relay pools are live, quota burn this 5h window, how many minds are stuck.
      echo "relay: $(timeout 6 mesh-relay --status 2>/dev/null | awk -F: 'NF>=2{gsub(/ /,"",$1);printf "%s ",$1}')| spend(5h): $(timeout 4 mesh-spend 2>/dev/null | awk '$NF ~ /^[0-9]+$/{t+=$NF} END{print t+0}')t | blocked-minds: $(grep -lE 'BLOCKED|RATE-LIMITED|NEEDS-INPUT|DEAD' "$M"/.mind-state-* 2>/dev/null | wc -l)"
      td=$(date -u +%F); echo "board today (real work — minds PULL from here; ideas/backlog pump RETIRED 2026-06-13, empty=normal): [task] $(grep "$td" "$M/chat.log" 2>/dev/null | grep -c '\[task\]') taking $(grep "$td" "$M/chat.log" 2>/dev/null | grep -c '\[taking\]') done $(grep "$td" "$M/chat.log" 2>/dev/null | grep -c '\[done\]')"
      echo "-- open ideas (next fuel) --"; grep -E '^\[ \]' "$M/ideas-queue" 2>/dev/null | head -4
      echo "-- last assignments (feed) --"; tail -3 "$M/feed.log" 2>/dev/null
      echo "-- pump engine (generate) --"; tail -3 "$M/generate.log" 2>/dev/null
      echo "-- queue-tend (anti-dup reconcile) --"; tail -2 "$M/queue-tend.log" 2>/dev/null
      echo "-- landed (review these) --"; git -C "$REPO" --no-pager log --oneline -4 2>/dev/null
      echo "-- stranded/uncommitted (mesh-land tends) --"; git -C "$REPO" status --short -- scripts/ knowledge/ 2>/dev/null | head -5 ;;
    reflexes)
      # SELF-TEND view: vitals (temp = this fleet's known failure mode) + every reflex's liveness
      echo "-- vitals --"; mesh-vitals 2>/dev/null | head -2
      echo "-- therm edges (last 2) --"; tail -2 "$M/therm.log" 2>/dev/null
      echo "-- supervised loops --"; mesh-supervise --status 2>/dev/null | head -16
      echo "-- crontab vs desired --"; mesh-reflexes --check 2>&1 | tail -2
      echo "-- edge states (every reflex, re-derived live) --"; state_wall
      echo "-- beats (per-run liveness: self, peers, reflexes) --"; beat_wall ;;
    sense)
      # the PERCEPTION channel — operator 2026-06-13: merge the 4 mon:* streams + body senses into
      # ONE rich window with a mind that reacts to what's happening around the body. All re-observed
      # live (perceive-anew), nothing stored.
      echo "-- where (cross-node BLE space-map: device | nearest node | rssi self/peer) --"
      if [ -n "${BLE_PEER:-}" ]; then
        timeout 24 mesh-presence-fuse "$BLE_PEER" 2>/dev/null | grep 'imozerov-\|Redmi\|Default-string' | grep -F '|' | head -6 \
          || { echo "  (cross-node fusion: peer slow/unreachable — local proximity:)"; timeout 10 mesh-presence 2>/dev/null | head -4; }
      else
        echo "  (single BLE vantage — proximity to $(hostname) only; add a 2nd BLE node for a map)"; timeout 12 mesh-presence 2>/dev/null | head -5 || echo "  (scan timeout)"
      fi
      echo "-- body activity (the phone) --"; timeout 12 mesh-body-motion 2>/dev/null | head -1 || echo "  (phone unreachable)"
      echo "-- ambient light --"; timeout 12 mesh-light --status 2>/dev/null | head -1 || echo "  (phone unreachable)"
      echo "-- novelty (surprising board events) --"; mesh-novelty --threshold 3.5 2>/dev/null | head -3
      echo "-- presence trends (residents/arrivals) --"; mesh-presence-trends 2>/dev/null | head -3
      echo "-- streams (last fed to minds) --"; tail -3 "$M/stream.log" 2>/dev/null ;;
    discover)
      # capability-research view: what's WIRED vs AVAILABLE-but-unwired — the exploration frontier
      echo "mission: ~/.mesh/discover-mission.md | drop finds → ~/.mesh/knowledge/"
      echo "-- organs WIRED across the fleet --"; mesh-organs 2>/dev/null | sed -n '4,12p'
      echo "-- phone: termux-* surface (wired vs total) --"
      _ph="${PHONE_USER:-u0_a386}@${PHONE_IP:-$(mesh-peer-addr Redmi 2>/dev/null)}"
      tot=$(timeout 8 ssh -p 8022 -o ConnectTimeout=5 -o BatchMode=yes -o StrictHostKeyChecking=no "$_ph" 'ls $PREFIX/bin/termux-* 2>/dev/null | wc -l' </dev/null 2>/dev/null)
      echo "  termux commands present: ${tot:-unreachable} | wired: voice location battery (3)"
      echo "-- recent capability finds (knowledge/) --"
      ls -t "$HOME/lte-workstation/knowledge"/*capab* "$HOME/.mesh/knowledge"/*capab* 2>/dev/null | head -3 | sed 's|.*/|  |'
      echo "-- last discover [done] on the board --"
      grep -E 'discover|capabilit|termux|organ' "$M/chat.log" 2>/dev/null | tail -3 | cut -c1-100 ;;
    organs)
      # what the mesh IS (nodes/minds/egress) + what it CAN (senses/actuators) — fleet-wide
      mesh-fleet-health 2>/dev/null
      echo; mesh-organs 2>/dev/null
      echo; mesh-fleet-states 2>/dev/null   # every node's edge-reflex states, re-derived live
      echo; echo "-- connectivity offered (this node) --"
      grep -A4 '^capabilities:' "$HOME/.mesh-card" 2>/dev/null | head -6 ;;
    tg)
      # the OPERATOR CHANNEL's own health + traffic — in (voice-rx), routing (textin), watchdog
      echo "voice-rx $(pgrep -f 'mesh-voice-rx' >/dev/null 2>&1 && echo UP || echo DOWN) | tg-watchdog: $(head -c12 "$M/.dsTG-state" 2>/dev/null || echo '?') | last-in age $(age_of "$M/voice-in.log") | textin-offset age $(age_of "$M/.textin-offset")"
      echo "-- operator IN (voice-in.log, last 8) --"; tail -8 "$M/voice-in.log" 2>/dev/null
      echo "-- textin routing (last 4) --"; tail -4 "$M/textin.log" 2>/dev/null ;;
    *)
      echo "-- node card --"; head -12 "$HOME/.mesh-card" 2>/dev/null ;;
  esac
  [ "$ONCE" = 1 ] && exit 0
  sleep "$SLEEP"
done
