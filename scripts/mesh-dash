      # so require argv[1] to be a python binary and the script to be one of the lane's runners.
      _wjl="$(pgrep -af 'wake/(train_fold|train_lora|train_scratch|make_folds|make_samples|condent|recut_windows)\.py' 2>/dev/null \
              | awk '$2 ~ /python[0-9.]*$/')"
      _wjn="$(printf '%s' "$_wjl" | grep -c . 2>/dev/null)"
      case "${_wjn:-}" in ''|*[!0-9]*) _wjn=0 ;; esac
      _wg="$(timeout 4 nvidia-smi --query-gpu=utilization.gpu,memory.used --format=csv,noheader 2>/dev/null | head -1)"
      _wg="${_wg:-UNKNOWN (nvidia-smi did not answer — blind, not idle)}"
      if [ "${_wjn:-0}" -gt 0 ]; then
        echo "-- RUN IN FLIGHT ($_wjn proc): $(printf '%s\n' "$_wjl" | head -1 | clip 96) · GPU $_wg --"
      else
        echo "-- no lane run in flight (no wake/*.py process) · GPU $_wg --"
      fi
      # THE MEASUREMENT and THE TRAINING, side by side and deliberately NOT ranked together: on this
      # lane val loss is an ANTI-selector (it ranked the worse model higher three times running), so
      # the two blocks must never be folded into one "best model" verdict.
      python3 -c "
import json,os,glob,statistics,time
import statistics as st
W=os.path.expanduser('~/finnegans-fake/wake')
def sig(path):
    # SIGNAL/novel per window, read straight from the record: (none-own) - (none-foreign) collapses
    # to foreign_npc - own_npc, on the tokens the fold does NOT quote. Derived here instead of by
    # importing wake/condent.py so the refresh loop never drags torch into the pane.
    d=json.load(open(path)); recs=d['records'] if isinstance(d,dict) else d
    out={}
    for r in recs:
        c=r.get('cond',{})
        try: o=c['own']['novel']['npc']; f=c['foreign']['novel']['npc']
        except Exception: continue
        if o is None or f is None: continue
        out[r['name'].split('/')[-1]]=f-o
    return out,(d.get('budget') if isinstance(d,dict) else None)
def agg(v):
    if not v: return None
    m=statistics.mean(v); sem=(statistics.stdev(v)/len(v)**.5) if len(v)>1 else 0.0
    return m,sem,sum(1 for x in v if x>0),len(v)
def fmt(a):
    if not a: return 'n/a'
    return '%+.4f +/- %.4f (%.1f sem)'%(a[0],a[1],(a[0]/a[1]) if a[1] else 0.0)
runs={}
for p in sorted(glob.glob(W+'/recs-*.json')):
    try: v,b=sig(p); runs[os.path.basename(p)[5:-5]]=(v,b,os.path.getmtime(p))
    except Exception as e: print('  recs %s UNREADABLE: %s'%(os.path.basename(p),e))
print('SCORED RUNGS -- SIGNAL/novel nats/char on tokens the fold does NOT quote; budget-matched, foreign-summary control subtracted.')
if not runs:
    print('  NO SCORED RUNS on disk (wake/recs-*.json absent). The measurement surface is MISSING,')
    print('  which is not the same claim as a null result -- do not read this as \"training did nothing\".')
else:
    base=runs.get('model',({},None,0))[0]
    print('  %-12s %6s %4s  %-24s %s'%('rung','budget','n','SIGNAL/novel','paired vs untrained base'))
    rows=[]
    for k,(v,b,mt) in runs.items():
        a=agg(list(v.values()))
        pr=agg([v[w]-base[w] for w in sorted(set(v)&set(base))]) if (base and k!='model') else None
        rows.append(((-a[0]) if a else 9.0,k,a,b,pr,mt))
    lead=None; srt=sorted(rows); shown=0; RCAP=4
    for _,k,a,b,pr,mt in srt:
        if lead is None and k!='model': lead=(k,runs[k][0])
        # cap the table but NEVER silently: a pane that grows a row per scored rung eventually
        # pushes its own top off a fixed pane, and a hidden row reads exactly like an absent one
        if shown>=RCAP and k!='model':
            continue
        shown+=1
        age=(time.time()-mt)/3600.0
        s='n/a' if not a else '%+.4f +/- %.4f (%d/%d)'%(a[0],a[1],a[2],a[3])
        print('  %-12s %6s %4s  %-24s %-28s scored %.0fh ago'%(k,b if b else '?',(a[3] if a else 0),s,(fmt(pr) if pr else '-- this IS the base --'),age))
    _hid=len([1 for _,k,_,_,_,_ in srt if k!='model'])-min(RCAP,len([1 for _,k,_,_,_,_ in srt if k!='model']))
    if _hid>0: print('  ... %d further rung(s) scored and NOT shown (ranked below these) -- wake/recs-*.json has all of them'%_hid)
    # THE GATE the lane actually turns on: paired against the leading rung, window by window. Two
    # aggregates compared is not this number -- the windows differ enormously in how much signal any
    # fold can carry, and the pairing is what makes a 0.003 nats/char difference readable at all.
    # THE NOISE FLOOR, measured on this lane rather than assumed: rungs that share an n_train are
    # independent trainings of the same rows, so the spread of their aggregates is how much of any
    # gap is the training draw. Without it a 0.002 difference reads as a result -- and it is not:
    # four trainings of the same 144 rows gave a verdict whose RANGE exceeded its own error bar.
    # The variant->adapter link is the lane's naming convention (ftNNN[x]-eK <-> fold-lora-NNN[x]);
    # a rung whose adapter cannot be resolved is left out rather than guessed into a group.
    fam={}
    for k in runs:
        stem=k[2:].rsplit('-e',1)[0] if k.startswith('ft') else None
        tl=(W+'/fold-lora-'+stem+'/trainlog.json') if stem else None
        if not tl or not os.path.exists(tl): continue
        try: n=json.load(open(tl)).get('n_train')
        except Exception: continue
        a=agg(list(runs[k][0].values()))
        # keyed by (rows, EPOCH): two epochs of one training are the same run read twice, not two
        # runs, and folding them in would inflate the floor with a within-run difference
        if a: fam.setdefault((n,k.rsplit('-e',1)[-1]),[]).append((k,a[0]))
    floors=[(nk,v) for nk,v in sorted(fam.items()) if len(v)>1]
    if len(floors)>2:
        print('  %d replicate families measured; showing the 2 largest (the rest: run the paired.py line in the results doc)'%len(floors))
        floors=sorted(floors,key=lambda x:-len(x[1]))[:2]
    if floors:
        for (n,ep),v in floors:
            # re-mean each member over the windows the WHOLE family scored. Members drop different
            # windows when a fold falls below the shared budget, and a spread computed over
            # different window sets books that difference as training noise, which it is not.
            sh=set.intersection(*[set(runs[k][0]) for k,_ in v])
            v=[(k,statistics.mean([runs[k][0][w] for w in sorted(sh)])) for k,_ in v]
            ms=[m for _,m in v]; sd=st.stdev(ms); rng=max(ms)-min(ms)
            # keep this ONE line: a line longer than the pane wraps, and a wrapped line eats a second
            # row, which would break the frame ceiling from a direction the line count cannot see.
            # So the member list is capped and the overflow COUNTED, never silently cut.
            _mem=' '.join('%s %+.4f'%(k.replace('-e'+ep,''),m) for k,m in v[:5])
            if len(v)>5: _mem+=' (+%d more)'%(len(v)-5)
            print('  floor: %dx %s rows @ep%s (%d win) sd %.4f range %.4f | %s'%(len(v),n,ep,len(sh),sd,rng,_mem))
        print('    a gap smaller than a family range there is the training draw, not a result.')
    else:
        print('  noise floor UNMEASURED: no rung here has been trained twice, so nothing on this')
        print('    lane says how much of a 0.002 gap is the training draw. Train one twice.')
    if lead:
        lk,lv=lead; parts=[]
        for k,(v,b,mt) in sorted(runs.items()):
            if k in (lk,'model'): continue
            pr=agg([v[w]-lv[w] for w in sorted(set(v)&set(lv))])
            if not pr: continue
            verdict='INSIDE its own error bar' if abs(pr[0])<2*(pr[1] or 1e9) else ('BEATS it' if pr[0]>0 else 'LOSES to it')
            parts.append('%s %s -> %s'%(k,fmt(pr),verdict))
        if parts:
            # the leader is ONE TRAINING unless said otherwise, and a difference against a single
            # draw carries that draw's noise: the published 47 rung sat 1.9 replicate sd above its
            # own siblings, and every 144-vs-47 verdict on this lane was measured against it.
            _lf=[f for f in floors if lk in [k for k,_ in f[1]]]
            _ln=(' [leader is 1 of %d trainings of its rows, family mean %+.4f -- these gaps carry ITS draw too]'%(
                 len(_lf[0][1]),statistics.mean([m for _,m in _lf[0][1]]))) if _lf else ' [leader is ONE training; its own spread is unmeasured]'
            print('  gate, paired vs the leader %s%s:%s'%(lk,'' if len(parts)<=2 else ' (extremes of %d)'%len(parts),_ln))
            for p in (parts if len(parts)<=2 else [parts[0],parts[-1]]): print('    '+p)
try: _tfn=len(json.load(open(W+'/teacher-folds.json')))
except Exception: _tfn=None
print('TRAINED ADAPTERS -- from each wake/fold-lora-*/trainlog.json; teacher corpus %s hand-written folds.'%(
    _tfn if _tfn is not None else 'UNKNOWN (teacher-folds.json unreadable)'))
print('  !! VAL LOSS IS AN ANTI-SELECTOR HERE -- it has ranked the worse model higher four times, most')
print('     recently between replicates differing in nothing but the draw. Select by the table above.')
ads=sorted(glob.glob(W+'/fold-lora-*/trainlog.json'))
if not ads:
    print('  no trainlog.json under wake/fold-lora-* -- no adapter has been trained here yet')
ACAP=4
ads_show=sorted(ads,key=lambda q:-os.path.getmtime(q))[:ACAP]
if len(ads)>len(ads_show):
    print('  showing the %d most recently trained of %d adapters on disk (older ones: wake/fold-lora-*/)'%(len(ads_show),len(ads)))
for p in sorted(ads_show):
    try: t=json.load(open(p))
    except Exception as e: print('  %s UNREADABLE: %s'%(p,e)); continue
    a=t.get('args',{}); h=t.get('history',[])
    v=' '.join('ep%d %.4f'%(x.get('epoch',i+1),x.get('val',float('nan'))) for i,x in enumerate(h))
    print('  %-16s n_train=%-4s rank=%-3s seed=%-3s lr=%-7s | val %s | %.0fh ago'%(
        os.path.basename(os.path.dirname(p)),t.get('n_train','?'),a.get('rank','?'),a.get('seed','?'),
        a.get('lr','?'),v or 'no history',(time.time()-os.path.getmtime(p))/3600.0))
seeds=set(); ranks=set()
for p in ads:
    try: a=json.load(open(p)).get('args',{})
    except Exception: continue
    seeds.add(a.get('seed')); ranks.add(a.get('rank'))
print('  NOTE: before 2026-08-18 that seed field controlled only WHICH ROWS were drawn (torch was never')
print('  seeded here), so an adapter older than that is not a replicate of anything -- read the ages.')
if ads and len(seeds)==1 and len(ranks)==1:
    print('  every adapter above shares seed=%s rank=%s -- one seed, one rank, so the run-to-run spread'%(list(seeds)[0],list(ranks)[0]))
    print('  is still unmeasured and no gap smaller than it can be believed.')
" 2>&1 | clip 160
      echo "-- wake on the board (its own last lines — the lane's record of what is open) --"
      grep -E '^\S+\s+wake@' "$M/chat.log" 2>/dev/null | tail -2 | clip 150 | sed 's/^/  /' ;;

    *)
      echo "-- node card --"; head -12 "$HOME/.mesh-card" 2>/dev/null ;;
  esac
  )"
  # ── THE ROW IS THE UNIT, SO THE ROW IS WHAT GETS BOUND ────────────────────────────────────────
  # The check frame is the one this node's health mind reads and the one the ceiling gate counts,
  # and its 10 over-wide rows (82…187 columns) are what made 34 lines paint 46 rows. Bind the
  # ASSEMBLED row here, after every field-level clip has had its say — that is the only place the
  # total is known. clip marks what it cuts, so an overflowing row can no longer masquerade as a
  # line that ended, and the prose trims below this in the check body are what keep the cut landing
  # on legend rather than on measurements. Scoped to check on purpose: adint deliberately renders
  # 150-column board quotes and gates its own WRAPPED rows (≤11) instead — that is a different
  # bargain, honestly accounted, and a blanket clip here would silently change it.
  [ "$role" = check ] && frame="$(printf '%s\n' "$frame" | clip "$_PANE_COLS")"
  [ "$ONCE" = 1 ] || clear
  printf '%s\n' "$frame"
  # OVERFLOW LEASE: a pane paints a tall frame's TAIL, so a frame taller than the pane silently hides
  # its top — and a hidden section is indistinguishable from an absent one. That is exactly how the
  # check pane broke (156-line frame into 27 rows: the health mind saw only the alphabetical tail of
  # the state wall and NONE of fleet/doctor/vpn/vitals/GPU, every one of them rendering fine, all
  # invisible). No silent caps: if the frame does not fit, the pane SAYS how many lines went off the
  # top, right next to the liveness footer — the one place a tall frame is always visible.
  # ROWS, NOT LINES (2026-08-19): this lease counted lines while the pane it warns about paints
  # rows, so a frame of wide rows overflowed a pane and the lease that exists to SAY SO stayed
  # silent — the same half-implemented arithmetic as the ceiling gate, in the one place the mind
  # would have been told. A wide row is exactly the case where the top scrolls away fastest.
  if [ "$ONCE" != 1 ] && [ "${_PANE_ROWS:-0}" -gt 0 ]; then
    _fl="$(printf '%s\n' "$frame" | rows_of "$_PANE_COLS")"
    case "${_fl:-}" in ''|*[!0-9]*) _fl=0 ;; esac
    # +2 = this warning row and the liveness footer below it, both in the same viewport
    [ "$_fl" -gt 0 ] && [ $(( _fl + 2 )) -gt "$_PANE_ROWS" ] && \
      # …AND THE WARNING ITSELF FITS. At 158 characters it painted THREE rows of the very pane it
      # was reporting as too small — on the live 11-row health pane, a quarter of the viewport
      # spent on the sentence saying the viewport is full.
      printf -- '-- ⚠ OVERFLOW: %s rows @%sc into %s — %s hidden ABOVE (trim role / grow pane) --\n' \
        "$_fl" "$_PANE_COLS" "$_PANE_ROWS" "$(( _fl + 2 - _PANE_ROWS ))"
  fi
  # VISIBLE renderer-lease footer (liveness-lease PART-3 mech-1): the top header date scrolls OFF a
  # frame taller than the pane, so the only ALWAYS-visible spot is the BOTTOM (the viewport shows a tall
  # frame's tail). This line re-stamps date -u EVERY frame → it ticks while the loop lives and FREEZES the
  # instant it dies = "dead at a glance" for a human AND the signal mesh-pane-watch's viewport capture
  # needs (a quiet-data pane like tg has a static body but this footer still advances → no false-frozen).
  # WAS 115 COLUMNS, 53 of them the sentence explaining what the stamp means — two rows spent
  # every frame to say one thing, inside the row budget the ceiling gate is fighting over. The
  # explanation belongs here: this line re-stamps date -u each frame, so it ADVANCES while the
  # loop lives and FREEZES the instant it dies. `ticks every frame` is kept verbatim because
  # mesh-pane-consume and mesh-loop-baton strip this line by that phrase.
  printf -- '-- pane live %s · refresh %ss · ticks every frame --\n' "$(date -u +%FT%TZ)" "$SLEEP"
  [ "$ONCE" = 1 ] && exit 0
  sleep "$SLEEP"
done
