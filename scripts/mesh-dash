    tags=' '.join(t.replace('tag:','') for t in (p.get('Tags') or []))
    bits=[]
    if p.get('ExitNodeOption'): bits.append('EXIT-NODE')
    if not p.get('_self'): bits.append('up'+humb(p.get('TxBytes'))+' dn'+humb(p.get('RxBytes')))
    if tags: bits.append(tags)
    extra=' '.join(bits)
    print('   %-18s %-15s %-7s %-22s %s'%(nm,ip0,os0,conn,extra))
for p in off:
    nm=(p.get('HostName') or '?')[:18]
    ip0=(p.get('TailscaleIPs') or ['?'])[0]
