#!/usr/bin/env bash
# mesh-dash <role> — renders the live DATA text for a channel's TOP pane (data = text, self-refreshing).
# Pairs with a mind in the bottom pane (the channel pattern: top data, bottom mind). All text.
# PERCEIVE-ANEW: every frame is re-derived from live state — reflex edge-artifacts, beats, logs,
# git — never a stored summary. The generic walls (state_wall/beat_wall/mind_wall) enumerate
# whatever artifacts EXIST, so a new reflex shows up in the pane without editing this dash.
# ROLE-SPECIFIC by operator request: the board lives in the chat window ONLY — no dash tails chat.log.
#   roles: steward | check | verify | codex/worker | minds | dev | reflexes | organs | tg | models | <other> (node card)
# test-fast: yes
# THE FULL SUITE IS LONGER THAN EVERY RUNNER'S CAP ON THIS NODE, so it declares a FAST CORE.
# Measured 2026-08-19: `--test` = 68-90s (29 one-frame renders; the `check` role alone is ~14s live
# and ~3.4s per fixture-HOME leg). mesh-doctor's parallel storm grants `timeout 12` and its serial
# confirm grants 60s, so the doctor could only ever TIME OUT on this file — and did, every hourly
# pass, in silence, until one of those timeouts landed at queue position 1 and was stamped
# 'smoke-test FAIL (real): mesh-dash' (18:23:01Z) on a suite that is rc=0 by hand. A gate no runner
# can reach is not a gate. So: `--test-fast` runs the cheap prefix (~4s, under the 12s cap) and is
# what the doctor drives; `--test` stays the WHOLE suite and is what mesh-land runs at landing under
# its 180s per-candidate budget — the strong claim is not weakened, it is given the runner that can
# afford it. Keep the split honest in BOTH directions: a new cheap gate belongs above the boundary,
# and if the fast core ever outgrows 12s the doctor is blind again (the boundary gate below measures
# it). task:doctor-stamps-a-timeout-as-a-confirmed-fail-and-only-queue-position-1-can-produce-it.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
# ONE name for the cached mesh-pace dispatch row: the minds frame writes/reads it and --test asserts
# from it, and $M is not bound until the role dispatch (below the --test block). A second spelling of
# this path would make the test's cache arm silently n/a forever the day the body's path changed.
PACE_CACHE="$HOME/.mesh/.pace-dispatch.cache"
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes" 2>/dev/null
# shared freshness idiom (render-layer lease, PART 3) — one lib so every pane ages values the same way;
# inline fallback so a missing lib never blanks the pane (degrade to visible UNKNOWN, never to blank).
_mf="$(command -v mesh-freshness 2>/dev/null)"; [ -n "$_mf" ] && . "$_mf" 2>/dev/null || true
command -v fresh_mark >/dev/null 2>&1 || fresh_mark(){ local f="$1" v="$2" ttl="${3:-1800}" a; [ -e "$f" ] || { echo "UNKNOWN (no data)"; return; }; a=$(( $(date +%s) - $(stat -c %Y "$f" 2>/dev/null || echo 0) )); [ -n "$v" ] || { echo "UNKNOWN (empty)"; return; }; [ "$a" -gt "$ttl" ] && echo "$v (${a}s STALE)" || echo "$v (${a}s)"; }
# BLE peer vantage for the cross-node presence MAP — resolved from the node-local registry, NEVER a
# hardcoded IP in the genome (that's how infra leaked before). First user@host that isn't self or a
# no-BLE VM/appliance. Perception windows draw from ALL nodes (operator: a window = the SUM of the
# whole mesh, not one node), so presence is a cross-node fusion, not a local scan.
BLE_PEER=""
for _tok in ${MESH_NODES:-}; do
  case "$_tok" in router:*|GL-MT3000:*|phaedra:*|ilya:*|ideapad:*|*:local) continue ;; esac
  case "${_tok#*:}" in *@*) BLE_PEER="${_tok#*:}"; break ;; esac
done
ONCE=0
if [ "${1:-}" = --test ] || [ "${1:-}" = --test-fast ]; then
  _T_FAST=0; [ "${1:-}" = --test-fast ] && _T_FAST=1
  # tmp fence — task:doctor-test-tmpdir-cleanup-traps. Re-exec the smoke test ONCE under a private
  # TMPDIR and remove it from the PARENT, so the cleanup cannot be lost to the test's own `exit 1`
  # and cannot be clobbered by an EXIT trap the test sets for itself. A nested --test inherits the
  # guard var and skips its own fence (it is already inside one).
  if [ -z "${MESH_TEST_TMPD:-}" ]; then
    MESH_TEST_TMPD="$(mktemp -d)" || { echo "smoke-test: FAIL (tmp fence: mktemp -d)"; exit 1; }
    trap 'rm -rf "$MESH_TEST_TMPD"' EXIT INT HUP TERM
    export MESH_TEST_TMPD TMPDIR="$MESH_TEST_TMPD" TMP="$MESH_TEST_TMPD" TEMP="$MESH_TEST_TMPD"
    _fence_rc=0; "$0" "$@" || _fence_rc=$?; exit "$_fence_rc"
  fi
  # a dash that paints a blank pane looks alive and informs nobody — so the smoke is a REAL
  # one-frame render (via --once), asserted on content, not an echo-ok
  for x in date git awk grep tail head printf stat; do
    command -v "$x" >/dev/null 2>&1 || { echo "smoke-test: FAIL (no $x)"; exit 1; }
  done
  out="$("$0" --once verify 2>&1)" || { echo "smoke-test: FAIL (verify render exited non-zero)"; exit 1; }
  printf '%s' "$out" | grep -q 'landed recently' || { echo "smoke-test: FAIL (verify frame missing its data block)"; exit 1; }
  # SOURCES REPORTS ARRIVAL, NOT THE MATERIAL'S OWN TIMESTAMP (2026-08-19). The archiver preserves
  # each record's mtime from its source file, so an operator drop of a month-old recording arrives
  # today carrying a month-old mtime. Sorting/aging that panel by mtime made it read "drop 15h35m
  # ago" at 09:53 while a drop had arrived, been archived and been ground at 08:16 — and the mind
  # reads this exact line to judge whether the operator has gone quiet. ctime is written by the
  # kernel when the file lands in the corpus and cannot be preserved by cp. Seen RED against %Y/ls -t.
  _sd="$(mktemp -d)"; mkdir -p "$_sd/records"
  : > "$_sd/records.log"
  printf 'x' > "$_sd/records/20260818-181752-drop-aaaaaaaa.wav"   # a genuinely older arrival
  touch -d '-9 hours' "$_sd/records/20260818-181752-drop-aaaaaaaa.wav"
  printf 'x' > "$_sd/records/20260718-100525-drop-bbbbbbbb.ogg"   # arrived NOW, month-old material
  touch -d '2026-07-18 10:05:25' "$_sd/records/20260718-100525-drop-bbbbbbbb.ogg"  # mtime old, ctime now
  _ss="$(MESH_DIR="$_sd" "$0" --once sound 2>&1 | grep -E '^  drop ')"
  rm -rf "$_sd"
  case "$_ss" in
    *"h"*"m ago"*) echo "smoke-test: FAIL (SOURCES aged a just-arrived drop by its MATERIAL's mtime — a month-old recording dropped now must read as minutes, got: $_ss)"; exit 1 ;;
    *"m ago"*) : ;;
    *) echo "smoke-test: FAIL (SOURCES drop row rendered no age at all — got: '$_ss')"; exit 1 ;;
  esac

  # A NON-ZERO VERDICT IS A VERDICT, NOT A FAILURE (2026-08-19). `mesh-room-music --diversity`
  # exits 1 to MEAN SOURCE-STARVED/MONOTONE. Piping it under `set -o pipefail` turned that into a
  # pipeline failure, so the `|| echo 'diversity UNKNOWN'` fired ON TOP of the verdict already
  # printed — the header both asserted and denied a verdict, and orphaned its ` --` terminator onto
  # the next line. Drive the real sound frame with a stub `mesh-room-music` on PATH that exits 1
  # exactly as the real one does. Seen RED against the piped form.
  _pd="$(mktemp -d)"; mkdir -p "$_pd/bin" "$_pd/mesh/records"; : > "$_pd/mesh/records.log"
  printf '#!/bin/sh\necho "diversity: SOURCE-STARVED — ear is 7/7 of last 7 lane render(s)"\nexit 1\n' > "$_pd/bin/mesh-room-music"
  chmod +x "$_pd/bin/mesh-room-music"
  _pr="$(PATH="$_pd/bin:$PATH" MESH_DIR="$_pd/mesh" "$0" --once sound 2>&1 | grep -c '^diversity UNKNOWN')"
  [ "$_pr" -eq 0 ] \
    || { rm -rf "$_pd"; echo "smoke-test: FAIL (a non-zero --diversity verdict rendered an extra 'diversity UNKNOWN' line — the header asserts a verdict and denies it in the same breath; capture the output, never pipe an exit-code-carrying verdict under pipefail)"; exit 1; }
  _ph="$(PATH="$_pd/bin:$PATH" MESH_DIR="$_pd/mesh" "$0" --once sound 2>&1 | grep '^-- RENDERS')"
  case "$_ph" in
    *"SOURCE-STARVED"*" --") : ;;
    *) rm -rf "$_pd"; echo "smoke-test: FAIL (the RENDERS header must carry the verdict AND keep its own terminator on one line — got: $_ph)"; exit 1 ;;
  esac
  rm -rf "$_pd"

  # AN EMPTY SOUNDSCAPES BLOCK MUST NOT READ AS A DEAD SCANNER (2026-08-19). Only finds scoring
  # >= SS_LOG_FLOOR reach soundscape.log, so "no lines" collapses quiet-room, below-floor and dead
  # into one appearance. The tick is touched on every eval, so its age is what separates them.
  _td="$(mktemp -d)"; mkdir -p "$_td/records"; : > "$_td/records.log"
  touch "$_td/.soundscape-tick"
  _t1="$(MESH_DIR="$_td" "$0" --once sound 2>&1 | grep '^-- SOUNDSCAPES')"
  case "$_t1" in
    *"last scan"*) : ;;
    *) rm -rf "$_td"; echo "smoke-test: FAIL (SOUNDSCAPES header carries no scan age — an empty block then reads as a dead scanner; got: $_t1)"; exit 1 ;;
  esac
  case "$_t1" in
    *"is logged, so no line != no sound"*) : ;;
    *) rm -rf "$_td"; echo "smoke-test: FAIL (SOUNDSCAPES header must name the log floor — without it an empty block reads as silence; got: $_t1)"; exit 1 ;;
  esac
  # …and a MISSING tick must say so, never render as a fresh or absent age.
  rm -f "$_td/.soundscape-tick"
  _t2="$(MESH_DIR="$_td" "$0" --once sound 2>&1 | grep '^-- SOUNDSCAPES')"
  case "$_t2" in
    *"UNKNOWN (no tick artifact)"*) : ;;
    *) rm -rf "$_td"; echo "smoke-test: FAIL (a missing tick must render UNKNOWN, not an age — an absent artifact is not a measurement; got: $_t2)"; exit 1 ;;
  esac
  rm -rf "$_td"

  out="$("$0" --once card-fallback 2>&1)" || { echo "smoke-test: FAIL (fallback render exited non-zero)"; exit 1; }
  printf '%s' "$out" | grep -q 'node card' || { echo "smoke-test: FAIL (fallback frame missing node card)"; exit 1; }
  # THE FUSED WITNESS PANE MUST CARRY BOTH HALVES (chat→witness merge, 2026-07-24). A merge that
  # silently renders one half is exactly how a lane dies green: the mind keeps working, the surface
  # it needs is simply gone, and nothing anywhere says so. Asserted on a REAL one-frame render.
  _w="$("$0" --once witness 2>&1)" || { echo "smoke-test: FAIL (witness render exited non-zero)"; exit 1; }
  printf '%s' "$_w" | grep -q 'board churn' \
    || { echo "smoke-test: FAIL (fused witness frame lost its BOARD half — the merged mind's coordination surface is gone)"; exit 1; }
  if command -v mesh-witness >/dev/null 2>&1; then
    printf '%s' "$_w" | grep -q 'self-measurement ledger' \
      || { echo "smoke-test: FAIL (fused witness frame lost its TAPE half — mesh-witness is installed, so this is a regression, not honest absence)"; exit 1; }
  else
    printf '%s' "$_w" | grep -q 'mesh-witness NOT INSTALLED' \
      || { echo "smoke-test: FAIL (mesh-witness absent, yet the tape half neither renders nor SAYS it is unavailable — a missing half must announce itself, never just vanish)"; exit 1; }
  fi
  # exactly ONE pane-live footer: the tape half is embedded (--embed) precisely so the pane carries a
  # single liveness lease. Two footers and a frozen render is unreadable — which one died?
  _pl="$(printf '%s\n' "$_w" | grep -c 'pane live')"
  [ "$_pl" = 1 ] || { echo "smoke-test: FAIL (fused witness frame has $_pl pane-live footers, want exactly 1 — the tape half must be rendered with --embed)"; exit 1; }
  # THE MEMORY-CORPUS METER MUST NOT ANSWER BY THE PANE'S CWD. mesh-memory-recall resolves its
  # corpus as CLAUDE_PROJECT_SLUG or, absent it, "-" + cwd — so before the pin, witness.0 (cwd $HOME)
  # rendered 12 memories / 42% opened off a near-miss corpus while witness.1 read 607 / 22% the same
  # second. Driven as a REAL render FROM $HOME (the cwd that produced the wrong answer) with a cold
  # private cache, so the pin is exercised, not grepped: unpinned, this leg reads $HOME's own corpus
  # name. Skipped when the tool is absent, and n/a-tolerant (a node with no corpus prints the
  # "no recall meter yet" line, which is honest and carries no corpus name to check).
  if command -v mesh-memory-recall >/dev/null 2>&1; then
    # $0 must be absolute BEFORE the cd, or the leg silently renders nothing and reads as a broken
    # meter (measured: a relative $0 turned this gate into a false FAIL on its first run).
    _self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
    _mcorp="$(cd "$HOME" && MESH_MEMRECALL_CACHE="$MESH_TEST_TMPD/memrecall.cache" \
      "$_self" --once witness 2>&1 | grep -m1 '^  corpus ' | awk '{print $2}')"
    _wantcorp="-$(printf '%s' "${HOME#/}/lte-workstation" | tr '/' '-')"
    if [ -n "$_mcorp" ]; then
      [ "$_mcorp" = "$_wantcorp" ] || { echo "smoke-test: FAIL (memory-corpus meter rendered from \$HOME named corpus '$_mcorp', want '$_wantcorp' — the meter is answering by the DATA pane's cwd again, and a near-miss corpus reads as a plausible, flattering number)"; exit 1; }
    else
      printf '%s' "$("$0" --once witness 2>&1)" | grep -q 'no recall meter yet' \
        || { echo "smoke-test: FAIL (memory-corpus block rendered neither a named corpus nor the honest 'no recall meter yet' line — a meter whose subject varies by caller must name its subject in every rendering)"; exit 1; }
    fi
  fi
  # `chat` is an ALIAS of the merged role, not a dead name: tmux is append-only, so a pre-merge chat
  # window keeps rendering until reboot and must show the merged surface — never fall through to the
  # generic node-card fallback, which would look like a fine pane while showing none of its data.
  _c="$("$0" --once chat 2>&1)"
  printf '%s' "$_c" | grep -q 'board churn' \
    || { echo "smoke-test: FAIL (role 'chat' no longer renders the merged surface — a surviving pre-merge pane would silently degrade to the card fallback)"; exit 1; }
  # THE WAKE PANE MUST BE A REAL ARM, NOT THE CARD FALLBACK. `wake` ran for days as a HAND-PLANTED
  # window with no arm here, so its top pane rendered the node card while the mind re-derived the
  # training state by hand every turn — a pane that looks fine and carries nothing the window is for.
  # Asserted on markers that render on ANY node, including one with no ~/finnegans-fake at all (the
  # block headers and the anti-selector warning are unconditional): this gate must report the CODE,
  # never the node it happens to run on.
  _wk="$("$0" --once wake 2>&1)" || { echo "smoke-test: FAIL (wake render exited non-zero)"; exit 1; }
  printf '%s' "$_wk" | grep -q 'node card' \
    && { echo "smoke-test: FAIL (role 'wake' fell through to the generic node-card fallback — the lane's data pane is gone and the window looks healthy)"; exit 1; }
  printf '%s' "$_wk" | grep -q 'SCORED RUNGS' \
    || { echo "smoke-test: FAIL (wake frame lost its SCORED RUNGS block — the measured content signal IS what the lane exists to produce)"; exit 1; }
  printf '%s' "$_wk" | grep -q 'VAL LOSS IS AN ANTI-SELECTOR' \
    || { echo "smoke-test: FAIL (wake frame lost the val-loss anti-selector warning — val loss ranked the worse model higher three times on this lane, so a val column printed without it is a trap)"; exit 1; }
  # AND IT MUST FIT. Every block here grows with the lane's work — a row per scored rung, a row
  # per trained adapter, three lines per replicate family — and a pane shows a tall frame's TAIL,
  # so unbounded growth silently deletes the top of the pane (the check frame, 156 lines into 27
  # rows, is the worked example). Each of those blocks is capped and SAYS what it dropped, which
  # makes this ceiling a claim about the CODE rather than about how much work the lane has done.
  # NOTHING MAY SIT EXACTLY ON THE 160-COLUMN CUT. The python block pipes through `clip 160`,
  # which truncates in silence — the two noise-floor lines rendered at exactly 160 and were losing
  # their last member's value while reading as complete. A line at the cut is the signature, so
  # assert no line has that length: content that long must be shortened or counted, not sliced.
  printf '%s\n' "$_wk" | awk 'length($0)==160{exit 1}' \
    || { echo "smoke-test: FAIL (a wake frame line is exactly 160 chars — that is the clip 160 truncation signature, and a measurement line losing its tail still reads as complete)"; exit 1; }
  _wkl="$(printf '%s\n' "$_wk" | wc -l)"
  [ "$_wkl" -le 36 ] || { echo "smoke-test: FAIL (wake frame is $_wkl lines against a 36-line ceiling — a data pane is ~40 rows, so the top scrolls away while every line renders perfectly; the per-rung/per-adapter/per-family caps are what keep this bounded)"; exit 1; }
  printf '%s' "$_wk" | grep -q 'TRAINED ADAPTERS' \
    || { echo "smoke-test: FAIL (wake frame lost its TRAINED ADAPTERS block — which rung was trained on what is half the pane)"; exit 1; }

  # A PANE THAT DOES NOT FIT ITS PANE SHOWS ONLY ITS TAIL — and a hidden section is indistinguishable
  # from an absent one. The check frame rendered 156 lines into a 27-row pane: FLEET, DOCTOR, VPN,
  # vitals, GPU, organs and supervised all rendered correctly, live and honest, and NOT ONE of them was
  # visible — the health mind saw the alphabetical tail (s..w) of a 112-line state dump and nothing
  # else. Every liveness signal was green throughout. Gate the SHAPE that caused it: the states block
  # must be a summary that NAMES its totals (so a capped remainder is stated, never dropped), and the
  # whole frame must stay inside a realistic pane.
  # UNSET, not inherited: with MESH_DASH_PANE_ROWS unset and --once refusing to read TMUX_PANE, this
  # renders the no-viewport frame — the same one cron and a capture get. Before that fix this very
  # line reported the TESTER'S WINDOW: red from a 41-row pane (43 lines), green from cron (33).
  # NODE-CONDITION SOFTENING (the shape mesh-restore already carries). A leg that cannot RUN on this
  # node — because the node lacks the organ/geometry the leg needs — records its reason here and the
  # suite ends n/a (exit 2), which mesh-land and mesh-fitness's regressions() treat as an honest pass.
  # It never softens a leg that RAN and failed: every _fail path still `exit 1`s on the spot, so a
  # real regression cannot reach the softening at all. This is what stops a NODE condition from
  # wearing a CODE verdict and getting a good commit auto-reverted.
  # ---- FAST CORE ENDS HERE ----------------------------------------------------------------------
  # Everything above is cheap (verify/sound/card-fallback/witness/chat/wake — no live `check` render,
  # which is the expensive one); everything below drives the heavy roles. --test-fast stops here so
  # mesh-doctor gets a gate inside its 12s cap; --test falls through and runs the lot.
  if [ "${_T_FAST:-0}" = 1 ]; then
    echo "smoke-test: ok (fast core — the deep gates below run under plain --test, which mesh-land drives at landing)"; exit 0
  fi

  # NODE-CONDITION SOFTENING scope note: _NA_REASONS is declared HERE, below the fast core, because no
  # fast-core leg is node-conditional. If one ever becomes so, move this pair above the boundary —
  # otherwise --test-fast would `exit 0` past an n/a leg and report a pass the node did not earn.
  _NA_REASONS=""
  _na_skip(){ _NA_REASONS="$_NA_REASONS
  - $1"; }

  # ── A CUT LINE MUST NEVER RENDER AS A LINE THAT ENDED ──────────────────────────────────────────
  # health's 20:20Z [task] dash-egress-clip-eats-the-measurements-and-leaves-the-prose, measured and
  # reproduced here byte-for-byte before the fix: the egress row rendered
  #   `DEGRADED-FUNCTIONAL where=hop1-bad (enantiostasis: var`
  # — an unclosed paren and a token cut mid-word that reads like a VALUE. The producer's 49-character
  # gloss `(enantiostasis: variable degraded, function held)` is not data (the verdict token
  # DEGRADED-FUNCTIONAL already carries that meaning) and it consumed the whole 54-character budget,
  # so `loss=0% avg=132.689ms jitter=27.213ms — page suppressed` was cut: the pane showed a verdict
  # WORD where the magnitude used to be, on 65 lines of the log, and a >10x latency degradation plus
  # a SUPPRESSED page were both invisible. Two independent legs, because either alone passes on the
  # broken build: (1) the gloss is stripped so the magnitude fits, (2) whatever still overflows is
  # MARKED, so a cut can never again be indistinguishable from a line that ended.
  _cd="$(mktemp -d)"
  printf '2026-08-19T20:24:03Z QUALITY DEGRADED-FUNCTIONAL where=hop1-bad (enantiostasis: variable degraded, function held) loss=0%% avg=132.689ms jitter=27.213ms hop1=192.168.8.1:0%%/46.566ms/34.714ms anthropic=405 — page suppressed\n' > "$_cd/egress-health.log"
  _ce="$(MESH_DIR="$_cd" "$0" --once check 2>&1 | grep 'egress now')"
  case "$_ce" in
    *enantiostasis*) rm -rf "$_cd"; echo "smoke-test: FAIL (the egress row still spends its width on the enantiostasis GLOSS — the verdict token already carries that meaning, and the gloss costs the measurements: $_ce)"; exit 1 ;;
  esac
  case "$_ce" in
    *avg=*) : ;;
    *) rm -rf "$_cd"; echo "smoke-test: FAIL (the egress row carries a verdict WORD and no magnitude — this is the whole fault: prose survived the clip and the numbers did not: $_ce)"; exit 1 ;;
  esac
  case "$_ce" in
    *…*) : ;;
    *) rm -rf "$_cd"; echo "smoke-test: FAIL (the egress row is longer than its budget and rendered NO truncation marker — a cut line that looks complete is how this fault stayed invisible: $_ce)"; exit 1 ;;
  esac
  # WIDTH IS PRESERVED: the marker replaces the last kept glyph instead of being appended, so a
  # clipped field is still exactly its budget. A marker that WIDENED the row would trade one
  # invisible fault (a silent cut) for another (an overflowing frame reads as a frozen pane).
  _cb="${_ce#*egress now: }"; _cb="${_cb% (age *}"
  _cbw="$(printf '%s' "$_cb" | wc -m)"
  [ "$_cbw" -le 55 ] || { rm -rf "$_cd"; echo "smoke-test: FAIL (the clipped egress field is $_cbw characters, over its 55 budget — the truncation marker must REPLACE the last glyph, not widen the row)"; exit 1; }
  # ...AND A LINE THAT FITS MUST NOT BE MARKED, or the marker is decoration that cries cut on every
  # row. Same code path, same render, only the producer line is shorter — this is the leg that keeps
  # the mark honest, and it is the one a `s/.\{N\}.*/\1…/` implementation fails.
  printf '2026-08-19T18:54:03Z QUALITY OK where=none loss=0%% avg=58.865ms mdev=0.572ms host=1.1.1.1\n' > "$_cd/egress-health.log"
  _cf="$(MESH_DIR="$_cd" "$0" --once check 2>&1 | grep 'egress now')"
  case "$_cf" in
    *…*) rm -rf "$_cd"; echo "smoke-test: FAIL (a fitting egress row was marked as truncated — a marker that fires when nothing was cut is worse than none: $_cf)"; exit 1 ;;
  esac
  case "$_cf" in
    *"mdev=0.572ms"*) : ;;
    *) rm -rf "$_cd"; echo "smoke-test: FAIL (a fitting egress row lost its tail anyway — the clip must pass a short line through whole: $_cf)"; exit 1 ;;
  esac
  # THE BOUNDARY, which is the only case that separates a correct marker from a naive one. A line
  # SHORTER than the budget passes through unmarked under every implementation, so the leg above
  # cannot catch `s/\(.\{N-1\}\).*/\1…/` — that form marks a line of EXACTLY N, which was not cut.
  # This fixture is tuned so the rendered field is exactly 54 characters: it must arrive whole, with
  # its last glyph intact and no mark.
  printf '2026-08-19T18:54:03Z QUALITY OK where=nonexxxxxxxx loss=0%% avg=58.865ms mdev=0.572ms host=1.1.1.1\n' > "$_cd/egress-health.log"
  _cg="$(MESH_DIR="$_cd" "$0" --once check 2>&1 | grep 'egress now')"
  _cgb="${_cg#*egress now: }"; _cgb="${_cgb% (age *}"
  [ "$(printf '%s' "$_cgb" | wc -m)" = 55 ] \
    || { rm -rf "$_cd"; echo "smoke-test: FAIL (the exact-budget fixture no longer renders 55 characters ($(printf '%s' "$_cgb" | wc -m)) — the boundary leg below is measuring the wrong case: [$_cgb])"; exit 1; }
  case "$_cgb" in
    *"mdev=0.572ms") : ;;
    *) rm -rf "$_cd"; echo "smoke-test: FAIL (a line of EXACTLY the budget was clipped or marked — it fits, nothing was cut, and marking it makes every full row cry truncation: [$_cgb])"; exit 1 ;;
  esac
  rm -rf "$_cd"

  # ── ROWS, NOT LINES ────────────────────────────────────────────────────────────────────────────
  # A pane paints ROWS; a line longer than the pane costs ceil(len/width) of them. Every ceiling in
  # here is a claim about what a mind can SEE, so every ceiling counts rows. (2026-08-19: the check
  # gate below counted lines, passed at exactly 34, and the frame it passed painted 46 rows in an
  # 80-column pane — 12 rows past its own limit, invisible to its own limit, which is precisely the
  # condition the gate was written to prevent.)
  # NEVER let the counter die on its input. It read stdin as strict UTF-8, so one split glyph in the
  # frame raised UnicodeDecodeError, printed NOTHING, and `${_adr:-99}` turned that silence into a
  # 99-row overflow verdict — the gate accusing the frame of the wrong crime, with a number nobody
  # measured. Decode with errors="replace": a corrupt byte then costs one column, and the ceiling
  # still answers the question it was asked. The separate leg below is what actually asserts the
  # frame is valid UTF-8, so this hardening cannot hide a regression in the clip.
  _rows(){ python3 -c 'import sys
w = int(sys.argv[1]) if len(sys.argv) > 1 and sys.argv[1].isdigit() and int(sys.argv[1]) > 0 else 80
d = sys.stdin.buffer.read().decode("utf-8","replace")
if d.endswith("\n"): d = d[:-1]
print(sum(max(1,-(-len(l)//w)) for l in d.split("\n")) if d else 0)' "${1:-80}"; }
  # the WIDEST row in stdin, in characters — names the offender when a ceiling goes red
  _widest(){ python3 -c 'import sys
d = sys.stdin.buffer.read().decode("utf-8","replace")
b = max(d.split("\n"), key=len) if d else ""
print("%d|%s" % (len(b), b[:120]))'; }
  _ck="$(MESH_DASH_PANE_ROWS= "$0" --once check 2>&1)" || { echo "smoke-test: FAIL (check render exited non-zero)"; exit 1; }
  _ckl="$(printf '%s\n' "$_ck" | _rows 80)"
  [ "${_ckl:-99}" -le 34 ] || { echo "smoke-test: FAIL (check frame paints $_ckl ROWS at 80 cols — a pane shows a tall frame's TAIL, so everything above row $(( _ckl - 27 )) is invisible while rendering perfectly. Widest row: $(printf '%s\n' "$_ck" | _widest))"; exit 1; }
  # ── AND NO SINGLE ROW MAY EXCEED THE DECLARED WIDTH ───────────────────────────────────────────
  # This is what makes the ceiling above a REAL number rather than a coincidence. Counting rows
  # tells you the frame overflowed; it does not stop the 35 field-level clip() sites from being
  # perfectly satisfied while the assembled row is twice the pane (the egress row was 2 + 47 label
  # + 54 clipped field + 58 UNCLIPPED tail = 161 with its budget met). The renderer now bounds the
  # assembled row at $_PANE_COLS, so lines and rows are the same number and this leg is what
  # asserts that — delete the bound and the frame goes red here, not silently 12 rows over.
  _ckw="$(printf '%s\n' "$_ck" | _widest)"
  [ "${_ckw%%|*}" -le 80 ] \
    || { echo "smoke-test: FAIL (a check row is ${_ckw%%|*} characters into an 80-column pane — a field-level clip cannot bound an assembled row, and a row that wraps costs rows the ceiling above is counting: [${_ckw#*|}])"; exit 1; }
  # …AND THE BOUND IS THE RENDERER'S, NOT THE DATA'S. A frame whose rows happen to be short today
  # passes the leg above while the bound is absent — that is exactly how the old ceiling passed for
  # months. Feed a row that CANNOT fit (a vpn-health line of 400 characters) and require it to come
  # back at the width, MARKED: the marker is what keeps a cut from reading as a line that ended.
  _wd0="$MESH_TEST_TMPD/wide"; mkdir -p "$_wd0"
  cp "$HOME/.mesh/.fleet-health.cache" "$_wd0/" 2>/dev/null || true
  printf '2026-08-19T00:00:00Z\tphaedra VPN OK — %s\n' "$(printf 'z%.0s' $(seq 1 400))" > "$_wd0/vpn-health.log"
  _wo0="$(MESH_DIR="$_wd0" MESH_DASH_PANE_ROWS= "$0" --once check 2>/dev/null | grep 'friends@phaedra')"
  _wow="$(printf '%s\n' "$_wo0" | _widest)"
  [ "${_wow%%|*}" -le 80 ] \
    || { echo "smoke-test: FAIL (a 400-character vpn-health line rendered ${_wow%%|*} columns — the assembled-row bound is not being applied, so the ceiling gate above is counting a frame the pane cannot paint)"; exit 1; }
  case "$_wo0" in
    *…*) : ;;
    *) echo "smoke-test: FAIL (a 400-character row was cut to the pane width and carried NO truncation marker — a cut that looks like a line that ended is how the whole class of these faults stays invisible: $_wo0)"; exit 1 ;;
  esac
  printf '%s' "$_ck" | grep -qE '^  [0-9]+ states: [0-9]+ alarm( \([0-9]+ phone-down, [0-9]+ src\?\))? · [0-9]+ stale' \
    || { echo "smoke-test: FAIL (check frame's edge-state block is not the summarizing form — a wall that grows with the reflex count cannot be the pane's bulk)"; exit 1; }
  for _sec in FLEET DOCTOR VPN vitals organs; do
    printf '%s' "$_ck" | grep -q -- "$_sec" \
      || { echo "smoke-test: FAIL (check frame lost its $_sec section — the trim that made it fit must not delete what the pane is FOR)"; exit 1; }
  done
  # ── THE FRAME MUST FIT WHEN THE NODE IS SICK, NOT ONLY WHEN IT IS WELL ──
  # The ≤34-line assertion above renders the LIVE frame, so it passes whenever this node happens to be
  # healthy — a gate that agrees with the current reading asserts nothing about the case it exists for.
  # Every failure block GROWS the frame (named doctor fails, DARK organs, UNPARSED, PROBE-WARNING)
  # while the resting frame sits ~5 lines under the ceiling. LIVE 2026-08-18T10:37Z: mesh-dash's own
  # smoke-test went red in doctor with bytes that pass 4/4 now — the node was sick, not the tool. And
  # it is self-referential: that failure is itself a doctor FAIL, which adds another line to the block.
  # So drive the WORST case, not the current one.
  _wd="$MESH_TEST_TMPD/worst"; mkdir -p "$_wd/.mesh" "$_wd/bin"
  cp "$HOME/.mesh/.fleet-health.cache" "$_wd/.mesh/" 2>/dev/null || true
  { echo '2026-01-01T00:00:00Z FAIL=9 WARN=99'
    for _i in 1 2 3 4 5 6 7 8 9; do echo "smoke-test FAIL (real): mesh-fixture-$_i"; done
  } > "$_wd/.mesh/.doctor-fails"
  printf '#!/bin/sh\nfor o in a b c d e f g h; do echo "  n:$o — DARK"; done\necho "  n:up — LIVE"\n' \
    > "$_wd/bin/mesh-organ-keepalive"; chmod +x "$_wd/bin/mesh-organ-keepalive"
  # …AND THE STATE WALL MUST BE SATURATED IN THE SAME BREATH. The fixture $HOME has no reflex states
  # of its own, so the block this ceiling is mostly bounding rendered EMPTY here — the leg drove the
  # doctor/organ growth against a state wall that had nothing to say, and passed while the live frame
  # (same code, a busy wall) ran 9 lines over. A worst case that silences one of its own inputs is not
  # a worst case. 40 alarm states, so the cap binds hard.
  _i=1; while [ "$_i" -le 40 ]; do echo "CRITICAL fixture $_i" > "$_wd/.mesh/.fixture$_i-state"; _i=$(( _i + 1 )); done
  # …AND THE TRAILING BLOCK AT ITS MAXIMUM TOO. Empty, the streams section is one word on the
  # autopoiesis row; FED, it is a header plus three lines. A worst case that leaves channels.log
  # empty silences the very input whose hand-written "2" in the cap arithmetic was wrong — the
  # frame ran three rows over on any node with a live feeder and nothing measured it.
  printf '%s\n' 'stream-a fed 2026-01-01T00:00:00Z' 'stream-b fed 2026-01-01T00:00:00Z' \
    'stream-c fed 2026-01-01T00:00:00Z' > "$_wd/.mesh/channels.log"
  _wl="$(MESH_DASH_PANE_ROWS= HOME="$_wd" PATH="$_wd/bin:$PATH" "$0" --once check 2>/dev/null | _rows 80)"
  [ "${_wl:-99}" -le 34 ] \
    || { echo "smoke-test: FAIL (check frame paints $_wl ROWS under a SICK node — 9 doctor fails + 8 DARK organs + 40 alarm states; the pane shows only a frame's tail, so the node's worst moment is exactly when the top scrolls away)"; exit 1; }
  # THE HEIGHT IS A PROPERTY OF THE CODE, NOT OF WHO RAN IT. A STUB tmux answers with a 90-row pane,
  # so the branch is genuinely driven: `TMUX_PANE=%99` alone would make the real tmux error out and
  # yield 0 rows — the same answer the fix produces, i.e. a leg that passes without asserting a thing.
  _td="$MESH_TEST_TMPD/tallpane"; mkdir -p "$_td"
  printf '#!/bin/sh\necho 90\n' > "$_td/tmux"; chmod +x "$_td/tmux"
  _t1="$(MESH_DASH_PANE_ROWS= TMUX_PANE=%99 PATH="$_td:$PATH" "$0" --once check 2>/dev/null | _rows 80)"
  _t2="$(MESH_DASH_PANE_ROWS= TMUX_PANE= "$0" --once check 2>/dev/null | _rows 80)"
  [ "$_t1" = "$_t2" ] \
    || { echo "smoke-test: FAIL (check frame is $_t1 rows with a 90-row tmux pane in the environment and $_t2 rows without one — a --once render goes to a pipe, not to that pane, and must not size itself to the terminal that invoked it)"; exit 1; }
  # AND THE ELASTIC PATH IS DRIVEN, not just the 34-line fallback: a pinned viewport must never be
  # exceeded. A cap that ignored $_PANE_ROWS renders the fallback 34 into a 27-row pane and goes red.
  # THE FLOOR IS A NODE CONDITION, THE CAP IS THE CODE. Trimming can only give back the ELASTIC
  # rows; the fixed sections are whatever this node's doctor/organs/alarm content happens to be, and
  # on a node whose fixed floor exceeds the pin NO cap can satisfy it. Measured 2026-08-19: mesh-home
  # floors at 24 rows, phaedra at 33 — so the 27 pin is a code assertion here and an unreachable
  # demand there, and asserting it flat is what put rc=1 on phaedra's mesh-dash --test and cost a good
  # commit an auto-revert. Measure the floor (pin 1 = maximum trimming), assert every pin AT OR ABOVE
  # it, and record the ones below as an honest NODE-CONDITION n/a instead of a code verdict. A floor
  # that does not read is still a FAIL — an unreadable floor must not become a licence to skip.
  _floor="$(MESH_DASH_PANE_ROWS=1 "$0" --once check 2>/dev/null | _rows 80)"
  case "${_floor:-0}" in ''|*[!0-9]*|0) echo "smoke-test: FAIL (could not measure the untrimmable floor — pin 1 rendered '${_floor:-}' rows)"; exit 1 ;; esac
  for _pr in 27 41 60; do
    if [ "$_pr" -lt "$_floor" ]; then
      _na_skip "pinned-pane cap at ${_pr} rows: this node's untrimmable floor is ${_floor} rows, so no cap can fit ${_pr} — a NODE condition (fixed-section content), not a code verdict"
      continue
    fi
    _pl="$(MESH_DASH_PANE_ROWS="$_pr" "$0" --once check 2>/dev/null | _rows 80)"
    [ "${_pl:-99}" -le "$_pr" ] \
      || { echo "smoke-test: FAIL (check frame is $_pl lines into a pinned ${_pr}-row pane, floor=${_floor} — the state cap must be measured against the rows already spent, not guessed by a constant)"; exit 1; }
  done
  # …and the SICK node in a pane it cannot possibly fit degrades honestly instead of overflowing
  # silently: the state rows go to zero and every one of them is still NAMED as dropped. (The fixed
  # sections alone are ~29 rows here, so nothing can make this fit 27 — the question is only whether
  # the pane LIES about it.)
  _po="$(MESH_DASH_PANE_ROWS=27 HOME="$_wd" PATH="$_wd/bin:$PATH" "$0" --once check 2>/dev/null)"
  case "$_po" in
    *"not shown (cap 0)"*) : ;;
    *) echo "smoke-test: FAIL (a state block squeezed to zero rows did not say so — a cap that drops every member silently is indistinguishable from a clean wall)"; exit 1 ;;
  esac
  # …and the truncation must NAME its remainder — a silent cap reads as "that is all of them".
  # CAPTURE FIRST, then match. `… --once check | grep -q PATTERN` is a false-FAIL generator here:
  # grep -q exits the moment it matches, SIGPIPEs the renderer, and under `set -o pipefail` the
  # pipeline reports failure BECAUSE the assertion succeeded. The line-count gate above is immune
  # only because `wc -l` drains the pipe. Cost me a debugging round; do not reintroduce the pipe.
  _wo="$(MESH_DASH_PANE_ROWS= HOME="$_wd" PATH="$_wd/bin:$PATH" "$0" --once check 2>/dev/null)"
  case "$_wo" in
    *"more FAIL not shown"*) : ;;
    *) echo "smoke-test: FAIL (9 doctor fails rendered with no '+N more' marker — a silently truncated fail list reads as the complete one)"; exit 1 ;;
  esac

  # ── THE adint FRAME IS BOUNDED IN *WRAPPED ROWS*, NOT IN LINES ──
  # LIVE 2026-08-19: the adint pane (80x11) was reported as "15 lines into 11 rows". It was worse
  # than that and the discrepancy IS the lesson — 9 logical lines rendered THIRTY-SIX rows, because a
  # 505-char constant wraps to seven. `wc -l` cannot see this: it is the metric under which an
  # overflowing pane reads as fitting. So this gate wraps at the real pane width and counts ROWS.
  # The mind was told about its own undischarged [taking] by the OPERATOR because the pane never
  # carried it — six rows of immutable HARD RULES had pushed it off the top — so the ceiling is
  # asserted together with the presence of the OPEN line it exists to keep visible.
  _ad="$(MESH_DASH_PANE_ROWS= "$0" --once adint 2>&1)" || { echo "smoke-test: FAIL (adint render exited non-zero)"; exit 1; }
  _adr="$(printf '%s\n' "$_ad" | _rows)"
  [ "${_adr:-99}" -le 11 ] \
    || { echo "smoke-test: FAIL (adint frame is $_adr wrapped rows at 80 cols into an 11-row pane — $(( _adr - 11 )) rows of its own top are scrolled away, and the frame renders perfectly while being unreadable)"; exit 1; }
  # THE FRAME MUST BE VALID UTF-8 (2026-08-19). Every pane clips to a width, and `cut -c` is
  # BYTE-wise in GNU coreutils — so on Cyrillic (2 bytes/char, which is what the operator's board,
  # voice transcripts and PLAN.md are made of) a clip lands mid-glyph about half the time. Live: the
  # adint frame ended `…захват ПЕРЕ<0xd0>`. A tmux pane renders that as a replacement glyph and
  # nobody notices; the row-counter above died on it outright. Assert the bytes, not the look.
  printf '%s\n' "$_ad" | python3 -c 'import sys
try: sys.stdin.buffer.read().decode("utf-8")
except UnicodeDecodeError as e: print("BAD: %s" % e); sys.exit(1)' \
    || { echo "smoke-test: FAIL (adint frame is not valid UTF-8 — a width clip split a multibyte character; use clip, never cut -c)"; exit 1; }
  printf '%s\n' "$_ad" | grep -q '^OPEN, undischarged:' \
    || { echo "smoke-test: FAIL (adint frame lost its OPEN/undischarged line — the trim that made it fit must not delete the claim the lane exists to settle)"; exit 1; }
  # WORST CASE, because the ceiling above renders the frame this node happens to have: one hold and
  # two short board lines. Every input here GROWS: three open obligations at once, and a board line
  # of the length the lane actually posts (the 18.08 [taking] ran 900+ chars — eleven rows by itself
  # if it were not clipped). A stub `mesh-promises` on PATH is what makes the hold leg real; without
  # it the fixture HOME would render "none" and assert nothing about the branch that overflows.
  _adw="$MESH_TEST_TMPD/adint"; mkdir -p "$_adw/.mesh" "$_adw/bin" "$_adw/self-adint/docs"
  printf '#!/bin/sh\ncat <<EOF\n                1 HOLD  liabilities:holds:adint:adint-hb-ru-market-study-with-a-long-slug\n             1 PROMISE  liabilities:promises:adint:frame-stage-b-inclusion-probe-ledger\n               1 CLAIM  liabilities:claims:adint:vantage-dependence-of-the-frame\nEOF\n' \
    > "$_adw/bin/mesh-promises"; chmod +x "$_adw/bin/mesh-promises"
  _long="$(printf 'x%.0s' $(seq 1 900))"
  printf '2026-08-18T20:27:50Z  adint@mesh-home  ::  [taking] adint: %s\n' "$_long" > "$_adw/.mesh/chat.log"
  printf '2026-08-18T20:28:58Z  adint@mesh-home  ::  [fyi] %s\n' "$_long" >> "$_adw/.mesh/chat.log"
  printf 'step-with-an-unreasonably-long-name-that-a-mind-might-well-write\n' > "$_adw/.mesh/adint-step"
  printf '%s\n' '⚠ a gap' '⚠ another' > "$_adw/self-adint/docs/brief-2026-08-15-operator.md"
  _adwr="$(MESH_DASH_PANE_ROWS= HOME="$_adw" PATH="$_adw/bin:$PATH" "$0" --once adint 2>/dev/null | _rows)"
  [ "${_adwr:-99}" -le 11 ] \
    || { echo "smoke-test: FAIL (adint frame is $_adwr wrapped rows under three open obligations and 900-char board lines — the pane's worst moment is exactly when its top scrolls away)"; exit 1; }

  # ── A DEGRADED-PROBE BANNER IS NOT A NODE ──
  # mesh-fleet-health prints a warning ABOVE the table when its own reachability probe is unreliable.
  # That banner is prose carrying the table's OWN vocabulary — "LOCAL" sits in field 2 — so the row
  # parser matched it and minted a node. LIVE 2026-08-18T08:38Z the check pane showed a 10th node
  # "⚠(LOCAL vitals=HIGH up=(load1=37.12))" beside the real mesh-home row carrying the OPPOSITE
  # verdict, and the warning itself — "non-answers shown as UNKNOWN(load), NOT down" — vanished by
  # being parsed. Fixture is the VERBATIM live banner: a tidied one would drop the very token that did it.
  _fd="$MESH_TEST_TMPD/fleet"; mkdir -p "$_fd/.mesh"
  printf '%s\n' '=== mesh-fleet-health 2026-08-18T08:38:25Z ===' \
    '⚠ LOCAL LOAD HIGH (load1=45.94) — reachability probe UNRELIABLE; non-answers shown as UNKNOWN(load), NOT down' \
    '' \
    'NODE                 REACHABLE  POWER        VITALS   UPSTREAM MINDS' \
    '-------------------- ---------- ------------ -------- -------- ------' \
    'mesh-home            LOCAL      MAINS        OK       ok       claude' \
    'Redmi 10             LAN-up     -            -        -        -' \
    'rip                  UNKNOWN(load) -          -        -        -' > "$_fd/.mesh/.fleet-health.cache"
  _ckb="$(HOME="$_fd" "$0" --once check 2>/dev/null)"
  printf '%s\n' "$_ckb" | grep -qE '^  3 nodes:' \
    || { echo "smoke-test: FAIL (fleet roster counted the degraded-probe BANNER as a node — want 3, got: $(printf '%s\n' "$_ckb" | grep -E '^  [0-9]+ nodes:'))"; exit 1; }
  printf '%s\n' "$_ckb" | grep -q '⚠(' \
    && { echo "smoke-test: FAIL (fleet roster rendered a node named from the banner glyph — a warning became a host)"; exit 1; }

  # ── SOURCE-CLASS PARTITION OF THE ALARM COUNT (phone-source-down vs a fault) ──
  # Fixture is built to be the failure the grouping can cause, not the one it fixes: FOUR alarming
  # states, of which TWO are the same absent phone — one whose organ DECLARES the phone class and one
  # whose organ declares NOTHING. The undeclared one is the whole gate. It must never be quietly
  # swallowed into either bucket: the total must still be 4, it must be NAMED src?, and its
  # row must still print. A partition that silently drops what it cannot classify shrinks the
  # denominator and reads cleaner while staying wrong.
  _sd="$MESH_TEST_TMPD/srcclass"; mkdir -p "$_sd/.mesh" "$_sd/.local/bin"
  printf 'OFFLINE|1|8|OFFLINE|0|NONE|NONE|NA\n' > "$_sd/.mesh/.tamper-state"      # declared phone, source down
  printf '|OFFLINE||||\n'                       > "$_sd/.mesh/.bodymo-state"      # UNDECLARED organ, same phone
  printf 'FAILED write path\n'                  > "$_sd/.mesh/.zzfault-state"     # a real fault (declared local)
  printf 'GPU DOWN\n'                           > "$_sd/.mesh/.zzgpu-state"       # a real fault, undeclared
  printf 'OK\n'                                 > "$_sd/.mesh/.zzcalm-state"      # quiet, must not be counted
  printf '#!/usr/bin/env bash\n# doctor-artifact: $HOME/.mesh/.tamper-state 1800 phone\n' > "$_sd/.local/bin/mesh-tamper"
  printf '#!/usr/bin/env bash\n# mesh-bodymo — NO doctor-artifact header, on purpose\n'   > "$_sd/.local/bin/mesh-bodymo"
  printf '#!/usr/bin/env bash\n# doctor-artifact: $HOME/.mesh/.zzfault-state 900 local\n' > "$_sd/.local/bin/mesh-zzfault"
  _sck="$(HOME="$_sd" "$0" --once check 2>/dev/null)"
  _shdr="$(printf '%s\n' "$_sck" | grep -m1 -E '^  [0-9]+ states: ')"
  [ -n "$_shdr" ] || { echo "smoke-test: FAIL (source-class fixture rendered no states line at all)"; exit 1; }
  _sal="$(printf '%s' "$_shdr" | sed -n 's/^  [0-9]* states: \([0-9]*\) alarm.*/\1/p')"
  _sph="$(printf '%s' "$_shdr" | sed -n 's/.*(\([0-9]*\) phone-down, [0-9]* src?).*/\1/p')"
  _sun="$(printf '%s' "$_shdr" | sed -n 's/.*([0-9]* phone-down, \([0-9]*\) src?).*/\1/p')"
  [ -n "$_sal" ] && [ -n "$_sph" ] && [ -n "$_sun" ] \
    || { echo "smoke-test: FAIL (states line carries no source-class partition — got '$_shdr'; the assertions below would assert nothing)"; exit 1; }
  # THE DENOMINATOR IS THE POINT: grouping must not remove a row from the alarm count.
  [ "$_sal" = 4 ] || { echo "smoke-test: FAIL (4 alarming states, alarm count reads $_sal — a source-class GROUP became a FILTER: '$_shdr')"; exit 1; }
  [ "$_sph" = 1 ] || { echo "smoke-test: FAIL (want 1 phone-down (the DECLARED phone organ), got $_sph — the undeclared phone organ must not be guessed into the class either: '$_shdr')"; exit 1; }
  [ "$_sun" = 2 ] || { echo "smoke-test: FAIL (want 2 src?, got $_sun — an organ with no doctor-artifact header must be NAMED unclassified, never folded into the fault remainder: '$_shdr')"; exit 1; }
  [ "$(( _sph + _sun ))" -le "$_sal" ] || { echo "smoke-test: FAIL (partition $_sph+$_sun exceeds the $_sal alarms it partitions)"; exit 1; }
  # ...and the row itself must survive, not just the count.
  printf '%s\n' "$_sck" | grep -q '✗ bodymo' \
    || { echo "smoke-test: FAIL (the undeclared phone organ's alarm ROW vanished from the wall — counted-but-invisible is still a drop)"; exit 1; }
  printf '%s\n' "$_sck" | grep -E '✗ (bodymo|zzgpu)' | grep -q 'src?' \
    || { echo "smoke-test: FAIL (undeclared alarm rows are not marked src? — the reader cannot tell 'not a phone' from 'unknown source')"; exit 1; }
  # A KNOWN SOURCE-DOWN MUST NOT OUTRANK A REAL FAULT in the capped display: the cap is what the
  # health mind actually sees, so demoting the count while leaving the ROWS sev-1 fixes nothing.
  # The cap is ELASTIC (pane-height derived), so assert the ORDER, not a fixed visible set: a real
  # fault must be displayed, and the phone-down must be absent or last — never above a fault.
  _sord="$(printf '%s\n' "$_sck" | sed -n 's/^  ✗ \([a-z]*\) .*/\1/p' | tr '\n' ' ')"
  case " $_sord" in
    *" zzfault "*) : ;;
    *) echo "smoke-test: FAIL (the real fault row 'zzfault' is not displayed at all (shown: '$_sord') — the cap is spending its rows on something other than faults)"; exit 1 ;;
  esac
  # `${_sord% }` vs `${_sord%tamper}tamper` was a FALSE-RED GENERATOR: $_sord ends in a space (it is
  # `tr '\n' ' '`), so `%tamper` never strips anything and the two sides could not be equal even with
  # tamper correctly last. It went unnoticed because the ceiling gate above exits first — a red gate
  # hides every gate after it, so a suite is only as tested as its FIRST failure. Strip once, compare
  # the tail.
  _sordt="${_sord% }"
  case " $_sordt " in
    *" tamper "*) case "$_sordt" in
        *tamper) : ;;
        *) echo "smoke-test: FAIL (row order '$_sord' — the phone-down is not last, so under the cap it pushes a real fault off the pane)"; exit 1 ;;
      esac ;;
    *) : ;;   # capped out entirely — correct, that is the demotion working
  esac
  # ── FIELD-VOCABULARY EXEMPTION (a sense's own band name is not a verdict) ──
  # Fixture is built as the failure the exemption can CAUSE, not the one it fixes. The dangerous
  # direction here is a false GREEN — a global "stop matching STALE" would mute every sense that
  # writes it meaning a genuinely dead input — so four of the five states must still alarm and only
  # the one whose organ DECLARED the field may go quiet.
  _vd="$MESH_TEST_TMPD/vocab"; mkdir -p "$_vd/.mesh" "$_vd/.local/bin"
  _vdecl='# doctor-vocab: $HOME/.mesh/.%s-state 4:ACTIVE,RECENT,STALE,COLD,NEVER'
  printf 'quiet|1787160000|8|STALE|5|ATTRIBUTED|NONE|NA\n' > "$_vd/.mesh/.vv1-state"  # declared band → exempt
  # vv2 must carry a word that IS in the alarm alphabet but is NOT in the declared band list —
  # BROKEN was the first draft and does not alarm at all, which made the gate vacuous (seen red).
  printf 'quiet|1787160000|8|DEGRADED|5|ATTRIBUTED|NONE|NA\n' > "$_vd/.mesh/.vv2-state" # UNDECLARED value, same field
  printf 'FAILED|1787160000|8|STALE|5|ATTRIBUTED|NONE|NA\n' > "$_vd/.mesh/.vv3-state" # real fault in field 1
  printf 'quiet|1787160000|8|STALE|5|ATTRIBUTED|NONE|NA\n' > "$_vd/.mesh/.vv4-state"  # SAME value, NO declaration
  printf 'quiet|1787160000|8|STALE|5|ATTRIBUTED|NONE|NA\n' > "$_vd/.mesh/.vv5-state"  # declaration points off the end
  # shellcheck disable=SC2059
  { printf '#!/usr/bin/env bash\n'; printf "$_vdecl\n" vv1; } > "$_vd/.local/bin/mesh-vv1"
  { printf '#!/usr/bin/env bash\n'; printf "$_vdecl\n" vv2; } > "$_vd/.local/bin/mesh-vv2"
  { printf '#!/usr/bin/env bash\n'; printf "$_vdecl\n" vv3; } > "$_vd/.local/bin/mesh-vv3"
  printf '#!/usr/bin/env bash\n# mesh-vv4 — declares NOTHING, on purpose\n' > "$_vd/.local/bin/mesh-vv4"
  printf '#!/usr/bin/env bash\n# doctor-vocab: $HOME/.mesh/.vv5-state 9:STALE\n' > "$_vd/.local/bin/mesh-vv5"
  _vck="$(HOME="$_vd" "$0" --once check 2>/dev/null)"
  _vhdr="$(printf '%s\n' "$_vck" | grep -m1 -E '^  [0-9]+ states: ')"
  [ -n "$_vhdr" ] || { echo "smoke-test: FAIL (vocab fixture rendered no states line at all)"; exit 1; }
  _val="$(printf '%s' "$_vhdr" | sed -n 's/^  [0-9]* states: \([0-9]*\) alarm.*/\1/p')"
  _vex="$(printf '%s' "$_vhdr" | sed -n 's/.* \([0-9]*\) vocab-ex.*/\1/p')"
  [ "$_val" = 4 ] \
    || { echo "smoke-test: FAIL (want 4 alarms — only the DECLARED band may go quiet; got $_val: '$_vhdr')"; exit 1; }
  [ "$_vex" = 1 ] \
    || { echo "smoke-test: FAIL (want 1 vocab-exempt NAMED on the states line, got '${_vex:-none}' — a suppression nobody can see is a silent filter: '$_vhdr')"; exit 1; }
  printf '%s\n' "$_vck" | grep -q '✗ vv1' \
    && { echo "smoke-test: FAIL (a sense's OWN declared band still red the wall — the exemption did not fire)"; exit 1; }
  printf '%s\n' "$_vck" | grep -q '✗ vv2' \
    || { echo "smoke-test: FAIL (an UNDECLARED value in the exempt field went quiet — the mask blanks the FIELD instead of matching the declared words, so format drift or a real alarm word lands silently)"; exit 1; }
  printf '%s\n' "$_vck" | grep -q '✗ vv3' \
    || { echo "smoke-test: FAIL (a real fault in field 1 was muted by an exemption on field 4 — the exemption is positional, never a per-state mute)"; exit 1; }
  printf '%s\n' "$_vck" | grep -q '✗ vv4' \
    || { echo "smoke-test: FAIL (the SAME value went quiet with NO declaration — the alarm word was removed globally, trading a false red for a false GREEN across every sense that writes it meaning a dead input)"; exit 1; }
  printf '%s\n' "$_vck" | grep -q '✗ vv5' \
    || { echo "smoke-test: FAIL (an out-of-range field index blanked something — an index past the end must be a no-op, not a mute)"; exit 1; }
  # The partition invariant the states line states must survive the new segment: vocab-exempt sits
  # OUTSIDE the parenthetical because an exempted state is not an alarm.
  printf '%s' "$_vhdr" | grep -qE 'alarm \([0-9]+ phone-down, [0-9]+ src\?\).*vocab-ex' \
    || { echo "smoke-test: FAIL (vocab-exempt was folded INTO the alarm parenthetical — it breaks the stated partition nphd+nsu+faults==nal: '$_vhdr')"; exit 1; }

  # …and skipping it is only half: the banner says the probe is UNRELIABLE and that non-answers are
  # UNKNOWN(load) rather than down. Dropped, the down: line reads as authoritative exactly when its
  # own producer has said it is not.
  printf '%s\n' "$_ckb" | grep -q 'PROBE-WARNING:.*UNRELIABLE' \
    || { echo "smoke-test: FAIL (the degraded-probe banner was skipped but never SURFACED — the down: list now reads as authoritative against its producer's own warning)"; exit 1; }

  # ── ONE READ, REUSED: the header count and the roster section must never contradict each other ──
  # A stub that ANSWERS DIFFERENTLY ON EACH CALL is the whole point: the pre-fix code invoked
  # `mesh-organ-keepalive --status` three times per frame (LIVE count, DARK count, roster), so a
  # producer that flapped between them published a self-contradicting frame — OBSERVED LIVE
  # 2026-08-17T23:02Z as `organs 12LIVE/1DARK` three lines above `all LIVE (none DARK)`.
  # The stub must be reached via HOME-redirect, NOT PATH order alone: every mesh-* tool re-prepends
  # $HOME/.local/bin at load, so a bare PATH stub is overtaken by the real bin dir.
  _od="$MESH_TEST_TMPD/organ"; mkdir -p "$_od/bin" "$_od/.mesh"
  cat > "$_od/bin/mesh-organ-keepalive" <<'ORGEOF'
#!/bin/sh
# flapping producer: odd calls report one DARK, even calls an all-LIVE roster
n=$(cat "$ORG_STUB_N" 2>/dev/null || echo 0); n=$((n+1)); echo "$n" > "$ORG_STUB_N"
echo "  n:alpha — LIVE"
if [ $((n % 2)) -eq 1 ]; then echo "  n:beta — DARK"; else echo "  n:beta — LIVE"; fi
echo "  n:gamma — LIVE"
ORGEOF
  chmod +x "$_od/bin/mesh-organ-keepalive"
  # the env prefix MUST sit inside the substitution, on the real command: `A=1 _v="$(…)"` is an
  # ASSIGNMENT LIST, not a temporary environment — it would leak HOME/PATH into every later gate
  # (caught exactly that way: the reflexes-wall gate below went red with 0 rows).
  _ckf="$(ORG_STUB_N="$_od/n" HOME="$_od" PATH="$_od/bin:$PATH" "$0" --once check 2>&1)"
  _hdark="$(printf '%s\n' "$_ckf" | sed -n 's/.*organs [0-9]*LIVE\/\([0-9]*\)DARK.*/\1/p' | head -1)"
  _sdark="$(printf '%s\n' "$_ckf" | sed -n 's/^-- organs DARK (\([0-9]*\)).*/\1/p' | head -1)"
  printf '%s\n' "$_ckf" | grep -q 'organs: all LIVE' && _sdark=0
  [ -n "$_hdark" ] && [ -n "$_sdark" ] \
    || { echo "smoke-test: FAIL (organ one-read gate could not extract both renderings — header='$_hdark' section='$_sdark'; the assertion below would assert nothing)"; exit 1; }
  [ "$_hdark" = "$_sdark" ] \
    || { echo "smoke-test: FAIL (organ header says ${_hdark} DARK but the roster section says ${_sdark} — one frame published two independent probes of a flapping producer as one fact; capture --status ONCE and reuse it)"; exit 1; }
  # the header's own two numbers must come from the SAME read too: LIVE+DARK must equal the roster
  # size (3 here). Pre-fix they came from two invocations, so the sum could name a phantom organ.
  _hlive="$(printf '%s\n' "$_ckf" | sed -n 's/.*organs \([0-9]*\)LIVE\/[0-9]*DARK.*/\1/p' | head -1)"
  [ "$(( _hlive + _hdark ))" -eq 3 ] \
    || { echo "smoke-test: FAIL (organ header ${_hlive}LIVE/${_hdark}DARK sums to $(( _hlive + _hdark )), want 3 — the two counts came from different reads of the same roster)"; exit 1; }
  # AN EMPTY READ IS NOT AN ALL-CLEAR. A failed/timed-out probe yields "", and grep -c "" is 0/0 —
  # which the pre-fix code rendered as `0LIVE/0DARK` + "all LIVE (none DARK)": a dead probe wearing
  # the exact words of a healthy roster. n/a must be a claim about the node.
  printf '#!/bin/sh\nexit 0\n' > "$_od/bin/mesh-organ-keepalive"; chmod +x "$_od/bin/mesh-organ-keepalive"
  _cke="$(HOME="$_od" PATH="$_od/bin:$PATH" "$0" --once check 2>&1)"
  printf '%s\n' "$_cke" | grep -q 'organs: all LIVE' \
    && { echo "smoke-test: FAIL (an UNREADABLE organ roster rendered as 'all LIVE (none DARK)' — a fabricated all-clear; it must render n/a)"; exit 1; }
  printf '%s\n' "$_cke" | grep -q 'organs n/a' && printf '%s\n' "$_cke" | grep -q 'organs: n/a' \
    || { echo "smoke-test: FAIL (an unreadable roster must say n/a in BOTH the header and the section — one silent half still reads as clean; got: $(printf '%s\n' "$_cke" | grep -i organ | tr '\n' '|'))"; exit 1; }
  # …and the FULL wall must still exist somewhere, or the summary has simply destroyed the detail it
  # points at ("full wall: mesh-dash --once reflexes" would name a surface that renders nothing).
  _rfw="$("$0" --once reflexes 2>&1 | grep -cE '^  [a-z0-9.-]+ .* age ')"
  [ "${_rfw:-0}" -ge 20 ] || { echo "smoke-test: FAIL (reflexes role renders $_rfw state rows — the check pane's summary points at a full wall that is gone)"; exit 1; }
  # THE ROOM PROBE MUST NOT MATCH ITSELF (2026-07-15, board/room-ear-watcher-up-is-a-pgrep-self-match).
  # Drive the probe the way the dash really drives it — `bash -lc "<probe text>"`, so the pattern lands
  # in a live cmdline — and assert the cam gate reports DOWN when no cam watcher exists. Under the old
  # bare `pgrep -af <name>` this FAILS (the probe shell matches itself → "watcher up, no frame yet"),
  # which is the whole point: it is the behaviour that was broken, not the source text. Sandbox HOME so
  # no real frame can satisfy it. NB: this sits ABOVE the mesh-pace exit-2 below on purpose — a gate
  # placed under a prerequisite guard is silent on exactly the nodes it should speak for.
  _probe="$(sed -n "/^        remote_probe='/,/^'$/p" "$0" | sed "1s/.*remote_probe='//; \$d")"
  if [ -z "$_probe" ]; then echo "smoke-test: FAIL (room probe not extractable — the self-match gate would assert nothing)"; exit 1; fi
  if pgrep -af "mesh-cam[-]watch" >/dev/null 2>&1; then
    echo "smoke-test: note (a real cam watcher runs here — cam=DOWN assertion unrenderable, self-match gate skipped)"
  else
    _hm="$(mktemp -d)"; mkdir -p "$_hm/.mesh"
    _pout="$(HOME="$_hm" bash -lc "$_probe" 2>/dev/null)"
    rm -rf "$_hm"
    printf '%s' "$_pout" | grep -q 'cam=DOWN' \
      || { echo "smoke-test: FAIL (room probe: no cam watcher runs, yet the probe does not report cam=DOWN — a pattern is matching the probe cmdline itself)"; exit 1; }
    # The ear row must be built from the organ gates (not a resurrected wake-word pgrep) AND must be
    # ONE COMPLETE LINE. Both halves are regressions that really happened: `is-active` prints its
    # verdict and ALSO exits non-zero, so `$(is-active || echo inactive)` yielded "inactive\ninactive"
    # and tore the row in two on the live pane — the room mind reads this row, and half a row is a
    # worse lie than no row. Assert the whole shape, on a single line.
    printf '%s' "$_pout" | grep -qE '^ear: stt=[a-z-]+ · wake-reflex=(UP|DOWN) · .+ · last name-wake: (never|just now|recent|old)$' \
      || { echo "smoke-test: FAIL (room probe: ear row is not one complete line built from the organ gates — got: $(printf '%s' "$_pout" | grep -A1 '^ear:' | head -2 | tr '\n' '/'))"; exit 1; }
  fi
  # VOICE FIELD IS DERIVED, NEVER A LITERAL (chat-review/room-dash-voice-field-is-a-literal): three
  # verify-ledger states must render THREE DIFFERENT strings in the organ line — under the old
  # constant Bose=mesh-say all three read identically healthy while the amp had been dead a day and
  # the verdict sat unread in the log (two room minds re-proved the death by hand in one night).
  # Sandbox HOME per state, driven through bash -lc exactly like the live ssh. Watched RED pre-fix
  # on all three lanes.
  _vh="$(mktemp -d)"; mkdir -p "$_vh/.mesh"
  _vrun(){ HOME="$_vh" bash -lc "$_probe" 2>/dev/null | grep '^organs:'; }
  printf '2026-07-17T00:00:01\tSILENT\t0.00\ttest\t\n2026-07-17T00:10:01\tSILENT\t0.00\ttest\t\n2026-07-17T00:20:01\tSILENT\t0.00\ttest\t\n' > "$_vh/.mesh/misha-say-verify.log"
  _vout="$(_vrun)"
  printf '%s' "$_vout" | grep -q 'Bose=VOICE-DEAD (fallback note3' \
    || { echo "smoke-test: FAIL (room probe: a 3x-SILENT verify tail does not render VOICE-DEAD — the voice organ field is a constant again; got: $_vout)"; exit 1; }
  # ONE COMPLETE LINE, ON A NODE WHERE THE UNIT IS DOWN — the half of this row nobody was asserting.
  # `systemctl is-active` PRINTS its verdict AND exits non-zero, so a `$(... || echo inactive)` capture
  # yields "inactive\ninactive" and `echo` splits the organs row across two lines: the cam and Bose
  # fields land on an orphan line that no `grep '^organs:'` consumer ever sees. That is invisible on a
  # node whose mesh-overhear is UP (this one), which is exactly why it survived the sweep that fixed
  # the sibling `stt` field and shipped rc=1 to phaedra instead. Driven with a stub systemctl that
  # REPRODUCES print-and-exit-nonzero, so the assertion holds on every node regardless of local unit
  # state. Seen RED with the `|| echo inactive` capture restored.
  _sd="$MESH_TEST_TMPD/sysctl-stub"; mkdir -p "$_sd"
  printf '#!/bin/sh\ncase "$*" in *is-active*) echo inactive; exit 3 ;; esac\nexit 1\n' > "$_sd/systemctl"
  chmod +x "$_sd/systemctl"
  _dout="$(HOME="$_vh" PATH="$_sd:$PATH" bash -c "$_probe" 2>/dev/null | grep '^organs:')"
  printf '%s' "$_dout" | grep -qE '^organs: mic-daemon=[^ ]+ \| cam=.* \| Bose=.+$' \
    || { echo "smoke-test: FAIL (room probe: with a DOWN unit the organs row is not one complete line — the cam/Bose fields fell onto an orphan line; got: $_dout)"; exit 1; }
  [ "$(printf '%s\n' "$_dout" | grep -c '^organs:')" = 1 ] \
    || { echo "smoke-test: FAIL (room probe: a DOWN unit produced $(printf '%s\n' "$_dout" | grep -c '^organs:') organs rows — the row was torn in two)"; exit 1; }
  printf '2026-07-17T00:00:01\tSILENT\t0.00\ttest\t\n2026-07-17T00:10:01\tOK\t0.62\ttest\t\n' > "$_vh/.mesh/misha-say-verify.log"
  _vout="$(_vrun)"
  printf '%s' "$_vout" | grep -q 'Bose=OK (verified' \
    || { echo "smoke-test: FAIL (room probe: an OK verify tail does not render the OK verdict in the organ line; got: $_vout)"; exit 1; }
  rm -f "$_vh/.mesh/misha-say-verify.log"
  _vout="$(_vrun)"
  printf '%s' "$_vout" | grep -q 'Bose=unverified' \
    || { echo "smoke-test: FAIL (room probe: an absent verify log does not render unverified — absence must be its own third string, never a healthy default; got: $_vout)"; exit 1; }
  rm -rf "$_vh"

  # the allocation block must render the dispatch GATE, not just idle/open counts — a frame that
  # shows hands+work and hides the governor holding them is why every mind hand-probed mesh-pace.
  # Asserted against a REAL minds frame (never the source text), in CACHE-ONLY mode: mesh-pace --status
  # measured 22.6-24.0s on 2026-08-10, so any test that pays that scan (the old failure-branch probe, or
  # a cold-cache render) burns ~28s of mesh-land's `timeout 30` and strands the dash on latency alone.
  # The cached row IS the discriminator the expensive probe used to be: row present + gate line missing
  # = regression (FAIL); no cached row = nothing to assert yet (exit 2, honest n/a — the live pane
  # refreshes it every 150s, so on any node with a minds pane this arm is the real one).
  out="$(MESH_DASH_FAST=1 MESH_DASH_PACE_CACHE_ONLY=1 "$0" --once minds 2>&1)" || { echo "smoke-test: FAIL (minds render exited non-zero)"; exit 1; }
  if printf '%s' "$out" | grep -qE '^  gate: dispatch (HELD|READY)'; then
    # the NUMBER must be the right column. The READY branch used to print eff_gap (the requirement)
    # labelled "elapsed"; assert the rendered elapsed against last_age from the same cached row, so a
    # revert to $3 goes red instead of quietly re-mislabelling a line minds read to explain a hold.
    if printf '%s' "$out" | grep -qE '^  gate: dispatch READY'; then
      _pel="$(printf '%s' "$out" | sed -nE 's/^  gate: dispatch READY — ([0-9]+)m elapsed.*/\1/p' | head -1)"
      _pwant="$(awk '$1=="dispatch"{printf "%d", $2/60}' "$PACE_CACHE" 2>/dev/null)"
      [ -n "$_pel" ] && [ -n "$_pwant" ] && [ "$_pel" = "$_pwant" ] \
        || { echo "smoke-test: FAIL (dispatch READY renders '${_pel:-?}m elapsed' but the cached row's last_age is ${_pwant:-?}m — wrong column, the requirement is not the elapsed)"; exit 1; }
    fi
  elif [ -s "$PACE_CACHE" ] && awk '$1=="dispatch"{f=1} END{exit !f}' "$PACE_CACHE"; then
    echo "smoke-test: FAIL (minds frame missing the dispatch pace gate — a cached dispatch row exists, so the line is renderable)"; exit 1
  else
    echo "smoke-test: n/a (no cached mesh-pace dispatch row — gate line unassertable, not regressed)"; exit 2
  fi
  # the division-of-labour axis must render mesh-forage's OUTPUT, not just its (unconditional) header
  # echo — assert a jq-PRODUCED line ('intended J=' or the empty-board fallback), which is silent if
  # the mesh-forage|jq pipe breaks or is mis-wired. Guarded on mesh-forage/jq: skipped where the axis
  # is honestly unrenderable, never a false green. (Same REAL-frame discipline as the gate above.)
  if command -v mesh-forage >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
    printf '%s' "$out" | grep -qE '^  (intended J=|no owner-assigned \[task\]s)' \
      || { echo "smoke-test: FAIL (minds frame missing the division-of-labour axis — mesh-forage output not wired into the pane)"; exit 1; }
  fi
  # ---- THE SPLIT'S OWN GATE ------------------------------------------------------------------------
  # The fast core exists for exactly one reason: to fit inside mesh-doctor's `timeout 12` parallel cap.
  # That is a MEASUREMENT, and it rots the moment a cheap-looking gate is added above the boundary —
  # at which point the doctor silently goes back to timing out on this file and nothing says so. So
  # measure it here, in the full suite (which mesh-land runs in the quiet at landing, not under the
  # INBOX SEEN-KEY. The block filters already-ground drops out of "pending gestures" by looking the
  # file's content hash up in .records-seen — and it extracted that hash with `clip 8`, a DISPLAY
  # function that since the 2026-08-19 marker change replaces the last kept glyph with "…". The key
  # was "8f7e9a5…", never "8f7e9a52", so the lookup could never match: every inbox file read UNSEEN
  # and the 4-line display cap hid how total it was — the live pane showed 4 already-ground files as
  # open gestures ("grinds first, never evicted") for days. That is the exact false claim the block
  # was written to kill. Drive the REAL render with a sandboxed inbox whose one file IS in the
  # sandboxed seen-store: it must report none pending. Falsify by restoring `clip 8`.
  _ib="$(mktemp -d)"; mkdir -p "$_ib/inbox"
  printf 'RIFFxxxxWAVEfmt ' > "$_ib/inbox/already-ground.wav"
  sha1sum "$_ib/inbox/already-ground.wav" | cut -c1-8 > "$_ib/.records-seen"
  _ibo="$(MESH_DIR="$_ib" "$0" --once sound 2>&1 | sed -n '/^-- INBOX/,/^-- RENDERS/p')"
  case "$_ibo" in
    *already-ground.wav*)
      echo "smoke-test: FAIL (a file whose hash IS in .records-seen still rendered as a pending gesture — the inbox seen-key does not match the store's format, so every ground drop reads as the operator waiting)"; rm -rf "$_ib"; exit 1 ;;
  esac
  case "$_ibo" in
    *"none pending"*) : ;;
    *) echo "smoke-test: FAIL (the inbox block rendered neither the file nor a 'none pending' line — the leg is asserting nothing: '$_ibo')"; rm -rf "$_ib"; exit 1 ;;
  esac
  rm -rf "$_ib"

  # doctor's own storm). 12 is the doctor's literal cap; the margin is deliberate slack, not padding.
  _tf_t0="$SECONDS"
  MESH_TEST_TMPD="${MESH_TEST_TMPD:-}" "$0" --test-fast >/dev/null 2>&1 \
    || { echo "smoke-test: FAIL (--test-fast did not exit 0 — the gate the doctor actually drives is red or absent)"; exit 1; }
  _tf_el=$(( SECONDS - _tf_t0 ))
  [ "$_tf_el" -le 9 ] \
    || { echo "smoke-test: FAIL (--test-fast took ${_tf_el}s — mesh-doctor's parallel pass grants 'timeout 12', so the fast core is back to being a gate no runner can reach; move a leg below the boundary)"; exit 1; }
  # ...and the header the doctor greps must be THERE. Without it _test_arg falls back to --test and the
  # split buys nothing: the doctor times out exactly as before, silently. Anchored at '^#', so this
  # grep's own (indented) line cannot satisfy it — a self-matching gate asserts its own text.
  grep -Eq '^#[[:space:]]*test-fast:[[:space:]]*yes([^a-z0-9]|$)' "$0" \
    || { echo "smoke-test: FAIL (the '# test-fast: yes' declaration is gone — mesh-doctor's _test_arg will drive the full 68s suite under a 12s cap again)"; exit 1; }

  if [ -n "$_NA_REASONS" ]; then
    echo "smoke-test: n/a (every leg that could run on this node PASSED; the following could not run here — a NODE condition, not a code verdict):$_NA_REASONS"
    exit 2
  fi
  echo "smoke-test: ok"; exit 0
fi
[ "${1:-}" = --once ] && { ONCE=1; shift; }   # render one frame and exit (no clear/sleep) — for --test
role="${1:-steward}"; M="${MESH_DIR:-$HOME/.mesh}"; REPO="$HOME/lte-workstation"
# pub channel's DATA pane is its OWN two-half dash (mesh-pub-dash: WRITE-ABOUT | external COMMENTS) —
# not a role rendered here. Hand off entirely so `mesh-dash pub` (the manifest's top-pane cmd) IS it.
if [ "$role" = pub ] && [ -x "$HOME/.local/bin/mesh-pub-dash" ]; then
  [ "${ONCE:-0}" = 1 ] && exec "$HOME/.local/bin/mesh-pub-dash" --once || exec "$HOME/.local/bin/mesh-pub-dash"
fi
# witness channel: NOTE — this used to hand the whole pane off to `mesh-witness --pane` here, before
# any helper is defined. Since the chat→witness merge (operator 2026-07-24) the witness pane is a
# TWO-HALF dash (tape ABOVE, board BELOW) and the board half needs self_meter/mesh-claim, so the role
# now renders through the normal case dispatch below. The blank-pane guard the old loop existed for
# (phaedra witness blank-pane flaps, 2026-07-08) is kept in kind, not in form: the main loop captures
# the whole frame into a var BEFORE `clear`, and the witness case emits its section headers
# unconditionally — so a hung/erroring mesh-witness degrades to a header with an ERROR line under it,
# never to the visible blank a bare clear-then-render raced into.
# SELF-REEXEC ON CODE UPDATE — a long-lived pane keeps its FIRST in-memory parse of this script, so a
# dash edit (e.g. dropping a block) leaves every running pane rendering the OLD layout with stale data
# until someone manually respawns it (operator-caught 2026-06-15: plan pane stale 1d22h after an edit).
# Fix at the source: stamp our own mtime at startup; each loop, if the file on disk is NEWER, exec the
# fresh code in place. No respawn list to maintain, no external reflex — every role self-heals within
# one refresh cycle of a deploy. ONCE/test path skips it (single frame, no loop).
SELF="$(command -v "$0" 2>/dev/null || echo "$0")"
SELF_MTIME="$(stat -c %Y "$SELF" 2>/dev/null || echo 0)"
# per-role refresh: organs fans out SSH to every peer (keep it cool); reflexes is local-cheap;
# room is a LIVE transcript the operator watches while talking — repaint every 3s, and the room case
# refreshes its ds cross-node cache every 3s too, so new transcript lines show within a few seconds.
# witness keeps the 15s cadence its bespoke loop had before the chat merge — the tape is a live
# measurement stream and the whole point of the channel is reading it AS it moves; the board half's
# one expensive read (mesh-claim) is cache-throttled to 60s inside the role so the faster repaint
# costs nothing extra.
case "$role" in organs) SLEEP=300 ;; reflexes) SLEEP=60 ;; room) SLEEP=3 ;; witness|chat) SLEEP=15 ;; *) SLEEP=30 ;; esac

clip(){ # width-clip stdin to $1 CHARACTERS — never bytes
  # `cut -c` is BYTE-wise in GNU coreutils despite its name, so it splits a multibyte character
  # whenever the clip lands mid-glyph. The operator's material is Russian: chat lines, voice
  # transcripts, PLAN.md and every board quote are Cyrillic, i.e. 2 bytes per character, so a
  # byte clip lands mid-character roughly half the time. Measured 2026-08-19: the adint frame
  # ended `…захват ПЕРЕ<0xd0>` and the pane-height gate's python row-counter died on it with
  # UnicodeDecodeError — printing an EMPTY row count into "adint frame is  wrapped rows", which
  # its own `${_adr:-99}` default then read as an overflow. So one split glyph both corrupted the
  # frame and made the gate that guards the frame report a fabricated number for the wrong reason.
  # GNU sed IS multibyte-aware under a UTF-8 locale: `.` matches a character, so this clips at N
  # glyphs and can never emit a partial one. Lines shorter than N pass through untouched.
  #
  # AND A CUT LINE IS MARKED (2026-08-19, health's 20:20Z [task] dash-egress-clip-eats-the-
  # measurements-and-leaves-the-prose). Until now this appended NOTHING, so a truncated line was
  # visually indistinguishable from a complete one — the pane showed `…where=hop1-bad (enantiostasis:
  # var`, an unclosed paren and a token cut mid-word that reads like a VALUE, and nothing anywhere
  # said a cut had happened. A fixed width is a silent contract between the producer and this
  # renderer, and when a producer grows its line NOTHING fails: no error, no marker, just fewer
  # facts. The marker is the only thing that turns that silence into a signal.
  # WIDTH IS PRESERVED EXACTLY: the marker REPLACES the last kept glyph rather than being appended,
  # so a clipped line is still $1 characters and no frame gets one column wider (an overflowing
  # frame reads as a frozen pane). The `..\+` tail requires at least TWO characters beyond $1-1,
  # i.e. it fires only when the line is genuinely LONGER than $1 — a line of exactly $1 characters
  # fits and passes through unmarked, so the marker can never claim a cut that did not happen.
  local _n="$1" _m="${MESH_DASH_CLIP_MARK:-…}"
  sed "s/\(.\{$((_n-1))\}\)..\+/\1$_m/"
}

rows_of(){ # how many ROWS does stdin PAINT in a $1-column pane?
  # Every height budget in this file — the ceiling gate, the overflow lease, the state-wall cap —
  # is spent in rows, and until 2026-08-19 every one of them counted LINES. A line longer than the
  # pane costs ceil(len/width) rows, so the check frame sat at 34 lines (its exact ceiling) and 46
  # rows, i.e. 12 rows past the limit, invisible to the limit. Count what the pane paints.
  # Characters, never bytes (the frame is full of ·/—/… and Cyrillic board text), and a corrupt
  # byte costs one column instead of killing the counter — a counter that dies on its input hands
  # its caller a fabricated verdict.
  python3 -c 'import sys
w = int(sys.argv[1]) if len(sys.argv) > 1 and sys.argv[1].isdigit() and int(sys.argv[1]) > 0 else 80
d = sys.stdin.buffer.read().decode("utf-8", "replace")
if d.endswith("\n"): d = d[:-1]
print(sum(max(1, -(-len(l) // w)) for l in d.split("\n")) if d else 0)' "${1:-80}" 2>/dev/null || echo 0
}

age_of(){ # human age of a file's last touch — "how fresh is this perception"
  local f="$1" a; [ -f "$f" ] || { echo "-"; return; }
  a=$(( $(date +%s) - $(stat -c %Y "$f" 2>/dev/null || echo 0) ))
  if   [ "$a" -ge 86400 ]; then echo "$((a/86400))d"
  elif [ "$a" -ge 3600 ];  then echo "$((a/3600))h"
  elif [ "$a" -ge 60 ];    then echo "$((a/60))m"
  else echo "${a}s"; fi
}
_dur_hm(){ # seconds → compact duration, for a CONDITION that has been holding (not a file age)
  local s="${1:-0}"
  if   [ "$s" -ge 3600 ]; then printf '%dh%02dm' $(( s / 3600 )) $(( (s % 3600) / 60 ))
  elif [ "$s" -ge 60   ]; then printf '%dm' $(( s / 60 ))
  else printf '%ds' "$s"; fi
}
age_bucket(){ # COARSE freshness bucket — a top pane shows fresh/stale, not an exact second-by-second age
  # that re-renders (and re-wakes the consuming mind) every frame (operator 2026-06-25 top-pane rule).
  local f="$1" m; [ -f "$f" ] || { echo "-"; return; }
  m=$(( ( $(date +%s) - $(stat -c %Y "$f" 2>/dev/null || echo 0) ) / 60 ))
  if   [ "$m" -lt 30 ];  then echo "<30m"
  elif [ "$m" -lt 60 ];  then echo "30-60m"
  elif [ "$m" -lt 180 ]; then echo "1-3h"
  else echo "3h+"; fi
}
age_bucket_room(){ # FINE freshness bucket for ROOM senses — fresh/recent/stale carries the live
  # "did the reflex stall?" signal yet kills the per-second/per-minute (Ns)/(Nm) churn that re-woke
  # the room mind every frame (operator 2026-06-25: top-pane liveness is the room block's own job).
  # $2 = stale-after seconds, judged against the WRITER's real cron stride — the old hardcoded 600s
  # assumed a */5 stride while the fusion crons run 2-59/15, branding a healthy reflex "stale" for
  # the last third of every cycle (age-vs-cadence mislabel, 2026-07-02).
  local f="$1" stale_after="${2:-600}" s; [ -f "$f" ] || { echo "-"; return; }
  s=$(( $(date +%s) - $(stat -c %Y "$f" 2>/dev/null || echo 0) ))
  if   [ "$s" -lt 120 ]; then echo "fresh"
  elif [ "$s" -lt "$stale_after" ]; then echo "recent"
  else echo "stale"; fi
}
# The ALARM alphabet is deliberately a list of BAD words, never a whitelist of good ones. The 120
# reflex states share NO vocabulary (OK · HEALTHY · QUIET · STABLE · lit:relevance · MASK=4608 · a
# bare device name …), so any green-list would silently reclassify every value it had never seen as
# fine — the a-guards-alphabet-must-match-its-patterns trap. Unmatched values are counted and NAMED
# "quiet/unclassified"; they are never called clean.
# \b on BOTH ends, or the word matches inside a benign one: WINDING_DOWN (a healthy evening rhythm)
# hit the bare DOWN and read as a sev-1 alarm. `_` is a word constituent in ERE, so \bDOWN\b correctly
# refuses WINDING_DOWN while still matching "DOWN|..." and "GPU DOWN".
_STATE_ALARM_RE='\b(CRIT|CRITICAL|FAIL|FAILED|FAULT|DOWN|DEAD|DEGRADED|OFFLINE|UNREACHABLE|DARK|STALE|ERROR|BLOCKED|WARN|ALERT|LOST|BAD)\b'
_STATE_SEV1_RE='\b(CRIT|CRITICAL|FAIL|FAILED|FAULT|DOWN|DEAD|OFFLINE|UNREACHABLE|LOST)\b'
# ── SOURCE CLASS: which alarms are one absent INPUT, reported honestly, N times over ──
# The classification above is CONTENT-ONLY, and the liveness-touch convention deliberately writes an
# alarm word (OFFLINE) into content when a sense's SOURCE is unreachable — mtime = "the reflex ran",
# content = "its input is gone" — while still exiting 2, which a state-FILE reader cannot see. So one
# unreachable phone reported correctly by four senses is four alarms, string-identical to four faults
# (health, 2026-08-18: "10 alarm", 4 of them one phone). The seam that already knows which senses hang
# off the phone is each tool's `# doctor-artifact: <path> <ttl> <reach_gate>` header — the same line
# mesh-doctor's theater gate reads, and for the same reason (a legitimately-absent artifact is not a
# fault). Index it path→gate and PARTITION the alarm count by it.
# NEVER A FILTER, and the distinction is the whole point of the fix: the total is untouched, and an
# organ carrying NO header is counted AND NAMED (`src?`), never folded into the fault
# remainder. A category that silently drops its unclassified members shrinks the denominator and reads
# cleaner while staying wrong — worse than the honest overcount it replaces.
_STATE_SRCDOWN_RE='\b(OFFLINE|UNREACHABLE|BLIND|DOWN)\b'
# ── FIELD VOCABULARY: an alarm word that is a SENSE'S OWN BAND NAME, not a verdict ──
# The scan above is content-only and word-matches an alarm alphabet ANYWHERE in a state's first 30
# bytes. That reds a perfectly healthy sense whose own recency vocabulary happens to reuse one of the
# words. Live and measured (health, 2026-08-19T17:05Z): `.tamper-state` reads
# `quiet|1787159105|8|STALE|6|ATTRIBUTED|NONE|NA` with a 50s-old mtime — verdict field 1 is `quiet`,
# and the STALE in field 4 is mesh-tamper's OWN documented band (`classify_recency`, mesh-tamper:105-122:
# ACTIVE 0-5m · RECENT 5-30m · STALE 30m-2h "historical, body has been at rest" · COLD >2h · NEVER).
# The alarm is INVERTED-MONOTONE: STALE is less concerning than COLD, and COLD does not red. It is not
# rare either — STALE is a 90-MINUTE band opening 30 min after every tamper event — and it had already
# PROPAGATED: `.window-state` carries `MOTION|tamper=STALE|...`, so one benign token reds TWO states
# from one root. It is also REDUNDANT: the header's own `N stale(>1h)` axis measures staleness from
# MTIME, which no vocabulary can fool.
# THE FIX IS POSITIONAL, NEVER LEXICAL. Dropping STALE from the alphabet would trade a false red for a
# false GREEN across every other sense that writes it meaning a genuinely dead input — the worse
# direction. Instead a sense DECLARES, beside the `# doctor-artifact:` header it already carries:
#     # doctor-vocab: <artifact-path> <field-index>:<comma-separated allowed values>
# and the scan blanks that pipe-field ONLY when its value is EXACTLY one of the declared words. Three
# properties are deliberate: (a) format drift, a new band, or a real alarm word landing in that slot
# all FAIL TOWARD ALARMING, because an undeclared value is not exempt; (b) the 30-byte scan window is
# unchanged, so a vocab field truncated past byte 30 simply is not exempted (again the safe
# direction); (c) it is NEVER A SILENT FILTER — every suppression is counted and NAMED on the header
# line (`N vocab-exempt`), outside the alarm parenthetical so the partition invariant
# nphd + nsu + faults == nal still holds exactly.
declare -A _SRC_GATE=()
declare -A _SRC_VOCAB=()
_load_src_gates(){ # ONE grep over the tool dir per render; path→reach_gate and path→vocab spec
  local d="${MESH_DASH_TOOLDIR:-$HOME/.local/bin}" line f p g
  _SRC_GATE=(); _SRC_VOCAB=()
  while IFS= read -r line; do
    f="${line%%:*}"; line="${line#*:}"
    case "$line" in
      '# doctor-artifact:'*)
        # shellcheck disable=SC2086
        set -- ${line#\# doctor-artifact:}
        p="${1:-}"; g="${3:-local}"
        [ -n "$p" ] || continue
        p="${p/\$HOME/$HOME}"; p="${p/#\~/$HOME}"
        _SRC_GATE["$p"]="$g" ;;
      '# doctor-vocab:'*)
        # shellcheck disable=SC2086
        set -- ${line#\# doctor-vocab:}
        p="${1:-}"; g="${2:-}"
        [ -n "$p" ] && [ -n "$g" ] || continue
        p="${p/\$HOME/$HOME}"; p="${p/#\~/$HOME}"
        _SRC_VOCAB["$p"]="$g" ;;
      *) continue ;;
    esac
  done < <(grep -m4 -H -e '^# doctor-artifact:' -e '^# doctor-vocab:' "$d"/mesh-* 2>/dev/null)
}
# _vocab_mask <value> <spec> → the value with declared vocabulary fields blanked. Pure; no state.
# spec = "<field-index>:<v1>,<v2>,..." (repeatable, space-separated). A field is blanked ONLY on an
# exact match against the declared list — anything else is left in place to be scanned as before.
_vocab_mask(){
  local v="$1" spec="$2" one idx allow i out cur
  local -a parts=()
  IFS='|' read -r -a parts <<< "$v"
  for one in $spec; do
    idx="${one%%:*}"; allow="${one#*:}"
    case "$idx" in ''|*[!0-9]*) continue ;; esac
    [ "$idx" -ge 1 ] 2>/dev/null || continue
    i=$(( idx - 1 )); [ "$i" -lt "${#parts[@]}" ] || continue
    cur="${parts[$i]}"
    case ",$allow," in *",$cur,"*) parts[$i]='' ;; esac
  done
  out=""
  for i in "${!parts[@]}"; do out="$out${parts[$i]}|"; done
  printf '%s' "${out%|}"
}
state_wall(){ # EVERY edge-trigger reflex state, one live line each — grows as reflexes grow
  # --alerts [N]: the SUMMARIZING form (the check pane's). The full wall is 120+ lines painted into a
  # ~27-row pane, and a pane shows a tall frame's TAIL — so the only thing the health mind could ever
  # see was the alphabetical tail (s..w) of the dump, with FLEET/DOCTOR/VPN/vitals/GPU/organs all
  # scrolled off above it. Every one of those reads was live and honest and NONE of them was visible.
  # Rule: a wall that grows with the reflex count cannot be the pane's bulk — summarize, cap, and say
  # the totals on the header so a capped remainder is STATED, never silently dropped.
  # The cap is ELASTIC, not a constant: the states block is the last section, so it gets whatever rows
  # the pane has left after the fixed sections (~24 rows for the check role). A hardcoded 6 either
  # overflows a short pane or wastes a tall one — and the remainder is always NAMED either way.
  local mode=full cap=6
  case "${1:-}" in --alerts) mode=alerts; cap="${2:-}"
    if [ -z "$cap" ]; then
      cap=6; [ "${_PANE_ROWS:-0}" -gt 0 ] && { cap=$(( _PANE_ROWS - 24 )); [ "$cap" -lt 2 ] && cap=2; }
    fi ;;
  esac
  local f n v vs a now tier src total=0 nq=0 nal=0 nst=0 nphd=0 nsu=0 nvx=0 grp=""
  local -a hits=()
  now=$(date +%s)
  [ "$mode" = alerts ] && _load_src_gates
  for f in "$M"/.[a-z]*-state; do
    [ -f "$f" ] || continue
    n="${f##*/}"; n="${n#.}"
    case "$n" in mind-state-*) continue;; esac   # minds get their own wall
    v="$(head -c30 "$f" 2>/dev/null | tr '\n' ' ')"
    if [ "$mode" = full ]; then
      printf '  %-22s %-16s age %s\n' "${n%-state}" "$v" "$(age_of "$f")"
      continue
    fi
    total=$((total+1))
    a=$(( now - $(stat -c %Y "$f" 2>/dev/null || echo 0) ))
    # SCAN VALUE, not display value: `v` is what the row prints; `vs` is `v` with the sense's own
    # declared band vocabulary blanked. They differ only where a `# doctor-vocab:` header exists, and
    # a suppression is counted (nvx) and named on the header line — never silently dropped.
    vs="$v"
    if [ -n "${_SRC_VOCAB[$f]-}" ]; then
      vs="$(_vocab_mask "$v" "${_SRC_VOCAB[$f]}")"
      if [ "$vs" != "$v" ] && printf '%s' "$v" | grep -qiE "$_STATE_ALARM_RE" \
         && ! printf '%s' "$vs" | grep -qiE "$_STATE_ALARM_RE"; then
        nvx=$((nvx+1))
      fi
    fi
    if printf '%s' "$vs" | grep -qiE "$_STATE_ALARM_RE"; then
      # Tiers order the CAPPED display as well as the count: 1/2 = a fault the node must look at,
      # 3 = a source-down the node already knows about (it must not push a real fault off the pane),
      # 4 = stale. src=UNDECLARED cannot be told apart from a fault and is therefore never demoted.
      src="${_SRC_GATE[$f]-UNDECLARED}"
      tier=2; printf '%s' "$vs" | grep -qiE "$_STATE_SEV1_RE" && tier=1
      nal=$((nal+1)); grp=""
      if [ "$src" = phone ] && printf '%s' "$vs" | grep -qiE "$_STATE_SRCDOWN_RE"; then
        tier=3; nphd=$((nphd+1)); grp=" [phone-down]"
      elif [ "$src" = UNDECLARED ]; then
        nsu=$((nsu+1)); grp=" [src?]"
      fi
      hits+=("$tier$(printf '  ✗ %-20s %-30s age %s%s' "${n%-state}" "$v" "$(age_of "$f")" "$grp")")
    elif [ "$a" -gt 3600 ]; then
      nst=$((nst+1)); hits+=("4$(printf '  ⌛ %-20s %-30s age %s' "${n%-state}" "$v" "$(age_of "$f")")")
    else
      nq=$((nq+1))
    fi
  done
  [ "$mode" = full ] && return 0
  # The parenthetical is a PARTITION of the alarm count, printed only when there is one to partition:
  # nphd + nsu + (attributable faults) == nal, always. Both named members are stated even at 0 once
  # any alarm exists, so "no phone-down today" is a reading, not a silence.
  # THE NAMES ARE THE ROWS' OWN (2026-08-19). This partition cost 38 of the row's 85 columns
  # and the row is the frame's densest; `src?` here and `[src?]` on every row beneath
  # it were two spellings of one class, so the short form is both narrower AND the one a reader
  # can match against what is printed below. The invariant is unchanged: nphd + nsu +
  # (attributable faults) == nal.
  grp=""
  [ "$nal" -gt 0 ] && grp=" ($nphd phone-down, $nsu src?)"
  # nvx sits OUTSIDE the parenthetical on purpose: an exempted state is NOT an alarm, so folding it
  # in would break the partition invariant the line above states. Printed only when it fired, and it
  # names the count so a suppression is always visible on the same line as the totals.
  local vxs=""; [ "$nvx" -gt 0 ] && vxs=" · $nvx vocab-ex"
  # the trailing `— full wall: mesh-dash --once reflexes` was 38 columns of instruction sitting
  # on the frame's densest measurement row; how to see the wall is documented, not re-printed
  # 2880 times a day at the cost of the counts themselves.
  printf '  %s states: %s alarm%s · %s stale · %s quiet%s\n' \
    "$total" "$nal" "$grp" "$nst" "$nq" "$vxs"
  local shown=0 h
  while IFS= read -r h; do
    [ -n "$h" ] || continue
    shown=$((shown+1)); [ "$shown" -le "$cap" ] && printf '%s\n' "${h#?}"
  done < <(printf '%s\n' ${hits[@]+"${hits[@]}"} | sort)
  [ "$shown" -gt "$cap" ] && printf '  … +%s more alarm/stale not shown (cap %s)\n' "$(( shown - cap ))" "$cap"
  return 0
}
mind_wall(){ # last classified pane-state per mind channel (watcher re-derives these)
  local f
  for f in "$M"/.mind-state-*; do
    [ -f "$f" ] || continue
    printf '  %-8s %-14s age %s\n' "${f##*-}" "$(head -c20 "$f" 2>/dev/null | tr '\n' ' ')" "$(age_of "$f")"
  done
}
beat_wall(){ # liveness beats — own heart, peers' hearts, reflex per-run beats
  local f n
  for f in "$M"/heartbeat*.beat "$M"/.*.beat; do
    [ -f "$f" ] || continue
    n="${f##*/}"; n="${n%.beat}"; n="${n#.}"; n="${n#heartbeat-}"; [ "$n" = heartbeat ] && n=self
    printf '  %-28s age %s\n' "$n" "$(age_of "$f")"
  done
}
# --- enrichment helpers (operator 2026-06-15: "data pane can be much more helpful") ---
stress_line(){ # the node's KNOWN FAILURE MODE first — the operator channel dies from heat (thermal throttle)
  local s; s="$(timeout 8 mesh-stress 2>/dev/null | sed 's/^mesh-stress: //')"
  [ -n "$s" ] && printf 'STRESS %s' "$s" || printf 'STRESS (unknown)'
}
actionable_minds(){ # ONLY minds that need a hand (the steward's job = drive these); else a one-line all-clear
  local f n st hits=0 total=0
  for f in "$M"/.mind-state-*; do
    [ -f "$f" ] || continue
    total=$((total+1)); n="${f##*-}"; st="$(head -c20 "$f" 2>/dev/null | tr -d '\n ')"
    case "$st" in BLOCKED*|NEEDS-INPUT*|RATE-LIMITED*|DEAD*)
      printf '  ⚠ %-8s %-14s age %s\n' "$n" "$st" "$(age_of "$f")"; hits=$((hits+1)) ;;
    esac
  done
  [ "$hits" = 0 ] && printf '  ✓ none blocked — %s minds idle/working\n' "$total"
}
open_work(){ # in-flight work = recent [taking] on the board today (real work, NOT vanity done-counts)
  local td lines; td=$(date -u +%F)
  lines="$(grep "$td" "$M/chat.log" 2>/dev/null | grep -oE '\[taking\].*' | tail -4)"
  if [ -n "$lines" ]; then printf '%s\n' "$lines" | clip 92 | sed 's/^/  /'
  else printf '  (no work claimed today)\n'; fi
}
# --- per-mind CONTEXT + SPEND self-meter (operator 2026-06-17: "keep track context (and /compact) +
# spend, depending on the mind"). The mesh-mind-compact + mesh-spend reflexes PRODUCE this; the data
# pane shows it; the mind acts on it (high ctx → it can /compact itself). "Depending on the mind" is
# real: opencode minds expose a readable context-% + $cost; claude minds don't (they auto-compact) —
# their spend is quota turns (mesh-spend --tokens). ONE cheap --stats call per window. ---
mind_engine(){ awk -v w="$1" '$1==w{print $2; exit}' "$M/minds.map" 2>/dev/null; }
self_meter(){ # $1=window — one line the OWNING mind reads to self-manage its context/spend
  local w="$1" eng line state tok pct doll lcage
  eng="$(mind_engine "$w")"; eng="${eng:-?}"
  line="$(mesh-mind-state --stats "$w" 2>/dev/null | awk -v w="$w" '$1==w{print;exit}')"
  state="$(printf '%s' "$line" | cut -f2 | tr -d ' ')"
  tok="$(printf '%s' "$line" | cut -f4 | tr -d ' ')"
  pct="$(printf '%s' "$line" | cut -f5 | tr -d ' ')"
  doll="$(printf '%s' "$line" | cut -f6 | tr -d ' ')"
  lcage="$(age_of "$M/.compact-$w")"
  # mind_engine reads ~/.mesh/minds.map — an artifact NO tool on this node writes (checked
  # 2026-07-24: absent entirely), so eng was "?" for EVERY window and every opencode channel
  # (senses/health/witness/discover/sound/vpn/tg-roz) got told "claude auto-compacts" while its
  # real ctx% sat unread in the very --stats line above. Fall back to the LIVE reading we already
  # hold: mesh-mind-state renders a real PCT ("3%") for opencode panes and a literal "?" for
  # claude ones, so a parseable PCT IS the opencode branch. The map still wins when it exists.
  # NOTE the quoting: an unquoted ? in a case pattern is a GLOB (any single char), not the literal
  # "?" this fallback is keyed on.
  case "$eng" in
    '?'|"") case "$pct" in [0-9]*%) eng=opencode ;; esac ;;
  esac
  if [ "$eng" = opencode ]; then
    printf '  self: %s · ctx %s (%s) · cost %s · last /clear %s ago (auto >60%%)\n' \
      "${state:-?}" "${pct:-?}" "${tok:-?}" "${doll:-free}" "$lcage"
  else
    # WAS 102 COLUMNS, 22 of them spent on two facts that are no longer true: `/compact` is
    # RETIRED mesh-wide (operator 2026-07-18 — `mesh-clear` is the one lever) and the 45m idle
    # trigger was deleted by design (clears happen at the TASK boundary). A legend that is both
    # wrong and two rows wide is the cheapest width in the frame to give back.
    printf '  self: %s · last /clear %s ago · spend: mesh-spend --tokens\n' \
      "${state:-?}" "$lcage"
  fi
}

while :; do
  # picked up a newer copy of ourselves? re-exec the fresh code in place (kills stale-layout panes)
  if [ "$ONCE" != 1 ]; then
    now_mtime="$(stat -c %Y "$SELF" 2>/dev/null || echo 0)"
    [ "$now_mtime" != "$SELF_MTIME" ] && exec "$SELF" "$role"
  fi
  # How many rows does this pane actually have? Re-read EVERY frame (a pane can be resized under a
  # live loop), so a role that sizes a block to the viewport tracks the real one instead of a value
  # captured at launch. 0 = unknown (not in tmux, or --once) → sizing blocks fall back to a fixed cap.
  # A --once RENDER HAS NO PANE. It goes to a pipe, a capture, a gate — and sizing it to the
  # TERMINAL THAT HAPPENED TO INVOKE IT is how `mesh-dash --test` came to report the tester's window
  # instead of the code: run from a 41-row tmux pane the elastic cap opened to 17 and the check frame
  # rendered 43 lines against its own 34-line ceiling; run from cron (no TMUX_PANE) the same code
  # rendered 33 and passed. Same tool, same node, same minute, opposite verdicts. MESH_DASH_PANE_ROWS
  # pins it explicitly for a caller that really is filling a known viewport (and for the gates below,
  # which must drive the elastic path deliberately rather than inherit it).
  _PANE_ROWS=0
  if [ -n "${MESH_DASH_PANE_ROWS:-}" ]; then
    _PANE_ROWS="$MESH_DASH_PANE_ROWS"
    case "${_PANE_ROWS:-}" in ''|*[!0-9]*) _PANE_ROWS=0 ;; esac
  elif [ "$ONCE" != 1 ] && [ -n "${TMUX_PANE:-}" ]; then
    _PANE_ROWS="$(tmux display-message -p -t "$TMUX_PANE" '#{pane_height}' 2>/dev/null)"
    case "${_PANE_ROWS:-}" in ''|*[!0-9]*) _PANE_ROWS=0 ;; esac
  fi
  # ── A PANE HAS TWO DIMENSIONS AND THE HEIGHT BUDGET ONLY EVER KNEW ONE ────────────────────────
  # (2026-08-19, health's 22:5xZ [task] mesh-dash, measured live on this node.) Everything above
  # counts LINES; a pane renders ROWS, and a line longer than the pane's WIDTH costs
  # ceil(len/width) of them. The check frame was 34 lines — its ceiling exactly — and 46 ROWS at
  # this pane's 80 columns, so 12 rows past its own limit existed and the limit could not see
  # them. The gate's comment ("a pane shows a tall frame's TAIL") was right; its arithmetic
  # implemented half of it. Width is now a first-class budget with the SAME discipline as rows:
  # an explicit pin wins, a LIVE pane may report itself, and a --once render (which goes to a pipe
  # or a gate, not to the terminal that invoked it) is sized by a DECLARED constant so the number
  # a gate reads is a property of the code and not of whoever ran it.
  _DECL_COLS=80
  _PANE_COLS="$_DECL_COLS"
  if [ -n "${MESH_DASH_PANE_COLS:-}" ]; then
    _PANE_COLS="$MESH_DASH_PANE_COLS"
    case "${_PANE_COLS:-}" in ''|*[!0-9]*|0) _PANE_COLS="$_DECL_COLS" ;; esac
  elif [ "$ONCE" != 1 ] && [ -n "${TMUX_PANE:-}" ]; then
    _PANE_COLS="$(tmux display-message -p -t "$TMUX_PANE" '#{pane_width}' 2>/dev/null)"
    case "${_PANE_COLS:-}" in ''|*[!0-9]*|0) _PANE_COLS="$_DECL_COLS" ;; esac
  fi
  # A pane narrower than this cannot hold a measurement anyway; a floor keeps the clip from
  # degenerating into a column of markers on a hand-dragged 12-column pane.
  [ "$_PANE_COLS" -lt 40 ] && _PANE_COLS=40
  # BUILD the frame into a buffer FIRST (the slow data-tools run in here), THEN clear+paint atomically
  # below. A slow/wedged tool now leaves the LAST good frame on screen (with its old timestamp = visibly
  # stale) instead of BLANKING the pane — the failure that made the steward pane go blank (2026-06-15).
  frame="$(
  # one header ROW, not three (title + date + blank). Every row the header spends is a row of real
  # data pushed off the top of a pane that only ever shows the frame's tail.
  printf '== %s data (refresh %ss) — %s — all text ==\n' "$role" "$SLEEP" "$(date -u +%FT%TZ)"
  case "$role" in
    steward)
      # 1. FUSED SITUATION — internal(stress/temp/minds) + external(security) + physical(presence) in one
      #    block. The operator-facing pane LEADS with situational awareness; temp lives here (our failure mode).
      timeout 9 mesh-situation 2>/dev/null | sed -n '1,5p' | sed 's/^==* /SITUATION: /; s/ =*$//' | clip 100 || echo "SITUATION: (unavailable)"
      # 2. substrate + failure-mode detail (therm/router/egress states aren't in the situation block)
      xn=$(timeout 5 tailscale debug prefs 2>/dev/null | python3 -c 'import json,sys;print(json.load(sys.stdin).get("ExitNodeID") or "none")' 2>/dev/null)
      det=$(timeout 6 mesh-stress --json 2>/dev/null | python3 -c 'import json,sys
try:
 d=json.load(sys.stdin); print("therm=%s router=%s egress=%s%s"%(d.get("therm_state"),d.get("router_state"),d.get("egress_state")," CLIMBING" if d.get("climbing")=="yes" else ""))
except Exception: print("")' 2>/dev/null)
      echo "egress $(ip route get 1.1.1.1 2>/dev/null|grep -oP 'dev \K\S+') exitnode=$xn | doctor FAIL=$(head -c4 "$M/.doctor-cron-state" 2>/dev/null || echo '?') | reflexes $(mesh-supervise --status 2>/dev/null|grep -c UP)UP | strands=$(git -C "$REPO" status --short -- scripts/ 2>/dev/null | wc -l) | $det"
      # 3. minds-state lives ONLY in the 'minds' window's data pane (operator 2026-06-15: "minds info
      #    belongs to the minds data pane only, not yours" — it was broken/duplicated here). The minds
      #    window owns the correct live mind-state + idle hands; this pane no longer duplicates it.
      # 4. in-flight work = recent [taking] (what's happening NOW), not a vanity done-count
      echo "-- open work (claimed today) --"; open_work
      # 5. operator inbox — is the operator waiting on us? (steward owns the comms lane)
      echo "-- operator (last in, age $(age_of "$M/voice-in.log")) --"; tail -1 "$M/voice-in.log" 2>/dev/null | clip 100
      # 6. PLAN this tick (PLAN.md uses '## THIS TICK', not the never-existent '## 🔜 NEXT' — audit 2026-06-19)
      echo "-- PLAN: this tick --"; awk '/^## THIS TICK/{f=1;print;next} /^## /{if(f)exit} f' "$M/PLAN.md" 2>/dev/null | grep -vE '^[[:space:]]*$' | clip 92 | head -3
      # 7. recent [done] (replaces the RETIRED feed/work-pump block — it showed 2-day-old dead data)
      echo "-- recent [done] --"; grep -F '[done]' "$M/chat.log" 2>/dev/null | grep -oE '\[done\].*' | tail -3 | clip 92 | sed 's/^/  /' ;;
    clear)
      # THE CLEAR WINDOW (operator 2026-07-18): every /clear, so clears get fixed by numbers not blind.
      # /compact is retired; /clear is the sole context lever. This pane = when cleared · ctx% at clear ·
      # handoff freshness · reason. Ledger written by mesh-mind-compact (task-boundary reflex) + mesh-clear.
      echo "== CLEAR-LOG — every /clear (when · ctx · handoff coverage) =="
      timeout 8 mesh-clear-log --stats 2>/dev/null || echo "  (clear-log unavailable)"
      echo; echo "-- recent clears --"
      timeout 8 mesh-clear-log --tail 12 2>/dev/null | clip 118 || echo "  (none)" ;;
    check)
      # THE STATE BLOCK GETS THE ROWS THAT ARE LEFT, MEASURED — not the rows a constant guessed were
      # left. Everything above it is captured first and COUNTED, so the frame's height is bounded by
      # construction instead of by hope. The old elastic cap (`_PANE_ROWS - 24`) was a fixed guess at
      # the size of a section that GROWS with the node's condition: 9 doctor fails + 8 DARK organs
      # spend 32 rows before the state wall says a word (measured), so on a sick node the guess is
      # 7 rows wrong and the pane silently eats its own top — precisely the failure this ceiling
      # exists to prevent, arriving exactly when the node is worst. The gate could not see it either:
      # the worst-case leg drives a fixture $HOME with NO reflex states, so the block it is bounding
      # renders empty there. Cap and remainder are unchanged in kind — the remainder is still NAMED.
      _pre="$(
      # UNIFIED node-health view — absorbs the old standalone organs + reflexes windows (operator
      # 2026-06-13: "none without a mind, merge into bigger ones"). One mind (this channel) watches
      # doctor + organs + reflexes + vitals + streams, re-derived live.
      sup="$(mesh-supervise --status 2>/dev/null)"
      # retry once on a transient empty read — else the count flips to a phantom 0UP/0DOWN
      # full-outage (intermittent torn read of the supervise state, observed 2026-06-25)
      [ -z "$sup" ] && { sleep 1; sup="$(mesh-supervise --status 2>/dev/null)"; }
      # ONE READ, REUSED — same discipline as $sup above, which got it after a torn read flipped the
      # count to a phantom 0UP/0DOWN. The organ read beside it did NOT: the header invoked
      # `mesh-organ-keepalive --status` TWICE (once for the LIVE count, once for the DARK count) and
      # the roster section below a THIRD time, so one frame published three independent probes of a
      # LIVE-probing producer as though they were one fact. OBSERVED 2026-08-17T23:02Z: the header
      # read `organs 12LIVE/1DARK` while the section three lines down read `all LIVE (none DARK)` —
      # body-motion flipped between the probes. The header's own two numbers came from two different
      # invocations, so NLIVE/MDARK need not even sum to the roster. Also 3x the probe cost per 30s
      # redraw, and these probes ssh out over the chronically-wedging sole uplink.
      organs="$(mesh-organ-keepalive --status 2>/dev/null)"
      [ -z "$organs" ] && { sleep 1; organs="$(mesh-organ-keepalive --status 2>/dev/null)"; }
      # An EMPTY read must never render as all-clear. grep -c on "" yields 0/0, which the header shows
      # as `0LIVE/0DARK` and the section below as "all LIVE (none DARK)" — a failed probe wearing the
      # exact words of a healthy roster. n/a is a claim about the node; a fabricated calm is not.
      if [ -n "$organs" ]; then
        _orgc="organs $(printf '%s' "$organs"|grep -c LIVE)LIVE/$(printf '%s' "$organs"|grep -c DARK)DARK"
      else
        _orgc="organs n/a (keepalive --status unreadable — NOT a clean roster)"
      fi
      self_meter health   # this mind's own context/spend (opencode: ctx% + $cost; /compact >60%)
      echo "egress $(ip route get 1.1.1.1 2>/dev/null|grep -oP 'dev \K\S+') | supervised $(printf '%s' "$sup"|grep -c UP)UP/$(printf '%s' "$sup"|grep -c DOWN)DOWN | $_orgc"
      # FLEET-WIDE health (operator 2026-06-14: every window = the WHOLE mesh, not just this node).
      # LIVE (operator 2026-06-19: Health must react to LIVE data, not a silently-rotting cache — the
      # old */10 cron was never wired, so this sat 2 DAYS stale showing dead nodes). Self-freshen: the
      # pane re-probes live when the cache is older than the TTL, else reuses it — so the data is never
      # more than ~2min old yet a 30s redraw stays cheap. Hard timeout so a slow peer can't wedge the pane.
      fc="$M/.fleet-health.cache"; fage=$(( $(date +%s) - $(stat -c %Y "$fc" 2>/dev/null || echo 0) ))
      if [ ! -s "$fc" ] || [ "$fage" -gt 150 ]; then
        ftmp="$fc.$$.tmp"  # PID-unique: concurrent dash procs (pane loop + a --once read) must not race a shared .tmp (the 'mv: cannot stat .fleet-health.cache.tmp' stderr leak)
        timeout 35 mesh-fleet-health > "$ftmp" 2>/dev/null && mv "$ftmp" "$fc"
        fage=$(( $(date +%s) - $(stat -c %Y "$fc" 2>/dev/null || echo 0) ))
      fi
      fstale=""; [ "$fage" -gt 600 ] && fstale="  ⚠️STALE (live re-probe failing — fix me)"
      echo "-- FLEET (ALL nodes — LIVE, $(age_of "$fc")$fstale) --"
      # COMPACT roster, not the raw table. The old `head -9` printed a 5-column table whose columns are
      # "-" for every non-SSH node AND silently cut the tail — 10 nodes in the cache, 7 on screen, the
      # PATH line gone, and no marker saying so. Group by reachability instead: every node is named on
      # one of three lines, so the block costs ~4 rows and drops NOBODY.
      awk '
        # ONLY the rows BELOW the dashed separator are node rows. mesh-fleet-health prints a BANNER
        # above it when its own probe is degraded — and that banner is prose containing the table
        # vocabulary, so the reachability-token scan below matched the word LOCAL inside it and minted
        # a NODE. Live 2026-08-18T08:38Z: "⚠ LOCAL LOAD HIGH (load1=45.94) — reachability probe
        # UNRELIABLE; non-answers shown as UNKNOWN(load), NOT down" rendered as a 10th node
        # ⚠(LOCAL vitals=HIGH up=(load1=45.94)) sitting beside the real mesh-home row with the
        # OPPOSITE verdict. The UNPARSED bucket could not catch it precisely BECAUSE the line carries
        # a matching token. Position, not vocabulary, is what separates a row from a banner.
        /^-----/ { intable=1; next }
        /^(===|NODE )/ || /^[[:space:]]*$/ { next }
        /^PATH:/ { path=$0; next }
        # …and the banner must be SURFACED, never merely skipped: it says the reachability probe is
        # UNRELIABLE and that non-answers are UNKNOWN(load) rather than down. Drop it and the down:
        # line below reads as authoritative exactly when its producer has said it is not. Glyph-
        # agnostic on purpose — any non-blank pre-table line that is not the ===/NODE header is a
        # banner, so a reworded or non-⚠ warning is carried too.
        !intable { warn = warn (warn?" ":"") $0; next }
        {
          # THE SUBSTR BOUNDS ARE GONE ON PURPOSE (2026-08-19). These two rows used
          # substr(...,1,150), which is a BYTE count in mawk while the banner is full of ⚠ and —
          # (3 bytes each) — so the cut landed mid-glyph and, tightened to fit a pane, sliced the
          # word UNRELIABLE in half. The assembled-row clip in the render loop is character-aware
          # AND marks what it cuts, so bounding here is both wrong and redundant; squeezing the
          # table padding and dropping the ⚠ the label already implies is all that is left to do.
          # WIDTH (2026-08-19, the mesh-dash board task): two edits below buy this roster row
          # back from 126 columns. (a) the ISO date on the PATH stamp is 20 columns and the
          # section header already carries a fleet age, so it was costing exactly the
          # peers/direct/relay arithmetic that is the only new information in that segment.
          # (b) OFFLINE/UNREACHABLE/UNKNOWN spelled in full, once per down node, was most of the
          # row; the three-letter forms keep every reason NAMED per node (no legend to read, no
          # class silently folded) at a third of the width.
          # node names may contain a space ("Redmi 10"), so the name is everything BEFORE the
          # REACHABLE token — never $1, and never a fixed-width cut (a long name overflows its column).
          ri=0; for(i=1;i<=NF;i++) if($i ~ /^(LOCAL|yes|no|LAN-ping|LAN-up|OFFLINE|UNREACHABLE|UNKNOWN.*)$/){ri=i;break}
          if(!ri){ odd=odd (odd?" · ":"") $0; nodd++; next }
          name=""; for(i=1;i<ri;i++) name=name (i>1?" ":"") $i
          r=$ri; vit=$(ri+2); up=$(ri+3); n++
          if(r=="LOCAL"||r=="yes"){ ok=ok (ok?" · ":"") name "(" r " vitals=" vit " up=" up ")"; nok++ }
          else if(r ~ /^LAN/){ lan=lan (lan?" · ":"") name "(" r ")"; nlan++ }
          else { rr=r; sub(/^OFFLINE$/, "OFF", rr); sub(/^UNREACHABLE$/, "UNR", rr); sub(/^UNKNOWN.*/, "UNK", rr); off=off (off?", ":"") name "(" rr ")"; noff++ }
        }
        END{
          # PATH counts ride the roster line: the per-node offline names it repeats are already on
          # the down: line below, so only its direct/relay/peers arithmetic is new information.
          sub(/ \|.*$/, "", path)
          sub(/ [0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:]+Z/, "", path)
          printf "  %d nodes: %d ssh · %d lan · %d down | %s\n", n, nok, nlan, noff, path
          if(nok)  printf "  up:     %s\n", ok
          if(nlan) printf "  lan:    %s\n", lan
          if(noff) printf "  down:   %s\n", off
          gsub(/  +/, " ", odd); gsub(/  +/, " ", warn); sub(/^⚠ ?/, "", warn)
          if(nodd) printf "  UNPARSED(%d): %s\n", nodd, odd
          if(length(warn)) printf "  PROBE-WARNING: %s\n", warn
        }' "$fc" 2>/dev/null
      # DOCTOR — the role-source this channel feeds off: not just the count, the NAMED failing
      # checks (from .doctor-fails, the latest-only snapshot) so the mind can act from the pane alone.
      if [ -s "$M/.doctor-fails" ]; then
        # the verdict line rides the header when there is nothing under it — a section header over a
        # single line is a row spent on punctuation.
        if [ "$(wc -l < "$M/.doctor-fails")" -le 1 ]; then
          echo "-- DOCTOR (this node, cached $(age_of "$M/.doctor-fails")): $(head -1 "$M/.doctor-fails") --"
        else
          # the verdict line RIDES THE HEADER in both branches (2026-08-19). Rendering it on its
          # own row spent two rows on a header, and it is the SICK branch — exactly the moment the
          # frame is fighting its ceiling — that paid for it.
          echo "-- DOCTOR (this node, cached $(age_of "$M/.doctor-fails")): $(head -1 "$M/.doctor-fails") --"
          # CAPPED AND THE REMAINDER NAMED — the organs block below already does this; this one used
          # `sed -n '2,7p'` and silently dropped fail 7+. Two reasons it matters, and the second is the
          # one that bit: a silent truncation reads as "that is all of them", AND the frame is only ~5
          # lines under the 34-line pane ceiling at rest, so every failure block that grows unbounded
          # makes mesh-dash's OWN smoke-test fail when the NODE is unhealthy. Reproduced 2026-08-18:
          # 6 doctor fails + 7 DARK organs renders 36 lines. Self-referential, too — that smoke-test
          # failure is itself a doctor FAIL, which adds another line here.
          _dn="$(( $(wc -l < "$M/.doctor-fails") - 1 ))"
          sed -n '2,4p' "$M/.doctor-fails" | sed 's/^/  ✗ /'
          [ "$_dn" -gt 3 ] && echo "  … +$(( _dn - 3 )) more FAIL not shown"
        fi
      else
        echo "doctor (this node): $(tail -1 "$M/doctor.log" 2>/dev/null) (age $(age_of "$M/doctor.log"))"
      fi
      # VPN — "always up for everyone" (operator 2026-06-19). STRICTLY OBSERVE-ONLY: reads the
      # cached state the */10 mesh-vpn-health + egress-health reflexes write — NEVER probes/touches a
      # tunnel or the router (the substrate is frozen: never-touch-working-vpn). Two SEPARATE paths:
      #   (a) friends' VPN server on phaedra (SS/trojan/WireGuard) · (b) the operator's HOME egress
      #   through the ROUTER's own NL VPN (do-not-break). A node offering a route never rides it.
      echo "-- VPN (observe-only — all clients always-up; tunnels + router FROZEN) --"
      # 187 COLUMNS = THREE ROWS, the widest line in the frame. Two rows carry the same facts:
      # the verdict+tunnels, then the client roster with the age on it. `phaedra VPN ` is stripped
      # because the label two characters to its left already says whose VPN this is — a prefix
      # that repeats the label is 12 columns of the pane spent saying nothing.
      _vph="$(tail -1 "$M/vpn-health.log" 2>/dev/null | cut -f2- \
              | sed -E 's/^phaedra VPN //; s/trojan cert ok \(([0-9]+d) left\)/cert \1/')"
      echo "  friends@phaedra: $(printf '%s' "$_vph" | clip 61)"
      echo "    $(printf '%s' "$_vph" | grep -oE 'clients: [^|]+' || echo 'roster n/a — run mesh-vpn-health') (age $(age_of "$M/vpn-health.log"))"
      # The label used to read "router→NL" — an ATTRIBUTION the probe cannot make. mesh-egress-health
      # pings 1.1.1.1, which is wifi → gateway → the router's own NL VPN → NL: four legs on one number.
      # On 2026-08-17T14:22Z a 40-60% loss burst sat at hop 1 (192.168.8.1) during the very read this
      # line was labelling, so the wifi leg wore the router's name. Scope is now honest, and the tape
      # carries a `where=` token (hop1-bad | beyond-hop1 | hop1-unknown) from a SIMULTANEOUS gateway
      # probe — kept early in the log line on purpose, so it survives this cut.
      # ...AND THE BASE RATE BESIDE THAT SAMPLE. The sample is ONE 5-ping frame in a ~4s window every 180s
      # — 2.2% of wallclock on a link that sits either at its floor or inside a multi-hundred-ms burst, so
      # it alternates OK/BAD/SKIP frame to frame while the true incidence held 43-58% BAD for four days and
      # nothing ever boarded it. Reading the sample alone is reading a coin flip; the fold names the LINK.
      # (window=inst+iv, CLAUDE.md; task:egress-quality-renders-one-coin-flip-sample-and-hides-a-50-percent-
      # base-rate 2026-08-19. Every mesh-egress-health run writes it, so this row costs a cat.)
      # ONE ROW, not two: the check frame has a hard 34-line ceiling that --test drives a sick-node fixture
      # against, and a second row here spent the last of it. So the sample is clipped harder and the fold
      # rides beside it, condensed to incidence + the window's median RTT; the full fold (SKIP split, p90,
      # window span) is one `mesh-egress-health --quality-summary` away.
      _qb=$(cut -d' ' -f2- "$M/.egress-quality-baserate" 2>/dev/null \
            | sed -E 's/^base=//; s/ unreach:[0-9]+ blind:[0-9]+//; s/ rtt_p90=[0-9.?]+//; s/ basewin=/ n=/')
      # THE LABEL COST 47 OF THE 80 COLUMNS BEFORE A SINGLE MEASUREMENT (health, 2026-08-19).
      # `sample=a coin flip | 24h=the LINK` is a caveat about how to READ the two fields, and a
      # caveat is a thing you learn once — it belongs in this comment and in the tool that writes
      # the log, not re-printed 2880 times a day into the row where the numbers have to fit. The
      # `now`/`24h` split still says it structurally: `now` IS the single sample (a coin flip on a
      # link this flaky), `24h` IS the aggregate that characterises the link.
      # TWO ROWS, NOT ONE CLIPPED ROW. `now` and `24h` are 115 columns together: on an
      # 80-column pane a single row can only carry them by CUTTING one, and the cut lands on the
      # 24h aggregate — rtt_p50 and n= — which is the half that characterises the link. A second
      # row costs one row and keeps every number; the clip below then never has to fire here.
      echo "  egress now: $(tail -1 "$M/egress-health.log" 2>/dev/null | sed -E 's/^[0-9TZ:-]+ //; s/ base=.*//; s/QUALITY //; s/ \(state=[^)]*\)//; s/ \(enantiostasis: [^)]*\)//; s/ (host|rmax|jmax|hop1|qfunc|anthropic)=[^ ]*//g' | clip 55) (age $(age_of "$M/egress-health.log"))"
      echo "  egress 24h: ${_qb:-base n/a}"
      # vitals + therm + freq on ONE row: three reads, one line — the section headers were costing more
      # rows than the data under them.
      # freq% = ACTUAL-throttle truth, BUT only meaningful UNDER DEMAND. Low freq + high load = real
      # throttle (the operator-channel-starvation risk). Low freq + LOW load = benign idle power-saving
      # downclock, NOT a cap (the governor clocks down when there's nothing to do — temp cool, no harm).
      # So gate CAPPED on load1 vs nproc, else a quiet node falsely reads CAPPED (2026-06-21: caught freq
      # 38% at load 1.32 / 74°C = idle, not throttle). Baseline: 94-100°C at load~10 ran ~88-91% = functional.
      # The prose caveat that used to trail the number is now carried by the LABEL itself
      # (CAPPED-under-load / idle-downclock(benign)) — self-describing, and it costs no row.
      _freq="$({ fcur=$(cat /sys/devices/system/cpu/cpu*/cpufreq/scaling_cur_freq 2>/dev/null|sort -rn|head -1); fmax=$(cat /sys/devices/system/cpu/cpu*/cpufreq/cpuinfo_max_freq 2>/dev/null|sort -rn|head -1); l1=$(cut -d' ' -f1 /proc/loadavg 2>/dev/null); nc=$(nproc 2>/dev/null||echo 1); if [ -n "$fcur" ] && [ -n "$fmax" ] && [ "$fmax" -gt 0 ] 2>/dev/null; then awk -v fc="$fcur" -v fm="$fmax" -v l1="${l1:-0}" -v nc="$nc" 'BEGIN{p=int(fc/fm*100); busy=(l1>=nc*0.5); if(p>=85)s="functional"; else if(busy)s="CAPPED-under-load"; else s="idle-downclock(benign)"; printf "freq=%d%% %s", p, s}'; else printf 'freq=? (no cpufreq sysfs)'; fi; })"
      # 131 COLUMNS = TWO ROWS, and every one of the extra 51 was padding or a repeated word:
      # the three sources are pasted with double spaces and `||` separators, `nproc:16` is a
      # constant of the node re-printed every 30s, `(0.2)` restates load/16 which is already
      # printed beside it, and the therm segment names max/load/mem again. Squeeze, then the
      # freq VERDICT keeps its distinction (ok vs CAPPED vs idle-dc) in a fifth of the width.
      # FIELD ORDER IS THE CLIP POLICY. Whatever still overflows loses its TAIL, so the tail is
      # the 24h peak triple (a slow-moving context number) and never the freq verdict, which is
      # the one field here that says whether this node is throttled right now.
      echo "  vitals: $(mesh-vitals 2>/dev/null | head -1 | sed -E 's/  +/ /g; s/ ?nproc:[0-9]+//; s/\([0-9.]+\)//') $(printf '%s' "$_freq" | sed -E 's/ functional/ ok/; s/ CAPPED-under-load/ CAPPED/; s/ idle-downclock\(benign\)/ idle-dc/') | pk $(tail -1 "$M/therm.log" 2>/dev/null | grep -oE 'max=[0-9]+°C.*' | head -1 | sed -E 's/max=//; s/°C/C/; s/  +/ /g; s/ ?load=/\//; s/ ?mem=/\//')"
       echo "-- CPU/GPU load (who's busy — load-audit + vram-watch, cached) --"
       # CPU auditor: who is eating CPU RIGHT NOW + is it junk? (state written every */2 by
       # mesh-load-audit --edge; instant-% via /proc 2-sample, proc classified mind/organ/user/?).
       # The dash NEVER runs the /proc sample itself (that's the reflex's job) — cheap state read here.
       _las="$M/.load-audit-state"
       if [ -s "$_las" ]; then
         # robust getter: the FIELD (|-delimited) whose START matches key= (an embedded "top=" inside
         # the cpu= reason text must NOT be mistaken for the real top= field — match field-start only)
         _laf() { awk -F'|' -v k="^$1=" '{ for(i=1;i<=NF;i++) if($i ~ k){ sub(k,"",$i); print $i; exit } }' "$_las"; }
         _lacpu="$(_laf CPU)"; _lagpu="$(_laf GPU)"; _laload="$(_laf load1)"; _lanp="$(_laf nproc)"
         # top consumer = first entry of the top= field (the headline hog + its tag)
         _latop="$(printf '%s' "$(_laf top)" | cut -d';' -f1 | clip 86)"
         echo "  load-audit($(age_of "$_las")): CPU=$_lacpu · GPU=$_lagpu · load1=${_laload:-?}/${_lanp:-?}c"
         # the top consumer is only a decision when the CPU is NOT quiet — a row spent naming the
         # busiest kworker on an idle box is a row that pushes a real alarm off the top of the pane.
         case "$_lacpu" in QUIET|"") : ;; *) [ -n "$_latop" ] && echo "    top: $_latop" ;; esac
       else
         echo "  load-audit: UNAVAILABLE (no .load-audit-state — run mesh-load-audit)"
       fi
       # GPU pressure (the RTX 3060 = local-inference organ + the hottest part). mesh-gpu-activity is
       # Intel i915 only; mesh-vram-watch is the nvidia reader. Its .state suffix hid it from state_wall
       # (glob is *-state), so it was collected-but-invisible — surface it explicitly here.
       _vws="$M/.vram-watch.state"
       # The sentinel OUTRANKS the state file. .vram-watch.state is written only on a SUCCESSFUL
       # read, so during a real outage it holds the last HEALTHY line forever — 2026-08-14 that
       # rendered here as "GPU HEALTHY (7h ago)" through 7h08m of all-inference-on-CPU, the age
       # being the only tell and nobody reading it. If the offline sentinel exists, the GPU is not
       # healthy-and-stale, it is DOWN, and this pane says so with the duration.
       _vwoff="$M/.vram-watch-offline"
       if [ -f "$_vwoff" ]; then
         read -r _vwsince _vwkind _vwlast < "$_vwoff" 2>/dev/null || true
         case "${_vwsince:-}" in ''|*[!0-9]*) _vwsince="$(stat -c %Y "$_vwoff" 2>/dev/null || echo 0)" ;; esac
         _vwdown=$(( $(date +%s) - _vwsince )); [ "$_vwdown" -lt 0 ] && _vwdown=0
         if [ "${_vwkind:-DOWN}" = ABSENT ]; then
           echo "  GPU: ABSENT (no dGPU organ on this node — vram-watch said so once, $(_dur_hm "$_vwdown") ago)"
         else
           echo "  GPU: DOWN for $(_dur_hm "$_vwdown") (nvidia-smi installed but unreadable — local inference is on CPU; last healthy read $(age_of "$_vws") old, NOT current)"
         fi
       elif [ -s "$_vws" ]; then
         _vwv="$(cut -d'|' -f1 "$_vws")"
         _vwvram="$(grep -oE 'vram=[0-9]+/[0-9]+MiB\([0-9]+%\)' "$_vws" | head -1)"
         _vwutil="$(grep -oE 'util=[0-9]+%' "$_vws" | head -1)"
         _vwtemp="$(grep -oE 'temp=[0-9]+C' "$_vws" | head -1)"
         _vwthrot="$(grep -oE 'throttle=0x[0-9a-f]+' "$_vws" | head -1)"
         _vwspill="$(grep -oE 'spill=[A-Za-z]+' "$_vws" | head -1)"
         # throttle= is a 30ms SAMPLE (0.005% of the */10 tick); throttle_iv= is the counter delta over
         # the WHOLE interval. Showing only the sample is how a throttle between two ticks stays invisible.
         _vwiv="$(grep -oE 'throttle_iv=[^ |]+' "$_vws" | head -1)"
         # 127 COLUMNS, of which: `GPU GPU:` says the word twice, `0x0000000000000001` spends
         # 16 nibbles to carry one bit, `throttle_iv=0ms/601000ms` names the field twice over,
         # and `spill=GPU` is the ordinary case (the interesting value is spill=CPU). Same rule
         # as the OFFLINE column above — print the field where it DIFFERS from the resting value.
         _vwv="${_vwv#GPU:}"
         _gvr="$(printf '%s' "${_vwvram:-}" | sed -E 's/MiB/M/')"
         _gth="$(printf '%s' "${_vwthrot:-}" | sed -E 's/^throttle=0x0*/throt=0x/; s/throt=0x$/throt=0x0/')"
         _giv="$(printf '%s' "${_vwiv:-}" | sed -E 's/^throttle_iv=/iv=/; s/([0-9]+)ms\/([0-9]+)000ms/\1\/\2s/')"
         _gsp=""; case "${_vwspill:-}" in spill=GPU|'') : ;; *) _gsp=" $_vwspill" ;; esac
         echo "  GPU $_vwv ($(age_of "$_vws")): ${_gvr:-?} ${_vwutil:-?} ${_vwtemp:-?} ${_gth:-?} ${_giv:-}${_gsp}"
       else
         echo "  GPU: UNAVAILABLE (no dGPU here, or vram-watch reflex not running)"
       fi
       # organs + supervised: the COUNTS are already on the egress line above, and `head -6` of an
       # all-LIVE roster spent 12 rows re-stating 13LIVE/0DARK/2UP while the sections that carry a
       # decision scrolled off. Print the FAILING members only; when none fail, one line says so —
       # and a truncated remainder is named, never dropped.
       # $organs is the SAME capture the header counted (see the one-read note above) — re-probing here
       # is what let the header and this section contradict each other inside one frame.
       _dark="$(printf '%s\n' "$organs" | grep -F DARK)"
       if [ -z "$organs" ]; then
         echo "-- organs: n/a (keepalive --status unreadable — the roster is UNKNOWN, not clean) --"
       elif [ -n "$_dark" ]; then
         # 3, not 5: the frame's worst case must fit the 34-line pane ceiling, and a sick node grows
         # every block at once (see the worst-case gate in --test). The remainder stays NAMED.
         echo "-- organs DARK ($(printf '%s\n' "$_dark" | wc -l)) --"; printf '%s\n' "$_dark" | head -2 | sed 's/^/  /'
         [ "$(printf '%s\n' "$_dark" | wc -l)" -gt 2 ] && echo "  … +$(( $(printf '%s\n' "$_dark" | wc -l) - 2 )) more DARK"
       else
         echo "-- organs: all LIVE (none DARK) --"
       fi
       _sdown="$(printf '%s\n' "$sup" | grep -F DOWN)"
       if [ -n "$_sdown" ]; then
         echo "-- supervised loops DOWN --"; printf '%s\n' "$_sdown" | head -4 | sed 's/^/  /'
       else
         # THE ALL-CLEAR CASE IS ALREADY ON THE SUMMARY ROW at the top of this frame
         # (`supervised 3UP/0DOWN`), so a dedicated row for it was the same fact twice — one of
         # the ~28 fixed rows this frame cannot trim, on a pane that is 11 rows tall. The DOWN
         # branch above still gets its own rows; absence of this line means all UP, and the
         # count is right there in the header.
         :
       fi
      )"
      printf '%s\n' "$_pre"
      # TARGET = the whole --once output, footer included (that is what the ceiling gate counts and
      # what a pane must hold). Everything not available to the state rows: the frame header (1) +
      # the rows $_pre already spent + the rows $_post will spend + the state block's own summary
      # line (1) + its "+N more" line (1) + the liveness footer (1). A cap of 0 is legal and still
      # names every dropped member.
      # $_post IS MEASURED, NOT ASSUMED (2026-08-19). The old arithmetic charged the trailing
      # sections a hand-written "2" — true only while channels.log was EMPTY. Fed, that block is a
      # header plus three lines, so on any node with a live feeder the frame ran three rows over
      # its ceiling and the constant said it did not. Build it first, measure it, spend it.
      # ROWS, NOT LINES (2026-08-19). $_pre is spent in ROWS — a 187-column friends@phaedra line
      # cost three of them — so budgeting against its LINE count handed the state wall rows the
      # pane could not paint, and the frame overshot its own ceiling by exactly the wrap it never
      # counted. rows_of measures what the pane paints at $_PANE_COLS; the assembled-row clip at
      # the bottom of this file then guarantees the two numbers agree.
      # THE TRAILING BLOCK IS FIXED COST, SO IT IS ONE ROW IN EVERY STATE (2026-08-19). Empty, it
      # used a whole row to say nothing was fed; fed, it was a header plus three lines — four rows
      # that the state wall, capped to ZERO on a sick node, could not take back. It is the frame's
      # lowest-priority content and it now spends the least: the autopoiesis verdicts carry a
      # streams word, and the newest feed rides its own row NAMING how many are not shown, the
      # same convention as every other cap here. Nothing is dropped silently.
      _chn="$(grep -c . "$M/channels.log" 2>/dev/null || echo 0)"
      _ch="$(tail -1 "$M/channels.log" 2>/dev/null)"
      _post="$(
        echo "-- autopoiesis: reflexes=$(cat "$M/.reflex-health-state" 2>/dev/null || echo ?) vitality=$(sed -n 's/^verdict=//p' "$M/.vitality-state" 2>/dev/null || echo ?) | feed $(age_of "$M/feed.log") | evolve $(age_of "$M/sense-evolve.log")${_ch:+ | streams fed}${_ch:- | streams none} --"
        [ -n "$_ch" ] && echo "  stream$([ "${_chn:-0}" -gt 1 ] && printf ' (newest of %s)' "$_chn"): $_ch"
      )"
      :
      _tgt=34; [ "${_PANE_ROWS:-0}" -gt 0 ] && _tgt="$_PANE_ROWS"
      _fixed=0
      for _blk in "$_pre" "$_post"; do
        _r="$(printf '%s\n' "$_blk" | rows_of "$_PANE_COLS")"
        case "${_r:-}" in ''|*[!0-9]*) _r="$(printf '%s\n' "$_blk" | wc -l)" ;; esac
        _fixed=$(( _fixed + _r ))
      done
      _cap=$(( _tgt - 4 - _fixed ))
      [ "$_cap" -lt 0 ] && _cap=0
      # section header FOLDED INTO the summary line state_wall already prints (it names the totals);
      # a separate "-- edge states --" row said nothing the next row didn't.
      state_wall --alerts "$_cap"
      printf '%s\n' "$_post" ;;   # converged feeder log (stream.log retired 2026-06-17)
    genome)
      # the GENOME channel — operator 2026-06-17: this window KEEPS and DEVELOPS the codebase
      # (autonomous development). Mind builds/improves tools, self-verifies, lands stranded fixes,
      # commits + pushes. Absorbs the old dev/discover/work/verify/plan cluster. Self-feeding lives
      # here too — the genome mind runs its own build/deploy ops (no separate shell window).
      self_meter genome   # this mind's own context/spend — /compact when ctx climbs (auto on idle too)
      # SELF-PRODUCTION cockpit — the autopoiesis meta-reflexes write these logs; this mind watches
      # the SAME data they do and acts on it (low vitality → produce/fix; a need → work it; a
      # fitness-revert → understand why; autowire → a tool joined the metabolism). Cheap (tails).
      echo "-- self-production (autopoiesis — reflexes + this mind both watch) --"
      # render-layer lease (PART 3): these strip the leading ISO ts → without re-adding age, a STALLED
      # autopoiesis lane shows its last line as if current. _fbucket re-attaches a COARSE age_bucket
      # (<30m/30-60m/1-3h/3h+) instead of fresh_mark's exact (Nm) age — no per-frame/per-minute churn
      # (operator 2026-06-25: top-pane liveness is THIS block's job, not central strip_volatile) + UNKNOWN
      # if missing/empty. A stall stays visible (the bucket climbs to 1-3h/3h+ for an hourly-cadence lane).
      _fbucket(){ local f="$1" v="$2"; [ -e "$f" ] || { echo "UNKNOWN (no data)"; return; }; [ -n "$v" ] || { echo "UNKNOWN (empty)"; return; }; echo "$v ($(age_bucket "$f"))"; }
      echo "  vitality: $(_fbucket "$M/vitality.log" "$(tail -1 "$M/vitality.log" 2>/dev/null | sed -E 's/^[0-9TZ:-]+ //' | clip 86)")"
      echo "  needs:    $(_fbucket "$M/needs.log"    "$(tail -1 "$M/needs.log"    2>/dev/null | sed -E 's/^[0-9TZ:-]+ //' | clip 86)")"
      # fitness is CONDITIONAL-WRITE (judges each HEAD once, then silently no-ops on a stable HEAD — like
      # feed/generate '@cond' in mesh-reflex-health). Its log mtime is the LAST-JUDGMENT time, NOT a
      # heartbeat, so fresh_mark's STALE-past-1h gave a chronic FALSE-STALE whenever no new commit landed
      # for an hour (the */27 cron keeps firing + correctly emits nothing). Show last verdict + age as
      # informational, never a STALE alarm; the cron's real liveness is mesh-reflex-health's job, not mtime.
      _fver="$(tail -1 "$M/fitness.log" 2>/dev/null | sed -E 's/^[0-9TZ:-]+ //' | clip 86)"
      echo "  fitness:  ${_fver:-UNKNOWN (no data)} (HEAD judged $(age_bucket "$M/fitness.log") ago — conditional-write, not a heartbeat)"
      echo "  autowire: $(_fbucket "$M/autowire.log" "$(tail -1 "$M/autowire.log" 2>/dev/null | sed -E 's/^[0-9TZ:-]+ //' | clip 86)")"
      # backlog count: grep -c PRINTS "0" *and* exits 1 on an empty (but present) file, so a bare
      # `grep -c ... || echo 0` double-prints ("0\n0") the moment the backlog drains → a stray "0"
      # line under feed: on every clean-rest. Collapse to one line; the `|| echo 0` still covers a
      # MISSING file (grep prints nothing, exits 2).
      echo "  feed:     $(tail -1 "$M/feed.log" 2>/dev/null | sed -E 's/^[0-9TZ:-]+ //') | backlog=$({ grep -cvE '^[[:space:]]*(#|$)' "$M/backlog" 2>/dev/null || echo 0; } | head -1)"
      echo "-- working tree (uncommitted) --"; git -C "$REPO" status -s 2>/dev/null | head -10
      echo "-- unpushed (origin/main..HEAD) --"; git -C "$REPO" --no-pager log --oneline origin/main..HEAD 2>/dev/null | head -5
      echo "-- stranded (settled, needs landing) --"; timeout 20 mesh-land 2>/dev/null | head -5   # bare = READ-ONLY dry-run; --check POSTS [strand] to the board (a dash must never write — flood 2026-06-17)
      echo "-- genome<->local drift --"; timeout 20 mesh-sync-tools 2>/dev/null | grep -iE 'drift|differ|stale|sync' | head -5
      # verify rotations: read the REAL artifact (verify.log never existed — audit 2026-06-19). Show
      # the latest verify-rotation-*.log + its age so a STALLED verify rotation is visible, not blank.
      vr="$(ls -t "$M"/verify-rotation-*.log 2>/dev/null | head -1)"
      echo "-- verify rotations ($([ -n "$vr" ] && age_bucket "$vr" || echo none)) --"; [ -n "$vr" ] && tail -2 "$vr" 2>/dev/null || echo "  (no verify rotation log yet)"
      # PLAN next: PLAN.md headers are '## THIS TICK' (the '## 🔜 NEXT' header never existed → blank;
      # audit 2026-06-19). Show the FIRST (current) THIS TICK block.
      echo "-- PLAN: this tick --"; awk '/^## THIS TICK/{f=1;print;next} /^## /{if(f)exit} f' "$M/PLAN.md" 2>/dev/null | grep -vE '^[[:space:]]*$' | clip 92 | head -4
      echo "-- recent commits --"; git -C "$REPO" --no-pager log --oneline -5 2>/dev/null ;;
    senses)
      # the SENSE-TENDING channel — operator 2026-06-17: this window KEEPS and DEVELOPS the senses
      # (perception analogue of genome). Mind verifies each sense yields a REAL artifact, fixes broken
      # organs, builds/improves sense tools + their reflexes. Cheap reads only (no per-frame phone SSH —
      # that is the mind's job); heavy probes belong to the mind, not the dash refresh loop.
      self_meter senses   # this mind's own context/spend (opencode: ctx% + $cost; /compact >60%)
      # CROSS-DEVICE sense map (operator 2026-06-19: harvest senses from EVERYTHING we reach, not
      # just the phone; the value is CROSS-validation between devices). Cheap: reads the cached
      # mesh-sense-map (a */10 reflex refreshes it via the SSH fan-out — never probed per frame here).
      timeout 6 mesh-sense-map --cached 2>/dev/null || echo "  (mesh-sense-map unavailable)"
      # COLLECTED cross-validation (operator's frontier: turn the inventory into a corroborated signal).
      # Cheap: reads the wifi-crossval state file (a */2h --edge reflex runs the 2-vantage SSH scan);
      # the actual cross-check is NEVER run per frame here.
      # WHICH PAIR is NOT hardcoded here: the state's summary carries a "· vantages <local>↔<peer>"
      # tag written by the tool from its LIVE MESH_WIFI_PEER. The old literal "IdeaPad↔iMac" named
      # two boxes that were not participants — IdeaPad last seen 2026-07-19, no iMac on the tailnet
      # at all — while the real pair was mesh-home↔192.168.8.214, so a reader chasing "only 1
      # vantage" was sent to the wrong nodes. The tool had already fixed this for its own board post
      # (_vantage_label); the fix was never swept to its only reader. Same shape the BLE line below
      # was fixed for. A missing artifact must render the honest n/a, not a blank: the fallback is on
      # the READ (`cat || echo`), not after the pipe, where `tr`'s rc=0 swallowed it.
      echo "  cross-val (wifi): $( { cat "$M/wifi-crossval.state" 2>/dev/null || echo 'n/a — run mesh-wifi-crossval'; } | tr '|' ' ' )"
      # BLE 2-vantage SPACE-MAP (operator's wanted capability): cached cat of ble-spacemap.state, written
      # by mesh-presence-fuse's one-shot run. Cheap — never runs the expensive 2-node BLE+SSH scan here.
      # The pair label is DERIVED (self↔MESH_FUSE_LABEL from ~/.mesh/nodes), never hardcoded: the old
      # fixed "IdeaPad↔ds" outlived both nodes and named a pair the fuse was not even attempting
      # (it targets MESH_FUSE_LABEL), so the pane asserted a cross-check that never ran.
      echo "  cross-val (ble,  $(hostname)↔${MESH_FUSE_LABEL:-<no-peer>}): $(cat "$M/ble-spacemap.state" 2>/dev/null || echo 'n/a — run mesh-presence-fuse')"
      # ALL senses the mesh has — the cached roll-call (operator 2026-06-17: "this window's top pane
      # should be all senses mesh has"). Cheap: reads the reflexes' cached artifacts, never live-probes
      # the phone per frame (that is the mind's job). STALE markers = the dead/lagging senses to fix.
      echo "-- LIVE READINGS (this node, cached — the mind runs live cross-checks) --"
      timeout 10 mesh-sensorium --cached 2>/dev/null | sed '1d' || echo "  (mesh-sensorium unavailable)"
      # NOTE3 organ row (board task senses-dash-note3-row): climate fusion (.climate-state, mesh-climate
      # cron) + camera artifact freshness (note3-cam-last.jpg, on-demand mesh-note3-cam). Cheap: two
      # local stats + one cat, never an ADB/SSH probe per frame. Ages are BUCKETED (fresh/recent/stale)
      # like attendance above — raw seconds tick every render and re-wake the mind on chrome. Honest:
      # absent state → UNKNOWN, absent hum field → omitted, never a faked reading.
      _cs="$M/.climate-state"; _n3cam="$HOME/.mesh/note3-cam-last.jpg"
      _n3age_bucket() { # $1=file $2=fresh_s $3=recent_s → fresh|recent|stale|UNKNOWN
        [ -f "$1" ] || { echo UNKNOWN; return; }
        local _a=$(( $(date +%s) - $(stat -c %Y "$1") ))
        if [ "$_a" -lt "$2" ]; then echo fresh; elif [ "$_a" -lt "$3" ]; then echo recent; else echo stale; fi
      }
      if [ -s "$_cs" ]; then
        # pull only the fields we render; a field the fuser didn't emit (e.g. hum= today) just drops out
        _n3f="$(grep -oE '(in_hpa|trend|d_hpa|out_c|hum)=[^ |]+' "$_cs" | tr '\n' ' ')"; _n3f="${_n3f% }"
        _n3clim="${_n3f:-$(head -c 60 "$_cs")} ($(_n3age_bucket "$_cs" 2700 5400))"
      else
        _n3clim="UNKNOWN (no .climate-state — mesh-climate not producing)"
      fi
      _n3cb="$(_n3age_bucket "$_n3cam" 3600 21600)"
      # the note3 shutter is an ON-DEMAND organ (`# orphan-ok:` in mesh-note3-cam — no cadence, no
      # cron line): nobody writes this frame unless a mind or the operator asks. Bucketing it like a
      # cadenced sense made "stale" its PERMANENT resting state, and in every other row of this pane
      # "stale" means a dead reflex — so the row could never distinguish a broken shutter from an
      # unasked one, and its only informative value (fresh) required someone to have just fired it by
      # hand. Same shape as the genome `fitness:` row above (conditional-write, not a heartbeat): show
      # the age, never the alarm word. `idle` = nobody asked; `stale` stays reserved for a sense that
      # OWES a frame. Verified 2026-08-19: shutter fires live (1.3MB frame) while the row read "stale".
      [ "$_n3cb" = UNKNOWN ] && _n3camtxt="UNKNOWN (no frame — run mesh-note3-cam)" || _n3camtxt="last frame ${_n3cb/stale/idle} (on-demand)"
      # craft-room light (mesh-light --craft, refreshed by the scheduled --edge piggyback → .light-craft-state).
      # Cheap: one local read of the state file — NO per-frame ADB (the cron piggyback does the read). Level
      # (DIM/…/UNKNOWN) + lux + bucketed freshness. Honest: absent state → UNKNOWN, UNKNOWN-marker passes through.
      _n3ls="$HOME/.mesh/.light-craft-state"
      if [ -s "$_n3ls" ]; then
        _n3lvl="$(cut -d'|' -f1 "$_n3ls" | awk '{print $1}')"
        _n3lux="$(grep -oE 'lux=[0-9]+' "$_n3ls" | head -1)"
        _n3lighttxt="${_n3lvl}${_n3lux:+ $_n3lux} ($(_n3age_bucket "$_n3ls" 1200 2400))"
      else
        _n3lighttxt="UNKNOWN (no reading — run mesh-light --craft)"
      fi
      echo "  NOTE3: craft-light ${_n3lighttxt} · climate ${_n3clim% } · cam $_n3camtxt"
      # ATTENDED-NESS / security: who holds a live session on THIS node and from WHERE (mesh-sessions).
      # Cheap + LOCAL (utmp via `w`, ~ms, no SSH) so it runs live per frame — a FOREIGN (public-IP)
      # login surfaces immediately, not on a cron delay. Honest: mesh-sessions exits 2 on unreadable
      # utmp → empty stdout → we render UNAVAILABLE, never a faked QUIET all-clear.
      echo "-- attended-ness (physical+nearby+remote fusion; stale sessions excluded) --"
      # mesh-attendance fuses keyboard(physical) + personal-BLE(nearby) + utmp(remote, REACHABILITY-
      # GATED so a stale half-open session is not counted live — liveness-is-a-lease). Richer + more
      # honest than raw mesh-sessions (which counts a lingering utmp peer as live). Heavier (2s keypress
      # sample + peer pings) → THROTTLED to ~120s into a cache, like FLEET above, so the 30s render loop
      # stays cheap. Honest-degraded: all-channels-blind → exit 2 → empty cache → fall back to raw
      # mesh-sessions (still honest: utmp unreadable → UNAVAILABLE, never a faked QUIET).
      ac="$M/.attendance.cache"; acage=$(( $(date +%s) - $(stat -c %Y "$ac" 2>/dev/null || echo 0) ))
      if [ ! -s "$ac" ] || [ "$acage" -gt 120 ]; then
        # PID-unique temp: a manual `--once` render and the live pane render concurrently shared one fixed
        # $ac.tmp → whichever mv ran second hit "cannot stat" (the other had already moved it). $$ isolates them.
        actmp="$ac.tmp.$$"
        timeout 12 mesh-attendance > "$actmp" 2>/dev/null && mv -f "$actmp" "$ac" || rm -f "$actmp"
        acage=$(( $(date +%s) - $(stat -c %Y "$ac" 2>/dev/null || echo 0) ))
      fi
      if [ -s "$ac" ]; then
        # bucket the cache age (throttled to 120s above) → fresh/recent/stale: the exact "(cached Ns)"
        # ticked every render and re-woke this mind on pure chrome (operator 2026-06-25 top-pane rule);
        # the bucket keeps the stall signal (refresh wedged → recent→stale) without the per-second churn.
        if   [ "$acage" -lt 120 ]; then acb=fresh
        elif [ "$acage" -lt 600 ]; then acb=recent
        else acb=stale; fi
        echo "  $(head -1 "$ac") (cached $acb)"
        grep -E 'REMOTE:' "$ac" | sed 's/^ */  /'
      else
        _sess="$(timeout 5 mesh-sessions 2>/dev/null)"
        echo "  ${_sess:-sessions=UNAVAILABLE (utmp unreadable — not faked)}"
      fi
      echo "-- sense-reflex liveness (per-run artifact freshness) --"
      timeout 15 mesh-reflex-health --check 2>/dev/null | head -4 | grep . \
        || echo "  (mesh-reflex-health unavailable)"   # --check is the read-only report; --status was never a mode (false 'unavailable' 2026-06-17)
      echo "-- recent sense work on board --"
      # Two ways a line counts as sense work: (a) a sense-DOMAIN marker by anyone, or (b) ANY substantive
      # marker authored by senses@/sensor-log@ (so the window's own [verify]/[done]/[fyi] sense work shows
      # here, not just [sense]/[room] markers — else the pane reads "no sense work since <hours ago>" while
      # this mind has been shipping fixes + cross-checks). Drop [idle]/[heartbeat] noise so the status-yield
      # churn doesn't crowd out real findings.
      grep -iE 'senses@|sensor-log@|:: *\[(sense|sensor|room|arriv|ambient|household|op-home|op-away|zone|presence)' "$M/chat.log" 2>/dev/null \
        | grep -vE ':: *\[(idle|heartbeat)\]' | tail -3 | clip 110
      echo "-- sense-evolve (last self-development directive — this mind acts on it) --"
      tail -1 "$M/sense-evolve.log" 2>/dev/null | sed -E 's/^[0-9TZ:-]+ //' | clip 100
      echo "-- frontier: develop NEW senses here; drop finds -> ~/.mesh/knowledge/ (pre-file: mesh-prior-art <id>) --" ;;
    witness|chat)
      # THE FUSED WITNESS PANE (operator 2026-07-24: "merge witness and chat, make it witness").
      # Two halves, because the merged mind holds two duty classes and each needs its own surface:
      #   TOP  = the TAPE   — mesh-witness's self-measurement ledger. READ-ONLY, pure-algorithmic
      #          (no AI in the measurement tract, operator 2026-07-06); the mind witnesses drift here
      #          and NEVER writes a measurement.
      #   BOTTOM = the BOARD — coordination: churn, claims, stuck strands. Here the mind ACTS: files
      #          [task] from chat-review, drives unmoved GAPs to their owners, and is dispatch's
      #          agentic fallback.
      # Why fused at all: two blind observers of the same fact contradicted each other on 2026-07-23
      # 60s apart (witness "mesh degraded 8h" @08:39 vs chat "board-idle 8h is REAL idle, all minds
      # UP" @08:40, retracted @08:43) — neither could see the other's pane. One pane, one verdict.
      # `chat` is kept as an ALIAS of this role, not a second lane: a stale mesh-dash chat pane left
      # running by a pre-merge window (tmux is append-only — the old window survives until reboot)
      # renders the merged surface instead of dying on an unknown role.
      self_meter witness   # this mind's own context/spend (opencode: ctx% + $cost)
      # -------- HALF 1: the tape --------
      # Re-invoked each frame so a code update to mesh-witness is picked up next tick. --embed drops
      # its own date+footer (this dash owns both); MESH_WITNESS_TAIL gives the board half its lines
      # back — the sparklines already carry the history the raw rows would repeat.
      if [ -x "$HOME/.local/bin/mesh-witness" ]; then
        MESH_WITNESS_TAIL="${MESH_WITNESS_TAIL:-4}" timeout 15 "$HOME/.local/bin/mesh-witness" --pane --embed 2>&1 \
          || echo "  (witness tape render FAILED — the ledger half is BLIND this frame, not all-clear)"
      else
        echo "== witness ==  (mesh-witness NOT INSTALLED on this node — tape half unavailable)"
      fi
      echo ""
      # -------- HALF 2: the board --------
      # board churn over the RECENT window (last 200 lines), not a lifetime grep — a coordination
      # pane needs current activity, not a cumulative [done]=574 that never reflects what's open NOW.
      recent="$(tail -200 "$M/chat.log" 2>/dev/null)"
      echo "-- board churn (last 200) --  [task]=$(printf '%s' "$recent" | grep -cE ':: *\[task\]') [taking]=$(printf '%s' "$recent" | grep -cE ':: *\[taking\]') [done]=$(printf '%s' "$recent" | grep -cE ':: *\[done\]')"
      # active CLAIMS (gf-borrowing-1): this mind owns claim attention — show who holds what + which are
      # aging unattended (STALE = owner idle/dead or past TTL → reclaimable; the --sweep reflex escalates).
      # THROTTLED to 60s: mesh-claim --list forks a liveness probe per claim, and the fused pane repaints
      # on the TAPE's 15s cadence — re-probing 4x/min is pure heat for a surface that moves on minutes.
      # The cache is served with its AGE, never silently: a probe that has been failing for 10 minutes
      # must read as a 10m-old claim list, not as the current one (a stale cache served bare is the
      # silent-fallback shape — plausible, indistinguishable from live).
      cc="$M/.witness-claims.cache"
      if [ ! -f "$cc" ] || [ "$(( $(date +%s) - $(stat -c %Y "$cc" 2>/dev/null || echo 0) ))" -ge 60 ]; then
        if timeout 8 mesh-claim --list >"$cc.tmp" 2>/dev/null; then mv "$cc.tmp" "$cc"; else rm -f "$cc.tmp"; fi
      fi
      cage="$(age_of "$cc")"; cnote=""
      case "$cage" in *m|*h|*d) cnote=" — CACHE $cage OLD (probe failing?)" ;; esac
      echo "-- active claims (mesh-claim: TTL+liveness; STALE=reclaimable)$cnote --"
      claims="$(cat "$cc" 2>/dev/null)"
      if [ -n "$claims" ]; then printf '%s\n' "$claims" | sed 's/^/  /' | head -5; else echo "  (none active)"; fi
      # DIGEST gaps: roll-call DIGEST's curated cross-mesh GAPS clause (liveness/deploy/hardware gaps no
      # formal board marker captures). Pattern fixed 2026-07-24: DIGEST dropped the literal "OPEN GAPs:"
      # wording for a bare "GAPS:" clause weeks ago and the old grep -oiE 'OPEN GAPs:.*' silently matched
      # nothing since — a blank line reads as "no gaps", not "extractor broken", so nobody noticed.
      # MEMORY CORPUS / nostalgia (operator 2026-08-15: "log memory recalls so we can measure it").
      # Still et al. PRL 109 120604: retained memory that does not predict the future is dissipative
      # ("nostalgia"). This is the corpus-side meter — reads are counted from session transcripts, so
      # "never opened" is a LOWER BOUND (MEMORY.md's index line is auto-loaded, and a mind can act on
      # the one-liner without opening the file). Belongs on the tape's own surface, not in the mind's
      # turn: witness kept re-deriving it by hand. THROTTLED 1h — the corpus moves on days, and the
      # scan walks every transcript. Cache served WITH ITS AGE, never bare (the claims-cache rule
      # above): a stale meter must read as stale, not as the current one.
      # PIN THE CORPUS. mesh-memory-recall resolves its project as CLAUDE_PROJECT_SLUG or, absent
      # that, "-" + the CALLER'S CWD — so unpinned, this line measures whatever corpus the DATA pane
      # happens to stand in, which nothing in the dash controls or asserts. Measured 2026-08-17:
      # witness.0 (cwd $HOME) rendered "12 memories · 5 opened (42%)" while witness.1 (cwd the genome
      # repo) read "607 · 133 (22%)" the same second — the pane was quoting a 13-file near-miss
      # corpus as the node's, and the error flattered us 2x on the nostalgia axis while hiding the
      # 474 never-opened memories that ARE the candidate list. The tool's own guard could not catch
      # it: it warns only when the cwd names NO corpus, and this cwd named a real (wrong) one —
      # presence-of-the-wrong-thing, not absence. Derive the slug from $REPO (the genome tree this
      # node's minds work in), never from where the pane stands.
      # cache path overridable ONLY so the smoke test can force a cold scan without clobbering the
      # live cache; everything else on this path (the pin, the tool, the render) stays the real one.
      mc="${MESH_MEMRECALL_CACHE:-$M/.witness-memrecall.cache}"
      mslug="-$(printf '%s' "${REPO#/}" | tr '/' '-')"
      if [ ! -f "$mc" ] || [ "$(( $(date +%s) - $(stat -c %Y "$mc" 2>/dev/null || echo 0) ))" -ge 3600 ]; then
        if CLAUDE_PROJECT_SLUG="$mslug" timeout 30 mesh-memory-recall --report --oneline >"$mc.tmp" 2>/dev/null && [ -s "$mc.tmp" ]; then
          mv "$mc.tmp" "$mc"
        else rm -f "$mc.tmp"; fi
      fi
      mage="$(age_of "$mc")"; mnote=""
      case "$mage" in *h|*d) mnote=" — CACHE $mage OLD (scan failing?)" ;; esac
      echo "-- memory corpus (mesh-memory-recall: retained vs. actually-read)$mnote --"
      if [ -s "$mc" ]; then cat "$mc"; else echo "  (no recall meter yet — mesh-memory-recall --scan)"; fi
      echo "-- digest gaps (roll-call DIGEST, curated cross-mesh) --"
      dg="$(grep 'roll-call DIGEST' "$M/chat.log" 2>/dev/null | tail -1 | grep -oiE 'GAPS:.*' | clip 200)"
      [ -n "$dg" ] && printf '  %s\n' "$dg" || echo "  (none this cycle)"
      # Raw-keyword "stuck strands" grep RETIRED 2026-07-24 (operator: "make top pane focused and clean"):
      # it substring-matched OVERDUE|BLOCKED|INCIDENT|... over raw prose, so a [done] post EXPLAINING a
      # past incident ("...priority:incident: mesh-loop-baton has no --help...ALREADY RESOLVED") matched
      # identically to a genuinely open one — proven false-positive, live pane showed 4 resolved [done]/
      # [fyi] posts as "stuck" with zero actually-open items (the substring-scan-turns-prose-into-a-verdict
      # trap, CLAUDE.md). mesh-promises' CLAIM/HOLD commodities (landed a22b704) now parse [task]/[taking]/
      # [verify]/[hold] into real double-entry leak state, rendered in "promise ledger" above (TAPE half)
      # — that supersedes this block for formal markers with zero false positives.
      echo "-- board (last 8) --"; tail -8 "$M/chat.log" 2>/dev/null | clip 160 ;;
    verify)
      echo "-- verify results (per-tool, from board) --"; timeout 10 mesh-verify-table 2>/dev/null | head -16
      echo "-- landed recently (reality-check these) --"; git -C "$REPO" --no-pager log --oneline -5 2>/dev/null
      echo "-- tools touched <=24h (re-verify surface) --"; git -C "$REPO" --no-pager log --since=24.hours --name-only --pretty=format: -- scripts/ 2>/dev/null | sort -u | sed '/^$/d' | head -6
      echo "-- uncommitted (stranding watch) --"; git -C "$REPO" status --short -- scripts/ 2>/dev/null | head -4
      # NOT "last 2 runs" — doctor.log is append-only and a run writes ONE LINE PER FINDING, so tail -2
      # can be two lines of one run, or two lines days apart. Since the cron run-stamp (2026-08-11) each
      # line carries its own ISO ts and lines of one run share it, so say what this actually is and let
      # the reader date it (an undateable doctor line is what made health misread an aged-out FAIL as live).
      echo "-- doctor findings (last 2 lines; stamp = run) --"; tail -2 "$M/doctor.log" 2>/dev/null
      echo "-- backlog (work queued) --"; grep -vE '^[[:space:]]*(#|$)' "$M/backlog" 2>/dev/null | head -3 ;;
    codex|worker)
      # YOUR queue only — filter the backlog to THIS worker's tasks (local:<role>|...), not the whole
      # backlog. Showing everyone's tasks as "your queue" let codex read a gemini task as its own.
      myq="$(grep "^local:$role|" "$M/backlog" 2>/dev/null | head -4)"
      echo "-- backlog (your queue: $role) --"; [ -n "$myq" ] && printf '%s\n' "$myq" || echo "  (nothing queued for $role — pull from the board or discover)"
      echo "-- ideas open --"; grep -E '^\[ \]' "$M/ideas-queue" 2>/dev/null | head -4
      echo "-- feed (last assignments) --"; tail -3 "$M/feed.log" 2>/dev/null
      echo "-- pump engine (generate) --"; tail -2 "$M/generate.log" 2>/dev/null ;;
    minds)
      # ALL-MINDS state — the data the 'minds' channel observes (its bottom pane is the reviver loop).
      # This window is FOR mind-orchestration, so its data pane carries everything that job needs:
      # who's free, what's unclaimed, and where the compute is going (operator 2026-06-15: a window's
      # data pane should hold all that matters for what the window is FOR).
      # ONE per-mind table (was TWO redundant: --watch live-state + --stats — both showed STATE, together
      # overflowing the 32-row pane so the top scrolled off-screen → windows "went missing", operator
      # 2026-06-25). Keep the live STATE/activity view; drop the duplicate --stats (its ctx/$ cols read
      # '?' anyway). NO head-cap on the per-mind list → ALL mind windows show (head -7/-8 truncated
      # chat/room/pub once the set grew to 8). STATE word kept, churning spinner-timer stripped.
      echo "-- live state per mind channel (orchestration: who's WORKING / IDLE / blocked) --"
      mesh-mind-state --watch 2>/dev/null | grep -vE 'would alert|^bash:' \
        | sed -E 's/ — [^(]*\([0-9]+[hmsd]([ ·][^)]*)?\)//'
      echo "-- allocation: idle hands & unclaimed work (mesh-dispatch) --"
      # 25s not 12: the OPEN scan went FULL-BOARD (dispatch-open-set-is-window-bound — it was tail-400 and
      # buried-but-open tasks were invisible+unroutable for days), which processes every board [task] line
      # (~335) not just the recent window (~56), so --status is ~15s here vs the old ~4s even after the scan
      # was optimized (loop-skip, pre-grep, pure-bash id fns, cached STATE/exposure, hoisted clock: 27s→15s).
      # The residual is the honest price of correct visibility; the 5-min cron pass absorbs it fine, and this
      # budget keeps the pane populated under load jitter. Further headroom would come from batching the
      # per-line claim_ts date parse — a deeper is_open refactor left for a reviewed change.
      # MESH_DASH_FAST (set only by --test): skip this 23s+ full-board scan. --test asserts the
      # dispatch GATE line (from mesh-pace, ~0.8s below), NEVER this allocation output, so skipping it
      # costs the test nothing while dropping the frame from ~31s to ~8s — under mesh-land's 30s autoland
      # `timeout 30 bash <bin> --test` gate, which was mislabelling this slow-but-GREEN test as
      # '--test failing' and permanently stranding mesh-dash from autolanding. LIVE pane never sets the
      # flag → keeps the full 25s scan. (2026-07-18)
      if [ "${MESH_DASH_FAST:-0}" = 1 ]; then
        echo "  (fast render: full-board dispatch scan skipped — live pane runs it)"
      else
        timeout 25 mesh-dispatch --status 2>/dev/null | grep -aE 'idle workers|open tasks|  - ' | head -4
      fi
      # WHY nothing moves. --status renders idle hands + open tasks but NEVER the spend governor that
      # holds the pass, so "1 idle / 10 open" reads as dispatch-is-broken and every mind re-probes
      # mesh-pace by hand to explain it (live 11:09Z: genome idle, 9 open, PACE-SKIP every cycle for
      # 40min — the pane showed the symptom and withheld the cause). The probe a mind repeats every
      # turn belongs on top. Silent when mesh-pace is absent/unreadable — no fake READY.
      # A PER-FRAME CAP ON A GROWING DEPENDENCY ROTS, TWICE NOW. 6s→15s was the first round (mesh-pace
      # --status ~11-12s then); by 2026-08-10 the same scan measured 22.6-24.0s (3 runs), so `timeout 15`
      # killed it on EVERY render again — gate line silently absent from the live pane and mesh-dash
      # --test red on exactly this string, stranding the dash from autoland. Bumping the constant a third
      # time just re-arms it. So: CACHE the one row we need (house TTL idiom, as FLEET above) — the frame
      # reads a file, and the expensive scan runs at most once per TTL instead of once per 30s frame.
      # The cap survives only as a wedge-guard, and its expiry is now LOUD (an UNREADABLE line naming it),
      # never a silently missing gate. Cheaper than before, too: ~23s/150s beats 15s-wasted/30s.
      # CACHE-ONLY mode exists for --test: mesh-land gates every tool under `timeout 30`, and a cold-cache
      # render pays ~28s of that budget for one line (2s of margin = the stranding trap again, one layer
      # over). The test reads the row the live pane already refreshes and never scans itself.
      pc="$PACE_CACHE"; page=$(( $(date +%s) - $(stat -c %Y "$pc" 2>/dev/null || echo 0) ))
      if [ "${MESH_DASH_PACE_CACHE_ONLY:-0}" = 1 ]; then
        page="$page"   # no refresh: render whatever the pane last cached, or the UNREAD line below
      elif [ ! -s "$pc" ] || [ "$page" -gt 150 ]; then
        ptmp="$pc.$$.tmp"   # PID-unique (same race as .fleet-health.cache above)
        # no `exit` in the awk: closing the pipe early SIGPIPEs mesh-pace and, under `set -o pipefail`,
        # turns a good read into a failed pipeline. Emptiness is checked on the file instead of the rc.
        timeout 45 mesh-pace --status 2>/dev/null | awk '$1=="dispatch"{print}' > "$ptmp" 2>/dev/null
        [ -s "$ptmp" ] && mv -f "$ptmp" "$pc"; rm -f "$ptmp"
        page=$(( $(date +%s) - $(stat -c %Y "$pc" 2>/dev/null || echo 0) ))
      fi
      # only a mode that ATTEMPTED the refresh may blame it: under cache-only nothing was re-read, so
      # "re-read failing" would accuse a call that never happened (this node has no live minds pane —
      # the row is warmed by whoever renders the frame, so an old age here is absence, not failure).
      pstale=""
      if [ "$page" -gt 600 ]; then
        if [ "${MESH_DASH_PACE_CACHE_ONLY:-0}" = 1 ]; then pstale=" (cache-only: not re-read)"
        else pstale=" ⚠️STALE (pace re-read failing — fix me)"; fi
      fi
      if [ -s "$pc" ]; then
        # columns: key last_age eff_gap remain now. The READY branch used to print eff_gap as "gap %dm
        # elapsed" — the REQUIREMENT rendered as the ELAPSED time (live: "gap 1m elapsed" while 98m had
        # actually elapsed against a 1m gap). Both quantities are named now.
        awk -v age="$(age_of "$pc")$pstale" '$1=="dispatch"{
          if ($5=="skip") printf "  gate: dispatch HELD by spend governor — %dm of %dm gap remain (tasks stay open, retry next */5) · pace read %s ago\n", $4/60, $3/60, age;
          else printf "  gate: dispatch READY — %dm elapsed since last pass vs %dm required gap · pace read %s ago\n", $2/60, $3/60, age }' "$pc"
      elif [ "${MESH_DASH_PACE_CACHE_ONLY:-0}" = 1 ]; then
        echo "  gate: dispatch UNREAD — cache-only render and the cached row is cold (the live pane refreshes it every 150s)"
      elif command -v mesh-pace >/dev/null 2>&1; then
        echo "  gate: dispatch UNREADABLE — mesh-pace --status produced no dispatch row within the 45s cap (it measured ~23s on 2026-08-10); this is NOT a green, raise the cap or fix pace"
      fi
      # division of labour (mesh-forage 3rd axis): the colony's INTENDED allocation (owner: histogram
      # over [task]) vs REALIZED engagement ([done]). This is an orchestration signal — an unengaged
      # specialist (assigned but delivering 0) is the dead-lane starvation PRECURSOR the who's-WORKING
      # table above cannot see, and the intended-vs-realized J gap says whether assignment spread
      # matches delivery. Silent if mesh-forage/jq unavailable (no fake all-clear). ~cheap: reads board.
      echo "-- division of labour: intended (owner:) vs realized ([done]) allocation (mesh-forage) --"
      timeout 20 mesh-forage --json 2>/dev/null | jq -r '
        (if (.assigned_tasks // 0) == 0 then "  no owner-assigned [task]s in window — intended-allocation field empty"
         else "  intended J=\(if .intended_evenness_J == -1 then "n/a(1 lane)" else .intended_evenness_J end) (assigned=\(.assigned_tasks)) · realized J=\(.evenness_J) (dominant=\(.dominant_lane) \(.dominant_share))" end),
        (if (.unengaged_specialists // "") != "" then "  ⚠ UNENGAGED SPECIALIST (assigned, delivered 0 — recruitment gap / dead-lane precursor): \(.unengaged_specialists)" else empty end),
        (if (.elastic_generalists // "") != "" then "  elastic: \(.elastic_generalists)— generalists absorbing unassigned work" else empty end)
      ' 2>/dev/null
      echo "-- quota: burn · weekly-position · waste (mesh-quota) --"
      timeout 6 mesh-quota 2>/dev/null | grep -E 'WALLED|FALLBACK|burn|weekly|verdict' | head -4
      echo "-- spend: where compute goes, paid vs free (mesh-spend) --"
      timeout 6 mesh-spend --by-provider 2>/dev/null | grep -E 'PAID|->|free|paid' | head -4
      # the OTHER budget this window allocates: the operator's own body. He asked 2026-08-16 for
      # the mesh to use him as an actuator LESS ("актуаторы Илья использовать поменьше"), and a
      # metric nobody can see is not a metric — so the HANDS/WORD rate lives beside the spend it
      # sits next to conceptually. ~0.4s, board-derived, writes nothing.
      echo "-- operator as actuator: HANDS is the axis to shrink (mesh-operator-hands) --"
      timeout 8 mesh-operator-hands --dash 2>/dev/null | sed 's/^/  /'
      # last /compact per ACTIVE mind channel — tmux-derived (not a stale hardcoded list that misses
      # newly-activated windows like room/pub; same window filter mesh-mind-state uses).
      mc="$(tmux list-windows -t "$(hostname)" -F '#{window_name}' 2>/dev/null | grep -vxE 'bash|shell|reflex|sh|mon:.*' | tr '\n' ' ')"
      echo "  last /compact:$(for w in $mc; do printf ' %s=%s' "$w" "$(age_bucket "$M/.compact-$w")"; done)"
      # ctx pressure — who is near their context wall NOW (the /compact early-warning; pairs with the
      # age line above: that says who compacted long ago, this says who is filling up). Two lines: a
      # DISTRIBUTION (count·max% over all live transcripts) + a PER-MIND line naming each window's ctx,
      # fed by the statusline breadcrumbs in ~/.mesh/ctx (the one place window↔transcript is known).
      # sed indents every emitted line; silent if the read fails (no fake reading).
      timeout 6 mesh-ctx-pressure 2>/dev/null | sed 's/^/  /'
      echo "-- mesh-wide: which minds exist where (caps · senses · actuators) --"
      mesh-minds 2>/dev/null | head -8 ;;
    dev)
      # the AUTONOMOUS DEVELOPMENT loop in one view: ideas → pump → minds → landed/stranded
      echo "$(stress_line)"   # dev mind asked for thermal — heat is what throttles a coding mind
      # dev-pane reply 2026-06-15 ([data-pane]: cost line useless @ $0 free tier) — show what a coding
      # mind ACTUALLY needs: which relay pools are live, quota burn this 5h window, how many minds are stuck.
      echo "relay: $(timeout 6 mesh-relay --status 2>/dev/null | awk -F: 'NF>=2{gsub(/ /,"",$1);printf "%s ",$1}')| spend(5h): $(timeout 4 mesh-spend 2>/dev/null | awk '$NF ~ /^[0-9]+$/{t+=$NF} END{print t+0}')t | blocked-minds: $(grep -lE 'BLOCKED|RATE-LIMITED|NEEDS-INPUT|DEAD' "$M"/.mind-state-* 2>/dev/null | wc -l)"
      td=$(date -u +%F); echo "board today (real work — minds PULL from here; ideas/backlog pump RETIRED 2026-06-13, empty=normal): [task] $(grep "$td" "$M/chat.log" 2>/dev/null | grep -c '\[task\]') taking $(grep "$td" "$M/chat.log" 2>/dev/null | grep -c '\[taking\]') done $(grep "$td" "$M/chat.log" 2>/dev/null | grep -c '\[done\]')"
      echo "-- open ideas (next fuel) --"; grep -E '^\[ \]' "$M/ideas-queue" 2>/dev/null | head -4
      echo "-- last assignments (feed) --"; tail -3 "$M/feed.log" 2>/dev/null
      echo "-- pump engine (generate) --"; tail -3 "$M/generate.log" 2>/dev/null
      echo "-- queue-tend (anti-dup reconcile) --"; tail -2 "$M/queue-tend.log" 2>/dev/null
      echo "-- landed (review these) --"; git -C "$REPO" --no-pager log --oneline -4 2>/dev/null
      echo "-- stranded/uncommitted (mesh-land tends) --"; git -C "$REPO" status --short -- scripts/ knowledge/ 2>/dev/null | head -5 ;;
    reflexes)
      # SELF-TEND view: vitals (temp = this fleet's known failure mode) + every reflex's liveness
      echo "-- vitals --"; mesh-vitals 2>/dev/null | head -2
      echo "-- therm edges (last 2) --"; tail -2 "$M/therm.log" 2>/dev/null
      echo "-- supervised loops --"; mesh-supervise --status 2>/dev/null | head -16
      echo "-- crontab vs desired --"; mesh-reflexes --check 2>&1 | tail -2
      echo "-- edge states (every reflex, re-derived live) --"; state_wall
      echo "-- beats (per-run liveness: self, peers, reflexes) --"; beat_wall ;;
    sense)
      # the PERCEPTION channel — operator 2026-06-13: merge the 4 mon:* streams + body senses into
      # ONE rich window with a mind that reacts to what's happening around the body. All re-observed
      # live (perceive-anew), nothing stored.
      echo "-- where (cross-node BLE space-map: device | nearest node | rssi self/peer) --"
      if [ -n "${BLE_PEER:-}" ]; then
        timeout 24 mesh-presence-fuse "$BLE_PEER" 2>/dev/null | grep -F '|' | head -6 \
          || { echo "  (cross-node fusion: peer slow/unreachable — local proximity:)"; timeout 10 mesh-presence 2>/dev/null | head -4; }
      else
        echo "  (single BLE vantage — proximity to $(hostname) only; add a 2nd BLE node for a map)"; timeout 12 mesh-presence 2>/dev/null | head -5 || echo "  (scan timeout)"
      fi
      echo "-- body activity (the phone) --"; timeout 12 mesh-body-motion 2>/dev/null | head -1 || echo "  (phone unreachable)"
      echo "-- ambient light --"; timeout 12 mesh-light --status 2>/dev/null | head -1 || echo "  (phone unreachable)"
      echo "-- novelty (surprising board events) --"; mesh-novelty --threshold 3.5 2>/dev/null | head -3
      echo "-- presence trends (residents/arrivals) --"; mesh-presence-trends 2>/dev/null | head -3
      echo "-- streams (last fed to minds) --"; tail -3 "$M/channels.log" 2>/dev/null ;;   # converged feeder log (stream.log retired 2026-06-17)
    discover)
      # GROWTH window — operator 2026-06-25 made the LITERATURE-REVIEW lane discover's OWN duty:
      # READ the field → WRITE a review → APPLY it itself (a review ENDS IN AN ATTEMPT, never a hand-off
      # — operator 2026-06-21). NO window-state/status here (operator: "состояние окошка discover явно
      # не нужно") — this pane is FED BY DISCOVER'S OWN WORK: what to read, what it reviewed, what it's
      # trying now. The mind reads this pane and self-drives read→review→apply (closed-loop consume).
      echo "mission: ~/.mesh/discover-mission.md | reviews → ~/.mesh/knowledge/review-*.md"
      echo "pre-file gate: mesh-prior-art <VID:PID/MAC/name> BEFORE any new knowledge/ file — PRIOR ART (rc 0) = cite/supersede; WEAK (rc 1, 'term ⊂ word') = a substring collision, NOT prior art, file anyway"
      # READ — fresh field briefs (mesh-study fetcher) + any pending literature ideas in the queue
      echo "-- READ: latest field briefs (mesh-study → study.log) --"
      grep -E '^=== study:' "$M/study.log" 2>/dev/null | tail -4 | sed 's/^=== study: /  /; s/ ===$//' || echo "  (no briefs — run mesh-study to pull the field)"
      echo "-- READ: pending literature ideas (queue) --"
      # capture-then-test (pipefail + `| head` SIGPIPEs `grep`/`ls` → a bare `|| echo` misfires)
      _lit="$(grep -E '^\[[ ~]\] (STUDY|LITERATURE|LIT)\(' "$M/ideas-queue" 2>/dev/null | tail -4)"
      [ -n "$_lit" ] && printf '%s\n' "$_lit" | clip 96 | sed 's/^/  /' || echo "  (none queued — bridge from a brief)"
      # REVIEW — the reviews discover has WRITTEN (newest first). Rank by FILENAME DATE, not
      # mtime: knowledge-sync mass-touches every doc to one identical mtime, so `ls -t` returns
      # an ARBITRARY 4-set that flaps between passes — and a flapping section churns the pane
      # signature, so the loop-baton/pane-consume wake diff fires on nothing (false-wake burn,
      # 2026-07-05; same defect FRONTIER below fixed on 2026-06-26).
      echo "-- REVIEW: latest reviews written (knowledge/) --"
      _revs="$(for _f in "$HOME/.mesh/knowledge"/review-*.md; do
                 [ -e "$_f" ] || continue
                 _d="$(printf '%s\n' "${_f##*/}" | grep -oE '20[0-9]{2}-?(0[1-9]|1[0-2])-?(0[1-9]|[12][0-9]|3[01])' | tr -d '-' | sort -rn | head -1)"
                 printf '%s\t%s\n' "${_d:-00000000}" "$_f"
               done | sort -rk1,1 | head -4 | cut -f2)"
      [ -n "$_revs" ] && printf '%s\n' "$_revs" | sed 's|.*/review-|  |; s|\.md$||' || echo "  (none yet)"
      # APPLY — the attempt: the loop must close in a real try, not end as a review
      echo "-- APPLY: literature attempts on the board (recent) --"
      grep -iE 'STUDY\(|literature|review-|applied.*concept|try(ing)? ' "$M/chat.log" 2>/dev/null | tail -4 | clip 100 | sed 's/^/  /'
      # FRONTIER — the apply targets (capability gaps to grow into); kept lean, no per-tick SSH/spend.
      # Rank by the DATE EMBEDDED IN THE FILENAME, not mtime: knowledge-sync/git touches every file
      # to one identical mtime, so `ls -t` could not surface recency — it pinned 2wk-stale gaps files
      # and hid the same-day re-triage notes entirely (discover-dash defect, 2026-06-26). Filename
      # dates arrive as 2026-06-26 or 20260626 → strip dashes, take the latest, sort desc; undated last.
      echo "-- FRONTIER: recent capability finds (apply targets) --"
      _caps="$(for _f in "$HOME/.mesh/knowledge"/*capab*; do
                 [ -e "$_f" ] || continue
                 # year anchored to 20xx + valid month/day, so model numbers like GL-MT3000 don't read as a date
                 _d="$(printf '%s\n' "${_f##*/}" | grep -oE '20[0-9]{2}-?(0[1-9]|1[0-2])-?(0[1-9]|[12][0-9]|3[01])' | tr -d '-' | sort -rn | head -1)"
                 printf '%s\t%s\n' "${_d:-00000000}" "$_f"
