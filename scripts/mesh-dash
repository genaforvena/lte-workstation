#!/usr/bin/env bash
# mesh-dash <role> — renders the live DATA text for a channel's TOP pane (data = text, self-refreshing).
# Pairs with a mind in the bottom pane (the channel pattern: top data, bottom mind). All text.
# ROLE-SPECIFIC by operator request: the board lives in the chat window ONLY — no dash tails chat.log.
#   roles: steward | check | verify | codex/worker | <anything> (falls back to the node card)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
ONCE=0
if [ "${1:-}" = --test ]; then
  # a dash that paints a blank pane looks alive and informs nobody — so the smoke is a REAL
  # one-frame render (via --once), asserted on content, not an echo-ok
  for x in date git awk grep tail head printf; do
    command -v "$x" >/dev/null 2>&1 || { echo "smoke-test: FAIL (no $x)"; exit 1; }
  done
  out="$("$0" --once verify 2>&1)" || { echo "smoke-test: FAIL (verify render exited non-zero)"; exit 1; }
  printf '%s' "$out" | grep -q 'landed recently' || { echo "smoke-test: FAIL (verify frame missing its data block)"; exit 1; }
  out="$("$0" --once card-fallback 2>&1)" || { echo "smoke-test: FAIL (fallback render exited non-zero)"; exit 1; }
  printf '%s' "$out" | grep -q 'node card' || { echo "smoke-test: FAIL (fallback frame missing node card)"; exit 1; }
  echo "smoke-test: ok"; exit 0
fi
[ "${1:-}" = --once ] && { ONCE=1; shift; }   # render one frame and exit (no clear/sleep) — for --test
role="${1:-steward}"; M="$HOME/.mesh"; REPO="$HOME/lte-workstation"
while :; do
  [ "$ONCE" = 1 ] || clear
  printf '== %s data (refresh 30s) — all text ==\n' "$role"; date -u; echo
  case "$role" in
    steward)
      xn=$(tailscale debug prefs 2>/dev/null | python3 -c 'import json,sys;print(json.load(sys.stdin).get("ExitNodeID") or "none")' 2>/dev/null)
      echo "egress $(ip route get 1.1.1.1 2>/dev/null|grep -oP 'dev \K\S+') exitnode=$xn | reflexes $(mesh-supervise --status 2>/dev/null|grep -c UP)UP"
      echo "ideas open=$(grep -cE '^\[ \]' "$M/ideas-queue" 2>/dev/null) inflight=$(grep -cE '^\[~\]' "$M/ideas-queue" 2>/dev/null) done=$(grep -cE '^\[x\]' "$M/ideas-queue" 2>/dev/null) | backlog=$(grep -cvE '^[[:space:]]*(#|$)' "$M/backlog" 2>/dev/null)"
      echo "-- PLAN: next --"; awk '/^## 🔜 NEXT/{f=1;next} /^## /{f=0} f' "$M/PLAN.md" 2>/dev/null | grep -vE '^[[:space:]]*$' | head -5
      echo "-- feed (work-pump) --"; tail -3 "$M/feed.log" 2>/dev/null ;;
    check)
      echo "egress $(ip route get 1.1.1.1 2>/dev/null|grep -oP 'dev \K\S+') | reflexes $(mesh-supervise --status 2>/dev/null|grep -c UP)UP/$(mesh-supervise --status 2>/dev/null|grep -c DOWN)DOWN | organs $(mesh-organ-keepalive --status 2>/dev/null|grep -c LIVE)LIVE/$(mesh-organ-keepalive --status 2>/dev/null|grep -c DARK)DARK"
      echo "-- node card: health --"; awk '/^health:/{f=1;next} /^[^ ]/{f=0} f' "$HOME/.mesh-card" 2>/dev/null | head -4
      echo "-- monitor streams --"; tail -4 "$M/stream.log" 2>/dev/null ;;
    verify)
      echo "-- landed recently (reality-check these) --"; git -C "$REPO" --no-pager log --oneline -5 2>/dev/null
      echo "-- backlog (work queued) --"; grep -vE '^[[:space:]]*(#|$)' "$M/backlog" 2>/dev/null | head -4 ;;
    codex|worker)
      # YOUR queue only — filter the backlog to THIS worker's tasks (local:<role>|...), not the whole
      # backlog. Showing everyone's tasks as "your queue" let codex read a gemini task as its own.
      myq="$(grep "^local:$role|" "$M/backlog" 2>/dev/null | head -4)"
      echo "-- backlog (your queue: $role) --"; [ -n "$myq" ] && printf '%s\n' "$myq" || echo "  (nothing queued for $role — pull from the board or discover)"
      echo "-- ideas open --"; grep -E '^\[ \]' "$M/ideas-queue" 2>/dev/null | head -4
      echo "-- feed (last assignments) --"; tail -3 "$M/feed.log" 2>/dev/null ;;
    *)
      echo "-- node card --"; head -12 "$HOME/.mesh-card" 2>/dev/null ;;
  esac
  [ "$ONCE" = 1 ] && exit 0
  sleep 30
done
