#!/usr/bin/env python3
"""mesh-voice-print — speaker verification for the room reflex.

The audio classifier (RMS + spectral flatness) cannot tell the operator's voice
from TV/music — it labels mixed speech-over-music as "music" and the reflex stays
silent for weeks (operator 2026-07-04: "неужели нельзя вычленить фингерпринт моего
голоса"). This tool uses resemblyzer (a lightweight speaker-encoder, ~17MB, runs
on torch) to create voice embeddings for known speakers and match audio chunks
against them. Only a MATCH gates transcription — TV/music never matches.

Requires: pip3 install --user --break-system-packages --index-url https://download.pytorch.org/whl/cpu torch
          pip3 install --user --break-system-packages resemblyzer
(CPU-only torch wheel, ~200MB; installed 2026-07-04 on imozerov-IdeaPad-3-15IIL05 — --test
verified live: encoder loads, 256-dim embeddings, self-match round-trip, exit 0.)

  mesh-voice-print --enroll <name> <wav>   create/update a voice print from a wav
  mesh-voice-print --match <wav>           print: <name> <score>  (or NO_MATCH)
  mesh-voice-print --match-dir <dir>       match the NEWEST wav in <dir>
  mesh-voice-print --list                  list enrolled voices + their scores vs each other
  mesh-voice-print --test                  smoke: synth enrollment + self-match

Voice prints live in ~/.mesh/voice-prints/<name>.npy (256-dim L2-normalized vectors).
Threshold: VOICE_PRINT_THRESH=0.75 (cosine sim of L2-normalized embeddings — resemblyzer
scores genuine same-speaker ~0.8-0.95, different-speaker ~0.3-0.5).
"""
import os, sys, wave, glob, time

# Interpreter discovery: numpy (and torch/resemblyzer) may live only inside a venv (mesh-home:
# ~/.venv-ai — system python3 has none, memory numpy-only-in-venvs-on-mesh-home). Probe candidates
# by ABSOLUTE path and re-exec into the first that imports numpy; only "no numpy anywhere on the
# node" is the honest n/a (exit 2) — a venv-bearing node must run, never n/a (false-green).
try:
    import numpy as np
except ImportError:
    import subprocess
    _home = os.path.expanduser("~")
    _cands = [os.path.join(_home, ".venv-ai/bin/python3")] + sorted(
        glob.glob(os.path.join(_home, ".venv-*/bin/python3")))
    for _c in _cands:
        if os.access(_c, os.X_OK) and subprocess.run(
                [_c, "-c", "import numpy"], capture_output=True).returncode == 0:
            os.execv(_c, [_c, os.path.abspath(__file__)] + sys.argv[1:])
    sys.stderr.write("mesh-voice-print: n/a — no python3 with numpy on this node (system or ~/.venv-*)\n")
    sys.exit(2)

MESH = os.path.expanduser(os.environ.get("MESH_DIR", "~/.mesh"))
PRINTS_DIR = os.path.join(MESH, "voice-prints")
THRESH = float(os.environ.get("VOICE_PRINT_THRESH", "0.75"))

def _encoder():
    from resemblyzer import VoiceEncoder
    return VoiceEncoder()

def read_wav(path):
    """Read a mono s16 wav → float32 numpy @ 16kHz (resemblyzer format).

    Accepts ANY samplerate/channel count: downmixes stereo and resamples to 16k.
    The old hard `assert framerate==16000` crashed enroll AND match on the
    operator's own reference (22050Hz), the exact file a human hands the tool —
    resemblyzer resamples internally, so the strict assert was over-strict. The
    16kHz-mono path is kept byte-identical (no resample call) so prints enrolled
    before this fix (e.g. operator.npy) stay consistent with fresh match embeds."""
    w = wave.open(path, "rb")
    sr = w.getframerate()
    nch = w.getnchannels()
    sampwidth = w.getsampwidth()
    raw = w.readframes(w.getnframes())
    w.close()
    if sampwidth != 2:
        raise ValueError(f"expected 16-bit PCM, got {sampwidth * 8}-bit ({path})")
    wav = np.frombuffer(raw, dtype=np.int16).astype(np.float32) / 32768.0
    if nch > 1:
        wav = wav.reshape(-1, nch).mean(axis=1)  # downmix to mono
    if sr != 16000:
        import librosa  # resemblyzer already pulls this in
        wav = librosa.resample(wav, orig_sr=sr, target_sr=16000)
    return np.ascontiguousarray(wav, dtype=np.float32)

def embed_wav(path, encoder=None):
    """Extract a 256-dim voice embedding from a wav file."""
    if encoder is None:
        encoder = _encoder()
    wav = read_wav(path)
    if len(wav) < 16000 * 1.0:  # need at least ~1s
        return None
    return encoder.embed_utterance(wav)

def load_prints():
    """Load all enrolled voice prints: {name: embedding}."""
    prints = {}
    if not os.path.isdir(PRINTS_DIR):
        return prints
    for f in glob.glob(os.path.join(PRINTS_DIR, "*.npy")):
        name = os.path.splitext(os.path.basename(f))[0]
        prints[name] = np.load(f)
    return prints

def match_embed(embed, prints):
    """Return (best_name, best_score) or (None, 0.0)."""
    if not prints or embed is None:
        return None, 0.0
    best_name, best = None, 0.0
    for name, ref in prints.items():
        sim = float(np.dot(embed, ref))  # both L2-normalized → dot = cosine
        if sim > best:
            best, best_name = sim, name
    return best_name, best

def cmd_enroll(name, wav_path):
    if not os.path.exists(wav_path):
        print(f"enroll: wav not found: {wav_path}", file=sys.stderr); sys.exit(1)
    os.makedirs(PRINTS_DIR, exist_ok=True)
    enc = _encoder()
    embed = embed_wav(wav_path, enc)
    if embed is None:
        print(f"enroll: audio too short in {wav_path} (need >=1s)", file=sys.stderr); sys.exit(1)
    out = os.path.join(PRINTS_DIR, f"{name}.npy")
    np.save(out, embed)
    # cross-check against existing prints
    prints = load_prints()
    prints[name] = embed
    scores = {n: float(np.dot(embed, e)) for n, e in prints.items() if n != name}
    print(f"enrolled: {name} ({len(embed)}-dim → {out})")
    if scores:
        print(f"  cross-similarity: {', '.join(f'{n}={s:.2f}' for n,s in sorted(scores.items(), key=lambda x:-x[1]))}")
    sys.exit(0)

def cmd_match(wav_path):
    prints = load_prints()
    if not prints:
        print("NO_MATCH 0.00 (no voice prints enrolled)"); sys.exit(1)
    enc = _encoder()
    embed = embed_wav(wav_path, enc)
    if embed is None:
        print("NO_MATCH 0.00 (audio too short)"); sys.exit(1)
    name, score = match_embed(embed, prints)
    if name and score >= THRESH:
        print(f"{name} {score:.2f}"); sys.exit(0)
    else:
        # print best guess + score even if below threshold (useful for tuning)
        best = f"{name} {score:.2f}" if name else "NO_MATCH 0.00"
        print(f"NO_MATCH {score:.2f} (best: {name}, thresh={THRESH})"); sys.exit(1)

def cmd_match_dir(directory):
    """Match the NEWEST wav in a directory (the audio-buffer use case)."""
    wavs = sorted(glob.glob(os.path.join(directory, "*.wav")), key=os.path.getmtime)
    if not wavs:
        print("NO_MATCH 0.00 (no wavs)"); sys.exit(1)
    cmd_match(wavs[-1])

def cmd_list():
    prints = load_prints()
    if not prints:
        print("(no voice prints enrolled)"); sys.exit(0)
    names = list(prints.keys())
    print(f"enrolled voices ({len(names)}):")
    for n in names:
        print(f"  {n}")
    # cross-similarity matrix (sanity: same-speaker should be high, cross-speaker low)
    if len(names) >= 2:
        print("\ncross-similarity:")
        for i, a in enumerate(names):
            row = []
            for j, b in enumerate(names):
                if i == j:
                    row.append("  1.00")
                else:
                    row.append(f"  {float(np.dot(prints[a], prints[b])):.2f}")
            print(f"  {a:12s}:" + "".join(row))

def _dep_check(import_thunk):
    """Run import_thunk() and return (ok, err-or-None). Broad `except Exception` — NOT just
    ImportError — so a corrupt install (e.g. resemblyzer/torch raising OSError from a missing
    libtorch_global_deps.so, the actual failure seen live 2026-07-04) reports the exception
    class/message cleanly instead of crashing --test with a raw traceback
    (chat-review/voiceprint-dep-error-clean)."""
    try:
        import_thunk()
        return True, None
    except Exception as e:
        return False, f"{type(e).__name__}: {e}"

def cmd_test():
    fails = []
    def _t(ok, msg):
        if not ok: fails.append(msg)
        print(f"  {'ok' if ok else 'FAIL'}: {msg}")

    # regression: _dep_check must catch OSError (and other non-ImportError exceptions), not just
    # ImportError — otherwise a corrupt torch install crashes --test with a raw traceback instead
    # of a clean FAIL line (chat-review/voiceprint-dep-error-clean). FALSIFIABLE: narrow _dep_check
    # back to `except ImportError` and this assert fails on the OSError case.
    def _boom(): raise OSError("libtorch_global_deps.so: cannot open shared object file")
    _ok, _err = _dep_check(_boom)
    _t((not _ok) and bool(_err) and _err.startswith("OSError"), f"dep-check catches OSError cleanly (got: {_err})")

    # deps
    ok, err = _dep_check(lambda: __import__("torch"))
    if ok:
        import torch
        _t(True, f"torch {torch.__version__}")
    else:
        _t(False, f"torch import failed: {err}"); print(f"smoke-test: FAIL ({'; '.join(fails)})"); sys.exit(1)
    ok, err = _dep_check(lambda: __import__("resemblyzer", fromlist=["VoiceEncoder"]))
    if ok:
        from resemblyzer import VoiceEncoder
        _t(True, "resemblyzer import")
    else:
        _t(False, f"resemblyzer import failed: {err}"); print(f"smoke-test: FAIL ({'; '.join(fails)})"); sys.exit(1)

    # synth two DIFFERENT audio signals and verify the encoder distinguishes them:
    # a low-frequency tone ("speaker A") vs a high-frequency tone ("speaker B")
    # — they're not real voices, but the encoder should produce different embeddings
    # (similarity well below 1.0), proving the pipeline works end-to-end.
    import tempfile
    enc = VoiceEncoder()
    sr = 16000
    t = np.arange(sr * 3) / sr  # 3 seconds

    sig_a = np.sin(2 * np.pi * 120 * t).astype(np.float32) * 0.5   # low tone
    sig_b = np.sin(2 * np.pi * 440 * t).astype(np.float32) * 0.5   # high tone

    emb_a = enc.embed_utterance(sig_a)
    emb_b = enc.embed_utterance(sig_b)
    sim_ab = float(np.dot(emb_a, emb_b))
    _t(len(emb_a) == 256, f"embedding dim = {len(emb_a)} (want 256)")
    _t(sim_ab < 0.99, f"different signals → different embeddings (sim={sim_ab:.3f} < 0.99)")
    _t(sim_ab >= -1.0, f"cosine sim in valid range ({sim_ab:.3f})")

    # enroll + match round-trip (same signal → should match itself)
    td = tempfile.mkdtemp()
    w = wave.open(os.path.join(td, "ref.wav"), "wb")
    w.setnchannels(1); w.setsampwidth(2); w.setframerate(sr)
    w.writeframes((sig_a * 32768).astype(np.int16).tobytes()); w.close()

    os.environ["MESH_DIR"] = td
    global PRINTS_DIR
    PRINTS_DIR = os.path.join(td, "voice-prints")
    os.makedirs(PRINTS_DIR, exist_ok=True)
    np.save(os.path.join(PRINTS_DIR, "tone_a.npy"), emb_a)
    prints = load_prints()
    name, score = match_embed(emb_a, prints)
    _t(name == "tone_a", f"self-match: {name} (want tone_a)")
    _t(score >= THRESH, f"self-match score {score:.3f} >= thresh {THRESH}")

    # regression: read_wav must accept a NON-16kHz wav (the operator's own
    # reference is 22050Hz) — the old hard assert crashed enroll AND match on it.
    # FALSIFIABLE: restore `assert getframerate()==16000` in read_wav and this
    # fails (AssertionError → caught → FAIL line), watched RED before the fix.
    w22 = os.path.join(td, "ref22050.wav")
    sr22 = 22050
    t22 = np.arange(sr22 * 2) / sr22
    sig22 = (np.sin(2 * np.pi * 150 * t22).astype(np.float32) * 0.5)
    _w = wave.open(w22, "wb")
    _w.setnchannels(1); _w.setsampwidth(2); _w.setframerate(sr22)
    _w.writeframes((sig22 * 32768).astype(np.int16).tobytes()); _w.close()
    try:
        emb22 = embed_wav(w22, enc)
        _t(emb22 is not None and len(emb22) == 256,
           f"read_wav accepts 22050Hz → 256-dim embed (got {None if emb22 is None else len(emb22)})")
    except Exception as e:
        _t(False, f"read_wav crashed on 22050Hz wav: {type(e).__name__}: {e}")

    import shutil; shutil.rmtree(td)

    if fails:
        print(f"smoke-test: FAIL ({'; '.join(fails)})"); sys.exit(1)
    print("smoke-test: ok (encoder + embeddings + cosine match round-trip)")
    sys.exit(0)

if __name__ == "__main__":
    if len(sys.argv) < 2:
        print(__doc__); sys.exit(1)
    cmd = sys.argv[1]
    if cmd == "--enroll":
        if len(sys.argv) < 4:
            print("usage: mesh-voice-print --enroll <name> <wav>"); sys.exit(1)
        cmd_enroll(sys.argv[2], sys.argv[3])
    elif cmd == "--match":
        if len(sys.argv) < 3:
            print("usage: mesh-voice-print --match <wav>"); sys.exit(1)
        cmd_match(sys.argv[2])
    elif cmd == "--match-dir":
        if len(sys.argv) < 3:
            print("usage: mesh-voice-print --match-dir <dir>"); sys.exit(1)
        cmd_match_dir(sys.argv[2])
    elif cmd == "--list":
        cmd_list()
    elif cmd == "--test":
        cmd_test()
    else:
        print(f"unknown command: {cmd}"); print(__doc__); sys.exit(1)
