#!/usr/bin/env bash
# mesh-clear — the /clear a mind types instead of a bare /clear. It does ONE thing in one order:
#
#     write a fresh handoff  →  /clear the pane  →  record the row
#
# There is NO judgement in it. No model, no coverage classification, no freshness arithmetic, no
# --auto re-gate. (Operator direction, 2026-07-24: "get rid of the conditional clears and make this
# logic dead simple".)
#
#   mesh-clear <window>            write handoff, /clear that window's mind pane, log it
#   mesh-clear <window> --dry-run  print what would happen; writes nothing, clears nothing
#   mesh-clear --gate <window>     query ONLY the bg-delivery backstop (for other launchers)
#   mesh-clear --test              smoke test (drives the real flow; asserts NO model is consulted)
#
# WHY THE MODEL GATE IS GONE. The old gate asked a tiny LLM "does this handoff COVER the recent
# work?" and blocked on anything short of an affirmative YES. That question only ever mattered
# because clears happened at ARBITRARY moments — a 45-minute timer, a context %, a stuck poll —
# i.e. in the MIDDLE of a task, where uncommitted work-state genuinely could be lost. Move the clear
# to the TASK BOUNDARY and the question answers itself:
#   · before a mind stakes a [taking], the previous task is already closed — nothing is in flight;
#   · after it posts [done], the artifact IS the commit + the board line, not the context.
# and for the mid-task clear a mind chooses to take, the safety net is already built and DETERMINISTIC:
# `mesh-handoff --snapshot` runs every 5 minutes, extracts the pane verbatim, and parks the worktree at
# refs/wip/<window> (mesh-wip-commit). That is what actually rescues a thread — measured, not judged.
# The model added a second, WORSE copy of that guarantee: it permitted only ~43% of covered clears
# (over-block 4/7 on its own bench) and cost a GPU call per clear. A gate that duplicates a
# deterministic guarantee, less reliably, is not a safety feature — it is a coin flip in the path.
#
# THE ONE CONDITION THAT REMAINS is not a judgement, it is a fact on disk: an unshipped DETACHED
# batch (bg manifest `running` / `done-undelivered`). A mind may launch work that delivers from its
# OWN completion path (mesh-bg-done), not from the mind; clearing mid-flight strands that delivery,
# and no handoff un-strands it. That scan reads files and compares pids — no model, no scrollback.
#
# HANDOFF WRITE, NOT HANDOFF CHECK. mesh-clear no longer asks whether a handoff exists — it WRITES
# one (mesh-handoff --snapshot, extractive + capped + clobber-protected), then clears. A clear whose
# handoff write could not run at all is a clear that drops state, so that is a hard failure of the
# procedure, not an extra gate.
# orphan-ok: on-demand — a mind runs it in place of /clear; not a cron reflex.
set -uo pipefail

MESH_DIR="${MESH_DIR:-$HOME/.mesh}"
HANDOFF_DIR="${MESH_HANDOFF_DIR:-$MESH_DIR/handoff}"
BG_DIR="${MESH_BG_DIR:-$MESH_DIR/bg}"                # bg-task delivery manifests (mesh-bg-register/-done)
SESSION="${MESH_CLEAR_SESSION:-$(hostname)}"
# the handoff writer lives in _write_handoff and is resolved AT CALL TIME (never a load-time global:
# a `MESH_CLEAR_HANDOFF_CMD=… mesh-clear …` prefix — which is how --test drives the real flow against a
# stub — cannot rebind a var already expanded at source time). NEVER a model: mesh-handoff --snapshot is
# deterministic extraction (it deliberately does not call one — a model per window would thrash the GPU
# the senses need).

_handoff_file() { printf '%s/%s.md' "$HANDOFF_DIR" "$(printf '%s' "$1" | tr -c 'A-Za-z0-9._-' '_')"; }

# --- THE ONLY BLOCKER: bg-task delivery. A mind may launch a DETACHED batch (mesh-sound-reflex's
# grind `... &`) that delivers from its OWN completion path via mesh-bg-done, NOT the mind. If the mind
# /clears mid-batch, that delivery must not be stranded. mesh-bg-register writes a manifest per detached
# task under ~/.mesh/bg/<window>/; this scans them. FIVE states (see mesh-bg-register): the gate BLOCKS
# on `running` (batch in flight) and `done-undelivered` (real output that never shipped), and PASSES on
# `delivered`, `done-nodeliver` and `crashed` (nothing to strand / nothing left that COULD deliver).
# Uncertainty about UNSHIPPED WORK blocks — that is a fact about a file, not an opinion about coverage.
# Sets globals G_BG_VERDICT (OK | BLOCK:bg-undelivered | BLOCK:bg-running) and G_BG_DETAIL (the offending
# "<batch>:<status>" list). Sets globals rather than echoing so callers read them WITHOUT a subshell — a
# $(...) capture would strand G_BG_DETAIL and, under set -u, blow up the later block message with an
# unbound-variable exit.
# CRASH-REAP (2026-07-21): a `running` manifest whose pid is DEAD and whose `updated` is older than
# MESH_BG_CRASH_GRACE (default 300s) is a batch that died BEFORE mesh-bg-done ever ran — a crash
# mid-delivery lands `done-undelivered` instead, because bg-done flips status FIRST. No surviving
# process will deliver it, so blocking every future /clear on it saves nothing: that is the
# stale-lease trap the manifest schema already names. The scan flips it → `crashed` (persisted) and
# says so LOUDLY (stderr + G_BG_REAPED); the batch's loss is the launcher's to notice, not the
# clear-gate's to guard forever. The grace window covers register/fork pid races; an unparseable pid
# is unverifiable → still BLOCKS; a LIVE pid blocks regardless of age (age alone never reaps).
_bg_scan() { # $1=window → sets G_BG_VERDICT, G_BG_DETAIL, G_BG_REAPED
  local win="$1" dir m st have_run=0 have_undel=0 blockers=()
  local pid upd now grace="${MESH_BG_CRASH_GRACE:-300}"
  dir="$BG_DIR/$(printf '%s' "$win" | tr -c 'A-Za-z0-9._-' '_')"
  G_BG_DETAIL=""; G_BG_VERDICT=OK; G_BG_REAPED=""
  [ -d "$dir" ] || return
  local had=0
  for m in "$dir"/*.manifest; do
    [ -e "$m" ] || continue        # nullglob-free: the literal glob survives when dir is empty
    had=1
    st="$(grep -m1 '^status=' "$m" 2>/dev/null | cut -d= -f2-)"
    if [ "$st" = running ]; then
      pid="$(grep -m1 '^pid=' "$m" 2>/dev/null | cut -d= -f2-)"
      upd="$(grep -m1 '^updated=' "$m" 2>/dev/null | cut -d= -f2-)"
      now="$(date +%s)"
      case "$pid" in ''|*[!0-9]*) pid="" ;; esac
      case "$upd" in ''|*[!0-9]*) upd="$now" ;; esac   # unparseable updated → treat as fresh (blocks)
      if [ -n "$pid" ] && ! kill -0 "$pid" 2>/dev/null && [ $(( now - upd )) -gt "$grace" ]; then
        sed -i "s/^status=running\$/status=crashed/; s/^updated=.*/updated=$now/" "$m" 2>/dev/null
        echo "mesh-clear: REAPED crashed bg batch $(basename "$m" .manifest) [$win] — pid $pid dead, updated $(( now - upd ))s ago, never reached mesh-bg-done; its output (if any) was NOT delivered" >&2
        G_BG_REAPED="${G_BG_REAPED:+$G_BG_REAPED }$(basename "$m" .manifest)"
        st=crashed
      fi
    fi
    case "$st" in
      running)          have_run=1;   blockers+=("$(basename "$m" .manifest):running") ;;
      done-undelivered) have_undel=1; blockers+=("$(basename "$m" .manifest):done-undelivered") ;;
      delivered|done-nodeliver|crashed) : ;; # terminal-clear → nothing to strand / nothing left to deliver
      *) # unknown/empty status is UNSAFE (a half-written or corrupt manifest) → treat as blocking
         have_undel=1; blockers+=("$(basename "$m" .manifest):${st:-<empty>}") ;;
    esac
  done
  [ "$had" = 1 ] || return
  if [ "${#blockers[@]}" -gt 0 ]; then
    G_BG_DETAIL="${blockers[*]}"
    if [ "$have_undel" = 1 ]; then G_BG_VERDICT=BLOCK:bg-undelivered; else G_BG_VERDICT=BLOCK:bg-running; fi
  fi
}

_resolve_mind_pane() { # $1=window → echoes "<session>:<window>.<idx>" of the BOTTOM (mind) pane, or empty
  local win="$1" idx
  tmux has-session -t "$SESSION" 2>/dev/null || return 0
  tmux list-windows -t "$SESSION" -F '#{window_name}' 2>/dev/null | grep -qx "$win" || return 0
  # mind pane = the bottom one (largest pane_top), same convention mesh-tell uses
  idx="$(tmux list-panes -t "$SESSION:$win" -F '#{pane_top} #{pane_index}' 2>/dev/null | sort -n | tail -1 | awk '{print $2}')"
  [ -n "$idx" ] && printf '%s:%s.%s' "$SESSION" "$win" "$idx"
}

_send_clear() { # $1=paneref — inject a real /clear + submit. The irreversible step.
  local pane="$1"
  tmux send-keys -t "$pane" C-u 2>/dev/null            # wipe any half-typed composer text
  sleep 0.1
  tmux send-keys -t "$pane" -l '/clear' 2>/dev/null
  sleep 0.2
  tmux send-keys -t "$pane" C-m 2>/dev/null
}

# Write the handoff. rc from mesh-handoff --snapshot: 0=written · 4=kept a fresher MANUAL handoff ·
# 6=kept the prior handoff (pane extracted hollow — never clobber with noise) · 5=nothing to snapshot
# (pane unreachable/empty — nothing to lose). 0/4/5/6 all mean "the best available handoff is in
# place"; anything else (tool absent, crash) means the write did NOT happen → the clear would drop
# state, so it fails. Sets G_HOFF_RC + G_HOFF_NOTE.
_write_handoff() { # $1=window
  local win="$1" rc cmd
  cmd="${MESH_CLEAR_HANDOFF_CMD:-mesh-handoff --snapshot}"   # resolved HERE, not at load time
  G_HOFF_NOTE=""
  # shellcheck disable=SC2086
  $cmd "$win" >/dev/null 2>&1; rc=$?
  G_HOFF_RC="$rc"
  case "$rc" in
    0) G_HOFF_NOTE="handoff written" ;;
    4) G_HOFF_NOTE="kept fresher manual handoff" ;;
    5) G_HOFF_NOTE="no scrollback to snapshot (nothing to lose)" ;;
    6) G_HOFF_NOTE="kept prior handoff (pane extracted hollow)" ;;
    *) G_HOFF_NOTE="handoff write FAILED (rc=$rc)"; return 1 ;;
  esac
  return 0
}

_run() { # $1=window  $2=dryrun(0/1)
  local win="$1" dry="$2" pane
  _bg_scan "$win"
  if [ "$G_BG_VERDICT" != OK ]; then
    echo "mesh-clear: BLOCKED (${G_BG_VERDICT#BLOCK:}) — NOT clearing '$win'." >&2
    case "$G_BG_VERDICT" in
      BLOCK:bg-undelivered) echo "  → a detached bg-task produced output that has NOT shipped: $G_BG_DETAIL" >&2
                            echo "    Let its delivery finish, or resolve each: mesh-bg-done $win <batch>  (deliver) | mesh-bg-done --no-deliver $win <batch>  (nothing to ship)." >&2 ;;
      BLOCK:bg-running)     echo "  → a detached bg-task is still RUNNING: $G_BG_DETAIL — wait for its completion path (mesh-bg-done) before clearing." >&2 ;;
    esac
    return 1
  fi
  pane="$(_resolve_mind_pane "$win")"
  if [ "$dry" = 1 ]; then
    echo "mesh-clear: would write handoff (${MESH_CLEAR_HANDOFF_CMD:-mesh-handoff --snapshot} $win) then /clear ${pane:-<pane unresolved>}"
    return 0
  fi
  [ -n "$pane" ] || { echo "mesh-clear: cannot resolve mind pane for '$win' — refusing to /clear" >&2; return 3; }
  if ! _write_handoff "$win"; then
    echo "mesh-clear: NOT clearing '$win' — $G_HOFF_NOTE. A /clear without a handoff drops the thread." >&2
    return 1
  fi
  echo "mesh-clear: /clear → $pane ($G_HOFF_NOTE)"
  _send_clear "$pane"
  command -v mesh-clear-log >/dev/null 2>&1 && \
    mesh-clear-log --record "$win" "task-boundary ($G_HOFF_NOTE)" "?" "?" mesh-clear "?" >/dev/null 2>&1 || true
  return 0
}

_test() {
  local rc=0 td; td="$(mktemp -d)"
  export MESH_DIR="$td/m" MESH_HANDOFF_DIR="$td/m/handoff" MESH_BG_DIR="$td/m/bg"
  HANDOFF_DIR="$MESH_HANDOFF_DIR"; BG_DIR="$MESH_BG_DIR"   # top-level eval predates these exports
  mkdir -p "$HANDOFF_DIR"
  export MESH_CLEAR_SESSION="__no_such_session__"          # no live pane: nothing can actually be cleared

  # 1) NO MODEL IN THE PATH. The behavioural assertion that the gate is really gone: put a POISONED
  #    `ollama` first on PATH which records every invocation, drive the whole flow, and assert the
  #    marker never appears. A source-grep would only prove the string is absent (source text is not
  #    behaviour); this proves nothing CALLS it. Seen red against the previous version, which consulted
  #    the model on every fresh handoff.
  local stub="$td/bin"; mkdir -p "$stub"
  printf '#!/bin/sh\necho "$@" >> "%s/ollama.calls"\nexit 0\n' "$td" > "$stub/ollama"; chmod +x "$stub/ollama"
  local oldpath="$PATH"; PATH="$stub:$PATH"
  local win=gatewin f; f="$(_handoff_file "$win")"
  printf '# handoff\nbuilt X, touched scripts/foo\n' > "$f"
  MESH_CLEAR_HANDOFF_CMD='true' _run "$win" 1 >"$td/out" 2>&1
  MESH_CLEAR_HANDOFF_CMD='true' _run "$win" 0 >>"$td/out" 2>&1
  PATH="$oldpath"
  [ -f "$td/ollama.calls" ] && { echo "clear-test: FAIL (a model WAS consulted — the gate is not actually gone: $(cat "$td/ollama.calls"))"; rc=1; }

  # 2) A STALE HANDOFF NO LONGER BLOCKS — the whole behavioural change, stated as a gate. Under the old
  #    freshness arithmetic a 3-hour-old handoff was BLOCK:stale; now the clear rewrites it and proceeds.
  touch -d '3 hours ago' "$f"
  MESH_CLEAR_HANDOFF_CMD='true' _run "$win" 1 >"$td/out" 2>&1
  grep -qi 'stale' "$td/out" && { echo "clear-test: FAIL (freshness arithmetic still in the path: $(cat "$td/out"))"; rc=1; }
  grep -q 'would write handoff' "$td/out" || { echo "clear-test: FAIL (stale handoff did not proceed: $(cat "$td/out"))"; rc=1; }

  # 3) THE HANDOFF IS WRITTEN, NOT CHECKED. Drive a stub writer and assert the CLEAR PATH invoked it —
  #    a clear that skips the write is the fault the whole doctrine exists to prevent. (No live pane
  #    here, so _run stops at pane-resolution; the write must already have been attempted or not — we
  #    assert the ORDER explicitly below with a resolvable pane stub.)
  _resolve_mind_pane() { printf 'fakesess:%s.1' "$1"; }   # override: pretend the pane exists
  _send_clear() { echo "SENT_CLEAR $1" >> "$td/sent"; }   # override: never touch a real tmux
  # stub WRITERS as real scripts: HANDOFF_CMD is word-split on expansion, so an inline `sh -c '…'`
  # would shred into argv garbage — the seam takes a command NAME plus flags, not a shell snippet.
  printf '#!/bin/sh\necho written >> "%s/hoff.calls"\n' "$td" > "$stub/hoff-ok";  chmod +x "$stub/hoff-ok"
  printf '#!/bin/sh\nexit 9\n'                              > "$stub/hoff-fail"; chmod +x "$stub/hoff-fail"
  MESH_CLEAR_HANDOFF_CMD="$stub/hoff-ok" _run "$win" 0 >"$td/out" 2>&1
  [ -s "$td/hoff.calls" ] || { echo "clear-test: FAIL (handoff writer never invoked before /clear)"; rc=1; }
  grep -q SENT_CLEAR "$td/sent" 2>/dev/null || { echo "clear-test: FAIL (/clear not sent on the happy path: $(cat "$td/out"))"; rc=1; }

  # 4) A FAILED HANDOFF WRITE MUST ABORT THE CLEAR (the one non-bg failure that stops it).
  : > "$td/sent"
  MESH_CLEAR_HANDOFF_CMD="$stub/hoff-fail" _run "$win" 0 >"$td/out" 2>&1
  [ $? = 0 ] && { echo "clear-test: FAIL (handoff write failure did not abort the clear)"; rc=1; }
  grep -q SENT_CLEAR "$td/sent" 2>/dev/null && { echo "clear-test: FAIL (/clear SENT despite a failed handoff write)"; rc=1; }
  grep -q 'rc=9' "$td/out" || { echo "clear-test: FAIL (handoff failure rc not reported: $(cat "$td/out"))"; rc=1; }

  # 5) BG-DELIVERY BACKSTOP — the only remaining blocker, all states, through REAL manifests written by
  #    mesh-bg-register/-done (so a drift in that shared format goes red here).
  local reg dn bw=bgwin bf; reg="$(command -v mesh-bg-register)"; dn="$(command -v mesh-bg-done)"
  bf="$(_handoff_file "$bw")"; printf '# handoff\nbuilt Y\n' > "$bf"
  if [ -n "$reg" ] && [ -n "$dn" ]; then
    : > "$td/sent"
    MESH_CLEAR_HANDOFF_CMD='true' _run "$bw" 0 >"$td/out" 2>&1
    grep -q SENT_CLEAR "$td/sent" || { echo "clear-test: FAIL (no bg manifest: clear did not proceed: $(cat "$td/out"))"; rc=1; }
    "$reg" "$bw" b-run --target op --on-done 'true' >/dev/null
    : > "$td/sent"
    MESH_CLEAR_HANDOFF_CMD='true' _run "$bw" 0 >"$td/out" 2>&1
    grep -q 'BLOCKED (bg-running)' "$td/out" || { echo "clear-test: FAIL (running manifest did not BLOCK: $(cat "$td/out"))"; rc=1; }
    grep -q SENT_CLEAR "$td/sent" 2>/dev/null && { echo "clear-test: FAIL (/clear SENT despite a running bg batch)"; rc=1; }
    "$reg" "$bw" b-undel --target op --on-done 'true' >/dev/null
    "$dn" "$bw" b-undel --on-done-override 'exit 4' >/dev/null 2>&1   # delivery fails → done-undelivered
    MESH_CLEAR_HANDOFF_CMD='true' _run "$bw" 0 >"$td/out" 2>&1
    grep -q 'BLOCKED (bg-undelivered)' "$td/out" || { echo "clear-test: FAIL (done-undelivered did not BLOCK: $(cat "$td/out"))"; rc=1; }
    "$dn" "$bw" b-undel --on-done-override 'true' >/dev/null 2>&1     # → delivered
    "$dn" "$bw" b-run --no-deliver >/dev/null 2>&1                    # → done-nodeliver
    : > "$td/sent"
    MESH_CLEAR_HANDOFF_CMD='true' _run "$bw" 0 >"$td/out" 2>&1
    grep -q SENT_CLEAR "$td/sent" || { echo "clear-test: FAIL (terminal manifests did not PASS: $(cat "$td/out"))"; rc=1; }
    _bg_scan "$bw"; [ "$G_BG_VERDICT" = OK ] || { echo "clear-test: FAIL (--gate scan not OK on terminal window: $G_BG_VERDICT)"; rc=1; }

    # 6) CRASH-REAP — a dead-pid `running` past the grace window must reap to `crashed` (else a died
    #    batch wedges every future clear: the stale-lease trap). Inside grace, and a LIVE pid at any
    #    age, must still BLOCK.
    local deadpid crashwin=bgcrash cm
    ( : ) & deadpid=$!; wait "$deadpid" 2>/dev/null   # a real, now-certainly-dead pid
    printf '# handoff\nbuilt Z\n' > "$(_handoff_file "$crashwin")"
    "$reg" "$crashwin" b-crash --target op --on-done 'true' >/dev/null
    cm="$BG_DIR/$crashwin/b-crash.manifest"
    sed -i "s/^pid=.*/pid=$deadpid/" "$cm"
    _bg_scan "$crashwin"; [ "$G_BG_VERDICT" = BLOCK:bg-running ] || { echo "clear-test: FAIL (dead pid INSIDE grace did not BLOCK: $G_BG_VERDICT)"; rc=1; }
    sed -i "s/^updated=.*/updated=1/" "$cm"           # ancient → past any grace
    _bg_scan "$crashwin"
    [ "$G_BG_VERDICT" = OK ] || { echo "clear-test: FAIL (dead pid + stale updated did not reap→PASS: $G_BG_VERDICT)"; rc=1; }
    grep -q '^status=crashed$' "$cm" || { echo "clear-test: FAIL (reap did not persist status=crashed: $(grep '^status=' "$cm"))"; rc=1; }
    "$reg" "$crashwin" b-live --target op --on-done 'true' >/dev/null
    cm="$BG_DIR/$crashwin/b-live.manifest"
    sed -i "s/^pid=.*/pid=$$/; s/^updated=.*/updated=1/" "$cm"
    _bg_scan "$crashwin"; [ "$G_BG_VERDICT" = BLOCK:bg-running ] || { echo "clear-test: FAIL (live pid + stale updated did not BLOCK: $G_BG_VERDICT)"; rc=1; }
  else
    echo "clear-test: WARN (mesh-bg-register/-done not on PATH — bg backstop cases skipped)"
  fi
  rm -rf "$td"

  [ "$rc" = 0 ] && echo "clear-test: ok (no model consulted — poisoned-ollama marker never written; stale handoff no longer blocks; handoff WRITTEN before /clear and a failed write aborts it; bg backstop: running+undelivered BLOCK, delivered+done-nodeliver PASS, crash-reap flips dead-pid+stale→crashed while grace/live-pid still BLOCK)"
  return "$rc"
}

# ---- lib mode ----
# Another tool may `MESH_CLEAR_LIB_ONLY=1 source mesh-clear` to reuse _bg_scan WITHOUT running the main
# dispatch. (The extractive-handoff seam moved to mesh-handoff's _extract_terse when the model gate was
# removed — mesh-clear-loss sources THAT now, so there is still exactly one extractor, not two.)
[ -n "${MESH_CLEAR_LIB_ONLY:-}" ] && return 0 2>/dev/null

# ---- arg parse ----
[ "${1:-}" = --test ] && { _test; exit $?; }
# --gate <window>: run ONLY the bg-delivery backstop (no handoff write, no /clear). For sound & other
# launchers to ask "is a /clear safe for this window right now?". exit 0 = OK (no unshipped bg work),
# 1 = BLOCK (prints the reason + offending manifests).
if [ "${1:-}" = --gate ]; then
  [ -n "${2:-}" ] || { echo "usage: mesh-clear --gate <window>" >&2; exit 2; }
  _bg_scan "$2"
  if [ "$G_BG_VERDICT" = OK ]; then echo "mesh-clear --gate: OK ($2) — no running/undelivered bg-task${G_BG_REAPED:+ (reaped crashed: $G_BG_REAPED)}"; exit 0; fi
  echo "mesh-clear --gate: ${G_BG_VERDICT#BLOCK:} ($2) — ${G_BG_DETAIL}" >&2; exit 1
fi
WIN=""; DRY=0
for a in "$@"; do
  case "$a" in
    --dry-run) DRY=1 ;;
    -h|--help) sed -n '2,12p' "$0"; exit 0 ;;
    -*) echo "mesh-clear: unknown flag $a" >&2; exit 2 ;;
    *) [ -z "$WIN" ] && WIN="$a" ;;
  esac
done
[ -n "$WIN" ] || { echo "usage: mesh-clear <window> [--dry-run] | --gate <window>" >&2; exit 2; }
_run "$WIN" "$DRY"
