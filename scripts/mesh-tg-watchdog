#!/usr/bin/env bash
# mesh-tg-watchdog — alert the OPERATOR if default-string's Telegram organ drops (e.g. a reboot
# wiped the scoped VPN routing). $0, no substrate change — pure monitoring + notify. Runs on a node
# that CAN reach Telegram (steward), checks default-string, and classifies the organ's DEPARTURE on
# two independent axes instead of one binary edge (see the two-knob / four-cell note below).
set -uo pipefail
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes"
export PATH="$HOME/.local/bin:$PATH"

# TWO AXES, NOT ONE (docs/reviews/deleuze-guattari-twin-axes-four-types-deterritorialization-tg-watchdog-2026-08-24.md).
# This watchdog used to read ONE axis — the tg=up/DOWN value — and fire only on its up->DOWN edge.
# Everything else was `exit 0`. That collapsed two independent questions onto one:
#   REACH  — is the probe LINE to default-string present at all?   (the assemblage's own boundary)
#   VALUE  — what did the organ report while the line was present?  (what the boundary encloses)
# With one axis, an unreachable host renders as silence, which reads exactly like "still up"; and a
# `prev` with no timestamp is a fossil, so an up->DOWN edge straddling a week of blindness is
# announced as a fresh transition. Both axes now carry their own value, their own `since`, and their
# own alerted-marker, and every cell of the 2x2 has a NAMED verdict — including the ones that used to
# be silent. A departure is classified by WHERE IT LANDED (recaptured / prevailing / off the axis
# entirely), never by the edge alone.
STATEF="${TG_WATCHDOG_STATE:-$HOME/.mesh/.dsTG-state}"
STALE_S="${TG_WATCHDOG_STALE_S:-1800}"          # a `prev` older than this is a fossil, not a state
UNREACH_S="${TG_WATCHDOG_UNREACH_ALERT_S:-3600}" # line lost this long => the tg axis is UNKNOWN, loudly

# Resolve the default-string node this watchdog monitors. The old default was ${TG_WATCHDOG_HOST:-}
# = EMPTY when unset → ssh with no host → empty probe → silent exit-0 EVERY run = HOLLOW (cron-wired,
# smoke-passing, never actually probing — would miss a real TG outage). Now: env override wins, else
# resolve via the registry (mesh-peer-addr), else a last-resort known addr. Never empty.
resolve_ds_host() {
  if [ -n "${TG_WATCHDOG_HOST:-}" ]; then printf '%s' "$TG_WATCHDOG_HOST"; return 0; fi
  local user="${TG_WATCHDOG_USER:-imozerov}" addr
  addr=$(mesh-peer-addr default-string 2>/dev/null || mesh-peer-addr imozerov-Default-string 2>/dev/null || true)
  if [ -n "$addr" ]; then printf '%s@%s' "$user" "$addr"; return 0; fi
  printf '%s' "${TG_WATCHDOG_FALLBACK:-imozerov@100.125.157.75}"   # last-resort known addr
}

human_age() { # seconds -> compact age; empty/non-numeric -> "unknown"
  case "${1:-}" in ''|*[!0-9]*) printf 'unknown'; return 0;; esac
  if   [ "$1" -lt 120 ]   ; then printf '%ss' "$1"
  elif [ "$1" -lt 7200 ]  ; then printf '%dm' $(( $1 / 60 ))
  else                          printf '%dh' $(( $1 / 3600 )); fi
}

# ---- state I/O (key=value lines; the LEGACY single line `tg=up` parses as the tg key, so an old
# state file is read without a migration step — it simply has no timestamps, i.e. age unknown).
PREV_TG= PREV_OBS= PREV_SINCE= PREV_ALERTED=
PREV_REACH= REACH_OBS= REACH_SINCE= REACH_ALERTED=
read_state() {
  [ -f "$STATEF" ] || return 0
  local k v
  while IFS='=' read -r k v; do
    case "$k" in
      tg)             PREV_TG="$v" ;;
      tg_observed)    PREV_OBS="$v" ;;
      tg_since)       PREV_SINCE="$v" ;;
      tg_alerted)     PREV_ALERTED="$v" ;;
      reach)          PREV_REACH="$v" ;;
      reach_observed) REACH_OBS="$v" ;;
      reach_since)    REACH_SINCE="$v" ;;
      reach_alerted)  REACH_ALERTED="$v" ;;
    esac
  done < "$STATEF"
}
write_state() {
  printf 'tg=%s\ntg_observed=%s\ntg_since=%s\ntg_alerted=%s\nreach=%s\nreach_observed=%s\nreach_since=%s\nreach_alerted=%s\n' \
    "$NEW_TG" "$NEW_OBS" "$NEW_SINCE" "$NEW_ALERTED" \
    "$NEW_REACH" "$NOW" "$NEW_REACH_SINCE" "$NEW_REACH_ALERTED" > "$STATEF"
}

# ---- the decision. Pure function of the globals above + PROBE + NOW; sets VERDICT/DETAIL/NEW_*.
# Called identically by the live path and by --test, so the gate drives the REAL classifier.
VERDICT= DETAIL= NEW_TG= NEW_OBS= NEW_SINCE= NEW_ALERTED= NEW_REACH= NEW_REACH_SINCE= NEW_REACH_ALERTED=
decide() {
  local age= down_for= lost_for=
  NEW_OBS="$NOW"
  NEW_TG="$PREV_TG" NEW_SINCE="$PREV_SINCE" NEW_ALERTED="$PREV_ALERTED"
  NEW_REACH="$PREV_REACH" NEW_REACH_SINCE="$REACH_SINCE" NEW_REACH_ALERTED="$REACH_ALERTED"

  if [ -z "$PROBE" ]; then
    # --- REACH axis lost. The probe LINE itself left; the tg value is UNKNOWN, never "still up".
    NEW_REACH=lost
    [ "$PREV_REACH" = lost ] && [ -n "$REACH_SINCE" ] || NEW_REACH_SINCE="$NOW"
    NEW_OBS="$PREV_OBS"     # we observed the LINE, not the organ — do not refresh the tg timestamp
    lost_for=$(( NOW - NEW_REACH_SINCE ))
    if [ "$lost_for" -ge "$UNREACH_S" ] && [ -z "$REACH_ALERTED" ]; then
      NEW_REACH_ALERTED="$NOW"; VERDICT=line-lost-absolute
      DETAIL="default-string unreachable for $(human_age "$lost_for") — the tg axis is UNKNOWN, not up (last known: ${PREV_TG:-none}, seen $(human_age "$( [ -n "$PREV_OBS" ] && echo $(( NOW - PREV_OBS )) )") ago)"
    else
      VERDICT=line-lost
      DETAIL="unreachable $(human_age "$lost_for") (bound $(human_age "$UNREACH_S"))"
    fi
    return 0
  fi

  # --- REACH axis present.
  NEW_REACH=ok
  if [ "$PREV_REACH" = lost ]; then
    NEW_REACH_SINCE="$NOW"; lost_for=$(( NOW - ${REACH_SINCE:-$NOW} ))
    if [ -n "$REACH_ALERTED" ]; then VERDICT=line-returned; DETAIL="probe line back after $(human_age "$lost_for")"; fi
    NEW_REACH_ALERTED=
  fi

  NEW_TG="${PROBE#tg=}"
  [ -n "$PREV_OBS" ] && age=$(( NOW - PREV_OBS ))
  [ "$NEW_TG" = "$PREV_TG" ] || NEW_SINCE="$NOW"
  [ -n "$NEW_SINCE" ] || NEW_SINCE="$NOW"

  if [ "$NEW_TG" = DOWN ] && [ "$PREV_TG" = up ]; then
    NEW_ALERTED="$NOW"
    if [ -z "$age" ] || [ "$age" -gt "$STALE_S" ]; then
      VERDICT=departed-blind
      DETAIL="tg=DOWN, but the last up reading is $(human_age "$age") old (bound $(human_age "$STALE_S")) — this edge straddles a blind window, the drop may be far older than now"
    else
      VERDICT=departed-fresh
      DETAIL="tg=DOWN — up as recently as $(human_age "$age") ago"
    fi
  elif [ "$NEW_TG" = up ] && [ "$PREV_TG" = DOWN ]; then
    down_for=$(( NOW - ${PREV_SINCE:-$NOW} ))
    if [ -n "$PREV_ALERTED" ]; then
      VERDICT=reterritorialized; DETAIL="tg back up after $(human_age "$down_for") down — the earlier DOWN alert is discharged"
    else
      VERDICT=recovered-unalerted; DETAIL="tg back up after $(human_age "$down_for") down (no alert had been sent)"
    fi
    NEW_ALERTED=
  elif [ "$NEW_TG" = DOWN ]; then
    VERDICT=still-down; DETAIL="tg=DOWN for $(human_age "$(( NOW - NEW_SINCE ))") — already alerted"
  else
    [ -n "$VERDICT" ] || VERDICT=held
    [ -n "$DETAIL" ]  || DETAIL="tg=up"
  fi
  return 0
}

# ---------------------------------------------------------------- test
if [ "${1:-}" = --test ]; then
  fail() { echo "smoke-test: FAIL ($1)"; exit 1; }
  for c in ssh grep head; do command -v "$c" >/dev/null 2>&1 || fail "no $c"; done
  mkdir -p "$HOME/.mesh" 2>/dev/null || fail "~/.mesh not writable"
  : > "$HOME/.mesh/.tg-watchdog-test" 2>/dev/null || fail "~/.mesh not writable"
  rm -f "$HOME/.mesh/.tg-watchdog-test"
  # the dead-but-green guard: the monitored host MUST resolve to a non-empty user@addr, else the
  # probe is hollow (the 2026-06-12 regression). Verify resolution + shape.
  h="$(resolve_ds_host)"
  [ -n "$h" ] || fail "default-string host did not resolve — probe would be hollow"
  case "$h" in *@*) : ;; *) fail "resolved host '$h' is not user@addr — ssh would be malformed";; esac

  # drive the REAL classifier over every cell of the 2x2. Each case names the verdict it must
  # produce; the cells that used to be silent (line-lost*, reterritorialized, departed-blind) are
  # the point of the gate — if the classifier regresses to one axis they collapse onto held/silence.
  NOW=1000000
  case_() { # <want-verdict> <probe> <prev_tg> <prev_obs_ago|-> <prev_since_ago|-> <prev_alerted> <prev_reach> <reach_since_ago|-> <reach_alerted>
    local want="$1"; PROBE="$2"; PREV_TG="$3"
    PREV_OBS=$( [ "$4" = - ] || echo $(( NOW - $4 )) ); PREV_SINCE=$( [ "$5" = - ] || echo $(( NOW - $5 )) )
    PREV_ALERTED="$6"; PREV_REACH="$7"; REACH_SINCE=$( [ "$8" = - ] || echo $(( NOW - $8 )) ); REACH_ALERTED="$9"
    VERDICT= DETAIL=; decide
    [ "$VERDICT" = "$want" ] || fail "cell '$want' classified as '$VERDICT' ($DETAIL)"
  }
  case_ held               "tg=up"   up   60    600   ""  ok   -    ""
  case_ departed-fresh     "tg=DOWN" up   60    600   ""  ok   -    ""
  case_ departed-blind     "tg=DOWN" up   99999 99999 ""  ok   -    ""
  case_ departed-blind     "tg=DOWN" up   -     -     ""  ok   -    ""    # legacy state: no timestamps
  case_ still-down         "tg=DOWN" DOWN 60    600   "1" ok   -    ""
  case_ reterritorialized  "tg=up"   DOWN 60    600   "1" ok   -    ""
  case_ recovered-unalerted "tg=up"  DOWN 60    600   ""  ok   -    ""
  case_ line-lost          ""        up   60    600   ""  ok   -    ""
  case_ line-lost-absolute ""        up   60    600   ""  lost 99999 ""
  case_ line-lost          ""        up   60    600   ""  lost 99999 "1"  # already alerted: no re-fire
  case_ line-returned      "tg=up"   up   60    600   ""  lost 99999 "1"
  # the unreachable cell must NEVER refresh the tg observation timestamp — else the fossil `prev`
  # is laundered into a fresh reading and departed-blind can never fire again.
  PROBE="" PREV_TG=up PREV_OBS=$(( NOW - 99999 )) PREV_SINCE= PREV_ALERTED= PREV_REACH=lost REACH_SINCE=$(( NOW - 10 )) REACH_ALERTED=
  decide; [ "$NEW_OBS" = "$(( NOW - 99999 ))" ] || fail "unreachable run laundered the tg timestamp ($NEW_OBS)"
  # state round-trip, including the legacy single-line form
  t=$(mktemp); STATEF="$t"
  printf 'tg=up\n' > "$t"; PREV_TG= PREV_OBS= PREV_SINCE= PREV_REACH=; read_state
  [ "$PREV_TG" = up ] && [ -z "$PREV_OBS" ] || { rm -f "$t"; fail "legacy state file did not parse as tg with unknown age"; }
  NEW_TG=DOWN NEW_OBS=1 NEW_SINCE=2 NEW_ALERTED=3 NEW_REACH=ok NEW_REACH_SINCE=4 NEW_REACH_ALERTED= NOW=5; write_state
  PREV_TG= PREV_OBS= PREV_SINCE= PREV_ALERTED= PREV_REACH= REACH_SINCE= REACH_ALERTED=; read_state
  [ "$PREV_TG$PREV_OBS$PREV_SINCE$PREV_ALERTED$PREV_REACH$REACH_SINCE" = "DOWN123ok4" ] || { rm -f "$t"; fail "state round-trip lost a field ($PREV_TG/$PREV_OBS/$PREV_SINCE/$PREV_ALERTED/$PREV_REACH/$REACH_SINCE)"; }
  rm -f "$t"
  echo "smoke-test: ok"; exit 0
fi

# ---------------------------------------------------------------- live
mkdir -p "$HOME/.mesh"
DS_HOST="$(resolve_ds_host)"
[ -n "$DS_HOST" ] || { echo "$(date -u +%FT%TZ) mesh-tg-watchdog: cannot resolve default-string addr — skip" >&2; exit 0; }
NOW=$(date +%s)
read_state
# absolute path: non-interactive ssh PATH may lack ~/.local/bin. head -1: single match.
PROBE=$(timeout 20 ssh -o BatchMode=yes -o ConnectTimeout=8 "$DS_HOST" '~/.local/bin/mesh-conn --oneline 2>/dev/null | grep -o "tg=[A-Za-z]*" | head -1' 2>/dev/null)
decide
write_state
echo "$(date -u +%FT%TZ) mesh-tg-watchdog: $VERDICT — $DETAIL"

SELF_FIX="Or self-fix: ssh $DS_HOST -t 'sudo bash ~/.mesh/tg-vpn.sh apply && sudo bash ~/.mesh/tg-vpn.sh confirm'"
case "$VERDICT" in
  departed-fresh|departed-blind)
    command -v mesh-tg >/dev/null 2>&1 && mesh-tg "⚠ default-string: Telegram organ is DOWN — $DETAIL. Likely a reboot dropped the scoped VPN routing. Reply 'fix it' and I'll repair it now (I have the rights). $SELF_FIX" ;;
  line-lost-absolute)
    command -v mesh-tg >/dev/null 2>&1 && mesh-tg "⚠ default-string: $DETAIL. The TG watchdog cannot see the organ at all — this is the WATCHDOG's own blindness, not a tg=up reading. $SELF_FIX" ;;
  reterritorialized|line-returned)
    command -v mesh-tg >/dev/null 2>&1 && mesh-tg "✓ default-string: $DETAIL" ;;
esac
exit 0
