#!/usr/bin/env bash
# mesh-tg-watchdog — alert the OPERATOR if default-string's Telegram organ drops (e.g. a reboot
# wiped the scoped VPN routing). $0, no substrate change — pure monitoring + notify. Runs on a node
# that CAN reach Telegram (steward), checks default-string, alerts on up->DOWN transition only.
set -uo pipefail
[ "${1:-}" = --test ] && { command -v ssh >/dev/null 2>&1 || { echo "smoke-test: FAIL (no ssh)"; exit 1; }; echo "smoke-test: ok"; exit 0; }
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes"
export PATH="$HOME/.local/bin:$PATH"
STATEF="$HOME/.mesh/.dsTG-state"
mkdir -p "$HOME/.mesh"   # (independent-review fix) ensure state dir exists
now=$(timeout 20 ssh -o BatchMode=yes -o ConnectTimeout=8 ${TG_WATCHDOG_HOST:-} 'mesh-conn --oneline 2>/dev/null | grep -o "tg=[A-Za-z]*" | head -1' 2>/dev/null)   # (review fix) head -1: single match only
[ -n "$now" ] || exit 0   # couldn't check — don't false-alert
prev=$(cat "$STATEF" 2>/dev/null || echo)
echo "$now" > "$STATEF"
if [ "$now" = "tg=DOWN" ] && [ "$prev" = "tg=up" ]; then
  command -v mesh-tg >/dev/null 2>&1 && mesh-tg "⚠ default-string: Telegram отвалился (tg=DOWN) — вероятно reboot слетел VPN-роутинг. Скажи 'перелечи' — я сразу починю (есть права). Или сам: ssh ${TG_WATCHDOG_HOST:-} -t 'sudo bash ~/.mesh/tg-vpn.sh apply && sudo bash ~/.mesh/tg-vpn.sh confirm'"
fi
