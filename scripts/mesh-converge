#!/usr/bin/env bash
# mesh-converge — MEASURE board convergence across nodes: the anti-entropy digest + the
#   "inconsistent window" metric the eventual-consistency field uses to measure itself.
#
# LITERATURE (live review 2026-07-13: distributed-systems coordination — gossip/CRDTs/eventual
#   consistency, angle = a concrete METRIC the field uses to measure itself). Dynamo-style stores
#   (Amazon DynamoDB, Apache Cassandra, Riak) reconcile replicas by MERKLE-TREE ANTI-ENTROPY:
#   two nodes exchange a small ROOT HASH of their data; equal ⇒ replicas are identical, decided in
#   O(1) with one hash on the wire; mismatch ⇒ descend the hash tree to find and ship ONLY the
#   divergent blocks — bandwidth O(log n), not O(n). The health of the system is measured by the
#   "INCONSISTENT WINDOW": how divergent the replicas are and for how long (refs: DynamoDB/Cassandra
#   anti-entropy repair; delta-state CRDTs, Almeida/Shapiro et al. arXiv:1603.01529).
#
# WHY IT'S A GAP WE DIDN'T EMBODY: mesh-chat-sync already gossips the board as a G-Set CRDT (union/
#   sort/dedup — convergent by construction) and mesh-phi already gives phi-accrual failure
#   detection. But chat-sync ships each peer's ENTIRE chat.log every round (O(n), blind) and NEVER
#   computes a digest — so it cannot (a) skip a peer that is already converged, nor (b) MEASURE
#   whether the fleet has actually converged or which node is behind. Divergence today is noticed
#   only when a stuck strand starts SPAMMING (the phaedra genome-strand DIVERGED case, 2026-07-12),
#   not by a clean metric. mesh-converge adds the missing measurement: a Merkle-style ROOT digest
#   of the local board (G-Set → LC_ALL=C sort -u | sha256) and, against a peer, the exact
#   INCONSISTENT WINDOW = |symmetric difference| of the two boards (root-compare first; descend to
#   the exact diff only on mismatch — the real protocol).
#
# Usage:
#   mesh-converge                 print the local board digest (count + Merkle root)
#   mesh-converge --digest [file] same, over an explicit board file
#   mesh-converge --peer u@ip     root-compare local vs peer; on mismatch, exact inconsistent window
#   mesh-converge --window A B     inconsistent window between two board files (hermetic core)
#   mesh-converge --test          smoke test (hermetic: digest identity + window counts)
#
# Honest-exit contract:
#   0 = a measurement was produced (digest, or a converged/diverged verdict)
#   2 = N/A — no board to read, or the peer is unreachable (never a faked "converged")
#   1 = FAIL — a real fault (unreadable-but-present input)
# orphan-ok: on-demand convergence-measurement instrument (chat-review/steward lane) — not scheduled.
set -euo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

BOARD="${MESH_CHAT_LOG:-$HOME/.mesh/chat.log}"
REMOTE_BOARD="${MESH_CONVERGE_REMOTE_BOARD:-.mesh/chat.log}"  # path on the peer (relative to its $HOME)

# G-Set digest of a board file: the Merkle root = sha256 over the sorted-unique line set.
# Two nodes are converged iff (count, root) are equal — the O(1) anti-entropy check.
board_count() { LC_ALL=C sort -u "$1" 2>/dev/null | grep -c . ; }
board_root()  { LC_ALL=C sort -u "$1" 2>/dev/null | sha256sum | cut -c1-12 ; }

# inconsistent window between two board files: echoes "<a_only> <b_only>" = lines A has that B
# lacks, and lines B has that A lacks. |A△B| = a_only + b_only; 0 ⇒ converged. comm (set-diff on
# sorted input), NOT grep -Ff — the pattern-file automaton OOMs on a big board ([[grep-Ff-pattern-file-oom]]).
window() {
  local a="$1" b="$2" a_only b_only
  a_only=$(comm -23 <(LC_ALL=C sort -u "$a") <(LC_ALL=C sort -u "$b") | grep -c . || true)
  b_only=$(comm -13 <(LC_ALL=C sort -u "$a") <(LC_ALL=C sort -u "$b") | grep -c . || true)
  printf '%s %s\n' "$a_only" "$b_only"
}

digest_line() {  # <file>
  printf 'count=%s root=%s\n' "$(board_count "$1")" "$(board_root "$1")"
}

case "${1:-}" in
  --test)
    fail=""
    t=$(mktemp -d)
    { echo "l1"; echo "l2"; echo "l3"; } > "$t/A"
    cp "$t/A" "$t/B"                                  # identical
    { echo "l1"; echo "l2"; echo "l3"; echo "l4"; echo "l5"; } > "$t/C"  # C = A + 2 lines
    # (1) identical boards → equal root, window 0 0 (converged)
    [ "$(board_root "$t/A")" = "$(board_root "$t/B")" ] || fail="$fail identical-root-differ"
    [ "$(window "$t/A" "$t/B")" = "0 0" ] || fail="$fail identical-window-nonzero"
    # (2) divergent boards → roots differ; exact window counts (A lacks 2 that C has; A has 0 C lacks)
    [ "$(board_root "$t/A")" != "$(board_root "$t/C")" ] || fail="$fail divergent-root-equal"
    [ "$(window "$t/A" "$t/C")" = "0 2" ] || fail="$fail window-AC-wrong:[$(window "$t/A" "$t/C")]"
    [ "$(window "$t/C" "$t/A")" = "2 0" ] || fail="$fail window-CA-wrong:[$(window "$t/C" "$t/A")]"
    # (3) dedup: duplicate lines don't inflate the set (G-Set idempotent union)
    { echo "l1"; echo "l1"; echo "l2"; echo "l3"; } > "$t/D"
    [ "$(board_root "$t/D")" = "$(board_root "$t/A")" ] || fail="$fail dedup-root-differ"
    # (4) honest-n/a: absent board exits 2, never a faked converged
    set +e; MESH_CHAT_LOG="$t/nope" "$0" --digest "$t/nope" >/dev/null 2>&1; na_rc=$?; set -e
    [ "$na_rc" = 2 ] || fail="$fail absent-board-not-na:[$na_rc]"
    rm -rf "$t"
    if [ -n "$fail" ]; then echo "test: FAIL ($fail )"; exit 1; fi
    echo "test: ok (Merkle root identity + inconsistent-window counts + G-Set dedup + absent=n/a)"
    ;;
  --window)
    A="${2:-}"; B="${3:-}"
    [ -r "$A" ] && [ -r "$B" ] || { echo "mesh-converge: n/a (a board file is unreadable)" >&2; exit 2; }
    read -r a_only b_only <<<"$(window "$A" "$B")"
    conv=CONVERGED; [ "$((a_only + b_only))" -gt 0 ] && conv=DIVERGED
    printf '%s window=%s (A-only=%s B-only=%s)\n' "$conv" "$((a_only + b_only))" "$a_only" "$b_only"
    ;;
  --digest)
    f="${2:-$BOARD}"
    [ -r "$f" ] || { echo "mesh-converge: n/a (board $f unreadable)" >&2; exit 2; }
    digest_line "$f"
    ;;
  --peer)
    peer="${2:-}"
    [ -n "$peer" ] || { echo "usage: mesh-converge --peer user@ip" >&2; exit 2; }
    [ -r "$BOARD" ] || { echo "mesh-converge: n/a (local board $BOARD unreadable)" >&2; exit 2; }
    # ROOT-COMPARE FIRST (the O(1) anti-entropy step): ship only one hash.
    remote_root=$(ssh -o ConnectTimeout=5 -o BatchMode=yes "$peer" \
      "LC_ALL=C sort -u \"\$HOME/$REMOTE_BOARD\" 2>/dev/null | sha256sum | cut -c1-12" 2>/dev/null) \
      || { echo "mesh-converge: n/a (peer $peer unreachable)" >&2; exit 2; }
    remote_root=${remote_root%% *}
    [ -n "$remote_root" ] || { echo "mesh-converge: n/a (peer $peer has no board)" >&2; exit 2; }
    local_root=$(board_root "$BOARD")
    if [ "$remote_root" = "$local_root" ]; then
      printf 'CONVERGED with %s (root=%s, window=0) — O(1) root match, no diff shipped\n' "$peer" "$local_root"
      exit 0
    fi
    # DESCEND on mismatch: fetch the peer board and compute the exact inconsistent window.
    tmp=$(mktemp)
    ssh -o ConnectTimeout=5 -o BatchMode=yes "$peer" "cat \"\$HOME/$REMOTE_BOARD\"" > "$tmp" 2>/dev/null \
      || { rm -f "$tmp"; echo "mesh-converge: n/a (peer $peer board fetch failed)" >&2; exit 2; }
    read -r a_only b_only <<<"$(window "$BOARD" "$tmp")"
    rm -f "$tmp"
    printf 'DIVERGED from %s: window=%s (local-only=%s, %s-only=%s) — local root=%s peer root=%s\n' \
      "$peer" "$((a_only + b_only))" "$a_only" "$peer" "$b_only" "$local_root" "$remote_root"
    printf 'repair: local is missing %s line(s) the peer has (chat-sync union will pull them)\n' "$b_only"
    ;;
  "")
    [ -r "$BOARD" ] || { echo "mesh-converge: n/a (board $BOARD unreadable)" >&2; exit 2; }
    digest_line "$BOARD"
    ;;
  *)
    echo "usage: mesh-converge [--digest [file] | --peer user@ip | --window A B | --test]" >&2
    exit 2
    ;;
esac
