#!/usr/bin/env bash
# mesh-ss-connections — list/classify Shadowsocks tunnel connections on phaedra
# Shows who's using the SS tunnel, identifies known vs unknown IPs,
# and alerts on breach connections (e.g. the Vimpelcom 3rd party).
# reflex-cadence: 13-59/15 * * * *
# reflex-args: --edge
#
#   mesh-ss-connections              human-readable connection table
#   mesh-ss-connections --json       JSON output
#   mesh-ss-connections --edge       state-tracked, fires on new/unknown connections
#   mesh-ss-connections --test       smoke test

set -euo pipefail
SSH_CMD="ssh -o StrictHostKeyChecking=no -o ConnectTimeout=10"
PHAEDRA="phaedra"
SS_PORT=443
ALT_PORTS="80"
STATE_FILE="${HOME}/.mesh/.ss-connections.state"
KNOWN_IPS="${HOME}/.mesh/ss-known-ips.txt"

# Known/authorized SS users and their labels.
# Format: IP SPACE LABEL per line.
# Also read from ~/.mesh/ss-known-ips.txt if it exists (overlays built-in list).
# CORRECTION 2026-06-18: do NOT add IPs without geo-verification.
known_ips() {
  cat <<'EOF'
194.147.115.17 operator-home-wifi
EOF
  [ -f "$KNOWN_IPS" ] && cat "$KNOWN_IPS" 2>/dev/null || true
}

# Known breach IPs (geo-verified) — labeled for clarity in output.
known_breach_ips() {
  cat <<'EOF'
95.26.150.184 Vimpelcom-RU-leech
54.145.201.186 AWS-Ashburn-leech
66.132.172.128 Vimpelcom-leech
148.222.205.182 SpaceX-CL-leech
167.233.17.122 Hetzner-DE-leech
108.170.28.178 Phoenix-Hosting-US-leech
69.5.169.193 Hydra-DE-leech
3.87.27.156 AWS-Ashburn-leech2
3.129.187.38 AWS-Ohio-leech
EOF
  [ -f "$KNOWN_IPS" ] && cat "$KNOWN_IPS" 2>/dev/null || true
}

check_deps() {
  local f=0
  command -v ssh >/dev/null 2>&1 || { echo "FAIL: ssh missing"; f=1; }
  [ "$f" = 0 ] || exit 1
}

fetch_connections() {
  $SSH_CMD "$PHAEDRA" "ss -tnp 2>/dev/null | grep 'ss-server' | grep ESTAB || true" 2>/dev/null
}

parse_conn() {
  local line="$1"
  local src_ip dst_ip
  # Extract local and peer addresses from ss output
  # Format: LOCAL:PORT PEER:PORT ...
  src_ip=$(echo "$line" | awk '{print $4}' | cut -d: -f1)
  dst_ip=$(echo "$line" | awk '{print $5}' | cut -d: -f1)
  [ -z "$src_ip" ] || [ -z "$dst_ip" ] && PARSE_ERROR=1 && return
  echo "$src_ip $dst_ip"
}

classify_ip() {
  local ip="$1"
  local known breach
  known=$(known_ips 2>/dev/null || cat "$KNOWN_IPS" 2>/dev/null || true)
  breach=$(known_breach_ips 2>/dev/null)
  if echo "$known" | grep -q "^${ip}\b"; then
    echo "KNOWN $(echo "$known" | grep "^${ip}\b" | head -1 | awk '{print $2}')"
  elif echo "$breach" | grep -q "^${ip}\b"; then
    echo "BREACH $(echo "$breach" | grep "^${ip}\b" | head -1 | awk '{print $2}')"
  else
    echo "UNKNOWN unknown"
  fi
}

do_test() {
  local TESTS_FAILED=0
  test_ok() { echo "  ok: $1"; }
  test_fail() { TESTS_FAILED=$((TESTS_FAILED + 1)); echo "  FAIL: $1"; }
  command -v ssh >/dev/null 2>&1 || test_fail "ssh not installed"
  command -v awk >/dev/null 2>&1 || test_fail "awk not installed"
  command -v grep >/dev/null 2>&1 || test_fail "grep not installed"
  command -v sort >/dev/null 2>&1 || test_fail "sort not installed"
  command -v cut >/dev/null 2>&1 || test_fail "cut not installed"
  command -v tr >/dev/null 2>&1 || test_fail "tr not installed"
  command -v wc >/dev/null 2>&1 || test_fail "wc not installed"
  [ "$TESTS_FAILED" -eq 0 ] || exit 1

  env -i PATH=/tmp/empty HOME="$HOME" /bin/sh -c 'command -v ssh >/dev/null 2>&1' >/dev/null 2>&1 \
    && test_fail "missing-ssh negative control unexpectedly passed"

  local td old_path sample parsed src_ip dst_ip local_port is_client COUNT UNIQUE_COUNT KNOWN_COUNT PASSENGER_COUNT BREACH_COUNT BREACH_UNIQUE conn_label conn_category
  td="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
  mkdir -p "$td/bin" "$td/home/.mesh" || { rm -rf "$td"; echo "smoke-test: FAIL (tmp setup)"; exit 1; }
  cat >"$td/bin/ssh" <<'EOF'
#!/bin/sh
case " $* " in
  *" echo ok "*) exit 0 ;;
  *" ss -tnp "*) cat <<'OUT'
ESTAB 0 0 10.0.0.1:443 194.147.115.17:53122 users:(("ss-server",pid=1,fd=3))
ESTAB 0 0 10.0.0.1:443 95.26.150.184:53123 users:(("ss-server",pid=1,fd=4))
ESTAB 0 0 10.0.0.1:23456 1.1.1.1:443 users:(("ss-server",pid=1,fd=5))
OUT
    exit 0 ;;
esac
exit 0
EOF
  chmod +x "$td/bin/ssh" || { rm -rf "$td"; echo "smoke-test: FAIL (stub ssh chmod)"; exit 1; }
  old_path="$PATH"
  PATH="$td/bin:$PATH"

  sample="$(fetch_connections)" || { rm -rf "$td"; PATH="$old_path"; echo "smoke-test: FAIL (stubbed fetch_connections errored)"; exit 1; }
  [ "$(printf '%s\n' "$sample" | grep -c '^ESTAB ')" -eq 3 ] || test_fail "stubbed fetch_connections emitted wrong shape"
  parsed="$(parse_conn "$(printf '%s\n' "$sample" | sed -n '1p')")" || test_fail "parse_conn rejected incoming line"
  src_ip="$(printf '%s' "$parsed" | awk '{print $1}')"
  dst_ip="$(printf '%s' "$parsed" | awk '{print $2}')"
  [ "$src_ip" = "10.0.0.1" ] || test_fail "parse_conn source drifted: $src_ip"
  [ "$dst_ip" = "194.147.115.17" ] || test_fail "parse_conn peer drifted: $dst_ip"
  [ "$(classify_ip 194.147.115.17)" = "KNOWN operator-home-wifi" ] || test_fail "known IP classification drifted"
  [ "$(classify_ip 95.26.150.184)" = "BREACH Vimpelcom-RU-leech" ] || test_fail "breach IP classification drifted"

  COUNT=0
  UNIQUE_COUNT=0
  KNOWN_COUNT=0
  PASSENGER_COUNT=0
  BREACH_COUNT=0
  BREACH_UNIQUE=0
  declare -A SEEN_UNIQUE=()
  declare -A SEEN_BREACH=()
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    COUNT=$((COUNT + 1))

    parsed="$(parse_conn "$line")"
    src_ip="$(printf '%s' "$parsed" | awk '{print $1}')"
    dst_ip="$(printf '%s' "$parsed" | awk '{print $2}')"
    [ -z "$src_ip" ] || [ -z "$dst_ip" ] && continue

    local_port="$(printf '%s' "$line" | awk '{print $4}' | cut -d: -f2)"
    is_client=0
    if [ "$local_port" = "$SS_PORT" ]; then
      is_client=1
    else
      for ap in $ALT_PORTS; do
        [ "$local_port" = "$ap" ] && is_client=1 && break
      done
    fi

    if [ "$is_client" = 1 ]; then
      CLIENT_IP="$dst_ip"
      [ "$CLIENT_IP" = "127.0.0.1" ] && continue
      if [ -z "${SEEN_UNIQUE[$CLIENT_IP]:-}" ]; then
        SEEN_UNIQUE[$CLIENT_IP]=1
        UNIQUE_COUNT=$((UNIQUE_COUNT + 1))
      fi

      conn_label="$(classify_ip "$CLIENT_IP")"
      conn_category="$(printf '%s' "$conn_label" | awk '{print $1}')"
      if [ "$conn_category" = "KNOWN" ]; then
        KNOWN_COUNT=$((KNOWN_COUNT + 1))
      else
        BREACH_COUNT=$((BREACH_COUNT + 1))
        if [ -z "${SEEN_BREACH[$CLIENT_IP]:-}" ]; then
          SEEN_BREACH[$CLIENT_IP]=1
          BREACH_UNIQUE=$((BREACH_UNIQUE + 1))
        fi
      fi
    else
      PASSENGER_COUNT=$((PASSENGER_COUNT + 1))
    fi
  done <<< "$sample"

  [ "$COUNT" -eq 3 ] || test_fail "unexpected stubbed connection count: $COUNT"
  [ "$UNIQUE_COUNT" -eq 2 ] || test_fail "unexpected unique client count: $UNIQUE_COUNT"
  [ "$KNOWN_COUNT" -eq 1 ] || test_fail "unexpected known client count: $KNOWN_COUNT"
  [ "$BREACH_COUNT" -eq 1 ] || test_fail "unexpected breach client count: $BREACH_COUNT"
  [ "$BREACH_UNIQUE" -eq 1 ] || test_fail "unexpected breach unique count: $BREACH_UNIQUE"
  [ "$PASSENGER_COUNT" -eq 1 ] || test_fail "unexpected proxy count: $PASSENGER_COUNT"
  PATH="$old_path"
  rm -rf "$td"
  [ $TESTS_FAILED -gt 0 ] && { echo "smoke-test: FAIL"; exit 1; }
  echo "smoke-test: ok (ssh negative control + stubbed ss parser/classifier verified)"
  exit 0
}

JSON=0; EDGE=0
while [ $# -gt 0 ]; do
  case "$1" in
    --test) do_test;;
    --json) JSON=1; shift;;
    --edge) EDGE=1; shift;;
    *) echo "usage: $0 [--json] [--edge] [--test]"; exit 1;;
  esac
done

check_deps

# Fetch connections
CONNS=$(fetch_connections) || {
  echo "mesh-ss-connections: FAIL — cannot reach phaedra or ss-server" >&2; exit 2
}

if [ -z "$CONNS" ]; then
  # No active connections
  [ "$JSON" = 1 ] && echo '{"connections":[],"total":0,"unique_ips":0,"status":"idle"}'
  [ "$JSON" = 0 ] && echo "mesh-ss-connections: no active SS connections"
  exit 0
fi

COUNT=0
declare -A SEEN_UNIQUE
UNIQUE_COUNT=0
RESULT_LINES=""
BREACH_IPS=""
BREACH_COUNT=0
BREACH_UNIQUE=0
declare -A SEEN_BREACH
KNOWN_COUNT=0
PASSENGER_COUNT=0

while IFS= read -r line; do
  [ -z "$line" ] && continue
  COUNT=$((COUNT + 1))

  parsed=$(parse_conn "$line")
  src_ip=$(echo "$parsed" | awk '{print $1}')
  dst_ip=$(echo "$parsed" | awk '{print $2}')
  [ -z "$src_ip" ] || [ -z "$dst_ip" ] && continue

  # Count unique client IPs (the source of the SS client connection — dst_ip is the exit target)
  # In `ss -tnp`, the ss-server proxy connections look like:
  #  ESTAB <SERVER>:443 <CLIENT>:PORT  (incoming from SS client)
  #  ESTAB <SERVER>:RANDOM <TARGET>:443  (outgoing to destination)
  # We classify: if the LOCAL port is SS_PORT or an alt port → it's an incoming client connection
  
  local_port=$(echo "$line" | awk '{print $4}' | cut -d: -f2)
  
  is_client=0
  if [ "$local_port" = "$SS_PORT" ]; then
    is_client=1
  else
    for ap in $ALT_PORTS; do
      [ "$local_port" = "$ap" ] && is_client=1 && break
    done
  fi
  
  if [ "$is_client" = 1 ]; then
    # This is an incoming SS client connection
    # For incoming: LOCAL=SRV:443, PEER=CLIENT:PORT → client IP is dst_ip!
    CLIENT_IP="$dst_ip"
    # Skip 127.0.0.1 — SS health check/self-test, not a breach
    [ "$CLIENT_IP" = "127.0.0.1" ] && continue
    if [ -z "${SEEN_UNIQUE[$CLIENT_IP]:-}" ]; then
      SEEN_UNIQUE[$CLIENT_IP]=1
      UNIQUE_COUNT=$((UNIQUE_COUNT + 1))
    fi
    
    classify_result=$(classify_ip "$CLIENT_IP")
    label=$(echo "$classify_result" | awk '{print $2}')
    category=$(echo "$classify_result" | awk '{print $1}')
    if [ "$category" = "KNOWN" ]; then
      KNOWN_COUNT=$((KNOWN_COUNT + 1))
    else
      BREACH_IPS="${BREACH_IPS}${CLIENT_IP} "
      BREACH_COUNT=$((BREACH_COUNT + 1))
      if [ -z "${SEEN_BREACH[$CLIENT_IP]:-}" ]; then
        SEEN_BREACH[$CLIENT_IP]=1
        BREACH_UNIQUE=$((BREACH_UNIQUE + 1))
      fi
    fi
    
    if [ "$JSON" = 1 ]; then
      RESULT_LINES="${RESULT_LINES}{\"client\":\"$CLIENT_IP\",\"label\":\"$label\",\"port\":\"$local_port\",\"type\":\"client\"},"
    fi
  else
    # Outgoing proxy connection (ss-server reaching a destination)
    PASSENGER_COUNT=$((PASSENGER_COUNT + 1))
    if [ "$JSON" = 1 ]; then
      RESULT_LINES="${RESULT_LINES}{\"src\":\"$src_ip\",\"dst\":\"$dst_ip\",\"type\":\"proxy\"},"
    fi
  fi
done <<< "$CONNS"

RESULT_LINES="${RESULT_LINES%,}"

if [ "$EDGE" = 1 ]; then
  # State tracking — fire only on state change
  PREV=""
  [ -f "$STATE_FILE" ] && PREV=$(cat "$STATE_FILE" 2>/dev/null) || true
  
  # Compute state hash: all known client IPs + breach IPs sorted
  KNOWN_SORTED=$(known_ips 2>/dev/null | grep -oP '^\S+' | sort | tr '\n' ' ')
  KNOWN_SORTED="${KNOWN_SORTED%% }"
  BREACH_SORTED=$(echo "$BREACH_IPS" | tr ' ' '\n' | sort | tr '\n' ' ')
  BREACH_SORTED="${BREACH_SORTED%% }"
  STATE="unique=${UNIQUE_COUNT}:breach=${BREACH_SORTED}:known=${KNOWN_SORTED}"
  
  if [ -n "$PREV" ] && [ "$PREV" = "$STATE" ]; then
    # No change — silent
    exit 0
  fi
  
  # State changed — save and report
  printf '%s' "$STATE" > "$STATE_FILE"
  
  if [ "$BREACH_COUNT" -gt 0 ]; then
    echo "[ss-connections] ${COUNT} active, ${UNIQUE_COUNT} unique: BREACH — ${BREACH_COUNT} unauthorized connection(s) from ${BREACH_UNIQUE} IP(s)"
  else
    echo "[ss-connections] ${COUNT} active, ${UNIQUE_COUNT} unique: 0 known — key breached"
  fi
  [ "${KNOWN_COUNT}" = "0" ] && echo "[ss-connections] WARNING: 0 known IPs connected — ALL traffic is unauthorized"
elif [ "$JSON" = 1 ]; then
  cat <<JSONEOF
{
  "connections": [${RESULT_LINES}],
  "total": ${COUNT},
  "proxy": ${PASSENGER_COUNT},
  "unique_clients": ${UNIQUE_COUNT},
  "breach_count": ${BREACH_COUNT},
  "known_clients": ${KNOWN_COUNT},
  "breach_ips": "${BREACH_IPS%% }",
  "status": "active",
  "note": "key breached — all active client IPs are unauthorized"
}
JSONEOF
else
  echo "mesh-ss-connections :: active SS connections on phaedra:${SS_PORT}"
  echo "Total: ${COUNT} | Clients: ${UNIQUE_COUNT} unique | Proxy flows: ${PASSENGER_COUNT}"
  if [ "$BREACH_COUNT" -gt 0 ]; then
    echo "⚠ BREACH: ${BREACH_COUNT} unknown client IP(s): ${BREACH_IPS}"
  fi
  echo "---"
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    parsed=$(parse_conn "$line")
    src_ip=$(echo "$parsed" | awk '{print $1}')
    dst_ip=$(echo "$parsed" | awk '{print $2}')
    local_port=$(echo "$line" | awk '{print $4}' | cut -d: -f2)
    [ -z "$src_ip" ] && continue
    if [ "$local_port" = "$SS_PORT" ] || [ "$local_port" = "80" ] || [ "$local_port" = "443" ]; then
      CLIENT_IP="$dst_ip"
      classify_result=$(classify_ip "$CLIENT_IP")
      label=$(echo "$classify_result" | awk '{print $2}')
      echo "  CLIENT ${CLIENT_IP}:${local_port} → ${src_ip} [${label}]"
    else
      echo "  PROXY  ${src_ip} → ${dst_ip}:${local_port}"
    fi
  done <<< "$CONNS"
fi

[ "$BREACH_COUNT" -gt 0 ] && exit 1
exit 0
