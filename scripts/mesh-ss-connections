#!/usr/bin/env bash
# mesh-ss-connections — list/classify Shadowsocks tunnel connections on phaedra
# Shows who's using the SS tunnel, identifies known vs unknown IPs,
# and alerts on breach connections (e.g. the Vimpelcom 3rd party).
# reflex-cadence: 13-59/15 * * * *
# reflex-args: --edge
#
#   mesh-ss-connections              human-readable connection table
#   mesh-ss-connections --json       JSON output
#   mesh-ss-connections --edge       state-tracked, fires on new/unknown connections
#   mesh-ss-connections --test       smoke test

set -euo pipefail
SSH_CMD="ssh -o StrictHostKeyChecking=no -o ConnectTimeout=10"
PHAEDRA="phaedra"
SS_PORT=443
ALT_PORTS="80"
STATE_FILE="${HOME}/.mesh/.ss-connections.state"
UNREACH_MARK="${HOME}/.mesh/.ss-connections.unreach"
KNOWN_IPS="${HOME}/.mesh/ss-known-ips.txt"

# Known/authorized SS users and their labels.
# Format: IP SPACE LABEL per line.
# Also read from ~/.mesh/ss-known-ips.txt if it exists (overlays built-in list).
# CORRECTION 2026-06-18: do NOT add IPs without geo-verification.
known_ips() {
  cat <<'EOF'
194.147.115.17 operator-home-wifi
EOF
  [ -f "$KNOWN_IPS" ] && cat "$KNOWN_IPS" 2>/dev/null || true
}

# Known breach IPs (geo-verified) — labeled for clarity in output.
known_breach_ips() {
  cat <<'EOF'
95.26.150.184 Vimpelcom-RU-leech
54.145.201.186 AWS-Ashburn-leech
66.132.172.128 Vimpelcom-leech
148.222.205.182 SpaceX-CL-leech
167.233.17.122 Hetzner-DE-leech
108.170.28.178 Phoenix-Hosting-US-leech
69.5.169.193 Hydra-DE-leech
3.87.27.156 AWS-Ashburn-leech2
3.129.187.38 AWS-Ohio-leech
EOF
  [ -f "$KNOWN_IPS" ] && cat "$KNOWN_IPS" 2>/dev/null || true
}

check_deps() {
  local f=0
  command -v ssh >/dev/null 2>&1 || { echo "FAIL: ssh missing"; f=1; }
  [ "$f" = 0 ] || exit 1
}

fetch_connections() {
  # retried once: the probe rides mesh-home's sole uplink, which deauths every ~14min —
  # a single-attempt ssh turned each flap window into a FAIL line (~25% of the artifact
  # by 2026-07-17, same family as the vpn-health cert false alarm, 744773d)
  local _try
  for _try in 1 2; do
    if $SSH_CMD "$PHAEDRA" "ss -tnp 2>/dev/null | grep 'ss-server' | grep ESTAB || true" 2>/dev/null; then
      return 0
    fi
    [ "$_try" = 1 ] && sleep 5
  done
  return 1
}

parse_conn() {
  local line="$1"
  local src_ip dst_ip
  # Extract local and peer addresses from ss output
  # Format: LOCAL:PORT PEER:PORT ...
  src_ip=$(echo "$line" | awk '{print $4}' | cut -d: -f1)
  dst_ip=$(echo "$line" | awk '{print $5}' | cut -d: -f1)
  [ -z "$src_ip" ] || [ -z "$dst_ip" ] && PARSE_ERROR=1 && return
  echo "$src_ip $dst_ip"
}

classify_ip() {
  local ip="$1"
  local known breach
  known=$(known_ips 2>/dev/null || cat "$KNOWN_IPS" 2>/dev/null || true)
  breach=$(known_breach_ips 2>/dev/null)
  if echo "$known" | grep -q "^${ip}\b"; then
    echo "KNOWN $(echo "$known" | grep "^${ip}\b" | head -1 | awk '{print $2}')"
  elif echo "$breach" | grep -q "^${ip}\b"; then
    echo "BREACH $(echo "$breach" | grep "^${ip}\b" | head -1 | awk '{print $2}')"
  else
    echo "UNKNOWN unknown"
  fi
}

do_test() {
  local TESTS_FAILED=0
  test_ok() { echo "  ok: $1"; }
  test_fail() { TESTS_FAILED=$((TESTS_FAILED + 1)); echo "  FAIL: $1"; }
  command -v ssh >/dev/null 2>&1 || test_fail "ssh not installed"
  command -v awk >/dev/null 2>&1 || test_fail "awk not installed"
  command -v grep >/dev/null 2>&1 || test_fail "grep not installed"
  command -v sort >/dev/null 2>&1 || test_fail "sort not installed"
  command -v cut >/dev/null 2>&1 || test_fail "cut not installed"
  command -v tr >/dev/null 2>&1 || test_fail "tr not installed"
  command -v wc >/dev/null 2>&1 || test_fail "wc not installed"
  [ "$TESTS_FAILED" -eq 0 ] || exit 1

  env -i PATH=/tmp/empty HOME="$HOME" /bin/sh -c 'command -v ssh >/dev/null 2>&1' >/dev/null 2>&1 \
    && test_fail "missing-ssh negative control unexpectedly passed"

  local td old_path sample parsed src_ip dst_ip local_port is_client COUNT UNIQUE_COUNT KNOWN_COUNT PASSENGER_COUNT BREACH_COUNT BREACH_UNIQUE UNKNOWN_COUNT UNKNOWN_UNIQUE conn_label conn_category live_rc live_out breach_line summary_line edge1 edge2
  td="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
  mkdir -p "$td/bin" "$td/home/.mesh" || { rm -rf "$td"; echo "smoke-test: FAIL (tmp setup)"; exit 1; }
  cat >"$td/bin/ssh" <<'EOF'
#!/bin/sh
case " $* " in
  *" echo ok "*) exit 0 ;;
  *" ss -tnp "*) cat <<'OUT'
ESTAB 0 0 10.0.0.1:443 194.147.115.17:53122 users:(("ss-server",pid=1,fd=3))
ESTAB 0 0 10.0.0.1:443 95.26.150.184:53123 users:(("ss-server",pid=1,fd=4))
ESTAB 0 0 10.0.0.1:443 95.26.150.184:53124 users:(("ss-server",pid=1,fd=7))
ESTAB 0 0 10.0.0.1:443 95.26.152.234:53125 users:(("ss-server",pid=1,fd=6))
ESTAB 0 0 10.0.0.1:443 95.26.152.234:53126 users:(("ss-server",pid=1,fd=8))
ESTAB 0 0 10.0.0.1:23456 1.1.1.1:443 users:(("ss-server",pid=1,fd=5))
OUT
    exit 0 ;;
esac
exit 0
EOF
  chmod +x "$td/bin/ssh" || { rm -rf "$td"; echo "smoke-test: FAIL (stub ssh chmod)"; exit 1; }
  old_path="$PATH"
  PATH="$td/bin:$PATH"

  sample="$(fetch_connections)" || { rm -rf "$td"; PATH="$old_path"; echo "smoke-test: FAIL (stubbed fetch_connections errored)"; exit 1; }
  [ "$(printf '%s\n' "$sample" | grep -c '^ESTAB ')" -eq 6 ] || test_fail "stubbed fetch_connections emitted wrong shape"
  parsed="$(parse_conn "$(printf '%s\n' "$sample" | sed -n '1p')")" || test_fail "parse_conn rejected incoming line"
  src_ip="$(printf '%s' "$parsed" | awk '{print $1}')"
  dst_ip="$(printf '%s' "$parsed" | awk '{print $2}')"
  [ "$src_ip" = "10.0.0.1" ] || test_fail "parse_conn source drifted: $src_ip"
  [ "$dst_ip" = "194.147.115.17" ] || test_fail "parse_conn peer drifted: $dst_ip"
  [ "$(classify_ip 194.147.115.17)" = "KNOWN operator-home-wifi" ] || test_fail "known IP classification drifted"
  [ "$(classify_ip 95.26.150.184)" = "BREACH Vimpelcom-RU-leech" ] || test_fail "breach IP classification drifted"
  [ "$(classify_ip 95.26.152.234)" = "UNKNOWN unknown" ] || test_fail "never-seen IP should classify UNKNOWN not BREACH"

  COUNT=0
  UNIQUE_COUNT=0
  KNOWN_COUNT=0
  PASSENGER_COUNT=0
  BREACH_COUNT=0
  BREACH_UNIQUE=0
  UNKNOWN_COUNT=0
  UNKNOWN_UNIQUE=0
  declare -A SEEN_UNIQUE=()
  declare -A SEEN_BREACH=()
  declare -A SEEN_UNKNOWN=()
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    COUNT=$((COUNT + 1))

    parsed="$(parse_conn "$line")"
    src_ip="$(printf '%s' "$parsed" | awk '{print $1}')"
    dst_ip="$(printf '%s' "$parsed" | awk '{print $2}')"
    [ -z "$src_ip" ] || [ -z "$dst_ip" ] && continue

    local_port="$(printf '%s' "$line" | awk '{print $4}' | cut -d: -f2)"
    is_client=0
    if [ "$local_port" = "$SS_PORT" ]; then
      is_client=1
    else
      for ap in $ALT_PORTS; do
        [ "$local_port" = "$ap" ] && is_client=1 && break
      done
    fi

    if [ "$is_client" = 1 ]; then
      CLIENT_IP="$dst_ip"
      [ "$CLIENT_IP" = "127.0.0.1" ] && continue
      if [ -z "${SEEN_UNIQUE[$CLIENT_IP]:-}" ]; then
        SEEN_UNIQUE[$CLIENT_IP]=1
        UNIQUE_COUNT=$((UNIQUE_COUNT + 1))
      fi

      conn_label="$(classify_ip "$CLIENT_IP")"
      conn_category="$(printf '%s' "$conn_label" | awk '{print $1}')"
      if [ "$conn_category" = "KNOWN" ]; then
        KNOWN_COUNT=$((KNOWN_COUNT + 1))
      elif [ "$conn_category" = "BREACH" ]; then
        BREACH_COUNT=$((BREACH_COUNT + 1))
        if [ -z "${SEEN_BREACH[$CLIENT_IP]:-}" ]; then
          SEEN_BREACH[$CLIENT_IP]=1
          BREACH_UNIQUE=$((BREACH_UNIQUE + 1))
        fi
      else
        UNKNOWN_COUNT=$((UNKNOWN_COUNT + 1))
        if [ -z "${SEEN_UNKNOWN[$CLIENT_IP]:-}" ]; then
          SEEN_UNKNOWN[$CLIENT_IP]=1
          UNKNOWN_UNIQUE=$((UNKNOWN_UNIQUE + 1))
        fi
      fi
    else
      PASSENGER_COUNT=$((PASSENGER_COUNT + 1))
    fi
  done <<< "$sample"

  [ "$COUNT" -eq 6 ] || test_fail "unexpected stubbed connection count: $COUNT"
  [ "$UNIQUE_COUNT" -eq 3 ] || test_fail "unexpected unique client count: $UNIQUE_COUNT"
  [ "$KNOWN_COUNT" -eq 1 ] || test_fail "unexpected known client count: $KNOWN_COUNT"
  [ "$BREACH_COUNT" -eq 2 ] || test_fail "unexpected breach client count: $BREACH_COUNT"
  [ "$BREACH_UNIQUE" -eq 1 ] || test_fail "unexpected breach unique count: $BREACH_UNIQUE"
  # A never-seen (rotated legit) IP must land in UNKNOWN, NOT inflate BREACH.
  [ "$UNKNOWN_COUNT" -eq 2 ] || test_fail "never-seen IP not counted UNKNOWN: $UNKNOWN_COUNT"
  [ "$UNKNOWN_UNIQUE" -eq 1 ] || test_fail "unexpected unknown unique count: $UNKNOWN_UNIQUE"
  [ "$PASSENGER_COUNT" -eq 1 ] || test_fail "unexpected proxy count: $PASSENGER_COUNT"

  # LIVE-PATH gate (2026-07-16): the loop above is a COPY of the main loop — it
  # asserts nothing about what the script itself prints or state-hashes. Drive
  # the real script ($0) end-to-end under the ssh stub with a sandboxed HOME
  # (STATE_FILE/KNOWN_IPS both derive from HOME). The stub carries each of the
  # breach IP and the unknown IP on TWO connections: every printed IP list must
  # carry them ONCE. Then the phantom-escalate contract: an --edge re-run whose
  # ONLY change is the conn-count of an already-seen IP must stay SILENT —
  # per-connection entries in the state hash fired a board POST per count
  # fluctuation on a healthy, unchanged IP set.
  live_rc=0
  live_out="$(HOME="$td/home" bash "$0" 2>/dev/null)" || live_rc=$?
  # breach is DATA, not a fetch failure: exit 0 even with a geo-verified breach
  # (the breach is in the printed ⚠ line). exit 1-on-breach made mesh-ss-clients:92
  # `--json || exit 2` discard every breach harvest as "unreachable" (267428).
  [ "$live_rc" -eq 0 ] || test_fail "live re-exec must exit 0 on good data (breach is data), got rc=$live_rc"
  breach_line="$(printf '%s\n' "$live_out" | grep 'BREACH' || true)"
  [ "$(printf '%s' "$breach_line" | grep -o '95\.26\.150\.184' | wc -l)" -eq 1 ] \
    || test_fail "breach IP not listed exactly once in summary: $breach_line"
  summary_line="$(printf '%s\n' "$live_out" | grep 'unrecognized client IP' || true)"
  [ "$(printf '%s' "$summary_line" | grep -o '95\.26\.152\.234' | wc -l)" -eq 1 ] \
    || test_fail "unknown IP not listed exactly once in summary: $summary_line"
  # --json CONTRACT gate (267428): mesh-ss-clients:92 calls `mesh-ss-connections
  # --json || exit 2`. A breach harvest MUST exit 0 AND emit valid JSON carrying
  # the breach — else the consumer treats a live breach as "phaedra unreachable"
  # and freezes the dash cache on the last good read. This is the exact path that
  # burned 9h; the plain-mode rc gate above does not cover it.
  json_rc=0
  json_out="$(HOME="$td/home" bash "$0" --json 2>/dev/null)" || json_rc=$?
  [ "$json_rc" -eq 0 ] || test_fail "--json must exit 0 on good data w/ breach, got rc=$json_rc"
  printf '%s' "$json_out" | grep -q '"breach_count":[[:space:]]*[1-9]' \
    || test_fail "--json must carry breach_count>0 in output, got: $json_out"
  printf '%s' "$json_out" | grep -q '95\.26\.150\.184' \
    || test_fail "--json breach_ips must list the geo-verified breach IP, got: $json_out"
  edge1="$(HOME="$td/home" bash "$0" --edge 2>/dev/null)" || true
  [ -n "$edge1" ] || test_fail "--edge first run must fire (fresh state)"
  mkdir -p "$td/bin2" || test_fail "bin2 setup"
  sed 's|^ESTAB 0 0 10.0.0.1:443 95.26.152.234:53126.*|&\nESTAB 0 0 10.0.0.1:443 95.26.152.234:53127 users:(("ss-server",pid=1,fd=9))|' \
    "$td/bin/ssh" > "$td/bin2/ssh" && chmod +x "$td/bin2/ssh" || test_fail "bin2 stub"
  edge2="$(HOME="$td/home" PATH="$td/bin2:$PATH" bash "$0" --edge 2>/dev/null)" || true
  [ -z "$edge2" ] || test_fail "--edge re-run with only a conn-count change must stay silent, got: $edge2"
  # recovery edge: after a FAIL (unreach mark set), the next successful --edge
  # run logs recovery exactly once — else a pane tailing the log shows the last
  # FAIL forever while healthy runs pass silently
  touch "$td/home/.mesh/.ss-connections.unreach" || test_fail "unreach mark seed"
  edge3="$(HOME="$td/home" PATH="$td/bin2:$PATH" bash "$0" --edge 2>/dev/null)" || true
  printf '%s' "$edge3" | grep -q 'recovered' || test_fail "--edge after unreach mark must log recovery, got: '$edge3'"
  edge4="$(HOME="$td/home" PATH="$td/bin2:$PATH" bash "$0" --edge 2>/dev/null)" || true
  [ -z "$edge4" ] || test_fail "--edge run after recovery must be silent again, got: '$edge4'"

  # --- attribution arms: an ssh miss must NAME THE LAYER, and only the arms that PROVE our own
  #     path may name phaedra. Driven with a failing ssh + a stubbed prover, one arm at a time.
  #     Hand-driving these once is not a gate: without this block the four messages can collapse
  #     back to one blame string and every suite stays green.
  mkdir -p "$td/bin3" || test_fail "bin3 setup"
  printf '#!/bin/sh\nexit 255\n' > "$td/bin3/ssh"; chmod +x "$td/bin3/ssh"
  _arm() { # <tsp-line|ABSENT> <grep-must-match> <grep-must-NOT-match> <label>
    if [ "$1" = ABSENT ]; then rm -f "$td/bin3/mesh-vpn-health"
    else printf '#!/bin/sh\necho "%s"\n' "$1" > "$td/bin3/mesh-vpn-health"; chmod +x "$td/bin3/mesh-vpn-health"; fi
    # HERMETIC PATH, not "$td/bin3:$PATH": with the real ~/.local/bin still behind the stub dir the
    # ABSENT arm was not absent at all, and the DEPLOYED mesh-vpn-health answered it — an old build
    # swallows the unknown --peer-transport flag and falls through to its full check, so the arm
    # measured whatever was on disk instead of the code under test.
    local out; out="$(HOME="$td/home" PATH="$td/bin3:/usr/bin:/bin" bash "$0" --edge 2>&1 >/dev/null)" || true
    printf '%s' "$out" | grep -q "$2" || { test_fail "$4: expected /$2/, got: $out"; return; }
    if [ -n "$3" ] && printf '%s' "$out" | grep -q "$3"; then test_fail "$4: must NOT match /$3/, got: $out"; return; fi
    test_ok "$4"
  }
  _arm "tsp=up|proven" "ssh/ss-server read failed" "" \
       "transport proven + ssh dead names the SSH LAYER, not the peer"
  _arm "tsp=down(control=Redmi 10)|silent but control answered" "phaedra unreachable" "" \
       "peer silent with our path proven still names phaedra (no true-positive regression)"
  _arm "tsp=unknown|our own path is unproven" "NOT a claim about phaedra" "phaedra unreachable" \
       "unproven transport is a NO READING, never a verdict about phaedra"
  _arm ABSENT "layer unattributed" "phaedra unreachable" \
       "prover absent is loud and unattributed, never a quiet blame"

  PATH="$old_path"
  rm -rf "$td"
  [ $TESTS_FAILED -gt 0 ] && { echo "smoke-test: FAIL"; exit 1; }
  echo "smoke-test: ok (ssh negative control + stubbed ss parser/classifier verified)"
  exit 0
}

JSON=0; EDGE=0
while [ $# -gt 0 ]; do
  case "$1" in
    --test) do_test;;
    --json) JSON=1; shift;;
    --edge) EDGE=1; shift;;
    *) echo "usage: $0 [--json] [--edge] [--test]"; exit 1;;
  esac
done

check_deps

# Fetch connections. In --edge mode both edges get logged: FAIL marks
# unreachable; the next successful edge run emits ONE recovery line and clears
# the mark — without it a pane tailing the log shows the last FAIL forever,
# because --edge's no-change path writes nothing (both-edges-need-the-same-gate,
# 2026-07-17). Scoped to --edge so interactive/--json runs neither set nor
# consume the cron lane's edge state.
CONNS=$(fetch_connections) || {
  [ "$EDGE" = 1 ] && { touch "$UNREACH_MARK" 2>/dev/null || true; }
  # THE SSH MISS DOES NOT NAME THE LAYER. This used to print one string —
  # "cannot reach phaedra or ss-server" — for every failure, i.e. it named the PEER for a fault
  # that on this node is usually OUR OWN: the sole uplink is a wedging RTL8822BU dongle, and the
  # FAIL rate here was 29% of the artifact (183 FAIL / 622 lines, 2026-08-22) while phaedra's two
  # sibling legs (vpn-health --edge, ss-test --edge) were PASSing minutes either side and a
  # 12x hand-probe went 12/12 at ~1.4s. A retry was added 2026-07-17 against the same symptom
  # ("~25% of the artifact") and did not move it, because a retry cannot fix an attribution.
  # Same bug class as the vpn-health blind branch fixed 2026-08-20; that tool's prover is now
  # callable as `--peer-transport`, so this asks it instead of carrying a second copy.
  # Three outcomes, because two cannot express "we could not tell" — and only the arms that
  # PROVE our path may name phaedra.
  _tsp=""
  command -v mesh-vpn-health >/dev/null 2>&1 && \
    _tsp="$(timeout 40 mesh-vpn-health --peer-transport "$PHAEDRA" 2>/dev/null)"
  case "$_tsp" in
    tsp=up*)
      # transport proven AND phaedra's tailscaled answered → the ssh/ss-server layer is the fault.
      echo "mesh-ss-connections: FAIL — phaedra reachable at the tailscale layer but the ssh/ss-server read failed (${_tsp#*|})" >&2 ;;
    tsp=down*)
      # our path proven by a control peer, phaedra silent → naming phaedra, with MORE evidence.
      echo "mesh-ss-connections: FAIL — phaedra unreachable (${_tsp#*|})" >&2 ;;
    tsp=unknown*)
      # nothing on the tailnet answered → this node's own uplink is the suspect. NEVER name phaedra.
      echo "mesh-ss-connections: FAIL — NO READING, layer unattributed: our own tailscale path is unproven, so this is NOT a claim about phaedra (${_tsp#*|})" >&2 ;;
    *)
      # prover absent/unavailable — loud about which claim we could not make, never a quiet blame.
      echo "mesh-ss-connections: FAIL — ssh to phaedra failed and the transport could not be probed (mesh-vpn-health --peer-transport unavailable): layer unattributed" >&2 ;;
  esac
  exit 2
}
if [ "$EDGE" = 1 ] && [ -f "$UNREACH_MARK" ]; then
  rm -f "$UNREACH_MARK"
  echo "[ss-connections] recovered — phaedra reachable again"
fi

if [ -z "$CONNS" ]; then
  # No active connections
  [ "$JSON" = 1 ] && echo '{"connections":[],"total":0,"unique_ips":0,"status":"idle"}'
  [ "$JSON" = 0 ] && echo "mesh-ss-connections: no active SS connections"
  exit 0
fi

COUNT=0
declare -A SEEN_UNIQUE
UNIQUE_COUNT=0
RESULT_LINES=""
BREACH_IPS=""
BREACH_COUNT=0
BREACH_UNIQUE=0
declare -A SEEN_BREACH
UNKNOWN_IPS=""
UNKNOWN_COUNT=0
UNKNOWN_UNIQUE=0
declare -A SEEN_UNKNOWN
KNOWN_COUNT=0
PASSENGER_COUNT=0

while IFS= read -r line; do
  [ -z "$line" ] && continue
  COUNT=$((COUNT + 1))

  parsed=$(parse_conn "$line")
  src_ip=$(echo "$parsed" | awk '{print $1}')
  dst_ip=$(echo "$parsed" | awk '{print $2}')
  [ -z "$src_ip" ] || [ -z "$dst_ip" ] && continue

  # Count unique client IPs (the source of the SS client connection — dst_ip is the exit target)
  # In `ss -tnp`, the ss-server proxy connections look like:
  #  ESTAB <SERVER>:443 <CLIENT>:PORT  (incoming from SS client)
  #  ESTAB <SERVER>:RANDOM <TARGET>:443  (outgoing to destination)
  # We classify: if the LOCAL port is SS_PORT or an alt port → it's an incoming client connection
  
  local_port=$(echo "$line" | awk '{print $4}' | cut -d: -f2)
  
  is_client=0
  if [ "$local_port" = "$SS_PORT" ]; then
    is_client=1
  else
    for ap in $ALT_PORTS; do
      [ "$local_port" = "$ap" ] && is_client=1 && break
    done
  fi
  
  if [ "$is_client" = 1 ]; then
    # This is an incoming SS client connection
    # For incoming: LOCAL=SRV:443, PEER=CLIENT:PORT → client IP is dst_ip!
    CLIENT_IP="$dst_ip"
    # Skip 127.0.0.1 — SS health check/self-test, not a breach
    [ "$CLIENT_IP" = "127.0.0.1" ] && continue
    if [ -z "${SEEN_UNIQUE[$CLIENT_IP]:-}" ]; then
      SEEN_UNIQUE[$CLIENT_IP]=1
      UNIQUE_COUNT=$((UNIQUE_COUNT + 1))
    fi
    
    classify_result=$(classify_ip "$CLIENT_IP")
    label=$(echo "$classify_result" | awk '{print $2}')
    category=$(echo "$classify_result" | awk '{print $1}')
    if [ "$category" = "KNOWN" ]; then
      KNOWN_COUNT=$((KNOWN_COUNT + 1))
    elif [ "$category" = "BREACH" ]; then
      # Geo-verified known-bad IP (known_breach_ips list) — real breach, alarming.
      BREACH_COUNT=$((BREACH_COUNT + 1))
      if [ -z "${SEEN_BREACH[$CLIENT_IP]:-}" ]; then
        SEEN_BREACH[$CLIENT_IP]=1
        BREACH_UNIQUE=$((BREACH_UNIQUE + 1))
        # one entry per IP: this list feeds the --edge state hash, which must
        # encode the IP SET — a per-connection entry makes every conn-count
        # fluctuation read as "IP-set changed" (phantom escalate POSTs)
        BREACH_IPS="${BREACH_IPS}${CLIENT_IP} "
      fi
    else
      # Never-seen IP (neither known nor geo-verified breach) — could be a
      # rotated legit client (DHCP) or a leech. Informational, NOT alarming.
      UNKNOWN_COUNT=$((UNKNOWN_COUNT + 1))
      if [ -z "${SEEN_UNKNOWN[$CLIENT_IP]:-}" ]; then
        SEEN_UNKNOWN[$CLIENT_IP]=1
        UNKNOWN_UNIQUE=$((UNKNOWN_UNIQUE + 1))
        # one entry per IP — same state-hash contract as BREACH_IPS above
        UNKNOWN_IPS="${UNKNOWN_IPS}${CLIENT_IP} "
      fi
    fi
    
    if [ "$JSON" = 1 ]; then
      RESULT_LINES="${RESULT_LINES}{\"client\":\"$CLIENT_IP\",\"label\":\"$label\",\"port\":\"$local_port\",\"type\":\"client\"},"
    fi
  else
    # Outgoing proxy connection (ss-server reaching a destination)
    PASSENGER_COUNT=$((PASSENGER_COUNT + 1))
    if [ "$JSON" = 1 ]; then
      RESULT_LINES="${RESULT_LINES}{\"src\":\"$src_ip\",\"dst\":\"$dst_ip\",\"type\":\"proxy\"},"
    fi
  fi
done <<< "$CONNS"

RESULT_LINES="${RESULT_LINES%,}"

if [ "$EDGE" = 1 ]; then
  # State tracking — fire only on state change
  PREV=""
  [ -f "$STATE_FILE" ] && PREV=$(cat "$STATE_FILE" 2>/dev/null) || true
  
  # Compute state hash: all known client IPs + breach IPs + unknown IPs sorted
  KNOWN_SORTED=$(known_ips 2>/dev/null | grep -oP '^\S+' | sort | tr '\n' ' ')
  KNOWN_SORTED="${KNOWN_SORTED%% }"
  BREACH_SORTED=$(echo "$BREACH_IPS" | tr ' ' '\n' | sort | tr '\n' ' ')
  BREACH_SORTED="${BREACH_SORTED%% }"
  UNKNOWN_SORTED=$(echo "$UNKNOWN_IPS" | tr ' ' '\n' | sort | tr '\n' ' ')
  UNKNOWN_SORTED="${UNKNOWN_SORTED%% }"
  STATE="unique=${UNIQUE_COUNT}:breach=${BREACH_SORTED}:unknown=${UNKNOWN_SORTED}:known=${KNOWN_SORTED}"

  if [ -n "$PREV" ] && [ "$PREV" = "$STATE" ]; then
    # No change — silent
    exit 0
  fi

  # State changed — save and report
  printf '%s' "$STATE" > "$STATE_FILE"

  # Only geo-verified breach IPs get the alarming BREACH wording + exit 1.
  # Never-seen (UNKNOWN) IPs get a neutral, non-alarming line and exit 0.
  if [ "$BREACH_COUNT" -gt 0 ]; then
    echo "[ss-connections] ${COUNT} active, ${UNIQUE_COUNT} unique: BREACH — ${BREACH_COUNT} geo-verified unauthorized connection(s) from ${BREACH_UNIQUE} IP(s)"
  elif [ "$UNKNOWN_COUNT" -gt 0 ]; then
    echo "[ss-connections] ${UNKNOWN_UNIQUE} unrecognized client IP(s), not geo-verified breach (${UNKNOWN_IPS%% })"
  fi
elif [ "$JSON" = 1 ]; then
  cat <<JSONEOF
{
  "connections": [${RESULT_LINES}],
  "total": ${COUNT},
  "proxy": ${PASSENGER_COUNT},
  "unique_clients": ${UNIQUE_COUNT},
  "breach_count": ${BREACH_COUNT},
  "unknown_count": ${UNKNOWN_COUNT},
  "known_clients": ${KNOWN_COUNT},
  "breach_ips": "${BREACH_IPS%% }",
  "unknown_ips": "${UNKNOWN_IPS%% }",
  "status": "active",
  "note": "breach_count = geo-verified known-bad IPs (alarming); unknown_count = never-seen IPs (informational, may be rotated legit clients)"
}
JSONEOF
else
  echo "mesh-ss-connections :: active SS connections on phaedra:${SS_PORT}"
  echo "Total: ${COUNT} | Clients: ${UNIQUE_COUNT} unique | Proxy flows: ${PASSENGER_COUNT}"
  if [ "$BREACH_COUNT" -gt 0 ]; then
    echo "⚠ BREACH: ${BREACH_COUNT} geo-verified unauthorized client IP(s): ${BREACH_IPS}"
  fi
  if [ "$UNKNOWN_COUNT" -gt 0 ]; then
    echo "· ${UNKNOWN_UNIQUE} unrecognized client IP(s), not geo-verified breach: ${UNKNOWN_IPS}"
  fi
  echo "---"
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    parsed=$(parse_conn "$line")
    src_ip=$(echo "$parsed" | awk '{print $1}')
    dst_ip=$(echo "$parsed" | awk '{print $2}')
    local_port=$(echo "$line" | awk '{print $4}' | cut -d: -f2)
    [ -z "$src_ip" ] && continue
    if [ "$local_port" = "$SS_PORT" ] || [ "$local_port" = "80" ] || [ "$local_port" = "443" ]; then
      CLIENT_IP="$dst_ip"
      classify_result=$(classify_ip "$CLIENT_IP")
      label=$(echo "$classify_result" | awk '{print $2}')
      echo "  CLIENT ${CLIENT_IP}:${local_port} → ${src_ip} [${label}]"
    else
      echo "  PROXY  ${src_ip} → ${dst_ip}:${local_port}"
    fi
  done <<< "$CONNS"
fi

# Exit 0 on successfully-fetched+parsed data. A breach is DATA — already reported
# above in every mode (printed ⚠ line / --edge alert line / JSON breach_count +
# breach_ips fields) — NOT a fetch failure. exit 1-on-breach broke the documented
# contract (mesh-ss-clients:12 "unreachable → exit 2"): its `--json || exit 2`
# discarded every breach harvest as "phaedra unreachable" → dash cache stale 9h
# while a live leech sat hidden (267428). exit 2 (the only non-zero path, above)
# means phaedra/ss unreachable; exit 0 means "here is what I found".
exit 0
