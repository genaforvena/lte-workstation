#!/usr/bin/env bash
# mesh-ss-connections — list/classify Shadowsocks tunnel connections on phaedra
# Shows who's using the SS tunnel, identifies known vs unknown IPs,
# and alerts on breach connections (e.g. the Vimpelcom 3rd party).
# reflex-cadence: */15
# reflex-args: --edge
# reflex-args: --edge
#
#   mesh-ss-connections              human-readable connection table
#   mesh-ss-connections --json       JSON output
#   mesh-ss-connections --edge       state-tracked, fires on new/unknown connections
#   mesh-ss-connections --test       smoke test

set -euo pipefail
SSH_CMD="ssh -o StrictHostKeyChecking=no -o ConnectTimeout=10"
PHAEDRA="phaedra"
SS_PORT=443
ALT_PORTS="80"
STATE_FILE="${HOME}/.mesh/.ss-connections.state"
KNOWN_IPS="${HOME}/.mesh/ss-known-ips.txt"

# Known/authorized SS users and their labels.
# Format: IP SPACE LABEL per line.
# Also read from ~/.mesh/ss-known-ips.txt if it exists (overlays built-in list).
known_ips() {
  cat <<'EOF'
54.145.201.186 AWS-Ashburn
95.26.150.184 operator-home
EOF
  [ -f "$KNOWN_IPS" ] && cat "$KNOWN_IPS" 2>/dev/null || true
}

check_deps() {
  local f=0
  command -v ssh >/dev/null 2>&1 || { echo "FAIL: ssh missing"; f=1; }
  [ "$f" = 0 ] || exit 1
}

fetch_connections() {
  $SSH_CMD "$PHAEDRA" "ss -tnp 2>/dev/null | grep 'ss-server' | grep ESTAB" 2>/dev/null
}

classify_ip() {
  local ip="$1"
  local known
  known=$(known_ips 2>/dev/null || cat "$KNOWN_IPS" 2>/dev/null || true)
  if echo "$known" | grep -q "^${ip}\b"; then
    echo "$(echo "$known" | grep "^${ip}\b" | head -1 | awk '{print $2}')"
  else
    echo "UNKNOWN"
  fi
}

do_test() {
  local TESTS_FAILED=0
  test_ok() { echo "  ok: $1"; }
  test_fail() { TESTS_FAILED=$((TESTS_FAILED + 1)); echo "  FAIL: $1"; }
  command -v ssh >/dev/null 2>&1 && test_ok "ssh found" || test_fail "ssh not installed"
  $SSH_CMD "$PHAEDRA" "echo ok" >/dev/null 2>&1 && test_ok "phaedra reachable" || test_fail "phaedra unreachable"
  fetch_connections >/dev/null 2>&1 && test_ok "ss-server connections readable" || { rc=$?; [ $rc -eq 2 ] || test_ok "ss-server connections readable (exit $rc)"; }
  [ $TESTS_FAILED -gt 0 ] && { echo "smoke-test: FAIL"; exit 1; }
  echo "smoke-test: ok"
  exit 0
}

JSON=0; EDGE=0
while [ $# -gt 0 ]; do
  case "$1" in
    --test) do_test;;
    --json) JSON=1; shift;;
    --edge) EDGE=1; shift;;
    *) echo "usage: $0 [--json] [--edge] [--test]"; exit 1;;
  esac
done

check_deps

# Fetch connections
CONNS=$(fetch_connections) || {
  echo "mesh-ss-connections: FAIL — cannot reach phaedra or ss-server" >&2; exit 2
}

if [ -z "$CONNS" ]; then
  # No active connections
  [ "$JSON" = 1 ] && echo '{"connections":[],"total":0,"unique_ips":0,"status":"idle"}'
  [ "$JSON" = 0 ] && echo "mesh-ss-connections: no active SS connections"
  exit 0
fi

# Parse connections into lines: src_ip dst_ip
PARSE_ERROR=0
parse_conn() {
  local line="$1"
  local src_ip dst_ip
  # Extract local and peer addresses from ss output
  # Format: LOCAL:PORT PEER:PORT ...
  src_ip=$(echo "$line" | awk '{print $4}' | cut -d: -f1)
  dst_ip=$(echo "$line" | awk '{print $5}' | cut -d: -f1)
  [ -z "$src_ip" ] || [ -z "$dst_ip" ] && PARSE_ERROR=1 && return
  echo "$src_ip $dst_ip"
}

COUNT=0
declare -A SEEN_UNIQUE
UNIQUE_COUNT=0
RESULT_LINES=""
BREACH_IPS=""
BREACH_COUNT=0
KNOWN_COUNT=0
PASSENGER_COUNT=0

while IFS= read -r line; do
  [ -z "$line" ] && continue
  COUNT=$((COUNT + 1))

  parsed=$(parse_conn "$line")
  src_ip=$(echo "$parsed" | awk '{print $1}')
  dst_ip=$(echo "$parsed" | awk '{print $2}')
  [ -z "$src_ip" ] || [ -z "$dst_ip" ] && continue

  # Count unique client IPs (the source of the SS client connection — dst_ip is the exit target)
  # In `ss -tnp`, the ss-server proxy connections look like:
  #  ESTAB <SERVER>:443 <CLIENT>:PORT  (incoming from SS client)
  #  ESTAB <SERVER>:RANDOM <TARGET>:443  (outgoing to destination)
  # We classify: if the LOCAL port is SS_PORT or an alt port → it's an incoming client connection
  
  local_port=$(echo "$line" | awk '{print $4}' | cut -d: -f2)
  
  is_client=0
  if [ "$local_port" = "$SS_PORT" ]; then
    is_client=1
  else
    for ap in $ALT_PORTS; do
      [ "$local_port" = "$ap" ] && is_client=1 && break
    done
  fi
  
  if [ "$is_client" = 1 ]; then
    # This is an incoming SS client connection
    # For incoming: LOCAL=SRV:443, PEER=CLIENT:PORT → client IP is dst_ip!
    CLIENT_IP="$dst_ip"
    if [ -z "${SEEN_UNIQUE[$CLIENT_IP]:-}" ]; then
      SEEN_UNIQUE[$CLIENT_IP]=1
      UNIQUE_COUNT=$((UNIQUE_COUNT + 1))
    fi
    
    label=$(classify_ip "$CLIENT_IP")
    if [ "$label" = "UNKNOWN" ]; then
      BREACH_IPS="${BREACH_IPS}${CLIENT_IP} "
      BREACH_COUNT=$((BREACH_COUNT + 1))
    else
      KNOWN_COUNT=$((KNOWN_COUNT + 1))
    fi
    
    if [ "$JSON" = 1 ]; then
      RESULT_LINES="${RESULT_LINES}{\"client\":\"$CLIENT_IP\",\"label\":\"$label\",\"port\":\"$local_port\",\"type\":\"client\"},"
    fi
  else
    # Outgoing proxy connection (ss-server reaching a destination)
    PASSENGER_COUNT=$((PASSENGER_COUNT + 1))
    if [ "$JSON" = 1 ]; then
      RESULT_LINES="${RESULT_LINES}{\"src\":\"$src_ip\",\"dst\":\"$dst_ip\",\"type\":\"proxy\"},"
    fi
  fi
done <<< "$CONNS"

RESULT_LINES="${RESULT_LINES%,}"

if [ "$EDGE" = 1 ]; then
  # State tracking — fire only on state change
  PREV=""
  [ -f "$STATE_FILE" ] && PREV=$(cat "$STATE_FILE" 2>/dev/null) || true
  
  # Compute state hash: all known client IPs + breach IPs sorted
  KNOWN_SORTED=$(known_ips 2>/dev/null | grep -oP '^\S+' | sort | tr '\n' ' ')
  KNOWN_SORTED="${KNOWN_SORTED%% }"
  BREACH_SORTED=$(echo "$BREACH_IPS" | tr ' ' '\n' | sort | tr '\n' ' ')
  BREACH_SORTED="${BREACH_SORTED%% }"
  STATE="unique=${UNIQUE_COUNT}:breach=${BREACH_SORTED}:known=${KNOWN_SORTED}"
  
  if [ -n "$PREV" ] && [ "$PREV" = "$STATE" ]; then
    # No change — silent
    exit 0
  fi
  
  # State changed — save and report
  printf '%s' "$STATE" > "$STATE_FILE"
  
  if [ "$BREACH_COUNT" -gt 0 ]; then
    echo "[ss-connections] ${COUNT} active, ${UNIQUE_COUNT} unique: BREACH — ${BREACH_COUNT} unknown IP(s): ${BREACH_IPS}"
  else
    echo "[ss-connections] ${COUNT} active, ${UNIQUE_COUNT} unique: all known"
  fi
elif [ "$JSON" = 1 ]; then
  cat <<JSONEOF
{
  "connections": [${RESULT_LINES}],
  "total": ${COUNT},
  "proxy": ${PASSENGER_COUNT},
  "unique_clients": ${UNIQUE_COUNT},
  "breach_count": ${BREACH_COUNT},
  "known_clients": ${KNOWN_COUNT},
  "breach_ips": "${BREACH_IPS%% }",
  "status": "active"
}
JSONEOF
else
  echo "mesh-ss-connections :: active SS connections on phaedra:${SS_PORT}"
  echo "Total: ${COUNT} | Clients: ${UNIQUE_COUNT} unique | Proxy flows: ${PASSENGER_COUNT}"
  if [ "$BREACH_COUNT" -gt 0 ]; then
    echo "⚠ BREACH: ${BREACH_COUNT} unknown client IP(s): ${BREACH_IPS}"
  fi
  echo "---"
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    parsed=$(parse_conn "$line")
    src_ip=$(echo "$parsed" | awk '{print $1}')
    dst_ip=$(echo "$parsed" | awk '{print $2}')
    local_port=$(echo "$line" | awk '{print $4}' | cut -d: -f2)
    [ -z "$src_ip" ] && continue
    if [ "$local_port" = "$SS_PORT" ] || [ "$local_port" = "80" ] || [ "$local_port" = "443" ]; then
      CLIENT_IP="$dst_ip"
      label=$(classify_ip "$CLIENT_IP")
      echo "  CLIENT ${CLIENT_IP}:${local_port} → ${src_ip} [${label}]"
    else
      echo "  PROXY  ${src_ip} → ${dst_ip}:${local_port}"
    fi
  done <<< "$CONNS"
fi

[ "$BREACH_COUNT" -gt 0 ] && exit 1
exit 0