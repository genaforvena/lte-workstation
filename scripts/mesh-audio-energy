#!/usr/bin/env bash
# mesh-audio-energy — ambient audio-energy sense for the phone body.
# Records 2 seconds of audio via termux-microphone-record, transfers Opus,
# decodes to WAV via GStreamer, computes RMS energy, classifies ambient
# audio level. Complements mesh-light (visual) with an auditory axis.
#
# Classification:
#   SILENT     — RMS < 0.005 — near-silent room
#   QUIET      — RMS < 0.02  — ambient hum, distant sounds
#   MODERATE   — RMS < 0.08  — conversation, music, TV
#   LOUD       — RMS ≥ 0.08  — loud music, shouting, machinery
#   --json     — raw RMS value
#
#   mesh-audio-energy            one-shot audio level
#   mesh-audio-energy --json     machine-readable
#   mesh-audio-energy --test     smoke test (exit 2 = phone unreachable)
#
# Consent: mic_always=yes (set MESH_MIC_ALWAYS=yes in ~/.mesh/nodes).
# Exit 2 on phone unreachable — never fakes a reading.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes"

OFFLINEFILE="$HOME/.mesh/.audio-energy-offline"
DURATION="${MESH_AUDIO_DURATION:-2}"

if [ "${1:-}" = --test ]; then
  command -v ssh >/dev/null 2>&1 || { echo "smoke-test: FAIL (no ssh)"; exit 1; }
  command -v python3 >/dev/null 2>&1 || { echo "smoke-test: FAIL (no python3)"; exit 1; }
  command -v gst-launch-1.0 >/dev/null 2>&1 || { echo "smoke-test: FAIL (no gst-launch-1.0)"; exit 1; }
  command -v mesh-phone-ip >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-phone-ip)"; exit 1; }
  mkdir -p "$HOME/.mesh" 2>/dev/null || { echo "smoke-test: FAIL (no ~/.mesh)"; exit 1; }
  mesh-phone-ip >/dev/null 2>&1 || { echo "smoke-test: n/a (phone unreachable — audio unavailable)"; exit 2; }
  echo "smoke-test: ok"; exit 0
fi

# Mic consent gate
if [ "${MESH_MIC_ALWAYS:-no}" != "yes" ]; then
  echo "audio-energy: mic consent not granted (set MESH_MIC_ALWAYS=yes in ~/.mesh/nodes)" >&2
  exit 2
fi

pip="$(mesh-phone-ip 2>/dev/null)" || {
    if [ ! -f "$OFFLINEFILE" ]; then echo "phone unreachable — can't read audio (not an alarm)"; touch "$OFFLINEFILE"; fi
    exit 2
}
rm -f "$OFFLINEFILE"

# Record on phone: termux-microphone-record -e opus (async), sleep, cat
remote="/sdcard/mesh-ae-$$.ogg"
encoded="$(mktemp /tmp/mesh-ae-XXXXXX.ogg)"
trap 'rm -f "$encoded" "$remote"' EXIT

if ! ssh -p "${PHONE_SSH_PORT:-8022}" -o BatchMode=yes -o ConnectTimeout=6 \
  -o StrictHostKeyChecking=accept-new "${PHONE_USER:-u0_a380}@$pip" \
  "termux-wake-lock >/dev/null 2>&1 || true; termux-microphone-record -f '${remote}' -l '${DURATION}' -e opus >/dev/null 2>&1; sleep $((DURATION + 2)); cat '${remote}' 2>/dev/null; rm -f '${remote}' 2>/dev/null" \
  > "$encoded" 2>/dev/null; then
  [ -s "$encoded" ] || { if [ ! -f "$OFFLINEFILE" ]; then echo "audio-energy: recording failed (phone unreachable?)" >&2; touch "$OFFLINEFILE"; fi; exit 2; }
fi

[ -s "$encoded" ] || { if [ ! -f "$OFFLINEFILE" ]; then echo "audio-energy: empty recording" >&2; touch "$OFFLINEFILE"; fi; exit 2; }

# Decode Opus → WAV → compute RMS via python3
rms="$(gst-launch-1.0 -q filesrc location="$encoded" ! oggdemux ! opusdec ! audioconvert ! audioresample \
  ! audio/x-raw,format=S16LE,rate=16000,channels=1 ! wavenc ! filesink location=/dev/stdout 2>/dev/null \
  | python3 -c '
import sys, struct, math, wave, io
try:
    data = sys.stdin.buffer.read()
    if len(data) < 44:
        print("0"); sys.exit(0)
    w = wave.open(io.BytesIO(data))
    frames = w.readframes(w.getnframes())
    w.close()
    if len(frames) < 2:
        print("0"); sys.exit(0)
    n = len(frames) // 2
    samples = struct.unpack("<" + "h" * n, frames[:n*2])
    sq = sum(s*s for s in samples)
    rms_val = math.sqrt(sq / n) / 32768.0
    print(rms_val)
except Exception:
    print("0")
' 2>/dev/null || echo "0")"

# Clamp
rms="${rms:-0}"
if [ "$(python3 -c "print(1 if float('$rms') < 0 else 0)" 2>/dev/null)" = 1 ]; then rms="0"; fi

# Classify
thresh_silent="${MESH_AUDIO_SILENT:-0.005}"
thresh_quiet="${MESH_AUDIO_QUIET:-0.02}"
thresh_moderate="${MESH_AUDIO_MODERATE:-0.08}"

state="SILENT"; tag="[audio-silent]"
if [ "$(python3 -c "print(1 if float('$rms') >= float('$thresh_moderate') else 0)" 2>/dev/null)" = 1 ]; then
  state="LOUD"; tag="[audio-loud]"
elif [ "$(python3 -c "print(1 if float('$rms') >= float('$thresh_quiet') else 0)" 2>/dev/null)" = 1 ]; then
  state="MODERATE"; tag="[audio-moderate]"
elif [ "$(python3 -c "print(1 if float('$rms') >= float('$thresh_silent') else 0)" 2>/dev/null)" = 1 ]; then
  state="QUIET"; tag="[audio-quiet]"
fi

if [ "${1:-}" = --json ]; then
  printf '{"state":"%s","rms":%s,"duration":%s}\n' "$state" "$rms" "$DURATION"
  exit 0
fi

echo "$tag ${state} — audio RMS energy ${rms} (${DURATION}s sample)"
