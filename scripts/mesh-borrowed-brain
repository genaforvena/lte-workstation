#!/usr/bin/env bash
# mesh-borrowed-brain — mind failover: a vouched neighbour lends its brain to a node whose
# local mind is down (stale beat + node alive). Manual lend only — auto-trigger is a
# deliberate follow-on step once the trust gate is proven in production.
#
#   mesh-borrowed-brain --status user@ip      check: target mind stale? this node vouched?
#   mesh-borrowed-brain --lend   user@ip      lend: trust-gate → single-writer lock → drive window
#   mesh-borrowed-brain --return user@ip      release lock and log handback
#
# Trust gate: THIS node must have a VOUCH entry in mesh-provenance --show (founding member vouched).
# Single writer: ~/.mesh/borrowed-brain.lock on TARGET prevents two lenders fighting.
# Recovery priority: the lender's job is to restore the TARGET's local mind and hand back.
# Provenance of design: ~/.mesh/knowledge/mind-failover-borrowed-brain.md

set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
MESH="${MESH:-$HOME/.mesh}"
SELF="$(hostname)"
LOCK_RELPATH=".mesh/borrowed-brain.lock"
MAX_AGE="${BORROWED_BRAIN_MAX_AGE:-600}"

trace() { mesh-trace "borrowed-brain: $*" 2>/dev/null || true; }
die()   { echo "ERROR: $*" >&2; exit 1; }

is_vouched() {
    mesh-provenance --show 2>/dev/null | grep -E "^[^ ]+ +VOUCH" | grep -q "$SELF"
}

target_beat_age() {
    local target="$1"
    local ts
    ts=$(ssh -o ConnectTimeout=5 -o StrictHostKeyChecking=no "$target" \
        'stat -c %Y ~/.mesh/mind-beat.ts 2>/dev/null' 2>/dev/null) || { echo "-1"; return; }
    echo $(( $(date +%s) - ts ))
}

target_hostname() {
    ssh -o ConnectTimeout=5 -o StrictHostKeyChecking=no "$1" hostname 2>/dev/null || echo "$1"
}

read_lock() {
    local target="$1"
    ssh -o ConnectTimeout=5 -o StrictHostKeyChecking=no "$target" \
        "cat ~/$LOCK_RELPATH 2>/dev/null" 2>/dev/null || true
}

# --test: dependency + dry-run self-check. Touches NO node, opens NO SSH, takes NO lock.
# Load-bearing assertion = ssh: this whole tool is SSH orchestration (target_beat_age,
# read_lock, --lend, --return all SSH to the target) — with no ssh on PATH every op silently
# dies, the green-but-dead class mesh-reflex-health hunts. Second dep = mesh-provenance: the
# is_vouched() trust gate calls it; absent, the gate denies EVERY --lend with no clue why.
# Dry-run: exercise the pure logic (unknown-cmd rejection + the lock-owner string match that
# guards --return) with NO network, so a broken dispatch/guard FAILs here not in production.
# Prove: `bash mesh-borrowed-brain --test` (PASS, ssh present) vs
#        `env PATH=/nonexistent bash mesh-borrowed-brain --test` (FAIL, ssh hidden).
if [ "${1:-}" = --test ]; then
  fail=0
  if command -v ssh >/dev/null 2>&1; then
    echo "  ok: ssh present ($(command -v ssh)) — the tool's only transport"
  else
    echo "  FAIL: ssh not on PATH — every lend/return/status op would silently die (reflex dead)"; fail=1
  fi
  if command -v mesh-provenance >/dev/null 2>&1; then
    echo "  ok: mesh-provenance present — is_vouched() trust gate can resolve"
  else
    echo "  FAIL: mesh-provenance missing — is_vouched() denies EVERY lend, no diagnostic"; fail=1
  fi
  # dry-run 1: the --return owner-guard match (the line that refuses to release another lender's
  # lock). Must MATCH this node's own lock line and REJECT a foreign one — no SSH, pure string.
  _mine="lender:$SELF started:2026-01-01T00:00:00Z"
  _theirs="lender:someone-else started:2026-01-01T00:00:00Z"
  if echo "$_mine" | grep -q "lender:$SELF" && ! echo "$_theirs" | grep -q "lender:$SELF"; then
    echo "  ok: --return owner-guard matches own lock, rejects foreign (dry, no SSH)"
  else
    echo "  FAIL: owner-guard logic broken — could release another lender's lock"; fail=1
  fi
  # dry-run 2: MAX_AGE must be a positive integer (the stale-beat threshold; a non-numeric value
  # makes the `[ "$age" -gt "$MAX_AGE" ]` test in --status/--lend error out at runtime).
  if [ "$MAX_AGE" -gt 0 ] 2>/dev/null; then
    echo "  ok: MAX_AGE=$MAX_AGE is a valid integer threshold"
  else
    echo "  FAIL: MAX_AGE='$MAX_AGE' not a positive integer — stale-beat compare would error"; fail=1
  fi
  [ "$fail" = 0 ] && { echo "smoke-test: ok"; exit 0; } || { echo "smoke-test: FAIL (missing dep / broken logic)"; exit 1; }
fi

cmd="${1:-}"; shift || true
target="${1:-}"
[ -z "$target" ] && die "usage: mesh-borrowed-brain --status|--lend|--return user@ip"

case "$cmd" in

--status)
    age=$(target_beat_age "$target")
    thost=$(target_hostname "$target")
    lock=$(read_lock "$target")
    echo "Target:  $thost ($target)"
    if [ "$age" = "-1" ]; then
        echo "  beat : unreachable (SSH failed) — node down, not mind down"
    elif [ "$age" -gt "$MAX_AGE" ]; then
        echo "  beat : STALE ${age}s (threshold ${MAX_AGE}s) — MIND DOWN"
    else
        echo "  beat : ${age}s fresh — OK"
    fi
    [ -n "$lock" ] && echo "  lock : HELD — $lock" || echo "  lock : free"
    echo ""
    if is_vouched; then
        echo "  $SELF: VOUCHED — eligible to lend"
    else
        echo "  $SELF: NOT VOUCHED — cannot lend (add VOUCH to provenance first)"
    fi
    ;;

--lend)
    is_vouched || die "trust gate: $SELF is not vouched — cannot lend brain"
    age=$(target_beat_age "$target")
    [ "$age" = "-1" ] && die "cannot reach $target (SSH failed) — node down, not mind down; lend aborted"
    [ "$age" -le "$MAX_AGE" ] && die "target mind is fresh (${age}s) — no failover needed"
    thost=$(target_hostname "$target")
    existing=$(read_lock "$target")
    [ -n "$existing" ] && die "single-writer: lock already held by '$existing' — aborting"
    # acquire lock on target
    ssh -o ConnectTimeout=5 -o StrictHostKeyChecking=no "$target" \
        "mkdir -p ~/.mesh && echo 'lender:$SELF started:$(date -u +%Y-%m-%dT%H:%M:%SZ)' > ~/$LOCK_RELPATH" \
        || die "failed to write lock on $target"
    trace "LEND BEGIN $thost ($target) beat_age=${age}s lock written"
    mesh-chat "BORROWED BRAIN: $SELF lending to $thost (beat ${age}s stale). Priority = restore local mind." 2>/dev/null || true
    # open drive window pointing at target's hostname-named session
    WIN="bb-$thost"
    if tmux new-window -n "$WIN" \
        "ssh -o StrictHostKeyChecking=no $target -t 'tmux new-session -A -s $thost'" 2>/dev/null; then
        echo "Brain lent. Drive window: $WIN"
    else
        echo "WARNING: could not open tmux window — drive manually:"
        echo "  ssh $target -t 'tmux new-session -A -s $thost'"
    fi
    echo ""
    echo "PRIORITY: restore $thost's local mind, then run:"
    echo "  mesh-borrowed-brain --return $target"
    ;;

--return)
    thost=$(target_hostname "$target")
    existing=$(read_lock "$target")
    if [ -z "$existing" ]; then
        echo "No lock on $thost — nothing to release."
        exit 0
    fi
    echo "$existing" | grep -q "lender:$SELF" \
        || die "lock held by '$existing', not $SELF — will not release"
    ssh -o ConnectTimeout=5 -o StrictHostKeyChecking=no "$target" \
        "rm -f ~/$LOCK_RELPATH" || die "failed to remove lock on $target"
    trace "LEND RETURN $thost ($target) — local mind restored, lock released"
    mesh-chat "RETURN: $SELF released borrowed-brain lock on $thost — local mind back." 2>/dev/null || true
    echo "Lock released. Borrowed-brain session on $thost ended."
    ;;

*)
    die "unknown command '$cmd'. Use --status, --lend, or --return"
    ;;
esac
