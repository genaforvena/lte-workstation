#!/usr/bin/env bash
# mesh-imac-audio-topology — freshness-bounded iMac CoreAudio endpoint/route read.
#
# A successful result is a single live `system_profiler SPAudioDataType` sample with
# default input/output, route/source, and channel counts.  SSH or parse failure is
# UNKNOWN: this tool never turns an unreachable iMac into an empty topology.
set -uo pipefail

IMAC_HOST="${MESH_IMAC_HOST:-ilya@192.168.8.214}"
TIMEOUT="${MESH_IMAC_AUDIO_TIMEOUT:-12}"

read_imac() {
  timeout "$TIMEOUT" ssh -o BatchMode=yes -o ConnectTimeout=6 \
    -o StrictHostKeyChecking=accept-new "$IMAC_HOST" \
    'system_profiler SPAudioDataType -detailLevel mini' </dev/null 2>/dev/null
}

classify() {
  local raw="$1" default_in default_out in_channels out_channels in_source out_source
  local physical virtual line name channels kind
  printf '%s\n' "$raw" | grep -q '^Audio:' || return 1
  default_in="$(printf '%s\n' "$raw" | awk '
    /^[[:space:]]{8,10}[^[:space:]].*:[[:space:]]*$/ {name=$0; sub(/^[[:space:]]+/,"",name); sub(/:[[:space:]]*$/, "", name)}
    /Default Input Device: Yes/ {print name; exit}')"
  default_out="$(printf '%s\n' "$raw" | awk '
    /^[[:space:]]{8,10}[^[:space:]].*:[[:space:]]*$/ {name=$0; sub(/^[[:space:]]+/,"",name); sub(/:[[:space:]]*$/, "", name)}
    /Default Output Device: Yes/ {print name; exit}')"
  in_channels="$(printf '%s\n' "$raw" | awk -F': ' '/Input Channels: [0-9]+/{print $2; exit}')"
  out_channels="$(printf '%s\n' "$raw" | awk -F': ' '/Output Channels: [0-9]+/{print $2; exit}')"
  in_source="$(printf '%s\n' "$raw" | awk -F': ' '/Input Source:/{print $2; exit}')"
  out_source="$(printf '%s\n' "$raw" | awk -F': ' '/Output Source:/{print $2; exit}')"
  [ -n "$default_in" ] && [ -n "$default_out" ] &&
    [ "$in_channels" -gt 0 ] 2>/dev/null && [ "$out_channels" -gt 0 ] 2>/dev/null &&
    [ -n "$in_source" ] && [ -n "$out_source" ] || return 1

  physical=""; virtual=""
  while IFS= read -r line; do
    case "$line" in
      *)
        [[ "$line" =~ ^[[:space:]]{8}[^[:space:]].*:[[:space:]]*$ ]] || continue
        name="$(printf '%s\n' "$line" | sed -E 's/^[[:space:]]+//; s/[[:space:]]*:$//')"; kind="physical"
        case "$name" in *Soundflower*|*"Sound Grabber"*|*"Internal Audio Driver"*) kind="virtual";; esac
        channels="$(printf '%s\n' "$raw" | awk -v n="$name" '
          substr($0,1,9) ~ /^        [^[:space:]]/ {
            hdr=$0; sub(/^[[:space:]]+/, "", hdr); sub(/:[[:space:]]*$/, "", hdr)
            if (hdr == n) {on=1; next}
            if (on) {exit}
          }
          on && /Input Channels:|Output Channels:/ {gsub(/^[[:space:]]+/, ""); vals=vals (vals?",":"") $0}
          END {print vals}')"
        [ "$kind" = physical ] && physical="${physical}${physical:+; }${name} [${channels:-channels-unknown}]" || \
          virtual="${virtual}${virtual:+; }${name} [${channels:-channels-unknown}]"
        ;;
    esac
  done < <(printf '%s\n' "$raw" | grep -E '^[[:space:]]{8}[^[:space:]].*:$')

  printf '[imac-audio-topology] status=OK input=%s input_channels=%s input_source=%s output=%s output_channels=%s output_source=%s physical=%s virtual=%s ts=%s\n' \
    "$default_in" "$in_channels" "$in_source" "$default_out" "$out_channels" "$out_source" \
    "${physical:--}" "${virtual:--}" "$(date -u +%FT%TZ)"
}

run() {
  local raw parsed
  raw="$(read_imac)" || { echo "[imac-audio-topology] status=UNKNOWN reason=ssh-failure host=$IMAC_HOST ts=$(date -u +%FT%TZ)"; return 2; }
  parsed="$(classify "$raw")" || { echo "[imac-audio-topology] status=UNKNOWN reason=parse-failure host=$IMAC_HOST ts=$(date -u +%FT%TZ)"; return 2; }
  printf '%s\n' "$parsed"
}

if [ "${1:-}" = --test ]; then
  fixture='Audio:
        Built-in Microphone:
          Default Input Device: Yes
          Input Channels: 2
          Input Source: Line In
        Built-in Output:
          Default Output Device: Yes
          Output Channels: 2
          Output Source: Headphones
        Soundflower (2ch):
          Input Channels: 2
          Output Channels: 2'
  classify "$fixture" | grep -q 'status=OK.*input_channels=2.*output_channels=2.*physical=.*virtual=' || {
    echo 'TEST-FAIL: fixture parse'; exit 1;
  }
  classify 'not SPAudioDataType' >/dev/null 2>&1 && { echo 'TEST-FAIL: malformed input accepted'; exit 1; }
  live="$(run 2>/dev/null)"; rc=$?
  if [ "$rc" = 0 ]; then
    printf '%s\n' "$live" | grep -q 'status=OK' || { echo 'TEST-FAIL: malformed live output'; exit 1; }
    echo "TEST: PASS (fixture + live: $live)"
  else
    echo 'TEST: n/a — fixture passed but iMac unavailable (honest exit 2)'
    exit 2
  fi
else
  run
fi
