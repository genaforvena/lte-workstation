#!/usr/bin/env bash
# test-help-guard — the CLASS gate for pub/argv-is-payload-tools-fire-on-help (2026-07-15).
#
# The bug: on every tool whose argv IS its payload, `--help` was not a question, it was the ACTION.
# `mesh-tg-update --help` mailed the operator a commit digest at 03:18Z; `mesh-tg --help` texted him
# the literal string '--help'; `mesh-sms --help` would have billed a real SMS to a real phone; and
# `mesh-say --help` would have spoken '--help' aloud into a sleeping room. Fixed by one guard, first
# line, before any dispatch: `case "${1:-}" in -h|--help) usage; exit 0 ;; esac`.
#
# This harness gates the CLASS, not the seven instances — add a new argv-is-payload tool to TOOLS
# below and it is covered. It asserts POSITIVELY, which is the whole point: a test that only checks
# "usage text appeared" passes on a tool that prints usage AND THEN SENDS. So we run each tool under
# a PATH shim that replaces every sender (ssh/curl/adb/tmux/spd-say/piper/...) with a recorder, and
# assert the recorder was NEVER called. mesh-trace's sender is a local append, so its log is checked
# for existence instead.
#
# Per tool, all four must hold:
#   1. exit 0
#   2. stdout contains the tool's own name (usage really rendered, not an empty sed)
#   3. NO sender binary was invoked  <-- the load-bearing one
#   4. no mesh-trace log was written
#
#   test-help-guard            run the gate
#   test-help-guard --test     same (mesh-doctor/mesh-land entry point)
#   test-help-guard --falsify  DELETE each guard in a scratch copy and prove the gate goes RED
#
# --falsify is not decoration: a gate you have not seen FAIL is not a gate. It copies each tool to a
# temp dir, strips the guard line, and asserts the sender FIRES — i.e. it reproduces the original bug
# on demand and proves this harness catches it.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

usage(){ sed -n '2,/^[^#]/p' "$0" | sed -n 's/^# \?//p'; }
case "${1:-}" in -h|--help) usage; exit 0 ;; esac

REPO="${MESH_REPO:-$HOME/lte-workstation}"
SRC="$REPO/scripts"
TOOLS="mesh-sms mesh-say mesh-note3-say mesh-trace mesh-tg mesh-tg-update mesh-tell"
# every way one of these tools can reach off-process. If a tool gains a new egress binary, add it
# here — an unshimmed sender is a hole in the gate, not a pass.
SENDERS="ssh scp curl wget nc adb tmux spd-say say piper termux-sms-send termux-tts-speak am ffmpeg"

fails=0; passes=0
sandbox_dir=""
setup_sandbox(){
  sandbox_dir="$(mktemp -d)"; mkdir -p "$sandbox_dir/bin" "$sandbox_dir/mesh"
  : > "$sandbox_dir/fired"
  local s
  for s in $SENDERS; do
    { printf '#!/bin/sh\n'
      printf 'echo "%s $*" >> "%s/fired"\n' "$s" "$sandbox_dir"
      printf 'exit 0\n'; } > "$sandbox_dir/bin/$s"
    chmod +x "$sandbox_dir/bin/$s"
  done
}
cleanup(){ [ -n "$sandbox_dir" ] && rm -rf "$sandbox_dir"; }
trap cleanup EXIT

# run_help <path-to-tool> [flag] — sets RC + OUT in the CALLER's shell and leaves $sandbox_dir/fired
# populated. Deliberately NOT used as "$(run_help ...)": command substitution forks a subshell, so RC
# would never escape it (this harness's own first red run).
run_help(){
  local tool="$1" flag="${2:---help}" out
  : > "$sandbox_dir/fired"; rm -rf "$sandbox_dir/mesh"; mkdir -p "$sandbox_dir/mesh"
  # PATH: shims FIRST so they shadow the real senders. MESH_DIR/HOME point at the sandbox so a tool
  # that appends locally (mesh-trace) writes there and never touches the node's real trace tier.
  PATH="$sandbox_dir/bin:$PATH" MESH_DIR="$sandbox_dir/mesh" \
    MESH_SMS_NUMBER="+00000000000" MESH_TELL_ACK_TIMEOUT=1 \
    timeout 20 "$tool" "$flag" > "$sandbox_dir/out" 2>&1
  RC=$?
  OUT="$(cat "$sandbox_dir/out")"
}

check(){ # check <label> <cond-rc> <detail>
  if [ "$2" = 0 ]; then passes=$((passes+1)); else
    fails=$((fails+1)); echo "  FAIL: $1 — $3"
  fi
}

setup_sandbox
mode="${1:-}"

if [ "$mode" = "--falsify" ]; then
  echo "test-help-guard --falsify: stripping the guard, expecting each tool to GO RED"
  for t in $TOOLS; do
    [ -f "$SRC/$t" ] || continue
    broken="$sandbox_dir/broken-$t"
    grep -v '^case "${1:-}" in -h|--help) usage; exit 0 ;; esac$' "$SRC/$t" > "$broken"
    chmod +x "$broken"
    if cmp -s "$broken" "$SRC/$t"; then
      echo "  FAIL: $t — no guard line to strip (guard missing or reworded)"; fails=$((fails+1)); continue
    fi
    run_help "$broken"
    if [ -s "$sandbox_dir/fired" ] || [ "$RC" != 0 ]; then
      echo "  RED (correct): $t — guard removed => rc=$RC sender=[$(head -1 "$sandbox_dir/fired" 2>/dev/null | cut -c1-40)]"
      passes=$((passes+1))
    else
      echo "  FAIL: $t — guard removed and NOTHING happened; this gate proves nothing for $t"
      fails=$((fails+1))
    fi
  done
  echo "test-help-guard --falsify: $passes proved-red, $fails inert"
  [ "$fails" = 0 ] || exit 1
  echo "smoke-test: ok (gate is real — every guard, when deleted, fires its sender)"
  exit 0
fi

echo "test-help-guard: --help must not BE the action ($(echo $TOOLS | wc -w) argv-is-payload tools)"
for t in $TOOLS; do
  if [ ! -f "$SRC/$t" ]; then echo "  FAIL: $t — not in $SRC"; fails=$((fails+1)); continue; fi
  for flag in --help -h; do
    run_help "$SRC/$t" "$flag"
    check "$t $flag rc" "$([ "$RC" = 0 ] && echo 0 || echo 1)" "rc=$RC (expected 0), out='$(printf '%s' "$OUT" | head -1 | cut -c1-60)'"
    printf '%s' "$OUT" | grep -q -- "$t" && r=0 || r=1
    check "$t $flag usage" "$r" "usage did not render (stdout has no '$t'): '$(printf '%s' "$OUT" | head -1 | cut -c1-60)'"
    [ -s "$sandbox_dir/fired" ] && r=1 || r=0
    check "$t $flag NO-SEND" "$r" "REACHED THE SEND PATH: $(head -1 "$sandbox_dir/fired" 2>/dev/null | cut -c1-60)"
    [ -e "$sandbox_dir/mesh/traces.log" ] && r=1 || r=0
    check "$t $flag NO-TRACE" "$r" "wrote a mark into the durable trace tier"
  done
done

echo "test-help-guard: $passes assertions passed, $fails failed"
[ "$fails" = 0 ] || { echo "smoke-test: FAIL ($fails)"; exit 1; }
echo "smoke-test: ok ($passes assertions — --help exits 0, prints usage, and reaches NO sender)"
