#!/usr/bin/env bash
# orphan-ok: on-demand operator probe; mesh-autowire refuses uncommitted genome sources, and this task forbids committing
# mesh-cpu-steal — host CPU time that the kernel reports as stolen by a hypervisor.
# This is a scheduler-visible hardware/runtime signal distinct from load, PSI, and frequency:
# work can be waiting while this node's vCPUs are runnable but not being given physical CPU time.
# A bare-metal kernel honestly reports zero; an unavailable or malformed procfs read is UNKNOWN.
#
# Exit: 0 = a real reading was published; 2 = /proc/stat is unavailable or malformed.
set -u
export PATH="${HOME:-/root}/.local/bin:$PATH"

MESH="${MESH_DIR:-${HOME:-/root}/.mesh}"
STATE="${MESH_CPU_STEAL_STATE:-$MESH/.cpu-steal-state}"
STAT_FILE="${MESH_CPU_STEAL_STAT_FILE:-/proc/stat}"
WINDOW_MS="${MESH_CPU_STEAL_WINDOW_MS:-250}"

read_steal() {
  local file="${1:-$STAT_FILE}"
  [ -r "$file" ] || return 2
  awk '
    $1 == "cpu" {
      # user nice system idle iowait irq softirq steal guest guest_nice
      if (NF < 9 || $9 !~ /^[0-9]+$/) exit 2
      print $9
      found=1
      exit
    }
    END { if (!found) exit 2 }
  ' "$file" 2>/dev/null
}

classify_delta() {
  case "${1:-}" in
    ''|*[!0-9]*) printf 'UNKNOWN\n' ;;
    0) printf 'CLEAR\n' ;;
    *) printf 'STOLEN\n' ;;
  esac
}

if [ "${1:-}" = --test ]; then
  td="$(mktemp -d)" || exit 1
  trap 'rm -rf "$td"' EXIT
  cat >"$td/stat" <<'EOF'
cpu  100 20 30 400 5 6 7 8 9 10
cpu0 50 10 15 200 2 3 4 5 6 7
EOF
  [ "$(read_steal "$td/stat")" = 8 ] || { echo 'smoke-test: FAIL (fixture steal field)'; exit 1; }
  [ "$(classify_delta 0)" = CLEAR ] || { echo 'smoke-test: FAIL (zero delta)'; exit 1; }
  [ "$(classify_delta 3)" = STOLEN ] || { echo 'smoke-test: FAIL (positive delta)'; exit 1; }
  if read_steal "$td/missing" >/dev/null 2>&1; then
    echo 'smoke-test: FAIL (missing procfs accepted)'; exit 1
  fi
  live="$(read_steal "$STAT_FILE" 2>/dev/null)" || {
    echo "smoke-test: n/a (real CPU steal field unavailable in $STAT_FILE)"; exit 2;
  }
  case "$live" in ''|*[!0-9]*) echo 'smoke-test: FAIL (live read malformed)'; exit 1;; esac
  echo "smoke-test: ok (fixture parser/classifier + REAL /proc/stat cpu steal=$live jiffies)"
  exit 0
fi

before="$(read_steal "$STAT_FILE" 2>/dev/null)" || {
  echo "mesh-cpu-steal: UNKNOWN — cannot read CPU steal field from $STAT_FILE" >&2
  exit 2
}
sleep "$(awk -v ms="$WINDOW_MS" 'BEGIN { printf "%.3f", ms / 1000 }')"
after="$(read_steal "$STAT_FILE" 2>/dev/null)" || {
  echo "mesh-cpu-steal: UNKNOWN — CPU steal field disappeared from $STAT_FILE" >&2
  exit 2
}
[ "$after" -ge "$before" ] 2>/dev/null || {
  echo 'mesh-cpu-steal: UNKNOWN — CPU steal counter moved backwards' >&2
  exit 2
}
delta=$((after - before))
verdict="$(classify_delta "$delta")"
mkdir -p "$(dirname "$STATE")" 2>/dev/null || exit 1
printf '%s|steal_jiffies=%s|delta_jiffies=%s|window_ms=%s|ts=%s\n' \
  "$verdict" "$after" "$delta" "$WINDOW_MS" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >"$STATE" || exit 1
mesh-state-touch "$STATE" >/dev/null 2>&1 || {
  echo 'mesh-cpu-steal: UNKNOWN — could not stamp live state' >&2
  exit 1
}

if [ "${1:-}" = --edge ]; then
  previous="$(sed -n '1s/|.*//p' "$STATE.prev" 2>/dev/null || true)"
  cp "$STATE" "$STATE.prev" 2>/dev/null || true
  [ "$previous" = "$verdict" ] && exit 0
fi
printf '[cpu-steal] %s — total_jiffies=%s delta_jiffies=%s window_ms=%s\n' \
  "$verdict" "$after" "$delta" "$WINDOW_MS"
