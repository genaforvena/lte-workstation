#!/usr/bin/env bash
# orphan-ok: on-demand Note3 gyroscope instrument; keep unwired until its relation to other axes is measured.
# mesh-note3-gyro — live MPU6500 angular velocity from the Note 3 Android sensor HAL.
# The existing mesh-gyro reads the Redmi body; this probes the distinct Note 3 body, whose
# orientation and acceleration are sensed but whose rotational rate is not. It publishes raw
# rad/s values only: no motion verdict is inferred from one read.
#
#   mesh-note3-gyro          one live three-axis reading
#   mesh-note3-gyro --json   machine-readable reading, including the HAL event tick
#   mesh-note3-gyro --test   parser fixtures + a real sensorcat hardware read
#
# Honest contract: adb/relay unreachable, absent gyro event, or malformed data exits 2.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && [ -z "${MESH_SKIP_NODES_SOURCE:-}" ] && . "$HOME/.mesh/nodes"

NOTE3_ADB_NODE="${MESH_NOTE3_ADB_NODE:-${MESH_BARO_ADB_NODE:-}}"
NOTE3_ADB_SERIAL="${MESH_NOTE3_ADB_SERIAL:-${MESH_BARO_ADB_SERIAL:-}}"

parse_gyro() {
  awk -F'|' '$1=="SENSOR" && $3=="4" {
    for (i=4; i<=7; i++) gsub(/[\r ]/, "", $i)
    printf "%s,%s,%s,%s", $4,$5,$6,$7
    exit
  }'
}

note3_gyro_raw() {
  local out raw ser=""
  if [ -n "${NOTE3_GYRO_RAW_OVERRIDE:-}" ]; then
    out="$NOTE3_GYRO_RAW_OVERRIDE"
  else
    [ -n "$NOTE3_ADB_NODE" ] || return 1
    [ -n "$NOTE3_ADB_SERIAL" ] && ser="-s $NOTE3_ADB_SERIAL"
    if [ "$NOTE3_ADB_NODE" = local ]; then
      mesh-note3-tool-install sensorcat >/dev/null 2>&1 || return 1
      raw="$(timeout 20 adb $ser shell '/data/local/tmp/sensorcat --secs 3 4' 2>/dev/null)" || return 1
    else
      raw="$(timeout 30 ssh -o BatchMode=yes -o ConnectTimeout=8 -o StrictHostKeyChecking=accept-new \
        "$NOTE3_ADB_NODE" "adb $ser shell '/data/local/tmp/sensorcat --secs 3 4'" </dev/null 2>/dev/null)" || return 1
    fi
    [ -n "$raw" ] || return 1
    out="$(printf '%s\n' "$raw" | parse_gyro)"
  fi
  [[ "$out" =~ ^(-?([0-9]+([.][0-9]*)?|[.][0-9]+)),(-?([0-9]+([.][0-9]*)?|[.][0-9]+)),(-?([0-9]+([.][0-9]*)?|[.][0-9]+)),([1-9][0-9]*)$ ]] || return 1
  printf '%s' "$out"
}

if [ "${1:-}" = --test ]; then
  fixture='SENSOR|MPU6500 Gyroscope Sensor|4|0.01|-0.02|0.3|123456789
SENSOR|AK09911C Magnetic field Sensor|2|2|3|4|99'
  got="$(printf '%b\n' "$fixture" | parse_gyro)"
  [ "$got" = '0.01,-0.02,0.3,123456789' ] || { echo "mesh-note3-gyro --test: FAIL (fixture parse: $got)" >&2; exit 1; }
  bad='SENSOR|MPU6500 Gyroscope Sensor|4||0|0|0'
  if NOTE3_GYRO_RAW_OVERRIDE="$bad" "$0" --json >/dev/null 2>&1; then
    echo 'mesh-note3-gyro --test: FAIL (empty axis accepted)' >&2; exit 1
  fi
  live="$(note3_gyro_raw 2>/dev/null)" || {
    echo 'mesh-note3-gyro --test: n/a (Note3 gyroscope unreachable or not producing a valid live event)' >&2
    exit 2
  }
  echo "mesh-note3-gyro --test: PASS (fixture + real Note3 MPU6500 HAL read: $live rad/s,tick)"
  exit 0
fi

mode=text
case "${1:-}" in '' ) ;; --json) mode=json ;; *) echo 'usage: mesh-note3-gyro [--json|--test]' >&2; exit 1 ;; esac
raw="$(note3_gyro_raw 2>/dev/null)" || {
  echo 'mesh-note3-gyro: UNREACHABLE — no valid live Note3 gyroscope event' >&2
  [ "$mode" = json ] && printf '{"status":"UNKNOWN","reason":"no valid live gyroscope event"}\n'
  exit 2
}
IFS=, read -r gx gy gz tick <<<"$raw"
ts="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
if [ "$mode" = json ]; then
  printf '{"status":"OK","sensor":"MPU6500 gyroscope","gx_rad_s":%s,"gy_rad_s":%s,"gz_rad_s":%s,"hal_tick_ns":%s,"ts":"%s"}\n' "$gx" "$gy" "$gz" "$tick" "$ts"
else
  printf 'note3-gyro: sensor=MPU6500 angular_velocity_rad_s=(%s,%s,%s) hal_tick_ns=%s ts=%s\n' "$gx" "$gy" "$gz" "$tick" "$ts"
fi
