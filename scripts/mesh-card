#!/usr/bin/env bash
# mesh-card — a node's small, current-state self-description (durable memory tier).
#
# Unlike the trace (volatile history), the card is the node's *now*: capabilities,
# known peers, and — the part that matters most — the INVARIANT this node must hold.
#
# The card is self-truthing: `--refresh` regenerates the live block from actual
# state (routing, exit-node, wireguard, services) and CHECKS it against the
# invariant. The VPN regression of 2026-06-07 happened because the card froze as
# a hand-written intention and silently diverged from reality; --refresh exists so
# that can't happen quietly again.
#
#   mesh-card             # print the card
#   mesh-card --refresh   # regenerate the live block from real state; check invariant
#
# Hand-written sections (invariant:, notes:) are preserved across --refresh.
# The live block is auto-generated — do not hand-edit it.
#
# A systemd watchdog (mesh-card-watchdog.timer + .service) runs --refresh
# every 15 minutes and alerts via mesh-tg on violation. Enable:
#   systemctl --user enable --now mesh-card-watchdog.timer
#
# ── CODE DUALITY (Hoffmeyer & Emmeche; Pattee) ──────────────────────────────────
# LITERATURE — biosemiotics, an OPERATIONAL mechanism (2026-06-21): CODE DUALITY (Claus Emmeche
# & Jesper Hoffmeyer, "From language to nature — the semiotic metamorphosis of biology", Semiotica
# 84:1, 1991; written 1988; roots in Bateson's analog/digital codes + Howard Pattee's complementarity
# of time-INDEPENDENT DESCRIPTION vs time-DEPENDENT DYNAMICS). Life requires TWO interlocking codes:
# an ANALOG code for ACTION/behaviour (the embodied, dynamic, time-dependent organism — the string
# quartet's actual performance) and a DIGITAL code for MEMORY/inheritance (a discrete, re-describable,
# time-independent record — the score). A living system PERSISTS across reproduction only because the
# analog organism is periodically RE-DESCRIBED into the digital code, and the digital code is later
# RE-EXPRESSED to reconstruct a new analog. Two faithfulness requirements fall out: (1) the digital
# re-description must not DIVERGE from the analog it describes; (2) it must be COMPLETE enough that
# re-expression reconstructs the FUNCTIONAL analog, not a crippled ancestor.
# THE MESH IS LITERALLY CODE-DUAL: the GENOME (scripts/, git — digital, re-describable, inheritable,
# time-independent) is the score; the RUNNING mesh (deployed ~/.local/bin executing + live panes/
# processes/senses — analog, dynamic, time-dependent) is the performance. THIS CARD is the per-node
# DIGITAL re-description: `--refresh` re-describes live analog state INTO the card (analog→digital),
# and on reboot `mesh-restore` TRUSTS the card to reconstruct the analog session (digital→analog). The
# reboot doctrine ("clean reincarnation: same hostname + ~/.mesh-card, fresh session") IS Emmeche-
# Hoffmeyer reproduction: the analog dies, the digital seed rebuilds it.
# WHERE THE CARD ALREADY EMBODIES IT — and where it STOPS: --refresh fights requirement (1) for the
# SUBSTRATE/CAPABILITY analog (the VPN-2026-06-07 divergence is a pure code-duality fault — the digital
# froze as intention and drifted from the analog reality; the :66 under-declare + :104 over-declare
# phantom-capability hazards are the same divergence in either direction). But it under-serves
# requirement (2): the card re-describes the STATIC substrate/capability snapshot, NOT the LEARNED /
# ADAPTIVE analog state a running node accrues — an empirically-tuned threshold a mind found works, an
# accreted baseline, an organ verified-working-once. That state is a THIRD category between the two the
# mesh handles cleanly: it is NOT re-observable perception (rightly DECAYED on reboot — "perception is
# re-observed, never stored") and NOT genome code (rightly in git). Code duality names exactly why this
# middle band silently fails to survive reproduction: it lives ONLY in the analog code, no digital
# re-description captures it, so each reincarnation inherits the genome's ANCESTRAL DEFAULTS — the
# functional adaptations the running node learned do not inherit. (Complement to this session's
# evolutionary-activity review on mesh-vitality: that asks whether produced structure PERSISTS; this
# asks whether learned structure is RE-DESCRIBED so it can persist ACROSS a reboot at all.)
# HELD FIX (instrument-first, steward/operator-gated — behavioral): a narrow, opt-in analog→digital
# re-description channel in the card for the LEARNED-adaptation band only — a tool declares a small,
# named, durable parameter (with provenance) that --refresh captures and mesh-restore re-expresses, so
# a reincarnated node inherits the adaptation, not the ancestral default. WHY HELD: the hard part is
# the BOUNDARY — most analog state is intentionally-decayed perception, and over-capturing would smuggle
# transient noise into the durable tier (re-introducing the very divergence --refresh exists to kill,
# and bloating the reproduction seed). Which parameters are worth re-describing must be curated +
# validated (against reboot-survival history) before any capture is wired. NOT shipped.
# DISTINCT from prior biosemiotics reviews: NOT the INTERPRETANT (triadic sign — the third leg of
# meaning); NOT Deacon SYMBOL-GROUNDING (icon→index→symbol reference stability). Code duality is about
# the DUAL-CODE ARCHITECTURE (analog action ⇄ digital memory) and the re-description that carries a
# system across reproduction — the inheritance mechanism, not the sign-reference relation.
# ────────────────────────────────────────────────────────────────────────────────
set -uo pipefail
# mesh-card calls many sibling tools (mesh-power, mesh-vitals, mesh-isp-health, mesh-peers) by name.
# Over a raw ssh/non-interactive shell ~/.local/bin may be absent from PATH, silently degrading every
# one of them (e.g. known-peers fell back to the non-deduped scan on ds). Anchor PATH so the card
# behaves identically wherever it runs.
export PATH="$HOME/.local/bin:$PATH"

CARD="${MESH_CARD:-$HOME/.mesh-card}"

# Default invariant, seeded only if the card has none yet. Edit it in the card.
DEFAULT_INVARIANT="this node's control plane (SSH/Tailscale/own egress) stays on the clean
  default route, always reachable. A capability this node OFFERS (e.g. VPN egress)
  must never carry this node's own reachability. Only forwarded client traffic may
  ride an offered route. Blast radius matches the request; nothing global, nothing
  involuntary."

ts() { date -u +%Y-%m-%dT%H:%M:%SZ; }

# --- preserve hand-written sections from an existing card ---------------------
extract_invariant() {
    [ -r "$CARD" ] || { printf '%s\n' "  $DEFAULT_INVARIANT"; return; }
    local inv
    inv=$(awk '
        /^invariant:/ {grab=1; next}
        grab && /^[a-z].*:/ {grab=0}
        grab {print}
    ' "$CARD" | sed '/^[[:space:]]*$/d')
    if [ -n "$inv" ]; then
        printf '%s\n' "$inv"
    else
        printf '%s\n' "  $DEFAULT_INVARIANT"
    fi
}
extract_notes() {
    [ -r "$CARD" ] || return
    awk '/^notes:/{grab=1} grab{print}' "$CARD"
}

# --- live probes (all sudo-free) ----------------------------------------------
detect_minds() {
    [ "${MESH_NO_CAP_MINDS:-0}" = 1 ] && { echo ""; return; }
    local m=""
    # Probe under the node's REAL toolchain, not a bare non-login PATH: minds install in many places
    # (nvm node bin, ~/.opencode/bin, ~/.bun/bin, ~/.local/bin). A bare command-v misses them → the
    # card under-declares → mesh-restore (which trusts the card) rebuilds FEWER mind channels than the
    # node actually runs (2026-06-13: IdeaPad lost opencode[~/.opencode/bin]+codex[nvm] on restart).
    [ -s "$HOME/.nvm/nvm.sh" ] && . "$HOME/.nvm/nvm.sh" >/dev/null 2>&1 && nvm use node >/dev/null 2>&1 || true
    local d; for d in "$HOME/.opencode/bin" "$HOME/.bun/bin" "$HOME/.local/bin"; do
        [ -d "$d" ] && case ":$PATH:" in *":$d:"*) :;; *) PATH="$d:$PATH";; esac
    done
    for a in claude opencode gemini codex aider ollama llm; do
        command -v "$a" >/dev/null 2>&1 && m="$m $a"
    done
    echo "${m# }"
}
# mic is REAL only if it CAPTURES a frame — not merely listed by `arecord -l`. A headless VM lists a
# dummy card that never yields audio (hollow organ → cascades into mesh-transcribe/-organ/-tts FAILs,
# 2026-06-12 on ds). Mirrors mesh-doctor's busy-vs-broken probe and shares its lock so card and doctor
# don't fight over the device. busy (held by a voice agent) = real; no-frame-and-not-busy = hollow.
# Probes EVERY capture device arecord lists, not just plughw:0,0 — the working mic may be a USB
# card at index 1+ while card 0 is a dummy (ds: card hid a verified-working USB mic, 2026-06-12).
mic_real() {
    local devs wav="/tmp/.card-mic.$$.wav" err="/tmp/.card-mic.$$.err" dev rc=1
    if command -v arecord >/dev/null 2>&1; then
        devs=$(arecord -l 2>/dev/null | sed -n 's/^card \([0-9]\+\): .*device \([0-9]\+\):.*/\1,\2/p')
        for dev in $devs; do
            flock -w 8 /tmp/.mesh-mic.lock arecord -d 1 -D "plughw:$dev" -f S16_LE -r 16000 "$wav" >/dev/null 2>"$err"
            if [ -s "$wav" ] || grep -qiE 'busy|in use|resource busy' "$err" 2>/dev/null; then rc=0; break; fi
        done
    fi
    # PipeWire fallback: on a desktop session where PipeWire/PulseAudio owns the capture device
    # EXCLUSIVELY, raw ALSA hw access reads busy/silent and the loop above leaves rc=1 — yet a real
    # mic is right there THROUGH PipeWire. ds 2026-06-26 (discover↻+health BATON): the webcam mic
    # pcmC2D0c is held by pipewire → `arecord -D hw:2` empty/no-busy → mic UNDECLARED, though
    # `pw-record` captures a ~125KB live WAV. Mirror the mesh-camera ffmpeg→fswebcam gate: detect a
    # sense by the SAME path the live organ (mesh-hear ds backend) takes, never a subset that buries
    # a working ear. Non-empty capture = device produced frames = real (same any-frame rule as above).
    if [ "$rc" -ne 0 ] && command -v pw-record >/dev/null 2>&1; then
        XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}" \
            timeout 3 pw-record --rate 16000 --channels 1 --format s16 "$wav" >/dev/null 2>"$err"
        [ -s "$wav" ] && rc=0
    fi
    rm -f "$wav" "$err"; return "$rc"
}

detect_senses() {
    local s=""
    # COUPLING-CONSTITUTION FALLACY (Adams & Aizawa; the canonical 4E/extended-cognition critique,
    # live 2023-25 "Mark of the Cognitive" debate, PMC5712358): a resource being causally COUPLED to a
    # cognitive system does NOT make it a CONSTITUENT of it. This detector declares a SENSE present by
    # COUPLING — the tool is installed (`command -v X`, :100) or passes a smoke `--test` (:106/111/112)
    # — NOT by CONSTITUTION (it produced a genuine recent reading). Installed / smoke-green != produces
    # real perception. PROOF it self-deceives: mesh-baro was cron-wired AND smoke-GREEN yet a DARK sense
    # (the only embodied node has no barometer → 0 real reads in ~300 runs; honest-decayed 2026-06-21) —
    # a phantom capability in the card, which claims to be "self-truthing" (:7) but here over-declares
    # the self's sensory boundary. Same failure CLASS the mesh keeps re-patching ad hoc and the 4E
    # critique NAMES once: cached Tailscale Online != alive ([[liveness-is-lease-not-cached-status]]),
    # a live mind PROCESS != a working mind ([[blocked-mind-is-a-failure-class]]), a sensor TOKEN != a
    # true reading (the 2026-06-21 mesh-correlate stuck-sensor finding). Coupling is not constitution.
    # HELD fix (instrument-first, NOT auto-flipped here): gate a sense on evidence of a genuine recent
    # reading — a fresh non-UNKNOWN ~/.mesh/.<sense>-state artifact, or a contribution-probing --test
    # (mesh-baro's fixed --test now probes the live sensor list, not a classifier) — generalize that to
    # the self-model. Gated because flipping detection naively could UNDER-declare a working-but-idle
    # sense, and mesh-restore TRUSTS the card → it would rebuild FEWER channels (the :66 under-declare
    # hazard); validate against real cached-state freshness first.
    # phone (termux) organs
    for nb in battery:termux-battery-status camera:termux-camera-photo \
              mic:termux-microphone-record location:termux-location; do
        command -v "${nb#*:}" >/dev/null 2>&1 && s="$s ${nb%%:*}"
    done
    # linux organs — declare what's actually present (live-contract: card reflects reality)
    bluetoothctl show 2>/dev/null | grep -q 'Powered: yes' && s="$s ble"
    nmcli -t radio wifi 2>/dev/null | grep -q enabled && s="$s wifi"
    mic_real && s="$s mic"
    command -v mesh-camera >/dev/null 2>&1 && mesh-camera --test >/dev/null 2>&1 && s="$s camera"
    command -v mesh-irq-rate >/dev/null 2>&1 && s="$s irq"
    ls /dev/ttyUSB* /dev/ttyACM* >/dev/null 2>&1 && { command -v screen >/dev/null 2>&1 || command -v minicom >/dev/null 2>&1 || command -v picocom >/dev/null 2>&1 || command -v cu >/dev/null 2>&1; } && s="$s serial"
    ls /sys/class/power_supply/ 2>/dev/null | grep -q . && s="$s power"
    [ -r /proc/acpi/button/lid/LID0/state ] && command -v mesh-lid >/dev/null 2>&1 && s="$s lid"
    # phone body organs (SSH-proxied: reachable from this node via mesh-* tools)
    command -v mesh-body-motion >/dev/null 2>&1 && mesh-body-motion --test >/dev/null 2>&1 && s="$s body-motion"
    command -v mesh-light >/dev/null 2>&1 && mesh-light --test >/dev/null 2>&1 && s="$s light"
    # net-vantage: a public-IP vantage — a globally-routable IPv4 bound LOCALLY (not LAN/CGNAT/wg).
    # The sense mesh-watchtower reads (inbound knocks / external reach / self-exposure). Detect the
    # ADDRESS, not the tool: mesh-* tools propagate to every node, so mesh-watchtower presence would
    # make every node falsely claim it — only a node with its own public IP genuinely has the sense.
    ip -4 -o addr show scope global 2>/dev/null | awk '{print $4}' | cut -d/ -f1 \
      | grep -qvE '^(10\.|172\.(1[6-9]|2[0-9]|3[01])\.|192\.168\.|100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\.|127\.|169\.254\.|0\.)' \
      && s="$s net-vantage"
    echo "${s# }"
}
_wg_has_active_peers() {
    local now iface peer ts
    now=$(date +%s)
    for iface in $(wg show interfaces 2>/dev/null); do
        while IFS=$'\t ' read -r peer ts; do
            [ -z "$peer" ] && continue
            [ "$ts" != "0" ] && [ "$ts" -le "$now" ] && [ $((now - ts)) -lt 3600 ] && return 0
        done < <(wg show "$iface" latest-handshakes 2>/dev/null)
    done
    return 1
}

detect_actuators() {
    local a=""
    aplay -l 2>/dev/null | grep -q '^card' && a="$a speaker"
    command -v termux-tts-speak >/dev/null 2>&1 && a="$a tts"
    command -v termux-sms-send  >/dev/null 2>&1 && a="$a sms"
    command -v mesh-say >/dev/null 2>&1 && aplay -l 2>/dev/null | grep -qi bose && a="$a voice-out:bose"
    # notify-send needs both DBUS and a graphical DISPLAY — without DISPLAY, it fails (Cannot autolaunch D-Bus / no daemon)
    command -v notify-send >/dev/null 2>&1 && [ -S "/run/user/$(id -u)/bus" ] && { [ -n "${DISPLAY-}" ] || [ -n "${WAYLAND_DISPLAY-}" ]; } && dbus-send --bus="unix:path=/run/user/$(id -u)/bus" --dest=org.freedesktop.Notifications --type=method_call --print-reply /org/freedesktop/Notifications org.freedesktop.Notifications.GetServerInformation >/dev/null 2>&1 && a="$a notify"
    command -v mesh-volume >/dev/null 2>&1 && mesh-volume --test >/dev/null 2>&1 && a="$a volume"
    command -v mesh-tv-dlna >/dev/null 2>&1 && command -v yt-dlp >/dev/null 2>&1 && a="$a tv dlna-tv"
    # speech/TTS actuator (spd-say, espeak-ng, festival, say) — voice output capability
    command -v spd-say >/dev/null 2>&1 && a="$a speech"
    command -v espeak-ng >/dev/null 2>&1 && a="$a speech"
    command -v festival >/dev/null 2>&1 && a="$a speech"
    command -v say >/dev/null 2>&1 && a="$a speech"
    # VPN/proxy services (actuators: this node runs them)
    command -v ss-server >/dev/null 2>&1 && a="$a shadowsocks"
    _wg_has_active_peers && a="$a wireguard-vpn"
    # self-describing capabilities (operator design 2026-06-21): each executable in ~/.mesh/caps/
    # is a capability this node OFFERS, named by its FILENAME. Surface the names so peers discover
    # + invoke them via mesh-organ (card-declared = public). The command/creds stay inside the file.
    local capd="${MESH_CAP_DIR:-$HOME/.mesh/caps}" n
    if [ -d "$capd" ]; then
        for n in "$capd"/*; do
            [ -x "$n" ] || continue
            n="${n##*/}"
            case " $a " in *" $n "*) ;; *) a="$a $n" ;; esac
        done
    fi
    echo "${a# }"
}

detect_connectivity() {
    local c=""
    # exit-node: this node consumes another node's egress
    tailscale status --json 2>/dev/null | python3 -c "
import json,sys
try: d=json.load(sys.stdin)
except Exception: sys.exit()
eid=(d.get('Self',{}) or {}).get('ExitNodeStatus') or {}
if eid: print('exit-node')
" 2>/dev/null | grep -q exit-node && c="$c exit-node"
    # public-ingress: this node offers public ingress (ngrok, bore, etc.)
    # Check for known ingress services running
    systemctl --user list-units --type=service --state=active --no-legend 2>/dev/null \
      | awk '{print $1}' | grep -qiE 'ngrok|bore|proxy-bot|mtg' && c="$c public-ingress"
    # exit-node-offered: this node OFFERS egress to others (advertised exit-node)
    tailscale status --peers=false 2>/dev/null | grep -q 'offers exit node' && c="$c exit-node-offered"
    # VPN/proxy services (connectivity: this node provides these tunnels)
    ( systemctl is-active shadowsocks-libev-server@config >/dev/null 2>&1 || systemctl is-active shadowsocks-libev >/dev/null 2>&1 ) && c="$c shadowsocks"
    _wg_has_active_peers && c="$c wireguard"
    echo "${c# }"
}

# --- health probes (best-effort — skip if tool absent) -------------------
health_power() {
    local raw source pct
    raw=$(mesh-power 2>/dev/null) || return 1
    source=$(echo "$raw" | awk '{print $2}')
    pct=$(echo "$raw" | grep -oP 'capacity=\K\d+')
    # battery-less nodes (VM/desktop: no capacity= field) → $pct empty → emit source only,
    # never a bare 'MAINS %' (stray % with no number) in the card / mesh-fleet-health POWER col.
    [ -n "$pct" ] && echo "${source} ${pct}%" || echo "${source}"
}

health_vitals() {
    local line distress rc
    line=$(mesh-vitals 2>/dev/null); rc=$?
    if [ "$rc" -eq 0 ]; then
        echo "OK $line"
    else
        distress=$(mesh-vitals --check 2>&1 || true)
        echo "DISTRESS $line ($distress)"
    fi
}

health_upstream() {
    local verdict
    verdict=$(mesh-isp-health --verdict 2>/dev/null) || return 1
    case "$verdict" in
        upstream-ok)   echo "ok" ;;
        upstream-down) echo "down" ;;
        *) echo "$verdict" ;;
    esac
}

refresh() {
    local host tsip lanip egress_dev wg_ifaces fwd pubip exitnode svc inv_check
    host=$(hostname)
    tsip=$(tailscale ip -4 2>/dev/null | head -1 || echo '?')
    # real LAN IP = a global v4 addr that isn't tailscale/docker/bridge/loopback
    lanip=$(ip -o -4 addr show scope global 2>/dev/null \
            | awk '$2!~/^(lo|tailscale|docker|br-|veth|wg|Gtcld)/ {print $4}' \
            | cut -d/ -f1 | head -1)
    egress_dev=$(ip route get 1.1.1.1 2>/dev/null | grep -oP 'dev \K\S+' | head -1)
    # wireguard interfaces present (no sudo needed)
    wg_ifaces=$(ip -o link show type wireguard 2>/dev/null | awk -F': ' '{print $2}' | cut -d@ -f1 | paste -sd' ' -)
    fwd=$(cat /proc/sys/net/ipv4/ip_forward 2>/dev/null)
    pubip=$(curl -s --max-time 6 https://ifconfig.me 2>/dev/null || echo '?')

    # exit-node (this node consuming someone else's egress)
    exitnode=$(tailscale status --json 2>/dev/null | python3 -c "
import json,sys
try: d=json.load(sys.stdin)
except Exception: print('?'); sys.exit()
eid=(d.get('Self',{}) or {}).get('ExitNodeStatus') or {}
# resolve ExitNodeID from prefs
import subprocess
pj=subprocess.run(['tailscale','debug','prefs'],capture_output=True,text=True).stdout
try: p=json.loads(pj)
except Exception: p={}
xid=p.get('ExitNodeID') or ''
if not xid: print('none'); sys.exit()
for peer in (d.get('Peer') or {}).values():
    if peer.get('ID')==xid: print(peer.get('HostName',xid)); sys.exit()
print(xid)
" 2>/dev/null || echo '?')

    # only mesh-relevant userland services — desktop/session noise is irrelevant here
    svc=$(systemctl --user list-units --type=service --state=active --no-legend 2>/dev/null \
          | awk '{print $1}' | grep -iE 'ngrok|bore|proxy-bot|vpn-hub|mtg|mesh' \
          | paste -sd' ' - || echo '')

    # --- INVARIANT CHECK: is this node's OWN control plane riding a local VPN? ---
    inv_check="OK"
    if [ -n "$egress_dev" ] && printf ' %s ' "$wg_ifaces" | grep -q " $egress_dev "; then
        inv_check="⚠ VIOLATED — host's own default egress is dev $egress_dev (a local WireGuard tunnel). The control plane is betting on an offered route. One endpoint flap = lockout. Set Table=off + scope to forwarded traffic only."
    fi

    local invariant notes
    invariant=$(extract_invariant)
    notes=$(extract_notes)

    {
        echo "hostname: $host"
        echo "tailscale-ip: $tsip"
        echo "lan-ip: ${lanip:-?}"
        echo "as-of: $(ts)  (live-refreshed)"
        echo
        echo "invariant:"
        printf '%s\n' "$invariant"
        echo
        echo "live (auto — regenerated by \`mesh-card --refresh\`; do not hand-edit):"
        echo "  default-egress: dev ${egress_dev:-?}$([ "$inv_check" = OK ] && echo '  (clean)' || echo '  ⚠ via WireGuard')"
        echo "  public-ip: $pubip"
        echo "  exit-node: $exitnode"
        echo "  ip-forwarding: $([ "$fwd" = 1 ] && echo on || echo off)"
        echo "  wireguard-ifaces: ${wg_ifaces:-none}"
        echo "  services-active: ${svc:-none}"
        echo "  invariant-check: $inv_check"
        echo
        echo "health:"
        local hp hv hu
        command -v mesh-power >/dev/null 2>&1 && hp=$(health_power 2>/dev/null) || hp=""
        command -v mesh-vitals >/dev/null 2>&1 && hv=$(health_vitals 2>/dev/null) || hv=""
        command -v mesh-isp-health >/dev/null 2>&1 && hu=$(health_upstream 2>/dev/null) || hu=""
        [ -n "$hp" ] && echo "  power: $hp"
        [ -n "$hv" ] && echo "  vitals: $hv"
        [ -n "$hu" ] && echo "  upstream: $hu"
        echo
        echo "capabilities:"
        echo "  minds: $(detect_minds | sed 's/^$/(none)/')"
        echo "  senses: $(detect_senses | sed 's/^$/(none)/')"
        echo "  actuators: $(detect_actuators | sed 's/^$/(none)/')"
        echo "  connectivity: $(detect_connectivity | sed 's/^$/(none)/')"
        echo
        echo "known-peers:"
        # Use mesh-peers (collision-deduped): Tailscale keeps a STALE duplicate when a node
        # re-registers (same HostName, old IP, offline) → a naive scan shows a LIVE node OFFLINE
        # in the durable card. mesh-peers collapses each HostName to its best (online) record.
        # Inline fallback keeps the card working on a fresh node before mesh-peers is deployed.
        if command -v mesh-peers >/dev/null 2>&1; then
            # --verify: corroborate liveness with a fresh ping so the DURABLE card never records a
            # frozen-but-Online peer as 'online' (the cached-card-status lie — operator 2026-06-21).
            # A peer Tailscale calls Online but that fails the ping is written 'stale', not 'online'.
            mesh-peers --json --verify 2>/dev/null | python3 -c "
import json,sys
try: rows=json.load(sys.stdin)
except Exception: sys.exit()
for r in rows:
    st=r.get('state') or ('online' if r.get('online') else 'offline')
    print(f\"  {r['hostname']}: {r['ip']} ({r['os']}, {st})\")
" 2>/dev/null
        else
            tailscale status --json 2>/dev/null | python3 -c "
import json,sys
try: d=json.load(sys.stdin)
except Exception: sys.exit()
for p in (d.get('Peer') or {}).values():
    if 'tag:lte-node' in (p.get('Tags') or []):
        st='online' if p.get('Online') else 'offline'
        print(f\"  {p.get('HostName','?')}: {p['TailscaleIPs'][0]} ({p.get('OS','?')}, {st})\")
" 2>/dev/null
        fi
        echo
        [ -n "$notes" ] && printf '%s\n' "$notes" || { echo "notes:"; echo "  - (none yet)"; }
    } > "$CARD.tmp" && mv "$CARD.tmp" "$CARD"

    cat "$CARD"
    if [ "$inv_check" != OK ]; then
        echo >&2
        echo "mesh-card: INVARIANT VIOLATION detected (see invariant-check above)." >&2
        return 2
    fi
}

case "${1:-}" in
    --refresh) refresh ;;
    --test)    failures=0
               for dep in tailscale python3 hostname ip; do
                 command -v "$dep" >/dev/null 2>&1 || { echo "smoke-test: FAIL ($dep missing)"; failures=1; }
               done
               for dep in curl systemctl wg; do
                 command -v "$dep" >/dev/null 2>&1 || echo "smoke-test: WARN ($dep missing — feature degraded)"
               done
               echo '{"Self":{"HostName":"test"},"Peer":{}}' | python3 -c "import json,sys; json.load(sys.stdin)" >/dev/null 2>&1 \
                 || { echo "smoke-test: FAIL (python3 JSON parse failed)"; failures=1; }
               ip -4 route get 1.1.1.1 >/dev/null 2>&1 \
                 || { echo "smoke-test: FAIL (ip route failed)"; failures=1; }
               ((failures)) && exit 1
               echo "smoke-test: ok"; exit 0 ;;
    "")        [ -r "$CARD" ] && cat "$CARD" || echo "no card at $CARD — run: mesh-card --refresh" ;;
    *)         echo "usage: mesh-card [--refresh]" >&2; exit 1 ;;
esac
