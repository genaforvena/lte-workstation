#!/usr/bin/env bash
# mesh-card — a node's small, current-state self-description (durable memory tier).
#
# Unlike the trace (volatile history), the card is the node's *now*: capabilities,
# known peers, and — the part that matters most — the INVARIANT this node must hold.
#
# The card is self-truthing: `--refresh` regenerates the live block from actual
# state (routing, exit-node, wireguard, services) and CHECKS it against the
# invariant. The VPN regression of 2026-06-07 happened because the card froze as
# a hand-written intention and silently diverged from reality; --refresh exists so
# that can't happen quietly again.
#
#   mesh-card             # print the card
#   mesh-card --refresh   # regenerate the live block from real state; check invariant
#
# Hand-written sections (invariant:, notes:) are preserved across --refresh.
# The live block is auto-generated — do not hand-edit it.
#
# A systemd watchdog (mesh-card-watchdog.timer + .service) runs --refresh
# every 15 minutes and alerts via mesh-tg on violation. Enable:
#   systemctl --user enable --now mesh-card-watchdog.timer
set -uo pipefail

CARD="${MESH_CARD:-$HOME/.mesh-card}"

# Default invariant, seeded only if the card has none yet. Edit it in the card.
DEFAULT_INVARIANT="this node's control plane (SSH/Tailscale/own egress) stays on the clean
  default route, always reachable. A capability this node OFFERS (e.g. VPN egress)
  must never carry this node's own reachability. Only forwarded client traffic may
  ride an offered route. Blast radius matches the request; nothing global, nothing
  involuntary."

ts() { date -u +%Y-%m-%dT%H:%M:%SZ; }

# --- preserve hand-written sections from an existing card ---------------------
extract_invariant() {
    [ -r "$CARD" ] || { printf '%s\n' "  $DEFAULT_INVARIANT"; return; }
    awk '
        /^invariant:/ {grab=1; next}
        grab && /^[a-z].*:/ {grab=0}
        grab {print}
    ' "$CARD" | sed '/^[[:space:]]*$/d' | { grep -q . && cat || printf '%s\n' "  $DEFAULT_INVARIANT"; }
}
extract_notes() {
    [ -r "$CARD" ] || return
    awk '/^notes:/{grab=1} grab{print}' "$CARD"
}

# --- live probes (all sudo-free) ----------------------------------------------
detect_minds() {
    local m=""
    for a in claude opencode gemini codex aider ollama llm; do
        command -v "$a" >/dev/null 2>&1 && m="$m $a"
    done
    echo "${m# }"
}
detect_senses() {
    local s=""
    # phone (termux) organs
    for nb in battery:termux-battery-status camera:termux-camera-photo \
              mic:termux-microphone-record location:termux-location; do
        command -v "${nb#*:}" >/dev/null 2>&1 && s="$s ${nb%%:*}"
    done
    # linux organs — declare what's actually present (live-contract: card reflects reality)
    bluetoothctl show 2>/dev/null | grep -q 'Powered: yes' && s="$s ble"
    nmcli -t radio wifi 2>/dev/null | grep -q enabled && s="$s wifi"
    arecord -l 2>/dev/null | grep -q '^card' && s="$s mic"
    ls /dev/video0 >/dev/null 2>&1 && s="$s camera"
    ls /dev/ttyUSB* /dev/ttyACM* >/dev/null 2>&1 && s="$s serial"
    ls /sys/class/power_supply/ 2>/dev/null | grep -q . && s="$s power"
    echo "${s# }"
}
detect_actuators() {
    local a=""
    aplay -l 2>/dev/null | grep -q '^card' && a="$a speaker"
    command -v termux-tts-speak >/dev/null 2>&1 && a="$a tts"
    command -v termux-sms-send  >/dev/null 2>&1 && a="$a sms"
    command -v mesh-say >/dev/null 2>&1 && aplay -l 2>/dev/null | grep -qi bose && a="$a voice-out:bose"
    echo "${a# }"
}

refresh() {
    local host tsip lanip egress_dev wg_ifaces fwd pubip exitnode svc inv_check
    host=$(hostname)
    tsip=$(tailscale ip -4 2>/dev/null | head -1 || echo '?')
    # real LAN IP = a global v4 addr that isn't tailscale/docker/bridge/loopback
    lanip=$(ip -o -4 addr show scope global 2>/dev/null \
            | awk '$2!~/^(lo|tailscale|docker|br-|veth|wg|Gtcld)/ {print $4}' \
            | cut -d/ -f1 | head -1)
    egress_dev=$(ip route get 1.1.1.1 2>/dev/null | grep -oP 'dev \K\S+' | head -1)
    # wireguard interfaces present (no sudo needed)
    wg_ifaces=$(ip -o link show type wireguard 2>/dev/null | awk -F': ' '{print $2}' | cut -d@ -f1 | paste -sd' ' -)
    fwd=$(cat /proc/sys/net/ipv4/ip_forward 2>/dev/null)
    pubip=$(curl -s --max-time 6 https://ifconfig.me 2>/dev/null || echo '?')

    # exit-node (this node consuming someone else's egress)
    exitnode=$(tailscale status --json 2>/dev/null | python3 -c "
import json,sys
try: d=json.load(sys.stdin)
except Exception: print('?'); sys.exit()
eid=(d.get('Self',{}) or {}).get('ExitNodeStatus') or {}
# resolve ExitNodeID from prefs
import subprocess
pj=subprocess.run(['tailscale','debug','prefs'],capture_output=True,text=True).stdout
try: p=json.loads(pj)
except Exception: p={}
xid=p.get('ExitNodeID') or ''
if not xid: print('none'); sys.exit()
for peer in (d.get('Peer') or {}).values():
    if peer.get('ID')==xid: print(peer.get('HostName',xid)); sys.exit()
print(xid)
" 2>/dev/null || echo '?')

    # only mesh-relevant userland services — desktop/session noise is irrelevant here
    svc=$(systemctl --user list-units --type=service --state=active --no-legend 2>/dev/null \
          | awk '{print $1}' | grep -iE 'ngrok|bore|proxy-bot|vpn-hub|mtg|mesh' \
          | paste -sd' ' - || echo '')

    # --- INVARIANT CHECK: is this node's OWN control plane riding a local VPN? ---
    inv_check="OK"
    if [ -n "$egress_dev" ] && printf ' %s ' "$wg_ifaces" | grep -q " $egress_dev "; then
        inv_check="⚠ VIOLATED — host's own default egress is dev $egress_dev (a local WireGuard tunnel). The control plane is betting on an offered route. One endpoint flap = lockout. Set Table=off + scope to forwarded traffic only."
    fi

    local invariant notes
    invariant=$(extract_invariant)
    notes=$(extract_notes)

    {
        echo "hostname: $host"
        echo "tailscale-ip: $tsip"
        echo "lan-ip: ${lanip:-?}"
        echo "as-of: $(ts)  (live-refreshed)"
        echo
        echo "invariant:"
        printf '%s\n' "$invariant"
        echo
        echo "live (auto — regenerated by \`mesh-card --refresh\`; do not hand-edit):"
        echo "  default-egress: dev ${egress_dev:-?}$([ "$inv_check" = OK ] && echo '  (clean)' || echo '  ⚠ via WireGuard')"
        echo "  public-ip: $pubip"
        echo "  exit-node: $exitnode"
        echo "  ip-forwarding: $([ "$fwd" = 1 ] && echo on || echo off)"
        echo "  wireguard-ifaces: ${wg_ifaces:-none}"
        echo "  services-active: ${svc:-none}"
        echo "  invariant-check: $inv_check"
        echo
        echo "capabilities:"
        echo "  minds: $(detect_minds | sed 's/^$/(none)/')"
        echo "  senses: $(detect_senses | sed 's/^$/(none)/')"
        echo "  actuators: $(detect_actuators | sed 's/^$/(none)/')"
        echo
        echo "known-peers:"
        tailscale status --json 2>/dev/null | python3 -c "
import json,sys
try: d=json.load(sys.stdin)
except Exception: sys.exit()
for p in (d.get('Peer') or {}).values():
    if 'tag:lte-node' in (p.get('Tags') or []):
        st='online' if p.get('Online') else 'offline'
        print(f\"  {p.get('HostName','?')}: {p['TailscaleIPs'][0]} ({p.get('OS','?')}, {st})\")
" 2>/dev/null
        echo
        [ -n "$notes" ] && printf '%s\n' "$notes" || { echo "notes:"; echo "  - (none yet)"; }
    } > "$CARD.tmp" && mv "$CARD.tmp" "$CARD"

    cat "$CARD"
    if [ "$inv_check" != OK ]; then
        echo >&2
        echo "mesh-card: INVARIANT VIOLATION detected (see invariant-check above)." >&2
        return 2
    fi
}

case "${1:-}" in
    --refresh) refresh ;;
    "")        [ -r "$CARD" ] && cat "$CARD" || echo "no card at $CARD — run: mesh-card --refresh" ;;
    *)         echo "usage: mesh-card [--refresh]" >&2; exit 1 ;;
esac
