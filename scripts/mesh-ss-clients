#!/usr/bin/env bash
# mesh-ss-clients — enrich the NON-Tailscale VPN users (SS/trojan clients on phaedra) for the vpn dash.
# Reads `mesh-ss-connections --json` (ONE ssh to phaedra — never per dash frame), adds per-client GEO
# (ip-api.com: country/city/ISP/ASN/reverse + class, 7-day cache) + per-client FLOW counts + AGGREGATE
# top DESTINATIONS (reverse-resolved), and writes ~/.mesh/.ss-clients.cache which the vpn dash renders.
#
# WHY a separate reflex (not an edit to mesh-ss-connections): that tool's --edge state-hash logic is
# load-bearing for breach escalation; bolting geo+online-calls onto it risks the escalation path and its
# hermetic --test (which re-execs $0). This tool is decoupled, owns its own caches + --test, and reuses
# mesh-ss-connections --json as a pure data source.
#
# HONESTY: phaedra unreachable → mesh-ss-connections --json exits 2 → this tool exits 2 WITHOUT
# overwriting the cache (the dash keeps the last good read, aged). ip-api / DNS unreachable → the field
# reads '-', never faked. Destinations are AGGREGATE (SS multiplexes; the dump carries no per-client
# attribution) — rendered as "tunnel reaching:", not per-client.
#
# HONESTY 2 — the failure line NAMED A PEER FOR A LOCAL FAULT (2026-08-16). This tool's only log line
# was "phaedra unreachable (mesh-ss-connections --json failed)" — a verdict about ANOTHER NODE derived
# from a failure that is equally consistent with THIS node being off the air. It fired at
# 14:24/14:39/14:54 while phaedra was FINE; the cause was mesh-home's own 14:23-14:56Z link outage
# (egress-health loss=80%, kernel tape), and the vpn mind's 14:09 and 15:00 reads of phaedra both
# succeeded. We reach phaedra over TAILSCALE (ssh alias → 100.94.116.17), so before naming it the
# honest question is "can this node reach ANYTHING?" → local_egress() below, two independent legs,
# both quoted IN the line. Sibling precedent that already got this right on the same ssh:
# mesh-vpn-health's "UNREACHABLE (read-only SSH failed) — BLIND, not a service verdict".
#
# HONESTY 2b — "BOTH LOCAL LEGS UP" WAS NEVER A LICENCE TO NAME THE PEER (2026-08-29). The fix above
# left the naming gated on local_egress, whose ts leg is `.Self.Online`: our own tailscaled's opinion
# of itself, which says nothing about whether packets reach phaedra. On 2026-08-20 that pair went green
# while the transport was dead and the peer was wrongly named anyway — the fault that produced
# `mesh-vpn-health --peer-transport`. This tool now names the peer only by RELAYING the attribution of
# the process that actually probed the transport (its `tsp=` token, never its prose); local_egress
# stays, demoted to context about US that may not name the peer in any arm.
#
# HONESTY 3 — the log was FAILURE-ONLY, so it is not a rate. 161/161 lines read "unreachable" because
# a success wrote NOTHING (the cache mtime was the sole success record) and no line carried a
# timestamp, making even the failure rate unrecoverable from the file. Every terminal branch now emits
# ONE timestamped line (ok / idle / blind / fault) on stdout|stderr, which is the cron log
# (`>> ~/.mesh/ss-clients.log 2>&1`) — deliberately NOT a $LOG the tool writes itself, so a hand-run
# and `--test` cannot forge the liveness record the log is read for.
#
# reflex-cadence: 9-59/15 * * * *
# reflex-args:
#
#   mesh-ss-clients              refresh ~/.mesh/.ss-clients.cache from live phaedra state
#   mesh-ss-clients --show       print the cache (what the pane renders)
#   mesh-ss-clients --test       hermetic smoke test (stubbed ssh + fixture geo/dns)

set -euo pipefail
M="${MESH_HOME:-$HOME/.mesh}"
OUT_CACHE="$M/.ss-clients.cache"
SELF="$0"

case "${1:-}" in
  --show)
    [ -s "$OUT_CACHE" ] && cat "$OUT_CACHE" || { echo "mesh-ss-clients: no cache yet (reflex not run)"; exit 1; }
    exit 0 ;;
  --test)
    # Hermetic: stub mesh-ss-connections (emits a known JSON dump), point geo+dns at local fixtures.
    td="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
    mkdir -p "$td/bin" "$td/geo" "$td/home/.mesh" || { rm -rf "$td"; echo "smoke-test: FAIL (dirs)"; exit 1; }
    cat >"$td/bin/mesh-ss-connections" <<'EOF'
#!/bin/sh
[ "$1" = "--json" ] || exit 2
cat <<'JSON'
{"connections":[
{"client":"95.26.149.97","label":"unknown","port":"443","type":"client"},
{"client":"95.26.149.97","label":"unknown","port":"443","type":"client"},
{"client":"194.147.115.17","label":"operator-home-wifi","port":"443","type":"client"},
{"src":"38.49.216.141","dst":"142.250.69.138","type":"proxy"},
{"src":"38.49.216.141","dst":"185.70.42.37","type":"proxy"},
{"src":"38.49.216.141","dst":"142.250.69.138","type":"proxy"}
],"unique_clients":2,"unknown_ips":"95.26.149.97","known_ips":"194.147.115.17","breach_ips":""}
JSON
exit 0
EOF
    chmod +x "$td/bin/mesh-ss-connections"
    # geo fixtures: <ip>.json
    printf '{"status":"success","country":"Russia","city":"Nizhniy Novgorod","isp":"PJSC Vimpelcom","as":"AS8402 PJSC Vimpelcom","reverse":"95-26-149-97.broadband.corbina.ru","mobile":false,"proxy":false,"hosting":false}' >"$td/geo/95.26.149.97.json"
    printf '{"status":"success","country":"Germany","city":"Frankfurt","isp":"Hetzner","as":"AS24940 Hetzner","reverse":"","mobile":false,"proxy":false,"hosting":true}' >"$td/geo/194.147.115.17.json"
    # dns fixtures: <ip>.ptr
    printf 'fra1.hetzner.com' >"$td/geo/142.250.69.138.ptr"
    printf 'mail.protonmail.ch' >"$td/geo/185.70.42.37.ptr"
    out="$(MESH_HOME="$td/home/.mesh" MESH_SS_CONN_DIR="$td/bin" MESH_SS_GEO_FIXTURE="$td/geo" \
           bash "$SELF" 2>&1)" || { rm -rf "$td"; echo "smoke-test: FAIL (core exited rc=$?)"; exit 1; }
    c="$td/home/.mesh/.ss-clients.cache"
    [ -s "$c" ] || { rm -rf "$td"; echo "smoke-test: FAIL (no cache written)"; exit 1; }
    # per-client geo must land (Russia/Vimpelcom for the friend), flows counted (2), status unknown-friend
    grep -q '95.26.149.97' "$c" || { rm -rf "$td"; echo "smoke-test: FAIL (friend IP missing)"; exit 1; }
    grep -q 'Russia' "$c" || { rm -rf "$td"; echo "smoke-test: FAIL (geo country missing)"; exit 1; }
    grep -q 'Vimpelcom' "$c" || { rm -rf "$td"; echo "smoke-test: FAIL (geo ISP missing)"; exit 1; }
    # flows: the friend has 2 client sockets -> 'flows=2' must appear on its line
    grep -E '^C	95\.26\.149\.97	2	' "$c" >/dev/null || { rm -rf "$td"; echo "smoke-test: FAIL (flow count wrong: $(grep '^C' "$c"))"; exit 1; }
    # aggregate destinations reverse-resolved (Google 142.250.69.138 appears twice -> top)
    grep -q '142.250.69.138' "$c" || { rm -rf "$td"; echo "smoke-test: FAIL (destination missing)"; exit 1; }
    grep -q 'fra1.hetzner.com' "$c" || { rm -rf "$td"; echo "smoke-test: FAIL (destination rDNS missing)"; exit 1; }
    # status: 194.147.115.17 is KNOWN (operator-home-wifi); 95.26.149.97 unknown-friend
    grep -E '^C	194\.147\.115\.17	.*KNOWN' "$c" >/dev/null || { rm -rf "$td"; echo "smoke-test: FAIL (known status)"; exit 1; }
    grep -E '^C	95\.26\.149\.97	.*unknown-friend' "$c" >/dev/null || { rm -rf "$td"; echo "smoke-test: FAIL (unknown-friend status)"; exit 1; }
    # (2) the SUCCESS branch must LOG — the log used to be failure-only (161/161 "unreachable"), so a
    # success left no line at all and the file could not be read as a rate. Assert the ISO timestamp
    # AND the counts, so a run that harvested nothing is not indistinguishable from a healthy one.
    printf '%s' "$out" | grep -qE '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z	mesh-ss-clients: ok — 2 client\(s\), 2 destination\(s\), 3 flow\(s\)' \
      || { rm -rf "$td"; echo "smoke-test: FAIL (success branch logged no timestamped count line: $out)"; exit 1; }

    # ── (1) the failure line must not name the peer for a LOCAL fault ────────────────────────────
    # Same stubbed failure (mesh-ss-connections exits 2) driven twice, differing ONLY in the local
    # egress probe, must produce two DIFFERENT claims. Stub ping+tailscale on PATH.
    cat >"$td/bin/fail-conn" <<'EOF'
#!/bin/sh
exit 2
EOF
    mkdir -p "$td/failbin" "$td/probe"
    cp "$td/bin/fail-conn" "$td/failbin/mesh-ss-connections"; chmod +x "$td/failbin/mesh-ss-connections"
    cat >"$td/probe/ping" <<'EOF'
#!/bin/sh
echo "--- stub ping statistics ---"
echo "2 packets transmitted, ${STUB_RX:-2} received, ${STUB_LOSS:-0}% packet loss, time 1000ms"
[ "${STUB_LOSS:-0}" = 100 ] && exit 1 || exit 0
EOF
    cat >"$td/probe/tailscale" <<'EOF'
#!/bin/sh
printf '{"BackendState":"%s","Self":{"Online":%s}}\n' "${STUB_TS_STATE:-Running}" "${STUB_TS_ONLINE:-true}"
EOF
    chmod +x "$td/probe/ping" "$td/probe/tailscale"
    cst="$(stat -c %Y "$c")"
    # ── the failure legs ────────────────────────────────────────────────────────────────────────
    # _fail <label> <stub-stderr|NONE> <extra-env...> then assert with _want/_wantnot on $FOUT.
    # The stub ALWAYS exits 2 (the ssh-read failure); what varies is the attribution it hands back.
    _fail() { # <stub-stderr-or-NONE> <env-assignments...>
      local se="$1"; shift
      if [ "$se" = NONE ]; then printf '#!/bin/sh\nexit 2\n' >"$td/failbin/mesh-ss-connections"
      else printf '#!/bin/sh\necho "%s" >&2\nexit 2\n' "$se" >"$td/failbin/mesh-ss-connections"; fi
      chmod +x "$td/failbin/mesh-ss-connections"
      FOUT="$(env "$@" PATH="$td/probe:$PATH" MESH_HOME="$td/home/.mesh" \
              MESH_SS_CONN_DIR="$td/failbin" bash "$SELF" 2>&1 || true)"
      # asserted per-arm, not once over a concatenation: every failure leg owes a timestamped line of
      # its OWN, and gluing them would leave every arm but the first unanchored to `^`.
      printf '%s\n' "$FOUT" | grep -qE '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z	mesh-ss-clients: ' \
        || { rm -rf "$td"; echo "smoke-test: FAIL (failure line not timestamped: $FOUT)"; exit 1; }
    }
    # `if !` form, never `grep && { exit 1; }`: this block runs under `set -e` (line 49), where a
    # trailing && list that evaluates false takes the whole suite down as a pass.
    _want()    { if ! printf '%s' "$FOUT" | grep -q "$1"; then rm -rf "$td"; echo "smoke-test: FAIL ($2: expected /$1/, got: $FOUT)"; exit 1; fi; }
    _wantnot() { if printf '%s' "$FOUT" | grep -q "$1"; then rm -rf "$td"; echo "smoke-test: FAIL ($2: must NOT match /$1/, got: $FOUT)"; exit 1; fi; }

    # (A) THE REGRESSION THIS FIX EXISTS FOR. Child gives no attribution, local egress reads UP on
    # both legs. That pair is `.Self.Online` + an ICMP probe — the exact evidence that was green on
    # 2026-08-20 while the transport was dead — so it may NOT name the peer, however healthy it looks.
    _fail NONE
    _wantnot 'phaedra' "no-token + egress up"
    _want 'no tsp= token' "no-token + egress up"
    _want 'fact about US only' "no-token + egress up"
    _want 'net=up' "no-token + egress up must still quote its own probe"

    # (B) same missing attribution, local egress DOWN: still unattributed, still no peer — but the
    # context clause must report the DIFFERENT local reading, or the two arms are one arm.
    _fail NONE STUB_LOSS=100 STUB_RX=0 STUB_TS_ONLINE=false
    _wantnot 'phaedra' "no-token + egress down"
    _want 'reads down' "no-token + egress down"

    # (C) partial local probe (net up, tailscale offline) — a third distinct reading, still no peer.
    _fail NONE STUB_TS_ONLINE=false
    _wantnot 'phaedra' "no-token + partial probe"
    _want 'reads degraded' "no-token + partial probe"

    # (D-G) THE RELAY. Four tokens, four claims, and the tool must carry the child's verdict rather
    # than mint one. The `down` arm is the no-true-positive-regression arm: naming phaedra is still
    # allowed — but only on the child's PROVEN evidence, never on our own self-report.
    _fail "mesh-ss-connections: FAIL — phaedra reachable at the tailscale layer but the ssh/ss-server read failed (tsp=up|ping answered)"
    _want 'ssh/ss-server read failed' "relay tsp=up"
    _want 'relaying ITS attribution' "relay tsp=up"
    _wantnot 'unreachable' "relay tsp=up must not invent a peer verdict"

    _fail "mesh-ss-connections: FAIL — phaedra unreachable (tsp=down(control=Redmi 10)|silent but control answered)"
    _want 'phaedra unreachable' "relay tsp=down (no true-positive regression)"
    _want 'control answered' "relay tsp=down must carry the proving detail"

    _fail "mesh-ss-connections: FAIL — NO READING, layer unattributed: our own tailscale path is unproven, so this is NOT a claim about phaedra (tsp=unknown|no tailscale peer answered)"
    _want 'NOT a claim about phaedra' "relay tsp=unknown"
    _wantnot 'phaedra unreachable' "relay tsp=unknown must not name the peer"

    _fail "mesh-ss-connections: FAIL — ssh to phaedra failed and the transport could not be probed (tsp=absent|mesh-vpn-health --peer-transport unavailable): layer unattributed"
    _want 'layer unattributed' "relay tsp=absent"
    _wantnot 'phaedra unreachable' "relay tsp=absent must not name the peer"

    # (I) AN UNKNOWN VERDICT WORD IS NOT IN THIS READER'S ALPHABET. A child that grows a fifth token
    # must NOT have it relayed as though we understood it — a relay is this tool asserting the child's
    # claim in its own log, and asserting a word you cannot interpret is worse than abstaining.
    _fail "mesh-ss-connections: FAIL — something new (tsp=banana|a verdict this build has never heard of)"
    _want 'no tsp= token' "unknown verdict word must not be relayed"
    _wantnot 'relaying ITS attribution' "unknown verdict word must not be relayed"

    # (J) THE VERDICT IS THE TOKEN THE LINE OPENED WITH, not any token its free text happens to quote
    # — the same positional rule the promise ledger learned when a verdict's prose quoted another
    # record's fields. Known token first, garbage token in the detail: the KNOWN one must win.
    _fail "mesh-ss-connections: FAIL — phaedra unreachable (tsp=down|silent, unlike the earlier tsp=banana)"
    _want 'phaedra unreachable' "first token wins over one quoted in the detail"
    _want 'relaying ITS attribution' "first token wins over one quoted in the detail"

    # (H) THE TOKEN IS THE PREDICATE, NOT THE PROSE. A child line that reads exactly like the old
    # peer-blaming sentence but carries NO token must fall to the unattributed arm — otherwise this
    # tool is keyed on a sentence and an old build's wording walks straight through it.
    _fail "mesh-ss-connections: FAIL — cannot reach phaedra or ss-server"
    _want 'no tsp= token' "untokened prose is not an attribution"
    _wantnot 'relaying ITS attribution' "untokened prose must not be relayed as a verdict"

    # not one of the eight legs touched the cache
    [ "$(stat -c %Y "$c")" = "$cst" ] || { rm -rf "$td"; echo "smoke-test: FAIL (failure branch clobbered the cache)"; exit 1; }
    rm -rf "$td"
    echo "smoke-test: ok (per-client geo+flows+status, aggregate dest rDNS, timestamped success line with counts; the peer is named ONLY by relaying the child's tsp= token — 10 failure legs: 3 untokened local readings + 4 relayed tokens + prose-is-not-a-verdict + unknown-word-is-not-in-the-alphabet + first-token-wins — cache untouched on all)"
    exit 0 ;;
  "") : ;;  # refresh path
  *) echo "usage: $0 [--show|--test]" >&2; exit 2 ;;
esac

# ── core: bash harvests JSON + status, python enriches + caches ──
# respect an explicit MESH_SS_CONN_DIR (the --test stub); else prefer the deployed tool, else same-dir
# (so a genome-only PATH still finds mesh-ss-connections).
if [ -n "${MESH_SS_CONN_DIR:-}" ]; then
  CONN_DIR="$MESH_SS_CONN_DIR"
elif command -v mesh-ss-connections >/dev/null 2>&1; then
  CONN_DIR="$(dirname "$(command -v mesh-ss-connections)")"
else
  CONN_DIR="$(dirname "$SELF")"
fi
ts_now() { date -u +%Y-%m-%dT%H:%M:%SZ; }
say()  { printf '%s\tmesh-ss-clients: %s\n' "$(ts_now)" "$1"; }
sayerr(){ printf '%s\tmesh-ss-clients: %s\n' "$(ts_now)" "$1" >&2; }

# local_egress → "<verdict>|<detail>" where verdict is up|down (up ONLY if BOTH legs are up).
# Two independent legs so one flaky probe cannot mint a peer verdict:
#   net = ICMP to a third party (the same axis mesh-egress-health watches; 100% loss / unparseable
#         stats = we are off the air), ts = tailscaled's own view (BackendState + Self.Online), which
#         is the transport ssh phaedra actually rides.
# Anything that is not a clean both-up reads as "cannot reach anything from here" and MUST NOT name a
# peer — an unknown leg is blindness about US, never evidence about THEM.
local_egress() {
  local loss net ts_state ts_online tsleg
  loss="$(ping -c 2 -W 2 -q "${MESH_SS_PROBE_HOST:-1.1.1.1}" 2>/dev/null | sed -n 's/.*[, ]\([0-9]\{1,3\}\)% packet loss.*/\1/p' | head -1 || true)"
  case "$loss" in
    ''|*[!0-9]*) net="net=unknown" ;;
    100)         net="net=down" ;;
    *)           net="net=up(loss=${loss}%)" ;;
  esac
  tsleg="ts=unknown"
  if command -v tailscale >/dev/null 2>&1; then
    ts_state="$(tailscale status --json --peers=false 2>/dev/null | jq -r '.BackendState // "?"' 2>/dev/null || true)"
    ts_online="$(tailscale status --json --peers=false 2>/dev/null | jq -r '.Self.Online // "?"' 2>/dev/null || true)"
    [ -n "$ts_state" ] || ts_state="?"; [ -n "$ts_online" ] || ts_online="?"
    tsleg="ts=${ts_state}/online=${ts_online}"
  fi
  # THREE verdicts, not two: "both legs up" and "both legs down" are claims we can make; ONE leg
  # failing is neither ("a shared observable cannot name the mechanism") — it is our own path in
  # doubt, which still forbids naming a peer but must NOT be reported as "cannot reach anything".
  case "$net:$tsleg" in
    net=up*:ts=Running/online=true) printf 'up|%s %s\n'       "$net" "$tsleg" ;;
    net=up*:*|*:ts=Running/online=true) printf 'degraded|%s %s\n' "$net" "$tsleg" ;;
    *)                              printf 'down|%s %s\n'     "$net" "$tsleg" ;;
  esac
}

# THE CHILD ALREADY ANSWERED "MAY WE NAME PHAEDRA?" — DO NOT ASK IT A SECOND TIME, AND NEVER FROM
# WORSE EVIDENCE. This block used to discard the child's stderr (`2>/dev/null`) and re-derive the
# attribution from local_egress alone, whose ts leg is `.Self.Online` — a LOCAL self-report by our own
# tailscaled. That is the precise signal that lied on 2026-08-20 (both legs green, the transport dead,
# the peer wrongly named), and it is why mesh-ss-connections grew `mesh-vpn-health --peer-transport`.
# So the egress-up arm here was naming phaedra on exactly the evidence the prover exists to overrule.
#
# Two ways to fix it and only one is right. Calling the prover ourselves would mean the SAME question
# probed TWICE, up to 40s apart, by two processes that then write disagreeing lines about one minute —
# the two-blind-observers failure this mesh has already paid for once. So: the process that made the
# probe owns the verdict, and we RELAY it. We key on its `tsp=` TOKEN, never on its prose, because a
# reader keyed on a sentence is a lint testing a different predicate than the parser.
#
# No token = the child failed BEFORE it could attribute (an old build, or a dep/usage failure where the
# ssh was never attempted). Asking the prover then would answer a question nobody asked, so that arm is
# LOUD and unattributed. local_egress survives only as context about US, explicitly labelled, and it
# may not name the peer in any arm — an unknown leg is blindness about us, never evidence about them.
_cerr_f="$(mktemp "${TMPDIR:-/tmp}/mesh-ss-clients.conn-err.XXXXXX")"
SSJSON="$("$CONN_DIR/mesh-ss-connections" --json 2>"$_cerr_f")" || {
  # exit 2 = the ssh read failed: do NOT clobber the cache (dash keeps last good, aged).
  _cerr="$(tr '\n' ' ' <"$_cerr_f" 2>/dev/null | sed 's/[[:space:]]*$//')"; rm -f "$_cerr_f"
  # first token only: `tsp=down(control=Redmi 10)` must read as `tsp=down`, and a detail string that
  # happens to quote another token must not outrank the verdict its own line opened with.
  # `|| true`: no token is the COMMON case this arm exists to handle (an old build, a dep failure),
  # and under `set -euo pipefail` a bare grep miss would kill the process before either arm ran —
  # the failure line would vanish entirely and the reflex would log nothing at all.
  _tok="$(printf '%s' "$_cerr" | grep -o 'tsp=[a-z]*' | head -1 || true)"
  case "$_tok" in
    tsp=up|tsp=down|tsp=unknown|tsp=absent)
      sayerr "mesh-ss-connections --json failed; relaying ITS attribution verbatim (that process made the transport probe — we do not re-derive one): ${_cerr} — cache untouched" ;;
    *)
      eg="$(local_egress)"
      sayerr "mesh-ss-connections --json failed with NO ${0##*/}-readable attribution (no tsp= token in: ${_cerr:-<no stderr>}) — layer unattributed, so this is NOT a claim about the peer; our own egress probe reads ${eg%%|*} (${eg#*|}) but that is a fact about US only; cache untouched" ;;
  esac
  exit 2
}
rm -f "$_cerr_f"
[ -n "$SSJSON" ] || { sayerr "empty dump (idle, ssh read OK) — cache untouched"; exit 0; }

set +e
SUMMARY="$(MESH_HOME="$M" MESH_SS_JSON="$SSJSON" python3 <<'PYEOF'
import os, sys, json, time, subprocess, urllib.request
M = os.environ.get('MESH_HOME') or os.path.expanduser('~/.mesh')
GEO = M + '/.ss-ip-geo.cache'; DNS = M + '/.ss-dns.cache'; OUT = M + '/.ss-clients.cache'
GEO_TTL = int(os.environ.get('MESH_SS_GEO_TTL', '604800'))
DNS_TTL = int(os.environ.get('MESH_SS_DNS_TTL', '86400'))
GEO_URL = os.environ.get('MESH_SS_GEO_URL', 'http://ip-api.com/json')
FIX = os.environ.get('MESH_SS_GEO_FIXTURE', '')   # hermetic --test: read <ip>.json/<ip>.ptr from here
now = int(time.time())

def load_cache(path):
    d = {}
    try:
        for ln in open(path):
            f = ln.rstrip('\n').split('\t')
            if len(f) >= 2:
                d[f[0]] = (f[1:], f[-1] if f[-1].isdigit() else '0')
    except Exception:
        pass
    return d

def save_cache(path, d, valcols):
    try:
        with open(path + '.tmp', 'w') as fh:
            for ip in sorted(d):
                cols, ts = d[ip]
                fh.write('\t'.join([ip] + cols[:valcols] + [ts]) + '\n')
        os.replace(path + '.tmp', path)
    except Exception:
        pass

geoc = load_cache(GEO)   # ip -> ([country,city,isp,as,class,reverse], ts)
dnsc = load_cache(DNS)   # ip -> ([hostname], ts)

def geo_of(ip):
    e = geoc.get(ip)
    if e and (now - int(e[1] or 0)) < GEO_TTL:
        return e[0]
    rec = ['-','-','-','-','-','-']
    try:
        if FIX:
            j = json.load(open(FIX + '/' + ip + '.json'))
        else:
            with urllib.request.urlopen(GEO_URL + '/' + ip + '?fields=status,country,city,isp,as,reverse,mobile,proxy,hosting', timeout=10) as r:
                j = json.loads(r.read().decode('utf-8', 'replace'))
        if j.get('status') == 'success':
            cls = 'hosting' if (j.get('hosting') or j.get('proxy')) else ('mobile' if j.get('mobile') else 'residential')
            rec = [j.get('country','-') or '-', j.get('city','-') or '-', (j.get('isp','-') or '-')[:22],
                   (j.get('as','-') or '-')[:18], cls, (j.get('reverse','-') or '-')]
    except Exception:
        rec = ['-','-','-','-','?','-']   # '?' = looked-up-but-failed (distinct from cached miss)
    geoc[ip] = (rec, str(now))
    return rec

def dns_of(ip):
    e = dnsc.get(ip)
    if e and (now - int(e[1] or 0)) < DNS_TTL:
        return e[0][0] if e[0] else ''
    host = ''
    try:
        if FIX:
            host = open(FIX + '/' + ip + '.ptr').read().strip()
        else:
            r = subprocess.run(['dig','+short','+time=2','+tries=1','-x',ip], capture_output=True, text=True, timeout=4)
            host = (r.stdout.strip().splitlines() or [''])[0].rstrip('.')
    except Exception:
        host = ''
    dnsc[ip] = ([host], str(now))
    return host

try:
    d = json.loads(os.environ.get('MESH_SS_JSON', ''))
except Exception:
    # rc=3: the ssh read SUCCEEDED and handed us garbage — a parser/producer fault, not blindness
    # and not a peer verdict. Distinct exit so the bash caller logs it as its own branch.
    print('unparseable JSON from mesh-ss-connections --json — cache untouched', file=sys.stderr)
    sys.exit(3)

conns = d.get('connections', [])
flows = {}; dests = {}
for c in conns:
    if c.get('type') == 'client':
        ip = c.get('client') or ''
        if ip and ip != '127.0.0.1':
            flows[ip] = flows.get(ip, 0) + 1
    elif c.get('type') == 'proxy':
        dst = c.get('dst') or ''
        if dst and not dst.startswith('127.') and dst != '38.49.216.141':
            dests[dst] = dests.get(dst, 0) + 1

# status from the JSON summary fields the reflex already classified
known = set((d.get('known_ips') or '').split())
breach = set((d.get('breach_ips') or '').split())
def status_of(ip):
    if ip in known: return 'KNOWN'
    if ip in breach: return 'BREACH'
    return 'unknown-friend'

lines = ['# updated ' + str(now)]
for ip in sorted(flows, key=lambda x: -flows[x]):
    g = geo_of(ip)
    # C \t ip \t flows \t country \t city \t isp \t as \t class \t status
    lines.append('\t'.join(['C', ip, str(flows[ip]), g[0], g[1], g[2], g[3], g[4], status_of(ip)]))

top = sorted(dests, key=lambda x: -dests[x])[:8]
for ip in top:
    h = dns_of(ip)
    lines.append('\t'.join(['D', ip, str(dests[ip]), h or '-']))

tmp = OUT + '.tmp'
with open(tmp, 'w') as fh:
    fh.write('\n'.join(lines) + '\n')
os.replace(tmp, OUT)
save_cache(GEO, geoc, 6)
save_cache(DNS, dnsc, 1)

# the SUCCESS artifact line (bash timestamps + prints it). Carries the counts the cache actually
# got, so a "green" run that harvested nothing is visible as 0 clients instead of looking identical
# to a healthy one.
nclients = sum(1 for l in lines if l.startswith('C\t'))
print('ok — %d client(s), %d destination(s), %d flow(s) → cache written'
      % (nclients, len(top), sum(flows.values())))
PYEOF
)"
PRC=$?
set -e
if [ "$PRC" -ne 0 ]; then
  sayerr "cache write FAILED (enrich rc=$PRC; ssh read was OK) — cache untouched"
  exit 1
fi
say "${SUMMARY:-ok — cache written (no summary emitted)}"
