#!/usr/bin/env bash
# orphan-ok: on-demand cross-sense advisory — a consumer (occupancy/activity fusion, the senses mind,
#            a craft-room presence check) calls it to attribute a magnetic disturbance on the fixed
#            Note3 body. Reads the two cached upstream states cheaply (no re-sensing); both upstream
#            senses already run on cron (note3-mag 1-59/5, note3-motion 4-59/5). Writes
#            .note3-magevent.state every run (mtime always fresh → no change-gate false-STALE).
#
# mesh-note3-magevent — CROSS-SENSE FUSION: magnetometer DISTURBANCE × accelerometer MOTION on the
# fixed Note3 craft-room body → attribute a magnetic event to the ENVIRONMENT vs the SENSOR being
# handled. One derived signal neither sensor gives alone.
#
# THE GAP: mesh-note3-mag emits STABLE/DISTURBED/FROZEN for the AK09911C magnetometer; mesh-note3-motion
# emits STILL/MOVED for the MPU6500 accelerometer. But a magnetometer reading changes for TWO physically
# different reasons that mag ALONE cannot separate:
#   (a) the FIELD genuinely changed around a stationary sensor — a nearby motor/transformer switched
#       (fridge compressor, fan, power tool), or a door-magnet contact moved: a real AMBIENT event.
#   (b) the SENSOR ITSELF moved/rotated — which rotates the Earth's ~50µT field vector in the sensor
#       frame and reads as a large delta: a sensor-frame ARTIFACT, NOT an environment event.
# The accelerometer is the discriminator: mag-DISTURBED while the phone is STILL isolates (a) from (b).
# This gives a passive, camera-/mic-free craft-room APPLIANCE/CONTACT-ACTIVITY signal — a JOINT read no
# single input reaches: mag can't tell env from handling; motion can't see the field at all.
#
# INPUTS (cheap — read the two cached derived states, no adb re-sense):
#   MAG    .note3-mag-state field-1 verdict → DISTURBED / QUIET(STABLE|INIT) / FROZEN(HAL stuck, blind)
#          / UNKNOWN(file missing|stale). FROZEN and stale BOTH mean "no trustworthy magnetic read".
#   MOTION .note3-motion-state field-1 verdict → STILL / MOVED / UNKNOWN(INIT|missing|stale).
#
# VERDICTS (the env-vs-handling split is the synergy — un-derivable from either leg alone):
#   QUIET      mag not disturbed (STABLE) → no magnetic event to attribute (motion irrelevant).
#   ENV-EVENT  mag DISTURBED + phone STILL → the field changed around a stationary sensor: a real
#              ambient magnetic event (appliance/motor on-off, door-magnet contact).
#   HANDLED    mag DISTURBED + phone MOVED → the disturbance is a sensor-frame artifact from the phone
#              being moved/rotated; NOT an environment event.
#   AMBIG      mag DISTURBED but motion UNKNOWN → a magnetic event is real but UN-attributable (the
#              discriminator leg is blind) — honestly distinct from ENV-EVENT, never guessed as one.
#   UNKNOWN    mag leg not assessable (state missing/stale, or HAL FROZEN) → cannot say; exit 2. Never
#              a silent QUIET all-clear ([[fusion-tools-distinguish-empty-from-failed]]). The reason
#              names WHY (stale vs frozen) so a degraded read is visibly distinct from a calm one.
#
# HONEST-DEGRADE: an UNREACHABLE Note3 body ages BOTH state files past FRESH_S → mag UNKNOWN → verdict
# UNKNOWN exit 2 (mesh-land treats exit 2 as an honest n/a pass). A blind motion leg with a real mag
# event renders AMBIG(partial), not a fabricated attribution.
#
#   mesh-note3-magevent            fold → one verdict + reason line
#   mesh-note3-magevent --json     machine-readable {verdict,partial,mag,motion,reason,ts}
#   mesh-note3-magevent --edge     emit ONLY on verdict change (stream/board consumer)
#   mesh-note3-magevent --test     assert the attribution truth-table + a live read (exit 2 = honest n/a)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

M="${MESH_DIR:-$HOME/.mesh}"
STATE="$M/.note3-magevent.state"
MAG_STATE="$M/.note3-mag-state"
MOTION_STATE="$M/.note3-motion-state"
FRESH_S="${MAGEVENT_FRESH_S:-900}"        # a state older than 3 upstream cron cycles (5min) is UNKNOWN
NOW="${MAGEVENT_NOW:-$(date +%s)}"

# ---- pure attribution: the whole fusion logic in one testable function ----------------------------
# args: mag(DISTURBED|QUIET|FROZEN|UNKNOWN)  motion(STILL|MOVED|UNKNOWN)
# echoes: "<VERDICT> <partial:0|1>"
attribute() {
  local mag="$1" motion="$2" partial=0
  [ "$motion" = UNKNOWN ] && partial=1
  case "$mag" in
    UNKNOWN|FROZEN) echo "UNKNOWN 1"; return ;;
    QUIET)          echo "QUIET $partial"; return ;;
    DISTURBED)
      case "$motion" in
        STILL) echo "ENV-EVENT 0"; return ;;
        MOVED) echo "HANDLED 0"; return ;;
        *)     echo "AMBIG 1"; return ;;
      esac ;;
  esac
  echo "UNKNOWN 1"
}

# ---- --test: exercise the attribution truth-table + a live read ----------------------------------
if [ "${1:-}" = "--test" ]; then
  fail=0
  chk() { # expected  mag motion
    local want="$1" got; got="$(attribute "$2" "$3")"
    [ "$got" = "$want" ] || { echo "  FAIL: attribute($2,$3) = '$got', want '$want'"; fail=1; }
  }
  # mag quiet → no event regardless of motion; motion-blind only flags partial
  chk "QUIET 0"     QUIET     STILL
  chk "QUIET 0"     QUIET     MOVED
  chk "QUIET 1"     QUIET     UNKNOWN
  # mag disturbed → the env-vs-handling split, gated by motion
  chk "ENV-EVENT 0" DISTURBED STILL
  chk "HANDLED 0"   DISTURBED MOVED
  chk "AMBIG 1"     DISTURBED UNKNOWN
  # mag not assessable → UNKNOWN, never a silent QUIET (honest-degrade core)
  chk "UNKNOWN 1"   FROZEN    STILL
  chk "UNKNOWN 1"   UNKNOWN   STILL
  chk "UNKNOWN 1"   UNKNOWN   UNKNOWN
  # a live read must yield a valid verdict (exit 0) OR honest n/a exit 2 (Note3 body unreachable)
  live="$("$0" --json 2>/dev/null)"; rc=$?
  if [ "$rc" -eq 0 ]; then
    v="$(printf '%s' "$live" | grep -oE '"verdict":"[A-Z-]+"' | head -1 | cut -d'"' -f4)"
    case "$v" in QUIET|ENV-EVENT|HANDLED|AMBIG|UNKNOWN) : ;;
      *) echo "smoke-test: FAIL (live verdict '$v' not in vocab)"; exit 1;; esac
    printf '%s' "$live" | grep -q '"reason":"..*"' || { echo "smoke-test: FAIL (empty reason)"; exit 1; }
    live_note="live read → $v"
  elif [ "$rc" -eq 2 ]; then
    live_note="live read → honest n/a (Note3 body unreachable, exit 2)"
  else
    echo "smoke-test: FAIL (live --json exit $rc)"; exit 1
  fi
  [ "$fail" -eq 0 ] || { echo "smoke-test: FAIL (attribution truth-table)"; exit 1; }
  echo "smoke-test: ok (9 attribution asserts + $live_note)"
  exit 0
fi

# ---- read_fresh <file> — echo first line if fresh, else empty (UNKNOWN caller-side) --------------
read_fresh() {
  local f="$1" mt
  [ -r "$f" ] || return 1
  mt="$(stat -c %Y "$f" 2>/dev/null || echo 0)"
  [ $(( NOW - mt )) -le "$FRESH_S" ] || return 1
  head -n1 "$f" 2>/dev/null
}

# ---- MAG leg: fine verdict from .note3-mag-state (field 1) ----------------------------------------
mag=UNKNOWN; mag_why="state missing/stale"
if [ -n "${MESH_MAGEVENT_MAG:-}" ]; then
  mag="$MESH_MAGEVENT_MAG"; mag_why="override"
else
  ml="$(read_fresh "$MAG_STATE" || true)"
  if [ -n "$ml" ]; then
    mv="$(printf '%s' "$ml" | cut -d'|' -f1)"
    case "$mv" in
      DISTURBED)    mag=DISTURBED; mag_why="$mv" ;;
      STABLE|INIT)  mag=QUIET;     mag_why="$mv" ;;
      FROZEN)       mag=FROZEN;    mag_why="HAL FROZEN (no fresh magnetic tick — sense blind)" ;;
      *)            mag=UNKNOWN;   mag_why="unrecognized verdict '$mv'" ;;
    esac
  fi
fi

# ---- MOTION leg: verdict from .note3-motion-state (field 1) ---------------------------------------
motion=UNKNOWN; motion_why="state missing/stale"
if [ -n "${MESH_MAGEVENT_MOTION:-}" ]; then
  motion="$MESH_MAGEVENT_MOTION"; motion_why="override"
else
  ol="$(read_fresh "$MOTION_STATE" || true)"
  if [ -n "$ol" ]; then
    ov="$(printf '%s' "$ol" | cut -d'|' -f1)"
    case "$ov" in
      MOVED) motion=MOVED; motion_why="$ov" ;;
      STILL) motion=STILL; motion_why="$ov" ;;
      *)     motion=UNKNOWN; motion_why="verdict '$ov' (not STILL/MOVED)" ;;
    esac
  fi
fi

# ---- fold -----------------------------------------------------------------------------------------
read verdict partial <<<"$(attribute "$mag" "$motion")"
partial_tag=""; [ "$partial" -eq 1 ] && partial_tag=" (partial)"

case "$verdict" in
  QUIET)     reason="Note3 magnetometer QUIET ($mag_why) — no magnetic event to attribute [motion=$motion]" ;;
  ENV-EVENT) reason="magnetometer DISTURBED while phone STILL — a real AMBIENT magnetic event (appliance/motor on-off or door-magnet contact near the fixed Note3), not sensor handling" ;;
  HANDLED)   reason="magnetometer DISTURBED but phone MOVED — the field delta is a sensor-frame artifact (phone rotated/handled), NOT an environment event" ;;
  AMBIG)     reason="magnetometer DISTURBED but motion leg blind ($motion_why) — a real magnetic event that cannot be attributed to environment vs handling" ;;
  UNKNOWN)   reason="cannot assess magnetic events — mag leg: $mag_why; motion leg: $motion_why" ;;
esac

ts="$(date -u +%FT%TZ 2>/dev/null || echo "$NOW")"

# persist (unconditionally every run → mtime always fresh, no change-gate false-STALE)
printf '%s%s | mag=%s motion=%s | %s\n' "$verdict" "$partial_tag" "$mag" "$motion" "$ts" > "$STATE"

if [ "${1:-}" = "--json" ]; then
  printf '{"verdict":"%s","partial":%s,"mag":"%s","motion":"%s","reason":"%s","ts":"%s"}\n' \
    "$verdict" "$partial" "$mag" "$motion" "$reason" "$ts"
  [ "$verdict" = UNKNOWN ] && exit 2 || exit 0
fi

if [ "${1:-}" = "--edge" ]; then
  prev_f="$M/.note3-magevent.verdict"
  prev="$(cat "$prev_f" 2>/dev/null || true)"
  printf '%s' "$verdict" > "$prev_f"
  [ "$verdict" = "$prev" ] && { [ "$verdict" = UNKNOWN ] && exit 2 || exit 0; }
  printf '[magevent] %s%s — %s\n' "$verdict" "$partial_tag" "$reason"
  [ "$verdict" = UNKNOWN ] && exit 2 || exit 0
fi

printf '%s%s — %s\n' "$verdict" "$partial_tag" "$reason"
[ "$verdict" = UNKNOWN ] && exit 2 || exit 0
