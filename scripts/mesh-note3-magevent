#!/usr/bin/env bash
# orphan-ok: on-demand cross-sense advisory — a consumer (occupancy/activity fusion, the senses mind,
#            a craft-room presence check) calls it to attribute a magnetic disturbance on the fixed
#            Note3 body. Reads the two cached upstream states cheaply (no re-sensing); both upstream
#            senses already run on cron (note3-mag 1-59/5, note3-motion 4-59/5). Writes
#            .note3-magevent.state every run (mtime always fresh → no change-gate false-STALE).
#
# mesh-note3-magevent — CROSS-SENSE FUSION: magnetometer DISTURBANCE × accelerometer MOTION on the
# fixed Note3 craft-room body → attribute a magnetic event to the ENVIRONMENT vs the SENSOR being
# handled. One derived signal neither sensor gives alone.
#
# THE GAP: mesh-note3-mag emits STABLE/DISTURBED/FROZEN for the AK09911C magnetometer; mesh-note3-motion
# emits STILL/MOVED for the MPU6500 accelerometer. But a magnetometer reading changes for TWO physically
# different reasons that mag ALONE cannot separate:
#   (a) the FIELD genuinely changed around a stationary sensor — a nearby motor/transformer switched
#       (fridge compressor, fan, power tool), or a door-magnet contact moved: a real AMBIENT event.
#   (b) the SENSOR ITSELF moved/rotated — which rotates the Earth's ~50µT field vector in the sensor
#       frame and reads as a large delta: a sensor-frame ARTIFACT, NOT an environment event.
# The accelerometer is the discriminator: mag-DISTURBED while the phone is STILL isolates (a) from (b).
# This gives a passive, camera-/mic-free craft-room APPLIANCE/CONTACT-ACTIVITY signal — a JOINT read no
# single input reaches: mag can't tell env from handling; motion can't see the field at all.
#
# INPUTS (cheap — read the two cached derived states, no adb re-sense):
#   MAG    .note3-mag-state field-1 verdict → DISTURBED / QUIET(STABLE|INIT) / FROZEN(HAL stuck, blind)
#          / UNKNOWN(file missing|stale). FROZEN and stale BOTH mean "no trustworthy magnetic read".
#   MOTION .note3-motion-state field-1 verdict → STILL / MOVED / UNKNOWN(INIT|missing|stale).
#
# VERDICTS (the env-vs-handling split is the synergy — un-derivable from either leg alone):
#   QUIET      mag not disturbed (STABLE) → no magnetic event to attribute (motion irrelevant).
#   ENV-EVENT  mag DISTURBED + phone STILL → the field changed around a stationary sensor: a real
#              ambient magnetic event (appliance/motor on-off, door-magnet contact).
#   HANDLED    mag DISTURBED + phone MOVED → the disturbance is a sensor-frame artifact from the phone
#              being moved/rotated; NOT an environment event.
#   AMBIG      mag DISTURBED but motion UNKNOWN → a magnetic event is real but UN-attributable (the
#              discriminator leg is blind) — honestly distinct from ENV-EVENT, never guessed as one.
#   BLIND      mag leg REACHABLE but not seeing (HAL FROZEN) → an ASSESSED, DEGRADED verdict; exit 0.
#   UNKNOWN    mag leg has no fresh upstream at all (state missing/stale) → n/a; exit 2. Never a
#              silent QUIET all-clear ([[fusion-tools-distinguish-empty-from-failed]]).
#
# A BLIND SENSE AND AN ABSENT ONE ARE DIFFERENT CLAIMS AND MUST NOT SHARE AN EXIT CODE (2026-07-15).
# Both used to fold to "UNKNOWN, exit 2" — and land/doctor read exit 2 as "this node lacks the organ",
# i.e. a PASS. So a Note3 that was REACHABLE AND PRODUCING while its magnetometer saw nothing reported
# its own 4h+ blindness to every gate as a capability gap. The sense's regression WAS its alibi
# ([[na-must-be-a-claim-about-the-node]]). This is not hypothetical: mag is FROZEN in 231/239 polls
# (96.7%) because dumpsys shows 0 listeners registered for AK09911C, so the FROZEN→exit-2 branch is
# the steady state, not the edge case — which also made --test's exit-0 branch (the ONLY place the
# verdict vocab and non-empty reason are asserted) dead code in practice.
#
# REACHABILITY IS ALREADY DECIDED UPSTREAM — DO NOT ADD A PROBE HERE. mesh-note3-mag:276 exits 2 on
# UNREACHABLE *before* it writes .note3-mag-state at :294, so the file is only ever written by a poll
# whose adb dumpsys read SUCCEEDED. Therefore a FRESH .note3-mag-state IS the proof of reachability,
# and FROZEN-in-a-fresh-file means "the body answered; the HAL cache is stuck" — reachable + blind.
# An unreachable body writes nothing → the file ages past FRESH_S → mag=UNKNOWN → exit 2, still honest.
# Re-probing adb here would be a SECOND definition of a fact the dataflow already carries (and would
# drift from it); the fix is to stop collapsing the two, not to re-measure.
#
# HONEST-DEGRADE: an UNREACHABLE Note3 body ages BOTH state files past FRESH_S → mag UNKNOWN → verdict
# UNKNOWN exit 2 (mesh-land treats exit 2 as an honest n/a pass). A blind motion leg with a real mag
# event renders AMBIG(partial), not a fabricated attribution.
#
#   mesh-note3-magevent            fold → one verdict + reason line
#   mesh-note3-magevent --json     machine-readable {verdict,partial,mag,motion,reason,ts}
#   mesh-note3-magevent --edge     emit ONLY on verdict change (stream/board consumer)
#   mesh-note3-magevent --test     assert the attribution truth-table + the exit-code split + a live read
#
# Exit: 0 = assessed (QUIET/ENV-EVENT/HANDLED/AMBIG/BLIND) · 2 = n/a, no fresh mag upstream (honest).
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

M="${MESH_DIR:-$HOME/.mesh}"
STATE="$M/.note3-magevent.state"
MAG_STATE="$M/.note3-mag-state"
MOTION_STATE="$M/.note3-motion-state"
FRESH_S="${MAGEVENT_FRESH_S:-900}"        # a state older than 3 upstream cron cycles (5min) is UNKNOWN
NOW="${MAGEVENT_NOW:-$(date +%s)}"

# ---- pure attribution: the whole fusion logic in one testable function ----------------------------
# args: mag(DISTURBED|QUIET|FROZEN|UNKNOWN)  motion(STILL|MOVED|UNKNOWN)
# echoes: "<VERDICT> <partial:0|1>"
# FROZEN and UNKNOWN are DIFFERENT CLAIMS (see header): FROZEN = the body answered but the HAL cache is
# stuck (reachable + blind → BLIND, exit 0, assessed); UNKNOWN = no fresh upstream at all (→ exit 2, n/a).
# They arrive here already distinguished — this function used to collapse them on one line, which is
# what laundered a blind sense into a green pass. Keep them apart.
attribute() {
  local mag="$1" motion="$2" partial=0
  [ "$motion" = UNKNOWN ] && partial=1
  case "$mag" in
    UNKNOWN)        echo "UNKNOWN 1"; return ;;
    FROZEN)         echo "BLIND 1";   return ;;
    QUIET)          echo "QUIET $partial"; return ;;
    DISTURBED)
      case "$motion" in
        STILL) echo "ENV-EVENT 0"; return ;;
        MOVED) echo "HANDLED 0"; return ;;
        *)     echo "AMBIG 1"; return ;;
      esac ;;
  esac
  echo "UNKNOWN 1"
}

# ---- exit_for_verdict <verdict> — THE ONE definition of the exit-code contract -------------------
# exit 2 is RESERVED for "n/a — no fresh mag upstream" (UNKNOWN). Every ASSESSED verdict exits 0,
# including BLIND: land/doctor read exit 2 as "this node lacks the organ", so routing a blind-but-
# reachable sense through it laundered a live regression into a pass. This rule was copy-pasted at
# FOUR exit sites (--json, --edge dedup, --edge emit, bare) and the 2026-07-15 gate drove only --json
# — a mutation that restored the bug on the BARE path sailed through green. One definition, four
# call sites, and --test drives every surface.
exit_for_verdict() {
  [ "$1" = UNKNOWN ] && exit 2
  exit 0
}

# ---- --test: exercise the attribution truth-table + a live read ----------------------------------
if [ "${1:-}" = "--test" ]; then
  fail=0
  chk() { # expected  mag motion
    local want="$1" got; got="$(attribute "$2" "$3")"
    [ "$got" = "$want" ] || { echo "  FAIL: attribute($2,$3) = '$got', want '$want'"; fail=1; }
  }
  # mag quiet → no event regardless of motion; motion-blind only flags partial
  chk "QUIET 0"     QUIET     STILL
  chk "QUIET 0"     QUIET     MOVED
  chk "QUIET 1"     QUIET     UNKNOWN
  # mag disturbed → the env-vs-handling split, gated by motion
  chk "ENV-EVENT 0" DISTURBED STILL
  chk "HANDLED 0"   DISTURBED MOVED
  chk "AMBIG 1"     DISTURBED UNKNOWN
  # mag REACHABLE but blind (HAL FROZEN) → BLIND, an assessed degraded verdict — NOT the n/a UNKNOWN.
  # This row is the regression gate: collapsing it back to "UNKNOWN 1" is the 2026-07-15 bug verbatim.
  chk "BLIND 1"     FROZEN    STILL
  chk "BLIND 1"     FROZEN    MOVED
  chk "BLIND 1"     FROZEN    UNKNOWN
  # mag leg has no upstream at all → UNKNOWN, never a silent QUIET (honest-degrade core)
  chk "UNKNOWN 1"   UNKNOWN   STILL
  chk "UNKNOWN 1"   UNKNOWN   UNKNOWN

  # ── the EXIT-CODE split, driven end-to-end on the REAL script (the truth-table above is pure; only
  # a real drive proves the code that consumers actually see). Each leg runs in a throwaway MESH_DIR so
  # the test NEVER writes the real .note3-magevent.state — a --test that writes the artifact a consumer
  # reads for liveness forges the evidence it exists to check (mesh-guardian, 09f7914). Needs no hardware.
  _td="$(mktemp -d)"; trap 'rm -rf "$_td"' EXIT
  drive() { # <name> <want_rc> <want_verdict> [env...]  → runs $0 --json in a clean MESH_DIR
    local name="$1" want_rc="$2" want_v="$3"; shift 3
    local out rc v; mkdir -p "$_td/$name"
    out="$(env MESH_DIR="$_td/$name" "$@" "$0" --json 2>/dev/null)"; rc=$?
    v="$(printf '%s' "$out" | grep -oE '"verdict":"[A-Z-]+"' | head -1 | cut -d'"' -f4)"
    [ "$rc" = "$want_rc" ] || { echo "  FAIL: $name → rc=$rc, want $want_rc (verdict '$v')"; fail=1; }
    [ "$v" = "$want_v" ] || { echo "  FAIL: $name → verdict '$v', want '$want_v'"; fail=1; }
    # every assessed verdict must carry a non-empty reason — this branch used to be dead code
    printf '%s' "$out" | grep -q '"reason":"..*"' || { echo "  FAIL: $name → empty reason"; fail=1; }
  }
  # a reachable+quiet sense assesses cleanly → rc 0
  drive quiet 0 QUIET       MESH_MAGEVENT_MAG=QUIET  MESH_MAGEVENT_MOTION=STILL
  # a reachable+BLIND sense is ASSESSED (rc 0), and must NOT read as n/a to land/doctor. Before the
  # 2026-07-15 fix this leg was rc=2/UNKNOWN — i.e. "this node lacks the organ" — while the body was up.
  drive blind 0 BLIND       MESH_MAGEVENT_MAG=FROZEN MESH_MAGEVENT_MOTION=STILL
  # exit 2 is RESERVED for a genuine absence: empty MESH_DIR, no overrides → no fresh upstream at all.
  drive absent 2 UNKNOWN    MESH_MAGEVENT_MOTION=STILL
  # the two must be DISTINGUISHABLE — same blind leg, opposite exit codes vs the absent one (2/2)
  printf '%s' "$(env MESH_DIR="$_td/blind" MESH_MAGEVENT_MAG=FROZEN "$0" --json 2>/dev/null)" \
    | grep -q '"verdict":"BLIND"' || { echo "  FAIL: blind and absent are not separable"; fail=1; }

  # ── EVERY SURFACE, not just --json. The exit rule had four copy-pasted sites and the first cut of
  # this gate drove only --json — a mutation restoring the bug on the BARE path passed green. A rule
  # asserted at one of its call sites is not asserted. --edge is driven twice: the second call takes
  # the dedup branch (verdict unchanged), which carries its own exit and is otherwise never covered.
  surf() { # <surface|""=bare> <mag> <want_rc>
    # NB: bash expands every arg to `local` BEFORE assigning any, so `d=...$mag` here would read the
    # not-yet-set GLOBAL mag and trip set -u. Reference $2 directly.
    local s="$1" mag="$2" want="$3" d="$_td/surf${1:-bare}-$2" rc; mkdir -p "$d"
    _run() { if [ -n "$s" ]; then env MESH_DIR="$d" MESH_MAGEVENT_MAG="$mag" MESH_MAGEVENT_MOTION=STILL "$0" "$s" >/dev/null 2>&1
             else            env MESH_DIR="$d" MESH_MAGEVENT_MAG="$mag" MESH_MAGEVENT_MOTION=STILL "$0"      >/dev/null 2>&1; fi; }
    _run; rc=$?
    [ "$rc" = "$want" ] || { echo "  FAIL: surface '${s:-bare}' mag=$mag → rc=$rc, want $want"; fail=1; }
    if [ "$s" = --edge ]; then   # second call → dedup branch (same verdict) must exit the same way
      _run; rc=$?
      [ "$rc" = "$want" ] || { echo "  FAIL: surface --edge dedup mag=$mag → rc=$rc, want $want"; fail=1; }
    fi
  }
  for _s in "" --json --edge; do
    surf "$_s" FROZEN 0    # BLIND is assessed → 0 on every surface
    surf "$_s" QUIET  0    # plainly assessed  → 0
    surf "$_s" UNKNOWN 2   # genuine n/a       → 2 on every surface
  done

  # ── live read: report ONLY what was actually observed. The old test narrated rc=2 as "Note3 body
  # unreachable" without ever probing reachability — on this node that string was false on both halves
  # and doctor printed it hourly. Reads the REAL upstream states (symlinked in) but writes its own
  # STATE to the throwaway.
  mkdir -p "$_td/live"
  for _s in .note3-mag-state .note3-motion-state; do
    [ -r "$M/$_s" ] && ln -sf "$M/$_s" "$_td/live/$_s"
  done
  live="$(env MESH_DIR="$_td/live" "$0" --json 2>/dev/null)"; rc=$?
  v="$(printf '%s' "$live" | grep -oE '"verdict":"[A-Z-]+"' | head -1 | cut -d'"' -f4)"
  case "$rc" in
    0) case "$v" in QUIET|ENV-EVENT|HANDLED|AMBIG|BLIND) : ;;
         *) echo "smoke-test: FAIL (live verdict '$v' not in the exit-0 vocab)"; exit 1;; esac
       printf '%s' "$live" | grep -q '"reason":"..*"' || { echo "smoke-test: FAIL (empty reason)"; exit 1; }
       live_note="live read → $v (assessed)" ;;
    2) [ "$v" = UNKNOWN ] || { echo "smoke-test: FAIL (rc=2 with verdict '$v' — exit 2 must mean UNKNOWN)"; exit 1; }
       live_note="live read → n/a: no fresh mag upstream (state missing/stale). NOT a reachability claim — this test does not probe the body" ;;
    *) echo "smoke-test: FAIL (live --json exit $rc)"; exit 1 ;;
  esac
  [ "$fail" -eq 0 ] || { echo "smoke-test: FAIL (attribution truth-table / exit-code split)"; exit 1; }
  echo "smoke-test: ok (11 attribution asserts + 4 exit-code drives + $live_note)"
  exit 0
fi

# ---- read_fresh <file> — echo first line if fresh, else empty (UNKNOWN caller-side) --------------
read_fresh() {
  local f="$1" mt
  [ -r "$f" ] || return 1
  mt="$(stat -c %Y "$f" 2>/dev/null || echo 0)"
  [ $(( NOW - mt )) -le "$FRESH_S" ] || return 1
  head -n1 "$f" 2>/dev/null
}

# ---- MAG leg: fine verdict from .note3-mag-state (field 1) ----------------------------------------
mag=UNKNOWN; mag_why="state missing/stale"
if [ -n "${MESH_MAGEVENT_MAG:-}" ]; then
  mag="$MESH_MAGEVENT_MAG"; mag_why="override"
else
  ml="$(read_fresh "$MAG_STATE" || true)"
  if [ -n "$ml" ]; then
    mv="$(printf '%s' "$ml" | cut -d'|' -f1)"
    case "$mv" in
      DISTURBED)    mag=DISTURBED; mag_why="$mv" ;;
      STABLE|INIT)  mag=QUIET;     mag_why="$mv" ;;
      FROZEN)       mag=FROZEN;    mag_why="HAL FROZEN (no fresh magnetic tick — sense blind)" ;;
      *)            mag=UNKNOWN;   mag_why="unrecognized verdict '$mv'" ;;
    esac
  fi
fi

# ---- MOTION leg: verdict from .note3-motion-state (field 1) ---------------------------------------
motion=UNKNOWN; motion_why="state missing/stale"
if [ -n "${MESH_MAGEVENT_MOTION:-}" ]; then
  motion="$MESH_MAGEVENT_MOTION"; motion_why="override"
else
  ol="$(read_fresh "$MOTION_STATE" || true)"
  if [ -n "$ol" ]; then
    ov="$(printf '%s' "$ol" | cut -d'|' -f1)"
    case "$ov" in
      MOVED) motion=MOVED; motion_why="$ov" ;;
      STILL) motion=STILL; motion_why="$ov" ;;
      *)     motion=UNKNOWN; motion_why="verdict '$ov' (not STILL/MOVED)" ;;
    esac
  fi
fi

# ---- fold -----------------------------------------------------------------------------------------
read verdict partial <<<"$(attribute "$mag" "$motion")"
partial_tag=""; [ "$partial" -eq 1 ] && partial_tag=" (partial)"

case "$verdict" in
  QUIET)     reason="Note3 magnetometer QUIET ($mag_why) — no magnetic event to attribute [motion=$motion]" ;;
  ENV-EVENT) reason="magnetometer DISTURBED while phone STILL — a real AMBIENT magnetic event (appliance/motor on-off or door-magnet contact near the fixed Note3), not sensor handling" ;;
  HANDLED)   reason="magnetometer DISTURBED but phone MOVED — the field delta is a sensor-frame artifact (phone rotated/handled), NOT an environment event" ;;
  AMBIG)     reason="magnetometer DISTURBED but motion leg blind ($motion_why) — a real magnetic event that cannot be attributed to environment vs handling" ;;
  BLIND)     reason="Note3 body REACHABLE but the magnetic sense is BLIND ($mag_why) — a fresh mag state proves the adb poll succeeded, so this is an assessed DEGRADED read, NOT an absent organ: the sense is broken, not missing [motion=$motion]" ;;
  UNKNOWN)   reason="cannot assess magnetic events — no fresh mag upstream (body unreachable or the note3-mag reflex is not running) — mag leg: $mag_why; motion leg: $motion_why" ;;
esac

ts="$(date -u +%FT%TZ 2>/dev/null || echo "$NOW")"

# persist (unconditionally every run → mtime always fresh, no change-gate false-STALE)
printf '%s%s | mag=%s motion=%s | %s\n' "$verdict" "$partial_tag" "$mag" "$motion" "$ts" > "$STATE"

if [ "${1:-}" = "--json" ]; then
  printf '{"verdict":"%s","partial":%s,"mag":"%s","motion":"%s","reason":"%s","ts":"%s"}\n' \
    "$verdict" "$partial" "$mag" "$motion" "$reason" "$ts"
  exit_for_verdict "$verdict"
fi

if [ "${1:-}" = "--edge" ]; then
  prev_f="$M/.note3-magevent.verdict"
  prev="$(cat "$prev_f" 2>/dev/null || true)"
  printf '%s' "$verdict" > "$prev_f"
  [ "$verdict" = "$prev" ] && exit_for_verdict "$verdict"
  printf '[magevent] %s%s — %s\n' "$verdict" "$partial_tag" "$reason"
  exit_for_verdict "$verdict"
fi

printf '%s%s — %s\n' "$verdict" "$partial_tag" "$reason"
exit_for_verdict "$verdict"
