#!/usr/bin/env python3
"""mesh-census — measure the mesh's capability coverage, and its progress over time.

Extends mesh-minds: probes every tag:lte-node for the FULL capability surface across
classes (minds / senses / actuators / connectivity / compute), marks verified vs merely
detected, checks health + the per-node invariant, and appends a snapshot to PROGRESS.md
so the trajectory is legible. Progress = the delta between censuses.

BOUNDARY (enforced here): actuators are DETECTED (the verb exists), never FIRED. This
census never sends an SMS, places a call, blasts IR, or triggers mic/camera. Verification
is limited to no-side-effect probes (battery read, compute, connectivity).

Usage:
  mesh-census            # human report + append snapshot to PROGRESS.md
  mesh-census --json     # machine-readable
  mesh-census --no-log   # don't append to PROGRESS.md
  mesh-census --smooth [--lag K]   # fixed-lag RETROSPECTIVE pass over PROGRESS.md

SMOOTHING (the census is otherwise a pure FILTER). Each snapshot is computed from that
instant's observations alone and frozen; a node that was merely UNREACHABLE contributes 0
to the surface, so "progress = the delta between snapshots" records a capability LOSS that
the next census records as an equal GAIN. `--smooth` is the backward pass: it re-reads the
last K snapshots and, where a later census proves a dark node's capability set was unchanged
across the gap, appends a REVISION of the past surface. It never mutates a prior row — the
filtered row stays as the record of what was believed then.
"""
import json, os, re, subprocess, sys, concurrent.futures, datetime, shutil, getpass

def _source_nodes():
    """Source ~/.mesh/nodes into os.environ."""
    p = os.path.expanduser("~/.mesh/nodes")
    if not os.path.exists(p): return
    with open(p) as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith("#"): continue
            if "=" in line:
                k, v = line.split("=", 1)
                k, v = k.strip(), v.strip().strip('"').strip("'")
                if k and k not in os.environ: os.environ[k] = v

_source_nodes()

def _ssh_user(ip):
    """Per-node ssh user from the MESH_NODES registry ("label:user@ip ...") — peers carry
    different users (phaedra=root, router=root, ilya=ilya). Using a single $USER for all
    nodes mis-auths root@ peers → they're wrongly counted 'unreachable' (the census under-count).
    Fallback to $USER/getpass so an unset $USER (cron/supervise) never emits a bare '@ip'."""
    for tok in (os.environ.get("MESH_NODES", "") or "").split():
        spec = tok.split(":", 1)[-1]            # drop the label
        if "@" in spec:
            u, i = spec.split("@", 1)
            if i == ip and u:
                return u
    return os.environ.get("USER") or getpass.getuser()

def _role_by_ip(ip):
    """ip -> label (MESH_NODES) -> role (MESH_ROLES); default 'mind'. Lets the census label a
    reachable-but-bash-less gateway honestly ('gateway') instead of 'unreachable' (a BusyBox router
    has no bash for the `bash -ls` probe → 0 capabilities, but it IS up, not unreachable)."""
    label = None
    for tok in (os.environ.get("MESH_NODES", "") or "").split():
        if ":" in tok:
            lbl, spec = tok.split(":", 1)
            if "@" in spec and spec.split("@", 1)[1] == ip:
                label = lbl; break
    if not label:
        return "mind"
    roles = {}
    for r in (os.environ.get("MESH_ROLES", "") or "").split():
        if ":" in r:
            roles[r.split(":", 1)[0]] = r.split(":", 1)[1]
    return roles.get(label, "mind")

def _smoke_base():
    """Legs 1-3: the census base (unchanged since the tool was written)."""
    if not shutil.which('tailscale'):
        print("smoke-test: FAIL (tailscale missing)"); return 1
    if not shutil.which('ssh'):
        print("smoke-test: FAIL (ssh missing)"); return 1
    try:
        out = subprocess.run(["tailscale", "status", "--json"], capture_output=True, text=True, check=True).stdout
        d = json.loads(out)
        me = d.get("Self", {})
        host = me.get("HostName", "")
        ip = (me.get("TailscaleIPs") or [""])[0]
        if not host or not ip.startswith("100."):
            print(f"smoke-test: FAIL (bad self census base: {host}|{ip})"); return 1
    except Exception as e:
        print(f"smoke-test: FAIL (tailscale census base failed: {e})"); return 1
    return 0


AGENTS = ["claude", "opencode", "gemini", "codex", "aider", "llm", "ollama"]

# termux verbs (prefix 'termux-' stripped) -> capability class
SENSE = {"battery-status","camera-info","camera-photo","microphone-record","location","sensor",
         "telephony-cellinfo","telephony-deviceinfo","wifi-connectioninfo","wifi-scaninfo",
         "audio-info","nfc","fingerprint","speech-to-text","clipboard-get","contact-list",
         "sms-inbox","sms-list","call-log","infrared-frequencies","usb"}
ACTUATOR = {"tts-speak","sms-send","telephony-call","infrared-transmit","torch","vibrate",
            "notification","media-player","toast","volume","brightness","wifi-enable",
            "clipboard-set","share","open-url","wallpaper","download","dialog"}

SSH = ["-o","BatchMode=yes","-o","ConnectTimeout=8","-o","StrictHostKeyChecking=no","-o","LogLevel=ERROR"]
REPO_PROGRESS = os.path.expanduser(os.environ.get("MESH_CENSUS_PROGRESS") or "~/lte-workstation/PROGRESS.md")
SMOOTH_LAG = 10          # fixed-lag window, in censuses (Van de Maele et al. 2026 use 10 observations)
CLASSES = ("minds", "senses", "actuators", "connectivity")

LINUX_PROBE = (r'''
export PATH="$HOME/.local/bin:$PATH"
m=""
for a in ''' + " ".join(AGENTS) + r'''; do command -v "$a" >/dev/null 2>&1 && m="$m $a"; done
echo "MINDS:$m"
if command -v mesh-card >/dev/null 2>&1; then
  senses=$(mesh-card 2>/dev/null | awk '/^[[:space:]]*senses:/{sub(/^[^:]*:[[:space:]]*/,""); print; exit}')
  actuators=$(mesh-card 2>/dev/null | awk '/^[[:space:]]*actuators:/{sub(/^[^:]*:[[:space:]]*/,""); print; exit}')
  echo "SENSES:$senses"
  echo "ACTUATORS:$actuators"
fi
echo "COMPUTE:cores=$(nproc 2>/dev/null) mem=$(free -h 2>/dev/null|awk '/Mem/{print $2}') disk=$(df -h / 2>/dev/null|awk 'NR==2{print $4}')"
ing=""
for s in ngrok bore-mtg proxy-bot; do systemctl --user is-active "$s" >/dev/null 2>&1 && ing="$ing $s"; done
dev=$(ip route get 1.1.1.1 2>/dev/null|grep -oP 'dev \K\S+'|head -1)
ex=$(tailscale debug prefs 2>/dev/null | tr -d ' ' | grep -c '"0.0.0.0/0"')
echo "CONN:default-dev=$dev ingress=$ing exit-advertise=$ex"
inet=$(ping -c1 -W3 1.1.1.1 >/dev/null 2>&1 && echo ok || echo fail); echo "INET:$inet"
''')

ANDROID_PROBE = (r'''
verbs=$(ls "$PREFIX/bin" 2>/dev/null | grep '^termux-' | sed 's/^termux-//' | paste -sd' ' -)
echo "TERMUX:$verbs"
echo "COMPUTE:cores=$(nproc 2>/dev/null) mem=$(free -h 2>/dev/null|awk '/Mem/{print $2}')"
echo "CONN:uplink=$(getprop gsm.operator.alpha 2>/dev/null | tr -d ' ' | head -c 24)"
bat=$(termux-battery-status 2>/dev/null | grep -c percentage); echo "VERIFY-BATTERY:$bat"
m=""
for a in ''' + " ".join(AGENTS) + r'''; do command -v "$a" >/dev/null 2>&1 && m="$m $a"; done
echo "MINDS:$m"
inet=$(ping -c1 -W3 1.1.1.1 >/dev/null 2>&1 && echo ok || echo fail); echo "INET:$inet"
''')


def nodes():
    out = subprocess.run(["tailscale","status","--json"], capture_output=True, text=True).stdout
    d = json.loads(out)
    res = []
    me = d.get("Self", {})
    res.append({"host": me.get("HostName"), "ip": (me.get("TailscaleIPs") or ["?"])[0],
                "online": True, "os": me.get("OS"), "self": True})
    peers = {}
    for p in d.get("Peer", {}).values():
        if "tag:lte-node" in (p.get("Tags") or []):
            host = p.get("HostName")
            cand = {"host": host, "ip": p["TailscaleIPs"][0],
                    "online": p.get("Online"), "os": p.get("OS"), "self": False}
            prev = peers.get(host)
            prev_score = (bool(prev.get("online")) if prev else False, ) if prev else (False,)
            cand_score = (bool(cand.get("online")), )
            if prev is None or cand_score > prev_score:
                peers[host] = cand
    res.extend(peers[h] for h in sorted(peers))
    return res


def probe(node):
    n = dict(node, minds=[], senses=[], actuators=[], connectivity=[], compute="",
             inet="?", invariant="?", reached=False)
    # Probe by REACHABILITY, not the (often-stale) Tailscale Online flag — a node can be
    # reachable over a direct path while the coordination server still lists it offline.
    android = node["os"] == "android"
    body = ANDROID_PROBE if android else LINUX_PROBE
    try:
        if node["self"]:
            cmd = ["bash","-ls"]
        elif android:
            cmd = ["ssh","-p",os.environ.get("PHONE_SSH_PORT","8022"),*SSH,f"{os.environ.get('PHONE_USER','u0_a380')}@{node['ip']}","bash -ls"]
        else:
            cmd = ["ssh",*SSH,f"{_ssh_user(node['ip'])}@{node['ip']}","bash -ls"]
        r = subprocess.run(cmd, input=body, capture_output=True, text=True, timeout=30)
        for line in r.stdout.splitlines():
            if line.startswith("MINDS:"):
                n["minds"] = line[6:].split(); n["reached"] = True
            elif line.startswith("SENSES:"):
                n["senses"] = [x for x in line[7:].split() if x and x != "(none)"]
            elif line.startswith("ACTUATORS:"):
                n["actuators"] = [x for x in line[10:].split() if x and x != "(none)"]
            elif line.startswith("TERMUX:"):
                for v in line[7:].split():
                    if v in SENSE: n["senses"].append(v)
                    elif v in ACTUATOR: n["actuators"].append(v)
            elif line.startswith("COMPUTE:"):
                n["compute"] = line[8:].strip()
            elif line.startswith("CONN:"):
                c = line[5:]
                if "exit-advertise=1" in c or "exit-advertise=2" in c: n["connectivity"].append("exit-node")
                if "ingress=" in c and c.split("ingress=")[1].split("exit")[0].strip(): n["connectivity"].append("public-ingress")
                if "uplink=" in c:
                    up = c.split("uplink=")[1].strip()
                    if up and up != "": n["connectivity"].append(f"uplink:{up}")
                # invariant: own default egress must NOT be a wireguard tunnel
                dev = ""
                if "default-dev=" in c: dev = c.split("default-dev=")[1].split()[0] if c.split("default-dev=")[1].split() else ""
                if dev:
                    n["invariant"] = "VIOLATED" if (dev == "Gtcld" or dev.startswith("wg")) else "OK"
                    if n["invariant"] == "OK" and "exit-node" not in n["connectivity"]:
                        pass
            elif line.startswith("INET:"):
                n["inet"] = line[5:].strip()
            elif line.startswith("VERIFY-BATTERY:"):
                n["battery_verified"] = line[15:].strip() == "1"
    except Exception as e:
        n["error"] = str(e)
    return n


def census():
    ns = nodes()
    with concurrent.futures.ThreadPoolExecutor(max_workers=8) as ex:
        res = list(ex.map(probe, ns))
    up = [r for r in res if r.get("reached")]
    # aggregate surface
    surf = {"minds": 0, "senses": 0, "actuators": 0, "connectivity": 0, "compute": 0}
    for r in res:
        surf["minds"] += len(r["minds"])
        surf["senses"] += len(r["senses"])
        surf["actuators"] += len(r["actuators"])
        surf["connectivity"] += len(r["connectivity"])
        surf["compute"] += 1 if r["compute"] else 0
    health_ok = sum(1 for r in up if r.get("inet") == "ok")
    inv = [f"{r['host']}={r['invariant']}" for r in res if r["invariant"] in ("OK","VIOLATED")]
    return res, surf, up, health_ok, inv


def _dark_tag(r):
    """Why a node produced no observation. NOT a capability reading — the difference between
    'this node has no senses' and 'we did not see this node' is the whole of the smoothing pass."""
    if r.get("reached"): return ""
    if not r.get("online"): return "offline"
    if _role_by_ip(r.get("ip", "")) == "router": return "gateway"
    return "unreachable"


def fmt_report(res, surf, up, health_ok, inv, ts):
    L = []
    L.append(f"=== MESH CENSUS {ts} ===")
    L.append(f"NODES: {len(up)}/{len(res)} up")
    L.append("")
    L.append(f"{'NODE':<28} {'M':>2} {'S':>2} {'A':>2}  CONNECTIVITY            COMPUTE")
    for r in res:
        if not r.get("reached"):
            tag = _dark_tag(r)
            if tag == "gateway": tag = "gateway (no probe)"
            L.append(f"{(r['host'] or '?'):<28} {'—':>2} {'—':>2} {'—':>2}  {tag}"); continue
        conn = ",".join(r["connectivity"]) or "-"
        L.append(f"{(r['host'] or '?'):<28} {len(r['minds']):>2} {len(r['senses']):>2} {len(r['actuators']):>2}  {conn:<22} {r['compute']}")
    L.append("")
    L.append("CAPABILITY SURFACE (across mesh):")
    L.append(f"  minds={surf['minds']}  senses={surf['senses']}  actuators={surf['actuators']}  connectivity={surf['connectivity']}  compute-nodes={surf['compute']}")
    L.append("  actuators are DETECTED, not fired (boundary). senses verified only by no-side-effect reads.")
    dark = {(r["host"] or "?"): _dark_tag(r) for r in res if not r.get("reached")}
    if dark:
        L.append(f"  coverage: reached={len(up)}/{len(res)} — this surface is a LOWER BOUND; "
                 f"dark={', '.join(f'{h}({w})' for h, w in sorted(dark.items()))}")
        L.append("  a dark node contributes 0, not UNKNOWN: run `mesh-census --smooth` once it answers again.")
    else:
        L.append(f"  coverage: reached={len(up)}/{len(res)} — complete; surface is exact.")
    L.append("")
    L.append("HEALTH / INVARIANTS:")
    L.append(f"  internet: {health_ok}/{len(up)} online nodes reach 1.1.1.1")
    L.append(f"  invariant-check: {', '.join(inv) or 'n/a'}")
    return "\n".join(L)


def append_progress(surf, up, res, health_ok, inv, ts):
    # Per-node / Dark are what make this row REVISABLE by a later census. Without them the
    # record throws away exactly the information a future observation would need in order to
    # correct it: a filtered row that cannot name what it failed to see is unsmoothable.
    per = ",".join(f"{(r['host'] or '?')}="
                   f"{len(r['minds'])}/{len(r['senses'])}/{len(r['actuators'])}/{len(r['connectivity'])}"
                   for r in res if r.get("reached"))
    dark = ",".join(f"{(r['host'] or '?')}({_dark_tag(r)})" for r in res if not r.get("reached"))
    line = (f"\n## Census {ts}\n"
            f"- Nodes up: {len(up)}/{len(res)}\n"
            f"- Surface: minds={surf['minds']} senses={surf['senses']} actuators={surf['actuators']} "
            f"connectivity={surf['connectivity']} compute-nodes={surf['compute']}\n"
            f"- Per-node: {per or 'none'}\n"
            f"- Dark: {dark or 'none'}\n"
            f"- Health: {health_ok}/{len(up)} reach internet; invariants: {', '.join(inv) or 'n/a'}\n")
    try:
        new = not os.path.exists(REPO_PROGRESS)
        with open(REPO_PROGRESS, "a") as f:
            if new:
                f.write("# Mesh progress log\n\nAppend-only census snapshots (newest at bottom). "
                        "Generated by `mesh-census`. Progress = the delta between snapshots.\n")
            f.write(line)
        return REPO_PROGRESS
    except Exception as e:
        return f"(could not write progress log: {e})"


# ---------------------------------------------------------------------------
# RETROSPECTIVE PASS (fixed-lag Bayesian smoothing over the durable record)
#
# Friston et al., "Supervised structure learning", Biological Psychology 193 (2024)
# [arXiv:2311.10300]: "Bayesian filtering (i.e., forward message passing) during the active
# sampling of observations, followed by Bayesian smoothing (i.e., forward and backward
# message passing) to revise posterior beliefs about past states at the end of an epoch."
# Van de Maele, Verbelen, George & Pezzulo, arXiv:2601.18946v2 (14 Mar 2026) contrast the two
# and run the backward pass over "a sliding window of 10 observations" — hence SMOOTH_LAG.
#
# Every mesh tape is a pure FILTER: written at the moment of observation and never revised by
# later evidence. Here that costs real numbers — a dark node contributes 0 to the surface, so
# PROGRESS.md records a loss and, one census later, an identical gain.
# ---------------------------------------------------------------------------

def parse_progress(path=None):
    """Read PROGRESS.md into snapshot rows. Rows written before the Per-node/Dark fields
    existed are marked fmt='v1' and are UNREVISABLE — they cannot name what they failed to
    see, so no later observation can correct them. That is reported, never guessed around."""
    path = path or REPO_PROGRESS
    rows, cur = [], None
    try:
        fh = open(path)
    except OSError:
        return rows
    with fh:
        for line in fh:
            if line.startswith("## "):
                # Any other section (e.g. an appended `## Smoothing` block) CLOSES the current
                # row — otherwise a revision block's own field-shaped lines would be reparsed
                # into the last census above it.
                m = re.match(r'##\s+Census\s+(\S+)', line)
                cur = {"ts": m.group(1), "surf": {}, "per_node": {}, "dark": {}, "fmt": "v1"} if m else None
                if cur: rows.append(cur)
                continue
            if cur is None: continue
            m = re.match(r'-\s+Nodes up:\s+(\d+)/(\d+)', line)
            if m: cur["up"], cur["tot"] = int(m.group(1)), int(m.group(2)); continue
            m = re.match(r'-\s+Surface:\s+(.*)', line)
            if m:
                for tok in m.group(1).split():
                    if "=" in tok:
                        k, v = tok.split("=", 1)
                        try: cur["surf"][k] = int(v)
                        except ValueError: pass
                continue
            m = re.match(r'-\s+Per-node:\s+(.*)', line)
            if m:
                cur["fmt"] = "v2"
                for tok in m.group(1).split(","):
                    tok = tok.strip()
                    if "=" not in tok: continue
                    h, counts = tok.rsplit("=", 1)
                    parts = counts.split("/")
                    if len(parts) != len(CLASSES): continue
                    try: cur["per_node"][h] = {c: int(x) for c, x in zip(CLASSES, parts)}
                    except ValueError: pass
                continue
            m = re.match(r'-\s+Dark:\s+(.*)', line)
            if m:
                cur["fmt"] = "v2"
                for tok in m.group(1).split(","):
                    tok = tok.strip()
                    mm = re.match(r'^(.*)\((\w+)\)$', tok)
                    if mm: cur["dark"][mm.group(1)] = mm.group(2)
                continue
    return rows


def smooth(rows, lag=SMOOTH_LAG):
    """Backward pass. For each dark host at row t, bracket it with the nearest observation
    BEFORE and AFTER t within `lag` rows.

      both sides agree      -> SMOOTHED: the host held that capability set across the gap
      both sides disagree   -> INDETERMINATE: a bound [min,max], never an invented point value
      one side / neither    -> UNREVISED: no future observation yet; the row stays filtered

    Only a two-sided bracket is a smoothing. A one-sided one is still filtering."""
    out = []
    for i, r in enumerate(rows):
        rec = {"ts": r["ts"], "fmt": r["fmt"], "filtered": dict(r.get("surf", {})),
               "revisions": [], "unrevised": [], "indeterminate": [],
               "smoothed": dict(r.get("surf", {}))}
        if r["fmt"] != "v2":
            rec["note"] = "pre-format (no Per-node/Dark field) — unrevisable"
            out.append(rec); continue
        lo, hi = max(0, i - lag), min(len(rows), i + lag + 1)
        for host in sorted(r["dark"]):
            back = next((rows[j]["per_node"][host] for j in range(i - 1, lo - 1, -1)
                         if rows[j]["fmt"] == "v2" and host in rows[j]["per_node"]), None)
            fwd = next((rows[j]["per_node"][host] for j in range(i + 1, hi)
                        if rows[j]["fmt"] == "v2" and host in rows[j]["per_node"]), None)
            sides = [x for x in (back, fwd) if x is not None]
            if len(sides) < 2:
                rec["unrevised"].append((host, r["dark"][host],
                                         "no later observation" if fwd is None else "no earlier observation"))
            elif back == fwd:
                for c in CLASSES:
                    rec["smoothed"][c] = rec["smoothed"].get(c, 0) + back[c]
                rec["smoothed"]["compute-nodes"] = rec["smoothed"].get("compute-nodes", 0) + 1
                rec["revisions"].append((host, r["dark"][host], dict(back)))
            else:
                rec["indeterminate"].append((host, r["dark"][host],
                                             {c: (min(x[c] for x in sides), max(x[c] for x in sides))
                                              for c in CLASSES}))
        out.append(rec)
    return out


def _nonzero_deltas(series):
    return sum(1 for a, b in zip(series, series[1:])
               if any(b.get(k, 0) - a.get(k, 0) for k in set(a) | set(b)))


def fmt_smoothing(rows, sm, lag, ts):
    L = [f"=== CENSUS SMOOTHING {ts} (fixed-lag backward pass, lag={lag} censuses) ==="]
    v2 = sum(1 for r in rows if r["fmt"] == "v2")
    L.append(f"rows read: {len(rows)}  (revisable v2: {v2}, pre-format v1: {len(rows) - v2})")
    L.append("")
    n_rev = n_ind = n_unr = 0
    for rec in sm:
        if not (rec["revisions"] or rec["indeterminate"] or rec["unrevised"]): continue
        L.append(f"{rec['ts']}")
        for host, why, counts in rec["revisions"]:
            n_rev += 1
            L.append(f"  SMOOTHED     {host} ({why}) held "
                     f"{'/'.join(str(counts[c]) for c in CLASSES)} across the gap "
                     f"(same set either side) -> surface was under-counted by that much")
        for host, why, bnd in rec["indeterminate"]:
            n_ind += 1
            L.append(f"  INDETERMINATE {host} ({why}) differs either side "
                     f"{{{', '.join(f'{c}:{bnd[c][0]}-{bnd[c][1]}' for c in CLASSES)}}} — left UNKNOWN")
        for host, why, reason in rec["unrevised"]:
            n_unr += 1
            L.append(f"  UNREVISED    {host} ({why}) — {reason}")
        if rec["revisions"]:
            L.append(f"    filtered  {' '.join(f'{k}={v}' for k, v in sorted(rec['filtered'].items()))}")
            L.append(f"    smoothed  {' '.join(f'{k}={v}' for k, v in sorted(rec['smoothed'].items()))}")
    if not (n_rev or n_ind or n_unr):
        L.append("  no dark node in any revisable row — nothing to smooth.")
    L.append("")
    filt = _nonzero_deltas([r.get("surf", {}) for r in rows])
    smth = _nonzero_deltas([r["smoothed"] for r in sm])
    conf = sum(1 for a, b in zip(rows, rows[1:])
               if a.get("up") is not None and b.get("up") is not None and a["up"] != b["up"]
               and any(b.get("surf", {}).get(k, 0) - a.get("surf", {}).get(k, 0) for k in CLASSES))
    L.append("DELTA SERIES (\"progress = the delta between snapshots\"):")
    L.append(f"  filtered: {filt} non-zero deltas / {max(0, len(rows) - 1)}")
    L.append(f"  smoothed: {smth} non-zero deltas / {max(0, len(rows) - 1)}   "
             f"({filt - smth} were a node going dark, not the mesh changing)")
    L.append(f"  coverage-confounded: {conf} delta(s) co-occur with a reachability change")
    L.append(f"  revisions={n_rev} indeterminate={n_ind} unrevised={n_unr}")
    return "\n".join(L), n_rev


def append_smoothing(text, ts):
    try:
        with open(REPO_PROGRESS, "a") as f:
            f.write(f"\n## Smoothing {ts}\n"
                    "Retrospective revision of past snapshots (append-only — the filtered rows above are\n"
                    "left exactly as written, as the record of what was believed at the time).\n```\n"
                    + text + "\n```\n")
        return REPO_PROGRESS
    except Exception as e:
        return f"(could not write progress log: {e})"


def main():
    ts = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    argv = sys.argv[1:]
    if "--smooth" in argv:
        lag = SMOOTH_LAG
        if "--lag" in argv:
            try: lag = max(1, int(argv[argv.index("--lag") + 1]))
            except (IndexError, ValueError):
                print("--lag needs an integer"); sys.exit(2)
        rows = parse_progress()
        if not rows:
            print(f"no census rows in {REPO_PROGRESS}"); sys.exit(2)
        sm = smooth(rows, lag)
        text, n_rev = fmt_smoothing(rows, sm, lag, ts)
        if "--json" in argv:
            print(json.dumps({"ts": ts, "lag": lag, "rows": len(rows), "smoothed": sm}, indent=2)); return
        print(text)
        if "--no-log" not in argv:
            if n_rev:
                print(f"\nrevision appended -> {append_smoothing(text, ts)}")
            else:
                print("\nnothing appended (no row was revisable — a revision record with no revision "
                      "in it would be a tape of only positives).")
        return
    res, surf, up, health_ok, inv = census()
    if "--json" in sys.argv[1:]:
        print(json.dumps({"ts": ts, "surface": surf, "nodes": res,
                          "health_ok": health_ok, "invariants": inv}, indent=2)); return
    print(fmt_report(res, surf, up, health_ok, inv, ts))
    if "--no-log" not in sys.argv[1:]:
        where = append_progress(surf, up, res, health_ok, inv, ts)
        print(f"\nsnapshot appended -> {where}")


def _fixture_progress(path, rows):
    """Write a PROGRESS.md fixture in the live format. rows = (ts, per_node, dark)."""
    with open(path, "w") as f:
        f.write("# Mesh progress log\n")
        for ts, per, dark in rows:
            surf = {c: sum(v[c] for v in per.values()) for c in CLASSES}
            f.write(f"\n## Census {ts}\n- Nodes up: {len(per)}/{len(per) + len(dark)}\n"
                    f"- Surface: minds={surf['minds']} senses={surf['senses']} actuators={surf['actuators']} "
                    f"connectivity={surf['connectivity']} compute-nodes={len(per)}\n"
                    f"- Per-node: {','.join(f'{h}=' + '/'.join(str(v[c]) for c in CLASSES) for h, v in per.items()) or 'none'}\n"
                    f"- Dark: {','.join(f'{h}({w})' for h, w in dark.items()) or 'none'}\n"
                    f"- Health: {len(per)}/{len(per)} reach internet; invariants: n/a\n")


def _smoke_smooth():
    """Legs 4-8: the backward pass. Every leg is the red of a specific way to get it wrong."""
    import tempfile
    A = {"minds": 2, "senses": 9, "actuators": 6, "connectivity": 1}
    B = {"minds": 1, "senses": 3, "actuators": 0, "connectivity": 1}
    B2 = {"minds": 1, "senses": 5, "actuators": 0, "connectivity": 1}      # b genuinely grew
    d = tempfile.mkdtemp(prefix="census-test-")
    fx = os.path.join(d, "PROGRESS.md")
    global REPO_PROGRESS
    saved = REPO_PROGRESS
    try:
        REPO_PROGRESS = fx
        # leg 4: a pure flap is smoothed away — the delta series must lose BOTH phantom deltas.
        _fixture_progress(fx, [("t1", {"a": A, "b": B}, {}),
                               ("t2", {"a": A}, {"b": "unreachable"}),
                               ("t3", {"a": A, "b": B}, {})])
        rows = parse_progress(); sm = smooth(rows, 10)
        if _nonzero_deltas([r["surf"] for r in rows]) != 2:
            print("smoke-test: FAIL (leg4 fixture: filtered series should show 2 phantom deltas)"); return 1
        if _nonzero_deltas([r["smoothed"] for r in sm]) != 0:
            print("smoke-test: FAIL (leg4: a dark-node flap was not smoothed away)"); return 1
        if sm[1]["smoothed"] != rows[0]["surf"]:
            print("smoke-test: FAIL (leg4: smoothed surface != the surface either side)"); return 1

        # leg 5: a REAL change must survive. b is dark at t2 and different either side ->
        # INDETERMINATE, bounded, and no point value invented.
        _fixture_progress(fx, [("t1", {"a": A, "b": B}, {}),
                               ("t2", {"a": A}, {"b": "unreachable"}),
                               ("t3", {"a": A, "b": B2}, {})])
        sm = smooth(parse_progress(), 10)
        if sm[1]["revisions"] or not sm[1]["indeterminate"]:
            print("smoke-test: FAIL (leg5: disagreeing bracket was point-revised instead of bounded)"); return 1
        if sm[1]["smoothed"] != sm[1]["filtered"]:
            print("smoke-test: FAIL (leg5: an indeterminate host moved the smoothed surface)"); return 1
        bnd = sm[1]["indeterminate"][0][2]
        if bnd["senses"] != (3, 5):
            print(f"smoke-test: FAIL (leg5: wrong bound {bnd['senses']}, want (3, 5))"); return 1

        # leg 6: still dark at the window edge -> UNREVISED, never silently zeroed-then-blessed.
        _fixture_progress(fx, [("t1", {"a": A, "b": B}, {}),
                               ("t2", {"a": A}, {"b": "unreachable"})])
        sm = smooth(parse_progress(), 10)
        if sm[1]["revisions"] or not sm[1]["unrevised"]:
            print("smoke-test: FAIL (leg6: one-sided bracket was treated as a smoothing)"); return 1

        # leg 7: the lag BINDS. Same flap, but the later observation is outside the window.
        _fixture_progress(fx, [("t1", {"a": A, "b": B}, {}),
                               ("t2", {"a": A}, {"b": "unreachable"}),
                               ("t3", {"a": A}, {"b": "unreachable"}),
                               ("t4", {"a": A, "b": B}, {})])
        if smooth(parse_progress(), 10)[1]["revisions"] == []:
            print("smoke-test: FAIL (leg7: lag=10 should reach t4)"); return 1
        if smooth(parse_progress(), 1)[1]["revisions"] != []:
            print("smoke-test: FAIL (leg7: lag=1 must NOT reach two rows forward)"); return 1

        # leg 8: a pre-format (v1) row is UNREVISABLE and must say so, never be silently
        # treated as 'no dark nodes' (that is the format-upgrade-never-reaches-the-record trap).
        with open(fx, "w") as f:
            f.write("# Mesh progress log\n\n## Census t0\n- Nodes up: 1/2\n"
                    "- Surface: minds=2 senses=9 actuators=6 connectivity=1 compute-nodes=1\n"
                    "- Health: 1/1 reach internet; invariants: n/a\n")
        r0 = parse_progress()[0]
        if r0["fmt"] != "v1":
            print("smoke-test: FAIL (leg8: a row with no Per-node field parsed as v2)"); return 1
        if "unrevisable" not in (smooth([r0], 10)[0].get("note") or ""):
            print("smoke-test: FAIL (leg8: pre-format row not reported unrevisable)"); return 1

        # leg 9: PROGRESS.md is a repo document — this tool appends a `## Smoothing` section to
        # it and a human may append anything else. A non-Census `##` header must CLOSE the row
        # above it; otherwise a later section's field-shaped lines are read back INTO the last
        # census, and a pass whose own output edits its next input is a loop, not a backward pass.
        _fixture_progress(fx, [("t1", {"a": A, "b": B}, {}),
                               ("t2", {"a": A}, {"b": "unreachable"}),
                               ("t3", {"a": A, "b": B}, {})])
        before = parse_progress()
        append_smoothing(fmt_smoothing(before, smooth(before, 10), 10, "t-now")[0], "t-now")
        with open(fx, "a") as f:
            f.write("\n## Notes\n- Nodes up: 9/9\n"
                    "- Surface: minds=999 senses=999 actuators=999 connectivity=999 compute-nodes=999\n"
                    "- Per-node: ghost=9/9/9/9\n- Dark: ghost(offline)\n")
        after = parse_progress()
        if len(after) != len(before):
            print(f"smoke-test: FAIL (leg9: trailing section became a census row: {len(after)} vs {len(before)})"); return 1
        if [r["surf"] for r in after] != [r["surf"] for r in before] or \
           [r["dark"] for r in after] != [r["dark"] for r in before] or \
           [r["per_node"] for r in after] != [r["per_node"] for r in before]:
            print("smoke-test: FAIL (leg9: a trailing section's fields were reparsed into the last census)"); return 1
        return 0
    finally:
        REPO_PROGRESS = saved
        shutil.rmtree(d, ignore_errors=True)


if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] == '--test':
        # The temp dir _smoke_smooth() makes is removed in a finally, and under the DEFAULT
        # disposition a terminate signal kills the interpreter without unwinding — so that finally
        # is decorative exactly when it is needed and the directory outlives the kill (measured:
        # 6 of 20 runs TERMed mid-window left a /tmp/census-test-* behind). Re-arming the signal so
        # it raises SystemExit turns the death into an ordinary unwind and the EXISTING finally
        # becomes the exit path. The finally stays — it is correct for the ordinary path, and this
        # only gives the abnormal one somewhere to unwind TO. Armed here rather than inside the
        # producer function so every leg of --test is covered, and only under --test, because the
        # census run itself must keep the default disposition a caller expects.
        import signal
        signal.signal(signal.SIGTERM, lambda *_: sys.exit(1))
        rc = _smoke_base() or _smoke_smooth()
        print("smoke-test: ok" if rc == 0 else "smoke-test: FAILED"); sys.exit(rc)
    main()
