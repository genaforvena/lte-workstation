#!/usr/bin/env bash
# mesh-rns-linkcheck — deploy shim for the Reticulum RNS link proof.
# Software proof that RNS Links round-trip E2E over TCP transport (two throwaway
# instances, real socket, nonce echo). Real tool + proof lib live at
# scripts/reticulum/. Deploy this shim, never the real tool (a copy breaks the ref).
# reflex-cadence: 41 */12 * * *
set -eu
REPO="${MESH_REPO:-$HOME/lte-workstation}"
TARGET="$REPO/scripts/reticulum/mesh-rns-linkcheck"
[ -x "$TARGET" ] || { echo "mesh-rns-linkcheck: n/a — no genome checkout at $TARGET (set MESH_REPO)" >&2; exit 2; }
exec "$TARGET" "$@"
