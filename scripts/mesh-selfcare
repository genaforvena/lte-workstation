#!/usr/bin/env bash
# mesh-selfcare — the SINGLE per-node self-care loop the operator asked for: a node should KNOW
# its connectivity to what it needs AND restore what it can, on its own, on any node ($0, no mind).
# smoke-test: --test checks mesh-conn + mesh-revive reachable
# It does not re-implement anything — it WRAPS two verified reflexes:
#   • mesh-revive --check  → gentle, reversible self-HEAL (crawl out of internet-starvation)
#   • mesh-conn  --oneline → connectivity AWARENESS (inet / Telegram / mesh), as text
# and posts ONE line to mesh-chat only when the state CHANGES (no spam, no busywork on silence).
#
#   mesh-selfcare            one cycle: heal + report current state (for verification)
#   mesh-selfcare --once     same as above, compact
#   mesh-selfcare --loop [s] run forever: every N sec (default 180) heal, then post on change
#   mesh-selfcare --test     smoke test (exit 0 if deps found)
#
# Design: ~/.mesh/knowledge/node-self-care.md. Heal is mesh-revive's own escalation, gated by its
# MESH_REVIVE_THRESHOLD consecutive-failure count; it IS substrate-touching (`tailscale up`, then a
# reversible exit-node drop) and no --test may reach it (mesh-revive's sandboxed() guard).
# NB: this header claimed until 2026-07-16 that heal was "opt-in-aggressive only via mesh-revive's
# own MESH_REVIVE_FALLBACK" and that "this wrapper never adds risk". MESH_REVIVE_FALLBACK has never
# existed in mesh-revive (0 hits) — heal() was unconditional, and the wrapper's own --test was the
# thing firing it hourly. A safety knob named in prose is not a safety knob.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"   # find sibling reflexes regardless of caller's PATH (cron/ssh/tmux)
MESH="$HOME/.mesh"; STATEF="$MESH/.selfcare-state"; mkdir -p "$MESH"
have(){ command -v "$1" >/dev/null 2>&1; }

# Render an ISP verdict as a board suffix. Enumerated, never a catch-all: an unrecognised
# or absent verdict must not inherit a confident branch. "likely us" is a real accusation
# and it needs real data behind it — no data means we say so.
upstream_suffix() {
  case "${1:-}" in
    upstream-down) printf ' (upstream-down → ISP broken)' ;;
    upstream-ok)   printf ' (upstream-ok → likely us)' ;;
    "")            printf ' (upstream UNKNOWN — no ISP verdict)' ;;
    *)             printf ' (upstream UNKNOWN — no ISP data)' ;;
  esac
}
have mesh-conn   || { echo "mesh-selfcare: needs mesh-conn (awareness)"   >&2; exit 1; }
have mesh-revive || { echo "mesh-selfcare: needs mesh-revive (self-heal)" >&2; exit 1; }

heal(){  mesh-revive --check 2>/dev/null | tail -n1; }
aware(){ mesh-conn --oneline 2>/dev/null; }

# A connectivity-UP edge: prev showed some DOWN, now neither inet nor mesh is DOWN. Pure (testable).
is_reconnect(){ [[ "$1" == *DOWN* && "$2" != *inet=DOWN* && "$2" != *mesh=DOWN* ]]; }

report_on_change(){            # post to chat only when connectivity state flips
  local now prev; now="$(aware)"; prev="$(cat "$STATEF" 2>/dev/null || echo)"
  local PENDF="$MESH/.selfcare-pending"
  if [ "$now" != "$prev" ]; then
    if [[ "$now" == *DOWN* ]]; then
      # DOWN DEBOUNCE — persist-across-2-cycles (chat-review/selfcare-one-cycle-blip-debounce):
      # the old +2s re-probe only caught single-READ glitches; a minutes-long link blip (live
      # 17:17→17:20Z, the rtw88 deauth class — this node's sole path drops ~every 14min) passed
      # it and boarded a DOWN + UP pair, then the recovery fired the rejoin fleet beat + crash-boot
      # forensics post: board-noise #1, ~3 lines per blip for a self-clearing event. A DOWN-ward
      # flip now posts only when read on TWO consecutive cycles; the first read parks in PENDF and
      # routes to trace (history kept, board spared). A blip that clears never confirms — no post,
      # no baseline flip, and therefore no reconnect edge → no rejoin beat.
      if [ ! -s "$PENDF" ]; then
        printf '%s\n' "$now" > "$PENDF"
        command -v mesh-trace >/dev/null 2>&1 && \
          mesh-trace "[selfcare-blip?] $now (was: ${prev:-?}) — unconfirmed, holding one cycle" >/dev/null 2>&1 || true
        return 0
      fi
      # second consecutive DOWN-ish read (any shape — a flapping link that changes WHICH field is
      # DOWN across cycles is still a confirmed degradation) → fall through to the post path
      rm -f "$PENDF"
    else
      # recovery / benign change: keep the cheap same-invocation re-probe (a single read can
      # glitch), but never a cycle-wide hold — a confirmed-DOWN node must push its rejoin beat
      # promptly on reconnect (operator 2026-06-21: reconnect = first beat).
      sleep 2; local now2; now2="$(aware)"
      [ "$now2" = "$now" ] || return 0
      rm -f "$PENDF"
    fi
    # Detect tg-only transition: tg changed but inet+mesh stayed the same.
    # These are transient Telegram blips (3-6 min flaps) that flood the board (~30 lines/day).
    # Suppress board post within 10 min of last tg-only post; always route to trace for history.
    local tg_only=0
    if [ -n "$prev" ]; then
      local prev_inet="${prev##*inet=}"; prev_inet="${prev_inet%% *}"
      local prev_mesh="${prev##*mesh=}"; prev_mesh="${prev_mesh%% *}"
      local now_inet="${now##*inet=}";   now_inet="${now_inet%% *}"
      local now_mesh="${now##*mesh=}";   now_mesh="${now_mesh%% *}"
      # Strip trailing whitespace from last field
      prev_inet="${prev_inet%% }"; prev_mesh="${prev_mesh%% }"
      now_inet="${now_inet%% }";   now_mesh="${now_mesh%% }"
      if [ "$prev_inet" = "$now_inet" ] && [ "$prev_mesh" = "$now_mesh" ]; then
        tg_only=1
      fi
    fi
    echo "$now" > "$STATEF"
    if [ -n "$prev" ] && have mesh-chat; then
      if [ "$tg_only" = 1 ]; then
        local TG_COOLDOWN="$MESH/.selfcare-tg-cooldown"
        local _tg_now; _tg_now="$(date +%s)"
        local _tg_last; _tg_last="$(cat "$TG_COOLDOWN" 2>/dev/null || echo 0)"
        if [ $((_tg_now - _tg_last)) -lt 600 ]; then
          # tg-only within cooldown — trace only, no board post
          command -v mesh-trace >/dev/null 2>&1 && \
            mesh-trace "[selfcare-tg-flap] $now (was: ${prev:-?})" >/dev/null 2>&1 || true
        else
          # Cooldown expired or first tg-only — allow board post
          printf '%s\n' "$_tg_now" > "$TG_COOLDOWN"
          MESH_WHO="selfcare@$(hostname)" mesh-chat "[selfcare] connectivity changed: $now (was: ${prev:-?})" >/dev/null 2>&1
        fi
      else
        # Full state change (inet or mesh changed) — always board post
        local extra=""
        if [[ "$now" == *inet=DOWN* ]] && have mesh-isp-health; then
          verdict=$(mesh-isp-health --verdict 2>/dev/null) || verdict=""
          extra="$(upstream_suffix "$verdict")"
        fi
        MESH_WHO="selfcare@$(hostname)" mesh-chat "[selfcare] connectivity changed: $now (was: ${prev:-?})${extra}" >/dev/null 2>&1
      fi
    fi
    # CONNECTIVITY-UP → the node PUSHES its own rejoin beat NOW (operator 2026-06-21: reconnect =
    # first beat; don't wait for the steward's next pull). Background — the beacon does a fleet sweep.
    if is_reconnect "$prev" "$now" && have mesh-heartbeat; then
      ( mesh-heartbeat --rejoin >/dev/null 2>&1 & )
    fi
    printf '%s  %s\n' "$(date -u +%H:%M:%SZ)" "$now"
  else
    # state matches the baseline again — an unconfirmed pending blip (if any) self-cleared
    rm -f "$PENDF"
  fi
}

case "${1:-}" in
  --test)
    # tmp fence — task:doctor-test-tmpdir-cleanup-traps. Re-exec the smoke test ONCE under a private
    # TMPDIR and remove it from the PARENT, so the cleanup cannot be lost to the test's own `exit 1`
    # and cannot be clobbered by an EXIT trap the test sets for itself. A nested --test inherits the
    # guard var and skips its own fence (it is already inside one).
    if [ -z "${MESH_TEST_TMPD:-}" ]; then
      MESH_TEST_TMPD="$(mktemp -d)" || { echo "smoke-test: FAIL (tmp fence: mktemp -d)"; exit 1; }
      trap 'rm -rf "$MESH_TEST_TMPD"' EXIT INT HUP TERM
      export MESH_TEST_TMPD TMPDIR="$MESH_TEST_TMPD" TMP="$MESH_TEST_TMPD" TEMP="$MESH_TEST_TMPD"
      _fence_rc=0; "$0" "$@" || _fence_rc=$?; exit "$_fence_rc"
    fi
    have mesh-conn || { echo "smoke-test: FAIL (no mesh-conn)"; exit 1; }
    have mesh-revive || { echo "smoke-test: FAIL (no mesh-revive)"; exit 1; }
    # dry-run: mesh-conn --oneline must produce inet=/mesh=/tg= fields
    out="$(mesh-conn --oneline 2>/dev/null)" || { echo "smoke-test: FAIL (mesh-conn --oneline exited $?)"; exit 1; }
    echo "$out" | grep -qE 'inet=' || { echo "smoke-test: FAIL (mesh-conn output missing inet=: ${out:0:80})"; exit 1; }
    echo "$out" | grep -qE 'mesh=' || { echo "smoke-test: FAIL (mesh-conn output missing mesh=: ${out:0:80})"; exit 1; }
    echo "$out" | grep -qE 'tg=' || { echo "smoke-test: FAIL (mesh-conn output missing tg=: ${out:0:80})"; exit 1; }
    # Drive mesh-revive under a THROWAWAY $HOME: its FLAG / FAIL_CNT / exit-node-save all derive
    # from $HOME (mesh-revive:16-18) and relocate together, so the healer's LIVE counter is never
    # written by a test. Until 2026-07-16 this line ran the healer against the real $HOME — and
    # since mesh-doctor:166 fires this --test hourly at :23 with MESH_TEST_SANDBOX=1 already in
    # the env, a green "smoke-test: ok" was running `tailscale up` + `tailscale set --exit-node=`
    # on a starving node. The substrate half is now blocked inside mesh-revive itself (its
    # sandboxed() guard, gated there on both actuators); this is the live-state half.
    # rc: 0 = up/healed, 1 = down but below the heal threshold — BOTH are correct answers from a
    # healthy tool (mesh-revive:86-89). Asserting rc=0 called the tool broken whenever the internet
    # was down, i.e. exactly when this reflex matters. Anything else is real breakage.
    _rvhome="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
    mkdir -p "$_rvhome/.mesh"
    _live_before="$(stat -c %Y "$HOME/.mesh/.revive-fails" 2>/dev/null || echo absent)"
    rev="$(HOME="$_rvhome" MESH_TEST_SANDBOX=1 mesh-revive --check 2>&1)"; _rvrc=$?
    rm -rf "$_rvhome"
    case "$_rvrc" in
      0|1) ;;
      *)   echo "smoke-test: FAIL (mesh-revive --check exited $_rvrc: ${rev:0:120})"; exit 1 ;;
    esac
    # the healer's live state must be exactly as we found it — this test does not feed the counter
    # it is supposed to be checking (the 09f7914 forge-your-own-evidence class)
    _live_after="$(stat -c %Y "$HOME/.mesh/.revive-fails" 2>/dev/null || echo absent)"
    [ "$_live_before" = "$_live_after" ] \
      || { echo "smoke-test: FAIL (--test wrote the healer's live counter ~/.mesh/.revive-fails: $_live_before -> $_live_after)"; exit 1; }
    # connectivity-up edge predicate (fires the rejoin push): DOWN→UP yes; already-up or still-down no
    is_reconnect "inet=DOWN mesh=DOWN tg=DOWN" "inet=OK mesh=OK tg=OK" || { echo "smoke-test: FAIL (DOWN→UP must be a reconnect)"; exit 1; }
    is_reconnect "inet=OK mesh=OK tg=OK"       "inet=OK mesh=OK tg=OK" && { echo "smoke-test: FAIL (already-up is not a reconnect)"; exit 1; }
    is_reconnect "inet=DOWN mesh=OK"           "inet=DOWN mesh=OK"     && { echo "smoke-test: FAIL (still inet=DOWN is not a reconnect)"; exit 1; }
    # ISP-verdict rendering: only a real verdict earns a confident suffix. An unknown or
    # absent one must never board "likely us" — that accuses this node off zero measurements.
    case "$(upstream_suffix upstream-down)" in *"ISP broken"*) ;; *) echo "smoke-test: FAIL (upstream-down must render ISP broken)"; exit 1 ;; esac
    case "$(upstream_suffix upstream-ok)"   in *"likely us"*)  ;; *) echo "smoke-test: FAIL (upstream-ok must render likely us)"; exit 1 ;; esac
    for _v in upstream-unknown "" garbage-verdict; do
      _s="$(upstream_suffix "$_v")"
      case "$_s" in *"likely us"*) echo "smoke-test: FAIL (verdict '${_v:-<empty>}' must NOT render 'likely us', got '$_s')"; exit 1 ;; esac
      case "$_s" in *UNKNOWN*) ;; *) echo "smoke-test: FAIL (verdict '${_v:-<empty>}' must render UNKNOWN, got '$_s')"; exit 1 ;; esac
    done
    # --once must NOT write the loop's change baseline (STATEF). mesh-report:41 / mesh-verify:68
    # scout via --once; an undebounced single read racing an outage reverted the baseline, and the
    # loop re-boarded the identical transition twice (2026-07-16 22:32+22:35, duplicate rejoin
    # sweeps). report_on_change (debounced) alone owns STATEF. Fixture: sandbox HOME, STATEF=up,
    # DOWN-reading mesh-conn stub → --once leaves STATEF byte-identical; the loop must still
    # flip it + post. Stubs live in the sandbox's ~/.local/bin — line 23 prepends $HOME/.local/bin,
    # so anchoring HOME puts them first (a bare PATH shim would be shadowed).
    _schome="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp scout-home)"; exit 1; }
    mkdir -p "$_schome/.mesh" "$_schome/.local/bin"
    printf 'inet=OK tg=OK mesh=OK\n' > "$_schome/.mesh/.selfcare-state"
    printf '#!/usr/bin/env bash\necho "inet=DOWN tg=DOWN mesh=DOWN"\n' > "$_schome/.local/bin/mesh-conn"
    printf '#!/usr/bin/env bash\nexit 0\n' > "$_schome/.local/bin/mesh-revive"
    printf '#!/usr/bin/env bash\nprintf "%%s\\n" "$*" >> "$HOME/.mesh/chat-posts.log"\n' > "$_schome/.local/bin/mesh-chat"
    for _t in mesh-trace mesh-heartbeat mesh-isp-health mesh-state-touch; do
      printf '#!/usr/bin/env bash\nexit 0\n' > "$_schome/.local/bin/$_t"
    done
    chmod +x "$_schome/.local/bin/"*
    HOME="$_schome" "$0" --once >/dev/null 2>&1
    _scafter="$(cat "$_schome/.mesh/.selfcare-state" 2>/dev/null)"
    [ "$_scafter" = "inet=OK tg=OK mesh=OK" ] \
      || { echo "smoke-test: FAIL (--once clobbered the loop baseline STATEF: '$_scafter')"; rm -rf "$_schome"; exit 1; }
    # ...and the loop still owns the flip: same fixture, one iteration must rewrite STATEF + post
    HOME="$_schome" "$0" --loop 1 >/dev/null 2>&1 &
    _sclp=$!
    _scflip=""
    for _i in $(seq 1 16); do
      grep -q DOWN "$_schome/.mesh/.selfcare-state" 2>/dev/null && { _scflip=1; break; }
      sleep 0.5
    done
    kill "$_sclp" 2>/dev/null; wait "$_sclp" 2>/dev/null
    [ -n "$_scflip" ] || { echo "smoke-test: FAIL (loop fixture did not flip STATEF on a real change)"; rm -rf "$_schome"; exit 1; }
    grep -q 'connectivity changed' "$_schome/.mesh/chat-posts.log" 2>/dev/null \
      || { echo "smoke-test: FAIL (loop fixture flipped STATEF but posted nothing)"; rm -rf "$_schome"; exit 1; }
    rm -rf "$_schome"
    # DOWN DEBOUNCE — persist-across-2-cycles (chat-review/selfcare-one-cycle-blip-debounce): the old
    # +2s re-probe only caught single-READ glitches; a 3-minute link blip (live 17:17→17:20Z, rtw88
    # deauth class) passed it, boarded DOWN + UP lines AND fired the rejoin fleet beat + crash-boot
    # forensics — board-noise #1. A DOWN-ward flip must be read on TWO consecutive cycles before it
    # posts; an unconfirmed blip routes to trace and fires NO rejoin. Recovery keeps the quick
    # re-probe (a confirmed-DOWN node must push its rejoin beat promptly, operator 2026-06-21).
    # Fixture 1: single-cycle blip — baseline UP, mesh-conn reads DOWN once then UP again: the loop
    # must post NOTHING, keep STATEF, fire NO rejoin, and leave one trace line.
    _bdhome="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp blip-home)"; exit 1; }
    mkdir -p "$_bdhome/.mesh" "$_bdhome/.local/bin"
    printf 'inet=OK tg=OK mesh=OK\n' > "$_bdhome/.mesh/.selfcare-state"
    # time-based stub: DOWN for 2.5s from its FIRST call, UP after — long enough to survive an
    # in-invocation re-probe (the pre-fix +2s debounce), short enough to clear before the NEXT 4s
    # cycle: the exact shape of the live 17:17→17:20Z blip scaled to test time.
    cat > "$_bdhome/.local/bin/mesh-conn" <<'STUB'
#!/usr/bin/env bash
n="$(cat "$HOME/.mesh/conn-calls" 2>/dev/null || echo 0)"; n=$((n+1)); printf '%s\n' "$n" > "$HOME/.mesh/conn-calls"
t="$(date +%s%3N)"
[ -f "$HOME/.mesh/conn-first" ] || printf '%s\n' "$t" > "$HOME/.mesh/conn-first"
if [ $(( t - $(cat "$HOME/.mesh/conn-first") )) -lt 2500 ]; then echo "inet=DOWN tg=DOWN mesh=DOWN"; else echo "inet=OK tg=OK mesh=OK"; fi
STUB
    printf '#!/usr/bin/env bash\nexit 0\n' > "$_bdhome/.local/bin/mesh-revive"
    printf '#!/usr/bin/env bash\nprintf "%%s\\n" "$*" >> "$HOME/.mesh/chat-posts.log"\n' > "$_bdhome/.local/bin/mesh-chat"
    printf '#!/usr/bin/env bash\nprintf "%%s\\n" "$*" >> "$HOME/.mesh/trace-posts.log"\n' > "$_bdhome/.local/bin/mesh-trace"
    printf '#!/usr/bin/env bash\nprintf "%%s\\n" "$*" >> "$HOME/.mesh/beat-calls.log"\n' > "$_bdhome/.local/bin/mesh-heartbeat"
    for _t in mesh-isp-health mesh-state-touch; do printf '#!/usr/bin/env bash\nexit 0\n' > "$_bdhome/.local/bin/$_t"; done
    chmod +x "$_bdhome/.local/bin/"*
    HOME="$_bdhome" "$0" --loop 4 >/dev/null 2>&1 &
    _bdlp=$!
    for _i in $(seq 1 30); do
      [ "$(cat "$_bdhome/.mesh/conn-calls" 2>/dev/null || echo 0)" -ge 3 ] && break
      sleep 0.5
    done
    kill "$_bdlp" 2>/dev/null; wait "$_bdlp" 2>/dev/null
    grep -q 'connectivity changed' "$_bdhome/.mesh/chat-posts.log" 2>/dev/null \
      && { echo "smoke-test: FAIL (a single-cycle blip reached the board — DOWN debounce missing)"; rm -rf "$_bdhome"; exit 1; }
    [ -s "$_bdhome/.mesh/beat-calls.log" ] \
      && { echo "smoke-test: FAIL (a single-cycle blip fired the rejoin beat)"; rm -rf "$_bdhome"; exit 1; }
    [ "$(cat "$_bdhome/.mesh/.selfcare-state")" = "inet=OK tg=OK mesh=OK" ] \
      || { echo "smoke-test: FAIL (a single-cycle blip flipped the loop baseline)"; rm -rf "$_bdhome"; exit 1; }
    grep -q 'selfcare-blip' "$_bdhome/.mesh/trace-posts.log" 2>/dev/null \
      || { echo "smoke-test: FAIL (an unconfirmed blip left no trace line — it must route to trace, not vanish)"; rm -rf "$_bdhome"; exit 1; }
    rm -rf "$_bdhome"
    # Fixture 2: recovery after a CONFIRMED DOWN baseline still posts promptly + fires the rejoin
    # beat (the debounce must gate ONSET only — both-edges lesson, inverted: recovery is the edge
    # the fleet needs fast).
    _rchome="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp recovery-home)"; exit 1; }
    mkdir -p "$_rchome/.mesh" "$_rchome/.local/bin"
    printf 'inet=DOWN tg=DOWN mesh=DOWN\n' > "$_rchome/.mesh/.selfcare-state"
    printf '#!/usr/bin/env bash\necho "inet=OK tg=OK mesh=OK"\n' > "$_rchome/.local/bin/mesh-conn"
    printf '#!/usr/bin/env bash\nexit 0\n' > "$_rchome/.local/bin/mesh-revive"
    printf '#!/usr/bin/env bash\nprintf "%%s\\n" "$*" >> "$HOME/.mesh/chat-posts.log"\n' > "$_rchome/.local/bin/mesh-chat"
    printf '#!/usr/bin/env bash\nprintf "%%s\\n" "$*" >> "$HOME/.mesh/beat-calls.log"\n' > "$_rchome/.local/bin/mesh-heartbeat"
    for _t in mesh-trace mesh-isp-health mesh-state-touch; do printf '#!/usr/bin/env bash\nexit 0\n' > "$_rchome/.local/bin/$_t"; done
    chmod +x "$_rchome/.local/bin/"*
    HOME="$_rchome" "$0" --loop 1 >/dev/null 2>&1 &
    _rclp=$!
    for _i in $(seq 1 16); do
      [ -s "$_rchome/.mesh/beat-calls.log" ] && break
      sleep 0.5
    done
    kill "$_rclp" 2>/dev/null; wait "$_rclp" 2>/dev/null
    grep -q 'connectivity changed' "$_rchome/.mesh/chat-posts.log" 2>/dev/null \
      || { echo "smoke-test: FAIL (recovery from a confirmed DOWN baseline did not board — debounce over-reached onto the recovery edge)"; rm -rf "$_rchome"; exit 1; }
    grep -q -- '--rejoin' "$_rchome/.mesh/beat-calls.log" 2>/dev/null \
      || { echo "smoke-test: FAIL (recovery from a confirmed DOWN baseline did not fire the rejoin beat)"; rm -rf "$_rchome"; exit 1; }
    rm -rf "$_rchome"
    echo "smoke-test: ok"; exit 0
    ;;
  ""|--once)
    h="$(heal)"; a="$(aware)"
    echo "=== self-care: $(hostname) ==="
    echo "  heal : ${h:-ok (no action needed)}"
    echo "  aware: $a"
    # NO write to STATEF here: it is the LOOP's change-detection baseline, owned solely by
    # report_on_change (debounced). This branch wrote its single undebounced read until
    # 2026-07-16 — mesh-report/mesh-verify scout via --once, and a scout racing an outage
    # reverted the baseline, so the loop re-boarded the same transition twice (22:32+22:35),
    # firing a duplicate rejoin fleet sweep each time.
    ;;
  --loop)
    iv="${2:-180}"
    echo "[mesh-selfcare] per-node self-care every ${iv}s on $(hostname): heal + aware (post on change)"
    # liveness beat: touch per iteration so a WEDGED loop is distinguishable from a healthy-quiet
    # one (supervisor checks process-exists, not loop-advancing — intel audit 2026-06-10)
    # STATEF is change-gated (report_on_change only rewrites it on a flip), so a long-held value
    # (e.g. mesh=DOWN steady for 25+ min, live-verified 2026-07-01) freezes its mtime past
    # mesh-mesh-state's 600s STALE_S → false UNKNOWN instead of the true DEGRADED. Apply the
    # liveness-touch convention (mesh-state-touch) here too: decouple ran-live from value-changed.
    while true; do heal >/dev/null; report_on_change; mesh-state-touch --create "$STATEF"; : > "$MESH/mesh-selfcare.beat"; sleep "$iv"; done ;;
  *) echo "usage: mesh-selfcare [--once|--loop [s]]" >&2; exit 1 ;;
esac
