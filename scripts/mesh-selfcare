#!/usr/bin/env bash
# mesh-selfcare — the SINGLE per-node self-care loop the operator asked for: a node should KNOW
# its connectivity to what it needs AND restore what it can, on its own, on any node ($0, no mind).
# smoke-test: --test checks mesh-conn + mesh-revive reachable
# It does not re-implement anything — it WRAPS two verified reflexes:
#   • mesh-revive --check  → gentle, reversible self-HEAL (crawl out of internet-starvation)
#   • mesh-conn  --oneline → connectivity AWARENESS (inet / Telegram / mesh), as text
# and posts ONE line to mesh-chat only when the state CHANGES (no spam, no busywork on silence).
#
#   mesh-selfcare            one cycle: heal + report current state (for verification)
#   mesh-selfcare --once     same as above, compact
#   mesh-selfcare --loop [s] run forever: every N sec (default 180) heal, then post on change
#   mesh-selfcare --test     smoke test (exit 0 if deps found)
#
# Design: ~/.mesh/knowledge/node-self-care.md. Heal is opt-in-aggressive only via mesh-revive's
# own MESH_REVIVE_FALLBACK (substrate stays the operator's call) — this wrapper never adds risk.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"   # find sibling reflexes regardless of caller's PATH (cron/ssh/tmux)
MESH="$HOME/.mesh"; STATEF="$MESH/.selfcare-state"; mkdir -p "$MESH"
have(){ command -v "$1" >/dev/null 2>&1; }
have mesh-conn   || { echo "mesh-selfcare: needs mesh-conn (awareness)"   >&2; exit 1; }
have mesh-revive || { echo "mesh-selfcare: needs mesh-revive (self-heal)" >&2; exit 1; }

heal(){  mesh-revive --check 2>/dev/null | tail -n1; }
aware(){ mesh-conn --oneline 2>/dev/null; }

report_on_change(){            # post to chat only when connectivity state flips
  local now prev; now="$(aware)"; prev="$(cat "$STATEF" 2>/dev/null || echo)"
  if [ "$now" != "$prev" ]; then
    # DEBOUNCE a transient probe blip: a single mesh-conn read can momentarily show mesh/inet DOWN that
    # the next cycle clears (phaedra mesh=DOWN flapped 20:02/22:27/23:00, all benign — peers reachable).
    # Re-probe once; accept the flip only if a FRESH read agrees, else treat as transient (keep prev, no post).
    sleep 2; local now2; now2="$(aware)"
    [ "$now2" = "$now" ] || return 0
    echo "$now" > "$STATEF"
    if [ -n "$prev" ] && have mesh-chat; then
      local extra=""
      if [[ "$now" == *inet=DOWN* ]] && have mesh-isp-health; then
        verdict=$(mesh-isp-health --verdict 2>/dev/null) || verdict=""
        if [ -n "$verdict" ]; then
          case "$verdict" in
            upstream-down) extra=" (upstream-down → ISP broken)" ;;
            *) extra=" (upstream-ok → likely us)" ;;
          esac
        fi
      fi
      MESH_WHO="selfcare@$(hostname)" mesh-chat "[selfcare] connectivity changed: $now (was: ${prev:-?})${extra}" >/dev/null 2>&1
    fi
    printf '%s  %s\n' "$(date -u +%H:%M:%SZ)" "$now"
  fi
}

case "${1:-}" in
  --test)
    have mesh-conn || { echo "smoke-test: FAIL (no mesh-conn)"; exit 1; }
    have mesh-revive || { echo "smoke-test: FAIL (no mesh-revive)"; exit 1; }
    # dry-run: mesh-conn --oneline must produce inet=/mesh=/tg= fields
    out="$(mesh-conn --oneline 2>/dev/null)" || { echo "smoke-test: FAIL (mesh-conn --oneline exited $?)"; exit 1; }
    echo "$out" | grep -qE 'inet=' || { echo "smoke-test: FAIL (mesh-conn output missing inet=: ${out:0:80})"; exit 1; }
    echo "$out" | grep -qE 'mesh=' || { echo "smoke-test: FAIL (mesh-conn output missing mesh=: ${out:0:80})"; exit 1; }
    echo "$out" | grep -qE 'tg=' || { echo "smoke-test: FAIL (mesh-conn output missing tg=: ${out:0:80})"; exit 1; }
    # dry-run: mesh-revive --check must exit 0
    rev="$(mesh-revive --check 2>&1)" || { echo "smoke-test: FAIL (mesh-revive --check exited $?: $rev)"; exit 1; }
    echo "smoke-test: ok"; exit 0
    ;;
  ""|--once)
    h="$(heal)"; a="$(aware)"
    echo "=== self-care: $(hostname) ==="
    echo "  heal : ${h:-ok (no action needed)}"
    echo "  aware: $a"
    echo "$a" > "$STATEF" ;;
  --loop)
    iv="${2:-180}"
    echo "[mesh-selfcare] per-node self-care every ${iv}s on $(hostname): heal + aware (post on change)"
    # liveness beat: touch per iteration so a WEDGED loop is distinguishable from a healthy-quiet
    # one (supervisor checks process-exists, not loop-advancing — intel audit 2026-06-10)
    while true; do heal >/dev/null; report_on_change; : > "$MESH/mesh-selfcare.beat"; sleep "$iv"; done ;;
  *) echo "usage: mesh-selfcare [--once|--loop [s]]" >&2; exit 1 ;;
esac
