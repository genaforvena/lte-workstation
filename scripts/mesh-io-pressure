#!/usr/bin/env bash
# orphan-ok: on-demand kernel I/O-stall probe — pulled manually when storage/I/O contention is
# being investigated; it is intentionally not a scheduled reflex or a cached liveness source.
# mesh-io-pressure — live Linux PSI I/O pressure sense.
#
# Reads /proc/pressure/io, which reports time that runnable tasks were stalled by I/O. This is a
# distinct hardware-visible axis from CPU load, memory pressure, thermals, and network quality.
# An absent or malformed PSI file is blind: exit 2 and never substitute a calm reading.
#
#   mesh-io-pressure          one live human-readable reading
#   mesh-io-pressure --json   machine-readable reading
#   mesh-io-pressure --test   fixture classifier plus a real /proc read gate
set -euo pipefail

read_psi() {
  local file="${MESH_IO_PRESSURE_ROOT:-/proc/pressure}/io"
  [ -r "$file" ] || return 2
  awk '
    function val(field,    a) {
      split(field, a, "=")
      if (a[2] !~ /^[0-9]+([.][0-9]+)?$/) bad=1
      return a[2]
    }
    $1 == "some" && NF == 5 {
      some10=val($2); some60=val($3); some300=val($4); some_total=val($5)
      got_some=1
    }
    $1 == "full" && NF == 5 {
      full10=val($2); full60=val($3); full300=val($4); full_total=val($5)
      got_full=1
    }
    END {
      if (bad || !got_some || !got_full) exit 2
      printf "%.2f\t%.2f\t%.2f\t%.2f\t%.2f\t%.2f\t%s\t%s\n", \
        some10, some60, some300, full10, full60, full300, some_total, full_total
    }
  ' "$file"
}

classify() {
  awk -v some10="$1" 'BEGIN {
    if (some10 >= 10) print "STALLED"
    else if (some10 >= 1) print "PRESSURED"
    else print "CALM"
  }'
}

if [ "${1:-}" = --test ]; then
  td="$(mktemp -d)"
  trap 'rm -rf "$td"' EXIT
  mkdir -p "$td"
  cat > "$td/io" <<'EOF'
some avg10=2.50 avg60=1.25 avg300=0.50 total=12345
full avg10=0.25 avg60=0.10 avg300=0.05 total=6789
EOF
  fixture="$(MESH_IO_PRESSURE_ROOT="$td" read_psi)"
  IFS=$'\t' read -r s10 s60 s300 f10 f60 f300 st ft <<< "$fixture"
  [ "$s10" = 2.50 ] || { echo "smoke-test: FAIL (fixture some.avg10=$s10)"; exit 1; }
  [ "$(classify "$s10")" = PRESSURED ] || { echo "smoke-test: FAIL (classifier)"; exit 1; }
  printf 'some avg10=bad avg60=1 avg300=1 total=1\nfull avg10=0 avg60=0 avg300=0 total=1\n' > "$td/io"
  if MESH_IO_PRESSURE_ROOT="$td" read_psi >/dev/null 2>&1; then
    echo 'smoke-test: FAIL (malformed PSI accepted)' >&2
    exit 1
  fi
  real="$(read_psi 2>/dev/null)" || {
    echo 'smoke-test: n/a (unreadable /proc/pressure/io)' >&2
    exit 2
  }
  printf '%s\n' "$real" | grep -q $'\t' || { echo 'smoke-test: FAIL (real PSI read malformed)' >&2; exit 1; }
  echo 'smoke-test: ok (fixture parser/classifier + malformed rejection + real /proc/pressure/io read)'
  exit 0
fi

reading="$(read_psi 2>/dev/null)" || {
  echo "mesh-io-pressure: BLIND — unreadable or malformed ${MESH_IO_PRESSURE_ROOT:-/proc/pressure}/io" >&2
  exit 2
}
IFS=$'\t' read -r some10 some60 some300 full10 full60 full300 some_total full_total <<< "$reading"
label="$(classify "$some10")"
ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

if [ "${1:-}" = --json ]; then
  printf '{"label":"%s","some_avg10":%s,"some_avg60":%s,"some_avg300":%s,"full_avg10":%s,"full_avg60":%s,"full_avg300":%s,"some_total_us":%s,"full_total_us":%s,"ts":"%s"}\n' \
    "$label" "$some10" "$some60" "$some300" "$full10" "$full60" "$full300" "$some_total" "$full_total" "$ts"
else
  printf '[io-pressure] %s — some avg10=%s%% avg60=%s%% avg300=%s%%; full avg10=%s%% avg60=%s%% avg300=%s%% (%s)\n' \
    "$label" "$some10" "$some60" "$some300" "$full10" "$full60" "$full300" "$ts"
fi
