#!/usr/bin/env python3
"""Synthetic cleaner Mind proposal followed by one keyed quarantine action."""
import argparse
import atexit
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import signal
import subprocess
import sys
import tempfile


class Hold(Exception):
    pass


def atomic(path: Path, row: dict):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, name = tempfile.mkstemp(prefix=".proposal-", dir=path.parent)
    try:
        with os.fdopen(fd, "w") as stream:
            json.dump(row, stream, sort_keys=True)
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(name, path)
        directory = os.open(path.parent, os.O_DIRECTORY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    finally:
        Path(name).unlink(missing_ok=True)


def parse_proposal(text: str) -> dict:
    lines = [line.strip() for line in text.splitlines() if line.strip()]
    if not lines or len(lines[-1]) > 1024:
        raise Hold("missing or oversized typed proposal")
    value = json.loads(lines[-1])
    if not isinstance(value, dict) or value.get("version") != 1:
        raise Hold("invalid proposal version")
    if value.get("action") == "hold" and set(value) == {"version", "action"}:
        return value
    if value.get("action") == "quarantine" and set(value) == {"version", "action", "path"} and isinstance(value["path"], str):
        return value
    raise Hold("proposal outside cleaner action grammar")


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--synthetic-root", required=True, type=Path)
    parser.add_argument("--state-dir", required=True, type=Path)
    parser.add_argument("--manifest", required=True, type=Path)
    parser.add_argument("--request-id", required=True)
    args = parser.parse_args()
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]{0,63}", args.request_id):
        raise Hold("invalid request identity")
    root = args.synthetic_root.resolve(strict=True)
    state = args.state_dir.resolve(strict=True)
    locks = state / "proposals"
    locks.mkdir(parents=True, exist_ok=True)
    lease = os.open(locks / f"{args.request_id}.lock", os.O_CREAT | os.O_RDWR, 0o600)
    atexit.register(os.close, lease)
    try:
        fcntl.flock(lease, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError as exc:
        raise Hold("proposal invocation lease busy") from exc
    manifest_bytes = args.manifest.read_bytes()
    if len(manifest_bytes) > 64 * 1024:
        raise Hold("manifest exceeds bounded input")
    manifest = json.loads(manifest_bytes)
    if manifest.get("version") != 1 or not isinstance(manifest.get("scan_id"), str):
        raise Hold("invalid scan manifest")
    candidates = [{"path": r.get("path"), "reasons": r.get("reasons")}
                  for r in manifest.get("candidates", []) if isinstance(r, dict)]
    if len(candidates) > 200:
        raise Hold("candidate count exceeds bounded input")
    request = state / "proposals" / f"{args.request_id}.json"
    manifest_sha = hashlib.sha256(manifest_bytes).hexdigest()
    if request.exists():
        stored = json.loads(request.read_text())
        if stored.get("manifest_sha256") != manifest_sha:
            raise Hold("request identity reused for changed manifest")
        proposal = stored.get("proposal")
        if not isinstance(proposal, dict):
            raise Hold("stored proposal malformed")
    else:
        prompt = ("You are cleaner in a synthetic fixture. Return one JSON object on the final line: "
                  "{\"version\":1,\"action\":\"hold\"} or "
                  "{\"version\":1,\"action\":\"quarantine\",\"path\":\".firecrawl/name.json\"}. "
                  "You cannot execute tools. Choose quarantine only for a manifest row whose sole reason "
                  "is disposable-generated. The deterministic gateway will validate all safety gates.\n"
                  f"Scan: {manifest['scan_id']}\nCandidates: {json.dumps(candidates, sort_keys=True)}")
        omp = os.environ.get("MESH_CLEANER_OMP_CMD", "omp")
        result = subprocess.run([omp, "--print", "--no-tools", "--no-extensions", "--no-session",
                                 "--no-rules", "--no-skills", "--max-time=30", prompt],
                                capture_output=True, text=True, timeout=40)
        if result.returncode:
            raise Hold(f"tool-free Mind failed rc={result.returncode}")
        if len(result.stdout.encode()) > 8192:
            raise Hold("Mind output exceeds bound")
        proposal = parse_proposal(result.stdout)
        atomic(request, {"version": 1, "request_id": args.request_id,
                         "manifest_sha256": manifest_sha, "proposal": proposal})
    if proposal == {"version": 1, "action": "hold"}:
        print(json.dumps({"request_id": args.request_id, "status": "held"}))
        return 0
    if (set(proposal) != {"version", "action", "path"} or proposal.get("version") != 1
            or proposal.get("action") != "quarantine" or not isinstance(proposal.get("path"), str)):
        raise Hold("stored proposal outside cleaner action grammar")
    rows = [r for r in manifest.get("candidates", []) if isinstance(r, dict) and r.get("path") == proposal["path"]]
    if len(rows) != 1:
        raise Hold("proposed path absent or duplicated in manifest")
    row = rows[0]
    identity = [manifest["scan_id"], row["path"], row.get("device_inode"), row.get("mtime_utc")]
    key = hashlib.sha256(json.dumps(identity, separators=(",", ":")).encode()).hexdigest()
    gateway = Path(__file__).with_name("mesh-cleaner-action")
    done = subprocess.run([str(gateway), "--synthetic-root", str(root), "--state-dir", str(state),
                           "--quarantine", key, "--manifest", str(args.manifest), "--path", row["path"]],
                          capture_output=True, text=True, timeout=20)
    if done.returncode:
        raise Hold(f"gateway UNKNOWN rc={done.returncode}: {done.stderr[:200]}")
    receipt = json.loads(done.stdout)
    if receipt.get("key") != key or receipt.get("status") != "delivered":
        raise Hold("gateway did not prove delivered action")
    effect = Path(__file__).with_name("mesh-cleaner-effect")
    artifact_sha = hashlib.sha256(done.stdout.encode()).hexdigest()
    effects = (
        ("board", {"version": 1, "owner": "cleaner", "marker": "fyi",
                   "message": f"synthetic quarantine {row['path']} action:{key}"}),
        ("task", {"version": 1, "owner": "cleaner", "task_id": f"cleaner/{args.request_id}",
                  "status": "done", "artifact_sha256": artifact_sha}),
        ("handoff", {"version": 1, "owner": "cleaner", "invocation": args.request_id,
                     "summary": f"invocation:{args.request_id} synthetic quarantine action:{key} delivered"}),
    )
    for kind, payload in effects:
        effect_key = hashlib.sha256(f"{args.request_id}/{kind}".encode()).hexdigest()
        payload_path = state / "payloads" / f"{effect_key}.json"
        atomic(payload_path, payload)
        posted = subprocess.run([str(effect), "--synthetic-state", str(state), "--append", effect_key,
                                 "--kind", kind, "--payload", str(payload_path)],
                                capture_output=True, text=True, timeout=10)
        if posted.returncode:
            raise Hold(f"{kind} receipt UNKNOWN rc={posted.returncode}: {posted.stderr[:200]}")
        if os.environ.get("MESH_CLEANER_CANARY_FAULT") == f"kill-after-{kind}":
            os.kill(os.getpid(), signal.SIGKILL)
    print(json.dumps({"request_id": args.request_id, "status": "delivered", "action_key": key}))
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (Hold, OSError, ValueError, KeyError, json.JSONDecodeError, subprocess.TimeoutExpired) as exc:
        print(f"mesh-cleaner-canary: UNKNOWN {exc}", file=sys.stderr)
        raise SystemExit(3)
