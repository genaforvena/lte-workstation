#!/usr/bin/env python3
"""Synthetic private append-only effect tape for cleaner proposal settlement."""
import argparse
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import signal
import sys


class Unknown(Exception):
    pass


def payload_check(kind: str, value: object):
    if not isinstance(value, dict) or value.get("version") != 1 or value.get("owner") != "cleaner":
        raise Unknown("invalid cleaner effect payload")
    if kind == "board":
        if set(value) != {"version", "owner", "marker", "message"} or value["marker"] not in ("fyi", "done", "yield"):
            raise Unknown("invalid board payload")
        text = value["message"]
    elif kind == "task":
        if set(value) != {"version", "owner", "task_id", "status", "artifact_sha256"} or value["status"] != "done":
            raise Unknown("invalid task payload")
        if not re.fullmatch(r"cleaner/[A-Za-z0-9_.-]+", value["task_id"]):
            raise Unknown("task is not exact-owner cleaner")
        if not re.fullmatch(r"[0-9a-f]{64}", value["artifact_sha256"]):
            raise Unknown("task artifact digest invalid")
        text = value["task_id"]
    elif kind == "handoff":
        if set(value) != {"version", "owner", "invocation", "summary"}:
            raise Unknown("invalid handoff payload")
        if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]{0,63}", value["invocation"]):
            raise Unknown("invalid handoff invocation")
        text = value["summary"]
    else:
        raise Unknown("effect kind outside allowlist")
    if not isinstance(text, str) or not text or len(text.encode()) > 1000 or "\n" in text:
        raise Unknown("effect text missing or oversized")


def scan(path: Path):
    if not path.exists():
        return {}
    if path.stat().st_size > 8 * 1024 * 1024:
        raise Unknown("effect tape exceeds bound")
    rows = {}
    with path.open("rb") as stream:
        for raw in stream:
            if not raw.endswith(b"\n") or len(raw) > 8192:
                raise Unknown("partial or oversized effect frame")
            try:
                row = json.loads(raw)
            except (UnicodeError, ValueError) as exc:
                raise Unknown("malformed effect frame") from exc
            key = row.get("key") if isinstance(row, dict) else None
            if not isinstance(key, str) or not re.fullmatch(r"[0-9a-f]{64}", key) or key in rows:
                raise Unknown("duplicate or malformed effect key")
            kind, payload = row.get("kind"), row.get("payload")
            payload_check(kind, payload)
            encoded = json.dumps(payload, sort_keys=True, separators=(",", ":")).encode()
            if row.get("payload_sha256") != hashlib.sha256(encoded).hexdigest():
                raise Unknown("effect payload digest mismatch")
            rows[key] = row
    return rows


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--synthetic-state", required=True, type=Path)
    mode = parser.add_mutually_exclusive_group(required=True)
    mode.add_argument("--append", metavar="KEY")
    mode.add_argument("--status", metavar="KEY")
    parser.add_argument("--kind", choices=("board", "task", "handoff"))
    parser.add_argument("--payload", type=Path)
    args = parser.parse_args()
    state = args.synthetic_state.resolve(strict=True)
    if state == Path.home().resolve() / ".mesh" or state == Path.home().resolve() / ".mesh/cleaner":
        raise Unknown("live Mesh state excluded")
    key = args.append or args.status
    if not re.fullmatch(r"[0-9a-f]{64}", key):
        raise Unknown("invalid effect key")
    path = state / "effects.log"
    lockpath = state / "effects.lock"
    with lockpath.open("a+") as lock:
        fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
        rows = scan(path)
        if args.status:
            row = rows.get(key)
            print(json.dumps({"key": key, "status": "delivered" if row else "unknown",
                              "kind": row["kind"] if row else None}))
            return 0 if row else 3
        if not args.kind or args.payload is None:
            raise Unknown("kind and payload required")
        raw = args.payload.read_bytes()
        if len(raw) > 4096:
            raise Unknown("payload exceeds bound")
        payload = json.loads(raw)
        payload_check(args.kind, payload)
        encoded = json.dumps(payload, sort_keys=True, separators=(",", ":")).encode()
        digest = hashlib.sha256(encoded).hexdigest()
        prior = rows.get(key)
        if prior:
            if prior["kind"] != args.kind or prior["payload_sha256"] != digest:
                raise Unknown("effect identity conflict")
            print(json.dumps({"key": key, "status": "delivered", "kind": args.kind}))
            return 0
        frame = json.dumps({"key": key, "kind": args.kind, "payload_sha256": digest,
                            "payload": payload}, sort_keys=True, separators=(",", ":")).encode() + b"\n"
        fd = os.open(path, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
        try:
            if os.write(fd, frame) != len(frame):
                raise Unknown("short effect append")
            os.fsync(fd)
        finally:
            os.close(fd)
        directory = os.open(state, os.O_DIRECTORY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
        if os.environ.get("MESH_CLEANER_EFFECT_FAULT") == "kill-after-append":
            os.kill(os.getpid(), signal.SIGKILL)
        print(json.dumps({"key": key, "status": "delivered", "kind": args.kind}))
        return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (Unknown, OSError, ValueError, KeyError, json.JSONDecodeError) as exc:
        print(f"mesh-cleaner-effect: UNKNOWN {exc}", file=sys.stderr)
        raise SystemExit(3)
