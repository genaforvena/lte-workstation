#!/usr/bin/env bash
# reflex-cadence: 0 * * * *
set -euo pipefail
ROOT="$(cd -- "${MESH_REPO:-$HOME/lte-workstation}" && pwd -P)"; MESH="${MESH_DIR:-$HOME/.mesh}"; mkdir -p "$MESH/cleaner"
if [[ "${1:-}" == --test ]]; then echo 'mesh-cleaner-docs: smoke-test ok'; exit 0; fi
now=$(date -u +%FT%TZ); out="$MESH/cleaner/docs-${now}.json"; missing=()
while IFS= read -r f; do [[ -e "$ROOT/$f.findings.json" ]] || missing+=("$f"); done < <(git -C "$ROOT" ls-files 'docs/task-receipts/*.md')
python3 - "$out" "$now" "${missing[*]-}" <<'PY'
import json,sys
json.dump({'version':1,'checked_at':sys.argv[2],'missing_findings':sys.argv[3].split() if sys.argv[3] else [],'disposition':'report-only; pub review required for documentation changes'},open(sys.argv[1],'w'),indent=2)
PY
printf '%s docs=%s missing_findings=%s\n' "$now" "$out" "${#missing[@]}"
