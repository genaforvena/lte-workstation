#!/usr/bin/env bash
# reflex-cadence: 17 3 * * *
set -euo pipefail
MESH="${MESH_DIR:-$HOME/.mesh}"; mkdir -p "$MESH/cleaner"
if [[ "${1:-}" == --test ]]; then echo 'mesh-cleaner-receipt: smoke-test ok'; exit 0; fi
now=$(date -u +%FT%TZ); printf '%s\treceipt\t%s\n' "$now" "${MESH}/cleaner/latest.json" >> "$MESH/cleaner/runs.tsv"
printf '%s receipt=ok latest=%s\n' "$now" "$MESH/cleaner/latest.json"
