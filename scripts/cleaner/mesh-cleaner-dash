#!/usr/bin/env bash
# reflex-cadence: on-demand
set -euo pipefail
MESH="${MESH_DIR:-$HOME/.mesh}"; f="$MESH/cleaner/latest.json"
if [[ "${1:-}" == --test ]]; then
  td=$(mktemp -d); trap 'rm -rf "$td"' EXIT
  MESH="$td"; f="$MESH/cleaner/latest.json"
  mkdir -p "$MESH/cleaner"
  printf '%s\n' '{"scan_id":"test","head":"test","candidate_count":13,"held_count":1,"candidates":[{"path":".firecrawl/old.json","reasons":["disposable-generated"]},{"path":"docs/task-plans/live.tsv","reasons":["protected-root"]},{"path":"mystery-file","reasons":[]}]}' >"$f"
  for i in $(seq 1 10); do
    python3 - "$MESH" "$i" <<'PY'
import json,sys
m=sys.argv[1]; i=sys.argv[2]
p=f'{m}/cleaner/latest.json'; d=json.load(open(p))
d['candidates'].append({'path':f'.firecrawl/gen-{i}.json','reasons':['disposable-generated']})
json.dump(d,open(p,'w'))
PY
  done
  out="$(MESH_DIR="$MESH" "$0" --once)"
  grep -q 'actionable=11' <<<"$out"
  grep -q 'delete=11' <<<"$out"
  grep -q 'unknowns=1' <<<"$out"
  grep -q 'held-reasons=protected-root:1' <<<"$out"
  grep -q '(+3 more)' <<<"$out"
  grep -q 'mystery-file' <<<"$out"
  printf '%s\n' "$out"
  echo 'mesh-cleaner-dash: smoke-test ok'; exit 0
fi
if [[ ! -s "$f" ]]; then echo 'cleaner: UNKNOWN (no scan manifest)'; exit 2; fi
python3 - "$f" <<'PY'
import json,sys
d=json.load(open(sys.argv[1])); rows=d.get('candidates',[])
actionable=[r for r in rows if 'disposable-generated' in (r.get('reasons') or [])]
held=[r for r in rows if r not in actionable]
unknown=[r for r in rows if not r.get('reasons')]
count_drift=(d.get('candidate_count',len(rows))-len(rows), d.get('held_count',len(held))-len(held))
from collections import Counter
reasons=Counter(x for r in held for x in (r.get('reasons') or ['unknown']))
old=sorted(rows,key=lambda r: (r.get('mtime_utc') or '',r['path']))[0]['path'] if rows else 'none'
def paths(rs,n=8):
    s=','.join(r['path'] for r in rs[:n]) or 'none'
    return s+(f' (+{len(rs)-n} more)' if len(rs)>n else '')
print('cleaner scan=%s head=%s candidates=%s held=%s actionable=%s delete=%s oldest=%s' % (d.get('scan_id','UNKNOWN'),d.get('head','UNKNOWN'),d.get('candidate_count',0),d.get('held_count',0),len(actionable),len(actionable),old))
print('unknowns=%s count-drift=candidates:%+d,held:%+d' % (len(unknown),count_drift[0],count_drift[1]))
print('held-reasons=%s' % (','.join('%s:%s'%x for x in sorted(reasons.items())) or 'none'))
print('actionable-paths=%s' % paths(actionable))
print('held-paths=%s' % paths(held))
print('unknown-paths=%s' % (paths(unknown) if unknown else 'none'))
print('last-receipt=%s retry=next scheduled scan; disposition=quarantine only with explicit apply and stable safety gates' % sys.argv[1])
PY
