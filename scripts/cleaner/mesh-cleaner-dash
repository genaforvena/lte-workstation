#!/usr/bin/env bash
# reflex-cadence: on-demand
set -euo pipefail
MESH="${MESH_DIR:-$HOME/.mesh}"; f="$MESH/cleaner/latest.json"
if [[ "${1:-}" == --test ]]; then mkdir -p "$MESH/cleaner"; printf '{"candidate_count":0,"held_count":0}' >"$f"; "$0" --once | grep -q 'candidates=0'; echo 'mesh-cleaner-dash: smoke-test ok'; exit 0; fi
if [[ ! -s "$f" ]]; then echo 'cleaner: UNKNOWN (no scan manifest)'; exit 2; fi
python3 - "$f" <<'PY'
import json,sys
d=json.load(open(sys.argv[1])); rows=d.get('candidates',[])
old=rows[0]['path'] if rows else 'none'
print('cleaner scan=%s head=%s candidates=%s held=%s oldest=%s' % (d.get('scan_id','UNKNOWN'),d.get('head','UNKNOWN'),d.get('candidate_count',0),d.get('held_count',0),old))
print('last-receipt=%s retry=next scheduled scan; disposition=report-only' % sys.argv[1])
PY
