#!/usr/bin/env bash
# reflex-cadence: */15 * * * *
# Inventory with an explicit positive class for reversible generated cleanup.
set -euo pipefail
ROOT="$(cd -- "${MESH_REPO:-$HOME/lte-workstation}" && pwd -P)"
MESH="${MESH_DIR:-$HOME/.mesh}"; mkdir -p "$MESH"
ts(){ date -u +%FT%TZ; }
if [[ "${1:-}" == --test ]]; then
  t=$(mktemp -d); trap 'rm -rf "$t"' EXIT
  git -C "$t" init -q; git -C "$t" config user.email test@example; git -C "$t" config user.name test
  printf seed >"$t/seed"; git -C "$t" add seed; git -C "$t" commit -qm seed; printf x >"$t/new"
  MESH_REPO="$t" MESH_DIR="$t/.mesh" "$0" --once >/dev/null
  test -s "$t/.mesh/cleaner/latest.json"; grep -q 'new' "$t/.mesh/cleaner/latest.json"
  echo 'mesh-cleaner-scan: smoke-test ok'; exit 0
fi
mkdir -p "$MESH/cleaner"
now=$(ts); head=$(git -C "$ROOT" rev-parse HEAD 2>/dev/null || echo UNKNOWN)
run="${now//[-:TZ]/}"; out="$MESH/cleaner/scan-$run.json"; tmp="$out.tmp"
status=$(git -C "$ROOT" status --porcelain=v1 --untracked-files=all 2>/dev/null || true)
python3 - "$ROOT" "$head" "$now" "$status" >"$tmp" <<'PY'
import json, pathlib, sys, time
root, head, scanned, raw = sys.argv[1:]
rows=[]
for line in raw.splitlines():
    if not line: continue
    path=line[3:] if len(line)>3 else line
    if ' -> ' in path: path=path.split(' -> ',1)[-1]
    p=pathlib.Path(root, path)
    try:
        st=p.stat(); size=st.st_size; mtime=time.strftime('%Y-%m-%dT%H:%M:%SZ',time.gmtime(st.st_mtime)); ident=f'{st.st_dev}:{st.st_ino}'
    except OSError: size=0; mtime=None; ident=None
    protected=path.startswith(('.git/','memory/','tests/','scripts/','charter/','docs/task-plans/','docs/task-receipts/','cleaner/'))
    generated=path.startswith('.firecrawl/') and path.endswith('.json')
    if protected: reasons=['protected-root']
    elif generated: reasons=['disposable-generated']
    else: reasons=['review-required']
    rows.append({'path':path,'git':line[:2].strip() or '??','bytes':size,'mtime_utc':mtime,'device_inode':ident,'reasons':reasons})
rows.sort(key=lambda r: (r['mtime_utc'] or '',r['path']))
print(json.dumps({'version':1,'scan_id':scanned,'repository':root,'head':head,'candidates':rows,'candidate_count':len(rows),'held_count':sum('protected-root' in r['reasons'] for r in rows)},indent=2,sort_keys=True))
PY
mv "$tmp" "$out"; ln -sfn "$(basename "$out")" "$MESH/cleaner/latest.json"
count=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["candidate_count"])' "$out")
held=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["held_count"])' "$out")
printf '%s\tscan\t%s\t%s\n' "$now" "$out" "$count" >> "$MESH/cleaner/runs.tsv"
printf '%s scan=%s head=%s candidates=%s held=%s\n' "$now" "$out" "$head" "$count" "$held"
