#!/usr/bin/env bash
# reflex-cadence: */15 * * * *
# Inventory with an explicit positive class for reversible generated cleanup.
set -euo pipefail
ROOT="$(cd -- "${MESH_REPO:-$HOME/lte-workstation}" && pwd -P)"
MESH="${MESH_DIR:-$HOME/.mesh}"; mkdir -p "$MESH"
ts(){ date -u +%FT%TZ; }
if [[ "${1:-}" == --test ]]; then
  t=$(mktemp -d); trap 'rm -rf "$t"' EXIT
  git -C "$t" init -q; git -C "$t" config user.email test@example; git -C "$t" config user.name test
  printf seed >"$t/seed"; git -C "$t" add seed; git -C "$t" commit -qm seed; printf x >"$t/new"
  MESH_REPO="$t" MESH_DIR="$t/.mesh" "$0" --once >/dev/null
  test -s "$t/.mesh/cleaner/latest.json"; grep -q 'new' "$t/.mesh/cleaner/latest.json"
  echo 'mesh-cleaner-scan: smoke-test ok'; exit 0
fi
mkdir -p "$MESH/cleaner"
now=$(ts); out="$MESH/cleaner/scan-${now//[-:TZ]/}.json"; tmp="$out.tmp"
trap 'rm -f -- "$tmp"' EXIT
python3 - "$ROOT" "$now" >"$tmp" <<'PY'
import json, os, pathlib, subprocess, sys, time
root, scanned = sys.argv[1:]
head = subprocess.run(['git', '-C', root, 'rev-parse', '--verify', 'HEAD'],
                      stdout=subprocess.PIPE, stderr=subprocess.PIPE)
if head.returncode:
    # An unborn repository has no HEAD; an unreadable repository must fail.
    symbolic = subprocess.run(['git', '-C', root, 'symbolic-ref', '-q', 'HEAD'],
                              stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if symbolic.returncode:
        raise SystemExit('cleaner scan: cannot read repository HEAD')
status = subprocess.run(['git', '-C', root, 'status', '--porcelain=v1', '-z',
                         '--untracked-files=all'], stdout=subprocess.PIPE,
                        stderr=subprocess.PIPE)
if status.returncode:
    raise SystemExit('cleaner scan: git status failed: ' + status.stderr.decode('utf-8', 'replace')[:200])
records = status.stdout.split(b'\0')
if records[-1:] != [b'']:
    raise SystemExit('cleaner scan: incomplete Git status record')
rows = []
i = 0
while i < len(records) - 1:
    record = records[i]
    if len(record) < 4 or record[2:3] != b' ':
        raise SystemExit('cleaner scan: malformed Git status record')
    code = record[:2]
    path = os.fsdecode(record[3:])
    i += 1
    if b'R' in code or b'C' in code:
        if i >= len(records) - 1:
            raise SystemExit('cleaner scan: missing rename source')
        i += 1  # -z places the destination first; the second path is the old name.
    p = pathlib.Path(root, path)
    try:
        st = p.stat()
        size = st.st_size
        mtime = time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime(st.st_mtime))
        ident = f'{st.st_dev}:{st.st_ino}'
    except OSError:
        size, mtime, ident = 0, None, None
    protected = path.startswith(('.git/', 'memory/', 'tests/', 'scripts/', 'charter/',
                                 'docs/task-plans/', 'docs/task-receipts/', 'cleaner/'))
    generated = path.startswith('.firecrawl/') and path.endswith('.json')
    reasons = ['protected-root'] if protected else ['disposable-generated'] if generated else ['review-required']
    rows.append({'path': path, 'git': code.decode('ascii').strip() or '??',
                 'bytes': size, 'mtime_utc': mtime, 'device_inode': ident, 'reasons': reasons})
rows.sort(key=lambda r: (r['mtime_utc'] or '', r['path']))
print(json.dumps({'version': 1, 'scan_id': scanned, 'repository': root,
                  'head': head.stdout.decode().strip() if head.returncode == 0 else 'UNKNOWN',
                  'candidates': rows, 'candidate_count': len(rows),
                  'held_count': sum('protected-root' in r['reasons'] for r in rows)},
                 indent=2, sort_keys=True))
PY
mv "$tmp" "$out"; ln -sfn "$(basename "$out")" "$MESH/cleaner/latest.json"
count=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["candidate_count"])' "$out")
head=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["head"])' "$out")
held=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["held_count"])' "$out")
printf '%s\tscan\t%s\t%s\n' "$now" "$out" "$count" >> "$MESH/cleaner/runs.tsv"
printf '%s scan=%s head=%s candidates=%s held=%s\n' "$now" "$out" "$head" "$count" "$held"
