#!/usr/bin/env bash
# reflex-cadence: */15 * * * *
# Report-only safety gate evaluator; no candidate is mutated.
set -euo pipefail
MESH="${MESH_DIR:-$HOME/.mesh}"; f="$MESH/cleaner/latest.json"
if [[ "${1:-}" == --test ]]; then
  t=$(mktemp -d); trap 'rm -rf "$t"' EXIT; mkdir -p "$t/.mesh/cleaner"
  printf '{"version":1,"candidates":[{"path":"x","reasons":["review-required"]}]}' >"$t/.mesh/cleaner/latest.json"
  MESH_DIR="$t/.mesh" "$0" --once | grep -q 'HELD'; echo 'mesh-cleaner-settle: smoke-test ok'; exit 0
fi
if [[ ! -s "$f" ]]; then echo 'mesh-cleaner-settle: UNKNOWN no scan manifest'; exit 2; fi
python3 - "$f" <<'PY'
import json,sys
d=json.load(open(sys.argv[1])); rows=d.get('candidates',[])
print('settle scan=%s candidates=%d' % (d.get('scan_id','UNKNOWN'),len(rows)))
for r in rows[:20]: print('HELD path=%s gates=%s' % (r['path'],','.join(r.get('reasons',[]) or ['unknown'])))
print('disposition=report-only; mutations=0; retry=next scan or explicit steward review')
PY
