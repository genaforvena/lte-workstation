#!/usr/bin/env bash
# reflex-cadence: */15 * * * *
# Safety-gated reversible quarantine evaluator. Default is a dry run; --apply is explicit.
set -euo pipefail
MESH="${MESH_DIR:-$HOME/.mesh}"; f="$MESH/cleaner/latest.json"
if [[ "${1:-}" == --test ]]; then
  t=$(mktemp -d); trap 'rm -rf "$t"' EXIT; mkdir -p "$t/.mesh/cleaner" "$t/repo/.firecrawl"
  printf x >"$t/repo/.firecrawl/old.json"; touch -d '2 hours ago' "$t/repo/.firecrawl/old.json"
  printf y >"$t/repo/.firecrawl/mtime.json"; touch -d '2 hours ago' "$t/repo/.firecrawl/mtime.json"
  python3 - "$t/.mesh/cleaner/latest.json" "$t/repo/.firecrawl/old.json" "$t/repo/.firecrawl/mtime.json" <<'PY'
import json, os, sys, time
p=sys.argv[2]; st=os.stat(p); mp=sys.argv[3]; mst=os.stat(mp)
json.dump({'version':1,'candidates':[{'path':'.firecrawl/old.json','reasons':['disposable-generated'],
 'device_inode':f'{st.st_dev}:{st.st_ino}',
 'mtime_utc':time.strftime('%Y-%m-%dT%H:%M:%SZ',time.gmtime(st.st_mtime)),
 'active_refs':[],'owner_refs':[],'task_refs':[]},
 {'path':'.firecrawl/mtime.json','reasons':['disposable-generated'],
  'device_inode':f'{mst.st_dev}:{mst.st_ino}','mtime_utc':'2000-01-01T00:00:00Z'},
 {'path':'.firecrawl/active.json','reasons':['disposable-generated'],'active_refs':['open-by-test']},
 {'path':'scripts/protected.json','reasons':['disposable-generated']},
 {'path':'x','reasons':['review-required']}]},open(sys.argv[1],'w'))
PY
  out="$(MESH_REPO="$t/repo" MESH_DIR="$t/.mesh" MESH_CLEANER_APPLY=1 "$0" --once)"
  grep -q 'QUARANTINED path=.firecrawl/old.json' <<<"$out"
  test ! -e "$t/repo/.firecrawl/old.json"
  test -n "$(find "$t/.mesh/cleaner/quarantine" -path '*/.firecrawl/old.json' -print -quit)"
  test -s "$t/.mesh/cleaner/settle-latest.json"
  grep -q 'HELD path=x' <<<"$out"
  grep -q 'HELD path=.firecrawl/active.json gates=active_refs:open-by-test' <<<"$out"
  grep -q 'HELD path=scripts/protected.json gates=protected-root' <<<"$out"
  grep -q 'HELD path=.firecrawl/mtime.json gates=mtime-changed' <<<"$out"
  printf '%s\n' "$out"
  echo 'mesh-cleaner-settle: smoke-test ok'; exit 0
fi
ROOT="$(cd -- "${MESH_REPO:-$HOME/lte-workstation}" && pwd -P)"
QUAR="$MESH/cleaner/quarantine/$(date -u +%Y%m%dT%H%M%SZ)-$(python3 -c 'import uuid; print(uuid.uuid4().hex)')"
python3 - "$f" "$ROOT" "$QUAR" "${MESH_CLEANER_APPLY:-0}" <<'PY'
import fcntl, hashlib, json, os, pathlib, stat, sys, tempfile, time, uuid

manifest, repository, quarantine, apply_flag = sys.argv[1:]
root = pathlib.Path(repository)
quar = pathlib.Path(quarantine).absolute()
apply = apply_flag == '1'
cleaner = quar.parent.parent
receipt = cleaner / 'settle-latest.json'
audits = cleaner / 'settle-receipts'
cleaner.mkdir(parents=True, exist_ok=True)

def atomic_json(path, state):
    fd, tmp = tempfile.mkstemp(prefix='.settle-', dir=path.parent)
    try:
        with os.fdopen(fd, 'w') as out:
            json.dump(state, out, indent=2, sort_keys=True)
            out.write('\n')
            out.flush()
            os.fsync(out.fileno())
        os.replace(tmp, path)
        directory = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)

def save_receipt(state):
    audits.mkdir(exist_ok=True)
    planned = any(row.get('status') == 'planned' for row in state['outcomes'])
    if planned:
        # Publish the recoverable checkpoint before any supplementary audit write.
        atomic_json(receipt, state)
        checkpoint = audits / (state['run_id'] + '-' + str(len(state['outcomes'])) + '.planned.json')
        if not checkpoint.exists():
            atomic_json(checkpoint, state)
    atomic_json(audits / (state['run_id'] + '.json'), state)
    if not planned:
        atomic_json(receipt, state)

def digest_file(path):
    digest = hashlib.sha256()
    with path.open('rb') as source:
        for chunk in iter(lambda: source.read(1024 * 1024), b''):
            digest.update(chunk)
    return digest.hexdigest()

def observed(path, expected):
    # No symlink may stand in for either endpoint or an endpoint's parent.
    if path.resolve() != path:
        return False
    try:
        st = path.lstat()
    except FileNotFoundError:
        return False
    return (stat.S_ISREG(st.st_mode)
            and f'{st.st_dev}:{st.st_ino}' == expected['device_inode']
            and st.st_size == expected['bytes']
            and time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime(st.st_mtime)) == expected['mtime_utc']
            and digest_file(path) == expected['sha256'])

def pending_endpoints(state, row):
    path = row['path']
    relative = pathlib.Path(path)
    if (not isinstance(path, str) or not path.startswith('.firecrawl/')
            or not path.endswith('.json') or relative.is_absolute()
            or '..' in relative.parts or '.' in relative.parts):
        raise ValueError('invalid-pending-path')
    prior_quar = pathlib.Path(state['quarantine'])
    if (prior_quar.parent != quar.parent or prior_quar.resolve() != prior_quar
            or pathlib.Path(row['source']) != root / relative
            or pathlib.Path(row['destination']) != prior_quar / relative):
        raise ValueError('invalid-pending-endpoints')
    source = root / relative
    dest = prior_quar / relative
    if source.resolve() != source or dest.resolve() != dest:
        raise ValueError('symlinked-pending-endpoint')
    return source, dest

# Serialize invocations so an older pending checkpoint cannot be overwritten
# by another settler between validation and the move.
with open(cleaner / '.settle.lock', 'a+') as lock:
    fcntl.flock(lock, fcntl.LOCK_EX)
    if receipt.exists():
        previous = json.loads(receipt.read_text())
        unresolved = [row for row in previous.get('outcomes', [])
                      if row.get('status') == 'planned'
                      or (row.get('status') == 'unknown' and 'destination' in row)]
        if len(unresolved) > 1:
            print('UNKNOWN multiple pending moves; receipt=%s' % receipt)
            raise SystemExit(2)
        if unresolved and not apply:
            print('UNKNOWN pending settlement; apply required for reconciliation; receipt=%s' % receipt)
            raise SystemExit(2)
        if 'run_id' not in previous:
            previous['run_id'] = uuid.uuid4().hex
        elif not isinstance(previous['run_id'], str) or len(previous['run_id']) != 32 or any(c not in '0123456789abcdef' for c in previous['run_id']):
            print('UNKNOWN invalid prior receipt id; receipt=%s' % receipt)
            raise SystemExit(2)
        # Archive completed receipts as well: the next evaluation may replace latest.
        if not (audits / (previous['run_id'] + '.json')).exists():
            audits.mkdir(exist_ok=True)
            atomic_json(audits / (previous['run_id'] + '.json'), previous)
        if unresolved:
            checkpoint = audits / (previous['run_id'] + '-prior-pending.json')
            if not checkpoint.exists():
                atomic_json(checkpoint, previous)
        for row in unresolved:
            try:
                source, dest = pending_endpoints(previous, row)
                source_present = os.path.lexists(source)
                dest_present = os.path.lexists(dest)
                if source_present and dest_present:
                    raise ValueError('source-and-destination-present')
                if not source_present and not dest_present:
                    raise ValueError('source-and-destination-missing')
                candidate = source if source_present else dest
                if not observed(candidate, row):
                    raise ValueError('pending-evidence-mismatch')
                if source_present:
                    dest.parent.mkdir(parents=True, exist_ok=True)
                    if source.stat().st_dev != dest.parent.stat().st_dev:
                        raise ValueError('quarantine-cross-device')
                    os.rename(source, dest)
                    if not observed(dest, row):
                        raise ValueError('post-move-evidence-mismatch')
                    row['recovery'] = 'resumed-source-only'
                else:
                    row['recovery'] = 'reconciled-destination-only'
                row['status'] = 'quarantined'
                previous['mutations'] = previous.get('mutations', 0) + 1
                save_receipt(previous)
                print('RECOVERED path=%s mode=%s to=%s' % (row['path'], row['recovery'], dest))
            except (OSError, KeyError, TypeError, ValueError) as error:
                print('UNKNOWN pending path=%s gates=%s; receipt=%s' % (row.get('path'), error, receipt))
                raise SystemExit(2)
        if unresolved:
            print('disposition=recovered; mutations=%d; receipt=%s' % (previous['mutations'], receipt))
            raise SystemExit(0)

    if not pathlib.Path(manifest).is_file() or not pathlib.Path(manifest).stat().st_size:
        print('mesh-cleaner-settle: UNKNOWN no scan manifest')
        raise SystemExit(2)

    d = json.loads(pathlib.Path(manifest).read_text())
    if (apply and receipt.exists() and previous.get('apply')
            and isinstance(d.get('scan_id'), str) and d['scan_id']
            and previous.get('scan_id') == d['scan_id']
            and any(row.get('status') == 'quarantined' for row in previous.get('outcomes', []))):
        print('settle scan=%s already-settled; mutations=0; receipt=%s' % (d['scan_id'], receipt))
        raise SystemExit(0)
    rows = d.get('candidates', [])
    outcomes = []
    mutations = 0
    state = {'version': 1, 'run_id': uuid.uuid4().hex, 'scan_id': d.get('scan_id'),
             'apply': apply, 'mutations': 0, 'quarantine': str(quar),
             'outcomes': outcomes, 'undo': 'restore each destination to its source'}
    print('settle scan=%s candidates=%d apply=%s quarantine=%s' % (d.get('scan_id','UNKNOWN'), len(rows), apply, quar))
    for r in rows:
        path = r.get('path',''); reasons = r.get('reasons') or ['unknown']; p = (root / path).resolve()
        try: inside = p.relative_to(root)
        except ValueError: outcomes.append({'path':path,'status':'held','gates':['outside-root']}); print('HELD path=%s gates=outside-root' % path); continue
        protected = path.startswith(('.git/','memory/','tests/','scripts/','charter/','docs/task-plans/','docs/task-receipts/','cleaner/'))
        if protected:
            outcomes.append({'path':path,'status':'held','gates':['protected-root']}); print('HELD path=%s gates=protected-root' % path); continue
        refs = []
        for key in ('active_refs','owner_refs','task_refs'):
            refs.extend('%s:%s' % (key,x) for x in (r.get(key) or []))
        disposable = 'disposable-generated' in reasons and len(reasons)==1 and path.startswith('.firecrawl/') and path.endswith('.json')
        if not disposable: outcomes.append({'path':path,'status':'held','gates':reasons}); print('HELD path=%s gates=%s' % (path,','.join(reasons))); continue
        if refs: outcomes.append({'path':path,'status':'held','gates':refs}); print('HELD path=%s gates=%s' % (path,','.join(refs))); continue
        try:
            st = p.stat(); age = time.time()-st.st_mtime
            if age < 3600: outcomes.append({'path':path,'status':'held','gates':['not-settled']}); print('HELD path=%s gates=not-settled' % path); continue
            identity = f'{st.st_dev}:{st.st_ino}'; mtime = time.strftime('%Y-%m-%dT%H:%M:%SZ',time.gmtime(st.st_mtime))
            if not r.get('device_inode') or not r.get('mtime_utc'): outcomes.append({'path':path,'status':'held','gates':['missing-stability-observation']}); print('HELD path=%s gates=missing-stability-observation' % path); continue
            if r['device_inode'] != identity: outcomes.append({'path':path,'status':'held','gates':['identity-changed']}); print('HELD path=%s gates=identity-changed' % path); continue
            if r['mtime_utc'] != mtime: outcomes.append({'path':path,'status':'held','gates':['mtime-changed']}); print('HELD path=%s gates=mtime-changed' % path); continue
            if not apply: outcomes.append({'path':path,'status':'ready','gates':['stable-generated']}); print('READY path=%s gates=stable-generated; use MESH_CLEANER_APPLY=1' % path); continue
            dest = quar / inside
            if os.path.lexists(dest): outcomes.append({'path':path,'status':'held','gates':['quarantine-destination-exists']}); print('HELD path=%s gates=quarantine-destination-exists' % path); continue
            if p != root / pathlib.Path(path) or not stat.S_ISREG(st.st_mode):
                outcomes.append({'path':path,'status':'held','gates':['unsafe-source']}); print('HELD path=%s gates=unsafe-source' % path); continue
            dest.parent.mkdir(parents=True,exist_ok=True)
            if st.st_dev != dest.parent.stat().st_dev:
                outcomes.append({'path':path,'status':'held','gates':['quarantine-cross-device']}); print('HELD path=%s gates=quarantine-cross-device' % path); continue
            digest = digest_file(p)
            planned = {'path':path,'status':'planned','source':str(p),'destination':str(dest),
                       'bytes':st.st_size,'sha256':digest,'device_inode':identity,'mtime_utc':mtime}
            outcomes.append(planned); state['mutations'] = mutations; save_receipt(state)
            os.rename(p, dest)
            if not observed(dest, planned):
                planned['status'] = 'unknown'; planned['error'] = 'post-move-evidence-mismatch'
                save_receipt(state)
                print('UNKNOWN path=%s gates=post-move-evidence-mismatch' % path)
                raise SystemExit(2)
            planned['status'] = 'quarantined'; mutations += 1
            state['mutations'] = mutations; save_receipt(state)
            print('QUARANTINED path=%s to=%s' % (path,dest))
        except OSError as error:
            if outcomes and outcomes[-1].get('status') == 'planned':
                outcomes[-1]['status'] = 'unknown'
                outcomes[-1]['error'] = str(error)
                save_receipt(state)
                print('UNKNOWN pending path=%s gates=%s' % (path,error))
                raise SystemExit(2)
            outcomes.append({'path':path,'status':'unknown','error':str(error)})
            print('UNKNOWN path=%s gates=%s error=%s' % (path,','.join(reasons),error))
    state['mutations'] = mutations
    save_receipt(state)
    print('disposition=quarantine; mutations=%d; receipt=%s; undo=restore from quarantine receipt' % (mutations,receipt))
PY
