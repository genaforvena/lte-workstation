#!/usr/bin/env bash
# reflex-cadence: */15 * * * *
# Safety-gated reversible quarantine evaluator. Default is a dry run; --apply is explicit.
set -euo pipefail
MESH="${MESH_DIR:-$HOME/.mesh}"; f="$MESH/cleaner/latest.json"
if [[ "${1:-}" == --test ]]; then
  t=$(mktemp -d); trap 'rm -rf "$t"' EXIT; mkdir -p "$t/.mesh/cleaner" "$t/repo/.firecrawl"
  printf x >"$t/repo/.firecrawl/old.json"; touch -d '2 hours ago' "$t/repo/.firecrawl/old.json"
  python3 - "$t/.mesh/cleaner/latest.json" <<'PY'
import json,sys
json.dump({'version':1,'candidates':[{'path':'.firecrawl/old.json','reasons':['disposable-generated'],'device_inode':None,'mtime_utc':'2000-01-01T00:00:00Z'},{'path':'x','reasons':['review-required']}]},open(sys.argv[1],'w'))
PY
  out="$(MESH_REPO="$t/repo" MESH_DIR="$t/.mesh" MESH_CLEANER_APPLY=1 "$0" --once)"
  grep -q 'QUARANTINED path=.firecrawl/old.json' <<<"$out"
  test ! -e "$t/repo/.firecrawl/old.json"
  test -n "$(find "$t/.mesh/cleaner/quarantine" -path '*/.firecrawl/old.json' -print -quit)"
  test -s "$t/.mesh/cleaner/settle-latest.json"
  grep -q 'HELD path=x' <<<"$out"
  printf '%s\n' "$out"
  echo 'mesh-cleaner-settle: smoke-test ok'; exit 0
fi
if [[ ! -s "$f" ]]; then echo 'mesh-cleaner-settle: UNKNOWN no scan manifest'; exit 2; fi
ROOT="$(cd -- "${MESH_REPO:-$HOME/lte-workstation}" && pwd -P)"
QUAR="$MESH/cleaner/quarantine/$(date -u +%Y%m%dT%H%M%SZ)"
python3 - "$f" "$ROOT" "$QUAR" "${MESH_CLEANER_APPLY:-0}" <<'PY'
import json, os, pathlib, shutil, sys, time
d=json.load(open(sys.argv[1])); root=pathlib.Path(sys.argv[2]); quar=pathlib.Path(sys.argv[3]); apply=sys.argv[4]=='1'
receipt=quar.parent.parent/'settle-latest.json'; rows=d.get('candidates',[]); outcomes=[]
print('settle scan=%s candidates=%d apply=%s quarantine=%s' % (d.get('scan_id','UNKNOWN'),len(rows),apply,quar))
mutations=0
for r in rows[:20]:
    path=r.get('path',''); reasons=r.get('reasons') or ['unknown']; p=(root/path).resolve()
    try: inside=p.relative_to(root)
    except ValueError: outcomes.append({'path':path,'status':'held','gates':['outside-root']}); print('HELD path=%s gates=outside-root' % path); continue
    disposable='disposable-generated' in reasons and path.startswith('.firecrawl/') and path.endswith('.json')
    if not disposable: outcomes.append({'path':path,'status':'held','gates':reasons}); print('HELD path=%s gates=%s' % (path,','.join(reasons))); continue
    try:
        st=p.stat(); age=time.time()-st.st_mtime
        if age < 3600: outcomes.append({'path':path,'status':'held','gates':['not-settled']}); print('HELD path=%s gates=not-settled' % path); continue
        if r.get('device_inode') and r['device_inode'] != f'{st.st_dev}:{st.st_ino}': outcomes.append({'path':path,'status':'held','gates':['identity-changed']}); print('HELD path=%s gates=identity-changed' % path); continue
        if not apply: outcomes.append({'path':path,'status':'ready','gates':['stable-generated']}); print('READY path=%s gates=stable-generated; use MESH_CLEANER_APPLY=1' % path); continue
        dest=quar/inside; dest.parent.mkdir(parents=True,exist_ok=True); shutil.move(str(p),str(dest)); mutations += 1
        outcomes.append({'path':path,'status':'quarantined','destination':str(dest)}); print('QUARANTINED path=%s to=%s' % (path,dest))
    except OSError as e: outcomes.append({'path':path,'status':'unknown','error':str(e)}); print('UNKNOWN path=%s gates=%s error=%s' % (path,','.join(reasons),e))
json.dump({'version':1,'scan_id':d.get('scan_id'),'apply':apply,'mutations':mutations,'outcomes':outcomes},open(receipt,'w'),indent=2,sort_keys=True)
print('disposition=quarantine; mutations=%d; receipt=%s; undo=restore from quarantine receipt' % (mutations,receipt))
PY
