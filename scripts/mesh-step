#!/usr/bin/env bash
# orphan-ok: on-demand step counter — wire via # reflex-cadence: when ready for scheduling
# mesh-step — the body's STEP COUNTER sense: cumulative steps (since boot) + step delta.
# Reads the phone's STEP_COUNTER sensor (Android hardware step counter) via termux-sensor
# over SSH. No existing tool reads step count as a standalone signal — mesh-body-motion
# fuses it into a locomotion classification but does NOT expose the raw count or delta.
#
# Step counter is a dedicated hardware sensor (accelerometer-based, always-on, battery-backed)
# that maintains a total step count since the last phone reboot. It's the mesh's only sensor
# that gives a true CUMULATIVE activity metric — accel/gyro/mag are instantaneous.
#
# Classification (vs previous read):
#   ACTIVE  — step count increased → the body WALKED since last check
#   STILL   — step count unchanged → the body did NOT walk (may be sitting/standing/on desk)
#   SEEDING — first read (baseline only, no classification)
#
# Uses mesh-state-touch on EVERY successful run so a long-STILL value (no steps between
# reads) does not decay to FALSE STALE — mtime = ran-live, content = value-changed.
#
# Exit codes:
#   0 = artifact produced (ACTIVE/STILL/SEEDING)
#   2 = phone unreachable or sensor absent — never fakes a reading
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes"

STATE="$HOME/.mesh/.step-state"
OFFLINEFILE="$HOME/.mesh/.step-offline"

# read_step_counter <ip> → echoes integer step count, or returns 1 on failure.
# Retries once because termux-sensor occasionally returns an empty/incomplete JSON
# on the first attempt (same driver-race class as vl_gyro / akm09918).
read_step_counter() {
  local _ip="$1" _out _steps
  for _try in 1 2; do
    _out="$(timeout 12 ssh -p "${PHONE_SSH_PORT:-8022}" -o BatchMode=yes -o ConnectTimeout=6 \
      -o StrictHostKeyChecking=accept-new "${PHONE_USER:-u0_a380}@$_ip" \
      "timeout 8 termux-sensor -s STEP_COUNTER -n 1 2>/dev/null" </dev/null 2>/dev/null)" || continue
    [ -n "$_out" ] || continue
    _steps="$(printf '%s' "$_out" | python3 -c '
import json, sys
s = sys.stdin.read().strip()
try:
    d, _ = json.JSONDecoder().raw_decode(s)
    v = d.get("STEP_COUNTER", {}).get("values", [])
    if v: print(int(v[0]))
except Exception:
    pass
' 2>/dev/null)"
    [ -n "$_steps" ] && { printf '%s' "$_steps"; return 0; }
  done
  return 1
}

if [ "${1:-}" = --test ]; then
  command -v python3 >/dev/null 2>&1 || { echo "smoke-test: FAIL (no python3)"; exit 1; }
  command -v ssh >/dev/null 2>&1 || { echo "smoke-test: FAIL (no ssh)"; exit 1; }
  command -v mesh-phone-ip >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-phone-ip)"; exit 1; }
  mkdir -p "$HOME/.mesh" 2>/dev/null || { echo "smoke-test: FAIL (no ~/.mesh)"; exit 1; }
  command -v mesh-state-touch >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-state-touch)"; exit 1; }

  fail=0

  # --classify: given prev_steps current_steps → verdict
  _classify() {
    local prev="$1" cur="$2"
    if [ -z "$prev" ]; then
      echo "SEEDING"
    elif [ "$cur" -gt "$prev" ]; then
      echo "ACTIVE"
    else
      echo "STILL"
    fi
  }

  r="$(_classify "" 100)"
  [ "$r" = "SEEDING" ] || { echo "  FAIL: no prev → SEEDING, got $r"; fail=1; }

  r="$(_classify 1000 1005)"
  [ "$r" = "ACTIVE" ] || { echo "  FAIL: 1000→1005 should be ACTIVE, got $r"; fail=1; }

  r="$(_classify 1000 1000)"
  [ "$r" = "STILL" ] || { echo "  FAIL: 1000→1000 should be STILL, got $r"; fail=1; }

  r="$(_classify 1000 999)"
  [ "$r" = "STILL" ] || { echo "  FAIL: 1000→999 (reboot/reset) should be STILL, got $r"; fail=1; }

  # Real SSH reachability check — phone_reachable_ip does a real ConnectTimeout=3 probe
  source "$HOME/.local/bin/mesh-patterns.sh" 2>/dev/null || true
  if command -v phone_reachable_ip >/dev/null 2>&1; then
    phone_reachable_ip >/dev/null 2>&1 || { echo "smoke-test: n/a (phone unreachable — step sense unavailable); classify-logic ok"; [ "$fail" = 0 ] && exit 2; exit 1; }
  fi
  # REAL-READ assertion: reachability ≠ producing. The step counter read must yield an integer
  # or the sense is hollow (cron-green with no real artifact).
  _spip="$(timeout 10 mesh-phone-ip 2>/dev/null)"
  if [ -n "$_spip" ]; then
    read_step_counter "$_spip" >/dev/null 2>&1 \
      || { echo "smoke-test: n/a (STEP_COUNTER did not yield an integer — sensor absent or not producing); classify-logic ok"; exit 2; }
  fi

  [ "$fail" = 1 ] && { echo "smoke-test: FAIL"; exit 1; }
  echo "smoke-test: ok (classify: SEEDING/ACTIVE/STILL + REAL STEP_COUNTER read)"
  exit 0
fi

# --- Phone reachability gate ---
pip="$(timeout 10 mesh-phone-ip 2>/dev/null)" || {
  if [ ! -f "$OFFLINEFILE" ]; then
    echo "phone unreachable — can't read step counter (not an alarm)" >&2
    touch "$OFFLINEFILE"
  fi
  exit 2
}
rm -f "$OFFLINEFILE"

# --- Read step counter ---
steps="$(read_step_counter "$pip")"
[ -n "$steps" ] || {
  if [ ! -f "$OFFLINEFILE" ]; then
    echo "step counter read failed — sensor absent or not producing (not an alarm)" >&2
    touch "$OFFLINEFILE"
  fi
  exit 2
}

TS=$(date -u +%Y-%m-%dT%H:%M:%SZ)

# --- Read previous state ---
prev_steps=""
if [ -f "$STATE" ]; then
  read -r prev_steps _ < "$STATE" 2>/dev/null || true
fi

# --- Determine state ---
if [ -z "$prev_steps" ]; then
  state="SEEDING"
  delta=""
  tag="[step-seed]"
else
  if [ "$steps" -gt "$prev_steps" ] 2>/dev/null; then
    delta=$((steps - prev_steps))
    state="ACTIVE"
    tag="[step-active]"
  else
    delta=0
    state="STILL"
    tag="[step-still]"
  fi
fi

# --- Write state + touch liveness ---
printf '%s %s %s\n' "$steps" "$state" "$TS" > "$STATE"
mesh-state-touch "$STATE"

# --- Output ---
if [ "${1:-}" = --json ]; then
  printf '{"state":"%s","total_steps":%s,"delta":%s,"prev_steps":%s,"ts":"%s"}\n' \
    "$state" "$steps" "${delta:-null}" "${prev_steps:-null}" "$TS"
  exit 0
fi

if [ "${1:-}" = --edge ]; then
  # Emit only on ACTIVE (steps increased) or state transition from SEEDING→ACTIVE
  [ "$state" = "ACTIVE" ] || exit 0
  printf '%s %s — +%d steps (total: %s)\n' "$tag" "$state" "$delta" "$steps"
  exit 0
fi

printf '%s %s — total=%s delta=%s\n' "$tag" "$state" "$steps" "${delta:-?}"
