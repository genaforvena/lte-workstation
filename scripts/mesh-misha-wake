#!/usr/bin/env bash
# mesh-misha-wake — TIER-2 wake-on-face for Misha (the room "third party"). Periodic, cheap, dormant-first.
#
# Operator design (2026-06-24, task senses/misha-dormant-wake-on-face): Misha SLEEPS by default and must
# WAKE only on seeing the OPERATOR'S FACE. This reflex, on the room node, grabs a frame, runs
# mesh-face-recognize, and on an operator-face hit opens a TTL "face-awake" window. It does NOT itself
# decide whether Misha may speak — it writes a stamp that the speak-authority (mesh-misha-gate) consumes
# as an additional CONFIRM path. So the two compose cleanly:
#
#     mesh-misha-wake  (this) ── writes ──▶  ~/.mesh/misha-face-awake  (epoch expiry)
#     mesh-misha-gate  (authority) ── reads it ──▶  active stamp ⇒ confirmed ⇒ mesh-room say allowed
#
# Why a stamp, not a direct say-toggle: the gate is called synchronously by `mesh-room say` on every
# utterance and must stay CHEAP — so the expensive Groq vision call lives HERE (periodic), and the gate
# just compares one epoch. The window also gives hysteresis: Misha stays awake for MISHA_TTL_SEC after
# the LAST sighting, so a brief look-away doesn't drop him mid-thought. When the operator leaves, the
# stamp simply lapses → the gate stops confirming via face → Misha returns to dormant. That lapse IS the
# operator's "no-face-for-N-minutes → dormant" (no active sleep step needed).
#
#   mesh-misha-wake            reflex tick: frame → recognize → (operator face ⇒ arm the awake window + greet-once)
#   mesh-misha-wake --status   print whether the face-awake window is open and how long is left
#   mesh-misha-wake --test     sandboxed test (no camera, no Groq, no say, no ssh)
#
# ROOM-NODE GUARD: the room camera + mic + Bose live on ROOM_NODE (default-string). This reflex only
# acts there; on every other node it exits 0 at once (no capture, no Groq, no cost) — mesh-room's pattern.
# So it is safe to autowire fleet-wide; only the room node spends anything.
#
# reflex-cadence: */3 * * * *
# reflex-args:
#
# Tunables (env): MISHA_TTL_SEC=600 · MISHA_WAKE_FACE="Ilya" (space-sep set; the OPERATOR by default) ·
#   MISHA_GREET="Привет." · MISHA_NOGREET=0 · ROOM_NODE=imozerov@100.125.157.75
#   MISHA_FACE_OVERRIDE=<label> (skip live capture+recognition — for --test / manual drive)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"   # cron's PATH is minimal; sibling mesh-* live here

MESH="$HOME/.mesh"
STAMP_FILE="$MESH/misha-face-awake"          # epoch: while now < contents, the operator face is "fresh"
LOG="$MESH/misha-wake.log"
TTL="${MISHA_TTL_SEC:-600}"
WAKE_FACE="${MISHA_WAKE_FACE:-Ilya}"
GREET="${MISHA_GREET:-Привет.}"
# ROOM_NODE resolution (2026-07-14): explicit env > ~/.mesh/nodes (node-local truth) > the historical
# ds default. This tool never sourced ~/.mesh/nodes, so after the room organs moved to mesh-home it
# kept ssh'ing to the RETIRED ds node. ROOM_NODE in restore.env does NOT reach here: tmux panes
# inherit the tmux SERVER's env, not mesh-restore's, and cron has no such env at all — ~/.mesh/nodes
# is the reliable path because each tool sources it itself at startup.
# Sourcing must NOT clobber an explicit override — the --test harnesses pass a deliberately
# unreachable ROOM_NODE, and a bare `. nodes` would rewrite it to localhost and gut the test.
_rn_explicit="${ROOM_NODE:-}"
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes" 2>/dev/null || true
ROOM_NODE="${_rn_explicit:-${ROOM_NODE:-imozerov@100.125.157.75}}"
CAM_DEV="${MISHA_CAM_DEV:-/dev/video0}"
CAM_RES="${MISHA_CAM_RES:-640x480}"
now(){ date +%s; }
stampnow(){ date -u +%FT%TZ; }
log(){ printf '%s  %s\n' "$(stampnow)" "$*" >> "$LOG"; }

stamp_active(){ [ -r "$STAMP_FILE" ] || return 1; local e; read -r e < "$STAMP_FILE" 2>/dev/null || return 1
                [ -n "${e:-}" ] || return 1; [ "$(now)" -lt "$e" ]; }

is_wake_face(){ local f="$1" w; for w in $WAKE_FACE; do [ "${f,,}" = "${w,,}" ] && return 0; done; return 1; }

is_room_node(){
  [ "${MISHA_FORCE_LOCAL:-0}" = 1 ] && return 0
  local host="${ROOM_NODE#*@}" ip
  [ "$host" = localhost ] || [ "$host" = 127.0.0.1 ] && return 0
  for ip in $(tailscale ip -4 2>/dev/null) $(hostname -I 2>/dev/null); do
    [ "$ip" = "$host" ] && return 0
  done
  return 1
}

# grab a FRESH frame -> echoes a path (own capture preferred so we don't depend on mesh-cam-watch running)
# WEDGE BACKOFF — shared with mesh-bruno-watch, keyed by DEVICE (2026-08-17).
# A wedged UVC camera does not fail cheaply: every open floods the kernel with `cannot submit urb 0,
# error -2` / `Failed to set UVC probe control : -110` (measured 9k-24k messages in ONE minute), and on
# mesh-home the webcam (usb 1-2.3) shares its USB-2.0 hub with the SOLE UPLINK dongle (usb 1-2.4), so
# the flood knocks the node off its own network. This reflex and mesh-bruno-watch run at the SAME */3
# cadence against the SAME /dev/video0: backing off only one of them leaves the other hammering, which
# is exactly what happened at 03:09Z after 584d0e4 armed the backoff in bruno-watch alone (an orphaned
# misha-wake fswebcam sat in D-state on usb_start_wait_urb, still holding the device). The state file is
# therefore keyed by DEVICE, not by reflex, and either opener may arm it or clear it.
# Format: "<consecutive-fails> <quiet-until-epoch>". ([[a-wedged-usb-device-attacks-its-hubs-neighbour]])
WEDGE_FAILS="${MISHA_WEDGE_FAILS:-3}"
WEDGE_QUIET="${MISHA_WEDGE_QUIET:-900}"
wedge_state(){ printf '%s' "$MESH/.uvc-wedge-$(basename "$CAM_DEV")"; }

grab_frame(){
  local tmp="$MESH/.misha-wake-frame.jpg" new="$MESH/.misha-wake-frame.new.jpg"
  if command -v fswebcam >/dev/null 2>&1; then
    local cmd="fswebcam --no-banner -d '$CAM_DEV' -r '$CAM_RES' -S 8 '$new'"
    # Read the shared backoff BEFORE touching the device at all — a skip that still probes "just once"
    # is not a backoff. While the quiet window stands we open the camera ZERO times and say so.
    local wst wfails=0 wquiet=0 nowsec; wst="$(wedge_state)"; nowsec="$(now)"
    [ -f "$wst" ] && read -r wfails wquiet < "$wst" 2>/dev/null
    case "${wfails:-x}${wquiet:-x}" in ''|*[!0-9]*) wfails=0; wquiet=0 ;; esac
    if [ "$nowsec" -lt "$wquiet" ]; then
      log "camera WEDGED — not opening $CAM_DEV for $(( wquiet - nowsec ))s more (it floods the USB hub it SHARES with the uplink); falling back to the shared frame"
    else
      rm -f "$new"
      # DEVICE MUTEX — see mesh-cam-lock. This reflex and mesh-bruno-watch share BOTH the camera
      # and the */3 cron minute, so without it they routinely opened /dev/video0 in the same
      # second. rc=75 = another organ holds it: fall through to the shared frame exactly as the
      # wedge-quiet branch does, and do NOT touch the wedge counter (a busy device is not a fault).
      _lk="$(command -v mesh-cam-lock 2>/dev/null || true)"
      if [ -n "$_lk" ]; then
        "$_lk" --dev "$CAM_DEV" --why misha-wake -- sh -c "$cmd" >/dev/null 2>&1
        if [ "$?" = 75 ]; then
          log "camera BUSY — another mesh organ holds $CAM_DEV; skipped this cycle (no wedge counted), falling back to the shared frame"
          rm -f "$new" 2>/dev/null || true
        fi
      else
        eval "$cmd" >/dev/null 2>&1
      fi
      # The ambient context may lack the `video` group (cron/systemd-user started before the
      # group was added → EACCES on /dev/video*). fswebcam then fails but the reflex still exits 0,
      # so the sense goes SILENTLY dead. Retry once explicitly acquiring the group via `sg`.
      if [ ! -s "$new" ] && command -v sg >/dev/null 2>&1; then
        if [ -n "$_lk" ]; then
          "$_lk" --dev "$CAM_DEV" --why misha-wake-sg -- sg video -c "$cmd" >/dev/null 2>&1
        else
          sg video -c "$cmd" >/dev/null 2>&1
        fi
      fi
      if [ -s "$new" ]; then
        printf '0 0\n' > "$wst" 2>/dev/null || true    # a live camera clears the backoff for BOTH openers
        mv -f "$new" "$tmp"; printf '%s' "$tmp"; return
      fi
      wfails=$(( wfails + 1 ))
      if [ "$wfails" -ge "$WEDGE_FAILS" ]; then
        printf '0 %s\n' "$(( nowsec + WEDGE_QUIET ))" > "$wst" 2>/dev/null || true
        log "camera failed ${wfails}x in a row — WEDGE backoff armed, no device open for ${WEDGE_QUIET}s (shares a USB hub with the uplink)"
      else
        printf '%s 0\n' "$wfails" > "$wst" 2>/dev/null || true
        log "camera produced no frame (device busy?) — consecutive fails: $wfails"
      fi
    fi
  fi
  # fallback: the shared cam-prev.jpg (kept fresh by mesh-cam-watch) if it exists
  [ -s "$MESH/cam-prev.jpg" ] && printf '%s' "$MESH/cam-prev.jpg"
}

# classify the room now -> echoes a label ("" on error / no frame / no recognizer)
classify(){
  if [ -n "${MISHA_FACE_OVERRIDE:-}" ]; then printf '%s' "$MISHA_FACE_OVERRIDE"; return; fi
  command -v mesh-face-recognize >/dev/null 2>&1 || return 0
  local f; f="$(grab_frame)"; [ -n "$f" ] || return 0
  local out; out="$(timeout 30 mesh-face-recognize "$f" 2>/dev/null)" || return 0
  printf '%s' "$(printf '%s' "$out" | tail -1 | tr -d '[:space:]')"
}

# ---- --status -------------------------------------------------------------------------------
if [ "${1:-}" = --status ]; then
  if stamp_active; then read -r e < "$STAMP_FILE"; echo "misha-wake: AWAKE-window OPEN ($(( e - $(now) ))s left)"
  else echo "misha-wake: window closed (Misha dormant unless room-sense confirms)"; fi
  exit 0
fi

# ---- --test : sandboxed, no camera/Groq/say/ssh ---------------------------------------------
if [ "${1:-}" = --test ]; then
  command -v timeout >/dev/null 2>&1 || { echo "smoke-test: FAIL (no timeout)"; exit 1; }
  P=0; F=0; pass(){ P=$((P+1)); }; fail(){ F=$((F+1)); echo "  FAIL: $1"; }
  tmp="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
  trap 'rm -rf "$tmp"' EXIT
  self="$(command -v "$0" 2>/dev/null)"; [ -x "$self" ] || self="$0"
  mkdir -p "$tmp/.mesh"
  ST="$tmp/.mesh/misha-face-awake"
  # MISHA_NOGREET=1 + MISHA_TEST not needed for greet since mesh-room is absent in sandbox PATH, but be safe:
  run(){ HOME="$tmp" MISHA_FORCE_LOCAL=1 MISHA_NOGREET=1 MISHA_TTL_SEC="${TTL_T:-600}" \
         MISHA_FACE_OVERRIDE="$1" timeout 10 bash "$self" 2>/dev/null; }

  # 1. no face seen -> no stamp (stays dormant)
  run Nobody >/dev/null
  [ ! -e "$ST" ] && pass || fail "Nobody must not arm the awake window"

  # 2. operator face (Ilya) -> stamp armed in the future
  run Ilya >/dev/null
  [ -e "$ST" ] && pass || fail "operator face must arm the window"
  read -r e < "$ST" 2>/dev/null; [ -n "${e:-}" ] && [ "$e" -gt "$(date +%s)" ] && pass || fail "stamp epoch must be in the future"

  # 3. --status reports the window open
  HOME="$tmp" bash "$self" --status 2>/dev/null | grep -q 'OPEN' && pass || fail "--status should report window OPEN"

  # 4. a stranger does NOT (re)arm — but an already-open window stays (hysteresis); expire it then stranger=closed
  printf '%s\n' "$(( $(date +%s) - 5 ))" > "$ST"   # force-expire
  run Stranger >/dev/null
  HOME="$tmp" bash "$self" --status 2>/dev/null | grep -q 'closed' && pass || fail "expired + stranger => window closed"

  # 5. Stranger/Nobody never overwrite an expired stamp into the future
  read -r e2 < "$ST" 2>/dev/null; [ "$e2" -lt "$(date +%s)" ] && pass || fail "non-operator must not push the stamp forward"

  # 6. no real capture/say happened (no frame file, no greeting side effect in sandbox)
  [ ! -e "$tmp/.mesh/.misha-wake-frame.jpg" ] && pass || fail "test must not capture a real frame"

  # 7. room-node-guard skip MUST log a trace (else a non-room cron tick is a silent hollow sense —
  #    16d/0-byte log incident, senses/misha-voicecount-roomguard-silent-2026-07-10)
  TLOG="$tmp/.mesh/misha-wake.log"; rm -f "$TLOG"
  HOME="$tmp" ROOM_NODE='nobody@203.0.113.9' MISHA_NOGREET=1 timeout 10 bash "$self" >/dev/null 2>&1
  [ -s "$TLOG" ] && grep -q 'room-node-skip' "$TLOG" && pass || fail "room-node-guard exit must log room-node-skip"

  # 8. WEDGE BACKOFF drives the REAL grab_frame against a camera that always fails and counts DEVICE
  #    OPENS — the only artifact separating a backoff from a skip that still probes. The state file is
  #    DEVICE-keyed and shared with mesh-bruno-watch: a wedge armed by either must silence BOTH, since
  #    the flood attacks the USB hub the sole uplink sits on, not just this reflex's own frame.
  wd="$tmp/wedge"; mkdir -p "$wd" "$tmp/.mesh"
  printf '#!/usr/bin/env bash\necho x >> "%s/opens"\nexit 0\n' "$wd" > "$wd/fswebcam"   # exits 0, writes NO file
  printf '#!/usr/bin/env bash\nexit 1\n' > "$wd/sg"                                    # no group-retry path here
  chmod +x "$wd/fswebcam" "$wd/sg"
  opens(){ [ -f "$wd/opens" ] && wc -l < "$wd/opens" | tr -d ' ' || echo 0; }
  # grab_frame is defined in THIS file, so the subshell below calls the real function (not a copy).
  WLOG="$tmp/.mesh/wedge.log"; WST="$tmp/.mesh/.uvc-wedge-video0"; rm -f "$WST" "$wd/opens"
  (
    # shellcheck disable=SC1090
    MESH="$tmp/.mesh"; LOG="$WLOG"; CAM_DEV=/dev/video0; STAMP_FILE="$tmp/.mesh/ignore"
    MISHA_WEDGE_FAILS=3; MISHA_WEDGE_QUIET=900; export PATH="$wd:$PATH"
    WEDGE_FAILS=3; WEDGE_QUIET=900
    grab_frame >/dev/null 2>&1; echo "$(opens)" > "$wd/n1"   # 1st fail
    grab_frame >/dev/null 2>&1; echo "$(opens)" > "$wd/n2"   # 2nd fail
    grab_frame >/dev/null 2>&1; echo "$(opens)" > "$wd/n3"   # 3rd fail -> arms the backoff
    grab_frame >/dev/null 2>&1; echo "$(opens)" > "$wd/n4"   # MUST NOT open the device
  ) >/dev/null 2>&1
  n1=$(cat "$wd/n1" 2>/dev/null || echo -1); n3=$(cat "$wd/n3" 2>/dev/null || echo -1)
  n4=$(cat "$wd/n4" 2>/dev/null || echo -1)
  [ "$n1" = 1 ] && pass || fail "a first failure must open the device exactly once (got $n1)"
  [ "$n3" = 3 ] && pass || fail "three failures must be three opens before the backoff arms (got $n3)"
  [ "$n4" = "$n3" ] && pass || fail "THE GATE — a backed-off tick must open the device ZERO times (cumulative $n3 -> $n4)"
  grep -q 'WEDGE backoff armed' "$WLOG" 2>/dev/null && pass || fail "arming the backoff must say so in the log"
  grep -q 'WEDGED — not opening' "$WLOG" 2>/dev/null && pass || fail "a backed-off tick must name itself in the log, not skip silently"
  read -r wf wq < "$WST" 2>/dev/null || { wf=x; wq=x; }
  { [ "${wq:-0}" -gt "$(date +%s)" ] 2>/dev/null; } && pass || fail "the armed state must carry a FUTURE quiet-until (got '$wq')"
  # the state file must be the DEVICE-keyed one bruno-watch reads, not a private per-reflex name
  [ -f "$tmp/.mesh/.uvc-wedge-video0" ] && pass || fail "the wedge state must be DEVICE-keyed (.uvc-wedge-video0) so mesh-bruno-watch shares it"
  # positive direction: a camera that comes back CLEARS the backoff for both openers
  printf '#!/usr/bin/env bash\nwhile [ $# -gt 1 ]; do shift; done\necho jpeg > "$1"\nexit 0\n' > "$wd/fswebcam"
  (
    MESH="$tmp/.mesh"; LOG="$WLOG"; CAM_DEV=/dev/video0
    WEDGE_FAILS=3; WEDGE_QUIET=900; export PATH="$wd:$PATH"
    printf '0 0\n' > "$WST"; grab_frame >/dev/null 2>&1
  ) >/dev/null 2>&1
  [ "$(cat "$WST" 2>/dev/null)" = "0 0" ] && pass || fail "a successful capture must clear the wedge state (got '$(cat "$WST" 2>/dev/null)')"

  echo "smoke-test: $([ "$F" -eq 0 ] && echo ok || echo FAIL) — asserts: $P passed, $F failed"
  [ "$F" -eq 0 ]; exit
fi

# ---- default: the reflex tick ---------------------------------------------------------------
# ROOM-NODE GUARD: nothing to do (and nothing spent) off the room node. MUST log — a silent exit
# here is indistinguishable from a dead reflex on a non-room mind node's cron (16d/0-byte log,
# senses/misha-voicecount-roomguard-silent-2026-07-10, same class as the note3 relay-skip fix
# 330c902: the skip itself is honest, but only if it leaves a trace).
if ! is_room_node; then log "[misha-wake] room-node-skip (ROOM_NODE=$ROOM_NODE, not here)"; exit 0; fi

was_open=1; stamp_active || was_open=0
label="$(classify)"

if is_wake_face "$label"; then
  printf '%s\n' "$(( $(now) + TTL ))" > "$STAMP_FILE"     # (re)arm the awake window
  if [ "$was_open" = 0 ]; then
    log "[misha-wake] operator face ($label) seen -> AWAKE window ${TTL}s"
    # greet ONCE on the dormant->awake edge (mesh-room say re-checks the gate, which the stamp now confirms)
    if [ "${MISHA_NOGREET:-0}" != 1 ] && command -v mesh-room >/dev/null 2>&1; then
      mesh-room say "$GREET" >/dev/null 2>&1 || true
    fi
  fi
fi
# no operator face this tick: do nothing — the stamp lapses on its own (= no-face-for-TTL => dormant)
exit 0
