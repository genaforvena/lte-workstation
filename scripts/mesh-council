#!/usr/bin/env bash
# mesh-council — multi-mind DISCUSSION → SYNTHESIS. Borrowing #2 from the operator's work mesh
# (guy-fawxible / Foxible), his HEADLINE pick: a question (from the operator OR a mind) is answered by
# SEVERAL minds, each from its own role-vantage, then CONVERGED into a synthesis — diversity-of-angle
# beats one mind's single answer, and the operator can be INSIDE the discussion, not just commanding.
# Re-derived as OUR tool over OUR primitives (mesh-chat board markers + mesh-tell + mesh-mind-state +
# mesh-relay) — never their repo/instance. Closes our gap: an operator Q currently goes to ONE mind (tg).
#
# A round is round-keyed board markers (decay on reboot like the rest of the bus):
#   [discuss] <round>: <question> — asked: <m1,m2,...>   opens a round (posted ONCE)
#   [angle]   <round>: <one-line role-vantage answer>     a mind's reply (owner = board WHO), or PASS
#   [synthesis] <round>: <converged answer>               the synthesis (posted ONCE, debounced)
#
# Usage:
#   mesh-council "<question>" [--minds a,b,c]   open a round: pick LIVE distinct-role minds (default
#                                               genome,health,senses,minds,tg ∩ reachable), post
#                                               [discuss], mesh-tell the IDLE ones a bounded reply-prompt
#                                               (WORKING minds ignore mid-turn but see the marker). Prints
#                                               the round key + asked roster.
#   mesh-council --collect <round> [--synth]    gather [angle]s for the round → roster (each asked mind's
#                                               angle or UNKNOWN — honest-empty, a non-responder is NEVER
#                                               faked). --synth feeds the angles to mesh-relay and posts
#                                               [synthesis] ONCE (skips if already synthesized: debounce).
#   mesh-council --status <round>               responded vs pending roster
#   mesh-council --test                         smoke (pure: round_key / parse_angles / roster / synth_exists)
#
# inc1 = CORE (this). DEFERRED to inc2: operator-facing surfacing (route [synthesis] → tg), auto-collect
# after a timeout, any cron trigger. (gf-borrowing-2, land SLOWLY one at a time.)
#
# reflex-cadence: none   # invoked on demand (a Q arrives); the auto-collect reflex is inc2
set -uo pipefail

BOARD="${MESH_CHAT_LOG:-$HOME/.mesh/chat.log}"
WHO="${MESH_WHO:-${USER:-?}@$(hostname)}"
HOST="$(hostname)"
DEFAULT_MINDS="${MESH_COUNCIL_MINDS:-genome health senses minds tg}"

# --- pure: a round key is an artifact id derived from the question + epoch (unique per round) ----------
round_key() {  # <question> <epoch>
  printf 'council-%s' "$(printf '%s|%s' "$1" "$2" | md5sum | cut -c1-8)"
}

# --- pure: from board lines on STDIN, the latest [angle] per mind for <round> → "window<TAB>answer".
# Mind posts as <window>@host; we key by WINDOW (strip @host). Marker is BODY-ANCHORED after ' :: '. ----
parse_angles() {  # <round>  (reads board on stdin)
  awk -v want="$1" '
    { i=index($0," :: "); if(i==0)next; meta=substr($0,1,i-1); msg=substr($0,i+4)
      sub(/[ \t]+$/,"",meta); sub(/^[ \t]+/,"",msg)
      if(msg !~ /^\[angle\] /) next
      who=meta; sub(/^.*[ \t]/,"",who); sub(/@.*/,"",who)          # window only
      body=msg; sub(/^\[angle\] /,"",body)
      r=body; sub(/:.*$/,"",r); gsub(/[ \t]/,"",r)                 # <round> = up to first colon
      if(r!=want) next
      ans=body; sub(/^[^:]*:[ \t]*/,"",ans)                        # answer = after the colon
      angle[who]=ans                                                # latest wins
    }
    END{ for(w in angle) print w "\t" angle[w] }
  '
}

# --- pure: from the [discuss] marker for <round>, echo "question<TAB>asked-csv" ------------------------
parse_discuss() {  # <round>  (reads board on stdin)
  awk -v want="$1" -v delim=" #asked:" '
    { i=index($0," :: "); if(i==0)next; msg=substr($0,i+4); sub(/^[ \t]+/,"",msg)
      if(msg !~ /^\[discuss\] /) next
      body=msg; sub(/^\[discuss\] /,"",body)
      r=body; sub(/:.*$/,"",r); gsub(/[ \t]/,"",r); if(r!=want) next
      rest=body; sub(/^[^:]*:[ \t]*/,"",rest)                       # "<question> #asked:a,b,c"
      asked=""; q=rest
      ai=index(rest,delim); if(ai>0){ q=substr(rest,1,ai-1); asked=substr(rest,ai+length(delim)) }
      print q "\t" asked
    }
  ' | tail -1
}

# --- pure: roster — each asked mind shows its angle or UNKNOWN (honest-empty). stdin: window<TAB>angle -
roster() {  # <asked-space-or-csv>  (angles on stdin)
  local asked w a; declare -A got=()
  while IFS=$'\t' read -r w a; do [ -n "$w" ] && got["$w"]="$a"; done
  asked="$(printf '%s' "$1" | tr ',' ' ')"
  for m in $asked; do
    if [ -n "${got[$m]+x}" ]; then printf '  %s: %s\n' "$m" "${got[$m]}"
    else printf '  %s: UNKNOWN (no angle yet)\n' "$m"; fi
  done
}

# --- pure: has the round already been synthesized? (debounce: post [synthesis] only once) --------------
synth_exists() {  # <round>  (reads board on stdin)
  grep -qE ":: *\[synthesis\] $1:" 2>/dev/null
}

_post() { mesh-chat "$1" >/dev/null; }

case "${1:-}" in
  --test)
    f=""
    [ "$(round_key 'why is X slow?' 1700000000)" = "$(round_key 'why is X slow?' 1700000000)" ] || f="$f rk-det"
    [ "$(round_key 'a' 1)" != "$(round_key 'b' 1)" ] || f="$f rk-uniq"
    case "$(round_key 'q' 1)" in council-????????) : ;; *) f="$f rk-shape" ;; esac
    board='2026-06-24T03:00:00Z  genome@h  ::  [discuss] council-abc: why slow? #asked:genome,health,senses
2026-06-24T03:01:00Z  genome@h  ::  [angle] council-abc: hot loop in parser, O(n^2)
2026-06-24T03:02:00Z  health@h  ::  [angle] council-abc: cpu fine, it is I/O wait
2026-06-24T03:03:00Z  genome@h  ::  prose quoting [angle] council-abc: should NOT override
2026-06-24T03:04:00Z  other@h  ::  [angle] council-XYZ: different round, ignore'
    ang="$(printf '%s\n' "$board" | parse_angles council-abc | sort)"
    [ "$ang" = "$(printf 'genome\thot loop in parser, O(n^2)\nhealth\tcpu fine, it is I/O wait')" ] || f="$f parse-angles"
    dis="$(printf '%s\n' "$board" | parse_discuss council-abc)"
    [ "$dis" = "$(printf 'why slow?\tgenome,health,senses')" ] || f="$f parse-discuss"
    ros="$(printf '%s\n' "$board" | parse_angles council-abc | roster 'genome,health,senses')"
    printf '%s\n' "$ros" | grep -q 'senses: UNKNOWN' || f="$f roster-unknown"
    printf '%s\n' "$ros" | grep -q 'genome: hot loop' || f="$f roster-angle"
    printf '%s\n' "$board" | synth_exists council-abc && f="$f synth-false"   # no synthesis yet → should be absent
    printf '2026-06-24T03:05:00Z  chat@h  ::  [synthesis] council-abc: it is I/O bound\n' | synth_exists council-abc || f="$f synth-true"
    if [ -n "$f" ]; then echo "smoke-test: FAIL ($f )"; exit 1; fi
    echo "smoke-test: ok (round_key, parse_angles body-anchor, parse_discuss, roster honest-empty, synth_exists)"; exit 0 ;;

  --status|--collect)
    verb="$1"; round="${2:-}"
    case "$round" in council-*) : ;; *) echo "mesh-council: need a round key (council-XXXXXXXX)" >&2; exit 64 ;; esac
    synth=0; [ "${3:-}" = --synth ] && synth=1
    dis="$(parse_discuss "$round" < "$BOARD")"; q="${dis%%$'\t'*}"; asked="${dis#*$'\t'}"
    [ -n "$asked" ] && [ "$asked" != "$dis" ] || { echo "mesh-council: no [discuss] $round on the board" >&2; exit 1; }
    echo "round $round — Q: $q"
    echo "-- angles (asked: $asked) --"
    parse_angles "$round" < "$BOARD" | roster "$asked"
    n="$(parse_angles "$round" < "$BOARD" | grep -c .)"
    na="$(printf '%s' "$asked" | tr ',' '\n' | grep -c .)"
    echo "-- $n/$na minds answered --"
    if [ "$verb" = --collect ] && [ "$synth" = 1 ]; then
      if synth_exists "$round" < "$BOARD"; then echo "(already synthesized — not re-posting)"; exit 0; fi
      [ "$n" -gt 0 ] || { echo "(no angles yet — nothing to synthesize; NOT faking one)"; exit 0; }
      angles_txt="$(parse_angles "$round" < "$BOARD" | awk -F'\t' '{print "- "$1": "$2}')"
      prompt="Several minds answered the question \"$q\", each from its own role-vantage. Synthesize their answers into ONE short converged paragraph: state the consensus, then name any real tension/disagreement. Do NOT invent views nobody gave. Angles:
$angles_txt"
      syn="$(printf '%s' "$prompt" | timeout 60 mesh-relay 2>/dev/null | tr '\n' ' ' | sed 's/  */ /g')"
      if [ -z "${syn// /}" ]; then echo "mesh-council: synthesis relay returned nothing (pool down) — not posting" >&2; exit 3; fi
      _post "[synthesis] $round: $syn"
      echo "-- synthesized → [synthesis] $round posted --"
    fi
    exit 0 ;;

  ""|-h|--help)
    sed -n '2,33p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;

  --*)
    echo "mesh-council: unknown verb '$1' (see --help)" >&2; exit 64 ;;

  *)
    # OPEN a round: broadcast a question to live distinct-role minds
    q="$1"; shift; minds="$DEFAULT_MINDS"
    while [ $# -gt 0 ]; do case "$1" in --minds) minds="$(printf '%s' "${2:-}" | tr ',' ' ')"; shift 2 ;; *) shift ;; esac; done
    [ -n "${q// /}" ] || { echo "mesh-council: empty question" >&2; exit 64; }
    epoch="$(date +%s)"; round="$(round_key "$q" "$epoch")"
    # candidates = requested set that are REACHABLE (window exists); honest: exclude ABSENT/DEAD, list who
    asked=""; idle=""
    for m in $minds; do
      mesh-mind-state "$m" >/dev/null 2>&1; rc=$?
      case "$rc" in 5|7) continue ;; esac                          # DEAD / ABSENT → not a candidate
      asked="$asked${asked:+ }$m"
      if mesh-mind-state "$m" 2>/dev/null | grep -qiw IDLE; then idle="$idle${idle:+ }$m"; fi
    done
    [ -n "$asked" ] || { echo "mesh-council: no reachable minds in '{$minds}' to ask" >&2; exit 1; }
    asked_csv="$(printf '%s' "$asked" | tr ' ' ',')"
    _post "[discuss] $round: $q #asked:$asked_csv"
    # actively poke the IDLE minds (WORKING ones ignore mid-turn but will see the [discuss] marker)
    for m in $idle; do
      mesh-tell "$m" "COUNCIL $round — question: \"$q\". Reply from your $m role-vantage in ONE line by running: mesh-chat '[angle] $round: <your answer>'  (or '[angle] $round: PASS' if nothing to add). One line, then resume." >/dev/null 2>&1 || true
    done
    echo "opened round $round"
    echo "  Q: $q"
    echo "  asked (reachable): $asked_csv"
    echo "  poked (idle now):  $(printf '%s' "$idle" | tr ' ' ',')"
    echo "  collect later: mesh-council --collect $round --synth"
    exit 0 ;;
esac
