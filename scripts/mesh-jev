#!/usr/bin/env python3
"""Small, secret-safe TypeSafe/Jev HTTP adapter for mesh callers."""

from __future__ import annotations

import argparse
import json
import os
import pathlib
import sys
import urllib.error
import urllib.request


DEFAULT_BASE_URL = "https://api.typesafe.ai"
DEFAULT_MODEL = "jev-latest"
SECRET_FILE = pathlib.Path.home() / ".mesh" / "secrets" / "typesafe.env"


def load_env_file(path: pathlib.Path) -> dict[str, str]:
    values: dict[str, str] = {}
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except FileNotFoundError:
        return values
    for line in lines:
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        key = key.strip()
        value = value.strip()
        if value and value[0:1] in {"'", '"'} and value[-1:] == value[0]:
            value = value[1:-1]
        values[key] = value
    return values


def config() -> tuple[str, str]:
    file_env = load_env_file(SECRET_FILE)
    key = os.environ.get("TYPESAFE_API_KEY", "").strip() or file_env.get("TYPESAFE_API_KEY", "").strip()
    base_url = os.environ.get("TYPESAFE_BASE_URL", "").strip() or file_env.get("TYPESAFE_BASE_URL", "").strip() or DEFAULT_BASE_URL
    if not key:
        raise RuntimeError("TYPESAFE_API_KEY is not configured (env or ~/.mesh/secrets/typesafe.env)")
    if not base_url.startswith(("https://", "http://")):
        raise RuntimeError("TYPESAFE_BASE_URL must be an http(s) URL")
    return key, base_url.rstrip("/")


def request_json(method: str, url: str, key: str, body: object | None = None) -> object:
    data = None
    headers = {"Authorization": f"Bearer {key}", "Accept": "application/json"}
    if body is not None:
        data = json.dumps(body, ensure_ascii=False).encode("utf-8")
        headers["Content-Type"] = "application/json"
    request = urllib.request.Request(url, data=data, headers=headers, method=method)
    try:
        with urllib.request.urlopen(request, timeout=60) as response:
            raw = response.read()
    except urllib.error.HTTPError as error:
        detail = error.read(512).decode("utf-8", errors="replace")
        raise RuntimeError(f"TypeSafe HTTP {error.code}: {detail}") from None
    except urllib.error.URLError as error:
        raise RuntimeError(f"TypeSafe connection failed: {error.reason}") from None
    try:
        return json.loads(raw)
    except json.JSONDecodeError:
        raise RuntimeError("TypeSafe returned a non-JSON response") from None


def read_request(path: str | None) -> dict:
    raw = pathlib.Path(path).read_text(encoding="utf-8") if path else sys.stdin.read()
    try:
        payload = json.loads(raw)
    except json.JSONDecodeError as error:
        raise RuntimeError(f"request is not valid JSON: {error}") from None
    if not isinstance(payload, dict):
        raise RuntimeError("request must be a JSON object")
    if "state" not in payload or "questions" not in payload:
        raise RuntimeError("request requires state and questions")
    if not isinstance(payload["questions"], dict) or not payload["questions"]:
        raise RuntimeError("questions must be a non-empty JSON object")
    payload.setdefault("model", DEFAULT_MODEL)
    return payload


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(description="Call the TypeSafe Jev System One API")
    mode = parser.add_mutually_exclusive_group(required=True)
    mode.add_argument("--models", action="store_true", help="list models available to this key")
    mode.add_argument("--evaluate", nargs="?", const="", metavar="REQUEST.json", help="evaluate JSON from stdin or a file")
    mode.add_argument("--test", action="store_true", help="run offline adapter checks")
    args = parser.parse_args(argv)

    if args.test:
        assert DEFAULT_MODEL == "jev-latest"
        assert load_env_file(pathlib.Path("/definitely/missing/typesafe.env")) == {}
        print("PASS: mesh-jev offline validation")
        return 0

    try:
        key, base_url = config()
        if args.models:
            result = request_json("GET", f"{base_url}/v1/models", key)
        else:
            payload = read_request(args.evaluate or None)
            result = request_json("POST", f"{base_url}/v1/systemone", key, payload)
        print(json.dumps(result, ensure_ascii=False, indent=2, sort_keys=True))
        return 0
    except RuntimeError as error:
        print(f"mesh-jev: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
