#!/usr/bin/env bash
# reflex-cadence: 2-59/5 * * * *
# mesh-room-sense-loss — WAKE THE ROOM MIND WHEN IT LOSES A SENSE (operator 2026-07-16: "the room mind
# was NOT woken when it lost one of its VISIONS"). The room's own reflex for organ health: it watches the
# room mind's DECLARED senses and, on a LIVE->dead EDGE, POKES the mind (mesh-tell room) so it wakes,
# notices its eyes/ears went dark, and acts AT ITS DISCRETION — revive the organ, or tell the operator.
#
# THE GAP THIS FILLS (confirmed 2026-07-16): mesh-cam-watch.service went inactive ~Jul-15 05:09 (the room
# mind's local camera — its eyes) and NOTHING woke the room for ~30h. mesh-room-reflex fires ONLY on
# transcript name/ambient speech (zero organ-health awareness); mesh-sense-monitor fuses cam liveness into
# a DISPLAY pane but never pokes a mind; mesh-room-sense silently degrades cam->UNKNOWN. A dash SHOWS a
# dead organ; nothing WAKES the mind about it. This reflex is that missing edge-triggered wake.
#
# POLARITY — FAIL LOUD, the OPPOSITE of the address gate. mesh-room-address fails OPEN toward SILENCE
# (its job is to REMOVE false wakes; when unsure it suppresses). This reflex fails LOUD toward WAKING:
# a sense that was LIVE and now reads DEAD *or* UNKNOWN (can't-tell) is treated as a loss worth a poke.
# A missing sense that was NEVER live here (camera-less node: the unit isn't installed) reads UNKNOWN
# from the first sight and seeds silently — it is not a loss, so it never cries wolf.
#
# DEBOUNCE — a loss must PERSIST to be believed. A sense reading not-live goes PENDING (no poke); only a
# SECOND consecutive not-live reading CONFIRMS the loss and pokes. A lone probe blip (a systemctl race,
# a momentary restart) clears from PENDING back to LIVE with no poke ever sent. This is the fix for the
# 2026-07-16 false poke: one cron fire read a rock-solid-active mesh-overhear as empty and woke the room.
# UNOBSERVABLE readings (bus unreachable, empty is-active) never even reach the machine — tick() FREEZES
# that sense (UNOBS != a sense verdict), so a session/cron quirk can never be laundered into a loss.
#
# FLAP GUARD — on top of debounce, a per-sense COOLDOWN (default 1h) gates the paid poke ON THE CONFIRM
# EDGE, so an organ that FLAPS (lose->recover->lose) costs at most one paid poke per cooldown. Recovery
# (dead->LIVE) is recorded SILENTLY (re-arm the latch + a cheap chat [fyi], never a paid mind poke) — the
# both-edges-need-a-gate rule: the recovery edge MUST reset the latch, or after the first loss the reflex
# would never fire for that sense again.
#
# HELD LOSS — A PERSISTENT LOSS IS THE ONE LOSS THE LATCH CANNOT REPORT (fixed 2026-08-21, board
# {#46195e58}). COOLDOWN is consulted at exactly ONE site: the PENDING->confirmed transition. Once
# status=LOST the not-alive path falls to the terminal `*) hold` branch, so for a loss that PERSISTS the
# cooldown branch is structurally UNREACHABLE — the code was a one-shot latch wearing a rate limiter's
# documentation ("one paid poke per cooldown" reads as a PACE; the branch that would re-fire is never
# entered). Measured that day: stt DEAD 27d21h, wake DEAD 28d0h, cam DEAD 2d21h, ~8000 cron ticks since
# the last output, ZERO of any kind. And it was silent on BOTH channels, because loss_note (the cheap
# board [fyi]) sat on the SAME confirm edge as the expensive poke — so a sense dead 28 days and a sense
# healed 28 days ago were byte-identical to every reader but --status. Fix: keep the POKE one-shot (a
# permanent loss must not mint a paid turn every tick), and give a HELD LOST its own long cadence on the
# CHEAP channel — RESTATE (default 24h) re-states the loss on the board WITH ITS AGE ("stt DEAD 28d"), so
# escalation is loud and free instead of silent. Never inherit a held state's reporting from its edge.
# A first-sight LOST (an organ that was NEVER live here) is NOT restated — it has no confirm timestamp
# (since=0, lastpoke=0) and crying wolf about an organ that never lived here is the false-poke failure
# this reflex already fixed once.
#
# LIVENESS-TOUCH — the STATE artifact's mtime is refreshed on EVERY run (mesh-state-touch), so a
# long-stable all-LIVE reading never reads as a dead reflex to the staleness watchdogs; the file's
# CONTENT is change-gated (per-sense state + lastpoke). A genuinely dead cron never runs -> never
# touches -> honest-STALE.
#
# THE SENSE LIST REUSES THE ROOM DASH'S ORGAN GATES (mesh-dash room remote_probe) — one definition of
# "is this organ alive", not a parallel list that rots: systemd is-active answers about the UNIT, and a
# running-but-stale producer (fresh unit, frozen artifact) is a HOLLOW sense counted DEAD, not LIVE.
#
#   mesh-room-sense-loss           one tick (probe every sense, poke on a LIVE->dead edge) — cron entry
#   mesh-room-sense-loss --status  human view: each sense's current verdict + last poke, no poke/no write
#   mesh-room-sense-loss --test    self-check: a simulated LIVE->dead pokes; cooldown suppresses a
#                                   re-fire; a HELD loss re-states cheaply on its own cadence (never a
#                                   second poke); recovery re-arms; first-sight seeds silently
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
# CRON RUNS WITHOUT A SESSION BUS: `systemctl --user` needs XDG_RUNTIME_DIR to reach the user manager,
# or every is-active call fails with "Failed to connect to bus" and empty stdout — which, unguarded,
# reads as DEAD and floods the room with false LOSS pokes on every fire (caught live 2026-07-16: the
# first cron tick poked ear/stt/wake though all three were active). Restore the runtime dir like the
# other user-systemd reflexes (mesh-room-reflex) do; a bus we STILL cannot reach reads UNKNOWN, not DEAD.
: "${XDG_RUNTIME_DIR:=/run/user/$(id -u)}"; export XDG_RUNTIME_DIR
MESH="$HOME/.mesh"
STATE="${ROOM_SENSE_LOSS_STATE:-$MESH/.room-sense-loss.state}"
COOLDOWN="${ROOM_SENSE_LOSS_COOLDOWN:-3600}"     # s between pokes for the SAME sense (flap guard)
RESTATE="${ROOM_SENSE_LOSS_RESTATE:-86400}"      # s between CHEAP board re-statements of a HELD loss
STALE="${ROOM_SENSE_LOSS_STALE:-300}"            # s: a producer's artifact older than this = hollow/DEAD
CAM_STALE="${ROOM_SENSE_LOSS_CAM_STALE:-600}"    # s: cam eyes run on a ~3min cron -> lease > 2 cycles
TRANS="${ROOM_TRANSCRIPT:-$MESH/room-transcript.txt}"

now() { date +%s; }
# Human age for a held loss — the whole point of the re-statement is that "28d" is visible without
# subtracting epochs by hand. 0/unknown renders `age?`, never a fabricated "0m" (missing != fresh).
hage() {  # <seconds>
  local s="${1:-0}"
  case "$s" in (''|*[!0-9]*) echo 'age?'; return ;; esac
  [ "$s" -le 0 ] && { echo 'age?'; return; }
  if   [ "$s" -ge 86400 ]; then echo "$(( s / 86400 ))d"
  elif [ "$s" -ge 3600 ];  then echo "$(( s / 3600 ))h"
  else                          echo "$(( s / 60 ))m"; fi
}

# The room mind's declared senses, each with a one-word human gloss for the poke.
SENSES="cam ear stt wake"
gloss() { case "$1" in
  cam)  echo "its EYES (room camera — mesh-imac-cam-watch / mesh-misha-wake / mesh-cam-watch)";;
  ear)  echo "its EARS (room mic / mesh-overhear)";;
  stt)  echo "its HEARING-INTO-WORDS (transcriber / mesh-room-gigaam)";;
  wake) echo "its WAKE REFLEX (mesh-room-reflex — the thing that hears its name)";;
  *)    echo "$1";;
esac; }

# ---- probes: each echoes LIVE | DEAD | UNKNOWN ---------------------------------------------------
# UNKNOWN is reserved for "can't tell / no such sense here" (unit not installed, systemctl absent) — it
# never fires a loss from first sight. DEAD is a POSITIVE "the organ that lives here is down or hollow".
_unit_active() { systemctl --user is-active "$1" 2>/dev/null | head -1; }   # active|inactive|failed|""
# Tri-state: PRESENT | ABSENT | UNOBS. A REACHABLE manager ALWAYS prints the "UNIT FILE" header — even
# for zero matches (verified: an absent unit still prints the header + "0 unit files listed." then exits
# 1). So a NONZERO exit alone cannot tell "genuinely absent" from "the query flaked": both are nonzero.
# The OUTPUT does: no header at all => the list query never completed (a D-Bus timeout/miss under cron
# load) => UNOBSERVABLE, NOT absent. Collapsing a flaked query into ABSENT is exactly what laundered a
# transient miss into a UNKNOWN loss and paid-poked the room about a healthy ear/wake — seen across TWO
# consecutive real cron fires 2026-07-16 (debounce can't catch a flake that spans 2 ticks; the fix is
# to never treat an unobservable query as a sense verdict at all).
_unit_state() {
  local unit="$1" out
  out="$(systemctl --user list-unit-files "$unit" 2>/dev/null)"
  printf '%s\n' "$out" | grep -q '^UNIT FILE' || { echo UNOBS; return; }   # query never returned a listing
  printf '%s\n' "$out" | grep -q "^$unit" && echo PRESENT || echo ABSENT
}
# Can we reach the user manager AT ALL? A bus-connect failure (no XDG_RUNTIME_DIR / no session) must read
# as can't-tell, never as a fabricated DEAD — the difference between UNKNOWN and DEAD is the difference
# between staying quiet and flooding the room. `show-environment` is a cheap query that succeeds only when
# the manager is actually reachable.
_mgr_ok() { systemctl --user show-environment >/dev/null 2>&1; }
_artifact_fresh() {  # <file> [max_age=STALE] — 0 if it exists and mtime <= max, 1 otherwise
  local f="$1" max="${2:-$STALE}" age
  [ -f "$f" ] || return 1
  age=$(( $(now) - $(stat -c %Y "$f" 2>/dev/null || echo 0) ))
  [ "$age" -le "$max" ]
}

# A unit-backed organ. THREE distinct classes of "not LIVE", never conflated:
#   UNOBS   — we could not OBSERVE the unit (no systemctl, bus unreachable, empty is-active from a
#             reachable-looking mgr). Not a sense verdict at all; tick() FREEZES the sense and never
#             pokes, so a cron session quirk or a bus outage can never fabricate a loss (the 11:42
#             ear=UNKNOWN false poke, 2026-07-16). Unobservable != lost.
#   UNKNOWN — the unit is genuinely NOT INSTALLED here (no such sense on this node) -> never a loss.
#   DEAD    — a REACHABLE manager says the installed unit is inactive/failed, or it is active but its
#             producer artifact is frozen (a hollow sense). A positive "the organ that lives here is down".
_probe_unit() {  # <unit> [freshness-artifact]
  local unit="$1" art="${2:-}" st
  command -v systemctl >/dev/null 2>&1 || { echo UNOBS; return; }
  _mgr_ok || { echo UNOBS; return; }                            # bus unreachable -> unobservable, not DEAD
  case "$(_unit_state "$unit")" in
    UNOBS)  echo UNOBS;   return ;;                             # list query flaked -> can't tell, FREEZE
    ABSENT) echo UNKNOWN; return ;;                             # genuinely no such unit here
  esac
  st="$(_unit_active "$unit")"
  [ -z "$st" ] && { echo UNOBS; return; }                       # empty answer -> couldn't read, don't guess
  if [ "$st" != active ]; then echo DEAD; return; fi
  if [ -n "$art" ] && ! _artifact_fresh "$art"; then echo DEAD; return; fi   # up but not cycling = hollow
  echo LIVE
}

# The room's EYES vary by node — probe whichever this node actually runs (in priority order), so the
# gate tracks the REAL vision organ — not a unit that isn't installed here (which is how the room dash's
# own pgrep-cam-watch gate reads cam=DOWN forever on this node while the webcam works fine). No producer
# present at all -> UNKNOWN (camera-less, never a false loss). Order matters: a node may run SEVERAL
# webcams (mesh-home runs the imac-cam-watch service over SSH AND the misha-wake cron locally). The
# PRIMARY room eye wins — imac-cam-watch (the room's remote camera over SSH, what the room MIND looks
# through) takes precedence over misha-wake (a face-wake reflex that happens to grab a local frame;
# its artifact going stale is a face-wake regression, NOT a room-vision loss). Caught 2026-07-19: the
# probe read misha-wake's stale frame on mesh-home while imac-cam-watch was LIVE → false "EYES DEAD"
# pokes every flap. Probe imac-cam-watch FIRST where it exists, fall through to the rest only when it
# doesn't.
_probe_cam() {
  if command -v systemctl >/dev/null 2>&1; then
    case "$(_unit_state mesh-imac-cam-watch.service)" in
      PRESENT) _probe_unit mesh-imac-cam-watch.service "$MESH/.imac-cam-prev.jpg"; return ;;
      UNOBS)   echo UNOBS; return ;;                            # can't tell if the service exists -> freeze, don't misroute
    esac
    case "$(_unit_state mesh-cam-watch.service)" in
      PRESENT) _probe_unit mesh-cam-watch.service "$MESH/cam-prev.jpg"; return ;;
      UNOBS)   echo UNOBS; return ;;                            # can't tell if the service exists -> freeze, don't misroute
    esac
  fi
  if crontab -l 2>/dev/null | grep -q 'mesh-misha-wake'; then
    _artifact_fresh "$MESH/.misha-wake-frame.jpg" "$CAM_STALE" && echo LIVE || echo DEAD; return
  fi
  echo UNKNOWN
}
_probe_ear()  { _probe_unit mesh-overhear.service; }
_probe_stt()  { _probe_unit mesh-room-gigaam.service "$TRANS"; }  # transcript must be CYCLING (mtime fresh)
_probe_wake() { _probe_unit mesh-room-reflex.service; }
probe() { "_probe_$1"; }

# ---- state: one line per sense — "name status lastpoke reading" ---------------------------------
# status is the DEBOUNCE state machine, not the raw reading:
#   LIVE     — healthy (last reading was LIVE)
#   PENDING  — read not-LIVE exactly ONCE; a poke is withheld until a SECOND consecutive not-LIVE
#              reading confirms it. A lone transient (probe race, momentary restart) clears from here
#              back to LIVE with no poke ever sent.
#   LOST     — confirmed lost (>=2 consecutive not-LIVE) and poked; holds until it recovers.
# reading = the last raw probe verdict (LIVE/DEAD/UNKNOWN), carried only to word the poke (DEAD vs
# UNKNOWN). UNOBS readings never reach here — tick() drops them before _evaluate.
# since   = when the loss was CONFIRMED (0 = not a confirmed loss: healthy, or a first-sight seed)
# lastnote = when the held loss was last RE-STATED on the board (0 = never)
# Both are appended fields: a pre-upgrade 4-field line reads them as 0, and the held branch falls back to
# lastpoke for the age, so an already-latched loss re-states with its REAL age on the first tick after
# deploy instead of pretending to be new.
_get() {  # <name> -> echoes "status lastpoke reading since lastnote" (empty if unseen)
  awk -v n="$1" '$1==n{ sc=($5==""?0:$5); ln=($6==""?0:$6); print $2, $3, $4, sc, ln }' "$STATE" 2>/dev/null
}
_set() {  # <name> <status> <lastpoke> <reading> [since] [lastnote]
  local n="$1" s="$2" lp="$3" rd="$4" sc="${5:-0}" ln="${6:-0}" tmp
  tmp="$(mktemp "${STATE}.XXXXXX")" || return 1
  { [ -f "$STATE" ] && grep -v -E "^$n[[:space:]]" "$STATE" 2>/dev/null; echo "$n $s $lp $rd $sc $ln"; } > "$tmp"
  mv -f "$tmp" "$STATE"
}

poke() {  # <name> <verdict>   — the LOUD paid wake
  local name="$1" verdict="$2"
  mesh-tell room "[room-sense-loss] YOU HAVE LOST A SENSE: $(gloss "$name") just went ${verdict} (was LIVE).
The room can no longer rely on this organ. React AT YOUR DISCRETION: try to bring it back (e.g. a cam
loss -> \`systemctl --user restart mesh-cam-watch.service\` and re-check; an ear/stt loss -> restart the
overhear/gigaam unit), and if you cannot, say so to the operator. Don't narrate — either act on it or,
if it is expected/known, note it and move on. This fires once per organ per cooldown, so it is real." \
    >/dev/null 2>&1
}

recovery_note() {  # <name> — cheap, no paid mind turn
  command -v mesh-chat >/dev/null 2>&1 && \
    mesh-chat "[fyi] room sense recovered: $(gloss "$1") is LIVE again (mesh-room-sense-loss re-armed)" \
      >/dev/null 2>&1 || true
}

# The BOARD side of a loss — the cheap mirror of recovery_note(). The paid poke() goes to the room
# PANE (mesh-tell room, off-board) to wake the room mind; but the board only ever saw the RECOVERY
# [fyi], so a board reader read every recovery with NO matching loss — a phantom one-sided recovery
# (the both-edges-same-gate trap: recovery ungated on the board, loss absent from it). Post a board
# [fyi] on EVERY confirmed loss (both POKE and SUPPRESS) so the board carries one loss line per
# recovery line. Cheap (no paid turn) — the COOLDOWN gates only the EXPENSIVE room-pane poke, never
# this board note, exactly as recovery_note() is ungated.
loss_note() {  # <name> <verdict> — cheap board [fyi], mirror of recovery_note
  command -v mesh-chat >/dev/null 2>&1 && \
    mesh-chat "[fyi] room sense lost: $(gloss "$1") went $2 (was LIVE) — mesh-room-sense-loss latched" \
      >/dev/null 2>&1 || true
}

# The HELD-loss channel: a loss that PERSISTS gets a cheap board re-statement on its OWN cadence
# (RESTATE), carrying the AGE. This is the only output a permanent loss ever produces after the confirm
# edge — the paid poke stays one-shot deliberately (a 28-day loss must not mint a paid turn per tick).
held_note() {  # <name> <verdict> <age-seconds>
  command -v mesh-chat >/dev/null 2>&1 && \
    mesh-chat "[fyi] room sense STILL lost: $(gloss "$1") $2 for $(hage "$3") — held (mesh-room-sense-loss, no re-poke; revive it or say so to the operator)" \
      >/dev/null 2>&1 || true
}

# The debounce state machine, isolated from the probe so --test can inject a reading. cur is a real
# sense verdict (LIVE/DEAD/UNKNOWN) — NEVER UNOBS (tick() filters those). Reads+writes STATE and pokes;
# echoes what it did (SEED|PENDING|POKE|SUPPRESS|HOLD|RECOVER|CLEAR) for the test and --status.
_evaluate() {  # <name> <cur:LIVE|DEAD|UNKNOWN>
  local name="$1" cur="$2" status lp rd sc ln t since_eff alive=0
  read -r status lp rd sc ln < <(_get "$name"); lp="${lp:-0}"; sc="${sc:-0}"; ln="${ln:-0}"
  case "$lp" in (''|*[!0-9]*) lp=0 ;; esac
  case "$sc" in (''|*[!0-9]*) sc=0 ;; esac
  case "$ln" in (''|*[!0-9]*) ln=0 ;; esac
  [ "$cur" = LIVE ] && alive=1

  if [ -z "$status" ]; then                                   # first sight — never poke (never saw it live)
    # A first-sight not-live seeds LOST with since=0: it is a sense that was NEVER live here, so it has no
    # confirmed loss and must never be re-stated (the held branch below requires a confirm timestamp).
    [ "$alive" = 1 ] && _set "$name" LIVE "$lp" "$cur" 0 0 || _set "$name" LOST "$lp" "$cur" 0 0
    echo SEED; return
  fi
  if [ "$alive" = 1 ]; then                                   # healthy this tick — clear since/lastnote
    if [ "$status" = LOST ]; then recovery_note "$name"; _set "$name" LIVE "$lp" LIVE 0 0; echo RECOVER; return; fi
    # LIVE->LIVE, or PENDING->LIVE (a transient that never confirmed → cleared, no poke)
    [ "$status" = PENDING ] && { _set "$name" LIVE "$lp" LIVE 0 0; echo CLEAR; return; }
    _set "$name" LIVE "$lp" LIVE 0 0; echo HOLD; return
  fi
  # not alive this tick (DEAD or UNKNOWN)
  case "$status" in
    LIVE)    _set "$name" PENDING "$lp" "$cur" 0 0; echo PENDING; return ;; # first not-live — WITHHOLD the poke
    PENDING) t="$(now)"                                                    # second consecutive — CONFIRMED loss
             if [ $(( t - lp )) -ge "$COOLDOWN" ]; then poke "$name" "$cur"; _set "$name" LOST "$t" "$cur" "$t" "$t"; loss_note "$name" "$cur"; echo POKE
             else _set "$name" LOST "$lp" "$cur" "$t" "$t"; loss_note "$name" "$cur"; echo SUPPRESS; fi; return ;;
    *)       # ALREADY LOST — the poke stays one-shot, but the loss does NOT go silent: re-state it cheaply
             # on the board every RESTATE seconds, carrying its age. This is the branch that was terminal
             # (`hold, no re-poke`) and left a 28-day loss with no expensive channel AND no cheap one.
             t="$(now)"; since_eff="$sc"; [ "$since_eff" = 0 ] && since_eff="$lp"   # pre-upgrade line: fall back to the poke ts
             if [ "$since_eff" != 0 ] && [ $(( t - ln )) -ge "$RESTATE" ]; then
               held_note "$name" "$cur" "$(( t - since_eff ))"
               _set "$name" LOST "$lp" "$cur" "$since_eff" "$t"; echo RESTATE; return
             fi
             _set "$name" LOST "$lp" "$cur" "$since_eff" "$ln"; echo HOLD; return ;;
  esac
}

tick() {
  mkdir -p "$MESH"
  local s cur
  for s in $SENSES; do
    cur="$(probe "$s")"
    # UNOBS = we could not observe this sense this tick (no bus, empty read). FREEZE it — do not evaluate,
    # do not poke, do not rewrite its status. A probe fault must never be laundered into a sense loss.
    [ "$cur" = UNOBS ] && continue
    _evaluate "$s" "$cur" >/dev/null
  done
  mesh-state-touch "$STATE" 2>/dev/null || touch "$STATE" 2>/dev/null || true   # liveness on EVERY run
}

if [ "${1:-}" = --status ]; then
  printf '=== room senses @%s ===\n' "$(date -u +%FT%TZ)"
  for s in $SENSES; do
    cur="$(probe "$s")"; read -r prev lp _ sc ln < <(_get "$s"); lp="${lp:-0}"; sc="${sc:-0}"; ln="${ln:-0}"
    case "$lp" in (''|*[!0-9]*) lp=0 ;; esac
    case "$sc" in (''|*[!0-9]*) sc=0 ;; esac
    case "$ln" in (''|*[!0-9]*) ln=0 ;; esac
    if [ "$lp" = 0 ]; then last="never"; else last="$(hage "$(( $(now) - lp ))") ago"; fi
    held=""; if [ "${prev:-}" = LOST ]; then
      se="$sc"; [ "$se" = 0 ] && se="$lp"
      [ "$se" != 0 ] && held=" LOST $(hage "$(( $(now) - se ))")"
      [ "$ln" != 0 ] && held="$held restated:$(hage "$(( $(now) - ln ))")ago"
    fi
    printf '  %-5s %-8s (stored:%-8s%s last-poke:%s) — %s\n' "$s" "$cur" "${prev:-?}" "$held" "$last" "$(gloss "$s")"
  done
  exit 0
fi

if [ "${1:-}" = --test ]; then
  f=0; tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT
  HOME="$tmp"; MESH="$tmp/.mesh"; mkdir -p "$MESH"; STATE="$MESH/.room-sense-loss.state"
  # Stub the paid poke and the liveness primitive so nothing real is touched and the poke is observable.
  # One record per poke — a sentinel line, NOT the (multi-line) message, so the counter counts POKES
  # not message lines. The full text still lands in pokes.txt for the content asserts below.
  printf '#!/usr/bin/env bash\nprintf "<<POKE>> %%s\\n" "$*" >> "%s/pokes"\n' "$tmp" > "$tmp/mesh-tell"
  printf '#!/usr/bin/env bash\nexit 0\n' > "$tmp/mesh-state-touch"
  printf '#!/usr/bin/env bash\nprintf "<<CHAT>> %%s\\n" "$*" >> "%s/chat"\n' "$tmp" > "$tmp/mesh-chat"
  chmod +x "$tmp/mesh-tell" "$tmp/mesh-state-touch" "$tmp/mesh-chat"; PATH="$tmp:$PATH"
  # `grep -c` PRINTS 0 and EXITS 1 on no match, so the old `[ -f x ] && grep -c ... || echo 0` emitted
  # TWO lines ("0\n0") for a genuine zero — which no assertion could ever equal. It never showed while
  # every assertion wanted >=1; the first want-0 gate (11b) went red on a correct run. Capture, default.
  _count() { local n; n="$(grep -c "$1" "$2" 2>/dev/null)"; echo "${n:-0}"; }
  npokes() { _count '<<POKE>>'               "$tmp/pokes"; }
  nloss()  { _count 'room sense lost'        "$tmp/chat"; }
  nrecov() { _count 'room sense recovered'   "$tmp/chat"; }
  nheld()  { _count 'room sense STILL lost'  "$tmp/chat"; }

  COOLDOWN=3600
  # 1. FIRST SIGHT seeds silently — never a poke (we never saw it LIVE, so a loss is undefined).
  for seed in LIVE DEAD UNKNOWN; do
    rm -f "$STATE" "$tmp/pokes"
    [ "$(_evaluate s "$seed")" = SEED ] || { echo "  FAIL: first sight of $seed was not SEED"; f=1; }
    [ "$(npokes)" = 0 ] || { echo "  FAIL: first sight of $seed poked (must seed silently)"; f=1; }
  done

  # 2. THE CORE REQUIREMENT — a LIVE->dead loss POKES. DEBOUNCED: the FIRST not-live reading only
  #    goes PENDING (no poke); a SECOND consecutive not-live CONFIRMS and pokes. This is the fix for
  #    the transient false poke (a lone probe blip must never reach the room).
  rm -f "$STATE" "$tmp/pokes"; _evaluate cam LIVE >/dev/null
  [ "$(_evaluate cam DEAD)" = PENDING ] || { echo "  FAIL: first not-live was not withheld as PENDING"; f=1; }
  [ "$(npokes)" = 0 ] || { echo "  FAIL: a single not-live reading poked (debounce broken)"; f=1; }
  [ "$(_evaluate cam DEAD)" = POKE ] || { echo "  FAIL: confirmed LIVE->DEAD did not POKE"; f=1; }
  [ "$(npokes)" = 1 ] || { echo "  FAIL: confirmed loss produced $(npokes) pokes, want 1"; f=1; }
  grep -q 'LOST A SENSE' "$tmp/pokes" || { echo "  FAIL: poke text missing the loss headline"; f=1; }
  grep -q 'EYES' "$tmp/pokes" || { echo "  FAIL: poke did not name the cam gloss (EYES)"; f=1; }

  # 3. THE TRANSIENT-CLEARS GATE (the 11:42 regression, 2026-07-16): a lone not-live reading that
  #    RECOVERS on the next tick must CLEAR with NO poke ever sent. Without debounce this flooded.
  rm -f "$STATE" "$tmp/pokes"; _evaluate ear LIVE >/dev/null
  [ "$(_evaluate ear UNKNOWN)" = PENDING ] || { echo "  FAIL: transient not-live was not PENDING"; f=1; }
  [ "$(_evaluate ear LIVE)" = CLEAR ] || { echo "  FAIL: a cleared transient was not CLEAR"; f=1; }
  [ "$(npokes)" = 0 ] || { echo "  FAIL: a one-tick transient POKED the room (debounce failed)"; f=1; }

  # 4. staying DEAD after a confirmed loss does NOT re-poke (LOST holds; it is not a level trigger).
  rm -f "$STATE" "$tmp/pokes"; _evaluate cam LIVE >/dev/null; _evaluate cam DEAD >/dev/null; _evaluate cam DEAD >/dev/null
  [ "$(_evaluate cam DEAD)" = HOLD ] || { echo "  FAIL: LOST->DEAD was not HOLD"; f=1; }
  [ "$(npokes)" = 1 ] || { echo "  FAIL: a held LOST sense re-poked"; f=1; }

  # 5. LIVE->UNKNOWN (confirmed) is ALSO a loss (fail-loud polarity) — can't-see is a loss, not a pass.
  rm -f "$STATE" "$tmp/pokes"; _evaluate ear LIVE >/dev/null; _evaluate ear UNKNOWN >/dev/null
  [ "$(_evaluate ear UNKNOWN)" = POKE ] || { echo "  FAIL: confirmed LIVE->UNKNOWN did not POKE (fail-loud)"; f=1; }

  # 6. COOLDOWN gates a fast flap: lose (confirmed, poke) -> recover -> lose again (confirmed) WITHIN
  #    cooldown -> SUPPRESS. A flapping organ costs at most one paid poke per cooldown.
  rm -f "$STATE" "$tmp/pokes"; COOLDOWN=3600
  _evaluate cam LIVE >/dev/null; _evaluate cam DEAD >/dev/null
  [ "$(_evaluate cam DEAD)" = POKE ] || { echo "  FAIL: first confirmed loss did not POKE"; f=1; }
  [ "$(_evaluate cam LIVE)" = RECOVER ] || { echo "  FAIL: recovery not detected (latch never re-arms)"; f=1; }
  _evaluate cam DEAD >/dev/null                                   # PENDING again
  [ "$(_evaluate cam DEAD)" = SUPPRESS ] || { echo "  FAIL: second confirmed loss within cooldown not SUPPRESSED"; f=1; }
  [ "$(npokes)" = 1 ] || { echo "  FAIL: flap produced $(npokes) pokes within cooldown, want 1"; f=1; }

  # 7. ...but past the cooldown, a real re-loss pokes again (not permanently latched).
  rm -f "$STATE" "$tmp/pokes"; COOLDOWN=0
  _evaluate cam LIVE >/dev/null; _evaluate cam DEAD >/dev/null
  [ "$(_evaluate cam DEAD)" = POKE ] || { echo "  FAIL: loss did not POKE at cooldown 0"; f=1; }
  _evaluate cam LIVE >/dev/null; _evaluate cam DEAD >/dev/null
  [ "$(_evaluate cam DEAD)" = POKE ] || { echo "  FAIL: re-loss past cooldown did not POKE"; f=1; }
  [ "$(npokes)" = 2 ] || { echo "  FAIL: two real losses past cooldown gave $(npokes) pokes, want 2"; f=1; }

  # 8. RECOVERY carries no paid poke.
  rm -f "$STATE" "$tmp/pokes"; COOLDOWN=3600
  _evaluate cam LIVE >/dev/null; _evaluate cam DEAD >/dev/null; _evaluate cam DEAD >/dev/null; rm -f "$tmp/pokes"
  [ "$(_evaluate cam LIVE)" = RECOVER ] || { echo "  FAIL: recovery not RECOVER"; f=1; }
  [ "$(npokes)" = 0 ] || { echo "  FAIL: recovery burned a paid poke"; f=1; }

  # 8b. BOARD SYMMETRY (roomsenseloss-recovery-edge-ungated): the board must carry a LOSS [fyi] for
  #     every RECOVERY [fyi]. The paid poke goes to the room PANE (off-board); the board previously
  #     saw only recoveries → a phantom one-sided recovery. A confirmed lose->recover cycle must leave
  #     the board with exactly 1 loss line and 1 recovery line. (RED-first: drop loss_note from the
  #     POKE/SUPPRESS branch and this goes 0-loss/1-recovery — the exact bug this closes.)
  rm -f "$STATE" "$tmp/pokes" "$tmp/chat"; COOLDOWN=3600
  _evaluate cam LIVE >/dev/null; _evaluate cam DEAD >/dev/null
  [ "$(_evaluate cam DEAD)" = POKE ] || { echo "  FAIL(sym): confirmed loss did not POKE"; f=1; }
  [ "$(nloss)" = 1 ] || { echo "  FAIL(sym): confirmed loss posted $(nloss) board loss lines, want 1"; f=1; }
  grep -q 'EYES' "$tmp/chat" || { echo "  FAIL(sym): board loss line did not name the cam gloss"; f=1; }
  [ "$(_evaluate cam LIVE)" = RECOVER ] || { echo "  FAIL(sym): recovery not RECOVER"; f=1; }
  [ "$(nrecov)" = 1 ] || { echo "  FAIL(sym): recovery posted $(nrecov) board lines, want 1"; f=1; }
  [ "$(nloss)" = "$(nrecov)" ] || { echo "  FAIL(sym): board asymmetric — $(nloss) loss vs $(nrecov) recovery"; f=1; }

  # 8c. A SUPPRESSED loss (flap within cooldown) still records on the board — the paid poke is gated
  #     by COOLDOWN, the cheap board note is NOT (mirror of recovery_note's ungated posting), else the
  #     following recovery is one-sided again.
  rm -f "$STATE" "$tmp/pokes" "$tmp/chat"; COOLDOWN=3600
  _evaluate cam LIVE >/dev/null; _evaluate cam DEAD >/dev/null; _evaluate cam DEAD >/dev/null  # POKE (loss#1)
  _evaluate cam LIVE >/dev/null                                                                # RECOVER
  _evaluate cam DEAD >/dev/null                                                                # PENDING
  [ "$(_evaluate cam DEAD)" = SUPPRESS ] || { echo "  FAIL(sym): second loss in cooldown not SUPPRESS"; f=1; }
  [ "$(nloss)" = 2 ] || { echo "  FAIL(sym): SUPPRESSED loss did not post a board line ($(nloss), want 2)"; f=1; }
  [ "$(npokes)" = 1 ] || { echo "  FAIL(sym): SUPPRESS burned a paid poke ($(npokes), want 1)"; f=1; }

  # 9. CRON-ENV REGRESSION (caught live 2026-07-16): an UNOBSERVABLE unit — bus unreachable, or an
  #    empty is-active from a reachable-looking manager — must read UNOBS (not DEAD/UNKNOWN), and tick()
  #    must FREEZE that sense (never evaluate, never poke). This is the root-cause gate for the false
  #    poke that woke the room about three healthy organs. Drive _probe_unit through a stubbed systemctl.
  sc="$tmp/systemctl"
  cat > "$sc" <<'SC'
#!/usr/bin/env bash
shift  # drop --user
# list-unit-files output MIRRORS real systemctl: a reachable mgr ALWAYS prints the "UNIT FILE" header
# (present -> header+row; absent -> header+"0 unit files listed."); a FLAKED query prints nothing.
_luf_present() { printf 'UNIT FILE               STATE   PRESET\n%s enabled enabled\n\n1 unit files listed.\n' "$2"; }
_luf_absent()  { printf 'UNIT FILE               STATE   PRESET\n\n0 unit files listed.\n'; exit 1; }
case "$FAKE_SC" in
  busfail)  exit 1 ;;                                    # every query fails: bus unreachable
  listfail) case "$1" in show-environment) exit 0;; list-unit-files) exit 1;; is-active) echo active; exit 0;; esac ;;  # mgr REACHABLE but the list-unit-files query flaked (D-Bus miss under load) -> UNOBS, NOT absent
  emptyact) case "$1" in show-environment) exit 0;; list-unit-files) _luf_present "$@";; is-active) exit 3;; esac ;;  # reachable but empty is-active read
  inactive) case "$1" in show-environment) exit 0;; list-unit-files) _luf_present "$@";; is-active) echo inactive; exit 3;; esac ;;
  active)   case "$1" in show-environment) exit 0;; list-unit-files) _luf_present "$@";; is-active) echo active; exit 0;; esac ;;
  nounit)   case "$1" in show-environment) exit 0;; list-unit-files) _luf_absent "$@";; is-active) echo inactive; exit 3;; esac ;;  # mgr ok, unit genuinely absent
esac
exit 0
SC
  chmod +x "$sc"
  [ "$(FAKE_SC=busfail  PATH="$tmp:$PATH" _probe_unit x.service)" = UNOBS ]   || { echo "  FAIL: unreachable bus was not UNOBS (would flood under cron)"; f=1; }
  # THE ROOT-CAUSE GATE (2026-07-16 false poke): the manager is reachable (show-environment ok) but the
  # list-unit-files query itself FLAKES under cron load. That is UNOBSERVABLE, and MUST NOT be laundered
  # into UNKNOWN (a loss). This is the exact path that paid-poked the room about a healthy ear across two
  # real cron fires; RED against _unit_installed's boolean collapse, green once list-failure -> UNOBS.
  [ "$(FAKE_SC=listfail PATH="$tmp:$PATH" _probe_unit x.service)" = UNOBS ]   || { echo "  FAIL: a reachable mgr whose list-unit-files query FLAKED was not UNOBS (laundered into a loss poke)"; f=1; }
  [ "$(FAKE_SC=emptyact PATH="$tmp:$PATH" _probe_unit x.service)" = UNOBS ]   || { echo "  FAIL: empty is-active read was not UNOBS"; f=1; }
  [ "$(FAKE_SC=nounit   PATH="$tmp:$PATH" _probe_unit x.service)" = UNKNOWN ] || { echo "  FAIL: an uninstalled unit was not UNKNOWN"; f=1; }
  [ "$(FAKE_SC=inactive PATH="$tmp:$PATH" _probe_unit x.service)" = DEAD ]    || { echo "  FAIL: reachable+inactive was not DEAD"; f=1; }
  [ "$(FAKE_SC=active   PATH="$tmp:$PATH" _probe_unit x.service)" = LIVE ]    || { echo "  FAIL: reachable+active was not LIVE"; f=1; }
  # tick() must FREEZE an UNOBS sense: state untouched, no poke. Seed cam=LIVE, then a probe that returns
  # UNOBS every tick must never advance cam toward PENDING/LOST and never poke.
  rm -f "$STATE" "$tmp/pokes"; SENSES=cam; _evaluate cam LIVE >/dev/null
  probe() { echo UNOBS; }
  tick; tick
  [ "$(_get cam)" = "LIVE 0 LIVE 0 0" ] || { echo "  FAIL: an UNOBS sense was not frozen at LIVE (got: $(_get cam))"; f=1; }
  [ "$(npokes)" = 0 ] || { echo "  FAIL: an UNOBS (unobservable) sense POKED the room"; f=1; }
  unset -f probe; SENSES="cam ear stt wake"

  # 11. THE HELD-LOSS CHANNEL (a-persistent-loss-is-the-one-loss-the-latch-cannot-report, {#46195e58}).
  #     RED against the old terminal `*) hold, no re-poke`: a confirmed loss that PERSISTS produced
  #     nothing on ANY channel forever (measured: stt DEAD 28d, ~8000 ticks, zero output). A held LOST
  #     must re-state itself on the board on its OWN cadence (RESTATE), carrying the AGE — and must
  #     NEVER burn a second paid poke.
  rm -f "$STATE" "$tmp/pokes" "$tmp/chat"; COOLDOWN=3600; RESTATE=0
  _evaluate stt LIVE >/dev/null; _evaluate stt DEAD >/dev/null
  [ "$(_evaluate stt DEAD)" = POKE ] || { echo "  FAIL(held): confirmed loss did not POKE"; f=1; }
  [ "$(_evaluate stt DEAD)" = RESTATE ] || { echo "  FAIL(held): a HELD loss did not RE-STATE (the terminal-hold bug: a persistent loss is silent forever)"; f=1; }
  [ "$(_evaluate stt DEAD)" = RESTATE ] || { echo "  FAIL(held): the second held tick did not RE-STATE"; f=1; }
  [ "$(npokes)" = 1 ] || { echo "  FAIL(held): re-statement burned a paid poke ($(npokes), want 1)"; f=1; }
  [ "$(nheld)" = 2 ] || { echo "  FAIL(held): $(nheld) held board lines, want 2"; f=1; }
  grep -q 'HEARING-INTO-WORDS' "$tmp/chat" || { echo "  FAIL(held): held line did not name the stt gloss"; f=1; }

  # 11b. ...but the CHEAP channel is still PACED: inside RESTATE the held ticks stay silent HOLDs, so a
  #      permanently dead organ costs one board line per day, not one per 5-minute cron tick.
  rm -f "$STATE" "$tmp/pokes" "$tmp/chat"; RESTATE=86400
  _evaluate stt LIVE >/dev/null; _evaluate stt DEAD >/dev/null; _evaluate stt DEAD >/dev/null   # POKE
  [ "$(_evaluate stt DEAD)" = HOLD ] || { echo "  FAIL(held): a held tick inside RESTATE was not a silent HOLD"; f=1; }
  [ "$(_evaluate stt DEAD)" = HOLD ] || { echo "  FAIL(held): a held tick inside RESTATE was not a silent HOLD"; f=1; }
  [ "$(nheld)" = 0 ] || { echo "  FAIL(held): $(nheld) held lines inside RESTATE, want 0 (board flood)"; f=1; }

  # 11c. THE AGE IS THE POINT — the re-statement must carry how long it has been lost, so "stt DEAD 28d"
  #      is readable without subtracting epochs. Backdate the confirm ts by 28 days and assert "28d".
  rm -f "$STATE" "$tmp/pokes" "$tmp/chat"; RESTATE=0
  _evaluate wake LIVE >/dev/null; _evaluate wake DEAD >/dev/null; _evaluate wake DEAD >/dev/null  # POKE
  old28=$(( $(now) - 28*86400 )); _set wake LOST "$old28" DEAD "$old28" "$old28"
  [ "$(_evaluate wake DEAD)" = RESTATE ] || { echo "  FAIL(held): backdated held loss did not RE-STATE"; f=1; }
  grep -q 'for 28d' "$tmp/chat" || { echo "  FAIL(held): re-statement carried no age (want '28d'): $(tail -1 "$tmp/chat")"; f=1; }

  # 11d. A PRE-UPGRADE 4-FIELD STATE LINE (already latched before this fix) must re-state with its REAL
  #      age from lastpoke, not pretend to be new — the live state on 2026-08-21 was exactly this shape.
  rm -f "$STATE" "$tmp/pokes" "$tmp/chat"; RESTATE=0
  printf 'stt LOST %s DEAD\n' "$(( $(now) - 28*86400 ))" > "$STATE"
  [ "$(_evaluate stt DEAD)" = RESTATE ] || { echo "  FAIL(held): a legacy 4-field LOST line did not RE-STATE"; f=1; }
  grep -q 'for 28d' "$tmp/chat" || { echo "  FAIL(held): legacy line re-stated with the wrong age: $(tail -1 "$tmp/chat")"; f=1; }

  # 11e. A FIRST-SIGHT LOST (an organ that was NEVER live here — no confirm timestamp) must NEVER be
  #      re-stated: crying wolf about a sense this node does not have is the false-poke failure the
  #      debounce/UNOBS work already closed once.
  rm -f "$STATE" "$tmp/pokes" "$tmp/chat"; RESTATE=0
  [ "$(_evaluate cam DEAD)" = SEED ] || { echo "  FAIL(held): first sight of DEAD was not SEED"; f=1; }
  [ "$(_evaluate cam DEAD)" = HOLD ] || { echo "  FAIL(held): a never-was-live seeded LOST was not a silent HOLD"; f=1; }
  [ "$(nheld)" = 0 ] || { echo "  FAIL(held): a never-was-live sense was re-stated ($(nheld) lines) — crying wolf"; f=1; }
  [ "$(npokes)" = 0 ] || { echo "  FAIL(held): a never-was-live sense poked"; f=1; }

  # 11f. RECOVERY clears the held bookkeeping: a later, genuinely NEW loss must state itself fresh, not
  #      inherit the previous loss's age or its restate clock.
  rm -f "$STATE" "$tmp/pokes" "$tmp/chat"; RESTATE=0; COOLDOWN=0
  _evaluate ear LIVE >/dev/null; _evaluate ear DEAD >/dev/null; _evaluate ear DEAD >/dev/null   # POKE
  _evaluate ear DEAD >/dev/null                                                                 # RESTATE
  [ "$(_evaluate ear LIVE)" = RECOVER ] || { echo "  FAIL(held): recovery after a re-statement not RECOVER"; f=1; }
  read -r st lpx rdx scx lnx < <(_get ear)
  [ "$scx" = 0 ] && [ "$lnx" = 0 ] || { echo "  FAIL(held): recovery left since/lastnote set ($scx/$lnx) — a new loss would inherit the old age"; f=1; }
  COOLDOWN=3600; RESTATE=86400

  # 10. LIVENESS-TOUCH: tick() refreshes STATE mtime even when nothing changes (all senses hold LIVE).
  probe() { echo LIVE; }
  rm -f "$STATE"; : > "$STATE"; touch -d '2020-01-01' "$STATE"
  rm -f "$tmp/mesh-state-touch"                          # exercise the real `touch` fallback path
  tick
  m="$(stat -c %Y "$STATE" 2>/dev/null || echo 0)"
  [ "$m" -gt "$(date -d '2021-01-01' +%s)" ] || { echo "  FAIL: tick() did not liveness-touch STATE mtime"; f=1; }
  printf '#!/usr/bin/env bash\nexit 0\n' > "$tmp/mesh-state-touch"; chmod +x "$tmp/mesh-state-touch"; unset -f probe

  [ "$f" = 0 ] && echo "  PASS: seeds silent, loss debounced+poked, transient clears free, flap cooldown-gated, HELD loss re-stated cheaply with its age (never re-poked, never for a never-live sense), recovery free, UNOBS frozen, liveness-touched" || exit 1
  exit 0
fi

tick
