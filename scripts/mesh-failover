#!/usr/bin/env bash
# mesh-failover — recover agentic tasks stranded on rate-limited workers.
# When a claude worker posts [mind-limited], its open [taking] task rots on the board
# unless re-dispatched to a free-engine worker that can complete it. This script:
#   --scan   polls chat.log for recent unhandled [mind-limited] events → re-dispatches
#   --handle HOST:WIN   recover stranded tasks for one specific worker
#   --test   smoke test (no side effects)
#
# Design: knowledge/agentic-failover-design-2026-06-15.md
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
BOARD="${MESH_BOARD:-$HOME/.mesh/chat.log}"
TRACES="${MESH_TRACES:-$HOME/.mesh/traces.log}"
SESS="$(hostname)"

# --------------------------------------------------------------------
# fingerprint: first 80 chars, whitespace-normalized, collapsed spaces
# --------------------------------------------------------------------
fingerprint() {
  printf '%s' "$1" | tr -s '[:space:]' ' ' | sed 's/^ *//;s/ *$//' | cut -c1-80
}

# --------------------------------------------------------------------
# fo_book <today> — today's failover bookkeeping, board ∪ trace, sorted.
# Real [failover-dispatched] reassignments live on the BOARD; the no-op
# 'failover-none' records (a worker with nothing open) live on the TRACE,
# kept off the board as noise. Every idempotency/dedup read consults BOTH
# so dedup holds wherever a marker was recorded.
# --------------------------------------------------------------------
fo_book() {
  { grep "^$1T" "$BOARD"   2>/dev/null | grep -E '\[failover-dispatched\]'
    grep "^$1T" "$TRACES" 2>/dev/null | grep -E 'failover-none'
  } | sort
}

# --test: verify dependencies + dead-worker detection logic
if [ "${1:-}" = "--test" ]; then
  fail=0
  have() { command -v "$1" >/dev/null 2>&1 || { echo "  FAIL: no $1"; fail=1; }; }
  have mesh-mind-control
  have mesh-chat
  have mesh-mind-state
  have mesh-trace
  [ -r "$BOARD" ] || { echo "  FAIL: board unreadable: $BOARD"; fail=1; }
  # Verify fingerprint function works
  fp=$(fingerprint "test task with extra   spaces")
  [ "$fp" = "test task with extra spaces" ] || { echo "  FAIL: fingerprint normalization broken (got '$fp')"; fail=1; }

  # Behavioral: a worker with [mind-limited] but NO open [taking] is a no-op —
  # it must route to the TRACE, never pollute the board with [failover-dispatched].
  # Sandbox board+trace into a tmpdir (MESH_DIR redirects mesh-trace's write).
  _td="$(mktemp -d)" || { echo "  FAIL: mktemp"; fail=1; }
  if [ -n "${_td:-}" ] && [ -d "$_td" ]; then
    _td_today="$(date -u +%Y-%m-%d)"
    _td_w="testhost:testwin"
    printf '%sT00:00:01Z  x  ::  [mind-limited] %s rate-limited\n' "$_td_today" "$_td_w" > "$_td/chat.log"
    : > "$_td/traces.log"
    MESH_BOARD="$_td/chat.log" MESH_TRACES="$_td/traces.log" MESH_DIR="$_td" \
      bash "$0" --handle "$_td_w" >/dev/null 2>&1 || true
    grep -q "failover-none .*${_td_w}.*no open \[taking\]" "$_td/traces.log" 2>/dev/null \
      || { echo "  FAIL: NONE no-op did not route to trace"; fail=1; }
    grep -q '\[failover-dispatched\]' "$_td/chat.log" 2>/dev/null \
      && { echo "  FAIL: NONE no-op polluted the board with [failover-dispatched]"; fail=1; }
    rm -rf "$_td"
  fi

  # --scan-dead: DEAD-SHELL must be treated as dead too (chat-review/shed-pane-dead-shell-
  # misclassified 2026-07-07) — a shed/killed worker's pane classifies DEAD-SHELL (process-truth),
  # not the plain "DEAD" this file's exact-match check originally looked for; without the fix its
  # stranded [taking] would never re-dispatch. mesh-mind-state/mesh-chat/mesh-mind-control stubbed as
  # exported functions (bash resolves them before PATH in the child `bash "$0"` invocation too — same
  # convention as the sandboxed --handle test above, extended to a subprocess since --scan-dead reads
  # its own top-level HOST/BOARD at script start).
  _fd_board="$(mktemp)"; _fd_today="$(date -u +%Y-%m-%d)"
  _fd_w="$(hostname):deadshelltestwin$$"
  printf '%sT00:00:01Z  x  ::  [taking] %s: some stranded task\n' "$_fd_today" "$_fd_w" > "$_fd_board"
  _fd_mark="$(mktemp)"; _fd_traces="$(mktemp)"
  mesh-mind-state(){ printf 'DEAD-SHELL\tbare shell — no mind-engine process\n'; return 8; }
  mesh-chat(){ printf '%s\n' "$*" >> "$_fd_mark_path"; }
  mesh-mind-control(){ :; }
  export -f mesh-mind-state mesh-chat mesh-mind-control
  _fd_mark_path="$_fd_mark" MESH_BOARD="$_fd_board" MESH_TRACES="$_fd_traces" \
    bash "$0" --scan-dead >/dev/null 2>&1
  grep -q "failover-dispatched.*${_fd_w}" "$_fd_mark" 2>/dev/null \
    || { echo "  FAIL: --scan-dead did not treat a DEAD-SHELL worker as dead (no dispatch recorded, mark: $(cat "$_fd_mark" 2>/dev/null))"; fail=1; }
  unset -f mesh-mind-state mesh-chat mesh-mind-control
  rm -f "$_fd_board" "$_fd_mark" "$_fd_traces"

  # --scan-dead: AUTH-DEAD (chat-review/mindstate-loggedout-not-idle) must ALSO re-dispatch a stranded
  # [taking] — a logged-out worker can't finish its claimed work. Same subprocess-stub convention as the
  # DEAD-SHELL case above; only the stubbed classification (exit 9) differs. Falsify: drop AUTH-DEAD from
  # the case arm → this stranded [taking] is skipped and no dispatch is recorded.
  _fa_board="$(mktemp)"; _fa_w="$(hostname):authdeadtestwin$$"
  printf '%sT00:00:01Z  x  ::  [taking] %s: some stranded task\n' "$(date -u +%Y-%m-%d)" "$_fa_w" > "$_fa_board"
  _fa_mark="$(mktemp)"; _fa_traces="$(mktemp)"
  mesh-mind-state(){ printf 'AUTH-DEAD\tNot logged in · Please run /login\n'; return 9; }
  mesh-chat(){ printf '%s\n' "$*" >> "$_fd_mark_path"; }
  mesh-mind-control(){ :; }
  export -f mesh-mind-state mesh-chat mesh-mind-control
  _fd_mark_path="$_fa_mark" MESH_BOARD="$_fa_board" MESH_TRACES="$_fa_traces" \
    bash "$0" --scan-dead >/dev/null 2>&1
  grep -q "failover-dispatched.*${_fa_w}" "$_fa_mark" 2>/dev/null \
    || { echo "  FAIL: --scan-dead did not treat an AUTH-DEAD (logged-out) worker as dead (no dispatch recorded, mark: $(cat "$_fa_mark" 2>/dev/null))"; fail=1; }
  unset -f mesh-mind-state mesh-chat mesh-mind-control
  rm -f "$_fa_board" "$_fa_mark" "$_fa_traces"

  [ "$fail" = 0 ] && echo "mesh-failover --test: ok" || { echo "mesh-failover --test: FAIL"; exit 1; }
  exit 0
fi

# --------------------------------------------------------------------
# Handle one stranded worker: HOST:WIN
# Returns 0 if at least one task was dispatched, 1 if nothing to do
# --------------------------------------------------------------------
handle_one() {
  local worker="$1"
  local host="${worker%%:*}"
  local win="${worker#*:}"
  local today
  today="$(date -u +%Y-%m-%d)"
  local dispatched=0

  # Find [mind-limited] event timestamp for this worker (today only)
  # Match only real events (tag after " :: ", not mentions in task descriptions)
  local limit_ts=""
  limit_ts=$(grep "^${today}T" "$BOARD" 2>/dev/null | grep ' ::  \[mind-limited\]' | grep "${worker}" | tail -1 | cut -d' ' -f1 | cut -d'T' -f2 || true)
  [ -z "$limit_ts" ] && return 1

  # Find [taking] lines by this worker (today only)
  # Match only real events (tag after " :: ")
  local takings
  takings=$(grep "^${today}T" "$BOARD" 2>/dev/null | grep ' ::  \[taking\]' | grep "${worker}")

  if [ -z "$takings" ]; then
    # No open [taking] — a no-op, NOT a real reassignment. Record once on the
    # durable TRACE (the idempotency reads below consult it) instead of the
    # board, so the board keeps only real [failover-dispatched] reassignments.
    MESH_WHO="failover@${SESS}" mesh-trace "failover-none ${worker} (no open [taking])" >/dev/null 2>&1
    return 0
  fi

  # For each [taking] line, extract task and check guards
  local IFSBK="$IFS"
  while IFS= read -r line; do
    # Skip if this [taking] was posted AFTER the [mind-limited] event (mind already recovered)
    local ts
    ts=$(echo "$line" | cut -d' ' -f1 | cut -d'T' -f2)
    [ "$ts" \> "$limit_ts" ] 2>/dev/null && continue

    # Extract the task text: everything after " ::  [taking] HOST:WIN: "
    local task
    task=$(echo "$line" | sed 's/^.*\[taking\] [^:]*:[^:]*: //')

    # Skip empty tasks
    [ -z "$task" ] && continue

    # Compute fingerprint
    local fp
    fp=$(fingerprint "$task")
    [ -z "$fp" ] && continue

    # Guard 1: already done (a [done] today contains this fingerprint)
    grep "^${today}T" "$BOARD" 2>/dev/null | grep ' ::  \[done\]' | grep -qF "$fp" && continue

    # Guard 2: already retaken (a [taking] from a DIFFERENT window after limit_ts)
    local retaken=0
    while IFS= read -r rl; do
      local rts
      rts=$(echo "$rl" | cut -d' ' -f1 | cut -d'T' -f2)
      [ "$rts" \> "$limit_ts" ] 2>/dev/null && { retaken=1; break; }
    done < <(grep "^${today}T" "$BOARD" 2>/dev/null | grep ' ::  \[taking\]' | grep -v "${worker}" | grep -F "$fp")
    [ "$retaken" = 1 ] && continue

    # Guard 3: already failovered for this fingerprint (board ∪ trace today)
    fo_book "$today" | grep -qF "$fp" && continue

    # Re-dispatch: post as [task] with failover marker, then dispatch
    local failover_task="${task}  [failover from ${worker}]"
    MESH_WHO="failover@${SESS}" mesh-chat "[task] ${failover_task}" >/dev/null 2>&1
    mesh-mind-control --dispatch "${failover_task}" >/dev/null 2>&1 && dispatched=1

    # Mark handled
    MESH_WHO="failover@${SESS}" mesh-chat "[failover-dispatched] ${worker} → ${fp}" >/dev/null 2>&1
  done <<<"$takings"
  IFS="$IFSBK"

  [ "$dispatched" = 1 ] && return 0 || return 1
}

# --------------------------------------------------------------------
# Handle one DEAD worker: HOST:WIN — re-dispatch [taking] tasks whose
# mind process died (bare shell prompt), no limit_ts needed.
# --------------------------------------------------------------------
handle_dead_one() {
  local worker="$1"
  local today="$(date -u +%Y-%m-%d)"
  local dispatched=0
  local takings
  takings=$(grep "^${today}T" "$BOARD" 2>/dev/null | grep ' ::  \[taking\]' | grep "${worker}")
  if [ -z "$takings" ]; then
    # DEAD worker with nothing open — same no-op: trace, not board.
    MESH_WHO="failover@${SESS}" mesh-trace "failover-none ${worker} (DEAD, no open [taking])" >/dev/null 2>&1
    return 0
  fi
  local IFSBK="$IFS"
  while IFS= read -r line; do
    local task fp
    task=$(echo "$line" | sed 's/^.*\[taking\] [^:]*:[^:]*: //')
    [ -z "$task" ] && continue
    fp=$(fingerprint "$task"); [ -z "$fp" ] && continue
    grep "^${today}T" "$BOARD" 2>/dev/null | grep ' ::  \[done\]' | grep -qF "$fp" && continue
    grep "^${today}T" "$BOARD" 2>/dev/null | grep ' ::  \[taking\]' | grep -v "${worker}" | grep -qF "$fp" && continue
    fo_book "$today" | grep -qF "$fp" && continue
    local failover_task="${task}  [failover from dead ${worker}]"
    MESH_WHO="failover@${SESS}" mesh-chat "[task] ${failover_task}" >/dev/null 2>&1
    mesh-mind-control --dispatch "${failover_task}" >/dev/null 2>&1 && dispatched=1
    MESH_WHO="failover@${SESS}" mesh-chat "[failover-dispatched] ${worker} → ${fp} (DEAD)" >/dev/null 2>&1
  done <<<"$takings"; IFS="$IFSBK"
  [ "$dispatched" = 1 ] && return 0 || return 1
}

# --------------------------------------------------------------------
# --handle HOST:WIN
# --------------------------------------------------------------------
if [ "${1:-}" = "--handle" ] && [ $# -ge 2 ]; then
  handle_one "$2"
  exit $?
fi

# --------------------------------------------------------------------
# --scan: read recent [mind-limited] events, handle unhandled ones
# --------------------------------------------------------------------
if [ "${1:-}" = "--scan" ]; then
  today="$(date -u +%Y-%m-%d)"
  # Find [mind-limited] events today that haven't been handled yet
  events=$(grep "^${today}T" "$BOARD" 2>/dev/null | grep ' ::  \[mind-limited\]' | grep -oP '\[mind-limited\] \K[^ ]+' | sort -u || true)

  for worker in $events; do
    # Skip if already handled (a failover record — board reassignment OR trace
    # no-op — exists for this worker after the last [mind-limited])
    handled=$(fo_book "$today" | grep -F "${worker}")
    if [ -n "$handled" ]; then
      # Check if there's a newer [mind-limited] AFTER the last handled
      last_handled_ts=$(echo "$handled" | tail -1 | cut -d' ' -f1 | cut -d'T' -f2)
      newer_limit=$(grep "^${today}T" "$BOARD" 2>/dev/null | grep ' ::  \[mind-limited\]' | grep "${worker}" | while IFS= read -r l; do
        lts=$(echo "$l" | cut -d' ' -f1 | cut -d'T' -f2)
        [ "$lts" \> "$last_handled_ts" ] 2>/dev/null && echo "$l"
      done)
      [ -z "$newer_limit" ] && continue
    fi
    handle_one "$worker" || true
  done
  exit 0
fi

# --------------------------------------------------------------------
# --scan-dead: find workers whose mind process DIED (DEAD state) with
# open [taking] claims and re-dispatch their tasks.
# --------------------------------------------------------------------
if [ "${1:-}" = "--scan-dead" ]; then
  today="$(date -u +%Y-%m-%d)"
  HOST="$(hostname)"
  workers=$(grep "^${today}T" "$BOARD" 2>/dev/null | grep ' ::  \[taking\]' | grep -oP '\[taking\] \K[^ ]+' | sort -u || true)
  for worker in $workers; do
    whost="${worker%%:*}"; wwin="${worker#*:}"
    [ "$whost" != "$HOST" ] && [ "$whost" != "local" ] && continue
    state=$(mesh-mind-state "$wwin" 2>/dev/null | head -1 | cut -f1)
    # DEAD-SHELL (chat-review/shed-pane-dead-shell-misclassified 2026-07-07): process-truth confirms
    # no mind engine at all — MORE certain than plain DEAD, not less. An exact-match "!= DEAD" here
    # would skip a shed/killed worker's stranded [taking] forever (it never re-dispatches).
    # AUTH-DEAD (chat-review/mindstate-loggedout-not-idle): a LOGGED-OUT worker can't finish its claimed
    # work until a human re-logs it in — treat its stranded [taking] as dead too, so it re-dispatches.
    case "$state" in DEAD|DEAD-SHELL|AUTH-DEAD) : ;; *) continue ;; esac
    fo_book "$today" | grep -F "${worker}" | grep -q 'DEAD' && continue
    handle_dead_one "$worker" || true
  done
  exit 0
fi

# --------------------------------------------------------------------
# Default: print usage
# --------------------------------------------------------------------
cat <<'EOF'
mesh-failover — recover agentic tasks stranded on rate-limited workers

  mesh-failover --test            smoke test (dependencies + board readable)
  mesh-failover --handle HOST:WIN recover stranded tasks for one worker
  mesh-failover --scan            scan chat.log for unhandled [mind-limited] → re-dispatch
  mesh-failover --scan-dead       scan for DEAD workers (process died) with open [taking] → re-dispatch

Wire-up (add to reflexes.cron):
  */2 * * * * mesh-failover --scan >> $HOME/.mesh/failover.log 2>&1
  */5 * * * * mesh-failover --scan-dead >> $HOME/.mesh/failover.log 2>&1
EOF
exit 0
