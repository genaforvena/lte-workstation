#!/usr/bin/env bash
# mesh-failover — recover agentic tasks stranded on rate-limited workers.
# When a claude worker posts [mind-limited], its open [taking] task rots on the board
# unless re-dispatched to a free-engine worker that can complete it. This script:
#   --scan   polls chat.log for recent unhandled [mind-limited] events → re-dispatches
#   --handle HOST:WIN   recover stranded tasks for one specific worker
#   --test   smoke test (no side effects)
#
# Design: knowledge/agentic-failover-design-2026-06-15.md
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
BOARD="$HOME/.mesh/chat.log"
SESS="$(hostname)"

# --------------------------------------------------------------------
# fingerprint: first 80 chars, whitespace-normalized, collapsed spaces
# --------------------------------------------------------------------
fingerprint() {
  printf '%s' "$1" | tr -s '[:space:]' ' ' | sed 's/^ *//;s/ *$//' | cut -c1-80
}

# --test: verify dependencies + dead-worker detection logic
if [ "${1:-}" = "--test" ]; then
  fail=0
  have() { command -v "$1" >/dev/null 2>&1 || { echo "  FAIL: no $1"; fail=1; }; }
  have mesh-mind-control
  have mesh-chat
  have mesh-mind-state
  [ -r "$BOARD" ] || { echo "  FAIL: board unreadable: $BOARD"; fail=1; }
  # Verify fingerprint function works
  fp=$(fingerprint "test task with extra   spaces")
  [ "$fp" = "test task with extra spaces" ] || { echo "  FAIL: fingerprint normalization broken (got '$fp')"; fail=1; }
  [ "$fail" = 0 ] && echo "mesh-failover --test: ok" || { echo "mesh-failover --test: FAIL"; exit 1; }
  exit 0
fi

# --------------------------------------------------------------------
# Handle one stranded worker: HOST:WIN
# Returns 0 if at least one task was dispatched, 1 if nothing to do
# --------------------------------------------------------------------
handle_one() {
  local worker="$1"
  local host="${worker%%:*}"
  local win="${worker#*:}"
  local today
  today="$(date -u +%Y-%m-%d)"
  local dispatched=0

  # Find [mind-limited] event timestamp for this worker (today only)
  # Match only real events (tag after " :: ", not mentions in task descriptions)
  local limit_ts=""
  limit_ts=$(grep "^${today}T" "$BOARD" 2>/dev/null | grep ' ::  \[mind-limited\]' | grep "${worker}" | tail -1 | cut -d' ' -f1 | cut -d'T' -f2 || true)
  [ -z "$limit_ts" ] && return 1

  # Find [taking] lines by this worker (today only)
  # Match only real events (tag after " :: ")
  local takings
  takings=$(grep "^${today}T" "$BOARD" 2>/dev/null | grep ' ::  \[taking\]' | grep "${worker}")

  if [ -z "$takings" ]; then
    # No open [taking] — mark as handled (no task to re-route)
    MESH_WHO="failover@${SESS}" mesh-chat "[failover-dispatched] ${worker} → NONE (no open [taking])" >/dev/null 2>&1
    return 0
  fi

  # For each [taking] line, extract task and check guards
  local IFSBK="$IFS"
  while IFS= read -r line; do
    # Skip if this [taking] was posted AFTER the [mind-limited] event (mind already recovered)
    local ts
    ts=$(echo "$line" | cut -d' ' -f1 | cut -d'T' -f2)
    [ "$ts" \> "$limit_ts" ] 2>/dev/null && continue

    # Extract the task text: everything after " ::  [taking] HOST:WIN: "
    local task
    task=$(echo "$line" | sed 's/^.*\[taking\] [^:]*:[^:]*: //')

    # Skip empty tasks
    [ -z "$task" ] && continue

    # Compute fingerprint
    local fp
    fp=$(fingerprint "$task")
    [ -z "$fp" ] && continue

    # Guard 1: already done (a [done] today contains this fingerprint)
    grep "^${today}T" "$BOARD" 2>/dev/null | grep ' ::  \[done\]' | grep -qF "$fp" && continue

    # Guard 2: already retaken (a [taking] from a DIFFERENT window after limit_ts)
    local retaken=0
    while IFS= read -r rl; do
      local rts
      rts=$(echo "$rl" | cut -d' ' -f1 | cut -d'T' -f2)
      [ "$rts" \> "$limit_ts" ] 2>/dev/null && { retaken=1; break; }
    done < <(grep "^${today}T" "$BOARD" 2>/dev/null | grep ' ::  \[taking\]' | grep -v "${worker}" | grep -F "$fp")
    [ "$retaken" = 1 ] && continue

    # Guard 3: already failovered for this fingerprint (any FAILOVER-DISPATCHED line today)
    grep "^${today}T" "$BOARD" 2>/dev/null | grep '\[failover-dispatched\]' | grep -qF "$fp" && continue

    # Re-dispatch: post as [task] with failover marker, then dispatch
    local failover_task="${task}  [failover from ${worker}]"
    MESH_WHO="failover@${SESS}" mesh-chat "[task] ${failover_task}" >/dev/null 2>&1
    mesh-mind-control --dispatch "${failover_task}" >/dev/null 2>&1 && dispatched=1

    # Mark handled
    MESH_WHO="failover@${SESS}" mesh-chat "[failover-dispatched] ${worker} → ${fp}" >/dev/null 2>&1
  done <<<"$takings"
  IFS="$IFSBK"

  [ "$dispatched" = 1 ] && return 0 || return 1
}

# --------------------------------------------------------------------
# Handle one DEAD worker: HOST:WIN — re-dispatch [taking] tasks whose
# mind process died (bare shell prompt), no limit_ts needed.
# --------------------------------------------------------------------
handle_dead_one() {
  local worker="$1"
  local today="$(date -u +%Y-%m-%d)"
  local dispatched=0
  local takings
  takings=$(grep "^${today}T" "$BOARD" 2>/dev/null | grep ' ::  \[taking\]' | grep "${worker}")
  if [ -z "$takings" ]; then
    MESH_WHO="failover@${SESS}" mesh-chat "[failover-dispatched] ${worker} → NONE (DEAD, no open [taking])" >/dev/null 2>&1
    return 0
  fi
  local IFSBK="$IFS"
  while IFS= read -r line; do
    local task fp
    task=$(echo "$line" | sed 's/^.*\[taking\] [^:]*:[^:]*: //')
    [ -z "$task" ] && continue
    fp=$(fingerprint "$task"); [ -z "$fp" ] && continue
    grep "^${today}T" "$BOARD" 2>/dev/null | grep ' ::  \[done\]' | grep -qF "$fp" && continue
    grep "^${today}T" "$BOARD" 2>/dev/null | grep ' ::  \[taking\]' | grep -v "${worker}" | grep -qF "$fp" && continue
    grep "^${today}T" "$BOARD" 2>/dev/null | grep '\[failover-dispatched\]' | grep -qF "$fp" && continue
    local failover_task="${task}  [failover from dead ${worker}]"
    MESH_WHO="failover@${SESS}" mesh-chat "[task] ${failover_task}" >/dev/null 2>&1
    mesh-mind-control --dispatch "${failover_task}" >/dev/null 2>&1 && dispatched=1
    MESH_WHO="failover@${SESS}" mesh-chat "[failover-dispatched] ${worker} → ${fp} (DEAD)" >/dev/null 2>&1
  done <<<"$takings"; IFS="$IFSBK"
  [ "$dispatched" = 1 ] && return 0 || return 1
}

# --------------------------------------------------------------------
# --handle HOST:WIN
# --------------------------------------------------------------------
if [ "${1:-}" = "--handle" ] && [ $# -ge 2 ]; then
  handle_one "$2"
  exit $?
fi

# --------------------------------------------------------------------
# --scan: read recent [mind-limited] events, handle unhandled ones
# --------------------------------------------------------------------
if [ "${1:-}" = "--scan" ]; then
  today="$(date -u +%Y-%m-%d)"
  # Find [mind-limited] events today that haven't been handled yet
  events=$(grep "^${today}T" "$BOARD" 2>/dev/null | grep ' ::  \[mind-limited\]' | grep -oP '\[mind-limited\] \K[^ ]+' | sort -u || true)

  for worker in $events; do
    # Skip if already handled (a [failover-dispatched] exists for this worker after the last [mind-limited])
    handled=$(grep "^${today}T" "$BOARD" 2>/dev/null | grep "\[failover-dispatched\].*${worker}")
    if [ -n "$handled" ]; then
      # Check if there's a newer [mind-limited] AFTER the last handled
      last_handled_ts=$(echo "$handled" | tail -1 | cut -d' ' -f1 | cut -d'T' -f2)
      newer_limit=$(grep "^${today}T" "$BOARD" 2>/dev/null | grep ' ::  \[mind-limited\]' | grep "${worker}" | while IFS= read -r l; do
        lts=$(echo "$l" | cut -d' ' -f1 | cut -d'T' -f2)
        [ "$lts" \> "$last_handled_ts" ] 2>/dev/null && echo "$l"
      done)
      [ -z "$newer_limit" ] && continue
    fi
    handle_one "$worker" || true
  done
  exit 0
fi

# --------------------------------------------------------------------
# --scan-dead: find workers whose mind process DIED (DEAD state) with
# open [taking] claims and re-dispatch their tasks.
# --------------------------------------------------------------------
if [ "${1:-}" = "--scan-dead" ]; then
  today="$(date -u +%Y-%m-%d)"
  HOST="$(hostname)"
  workers=$(grep "^${today}T" "$BOARD" 2>/dev/null | grep ' ::  \[taking\]' | grep -oP '\[taking\] \K[^ ]+' | sort -u || true)
  for worker in $workers; do
    whost="${worker%%:*}"; wwin="${worker#*:}"
    [ "$whost" != "$HOST" ] && [ "$whost" != "local" ] && continue
    state=$(mesh-mind-state "$wwin" 2>/dev/null | head -1 | cut -f1)
    [ "$state" != "DEAD" ] && continue
    grep "^${today}T" "$BOARD" 2>/dev/null | grep "\[failover-dispatched\].*${worker}.*DEAD" >/dev/null 2>&1 && continue
    handle_dead_one "$worker" || true
  done
  exit 0
fi

# --------------------------------------------------------------------
# Default: print usage
# --------------------------------------------------------------------
cat <<'EOF'
mesh-failover — recover agentic tasks stranded on rate-limited workers

  mesh-failover --test            smoke test (dependencies + board readable)
  mesh-failover --handle HOST:WIN recover stranded tasks for one worker
  mesh-failover --scan            scan chat.log for unhandled [mind-limited] → re-dispatch
  mesh-failover --scan-dead       scan for DEAD workers (process died) with open [taking] → re-dispatch

Wire-up (add to reflexes.cron):
  */2 * * * * mesh-failover --scan >> $HOME/.mesh/failover.log 2>&1
  */5 * * * * mesh-failover --scan-dead >> $HOME/.mesh/failover.log 2>&1
EOF
exit 1
