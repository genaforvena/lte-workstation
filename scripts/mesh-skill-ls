#!/usr/bin/env bash
# mesh-skill-ls — list all skill cards with verification age (ASPIRE rot detection).
# Shows slug, verification date, age in days, and symptom summary.
# Usage: mesh-skill-ls [--stale-only] [--json]
# reflex-cadence: none (on-demand auditing tool)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

SKILLS_DIR="$HOME/.mesh/knowledge/skills"
MAX_DAYS="${MESH_SKILL_MAX_DAYS:-30}"  # Floor-gate window

stale_only=false
json_output=false

while [ $# -gt 0 ]; do
  case "$1" in
    --stale-only) stale_only=true ;;
    --json) json_output=true ;;
    *) echo "Unknown option: $1"; exit 1 ;;
  esac
  shift
done

if [ ! -d "$SKILLS_DIR" ]; then
  [ "$json_output" = true ] && echo "[]" || echo "No skills directory found: $SKILLS_DIR"
  exit 0
fi

skill_cards=("$SKILLS_DIR"/*.md)
if [ ${#skill_cards[@]} -eq 0 ] || [ ! -f "${skill_cards[0]}" ]; then
  [ "$json_output" = true ] && echo "[]" || echo "No skill cards found"
  exit 0
fi

now=$(date +%s)

if [ "$json_output" = true ]; then
  echo "["
  first=true
else
  printf "%-40s %-12s %-6s %s\n" "SLUG" "VERIFIED" "AGE" "SYMPTOM"
  printf "%-40s %-12s %-6s %s\n" "--------" "-------" "---" "------"
fi

for skill_file in "${skill_cards[@]}"; do
  [ -f "$skill_file" ] || continue

  # Extract fields
  slug=$(grep "^slug:" "$skill_file" | head -1 | sed 's/slug: //;s/^[[:space:]]*//;s/[[:space:]]*$//')
  verified=$(grep "^verified:" "$skill_file" | head -1 | sed 's/verified: //;s/^[[:space:]]*//;s/[[:space:]]*$//')
  symptom=$(awk '/^## Symptom/{f=1;next} f && /^## /{exit} f && NF{print;exit}' "$skill_file" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')

  # Calculate age
  if [ -n "$verified" ]; then
    verified_ts=$(date -d "$verified" +%s 2>/dev/null || echo 0)
    age_days=$(( (now - verified_ts) / 86400 ))
  else
    age_days="?"
  fi

  # Skip if stale-only filter and this skill is fresh
  if [ "$stale_only" = true ] && [ "$age_days" != "?" ] && [ "$age_days" -lt "$MAX_DAYS" ]; then
    continue
  fi

  # Format symptom (truncate if too long)
  symptom_short=$(echo "$symptom" | cut -c1-60)

  if [ "$json_output" = true ]; then
    [ "$first" = false ] && echo ","
    first=false
    echo "  {"
    echo "    \"slug\": \"$slug\","
    echo "    \"verified\": \"$verified\","
    echo "    \"age_days\": $age_days,"
    echo "    \"symptom\": \"$symptom_short\","
    echo "    \"file\": \"$skill_file\""
    echo -n "  }"
  else
    printf "%-40s %-12s %-6s %s\n" "$slug" "$verified" "${age_days}d" "$symptom_short"
  fi
done

if [ "$json_output" = true ]; then
  echo ""
  echo "]"
else
  echo ""
  echo "Total: $(ls "$SKILLS_DIR"/*.md 2>/dev/null | wc -l) skill cards"
  echo "Floor-gate window: ${MAX_DAYS} days"
fi