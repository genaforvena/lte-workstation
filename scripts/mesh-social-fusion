#!/usr/bin/env bash
# mesh-social-fusion — 4-sense fusion: ambient-level + BLE presence + activity + social-context
# Answers: is this a social moment right now?
#
# Usage:
#   mesh-social-fusion            one-shot verdict to stdout
#   mesh-social-fusion --edge     only emit on state change (for cron wiring)
#   mesh-social-fusion --json     machine-readable JSON
#   mesh-social-fusion --test     smoke test
#
# Signals (read from state files — zero subprocesses):
#   ambient-level:    SILENCE/QUIET/MODERATE/LOUD (IdeaPad mic)
#   presence-state:   count=N strongest=name(rssi) types=... (BLE inventory)
#   activity.state:   IDLE/AMBIANT/MODERATE/ACTIVE/UNCERTAIN (3-sense fusion)
#   social-context.state: SOLO-LEISURE/SOLO-WORK/FAMILY-TIME/etc (phone fusion)
#
# Fusion — 5-level social temperature:
#   SOLO_QUIET    = 1 device + quiet/silent + idle (nobody here or alone and still)
#   SOLO_FOCUSED  = 1 device + moderate+ sound + idle (alone, working/reading)
#   SOCIAL_ACTIVE = ≥2 devices + moderate/loud sound (multiple people, interaction)
#   SOCIAL_PASSIVE = ≥2 devices + quiet/silent (people present but not interacting)
#   UNCERTAIN     = signals conflict or unreachable
#
# UNREACHABLE ≠ SOLO_QUIET: missing signals render UNCERTAIN, never silent all-clear.
#
# Exit codes:
#   0 = verdict assessed (may be UNCERTAIN)
#   2 = cannot assess (all signals unreachable)

set -euo pipefail

STATE_DIR="${MESH_STATE_DIR:-$HOME/.mesh}"
STATE="$STATE_DIR/.social-fusion.state"
PENDING="$STATE_DIR/.social-fusion.pending"
MODE="oneshot"
EDGE_WINDOW=2

for arg in "$@"; do
  case "$arg" in
    --edge) MODE=edge ;;
    --json) MODE=json ;;
    --test) MODE=test ;;
  esac
done

mkdir -p "$STATE_DIR"

TS=$(date -u '+%Y-%m-%dT%H:%M:%SZ')

# --- Read signals from state files (zero subprocesses) ---
_read_state() {
  local f="$STATE_DIR/$1"
  [ -f "$f" ] && head -1 "$f" || echo "UNKNOWN"
}

# Ambient level
ambient="$(_read_state .ambient-level)"
case "$ambient" in SILENCE|QUIET|MODERATE|LOUD) ;; *) ambient="UNKNOWN" ;; esac

# BLE device count (from enriched mesh-presence state)
device_count=0
dev_str="$(_read_state .presence-state)"
if [ -n "$dev_str" ] && [ "$dev_str" != "UNKNOWN" ]; then
  device_count="$(printf '%s' "$dev_str" | grep -oE 'count=[0-9]+' | cut -d= -f2)"
  : "${device_count:=0}"
fi

# Activity level
activity="$(_read_state .activity.state)"
case "$activity" in IDLE|AMBIENT|MODERATE|ACTIVE|UNCERTAIN) ;; *) activity="UNKNOWN" ;; esac

# Social context (from phone-based fusion)
social_ctx="$(_read_state .social-context.state)"
case "$social_ctx" in SOLO-LEISURE|SOLO-WORK|FAMILY-TIME|SOCIAL-ONLINE|TRANSITION|DEGRADED|UNCERTAIN) ;; *) social_ctx="UNKNOWN" ;; esac

# --- Fusion engine ---
_fuse() {
  local am="$1" dc="$2" ac="$3" sc="$4"

  # All unreachable → cannot assess
  if [ "$am" = "UNKNOWN" ] && [ "$dc" = "0" ] && [ "$ac" = "UNKNOWN" ] && [ "$sc" = "UNKNOWN" ]; then
    verdict="UNCERTAIN"; reason="all signals unreachable"; return 2
  fi

  # SOCIAL_ACTIVE: multiple devices + sound activity
  if [ "$dc" -ge 2 ] 2>/dev/null; then
    if [ "$am" = "MODERATE" ] || [ "$am" = "LOUD" ] || [ "$ac" = "MODERATE" ] || [ "$ac" = "ACTIVE" ]; then
      verdict="SOCIAL_ACTIVE"; reason="${dc} devices + ambient $am / activity $ac"
      return 0
    fi
    # Multiple devices but quiet → passive social
    verdict="SOCIAL_PASSIVE"; reason="${dc} devices + ambient $am (quiet co-presence)"
    return 0
  fi

  # Single device or none
  if [ "$dc" -le 1 ] 2>/dev/null; then
    if [ "$am" = "MODERATE" ] || [ "$am" = "LOUD" ] || [ "$ac" = "MODERATE" ] || [ "$ac" = "ACTIVE" ]; then
      verdict="SOLO_FOCUSED"; reason="1 device + ambient $am / activity $ac (alone, active)"
      return 0
    fi
    verdict="SOLO_QUIET"; reason="${dc} device(s) + ambient $am (alone, still)"
    return 0
  fi

  # Fallback
  verdict="UNCERTAIN"; reason="mixed: ambient=$am devices=$dc activity=$ac social=$sc"
  return 0
}

# --- Test mode ---
if [ "$MODE" = "test" ]; then
  (
    set +e
    # Case 1: 1 device + quiet + idle → SOLO_QUIET
    _fuse 'QUIET' 1 'IDLE' 'SOLO-LEISURE'
    [ "$verdict" = "SOLO_QUIET" ] || { echo "  FAIL: quiet+1device → SOLO_QUIET (got $verdict)"; exit 1; }
    # Case 2: 1 device + moderate + idle → SOLO_FOCUSED
    _fuse 'MODERATE' 1 'IDLE' 'SOLO-WORK'
    [ "$verdict" = "SOLO_FOCUSED" ] || { echo "  FAIL: moderate+1device → SOLO_FOCUSED (got $verdict)"; exit 1; }
    # Case 3: 3 devices + loud → SOCIAL_ACTIVE
    _fuse 'LOUD' 3 'ACTIVE' 'FAMILY-TIME'
    [ "$verdict" = "SOCIAL_ACTIVE" ] || { echo "  FAIL: loud+3devices → SOCIAL_ACTIVE (got $verdict)"; exit 1; }
    # Case 4: 2 devices + silence → SOCIAL_PASSIVE
    _fuse 'SILENCE' 2 'IDLE' 'FAMILY-TIME'
    [ "$verdict" = "SOCIAL_PASSIVE" ] || { echo "  FAIL: silence+2devices → SOCIAL_PASSIVE (got $verdict)"; exit 1; }
    # Case 5: all unknown + 0 devices → UNCERTAIN (exit 2)
    _fuse 'UNKNOWN' 0 'UNKNOWN' 'UNKNOWN'; rc=$?
    [ "$verdict" = "UNCERTAIN" ] || { echo "  FAIL: all-unknown → UNCERTAIN (got $verdict)"; exit 1; }
    [ "$rc" = "2" ] || { echo "  FAIL: all-unknown → exit 2 (got $rc)"; exit 1; }
    # Case 6: 0 devices + moderate → SOLO_FOCUSED (ambient proves presence)
    _fuse 'MODERATE' 0 'MODERATE' 'UNKNOWN'
    [ "$verdict" = "SOLO_FOCUSED" ] || { echo "  FAIL: moderate+0devices → SOLO_FOCUSED (got $verdict)"; exit 1; }
    echo "smoke-test: ok (6 assertions: quiet+1→SOLO_QUIET, moderate+1→SOLO_FOCUSED, loud+3→SOCIAL_ACTIVE, silence+2→SOCIAL_PASSIVE, all-unknown→UNCERTAIN/exit2, moderate+0→SOLO_FOCUSED)"
  )
  exit $?
fi

_fuse "$ambient" "$device_count" "$activity" "$social_ctx"
ec=$?

# --- Edge mode ---
if [ "$MODE" = "edge" ]; then
  confirmed=""
  [ -f "$STATE" ] && confirmed="$(head -1 "$STATE")"
  pending=""; pcount=0
  [ -f "$PENDING" ] && { pending="$(head -1 "$PENDING" | cut -d: -f1)"; pcount="$(head -1 "$PENDING" | cut -d: -f2)"; }

  if [ "$verdict" = "$confirmed" ]; then
    :
  elif [ "$verdict" = "$pending" ]; then
    pcount=$((pcount + 1))
    echo "${pending}:${pcount}" > "$PENDING"
    if [ "$pcount" -ge "$EDGE_WINDOW" ]; then
      echo "$verdict" > "$STATE"
      rm -f "$PENDING"
      echo "[social-fusion] $verdict — $reason"
    fi
  else
    echo "${verdict}:1" > "$PENDING"
  fi
fi

# --- Output ---
case "$MODE" in
  oneshot|edge)
    printf 'social-fusion: %s — %s [ambient=%s devices=%s activity=%s social=%s]\n' \
      "$verdict" "$reason" "$ambient" "$device_count" "$activity" "$social_ctx"
    ;;
  json)
    printf '{"verdict":"%s","reason":"%s","ambient":"%s","devices":%d,"activity":"%s","social":"%s","ts":"%s"}\n' \
      "$verdict" "$reason" "$ambient" "$device_count" "$activity" "$social_ctx" "$TS"
    ;;
esac

exit ${ec:-0}
