#!/usr/bin/env bash
# orphan-ok: on-demand cached fusion; its --edge mode is manually invoked, never independently scheduled
# mesh-social-fusion — 4-sense fusion: ambient-level + BLE presence + activity + social-context
# Answers: is this a social moment right now?
#
# Usage:
#   mesh-social-fusion            one-shot verdict to stdout
#   mesh-social-fusion --edge     only emit on state change (for cron wiring)
#   mesh-social-fusion --json     machine-readable JSON
#   mesh-social-fusion --test     smoke test
#
# Signals (read from state files — zero subprocesses):
#   ambient-level:    SILENCE/QUIET/MODERATE/LOUD (IdeaPad mic)
#   presence-state:   count=N strongest=name(rssi) types=... (BLE inventory)
#   activity.state:   IDLE/AMBIANT/MODERATE/ACTIVE/UNCERTAIN (3-sense fusion)
#   social-context.state: SOLO-LEISURE/SOLO-WORK/FAMILY-TIME/etc (phone fusion)
#
# Fusion — 5-level social temperature plus joint relations:
#   SOLO_QUIET    = 1 device + quiet/silent + idle (nobody here or alone and still)
#   SOLO_FOCUSED  = 1 device + moderate+ sound + idle (alone, working/reading)
#   SOCIAL_ACTIVE = ≥2 devices + moderate/loud sound (multiple people, interaction)
#   SOCIAL_PASSIVE = ≥2 devices + quiet/silent (people present but not interacting)
#   UNCERTAIN     = signals conflict or unreachable
#
# UNREACHABLE ≠ EMPTY: each axis carries LIVE/UNREACHABLE/STALE/HOLLOW.  In particular,
# a missing BLE census is never coerced to count=0, so no silent SOLO_QUIET can be minted.
# The relation field is deliberately separate from the temperature label: CO_PRESENT_ACTIVE needs
# three load-bearing axes live and jointly showing co-presence plus activity; SOCIAL_GATHERING adds
# the independent social-context axis. No one input can produce either relation by itself.
#
# Exit codes:
#   0 = verdict assessed (may be UNCERTAIN)
#   2 = cannot assess (all signals unreachable)

set -euo pipefail

STATE_DIR="${MESH_STATE_DIR:-$HOME/.mesh}"
STATE="$STATE_DIR/.social-fusion.state"
PENDING="$STATE_DIR/.social-fusion.pending"
AXIS_MAX_AGE="${MESH_SOCIAL_FUSION_AXIS_MAX_AGE:-900}"
MODE="oneshot"
EDGE_WINDOW=2

for arg in "$@"; do
  case "$arg" in
    --edge) MODE=edge ;;
    --json) MODE=json ;;
    --test) MODE=test ;;
  esac
done

mkdir -p "$STATE_DIR"

TS=$(date -u '+%Y-%m-%dT%H:%M:%SZ')

# --- Read cached axes, preserving the difference between empty and unavailable. ---
# A state-file mtime is its producer heartbeat (not the reading time).  A present but malformed
# file is HOLLOW: cron may be green, but this consumer received no usable observation.
read_axis() {
  local name="$1" allowed="$2" f raw mtime now age
  f="$STATE_DIR/$name"
  AXIS_VALUE="UNKNOWN"; AXIS_STATUS="UNREACHABLE"
  [ -f "$f" ] || return 0
  mtime="$(stat -c %Y "$f" 2>/dev/null || printf 0)"
  now="$(date +%s)"
  age=$((now - mtime))
  if [ "$mtime" -le 0 ] 2>/dev/null || [ "$age" -gt "$AXIS_MAX_AGE" ] 2>/dev/null; then
    AXIS_STATUS="STALE"; return
  fi
  raw="$(head -1 "$f" 2>/dev/null | cut -d'|' -f1)"
  if printf '%s\n' "$raw" | grep -Eq "$allowed"; then
    AXIS_VALUE="$raw"; AXIS_STATUS="LIVE"
  else
    AXIS_STATUS="HOLLOW"
  fi
}

# Ambient level
read_axis .ambient-level '^(SILENCE|QUIET|MODERATE|LOUD)$'
ambient="$AXIS_VALUE"; ambient_status="$AXIS_STATUS"

# BLE device count (from enriched mesh-presence state)
read_axis .presence-state '^.*count=[0-9]+.*$'
dev_str="$AXIS_VALUE"; presence_status="$AXIS_STATUS"; device_count="UNKNOWN"
if [ "$presence_status" = "LIVE" ]; then
  device_count="$(printf '%s' "$dev_str" | grep -oE 'count=[0-9]+' | cut -d= -f2)"
  [ -n "$device_count" ] || { device_count="UNKNOWN"; presence_status="HOLLOW"; }
fi

# Activity level
read_axis .activity.state '^(IDLE|AMBIENT|MODERATE|ACTIVE|UNCERTAIN)$'
activity="$AXIS_VALUE"; activity_status="$AXIS_STATUS"

# Social context (from phone-based fusion)
read_axis .social-context.state '^(SOLO-LEISURE|SOLO-WORK|FAMILY-TIME|SOCIAL-ONLINE|TRANSITION|DEGRADED|UNCERTAIN)$'
social_ctx="$AXIS_VALUE"; social_status="$AXIS_STATUS"

# --- Fusion engine ---
_fuse() {
  local am="$1" dc="$2" ac="$3" sc="$4" ps="${5:-LIVE}"

  # All unreachable → cannot assess
  # A real empty BLE census is dc=0 with ps=LIVE; it is evidence and must not enter this arm.
  if [ "$am" = "UNKNOWN" ] && [ "$ps" != "LIVE" ] && [ "$ac" = "UNKNOWN" ] && [ "$sc" = "UNKNOWN" ]; then
    verdict="UNCERTAIN"; reason="all signals unreachable [unreachable:ambient,presence,activity,social]"; return 2
  fi

  # SOCIAL_ACTIVE: multiple devices + sound activity
  if [ "$dc" -ge 2 ] 2>/dev/null; then
    if [ "$am" = "MODERATE" ] || [ "$am" = "LOUD" ] || [ "$ac" = "MODERATE" ] || [ "$ac" = "ACTIVE" ]; then
      verdict="SOCIAL_ACTIVE"; reason="${dc} devices + ambient $am / activity $ac"
      return 0
    fi
    # Multiple devices but quiet → passive social
    verdict="SOCIAL_PASSIVE"; reason="${dc} devices + ambient $am (quiet co-presence)"
    return 0
  fi

  # Single device or none
  if [ "$dc" -le 1 ] 2>/dev/null; then
    if [ "$am" = "MODERATE" ] || [ "$am" = "LOUD" ] || [ "$ac" = "MODERATE" ] || [ "$ac" = "ACTIVE" ]; then
      verdict="SOLO_FOCUSED"; reason="1 device + ambient $am / activity $ac (alone, active)"
      return 0
    fi
    verdict="SOLO_QUIET"; reason="${dc} device(s) + ambient $am (alone, still)"
    return 0
  fi

  # Fallback
  verdict="UNCERTAIN"; reason="mixed: ambient=$am devices=$dc activity=$ac social=$sc"
  return 0
}

# A joint pattern, not a max/worst-of fold. Coverage is the overlap of the required axes.
joint_relation() {
  local am="$1" dc="$2" ac="$3" ams="$4" ps="$5" as="$6" sc="${7:-UNKNOWN}" ss="${8:-UNREACHABLE}"
  relation="UNKNOWN"; coverage="0/3"; social_relation="UNKNOWN"; social_coverage="0/4"
  if [ "$ams" = "LIVE" ] && [ "$ps" = "LIVE" ] && [ "$as" = "LIVE" ]; then
    coverage="3/3"
    if [ "$dc" -ge 2 ] 2>/dev/null && \
       { [ "$am" = "MODERATE" ] || [ "$am" = "LOUD" ]; } && \
       { [ "$ac" = "MODERATE" ] || [ "$ac" = "ACTIVE" ]; }; then
      relation="CO_PRESENT_ACTIVE"
    else
      relation="NO_JOINT_PATTERN"
    fi
  fi
  if [ "$ams" = "LIVE" ] && [ "$ps" = "LIVE" ] && [ "$as" = "LIVE" ] && [ "$ss" = "LIVE" ]; then
    social_coverage="4/4"
    if [ "$relation" = "CO_PRESENT_ACTIVE" ] && \
       { [ "$sc" = "FAMILY-TIME" ] || [ "$sc" = "SOCIAL-ONLINE" ]; }; then
      social_relation="SOCIAL_GATHERING"
      relation="$social_relation"
      coverage="$social_coverage"
    else
      social_relation="NO_SOCIAL_GATHERING"
    fi
  fi
}
joint_relation "$ambient" "$device_count" "$activity" "$ambient_status" "$presence_status" "$activity_status" "$social_ctx" "$social_status"

# Occupancy is a separate three-axis relation, not a worst-of fold.  A device count alone can be
# an unattended appliance, while sound/activity alone can be a machine; require the overlap so no
# single input can mint a room state.  A live but non-matching tuple is UNRESOLVED, not EMPTY.
occupancy="UNKNOWN"; occupancy_coverage="0/3"; occupancy_reason="unavailable axis: ambient=$ambient_status presence=$presence_status activity=$activity_status"
if [ "$ambient_status" = "LIVE" ] && [ "$presence_status" = "LIVE" ] && [ "$activity_status" = "LIVE" ]; then
  occupancy_coverage="3/3"
  if [ "$device_count" -ge 1 ] 2>/dev/null && \
     { [ "$ambient" = "MODERATE" ] || [ "$ambient" = "LOUD" ]; } && \
     { [ "$activity" = "MODERATE" ] || [ "$activity" = "ACTIVE" ]; }; then
    occupancy="OCCUPIED"
    occupancy_reason="presence=$device_count + ambient=$ambient + activity=$activity"
  elif [ "$device_count" = "0" ] && \
       { [ "$ambient" = "SILENCE" ] || [ "$ambient" = "QUIET" ]; } && \
       [ "$activity" = "IDLE" ]; then
    occupancy="EMPTY"
    occupancy_reason="presence=0 + ambient=$ambient + activity=IDLE"
  else
    occupancy="UNRESOLVED"
    occupancy_reason="live axes disagree: presence=$device_count ambient=$ambient activity=$activity"
  fi
fi

# Operator state is a separate relation across heterogeneous axes: BLE presence, room activity,
# and phone-derived social context.  No one axis can mint it, and the denominator is the live
# overlap of exactly these three inputs.
operator_state="UNKNOWN"; operator_coverage="0/3"; operator_reason="unavailable axis: presence=$presence_status activity=$activity_status social=$social_status"
if [ "$presence_status" = "LIVE" ] && [ "$activity_status" = "LIVE" ] && [ "$social_status" = "LIVE" ]; then
  operator_coverage="3/3"
  if [ "$device_count" -ge 2 ] 2>/dev/null && [ "$activity" = "ACTIVE" ] && \
     { [ "$social_ctx" = "FAMILY-TIME" ] || [ "$social_ctx" = "SOCIAL-ONLINE" ]; }; then
    operator_state="SOCIAL_ENGAGED"
    operator_reason="presence=$device_count + activity=$activity + social=$social_ctx"
  elif [ "$device_count" -ge 1 ] 2>/dev/null && \
       { [ "$activity" = "MODERATE" ] || [ "$activity" = "ACTIVE" ]; } && \
       [ "$social_ctx" = "SOLO-WORK" ]; then
    operator_state="SOLO_ACTIVE"
    operator_reason="presence=$device_count + activity=$activity + social=$social_ctx"
  elif [ "$device_count" -ge 1 ] 2>/dev/null && [ "$activity" = "IDLE" ] && [ "$social_ctx" = "SOLO-LEISURE" ]; then
    operator_state="SOLO_QUIET"
    operator_reason="presence=$device_count + activity=IDLE + social=SOLO-LEISURE"
  else
    operator_state="UNRESOLVED"
    operator_reason="live axes disagree: presence=$device_count activity=$activity social=$social_ctx"
  fi
fi

# The verdict needs the three load-bearing observations.  Context is retained as a visible,
# optional corroborator; it does not turn a genuine empty BLE scan into an unavailable one.
if [ "$ambient_status" != "LIVE" ] || [ "$presence_status" != "LIVE" ] || [ "$activity_status" != "LIVE" ]; then
  verdict="UNCERTAIN"
  reason="unavailable axis: ambient=$ambient_status presence=$presence_status activity=$activity_status"
  ec=2
else
  _fuse "$ambient" "$device_count" "$activity" "$social_ctx" "$presence_status"; ec=$?
fi

# --- Test mode ---
if [ "$MODE" = "test" ]; then
  (
    set +e
    # Case 1: 1 device + quiet + idle → SOLO_QUIET
    _fuse 'QUIET' 1 'IDLE' 'SOLO-LEISURE'
    [ "$verdict" = "SOLO_QUIET" ] || { echo "  FAIL: quiet+1device → SOLO_QUIET (got $verdict)"; exit 1; }
    # Case 2: 1 device + moderate + idle → SOLO_FOCUSED
    _fuse 'MODERATE' 1 'IDLE' 'SOLO-WORK'
    [ "$verdict" = "SOLO_FOCUSED" ] || { echo "  FAIL: moderate+1device → SOLO_FOCUSED (got $verdict)"; exit 1; }
    # Case 3: 3 devices + loud → SOCIAL_ACTIVE
    _fuse 'LOUD' 3 'ACTIVE' 'FAMILY-TIME'
    [ "$verdict" = "SOCIAL_ACTIVE" ] || { echo "  FAIL: loud+3devices → SOCIAL_ACTIVE (got $verdict)"; exit 1; }
    # Case 4: 2 devices + silence → SOCIAL_PASSIVE
    _fuse 'SILENCE' 2 'IDLE' 'FAMILY-TIME'
    [ "$verdict" = "SOCIAL_PASSIVE" ] || { echo "  FAIL: silence+2devices → SOCIAL_PASSIVE (got $verdict)"; exit 1; }
    # Case 5: all unknown + 0 devices → UNCERTAIN (exit 2)
    _fuse 'UNKNOWN' 0 'UNKNOWN' 'UNKNOWN' 'UNREACHABLE'; rc=$?
    [ "$verdict" = "UNCERTAIN" ] || { echo "  FAIL: all-unknown → UNCERTAIN (got $verdict)"; exit 1; }
    [ "$rc" = "2" ] || { echo "  FAIL: all-unknown → exit 2 (got $rc)"; exit 1; }
    _fuse 'QUIET' 0 'IDLE' 'SOLO-LEISURE' 'LIVE'
    [ "$verdict" = "SOLO_QUIET" ] || { echo "  FAIL: live empty presence → SOLO_QUIET (got $verdict)"; exit 1; }
    # Case 6: 0 devices + moderate → SOLO_FOCUSED (ambient proves presence)
    _fuse 'MODERATE' 0 'MODERATE' 'UNKNOWN'
    [ "$verdict" = "SOLO_FOCUSED" ] || { echo "  FAIL: moderate+0devices → SOLO_FOCUSED (got $verdict)"; exit 1; }
    joint_relation MODERATE 3 ACTIVE LIVE LIVE LIVE
    [ "$relation" = "CO_PRESENT_ACTIVE" ] && [ "$coverage" = "3/3" ] || { echo "  FAIL: live multi-axis joint pattern/coverage (relation=$relation coverage=$coverage)"; exit 1; }
    joint_relation MODERATE 3 ACTIVE LIVE LIVE LIVE FAMILY-TIME LIVE
    [ "$relation" = "SOCIAL_GATHERING" ] && [ "$coverage" = "4/4" ] && [ "$social_relation" = "SOCIAL_GATHERING" ] || { echo "  FAIL: four-axis social gathering relation/coverage (relation=$relation coverage=$coverage)"; exit 1; }
    joint_relation MODERATE 3 ACTIVE LIVE UNREACHABLE LIVE
    [ "$relation" = "UNKNOWN" ] && [ "$coverage" = "0/3" ] || { echo "  FAIL: unreachable presence must suppress joint relation (relation=$relation coverage=$coverage)"; exit 1; }
    # Cross-sense operator state: presence × activity × social context.
    presence_status=LIVE; activity_status=LIVE; social_status=LIVE; device_count=3; activity=ACTIVE; social_ctx=FAMILY-TIME
    operator_state="UNKNOWN"; operator_coverage="0/3"
    if [ "$presence_status" = LIVE ] && [ "$activity_status" = LIVE ] && [ "$social_status" = LIVE ]; then
      operator_coverage=3/3
      if [ "$device_count" -ge 2 ] && [ "$activity" = ACTIVE ] && { [ "$social_ctx" = FAMILY-TIME ] || [ "$social_ctx" = SOCIAL-ONLINE ]; }; then
        operator_state=SOCIAL_ENGAGED
      fi
    fi
    [ "$operator_state" = SOCIAL_ENGAGED ] && [ "$operator_coverage" = 3/3 ] || { echo "  FAIL: live operator tuple (state=$operator_state coverage=$operator_coverage)"; exit 1; }
    social_status=UNREACHABLE; operator_state=UNKNOWN; operator_coverage=0/3
    [ "$operator_state" != SOCIAL_ENGAGED ] && [ "$operator_coverage" = 0/3 ] || { echo "  FAIL: unreachable social context must suppress operator state"; exit 1; }
    echo "smoke-test: ok (6 assertions + joint relation/coverage contract)"
  )
  exit $?
fi

# --- Edge mode ---
if [ "$MODE" = "edge" ]; then
  confirmed=""
  [ -f "$STATE" ] && confirmed="$(head -1 "$STATE")"
  pending=""; pcount=0
  [ -f "$PENDING" ] && { pending="$(head -1 "$PENDING" | cut -d: -f1)"; pcount="$(head -1 "$PENDING" | cut -d: -f2)"; }

  if [ "$verdict" = "$confirmed" ]; then
    :
  elif [ "$verdict" = "$pending" ]; then
    pcount=$((pcount + 1))
    echo "${pending}:${pcount}" > "$PENDING"
    if [ "$pcount" -ge "$EDGE_WINDOW" ]; then
      echo "$verdict" > "$STATE"
      rm -f "$PENDING"
      echo "[social-fusion] $verdict — $reason"
    fi
  else
    echo "${verdict}:1" > "$PENDING"
  fi
  # A stable confirmed value is still a live evaluation.  Never make it decay into a false stale.
  [ -e "$STATE" ] && mesh-state-touch "$STATE"
fi

# --- Output ---
case "$MODE" in
  oneshot|edge)
    printf 'social-fusion: %s — %s [relation=%s coverage=%s social_relation=%s social_coverage=%s occupancy=%s occupancy_coverage=%s occupancy_reason=%s operator_state=%s operator_coverage=%s operator_reason=%s ambient=%s/%s presence=%s/devices=%s activity=%s/%s social=%s/%s]\n' \
      "$verdict" "$reason" "$relation" "$coverage" "$social_relation" "$social_coverage" "$occupancy" "$occupancy_coverage" "$occupancy_reason" "$operator_state" "$operator_coverage" "$operator_reason" "$ambient_status" "$ambient" "$presence_status" "$device_count" "$activity_status" "$activity" "$social_status" "$social_ctx"
    ;;
  json)
    printf '{"verdict":"%s","reason":"%s","relation":"%s","coverage":"%s","social_relation":"%s","social_coverage":"%s","occupancy":"%s","occupancy_coverage":"%s","occupancy_reason":"%s","operator_state":"%s","operator_coverage":"%s","operator_reason":"%s","ambient":"%s","ambient_status":"%s","presence":"%s","devices":"%s","activity":"%s","activity_status":"%s","social":"%s","social_status":"%s","ts":"%s"}\n' \
      "$verdict" "$reason" "$relation" "$coverage" "$social_relation" "$social_coverage" "$occupancy" "$occupancy_coverage" "$occupancy_reason" "$operator_state" "$operator_coverage" "$operator_reason" "$ambient" "$ambient_status" "$presence_status" "$device_count" "$activity" "$activity_status" "$social_ctx" "$social_status" "$TS"
    ;;
esac

exit ${ec:-0}
