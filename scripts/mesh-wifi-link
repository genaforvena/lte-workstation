#!/usr/bin/env bash
# reflex-cadence: 2-59/5 * * * *
# reflex-args: --edge
# mesh-wifi-link — WiFi LINK QUALITY sense: how good is the phone's WiFi connection?
# Reads termux-wifi-connectioninfo (link speed, RSSI, frequency) to assess the
# RF environment. No single sensor gives this — it reflects physical-layer quality
# that WiFi scans miss (interference, distance, room absorption by people).
#
# Why it matters:
#   - Link speed drops when people enter a room (bodies absorb 2.4GHz)
#   - RSSI degradation without AP change = interference or obstacle
#   - Frequency band (2.4 vs 5GHz) indicates distance/preference
#   - A failing WiFi adapter shows degrading link speed before disconnect
#
# Usage:
#   mesh-wifi-link           one-shot quality verdict to stdout
#   mesh-wifi-link --edge    emit only on quality class change (2-consecutive debounce)
#   mesh-wifi-link --json    machine-readable JSON
#   mesh-wifi-link --test    smoke test (no phone call)
#
# Signals:
#   link_speed_mbps:  current PHY link rate (from termux-wifi-connectioninfo)
#   rssi:             received signal strength in dBm
#   frequency_mhz:    2400 or 5000 band
#   supplicant_state: COMPLETED = connected, other = transient/disconnected
#
# Classification:
#   EXCELLENT  = link_speed >= 200 Mbps AND rssi >= -50
#   GOOD       = link_speed >= 72 Mbps AND rssi >= -65
#   FAIR       = link_speed >= 24 Mbps AND rssi >= -75
#   POOR       = link_speed < 24 Mbps OR rssi < -75
#   DISCONNECTED = supplicant_state != COMPLETED
#
# Exit codes (honest-exit contract):
#   0 = quality assessed
#   2 = phone unreachable — cannot assess, never faked
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes"

STATE="$HOME/.mesh/.wifi-link.state"
OFFLINEFILE="$HOME/.mesh/.wifi-link-offline"

# RETRY-SAMPLED read (uses the already-resolved $pip). termux-wifi-connectioninfo returns {} / all-
# null on a COLD or screen-gated call — ~95% of single cron calls came back empty while a warm/repeated
# call succeeds (the mesh-mag/mesh-gyro `-n 2` driver-race class: a reachable phone whose driver returns
# empty is a HOLLOW sense — cron-green while the artifact goes stale). Resample up to WIFI_LINK_TRIES so
# one racing empty can't blank a LIVE link; a REAL read is one carrying a numeric link_speed OR rssi.
# Echoes the JSON on stdout; rc 0 = real read, rc 1 = empty/gated after all tries (never faked).
read_conninfo() {
  local i out=""
  for i in $(seq 1 "${WIFI_LINK_TRIES:-3}"); do
    out="$(timeout 10 ssh -p "${PHONE_SSH_PORT:-8022}" -o BatchMode=yes -o ConnectTimeout=5 \
      -o StrictHostKeyChecking=accept-new "${PHONE_USER:-u0_a380}@$pip" \
      'termux-wifi-connectioninfo' </dev/null 2>/dev/null)"
    if printf '%s' "$out" | grep -qE '"(link_speed_mbps|rssi)"[[:space:]]*:[[:space:]]*-?[0-9]+'; then
      printf '%s' "$out"; return 0
    fi
    [ "$i" -lt "${WIFI_LINK_TRIES:-3}" ] && sleep "${WIFI_LINK_RETRY_GAP:-1.2}"
  done
  printf '%s' "$out"; return 1   # last (empty/gated) result — caller decides honest exit 2
}

if [ "${1:-}" = --test ]; then
  command -v mesh-phone-ip >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-phone-ip)"; exit 1; }
  mkdir -p "$HOME/.mesh" 2>/dev/null || { echo "smoke-test: FAIL (no $HOME/.mesh)"; exit 1; }
  pip="$(mesh-phone-ip 2>/dev/null)" || { echo "smoke-test: n/a (phone unreachable)"; exit 2; }
  if ! timeout 8 ssh -p "${PHONE_SSH_PORT:-8022}" -o BatchMode=yes -o ConnectTimeout=5 \
       -o StrictHostKeyChecking=accept-new "${PHONE_USER:-u0_a380}@$pip" \
       'command -v termux-wifi-connectioninfo' </dev/null >/dev/null 2>&1; then
    echo "smoke-test: n/a (phone unreachable or no termux-wifi-connectioninfo)"; exit 2
  fi
  # REAL-READ GATE (doctrine: --test must assert a live read PRODUCES data, not just that the command
  # exists — that hollow gap is exactly why this sense was cron-green while ~95% empty). Honest contract:
  # real numeric fields => ok(0); reachable-but-empty-after-retries OR unreachable => n/a(2), never FAIL,
  # so mesh-land treats a legitimately screen-gated phone as a pass (exit 2), not a blocked landing.
  if json="$(read_conninfo)"; then
    ls="$(printf '%s' "$json" | grep -oE '"link_speed_mbps"[[:space:]]*:[[:space:]]*[0-9]+' | grep -oE '[0-9]+$')"
    rs="$(printf '%s' "$json" | grep -oE '"rssi"[[:space:]]*:[[:space:]]*-?[0-9]+' | grep -oE '[0-9]+$')"
    echo "smoke-test: ok (live read produced real fields: link_speed=${ls:-?}Mbps rssi=-${rs:-?}dBm)"; exit 0
  else
    echo "smoke-test: n/a (phone reachable but termux-wifi-connectioninfo empty/gated after ${WIFI_LINK_TRIES:-3} tries — honest BLIND, not faked)"; exit 2
  fi
fi

MODE=text; [ "${1:-}" = --json ] && MODE=json
EDGE=0
if [ "${1:-}" = --edge ]; then EDGE=1; MODE=edge; fi
TS=$(date -u +%Y-%m-%dT%H:%M:%SZ)

# --- Phone reachability ---
pip="$(mesh-phone-ip 2>/dev/null)" || {
  if [ ! -f "$OFFLINEFILE" ]; then
    echo "mesh-wifi-link: phone offline (all IPs tried) — no WiFi link sense" >&2
    touch "$OFFLINEFILE"
  fi
  exit 2
}
rm -f "$OFFLINEFILE"

# --- Read WiFi connection info (retry-sampled — see read_conninfo header) ---
# On empty-after-retries, route the diagnostic to a SIDECAR log, NOT stdout/stderr: under cron, stderr
# is redirected into wifi-link.log (the tape's source), so an empty line there becomes the tape's tail
# token -> UNKNOWN, and it keeps the log artificially FRESH so the tape never reaches its canonical
# .state liveness-fallback (psi/situation pattern). Keeping the empty noise off wifi-link.log lets the
# log carry ONLY real readings; a quiet-but-live FAIR then ages the log -> tape falls back to the fresh
# .wifi-link.state. Interactive callers (TTY) still see the diagnostic on stderr.
json="$(read_conninfo)" || {
  _emsg="phone reachable but termux-wifi-connectioninfo empty/gated after ${WIFI_LINK_TRIES:-3} tries — BLIND, not faked"
  if [ -t 2 ]; then echo "mesh-wifi-link: $_emsg" >&2
  else printf '%s  %s\n' "$TS" "$_emsg" >> "$HOME/.mesh/wifi-link-empty.log" 2>/dev/null || true; fi
  exit 2
}

# --- Parse JSON ---
# Extract fields with grep — avoids jq dependency on the phone
# JSON has spaces after colons: "key": "value" — patterns must match that
link_speed="$(printf '%s' "$json" | grep -oE '"link_speed_mbps"[[:space:]]*:[[:space:]]*[0-9]+' | grep -oE '[0-9]+$')"
rssi_line="$(printf '%s' "$json" | grep -oE '"rssi"[[:space:]]*:[[:space:]]*-?[0-9]+' | head -1)"
rssi="$(printf '%s' "$rssi_line" | grep -oE '[0-9]+$')"
case "$rssi_line" in *-*) rssi="-${rssi}";; esac
freq="$(printf '%s' "$json" | grep -oE '"frequency_mhz"[[:space:]]*:[[:space:]]*[0-9]+' | grep -oE '[0-9]+$')"
ssid="$(printf '%s' "$json" | grep -oE '"ssid"[[:space:]]*:[[:space:]]*"[^"]*"' | sed 's/.*"[[:space:]]*:[[:space:]]*"//;s/"$//')"
supplicant="$(printf '%s' "$json" | grep -oE '"supplicant_state"[[:space:]]*:[[:space:]]*"[^"]*"' | sed 's/.*"[[:space:]]*:[[:space:]]*"//;s/"$//')"
bssid="$(printf '%s' "$json" | grep -oE '"bssid"[[:space:]]*:[[:space:]]*"[^"]*"' | sed 's/.*"[[:space:]]*:[[:space:]]*"//;s/"$//')"

# --- Classify quality ---
if [ "$supplicant" != "COMPLETED" ]; then
  quality="DISCONNECTED"
  reason="supplicant_state=$supplicant (not connected)"
elif [ -z "$link_speed" ] || [ -z "$rssi" ]; then
  quality="UNKNOWN"
  reason="missing fields: link_speed=${link_speed:-?} rssi=${rssi:-?}"
elif [ "$link_speed" -ge 200 ] && [ "$rssi" -ge -50 ]; then
  quality="EXCELLENT"
  reason="${link_speed} Mbps, RSSI ${rssi} dBm (${freq}MHz)"
elif [ "$link_speed" -ge 72 ] && [ "$rssi" -ge -65 ]; then
  quality="GOOD"
  reason="${link_speed} Mbps, RSSI ${rssi} dBm (${freq}MHz)"
elif [ "$link_speed" -ge 24 ] && [ "$rssi" -ge -75 ]; then
  quality="FAIR"
  reason="${link_speed} Mbps, RSSI ${rssi} dBm (${freq}MHz)"
else
  quality="POOR"
  reason="${link_speed} Mbps, RSSI ${rssi} dBm (${freq}MHz)"
fi

band="5GHz"
[ "${freq:-0}" -lt 3000 ] 2>/dev/null && band="2.4GHz"

signals="link=${link_speed:-?}Mbps rssi=${rssi:-?}dBm freq=${freq:-?}MHz band=$band ssid=${ssid:-?}"

case "$MODE" in
  json)
    printf '{"quality":"%s","link_speed":%s,"rssi":%s,"frequency":%s,"band":"%s","ssid":"%s","bssid":"%s","supplicant":"%s","signals":"%s","reason":"%s","ts":"%s"}\n' \
      "$quality" "${link_speed:-null}" "${rssi:-null}" "${freq:-null}" "$band" "${ssid:-}" "${bssid:-}" "${supplicant:-}" "$signals" "$reason" "$TS"
    ;;
  edge)
    PENDING="${STATE%.state}.pending"
    confirmed="$(cat "$STATE" 2>/dev/null || true)"
    pending_line="$(cat "$PENDING" 2>/dev/null || true)"
    pending="${pending_line%%:*}"; pcount="${pending_line##*:}"; pcount="${pcount:-0}"

    if [ -z "$confirmed" ]; then
      printf '%s\n' "$quality" > "$STATE"; rm -f "$PENDING"
    elif [ "$quality" = "$confirmed" ]; then
      rm -f "$PENDING"
    elif [ "$quality" = "$pending" ]; then
      pcount=$((pcount + 1))
      if [ "$pcount" -ge 2 ]; then
        printf '%s\n' "$quality" > "$STATE"; rm -f "$PENDING"
        printf '[wifi-link] %s — %s [%s]\n' "$quality" "$reason" "$signals"
      else
        printf '%s:%d\n' "$quality" "$pcount" > "$PENDING"
      fi
    else
      printf '%s:1\n' "$quality" > "$PENDING"
    fi
    [ -e "$STATE" ] && touch "$STATE" 2>/dev/null || printf '%s\n' "$quality" > "$STATE"
    ;;
  *)
    printf '[wifi-link] %s — %s [%s]\n' "$quality" "$reason" "$signals"
    ;;
esac
