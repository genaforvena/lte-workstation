#!/usr/bin/env bash
# observer-probe: mesh-wifi-link
#   mesh-observer-effect: a pure READ, safe to run K+3 times; reads the phone's Wi-Fi adapter over SSH
# reflex-cadence: 2-59/5 * * * *
# reflex-state: $HOME/.mesh/.wifi-link.state
# reflex-blind-marker: $HOME/.mesh/.wifi-link-offline
# ^ Both declarations are required: an offline phone touches the marker instead of refreshing the last-good state.
# reflex-args: --edge
# mesh-wifi-link — compatibility entrypoint; phone Wi-Fi link adapter lives in integrations/.
set -u

self="${BASH_SOURCE[0]}"
case "$self" in
  */*) ;;
  *) self="$(command -v "$self")" || exit 127 ;;
esac

# Resolve installed symlinks back to this repository before selecting the sibling source.
while [ -L "$self" ]; do
  self_dir="$(CDPATH= cd -P "$(dirname "$self")" && pwd)" || exit 1
  link_target="$(readlink "$self")" || exit 1
  case "$link_target" in
    /*) self="$link_target" ;;
    *) self="$self_dir/$link_target" ;;
  esac
done

script_dir="$(CDPATH= cd -P "$(dirname "$self")" && pwd)" || exit 1
implementation="$script_dir/integrations/mesh-wifi-link"
if [ ! -x "$implementation" ]; then
  repo_root="${MESH_REPO:-${MESH_GENOME:-$HOME/lte-workstation}}"
  implementation="$repo_root/scripts/integrations/mesh-wifi-link"
fi
[ -x "$implementation" ] || {
  printf 'mesh-wifi-link: implementation missing or not executable: %s\n' "$implementation" >&2
  exit 127
}
exec "$implementation" "$@"
