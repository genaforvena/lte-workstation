#!/usr/bin/env bash
# mesh-md-link — stable {#uuid} anchors for Markdown links, so links survive a re-file.
# orphan-ok: on-demand markdown-link resolver/auditor (STUDY self-healing systems 2026-07-15) —
# minds call it when writing/linking docs; nothing schedules it.
#
# Markdown links break on refactor: `[see setup](docs/setup.md#install)` dies when the file
# moves or the heading is reworded. Same class as the board slug-orphan that mesh-board-id
# heals with {#id} tokens. This tool gives a doc SECTION an identity that is not its path:
# an HTML-comment anchor `<!-- {#uuid} -->` on its own line above the heading. Links carry
# the id — `[see setup](#uuid)` — and resolve() finds the section WHEREVER it now lives.
#
#   mesh-md-link mint                        print a fresh anchor line: <!-- {#uuid} -->
#   mesh-md-link resolve <id> [--dir D]      newest file:line carrying the anchor (rc 1: unknown)
#   mesh-md-link markdown <id> [--dir D]     print a Markdown link to the anchor's section
#   mesh-md-link check [--dir D]             sweep *.md under DIR (default .):
#                                              ANCHORED sections with an anchor
#                                              LINKED  ](#id) links that resolve
#                                              DANGLING ](#id) links with no anchor target
#                                              DUP      one id anchored in >1 place
#                                            rc 1 on DANGLING/DUP, else 0
#   mesh-md-link --test                      hermetic smoke test (sandboxed dir)
#
# READ-ONLY except mint output: never rewrites files. Accepts bare/UUID/{#..}/<!-- --> forms.
set -uo pipefail
usage(){ sed -n '2,/^[^#]/p' "$0" | sed -n 's/^# \?//p'; }
case "${1:-}" in -h|--help|"") usage; exit 0 ;; esac

norm_id(){ printf '%s' "$1" | sed -E 's/^<!-- *//; s/ *-->$//; s/^\{#//; s/\}$//; s/^#//'; }

mint(){
  local raw variant
  raw="$(od -An -N16 -tx1 /dev/urandom 2>/dev/null | tr -d ' \n')"
  [ "${#raw}" = 32 ] || { echo "mesh-md-link: mint failed (urandom read)" >&2; return 1; }
  case "$raw" in *[!0-9a-f]*) echo "mesh-md-link: mint failed (urandom read)" >&2; return 1 ;; esac
  variant="${raw:16:1}"
  case "$variant" in 0|1|2|3|4|5|6|7|c|d|e|f) variant=8 ;; 8|9|a|b) : ;; *) return 1 ;; esac
  printf '<!-- {#%s-%s-4%s-%s%s-%s} -->\n' "${raw:0:8}" "${raw:8:4}" "${raw:13:3}" "$variant" "${raw:17:3}" "${raw:20:12}"
}

dir_of(){ local d="."; while [ $# -gt 0 ]; do case "$1" in --dir) d="${2:-.}"; shift 2;; *) shift;; esac; done; printf '%s' "$d"; }
id_of(){ local i=""; while [ $# -gt 0 ]; do case "$1" in --dir) shift 2;; *) [ -z "$i" ] && i="$1"; shift;; esac; done; printf '%s' "$i"; }

resolve(){
  local id dir; id="$(norm_id "$(id_of "$@")")"; dir="$(dir_of "$@")"
  [ -n "$id" ] || { usage; return 1; }
  [ -d "$dir" ] || { echo "mesh-md-link: n/a — no dir $dir" >&2; return 2; }
  local hit; hit="$(grep -rFn --include='*.md' -e "{#$id}" "$dir" 2>/dev/null | grep -F '<!--' | tail -1)"
  [ -n "$hit" ] || { echo "mesh-md-link: {#$id} anchors no section under $dir" >&2; return 1; }
  printf '%s\n' "$hit"
}

markdown(){
  local id dir line loc heading f
  id="$(norm_id "$(id_of "$@")")"; dir="$(dir_of "$@")"
  [ -n "$id" ] || { usage; return 1; }
  line="$("$0" resolve "$id" --dir "$dir")" || return 1
  f="${line%%:*}"; loc="${line#*:}"; loc="${loc%%:*}"
  heading="$(awk -v n="$loc" 'NR>n && /^#+ /{print; exit} NR<=n{prev=$0} /^#+ /{prev=$0} NR==n{next_is_heading=1} NR==n+1&&next_is_heading{print; exit}' "$f" 2>/dev/null)"
  [ -n "$heading" ] || heading="$(grep -n '^#\+ ' "$f" 2>/dev/null | head -1 | sed 's/^[0-9]*://')"
  heading="${heading#+ }"; heading="${heading#+ }"; heading="${heading#+ }"
  [ -n "$heading" ] || heading="$f:$loc"
  printf '[%s](#%s)\n' "$heading" "$id"
}

check(){
  local dir; dir="$(dir_of "$@")"
  [ -d "$dir" ] || { echo "mesh-md-link: n/a — no dir $dir" >&2; return 2; }
  grep -rHn --include='*.md' -oE '\]\(#[0-9a-f]{8}(-[0-9a-f]{4}){0,4}\)|<!-- *\{#[^}]+\} *-->' "$dir" 2>/dev/null | python3 -c '
import sys, re, collections
anchors = collections.Counter()
links = []
for ln in sys.stdin:
    ln = ln.rstrip("\n")
    try: loc, m = ln.split(":", 1)
    except ValueError: continue
    for a in re.findall(r"<!-- *\{#([^}]+)\} *-->", m):
        anchors[a] += 1
        anchors["_loc:"+a] = loc
    for l in re.findall(r"\]\(#([^)]+)\)", m):
        links.append((loc, l))
dang = dup = ok = 0
for a, n in anchors.items():
    if a.startswith("_loc:"): continue
    if n > 1:
        print(f"DUP      {{#{a}}} x{n}"); dup += 1
for loc, l in links:
    if l in anchors:
        print(f"LINKED   #{l} in {loc}")
    else:
        print(f"DANGLING #{l} in {loc}"); dang += 1
print(f"check: anchored {sum(1 for k in anchors if not k.startswith(chr(95)+chr(108)+chr(111)+chr(99)+chr(58)))} · links {len(links)} · dangling {dang} · dup {dup}")
sys.exit(1 if (dang + dup) else 0)
'
}

selftest(){
  local t rc out; t="$(mktemp -d)" || exit 1
  trap "rm -rf '$t'" EXIT
  out="$("$0" mint)"; case "$out" in *'{#'????????-????-4???-????-????????????'}'*) : ;; *) echo "smoke-test: FAIL (mint shape)"; exit 1 ;; esac
  [ "$out" != "$("$0" mint)" ] || { echo "smoke-test: FAIL (two mints identical)"; exit 1; }
  mkdir -p "$t/docs"
  id="deadbeef-1111-4111-8111-111111111111"
  printf '<!-- {#%s} -->\n# Install\n\nSee [advanced](#%s).\n' "$id" "$id" > "$t/docs/setup.md"
  out="$("$0" resolve "$id" --dir "$t")" || { echo "smoke-test: FAIL (resolve rc)"; exit 1; }
  case "$out" in *'setup.md'*) : ;; *) echo "smoke-test: FAIL (resolve not setup.md: $out)"; exit 1 ;; esac
  # REFACTOR: move the section to a new file + reword the heading — id link must follow
  printf '<!-- {#%s} -->\n# Installation (v2)\n' "$id" > "$t/guide.md"
  rm "$t/docs/setup.md"
  out="$("$0" resolve "$id" --dir "$t")" || { echo "smoke-test: FAIL (resolve after move rc)"; exit 1; }
  case "$out" in *'guide.md'*) : ;; *) echo "smoke-test: FAIL (link did not survive refactor: $out)"; exit 1 ;; esac
  out="$("$0" markdown "$id" --dir "$t")" || { echo "smoke-test: FAIL (markdown rc)"; exit 1; }
  case "$out" in *'Installation (v2)](#'"$id"')'*) : ;; *) echo "smoke-test: FAIL (markdown label not newest: $out)"; exit 1 ;; esac
  printf 'See [ghost](#cafecafe).\n' > "$t/dang.md"
  out="$("$0" check --dir "$t")"; rc=$?
  [ "$rc" = 1 ] || { echo "smoke-test: FAIL (check rc=$rc, want 1 on DANGLING)"; exit 1; }
  case "$out" in *'DANGLING #cafecafe'*) : ;; *) echo "smoke-test: FAIL (no DANGLING): $out"; exit 1 ;; esac
  rm "$t/dang.md"
  "$0" check --dir "$t" >/dev/null || { echo "smoke-test: FAIL (clean check rc)"; exit 1; }
  "$0" resolve deadbeef --dir "$t/none" >/dev/null 2>&1; rc=$?
  [ "$rc" = 2 ] || { echo "smoke-test: FAIL (no-dir rc=$rc, want 2)"; exit 1; }
  echo "smoke-test: ok (mint/resolve-follows-refile/markdown/check dangling)"
}

case "$1" in
  --test) selftest ;;
  mint) mint ;;
  resolve) shift; resolve "$@" ;;
  markdown) shift; markdown "$@" ;;
  check) shift; check "$@" ;;
  *) usage; exit 1 ;;
esac
