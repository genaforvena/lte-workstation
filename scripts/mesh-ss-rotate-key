#!/usr/bin/env bash
# mesh-ss-rotate-key — generate new SS password + restart phaedra's ss-server
# SS key is confirmed breached (Vimpelcom 3rd party used it, 2026-06-18).
# Run ONLY after operator confirms their setup works with current key.
# Outputs new URIs for all active ports.
# reflex-cadence: none (on-demand — only when key is compromised)

set -euo pipefail
PHAEDRA="phaedra"
SS_HOST="38.49.216.141"
SS_PORT=443
METHOD="chacha20-ietf-poly1305"
CONF_PATH="/var/lib/shadowsocks-libev/config.json"

do_test() {
  local f=0
  command -v ssh >/dev/null 2>&1 || { echo "FAIL: ssh missing"; f=1; }
  command -v openssl >/dev/null 2>&1 || { echo "FAIL: openssl missing"; f=1; }
  timeout 5 ssh -o StrictHostKeyChecking=no "$PHAEDRA" "echo ok" 2>/dev/null || { echo "FAIL: phaedra unreachable"; exit 2; }
  ssh "$PHAEDRA" "test -f $CONF_PATH" 2>/dev/null || { echo "FAIL: no SS config on phaedra"; exit 2; }
  echo "smoke-test: ok"; exit 0
}

DRY_RUN=0
while [ $# -gt 0 ]; do
  case "$1" in
    --test) do_test;;
    --dry-run) DRY_RUN=1; shift;;
    *) echo "usage: $0 [--dry-run] [--test]"; exit 1;;
  esac
done

# Read current config
CONF=$(timeout 15 ssh -o StrictHostKeyChecking=no "$PHAEDRA" "cat $CONF_PATH" 2>/dev/null) || {
  echo "mesh-ss-rotate-key: FAIL — cannot read SS config" >&2; exit 2
}
OLD_PASSWORD=$(echo "$CONF" | python3 -c "import json,sys; print(json.load(sys.stdin)['password'])") || {
  echo "mesh-ss-rotate-key: FAIL — cannot parse current password" >&2; exit 2
}

# Generate new 32-byte random password (base64-encoded, same format as current)
NEW_PASSWORD=$(openssl rand -base64 32 | tr -d '\n')
NEW_PASSWORD_BARE=$(printf '%s' "$NEW_PASSWORD" | base64 -w0 | tr '+/' '-_' | tr -d '=')

echo "mesh-ss-rotate-key :: SS key rotation on $PHAEDRA"
echo "  Old password (last 4): ...${OLD_PASSWORD: -4}"
echo "  New password (last 4): ...${NEW_PASSWORD: -4}"
echo "  Method: $METHOD"

if [ "$DRY_RUN" = 1 ]; then
  echo "  [DRY RUN] No changes made. Run without --dry-run to apply."
  exit 0
fi

# Build new config
NEW_CONF=$(echo "$CONF" | python3 -c "
import json,sys
d=json.load(sys.stdin)
d['password']='$NEW_PASSWORD'
print(json.dumps(d,indent=2))
")

# Write to phaedra
echo "$NEW_CONF" | timeout 15 ssh -o StrictHostKeyChecking=no "$PHAEDRA" "sudo tee $CONF_PATH > /dev/null" 2>/dev/null || {
  echo "mesh-ss-rotate-key: FAIL — could not write new config" >&2; exit 2
}

# Restart SS server
ssh "$PHAEDRA" "sudo systemctl restart shadowsocks-libev" 2>&1 | tail -2 || {
  echo "mesh-ss-rotate-key: FAIL — ss-server restart failed" >&2; exit 2
}
sleep 2

# Verify SS is running
if ! ssh "$PHAEDRA" "systemctl is-active shadowsocks-libev" 2>/dev/null | grep -q active; then
  echo "mesh-ss-rotate-key: FAIL — ss-server not active after restart" >&2
  exit 2
fi
echo "  ss-server restarted: OK"

# Generate new URIs for port 443 (native) and port 80 (socat proxy, if active)
NEW_URI_443="ss://$(printf '%s:%s' "$METHOD" "$NEW_PASSWORD" | base64 -w0 | tr '+/' '-_' | tr -d '=')@${SS_HOST}:443#mesh-lte-bypass"
echo ""
echo "  New SS URIs:"
echo "  Port 443: $NEW_URI_443"

# Check if port 80 redirect is active
if ssh "$PHAEDRA" "systemctl is-active ss-alt-80" 2>/dev/null | grep -q active; then
  NEW_URI_80="ss://$(printf '%s:%s' "$METHOD" "$NEW_PASSWORD" | base64 -w0 | tr '+/' '-_' | tr -d '=')@${SS_HOST}:80#mesh-lte-bypass-80"
  echo "  Port  80: $NEW_URI_80"
fi

echo ""
echo "  ⚠  OLD configs with the previous password will stop working immediately."
echo "  ⚠  Re-import the new config on all devices."
