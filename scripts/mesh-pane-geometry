#!/usr/bin/env bash
# Restore visible DATA room after detached tmux startup. Only declared role
# windows whose first pane runs mesh-dash are resized; the mind process is kept.
set -uo pipefail
mode="${1:---ensure}"; sess="${2:-$(hostname)}"
case "$mode" in --ensure|--dry-run) ;; *) echo 'usage: mesh-pane-geometry [--ensure|--dry-run] [session]' >&2; exit 2;; esac
command -v tmux >/dev/null 2>&1 || exit 2
tmux has-session -t "$sess" 2>/dev/null || exit 2

# A detached restore has no honest viewport. The minute pane reflex retries
# after a client attaches; small clients keep the pane coverage gate in HOLD.
clients="$(tmux list-clients -t "$sess" -F '#{client_width} #{client_height} #{client_session}' 2>/dev/null)" || exit 2
[ "$(printf '%s\n' "$clients" | grep -c .)" = 1 ] || { echo 'geometry HOLD: need exactly one attached client' >&2; exit 2; }
read -r width height client_session <<<"$clients"
[[ "$width" =~ ^[0-9]+$ && "$height" =~ ^[0-9]+$ && "$client_session" = "$sess" ]] || exit 2
[ "$width" -ge 160 ] && [ "$height" -ge 64 ] || { echo "geometry HOLD: client ${width}x${height} below 160x64" >&2; exit 2; }
# tmux status consumes one row on this session. Read the active client window
# rather than guessing how many status rows are configured.
viewport="$(tmux display-message -p -t "$sess" '#{window_width} #{window_height}' 2>/dev/null)" || exit 2
read -r pane_width pane_height <<<"$viewport"
[[ "$pane_width" =~ ^[0-9]+$ && "$pane_height" =~ ^[0-9]+$ ]] || exit 2
[ "$pane_width" -ge 160 ] && [ "$pane_height" -ge 63 ] || exit 2
# Reserve 16 rows plus the tmux divider for the live mind; compacted DATA
# frames currently need <=36 rows at 274 columns. Witness gets the whole pane.
top_height=$((pane_height - 17))
changed=0
while read -r win panes current_width current_height; do
  case "$win" in
    minds|genome|tg|senses|health|cleaner|pub|discover|sound|vpn|tg-roz|job|adint|hire|haunt|wake) [ "$panes" = 2 ] || continue ;;
    witness) [ "$panes" = 1 ] || continue ;;
    *) continue ;;
  esac
  start="$(tmux display-message -p -t "$sess:$win.0" '#{pane_start_command}' 2>/dev/null)" || continue
  dash_role="$win"; [ "$win" = health ] && dash_role=check
  case "$start" in *"mesh-dash $dash_role"*) ;; *) continue ;; esac
  [ "$current_width" = "$pane_width" ] && [ "$current_height" = "$pane_height" ] && {
    if [ "$win" = witness ]; then continue; fi
    current_top="$(tmux display-message -p -t "$sess:$win.0" '#{pane_height}' 2>/dev/null)"
    [ "$current_top" = "$top_height" ] && continue
  }
  if [ "$mode" = --dry-run ]; then
    echo "would resize $sess:$win to ${pane_width}x${pane_height}${panes:+ panes=$panes top=$top_height}"
    continue
  fi
  tmux resize-window -t "$sess:$win" -x "$pane_width" -y "$pane_height" || exit 1
  if [ "$panes" = 2 ]; then tmux resize-pane -t "$sess:$win.0" -y "$top_height" || exit 1; fi
  changed=$((changed+1))
done < <(tmux list-windows -t "$sess" -F '#{window_name} #{window_panes} #{window_width} #{window_height}' 2>/dev/null)
[ "$changed" -eq 0 ] || echo "geometry: $changed role window(s) resized to ${pane_width}x${pane_height} (top=$top_height; mind>=16)"
