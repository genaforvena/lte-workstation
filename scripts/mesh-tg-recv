#!/usr/bin/env bash
# mesh-tg-recv — receive the OPERATOR's Telegram messages into mesh-chat, from a node that CAN
# reach api.telegram.org. default-string's clean host route can't (ISP-blocked; only its VPN can),
# so rather than route the bot's traffic via the VPN (a substrate change on default-string), the
# RECEIVER lives on a node that already reaches telegram (IdeaPad, via the exit-node). Pairs with
# mesh-tg (send). ONE poller only — do not run alongside another getUpdates consumer (proxy-bot).
#   mesh-tg-recv --once   read pending operator msgs -> chat, advance offset, exit
#   mesh-tg-recv --loop   long-poll forever (run in a tmux window)
set -uo pipefail
ENVF="$HOME/.config/remote-access/env"; [ -f "$ENVF" ] && { set -a; . "$ENVF"; set +a; }
TOKEN="${BOT_TOKEN:?BOT_TOKEN missing}"; OWNER="${CHAT_ID:?CHAT_ID missing}"
CHAT="$HOME/.mesh/chat.log"; OFFF="$HOME/.mesh/.tg-offset"; mkdir -p "$HOME/.mesh"; touch "$CHAT"
poll(){
  local off resp; off="$(cat "$OFFF" 2>/dev/null || echo 0)"
  resp="$(curl -s --max-time $(( ${1:-25} + 8 )) "https://api.telegram.org/bot${TOKEN}/getUpdates?offset=${off}&timeout=${1:-25}")"
  printf '%s' "$resp" | OWNER="$OWNER" CHAT="$CHAT" OFFF="$OFFF" python3 - <<'PY'
import json,sys,os,time
try: d=json.loads(sys.stdin.read())
except Exception: sys.exit(0)
if not d.get("ok"): print("getUpdates:", d.get("description","not ok")); sys.exit(0)
owner=int(os.environ["OWNER"]); chat=os.environ["CHAT"]; offf=os.environ["OFFF"]
maxid=None
for u in d.get("result",[]):
    maxid=u["update_id"]
    m=u.get("message") or u.get("edited_message") or {}
    if (m.get("from") or {}).get("id")!=owner: continue
    t=m.get("text") or m.get("caption") or ""
    if t:
        ts=time.strftime("%H:%M:%SZ", time.gmtime())
        open(chat,"a").write(f"{ts}  tg:operator  ::  {t}\n")
        print("RECV:", t[:100])
if maxid is not None: open(offf,"w").write(str(maxid+1))
PY
}
case "${1:-}" in
  --loop) echo "[mesh-tg-recv] long-polling operator -> mesh-chat (receiver on $(hostname))"; while true; do poll 25 || true; sleep 1; done ;;
  ""|--once) poll 2 ;;
  *) echo "usage: mesh-tg-recv [--once|--loop]" >&2; exit 1 ;;
esac
