#!/usr/bin/env python3
"""Materialize the historical voice asks as an auditable, non-closing ledger.

The witness batch in chat.log is only an acknowledgement.  This tool joins each
acknowledged ask to the exact source line in voice-in.log and emits one ledger row
per ask.  Rows deliberately start as OPEN: a TG reply is never treated as proof.
Later work may replace OPEN with IMPLEMENTED, DESIGN, or DECLINED and must cite an
artifact/reason.
"""
from __future__ import annotations

import argparse
import os
import re
from datetime import datetime, timezone
from pathlib import Path

CHAT = Path.home() / ".mesh/chat.log"
VOICE = Path.home() / ".mesh/voice-in.log"
DEFAULT_OUT = Path.home() / ".mesh/evidence/historical-ask-drain-20260906.tsv"
REPO = Path(os.environ.get("MESH_GENOME", Path.home() / "lte-workstation"))
DECISIONS = REPO / "docs/historical-ask-decisions-20260906.tsv"
ID_RE = re.compile(r"\[done\]\s+ask:(\d{8}T\d{6}Z)")
VOICE_RE = re.compile(r"^(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d)Z\s+(\S+)\s+(.*)$")


def load() -> list[dict[str, str]]:
    asks: list[str] = []
    for line in CHAT.read_text(errors="replace").splitlines():
        match = ID_RE.search(line)
        if match and match.group(1) not in asks:
            asks.append(match.group(1))
    source: dict[str, tuple[str, str, str]] = {}
    for line in VOICE.read_text(errors="replace").splitlines():
        match = VOICE_RE.match(line)
        if not match:
            continue
        stamp, kind, body = match.groups()
        key = stamp.replace("-", "").replace(":", "") + "Z"
        source[key] = (stamp + "Z", kind, body)
    decisions: dict[str, tuple[str, str, str]] = {}
    if DECISIONS.exists():
        for line in DECISIONS.read_text(errors="replace").splitlines():
            if not line or line.startswith("#"):
                continue
            ask_id, status, artifact, reason = line.split("\t", 3)
            decisions[ask_id] = (status, artifact, reason)
    rows = []
    for ask_id in asks:
        stamp, kind, body = source.get(ask_id, ("", "MISSING", "source line not found"))
        status, artifact, reason = decisions.get(ask_id, ("OPEN", "", ""))
        rows.append({"id": ask_id, "source_ts": stamp, "kind": kind,
                     "status": status, "artifact": artifact, "reason": reason,
                     "ask": body.replace("\t", " ").replace("\n", " ")})
    return rows


def write(path: Path, rows: list[dict[str, str]]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    header = "id\tsource_ts\tkind\tstatus\tartifact\treason\task\n"
    body = "".join("\t".join(row[key] for key in header.rstrip().split("\t")) + "\n"
                   for row in rows)
    path.write_text("# generated by scripts/mesh-historical-ask-ledger; OPEN is not closed\n"
                    + header + body)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--out", type=Path, default=DEFAULT_OUT)
    parser.add_argument("--test", action="store_true")
    args = parser.parse_args()
    rows = load()
    if args.test:
        assert len(rows) == 191, len(rows)
        assert len({row["id"] for row in rows}) == len(rows)
        assert sum(row["status"] == "OPEN" for row in rows) == 188
        assert {row["status"] for row in rows} == {"OPEN", "DECLINED", "DESIGN"}
        assert sum(row["kind"] == "MISSING" for row in rows) == 0
        print(f"historical-ask-ledger: {len(rows)} unique source-backed OPEN rows")
        return 0
    write(args.out, rows)
    print(f"wrote {len(rows)} OPEN rows to {args.out}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
