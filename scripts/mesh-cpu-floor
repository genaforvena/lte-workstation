#!/usr/bin/env bash
# orphan-ok: on-demand ACPI CPPC hardware floor probe; invoked by the senses mind when needed
# mesh-cpu-floor — CPU firmware minimum-performance floor sense.
#
# Reads ACPI CPPC's per-core lowest_freq from sysfs. This is not the current clock
# (mesh-cpufreq) or the delivered clock (mesh-cppc): it is the lowest frequency the
# firmware permits/request policy exposes for each core. A change here can explain
# why a quiet CPU still will not enter a lower performance state.
#
# Honest contract: no readable CPPC lowest_freq -> exit 2; never substitute a default.
#   mesh-cpu-floor          one real hardware reading
#   mesh-cpu-floor --json   machine-readable reading
#   mesh-cpu-floor --test   fixture parser + real sysfs gate
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

ROOT="${MESH_CPU_FLOOR_ROOT:-/sys/devices/system/cpu}"
STATE="${MESH_CPU_FLOOR_STATE:-${HOME:-/tmp}/.mesh/.cpu-floor.state}"

read_floors() {
  local root="${MESH_CPU_FLOOR_ROOT:-$ROOT}" d v n=0 total=0 min=""
  for d in "$root"/cpu[0-9]*/acpi_cppc; do
    [ -r "$d/lowest_freq" ] || continue
    v="$(cat "$d/lowest_freq" 2>/dev/null || true)"
    case "$v" in ''|*[!0-9]*) continue ;; esac
    total=$((total + v)); n=$((n + 1))
    [ -z "$min" ] || [ "$v" -lt "$min" ] || continue
    min="$v"
  done
  [ "$n" -gt 0 ] || return 2
  printf '%s %s %s\n' "$min" "$total" "$n"
}

if [ "${1:-}" = --test ]; then
  td="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
  trap 'rm -rf "$td"' EXIT
  mkdir -p "$td/cpu0/acpi_cppc" "$td/cpu3/acpi_cppc"
  printf '800\n' > "$td/cpu0/acpi_cppc/lowest_freq"
  printf '1200\n' > "$td/cpu3/acpi_cppc/lowest_freq"
  got="$(MESH_CPU_FLOOR_ROOT="$td" read_floors)" || { echo "smoke-test: FAIL (fixture read)"; exit 1; }
  [ "$got" = "800 2000 2" ] || { echo "smoke-test: FAIL (fixture got '$got')"; exit 1; }
  mkdir -p "$td/bad/cpu0/acpi_cppc"
  printf 'not-a-frequency\n' > "$td/bad/cpu0/acpi_cppc/lowest_freq"
  MESH_CPU_FLOOR_ROOT="$td/bad" read_floors >/dev/null 2>&1 && { echo "smoke-test: FAIL (malformed source accepted)"; exit 1; }
  live="$(read_floors 2>/dev/null)" || { echo "smoke-test: n/a — no readable CPPC lowest_freq on $(hostname)"; exit 2; }
  [ -n "$live" ] || { echo "smoke-test: FAIL (live read was empty)"; exit 1; }
  echo "smoke-test: ok (fixture parser + REAL CPPC lowest_freq read: $live)"
  exit 0
fi

_floor_read="$(read_floors 2>/dev/null)" || {
  echo "mesh-cpu-floor: UNREACHABLE — no readable ACPI CPPC lowest_freq" >&2
  exit 2
}
read -r min total n <<<"$_floor_read"
ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
mkdir -p "$(dirname "$STATE")" 2>/dev/null || exit 1
printf 'min_khz=%s|sum_khz=%s|cpus=%s|ts=%s\n' "$min" "$total" "$n" "$ts" > "$STATE" || exit 1
if [ "${1:-}" = --json ]; then
  printf '{"min_khz":%s,"sum_khz":%s,"cpus":%s,"source":"acpi_cppc/lowest_freq","ts":"%s"}\n' "$min" "$total" "$n" "$ts"
else
  printf '[cpu-floor] min=%skHz cpus=%s source=acpi_cppc/lowest_freq @ %s\n' "$min" "$n" "$ts"
fi
