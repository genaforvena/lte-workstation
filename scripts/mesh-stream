#!/usr/bin/env bash
# mesh-stream — THE universal primitive for connecting a MIND to work (operator's pattern, 2026-06-11).
#
#   "This pattern is for EVERYTHING. Minds don't generate work per se — work is the mind's RESPONSE to
#    data fed into its session. Any stream = a tmux window/pane (the SOURCE), reflective PULLING,
#    FILTERING, and CONDITIONALLY feeding the filtered data as a KEYSTROKE prompt into a mind's tmux
#    session (claude/opencode/gemini/codex; claude default)."
#
# Monitoring, task-flow, voice, alerts, reviews — ALL are mesh-stream instances. The reflex (cron) is
# cheap and always runs; the expensive MIND is engaged ONLY when the filter emits something.
#
#   mesh-stream <name> '<pull>' '<filter>' [mind]
#     pull   : cmd → the SOURCE data this cycle (also shown live in pane  mon:<name>)
#     filter : receives pull's output on STDIN → emits on STDOUT the PROMPT to feed the mind.
#              Emit NOTHING ⇒ no mind needed this cycle. (filter = the CONDITION + the SHAPING.)
#     mind   : session window to feed (default: claude). Special: "@idle" feeds the first idle worker.
#   Edge-dedup: the same prompt isn't re-fed until it changes — don't spam the mind.
#   mesh-stream --test
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
S="$(hostname)"; ST="$HOME/.mesh/stream"; mkdir -p "$ST"
[ "${1:-}" = --test ] && { echo "smoke-test: ok"; exit 0; }
name="${1:?usage: mesh-stream <name> '<pull>' '<filter>' [mind]}"; pull="${2:?need pull}"; filter="${3:?need filter}"; mind="${4:-claude}"
WIN="mon:$name"; lastfed="$ST/$name.lastfed"; ts(){ date -u +%H:%MZ; }

# (1) PULL the source
data="$(bash -c "$pull" 2>&1)"

# (2) PERCEIVE: a self-refreshing PANE showing the live source (not stored — re-observed)
if tmux has-session -t "$S" 2>/dev/null && ! tmux list-windows -t "$S" -F '#{window_name}' 2>/dev/null | grep -qx "$WIN"; then
  pb=$(printf '%s' "$pull" | base64 | tr -d '\n')
  tmux new-window -d -t "$S" -n "$WIN" \
    "while :; do clear; echo \"== stream: $name  (source refresh 30s) ==\"; date -u; echo; bash -c \"\$(echo $pb | base64 -d)\" 2>&1; sleep 30; done" 2>/dev/null || true
fi

# (3) FILTER → the prompt to feed (empty stdout ⇒ nothing needed this cycle)
prompt="$(printf '%s' "$data" | bash -c "$filter" 2>/dev/null || true)"
[ -z "${prompt//[[:space:]]/}" ] && { echo "$(ts) stream[$name]: nothing to feed"; exit 0; }

# (4) edge-dedup
if [ "$prompt" = "$(cat "$lastfed" 2>/dev/null || true)" ]; then echo "$(ts) stream[$name]: unchanged prompt — not re-feeding"; exit 0; fi

# (5) resolve the mind: @idle → first idle worker window, else the named window
target="$mind"
if [ "$mind" = "@idle" ]; then
  target=""
  for w in opencode gemini claude; do
    a="$(tmux capture-pane -t "$S:$w" -p 2>/dev/null)"; sleep 1.5; b="$(tmux capture-pane -t "$S:$w" -p 2>/dev/null)"
    [ -n "$a" ] && [ "$a" = "$b" ] && { target="$w"; break; }
  done
  [ -z "$target" ] && { echo "$(ts) stream[$name]: no idle worker — holding"; exit 0; }
fi

# (6) CONDITIONALLY FEED as a keystroke prompt into the mind's session
if mesh-tell "$target" "$prompt" >/dev/null 2>&1; then
  printf '%s' "$prompt" > "$lastfed"
  echo "$(ts) stream[$name] → FED $target: ${prompt:0:70}"
else echo "$(ts) stream[$name]: feed to $target failed"; fi
