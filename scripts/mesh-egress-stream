#!/usr/bin/env bash
# mesh-egress-stream — degrade-only stream on top of mesh-egress-health.
#
# Cheap reflex: poll egress, then feed a mind only when quality drops.
# Trigger conditions:
#   - mesh-egress-health reports BAD
#   - Anthropic HTTP code is present and not 401/405
#   - optional latency/loss thresholds are exceeded if future payloads provide them
#
# Test mode:
#   MESH_EGRESS_STREAM_TEST_PAYLOAD can inject a synthetic payload.
#   MESH_EGRESS_STREAM_MIND can override the target mind (default: @idle).
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
MESH="$HOME/.mesh"
LASTFED="$MESH/.egress-stream.lastfed"
mkdir -p "$MESH"
ts(){ date -u +%FT%TZ; }

resolve_idle() {
  local S
  S="$(hostname)"
  for w in opencode gemini claude; do
    a="$(tmux capture-pane -t "$S:$w" -p 2>/dev/null)"; sleep 1.5
    b="$(tmux capture-pane -t "$S:$w" -p 2>/dev/null)"
    [ -n "$a" ] && [ "$a" = "$b" ] && { printf '%s' "$w"; return 0; }
  done
  return 1
}

pull_payload() {
  if [ -n "${MESH_EGRESS_STREAM_TEST_PAYLOAD:-}" ]; then
    printf '%s\n' "$MESH_EGRESS_STREAM_TEST_PAYLOAD"
    return 0
  fi

  mesh-egress-health >/dev/null 2>&1 || true
  state="$(cat "$MESH/.egress-state" 2>/dev/null || echo OK)"
  last="$(tail -n1 "$MESH/egress-health.log" 2>/dev/null || true)"
  anth="$(printf '%s' "$last" | sed -n 's/.*anthropic=\([0-9][0-9][0-9]\).*/\1/p')"
  latency="$(printf '%s' "$last" | sed -n 's/.*latency=\([0-9.][0-9.]*\).*/\1/p')"
  loss="$(printf '%s' "$last" | sed -n 's/.*loss=\([0-9.][0-9.]*\).*/\1/p')"
  printf 'state=%s\nanth=%s\nlatency=%s\nloss=%s\nlast=%s\n' \
    "$state" "${anth:-}" "${latency:-}" "${loss:-}" "$last"
}

prompt_for_payload() {
  local state="" anth="" latency="" loss="" last="" bad=0 reason=""
  while IFS='=' read -r key value; do
    case "$key" in
      state) state="$value" ;;
      anth) anth="$value" ;;
      latency) latency="$value" ;;
      loss) loss="$value" ;;
      last) last="$value" ;;
    esac
  done

  case "$state" in
    BAD|FAIL|DOWN) bad=1; reason="state=$state" ;;
  esac
  case "$anth" in
    401|405|'') : ;;
    *) bad=1; reason="${reason:+$reason }anth=$anth" ;;
  esac

  if [ -n "${MESH_EGRESS_LATENCY_MS:-}" ] && [ -n "$latency" ]; then
    if awk "BEGIN { exit !($latency > ${MESH_EGRESS_LATENCY_MS:-0}) }"; then
      bad=1
      reason="${reason:+$reason }latency=${latency}ms>${MESH_EGRESS_LATENCY_MS}ms"
    fi
  fi
  if [ -n "${MESH_EGRESS_LOSS_PCT:-}" ] && [ -n "$loss" ]; then
    if awk "BEGIN { exit !($loss > ${MESH_EGRESS_LOSS_PCT:-0}) }"; then
      bad=1
      reason="${reason:+$reason }loss=${loss}%>${MESH_EGRESS_LOSS_PCT}%"
    fi
  fi

  [ "$bad" -eq 1 ] || return 1
  printf '[check] egress degraded: %s' "$reason"
  [ -n "$last" ] && printf ' — %s' "$last"
  printf '\n'
}

feed_prompt() {
  local target="$1" prompt="$2" prev=""
  prev="$(cat "$LASTFED" 2>/dev/null || true)"
  if [ "$prompt" = "$prev" ]; then
    echo "$(ts) stream[egress]: unchanged prompt — not re-feeding"
    return 0
  fi

  if [ "$target" = "@idle" ]; then
    target="$(resolve_idle 2>/dev/null || true)"
    [ -n "$target" ] || { echo "$(ts) stream[egress]: no idle worker — holding"; return 0; }
  fi

  if mesh-tell "$target" "$prompt" >/dev/null 2>&1; then
    printf '%s' "$prompt" > "$LASTFED"
    echo "$(ts) stream[egress] → FED $target: ${prompt:0:70}"
  else
    echo "$(ts) stream[egress]: feed to $target failed"
    return 1
  fi
}

if [ "${1:-}" = --test ]; then
  command -v mesh-egress-health >/dev/null 2>&1 || { echo "smoke-test: FAIL (mesh-egress-health missing)"; exit 1; }
  command -v mesh-tell >/dev/null 2>&1 || { echo "smoke-test: FAIL (mesh-tell missing)"; exit 1; }
  echo "smoke-test: ok"
  exit 0
fi

if [ "${1:-}" = --eval ]; then
  shift
  prompt="$(printf '%s\n' "${1:-}" | prompt_for_payload || true)"
  [ -n "${prompt//[[:space:]]/}" ] && printf '%s\n' "$prompt"
  exit 0
fi

mind="${MESH_EGRESS_STREAM_MIND:-@idle}"
payload="$(pull_payload)"
prompt="$(printf '%s\n' "$payload" | prompt_for_payload || true)"
[ -z "${prompt//[[:space:]]/}" ] && { echo "$(ts) stream[egress]: nothing to feed"; exit 0; }
feed_prompt "$mind" "$prompt"
