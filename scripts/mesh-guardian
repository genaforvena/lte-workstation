#!/usr/bin/env bash
# mesh-guardian — SURVIVAL reflex (reflective node + organ check; from ANY node — location independent).
# Ensures: every node reachable; every MIND node has its hostname-tmux session (the mind's home + the
# connection substrate); the telegram organ (single mesh-voice-rx) is alive. RECOVERS what it can
# (recreate tmux over ssh = channel-messaging, restart the organ), ALERTS what it can't (down mind/sense).
# reflex-cadence: 23 * * * *
set -uo pipefail
if [ "${1:-}" = --test ]; then
  command -v ssh >/dev/null 2>&1 || { echo "smoke-test: FAIL (no ssh)"; exit 1; }
  command -v timeout >/dev/null 2>&1 || { echo "smoke-test: FAIL (no timeout)"; exit 1; }
  mkdir -p "$HOME/.mesh" 2>/dev/null || { echo "smoke-test: FAIL (~/.mesh not writable)"; exit 1; }
  command -v grep >/dev/null 2>&1 || { echo "smoke-test: FAIL (no grep)"; exit 1; }
  command -v mktemp >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mktemp)"; exit 1; }
  # Dry-run: mock unreachable peer → verify parallel path detects DOWN + exits cleanly (no hang)
  _tn="$(mktemp)"
  printf 'MESH_NODES="test-guardian-peer:nonexistent-host-127-0-99-253.local"\nMESH_ROLES="test-guardian-peer:mind"\n' > "$_tn"
  # MESH_GUARDIAN_NO_ALERT=1: exercise the FULL reachability+DOWN path but NEVER send a real
  # Telegram alarm. Without this, every smoke-test (mesh-doctor/fitness/reflex-health all run it)
  # spammed the operator with "🛡 GUARDIAN: test-guardian-peer unreachable" about a FAKE peer —
  # the self-inflicted noise that made the operator distrust the reflexes (2026-06-17).
  # The dry-run gets its OWN log. Writing into the real guardian.log made the smoke test forge the
  # artifact it was supposed to check: doctor runs this every hour at :23, so guardian.log filled with
  # "DOWN test-guardian-peer / guardian pass done" that reads EXACTLY like a live pass — while the real
  # reflex was not in cron at all and had never run here. The log looked alive because the test was
  # talking. A test must never write to the artifact a human reads for liveness.
  _tl="$(mktemp)"
  MESH_GUARDIAN_NO_ALERT=1 MESH_GUARDIAN_LOG="$_tl" MESH_GUARDIAN_NODES_FILE="$_tn" \
    timeout 30 bash "${BASH_SOURCE[0]}" >/dev/null 2>&1 || true
  if ! grep -q 'DOWN test-guardian-peer' "$_tl" 2>/dev/null; then
    rm -f "$_tn" "$_tl"; echo "smoke-test: FAIL (DOWN not logged for test-guardian-peer)" >&2; exit 1
  fi
  rm -f "$_tl"
  # tg-organ keeper: assert the predicate DECIDES — both directions. A hardcoded TG_HOST made this
  # branch permanently false and nothing noticed for a day (organ dead 01:28→04:32, log green every
  # hour). Drive it with a mock credential: token present → keeper ACTIVE; absent → keeper skipped
  # with a reason. A gate you have not seen fail is not a gate, so we run the fail direction too.
  # Each direction gets a FRESH log. Greping the shared guardian.log made this gate vacuous in the
  # first draft: the run-before's "keeper ACTIVE" line was still in the tail, so the broken hardcoded
  # predicate passed its own gate. An assertion that can read another run's artifact asserts nothing.
  _tc="$(mktemp)"; _tglog(){ local _l; _l="$(mktemp)"
    MESH_GUARDIAN_NO_ALERT=1 MESH_GUARDIAN_TG_DRYRUN=1 MESH_TG_CRED="$_tc" MESH_GUARDIAN_LOG="$_l" \
      MESH_GUARDIAN_NODES_FILE="$_tn" timeout 30 bash "${BASH_SOURCE[0]}" >/dev/null 2>&1 || true
    cat "$_l"; rm -f "$_l"; }
  printf 'BOT_TOKEN=123:mock\n' > "$_tc"
  _tglog | grep -q 'telegram organ keeper ACTIVE' || {
    rm -f "$_tn" "$_tc"; echo "smoke-test: FAIL (keeper did not fire with BOT_TOKEN present)" >&2; exit 1; }
  : > "$_tc"
  _tglog | grep -q 'telegram organ not kept here' || {
    rm -f "$_tn" "$_tc"; echo "smoke-test: FAIL (keeper fired/silent without BOT_TOKEN)" >&2; exit 1; }
  rm -f "$_tn" "$_tc"
  echo "smoke-test: ok (reachability + DOWN detection; tg-organ keeper decides both directions)"
  exit 0
fi
export PATH="$HOME/.local/bin:$PATH"
LOG="${MESH_GUARDIAN_LOG:-$HOME/.mesh/guardian.log}"; stamp(){ date -u +%FT%TZ; }
note(){ echo "$(stamp) $*" >> "$LOG"; }
alert(){ [ -z "${MESH_GUARDIAN_NO_ALERT:-}" ] && command -v mesh-tg >/dev/null 2>&1 && mesh-tg "🛡 GUARDIAN: $*" >/dev/null 2>&1; note "ALERT: $*"; }
S(){ timeout 14 ssh -n -o BatchMode=yes -o ConnectTimeout=6 $1 "$2" 2>/dev/null; }
# The telegram organ runs where the BOT_TOKEN is — that is the only place it CAN run. A hardcoded
# hostname is a VACUOUS predicate: when the minds migrated IdeaPad→mesh-home (2026-07-14) this test
# went permanently false, the keeper body below never executed once, and the log still wrote a green
# "guardian pass done" every hour while the organ lay dead since 01:28 and the operator's messages
# piled up unread. Derive it from the credential instead, so the check follows the organ; keep an
# explicit MESH_TG_HOST override (~/.mesh/nodes) for a node that holds a token but must not poll
# (two pollers on one token = getUpdates 409, silently eating operator messages).
TG_CRED="${MESH_TG_CRED:-$HOME/.config/remote-access/env}"
tg_is_host(){
  [ -n "${MESH_TG_HOST:-}" ] && { [ "$(hostname)" = "$MESH_TG_HOST" ]; return; }
  grep -qs '^[[:space:]]*BOT_TOKEN=[^[:space:]]' "$TG_CRED"
}

# name | ssh-target | role
# name | ssh-target | role — sourced from ~/.mesh/nodes (plantability: no hardcoded IPs).
# Format in nodes file: MESH_NODES="name:user@ip-or-local name2:user2@ip2 ..."
# Roles default to "mind" unless overridden via MESH_ROLES="name:mind name2:sense ..."
NODES_FILE="${MESH_GUARDIAN_NODES_FILE:-$HOME/.mesh/nodes}"
declare -A NODE_ROLES
ROLES_DATA="${MESH_ROLES:-}"
if [ -n "$ROLES_DATA" ]; then
  for r in $ROLES_DATA; do
    rn="${r%%:*}"; rr="${r#*:}"; NODE_ROLES["$rn"]="$rr"
  done
fi
NODE_DATA=""
if [ -f "$NODES_FILE" ]; then
  while IFS='=' read -r k v; do
    case "$k" in MESH_NODES|MESH_NODES_INNER)
      v="${v#\"}"; v="${v%\"}"
      for entry in $v; do
        name="${entry%%:*}"; rest="${entry#*:}"
        [ "$rest" = "local" ] && continue
        role="${NODE_ROLES[$name]:-mind}"
        NODE_DATA+="${name}|${rest}|${role}"$'\n'
      done ;;
  esac
  done < "$NODES_FILE"
fi
if [ -z "$NODE_DATA" ]; then
  note "guardian: no peer nodes in ~/.mesh/nodes — skipping reachability check"
  exit 0
fi

# Parallel reachability check — avoids SEQUENTIAL-SSH-HANG on multiple offline peers
_gt="$(mktemp -d)"
trap 'rm -rf "$_gt"' EXIT
while IFS='|' read -r name tgt role; do
  [ -z "${name:-}" ] && continue
  (
    if S "$tgt" 'echo ok' | grep -q ok; then
      printf 'UP|%s\n' "$role" > "$_gt/$name"
      if [ "$role" = mind ]; then
        out="$(S "$tgt" 'tmux has-session -t "$(hostname)" 2>/dev/null && echo has || { tmux new-session -A -d -s "$(hostname)" && echo recreated; }')"
        printf '%s' "$out" >> "$_gt/$name"
      fi
    else
      printf 'DOWN|%s' "$role" > "$_gt/$name"
    fi
  ) &
done <<< "$NODE_DATA"
wait

while IFS='|' read -r name tgt role; do
  [ -z "${name:-}" ] && continue
  _status="$(head -1 "$_gt/$name" 2>/dev/null || echo 'UNKNOWN|')"
  _state="${_status%%|*}"
  if [ "$_state" = "UP" ]; then
    note "UP $name"
    if [ "$role" = mind ]; then
      _tmux="$(tail -1 "$_gt/$name" 2>/dev/null || echo '')"
      case "$_tmux" in *recreated*) alert "$name had NO tmux session — recreated it (connection substrate restored)";; esac
    fi
  else
    note "DOWN $name ($role) unreachable"
    [ "$role" = mind ] && alert "$name (mind) unreachable — power/network needed"
    [ "$role" = sense ] && note "sense $name down (phone may be asleep)"
  fi
done <<< "$NODE_DATA"
rm -rf "$_gt"; trap - EXIT

# telegram organ: keep EXACTLY one mesh-voice-rx on its host
if tg_is_host; then
  n=$(ps -eo comm,args 2>/dev/null | awk '$1=="python3" && /mesh-voice-rx/' | wc -l)
  note "telegram organ keeper ACTIVE (instances=$n)"   # proves the branch RAN, not just that it exists
  if [ "$n" -eq 0 ]; then
    if [ -n "${MESH_GUARDIAN_TG_DRYRUN:-}" ]; then note "telegram organ would be restarted (dry-run)"
    else setsid python3 "$HOME/.local/bin/mesh-voice-rx" >/dev/null 2>&1 & note "RECOVERED telegram organ (was 0) — restarted"; alert "telegram organ was down — restarted"; fi
  elif [ "$n" -gt 1 ]; then note "telegram organ has $n instances (dup) — leaving to next pass"; fi
else
  # NOT-the-host is a real claim, not a shrug: say WHY, so a node that lost its token (or a bad
  # MESH_TG_HOST) reads as skipped-for-this-reason instead of vanishing into a green pass. This is
  # the branch that was silently taken on every pass for a day.
  note "telegram organ not kept here (no BOT_TOKEN in $TG_CRED${MESH_TG_HOST:+ / MESH_TG_HOST=$MESH_TG_HOST})"
fi
note "guardian pass done"
