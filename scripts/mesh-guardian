#!/usr/bin/env bash
# mesh-guardian — SURVIVAL reflex (reflective node + organ check; from ANY node — location independent).
# Ensures: every node reachable; every MIND node has its hostname-tmux session (the mind's home + the
# connection substrate); the telegram organ (single mesh-voice-rx) is alive. RECOVERS what it can
# (recreate tmux over ssh = channel-messaging, restart the organ), ALERTS what it can't (down mind/sense).
# reflex-cadence: 23 * * * *
set -uo pipefail
if [ "${1:-}" = --test ]; then
  command -v ssh >/dev/null 2>&1 || { echo "smoke-test: FAIL (no ssh)"; exit 1; }
  command -v timeout >/dev/null 2>&1 || { echo "smoke-test: FAIL (no timeout)"; exit 1; }
  mkdir -p "$HOME/.mesh" 2>/dev/null || { echo "smoke-test: FAIL (~/.mesh not writable)"; exit 1; }
  command -v grep >/dev/null 2>&1 || { echo "smoke-test: FAIL (no grep)"; exit 1; }
  command -v mktemp >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mktemp)"; exit 1; }
  # Dry-run: mock unreachable peer → verify parallel path detects DOWN + exits cleanly (no hang)
  _tn="$(mktemp)"
  printf 'MESH_NODES="test-guardian-peer:nonexistent-host-127-0-99-253.local"\nMESH_ROLES="test-guardian-peer:mind"\n' > "$_tn"
  # MESH_GUARDIAN_NO_ALERT=1: exercise the FULL reachability+DOWN path but NEVER send a real
  # Telegram alarm. Without this, every smoke-test (mesh-doctor/fitness/reflex-health all run it)
  # spammed the operator with "🛡 GUARDIAN: test-guardian-peer unreachable" about a FAKE peer —
  # the self-inflicted noise that made the operator distrust the reflexes (2026-06-17).
  # The dry-run gets its OWN log. Writing into the real guardian.log made the smoke test forge the
  # artifact it was supposed to check: doctor runs this every hour at :23, so guardian.log filled with
  # "DOWN test-guardian-peer / guardian pass done" that reads EXACTLY like a live pass — while the real
  # reflex was not in cron at all and had never run here. The log looked alive because the test was
  # talking. A test must never write to the artifact a human reads for liveness.
  _tl="$(mktemp)"
  MESH_GUARDIAN_NO_ALERT=1 MESH_GUARDIAN_LOG="$_tl" MESH_GUARDIAN_NODES_FILE="$_tn" \
    timeout 30 bash "${BASH_SOURCE[0]}" >/dev/null 2>&1 || true
  if ! grep -q 'DOWN test-guardian-peer' "$_tl" 2>/dev/null; then
    rm -f "$_tn" "$_tl"; echo "smoke-test: FAIL (DOWN not logged for test-guardian-peer)" >&2; exit 1
  fi
  rm -f "$_tl"
  # ROLES COME FROM THE FILE, not just the environment. The node LIST is read out of ~/.mesh/nodes by
  # a line parser that matched MESH_NODES only, while the role map was read from $MESH_ROLES in the
  # ENV — so under cron (no env) every file-declared role collapsed to the default 'mind' and each
  # sleeping phone raised an hourly "(mind) unreachable" ALERT. Measured on phaedra: 3333 ALERTs since
  # 2026-06-16, 784 of them for a Redmi declared `sense` in the very file this tool reads. A parser
  # that picks ONE key out of a config file silently ignores the rest of it, and the tool's own header
  # said "overridden via MESH_ROLES" without ever saying "env only" — the docs lied in the same
  # direction as the code. Both directions are gated: file supplies the role, env overrides it.
  _rn="$(mktemp)"
  printf 'MESH_NODES="test-guardian-sense:nonexistent-host-127-0-99-252.local"\nMESH_ROLES="test-guardian-sense:sense"\n' > "$_rn"
  # PARITY WITH _sblog, and the bug that made this comment necessary: _rrun set NO_ALERT/LOG/NODES_FILE
  # but neither MESH_GUARDIAN_TG_DRYRUN nor a mock MESH_TG_CRED, so every invocation below ran the tg
  # leg for real against the node's actual token. An ungated leg standing beside a gated one IS the
  # bug — these legs test MESH_ROLES and have no business touching the telegram organ at all.
  _rc="$(mktemp)"; : > "$_rc"                 # empty cred: no token -> tg_role() is `none` here
  _rsl="$(mktemp)"; : > "$_rsl"               # positive evidence channel for the assertion below
  _rrun(){ local _l; _l="$(mktemp)"
    MESH_GUARDIAN_NO_ALERT=1 MESH_GUARDIAN_TG_DRYRUN=1 MESH_TG_CRED="$_rc" \
      MESH_GUARDIAN_TG_START_LOG="$_rsl" MESH_GUARDIAN_LOG="$_l" MESH_GUARDIAN_NODES_FILE="$_rn" \
      timeout 30 env "$@" bash "${BASH_SOURCE[0]}" >/dev/null 2>&1 || true
    cat "$_l"; rm -f "$_l"; }
  _rout="$(_rrun)"
  case "$_rout" in *"test-guardian-sense (mind) unreachable"*)
    rm -f "$_tn" "$_rn"; echo "smoke-test: FAIL (file MESH_ROLES ignored — sense node alerted as mind)" >&2; exit 1 ;;
  esac
  printf '%s\n' "$_rout" | grep -q 'sense test-guardian-sense down' || {
    rm -f "$_tn" "$_rn"; echo "smoke-test: FAIL (file-declared sense role not applied)" >&2; exit 1; }
  _rout="$(_rrun MESH_ROLES=test-guardian-sense:compute)"
  printf '%s\n' "$_rout" | grep -q 'DOWN test-guardian-sense (compute)' || {
    rm -f "$_tn" "$_rn"; echo "smoke-test: FAIL (env MESH_ROLES did not override the file role)" >&2; exit 1; }
  if printf '%s\n' "$_rout" | grep -q 'ALERT'; then
    rm -f "$_tn" "$_rn"; echo "smoke-test: FAIL (compute node raised a mind ALERT)" >&2; exit 1; fi
  # NO --test LEG MAY REACH A REAL START. Asserted POSITIVELY (a recorded call), not as an absence
  # read off the process table — an ambient `pgrep` would pass on any node that happens to run no
  # poller, which is exactly the reading that made this invisible for hours. Two claims: the role
  # legs must not have touched the organ at all, and where the actuator IS reached under test it must
  # record a refusal rather than spawn.
  if grep -q '^started$' "$_rsl" 2>/dev/null; then
    rm -f "$_tn" "$_rn" "$_rc" "$_rsl"
    echo "smoke-test: FAIL (a --test leg reached a REAL tg_start — this is the hourly rival poller)" >&2; exit 1; fi
  # ...and the stronger form, because the line above can only see a start the START LOG was passed to:
  # a future edit that drops the whole env prefix would take the real cred AND lose the recorder, and
  # the absence would read as clean. These legs test MESH_ROLES, so the ONLY correct tg note here is
  # the not-kept one produced by the empty mock credential. On any node that actually holds a token —
  # i.e. every node where this bug can bite — reverting _rrun's cred flips this to "keeper ACTIVE".
  printf '%s\n' "$_rout" | grep -q 'telegram organ not kept here' || {
    rm -f "$_tn" "$_rn" "$_rc" "$_rsl"
    echo "smoke-test: FAIL (a MESH_ROLES leg read a REAL telegram credential — the tg leg has no business running here)" >&2; exit 1; }
  rm -f "$_rn" "$_rc"
  # tg-organ keeper: assert the predicate DECIDES — both directions. A hardcoded TG_HOST made this
  # branch permanently false and nothing noticed for a day (organ dead 01:28→04:32, log green every
  # hour). Drive it with a mock credential: token present → keeper ACTIVE; absent → keeper skipped
  # with a reason. A gate you have not seen fail is not a gate, so we run the fail direction too.
  # Each direction gets a FRESH log. Greping the shared guardian.log made this gate vacuous in the
  # first draft: the run-before's "keeper ACTIVE" line was still in the tail, so the broken hardcoded
  # predicate passed its own gate. An assertion that can read another run's artifact asserts nothing.
  _tc="$(mktemp)"; _tglog(){ local _l; _l="$(mktemp)"
    MESH_GUARDIAN_NO_ALERT=1 MESH_GUARDIAN_TG_DRYRUN=1 MESH_TG_CRED="$_tc" MESH_GUARDIAN_LOG="$_l" \
      MESH_GUARDIAN_NODES_FILE="$_tn" timeout 30 bash "${BASH_SOURCE[0]}" >/dev/null 2>&1 || true
    cat "$_l"; rm -f "$_l"; }
  printf 'BOT_TOKEN=123:mock\n' > "$_tc"
  _tglog | grep -q 'telegram organ keeper ACTIVE' || {
    rm -f "$_tn" "$_tc"; echo "smoke-test: FAIL (keeper did not fire with BOT_TOKEN present)" >&2; exit 1; }
  # THE ACTUATOR UNDER mesh-doctor's SWEEP. The dry-run legs above never reach tg_start at all, which
  # is exactly why an ungated leg could: `--test` proved the keeper DECIDES, never that it cannot ACT.
  # Drive a full pass with NO dry-run — token present, instances forced to 0, so the primary leg calls
  # tg_start for real — under MESH_TEST_SANDBOX=1, the variable mesh-doctor exports at every child
  # --test site. Assert POSITIVELY on a recorded refusal, not on the absence of a process: an ambient
  # pgrep passes on any node that happens to run no poller, and that reading is what hid the hourly
  # rival for hours. RED before the guard in tg_start: the log reads `started` and a real setsid
  # poller appears.
  printf 'BOT_TOKEN=123:mock\n' > "$_tc"
  _sbl="$(mktemp)"; : > "$_sbl"
  MESH_GUARDIAN_NO_ALERT=1 MESH_TG_CRED="$_tc" MESH_TG_COUNT=0 MESH_TEST_SANDBOX=1 \
    MESH_GUARDIAN_TG_START_LOG="$_sbl" MESH_GUARDIAN_LOG="$(mktemp)" MESH_GUARDIAN_NODES_FILE="$_tn" \
    timeout 30 bash "${BASH_SOURCE[0]}" >/dev/null 2>&1 || true
  grep -q '^started$' "$_sbl" 2>/dev/null && {
    rm -f "$_tn" "$_tc" "$_sbl"
    echo "smoke-test: FAIL (under MESH_TEST_SANDBOX the keeper STARTED a real poller — this is the hourly rival mesh-doctor's sweep raises)" >&2; exit 1; }
  grep -q '^refused$' "$_sbl" 2>/dev/null || {
    rm -f "$_tn" "$_tc" "$_sbl"
    echo "smoke-test: FAIL (tg_start was never reached under sandbox, so nothing was asserted — the gate is vacuous, not passing)" >&2; exit 1; }
  rm -f "$_sbl"
  : > "$_tc"
  _tglog | grep -q 'telegram organ not kept here' || {
    rm -f "$_tn" "$_tc"; echo "smoke-test: FAIL (keeper fired/silent without BOT_TOKEN)" >&2; exit 1; }
  # STANDBY: the leg that keeps a SECOND poller off the token. Every direction is driven, because the
  # cost of each wrong answer is a different flavour of the same 2026-08-18 incident: taking over while
  # the primary polls SPLITS the operator's inbox; refusing while the primary is dark loses it entirely.
  # The probe and the instance count are both injected — a gate that reads whatever this node happens
  # to be running asserts the node, not the code.
  _sn="$(mktemp)"; _ss="$(mktemp)"; _sm="$(mktemp)"; rm -f "$_sm"
  printf 'BOT_TOKEN=123:mock\n' > "$_tc"
  printf 'MESH_NODES="test-guardian-primary:nonexistent-host-127-0-99-251.local"\nMESH_TG_HOST=test-guardian-primary\n' > "$_sn"
  _sfail(){ rm -f "$_tn" "$_tc" "$_sn" "$_ss" "$_sm"; echo "smoke-test: FAIL ($1)" >&2; exit 1; }
  _sblog(){ local _l; _l="$(mktemp)"
    MESH_GUARDIAN_NO_ALERT=1 MESH_GUARDIAN_TG_DRYRUN=1 MESH_TG_CRED="$_tc" MESH_GUARDIAN_LOG="$_l" \
      MESH_GUARDIAN_NODES_FILE="$_sn" MESH_TG_STANDBY_STATE="$_ss" MESH_TG_STANDBY_MARK="$_sm" \
      MESH_TG_PROBE_TRIES=2 MESH_TG_PROBE_GAP=0 MESH_TG_STANDBY_PASSES=2 MESH_TG_COUNT=0 \
      timeout 30 env "$@" bash "${BASH_SOURCE[0]}" --tg-standby >/dev/null 2>&1 || true
    cat "$_l"; rm -f "$_l"; }
  # (a) MESH_TG_HOST out of the FILE decides. This is the regression gate for the actual re-raise:
  #     the env-only parse made a token-holding non-primary act as primary on any cron line that
  #     omitted the prefix, which is how phaedra came back every hour at :23.
  printf '0\n' > "$_ss"; _out="$(_sblog MESH_TG_PROBE_CMD=true)"
  printf '%s\n' "$_out" | grep -q 'STANDBY idle' || _sfail "file MESH_TG_HOST ignored — token holder did not become standby"
  printf '%s\n' "$_out" | grep -q 'keeper ACTIVE (primary' && _sfail "standby node acted as primary"
  printf '%s\n' "$_out" | grep -q 'TAKE OVER' && _sfail "standby took over while the primary was polling"
  # (b) --tg-standby is the leg ALONE: no peer sweep, no pass-done line (that is the hourly reflex).
  printf '%s\n' "$_out" | grep -qE 'DOWN test-guardian|guardian pass done' && _sfail "--tg-standby ran the full pass"
  # (c) failing probes ARM first, take over only after the pass count is reached — and the arming pass
  #     must NOT poll (a single flapping minute on this node's dongle uplink must not split the inbox).
  printf '0\n' > "$_ss"; _out="$(_sblog MESH_TG_PROBE_CMD=false)"
  printf '%s\n' "$_out" | grep -q 'STANDBY armed .*pass 1/2' || _sfail "first failed pass did not arm (got: $(printf '%s' "$_out" | tr '\n' ';'))"
  printf '%s\n' "$_out" | grep -q 'TAKE OVER' && _sfail "took over on the FIRST failed pass"
  _out="$(_sblog MESH_TG_PROBE_CMD=false)"
  printf '%s\n' "$_out" | grep -q 'would TAKE OVER' || _sfail "no takeover after 2 failed passes (got: $(printf '%s' "$_out" | tr '\n' ';'))"
  # (d) a recovered primary STANDS THE STANDBY DOWN — without this the fallback holds the channel for
  #     ever and the split inbox is permanent, just with the nodes swapped.
  printf '4\n' > "$_ss"; printf '999999\n' > "$_sm"
  _out="$(_sblog MESH_TG_PROBE_CMD=true)"
  printf '%s\n' "$_out" | grep -q 'would hand back' || _sfail "standby did not stand down when the primary returned"
  rm -f "$_sm"
  # (e) an unprobeable primary is NOT a dead one: refuse, loudly.
  printf 'MESH_NODES="some-other-node:nonexistent-host-127-0-99-250.local"\nMESH_TG_HOST=test-guardian-primary\n' > "$_sn"
  printf '0\n' > "$_ss"; _out="$(_sblog MESH_TG_PROBE_CMD=false)"
  printf '%s\n' "$_out" | grep -q 'STANDBY BLIND' || _sfail "blind standby did not refuse"
  printf '%s\n' "$_out" | grep -q 'TAKE OVER' && _sfail "took over on an unprobeable primary"
  rm -f "$_tn" "$_tc" "$_sn" "$_ss" "$_sm"
  echo "smoke-test: ok (reachability + DOWN detection; tg-organ primary/standby/none all decided; standby arms, takes over, stands down, refuses blind)"
  exit 0
fi
TG_ONLY=0; [ "${1:-}" = --tg-standby ] && TG_ONLY=1
export PATH="$HOME/.local/bin:$PATH"
LOG="${MESH_GUARDIAN_LOG:-$HOME/.mesh/guardian.log}"; stamp(){ date -u +%FT%TZ; }
note(){ echo "$(stamp) $*" >> "$LOG"; }
alert(){ [ -z "${MESH_GUARDIAN_NO_ALERT:-}" ] && command -v mesh-tg >/dev/null 2>&1 && mesh-tg "🛡 GUARDIAN: $*" >/dev/null 2>&1; note "ALERT: $*"; }
S(){ timeout 14 ssh -n -o BatchMode=yes -o ConnectTimeout=6 $1 "$2" 2>/dev/null; }
# The telegram organ runs where the BOT_TOKEN is — that is the only place it CAN run. A hardcoded
# hostname is a VACUOUS predicate: when the minds migrated IdeaPad→mesh-home (2026-07-14) this test
# went permanently false, the keeper body below never executed once, and the log still wrote a green
# "guardian pass done" every hour while the organ lay dead since 01:28 and the operator's messages
# piled up unread. Derive it from the credential instead, so the check follows the organ; keep an
# explicit MESH_TG_HOST override (~/.mesh/nodes) for a node that holds a token but must not poll
# (two pollers on one token = getUpdates 409, silently eating operator messages).
TG_CRED="${MESH_TG_CRED:-$HOME/.config/remote-access/env}"
# TWO POLLERS ON ONE TOKEN IS NOT A DEGRADED MODE, IT IS A SPLIT INBOX. Telegram answers exactly one
# getUpdates and 409s the other, so each operator message lands in whichever node won that race and is
# INVISIBLE on the other — no line missing, no error on the losing side's board, just a message that
# was never there. Measured 2026-08-18: phaedra carried a SECOND hourly guardian cron line with no
# MESH_TG_HOST in its env, so the token-derived predicate below read "I am the host", it restarted a
# local mesh-voice-rx at :23, and mesh-home's poller logged `Conflict: terminated by other getUpdates
# request` ~800x/hour from 15:23 while three operator messages — one a PDF carrying a real request —
# went only to phaedra's voice-in.log. The OPERATOR noticed before any reflex did.
# Root cause of the re-raise: MESH_TG_HOST, the documented override for exactly this, was read from
# the ENVIRONMENT ONLY, so it lived in one cron line's prefix instead of in the node's config — the
# same env-only-parse bug already paid for once with MESH_ROLES (2026-08-16, see below). A role
# declared in a cron line is not declared: the next line that omits it re-raises the organ.
# So the roles are now explicit, read from ~/.mesh/nodes, and a non-primary is SILENT until the
# primary is demonstrably not polling (operator 2026-08-18: "start tg poller only after 5 failed
# attempts to ssh to mesh-home or something"):
#   primary — declared TG_HOST (or, undeclared, whoever holds the token): keep exactly one poller.
#   standby — holds a token, is not the primary: poll ONLY after the primary fails
#             MESH_TG_PROBE_TRIES probes in a pass AND that pass repeats MESH_TG_STANDBY_PASSES
#             times; stand down (stop OUR poller) the moment the primary answers again.
#   none    — no token here: say which reason, never poll.
# The probe reads the ORGAN, not the host — `pgrep mesh-voice-rx` over ssh — so a primary that is UP
# with a dead poller fails it too; that (not a powered-off node) is the operator's actual pain. The
# pattern is bracketed because the probe string is itself a cmdline on the far side.
# One refusal is deliberate: if the primary has no ssh target in ~/.mesh/nodes we cannot tell DEAD
# from UNPROBEABLE, and a wrong takeover eats the very channel it is meant to rescue — so we refuse
# and say so, rather than treating a blind read as a death certificate.
TG_STANDBY_STATE="${MESH_TG_STANDBY_STATE:-$HOME/.mesh/.tg-standby.state}"
TG_STANDBY_MARK="${MESH_TG_STANDBY_MARK:-$HOME/.mesh/.tg-standby.active}"
tg_have_token(){ grep -qs '^[[:space:]]*BOT_TOKEN=[^[:space:]]' "$TG_CRED"; }
TG_WHY=""
tg_role(){   # primary | standby | none  — TG_HOST is resolved from the nodes file + env below
  if [ -n "${TG_HOST:-}" ]; then
    if [ "$(hostname)" = "$TG_HOST" ]; then
      tg_have_token && { echo primary; return; }
      TG_WHY="TG_HOST=$TG_HOST names this node but there is no BOT_TOKEN in $TG_CRED"; echo none; return
    fi
    tg_have_token && { echo standby; return; }
    TG_WHY="not the declared host (TG_HOST=$TG_HOST) and no BOT_TOKEN in $TG_CRED"; echo none; return
  fi
  tg_have_token && { echo primary; return; }
  TG_WHY="no BOT_TOKEN in $TG_CRED"; echo none
}
# MESH_TG_COUNT is a TEST seam, not a tuning knob: the standby decision must be gated deterministically
# on a node that may itself be running a real poller (the primary runs this same --test hourly), and an
# ambient instance count would make the takeover gate pass or fail by accident.
tg_count(){ [ -n "${MESH_TG_COUNT:-}" ] && { printf '%s' "$MESH_TG_COUNT"; return; }
  ps -eo comm,args 2>/dev/null | awk '$1=="python3" && /mesh-voice-rx/' | wc -l; }
# THE ACTUATOR ITSELF REFUSES UNDER TEST, because gating every LEG is a promise no future edit keeps.
# 2026-08-21: mesh-doctor's hourly `--cron` smoke sweep runs `mesh-guardian --test`, whose _rrun helper
# ran the FULL production pass with the real credential and no dry-run gate (its sibling _sblog set
# both). Its temp nodes file declares no MESH_TG_HOST, so tg_role() fell to `tg_have_token && primary`
# — an undeclared host defaulting to claiming to BE the host — and this line then setsid'd a REAL
# poller on phaedra at :25 every hour. Telegram allows one getUpdates per token, so that poller won
# the race and the operator's voice notes landed on a node with no whisper stack, written there as
# "[voice: empty transcript]". Unattributable for hours: setsid erases the parent, the test's notes
# went to a temp MESH_GUARDIAN_LOG so guardian.log stayed silent, and no cron line, timer or unit
# named guardian — doctor's cron was the trigger.
# _rrun is fixed below, but a leg-by-leg promise is exactly what failed here, so the refusal lives at
# the one place every leg must pass through. MESH_TEST_SANDBOX is exported by mesh-doctor's sweep at
# every child --test site, so this closes the caller that actually did it, not just this tool's own
# suite. The refusal is RECORDED, never silent: a start that did not happen must be as legible as one
# that did, or the next reader cannot tell the guard from a dead branch.
tg_start(){
  if [ -n "${MESH_GUARDIAN_TG_DRYRUN:-}" ] || [ -n "${MESH_TEST_SANDBOX:-}" ]; then
    note "telegram organ start REFUSED — running under test (dryrun=${MESH_GUARDIAN_TG_DRYRUN:-0} sandbox=${MESH_TEST_SANDBOX:-0})"
    [ -n "${MESH_GUARDIAN_TG_START_LOG:-}" ] && printf 'refused\n' >> "$MESH_GUARDIAN_TG_START_LOG"
    return 0
  fi
  [ -n "${MESH_GUARDIAN_TG_START_LOG:-}" ] && printf 'started\n' >> "$MESH_GUARDIAN_TG_START_LOG"
  setsid python3 "$HOME/.local/bin/mesh-voice-rx" >/dev/null 2>&1 &
}
tg_probe(){  # rc 0 = the primary IS polling. $1 = ssh target
  if [ -n "${MESH_TG_PROBE_CMD:-}" ]; then eval "$MESH_TG_PROBE_CMD"; return; fi
  local n; n="$(S "$1" 'pgrep -c -f "[m]esh-voice-rx" 2>/dev/null || echo 0')"
  n="${n//[^0-9]/}"; [ -n "$n" ] && [ "$n" -ge 1 ]
}
tg_standby(){
  local tries="${MESH_TG_PROBE_TRIES:-5}" gap="${MESH_TG_PROBE_GAP:-5}" need="${MESH_TG_STANDBY_PASSES:-2}"
  local tgt i ok=1 fails n pid newpid
  tgt="$(printf '%s\n' "$NODE_DATA" | awk -F'|' -v h="$TG_HOST" '$1==h{print $2; exit}')"
  if [ -z "$tgt" ]; then
    note "telegram organ STANDBY BLIND — primary '$TG_HOST' has no ssh target in $NODES_FILE; refusing takeover (unprobeable is not dead)"
    return
  fi
  for ((i=1;i<=tries;i++)); do
    if tg_probe "$tgt"; then ok=0; break; fi
    [ "$i" -lt "$tries" ] && [ "$gap" != 0 ] && sleep "$gap"
  done
  n="$(tg_count)"
  if [ "$ok" -eq 0 ]; then
    printf '0\n' > "$TG_STANDBY_STATE"
    if [ -s "$TG_STANDBY_MARK" ]; then
      pid="$(head -1 "$TG_STANDBY_MARK" 2>/dev/null)"; pid="${pid//[^0-9]/}"
      if [ -n "${MESH_GUARDIAN_TG_DRYRUN:-}" ]; then
        note "telegram organ STANDBY would hand back to $TG_HOST (dry-run, our pid=$pid)"; return
      fi
      if [ -n "$pid" ] && grep -qs 'mesh-voice-rx' "/proc/$pid/cmdline"; then kill "$pid" 2>/dev/null; fi
      rm -f "$TG_STANDBY_MARK"
      note "telegram organ STANDBY handed back to $TG_HOST (stopped our poller pid=$pid)"
      alert "telegram organ: $TG_HOST is polling again — standby $(hostname) stood down"
    else
      note "telegram organ STANDBY idle — $TG_HOST is polling (probe ok, local instances=$n)"
    fi
    return
  fi
  fails="$(head -1 "$TG_STANDBY_STATE" 2>/dev/null || echo 0)"; fails="${fails//[^0-9]/}"; : "${fails:=0}"
  fails=$((fails+1)); printf '%s\n' "$fails" > "$TG_STANDBY_STATE"
  if [ "$fails" -lt "$need" ]; then
    note "telegram organ STANDBY armed — $TG_HOST failed $tries probe(s) (pass $fails/$need) — not taking over yet"
    return
  fi
  if [ "$n" -gt 0 ]; then
    note "telegram organ STANDBY already polling ($n instance(s)) while $TG_HOST is dark"; return
  fi
  if [ -n "${MESH_GUARDIAN_TG_DRYRUN:-}" ]; then
    note "telegram organ STANDBY would TAKE OVER (dry-run, $tries probe(s) x $fails/$need passes failed)"; return
  fi
  tg_start; sleep 1
  newpid="$(pgrep -f '[m]esh-voice-rx' 2>/dev/null | head -1)"
  printf '%s\n' "${newpid:-}" > "$TG_STANDBY_MARK"
  note "telegram organ STANDBY TOOK OVER — $TG_HOST failed $tries probe(s) x $fails passes; poller pid=${newpid:-unknown}"
  alert "telegram organ: $TG_HOST not polling ($tries probes x $fails passes) — standby $(hostname) TOOK OVER the channel"
}
tg_leg(){
  local role n; role="$(tg_role)"
  case "$role" in
    primary)
      n="$(tg_count)"
      note "telegram organ keeper ACTIVE (primary, instances=$n)"   # proves the branch RAN, not just that it exists
      if [ "$n" -eq 0 ]; then
        if [ -n "${MESH_GUARDIAN_TG_DRYRUN:-}" ]; then note "telegram organ would be restarted (dry-run)"
        else tg_start; note "RECOVERED telegram organ (was 0) — restarted"; alert "telegram organ was down — restarted"; fi
      elif [ "$n" -gt 1 ]; then note "telegram organ has $n instances (dup) — leaving to next pass"; fi
      ;;
    standby) tg_standby ;;
    # NOT-the-host is a real claim, not a shrug: say WHY, so a node that lost its token (or a bad
    # MESH_TG_HOST) reads as skipped-for-this-reason instead of vanishing into a green pass. This is
    # the branch that was silently taken on every pass for a day.
    *) note "telegram organ not kept here ($TG_WHY)" ;;
  esac
}

# name | ssh-target | role
# name | ssh-target | role — sourced from ~/.mesh/nodes (plantability: no hardcoded IPs).
# Format in nodes file: MESH_NODES="name:user@ip-or-local name2:user2@ip2 ..."
#                       MESH_ROLES="name:mind name2:sense ..."   (same file, same parser)
# ROLE PRECEDENCE, in order, last wins: default "mind" < MESH_ROLES in the NODES FILE < $MESH_ROLES
# in the ENVIRONMENT (an operator/cron-line override on top of the declared topology). The file is
# the normal place to declare a role; the env is for a one-off. Until 2026-08-16 the env was the
# ONLY source — the file's own MESH_ROLES line was parsed by nobody here — so every cron run (which
# has no env) read every node as "mind" and alarmed on sleeping phones. Both edges are gated in
# --test; do not narrow this to one source again.
NODES_FILE="${MESH_GUARDIAN_NODES_FILE:-$HOME/.mesh/nodes}"
declare -A NODE_ROLES
# A token with no ':' (rn == rr) is not a role assignment — skip it rather than setting role=<name>.
roles_add(){ local r rn rr; for r in $1; do rn="${r%%:*}"; rr="${r#*:}"
  [ -n "$rn" ] && [ "$rn" != "$r" ] && [ -n "$rr" ] && NODE_ROLES["$rn"]="$rr"; done; }
# Values in the nodes file are `KEY="a b c"   # trailing comment` — take what is inside the quotes,
# not up to the LAST quote on the line (the real MESH_ROLES line carries a commented rationale).
unquote(){ local v="$1"; v="${v#"${v%%[![:space:]]*}"}"
  case "$v" in \"*) v="${v#\"}"; v="${v%%\"*}" ;; *) v="${v%%#*}" ;; esac; printf '%s' "$v"; }
NODE_DATA=""; _nodes_raw=""; _roles_file=""; _tg_host_file=""
if [ -f "$NODES_FILE" ]; then
  while IFS='=' read -r k v; do
    k="${k#"${k%%[![:space:]]*}"}"
    case "$k" in
      MESH_NODES|MESH_NODES_INNER) _nodes_raw+=" $(unquote "$v")" ;;
      MESH_ROLES)                  _roles_file+=" $(unquote "$v")" ;;
      MESH_TG_HOST)                _tg_host_file="$(unquote "$v")" ;;
    esac
  done < "$NODES_FILE"
fi
# Same precedence as the roles above, same reason: the FILE is where a node declares which host owns
# the telegram token; the env is a one-off override. Env-only was the re-raise path (see tg_role).
TG_HOST="${MESH_TG_HOST:-${_tg_host_file:-}}"
roles_add "$_roles_file"          # declared topology
roles_add "${MESH_ROLES:-}"       # env override on top
for entry in $_nodes_raw; do
  name="${entry%%:*}"; rest="${entry#*:}"
  [ "$rest" = "local" ] && continue
  role="${NODE_ROLES[$name]:-mind}"
  NODE_DATA+="${name}|${rest}|${role}"$'\n'
done
# --tg-standby: the telegram leg ALONE, so a standby node can run it on a cadence that actually
# rescues the channel. The full pass is an hourly ssh sweep of every peer; at that cadence a standby
# takeover lands hours after the operator's message went nowhere, which is not a rescue. This mode
# does one probe burst and exits.
if [ "${TG_ONLY:-0}" = 1 ]; then tg_leg; exit 0; fi
if [ -z "$NODE_DATA" ]; then
  # The organ keeper used to sit BELOW this early exit: a node with no peers declared kept its own
  # telegram organ never, while logging a green pass. Keep the leg, then leave.
  tg_leg
  note "guardian: no peer nodes in ~/.mesh/nodes — skipping reachability check"
  exit 0
fi

# Parallel reachability check — avoids SEQUENTIAL-SSH-HANG on multiple offline peers
_gt="$(mktemp -d)"
trap 'rm -rf "$_gt"' EXIT
while IFS='|' read -r name tgt role; do
  [ -z "${name:-}" ] && continue
  (
    if S "$tgt" 'echo ok' | grep -q ok; then
      printf 'UP|%s\n' "$role" > "$_gt/$name"
      if [ "$role" = mind ]; then
        out="$(S "$tgt" 'tmux has-session -t "$(hostname)" 2>/dev/null && echo has || { tmux new-session -A -d -s "$(hostname)" && echo recreated; }')"
        printf '%s' "$out" >> "$_gt/$name"
      fi
    else
      printf 'DOWN|%s' "$role" > "$_gt/$name"
    fi
  ) &
done <<< "$NODE_DATA"
wait

while IFS='|' read -r name tgt role; do
  [ -z "${name:-}" ] && continue
  _status="$(head -1 "$_gt/$name" 2>/dev/null || echo 'UNKNOWN|')"
  _state="${_status%%|*}"
  if [ "$_state" = "UP" ]; then
    note "UP $name"
    if [ "$role" = mind ]; then
      _tmux="$(tail -1 "$_gt/$name" 2>/dev/null || echo '')"
      case "$_tmux" in *recreated*) alert "$name had NO tmux session — recreated it (connection substrate restored)";; esac
    fi
  else
    note "DOWN $name ($role) unreachable"
    [ "$role" = mind ] && alert "$name (mind) unreachable — power/network needed"
    [ "$role" = sense ] && note "sense $name down (phone may be asleep)"
  fi
done <<< "$NODE_DATA"
rm -rf "$_gt"; trap - EXIT

# telegram organ: keep EXACTLY one mesh-voice-rx on the token's host (primary/standby/none — tg_leg)
tg_leg
note "guardian pass done"
