#!/usr/bin/env bash
# mesh-morning — the steward's morning round-up. Each node writes its OWN report (mesh-report);
# this collects every node's one-line pointer and tells the operator (Telegram) WHERE to look +
# each node's headline. $0. The operator reads ONE message; the full report lives on each node.
#   mesh-morning          print the round-up
#   mesh-morning --send   also send to operator Telegram (via mesh-tg)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
# node list: "label target"  (target=local or user@host)
NODES=(
  "IdeaPad local"
  "default-string imozerov@100.125.157.75"
  "ilya ilya@100.107.198.111"
)
DAY="$(date -u +%Y-%m-%d)"; F="$(mktemp)"
{
  echo "☀️ Доброе утро — отчёты нод $DAY (UTC)"
  echo "каждая нода написала свой отчёт сама; вот где смотреть:"
  echo
  for entry in "${NODES[@]}"; do
    label="${entry%% *}"; tgt="${entry##* }"
    # trigger a fresh report, then read the pointer (so timing/TZ never matters)
    if [ "$tgt" = local ]; then
      mesh-report >/dev/null 2>&1; ptr="$(cat "$HOME/.mesh/report-latest.txt" 2>/dev/null)"
    else
      timeout 50 ssh -o StrictHostKeyChecking=accept-new -o BatchMode=yes -o ConnectTimeout=8 "$tgt" \
        'PATH=$HOME/.local/bin:$PATH mesh-report >/dev/null 2>&1; cat ~/.mesh/report-latest.txt' 2>/dev/null > "$F.n" && ptr="$(cat "$F.n")" || ptr=""
    fi
    if [ -n "$ptr" ]; then echo "• $ptr"; else echo "• $label: (нет отчёта / нода недоступна)"; fi
  done
  rm -f "$F.n"
  echo
  echo "полный отчёт ноды:  ssh <нода> 'cat ~/.mesh/reports/$DAY.md'   (или открой файл на ноде)"
  echo "живой план/верификация:  ~/.mesh/PLAN.md  ·  свежий аудит:  mesh-verify"
} > "$F"
cat "$F"
if [ "${1:-}" = "--send" ]; then
  if command -v mesh-tg >/dev/null 2>&1; then mesh-tg "$(cat "$F")" >/dev/null && echo "[sent to operator Telegram]"; else echo "[mesh-tg not found]"; fi
fi
rm -f "$F"
