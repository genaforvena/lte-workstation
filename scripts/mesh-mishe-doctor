#!/usr/bin/env bash
# Read-only synthetic shadow health. Explicitly reports disabled real authority.
set -euo pipefail
core="${MESH_MISHE_CORE:-}"
home="${MESH_MISHE_HOME:-$HOME/.mesh/mishe-tauftauf}"
python="${MESH_MISHE_PYTHON:-}"
if [ -z "$python" ]; then
  if [ -x "$HOME/.mesh/venvs/mishe-tauftauf/bin/python" ]; then
    python="$HOME/.mesh/venvs/mishe-tauftauf/bin/python"
  else
    python=python3
  fi
fi
if [ ! -f "$home/feed" ]; then
  echo 'mishe synthetic: DISABLED (no initialized feed); authority=legacy'
  exit 0
fi
command -v "$python" >/dev/null 2>&1 || { echo 'mishe synthetic: UNKNOWN (Python interpreter absent); authority=legacy'; exit 1; }
if [ -n "$core" ]; then
  [ -f "$core/src/mishe_tauftauf/__main__.py" ] || { echo 'mishe synthetic: UNKNOWN (core source absent); authority=legacy'; exit 1; }
  export PYTHONPATH="$core/src${PYTHONPATH:+:$PYTHONPATH}"
fi
[ -x "$home/top-pains/synthetic" ] && [ -x "$home/projectors/synthetic" ] || {
  echo 'mishe synthetic: UNKNOWN (renderer/projector absent); authority=legacy'
  exit 1
}
out="$("$python" -m mishe_tauftauf --home "$home" doctor 2>&1)" || {
  echo 'mishe synthetic: UNKNOWN (core doctor failed); authority=legacy'
  exit 1
}
age="$("$python" - "$home" "${MESH_MISHE_MAX_AGE:-300}" <<'PY'
from pathlib import Path
import sys
import time
from mishe_tauftauf.feed import Feed

home = Path(sys.argv[1])
entries = [entry for entry in Feed(home).entries() if entry.source == "observation/synthetic"]
if not entries:
    print("no observation yet")
    raise SystemExit(1)
if "UNKNOWN" in entries[-1].body:
    print("latest observation UNKNOWN")
    raise SystemExit(1)
if (home / "top-pains" / "cleaner").exists():
    cleaner = [entry for entry in Feed(home).entries() if entry.source == "observation/cleaner"]
    if not cleaner:
        print("cleaner shadow has no observation")
        raise SystemExit(1)
    if "UNKNOWN" in cleaner[-1].body:
        print("cleaner shadow observation UNKNOWN")
        raise SystemExit(1)
try:
    max_age = int(sys.argv[2])
    if max_age < 0:
        raise ValueError
    last_pass = float((home / ".mesh-mishe-pass").read_text(encoding="ascii").strip())
except (ValueError, OSError, UnicodeError):
    print("successful pass missing or invalid")
    raise SystemExit(1)
if time.time() - last_pass > max_age:
    print("stale successful pass")
    raise SystemExit(1)
if last_pass > time.time() + 5:
    print("successful pass timestamp is in the future")
    raise SystemExit(1)
print("fresh")
PY
)" || {
  echo "mishe synthetic: UNKNOWN ($age); authority=legacy"
  exit 1
}
if [ -x "$home/top-pains/cleaner" ]; then
  parity="$("$python" "${MESH_REPO:-$HOME/lte-workstation}/scripts/mesh-mishe-parity")" || {
    printf '%s\n' "$parity"
    exit 1
  }
  printf '%s\n' "$parity"
  echo 'mishe synthetic: observed; cleaner=shadow; authority=legacy'
else
  echo 'mishe synthetic: observed; authority=legacy; real-channels=disabled'
fi
