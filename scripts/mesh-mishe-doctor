#!/usr/bin/env bash
# Read-only synthetic shadow health. Explicitly reports disabled real authority.
set -euo pipefail
core="${MESH_MISHE_CORE:-$HOME/mishe-tauftauf}"
home="${MESH_MISHE_HOME:-$HOME/.mesh/mishe-tauftauf}"
if [ ! -f "$home/feed" ]; then
  echo 'mishe synthetic: DISABLED (no initialized feed); authority=legacy'
  exit 0
fi
[ -f "$core/src/mishe_tauftauf/__main__.py" ] || { echo 'mishe synthetic: UNKNOWN (core absent); authority=legacy'; exit 1; }
[ -x "$home/top-pains/synthetic" ] && [ -x "$home/projectors/synthetic" ] || {
  echo 'mishe synthetic: UNKNOWN (renderer/projector absent); authority=legacy'
  exit 1
}
export PYTHONPATH="$core/src${PYTHONPATH:+:$PYTHONPATH}"
out="$(python3 -m mishe_tauftauf --home "$home" doctor 2>&1)" || {
  echo 'mishe synthetic: UNKNOWN (core doctor failed); authority=legacy'
  exit 1
}
if grep -Eq 'UNKNOWN — event projector synthetic|UNKNOWN event filter synthetic' "$home/feed"; then
  echo 'mishe synthetic: UNKNOWN (projector/filter failure); authority=legacy'
  exit 1
fi
age="$(python3 - "$home" "${MESH_MISHE_MAX_AGE:-300}" <<'PY'
from datetime import datetime, timezone
from pathlib import Path
import sys
from mishe_tauftauf.feed import Feed

entries = [entry for entry in Feed(Path(sys.argv[1])).entries() if entry.source == "observation/synthetic"]
if not entries:
    print("no observation yet")
    raise SystemExit(1)
try:
    max_age = int(sys.argv[2])
    if max_age < 0:
        raise ValueError
except ValueError:
    print("invalid max age")
    raise SystemExit(1)
timestamp = datetime.fromisoformat(entries[-1].timestamp.replace("Z", "+00:00"))
elapsed = (datetime.now(timezone.utc) - timestamp).total_seconds()
if elapsed > max_age:
    print("stale observation")
    raise SystemExit(1)
print("fresh")
PY
)" || {
  echo "mishe synthetic: UNKNOWN ($age); authority=legacy"
  exit 1
}
echo 'mishe synthetic: observed; authority=legacy; real-channels=disabled'
