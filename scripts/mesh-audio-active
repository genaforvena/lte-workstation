#!/usr/bin/env bash
# orphan-ok: on-demand activity-probe, mind/fusion-invoked LIVE (LIVE-ONLY class like keypresence/
#   body-context — reads an INSTANTANEOUS state, no per-run cache to schedule).
# mesh-audio-active — is sound ACTIVELY PLAYING out of THIS node's speakers right now?
#
# WHY this is a NEW, distinct sense (not covered by the existing perception set):
#   - mesh-audio reports CAPABILITY (how many capture/playback devices, audio-group, cards) — a
#     STATIC inventory. This reports live STATE: is a playback stream RUNNING this instant. It is the
#     OUTPUT-side counterpart to the mic senses (overhear/room/transcribe): not "what the node HEARS"
#     but "what the node is EMITTING". Media coming out of the speakers = activity at this node.
#   - HONEST scope (the appliance-vs-person rule): PLAYING asserts a playback stream is active
#     (media / a tone), NOT that a human is present — a scheduled tone plays to an empty room. So it
#     is an ACTIVITY signal only and NEVER a presence claim; it deliberately does not fall into the
#     appliance-vs-person trap because it claims no person. A fusion may combine it with a
#     person-specific sense (keypresence / personal-BLE), but on its own it stays agnostic.
#
# REAFFERENCE vs EXAFFERENCE (efference-copy cancellation, sense-enrichment 2026-07-10):
#   Lit basis — the 4E/enactive & motor-neuroscience distinction: the nervous system must separate
#   sensory input its OWN action caused (REAFFERENCE) from input the external world caused
#   (EXAFFERENCE), by predicting the self-effect from a copy of the motor command (the "efference
#   copy") and subtracting it — isolating exafference for attention. (Efference copy, Wikipedia;
#   Straka/Simmons/Chagnaud, "Predictive Sensing: The Role of Motor Signals in Sensory Processing",
#   PMC6733654, 2019; the sensorimotor-contingency / attunement framing, arXiv:2510.14227, 2025.)
#   THE GAP THIS CLOSES: a bare RUNNING substream cannot tell "a human started a video" (exafference
#   — the REAL activity signal) from "the mesh played its OWN drone/metronome/TTS/room-music tone"
#   (reafference — self-caused, NOT external activity). The mesh's acoustic MIC senses already cancel
#   this (mesh-soundscape/overhear/mic-correlate drain on the `mesh-speaking` flag), but the
#   OUTPUT-side sense never did. The efference copy is already emitted by every audio actuator — the
#   `$MESH/mesh-speaking` flag (mesh-voice-tx) + a live player process (pw-play/aplay/paplay) — so we
#   subtract it here: PLAYING now carries an additive `source=self|external` field. source=self =
#   reafference (the node IS emitting, but it's the mesh's own output, not activity); source=external
#   = exafference (a genuine outside stream — media/a person). ADDITIVE + vocab-safe: the first token
#   stays PLAYING|SILENT so `*PLAYING*` consumers (mesh-audio-mode, mesh-room-sense) are untouched; a
#   fusion that wants the cancelled signal reads `source=`. (Fixes the mesh-room-sense mis-read that
#   treats ALL audio-active PLAYING as self-playback contamination — a human watching a video is
#   exafference and SHOULD count as presence, not be discounted.)
#
# THE SHADOW CONTROL — a level is not a confirmation (lit-4E live review 2026-08-26, genome).
#   Auvray, Lenay & Stewart's PERCEPTUAL CROSSING paradigm (New Ideas in Psychology 27(1):32-47, 2009;
#   live restatements: Froese, Iizuka & Ikegami, Sci.Rep. 3:3672 doi:10.1038/srep03672; Deschamps,
#   Lenay et al., Front.Psychol. 7:1059 doi:10.3389/fpsyg.2016.01059; open-source rig PMC11164400)
#   puts THREE objects in the sensory field: a static DECOY, the partner's AVATAR, and the avatar's
#   SHADOW — an object dragged along the avatar's EXACT trajectory that does NOT sense you back. The
#   static decoy is trivially discriminated; the shadow is not, because at every instant it delivers
#   the IDENTICAL sensory signature as the real partner. What separates them is not the signal but its
#   CONTINGENCY ON YOUR OWN ACTION. That is the field's own answer to "how do you test a coupling
#   claim": the negative arm must match the positive arm in every measured property EXCEPT reciprocity.
#
#   `--confirm` (2026-07-30, below) landed the confirmatory half of sensorimotor mastery but proved it
#   against the STATIC DECOY only: `confirm_of` split on the mic CLASS, so SILENCE→unheard and any of
#   QUIET|MODERATE|LOUD→heard. The room's own floor IS the shadow. Measured on this node's live tape
#   (`~/.mesh/ambient-db-tape.tsv`, 16870 clean rows 2026-07-14..2026-08-26) the ambient sits at a p20
#   floor of -46.8 dBFS with ordinary samples riding +1.7 dB (p50) above it — every one of those reads
#   QUIET or louder. So an occupied room, a fan, the operator's iMac or an open window mints
#   `confirm=heard` for a stone-dead sink, which is precisely the fault class this axis exists to catch
#   ([[bose-usb-sink-is-not-speaker-sounds]], [[mesh-home-audio-stack-down-note3-ear]]).
#
#   The fix is the paradigm's own discriminator, in dB: require a LIFT above the room's own floor, not
#   a level. floor = p20 of the trailing 6h of the ambient tape (per-window, never a constant — the p20
#   has sd 15.6 dB across this node's 111 six-hour windows); lift = current rms_db - floor; the default
#   threshold 5.0 dB IS the corpus's own p75 lift, so only the quarter of ambient samples that already
#   ride highest could clear it unaided. Re-derive the claim, never quote it:
#     python3 - <<'X'  # p20 floor per 6h window + the lift distribution above it
#     import statistics as st, datetime as dt, collections
#     rows=[]
#     for l in open('~/.mesh/ambient-db-tape.tsv'.replace('~',__import__('os').path.expanduser('~')),'rb'):
#         l=l.replace(b'\x00',b'').decode('utf-8','replace')
#         if l.startswith('#'): continue
#         f=l.rstrip().split('\t')
#         if len(f)<2: continue
#         try: rows.append((dt.datetime.fromisoformat(f[0].replace('Z','+00:00')).timestamp(),float(f[1])))
#         except Exception: pass
#     b=collections.defaultdict(list)
#     for t,db in rows: b[int(t//21600)].append(db)
#     lifts=[]
#     for v in b.values():
#         if len(v)>=30: fl=st.quantiles(v,n=100)[19]; lifts+=[x-fl for x in v]
#     lifts.sort(); print('p50 %+.1f p75 %+.1f p90 %+.1f'%tuple(lifts[int(len(lifts)*q)] for q in (.5,.75,.9)))
#     X
#
#   NEW VERDICT WORD `shadowed`, and it is safe to mint here: `confirm=` has NO consumer in the genome
#   (`grep -rn 'confirm=' scripts/` finds only test-chaos-drill's unrelated variable; mesh-room-sense
#   parses `source=`, not `confirm=`) — so this cannot break a reader's alphabet
#   ([[a-new-verdict-word-must-be-in-the-consumers-alphabet]]). It only ever appears where the old code
#   said `heard`, and it WEAKENS that claim; it never converts a `heard` into an alarm. When the floor
#   is UNKNOWN (no tape / <30 rows in window / newest row older than 900s) the verdict is the old one
#   verbatim — absent evidence must not mint a new word ([[na-must-be-a-claim-about-the-node]]).
#   The floor is a LOW QUANTILE on purpose: the tape records whatever is sounding, our own playback
#   included, so a median would drift toward our own output and erase the very lift it is measuring.
#   Report-only, like the axis it extends; env: MESH_AUDIO_ACTIVE_LIFT_DB / _FLOOR_WIN_S / _FLOOR_MIN_N
#   / _FLOOR_MAX_AGE_S / _TAPE, and _FLOOR / _MIC_DB inject the two reads for `--test`.
#
# REAFFERENCE CONFIRMATION — loop-closure (`--confirm`; lit-4E live review 2026-07-30, angle: a
#   foundational idea applied TOO LOOSELY):
#   The reafference block above uses the efference copy in ONLY ONE direction — SUBTRACT it, so our
#   own sound doesn't masquerade as activity. But von Holst & Mittelstaedt's reafference principle
#   (1950) and sensorimotor-contingency MASTERY (O'Regan & Noë 2001; the sensorimotor-approach review
#   arXiv:2510.14227, 2025; enactive AI arXiv:2605.24238, 2026) are constitutively about a PREDICTION
#   THAT MUST BE CONFIRMED: the efference copy predicts a sensory consequence, and mastery = that
#   consequence actually arrives. The other half of "subtract your own sound" is "…and if your own
#   predicted sound is MISSING, your actuator is hollow." We never used it. Worse, this tool trusts
#   `state: RUNNING` — the kernel's record that the mesh COMMANDED playback (the efference copy
#   itself), NOT proof sound left the speaker. mesh-sink-health closes the loop for exactly ONE fault
#   (the PipeWire broken-pipe wedge) by LOG SIGNATURE and EXPLICITLY refuses acoustic confirmation
#   ("never by absence-of-sound"); so a muted / disconnected / misrouted / zero-volume speaker leaves
#   the substream RUNNING, emits no wedge log, and reads PLAYING source=self here + HEALTHY there while
#   the room is dead silent — nobody checks. THE MECHANISM (`--confirm`, report-only): when a
#   source=self stream is RUNNING, sample the room mic (reuse mesh-ambient-level) and CLOSE THE LOOP —
#     confirm=heard    the predicted reafference arrived (mic QUIET/MODERATE/LOUD) → actuator VERIFIED
#     confirm=unheard  sink RUNNING yet the room is SILENT → HOLLOW actuator (the silent-speaker fault
#                      class the log-signature check is blind to; a working speaker mid-TTS is NEVER dead-silent)
#     confirm=n/a      not self-emitting, nothing running, or mic unreachable (nothing to / can't confirm — honest)
#   Report-only (no heal/kill/post — silence is normal, so unheard is a FLAG for a human eye, never an
#   auto-action; respects mesh-sink-health's never-touch-a-working-sink rule). This is the mesh's own
#   Verification Principle in acoustic form: "PLAYING" is a claim; "the mic heard it" is the artifact.
#
# COROLLARY-DISCHARGE TIMING — the hub, not the pathway (`--cd`; lit predictive-processing live review
#   2026-08-14, angle: cross-domain transfer):
#   Jarzyna & Carlson, "Developmental and evolutionary changes in sensorimotor integration to maintain
#   coordination of corollary discharge and afferent input in electric fish", *Current Biology*, 11 Jun
#   2026, doi:10.1016/j.cub.2026.04.068. Recording every stage of the corollary-discharge pathway WITHIN
#   individual mormyrids, they show the cancellation signal is not merely present-or-absent: it must stay
#   TEMPORALLY COORDINATED with a self-signal whose duration keeps changing (hormonally over days,
#   developmentally, evolutionarily across species) — and that hormonal, developmental AND evolutionary
#   retimings ALL first appear at ONE structure, the mesencephalic command-associated nucleus (MCA),
#   which branches to the three downstream pathways. One hub is recalibrated; the pathways inherit it.
#   Fail to retime and self-generated signal swamps the sense, so external input cannot be detected.
#   THE TRANSFER: `$MESH/mesh-speaking` IS this mesh's corollary discharge — one hub mark, read by the
#   room ear (mesh-overhear capture loop + _self_playing + _self_emitting_now), mesh-soundscape,
#   mesh-room-music, mesh-tuner/metronome/changes (MUTE_FLAG) and by self_emitting() here. But the mesh
#   recalibrated at the PATHWAY, not the hub: mesh-note3-say (2026-07-14) learned the hard way that a
#   bare touch/rm cannot span a duration — two overlapping speaks let the shorter one's release unmute
#   the mic over the longer one's voice, and the room transcribed the mesh's OWN speech as the operator's
#   — and fixed it by writing a DEADLINE EPOCH into the mark, extended monotonically. That fix never
#   reached the hub: mesh-say (EXIT-trap `rm -f`), mesh-voice-tx (`touch` … `rm -f`) and mesh-overhear's
#   pwplay path still write the EMPTY touch-dialect and delete unconditionally, so one pathway's release
#   still cancels another's live corollary discharge. And the READERS diverge on the same mark:
#   _self_emitting_now honours the deadline and fails OPEN on a stale mark, while the capture loop and
#   _self_playing test bare `os.path.exists` — one mark, two answers (this file was a third: a bare
#   `[ -f ]`, so a leaked mark pinned source=self forever and masked genuine EXAFFERENCE from
#   mesh-room-sense's presence fusion; fixed below by reading the mark through cd_mark()).
#   THE MECHANISM (`--cd`, report-only): ONE canonical reading of the mark (cd_mark: deadline dialect →
#   held|expired · touch dialect → held|stale by mtime vs MESH_SELF_EMIT_STALE, the same env knob
#   mesh-overhear uses) crossed with the local emission evidence (a player process) →
#     cd=aligned    mark held while a player emits — self-sound is cancelled at the ear (coordinated)
#     cd=uncovered  a player is emitting with NO live mark — the ear is LIVE on our own voice
#                   (self-transcription → the false-wake class), the fish's "swamped by self" fault
#     cd=overhang   mark held with no local emission — legitimate for a remote/other-body speaker
#                   (voice-tx plays on the Bose node, note3-say over adb), or a writer over-holding
#     cd=expired    deadline passed, reaper has not removed the mark — the READER DIVERGENCE is live:
#                   deadline-aware readers fail open, bare-exists readers stay DEAF
#     cd=stale      touch-dialect mark older than the stale window — same divergence
#     cd=n/a        nothing emitting, no mark
#   Report-only (no write, no reap): the mark is shared substrate and a wrong release makes the mesh
#   transcribe itself, a wrong hold makes it deaf. This axis MEASURES the coordination; the hub fix
#   (one hold/release primitive with monotone-max deadline semantics, migrating mesh-say / mesh-voice-tx /
#   mesh-overhear off last-writer-wins) is the proposal it is evidence for.
#
# SOURCE: /proc/asound/card*/pcm*p/sub*/status — the kernel ALSA playback substream state. A line
#   "state: RUNNING" => that substream is actively playing; an idle substream's file is just "closed".
#   World-readable, no root, no `audio` group, no SSH, headless-safe (pure /proc read).
#
# HONEST degradation (the no-faked-reading rule):
#   - No /proc/asound, or no playback substream status files at all (a VM / headless box with no
#     sound card) => EXIT 2 "unreachable" — NOT a fake SILENT. Absence-of-hardware must read
#     differently from a real quiet.
#   - All substreams closed => SILENT (honest: no active playback in this instant). SILENT is NOT a
#     claim of human absence — the node simply is not playing anything right now.
#
# Usage:
#   mesh-audio-active           one-shot live read -> PLAYING | SILENT (+ stream count, rate/format)
#   mesh-audio-active --json    machine form {ts,host,status,running_streams,source}
#   mesh-audio-active --confirm reafference loop-closure: when source=self, does the mic corroborate?
#                               -> confirm=heard|unheard|n/a  (report-only; +--json for machine form)
#   mesh-audio-active --cd      corollary-discharge coordination: is the hub mark ($MESH/mesh-speaking)
#                               timed to the emission? -> cd=aligned|uncovered|overhang|expired|stale|n/a
#                               (report-only, never writes/reaps the mark; +--json. Does NOT need a sound
#                               card — the mark and the player process are readable without one, so this
#                               axis does not inherit the exit-2 of the ALSA reads.)
#   mesh-audio-active --test    smoke test (RUNNING-vs-closed parse on synthetic fixtures)
#   exit 0 = real reading · exit 2 = no playback substreams (sense unreachable on this node)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
HOST="$(hostname)"
MESH="${MESH_DIR:-$HOME/.mesh}"

# --- count_running <status-blob>: echo the number of substreams in state RUNNING. A running
# substream's status carries a "state: RUNNING" line; an idle one is the single word "closed"
# (no state: line). FALSIFIABLE: flip the regex and the --test fixtures fail.
count_running() {
  printf '%s\n' "$1" | grep -cE '^[[:space:]]*state:[[:space:]]*RUNNING' || true
}

# --- self_emitting: rc0 iff the mesh's OWN audio efference copy is active right now — the
# `mesh-speaking` flag (touched by mesh-voice-tx and the mute-gated actuators) OR a live playback
# player process (pw-play/aplay/paplay — the binaries drone/metronome/room-music/looper/say invoke).
# NOT pw-record: capture is not emission. Mirrors mesh-soundscape's self-playback gate. Overridable
# for offline --test via MESH_AUDIO_ACTIVE_SELF (1=self, 0=not) so the classifier is falsifiable.
self_emitting() {
  case "${MESH_AUDIO_ACTIVE_SELF:-}" in 1) return 0 ;; 0) return 1 ;; esac
  # was a bare `[ -f "$MESH/mesh-speaking" ]` — a THIRD dialect of the hub mark (see the
  # corollary-discharge block in the header): a leaked/expired mark pinned source=self forever and
  # masked genuine exafference downstream. Read it through the one canonical cd_mark() instead.
  [ "$(cd_state)" = held ] && return 0
  player_alive
}

# --- player_alive: rc0 iff a LOCAL playback player process the mesh launches is alive right now
# (pw-play/aplay/paplay — drone/metronome/room-music/looper/say). NOT pw-record: capture is not
# emission. This is the emission evidence INDEPENDENT of the hub mark, which is what makes the
# corollary-discharge axis able to see the mark and the emission come apart. Injectable offline via
# MESH_AUDIO_ACTIVE_PLAYER (1=emitting, 0=not).
player_alive() {
  case "${MESH_AUDIO_ACTIVE_PLAYER:-}" in 1) return 0 ;; 0) return 1 ;; esac
  pgrep -x pw-play >/dev/null 2>&1 && return 0
  pgrep -x aplay   >/dev/null 2>&1 && return 0
  pgrep -x paplay  >/dev/null 2>&1 && return 0
  return 1
}

# staleness window for the touch-dialect mark — the SAME env knob mesh-overhear's _self_emitting_now
# reads, deliberately: one hub, one calibration (Jarzyna & Carlson 2026). Default 300s.
CD_STALE="${MESH_SELF_EMIT_STALE:-300}"

# --- cd_mark <present:0|1> <content> <age_s> <now_epoch> <stale_s>: THE canonical reading of the hub
# corollary-discharge mark, in one place. The mark is written in TWO live dialects and this is the only
# function in this tool that knows both: a DEADLINE EPOCH (mesh-note3-say — held until the epoch, then
# expired) or an EMPTY touch flag (mesh-say/mesh-voice-tx/mesh-overhear — held while mtime-fresh, then
# stale). Staleness FAILS OPEN (stale != held): a mark leaked by a killed writer must never leave the
# node permanently deaf. PURE + FALSIFIABLE via --test.
cd_mark() {
  [ "$1" = 1 ] || { echo absent; return; }
  case "$2" in
    ''|*[!0-9]*) { [ "$3" -le "$5" ] 2>/dev/null && echo held; } || echo stale ;;
    *)           { [ "$4" -lt "$2" ] 2>/dev/null && echo held; } || echo expired ;;
  esac
}

# --- cd_state: cd_mark applied to the live mark on disk. Injectable offline via MESH_AUDIO_ACTIVE_CD.
cd_state() {
  case "${MESH_AUDIO_ACTIVE_CD:-}" in ?*) echo "$MESH_AUDIO_ACTIVE_CD"; return ;; esac
  local f="$MESH/mesh-speaking" now m c
  [ -f "$f" ] || { echo absent; return; }
  now="$(date +%s)"
  m="$(stat -c %Y "$f" 2>/dev/null)" || m="$now"
  c="$(tr -d '[:space:]' < "$f" 2>/dev/null)"
  cd_mark 1 "$c" "$(( now - m ))" "$now" "$CD_STALE"
}

# --- cd_of <player:0|1> <mark>: corollary-discharge COORDINATION verdict — does the cancellation
# signal actually span the emission? The mark alone cannot say (it is present-or-absent); the emission
# alone cannot say. Crossing them is the whole point: `uncovered` is the fish's "swamped by its own
# signal" fault (the ear live on our own voice → self-transcription/false wake), `expired`/`stale` are
# the live READER DIVERGENCE (deadline-aware readers fail open, bare-exists readers stay deaf), and
# `overhang` is NOT a fault — the mesh routinely speaks off-node (voice-tx on the Bose, note3-say over
# adb) with no local player process. PURE + FALSIFIABLE via --test.
cd_of() {
  case "$2" in
    held)    [ "$1" = 1 ] && echo aligned   || echo overhang ;;
    expired) [ "$1" = 1 ] && echo uncovered || echo expired ;;
    stale)   [ "$1" = 1 ] && echo uncovered || echo stale ;;
    *)       [ "$1" = 1 ] && echo uncovered || echo na ;;
  esac
}

# --- source_of <running_count> <self:0|1>: PURE efference-cancellation classifier. Given the
# reafferent signal (RUNNING substreams) and the efference copy (is the mesh emitting), echo the
# isolated source: none (nothing playing) · self (reafference — the mesh's own output) · external
# (exafference — an outside stream, the real activity signal). FALSIFIABLE via --test.
source_of() {
  [ "$1" -gt 0 ] 2>/dev/null || { echo none; return; }
  [ "$2" = 1 ] && { echo self; return; }
  echo external
}

# --- read_mic_level: echo the room mic's level class (SILENCE|QUIET|MODERATE|LOUD) via the existing
# calibrated ear (mesh-ambient-level), or UNREACHABLE if no capture device here. Overridable offline
# for --test via MESH_AUDIO_ACTIVE_MIC so the confirm classifier is falsifiable without hardware.
read_mic_level() {
  case "${MESH_AUDIO_ACTIVE_MIC:-}" in ?*) echo "$MESH_AUDIO_ACTIVE_MIC"; return ;; esac
  local j lbl
  j="$(mesh-ambient-level --json 2>/dev/null)" || { echo UNREACHABLE; return; }
  lbl="$(printf '%s' "$j" | python3 -c 'import sys,json; print(json.load(sys.stdin).get("label",""))' 2>/dev/null)"
  case "$lbl" in SILENCE|QUIET|MODERATE|LOUD) echo "$lbl" ;; *) echo UNREACHABLE ;; esac
}

# --- THE SHADOW CONTROL (lit-4E live review 2026-08-26; see the header block). read_mic_db echoes the
# mic's CURRENT rms in dBFS (the number behind the class), ambient_floor echoes the ROOM'S OWN floor
# derived from the live ambient tape, and lift_of is the pure subtraction that separates them. A level
# is not a confirmation: the room has its own floor, and a dead sink in an occupied room reads exactly
# like a live one. Only the LIFT above that floor is contingent on our emission.
# Both reads are injectable so the classifier is falsifiable without hardware and without a tape.
read_mic_db() {
  case "${MESH_AUDIO_ACTIVE_MIC_DB:-}" in ?*) echo "$MESH_AUDIO_ACTIVE_MIC_DB"; return ;; esac
  local j
  j="$(mesh-ambient-level --json 2>/dev/null)" || { echo ""; return; }
  printf '%s' "$j" | python3 -c 'import sys,json
try:  print(float(json.load(sys.stdin).get("rms_db")))
except Exception: print("")' 2>/dev/null
}

# ambient_floor -> "<floor_db>|<n>|<age_s>" or "|0|" when the floor is UNKNOWN. The floor is the p20 of
# the trailing window of ~/.mesh/ambient-db-tape.tsv (mesh-ambient-tape, 2-min cadence).
#   * p20, not the median: our OWN playback contaminates the tape (the tape is written whatever is
#     sounding), and a low quantile still estimates the room's quiet floor as long as we are not
#     emitting for most of the window. A median would drift toward our own output.
#   * PER-WINDOW, never a constant: measured across this node's 111 six-hour windows the p20 floor has
#     sd 15.6 dB (the tape pools capture devices at different gains), so any pinned floor is a fossil.
#   * UNKNOWN (not a guessed number) when the tape is missing, short (<MIN_N rows) or stale — the
#     caller then keeps today's verdict rather than minting one from absent evidence.
# NUL spans are stripped: this is an append log on a power-cycling node (crash loss, not a race).
ambient_floor() {
  case "${MESH_AUDIO_ACTIVE_FLOOR:-}" in ?*) echo "$MESH_AUDIO_ACTIVE_FLOOR"; return ;; esac
  local tape="${MESH_AUDIO_ACTIVE_TAPE:-$HOME/.mesh/ambient-db-tape.tsv}"
  [ -r "$tape" ] || { echo "|0|"; return; }
  MESH_AF_TAPE="$tape" \
  MESH_AF_WIN="${MESH_AUDIO_ACTIVE_FLOOR_WIN_S:-21600}" \
  MESH_AF_MINN="${MESH_AUDIO_ACTIVE_FLOOR_MIN_N:-30}" \
  MESH_AF_MAXAGE="${MESH_AUDIO_ACTIVE_FLOOR_MAX_AGE_S:-900}" \
  python3 - <<'PY' 2>/dev/null || echo "|0|"
import os, sys, time, datetime as dt
win=float(os.environ["MESH_AF_WIN"]); minn=int(os.environ["MESH_AF_MINN"]); maxage=float(os.environ["MESH_AF_MAXAGE"])
now=time.time(); vals=[]; newest=None
try:
    for raw in open(os.environ["MESH_AF_TAPE"],"rb"):
        line=raw.replace(b"\x00",b"").decode("utf-8","replace")
        if line.startswith("#"): continue
        f=line.rstrip("\n").split("\t")
        if len(f)<2: continue
        try:
            t=dt.datetime.fromisoformat(f[0].replace("Z","+00:00")).timestamp(); db=float(f[1])
        except Exception: continue
        if newest is None or t>newest: newest=t
        if now-t<=win: vals.append(db)
except Exception:
    print("|0|"); sys.exit(0)
if newest is None or len(vals)<minn or (now-newest)>maxage:
    print("|%d|%s"%(len(vals), "" if newest is None else int(now-newest))); sys.exit(0)
vals.sort()
p20=vals[max(0,min(len(vals)-1,int(round(0.20*(len(vals)-1)))))]
print("%.1f|%d|%d"%(p20,len(vals),int(now-newest)))
PY
}

# lift_of <mic_db> <floor_db> -> the dB the room rose ABOVE its own floor, or "" when either side is
# UNKNOWN. Pure; the whole shadow discrimination is this one subtraction.
lift_of() {
  case "$1" in ''|*[!-0-9.]*) echo ""; return ;; esac
  case "$2" in ''|*[!-0-9.]*) echo ""; return ;; esac
  awk -v a="$1" -v b="$2" 'BEGIN{printf "%.1f", a-b}'
}

# --- confirm_of <running> <self:0|1> <mic_level>: reafference CONFIRMATION classifier (loop-closure).
# The efference copy (source=self) PREDICTS the room now carries the mesh's own sound; close the loop
# against the mic. heard = predicted reafference arrived (actuator VERIFIED) · unheard = sink RUNNING
# yet the room is SILENT (HOLLOW actuator — the silent-speaker fault the log-signature check misses) ·
# na = not self-emitting / nothing running / mic unreachable (nothing to, or cannot, confirm). PURE +
# FALSIFIABLE via --test. Only source=self is confirmable — an EXTERNAL stream has no efference copy
# predicting a level, so we make no claim about it (na).
# 4th arg <lift_db> (2026-08-26): the dB the room sits ABOVE its own floor, or "" when the floor is
# UNKNOWN. A non-silent room is the SHADOW, not the confirmation — see the header. lift < threshold →
# shadowed (level fully explained by the room's own floor: UNCONFIRMED, not verified). lift UNKNOWN →
# the pre-2026-08-26 verdict verbatim, so absent evidence never mints a new word.
confirm_of() {
  [ "$1" -gt 0 ] 2>/dev/null || { echo na; return; }   # nothing running → nothing to confirm
  [ "$2" = 1 ] || { echo na; return; }                 # not self-emitting → no efference copy to check
  case "$3" in
    SILENCE)                echo unheard ;;             # emitting yet room dead-silent → HOLLOW actuator
    QUIET|MODERATE|LOUD)
      case "${4:-}" in
        ''|*[!-0-9.]*) echo heard ;;                    # floor UNKNOWN → today's verdict, no new claim
        *) if awk -v l="$4" -v t="${MESH_AUDIO_ACTIVE_LIFT_DB:-5.0}" 'BEGIN{exit !(l+0 >= t+0)}'; then
             echo heard                                 # the room rose WITH our emission → VERIFIED
           else
             echo shadowed                              # level ≈ the room's own floor → UNCONFIRMED
           fi ;;
      esac ;;
    *)                      echo na ;;                  # UNREACHABLE / unknown → honest can't-confirm
  esac
}

if [ "${1:-}" = --test ]; then
  _f=0
  running=$'state: RUNNING\nowner_pid   : 1234\nformat: S16_LE\nrate: 48000 (48000/1)'   # an active stream
  idle='closed'                                                                            # an idle substream
  setup=$'state: SETUP\nowner_pid   : 999'                                                 # opened-but-not-running -> NOT counted
  # (a) one running stream -> 1
  [ "$(count_running "$running")" = 1 ] || { echo "  FAIL: one RUNNING should count 1, got '$(count_running "$running")'"; _f=1; }
  # (b) idle 'closed' -> 0 (the trap: 'closed' must never read as active)
  [ "$(count_running "$idle")" = 0 ] || { echo "  FAIL: 'closed' substream must count 0"; _f=1; }
  # (c) SETUP (opened, not yet playing) -> 0 (only RUNNING is active playback)
  [ "$(count_running "$setup")" = 0 ] || { echo "  FAIL: SETUP must not count as RUNNING"; _f=1; }
  # (d) mixed: one running + two idle -> 1
  [ "$(count_running "$(printf '%s\n%s\n%s\n' "$running" "$idle" "$idle")")" = 1 ] \
    || { echo "  FAIL: running+2 idle should be 1"; _f=1; }
  # (e) two running -> 2
  [ "$(count_running "$(printf '%s\n%s\n' "$running" "$running")")" = 2 ] \
    || { echo "  FAIL: two RUNNING should be 2"; _f=1; }
  # (f) empty input -> 0 (no streams)
  [ "$(count_running "")" = 0 ] || { echo "  FAIL: empty must be 0"; _f=1; }
  # --- REAFFERENCE-cancellation fixtures (efference-copy, 2026-07-10). source_of() isolates the
  # exafference by subtracting the self-caused component; falsifiable — flip a case and it fails. ---
  # (g) playing + efference copy present => self (reafference: the mesh's own tone, NOT activity)
  [ "$(source_of 1 1)" = self ]     || { echo "  FAIL: running + self-emitting must be source=self, got '$(source_of 1 1)'"; _f=1; }
  # (h) playing + NO efference copy => external (exafference: a genuine outside stream = the signal)
  [ "$(source_of 1 0)" = external ] || { echo "  FAIL: running + not-self must be source=external, got '$(source_of 1 0)'"; _f=1; }
  # (i) two streams + self => still self (count>1 doesn't change the source verdict)
  [ "$(source_of 2 1)" = self ]     || { echo "  FAIL: 2 running + self must be source=self"; _f=1; }
  # (j) nothing running => none (no reafferent signal at all — source is undefined, not 'external')
  [ "$(source_of 0 0)" = none ]     || { echo "  FAIL: 0 running must be source=none, got '$(source_of 0 0)'"; _f=1; }
  [ "$(source_of 0 1)" = none ]     || { echo "  FAIL: 0 running must be source=none even if self-flag set"; _f=1; }
  # (k) self_emitting honours the offline override both ways (the efference copy is injectable)
  MESH_AUDIO_ACTIVE_SELF=1 self_emitting || { echo "  FAIL: MESH_AUDIO_ACTIVE_SELF=1 must force self_emitting rc0"; _f=1; }
  MESH_AUDIO_ACTIVE_SELF=0 self_emitting && { echo "  FAIL: MESH_AUDIO_ACTIVE_SELF=0 must force self_emitting rc1"; _f=1; }
  # --- REAFFERENCE-CONFIRMATION fixtures (loop-closure, 2026-07-30). confirm_of closes the action→
  # perception loop: a self-source stream whose sound the mic CANNOT hear = a hollow actuator. The
  # load-bearing pair is (l)/(m): self+RUNNING splits on the mic alone, so a classifier that ignored
  # the mic (always 'heard') fails (m), and one that ignored source (flagging external silence) fails
  # (o). Falsifiable — flip any case and it goes RED. ---
  # (l) self + running + mic corroborates → heard (actuator verified)
  [ "$(confirm_of 1 1 MODERATE)" = heard ]  || { echo "  FAIL: self+running+MODERATE mic must be confirm=heard, got '$(confirm_of 1 1 MODERATE)'"; _f=1; }
  [ "$(confirm_of 1 1 QUIET)"    = heard ]  || { echo "  FAIL: self+running+QUIET mic must be confirm=heard"; _f=1; }
  # (m) self + running + mic SILENT → unheard (HOLLOW: emitting yet the room is dead-silent)
  [ "$(confirm_of 1 1 SILENCE)"  = unheard ]|| { echo "  FAIL: self+running+SILENCE mic must be confirm=unheard (hollow actuator undetected), got '$(confirm_of 1 1 SILENCE)'"; _f=1; }
  # (n) self + running + mic UNREACHABLE → na (no ear here — cannot confirm, must NOT cry hollow)
  [ "$(confirm_of 1 1 UNREACHABLE)" = na ] || { echo "  FAIL: unreachable mic must be confirm=na, not a false hollow-alarm, got '$(confirm_of 1 1 UNREACHABLE)'"; _f=1; }
  # (o) EXTERNAL source (self=0), even with a silent mic → na (no efference copy predicts a level; a
  #     quiet human video is NOT a hollow-actuator alarm — the trap this axis must not fall into)
  [ "$(confirm_of 1 0 SILENCE)"  = na ]     || { echo "  FAIL: external+SILENCE must be confirm=na (external has no efference copy to confirm), got '$(confirm_of 1 0 SILENCE)'"; _f=1; }
  # (p) nothing running → na regardless of the flags
  [ "$(confirm_of 0 1 MODERATE)" = na ]     || { echo "  FAIL: 0 running must be confirm=na"; _f=1; }
  # (q) read_mic_level honours the offline override (the ear is injectable, like the efference copy)
  [ "$(MESH_AUDIO_ACTIVE_MIC=LOUD read_mic_level)" = LOUD ] || { echo "  FAIL: MESH_AUDIO_ACTIVE_MIC override must pass through read_mic_level"; _f=1; }
  # --- SHADOW-CONTROL fixtures (lit-4E live review 2026-08-26, perceptual crossing). The whole point:
  # (l)/(m) above split self+RUNNING on SILENCE vs not-silence — the STATIC DECOY. These legs add the
  # SHADOW: identical mic CLASS, identical everything, differing ONLY in whether the level is contingent
  # on our emission. The load-bearing pair is (r1)/(r2): SAME class, SAME code path, opposite verdict on
  # the lift alone, so a classifier that ignores the lift cannot pass both. (r3) is the honest-fallback
  # leg — floor UNKNOWN must reproduce the pre-2026-08-26 verdict, never mint the new word. ---
  # (r1) self + running + MODERATE + a real lift above the room's floor → heard (contingent on us)
  [ "$(confirm_of 1 1 MODERATE 12.0)" = heard ] \
    || { echo "  FAIL: a +12.0 dB lift must be confirm=heard, got '$(confirm_of 1 1 MODERATE 12.0)'"; _f=1; }
  # (r2) THE SHADOW: same class, same source, same running count — but the level sits at the room's own
  #      floor, so it is explained without us. Must NOT be heard.
  [ "$(confirm_of 1 1 MODERATE 1.7)" = shadowed ] \
    || { echo "  FAIL: a +1.7 dB lift (the corpus's own p50 ambient wobble) must be confirm=shadowed, not a confirmation, got '$(confirm_of 1 1 MODERATE 1.7)'"; _f=1; }
  [ "$(confirm_of 1 1 QUIET 0.0)" = shadowed ] \
    || { echo "  FAIL: zero lift must be confirm=shadowed"; _f=1; }
  [ "$(confirm_of 1 1 LOUD -3.0)" = shadowed ] \
    || { echo "  FAIL: a LOUD room BELOW its own floor must still be confirm=shadowed (class is not evidence)"; _f=1; }
  # (r3) floor UNKNOWN (no tape / short / stale) → the OLD verdict verbatim; absent evidence mints nothing
  [ "$(confirm_of 1 1 MODERATE '')" = heard ] \
    || { echo "  FAIL: unknown lift must fall back to the pre-shadow verdict 'heard', got '$(confirm_of 1 1 MODERATE '')'"; _f=1; }
  [ "$(confirm_of 1 1 SILENCE '')" = unheard ] \
    || { echo "  FAIL: SILENCE must stay unheard whatever the floor says"; _f=1; }
  # (r4) the threshold is the boundary it claims to be, in both directions (exactly-at-threshold = heard)
  [ "$(MESH_AUDIO_ACTIVE_LIFT_DB=5.0 confirm_of 1 1 QUIET 5.0)" = heard ] \
    || { echo "  FAIL: lift exactly at the threshold must be heard"; _f=1; }
  [ "$(MESH_AUDIO_ACTIVE_LIFT_DB=5.0 confirm_of 1 1 QUIET 4.9)" = shadowed ] \
    || { echo "  FAIL: lift just under the threshold must be shadowed"; _f=1; }
  # (r5) the shadow never leaks past the source gate — an EXTERNAL stream has no efference copy, so no
  #      lift claim is made about it either
  [ "$(confirm_of 1 0 MODERATE 1.0)" = na ] \
    || { echo "  FAIL: external source must stay na regardless of lift"; _f=1; }
  # (r6) lift_of is the pure subtraction, and it refuses BOTH unknown sides rather than guessing a 0
  [ "$(lift_of -30.8 -46.8)" = 16.0 ] || { echo "  FAIL: lift_of -30.8 -46.8 must be 16.0, got '$(lift_of -30.8 -46.8)'"; _f=1; }
  [ "$(lift_of '' -46.8)" = "" ]      || { echo "  FAIL: unknown mic_db must give an EMPTY lift, never 0"; _f=1; }
  [ "$(lift_of -30.8 '')" = "" ]      || { echo "  FAIL: unknown floor must give an EMPTY lift, never 0"; _f=1; }
  [ "$(lift_of UNREACHABLE -46.8)" = "" ] || { echo "  FAIL: a non-numeric mic reading must give an EMPTY lift"; _f=1; }
  # (r7) ambient_floor over a REAL tape file (not the injection): a fresh, long-enough tape yields a
  #      floor at the 20th percentile, and the SAME tape aged past MAX_AGE yields UNKNOWN — the
  #      staleness gate is proved by the clock, not by absence.
  _tp="$(mktemp -d)"; trap 'rm -rf "$_tp"' EXIT
  python3 - "$_tp/tape.tsv" <<'PYTAPE'
import sys, time, datetime as dt
now=time.time()
with open(sys.argv[1],"w") as fh:
    fh.write("# fixture\n")
    for i in range(60):                       # 60 rows, 2-min cadence, newest ~now
        t=dt.datetime.fromtimestamp(now-(59-i)*120, dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
        db=-50.0 if i < 20 else -30.0         # p20 of this set is the -50 band
        fh.write("%s\t%.1f\t-10.0\tQUIET\n"%(t,db))
PYTAPE
  _fl="$(MESH_AUDIO_ACTIVE_TAPE="$_tp/tape.tsv" ambient_floor)"
  case "$_fl" in -50.0\|60\|*) : ;; *) echo "  FAIL: ambient_floor on a fresh 60-row fixture must read '-50.0|60|<age>', got '$_fl'"; _f=1 ;; esac
  # the same rows, shifted 2h into the past: a tape that STOPPED being written must render UNKNOWN.
  # Proved by the CLOCK on a present, well-formed, long-enough tape — not by absence.
  python3 - "$_tp/stale.tsv" <<'PYSTALE'
import sys, time, datetime as dt
now=time.time()-7200
with open(sys.argv[1],"w") as fh:
    fh.write("# fixture\n")
    for i in range(60):
        t=dt.datetime.fromtimestamp(now-(59-i)*120, dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
        fh.write("%s\t%.1f\t-10.0\tQUIET\n"%(t, -50.0 if i < 20 else -30.0))
PYSTALE
  _fl="$(MESH_AUDIO_ACTIVE_TAPE="$_tp/stale.tsv" MESH_AUDIO_ACTIVE_FLOOR_WIN_S=86400 ambient_floor)"
  case "$_fl" in -*) echo "  FAIL: a tape whose newest row is 2h old must render UNKNOWN, not a floor ('$_fl')"; _f=1 ;; esac
  _fl="$(MESH_AUDIO_ACTIVE_TAPE="$_tp/tape.tsv" MESH_AUDIO_ACTIVE_FLOOR_MIN_N=999 ambient_floor)"
  case "$_fl" in -*) echo "  FAIL: a tape shorter than MIN_N must render UNKNOWN, not a floor ('$_fl')"; _f=1 ;; esac
  _fl="$(MESH_AUDIO_ACTIVE_TAPE="$_tp/nope.tsv" ambient_floor)"
  [ "$_fl" = "|0|" ] || { echo "  FAIL: a missing tape must render '|0|' (UNKNOWN), got '$_fl'"; _f=1; }
  # (r8) NUL spans (crash loss on this power-cycling node) must not kill the floor read
  printf '\0\0\0\0' >> "$_tp/tape.tsv"
  _fl="$(MESH_AUDIO_ACTIVE_TAPE="$_tp/tape.tsv" ambient_floor)"
  case "$_fl" in -50.0\|*) : ;; *) echo "  FAIL: NUL bytes in the tape must be stripped, not fatal (got '$_fl')"; _f=1 ;; esac
  # (r9) END-TO-END through the real script, both flag states, the exit code and the WORD must follow the
  #      injected floor — a pure-function leg cannot see a classifier that is computed and then discarded.
  # DRIVE THE FILE UNDER TEST, not whatever wears its name on PATH. `"$0"` is `mesh-audio-active` when
  # invoked as `bash mesh-audio-active --test` from the genome, and bash then resolves that child via
  # PATH — i.e. the DEPLOYED ~/.local/bin copy — so a genome-only edit would test green against the old
  # binary. Caught live 2026-08-26 (this leg was the thing that caught it).
  _self="$(cd "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/$(basename -- "${BASH_SOURCE[0]}")"
  mkdir -p "$_tp/asound/card0/pcm0p/sub0"
  printf 'state: RUNNING\nowner_pid   : 1234\nformat: S16_LE\nrate: 48000 (48000/1)\n' > "$_tp/asound/card0/pcm0p/sub0/status"
  _out="$(MESH_AUDIO_ACTIVE_PCMROOT="$_tp/asound" MESH_AUDIO_ACTIVE_SELF=1 MESH_AUDIO_ACTIVE_MIC=MODERATE MESH_AUDIO_ACTIVE_MIC_DB=-30.0 \
          MESH_AUDIO_ACTIVE_FLOOR='-46.8|900|60' "$_self" --confirm --json 2>/dev/null)" || true
  case "$_out" in *'"confirm":"heard"'*) : ;; *) echo "  FAIL: --confirm --json with a 16.8 dB lift must render heard, got: $_out"; _f=1 ;; esac
  case "$_out" in *'"lift_db":16.8'*) : ;; *) echo "  FAIL: --confirm --json must PUBLISH the lift it decided on, got: $_out"; _f=1 ;; esac
  _out="$(MESH_AUDIO_ACTIVE_PCMROOT="$_tp/asound" MESH_AUDIO_ACTIVE_SELF=1 MESH_AUDIO_ACTIVE_MIC=MODERATE MESH_AUDIO_ACTIVE_MIC_DB=-45.0 \
          MESH_AUDIO_ACTIVE_FLOOR='-46.8|900|60' "$_self" --confirm --json 2>/dev/null)" || true
  case "$_out" in *'"confirm":"shadowed"'*) : ;; *) echo "  FAIL: the SAME mic class at the room's own floor must render shadowed end-to-end, got: $_out"; _f=1 ;; esac
  case "$_out" in *'"floor_db":-46.8'*) : ;; *) echo "  FAIL: --confirm --json must publish the floor it stood on, got: $_out"; _f=1 ;; esac
  _out="$(MESH_AUDIO_ACTIVE_PCMROOT="$_tp/asound" MESH_AUDIO_ACTIVE_SELF=1 MESH_AUDIO_ACTIVE_MIC=MODERATE MESH_AUDIO_ACTIVE_MIC_DB=-45.0 \
          MESH_AUDIO_ACTIVE_FLOOR='|0|' "$_self" --confirm --json 2>/dev/null)" || true
  case "$_out" in *'"confirm":"heard"'*) : ;; *) echo "  FAIL: an UNKNOWN floor must reproduce the old verdict end-to-end, got: $_out"; _f=1 ;; esac
  case "$_out" in *'"lift_db":null'*) : ;; *) echo "  FAIL: an unknown lift must render null, never 0, got: $_out"; _f=1 ;; esac
  rm -rf "$_tp"; trap - EXIT
  # --- COROLLARY-DISCHARGE TIMING fixtures (lit-PP 2026-08-14, Jarzyna & Carlson). cd_mark reads BOTH
  # live dialects of the hub mark; cd_of crosses it with the emission. The load-bearing pairs:
  # (r)/(s) split the deadline dialect on the CLOCK alone (a reader that only tested existence cannot
  # pass both), (v)/(w) split the SAME mark state on the emission alone, and (x) keeps `overhang` out
  # of the fault classes so off-node speech is never mis-flagged. ---
  _now=1000000000
  # (r) deadline epoch in the FUTURE → held (the mark spans the emission)
  [ "$(cd_mark 1 $((_now+20)) 0 "$_now" 300)" = held ] || { echo "  FAIL: future deadline must be held, got '$(cd_mark 1 $((_now+20)) 0 "$_now" 300)'"; _f=1; }
  # (s) deadline epoch PASSED → expired (bare existence would still read 'held' — the divergence)
  [ "$(cd_mark 1 $((_now-5)) 0 "$_now" 300)" = expired ] || { echo "  FAIL: passed deadline must be expired, got '$(cd_mark 1 $((_now-5)) 0 "$_now" 300)'"; _f=1; }
  # (t) empty touch-dialect mark, mtime FRESH → held
  [ "$(cd_mark 1 '' 10 "$_now" 300)" = held ] || { echo "  FAIL: fresh touch-mark must be held"; _f=1; }
  # (u) empty touch-dialect mark, mtime OLD → stale (FAIL OPEN: a leaked mark must not mean deaf forever)
  [ "$(cd_mark 1 '' 900 "$_now" 300)" = stale ] || { echo "  FAIL: old touch-mark must be stale (fail open), got '$(cd_mark 1 '' 900 "$_now" 300)'"; _f=1; }
  # (u2) no mark at all → absent
  [ "$(cd_mark 0 '' 0 "$_now" 300)" = absent ] || { echo "  FAIL: no mark must be absent"; _f=1; }
  # (v) emitting + mark held → aligned (corollary discharge spans the self-signal)
  [ "$(cd_of 1 held)" = aligned ] || { echo "  FAIL: player+held must be cd=aligned"; _f=1; }
  # (w) emitting + mark expired/stale/absent → uncovered (the ear is LIVE on our own voice)
  [ "$(cd_of 1 expired)" = uncovered ] || { echo "  FAIL: player+expired must be cd=uncovered, got '$(cd_of 1 expired)'"; _f=1; }
  [ "$(cd_of 1 stale)"   = uncovered ] || { echo "  FAIL: player+stale must be cd=uncovered"; _f=1; }
  [ "$(cd_of 1 absent)"  = uncovered ] || { echo "  FAIL: player+absent must be cd=uncovered"; _f=1; }
  # (x) mark held, NO local player → overhang, NOT a fault (voice-tx/note3-say speak off this node)
  [ "$(cd_of 0 held)" = overhang ] || { echo "  FAIL: held with no local player must be cd=overhang (off-node speech is not a fault), got '$(cd_of 0 held)'"; _f=1; }
  # (y) not emitting + expired/stale → the reader-divergence classes, reported as themselves
  [ "$(cd_of 0 expired)" = expired ] || { echo "  FAIL: no player+expired must be cd=expired"; _f=1; }
  [ "$(cd_of 0 stale)"   = stale ]   || { echo "  FAIL: no player+stale must be cd=stale"; _f=1; }
  # (z) nothing emitting, no mark → na
  [ "$(cd_of 0 absent)" = na ] || { echo "  FAIL: quiet + no mark must be cd=n/a"; _f=1; }
  # (aa) the hub mark is injectable, and self_emitting() now reads it through cd_mark — an EXPIRED mark
  #      must NOT pin source=self (the bug this review found: a leaked mark masked real exafference)
  MESH_AUDIO_ACTIVE_CD=held    MESH_AUDIO_ACTIVE_PLAYER=0 self_emitting \
    || { echo "  FAIL: a HELD hub mark must make self_emitting rc0"; _f=1; }
  MESH_AUDIO_ACTIVE_CD=expired MESH_AUDIO_ACTIVE_PLAYER=0 self_emitting \
    && { echo "  FAIL: an EXPIRED hub mark must NOT read as self-emitting (leaked mark masks exafference)"; _f=1; }
  MESH_AUDIO_ACTIVE_CD=stale   MESH_AUDIO_ACTIVE_PLAYER=0 self_emitting \
    && { echo "  FAIL: a STALE hub mark must NOT read as self-emitting (fail open)"; _f=1; }
  MESH_AUDIO_ACTIVE_CD=absent  MESH_AUDIO_ACTIVE_PLAYER=1 self_emitting \
    || { echo "  FAIL: a live player process alone must still read as self-emitting"; _f=1; }
  # (ab) the same claim driven through a REAL mark FILE, not the injection — an injected class would be
  #      satisfied by a reader that never parses the mark at all. Throwaway MESH dir: this test must
  #      NEVER write the live ~/.mesh/mesh-speaking (writing it would mute the room ear for real).
  _td="$(mktemp -d)"
  printf '%s\n' "$(( $(date +%s) - 60 ))" > "$_td/mesh-speaking"       # deadline 60s in the past
  ( unset MESH_AUDIO_ACTIVE_CD; MESH="$_td"; export MESH_AUDIO_ACTIVE_PLAYER=0; self_emitting ) \
    && { echo "  FAIL: a real on-disk EXPIRED mark must NOT read as self-emitting (this is the leaked-mark-masks-exafference bug)"; _f=1; }
  : > "$_td/mesh-speaking"                                              # touch dialect, mtime now
  ( unset MESH_AUDIO_ACTIVE_CD; MESH="$_td"; export MESH_AUDIO_ACTIVE_PLAYER=0; self_emitting ) \
    || { echo "  FAIL: a real on-disk FRESH touch mark must read as self-emitting"; _f=1; }
  rm -rf "$_td"
  [ "$_f" = 0 ] || { echo "smoke-test: FAIL"; exit 1; }
  echo "smoke-test: ok (RUNNING parse 6 + reafference source_of/self_emitting 7 + confirmation confirm_of/read_mic_level 7 + corollary-discharge cd_mark/cd_of/self_emitting 19 + SHADOW-control lift/floor/end-to-end 24 = 63 assertions)"
  echo "(mutation: make confirm_of ignore the mic (always 'heard') → fixture (m) self+SILENCE no longer"
  echo " reads unheard → RED. Make it flag external silence (drop the self=1 guard) → (o) goes RED."
  echo " Make cd_mark ignore the clock (deadline branch always 'held') → (s) RED. Make stale read as"
  echo " held (fail closed) → (u) RED. Make cd_of call 'overhang' a fault (uncovered) → (x) RED. SHADOW arm: make confirm_of ignore
 the lift (any non-silence → 'heard') → (r2) RED; drop ambient_floor's staleness gate → (r7) RED;
 let lift_of return 0 instead of "" for an unknown side → (r6)+(r9) RED; fall back to 'shadowed'
 on an UNKNOWN floor → (r3) RED; compute the lift in --confirm and pass "" to confirm_of (the
 computed-then-discarded wiring bug) → (r9) RED while every pure leg stays green.)"
  exit 0
fi

shopt -s nullglob

# --- --cd: corollary-discharge COORDINATION (report-only, never writes or reaps the mark). Deliberately
# does NOT read /proc/asound and does NOT exit 2 on a cardless node: the hub mark and the player process
# are both readable without a sound card, and on this very node (mesh-home, 2026-08-14) aplay runs with
# every hw substream reading `closed` — so an ALSA gate here would render the axis blind exactly where
# the mesh speaks through PipeWire/remote sinks.
if [ "${1:-}" = --cd ]; then
  DJSON=0; [ "${2:-}" = --json ] && DJSON=1
  ts="$(date -u +%FT%TZ)"
  mark="$(cd_state)"
  player=0; player_alive && player=1
  cd="$(cd_of "$player" "$mark")"
  # dialect + remaining/age detail, read once, purely for the human line (never for the verdict)
  dialect="none"; detail=""
  if [ -f "$MESH/mesh-speaking" ]; then
    _c="$(tr -d '[:space:]' < "$MESH/mesh-speaking" 2>/dev/null)"
    _now="$(date +%s)"; _m="$(stat -c %Y "$MESH/mesh-speaking" 2>/dev/null)" || _m="$_now"
    case "$_c" in
      ''|*[!0-9]*) dialect="touch";    detail="age=$(( _now - _m ))s stale_window=${CD_STALE}s" ;;
      *)           dialect="deadline"; detail="remaining=$(( _c - _now ))s" ;;
    esac
  fi
  if [ "$DJSON" = 1 ]; then
    printf '{"ts":"%s","host":"%s","cd":"%s","mark":"%s","dialect":"%s","player":%s}\n' \
      "$ts" "$HOST" "$cd" "$mark" "$dialect" "$player"
    exit 0
  fi
  case "$cd" in
    aligned)   echo "[audio-active] cd=aligned — corollary discharge HELD (mark=$dialect${detail:+ $detail}) while a local player emits → our own sound is cancelled at the ear" ;;
    uncovered) echo "[audio-active] cd=uncovered — a local player is EMITTING with no live corollary discharge (mark=$mark${detail:+, $detail}) → the ear is live on our OWN sound: self-transcription / false-wake risk. FLAG — a writer released the shared mark while another pathway was still speaking." ;;
    overhang)  echo "[audio-active] cd=overhang — mark HELD (mark=$dialect${detail:+ $detail}) with no local player: normal for off-node speech (voice-tx on the Bose, note3-say over adb), or a writer over-holding. Not a fault." ;;
    expired)   echo "[audio-active] cd=expired — deadline PASSED and the mark is still on disk ($detail) → READER DIVERGENCE live: deadline-aware readers (mesh-overhear _self_emitting_now, this tool) fail open, bare-exists readers (overhear capture loop, _self_playing) stay DEAF." ;;
    stale)     echo "[audio-active] cd=stale — touch-dialect mark older than the stale window ($detail) → same reader divergence; a writer leaked it (killed mid-speech / unconditional rm skipped)." ;;
    na)        echo "[audio-active] cd=n/a — no corollary-discharge mark and no local player (nothing to coordinate)" ;;
  esac
  exit 0
fi

# --- --confirm: reafference loop-closure. Read the substream state (efference copy), and if the mesh
# is emitting its OWN sound, ask the mic whether that sound actually reached the room. Report-only.
if [ "${1:-}" = --confirm ]; then
  CJSON=0; [ "${2:-}" = --json ] && CJSON=1
  # the substream ROOT is overridable so the end-to-end shadow legs can drive the REAL count_running
  # parser against a fixture tree — an injected count would prove the classifier, never the wiring.
  cfiles=("${MESH_AUDIO_ACTIVE_PCMROOT:-/proc/asound}"/card*/pcm*p/sub*/status)
  ts="$(date -u +%FT%TZ)"
  if [ "${#cfiles[@]}" -eq 0 ]; then
    [ "$CJSON" = 1 ] && printf '{"ts":"%s","host":"%s","status":"UNREACHABLE","source":"none","confirm":"na"}\n' "$ts" "$HOST"
    echo "[audio-active] UNREACHABLE — no ALSA playback substreams on $HOST (cannot confirm)" >&2
    exit 2
  fi
  cblob=""; for f in "${cfiles[@]}"; do cblob="${cblob}$(cat "$f" 2>/dev/null)"$'\n'; done
  running="$(count_running "$cblob")"
  self=0; self_emitting && self=1
  source="$(source_of "$running" "$self")"
  # only sample the mic when there is a self-source stream to confirm (avoid a needless capture)
  mic="n/a"; micdb=""; floor=""; floor_n=0; floor_age=""; lift=""
  if [ "$running" -gt 0 ] && [ "$self" = 1 ]; then
    mic="$(read_mic_level)"
    micdb="$(read_mic_db)"
    IFS='|' read -r floor floor_n floor_age <<<"$(ambient_floor)"
    lift="$(lift_of "$micdb" "$floor")"
  fi
  confirm="$(confirm_of "$running" "$self" "$mic" "$lift")"
  # the EVIDENCE travels with the verdict: a reader can see whether the floor was known, how many rows
  # it stood on and how old they were — a bare 'heard' cannot say whether it was earned or defaulted.
  ev="floor_db=${floor:-none} floor_n=${floor_n:-0}${floor_age:+ floor_age_s=$floor_age} mic_db=${micdb:-none} lift_db=${lift:-unknown} lift_thr=${MESH_AUDIO_ACTIVE_LIFT_DB:-5.0}"
  if [ "$CJSON" = 1 ]; then
    st="SILENT"; [ "$running" -gt 0 ] && st="PLAYING"
    printf '{"ts":"%s","host":"%s","status":"%s","source":"%s","mic":"%s","confirm":"%s","mic_db":%s,"floor_db":%s,"floor_n":%s,"lift_db":%s,"lift_thr":%s}\n' \
      "$ts" "$HOST" "$st" "$source" "$mic" "$confirm" \
      "${micdb:-null}" "${floor:-null}" "${floor_n:-0}" "${lift:-null}" "${MESH_AUDIO_ACTIVE_LIFT_DB:-5.0}"
    exit 0
  fi
  case "$confirm" in
    heard)    echo "[audio-active] confirm=heard — source=self stream RUNNING and the room rose WITH it (mic=$mic $ev) → actuator VERIFIED (reafference arrived)" ;;
    shadowed) echo "[audio-active] confirm=shadowed — source=self stream RUNNING and the mic is not silent (mic=$mic), but the level is fully explained by the room's OWN floor ($ev) → the sound is a SHADOW (exafference), the actuator is UNCONFIRMED. A level is not a confirmation; only a lift is." ;;
    unheard)  echo "[audio-active] confirm=unheard — source=self stream RUNNING but the room is SILENT → HOLLOW actuator (muted/disconnected/misrouted speaker; predicted reafference MISSING). FLAG — check the sink." ;;
    na)       echo "[audio-active] confirm=n/a — nothing self-emitting to confirm (running=$running source=$source mic=$mic)" ;;
  esac
  exit 0
fi

JSON=0; [ "${1:-}" = --json ] && JSON=1

files=(/proc/asound/card*/pcm*p/sub*/status)
if [ "${#files[@]}" -eq 0 ]; then
  # honest-degraded: no ALSA playback substreams -> this node has no sound output to sense
  # (headless VM / no card). NOT a SILENT reading — the hardware sense itself is absent here.
  if [ "$JSON" = 1 ]; then
    printf '{"ts":"%s","host":"%s","status":"UNREACHABLE","running_streams":0}\n' "$(date -u +%FT%TZ)" "$HOST"
  fi
  echo "[audio-active] UNREACHABLE — no ALSA playback substreams on $HOST (no sound card / headless; not 'silent')" >&2
  exit 2
fi

blob=""
for f in "${files[@]}"; do blob="${blob}$(cat "$f" 2>/dev/null)"$'\n'; done
running="$(count_running "$blob")"
ts="$(date -u +%FT%TZ)"

# efference-copy cancellation: is a live playback OUR OWN doing? subtract it → isolate the source.
self=0; self_emitting && self=1
source="$(source_of "$running" "$self")"

if [ "$JSON" = 1 ]; then
  st="SILENT"; [ "$running" -gt 0 ] && st="PLAYING"
  printf '{"ts":"%s","host":"%s","status":"%s","running_streams":%s,"source":"%s"}\n' "$ts" "$HOST" "$st" "$running" "$source"
  exit 0
fi

if [ "$running" -gt 0 ]; then
  # pull rate/format/channels from the first running substream for detail
  detail=""
  for f in "${files[@]}"; do
    if grep -qE '^[[:space:]]*state:[[:space:]]*RUNNING' "$f" 2>/dev/null; then
      detail="$(grep -E '^[[:space:]]*(format|rate|channels):' "$f" 2>/dev/null | sed -E 's/^[[:space:]]+//' | tr '\n' ' ' | sed -E 's/ +$//')"
      break
    fi
  done
  if [ "$source" = self ]; then
    echo "[audio-active] PLAYING — $running active playback stream(s) on $HOST${detail:+ ($detail)} source=self → the mesh's OWN output (reafference: efference copy active — NOT external activity)"
  else
    echo "[audio-active] PLAYING — $running active playback stream(s) on $HOST${detail:+ ($detail)} source=external → sound coming out of the speakers now (exafference: outside stream — ACTIVITY, not a presence claim)"
  fi
else
  echo "[audio-active] SILENT — no active playback stream on $HOST (speakers idle; NOT 'absent' — the node may simply not be playing)"
fi
exit 0
