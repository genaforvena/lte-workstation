#!/usr/bin/env bash
# mesh-motion-type — gyro+accel fusion: distinguish ROTATION vs TRANSLATION.
# Gyro (angular velocity) detects rotation accel can't see. Accel (step counter)
# detects translation gyro can't see. Together they classify HOW the body moves:
#
#   STILL            = no rotation, no translation — phone stationary
#   TRANSLATION      = walking/running (steps increasing) without turning
#   ROTATION         = phone being spun/turned in place (no steps)
#   WALKING_TURNING  = walking while turning the phone (both active)
#   HANDLED          = body-state is HANDLED (overrides — interaction)
#   COVERED          = body-state is COVERED (overrides — pocketed/face-down)
#   DEGRADED         = one or both inputs weak/unavailable
#
#   mesh-motion-type            one-shot fused type
#   mesh-motion-type --edge     emit only on state change (2-consecutive)
#   mesh-motion-type --json     machine-readable
#   mesh-motion-type --test     smoke test (exit 2 = phone unreachable)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

STATE="$HOME/.mesh/.motion-type.state"
OFFLINEFILE="$HOME/.mesh/.motion-type-offline"

if [ "${1:-}" = --test ]; then
  command -v mesh-gyro >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-gyro)"; exit 1; }
  command -v mesh-body-motion >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-body-motion)"; exit 1; }
  mesh-body-motion --test >/dev/null 2>&1; rc=$?
  [ "$rc" = 2 ] && { echo "smoke-test: n/a (phone unreachable — no motion type)"; exit 2; }
  [ "$rc" = 0 ] || { echo "smoke-test: FAIL (mesh-body-motion --test rc=$rc)"; exit 1; }
  echo "smoke-test: ok"; exit 0
fi

MODE=text; [ "${1:-}" = --json ] && MODE=json
EDGE=0; [ "${1:-}" = --edge ] && EDGE=1
TS=$(date -u +%H:%M:%SZ)

# --- Gyro ---
gyro_j="$(timeout 8 mesh-gyro --json 2>/dev/null)" || gyro_j=""
if [ -n "$gyro_j" ]; then
  gyro_state="$(printf '%s' "$gyro_j" | grep -oE '"state":"[^"]*"' | cut -d'"' -f4)"
  gyro_max="$(printf '%s' "$gyro_j" | grep -oE '"max_rad_s":[0-9.]+' | cut -d: -f2)"
else
  gyro_state="UNKNOWN"; gyro_max=""
fi

# --- Body motion ---
bm_out="$(timeout 12 mesh-body-motion 2>/dev/null)"; bm_rc=$?
if [ "$bm_rc" = 2 ]; then
  if [ ! -f "$OFFLINEFILE" ]; then echo "motion-type: phone unreachable — cannot assess" >&2; touch "$OFFLINEFILE"; fi
  # STDOUT always gets an honest DEGRADED line, every run — the OFFLINEFILE guard above only
  # debounces the one-time stderr operator note. Silencing stdout too (bare `exit 2`, pre-2026-07-09)
  # made this tool's only caller (mesh-sense-monitor) render a dead '(no data)' axis for the ENTIRE
  # phone-offline stretch instead of a real degraded reading (sense-liveness sweep finding).
  case "$MODE" in
    json) printf '{"type":"DEGRADED","gyro_state":"UNKNOWN","body_state":"UNKNOWN","steps_delta":"","reason":"phone unreachable","ts":"%s"}\n' "$TS" ;;
    *)    printf '[motion-type] DEGRADED         — phone unreachable | gyro=%s(max=%s) body=UNKNOWN steps=\n' "$gyro_state" "${gyro_max:-?}" ;;
  esac
  exit 2
fi
rm -f "$OFFLINEFILE"

bm_state="UNKNOWN"; bm_steps=""
if [ -n "$bm_out" ]; then
  bm_tag="$(printf '%s' "$bm_out" | grep -oE '\[body-[a-z]+\]' | tr -d '[]')"
  case "${bm_tag##*-}" in
    still)   bm_state="STILL";;
    carried) bm_state="CARRIED";;
    handled) bm_state="HANDLED";;
    covered) bm_state="COVERED";;
  esac
  bm_steps="$(printf '%s' "$bm_out" | grep -oE 'Δ[+-][0-9]+' | tr -d 'Δ+' | head -1)"
  bm_steps="${bm_steps:-0}"
fi

# --- Fusion ---
type=""; reason=""; signals="gyro=${gyro_state}(max=${gyro_max:-?}) body=${bm_state} steps=${bm_steps}"

if [ "$bm_state" = "HANDLED" ]; then
  type="HANDLED"; reason="phone being handled (body=HANDLED)"
elif [ "$bm_state" = "COVERED" ]; then
  type="COVERED"; reason="phone covered (body=COVERED)"
elif [ "$gyro_state" = "UNKNOWN" ] || [ "$bm_state" = "UNKNOWN" ]; then
  type="DEGRADED"; reason="one or both inputs unavailable"
elif [ "$gyro_state" = "MOVING" ] && [ "$bm_state" = "CARRIED" ]; then
  type="WALKING_TURNING"; reason="walking while turning phone"
elif [ "$gyro_state" = "MOVING" ]; then
  type="ROTATION"; reason="phone being rotated (no stepping)"
elif [ "$bm_state" = "CARRIED" ] && [ "$bm_steps" -gt 0 ] 2>/dev/null; then
  type="TRANSLATION"; reason="walking (steps increasing, no rotation)"
elif [ "$bm_state" = "CARRIED" ]; then
  # CARRIED but 0 steps delta — body-motion may classify as CARRIED from accel alone;
  # treat as potential TRANSLATION with low confidence = TRANSLATION still, but note it
  type="TRANSLATION"; reason="body carried (no recent step delta)"
else
  type="STILL"; reason="no rotation, no translation"
fi

if [ "$MODE" = json ]; then
  printf '{"type":"%s","gyro_state":"%s","body_state":"%s","steps_delta":"%s","reason":"%s","ts":"%s"}\n' \
    "$type" "$gyro_state" "$bm_state" "${bm_steps}" "$reason" "$TS"
  exit 0
fi

if [ "$EDGE" = 1 ]; then
  PENDING="${STATE%.state}.pending"
  confirmed="$(cat "$STATE" 2>/dev/null || true)"
  pending_line="$(cat "$PENDING" 2>/dev/null || true)"
  pending="${pending_line%%:*}"; pcount="${pending_line##*:}"; pcount="${pcount:-0}"

  if [ -z "$confirmed" ]; then
    printf '%s\n' "$type" > "$STATE"; rm -f "$PENDING"
  elif [ "$type" = "$confirmed" ]; then
    rm -f "$PENDING"
  elif [ "$type" = "$pending" ]; then
    pcount=$((pcount + 1))
    if [ "$pcount" -ge 2 ]; then
      printf '%s\n' "$type" > "$STATE"; rm -f "$PENDING"
      printf '[motion-type] %s — %s | %s\n' "$type" "$reason" "$signals"
    else
      printf '%s:%d\n' "$type" "$pcount" > "$PENDING"
    fi
  else
    printf '%s:1\n' "$type" > "$PENDING"
  fi
  exit 0
fi

printf '[motion-type] %-15s — %s | %s\n' "$type" "$reason" "$signals"
