#!/usr/bin/env bash
# mesh-rns-sh — deploy shim for the ssh-FREE Reticulum remote shell/exec channel.
# rnsh (interactive shell) / rnx (one-shot) over an RNS Link — rides the LAN directly (no laggy
# tailscale/egress hop), resumes across drops, same E2E crypto, carries onto radio later. Real tool
# lives at scripts/reticulum/. Deploy this shim, never the real tool (a copy breaks the ref).
# --serve keeps THIS node's listeners up (idempotent; fail-safe — refuses an empty allowlist).
# reflex-cadence: */5 * * * *
# reflex-args: --serve
set -eu
REPO="${MESH_REPO:-$HOME/lte-workstation}"
TARGET="$REPO/scripts/reticulum/mesh-rns-sh.sh"
[ -x "$TARGET" ] || { echo "mesh-rns-sh: n/a — no genome checkout at $TARGET (set MESH_REPO)" >&2; exit 2; }
exec "$TARGET" "$@"
