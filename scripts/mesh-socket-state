#!/usr/bin/env bash
# mesh-socket-state — TCP socket posture from /proc/net/tcp[6]
# Reads the kernel's live TCP connection table — zero subprocesses, instant, no phone needed.
#
# Usage:
#   mesh-socket-state           one-shot verdict to stdout
#   mesh-socket-state --edge    only emit on state change (for cron wiring)
#   mesh-socket-state --json    machine-readable JSON
#   mesh-socket-state --exposure        LISTEN sockets split by BIND ADDRESS (public/loopback/bound)
#   mesh-socket-state --exposure --edge only emit when the PUBLIC set changes
#   mesh-socket-state --test    smoke test
#
# EXPOSURE — WHERE a listener is bound, not just that it exists (2026-08-04, discover→health→genome
# baton). This tool COUNTS listening ports and has never asked what address they are bound to: the
# live reader below extracts the port from `local_address` and discards the IP (the dead
# parse_proc_tcp even assigns `lip_hex` and never uses it). So a service on 127.0.0.1 and one on
# 0.0.0.0 are the same number here — and "3 listening ports" says nothing about whether the node is
# EXPOSED.
#
# That blind spot cost two minds a manual round trip: discover reported phaedra as running
# `ss-server:443/8389, socat:80, trojan:8443, python3:8092 ... all public-listening`; health
# re-probed by hand over SSH and corrected ONE of them — `ss-server:8389` is `LISTEN 127.0.0.1:8389`,
# localhost only, not public. Three of four confirmed, one detail wrong, and the only way to know
# was a human-directed `ss -tlnp`. The kernel had the answer in a field we were already reading.
#
# HONEST CLASSES — this reports what the bind address ITSELF says, and refuses to guess further:
#   PUBLIC    wildcard bind (0.0.0.0 / ::) — reachable on EVERY interface this node has, including
#             any public IP. This is the class that makes a node an ingress.
#   LOOPBACK  127.0.0.0/8 or ::1 — unreachable off-host, whatever the port number suggests.
#   BOUND     a SPECIFIC address — now JUDGED (2026-08-04), by reading the one table that answers it:
#             `ip -o addr show`. Two facts are ANDed, neither guessed — the interface that OWNS the
#             address, and the scope of the address RANGE (PRIVATE/CGNAT/ULA/LINK-LOCAL/GLOBAL).
#             CGNAT-or-ULA on a tailscale iface ⇒ TAILNET; GLOBAL ⇒ a real front door and it says so.
#             No `ip` on the node ⇒ UNJUDGED, the old honest silence, never a fabricated scope.
#             An address on NO local interface ⇒ UNOWNED — a real anomaly, and the reason the
#             comparison is done on canonical bits (see v6_norm) rather than on printed text.
#
# Signals perceived:
#   LISTENING    ports with established listeners (ss -tln equivalent)
#   ESTABLISHED  active TCP sessions (data flowing)
#   TOTAL        total sockets (listening + established + TIME_WAIT etc.)
#
# Classification (5 levels):
#   QUIET       = ≤2 listening ports, 0 established connections
#   SERVING     = ≥3 listening ports OR ≥1 established connection
#   BUSY        = ≥5 listening ports AND ≥3 established connections
#   SATURATED   = ≥10 established connections (possible scan or heavy load)
#   UNCERTAIN   = /proc unreadable (permission denied)
#
# Why this matters: no other sense tells you "is this node actively serving traffic?"
# mesh-net-io sees bytes flowing but not WHY. mesh-socket-state sees the connections.
#
# Exit codes:
#   0 = posture assessed
#   2 = cannot read /proc/net/tcp (permission denied)

set -euo pipefail

STATE_DIR="${MESH_STATE_DIR:-$HOME/.mesh}"
STATE="$STATE_DIR/.socket-state"
PENDING="$STATE_DIR/.socket.pending"
MODE="oneshot"
EDGE_WINDOW=2

for arg in "$@"; do
  case "$arg" in
    --edge) EDGE=1 ;;
    --json) MODE=json ;;
    --exposure) MODE=exposure ;;
    --test) MODE=test ;;
  esac
done
# --exposure --edge and --edge --exposure must mean the same thing whatever the order: the flags are
# read in one pass, so resolving --edge INSIDE the loop would let a later --exposure clobber it (and
# a bare --edge with no other flag must still select the original edge mode).
EDGE="${EDGE:-0}"
if [ "$EDGE" = 1 ] && [ "$MODE" = oneshot ]; then MODE=edge; fi

mkdir -p "$STATE_DIR"

# --- Parse /proc/net/tcp ---
# Format: sl local_address rem_address st tx_queue:rx_queue tr:tm->when retrnsmt uid timeout inode
# State is hex: 01=ESTABLISHED, 0A=LISTEN, 06=TIME_WAIT, etc.
# local_address is hex IP:PORT

declare -A port_state
declare -A port_addr
declare -A port_uid
total=0
listening=0
established=0
time_wait=0
other=0

parse_proc_tcp() {
  local file="$1" label="$2"
  [ -f "$file" ] || return 0
  # Skip header line
  tail -n +2 "$file" 2>/dev/null | while read -r sl local rem st _ rest; do
    [ -z "$sl" ] && continue
    total=$((total + 1))

    # Extract port from local_address (last 4 hex chars after colon)
    local lport_hex="${local##*:}"
    local lport=$((16#${lport_hex})) 2>/dev/null || continue

    # Extract state
    local state_hex="$st"
    local state_name=""
    case "$state_hex" in
      0A) state_name="LISTEN"; listening=$((listening + 1)) ;;
      01) state_name="ESTAB"; established=$((established + 1)) ;;
      06) state_name="TW"; time_wait=$((time_wait + 1)) ;;
      *)  other=$((other + 1)) ;;
    esac

    # Track per-port state (only LISTEN matters)
    if [ "$state_name" = "LISTEN" ]; then
      # Convert hex IP to readable (best-effort)
      local lip_hex="${local%%:*}"
      port_state[$lport]="LISTEN"
      port_addr[$lport]="${label}:${lport}"
    fi
  done
}

# --- Test mode ---
if [ "$MODE" = "test" ]; then
  (
    set +e
    # Test port parsing: simulate LISTEN on port 22
    port_state[22]="LISTEN"
    port_addr[22]="tcp:22"
    listening=1; established=0; total=1; time_wait=0; other=0

    # Test classification
    classify() {
      local l="$1" e="$2" t="$3"
      if [ "$e" -ge 10 ]; then echo "SATURATED"
      elif [ "$l" -ge 5 ] && [ "$e" -ge 3 ]; then echo "BUSY"
      elif [ "$l" -ge 3 ] || [ "$e" -ge 1 ]; then echo "SERVING"
      elif [ "$l" -le 2 ] && [ "$e" -eq 0 ]; then echo "QUIET"
      else echo "UNCERTAIN"; fi
    }

    # Assert 1: quiet (1 listen, 0 estab) → QUIET
    r=$(classify 1 0 1); [ "$r" = "QUIET" ] || { echo "  FAIL: 1/0 → QUIET (got $r)"; exit 1; }
    # Assert 2: serving (3 listen) → SERVING
    r=$(classify 3 0 3); [ "$r" = "SERVING" ] || { echo "  FAIL: 3/0 → SERVING (got $r)"; exit 1; }
    # Assert 3: serving (1 estab) → SERVING
    r=$(classify 1 1 2); [ "$r" = "SERVING" ] || { echo "  FAIL: 1/1 → SERVING (got $r)"; exit 1; }
    # Assert 4: busy (5 listen + 3 estab) → BUSY
    r=$(classify 5 3 8); [ "$r" = "BUSY" ] || { echo "  FAIL: 5/3 → BUSY (got $r)"; exit 1; }
    # Assert 5: saturated (10 estab) → SATURATED
    r=$(classify 2 10 12); [ "$r" = "SATURATED" ] || { echo "  FAIL: 2/10 → SATURATED (got $r)"; exit 1; }
    # Assert 6: port parsing (22 is LISTEN)
    [ "${port_state[22]}" = "LISTEN" ] || { echo "  FAIL: port 22 should be LISTEN"; exit 1; }

    # --- exposure legs (2026-08-04). FUNCTIONAL: they run "$0" --exposure against REAL /proc-format
    # fixtures, so the little-endian decode, the LISTEN filter and the classifier are asserted
    # TOGETHER. MESH_STATE_DIR is redirected at a scratch dir — the edge legs write a state file, and
    # a --test that writes the artifact a reader trusts forges the evidence it exists to check.
    _tx="$(mktemp -d)"
    { echo "  sl  local_address rem_address   st tx_queue rx_queue tr tm->when retrnsmt uid timeout inode"
      echo "   0: 00000000:0016 00000000:0000 0A 00000000:00000000 00:00000000 00000000 0 0 1"
      echo "   1: 0100007F:20C5 00000000:0000 0A 00000000:00000000 00:00000000 00000000 0 0 2"
      echo "   2: E108A8C0:14EB 00000000:0000 0A 00000000:00000000 00:00000000 00000000 0 0 3"
      echo "   3: 0100007F:1F91 0100007F:C350 01 00000000:00000000 00:00000000 00000000 0 0 4"
      echo "   4: 61b24a64:CCF0 00000000:0000 0A 00000000:00000000 00:00000000 00000000 0 0 8"
      echo "   5: 077100cb:20FB 00000000:0000 0A 00000000:00000000 00:00000000 00000000 0 0 9"
      echo "   6: 096433c6:270F 00000000:0000 0A 00000000:00000000 00:00000000 00000000 0 0 10"
      echo "   7: 637100cb:1E61 00000000:0000 0A 00000000:00000000 00:00000000 00000000 0 0 11"
      echo "   8: 05053f64:17AC 00000000:0000 0A 00000000:00000000 00:00000000 00000000 0 0 12"
    } > "$_tx/tcp"
    { echo "  sl  local_address rem_address   st tx_queue rx_queue tr tm->when retrnsmt uid timeout inode"
      echo "   0: 00000000000000000000000000000000:01BB 00000000000000000000000000000000:0000 0A 0 0 0 0 0 5"
      echo "   1: 00000000000000000000000001000000:1F90 00000000000000000000000000000000:0000 0A 0 0 0 0 0 6"
      echo "   2: 5c117afd0000e0a10000000063b23b64:AFBB 00000000000000000000000000000000:0000 0A 0 0 0 0 0 7"
    } > "$_tx/tcp6"
    # The interface table the BOUND verdict reads. Captured `ip -o addr show` FORMAT, and the v6 line
    # is written COMPRESSED exactly as `ip` prints it — the socket decoder renders the same address
    # EXPANDED, so a string-match implementation fails assert 14 and only assert 14.
    { echo "1: lo    inet 127.0.0.1/8 scope host lo"
      echo "1: lo    inet6 ::1/128 scope host"
      echo "2: tailscale0    inet 100.74.178.97/32 scope global tailscale0"
      echo "2: tailscale0    inet6 fd7a:115c:a1e0::643b:b263/128 scope global"
      echo "3: wlan0    inet 192.168.8.225/24 brd 192.168.8.255 scope global wlan0"
      echo "4: eth0    inet 203.0.113.7/24 brd 203.0.113.255 scope global eth0"
      echo "5: tailscale9    inet 203.0.113.99/32 scope global tailscale9"
      echo "4: eth0    inet 100.63.5.5/24 scope global eth0"
    } > "$_tx/ipaddr"
    _xrun(){ MESH_STATE_DIR="$_tx" MESH_SOCKET_TCP="$_tx/tcp" MESH_SOCKET_TCP6="$_tx/tcp6" \
             MESH_SOCKET_IPADDR="$_tx/ipaddr" "$0" "$@"; }
    _xfail(){ echo "  FAIL: $1"; rm -rf "$_tx"; exit 1; }
    out="$(_xrun --exposure)"
    # Assert 7: the wildcard binds are the PUBLIC class, v4 AND v6
    printf '%s\n' "$out" | grep -qx '  PUBLIC   0.0.0.0:22'  || _xfail "0.0.0.0:22 not PUBLIC ($out)"
    printf '%s\n' "$out" | grep -qx '  PUBLIC   :::443'      || _xfail ":::443 (v6 wildcard) not PUBLIC ($out)"
    # Assert 8: THE REGRESSION LEG — the loopback bind health had to correct by hand. 0100007F is
    # 127.0.0.1 read little-endian; a big-endian read makes it 1.0.0.127 and it lands in BOUND, and
    # any "count the listeners" reading calls it exposed. Port 8389 is the real phaedra case.
    printf '%s\n' "$out" | grep -qx '  LOOPBACK 127.0.0.1:8389' || _xfail "127.0.0.1:8389 not LOOPBACK — the little-endian decode or the class is wrong ($out)"
    printf '%s\n' "$out" | grep -q  'PUBLIC.*8389'             && _xfail "a loopback-bound port was reported PUBLIC — the exact overstatement this axis exists to prevent ($out)"
    printf '%s\n' "$out" | grep -qx '  LOOPBACK ::1:8080'      || _xfail "::1 not LOOPBACK ($out)"
    # Assert 9: a specific address is BOUND — named, then judged by the interface that owns it
    printf '%s\n' "$out" | grep -q '^  BOUND    192.168.8.225:5355 *→ PRIVATE (wlan0)' || _xfail "specific addr not BOUND/PRIVATE ($out)"
    # Assert 10: an ESTABLISHED socket is NOT an exposure (st=01 must never reach the report)
    printf '%s\n' "$out" | grep -q ':8081' && _xfail "an ESTABLISHED socket was counted as a listener ($out)"
    printf '%s\n' "$out" | grep -q '^socket-exposure: 2 PUBLIC (wildcard) · 2 LOOPBACK · 7 BOUND (specific addr — 3 on a GLOBAL address)' \
      || _xfail "exposure counts wrong ($out)"
    # Assert 11: --edge is an EDGE — baseline once, then SILENT while the public set holds
    o1="$(_xrun --exposure --edge)"; printf '%s' "$o1" | grep -q 'baseline: PUBLIC' || _xfail "edge did not emit a baseline ($o1)"
    o2="$(_xrun --exposure --edge)"; [ -z "$o2" ] || _xfail "edge re-emitted on an UNCHANGED public set — that is a heartbeat, not an edge ($o2)"
    # Assert 12: a NEW wildcard listener breaks the silence (the alarm arm — 8092 is phaedra's real
    # loc-collector, the listener that appeared and went unnoticed for weeks)
    echo "   4: 00000000:1F9C 00000000:0000 0A 00000000:00000000 00:00000000 00000000 0 0 7" >> "$_tx/tcp"
    o3="$(_xrun --exposure --edge)"; printf '%s' "$o3" | grep -q 'PUBLIC SET CHANGED' || _xfail "a new wildcard listener did not fire the edge ($o3)"
    printf '%s' "$o3" | grep -q '0.0.0.0:8092' || _xfail "the changed set does not name the new port ($o3)"
    # Assert 13: unreadable table ⇒ rc=2 (honest n/a), never an empty all-clear
    MESH_STATE_DIR="$_tx" MESH_SOCKET_TCP="$_tx/nope" MESH_SOCKET_TCP6="$_tx/nope6" "$0" --exposure >/dev/null 2>&1
    [ "$?" = 2 ] || _xfail "missing /proc table did not give rc=2 — an unreadable table is not an unexposed node"

    # --- BOUND reachability legs (2026-08-04, discover→health→genome baton) ---------------------
    # Assert 14: THE REGRESSION LEG. The socket side renders this address EXPANDED
    # ([fd7a:115c:a1e0:0:0:0:643b:b263]); the ipaddr fixture holds it COMPRESSED
    # (fd7a:115c:a1e0::643b:b263). Same 128 bits, two texts. A string-match owner lookup reads
    # UNOWNED here — silently, and on every v6 bind on every node. This leg is the ONLY thing that
    # tells the two implementations apart; seen RED against a v6_norm stubbed to `printf '%s' "$1"`.
    printf '%s\n' "$out" | grep -q '^  BOUND    \[fd7a:115c:a1e0:0:0:0:643b:b263\]:44987 *→ TAILNET (tailscale0, ULA)' \
      || _xfail "compressed-vs-expanded IPv6 broke the owner lookup — the address is tailscale0's own and must read TAILNET, not UNOWNED ($out)"
    # Assert 15: v4 CGNAT on a tailscale iface — the two facts ANDed, not the iface name alone
    printf '%s\n' "$out" | grep -q '^  BOUND    100.74.178.97:52464 *→ TAILNET (tailscale0, CGNAT)' \
      || _xfail "CGNAT-on-tailscale0 not read as TAILNET ($out)"
    # Assert 16: a specific bind to a ROUTABLE address is a front door and must say so — the whole
    # point of judging BOUND at all. If this ever silently degrades, an ingress reads as "not judged".
    printf '%s\n' "$out" | grep -q '^  BOUND    203.0.113.7:8443 *→ GLOBAL (eth0) — a specific bind to a routable address IS a front door' \
      || _xfail "a globally-routable specific bind was not flagged GLOBAL ($out)"
    # Assert 17: an address on NO local interface is UNOWNED — the honest anomaly, never quietly
    # scoped from its range as if some interface held it
    printf '%s\n' "$out" | grep -q '^  BOUND    198.51.100.9:9999 *→ UNOWNED (no local interface holds 198.51.100.9)' \
      || _xfail "an address held by no interface was not reported UNOWNED ($out)"
    # Assert 18: the verdict is the two facts ANDed, NOT the interface name. A tailscale-named iface
    # holding a globally-routable address must read GLOBAL — an iface-name shortcut would launder a
    # real front door into "tailnet-only", the worst direction for this tool to be wrong in.
    printf '%s\n' "$out" | grep -q '^  BOUND    203.0.113.99:7777 *→ GLOBAL (tailscale9)' \
      || _xfail "a routable address on a tailscale-named iface was laundered as TAILNET — the verdict is reading the iface NAME, not the address range ($out)"
    # Assert 19: the CGNAT range is 100.64/10, not 100/8. 100.63.5.5 is ordinary routable space; a
    # sloppy '100.*' match calls it tailnet-only and hides an exposure.
    printf '%s\n' "$out" | grep -q '^  BOUND    100.63.5.5:6060 *→ GLOBAL (eth0)' \
      || _xfail "100.63.5.5 is BELOW the 100.64/10 CGNAT range and must read GLOBAL, not CGNAT ($out)"
    # Assert 20: no interface table ⇒ UNJUDGED everywhere, never a fabricated scope. This is the old
    # honest silence, and it must survive — a node without `ip` must not start guessing.
    onoip="$(MESH_STATE_DIR="$_tx" MESH_SOCKET_TCP="$_tx/tcp" MESH_SOCKET_TCP6="$_tx/tcp6" \
             MESH_SOCKET_IPADDR="$_tx/absent" "$0" --exposure)"
    printf '%s\n' "$onoip" | grep -q 'reachability not judged' \
      || _xfail "with no interface table the summary still claimed a judgement ($onoip)"
    printf '%s\n' "$onoip" | grep -qE 'TAILNET|GLOBAL|PRIVATE|UNOWNED' \
      && _xfail "with no interface table a scope was INVENTED — absent input must render UNJUDGED, not a guess ($onoip)"
    printf '%s\n' "$onoip" | grep -q '→ UNJUDGED (no `ip` — interface table unread)' \
      || _xfail "missing interface table did not render UNJUDGED on the rows ($onoip)"
    rm -rf "$_tx"

    echo "smoke-test: ok (20 assertions: quiet→QUIET, 3-listen→SERVING, 1-estab→SERVING, 5+3→BUSY, 10-estab→SATURATED, port-parse→LISTEN, exposure public/loopback/bound + estab-excluded + edge silent/fires + rc2 + BOUND judged: v6-compressed→TAILNET, v4-CGNAT→TAILNET, routable→GLOBAL, no-iface→UNOWNED, iface-name≠verdict, CGNAT-boundary, no-ip→UNJUDGED)"
  )
  exit $?
fi

TS=$(date -u '+%Y-%m-%dT%H:%M:%SZ')

# --- exposure mode: LISTEN sockets classified by BIND ADDRESS (see the header) -------------------
# Fixture-overridable so --test drives REAL /proc-format tables instead of asserting a helper in
# isolation; the parser and the classifier are exercised together, as one organ.
PROC_TCP="${MESH_SOCKET_TCP:-/proc/net/tcp}"
PROC_TCP6="${MESH_SOCKET_TCP6:-/proc/net/tcp6}"

# /proc/net/tcp local_address is hex, LITTLE-ENDIAN per byte: 0100007F is 127.0.0.1, not 1.0.0.127.
# Reading it big-endian would misclassify every loopback bind as a routable address — the exact
# error, inverted, that this axis exists to prevent.
v4_from_hex() { printf '%d.%d.%d.%d' "$((16#${1:6:2}))" "$((16#${1:4:2}))" "$((16#${1:2:2}))" "$((16#${1:0:2}))"; }

# tcp6 is FOUR little-endian 32-bit words, so the byte swap is per-word, not across the whole 32
# chars. Rendered as all 8 groups with leading zeros stripped — no "::" compression, because a
# half-right address compressor is worse than a long correct one for something a human will compare
# against `ss -tln` by eye.
v6_from_hex() {
  local h="$1" w b out="" i j g
  for i in 0 8 16 24; do
    w="${h:$i:8}"; b="${w:6:2}${w:4:2}${w:2:2}${w:0:2}"
    for j in 0 4; do g="${b:$j:4}"; g="$(printf '%x' "$((16#$g))")"; out="${out}${g}:"; done
  done
  printf '%s' "${out%:}"
}

classify_addr() { # <dotted-or-v6-text> -> PUBLIC | LOOPBACK | BOUND
  case "$1" in
    0.0.0.0|::)  echo PUBLIC ;;
    127.*|::1)   echo LOOPBACK ;;
    *)           echo BOUND ;;
  esac
}

# --- BOUND reachability: which local interface owns the address (2026-08-04) --------------------
# The header used to stop at "prints the address, does NOT claim a verdict" because the routing/
# interface table was out of scope. It is one read away, and the class was printed but never
# judged — so every BOUND row, on every node, said exactly nothing.
#
# The trap this closes: `ip` renders IPv6 COMPRESSED (fd7a:115c:a1e0::643b:b263) while the tcp6
# decoder above renders it EXPANDED (fd7a:115c:a1e0:0:0:0:643b:b263). Same 128 bits, two texts —
# a naive string-match reads "no interface owns this" on EVERY v6 bind on EVERY node, forever, and
# silently: the failure looks like a legitimate UNOWNED. So both sides are canonicalized to the
# fully-expanded 8×4-hex form before comparing, never string-matched as printed. Sibling of the
# little-endian trap in assert 8 — same lesson (a text rendering is not the value), one layer down.
#
# v6_norm: any textual IPv6 -> 8 lowercase 4-digit groups. rc=1 on anything it cannot parse, so a
# malformed address drops out of the map instead of poisoning it with a plausible key.
v6_norm() {
  local a="$1" v4 pre o1 o2 o3 o4 left right hasdc=0 fill i g out=""
  a="${a#[}"; a="${a%]}"; a="${a%%\%*}"          # brackets + zone id (%eth0)
  case "$a" in
    *[!0-9A-Fa-f:.]*|*:::*|"") return 1 ;;
  esac
  case "$a" in *.*)                               # embedded v4 tail -> two hex groups
      v4="${a##*:}"; pre="${a%:*}"
      case "$v4" in *.*.*.*) ;; *) return 1 ;; esac
      IFS=. read -r o1 o2 o3 o4 <<<"$v4"
      { [ -n "${o4:-}" ] && [ "$o1" -le 255 ] && [ "$o2" -le 255 ] && [ "$o3" -le 255 ] && [ "$o4" -le 255 ]; } 2>/dev/null || return 1
      a="${pre}:$(printf '%x:%x' "$(( (o1<<8)|o2 ))" "$(( (o3<<8)|o4 ))")" ;;
  esac
  case "$a" in
    *::*) hasdc=1; left="${a%%::*}"; right="${a##*::}" ;;
    *)    left="$a"; right="" ;;
  esac
  local -a L=() R=()
  [ -n "$left"  ] && IFS=: read -r -a L <<<"$left"
  [ -n "$right" ] && IFS=: read -r -a R <<<"$right"
  fill=$(( 8 - ${#L[@]} - ${#R[@]} ))
  if [ "$hasdc" = 1 ]; then [ "$fill" -ge 0 ] || return 1
  else [ "$fill" -eq 0 ] || return 1; fill=0; fi
  for ((i=0; i<${#L[@]}; i++)); do
    g="${L[i]}"; case "$g" in ""|*[!0-9A-Fa-f]*) return 1 ;; esac; [ "${#g}" -le 4 ] || return 1
    out="${out}$(printf '%04x' "$((16#$g))"):"
  done
  for ((i=0; i<fill; i++)); do out="${out}0000:"; done
  for ((i=0; i<${#R[@]}; i++)); do
    g="${R[i]}"; case "$g" in ""|*[!0-9A-Fa-f]*) return 1 ;; esac; [ "${#g}" -le 4 ] || return 1
    out="${out}$(printf '%04x' "$((16#$g))"):"
  done
  printf '%s' "${out%:}"
}

# addr_key: the comparable form of EITHER side (socket-decoded or ip-reported). v4 dotted-decimal is
# already canonical on both sides; v6 goes through v6_norm.
addr_key() {
  case "$1" in
    *:*) v6_norm "$1" ;;
    *)   printf '%s' "$1" ;;
  esac
}

# addr_scope: what the ADDRESS RANGE says about reachability — a fact about the bits, independent of
# any interface name. Ranges, not vibes.
addr_scope() { # <canonical-key> -> PRIVATE | CGNAT | LINK-LOCAL | ULA | GLOBAL
  local k="$1" a b
  case "$k" in
    *:*) case "${k%%:*}" in
           fe8?|fe9?|fea?|feb?) echo LINK-LOCAL ;;
           f[cd]??)             echo ULA ;;
           *)                   echo GLOBAL ;;
         esac ;;
    *)   a="${k%%.*}"; b="${k#*.}"; b="${b%%.*}"
         case "$a" in
           10)          echo PRIVATE ;;
           192)         [ "$b" = 168 ] && echo PRIVATE || echo GLOBAL ;;
           172)         { [ "$b" -ge 16 ] && [ "$b" -le 31 ]; } && echo PRIVATE || echo GLOBAL ;;
           100)         { [ "$b" -ge 64 ] && [ "$b" -le 127 ]; } && echo CGNAT || echo GLOBAL ;;
           169)         [ "$b" = 254 ] && echo LINK-LOCAL || echo GLOBAL ;;
           *)           echo GLOBAL ;;
         esac ;;
  esac
}

if [ "$MODE" = exposure ]; then
  [ -r "$PROC_TCP" ] || { echo "socket-exposure: UNCERTAIN — cannot read $PROC_TCP"; exit 2; }

  # Interface map, read ONCE (one subprocess in this mode only — the oneshot/edge path stays
  # subprocess-free). Fixture-overridable so --test drives a captured `ip -o addr show` instead of
  # this machine's live interfaces, which no assertion could depend on.
  declare -A IFACE_OF=()
  HAVE_IFMAP=0
  _ipaddr_lines() {
    if [ -n "${MESH_SOCKET_IPADDR:-}" ]; then [ -f "$MESH_SOCKET_IPADDR" ] && cat "$MESH_SOCKET_IPADDR"
    elif command -v ip >/dev/null 2>&1; then ip -o addr show 2>/dev/null
    fi
  }
  while read -r _ ifc fam iaddr _; do
    case "${fam:-}" in inet|inet6) ;; *) continue ;; esac
    iaddr="${iaddr%%/*}"
    ikey="$(addr_key "$iaddr")" || continue
    [ -n "$ikey" ] || continue
    IFACE_OF["$ikey"]="$ifc"; HAVE_IFMAP=1
  done < <(_ipaddr_lines)

  # bound_verdict: the two facts, ANDed, never guessed. Absent `ip` ⇒ UNJUDGED (the old honest
  # silence), never a fabricated scope. Address on no local interface ⇒ UNOWNED, which is a real
  # anomaly worth seeing, not a parser artefact — that is exactly why v6_norm exists.
  bound_verdict() { # <printed-addr> -> "<VERDICT> (<detail>)"
    local a="$1" k sc ifc
    [ "$HAVE_IFMAP" = 1 ] || { printf 'UNJUDGED (no `ip` — interface table unread)'; return; }
    a="${a#[}"; a="${a%]}"
    k="$(addr_key "$a")" || k=""
    [ -n "$k" ] || { printf 'UNJUDGED (unparseable address)'; return; }
    ifc="${IFACE_OF[$k]:-}"
    sc="$(addr_scope "$k")"
    if [ -z "$ifc" ]; then printf 'UNOWNED (no local interface holds %s)' "$a"; return; fi
    # Scope comes from the address RANGE (RFC-defined, identical on every node); the interface NAME is
    # printed as the fact it is. The one name-sensitive branch is the TAILNET fold, and it only ever
    # sharpens a label that is already correct — an unrecognised iface name holding the same CGNAT/ULA
    # address still reads "CGNAT (foo0) — not globally routable". Name-prefix taxonomies drift per node
    # (discover's own caveat when filing this); a scope read from the bits does not.
    case "$ifc:$sc" in
      tailscale*:CGNAT|tailscale*:ULA) printf 'TAILNET (%s, %s) — tailnet-only' "$ifc" "$sc" ;;
      *:GLOBAL)                        printf 'GLOBAL (%s) — a specific bind to a routable address IS a front door' "$ifc" ;;
      *)                               printf '%s (%s) — not globally routable' "$sc" "$ifc" ;;
    esac
  }

  rows=""
  while read -r _ local _ st _; do
    [ -z "$local" ] && continue
    [ "$st" = "0A" ] || continue                       # LISTEN only — an ESTABLISHED peer address
    hex="${local%%:*}"; pt="${local##*:}"              # is not an exposure, and counting it would
    port=$((16#$pt))                                   # make every outbound connection look served
    case "${#hex}" in
      8)  addr="$(v4_from_hex "$hex")" ;;
      32) case "$hex" in
            00000000000000000000000000000000) addr="::" ;;
            00000000000000000000000001000000) addr="::1" ;;
            0000000000000000FFFF0000*)        addr="$(v4_from_hex "${hex:24:8}")" ;;   # v4-mapped
            *)                                addr="[$(v6_from_hex "$hex")]" ;;
          esac ;;
      *)  continue ;;
    esac
    cls="$(classify_addr "$addr")"
    vd=""; [ "$cls" = BOUND ] && vd="$(bound_verdict "$addr")"
    rows="${rows}${cls}	${addr}:${port}	${vd}
"
  done < <(for f in "$PROC_TCP" "$PROC_TCP6"; do [ -f "$f" ] && tail -n +2 "$f"; done 2>/dev/null)

  pub=$(printf '%s' "$rows" | grep -c '^PUBLIC' || true)
  lo=$(printf  '%s' "$rows" | grep -c '^LOOPBACK' || true)
  bd=$(printf  '%s' "$rows" | grep -c '^BOUND' || true)
  # A BOUND row that lands on a GLOBAL address is an ingress exactly as much as a wildcard one — it
  # belongs in the headline, not buried in the list. Counted, not folded into the PUBLIC set: the
  # edge fingerprint below is the WILDCARD set, and silently redefining it would re-baseline every
  # node's state file at once and read as "the public set changed" on all of them.
  bg=$(printf '%s' "$rows" | awk -F'\t' '$1=="BOUND" && $3 ~ /^GLOBAL/' | grep -c . || true)
  # The PUBLIC set is the thing worth watching for change — a new wildcard listener is a new front
  # door. Sorted + deduped so the fingerprint is stable across reboots and socket churn.
  pubset="$(printf '%s' "$rows" | awk -F'\t' '$1=="PUBLIC"{print $2}' | sort -u | tr '\n' ' ')"

  if [ "$EDGE" = 1 ]; then
    XSTATE="$STATE_DIR/.socket-exposure"
    prev=""; [ -f "$XSTATE" ] && prev="$(head -1 "$XSTATE")"
    if [ "$pubset" = "$prev" ]; then exit 0; fi        # unchanged ⇒ silent (this is the edge)
    printf '%s\n' "$pubset" > "$XSTATE"
    if [ -z "$prev" ]; then printf '[socket-exposure] baseline: PUBLIC = %s\n' "${pubset:-<none>}"
    else printf '[socket-exposure] PUBLIC SET CHANGED\n  was: %s\n  now: %s\n' "${prev:-<none>}" "${pubset:-<none>}"; fi
    exit 0
  fi

  bnote="specific addr, judged by owning interface"
  [ "$bg" -gt 0 ] && bnote="specific addr — ${bg} on a GLOBAL address"
  [ "$HAVE_IFMAP" = 1 ] || bnote="specific addr, reachability not judged (no \`ip\`)"
  printf 'socket-exposure: %d PUBLIC (wildcard) · %d LOOPBACK · %d BOUND (%s)\n' \
    "$pub" "$lo" "$bd" "$bnote"
  printf '%s' "$rows" | sort -t'	' -k1,1 -k2,2V \
    | awk -F'\t' '{ if ($3 != "") printf "  %-8s %-40s → %s\n", $1, $2, $3; else printf "  %-8s %s\n", $1, $2 }'
  exit 0
fi

# --- Read /proc/net/tcp and tcp6 ---
# --- Read /proc/net/tcp and tcp6 ---
total=0; listening=0; established=0; time_wait=0; other=0
while read -r _ local rem st _; do
  [ -z "$local" ] && continue
  lport_hex="${local##*:}"
  lport=$((16#${lport_hex})) 2>/dev/null || continue
  total=$((total + 1))
  case "$st" in
    0A) listening=$((listening + 1)) ;;
    01) established=$((established + 1)) ;;
    06) time_wait=$((time_wait + 1)) ;;
    *)  other=$((other + 1)) ;;
  esac
done < <(for f in /proc/net/tcp /proc/net/tcp6; do [ -f "$f" ] && tail -n +2 "$f"; done 2>/dev/null)

# Default if nothing parsed
: "${total:=0}" "${listening:=0}" "${established:=0}" "${time_wait:=0}" "${other:=0}"

# --- Classification ---
verdict="UNCERTAIN"; reason=""
if [ "$established" -ge 10 ]; then
  verdict="SATURATED"; reason="${established} established connections (possible scan or heavy load)"
elif [ "$listening" -ge 5 ] && [ "$established" -ge 3 ]; then
  verdict="BUSY"; reason="${listening} listening + ${established} established"
elif [ "$listening" -ge 3 ] || [ "$established" -ge 1 ]; then
  verdict="SERVING"; reason="${listening} listening + ${established} established"
elif [ "$listening" -le 2 ] && [ "$established" -eq 0 ]; then
  verdict="QUIET"; reason="${listening} listening ports, no active connections"
else
  verdict="UNCERTAIN"; reason="${listening} listening + ${established} established (unusual mix)"
fi

# Check /proc readability
if [ ! -r /proc/net/tcp ]; then
  verdict="UNCERTAIN"; reason="cannot read /proc/net/tcp (permission denied)"
fi

# --- Edge mode ---
if [ "$MODE" = "edge" ]; then
  confirmed=""
  [ -f "$STATE" ] && confirmed="$(head -1 "$STATE")"
  pending=""; pcount=0
  [ -f "$PENDING" ] && { pending="$(head -1 "$PENDING" | cut -d: -f1)"; pcount="$(head -1 "$PENDING" | cut -d: -f2)"; }

  if [ "$verdict" = "$confirmed" ]; then
    :
  elif [ "$verdict" = "$pending" ]; then
    pcount=$((pcount + 1))
    echo "${pending}:${pcount}" > "$PENDING"
    if [ "$pcount" -ge "$EDGE_WINDOW" ]; then
      echo "$verdict" > "$STATE"
      rm -f "$PENDING"
      echo "[socket-state] $verdict — $reason"
    fi
  else
    echo "${verdict}:1" > "$PENDING"
  fi
fi

# --- Output ---
case "$MODE" in
  oneshot|edge)
    printf 'socket-state: %s — %s [listen=%s estab=%s tw=%s total=%s]\n' \
      "$verdict" "$reason" "$listening" "$established" "$time_wait" "$total"
    ;;
  json)
    printf '{"verdict":"%s","reason":"%s","listening":%d,"established":%d,"time_wait":%d,"total":%d,"ts":"%s"}\n' \
      "$verdict" "$reason" "$listening" "$established" "$time_wait" "$total" "$TS"
    ;;
esac

exit 0
