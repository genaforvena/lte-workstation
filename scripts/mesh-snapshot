#!/usr/bin/env bash
# mesh-snapshot — partial, peer-replicated backup of a node's tmux scrollback (its recent memory).
# smoke-test: --test checks tmux session exists + snapshot dir writable
#
# A node's tmux session is its volatile recent memory; death wipes it. This captures the
# scrollback of every window and pushes a copy to a PEER node, so a destroyed node's recent
# state survives — partially — on a neighbor. NOT resurrection (no live panes restored): a
# bounded TEXT copy for recall. Memory becomes gossiped, in the mesh's web-of-trust spirit;
# local decay still happens, but a node is no longer an island.
#
#   mesh-snapshot                  capture this node's session -> ~/.mesh/snapshots + push to peer
#   mesh-snapshot --recall <node>  open a 'recall:<node>' window showing that node's last snapshot
#   mesh-snapshot --peers          list snapshots this node holds (its own + neighbors')
#   mesh-snapshot --loop [sec]     snapshot every N sec (default 600) — run in a tmux window
#   mesh-snapshot --blueprint [f]  capture the node's REPLICATION GENOTYPE (genome HEAD + card minds/caps
#                                  + mind-channel config + live window set + reflex/tool manifest) — the
#                                  "snapshot of the running node as a blueprint" a replica reconstitutes from
#   mesh-snapshot --replicate [f]  DRY-RUN reconstitution plan from a blueprint (spawns NOTHING — agent
#                                  replication is card-gated mesh-restore; this only prints the plan)
#   mesh-snapshot --test           smoke test: deps + dry-run capture (exit 0 if pipeline works)
#
# SELF-REPLICATION (study 'self-replication' brief 2026-06-11): the scrollback save above is EPISODIC
# memory (what the node experienced). A replica also needs the GENOTYPE — the replicable configuration
# that makes this a working agent. --blueprint captures that genotype; reconstitution = carry genome+card
# to the target and run mesh-restore (idempotent, CARD-GATED: a card declaring no minds spawns no minds).
# Deliberately NO auto-spawn here: an agent-spawner that forks without the card's consent is the canonical
# runaway-replication risk the card-gating exists to prevent — so the dangerous actuator stays mesh-restore.
#
# Config: SNAP_PEER (<ts-ip>), SNAP_USER (username), SNAP_LINES (400), SNAP_KEEP (5)
set -uo pipefail
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes"
DIR="$HOME/.mesh/snapshots"; mkdir -p "$DIR"
HOST="$(hostname)"; SESSION="$HOST"
USER_R="${SNAP_USER:-$(whoami)}"
PEER="${SNAP_PEER:-}"
# Cross-node resilience needs SOME peer to hold the copy. The supervised `--loop` invocation passes no
# SNAP_PEER, so without a fallback line ~47 silently no-ops the push EVERY run → a destroyed node's
# scrollback never survives, the exact failure this tool exists to prevent (verify 2026-06-13). Derive
# a default peer from the registry: first MIND/compute node that isn't self/router/sense. (Same
# registry-resolve pattern as the knowledge-sync / tg-watchdog hollow-host fixes — no hardcoded names.)
if [ -z "$PEER" ]; then
  _myip="$(tailscale ip -4 2>/dev/null | head -1)"
  for _e in ${MESH_NODES:-}; do
    _l="${_e%%:*}"; _role=""
    for _r in ${MESH_ROLES:-}; do [ "${_r%%:*}" = "$_l" ] && _role="${_r#*:}"; done
    case "$_role" in router|sense) continue ;; esac
    _cip="$(mesh-peer-addr "$_l" 2>/dev/null)" || continue
    [ -n "$_cip" ] && [ "$_cip" != "$_myip" ] && { PEER="$_cip"; break; }
  done
fi
LINES="${SNAP_LINES:-400}"; KEEP="${SNAP_KEEP:-5}"

save() {
  local f="$DIR/$HOST.txt" ts lock="$DIR/.snapshot.lock"
  ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  # simple pid lock — skip if another save is active
  if [ -f "$lock" ] && kill -0 "$(cat "$lock" 2>/dev/null)" 2>/dev/null; then
    echo "snapshot $HOST skipped (previous save still running)"
    return 0
  fi
  echo "$$" > "$lock"
  {
    echo "=== mesh-snapshot  $HOST  @ $ts ==="
    for w in $(tmux list-windows -t "$SESSION" -F '#{window_index}:#{window_name}' 2>/dev/null); do
      printf '\n----- window %s -----\n' "$w"
      tmux capture-pane -t "$SESSION:${w%%:*}" -p -S "-$LINES" 2>/dev/null | sed '/^[[:space:]]*$/d'
    done
  } > "$f.new" 2>/dev/null
  mv -f "$f.new" "$f" 2>/dev/null || true
  rm -f "$lock"
  [ -f "$f" ] || { echo "snapshot $HOST failed"; return 1; }
  cp "$f" "$DIR/$HOST-$(date -u +%Y%m%dT%H%M%SZ).txt" 2>/dev/null || true
  ls -1t "$DIR/$HOST-"*.txt 2>/dev/null | tail -n +$((KEEP+1)) | xargs -r rm -f
  echo "snapshot $HOST ($(wc -l <"$f") lines) saved"
  [ -z "$PEER" ] && return 0
  local myip; myip="$(tailscale ip -4 2>/dev/null | head -1)"
  [ "$PEER" = "$myip" ] && return 0
  if ssh -o BatchMode=yes -o ConnectTimeout=8 "$USER_R@$PEER" 'mkdir -p ~/.mesh/snapshots' 2>/dev/null \
     && scp -q -o BatchMode=yes -o ConnectTimeout=8 "$f" "$USER_R@$PEER:.mesh/snapshots/$HOST.txt" 2>/dev/null; then
    echo "snapshot pushed to $PEER"
    if [ -d "$HOME/.mesh/knowledge" ] && [ -n "$(ls -A "$HOME/.mesh/knowledge" 2>/dev/null)" ]; then
      ssh -o BatchMode=yes -o ConnectTimeout=8 "$USER_R@$PEER" 'mkdir -p ~/.mesh/knowledge' 2>/dev/null \
        && scp -qr -o BatchMode=yes -o ConnectTimeout=8 "$HOME/.mesh/knowledge/." "$USER_R@$PEER:.mesh/knowledge/" 2>/dev/null \
        && echo "knowledge gossiped to $PEER"
    fi
    # BOARD DURABILITY (board-durability, genome 2026-07-06): chat.log is the mesh's coordination MEMORY
    # (dispatch dedup, [done] cites, verify scans) yet this push only ever shipped tmux SCROLLBACK — a
    # wiped board restored solely from a mind's session ctx. Ride the SAME proven peer-push to gossip the
    # newest board off-node (layer 3 of board-durability; layers 1-2 = rotate+shrink-refuse in
    # mesh-chat-sync), so a destroyed node's board survives on a peer at ~/.mesh/board-snapshots/chat-$HOST.log.
    if [ -s "$HOME/.mesh/chat.log" ]; then
      ssh -o BatchMode=yes -o ConnectTimeout=8 "$USER_R@$PEER" 'mkdir -p ~/.mesh/board-snapshots' 2>/dev/null \
        && scp -q -o BatchMode=yes -o ConnectTimeout=8 "$HOME/.mesh/chat.log" "$USER_R@$PEER:.mesh/board-snapshots/chat-$HOST.log" 2>/dev/null \
        && echo "board gossiped to $PEER"
    fi
  fi
}

# blueprint — capture the node's REPLICATION GENOTYPE (config needed to reconstitute a working agent),
# distinct from save()'s scrollback (episodic memory). Read-only; writes one self-contained file.
blueprint() {
  local out="${1:-$DIR/blueprint-$HOST-$(date -u +%Y%m%dT%H%M%SZ).txt}"
  local repo="${MESH_REPO:-$HOME/lte-workstation}"
  local card="$HOME/.mesh-card" renv="$HOME/.mesh/restore.env" rcron="$HOME/.mesh/reflexes.cron"
  {
    echo "# mesh replication BLUEPRINT (genotype of the running node — reconstitute via mesh-restore)"
    echo "# host: $HOST"
    echo "# captured: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo
    echo "## GENOME (code blueprint)"
    echo "head: $(git -C "$repo" rev-parse --short HEAD 2>/dev/null || echo UNKNOWN)"
    echo "origin: $(git -C "$repo" remote get-url origin 2>/dev/null || echo none)"
    echo
    echo "## CARD (declared capabilities / minds / roles — the phenotype contract that GATES replication)"
    if [ -f "$card" ]; then grep -iE '^(minds|caps|capabilit|role|node|host)' "$card" 2>/dev/null || sed -n '1,12p' "$card" 2>/dev/null || true; else echo "(no card — a HANDS-OFF node: replication spawns no minds)"; fi
    echo
    echo "## MIND CHANNELS (which agents to spawn — node-local restore.env)"
    if [ -f "$renv" ]; then grep -E 'MESH_MIND_CHANNELS|MESH_[A-Z]*_CMD|MESH_MIND_WORKERS' "$renv" 2>/dev/null || echo "(restore.env present, no mind-channel overrides → genome default set)"; else echo "(no restore.env → genome default channel set)"; fi
    echo
    echo "## CHANNELS LIVE NOW (the running window set being snapshotted)"
    tmux list-windows -t "$SESSION" -F '  #{window_index} #{window_name} (#{window_panes}p)' 2>/dev/null || echo "  (no live session)"
    echo
    echo "## REFLEXES (autonomic loops — desired-set size)"
    if [ -f "$rcron" ]; then echo "active-lines: $(grep -cvE '^[[:space:]]*#|^[[:space:]]*$' "$rcron" 2>/dev/null || echo 0)"; else echo "(no reflexes.cron)"; fi
    echo
    echo "## TOOLSET (deployed mesh-* manifest)"
    echo "count: $(ls "$HOME/.local/bin/"mesh-* 2>/dev/null | wc -l)"
    echo "manifest-sha: $(ls "$HOME/.local/bin/"mesh-* 2>/dev/null | xargs -r -n1 basename | sort | sha1sum 2>/dev/null | cut -c1-12)"
    echo
    echo "## RECONSTITUTE (how a replica is grown from this genotype)"
    echo "  1. clone/pull genome 'origin' to 'head' above; mesh-sync-tools --apply (deploy mesh-* → ~/.local/bin)"
    echo "  2. place ~/.mesh-card with the minds/caps above + restore.env mind-channel config"
    echo "  3. run: mesh-restore   (idempotent, CARD-GATED — spawns minds ONLY if the card declares them)"
  } > "$out"
  echo "blueprint → $out"
  echo "  $(grep -c '^##' "$out" 2>/dev/null) sections | genome $(awk '/^head:/{print $2; exit}' "$out") | tools $(awk '/^count:/{print $2; exit}' "$out")"
}

case "${1:-}" in
  --test)    fail=0
    command -v tmux >/dev/null 2>&1 || { echo "  FAIL: tmux not found"; fail=1; }
    command -v ssh >/dev/null 2>&1 || { echo "  FAIL: ssh not found"; fail=1; }
    command -v scp >/dev/null 2>&1 || { echo "  FAIL: scp not found"; fail=1; }
    command -v tailscale >/dev/null 2>&1 || { echo "  FAIL: tailscale not found"; fail=1; }
    tmux has-session -t "$SESSION" 2>/dev/null || { echo "  FAIL: tmux session '$SESSION' not found"; fail=1; }
    [ -d "$DIR" ] || { echo "  FAIL: snapshot dir '$DIR' not writable"; fail=1; }
    # dry-run: capture one window to prove capture pipeline works
    _win="$(tmux list-windows -t "$SESSION" -F '#{window_index}' 2>/dev/null | head -1)"
    [ -n "$_win" ] || { echo "  FAIL: no windows in session"; fail=1; }
    _cap="$(tmux capture-pane -t "$SESSION:$_win" -p -S -5 2>/dev/null | wc -l)"
    [ "$_cap" -gt 0 ] 2>/dev/null || { echo "  FAIL: capture-pane returned empty"; fail=1; }
    echo "  ok: capture-pane works (window $_win, $_cap lines)"
    # check peer resolution tailscale works
    _myip="$(tailscale ip -4 2>/dev/null | head -1)"
    [ -n "$_myip" ] || { echo "  FAIL: tailscale ip -4 returned nothing"; fail=1; }
    echo "  ok: peer IP resolved ($_myip)"
    # blueprint: capture the genotype to a temp file, assert the replicable sections are present
    _bp="$(mktemp)"; blueprint "$_bp" >/dev/null 2>&1
    for _s in GENOME CARD "MIND CHANNELS" REFLEXES TOOLSET RECONSTITUTE; do
      grep -q "^## .*$_s" "$_bp" 2>/dev/null || { echo "  FAIL: blueprint missing section: $_s"; fail=1; }
    done
    echo "  ok: blueprint captures $(grep -c '^##' "$_bp" 2>/dev/null) genotype sections"
    # replicate dry-run must print the plan and spawn NOTHING (no tmux window, no mind process)
    _rep="$(MESH_DIR= "$0" --replicate "$_bp" 2>&1)"
    printf '%s' "$_rep" | grep -q 'DRY-RUN' || { echo "  FAIL: --replicate not a dry-run"; fail=1; }
    printf '%s' "$_rep" | grep -q 'spawns NOTHING\|No agent is forked\|spawns nothing' || { echo "  FAIL: --replicate missing the no-spawn safety guarantee"; fail=1; }
    rm -f "$_bp"
    # board-durability layer 3: the board is gossiped to the peer only when chat.log is non-empty (-s guard).
    _bl="$(mktemp)"; printf '2026-06-12T06:00:00Z  a@n  ::  [x] line\n' > "$_bl"
    [ -s "$_bl" ] || { echo "  FAIL: board-push guard — non-empty chat.log should pass -s"; fail=1; }
    : > "$_bl"; [ -s "$_bl" ] && { echo "  FAIL: board-push guard — empty chat.log must NOT pass -s"; fail=1; }
    rm -f "$_bl"
    grep -q 'board-snapshots/chat-\$HOST.log' "$0" || { echo "  FAIL: board-push block missing (layer 3 not wired)"; fail=1; }
    echo "  ok: board-durability layer 3 present + guarded"
    [ "$fail" = 0 ] && echo "smoke-test: ok" && exit 0 || { echo "smoke-test: FAIL"; exit 1; } ;;
  ""|--save) save ;;
  --recall)
    node="${2:?usage: mesh-snapshot --recall <node>}"; f="$DIR/$node.txt"
    [ -f "$f" ] || { echo "no snapshot for '$node' here. have: $(ls "$DIR"/*.txt 2>/dev/null | xargs -rn1 basename | tr '\n' ' ')"; exit 1; }
    tmux has-session -t "$SESSION" 2>/dev/null || tmux new-session -d -s "$SESSION"
    tmux new-window -t "$SESSION" -n "recall:$node" "less '$f'"
    echo "opened 'recall:$node' window from the snapshot held here ($(head -1 "$f"))"
    ;;
  --peers) ls -la "$DIR"/*.txt 2>/dev/null | awk '{print "  "$NF" ("$5"b)"}' || echo "no snapshots yet" ;;
  --loop)
    iv="${2:-600}"; echo "[mesh-snapshot] every ${iv}s: $HOST -> $PEER"
    # liveness beat (intel audit 2026-06-10): wedged loop ≠ healthy-quiet loop
    while true; do save; : > "$HOME/.mesh/mesh-snapshot.beat"; sleep "$iv"; done ;;
  --blueprint) blueprint "${2:-}" ;;
  --replicate)
    bp="${2:-$(ls -t "$DIR"/blueprint-*.txt 2>/dev/null | head -1)}"
    [ -n "$bp" ] && [ -f "$bp" ] || { echo "mesh-snapshot --replicate: no blueprint found — run 'mesh-snapshot --blueprint' first, or pass a file" >&2; exit 1; }
    echo "=== REPLICATION PLAN (DRY-RUN — spawns NOTHING) from $bp ==="
    sed -n '/^## GENOME/,/^## CHANNELS LIVE/p' "$bp" | grep -vE '^## CHANNELS LIVE'
    sed -n '/^## RECONSTITUTE/,$p' "$bp"
    echo
    echo "SAFETY: this command forks NO agent. Self-replication = reconstitution via mesh-restore, which is"
    echo "CARD-GATED (a node whose card declares no minds gets NO minds) and idempotent. To grow a replica:"
    echo "  • on THIS node:  run 'mesh-restore'  (re-establishes the channel set above)"
    echo "  • on a PEER:     carry genome+card there (ssh user@ip '~/.local/bin/mesh-restore')"
    echo "No agent is forked by this command — the runaway-replication actuator stays behind card-gated mesh-restore." ;;
  *) echo "usage: mesh-snapshot [--save | --recall <node> | --peers | --loop [sec] | --blueprint [file] | --replicate [file]]" >&2; exit 1 ;;
esac
