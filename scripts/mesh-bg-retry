#!/usr/bin/env bash
# mesh-bg-retry — the missing half of the bg-manifest contract: RETRY a stranded delivery.
#
# mesh-bg-register's contract calls `done-undelivered` "retryable, must be resolved (BLOCKS)".
# Nothing in the mesh retried it. The state is written by mesh-bg-done BEFORE it runs the on-done
# (deliberately: a crash in between must not read as delivered), so any batch whose process dies
# mid-delivery — OOM, pane death, reboot, a mind /cleared out from under it — sits done-undelivered
# forever. The crash-reap only covers `running` -> `crashed`; a dead pid at done-undelivered is
# unreapable AND unretried, so it blocks that window's every future /clear permanently.
#
# Measured on this node 2026-08-20: 74 stranded sound manifests, oldest 2026-07-27, ALL with dead
# pids and ALL with their render still on disk — and `mesh-clear --gate sound` blocking on every one
# of them, which is exactly why that window had not /cleared in 26 days. A hand-retry of the freshest
# (mesh-bg-done <manifest>) delivered first try, TG ok:true: the renders were never bad, the delivery
# path just had nobody to restart it.
#
#   mesh-bg-retry [--window <w>]                 DRY RUN (default): list what would be retried
#   mesh-bg-retry --apply [--window <w>] [--max N]   actually retry, at most N per run (default 3)
#   mesh-bg-retry --test
#
# DRY RUN IS THE DEFAULT ON PURPOSE. Every retry fires the manifest's on-done, which for the sound
# lane means an audio file into the operator's Telegram. A deep backlog drained in one run is a
# notification flood, so --apply is explicit and --max caps the pace; run it on a cadence to drain
# gradually rather than raising the cap.
#
# ONLY a DEAD pid is retried. A live pid means the original delivery may still be in flight, and
# re-firing the on-done alongside it sends the target a DUPLICATE.
#
# Attempts are counted from THIS TOOL'S OWN LOG, not from a manifest field — the manifest schema is
# shared by three tools and closed; widening it here would make every reader's parse a guess. After
# MAX_ATTEMPTS the batch is left ALONE and reported LOUDLY, still blocking: a delivery that fails
# forever is a thing a human must see, never something this tool may quietly mark resolved.
# reflex-cadence: */30 * * * *
# reflex-args: --apply --max 3
# Cadence is the OPERATOR'S drain pace (2026-08-20), not a default: 3 per 30min = ~6 tracks/hour into
# his Telegram, the 73-deep backlog drains in ~12h, and the clear gate unwedges as it goes. The cap is
# the whole point — do not raise it to "catch up", that is the notification flood this paces around.
set -uo pipefail

MESH_DIR="${MESH_DIR:-$HOME/.mesh}"
BG_DIR="${MESH_BG_DIR:-$MESH_DIR/bg}"
LOG="${MESH_BG_RETRY_LOG:-$MESH_DIR/bg-retry.log}"
MAX_ATTEMPTS="${MESH_BG_RETRY_MAX_ATTEMPTS:-5}"
FRESH_SECS="${MESH_BG_RETRY_FRESH_SECS:-3600}"   # a stranding this new is a LIVE failure, not backlog
# Resolve mesh-bg-done ABSOLUTELY. cron's PATH is not a login shell's: the first wired run died
# rc=127 on all three batches — "command not found", not a delivery failure — and, worse, charged
# each one an attempt for it. A bare name here is a dependency on an environment this tool does not
# control. (a-login-shells-path-hides-a-dead-cron-reflex)
# THE MANIFEST'S on-done IS A BARE COMMAND NAME. It was written by a mind holding a login PATH
# ("mesh-room-music --deliver ..."), and bg-done runs it via `bash -c` in WHATEVER environment the
# caller has. Under cron's PATH (/usr/bin:/bin) that name does not resolve and the delivery dies
# rc=127 — measured: `env -i PATH=/usr/bin:/bin bash -c 'mesh-room-music …'` -> "command not found",
# while mesh-bg-done itself runs fine there. So the fault is the on-done's PATH, not bg-done's: a
# retrier that fixes only its OWN resolution still fails every batch. Put ~/.local/bin on PATH for
# the whole run. (a-login-shells-path-hides-a-dead-cron-reflex)
_ensure_path() {
  case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) PATH="$HOME/.local/bin:$PATH"; export PATH ;; esac
}

BG_DONE="${MESH_BG_DONE_CMD:-}"
if [ -z "$BG_DONE" ]; then
  for _c in "$HOME/.local/bin/mesh-bg-done" "$(command -v mesh-bg-done 2>/dev/null)"; do
    [ -n "$_c" ] && [ -x "$_c" ] && { BG_DONE="$_c"; break; }
  done
fi

_mf_get() { grep -m1 "^$2=" "$1" 2>/dev/null | cut -d= -f2-; }
_now()    { date -u +%Y-%m-%dT%H:%M:%SZ; }

# attempts already spent on this batch, counted from our own log (batch ids are unique per run).
_attempts() { # $1=batch
  [ -r "$LOG" ] || { echo 0; return; }
  # grep -c PRINTS 0 and EXITS 1 on no match, so a `|| echo 0` fallback prints a SECOND zero and the
  # caller reads "0\n0" — two lines where a count was expected. Swallow the exit code, not the output.
  local n; n="$(grep -cF " attempt batch=$1 " "$LOG" 2>/dev/null)" || true
  printf '%s\n' "${n:-0}"
}

# every done-undelivered manifest with a DEAD pid, in TWO TIERS.
#
# Plain oldest-first was wrong, and wrong in the direction that matters. It is the fair order for a
# BACKLOG — nothing starves behind newer work — but it buries a LIVE failure. Measured: drop ee7f3fca
# stranded at 11:10 on a DNS blip (curl rc=6) while 66 manifests from the previous 24 days sat ahead
# of it; at 3 per 30min the operator would have waited ~11h for the render he made minutes ago, while
# the lane shipped him grinds he had long forgotten. Age is not urgency: a fresh stranding is a live
# delivery failure someone is waiting on, an old one is history.
#
# So: FRESH tier (stranded within BG_RETRY_FRESH_SECS) drains first, then the backlog. Oldest-first
# INSIDE each tier, so the anti-starvation property still holds where it was actually doing work.
_candidates() { # $1=window-filter(optional)
  local win="${1:-}" root="$BG_DIR" f pid upd now tier
  [ -n "$win" ] && root="$BG_DIR/$win"
  [ -d "$root" ] || return 0
  now="$(date +%s)"
  while IFS= read -r f; do
    [ -r "$f" ] || continue
    [ "$(_mf_get "$f" status)" = done-undelivered ] || continue
    pid="$(_mf_get "$f" pid)"
    # a live pid = delivery may still be in flight; re-firing on-done would DUPLICATE it.
    [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && continue
    upd="$(_mf_get "$f" updated)"
    # tier 0 = fresh (sorts first), tier 1 = backlog. Both then ordered by updated ascending.
    tier=1; [ $(( now - ${upd:-0} )) -le "$FRESH_SECS" ] && tier=0
    printf '%s\t%s\t%s\n' "$tier" "${upd:-0}" "$f"
  done < <(find "$root" -name '*.manifest' -type f 2>/dev/null) | sort -k1,1n -k2,2n | cut -f3-
}

_report_line() { # $1=manifest
  local f="$1" b w t u a
  b="$(_mf_get "$f" batch)"; w="$(_mf_get "$f" window)"; t="$(_mf_get "$f" target)"
  u="$(_mf_get "$f" updated)"; a="$(_attempts "$b")"
  printf '  %-8s %-34s -> %-14s stranded %s  attempts=%s/%s\n' \
    "$w" "$b" "$t" "$(date -u -d "@${u:-0}" +%Y-%m-%dT%H:%MZ 2>/dev/null || echo '?')" "$a" "$MAX_ATTEMPTS"
}

_run() { # $1=apply(0/1) $2=window $3=max
  local apply="$1" win="$2" max="$3" f n=0 done_n=0 fail_n=0 exh_n=0 b a rc
  local -a cands=()
  while IFS= read -r f; do [ -n "$f" ] && cands+=("$f"); done < <(_candidates "$win")
  n="${#cands[@]}"
  if [ "$n" = 0 ]; then
    echo "mesh-bg-retry: nothing stranded${win:+ in $win} (no done-undelivered manifest with a dead pid)"
    return 0
  fi
  if [ "$apply" = 0 ]; then
    echo "mesh-bg-retry: DRY RUN — $n stranded batch(es)${win:+ in $win}, would retry up to $max per --apply run:"
    local i=0
    for f in "${cands[@]}"; do
      i=$((i+1)); [ "$i" -gt "$max" ] && { echo "  … and $((n-max)) more (raise --max, or run --apply repeatedly / on a cadence)"; break; }
      _report_line "$f"
    done
    echo "mesh-bg-retry: nothing sent. Re-run with --apply to actually deliver."
    return 0
  fi
  mkdir -p "$(dirname "$LOG")"
  # Normalize PATH HERE, not at load time: load time only covers a PATH that was already wrong when
  # the process started, and the on-done executes during the run.
  _ensure_path
  # A missing/unrunnable bg-done is OUR fault, not a delivery's. Abort before touching anything:
  # charging attempts for it would exhaust every stranded batch on a config error and turn a
  # one-line PATH fix into 74 permanent "exhausted" verdicts.
  if [ -z "$BG_DONE" ] || ! [ -x "$BG_DONE" ]; then
    echo "mesh-bg-retry: cannot run mesh-bg-done (BG_DONE='$BG_DONE') — aborting WITHOUT charging attempts; fix the path, nothing is stranded further" >&2
    printf '%s abort reason=bg-done-unrunnable bg_done=%s\n' "$(_now)" "${BG_DONE:-<unset>}" >> "$LOG"
    return 3
  fi
  for f in "${cands[@]}"; do
    [ "$((done_n+fail_n))" -ge "$max" ] && break
    b="$(_mf_get "$f" batch)"; a="$(_attempts "$b")"
    if [ "$a" -ge "$MAX_ATTEMPTS" ]; then
      exh_n=$((exh_n+1))
      printf '%s exhausted batch=%s attempts=%s manifest=%s\n' "$(_now)" "$b" "$a" "$f" >> "$LOG"
      echo "mesh-bg-retry: EXHAUSTED after $a attempts, left BLOCKING for a human: $f" >&2
      continue
    fi
    printf '%s attempt batch=%s n=%s manifest=%s\n' "$(_now)" "$b" "$((a+1))" "$f" >> "$LOG"
    "$BG_DONE" "$f" >>"$LOG" 2>&1; rc=$?
    if [ "$rc" = 0 ] && [ "$(_mf_get "$f" status)" = delivered ]; then
      done_n=$((done_n+1)); echo "mesh-bg-retry: delivered $b"
      printf '%s delivered batch=%s manifest=%s\n' "$(_now)" "$b" "$f" >> "$LOG"
    elif [ "$rc" = 127 ] || [ "$rc" = 126 ]; then
      # The RUNNER could not execute — not the delivery failing. Un-charge this attempt (a config
      # fault must not consume a batch's budget) and stop: every remaining batch would fail the same.
      sed -i "/ attempt batch=$b n=$((a+1)) /d" "$LOG" 2>/dev/null
      echo "mesh-bg-retry: bg-done not executable (rc=$rc) — attempt refunded, aborting the run" >&2
      printf '%s abort reason=bg-done-rc%s batch=%s\n' "$(_now)" "$rc" "$b" >> "$LOG"
      return 3
    else
      fail_n=$((fail_n+1)); echo "mesh-bg-retry: FAILED rc=$rc (stays done-undelivered, retryable) $b" >&2
      printf '%s failed batch=%s rc=%s manifest=%s\n' "$(_now)" "$b" "$rc" "$f" >> "$LOG"
    fi
  done
  echo "mesh-bg-retry: delivered=$done_n failed=$fail_n exhausted=$exh_n · $((n-done_n)) still stranded${win:+ in $win}"
  [ "$fail_n" = 0 ]
}

_test() {
  # NOT local: the EXIT trap fires after _test returns, and under `set -u` a local is already out of
  # scope by then — the cleanup dies on "td: unbound variable" and leaks the dir.
  local rc=0; _RT_TD="$(mktemp -d)"; trap 'rm -rf "$_RT_TD"' EXIT
  local td="$_RT_TD"
  export MESH_DIR="$td/m"; BG_DIR="$td/m/bg"; export MESH_BG_DIR="$BG_DIR"
  LOG="$td/m/bg-retry.log"; MAX_ATTEMPTS=2
  mkdir -p "$BG_DIR/w"
  _mk() { # $1=batch $2=status $3=pid $4=ondone [$5=updated]
    printf 'window=w\nbatch=%s\ntarget=T\non-done=%s\nstatus=%s\npid=%s\nregistered=1\nupdated=%s\n' \
      "$1" "$4" "$2" "$3" "${5:-$(date +%s)}" > "$BG_DIR/w/$1.manifest"
  }
  # a real stub bg-done: flips status per the on-done's exit, exactly like the shipped tool.
  cat > "$td/bgdone" <<'EOF'
#!/usr/bin/env bash
f="$1"; oc="$(grep -m1 '^on-done=' "$f" | cut -d= -f2-)"
bash -c "$oc" || exit 4
sed -i 's/^status=.*/status=delivered/' "$f"
EOF
  chmod +x "$td/bgdone"; BG_DONE="$td/bgdone"

  # dead pid 2 (init's child reaper is never ours; use a pid we KNOW is dead)
  local deadpid; deadpid="$( (exec sh -c 'echo $$') )"   # a pid that has already exited
  _mk ok        done-undelivered "$deadpid" "true"
  _mk failing   done-undelivered "$deadpid" "false"
  _mk live      done-undelivered "$$"       "true"
  _mk terminal  delivered        "$deadpid" "true"

  # 1. DRY RUN sends nothing and settles nothing — the default must never act.
  local out; out="$(_run 0 w 10)"
  grep -q 'DRY RUN' <<<"$out"        || { echo "bg-retry-test: FAIL (default is not a dry run)"; rc=1; }
  grep -q 'nothing sent' <<<"$out"   || { echo "bg-retry-test: FAIL (dry run did not say it sent nothing)"; rc=1; }
  grep -qx 'status=done-undelivered' "$BG_DIR/w/ok.manifest" \
    || { echo "bg-retry-test: FAIL (dry run MUTATED a manifest — the default acted)"; rc=1; }
  [ ! -s "$LOG" ] || { echo "bg-retry-test: FAIL (dry run wrote the attempt log)"; rc=1; }

  # 2. a LIVE pid is never retried — re-firing on-done beside an in-flight delivery duplicates it.
  grep -q ' live ' <<<"$out" && { echo "bg-retry-test: FAIL (a live-pid manifest was listed as retryable)"; rc=1; }
  # 3. a terminal manifest is never a candidate.
  grep -q ' terminal ' <<<"$out" && { echo "bg-retry-test: FAIL (a delivered manifest was listed as retryable)"; rc=1; }

  # 4. --apply delivers the good one and leaves the failing one BLOCKING (never a silent resolve).
  _run 1 w 10 >/dev/null 2>&1
  grep -qx 'status=delivered' "$BG_DIR/w/ok.manifest" \
    || { echo "bg-retry-test: FAIL (--apply did not deliver a retryable batch)"; rc=1; }
  grep -qx 'status=done-undelivered' "$BG_DIR/w/failing.manifest" \
    || { echo "bg-retry-test: FAIL (a FAILED retry did not stay done-undelivered — a failing delivery was silently resolved)"; rc=1; }
  grep -qx 'status=done-undelivered' "$BG_DIR/w/live.manifest" \
    || { echo "bg-retry-test: FAIL (--apply touched a live-pid manifest)"; rc=1; }

  # 5. --max CAPS the run, AND the drain order is oldest-stranded first (the fair order: a batch that
  #    has waited longest ships next, so a busy lane cannot starve the backlog behind it forever).
  #    updated= is pinned, not `date`: with ties the sort order is arbitrary and this leg passes or
  #    fails on which manifest find(1) happened to emit first — a flake wearing a verdict's clothes.
  # Own window dir: earlier legs leave `failing` behind with updated=now, which lands in the FRESH
  # tier and preempts whatever an ORDERING leg is trying to measure. An ordering assertion has to own
  # its candidate set or it is measuring the leftovers.
  mkdir -p "$BG_DIR/ord"
  _mkw() { printf 'window=ord\nbatch=%s\ntarget=T\non-done=%s\nstatus=%s\npid=%s\nregistered=1\nupdated=%s\n' \
             "$1" "$4" "$2" "$3" "$5" > "$BG_DIR/ord/$1.manifest"; }
  _mkw cap1 done-undelivered "$deadpid" "true" 10
  _mkw cap2 done-undelivered "$deadpid" "true" 20
  _run 1 ord 1 >/dev/null 2>&1
  local capped; capped=$(grep -lx 'status=delivered' "$BG_DIR/ord/cap1.manifest" "$BG_DIR/ord/cap2.manifest" 2>/dev/null | wc -l)
  [ "$capped" = 1 ] || { echo "bg-retry-test: FAIL (--max 1 settled $capped batches — the pace cap does not cap)"; rc=1; }
  grep -qx 'status=delivered' "$BG_DIR/ord/cap1.manifest" \
    || { echo "bg-retry-test: FAIL (the capped run did not take the OLDEST stranded batch — the backlog can starve behind newer work)"; rc=1; }

  # 6. ATTEMPTS EXHAUST. The failing batch has burnt 1 attempt; drive it past MAX_ATTEMPTS=2 and it
  #    must be SKIPPED and reported, still blocking — never marked resolved to unwedge the gate.
  _run 1 w 10 >/dev/null 2>&1            # attempt 2 -> now at MAX
  local eout; eout="$(_run 1 w 10 2>&1)" # attempt 3 -> refused
  grep -q 'EXHAUSTED' <<<"$eout" || { echo "bg-retry-test: FAIL (an over-limit batch was retried again instead of reported exhausted)"; rc=1; }
  grep -qx 'status=done-undelivered' "$BG_DIR/w/failing.manifest" \
    || { echo "bg-retry-test: FAIL (an exhausted batch was resolved rather than left blocking)"; rc=1; }
  [ "$(_attempts failing)" -le 3 ] \
    || { echo "bg-retry-test: FAIL (exhausted batch kept burning attempts: $(_attempts failing))"; rc=1; }

  # 6b. A FRESH STRANDING BEATS THE BACKLOG. Oldest-first alone buried a live failure: drop ee7f3fca
  #     stranded on a DNS blip with 66 manifests from the previous 24 days ahead of it, i.e. ~11h at
  #     the wired pace before the operator got the render he had just made. Age is not urgency. One
  #     ancient backlog entry + one stranded seconds ago, --max 1: the FRESH one must ship.
  rm -f "$BG_DIR/ord/"*.manifest
  _mkw ancient done-undelivered "$deadpid" "true" 10
  _mkw justnow done-undelivered "$deadpid" "true" "$(date +%s)"
  _run 1 ord 1 >/dev/null 2>&1
  grep -qx 'status=delivered' "$BG_DIR/ord/justnow.manifest" \
    || { echo "bg-retry-test: FAIL (a seconds-old stranding lost its slot to a backlog entry — a live delivery failure waits behind history)"; rc=1; }
  grep -qx 'status=done-undelivered' "$BG_DIR/ord/ancient.manifest" \
    || { echo "bg-retry-test: FAIL (the capped run shipped the backlog entry too — --max is not capping across tiers)"; rc=1; }
  # ...and within the backlog tier the old fairness still holds: two old ones, oldest goes first.
  rm -f "$BG_DIR/ord/"*.manifest
  _mkw old1 done-undelivered "$deadpid" "true" 100
  _mkw old2 done-undelivered "$deadpid" "true" 200
  _run 1 ord 1 >/dev/null 2>&1
  grep -qx 'status=delivered' "$BG_DIR/ord/old1.manifest" \
    || { echo "bg-retry-test: FAIL (inside the backlog tier the drain no longer takes the oldest — the anti-starvation property was lost with the tiering)"; rc=1; }

  # 7. A RUNNER FAULT IS NOT A DELIVERY FAULT. cron's PATH is not a login shell's, and the first
  #    wired run died rc=127 on every batch — "command not found" — while charging each one an
  #    attempt. Left alone that turns a one-line PATH fix into N permanent "exhausted" verdicts.
  #    (a) an unrunnable bg-done aborts BEFORE touching anything and charges nothing;
  #    (b) an rc=127 mid-run REFUNDS the attempt it just wrote and stops the run.
  # (c) the on-done's OWN bare name must resolve. This is the fault that actually killed the first
  #     wired run: bg-done ran fine, the on-done "mesh-room-music --deliver ..." did not. Drive a
  #     manifest whose on-done is a bare name living ONLY in a dir we add to PATH the same way the
  #     shipped tool adds ~/.local/bin — if that export is dropped, this leg goes red.
  mkdir -p "$HOME/.local/bin" 2>/dev/null
  printf '#!/usr/bin/env bash\nexit 0\n' > "$HOME/.local/bin/mesh-bg-retry-selftest-probe" 2>/dev/null \
    && chmod +x "$HOME/.local/bin/mesh-bg-retry-selftest-probe" 2>/dev/null
  if [ -x "$HOME/.local/bin/mesh-bg-retry-selftest-probe" ]; then
    _mk bare done-undelivered "$deadpid" "mesh-bg-retry-selftest-probe" 5
    ( PATH=/usr/bin:/bin; _run 1 w 1 ) >/dev/null 2>&1
    grep -qx 'status=delivered' "$BG_DIR/w/bare.manifest" \
      || { echo "bg-retry-test: FAIL (an on-done that is a BARE NAME did not resolve under a cron-like PATH — every real manifest's on-done is a bare name)"; rc=1; }
    rm -f "$HOME/.local/bin/mesh-bg-retry-selftest-probe"
  fi

  _mk cfg1 done-undelivered "$deadpid" "true" 10; _mk cfg2 done-undelivered "$deadpid" "true" 20
  local before after out2
  before="$(_attempts cfg1)"
  ( BG_DONE="$td/does-not-exist"; _run 1 w 5 ) >/dev/null 2>&1
  after="$(_attempts cfg1)"
  [ "$before" = "$after" ] \
    || { echo "bg-retry-test: FAIL (an unrunnable bg-done charged an attempt: $before -> $after) — a config fault would exhaust the whole backlog"; rc=1; }
  grep -qx 'status=done-undelivered' "$BG_DIR/w/cfg1.manifest" \
    || { echo "bg-retry-test: FAIL (the abort path mutated a manifest)"; rc=1; }
  printf '#!/usr/bin/env bash\nexit 127\n' > "$td/bgdone127"; chmod +x "$td/bgdone127"
  out2="$( BG_DONE="$td/bgdone127"; _run 1 w 5 2>&1 )"
  grep -q 'attempt refunded' <<<"$out2" \
    || { echo "bg-retry-test: FAIL (an rc=127 runner fault was booked as a delivery failure: '$out2')"; rc=1; }
  [ "$(_attempts cfg1)" = "$before" ] \
    || { echo "bg-retry-test: FAIL (rc=127 did not refund the attempt: $before -> $(_attempts cfg1))"; rc=1; }

  [ "$rc" = 0 ] && echo "smoke-test: ok (dry run is the default and mutates nothing; a live pid and a terminal manifest are never candidates; --apply delivers through the REAL bg-done state flip; a FAILED delivery stays done-undelivered and blocking, never silently resolved; --max caps the drain pace; a FRESH stranding (a live delivery failure) preempts the backlog while the backlog itself still drains oldest-first; attempts exhaust into a loud skip that leaves the gate blocking for a human; and a RUNNER fault — bg-done missing or rc=126/127 — aborts charging nothing and refunds the attempt it wrote, so cron's PATH cannot exhaust the whole backlog; and an on-done that is a BARE NAME resolves under a cron-like PATH, which is the fault that actually killed the first wired run)"
  return "$rc"
}

APPLY=0; WIN=""; MAX=3
while [ $# -gt 0 ]; do
  case "$1" in
    --test)    _test; exit $? ;;
    --apply)   APPLY=1 ;;
    --window)  WIN="${2:-}"; shift ;;
    --max)     MAX="${2:-3}"; shift ;;
    -h|--help) sed -n '2,30p' "$0"; exit 0 ;;
    *) echo "mesh-bg-retry: unknown arg '$1'" >&2; exit 2 ;;
  esac
  shift
done
_run "$APPLY" "$WIN" "$MAX"
