#!/usr/bin/env bash
# mesh-sensor-digest — daily sensor analysis: reads sensors.log + presence.log → summary
# reflex-cadence: 0 7 * * *
#
# Analyzes yesterday's sensor data: cpu_temp, cpu_load, mem, wifi_rssi, room_sense,
# phone_battery, thermal zones. Computes min/max/avg, detects anomalies, tracks trends.
#
#   mesh-sensor-digest              analyze yesterday, print to stdout
#   mesh-sensor-digest --today      analyze today (partial)
#   mesh-sensor-digest --send       also send to Telegram
#   mesh-sensor-digest --test       smoke test
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

MESH="$HOME/.mesh"
SENSORS_LOG="$MESH/sensors.log"
PRESENCE_LOG="$MESH/presence.log"
DIGEST_DIR="$MESH/digests"

# --- Test ---
if [ "${1:-}" = --test ]; then
  for x in date awk sort head tail wc; do command -v "$x" >/dev/null 2>&1 || { echo "smoke-test: FAIL (no $x)"; exit 1; }; done
  # Need at least some sensor data
  [ -f "$SENSORS_LOG" ] || { echo "smoke-test: FAIL (no sensors.log)"; exit 1; }
  out="$("$0" 2>/dev/null)" || { echo "smoke-test: FAIL (render errored)"; exit 1; }
  printf '%s' "$out" | grep -q "sensor digest" || { echo "smoke-test: FAIL (missing header)"; exit 1; }
  echo "smoke-test: ok ($(printf '%s' "$out" | wc -l) lines)"; exit 0
fi

# --- Date ---
if [ "${1:-}" = --today ]; then
  DAY="$(date -u +%Y-%m-%d)"
  DAY_LABEL="today ($DAY)"
else
  DAY="$(date -u -d 'yesterday' +%Y-%m-%d 2>/dev/null || date -u -v-1d +%Y-%m-%d)"
  DAY_LABEL="yesterday ($DAY)"
fi

# --- Extract today's data ---
TODAYS_SENSORS="$(mktemp)"
trap 'rm -f "$TODAYS_SENSORS"' EXIT
grep -a "^${DAY}" "$SENSORS_LOG" > "$TODAYS_SENSORS" 2>/dev/null

TOTAL_LINES=$(wc -l < "$TODAYS_SENSORS")
if [ "$TOTAL_LINES" -eq 0 ]; then
  echo "sensor digest — $DAY: no sensor data for $DAY"
  exit 0
fi

# --- Helper: stats for a numeric sensor ---
sensor_stats() {
  local name="$1" col="$2" extra_filter="${3:-}"
  local vals
  vals=$(awk -v c="$col" -v f="$extra_filter" '
    $3 == c && (f == "" || $4 == f) { print $4+0 }
  ' "$TODAYS_SENSORS" | sort -n)
  local n=$(echo "$vals" | grep -c '.')
  if [ "$n" -eq 0 ]; then return; fi
  local min=$(echo "$vals" | head -1)
  local max=$(echo "$vals" | tail -1)
  local avg=$(echo "$vals" | awk '{s+=$1} END {printf "%.1f", s/NR}')
  local high=$(echo "$vals" | awk -v t="$3" '$1 > t' | wc -l)
  echo "$name: min=$min max=$max avg=$avg [n=$n]"
  if [ "$high" -gt 0 ] && [ -n "$3" ]; then
    echo "  ⚠ $high reading(s) above threshold ($3)"
  fi
}

# --- Render ---
mkdir -p "$DIGEST_DIR" 2>/dev/null
OUT="$DIGEST_DIR/digest-$DAY.txt"
{
  echo "📊 sensor digest — $DAY_LABEL"
  echo ""

  # CPU Temperature
  echo "── cpu temperature ──"
  sensor_stats "temp" "cpu_temp" 80
  # Show time-of-day pattern (when hot)
  echo "  hottest hours:"
  awk '$3 == "cpu_temp" && $4+0 > 70 {
    split($1, t, "T"); split(t[2], h, ":");
    print h[1]
  }' "$TODAYS_SENSORS" | sort | uniq -c | sort -rn | head -3 | awk '{printf "    %s:00 → %s reading(s)\n", $2, $1}'
  echo ""

  # CPU Load
  echo "── cpu load (1m) ──"
  sensor_stats "load" "cpu_load1" 4.0
  echo ""

  # Memory
  echo "── memory usage ──"
  sensor_stats "mem%" "mem_used_pct" 85
  echo ""

  # WiFi RSSI (per AP)
  echo "── wifi rssi ──"
  for ap in $(awk '$3 == "wifi_rssi" {print $4}' "$TODAYS_SENSORS" | sort -u); do
    echo "  $ap:"
    awk -v ap="$ap" '$3 == "wifi_rssi" && $4 == ap {print $5+0}' "$TODAYS_SENSORS" | sort -n | awk '
      NR==1{min=$1} {sum+=$1; last=$1} END{
        if(NR>0) printf "    min=%s max=%s avg=%.0f last=%s [n=%d]\n", min, last, sum/NR, last, NR
      }'
  done
  echo ""

  # Room Sense
  echo "── room sense ──"
  awk '$3 == "room_sense" {print $4}' "$TODAYS_SENSORS" | sort | uniq -c | sort -rn | awk '{printf "  %s: %s\n", $2, $1}'
  echo ""

  # Thermal zones (IdeaPad)
  therm_count=$(awk '$3 ~ /^therm_/ {print $3}' "$TODAYS_SENSORS" | sort -u | wc -l)
  if [ "$therm_count" -gt 0 ]; then
    echo "── thermal zones ($therm_count sensors) ──"
    for zone in $(awk '$3 ~ /^therm_/ {print $3}' "$TODAYS_SENSORS" | sort -u); do
      awk -v z="$zone" '$3 == z {print $4+0}' "$TODAYS_SENSORS" | sort -n | awk -v zn="$zone" '
        NR==1{min=$1} {sum+=$1; last=$1} END{
          if(NR>0) printf "  %s: min=%.0f max=%.0f avg=%.0f\n", zn, min, last, sum/NR
        }'
    done
    echo ""
  fi

  # Phone sensors (if present)
  phone_lines=$(awk '$3 == "phone_battery" {print $4+0}' "$TODAYS_SENSORS" | wc -l)
  if [ "$phone_lines" -gt 0 ]; then
    echo "── phone ──"
    sensor_stats "battery%" "phone_battery" 20
    sensor_stats "battery_temp" "phone_battery_temp" 40
    sensor_stats "light" "phone_light" ""
    sensor_stats "steps" "phone_steps" ""
    echo ""
  fi

  # BLE Presence
  echo "── ble presence ──"
  awk '$3 == "ble_count" {print $4+0}' "$TODAYS_SENSORS" | sort -n | awk '
    NR==1{min=$1} {sum+=$1; last=$1} END{
      if(NR>0) printf "  devices: min=%d max=%d avg=%.0f [n=%d]\n", min, last, sum/NR, NR
    }'
  # Named devices
  awk '$3 == "ble_named" {print $4}' "$TODAYS_SENSORS" | sort -u | head -10 | awk '{printf "  known: %s\n", $1}'
  echo ""

  # Presence log summary
  if [ -f "$PRESENCE_LOG" ]; then
    echo "── presence log ──"
    grep -a "^${DAY}" "$PRESENCE_LOG" 2>/dev/null | wc -l | awk '{printf "  scans: %d\n", $1}'
    grep -a "^${DAY}" "$PRESENCE_LOG" 2>/dev/null | awk -F'n=' '{print $2}' | cut -d' ' -f1 | sort -n | awk '
      NR==1{min=$1} {sum+=$1; last=$1} END{
        if(NR>0) printf "  devices visible: min=%d max=%d avg=%.0f\n", min, last, sum/NR
      }'
    echo ""
  fi

  # Anomalies
  echo "── anomalies ──"
  anomalies=0
  # CPU hot
  hot_cpu=$(awk '$3 == "cpu_temp" && $4+0 > 85' "$TODAYS_SENSORS" | wc -l)
  if [ "$hot_cpu" -gt 0 ]; then echo "  ⚠ CPU above 85°C: $hot_cpu reading(s)"; anomalies=$((anomalies+1)); fi
  # Memory high
  hot_mem=$(awk '$3 == "mem_used_pct" && $4+0 > 90' "$TODAYS_SENSORS" | wc -l)
  if [ "$hot_mem" -gt 0 ]; then echo "  ⚠ Memory above 90%: $hot_mem reading(s)"; anomalies=$((anomalies+1)); fi
  # CPU load high
  hot_load=$(awk '$3 == "cpu_load1" && $4+0 > 6.0' "$TODAYS_SENSORS" | wc -l)
  if [ "$hot_load" -gt 0 ]; then echo "  ⚠ CPU load above 6.0: $hot_load reading(s)"; anomalies=$((anomalies+1)); fi
  # WiFi disconnects (RSSI drop to very low)
  bad_wifi=$(awk '$3 == "wifi_rssi" && $4+0 < 15' "$TODAYS_SENSORS" | wc -l)
  if [ "$bad_wifi" -gt 0 ]; then echo "  ⚠ WiFi RSSI < 15: $bad_wifi reading(s)"; anomalies=$((anomalies+1)); fi
  # Phone battery low
  low_bat=$(awk '$3 == "phone_battery" && $4+0 < 15' "$TODAYS_SENSORS" | wc -l)
  if [ "$low_bat" -gt 0 ]; then echo "  ⚠ Phone battery < 15%: $low_bat reading(s)"; anomalies=$((anomalies+1)); fi
  if [ "$anomalies" -eq 0 ]; then echo "  ✓ no anomalies detected"; fi
  echo ""

  # Coverage
  echo "── coverage ──"
  echo "  total sensor readings: $TOTAL_LINES"
  echo "  sensor types: $(awk '{print $3}' "$TODAYS_SENSORS" | sort -u | wc -l)"
  hours=$(awk -F'T|Z' '{print $2}' "$TODAYS_SENSORS" | cut -d: -f1 | sort -u | wc -l)
  echo "  hours covered: $hours/24"
  echo ""
  echo "generated: $(date -u +%FT%TZ)"

} > "$OUT"
cat "$OUT"

# Send if requested
if [ "${1:-}" = --send ]; then
  if command -v mesh-tg >/dev/null 2>&1; then
    mesh-tg "$(cat "$OUT")" >/dev/null && echo "[sent to operator Telegram]"
  else
    echo "[mesh-tg not found]"
  fi
fi
