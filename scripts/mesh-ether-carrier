#!/usr/bin/env bash
# reflex-cadence: */5 * * * *
# reflex-args: --edge
# doctor-artifact: $HOME/.mesh/.ether-carrier.state 900 sys
# mesh-ether-carrier — physical NIC carrier/operstate relation.
#
# The NIC exposes two different live axes: electrical/link carrier and the kernel's
# operational state.  The joint mismatch is useful in its own right: neither field
# alone can say that the driver has carrier but has not admitted the interface, or
# that the interface claims up without carrier.  Virtual interfaces are excluded.
#
# Honest contract: no physical interface with two valid live fields -> exit 2.
# A successful run writes a live state and refreshes its mtime on every run.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME="$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6)"
export HOME

ROOT="${MESH_ETHER_CARRIER_ROOT:-/sys/class/net}"
MESH="${MESH_DIR:-$HOME/.mesh}"
STATE="${MESH_ETHER_CARRIER_STATE:-$MESH/.ether-carrier.state}"

read_rows() {
  local scan_root="${MESH_ETHER_CARRIER_ROOT:-$ROOT}" path iface carrier oper found=0
  shopt -s nullglob
  for path in "$scan_root"/*; do
    [ -d "$path/device" ] || continue
    [ -r "$path/carrier" ] && [ -r "$path/operstate" ] || continue
    iface="${path##*/}"
    carrier="$(tr -d '[:space:]' < "$path/carrier" 2>/dev/null)"
    oper="$(tr -d '[:space:]' < "$path/operstate" 2>/dev/null)"
    case "$carrier" in 0|1) ;; *) continue ;; esac
    case "$oper" in up|down|unknown|dormant|lowerlayerdown|testing) ;; *) continue ;; esac
    printf '%s|%s|%s\n' "$iface" "$carrier" "$oper"
    found=1
  done
  shopt -u nullglob
  [ "$found" -eq 1 ]
}

classify_rows() {
  local rows="$1" iface carrier oper mismatch=0 count=0
  while IFS='|' read -r iface carrier oper; do
    [ -n "${iface:-}" ] || continue
    count=$((count + 1))
    if { [ "$carrier" = 1 ] && [ "$oper" = down ]; } ||
       { [ "$carrier" = 0 ] && [ "$oper" = up ]; }; then
      mismatch=1
    fi
  done <<< "$rows"
  [ "$count" -gt 0 ] || return 2
  [ "$mismatch" -eq 1 ] && printf 'CARRIER-OPERSTATE-MISMATCH' || printf 'CONSISTENT'
}

if [ "${1:-}" = --test ]; then
  td="$(mktemp -d)" || { echo 'smoke-test: FAIL (mktemp)'; exit 1; }
  trap 'rm -rf "$td"' EXIT
  mkdir -p "$td/net/eth0/device" "$td/net/eth1/device" "$td/net/lo"
  printf '1\n' > "$td/net/eth0/carrier"
  printf 'up\n' > "$td/net/eth0/operstate"
  printf '0\n' > "$td/net/eth1/carrier"
  printf 'up\n' > "$td/net/eth1/operstate"
  rows="$(MESH_ETHER_CARRIER_ROOT="$td/net" read_rows)" || { echo 'smoke-test: FAIL (fixture read)'; exit 1; }
  [ "$(classify_rows "$rows")" = CARRIER-OPERSTATE-MISMATCH ] || {
    echo "smoke-test: FAIL (mismatch classifier: $rows)"; exit 1;
  }
  printf 'down\n' > "$td/net/eth1/operstate"
  rows="$(MESH_ETHER_CARRIER_ROOT="$td/net" read_rows)" || exit 1
  [ "$(classify_rows "$rows")" = CONSISTENT ] || { echo 'smoke-test: FAIL (consistent classifier)'; exit 1; }
  empty="$td/empty"; mkdir -p "$empty"
  if MESH_ETHER_CARRIER_ROOT="$empty" read_rows; then
    echo 'smoke-test: FAIL (empty root read succeeded)'; exit 1
  fi
  rows="$(read_rows 2>/dev/null)" || { echo 'smoke-test: n/a (no live physical NIC carrier source)'; exit 2; }
  verdict="$(classify_rows "$rows")" || { echo 'smoke-test: FAIL (live rows not classifiable)'; exit 1; }
  echo "smoke-test: ok (fixture relation + REAL carrier/operstate read: $verdict [$rows])"
  exit 0
fi

json=0; edge=0
for arg in "$@"; do
  case "$arg" in --json) json=1 ;; --edge) edge=1 ;; esac
done
rows="$(read_rows 2>/dev/null)" || {
  echo "mesh-ether-carrier: UNKNOWN — no physical NIC carrier/operstate source under $ROOT" >&2
  exit 2
}
verdict="$(classify_rows "$rows")" || exit 2
mkdir -p "$(dirname "$STATE")" 2>/dev/null || exit 1
previous="$(head -1 "$STATE" 2>/dev/null || true)"
printf '%s|rows=%s|ts=%s\n' "$verdict" "${rows//$'\n'/,}" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$STATE" || exit 1
mesh-state-touch "$STATE" >/dev/null 2>&1 || {
  echo 'mesh-ether-carrier: UNKNOWN — could not stamp live state' >&2
  exit 1
}

if [ "$json" -eq 1 ]; then
  printf '{"verdict":"%s","rows":"%s","ts":"%s"}\n' \
    "$verdict" "${rows//$'\n'/,}" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
elif [ "$edge" -eq 1 ] && [ "$previous" = "$verdict" ]; then
  exit 0
else
  printf '[ether-carrier] %s — %s\n' "$verdict" "${rows//$'\n'/,}"
fi
