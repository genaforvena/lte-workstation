#!/usr/bin/env bash
# reflex-cadence: 9-59/15 * * * *
# reflex-args: --edge
# mesh-perimeter — the mesh's ONE situational-awareness read of its surroundings: OUTSIDE + NETWORK +
# PHYSICAL fused into a single CALM/NOTICE/ALERT verdict. No single sense answers "is anything unusual
# around?" — together they do:
#   OUTSIDE  (mesh-watchtower)     — the public-IP vantage: external scanners/knocks, reach, exposure.
#   NETWORK  (mesh-lan-newdevice   — a NEW/unknown device on the home LAN (router DHCP delta), PLUS
#            +mesh-gateway-identity) the gateway IP→MAC binding canary: a flipped gateway MAC is the
#                                  ARP-spoof/MITM/router-swap signal a device census can't see —
#                                  raises NETWORK to ALERT (fresh flip) / NOTICE (flip within 30m,
#                                  already auto-rebaselined by the canary). READ-ONLY on the canary's
#                                  cron log (no double-writer on its change-gated baseline).
#   PHYSICAL (mesh-presence        — unknown BLE devices in radio range (rough proximity), PLUS
#            +mesh-motion-attribution) device-free MOTION × operator-home: motion while the operator is
#                                  AWAY with no carried device (UNEXPLAINED) = the device-less intruder
#                                  BLE alone misses → raises PHYSICAL to NOTICE (honest-fusion gated).
# It is to the perimeter what mesh-body-context is to the body and mesh-sensorium is to the node:
# a fusion, not a new sensor. Read-only (observes; never acts).
#
# Honest-organ doctrine (memory fusion-tools-distinguish-empty-from-failed): an UNREACHABLE input is
# rendered visibly distinct from a genuine all-clear — a down sensor is never silently a "CALM". The
# overall verdict is the worst REACHABLE axis; if every axis is unreachable it says CANNOT-ASSESS, not
# CALM. NETWORK reads the lan-newdevice baseline READ-ONLY (no mutation) so it never races that reflex.
#
# LITERATURE (live review, 2026-06-29 — predictive processing / Bayesian brain, angle = concrete metric):
# Shafiei, Jesawada, Friston & Russo, "Distributionally robust free energy principle for decision-making"
# (Nature Communications 17:707, 2026; doi:10.1038/s41467-025-67348-6) introduce DR-FREE: choose policies by
# minimizing the MAXIMUM free energy over an ambiguity set, not the expected free energy under one learned
# environment. The measurable mechanism is a minimax ambiguity cost: evaluate plausible environments in
# the ambiguity set and optimize against the worst one. Their experiments use stochastic navigation/control
# benchmarks where ordinary free-energy agents fail under shifted/ambiguous dynamics but robust agents
# complete the task. This is NOT already embodied by honest-fusion. Honest-fusion says "unreachable !=
# clear" in the text; DR-FREE says an action policy can be chosen under the WORST plausible unread axis.
# Concrete application HERE: `PERIMETER_ROBUST_PARTIAL=1` makes a partial all-clear non-CALM. If every
# reachable axis is CALM but at least one axis is unreachable, the worst plausible hidden environment is
# not trusted as clear, so the perimeter emits NOTICE (partial) instead of CALM (partial). Default stays
# unchanged because this can raise operator-facing sensitivity; enable it only for robust posture policy.
#
# ── MARKOV-BLANKET REIFICATION: this perimeter is a Pearl blanket (a map-tool), never a Friston blanket ──
# LITERATURE (live review, 2026-06-22 — predictive processing / the Bayesian brain, angle = a known
# CRITIQUE/failure mode): the un-embodied concept is the PEARL-vs-FRISTON BLANKET conflation, the central
# critique of the free-energy programme's use of the boundary construct. A Markov blanket is the
# statistical boundary (sensory + active states) that conditionally separates a "system" from everything
# else. Bruineberg, Dołęga, Dewhurst & Baltieri, "The Emperor's New Markov Blankets" (Behavioral & Brain
# Sciences 45:e183, 2022; philsci-archive 18467) show the literature slides between two incompatible
# readings: a PEARL blanket — the original instrumental/epistemic device (a partition the MODELLER draws
# to factor a joint distribution; part of the MAP) — and a FRISTON blanket — the metaphysical claim that
# this partition is a REAL boundary in the world, demarcating where an agent/self ends (part of the
# TERRITORY). The reification error is transposing Pearl's empirical credentials onto Friston's
# ontological claim: "the math is not the territory" (Andrews 2021). Live, continuously published debate:
# BBS commentaries "Markov blankets do not demarcate the boundaries of the mind" + "Markov blankets and
# the preformationist assumption" (2022); dynamic-blanket-detection work continuing to 2025.
# WHERE IT BITES — HERE. This tool draws exactly such a boundary: it fuses OUTSIDE/NETWORK/PHYSICAL and
# classifies devices as KNOWN (ours) vs unknown/FOREIGN, then renders one CALM/NOTICE/ALERT verdict — the
# textbook shape of a mesh "self" with a sensory surface and an inside to defend. That partition is a
# PEARL blanket: an instrumental factoring of the sensor stream, drawn for the OPERATOR's situational
# awareness. The reification hazard is reading it as a FRISTON blanket — a real self/non-self skin of a
# "mesh organism" — so that a device crossing the perimeter becomes an ontological INTRUDER across the
# mesh's body rather than a change in the modeller's catalog. This is the formal grounding of the standing
# discipline [[all-is-text-prediction-discipline]] ("no self/non-self tag … own actions are just more text
# to predict"): the perimeter is the one organ most TEMPTED to reify, because tagging inside/outside is
# its whole job.
# DISTINCT FROM the honest-fusion doctrine above (:13-16): that governs REACHABLE-vs-unreachable (a down
# axis is never a silent CALM) — an epistemic-coverage rule. This is a different axis, SELF-vs-world: is
# the inside/outside split a map-tool or a territory-boundary? Honest-fusion keeps the verdict honest
# about what it COULD read; this keeps it honest about what the boundary IS. Also NOT requisite-variety /
# the good-regulator theorem (mesh-homeostasis) and NOT precision-weighting (mesh-precision) — other PP
# threads already embodied; and NOT the FEP dark-room drive (mesh-needs).
# HELD (behavioral, steward/operator): nothing to change in the fuse — it already only observes + reports.
# The inoculation is to keep the partition explicitly INSTRUMENTAL in any future framing: never let
# "perimeter = the mesh's skin / immune boundary" calcify into code that treats KNOWN/FOREIGN as an
# ontological self, and keep CALM/NOTICE/ALERT a situational read for the operator, not a threat-to-the-
# self verdict.
#
#   mesh-perimeter           one fused situational read: 3 axes + overall verdict
#   mesh-perimeter --edge     only emit when verdict changes vs last run (for cron wiring)
#   mesh-perimeter --raw      the raw per-axis facts behind the verdict (the artifact)
#   mesh-perimeter --test     deps + at-least-one-axis reachable gate (exit 2 = nothing to read)
#
# Exit: 0 = a read was produced (verdict is in the TEXT, not rc — sense convention); 2 = could not
# assess (every axis unreachable). LAN intrusion / scan spikes surface as ALERT/NOTICE in the text.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes"

KNOWN_LAN="$HOME/.mesh/.lan-known-macs"   # baseline OWNED by mesh-lan-newdevice; we only READ it
BLE_WIN="${PERIMETER_BLE_WIN:-8}"
BENIGN_SUPPRESS="${PERIMETER_BENIGN_SUPPRESS:-3}" # suppress known-benign scan spikes after N repeats
BENIGN_STATE="$HOME/.mesh/.perimeter-benign"      # track known-benign fingerprint counts
ROBUST_PARTIAL="${PERIMETER_ROBUST_PARTIAL:-0}"   # opt-in DR-FREE-style worst-case ambiguity guard

# A locally-administered MAC (bit 0x02 of first octet) is privacy-randomized (iOS/Android rotation) —
# an unknown one is far more likely a known device's new random address than an intrusion, so it is a
# NOTICE not an ALERT. A globally-unique (OUI) unknown MAC keeps the stronger ALERT. (Same insight
# mesh-lan-newdevice and mesh-novelty use.)
is_laa() { local o="${1%%:*}"; [ -n "$o" ] && (( (16#$o & 2) != 0 )) 2>/dev/null; }

# ---- FUSE: overall verdict = worst REACHABLE axis (UNREACHABLE contributes coverage, not severity).
# Pure (no I/O) so --test can dry-run the honest-fusion contract — the tool's reason to exist.
rank() { case "$1" in ALERT) echo 3;; NOTICE) echo 2;; CALM) echo 1;; *) echo 0;; esac; }
# fuse_posture <out_sev> <net_sev> <phy_sev> → sets globals `verdict` and `ec` (identical to the old
# inline block). Worst reachable axis wins; an unreachable axis (rank 0) adds coverage not severity;
# all-3-unreachable = CANNOT-ASSESS exit 2 (never a silent CALM); a partial mix is annotated.
fuse_posture() {
  local s r v worst=0 reachable=0 unreach=0
  for s in "$1" "$2" "$3"; do
    r=$(rank "$s")
    if [ "$r" -gt 0 ]; then reachable=$((reachable+1)); [ "$r" -gt "$worst" ] && worst=$r; else unreach=$((unreach+1)); fi
  done
  if [ "$reachable" -eq 0 ]; then verdict="CANNOT-ASSESS (all 3 axes unreachable)"; ec=2
  else
    case "$worst" in 3) v=ALERT;; 2) v=NOTICE;; *) v=CALM;; esac
    if [ "$ROBUST_PARTIAL" = 1 ] && [ "$v" = CALM ] && [ "$unreach" -gt 0 ]; then
      v=NOTICE
    fi
    verdict="$v"; [ "$unreach" -gt 0 ] && verdict="$v (partial — $unreach/3 axes unreachable)"; ec=0
  fi
}
# motion_phy_sev <ma_verdict> <ma_rc> <cur_phy_sev> → echoes the (possibly-raised) PHYSICAL severity.
# Folds mesh-motion-attribution (device-free MOTION × operator-home) into the PHYSICAL axis, which BLE
# alone can't answer: motion while the operator is AWAY with no carried device is the real intrusion
# signal. Pure (no I/O) so --test dry-runs it. Honest-fusion contract:
#   - ONLY a confident UNEXPLAINED (rc 0) raises severity, and only to NOTICE — wifi-motion is
#     RSSI-drift radar (noisier than a MAC); flag-to-investigate, never cry wolf at ALERT on one blip.
#   - A degraded/UNKNOWN motion read (rc≠0) NEVER escalates (a dead radar must not manufacture an
#     intruder), and OCCUPANT/ATTRIBUTED/UNATTRIBUTED/QUIET are benign/neutral — no escalation.
#   - Never LOWERS an existing ALERT (e.g. an unknown-global-MAC network-adjacent physical reading).
#   - UNREACHABLE→NOTICE is intended: a reachable confident UNEXPLAINED makes a BLE-blind axis assessable.
motion_phy_sev() {
  local v="$1" rc="$2" cur="$3"
  if [ "$rc" -eq 0 ] && [ "$v" = "UNEXPLAINED" ] && [ "$cur" != "ALERT" ]; then echo "NOTICE"; else echo "$cur"; fi
}

# gw_net_sev <gw_label> <fresh:0|1> <recent_changed:0|1> <cur_net_sev> → echoes the (possibly-raised)
# NETWORK severity. Folds mesh-gateway-identity (gateway IP→MAC binding canary) into the NETWORK axis,
# which lan-newdevice alone can't answer: the census sees who JOINED the LAN, not whether the gateway
# ITSELF was swapped/spoofed. Pure (no I/O) so --test dry-runs it. Honest-fusion contract:
#   - Only a FRESH canary reading escalates. Newest-line CHANGED (flip caught on the last canary run)
#     → ALERT — a flipped gateway MAC is the canonical ARP-spoof/MITM signature (at least as strong as
#     lan-newdevice's unknown-global-MAC ALERT). Fires on a legit router swap too — worth ALERT either way.
#   - The canary AUTO-REBASELINES, so a flip earlier in the window survives only in its log: a CHANGED
#     within the recent window (newest already STABLE again) → NOTICE — investigate, don't cry wolf twice.
#   - A stale/missing canary log NEVER escalates and never fakes assessability (cur passes through —
#     a dead canary must not manufacture a MITM, nor silently bless the gateway).
#   - NEW (first observation / gateway IP moved networks) is neutral — never escalated.
#   - Never LOWERS an existing ALERT (e.g. an unknown-global-MAC on the LAN).
#   - UNREACHABLE→ALERT/NOTICE is intended: a fresh canary hit makes a DHCP-blind axis assessable.
gw_net_sev() {
  local label="$1" fresh="$2" recent="$3" cur="$4"
  if [ "$fresh" = 1 ] && [ "$label" = CHANGED ]; then echo "ALERT"; return; fi
  if [ "$recent" = 1 ] && [ "$cur" != ALERT ]; then echo "NOTICE"; return; fi
  echo "$cur"
}

# gw_log_scan <canary-log> <now_epoch> [fresh_s=1200] [recent_s=1800] → sets globals gw_label / gw_mac /
# gw_fresh (newest per-run line within fresh_s = 2× the canary's */10 stride) / gw_recent (any CHANGED
# line within recent_s). File-bound + epoch-parameterized so --test drives it on fixtures. Only
# '[gateway-identity] ' emit lines are parsed (the canary's exit-2 UNREACHABLE stderr lines land in the
# same cron log and must not be misread as verdicts). ts = the line's last field (the canary's emit format).
gw_log_scan() {
  local f="$1" now="$2" fresh_s="${3:-1200}" recent_s="${4:-1800}" line ts ep
  gw_label=""; gw_mac=""; gw_fresh=0; gw_recent=0
  [ -r "$f" ] || return 0
  line="$(grep -E '^\[gateway-identity\] ' "$f" 2>/dev/null | tail -1)"
  [ -n "$line" ] || return 0
  gw_label="$(printf '%s' "$line" | awk '{print $2}')"
  gw_mac="$(printf '%s' "$line" | grep -oE 'mac=[^ ]+' | head -1 | cut -d= -f2)"
  ts="$(printf '%s' "$line" | awk '{print $NF}')"
  ep="$(date -d "$ts" +%s 2>/dev/null)" || ep=""
  [ -n "$ep" ] && [ $(( now - ep )) -le "$fresh_s" ] && gw_fresh=1
  while IFS= read -r line; do
    ts="$(printf '%s' "$line" | awk '{print $NF}')"
    ep="$(date -d "$ts" +%s 2>/dev/null)" || continue
    [ -n "$ep" ] && [ $(( now - ep )) -le "$recent_s" ] && gw_recent=1
  done < <(grep -E '^\[gateway-identity\] CHANGED ' "$f" 2>/dev/null | tail -5)
  return 0
}

if [ "${1:-}" = --test ]; then
  command -v ssh >/dev/null 2>&1 || { echo "smoke-test: FAIL (no ssh)"; exit 1; }
  for t in mesh-watchtower mesh-lan-newdevice mesh-presence; do
    command -v "$t" >/dev/null 2>&1 || { echo "smoke-test: FAIL (no $t)"; exit 1; }
  done
  # Dry-run the honest-fusion contract with synthetic axes (no network) — the core verdict logic the
  # old smoke never touched. A regression flipping worst-of-axes, or silently lowering an unreachable
  # axis to CALM, or faking a CALM when all axes are down, was previously invisible to --test.
  _f=0
  fuse_posture ALERT  CALM   CALM;   { [ "$verdict" = ALERT ]  && [ "$ec" = 0 ]; } || { echo "  FAIL: worst-axis→ALERT (got '$verdict' ec=$ec)"; _f=1; }
  fuse_posture CALM   NOTICE CALM;   { [ "$verdict" = NOTICE ] && [ "$ec" = 0 ]; } || { echo "  FAIL: worst-axis→NOTICE (got '$verdict')"; _f=1; }
  fuse_posture CALM   CALM   CALM;   { [ "$verdict" = CALM ]   && [ "$ec" = 0 ]; } || { echo "  FAIL: all-CALM (got '$verdict')"; _f=1; }
  fuse_posture ALERT  UNKNOWN UNKNOWN; { [ "$verdict" = "ALERT (partial — 2/3 axes unreachable)" ] && [ "$ec" = 0 ]; } || { echo "  FAIL: unreachable=coverage-not-severity+partial (got '$verdict')"; _f=1; }
  fuse_posture UNKNOWN UNKNOWN UNKNOWN; case "$verdict" in CANNOT-ASSESS*) [ "$ec" = 2 ] || { echo "  FAIL: all-unreachable ec=2 (got $ec)"; _f=1; };; *) echo "  FAIL: all-unreachable→CANNOT-ASSESS (got '$verdict')"; _f=1;; esac
  ROBUST_PARTIAL=1; fuse_posture CALM UNKNOWN CALM; { [ "$verdict" = "NOTICE (partial — 1/3 axes unreachable)" ] && [ "$ec" = 0 ]; } || { echo "  FAIL: robust partial all-clear→NOTICE (got '$verdict')"; _f=1; }; ROBUST_PARTIAL="${PERIMETER_ROBUST_PARTIAL:-0}"
  # motion-attribution → PHYSICAL severity (the 2026-06-24 motion×operator-home integration)
  [ "$(motion_phy_sev UNEXPLAINED  0 CALM)"        = NOTICE ]      || { echo "  FAIL: UNEXPLAINED(rc0) raises CALM→NOTICE"; _f=1; }
  [ "$(motion_phy_sev UNEXPLAINED  0 UNREACHABLE)" = NOTICE ]      || { echo "  FAIL: UNEXPLAINED(rc0) makes BLE-blind axis assessable→NOTICE"; _f=1; }
  [ "$(motion_phy_sev UNEXPLAINED  0 ALERT)"       = ALERT ]       || { echo "  FAIL: motion NEVER lowers an existing ALERT"; _f=1; }
  [ "$(motion_phy_sev UNEXPLAINED  2 CALM)"        = CALM ]        || { echo "  FAIL: degraded motion (rc2) NEVER escalates (honest-fusion: dead radar ≠ intruder)"; _f=1; }
  [ "$(motion_phy_sev OCCUPANT     0 CALM)"        = CALM ]        || { echo "  FAIL: OCCUPANT (operator home, benign) never escalates"; _f=1; }
  [ "$(motion_phy_sev UNATTRIBUTED 0 CALM)"        = CALM ]        || { echo "  FAIL: UNATTRIBUTED (op-home unknown, neutral) never escalates"; _f=1; }
  [ "$(motion_phy_sev QUIET        0 CALM)"        = CALM ]        || { echo "  FAIL: QUIET (no motion) never escalates"; _f=1; }
  # gateway-identity → NETWORK severity (the 2026-07-03 ARP-canary integration)
  [ "$(gw_net_sev CHANGED 1 1 CALM)"        = ALERT ]       || { echo "  FAIL: fresh gateway-MAC flip raises CALM→ALERT"; _f=1; }
  [ "$(gw_net_sev CHANGED 1 1 UNREACHABLE)" = ALERT ]       || { echo "  FAIL: fresh flip makes a DHCP-blind axis assessable→ALERT"; _f=1; }
  [ "$(gw_net_sev STABLE  1 1 CALM)"        = NOTICE ]      || { echo "  FAIL: rebaselined flip within window raises CALM→NOTICE"; _f=1; }
  [ "$(gw_net_sev STABLE  1 1 ALERT)"       = ALERT ]       || { echo "  FAIL: canary NEVER lowers an existing ALERT"; _f=1; }
  [ "$(gw_net_sev STABLE  1 0 CALM)"        = CALM ]        || { echo "  FAIL: fresh STABLE binding never escalates"; _f=1; }
  [ "$(gw_net_sev NEW     1 0 CALM)"        = CALM ]        || { echo "  FAIL: NEW (first obs / gw moved networks) is neutral"; _f=1; }
  [ "$(gw_net_sev ''      0 0 CALM)"        = CALM ]        || { echo "  FAIL: stale/missing canary log never escalates (dead canary ≠ MITM)"; _f=1; }
  [ "$(gw_net_sev ''      0 0 UNREACHABLE)" = UNREACHABLE ] || { echo "  FAIL: stale canary must not fake assessability (blind stays blind)"; _f=1; }
  # gw_log_scan on fixtures (file-bound, epoch-parameterized — no live canary needed)
  _gtd="$(mktemp -d)"; _gl="$_gtd/gw.log"; _gnow=1000000000
  _gts() { date -u -d "@$1" +%FT%TZ; }
  printf '[gateway-identity] STABLE gw=192.168.8.1 mac=aa:bb:cc:dd:ee:ff dev=wlan0 since=x @ host %s\n' "$(_gts $((_gnow-300)))" > "$_gl"
  gw_log_scan "$_gl" "$_gnow"
  { [ "$gw_label" = STABLE ] && [ "$gw_fresh" = 1 ] && [ "$gw_recent" = 0 ] && [ "$gw_mac" = aa:bb:cc:dd:ee:ff ]; } \
    || { echo "  FAIL: fresh STABLE line should parse label/mac fresh=1 recent=0 (got $gw_label/$gw_mac/$gw_fresh/$gw_recent)"; _f=1; }
  printf '[gateway-identity] CHANGED gw=192.168.8.1 mac=de:ad:be:ef:00:01 dev=wlan0 was=aa:bb:cc:dd:ee:ff since=x @ host %s\n' "$(_gts $((_gnow-120)))" >> "$_gl"
  gw_log_scan "$_gl" "$_gnow"
  { [ "$gw_label" = CHANGED ] && [ "$gw_fresh" = 1 ] && [ "$gw_recent" = 1 ]; } \
    || { echo "  FAIL: newest fresh CHANGED should set label=CHANGED fresh=1 recent=1 (got $gw_label/$gw_fresh/$gw_recent)"; _f=1; }
  printf '[gateway-identity] STABLE gw=192.168.8.1 mac=de:ad:be:ef:00:01 dev=wlan0 since=x @ host %s\n' "$(_gts $((_gnow-60)))" >> "$_gl"
  gw_log_scan "$_gl" "$_gnow"
  { [ "$gw_label" = STABLE ] && [ "$gw_recent" = 1 ]; } \
    || { echo "  FAIL: rebaselined flip (CHANGED then STABLE) must keep recent=1 (got $gw_label/$gw_recent)"; _f=1; }
  gw_log_scan "$_gl" $((_gnow + 7200))
  { [ "$gw_fresh" = 0 ] && [ "$gw_recent" = 0 ]; } \
    || { echo "  FAIL: 2h-old log must read fresh=0 recent=0 (stale canary, got $gw_fresh/$gw_recent)"; _f=1; }
  printf 'gateway-identity: UNREACHABLE — no default route\n' > "$_gl"
  gw_log_scan "$_gl" "$_gnow"
  { [ -z "$gw_label" ] && [ "$gw_fresh" = 0 ]; } \
    || { echo "  FAIL: exit-2 stderr lines in the cron log must not parse as a verdict (got '$gw_label')"; _f=1; }
  rm -rf "$_gtd"
  [ "$_f" = 0 ] || { echo "smoke-test: FAIL (fusion contract)"; exit 1; }
  # at least one axis must be reachable or there is nothing live to fuse (the logic above is proven regardless)
  if mesh-watchtower --test >/dev/null 2>&1 || mesh-lan-newdevice --test >/dev/null 2>&1 \
     || mesh-presence --test >/dev/null 2>&1; then
    echo "smoke-test: ok (fusion contract: 26 assertions [6 fuse + 7 motion→PHYSICAL + 8 gw→NETWORK + 5 gw-log-scan] + ≥1 axis reachable)"; exit 0
  fi
  echo "smoke-test: n/a (fusion contract: 26 assertions PASS; no axis reachable now — outside/network/physical all down)"; exit 2
fi

RAW=0; EDGE=0
[ "${1:-}" = --raw ] && RAW=1
[ "${1:-}" = --edge ] && EDGE=1
STATEFILE="$HOME/.mesh/.perimeter.state"
# For --edge: snapshot the PREVIOUS verdict before the scan overwrites the state file
prev_verdict=""
if [ "$EDGE" -eq 1 ] && [ -f "$STATEFILE" ]; then
  prev_verdict="$(awk -F'\t' '{print $5}' "$STATEFILE" 2>/dev/null | head -1 || true)"
fi
HOST="$(hostname)"; TS="$(date -u +%FT%TZ)"
rawfacts=""

# ---- OUTSIDE: phaedra public-IP vantage (mesh-watchtower) ----------------------------------------
out_sev="UNREACHABLE"; out_msg="phaedra vantage unreachable (exit 2) — outside is BLIND, not clear"
wt="$(timeout 35 mesh-watchtower 2>/dev/null)"; wtrc=$?
if [ $wtrc -eq 0 ] && [ -n "$wt" ]; then
  rawfacts+="OUTSIDE	$wt"$'\n'
  if printf '%s' "$wt" | grep -q 'reach-down'; then
    out_sev="ALERT"; out_msg="external REACH DOWN — mesh blind from the outside: $wt"
  elif printf '%s' "$wt" | grep -q 'SCAN-SPIKE'; then
    # known-benign suppression: fingerprint the scan pattern (exposed ports + key-only auth).
    # A recurrence of the SAME ports every hour is routine internet noise, not an incident.
    # After BENIGN_SUPPRESS repeats, downgrade to CALM — the first N spikes still surface so
    # a genuinely NEW scan target (new port opened) is caught before suppression kicks in.
    fp="$(printf '%s' "$wt" | grep -oE 'exposes\[[^]]+\]' | head -1)"
    fp="${fp:-SCAN-SPIKE}"
    bcount=0
    if [ -f "$BENIGN_STATE" ]; then bcount=$(grep -m1 -F "$fp" "$BENIGN_STATE" 2>/dev/null | cut -d'|' -f2); fi
    bcount=$(( ${bcount:-0} + 1 ))
    grep -vF "$fp" "$BENIGN_STATE" 2>/dev/null > "$BENIGN_STATE.tmp" ; printf '%s|%d\n' "$fp" "$bcount" >> "$BENIGN_STATE.tmp"; mv -f "$BENIGN_STATE.tmp" "$BENIGN_STATE"
    if [ "$bcount" -ge "$BENIGN_SUPPRESS" ]; then
      out_sev="CALM"; out_msg="scan spike (known-benign ×${bcount}, suppressed): $wt"
    else
      out_sev="NOTICE"; out_msg="scan spike (benign: mesh is key-only auth, no password path): $wt"
    fi
  else
    out_sev="CALM"; out_msg="$wt"
  fi
else
  rawfacts+="OUTSIDE	UNREACHABLE (watchtower rc=$wtrc)"$'\n'
fi

# ---- NETWORK: home-LAN new/unknown device (mesh-lan-newdevice baseline, READ-ONLY) ---------------
net_sev="UNREACHABLE"; net_msg="router DHCP unreachable — LAN is BLIND, not clear"
st="$(timeout 20 mesh-lan-newdevice --status 2>/dev/null)"
leases="$(printf '%s\n' "$st" | awk 'NF>=3 && $3 ~ /^[0-9a-fA-F:]{17}$/ {print tolower($3)}')"
if printf '%s' "$st" | grep -qi 'unreachable'; then
  rawfacts+="NETWORK	UNREACHABLE (router DHCP unreadable)"$'\n'
elif [ -n "$leases" ]; then
  declare -A KMAC=()
  if [ -f "$KNOWN_LAN" ]; then while read -r m; do [ -n "$m" ] && KMAC["$(printf '%s' "$m" | tr 'A-F' 'a-f')"]=1; done < "$KNOWN_LAN"; fi
  unk_global=""; unk_laa=""; nlease=0
  while read -r mac; do
    [ -n "$mac" ] || continue; nlease=$((nlease+1))
    [ -n "${KMAC[$mac]:-}" ] && continue
    if is_laa "$mac"; then unk_laa+="$mac "; else unk_global+="$mac "; fi
  done <<<"$leases"
  rawfacts+="NETWORK	$nlease leases; unknown-global=[${unk_global% }] unknown-laa=[${unk_laa% }]"$'\n'
  if [ -n "$unk_global" ]; then
    net_sev="ALERT"; net_msg="UNKNOWN device on LAN (globally-unique MAC = real intrusion signal): ${unk_global% }"
  elif [ -n "$unk_laa" ]; then
    net_sev="NOTICE"; net_msg="unknown LAN MAC but randomized (likely a known device rotating): ${unk_laa% }"
  else
    net_sev="CALM"; net_msg="$nlease leases, all known (baseline ${#KMAC[@]} MACs)"
  fi
else
  rawfacts+="NETWORK	UNREACHABLE (no leases parsed)"$'\n'
fi

# ---- NETWORK (cont.): gateway ARP-binding canary (mesh-gateway-identity, READ-ONLY log tail) ------
# lan-newdevice above answers WHO is on the LAN; this answers whether the GATEWAY ITSELF is still the
# device it was. READ-ONLY on the canary's own cron log (running it live here would double-write its
# change-gated baseline — the same no-race doctrine as the lan-newdevice READ-ONLY read above).
GW_LOG="${PERIMETER_GW_LOG:-$HOME/.mesh/gateway-identity.log}"
gw_log_scan "$GW_LOG" "$(date +%s)" "${PERIMETER_GW_FRESH:-1200}" "${PERIMETER_GW_RECENT:-1800}"
net_sev_before="$net_sev"
net_sev="$(gw_net_sev "$gw_label" "$gw_fresh" "$gw_recent" "$net_sev")"
if [ "$gw_fresh" = 1 ] || [ "$gw_recent" = 1 ]; then
  rawfacts+="NETWORK-GATEWAY	$gw_label mac=$gw_mac fresh=$gw_fresh recent_changed=$gw_recent"$'\n'
  if [ "$net_sev" != "$net_sev_before" ]; then
    case "$gw_label" in
      CHANGED) net_msg="GATEWAY MAC FLIPPED (ARP-spoof/MITM or router swap; now mac=$gw_mac — verify the router); ${net_msg}" ;;
      *)       net_msg="gateway MAC flipped within the last 30m (canary rebaselined; now $gw_label $gw_mac); ${net_msg}" ;;
    esac
  else
    net_msg="$net_msg; gw=${gw_label}(${gw_mac})"
  fi
else
  rawfacts+="NETWORK-GATEWAY	unattestable (canary log stale/missing) — not escalating (honest-fusion)"$'\n'
fi

# ---- PHYSICAL: BLE devices in radio range (mesh-presence) ----------------------------------------
# BLE is intentionally INFORMATIONAL (the dedicated edge sense is mesh-presence-delta) — a busy
# environment is noisy, so perimeter reports presence without crying wolf. UNREACHABLE/BUSY stay
# distinct from "0 in range".
phy_sev="UNREACHABLE"; phy_msg="BLE adapter unavailable — physical proximity BLIND, not clear"
pr="$(timeout $((BLE_WIN + 40)) mesh-presence "$BLE_WIN" 2>/dev/null)"; prc=$?
if [ $prc -eq 3 ]; then
  rawfacts+="PHYSICAL	BUSY (adapter scan-locked by another scanner — not an empty reading)"$'\n'
  phy_sev="UNREACHABLE"; phy_msg="BLE adapter busy (another scanner holds it) — could not sample"
elif [ $prc -eq 0 ] && [ -n "$pr" ]; then
  dev="$(printf '%s\n' "$pr" | grep -E '^-?[0-9]+\|')"
  ndev="$(printf '%s\n' "$dev" | grep -c . )"
  # named = a real name (not '?'), excluding obvious randomized device-name tokens (SC-XXXX hex)
  named="$(printf '%s\n' "$dev" | awk -F'|' '$3!="?" && $3!="" && $3 !~ /^SC-[0-9A-F]+$/ {print $3}' | paste -sd';' -)"
  rawfacts+="PHYSICAL	$ndev BLE in range; named=[$named]"$'\n'
  phy_sev="CALM"; phy_msg="$ndev BLE device(s) in range${named:+; named: $named}"
elif [ $prc -eq 1 ] || [ $prc -eq 0 ]; then
  rawfacts+="PHYSICAL	0 devices (presence rc=$prc)"$'\n'
  phy_sev="CALM"; phy_msg="0 BLE devices in range"
else
  rawfacts+="PHYSICAL	UNREACHABLE (presence rc=$prc)"$'\n'
  phy_msg="BLE adapter could not be read (rc=$prc)"
fi

# ---- PHYSICAL (cont.): MOTION × operator-home (mesh-motion-attribution) -----------------------------
# BLE above sees DEVICES; this adds whether unexplained physical MOTION is happening while the operator
# is AWAY — the device-less intruder BLE-presence alone misses (0 BLE devices is exactly that case).
# Reads its own cached presence.log (no live BLE scan → no adapter contention with the block above);
# its wifi-motion probe is independent. Honest-fusion: ONLY a confident UNEXPLAINED raises severity
# (to NOTICE); a degraded/UNKNOWN read never escalates, OCCUPANT/ATTRIBUTED/UNATTRIBUTED/QUIET don't.
ma_json="$(timeout 30 mesh-motion-attribution --json 2>/dev/null)"; marc=$?
ma_verdict="$(printf '%s' "$ma_json" | sed -nE 's/.*"verdict":"([^"]+)".*/\1/p')"
[ -n "$ma_verdict" ] || ma_verdict="UNKNOWN"
phy_sev_before="$phy_sev"
phy_sev="$(motion_phy_sev "$ma_verdict" "$marc" "$phy_sev")"
if [ "$marc" -eq 0 ]; then
  rawfacts+="PHYSICAL-MOTION	$ma_verdict"$'\n'
  case "$ma_verdict" in
    UNEXPLAINED)
      [ "$phy_sev" != "$phy_sev_before" ] \
        && phy_msg="$phy_msg; MOTION while operator AWAY, no carried-device cause (UNEXPLAINED — investigate)" \
        || phy_msg="$phy_msg; UNEXPLAINED motion (already $phy_sev_before)" ;;
    OCCUPANT|ATTRIBUTED|UNATTRIBUTED) phy_msg="$phy_msg; motion=$ma_verdict (benign/neutral)" ;;
  esac
else
  rawfacts+="PHYSICAL-MOTION	UNKNOWN/degraded (motion-attribution rc=$marc) — not escalating (honest-fusion)"$'\n'
fi

# ---- FUSE: overall verdict = worst REACHABLE axis (rank()/fuse_posture defined up top, shared with --test)
fuse_posture "$out_sev" "$net_sev" "$phy_sev"

# cache the verdict for the META-fusion (mesh-situation reads this cheaply instead of re-running the
# heavy external axis). One line: <iso-ts>\t<out_sev>\t<net_sev>\t<phy_sev>\t<verdict>
printf '%s\t%s\t%s\t%s\t%s\n' "$TS" "$out_sev" "$net_sev" "$phy_sev" "$verdict" > "$STATEFILE" 2>/dev/null || true

if [ "$RAW" -eq 1 ]; then printf '%s' "$rawfacts"; exit "$ec"; fi

# --edge: only emit when verdict changes (suppress identical repeats for cron wiring)
if [ "$EDGE" -eq 1 ] && [ "$verdict" = "$prev_verdict" ]; then exit "$ec"; fi

# --edge posts ONE terse verdict line (not the 4-line report — that's high-bulk board noise; mirrors
# mesh-stress's one-line edge). Full detail stays available via `mesh-perimeter` or ~/.mesh/.perimeter.state.
if [ "$EDGE" -eq 1 ]; then
  case "$verdict" in
    CALM|NOMINAL)   mark=perimeter-calm ;;
    ALERT|CRITICAL) mark=perimeter-alert ;;
    *)              mark=perimeter-notice ;;
  esac
  # surface the DRIVING axis's reason (the one whose severity == the fused verdict), trimmed to 1 line
  if   [ "$out_sev" = "$verdict" ]; then reason="$out_msg"
  elif [ "$net_sev" = "$verdict" ]; then reason="$net_msg"
  elif [ "$phy_sev" = "$verdict" ]; then reason="$phy_msg"
  else reason="$out_msg"; fi
  reason="$(printf '%s' "$reason" | cut -c1-90)"
  printf '[%s] %s: O=%s N=%s P=%s — %s (mesh-perimeter for full)\n' \
    "$mark" "$HOST" "$out_sev" "$net_sev" "$phy_sev" "$reason"
  exit "$ec"
fi

printf '=== mesh-perimeter %s @ %s — %s ===\n' "$HOST" "$TS" "$verdict"
printf ' OUTSIDE  [%-11s] %s\n' "$out_sev" "$out_msg"
printf ' NETWORK  [%-11s] %s\n' "$net_sev" "$net_msg"
printf ' PHYSICAL [%-11s] %s\n' "$phy_sev" "$phy_msg"
exit "$ec"
