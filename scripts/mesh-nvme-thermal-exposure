#!/usr/bin/env bash
# orphan-ok: on-demand NVMe thermal-exposure read; a human or sense consumer calls it when needed
# mesh-nvme-thermal-exposure — cumulative controller-reported time above NVMe thermal thresholds.
# Reads warning_temp_time and critical_comp_time from each reachable NVMe SMART log. These are
# controller lifetime counters in minutes, not an estimate from current temperature.
#
# Usage:
#   mesh-nvme-thermal-exposure [--json]
#   mesh-nvme-thermal-exposure --test   parser fixtures + at least one real controller read
#
# Honest contract: missing nvme-cli, noninteractive sudo, device, command success, or required
# counter fields means that controller is omitted. If no controller returns a valid real reading,
# exit 2. A zero counter is emitted only when it was present in a successful controller response.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

ROOT="${MESH_NVME_THERMAL_ROOT:-/sys/class/nvme}"
NVME="${MESH_NVME_THERMAL_NVME:-nvme}"
SUDO="${MESH_NVME_THERMAL_SUDO:-sudo}"

parse_log() {
  python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
    keys = ("warning_temp_time", "critical_comp_time")
    vals = [d[k] for k in keys]
    if any(type(v) is not int or v < 0 for v in vals):
        raise ValueError("thermal counters must be non-negative integers")
    print("\t".join(map(str, vals)))
except Exception as e:
    print("invalid NVMe thermal log: " + str(e), file=sys.stderr)
    sys.exit(1)
'
}

read_all() {
  local ctl dev serial raw parsed count=0 json_mode="${1:-0}"
  local -a rows=()
  shopt -s nullglob
  for ctl in "$ROOT"/nvme[0-9]*; do
    [ -d "$ctl" ] || continue
    [[ "$(basename "$ctl")" =~ ^nvme[0-9]+$ ]] || continue
    dev="/dev/$(basename "$ctl")"
    [ -r "$ctl/serial" ] || continue
    IFS= read -r serial < "$ctl/serial" || continue
    serial="${serial//[[:space:]]/}"
    [ -n "$serial" ] || continue
    raw="$("$SUDO" -n "$NVME" smart-log "$dev" -o json 2>/dev/null)" || continue
    parsed="$(printf '%s\n' "$raw" | parse_log 2>/dev/null)" || continue
    local warning critical
    IFS=$'\t' read -r warning critical <<< "$parsed"
    [ -n "$warning" ] && [ -n "$critical" ] || continue
    if [ "$json_mode" = 1 ]; then
      rows+=("{\"serial\":\"${serial//\"/\\\"}\",\"warning_temp_min\":$warning,\"critical_comp_min\":$critical}")
    else
      rows+=("nvme-thermal-exposure|serial=$serial|warning_temp_min=$warning|critical_comp_min=$critical")
    fi
    count=$((count + 1))
  done
  shopt -u nullglob
  [ "$count" -gt 0 ] || return 2
  if [ "$json_mode" = 1 ]; then
    printf '[%s]\n' "$(IFS=,; echo "${rows[*]}")"
  else
    printf '%s\n' "${rows[@]}"
  fi
}

test_tool() {
  local got live_rc
  got="$(printf '%s\n' '{"warning_temp_time":0,"critical_comp_time":7}' | parse_log)" || {
    echo "smoke-test: FAIL (valid counters rejected)"; return 1;
  }
  [ "$got" = $'0\t7' ] || { echo "smoke-test: FAIL (counter values changed: $got)"; return 1; }
  if printf '%s\n' '{"warning_temp_time":-1,"critical_comp_time":0}' | parse_log >/dev/null 2>&1; then
    echo "smoke-test: FAIL (negative counter accepted)"; return 1
  fi
  if printf '%s\n' '{"warning_temp_time":0}' | parse_log >/dev/null 2>&1; then
    echo "smoke-test: FAIL (missing counter accepted)"; return 1
  fi
  live="$(read_all)"; live_rc=$?
  [ "$live_rc" -eq 0 ] || {
    echo "smoke-test: n/a (no NVMe controller produced a real thermal log; exit 2)" >&2
    return 2
  }
  printf '%s\n' "$live" | awk -F'|' '
    NF != 4 || $1 != "nvme-thermal-exposure" || $2 !~ /^serial=.+/ ||
      $3 !~ /^warning_temp_min=[0-9]+$/ || $4 !~ /^critical_comp_min=[0-9]+$/ { exit 1 }
  ' || { echo "smoke-test: FAIL (live artifact malformed)"; return 1; }
  echo "smoke-test: ok (fixture parser + live NVMe thermal SMART read)"
}

case "${1:-}" in
  --test) test_tool; exit $? ;;
  --json) read_all 1; exit $? ;;
  "") read_all 0; exit $? ;;
  *) echo "usage: mesh-nvme-thermal-exposure [--json|--test]" >&2; exit 1 ;;
esac
