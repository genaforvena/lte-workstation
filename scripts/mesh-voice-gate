#!/usr/bin/env bash
# mesh-voice-gate — should the mesh make sound on this node RIGHT NOW?
#
# Single source of truth for the Bose/output mute decision. Every audio-output path calls this
# before playing; if it exits non-zero, the path stays SILENT. Three suppression causes (any one):
#   1. ~/.mesh/room-voice-off   — manual operator silence switch (the one mesh-overhear always honored)
#   2. ~/.mesh/thermal-silence  — AUTO flag: mesh-therm-watch sets it on a sustained HOT episode,
#                                 clears it on recovery. So a node that's overheating/throttling goes
#                                 quiet on its own — the operator doesn't have to flip the switch each
#                                 overheat (operator 2026-06-24: "оч мешает" — ds reboots ~4×/day and a
#                                 sound fired on each recovery).
#   3. ~/.mesh/.therm-state == HOT — live belt-and-suspenders (the auto flag has up to a */5 cron lag;
#                                    the live state catches a fresh spike inside that window).
#
# Which mode ("fully off" vs "only during overheat") is just which flags are set: remove
# room-voice-off and therm-watch manages thermal-silence → sound only during overheat; keep
# room-voice-off → fully off. The gate doesn't care; it suppresses on ANY cause.
#
#   mesh-voice-gate                 check THIS node; exit 0=allow, 1=suppress (reason on stderr)
#   mesh-voice-gate --node U@H      check a REMOTE node (the Bose node) over ssh — for paths that play
#                                   cross-node (mesh-voice-tx --bose, mesh-room-music --play) so the
#                                   decision is made where the sound actually comes out.
#   mesh-voice-gate --test          logic self-test (synthetic flag states; no sound, no side effects)
#
# Fail-OPEN on remote: if the ssh is unreachable or the gate binary missing there, ALLOW (exit 0) —
# fail-open for sound (don't strand the voice lifeline); room-voice-off is the primary, reliable mute.
set -uo pipefail
MESH="${MESH_DIR:-$HOME/.mesh}"

# ---- --test: exercise the flag logic against synthetic MESH_DIR states (no real flags touched) ----
if [ "${1:-}" = "--test" ]; then
  td="$(mktemp -d /tmp/mvg-test.XXXXXX)" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
  trap 'rm -rf "$td"' EXIT
  MESH_DIR="$td" MESH="$td" "$0" --selftest "$td"; exit $?
fi

if [ "${1:-}" = "--selftest" ]; then
  # internal: argv[2] = a temp MESH dir; run the LOCAL decision fn against several flag combos.
  td="$2"; fail=0
  decide(){  # → 0 allow / 1 suppress (reason on stderr). Thermal only when VOICE_GATE_THERMAL=1.
    local reason=""
    [ -f "$td/room-voice-off" ] && reason="room-voice-off"
    if [ -z "$reason" ] && [ "${VOICE_GATE_THERMAL:-0}" = 1 ]; then
      [ -f "$td/thermal-silence" ] && reason="thermal-silence"
      if [ -z "$reason" ]; then
        local st; st="$(cat "$td/.therm-state" 2>/dev/null || echo OK)"
        [ "$st" = "HOT" ] && reason="therm-state HOT"
      fi
    fi
    [ -n "$reason" ] && { echo "$reason" >&2; return 1; }
    return 0
  }
  chk(){ # $1=name $2=want(allow|suppress)
    if [ "$2" = allow ]; then decide 2>/dev/null && echo "  [PASS] $1 → allow" || { echo "  [FAIL] $1 → expected allow, got suppress"; fail=1; }
    else decide 2>/dev/null && { echo "  [FAIL] $1 → expected suppress, got allow"; fail=1; } || echo "  [PASS] $1 → suppress"; fi
  }
  rm -f "$td"/room-voice-off "$td"/thermal-silence "$td/.therm-state"
  chk "no flags (normal)"          allow
  : > "$td/.therm-state"; echo OK > "$td/.therm-state"
  chk "therm-state OK (normal)"    allow
  echo HOT > "$td/.therm-state"
  chk "therm-state HOT — DEFAULT ignores (audio is not heat-provoking)"   allow
  VOICE_GATE_THERMAL=1 chk "therm-state HOT — opt-in (VOICE_GATE_THERMAL=1) gates"   suppress
  rm -f "$td/.therm-state"; echo OK > "$td/.therm-state"
  : > "$td/thermal-silence"
  chk "thermal-silence — DEFAULT ignores"   allow
  VOICE_GATE_THERMAL=1 chk "thermal-silence — opt-in gates"              suppress
  rm -f "$td/thermal-silence"
  : > "$td/room-voice-off"
  chk "room-voice-off (manual)"    suppress      # the manual switch ALWAYS wins
  echo OK > "$td/.therm-state"
  chk "room-voice-off + therm OK"  suppress
  : > "$td/thermal-silence"
  chk "manual + thermal-silence set — manual wins"   suppress
  [ "$fail" = 0 ] && { echo "smoke-test: ok (manual switch gates by default; thermal opt-in via VOICE_GATE_THERMAL=1)"; exit 0; }
  echo "smoke-test: FAIL"; exit 1
fi

# ---- --node: recurse over ssh so the decision is made WHERE THE SOUND COMES OUT ----
if [ "${1:-}" = "--node" ] && [ $# -ge 2 ]; then
  node="$2"
  out="$(ssh -o BatchMode=yes -o ConnectTimeout=4 "$node" 'mesh-voice-gate 2>&1 >/dev/null' 2>/dev/null)"
  # remote suppressed (exit 1) → its stderr starts with the reason; propagate the suppress.
  if [ -n "$out" ]; then echo "mesh-voice-gate: SUPPRESS via $node — $out" >&2; exit 1; fi
  exit 0   # remote allowed OR unreachable/not-installed → fail-OPEN (don't strand the voice lifeline)
fi

# ---- local decision ----
# (operator 2026-07-04: "audio playback is not heat-provoking" — thermal-muting AUDIO was misdirected;
#  the real heat sources are whisper/minds, which carry their own guards: OH_STT_FAST, mind-shed, and
#  therm-watch gating COMPUTE. Room voice now plays ALWAYS unless the operator's own silence switch is
#  set. Set VOICE_GATE_THERMAL=1 to re-enable thermal-silence / .therm-state HOT suppression if a node
#  ever truly needs audio muted for heat.)
_reason=""
[ -f "$MESH/room-voice-off" ] && _reason="room-voice-off (manual silence switch)"
if [ -z "$_reason" ] && [ "${VOICE_GATE_THERMAL:-0}" = 1 ]; then
  [ -f "$MESH/thermal-silence" ] && _reason="thermal-silence (auto overheat mute)"
  if [ -z "$_reason" ]; then
    st="$(cat "$MESH/.therm-state" 2>/dev/null || echo OK)"
    [ "$st" = "HOT" ] && _reason="therm-state HOT (live)"
  fi
fi
if [ -n "$_reason" ]; then
  echo "$_reason" >&2
  exit 1
fi
exit 0
