#!/usr/bin/env bash
# mesh-reflexes — the node's cron reflexes have a DECLARED source of truth, and drift self-heals.
#
# The problem this closes: ~45 autonomy reflexes (role-ticks, supervise, feed, generate, chat-sync,
# the monitor streams) lived ONLY in the live crontab. Nothing declared them; mesh-restore guarded
# just `mesh-tick`. A concurrent `(crontab -l; echo NEW) | crontab -` race (two stewards) does a
# read-modify-write that silently DROPS whatever the other just added — observed as "5th reflex
# drop today". A dropped reflex = a hole in self-healing until a human notices.
#
# The fix: ~/.mesh/reflexes.cron is the DESIRED set (node-local, gitignored, survives reboot in
# ~/.mesh). `--apply` reconciles the live crontab to be a SUPERSET of it: every desired reflex
# present (added if missing), and NOTHING ever removed (operator/other lines preserved). Idempotent
# and flock-serialized, so concurrent applies can't race. Wired into mesh-restore (runs */5) →
# any dropped reflex is back within 5 minutes.
#
#   mesh-reflexes --snapshot   capture the current crontab as the desired set (bootstrap / re-baseline)
#   mesh-reflexes --apply      ensure every desired reflex is present (add missing; never drop). flock'd.
#   mesh-reflexes --check      list desired reflexes MISSING from the live crontab; exit 1 if any.
#                              Also names WITHHELD (commented out, not re-added) and RESURRECTED
#                              (running AND commented out — a withdrawal that was already undone).
#   mesh-reflexes --test       smoke test
#
# PAUSE convention (chat-review/compute-node-dispatchers-bypass-the-governor 2026-07-21): to pause a
# reflex WITHOUT un-wiring it, comment its crontab line out UNDER a '# PAUSED <slug> <date> ...'
# marker line (context = the consecutive comment lines that follow the marker; keep the commented
# line — a marker alone protects nothing). --apply then skips re-adding it (PAUSED in the summary)
# and --check reports it PAUSED, not MISSING. Deleting the line from BOTH the crontab and
# reflexes.cron remains the full un-wire (autowire won't re-wire while the commented line sits in
# the crontab — its already-wired grep matches comments too).
#
# WITHHOLD (2026-08-19, review-constraint-closure-…): commenting a cron line out is a WITHDRAWAL
# whatever words precede it, and --apply now honours EVERY spelling, not just the PAUSED marker.
# It had to: the PAUSED form was the only one recognised, so any other wording read as ABSENT and
# the */5 self-heal put the reflex straight back. MEASURED here — the operator quiesced three GPU
# reflexes on 2026-07-24 as `# GPU-QUIESCE 2026-07-24 operator: <the whole cron line>`; all three
# were re-added and have been running for 26 days beside their own commented-out monument
# (`--check` now prints them as RESURRECTED). A desired reflex whose signature also appears in a
# commented-out cron line is WITHHELD: not re-added, named in the summary, posted once per set.
# This aligns mesh-reflexes with mesh-autowire, which ALREADY treats a commented line as protective
# ("already wired? present in the desired set OR the live crontab" — its grep matches comments); the
# two tools disagreed, and the one that ran every 5 minutes won.
# Note what a WITHHOLD does NOT do: it stops the next resurrection, it cannot un-run the ones
# already spent, and it leaves the desired set still asserting the reflex. Deleting the line from
# reflexes.cron is still the only full un-wire — the withhold just stops the crontab from silently
# out-voting the human while that has not happened.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
DESIRED="${MESH_REFLEXES:-$HOME/.mesh/reflexes.cron}"
LOCK="$HOME/.mesh/.reflexes.lock"

# A stable per-line SIGNATURE: identifies "this reflex" regardless of schedule/logfile tweaks, so a
# schedule change doesn't create a duplicate and a presence check is robust. Drops the 5 schedule
# fields (or the @token), the trailing redirections, normalizes $HOME and whitespace.
sigs() { # stdin: crontab lines -> stdout: one signature per non-comment/non-blank line
         # `sigs --paused`: instead emit the sig of each cron line COMMENTED OUT under a
         # '# PAUSED <slug> ...' marker (the deliberate-pause convention; context runs over the
         # following comment lines and breaks at the first blank/non-comment line).
         # `sigs --commented`: emit the sig of EVERY commented-out cron line, whatever wording
         # precedes it — the WITHHELD set. A human who comments a reflex out has withdrawn it;
         # PAUSED is one spelling of that, not the only one. KEEP IN SYNC with RECONCILE_PY.
  python3 -c '
import sys,re
home="'"$HOME"'"
paused_mode = (len(sys.argv)>1 and sys.argv[1]=="--paused")
comment_mode = (len(sys.argv)>1 and sys.argv[1]=="--commented")
CRONISH=re.compile(r"((?:[-0-9*/,]+\s+){4}[-0-9*/,]+\s+\S.*)$")
ATISH=re.compile(r"(@[a-z]+\s+\S.*)$")
in_pause=False
for raw in sys.stdin:
    line=raw.rstrip("\n")
    s=line.strip()
    if comment_mode:
        if not s.startswith("#"): continue
        body=s.lstrip("#").strip()
        m=CRONISH.search(body) or ATISH.search(body)
        if not m: continue
        s=m.group(1)
    elif paused_mode:
        if re.match(r"^#\s*PAUSED\b",s): in_pause=True; continue
        if not s or not s.startswith("#"): in_pause=False; continue
        if not in_pause: continue
        s=s.lstrip("#").strip()
        if not s or s.startswith("#"): continue
    elif not s or s.startswith("#"): continue
    s=s.replace("$HOME",home).replace("${HOME}",home)
    if s.startswith("@"):                       # @reboot CMD  -> drop first token
        s=s.split(None,1)[1] if len(s.split(None,1))>1 else s
    elif re.match(r"^[A-Za-z_][A-Za-z0-9_]*=",s): # PATH=/env assignment -> keep whole
        pass
    else:                                       # M H D Mo Dw CMD -> drop 5 schedule fields
        parts=s.split(None,5); s=parts[5] if len(parts)>5 else s
    s=re.sub(r"\s+#.*$","",s)                           # strip a trailing shell-comment note FIRST: a cron
                                                        # line carries ` # autowired ...` / ` # reconciled ...`;
                                                        # the comment is NOT behaviour, so it must NOT change the
                                                        # signature. (Was missing → a comment edit minted a new sig →
                                                        # --apply appended a comment-only TWIN: the cron-dup-entries
                                                        # bug. Strip BEFORE redirections so a `->`/`>` inside the note
                                                        # is not mis-eaten as a redirection.) KEEP IN SYNC with RECONCILE_PY.
    s=re.sub(r"\s*(>>?\s*\S+|2>&1|2>\s*\S+)\s*"," ",s)  # strip redirections
    s=re.sub(r"\s+"," ",s).strip()
    print(s)
' "$@"
}

# Dedup the trace post. A chronically dropped+restored reflex would post the SAME self-heal line
# every cron cycle (observed 5×/220 board lines, chat-review 2026-06-17) — the Nth identical post
# adds no signal and drowns the window. Suppress a repeat: post only when the EVENT signature (the
# healed reflexes by stable signature + the count) changed, or the last identical post is >1h old.
# The crontab is still fixed either way — only the noisy trace line is throttled, never the heal.
# POST TO mesh-trace (metabolism tier), NOT mesh-chat (coordination board) — same fix class as
# autowired→trace 25b784f, compact→compact.log, sense-evolve→trace (chat-review 2026-06-20).
HEALED_SENTINEL="$HOME/.mesh/.reflexes-healed"
withheld_post() {  # $1 = trace message, $2 = event signature — own sentinel, 6h window
  local last_sig="" last_age=999999 now sent="$HOME/.mesh/.reflexes-withheld.sentinel"
  if [ -f "$sent" ]; then
    last_sig="$(head -1 "$sent" 2>/dev/null)"
    now="$(date +%s 2>/dev/null || echo 0)"
    last_age=$(( now - $(stat -c %Y "$sent" 2>/dev/null || echo 0) ))
  fi
  [ "$last_sig" = "$2" ] && [ "$last_age" -lt 21600 ] && return 0
  command -v mesh-trace >/dev/null 2>&1 && mesh-trace "$1" >/dev/null 2>&1 || true
  printf '%s\n' "$2" > "$sent" 2>/dev/null || true
}

heal_post() {  # $1 = trace message, $2 = event signature
  local last_sig="" last_age=999999 now
  if [ -f "$HEALED_SENTINEL" ]; then
    last_sig="$(head -1 "$HEALED_SENTINEL" 2>/dev/null)"
    now="$(date +%s 2>/dev/null || echo 0)"
    last_age=$(( now - $(stat -c %Y "$HEALED_SENTINEL" 2>/dev/null || echo 0) ))
  fi
  [ "$last_sig" = "$2" ] && [ "$last_age" -lt 3600 ] && return 0   # same event, <1h ago → suppress
  command -v mesh-trace >/dev/null 2>&1 && mesh-trace "$1" >/dev/null 2>&1 || true
  printf '%s\n' "$2" > "$HEALED_SENTINEL" 2>/dev/null || true
}

# RECONCILE_PY — given DESIRED + a live-crontab file, emit the reconciled crontab (argv[3]) and a
# machine summary on stdout. The reconcile, not a blind append:
#   - exact-duplicate live lines           → drop (routine, always was)
#   - a live line whose sig == a DESIRED reflex's sig → that slot is MANAGED: keep the FIRST occurrence
#       but REWRITE it to the desired raw line (so a cadence/comment reconcile in reflexes.cron actually
#       takes effect — REPLACE, not append), and DROP any further same-sig twins (collapse the dups).
#   - a live line whose sig is NOT desired  → operator/other line, preserved verbatim (never-drop invariant)
#   - a desired reflex whose sig never appeared in live → appended (genuinely missing — self-heal)
# This closes cron-dup-entries: a comment/cadence edit reconciles in place instead of minting a twin,
# and the existing comment-only twins collapse to one on the next --apply. sig() MUST match sigs() above.
RECONCILE_PY='
import sys,re,os
from collections import Counter
home=os.environ["HOME"]
desired_path,live_path,out_path=sys.argv[1],sys.argv[2],sys.argv[3]
def sig(line):
    s=line.strip()
    if not s or s.startswith("#"): return None
    s=s.replace("$HOME",home).replace("${HOME}",home)
    if s.startswith("@"):
        p=s.split(None,1); s=p[1] if len(p)>1 else s
    elif re.match(r"^[A-Za-z_][A-Za-z0-9_]*=",s):
        pass
    else:
        p=s.split(None,5); s=p[5] if len(p)>5 else s
    s=re.sub(r"\s+#.*$","",s)
    s=re.sub(r"\s*(>>?\s*\S+|2>&1|2>\s*\S+)\s*"," ",s)
    s=re.sub(r"\s+"," ",s).strip()
    return s
want={}; dorder=[]
for l in open(desired_path).read().splitlines():
    if not l.strip() or l.strip().startswith("#"): continue
    g=sig(l)
    if g is None: continue
    if g not in want: dorder.append(g)
    want[g]=l
# PAUSED scan: a comment line "# PAUSED <slug> ..." opens a pause context over the FOLLOWING
# commented-out cron lines (broken by the first blank/non-comment line). Their sigs are DELIBERATELY
# paused: never re-added by the self-heal below — else --apply resurrects a paused reflex every
# cycle (the phaedra mesh-dispatch case, 2026-07-21). KEEP IN SYNC with sigs --paused.
paused=set(); in_pause=False
for line in open(live_path).read().splitlines():
    st=line.strip()
    if re.match(r"^#\s*PAUSED\b",st): in_pause=True; continue
    if not st or not st.startswith("#"): in_pause=False; continue
    if in_pause:
        g=sig(st.lstrip("#").strip())
        if g: paused.add(g)
# COMMENTED-TWIN scan (WITHHELD). A human who comments a reflex OUT of the live crontab has
# withdrawn it — whatever words they wrote in front of it. The PAUSED marker above is ONE spelling
# of that; it is not the only one anybody uses, and requiring it made every other spelling a no-op.
# MEASURED on this node 2026-08-19: the operator quiesced three GPU reflexes on 2026-07-24 as
#   "# GPU-QUIESCE 2026-07-24 operator: */5 * * * * $HOME/.local/bin/mesh-bruno >> ..."
# and --apply, running every 5 minutes, read that as ABSENT and re-added all three within the hour.
# They have been running for 26 days beside their own commented-out monument (bruno.log was written
# 60 s before this was measured). So: a desired reflex whose signature ALSO appears in a
# commented-out cron line is WITHHELD — never silently re-added. mesh-autowire already reads a
# commented line as protective ("already wired? present in the desired set OR the live crontab" —
# its grep matches comments); this makes mesh-reflexes agree with it instead of undoing it.
# The schedule need not sit at the start of the comment: the marker text can precede it, so the
# cron line is searched for ANYWHERE after the "#" rather than assumed to be the first token.
CRONISH=re.compile(r"((?:[-0-9*/,]+\s+){4}[-0-9*/,]+\s+\S.*)$")
ATISH=re.compile(r"(@[a-z]+\s+\S.*)$")
def commented_sig(line):
    st=line.strip()
    if not st.startswith("#"): return None
    body=st.lstrip("#").strip()
    m=CRONISH.search(body) or ATISH.search(body)
    if not m: return None
    return sig(m.group(1))
commented=set()
for line in open(live_path).read().splitlines():
    g=commented_sig(line)
    if g: commented.add(g)
# live, exact-deduped, order-preserving
live=[]; seen=set(); deduped=[]
for line in open(live_path).read().splitlines():
    st=line.strip()
    if st=="" or st.startswith("#"):
        live.append(("c",line)); continue
    if line in seen:
        deduped.append(line); continue            # exact-duplicate line -> drop (routine)
    seen.add(line); live.append(("x",line))
cnt=Counter(sig(l) for k,l in live if k=="x")
out=[]; placed=set(); replaced=[]; collapsed=[]
for k,line in live:
    if k=="c":
        out.append(line); continue
    g=sig(line)
    if g in want and cnt[g]>1:
        # TWIN of a desired reflex (the cron-dup case: a reconcile that minted a comment/text twin).
        # Collapse to ONE canonical desired line at the FIRST occurrence; drop the later twin(s). This
        # is the "REPLACE a reconciled entry rather than append a duplicate" the task asks for.
        if g in placed:
            collapsed.append(line); continue
        placed.add(g); canon=want[g]
        if line.strip()!=canon.strip():
            out.append(canon); replaced.append(g)
        else:
            out.append(line)
    else:
        # SINGLETON (or non-desired) live line -> preserve verbatim. Deliberately do NOT re-pace a
        # single live reflex to match the desired schedule: a live-only slow-down not yet written back
        # to reflexes.cron (e.g. an operator pacing change) must NOT be silently reverted. Schedule
        # reconcile is the operator/steward decision; --apply only de-dups + self-heals missing.
        out.append(line)
        if g in want: placed.add(g)
added=[]; pausedskip=[]; withheld=[]
for g in dorder:
    if g not in placed and cnt.get(g,0)==0:        # desired reflex entirely absent from live -> self-heal
        if g in paused:                            # ... unless deliberately PAUSED in the live crontab
            pausedskip.append(want[g]); continue
        if g in commented:                         # ... or commented out under ANY wording (WITHHELD)
            withheld.append(want[g]); continue
        out.append(want[g]); placed.add(g); added.append(want[g])
deduped=deduped+collapsed
open(out_path,"w").write(("\n".join(out)+"\n") if out else "")
def nm(ls):
    return " ".join(sorted({m for l in ls for m in re.findall(r"mesh-[a-z0-9][a-z0-9-]*",l)}))
print("ADDED=%d"%len(added))
print("REPLACED=%d"%len(replaced))
print("DEDUPED=%d"%len(deduped))
print("PAUSED=%d"%len(pausedskip))
print("WITHHELD=%d"%len(withheld))
print("CHANGED=%d"%(1 if (added or replaced or deduped) else 0))
print("ADDNAMES=%s"%nm(added))
print("ADDSIGS=%s"%"|".join(sorted(sig(l) for l in added)))
print("PAUSEDNAMES=%s"%nm(pausedskip))
print("WITHHELDNAMES=%s"%nm(withheld))
print("WITHHELDSIGS=%s"%"|".join(sorted(sig(l) for l in withheld)))
'

case "${1:-}" in
  --test)
    command -v crontab >/dev/null 2>&1 || { echo "smoke-test: FAIL (no crontab)"; exit 1; }
    command -v python3 >/dev/null 2>&1 || { echo "smoke-test: FAIL (no python3)"; exit 1; }
    command -v flock   >/dev/null 2>&1 || { echo "smoke-test: FAIL (no flock)"; exit 1; }
    mkdir -p "$HOME/.mesh" 2>/dev/null || { echo "smoke-test: FAIL (no ~/.mesh)"; exit 1; }
    printf '%s\n' '*/2 * * * * $HOME/.local/bin/mesh-x >> /dev/null 2>&1' | sigs | grep -q 'mesh-x' \
      || { echo "smoke-test: FAIL (signature extraction broken)"; exit 1; }
    # heal_post dedup: a repeated identical event (same sig, <1h) posts at most once; a NEW sig posts.
    # Shadow mesh-trace with a recorder so the test never touches the real trace.
    tdir="$(mktemp -d)"; printf '#!/bin/sh\necho x >> "%s/posts"\n' "$tdir" > "$tdir/mesh-trace"
    chmod +x "$tdir/mesh-trace"; PATH="$tdir:$PATH"; HEALED_SENTINEL="$tdir/sent"
    heal_post "msg" "sig-1"; heal_post "msg" "sig-1"   # 2nd identical+fresh → suppressed
    heal_post "msg" "sig-2"                            # different sig → posts
    posts=$(grep -c . "$tdir/posts" 2>/dev/null || echo 0); rm -rf "$tdir"
    [ "$posts" = "2" ] || { echo "smoke-test: FAIL (heal_post dedup: want 2 posts [sig-1 once + sig-2], got $posts)"; exit 1; }
    # --snapshot must record an EMPTY desired set when the crontab has NO reflex lines (all-comment /
    # empty crontab — the reorg-paused state). FALSIFIABLE: revert the fix to `&& mv` and this FAILs
    # (empty grep -v exits 1 → mv skipped → DESIRED never written). Sandboxed: shadow `crontab` + a tmp DESIRED.
    sdir="$(mktemp -d)"; printf '#!/bin/sh\nprintf "%%s\\n" "# only comments" ""\n' > "$sdir/crontab"
    chmod +x "$sdir/crontab"
    MESH_REFLEXES="$sdir/desired.cron" PATH="$sdir:$PATH" bash "$0" --snapshot >/dev/null 2>&1
    [ -f "$sdir/desired.cron" ] || { echo "smoke-test: FAIL (--snapshot did not write desired set for all-comment crontab — grep -v '&& mv' skip-on-empty bug)"; rm -rf "$sdir"; exit 1; }
    sc=$(grep -c . "$sdir/desired.cron" 2>/dev/null || true)
    [ "${sc:-x}" = 0 ] || { echo "smoke-test: FAIL (all-comment crontab should yield 0 reflex lines, got $sc)"; rm -rf "$sdir"; exit 1; }
    rm -rf "$sdir"
    # RECONCILE_PY: a comment-only TWIN collapses to the DESIRED raw line (reconcile-in-place, not a
    # duplicate append — the cron-dup-entries fix); an operator line is preserved; a missing desired
    # reflex is appended. FALSIFIABLE: revert the sigs() comment-strip and the twin no longer collapses
    # (two mesh-x lines survive) → this FAILs.
    rdir="$(mktemp -d)"
    printf '%s\n' \
      '1 * * * * $HOME/.local/bin/mesh-x   # v2 reconciled comment' \
      '23 */4 * * * $HOME/.local/bin/mesh-y   # only-in-desired (missing from live)' \
      '2 * * * * $HOME/.local/bin/mesh-z   # desired pace (faster)' > "$rdir/desired"
    printf '%s\n' \
      '1 * * * * $HOME/.local/bin/mesh-x' \
      '1 * * * * $HOME/.local/bin/mesh-x   # v1 old comment' \
      '9 * * * * $HOME/.local/bin/mesh-z   # live-only slow-down NOT in desired' \
      '5 * * * * /opt/operator-thing --keep' > "$rdir/live"
    HOME="$HOME" python3 -c "$RECONCILE_PY" "$rdir/desired" "$rdir/live" "$rdir/out" > "$rdir/sum" 2>/dev/null
    xn=$(grep -cE '/mesh-x( |$)' "$rdir/out" 2>/dev/null || echo 99)
    [ "$xn" = 1 ] || { echo "smoke-test: FAIL (comment-twin not collapsed — mesh-x appears $xn times, want 1)"; rm -rf "$rdir"; exit 1; }
    grep -qF 'mesh-x   # v2 reconciled comment' "$rdir/out" || { echo "smoke-test: FAIL (twin slot not reconciled to desired raw line)"; rm -rf "$rdir"; exit 1; }
    grep -qF '/opt/operator-thing --keep' "$rdir/out" || { echo "smoke-test: FAIL (operator line dropped — never-drop invariant broken)"; rm -rf "$rdir"; exit 1; }
    grep -qE '/mesh-y( |$)' "$rdir/out" || { echo "smoke-test: FAIL (missing desired reflex not appended)"; rm -rf "$rdir"; exit 1; }
    # REGRESSION GUARD: a SINGLETON live reflex whose schedule diverges from desired must be PRESERVED
    # verbatim (live '9 * * * *'), NOT re-paced to the desired '2 * * * *' — else --apply would silently
    # revert an operator live-only slow-down (the real mesh-chat-sync */55-vs-*/25 case, 2026-06-27).
    grep -qF '9 * * * * $HOME/.local/bin/mesh-z   # live-only slow-down NOT in desired' "$rdir/out" \
      || { echo "smoke-test: FAIL (singleton schedule divergence re-paced — would revert an operator slow-down)"; rm -rf "$rdir"; exit 1; }
    grep -qF '2 * * * * $HOME/.local/bin/mesh-z' "$rdir/out" && { echo "smoke-test: FAIL (desired pace injected over a live singleton)"; rm -rf "$rdir"; exit 1; }
    grep -q '^ADDED=1$' "$rdir/sum" && grep -q '^DEDUPED=1$' "$rdir/sum" && grep -q '^REPLACED=1$' "$rdir/sum" \
      || { echo "smoke-test: FAIL (reconcile summary wrong: $(tr '\n' ' ' < "$rdir/sum"))"; rm -rf "$rdir"; exit 1; }
    rm -rf "$rdir"
    echo "  reconcile ok (twin collapses→reconciled; singleton pace preserved; operator line kept; missing appended)"
    # PAUSED marker durability: a desired reflex whose live line was commented out under a
    # '# PAUSED <slug> <date>' marker must NOT be re-added by the reconcile — else --apply silently
    # RESURRECTS a deliberately paused reflex every cycle (the phaedra mesh-dispatch case,
    # chat-review/compute-node-dispatchers-bypass-the-governor 2026-07-21).
    #
    # THE NO-MARKER CASE FLIPPED 2026-08-19, DELIBERATELY. This leg used to require that a commented
    # cron line WITHOUT a PAUSED marker stay eligible for self-heal, reasoning that "a stray old
    # comment must not suppress a genuine drop". Measured cost of that rule on this node: the
    # operator commented three GPU reflexes out on 2026-07-24 in his own wording
    # (`# GPU-QUIESCE 2026-07-24 operator: <the cron line>`), the */5 self-heal read that as ABSENT,
    # and all three ran for 26 days beside their own commented-out monument — nobody noticed, because
    # a re-add is silent. The old fear was a SILENT over-block; the fix is not to keep under-blocking
    # but to make the block LOUD: mesh-q below must now be WITHHELD **and named in the summary**, so
    # a stray comment costs a line of log every cycle instead of costing a human's decision. (A
    # genuinely stale comment is removed by deleting it; a genuine drop under one is visible in
    # --check as WITHHELD, never as a quiet nothing.)
    pdir="$(mktemp -d)"
    printf '%s\n' \
      '7 * * * * $HOME/.local/bin/mesh-p   # autowired 2026-07-07' \
      '9 * * * * $HOME/.local/bin/mesh-q' > "$pdir/desired"
    printf '%s\n' \
      '# PAUSED test-slug 2026-07-16' \
      '# 7 * * * * $HOME/.local/bin/mesh-p   # autowired 2026-07-07' \
      '' \
      '# 9 * * * * $HOME/.local/bin/mesh-q' \
      '5 * * * * /opt/operator-thing --keep' > "$pdir/live"
    HOME="$HOME" python3 -c "$RECONCILE_PY" "$pdir/desired" "$pdir/live" "$pdir/out" > "$pdir/sum" 2>/dev/null
    grep -qE '^[^#]*[/]mesh-p( |$)' "$pdir/out" && { echo "smoke-test: FAIL (PAUSED reflex resurrected — mesh-p re-added despite live '# PAUSED' marker)"; rm -rf "$pdir"; exit 1; }
    grep -qE '^[^#]*[/]mesh-q( |$)' "$pdir/out" && { echo "smoke-test: FAIL (mesh-q is commented OUT in the live crontab — that is a withdrawal in somebody's own wording and must be WITHHELD, not re-added)"; rm -rf "$pdir"; exit 1; }
    grep -q '^WITHHELD=1$' "$pdir/sum" || { echo "smoke-test: FAIL (a withhold that is not COUNTED is a silent block — the very failure mode the old self-heal rule feared: $(tr '\n' ' ' < "$pdir/sum"))"; rm -rf "$pdir"; exit 1; }
    grep -q '^WITHHELDNAMES=.*mesh-q' "$pdir/sum" || { echo "smoke-test: FAIL (the withheld reflex must be NAMED — a count alone does not tell a human which decision was honoured: $(tr '\n' ' ' < "$pdir/sum"))"; rm -rf "$pdir"; exit 1; }
    grep -qF '# PAUSED test-slug 2026-07-16' "$pdir/out" || { echo "smoke-test: FAIL (PAUSED marker comment dropped — never-drop invariant broken)"; rm -rf "$pdir"; exit 1; }
    grep -q '^PAUSED=1$' "$pdir/sum" || { echo "smoke-test: FAIL (reconcile summary missing PAUSED=1: $(tr '\n' ' ' < "$pdir/sum"))"; rm -rf "$pdir"; exit 1; }
    # sigs --paused: emits ONLY the sig(s) commented out under a PAUSED marker (feeds --check so a
    # paused reflex reads PAUSED, not a chronic false-MISSING alarm).
    # THE GPU-QUIESCE SHAPE, verbatim — the wording that cost 26 days. The cron schedule does NOT
    # start the comment here (a marker phrase precedes it), so a parser that only looks at the first
    # token after "#" sees prose and re-adds the reflex. This fixture is the real crontab line.
    gdir="$(mktemp -d)"
    printf '%s\n' '*/5 * * * * $HOME/.local/bin/mesh-bruno >> $HOME/.mesh/bruno.log 2>&1   # autowired 2026-07-14' > "$gdir/desired"
    printf '%s\n' \
      '# GPU-QUIESCE 2026-07-24 operator: */5 * * * * $HOME/.local/bin/mesh-bruno >> $HOME/.mesh/bruno.log 2>&1   # autowired 2026-07-14' \
      '*/10 * * * * $HOME/.local/bin/mesh-other >> /dev/null 2>&1' > "$gdir/live"
    HOME="$HOME" python3 -c "$RECONCILE_PY" "$gdir/desired" "$gdir/live" "$gdir/out" > "$gdir/sum" 2>/dev/null
    grep -qE '^[^#]*[/]mesh-bruno( |$| )' "$gdir/out" && { echo "smoke-test: FAIL (the operator's own quiesce wording was overruled — a withdrawal is a withdrawal whatever marker precedes the cron line)"; rm -rf "$gdir"; exit 1; }
    grep -q '^WITHHELD=1$' "$gdir/sum" || { echo "smoke-test: FAIL (GPU-QUIESCE line not counted as WITHHELD: $(tr '\n' ' ' < "$gdir/sum"))"; rm -rf "$gdir"; exit 1; }
    # ...and the withhold must be SPECIFIC, not a blanket "any comment stops everything": a genuinely
    # DROPPED reflex with no commented twin at all must still self-heal. Without this the fix could
    # be "never add anything" and every assertion above would still pass.
    printf '%s\n' \
      '*/5 * * * * $HOME/.local/bin/mesh-bruno >> $HOME/.mesh/bruno.log 2>&1   # autowired 2026-07-14' \
      '*/6 * * * * $HOME/.local/bin/mesh-dropped >> /dev/null 2>&1' > "$gdir/desired2"
    HOME="$HOME" python3 -c "$RECONCILE_PY" "$gdir/desired2" "$gdir/live" "$gdir/out2" > "$gdir/sum2" 2>/dev/null
    grep -qE '^[^#]*[/]mesh-dropped( |$)' "$gdir/out2" || { echo "smoke-test: FAIL (a genuinely dropped reflex with NO commented twin must still self-heal — the withhold must be per-signature, not a blanket)"; rm -rf "$gdir"; exit 1; }
    grep -q '^ADDED=1$' "$gdir/sum2" || { echo "smoke-test: FAIL (self-heal count wrong alongside a withhold: $(tr '\n' ' ' < "$gdir/sum2"))"; rm -rf "$gdir"; exit 1; }
    # ...and PROSE must not withhold. A note that merely MENTIONS a tool is not a commented-out cron
    # line; treating it as one would let a board quote or a doc comment silently un-wire a reflex.
    printf '%s\n' \
      '# note: we should probably look at $HOME/.local/bin/mesh-dropped again some day' \
      '*/10 * * * * $HOME/.local/bin/mesh-other >> /dev/null 2>&1' > "$gdir/live3"
    HOME="$HOME" python3 -c "$RECONCILE_PY" "$gdir/desired2" "$gdir/live3" "$gdir/out3" > "$gdir/sum3" 2>/dev/null
    grep -qE '^[^#]*[/]mesh-dropped( |$)' "$gdir/out3" || { echo "smoke-test: FAIL (a PROSE comment mentioning a tool was read as a commented-out cron line — a mention is not a withdrawal)"; rm -rf "$gdir"; exit 1; }
    # sigs --commented must extract the schedule that sits AFTER the marker text, and must stay
    # silent on prose (same two claims, at the other call site that --check reads).
    printf '%s\n' "$(sigs --commented < "$gdir/live")" | grep -q 'mesh-bruno' \
      || { echo "smoke-test: FAIL (sigs --commented missed a cron line preceded by marker text)"; rm -rf "$gdir"; exit 1; }
    printf '%s\n' "$(sigs --commented < "$gdir/live3")" | grep -q 'mesh-dropped' \
      && { echo "smoke-test: FAIL (sigs --commented turned prose into a withdrawal)"; rm -rf "$gdir"; exit 1; }
    rm -rf "$gdir"
    echo "  withhold ok (operator wording honoured; genuine drop still heals; prose is not a withdrawal)"
    pp="$(sigs --paused < "$pdir/live")"
    printf '%s\n' "$pp" | grep -q 'mesh-p' || { echo "smoke-test: FAIL (sigs --paused did not extract the paused mesh-p sig)"; rm -rf "$pdir"; exit 1; }
    printf '%s\n' "$pp" | grep -q 'mesh-q' && { echo "smoke-test: FAIL (sigs --paused over-matched — mesh-q comment has no PAUSED marker)"; rm -rf "$pdir"; exit 1; }
    # --check on a paused reflex: exit 0 + a PAUSED line, never MISSING. Sandboxed shadow crontab.
    printf '#!/bin/sh\ncat "%s/live"\n' "$pdir" > "$pdir/crontab"; chmod +x "$pdir/crontab"
    printf '%s\n' '7 * * * * $HOME/.local/bin/mesh-p   # autowired 2026-07-07' > "$pdir/desired1"
    chk="$(MESH_REFLEXES="$pdir/desired1" PATH="$pdir:$PATH" bash "$0" --check 2>&1)"; chkrc=$?
    [ "$chkrc" = 0 ] || { echo "smoke-test: FAIL (--check exit $chkrc on a paused-only reflex — chronic false-MISSING alarm)"; rm -rf "$pdir"; exit 1; }
    printf '%s\n' "$chk" | grep -q 'PAUSED' || { echo "smoke-test: FAIL (--check did not report the paused reflex as PAUSED: $chk)"; rm -rf "$pdir"; exit 1; }
    rm -rf "$pdir"
    echo "  paused ok (PAUSED-marked reflex not resurrected; an unmarked commented-out line is WITHHELD and NAMED; --check reads PAUSED not MISSING)"
    echo "smoke-test: ok"; exit 0 ;;

  --snapshot)
    mkdir -p "$HOME/.mesh"
    # grep -v exits 1 when it selects ZERO lines (an all-comment / empty crontab → empty desired
    # set — exactly the reflexes-paused-for-reorg state). Under pipefail that skips a gated `&& mv`,
    # leaving DESIRED STALE (+ a stray .tmp) so --check then false-reports removed reflexes as
    # MISSING. Do NOT gate the mv on the pipeline's exit. (Same skip-on-empty lesson as mesh-feed:94.)
    crontab -l 2>/dev/null | grep -vE '^[[:space:]]*$|^[[:space:]]*#' > "$DESIRED.tmp"; mv "$DESIRED.tmp" "$DESIRED"
    echo "mesh-reflexes: snapshot -> $DESIRED ($(grep -c . "$DESIRED") reflex line(s))" ;;

  --check)
    [ -r "$DESIRED" ] || { echo "mesh-reflexes: no desired set at $DESIRED (run --snapshot)"; exit 0; }
    raw="$(crontab -l 2>/dev/null)"
    live="$(printf '%s\n' "$raw" | sigs)"
    pausedl="$(printf '%s\n' "$raw" | sigs --paused)"
    commentedl="$(printf '%s\n' "$raw" | sigs --commented)"
    miss=0; wh=0; rescount=0
    while IFS= read -r want; do
      [ -n "$want" ] || continue
      if printf '%s\n' "$live" | grep -qxF "$want"; then
        # LIVE — but is there also a commented-out twin saying somebody withdrew it? That is a
        # RESURRECTION: the reflex is running beside its own withdrawal. Name it; the reconciler
        # can only stop the NEXT one, it cannot un-run the 26 days already spent.
        printf '%s\n' "$commentedl" | grep -qxF "$want" \
          && { echo "RESURRECTED: $want (running AND commented out in the same crontab)"; rescount=$((rescount+1)); }
        continue
      fi
      # deliberately paused ('# PAUSED' marker over the commented line) → not a drop, don't alarm
      printf '%s\n' "$pausedl" | grep -qxF "$want" && { echo "PAUSED: $want"; continue; }
      # commented out under ANY other wording → WITHHELD, also not a drop
      printf '%s\n' "$commentedl" | grep -qxF "$want" && { echo "WITHHELD: $want"; wh=$((wh+1)); continue; }
      echo "MISSING: $want"; miss=$((miss+1))
    done < <(sigs < "$DESIRED")
    [ "$rescount" -gt 0 ] && echo "mesh-reflexes: $rescount reflex(es) RESURRECTED over a commented-out withdrawal — the desired set still asserts them; remove them from $DESIRED to make the withdrawal stick"
    [ "$wh" -gt 0 ] && echo "mesh-reflexes: $wh reflex(es) WITHHELD (commented out in the live crontab, not re-added)"
    if [ "$miss" -eq 0 ]; then echo "mesh-reflexes: all desired reflexes present"; exit 0
    else echo "mesh-reflexes: $miss reflex(es) MISSING from live crontab"; exit 1; fi ;;

  --apply)
    [ -r "$DESIRED" ] || { echo "mesh-reflexes: no desired set at $DESIRED (run --snapshot first)" >&2; exit 0; }
    mkdir -p "$HOME/.mesh"
    exec 9>"$LOCK"
    flock -w 15 9 || { echo "mesh-reflexes: could not lock (another apply running)" >&2; exit 0; }
    # Torn-read guard (mesh-doctor-torn-read class): `crontab -l` can return a PARTIAL view of the
    # spool while a concurrent crontab write is mid-replace (our own */5 flocked --apply via
    # mesh-restore, or the cron daemon reloading). A partial view comes in three shapes — EMPTY,
    # DOUBLED, or (the one the old single-re-read MISSED) MISSING-ONE-LINE. Acting on a missing-line
    # read makes --apply think a present reflex was dropped → it ADDs it → a transient duplicate that
    # flaps each cycle (the mesh-body-state churn, [fyi] 13:41). The old guard only caught empty/
    # doubled. FIX: require a STABLE read — two consecutive identical non-empty reads — which catches
    # ALL three torn shapes without having to know what's "missing". If the crontab won't settle in a
    # few tries, SKIP this cycle (the next */5 --apply retries on a calm read) rather than act on an
    # unstable snapshot — a genuine drop simply heals one cycle later, never lost.
    live_orig="$(crontab -l 2>/dev/null)"
    _stable=0
    for _try in 1 2 3; do
      sleep 1
      _live2="$(crontab -l 2>/dev/null)"
      if [ -n "$_live2" ] && [ "$_live2" = "$live_orig" ]; then _stable=1; break; fi
      live_orig="$_live2"
    done
    if [ "$_stable" -ne 1 ]; then
      echo "mesh-reflexes: crontab read unstable (concurrent write) — skipping this cycle, next --apply retries" >&2
      rm -f "$LOCK.add" 2>/dev/null; exit 0
    fi
    # Reconcile (RECONCILE_PY): add MISSING, REPLACE a cadence/comment-reconciled slot in place, and
    # COLLAPSE same-sig twins — instead of the old blind add-only append that minted the comment-only
    # duplicate twins (cron-dup-entries). Operator/non-desired lines are preserved untouched.
    printf '%s\n' "$live_orig" > "$LOCK.live"
    summary="$(python3 -c "$RECONCILE_PY" "$DESIRED" "$LOCK.live" "$LOCK.new" 2>/dev/null)"
    added=$(printf '%s\n' "$summary"   | sed -n 's/^ADDED=//p')
    replaced=$(printf '%s\n' "$summary"| sed -n 's/^REPLACED=//p')
    deduped=$(printf '%s\n' "$summary" | sed -n 's/^DEDUPED=//p')
    changed=$(printf '%s\n' "$summary" | sed -n 's/^CHANGED=//p')
    addnames=$(printf '%s\n' "$summary"| sed -n 's/^ADDNAMES=//p')
    addsigs=$(printf '%s\n' "$summary" | sed -n 's/^ADDSIGS=//p')
    withheld=$(printf '%s\n' "$summary" | sed -n 's/^WITHHELD=//p')
    whnames=$(printf '%s\n' "$summary" | sed -n 's/^WITHHELDNAMES=//p')
    whsigs=$(printf '%s\n' "$summary"  | sed -n 's/^WITHHELDSIGS=//p')
    # A WITHHOLD is the one outcome that must never be silent: it is the mesh declining to undo a
    # human. Say it every cycle in the log, and post ONCE per distinct set (its own sentinel, so it
    # does not alternate-thrash with heal_post's).
    if [ "${withheld:-0}" -gt 0 ]; then
      echo "mesh-reflexes: WITHHELD ${withheld} reflex(es) — commented out in the live crontab, NOT re-added: ${whnames:-?}"
      withheld_post "[fyi] mesh-reflexes: withheld ${withheld} reflex(es) from self-heal — commented out in the live crontab (a withdrawal, whatever its wording): ${whnames:-?}. To un-wire for good, delete them from ${DESIRED}; to run them again, uncomment the crontab line." \
        "withheld:${withheld}:${whsigs}"
    fi
    if [ "${changed:-0}" = 1 ] && [ -s "$LOCK.new" ]; then
      crontab - < "$LOCK.new"                      # never install an EMPTY crontab (the -s guard)
      if [ "${added:-0}" -gt 0 ]; then
        echo "mesh-reflexes: re-installed ${added} missing reflex(es)${addnames:+: $addnames}${replaced:+; reconciled $replaced}${deduped:+; deduped $deduped}"
        # A genuinely MISSING reflex matters → board post (named + sig-deduped, chat-review 2026-06-19).
        heal_post "[done] mesh-reflexes: self-healed ${added} dropped cron reflex(es): ${addnames:-?}" \
          "heal:${added}:${addsigs}"
      else
        # Reconcile-in-place / twin-collapse is routine self-maintenance (--apply runs */5) — log it,
        # do NOT post to the board (same de-noise rationale as the old exact-dup branch, chat-review
        # 2026-06-19). Once a comment/cadence edit reconciles, the sig matches and this goes no-op.
        echo "mesh-reflexes: reconciled ${replaced:-0} + deduped ${deduped:-0} cron line(s) (routine, board-silent)"
      fi
    else
      echo "mesh-reflexes: all desired reflexes present, no duplicates (no-op)"
    fi
    rm -f "$LOCK.add" "$LOCK.live" "$LOCK.new" ;;

  *) echo "usage: mesh-reflexes --snapshot|--apply|--check|--test" >&2; exit 1 ;;
esac
