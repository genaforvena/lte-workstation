#!/usr/bin/env bash
# mesh-land — the steward's review-and-land of STRANDED stream work, toolified + made visible.
#
# The mesh's design centralises genome commits in the STEWARD (workers post [done] to the board but
# don't commit — that avoids multi-mind git-push races). The gap is reliability: if a steward tick
# misses the landing, stream fixes strand uncommitted → no durability, no propagation to other nodes
# → the recurring deploy-drift (6 fixes stranded 2 ticks, 2026-06-12). mesh-land closes that loop
# WITHOUT distributing commits: it finds SETTLED (stable-mtime, not actively-edited) + parse-clean
# uncommitted scripts/ edits, and either alerts (so a tick never misses them) or lands them in one
# attributed commit. The steward still eyeballs `git diff` before --apply — parse-clean ≠ correct.
#
#   mesh-land            list settled+clean candidates (dry-run, default) — review then --apply
#   mesh-land --apply    commit + push + deploy the settled+clean candidates (human-reviewed)
#   mesh-land --autoland UNATTENDED cron path: land only candidates that ALSO pass their own
#                        --test (eyeball-substitute); the rest stay for --apply. Steward-only.
#   mesh-land --check    quiet; exit 1 + board-alert if settled-stranded work exists (for a cron reflex).
#                        Alert is FLOOD-GATED: re-posts only when the strand set changes, else once
#                        per MESH_LAND_REFRESH (1h) — kills the identical-[strand]-every-tick board flood.
#   mesh-land --test     smoke test
#
# Candidates now include BOTH tracked-modified AND untracked new scripts/mesh-* (a brand-new tool
# written but never `git add`ed used to strand invisibly — the recurring "wired but ungenomed" class).
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
REPO="${MESH_REPO:-$HOME/lte-workstation}"
SETTLE="${MESH_LAND_SETTLE:-600}"   # mtime must be older than this (settled = not in-flight)
STRAND_TTL="${MESH_LAND_TTL:-7200}" # escalate nagging strands >TTL seconds to [task] (default 2h)
STRAND_STATE="${MESH_DIR:-$HOME/.mesh}/.mesh-land-strands"
POSTED_STATE="${MESH_DIR:-$HOME/.mesh}/.mesh-land-posted" # last-posted strand signature + epoch (board-flood gate)
REFRESH="${MESH_LAND_REFRESH:-3600}"  # re-post an UNCHANGED strand set at most this often (default 1h reminder)
# SUBSTRATE EXCLUSION (chat-review/autoland-substrate-guard 2026-06-20): the tools that manage the
# LIVE substrate (cron/routing/egress/ssh + mesh-land itself) are NEVER auto-landed. A green --test
# is only an "eyeball substitute" — when it doesn't cover the CHANGED path a regression auto-ships to
# the highest-blast-radius layer. PROVEN: a mesh-reflexes torn-read fix passed --test/--check yet
# disabled mesh-wide reflex self-heal, and was ~minutes from autoland committing+deploying it to the
# LIVE crontab manager (settled+parse-clean+--test-green). These ALWAYS fall to a human `mesh-land
# --apply` (still alerted as a strand by the --check reflex). Overridable per node via env.
SUBSTRATE_TOOLS="${MESH_LAND_SUBSTRATE:-mesh-reflexes mesh-restore mesh-fix-egress mesh-dms mesh-harden-ssh mesh-revert-catch mesh-land mesh-genome-sync}"

# docs/ (prose, not code) need no parse/test/deploy — only the settle gate. is_doc routes a docs/
# candidate through a LAND-ONLY path (commit+push, no ~/.local/bin deploy) so doc-drift task output
# — which workers are told to leave for the steward, but which is NOT a scripts/ tool — stops
# stranding forever. (gap 2026-06-19: autoland enumerated scripts/ only → docs/ blocked genome pulls.)
is_doc(){ case "$1" in docs/*) return 0 ;; *) return 1 ;; esac; }
# is_substrate: a candidate that manages the live substrate — excluded from --autoland (see above).
is_substrate(){ local b; b="$(basename "$1")"; case " $SUBSTRATE_TOOLS " in *" $b "*) return 0 ;; *) return 1 ;; esac; }

[ "${1:-}" = --test ] && {
  command -v git >/dev/null 2>&1 || { echo "smoke-test: FAIL (no git)"; exit 1; }
  [ -d "$REPO/.git" ] || { echo "smoke-test: FAIL (no repo at $REPO)"; exit 1; }
  command -v python3 >/dev/null 2>&1 || { echo "smoke-test: FAIL (no python3)"; exit 1; }
  is_doc "docs/x.md" && ! is_doc "scripts/mesh-x" && ! is_doc "x.md" \
    || { echo "smoke-test: FAIL (is_doc routing)"; exit 1; }
  # substrate exclusion: the proven-dangerous cron/routing managers must classify as substrate
  # (held from --autoland), an ordinary stream tool must NOT.
  is_substrate "scripts/mesh-reflexes" && is_substrate "scripts/mesh-restore" \
    && is_substrate "scripts/mesh-fix-egress" && is_substrate "scripts/mesh-land" \
    && ! is_substrate "scripts/mesh-presence" && ! is_substrate "scripts/mesh-light" \
    || { echo "smoke-test: FAIL (is_substrate routing)"; exit 1; }
  echo "smoke-test: ok"; exit 0; }

cd "$REPO" 2>/dev/null || { echo "mesh-land: no repo $REPO" >&2; exit 1; }
now=$(date +%s)

parse_ok(){ is_doc "$1" && return 0   # docs: prose, nothing to parse
  case "$(head -1 "$1" 2>/dev/null)" in
  *python*) python3 -m py_compile "$1" 2>/dev/null ;;
  *)        bash -n "$1" 2>/dev/null ;;
esac; }

# --test correctness gate for the AUTOMATED landing path (--autoland). parse-clean ≠ correct
# (the design's eyeball caveat), so for unattended landing we additionally require the tool's
# own --test to pass: exit 0 (ok) or 2 (honest n/a — e.g. phone/TV unreachable on this node).
# A tool with no --test, or one that FAILS/errors, is NOT auto-landed — it falls to manual
# `mesh-land --apply` (still alerted).
# MUST test the CANDIDATE ($1, the uncommitted scripts/ edit about to be committed+deployed), NOT
# the deployed ~/.local/bin copy. The deployed copy is the STALE pre-edit version, so a new edit that
# BREAKS its own --test would PASS this gate on the old copy and autoland anyway — the exact hollow-
# gate bug that landed mesh-queue-tend with a failing --test (set-u crash) at the */15 minute-33
# autoland slot, 2026-06-20. A landing gate must verify the artifact it is about to LAND.
test_ok(){
  local bin="$1"   # the candidate being landed — never the deployed copy (see above)
  grep -q -- '--test' "$bin" 2>/dev/null || return 1   # no --test handler → can't auto-verify
  timeout 30 bash "$bin" --test >/dev/null 2>&1; local rc=$?
  [ "$rc" = 0 ] || [ "$rc" = 2 ]
}

# Candidates = uncommitted scripts/ work, BOTH tracked-modified (git diff HEAD) AND untracked
# new tools (git ls-files --others). A mind that writes a brand-new scripts/mesh-* but never
# `git add`s it used to strand invisibly (the "wired but ungenomed" class); now it's caught the
# same as a modified file, with the same settled + parse-clean gate.
cands=(); fresh=(); broken=()
while IFS= read -r f; do
  [ -n "$f" ] && [ -f "$f" ] || continue
  age=$(( now - $(stat -c %Y "$f" 2>/dev/null || echo "$now") ))
  if [ "$age" -lt "$SETTLE" ]; then fresh+=("$(basename "$f")"); continue; fi   # in-flight: leave it
  parse_ok "$f" || { broken+=("$(basename "$f")"); continue; }                  # never land a parse error
  cands+=("$f")
done < <( { git diff --name-only HEAD -- scripts/ docs/; git ls-files --others --exclude-standard -- scripts/; } 2>/dev/null | sort -u)
# NOTE: docs/ joins the TRACKED-modified set only (git diff), NOT git ls-files --others — a brand-new
# untracked doc is more likely an in-progress draft than settled work, so only EDITS to existing docs
# auto-land. New docs land via explicit 'mesh-land --apply' or a mind's own commit.

mode="${1:-}"

# --autoland: the UNATTENDED cadence path (cron). Land only candidates that ALSO pass their own
# --test (the eyeball-substitute); everything else stays for manual --apply. This converts the
# recurring strand from "planner hand-lands each tick" to "auto-lands within the cadence" while
# never auto-committing unverified work. Safe to cadence because mesh-land runs on the STEWARD
# only (single git writer — no multi-node push race), and the SETTLE gate already excludes
# in-flight edits. Implemented by filtering cands→tested, alerting the rest, then falling through
# to the --apply path.
if [ "$mode" = --autoland ]; then
  tested=(); held=()
  for f in "${cands[@]}"; do
    if is_substrate "$f"; then held+=("$(basename "$f")"); continue   # substrate: human --apply only, never auto
    elif is_doc "$f"; then tested+=("$f")      # docs: no --test exists; settle+tracked is the gate
    else test_ok "$f" && tested+=("$f"); fi
  done
  # Substrate candidates left uncommitted are surfaced by the --check reflex as a strand (manual
  # review path) — no separate alert here (keeps strand-alerting in ONE place, no double-post).
  [ "${#held[@]}" -gt 0 ] && echo "mesh-land: substrate held for manual --apply (not auto-landed): ${held[*]}" >&2
  # Land ONLY the --test-passing set, silently. Whatever stays uncommitted (no/failing --test)
  # is left for the sibling `mesh-land --check` reflex to alert + TTL-escalate — so alerting
  # lives in ONE place (no double [strand] posts) and this path is pure action.
  cands=("${tested[@]+"${tested[@]}"}")
  mode=--apply   # fall through to the commit+push+deploy path with the test-gated set
fi

if [ "$mode" = --check ]; then
  # TTL-aware strand nagging: track first-seen per file, escalate old strands to [task].
  mkdir -p "$(dirname "$STRAND_STATE")"
  touch "$STRAND_STATE"
  # clean state file: drop entries for files no longer in diff
  tmp_state="$(mktemp)"; trap 'rm -f "$tmp_state"' EXIT
  active_files="$(printf '%s\n' "${cands[@]##*/}" | sort -u)"
  while IFS='|' read -r k ts; do
    printf '%s\n' "$active_files" | grep -qxF "$k" 2>/dev/null && printf '%s|%s\n' "$k" "$ts" >> "$tmp_state"
  done < "$STRAND_STATE"
  mv -f "$tmp_state" "$STRAND_STATE"
  # categorise strands by age; first-seen defaults to now for new ones
  nag=(); task=(); dropped=()
  for f in "${cands[@]}"; do
    bn="$(basename "$f")"
    first=$(grep "^${bn}|" "$STRAND_STATE" 2>/dev/null | cut -d'|' -f2)
    if [ -z "$first" ]; then first="$now"; printf '%s|%s\n' "$bn" "$now" >> "$STRAND_STATE"; fi
    age=$(( now - first ))
    if   [ "$age" -ge $(( STRAND_TTL * 4 )) ]; then dropped+=("$bn")
    elif [ "$age" -ge "$STRAND_TTL" ];             then task+=("$bn")
    else                                                 nag+=("$bn"); fi
  done
  # BOARD-FLOOD GATE (chat-review 2026-06-17: land [strand] re-posted identical lines every
  # tick → ~30% of the board, drowning real signal). Post ONLY when the strand SET changed
  # (nag+task+dropped file lists) OR the unchanged set is older than REFRESH (a periodic
  # reminder, default 1h). The strands still exist (exit 1) every tick — we just don't re-shout
  # the same line. Signature is the sorted file lists per category; stored as ts\nsig.
  sig="n:$(printf '%s,' "${nag[@]+"${nag[@]}"}")|t:$(printf '%s,' "${task[@]+"${task[@]}"}")|d:$(printf '%s,' "${dropped[@]+"${dropped[@]}"}")"
  last_ts=0; last_sig=""
  [ -f "$POSTED_STATE" ] && { read -r last_ts; read -r last_sig; } < "$POSTED_STATE" 2>/dev/null
  [ -n "$last_ts" ] || last_ts=0; case "$last_ts" in *[!0-9]*) last_ts=0;; esac
  do_post=0
  if [ "$sig" != "$last_sig" ] || [ $(( now - last_ts )) -ge "$REFRESH" ]; then
    do_post=1; printf '%s\n%s\n' "$now" "$sig" > "$POSTED_STATE" 2>/dev/null
  fi
  if [ "$do_post" = 1 ]; then
    [ "${#nag[@]}"    -gt 0 ] && command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="land@$(hostname)" mesh-chat "[strand] ${#nag[@]} settled stream fix(es) uncommitted: $(printf '%s ' "${nag[@]}")— steward: review (git diff) + 'mesh-land --apply'." >/dev/null 2>&1
    [ "${#task[@]}"   -gt 0 ] && command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="land@$(hostname)" mesh-chat "[task] stranded ${#task[@]} fix(es) for $(bc <<< "scale=1; $(( STRAND_TTL / 3600 ))")h+: $(printf '%s ' "${task[@]}")— steward: land or decay (owner: mesh-land)" >/dev/null 2>&1
    [ "${#dropped[@]}" -gt 0 ] && command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="land@$(hostname)" mesh-chat "[escalate] stranded ${#dropped[@]} fix(es) for $(bc <<< "scale=1; $(( STRAND_TTL * 4 / 3600 ))")h+ SILENT-DROPPED: $(printf '%s ' "${dropped[@]}")— operator/steward action needed" >/dev/null 2>&1
  fi
  [ "${#nag[@]}" -gt 0 ] || [ "${#task[@]}" -gt 0 ] || [ "${#dropped[@]}" -gt 0 ] && exit 1
  exit 0
fi

if [ "${#cands[@]}" -eq 0 ]; then
  echo "mesh-land: nothing settled+clean to land"
  [ "${#fresh[@]}"  -gt 0 ] && echo "  in-flight (mtime < ${SETTLE}s, left alone): ${fresh[*]}"
  [ "${#broken[@]}" -gt 0 ] && echo "  PARSE-BROKEN (skipped — fix or revert): ${broken[*]}"
  exit 0
fi

echo "mesh-land: ${#cands[@]} settled+clean candidate(s) to land:"
for f in "${cands[@]}"; do echo "  + $(basename "$f")  ($(git diff --numstat HEAD "$f" | awk '{print "+"$1" -"$2}'))"; done
[ "${#fresh[@]}"  -gt 0 ] && echo "  skipped in-flight: ${fresh[*]}"
[ "${#broken[@]}" -gt 0 ] && echo "  skipped parse-broken: ${broken[*]}"

[ "$mode" = --apply ] || { echo; echo "(dry-run — review with 'git diff HEAD -- scripts/<f>', then: mesh-land --apply)"; exit 0; }

# Ensure shebang scripts are executable in the COMMITTED tree. The atomic-deploy below chmods +x only
# the ~/.local/bin copy — a candidate left 644 ships NON-EXECUTABLE in the genome → doctor "NOT
# EXECUTABLE" FAIL, the recurring exec-bit class (mesh-consume-all/mesh-liveness-loop/mesh-chat-deliver,
# 2026-06-21). chmod the source before `git add` so the committed mode is 755, matching the deploy.
for f in "${cands[@]}"; do
  [ -f "$f" ] && head -1 "$f" 2>/dev/null | grep -q '^#!' && [ ! -x "$f" ] && chmod +x "$f"
done
git add -- "${cands[@]}"
names="$(printf '%s ' "${cands[@]##*/}")"
git commit -q -m "mesh-land: land ${#cands[@]} settled stream fix(es): ${names}

Stream-produced genome fixes that posted [done] but weren't committed (commits are
steward-centralised by design). Settled (stable mtime > ${SETTLE}s), parse-clean,
steward-reviewed. Landed + deployed by mesh-land." || { echo "mesh-land: commit failed"; exit 1; }
git push -q origin main 2>&1 | tail -1
# ATOMIC deploy (.tmp → mv -f): mesh-land deploys mesh-* tools, many cron-wired, into the LIVE bin.
# A bare 'cp' truncate-then-writes in place → a concurrent cron exec can read a half-written file →
# phantom 'unexpected EOF' (the torn-read class, hit 2026-06-13). mv -f is an atomic rename on the
# same fs, so a running process sees either the whole old or whole new inode, never a partial one.
for f in "${cands[@]}"; do
  is_doc "$f" && continue   # land-only: docs are committed+pushed, nothing to deploy to ~/.local/bin
  b="$(basename "$f")"; d="$HOME/.local/bin/$b"
  cp "$f" "$d.tmp.$$" 2>/dev/null && chmod +x "$d.tmp.$$" 2>/dev/null && mv -f "$d.tmp.$$" "$d" 2>/dev/null
done
echo "mesh-land: landed + deployed: ${names}"
command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="land@$(hostname)" mesh-chat "[done] mesh-land: landed ${#cands[@]} settled stream fix(es): ${names}" >/dev/null 2>&1 || true
