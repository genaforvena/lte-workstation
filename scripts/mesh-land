#!/usr/bin/env bash
# reflex-cadence: 3-59/15 * * * *
# reflex-args: --autoland
# mesh-land — the steward's review-and-land of STRANDED stream work, toolified + made visible.
#
# The mesh's design centralises genome commits in the STEWARD (workers post [done] to the board but
# don't commit — that avoids multi-mind git-push races). The gap is reliability: if a steward tick
# misses the landing, stream fixes strand uncommitted → no durability, no propagation to other nodes
# → the recurring deploy-drift (6 fixes stranded 2 ticks, 2026-06-12). mesh-land closes that loop
# WITHOUT distributing commits: it finds SETTLED (stable-mtime, not actively-edited) + parse-clean
# uncommitted scripts/ edits, and either alerts (so a tick never misses them) or lands them in one
# attributed commit. The steward still eyeballs `git diff` before --apply — parse-clean ≠ correct.
#
#   mesh-land            list settled+clean candidates (dry-run, default) — review then --apply
#   mesh-land --apply    commit + push + deploy the settled+clean candidates (human-reviewed)
#   mesh-land --autoland THE CADENCED arm (see the reflex-cadence header — */15 offset-3). The
#                        UNATTENDED cron path: land only candidates that ALSO pass their own --test
#                        (eyeball-substitute); the rest stay for --apply. Steward-only. push-heals
#                        FIRST thing every tick (line below) so it SUBSUMES --push-heal — this one
#                        line both COMMITS settled+test-green work AND pushes a stranded pane commit.
#   mesh-land --check    quiet; exit 1 + board-alert if settled-stranded work exists (for a cron reflex).
#                        Alert is FLOOD-GATED: re-posts only when the strand set changes, else with
#                        exponential backoff (1h→2h→4h→8h cap) — kills the identical-[strand]-every-tick
#                        board flood while keeping long-stale strands visible.
#   mesh-land --push-heal  push-only: if local main is a clean fast-forward ahead of origin/main, push
#                        it. Never commits, never forces. The MANUAL / lean-node arm — on the steward
#                        node --autoland (cadenced) push-heals every tick and subsumes it; kept as a
#                        cheap standalone for a node that holds the repo but must not auto-COMMIT.
#   mesh-land --test     smoke test
#
# Candidates now include BOTH tracked-modified AND untracked new scripts/mesh-* (a brand-new tool
# written but never `git add`ed used to strand invisibly — the recurring "wired but ungenomed" class).
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
REPO="${MESH_REPO:-$HOME/lte-workstation}"
SETTLE="${MESH_LAND_SETTLE:-600}"   # mtime must be older than this (settled = not in-flight)
STRAND_TTL="${MESH_LAND_TTL:-7200}" # escalate nagging strands >TTL seconds to [task] (default 2h)
STRAND_STATE="${MESH_DIR:-$HOME/.mesh}/.mesh-land-strands"
POSTED_STATE="${MESH_DIR:-$HOME/.mesh}/.mesh-land-posted" # last-posted strand signature + epoch + refresh-interval (board-flood gate)
# TASK_POSTED_STATE (chat-review/land-close-tool-vs-task-slug-mismatch 2026-07-04): tool basenames
# CURRENTLY carrying an open board [task] land-strand/<tool> (see the task[] posting below). Tracked
# so the close-out check can tell "was posted, now cleared" (→ post its [done]) from "never posted"
# (→ nothing to close).
TASK_POSTED_STATE="${MESH_DIR:-$HOME/.mesh}/.mesh-land-task-posted"
POSTED_LOCK="${MESH_DIR:-$HOME/.mesh}/.mesh-land-posted.lock" # serializes both the close-out and board-flood-gate critical sections
CHAT_LOG="${MESH_LAND_CHAT_LOG:-${MESH_DIR:-$HOME/.mesh}/chat.log}" # board scrape source for commit-body provenance (cite_for_candidate)
REFRESH="${MESH_LAND_REFRESH:-3600}"  # re-post an UNCHANGED strand set at most this often (default 1h reminder)
MAX_REFRESH="${MESH_LAND_MAX_REFRESH:-28800}"  # backoff cap: double REFRESH each identical re-post, up to this (default 8h)
# SUBSTRATE EXCLUSION (chat-review/autoland-substrate-guard 2026-06-20): the tools that manage the
# LIVE substrate (cron/routing/egress/ssh + mesh-land itself) are NEVER auto-landed. A green --test
# is only an "eyeball substitute" — when it doesn't cover the CHANGED path a regression auto-ships to
# the highest-blast-radius layer. PROVEN: a mesh-reflexes torn-read fix passed --test/--check yet
# disabled mesh-wide reflex self-heal, and was ~minutes from autoland committing+deploying it to the
# LIVE crontab manager (settled+parse-clean+--test-green). These ALWAYS fall to a human `mesh-land
# --apply` (still alerted as a strand by the --check reflex). Overridable per node via env.
SUBSTRATE_TOOLS="${MESH_LAND_SUBSTRATE:-mesh-reflexes mesh-restore mesh-fix-egress mesh-dms mesh-harden-ssh mesh-revert-catch mesh-land mesh-genome-sync}"

# docs/ (prose, not code) need no parse/test/deploy — only the settle gate. is_doc routes a docs/
# candidate through a LAND-ONLY path (commit+push, no ~/.local/bin deploy) so doc-drift task output
# — which workers are told to leave for the steward, but which is NOT a scripts/ tool — stops
# stranding forever. (gap 2026-06-19: autoland enumerated scripts/ only → docs/ blocked genome pulls.)
# is_doc: prose (not code) → LAND-ONLY path (commit+push, NO ~/.local/bin deploy). docs/ subtree,
# AND any *.md (root-level doctrine like CLAUDE.md/AGENTS.md/README.md used to strand uncommitted —
# mesh-land only enumerated scripts/+docs/, so a root CLAUDE.md edit silently rotted; now it lands).
# ALSO systemd unit/data files (chat-review/land-parse-broken-unit-files 2026-07-04): a .service's
# `Description=...(...)` line trips `bash -n`'s "syntax error near '('" — parse_ok wrongly bash-parsed
# it, so it never settles+lands (PARSE-BROKEN forever, e.g. mesh-phaedra-port80-fallback.service).
# mesh-sync-tools hit + fixed this exact bug class for its own drift-parse (mesh-liveness-loop.service,
# 2026-06-21) — mirror its extension set here. These aren't scripts: no parse, no --test, no
# ~/.local/bin deploy (systemd units install to a specific node's /etc/systemd/system by hand).
# ALSO uxn-lane artifacts (meta-detectors-blind-to-uxn-lane-idioms 2026-07-24): a *.tal (uxn assembly
# source) and a *.rom (compiled uxn binary) are NEITHER bash NOR python — `bash -n` chokes on `|0100`/
# `DEO2`/binary bytes, so parse_ok wrongly marked them PARSE-BROKEN forever (net-ident.rom/.tal stranded
# every mesh-land run). They are repo-only data (tools read them from $REPO/scripts/uxn/ via `$here/`,
# never deployed), and their correctness is the uxn lane's OWN --test — e.g. mesh-uxn-drift re-assembles
# net-ident.tal with uxnasm and byte-compares against net-ident.rom. So: no bash/python parse, land-only.
# ALSO *.c/*.h (loop-baton 2026-07-24, hyst-gate.c stranded as parse-broken): C sources — uxn ROM
# sources compiled by chibicc (hyst-gate.c/board-check.c/lisp-eval.c → cc-rom.sh) AND host C
# (uxn-packet-gate/nfq-gate.c → cc) — are neither bash nor python; `bash -n` chokes on `//` comments
# and C syntax exactly as it did on `|0100`/`DEO2`. Same class, same fix: route as land-only data,
# their correctness is the compile + the ROM/harness --test (test-hyst-gate, test-packet-gate), never
# bash -n. (There are no bash/python TOOLS with a .c/.h extension in this repo — the exclusion is total.)
# ALSO hledger journals (*.journal) and the uxn gates-as-data / fixture files (loop-baton 2026-07-28,
# accounts.journal + threshold-ledger stranded PARSE-BROKEN). Same class again: an hledger `.journal`
# (accounts.journal — `;`-comments, `account`/posting lines) and the extensionless uxn gate specs +
# fixtures (`scripts/uxn/threshold-ledger` gates-as-data table, `*-fixtures`/`*-goals`/`*-sources`/
# `*-gates`, `.rom.sym` assembler symbol sidecars) are neither bash nor python — `bash -n` chokes on
# `; comment`/`therm-alarm | max | ...`/binary bytes, so parse_ok marked them PARSE-BROKEN every run.
# They are repo-only DATA (the hledger lane reads accounts.journal; the uxn tools read the gate/fixture
# rows from $REPO/scripts/uxn/), read never deployed, and their correctness is their OWN --test
# (test-threshold-ledger re-derives the rows; mesh-ledger validates the journal). So: land-only, no
# parse. The uxn-data globs are ANCHORED to scripts/uxn/ ON PURPOSE — a bare `*-ledger` would swallow
# the real bash tools scripts/mesh-ledger + scripts/mesh-gpu-ledger (route them as docs → no parse, no
# ~/.local/bin deploy); `*-gates` is plural so it can't hit the singular `mesh-*-gate` tools. `.journal`
# and `.rom.sym` are total exclusions (no bash/python tool carries either), so they stay unanchored.
is_doc(){ case "$1" in docs/*|*.md|*.service|*.timer|*.socket|*.target|*.path|*.mount|*.json|*.txt|*.conf|*.example|*.env|*.tal|*.rom|*.rom.sym|*.c|*.h|*.journal|scripts/uxn/*-fixtures|scripts/uxn/*-ledger|scripts/uxn/*-goals|scripts/uxn/*-sources|scripts/uxn/*-gates) return 0 ;; *) return 1 ;; esac; }
# is_substrate: a candidate that manages the live substrate — excluded from --autoland (see above).
is_substrate(){ local b; b="$(basename "$1")"; case " $SUBSTRATE_TOOLS " in *" $b "*) return 0 ;; *) return 1 ;; esac; }

# push_heal <repo-dir> — get a COMMITTED genome onto origin. This is the mesh's only unattended
# local->origin push, and for 11h on 2026-07-15 it was unreachable: the logic lived INLINE inside
# --autoland, and mesh-land was in no crontab and carried no reflex-cadence header. Minds commit in
# their own panes (CLAUDE.md "every window is data/mind"), so the commits happened — 55 of them —
# and simply never left the node. GitHub's last commit read 07-14 21:48 while local main was 55
# ahead; the operator noticed before any reflex did, because no reflex was looking. Extracted here
# so --push-heal (cadenced below), --autoland, and --apply all drive the SAME code, and so a real
# test can reach it.
#
# NEVER force: origin is public. A DIVERGED origin (a peer pushed) returns 1 and is left for a human
# — force-pushing a public branch to "heal" a strand would destroy the peer's commits. Fast-forward
# only, which is also what makes this safe to run on any node that has the repo: two nodes racing the
# same ff-push means one wins and the other reads "up-to-date", never a lost commit.
# origin_fetch <repo-dir> — fetch origin/main and REPORT WHETHER IT WORKED. Every divergence verdict
# in this file is computed against the CACHED origin/main ref, and that cache is only as fresh as the
# last SUCCESSFUL fetch — so a fetch that failed (egress dip, DNS, the wifi TX wedge) leaves a stale
# ref that reads EXACTLY like a real divergence. Live 2026-08-16 14:33Z, inside the 14:23–14:56Z
# outage in which this node reached NO remote at all (tailscale+anthropic+groq all down per
# access-probe): autoland's `git pull --ff-only` failed because the network was down,
# reconcile_divergence's `git pull --rebase` failed for the SAME reason, and the pair was reported as
# "diverged from origin AND rebase-reconcile CONFLICTED" — a priority:incident strand pulling a
# steward at a phantom, while `git rev-list --left-right --count origin/main...main` was 0 0 and a
# push succeeded first-attempt 20 minutes later (health, 15:12Z). A divergence verdict computed while
# the network is down is a claim about the FETCH, not about origin, and the two are indistinguishable
# downstream — sibling of delivered-was-a-claim-about-curl. So the rc is now CHECKED and an
# unreachable origin renders UNKNOWN (loud, named, no alarm), never "diverged".
# Sets ORIGIN_FETCH_ERR to git's own words; returns git's rc (0 = the cached ref is FRESH).
ORIGIN_FETCH_ERR=""
origin_fetch(){
  local r="$1" rc
  ORIGIN_FETCH_ERR="$(timeout 20 git -C "$r" fetch --quiet origin main 2>&1)"; rc=$?
  ORIGIN_FETCH_ERR="$(printf '%s' "$ORIGIN_FETCH_ERR" | tr '\n' ' ' | cut -c1-200)"
  [ "$rc" = 124 ] && ORIGIN_FETCH_ERR="fetch TIMED OUT after 20s${ORIGIN_FETCH_ERR:+: $ORIGIN_FETCH_ERR}"
  return $rc
}

push_heal(){
  local r="$1" hl ho fresh
  origin_fetch "$r"; fresh=$?
  hl=$(git -C "$r" rev-parse --verify --quiet main 2>/dev/null)
  ho=$(git -C "$r" rev-parse --verify --quiet origin/main 2>/dev/null)
  [ -n "$hl" ] && [ -n "$ho" ] || { echo "$(date -u +%FT%TZ) push-heal: no main/origin/main in $r — nothing to heal"; return 0; }
  [ "$hl" = "$ho" ] && return 0    # in sync — the common case, stays silent so cron logs mean something
  if git -C "$r" merge-base --is-ancestor "$ho" "$hl" 2>/dev/null; then
    # Capture git's OWN stderr: the failure branch used to discard it (2>/dev/null) and log a
    # hardcoded guess, "push FAILED (egress?)". That guess was unfalsifiable and, live on 2026-07-15
    # 17:07+17:22, WRONG — a by-hand `git push` succeeded instantly (rc=0), so egress was never the
    # cause, and the real reason had already been thrown away by the redirect. A diagnosis nobody can
    # check is worse than none: it sends the next reader after the network while the true fault
    # repeats every tick. rc=124 is the ONE case that really is a slow/blocked egress (timeout fired) —
    # it is now claimed only when MEASURED, never assumed.
    local perr prc
    perr="$(timeout 15 git -C "$r" push --quiet origin main 2>&1)"; prc=$?
    if [ "$prc" = 0 ]; then
      echo "$(date -u +%FT%TZ) push-heal: pushed stranded local main ${hl:0:7} -> origin (was ${ho:0:7})"
      return 0
    fi
    perr="$(printf '%s' "$perr" | tr '\n' ' ' | cut -c1-300)"
    if [ "$prc" = 124 ]; then
      echo "$(date -u +%FT%TZ) push-heal: local ${hl:0:7} ahead of origin ${ho:0:7}, push TIMED OUT after 15s (slow egress) — retry next tick"
    else
      echo "$(date -u +%FT%TZ) push-heal: local ${hl:0:7} ahead of origin ${ho:0:7}, push FAILED rc=$prc: ${perr:-(git said nothing)} — retry next tick"
    fi
    return 1
  fi
  # Not a fast-forward — but that is only a claim about ORIGIN if the cached ref is fresh. If the
  # fetch above failed, ${ho} is whatever the last reachable tick left behind and this branch is
  # measuring the outage, not the repo.
  if [ "$fresh" != 0 ]; then
    echo "$(date -u +%FT%TZ) push-heal: cannot reach origin (${ORIGIN_FETCH_ERR:-git said nothing}) — local ${hl:0:7} vs CACHED origin ${ho:0:7}: divergence UNKNOWN, NOT claimed; retry next tick"
    return 1
  fi
  echo "$(date -u +%FT%TZ) push-heal: local ${hl:0:7} DIVERGED from origin ${ho:0:7} (not fast-forward) — manual reconcile, NOT force-pushing public origin"
  return 1
}

# reconcile_divergence: SELF-HEAL a diverged main so a fork can never again silently stall the whole
# output lane. Added 2026-07-29 after a divergence jammed autoland for ~10h (tg): autoland's `git pull
# --ff-only` aborted every 15m with "manual reconcile needed" while genome kept producing (71 files
# piled up uncommitted, 0 commits, mesh "looked dead") — nobody was watching the steward, only the
# operator noticed. A step everything depends on must self-heal or LOUDLY alarm, never fail silent.
# Non-destructive by construction: local's unique commits were never published, so replaying them ONTO
# origin via rebase (rewriting their local-only SHAs) loses nothing; --autostash carries the dirty
# candidate tree across; the subsequent `git push` is then a normal FAST-FORWARD, NEVER a force — the
# public-origin invariant (push_heal above) is preserved. Only a genuine CONTENT conflict (both sides
# edited the same lines — rare on a single-writer steward, since a peer/mirror push usually touches
# other files) falls through to a deduped board [strand] alarm + abort, leaving origin untouched.
reconcile_divergence(){
  local r="$1"
  if git -C "$r" pull --rebase --autostash --quiet origin main 2>/dev/null; then
    echo "$(date -u +%FT%TZ) autoland: diverged from origin — AUTO-RECONCILED by rebase (local replayed onto origin), landing continues"
    return 0
  fi
  git -C "$r" rebase --abort 2>/dev/null || true   # restore pre-rebase state; a half-rebase must never leak
  # `git pull --rebase` fails for TWO unrelated reasons and used to report only one of them: a real
  # content conflict, and simply not reaching the remote. The second is what fired at 14:33Z on
  # 2026-08-16 (see origin_fetch). Ask the network before naming a conflict — an unreachable origin
  # renders UNKNOWN and posts NO strand, because a steward summoned at priority:incident to reconcile
  # a divergence that does not exist learns to ignore the next one that does.
  if ! origin_fetch "$r"; then
    echo "$(date -u +%FT%TZ) autoland: pull --rebase failed but origin is UNREACHABLE (${ORIGIN_FETCH_ERR:-git said nothing}) — divergence/conflict UNKNOWN, NOT claimed, no strand posted; retry next tick"
    return 1
  fi
  echo "$(date -u +%FT%TZ) autoland: diverged from origin AND rebase-reconcile CONFLICTED — manual reconcile needed (origin untouched)"
  # LOUD, deduped (≤1/h) board alarm — the silent-log-and-give-up that hid the 10h stall is exactly
  # what we are replacing. A conflict is a real steward action item, not a benign strand.
  local stamp="${MESH_HOME_DIR:-$HOME/.mesh}/land-reconcile-alarm.stamp" nows age
  nows=$(date +%s)
  if [ -f "$stamp" ]; then age=$(( nows - $(stat -c %Y "$stamp" 2>/dev/null || echo 0) )); [ "$age" -lt 3600 ] && return 1; fi
  command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="land@$(hostname)" mesh-chat \
    "[strand] autoland BLOCKED: local main diverged from origin and auto-rebase CONFLICTED — steward must manually reconcile (git pull --rebase, resolve, git push). Autopoiesis OUTPUT is jammed until then. priority:incident" 2>/dev/null || true
  mkdir -p "$(dirname "$stamp")" 2>/dev/null; : > "$stamp"
  return 1
}

# (--test block relocated just below the helper defs so it can assert autoland_excuse — see there.)

cd "$REPO" 2>/dev/null || { echo "mesh-land: no repo $REPO" >&2; exit 1; }
now=$(date +%s)

parse_ok(){ is_doc "$1" && return 0   # docs: prose, nothing to parse
  case "$(head -1 "$1" 2>/dev/null)" in
  *python*) python3 -m py_compile "$1" 2>/dev/null ;;
  *)        bash -n "$1" 2>/dev/null ;;
esac; }

# UNTRACKED_DOC_PATHS: which NEW (untracked) doc paths join the candidate set. `git diff` only ever
# sees docs that are ALREADY tracked, so a brand-new .md needs an explicit `ls-files --others` glob or
# it has no landing cadence AT ALL — --autoland is the only cadenced arm, --apply is manual.
# Measured 2026-07-29: docs/reviews/ held ONE tracked file (dragon-king-precursor-2026-07-06) against
# 83 untracked docs, the oldest 5 days old, while the live-lit review lane was landing ~9 artifacts an
# afternoon and citing each one as the artifact of its [done]. Those cites resolved to nothing in the
# genome — disk-only, invisible to every peer, decaying on reboot. Same family as 1969a5d "the push
# that only happens when something else does": a product whose only landing path is a manual verb has
# no cadence, so it strands until a human notices.
# SCOPED, not blanket: docs/reviews/ is a write-once dated-artifact convention (a review doc is written
# at the END of a review and never touched again), so SETTLE is a true settled signal there. The
# genuine in-progress files the old comment worried about — docs/*-draft.md, docs/superpowers/plans/ —
# are deliberately NOT in this list and still land only via explicit `mesh-land --apply` or a mind's
# own commit.
# 2026-08-15 (loop-baton, genome): the 2026-07-29 fix was made for the REVIEW lane only, and the STUDY
# lane — the other write-once dated-artifact convention, `docs/study-<date>-<slug>.md` — was left with
# the identical defect. Measured this node: 3 untracked study docs on disk (hours old) against 5
# tracked, and ALL FIVE tracked ones entered the genome through a mind's own manual `git commit`
# (29b6d79/263dd4b/d24e8fc×2/29db7fe) — never once through mesh-land. So the lane had no cadence at
# all, while each study's own header cited the scripts/ code that mesh-land HAD landed minutes before:
# the code committed, the document explaining it stranded. Same convention as docs/reviews/ (written at
# the END of a study, never touched again → SETTLE is a true settled signal), so it gets the same arm.
# The glob is ANCHORED to the dated `study-` prefix on purpose: it cannot swallow a docs/*-draft.md.
UNTRACKED_DOC_PATHS=(docs/reviews/ 'docs/study-*.md')

# enumerate_cand_paths <repo> → repo-relative candidate paths, BEFORE the settle/parse gates.
# A function (not an inline pipeline) so the smoke-test can drive it against a real throwaway repo —
# source text is never behaviour, and a grep for these globs would prove only that they are typed.
#
# TRACKED_CAND_GLOBS mirrors is_doc's land-only arm for ROOT-LEVEL data/templates. is_doc has carried
# `*.example`/`*.json`/`*.conf`/`*.env`/`*.txt` for months, but the enumerator only ever OFFERED
# scripts/ + docs/ + '*.md' — so at the repo root those arms were unreachable and the file could never
# become a candidate however long it sat. Live instance (2026-08-15): `mesh-tell`'s MESH_TELL_WAL_LEVEL
# knob landed as code at fac079e while the ONLY place it is documented — the `nodes.example` template a
# node operator actually reads — stayed dirty in the tree with mesh-land reporting "nothing settled+clean
# to land". A safety knob whose documentation cannot land is a knob named nowhere the reader looks.
# SAFE BY CONSTRUCTION: every glob here is one is_doc already routes LAND-ONLY (commit+push, no
# ~/.local/bin deploy, no bash -n), so a template can never be mistaken for a tool. Deliberately NOT a
# blanket root sweep: an unmatched root file (.gitignore, a lockfile) would fall to the CODE path and
# `bash -n` would mark it PARSE-BROKEN forever — the trap this file has now hit five times (.service,
# .tal/.rom, .c/.h, .journal, uxn gates-as-data).
TRACKED_CAND_GLOBS=('*.md' '*.example' '*.json' '*.conf' '*.env' '*.txt')
enumerate_cand_paths(){
  local r="$1"
  { git -C "$r" diff --name-only HEAD -- scripts/ docs/ "${TRACKED_CAND_GLOBS[@]}"
    git -C "$r" ls-files --others --exclude-standard -- scripts/ "${UNTRACKED_DOC_PATHS[@]}"
  } 2>/dev/null | sort -u
}

# --test correctness gate for the AUTOMATED landing path (--autoland). parse-clean ≠ correct
# (the design's eyeball caveat), so for unattended landing we additionally require the tool's
# own --test to pass: exit 0 (ok) or 2 (honest n/a — e.g. phone/TV unreachable on this node).
# A tool with no --test, or one that FAILS/errors, is NOT auto-landed — it falls to manual
# `mesh-land --apply` (still alerted).
# MUST test the CANDIDATE ($1, the uncommitted scripts/ edit about to be committed+deployed), NOT
# the deployed ~/.local/bin copy. The deployed copy is the STALE pre-edit version, so a new edit that
# BREAKS its own --test would PASS this gate on the old copy and autoland anyway — the exact hollow-
# gate bug that landed mesh-queue-tend with a failing --test (set-u crash) at the */15 minute-33
# autoland slot, 2026-06-20. A landing gate must verify the artifact it is about to LAND.
# A TIMEOUT IS NOT A REFUSAL — it names a STATE, not a verdict (2026-08-19). rc=124 means the budget
# ran out with the tool's OWN verdict still unknown; folding it into the boolean below reported every
# slow-but-green tool as '--test failing' — a false accusation against a tool that passes. Live case:
# scripts/mesh-dash --test exits 0 in 47.4s (measured), so under this gate it exits 124 and the steward
# was told its test FAILS. That fix named the state correctly and left the DISPOSITION alone — which
# turned out to be the whole bug, one layer down.
#
# A BUDGET BELOW THE SUITE IS A PERMANENT HOLD, NOT A HOLD (2026-08-19, second pass). 30s was never a
# verdict either: scripts/mesh-dash --test exits 0 (GREEN) in 40.6s at HEAD and 51.8s under load on
# mesh-home, so the mesh's most-edited tool could NEVER be verified inside the budget and therefore
# could never auto-land — not once, in any run, ever. Not a stall a steward clears: a structural
# exclusion that re-arms itself the moment the next edit lands, and the strand it emits reads as
# transient ('verdict unknown') when it is permanent. It cost a whole NODE: phaedra's autoland sat
# rebase-CONFLICTED on scripts/mesh-dash for 19.5h (2026-08-18T10:38Z→2026-08-19T06:07Z) because the
# fix that would unjam it lived in the one file this gate could not verify, and every unattended path
# that could have landed it was held. A budget must exceed the suite it is budgeting, or it is not
# measuring the tool — it is measuring itself.
#
# So the budget is per-CANDIDATE (LAND_TEST_TIMEOUT) and the RUN gets its own elapsed POOL
# (LAND_TEST_POOL). Raising the per-candidate figure alone would let N slow candidates run past the
# 15-min autoland cadence and overlap the next tick; the pool bounds the whole run at
# POOL + one grant regardless of how many candidates a run holds. The pool is charged ELAPSED, never
# the granted budget — charging the grant would bill a 2s green tool for 180s and starve a run of
# fast candidates for no reason ([[a-timeout-cap-is-a-hang-backstop-not-a-latency-budget]]).
# A candidate that finds the pool spent is NOT judged: it gets its own state (4), its own reason, and
# the next tick — 15 min later with a fresh pool — verifies it. Never silently landed, never
# called red.
# Returns: 0 = pass (or honest n/a) · 3 = timed out, verdict UNKNOWN · 4 = run's pool spent, UNRUN
#          · 1 = failed / no --test handler.
# (A tool that itself exits 124 is indistinguishable from the kill — that is timeout(1)'s contract.)
LAND_TEST_TIMEOUT="${MESH_LAND_TEST_TIMEOUT:-180}"   # per candidate; must EXCEED the heaviest suite
LAND_TEST_POOL="${MESH_LAND_TEST_POOL:-600}"         # per RUN, elapsed — bounds a slow/hung candidate set
LAND_TEST_FLOOR="${MESH_LAND_TEST_FLOOR:-30}"        # a grant below this is not worth spending → state 4
LAND_TEST_GRANT=0                                    # the budget the LAST test_ok actually granted
# THE POOL LIVES IN A FILE BECAUSE ITS ONLY READER IS A SUBSHELL. Both production call sites spell it
# `$(autoland_excuse "$f")` — a command substitution, i.e. a forked subshell — so a plain shell variable
# incremented inside test_ok is discarded the instant the substitution closes, and every candidate would
# see a pristine pool. Accounting that cannot outlive the frame it is computed in is not accounting; the
# bound would have read as enforced while nothing was ever charged. $$ is the SCRIPT's pid in every such
# subshell (BASHPID is the one that differs), so it names the RUN, which is exactly the scope the pool is
# for. Reset unconditionally at load — a recycled pid must never inherit a dead run's spend — and sweep
# day-old siblings, since the traps in this file are per-function and clobber each other, so a global
# EXIT trap here would be a promise the next `trap … EXIT` silently breaks.
LAND_POOL_FILE="${TMPDIR:-/tmp}/.mesh-land-pool.$$"
_pool_spent(){ local v; v="$(cat "$LAND_POOL_FILE" 2>/dev/null)"; case "$v" in ''|*[!0-9]*) v=0 ;; esac; printf '%s' "$v"; }
_pool_charge(){ printf '%s' "$(( $(_pool_spent) + ${1:-0} ))" > "$LAND_POOL_FILE" 2>/dev/null || true; }
_pool_reset(){ printf 0 > "$LAND_POOL_FILE" 2>/dev/null || true
  find "${TMPDIR:-/tmp}" -maxdepth 1 -name '.mesh-land-pool.*' -mtime +1 -delete 2>/dev/null || true; }
_pool_reset
test_ok(){
  local bin="$1"   # the candidate being landed — never the deployed copy (see above)
  grep -q -- '--test' "$bin" 2>/dev/null || return 1   # no --test handler → can't auto-verify
  local grant=$(( LAND_TEST_POOL - $(_pool_spent) ))
  [ "$grant" -gt "$LAND_TEST_TIMEOUT" ] && grant="$LAND_TEST_TIMEOUT"
  LAND_TEST_GRANT="$grant"
  [ "$grant" -ge "$LAND_TEST_FLOOR" ] || return 4     # pool spent — UNRUN, not a verdict
  local _t0="$SECONDS" rc
  timeout "$grant" bash "$bin" --test >/dev/null 2>&1; rc=$?
  _pool_charge "$(( SECONDS - _t0 ))"
  case "$rc" in
    0|2) return 0 ;;   # ok / honest n/a (organ absent on this node)
    124) return 3 ;;   # budget exceeded — UNKNOWN, not red
    *)   return 1 ;;
  esac
}

# autoland_excuse: echo "" if --autoland WILL land this settled candidate (a doc, or a non-substrate
# tool whose own --test passes), else echo the steward-required REASON it is HELD for manual --apply
# ('substrate' / 'no --test' / '--test failing' / '--test timed out at <N>s — verdict unknown'). --autoland and --check share this so the set --check
# routes to the trace as "auto-lands in ≤3m" is EXACTLY the set --autoland commits 3m later — no drift
# (chat-review/strand-autoland-eligibility 2026-06-22: --check used to board-[strand] eligible work the
# steward needn't touch, racing the */15-offset-3 autoland that lands it itself → false call-to-action).
autoland_excuse(){
  is_substrate "$1" && { printf 'substrate'; return; }
  is_doc "$1" && return 0                                   # docs auto-land on settle+tracked (no --test)
  # source-exec-gate (chat-review/source-exec-gate 2026-06-25): a shebang script committed WITHOUT +x is a
  # latent landmine — it won't run as ./scripts/<t>, and a --test that re-execs "$0" fails rc=126 from the
  # source while the deployed (+x) copy passes, so its "green" can't be trusted. HOLD it for manual fix
  # (chmod +x) rather than land a non-executable tool. (mesh-doctor also WARNs on this mesh-wide.)
  case "$(head -1 "$1" 2>/dev/null)" in '#!'*) [ -x "$1" ] || { printf 'non-+x source (chmod +x)'; return; } ;; esac
  grep -q -- '--test' "$1" 2>/dev/null || { printf 'no --test'; return; }
  local trc; test_ok "$1"; trc=$?
  [ "$trc" = 0 ] && return 0
  # NO PARENTHESES in a reason string: the strand [task] entry is '<tool>(<reason>)' and is parsed back
  # with ${e#*(} / ${e%)}, so a nested '(' silently truncates the reason on the board.
  # Name the budget test_ok ACTUALLY granted, not the configured ceiling: once the run's pool is part-spent
  # the grant is smaller, and reporting the ceiling would tell a steward to speed a suite up past a bar it
  # was never held to on this run.
  [ "$trc" = 3 ] && { printf -- '--test timed out at %ss — verdict unknown' "$LAND_TEST_GRANT"; return; }
  # UNRUN is not a verdict about the TOOL at all — it is one about this run. Its own reason so it can never
  # be read as, or aged like, a red test; the next tick has a fresh pool and verifies it normally.
  [ "$trc" = 4 ] && { printf -- '--test unrun — this run spent its %ss verification pool' "$LAND_TEST_POOL"; return; }
  printf -- '--test failing'
}

# unwired_note (chat-review/land-lands-unwired-no-header + task/land-lands-unwired-no-header
# 2026-07-08): mesh-land lands settled candidates with zero orphan/wiring-awareness, so a tool
# authored as a STUDY prototype with no cron/dash caller lands silently and starts its clock
# toward a mesh-doctor orphan WARN with no attached explanation of intent (live: mesh-vote landed
# 20:48:18Z 07-08 with 0 orphan-ok hits, 0 CLAUDE.md canon mentions, already sitting in
# ~/.mesh/.doctor-orphans-state). This mirrors mesh-doctor's own orphan check (scripts/mesh-doctor
# :822-877) — orphan-ok header / reflex-cadence:none-style self-declaration / crontab / systemd /
# supervise.list / CLAUDE.md canon (bare + glob/brace) / cross-script invocation (comment-stripped,
# token-bound, excluding self) — but scoped to ONE candidate (not mesh-doctor's whole-genome scan),
# so it's cheap enough to run inline on every land. Surfaces, never blocks: echoes a note string
# when NONE of those checks find the candidate wired/declared, else echoes nothing.
unwired_note(){
  local f="$1" name re_name tok canon pat expanded g
  is_doc "$f" && return 0    # docs aren't tools — no orphan concept applies
  name="$(basename "$f")"
  grep -Eq '^#[[:space:]]*orphan-ok:' "$f" 2>/dev/null && return 0
  grep -Eiq '^#[[:space:]]*reflex-cadence:[[:space:]]*(none|off|manual|on-?demand)([^a-z0-9]|$)' "$f" 2>/dev/null && return 0
  # A REAL 5-field cron cadence is NOT an orphan: the :647 mesh-autowire call wires it into
  # reflexes.cron THIS same land run (chat-review/land-orphan-warn-ignores-cadence 2026-07-11).
  # Without this, a tool like mesh-fs-integrity ('# reflex-cadence: 17 * * * *') fell through the
  # none/off/manual/on-demand sentinel above and printed a false 'will surface as a mesh-doctor
  # orphan' note moments before autowire wired it — cry-wolf that misdirected a steward to 'wire'
  # an already-self-wiring tool (verified: flagged at land, now in reflexes.cron, not a doctor orphan).
  # 5 cron fields ([-0-9*/,]+ ×5); trailing inline comment allowed (e.g. '0 */6 * * * (every 6h)').
  grep -Eiq '^#[[:space:]]*reflex-cadence:[[:space:]]*[-0-9*/,]+([[:space:]]+[-0-9*/,]+){4}([[:space:]]|$)' "$f" 2>/dev/null && return 0
  re_name=$(printf '%s' "$name" | sed 's/[.[]/\\&/g')
  tok="(^|[^A-Za-z0-9_-])${re_name}([^A-Za-z0-9_-]|$)"
  crontab -l 2>/dev/null | grep -Eq "$tok" && return 0
  grep -Eq "$tok" "$HOME"/.config/systemd/user/*.service 2>/dev/null && return 0
  [ -f "$HOME/.mesh/supervise.list" ] && grep -Eq "$tok" "$HOME/.mesh/supervise.list" 2>/dev/null && return 0
  grep -Eq "\`$(printf '%s' "$name" | sed 's/[.]/\\./g')(\`| )" "$REPO/CLAUDE.md" 2>/dev/null && return 0
  canon=$(awk '/On-demand canon/,/Capabilities/' "$REPO/CLAUDE.md" 2>/dev/null)
  while IFS= read -r g; do
    [ -z "$g" ] && continue
    pat="${g#\`}"; pat="${pat%\`}"
    for expanded in $(eval "echo $pat" 2>/dev/null); do
      case "$name" in $expanded) return 0 ;; esac
    done
  done < <(printf '%s\n' "$canon" | grep -oP '\S+(\*|{[^}]+})' | grep -v '\*\*' || true)
  # cross-script invocation: some OTHER script in the genome calls this tool by name (comment-
  # stripped so a mention in a comment doesn't count, token-bound so a longer name containing this
  # one as a substring doesn't count, excluding the candidate's own file).
  for g in "$REPO"/scripts/*; do
    [ -f "$g" ] || continue
    [ "$(basename "$g")" = "$name" ] && continue
    sed 's/#.*//' "$g" 2>/dev/null | grep -Eq "$tok" && return 0
  done
  printf '(unwired: no orphan-ok header or canon entry — will surface as a mesh-doctor orphan; add one or wire it)'
}

# FLOOD-GATE STATE I/O (chat-review/land-posted-state-read-mismatch 2026-07-04): POSTED_STATE is
# WRITTEN as THREE LINES (ts\nsig\nrefresh — sig contains spaces via the category file lists, so a
# single-line word-split read would truncate it). The old inline reader did exactly that
# ('read -r last_ts last_sig last_refresh _' consumed only line 1) → last_sig=''/last_refresh=''
# on EVERY check → sig never matched → the sig-dedup AND the exponential backoff were dead code and
# every --check with strands posted (the 109-duplicate [escalate] flood). Read all 3 lines; keep the
# 3-line write. Extracted as functions so the --test below can prove the round-trip + gate behavior.
read_posted_state(){ # $1=state file → sets last_ts/last_sig/last_refresh
  last_ts=0; last_sig=""; last_refresh="$REFRESH"
  [ -f "$1" ] || return 0
  { IFS= read -r last_ts; IFS= read -r last_sig; IFS= read -r last_refresh; } < "$1" 2>/dev/null || true
  [ -n "$last_ts" ] || last_ts=0; case "$last_ts" in *[!0-9]*) last_ts=0;; esac
  [ -n "$last_refresh" ] || last_refresh="$REFRESH"; case "$last_refresh" in *[!0-9]*) last_refresh="$REFRESH"; esac
}
gate_decide(){ # $1=now $2=sig (uses last_ts/last_sig/last_refresh from read_posted_state) → sets do_post/cur_refresh
  if [ "$2" != "$last_sig" ]; then
    cur_refresh="$REFRESH"   # strand set changed → post now, reset backoff
  else
    cur_refresh=$(( last_refresh * 2 ))
    [ "$cur_refresh" -gt "$MAX_REFRESH" ] && cur_refresh="$MAX_REFRESH"
  fi
  if [ "$2" != "$last_sig" ] || [ $(( $1 - last_ts )) -ge "$cur_refresh" ]; then do_post=1; else do_post=0; fi
}

# strand_path_for: $1=tool basename → the file it names under $REPO, or empty if it no longer exists.
# Mirrors the cands globs (scripts/ + docs/ + docs/reviews/ + top-level *.md and the is_doc templates),
# so a strand is resolved
# the same way it was raised — a reader that lags the enumerator renders a real strand as `decayed`
# (a-format-fix-must-sweep-every-reader).
strand_path_for(){
  local bn="$1" p
  for p in "$REPO/scripts/$bn" "$REPO/docs/$bn" "$REPO/docs/reviews/$bn" "$REPO/$bn"; do
    [ -f "$p" ] && { printf '%s' "$p"; return 0; }
  done
  return 1
}

# strand_disposition: $1=tool basename → landed | decayed | in-flight. ASKS GIT what happened instead
# of inferring it from absence-from-cands, which is the bug this replaces (chat-review 2026-07-15):
# cands drops a file whose mtime is younger than SETTLE (:509 fresh[]) or that fails parse_ok (broken[]),
# so merely SAVING an edit to a stranded file made it "cleared" and fired its [done] — live: room
# [taking] land-strand/mesh-room-gigaam 09:36:47 → [done] 09:38:51 → the ACTUAL landing 3a56a92 at
# 09:40:20, 89s AFTER the close. The edit closed it, not the landing. The old message ("landed or
# decayed") was unfalsifiable by construction — a third case, still-being-worked, rendered identically.
#   in-flight = the file still carries uncommitted work (a fresh edit OR a parse error) → NOT landed.
#   landed    = tracked and identical to HEAD → the work is really committed.
#   decayed   = the file is gone → the candidate vanished.
strand_disposition(){
  local bn="$1" p
  p="$(strand_path_for "$bn")" || { echo decayed; return 0; }
  git -C "$REPO" ls-files --error-unmatch -- "$p" >/dev/null 2>&1 || { echo in-flight; return 0; }
  if git -C "$REPO" diff --quiet HEAD -- "$p" 2>/dev/null; then echo landed; else echo in-flight; fi
}

# close_out_cleared: $1=TASK_POSTED_STATE path (one tool basename per line), $2=active_files (newline
# list of THIS round's strand basenames). A line absent from $2 has left the strand SET, which is not
# the same claim as "the work landed" — strand_disposition adjudicates, and only landed/decayed close.
# An in-flight file stays tracked so its [task] is still open when the mind actually lands it. Extracted
# (like gate_decide/read_posted_state above) so --test can prove the transition against a fixture repo.
close_out_cleared(){
  local state="$1" active="$2" tmp bn disp cite
  tmp="$(mktemp)"
  while IFS= read -r bn; do
    [ -n "$bn" ] || continue
    if printf '%s\n' "$active" | grep -qxF "$bn"; then
      printf '%s\n' "$bn" >> "$tmp"   # still stranded — keep tracking, no close yet
      continue
    fi
    disp="$(strand_disposition "$bn")"
    case "$disp" in
      in-flight)
        printf '%s\n' "$bn" >> "$tmp" ;;   # a mind is mid-edit: absence from cands is an EDIT, not a landing
      landed)
        cite="$(git -C "$REPO" log -1 --format=%h -- "$(strand_path_for "$bn")" 2>/dev/null)"
        command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="land@$(hostname)" mesh-chat "[done] land-strand/${bn}: landed${cite:+ ($cite)} — closing (owner: minds)" >/dev/null 2>&1 ;;
      decayed)
        command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="land@$(hostname)" mesh-chat "[done] land-strand/${bn}: decayed off strand — candidate no longer exists — closing (owner: minds)" >/dev/null 2>&1 ;;
    esac
  done < "$state"
  mv -f "$tmp" "$state"
}

# cite_for_candidate: $1=basename → echoes "cites: chat-review/<slug>" if the recent board carries a
# [done]/[sense] line naming this basename with a chat-review/<slug> reference, else echoes nothing
# (chat-review/land-commit-cites-slugs 2026-07-05: the aggregate commit body named basenames but not
# WHICH board [done] settled each one, so autonomy_ratio and any commit-history scan can't see a
# land-bundled fix's chat-review origin — it reads as self-originated). Best-effort: last-N lines,
# most-recent match wins, no match → empty (commit body unchanged for that candidate).
cite_for_candidate(){
  local base="$1" line slug
  [ -s "$CHAT_LOG" ] || return 0
  line="$(tail -n 300 "$CHAT_LOG" 2>/dev/null | grep -E '::  \[(done|sense)\]' | grep -F "$base" | tail -1)"
  [ -n "$line" ] || return 0
  slug="$(printf '%s' "$line" | grep -oE 'chat-review/[A-Za-z0-9_-]+' | head -1)"
  [ -n "$slug" ] || return 0
  printf 'cites: %s (%s)\n' "$slug" "$base"
}

# accumulate_cites: $@=basenames → ONE 'cites: ...' line per candidate that has a board slug, newline-
# joined (chat-review/land-cites-newline-strip). The old inline loop did cites="${cites}$(cite_for_
# candidate ...)" — the cmd-subst strips each call's trailing newline, so a multi-candidate commit
# mashed every cites: onto ONE physical line (repro: 401b1c7), breaking the ^cites: grep + mesh-vitality
# autonomy_ratio. Emitting a newline per non-empty cite here keeps them separate; the SINGLE cmd-subst
# the caller wraps this in strips only the ONE trailing newline, never the internal ones. Shared by the
# real path AND --test (no duplicate-drift, cf. mesh-dispatch slugof).
accumulate_cites(){
  local base c
  for base in "$@"; do
    c="$(cite_for_candidate "$base")"
    [ -n "$c" ] && printf '%s\n' "$c"
  done
}

# classify_strand_tier <reason> <age_secs> — decide WHICH board/trace tier a settled-but-unlanded
# candidate belongs in, keyed on its autoland_excuse REASON *before* age (chat-review/
# land-aged-excluded-strand-misrouted-to-decay 2026-07-18). The prior loop bucketed by age FIRST, so a
# steward-required reason that can NEVER auto-land as-is — 'substrate' (contended single-writer, held by
# design) / 'non-+x source' (needs chmod +x) / 'no --test' (needs a test) — aged past TTL into the
# task('… land or DECAY')/dropped('SILENT-DROPPED') tiers, which by their own :689 comment mean 'an
# ELIGIBLE file that STALLED'. That relabelled legitimately-held work as decayable then silently-dropped
# purely by the clock (live: mesh-egress-tunnel, non-+x, [strand] 01:48 → [task] land-or-decay 04:25).
# Fix: those held-by-design reasons stay nag_excl [strand] 'steward: review + apply' at EVERY age. Only
# the genuinely age-meaningful reasons age-tier: '' (ELIGIBLE — aging = autoland actually stalled) and
# '--test failing' (a persistently-red tool a steward may fix-or-decay). Echoes: nag_excl|nag_elig|task|dropped.
classify_strand_tier(){
  local r="$1" age="$2"
  # held-by-design / never-auto-landable-as-is → steward-required at any age (skip the age tiers).
  # '--test timed out …' age-tiers WITH '--test failing': both are fixable by the owner (speed the test
  # up, or raise MESH_LAND_TEST_TIMEOUT) and both stall landing indefinitely if nobody looks, so an aged
  # one must surface as [task], not sit in the held-by-design bucket forever.
  case "$r" in
    ''|'--test failing'|'--test timed out'*|'--test unrun'*) : ;;
    *) printf 'nag_excl'; return ;;
  esac
  if   [ "$age" -ge $(( STRAND_TTL * 4 )) ]; then printf 'dropped'
  elif [ "$age" -ge "$STRAND_TTL" ];         then printf 'task'
  elif [ -n "$r" ];                          then printf 'nag_excl'   # young '--test failing' → board [strand]
  else                                            printf 'nag_elig'   # eligible young → trace
  fi
}

# --test (relocated here so it sees test_ok + autoland_excuse, the AUTOLAND classification it asserts).
[ "${1:-}" = --test ] && {
  command -v git >/dev/null 2>&1 || { echo "smoke-test: FAIL (no git)"; exit 1; }
  [ -d "$REPO/.git" ] || { echo "smoke-test: FAIL (no repo at $REPO)"; exit 1; }
  command -v python3 >/dev/null 2>&1 || { echo "smoke-test: FAIL (no python3)"; exit 1; }
  is_doc "docs/x.md" && ! is_doc "scripts/mesh-x" && is_doc "x.md" && is_doc "CLAUDE.md" \
    || { echo "smoke-test: FAIL (is_doc routing)"; exit 1; }
  # uxn-lane artifacts route as is_doc (meta-detectors-blind-to-uxn-lane-idioms 2026-07-24): a *.tal
  # (uxn source) and *.rom (uxn binary) are neither bash nor python — parse_ok must NOT bash-parse them
  # (it marked net-ident.rom/.tal PARSE-BROKEN forever). RED-first: these asserts FAIL against the
  # pre-fix code, and a real scripts/ tool must STILL parse-gate (not route as doc).
  is_doc "scripts/uxn/net-ident.tal" && is_doc "scripts/uxn/net-ident.rom" && ! is_doc "scripts/mesh-uxn-drift" \
    || { echo "smoke-test: FAIL (uxn .tal/.rom is_doc routing)"; exit 1; }
  _tal="$(mktemp -u).tal"; printf '|0100 #d0 #da DEO BRK\n' > "$_tal"
  parse_ok "$_tal" || { rm -f "$_tal"; echo "smoke-test: FAIL (.tal wrongly parse-broken by bash -n)"; exit 1; }
  rm -f "$_tal"
  # *.c/*.h are C (uxn ROM source / host C), neither bash nor python (loop-baton 2026-07-24, hyst-gate.c
  # stranded). RED-first: against the pre-fix is_doc these FAIL (a `//`-led C file bash-parses broken).
  is_doc "scripts/uxn/hyst-gate.c" && is_doc "scripts/uxn-packet-gate/nfq-gate.c" \
    || { echo "smoke-test: FAIL (uxn/host .c is_doc routing)"; exit 1; }
  _c="$(mktemp -u).c"; printf '// c comment\nint main(void){return 0;}\n' > "$_c"
  parse_ok "$_c" || { rm -f "$_c"; echo "smoke-test: FAIL (.c wrongly parse-broken by bash -n)"; exit 1; }
  rm -f "$_c"
  # hledger journals + uxn gates-as-data/fixtures route as is_doc (loop-baton 2026-07-28,
  # accounts.journal + threshold-ledger stranded). RED-first: a `; comment` journal and a `x | y | z`
  # gate row both bash-parse broken against the pre-fix is_doc. The anchoring guard is load-bearing —
  # the real bash tools scripts/mesh-ledger + scripts/mesh-gpu-ledger must NOT route as docs.
  is_doc "scripts/accounts.journal" && is_doc "scripts/uxn/threshold-ledger" \
    && is_doc "scripts/uxn/threshold-fixtures" && is_doc "scripts/uxn/sexpr-gates" \
    && is_doc "scripts/uxn/hyst-gate.rom.sym" \
    && ! is_doc "scripts/mesh-ledger" && ! is_doc "scripts/mesh-gpu-ledger" \
    || { echo "smoke-test: FAIL (journal/uxn-data is_doc routing)"; exit 1; }
  _jr="$(mktemp -u).journal"; printf '; a comment\naccount expenses:x  ; inline\n' > "$_jr"
  parse_ok "$_jr" || { rm -f "$_jr"; echo "smoke-test: FAIL (.journal wrongly parse-broken by bash -n)"; exit 1; }
  rm -f "$_jr"
  # systemd unit/data files route as is_doc (land-parse-broken-unit-files): a real .service with a
  # parenthesized Description= must NOT bash-parse-fail (the exact bug: bash -n chokes on the '(').
  _svc="$(mktemp -u).service"; printf '[Unit]\nDescription=demo (parens)\n[Service]\nExecStart=/bin/true\n' > "$_svc"
  is_doc "$_svc" && parse_ok "$_svc" \
    || { rm -f "$_svc"; echo "smoke-test: FAIL (systemd-unit is_doc/parse_ok routing)"; exit 1; }
  rm -f "$_svc"
  # substrate exclusion: the proven-dangerous cron/routing managers must classify as substrate
  # (held from --autoland), an ordinary stream tool must NOT.
  is_substrate "scripts/mesh-reflexes" && is_substrate "scripts/mesh-restore" \
    && is_substrate "scripts/mesh-fix-egress" && is_substrate "scripts/mesh-land" \
    && ! is_substrate "scripts/mesh-presence" && ! is_substrate "scripts/mesh-light" \
    || { echo "smoke-test: FAIL (is_substrate routing)"; exit 1; }
  # autoland-eligibility split (chat-review/strand-autoland-eligibility 2026-06-22): the SHARED
  # classifier must route a substrate tool → 'substrate' (steward-required → board) and a doc → ''
  # (autoland-eligible → trace). The no-test/--test-failing arms run a real --test, so they are
  # exercised by the autoland path itself, not re-run in this smoke.
  [ "$(autoland_excuse scripts/mesh-reflexes)" = substrate ] && [ -z "$(autoland_excuse docs/x.md)" ] \
    || { echo "smoke-test: FAIL (autoland_excuse routing)"; exit 1; }
  # source-exec-gate (chat-review/source-exec-gate): a shebang candidate WITHOUT +x must be HELD
  # ('non-+x source'), never auto-landed; the same file WITH +x must NOT be held for that reason.
  _xt="$(mktemp)"; printf '#!/usr/bin/env bash\n# --test\necho hi\n' > "$_xt"; chmod 644 "$_xt"
  case "$(autoland_excuse "$_xt")" in non-+x*) : ;; *) echo "smoke-test: FAIL (non-+x source not held by autoland_excuse)"; rm -f "$_xt"; exit 1 ;; esac
  chmod 755 "$_xt"
  case "$(autoland_excuse "$_xt")" in non-+x*) echo "smoke-test: FAIL (+x source wrongly held as non-+x)"; rm -f "$_xt"; exit 1 ;; esac
  rm -f "$_xt"
  # TIMEOUT IS NOT A VERDICT (task/land-reports-a-timeout-as-a-test-failure 2026-08-19): rc=124 from the
  # budget must get its OWN excuse, never '--test failing'. Driven against REAL fixtures under a 1s
  # budget (not a stubbed timeout) — the whole bug was that the rc was never asked for. RED-first: with
  # the old `[ "$rc" = 0 ] || [ "$rc" = 2 ]` boolean the slow fixture reports '--test failing'.
  # FLOOR too: the pool machinery refuses to spend a grant below LAND_TEST_FLOOR, so a 1s budget must
  # come with a 1s floor or this block asserts the UNRUN state instead of the timeout it is about.
  _to_save="$LAND_TEST_TIMEOUT"; LAND_TEST_TIMEOUT=1
  _to_fl_save="$LAND_TEST_FLOOR"; LAND_TEST_FLOOR=1; _pool_reset
  _mkfix(){ local f; f="$(mktemp)"; printf '#!/usr/bin/env bash\n# --test\n%s\n' "$2" > "$f"; chmod 755 "$f"; printf '%s' "$f"; }
  _f_slow="$(_mkfix slow 'sleep 5; exit 0')"   # green, but not inside the budget
  _f_red="$(_mkfix red  'exit 1')"
  _f_ok="$(_mkfix ok    'exit 0')"
  _f_na="$(_mkfix na    'exit 2')"
  test_ok "$_f_slow"; [ "$?" = 3 ] || { echo "smoke-test: FAIL (test_ok did not report rc=124 as its own state=3)"; rm -f "$_f_slow" "$_f_red" "$_f_ok" "$_f_na"; exit 1; }
  _to_reason="$(autoland_excuse "$_f_slow")"
  case "$_to_reason" in
    '--test timed out at 1s'*) : ;;
    *) echo "smoke-test: FAIL (a timed-out --test was named '$_to_reason' — a timeout names a state, not a verdict)"; rm -f "$_f_slow" "$_f_red" "$_f_ok" "$_f_na"; exit 1 ;;
  esac
  case "$_to_reason" in *'('*|*')'*) echo "smoke-test: FAIL (timeout reason contains a paren — the '<tool>(<reason>)' strand entry truncates on it)"; rm -f "$_f_slow" "$_f_red" "$_f_ok" "$_f_na"; exit 1 ;; esac
  # the OTHER three arms must be unmoved by the split (a fix that renames every outcome fixes nothing)
  [ "$(autoland_excuse "$_f_red")" = '--test failing' ] \
    || { echo "smoke-test: FAIL (a genuinely red --test stopped reporting '--test failing')"; rm -f "$_f_slow" "$_f_red" "$_f_ok" "$_f_na"; exit 1; }
  [ -z "$(autoland_excuse "$_f_ok")" ] && [ -z "$(autoland_excuse "$_f_na")" ] \
    || { echo "smoke-test: FAIL (a passing / honest-n/a --test is no longer autoland-eligible)"; rm -f "$_f_slow" "$_f_red" "$_f_ok" "$_f_na"; exit 1; }
  # the reason must survive the strand [task] entry round-trip it will be printed into
  _to_entry="mesh-slow($_to_reason)"; _to_bn="${_to_entry%%(*}"; _to_got="${_to_entry#*(}"; _to_got="${_to_got%)}"
  [ "$_to_bn" = mesh-slow ] && [ "$_to_got" = "$_to_reason" ] \
    || { echo "smoke-test: FAIL (timeout reason does not round-trip the '<tool>(<reason>)' strand entry: got='$_to_got')"; rm -f "$_f_slow" "$_f_red" "$_f_ok" "$_f_na"; exit 1; }
  # and it must AGE-TIER like '--test failing' (fixable by its owner), not sit in held-by-design forever
  [ "$(classify_strand_tier "$_to_reason" "$(( STRAND_TTL + 1 ))")" = task ] \
    && [ "$(classify_strand_tier "$_to_reason" 1)" = nag_excl ] \
    || { echo "smoke-test: FAIL (a timed-out strand does not age-tier — it would never surface as [task])"; rm -f "$_f_slow" "$_f_red" "$_f_ok" "$_f_na"; exit 1; }
  LAND_TEST_TIMEOUT="$_to_save"; LAND_TEST_FLOOR="$_to_fl_save"
  # A BUDGET BELOW THE SUITE IS A PERMANENT EXCLUSION (2026-08-19). The 30s default could not verify
  # scripts/mesh-dash --test, which exits 0 in 40.6s at HEAD and 51.8s under load — so the mesh's
  # most-edited tool was structurally unlandable by the unattended path, and the node whose unjam lived
  # in that file sat rebase-CONFLICTED for 19.5h. Asserted BEHAVIOURALLY and against the DEFAULTS
  # (no env override), because the defect was the default: a green suite slower than the retired 30s
  # ceiling must now be autoland-ELIGIBLE. RED-first: against the old code this fixture is held with
  # '--test timed out at 30s'. Costs its own sleep — that is the price of testing the real budget
  # rather than a stub of it, and mesh-land is substrate, never autolanded, so it pays no budget itself.
  _to_pool_save="$LAND_TEST_POOL"; _to_floor_save="$LAND_TEST_FLOOR"
  _mkfix2(){ local f; f="$(mktemp)"; printf '#!/usr/bin/env bash\n# --test\n%s\n' "$1" > "$f"; chmod 755 "$f"; printf '%s' "$f"; }
  _pool_reset
  _f_31="$(_mkfix2 'sleep 31; exit 0')"
  _e31="$(autoland_excuse "$_f_31")"
  [ -z "$_e31" ] || { echo "smoke-test: FAIL (a GREEN --test taking 31s is not autoland-eligible under the default budget — got '$_e31'; a budget below the suite is a permanent exclusion, not a hold)"; rm -f "$_f_31"; exit 1; }
  rm -f "$_f_31"
  # THE RUN'S POOL IS REAL AND CROSSES THE SUBSHELL. Production spells this `$(autoland_excuse "$f")`,
  # so the charge must survive a command substitution — drive it through that exact form, never by
  # calling test_ok directly, or the gate proves nothing about the path that runs. Budget 6s of pool
  # against three 3s-green candidates: two verify, the third finds the pool spent and is UNRUN.
  # RED-first: with the pool held in a plain shell variable every candidate sees a pristine pool and
  # the third comes back eligible; with no pool at all, likewise.
  # Margins are deliberate, not tuned to luck: SECONDS is integer-granular so each 3s candidate charges
  # 3 OR 4. Both roads reach the same verdict — spent 6 leaves grant 2, spent 8 leaves grant 0, and the
  # floor is 3 — so the gate cannot pass or fail on rounding.
  LAND_TEST_TIMEOUT=10; LAND_TEST_POOL=8; LAND_TEST_FLOOR=3; _pool_reset
  _f_a="$(_mkfix2 'sleep 3; exit 0')"; _f_b="$(_mkfix2 'sleep 3; exit 0')"; _f_c="$(_mkfix2 'sleep 3; exit 0')"
  _ea="$(autoland_excuse "$_f_a")"; _eb="$(autoland_excuse "$_f_b")"; _ec="$(autoland_excuse "$_f_c")"
  [ -z "$_ea" ] && [ -z "$_eb" ] \
    || { echo "smoke-test: FAIL (a green candidate inside the run's pool was not eligible: '$_ea' / '$_eb')"; rm -f "$_f_a" "$_f_b" "$_f_c"; exit 1; }
  case "$_ec" in
    '--test unrun'*) : ;;
    '') echo "smoke-test: FAIL (the run's verification pool was spent and the third candidate landed anyway — the charge did not survive the \$(autoland_excuse) subshell, so the cadence bound is not enforced)"; rm -f "$_f_a" "$_f_b" "$_f_c"; exit 1 ;;
    *)  echo "smoke-test: FAIL (a candidate left UNRUN by the spent pool was named '$_ec' — an unrun test is a fact about this RUN, never a verdict about the tool)"; rm -f "$_f_a" "$_f_b" "$_f_c"; exit 1 ;;
  esac
  case "$_ec" in *'('*|*')'*) echo "smoke-test: FAIL (unrun reason contains a paren — the '<tool>(<reason>)' strand entry truncates on it)"; rm -f "$_f_a" "$_f_b" "$_f_c"; exit 1 ;; esac
  # and it must age-tier, not sit in the held-by-design bucket: a pool spent EVERY run stalls landing
  # exactly as a red test does, and only the age tiers surface that.
  [ "$(classify_strand_tier "$_ec" "$(( STRAND_TTL + 1 ))")" = task ] \
    || { echo "smoke-test: FAIL (an unrun-by-pool strand does not age-tier — a permanently spent pool would never surface)"; rm -f "$_f_a" "$_f_b" "$_f_c"; exit 1; }
  rm -f "$_f_a" "$_f_b" "$_f_c"
  # A PART-SPENT POOL MUST NAME THE GRANT IT ACTUALLY GAVE, not the configured ceiling — telling a
  # steward the suite blew a 100s bar it was never held to sends them to optimise against a fiction.
  # The spend is set EXACTLY here rather than earned by a preceding fixture: what is under test is the
  # grant arithmetic and the name it produces, and a wall-clock charge would make the expected string
  # depend on SECONDS rounding — a gate whose expected value moves is a coin toss, not an assertion.
  LAND_TEST_TIMEOUT=100; LAND_TEST_POOL=8; LAND_TEST_FLOOR=1; _pool_reset; _pool_charge 4
  _f_e="$(_mkfix2 'sleep 30; exit 0')"
  _ee="$(autoland_excuse "$_f_e")"
  case "$_ee" in
    '--test timed out at 4s'*) : ;;
    *) echo "smoke-test: FAIL (a timeout under a part-spent pool reported '$_ee' — it must name the grant test_ok gave, not the \$LAND_TEST_TIMEOUT ceiling)"; rm -f "$_f_e"; exit 1 ;;
  esac
  rm -f "$_f_e"; unset -f _mkfix2
  LAND_TEST_TIMEOUT="$_to_save"; LAND_TEST_POOL="$_to_pool_save"; LAND_TEST_FLOOR="$_to_floor_save"; _pool_reset
  rm -f "$_f_slow" "$_f_red" "$_f_ok" "$_f_na"; unset -f _mkfix
  # STRAND-TIER REASON-BEFORE-AGE (chat-review/land-aged-excluded-strand-misrouted-to-decay 2026-07-18):
  # a held-by-design strand ('substrate' / 'non-+x source (chmod +x)' / 'no --test') must stay nag_excl
  # [strand] at EVERY age — never age into task('land or decay')/dropped('SILENT-DROPPED'). Only ''
  # (eligible) and '--test failing' age-tier. RED-first: the OLD age-before-reason loop rendered an aged
  # substrate strand as 'task' — assert it is 'nag_excl' now (that assert FAILs against the pre-fix code),
  # an aged empty-reason strand STILL 'task', and a young substrate strand still 'nag_excl'.
  _aged=$(( STRAND_TTL + 60 )); _old=$(( STRAND_TTL * 4 + 60 )); _young=10
  [ "$(classify_strand_tier substrate "$_aged")" = nag_excl ] \
    || { echo "smoke-test: FAIL (aged substrate strand mis-tiered to '$(classify_strand_tier substrate "$_aged")', must stay nag_excl — the age-before-reason decay bug)"; exit 1; }
  [ "$(classify_strand_tier substrate "$_old")" = nag_excl ] \
    || { echo "smoke-test: FAIL (4×TTL substrate strand mis-tiered to '$(classify_strand_tier substrate "$_old")' — steward-required never SILENT-DROPPED)"; exit 1; }
  [ "$(classify_strand_tier 'non-+x source (chmod +x)' "$_aged")" = nag_excl ] \
    || { echo "smoke-test: FAIL (aged non-+x strand mis-tiered — held-by-design, must stay nag_excl)"; exit 1; }
  [ "$(classify_strand_tier 'no --test' "$_aged")" = nag_excl ] \
    || { echo "smoke-test: FAIL (aged no-test strand mis-tiered — held-by-design, must stay nag_excl)"; exit 1; }
  [ "$(classify_strand_tier substrate "$_young")" = nag_excl ] \
    || { echo "smoke-test: FAIL (young substrate strand must be nag_excl [strand], got '$(classify_strand_tier substrate "$_young")')"; exit 1; }
  [ "$(classify_strand_tier '' "$_aged")" = task ] \
    || { echo "smoke-test: FAIL (aged ELIGIBLE strand must age-tier to task, got '$(classify_strand_tier '' "$_aged")')"; exit 1; }
  [ "$(classify_strand_tier '' "$_old")" = dropped ] \
    || { echo "smoke-test: FAIL (4×TTL ELIGIBLE strand must escalate to dropped, got '$(classify_strand_tier '' "$_old")')"; exit 1; }
  [ "$(classify_strand_tier '' "$_young")" = nag_elig ] \
    || { echo "smoke-test: FAIL (young ELIGIBLE strand must be nag_elig [trace], got '$(classify_strand_tier '' "$_young")')"; exit 1; }
  [ "$(classify_strand_tier '--test failing' "$_aged")" = task ] \
    || { echo "smoke-test: FAIL (aged --test-failing strand should age-tier (fix-or-decay), got '$(classify_strand_tier '--test failing' "$_aged")')"; exit 1; }
  [ "$(classify_strand_tier '--test failing' "$_young")" = nag_excl ] \
    || { echo "smoke-test: FAIL (young --test-failing strand must be nag_excl [strand], got '$(classify_strand_tier '--test failing' "$_young")')"; exit 1; }
  # (was: two `grep -q '<literal>' "$0"` gates claiming to prove the self-heal exists and is
  # ff-gated. Both were VACUOUS — a source-grep for a literal ALSO matches the grep line's own
  # pattern, so each gate asserted its own text and could never fail. Demonstrated 2026-07-15:
  # deleting the entire self-heal push from the pre-fix mesh-land still yielded `smoke-test: ok`.
  # A gate that reads the source for a string cannot see whether the code RUNS — and this one was
  # guarding the exact push that then sat unreached for 11h while 55 commits stranded. Replaced by
  # the behavioural push_heal test below, which drives a real push at a real origin and asserts the
  # ref MOVES.)
  # board-flood gate sig (chat-review/strand-floodgate-sig 2026-06-26): the gate must key on BOARD
  # categories only (nag_excl/task/dropped), EXCLUDING the trace-only eligible category — else
  # eligible-set churn (a fix settling→landing→clearing) flips the sig and re-posts the unchanged
  # [strand] line (7/9 false re-posts in 5h). Search term built split so this assert can't match its
  # OWN grep text (FALSIFIABLE: re-add the eligible category to the sig → it matches → FAIL).
  _ne="nag_""elig"
  grep -nE '^[[:space:]]*sig="x:' "$0" | head -1 | grep -qF "$_ne" \
    && { echo "smoke-test: FAIL (board-flood gate sig includes the trace-only eligible category — its churn re-posts unchanged board lines)"; exit 1; }
  # POSTED_STATE anti-repeat gate must be serialized (chat-review/land-posted-state-race): the
  # read→decide→write of do_post has to sit inside an flock, else two concurrent --check double-post.
  # FALSIFIABLE: strip the flock guard from the gate → this assert FAILs. Pattern built from
  # split fragments so it can NEVER match this assertion's own text (the vacuous-self-grep class,
  # 1969a5d) — it matches only the real do_post critical-section lines.
  _fl_a='if command -v flock >/dev/null 2>&1 && ! '; _fl_b='flock -n 9; then'
  _pl_a='} 9>"$POSTED'; _pl_b='_LOCK"'
  grep -qF "${_fl_a}${_fl_b}" "$0" && grep -qF "${_pl_a}${_pl_b}" "$0" \
    || { echo "smoke-test: FAIL (POSTED_STATE gate not flock-serialized — concurrent --check will double-post)"; exit 1; }
  # behavioral unit: prove flock -n actually serializes two racers on one lock (the mechanism the fix
  # relies on) — the loser must NOT proceed. Deterministic; degrade-skip if flock is unavailable.
  if command -v flock >/dev/null 2>&1; then
    _lk="$(mktemp)"; _out="$(mktemp)"
    ( flock -n 9 && { printf 'won\n' >> "$_out"; sleep 0.4; } ) 9>"$_lk" &
    sleep 0.1
    ( flock -n 9 && printf 'won\n' >> "$_out" ) 9>"$_lk"   # contends while holder sleeps → must lose
    wait
    _wins="$(grep -c won "$_out" 2>/dev/null || echo 0)"; rm -f "$_lk" "$_out"
    [ "$_wins" = 1 ] || { echo "smoke-test: FAIL (flock -n did not serialize racers: $_wins acquired, expected 1)"; exit 1; }
  fi
  # flood-gate state read↔write round-trip (chat-review/land-posted-state-read-mismatch 2026-07-04):
  # state is written as 3 LINES; the reader must recover ts + the space-containing sig + refresh.
  # FALSIFIABLE: revert to the single-line word-split read → sig/refresh come back empty → FAIL.
  _ps="$(mktemp)"
  printf '%s\n%s\n%s\n' 1000 'x:a b,|t:c,|d:' 3600 > "$_ps"   # exact writer format, sig has spaces
  read_posted_state "$_ps"
  [ "$last_ts" = 1000 ] && [ "$last_sig" = 'x:a b,|t:c,|d:' ] && [ "$last_refresh" = 3600 ] \
    || { echo "smoke-test: FAIL (read_posted_state does not round-trip the 3-line write: ts=$last_ts sig='$last_sig' refresh=$last_refresh)"; rm -f "$_ps"; exit 1; }
  rm -f "$_ps"
  # gate behavior on that state: same sig inside the refresh window must NOT post (the dedup the
  # broken read defeated); aged repost must DOUBLE the interval (backoff engages); changed sig
  # posts immediately and resets to REFRESH.
  gate_decide 2000 'x:a b,|t:c,|d:'
  [ "$do_post" = 0 ] || { echo "smoke-test: FAIL (unchanged sig inside refresh window re-posted — sig-dedup dead)"; exit 1; }
  gate_decide 9000 'x:a b,|t:c,|d:'
  [ "$do_post" = 1 ] && [ "$cur_refresh" = 7200 ] \
    || { echo "smoke-test: FAIL (aged identical repost: do_post=$do_post refresh=$cur_refresh, want 1/7200 — backoff not engaging)"; exit 1; }
  gate_decide 2000 'x:CHANGED|t:|d:'
  [ "$do_post" = 1 ] && [ "$cur_refresh" = "$REFRESH" ] \
    || { echo "smoke-test: FAIL (changed sig must post now + reset backoff: do_post=$do_post refresh=$cur_refresh)"; exit 1; }
  # PER-TOOL SLUG idof-MATCH (chat-review/land-close-tool-vs-task-slug-mismatch 2026-07-04): the
  # whole point of the fix is that mesh-dispatch's idof (slug-first: text-before-first-colon, then
  # strip to the last '/' segment) resolves the new [task]/[done] land-strand lines to the TOOL NAME,
  # not a shared aggregate id. Replicate that one-liner here (it's a pure string transform — no need
  # to source the whole sibling script) and prove both message shapes agree on the SAME tool id.
  # FALSIFIABLE: revert to the old aggregate 'stranded N fix(es) for Xh+: ...' line → this id becomes
  # 'strandedNfixesforXh' (shared across every tool) → the two ids below stop matching the tool name.
  _slugof(){ local h="${1%%:*}"; h="${h##*/}"; printf '%s' "$h" | tr -cd '[:alnum:]-'; }
  _task_line="[task] land-strand/mesh-airtime: stranded (--test failing) 2.0h+ — steward: land or decay (owner: minds)"
  _done_line="[done] land-strand/mesh-airtime: landed or decayed off strand — closing (owner: minds)"
  _task_id="$(_slugof "${_task_line#\[task\] }")"; _done_id="$(_slugof "${_done_line#\[done\] }")"
  [ "$_task_id" = "mesh-airtime" ] && [ "$_done_id" = "mesh-airtime" ] \
    || { echo "smoke-test: FAIL (per-tool slug does not resolve to the tool name: task-id='$_task_id' done-id='$_done_id')"; exit 1; }
  # CLOSE-OUT BEHAVIOR: absence from active_files is NOT a landing. Driven against a REAL throwaway git
  # repo (not a stub) because the whole bug was that the disposition was never asked of git: the three
  # outcomes are a git fact, so a fixture that faked git would re-assert the bug it is here to catch.
  #   mesh-landed    committed, clean vs HEAD                        → [done] landed (<sha>)
  #   mesh-inflight  committed THEN edited (the room-gigaam shape)   → NO post, stays tracked
  #   mesh-untracked never committed                                 → NO post, stays tracked
  #   mesh-gone      no such file                                    → [done] decayed
  #   mesh-still-stranded  still in active_files                     → NO post, stays tracked
  _co_repo="$(mktemp -d)"; mkdir -p "$_co_repo/scripts"
  ( cd "$_co_repo" && git init -q . && git config user.email t@t && git config user.name t \
    && printf 'v1\n' > scripts/mesh-landed && printf 'v1\n' > scripts/mesh-inflight \
    && printf 'v1\n' > scripts/mesh-still-stranded \
    && git add -A && git commit -qm seed ) >/dev/null 2>&1
  printf 'v2-uncommitted\n' > "$_co_repo/scripts/mesh-inflight"     # a mind mid-edit: dirty vs HEAD
  printf 'brand-new\n'      > "$_co_repo/scripts/mesh-untracked"    # never committed
  _co_state="$(mktemp)"; _co_cap="$(mktemp)"
  printf 'mesh-landed\nmesh-inflight\nmesh-untracked\nmesh-gone\nmesh-still-stranded\n' > "$_co_state"
  mesh-chat(){ printf '%s\n' "$*" >> "$_co_cap"; }   # hermetic stub — no live board post
  ( REPO="$_co_repo"; close_out_cleared "$_co_state" "mesh-still-stranded" )
  unset -f mesh-chat
  _co_fail(){ echo "smoke-test: FAIL (close_out_cleared: $1) posts='$(cat "$_co_cap")' state='$(cat "$_co_state")'"; rm -rf "$_co_repo"; rm -f "$_co_state" "$_co_cap"; exit 1; }
  grep -q 'land-strand/mesh-landed: landed (' "$_co_cap" \
    || _co_fail "did not post a cited [done] for the genuinely landed tool"
  grep -q 'land-strand/mesh-gone: decayed off strand' "$_co_cap" \
    || _co_fail "did not post [done] for the vanished tool"
  grep -q 'mesh-inflight' "$_co_cap" \
    && _co_fail "closed a tool that is merely BEING EDITED — an edit is not a landing (the 2026-07-15 bug)"
  grep -q 'mesh-untracked' "$_co_cap" \
    && _co_fail "closed a never-committed tool as landed"
  grep -q 'mesh-still-stranded' "$_co_cap" \
    && _co_fail "posted a [done] for a tool still in the active set"
  grep -q 'landed or decayed' "$_co_cap" \
    && _co_fail "still emits the unfalsifiable 'landed or decayed' — the three outcomes must be split"
  [ "$(sort "$_co_state" | tr '\n' ' ')" = "mesh-inflight mesh-still-stranded mesh-untracked " ] \
    || _co_fail "state must keep exactly the in-flight + still-active tools and drop the closed ones"
  rm -rf "$_co_repo"; rm -f "$_co_state" "$_co_cap"
  # per-tool [task] posting: the loop must build 'land-strand/<tool>' from a task[]-shaped
  # '<tool>(<reason>)' entry (the format the age-tier categorisation above produces).
  _t_bn="mesh-airtime"; _t_reason="--test failing"
  _entry="${_t_bn}(${_t_reason})"
  _got_bn="${_entry%%(*}"; _got_reason="${_entry#*(}"; _got_reason="${_got_reason%)}"
  [ "$_got_bn" = "mesh-airtime" ] && [ "$_got_reason" = "--test failing" ] \
    || { echo "smoke-test: FAIL (task[] entry parse: bn='$_got_bn' reason='$_got_reason')"; exit 1; }
  # cite_for_candidate (chat-review/land-commit-cites-slugs): a fixture board with a [done] naming a
  # candidate + a chat-review slug must produce a cites: line; a candidate with no matching board line
  # (or a match with no slug) must produce nothing (best-effort, empty ok).
  _cl_bak="$CHAT_LOG"; CHAT_LOG="$(mktemp)"
  cat > "$CHAT_LOG" <<'EOF'
2026-07-05T07:58:41Z  chat@node  ::  [fyi] unrelated chatter about mesh-airtime, not a settle line
2026-07-05T07:59:39Z  genome@node  ::  [done] LITERATURE fix shipped in scripts/mesh-precision, cite chat-review/frame-coverage-ship, steward lands
2026-07-05T08:03:02Z  senses@node  ::  [sense] fixed false-AWAY in mesh-operator-home: added SIGNAL 4, --test 11 combos ok, uncommitted for mesh-land
EOF
  _cite_p="$(cite_for_candidate mesh-precision)"
  case "$_cite_p" in cites:\ chat-review/frame-coverage-ship*) : ;; *) echo "smoke-test: FAIL (cite_for_candidate missed a real [done]+slug match: '$_cite_p')"; rm -f "$CHAT_LOG" 2>/dev/null; CHAT_LOG="$_cl_bak"; exit 1 ;; esac
  _cite_oh="$(cite_for_candidate mesh-operator-home)"
  [ -z "$_cite_oh" ] || { echo "smoke-test: FAIL (cite_for_candidate fabricated a slug for a [sense] line with none: '$_cite_oh')"; rm -f "$CHAT_LOG"; CHAT_LOG="$_cl_bak"; exit 1; }
  _cite_none="$(cite_for_candidate mesh-nonexistent-tool)"
  [ -z "$_cite_none" ] || { echo "smoke-test: FAIL (cite_for_candidate fabricated a citation for a basename with no board mention: '$_cite_none')"; rm -f "$CHAT_LOG"; CHAT_LOG="$_cl_bak"; exit 1; }
  rm -f "$CHAT_LOG"; CHAT_LOG="$_cl_bak"
  # MULTI-CANDIDATE accumulation (chat-review/land-cites-newline-strip): 2 candidates that each carry a
  # board slug must land on 2 SEPARATE ^cites: lines — the accumulator emits a newline per cite and the
  # caller's single cmd-subst strips only the trailing one. Repro 401b1c7: the old inline concat mashed
  # them onto one line, so ^cites: grep + autonomy_ratio saw a single garbled entry.
  _cl_bak2="$CHAT_LOG"; CHAT_LOG="$(mktemp)"
  cat > "$CHAT_LOG" <<'EOF'
2026-07-05T07:59:39Z  genome@node  ::  [done] fix in scripts/mesh-precision, cite chat-review/frame-coverage-ship, steward lands
2026-07-05T08:10:00Z  genome@node  ::  [done] fix in scripts/mesh-dispatch, cite chat-review/gap-line-hardcodes-reason, steward lands
EOF
  _multi="$(accumulate_cites mesh-precision mesh-dispatch)"
  _nlines="$(printf '%s\n' "$_multi" | grep -c '^cites:')"
  [ "$_nlines" -eq 2 ] \
    || { echo "smoke-test: FAIL (multi-candidate cites must be 2 separate ^cites: lines, got $_nlines: '$_multi')"; rm -f "$CHAT_LOG"; CHAT_LOG="$_cl_bak2"; exit 1; }
  # FALSIFIABILITY: the reverted one-line variant (concat with no per-cite newline, the exact old bug)
  # collapses to a SINGLE ^cites: line — proving the count-2 assertion above genuinely discriminates
  # fixed from broken (revert accumulate_cites to strip newlines → _multi becomes 1 line → the FAIL fires).
  _mashed="$(cite_for_candidate mesh-precision)$(cite_for_candidate mesh-dispatch)"
  [ "$(printf '%s\n' "$_mashed" | grep -c '^cites:')" -eq 1 ] \
    || { echo "smoke-test: FAIL (falsifiability: the mashed no-newline concat should read as exactly 1 ^cites: line)"; rm -f "$CHAT_LOG"; CHAT_LOG="$_cl_bak2"; exit 1; }
  rm -f "$CHAT_LOG"; CHAT_LOG="$_cl_bak2"
  # unwired_note (chat-review/land-lands-unwired-no-header + task/land-lands-unwired-no-header):
  # a candidate with no orphan-ok header, no CLAUDE.md canon mention, no crontab/systemd/supervise
  # wiring, and no cross-script invocation must get a note; the SAME candidate with an orphan-ok
  # header added must come back empty (declared-intentional, nothing to surface). Uses a real file
  # planted in $REPO/scripts (unwired_note's cross-script invocation check scans that dir) with a
  # name unique enough not to collide with any real tool/canon/crontab entry.
  # trap-guarded (chat-review/land-unwired-fixture-leak): the fixture lives inside the TRACKED
  # scripts/ dir (unwired_note's cross-script scan requires that), so any interruption between
  # creation and the rm -f below (Ctrl-C, a harness timeout, SIGTERM) used to leak a permanent
  # mesh-zz-test-unwired-$$ file into the working tree — which then shows up as its own false
  # "unwired" landing candidate. FALSIFIABLE: drop this trap, SIGTERM the process between the two
  # printf's → the fixture survives in scripts/ instead of being cleaned up.
  _un_name="mesh-zz-test-unwired-$$"; _un_f="$REPO/scripts/$_un_name"
  trap 'rm -f "$_un_f"' EXIT INT TERM
  printf '#!/usr/bin/env bash\necho hi\n' > "$_un_f"
  _un_got="$(unwired_note "$_un_f")"
  case "$_un_got" in *"will surface as a mesh-doctor orphan"*) : ;; *) echo "smoke-test: FAIL (unwired_note missed a genuinely-unwired candidate: '$_un_got')"; exit 1 ;; esac
  printf '#!/usr/bin/env bash\n# orphan-ok: test fixture, intentionally unwired\necho hi\n' > "$_un_f"
  [ -z "$(unwired_note "$_un_f")" ] \
    || { echo "smoke-test: FAIL (unwired_note flagged a candidate carrying its own orphan-ok header)"; exit 1; }
  # a REAL 5-field cron cadence self-wires via :647 autowire this same run → NOT an orphan
  # (chat-review/land-orphan-warn-ignores-cadence): must come back empty. FALSIFIABLE: revert the
  # cadence exemption and this fixture flags 'will surface as a mesh-doctor orphan' before autowire.
  printf '#!/usr/bin/env bash\n# reflex-cadence: 17 * * * *\necho hi\n' > "$_un_f"
  [ -z "$(unwired_note "$_un_f")" ] \
    || { echo "smoke-test: FAIL (unwired_note flagged a real 5-field reflex-cadence tool that :647 autowire wires this run)"; exit 1; }
  # a trailing inline comment after the 5 fields must not defeat the exemption
  printf '#!/usr/bin/env bash\n# reflex-cadence: 0 */6 * * * (every 6 hours)\necho hi\n' > "$_un_f"
  [ -z "$(unwired_note "$_un_f")" ] \
    || { echo "smoke-test: FAIL (unwired_note flagged a reflex-cadence tool with a trailing inline comment)"; exit 1; }
  # a MALFORMED cadence (only 4 fields) is NOT a valid schedule → still an orphan (autowire won't wire it)
  printf '#!/usr/bin/env bash\n# reflex-cadence: 17 * * *\necho hi\n' > "$_un_f"
  case "$(unwired_note "$_un_f")" in *"will surface as a mesh-doctor orphan"*) : ;; *) echo "smoke-test: FAIL (unwired_note exempted a malformed 4-field reflex-cadence that autowire cannot wire)"; exit 1 ;; esac
  rm -f "$_un_f"
  trap - EXIT INT TERM
  # a doc candidate is never a wiring target — must always come back empty regardless of content.
  [ -z "$(unwired_note "docs/x.md")" ] \
    || { echo "smoke-test: FAIL (unwired_note flagged a docs/ candidate — is_doc exemption not honored)"; exit 1; }
  # push_heal — drive the REAL push against a REAL bare origin in a temp dir. A stub/echo test here
  # would be worthless: the bug this closes was that the push code was never REACHED, and every
  # surrounding gate was green while 55 commits sat local for 11h. So assert the artifact — origin's
  # ref actually MOVES — not that a function returned 0.
  _ph_d="$(mktemp -d)"; trap 'rm -rf "$_ph_d"' EXIT INT TERM
  git init -q --bare "$_ph_d/origin.git"
  git clone -q "$_ph_d/origin.git" "$_ph_d/work" 2>/dev/null
  git -C "$_ph_d/work" config user.email t@t; git -C "$_ph_d/work" config user.name t
  echo one > "$_ph_d/work/f"; git -C "$_ph_d/work" add f; git -C "$_ph_d/work" commit -qm one
  git -C "$_ph_d/work" branch -M main; git -C "$_ph_d/work" push -q -u origin main
  # in sync → silent no-op (a cadenced reflex that narrates every quiet tick trains everyone to ignore its log)
  [ -z "$(push_heal "$_ph_d/work")" ] \
    || { echo "smoke-test: FAIL (push_heal spoke on an in-sync repo — cron log noise)"; exit 1; }
  # local ahead → the commit must actually REACH origin. This is the exact 2026-07-15 strand.
  echo two > "$_ph_d/work/f"; git -C "$_ph_d/work" commit -qam two
  _ph_want="$(git -C "$_ph_d/work" rev-parse main)"
  push_heal "$_ph_d/work" >/dev/null \
    || { echo "smoke-test: FAIL (push_heal returned non-zero on a clean fast-forward)"; exit 1; }
  [ "$(git -C "$_ph_d/origin.git" rev-parse main)" = "$_ph_want" ] \
    || { echo "smoke-test: FAIL (push_heal claimed success but origin did NOT move — the stranded-push bug itself)"; exit 1; }
  # FALSIFIABILITY / the thing that must NEVER happen: a peer pushed, so local is DIVERGED, not behind.
  # push_heal must refuse AND leave the public origin exactly where the peer left it.
  git clone -q -b main "$_ph_d/origin.git" "$_ph_d/other" 2>/dev/null   # -b main: the bare repo's HEAD is still the init default
  git -C "$_ph_d/other" config user.email t@t; git -C "$_ph_d/other" config user.name t
  echo peer > "$_ph_d/other/g"; git -C "$_ph_d/other" add g; git -C "$_ph_d/other" commit -qm peer
  git -C "$_ph_d/other" push -q origin main
  _ph_peer="$(git -C "$_ph_d/origin.git" rev-parse main)"
  echo three > "$_ph_d/work/f"; git -C "$_ph_d/work" commit -qam three   # work never saw 'peer' → diverged
  push_heal "$_ph_d/work" >/dev/null \
    && { echo "smoke-test: FAIL (push_heal returned success on a DIVERGED origin)"; exit 1; }
  [ "$(git -C "$_ph_d/origin.git" rev-parse main)" = "$_ph_peer" ] \
    || { echo "smoke-test: FAIL (push_heal MOVED a diverged public origin — the peer's commit was destroyed)"; exit 1; }
  # UNREACHABLE ORIGIN (2026-08-16 14:33Z): the same repo, the same local commits, the only change is
  # that origin cannot be reached — so every ref comparison below runs against a STALE cached
  # origin/main. Both readers must render UNKNOWN, and reconcile_divergence must post NO strand.
  # The repo is left genuinely diverged from the fixture above, i.e. the state that USED to print
  # "DIVERGED"/"CONFLICTED" — a network-blind reading is indistinguishable from the real thing, which
  # is exactly why this gate drives the real functions and greps their real words.
  # FALSIFIABLE: delete the `[ "$fresh" != 0 ]` guard in push_heal → assert 1 FAILs; delete the
  # `! origin_fetch` guard in reconcile_divergence → asserts 2+3 FAIL (the strand gets posted).
  git -C "$_ph_d/work" remote set-url origin "$_ph_d/gone-origin.git"   # nonexistent → fetch rc≠0
  _ph_out="$(push_heal "$_ph_d/work" 2>&1)"
  case "$_ph_out" in
    *"divergence UNKNOWN"*) : ;;
    *) echo "smoke-test: FAIL (push_heal on an UNREACHABLE origin said '${_ph_out#* }' — a fetch that could not run must render UNKNOWN, never a divergence verdict)"; exit 1 ;;
  esac
  case "$_ph_out" in *DIVERGED*) echo "smoke-test: FAIL (push_heal claimed DIVERGED while origin was unreachable — the verdict is about the fetch, not origin)"; exit 1 ;; esac
  # reconcile_divergence: stub mesh-chat so a posted strand leaves a FILE, and point MESH_HOME_DIR at
  # a fresh dir so the 1h dedup stamp cannot make "no strand" pass for the wrong reason.
  mkdir -p "$_ph_d/bin" "$_ph_d/mesh"
  printf '#!/bin/sh\ntouch "%s/strand-posted"\n' "$_ph_d" > "$_ph_d/bin/mesh-chat"; chmod +x "$_ph_d/bin/mesh-chat"
  _ph_out="$(PATH="$_ph_d/bin:$PATH" MESH_HOME_DIR="$_ph_d/mesh" reconcile_divergence "$_ph_d/work" 2>&1)"
  case "$_ph_out" in
    *UNREACHABLE*) : ;;
    *) echo "smoke-test: FAIL (reconcile_divergence on an UNREACHABLE origin said '${_ph_out#* }' — a pull that could not reach the remote is not a CONFLICT)"; exit 1 ;;
  esac
  [ -e "$_ph_d/strand-posted" ] \
    && { echo "smoke-test: FAIL (reconcile_divergence posted the priority:incident strand while origin was unreachable — the phantom steward summons)"; exit 1; }
  rm -rf "$_ph_d"; trap - EXIT INT TERM
  # untracked-review-doc enumeration (2026-07-29: docs/reviews/ had 1 tracked file vs 83 untracked, the
  # oldest 5 days old — the review lane's artifacts had NO cadenced landing path, so every [done] citing
  # one cited a disk-only file). Drive enumerate_cand_paths against a REAL repo, not a source grep:
  # a NEW docs/reviews/ doc must be enumerated, a NEW draft/plan elsewhere under docs/ must NOT, and a
  # gitignored file must not sneak in either. FALSIFIABLE: drop docs/reviews/ from UNTRACKED_DOC_PATHS →
  # the first assert FAILs; widen it to bare docs/ → the scoping assert FAILs.
  # 2026-08-15 adds the two siblings this gate did NOT cover, each falsifiable the same way: a NEW
  # docs/study-<date>-<slug>.md must enumerate (drop the glob → FAIL), and a MODIFIED root-level
  # is_doc template (nodes.example) must enumerate (shrink TRACKED_CAND_GLOBS back to '*.md' → FAIL)
  # while a modified root file is_doc does NOT route (.gitignore) must stay out, so it can never reach
  # the code path and bash -n itself into PARSE-BROKEN forever.
  _ce_d="$(mktemp -d)"; trap 'rm -rf "$_ce_d"' EXIT INT TERM
  git init -q "$_ce_d"; git -C "$_ce_d" config user.email t@t; git -C "$_ce_d" config user.name t
  mkdir -p "$_ce_d/scripts" "$_ce_d/docs/reviews" "$_ce_d/docs/superpowers/plans"
  printf 'seed\n' > "$_ce_d/README.md"; git -C "$_ce_d" add README.md
  printf '# tmpl\n' > "$_ce_d/nodes.example"; git -C "$_ce_d" add nodes.example
  git -C "$_ce_d" commit -qm seed; git -C "$_ce_d" branch -M main
  printf 'docs/scratch.md\n' > "$_ce_d/.gitignore"
  git -C "$_ce_d" add .gitignore; git -C "$_ce_d" commit -qm ignore
  printf '# review\n'  > "$_ce_d/docs/reviews/some-review-2026-07-29.md"   # NEW artifact → must land
  printf '# study\n'   > "$_ce_d/docs/study-2026-08-15-a-thing.md"         # NEW study    → must land
  printf '# draft\n'   > "$_ce_d/docs/devto-something-draft.md"            # NEW draft    → must NOT
  printf '# plan\n'    > "$_ce_d/docs/superpowers/plans/p.md"              # NEW plan     → must NOT
  printf '# scratch\n' > "$_ce_d/docs/scratch.md"                          # gitignored   → must NOT
  printf '# tmpl\nKNOB=1\n' > "$_ce_d/nodes.example"                       # EDITED tmpl  → must land
  printf 'docs/scratch.md\n#edit\n' > "$_ce_d/.gitignore"                  # EDITED root  → must NOT
  _ce_out="$(enumerate_cand_paths "$_ce_d")"
  printf '%s\n' "$_ce_out" | grep -qx 'docs/reviews/some-review-2026-07-29.md' \
    || { echo "smoke-test: FAIL (a NEW docs/reviews/ artifact is not a candidate — the review lane has no landing cadence); got: $_ce_out"; exit 1; }
  printf '%s\n' "$_ce_out" | grep -qx 'docs/study-2026-08-15-a-thing.md' \
    || { echo "smoke-test: FAIL (a NEW docs/study-*.md artifact is not a candidate — the study lane has no landing cadence); got: $_ce_out"; exit 1; }
  printf '%s\n' "$_ce_out" | grep -qx 'nodes.example' \
    || { echo "smoke-test: FAIL (an EDITED root-level is_doc template is not a candidate — its documented knob can never land); got: $_ce_out"; exit 1; }
  is_doc nodes.example \
    || { echo "smoke-test: FAIL (nodes.example enumerated but NOT is_doc — it would bash -n as code and deploy to ~/.local/bin)"; exit 1; }
  printf '%s\n' "$_ce_out" | grep -qE 'devto-something-draft|superpowers/plans|docs/scratch|gitignore' \
    && { echo "smoke-test: FAIL (enumeration is not scoped — it swept a draft/plan/ignored/non-is_doc root file); got: $_ce_out"; exit 1; }
  # the enumerator and the strand READER must agree: a basename raised from docs/reviews/ has to resolve
  # back to a real path, else a genuine strand reads as `decayed` and closes itself.
  MESH_REPO_SAVE="$REPO"; REPO="$_ce_d"
  [ "$(strand_path_for some-review-2026-07-29.md)" = "$_ce_d/docs/reviews/some-review-2026-07-29.md" ] \
    || { echo "smoke-test: FAIL (strand_path_for does not resolve a docs/reviews/ basename — reader lags the enumerator)"; REPO="$MESH_REPO_SAVE"; exit 1; }
  REPO="$MESH_REPO_SAVE"
  rm -rf "$_ce_d"; trap - EXIT INT TERM
  echo "smoke-test: ok"; exit 0; }

# Candidates = uncommitted scripts/ work, BOTH tracked-modified (git diff HEAD) AND untracked
# new tools (git ls-files --others). A mind that writes a brand-new scripts/mesh-* but never
# `git add`s it used to strand invisibly (the "wired but ungenomed" class); now it's caught the
# same as a modified file, with the same settled + parse-clean gate.
cands=(); fresh=(); broken=()
while IFS= read -r f; do
  [ -n "$f" ] && [ -f "$f" ] || continue
  age=$(( now - $(stat -c %Y "$f" 2>/dev/null || echo "$now") ))
  if [ "$age" -lt "$SETTLE" ]; then fresh+=("$(basename "$f")"); continue; fi   # in-flight: leave it
  parse_ok "$f" || { broken+=("$(basename "$f")"); continue; }                  # never land a parse error
  cands+=("$f")
done < <(enumerate_cand_paths "$REPO")
# NOTE: untracked docs join the set ONLY under UNTRACKED_DOC_PATHS (see the enumerate_cand_paths defs)
# — currently docs/reviews/ and docs/study-*.md, the two write-once dated-artifact conventions.
# Everything else under docs/ still needs to be tracked before an EDIT to it auto-lands; a brand-new
# draft/plan lands via explicit 'mesh-land --apply' or a mind's own commit.

mode="${1:-}"

# --push-heal: a standalone push-only arm. Never commits, never deploys, never touches the board, so
# it is safe at a tight cadence and safe on any node holding the repo. On the STEWARD node it is no
# longer the cadenced reflex — --autoland is (reflex-args header), and --autoland push-heals as its
# FIRST action every tick (see the push_heal call at the top of its block), so the stranded-pane-commit
# case it was built for is already covered there. It exists as a distinct verb for a LEAN node that
# holds the repo but must NOT auto-commit: wire --push-heal there instead of --autoland. (History: it
# WAS the sole cadenced arm 2026-07-15..2026-07-18 while the code everywhere assumed --autoland ran on
# cron — so settled --test-green worker fixes never auto-committed, aged past STRAND_TTL into
# land-strand [task]s, and sat uncommitted for hours until a manual --apply. The SETTLE→COMMIT cadence
# the tool exists to provide was structurally absent. Same family as 1969a5d "the push that only
# happens when something else does": a step everything depends on must have its OWN unconditional
# cadence — so --autoland, which both commits AND pushes, is now that cadence. chat-review/autoland-not-croned.)
if [ "$mode" = --push-heal ]; then
  push_heal "$REPO"; exit $?
fi

# --autoland: the UNATTENDED cadence path (cron). Land only candidates that ALSO pass their own
# --test (the eyeball-substitute); everything else stays for manual --apply. This converts the
# recurring strand from "planner hand-lands each tick" to "auto-lands within the cadence" while
# never auto-committing unverified work. Safe to cadence because mesh-land runs on the STEWARD
# only (single git writer — no multi-node push race), and the SETTLE gate already excludes
# in-flight edits. Implemented by filtering cands→tested, alerting the rest, then falling through
# to the --apply path.
if [ "$mode" = --autoland ]; then
  # SELF-HEAL a stranded local->origin push. The `git push origin main` below runs ONLY when this run
  # lands a NEW candidate; an empty autoland exits at "nothing settled to land" before ever pushing. So
  # if a prior land's push failed transiently (DNS/egress dip — land.log "Could not resolve host:
  # github.com"), the commit AND the anti-SPOF mirrors (which sync FROM origin) lag until the next
  # successful land — unbounded if no new work arrives. Heal it every autoland tick: if local main is a
  # clean FAST-FORWARD ahead of origin/main, push it now. NEVER force the PUBLIC origin — a diverged
  # origin (a peer pushed) is left for manual reconcile, only logged. (confirmed 2026-06-24: eed47a0 +
  # 1c92d95 stranded back-to-back during a flaky-egress window.)
  push_heal "$REPO" || true   # a diverged/failed heal must never abort the landing itself
  # PULL-FORWARD (chat-review/autoland-pull-first): ensure local is up-to-date before committing.
  # Without this, autoland commits on top of a stale base when origin has new commits → divergence.
  # --ff-only: fast-forward only; diverged trees abort (manual reconcile needed).
  # Split into FETCH then MERGE (was one `git pull --ff-only`) so the two failure modes stop sharing
  # an exit code: a pull that fails because the network is down was read as "diverged" and escalated
  # to a priority:incident strand (origin_fetch above carries the 2026-08-16 14:33Z artifact). With
  # the fetch's rc checked, only a merge that fails against a FRESH origin/main is a divergence.
  if origin_fetch "$REPO"; then
    if ! git -C "$REPO" merge --ff-only -q origin/main 2>/dev/null; then
      # Diverged (local + origin both advanced). Do NOT silently abort — that hid a 10h autopoiesis
      # stall (tg 2026-07-29). Attempt a non-destructive rebase-reconcile; only bail if it CONFLICTS
      # (reconcile_divergence has already alarmed the board loudly in that case).
      reconcile_divergence "$REPO" || exit 0
    fi
  else
    # Unreachable origin: pull-forward is impossible, so the base MAY be stale — but landing local
    # commits stays recoverable (push_heal/reconcile fast-forward or rebase them next reachable tick),
    # whereas the old path aborted the whole output lane for the length of every egress dip AND
    # blamed a divergence for it.
    echo "$(date -u +%FT%TZ) autoland: cannot reach origin (${ORIGIN_FETCH_ERR:-git said nothing}) — divergence UNKNOWN, NOT claimed; landing locally, push retries next tick"
  fi
  tested=(); held=()
  for f in "${cands[@]}"; do
    if [ -z "$(autoland_excuse "$f")" ]; then tested+=("$f")        # eligible: doc or passing non-substrate
    elif is_substrate "$f"; then held+=("$(basename "$f")")         # substrate: human --apply only (message below)
    fi                                                              # no-test/--test-failing: left for --check (no double-alert)
  done
  # Substrate candidates left uncommitted are surfaced by the --check reflex as a strand (manual
  # review path) — no separate alert here (keeps strand-alerting in ONE place, no double-post).
  [ "${#held[@]}" -gt 0 ] && echo "mesh-land: substrate held for manual --apply (not auto-landed): ${held[*]}" >&2
  # Land ONLY the --test-passing set, silently. Whatever stays uncommitted (no/failing --test)
  # is left for the sibling `mesh-land --check` reflex to alert + TTL-escalate — so alerting
  # lives in ONE place (no double [strand] posts) and this path is pure action.
  cands=("${tested[@]+"${tested[@]}"}")
  mode=--apply   # fall through to the commit+push+deploy path with the test-gated set
fi

if [ "$mode" = --check ]; then
  # AUTOLAND-ELIGIBILITY SPLIT (chat-review/strand-autoland-eligibility 2026-06-22): board-[strand] is a
  # CALL-TO-ACTION for the steward. A candidate that --autoland will commit itself ~3m from now (the
  # */15-offset-3 tick) needs NO steward action, so boarding it is a FALSE alarm that races the autoland.
  # Classify each candidate via the SHARED autoland_excuse: EXCLUDED (substrate / no-or-failing --test) →
  # board, labeled 'steward-required: <reason>'; ELIGIBLE (doc or passing non-substrate) → the TRACE
  # (durable heads-up 'auto-lands in ≤3m'), not the board. The age-TTL buckets below still run over ALL
  # candidates, so if --autoland ever STOPS landing eligible work it ages past STRAND_TTL into the
  # task/dropped tiers and re-escalates to the board — the trace route never silently buries a real strand.
  declare -A REASON=()
  for f in "${cands[@]}"; do REASON["$(basename "$f")"]="$(autoland_excuse "$f")"; done

  # TTL-aware strand nagging: track first-seen per file, escalate old strands to [task].
  mkdir -p "$(dirname "$STRAND_STATE")"
  touch "$STRAND_STATE"
  # clean state file: drop entries for files no longer in diff
  tmp_state="$(mktemp)"; trap 'rm -f "$tmp_state"' EXIT
  active_files="$(printf '%s\n' "${cands[@]##*/}" | sort -u)"
  while IFS='|' read -r k ts; do
    printf '%s\n' "$active_files" | grep -qxF "$k" 2>/dev/null && printf '%s|%s\n' "$k" "$ts" >> "$tmp_state"
  done < "$STRAND_STATE"
  mv -f "$tmp_state" "$STRAND_STATE"
  # CLOSE-OUT (chat-review/land-close-tool-vs-task-slug-mismatch 2026-07-04): the old aggregate
  # '[task] stranded N fix(es) ...: toolA(reason) toolB(reason) …' line collapsed EVERY strand task
  # to the same idof (text-before-first-colon = 'stranded N fix(es) for Xh+' — identical every post),
  # so a tool that landed (dropped out of the diff → cleared from STRAND_STATE above) could never be
  # closed by a targeted '[done]' — its land@ [task] sat OPEN forever, and mesh-dispatch kept
  # re-routing it to idle workers as churn. The fix below (task[] posting, further down) gives each
  # strand task a per-tool slug 'land-strand/<tool>' so idof resolves to the TOOL NAME. Here: any tool
  # previously posted under that scheme which has now left the active strand set (landed, or the
  # candidate simply vanished) gets its matching '[done] land-strand/<tool>' fired once, closing
  # EXACTLY that task — then it's dropped from TASK_POSTED_STATE so it never re-fires.
  touch "$TASK_POSTED_STATE"
  # Same TOCTOU class as the POSTED_STATE gate below (chat-review/land-posted-state-race): two
  # concurrent --check runs could both read TASK_POSTED_STATE before either writes it back, both see
  # the same cleared tool, both post its [done]. Reuse POSTED_LOCK (sequential within this process —
  # the later flock use for the board-flood gate happens after this block releases it, never nested).
  {
    if command -v flock >/dev/null 2>&1 && ! flock -n 9; then
      : # lost the race — another --check holds the lock; skip close-out this tick, retry next
    else
      close_out_cleared "$TASK_POSTED_STATE" "$active_files"
    fi
  } 9>"$POSTED_LOCK"
  # categorise strands by REASON-then-age via classify_strand_tier (chat-review/
  # land-aged-excluded-strand-misrouted-to-decay): reason gates first so held-by-design work never ages
  # into the decay/drop tiers.
  #   nag_excl  = EXCLUDED  → board [strand], steward-required: <reason>
  #               (held-by-design reasons stay here at ANY age; young '--test failing' too)
  #   nag_elig  = young + ELIGIBLE          → trace 'auto-lands in ≤3m' (no board, no steward action)
  #   task      = aged ≥ TTL  (eligible or --test-failing only) → board [task] (autoland STALLED / fix-or-decay)
  #   dropped   = aged ≥ 4×TTL (same set)   → board [escalate]
  nag_excl=(); nag_elig=(); task=(); dropped=()
  for f in "${cands[@]}"; do
    bn="$(basename "$f")"; r="${REASON[$bn]}"
    first=$(grep "^${bn}|" "$STRAND_STATE" 2>/dev/null | cut -d'|' -f2)
    if [ -z "$first" ]; then first="$now"; printf '%s|%s\n' "$bn" "$now" >> "$STRAND_STATE"; fi
    age=$(( now - first ))
    case "$(classify_strand_tier "$r" "$age")" in
      dropped)  dropped+=("$bn(${r:-autoland-stalled})") ;;
      task)     task+=("$bn(${r:-autoland-stalled})") ;;
      nag_excl) nag_excl+=("$bn($r)") ;;
      *)        nag_elig+=("$bn") ;;    # nag_elig — eligible → trace
    esac
  done
  # BOARD-FLOOD GATE (chat-review 2026-06-17: land [strand] re-posted identical lines every
  # tick → ~30% of the board, drowning real signal). Post ONLY when the strand SET changed
  # (all category file lists) OR the unchanged set is older than the current refresh interval.
  # EXPONENTIAL BACKOFF: when the strand set is unchanged, double the refresh interval each
  # re-post (REFRESH → 2× → 4× → … up to MAX_REFRESH). When the set changes, reset to
  # REFRESH. The strands still exist (exit 1) every tick — we just space out identical re-posts.
  # Signature is the sorted file lists per category; stored as ts\nsig\nrefresh.
  # sig keys on BOARD categories ONLY (nag_excl/task/dropped). nag_elig is TRACE-only (line 243 →
  # mesh-trace, never the board), so eligible-set churn (a fix settling→landing→clearing) must NOT
  # flip this sig and re-post the unchanged [strand]/[task]/[escalate] lines — the defeated-gate board
  # flood (7/9 false [strand] re-posts in 5h, chat-review/strand-floodgate-sig 2026-06-26). The nag_elig
  # trace fires outside do_post below so eligible-only changes still leave a durable heads-up.
  sig="x:$(printf '%s,' "${nag_excl[@]+"${nag_excl[@]}"}")|t:$(printf '%s,' "${task[@]+"${task[@]}"}")|d:$(printf '%s,' "${dropped[@]+"${dropped[@]}"}")"
  # CONCURRENCY LOCK (chat-review/land-posted-state-race 2026-07-03): the POSTED_STATE
  # read→decide→write below is a TOCTOU — two concurrent 'mesh-land --check' (cron's dedicated
  # */45 run + mesh-vitality's own '--check' call at :17 hourly, or an ad-hoc verify run) can both
  # read the same last_ts/last_sig BEFORE either writes back, both compute do_post=1, and both post
  # the identical [strand]/[task]/[escalate] line — defeating the very anti-flood gate above.
  # LIVE-REPRODUCED: byte-identical [task]+[escalate] pair 25s apart 2026-07-03T03:17:02Z/03:17:27Z.
  # A non-blocking flock serializes it: the loser can't acquire fd 9 → do_post stays 0 → it silently
  # skips the post (the strands still exist; the exit-1 liveness signal below is OUTSIDE the lock, so
  # exit code / dash 'unlanded work' is unaffected). flock-absent (non-util-linux) → degrade UNLOCKED
  # (prior maybe-double behavior) rather than never-post.
  do_post=0
  {
    if command -v flock >/dev/null 2>&1 && ! flock -n 9; then
      : # lost the race — another --check holds the lock; skip posting (do_post stays 0)
    else
      read_posted_state "$POSTED_STATE"
      gate_decide "$now" "$sig"
      [ "$do_post" = 1 ] && printf '%s\n%s\n%s\n' "$now" "$sig" "$cur_refresh" > "$POSTED_STATE" 2>/dev/null
    fi
  } 9>"$POSTED_LOCK"
  if [ "$do_post" = 1 ]; then
    # EXCLUDED → board [strand], labeled with the steward-required reason (substrate / no-or-failing --test).
    [ "${#nag_excl[@]}" -gt 0 ] && command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="land@$(hostname)" mesh-chat "[strand] ${#nag_excl[@]} steward-required fix(es) (NOT autoland-eligible): $(printf '%s ' "${nag_excl[@]}")— steward: review (git diff) + 'mesh-land --apply'." >/dev/null 2>&1
    # AGED → board [task]. owner:minds (NOT the tool basename) so the dispatcher routes it to the
    # minds/orchestrator → human-steward, not a generic worker that must reject it (substrate strands
    # are un-actionable by an agent — owner:mesh-land wasted a worker turn on a reject every TTL cycle).
    # ONE POST PER TOOL (chat-review/land-close-tool-vs-task-slug-mismatch): each gets its own
    # 'land-strand/<tool>' slug (idof resolves to the tool name — see close-out above) instead of the
    # old aggregate line that collapsed every strand task to the same un-targetable id. Tracked in
    # TASK_POSTED_STATE so a subsequent close-out can find + clear it by name.
    if [ "${#task[@]}" -gt 0 ] && command -v mesh-chat >/dev/null 2>&1; then
      for t in "${task[@]}"; do
        t_bn="${t%%(*}"; t_reason="${t#*(}"; t_reason="${t_reason%)}"
        MESH_WHO="land@$(hostname)" mesh-chat "[task] land-strand/${t_bn}: stranded (${t_reason}) $(bc <<< "scale=1; $(( STRAND_TTL / 3600 ))")h+ — steward: land or decay (owner: minds)" >/dev/null 2>&1
        grep -qxF "$t_bn" "$TASK_POSTED_STATE" 2>/dev/null || printf '%s\n' "$t_bn" >> "$TASK_POSTED_STATE"
      done
    fi
    [ "${#dropped[@]}" -gt 0 ] && command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="land@$(hostname)" mesh-chat "[escalate] stranded ${#dropped[@]} fix(es) for $(bc <<< "scale=1; $(( STRAND_TTL * 4 / 3600 ))")h+ SILENT-DROPPED: $(printf '%s ' "${dropped[@]}")— operator/steward action needed" >/dev/null 2>&1
  fi
  # ELIGIBLE → trace (durable heads-up, NOT a board call-to-action): autoland commits these ~3m on.
  # OUTSIDE do_post (chat-review/strand-floodgate-sig): eligible-only churn must leave its heads-up
  # WITHOUT re-shouting the board (which is gated by the board-only sig above). nag_elig is transient —
  # it autolands in ≤3m — so an ungated trace fires ~once per file, never a flood; if autoland stalls
  # the per-check re-trace is the useful "still eligible, hasn't landed" nudge.
  [ "${#nag_elig[@]}" -gt 0 ] && command -v mesh-trace >/dev/null 2>&1 && MESH_WHO="land@$(hostname)" mesh-trace "land: ${#nag_elig[@]} settled fix(es) auto-land in ≤3m (no steward action): $(printf '%s ' "${nag_elig[@]}")" >/dev/null 2>&1
  # exit 1 = settled uncommitted work exists (any tier, incl. eligible-pending-autoland) — preserves the
  # land.log/dash 'there is unlanded work' signal; the board/trace SPLIT above is purely about WHERE it speaks.
  [ "${#nag_excl[@]}" -gt 0 ] || [ "${#nag_elig[@]}" -gt 0 ] || [ "${#task[@]}" -gt 0 ] || [ "${#dropped[@]}" -gt 0 ] && exit 1
  exit 0
fi

if [ "${#cands[@]}" -eq 0 ]; then
  echo "mesh-land: nothing settled+clean to land"
  [ "${#fresh[@]}"  -gt 0 ] && echo "  in-flight (mtime < ${SETTLE}s, left alone): ${fresh[*]}"
  [ "${#broken[@]}" -gt 0 ] && echo "  PARSE-BROKEN (skipped — fix or revert): ${broken[*]}"
  exit 0
fi

echo "mesh-land: ${#cands[@]} settled+clean candidate(s) to land:"
for f in "${cands[@]}"; do echo "  + $(basename "$f")  ($(git diff --numstat HEAD "$f" | awk '{print "+"$1" -"$2}'))"; done
[ "${#fresh[@]}"  -gt 0 ] && echo "  skipped in-flight: ${fresh[*]}"
[ "${#broken[@]}" -gt 0 ] && echo "  skipped parse-broken: ${broken[*]}"

[ "$mode" = --apply ] || { echo; echo "(dry-run — review with 'git diff HEAD -- scripts/<f>', then: mesh-land --apply)"; exit 0; }

# Ensure shebang scripts are executable in the COMMITTED tree. The atomic-deploy below chmods +x only
# the ~/.local/bin copy — a candidate left 644 ships NON-EXECUTABLE in the genome → doctor "NOT
# EXECUTABLE" FAIL, the recurring exec-bit class (mesh-consume-all/mesh-liveness-loop/mesh-chat-deliver,
# 2026-06-21). chmod the source before `git add` so the committed mode is 755, matching the deploy.
for f in "${cands[@]}"; do
  [ -f "$f" ] && head -1 "$f" 2>/dev/null | grep -q '^#!' && [ ! -x "$f" ] && chmod +x "$f"
done
git add -- "${cands[@]}"
names="$(printf '%s ' "${cands[@]##*/}")"
cites="$(accumulate_cites "${cands[@]##*/}")"
unwired="$(for f in "${cands[@]}"; do n="$(unwired_note "$f")"; [ -n "$n" ] && printf '%s %s\n' "$(basename "$f")" "$n"; done)"
commit_msg="mesh-land: land ${#cands[@]} settled stream fix(es): ${names}

Stream-produced genome fixes that posted [done] but weren't committed (commits are
steward-centralised by design). Settled (stable mtime > ${SETTLE}s), parse-clean,
steward-reviewed. Landed + deployed by mesh-land."
[ -n "$cites" ] && commit_msg="${commit_msg}

${cites}"
[ -n "$unwired" ] && commit_msg="${commit_msg}

${unwired}"
git commit -q -m "$commit_msg" || { echo "mesh-land: commit failed"; exit 1; }
# `git push -q origin main 2>&1 | tail -1` used to live here — the pipe threw the push's rc away, so a
# failed push (egress dip, diverged origin) printed a line nobody gated on and the run went on to
# report "landed + deployed" over a commit that never left the node. Same silent-fallback family as
# the strand this whole change is about. push_heal reports and returns its rc; say so out loud.
push_heal "$REPO" || echo "mesh-land: PUSH FAILED — the commit is LOCAL-ONLY (deploy below still ran); --push-heal retries next tick"
# ATOMIC deploy (.tmp → mv -f): mesh-land deploys mesh-* tools, many cron-wired, into the LIVE bin.
# A bare 'cp' truncate-then-writes in place → a concurrent cron exec can read a half-written file →
# phantom 'unexpected EOF' (the torn-read class, hit 2026-06-13). mv -f is an atomic rename on the
# same fs, so a running process sees either the whole old or whole new inode, never a partial one.
for f in "${cands[@]}"; do
  is_doc "$f" && continue   # land-only: docs are committed+pushed, nothing to deploy to ~/.local/bin
  b="$(basename "$f")"; d="$HOME/.local/bin/$b"
  cp "$f" "$d.tmp.$$" 2>/dev/null && chmod +x "$d.tmp.$$" 2>/dev/null && mv -f "$d.tmp.$$" "$d" 2>/dev/null
done
echo "mesh-land: landed + deployed: ${names}"
# Auto-wire any reflex-cadence tools that were just deployed (closes the autopoiesis loop at integration step)
command -v mesh-autowire >/dev/null 2>&1 && mesh-autowire 2>&1 | tail -1 || echo "mesh-land: autowire not available/skipped"
done_msg="[done] mesh-land: landed ${#cands[@]} settled stream fix(es): ${names}"
[ -n "$unwired" ] && done_msg="${done_msg}$(printf ' | %s' "$unwired")"
command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="land@$(hostname)" mesh-chat "$done_msg" >/dev/null 2>&1 || true
