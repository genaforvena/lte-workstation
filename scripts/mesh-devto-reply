#!/usr/bin/env python3
"""mesh-devto-reply — the ACTUATOR twin of mesh-devto-comments: an owed reply becomes an AGING
liability that either gets posted or gets louder, never a blip on a dash nobody is reading.

  mesh-devto-reply --owed [--json] [--all]  branch TIPS that owe a reply, with AGE (no state change)
  mesh-devto-reply --spam <idcode> --reason "..."     dispose a promo/spam row: settled, never re-escalates
  mesh-devto-reply --no-reply <idcode> --reason "..." dispose a row pub chose not to answer: settled, never re-escalates
  mesh-devto-reply --draft <idcode>   materialize a draft with the thread context above the marker
  mesh-devto-reply --post  <idcode>   post that draft through the browser, VERIFY, settle
  mesh-devto-reply [--tg] [--max N]   reflex pass: post ready drafts (if armed), escalate the rest
  mesh-devto-reply --test

# reflex-cadence: 23 */3 * * *
# reflex-args: --tg
# doctor-artifact: $HOME/.mesh/devto-replies/.pulse 14400 net

WHY THIS EXISTS (operator 2026-08-20, «we keep owing replies»): the lane had a WATCHER and no
ACTUATOR. mesh-devto-comments polls, pings and renders "1 REPLY OWED" — then the posting itself
lived in a MEMORY FILE as a browser recipe re-derived by hand every time (it cost several probes
each round), so discharging a reply depended on a mind having attention that day. A watcher whose
only actuator is somebody's attention produces exactly this: @fromzerotoship's 3d5e9 sat 3.5 days
while every reflex read green. This tool is the mesh-job-reply pattern carried into pub, and its
guards are that tool's guards, one for one:

* **Armed, not merely installed.** The unattended pass posts only under MESH_DEVTO_AUTOREPLY=on
  (~/.mesh/nodes). A mind's explicit --post is its own hands and always allowed.
* **One trigger, narrowly defined.** A branch TIP on my own published article, not authored by me,
  with no reply of mine anywhere BELOW it. Answered is a property of the TIP, never of the root —
  replying once must not make every later reply invisible.
* **The words are never generated.** Unlike the job lane, a comment reply cannot be assembled from
  fixed text — so this tool composes NOTHING. It refuses an empty draft, a draft still carrying the
  placeholder, and a body already sent. Only the parts that CAN be bounded are bounded: detect,
  route, post, verify, settle. The prose stays a mind's.
* **The artifact is the thread, not the click.** dev.to's Preact form can be clicked on a page that
  has navigated out from under it, and body.innerText right after Submit reads True off the still-
  mounted textarea. Proof is a fresh GET /api/comments showing a NEW id_code nested under the
  target — nothing else settles the row.
* **He is told immediately, with the exact text** (board + --tg), because a comment posted under his
  name that he learns about later is worse than a late one.

No write endpoint: POST /api/comments -> 404, re-measured 2026-08-20 against a GET 200 control on
the same host+key, so the 404 is the endpoint and not auth. The browser IS the wired route.

State: ~/.mesh/devto-replies/state.json (idcode -> body sha, posted id_code, verified, escalations)
Drafts: ~/.mesh/devto-drafts/reply-<idcode>.md   Log: ~/.mesh/devto-reply.log   Pulse: .pulse
Exit: 0 ok · 1 a post was attempted and did NOT verify · 2 n/a (no key / API unreachable / no
browser organ) — an honest n/a, never a faked "nothing owed".
"""
import argparse, hashlib, json, os, pathlib, re, subprocess, sys, time, tempfile, shutil

os.environ["PATH"] = os.path.expanduser("~/.local/bin") + os.pathsep + os.environ.get("PATH", "/usr/bin:/bin")

HOME    = pathlib.Path(os.environ.get("MESH_DEVTO_HOME") or pathlib.Path.home())
MESH    = HOME / ".mesh"
ENVF    = pathlib.Path(os.environ.get("MESH_DEVTO_ENV") or (MESH / "devto.env"))
STATED  = MESH / "devto-replies"
STATE   = STATED / "state.json"
DISPOS  = STATED / "dispositions.json"
OWED_CACHE = STATED / "owed-cache.json"
PULSE   = STATED / ".pulse"
DRAFTS  = MESH / "devto-drafts"
LOG     = pathlib.Path(os.environ.get("MESH_DEVTO_REPLY_LOG") or (MESH / "devto-reply.log"))
BSTATE  = MESH / "browser" / "devto.json"
API     = "https://dev.to/api"
MARK    = "%%BODY%%"
PLACE   = "<write the reply here — this line must be gone before --post will run>"
MIN_AGE_H     = float(os.environ.get("MESH_DEVTO_MIN_AGE_H", "2"))     # let a thread settle first
ESCALATE_EV_H = float(os.environ.get("MESH_DEVTO_ESCALATE_H", "12"))   # re-say it, with the age
CAP           = int(os.environ.get("MESH_DEVTO_REPLY_CAP", "2"))
API_ATTEMPTS  = max(1, int(os.environ.get("MESH_DEVTO_API_ATTEMPTS", "3")))
API_TIMEOUT_S = max(1, int(os.environ.get("MESH_DEVTO_API_TIMEOUT_S", "10")))
API_BACKOFF_S = max(0.0, float(os.environ.get("MESH_DEVTO_API_BACKOFF_S", "0.5")))
OWED_CACHE_H  = max(0.0, float(os.environ.get("MESH_DEVTO_OWED_CACHE_H", "6")))

def log(msg):
    LOG.parent.mkdir(parents=True, exist_ok=True)
    with LOG.open("a") as f:
        f.write("%s %s\n" % (time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), msg))

NODES = MESH / "nodes"

def _source(path, prefixes=None):
    """cron sources NOTHING. A gate armed in ~/.mesh/nodes is inert unless the tool reads that file
    itself — measured here before shipping: MESH_DEVTO_AUTOREPLY=on in nodes, and a stripped
    `env -i` run still printed 'autoreply disarmed'."""
    if not path.exists():
        return
    for ln in path.read_text().splitlines():
        ln = ln.strip()
        if not ln or ln.startswith("#") or "=" not in ln:
            continue
        k, v = ln.split("=", 1)
        k = k.replace("export ", "").strip()
        if prefixes and not any(k.startswith(pre) for pre in prefixes):
            continue
        os.environ.setdefault(k, v.strip().strip('"').strip("'"))

def load_env():
    _source(ENVF)
    _source(NODES, prefixes=("MESH_DEVTO_",))     # the arming lives here, and cron will not source it
    return os.environ.get("DEVTO_API_KEY", "")

def api_get(path, key):
    """Read with bounded retry; a partial/slow API read is UNKNOWN, never an empty result."""
    for attempt in range(API_ATTEMPTS):
        try:
            p = subprocess.run(["curl", "-sS", "--max-time", str(API_TIMEOUT_S),
                                "-H", "api-key: " + key, "%s/%s" % (API, path)],
                               capture_output=True, text=True, timeout=API_TIMEOUT_S + 2)
        except (OSError, subprocess.TimeoutExpired):
            p = None
        if p is not None and p.returncode == 0 and p.stdout.strip():
            try:
                return json.loads(p.stdout)
            except Exception:
                pass
        if attempt + 1 < API_ATTEMPTS:
            time.sleep(API_BACKOFF_S * (2 ** attempt))
    return None

def state_load():
    try:
        return json.loads(STATE.read_text())
    except Exception:
        return {}

def state_save(st):
    STATED.mkdir(parents=True, exist_ok=True)
    tmp = STATE.with_suffix(".tmp")
    tmp.write_text(json.dumps(st, indent=1, sort_keys=True))
    tmp.replace(STATE)

def dispos_load():
    """pub's moderation dispositions: idcode -> {verdict: spam|no-reply, reason, at, by}.
    A disposed row is settled moderation-side — it must never re-escalate."""
    try:
        d = json.loads(DISPOS.read_text())
        return d if isinstance(d, dict) else {}
    except Exception:
        return {}

def dispos_save(d):
    STATED.mkdir(parents=True, exist_ok=True)
    tmp = DISPOS.with_suffix(".tmp")
    tmp.write_text(json.dumps(d, indent=1, sort_keys=True))
    tmp.replace(DISPOS)

def do_dispose(idcode, verdict, reason):
    if verdict not in ("spam", "no-reply"):
        print("verdict must be spam or no-reply, not %r" % verdict, file=sys.stderr)
        return 1
    if not reason or len(reason) < 10:
        print("a disposition needs a reason (>=10 chars) — it is a moderation verdict, not a shrug",
              file=sys.stderr)
        return 1
    d = dispos_load()
    d[idcode] = {"verdict": verdict, "reason": reason,
                 "at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
                 "by": "pub@%s" % os.uname().nodename}
    dispos_save(d)
    log("DISPOSED %s as %s: %s" % (idcode, verdict, reason))
    print("disposed %s as %s" % (idcode, verdict))
    return 0

def is_disposed(idcode):
    return idcode in dispos_load()

def owed_cache_load():
    try:
        cached = json.loads(OWED_CACHE.read_text())
        age = time.time() - float(cached.get("fetched_at", 0))
        if age <= OWED_CACHE_H * 3600 and isinstance(cached.get("rows"), list):
            return cached, age
    except (OSError, TypeError, ValueError, json.JSONDecodeError):
        pass
    return None, None

def owed_cache_save(rows, me):
    STATED.mkdir(parents=True, exist_ok=True)
    tmp = OWED_CACHE.with_suffix(".tmp")
    tmp.write_text(json.dumps({"fetched_at": time.time(), "me": me, "rows": rows},
                              indent=1, sort_keys=True))
    tmp.replace(OWED_CACHE)

def announce(kind, text):
    """Every outward line goes through here. MESH_DEVTO_DRYCHAT=1 prints instead of posting — it can
    only make this tool QUIETER, never louder, and it is what lets --test drive the escalation branch
    for real instead of asserting the source text of a branch nobody has watched fire."""
    if os.environ.get("MESH_DEVTO_DRYCHAT") == "1":
        print("[dry:%s] %s" % (kind, text)); return
    if kind == "tg":
        subprocess.run(["mesh-tg", text], capture_output=True)
    else:
        subprocess.run(["mesh-chat", text], capture_output=True,
                       env=dict(os.environ, MESH_WHO="pub@%s" % os.uname().nodename))

def touch_pulse():
    """Liveness-touch: mtime = RAN LIVE, content = the change-gated state. A pass that changes
    nothing must still prove it ran, or the mtime watchdogs read a quiet lane as a dead one."""
    STATED.mkdir(parents=True, exist_ok=True)
    PULSE.write_text(time.strftime("%Y-%m-%dT%H:%M:%SZ\n", time.gmtime()))

# ---------------------------------------------------------------- the owed-tip selector
def _ts(s):
    try:
        return time.mktime(time.strptime((s or "")[:19], "%Y-%m-%dT%H:%M:%S"))
    except Exception:
        return 0.0

def owed_tips(tree, me, me_id=None):
    """A branch is owed when NO node below its root is mine. Report one row per branch and aim it
    at the LAST comment in that subtree — answered is a property of the tip, so a check evaluated
    only at the top level goes permanently blind the moment I reply once.

    IDENTITY is TRI-STATE (chat-review/devto-is-mine-missing-user): the username-only test this
    replaced read a comment with NO `user` as not-mine, so an own reply returned without its
    author un-answered the branch above it exactly like the depth bug did. dev.to embeds a full
    user on all 86 comments across 12 articles (measured 2026-09-23), so this is a forward guard,
    not a live condition. mine() answers True only on evidence; a node with neither username nor
    user_id is UNKNOWN, and UNKNOWN is never asserted as mine — the cost of a wrong guess falls
    on the reader (a real reply reported owed twice) rather than on our reply rate (a reader
    never answered). The numeric id is the fallback that resolves an own reply whose username
    was stripped or changed: /api/users/me `id` 4001201 is the `user_id` on every one of our
    comments and on none of the 3 foreign authors."""
    out = []
    def mine_state(n):
        u = n.get("user")
        if not isinstance(u, dict):
            u = {}
        un, uid = u.get("username"), u.get("user_id")
        if un is None and uid is None:
            return None                              # identity absent from the record
        if un == me or (me_id is not None and uid == me_id):
            return True
        return False
    def mine(n):
        return mine_state(n) is True
    def mine_below(n):
        # Whole-subtree ownership test, TRI-STATE (chat-review/devto-is-mine-missing-user):
        # True (mine anywhere below, n included) > None (unknown identity below, no
        # mine) > False. any() would collapse UNKNOWN into False and report my own
        # identity-less reply as a reader owed a reply.
        if mine(n):
            return True
        if mine_state(n) is None:
            seen = None
        else:
            seen = False
        for c in n.get("children") or []:
            r = mine_below(c)
            if r is True:
                return True
            if r is None:
                seen = None
        return seen
    def last_in(n):
        best = n
        for c in n.get("children") or []:
            cand = last_in(c)
            if _ts(cand.get("created_at")) > _ts(best.get("created_at")):
                best = cand
        return best
    def reader_below(n):
        # First DEPTH-LEFT reader with an evidenced identity. Descend through identity-less
        # nodes (which may be our own reply with a stripped author) rather than escalating the
        # identity-less node itself: a reply drafted there would be addressed to ourselves.
        for c in n.get("children") or []:
            if mine_state(c) is None:
                return reader_below(c)
            if not mine(c):
                return c
        return n
    def walk(n):
        # Tri-state descent: mine_below True = answered here, descend for deeper tips;
        # None = unresolved identity below (my user_id-only reply or a bare node) —
        # never report the CURRENT node as a reader row, descend to the real tip;
        # False = no mine below — report highest owed node + tip, stop.
        sub = mine_below(n)
        if sub is True:
            for c in n.get("children") or []:
                walk(c)
            return
        if sub is None:
            for c in n.get("children") or []:
                walk(c)
            return
        # An identity-less node is never owed: with no `user` at all we cannot evidence it is a
        # reader rather than our own reply with a stripped author, so escalating it would draft a
        # reply to ourselves. Descend — a real reader below still surfaces.
        if mine_state(n) is None:
            for c in n.get("children") or []:
                walk(c)
            return
        out.append((n, last_in(n)))          # highest owed node + the tip to answer
        return                               # one row per branch, never one per comment
    for t in tree:
        walk(t)
    return out

def collect(key):
    arts = []
    page = 1
    while True:                     # per_page=40 truncates: a live thread on an old article
        batch = api_get("articles/me/published?per_page=40&page=%d" % page, key)  # (4218940 sat
        if batch is None:           # past page 1 while 3f8ge went unanswered) — page until empty.
            if page == 1:
                return None, None
            return None, None
        if not batch:
            break
        arts += batch
        page += 1
    me = None
    rows = []
    for a in arts:
        tree = api_get("comments?a_id=%s" % a["id"], key)
        if tree is None:
            return None, None
        if me is None:
            me = (arts[0].get("user") or {}).get("username") or os.environ.get("DEVTO_USERNAME", "")
            # The NUMERIC identity axis, read live once per collect. /api/users/me is key-gated
            # (unauthenticated → 401) and answers `id` for this account; it is what owed_tips
            # falls back to for a comment with no username. An unreadable endpoint leaves this
            # empty and the selector degrades to username-only — no new failure mode.
            who = api_get("users/me", key)
            me_id = who.get("id") if isinstance(who, dict) else None
        for root, tip in owed_tips(tree, me, me_id):
            rows.append({"article_id": a["id"], "article_title": a["title"], "article_url": a["url"],
                         "root": root.get("id_code"), "idcode": tip.get("id_code"),
                         "author": (tip.get("user") or {}).get("username", "?"),
                         "created_at": tip.get("created_at"),
                         "age_h": round((time.time() - _ts(tip.get("created_at"))) / 3600.0, 1),
                         "text": re.sub(r"\s+", " ", re.sub("<[^>]+>", " ", tip.get("body_html") or "")).strip()})
    owed_cache_save(rows, me)
    return rows, me

# ---------------------------------------------------------------- drafts
def draft_path(idcode):
    return DRAFTS / ("reply-%s.md" % idcode)

def draft_body(idcode):
    """Everything after the marker is the post; everything above it is scratch the reader never sees.
    A draft still carrying the placeholder is NOT a draft — that is the whole 'never generated' guard."""
    p = draft_path(idcode)
    if not p.exists():
        return None, "no draft (%s)" % p
    raw = p.read_text()
    if MARK not in raw:
        return None, "draft has no %s marker" % MARK
    body = raw.split(MARK, 1)[1].strip()
    if not body:
        return None, "draft body is empty"
    if PLACE.split("—")[0].strip() in body:
        return None, "draft still carries the placeholder — nothing was written"
    if len(body) < 40:
        return None, "draft body is %d chars — too short to be a real reply" % len(body)
    return body, None

def do_draft(row):
    DRAFTS.mkdir(parents=True, exist_ok=True)
    p = draft_path(row["idcode"])
    if p.exists():
        print("draft already exists: %s" % p); return 0
    ctx = ["# reply to @%s  [%s]  on %r" % (row["author"], row["idcode"], row["article_title"]),
           "# %s" % row["article_url"], "# posted %s (%.1fh ago)" % (row["created_at"], row["age_h"]),
           "#", "# --- what they said (context; everything above the marker is stripped) ---"]
    ctx += ["# " + row["text"][i:i+110] for i in range(0, min(len(row["text"]), 3000), 110)]
    ctx += ["", MARK, PLACE, ""]
    p.write_text("\n".join(ctx))
    print("drafted %s" % p)
    return 0

# ---------------------------------------------------------------- post + verify
def numeric_id(article_url, idcode):
    """dev.to's /api/comments carries id_code only; the DOM node id is numeric. Map by scanning the
    article HTML and pairing each /comment/<idcode> anchor with the data-comment-id that precedes it."""
    p = subprocess.run(["curl", "-s", "--max-time", "30", article_url], capture_output=True, text=True)
    if p.returncode != 0 or len(p.stdout) < 5000:
        return None
    last = None
    for m in re.finditer(r'data-comment-id="(\d+)"|/comment/([0-9a-z]+)', p.stdout):
        if m.group(1):
            last = m.group(1)
        elif m.group(2) == idcode and last:
            return last
    return None

def verify_posted(article_id, target_idcode, key, before):
    """The artifact is the THREAD. A fresh GET must show an id_code under the target that was not
    there before — never the DOM right after the click, which reads off the still-mounted form."""
    tree = api_get("comments?a_id=%s" % article_id, key)
    if tree is None:
        return None
    found = []
    def walk(n, under):
        code = n.get("id_code")
        if under and code not in before:
            found.append(code)
        for c in n.get("children") or []:
            walk(c, under or code == target_idcode)
    for t in tree:
        walk(t, False)
    return found[0] if found else None

def codes_of(tree):
    s = set()
    def walk(n):
        s.add(n.get("id_code"))
        for c in n.get("children") or []:
            walk(c)
    for t in tree or []:
        walk(t)
    return s

def do_post(row, key, dry=False, tg=False):
    body, why = draft_body(row["idcode"])
    if why:
        print("REFUSING to post %s: %s" % (row["idcode"], why), file=sys.stderr)
        return 1
    st = state_load()
    sha = hashlib.sha256(body.encode()).hexdigest()[:12]
    prev = st.get(row["idcode"], {})
    if prev.get("verified") and prev.get("sha") == sha:
        print("already posted+verified as %s" % prev.get("posted")); return 0
    num = numeric_id(row["article_url"], row["idcode"])
    if not num:
        print("could not resolve the numeric comment id for %s" % row["idcode"], file=sys.stderr)
        return 1
    before = codes_of(api_get("comments?a_id=%s" % row["article_id"], key))
    steps = [
        'goto %s' % row["article_url"],
        'wait 2500',
        'eval \'document.querySelector("#comment-node-%s .toggle-reply-form").click()\'' % num,
        'wait 1500',
        'waitfor "#textarea-for-%s" 8000' % num,
        'fillenv "#textarea-for-%s" MESH_DEVTO_REPLY_BODY' % num,
        'wait 500',
        'eval \'document.querySelector("form:has(#textarea-for-%s) button[type=submit]").click()\'' % num,
        'wait 6000',
    ]
    if dry:
        print("comment-node %s · body sha %s · %d chars" % (num, sha, len(body)))
        print("\n".join(steps)); return 0
    fd, sf = tempfile.mkstemp(suffix=".steps"); os.close(fd)
    pathlib.Path(sf).write_text("\n".join(steps) + "\n")
    env = dict(os.environ, MESH_DEVTO_REPLY_BODY=body)
    subprocess.run(["mesh-browse", row["article_url"], "--state", str(BSTATE), "--act-file", sf],
                   env=env, capture_output=True, text=True, timeout=240)
    os.unlink(sf)
    time.sleep(4)
    posted = verify_posted(row["article_id"], row["idcode"], key, before)
    st.setdefault(row["idcode"], {}).update({"sha": sha, "posted": posted, "verified": bool(posted),
                                             "at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
                                             "article": row["article_id"]})
    state_save(st)
    if not posted:
        log("POST UNVERIFIED %s (sha %s) — thread does not show a new reply" % (row["idcode"], sha))
        print("UNVERIFIED: the thread does not show a new reply under %s — row stays owed"
              % row["idcode"], file=sys.stderr)
        return 1
    log("POSTED %s -> %s (sha %s)" % (row["idcode"], posted, sha))
    msg = ("[done] pub: replied to @%s [%s] on %r — posted as %s, VERIFIED by a fresh /api/comments "
           "read (new id_code nested under the target), not by the DOM after the click. Text: %s"
           % (row["author"], row["idcode"], row["article_title"], posted, body[:900]))
    announce("board", msg)
    if tg:
        announce("tg", "pub replied on dev.to (%r) to @%s — %s" %
                 (row["article_title"], row["author"], body[:600]))
    print("posted %s -> %s (verified)" % (row["idcode"], posted))
    return 0

def mint_chain(row, n_esc, why):
    """An escalation becomes a ledger-visible mesh-task chain, never a bare [task] line
    dispatch cannot route. Returns the chain name, or None if minting failed (caller
    then falls back to the bare board line so the escalation is never lost)."""
    import tempfile as _tf
    chain = "devto-reply-%s" % row["idcode"]
    plan = ("pub\tdraft-reply\tReply owed to @%s on %r (age at escalation, x%d) — %s. "
            "Draft: mesh-devto-reply --draft %s, then --post %s.\n"
            % (row["author"], row["article_title"], n_esc, why, row["idcode"], row["idcode"]))
    pf = None
    try:
        fd, pf = _tf.mkstemp(suffix=".plan.tsv")
        with os.fdopen(fd, "w") as f:
            f.write(plan)
        p = subprocess.run(["mesh-task", "create", chain, pf], capture_output=True, text=True)
        if p.returncode == 0:
            log("CHAIN %s minted for escalation x%d" % (chain, n_esc))
            return chain
        log("CHAIN-MINT-FAILED %s: %s" % (chain, (p.stderr or p.stdout).strip()[:200]))
    except OSError as e:
        log("CHAIN-MINT-FAILED %s: %s" % (chain, e))
    finally:
        if pf:
            try:
                os.unlink(pf)
            except OSError:
                pass
    return None

# ---------------------------------------------------------------- the unattended pass
def do_pass(rows, key, tg, maxn):
    armed = os.environ.get("MESH_DEVTO_AUTOREPLY", "").lower() == "on"
    st = state_load()
    now = time.time()
    posted = escalated = skipped = 0
    live = []
    for row in rows:
        disp = dispos_load().get(row["idcode"])
        if disp:
            skipped += 1
            continue                    # disposed: settled, never re-escalates, emits nothing
        live.append(row)
    for row in live:
        if row["age_h"] < MIN_AGE_H:
            continue
        ready = draft_body(row["idcode"])[0] is not None
        if ready and armed and posted < maxn:
            posted += 1
            do_post(row, key, tg=tg)
            continue
        rec = st.setdefault(row["idcode"], {})
        last = rec.get("escalated_at", 0)
        if now - last < ESCALATE_EV_H * 3600:
            continue
        rec["escalated_at"] = now
        rec["escalations"] = rec.get("escalations", 0) + 1
        why = "draft READY, autoreply DISARMED" if ready else draft_body(row["idcode"])[1]
        chain = None if os.environ.get("MESH_DEVTO_DRYCHAT") == "1" else mint_chain(row, rec["escalations"], why)
        if chain:
            line = ("[task] %s/draft-reply: reply owed to @%s on %r for %.1fh (x%d) — %s. "
                    "owner: mesh-devto-reply/pub. Draft: mesh-devto-reply --draft %s, then --post %s."
                    % (chain, row["author"], row["article_title"], row["age_h"],
                       rec["escalations"], why, row["idcode"], row["idcode"]))
        else:
            line = ("[task] devto-reply-%s: reply owed to @%s on %r for %.1fh (x%d) — %s. "
                    "owner: mesh-devto-reply/pub. Draft: mesh-devto-reply --draft %s, then --post %s."
                    % (row["idcode"], row["author"], row["article_title"], row["age_h"],
                       rec["escalations"], why, row["idcode"], row["idcode"]))
        announce("board", line)
        if tg:
            announce("tg", "dev.to reply owed %.1fh to @%s on %r" %
                     (row["age_h"], row["author"], row["article_title"]))
        log("ESCALATED %s age=%.1fh x%d (%s)%s" % (row["idcode"], row["age_h"], rec["escalations"], why,
                                                  " chain=%s" % chain if chain else ""))
        escalated += 1
    state_save(st)
    print("owed %d · posted %d · escalated %d · disposed-skipped %d%s" % (len(live), posted, escalated,
          skipped, "" if armed else " (autoreply disarmed — set MESH_DEVTO_AUTOREPLY=on to post unattended)"))
    return 0

# ---------------------------------------------------------------- test
def test():
    bad = lambda m: (print("smoke-test: FAIL (%s)" % m), sys.exit(1))
    # 1. the tip selector: a reply of mine at depth 1 must NOT mark a LATER grandchild answered.
    tree = [{"id_code": "r", "user": {"username": "them"}, "created_at": "2026-01-01T00:00:00Z", "children": [
             {"id_code": "a", "user": {"username": "me"}, "created_at": "2026-01-02T00:00:00Z", "children": [
              {"id_code": "b", "user": {"username": "them"}, "created_at": "2026-01-03T00:00:00Z", "children": []}]}]}]
    got = [(r.get("id_code"), t.get("id_code")) for r, t in owed_tips(tree, "me")]
    if got != [("b", "b")]:
        bad("owed tip under my own reply not reported: %r" % got)
    # ...and one branch is ONE row aimed at its last comment, never one row per comment.
    tree2 = [{"id_code": "r", "user": {"username": "them"}, "created_at": "2026-01-01T00:00:00Z", "children": [
              {"id_code": "c", "user": {"username": "them"}, "created_at": "2026-01-04T00:00:00Z", "children": []}]}]
    got2 = [(r.get("id_code"), t.get("id_code")) for r, t in owed_tips(tree2, "me")]
    if got2 != [("r", "c")]:
        bad("branch not collapsed to one row aimed at the tip: %r" % got2)
    # a fully answered thread owes nothing
    tree3 = [{"id_code": "r", "user": {"username": "them"}, "created_at": "2026-01-01T00:00:00Z", "children": [
              {"id_code": "a", "user": {"username": "me"}, "created_at": "2026-01-02T00:00:00Z", "children": []}]}]
    if owed_tips(tree3, "me"):
        bad("answered thread reported as owed")
    # 1b. MISSING-USER IDENTITY (chat-review/devto-is-mine-missing-user). The username-only test
    #     this replaced read a comment with no `user` as not-mine, so an own reply returned
    #     without its author was reported as a reader OWED a reply — the tool would draft a
    #     reply to itself. mine() now decides on TWO evidence axes (username + numeric id) and
    #     never asserts a node with no identity at all. RED-first: restoring the old
    #     (c.get("user") or {}).get("username") == me comparison fails all three at once.
    tree4 = [{"id_code": "m1", "user": {"username": "them", "user_id": 99},
              "created_at": "2026-01-01T00:00:00Z",
              "children": [{"id_code": "m2", "user": {"user_id": 4001},
                            "created_at": "2026-01-02T00:00:00Z",
                            "children": [{"id_code": "m3", "user": {"username": "them", "user_id": 98},
                                          "created_at": "2026-01-03T00:00:00Z", "children": []}]}]}]
    # (4) the numeric axis identifies my reply with NO username: the branch above it is
    #     answered and the reader becomes its own owed root — same semantic as assertion 1.
    got4 = [(r.get("id_code"), t.get("id_code")) for r, t in owed_tips(tree4, "me", 4001)]
    if got4 != [("m3", "m3")]:
        bad("own reply identified by user_id only was itself reported as owed: %r" % got4)
    # (5) without the numeric axis that reply has NO evidenced identity, so it is not asserted
    #     as mine either: UNKNOWN never becomes mine on a guess. The branch root m1 stays owed
    #     with the real reader m3 as the tip — the honest not-mine reading, erring toward
    #     answering rather than toward drafting a reply to ourselves.
    got5 = [(r.get("id_code"), t.get("id_code")) for r, t in owed_tips(tree4, "me", None)]
    if got5 != [("m1", "m3")]:
        bad("identity-less own reply was not carried to its real tip: %r" % got5)
    # (6) a tip with NO identity at all (user={}) can never be owed: no evidence it is a reader
    tree6 = [{"id_code": "n1", "user": {"username": "them", "user_id": 99},
              "created_at": "2026-01-01T00:00:00Z",
              "children": [{"id_code": "n2", "user": {},
                            "created_at": "2026-01-02T00:00:00Z", "children": []}]}]
    got6 = [(r.get("id_code"), t.get("id_code")) for r, t in owed_tips(tree6, "me", 4001)]
    if got6:
        bad("a tip with NO identity at all was reported as owed: %r" % got6)
    # 2. the never-generated guard, driven against REAL files in a scratch HOME (never the durable one)
    global DRAFTS, STATE, STATED, PULSE, LOG
    tmp = pathlib.Path(tempfile.mkdtemp(prefix="devto-reply-test-"))
    DRAFTS, STATED = tmp / "drafts", tmp / "state"
    STATE, PULSE, LOG = STATED / "state.json", STATED / ".pulse", tmp / "test.log"
    row = {"idcode": "zz1", "author": "them", "article_title": "T", "article_url": "u",
           "created_at": "2026-01-01T00:00:00Z", "age_h": 99.0, "text": "x" * 200}
    if draft_body("zz1")[0] is not None: bad("a missing draft passed the guard")
    do_draft(row)
    b, why = draft_body("zz1")
    if b is not None: bad("the freshly stubbed draft passed the guard (placeholder not caught): %r" % why)
    p = draft_path("zz1")
    p.write_text(p.read_text().replace(PLACE, "short"))
    if draft_body("zz1")[0] is not None: bad("a 5-char body passed the length guard")
    p.write_text(p.read_text().replace("short", "R" * 60))
    b, why = draft_body("zz1")
    if b != "R" * 60: bad("a real body was not extracted cleanly: %r / %r" % (b, why))
    if MARK in b or "#" in b: bad("context above the marker leaked into the body")
    # 3. verify_posted must not accept a code that already existed, and must find a NEW one.
    def mk(extra):
        # the target ALREADY has a reply under it (id "stale", present in `before`), so an
        # implementation that just looks for "anything nested under the target" passes wrongly.
        kids = [{"id_code": "old", "user": {}, "children":
                 [{"id_code": "stale", "user": {}, "children": []}] + list(extra)}]
        return [{"id_code": "top", "user": {}, "children": kids}]
    global api_get
    real_api = api_get
    api_get = lambda path, key: mk([])
    if verify_posted(1, "old", "k", {"top", "old", "stale"}) is not None:
        bad("verify_posted counted a reply that was ALREADY in the thread before the post")
    api_get = lambda path, key: mk([{"id_code": "new", "user": {}, "children": []}])
    if verify_posted(1, "old", "k", {"top", "old", "stale"}) != "new":
        bad("verify_posted missed the new nested reply")
    if verify_posted(1, "nosuch", "k", {"top", "old", "stale"}) is not None:
        bad("verify_posted counted a reply nested under a DIFFERENT comment")
    # 3a2. ARTICLE PAGINATION: a live thread on an old article must not fall off page 1.
    def fake_paged(path, key):
        if path.startswith("articles/"):
            if "page=1" in path:
                return [{"id": 1, "title": "new", "url": "u1",
                         "user": {"username": "me"}}]
            if "page=2" in path:
                return [{"id": 2, "title": "old", "url": "u2",
                         "user": {"username": "me"}}]
            return []
        if "a_id=2" in path:
            return [{"id_code": "oldroot", "user": {"username": "them"},
                     "created_at": "2026-01-01T00:00:00Z", "children": []}]
        return []
    api_get = fake_paged
    prows, pme = collect("k")
    api_get = real_api
    if prows is None or [r["idcode"] for r in prows] != ["oldroot"]:
        bad("collect stopped at page 1 and dropped the old article's owed thread: %r" % (prows,))
    # a mid-pagination API failure is UNKNOWN, never a partial (silent) result.
    api_get = lambda path, key: None
    prows2, _ = collect("k")
    api_get = real_api
    if prows2 is not None:
        bad("a failed article read returned a partial list instead of UNKNOWN")
    # 3b. THE LOUD BRANCH, driven — an escalation nobody has watched fire is not an escalation.
    import io, contextlib
    os.environ["MESH_DEVTO_DRYCHAT"] = "1"
    old_cap = globals().get("MIN_AGE_H")
    row_old = dict(row, idcode="zz2", age_h=50.0)
    row_new = dict(row, idcode="zz3", age_h=0.1)
    buf = io.StringIO()
    with contextlib.redirect_stdout(buf):
        do_pass([row_old, row_new], "k", False, 2)
    out = buf.getvalue()
    if "devto-reply-zz2" not in out or "50.0h" not in out:
        bad("an owed row 50h old did not escalate: %r" % out[:300])
    if "owner: mesh-devto-reply/pub" not in out:
        bad("the escalation carries no routable owner clause")
    if "zz3" in out:
        bad("a row younger than MIN_AGE_H escalated — the settle window does nothing")
    buf2 = io.StringIO()
    with contextlib.redirect_stdout(buf2):
        do_pass([row_old], "k", False, 2)
    if "devto-reply-zz2" in buf2.getvalue():
        bad("the same row escalated twice inside the window — the board would be spammed")
    os.environ.pop("MESH_DEVTO_DRYCHAT", None)
    # 3d. DISPOSITIONS: a spam-disposed row emits NOTHING from the pass and never re-escalates.
    global DISPOS
    DISPOS = STATED / "dispositions.json"
    if do_dispose("zz9", "spam", "x") == 0:
        bad("a reason shorter than 10 chars was accepted as a moderation verdict")
    if do_dispose("zz9", "maybe", "a long enough reason here") == 0:
        bad("an unknown verdict was accepted")
    if do_dispose("zz9", "spam", "promo link farm, unrelated to the article") != 0:
        bad("a well-formed spam disposition was refused")
    if not is_disposed("zz9"):
        bad("the disposed row does not read back as disposed")
    os.environ["MESH_DEVTO_DRYCHAT"] = "1"
    row_spam = dict(row, idcode="zz9", age_h=50.0)
    row_live = dict(row, idcode="zz8", age_h=50.0)
    buf3 = io.StringIO()
    with contextlib.redirect_stdout(buf3):
        do_pass([row_spam, row_live], "k", False, 2)
    out3 = buf3.getvalue()
    if "zz9" in out3:
        bad("a spam-disposed row leaked into the pass output: %r" % out3[:300])
    if "owed 1 ·" not in out3 or "disposed-skipped 1" not in out3:
        bad("the pass did not account the disposed row separately: %r" % out3[:300])
    if "devto-reply-zz8" not in out3:
        bad("the live owed row did not escalate beside the disposed one")
    # 3f. the --is-disposed CLI verb: the read-only gate the poller calls. A settled row answers
    #     0, an unknown row answers 1, and neither may touch the network or the API key.
    if not is_disposed("zz9"):
        bad("precondition: zz9 must be disposed before the CLI verb is probed")
    saved_argv, saved_env = sys.argv, os.environ.get("DEVTO_API_KEY")
    os.environ.pop("DEVTO_API_KEY", None)
    try:
        sys.argv = ["mesh-devto-reply", "--is-disposed", "zz9"]
        if main() != 0:
            bad("--is-disposed answered non-zero for a settled row")
        sys.argv = ["mesh-devto-reply", "--is-disposed", "zz1-not-disposed"]
        if main() != 1:
            bad("--is-disposed answered 0 for a row with no disposition")
    finally:
        sys.argv = saved_argv
        if saved_env is not None:
            os.environ["DEVTO_API_KEY"] = saved_env
    os.environ.pop("MESH_DEVTO_DRYCHAT", None)
    # 3e. CHAIN MINT: an escalation carries a ledger chain, never just a bare board line.
    import subprocess as _sp
    real_run = _sp.run
    seen = {}
    def fake_run(cmd, **kw):
        seen["cmd"] = cmd
        class R: returncode = 0; stdout = "created"; stderr = ""
        return R()
    _sp.run = fake_run
    subprocess.run = fake_run
    try:
        ch = mint_chain(dict(row, idcode="zz7", author="them", article_title="T"), 1, "no draft")
    finally:
        _sp.run = real_run
        subprocess.run = real_run
    if ch != "devto-reply-zz7":
        bad("mint_chain did not return the ledger chain name: %r" % ch)
    if seen.get("cmd", [])[:3] != ["mesh-task", "create", "devto-reply-zz7"]:
        bad("mint_chain did not call mesh-task create: %r" % seen.get("cmd"))
    _sp.run = real_run
    def fail_run(cmd, **kw):
        class R: returncode = 1; stdout = ""; stderr = "chain exists"
        return R()
    subprocess.run = fail_run
    try:
        ch2 = mint_chain(dict(row, idcode="zz7", author="them", article_title="T"), 1, "no draft")
    finally:
        subprocess.run = real_run
    if ch2 is not None:
        bad("a failed mint did not return None (the caller must fall back to the bare line)")
    # 3c. THE ARMING MUST COME FROM THE FILE. cron sources nothing, so a gate that only reads the
    #     environment is armed in prose and disarmed in fact — that is how this very tool shipped
    #     its first minute (env -i run printed "disarmed" with nodes saying on).
    global NODES, ENVF
    _keep_nodes, _keep_envf, _keep_key = NODES, ENVF, os.environ.get("DEVTO_API_KEY")
    nd = tmp / "nodes"
    nd.write_text("# c\nMESH_DEVTO_AUTOREPLY=on\nDEVTO_API_KEY=leak-me\nUNRELATED=x\n")
    NODES, ENVF = nd, tmp / "absent.env"
    os.environ.pop("MESH_DEVTO_AUTOREPLY", None); os.environ.pop("UNRELATED", None)
    os.environ.pop("DEVTO_API_KEY", None)
    load_env()
    if os.environ.get("MESH_DEVTO_AUTOREPLY") != "on":
        bad("the arming in the nodes file never reached the process — cron would run it disarmed")
    if os.environ.get("UNRELATED") or os.environ.get("DEVTO_API_KEY") == "leak-me":
        bad("the nodes reader is not scoped to MESH_DEVTO_* — it imported the whole node config")
    os.environ.pop("MESH_DEVTO_AUTOREPLY", None)
    NODES, ENVF = _keep_nodes, _keep_envf
    if _keep_key:
        os.environ["DEVTO_API_KEY"] = _keep_key
    else:
        os.environ.pop("DEVTO_API_KEY", None)
    # 4. liveness-touch writes a pulse, and the test's own writes never touched the durable paths.
    touch_pulse()
    if not PULSE.exists(): bad("pulse not written")
    if str(pathlib.Path.home()) in str(LOG) and ".mesh/devto-reply.log" in str(LOG):
        bad("the test wrote to the durable log — a dry run must never forge the liveness record")
    shutil.rmtree(tmp, ignore_errors=True)
    # 5. the organ itself: no key is an honest n/a, not "nothing owed".
    if not load_env() and not os.environ.get("DEVTO_API_KEY"):
        print("smoke-test: n/a (no DEVTO_API_KEY — selector+guard arms passed)"); sys.exit(2)
    print("smoke-test: ok (tip-not-root selector + branch collapsed to one row + answered owes nothing"
          " + missing/placeholder/short drafts all REFUSED + body extracted without context"
          " + verify needs a NEW code nested under THIS target"
          " + escalation SEEN firing once, carrying its owner, skipping a young row and"
          " suppressed on the second pass + the arming READ FROM THE NODES FILE and scoped"
          " to MESH_DEVTO_* + pulse + test wrote no durable log)")
    return 0

def main():
    ap = argparse.ArgumentParser(add_help=False)
    ap.add_argument("--draft"); ap.add_argument("--post"); ap.add_argument("--dry", action="store_true")
    ap.add_argument("--owed", action="store_true"); ap.add_argument("--json", action="store_true"); ap.add_argument("--all", action="store_true")
    ap.add_argument("--is-disposed")
    ap.add_argument("--tg", action="store_true"); ap.add_argument("--max", type=int, default=CAP)
    ap.add_argument("--test", action="store_true"); ap.add_argument("-h", "--help", action="store_true")
    ap.add_argument("--spam"); ap.add_argument("--no-reply"); ap.add_argument("--reason", default="")
    a = ap.parse_args()
    if a.help:
        sys.stdout.write(__doc__); return 0
    if a.test:
        return test()
    if a.is_disposed is not None:
        # read-only moderation lookup (used by mesh-devto-comments --pending/--list): a settled row
        # never resurfaces. Answered BEFORE the API reads — a disposition is local state, not a fetch.
        return 0 if is_disposed(a.is_disposed) else 1
    if a.spam or a.no_reply:
        if (a.spam and a.no_reply) or not a.reason:
            print("one of --spam/--no-reply plus --reason is required", file=sys.stderr); return 1
        return do_dispose(a.spam or a.no_reply, "spam" if a.spam else "no-reply", a.reason)
    key = load_env()
    if not key:
        print("[devto-reply] n/a: no DEVTO_API_KEY in %s" % ENVF, file=sys.stderr); return 2
    rows, me = collect(key)
    cached = False
    cache_age = None
    if rows is None:
        cache, cache_age = owed_cache_load()
        if cache is not None:
            rows, me, cached = cache["rows"], cache.get("me"), True
            print("[devto-reply] UNKNOWN: API read failed; showing %.1fh-old ownership cache — posting disabled"
                  % (cache_age / 3600.0), file=sys.stderr)
        else:
            print("[devto-reply] n/a: dev.to API unreachable — NOT reporting 'nothing owed'", file=sys.stderr)
            return 2
    touch_pulse()
    rows.sort(key=lambda r: -r["age_h"])
    if a.owed:
        shown = rows if a.all else [r for r in rows if not is_disposed(r["idcode"])]
        if a.json:
            print(json.dumps({"status": "UNKNOWN" if cached else "FRESH", "cache_age_h":
                              round(cache_age / 3600.0, 2) if cached else None,
                              "rows": shown}, indent=1)); return 2 if cached else 0
        for r in shown:
            d = dispos_load().get(r["idcode"]) if a.all else None
            print("[%s] @%-24s %5.1fh  %s%s\n     %s" % (r["idcode"], r["author"], r["age_h"],
                                                       r["article_title"],
                                                       "  [disposed: %s]" % d["verdict"] if d else "",
                                                       r["text"][:150]))
        if not shown:
            print("nothing owed (%s)" % me)
        return 2 if cached else 0
    if cached:
        print("[devto-reply] refusing action from stale ownership cache", file=sys.stderr)
        return 2
    sel = a.draft or a.post
    if sel:
        hit = [r for r in rows if r["idcode"] == sel or r["root"] == sel]
        if not hit:
            print("%s is not an owed tip right now (mesh-devto-reply --owed)" % sel, file=sys.stderr)
            return 1
        return do_draft(hit[0]) if a.draft else do_post(hit[0], key, dry=a.dry, tg=a.tg)
    return do_pass(rows, key, a.tg, a.max)

if __name__ == "__main__":
    sys.exit(main())
