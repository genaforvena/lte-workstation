#!/usr/bin/env bash
# mesh-tv-watch — edge-triggered TV liveness reflex: [tv-down]/[tv-ok] on port 52323 change.
# Usage: mesh-tv-watch [--edge] [--test]
# Exit: 0 = verdict emitted (or no change on --edge); 2 = smoke-test fail
set -uo pipefail
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
export PATH="$HOME/.local/bin:$PATH"

TV_IP="${MESH_TV_IP:-192.168.8.130}"
TV_PORT="${MESH_TV_PORT:-52323}"
STATEFILE="$HOME/.mesh/.tv-watch.state"

if [ "${1:-}" = "--test" ]; then
  command -v mesh-chat >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-chat)"; exit 2; }
  command -v nc >/dev/null 2>&1 || { echo "smoke-test: FAIL (no nc)"; exit 2; }
  [ -d "$(dirname "$STATEFILE")" ] || { echo "smoke-test: FAIL (no ~/.mesh)"; exit 2; }
  # dry-run: mock unreachable IP → verify down detection + state file written
  _sf="$STATEFILE"
  rm -f "$_sf"
  TV_IP=127.0.0.2 TV_PORT=1 nc -z -w1 127.0.0.2 1 2>/dev/null; _rc=$?
  _cur=$([ "$_rc" = 0 ] && echo ok || echo down)
  printf '%s' "$_cur" >"$_sf"
  [ "$_cur" = "down" ] && [ -f "$_sf" ] && [ "$(cat "$_sf")" = "down" ] || { echo "smoke-test: FAIL (state file wrong)"; exit 2; }
  rm -f "$_sf"
  echo "smoke-test: ok"; exit 0
fi

# Probe: port open within 3s = TV on
if nc -z -w3 "$TV_IP" "$TV_PORT" >/dev/null 2>&1; then
  cur="ok"
else
  cur="down"
fi

prev="$(cat "$STATEFILE" 2>/dev/null || true)"

if [ "$cur" = "$prev" ]; then
  exit 0  # no change, suppress
fi

printf '%s' "$cur" > "$STATEFILE"

if [ "$cur" = "ok" ]; then
  mesh-chat "[tv-ok] TV ${TV_IP} DLNA :${TV_PORT} reachable — TV on" 2>/dev/null || true
else
  mesh-chat "[tv-down] TV ${TV_IP} DLNA :${TV_PORT} unreachable — TV off or offline" 2>/dev/null || true
fi
