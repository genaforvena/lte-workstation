#!/usr/bin/env bash
# mesh-diary — the mesh keeps a DIARY of the home's life. A reflex, not a mind.
#
# Operator (2026-07-17): "пусть записывает вообще все и оформляет в дневник. минд почти ничего
# не делать должен, только проверять, что дневник ведётся. большая часть работы окна — рефлексы."
#
# Every run it reads whatever is NEW across the life-sources (room speech, arrivals, presence,
# activity states) since its per-source byte watermark, hands the raw material to mesh-relay to
# be written up as a short diary entry (Russian, first-person "мы/дом"), and appends it to the
# day's file. The mind's only job is to check the diary is still being kept (mesh-diary --status).
#
# FAST INGEST, DEBOUNCED EMISSION (operator 2026-07-17 "я говорил, а запись не идёт"): the room
# transcript SELF-PRUNES to ~10 min (mesh-room-gigaam prunes every 8s) — a 20-min diary cadence
# therefore LOST every word older than the prune horizon before it could read it. So the diary now
# TICKS FAST (*/2, well under the 10-min prune) and on every tick pulls new speech straight into a
# durable HOLD buffer (~/.mesh/diary/.hold) — once there, the material survives the transcript prune.
# It does NOT write an entry per tick (that would flood the day with fragments). Instead it emits ONE
# entry when the burst SETTLES — QUIET seconds with no new speech — or, for a long unbroken monologue,
# when the hold hits MAXHOLD (kept safely under the 10-min prune). Result: a sentence lands in the
# diary ~QUIET after it's spoken, a conversation becomes one entry, and nothing is ever pruned unread.
#
#   mesh-diary                run once: ingest new material → format → append today's entry
#   mesh-diary --status       liveness verdict for the mind (KEPT | HOLDING | EMPTY-OK | DEAF | STALE)
#   mesh-diary --heal         restart any DEAD room-ear service (the mind is steward of the tract)
#   mesh-diary --tail [n]      last n lines of the current diary file (default 40)
#   mesh-diary --today         path of today's diary file
#   mesh-diary --json          machine-readable status
#   mesh-diary --test          smoke test (drives the REAL ingest pipeline, sandboxed)
#
# Diary:     ~/.mesh/diary/YYYY-MM-DD.md   (one file per day, entries appended)
# Watermark: ~/.mesh/diary/.offsets        (per-source byte offset; reset to 0 on rotation)
# State:     ~/.mesh/diary/.state          (mtime = last live run; content = last verdict)
#
# MESH_DIARY_SOURCES : space-sep basenames under ~/.mesh to ingest (default below).
# MESH_DIARY_RELAY   : formatter command (default: mesh-relay). Test stubs this — never the pipeline.
# MESH_DIARY_MODEL   : optional model pin passed to the relay via MESH_GROQ_MODEL.
# MESH_DIARY_CAP     : max bytes read per source per run (default 8000) — bounds the relay prompt.
# MESH_DIARY_QUIET   : seconds of no-new-speech that SETTLE a burst → flush one entry (default 90).
# MESH_DIARY_MAXHOLD : hard ceiling — flush even mid-burst after this many seconds held (default 360,
#                      < the ~10-min transcript prune so a monologue is never pruned unread).
#
# NO SILENT FALLBACK: if the relay produces nothing, the entry is still written but marked
#   [RELAY-FAILED] with the RAW material verbatim — the diary keeps progressing and the failure is
#   LOUD in the file and the verdict, never a plausible blank. A dead cron never runs → never
#   touches → --status honestly reads STALE.
#
# reflex-cadence: */2 * * * *
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes" 2>/dev/null || true

MESH="${MESH_DIR:-$HOME/.mesh}"
DIARY_DIR="$MESH/diary"
OFFSETS="$DIARY_DIR/.offsets"
STATE="$DIARY_DIR/.state"
HOLD="$DIARY_DIR/.hold"            # durable buffer of ingested-but-not-yet-emitted speech (prune-safe)
HOLDSTART="$DIARY_DIR/.holdstart"  # mtime = when the current burst began accumulating
CAP="${MESH_DIARY_CAP:-8000}"
QUIET="${MESH_DIARY_QUIET:-90}"        # seconds of silence that settle a burst → flush
MAXHOLD="${MESH_DIARY_MAXHOLD:-360}"   # hard flush ceiling (< the ~10-min transcript prune)
RELAY="${MESH_DIARY_RELAY:-mesh-relay}"
# The diary is the STEWARD of the whole tract (ear → STT → transcript → diary). Its liveness verdict
# must not read EMPTY-OK ("quiet home") when the truth is DEAF (the ear died) — that is a hollow
# sense (reachable ≠ producing). ear_state checks the ear services; a dead ear under an otherwise-
# quiet diary becomes a LOUD DEAF, and --heal restarts a dead ear. Node-tunable list of the room-ear
# units; empty/absent → n/a (never a false DEAF on a node that has no such units).
EAR_UNITS="${MESH_DIARY_EAR_UNITS:-mesh-room-note3-bridge.service mesh-room-gigaam.service mesh-overhear.service}"
# A life-diary needs a model that FOLLOWS the Russian first-person instruction — the relay's default
# llama-3.1-8b-instant ignores it and dumps an English device analysis (relay-verdict-needs-a-pin).
# Pin a prose-grade instruct model; override per node via MESH_DIARY_MODEL.
# NB: llama-4-scout-17b-16e-instruct was RETIRED from Groq 2026-07-17 ("model does not exist" —
# verified absent from the live /v1/models catalog, bare AND meta-llama/ prefixed). A dead pin does
# not error: mesh-relay's auto-mode degrades groq→local silently, so EVERY entry fell to the local
# qwen/gemma prose path → garbled RU («неприинимательное»). llama-3.3-70b-versatile is the live
# prose-grade Groq model (the same pick mesh-interpret vets for real work). Repin + force --pool groq
# in format_entry so a future retirement surfaces LOUDLY (RELAY-FAILED) instead of lying in prose.
: "${MESH_DIARY_MODEL:=llama-3.3-70b-versatile}"
# Life-sources by default — SPEECH in the room and WHO came/went are what a home diary is of. Raw
# device/BLE scans (presence.log) and mesh-internal coordination (chat/traces/records) are NOISE that
# drowns the life signal — the model latched onto MAC addresses when presence.log was fed. Widen
# deliberately via MESH_DIARY_SOURCES (e.g. add home-state.log for activity narration).
SOURCES="${MESH_DIARY_SOURCES:-room-transcript.txt arrivals.log}"

mkdir -p "$DIARY_DIR"
[ -e "$OFFSETS" ] || : >"$OFFSETS"

today_file(){ echo "$DIARY_DIR/$(date -u +%Y-%m-%d).md"; }
now_hm(){ date -u +%H:%M; }

# --- per-source watermark: emit only bytes appended since last run ------------------------------
_get_off(){ awk -v k="$1" '$1==k{print $2; found=1} END{if(!found)print 0}' "$OFFSETS"; }
_set_off(){ # $1=key $2=offset  (rewrite the one line, keep the rest)
  local k="$1" v="$2" tmp; tmp="$(mktemp)"
  awk -v k="$k" -v v="$v" '$1==k{print k, v; done=1; next} {print} END{if(!done)print k, v}' "$OFFSETS" >"$tmp" && mv "$tmp" "$OFFSETS"
}

# Collect the new material across all sources into $RAW_TMP; stage the would-be offsets into
# $STAGE_TMP (committed by the caller only once the entry is safely written — a crash mid-format
# then re-reads the same material next run rather than losing it). Files, not shell vars, because
# the caller reads this via $(...) and a subshell var would never reach the parent to commit.
RAW_TMP="" STAGE_TMP=""
collect_new(){
  local src f size off new tag any=0 start
  RAW_TMP="$(mktemp)"; STAGE_TMP="$(mktemp)"
  for src in $SOURCES; do
    f="$MESH/$src"
    [ -e "$f" ] || continue
    size=$(stat -c%s "$f" 2>/dev/null || echo 0)
    off=$(_get_off "$src")
    # rotation/truncation guard — file shrank under our offset → start from the top
    [ "$off" -gt "$size" ] 2>/dev/null && off=0
    if [ "$size" -gt "$off" ]; then
      # read at most CAP bytes of the NEW tail (skip ahead if the gap is larger than the cap)
      start=$off
      [ $(( size - off )) -gt "$CAP" ] && start=$(( size - CAP ))
      new="$(tail -c +"$(( start + 1 ))" "$f" 2>/dev/null | grep -a -v '^[[:space:]]*$' || true)"
      if [ -n "$new" ]; then
        tag="${src%.*}"
        printf '## %s\n%s\n\n' "$tag" "$new" >>"$RAW_TMP"
        any=1
      fi
    fi
    printf '%s %s\n' "$src" "$size" >>"$STAGE_TMP"
  done
  return $(( any ? 0 : 1 ))
}
commit_off(){ [ -s "$STAGE_TMP" ] || return 0; while read -r k v; do [ -n "$k" ] && _set_off "$k" "$v"; done <"$STAGE_TMP"; }

# --- the mind-less formatter: raw material → one short diary entry -------------------------------
# NO "Тихо." escape hatch in the prompt — the model over-takes it and collapses a lively scene into
# one word (skip-hatch trap). Quiet is decided in CODE: collect_new returns "nothing new" → EMPTY-OK,
# no entry. By the time we prompt, there IS material, so demand a grounded paragraph about it.
DIARY_PROMPT='Ты — дневник умного дома. Ниже сырые события с прошлой записи (речь в комнате,
приходы/уходы). Напиши ОДИН короткий живой абзац дневника на русском от лица дома ("мы", "у нас") —
что происходило, кто был, о чём говорили, какое настроение. Пиши только про то, что реально есть в
событиях, не выдумывай. Если в событиях нет приходов/уходов — значит, никто не пришёл и не ушёл;
НИКОГДА не упоминай системы и датчики (mesh-arrivals, сигнал, обработка и т.п.) и не утверждай, что
они чего-то не обнаружили, не обработали или нет сигнала — пиши просто про людей и происходящее.
Пиши строго по-русски, кириллицей; латиница — только для имён устройств
(note3, Quest 3). Никаких иностранных слов, иероглифов и вкраплений других языков. Только сам текст
записи: без заголовков, без списков, без преамбулы, без английского. Вот события:'

# --- foreign-script guard (mixed-script leak, room chat-review 2026-07-20 15:01:50Z) --------------
# llama-3.3-70b stochastically bleeds other-script tokens into RU prose («не来了», «довольно活ым»,
# 5+ entries in one day). Benched vs the live Groq pool 2026-07-21 (n=12/model, real prompt +
# leak-provoking fixtures): no live model is measurably cleaner (qwen3.6-27b is WORSE — leaks +
# 7/12 empty; gpt-oss-* 0-vs-0 against the incumbent), so the pin stays and the guard is CODE:
# letters outside Cyrillic+Latin are never legitimate in an entry (RU prose + Latin device names
# only). Dirty render → ONE retry (the leak is stochastic — a re-roll is usually clean); still
# dirty → strip the foreign letters. Latin-word bleed («dijo», «ngay») is indistinguishable from
# device names in code — the strict-Cyrillic prompt line above is what targets it.
_has_foreign(){ perl -CSD -ne '$n++ while /(?![\p{Latin}\p{Cyrillic}])\pL/g; END{exit($n?0:1)}'; }
_scrub_foreign(){ perl -CSD -pe 's/(?![\p{Latin}\p{Cyrillic}])\pL//g'; }

format_entry(){ # stdin=raw material -> stdout=entry text (empty on relay failure)
  local raw out try; raw="$(cat)"
  [ -n "$raw" ] || { echo; return; }
  local env_pin=(); [ -n "${MESH_DIARY_MODEL:-}" ] && env_pin=(env "MESH_GROQ_MODEL=$MESH_DIARY_MODEL")
  # FORCE the groq pool — no silent fallover to the local qwen/gemma prose path (measured garbled RU).
  # For the diary, an honest gap ([RELAY-FAILED] + raw preserved, below) beats a fabricated paragraph,
  # so groq-down / a retired pin must surface as EMPTY here → the LOUD failure path in flush_hold.
  for try in 1 2; do
    out="$(printf '%s\n\n%s\n' "$DIARY_PROMPT" "$raw" \
      | timeout 90 "${env_pin[@]}" "$RELAY" --pool groq 2>/dev/null | sed '/^[[:space:]]*$/d')"
    [ -n "$out" ] || break                       # empty = relay down → the LOUD path, not a re-roll
    printf '%s' "$out" | _has_foreign || break   # clean → done
    if [ "$try" = 1 ]; then
      echo "diary: foreign-script leak in render — retrying once" >&2
    else
      echo "diary: foreign-script leak persisted — scrubbing" >&2
      out="$(printf '%s' "$out" | _scrub_foreign)"
    fi
  done
  printf '%s\n' "$out"
}

# --- flush the HOLD buffer into ONE diary entry (called only when a burst has settled) -----------
flush_hold(){
  local raw entry f rc=0
  raw="$(cat "$HOLD")"
  [ -n "$raw" ] || { rm -f "$HOLD" "$HOLDSTART" 2>/dev/null; return 0; }
  entry="$(format_entry <"$HOLD")"
  f="$(today_file)"
  { echo "### $(now_hm)Z"
    if [ -n "$entry" ]; then
      printf '%s\n\n' "$entry"
    else
      # LOUD failure — the relay gave nothing; preserve raw material so the day is never blank-lied.
      echo "[RELAY-FAILED — raw material preserved]"
      printf '```\n%s\n```\n\n' "$raw"
    fi
  } >>"$f"
  rm -f "$HOLD" "$HOLDSTART" 2>/dev/null   # burst emitted — clear the buffer
  if [ -n "$entry" ]; then
    echo "KEPT $(date -u +%FT%TZ) $(wc -c <"$f") bytes" >"$STATE"
    echo "diary: entry appended -> $f"
  else
    echo "RELAY-FAILED $(date -u +%FT%TZ) raw preserved" >"$STATE"
    echo "diary: RELAY-FAILED — raw material preserved in $f" >&2
    rc=3
  fi
  return $rc
}

run_once(){
  local now quiet_age hold_age
  # 1) INGEST — pull any NEW speech straight into the durable HOLD buffer. Once here it is safe from
  #    the ~10-min transcript prune; commit the watermark immediately so we never re-read it.
  collect_new || true
  if [ -s "$RAW_TMP" ]; then
    [ -e "$HOLDSTART" ] || : >"$HOLDSTART"   # mark the burst's start (mtime = first-held)
    cat "$RAW_TMP" >>"$HOLD"                  # append (mtime of .hold = last-new-speech time)
    commit_off
  fi
  rm -f "$RAW_TMP" "$STAGE_TMP" 2>/dev/null

  # 2) EMIT — only when the burst has SETTLED (QUIET s of no new speech) or hit the MAXHOLD ceiling.
  if [ -s "$HOLD" ]; then
    now=$(date +%s)
    quiet_age=$(( now - $(stat -c%Y "$HOLD" 2>/dev/null || echo "$now") ))
    hold_age=$(( now - $(stat -c%Y "$HOLDSTART" 2>/dev/null || echo "$now") ))
    if [ "$quiet_age" -ge "$QUIET" ] || [ "$hold_age" -ge "$MAXHOLD" ]; then
      flush_hold; return $?
    fi
    # burst still forming — stay LIVE, write no fragment
    echo "HOLDING $(date -u +%FT%TZ) burst settling (quiet ${quiet_age}s/${QUIET}, held ${hold_age}s/${MAXHOLD})" >"$STATE"
    echo "diary: holding — burst not settled yet"; return 0
  fi

  # 3) nothing held and nothing new — stay LIVE, quiet home
  echo "EMPTY-OK $(date -u +%FT%TZ) no new material" >"$STATE"
  echo "diary: no new material (still kept)"; return 0
}

# --- ear-liveness: is the tract actually HEARING? (override in --test via MESH_DIARY_EAR_CMD) -----
ear_state(){ # prints: alive | dead | n/a
  if [ -n "${MESH_DIARY_EAR_CMD:-}" ]; then "$MESH_DIARY_EAR_CMD"; return; fi
  command -v systemctl >/dev/null 2>&1 || { echo n/a; return; }
  [ -n "$EAR_UNITS" ] || { echo n/a; return; }
  local u known=0
  for u in $EAR_UNITS; do
    [ "$(systemctl --user is-active "$u" 2>/dev/null)" = active ] && { echo alive; return; }
    systemctl --user cat "$u" >/dev/null 2>&1 && known=1   # unit exists on this node?
  done
  [ "$known" = 1 ] && echo dead || echo n/a   # no known unit here → don't judge (n/a)
}

# --- self-heal: restart any DEAD ear unit that exists on this node (sensors are a commons) --------
heal_ears(){
  command -v systemctl >/dev/null 2>&1 || { echo "diary: no systemctl — cannot heal ears"; return 2; }
  local u did=0
  for u in $EAR_UNITS; do
    systemctl --user cat "$u" >/dev/null 2>&1 || continue         # only touch units that exist
    if [ "$(systemctl --user is-active "$u" 2>/dev/null)" != active ]; then
      if systemctl --user restart "$u" 2>/dev/null; then
        echo "diary: restarted dead ear $u"
        command -v mesh-trace >/dev/null 2>&1 && mesh-trace "diary: healed dead ear $u (restart)" >/dev/null 2>&1 || true
        did=1
      else
        echo "diary: FAILED to restart $u" >&2
      fi
    fi
  done
  [ "$did" = 0 ] && echo "diary: all ears alive (nothing to heal)"
  return 0
}

status_verdict(){ # KEPT | HOLDING | EMPTY-OK | DEAF | STALE | UNKNOWN, with age
  local age v
  [ -e "$STATE" ] || { echo "UNKNOWN (never run)"; return; }
  age=$(( $(date +%s) - $(stat -c%Y "$STATE" 2>/dev/null || echo 0) ))
  v="$(cut -d' ' -f1 "$STATE" 2>/dev/null)"
  # the reflex ticks every 2m; ~7 missed cadences without a live touch = the diary stopped being kept
  if [ "$age" -gt 900 ]; then echo "STALE (${age}s since last run — diary not being kept)"; return; fi
  case "$v" in
    KEPT)          echo "KEPT (${age}s — entries flowing)";;
    HOLDING)       echo "HOLDING (${age}s — live, burst settling)";;
    EMPTY-OK)      # "quiet" is only honest if the ear is actually up — else the home is DEAF, not quiet
                   if [ "$(ear_state)" = dead ]; then
                     echo "DEAF (${age}s — ear DOWN, home not being heard; run: mesh-diary --heal)"
                   else
                     echo "EMPTY-OK (${age}s — live, quiet home)"
                   fi;;
    RELAY-FAILED)  echo "RELAY-FAILED (${age}s — formatter down, raw preserved)";;
    *)             echo "UNKNOWN (${age}s)";;
  esac
}

# --- test: drive the REAL ingest→collect→format→append→offset pipeline (relay stubbed, HOME sandboxed) --
if [ "${1:-}" = --test ]; then
  for x in awk tail stat sed wc perl; do command -v "$x" >/dev/null 2>&1 || { echo "smoke-test: FAIL (no $x)"; exit 1; }; done
  td="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
  trap 'rm -rf "$td"' EXIT
  mkdir -p "$td/.mesh"
  # a stub formatter that PROVES the real material reached it — byte count + a token from the fixture
  stub="$td/relay-stub"; cat >"$stub" <<'EOF'
#!/usr/bin/env bash
in="$(cat)"; echo "STUBENTRY:$(printf '%s' "$in" | wc -c)b"
printf '%s' "$in" | grep -q 'привет' && echo "GOT-PRIVET"
EOF
  chmod +x "$stub"
  df="$td/.mesh/diary/$(date -u +%Y-%m-%d).md"
  run(){ HOME="$td" MESH_DIR="$td/.mesh" MESH_DIARY_RELAY="$stub" MESH_DIARY_SOURCES=room-transcript.txt "$@" "$0"; }
  seed(){ printf '[20:57:03] [note3] привет дом\nкак дела\n' >"$td/.mesh/room-transcript.txt"; }
  seed

  # 1) INGEST-HOLDS: a fresh burst must be pulled into the hold buffer but NOT emitted as an entry
  #    while it is still forming (QUIET not yet elapsed) — no per-tick fragment flood.
  out="$(run env MESH_DIARY_QUIET=9999 MESH_DIARY_MAXHOLD=9999 2>&1)" \
    || { echo "smoke-test: FAIL (ingest run errored: $out)"; exit 1; }
  [ -s "$td/.mesh/diary/.hold" ] || { echo "smoke-test: FAIL (new speech not pulled into the hold buffer)"; exit 1; }
  [ -e "$df" ] && grep -q 'STUBENTRY:' "$df" && { echo "smoke-test: FAIL (unsettled burst emitted an entry — no debounce)"; exit 1; }
  HOME="$td" MESH_DIR="$td/.mesh" "$0" --status 2>/dev/null | grep -q 'HOLDING' \
    || { echo "smoke-test: FAIL (--status not HOLDING while a burst is settling)"; exit 1; }

  # 2) PRUNE-SURVIVES: wipe the transcript (simulate the 10-min prune) — the held speech must STILL
  #    reach the formatter intact. Then SETTLE it (QUIET=0) → exactly one entry, carrying the words.
  : >"$td/.mesh/room-transcript.txt"
  run env MESH_DIARY_QUIET=0 MESH_DIARY_MAXHOLD=9999 >/dev/null 2>&1
  [ -s "$df" ] || { echo "smoke-test: FAIL (settled burst wrote no diary file)"; exit 1; }
  grep -q 'STUBENTRY:' "$df" || { echo "smoke-test: FAIL (formatter output not in diary — flush broken)"; exit 1; }
  grep -q 'GOT-PRIVET' "$df" || { echo "smoke-test: FAIL (held speech lost across the prune — not durable)"; exit 1; }
  [ -e "$td/.mesh/diary/.hold" ] && { echo "smoke-test: FAIL (hold buffer not cleared after flush)"; exit 1; }

  # 3) DEDUP + LIVENESS: a further tick with nothing new appends no second entry and reads live+quiet
  before="$(grep -c 'STUBENTRY:' "$df")"
  run env MESH_DIARY_QUIET=0 >/dev/null 2>&1
  after="$(grep -c 'STUBENTRY:' "$df")"
  [ "$before" = "$after" ] || { echo "smoke-test: FAIL (re-ran with no new material yet appended again — watermark/hold leak)"; exit 1; }
  HOME="$td" MESH_DIR="$td/.mesh" "$0" --status 2>/dev/null | grep -q 'EMPTY-OK' \
    || { echo "smoke-test: FAIL (--status not EMPTY-OK after an empty run)"; exit 1; }

  # 4) MAXHOLD CEILING: a long unbroken burst (QUIET never elapses) must still flush once the hold
  #    hits MAXHOLD — a monologue is never held past the transcript prune.
  printf '[21:03:10] [note3] это длинный монолог без пауз\n' >>"$td/.mesh/room-transcript.txt"
  ceil="$(grep -c 'STUBENTRY:' "$df")"
  run env MESH_DIARY_QUIET=9999 MESH_DIARY_MAXHOLD=0 >/dev/null 2>&1
  [ "$(grep -c 'STUBENTRY:' "$df")" -gt "$ceil" ] \
    || { echo "smoke-test: FAIL (MAXHOLD ceiling did not force a flush of an unsettled burst)"; exit 1; }

  # 5) LOUD relay failure: a formatter that emits nothing must still write an entry, marked, raw preserved
  printf 'новое событие для проверки сбоя\n' >>"$td/.mesh/room-transcript.txt"
  emptyrelay="$td/relay-empty"; printf '#!/usr/bin/env bash\ncat >/dev/null; exit 0\n' >"$emptyrelay"; chmod +x "$emptyrelay"
  HOME="$td" MESH_DIR="$td/.mesh" MESH_DIARY_RELAY="$emptyrelay" MESH_DIARY_SOURCES=room-transcript.txt \
    MESH_DIARY_QUIET=0 "$0" >/dev/null 2>&1
  grep -q 'RELAY-FAILED' "$df" || { echo "smoke-test: FAIL (empty relay output did not produce a LOUD [RELAY-FAILED] entry)"; exit 1; }
  grep -q 'новое событие для проверки сбоя' "$df" || { echo "smoke-test: FAIL (raw material not preserved on relay failure)"; exit 1; }

  # 6) DEAF vs QUIET: a quiet diary (EMPTY-OK state) with a DEAD ear must read DEAF, not EMPTY-OK —
  #    the hollow-sense guard. Force an empty run to write EMPTY-OK state, then stub the ear as dead.
  seed2="$td/.mesh/room-transcript.txt"; : >"$seed2"
  earalive="$td/ear-alive"; printf '#!/usr/bin/env bash\necho alive\n' >"$earalive"; chmod +x "$earalive"
  eardead="$td/ear-dead";   printf '#!/usr/bin/env bash\necho dead\n'  >"$eardead";  chmod +x "$eardead"
  # advance offsets past everything so a run is genuinely empty → EMPTY-OK state
  HOME="$td" MESH_DIR="$td/.mesh" MESH_DIARY_RELAY="$stub" MESH_DIARY_SOURCES=room-transcript.txt \
    MESH_DIARY_QUIET=0 "$0" >/dev/null 2>&1
  HOME="$td" MESH_DIR="$td/.mesh" MESH_DIARY_EAR_CMD="$eardead" "$0" --status 2>/dev/null | grep -q 'DEAF' \
    || { echo "smoke-test: FAIL (quiet diary + dead ear did not read DEAF — hollow-sense guard off)"; exit 1; }
  HOME="$td" MESH_DIR="$td/.mesh" MESH_DIARY_EAR_CMD="$earalive" "$0" --status 2>/dev/null | grep -q 'EMPTY-OK' \
    || { echo "smoke-test: FAIL (quiet diary + live ear did not read EMPTY-OK)"; exit 1; }

  # 7) GROQ-PINNED (no silent local-fallback): the prose call MUST force --pool groq so a retired pin
  #    or groq-down surfaces as the LOUD RELAY-FAILED path (case 5), never a garbled local paragraph
  #    passed off as the house's diary. Assert the relay is invoked with --pool groq. (The 2026-07-17
  #    diary-pin-dead find: llama-4-scout retired → auto-mode degraded to garbled local RU, silently.)
  printf '[21:07:00] [note3] событие для проверки пула\n' >>"$td/.mesh/room-transcript.txt"
  argrelay="$td/relay-argcheck"
  cat >"$argrelay" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' "$*" >>"$HOME/.mesh/relay-args.log"
cat >/dev/null; echo "ARGENTRY"
EOF
  chmod +x "$argrelay"
  HOME="$td" MESH_DIR="$td/.mesh" MESH_DIARY_RELAY="$argrelay" MESH_DIARY_SOURCES=room-transcript.txt \
    MESH_DIARY_QUIET=0 "$0" >/dev/null 2>&1
  grep -q -- '--pool groq' "$td/.mesh/relay-args.log" \
    || { echo "smoke-test: FAIL (prose call did not force --pool groq — silent fallover to garbled local RU still reachable)"; exit 1; }

  # 8) FOREIGN-SCRIPT GUARD (the 2026-07-20 mixed-script leak: llama-3.3-70b stochastically bled
  #    CJK/other-script tokens into RU prose — «не来了», «довольно活ым», 5+ entries in one day).
  #    A dirty render must be RETRIED once (the leak is stochastic — a re-roll is usually clean);
  #    a persistently dirty render must be SCRUBBED of foreign-script letters before it lands.
  #    Cyrillic AND Latin are legitimate (RU prose + device names like Quest 3 / note3) — only
  #    letters outside both scripts are ever noise.
  #    8a: dirty-once → retried → the CLEAN re-roll lands, zero foreign letters, exactly 2 calls.
  printf '[21:12:00] [note3] событие для проверки иероглифов\n' >>"$td/.mesh/room-transcript.txt"
  dirtyonce="$td/relay-dirty-once"
  cat >"$dirtyonce" <<'EOF'
#!/usr/bin/env bash
cat >/dev/null
n=$(( $(cat "$HOME/.mesh/dirty-calls" 2>/dev/null || echo 0) + 1 )); echo "$n" >"$HOME/.mesh/dirty-calls"
if [ "$n" = 1 ]; then echo "У нас было довольно活ым настроение, note3 говорил."
else echo "У нас было живое настроение, note3 говорил."; fi
EOF
  chmod +x "$dirtyonce"
  HOME="$td" MESH_DIR="$td/.mesh" MESH_DIARY_RELAY="$dirtyonce" MESH_DIARY_SOURCES=room-transcript.txt \
    MESH_DIARY_QUIET=0 "$0" >/dev/null 2>&1
  grep -q '活' "$df" && { echo "smoke-test: FAIL (dirty render landed — foreign-script guard off)"; exit 1; }
  grep -q 'живое настроение' "$df" || { echo "smoke-test: FAIL (clean re-roll did not land after a dirty render)"; exit 1; }
  [ "$(cat "$td/.mesh/dirty-calls" 2>/dev/null)" = 2 ] || { echo "smoke-test: FAIL (dirty render was not retried exactly once — calls=$(cat "$td/.mesh/dirty-calls" 2>/dev/null))"; exit 1; }
  #    8b: dirty-always → retried once, then SCRUBBED — foreign letters stripped, RU text kept.
  printf '[21:14:00] [note3] ещё событие для проверки скраба\n' >>"$td/.mesh/room-transcript.txt"
  dirtyalways="$td/relay-dirty-always"
  printf '#!/usr/bin/env bash\ncat >/dev/null; echo "В доме有人 сказал спасибо."\n' >"$dirtyalways"; chmod +x "$dirtyalways"
  HOME="$td" MESH_DIR="$td/.mesh" MESH_DIARY_RELAY="$dirtyalways" MESH_DIARY_SOURCES=room-transcript.txt \
    MESH_DIARY_QUIET=0 "$0" >/dev/null 2>&1
  grep -q '有人' "$df" && { echo "smoke-test: FAIL (persistently dirty render landed unscrubbed)"; exit 1; }
  grep -q 'сказал спасибо' "$df" || { echo "smoke-test: FAIL (scrub destroyed the RU text instead of stripping foreign letters)"; exit 1; }

  echo "smoke-test: ok (ingest→hold, debounced settle-flush, prune-survival, dedup, MAXHOLD ceiling, LOUD relay-fail, DEAF-vs-quiet guard, groq-pinned no-silent-fallback, foreign-script retry+scrub guard all asserted)"
  exit 0
fi

case "${1:-}" in
  --status) status_verdict;;
  --heal)   heal_ears;;
  --today)  today_file;;
  --tail)   f="$(today_file)"; [ -e "$f" ] && tail -n "${2:-40}" "$f" || echo "(no diary yet today)";;
  --json)   f="$(today_file)"; v="$(status_verdict)"
            printf '{"verdict":"%s","today":"%s","bytes":%s}\n' "${v%% *}" "$f" "$([ -e "$f" ] && stat -c%s "$f" || echo 0)";;
  ""|--run) run_once;;
  *) echo "usage: mesh-diary [--status|--heal|--tail [n]|--today|--json|--test]" >&2; exit 2;;
esac
