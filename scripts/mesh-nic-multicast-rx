#!/usr/bin/env bash
# orphan-ok: on-demand physical-NIC multicast probe; it is pulled by a sense consumer when LAN
# discovery/activity needs a direct hardware counter and is intentionally not cron-wired.
# mesh-nic-multicast-rx — cumulative multicast Ethernet frames received by physical NICs.
#
# This is a distinct signal from byte rates, drops, carrier state, and BLE presence: it exposes
# the NIC's own received-multicast counter, which reflects LAN broadcast/discovery traffic.
# Virtual interfaces are excluded. Missing or malformed physical counters are unreachable (2),
# never a fabricated zero.
set -euo pipefail
export PATH="$HOME/.local/bin:$PATH"

MESH="${MESH_DIR:-$HOME/.mesh}"
ROOT="${MESH_NIC_MULTICAST_ROOT:-/sys/class/net}"
STATE="${MESH_NIC_MULTICAST_STATE:-$MESH/.nic-multicast-rx.state}"

read_snapshot() {
  local root="${1:-$ROOT}" dir iface value total=0 interfaces=0
  shopt -s nullglob
  for dir in "$root"/*; do
    [ -d "$dir" ] || continue
    iface="${dir##*/}"
    [ -e "$dir/device" ] || [ -d "$dir/wireless" ] || continue
    [ -r "$dir/statistics/multicast" ] || continue
    value="$(tr -d '[:space:]' < "$dir/statistics/multicast" 2>/dev/null)"
    case "$value" in ''|*[!0-9]*) continue ;; esac
    total=$((total + value))
    interfaces=$((interfaces + 1))
    printf '%s|%s\n' "$iface" "$value"
  done
  shopt -u nullglob
  [ "$interfaces" -gt 0 ] || return 2
  printf 'TOTAL|%s|INTERFACES|%s\n' "$total" "$interfaces"
}

if [ "${1:-}" = --test ]; then
  td="$(mktemp -d)"
  trap 'rm -rf "$td"' EXIT
  mkdir -p "$td/net/eth0/statistics" "$td/devices/eth"
  printf '7\n' > "$td/net/eth0/statistics/multicast"
  ln -s "$td/devices/eth" "$td/net/eth0/device"
  fixture="$(MESH_NIC_MULTICAST_ROOT="$td/net" MESH_NIC_MULTICAST_STATE="$td/state" "$0" --json)"
  printf '%s\n' "$fixture" | grep -q '"multicast_frames":7' || {
    echo "smoke-test: FAIL (fixture multicast count: $fixture)"; exit 1;
  }
  MESH_NIC_MULTICAST_ROOT="$td/missing" MESH_NIC_MULTICAST_STATE="$td/missing-state" "$0" >/dev/null 2>&1 && {
    echo 'smoke-test: FAIL (missing physical NIC source must exit 2)'; exit 1;
  } || [ "$?" -eq 2 ] || {
    echo 'smoke-test: FAIL (missing physical NIC source returned the wrong exit)'; exit 1;
  }
  live="$(MESH_NIC_MULTICAST_STATE="$td/live-state" "$0" --json 2>/dev/null)" || {
    echo 'smoke-test: n/a (no readable physical multicast counter)'; exit 2;
  }
  printf '%s\n' "$live" | grep -q '"multicast_frames":[0-9]' || {
    echo "smoke-test: FAIL (REAL multicast artifact malformed: $live)"; exit 1;
  }
  echo "smoke-test: ok (fixture + unreachable exit-2 + REAL multicast counter read: $live)"
  exit 0
fi

snapshot="$(read_snapshot 2>/dev/null)" || {
  echo "mesh-nic-multicast-rx: UNREACHABLE — no physical multicast counter under $ROOT" >&2
  exit 2
}
total="$(printf '%s\n' "$snapshot" | awk -F'|' '$1=="TOTAL" {print $2; exit}')"
interfaces="$(printf '%s\n' "$snapshot" | awk -F'|' '$3=="INTERFACES" {print $4; exit}')"
[ "$total" = "${total//[^0-9]/}" ] && [ -n "$total" ] || { echo 'mesh-nic-multicast-rx: malformed total' >&2; exit 1; }
[ "$interfaces" = "${interfaces//[^0-9]/}" ] && [ -n "$interfaces" ] || { echo 'mesh-nic-multicast-rx: malformed interface count' >&2; exit 1; }
ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
mkdir -p "$(dirname "$STATE")"
printf 'label=%s|interfaces=%s|multicast_frames=%s|source=%s|ts=%s\n' \
  "$([ "$total" -gt 0 ] && printf SEEN || printf QUIET)" "$interfaces" "$total" "$ROOT" "$ts" > "$STATE"
mesh-state-touch "$STATE" >/dev/null 2>&1 || {
  echo 'mesh-nic-multicast-rx: UNREACHABLE — could not stamp live state' >&2; exit 1;
}

if [ "${1:-}" = --json ]; then
  printf '{"label":"%s","interfaces":%s,"multicast_frames":%s,"source":"%s","ts":"%s"}\n' \
    "$([ "$total" -gt 0 ] && printf SEEN || printf QUIET)" "$interfaces" "$total" "$ROOT" "$ts"
else
  printf '[nic-multicast-rx] %s — interfaces=%s multicast_frames=%s (%s)\n' \
    "$([ "$total" -gt 0 ] && printf SEEN || printf QUIET)" "$interfaces" "$total" "$ROOT"
fi
