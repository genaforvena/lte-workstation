#!/usr/bin/env bash
# reflex-cadence: 9-59/15 * * * *
# reflex-args: --edge
# mesh-gyro — the phone's GYROSCOPE sense: angular velocity around X/Y/Z.
# (Cadence offset from mesh-mag's 4-59/15 so the two phone-SSH sensor reads never stack.
# This header was MISSING until 2026-07-05 — the sense was driver-fixed (d657375) but never
# self-wired, so autowire skipped it and .gyro-state sat 9 days stale while the phone was live.)
# No existing mesh tool reads the gyroscope — body-motion uses accel (linear
# forces + gravity), not gyro (rotation rate). Gyro detects rotation that
# accel alone can miss: turning, spinning, twisting.
#
# Classification:
#   STILL    — all axes < 0.1 rad/s — phone stationary
#   MOVING   — any axis ≥ 0.1 rad/s — phone being rotated/turned
#   --json   — raw X/Y/Z rad/s values
#   --test   — smoke test (exit 2 = phone unreachable)
#
# Exit 2 on phone unreachable — never fakes a reading.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes"

THRESH="${MESH_GYRO_THRESH:-0.1}"
STATE="$HOME/.mesh/.gyro-state"
OFFLINEFILE="$HOME/.mesh/.gyro-offline"

# read_vl_gyro <ip> → echoes "gx gy gz" (3 axes) or empty + return 1. RETRIES across samplings because
# the vl_gyro termux driver is NON-DETERMINISTIC: a single -n combo intermittently returns cleanup-
# noise / an empty first object (~1-in-5 live, 2026-06-27) → "gyro parse failed" every such run → the
# state artifact goes STALE (the exact hollow-sense hole mesh-mag's read_akm09918 closed for akm09918).
# vl_gyro HANGS with -d (unlike akm09918 which NEEDS it), so the retries vary only -n. Within EACH
# attempt the parser SCANS ALL objects the -n>1 stream returns and takes the first that carries >=3
# axes (so a noisy leading object no longer wastes the whole read); across attempts it re-rolls the
# driver. Mirrors mesh-mag's multi-sampling resilience.
read_vl_gyro() {
  local _ip="$1" _out _xyz
  for _n in 2 3 2; do
    _out="$(timeout 12 ssh -p "${PHONE_SSH_PORT:-8022}" -o BatchMode=yes -o ConnectTimeout=6 \
      -o StrictHostKeyChecking=accept-new "${PHONE_USER:-u0_a380}@$_ip" \
      "timeout 8 termux-sensor -s vl_gyro -n $_n 2>/dev/null" </dev/null 2>/dev/null)" || continue
    [ -n "$_out" ] || continue
    _xyz="$(printf '%s' "$_out" | python3 -c '
import json, sys
s = sys.stdin.read().strip()
dec = json.JSONDecoder(); i = 0; out = ""
while i < len(s):
    try:
        d, j = dec.raw_decode(s[i:])
    except Exception:
        break
    v = d.get("vl_gyro", {}).get("values", [])
    if len(v) >= 3:
        out = "%s %s %s" % (v[0], v[1], v[2]); break
    i += j
    while i < len(s) and s[i] in " \n\r\t": i += 1
print(out)
' 2>/dev/null)"
    [ -n "$_xyz" ] && { printf '%s' "$_xyz"; return 0; }
  done
  return 1
}

if [ "${1:-}" = --test ]; then
  command -v python3 >/dev/null 2>&1 || { echo "smoke-test: FAIL (no python3)"; exit 1; }
  command -v sed >/dev/null 2>&1 || { echo "smoke-test: FAIL (no sed)"; exit 1; }
  command -v sort >/dev/null 2>&1 || { echo "smoke-test: FAIL (no sort)"; exit 1; }
  fail=0

  _classify() {
    local j="$1" th="${2:-0.1}"
    local gx gy gz sx sy sz max_rad still
    read -r gx gy gz <<<"$(printf '%s' "$j" | python3 -c 'import json,sys
try:
    d=json.load(sys.stdin)
    vals=d.get("vl_gyro",{}).get("values",[])
    if len(vals) >= 3:
        print(f"{vals[0]} {vals[1]} {vals[2]}")
    else:
        print("")
except:
    print("")' 2>/dev/null)"
    [ -n "${gx:-}" ] || { echo "PARSE-FAIL"; return; }
    sx="$(printf '%s' "$gx" | sed 's/^-//')"
    sy="$(printf '%s' "$gy" | sed 's/^-//')"
    sz="$(printf '%s' "$gz" | sed 's/^-//')"
    max_rad="$(printf '%s\n%s\n%s\n' "$sx" "$sy" "$sz" | sort -rn | head -1)"
    still="$(printf '%s %s' "$max_rad" "$th" | python3 -c 'import sys; a,b=sys.stdin.read().split(); print(int(float(a) < float(b)))' 2>/dev/null || echo 0)"
    [ "$still" = 1 ] && echo "STILL" || echo "MOVING"
  }

  r="$(_classify '{"vl_gyro":{"values":[0.01,0.02,0.03]}}')"
  [ "$r" = "STILL" ] || { echo "FAIL: low values → $r (expected STILL)"; fail=1; }

  r="$(_classify '{"vl_gyro":{"values":[0.15,0.02,0.03]}}')"
  [ "$r" = "MOVING" ] || { echo "FAIL: one high axis → $r (expected MOVING)"; fail=1; }

  r="$(_classify '{"vl_gyro":{"values":[0.0,0.0,0.0]}}')"
  [ "$r" = "STILL" ] || { echo "FAIL: zero → $r (expected STILL)"; fail=1; }

  r="$(_classify '{"vl_gyro":{"values":[-0.2,-0.01,-0.01]}}')"
  [ "$r" = "MOVING" ] || { echo "FAIL: negative high → $r (expected MOVING)"; fail=1; }

  r="$(_classify '{"vl_gyro":{"values":[0.1,0.0,0.0]}}')"
  [ "$r" = "MOVING" ] || { echo "FAIL: at-threshold → $r (expected MOVING, 0.1 < 0.1 false)"; fail=1; }

  r="$(_classify '{"temperature":{"values":[25]}}')"
  [ "$r" = "PARSE-FAIL" ] || { echo "FAIL: absent sensor → $r (expected PARSE-FAIL)"; fail=1; }

  r="$(_classify '{"vl_gyro":{"values":[]}}')"
  [ "$r" = "PARSE-FAIL" ] || { echo "FAIL: empty values → $r (expected PARSE-FAIL)"; fail=1; }

  if [ "$fail" = 1 ]; then echo "smoke-test: FAIL"; exit 1; fi
  # REAL-READ assertion (2026-06-26, mirror mesh-mag d657375): reachability ≠ producing. The live
  # vl_gyro read must parse to 3 axes or the sense is hollow (cron-green but no real artifact — the
  # -n 1 driver-race hole the live path just closed; this gate stops it regressing undetected).
  # vl_gyro takes NO -d (it hangs with a delay flag, unlike akm09918) — read exactly as the live path.
  source "$HOME/.local/bin/mesh-patterns.sh" 2>/dev/null || true
  if command -v phone_reachable_ip >/dev/null 2>&1; then
    phone_reachable_ip >/dev/null 2>&1 || { echo "smoke-test: n/a (phone unreachable — gyro sense unavailable); classify-logic ok"; exit 2; }
  fi
  _gpip="$(mesh-phone-ip 2>/dev/null)"
  if [ -n "$_gpip" ]; then
    # exercise the ACTUAL hardened live path (read_vl_gyro multi-attempt retry) — a single -n 2 read
    # here would itself flake ~1-in-5 and falsely report the sense hollow when it is in fact producing.
    read_vl_gyro "$_gpip" >/dev/null 2>&1 \
      || { echo "smoke-test: n/a (vl_gyro read did not yield 3 axes across samplings — sense not producing a real artifact; the hollow-sense signature); classify-logic ok"; exit 2; }
  fi
  echo "smoke-test: ok (gyro: classify + REAL vl_gyro 3-axis read via multi-sampling retry)"
  exit 0
fi

pip="$(mesh-phone-ip 2>/dev/null)" || {
    if [ ! -f "$OFFLINEFILE" ]; then echo "phone unreachable — can't read gyroscope (not an alarm)"; touch "$OFFLINEFILE"; fi
    exit 2
}
rm -f "$OFFLINEFILE"

# Multi-sampling retry (read_vl_gyro): a SINGLE -n combo intermittently races the non-deterministic
# vl_gyro driver (~1-in-5 live → "gyro parse failed" + stale state). read_vl_gyro retries across
# attempts AND scans every object in each stream for the first 3-axis read. (2026-06-27 hardening,
# same driver-race class mesh-mag's read_akm09918 already closed; replaces the lone -n 2 read.)
mag_xyz="$(read_vl_gyro "$pip")"
[ -n "$mag_xyz" ] || { if [ ! -f "$OFFLINEFILE" ]; then echo "gyro parse failed across samplings (not an alarm)"; touch "$OFFLINEFILE"; fi; exit 2; }
read -r gx gy gz <<< "$mag_xyz"

sx="$(printf '%s' "$gx" | sed 's/^-//')"
sy="$(printf '%s' "$gy" | sed 's/^-//')"
sz="$(printf '%s' "$gz" | sed 's/^-//')"

max_rad="$(printf '%s\n%s\n%s\n' "$sx" "$sy" "$sz" | sort -rn | head -1)"
still="$(printf '%s %s' "$max_rad" "$THRESH" | python3 -c 'import sys; a,b=sys.stdin.read().split(); print(int(float(a) < float(b)))' 2>/dev/null || echo 0)"
if [ "$still" = 1 ]; then
  state="STILL"; tag="[gyro-still]"
else
  state="MOVING"; tag="[gyro-moving]"
fi

if [ "${1:-}" = --json ]; then
  printf '{"state":"%s","gx_rad_s":%s,"gy_rad_s":%s,"gz_rad_s":%s,"max_rad_s":%s,"threshold":%s}\n' \
    "$state" "$gx" "$gy" "$gz" "$max_rad" "$THRESH"
  exit 0
fi

prev="$(cat "$STATE" 2>/dev/null || echo UNKNOWN)"

if [ "$state" = "STILL" ]; then
  echo STILL > "$STATE"
else
  echo MOVING > "$STATE"
fi

if [ "${1:-}" = --edge ] && [ "$prev" = "$state" ]; then
  exit 0
fi

echo "$tag ${state} — gyro (rad/s) x=${gx} y=${gy} z=${gz} (threshold ${THRESH})"
