#!/usr/bin/env bash
# orphan-ok: on-demand thermal-zone probe — the kernel already exposes the host's physical heat
#   sensors via /sys/class/thermal, but nothing in-tree currently interprets that bus directly.
#   This tool stays on-demand (no cron), so a bare orphan-ok header is the honest fit.
# mesh-thermal-zone — hottest readable kernel thermal zone on this host.
#
# Reads /sys/class/thermal/thermal_zone*/{type,temp}, selects the hottest readable zone, and
# classifies the host as COOL / WARM / HOT. A missing or unreadable thermal bus is BLIND and
# exits 2; an unreadable bus is never collapsed into a fake "cool" reading.
#
# Usage:
#   mesh-thermal-zone          one-shot human read
#   mesh-thermal-zone --json   machine-readable JSON
#   mesh-thermal-zone --test   hermetic fixture test + exit-2 reachability gate
set -u

STATE="${MESH_THERMAL_STATE:-$HOME/.mesh/.thermal-zone-state}"
mkdir -p "$(dirname "$STATE")"

thermal_dir() { printf '%s' "${MESH_THERMAL_DIR:-/sys/class/thermal}"; }

shopt -s nullglob

collect_zones() {
  local z type temp best_type="" best_temp="" best_zone="" count=0
  local dir
  dir="$(thermal_dir)"
  for z in "$dir"/thermal_zone*/; do
    [ -r "$z/type" ] || continue
    [ -r "$z/temp" ] || continue
    type="$(cat "$z/type" 2>/dev/null || true)"
    temp="$(cat "$z/temp" 2>/dev/null || true)"
    case "$temp" in
      ''|*[!0-9]*) continue ;;
    esac
    count=$((count + 1))
    if [ -z "$best_temp" ] || [ "$temp" -gt "$best_temp" ] 2>/dev/null; then
      best_temp="$temp"
      best_type="$type"
      best_zone="${z%/}"
    fi
  done
  printf '%s\t%s\t%s\t%s\n' "$count" "${best_zone##*/}" "$best_type" "${best_temp:-}"
}

classify() {
  local temp_mc="$1"
  [ -z "$temp_mc" ] && { echo BLIND; return; }
  if [ "$temp_mc" -lt 45000 ] 2>/dev/null; then
    echo COOL
  elif [ "$temp_mc" -lt 70000 ] 2>/dev/null; then
    echo WARM
  else
    echo HOT
  fi
}

fmt_c() {
  awk -v m="$1" 'BEGIN{printf "%.1f", m/1000}'
}

if [ "${1:-}" = --test ]; then
  td="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
  trap 'rm -rf "$td"' EXIT
  mkdir -p "$td/thermal_zone0" "$td/thermal_zone1" "$td/thermal_zone2"
  printf 'cpu-quiet\n' >"$td/thermal_zone0/type"
  printf '41000\n' >"$td/thermal_zone0/temp"
  printf 'cpu-hot\n' >"$td/thermal_zone1/type"
  printf '92050\n' >"$td/thermal_zone1/temp"
  printf 'camera\n' >"$td/thermal_zone2/type"
  printf 'bad\n' >"$td/thermal_zone2/temp"
  out="$(MESH_THERMAL_DIR="$td" collect_zones)"
  IFS=$'\t' read -r count zone type temp <<EOF
$out
EOF
  [ "$count" = 2 ] || { echo "smoke-test: FAIL (expected 2 readable zones, got $count)"; exit 1; }
  [ "$zone" = thermal_zone1 ] || { echo "smoke-test: FAIL (expected hottest zone1, got $zone)"; exit 1; }
  [ "$type" = cpu-hot ] || { echo "smoke-test: FAIL (expected cpu-hot, got $type)"; exit 1; }
  [ "$temp" = 92050 ] || { echo "smoke-test: FAIL (expected 92050, got $temp)"; exit 1; }
  [ "$(classify 41000)" = COOL ] || { echo "smoke-test: FAIL (41000→COOL)"; exit 1; }
  [ "$(classify 50000)" = WARM ] || { echo "smoke-test: FAIL (50000→WARM)"; exit 1; }
  [ "$(classify 92050)" = HOT ] || { echo "smoke-test: FAIL (92050→HOT)"; exit 1; }
  if [ -d /sys/class/thermal ]; then
    MESH_THERMAL_DIR="$td/nope" bash "$0" >/dev/null 2>&1
    [ $? -eq 2 ] || { echo "smoke-test: FAIL (absent thermal dir must exit 2)"; exit 1; }
  else
    echo "smoke-test: n/a (no thermal sysfs on this node)"; exit 2
  fi
  echo "smoke-test: ok (3 fixture assertions + thermal sysfs present)"
  exit 0
fi

THERMAL_DIR="$(thermal_dir)"
if [ ! -d "$THERMAL_DIR" ]; then
  echo "mesh-thermal-zone: BLIND — no thermal sysfs at $THERMAL_DIR (unreadable bus)"
  exit 2
fi

data="$(collect_zones)"
IFS=$'\t' read -r count zone type temp <<EOF
$data
EOF

[ "$count" != 0 ] || {
  echo "mesh-thermal-zone: BLIND — no readable thermal zones under $THERMAL_DIR"
  exit 2
}

label="$(classify "$temp")"
temp_c="$(fmt_c "$temp")"
ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
reason="hottest kernel thermal zone"
printf '%s|%s|%s|%s|%s\n' "$label" "$zone" "$type" "$temp_c" "$ts" >"$STATE"

if [ "${1:-}" = --json ]; then
  printf '{"label":"%s","zone":"%s","type":"%s","temp_c":%s,"zones":%s,"ts":"%s"}\n' \
    "$label" "$zone" "$type" "$temp_c" "$count" "$ts"
  exit 0
fi

printf '[thermal-zone] %s — %s %sC via %s (%s readable zones)\n' \
  "$label" "${zone:-unknown}" "$temp_c" "${type:-unknown}" "$count"
