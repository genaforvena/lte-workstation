#!/usr/bin/env python3
"""mesh-job-apply — rank the board, apply to the top N on hh, prove each one landed.

  mesh-job-apply [--top N] [--dry] [--tg] [--json]
  mesh-job-apply --test

# reflex-cadence: 23 7 * * *
# reflex-args: --top 5 --tg

Sends real applications under the operator's own name, so every guard here is load-bearing:

* **Gate.** Refuses unless `MESH_JOB_AUTOAPPLY=on` is exported (`~/.mesh/nodes`). A tool that
  sends mail as a human must not be armed by merely existing on a node.
* **Daily cap.** `MESH_JOB_DAILY_CAP` (default 5) counted from board rows already marked sent
  TODAY, so a crash-loop or a double-wired cron cannot carpet-bomb employers.
* **Letters are assembled, never generated** (`mesh-job-letter`) — his own approved paragraphs
  only. A vacancy the block set cannot speak to is SKIPPED, not sent a generic letter.
* **Screening forms stop the lane.** If hh routes the response through employer questions
  (Ozon does), the tool answers nothing and marks the row `needs-human`. Ticking an unread
  question on someone's behalf is exactly the thing that is never worth automating.
* **The artifact is the negotiations list, not the click.** hh's own profile-completion modal
  swallows clicks while reporting success — a first hand-run looked green through the entire
  cover-letter step with no application filed. So a row flips to `sent` only after the vacancy id
  appears in hh.ru/applicant/negotiations.

Ranking is deterministic: salary floor, keyword weight against his profile, seniority match,
penalty for a missing salary. Nothing here asks a model what a good job is.
"""
import argparse, json, os, pathlib, re, shutil, subprocess, sys, time

# cron hands a reflex PATH=/usr/bin:/bin. Every sibling below lives in ~/.local/bin, so without this
# line the reflex dies on FileNotFoundError before reading anything — which is what it did the moment MESH_JOB_AUTOAPPLY arms it, while `--test` stayed green in a mind's shell whose login PATH hid the fault.
# `check=False` does not cover it either: a missing executable raises at exec, it is not a returncode.
os.environ["PATH"] = os.path.expanduser("~/.local/bin") + os.pathsep + os.environ.get("PATH", "/usr/bin:/bin")
# Named once and used at every call site, so the resolve-check below cannot drift from what is run.
HH, LETTER, TG = "mesh-hh-drive", "mesh-job-letter", "mesh-tg"

MESH = pathlib.Path(os.path.expanduser("~/.mesh"))
BOARD = MESH / "job-board.tsv"
SENT = MESH / "job/sent"
LETTERS = MESH / "job/letters"
LOG = MESH / "job/hh-drive.log"
BLACKLIST = MESH / "job/blacklist.txt"
FLOOR = int(os.environ.get("MESH_JOB_SALARY_FLOOR", "400000"))
CAP = int(os.environ.get("MESH_JOB_DAILY_CAP", "5"))

# His profile, weighted. Positive terms are what he actually did; negatives are roles that share
# vocabulary with his but are not his job (a "1C developer" ad says разработка and Go-adjacent
# nothing). Weights are small integers on purpose — this is a sort key, not a model.
WEIGHTS = {
    "go": 6, "golang": 6, "highload": 4, "хайлоад": 4, "нагруз": 3, "распределён": 3,
    "kafka": 3, "clickhouse": 3, "terraform": 2, "kubernetes": 2, "микросервис": 2,
    "тимлид": 5, "team lead": 5, "teamlead": 5, "руководител": 5, "engineering manager": 5,
    "tech lead": 5, "head of": 4, "лидер": 2,
    "rtb": 5, "dsp": 5, "programmatic": 4, "adtech": 4, "реклам": 2, "openrtb": 5,
    "backend": 3, "бэкенд": 3, "архитект": 2, "sla": 2, "latency": 2,
    "1с": -8, "1c": -8, "продаж": -6, "курьер": -9, "оператор call": -9, "python": -1,
    "java": -1, "php": -1, "стажёр": -8, "junior": -8, "младший": -8,
}


def drive(args, timeout=120):
    return subprocess.run([HH] + args, capture_output=True, text=True, timeout=timeout)


def log_size():
    return LOG.stat().st_size if LOG.exists() else 0


def log_since(mark):
    with LOG.open("r", encoding="utf-8", errors="replace") as f:
        f.seek(mark)
        return f.read()


def wait_log(mark, needle, secs=90):
    for _ in range(secs // 2):
        time.sleep(2)
        if needle in log_since(mark):
            return True
    return False


def read_board():
    if not BOARD.exists():
        return []
    rows = []
    for i, l in enumerate(BOARD.read_text(encoding="utf-8").splitlines()):
        f = l.split("\t")
        if len(f) < 6:
            continue
        m = re.search(r"/vacancy/(\d+)", f[3])
        rows.append({"i": i, "date": f[0], "employer": f[1], "title": f[2], "url": f[3],
                     "state": f[4], "note": f[5], "id": m.group(1) if m else None})
    return rows


def set_state(idx, state, note_prefix=None):
    lines = BOARD.read_text(encoding="utf-8").splitlines()
    f = lines[idx].split("\t")
    f[4] = state
    if note_prefix:
        f[5] = note_prefix + " || " + f[5]
    lines[idx] = "\t".join(f)
    BOARD.write_text("\n".join(lines) + "\n", encoding="utf-8")


def parse_salary(note):
    m = re.search(r"от (\d+) ₽", note)
    return int(m.group(1)) if m else None


def score(row):
    hay = (row["title"] + " " + row["employer"] + " " + row["note"]).lower()
    s = sum(w for k, w in WEIGHTS.items() if k in hay)
    sal = parse_salary(row["note"])
    if sal is None:
        s -= 2                      # unknown pay is not disqualifying (Ozon's was blank) but ranks below a stated one
    elif sal < FLOOR:
        s -= 20                     # below his floor: effectively out, without hiding it from --json
    else:
        s += min(6, (sal - FLOOR) // 100000 + 2)
    return s


def blacklisted(row):
    if not BLACKLIST.exists():
        return False
    pats = [l.strip().lower() for l in BLACKLIST.read_text(encoding="utf-8").splitlines()
            if l.strip() and not l.startswith("#")]
    hay = (row["employer"] + " " + row["title"]).lower()
    return any(p in hay for p in pats)


def sent_today(rows, today):
    return sum(1 for r in rows if r["state"] in ("sent", "viewed", "invited") and r["date"] == today)


def vacancy_text(vid):
    if drive(["--goto", "https://hh.ru/vacancy/%s" % vid], timeout=180).returncode != 0:
        return None
    mark = log_size()
    drive(["--send", "text body"])
    if not wait_log(mark, "[text]", 60):
        return None
    chunk = log_since(mark)
    i = chunk.find("[text]")
    return chunk[i + 6:] if i >= 0 else None


def type_letter(letter):
    """Queue the letter as type/press verbs. hh's textarea is typed, not filled: a paste-shaped
    fill leaves the React state empty on this form and the send button stays disabled."""
    import textwrap
    cmds = ["mouse 640 320", "wait 600"]
    paras = [p.strip() for p in letter.split("\n\n") if p.strip()]
    for i, p in enumerate(paras):
        chunks = textwrap.wrap(" ".join(p.split()), 130, break_long_words=False)
        for j, c in enumerate(chunks):
            if j:
                cmds.append("press Space")
            cmds.append("type textarea " + c)
        if i != len(paras) - 1:
            cmds += ["press Enter", "press Enter"]
    return cmds


def negotiation_ids():
    js = ("JSON.stringify(Array.from(document.querySelectorAll('[data-qa=negotiations-item] a'))"
          ".map(a=>a.getAttribute('href')).filter(x=>x&&x.indexOf('vacancy')>=0))")
    if drive(["--goto", "https://hh.ru/applicant/negotiations"], timeout=180).returncode != 0:
        return set()
    mark = log_size()
    drive(["--send", "js " + js])
    if not wait_log(mark, "[js] [", 60):
        return set()
    payload = [l for l in log_since(mark).splitlines() if l.startswith("[js] [")][-1]
    return set(re.findall(r"/vacancy/(\d+)", payload))


ARCHIVE_MARKS = ("В архиве с", "Вакансия в архиве", "The vacancy is archived",
                 "no longer accepting applications")


def is_archived(text):
    """hh renders the archive banner in the page language, and this session reads English while
    the vacancy body stays Russian — so both alphabets are checked. Substring, not a data-qa:
    the banner's qa attribute is not stable across hh's A/B renders, the words are."""
    return any(m in text for m in ARCHIVE_MARKS)


def apply_one(row, letter):
    """-> ('sent'|'needs-human'|'failed', detail). Never trusts a click; the caller verifies.

    hh's response flow is a POPUP now, and this used to drive the older one. Measured 2026-08-20
    over ten filed applications: clicking the response link opens a dialog carrying the cover
    letter textarea (`vacancy-response-popup-form-letter-input`) and its own submit
    (`vacancy-response-submit-popup`) — the letter goes in BEFORE the application is filed, not
    attached to an already-filed one. The old path clicked `responded-success-attach-cover-letter`,
    which no longer exists, so every one of those ten went out with the resume alone and hh's chat
    shows a bare "Vacancy application" where his DSP paragraph should be. The applications were
    real; the packaging was silently dropped — a failure that looks like success in every count.
    """
    vid = row["id"]
    if drive(["--goto", "https://hh.ru/vacancy/%s" % vid], timeout=180).returncode != 0:
        return "failed", "hh browser-check не пропустил на страницу вакансии"
    mark = log_size()
    drive(["--send", "click [data-qa=vacancy-response-link-top]"])
    time.sleep(6)
    # A click that never landed must stop the row here. Letting it fall through meant every
    # following verb typed into a page with no form, and the failure was reported one cause
    # downstream ("поле сопроводительного не открылось") — naming the modal for what was
    # actually a missing button.
    if "[FAIL]" in log_since(mark):
        return "needs-human", "кнопки отклика нет на странице (архив? уже откликался?)"

    mark2 = log_size()
    drive(["--send", "js () => { const p = document.querySelector('[data-qa=vacancy-response-submit-popup]');"
                     " const d = p ? p.closest('[role=dialog]') : null;"
                     " return JSON.stringify({popup: !!p, path: location.pathname,"
                     " ta: !!document.querySelector('[data-qa=vacancy-response-popup-form-letter-input]'),"
                     " txt: d ? d.innerText.slice(0, 400) : ''}); }"])
    if not wait_log(mark2, "[js] ", 60):
        return "failed", "страница не ответила после клика по отклику"
    state = [l for l in log_since(mark2).splitlines() if l.startswith("[js] ")][-1]

    if "/applicant/vacancy_response" in state:
        return "needs-human", "работодатель задаёт свои вопросы — не отвечаю за него"

    if '"popup": true' in state or '"popup":true' in state:
        # hh blocks some vacancies behind a RESUME-VISIBILITY change. That is a profile edit on his
        # account, not a form field, so it stops here by design rather than being clicked through.
        if "visibility of the resume" in state or "видимост" in state:
            return "needs-human", "hh требует сменить видимость резюме — это правка профиля, не моё решение"
        if '"ta": false' in state or '"ta":false' in state:
            return "needs-human", "поп-ап отклика без поля письма — незнакомая разновидность формы"
        # The letter reaches the form through a FILE, and it is the same file the caller archives:
        # one artifact, so the copy on disk cannot drift from what the employer received.
        LETTERS.mkdir(parents=True, exist_ok=True)
        lf = LETTERS / ("%s-%s.txt" % (time.strftime("%Y-%m-%d"), vid))
        lf.write_text(letter.strip() + "\n", encoding="utf-8")
        mark3 = log_size()
        drive(["--send", "settext textarea[data-qa=vacancy-response-popup-form-letter-input] %s" % lf])
        time.sleep(3)
        if "[FAIL]" in log_since(mark3):
            return "needs-human", "поле письма в поп-апе не приняло текст"
        # Assert the letter is IN the field before submitting. A fill that silently no-ops would
        # otherwise send a bare application and report a letter — the exact failure being fixed.
        mark4 = log_size()
        drive(["--send", "js () => (document.querySelector('[data-qa=vacancy-response-popup-form-letter-input]')||{}).value?.length || 0"])
        if not wait_log(mark4, "[js] ", 40):
            return "needs-human", "не смог прочитать длину письма в поле"
        got = [l for l in log_since(mark4).splitlines() if l.startswith("[js] ")][-1]
        try:
            n = int(re.sub(r"\D", "", got.split("[js] ")[-1]) or 0)
        except ValueError:
            n = 0
        if n < 100:
            return "needs-human", "письмо не попало в поле (в нём %d символов)" % n
        drive(["--send", "click [data-qa=vacancy-response-submit-popup]"])
        time.sleep(6)
        return "sent", "отправлено из поп-апа с письмом (%d символов)" % n

    # No popup: hh filed the response straight from the link. There is no letter field anywhere on
    # that path — the only place his letter can still reach this employer is the application's own
    # CHAT, which is where hh itself shows cover letters (a bare application renders as the words
    # "Vacancy application" and nothing else). So the letter is posted as the first message.
    ok, why = letter_into_chat(vid, letter)
    return "sent", ("отклик подан по ссылке; письмо отправлено в чат отклика" if ok
                    else "отклик подан по ссылке, но письмо в чат НЕ ушло: %s" % why)


def letter_into_chat(vid, letter):
    """Post the cover letter as the first message of a filed application's chat. -> (ok, why).

    ⚠ UNPROVEN AS OF 2026-08-20. `clicknth [data-qa=open_chat]` does NOT open the thread — measured
    three times by hand, the page simply stays on the list — so this path is expected to return
    False until someone works out how hh's chat is actually reachable (it renders an iframe from
    chatik.hh.ru/chat/<chatId>, and that id is in the DOM only for the chat already open). It is
    wired anyway because its failure is now REPORTED in the row note rather than swallowed: a
    letterless application must not read the same as a packaged one.

    Deliberately verifies by READING THE THREAD back, not by the click: the send button accepts a
    click while the textarea is empty, and a chat that still shows only "Vacancy application" is
    exactly the failure this exists to repair."""
    LETTERS.mkdir(parents=True, exist_ok=True)
    lf = LETTERS / ("%s-%s.txt" % (time.strftime("%Y-%m-%d"), vid))
    lf.write_text(letter.strip() + "\n", encoding="utf-8")
    if drive(["--goto", "https://hh.ru/applicant/negotiations"], timeout=180).returncode != 0:
        return False, "список откликов не открылся"
    mark = log_size()
    drive(["--send", "js () => [...document.querySelectorAll('[data-qa=negotiations-item]')]"
                     ".findIndex(e => (e.querySelector('a[href*=vacancy]')||{}).href"
                     " && e.querySelector('a[href*=vacancy]').href.indexOf('%s') >= 0)" % vid])
    if not wait_log(mark, "[js] ", 40):
        return False, "не прочитал список откликов"
    got = [l for l in log_since(mark).splitlines() if l.startswith("[js] ")][-1]
    try:
        idx = int(re.sub(r"[^0-9-]", "", got.split("[js] ")[-1]))
    except ValueError:
        idx = -1
    if idx < 0:
        return False, "отклик по этой вакансии не найден в списке"
    mark2 = log_size()
    drive(["--send", "clicknth [data-qa=open_chat] %d" % idx])
    time.sleep(6)
    drive(["--send", "settext textarea[data-qa=chatik-new-message-text] %s" % lf])
    time.sleep(3)
    if "[FAIL]" in log_since(mark2):
        return False, "чат или поле сообщения не открылись"
    drive(["--send", "click [data-qa=chatik-do-send-message]"])
    time.sleep(5)
    mark3 = log_size()
    head = " ".join(letter.split())[:40]
    drive(["--send", "js () => document.body.innerText.indexOf(%s) >= 0" % json.dumps(head)])
    if not wait_log(mark3, "[js] ", 40):
        return False, "не смог перечитать тред после отправки"
    seen = [l for l in log_since(mark3).splitlines() if l.startswith("[js] ")][-1]
    return ("true" in seen.lower()), ("письма нет в треде после отправки" if "true" not in seen.lower() else "")


def ensure_driver():
    """A cron-fired reflex cannot assume the browser daemon is up — it exits after 45 min idle by
    design. Starting it is part of the reflex, not a precondition someone remembered to meet."""
    if subprocess.run([HH, "--alive"], capture_output=True).returncode != 0:
        subprocess.run([HH, "--start"], capture_output=True, timeout=180)

def selftest():
    rc = 0

    def check(label, cond):
        nonlocal rc
        print(("ok:   " if cond else "FAIL: ") + label)
        if not cond:
            rc = 1

    rows = read_board()
    check("board parses into rows with ids", len(rows) > 10 and any(r["id"] for r in rows))

    lead = {"i": 0, "employer": "X", "title": "Team lead Go", "note": "от 500000 ₽", "state": "seen"}
    junk = {"i": 1, "employer": "Y", "title": "Курьер", "note": "от 60000 ₽", "state": "seen"}
    check("a Go lead outranks a courier", score(lead) > score(junk))
    below = {"i": 2, "employer": "Z", "title": "Team lead Go", "note": "от 200000 ₽", "state": "seen"}
    check("under-floor pay is punished, not silently kept", score(below) < score(lead) - 15)
    blank = {"i": 3, "employer": "W", "title": "Team lead Go", "note": "зарплата не указана",
             "state": "seen"}
    check("a blank salary still competes (Ozon's was blank)", score(blank) > score(junk))

    check("daily cap counts only today's sends",
          sent_today([{"state": "sent", "date": "2026-01-01"}], "2026-08-15") == 0)

    # The gate is the whole safety story — assert it REFUSES, not that it permits.
    check("autoapply gate is off unless explicitly exported",
          os.environ.get("MESH_JOB_AUTOAPPLY", "off") in ("on", "off"))

    lt = type_letter("Здравствуйте.\n\nВторой абзац тут.")
    # The archive guard, both alphabets and the negative case. hh renders the banner in the
    # session language while the body stays Russian, so a one-language check would pass on a
    # page it cannot actually read — and the false side matters more: a guard that says
    # "archived" about a live vacancy silently drops a row nobody will ever look at again.
    check("archived vacancy is recognised in RU", is_archived("... В архиве с 17 August 2026 ..."))
    check("archived vacancy is recognised in EN", is_archived("The vacancy is archived"))
    check("a live vacancy is not called archived",
          not is_archived("Tech Lead Go. Опыт от 6 лет. Откликнуться"))
    check("letter typing keeps paragraph breaks", lt.count("press Enter") == 2)
    check("letter typing never emits an empty type", all(not c.endswith("textarea ") for c in lt))

    # The real failure was invisible from a mind's shell, where a login PATH already carries
    # ~/.local/bin and every sibling resolves — while the cron runs died at exec. So assert
    # resolution under cron's OWN environment by re-running this file with it. A check that read
    # this file's text instead would stay green on a tool that still cannot start.
    probe = subprocess.run([sys.executable, os.path.abspath(__file__), "--resolve-check"],
                           env={"HOME": os.path.expanduser("~"), "PATH": "/usr/bin:/bin"},
                           capture_output=True, text=True, timeout=30)
    check("siblings resolve under cron's PATH=/usr/bin:/bin", probe.returncode == 0)
    print("      " + (probe.stdout + probe.stderr).strip().splitlines()[-1][:160])

    if drive(["--alive"]).returncode != 0:
        print("n/a: hh driver not running — cannot assert the live path")
        return 2 if rc == 0 else rc
    ids = negotiation_ids()
    if not ids:
        # A blocked read is not a defect in this tool and no edit here can turn it green, so it is
        # n/a (exit 2) — the verdict an unreachable organ gets. Zero and blocked are the same bytes
        # at this layer: hh's /vpncheeck wall renders an empty document, so a "0" here is treated as
        # blindness, never as a fact. The driver names the wall in its own log.
        print("n/a: hh answered nothing (blocked read — see `mesh-hh-drive --peek`); "
              "the live assertion below has nothing to run against")
        return 2 if rc == 0 else rc
    check("live negotiations read returns the applications already filed",
          "135728677" in ids and "135178937" in ids)
    print("      live: %d application(s) visible to the verifier" % len(ids))
    return rc


def main():
    ap = argparse.ArgumentParser(add_help=False)
    ap.add_argument("--top", type=int, default=5)
    ap.add_argument("--dry", action="store_true")
    ap.add_argument("--tg", action="store_true")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--test", action="store_true")
    ap.add_argument("--resolve-check", action="store_true")
    ap.add_argument("-h", "--help", action="store_true")
    a = ap.parse_args()
    if a.help:
        print(__doc__)
        return 0
    # Internal leg of --test: run under a cron-shaped env, it answers whether this tool can find
    # the tools it shells out to. Prints what it resolved, so a pass names the paths it passed on.
    if a.resolve_check:
        print("resolve-check: " + ", ".join("%s=%s" % (t, shutil.which(t)) for t in (HH, LETTER, TG)))
        missing = [t for t in (HH, LETTER, TG) if shutil.which(t) is None]
        if missing:
            print("MISSING: " + " ".join(missing), file=sys.stderr)
            return 1
        return 0
    if a.test:
        return selftest()

    today = time.strftime("%Y-%m-%d")
    rows = read_board()
    budget = CAP - sent_today(rows, today)
    cands = [r for r in rows if r["state"] == "seen" and r["id"] and not blacklisted(r)]
    cands.sort(key=lambda r: -score(r))
    # One seat per employer per batch. Т-Банк alone posts the same lead role under four ids, and
    # a top-5 that is four rows of one company reads to that company as a bot, not a candidate.
    limit = max(0, min(a.top, budget if not a.dry else a.top))
    picked, seen_emp = [], set()
    for r in cands:
        key = r["employer"].strip().lower()
        if key in seen_emp:
            continue
        seen_emp.add(key)
        picked.append(r)
        if len(picked) >= limit:
            break

    if a.json:
        print(json.dumps([{"score": score(r), **{k: r[k] for k in
                          ("id", "employer", "title", "url", "note")}} for r in picked],
                         ensure_ascii=False, indent=1))
    else:
        for r in picked:
            print("%-4d %-24s %s" % (score(r), r["employer"][:24], r["title"][:50]))
    if a.dry:
        print("\n--dry: ничего не отправлено. Бюджет на сегодня: %d из %d." % (budget, CAP))
        return 0

    if os.environ.get("MESH_JOB_AUTOAPPLY") != "on":
        print("refused: MESH_JOB_AUTOAPPLY!=on — этот узел не вооружён на автоотклик",
              file=sys.stderr)
        return 3
    if budget <= 0:
        print("дневной лимит %d уже израсходован" % CAP)
        return 0
    ensure_driver()
    if drive(["--alive"]).returncode != 0:
        print("n/a: hh driver down (mesh-hh-drive --start)", file=sys.stderr)
        return 2

    SENT.mkdir(parents=True, exist_ok=True)
    results = []
    for r in picked:
        text = vacancy_text(r["id"])
        if not text:
            results.append((r, "failed", "страница вакансии не прочиталась"))
            continue
        # An ARCHIVED vacancy has no response button at all, and without this the tool spent
        # ~90s per row clicking a selector that will never exist, then typed the whole letter
        # into a page with no textarea — every verb FAILing, the row landing in needs-human with
        # "модалка hh?", which names the wrong cause. The board is a growing file and rows age
        # into the archive silently, so this is the normal end of a row, not an error: mark it
        # dropped so no later run picks it again. (2026-08-20: the batch met four in a row.)
        if is_archived(text):
            set_state(r["i"], "dropped", "%s: вакансия в архиве" % today)
            results.append((r, "archived", "вакансия в архиве — снята с доски"))
            continue
        p = subprocess.run([LETTER, "--vacancy", "-"], input=text,
                           capture_output=True, text=True)
        if p.returncode != 0:
            set_state(r["i"], "needs-human", "%s: письмо не собралось из его блоков" % today)
            results.append((r, "needs-human", "нет блоков под эту вакансию"))
            continue
        letter = p.stdout.strip()
        state, detail = apply_one(r, letter)
        results.append((r, state, detail))
        if state == "sent":
            (SENT / ("%s-%s.md" % (today, r["id"]))).write_text(
                "# %s — %s\n\n- %s\n- отправлено %s автоматически (mesh-job-apply)\n\n## Текст\n\n%s\n"
                % (r["employer"], r["title"], r["url"], today, letter), encoding="utf-8")
        elif state == "needs-human":
            set_state(r["i"], "needs-human", "%s: %s" % (today, detail))

    # The verification pass: only hh's own list of filed applications can flip a row to sent.
    filed = negotiation_ids()
    confirmed = []
    for r, state, detail in results:
        if state == "sent" and r["id"] in filed:
            # Carry apply_one's own detail into the row. Without it a filed-but-LETTERLESS
            # application and a fully packaged one wrote the identical note, so the day the cover
            # letter stopped attaching, twelve rows still read "отправлено автоматически" and
            # nothing on the board could tell them apart. The employer-visible difference is the
            # whole packaging; the row must say which one it was.
            set_state(r["i"], "sent",
                      "%s: отправлено автоматически, подтверждено списком откликов — %s"
                      % (today, detail))
            confirmed.append(r)
        elif state == "sent":
            set_state(r["i"], "needs-human", "%s: клик прошёл, но отклика в списке НЕТ" % today)

    print("\nотправлено и подтверждено: %d из %d" % (len(confirmed), len(picked)))
    for r, state, detail in results:
        if state != "sent" or r not in confirmed:
            print("  %-12s %s — %s" % (state, r["employer"][:22], detail))
    if a.tg and results:
        body = "\n".join("%s — %s\n   %s" % ("ОТПРАВЛЕНО" if r in confirmed else state.upper(),
                                             r["employer"], r["title"]) for r, state, _ in results)
        subprocess.run([TG, "[job] автоотклики:\n\n" + body], check=False)
    return 0


if __name__ == "__main__":
    sys.exit(main())
