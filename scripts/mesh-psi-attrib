#!/usr/bin/env bash
# orphan-ok: consumed by `mesh-psi --edge`, which OWNS this sense's interval baseline (it calls
#   `--who <axis> --advance` on its own scheduled tick). Deliberately NOT cron-wired itself: two
#   independent advancers of one baseline store each halve the other's observed interval, so every
#   reading would silently describe a window neither reflex actually spans. One writer, by design.
#
# mesh-psi-attrib — WHO is stalling. `mesh-psi` publishes an anonymous verdict ("[psi] STALLED — io
# some=49.91%"); the kernel already publishes the same quantity PER CGROUP (`{cpu,io,memory}.pressure`
# under every node of /sys/fs/cgroup, same some/full × avg10/60/300 + `total=` accumulator shape), so
# the subject is readable at zero privilege cost. 392/392 pressure files read as uid 1000 on this node.
#
#   mesh-psi-attrib                 top-N per axis, own-fraction, over the last interval
#   mesh-psi-attrib --json          machine-readable
#   mesh-psi-attrib --who <axis>    one line for mesh-psi's `who=` field (peek — does not advance)
#   mesh-psi-attrib --advance       advance the interval baseline (the scheduled edge only)
#   mesh-psi-attrib --test          smoke test (synthetic cgroup fixtures, no live read before the gate)
#
# ── THREE PROPERTIES BUILT IN, NOT DISCOVERED LATER (measured 2026-08-15, knowledge/
#    capability-cgroup-psi-names-the-stall-owner-mesh-home-20260815.md; independently reproduced by
#    health@mesh-home on its own script the same evening) ──
#
# (1) SHARES DO NOT NEST AND DO NOT SUM. PSI is the fraction of wallclock a cgroup's OWN task set was
#     stalled — not a partition of a budget. A child can, and on this node routinely does, exceed its
#     parent AND the node-wide figure: measured `system.slice/cron.service` io 23.18% > `system.slice`
#     22.00%; on a busier pass 36.06% > 35.20% > root 34.04%; memory `some` 2.47 > root 2.24. Live at
#     the moment this tool was written, io `total=`: cron.service 2400549825 > root 2302460213.
#     So this tool NEVER renders a summing breakdown. There is no "X% of the stall" anywhere in it,
#     because that number does not exist — the kernel made no such decomposition. Each row is that
#     cgroup's own fraction, labelled as such, and an inversion is ANNOTATED rather than normalised
#     away. That annotation is the load-bearing part: a renderer that decomposed could not produce it.
#     The inversion is LOAD-GATED (health@ measured a quiet 60s window in which every axis nested
#     cleanly, root > slice > service, no inversion anywhere), which is exactly why the --test fixture
#     is SYNTHETIC: a gate that sampled live would pass vacuously on any calm node.
#
# (2) THE ROOT CGROUP CARRIES NO NEW INFORMATION. /sys/fs/cgroup/{io,cpu,memory}.pressure match
#     /proc/pressure/* digit-for-digit on avg10/avg60/avg300 (confirmed on all three axes, not just
#     io). Reading the root and calling it attribution is a second rendering of the value mesh-psi
#     already prints. So the root is EXCLUDED from every attribution row; it appears only as a
#     labelled `node=` reference on the caveat line, so a reader can see a child exceed it.
#     (Do NOT compare `total=` digit-for-digit anywhere: two sequential reads skew — health@ measured
#     io 2119896649 vs 2119896865, 216us apart — so an equality gate on totals FLAPS by read order.)
#
# (3) GRANULARITY IS PART OF THE READING. `cron.service` is one cgroup shared by the WHOLE reflex
#     fleet — every autowired reflex, a dozen live `CRON -f -P` forks, the reticulum listeners — so
#     it names a fleet, never a tool. A consumer that reads it as one reflex blames the wrong thing.
#     Every row therefore carries a granularity token, and the legend spells each one out. On this
#     node the finest attribution available is "the reflex fleet vs the minds vs a named service";
#     per-reflex resolution would need the cron lines to run under `systemd-run --scope`, which they
#     do not. (In a quiet pass cron.service's io delta was 99.2% of system.slice's — for io purposes
#     system.slice IS the reflex fleet on this node.)
#
# INTERVAL, NEVER avg10 — the accumulator is present per-cgroup, so this sense is built interval-correct
# from day one and never has the narrow-window defect fe35dd9 had to fix in mesh-psi (avg10 read once
# per 600s = 1.7% coverage; .psi.state read CALM for 14.2 days on a visibly stalled node). `total=` is
# a monotonic microsecond counter; a delta between two ticks covers 100% of the interval.
# Missing evidence renders `na`, never 0: first sight, a sub-MIN_DT gap, a cgroup that did not exist
# last tick, and a cgroup whose counter went BACKWARDS (the unit restarted → the cgroup was recreated
# → its counter restarted at 0) are all EXCLUDED from the ranking, never folded in as a fabricated calm.
set -uo pipefail
export LC_ALL=C

CGROOT="${MESH_PSI_ATTRIB_CGROOT:-/sys/fs/cgroup}"
STORE_DEFAULT="${HOME:-/root}/.mesh/.psi-attrib.totals"
TOPN="${MESH_PSI_ATTRIB_TOPN:-5}"
MIN_DT="${MESH_PSI_ATTRIB_MIN_DT:-60}"   # a window shorter than this is noise, not an interval
AXES="cpu io memory"

# ── collect: every cgroup's some/full `total=` for one axis. Emits `<axis> <cgroup> <some> <full>`.
# The ROOT is emitted as cgroup `.` so property (2)'s reference value is available; the renderer
# never promotes it to an attribution row.
collect_axis() {  # $1 = cpu|io|memory
  local axis="$1"
  find "$CGROOT" -name "${axis}.pressure" -print0 2>/dev/null \
    | xargs -0 -r awk -v axis="$axis" -v rootlen="${#CGROOT}" '
        function flush(   name) {
          if (cur == "") return
          name = substr(cur, rootlen + 2)                 # strip "$CGROOT/" by LENGTH, not by regex:
                                                          # a path is not a pattern (a fixture dir under
                                                          # /tmp/claude-1000/... is full of regex chars)
          sub("/?" axis "\\.pressure$", "", name)
          if (name == "") name = "."                       # the root cgroup
          printf "%s %s %s %s\n", axis, name, (s == "" ? 0 : s), (f == "" ? 0 : f)
        }
        FILENAME != cur { flush(); cur = FILENAME; s = ""; f = "" }
        /^some/ { for (i = 1; i <= NF; i++) if ($i ~ /^total=/) { t = $i; sub("total=", "", t); s = t } }
        /^full/ { for (i = 1; i <= NF; i++) if ($i ~ /^total=/) { t = $i; sub("total=", "", t); f = t } }
        END { flush() }'
}

collect_all() { local a; for a in $AXES; do collect_axis "$a"; done; }

# ── attribute: PURE given two snapshot files + dt. Emits `<axis> <cgroup> <some_pct> <full_pct>`,
# unsorted, root included as `.`. This is the whole arithmetic of the sense, and it is a plain
# own-fraction per cgroup — there is deliberately no denominator other than the elapsed interval.
attribute() {  # $1 = prev snapshot file, $2 = cur snapshot file, $3 = dt seconds
  local prev="$1" cur="$2" dt="$3" mindt
  mindt="${MESH_PSI_ATTRIB_MIN_DT:-$MIN_DT}"      # call-time read: a load-time global would not rebind
  case "$dt" in ''|*[!0-9]*) return 0;; esac
  [ "$dt" -ge "$mindt" ] || return 0              # too short a window to mean anything → nothing, not 0s
  awk -v dt="$dt" '
    NR == FNR { if ($1 ~ /^#/) next; k = $1 SUBSEP $2; ps[k] = $3; pf[k] = $4; seen[k] = 1; next }
    {
      k = $1 SUBSEP $2
      if (!(k in seen))                    next   # no baseline (cgroup is new this tick) → na, not 0
      if ($3 + 0 < ps[k] + 0)              next   # counter went backwards: the unit restarted and its
      if ($4 + 0 < pf[k] + 0)              next   # cgroup was recreated → na, never a negative or a 0
      printf "%s %s %.2f %.2f\n", $1, $2, ($3 - ps[k]) / (dt * 1000000) * 100, ($4 - pf[k]) / (dt * 1000000) * 100
    }' "$prev" "$cur"
}

# ── granularity token (property 3). A property of the cgroup KIND, not of this node.
gran_token() {  # $1 = cgroup path
  case "$1" in
    */cron.service|cron.service) echo fleet ;;
    *.service)                   echo service ;;
    *.scope)                     echo scope ;;
    *.slice)                     echo slice ;;
    .)                           echo node ;;
    *)                           echo cgroup ;;
  esac
}

GRAN_LEGEND="fleet=one cgroup shared by EVERY cron job (the whole reflex fleet — never a single tool) · service=one unit, all its processes · scope=one transient unit · slice=an aggregate of its children, not a process"

# ── non-nesting detector (property 1). PURE: reads the attribution rows, reports every child that
# exceeds its own parent, or that exceeds the node-wide root figure. Emits one `<axis>|<child>|<child
# pct>|<parent>|<parent pct>` line per inversion. A renderer that decomposed the stall into shares
# could not produce this output at all — which is precisely why the --test asserts on it.
nonnesting() {  # stdin = attribution rows
  awk -F' ' '
    { pct[$1 SUBSEP $2] = $3; ax[NR] = $1; cg[NR] = $2; n = NR }
    END {
      for (i = 1; i <= n; i++) {
        if (cg[i] == ".") continue
        parent = cg[i]
        if (sub("/[^/]+$", "", parent) == 0) parent = "."     # a top-level cgroup: its parent IS the root
        k = ax[i] SUBSEP parent
        if (!(k in pct)) continue
        if (pct[ax[i] SUBSEP cg[i]] > pct[k] + 0.01)
          printf "%s|%s|%.2f|%s|%.2f\n", ax[i], cg[i], pct[ax[i] SUBSEP cg[i]], parent, pct[k]
      }
    }'
}

# ── snapshot plumbing ────────────────────────────────────────────────────────────────────────────
STORE="${MESH_PSI_ATTRIB_STORE:-$STORE_DEFAULT}"

load_prev_dt() {  # echoes dt seconds (0 if no usable baseline)
  local pts=""
  [ -s "$STORE" ] && pts="$(awk '$1 == "#" && $2 == "ts" { print $3; exit }' "$STORE" 2>/dev/null)"
  case "$pts" in ''|*[!0-9]*) echo 0; return;; esac
  local d=$(( $(date +%s) - pts ))
  [ "$d" -ge 0 ] 2>/dev/null || d=0        # clock stepped backwards → no trustworthy window
  echo "$d"
}

advance_store() {  # $1 = cur snapshot file
  local tmp="${STORE}.$$"
  { printf '# ts %s\n' "$(date +%s)"; cat "$1"; } > "$tmp" 2>/dev/null \
    && mv -f "$tmp" "$STORE" 2>/dev/null || rm -f "$tmp" 2>/dev/null
}

# ── --test ───────────────────────────────────────────────────────────────────────────────────────
if [ "${1:-}" = --test ]; then
  command -v awk  >/dev/null 2>&1 || { echo "smoke-test: FAIL (no awk)";  exit 1; }
  command -v find >/dev/null 2>&1 || { echo "smoke-test: FAIL (no find)"; exit 1; }
  fail() { echo "smoke-test: FAIL ($1)"; exit 1; }
  _td="$(mktemp -d)"; trap 'rm -rf "$_td"' EXIT

  # Build a synthetic cgroup tree. `some`/`full` totals in microseconds; the fixture interval is 600s,
  # so 540000000us = 90.00%.  mkfix <relpath> <axis> <some_us> <full_us>
  mkfix() {
    local d="$_td/cg/$1"; [ "$1" = . ] && d="$_td/cg"
    mkdir -p "$d"
    printf 'some avg10=0.00 avg60=0.00 avg300=0.00 total=%s\nfull avg10=0.00 avg60=0.00 avg300=0.00 total=%s\n' \
      "$3" "$4" > "$d/$2.pressure"
  }
  zero_store() {  # a baseline of all-zero totals, dated 600s ago
    { printf '# ts %s\n' "$(( $(date +%s) - 600 ))"
      for _a in cpu io memory; do
        printf '%s . 0 0\n%s system.slice 0 0\n%s system.slice/cron.service 0 0\n%s user.slice 0 0\n' "$_a" "$_a" "$_a" "$_a"
      done
    } > "$_td/store"
  }

  # ── FIXTURE A — THE INVERSION. Child (cron.service, 90%) strictly exceeds its parent
  # (system.slice, 80%) which strictly exceeds the node-wide root (50%). This is property (1)'s whole
  # claim, and it is SYNTHETIC on purpose: health@mesh-home measured a quiet 60s window in which every
  # axis nested cleanly, so a gate that sampled the live node would pass vacuously whenever nothing
  # stalls. The two rendered figures sum to 170% — a summing breakdown physically cannot emit them.
  mkfix .                          io 300000000 280000000   # root       50.00% / 46.67%
  mkfix system.slice               io 480000000 460000000   # parent     80.00% / 76.67%
  mkfix system.slice/cron.service  io 540000000 520000000   # CHILD      90.00% / 86.67%  ← exceeds both
  mkfix user.slice                 io  60000000  30000000   #            10.00% /  5.00%
  for _a in cpu memory; do mkfix . "$_a" 0 0; mkfix system.slice "$_a" 0 0; mkfix system.slice/cron.service "$_a" 0 0; mkfix user.slice "$_a" 0 0; done
  zero_store
  outA="$(MESH_PSI_ATTRIB_CGROOT="$_td/cg" MESH_PSI_ATTRIB_STORE="$_td/store" "$0" 2>&1)" \
    || fail "inverted fixture run failed: $outA"

  # The fixture's dt is wall-clock (now - store ts), so it lands on 600s ±a second or two and the
  # rendered figures are 90.00% ±0.2. Asserting the exact digits would make the gate's colour track
  # how long the suite took to get here. So assert the RELATIONS instead — they are exact, and they
  # are the actual property: an own-fraction is scale-free, a share of a total is not.
  # Scoped to an AXIS: every axis renders identically-shaped rows, so an unscoped match returns
  # whichever axis the walk emitted first (it returned cpu's 0.00 and read as "the child was rescaled").
  rowpct() { printf '%s\n' "$1" | awk -v want="$2" -v cg="$3" \
    '$2 == "node=" || $1 ~ /^(cpu|io|memory)$/ { ax = $1 } $2 == "some" && $4 == "full" && $5 == cg && ax == want { p = $1; sub("%", "", p); print p; exit }'; }
  cA="$(rowpct "$outA" io system.slice/cron.service)"; pA="$(rowpct "$outA" io system.slice)"; uA="$(rowpct "$outA" io user.slice)"
  [ -n "$cA" ] && [ -n "$pA" ] && [ -n "$uA" ] || fail "inverted fixture did not render all three rows (child=$cA parent=$pA user=$uA): $outA"
  # (1a) the own-fractions survive UNNORMALISED — ~90/~80/~10, not rescaled to anything.
  awk -v c="$cA" 'BEGIN{exit !(c > 89.5 && c < 90.5)}' || fail "child's own fraction was rescaled (got $cA, fixture is 90%): $outA"
  awk -v p="$pA" 'BEGIN{exit !(p > 79.5 && p < 80.5)}' || fail "parent's own fraction was rescaled (got $pA, fixture is 80%): $outA"
  # (1b) THE ARITHMETIC THAT ONLY AN OWN-FRACTION CAN DO: the three rendered figures sum to ~180%.
  # A summing breakdown is constrained to 100 by construction — it would have had to print 50/44/6.
  # So this single assertion cannot be satisfied by any renderer that decomposed the stall into shares.
  awk -v c="$cA" -v p="$pA" -v u="$uA" 'BEGIN{exit !(c + p + u > 150)}' \
    || fail "the rendered fractions sum to $(awk -v c="$cA" -v p="$pA" -v u="$uA" 'BEGIN{print c+p+u}')% — that is a summing breakdown, not three own-fractions: $outA"
  # (1c) ...and the child genuinely exceeds its parent in what was RENDERED, not merely in the fixture.
  awk -v c="$cA" -v p="$pA" 'BEGIN{exit !(c > p)}' || fail "the renderer clamped the child ($cA) to its parent ($pA): $outA"
  # (1c) THE GATE. The inversion must be NOTICED and named. A renderer that decomposed the stall into
  # shares of a parent could never emit this line — child>parent would have been normalised out of
  # existence upstream. This assertion going red is what "asserted property (1)" means.
  case "$outA" in *"non-nesting"*) :;; *) fail "child 90.00% > parent 80.00% went UNFLAGGED — property (1) unasserted: $outA";; esac
  # The fixture inverts at TWO depths (cron.service>system.slice AND system.slice>root); assert on the
  # DEEPER one specifically. `grep … | head -1` would have taken whichever the walk emitted first.
  _nn="$(printf '%s\n' "$outA" | grep 'non-nesting' | grep 'cron.service')"
  case "$_nn" in *"system.slice/cron.service"*EXCEEDS*"parent system.slice"*) :;; *)
    fail "the non-nesting note must name the child AND its parent: ${_nn:-<no cron.service inversion reported>}";; esac
  [ "$(printf '%s\n' "$outA" | grep -c 'non-nesting')" -ge 2 ] \
    || fail "both inversion depths must be reported (child>parent AND parent>root): $outA"
  printf '%s\n' "$_nn" | grep -qE '[0-9]+\.[0-9]+%.*EXCEEDS.*[0-9]+\.[0-9]+%' \
    || fail "the non-nesting note must carry BOTH own-fractions, so a reader can see the inversion: $_nn"
  # (2) the root is never an attribution row — it is the value mesh-psi already publishes.
  # Assert on the ROW SHAPE the renderer actually emits. The first cut of this anchored the axis name
  # at line start — attribution rows do not start with it, so the pattern could never match and the
  # gate passed a mutant that rendered the root as a row. Survived the mutation pass; caught by it.
  [ -z "$(rowpct "$outA" io .)" ] || fail "the root cgroup was rendered as an attribution row (property 2): $outA"
  [ -z "$(rowpct "$outA" cpu .)" ] || fail "the root cgroup was rendered as a cpu attribution row (property 2): $outA"
  case "$outA" in *"node="*) :;; *) fail "the node-wide reference figure must be labelled node=: $outA";; esac
  # (3) granularity is in the reading, not in a man page.
  case "$outA" in *"[fleet]"*) :;; *) fail "cron.service must carry the fleet granularity token: $outA";; esac
  case "$outA" in *"never a single tool"*) :;; *) fail "the fleet legend must spell out that it is not one tool: $outA";; esac

  # ── FIXTURE B — THE NESTING CONTROL (the other edge of the same signal). Same tree, child now
  # BELOW its parent. The note must be ABSENT. Without this, a tool that printed "non-nesting"
  # unconditionally would pass fixture A, and the gate would assert a constant instead of a property.
  # It must nest at EVERY depth, not just the leaf: the first cut of this control lowered the child
  # under system.slice but left system.slice (80%) above the root (50%), so a legitimate inversion
  # survived one level up and the control failed for the right reason. root 90 > slice 80 > svc 40.
  mkfix .                         io 540000000 520000000   # root  90.00%
  mkfix system.slice/cron.service io 240000000 120000000   # child 40.00% < parent 80.00% < root
  zero_store
  outB="$(MESH_PSI_ATTRIB_CGROOT="$_td/cg" MESH_PSI_ATTRIB_STORE="$_td/store" "$0" 2>&1)" \
    || fail "nesting fixture run failed: $outB"
  cB="$(rowpct "$outB" io system.slice/cron.service)"; pB="$(rowpct "$outB" io system.slice)"
  [ -n "$cB" ] && [ -n "$pB" ] || fail "nesting fixture did not render both rows (child=$cB parent=$pB): $outB"
  awk -v c="$cB" -v p="$pB" 'BEGIN{exit !(c > 39.5 && c < 40.5 && c < p)}' \
    || fail "nesting fixture: child should render ~40% and sit BELOW its parent (got $cB vs $pB): $outB"
  case "$outB" in *"non-nesting"*) fail "a cleanly-NESTING fixture must NOT report non-nesting — the flag is a constant, not a detector: $outB";; esac

  # ── the na paths: missing evidence is never a 0 ──
  # first sight (no store at all) → no interval, and the tool says so rather than printing zeros
  rm -f "$_td/store"
  outN="$(MESH_PSI_ATTRIB_CGROOT="$_td/cg" MESH_PSI_ATTRIB_STORE="$_td/store" "$0" 2>&1)"
  case "$outN" in *"no interval baseline"*) :;; *) fail "first sight must report no baseline, not a reading: $outN";; esac
  case "$outN" in *0.00%*) fail "first sight rendered 0.00% — a fabricated calm from missing evidence: $outN";; esac
  # sub-MIN_DT window → same
  { printf '# ts %s\n' "$(( $(date +%s) - 5 ))"; printf 'io . 0 0\nio system.slice 0 0\n'; } > "$_td/store"
  outS="$(MESH_PSI_ATTRIB_CGROOT="$_td/cg" MESH_PSI_ATTRIB_STORE="$_td/store" "$0" 2>&1)"
  case "$outS" in *"no interval baseline"*) :;; *) fail "a 5s window must not be rendered as an interval: $outS";; esac
  # a counter that went BACKWARDS (unit restarted, cgroup recreated) must drop out, not go negative
  { printf '# ts %s\n' "$(( $(date +%s) - 600 ))"
    printf 'io . 0 0\nio system.slice 0 0\nio system.slice/cron.service 999999999999 999999999999\nio user.slice 0 0\n'; } > "$_td/store"
  outR="$(MESH_PSI_ATTRIB_CGROOT="$_td/cg" MESH_PSI_ATTRIB_STORE="$_td/store" "$0" 2>&1)"
  case "$outR" in *-[0-9]*%*) fail "a reset counter produced a negative fraction: $outR";; esac
  case "$outR" in *cron.service*) fail "a cgroup whose counter reset must be EXCLUDED (na), not folded in: $outR";; esac
  case "$outR" in *"system.slice"*) :;; *) fail "the reset guard dropped the healthy siblings too: $outR";; esac

  # ── --who: the field mesh-psi consumes. Must name a subject AND its granularity, never a bare pct.
  zero_store
  mkfix system.slice/cron.service io 540000000 520000000
  outW="$(MESH_PSI_ATTRIB_CGROOT="$_td/cg" MESH_PSI_ATTRIB_STORE="$_td/store" "$0" --who io 2>&1)"
  case "$outW" in *"system.slice/cron.service"*) :;; *) fail "--who io must name the top io cgroup: $outW";; esac
  _wp="$(printf '%s' "$outW" | sed -n 's/.* \([0-9.]*\)%\[own.*/\1/p')"
  [ -n "$_wp" ] && awk -v p="$_wp" 'BEGIN{exit !(p > 89.5 && p < 90.5)}' \
    || fail "--who must carry the own-fraction (~90%, got '${_wp:-none}'): $outW"
  case "$outW" in *fleet*)   :;; *) fail "--who must carry the granularity token — a consumer reading cron.service as one tool blames the wrong thing: $outW";; esac
  case "$outW" in *own*)     :;; *) fail "--who must mark the figure as an OWN fraction, not a share: $outW";; esac
  case "$outW" in *node=*)   :;; *) fail "--who must carry the node reference — without it a window mismatch reads as a broken attribution: $outW";; esac
  outWc="$(MESH_PSI_ATTRIB_CGROOT="$_td/cg" MESH_PSI_ATTRIB_STORE="$_td/store" "$0" --who cpu 2>&1)"
  case "$outWc" in *na*) :;; *) fail "--who on an axis with no stall must be na, not a fabricated subject: $outWc";; esac
  case "$outWc" in *"not absent"*) :;; *) fail "an unattributable stall must be distinguished from an absent one: $outWc";; esac
  # --who is a PEEK: it must not advance the baseline (that would reset dt and blind the next tick)
  _before="$(cat "$_td/store")"
  MESH_PSI_ATTRIB_CGROOT="$_td/cg" MESH_PSI_ATTRIB_STORE="$_td/store" "$0" --who io >/dev/null 2>&1
  [ "$(cat "$_td/store")" = "$_before" ] || fail "--who advanced the interval baseline — the next scheduled tick is now blind"
  # --advance is the only writer, and it must actually move the store
  MESH_PSI_ATTRIB_CGROOT="$_td/cg" MESH_PSI_ATTRIB_STORE="$_td/store" "$0" --advance >/dev/null 2>&1
  [ "$(cat "$_td/store")" = "$_before" ] && fail "--advance did not write the baseline"
  grep -q '^io system.slice/cron.service 540000000 520000000$' "$_td/store" \
    || fail "--advance wrote a baseline that does not match the fixture: $(cat "$_td/store")"

  # ── json shape
  zero_store
  outJ="$(MESH_PSI_ATTRIB_CGROOT="$_td/cg" MESH_PSI_ATTRIB_STORE="$_td/store" "$0" --json 2>&1)"
  case "$outJ" in *'"non_nesting":'*)  :;; *) fail "json missing non_nesting: $outJ";; esac
  case "$outJ" in *'"granularity":'*)  :;; *) fail "json rows must carry granularity: $outJ";; esac
  case "$outJ" in *'"not_a_breakdown"'*) :;; *) fail "json must state that the fractions are not a breakdown: $outJ";; esac

  rm -rf "$_td"; trap - EXIT

  # ── the live path, gated: exercised only where cgroup v2 PSI is actually present.
  if [ -r "$CGROOT/io.pressure" ]; then
    # NOTE: capture first, THEN assert. `collect_axis io | grep -q …` makes grep exit early, awk dies
    # of SIGPIPE, and `pipefail` turns that 141 into a red gate that has nothing to do with the claim.
    _liveout="$(collect_axis io)"
    live="$(printf '%s\n' "$_liveout" | wc -l)"
    [ "$live" -ge 2 ] || fail "live collect found $live io cgroups — the walk is broken"
    case "$_liveout" in *io\ system.slice*|*io\ user.slice*) :;; *)
      fail "live collect found no non-root cgroup — no attribution possible: $_liveout";; esac
    echo "smoke-test: ok (property 1 asserted on a synthetic inversion + its nesting control, root/granularity/na/who/advance/json; live walk saw $live io cgroups)"
  else
    echo "smoke-test: ok (no cgroup v2 PSI here — fixtures asserted; live walk n/a)"
  fi
  exit 0
fi

# ── modes ────────────────────────────────────────────────────────────────────────────────────────
MODE=text; WHO_AXIS=""; ADVANCE=0
while [ $# -gt 0 ]; do
  case "$1" in
    --json)    MODE=json ;;
    --who)     MODE=who; WHO_AXIS="${2:-}"; shift ;;
    --advance) ADVANCE=1; [ "$MODE" = text ] && MODE=silent ;;
    --top)     TOPN="${2:-5}"; shift ;;
    *) echo "mesh-psi-attrib: unknown argument '$1'" >&2; exit 64 ;;
  esac
  shift
done

if [ ! -r "$CGROOT/cgroup.controllers" ] && [ ! -r "$CGROOT/io.pressure" ]; then
  case "$MODE" in
    json)   printf '{"available":false,"reason":"no cgroup v2 PSI at %s","ts":"%s"}\n' "$CGROOT" "$(date -u +%H:%M:%SZ)" ;;
    who)    printf 'na (no cgroup v2 PSI)\n' ;;
    silent) : ;;
    *)      printf '[psi-attrib] UNAVAILABLE — no cgroup v2 PSI at %s\n' "$CGROOT" ;;
  esac
  exit 2
fi

TD="$(mktemp -d)"; trap 'rm -rf "$TD"' EXIT
collect_all > "$TD/cur"
DT="$(load_prev_dt)"
[ -s "$STORE" ] || : > "$TD/prev-empty"
PREVF="$STORE"; [ -s "$PREVF" ] || PREVF="$TD/prev-empty"
attribute "$PREVF" "$TD/cur" "$DT" > "$TD/attr"

# The baseline advance happens AFTER the read is used, and only when explicitly asked. mesh-psi's
# scheduled --edge run is the single caller that asks; every other invocation is a peek.
[ "$ADVANCE" = 1 ] && advance_store "$TD/cur"
[ "$MODE" = silent ] && exit 0

TS="$(date -u +%H:%M:%SZ)"
HAVE=0; [ -s "$TD/attr" ] && HAVE=1
NONEST="$(nonnesting < "$TD/attr")"

node_pct() {  # $1 = axis → the root cgroup's own fraction (== /proc/pressure, property 2)
  awk -v a="$1" '$1 == a && $2 == "." { print $3; exit }' "$TD/attr"
}
top_rows() {  # $1 = axis → top-N non-root rows by own some-fraction
  awk -v a="$1" '$1 == a && $2 != "."' "$TD/attr" | sort -k3 -gr | head -n "$TOPN"
}

if [ "$MODE" = who ]; then
  case " $AXES " in *" $WHO_AXIS "*) :;; *) echo "na (axis '$WHO_AXIS' is not one of: $AXES)"; exit 64;; esac
  if [ "$HAVE" = 0 ]; then echo "na (no interval baseline: dt=${DT}s)"; exit 0; fi
  row="$(top_rows "$WHO_AXIS" | head -1)"
  nref="$(node_pct "$WHO_AXIS")"
  # The node reference travels WITH the answer, always. mesh-psi folds its own window (its TOTALS
  # baseline) with this one, and until both advance on the same tick they can span different
  # intervals — measured live: mesh-psi read io 8.26% over 580s while this sense's window was 98s and
  # saw 0.53%. Without node= beside the verdict, that reads as "the attribution is broken" instead of
  # "these are two windows". Publishing the reference makes the mismatch visible rather than inferable.
  if [ -z "$row" ]; then echo "na (no attributable cgroup on $WHO_AXIS; node=${nref:-na}% over ${DT}s)"; exit 0; fi
  set -- $row
  pct="$3"
  # A subject worth naming has to have actually stalled. Below the floor there is no owner to name,
  # and inventing one from the top of a list of near-zeros is a fabricated subject. Say the floor was
  # not crossed — that is a different claim from "nobody stalled", and a thinly-spread stall (no single
  # cgroup dominant) is a real state the consumer must be able to tell apart from a calm one.
  if awk -v p="$pct" 'BEGIN{exit !(p < 1)}'; then
    echo "na (no cgroup above 1% on $WHO_AXIS over ${DT}s — stall unattributable at this granularity, not absent; node=${nref:-na}%)"
    exit 0
  fi
  printf '%s %s%%[own,%s,iv%ss,node=%s%%]\n' "$2" "$pct" "$(gran_token "$2")" "$DT" "${nref:-na}"
  exit 0
fi

if [ "$MODE" = json ]; then
  {
    printf '{"available":true,"interval_s":%s,"has_interval":%s,' "$DT" "$([ "$HAVE" = 1 ] && echo true || echo false)"
    printf '"not_a_breakdown":"each figure is that cgroup OWN stalled-time fraction over the interval; shares overlap, do not sum, and a child may exceed its parent",'
    printf '"rows":['
    first=1
    for a in $AXES; do
      while read -r _ax cg ps pf; do
        [ -n "$cg" ] || continue
        [ "$first" = 1 ] || printf ','
        first=0
        printf '{"axis":"%s","cgroup":"%s","some_pct":%s,"full_pct":%s,"granularity":"%s"}' "$a" "$cg" "$ps" "$pf" "$(gran_token "$cg")"
      done <<EOF
$(top_rows "$a")
EOF
    done
    printf '],"node_reference":{'
    firstn=1
    for a in $AXES; do
      n="$(node_pct "$a")"; [ -n "$n" ] || continue
      [ "$firstn" = 1 ] || printf ','
      firstn=0
      printf '"%s":%s' "$a" "$n"
    done
    printf '},"non_nesting":['
    firstx=1
    printf '%s\n' "$NONEST" | while IFS='|' read -r ax child cpct parent ppct; do
      [ -n "$ax" ] || continue
      [ "$firstx" = 1 ] || printf ','
      firstx=0
      printf '{"axis":"%s","child":"%s","child_pct":%s,"parent":"%s","parent_pct":%s}' "$ax" "$child" "$cpct" "$parent" "$ppct"
    done
    printf '],"ts":"%s"}\n' "$TS"
  }
  exit 0
fi

# ── text ──
if [ "$HAVE" = 0 ]; then
  printf '[psi-attrib] no interval baseline (dt=%ss — first sight, a reset, or below the %ss floor). No attribution rendered: an own-fraction with no baseline would be a fabricated 0, not a calm cgroup.\n' \
    "$DT" "${MESH_PSI_ATTRIB_MIN_DT:-$MIN_DT}"
  exit 0
fi

printf '[psi-attrib] interval=%ss (total= delta — 100%% coverage, not an avg10 sample) | each %% is that cgroup'"'"'s OWN stalled time, NOT a share of the node: they overlap, do not sum, and a child may exceed its parent.\n' "$DT"
for a in $AXES; do
  rows="$(top_rows "$a")"
  [ -n "$rows" ] || continue
  n="$(node_pct "$a")"
  printf '  %-6s node=%s%% (the figure mesh-psi already publishes — a reference, never a total)\n' "$a" "${n:-na}"
  printf '%s\n' "$rows" | while read -r _ax cg ps pf; do
    [ -n "$cg" ] || continue
    printf '         %7s%% some  %7s%% full  %-34s [%s]\n' "$ps" "$pf" "$cg" "$(gran_token "$cg")"
  done
done
if [ -n "$NONEST" ]; then
  # printf '%s\n', never '%s': $(...) already stripped the trailing newline, so the un-terminated
  # final record makes `read` return non-zero and the LAST inversion is silently dropped — which is
  # exactly the deepest one (a leaf exceeding its parent), the finding this whole tool exists for.
  printf '%s\n' "$NONEST" | while IFS='|' read -r ax child cpct parent ppct; do
    [ -n "$ax" ] || continue
    [ "$parent" = "." ] && parent="the node-wide root (== /proc/pressure/$ax)"
    printf '  non-nesting (%s): %s %s%% EXCEEDS its parent %s %s%% — expected, not a bug: PSI is a per-task-set stalled-time fraction, not a partition.\n' \
      "$ax" "$child" "$cpct" "$parent" "$ppct"
  done
fi
printf '  granularity: %s\n' "$GRAN_LEGEND"
