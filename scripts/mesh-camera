#!/usr/bin/env bash
# mesh-camera — on-demand still capture from this node's webcam → a real JPEG artifact.
# The camera was "hollow" (device present, no system capture tool) until we found the bundled
# imageio_ffmpeg ffmpeg can grab a v4l2 frame without sudo/install. This makes the visual sense REAL.
#
#   mesh-camera [out.jpg]   capture one frame (default ~/.mesh/cam/last.jpg)
#   mesh-camera --test      smoke test (device + a working capture path)
#
# Honest organ: only declared because capture produces a real non-zero JPEG (see mesh-doctor camera
# check). Single still on demand — NOT a continuous feed. On owned/authorized nodes per operator.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
CAM="${MESH_CAM:-/dev/video0}"
OUT="${1:-$HOME/.mesh/cam/last.jpg}"

# resolve a capture binary: bundled imageio_ffmpeg (no install needed) → system ffmpeg → fswebcam
ffbin(){ python3 -c 'import imageio_ffmpeg;print(imageio_ffmpeg.get_ffmpeg_exe())' 2>/dev/null \
         || command -v ffmpeg 2>/dev/null; }
have_capture(){ [ -e "$CAM" ] && { [ -n "$(ffbin)" ] || command -v fswebcam >/dev/null 2>&1; }; }

if [ "${1:-}" = --test ]; then
  [ -e "$CAM" ] || { echo "smoke-test: FAIL (no camera device $CAM)"; exit 1; }
  have_capture || { echo "smoke-test: FAIL (camera present but no capture path: bundled/system ffmpeg or fswebcam)"; exit 1; }
  echo "smoke-test: ok"; exit 0
fi

[ -e "$CAM" ] || { echo "mesh-camera: no camera at $CAM" >&2; exit 1; }
mkdir -p "$(dirname "$OUT")"
FF="$(ffbin)"
if [ -n "$FF" ]; then
  "$FF" -nostdin -loglevel error -f v4l2 -i "$CAM" -frames:v 1 -y "$OUT" 2>/dev/null
elif command -v fswebcam >/dev/null 2>&1; then
  fswebcam -d "$CAM" -r 1280x720 --no-banner "$OUT" >/dev/null 2>&1
fi
if [ -s "$OUT" ]; then
  echo "mesh-camera: captured $(stat -c%s "$OUT") bytes -> $OUT"
else
  echo "mesh-camera: capture FAILED (device busy or no frame)" >&2; exit 1
fi
