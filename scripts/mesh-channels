#!/usr/bin/env bash
# mesh-channels — instantiate the CHANNEL-SET from ~/.mesh/streams.conf (operator's converged design,
# 2026-06-13: EVERY data+mind window is a mesh-stream instance  state-fn -> mesh-delta -> mind; NO
# special-cased windows). One pull->delta->feed per channel per call — cron-driven, so each tick feeds a
# mind ONLY when its state changed (mesh-delta seeds silent + emits on change; mesh-stream edge-dedups).
# Purely ADDITIVE: composes mesh-stream + mesh-delta, touches no substrate (mesh-restore/-stream/-dash).
# The mon:<name> display window is suppressed (NODISPLAY) — the data already lives in the channel pane.
#
#   streams.conf line:  name | state-fn (the PULL, a shell cmd) | mind-window [| filter]
#   the FILTER defaults to `mesh-delta <name>` (the uniform significance gate). An OPTIONAL 4th field
#   overrides it with a bespoke filter (any cmd: stdin=pull output, stdout=the prompt to feed, empty=skip)
#   — this is what lets the hand-written cron streams (conn/isp/novelty/...) fold into ONE config instead
#   of N special-cased crontab lines (the operator's "no special-casing; everything from the primitive").
#   Backward-compatible: a 3-field line keeps the mesh-delta default.
#
#   mesh-channels         tick every configured channel (instantiate / feed-on-delta)
#   mesh-channels --list  show the channel-set
#   mesh-channels --test  smoke
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
CONF="${MESH_STREAMS_CONF:-$HOME/.mesh/streams.conf}"

if [ "${1:-}" = --test ]; then
  for x in mesh-stream mesh-delta mktemp sed xargs; do
    command -v "$x" >/dev/null 2>&1 || { echo "smoke-test: FAIL (no $x)"; exit 1; }
  done
  tmp="$(mktemp)" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }; trap 'rm -f "$tmp"' EXIT
  printf '# a comment\n\nx | echo hi | plan\ny | echo yo | dev | grep -qE "a|b" && echo fire\n' > "$tmp"
  n=$(MESH_STREAMS_CONF="$tmp" "$0" --list 2>/dev/null | grep -cE '^[xy] ') || true
  [ "$n" = 2 ] || { echo "smoke-test: FAIL (parse: expected 2 channels, got $n)"; exit 1; }
  MESH_STREAMS_CONF="$tmp" "$0" --list 2>/dev/null | grep -q 'mind:plan' || { echo "smoke-test: FAIL (mind not parsed)"; exit 1; }
  # 3-field line x → filter defaults to mesh-delta; 4-field line y → bespoke filter with a LITERAL pipe honored (greedy)
  MESH_STREAMS_CONF="$tmp" "$0" --list 2>/dev/null | grep -q 'filter: mesh-delta x' || { echo "smoke-test: FAIL (default filter not applied)"; exit 1; }
  MESH_STREAMS_CONF="$tmp" "$0" --list 2>/dev/null | grep -q 'filter: grep -qE "a|b" && echo fire' || { echo "smoke-test: FAIL (greedy piped filter truncated/not parsed)"; exit 1; }
  echo "smoke-test: ok"; exit 0
fi

[ -f "$CONF" ] || { echo "mesh-channels: no config at $CONF" >&2; exit 1; }

# parse config → tab-separated  name<TAB>pull<TAB>mind<TAB>filter  (skip blank + #comment lines).
# filter defaults to `mesh-delta <name>` when absent/empty (backward-compatible). filter is the GREEDY
# last field — it keeps any literal `|` (real filters pipe + use `|` in regexes, e.g. grep "a|b") instead
# of the delimiter truncating them. So: name | pull | mind | filter-may-contain | pipes-freely.
parse() {
  while IFS='|' read -r name pull mind filter; do
    name="$(echo "$name" | xargs 2>/dev/null)"; [ -z "$name" ] && continue
    case "$name" in \#*) continue;; esac
    pull="$(echo "$pull" | sed 's/^ *//;s/ *$//')"
    mind="$(echo "$mind" | xargs 2>/dev/null)"; [ -z "$mind" ] && mind=plan
    filter="$(echo "$filter" | sed 's/^ *//;s/ *$//')"; [ -z "$filter" ] && filter="mesh-delta $name"
    printf '%s\t%s\t%s\t%s\n' "$name" "$pull" "$mind" "$filter"
  done < "$CONF"
}

if [ "${1:-}" = --list ]; then
  parse | while IFS=$'\t' read -r name pull mind filter; do
    printf '%s  ->  mind:%s   [pull: %s | filter: %s]\n' "$name" "$mind" "$pull" "$filter"
  done
  exit 0
fi

# Rate-limit fallback routing: when a channel's target mind is RATE-LIMITED,
# route to the first idle worker in MESH_RATE_FALLBACK (colon-sep window names).
# Allows alerts to reach a live mind even when the primary planner is cooling down.
MESH_RATE_FALLBACK="${MESH_RATE_FALLBACK:-dev:discover:sense}"
_target_mind() { # $1=desired mind → stdout=routed mind (fallback if rate-limited)
  local want="$1" state
  state="$(mesh-mind-state "$want" 2>/dev/null | grep -oE 'WORKING|IDLE|RATE-LIMITED|DEAD' | head -1)"
  if [ "$state" = "RATE-LIMITED" ]; then
    local fb; IFS=':' read -ra _FBs <<< "$MESH_RATE_FALLBACK"
    for fb in "${_FBs[@]}"; do
      [ "$fb" = "$want" ] && continue
      local fb_state; fb_state="$(mesh-mind-state "$fb" 2>/dev/null | grep -oE 'WORKING|IDLE|RATE-LIMITED|DEAD' | head -1)"
      if [ "$fb_state" = "IDLE" ]; then printf '%s' "$fb"; return; fi
    done
  fi
  printf '%s' "$want"
}

# tick every channel: state-fn -> filter -> mind  (display suppressed; data already lives in the pane)
parse | while IFS=$'\t' read -r name pull mind filter; do
  target="$(_target_mind "$mind")"
  [ "$target" != "$mind" ] && printf '[%s] routing to %s (plan is rate-limited)\n' "$name" "$target"
  MESH_STREAM_NODISPLAY=1 mesh-stream "$name" "$pull" "$filter" "$target" 2>&1 | sed "s/^/[$name] /" || true
done
