#!/usr/bin/env bash
# mesh-channels — instantiate the CHANNEL-SET from ~/.mesh/streams.conf (operator's converged design,
# 2026-06-13: EVERY data+mind window is a mesh-stream instance  state-fn -> mesh-delta -> mind; NO
# special-cased windows). One pull->delta->feed per channel per call — cron-driven, so each tick feeds a
# mind ONLY when its state changed (mesh-delta seeds silent + emits on change; mesh-stream edge-dedups).
# Purely ADDITIVE: composes mesh-stream + mesh-delta, touches no substrate (mesh-restore/-stream/-dash).
# The mon:<name> display window is suppressed (NODISPLAY) — the data already lives in the channel pane.
#
#   streams.conf line:  name | state-fn (the PULL, a shell cmd) | mind-window [| filter]
#   the FILTER defaults to `mesh-delta <name>` (the uniform significance gate). An OPTIONAL 4th field
#   overrides it with a bespoke filter (any cmd: stdin=pull output, stdout=the prompt to feed, empty=skip)
#   — this is what lets the hand-written cron streams (conn/isp/novelty/...) fold into ONE config instead
#   of N special-cased crontab lines (the operator's "no special-casing; everything from the primitive").
#   Backward-compatible: a 3-field line keeps the mesh-delta default.
#
#   mesh-channels         tick every configured channel (instantiate / feed-on-delta)
#   mesh-channels --list  show the channel-set
#   mesh-channels --test  smoke
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
CONF="${MESH_STREAMS_CONF:-$HOME/.mesh/streams.conf}"

if [ "${1:-}" = --test ]; then
  for x in mesh-stream mesh-delta mktemp sed xargs; do
    command -v "$x" >/dev/null 2>&1 || { echo "smoke-test: FAIL (no $x)"; exit 1; }
  done
  tmp="$(mktemp)" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }; trap 'rm -f "$tmp"' EXIT
  printf '# a comment\n\nx | echo hi | plan\ny | echo yo | dev | grep -qE "a|b" && echo fire\n@hb minds plan\n' > "$tmp"
  n=$(MESH_STREAMS_CONF="$tmp" "$0" --list 2>/dev/null | grep -cE '^[xy] ') || true
  [ "$n" = 2 ] || { echo "smoke-test: FAIL (parse: expected 2 edge channels, got $n)"; exit 1; }
  MESH_STREAMS_CONF="$tmp" "$0" --list 2>/dev/null | grep -q 'mind:plan' || { echo "smoke-test: FAIL (mind not parsed)"; exit 1; }
  MESH_STREAMS_CONF="$tmp" "$0" --list 2>/dev/null | grep -q '@hb minds' || { echo "smoke-test: FAIL (@hb heartbeat line not parsed / leaked into edge channels)"; exit 1; }
  # 3-field line x → filter defaults to mesh-delta; 4-field line y → bespoke filter with a LITERAL pipe honored (greedy)
  MESH_STREAMS_CONF="$tmp" "$0" --list 2>/dev/null | grep -q 'filter: mesh-delta x' || { echo "smoke-test: FAIL (default filter not applied)"; exit 1; }
  MESH_STREAMS_CONF="$tmp" "$0" --list 2>/dev/null | grep -q 'filter: grep -qE "a|b" && echo fire' || { echo "smoke-test: FAIL (greedy piped filter truncated/not parsed)"; exit 1; }
  echo "smoke-test: ok"; exit 0
fi

[ -f "$CONF" ] || { echo "mesh-channels: no config at $CONF" >&2; exit 1; }

# parse config → tab-separated  name<TAB>pull<TAB>mind<TAB>filter  (skip blank + #comment lines).
# filter defaults to `mesh-delta <name>` when absent/empty (backward-compatible). filter is the GREEDY
# last field — it keeps any literal `|` (real filters pipe + use `|` in regexes, e.g. grep "a|b") instead
# of the delimiter truncating them. So: name | pull | mind | filter-may-contain | pipes-freely.
# parse EDGE config → tab-separated  name<TAB>pull<TAB>mind<TAB>filter  (skip blank, #comment, and @hb
# heartbeat lines — those are handled separately). filter defaults to `mesh-delta <name>` when absent;
# filter is the GREEDY last field — keeps literal `|` (real filters pipe + use `|` in regexes).
parse() {
  while IFS='|' read -r name pull mind filter; do
    name="$(echo "$name" | xargs 2>/dev/null)"; [ -z "$name" ] && continue
    case "$name" in \#*|@hb|@hb\ *) continue;; esac
    pull="$(echo "$pull" | sed 's/^ *//;s/ *$//')"
    mind="$(echo "$mind" | xargs 2>/dev/null)"; [ -z "$mind" ] && mind=plan
    filter="$(echo "$filter" | sed 's/^ *//;s/ *$//')"; [ -z "$filter" ] && filter="mesh-delta $name"
    printf '%s\t%s\t%s\t%s\n' "$name" "$pull" "$mind" "$filter"
  done < "$CONF"
}

# parse HEARTBEAT lines:  @hb <window> <role> [min]  (space-separated, no pipes) → window<TAB>role<TAB>min.
# A heartbeat is a self-continuation TICK — delegated to mesh-tick-adapt (idle-gates + P-controller cadence,
# and crucially RE-feeds each cycle, which mesh-stream's edge-dedup cannot do). This is what gives an idle
# mind whose source never changes a reason to keep going — the "where's my tick" guarantee, per channel.
parse_hb() {
  while read -r tag win role _min _rest; do
    [ "$tag" = "@hb" ] && [ -n "${win:-}" ] && printf '%s\t%s\n' "$win" "${role:-}"
  done < "$CONF"
}

if [ "${1:-}" = --list ]; then
  parse | while IFS=$'\t' read -r name pull mind filter; do
    printf '%s  ->  mind:%s   [pull: %s | filter: %s]\n' "$name" "$mind" "$pull" "$filter"
  done
  parse_hb | while IFS=$'\t' read -r win role; do
    printf '@hb %s  ->  heartbeat tick (role:%s)\n' "$win" "${role:-default}"
  done
  exit 0
fi

# state of a mind window (field 1 of mesh-mind-state): WORKING|NEEDS-INPUT|RATE-LIMITED|IDLE|DEAD
_mind_state() { mesh-mind-state "$1" 2>/dev/null | grep -oE 'WORKING|NEEDS-INPUT|RATE-LIMITED|IDLE|DEAD' | head -1; }

# Rate-limit fallback routing: when a channel's target mind is RATE-LIMITED, route the edge feed to the
# first IDLE worker in MESH_RATE_FALLBACK so an alert still reaches a live mind while the primary cools.
MESH_RATE_FALLBACK="${MESH_RATE_FALLBACK:-genome:senses:health}"
_target_mind() {
  local want="$1" state; state="$(_mind_state "$want")"
  if [ "$state" = "RATE-LIMITED" ]; then
    local fb; IFS=':' read -ra _FBs <<< "$MESH_RATE_FALLBACK"
    for fb in "${_FBs[@]}"; do
      [ "$fb" = "$want" ] && continue
      [ "$(_mind_state "$fb")" = "IDLE" ] && { printf '%s' "$fb"; return; }
    done
  fi
  printf '%s' "$want"
}

# SINGLE-WRITER guard: this driver SERIALIZES many slow mesh-mind-state pane-samples, so a tick can run
# tens of seconds. A non-blocking lock makes an overlapping cron run SKIP rather than pile up (the
# mesh-doctor --quiet pile-up lesson). --test/--list above run lock-free.
exec 9>"$HOME/.mesh/.channels.lock" 2>/dev/null || true
flock -n 9 2>/dev/null || { echo "mesh-channels: another tick in progress — skip"; exit 0; }

# 1) HEARTBEAT channels first — self-continuation tick (tick-adapt idle-gates + paces itself, logs to tick.log).
# DETACH each: mesh-tick FOREGROUND-sleeps on its empty/fast-tick backoff (up to MESH_TICK_SLOW_SLEEP=300s),
# which would block this serial driver AND hold the single-writer lock for 5 minutes. Run backgrounded with
# the lock fd (9) CLOSED so the sleep holds neither; and set SLOW_SLEEP=0 since the cron cadence already paces.
parse_hb | while IFS=$'\t' read -r win role; do
  ( exec 9>&-; MESH_TICK_SLOW_SLEEP=0 mesh-tick-adapt local "$win" "${role:-}" >> "$HOME/.mesh/tick.log" 2>&1 ) &
  echo "[@hb $win] tick-adapt(role=${role:-default}) [detached]"
done

# 2) EDGE channels — feed the mind on a significant source change. IDLE-GATE centrally: NEVER inject into a
# WORKING mind (corrupts its turn) or a NEEDS-INPUT mind (a permission gate → leave it to gate-watch/operator).
# The edge is simply caught on the next idle tick — mesh-delta only advances its seen-state when we run it.
parse | while IFS=$'\t' read -r name pull mind filter; do
  st="$(_mind_state "$mind")"
  case "$st" in WORKING|NEEDS-INPUT) echo "[$name] skip — $mind is $st (don't interrupt)"; continue;; esac
  target="$(_target_mind "$mind")"
  [ "$target" != "$mind" ] && printf '[%s] routing to %s (%s rate-limited)\n' "$name" "$target" "$mind"
  rst="$(_mind_state "$target")"; case "$rst" in WORKING|NEEDS-INPUT) echo "[$name] skip — routed $target is $rst"; continue;; esac
  MESH_STREAM_NODISPLAY=1 mesh-stream "$name" "$pull" "$filter" "$target" 2>&1 | sed "s/^/[$name] /" || true
done
