#!/usr/bin/env bash
# reflex-cadence: */5 * * * *
# reflex-state: $HOME/.mesh/.mlme-tap.state
# (Declared so mesh-reflex-health DERIVES us into its watch table. The state is touched on EVERY
#  successful eval — liveness-touch convention — so a node whose radio is quiet for days does not
#  read as a dead reflex. The state line leads with the VERDICT and the stamp rides in an `at=`
#  field, for the same reason mesh-route-events does: a field 1 that is a clock defeats BOTH
#  frozen-value axes at once. Do not put the stamp back in front.)
#
# mesh-mlme-tap — the nl80211 MLME frame-plane tap: who threw the link away, why, and WHEN.
#
# WHY THIS EXISTS. `mesh-link-heal` POLLS `iw link` at TICK=60. A poll can only ever say "it was
# down when I looked", and three things follow that no faster poll fixes honestly:
#   · An episode briefer than one tick is INVISIBLE. Measured 2026-08-26T16:20:48-16:47:08Z with a
#     2s sampler beside the live tool: FIVE not-associated episodes, link-heal logged TWO. 60% of
#     episodes unrecorded, and the survivors are biased LONG by exactly the same cut — so the
#     RECOVERED count CLAUDE.local.md quotes as the honest dongle-fault axis is a FLOOR on episode
#     COUNT, and the median dark it reports is the STRIDE, not the fault.
#     [[an-events-duration-under-the-poll-period-is-invisible-to-the-poller]]
#   · A poller cannot date the DEATH, only the recovery. link-heal's own rows say so: "lower bound,
#     window=5s/60s".
#   · A poller cannot name the DIRECTION. "The AP threw us off" and "our dongle gave up" render
#     identically to `iw link`, and CLAUDE.local.md has carried that as an open question with no
#     instrument at all. The frame plane answers it in one field.
#     [[the-ap-deauths-us-reason-6-not-our-dongle-giving-up]]
#
# The nl80211 mlme multicast group carries every AUTHENTICATE/ASSOCIATE/DEAUTHENTICATE/DISASSOCIATE/
# CONNECT/ROAM/DISCONNECT the kernel raises, with the raw management frame attached, and it is
# readable at uid 1000 with no CAP_NET_ADMIN (discover@mesh-home 2026-08-26, verified independently
# by health@ the same hour and by this window's own 26-minute capture).
#
# THIS IS A SENSE, NOT AN ACTUATOR. Re-association stays the driver's job and the recovery ladder
# stays mesh-link-heal's. This tool installs nothing, heals nothing, and touches no radio: it only
# listens. It must never be given an actuator — the ladder must not be driven off a firehose.
#
# THE TRAPS IT IS BUILT AROUND, every one of them already paid for on this node:
#
#   1. A SILENTLY-UNSUBSCRIBED LISTENER RENDERS IDENTICALLY TO A QUIET RADIO. So the subscription is
#      never inferred from what we asked for: it is read back out of /proc/net/netlink for the
#      listener's OWN socket, matched by INODE, and a listener whose mlme bit is not set REFUSES to
#      listen rather than wearing `up`. Same shape as [[a-declared-pref-is-not-the-fib]] and
#      [[a-mode-bit-is-not-the-write]].
#
#   2. /proc/net/netlink `Groups` IS FIELD 4 AND `Drops` IS FIELD 9. health@ read field 6 first and
#      got 0x00000000 off a socket that was delivering six groups' events — and a wrong column
#      FAILS TOWARD FALSE-ABSENCE, it does not error.
#      [[proc-net-netlink-groups-is-field-4-and-a-wrong-column-reads-as-no-subscription]]
#      The socket is matched by the INODE, never the `Pid` column: that column is the netlink
#      PORTID, which only DEFAULTS to the pid and is autobound to a large random value when the pid
#      is taken. This node's table carries such rows right now.
#
#   3. FRAME BYTE OFFSET 24 IS A REASON CODE ONLY FOR SUBTYPE 12 (deauth) AND 10 (disassoc). On an
#      Action frame the same two bytes are category|action and yield a PLAUSIBLE reason with no
#      error at all. We decode subtype-aware, render `reason=na` on every other subtype, and log the
#      raw framehex so a wrong decode is always re-checkable from the tape.
#      [[a-fixed-field-offset-is-valid-for-one-message-type-only]]
#
#   4. A NARROW SUBSCRIPTION, AND THE Drops COLUMN PUBLISHED BESIDE THE COUNT. ENOBUFS loses
#      netlink messages with NO error on the stream, so a dropped deauth reads exactly like no
#      deauth. We join `mlme` ONLY — never `all`, which on this node's LAN drowns the signal — and
#      every reading carries the socket's Drops delta as a coverage term.
#
#   5. THE COMMAND NUMBERS ARE DERIVED FROM THE KERNEL HEADER, NOT PINNED. The hand-written table in
#      the probe this tool grew out of had FRAME=60 / FRAME_TX_STATUS=61; the header says 59 / 60,
#      because `NL80211_CMD_REGISTER_ACTION = NL80211_CMD_REGISTER_FRAME` and `NL80211_CMD_ACTION =
#      NL80211_CMD_FRAME` are ALIASES that do not advance the counter and are easy to count as if
#      they did. Nine other values in that table were right, which is exactly why the two wrong ones
#      would have survived: every FRAME event would have been labelled FRAME_TX_STATUS, silently.
#      We parse `enum nl80211_commands` / `enum nl80211_attrs` out of the header, fall back to the
#      pinned pair only with the SOURCE NAMED in every reading, and --test asserts the derivation.
#
#   6. A LIVE TAP HAS NO HISTORY. Absence before start-of-listen is UNKNOWN, never zero.
#      [[absence-from-a-bounded-cache-is-unknown-never-down]]
#
# THE TWO CROSS-CHECKS AGAINST mesh-link-heal, AND WHY THEY POINT OPPOSITE WAYS. link-heal's
# RECOVERED tape is an independent witness of the same fault, so a disagreement is information —
# but which instrument it indicts depends on the SIGN:
#   · link-heal logged a RECOVERED and this tap named NO loss event in a window it claims it covered
#     fully  ->  verdict GAP (rc 2): distrust THIS tap. The episode demonstrably happened.
#     The look-back is extended by HEAL_LAG first, because a RECOVERED row is written at the CLOSE
#     of an episode whose opening deauth is up to (dark + TICK) older — a window boundary between
#     the two would otherwise make this arm accuse itself.
#     [[a-self-distrust-arm-must-look-back-past-its-own-remedys-latency]]
#   · this tap named loss events that link-heal never logged  ->  that is NOT a gap, it is the
#     MEASUREMENT the tick60 task asked for, published as `unlogged=`. It is the expected sign.
#
# NEVER PROVOKE A DISCONNECT TO TEST THIS. The dongle is this node's sole uplink and forcing one is
# self-defeating by the CLAUDE.md gate — you would sever the channel the rollback runs over. It
# fires unaided every few minutes; wait for it.
#
#   mesh-mlme-tap             ensure the listener, one read pass: emit, board, advance the baseline
#   mesh-mlme-tap --check     read-only: same reading, no ensure, no write, no board post
#   mesh-mlme-tap --status    the last reading, no new read
#   mesh-mlme-tap --coverage  the coverage terms alone (mlme bit + drops + listener age)
#   mesh-mlme-tap --tail [N]  the last N events (default 20)
#   mesh-mlme-tap --derive    the header-derived command/attr numbers and their source
#   mesh-mlme-tap --episode <start-epoch> <end-epoch>
#                             for a window a POLLER names: how many MLME loss episodes really
#                             happened in it and how long the association was really down, with this
#                             tap's own coverage travelling beside the numbers. Consumed by
#                             mesh-link-heal, whose 60s cadence cannot produce either number.
#                             rc 0 = covered, no episode · 1 = covered, episodes named · 2 = the
#                             window is not covered, so every field is na and coverage says why
#   mesh-mlme-tap --daemon    the listener itself (foreground; refuses to double-start)
#   mesh-mlme-tap --ensure    start the listener if none holds the lock
#   mesh-mlme-tap --stop      stop the listener
#   mesh-mlme-tap --test      fixtures + a REAL listener asserted against the kernel's own tables
#
# exit 0 = QUIET (listening, fully covered, no MLME loss event) · 1 = EVENTS (loss events named) ·
# 2 = honest UNKNOWN (listener down, unsubscribed, drops, an uncovered window, or GAP vs link-heal)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"   # cron self-defense (siblings by bare name)

LOG="${MESH_MLME_LOG:-$HOME/.mesh/mlme-events.log}"
COVF="${MESH_MLME_COVF:-$HOME/.mesh/.mlme-tap.coverage}"
STATE="${MESH_MLME_STATE:-$HOME/.mesh/.mlme-tap.state}"
BASE="${MESH_MLME_BASE:-$HOME/.mesh/.mlme-tap.baseline}"
LOCKF="${MESH_MLME_LOCK:-$HOME/.mesh/.mlme-tap.lock}"
STARTF="${MESH_MLME_STARTF:-$HOME/.mesh/.mlme-tap.started}"
PIDF="${MESH_MLME_PIDF:-$HOME/.mesh/.mlme-tap.pid}"
DLOG="${MESH_MLME_DLOG:-$HOME/.mesh/.mlme-tap.daemon.log}"
MARK="${MESH_MLME_MARK:-$HOME/.mesh/.mlme-tap.posted}"
HEALLOG="${MESH_MLME_HEALLOG:-$HOME/.mesh/link-heal.log}"
NLH="${MESH_MLME_NLH:-/usr/include/linux/nl80211.h}"
MAXB="${MESH_MLME_MAXB:-1048576}"          # rotate at this size, keep one generation
COV_S="${MESH_MLME_COV_S:-60}"             # coverage sample interval (seconds)
COV_MAXL="${MESH_MLME_COV_MAXL:-4000}"
FIRST_WIN="${MESH_MLME_FIRST_WIN:-300}"
NAMES_MAX="${MESH_MLME_NAMES:-6}"
HEAL_LAG="${MESH_MLME_HEAL_LAG:-180}"      # link-heal deauth->RECOVERED worst case (dark + TICK)
DEBOUNCE_MIN="${MESH_MLME_DEBOUNCE_MIN:-900}"
CHAT="${MESH_MLME_CHAT:-1}"
# The group the listener asks for. A test seam ONLY — the negative arm of --test narrows it to a
# group that carries no MLME traffic, to prove the bit assertion actually FAILS. Never narrow it in
# production: see TRAP 1.
MLME_GROUP="${MESH_MLME_GROUP:-mlme}"

stamp(){ date -u +%FT%TZ; }
now_epoch(){ date -u +%s; }
mkdirp(){ mkdir -p "$(dirname "$1")" 2>/dev/null; }

# --- the constants, RE-DERIVED from the kernel header --------------------------------------------
# See TRAP 5. Prints `cmd:<name>=<n> ... attr:<name>=<n> ... src=<header|pinned>`.
PY_DERIVE='
import re,sys
H=sys.argv[1]
CMDS=("AUTHENTICATE","ASSOCIATE","DEAUTHENTICATE","DISASSOCIATE","CONNECT","ROAM","DISCONNECT",
      "FRAME","FRAME_TX_STATUS","NEW_STATION","DEL_STATION")
ATTRS=("IFINDEX","IFNAME","MAC","FRAME","REASON_CODE","TIMED_OUT","DISCONNECTED_BY_AP","ACK")
PINNED_C={"AUTHENTICATE":37,"ASSOCIATE":38,"DEAUTHENTICATE":39,"DISASSOCIATE":40,"CONNECT":46,
          "ROAM":47,"DISCONNECT":48,"FRAME":59,"FRAME_TX_STATUS":60,"NEW_STATION":19,"DEL_STATION":20}
PINNED_A={"IFINDEX":3,"IFNAME":4,"MAC":6,"FRAME":51,"REASON_CODE":54,"TIMED_OUT":65,
          "DISCONNECTED_BY_AP":71,"ACK":92}
def parse(src, enum, prefix):
    m=re.search(r"^enum %s \{(.*?)^\};"%enum, src, re.S|re.M)
    if not m: return {}
    body=re.sub(r"/\*.*?\*/","",m.group(1),flags=re.S)
    out={}; nxt=0
    for line in body.split("\n"):
        line=line.strip()
        mm=re.match(r"^(%s[A-Z0-9_]*)\s*(=\s*([^,]+))?,?$"%prefix, line)
        if not mm: continue
        name=mm.group(1); val=mm.group(3)
        if val is not None:
            v=val.strip()
            if re.fullmatch(r"\d+", v): nxt=int(v)
            elif v in out: nxt=out[v]           # an ALIAS: takes the target value, does not advance
            else: continue                      # unresolvable: skip WITHOUT advancing the counter
        out[name]=nxt; nxt+=1
    return out
c=a={}
src=""
try: src=open(H).read()
except Exception: pass
if src:
    c=parse(src,"nl80211_commands","NL80211_CMD_")
    a=parse(src,"nl80211_attrs","NL80211_ATTR_")
ok = all(("NL80211_CMD_"+k) in c for k in CMDS) and all(("NL80211_ATTR_"+k) in a for k in ATTRS)
if ok:
    src_name="header:"+H
    C={k:c["NL80211_CMD_"+k] for k in CMDS}; A={k:a["NL80211_ATTR_"+k] for k in ATTRS}
else:
    src_name="pinned"; C=PINNED_C; A=PINNED_A
print(" ".join("cmd:%s=%d"%(k,C[k]) for k in CMDS))
print(" ".join("attr:%s=%d"%(k,A[k]) for k in ATTRS))
print("src=%s"%src_name)
'
derive(){ python3 -c "$PY_DERIVE" "$NLH" 2>/dev/null; }
derive_src(){ derive | sed -n 's/^src=//p'; }

# --- the listener ---------------------------------------------------------------------------------
# Python, because the frame plane needs raw netlink: `iw event` prints a decoded line but drops the
# raw frame, the reason code's subtype context, and the Drops column this tool's coverage rests on.
PY_LISTEN='
import socket, struct, os, sys, time, select

H, LOG, COVF, COV_S, MAXB, COV_MAXL, WANT = sys.argv[1], sys.argv[2], sys.argv[3], int(sys.argv[4]), int(sys.argv[5]), int(sys.argv[6]), sys.argv[7]
NETLINK_GENERIC = 16; SOL_NETLINK = 270; ADD_MEMBERSHIP = 1

def align(n): return (n + 3) & ~3
def attrs(buf):
    out = []; i = 0
    while i + 4 <= len(buf):
        alen, atype = struct.unpack_from("=HH", buf, i)
        if alen < 4: break
        out.append((atype & 0x3fff, buf[i+4:i+alen])); i += align(alen)
    return out

# --- the constants, HANDED IN by derive() -------------------------------------------------------
# There is exactly ONE parser of the kernel header in this file (PY_DERIVE) and the listener
# consumes what it produced, as `cmd:NAME=N ... attr:NAME=N ... src=...`. It used to carry a second
# private copy of the same regex loop, and a mutant that broke the alias handling in the REAL parser
# left the suite green because the test drove --derive and the listener drove the other copy.
# [[n-private-copies-of-one-predicate-are-all-green-and-none-is-complete]]
CMD = {}; A = {}; CSRC = "na"
for tok in H.split():
    if tok.startswith("cmd:") and "=" in tok:
        k, v = tok[4:].split("=", 1); CMD[int(v)] = k
    elif tok.startswith("attr:") and "=" in tok:
        k, v = tok[5:].split("=", 1); A[k] = int(v)
    elif tok.startswith("src="):
        CSRC = tok[4:]
_need_a = ("IFINDEX", "IFNAME", "MAC", "FRAME", "REASON_CODE", "TIMED_OUT", "DISCONNECTED_BY_AP", "ACK")
if not CMD or any(k not in A for k in _need_a):
    sys.stderr.write("UNSUBSCRIBED: the constants handed in name no commands or are missing an attribute — refusing to decode blind (got %r)\n" % H[:200])
    sys.exit(2)

# IEEE 802.11 reason codes. NOT a kernel enum (linux/ieee80211.h is not shipped here) — these are
# standard values, and an unmapped one renders `unmapped(N)`, never `?`: an unknown code must read
# as unknown, not as a missing field.
REASON = {1:"UNSPECIFIED",2:"PREV_AUTH_NOT_VALID",3:"DEAUTH_LEAVING",4:"DISASSOC_DUE_TO_INACTIVITY",
  5:"DISASSOC_AP_BUSY",6:"CLASS2_FRAME_FROM_NONAUTH_STA",7:"CLASS3_FRAME_FROM_NONASSOC_STA",
  8:"DISASSOC_STA_HAS_LEFT",9:"STA_REQ_ASSOC_WITHOUT_AUTH",10:"DISASSOC_BAD_POWER",
  11:"DISASSOC_BAD_SUPP_CHAN",13:"INVALID_IE",14:"MIC_FAILURE",15:"4WAY_HANDSHAKE_TIMEOUT",
  16:"GROUP_KEY_UPDATE_TIMEOUT",17:"IE_DIFFERENT",18:"INVALID_GROUP_CIPHER",
  19:"INVALID_PAIRWISE_CIPHER",20:"INVALID_AKMP",23:"IEEE8021X_FAILED",24:"CIPHER_SUITE_REJECTED",
  34:"DISASSOC_LOW_ACK"}
SUBTYPE = {0:"assoc-req",1:"assoc-resp",2:"reassoc-req",3:"reassoc-resp",4:"probe-req",
  5:"probe-resp",8:"beacon",10:"disassoc",11:"auth",12:"deauth",13:"action"}
# Offset 24 is a reason code for these subtypes ONLY. See TRAP 3.
REASON_SUBTYPES = (10, 12)

def rname(rc): return REASON.get(rc, "unmapped(%d)" % rc)
def macfmt(b): return ":".join("%02x" % x for x in b)

def decode_frame(f, ourmac):
    """The ONE frame decoder. The listener calls it and --decode-frame calls it, so a test drives
    the parser OWN predicate and not a lookalike of it.
    [[a-lint-that-tests-a-different-predicate-than-the-parser-is-blind]]
    Returns (subtype, subtype_name, direction, frame_reason, frame_reason_name)."""
    if f is None or len(f) < 24:
        return "na", "na", "na", "na", "na"
    fc = struct.unpack_from("<H", f, 0)[0]
    sub = (fc >> 4) & 0xF
    st = str(sub); stn = SUBTYPE.get(sub, "unmapped(%d)" % sub)
    sa = macfmt(f[10:16])
    direction = "na"
    if ourmac and ourmac != "na":
        direction = "us->AP" if sa.lower() == ourmac.lower() else "AP->us"
    if sub in REASON_SUBTYPES and len(f) >= 26:
        rc = struct.unpack_from("<H", f, 24)[0]
        return st, stn, direction, str(rc), rname(rc)
    # TRAP 3: on every other subtype those two bytes are NOT a reason code (on an Action frame they
    # are category|action) and would yield a plausible number with no error at all.
    return st, stn, direction, "na", "na(subtype-%s-carries-no-reason-at-offset-24)" % st

if len(sys.argv) > 8 and sys.argv[7] == "--decode-frame":
    _f = bytes.fromhex(sys.argv[8]); _m = sys.argv[9] if len(sys.argv) > 9 else "na"
    _st, _stn, _dir, _fr, _frn = decode_frame(_f, _m)
    print("subtype=%s subtype_name=%s dir=%s frame_reason=%s frame_reason_name=%s" % (_st, _stn, _dir, _fr, _frn))
    sys.exit(0)

def getfamily(name):
    s = socket.socket(socket.AF_NETLINK, socket.SOCK_RAW, NETLINK_GENERIC); s.bind((0, 0))
    nm = name.encode() + b"\0"
    p = struct.pack("=BBH", 3, 2, 0) + struct.pack("=HH", 4 + len(nm), 2) + nm + b"\0" * (align(4 + len(nm)) - (4 + len(nm)))
    s.send(struct.pack("=IHHII", 16 + len(p), 16, 0x05, 1, 0) + p)
    d = s.recv(65535); s.close()
    mlen, mtype = struct.unpack_from("=IH", d, 0)
    if mtype == 2: raise SystemExit("NLMSG_ERROR resolving %s: %d" % (name, struct.unpack_from("=i", d, 16)[0]))
    fid = None; grp = {}
    for t, v in attrs(d[16:mlen][4:]):
        if t == 1: fid = struct.unpack_from("=H", v, 0)[0]
        elif t == 7:
            for _, g in attrs(v):
                gn = gi = None
                for gt, gv in attrs(g):
                    if gt == 1: gn = gv.split(b"\0")[0].decode()
                    elif gt == 2: gi = struct.unpack_from("=I", gv, 0)[0]
                if gn is not None: grp[gn] = gi
    return fid, grp

# /proc/net/netlink: sk Eth Pid Groups Rmem Wmem Dump Locks Drops Inode
# Groups is FIELD 4 (index 3), Drops is FIELD 9 (index 8), Inode is FIELD 10 (index 9). TRAP 2.
GROUPS_COL, DROPS_COL, INODE_COL = 3, 8, 9
def netlink_row(inode):
    try:
        for ln in open("/proc/net/netlink"):
            f = ln.split()
            if len(f) > INODE_COL and f[INODE_COL] == str(inode): return f
    except OSError: pass
    return None

fid, groups = getfamily("nl80211")
if WANT not in groups:
    sys.stderr.write("UNSUBSCRIBED: nl80211 advertises no multicast group named %r (has: %s)\n" % (WANT, ",".join(sorted(groups))))
    sys.exit(2)
gid = groups[WANT]
s = socket.socket(socket.AF_NETLINK, socket.SOCK_RAW, NETLINK_GENERIC); s.bind((0, 0))
try: s.setsockopt(SOL_NETLINK, ADD_MEMBERSHIP, gid)
except OSError as e:
    sys.stderr.write("UNSUBSCRIBED: joining group %s(%d) failed: %s\n" % (WANT, gid, e.strerror)); sys.exit(2)
ino = os.stat("/proc/self/fd/%d" % s.fileno()).st_ino

# ASSERT THE SUBSCRIPTION FROM THE KERNEL, never from what we asked for. TRAP 1 + TRAP 2.
row = netlink_row(ino)
if row is None:
    sys.stderr.write("UNSUBSCRIBED: inode %d not found in /proc/net/netlink\n" % ino); sys.exit(2)
mask = int(row[GROUPS_COL], 16)
want_bit = 1 << (gid - 1)
if not (mask & want_bit):
    open(COVF, "a").write("%d pid=%d inode=%d groups=0x%08x mlme=0 drops=%s UNSUBSCRIBED refusing-to-listen group=%s(%d) csrc=%s\n"
                          % (int(time.time()), os.getpid(), ino, mask, row[DROPS_COL], WANT, gid, CSRC))
    sys.stderr.write("UNSUBSCRIBED: kernel says groups=0x%08x, bit for %s(%d) is CLEAR — a listener that is not subscribed renders identically to a quiet radio; refusing to listen blind\n" % (mask, WANT, gid))
    sys.exit(2)
open(COVF, "a").write("%d pid=%d inode=%d groups=0x%08x mlme=1 drops=%s SUBSCRIBED group=%s(%d) csrc=%s\n"
                      % (int(time.time()), os.getpid(), ino, mask, row[DROPS_COL], WANT, gid, CSRC))
sys.stderr.write("subscribed: group=%s(%d) groups=0x%08x drops=%s inode=%d constants-from=%s\n" % (WANT, gid, mask, row[DROPS_COL], ino, CSRC))
sys.stderr.flush()

# Our own MAC, per IFINDEX and re-resolved on a miss. Never cached once at startup: the sole uplink
# here is a USB dongle that is replugged, and both the ifindex and the name follow the plug.
# [[a-detectors-subject-picked-by-ifindex-follows-the-plug]]
_ifc = {}
def iface_of(ifindex):
    e = _ifc.get(ifindex)
    if e is not None and time.time() - e[2] < 30: return e[0], e[1]
    name = mac = "na"
    try:
        for d in os.listdir("/sys/class/net"):
            try:
                if int(open("/sys/class/net/%s/ifindex" % d).read().strip()) == ifindex:
                    name = d
                    try: mac = open("/sys/class/net/%s/address" % d).read().strip()
                    except OSError: mac = "na"
                    break
            except (OSError, ValueError): continue
    except OSError: pass
    _ifc[ifindex] = (name, mac, time.time())
    return name, mac

def rotate():
    try:
        if os.path.getsize(LOG) >= MAXB: os.replace(LOG, LOG + ".1")
    except OSError: pass

def sample(last_drops):
    r = netlink_row(ino)
    if r is None:
        open(COVF, "a").write("%d pid=%d inode=%d groups=na mlme=na drops=na socket-gone\n" % (int(time.time()), os.getpid(), ino)); return None, True
    m = int(r[GROUPS_COL], 16); d = r[DROPS_COL]
    bit = 1 if (m & want_bit) else 0
    open(COVF, "a").write("%d pid=%d inode=%d groups=0x%08x mlme=%d drops=%s\n" % (int(time.time()), os.getpid(), ino, m, bit, d))
    try:
        n = sum(1 for _ in open(COVF))
        if n > COV_MAXL:
            lines = open(COVF).readlines()[-(COV_MAXL // 2):]
            open(COVF + ".t", "w").writelines(lines); os.replace(COVF + ".t", COVF)
    except OSError: pass
    if bit == 0:
        open(COVF, "a").write("%d pid=%d inode=%d groups=0x%08x mlme=0 drops=%s UNSUBSCRIBED exiting\n" % (int(time.time()), os.getpid(), ino, m, d))
        return d, True
    return d, False

last_sample = 0.0; drops = None
while True:
    if time.time() - last_sample >= COV_S:
        drops, dead = sample(drops); last_sample = time.time()
        if dead: sys.exit(2)
    rr, _, _ = select.select([s], [], [], 1.0)
    if not rr: continue
    try: data = s.recv(1 << 20)
    except OSError as e:
        sys.stderr.write("RECV-ERR %s\n" % e.strerror); continue
    off = 0
    while off + 16 <= len(data):
        mlen, mtype = struct.unpack_from("=IH", data, off)
        if mlen < 16: break
        if mtype == fid:
            cmd = data[off + 16]
            name = CMD.get(cmd)
            if name is not None:
                now = time.time()
                ts = time.strftime("%Y-%m-%dT%H:%M:%S", time.gmtime(now)) + ".%03dZ" % ((now % 1) * 1000)
                d = dict(attrs(data[off + 20:off + mlen]))
                ifidx = struct.unpack_from("=I", d[A["IFINDEX"]], 0)[0] if A["IFINDEX"] in d else 0
                ifn, ourmac = iface_of(ifidx) if ifidx else ("na", "na")
                if A["IFNAME"] in d:
                    try: ifn = d[A["IFNAME"]].split(b"\0")[0].decode() or ifn
                    except Exception: pass
                mac = macfmt(d[A["MAC"]]) if A["MAC"] in d else "na"
                reason = rn = "na"
                if A["REASON_CODE"] in d and len(d[A["REASON_CODE"]]) >= 2:
                    rc = struct.unpack_from("=H", d[A["REASON_CODE"]], 0)[0]; reason = str(rc); rn = rname(rc)
                by_ap = "yes" if A["DISCONNECTED_BY_AP"] in d else ("no" if name == "DISCONNECT" else "na")
                timed_out = "yes" if A["TIMED_OUT"] in d else "na"
                st = stn = "na"; direction = "na"; fhex = "na"; freason = frn = "na"
                if A["FRAME"] in d and len(d[A["FRAME"]]) >= 24:
                    f = d[A["FRAME"]]
                    st, stn, direction, freason, frn = decode_frame(f, ourmac)
                    fhex = f.hex()
                rotate()
                open(LOG, "a").write("%d ts=%s ev=%s cmd=%d if=%s ifindex=%d peer=%s dir=%s reason=%s reason_name=%s frame_reason=%s frame_reason_name=%s by_ap=%s timed_out=%s subtype=%s subtype_name=%s :: framehex=%s\n"
                    % (int(now), ts, name, cmd, ifn, ifidx, mac, direction, reason, rn, freason, frn, by_ap, timed_out, st, stn, fhex))
        off += align(mlen)
'

listener_alive(){
  [ -e "$LOCKF" ] || return 1
  if exec 8>>"$LOCKF" 2>/dev/null; then
    if flock -n 8 2>/dev/null; then exec 8>&-; return 1; fi
    exec 8>&-; return 0
  fi
  return 1
}

daemon(){
  command -v python3 >/dev/null 2>&1 || { echo "$(stamp) n/a: python3 absent — the frame plane needs raw netlink" >&2; return 2; }
  mkdirp "$LOCKF"; mkdirp "$LOG"; mkdirp "$COVF"
  exec 9>>"$LOCKF" || return 2
  if ! flock -n 9; then echo "$(stamp) another listener already holds $LOCKF — refusing to double-start"; return 0; fi
  printf '%s\n' "$(now_epoch)" > "$STARTF"
  printf '%s\n' "$$" > "$PIDF"
  local consts; consts="$(derive | tr '\n' ' ')"
  python3 -c "$PY_LISTEN" "$consts" "$LOG" "$COVF" "$COV_S" "$MAXB" "$COV_MAXL" "$MLME_GROUP"
  local rc=$?
  rm -f "$STARTF" "$PIDF"
  return "$rc"
}

ensure(){
  if listener_alive; then echo "listener: already running (holds $LOCKF)"; return 0; fi
  mkdirp "$DLOG"
  setsid nohup bash "${BASH_SOURCE[0]}" --daemon >>"$DLOG" 2>&1 &
  local i
  for i in $(seq 1 20); do
    listener_alive && { echo "listener: started"; return 0; }
    sleep 0.3
  done
  echo "listener: FAILED to start (see $DLOG)"; return 1
}

pgid_of(){ sed -n 's/.*) //p' "/proc/$1/stat" 2>/dev/null | awk '{print $3}'; }

stop_listener(){
  listener_alive || { echo "listener: not running"; return 0; }
  # Scoped by THIS instance's pidfile, never by a name match across the node: a `pkill -f
  # mesh-mlme-tap --daemon` would reach out of a sandboxed --test and kill the node's real reflex,
  # and it matches the very shell running it. [[a-name-matching-stop-kills-your-other-selves]]
  local pid=""; [ -r "$PIDF" ] && pid="$(tr -dc '0-9' < "$PIDF")"
  if [ -z "$pid" ] || [ ! -r "/proc/$pid/cmdline" ]; then
    echo "listener: the lock is held but $PIDF names no live process — refusing to guess which pid to kill"; return 1
  fi
  case "$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null)" in
    *mesh-mlme-tap*--daemon*) : ;;
    *) echo "listener: pid $pid is not a listener (pid reused) — refusing to kill it"; return 1;;
  esac
  local pgid; pgid="$(pgid_of "$pid")"; [ -n "$pgid" ] || pgid="$pid"
  kill -TERM -- -"$pgid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null
  local i; for i in $(seq 1 10); do listener_alive || { rm -f "$PIDF"; echo "listener: stopped"; return 0; }; sleep 0.3; done
  kill -KILL -- -"$pgid" 2>/dev/null
  for i in 1 2 3 4 5; do listener_alive || { rm -f "$PIDF"; echo "listener: stopped (KILL)"; return 0; }; sleep 0.3; done
  echo "listener: still holding the lock after TERM+KILL"; return 1
}

# --- reading ---------------------------------------------------------------------------------------
scan_since(){
  local since="$1" f
  for f in "$LOG.1" "$LOG"; do [ -f "$f" ] && cat "$f"; done 2>/dev/null \
    | awk -v s="$since" '$1 ~ /^[0-9]+$/ && $1+0 >= s+0'
}
# The LOSS events: the three commands that mean the association ended. CONNECT/ROAM/AUTHENTICATE/
# ASSOCIATE are the recovery edge and are counted apart — folding them would erase the very
# distinction (death vs recovery) this tap exists to draw.
LOSS_RE='^(DEAUTHENTICATE|DISASSOCIATE|DISCONNECT)$'
count_loss(){ scan_since "$1" | awk -v re="$LOSS_RE" '{for(i=2;i<=NF;i++){if($i=="::")break;split($i,p,"=");if(p[1]=="ev"&&p[2]~re)n++}}END{print n+0}'; }
count_all(){  scan_since "$1" | wc -l | tr -d ' '; }
# Direction split over the loss events -> "<ap_to_us> <us_to_ap> <unknown>".
# TWO independent sources of direction, and the second is not a guess: a DISCONNECT carries no
# management frame at all, so its `dir` is structurally na — but the kernel attaches
# NL80211_ATTR_DISCONNECTED_BY_AP to exactly that event, which IS the same fact. Reading only the
# frame left every DISCONNECT in the unknown column while the answer sat in the next field, and
# `dir-unknown` is the column a reader uses to decide the tap cannot answer the question.
# The frame wins where both are present; `by_ap=no` is a real us->AP claim, not an absence.
dir_split(){
  scan_since "$1" | awk -v re="$LOSS_RE" '{ev="";d="na";b="na"
      for(i=2;i<=NF;i++){ if($i=="::")break; split($i,p,"="); if(p[1]=="ev")ev=p[2]; else if(p[1]=="dir")d=p[2]
                          else if(p[1]=="by_ap")b=p[2] }
      if(ev~re){
        if(d=="AP->us")a++
        else if(d=="us->AP")u++
        else if(b=="yes")a++
        else if(b=="no")u++
        else k++ } }
    END{ printf "%d %d %d", a+0, u+0, k+0 }'
}
# reason histogram over the loss events, most-frequent first. Prefers the FRAME reason (the wire
# truth) and falls back to the attribute; renders `none` when neither is present rather than 0.
reasons_since(){
  local since="$1" max="${2:-6}"
  scan_since "$since" | awk -v re="$LOSS_RE" '{ev="";r="";rn=""
      for(i=2;i<=NF;i++){ if($i=="::")break; split($i,p,"=")
        if(p[1]=="ev")ev=p[2]
        else if(p[1]=="frame_reason"&&p[2]!="na"){r=p[2]}
        else if(p[1]=="frame_reason_name"&&p[2]!~/^na/){rn=p[2]}
        else if(p[1]=="reason"&&p[2]!="na"&&r==""){r=p[2]}
        else if(p[1]=="reason_name"&&p[2]!="na"&&rn==""){rn=p[2]} }
      if(ev~re){ k=(r==""?"none":r"("rn")"); c[k]++ } }
    END{ for(k in c) printf "%d\t%s(x%d)\n", c[k], k, c[k] }' \
    | sort -rn | head -n "$max" | cut -f2 | paste -sd, - 2>/dev/null
}
names_since(){
  local since="$1" max="${2:-6}"
  scan_since "$since" | awk '{ev="?"
      for(i=2;i<=NF;i++){ if($i=="::")break; split($i,p,"="); if(p[1]=="ev")ev=p[2] }
      c[ev]++; if(!(ev in ord)) ord[ev]=++n }
    END{ for(e in c) printf "%d\t%s(x%d)\n", ord[e], e, c[e] }' \
    | sort -n | head -n "$max" | cut -f2 | paste -sd, - 2>/dev/null
}
# mesh-link-heal's independent tape: RECOVERED rows in the window. Matched on the VERB by position
# (field 2), never as a substring of the whole line — a row's free text can quote another row's
# fields. [[a-verdicts-free-text-quotes-another-records-fields]]
heal_recovered_since(){
  local since="$1"
  [ -r "$HEALLOG" ] || { echo na; return; }
  awk -v s="$since" '
    $2 == "RECOVERED" {
      ts=$1; gsub(/[-:TZ]/," ",ts); n=split(ts,a," ")
      if (n>=6) { e=mktime(a[1]" "a[2]" "a[3]" "a[4]" "a[5]" "a[6]" UTC")
                  if (e=="" || e<0) next
                  if (e >= s+0) c++ } }
    END{ print c+0 }' "$HEALLOG" 2>/dev/null
}

# The coverage terms, from the listener's own samples. Prints
# "<fresh 0|1> <mlme-bit> <drops-last> <drops-delta> <groups> <age>"
cov_terms(){   # $1 = window start epoch, $2 = now
  local since="$1" now="$2"
  [ -r "$COVF" ] || { echo "0 na na na na na"; return; }
  awk -v s="$since" -v now="$now" -v maxage="$(( COV_S * 3 + 10 ))" '
    $1 ~ /^[0-9]+$/ {
      e=$1; g="na"; m="na"; d="na"
      for(i=2;i<=NF;i++){ split($i,p,"="); if(p[1]=="groups")g=p[2]; else if(p[1]=="mlme")m=p[2]; else if(p[1]=="drops")d=p[2] }
      le=e; lg=g; lm=m; ld=d
      if (e+0 >= s+0 && fd=="") fd=d
      if ($0 ~ /UNSUBSCRIBED/) unsub=1
    }
    END{
      if (le=="") { print "0 na na na na na"; exit }
      age = now - le
      fresh = (age <= maxage) ? 1 : 0
      if (unsub) lm=0
      dd="na"
      if (ld ~ /^[0-9]+$/ && fd ~ /^[0-9]+$/) { dd = ld - fd; if (dd<0) dd="na" }
      else if (ld ~ /^[0-9]+$/) dd = ld
      printf "%d %s %s %s %s %d\n", fresh, lm, ld, dd, lg, age
    }' "$COVF"
}

# --- the verdict (pure) ----------------------------------------------------------------------------
# in: live start now win loss allev recovered cfresh cmlme ddelta lossext
# out: <verdict>|<rc>|<coverage-word>|<sentence>
decide(){
  local live="$1" start="$2" now="$3" win="$4" loss="$5" allev="$6" recovered="$7"
  local cfresh="$8" cmlme="$9" ddelta="${10}" lossext="${11:-0}"
  case "$win" in ''|na|*[!0-9]*)
    printf 'BASELINE|0|na|first sight: recorded the clock as the baseline and claimed NOTHING — a live tap has no history, so there is no window it could have covered yet\n'; return;;
  esac
  if [ "$live" != 1 ]; then
    printf 'UNKNOWN|2|blind|no listener holds the lock, so the MLME plane is BLIND for this window, not quiet — an empty log from a dead listener is a fabricated calm, and the multicast stream keeps no history to catch up from\n'; return
  fi
  if [ "$cfresh" != 1 ]; then
    printf 'UNKNOWN|2|no-sample|the listener holds the lock but has published no fresh coverage sample, so its subscription and its Drops term are both unknown for this window — an unsubscribed listener renders identically to a quiet radio, so silence here is not a reading\n'; return
  fi
  if [ "$cmlme" != 1 ]; then
    printf 'UNKNOWN|2|unsubscribed|the kernel says this listener is NOT subscribed to the mlme group (bit read from /proc/net/netlink field 4 for its own socket, matched by inode) — every deauth it did not receive would render as a quiet radio\n'; return
  fi
  case "$ddelta" in ''|na) : ;; *)
    if [ "$ddelta" -gt 0 ] 2>/dev/null; then
      printf 'UNKNOWN|2|drops=%s|the socket DROPPED %s netlink message(s) in this window (ENOBUFS loses messages with no error on the stream), so a deauth could have gone missing and would read exactly like no deauth — the count below is a FLOOR and the window is unknown, never quiet\n' "$ddelta" "$ddelta"; return
    fi;;
  esac
  case "$start" in ''|na|*[!0-9]*) start="$now";; esac
  local covered=$(( now - start )); [ "$covered" -lt 0 ] && covered=0
  if [ "$covered" -lt "$win" ]; then
    if [ "${loss:-0}" -gt 0 ] 2>/dev/null; then
      printf 'EVENTS|1|partial:%ss/%ss|%s MLME loss event(s), but the listener covered only %ss of the last %ss (it started inside the window) — the count is a FLOOR and the uncovered head is UNKNOWN, not zero: a live tap has no history\n' "$covered" "$win" "$loss" "$covered" "$win"; return
    fi
    printf 'UNKNOWN|2|partial:%ss/%ss|the listener covered only %ss of the last %ss (it started inside the window), so "no loss event" is a claim about %ss of it and UNKNOWN about the rest\n' "$covered" "$win" "$covered" "$win" "$covered"; return
  fi
  # The independent witness, in the sign that indicts THIS tap: link-heal saw an episode close and
  # we named nothing that could have opened it, in a window we claim we covered fully.
  case "$recovered" in ''|na) : ;; *)
    if [ "$recovered" -gt 0 ] 2>/dev/null && [ "${loss:-0}" = 0 ]; then
      if [ "${lossext:-0}" != na ] && [ "${lossext:-0}" -gt 0 ] 2>/dev/null; then
        printf 'EVENTS|1|full|STRADDLE: mesh-link-heal closed %s episode(s) in this window and this tap named no loss event INSIDE it, but it did name %s in the preceding %ss — a RECOVERED row is written at the CLOSE of an episode whose opening deauth is up to (dark + TICK) older, so this is an episode dated to the previous window, NOT two instruments disagreeing\n' "$recovered" "$lossext" "$HEAL_LAG"; return
      fi
      printf 'GAP|2|full|mesh-link-heal closed %s episode(s) inside a window this tap claims it covered FULLY, with the mlme bit set and zero drops, and this tap named NO loss event in it NOR in the preceding %ss — two instruments disagree, so distrust THIS one: rc 2 says the window is unattributable, never that the radio was calm\n' "$recovered" "$HEAL_LAG"; return
    fi;;
  esac
  if [ "${loss:-0}" -gt 0 ] 2>/dev/null; then
    printf 'EVENTS|1|full|%s MLME loss event(s) dated to the millisecond, alongside %s other MLME event(s) in the window — this is the instant the association ended and the direction it came from, neither of which a 60s poll of `iw link` can produce\n' "$loss" "$(( ${allev:-0} - loss ))"; return
  fi
  if [ "${allev:-0}" -gt 0 ] 2>/dev/null; then
    printf 'QUIET|0|full|no MLME loss event in the window; %s non-loss MLME event(s) (association/recovery edges) — the association held\n' "$allev"; return
  fi
  printf 'QUIET|0|full|no MLME event at all in the window: subscribed, zero drops, listener up for the whole of it — the association held and nothing touched the frame plane\n'
}

# --- the EPISODE answer, for a poller that wants what its own cadence cannot give it ---------------
# mesh-link-heal is a 60s poller and an ACTUATOR: it must stay a poller (the recovery ladder must not
# be driven off a firehose), but its closing row reports `>=Ns dark (lower bound, window=5s/60s)`
# on an unacted episode (and `Ns to-recovery (elapsed, …)` where its own ladder climbed, which is
# not a dark reading at all) and that number is the STRIDE, not the fault. Measured 2026-08-26T16:20:48-16:47:08Z:
# a 2s sampler saw FIVE not-associated episodes and link-heal logged TWO — the three it missed all
# lasted under one tick, so ~60% of episodes are unrecorded AND the survivors are biased LONG by
# exactly the same cut. [[an-events-duration-under-the-poll-period-is-invisible-to-the-poller]]
#
# This mode answers, for a window the caller names, the two things the poller structurally cannot:
# how many MLME loss episodes actually happened in it, and how long the association was really down.
# It lives HERE and not in link-heal on purpose — the log grammar, the loss-event alphabet and the
# coverage terms all belong to this tool, and a second private parse in the consumer is how a guard
# stops guarding the thing it names.
# [[n-private-copies-of-one-predicate-are-all-green-and-none-is-complete]]
#
# COVERAGE TRAVELS WITH THE NUMBERS, ALWAYS. A caller that gets `episodes=0` with no coverage term
# cannot tell "the radio was calm" from "this tap was not listening", and those two must never render
# the same. Every field goes `na` and coverage says WHY when the window is not covered — never 0,
# which is a claim. [[a-blindness-sentinel-fused-as-a-reading]]
episode_window(){   # <start-epoch> <end-epoch> → "episodes=<n|na> dark=<s|na> coverage=<word> ..."
  local st="$1" en="$2" now live=0 cf cm cd cdd cg cage
  case "$st$en" in *[!0-9]*) printf 'episodes=na dark=na coverage=bad-window first=na last=na\n'; return 2;; esac
  now="$(now_epoch)"
  listener_alive && live=1
  local lstart=na; [ -r "$STARTF" ] && lstart="$(tr -dc '0-9' < "$STARTF")"; [ -n "$lstart" ] || lstart=na
  read -r cf cm cd cdd cg cage <<<"$(cov_terms "$st" "$now")"
  # The same coverage ladder decide() uses, in the same order and with the same meanings — a second
  # ordering here would let this mode call a window covered that the main reading calls blind.
  local cov=full
  if   [ "$live" != 1 ];                       then cov=blind
  elif [ "${cf:-0}" != 1 ];                    then cov=no-sample
  elif [ "${cm:-0}" != 1 ];                    then cov=unsubscribed
  elif [ "${cdd:-na}" != na ] && [ "${cdd:-0}" -gt 0 ] 2>/dev/null; then cov="drops=$cdd"
  else
    # COVERED PORTION, not listener AGE — the two are different numbers and the first draft printed
    # the wrong one, which read `partial:2445s/100s` (more covered than the window is long). It is
    # the OVERLAP of [st,en] with [lstart,now]: a window entirely before the tap started is 0s
    # covered, not "recently started".
    local wlen=$(( en - st )) cstart cend covered
    [ "$wlen" -lt 0 ] && wlen=0
    cstart="$st"; [ "$lstart" != na ] && [ "$lstart" -gt "$st" ] 2>/dev/null && cstart="$lstart"
    cend="$en";   [ "$now" -lt "$en" ] 2>/dev/null && cend="$now"
    covered=$(( cend - cstart )); [ "$covered" -lt 0 ] && covered=0
    # A live tap has no history, so an uncovered head is UNKNOWN, never zero.
    # [[absence-from-a-bounded-cache-is-unknown-never-down]]
    [ "$lstart" = na ] && covered=0
    [ "$covered" -lt "$wlen" ] && cov="partial:${covered}s/${wlen}s"
  fi
  case "$cov" in full) : ;; *) printf 'episodes=na dark=na coverage=%s first=na last=na\n' "$cov"; return 2;; esac
  # Episodes: a loss event OPENS one; a CONNECT/ROAM closes it. Consecutive loss events with no
  # recovery between them are ONE episode (a deauth and the DISCONNECT it causes are the same
  # outage, 1ms apart — counting rows would triple every episode).
  local out
  out="$(scan_since "$st" | awk -v en="$en" -v re="$LOSS_RE" '
      $1+0 <= en+0 {
        ev=""; ts=""
        for(i=2;i<=NF;i++){ if($i=="::")break; split($i,p,"="); if(p[1]=="ev")ev=p[2]; else if(p[1]=="ts")ts=p[2] }
        if (ev ~ re) { if (!open) { n++; open=1; if(first=="")first=ts; ostart=$1 } ; last=ts; lend=$1 }
        else if (ev=="CONNECT" || ev=="ROAM") { if (open) { open=0; dark += $1 - ostart; if(dsn=="")dsn=0; dsn++ ; last=ts; lend=$1 } }
      }
      END{ printf "%d %d %d %s %s", n+0, dark+0, (open?1:0), (first==""?"na":first), (last==""?"na":last) }')"
  local n dark unclosed first last
  read -r n dark unclosed first last <<<"$out"
  # An episode still OPEN at the end of the window has no measured duration yet — report the count
  # and say the duration is a floor, never silently attribute the window's remainder to it.
  local darkf="$dark"
  [ "${unclosed:-0}" = 1 ] && darkf="${dark}+open"
  printf 'episodes=%s dark=%s coverage=full first=%s last=%s\n' "${n:-0}" "$darkf" "$first" "$last"
  [ "${n:-0}" -gt 0 ] 2>/dev/null && return 1
  return 0
}

# --- the reading ------------------------------------------------------------------------------------
read_pass(){    # $1 = 1 if this pass may write state/baseline/board
  local writes="${1:-1}" now start win live=0 loss allev recovered cf cm cd cdd cg cage lossext
  now="$(now_epoch)"
  listener_alive && live=1
  # `2>/dev/null` on the command cannot suppress the SHELL's own failure to OPEN the redirection,
  # so an absent state file printed "No such file or directory" and then poisoned the arithmetic
  # below. Guard on readability, never on the redirect.
  # [[a-stderr-null-after-a-redirection-cannot-suppress-the-open-failure]]
  start=na; [ -r "$STARTF" ] && start="$(tr -dc '0-9' < "$STARTF")"; [ -n "$start" ] || start=na
  local base=""; [ -r "$BASE" ] && base="$(tr -dc '0-9' < "$BASE")"
  if [ -z "$base" ]; then win=na; else win=$(( now - base )); [ "$win" -le 0 ] && win="$FIRST_WIN"; fi
  local since
  case "$win" in
    ''|na|*[!0-9]*) since=$(( now - FIRST_WIN ));;
    *)              since=$(( now - win ));;
  esac

  loss="$(count_loss "$since")"; allev="$(count_all "$since")"
  recovered="$(heal_recovered_since "$since")"
  lossext="$(count_loss "$(( since - HEAL_LAG ))")"
  read -r cf cm cd cdd cg cage <<<"$(cov_terms "$since" "$now")"

  local d; d="$(decide "$live" "$start" "$now" "$win" "$loss" "$allev" "$recovered" "$cf" "$cm" "$cdd" "$lossext")"
  local verdict rc covword sentence
  verdict="${d%%|*}"; d="${d#*|}"; rc="${d%%|*}"; d="${d#*|}"; covword="${d%%|*}"; sentence="${d#*|}"
  sentence="${sentence%$'\n'}"

  local a u k; read -r a u k <<<"$(dir_split "$since")"
  local rs; rs="$(reasons_since "$since" "$NAMES_MAX")"; [ -n "$rs" ] || rs=none
  local ns; ns="$(names_since "$since" "$NAMES_MAX")"; [ -n "$ns" ] || ns=none
  # The FINDING sign of the link-heal disagreement: loss events this tap saw that the poller never
  # logged. Not a gap — the expected direction, and the number the tick60 task asked for.
  local unlogged=na
  case "$recovered" in ''|na) : ;; *) [ "${loss:-0}" -ge 0 ] 2>/dev/null && unlogged=$(( loss - recovered )); [ "${unlogged:-0}" -lt 0 ] && unlogged=0;; esac

  local line
  local winf; case "$win" in ''|na|*[!0-9]*) winf=na;; *) winf="${win}s";; esac
  line="$(printf '%s %s at=%s win=%s loss=%s events=%s ap->us=%s us->AP=%s dir-unknown=%s heal-recovered=%s unlogged=%s coverage=%s drops=%s groups=%s csrc=%s listener-age=%ss reasons=%s kinds=%s :: %s' \
    "$verdict" "$(hostname)" "$(stamp)" "$winf" "$loss" "$allev" "$a" "$u" "$k" "$recovered" "$unlogged" \
    "$covword" "${cdd:-na}" "${cg:-na}" "$(derive_src)" "$( [ "$start" = na ] && echo na || echo $(( now - start )) )" "$rs" "$ns" "$sentence")"
  printf '%s\n' "$line"

  if [ "$writes" = 1 ]; then
    mkdirp "$STATE"; printf '%s\n' "$line" > "$STATE"
    command -v mesh-state-touch >/dev/null 2>&1 && mesh-state-touch "$STATE" >/dev/null 2>&1
    mkdirp "$BASE"; printf '%s\n' "$now" > "$BASE"
    if [ "$CHAT" = 1 ] && [ "$verdict" != QUIET ] && [ "$verdict" != BASELINE ] && command -v mesh-chat >/dev/null 2>&1; then
      local lastpost=0; [ -r "$MARK" ] && lastpost="$(tr -dc '0-9' < "$MARK")"; [ -n "$lastpost" ] || lastpost=0
      if [ $(( now - lastpost )) -ge "$DEBOUNCE_MIN" ]; then
        mesh-chat "[fyi] mlme-tap on $(hostname): $line" >/dev/null 2>&1 && printf '%s\n' "$now" > "$MARK"
      fi
    fi
  fi
  return "$rc"
}

# --- self test ---------------------------------------------------------------------------------
SB_DIRS=""
reap_sb(){ local d pid pgid
  for d in $SB_DIRS; do
    pid=""; [ -r "$d/e.pid" ] && pid="$(tr -dc '0-9' < "$d/e.pid")"
    [ -n "${pid:-}" ] || continue
    case "$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null)" in
      *mesh-mlme-tap*--daemon*) pgid="$(pgid_of "$pid")"; [ -n "$pgid" ] || pgid="$pid"
        kill -TERM -- -"$pgid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null
        sleep 0.4; kill -KILL -- -"$pgid" 2>/dev/null || true;;
    esac
  done
  for d in $SB_DIRS; do rm -rf "$d" 2>/dev/null; done
  SB_DIRS=""
}

self_test(){
  local fails=0
  F(){ echo "  FAIL: $*"; fails=$((fails+1)); }
  # A --test that leaks a listener holding a deleted lock is not green. Reap on EVERY exit path.
  trap 'reap_sb' EXIT INT TERM

  echo "mesh-mlme-tap --test"

  command -v python3 >/dev/null 2>&1 || { echo "  n/a: python3 absent"; return 2; }

  # ---- 1. THE CONSTANTS ARE DERIVED FROM THE HEADER, AND THE ALIAS TRAP IS HANDLED -------------
  local der src
  der="$(derive)" || F "derive: produced nothing"
  src="$(printf '%s\n' "$der" | sed -n 's/^src=//p')"
  case "$src" in header:*|pinned) : ;; *) F "derive: src is '$src', expected header:<path> or pinned";; esac
  local cdeauth cframe cftx
  cdeauth="$(printf '%s\n' "$der" | tr ' ' '\n' | sed -n 's/^cmd:DEAUTHENTICATE=//p')"
  cframe="$( printf '%s\n' "$der" | tr ' ' '\n' | sed -n 's/^cmd:FRAME=//p')"
  cftx="$(   printf '%s\n' "$der" | tr ' ' '\n' | sed -n 's/^cmd:FRAME_TX_STATUS=//p')"
  # 39 is not a guess: it is the command number on the deauth this node CAPTURED on 2026-08-26.
  [ "$cdeauth" = 39 ] || F "derive: DEAUTHENTICATE=$cdeauth, but the frame captured live on this node carried cmd=39"
  [ -n "$cframe" ] && [ -n "$cftx" ] && [ "$(( cframe + 1 ))" = "$cftx" ] \
    || F "derive: FRAME($cframe) and FRAME_TX_STATUS($cftx) must be consecutive"
  # THE ALIAS ARM, driven against a synthetic header THROUGH THIS TOOL'S OWN --derive. `X = Y`
  # takes Y's value and does NOT advance the counter past it — count it as an ordinary enumerator
  # and everything after it shifts by one, silently, which is exactly how the probe this tool grew
  # out of got FRAME wrong by one.
  # It must drive --derive and not a private re-implementation of the parser: the first version of
  # this leg carried its own copy of the regex loop, and a mutant that broke the REAL parser's alias
  # handling left the whole suite green.
  # [[a-lint-that-tests-a-different-predicate-than-the-parser-is-blind]]
  local ah; ah="$(mktemp)" || ah=""
  if [ -n "$ah" ]; then
    { echo 'enum nl80211_commands {'
      echo '	NL80211_CMD_UNSPEC,'
      echo '	NL80211_CMD_NEW_STATION,'
      echo '	NL80211_CMD_DEL_STATION,'
      echo '	NL80211_CMD_AUTHENTICATE,'
      echo '	NL80211_CMD_SYNTHETIC_ALIAS = NL80211_CMD_AUTHENTICATE,'
      echo '	NL80211_CMD_ASSOCIATE,'
      echo '	NL80211_CMD_DEAUTHENTICATE,'
      echo '	NL80211_CMD_DISASSOCIATE,'
      echo '	NL80211_CMD_CONNECT,'
      echo '	NL80211_CMD_ROAM,'
      echo '	NL80211_CMD_DISCONNECT,'
      echo '	NL80211_CMD_FRAME,'
      echo '	NL80211_CMD_FRAME_TX_STATUS,'
      echo '};'
      echo 'enum nl80211_attrs {'
      echo '	NL80211_ATTR_UNSPEC,'
      echo '	NL80211_ATTR_IFINDEX,'
      echo '	NL80211_ATTR_IFNAME,'
      echo '	NL80211_ATTR_MAC,'
      echo '	NL80211_ATTR_FRAME,'
      echo '	NL80211_ATTR_REASON_CODE,'
      echo '	NL80211_ATTR_TIMED_OUT,'
      echo '	NL80211_ATTR_DISCONNECTED_BY_AP,'
      echo '	NL80211_ATTR_ACK,'
      echo '};'
    } > "$ah"
    local ad; ad="$(MESH_MLME_NLH="$ah" bash "$0" --derive 2>/dev/null)"
    _av(){ printf '%s\n' "$ad" | tr ' ' '\n' | sed -n "s/^$1=//p"; }
    case "$(printf '%s\n' "$ad" | sed -n 's/^src=//p')" in
      header:*) : ;;
      *) F "alias arm: --derive fell back to the pinned table on a synthetic header that names every constant it needs — the leg would then be asserting the pinned values, not the parser";;
    esac
    # AUTHENTICATE is the 4th enumerator (0-based 3); the alias after it takes 3 and must NOT
    # advance, so ASSOCIATE is 4, FRAME 10 and FRAME_TX_STATUS 11.
    [ "$(_av cmd:AUTHENTICATE)"    = 3  ] || F "alias arm: AUTHENTICATE=$(_av cmd:AUTHENTICATE), expected 3"
    [ "$(_av cmd:ASSOCIATE)"       = 4  ] || F "alias arm: an aliased enumerator must not advance the counter — ASSOCIATE=$(_av cmd:ASSOCIATE), expected 4. Count the alias as ordinary and EVERY command after it shifts by one, silently."
    [ "$(_av cmd:FRAME)"           = 10 ] || F "alias arm: FRAME=$(_av cmd:FRAME), expected 10"
    [ "$(_av cmd:FRAME_TX_STATUS)" = 11 ] || F "alias arm: FRAME_TX_STATUS=$(_av cmd:FRAME_TX_STATUS), expected 11"
    [ "$(_av attr:MAC)"            = 3  ] || F "alias arm: attr MAC=$(_av attr:MAC), expected 3"
    rm -f "$ah"
  fi

  # ---- 2. THE FRAME DECODER, DRIVEN ON A FRAME THIS NODE ACTUALLY CAPTURED ---------------------
  # Not a hand-authored fixture asserting my own assumptions: this is the deauth caught at
  # 2026-08-26T16:21Z. subtype 12, reason 6, sent BY the AP.
  # [[a-hand-written-fixture-asserts-the-parsers-own-assumptions]]
  local OURMAC="bc:ec:43:43:4a:22"
  local DEAUTH_HEX="c0002400bcec43434a22769b9fabe7b5769b9fabe7b590230600"
  local out
  out="$(python3 -c "$PY_LISTEN" "$(derive | tr '\n' ' ')" /dev/null /dev/null 60 1 1 --decode-frame "$DEAUTH_HEX" "$OURMAC" 2>&1)"
  case "$out" in
    *"subtype=12"*) : ;; *) F "decode: the captured deauth must decode as subtype 12 — got: $out";;
  esac
  case "$out" in
    *"frame_reason=6"*) : ;; *) F "decode: the captured deauth carries reason 6 at offset 24 — got: $out";;
  esac
  case "$out" in
    *"dir=AP->us"*) : ;; *) F "decode: the captured deauth was sent BY THE AP (SA != our MAC) — got: $out";;
  esac
  # TRAP 3, driven twice. First on a REAL frame from the same capture: the AUTH (subtype 11) that
  # reassociated us 13.6s later. Offset 24 on it is not a reason code and must render na.
  local AUTH_HEX="b0002400bcec43434a22769b9fabe7b5769b9fabe7b50000000002000000"
  out="$(python3 -c "$PY_LISTEN" "$(derive | tr '\n' ' ')" /dev/null /dev/null 60 1 1 --decode-frame "$AUTH_HEX" "$OURMAC" 2>&1)"
  case "$out" in
    *"subtype=11"*) : ;; *) F "decode: the captured auth frame must decode as subtype 11 — got: $out";;
  esac
  case "$out" in
    *"frame_reason=na"*) : ;;
    *) F "decode: offset 24 on a subtype-11 auth frame is not a reason code and must render na. Got: $out";;
  esac
  # Second on the ACTION case, which is the one that BITES: the captured deauth with ONLY its
  # frame-control subtype changed 12 -> 13, so every other byte is real. Offset 24 still holds the
  # bytes 06 00 — a decoder that ignored the subtype would report reason 6 here with no error at
  # all, and it would be category 6 / action 0. That is the whole trap in one pair of fixtures.
  local ACTION_HEX="d0002400bcec43434a22769b9fabe7b5769b9fabe7b590230600"
  out="$(python3 -c "$PY_LISTEN" "$(derive | tr '\n' ' ')" /dev/null /dev/null 60 1 1 --decode-frame "$ACTION_HEX" "$OURMAC" 2>&1)"
  case "$out" in
    *"subtype=13"*) : ;; *) F "decode: an action frame must decode as subtype 13 — got: $out";;
  esac
  case "$out" in
    *"frame_reason=na"*) : ;;
    *) F "decode: offset 24 on a subtype-13 action frame is category|action, NOT a reason code — it must render na even though the bytes there are literally 06 00. Got: $out";;
  esac
  # and the direction must flip when WE are the sender
  out="$(python3 -c "$PY_LISTEN" "$(derive | tr '\n' ' ')" /dev/null /dev/null 60 1 1 --decode-frame "$DEAUTH_HEX" "76:9b:9f:ab:e7:b5" 2>&1)"
  case "$out" in *"dir=us->AP"*) : ;; *) F "decode: with the SA as our own MAC the direction must be us->AP — got: $out";; esac
  # An UNMAPPED reason code must read as unmapped, never as absence: a reason we do not have a name
  # for is a fact about our table, not about the radio, and rendering it `na` would silently merge
  # it with "the frame carried no reason at all". Same real frame, reason bytes 06 00 -> e7 03 (999).
  # [[a-collapsed-reason-makes-blind-and-quiet-identical]]
  local UNMAPPED_HEX="c0002400bcec43434a22769b9fabe7b5769b9fabe7b59023e703"
  out="$(python3 -c "$PY_LISTEN" "$(derive | tr '\n' ' ')" /dev/null /dev/null 60 1 1 --decode-frame "$UNMAPPED_HEX" "$OURMAC" 2>&1)"
  case "$out" in
    *"frame_reason=999"*) : ;; *) F "decode: an unmapped reason code must still report its NUMBER — got: $out";;
  esac
  case "$out" in
    *"frame_reason_name=unmapped(999)"*) : ;;
    *) F "decode: a reason code with no name in our table must render unmapped(N), never na — na is what a frame that carries NO reason renders, and collapsing the two makes an unknown code indistinguishable from an absent field. Got: $out";;
  esac
  # a short frame must not be decoded at all rather than read past its tail
  out="$(python3 -c "$PY_LISTEN" "$(derive | tr '\n' ' ')" /dev/null /dev/null 60 1 1 --decode-frame "c000000a" "$OURMAC" 2>&1)"
  case "$out" in *"subtype=na"*) : ;; *) F "decode: a frame shorter than 24 bytes must render na, not a decode — got: $out";; esac

  # ---- 2b. --episode: THE ANSWER A POLLER CANNOT PRODUCE ---------------------------------------
  # Driven as the REAL black box over a synthetic tape, because the two things mesh-link-heal asks
  # for are exactly the two its own cadence destroys: how many episodes really happened, and how
  # long the association was really down.
  local eb; eb="$(mktemp -d)" || eb=""
  if [ -n "$eb" ]; then
    local EN E0; EN="$(now_epoch)"; E0=$(( EN - 300 ))
    {
      printf '%s ts=T1 ev=DEAUTHENTICATE cmd=39 if=w ifindex=8 peer=a dir=AP->us reason=na reason_name=na frame_reason=6 frame_reason_name=X by_ap=na timed_out=na subtype=12 subtype_name=deauth :: framehex=aa\n' $(( E0 + 10 ))
      printf '%s ts=T2 ev=DISCONNECT cmd=48 if=w ifindex=8 peer=a dir=na reason=6 reason_name=X frame_reason=na frame_reason_name=na by_ap=yes timed_out=na subtype=na subtype_name=na :: framehex=na\n' $(( E0 + 10 ))
      printf '%s ts=T3 ev=CONNECT cmd=46 if=w ifindex=8 peer=a dir=na reason=na reason_name=na frame_reason=na frame_reason_name=na by_ap=no timed_out=na subtype=na subtype_name=na :: framehex=na\n' $(( E0 + 24 ))
      printf '%s ts=T4 ev=DEAUTHENTICATE cmd=39 if=w ifindex=8 peer=a dir=AP->us reason=na reason_name=na frame_reason=6 frame_reason_name=X by_ap=na timed_out=na subtype=12 subtype_name=deauth :: framehex=bb\n' $(( E0 + 100 ))
      printf '%s ts=T5 ev=CONNECT cmd=46 if=w ifindex=8 peer=a dir=na reason=na reason_name=na frame_reason=na frame_reason_name=na by_ap=no timed_out=na subtype=na subtype_name=na :: framehex=na\n' $(( E0 + 103 ))
    } > "$eb/e.log"
    echo $(( E0 - 10 )) > "$eb/e.started"
    printf '%s pid=1 inode=1 groups=0x00200000 mlme=1 drops=0\n' "$EN" > "$eb/e.cov"
    : > "$eb/e.lock"; ( exec 9>>"$eb/e.lock"; flock 9; sleep 30 ) & local _elk=$!
    sleep 0.4
    _ep(){ MESH_MLME_LOG="$eb/e.log" MESH_MLME_COVF="$eb/e.cov" MESH_MLME_LOCK="$eb/e.lock" \
           MESH_MLME_STARTF="$eb/e.started" bash "$0" --episode "$1" "$2"; }
    # (a) TWO episodes, and the dark is their SUM (14s + 3s), not the window and not the stride.
    #     A 60s poller would see at most ONE of these and would report a bound quantised to 60.
    out="$(_ep "$E0" "$EN")"
    case "$out" in
      *"episodes=2"*"dark=17"*"coverage=full"*) : ;;
      *) F "--episode: two closed episodes of 14s and 3s must read episodes=2 dark=17 coverage=full — got: $out";;
    esac
    # (b) A DEAUTH AND THE DISCONNECT IT CAUSES ARE ONE EPISODE. They are 1ms apart and counting
    #     log ROWS instead of episodes would treble every outage. This is why the count is an
    #     open/close walk and not a `wc -l`.
    case "$out" in *"episodes=3"*) F "--episode: a deauth and its DISCONNECT counted as separate episodes — the count must be an open/close walk, not a row count";; esac
    # (c) A window the listener did not cover must render every field na and SAY WHY. A tap that was
    #     not listening reporting episodes=0 is a fabricated calm in the one place a human goes to
    #     ask what happened. [[a-blindness-sentinel-fused-as-a-reading]]
    out="$(_ep $(( E0 - 5000 )) $(( E0 - 4000 )))"
    case "$out" in
      *"episodes=na"*"dark=na"*"coverage=partial:"*) : ;;
      *) F "--episode: a window entirely before the listener started must be na with a partial coverage word, never 0 — got: $out";;
    esac
    case "$out" in *"episodes=0"*) F "--episode: an UNCOVERED window rendered episodes=0 — absence of evidence rendered as evidence of absence";; esac
    # (d) …and the covered-portion arithmetic is an OVERLAP, not the listener's age. The first draft
    #     printed the age and produced `partial:2445s/100s` — more covered than the window is long.
    case "$out" in *"partial:0s/1000s"*) : ;; *) F "--episode: a window ending before the listener started is 0s covered of its own length — got: $out";; esac
    # (e) A DEAD listener is blind, never quiet — the strongest form of (c).
    kill "$_elk" 2>/dev/null; wait "$_elk" 2>/dev/null
    out="$(_ep "$E0" "$EN")"
    case "$out" in
      *"episodes=na"*"coverage=blind"*) : ;;
      *) F "--episode: with no listener holding the lock the window is BLIND and every field na — got: $out";;
    esac
    rm -rf "$eb"
  fi

  # ---- 3. THE VERDICT TABLE --------------------------------------------------------------------
  # args: live start now win loss allev recovered cfresh cmlme ddelta lossext
  case "$(decide 1 100 1000 na  0 0 0 1 1 0 0)"  in BASELINE\|0\|*) : ;; *) F "decide: no baseline yet must be BASELINE, not a claim";; esac
  case "$(decide 0 100 1000 300 0 0 0 1 1 0 0)"  in UNKNOWN\|2\|blind\|*) : ;; *) F "decide: a dead listener must be UNKNOWN/blind, never QUIET";; esac
  case "$(decide 1 100 1000 300 0 0 0 0 1 0 0)"  in UNKNOWN\|2\|no-sample\|*) : ;; *) F "decide: a stale coverage sample must be UNKNOWN, never QUIET";; esac
  case "$(decide 1 100 1000 300 0 0 0 1 0 0 0)"  in UNKNOWN\|2\|unsubscribed\|*) : ;; *) F "decide: an unsubscribed listener must be UNKNOWN, never QUIET";; esac
  case "$(decide 1 100 1000 300 0 0 0 1 1 3 0)"  in UNKNOWN\|2\|drops=3\|*) : ;; *) F "decide: a nonzero Drops delta must be UNKNOWN, never QUIET";; esac
  case "$(decide 1 900 1000 300 0 0 0 1 1 0 0)"  in UNKNOWN\|2\|partial:*) : ;; *) F "decide: a listener that covered only part of the window must be UNKNOWN";; esac
  case "$(decide 1 900 1000 300 2 2 0 1 1 0 2)"  in EVENTS\|1\|partial:*) : ;; *) F "decide: loss events under partial coverage are a FLOOR, verdict EVENTS";; esac
  case "$(decide 1 100 1000 300 0 0 0 1 1 0 0)"  in QUIET\|0\|full\|*) : ;; *) F "decide: subscribed, covered, no drops, no events must be QUIET";; esac
  case "$(decide 1 100 1000 300 0 4 0 1 1 0 0)"  in QUIET\|0\|full\|*"non-loss"*) : ;; *) F "decide: non-loss MLME events alone must still be QUIET";; esac
  case "$(decide 1 100 1000 300 3 5 3 1 1 0 3)"  in EVENTS\|1\|full\|*) : ;; *) F "decide: loss events in a covered window must be EVENTS";; esac
  # the self-distrust arm: link-heal closed an episode we never saw the opening of
  case "$(decide 1 100 1000 300 0 0 2 1 1 0 0)"  in GAP\|2\|full\|*) : ;; *) F "decide: a RECOVERED inside a fully-covered window with no loss event must be GAP (distrust THIS tap)";; esac
  # ...but not when the opening deauth is merely in the preceding HEAL_LAG: that is a STRADDLE, an
  # attribution fact, not a disagreement. A self-distrust arm that accuses itself is noise.
  case "$(decide 1 100 1000 300 0 0 2 1 1 0 2)"  in EVENTS\|1\|full\|STRADDLE:*) : ;; *) F "decide: a RECOVERED whose opening loss event sits in the lookback must be STRADDLE, not GAP";; esac
  # ...and GAP must not fire when we DID see the loss event
  case "$(decide 1 100 1000 300 2 2 2 1 1 0 2)"  in GAP\|*) F "decide: GAP fired even though the tap named the loss event";; esac
  # ...nor under partial coverage, where the episode may sit in the head we never covered
  case "$(decide 1 900 1000 300 0 0 2 1 1 0 0)"  in UNKNOWN\|2\|partial:*) : ;; *) F "decide: a RECOVERED under partial coverage must be UNKNOWN, not GAP";; esac

  # ---- 4. THE LOG READERS, against a synthetic tape --------------------------------------------
  local rb; rb="$(mktemp -d)" || rb=""
  if [ -n "$rb" ]; then
    local n0; n0="$(now_epoch)"
    {
      printf '%s ts=x ev=DEAUTHENTICATE cmd=39 if=w ifindex=8 peer=a dir=AP->us reason=na reason_name=na frame_reason=6 frame_reason_name=CLASS2_FRAME_FROM_NONAUTH_STA by_ap=na timed_out=na subtype=12 subtype_name=deauth :: framehex=aa\n' "$(( n0 - 10 ))"
      printf '%s ts=x ev=DISCONNECT cmd=48 if=w ifindex=8 peer=a dir=na reason=6 reason_name=CLASS2_FRAME_FROM_NONAUTH_STA frame_reason=na frame_reason_name=na by_ap=yes timed_out=na subtype=na subtype_name=na :: framehex=na\n' "$(( n0 - 9 ))"
      printf '%s ts=x ev=CONNECT cmd=46 if=w ifindex=8 peer=a dir=na reason=na reason_name=na frame_reason=na frame_reason_name=na by_ap=no timed_out=na subtype=na subtype_name=na :: framehex=na\n' "$(( n0 - 8 ))"
      printf '%s ts=x ev=DEAUTHENTICATE cmd=39 if=w ifindex=8 peer=a dir=us->AP reason=na reason_name=na frame_reason=3 frame_reason_name=DEAUTH_LEAVING by_ap=na timed_out=na subtype=12 subtype_name=deauth :: framehex=bb\n' "$(( n0 - 7 ))"
      printf '%s ts=x ev=DISCONNECT cmd=48 if=w ifindex=8 peer=a dir=na reason=na reason_name=na frame_reason=na frame_reason_name=na by_ap=no timed_out=na subtype=na subtype_name=na :: framehex=na\n' "$(( n0 - 6 ))"
      printf '%s ts=x ev=DEAUTHENTICATE cmd=39 if=w ifindex=8 peer=a dir=AP->us reason=na reason_name=na frame_reason=999 frame_reason_name=unmapped(999) by_ap=na timed_out=na subtype=12 subtype_name=deauth :: framehex=cc\n' "$(( n0 - 900 ))"
    } > "$rb/e.log"
    local got
    # The readers are functions in THIS shell; point them at the fixture directly rather than
    # re-implementing the scan in the test.
    local _saveLOG="$LOG"; LOG="$rb/e.log"
    got="$(count_loss "$(( n0 - 60 ))")"
    [ "$got" = 4 ] || F "count_loss: expected 4 loss events in the last 60s (2 deauth + 2 disconnect), got '$got'"
    got="$(count_all "$(( n0 - 60 ))")"
    [ "$got" = 5 ] || F "count_all: expected 5 MLME events in the last 60s, got '$got'"
    got="$(dir_split "$(( n0 - 60 ))")"
    [ "$got" = "2 2 0" ] || F "dir_split: expected '2 2 0' — a DISCONNECT carries no management frame, so its direction comes from by_ap (yes -> AP->us, no -> us->AP), which is the SAME fact the frame would have carried and not a guess. Got '$got'"
    got="$(count_loss "$(( n0 - 60 ))")"
    local gotext; gotext="$(count_loss "$(( n0 - 1000 ))")"
    [ "$gotext" = 5 ] || F "the lookback must reach the older event: expected 5 over 1000s, got '$gotext'"
    got="$(reasons_since "$(( n0 - 60 ))" 6)"
    case "$got" in *"6(CLASS2_FRAME_FROM_NONAUTH_STA)"*) : ;; *) F "reasons_since: the wire reason must be named — got '$got'";; esac
    got="$(reasons_since "$(( n0 - 1000 ))" 6)"
    case "$got" in *"unmapped(999)"*) : ;; *) F "reasons_since: an unmapped reason code must read as unmapped, never as absence — got '$got'";; esac
    got="$(names_since "$(( n0 - 60 ))" 6)"
    case "$got" in *DEAUTHENTICATE*CONNECT*) : ;; *) F "names_since: expected the kinds in first-seen order — got '$got'";; esac
    LOG="$_saveLOG"
    rm -rf "$rb"
  fi

  # ---- 5. link-heal's tape, read by POSITION not by substring ----------------------------------
  local hb; hb="$(mktemp -d)" || hb=""
  if [ -n "$hb" ]; then
    local n0 ts1 ts2; n0="$(now_epoch)"
    ts1="$(date -u -d @"$(( n0 - 30 ))" +%FT%TZ)"; ts2="$(date -u -d @"$(( n0 - 3000 ))" +%FT%TZ)"
    {
      printf '%s RECOVERED shape=DEAUTHED-CARRIER down_checks=1\n' "$ts1"
      printf '%s ACTION driver reload note="a RECOVERED happened earlier"\n' "$ts1"
      printf '%s RECOVERED shape=WEDGED down_checks=9\n' "$ts2"
    } > "$hb/h.log"
    local _s="$HEALLOG"; HEALLOG="$hb/h.log"
    local g; g="$(heal_recovered_since "$(( n0 - 300 ))")"
    [ "$g" = 1 ] || F "heal_recovered_since: expected 1 in the last 300s — the ACTION row QUOTES the word RECOVERED in its free text and must not be counted (field 2 only). Got '$g'"
    g="$(heal_recovered_since "$(( n0 - 4000 ))")"
    [ "$g" = 2 ] || F "heal_recovered_since: expected 2 over 4000s, got '$g'"
    HEALLOG="$_s"; rm -rf "$hb"
  fi

  # ---- 6. LABEL AXIS: field 1 of the state line must be a VERDICT, not a datum ------------------
  # Borrowed from mesh-reflex-health's OWN predicate — a lookalike regex here would be a guard on a
  # different grammar than the one that actually decides.
  local rh rhsrc lbl
  rh="$(command -v mesh-reflex-health 2>/dev/null)"; [ -n "$rh" ] || rh="$(dirname "$0")/mesh-reflex-health"
  if [ ! -r "$rh" ]; then
    echo "  note: mesh-reflex-health unreadable ('$rh') — the label-axis leg is SKIPPED, not passed"
  else
    rhsrc="$(sed -n '/^ow_label(){/,/^}/p;/^ow_label_is_datum(){/,/^}/p' "$rh")"
    case "$rhsrc" in
      *ow_label\(\)*ow_label_is_datum\(\)*) : ;;
      *) F "label axis: could not lift ow_label/ow_label_is_datum out of $rh — the predicate moved or was renamed; re-point this leg rather than falling back to a private copy"; rhsrc="";;
    esac
    if [ -n "$rhsrc" ]; then
      local lsb; lsb="$(mktemp -d)" || lsb=""
      if [ -n "$lsb" ]; then
        ( MESH_MLME_STATE="$lsb/e.state" MESH_MLME_LOG="$lsb/e.log" MESH_MLME_COVF="$lsb/e.cov" \
          MESH_MLME_BASE="$lsb/e.base" MESH_MLME_STARTF="$lsb/e.started" MESH_MLME_PIDF="$lsb/e.pid" \
          MESH_MLME_MARK="$lsb/e.posted" MESH_MLME_CHAT=0 \
          bash "$0" --check >"$lsb/e.out" 2>/dev/null ) || true
        sed -n '1p' "$lsb/e.out" > "$lsb/e.state" 2>/dev/null
        if [ ! -s "$lsb/e.state" ]; then
          F "label axis: the read pass emitted no line, so the field-1 assertion is vacuous"
        else
          lbl="$(eval "$rhsrc"; ow_label "$lsb/e.state")"
          if (eval "$rhsrc"; ow_label_is_datum "$lbl"); then
            F "label axis: field 1 of the state line is a DATUM ('$lbl'), not a verdict — mesh-reflex-health would report this reflex UNWATCHABLE and make NO frozen-value claim about it. Keep the verdict first and the stamp in at=."
          fi
          # The alphabet is derived from this file's OWN emitters, never hand-copied: an enumerated
          # list rots the first time decide() learns a new word, then quietly accepts anything.
          local alpha; alpha="$(grep -oE "printf '[A-Z]+\\|" "$0" | sed "s/^printf '//;s/|$//" | LC_ALL=C sort -u | tr '\n' ' ')"
          case " $alpha " in *" $lbl "*) : ;; *) F "label axis: field 1 is '$lbl', which is none of this tool's own emitted verdicts ($alpha)";; esac
          grep -q ' at=[0-9]\{4\}-[0-9]\{2\}-[0-9]\{2\}T' "$lsb/e.state" || F "label axis: the stamp did not survive as an at= field — moving the verdict to front must not COST the timestamp: $(cat "$lsb/e.state")"
        fi
        rm -rf "$lsb"
      fi
    fi
  fi

  # ---- 7. THE REAL LISTENER ARM ----------------------------------------------------------------
  # A string check is not a sense. This raises a REAL listener on a REAL nl80211 socket and asserts
  # its subscription out of the kernel's own table — the same read the daemon gates on. It touches
  # no radio: subscribing to a multicast group is passive, and this tool has no actuator to drive.
  # We do NOT provoke a disconnect: the dongle is this node's sole uplink and forcing one is
  # self-defeating by the CLAUDE.md gate.
  local sb; sb="$(mktemp -d)" || { echo "  n/a: mktemp"; return 2; }
  SB_DIRS="$sb"
  local envs="MESH_MLME_LOG=$sb/e.log MESH_MLME_COVF=$sb/e.cov MESH_MLME_LOCK=$sb/e.lock MESH_MLME_STARTF=$sb/e.started MESH_MLME_PIDF=$sb/e.pid MESH_MLME_DLOG=$sb/e.dlog MESH_MLME_BASE=$sb/e.base MESH_MLME_STATE=$sb/e.state MESH_MLME_MARK=$sb/e.posted MESH_MLME_CHAT=0 MESH_MLME_COV_S=2"
  # shellcheck disable=SC2086
  if ! env $envs bash "$0" --ensure >/dev/null 2>&1; then
    # REFUSED and UNREACHABLE are different claims and one exit code cannot carry both. A node with
    # no cfg80211 has no nl80211 family at all and that is an honest n/a; a listener that resolved
    # the family, joined the group and then could not read its OWN subscription back is a DEFECT in
    # this tool, and degrading it to n/a would make the whole real arm silently skippable — which
    # is exactly how a mutant that reads the wrong /proc column stayed green.
    # [[an-exit-code-cannot-carry-the-refused-vs-unreachable-distinction]]
    # POLARITY: default to RED and exempt only the NAMED absences. An allowlist of failure strings
    # fails toward silence — the first version listed `UNSUBSCRIBED` as the only defect signal, and
    # a listener that subscribed and then died in its sampler fell straight through into n/a, so a
    # doubly-broken build read as "no wifi on this node" and the whole real arm was skipped.
    # [[an-exclusion-allowlist-fails-toward-silence-so-invert-the-polarity]]
    if grep -qE 'NLMSG_ERROR resolving|no multicast group named' "$sb/e.dlog" 2>/dev/null; then
      echo "  n/a: nl80211 does not resolve here (no cfg80211?) — the real arm cannot run and a string check would not substitute:"
      tail -3 "$sb/e.dlog" 2>/dev/null; reap_sb; return 2
    fi
    F "real arm: the listener would not stay up, and the reason is not one of the named absences (no nl80211 family / no such group) — an unexplained failure to listen is this tool being wrong, not the organ being missing. dlog: $(tail -2 "$sb/e.dlog" 2>/dev/null | tr '\n' ' ')"
    if [ -s "$sb/e.cov" ]; then
      grep -q 'mlme=0' "$sb/e.cov" 2>/dev/null \
        && F "real arm: a coverage sample reads mlme=0 — the kernel does not agree this listener is subscribed to the group it joined (Groups is FIELD 4 of /proc/net/netlink; a wrong column reads a live subscription as none and never errors)"
    fi
    reap_sb; trap - EXIT INT TERM; echo "  $fails leg(s) RED"; return 1
  fi
  local i
  for i in $(seq 1 20); do [ -s "$sb/e.cov" ] && break; sleep 0.3; done
  grep -q 'SUBSCRIBED' "$sb/e.cov" 2>/dev/null \
    || F "real arm: the listener wrote no SUBSCRIBED sample — it must assert its own group bit out of /proc/net/netlink before listening (see $sb/e.cov, $sb/e.dlog)"
  grep -q 'mlme=1' "$sb/e.cov" 2>/dev/null \
    || F "real arm: the kernel does not report the mlme bit set for this listener's own socket"
  # ...and no sample may EVER carry mlme=0 while the listener is still running: the gate's whole job
  # is that a listener whose bit is clear stops rather than wearing `up`.
  grep -q 'mlme=0' "$sb/e.cov" 2>/dev/null \
    && F "real arm: a coverage sample reads mlme=0 and the listener kept running — a listener that is not subscribed renders identically to a quiet radio and must exit, not sample on"
  # the groups mask the kernel reports must be non-zero — field 4, TRAP 2. A wrong column reads
  # 0x00000000 off a socket that is delivering events, and it FAILS TOWARD FALSE-ABSENCE.
  local gm; gm="$(sed -n 's/.*groups=\(0x[0-9a-f]*\).*/\1/p' "$sb/e.cov" | tail -1)"
  case "${gm:-0x00000000}" in 0x00000000|'') F "real arm: groups read as $gm — /proc/net/netlink Groups is FIELD 4; a wrong column reads a subscribed socket as unsubscribed and never errors";; esac
  # the coverage sampler must keep publishing (a wedged listener must age into UNKNOWN, not calm)
  local c1 c2; c1="$(wc -l < "$sb/e.cov")"; sleep 3; c2="$(wc -l < "$sb/e.cov")"
  [ "${c2:-0}" -gt "${c1:-0}" ] 2>/dev/null || F "real arm: the coverage sampler published no new sample in 3s at COV_S=2 — a listener that stops sampling must age into UNKNOWN, and it cannot if it never samples"
  # A read pass over the live listener must produce a parseable verdict line. The FIRST pass can
  # only ever be BASELINE (a live tap has no history), so lay the baseline with a write pass and
  # then read across a real window — otherwise every arm below is asserted against a tool that has
  # not yet claimed anything, and the blind leg in particular would pass for the wrong reason.
  # shellcheck disable=SC2086
  env $envs bash "$0" --run >/dev/null 2>&1
  sleep 2
  # shellcheck disable=SC2086
  out="$(env $envs bash "$0" --check 2>&1 | head -1)"
  case "$out" in QUIET*|EVENTS*|UNKNOWN*|GAP*) : ;; *) F "real arm: --check over a live listener with a baseline laid emitted '$out'";; esac
  case "$out" in BASELINE*) F "real arm: the baseline was not laid by the write pass, so every arm below would be vacuous";; esac
  case "$out" in *coverage=*) : ;; *) F "real arm: the reading carries no coverage term — silence without coverage is not a reading";; esac
  case "$out" in *csrc=header:*) : ;; *) F "real arm: the reading must NAME where its constants came from — got '$out'";; esac
  # shellcheck disable=SC2086
  env $envs bash "$0" --stop >/dev/null 2>&1 || F "real arm: --stop failed to stop the listener it started"
  # and once stopped, the reading must go UNKNOWN/blind — never QUIET. A dead listener's empty log
  # is a fabricated calm, and this is the leg that proves the gate can FAIL.
  # shellcheck disable=SC2086
  out="$(env $envs bash "$0" --check 2>&1 | head -1)"
  case "$out" in UNKNOWN*blind*) : ;; *) F "real arm: with the listener stopped the reading must be UNKNOWN/blind, got '$out'";; esac

  # ---- 8. THE NEGATIVE ARM: refuse to listen blind ---------------------------------------------
  # A gate you have not seen fail is not a gate. Point the listener at a group nl80211 does not
  # advertise: it must exit non-zero, say UNSUBSCRIBED, and write NO event log.
  local sb2; sb2="$(mktemp -d)" || sb2=""
  if [ -n "$sb2" ]; then
    SB_DIRS="$SB_DIRS $sb2"
    local envs2="MESH_MLME_LOG=$sb2/e.log MESH_MLME_COVF=$sb2/e.cov MESH_MLME_LOCK=$sb2/e.lock MESH_MLME_STARTF=$sb2/e.started MESH_MLME_PIDF=$sb2/e.pid MESH_MLME_DLOG=$sb2/e.dlog MESH_MLME_GROUP=mlme-no-such-group"
    # shellcheck disable=SC2086
    env $envs2 bash "$0" --daemon >"$sb2/e.dlog" 2>&1
    local rc2=$?
    [ "$rc2" -ne 0 ] || F "negative arm: a listener asked for a group nl80211 does not advertise exited 0 — it must refuse rather than listen blind"
    grep -q 'UNSUBSCRIBED\|no multicast group' "$sb2/e.dlog" 2>/dev/null \
      || F "negative arm: the refusal must SAY why it refused (see $sb2/e.dlog)"
    [ ! -s "$sb2/e.log" ] || F "negative arm: a refusing listener must write no event log — a blind listener's empty log is a fabricated calm, but a NON-empty one is worse"
  fi

  reap_sb; trap - EXIT INT TERM
  if [ "$fails" = 0 ]; then echo "  all legs green (constants derived from ${src}, real listener asserted against the kernel's own table)"; return 0; fi
  echo "  $fails leg(s) RED"; return 1
}

# --- dispatch -------------------------------------------------------------------------------------
case "${1:---run}" in
  --run|'')   ensure >/dev/null 2>&1; read_pass 1;;
  --check)    read_pass 0;;
  --status)   if [ -r "$STATE" ]; then cat "$STATE"; else echo "no reading yet ($STATE absent)"; exit 2; fi;;
  --coverage) now="$(now_epoch)"; read -r f m d dd g age <<<"$(cov_terms "$(( now - 300 ))" "$now")"
              live=0; listener_alive && live=1
              st=na; [ -r "$STARTF" ] && st="$(tr -dc '0-9' < "$STARTF")"; [ -n "$st" ] || st=na
              printf 'listener=%s fresh=%s mlme=%s drops=%s drops-delta=%s groups=%s sample-age=%ss listener-age=%ss constants-from=%s\n' \
                "$( [ "$live" = 1 ] && echo up || echo down )" "$f" "$m" "$d" "$dd" "$g" "$age" \
                "$( [ "$st" = na ] && echo na || echo $(( now - st )) )" "$(derive_src)";;
  --tail)     n="${2:-20}"; for f in "$LOG.1" "$LOG"; do [ -f "$f" ] && cat "$f"; done 2>/dev/null | tail -n "$n";;
  --derive)   derive;;
  --episode)  episode_window "${2:-x}" "${3:-x}";;
  --daemon)   daemon;;
  --ensure)   ensure;;
  --stop)     stop_listener;;
  --test)     self_test;;
  -h|--help)  sed -n '11,140p' "$0" | sed 's/^# \{0,1\}//';;
  *)          echo "unknown flag: $1 (try --help)" >&2; exit 2;;
esac
