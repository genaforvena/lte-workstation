#!/usr/bin/env bash
# Guarded pool-0 candidate for the verified tiny-fleet adapters.
set -u
root="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
[ -f "$root/scripts/tiny_fleet_pool.py" ] || root="${MESH_REPO:-$HOME/lte-workstation}"
venv="${MESH_TINY_FLEET_PYTHON:-/home/mesh-home/tiny-fleet/.venv/bin/python}"
if [ -x "$venv" ]; then
  exec "$venv" "$root/scripts/tiny_fleet_pool.py" "$@"
fi
exec python3 "$root/scripts/tiny_fleet_pool.py" "$@"
