#!/usr/bin/env bash
# orphan-ok: on-demand census instrument — a mind runs it when it wants to know whether a
#            candidate fused sense is earned; it writes no state and drives nothing.
# mesh-synergy — does a PAIR of axes carry what NEITHER carries alone? (operator 2026-08-30)
#
# WHY. The operator corrected this window's goal: a sense should come from a CORRELATION across
# several, possibly heterogeneous axes, not from a raw read of one parameter. Nine of this mesh's
# eighteen fused organs already carry hand-written JOINT rules — a verdict that fires only on a
# combination no single axis reaches (mesh-motion-fuse:217, mesh-therm-regime:129, mesh-body-context:55,
# mesh-social-fusion:86, mesh-interruptibility:248, mesh-operator-state:532, mesh-activity:156,
# mesh-room-sense:719, mesh-burn-window:107). NOT ONE of them has ever been shown a NULL. This is that
# null. It is a SENSE about the sensorium: it installs nothing and changes no verdict.
#
# THE QUESTION, made falsifiable. For every ordered triple (T, A, B) of axes on a tape: predict T's
# NEXT value, out of sample, from four nested models —
#     persist  {T}        · the current value alone (senses are sticky; this is the baseline that kills)
#     +A       {T,A} · +B  {T,B}          · one axis added
#     +AB      {T,A,B}                    · the pair added
# joint gain := acc(+AB) − max(acc(persist), acc(+A), acc(+B)).  A pair is EARNED only if it beats
# EVERY simpler model. Beating the better single axis while losing to persistence is worth nothing —
# it means knowing the current value already told you more than both new axes together.
#
# WHY OUT OF SAMPLE, AND WHY BLOCKED. Plug-in mutual information rises with alphabet size, so
# I(A,B;T') ≥ max(I(A;T'),I(B;T')) BY CONSTRUCTION — an in-sample synergy number is a measure of how
# many cells the pair has, not of what it knows. Held-out accuracy has the opposite bias: an
# over-parameterised joint model does WORSE out of sample. Folds are CONTIGUOUS, never random: adjacent
# rows on a sensor tape are autocorrelated, and a random split leaks the answer across the cut.
#
# WHY A NULL IS NOT OPTIONAL. Cross-validation noise alone puts some triples above zero. The null here
# is a CIRCULAR SHIFT of B, which preserves B's marginals AND its autocorrelation while destroying its
# relation to everything else — a plain shuffle would destroy the autocorrelation too and hand the real
# data an unearned win. The finding threshold is the null's own upper quantile over THIS corpus, never
# a pinned constant.
#
# WHAT A NULL RESULT MEANS. "Indistinguishable from the null" is a real answer and the honest one to
# publish: it says a fused sense built on these axes at this cadence would be reporting its own noise.
#
#   mesh-synergy [tape]        census over a TSV tape (default ~/.mesh/sensor-tape.tsv)
#   mesh-synergy --top N       show N strongest triples (default 20)
#   mesh-synergy --nulls K     null replicates (default 3; each is a full pass)
#   mesh-synergy --test        self-test: a PLANTED pure-XOR pair MUST be found, and a corpus of
#                              pure noise MUST come back indistinguishable from its own null
set -uo pipefail
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
export PATH="$PATH:$HOME/.local/bin"

TAPE_DEFAULT="${MESH:-$HOME/.mesh}/sensor-tape.tsv"
TOP="${SYNERGY_TOP:-20}"; NULLS="${SYNERGY_NULLS:-3}"; MODE=census; TAPE=""; LEVELS="${SYNERGY_LEVELS:-0}"
while [ $# -gt 0 ]; do
  case "$1" in
    --top) TOP="${2:-20}"; shift 2;;
    --nulls) NULLS="${2:-3}"; shift 2;;
    --levels) LEVELS="${2:-0}"; shift 2;;
    --test) MODE=test; shift;;
    -h|--help) sed -n '3,40p' "$0"; exit 0;;
    -*) echo "mesh-synergy: unknown flag $1" >&2; exit 2;;
    *) TAPE="$1"; shift;;
  esac
done
[ -n "$TAPE" ] || TAPE="$TAPE_DEFAULT"

command -v python3 >/dev/null 2>&1 || { echo "mesh-synergy: python3 absent — this instrument cannot run here"; exit 2; }

PY_CENSUS='
import sys, os, itertools, statistics, collections, datetime, random
TAPE=sys.argv[1]; TOP=int(sys.argv[2]); NULLS=int(sys.argv[3])
LEVELS=int(sys.argv[4]) if len(sys.argv)>4 else 0
MISSING={"NOLOG","STALE","UNKNOWN","","-","n/a","na","?"}   # honest-fusion: not a value, never a level
FOLDS=5; MINN=int(os.environ.get("SYNERGY_MINN","200"))
recs=[]; names=None
try: fh=open(TAPE)
except OSError as e: print("tape unreadable: %s"%e); sys.exit(2)
for line in fh:
    line=line.rstrip("\n")
    if not line or line.startswith("#"): continue
    f=line.split("\t")
    if names is None: names=f; continue
    if len(f)!=len(names): continue
    try: t=datetime.datetime.strptime(f[0],"%Y-%m-%dT%H:%M:%SZ")
    except ValueError: continue
    recs.append((t,f))
if names is None or len(recs)<MINN:
    print("tape carries %d usable rows (< %d) — UNKNOWN, not a null result"%(len(recs),MINN)); sys.exit(2)
recs.sort(key=lambda r:r[0])
SENSES=names[1:]; NS=len(SENSES); N=len(recs)
# LEVELS>0 quantile-bins any column whose readings are all numbers. A quantity has to be discretised
# before a cell-counting model can hold it, and THE NUMBER OF LEVELS IS THE EXPERIMENT: this census
# came back null on a tape of verdicts already coarsened to 2-10 categories upstream, so re-asking the
# same question at several resolutions is how you tell a quiet sensorium from a tape that threw the
# signal away. Edges come from the columns OWN marginal distribution and carry no information about
# any target, so binning cannot leak the answer into the fold.
codes=[]; alpha=[]; present=[]; kinds=[]
for j in range(NS):
    raw=[(f[j+1] if j+1<len(f) else "") for t,f in recs]
    vals=[v for v in raw if v not in MISSING]
    numeric=bool(vals) and LEVELS>0
    if numeric:
        try: nv=[float(v) for v in vals]
        except ValueError: numeric=False
    if numeric:
        sv=sorted(nv)
        edges=[sv[int(q*(len(sv)-1))] for q in [i/LEVELS for i in range(1,LEVELS)]]
        edges=sorted(set(edges))
        def lvl(x,e=edges):
            k=0
            for b in e:
                if x>b: k+=1
                else: break
            return k
        c=[]
        for v in raw:
            c.append(-1 if v in MISSING else lvl(float(v)))
        codes.append(c); alpha.append(len(set(x for x in c if x>=0))); kinds.append("q%d"%LEVELS)
    else:
        m={}; c=[]
        for v in raw: c.append(-1 if v in MISSING else m.setdefault(v,len(m)))
        codes.append(c); alpha.append(len(m)); kinds.append("tok")
    present.append(sum(1 for x in c if x>=0))
gaps=[(recs[i+1][0]-recs[i][0]).total_seconds() for i in range(N-1)]
cad=statistics.median(gaps) if gaps else 0
MAXGAP=2.5*cad if cad>0 else 0
# ADJACENCY: a successor exists only if the next row is really the next TICK. A hole in the tape on a
# node that power-cycles is an OUTAGE, not a slow sample; pairing across it invents a transition.
succ=[(i+1) if (i+1<N and MAXGAP>0 and 0<(recs[i+1][0]-recs[i][0]).total_seconds()<=MAXGAP) else -1
      for i in range(N)]
adj=sum(1 for s in succ if s>=0)
print("tape        : %s"%TAPE)
print("coverage    : rows=%d  span=%sZ..%sZ  cadence_median=%.0fs  adjacent_successors=%d/%d (%.1f%%)"
      %(N,recs[0][0].isoformat(),recs[-1][0].isoformat(),cad,adj,N,100.0*adj/N))
print("axes        : "+"  ".join("%s[%s](k=%d,%.0f%%)"%(s,kd,a,100.0*p/N) for s,kd,a,p in zip(SENSES,kinds,alpha,present)))

def census(shift):
    res=[]
    for T in range(NS):
        cT=codes[T]
        for A,B in itertools.combinations([j for j in range(NS) if j!=T],2):
            cA=codes[A]
            cB=codes[B] if shift==0 else codes[B][shift:]+codes[B][:shift]
            idx=[i for i in range(N) if succ[i]>=0 and cT[i]>=0 and cA[i]>=0 and cB[i]>=0 and cT[succ[i]]>=0]
            n=len(idx)
            if n<MINN: continue
            y=[cT[succ[i]] for i in idx]
            kp=[(cT[i],) for i in idx]; ka=[(cT[i],cA[i]) for i in idx]
            kb=[(cT[i],cB[i]) for i in idx]; kj=[(cT[i],cA[i],cB[i]) for i in idx]
            hits={"persist":0,"+A":0,"+B":0,"+AB":0}
            fold=n//FOLDS
            for f in range(FOLDS):
                lo=f*fold; hi=(f+1)*fold if f<FOLDS-1 else n
                tr=list(range(0,lo))+list(range(hi,n))
                tab={}
                for nm,k in (("persist",kp),("+A",ka),("+B",kb),("+AB",kj)):
                    d=collections.defaultdict(collections.Counter)
                    for p in tr: d[k[p]][y[p]]+=1
                    tab[nm]={kk:cc.most_common(1)[0][0] for kk,cc in d.items()}
                gc=collections.Counter(y[p] for p in tr).most_common(1)[0][0]
                for p in range(lo,hi):
                    # BACKOFF: an unseen cell falls back to its parent model, never to a guess — so the
                    # joint model is never punished for sparsity it can route around, and never rewarded
                    # for cells it has not actually seen.
                    pr=tab["persist"].get(kp[p],gc)
                    if pr==y[p]: hits["persist"]+=1
                    for nm,k in (("+A",ka),("+B",kb)):
                        v=tab[nm].get(k[p]); v=pr if v is None else v
                        if v==y[p]: hits[nm]+=1
                    v=tab["+AB"].get(kj[p])
                    if v is None: v=tab["+A"].get(ka[p],pr)
                    if v==y[p]: hits["+AB"]+=1
            acc={k:v/n for k,v in hits.items()}
            base=max(acc["persist"],acc["+A"],acc["+B"])
            # the single-axis control is scored on the B LEG ALONE, because B is the only column the null
            # shifts. Scoring it on max(+A,+B) would leave the real A->target relation inside the null
            # itself, and the control line would then be inflated by the very signal it is meant to
            # measure — it read +0.1141 that way, high enough to swallow every real single-axis gain.
            res.append((acc["+AB"]-base,T,A,B,n,acc,acc["+B"]-acc["persist"]))
    res.sort(reverse=True)
    return res

real=census(0)
if not real:
    print("no triple reaches the %d-sample floor on common support — UNKNOWN, not a null result"%MINN); sys.exit(2)
random.seed(20260830)
shifts=sorted(random.sample(range(N//8,N-N//8),min(NULLS,max(1,N//4))))
nulls=[census(s) for s in shifts]
gains=[g for g,_,_,_,_,_,_ in real]
nullgains=sorted([g for c in nulls for g,_,_,_,_,_,_ in c],reverse=True)
# THE SECOND QUESTION, and it is the one that says what a null joint result MEANS. If no single axis
# beats persistence either, the tape carries no learnable structure at all and "no synergy" is a
# statement about stickiness, not about fusion. If single axes DO beat it while pairs add nothing,
# then correlation genuinely buys nothing here and the finding is about fusion.
sgains=[sg for _,_,_,_,_,_,sg in real]
snull=[sg for c in nulls for _,_,_,_,_,_,sg in c]
srepmax=[max(sg for _,_,_,_,_,_,sg in c) if c else float("-inf") for c in nulls]
sthr=max(srepmax)
def q(sorted_desc,p):
    if not sorted_desc: return float("nan")
    i=int(p*(len(sorted_desc)-1)); return sorted_desc[i]
# THE FINDING LINE — family-wise, re-derived each run from THIS corpus own null, never pinned. The
# census asks the same question of HUNDREDS of triples, so a per-triple 99th percentile is guaranteed to
# hand back ~1% of them as findings even when nothing is there — it did exactly that on the tool own
# arm-7 fixture (252 triples, one spurious EARNED). The line that survives a census is the null MAXIMUM
# PER REPLICATE: the largest gain a whole pass over relation-free data can produce. Clearing it means
# clearing the best thing chance built out of this many triples, not the best thing chance built out of
# one. Conservative by construction, and that is the correct direction for an instrument whose null
# result is itself the publishable answer.
repmax=[max(g for g,_,_,_,_,_,_ in c) if c else float("-inf") for c in nulls]
thr=max(repmax)
thr_rule="largest joint gain any of %d relation-free passes produced over %d triples each — family-wise, not per-triple"%(len(nulls),len(real))
print("triples     : %d real / %d null (circular shifts of B at rows %s; marginals AND autocorrelation preserved)"
      %(len(real),len(nullgains),",".join(map(str,shifts))))
print("finding line: joint gain > %+.4f  (%s)"%(thr,thr_rule))
hdr="%-16s%-16s%-16s%7s%9s%8s%8s%8s%9s"%("target","A","B","n","persist","+A","+B","+AB","joint")
print("")
for th in (0.0,0.005,0.01,0.02,0.05):
    nr=sum(1 for g in gains if g>th); nn=sum(1 for g in nullgains if g>th)/max(1,len(nulls))
    print("  joint gain > %+.3f : real %4d   null %6.1f (mean of %d replicates)"%(th,nr,nn,len(nulls)))
found=[r for r in real if r[0]>thr]
sfound=[r for r in real if r[6]>sthr]
print("")
print("single-axis control (does ONE axis beat persistence? if not, a null joint result is about the")
print("tape being sticky, not about fusion):")
print("  best single gain: %+.4f   line: %+.4f   clearing it: %d of %d triples"%(max(sgains) if sgains else float("nan"),sthr,len(sfound),len(real)))
print("")
print("VERDICT     : %s"%("EARNED — %d triple(s) clear the null line"%len(found) if found else
      "INDISTINGUISHABLE FROM NULL — no pair on this tape carries joint information; a fused sense built on these axes would report its own noise"))
print("")
print("top %d by joint gain (a pair must beat persistence AND each single axis):"%TOP)
print(hdr)
for g,T,A,B,n,a,sg in real[:TOP]:
    mark=" *" if g>thr else ""
    print("%-16s%-16s%-16s%7d%9.4f%8.4f%8.4f%8.4f%+9.4f%s"%(SENSES[T],SENSES[A],SENSES[B],n,
          a["persist"],a["+A"],a["+B"],a["+AB"],g,mark))
sys.exit(0 if found else 1)
'

if [ "$MODE" = test ]; then
  td=$(mktemp -d); trap 'rm -rf "$td"' EXIT
  rc_all=0
  # ARM 1 — the instrument must SEE a real joint pattern. A pure XOR: neither axis alone says anything
  # about the target, the pair says everything. If this does not come back EARNED the census is blind
  # and every null result it has ever printed is worthless.
  python3 - "$td/planted.tsv" <<'PLANT'
import sys, random, datetime
random.seed(11); out=[]; t=datetime.datetime(2026,1,1)
out.append("\t".join(["ts","noise1","noise2","plantA","plantB","plantT"]))
prev=None
for i in range(1200):
    a=random.choice("XY"); b=random.choice("XY")
    tgt="P" if prev is None else ("P" if prev[0]==prev[1] else "Q")
    out.append("\t".join([(t+datetime.timedelta(minutes=10*i)).strftime("%Y-%m-%dT%H:%M:%SZ"),
                          random.choice("MN"),random.choice("MN"),a,b,tgt]))
    prev=(a,b)
open(sys.argv[1],"w").write("\n".join(out)+"\n")
PLANT
  o1=$(python3 -c "$PY_CENSUS" "$td/planted.tsv" 5 3 2>&1); r1=$?
  if [ "$r1" -eq 0 ] && printf '%s' "$o1" | grep -q 'VERDICT *: EARNED' && printf '%s' "$o1" | grep -qE 'plantT +plantA +plantB'; then
    echo "PASS arm1: planted pure-XOR pair is FOUND (the census is not blind)"
  else
    echo "FAIL arm1: the planted synergy was NOT found (rc=$r1) — a null result from this tool means nothing"; rc_all=1
    printf '%s\n' "$o1" | sed -n '1,12p'
  fi
  # ARM 2 — a corpus of pure noise must come back INDISTINGUISHABLE. Without this the tool would
  # dress cross-validation jitter as a discovery, which is the exact failure the null exists to stop.
  python3 - "$td/noise.tsv" <<'NOISE'
import sys, random, datetime
random.seed(12); out=[]; t=datetime.datetime(2026,1,1)
cols=["ts"]+["n%d"%i for i in range(6)]
out.append("\t".join(cols))
for i in range(1500):
    out.append("\t".join([(t+datetime.timedelta(minutes=10*i)).strftime("%Y-%m-%dT%H:%M:%SZ")]
                         +[random.choice("ABC") for _ in range(6)]))
open(sys.argv[1],"w").write("\n".join(out)+"\n")
NOISE
  o2=$(python3 -c "$PY_CENSUS" "$td/noise.tsv" 5 3 2>&1); r2=$?
  if [ "$r2" -eq 1 ] && printf '%s' "$o2" | grep -q 'INDISTINGUISHABLE FROM NULL'; then
    echo "PASS arm2: a pure-noise corpus is reported as indistinguishable from its own null"
  else
    echo "FAIL arm2: noise was reported as a finding (rc=$r2)"; rc_all=1
    printf '%s\n' "$o2" | sed -n '1,12p'
  fi
  # ARM 3 — a tape too thin must render UNKNOWN (rc 2), never a calm "no synergy here".
  printf 'ts\ta\tb\tc\n2026-01-01T00:00:00Z\tX\tY\tZ\n' > "$td/thin.tsv"
  o3=$(python3 -c "$PY_CENSUS" "$td/thin.tsv" 5 3 2>&1); r3=$?
  if [ "$r3" -eq 2 ] && printf '%s' "$o3" | grep -q 'UNKNOWN, not a null result'; then
    echo "PASS arm3: a thin tape renders UNKNOWN (rc 2), not a false all-clear"
  else
    echo "FAIL arm3: thin tape did not render UNKNOWN (rc=$r3): $o3"; rc_all=1
  fi
  # ARM 4 — an absent tape must exit 2, not 1: 'I could not look' and 'I looked and found nothing'
  # are different sentences and a scheduler reads the difference.
  o4=$(python3 -c "$PY_CENSUS" "$td/does-not-exist.tsv" 5 3 2>&1); r4=$?
  if [ "$r4" -eq 2 ]; then echo "PASS arm4: an absent tape exits 2 (unreadable), never 1 (looked, found nothing)"
  else echo "FAIL arm4: absent tape exited $r4"; rc_all=1; fi
  # ARM 5 — the census must be held OUT of sample. In-sample, a joint model wins by having more cells:
  # on a pure-noise corpus its accuracy would climb far above persistence while knowing nothing. The
  # null absorbs that bias in the VERDICT, but the accuracies a human reads would still be fiction.
  top_ab=$(printf '%s\n' "$o2" | awk '/^n[0-9]/{print $(NF-1); exit}')
  top_p=$(printf '%s\n' "$o2" | awk '/^n[0-9]/{print $(NF-4); exit}')
  if [ -n "$top_ab" ] && [ -n "$top_p" ] && awk -v a="$top_ab" -v p="$top_p" 'BEGIN{exit !(a-p<0.05)}'; then
    echo "PASS arm5: on pure noise the joint model stays within 0.05 of persistence (+AB=$top_ab persist=$top_p) — the accuracies are held out, not fitted"
  else
    echo "FAIL arm5: joint model beat persistence by $top_ab-$top_p on PURE NOISE — the census is scoring in sample"; rc_all=1
  fi
  # ARM 6 — a hole in the tape is an OUTAGE, not a slow sample. Pairing a row with the row after a
  # power-off invents a transition that never happened; the guard must drop those and SAY it did.
  python3 - "$td/holed.tsv" <<'HOLED'
import sys, random, datetime
random.seed(13); out=["\t".join(["ts"]+["h%d"%i for i in range(5)])]
t=datetime.datetime(2026,1,1)
for i in range(1200):
    if i%3==0: t+=datetime.timedelta(hours=9)      # a power-off between most samples
    else:      t+=datetime.timedelta(minutes=10)
    out.append("\t".join([t.strftime("%Y-%m-%dT%H:%M:%SZ")]+[random.choice("ABC") for _ in range(5)]))
open(sys.argv[1],"w").write("\n".join(out)+"\n")
HOLED
  o6=$(python3 -c "$PY_CENSUS" "$td/holed.tsv" 5 1 2>&1); r6=$?
  frac=$(printf '%s\n' "$o6" | awk -F'[()%]' '/adjacent_successors/{print $2}')
  if [ -n "$frac" ] && awk -v f="$frac" 'BEGIN{exit !(f<90)}'; then
    echo "PASS arm6: a tape that is one third power-offs reports only ${frac}% adjacent successors — the holes are dropped, not paired across"
  else
    echo "FAIL arm6: holed tape reported ${frac:-?}% adjacent successors — transitions are being invented across outages"; rc_all=1
  fi
  # ARM 7 — a missing token is not a level. NOLOG/STALE/UNKNOWN mark WHEN a sense could not read, and on
  # this node that pattern tracks power-offs and night — so admitting it as a value lets two senses'
  # BLINDNESS patterns identify the clock and mint a joint finding out of nothing but their own outages.
  python3 - "$td/stale.tsv" <<'STALE'
import sys, random, datetime
random.seed(14); out=["\t".join(["ts","sA","sB","tgt"]+["f%d"%i for i in range(6)])]
t=datetime.datetime(2026,1,1)
for i in range(1600):
    ts=t+datetime.timedelta(minutes=10*i); blk=(ts.hour//6)          # four blocks of the day
    a="STALE" if blk in (0,1) else random.choice("XY")               # sA is blind for half the day
    b="STALE" if blk in (1,2) else random.choice("XY")               # sB is blind for a shifted half
    tgt=random.choice("PPPPPPPPPQ") if blk==1 else random.choice("QQQQQQQQQP")  # block-conditioned and
    out.append("\t".join([ts.strftime("%Y-%m-%dT%H:%M:%SZ"),a,b,tgt]+[random.choice("MN") for _ in range(6)]))
open(sys.argv[1],"w").write("\n".join(out)+"\n")   # NOT sticky, so persistence cannot mask the effect
STALE
  o7=$(python3 -c "$PY_CENSUS" "$td/stale.tsv" 5 3 2>&1); r7=$?
  if [ "$r7" -eq 1 ] && printf '%s' "$o7" | grep -q 'INDISTINGUISHABLE FROM NULL'; then
    echo "PASS arm7: two senses whose BLINDNESS patterns jointly identify the clock mint no finding — missing is not a level"
  else
    echo "FAIL arm7: a joint pattern was mined out of two senses' missing tokens (rc=$r7)"; rc_all=1
    printf '%s\n' "$o7" | grep -E 'VERDICT|tgt' | head -3
  fi
  [ "$rc_all" -eq 0 ] && echo "mesh-synergy --test: PASS" || echo "mesh-synergy --test: FAIL"
  exit "$rc_all"
fi

python3 -c "$PY_CENSUS" "$TAPE" "$TOP" "$NULLS" "$LEVELS"
