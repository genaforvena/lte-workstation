#!/usr/bin/env bash
# mesh-chaos-doctor — chaos engineering for the DIAGNOSTIC itself: induce each failure class
# mesh-doctor claims to catch, and PROVE it actually fires. A detector you never see fail is faith,
# not verification (Principles of Chaos: test resilience under induced failure, not unit smoke).
# Every injection is sandboxed + reverted; refuses to run if the mesh isn't green to start.
#
#   mesh-chaos-doctor          run all drills; exit = number of drills that FAILED to detect
#   mesh-chaos-doctor --test   smoke test
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ "${1:-}" = --test ] && { command -v mesh-doctor >/dev/null 2>&1 && echo "smoke-test: ok" || { echo "smoke-test: FAIL (no mesh-doctor)"; exit 1; }; exit 0; }
BIN="$HOME/.local/bin"; FAIL=0
pass(){ printf '  \033[32mDETECTED\033[0m %s\n' "$1"; }
miss(){ FAIL=$((FAIL+1)); printf '  \033[31mMISSED\033[0m   %s — doctor did NOT catch this!\n' "$1"; }

# precondition: mesh must be green, or we can't tell our injection from real breakage
if ! mesh-doctor --quiet >/dev/null 2>&1; then echo "ABORT: mesh-doctor already FAILs — fix real issues before chaos-testing"; exit 2; fi
echo "baseline green ✓ — injecting failures (each reverted):"

# DRILL 1: a committed-but-broken tool (the 5-broken-python class) → parse check must catch it
T="$BIN/mesh-chaostest-$$"
printf '#!/usr/bin/env bash\nthis is (((not valid bash\n' > "$T"; chmod +x "$T"
out=$(mesh-doctor 2>&1); echo "$out" | grep -q "WON'T PARSE.*mesh-chaostest" && pass "broken-tool → parse-check" || miss "broken-tool → parse-check"
rm -f "$T"

# DRILL 2: a hollow organ in a sandbox card (camera declared, no capture tool) → organ check must flag
TC="$(mktemp)"; printf 'senses: camera\nactuators:\n' > "$TC"
# only meaningful if no capture tool exists (else camera is legitimately exercisable)
if ! command -v ffmpeg >/dev/null 2>&1 && ! command -v fswebcam >/dev/null 2>&1; then
  out=$(MESH_CARD="$TC" mesh-doctor 2>&1); echo "$out" | grep -qi 'camera declared but no capture tool' && pass "hollow-organ → organ-check" || miss "hollow-organ → organ-check"
else echo "  SKIP hollow-organ (capture tool present → camera not hollow here)"; fi
rm -f "$TC"

# DRILL 3: a broken --test smoke (real-bug class) → smoke check must catch it (non-hardware tool)
T2="$BIN/mesh-chaossmoke-$$"
printf '#!/usr/bin/env bash\n[ "$1" = --test ] && { echo "smoke-test: FAIL (injected)"; exit 1; }\nexit 0\n' > "$T2"; chmod +x "$T2"
out=$(mesh-doctor 2>&1); echo "$out" | grep -q "smoke-test FAIL.*mesh-chaossmoke" && pass "broken-smoke → smoke-check" || miss "broken-smoke → smoke-check"
rm -f "$T2"

# verify clean revert
if mesh-doctor --quiet >/dev/null 2>&1; then echo "revert ✓ — mesh green again"; else echo "  ⚠ mesh not green after revert — investigate"; FAIL=$((FAIL+1)); fi
echo "mesh-chaos-doctor: $FAIL drill(s) where the detector MISSED the injected failure"
exit "$FAIL"
