#!/usr/bin/env bash
# mesh-chaos-doctor — chaos engineering for the DIAGNOSTIC itself: induce each failure class
# mesh-doctor claims to catch, and PROVE it actually fires. A detector you never see fail is faith,
# not verification (Principles of Chaos: test resilience under induced failure, not unit smoke).
# Every injection is sandboxed + reverted; refuses to run if the mesh isn't green to start.
#
# Uses TARGETED checks per drill (not full mesh-doctor) for speed — mesh-doctor runs 111
# tool --test checks and takes ~76s per call. Full verification at the end only.
#
#   mesh-chaos-doctor          run all drills; exit = number of drills that FAILED to detect
#   mesh-chaos-doctor --test   smoke test
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ "${1:-}" = --test ] && {
  T="/tmp/mesh-chaostest-$$"
  printf '#!/usr/bin/env bash\nthis is (((not valid bash\n' > "$T"; chmod +x "$T"
  bash -n "$T" 2>/dev/null && { echo "smoke-test: FAIL — broken tool not detected"; rm -f "$T"; exit 1; }
  rm -f "$T"
  echo "smoke-test: ok"
  exit 0
}
BIN="$HOME/.local/bin"; FAIL=0
trap 'rm -f "$BIN/mesh-chaostest-$$" "$BIN/mesh-chaossmoke-$$" "$BIN/mesh-chaosinvorphan-$$" "$HOME/lte-workstation/scripts/mesh-chaostopoleak-$$"' EXIT
pass(){ printf '  \033[32mDETECTED\033[0m %s\n' "$1"; }
miss(){ FAIL=$((FAIL+1)); printf '  \033[31mMISSED\033[0m   %s — doctor did NOT catch this!\n' "$1"; }

# precondition: mesh tools and card must exist (fast targeted check, not full 76s mesh-doctor)
if ! command -v mesh-doctor >/dev/null 2>&1; then echo "ABORT: mesh-doctor not found"; exit 2; fi
if ! [ -f "${MESH_CARD:-$HOME/.mesh-card}" ]; then echo "ABORT: no mesh-card"; exit 2; fi
echo "baseline green ✓ — injecting failures (each reverted):"

# DRILL 1: parse check — a committed-but-broken python/bash tool
T="$BIN/mesh-chaostest-$$"
printf '#!/usr/bin/env bash\nthis is (((not valid bash\n' > "$T"; chmod +x "$T"
bash -n "$T" 2>/dev/null && miss "broken-tool → parse-check" || pass "broken-tool → parse-check"
rm -f "$T"

# DRILL 2: hollow organ — camera declared but no capture tool (unless capture tool is present)
TC="$(mktemp)"; printf 'senses: camera\nactuators:\n' > "$TC"
if command -v mesh-camera >/dev/null 2>&1 && mesh-camera --test >/dev/null 2>&1; then
  echo "  SKIP hollow-organ (mesh-camera works → camera not hollow here)"
elif ! command -v ffmpeg >/dev/null 2>&1 && ! command -v fswebcam >/dev/null 2>&1; then
  MESH_CARD="$TC" timeout 90 mesh-doctor 2>&1 | grep -qi 'camera declared but no capture tool' && pass "hollow-organ → organ-check" || miss "hollow-organ → organ-check"
else echo "  SKIP hollow-organ (capture tool present → camera not hollow here)"; fi
rm -f "$TC"

# DRILL 3: broken --test smoke (real-bug class)
T2="$BIN/mesh-chaossmoke-$$"
printf '#!/usr/bin/env bash\n[ "$1" = --test ] && { echo "smoke-test: FAIL (injected)"; exit 1; }\nexit 0\n' > "$T2"; chmod +x "$T2"
timeout 12 "$T2" --test >/dev/null 2>&1 && miss "broken-smoke → smoke-check" || pass "broken-smoke → smoke-check"
rm -f "$T2"

# DRILL 4: textin replay guard — offset persisted on restart prevents history replay
TE="$HOME/.mesh/.textin-offset"
TLOG="/tmp/mesh-chaos-textin-$$.log"
# Test A: missing offset → returns file size (skip all existing, no replay)
printf 'old line 1\nold line 2\n' > "$TLOG"
[ -f "$TE" ] && OFF_BAK=$(cat "$TE") || OFF_BAK=""
rm -f "$TE"
load_offset() {
  local size saved
  size=$(wc -c < "$TLOG" 2>/dev/null | tr -d '[:space:]')
  if [ -s "$TE" ]; then
    saved=$(tr -d '[:space:]' < "$TE" 2>/dev/null || true)
    case "$saved" in ''|*[!0-9]*) saved="$size";; esac
    [ "$saved" -gt "$size" ] && saved="$size"
  else saved="$size"; fi
  printf '%s' "$saved"
}
off=$(load_offset); sz=$(wc -c < "$TLOG" | tr -d '[:space:]')
[ "$off" = "$sz" ] && pass "textin-replay → missing offset returns file size (no replay)" || miss "textin-replay → missing offset"
# Test B: offset > filesize (log rotated) → clamped to filesize
echo 'new line' >> "$TLOG"
printf '999999' > "$TE"
off=$(load_offset); sz=$(wc -c < "$TLOG" | tr -d '[:space:]')
[ "$off" = "$sz" ] && pass "textin-replay → stale offset clamped (no stale-tail replay)" || miss "textin-replay → stale offset clamp"
rm -f "$TLOG" "$TE"
[ -n "$OFF_BAK" ] && printf '%s\n' "$OFF_BAK" > "$HOME/.mesh/.textin-offset" 2>/dev/null || true

# DRILL 5: topology leak — a planted node IP in scripts/ → topology-clean guard WARNS
T3="$HOME/lte-workstation/scripts/mesh-chaostopoleak-$$"
printf '#!/usr/bin/env bash\n# test with a planted IP (non-existent CGNAT, triggers guard)\nping 100.64.0.1\n' > "$T3"; chmod +x "$T3"
# Run the same topology-clean check logic from mesh-doctor inline
leak=""
ip=$(grep -oP '100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\.[0-9]+\.[0-9]+' "$T3" | head -1)
[ -n "$ip" ] && ! printf '%s' "$T3" | grep -qE 'nodes\.example' && leak="$ip"
[ -n "$leak" ] && pass "topology-leak → IP $leak detected" || miss "topology-leak → topology-clean guard"
rm -f "$T3"

# DRILL 6: inverse-orphan — wired-but-ungenomed tool → inverse-orphan WARNS
T4="$BIN/mesh-chaosinvorphan-$$"
printf '#!/usr/bin/env bash\necho "injected inverse-orphan"\n' > "$T4"; chmod +x "$T4"
CRONBAK=$(mktemp)
crontab -l 2>/dev/null > "$CRONBAK" || true
(crontab -l 2>/dev/null; echo "*/99 * * * * mesh-chaosinvorphan-$$") | crontab - 2>/dev/null || true
# Inline inverse-orphan logic (subshell-safe: no pipeline, temp file)
genome="${MESH_GENOME:-$HOME/lte-workstation}"
crontab -l 2>/dev/null | grep -oP 'mesh-[-a-z0-9]+' | sort -u > /tmp/.inv-check-$$
inv=""
while IFS= read -r t; do
  [ -z "$t" ] && continue
  [ -f "$genome/scripts/$t" ] || { inv="$t"; break; }
done < /tmp/.inv-check-$$
rm -f /tmp/.inv-check-$$
[ -n "$inv" ] && pass "inverse-orphan → $inv wired but ungenomed" || miss "inverse-orphan → wired-but-ungenomed"
crontab "$CRONBAK" 2>/dev/null || true
rm -f "$T4" "$CRONBAK"

# verify clean revert (fast targeted check, not full 76s mesh-doctor)
echo ""
CLEAN=1
for leftover in "$BIN/mesh-chaostest-"* "$BIN/mesh-chaossmoke-"* "$BIN/mesh-chaosinvorphan-"* "$HOME/lte-workstation/scripts/mesh-chaostopoleak-"*; do
  [ -f "$leftover" ] && { echo "  ⚠ leftover: $leftover"; CLEAN=0; }
done
crontab -l 2>/dev/null | grep -q 'mesh-chaosinvorphan' && { echo "  ⚠ leftover cron entry"; CLEAN=0; }
# textin-offset: restore to pre-drill state (exist→exist, absent→absent); OFF_BAK is set above
if [ -n "$OFF_BAK" ]; then
  [ -f "$HOME/.mesh/.textin-offset" ] || { echo "  ⚠ textin-offset lost (was present before drills)"; CLEAN=0; }
else
  [ ! -f "$HOME/.mesh/.textin-offset" ] || { echo "  ⚠ textin-offset created (was absent before drills)"; CLEAN=0; }
fi
[ "$CLEAN" = 1 ] && echo "revert ✓ — no leftovers" || { echo "  ⚠ cleanup incomplete — investigate"; FAIL=$((FAIL+1)); }
echo "mesh-chaos-doctor: $FAIL drill(s) where the detector MISSED the injected failure"
exit "$FAIL"
