#!/usr/bin/env bash
# mesh-chaos-doctor — chaos engineering for the DIAGNOSTIC itself: induce each failure class
# mesh-doctor claims to catch, and PROVE it actually fires. A detector you never see fail is faith,
# not verification (Principles of Chaos: test resilience under induced failure, not unit smoke).
# Every injection is sandboxed + reverted; refuses to run if the mesh isn't green to start.
#
# Uses TARGETED checks per drill (not full mesh-doctor) for speed — mesh-doctor runs 111
# tool --test checks and takes ~76s per call. Full verification at the end only.
#
#   mesh-chaos-doctor          run all drills; exit = number of drills that FAILED to detect
#   mesh-chaos-doctor --frame  FRAME AUDIT of this suite itself: what fraction of the subject's own
#                              check classes is drilled at all, which drills still say DETECTED when
#                              the subject is STUBBED OUT (those test a copy, not the detector), and
#                              which declared target classes no longer exist. Read-only.
#   mesh-chaos-doctor --test   smoke test
#
# ── THE FRAME PROBLEM, APPLIED TO THIS SUITE (relevance-realization landing 2026-08-22; review:
#    docs/reviews/rr-frame-blindness-tautological-drill-chaos-doctor-2026-08-22.md) ──
# Vervaeke's point about relevance realization is that it CANNOT be an algorithm over a fixed feature
# set, because choosing the features is the problem being solved; RR has to be a self-organising
# process that can be WRONG and re-tune. A chaos suite is a frame in exactly that sense: six
# hand-picked failure classes standing in for everything mesh-doctor claims to catch. Two ways such a
# frame goes silently blind, both of which this suite had:
#   (1) it never measures its COVERAGE of the space it claims to verify, and
#   (2) a drill can RE-IMPLEMENT the detector inline and then test its own copy — after which the real
#       detector could be deleted and the drill would still print DETECTED. A drill that cannot be
#       wrong is not evidence; it is the frame confirming itself.
# --frame measures both, and it establishes (2) by DRIVING, never by reading the source: it re-runs
# the whole suite against a mesh-doctor that detects nothing, and names every drill still green.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
# Prepended AFTER the export above on purpose: a stub dir handed in by a caller would otherwise lose
# the PATH race to the real ~/.local/bin (the documented poisoned-binary trap). Set ONLY by --frame's
# own re-invocation; it can only ever make the subject WEAKER, so a production run that never sets it
# cannot be made falsely green by it.
[ -n "${MESH_CHAOS_SUBJECT_STUB:-}" ] && PATH="$MESH_CHAOS_SUBJECT_STUB:$PATH"
[ "${1:-}" = --test ] && {
  # --frame must MEASURE, not assert. Three legs, each driven:
  #  (a) it reports a coverage fraction over the subject's real class list;
  #  (b) it NAMES the uncovered classes (an unnamed gap reads as no gap);
  #  (c) the tautology drive actually finds the subject-free drills — and this leg is the one that
  #      would go quiet if MESH_CHAOS_SUBJECT_STUB ever stopped winning the PATH race, which is the
  #      documented way a poisoned binary silently loses to the real one.
  _fo="$(bash "${BASH_SOURCE[0]}" --frame 2>&1)"
  printf '%s' "$_fo" | grep -qE '^  coverage: [0-9]+/[0-9]+ declared check class' \
    || { echo "smoke-test: FAIL (--frame reports no coverage fraction over the subject's classes)"; exit 1; }
  printf '%s' "$_fo" | grep -q 'uncovered classes (NAMED' \
    || { echo "smoke-test: FAIL (--frame does not name its uncovered classes)"; exit 1; }
  printf '%s' "$_fo" | grep -qE '^  tautological=[0-9]+ ' \
    || { echo "smoke-test: FAIL (--frame ran no tautology drive — a drill that tests its own copy stays invisible)"; exit 1; }
  # The drive must be CAPABLE of firing: this suite is known to contain subject-free drills, so a
  # zero here means the stub lost the PATH race or the drive never ran, not that the suite is clean.
  printf '%s' "$_fo" | grep -qE '^  tautological=0 ' \
    && { echo "smoke-test: FAIL (tautology drive found NOTHING in a suite whose drills re-implement their checks inline)"; exit 1; }
  # ...and the PATH race itself, driven rather than trusted. The count above cannot see a broken stub
  # (these drills never call the subject at all, so they print DETECTED either way) — only asking the
  # child which binary it resolved can.
  _ss="$(mktemp -d)"; printf '#!/usr/bin/env bash\nexit 0\n' > "$_ss/mesh-doctor"; chmod +x "$_ss/mesh-doctor"
  _w="$(MESH_CHAOS_SUBJECT_STUB="$_ss" bash "${BASH_SOURCE[0]}" --which-subject 2>/dev/null)"
  rm -rf "$_ss"
  case "$_w" in
    "$_ss/mesh-doctor"|*/mesh-doctor) [ "${_w%/mesh-doctor}" != "${_w}" ] || { echo "smoke-test: FAIL (--which-subject returned '$_w')"; exit 1; } ;;
    *) echo "smoke-test: FAIL (stub subject unresolvable: '$_w')"; exit 1 ;;
  esac
  case "$_w" in
    /tmp/*) : ;;
    *) echo "smoke-test: FAIL (the stubbed subject LOST the PATH race — resolved '$_w', not the stub dir; the tautology drive would be silently measuring the REAL mesh-doctor)"; exit 1 ;;
  esac
  T="/tmp/mesh-chaostest-$$"
  printf '#!/usr/bin/env bash\nthis is (((not valid bash\n' > "$T"; chmod +x "$T"
  bash -n "$T" 2>/dev/null && { echo "smoke-test: FAIL — broken tool not detected"; rm -f "$T"; exit 1; }
  rm -f "$T"
  echo "smoke-test: ok"
  exit 0
}
# Each drill DECLARES the mesh-doctor check class it stands for. A declared class that no longer
# exists in the subject is a drill tending a target that is gone — asserted by --frame, because
# "passing" and "still aimed at something real" are unrelated facts.
DRILL_CLASSES='tools PARSE (committed-but-broken — runs even without --test)
organs FUNCTIONAL (not just declared — hollow/broken-default)
tool smoke tests (--test, node-aware)
genome topology-clean (no hardcoded tailnet IPs — plantability)
inverse-orphan check (cron/supervise-wired tools that are MISSING from genome scripts/)'

# Hidden probe: which mesh-doctor does this process actually resolve? Exists so --test can DRIVE the
# poisoned-PATH contract instead of trusting it — the stub is prepended after this script exports its
# own PATH, and if that order is ever reversed the stub silently loses and the tautology drive goes
# quiet without a single assertion changing.
[ "${1:-}" = --which-subject ] && { command -v mesh-doctor || echo NONE; exit 0; }

if [ "${1:-}" = --frame ]; then
  GENOME="${MESH_GENOME:-$HOME/lte-workstation}"
  DOC="$GENOME/scripts/mesh-doctor"
  [ -r "$DOC" ] || { echo "mesh-chaos-doctor --frame: cannot read $DOC — frame unmeasurable (na, not 0)"; exit 2; }
  # The subject's own declared check classes (its section headers), minus the summary banner.
  classes="$(grep -oE 'hdr "[^"]+"' "$DOC" | sed 's/^hdr "//; s/"$//' | grep -v '^summary$')"
  ntot=$(printf '%s\n' "$classes" | grep -c .)
  ndrl=$(printf '%s\n' "$DRILL_CLASSES" | grep -c .)
  # A declared target that is no longer a class in the subject.
  gone=""
  while IFS= read -r c; do
    [ -z "$c" ] && continue
    printf '%s\n' "$classes" | grep -qxF "$c" || gone="${gone:+$gone; }$c"
  done <<EOF
$DRILL_CLASSES
EOF
  echo "mesh-chaos-doctor --frame — the suite's own frame, measured"
  echo "  subject: $DOC"
  printf '  coverage: %d/%d declared check class(es) drilled (%.0f%%)\n' \
    "$ndrl" "$ntot" "$(awk -v a="$ndrl" -v b="$ntot" 'BEGIN{print (b?100*a/b:0)}')"
  if [ -n "$gone" ]; then echo "  ✗ drill target(s) NO LONGER a class in the subject: $gone"; else
    echo "  ✓ every declared drill target is still a live class in the subject"; fi
  echo "  uncovered classes (NAMED — an unnamed gap reads as no gap):"
  while IFS= read -r c; do
    [ -z "$c" ] && continue
    printf '%s\n' "$DRILL_CLASSES" | grep -qxF "$c" || printf '    · %s\n' "$c"
  done <<EOF
$classes
EOF
  # TAUTOLOGY DRIVE. Re-run the whole suite with a mesh-doctor that detects NOTHING. Any drill still
  # reporting DETECTED proved something about a copy of the check living in this file, not about the
  # detector — the real one could be deleted and the drill would stay green.
  _sd="$(mktemp -d)"
  printf '#!/usr/bin/env bash\nexit 0\n' > "$_sd/mesh-doctor"; chmod +x "$_sd/mesh-doctor"
  echo "  tautology drive (suite re-run against a mesh-doctor that detects nothing):"
  _out="$(MESH_CHAOS_SUBJECT_STUB="$_sd" MESH_CHAOS_FRAME_CHILD=1 bash "$0" 2>/dev/null)"
  rm -rf "$_sd"
  _taut=0
  while IFS= read -r ln; do
    case "$ln" in
      *DETECTED*) _taut=$((_taut+1))
        printf '    SUBJECT-FREE %s\n' "$(printf '%s' "$ln" | sed 's/\x1b\[[0-9;]*m//g; s/.*DETECTED *//')" ;;
    esac
  done <<EOF
$_out
EOF
  [ "$_taut" -eq 0 ] && echo "    (none — every DETECTED needed the real subject)"
  printf '  tautological=%d of the drills that fired\n' "$_taut"
  exit 0
fi

BIN="$HOME/.local/bin"; FAIL=0
trap 'rm -f "$BIN/mesh-chaostest-$$" "$BIN/mesh-chaossmoke-$$" "$BIN/mesh-chaosinvorphan-$$" "$HOME/lte-workstation/scripts/mesh-chaostopoleak-$$"' EXIT
pass(){ printf '  \033[32mDETECTED\033[0m %s\n' "$1"; }
miss(){ FAIL=$((FAIL+1)); printf '  \033[31mMISSED\033[0m   %s — doctor did NOT catch this!\n' "$1"; }

# precondition: mesh tools and card must exist (fast targeted check, not full 76s mesh-doctor)
if ! command -v mesh-doctor >/dev/null 2>&1; then echo "ABORT: mesh-doctor not found"; exit 2; fi
if ! [ -f "${MESH_CARD:-$HOME/.mesh-card}" ]; then echo "ABORT: no mesh-card"; exit 2; fi
echo "baseline green ✓ — injecting failures (each reverted):"

# DRILL 1: parse check — a committed-but-broken python/bash tool
T="$BIN/mesh-chaostest-$$"
printf '#!/usr/bin/env bash\nthis is (((not valid bash\n' > "$T"; chmod +x "$T"
bash -n "$T" 2>/dev/null && miss "broken-tool → parse-check" || pass "broken-tool → parse-check"
rm -f "$T"

# DRILL 2: hollow organ — camera declared but no capture tool (unless capture tool is present)
TC="$(mktemp)"; printf 'senses: camera\nactuators:\n' > "$TC"
if command -v mesh-camera >/dev/null 2>&1 && mesh-camera --test >/dev/null 2>&1; then
  echo "  SKIP hollow-organ (mesh-camera works → camera not hollow here)"
elif ! command -v ffmpeg >/dev/null 2>&1 && ! command -v fswebcam >/dev/null 2>&1; then
  MESH_CARD="$TC" timeout 90 mesh-doctor 2>&1 | grep -qi 'camera declared but no capture tool' && pass "hollow-organ → organ-check" || miss "hollow-organ → organ-check"
else echo "  SKIP hollow-organ (capture tool present → camera not hollow here)"; fi
rm -f "$TC"

# DRILL 3: broken --test smoke (real-bug class)
T2="$BIN/mesh-chaossmoke-$$"
printf '#!/usr/bin/env bash\n[ "$1" = --test ] && { echo "smoke-test: FAIL (injected)"; exit 1; }\nexit 0\n' > "$T2"; chmod +x "$T2"
timeout 12 "$T2" --test >/dev/null 2>&1 && miss "broken-smoke → smoke-check" || pass "broken-smoke → smoke-check"
rm -f "$T2"

# DRILL 4: textin replay guard — offset persisted on restart prevents history replay
TE="$HOME/.mesh/.textin-offset"
TLOG="/tmp/mesh-chaos-textin-$$.log"
# Test A: missing offset → returns file size (skip all existing, no replay)
printf 'old line 1\nold line 2\n' > "$TLOG"
[ -f "$TE" ] && OFF_BAK=$(cat "$TE") || OFF_BAK=""
rm -f "$TE"
load_offset() {
  local size saved
  size=$(wc -c < "$TLOG" 2>/dev/null | tr -d '[:space:]')
  if [ -s "$TE" ]; then
    saved=$(tr -d '[:space:]' < "$TE" 2>/dev/null || true)
    case "$saved" in ''|*[!0-9]*) saved="$size";; esac
    [ "$saved" -gt "$size" ] && saved="$size"
  else saved="$size"; fi
  printf '%s' "$saved"
}
off=$(load_offset); sz=$(wc -c < "$TLOG" | tr -d '[:space:]')
[ "$off" = "$sz" ] && pass "textin-replay → missing offset returns file size (no replay)" || miss "textin-replay → missing offset"
# Test B: offset > filesize (log rotated) → clamped to filesize
echo 'new line' >> "$TLOG"
printf '999999' > "$TE"
off=$(load_offset); sz=$(wc -c < "$TLOG" | tr -d '[:space:]')
[ "$off" = "$sz" ] && pass "textin-replay → stale offset clamped (no stale-tail replay)" || miss "textin-replay → stale offset clamp"
rm -f "$TLOG" "$TE"
[ -n "$OFF_BAK" ] && printf '%s\n' "$OFF_BAK" > "$HOME/.mesh/.textin-offset" 2>/dev/null || true

# DRILL 5: topology leak — a planted node IP in scripts/ → topology-clean guard WARNS
T3="$HOME/lte-workstation/scripts/mesh-chaostopoleak-$$"
printf '#!/usr/bin/env bash\n# test with a planted IP (non-existent CGNAT, triggers guard)\nping 100.64.0.1\n' > "$T3"; chmod +x "$T3"
# Run the same topology-clean check logic from mesh-doctor inline
leak=""
ip=$(grep -oP '100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\.[0-9]+\.[0-9]+' "$T3" | head -1)
[ -n "$ip" ] && ! printf '%s' "$T3" | grep -qE 'nodes\.example' && leak="$ip"
[ -n "$leak" ] && pass "topology-leak → IP $leak detected" || miss "topology-leak → topology-clean guard"
rm -f "$T3"

# DRILL 6: inverse-orphan — wired-but-ungenomed tool → inverse-orphan WARNS
T4="$BIN/mesh-chaosinvorphan-$$"
printf '#!/usr/bin/env bash\necho "injected inverse-orphan"\n' > "$T4"; chmod +x "$T4"
CRONBAK=$(mktemp)
crontab -l 2>/dev/null > "$CRONBAK" || true
(crontab -l 2>/dev/null; echo "*/99 * * * * mesh-chaosinvorphan-$$") | crontab - 2>/dev/null || true
# Inline inverse-orphan logic (subshell-safe: no pipeline, temp file)
genome="${MESH_GENOME:-$HOME/lte-workstation}"
crontab -l 2>/dev/null | grep -oP 'mesh-[-a-z0-9]+' | sort -u > /tmp/.inv-check-$$
inv=""
while IFS= read -r t; do
  [ -z "$t" ] && continue
  [ -f "$genome/scripts/$t" ] || { inv="$t"; break; }
done < /tmp/.inv-check-$$
rm -f /tmp/.inv-check-$$
[ -n "$inv" ] && pass "inverse-orphan → $inv wired but ungenomed" || miss "inverse-orphan → wired-but-ungenomed"
crontab "$CRONBAK" 2>/dev/null || true
rm -f "$T4" "$CRONBAK"

# verify clean revert (fast targeted check, not full 76s mesh-doctor)
echo ""
CLEAN=1
for leftover in "$BIN/mesh-chaostest-"* "$BIN/mesh-chaossmoke-"* "$BIN/mesh-chaosinvorphan-"* "$HOME/lte-workstation/scripts/mesh-chaostopoleak-"*; do
  [ -f "$leftover" ] && { echo "  ⚠ leftover: $leftover"; CLEAN=0; }
done
crontab -l 2>/dev/null | grep -q 'mesh-chaosinvorphan' && { echo "  ⚠ leftover cron entry"; CLEAN=0; }
# textin-offset: restore to pre-drill state (exist→exist, absent→absent); OFF_BAK is set above
if [ -n "$OFF_BAK" ]; then
  [ -f "$HOME/.mesh/.textin-offset" ] || { echo "  ⚠ textin-offset lost (was present before drills)"; CLEAN=0; }
else
  [ ! -f "$HOME/.mesh/.textin-offset" ] || { echo "  ⚠ textin-offset created (was absent before drills)"; CLEAN=0; }
fi
[ "$CLEAN" = 1 ] && echo "revert ✓ — no leftovers" || { echo "  ⚠ cleanup incomplete — investigate"; FAIL=$((FAIL+1)); }
echo "mesh-chaos-doctor: $FAIL drill(s) where the detector MISSED the injected failure"
exit "$FAIL"
