#!/usr/bin/env bash
# mesh-vitals — node survival vitals: disk%, mem%, load/nproc, max-CPU-temp.
#
#   mesh-vitals              one concise line
#   mesh-vitals --json       JSON format
#   mesh-vitals --check      exit 1 + reason if ANY in distress, else exit 0
#   mesh-vitals --alert      cron mode: --check + edge-triggered mesh-chat post
#
# Distress thresholds: disk>90%  mem>95%  load1>4*nproc  temp>85°C
# No deps — procfs + sysfs + awk only.
#
# TWO TIERS — thermal_zone AND hwmon (2026-07-15). This read ONLY thermal_zone*, an INTEL/ACPI-laptop
# assumption, and is the untouched SIBLING of the mesh-therm bug fixed in dacf6f1. AMD desktops expose
# no thermal_zone at all (mesh-home has only cooling_device*); their CPU temp lives in hwmon (k10temp).
# The loop matched nothing, temp_max stayed empty, and the `${temp_max:--1}` fallback rendered -1 —
# so `temp:-1C` sat on the check dash for days while k10temp read 54°C. Health flagged it repeatedly
# ("thermal-sense mesh-home; dash still temp:-1C") and it survived because dacf6f1 fixed mesh-therm and
# nobody swept its siblings.
#
# The blast radius is the DISTRESS GATE, not the cosmetic line: check_distress tests `temp > 85`, and
# -1 > 85 is false, so this node's vitals could NEVER report thermal distress — structurally, since the
# box was built. -1 is a better sentinel than mesh-therm's old 0 (it is not a plausible temperature, so
# a human reading the dash sees something is wrong) but the GATE cannot tell the difference: to an
# integer comparison, "blind" and "cold" are both just "not >85". Canonical f51e36d.
#
# DELIBERATE DUPLICATION — do NOT "DRY" this into mesh-therm or mesh-patterns.sh. This tool's contract
# is "No deps — procfs + sysfs + awk only" (:10) because it is the SURVIVAL vitals reader: it must work
# on a node where everything else is broken. Sourcing a shared helper would trade that away. The copy is
# the price of the contract; this note is here so a future FER sweep does not silently remove it.
set -uo pipefail

MESH_DIR="${MESH_DIR:-$HOME/.mesh}"
FLAG="$MESH_DIR/.vitals-distress-flag"

# Env-overridable so --test drives fixtures instead of the real sysfs tree.
VITALS_ZONE_GLOB="${MESH_VITALS_ZONE_GLOB:-/sys/class/thermal/thermal_zone*/temp}"
VITALS_HWMON_GLOB="${MESH_VITALS_HWMON_GLOB:-/sys/class/hwmon/hwmon*}"

get_vitals() {
  local disk_pct mem_pct load1 load_norm temp_max nproc t tz tc type

  nproc=$(nproc)

  disk_pct=$(df / | awk 'NR==2{sub(/%/,""); print $5}')
  disk_pct="${disk_pct:-?}"

  mem_pct=$(awk '/MemTotal/{t=$2} /MemAvailable/{a=$2} END{if(t>0) printf "%.0f",(t-a)/t*100; else print "?"}' /proc/meminfo)

  load1=$(awk '{print $1}' /proc/loadavg)
  load_norm=$(awk "BEGIN {if($nproc>0) printf \"%.1f\", $load1/$nproc; else print \"?\"}")

  # max across BOTH tiers (unchanged semantics: max = hottest sensor). Absent on both ⇒ -1 = no organ.
  temp_max=""
  for tz in $VITALS_ZONE_GLOB; do
    [ -r "$tz" ] || continue
    t=$(cat "$tz" 2>/dev/null) || continue
    case "$t" in ''|*[!0-9-]*) continue ;; esac
    tc=$(( t / 1000 ))
    [ -z "$temp_max" ] || [ "$tc" -gt "$temp_max" ] && temp_max=$tc
  done
  for tz in $VITALS_HWMON_GLOB/temp*_input; do
    [ -r "$tz" ] || continue
    t=$(cat "$tz" 2>/dev/null) || continue
    case "$t" in ''|*[!0-9-]*) continue ;; esac
    tc=$(( t / 1000 ))
    [ -z "$temp_max" ] || [ "$tc" -gt "$temp_max" ] && temp_max=$tc
  done
  temp_max="${temp_max:--1}"

  echo "$disk_pct $mem_pct $load1 $load_norm $temp_max $nproc"
}

check_distress() {
  read -r disk mem load1 loadn temp nproc <<<"$(get_vitals)"
  local d=""

  [ "$disk" -gt 90 ] 2>/dev/null && d="$d disk=${disk}%"
  [ "$mem" -gt 95 ] 2>/dev/null && d="$d mem=${mem}%"
  if [ -n "$load1" ] && [ -n "$nproc" ] && [ "$nproc" -gt 0 ]; then
    local thresh=$(( 4 * nproc ))
    if awk "BEGIN {exit !($load1 > $thresh)}"; then
      d="$d load1=${load1}(>${thresh},nproc=$nproc)"
    fi
  fi
  [ "$temp" -gt 85 ] 2>/dev/null && d="$d temp=${temp}C"

  if [ -n "$d" ]; then
    echo "${d# }"
    return 1
  fi
  return 0
}

# Name the current top CPU consumer — makes a temp-distress alert SELF-DIAGNOSING: a kernel irq
# thread (e.g. irq/9-acpi = an ACPI GPE storm, 2026-06-13), a walled-mind spinner, or legit load all
# look identical as "temp=99C" without this. ps is the one non-procfs dep; used only on a hot alert.
top_cpu() {
  command -v ps >/dev/null 2>&1 || return 0
  ps -eo pcpu,comm --sort=-pcpu --no-headers 2>/dev/null | awk 'NR==1{printf "%s %d%%", $2, $1+0}'
}

# --- commands -------------------------------------------------------------
case "${1:-}" in
  --test)
    [ -r /proc/meminfo ] || { echo "smoke-test: FAIL (/proc/meminfo not readable)"; exit 1; }
    [ -r /proc/loadavg ] || { echo "smoke-test: FAIL (/proc/loadavg not readable)"; exit 1; }
    command -v df >/dev/null 2>&1 || { echo "smoke-test: FAIL (df not found)"; exit 1; }
    command -v nproc >/dev/null 2>&1 || { echo "smoke-test: FAIL (nproc not found)"; exit 1; }

    # Cross-tier max fixture: hwmon-only (the AMD shape this tool was blind to) must be READ, and the
    # max must be taken across BOTH tiers. Previously this --test asserted "procfs+sysfs readable" and
    # never once exercised the temperature path it was named after — it certified every axis except the
    # broken one.
    _td="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
    mkdir -p "$_td/zone0" "$_td/hwmon0" "$_td/hwmon1"
    printf '41000\n' > "$_td/zone0/temp"          # zone tier: 41C
    printf '67000\n' > "$_td/hwmon0/temp1_input"  # hwmon tier: 67C  <- the max, and zone-only misses it
    printf '35000\n' > "$_td/hwmon1/temp1_input"
    _got=$(MESH_VITALS_ZONE_GLOB="$_td/zone*/temp" MESH_VITALS_HWMON_GLOB="$_td/hwmon*" bash "$0" 2>/dev/null)
    case "$_got" in
      *temp:67C*) : ;;
      *) rm -rf "$_td"; echo "smoke-test: FAIL (cross-tier max: want temp:67C from the hwmon tier, got '$_got')"; exit 1 ;;
    esac
    # hwmon-only node (zone tier absent entirely) — the exact mesh-home shape
    _got2=$(MESH_VITALS_ZONE_GLOB="$_td/nonexistent*/temp" MESH_VITALS_HWMON_GLOB="$_td/hwmon*" bash "$0" 2>/dev/null)
    case "$_got2" in
      *temp:67C*) : ;;
      *) rm -rf "$_td"; echo "smoke-test: FAIL (hwmon-only node must still read 67C, got '$_got2')"; exit 1 ;;
    esac
    # no organ on either tier → honest -1, never a fabricated cold CPU
    _got3=$(MESH_VITALS_ZONE_GLOB="$_td/none*/temp" MESH_VITALS_HWMON_GLOB="$_td/none*" bash "$0" 2>/dev/null)
    case "$_got3" in
      *temp:-1C*) : ;;
      *) rm -rf "$_td"; echo "smoke-test: FAIL (no-organ must read temp:-1C, got '$_got3')"; exit 1 ;;
    esac
    rm -rf "$_td"

    # REAL-READ gate: if this node HAS readable thermal silicon, the tool must actually read it.
    # -1 while sensors exist is BLIND, not cold — and it is invisible to the distress gate, which only
    # asks `temp > 85`. NOTE the deliberate asymmetry with the sense tools unwired this session: those
    # exit 2 (honest n/a) because temp is their ONLY axis. mesh-vitals reports four, and disk/mem/load
    # are live on a sensorless node, so a genuinely thermometer-less box stays rc=0 with the temp axis
    # honestly n/a. Only BLIND-while-sensors-exist is a FAIL.
    # The "does this node have silicon?" probe MUST read the REAL, hardcoded sysfs — never
    # $VITALS_*_GLOB. Those are the values UNDER TEST: the bug IS "the tool's globs miss the sensors",
    # so a probe sharing them asks the tool whether the tool is right and always hears yes. I wrote it
    # with the globs first and the gate was VACUOUS — reintroducing the exact bug (hwmon tier removed)
    # produced a green "temp axis honestly n/a" instead of a FAIL, because the override blinded the
    # probe and the real read in the same stroke. Caught only by watching it go red. That is this
    # session's whole class (562938a/dacf6f1/9f5bc51) reappearing inside its own fix: a gate whose
    # precondition is its own failure condition. The probe answers a question about the NODE; it must
    # not be answerable by the tool's configuration.
    _live=$(get_vitals); _t=$(echo "$_live" | awk '{print $5}')
    _have=0
    for _f in /sys/class/thermal/thermal_zone*/temp /sys/class/hwmon/hwmon*/temp*_input; do
      [ -r "$_f" ] && { _have=1; break; }
    done
    if [ "$_have" = 1 ]; then
      if [ "${_t:-−1}" -le 0 ] 2>/dev/null || [ "${_t:-0}" -ge 150 ] 2>/dev/null; then
        echo "smoke-test: FAIL (real-read: this node HAS readable thermal sensors but the tool read temp=${_t}C — BLIND, not cold. A -1 is invisible to check_distress, which only asks temp>85.)"
        exit 1
      fi
      echo "smoke-test: ok (procfs+sysfs readable; cross-tier + hwmon-only + no-organ fixtures; real-read gate: live silicon reads ${_t}C)"
      exit 0
    fi
    echo "smoke-test: ok (procfs+sysfs readable; cross-tier + hwmon-only + no-organ fixtures; temp axis honestly n/a — no thermal sensor on $(hostname); disk/mem/load unaffected)"
    exit 0
    ;;

  --check)
    distress=$(check_distress) || { echo "$distress"; exit 1; }
    exit 0
    ;;

  --alert)
    if distress=$(check_distress 2>/dev/null); then
      if [ -f "$FLAG" ]; then
        rm -f "$FLAG"
      fi
    else
      mkdir -p "$MESH_DIR"
      prev=$(cat "$FLAG" 2>/dev/null || true)
      if [ "$prev" != "$distress" ]; then
        echo "$distress" > "$FLAG"          # dedup on the STABLE distress string (not the live %),
        msg="$distress"                      # so a fluctuating top-CPU % can't re-trigger the alert.
        case "$distress" in *temp=*) c="$(top_cpu)"; [ -n "$c" ] && msg="$distress (top: $c)" ;; esac
        command -v mesh-chat >/dev/null 2>&1 \
          && MESH_WHO="vitals@$(hostname)" mesh-chat "[vitals-distress] $(hostname): $msg" >/dev/null 2>&1
      fi
      exit 1
    fi
    exit 0
    ;;

  --json)
    read -r disk mem load1 loadn temp nproc <<<"$(get_vitals)"
    printf '{"disk_pct":%s,"mem_pct":%s,"load1":%s,"load_norm":%s,"nproc":%s,"temp_max_c":%s}\n' \
      "$disk" "$mem" "$load1" "$loadn" "$nproc" "$temp"
    ;;

  *)
    read -r disk mem load1 loadn temp nproc <<<"$(get_vitals)"
    printf 'disk:%s%%  mem:%s%%  load:%s/%s(%.1f)  temp:%sC  nproc:%s\n' \
      "$disk" "$mem" "$load1" "$nproc" "${loadn#0}" "$temp" "$nproc"
    ;;
esac