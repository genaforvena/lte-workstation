#!/usr/bin/env bash
# mesh-egress-tunnel — health of THIS node's OWN public egress through its wg-mesh CONSUMER tunnel
# (mesh-home -> phaedra). Distinct lane from its two neighbours, and the distinction is the whole point:
#   - mesh-vpn-health   = the OFFERER path (is the VPN service live for the FRIENDS we serve?)
#   - mesh-egress-health= egress QUALITY/geo (is the exit country right, is anthropic 403-blocked?)
#   - THIS             = is my public egress actually RIDING the phaedra tunnel, or did it SILENTLY
#                        fall back to the router's NL VPN? (the 2026-07-18 persistence gap: wg-mesh
#                        comes up but the fwmark policy route doesn't stick → egress quietly reverts
#                        to 194.147.115.17 while every other signal stays green.)
#
# The verdict is EARNED by a real artifact: a marked curl to an echo-IP service. If it returns nothing
# → DOWN (tunnel/blackhole). If it returns a foreign IP → FALLBACK. But the exit IP ALONE CANNOT NAME
# THE PATH, and until 2026-08-10 this tool claimed it could: "if it returns the phaedra egress → the
# tunnel is up AND the policy route is intact (one probe proves both)". It does not. mesh-home's
# ROUTER LAN-VPN fallback also exits through phaedra, so BOTH the tunnel path and the off-tunnel path
# present the SAME observable — an IP match is consistent with either. Measured live on mesh-home
# 2026-08-10: wg-mesh absent (`Device "wg-mesh" does not exist`), table 200 empty, rule 5200 inert,
# egress 38.49.216.141 → this tool printed "✓ OK egress 38.49.216.141 via wg-mesh (tunnel up, policy
# route intact)" ON THE SAME FRAME as its own sub-line "wg-mesh DOWN · table 200 MISSING", and the
# unattended --heal reflex logged `after =OK … (tunnel up)` 348 times. The tool built to catch the
# silent off-tunnel regression was REPORTING that regression as a healthy tunnel.
# So: the three facts the OK detail asserts (iface up / rule present / table default) are now READ and
# fold INTO the verdict. IP matches + all three hold → OK (they agree). IP matches + any fails →
# AMBIGUOUS (the IP is shared; it is not proof of this tunnel). One probe proves ONE thing.
# The curl is cached (TTL, default 60s) so a per-frame dash caller pays one probe/minute, not one/frame.
#
# Read-only by default. `--heal` re-applies the (idempotent) policy route — the persistence fix path.
# reflex-cadence: 9-59/15 * * * *
# reflex-args: --heal
# The --heal path is additive-only (apply_route: `route replace` in the ISOLATED table $RT_TABLE +
# `ip rule add` iff the fwmark rule is missing — never mutates the host's main route), so it is safe
# to run UNATTENDED with no dead-man's-switch: it closes the silent-until-a-mind-checks window on the
# 2026-07-18 persistence gap (rule 5200 drops on reboot/re-flush → egress silently reverts off-tunnel).
# This only heals the drop; the ROOT trigger (reboot vs something re-flushing PostUp's rule) is undiagnosed.
set -uo pipefail

M="$HOME/.mesh"
# under sudo/root HOME the dir may not exist — without it the cache (and --test's injected
# fixtures) silently fail to write and verdict live-curls per call (2026-07-21, health's dms find)
mkdir -p "$M" 2>/dev/null
PHAEDRA_EGRESS="${MESH_WG_EGRESS_IP:-38.49.216.141}"   # phaedra's ISP-facing IP (what the world sees)
WG_IF="${MESH_WG_IF:-wg-mesh}"
RULE_PRIO="${MESH_WG_RULE_PRIO:-5200}"
RT_TABLE="${MESH_WG_RT_TABLE:-200}"
FWMARK="${MESH_WG_FWMARK:-0x40000}"
FWMASK="${MESH_WG_FWMASK:-0xff0000}"
CACHE="$M/.egress-tunnel-ip.cache"
CACHE_TTL="${MESH_EGRESS_TUNNEL_TTL:-60}"
IP_URL="${MESH_EGRESS_IP_URL:-https://api.ipify.org}"

now(){ date +%s; }

# --- cached egress-IP probe: the load-bearing artifact. Only re-curls when the cache is older than
#     CACHE_TTL, so dash frames are cheap. The curl is MARKED traffic (public dest) → it exercises the
#     exact path we are judging. Empty result (timeout/blackhole) is preserved as "" (DOWN), never faked.
#     RETRY ONCE on empty before caching: a lone curl timeout to the external $IP_URL over this node's
#     slow (~350KB/s) egress caches an empty "" → a 60s FALSE DOWN that alarms the dash and could tempt
#     a heal on a working tunnel. A real blackhole fails BOTH tries → still DOWN (detection preserved);
#     a transient timeout recovers on the retry → no false alarm. Same family as the -n 1→-n 2 driver-race
#     fix: one attempt races the slow path, two de-flap it. This does NOT fake a green — two empties = DOWN.
egress_ip(){
  local age=99999
  [ -f "$CACHE" ] && age=$(( $(now) - $(stat -c %Y "$CACHE" 2>/dev/null || echo 0) ))
  if [ "$age" -lt "$CACHE_TTL" ]; then cat "$CACHE"; return; fi
  local ip; ip=$(timeout 20 curl -s --max-time 18 "$IP_URL" 2>/dev/null | tr -dc '0-9.')
  [ -z "$ip" ] && ip=$(timeout 20 curl -s --max-time 18 "$IP_URL" 2>/dev/null | tr -dc '0-9.')
  # write even when empty (a blackhole is a real, current reading — don't serve a stale green over it)
  printf '%s' "$ip" > "$CACHE.$$.tmp" 2>/dev/null && mv -f "$CACHE.$$.tmp" "$CACHE" 2>/dev/null
  printf '%s' "$ip"
}

# --- cheap local diagnostics (no network) ---
rule_present(){ ip rule show 2>/dev/null | grep -q "^${RULE_PRIO}:.*fwmark ${FWMARK}.*lookup ${RT_TABLE}"; }
route_present(){ ip route show table "$RT_TABLE" 2>/dev/null | grep -q "default dev ${WG_IF}"; }
iface_up(){ ip link show "$WG_IF" 2>/dev/null | grep -q 'state UNKNOWN\|state UP\|LOWER_UP'; }
handshake_age(){ # seconds since last wg handshake, or -1 if unreadable/never
  local hs; hs=$(sudo -n wg show "$WG_IF" latest-handshakes 2>/dev/null | awk 'NR==1{print $2}')
  [ -n "$hs" ] && [ "$hs" -gt 0 ] 2>/dev/null && echo $(( $(now) - hs )) || echo -1
}

apply_route(){ # idempotent — the persistence fix. Marking + masq live in the wg conf PostUp / are
                # already present; this restores ONLY the policy route that fails to stick on reboot.
  sudo -n ip route replace default dev "$WG_IF" table "$RT_TABLE" 2>/dev/null
  ip rule show 2>/dev/null | grep -q "^${RULE_PRIO}:.*fwmark ${FWMARK}.*lookup ${RT_TABLE}" \
    || sudo -n ip rule add priority "$RULE_PRIO" fwmark "${FWMARK}/${FWMASK}" lookup "$RT_TABLE" 2>/dev/null
}

# classify — PURE: the observable (exit IP) plus the three local tunnel facts → one verdict. Kept
# argument-driven so --test can assert the whole matrix without a live substrate or a live curl (the
# live reads happen at the single call site in verdict()/--pane). Every clause of a detail string must
# be EARNED by an argument: an unread fact may not be asserted, and that is exactly the defect this
# function replaced — "policy route missing" was printed on the FALLBACK arm without ever looking.
classify(){ # <ip> <iface:0|1> <rule:0|1> <route:0|1> -> "OK|AMBIGUOUS|FALLBACK|DOWN<tab>detail"
  local ip="$1" ifc="$2" rl="$3" rt="$4" miss=""
  [ "$ifc" = 1 ] || miss="${miss}${miss:+, }iface ${WG_IF} DOWN"
  [ "$rl"  = 1 ] || miss="${miss}${miss:+, }rule ${RULE_PRIO} MISSING"
  [ "$rt"  = 1 ] || miss="${miss}${miss:+, }table ${RT_TABLE} has no default dev ${WG_IF}"
  if [ -z "$ip" ]; then
    printf 'DOWN\tno egress — marked traffic blackholed (tunnel down or route to a dead %s)' "$WG_IF"
  elif [ "$ip" = "$PHAEDRA_EGRESS" ]; then
    if [ -z "$miss" ]; then
      printf 'OK\tegress %s via %s (tunnel up, policy route intact — exit IP, iface, rule and table all agree)' "$ip" "$WG_IF"
    else
      # the shared-observable trap: the router LAN-VPN fallback exits through this SAME IP, so a match
      # is consistent with the tunnel being entirely absent. Report what is known, name what is not.
      printf 'AMBIGUOUS\tegress %s matches the phaedra egress but is NOT proof of this tunnel (%s) — the router LAN-VPN fallback exits through the SAME IP, so the IP alone cannot name the path' "$ip" "$miss"
    fi
  elif [ -n "$miss" ]; then
    printf 'FALLBACK\tegress %s — NOT phaedra (%s); %s → fell back off-tunnel' "$ip" "$PHAEDRA_EGRESS" "$miss"
  else
    # a foreign IP with iface+rule+table ALL intact is a different fault than a dropped route, and
    # blaming the route here would send the mind to --heal something that is already in place.
    printf 'FALLBACK\tegress %s — NOT phaedra (%s); iface, rule %s and table %s are ALL intact, so marked traffic is not taking them (fwmark/masq or peer-side fault — --heal will not help)' "$ip" "$PHAEDRA_EGRESS" "$RULE_PRIO" "$RT_TABLE"
  fi
}

verdict(){ # live reads → classify
  classify "$(egress_ip)" \
    "$(iface_up      && echo 1 || echo 0)" \
    "$(rule_present  && echo 1 || echo 0)" \
    "$(route_present && echo 1 || echo 0)"
}

case "${1:-}" in
  --test)
    fail(){ echo "smoke-test: FAIL ($1)"; exit 1; }
    command -v ip   >/dev/null 2>&1 || fail "no ip"
    command -v curl >/dev/null 2>&1 || fail "no curl"
    # (1) the classifier matrix — pure classify(), so the expected verdict does NOT depend on whether
    # THIS node's tunnel happens to be up (a gate whose answer moves with the live substrate asserts
    # nothing). A future edit that collapses AMBIGUOUS back into OK fails here on three separate rows.
    c(){ local got; got=$(classify "$2" "$3" "$4" "$5" | cut -f1)
         [ "$got" = "$6" ] || fail "classify $1: ip='$2' iface=$3 rule=$4 route=$5 → got '$got', want '$6'"; }
    c all-agree        "$PHAEDRA_EGRESS" 1 1 1 OK
    c ip-only-no-iface "$PHAEDRA_EGRESS" 0 1 1 AMBIGUOUS
    c ip-only-no-rule  "$PHAEDRA_EGRESS" 1 0 1 AMBIGUOUS
    c ip-only-no-route "$PHAEDRA_EGRESS" 1 1 0 AMBIGUOUS
    c live-mesh-home   "$PHAEDRA_EGRESS" 0 1 0 AMBIGUOUS   # the exact 2026-08-10 state that read "✓ OK"
    c router-off       "194.147.115.17"  0 1 0 FALLBACK
    c foreign-intact   "1.2.3.4"         1 1 1 FALLBACK
    c blackhole        ""                0 0 0 DOWN
    c blackhole-up     ""                1 1 1 DOWN        # empty egress is DOWN whatever the facts say
    # (2) every clause of a detail must be EARNED. The AMBIGUOUS detail must name the shared-IP confound
    # and must NOT claim the tunnel is up; the all-intact FALLBACK must not blame a missing route.
    d=$(classify "$PHAEDRA_EGRESS" 0 1 0 | cut -f2)
    case "$d" in *"SAME IP"*) ;; *) fail "AMBIGUOUS detail does not name the shared-IP confound: $d";; esac
    case "$d" in *"tunnel up"*) fail "AMBIGUOUS detail still claims 'tunnel up': $d";; esac
    case "$d" in *"iface ${WG_IF} DOWN"*) ;; *) fail "AMBIGUOUS detail does not name the failing fact: $d";; esac
    d2=$(classify "1.2.3.4" 1 1 1 | cut -f2)
    case "$d2" in *MISSING*|*missing*) fail "FALLBACK detail blames a missing route while rule+table are present: $d2";; esac
    # (3) WIRING — classify() being right is worthless if verdict() never passes it the live facts.
    # Inject the phaedra IP into the cache: the tag must be OK if and ONLY if all three live reads hold.
    # (assign CACHE_TTL itself — setting MESH_EGRESS_TUNNEL_TTL here would not rebind a load-time global)
    CACHE_TTL=999999; printf '%s' "$PHAEDRA_EGRESS" > "$CACHE"
    if iface_up && rule_present && route_present; then want=OK; else want=AMBIGUOUS; fi
    vt=$(verdict | cut -f1)
    [ "$vt" = "$want" ] || fail "verdict() on an injected phaedra IP → '$vt', but the live iface/rule/route reads say '$want' (verdict is not consulting them)"
    printf '' > "$CACHE"
    [ "$(verdict | cut -f1)" = DOWN ] || fail "verdict() on an empty egress reading → not DOWN"
    # (4) the RENDERING is the artifact a human reads, and the reported defect was a contradiction
    # BETWEEN its two lines. Assert on the real --pane output (cache injected, so no live curl): a
    # headline claiming OK may never sit above a sub-line reporting a DOWN iface or a MISSING route.
    printf '%s' "$PHAEDRA_EGRESS" > "$CACHE"
    pane="$(bash "$0" --pane 2>/dev/null)"
    ph="$(printf '%s\n' "$pane" | sed -n 1p)"; psub="$(printf '%s\n' "$pane" | sed -n 2p)"
    [ -n "$ph" ] || fail "--pane produced no headline"
    if printf '%s' "$ph" | grep -q ' OK ' && printf '%s' "$psub" | grep -qE 'DOWN|MISSING'; then
      fail "pane self-contradiction: headline '$ph' sits above sub-line '$psub'"
    fi
    rm -f "$CACHE"
    echo "smoke-test: ok (classifier matrix OK/AMBIGUOUS/FALLBACK/DOWN · details earned · verdict() consults live iface/rule/route → $want here)"; exit 0 ;;
  --heal)
    before="$(verdict)"
    apply_route
    rm -f "$CACHE"   # force a fresh probe past the cache
    after="$(verdict)"
    printf 'heal: before=%s\n      after =%s\n' "$(printf '%s' "$before" | tr '\t' ' ')" "$(printf '%s' "$after" | tr '\t' ' ')"
    printf '%s' "$after" | grep -q '^OK' && exit 0 || exit 1 ;;
  --pane|"")
    # one compact block for the vpn dash top pane. The three tunnel facts are read ONCE and feed BOTH
    # the verdict and the sub-line — until 2026-08-10 the verdict ignored them and the sub-line read
    # them separately, which is how the pane came to print "✓ OK … tunnel up" directly above
    # "wg-mesh DOWN · table 200 MISSING". Two renderings of one state must be canonicalized.
    ifc=$(iface_up      && echo 1 || echo 0)
    rl=$( rule_present  && echo 1 || echo 0)
    rt=$( route_present && echo 1 || echo 0)
    v="$(classify "$(egress_ip)" "$ifc" "$rl" "$rt")"; tag="${v%%$'\t'*}"; detail="${v#*$'\t'}"
    ha="$(handshake_age)"
    case "$ha" in -1) hs="unreadable";; *) hs="$((ha))s ago";; esac
    mark="✓"; [ "$tag" = OK ] || mark="✗"
    printf '  %s %-9s %s\n' "$mark" "$tag" "$detail"
    printf '    tunnel: %s %s · handshake %s · rule %s%s · table %s %s\n' \
      "$WG_IF" "$([ "$ifc" = 1 ] && echo up || echo DOWN)" "$hs" \
      "$RULE_PRIO" "$([ "$rl" = 1 ] && echo ✓ || echo ' MISSING')" \
      "$RT_TABLE" "$([ "$rt" = 1 ] && echo ✓ || echo 'MISSING')"
    # the remedy must match the fault: apply_route runs `ip route replace … dev $WG_IF`, which CANNOT
    # succeed while the device is absent, so pointing a mind at --heal there is a dead end.
    if [ "$tag" != OK ]; then
      if [ "$ifc" = 1 ]; then
        printf '    → heal: mesh-egress-tunnel --heal (re-applies fwmark %s → table %s default dev %s)\n' "$FWMARK" "$RT_TABLE" "$WG_IF"
      else
        printf '    → %s is ABSENT — --heal cannot fix this (route replace needs the device); bring the tunnel up first, then --heal\n' "$WG_IF"
      fi
    fi ;;
  --verdict) verdict; echo ;;
  *) echo "usage: mesh-egress-tunnel [--pane|--verdict|--heal|--test]"; exit 2 ;;
esac
