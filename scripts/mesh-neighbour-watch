#!/usr/bin/env bash
# mesh-neighbour-watch — the mesh's SELF-REPLICATION reflex: detect stale neighbour nodes and
# optionally re-clone the worker substrate onto them. This IS the "scheduled worker-clone" — it
# does NOT conjure new hardware (impossible + unsafe), it ensures the worker GENOME (the channel
# session + mesh-* tools) is present on every ELIGIBLE, CONSENTING, reachable peer, idempotently.
# The replicator is mesh-restore; this fans it out across peers that lost (or never had) their session.
# smoke-test: --test checks mesh-peers parses AND the consent gate qualifies engines / rejects a
#   blank-minds (decommissioned) card.
#
# CONSENT INVARIANT (HANDS-OFF rule): only re-clone onto a peer whose card NAMES a mind engine.
# A BLANK `minds:` line is the operator's "minds off the mesh" decommission switch (e.g. ilya
# 2026-06-15) — presence of the line alone must NOT qualify, or the replicator clones the worker
# substrate back onto a node the operator switched OFF. Matches mesh-mind-keepalive/channel-keepalive.
#
# Reads known peers from tailscale status + ~/.mesh/nodes. For each reachable peer,
# checks their session liveness (mesh-card beat or tmux session). Dry-run by default.
#
#   mesh-neighbour-watch           one cycle: probe all peers, report dead/alive
#   mesh-neighbour-watch --apply   attempt mesh-restore on dead-but-SSH-reachable peers
#   mesh-neighbour-watch --loop [s] run forever (default 300s)
#   mesh-neighbour-watch --test    smoke test
#
# Read-only unless --apply is set. Exit: 0 if all peers ok, 1 if any dead peer found.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
MESH="$HOME/.mesh"; HOST="$(hostname)"; ts="$(date -u +%FT%TZ)"
LOG="$MESH/neighbour-watch.log"; BEAT="$MESH/mesh-neighbour-watch.beat"
mkdir -p "$MESH"
peer_label() {
  case "$1" in
    imozerov-IdeaPad*) echo "ideapad" ;;
    imozerov-Default-string|Default-string|default-string) echo "default-string" ;;
    "Redmi 10"|Redmi) echo "Redmi" ;;
    GL-MT3000) echo "GL-MT3000" ;;
    ilya) echo "ilya" ;;
    *) echo "$1" ;;
  esac
}
# Peer-specific SSH args (override with MESH_PEER_SSH_MAP in env, format: "name:user@host:port name2:user2@host2:port2")
declare -A SSH_MAP
if [ -n "${MESH_PEER_SSH_MAP:-}" ]; then
  for entry in $MESH_PEER_SSH_MAP; do
    k="${entry%%:*}"; v="${entry#*:}"; SSH_MAP["$k"]="$v"
  done
fi
if [ -f "$MESH/nodes" ]; then
  . "$MESH/nodes"
  if [ -n "${MESH_NODES:-}" ]; then
    for entry in $MESH_NODES; do
      k="${entry%%:*}"; v="${entry#*:}"; SSH_MAP["$k"]="$v"
    done
  fi
fi

# Authoritative consent predicate (matches mesh-mind-keepalive:38 / mesh-channel-keepalive:25):
# a peer is an eligible worker-clone target ONLY if its card's `minds:` line NAMES a mind engine.
card_declares_mind() {  # $1 = card text (else stdin) → rc 0 iff an engine is declared on a minds: line
  local card="${1-}"; [ "$#" -ge 1 ] || card="$(cat)"
  printf '%s\n' "$card" | grep -iE '^[[:space:]]*minds:' | grep -qwiE 'claude|opencode|gemini|codex'
}

if [ "${1:-}" = --test ]; then
  command -v mesh-peers >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-peers)"; exit 1; }
  mesh-peers --online >/dev/null 2>&1 || { echo "smoke-test: FAIL (mesh-peers --online failed)"; exit 1; }
  # Consent gate — the self-replication safety invariant (falsifiable: flip any expected rc → FAIL):
  card_declares_mind 'minds: claude opencode' || { echo "smoke-test: FAIL (engine card must qualify)"; exit 1; }
  card_declares_mind $'role: mind\n  minds:  claude' || { echo "smoke-test: FAIL (indented engine card must qualify)"; exit 1; }
  card_declares_mind 'minds:' && { echo "smoke-test: FAIL (blank minds: must NOT qualify — decommission switch)"; exit 1; }
  card_declares_mind $'role: compute\n  minds: ' && { echo "smoke-test: FAIL (blank/whitespace minds: must NOT qualify)"; exit 1; }
  card_declares_mind 'role: compute' && { echo "smoke-test: FAIL (no minds: line must NOT qualify)"; exit 1; }
  echo "smoke-test: ok (peers parse + consent gate: engine qualifies, blank/absent minds rejected)"; exit 0
fi

APPLY=0; [ "${1:-}" = --apply ] && APPLY=1
if [ "${1:-}" = --loop ]; then
  iv="${2:-300}"
  echo "[mesh-neighbour-watch] watching peers every ${iv}s on $HOST"
  while true; do
    : > "$BEAT"; "$0" 2>/dev/null || true; sleep "$iv"
  done
  exit 0
fi

# Gather peers from the canonical, de-duplicated peer reader
declare -A peers
while IFS='|' read -r name ip; do
  [ "$name" = "$HOST" ] && continue
  peers["$name"]="$ip"
done < <(mesh-peers --online 2>/dev/null | tr '\t' '|')

[ ${#peers[@]} -eq 0 ] && echo "no peers to check" && exit 0

found_dead=0; out=""; nl='
'
for name in "${!peers[@]}"; do
  ip="${peers[$name]}"
  label=$(peer_label "$name")
  sa="${SSH_MAP[$label]:-}"
  [ -z "$sa" ] && sa="${SSH_MAP[$name]:-imozerov@$ip}"
  alive_ssh=0; alive_session=0; gateway=0
  timeout 8 ssh -o BatchMode=yes -o ConnectTimeout=5 $sa 'echo ok' 2>/dev/null | grep -q ok && alive_ssh=1
  if [ "$alive_ssh" = 1 ]; then
    # Distinguish three cases — a tmux-LESS peer (BusyBox gateway like the GL-MT3000 router) physically
    # CANNOT host a hostname session, so 'no tmux' must NOT read as SESSION DEAD (else: perpetual rc=1
    # false-positive + --apply SSHes mesh-restore at the router every cycle + it MASKS real dead sessions
    # on actual mind nodes). has-session→OK / has-tmux-no-session→DEAD / no-tmux→gateway (no session expected).
    sess_out=$(timeout 5 ssh -o BatchMode=yes -o ConnectTimeout=4 $sa 'command -v tmux >/dev/null 2>&1 || { echo NOTMUX; exit 0; }; tmux has-session -t $(hostname) 2>/dev/null && echo OK' 2>/dev/null)
    case "$sess_out" in
      *OK*)     alive_session=1 ;;
      *NOTMUX*) alive_session=1; gateway=1 ;;
    esac
  fi
  if [ "$alive_ssh" = 0 ]; then
    out="${out}${ts}  $name ($ip) — UNREACHABLE${nl}"; found_dead=1
  elif [ "$gateway" = 1 ]; then
    out="${out}${ts}  $name ($ip) — OK (gateway, no session expected)${nl}"
  elif [ "$alive_session" = 0 ]; then
    out="${out}${ts}  $name ($ip) — SESSION DEAD${nl}"
    if [ "$APPLY" = 1 ]; then
      # Card-gating (CONSENT INVARIANT): only re-clone onto a peer whose card NAMES a mind engine.
      # Compute-only / router / sense nodes — AND decommissioned nodes with a BLANK minds: line —
      # must NOT be restored: firing mesh-restore on them re-clones the worker substrate onto a node
      # the operator switched off (HANDS-OFF), or is wasted work + noise on a non-mind node.
      has_minds=0
      card="$(ssh -o BatchMode=yes -o ConnectTimeout=10 "$sa" \
        'cat ~/.mesh-card 2>/dev/null' </dev/null 2>/dev/null)" && {
        card_declares_mind "$card" && has_minds=1
      }
      if [ "$has_minds" = 0 ]; then
        out="${out}${ts}    → SKIP restore: card declares no mind engine (compute/router/sense/decommissioned node)${nl}"
      else
        ssh -o BatchMode=yes -o ConnectTimeout=5 $sa '~/.local/bin/mesh-restore' 2>/dev/null \
          && out="${out}${ts}    → restore OK${nl}" \
          || out="${out}${ts}    → restore FAILED${nl}"
      fi
    else
      out="${out}${ts}    → would restore (add --apply)${nl}"
    fi
    found_dead=1
  else
    out="${out}${ts}  $name ($ip) — OK${nl}"
  fi
done

printf '%s' "$out" >> "$LOG"
printf '%s' "$out"
exit $found_dead
