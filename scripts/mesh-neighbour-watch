#!/usr/bin/env bash
# mesh-neighbour-watch — detect stale neighbour nodes and optionally restore them.
# smoke-test: --test checks tailscale status parsable
#
# Reads known peers from tailscale status + ~/.mesh/nodes. For each reachable peer,
# checks their session liveness (mesh-card beat or tmux session). Dry-run by default.
#
#   mesh-neighbour-watch           one cycle: probe all peers, report dead/alive
#   mesh-neighbour-watch --apply   attempt mesh-restore on dead-but-SSH-reachable peers
#   mesh-neighbour-watch --loop [s] run forever (default 300s)
#   mesh-neighbour-watch --test    smoke test
#
# Read-only unless --apply is set. Exit: 0 if all peers ok, 1 if any dead peer found.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
MESH="$HOME/.mesh"; HOST="$(hostname)"; ts="$(date -u +%FT%TZ)"
LOG="$MESH/neighbour-watch.log"; BEAT="$MESH/mesh-neighbour-watch.beat"
mkdir -p "$MESH"
peer_label() {
  case "$1" in
    imozerov-IdeaPad*) echo "ideapad" ;;
    imozerov-Default-string|Default-string|default-string) echo "default-string" ;;
    "Redmi 10"|Redmi) echo "Redmi" ;;
    GL-MT3000) echo "GL-MT3000" ;;
    ilya) echo "ilya" ;;
    *) echo "$1" ;;
  esac
}
# Peer-specific SSH args (override with MESH_PEER_SSH_MAP in env, format: "name:user@host:port name2:user2@host2:port2")
declare -A SSH_MAP
if [ -n "${MESH_PEER_SSH_MAP:-}" ]; then
  for entry in $MESH_PEER_SSH_MAP; do
    k="${entry%%:*}"; v="${entry#*:}"; SSH_MAP["$k"]="$v"
  done
fi
if [ -f "$MESH/nodes" ]; then
  . "$MESH/nodes"
  if [ -n "${MESH_NODES:-}" ]; then
    for entry in $MESH_NODES; do
      k="${entry%%:*}"; v="${entry#*:}"; SSH_MAP["$k"]="$v"
    done
  fi
fi

if [ "${1:-}" = --test ]; then
  command -v mesh-peers >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-peers)"; exit 1; }
  mesh-peers --online >/dev/null 2>&1 || { echo "smoke-test: FAIL (mesh-peers --online failed)"; exit 1; }
  echo "smoke-test: ok"; exit 0
fi

APPLY=0; [ "${1:-}" = --apply ] && APPLY=1
if [ "${1:-}" = --loop ]; then
  iv="${2:-300}"
  echo "[mesh-neighbour-watch] watching peers every ${iv}s on $HOST"
  while true; do
    : > "$BEAT"; "$0" 2>/dev/null || true; sleep "$iv"
  done
  exit 0
fi

# Gather peers from the canonical, de-duplicated peer reader
declare -A peers
while IFS='|' read -r name ip; do
  [ "$name" = "$HOST" ] && continue
  peers["$name"]="$ip"
done < <(mesh-peers --online 2>/dev/null | tr '\t' '|')

[ ${#peers[@]} -eq 0 ] && echo "no peers to check" && exit 0

found_dead=0; out=""; nl='
'
for name in "${!peers[@]}"; do
  ip="${peers[$name]}"
  label=$(peer_label "$name")
  sa="${SSH_MAP[$label]:-}"
  [ -z "$sa" ] && sa="${SSH_MAP[$name]:-imozerov@$ip}"
  alive_ssh=0; alive_session=0
  timeout 8 ssh -o BatchMode=yes -o ConnectTimeout=5 $sa 'echo ok' 2>/dev/null | grep -q ok && alive_ssh=1
  if [ "$alive_ssh" = 1 ]; then
    timeout 5 ssh -o BatchMode=yes -o ConnectTimeout=4 $sa 'tmux has-session -t $(hostname) 2>/dev/null && echo ok' 2>/dev/null | grep -q ok && alive_session=1
  fi
  if [ "$alive_ssh" = 0 ]; then
    out="${out}${ts}  $name ($ip) — UNREACHABLE${nl}"; found_dead=1
  elif [ "$alive_session" = 0 ]; then
    out="${out}${ts}  $name ($ip) — SESSION DEAD${nl}"
    if [ "$APPLY" = 1 ]; then
      ssh -o BatchMode=yes -o ConnectTimeout=5 $sa '~/.local/bin/mesh-restore' 2>/dev/null \
        && out="${out}${ts}    → restore OK${nl}" \
        || out="${out}${ts}    → restore FAILED${nl}"
    else
      out="${out}${ts}    → would restore (add --apply)${nl}"
    fi
    found_dead=1
  else
    out="${out}${ts}  $name ($ip) — OK${nl}"
  fi
done

printf '%s' "$out" >> "$LOG"
printf '%s' "$out"
exit $found_dead
