#!/usr/bin/env bash
# mesh-tailnet-policy — the sense that reads THIS MESH'S OWN NETWORK POLICY. Nothing here read it.
#
# task {#board 2026-08-30 discover, owner mesh-tailnet-policy/genome, priority:incident}.
#
# TWO PLANES, AND BOTH MUST BE IN ONE READING — the doctrine rule one ring out is
# [[a-declared-pref-is-not-the-fib]], and a tailnet ACL is that same shape at the policy layer:
#   (1) THE DECLARATION — GET /api/v2/tailnet/-/acl. What we SAY the policy is. Its ETag is the
#       VERSION, and drift is the whole point, so the etag is published in every reading.
#   (2) THE INSTALLED FILTER — `tailscale debug netmap` .PacketFilter. What the kernel-side
#       wireguard peer actually enforces. A declared grant that never compiled into a filter rule
#       is a pref, not a FIB.
# They are never folded. A reading with one plane blind says so per-plane and renders that plane
# UNKNOWN — never a level, never a zero.
#
# ALARM ON DRIFT, NOT ON THE LEVEL. The level here is alarming on its face (see below) and has been
# stable for as long as anyone has looked; an edge-triggered alarm about a standing level ages out
# of the room in a day and then guards nothing. What is actionable is CHANGE: a new owner identity
# in /devices, a widened grant, a new nodeAttr, a new ssh rule, a changed packet filter.
#
# ── THREE TRAPS, ALL MEASURED. Do not re-derive them. ─────────────────────────────────────────────
#
# (a) POST /acl/validate RETURNS HTTP 200 FOR AN INVALID POLICY. Control arm run in the same minute
#     as the treatment, 2026-08-30: a doc whose grant cites an undeclared tag answers
#     `200 {"message":"src=tag not found: \"tag:doesnotexist\""}`, while the live doc answers
#     `200 {}`. So `[ "$code" = 200 ]` blesses every broken policy the endpoint exists to catch —
#     a gate on the transport answering a question about the content. KEY ON THE BODY.
#
# (b) THE NETMAP READ CAN BE DENIED, AND THE DENIAL IS NOT A NODE FACT — IT IS A PREF THAT MOVES.
#     The task filed this as "root-gated; uid 1000 -> 'Access denied: debug access denied';
#     OperatorUser is None here". RE-MEASURED 2026-08-30T23:5xZ while building this: OperatorUser
#     on mesh-home now reads **mesh-home**, and uid 1000 returns a PacketFilter BYTE-IDENTICAL to
#     the sudo read (1 rule, AllCaps 10 both ways). So the privilege premise changed under the
#     report. That is exactly why this tool binds its guard to THE OUTCOME — did we get a
#     PARSEABLE PacketFilter? — and never to a privilege, a node name, or a remembered pref
#     ([[a-guard-bound-to-a-node-name-goes-permanently-false]]). The design lesson the trap was
#     filed for stands unchanged and is the reason the outcome guard exists: on a node where the
#     read IS denied it returns EMPTY, and empty must render UNKNOWN, never "no rules" — a
#     permissive filter and an unreadable one are the same bytes and opposite facts.
#
# (c) tagOwners: {"tag:lte-node": ["autogroup:member"]} means ANY MEMBER MAY CLAIM THAT TAG. So
#     `tag:lte-node` is SELF-ASSERTED — an announcement, never an attestation — and everything in
#     this mesh that treats the tag as identity inherits that. CLAUDE.md's own canonical discovery
#     (`select(.Tags[]? == "tag:lte-node")`) is one such consumer. The reading publishes a
#     per-tag attestation word so a consumer can see which it is holding.
#
# WHAT THE LEVEL IS, as of the first reading (2026-08-30): the installed filter is ONE rule —
# all of 100.64/10 to every destination, every port, proto TCP/UDP/ICMP/ICMPv6 — and /devices
# carries TWO owner identities (ilyailiilia 10 devices, tinangel266 3, of which 2 online and
# UNTAGGED). Those foreign-owner peers are therefore unrestricted by the filter. That is the
# standing level; this tool exists to catch the next CHANGE to it.
#
# reflex-cadence: 23 */6 * * *
# reflex-args: --once
#
#   mesh-tailnet-policy              print the current reading (both planes, coverage, attestation)
#   mesh-tailnet-policy --once       one drift pass (cron): compare to the baseline, post on change
#   mesh-tailnet-policy --baseline   print the stored baseline
#   mesh-tailnet-policy --test       hermetic smoke (no network, no board)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"

MESH_DIR="${MESH_DIR:-$HOME/.mesh}"
SECRETS="${MESH_TP_SECRETS:-$MESH_DIR/secrets/tailscale.env}"
STATE="${MESH_TP_STATE:-$MESH_DIR/.tailnet-policy.state}"     # the BASELINE (json)
LOG="${MESH_TP_LOG:-$MESH_DIR/tailnet-policy.log}"            # the durable verdict tape
API="${MESH_TP_API:-https://api.tailscale.com/api/v2/tailnet/-}"
CURL_T="${MESH_TP_TIMEOUT:-25}"
# overridable so --test can drive the DENIED/absent netmap read: a PATH prepend cannot hide
# /usr/bin/tailscale from a script whose own line 2 re-exports PATH.
TS_BIN="${MESH_TP_TS:-tailscale}"
HOST="$(hostname)"
ts(){ date -u +%Y-%m-%dT%H:%M:%SZ; }
tape(){ printf '%s  %s\n' "$(ts)" "$*" >> "$LOG" 2>/dev/null || true; }

# ── HUJSON -> JSON. The ACL endpoint serves HuJSON (comments + trailing commas); `jq` refuses it,
# and a tool that silently fell back to "unparseable" on the NORMAL response would render every
# healthy read as blind. Strip // and /* */ comments and trailing commas, string-aware — a naive
# regex eats a `//` inside a URL, and this very doc contains "https://tailscale.com/cap/...".
# NOTE: the program is passed with `python3 -c`, never `python3 - <<HEREDOC`. A heredoc IS the
# process's stdin, so `sys.stdin.read()` returns the program text and the piped document is never
# seen — the first draft did exactly that and every healthy ACL read rendered BLIND.
# THE DOCUMENT COMES IN ON ARGV, NOT STDIN, AND THE PROGRAM COMES IN ON A QUOTED HEREDOC.
# Two failures paid for that shape, both of which made every HEALTHY ACL read render BLIND:
#   `python3 - <<HEREDOC` makes the heredoc the process's STDIN, so sys.stdin.read() returns the
#   program text and the piped document is never seen; and moving the program into a single-quoted
#   bash string instead is worse, because this program contains single quotes (c=='"'"'"'"'"', '"'"'\\'"'"') and the
#   FIRST of them closes the bash string, truncating the program mid-statement.
# argv sidesteps both. The ACL doc is ~560 bytes; ARG_MAX is ~2MB.
hujson_to_json(){
  python3 - "$(cat)" <<'PYX'
import sys, json
s = sys.argv[1]
out=[]; i=0; n=len(s); instr=False; esc=False
while i < n:
    c = s[i]
    if instr:
        out.append(c)
        if esc: esc=False
        elif c=='\\': esc=True
        elif c=='"': instr=False
        i+=1; continue
    if c=='"': instr=True; out.append(c); i+=1; continue
    if c=='/' and i+1<n and s[i+1]=='/':
        while i<n and s[i]!='\n': i+=1
        continue
    if c=='/' and i+1<n and s[i+1]=='*':
        i+=2
        while i+1<n and not (s[i]=='*' and s[i+1]=='/'): i+=1
        i+=2; continue
    out.append(c); i+=1
t=''.join(out)
# trailing commas, string-aware: walk back over whitespace from every ] or }
res=[]; i=0; n=len(t); instr=False; esc=False
while i<n:
    c=t[i]
    if instr:
        res.append(c)
        if esc: esc=False
        elif c=='\\': esc=True
        elif c=='"': instr=False
        i+=1; continue
    if c=='"': instr=True; res.append(c); i+=1; continue
    if c in ']}':
        while res and res[-1].isspace(): res.pop()
        if res and res[-1]==',': res.pop()
    res.append(c); i+=1
t=''.join(res)
try: json.loads(t)
except Exception: sys.exit(1)
sys.stdout.write(t)
PYX
}

# decl_from_json <json> — the declaration parse, as ONE entry point. Both decl_plane and --test go
# through it, so the gate cannot pass on a transcription of the rule while the rule itself is wrong.
decl_from_json(){
  python3 - "${1:-}" <<'DPY' 2>/dev/null
import json,sys,hashlib
try: d=json.loads(sys.argv[1])
except Exception: sys.exit(1)
def h(x): return hashlib.sha256(json.dumps(x,sort_keys=True).encode()).hexdigest()[:16]
g=d.get("grants",d.get("acls",[]))
print("decl-grants:",len(g),"fp="+h(g))
ssh=d.get("ssh",[])
print("decl-ssh:",len(ssh),"fp="+h(ssh))
na=d.get("nodeAttrs",[])
print("decl-nodeattrs:",len(na),"fp="+h(na))
# (c) THE ATTESTATION QUESTION, per tag. autogroup:member (or :members) as a tagOwner means ANY
# member may claim the tag, so the tag is an ANNOUNCEMENT, never an attestation — and every
# consumer keying on it, CLAUDE.md's own canonical discovery included, inherits that.
to=d.get("tagOwners",{})
for t in sorted(to):
    owners=to[t] or []
    word="self-asserted" if any(str(o).startswith("autogroup:member") for o in owners) else "owner-restricted"
    print("decl-tag: %s %s owners=%s" % (t, word, ",".join(map(str,owners)) or "-"))
print("decl-fp:",h(d))
DPY
}

# ── PLANE 1: the DECLARATION. Prints key: value lines; state says which, never the rc.
decl_plane(){
  local key hdr body code etag json
  if [ ! -r "$SECRETS" ]; then
    echo "decl-state: blind"; echo "decl-reason: no readable $SECRETS — this node holds no tailnet API credential"; return 0
  fi
  key="$(sed -n 's/^[[:space:]]*\(export[[:space:]]\+\)\?TS_API_KEY=//p' "$SECRETS" 2>/dev/null | tail -1 | tr -d '"'"'"'')"
  if [ -z "${key:-}" ]; then
    echo "decl-state: blind"; echo "decl-reason: $SECRETS carries no TS_API_KEY"; return 0
  fi
  hdr="$(mktemp)"; body="$(mktemp)"
  code="$(timeout "$CURL_T" curl -s -o "$body" -D "$hdr" -w '%{http_code}' -u "$key:" "$API/acl" 2>/dev/null)"
  etag="$(grep -i '^etag:' "$hdr" 2>/dev/null | tail -1 | tr -d '\r' | sed 's/^[Ee][Tt][Aa][Gg]:[[:space:]]*//; s/"//g')"
  case "$code" in
    200) : ;;
    401|403) echo "decl-state: unauth"; echo "decl-reason: HTTP $code — the key is rejected, so we cannot read our own declared policy"; rm -f "$hdr" "$body"; return 0 ;;
    ''|000) echo "decl-state: unreachable"; echo "decl-reason: no HTTP response within ${CURL_T}s"; rm -f "$hdr" "$body"; return 0 ;;
    *)   echo "decl-state: blind"; echo "decl-reason: HTTP $code from the ACL endpoint"; rm -f "$hdr" "$body"; return 0 ;;
  esac
  json="$(hujson_to_json < "$body")"
  if [ -z "${json:-}" ]; then
    # A 200 we cannot parse is BLIND, never empty-policy. This is the (b)-shaped trap on the other
    # plane: unreadable and permissive are the same bytes to a consumer that folds them.
    echo "decl-state: blind"; echo "decl-reason: HTTP 200 but the body did not parse as HuJSON ($(wc -c < "$body") bytes)"
    echo "decl-etag: ${etag:-none}"; rm -f "$hdr" "$body"; return 0
  fi
  echo "decl-state: ok"
  echo "decl-etag: ${etag:-none}"
  decl_from_json "$json" \
    || { echo "decl-state: blind"; echo "decl-reason: parsed as JSON but the shape was not readable"; }
  rm -f "$hdr" "$body"
}

# ── PLANE 2: the INSTALLED filter. The guard is bound to THE OUTCOME — did a parseable
# PacketFilter come back — never to a privilege, a node name, or a remembered pref (trap b).
inst_plane(){
  local out pf
  if ! command -v "$TS_BIN" >/dev/null 2>&1; then
    echo "inst-state: absent"; echo "inst-reason: no tailscale CLI on this node"; return 0
  fi
  out="$(timeout "$CURL_T" "$TS_BIN" debug netmap 2>/dev/null)"
  if [ -z "${out:-}" ]; then
    # DENIED / not-running / timed out all land here, and all of them are UNKNOWN. An empty read
    # must never render "no rules": a wide-open filter and an unreadable one are the same bytes.
    out="$(timeout "$CURL_T" sudo -n "$TS_BIN" debug netmap 2>/dev/null)"
  fi
  if [ -z "${out:-}" ]; then
    echo "inst-state: unknown"
    echo "inst-reason: netmap read returned nothing as this user or under sudo -n (denied, daemon down, or timed out) — this is NOT 'no rules'"
    return 0
  fi
  pf="$(printf '%s' "$out" | jq -c '.PacketFilter' 2>/dev/null)"
  if [ -z "${pf:-}" ] || [ "$pf" = null ]; then
    echo "inst-state: unknown"; echo "inst-reason: the netmap parsed but carries no .PacketFilter field"; return 0
  fi
  echo "inst-state: ok"
  printf '%s' "$pf" | python3 -c '
import json,sys,hashlib,ipaddress
pf=json.load(sys.stdin)
print("inst-rules:",len(pf),"fp="+hashlib.sha256(json.dumps(pf,sort_keys=True).encode()).hexdigest()[:16])
# WIDTH, not a count: how much address space may reach how many ports. A rule count is blind to a
# rule getting wider, which is the drift class the task names.
v4=0; allports=0
for r in pf:
    for s in (r.get("Srcs") or []):
        try:
            n=ipaddress.ip_network(s, strict=False)
            if n.version==4: v4=max(v4, n.num_addresses)
        except Exception: pass
    for d in (r.get("Dsts") or []):
        p=d.get("Ports") or {}
        if p.get("First",1)==0 and p.get("Last",0)>=65535: allports+=1
print("inst-widest-src-v4:", v4)
print("inst-allport-dsts:", allports)
' 2>/dev/null || { echo "inst-state: unknown"; echo "inst-reason: .PacketFilter did not read as a list of rules"; }
}

# ── PLANE 3: the OWNER CENSUS. A new owner identity is a drift class the ACL text cannot show.
owners_plane(){
  local key body code
  [ -r "$SECRETS" ] || { echo "own-state: blind"; echo "own-reason: no readable $SECRETS"; return 0; }
  key="$(sed -n 's/^[[:space:]]*\(export[[:space:]]\+\)\?TS_API_KEY=//p' "$SECRETS" 2>/dev/null | tail -1 | tr -d '"'"'"'')"
  [ -n "${key:-}" ] || { echo "own-state: blind"; echo "own-reason: no TS_API_KEY"; return 0; }
  body="$(mktemp)"
  code="$(timeout "$CURL_T" curl -s -o "$body" -w '%{http_code}' -u "$key:" "$API/devices" 2>/dev/null)"
  if [ "$code" != 200 ]; then
    echo "own-state: blind"; echo "own-reason: HTTP $code from /devices"; rm -f "$body"; return 0
  fi
  if ! jq -e '.devices' "$body" >/dev/null 2>&1; then
    echo "own-state: blind"; echo "own-reason: /devices answered 200 with no .devices array"; rm -f "$body"; return 0
  fi
  echo "own-state: ok"
  jq -r '
    [.devices[] | {u:.user, tagged:((.tags//[])|length>0)}] as $d
    | "own-identities: " + ([$d[].u] | unique | join(",")),
      "own-count: " + ([$d[].u] | unique | length | tostring),
      "own-untagged: " + ([$d[] | select(.tagged|not)] | length | tostring)
  ' "$body" 2>/dev/null
  rm -f "$body"
}

reading(){ decl_plane; inst_plane; owners_plane; }

# ── the drift classes, as "<class>=<value>" lines. A BLIND plane contributes NOTHING to the
# comparison — comparing a blind read against a good baseline manufactures drift out of our own
# blindness, and that is the loudest possible way to be wrong.
fingerprint(){  # reads a reading on stdin
  awk '
    /^decl-state: ok/      {dok=1}
    /^inst-state: ok/      {iok=1}
    /^own-state: ok/       {ook=1}
    /^decl-etag: /         {etag=$2}
    /^decl-grants: /       {g=$2 " " $3}
    /^decl-ssh: /          {s=$2 " " $3}
    /^decl-nodeattrs: /    {na=$2 " " $3}
    /^decl-tag: /          {tags = tags $2 ":" $3 " "}
    /^inst-rules: /        {ir=$2 " " $3}
    /^inst-widest-src-v4: /{iw=$2}
    /^inst-allport-dsts: / {ia=$2}
    /^own-identities: /    {oi=$2}
    END{
      if (dok) { sub(/ +$/,"",tags); print "etag=" etag; print "grants=" g; print "ssh=" s; print "nodeattrs=" na; print "tags=" tags }
      if (iok) { print "filter=" ir; print "widest=" iw; print "allports=" ia }
      if (ook) { print "owners=" oi }
    }'
}

drift(){  # <baseline-file> <current-fp-file> -> prints "<class>: <old> -> <new>" lines
  # index()/substr(), never -F= with a rebuilt record: awk rebuilds $0 with OFS, which injected a
  # leading space into every value, so a changed class read as ' aaa ->  bbb' and matched nothing.
  awk 'NR==FNR{ i=index($0,"="); if(i){ o[substr($0,1,i-1)]=substr($0,i+1) } next }
       { i=index($0,"="); if(!i) next; k=substr($0,1,i-1); n=substr($0,i+1)
         if (k in o) { if (o[k] != n) printf "%s: %s -> %s\n", k, o[k], n }
         else printf "%s: <unbaselined> -> %s\n", k, n }' "$1" "$2"
}

case "${1:-}" in
  --test)
    f=""
    # HuJSON: the live ACL doc's own shape — trailing commas, and a "//" INSIDE a string.
    j="$(printf '%s' '{
      // a comment
      "tagOwners": {"tag:x": ["autogroup:member"],},
      "nodeAttrs": [{"target":["*"],"attr":["https://tailscale.com/cap/x"]},],
    }' | hujson_to_json)"
    [ -n "$j" ] || f="$f hujson-refused-the-live-doc-shape (every healthy read would render blind)"
    printf '%s' "$j" | jq -e '.nodeAttrs[0].attr[0]' >/dev/null 2>&1 \
      || f="$f hujson-ate-a-url (a naive // comment strip eats https:// inside a string — this doc contains one)"
    # fingerprint: a BLIND plane contributes NOTHING, or a blind read manufactures drift.
    fp="$(printf 'decl-state: blind\ndecl-reason: x\ninst-state: ok\ninst-rules: 1 fp=aa\ninst-widest-src-v4: 5\ninst-allport-dsts: 1\nown-state: blind\n' | fingerprint)"
    case "$fp" in *etag=*|*grants=*|*owners=*) f="$f blind-plane-entered-the-fingerprint (comparing a blind read to a good baseline manufactures drift out of our own blindness)" ;; esac
    case "$fp" in *filter=1*) : ;; *) f="$f readable-plane-dropped-from-the-fingerprint:[$fp]" ;; esac
    # drift: a changed class is named with BOTH values; an unchanged one is silent.
    b="$(mktemp)"; c="$(mktemp)"
    printf 'etag=aaa\nowners=me\nfilter=1\n' > "$b"; printf 'etag=bbb\nowners=me\nfilter=1\n' > "$c"
    d="$(drift "$b" "$c")"
    case "$d" in *"etag: aaa -> bbb"*) : ;; *) f="$f drift-missed-a-changed-class:[$d]" ;; esac
    case "$d" in *owners*|*filter*) f="$f drift-reported-an-unchanged-class (every pass would alarm):[$d]" ;; esac
    printf 'etag=aaa\n' > "$b"; printf 'etag=aaa\nowners=new@x\n' > "$c"
    d="$(drift "$b" "$c")"
    case "$d" in *"owners: <unbaselined> -> new@x"*) : ;; *) f="$f drift-missed-a-NEW-class (a new owner identity appearing is the drift class the ACL text cannot show):[$d]" ;; esac
    rm -f "$b" "$c"
    # (c) THE ATTESTATION WORD, through the TOOL'S OWN decl_from_json — never a transcription of
    #     the predicate. Driven: inverting the real rule must turn this red.
    a="$(decl_from_json '{"tagOwners":{"tag:a":["autogroup:member"],"tag:b":["someone@example.com"]}}')"
    case "$a" in *"decl-tag: tag:a self-asserted"*) : ;; *) f="$f tagowner-autogroup-member-not-called-self-asserted (the tag is an announcement, never an attestation, and every consumer keying on it inherits that):[$a]" ;; esac
    case "$a" in *"decl-tag: tag:b owner-restricted"*) : ;; *) f="$f tagowner-named-owner-called-self-asserted:[$a]" ;; esac
    case "$a" in *"decl-grants: 0"*) : ;; *) f="$f decl-parse-lost-the-grant-count:[$a]" ;; esac

    # (a) the validate trap, as a PURE predicate over the two bodies measured live 2026-08-30.
    vok(){ case "$1" in '{}') return 0 ;; *) return 1 ;; esac; }
    vok '{}' || f="$f validate-rejected-the-valid-body"
    vok '{"message":"src=tag not found: \"tag:doesnotexist\""}' \
      && f="$f validate-blessed-an-INVALID-policy (both bodies come back HTTP 200 — a gate on the code blesses every broken policy the endpoint exists to catch; key on the BODY)"
    # (b) the outcome guard: an EMPTY netmap read is UNKNOWN, never 'no rules'.
    # A MISSING BINARY IS THE EASY HALF AND IT IS NOT TRAP (b). The trap is a binary that EXISTS and
    # whose read is DENIED — it returns empty, and empty must never render "no rules". Pointing
    # TS_BIN at a nonexistent name returns at the `command -v` guard and never reaches the code the
    # trap is about; measured, that arm passed with the empty-read branch mutated to "0 rules".
    # So: a stub that exists, is executable, and prints nothing — exactly what a denial looks like.
    tb="$(mktemp -d)"; printf '#!/bin/sh\nexit 1\n' > "$tb/ts-denied"; chmod +x "$tb/ts-denied"
    o="$(TS_BIN="$tb/ts-denied" inst_plane 2>/dev/null)"
    case "$o" in *"inst-state: unknown"*) : ;; *) f="$f denied-netmap-not-unknown (an existing binary whose read is refused is the trap; a missing one is not):[$o]" ;; esac
    case "$o" in *"inst-rules: 0"*|*"inst-state: ok"*) f="$f denied-netmap-rendered-as-a-LEVEL (a wide-open filter and an unreadable one are the same bytes and opposite facts)" ;; esac
    # ...and the genuinely absent binary is its OWN word, never folded into the denied one.
    o2="$(TS_BIN=__no-such-tailscale-binary__ inst_plane 2>/dev/null)"
    case "$o2" in *"inst-state: absent"*) : ;; *) f="$f absent-binary-not-called-absent:[$o2]" ;; esac
    rm -rf "$tb"
    if [ -n "$f" ]; then echo "smoke-test: FAIL ($f )"; exit 1; fi
    echo "smoke-test: ok (HuJSON parses the live doc's own shape — trailing commas AND a // inside a string, which this ACL really contains; a BLIND plane contributes nothing to the fingerprint so a blind read cannot manufacture drift; drift names a changed class with both values, is silent on an unchanged one, and reports a NEW class as <unbaselined>; tagOwners autogroup:member reads self-asserted and a named owner reads owner-restricted (trap c); the validate predicate keys on the BODY, because both the valid and the INVALID policy come back HTTP 200 (trap a, control arm measured live); and an empty netmap read renders unknown/absent and NEVER 'no rules' (trap b's design lesson, bound to the OUTCOME rather than to a privilege — OperatorUser on this node moved from None to mesh-home between the task being filed and this tool being written))"
    exit 0 ;;

  --baseline) [ -s "$STATE" ] && cat "$STATE" || echo "no baseline yet"; exit 0 ;;

  --once)
    cur="$(mktemp)"; fp="$(mktemp)"
    reading > "$cur"; fingerprint < "$cur" > "$fp"
    dstates="$(grep -E '^(decl|inst|own)-state:' "$cur" | tr '\n' ' ')"
    if [ ! -s "$fp" ]; then
      tape "BLIND $dstates — every plane unreadable this pass; baseline untouched"
      echo "mesh-tailnet-policy: BLIND — $dstates"; rm -f "$cur" "$fp"; exit 0
    fi
    if [ ! -s "$STATE" ]; then
      cp "$fp" "$STATE"
      tape "BASELINE $dstates $(tr '\n' ' ' < "$fp")"
      echo "mesh-tailnet-policy: baseline established (first run — nothing to compare against, and saying so beats an alarm nobody can act on)"
      command -v mesh-chat >/dev/null 2>&1 && mesh-chat "[fyi] tailnet-policy@$HOST: baseline established for this mesh's OWN network policy — nothing read it until now. $(tr '\n' ' ' < "$fp") · planes: $dstates. Drift (a new owner identity, a widened grant, a new nodeAttr, a new ssh rule, a changed packet filter) alarms from here; the LEVEL does not, because it is standing and an edge alarm about a standing level ages out of the room." >/dev/null 2>&1
      rm -f "$cur" "$fp"; exit 0
    fi
    d="$(drift "$STATE" "$fp")"
    if [ -z "$d" ]; then
      tape "SAME $dstates $(tr '\n' ' ' < "$fp")"
      echo "mesh-tailnet-policy: no drift — $dstates"; rm -f "$cur" "$fp"; exit 0
    fi
    # DRIFT. Merge only the classes we could READ this pass — a blind plane must not erase a
    # baseline class it simply could not see.
    tape "DRIFT $dstates $(printf '%s' "$d" | tr '\n' ';')"
    awk -F= 'NR==FNR{k=$1; seen[k]=1; print; next} {k=$1; if(!(k in seen)) print}' "$fp" "$STATE" > "$STATE.new" && mv "$STATE.new" "$STATE"
    echo "mesh-tailnet-policy: DRIFT"; printf '%s\n' "$d"
    command -v mesh-chat >/dev/null 2>&1 && mesh-chat "[fyi] tailnet-policy@$HOST: POLICY DRIFT on this mesh's own network policy — $(printf '%s' "$d" | tr '\n' ' · '). Planes: $dstates. Read the declaration with 'mesh-tailnet-policy' and remember tag:lte-node is SELF-ASSERTED (tagOwners autogroup:member), so a tag is an announcement, not an attestation." >/dev/null 2>&1
    rm -f "$cur" "$fp"; exit 0 ;;

  ''|--check) reading; exit 0 ;;
  *) echo "usage: mesh-tailnet-policy [--check|--once|--baseline|--test]" >&2; exit 64 ;;
esac
