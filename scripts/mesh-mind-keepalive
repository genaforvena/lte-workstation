#!/usr/bin/env bash
# mesh-mind-keepalive — keep THIS node's claude MIND alive. The loop-supervisor restarts dead loops,
# but nothing restarted a dead MIND — so a node whose claude crashed/exited went "missing its claude
# until someone noticed". This relaunches it. The mind sleeps; the mesh wakes it.
#
#   mesh-mind-keepalive            ensure the claude window has claude running; relaunch if not
#   mesh-mind-keepalive --status   report only
#
# Guards: (a) no-op if claude is already running (the common case); (b) SKIP if a limit/auth wall is
# showing — relaunching would just loop into the limit; (c) restart-intensity: >3 relaunches/30min =
# persistent fault → STOP + escalate (don't burn into a crash-loop); (d) --continue keeps the mind's
# context (it resumes, doesn't wake blank).
#
# ── COUPLED-REGULATOR PATHOLOGY — each essential variable optimized locally, none jointly ──
# LITERATURE (homeostasis/allostasis, live review 2026-07-06): "Gradual proactive regulation of body
# state by reinforcement learning of homeostasis" (bioRxiv 10.1101/2025.10.17.682979, 2025-10-17;
# also in press, Neural Networks, ScienceDirect S0168010226000088). The paper extends homeostatic
# reinforcement learning (HRL) to MULTI-DIMENSIONAL systems and its headline finding is not the
# per-variable controller — it's what happens when several are combined: "local optimization can give
# rise to emergent trade-offs or even maladaptive, pathological states at the system level" — i.e. each
# essential variable's regulator can be individually correct and the COMBINATION still pathological,
# because no regulator holds a model of what the others are doing.
# THE GAP THIS NAMES: this mesh already runs several single-variable homeostats exactly this way —
# mesh-therm-watch/mesh-stress regulate TEMPERATURE (advisory/shed under heat), mesh-resource-guard
# regulates MEMORY (nice/oom_score_adj under pressure, never kills), and THIS tool regulates MIND-
# LIVENESS ("is claude running? if not, relaunch"). Each is individually well-guarded (own hysteresis,
# own rate caps, own escalation). But this tool's relaunch decision (:87 `[ "$cmd" = claude ] && exit 0`,
# the STORM check below) reads ONLY pane state + its own relaunch-count file — it holds no model of
# WHY the mind is down. If a mind exits/dies because the node is thermally throttled or memory-pressured
# ([[thermal-throttle-starves-operator-channel]], [[autonomous-dev-thermal-shed-diagnosis]] — a real
# past failure mode on this node, 93-97°C), relaunching it immediately (a fresh `claude --continue`
# spikes CPU on launch) feeds load right back into the variable that caused the death — two locally-
# sound regulators (shed-for-thermal vs restore-for-liveness) fighting each other into an oscillation
# neither alone can see, which is precisely the multi-dimensional HRL paper's failure mode made concrete
# on this mesh rather than in simulation.
# DISTINCT from prior allostasis/ultrastability reviews on this file tree: NOT allostatic-load
# (mesh-stress/mesh-algedonic/mesh-reliability — correction-FREQUENCY per subsystem, a single-variable
# measurement); NOT the Good Regulator Theorem gap (mesh-homeostasis — a regulator's model of ITS OWN
# disturbance source); NOT ultrastability's second loop (mesh-homeostasis — reconfiguring ONE regulator's
# own parameters). This is the cross-regulator coupling those all leave unmodeled: N separately-sound
# single-variable homeostats with no shared arbiter.
# HELD fix (instrument-first, steward/operator-gated — behavioral): before relaunching, cheaply check
# the node's own thermal/memory state (`mesh-stress --json`'s `therm_state`/`level_num` — already
# computed, zero new sensing) and if it reads HOT/STRESSED, log a DEFERRED relaunch (retry next tick)
# instead of firing immediately — breaking the fight by making mind-liveness regulation YIELD to the
# thermal regulator instead of racing it blind. Not shipped here (comment-only; 0 behavior change) —
# needs the defer-vs-storm interaction validated (a deferred relaunch must still count toward, or be
# exempt from, the restart-intensity window) before it's safe to wire.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -f "$HOME/.mesh/restore.env" ] && . "$HOME/.mesh/restore.env" 2>/dev/null || true   # lean-node MESH_MIND_CHANNELS, cmd overrides
S="$(hostname)"; WIN="${MESH_MIND_WIN:-plan}"; MESH="$HOME/.mesh"; CARD="$HOME/.mesh-card"   # 2026-06-13: steward mind lives in the 'plan' data-channel
[ "${1:-}" = --test ] && {
  command -v tmux >/dev/null 2>&1 || { echo "smoke-test: FAIL (no tmux)"; exit 1; }
  # dry-run: hostname session must exist (mind keepalive is per-node, acts through this session)
  tmux has-session -t "$S" 2>/dev/null || { echo "smoke-test: FAIL (no tmux session '$S' — mind-keepalive can't reach any window)"; exit 1; }
  # dry-run: window check — $WIN must exist or be creatable (tmux new-window below uses it)
  tmux list-windows -t "$S" -F '#{window_name}' 2>/dev/null | grep -qx "$WIN" || true  # non-fatal: tool creates missing windows
  # dry-run: card parse — minds: line should be readable and contain a known mind binary
  if [ -f "$CARD" ]; then
    grep -qiE '^[[:space:]]*minds:' "$CARD" || true  # card may have no minds (organ-only node) — not a FAIL
    grep -iE '^[[:space:]]*minds:' "$CARD" | grep -qwE 'claude|opencode|gemini|codex' || true
  fi
  # INSTANCE LOCK regression guard (chat-review/mind-keepalive-check-then-spawn-race, same bug class as
  # mesh-loop-baton's --ensure and mesh-channel-keepalive's keepalive pass, 2026-07-01 literature pass —
  # CALM-theorem framing: "is claude running? if not, relaunch" is a non-monotonic ensure-singleton op,
  # so two concurrent invocations (overlapping cron tick + a slow tmux/ssh call, or a manual run racing
  # cron) can both observe DOWN and both fire "claude --continue" into the same pane). flock must actually
  # serialize two racing sections — falsifiable: drop the lock and the interleave below fails.
  command -v flock >/dev/null 2>&1 || { echo "smoke-test: FAIL (no flock — relaunch check+act is unprotected)"; exit 1; }
  ltmp="$(mktemp)"; otmp="$(mktemp)"; rm -f "$otmp"
  ( exec 9>"$ltmp"; flock 9; printf 'a-start\n' >> "$otmp"; sleep 0.3; printf 'a-end\n' >> "$otmp" ) &
  sleep 0.05
  ( exec 9>"$ltmp"; flock 9; printf 'b-start\n' >> "$otmp"; sleep 0.1; printf 'b-end\n' >> "$otmp" ) &
  wait
  seq="$(tr '\n' ',' < "$otmp")"
  case "$seq" in
    a-start,a-end,b-start,b-end,) : ;;
    *) echo "smoke-test: FAIL (flock did not serialize two racing sections: got '$seq')"; rm -f "$ltmp" "$otmp"; exit 1 ;;
  esac
  rm -f "$ltmp" "$otmp"
  # split fragments: the pattern can never match this line's own text (vacuous-self-grep class,
  # 1969a5d) — it matches only the real relaunch-path lock line.
  _rl_a='flock -n '; _rl_b='200 || { echo "$(ts) $WIN: another keepalive pass in progress'
  grep -qF "${_rl_a}${_rl_b}" "$0" || { echo "smoke-test: FAIL (relaunch path no longer uses flock)"; exit 1; }
  echo "smoke-test: ok (instance-lock serializes check-then-relaunch, flock-guarded)"; exit 0
}
LOG="$MESH/mind-keepalive.log"; ts(){ date -u +%FT%TZ; }
# DECLARATION-GATED: a node declares whatever it is — only minds, only organs, neither, both. Keep
# on-air ONLY a mind the card actually declares; an organ-only node (e.g. the phone) gets no forced
# claude. (operator: "it can be only organs, only minds, none, both, anything".)
if [ -f "$CARD" ] && grep -qiE '^[[:space:]]*minds:' "$CARD"; then
  # Check for any known AI mind binary — the card lists binary names (claude/opencode/gemini),
  # NOT window names (plan/health/verify). Window names changed with the data-channel refactor;
  # checking $WIN would always fail on channel-layout nodes and produce spurious no-op log spam.
  grep -iE '^[[:space:]]*minds:' "$CARD" | grep -qwE 'claude|opencode|gemini|codex' || { echo "$(ts) no AI minds declared in card — no-op (organ-only node)" >>"$LOG"; exit 0; }
fi
# LEAN-NODE allowlist: on a RAM-constrained node MESH_MIND_CHANNELS lists the only channels that run a
# mind (mesh-restore/channel-keepalive honor it). If set and this keepalive's WIN isn't listed, no-op —
# else we'd create+launch a mind in an unallowed window and OOM the node (phaedra 1.9Gi, 2026-06-15).
if [ -n "${MESH_MIND_CHANNELS:-}" ]; then
  case " $MESH_MIND_CHANNELS " in *" $WIN "*) :;; *) echo "$(ts) $WIN not in MESH_MIND_CHANNELS (lean node) — no-op" >>"$LOG"; exit 0;; esac
fi
tmux has-session -t "$S" 2>/dev/null || { echo "$(ts) no session" >>"$LOG"; exit 0; }

# window present? (create empty if missing — e.g. fresh boot)
tmux list-windows -t "$S" -F '#{window_name}' 2>/dev/null | grep -qx "$WIN" || { tmux new-window -d -t "$S" -n "$WIN"; sleep 1; }
# If the window is a 2-pane CHANNEL (top=data, bottom=mind), mesh-channel-keepalive owns it. This
# window-level keepalive would relaunch into the wrong/active pane and fight the channel — defer.
[ "${1:-}" != --status ] && tmux list-panes -t "$S:$WIN" -F '#{pane_index}' 2>/dev/null | grep -qx 1 && { echo "$(ts) $WIN is a 2-pane channel — channel-keepalive owns it, defer" >>"$LOG"; exit 0; }
# INSTANCE LOCK: check ("is claude running?") + act (relaunch) must be atomic across concurrent
# invocations of THIS window — else an overlapping cron tick / manual run can both read DOWN and both
# fire "claude --continue" into the same pane (the mesh-loop-baton --ensure race, same class). --status
# is read-only, exempt. Non-blocking: a second pass just skips this tick, the next one tends it.
if [ "${1:-}" != --status ]; then
  exec 200>"$MESH/.mind-keepalive-$WIN.lock"
  flock -n 200 || { echo "$(ts) $WIN: another keepalive pass in progress — skip" >>"$LOG"; exit 0; }
fi
cmd="$(tmux list-panes -t "$S:$WIN" -F '#{pane_current_command}' 2>/dev/null | head -1)"

if [ "${1:-}" = --status ]; then
  [ "$cmd" = claude ] && echo "  $S:$WIN — claude ALIVE" || echo "  $S:$WIN — claude DOWN (cmd=$cmd)"
  exit 0
fi

[ "$cmd" = claude ] && exit 0     # alive — nothing to do (the common case)

# claude is NOT running in its window. Decide whether to relaunch.
pane="$(tmux capture-pane -t "$S:$WIN" -p -S -8 2>/dev/null)"
if printf '%s\n' "$pane" | grep -qiE 'hit your (session|usage) limit|upgrade to (team|pro)|rate limit|· *resets [0-9]'; then
  echo "$(ts) SKIP $WIN: limit/auth wall showing — not relaunching (would loop)" >>"$LOG"; exit 0
fi
# restart-intensity (OTP): max 3 relaunches in 30min
f="$MESH/.mind-relaunch-$WIN"; now=$(date +%s)
{ [ -f "$f" ] && awk -v n="$now" '($1+1800)>n' "$f"; echo "$now"; } > "$f.tmp" 2>/dev/null && mv "$f.tmp" "$f"
if [ "$(wc -l <"$f" 2>/dev/null||echo 0)" -gt 3 ]; then
  echo "$(ts) STORM $WIN: >3 relaunches/30min — STOP + escalate" >>"$LOG"
  command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="keepalive@$S" mesh-chat "[mind-down] $S: claude keeps dying (>3 relaunches/30min) — persistent crash/limit, needs operator." >/dev/null 2>&1
  exit 1
fi
# relaunch with context continuity
tmux send-keys -t "$S:$WIN" C-c 2>/dev/null; sleep 0.5
tmux send-keys -t "$S:$WIN" "claude --continue" C-m
echo "$(ts) RELAUNCHED $WIN (claude --continue)" >>"$LOG"
command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="keepalive@$S" mesh-chat "[mind-revive] $S: claude was down — relaunched (--continue, context kept)." >/dev/null 2>&1
