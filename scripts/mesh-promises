#!/usr/bin/env bash
# mesh-promises — a DOUBLE-ENTRY LEAK DETECTOR for the mesh's board promises.
#
# Operator premise (2026-07-24): "hledger can count not only money spent but any sort of debts
# (promises, claims, etc)." True — and not a hack: double-entry has ALWAYS tracked obligations, not
# cash (the Mesopotamian tablets recorded grain OWED). A promise is a LIABILITY; keeping it is the
# balancing posting; an obligation open-but-not-discharged is a NONZERO liability balance that does
# not scroll off the board. That standing balance IS the leak detector.
#
# THE LEAK IT DETECTS: the mesh's most persistent failure class is the DROPPED PROMISE — a `[task]`
# that never became `[done]`, a `[taking]` that aged into a phantom, a reflex promised and never
# wired. The board (chat.log) has no mechanism to surface these: they scroll away and nobody is
# looking (cf. CLAUDE.md "the OPERATOR noticed before any reflex did — none was looking"). This tool
# replays the board into a promise ledger where an unkept promise is a STANDING, AGED, queryable
# quantity — and posts LOUDLY when a fresh one crosses the leak threshold.
#
# MODEL (the board is the source of truth; the journal is a materialized, tamper-evident view):
#   OPEN     a body-start `[task]` line → opens a promise, keyed by a derived slug, owner from the
#            `owner: <tool>/<window>` clause (window after the slash) or else the posting window.
#            Recurring same-key tasks dedup to ONE open promise (redmi-ssh-key posted 6x = 1 debt).
#   KEEP     a later `[done]` that matches an open promise closes it. Match = leading-slug equality
#            (the `[done] <slug>:` discipline) OR distinctive-token overlap (owner-preferred). A done
#            matching no open promise is SELF-DIRECTED work (legitimate here), counted, never a phantom.
#   LEAK     an open promise aged past the threshold with no keeping done. incident-tagged promises
#            leak faster (MESH_PROMISE_LEAK_INCIDENT_H). This is the signal.
#
# CLAIM FAMILY EXTENSION (2026-07-24, claim-family-leak): [task]/[done] is only ONE promise shape.
# discover's board audit (14:39 fyi) found 19 open [verify] + 2 stale [taking] this detector was
# BLIND to — the two claim types that leak most ([taking] abandoned, [verify] never redeemed) had
# ZERO ledger visibility. Two more commodities, same double-entry idiom, same journal:
#   CLAIM ([verify])  a check OWED by an addressed window. Debtor parsed from the body's LEADING
#                      address form: `A→B: ...` / `A/B: ...` addresses B; a bare `A: ...` addresses A;
#                      no leading window-token → **reflex-broadcast** (a structural dead-letter — no
#                      window can ever post AS reflex-broadcast, so it is NEVER redeemable by
#                      construction; ages and stays LOUD forever, deliberately — that IS the signal
#                      for the sharpest leak class discover found, 10-44h aged reflex alerts nobody
#                      owns). A self-addressed claim (debtor == poster) is a self-check, not an
#                      obligation on someone else — skipped, not counted (mirrors "self-directed done").
#                      REDEEMED by a later `[fyi]`/`[sense]`/`[done]` FROM the debtor whose tokens
#                      overlap the claim's lead (same matching discipline as done↔task).
#   HOLD ([taking])   a claim HELD on a task by its taker. Only a `[taking] <slug>: <detail>` post
#                      opens one — a content-free `[taking]` (no `slug:` prefix, CLAUDE.md's "heartbeat,
#                      not a sign of life") is NOT modeled, same as before. REDEEMED by a later
#                      `[done]` FROM THE SAME TAKER matching the slug (exact) or token overlap.
#   Both age/leak on the SAME open→leak→keep shape as PROMISE (MESH_CLAIM_LEAK_H for claims — a
#   check owed has a SHORTER SLA than a task; holds reuse MESH_PROMISE_LEAK_H, same as a task).
#   v1 KNOWN LIMITATION: address parsing is a prose heuristic (no `owner:`/`task:` tag exists yet on
#   [verify]/[taking] lines) — same class of imprecision the original PROMISE derivation already
#   carries and has iteratively hardened (Cyrillic slugs, owner-last-clause, etc.). Direction 1's
#   board→journal tag schema (docs/design-board-tag-schema-2026-07-24.md) makes this EXACT once
#   minds start emitting the ` ; task:/owner:/status:` tail; this heuristic is the safe first step,
#   consistent with that doc's migration order ("prefer explicit tag, fall back to derivation").
#
# DOUBLE-ENTRY (the error-detecting layer, same idiom as mesh-ledger):
#   liabilities:promises:<owner>:<slug>   +1 PROMISE on open, -1 on keep   (Dr/Cr vs equity:promises)
#   → `hledger bal liabilities:promises` = the CURRENT OPEN SET (balance 1 = open, 0 = kept).
#   → `hledger check` = PARITY: every open/keep txn sums to zero; a booking bug FAILS with no oracle.
#   → TWO independent computations must AGREE: the python board-replay open-count == the hledger
#     balance (an error-detecting cross-check — a divergence means the journal was corrupted/edited).
#   Commodity PROMISE lives in its OWN journal/repo (~/.mesh/promises/) — NEVER mixed with the USD
#   ledger (mixing commodities makes `bal` multi-commodity noise; CLAUDE.md rule + my own last-turn call).
#
#   mesh-promises              leak report — open promises aged past threshold, by owner, with age
#   mesh-promises --all        every open promise (any age) + match audit (which done kept which)
#   mesh-promises --balance    hledger bal liabilities:promises (standing open obligations)
#   mesh-promises --feed       rebuild journal from board, commit, refresh the witness-pane surfaces
#                              (summary + leak worklist). The cadence.
#
# WHERE LEAKS SURFACE: the witness top pane (a read-only tape) tails the cheap summary + leak
# worklist this writes each feed; witness-the-MIND then DRIVES the leaked owners (its board duty:
# "drives stuck strands to owners"). That is deliberately BETTER than a cron reflex auto-posting
# [fyi] to the board — a self-posting reflex competes with witness and adds board noise. Board
# auto-post is therefore OPT-IN (MESH_PROMISE_POST=1), for nodes that run NO witness mind.
#   mesh-promises --check      parity (hledger check) + replay-vs-balance AGREEMENT + no-negative gate
#   mesh-promises --dash       compact pane summary
#   mesh-promises --json       machine-readable open/leak set
#   mesh-promises --collisions I-confluence/CALM uniqueness-violation report: task slugs held OPEN by
#                              ≥2 distinct takers (a double-hold the G-Set board can never PREVENT —
#                              detect + hand-reconcile). exit 1 if any, 0 if clean. Report-only.
#   mesh-promises --test       RED-first: a gate SEEN to flag an aged-open promise, clear on keep,
#                              and catch an over-discharge. A gate you have not seen FAIL is not a gate.
#
# Env: MESH_PROMISE_LEAK_H (default 24)  MESH_PROMISE_LEAK_INCIDENT_H (default 6)
#      MESH_CLAIM_LEAK_H (default 12 — [verify] claim SLA, shorter than a task's)
#      MESH_CHAT_LOG (default ~/.mesh/chat.log)  MESH_PROMISES_DIR (default ~/.mesh/promises)
#      MESH_PROMISE_MIN_OVERLAP (default 1)  MESH_PROMISE_POST (set → --feed board-posts new leaks;
#      default OFF, witness owns surfacing)  MESH_PROMISE_NO_POST (hard override — never post, for --test)
# reflex-cadence: 31 * * * *
# reflex-args: --feed
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
MESH="$HOME/.mesh"
CHAT_LOG="${MESH_CHAT_LOG:-$MESH/chat.log}"
PROM_DIR="${MESH_PROMISES_DIR:-$MESH/promises}"
JOURNAL="$PROM_DIR/promises.journal"
STATE="$MESH/.promises-state"          # last-known leaked keys (transition posting), + liveness mtime
SUMMARY="$MESH/.promises-summary"       # cheap one-line for pane consumers (witness tails this)
LEAKS_CACHE="$MESH/.promises-leaks"     # cheap short leak list — the witness pane's driving worklist
LEAK_H="${MESH_PROMISE_LEAK_H:-24}"
LEAK_INCIDENT_H="${MESH_PROMISE_LEAK_INCIDENT_H:-6}"
CLAIM_LEAK_H="${MESH_CLAIM_LEAK_H:-12}"
MIN_OVERLAP="${MESH_PROMISE_MIN_OVERLAP:-1}"
# accounts.journal — the chart-of-accounts / roster source of truth (Component 2). Deployed copy
# first, then the genome copy beside this script (so --test / an undeployed checkout still validate).
ACCOUNTS_JOURNAL="${MESH_ACCOUNTS_JOURNAL:-$MESH/accounts.journal}"
_self_dir="$(cd "$(dirname "$0")" && pwd)"

have(){ command -v "$1" >/dev/null 2>&1; }

# self-seed: a fresh/rebooted node has no ~/.mesh/accounts.journal (nothing re-plants it — tg fyi
# 14:46). Fail-open already makes an absent chart SAFE (roster inactive, no false quarantine), but a
# reachable genome copy should just be used rather than silently staying inert. One-shot, quiet.
seed_accounts_journal(){
  [ -f "$ACCOUNTS_JOURNAL" ] && return 0
  local seed="${MESH_REPO:-$HOME/lte-workstation}/scripts/accounts.journal"
  [ -f "$seed" ] && mkdir -p "$(dirname "$ACCOUNTS_JOURNAL")" && cp "$seed" "$ACCOUNTS_JOURNAL" 2>/dev/null
  return 0
}
seed_accounts_journal

# the roster = window leaves declared in accounts.journal (account liabilities:promises:<w>, minus
# the :unrouted quarantine). Empty if no accounts.journal is found → the python check FAILS OPEN
# (trusts owners as-is), so a missing chart never nukes every promise to unrouted.
roster_windows(){
  local af=""
  [ -f "$ACCOUNTS_JOURNAL" ] && af="$ACCOUNTS_JOURNAL"
  [ -z "$af" ] && [ -f "$_self_dir/accounts.journal" ] && af="$_self_dir/accounts.journal"
  [ -z "$af" ] && return 0
  grep -oE '^account liabilities:promises:[a-z0-9-]+$' "$af" \
    | sed 's/.*://' | grep -vx unrouted | sort -u | tr '\n' ' '
}
git_prom(){ git -C "$PROM_DIR" -c user.name='mesh-promises' -c user.email='noreply@mesh' "$@"; }
ensure_repo(){ mkdir -p "$PROM_DIR"; [ -d "$PROM_DIR/.git" ] || git_prom init -q 2>/dev/null; }

# ============================ core replay (python) ============================
# The ONE parse. argv: <mode> <chat_log> <now_iso> <leak_h> <incident_h> <min_overlap> [journal_out]
#   mode journal  → write hledger journal to <journal_out>, print open/leak summary to stdout
#   mode report   → human leak report to stdout (exit 1 if any leak, 0 if none, 2 if no board)
#   mode all      → every open promise + match audit
#   mode json     → machine JSON of {open:[...], leaks:[...], kept:N, unkeyed_done:N}
#   mode counts   → "open=<n> leak=<n>" (for the agreement cross-check)
replay(){
MESH_PROMISE_ROSTER="${MESH_PROMISE_ROSTER-$(roster_windows)}" MESH_CLAIM_LEAK_H="${MESH_CLAIM_LEAK_H:-$CLAIM_LEAK_H}" python3 - "$@" <<'PYEOF'
import sys, re, json, os
from datetime import datetime, timezone, timedelta

mode      = sys.argv[1]
chat_log  = sys.argv[2]
now_iso   = sys.argv[3]
leak_h    = float(sys.argv[4])
incid_h   = float(sys.argv[5])
min_ov    = int(sys.argv[6])
jout      = sys.argv[7] if len(sys.argv) > 7 else None
CLAIM_H   = float(os.environ.get('MESH_CLAIM_LEAK_H', '12'))
# BAD-DEBT WRITE-OFF horizon (reflex-broadcast claims ONLY — see the write-off block below). 0/absent
# disables it and the dead-letter is carried forever, the pre-2026-07-24 behaviour.
WRITEOFF_H = float(os.environ.get('MESH_CLAIM_WRITEOFF_H', '48'))
# minimum distinctive-token overlap for a CLAIM/HOLD redemption (see best_match_scoped).
CLAIM_MIN_OV = int(os.environ.get('MESH_CLAIM_MIN_OVERLAP', '2'))

# ROSTER (Component 2 — accounts.journal is the source of truth, passed in via env by the shell).
# An owner: that is NOT a declared roster window is quarantined to the VISIBLE :unrouted account
# rather than opening a phantom liability under a plausible-looking name (the claude-md/mesh-home/
# none/models/bruno phantoms live on 2026-07-24). FAIL-OPEN: an ABSENT roster (empty env) disables
# the check and trusts the owner as-is — an absent accounts.journal must not nuke every promise to
# unrouted (the opposite, silent, failure). The reject-at-write-time of a malformed owner is C1's
# job (mesh-chat grammar); here, over the historical board, quarantine-and-COUNT is the honest move.
ROSTER = set(w for w in os.environ.get('MESH_PROMISE_ROSTER', '').split() if w)
ROSTER_ACTIVE = bool(ROSTER)
def is_unrouted(owner):
    return ROSTER_ACTIVE and owner not in ROSTER
def acct_window(owner):
    return 'unrouted' if is_unrouted(owner) else sanitize(owner)

def parse_ts(s):
    try: return datetime.strptime(s.rstrip('Z'), '%Y-%m-%dT%H:%M:%S').replace(tzinfo=timezone.utc)
    except Exception:
        try: return datetime.strptime(s.rstrip('Z'), '%Y-%m-%dT%H:%M').replace(tzinfo=timezone.utc)
        except Exception: return None

now = parse_ts(now_iso) or datetime.now(timezone.utc)

# a REAL board marker is anchored at the body start (memory board-marker-grep-must-anchor-to-body):
#   <ts>  <who>@<node>  ::  [marker] body...
# fyi/sense are parsed too, but ONLY as passive CLAIM-redemption sources — they never open anything.
LINE = re.compile(r'^(\S+)\s+([^\s@]+)@(\S+)\s+::\s+\[(task|taking|done|verify|fyi|sense)\]\s*(.*)$')

STOP = set('''the and for with from into that this then than over live fixed done task tasks owner
owners operator operators priority incident mesh node home step steps adds wire wired make makes made
move moves moved scope scoped verify verified test tests testing green red line lines file files pane
panes dash uncommitted land lands landed deploy deploys deployed commit commits committed pushed proven
prove gate gates real reals when each both every none already round rounds restating blocked action now
next also into onto only just still yet were was been being have has had will would should could may
might must shall about above after again against all any are but can cast come does down else ever
first give goes here into its like more most much must need needs new not off out per put ran run runs
same seen sends sent she some such sure take takes than that them then they this thus told took upgrade
use used uses using very want wants what when will with work works your fyi done fix fixes flag flags
чтобы если есть быть было были надо нужно нужен нужна нужны должен должна должно должны через когда
после перед этот этой этого сейчас также тоже может можно очень потом здесь который которая которое
которые полностью просто ещё уже'''.split())

def toks(s, cap=None):
    # [\W_] not [^a-z0-9]: the board is bilingual — the ASCII alphabet returned ZERO tokens for a
    # Cyrillic lead, so operator (Russian) tasks could never be matched by overlap (test leg 11/12)
    out = []
    for w in re.split(r'[\W_]+', (s or '').lower()):
        if len(w) >= 4 and w not in STOP:
            out.append(w)
            if cap and len(out) >= cap: break
    return out

def sanitize(s):
    # \w is unicode in py3: Cyrillic survives into the slug (hledger accounts are UTF-8-clean).
    # The old [^a-z0-9] collapsed every Cyrillic lead to 'x' — all same-owner Russian tasks keyed
    # as ONE promise, and any Cyrillic done slug-matched all of them (false discharge).
    s = re.sub(r'[\W_]+', '-', (s or '').lower()).strip('-')
    return s[:40] or 'x'

def lead(body):
    # the promise's headline: up to the first ':' , '(' , '—' , ' - ' , or 'owner:'
    b = re.split(r'\bowner:', body, 1)[0]
    b = re.split(r'[:(]|—| - ', b, 1)[0]
    b = b.strip()
    # fallback: a headline that vanished (body led with ':' / '(') would sanitize to a shared 'x'
    # key and MERGE distinct promises — use the body head instead so each keeps its own identity.
    if len(b) < 4:
        b = re.sub(r'\s+', ' ', body).strip()[:70]
    return b

def owner_of(body, who):
    # LAST owner: match, not first — the routing clause TRAILS by board convention, and a task
    # ABOUT routing can quote `owner: <window>` mid-prose before its real clause (test leg 13)
    ms = re.findall(r'owner:\s*([^\s,;)]+)', body)
    if ms:
        o = ms[-1].rstrip('.,;:)')                   # strip trailing punctuation (owner: genome.)
        return o.split('/')[-1] if '/' in o else o   # tool/window → window
    return who

def is_incident(body):
    return bool(re.search(r'priority:\s*incident', body))

# ---- claim-family (CLAIM/HOLD) parsing helpers ----

def parse_addressed(body):
    # leading address form: "A->B: rest" / "A/B: rest" (arrow/slash -> B addressed) or bare
    # "A: rest" (A self-addressed). A short parenthetical may trail the address before the colon
    # ("health→discover (loop-baton): ...", live board convention) — tolerated, dropped. No leading
    # window-token -> (None, body) = unaddressed.
    m = re.match(r'^([a-zA-Z][\w-]{1,24})(?:[→/]([a-zA-Z][\w-]{1,24}))?\s*(?:\([^)]{0,30}\)\s*)?:\s*(.*)$',
                 body.strip(), re.S)
    if not m:
        return None, body
    debtor = (m.group(2) or m.group(1)).lower()
    return debtor, m.group(3)

def taking_slug_and_rest(body):
    # doctrine: "[taking] MUST reference a specific open [task] (its slug)" — the "<slug>: <detail>"
    # discipline, same shape as [done]. No colon-delimited lead = content-free heartbeat, not modeled.
    # Lead needs >=2 chars — the shortest live window is `tg` (2). {1,60} on the tail, NOT {2,60}, which
    # demanded 3 and silently dropped EVERY who-first `tg: <slug> — ...` (the operator's own lane), so
    # slug=None and the self-lead-drop in the caller was never reached (a live [taking] read as a
    # content-free heartbeat, held 6 days unseen). Guard the relaxation: {1,60} lets a bare `10:42`
    # clock reach the first colon, so reject an all-digit lead — a time is never a window/slug name.
    m = re.match(r'^([^\s:][^:]{1,60}):\s*(.*)$', body.strip(), re.S)
    if not m or m.group(1).strip().isdigit():
        return None, body
    return sanitize(m.group(1)), m.group(2)

def best_match_scoped(dtoks, dlead_slug, pool):
    # same matching discipline as best_match(), scoped to ONE debtor's/taker's own pool of opens.
    if dlead_slug in pool:
        return dlead_slug
    best, best_score = None, 0
    for k, o in pool.items():
        ov = len(set(dtoks) & set(o['ktoks']))
        # A single shared topic word is NOT a redemption. best_match() already refuses a one-token
        # cross-owner keep for promises ("weak single-token match = likely false"); claims and holds
        # need the same floor, and need it MORE — closing one is a positive all-clear about work
        # nobody did. Live pair it was failing on: senses' BLE-presence [fyi] naming a Bose speaker
        # closed the open "Bose voice SILENT since 07-17, never verified heard" check on the single
        # token "bose" (test 27). Wrong direction of error: an unmatched real redemption just leaves
        # a claim loud (recoverable); a false close reports a verification that never happened.
        if ov < max(min_ov, CLAIM_MIN_OV): continue
        if ov > best_score:
            best, best_score = k, ov
    return best

# ---- collect chronological events ----
events = []  # (ts, kind, who, owner, body)
try:
    fh = open(chat_log, errors='replace')
except FileNotFoundError:
    if mode == 'counts': print("open=0 leak=0 unrouted=0")
    elif mode == 'json': print(json.dumps({"open":[],"leaks":[],"kept":0,"unkeyed_done":0,"error":"no-board"}))
    else: sys.stderr.write("mesh-promises: no board (%s)\n" % chat_log)
    sys.exit(2)

for ln in fh:
    m = LINE.match(ln)
    if not m: continue
    ts_s, who, node, marker, body = m.groups()
    ts = parse_ts(ts_s)
    if ts is None: continue
    # roll-call / digests quote task state in prose; they post [fyi], but guard the poster too
    if who in ('roll-call',): continue
    events.append((ts, marker, who, owner_of(body, who), body.strip()))
events.sort(key=lambda e: e[0])
del fh

# ---- replay ----
# open promises keyed by derived slug. key = sanitized lead (dedup recurring same-lead tasks).
opens = {}       # key -> dict(owner, ts, incident, lead, ktoks, episode)
episodes = []    # (owner, slug, open_ts, close_ts|None, incident, lead)  — one per open→(keep|still-open)
kept = 0
unkeyed_done = 0
audit = []       # (kept_slug, done_lead) for --all

# CLAIM ([verify]) — nested by debtor so redemption only ever matches against what THAT debtor owes.
claims = {}          # debtor -> { slug -> dict(ts, lead, ktoks, reflex) }
claim_episodes = []  # (debtor, slug, open_ts, close_ts|None, lead, reflex)
claim_self_skipped = 0

# ── PASK CONVERSATION THEORY (teachback): agreement is NOT understanding ───────────────────────────
# review-second-order-cyb-pask-teachback-agreement-vs-understanding-2026-07-28 (LIVE literature).
# A [verify] claim is redeemed above by TOKEN-OVERLAP alone: a bare "[fyi] confirmed, looks right"
# closes it identically to an independent RE-DERIVATION. Gordon Pask's foundational result (Conversation
# Theory) is that agreement on a CONCLUSION is not understanding — understanding is certified ONLY by
# TEACHBACK: the redeemer reconstructs/re-derives the checked thing (a fresh artifact) rather than
# echoing the verdict ("rote responses are not accepted; understanding must be demonstrated by applying
# the knowledge in a concrete way", Pask via communicationtheory.org / cortland). The ledger applies
# "verified" too loosely: it counts a rubber-stamp as a redemption. We classify each redemption
# REPORT-ONLY (the close still stands — behaviour is the steward's): TEACHBACK iff the redeeming post
# carries a reconstruction artifact (commit hash, file:line, rc=, a measured quantity, a ratio, a cited
# `token`/URL); else ACK (assertion without demonstrated understanding — Pask: this does not close the
# loop). Bias is deliberately toward TEACHBACK on ambiguity: a false ACK over-accuses a real check,
# worse than a missed one, so any reconstruction token clears it.
_TEACHBACK_RE = re.compile(
    r'(?:\b[0-9a-f]{7,40}\b'          # a commit / content hash
    r'|[\w./+-]+:\d+'                 # file:line (a re-inspected location)
    r'|\brc=\d+'                      # an exit code from a re-run
    r'|\b\d+(?:\.\d+)?\s?(?:ms|s|%|mb|gb|kb|hz|bits?|b|px|x)\b'  # a measured quantity with a unit
    r'|\b\d+/\d+\b'                   # a ratio / count (17/17, 3/5)
    r'|`[^`]+`'                       # an inline-code / cited token, re-derived not echoed
    r'|https?://)',                   # a source re-read
    re.I)
def is_teachback(body):
    return bool(_TEACHBACK_RE.search(body or ''))
claim_teachback = 0      # redeemed [verify] whose redemption DEMONSTRATED reconstruction (Pask: understood)
claim_ack = 0            # redeemed [verify] closed by bare agreement — no reconstruction artifact
claim_ack_list = []      # (debtor, slug, lead) of ack-only redemptions — agreement without understanding

# HOLD ([taking]) — nested by taker so redemption only ever matches against what THAT taker holds.
holds = {}           # taker -> { slug -> dict(ts, lead, ktoks) }
hold_episodes = []   # (taker, slug, open_ts, close_ts|None, lead)
hold_skipped = 0     # content-free [taking] (no slug), not modeled — CLAUDE.md's heartbeat carve-out

# ORDER-WORD REDUNDANCY (Deleuze & Guattari, ATP plateau 4, "Postulates of Linguistics"): the
# order-word (mot d'ordre) functions by REDUNDANCY, not information — the same obligation repeated
# through the social field ("the elementary unit of language is the order-word … language is not
# informational, it is a redundancy"). This detector ALREADY collapses a recurring same-key post to
# ONE debt (the header's "redmi-ssh-key posted 6x = 1 debt") and DISCARDS the multiplicity. That
# discarded count IS the order-word redundancy: each re-issue transmits no NEW obligation — it is the
# poster shouting an order already in force. It is a LEADING tell of a leak, ORTHOGONAL to age (each
# re-post can reset a naive age clock while the rising re-issue count is the real signal that nobody
# is discharging it). Purely additive to the ledger: a re-issue is still 1 debt (the obligation is
# one), so parity/agreement/write-off are untouched — this only surfaces what dedup threw away.
ow_posts = 0             # obligation-bearing order-words posted (task + slug-taking + non-self verify)
ow_reissues = 0          # of those, ones repeating an obligation already open at the moment posted
reissue_by_key = {}      # "<family>:<key>" -> re-issue count (survives close; opens[] gets popped)

def best_match(dtoks, dlead_slug, downer):
    # return the open key this done best keeps, or None
    strong = [k for k,o in opens.items() if o['slug'] == dlead_slug]
    if strong:
        # leading-slug equality is the [done] <slug>: discipline — strongest signal
        return sorted(strong, key=lambda k: opens[k]['ts'])[0]
    best, best_score = None, 0
    for k,o in opens.items():
        ov = len(set(dtoks) & set(o['ktoks']))
        if ov < min_ov: continue
        score = ov + (1 if o['owner'] == downer else 0)
        # require overlap>=2 when owners differ (weak single-token cross-owner match = likely false)
        if o['owner'] != downer and ov < 2: continue
        if score > best_score or (score == best_score and best is not None and o['ts'] < opens[best]['ts']):
            best, best_score = k, score
    return best

for ts, marker, who, owner, body in events:
    if marker == 'task':
        hl = lead(body)
        key = sanitize(hl)
        # SELF-LEAD (window-name-as-slug): a poster who writes "[task] <own-window>: <what>"
        # (redundant self-address, same doctrine-adjacent shape as [taking]'s who-first form) makes
        # lead(body) their own window name — no [done] can ever slug-match it (a [done] leads with
        # the SUBJECT, not the poster's name), so it leaks FOREVER even after both sides agree on the
        # board it's closed. Live 2026-07-28/29: discover's "[task] discover: wire-mesh-log-attest-
        # board-alert" kept re-leaking as genome:discover a full day after genome's [done] closed it
        # and discover accepted the close — a [fyi] mutual-agreement never touches the ledger's
        # matcher, only a re-read slug does. Twin of the [taking] fix below (holds:X:X, 2026-07-27):
        # drop the self-lead and re-read the slug from what follows, same lead() discipline.
        if key == sanitize(who):
            rest = body.split(':', 1)[1] if ':' in body else ''
            if rest.strip():
                hl = lead(rest)
                key = sanitize(hl)
        ow_posts += 1                       # an obligation-bearing order-word
        if key in opens:                    # recurring re-post while still open → dedup
            if is_incident(body): opens[key]['incident'] = True
            ow_reissues += 1                # repeats an order already in force (redundancy)
            reissue_by_key['task:'+key] = reissue_by_key.get('task:'+key, 0) + 1
            continue
        opens[key] = dict(owner=owner, ts=ts, incident=is_incident(body),
                          lead=hl[:70], slug=key, ktoks=toks(hl, cap=8))
    elif marker == 'done':
        hl = lead(body)
        dtoks = toks(body, cap=12)
        k = best_match(dtoks, sanitize(hl), owner)
        if k:
            o = opens.pop(k)
            episodes.append((o['owner'], o['slug'], o['ts'], ts, o['incident'], o['lead']))
            kept += 1
            audit.append((o['slug'], hl[:50]))
        else:
            unkeyed_done += 1
        # a [done] can ALSO release a HOLD the same poster is sitting on (finishing the task
        # discharges both the promise and the taking-lock) — independent of whether it matched above.
        pool = holds.get(who)
        released = False
        if pool:
            hk = best_match_scoped(dtoks, sanitize(hl), pool)
            if hk:
                ho = pool.pop(hk)
                hold_episodes.append((who, hk, ho['ts'], ts, ho['lead']))
                released = True
        if not released:
            # RETIRED-TAKER INHERITANCE: release normally requires a [done] FROM THE SAME TAKER, but a
            # window that was merged away or decommissioned can never post again — its hold would age
            # LOUD forever with no one able to discharge it (the reflex-broadcast shape; live: chat's
            # quota-idle-verdict hold stood 56h after the 07-24 chat→witness merge, while genome had
            # posted the [done] 7 minutes after it was taken). The successor discharges it: a matching
            # [done] from ANY window releases it. Roster-GATED — while a taker is a live roster window
            # nothing else can close its hold, so this never becomes a way to steal another's claim.
            # FAIL-SAFE with the roster absent: is_unrouted() is False for everyone, so an empty
            # roster inherits NOTHING (no silent mass-release), same direction as the C2 fail-open.
            for taker, tpool in holds.items():
                if not (tpool and is_unrouted(taker)): continue
                hk = best_match_scoped(dtoks, sanitize(hl), tpool)
                if hk:
                    ho = tpool.pop(hk)
                    hold_episodes.append((taker, hk, ho['ts'], ts, ho['lead']))
                    break
    elif marker == 'taking':
        # [taking] is ALSO the in-the-moment lock (mesh-claim's job) — no PROMISE state change here.
        slug, rest = taking_slug_and_rest(body)
        # WHO-FIRST FORM: CLAUDE.md documents "[taking] <who>: <what>". A lead equal to the poster's
        # own window is an identity, not a slug — keying the hold on it minted holds:<who>:<who>,
        # which no [done] <slug> could ever release (live 2026-07-27: holds:discover:discover,
        # holds:genome:genome, holds:health:health — every doctrine-formatted [taking] on the board,
        # each a permanent false leak billed to its poster). Drop the self-lead and re-read the slug
        # from what follows, same lead() discipline as [task]/[done]. Poster's window ONLY — a lead
        # naming a DIFFERENT window stays a slug as far as this parser can know (test 24's dispatch
        # form). An empty remainder is content-free (a bare "[taking] genome:" claims nothing).
        if slug is not None and slug == sanitize(who):
            slug = sanitize(lead(rest)) if rest.strip() else None
        if slug is None:
            hold_skipped += 1               # content-free — heartbeat, not a claim held
        else:
            pool = holds.setdefault(who, {})
            ow_posts += 1                   # a slug-bearing [taking] is an order-word too
            if slug not in pool:            # recurring re-take while still open → dedup
                pool[slug] = dict(ts=ts, lead=(rest.strip() or body)[:70], ktoks=toks(rest, cap=8))
            else:
                ow_reissues += 1
                rk = 'hold:%s/%s' % (who, slug)
                reissue_by_key[rk] = reissue_by_key.get(rk, 0) + 1
    elif marker == 'verify':
        debtor, rest = parse_addressed(body)
        # OWNER-TAG FALLBACK: the leading-token address is a prose heuristic; the trailing
        # `owner: <tool>/<window>` clause is the poster's EXPLICIT routing (what dispatch already
        # routes by). When the heuristic yields no LIVE window — unaddressed (dead-letter) or a slug
        # that quarantines to :unrouted — take the explicit tag instead: the live "[verify]
        # room-speech-heard: ... owner: senses" sat 46h in quarantine while naming its window in
        # plain sight. FALLBACK, never override: a valid leading address wins over a trailing owner:
        # (code findings routinely carry "owner: <tool>/<window>" for the FIX, not for the check).
        if debtor is None or is_unrouted(debtor):
            tagged = owner_of(body, None)
            if tagged and not is_unrouted(tagged.lower()):
                debtor, rest = tagged.lower(), rest if debtor is not None else body
        reflex = debtor is None
        if reflex:
            debtor = 'reflex-broadcast'
        if (not reflex) and debtor == who:
            claim_self_skipped += 1         # self-addressed = a self-check, not an obligation on another
        else:
            hl = lead(rest) if rest.strip() else lead(body)
            slug = sanitize(hl)
            pool = claims.setdefault(debtor, {})
            ow_posts += 1                   # a [verify] owed to another window is an order-word too
            if slug not in pool:            # recurring re-post while still open → dedup
                pool[slug] = dict(ts=ts, lead=hl[:70], ktoks=toks(hl, cap=8), reflex=reflex)
            else:
                ow_reissues += 1
                rk = 'verify:%s/%s' % (debtor, slug)
                reissue_by_key[rk] = reissue_by_key.get(rk, 0) + 1
    elif marker in ('fyi', 'sense'):
        # passive redemption source ONLY — never opens a claim of its own.
        pool = claims.get(who)
        if pool:
            hl = lead(body)
            dtoks = toks(body, cap=12)
            ck = best_match_scoped(dtoks, sanitize(hl), pool)
            if ck:
                co = pool.pop(ck)
                claim_episodes.append((who, ck, co['ts'], ts, co['lead'], co['reflex']))
                # Pask teachback classification (report-only): did this redemption reconstruct, or ack?
                if is_teachback(body):
                    claim_teachback += 1
                else:
                    claim_ack += 1
                    claim_ack_list.append((who, ck, co['lead']))

# still-open promises become open-ended episodes
open_list = []
for k,o in opens.items():
    episodes.append((o['owner'], o['slug'], o['ts'], None, o['incident'], o['lead']))
    age_h = (now - o['ts']).total_seconds() / 3600.0
    thr = incid_h if o['incident'] else leak_h
    open_list.append(dict(owner=o['owner'], slug=o['slug'], lead=o['lead'],
                          opened=o['ts'].strftime('%Y-%m-%dT%H:%M:%SZ'),
                          age_h=round(age_h,1), incident=o['incident'],
                          threshold_h=thr, leaked=age_h > thr))
open_list.sort(key=lambda x: -x['age_h'])
leaks = [x for x in open_list if x['leaked']]
# open promises whose owner: is NOT a roster window — the phantom count, now a visible number.
unrouted_open = sum(1 for x in open_list if is_unrouted(x['owner']))

# still-open claims/holds become open-ended episodes too — same shape as promises.
claim_open_list = []
for debtor, pool in claims.items():
    for slug, o in pool.items():
        claim_episodes.append((debtor, slug, o['ts'], None, o['lead'], o['reflex']))
        age_h = (now - o['ts']).total_seconds() / 3600.0
        claim_open_list.append(dict(debtor=debtor, slug=slug, lead=o['lead'],
                                    opened=o['ts'].strftime('%Y-%m-%dT%H:%M:%SZ'),
                                    age_h=round(age_h,1), reflex=o['reflex'],
                                    threshold_h=CLAIM_H, leaked=age_h > CLAIM_H,
                                    # WRITE-OFF: a reflex-broadcast claim is uncollectible BY
                                    # CONSTRUCTION (no window can ever post as the dead-letter
                                    # account), so past the horizon it is written off rather than
                                    # carried at full value forever — the accounting answer to bad
                                    # debt. Only ever applies to `reflex`: a window-owed claim can
                                    # be paid, so it stays leaked no matter how old (writing THOSE
                                    # off would blind the detector to exactly what it exists for).
                                    written_off=bool(o['reflex'] and WRITEOFF_H > 0 and age_h > WRITEOFF_H)))
claim_open_list.sort(key=lambda x: -x['age_h'])
for x in claim_open_list:
    if x['written_off']: x['leaked'] = False
claim_writeoffs = [x for x in claim_open_list if x['written_off']]
writeoff_keys = set((x['debtor'], x['slug']) for x in claim_writeoffs)
claim_leaks = [x for x in claim_open_list if x['leaked']]

hold_open_list = []
for taker, pool in holds.items():
    for slug, o in pool.items():
        hold_episodes.append((taker, slug, o['ts'], None, o['lead']))
        age_h = (now - o['ts']).total_seconds() / 3600.0
        hold_open_list.append(dict(taker=taker, slug=slug, lead=o['lead'],
                                   opened=o['ts'].strftime('%Y-%m-%dT%H:%M:%SZ'),
                                   age_h=round(age_h,1), threshold_h=leak_h, leaked=age_h > leak_h))
hold_open_list.sort(key=lambda x: -x['age_h'])
hold_leaks = [x for x in hold_open_list if x['leaked']]

# I-CONFLUENCE / UNIQUENESS-VIOLATION (CALM theorem, Hellerstein & Alvaro, CACM 2020 / arXiv:1901.01930;
# Complete CALM, arXiv:2602.09435 2026; invariant confluence, Bailis et al. VLDB'15 arXiv:1402.2237).
# THE FOUNDATIONAL IDEA APPLIED TOO LOOSELY: the board is a grow-only set (G-Set) — monotone, hence
# coordination-free and convergent by CALM. But `[taking]` is asked to enforce "AT MOST ONE taker per
# task" (CLAUDE.md: "a claim that stops double-dispatch"). Uniqueness / mutual-exclusion is the CANONICAL
# NON-I-confluent invariant: two states each with one taker are individually valid, yet their MERGE (the
# board is set-union) has two — merging invariant-preserving states does NOT preserve the invariant. CALM
# proves this CANNOT be made safe coordination-free over gossip; the mesh has only PREVENTION
# (mesh-mind-control's ever-growing race patches: cross-node-dedup 07-07, presync 07-09, still racing at
# 20:03Z) and each patch only SHRINKS the window — up to ~25min of gossip lag guarantees it never closes.
# The theory-correct answer for a non-I-confluent invariant you can't afford to coordinate on: accept the
# occasional violation and RECONCILE it after the fact. This is that reconciliation arm — a DOUBLE-HOLD:
# the same task slug held OPEN by ≥2 DISTINCT takers at once (both unsettled = live wasted parallel work,
# the [[parallel-minds-same-goal-different-file]] harm, until now caught only by a human/review). Report-
# only (visibility, like --frontier/--metastable): it points at a merge-conflict to heal (one taker
# yields), it does not itself pick the winner. Slug-join is the same prose heuristic the rest of the tool
# carries — two takers who slugged the same task differently won't collide (a known false-negative).
hold_collisions = []
_holds_by_slug = {}
for _x in hold_open_list:
    _holds_by_slug.setdefault(_x['slug'], []).append(_x)
for _slug, _xs in _holds_by_slug.items():
    _takers = sorted(set(_x['taker'] for _x in _xs))
    if len(_takers) >= 2:
        _first = sorted(_xs, key=lambda x: x['opened'])[0]
        hold_collisions.append(dict(slug=_slug, takers=_takers, n=len(_takers), lead=_first['lead'],
                                    first_opened=_first['opened'], max_age_h=max(x['age_h'] for x in _xs)))
hold_collisions.sort(key=lambda c: -c['max_age_h'])

# ---- emit ----
if mode == 'redundancy':
    # ORDER-WORD REDUNDANCY R = re-issues / obligation-bearing posts. R=0 → every order-word
    # transmitted a NEW obligation (pure information, no resonance); R→1 → the board is almost all
    # repetition of orders already in force (loud, not moving). D&G: the order-word IS redundancy.
    R = (ow_reissues / ow_posts) if ow_posts else 0.0
    print("order-word redundancy: R=%.3f (%d re-issue(s) / %d obligation-bearing post(s)) · %s" % (
        R, ow_reissues, ow_posts, now.strftime('%H:%MZ')))
    if ow_reissues:
        print("  loudest order-words (an order re-issued while already in force — a leading leak tell):")
        for rk, n in sorted(reissue_by_key.items(), key=lambda kv: -kv[1])[:10]:
            fam, key = rk.split(':', 1)
            print("    %-7s ×%d re-issue(s)  %s" % (fam, n, key))
    else:
        print("  no order re-issued while already in force — every post carried a new obligation.")
    sys.exit(0)

if mode == 'teachback':
    # PASK: of the [verify] claims that were REDEEMED, how many by TEACHBACK (reconstruction shown)
    # vs by bare ACK (agreement asserted, understanding not demonstrated). U = teachback / redeemed.
    redeemed = claim_teachback + claim_ack
    U = (claim_teachback / redeemed) if redeemed else 0.0
    print("pask teachback: U=%.3f (%d reconstructed / %d redeemed [verify]) · %d ack-only · %s" % (
        U, claim_teachback, redeemed, claim_ack, now.strftime('%H:%MZ')))
    if claim_ack_list:
        print("  redeemed by ACK — agreement asserted, no reconstruction shown (Pask: loop not closed):")
        for debtor, slug, lead_ in claim_ack_list[:10]:
            print("    %-10s %s" % (debtor, lead_[:64]))
    elif redeemed:
        print("  every redeemed [verify] carried a reconstruction artifact — teachback clean.")
    else:
        print("  no redeemed [verify] in the window to classify.")
    sys.exit(0)

if mode == 'collisions':
    # CALM / I-confluence uniqueness-violation report: task slugs held OPEN by ≥2 distinct takers.
    # A coordination fault the append-only board can never PREVENT (uniqueness is non-monotone) — so
    # it is DETECTED here and healed by hand (one taker yields). Exit 1 if any, 0 if clean (honest).
    print("mesh-promises collisions: %d double-hold(s) — same task held by ≥2 takers (CALM uniqueness violation) · %s" % (
        len(hold_collisions), now.strftime('%H:%MZ')))
    if hold_collisions:
        print("  a G-Set board cannot enforce one-taker-per-task; reconcile by hand — one taker yields:")
        for c in hold_collisions:
            print("  ⚠ %-26s  %d takers [%s]  oldest %5.1fh  %s" % (
                c['slug'][:26], c['n'], ", ".join(c['takers']), c['max_age_h'], c['lead'][:40]))
    else:
        print("  no double-holds — every open [taking] is held by exactly one taker.")
    sys.exit(1 if hold_collisions else 0)

if mode == 'counts':
    print("open=%d leak=%d unrouted=%d claim_open=%d claim_leak=%d hold_open=%d hold_leak=%d collide=%d" % (
        len(open_list), len(leaks), unrouted_open,
        len(claim_open_list), len(claim_leaks), len(hold_open_list), len(hold_leaks),
        len(hold_collisions)))
    sys.exit(0)

if mode == 'json':
    print(json.dumps(dict(open=open_list, leaks=leaks, kept=kept, unkeyed_done=unkeyed_done,
                          claims=claim_open_list, claim_leaks=claim_leaks,
                          claim_self_skipped=claim_self_skipped,
                          claim_teachback=claim_teachback, claim_ack=claim_ack,
                          holds=hold_open_list, hold_leaks=hold_leaks, hold_skipped=hold_skipped,
                          hold_collisions=hold_collisions,
                          now=now.strftime('%Y-%m-%dT%H:%M:%SZ'))))
    sys.exit(1 if (leaks or claim_leaks or hold_leaks or hold_collisions) else 0)

if mode == 'journal':
    lines = ["; mesh-promises — double-entry promise ledger (auto-materialized from the board).",
             "; commodity PROMISE. bal liabilities:promises = the current OPEN obligation set.",
             "; commodity CLAIM  ([verify] owed) · commodity HOLD ([taking] held) — same idiom.",
             "; DO NOT hand-edit — regenerated from chat.log each --feed.", ""]
    # one txn per open, one per keep — netting in liabilities:promises:<owner>:<slug>
    seq = 0
    for owner, slug, ots, cts, incid, hl in sorted(episodes, key=lambda e: e[2]):
        seq += 1
        # owner segment is roster-validated: a non-roster owner books to :unrouted (VISIBLE), not a
        # phantom named window. The CLAIMED owner is preserved in the owner: tag either way, so the
        # quarantine loses no information — an unrouted promise still shows whom it claimed.
        acct = "liabilities:promises:%s:%s" % (acct_window(owner), slug)
        tag = "promise:%s owner:%s opened:%s%s" % (slug, owner,
                ots.strftime('%Y-%m-%dT%H:%M:%SZ'), " priority:incident" if incid else "")
        # TWO spaces min between account and amount — hledger's delimiter. A long (>pad) account with
        # only ONE space folds the amount INTO the account name, so open/keep land in DIFFERENT
        # mangled accounts and never net (parity still passes via inference — the silent trap).
        lines.append("%s * promise opened: %s  ; %s" % (ots.strftime('%Y-%m-%d'), slug, tag))
        lines.append("    %s  1 PROMISE" % acct)
        lines.append("    %s  -1 PROMISE" % "equity:promises")
        lines.append("")
        if cts is not None:
            lag = round((cts - ots).total_seconds()/3600.0, 1)
            lines.append("%s * promise kept: %s  ; promise:%s kept:%s lag:%sh" % (
                cts.strftime('%Y-%m-%d'), slug, slug, cts.strftime('%Y-%m-%dT%H:%M:%SZ'), lag))
            lines.append("    %s  -1 PROMISE" % acct)
            lines.append("    %s  1 PROMISE" % "equity:promises")
            lines.append("")

    # CLAIM txns — debtor segment roster-validated same as promises; reflex-broadcast is a DEDICATED
    # account (never quarantined into :unrouted — it is structural, not a mis-owned phantom).
    for debtor, slug, ots, cts, hl, reflex in sorted(claim_episodes, key=lambda e: e[2]):
        seq += 1
        leaf = 'reflex-broadcast' if reflex else acct_window(debtor)
        acct = "liabilities:claims:%s:%s" % (leaf, slug)
        tag = "claim:%s debtor:%s opened:%s%s" % (slug, debtor,
                ots.strftime('%Y-%m-%dT%H:%M:%SZ'), " reflex-broadcast" if reflex else "")
        lines.append("%s * claim opened: %s  ; %s" % (ots.strftime('%Y-%m-%d'), slug, tag))
        lines.append("    %s  1 CLAIM" % acct)
        lines.append("    %s  -1 CLAIM" % "equity:claims")
        lines.append("")
        if cts is not None:
            lag = round((cts - ots).total_seconds()/3600.0, 1)
            lines.append("%s * claim redeemed: %s  ; claim:%s redeemed:%s lag:%sh" % (
                cts.strftime('%Y-%m-%d'), slug, slug, cts.strftime('%Y-%m-%dT%H:%M:%SZ'), lag))
            lines.append("    %s  -1 CLAIM" % acct)
            lines.append("    %s  1 CLAIM" % "equity:claims")
            lines.append("")
        elif (debtor, slug) in writeoff_keys:
            # BAD-DEBT WRITE-OFF (reflex-broadcast only): the debt is REAL but uncollectible — no
            # window can ever post as the dead-letter account, so it can never be redeemed. Booked
            # out of the liability into expenses:claims:uncollectible, dated at the horizon crossing:
            # the ledger keeps the whole history (opened → written off), the standing balance stops
            # carrying a debt that can never be paid. A window-owed claim NEVER reaches this branch.
            wts = ots + timedelta(hours=WRITEOFF_H)
            lines.append("%s * claim written off (uncollectible): %s  ; claim:%s debtor:%s written-off-after:%.0fh" % (
                wts.strftime('%Y-%m-%d'), slug, slug, debtor, WRITEOFF_H))
            lines.append("    %s  -1 CLAIM" % acct)
            lines.append("    %s  1 CLAIM" % "expenses:claims:uncollectible")
            lines.append("")

    # HOLD txns — taker segment roster-validated same as promises (taker is always a real poster).
    for taker, slug, ots, cts, hl in sorted(hold_episodes, key=lambda e: e[2]):
        seq += 1
        acct = "liabilities:holds:%s:%s" % (acct_window(taker), slug)
        tag = "hold:%s taker:%s opened:%s" % (slug, taker, ots.strftime('%Y-%m-%dT%H:%M:%SZ'))
        lines.append("%s * hold taken: %s  ; %s" % (ots.strftime('%Y-%m-%d'), slug, tag))
        lines.append("    %s  1 HOLD" % acct)
        lines.append("    %s  -1 HOLD" % "equity:holds")
        lines.append("")
        if cts is not None:
            lag = round((cts - ots).total_seconds()/3600.0, 1)
            lines.append("%s * hold released: %s  ; hold:%s released:%s lag:%sh" % (
                cts.strftime('%Y-%m-%d'), slug, slug, cts.strftime('%Y-%m-%dT%H:%M:%SZ'), lag))
            lines.append("    %s  -1 HOLD" % acct)
            lines.append("    %s  1 HOLD" % "equity:holds")
            lines.append("")

    if jout:
        open(jout, 'w').write("\n".join(lines) + "\n")
    # claim_writeoff is load-bearing for --check: a written-off claim stays an OPEN episode here but
    # nets to ZERO in hledger, so the agreement cross-check must subtract it (else it reports its own
    # bookkeeping as a corrupted journal — which is exactly what it did when write-off first landed).
    print("open=%d leak=%d kept=%d unkeyed_done=%d unrouted=%d "
          "claim_open=%d claim_leak=%d claim_reflex=%d claim_self=%d claim_writeoff=%d "
          "hold_open=%d hold_leak=%d hold_skip=%d" % (
        len(open_list), len(leaks), kept, unkeyed_done, unrouted_open,
        len(claim_open_list), len(claim_leaks),
        sum(1 for x in claim_open_list if x['reflex']), claim_self_skipped, len(claim_writeoffs),
        len(hold_open_list), len(hold_leaks), hold_skipped))
    sys.exit(0)

if mode == 'all':
    print("mesh-promises · %d open promise(s) · %d kept · %d self-directed done(s) · %s" % (
        len(open_list), kept, unkeyed_done, now.strftime('%H:%MZ')))
    print("  %-10s %6s %3s  %s" % ("owner","age_h","!","promise"))
    for x in open_list:
        flag = "🔴" if x['leaked'] else ("‼" if x['incident'] else " ")
        print("  %-10s %6.1f %3s  %s" % (x['owner'], x['age_h'], flag, x['lead']))
    if claim_open_list:
        print("  -- claims ([verify] owed, %d self-check(s) skipped) --" % claim_self_skipped)
        print("  %-14s %6s %3s  %s" % ("debtor","age_h","!","claim"))
        for x in claim_open_list:
            flag = "🔴" if x['leaked'] else ("B" if x['reflex'] else " ")
            print("  %-14s %6.1f %3s  %s" % (x['debtor'], x['age_h'], flag, x['lead']))
    if hold_open_list:
        print("  -- holds ([taking] held, %d content-free skipped) --" % hold_skipped)
        print("  %-14s %6s %3s  %s" % ("taker","age_h","!","hold"))
        for x in hold_open_list:
            flag = "🔴" if x['leaked'] else " "
            print("  %-14s %6.1f %3s  %s" % (x['taker'], x['age_h'], flag, x['lead']))
    if hold_collisions:
        print("  -- double-holds (CALM uniqueness violation: same task, ≥2 takers) --")
        for c in hold_collisions:
            print("  ⚠ %-24s  %d [%s]  %s" % (c['slug'][:24], c['n'], ", ".join(c['takers']), c['lead'][:36]))
    sys.exit(0)

# mode report (default)
# The write-off is REPORTED, never silent — a liability that drops out of the leak list without a word
# is the failure mode the whole detector exists to prevent (a clean board that isn't).
def print_writeoffs():
    if claim_writeoffs:
        print("mesh-promises: %d reflex-broadcast claim(s) WRITTEN OFF (uncollectible >%.0fh — a dead-letter has no payer; the fix belongs at the POSTER, which must address its [verify] to a window): %s" % (
            len(claim_writeoffs), WRITEOFF_H, "; ".join(x['lead'][:40] for x in claim_writeoffs)))

any_leaks = bool(leaks or claim_leaks or hold_leaks or hold_collisions)
if not any_leaks:
    print("mesh-promises: no leaked promises/claims/holds (%d/%d/%d open, all within threshold; %d kept) · %s" % (
        len(open_list), len(claim_open_list), len(hold_open_list), kept, now.strftime('%H:%MZ')))
    print_writeoffs()
    sys.exit(0)
# COLLISION FIRST — a double-hold is live wasted work RIGHT NOW (two minds on one task), louder than an
# aged leak; CALM says the board can never PREVENT it, so surfacing it for hand-reconciliation is the job.
if hold_collisions:
    print("mesh-promises: %d DOUBLE-HOLD(s) — same task held by ≥2 takers (CALM uniqueness violation; reconcile by hand, one taker yields):" % len(hold_collisions))
    for c in hold_collisions:
        print("  ⚠ %-24s  %d takers [%s]  oldest %5.1fh  %s" % (
            c['slug'][:24], c['n'], ", ".join(c['takers']), c['max_age_h'], c['lead'][:40]))
if leaks:
    print("mesh-promises: %d LEAKED promise(s) — made, not kept, aged past threshold:" % len(leaks))
    for x in leaks:
        print("  🔴 %-10s  %5.1fh (>%.0fh%s)  %s" % (
            x['owner'], x['age_h'], x['threshold_h'], " incident" if x['incident'] else "", x['lead']))
if claim_leaks:
    print("mesh-promises: %d LEAKED claim(s) — [verify] owed, never redeemed:" % len(claim_leaks))
    for x in claim_leaks:
        tag = " [reflex-broadcast, structurally undischargeable]" if x['reflex'] else ""
        print("  🔴 %-14s  %5.1fh (>%.0fh)%s  %s" % (
            x['debtor'], x['age_h'], x['threshold_h'], tag, x['lead']))
if hold_leaks:
    print("mesh-promises: %d LEAKED hold(s) — [taking] claimed, never released:" % len(hold_leaks))
    for x in hold_leaks:
        print("  🔴 %-14s  %5.1fh (>%.0fh)  %s" % (
            x['taker'], x['age_h'], x['threshold_h'], x['lead']))
print_writeoffs()
sys.exit(1)
PYEOF
}

now_iso(){ date -u +%Y-%m-%dT%H:%M:%SZ; }

# ============================ commands ============================
do_report(){ replay report "$CHAT_LOG" "$(now_iso)" "$LEAK_H" "$LEAK_INCIDENT_H" "$MIN_OVERLAP"; }
do_all(){    replay all    "$CHAT_LOG" "$(now_iso)" "$LEAK_H" "$LEAK_INCIDENT_H" "$MIN_OVERLAP"; }
do_json(){   replay json   "$CHAT_LOG" "$(now_iso)" "$LEAK_H" "$LEAK_INCIDENT_H" "$MIN_OVERLAP"; }
do_redundancy(){ replay redundancy "$CHAT_LOG" "$(now_iso)" "$LEAK_H" "$LEAK_INCIDENT_H" "$MIN_OVERLAP"; }
do_teachback(){ replay teachback "$CHAT_LOG" "$(now_iso)" "$LEAK_H" "$LEAK_INCIDENT_H" "$MIN_OVERLAP"; }
do_collisions(){ replay collisions "$CHAT_LOG" "$(now_iso)" "$LEAK_H" "$LEAK_INCIDENT_H" "$MIN_OVERLAP"; }

do_balance(){
  have hledger || { echo "mesh-promises --balance: hledger not installed (n/a)"; exit 2; }
  ensure_repo; do_materialize >/dev/null
  [ -s "$JOURNAL" ] || { echo "(no promises booked yet)"; exit 2; }
  echo "standing open obligations (bal liabilities:promises · 1 PROMISE = open, netted):"
  hledger -f "$JOURNAL" balance liabilities:promises --no-total 2>/dev/null | grep -v ' 0 ' | sed 's/^/  /'
  echo "standing open claims (bal liabilities:claims · [verify] owed, netted):"
  hledger -f "$JOURNAL" balance liabilities:claims --no-total 2>/dev/null | grep -v ' 0 ' | sed 's/^/  /'
  echo "standing open holds (bal liabilities:holds · [taking] held, netted):"
  hledger -f "$JOURNAL" balance liabilities:holds --no-total 2>/dev/null | grep -v ' 0 ' | sed 's/^/  /'
}

# materialize the journal from the board; echo the counts line
do_materialize(){
  ensure_repo
  local tmp; tmp="$(mktemp)"
  local counts; counts="$(replay journal "$CHAT_LOG" "$(now_iso)" "$LEAK_H" "$LEAK_INCIDENT_H" "$MIN_OVERLAP" "$tmp")"
  mv -f "$tmp" "$JOURNAL"
  echo "$counts"
}

do_check(){
  have hledger || { echo "mesh-promises --check: hledger not installed (n/a)"; exit 2; }
  ensure_repo
  local counts; counts="$(do_materialize)"
  [ -s "$JOURNAL" ] || { echo "mesh-promises --check: no promises yet (n/a)"; exit 2; }
  echo "== parity (hledger check: every open/keep txn sums to zero) =="
  if hledger -f "$JOURNAL" check 2>&1 | sed 's/^/  /'; then echo "  parity: PASS"; else echo "  parity: FAIL"; exit 1; fi
  # no liability account may be NEGATIVE (a keep with no open = phantom over-discharge)
  local neg; neg="$(hledger -f "$JOURNAL" balance liabilities:promises --no-total 2>/dev/null | grep -E '^\s*-[0-9]' | head)"
  if [ -n "$neg" ]; then echo "  over-discharge: FAIL — negative liability (kept a promise never opened):"; echo "$neg" | sed 's/^/    /'; exit 1; fi
  local negc; negc="$(hledger -f "$JOURNAL" balance liabilities:claims --no-total 2>/dev/null | grep -E '^\s*-[0-9]' | head)"
  if [ -n "$negc" ]; then echo "  over-discharge (claims): FAIL — negative liability:"; echo "$negc" | sed 's/^/    /'; exit 1; fi
  local negh; negh="$(hledger -f "$JOURNAL" balance liabilities:holds --no-total 2>/dev/null | grep -E '^\s*-[0-9]' | head)"
  if [ -n "$negh" ]; then echo "  over-discharge (holds): FAIL — negative liability:"; echo "$negh" | sed 's/^/    /'; exit 1; fi
  echo "  over-discharge: none (no negative liability, promises/claims/holds)"
  # AGREEMENT: two independent computations of the open count must match (error-detecting code).
  # NOTE the anchor "(^| )" — "open=" is a substring of "claim_open="/"hold_open=", so an unanchored
  # grep would also match inside those longer tokens and corrupt this extraction (same trap class as
  # the substring-scan-turns-prose-into-a-verdict memory).
  local py_open hl_open
  py_open="$(echo "$counts" | grep -oE '(^| )open=[0-9]+' | cut -d= -f2)"
  hl_open="$(hledger -f "$JOURNAL" balance liabilities:promises --no-total -N 2>/dev/null | awk '{s+=$1} END{printf "%d", s+0}')"
  echo "== agreement (board replay open-count == hledger balance) =="
  if [ "${py_open:-x}" = "${hl_open:-y}" ]; then echo "  agreement: PASS (replay=$py_open == hledger=$hl_open)"; else
    echo "  agreement: FAIL — replay=$py_open != hledger=$hl_open (journal corrupted/edited)"; exit 1; fi
  local cl_open cl_hl cl_woff
  cl_open="$(echo "$counts" | grep -oE 'claim_open=[0-9]+' | cut -d= -f2)"
  # a WRITTEN-OFF claim is still an open episode in the replay but is booked OUT of the liability
  # (expenses:claims:uncollectible), so the standing balance is open MINUS written-off. Without this
  # the cross-check reports the ledger's own honest bookkeeping as a corrupted journal.
  cl_woff="$(echo "$counts" | grep -oE 'claim_writeoff=[0-9]+' | cut -d= -f2)"
  cl_open="$(( ${cl_open:-0} - ${cl_woff:-0} ))"
  cl_hl="$(hledger -f "$JOURNAL" balance liabilities:claims --no-total -N 2>/dev/null | awk '{s+=$1} END{printf "%d", s+0}')"
  echo "== agreement (claims: board replay open-count == hledger balance) =="
  if [ "${cl_open:-x}" = "${cl_hl:-y}" ]; then echo "  agreement: PASS (replay=$cl_open == hledger=$cl_hl)"; else
    echo "  agreement: FAIL — replay=$cl_open != hledger=$cl_hl (journal corrupted/edited)"; exit 1; fi
  local ho_open ho_hl
  ho_open="$(echo "$counts" | grep -oE 'hold_open=[0-9]+' | cut -d= -f2)"
  ho_hl="$(hledger -f "$JOURNAL" balance liabilities:holds --no-total -N 2>/dev/null | awk '{s+=$1} END{printf "%d", s+0}')"
  echo "== agreement (holds: board replay open-count == hledger balance) =="
  if [ "${ho_open:-x}" = "${ho_hl:-y}" ]; then echo "  agreement: PASS (replay=$ho_open == hledger=$ho_hl)"; else
    echo "  agreement: FAIL — replay=$ho_open != hledger=$ho_hl (journal corrupted/edited)"; exit 1; fi
  # ROSTER (Component 2): open promises whose owner: is NOT a declared window — quarantined to
  # :unrouted, VISIBLE not phantom. LOUD but not a hard gate here: these are historical board lines
  # (the live reject is C1/mesh-chat's job), and parity/agreement above are the exit-1 conditions.
  local roster; roster="$(roster_windows)"
  local unrouted; unrouted="$(echo "$counts" | grep -oE 'unrouted=[0-9]+' | cut -d= -f2)"
  echo "== roster (owner: validated against accounts.journal) =="
  if [ -z "$roster" ]; then echo "  roster: INACTIVE (no accounts.journal found — owners trusted as-is, fail-open)"
  elif [ "${unrouted:-0}" -gt 0 ]; then
    echo "  roster: $unrouted open promise(s) owned by NON-roster windows → liabilities:promises:unrouted (assign an owner or retire the task):"
    hledger -f "$JOURNAL" balance liabilities:promises:unrouted --no-total 2>/dev/null | grep -v ' 0 ' | sed 's/^/    /'
  else echo "  roster: clean (every open promise owned by a declared window)"; fi
  exit 0
}

write_summary(){
  local counts="$1"
  local open leak kept unrouted claim_open claim_leak hold_open hold_leak collide
  open="$(echo "$counts" | grep -oE '(^| )open=[0-9]+' | cut -d= -f2)"
  leak="$(echo "$counts" | grep -oE '(^| )leak=[0-9]+' | cut -d= -f2)"
  kept="$(echo "$counts" | grep -oE 'kept=[0-9]+' | cut -d= -f2)"
  unrouted="$(echo "$counts" | grep -oE 'unrouted=[0-9]+' | cut -d= -f2)"
  claim_open="$(echo "$counts" | grep -oE 'claim_open=[0-9]+' | cut -d= -f2)"
  claim_leak="$(echo "$counts" | grep -oE 'claim_leak=[0-9]+' | cut -d= -f2)"
  hold_open="$(echo "$counts" | grep -oE 'hold_open=[0-9]+' | cut -d= -f2)"
  hold_leak="$(echo "$counts" | grep -oE 'hold_leak=[0-9]+' | cut -d= -f2)"
  collide="$(echo "$counts" | grep -oE 'collide=[0-9]+' | cut -d= -f2)"
  # unrouted only shown when >0 (the phantom-owner count — a number that grows, per the spec)
  local urseg=""; [ "${unrouted:-0}" -gt 0 ] 2>/dev/null && urseg=" · ${unrouted} unrouted"
  # a double-hold is a coordination FAULT (CALM uniqueness violation) — shown only when >0, and LOUD.
  local colseg=""; [ "${collide:-0}" -gt 0 ] 2>/dev/null && colseg=" · ⚠ ${collide} DOUBLE-HOLD"
  printf 'promises: %s open · %s LEAKED · %s kept%s · claims %s open/%s LEAKED · holds %s open/%s LEAKED%s · as of %s\n' \
    "${open:-?}" "${leak:-?}" "${kept:-?}" "$urseg" "${claim_open:-?}" "${claim_leak:-?}" \
    "${hold_open:-?}" "${hold_leak:-?}" "$colseg" "$(date -u +%H:%MZ)" > "$SUMMARY"
}

# the witness pane's driving worklist — a few plain lines (owner · age · promise) per leak. Cheap
# (rendered from the json the feed already computed); witness reads it to know whom to drive.
write_leaks_cache(){  # $1 = json file
  python3 - "$1" "$LEAKS_CACHE" <<'PY'
import sys, json
jt, out = sys.argv[1], sys.argv[2]
try: j = json.load(open(jt))
except Exception: j = {}
leaks = j.get('leaks', [])
rows = ["  %-10s %5.0fh%s  %s" % (l['owner'], l['age_h'], " !" if l['incident'] else "  ", l['lead'][:46])
        for l in leaks[:8]]
crows = ["  %-10s %5.0fh %s  [claim] %s" % (l['debtor'], l['age_h'], "B" if l['reflex'] else " ", l['lead'][:40])
         for l in j.get('claim_leaks', [])[:4]]
hrows = ["  %-10s %5.0fh    [hold] %s" % (l['taker'], l['age_h'], l['lead'][:40])
         for l in j.get('hold_leaks', [])[:4]]
# double-holds first — a CALM uniqueness violation is live wasted work, louder than an aged leak.
xrows = ["  ⚠ %-20s [%s]  [double-hold] %s" % (c['slug'][:20], ", ".join(c['takers']), c['lead'][:32])
         for c in j.get('hold_collisions', [])[:4]]
rows = xrows + rows + crows + hrows
open(out, 'w').write(("\n".join(rows) + "\n") if rows else "")
PY
}

do_feed(){
  have hledger || { echo "mesh-promises --feed: hledger not installed" >&2; exit 2; }
  [ -f "$CHAT_LOG" ] || { echo "mesh-promises --feed: no board — n/a" >&2; exit 2; }
  ensure_repo
  # FIRST-RUN suppression: a brand-new detector must not retroactively alarm every historical leak
  # (that is the opposite of "rare and loud"). Seed state silently; alert only on leaks that appear
  # AFTER the detector exists.
  local first=0; [ -f "$STATE" ] || first=1
  local counts; counts="$(do_materialize)"
  # parity gate: refuse to commit a journal that does not balance (no oracle)
  if ! hledger -f "$JOURNAL" check >/tmp/mesh-promises-check.$$ 2>&1; then
    echo "mesh-promises --feed: REFUSED — journal does not balance:" >&2
    cat /tmp/mesh-promises-check.$$ >&2; rm -f /tmp/mesh-promises-check.$$; exit 1
  fi
  rm -f /tmp/mesh-promises-check.$$
  git_prom add -A >/dev/null 2>&1
  git_prom commit -q -m "promises feed: $counts" >/dev/null 2>&1
  write_summary "$counts"
  # liveness-touch: mtime = ran-live (always), content = change-gated (below)
  command -v mesh-state-touch >/dev/null 2>&1 && mesh-state-touch "$STATE" >/dev/null 2>&1 || touch "$STATE" 2>/dev/null

  # refresh the witness-pane surfaces (summary already written; add the leak worklist) + the
  # transition diff for the opt-in board post.
  local jt; jt="$(mktemp)"; do_json > "$jt" 2>/dev/null
  write_leaks_cache "$jt"
  local newleaks
  newleaks="$(python3 - "$jt" "$STATE" <<'PY'
import sys, json
jt, statef = sys.argv[1], sys.argv[2]
try: leaks = json.load(open(jt)).get('leaks', [])
except Exception: leaks = []
cur = {("%s/%s" % (l['owner'], l['slug'])) for l in leaks}
try: prev = set(x.strip() for x in open(statef) if x.strip() and not x.startswith('#'))
except FileNotFoundError: prev = set()
fresh = []
for l in leaks:
    k = "%s/%s" % (l['owner'], l['slug'])
    if k not in prev:
        fresh.append("%s (%s, %.0fh%s)" % (l['lead'], l['owner'], l['age_h'], " incident" if l['incident'] else ""))
# rewrite state to the CURRENT leaked set (so a re-closed→re-opened promise re-alerts honestly)
open(statef, 'w').write("# mesh-promises leaked keys (owner/slug), one per line\n" + "\n".join(sorted(cur)) + "\n")
print("\n".join(fresh))
PY
)"
  rm -f "$jt"
  local n; n="$(echo "$counts" | grep -oE '(^| )leak=[0-9]+' | cut -d= -f2)"
  echo "mesh-promises: $counts"
  if [ "$first" = 1 ]; then
    echo "mesh-promises: first run — seeded ${n:-0} existing leak(s) silently; will alert only on NEW leaks"
    newleaks=""
  fi
  # board auto-post is OPT-IN (witness owns surfacing by default — see header). MESH_PROMISE_NO_POST
  # is the hard override that keeps --test off the real board no matter what.
  if [ -n "$newleaks" ] && [ -n "${MESH_PROMISE_POST:-}" ] && [ -z "${MESH_PROMISE_NO_POST:-}" ] && have mesh-chat; then
    while IFS= read -r lk; do
      [ -n "$lk" ] || continue
      mesh-chat "[fyi] promise-leak: a board promise crossed the leak threshold unkept — $lk. Owner: pick it up or explicitly retire it. (mesh-promises)" >/dev/null 2>&1
    done <<< "$newleaks"
    echo "mesh-promises: posted $(echo "$newleaks" | grep -c .) new leak alert(s) to the board"
  fi
}

do_dash(){
  echo "mesh-promises · board promise leak detector · $(date -u +%H:%MZ) · $(hostname)"
  local counts; counts="$(replay journal "$CHAT_LOG" "$(now_iso)" "$LEAK_H" "$LEAK_INCIDENT_H" "$MIN_OVERLAP" /dev/null 2>/dev/null)"
  write_summary "$counts"
  [ -f "$SUMMARY" ] && sed 's/^/  /' "$SUMMARY"
  echo "── leaked (made, not kept, aged) ──"
  do_report 2>/dev/null | grep '🔴' | head -8 | sed 's/^/  /'
  do_report >/dev/null 2>&1 || true
  echo "── oldest open (any age) ──"
  do_all 2>/dev/null | tail -n +3 | head -6 | sed 's/^/  /'
}

# ============================ --test (RED-first) ============================
do_test(){
  have hledger || { echo "smoke-test: FAIL (hledger not installed)"; exit 1; }
  have python3 || { echo "smoke-test: FAIL (no python3)"; exit 1; }
  local t; t="$(mktemp -d)"; trap 'rm -rf "$t"' RETURN
  export MESH_PROMISE_NO_POST=1
  local NOW=2026-07-24T12:00:00Z

  # a synthetic board: an OLD unkept task (should leak), a kept task, an incident, a self-directed done
  cat > "$t/board" <<'EOF'
2026-07-23T00:00:00Z  genome@n  ::  [task] wire the frobnicator reflex into cron. owner: genome
2026-07-23T01:00:00Z  senses@n  ::  [task] calibrate the widget sensor axis. owner: senses/senses
2026-07-23T02:00:00Z  senses@n  ::  [done] widget: calibrated the widget sensor axis, RED-first proven.
2026-07-24T09:00:00Z  health@n  ::  [task] investigate uplink flap. owner: health priority:incident
2026-07-24T05:00:00Z  pub@n     ::  [done] drafted a reply nobody asked for as self-directed work.
EOF

  # 1) RED SEEN: the frobnicator task (36h old, unkept) MUST be flagged a leak. If the detector does
  #    not fire here, it detects nothing — a leak detector you have not seen fire is not one.
  local rep rc; rep="$(replay report "$t/board" "$NOW" 24 6 1)"; rc=$?
  echo "$rep" | grep -q 'frobnicator' || { echo "smoke-test: FAIL (aged unkept promise NOT flagged — VACUOUS detector)"; echo "$rep" | sed 's/^/    /'; exit 1; }
  [ $rc -eq 1 ] || { echo "smoke-test: FAIL (report exit want 1 with leaks, got $rc)"; exit 1; }

  # 2) the KEPT widget task MUST NOT be flagged (done matched it → cleared)
  echo "$rep" | grep -q 'widget' && { echo "smoke-test: FAIL (kept promise flagged as leak — false positive)"; exit 1; }

  # 3) incident MATURES FASTER: the 3h-old incident is NOT yet leaked at 6h, but IS at 2h threshold.
  #    (capture-then-grep: report exits 1 when leaks exist, so a `report | grep` pipeline would return
  #    report's exit under pipefail — a false verdict even when grep matches. Same family as the
  #    pipefail-SIGPIPE trap. Grep the captured text, not the pipeline status.)
  local r2 r6
  r2="$(replay report "$t/board" "$NOW" 24 2 1)"
  echo "$r2" | grep -q 'uplink' || { echo "smoke-test: FAIL (incident not flagged at tightened 2h threshold)"; exit 1; }
  r6="$(replay report "$t/board" "$NOW" 24 6 1)"
  echo "$r6" | grep -q 'uplink' && { echo "smoke-test: FAIL (3h incident leaked at 6h threshold — too eager)"; exit 1; }

  # 4) GREEN: close the frobnicator, it must CLEAR (the transition a real leak detector must show)
  cat > "$t/board2" <<'EOF'
2026-07-23T00:00:00Z  genome@n  ::  [task] wire the frobnicator reflex into cron. owner: genome
2026-07-23T06:00:00Z  genome@n  ::  [done] frobnicator: wired the frobnicator reflex into cron, autowired + --test green.
EOF
  local rc4; rc4="$(replay report "$t/board2" "$NOW" 24 6 1)"
  echo "$rc4" | grep -q 'frobnicator' && { echo "smoke-test: FAIL (kept frobnicator still flagged — does not clear)"; exit 1; }

  # 5) JOURNAL PARITY: the materialized journal must balance (double-entry error-detecting code)
  local jf="$t/j.journal"
  replay journal "$t/board" "$NOW" 24 6 1 "$jf" >/dev/null
  hledger -f "$jf" check >/dev/null 2>&1 || { echo "smoke-test: FAIL (materialized journal does not balance)"; exit 1; }

  # 6) AGREEMENT: board-replay open-count == hledger balance (two independent computations)
  local py_open hl_open
  py_open="$(replay counts "$t/board" "$NOW" 24 6 1 | grep -oE '(^| )open=[0-9]+' | cut -d= -f2)"
  hl_open="$(hledger -f "$jf" balance liabilities:promises --no-total -N 2>/dev/null | awk '{s+=$1} END{printf "%d", s+0}')"
  [ "$py_open" = "$hl_open" ] || { echo "smoke-test: FAIL (agreement: replay open=$py_open != hledger=$hl_open)"; exit 1; }

  # 7) OVER-DISCHARGE seen caught: a hand-forged journal that keeps a promise never opened must drive
  #    a NEGATIVE liability — the parity/sanity gate must catch it (proves the check isn't decorative).
  cat > "$t/bad.journal" <<'EOF'
2026-07-24 * promise kept: ghost  ; promise:ghost
    liabilities:promises:genome:ghost                -1 PROMISE
    equity:promises                                   1 PROMISE
EOF
  local neg; neg="$(hledger -f "$t/bad.journal" balance liabilities:promises --no-total 2>/dev/null | grep -E '^\s*-[0-9]')"
  [ -n "$neg" ] || { echo "smoke-test: FAIL (over-discharge gate VACUOUS — negative liability not visible)"; exit 1; }

  # 8) marker discipline: a [task] token QUOTED mid-prose in an [fyi] digest must NOT open a promise
  cat > "$t/board3" <<'EOF'
2026-07-24T09:00:00Z  roll-call@n  ::  [fyi] digest: the [task] backlog is empty; nothing outstanding.
2026-07-24T09:01:00Z  witness@n    ::  [idle] swept, green — the [task] queue quoted above is closed.
EOF
  local o3; o3="$(replay counts "$t/board3" "$NOW" 24 6 1)"
  case "$o3" in "open=0 leak=0"*) :;; *) echo "smoke-test: FAIL (mid-prose [task] quote opened a phantom promise: $o3)"; exit 1;; esac

  # 9) honest n/a: no board → exit 2 (not a fake all-clear)
  replay report "$t/nope" "$NOW" 24 6 1 >/dev/null 2>&1; [ $? -eq 2 ] || { echo "smoke-test: FAIL (missing board did not return n/a exit 2)"; exit 1; }

  # 10) LONG-ACCOUNT NETTING: a kept promise with a long owner:slug (account >48 chars) must NET to
  #     zero per-account. The one-space-delimiter bug folded the amount into the account name, so
  #     open/keep landed in DIFFERENT mangled accounts and NEVER netted (parity/agreement still
  #     passed via hledger's inference — the silent trap). Assert the account is netted away entirely.
  cat > "$t/board4" <<'EOF'
2026-07-23T00:00:00Z  senses@n  ::  [task] chat-review-access-probe-blind-from-down-and-noise. owner: senses/senses
2026-07-23T03:00:00Z  senses@n  ::  [done] chat-review-access-probe-blind-from-down-and-noise: fixed, RED-first proven.
EOF
  local jf4="$t/j4.journal"
  replay journal "$t/board4" "$NOW" 24 6 1 "$jf4" >/dev/null
  local resid; resid="$(hledger -f "$jf4" balance liabilities:promises --no-total 2>/dev/null | grep -c 'chat-review-access-probe')"
  [ "$resid" = "0" ] || { echo "smoke-test: FAIL (long-account kept promise did NOT net to zero — $resid residual row(s), the one-space bug)"; hledger -f "$jf4" balance liabilities:promises 2>/dev/null | sed 's/^/    /'; exit 1; }

  # 11) CYRILLIC SLUGS: the operator's tasks are Russian. The ASCII-only sanitize/toks alphabet
  #     collapsed every Cyrillic lead to the degenerate slug 'x' (live: liabilities:promises:witness:x
  #     for «спроектировать борд как игру…», 2026-07-24) — all same-owner Cyrillic tasks keyed as ONE
  #     promise, and toks() returned zero tokens so a Cyrillic [done] could never match by overlap.
  #     Assert: two Cyrillic tasks yield two NON-degenerate slugs, a token-sharing Cyrillic done
  #     discharges its task, and the Cyrillic-account journal still balances.
  cat > "$t/board5" <<'EOF'
2026-07-24T10:00:00Z  tg@n  ::  [task] спроектировать борд как игру чтобы легло на hledger. owner: witness
2026-07-24T10:05:00Z  tg@n  ::  [task] диспатч должен быть событийным через леджер. owner: genome
2026-07-24T11:00:00Z  witness@n  ::  [done] спроектировал борд как игру, правила записаны.
EOF
  local jf5="$t/j5.journal"
  replay journal "$t/board5" "$NOW" 24 6 1 "$jf5" >/dev/null
  grep -qE 'liabilities:promises:[a-z0-9-]+:x( |$)' "$jf5" && { echo "smoke-test: FAIL (Cyrillic lead degenerated to slug 'x' — ASCII-blind sanitize)"; grep 'promise opened' "$jf5" | sed 's/^/    /'; exit 1; }
  local o5; o5="$(replay counts "$t/board5" "$NOW" 24 6 1 | grep -oE '(^| )open=[0-9]+' | cut -d= -f2)"
  [ "$o5" = "1" ] || { echo "smoke-test: FAIL (Cyrillic done must discharge its token-sharing task: want open=1, got open=$o5)"; exit 1; }
  hledger -f "$jf5" check >/dev/null 2>&1 || { echo "smoke-test: FAIL (Cyrillic-account journal does not balance)"; exit 1; }

  # 12) CYRILLIC NO-FALSE-DISCHARGE: a Cyrillic [done] sharing NO tokens with the open task must NOT
  #     close it. Under the degenerate-'x' bug both sides sanitized to 'x', so slug-equality matched
  #     ANY Cyrillic done to ANY same-owner Cyrillic task — a false discharge, the irreversible
  #     direction (an unkept promise silently marked kept never leaks).
  cat > "$t/board6" <<'EOF'
2026-07-24T10:00:00Z  tg@n  ::  [task] диспатч должен быть событийным через леджер. owner: genome
2026-07-24T11:00:00Z  genome@n  ::  [done] починил роутер на кухне полностью, кабель заменён.
EOF
  local o6; o6="$(replay counts "$t/board6" "$NOW" 24 6 1 | grep -oE '(^| )open=[0-9]+' | cut -d= -f2)"
  [ "$o6" = "1" ] || { echo "smoke-test: FAIL (token-disjoint Cyrillic done falsely discharged the task: want open=1, got open=$o6)"; exit 1; }

  # 13) OWNER = LAST CLAUSE: the routing clause TRAILS by board convention, so a task whose prose
  #     quotes `owner: <window>` mid-sentence (a task ABOUT routing) must still key its promise to
  #     the real trailing clause. Live 2026-07-24: the event-dispatch task opened under owner
  #     'window' — its own prose hijacked the first-match extraction.
  cat > "$t/board7" <<'EOF'
2026-07-24T10:00:00Z  tg@n  ::  [task] постинг с owner: <window> должен будить окно сразу. owner: mesh-land/genome
EOF
  local jf7="$t/j7.journal"
  replay journal "$t/board7" "$NOW" 24 6 1 "$jf7" >/dev/null
  grep -q 'liabilities:promises:genome:' "$jf7" || { echo "smoke-test: FAIL (trailing owner clause lost — promise keyed to prose-quoted owner, not genome)"; grep liabilities "$jf7" | sed 's/^/    /'; exit 1; }

  # 14) ROSTER QUARANTINE (Component 2): a [task] owned by a NON-roster window (retired 'bruno') must
  #     book to liabilities:promises:unrouted, NOT a phantom liabilities:promises:bruno — the live
  #     claude-md/mesh-home/none/models/bruno phantoms, 2026-07-24. A roster owner in the same board
  #     still books to its own account; the claimed owner survives in the owner: tag either way.
  cat > "$t/board8" <<'EOF'
2026-07-24T10:00:00Z  tg@n  ::  [task] почини грайндер полностью. owner: bruno
2026-07-24T10:05:00Z  tg@n  ::  [task] событийный диспатч через леджер. owner: genome
EOF
  local jf8="$t/j8.journal"
  MESH_PROMISE_ROSTER="tg genome witness senses health discover sound pub vpn tg-roz" \
    replay journal "$t/board8" "$NOW" 24 6 1 "$jf8" >/dev/null
  grep -q 'liabilities:promises:bruno:' "$jf8" && { echo "smoke-test: FAIL (non-roster owner 'bruno' opened a PHANTOM named liability instead of :unrouted)"; grep liabilities "$jf8" | sed 's/^/    /'; exit 1; }
  grep -q 'liabilities:promises:unrouted:' "$jf8" || { echo "smoke-test: FAIL (non-roster owner not quarantined to :unrouted)"; grep liabilities "$jf8" | sed 's/^/    /'; exit 1; }
  grep -q 'liabilities:promises:genome:' "$jf8" || { echo "smoke-test: FAIL (roster owner 'genome' must still book to its own account)"; exit 1; }
  grep -q 'owner:bruno' "$jf8" || { echo "smoke-test: FAIL (quarantine dropped the claimed owner from the tag)"; exit 1; }
  hledger -f "$jf8" check >/dev/null 2>&1 || { echo "smoke-test: FAIL (quarantined journal does not balance)"; exit 1; }

  # 15) FAIL-OPEN: with NO roster (accounts.journal absent → empty MESH_PROMISE_ROSTER, set-but-empty
  #     so the `-` default is NOT triggered), a non-roster owner must book to its OWN named account,
  #     NOT unrouted — an absent chart must never nuke every promise to quarantine (the opposite,
  #     silent, failure). Asserts the fail-safe direction the ROSTER_ACTIVE guard exists for.
  local jf9="$t/j9.journal"
  MESH_PROMISE_ROSTER="" replay journal "$t/board8" "$NOW" 24 6 1 "$jf9" >/dev/null
  grep -q 'liabilities:promises:bruno:' "$jf9" || { echo "smoke-test: FAIL (fail-open broken — empty roster quarantined a valid-as-is owner)"; grep liabilities "$jf9" | sed 's/^/    /'; exit 1; }
  grep -q 'liabilities:promises:unrouted:' "$jf9" && { echo "smoke-test: FAIL (empty roster must NOT quarantine — fail-open violated)"; exit 1; }

  # ============= claim-family (CLAIM/HOLD) — 2026-07-24 extension =============
  export MESH_CLAIM_LEAK_H=12

  # 16) CLAIM opens on an addressed [verify] and LEAKS when the debtor never redeems it (36h > 12h SLA).
  cat > "$t/boardc1" <<'EOF'
2026-07-23T00:00:00Z  tg@n      ::  [verify] genome: check the port-forward reflex actually rebinds after a DHCP renew.
EOF
  local repc1; repc1="$(replay report "$t/boardc1" "$NOW" 24 6 1)"
  echo "$repc1" | grep -q 'port-forward' || { echo "smoke-test: FAIL (addressed [verify] not opened/leaked as a claim)"; echo "$repc1" | sed 's/^/    /'; exit 1; }

  # 17) CLAIM REDEMPTION: a later [fyi] FROM the debtor with overlapping tokens closes it — clears.
  cat > "$t/boardc2" <<'EOF'
2026-07-23T00:00:00Z  tg@n      ::  [verify] genome: check the port-forward reflex actually rebinds after a DHCP renew.
2026-07-23T02:00:00Z  genome@n  ::  [fyi] confirmed the port-forward reflex rebinds cleanly after a DHCP renew, tested twice.
EOF
  local repc2; repc2="$(replay report "$t/boardc2" "$NOW" 24 6 1)"
  echo "$repc2" | grep -q 'port-forward' && { echo "smoke-test: FAIL (redeemed claim still flagged — does not clear)"; exit 1; }

  # 18) CLAIM SELF-SKIP: a self-addressed [verify] ("health: verified ...") is a self-check, not an
  #     obligation on someone else — must NOT open a claim at all (0 open, not "open and instantly kept").
  cat > "$t/boardc3" <<'EOF'
2026-07-21T15:02:23Z  health@n  ::  [verify] health: verified discover's finding live — confirmed, matches exactly.
EOF
  local cc3; cc3="$(replay counts "$t/boardc3" "$NOW" 24 6 1)"
  echo "$cc3" | grep -q 'claim_open=0' || { echo "smoke-test: FAIL (self-addressed [verify] opened a phantom claim: $cc3)"; exit 1; }

  # 19) CLAIM REFLEX-BROADCAST: a [verify] with no addressable leading window-token books to the
  #     dedicated reflex-broadcast account and is NEVER redeemable BY CONSTRUCTION — no window can ever
  #     post as "reflex-broadcast", so an unrelated window's [fyi] on the same topic must NOT close it
  #     (the sharpest leak class discover found: reflex alerts nobody owns, aged 10-44h live).
  cat > "$t/boardc4" <<'EOF'
2026-07-20T00:00:00Z  load-audit@n  ::  [verify] [JUNK-LOAD] sustained load average 22.4 for 44 hours — investigate.
2026-07-21T00:00:00Z  health@n      ::  [fyi] investigated the sustained load average situation, looks stable now.
EOF
  local jfc4="$t/jc4.journal"
  replay journal "$t/boardc4" "$NOW" 24 6 1 "$jfc4" >/dev/null
  grep -q 'liabilities:claims:reflex-broadcast:' "$jfc4" || { echo "smoke-test: FAIL (unaddressed [verify] did not book to reflex-broadcast)"; grep liabilities "$jfc4" | sed 's/^/    /'; exit 1; }
  local repc4; repc4="$(replay report "$t/boardc4" "$NOW" 24 6 1)"
  echo "$repc4" | grep -q 'reflex-broadcast' || { echo "smoke-test: FAIL (reflex-broadcast claim did not surface as leaked despite an unrelated window's fyi)"; exit 1; }

  # 20) HOLD opens on a [taking] with a slug and LEAKS when the taker never releases it (36h > 24h SLA).
  cat > "$t/boardh1" <<'EOF'
2026-07-23T00:00:00Z  discover@n  ::  [taking] widget-audit: discover — auditing the widget subsystem now.
EOF
  local reph1; reph1="$(replay report "$t/boardh1" "$NOW" 24 6 1)"
  echo "$reph1" | grep -q 'widget' || { echo "smoke-test: FAIL (slugged [taking] not opened/leaked as a hold)"; echo "$reph1" | sed 's/^/    /'; exit 1; }

  # 21) HOLD REDEMPTION: a later [done] FROM THE SAME TAKER matching the slug releases it — clears.
  cat > "$t/boardh2" <<'EOF'
2026-07-23T00:00:00Z  discover@n  ::  [taking] widget-audit: discover — auditing the widget subsystem now.
2026-07-23T02:00:00Z  discover@n  ::  [done] widget-audit: audited the widget subsystem, all clean.
EOF
  local reph2; reph2="$(replay report "$t/boardh2" "$NOW" 24 6 1)"
  echo "$reph2" | grep -q 'widget' && { echo "smoke-test: FAIL (released hold still flagged — does not clear)"; exit 1; }

  # 22) HOLD CONTENT-FREE SKIP: a bare "[taking]" with no "<slug>: " lead is a heartbeat (CLAUDE.md's
  #     "not a sign of life" carve-out) — must NOT open a hold.
  cat > "$t/boardh3" <<'EOF'
2026-07-23T00:00:00Z  senses@n  ::  [taking] just orienting, nothing new to claim yet.
EOF
  local ch3; ch3="$(replay counts "$t/boardh3" "$NOW" 24 6 1)"
  echo "$ch3" | grep -q 'hold_open=0' || { echo "smoke-test: FAIL (content-free [taking] opened a phantom hold: $ch3)"; exit 1; }

  # 22b) TWO-CHAR WINDOW HOLD: the doctrine who-first form "[taking] <who>: <slug> — <detail>" from
  #      the SHORTEST live window (tg, 2 chars) MUST open a hold. The old {2,60} tail demanded a >=3
  #      char lead, so taking_slug_and_rest returned slug=None for every `tg: ...` — the whole tg lane,
  #      the one carrying live operator requests — and the self-lead-drop that re-reads the real slug
  #      was never reached. Live: operator-diary-transcription-batch2 held 6 days, minted NO hold; the
  #      operator noticed before the leak detector could. (promises-two-char-window-mints-no-hold.)
  cat > "$t/boardh4" <<'EOF'
2026-07-23T00:00:00Z  tg@n  ::  [taking] tg: diary-batch2 — transcribing the operator's 52 diary pages.
EOF
  local ch4; ch4="$(replay counts "$t/boardh4" "$NOW" 24 6 1)"
  echo "$ch4" | grep -q 'hold_open=1' || { echo "smoke-test: FAIL (2-char window who-first [taking] minted NO hold — the tg lane is invisible: $ch4)"; exit 1; }
  local reph4; reph4="$(replay report "$t/boardh4" "$NOW" 24 6 1)"
  echo "$reph4" | grep -q 'diary-batch2' || { echo "smoke-test: FAIL (2-char window hold not surfaced/leaked by slug)"; echo "$reph4" | sed 's/^/    /'; exit 1; }

  # 22c) THE GUARD (relaxing the lead must NOT newly swallow a clock): a body whose lead is a bare
  #      HH:MM time — all-digits before the first colon — is NOT a slug. Under {2,60} a 2-digit hour
  #      never matched; {1,60} makes `10` reach the first colon, so an explicit all-digit-lead reject
  #      keeps a time-lead from minting a phantom hold keyed on the hour.
  cat > "$t/boardh4t" <<'EOF'
2026-07-23T00:00:00Z  senses@n  ::  [taking] 10:42 was when the flap started, still orienting.
EOF
  local ch4t; ch4t="$(replay counts "$t/boardh4t" "$NOW" 24 6 1)"
  echo "$ch4t" | grep -q 'hold_open=0' || { echo "smoke-test: FAIL (a HH:MM time-lead minted a phantom hold after the {1,60} relaxation: $ch4t)"; exit 1; }

  # 23) CLAIM+HOLD JOURNAL PARITY/AGREEMENT: a board mixing an open claim, a redeemed claim, an open
  #     hold and a redeemed hold must materialize a BALANCING journal (double-entry error-detecting code).
  cat > "$t/boardch" <<'EOF'
2026-07-24T10:00:00Z  tg@n      ::  [verify] genome: check the port-forward reflex rebinds after DHCP renew.
2026-07-23T01:00:00Z  vpn@n     ::  [verify] health: check the egress latency spike on the NL exit.
2026-07-23T02:00:00Z  health@n  ::  [fyi] checked the egress latency spike on the NL exit, transient, resolved.
2026-07-23T00:30:00Z  discover@n ::  [taking] widget-audit: discover — auditing the widget subsystem now.
2026-07-23T03:00:00Z  discover@n ::  [done] widget-audit: audited the widget subsystem, all clean.
2026-07-24T09:00:00Z  senses@n  ::  [taking] sensor-recal: senses — recalibrating the mag axis.
EOF
  local jfch="$t/jch.journal"
  replay journal "$t/boardch" "$NOW" 24 6 1 "$jfch" >/dev/null
  hledger -f "$jfch" check >/dev/null 2>&1 || { echo "smoke-test: FAIL (claim+hold journal does not balance)"; hledger -f "$jfch" check 2>&1 | sed 's/^/    /'; exit 1; }
  local cch; cch="$(replay counts "$t/boardch" "$NOW" 24 6 1)"
  echo "$cch" | grep -q 'claim_open=1 claim_leak=0' || { echo "smoke-test: FAIL (claim open/redeemed counts wrong: $cch)"; exit 1; }
  echo "$cch" | grep -q 'hold_open=1 hold_leak=0' || { echo "smoke-test: FAIL (hold open/released counts wrong: $cch)"; exit 1; }

  # 24) RETIRED-TAKER HOLD INHERITANCE: a hold taken by a window that NO LONGER EXISTS can never be
  #     released by its taker — release requires a [done] FROM THE SAME TAKER and no one can ever post
  #     as a merged-away window again (structurally the reflex-broadcast shape, but here the right
  #     answer is INHERITANCE, not eternal loudness). Live case: chat took quota-idle-verdict on
  #     07-22, genome did the work and posted [done] 7 minutes later, chat was merged into witness on
  #     07-24 — the hold then stood 56h against a window that does not exist. Roster-gated: a [done]
  #     from ANY window releases a hold whose taker is off the roster.
  cat > "$t/boardh5" <<'EOF'
2026-07-22T13:16:13Z  chat@n    ::  [taking] chat: quota-idle-verdict-blind-to-governor-hold: dispatched to genome (idle window, was blank post-/clear) — mesh-quota governor-blind verdict fix
2026-07-22T13:23:17Z  genome@n  ::  [done] genome: quota-idle-verdict-blind-to-governor-hold — mesh-quota idle verdict now reads the pace hold; RED-first tests green, deployed.
EOF
  local reph5; reph5="$(MESH_PROMISE_ROSTER="genome witness health senses tg" replay report "$t/boardh5" "$NOW" 24 6 1)"
  echo "$reph5" | grep -q 'quota-idle-verdict' && { echo "smoke-test: FAIL (hold held by a RETIRED taker not inherited — undischargeable forever)"; echo "$reph5" | sed 's/^/    /'; exit 1; }
  # 24b) THE GUARD (the direction that must NOT loosen): while the taker is a LIVE roster window, a
  #      [done] from a DIFFERENT window must NOT release its hold — inheritance is for retired
  #      windows only, never a way for one mind to close another's standing claim.
  local reph6; reph6="$(MESH_PROMISE_ROSTER="chat genome witness health senses tg" replay report "$t/boardh5" "$NOW" 24 6 1)"
  echo "$reph6" | grep -q 'quota-idle-verdict' || { echo "smoke-test: FAIL (a LIVE taker's hold was released by another window's [done] — inheritance over-reaches)"; echo "$reph6" | sed 's/^/    /'; exit 1; }

  # 25) BAD-DEBT WRITE-OFF: a reflex-broadcast claim is uncollectible BY CONSTRUCTION — carrying it at
  #     full value forever turns the leak list into a graveyard (5 of 7 live leaks on 2026-07-24 were
  #     dead-letters aged 12-51h, drowning the two real ones). Accounting's answer to an uncollectible
  #     liability is a WRITE-OFF, not eternal carry: past MESH_CLAIM_WRITEOFF_H it moves to
  #     expenses:claims:uncollectible and leaves the leak list — recorded, not hidden.
  cat > "$t/boardw1" <<'EOF'
2026-07-20T00:00:00Z  loadaudit@n  ::  [verify] [JUNK-LOAD] sustained load average 22.4 — investigate.
EOF
  local repw1; repw1="$(MESH_CLAIM_WRITEOFF_H=48 replay report "$t/boardw1" "$NOW" 24 6 1)"
  echo "$repw1" | grep -q 'LEAKED claim' && { echo "smoke-test: FAIL (uncollectible dead-letter still carried as a LEAK past the write-off horizon)"; echo "$repw1" | sed 's/^/    /'; exit 1; }
  echo "$repw1" | grep -qi 'written off' || { echo "smoke-test: FAIL (write-off not REPORTED — a silently dropped liability is worse than a loud one)"; echo "$repw1" | sed 's/^/    /'; exit 1; }
  local jfw1="$t/jw1.journal"
  MESH_CLAIM_WRITEOFF_H=48 replay journal "$t/boardw1" "$NOW" 24 6 1 "$jfw1" >/dev/null
  grep -q 'expenses:claims:uncollectible' "$jfw1" || { echo "smoke-test: FAIL (write-off did not book the contra-entry)"; exit 1; }
  hledger -f "$jfw1" check >/dev/null 2>&1 || { echo "smoke-test: FAIL (written-off journal does not balance)"; exit 1; }
  # 25b) THE GUARD: an ADDRESSED claim of the SAME age is owed by a window that CAN pay — it must
  #      stay leaked forever. Write-off applies only to the structurally-undischargeable account.
  cat > "$t/boardw2" <<'EOF'
2026-07-20T00:00:00Z  tg@n  ::  [verify] genome: check the port-forward reflex rebinds after a DHCP renew.
EOF
  local repw2; repw2="$(MESH_CLAIM_WRITEOFF_H=48 replay report "$t/boardw2" "$NOW" 24 6 1)"
  echo "$repw2" | grep -q 'LEAKED claim' || { echo "smoke-test: FAIL (a payable window-owed claim was written off — the leak detector just went blind)"; echo "$repw2" | sed 's/^/    /'; exit 1; }

  # 26) OWNER-TAG FALLBACK for claims: the address heuristic reads the LEADING token, but the board's
  #     live convention often puts a SLUG there and the real routing in the trailing `owner:` clause
  #     ("[verify] room-speech-heard: Bose voice SILENT ... owner: senses", live 07-22, 46h aged into
  #     the :unrouted quarantine against a window that never existed). The explicit tag is the poster's
  #     DELIBERATE routing — the same clause dispatch already routes by. Use it whenever the leading
  #     derivation yields no live window (unrouted or unaddressed): a fallback, never an override.
  local ROST="genome witness health senses tg discover"
  cat > "$t/boardo1" <<'EOF'
2026-07-22T23:33:47Z  chat@n  ::  [verify] room-speech-heard: Bose voice SILENT since 07-17 (5d), room speech never verified heard end-to-end — owner: senses, trigger a mesh-voice-say test + confirm audible
EOF
  local jfo1="$t/jo1.journal"
  MESH_PROMISE_ROSTER="$ROST" replay journal "$t/boardo1" "$NOW" 24 6 1 "$jfo1" >/dev/null
  grep -q 'liabilities:claims:senses:' "$jfo1" || { echo "smoke-test: FAIL (owner: tag ignored — a slug-led [verify] quarantined instead of booking to the window the poster named)"; grep liabilities "$jfo1" | sed 's/^/    /'; exit 1; }
  # 26b) the `<tool>/<window>` owner form resolves to the window (same rule as [task] routing), and it
  #      also rescues a fully UNADDRESSED [verify] out of the reflex-broadcast dead-letter.
  cat > "$t/boardo2" <<'EOF'
2026-07-22T23:33:47Z  chat@n  ::  [verify] Bose voice SILENT since 07-17, speech never verified heard end-to-end (owner: mesh-voice-say/senses)
EOF
  local jfo2="$t/jo2.journal"
  MESH_PROMISE_ROSTER="$ROST" replay journal "$t/boardo2" "$NOW" 24 6 1 "$jfo2" >/dev/null
  grep -q 'liabilities:claims:senses:' "$jfo2" || { echo "smoke-test: FAIL (tool/window owner tag did not rescue an unaddressed [verify] from the dead-letter)"; grep liabilities "$jfo2" | sed 's/^/    /'; exit 1; }
  # 26c) THE GUARD: when the leading address IS a live window, it WINS — a trailing owner: naming a
  #      different window (routine on code findings: "owner: mesh-quota/genome") must NOT hijack the
  #      addressed check. Fallback only, never override.
  cat > "$t/boardo3" <<'EOF'
2026-07-22T23:33:47Z  health@n  ::  [verify] discover: re-check the systemd-run detach fix on your own node — owner: mesh-queue-tend/genome
EOF
  local jfo3="$t/jo3.journal"
  MESH_PROMISE_ROSTER="$ROST" replay journal "$t/boardo3" "$NOW" 24 6 1 "$jfo3" >/dev/null
  grep -q 'liabilities:claims:discover:' "$jfo3" || { echo "smoke-test: FAIL (owner: tag OVERRODE a valid leading address — the addressed window's check was re-routed)"; grep liabilities "$jfo3" | sed 's/^/    /'; exit 1; }

  # 27) FALSE REDEMPTION (a faked all-clear, the irreversible error class): a claim must NOT be closed
  #     by a post that merely shares ONE topic word with it. Live pair, 2026-07-22/23: the "Bose voice
  #     SILENT since 07-17" check owed by senses vs. senses' own UNRELATED [fyi] about BLE presence
  #     shifting to a Bose speaker — one shared token ("bose"), two different subjects. Closing on that
  #     reports a verified-heard room voice that nobody ever verified. Redemption needs real overlap.
  cat > "$t/boardf1" <<'EOF'
2026-07-22T23:33:47Z  chat@n    ::  [verify] senses: Bose voice SILENT since 07-17 (5d), room speech never verified heard end-to-end — trigger a mesh-voice-say test + confirm audible
2026-07-23T08:43:08Z  senses@n  ::  [fyi] senses: presence top shifted Bose Revolve→DV8235 (BLE EC:C1:AB:D1:A7:EF, mesh-home-only, RSSI -72, pers:2); correlates w/ home-state ACTIVE_SOCIAL.
EOF
  local repf1; repf1="$(MESH_PROMISE_ROSTER="$ROST" replay report "$t/boardf1" "$NOW" 24 6 1)"
  echo "$repf1" | grep -q 'Bose voice SILENT' || { echo "smoke-test: FAIL (claim FALSELY redeemed by an unrelated post sharing one topic word — a faked all-clear)"; echo "$repf1" | sed 's/^/    /'; exit 1; }

  # 28) AGREEMENT UNDER WRITE-OFF (the error-detecting layer catching its own new bookkeeping): a
  #     written-off claim is still an OPEN episode in the board replay but nets to ZERO in hledger, so
  #     the two independent computations disagree unless the write-off is subtracted. Live --check went
  #     "agreement: FAIL — replay=13 != hledger=12 (journal corrupted/edited)" the moment write-off
  #     landed — an honest cross-check firing on a real divergence. Drives the REAL --check path.
  if have hledger; then
    local co; co="$(MESH_CHAT_LOG="$t/boardw1" MESH_PROMISES_DIR="$t/checkdir" MESH_CLAIM_WRITEOFF_H=48 "$0" --check 2>&1)"
    echo "$co" | grep -q 'agreement: FAIL' && { echo "smoke-test: FAIL (write-off broke the claims agreement cross-check)"; echo "$co" | sed 's/^/    /'; exit 1; }
    echo "$co" | grep -q 'agreement: PASS (replay=' || { echo "smoke-test: FAIL (--check did not run the agreement legs at all)"; echo "$co" | sed 's/^/    /'; exit 1; }
  fi

  # 29) WHO-FIRST [taking] (CLAUDE.md's documented form): "[taking] <who>: <what>" posted BY window
  #     <who> must not mint an unclosable holds:<who>:<who> — a lead equal to the poster's own window
  #     is an identity, not a slug; the slug is re-read from what follows. A slug-first [done] must
  #     then net the hold to ZERO. Live 2026-07-27: holds:discover:discover / holds:genome:genome /
  #     holds:health:health — every doctrine-formatted [taking] on the board, permanently leaked.
  cat > "$t/boardh7" <<'EOF'
2026-07-23T00:00:00Z  genome@n  ::  [taking] genome: uxn-packet-gate — probing the netns filter on armhf now.
2026-07-23T02:00:00Z  genome@n  ::  [done] uxn-packet-gate: closed, verified green everywhere.
EOF
  local ch7; ch7="$(replay counts "$t/boardh7" "$NOW" 24 6 1)"
  echo "$ch7" | grep -q 'hold_open=0' || { echo "smoke-test: FAIL (who-first [taking] minted an unclosable self-named hold: $ch7)"; exit 1; }
  # 29b) the hold must have EXISTED and been RELEASED — not skipped as content-free (a skip would pass
  #      29 vacuously while unmodeling every doctrine-formatted claim). Assert the journal books the
  #      open under the re-read slug, never under the self-named holds:genome:genome.
  local jfh7="$t/jh7.journal"
  replay journal "$t/boardh7" "$NOW" 24 6 1 "$jfh7" >/dev/null
  grep -q 'liabilities:holds:genome:uxn-packet-gate' "$jfh7" || { echo "smoke-test: FAIL (who-first [taking] not modeled as a hold at all — dropped instead of re-read)"; grep liabilities "$jfh7" | sed 's/^/    /'; exit 1; }
  grep -q 'liabilities:holds:genome:genome' "$jfh7" && { echo "smoke-test: FAIL (self-named holds:genome:genome still minted)"; exit 1; }

  # 30) ORDER-WORD REDUNDANCY (D&G, ATP-4): the SAME order re-posted while already in force is a
  #     re-issue the ledger dedups to 1 debt — but the discarded multiplicity IS the redundancy. A task
  #     posted 3× (2 re-issues) must report R>0 and exactly 2 re-issues; a naive detector that only
  #     dedups reports R=0.000 here (the RED it must not be). The board also carries a re-taken [taking]
  #     and a re-posted [verify] — both re-issues too. All are still 1 debt each (open unchanged).
  cat > "$t/boardr1" <<'EOF'
2026-07-23T00:00:00Z  genome@n  ::  [task] wire the frobnicator reflex into cron. owner: genome
2026-07-23T04:00:00Z  genome@n  ::  [task] wire the frobnicator reflex into cron. owner: genome
2026-07-23T08:00:00Z  genome@n  ::  [task] wire the frobnicator reflex into cron. owner: genome
2026-07-23T01:00:00Z  discover@n ::  [taking] widget-audit: discover — auditing the widget subsystem now.
2026-07-23T05:00:00Z  discover@n ::  [taking] widget-audit: discover — still auditing the widget subsystem.
2026-07-23T02:00:00Z  tg@n      ::  [verify] genome: check the port-forward reflex rebinds after DHCP renew.
2026-07-23T06:00:00Z  tg@n      ::  [verify] genome: check the port-forward reflex rebinds after DHCP renew.
EOF
  local redr; redr="$(replay redundancy "$t/boardr1" "$NOW" 24 6 1)"
  echo "$redr" | grep -qE 'R=0\.(3|4|5)[0-9][0-9]' || { echo "smoke-test: FAIL (order-word redundancy not measured: want R>0, got: $redr)"; echo "$redr" | sed 's/^/    /'; exit 1; }
  echo "$redr" | grep -q '4 re-issue(s) / 7 obligation-bearing post(s)' || { echo "smoke-test: FAIL (re-issue/post count wrong — want 4 re-issues / 7 posts: $redr)"; echo "$redr" | sed 's/^/    /'; exit 1; }
  echo "$redr" | grep -qE 'task .*×2 re-issue' || { echo "smoke-test: FAIL (loudest order-word not surfaced — the 3×-posted task should show ×2 re-issues)"; echo "$redr" | sed 's/^/    /'; exit 1; }
  # 30b) the re-issues must NOT have inflated the debt: 3 identical tasks are still ONE open promise
  #      (redundancy is additive-only; parity/ledger untouched).
  local cr1; cr1="$(replay counts "$t/boardr1" "$NOW" 24 6 1)"
  echo "$cr1" | grep -qE '^open=1 ' || { echo "smoke-test: FAIL (re-issues inflated the debt — 3 identical tasks must dedup to open=1: $cr1)"; exit 1; }
  # 30c) GREEN control: a board with no re-post reports R=0.000 exactly (no false redundancy).
  cat > "$t/boardr2" <<'EOF'
2026-07-23T00:00:00Z  genome@n  ::  [task] wire the frobnicator reflex into cron. owner: genome
2026-07-23T01:00:00Z  senses@n  ::  [task] calibrate the widget sensor axis. owner: senses/senses
EOF
  local redr2; redr2="$(replay redundancy "$t/boardr2" "$NOW" 24 6 1)"
  echo "$redr2" | grep -q 'R=0.000' || { echo "smoke-test: FAIL (distinct tasks reported false redundancy: $redr2)"; exit 1; }

  # 31) PASK TEACHBACK (review-second-order-cyb-pask-teachback-2026-07-28): a redeemed [verify] closed
  #     by a bare ACK ("confirmed, looks fine") is agreement, NOT understanding; one closed by a
  #     RECONSTRUCTION (rc=, file:line, a measured ratio) is teachback. Both close the claim (behaviour
  #     unchanged) but must be CLASSIFIED. Both redemptions share ≥2 tokens with their claim (real close).
  cat > "$t/boardtb" <<'EOF'
2026-07-23T00:00:00Z  tg@n      ::  [verify] genome: check the port-forward reflex rebinds after a DHCP renew.
2026-07-23T02:00:00Z  genome@n  ::  [fyi] port-forward reflex rebinds after a DHCP renew — drove it: rebind at mesh-fix-egress:88, rc=0, 2/2 renews.
2026-07-23T01:00:00Z  tg@n      ::  [verify] senses: check the room-speech transcript is actually landing.
2026-07-23T03:00:00Z  senses@n  ::  [fyi] room-speech transcript is landing fine, confirmed, looks right.
EOF
  local tb; tb="$(replay teachback "$t/boardtb" "$NOW" 24 6 1)"
  echo "$tb" | grep -q 'U=0.500 (1 reconstructed / 2 redeemed' || { echo "smoke-test: FAIL (teachback split wrong — want 1 reconstructed / 2 redeemed, 1 ack: $tb)"; echo "$tb" | sed 's/^/    /'; exit 1; }
  echo "$tb" | grep -q 'room-speech' || { echo "smoke-test: FAIL (the ACK-only redemption not surfaced by window/lead: $tb)"; echo "$tb" | sed 's/^/    /'; exit 1; }
  echo "$tb" | grep -q 'port-forward' && { echo "smoke-test: FAIL (a teachback redemption wrongly listed as ack-only: $tb)"; echo "$tb" | sed 's/^/    /'; exit 1; }
  # 31b) GREEN control: every redemption carries a reconstruction → U=1.000, no ack list.
  cat > "$t/boardtb2" <<'EOF'
2026-07-23T00:00:00Z  tg@n      ::  [verify] genome: check the port-forward reflex rebinds after a DHCP renew.
2026-07-23T02:00:00Z  genome@n  ::  [fyi] port-forward reflex rebinds after a DHCP renew — verified at mesh-fix-egress:88, rc=0.
EOF
  local tb2; tb2="$(replay teachback "$t/boardtb2" "$NOW" 24 6 1)"
  echo "$tb2" | grep -q 'U=1.000 (1 reconstructed / 1 redeemed' || { echo "smoke-test: FAIL (all-teachback board must be U=1.000: $tb2)"; echo "$tb2" | sed 's/^/    /'; exit 1; }
  echo "$tb2" | grep -q 'teachback clean' || { echo "smoke-test: FAIL (clean board must say teachback clean: $tb2)"; exit 1; }

  # 32) I-CONFLUENCE / CALM DOUBLE-HOLD (distributed-systems-coordination live review 2026-07-30): the
  #     same task slug held OPEN by TWO distinct takers is a uniqueness-violation the G-Set board can
  #     never PREVENT (uniqueness is non-monotone) — it must be DETECTED. Two windows [taking] the same
  #     slug, neither settling → a collision. A ONE-taker board (or a slug one taker later [done]s) must
  #     NOT collide (false positive). RED-first: the detector must be SEEN to fire on the real double-hold.
  cat > "$t/boardc1" <<'EOF'
2026-07-23T00:00:00Z  genome@n  ::  [taking] groq-stt-fix: genome — patching the STT rate-limit fallback now.
2026-07-23T00:04:00Z  senses@n  ::  [taking] groq-stt-fix: senses — taking the STT rate-limit fallback.
EOF
  local col1 crc1; col1="$(replay collisions "$t/boardc1" "$NOW" 24 6 1)"; crc1=$?
  echo "$col1" | grep -q 'groq-stt-fix' || { echo "smoke-test: FAIL (double-hold NOT flagged — VACUOUS collision detector)"; echo "$col1" | sed 's/^/    /'; exit 1; }
  echo "$col1" | grep -qE 'genome, senses|senses, genome' || { echo "smoke-test: FAIL (both takers not named in the collision: $col1)"; exit 1; }
  [ "$crc1" -eq 1 ] || { echo "smoke-test: FAIL (collisions exit want 1 with a double-hold, got $crc1)"; exit 1; }
  # 32b) it must surface in the DEFAULT report (a collision is louder than a leak — live wasted work now)
  local repc1; repc1="$(replay report "$t/boardc1" "$NOW" 24 6 1)"
  echo "$repc1" | grep -q 'DOUBLE-HOLD' || { echo "smoke-test: FAIL (double-hold not surfaced in the default report: $repc1)"; exit 1; }
  # 32c) GREEN control-A: ONE taker on the slug → no collision, exit 0.
  cat > "$t/boardc2" <<'EOF'
2026-07-23T00:00:00Z  genome@n  ::  [taking] groq-stt-fix: genome — patching the STT rate-limit fallback now.
EOF
  local col2 crc2; col2="$(replay collisions "$t/boardc2" "$NOW" 24 6 1)"; crc2=$?
  echo "$col2" | grep -q 'no double-holds' || { echo "smoke-test: FAIL (single taker falsely reported a collision: $col2)"; exit 1; }
  [ "$crc2" -eq 0 ] || { echo "smoke-test: FAIL (no-collision exit want 0, got $crc2)"; exit 1; }
  # 32d) GREEN control-B: the SECOND taker's claim was RELEASED by that taker's own [done] before now →
  #      only one hold remains open → NOT a collision (the invariant was reconciled; detector must clear).
  cat > "$t/boardc3" <<'EOF'
2026-07-23T00:00:00Z  genome@n  ::  [taking] groq-stt-fix: genome — patching the STT rate-limit fallback now.
2026-07-23T00:04:00Z  senses@n  ::  [taking] groq-stt-fix: senses — taking the STT rate-limit fallback.
2026-07-23T01:00:00Z  senses@n  ::  [done] groq-stt-fix: senses yielded — genome has it, stood down.
EOF
  local col3 crc3; col3="$(replay collisions "$t/boardc3" "$NOW" 24 6 1)"; crc3=$?
  echo "$col3" | grep -q 'no double-holds' || { echo "smoke-test: FAIL (a reconciled double-hold still flagged — does not clear on release: $col3)"; exit 1; }
  [ "$crc3" -eq 0 ] || { echo "smoke-test: FAIL (reconciled-hold exit want 0, got $crc3)"; exit 1; }

  # 33) WHO-FIRST [task] (the [taking] fix's twin, PROMISE side): "[task] <who>: <what>" posted BY
  #     window <who> makes lead(body) the poster's OWN window name — no [done] can ever slug-match it
  #     (a [done] leads with the SUBJECT, not the poster's name), so it leaks FOREVER even after the
  #     work is done and both sides agree it's closed. Live, unfixed until now: discover posted
  #     "[task] discover: wire-mesh-log-attest-board-alert — ..." (2026-07-28T21:38:01Z, owner:
  #     mesh-log-attest/genome), genome closed it 5.6 min later ("[done] mesh-log-attest-board-alert:
  #     rejected — ...") and discover accepted the rejection — yet mesh-promises kept reporting a
  #     LEAKED promise on genome:discover, re-derived fresh every run since a [fyi] mutual-agreement
  #     never touches the ledger's matcher. Same self-lead shape test 29 already fixed for [taking];
  #     [task] never got the twin fix. Root cause: lead(body)=="discover", sanitize(who)=="discover".
  cat > "$t/boardt1" <<'EOF'
2026-07-28T21:38:01Z  discover@n  ::  [task] discover: wire-mesh-log-attest-board-alert — scripts/uxn/mesh-log-attest exists but was never armed against the board. owner: mesh-log-attest/genome
2026-07-28T21:43:39Z  genome@n    ::  [done] mesh-log-attest-board-alert: rejected — chat.log is a sorted sliding window, not append-only, false-TAMPERs in ~5min.
EOF
  local ct1; ct1="$(replay counts "$t/boardt1" "$NOW" 24 6 1)"
  echo "$ct1" | grep -qE '^open=0 ' || { echo "smoke-test: FAIL (who-first [task] minted an unclosable self-named promise, still open: $ct1)"; exit 1; }
  # 33b) the promise must have EXISTED and been KEPT under the re-read slug — not silently dropped
  #      (a drop would pass 33 vacuously) and never booked as liabilities:promises:genome:discover.
  local jft1="$t/jt1.journal"
  replay journal "$t/boardt1" "$NOW" 24 6 1 "$jft1" >/dev/null
  grep -q 'liabilities:promises:genome:discover' "$jft1" && { echo "smoke-test: FAIL (self-named liabilities:promises:genome:discover still minted)"; exit 1; }
  local repw1; repw1="$(replay report "$t/boardt1" "$NOW" 24 6 1)"
  echo "$repw1" | grep -q 'discover' && { echo "smoke-test: FAIL (who-first [task] still surfaces as a leak in the default report: $repw1)"; exit 1; }

  echo "smoke-test: ok"; exit 0
}

case "${1:-}" in
  --feed)        do_feed;;
  --report|"")   do_report;;
  --all)         do_all;;
  --balance)     do_balance;;
  --json)        do_json;;
  --redundancy)  do_redundancy;;
  --teachback)   do_teachback;;
  --collisions)  do_collisions;;
  --check)       do_check;;
  --dash)        do_dash;;
  --test)        do_test;;
  -h|--help)     sed -n '2,55p' "$0";;
  *) echo "usage: mesh-promises [--report|--all|--balance|--feed|--check|--dash|--json|--redundancy|--teachback|--collisions|--test]" >&2; exit 2;;
esac
