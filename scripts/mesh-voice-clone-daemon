#!/home/mesh-home/.venv-ai/bin/python
"""mesh-voice-clone-daemon — warm XTTS-v2 daemon that speaks in the OPERATOR'S cloned voice.

The mesh's voice is the operator's own voice. Cold XTTS load is ~12-25s (measured), so
"all speech" is only usable if the model stays WARM: this daemon loads xtts_v2 ONCE, precomputes
the operator's conditioning latents ONCE from the reference wavs, then serves text->wav over a
Unix socket at ~0.7-1.7s per line (measured, GPU). Clients: mesh-voice-say (the primitive every
speech organ delegates to).

Protocol (newline-terminated request, single line):
    <out_wav_path>\t<text>\n
Reply (single line):
    OK\t<out_wav_path>\t<audio_secs>\n     synth ok, 24kHz mono PCM wav at out_wav_path
    ERR\t<message>\n                       synth failed (caller falls back to piper — LOUDLY)
    BUSY\t<depth>/<max>\n                  ADMISSION REFUSED — queue full (caller: mesh-voice-say
                                           rc=8; fall back to piper NOW, do not queue behind it)

ADMISSION CONTROL (task:synth-depth-unbounded, 2026-08-16). The synth is single-writer (`_lock`) and
was UNBOUNDED behind it: every accepted request queued no matter how deep, and a client killed by its
caller's `timeout` kept its place — the GPU finished work nobody was on the socket for, then failed
`sendall` with EPIPE. Measured over 4438 completed synths in this log: 79% overlapped, max depth 18,
and on the SAME 1.4-1.6s fixture the median wall goes 10.6s solo → 17.9 / 26.3 / 32.7 / 35.9 / 41.4 /
36.6 / 50.8s at depth 1..7+ — i.e. each queue level costs one whole synth. 3240 of those completions
are followed by `[Errno 32] Broken pipe`, 100% of them preceded by their own `synth ok` line: not an
error rate, work done for an absent client. 88% of the overlapped fixture starts land in minutes
36-41 = the hourly `mesh-doctor --cron` sweep, whose per-tool `timeout 12` is BELOW the p50 wall of
the very synth it triggers, so the sweep killed its own clients and its retries deepened the queue —
a self-sustaining congestion loop in front of the operator-facing speech path. Two teeth, both here
(a client-side lock would only move the wait): drop work whose client is GONE (checked before and
while queueing, and again before the reply), and refuse at MESH_CLONE_MAXDEPTH instead of queueing
forever. The queue wait stays INSIDE the reported wall (`in <W>s`) on purpose — that is the axis the
depth table is derived from; timing only the inference would erase it.

Env:
    MESH_CLONE_SOCK    unix socket path   (default ~/.mesh/voice-clone/xtts.sock)
    MESH_CLONE_REFS    ':'-joined ref wavs (default: operator-ref + front/usb multi-mic)
    MESH_CLONE_LANG    xtts language      (default ru)
    MESH_CLONE_LOG     log file           (default ~/.mesh/voice-clone/daemon.log)
    MESH_CLONE_MAXDEPTH  in-flight requests admitted before BUSY (default 3)

--test : socket-protocol fixtures (admission + abandoned-client drop, driven through the REAL
         serve()/handle() with a stubbed synth) + offline contract check (imports, refs exist,
         socket path writable). Does NOT load the model (that is the LIVE gate in mesh-voice-say
         --test). exit 0 ok / 1 fail / 2 n/a.
"""
import os, sys, socket, threading, time, traceback

import signal

# SIGTERM MUST UNWIND, or every `finally` below is decorative. Python's DEFAULT SIGTERM disposition
# terminates the interpreter WITHOUT running finally blocks, TemporaryDirectory.__exit__ or atexit,
# so a correct-looking cleanup never executes. The signal is routine here, not hypothetical: GNU
# `timeout` without --foreground puts its child in its OWN PROCESS GROUP and signals the GROUP, so
# every timeout-wrapped call site -- mesh-doctor's hourly --test sweep, mesh-autowire's `timeout 30`
# -- delivers TERM to this process. That is how 950MB of stranded snapshots filled phaedra's /tmp on
# 2026-08-16 with a `finally: rmtree` sitting right there in the source (first fixed in mesh-spend,
# d2fd7c9b). sys.exit() from a handler raises SystemExit in the MAIN THREAD, which is what makes
# try/finally unwind. SIGKILL stays uncatchable -- that half is mesh-tmp-guard's sweep, never this.
for _sig in (signal.SIGTERM, signal.SIGHUP):
    signal.signal(_sig, lambda _s, _f: sys.exit(128 + _s))


HOME = os.path.expanduser("~")
MESH = os.path.join(HOME, ".mesh")
CLONE_DIR = os.path.join(MESH, "voice-clone")
SOCK = os.environ.get("MESH_CLONE_SOCK", os.path.join(CLONE_DIR, "xtts.sock"))
LANG = os.environ.get("MESH_CLONE_LANG", "auto")  # "auto" → per-request Cyrillic/Latin detect
LOGF = os.environ.get("MESH_CLONE_LOG", os.path.join(CLONE_DIR, "daemon.log"))
DEFAULT_REFS = ":".join([
    os.path.join(MESH, "voiceref", "operator-ref.wav"),
    os.path.join(MESH, "voiceref", "front-235334.wav"),
    os.path.join(MESH, "voiceref", "usb-235334.wav"),
])
REFS = [p for p in os.environ.get("MESH_CLONE_REFS", DEFAULT_REFS).split(":") if p]
MAXDEPTH = int(os.environ.get("MESH_CLONE_MAXDEPTH", "3"))


_LOG_SINK = None   # --test redirects here: a dry-run must never write the log a watchdog reads


def log(msg):
    line = f"{time.strftime('%Y-%m-%dT%H:%M:%S')} {msg}"
    if _LOG_SINK is not None:
        _LOG_SINK.append(line)
        return
    try:
        with open(LOGF, "a") as f:
            f.write(line + "\n")
    except Exception:
        pass
    print(line, flush=True)


def _proto_fixtures():
    """ADMISSION + ABANDONED-DROP gates (task:synth-depth-unbounded). 0 ok / 1 fail.

    Drives the REAL serve()/handle() over a real Unix socket with the model swapped for a stub, so
    everything under test is the shipped code path: the admission check, the cancellable lock wait,
    and the liveness peek. HONEST LIMIT: the stub means this asserts nothing about xtts itself —
    inference correctness is mesh-voice-say --test's live gate, not this one.

    Both legs are driven in BOTH directions: with the guard (green) and with the guard disabled
    (must go RED), because a gate that has not been seen fail is not a gate.
    """
    global SOCK, MAXDEPTH, _synth_fn, _LIVENESS, _LOG_SINK, _inflight
    import tempfile
    td = tempfile.mkdtemp(prefix="mvcd-proto-")
    try:
        calls = []

        def _stub(out_path, text):
            time.sleep(0.02)
            with open(out_path, "wb") as f:
                f.write(b"RIFF" + b"\0" * 64)
            calls.append(text)
            return 1.5

        _synth_fn = _stub

        def _spawn(tag):
            global SOCK, _inflight
            SOCK = os.path.join(td, tag + ".sock")
            _inflight = 0
            del calls[:]
            _LOG_SINK[:] = []
            threading.Thread(target=serve, daemon=True).start()
            for _ in range(100):
                if os.path.exists(SOCK):
                    return SOCK
                time.sleep(0.02)
            return SOCK

        def _send(sock_path, text, abandon=False):
            s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            s.settimeout(15)
            s.connect(sock_path)
            s.sendall((os.path.join(td, "o.wav") + "\t" + text + "\n").encode())
            if abandon:                       # exactly what `timeout` does to mesh-voice-say --test
                s.close()
                return None
            buf = b""
            while b"\n" not in buf:
                c = s.recv(65536)
                if not c:
                    break
                buf += c
            s.close()
            return buf.split(b"\n", 1)[0].decode("utf-8", "replace")

        def _abandon_round(liveness):
            # 6 clients queue behind a held lock and then die. With the drop: none of their work runs.
            # MAXDEPTH is lifted out of the way — this leg measures the DROP, and the default 3 would
            # otherwise refuse clients 3-5 and green the count for the other guard's reason.
            global _LIVENESS, MAXDEPTH
            _LIVENESS = liveness
            MAXDEPTH = 99
            sp = _spawn("aband-" + ("on" if liveness else "off"))
            _lock.acquire()
            try:
                for i in range(6):
                    _send(sp, f"dead-{i}", abandon=True)
                time.sleep(0.2)               # > one poll of the cancellable acquire
            finally:
                _lock.release()
            # settle: with the check ON every client is already dropped before the release; with it OFF
            # all 6 must be given time to actually RUN, or the red direction would pass for the wrong
            # reason (a slow fixture reading as a working guard).
            time.sleep(0.2 if liveness else 1.0)
            # count the MARKER, never a substring the fixture text could also spell — the request text
            # is «dead-N» precisely so it cannot forge (or mask) the verdict it is being judged by
            return len(calls), sum(1 for l in _LOG_SINK if "synth abandoned" in l)

        _LOG_SINK = []
        fails = []
        ran, dropped = _abandon_round(True)
        if ran != 0 or dropped != 6:
            fails.append(f"abandoned-drop: {ran} of 6 dead clients' synths still RAN, {dropped}/6 dropped")
        red_ran, red_dropped = _abandon_round(False)
        if red_ran != 6 or red_dropped != 0:
            fails.append(f"abandoned-drop RED direction is vacuous: without the liveness check the same "
                         f"fixture ran {red_ran}/6 (want 6) and dropped {red_dropped} (want 0)")
        _LIVENESS = True

        def _admit_round(maxdepth):
            # Every client runs in its own thread INCLUDING the third: at MAXDEPTH=99 (the red
            # direction) it is admitted and blocks on the lock this function is holding, so sending it
            # inline would deadlock the fixture instead of measuring it.
            global MAXDEPTH
            MAXDEPTH = maxdepth
            sp = _spawn(f"admit-{maxdepth}")
            third, ths = [], []
            _lock.acquire()
            try:
                for i in range(2):
                    t = threading.Thread(target=lambda i=i: _send(sp, f"holder-{i}"))
                    t.daemon = True
                    t.start()
                    ths.append(t)
                time.sleep(0.2)               # let both be admitted and start queueing
                t3 = threading.Thread(target=lambda: third.append(_send(sp, "third")))
                t3.daemon = True
                t3.start()
                ths.append(t3)
                time.sleep(0.25)              # a refusal lands inside this window; an admit does not
            finally:
                _lock.release()
            for t in ths:
                t.join(5)
            return third[0] if third else None

        third = _admit_round(2)
        if not (third or "").startswith("BUSY\t2/2"):
            fails.append(f"admission: 3rd request at MAXDEPTH=2 was not refused (reply: {third!r})")
        red_third = _admit_round(99)
        if not (red_third or "").startswith("OK\t"):
            fails.append(f"admission RED direction is vacuous: at MAXDEPTH=99 the 3rd request should be "
                         f"ADMITTED, got {red_third!r}")
        MAXDEPTH = int(os.environ.get("MESH_CLONE_MAXDEPTH", "3"))
        _synth_fn = synth
        _LOG_SINK = None
        if fails:
            for f in fails:
                print("smoke-test: FAIL (" + f + ")")
            return 1
        print("proto: ok (abandoned work dropped 6/6 and RED without the check; BUSY at depth 2/2 and "
              "admitted at 99)")
        return 0
    finally:
        # STRAIGHT-LINE CLEANUP IS WHAT SIGTERM SKIPS. The rmtree used to sit at the end of
        # the happy path, so a signal mid-proto stranded the whole mvcd-proto- dir.
        import shutil as _sh_proto
        _sh_proto.rmtree(td, ignore_errors=True)


def selftest():
    # offline contract only — never loads the model here (that is the live gate downstream)
    # PROTOCOL FIXTURES FIRST: they are node-independent (stubbed synth, no model, no refs), so they
    # must run ABOVE the refs/TTS n/a gate below or they would be dead code on every node that lacks
    # the xtts venv — the prereq-guard-above-the-test trap.
    if _proto_fixtures() != 0:
        return 1
    # SPLIT CONTRACT — pure, node-independent, so it sits ABOVE the refs/TTS n/a gate too. Every arm
    # here was RED before 2026-08-26, when _split carried its own limit=200 against ru's real 182 and
    # could not cut a single over-long sentence at all. The failure is SILENT (the wav writes,
    # concatenates and plays; only the words stop), which is exactly why it needs a gate.
    _sf = []
    _lim_ru = _CHAR_LIMIT_FALLBACK["ru"]
    _long_sent = "и " * 200                                   # ONE 400-char sentence, no boundary
    for _c in _split(_long_sent, _lim_ru):
        if len(_c) > _lim_ru:
            _sf.append(f"a single over-long sentence reached inference at {len(_c)} chars > {_lim_ru}")
            break
    _many = " ".join("Это предложение номер %d." % i for i in range(40))
    _chunks = _split(_many, _lim_ru)
    _over = [len(c) for c in _chunks if len(c) > _lim_ru]
    if _over:
        _sf.append(f"grouped chunks exceed the cap: {_over}")
    # nothing may be LOST by the split — the words that go in are the words that come out
    if " ".join(" ".join(_chunks).split()) != " ".join(_many.split()):
        _sf.append("the split dropped or reordered words")
    if " ".join(" ".join(_split(_long_sent, _lim_ru)).split()) != " ".join(_long_sent.split()):
        _sf.append("hard-slicing an over-long sentence dropped words")
    # a word longer than the whole budget must still be cut, not passed through
    if any(len(c) > 20 for c in _hard_slice("a" * 100, 20)):
        _sf.append("a single word longer than the cap was passed through uncut")
    # The cap is ASKED OF THE MODEL, never assumed. The fixture's numbers are DELIBERATELY NOT the
    # fallback table's: a fake tokenizer that agrees with the fallback cannot tell "read the
    # tokenizer" from "ignored it and used the default" — both arms return the same value and the
    # arm is vacuous. (Caught by mutation: with the tokenizer read deleted, a 182/250 fixture stayed
    # green.)
    class _FakeTok:  # noqa: E306
        char_limits = {"ru": 111, "en": 222}
    class _FakeModel:  # noqa: E306
        tokenizer = _FakeTok()
    if _lang_limit("ru", _FakeModel()) != 111:
        _sf.append("_lang_limit ignores the tokenizer's own ru cap")
    if _lang_limit("en", _FakeModel()) != 222:
        _sf.append("_lang_limit ignores the tokenizer's own en cap")
    if _lang_limit("ru", object()) > 182:
        _sf.append("the no-tokenizer fallback overshoots ru's cap — the unsafe direction")
    if _sf:
        for _f in _sf:
            print("smoke-test: FAIL (" + _f + ")")
        return 1
    print("split: ok (cap asked of the tokenizer; groups and over-long sentences both bounded; no words lost)")

    # DEVICE CONTRACT — pure, node-independent (a FAKE torch, so the arms are identical on a node
    # with no GPU at all). Every arm below stands for a way the 2026-08-26 finding could come back:
    # the daemon ran cpu for 16 straight starts because a constant said so and nothing ever asked.
    _df = []

    class _FakeCuda:
        def __init__(self, avail=True, free_mb=8000, total_mb=12288, raise_info=None):
            self._a, self._f, self._t, self._r = avail, free_mb, total_mb, raise_info
        def is_available(self):
            return self._a
        def mem_get_info(self):
            if self._r:
                raise RuntimeError(self._r)
            return self._f * 1048576, self._t * 1048576

    class _FakeTorch:
        def __init__(self, **kw):
            self.cuda = _FakeCuda(**kw)

    def _pick(env, **kw):
        _keep = {k: os.environ.get(k) for k in ("MESH_CLONE_DEVICE", "MESH_CLONE_MIN_VRAM_MB")}
        try:
            for k in _keep:
                os.environ.pop(k, None)
            os.environ.update(env)
            return _pick_device(_FakeTorch(**kw))
        finally:
            for k, v in _keep.items():
                os.environ.pop(k, None)
                if v is not None:
                    os.environ[k] = v

    # 1. THE FINDING ITSELF: with nothing pinned and headroom free, auto must reach the GPU.
    if _pick({}, free_mb=8000)[0] != "cuda":
        _df.append("auto with ample free VRAM did not choose cuda — the 16-starts-on-cpu bug")
    # 2. The OLD concern, still honoured: no headroom -> cpu, never a hopeful cuda.
    if _pick({}, free_mb=1200)[0] != "cpu":
        _df.append("auto chose cuda with less free VRAM than the measured peak")
    # 3. An explicit pin wins in BOTH directions (cpu pin over a free GPU; cuda pin over the gate).
    if _pick({"MESH_CLONE_DEVICE": "cpu"}, free_mb=8000)[0] != "cpu":
        _df.append("MESH_CLONE_DEVICE=cpu did not pin cpu")
    if _pick({"MESH_CLONE_DEVICE": "cuda"}, free_mb=1200)[0] != "cuda":
        _df.append("MESH_CLONE_DEVICE=cuda did not bypass the headroom gate")
    # 4. No GPU at all -> cpu, even when cuda is PINNED (a lean node must not die on this line).
    if _pick({"MESH_CLONE_DEVICE": "cuda"}, avail=False)[0] != "cpu":
        _df.append("a pinned cuda on a node with no cuda device did not fall back")
    # 5. A DRIVER THAT WILL NOT ANSWER is not a free GPU. auto must take the safe direction rather
    #    than guess a number — the unreadable case is precisely where a hopeful default cascades.
    if _pick({}, raise_info="nvml unreachable")[0] != "cpu":
        _df.append("auto treated an unreadable free-VRAM read as headroom")
    # 6. The gate is a MEASURED constant, not a vibe: it must move when the operator moves it.
    if _pick({"MESH_CLONE_MIN_VRAM_MB": "9000"}, free_mb=8000)[0] != "cpu":
        _df.append("MESH_CLONE_MIN_VRAM_MB is not honoured")
    # 7. Every choice must SAY WHY. A device line with an empty reason is how this got missed.
    for _env, _kw in (({}, {"free_mb": 8000}), ({}, {"free_mb": 1200}),
                      ({"MESH_CLONE_DEVICE": "cpu"}, {})):
        if not (_pick(_env, **_kw)[1] or "").strip():
            _df.append("a device choice carried no stated reason")
    # 8. OOM RECOGNITION — the demotion is worthless if the exception is not recognised, and a
    #    plain RuntimeError carrying the message is the common shape, not OutOfMemoryError.
    class OutOfMemoryError(Exception):        # torch's real class NAME — the fixture must wear it
        pass
    if not _is_oom(RuntimeError("CUDA out of memory. Tried to allocate 2.00 GiB")):
        _df.append("_is_oom misses a RuntimeError-shaped CUDA OOM")
    if not _is_oom(OutOfMemoryError("boom")):
        _df.append("_is_oom misses torch's OutOfMemoryError class")
    if _is_oom(ValueError("empty text")):
        _df.append("_is_oom swallows an unrelated error — it would hide a real bug as a demotion")
    # 9. PROMOTION (task:mesh-voice-clone-daemon) — the one-way door. Driven through the REAL
    #    synth(), with fake torch/numpy/soundfile in sys.modules so the arms are identical on a
    #    node with no GPU at all: squeeze (1800 MiB free) must stay cpu, headroom freed (6000)
    #    must end on cuda AND say so, and the MESH_CLONE_DEVICE=cpu pin must never move. The RED
    #    direction disables the promoter outright — without it the fixture cannot tell "the leg
    #    exists" from "it was never wired", and a gate that cannot go red is not a gate.
    class _FakeTensor9:  # wears .to() like the model and the latents
        def __init__(self):
            self.dev = "cpu"
        def to(self, dev):
            self.dev = dev
            return self
    class _FakePromModel9(_FakeTensor9):
        def inference(self, ch, lang, gpt, spk):
            return {"wav": [0.0] * 16000}
    class _FakeNP9:
        float32 = "float32"
        @staticmethod
        def asarray(x, dtype=None):
            return list(x)
        @staticmethod
        def concatenate(xs):
            out = []
            for x in xs:
                out.extend(x)
            return out
    class _FakeSF9:
        @staticmethod
        def write(path, audio, rate):
            with open(path, "wb") as f:
                f.write(b"RIFF" + b"\0" * 64)
    class _FakeTorchSeq9:
        def __init__(self, seq):
            _s = list(seq)
            class _C:
                @staticmethod
                def is_available():
                    return True
                @staticmethod
                def mem_get_info():
                    free = _s[0] if len(_s) == 1 else _s.pop(0)
                    return free * 1048576, 12288 * 1048576
            self.cuda = _C()
    def _prom_round9(env, seq):
        import tempfile as _tf9, shutil as _sh9
        g9 = globals()
        keep9 = (g9["_model"], g9["_gpt"], g9["_spk"], g9["_DEVICE"], g9["_LOG_SINK"])
        modkeep9 = {k: sys.modules.get(k) for k in ("torch", "numpy", "soundfile")}
        envkeep9 = {k: os.environ.get(k) for k in ("MESH_CLONE_DEVICE", "MESH_CLONE_MIN_VRAM_MB")}
        try:
            os.environ.pop("MESH_CLONE_DEVICE", None)
            os.environ.pop("MESH_CLONE_MIN_VRAM_MB", None)
            os.environ.update(env)
            sys.modules["torch"] = _FakeTorchSeq9(seq)
            sys.modules["numpy"] = _FakeNP9()
            sys.modules["soundfile"] = _FakeSF9()
            g9["_model"] = _FakePromModel9()
            g9["_gpt"] = _FakeTensor9()
            g9["_spk"] = _FakeTensor9()
            g9["_DEVICE"] = "cpu"
            g9["_LOG_SINK"] = []
            d9 = _tf9.mkdtemp(prefix="mvcd-prom-")
            try:
                synth(os.path.join(d9, "a.wav"), "короткая проверка голоса")
                mid9 = g9["_DEVICE"]
                synth(os.path.join(d9, "b.wav"), "короткая проверка голоса")
                end9 = g9["_DEVICE"]
            finally:
                _sh9.rmtree(d9, ignore_errors=True)
            return mid9, end9, list(g9["_LOG_SINK"])
        finally:
            (g9["_model"], g9["_gpt"], g9["_spk"], g9["_DEVICE"], g9["_LOG_SINK"]) = keep9
            for _k9, _v9 in modkeep9.items():
                if _v9 is None:
                    sys.modules.pop(_k9, None)
                else:
                    sys.modules[_k9] = _v9
            for _k9, _v9 in envkeep9.items():
                os.environ.pop(_k9, None)
                if _v9 is not None:
                    os.environ[_k9] = _v9
    _mid9, _end9, _lines9 = _prom_round9({}, [1800, 6000])
    if _mid9 != "cpu":
        _df.append(f"promotion synthesised on {_mid9} while VRAM was squeezed at 1800 MiB — must stay cpu")
    if _end9 != "cuda":
        _df.append("promotion missing: after the squeeze freed to 6000 MiB the daemon stayed on cpu "
                   "— the one-way door")
    if _end9 == "cuda" and not any("promot" in _l9 for _l9 in _lines9):
        _df.append("the promotion moved silently — the demotion is LOUD and the return must be too")
    _midp9, _endp9, _ = _prom_round9({"MESH_CLONE_DEVICE": "cpu"}, [1800, 6000])
    if _midp9 != "cpu" or _endp9 != "cpu":
        _df.append("MESH_CLONE_DEVICE=cpu was undone by a headroom reading — the pin must be absolute")
    _gsave9 = globals()["_maybe_promote_to_cuda"]
    try:
        globals()["_maybe_promote_to_cuda"] = lambda *a, **k: False
        _, _endred9, _ = _prom_round9({}, [1800, 6000])
    finally:
        globals()["_maybe_promote_to_cuda"] = _gsave9
    if _endred9 != "cpu":
        _df.append("promotion RED direction is vacuous: with the promoter disabled the fixture still "
                   f"ended on {_endred9} — it cannot see a missing leg at all")
    if _df:
        for _f in _df:
            print("smoke-test: FAIL (" + _f + ")")
        return 1
    print("device: ok (auto reaches the GPU on headroom, refuses it without, honours both pins and "
          "an absent/unreadable driver, states a reason every time; OOM recognised by class AND message; "
          "cpu-stuck promotes through the real synth when headroom returns, never when pinned)")
    refs_ok = [p for p in REFS if os.path.isfile(p) and os.path.getsize(p) > 1000]
    if not refs_ok:
        print(f"smoke-test: n/a (no operator reference wavs — {REFS})")
        return 2
    try:
        _install_isin_shim()  # xtts_v2 needs it at TTS-import time, even for a dry contract check
        import TTS  # noqa: F401
        import soundfile  # noqa: F401
    except Exception as e:
        print(f"smoke-test: n/a (TTS/torch/soundfile not importable: {e})")
        return 2
    d = os.path.dirname(SOCK) or "."
    if not os.path.isdir(d):
        try:
            os.makedirs(d, exist_ok=True)
        except Exception as e:
            print(f"smoke-test: FAIL (socket dir not creatable: {e})")
            return 1
    if not os.access(d, os.W_OK):
        print(f"smoke-test: FAIL (socket dir not writable: {d})")
        return 1
    print(f"smoke-test: ok ({len(refs_ok)}/{len(REFS)} refs, TTS importable, sock dir writable)")
    return 0


# ── model (loaded once, at startup) ──────────────────────────────────────────────────────────
_model = None
_gpt = None
_spk = None
_lock = threading.Lock()  # GPU is single-writer; serialize synth
_inflight = 0             # admitted requests not yet finished (queued + running)
_depth_lock = threading.Lock()
_LIVENESS = True          # abandoned-client drop; --test flips it to drive the gate RED


def _install_isin_shim():
    # xtts_v2 predates transformers' isin_mps_friendly; the low-level inference path calls it with
    # KEYWORDS (elements=, test_elements=) while other paths call positionally — accept both, or the
    # first m.inference() dies "unexpected keyword argument 'elements'". (learned 2026-07-18.)
    import torch
    import transformers.pytorch_utils as pu
    if getattr(pu, "_mesh_isin_shim", False):
        return
    def _isin(elements=None, test_elements=None, *a, **k):
        if elements is None and a:
            elements = a[0]
        if test_elements is None and len(a) > 1:
            test_elements = a[1]
        return torch.isin(elements, test_elements)
    pu.isin_mps_friendly = _isin
    pu._mesh_isin_shim = True


# ---------------------------------------------------------------------------------------------
# DEVICE. The daemon ran on CPU for every one of the 16 starts in the journal (2026-08-17..08-26),
# because both the code default and the systemd unit said "cpu". That was a DELIBERATE 2026-07-18
# choice — cuda load had died CUDA-OOM with 11MB free while gigaam + note3 STT daemons and a big
# ollama model held ~10.8/12GB — but the premise expired without the constant noticing: those STT
# daemons are not running, and ollama's residency is keep_alive-BOUNDED, not permanent.
#
# Re-measured 2026-08-26 on ONE 1047-char ru phrase, the operator-facing length, wall-clock on the
# REAL note and never RTF on a short clip (a short clip lied by 28x on this node once already):
#     cpu  : 147.05s wall for 67.25s of audio   (RTF 2.19)
#     cuda :  16.76s wall for 62.75s of audio   (RTF 0.27)   -> 8.8x
# and ollama was NOT evicted — same model id, 100% GPU, before and after. XTTS costs ~2.1GB warm,
# ~2.7GB peak (6609 -> 7179 MiB of 12288 during synth). The 147s is not academic: it is why a
# ~1200-char operator note blew mesh-voice-say's budget and went to background.
#
# So the default is "auto", not "cuda": the OLD concern was real and is only DORMANT. A big model
# can arrive at any time, and mesh-voice-say is the mesh's ONLY synth primitive, so the failure
# direction has to stay away from "the voice organ OOMs and every speech organ falls to piper".
# Hence two teeth, and both are LOUD -- a silent fallback would turn this whole finding back into
# a plausible constant:
#   * a HEADROOM GATE at load: cuda only if the driver's own free-VRAM read clears the measured
#     peak plus margin. It reports the numbers it decided on, either way.
#   * an OOM DEMOTION at load AND mid-synth: if cuda dies out-of-memory anyway, move to cpu, say
#     so at full volume, and keep serving. Slow speech is a degradation; no speech is an outage.
#   * a PROMOTION on every synth request (task:mesh-voice-clone-daemon): if we are on cpu and the
#     headroom gate would NOW clear, move back to cuda and say so just as loudly. Without it the
#     door is one-way — a restart inside a transient squeeze (ollama keep_alive residents, a
#     power-cycle relaunch racing a big model) latches ~8x-slower cpu synth until a human restarts
#     the unit, and the operator's hands being the loop IS the incident.
# MESH_CLONE_DEVICE=cpu|cuda still PINS the choice (cuda skips the gate, never the demotion).
_DEVICE = "cpu"


def _is_oom(e):
    """CUDA OOM arrives under more than one class, so match the MESSAGE too.

    torch.cuda.OutOfMemoryError only exists on newer torch and is not what every layer raises;
    a plain RuntimeError carrying "CUDA out of memory" is the common shape. Erring toward
    "treat it as OOM" is the safe direction: the fallback is a working cpu synth."""
    if e.__class__.__name__ == "OutOfMemoryError":
        return True
    return "out of memory" in str(e).lower()


def _empty_cuda_cache():
    try:
        import torch
        torch.cuda.empty_cache()
    except Exception:
        pass


def _pick_device(torch):
    """Return (device, why). The WHY is logged verbatim -- a device choice with no stated reason
    is exactly how "cpu" survived 16 starts and a month without anyone asking."""
    want = os.environ.get("MESH_CLONE_DEVICE", "auto").strip().lower() or "auto"
    if want == "cpu":
        return "cpu", "pinned by MESH_CLONE_DEVICE=cpu"
    if not torch.cuda.is_available():
        return "cpu", ("MESH_CLONE_DEVICE=cuda but torch reports NO cuda device -- falling back"
                       if want == "cuda" else "no cuda device available to torch")
    need = int(os.environ.get("MESH_CLONE_MIN_VRAM_MB", "3500"))
    try:
        free_b, total_b = torch.cuda.mem_get_info()
        free, total = free_b // 1048576, total_b // 1048576
    except Exception as e:
        # Ask the DRIVER, and if the driver will not answer, do not guess a number: honour an
        # explicit pin, and let auto take the direction that cannot cascade.
        if want == "cuda":
            return "cuda", f"pinned by MESH_CLONE_DEVICE=cuda; free-VRAM unreadable ({e})"
        return "cpu", f"auto: free VRAM unreadable ({e}) -- cpu is the safe direction"
    if want == "cuda":
        return "cuda", f"pinned by MESH_CLONE_DEVICE=cuda (free {free}/{total} MiB, gate {need} MiB bypassed)"
    if free >= need:
        return "cuda", f"auto: free {free}/{total} MiB >= {need} MiB headroom"
    return "cpu", (f"auto: only {free}/{total} MiB free < {need} MiB headroom -- staying on cpu so a "
                   f"warm XTTS cannot OOM-cascade whatever holds the GPU")


def _demote_to_cpu(reason):
    """Move an already-loaded cuda model (and the operator's latents) to cpu, LOUDLY.

    The latents are tensors on the SAME device as the model: moving the model alone leaves
    inference mixing cpu weights with cuda conditioning and it dies on device mismatch -- a
    second, more confusing failure standing where the OOM was."""
    global _model, _gpt, _spk, _DEVICE
    log(f"OOM-FALLBACK: demoting XTTS cuda -> cpu ({reason}). Synth stays UP and gets ~8x slower; "
        f"the daemon re-promotes itself on the next synth once the GPU has headroom again.")
    try:
        _model = _model.to("cpu")
        _gpt = _gpt.to("cpu") if hasattr(_gpt, "to") else _gpt
        _spk = _spk.to("cpu") if hasattr(_spk, "to") else _spk
        import torch
        torch.set_num_threads(int(os.environ.get("MESH_CLONE_THREADS", "12")))
    except Exception as e:
        log(f"OOM-FALLBACK: demotion itself failed: {e}")
        raise
    _DEVICE = "cpu"
    _empty_cuda_cache()


def _maybe_promote_to_cuda(torch_mod=None):
    """PROMOTION leg (task:mesh-voice-clone-daemon) — the return path the demotion never had.

    Called at the top of every synth() (which runs with _lock held, so the move is serialized).
    If we are stuck on cpu and _pick_device() would NOW say cuda, move the model AND the
    operator's latents back to cuda, LOUDLY, in the same voice the demotion uses. A failed
    promotion (the VRAM vanished between the read and the move) stays on cpu and synths there —
    the failure direction is slow speech, never no speech. MESH_CLONE_DEVICE=cpu pins absolutely:
    an operator pin is never undone by a headroom reading."""
    global _model, _gpt, _spk, _DEVICE
    if _DEVICE != "cpu":
        return False
    if _model is None:
        return False
    if os.environ.get("MESH_CLONE_DEVICE", "auto").strip().lower() == "cpu":
        return False
    try:
        _torch = torch_mod if torch_mod is not None else __import__("torch")
        dev, why = _pick_device(_torch)
    except Exception:
        return False
    if dev != "cuda":
        return False
    try:
        _model = _model.to("cuda")
        _gpt = _gpt.to("cuda") if hasattr(_gpt, "to") else _gpt
        _spk = _spk.to("cuda") if hasattr(_spk, "to") else _spk
    except Exception as e:
        log(f"OOM-RECOVERY: promotion cpu -> cuda failed ({e.__class__.__name__}: {e}) — staying on cpu.")
        return False
    _DEVICE = "cuda"
    log(f"OOM-RECOVERY: promoting XTTS cpu -> cuda ({why}). Synth back on GPU speed; no restart needed.")
    return True


def load_model():
    global _model, _gpt, _spk, _DEVICE
    _install_isin_shim()
    import torch
    import torch.serialization as ts
    from TTS.tts.configs.xtts_config import XttsConfig
    from TTS.tts.models.xtts import XttsAudioConfig, XttsArgs
    from TTS.config.shared_configs import BaseDatasetConfig
    ts.add_safe_globals([XttsConfig, XttsAudioConfig, XttsArgs, BaseDatasetConfig])
    from TTS.api import TTS
    dev, why = _pick_device(torch)
    log(f"device: {dev} ({why})")
    if dev == "cpu":
        try:
            torch.set_num_threads(int(os.environ.get("MESH_CLONE_THREADS", "12")))
        except Exception:
            pass
    t0 = time.time()
    tts = TTS("tts_models/multilingual/multi-dataset/xtts_v2")
    try:
        tts = tts.to(dev)
    except Exception as e:                       # a model that loaded ELSEWHERE meanwhile
        if dev == "cuda" and _is_oom(e):
            log(f"OOM-FALLBACK: cuda load failed ({e.__class__.__name__}) — retrying on cpu. "
                f"Something took the VRAM between the headroom read and the load.")
            dev = "cpu"
            try:
                torch.set_num_threads(int(os.environ.get("MESH_CLONE_THREADS", "12")))
            except Exception:
                pass
            _empty_cuda_cache()
            tts = tts.to("cpu")
        else:
            raise
    _DEVICE = dev
    _model = tts.synthesizer.tts_model
    log(f"model loaded on {dev} in {time.time()-t0:.1f}s")
    refs_ok = [p for p in REFS if os.path.isfile(p)]
    if not refs_ok:
        raise RuntimeError(f"no operator reference wavs found: {REFS}")
    t0 = time.time()
    _gpt, _spk = _model.get_conditioning_latents(audio_path=refs_ok)
    log(f"operator conditioning latents computed from {len(refs_ok)} refs in {time.time()-t0:.1f}s")


# The SMALLEST cap among the cyrillic/latin languages this mesh speaks. Used only when the live
# tokenizer cannot be asked; erring SHORT is the safe direction, because overshooting is silent.
_CHAR_LIMIT_FALLBACK = {"ru": 182, "en": 250}


def _lang_limit(lang, model=None):
    """The per-language character cap, asked of THE TOKENIZER THAT ENFORCES IT.

    _split used to carry its own `limit=200`, which is ABOVE ru's real cap of 182. Every group
    landing between 183 and 200 chars therefore reached inference oversized, and xtts logged
    "this might cause truncated audio" and clipped it — silently, because the wav still writes,
    still concatenates and still plays, so the only evidence a listener ever gets is a sentence
    that stops. Measured 2026-08-26 on two real operator/peer notes. A constant that stands in for
    ANOTHER component's constant is wrong the moment they disagree and nothing here would notice;
    ask the component."""
    m = model if model is not None else globals().get("_model")
    try:
        cl = getattr(getattr(m, "tokenizer", None), "char_limits", None)
        if isinstance(cl, dict) and cl.get(lang):
            return int(cl[lang])
    except Exception:
        pass
    return _CHAR_LIMIT_FALLBACK.get(lang, 182)


def _hard_slice(sentence, limit):
    """Cut ONE over-long sentence on word boundaries so no piece exceeds the cap.

    The old grouping loop could only ever start a new group at a SENTENCE boundary, so a single
    sentence longer than the limit was handed to inference whole — the grouping was bounded, the
    output was not. Cuts on spaces; a single word past the cap is cut mid-word (nothing else can
    be done, and it is better than losing the rest of the note)."""
    s = " ".join(str(sentence).split())
    if len(s) <= limit:
        return [s] if s else []
    out, cur = [], ""
    for w in s.split(" "):
        while len(w) > limit:                 # one unbroken word longer than the whole budget
            if cur:
                out.append(cur); cur = ""
            out.append(w[:limit]); w = w[limit:]
        if not cur:
            cur = w
        elif len(cur) + 1 + len(w) <= limit:
            cur += " " + w
        else:
            out.append(cur); cur = w
    if cur:
        out.append(cur)
    return out


def _split(text, limit=None):
    # XTTS low-level inference has no auto-split; break long text on sentence boundaries so each
    # chunk stays under the model's OWN per-language cap (see _lang_limit), then concatenate the
    # wavs. `limit` is passed by synth(); the default keeps direct callers conservative.
    import re
    if limit is None:
        limit = _CHAR_LIMIT_FALLBACK["ru"]
    text = text.strip()
    if len(text) <= limit:
        return [text] if text else []
    parts, cur = [], ""
    for sent in re.split(r"(?<=[.!?…])\s+", text):
        for tok in _hard_slice(sent, limit):
            if cur and len(cur) + len(tok) + 1 <= limit:
                cur = (cur + " " + tok).strip()
            elif not cur:
                cur = tok
            else:
                parts.append(cur)
                cur = tok
    if cur:
        parts.append(cur)
    return parts or [text[:limit]]


def _detect_lang(text):
    # xtts is cross-lingual: the operator's ru-conditioned voice can speak either language, but the
    # LANGUAGE code must match the TEXT or prosody garbles. Cyrillic-majority → ru, else → en. LANG
    # env (default ru) only forces it when set explicitly to something other than "auto".
    if LANG != "auto":
        return LANG
    cyr = sum(1 for c in text if "Ѐ" <= c <= "ӿ")
    lat = sum(1 for c in text if ("a" <= c.lower() <= "z"))
    return "en" if lat > cyr else "ru"


def synth(out_path, text):
    # CALLED WITH _lock HELD (handle() owns the acquire so the wait is cancellable — see _peer_gone).
    _maybe_promote_to_cuda()  # one headroom re-read per request; a no-op unless cpu-stuck with GPU free
    import numpy as np
    import soundfile as sf
    lang = _detect_lang(text)
    # LANGUAGE FIRST: the cap is per-language, so splitting before deciding the language can only
    # ever use a guess. ru is 182 and en is 250 — a 240-char en group is fine and a 240-char ru
    # group is a clipped sentence.
    chunks = _split(text, _lang_limit(lang))
    if not chunks:
        raise ValueError("empty text")
    wavs = []
    for ch in chunks:
        try:
            o = _model.inference(ch, lang, _gpt, _spk)
        except Exception as e:
            # MID-SYNTH OOM. Something else took the VRAM after we loaded. Without this the
            # daemon would keep answering ERR for the rest of its life and every speech organ in
            # the mesh would sit on piper until a human restarted the unit -- an outage produced
            # by a memory spike that has already passed. Demote once, redo THIS chunk on cpu.
            if _DEVICE == "cuda" and _is_oom(e):
                _empty_cuda_cache()
                _demote_to_cpu(f"mid-synth on chunk {len(wavs)+1}/{len(chunks)}")
                o = _model.inference(ch, lang, _gpt, _spk)
            else:
                raise
        wavs.append(np.asarray(o["wav"], dtype="float32"))
    audio = np.concatenate(wavs) if len(wavs) > 1 else wavs[0]
    tmp = out_path + ".tmp.wav"
    sf.write(tmp, audio, 24000)
    os.replace(tmp, out_path)
    return len(audio) / 24000.0


_synth_fn = synth   # indirection: --test drives the REAL handle()/serve() with a stubbed synth


def _peer_gone(conn):
    """True iff the client closed its end — i.e. this request is ABANDONED work.

    The protocol is one line in, one line out: after we have read the request the client is blocked
    reading the reply and sends nothing more, so a readable EOF can only mean it died (its caller's
    `timeout` killed it — mesh-doctor's 12s window around mesh-voice-say --test is the volume case).
    PEEK, never consume; a live-but-silent client raises BlockingIOError.
    """
    if not _LIVENESS:
        return False
    try:
        conn.setblocking(False)
        try:
            return conn.recv(1, socket.MSG_PEEK) == b""
        except BlockingIOError:
            return False
        except OSError:
            return True           # reset/aborted — also gone
    finally:
        try:
            conn.settimeout(120)
        except Exception:
            pass


def handle(conn):
    global _inflight
    admitted = False
    try:
        conn.settimeout(120)
        buf = b""
        while b"\n" not in buf:
            chunk = conn.recv(65536)
            if not chunk:
                break
            buf += chunk
        line = buf.split(b"\n", 1)[0].decode("utf-8", "replace")
        if "\t" not in line:
            conn.sendall(b"ERR\tmalformed request (want <out>\\t<text>)\n")
            return
        out_path, text = line.split("\t", 1)
        out_path = out_path.strip()
        # ADMISSION: refuse rather than queue without bound. The caller (mesh-voice-say rc=8) can
        # fall back to piper in ~0s; queueing would have cost it one whole synth per level ahead.
        with _depth_lock:
            depth = _inflight
            if depth >= MAXDEPTH:
                log(f"BUSY refused at depth {depth}/{MAXDEPTH}  «{text[:40]}»")
                conn.sendall(f"BUSY\t{depth}/{MAXDEPTH}\n".encode())
                return
            _inflight += 1
            admitted = True
        # t0 BEFORE the queue wait, deliberately: the reported wall is what the CALLER experienced,
        # and it is the axis the depth dose-response is measured on.
        t0 = time.time()
        while not _lock.acquire(timeout=0.1):   # poll, not block: a dead client must vacate fast
            if _peer_gone(conn):
                log(f"synth abandoned in queue after {time.time()-t0:.2f}s (client gone)  «{text[:40]}»")
                return
        try:
            if _peer_gone(conn):
                log(f"synth abandoned at head after {time.time()-t0:.2f}s (client gone)  «{text[:40]}»")
                return
            secs = _synth_fn(out_path, text)
        except Exception as e:
            log(f"synth ERR: {e}\n{traceback.format_exc()}")
            conn.sendall(f"ERR\t{e}\n".encode())
            return
        finally:
            _lock.release()
        tail = "" if not _peer_gone(conn) else "  (client gone — reply dropped)"
        log(f"synth ok {secs:.1f}s audio in {time.time()-t0:.2f}s -> {out_path}{tail}  «{text[:60]}»")
        if not tail:
            conn.sendall(f"OK\t{out_path}\t{secs:.2f}\n".encode())
    except Exception as e:
        log(f"handle ERR: {e}")
    finally:
        if admitted:
            with _depth_lock:
                _inflight -= 1
        try:
            conn.close()
        except Exception:
            pass


def serve():
    os.makedirs(os.path.dirname(SOCK), exist_ok=True)
    if os.path.exists(SOCK):
        os.unlink(SOCK)
    srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    srv.bind(SOCK)
    os.chmod(SOCK, 0o660)
    srv.listen(8)
    log(f"listening on {SOCK}")
    # readiness marker: a sibling file the client/health can stat without opening the socket
    try:
        open(SOCK + ".ready", "w").write(str(int(time.time())))
    except Exception:
        pass
    while True:
        conn, _ = srv.accept()
        threading.Thread(target=handle, args=(conn,), daemon=True).start()


def _tmp_fence():
    """tmp fence — task:doctor-test-tmpdir-cleanup-traps.

    Re-exec the selftest ONCE under a private TMPDIR and remove it from the PARENT, so the cleanup
    cannot be lost to a sys.exit() deep in the test. Same shape as the shell fence in the mesh-*
    smoke tests; the honest limit is that a SIGKILL of the parent still strands the dir.
    """
    import shutil, subprocess, tempfile
    if os.environ.get("MESH_TEST_TMPD"):
        return
    d = tempfile.mkdtemp()
    env = dict(os.environ, MESH_TEST_TMPD=d, TMPDIR=d, TMP=d, TEMP=d)
    try:
        rc = subprocess.call([sys.executable, os.path.abspath(__file__)] + sys.argv[1:], env=env)
    finally:
        shutil.rmtree(d, ignore_errors=True)
    sys.exit(rc)


def main():
    if "--test" in sys.argv[1:]:
        _tmp_fence()
        sys.exit(selftest())
    load_model()
    serve()


if __name__ == "__main__":
    main()
