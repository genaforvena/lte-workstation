#!/usr/bin/env bash
# mesh-github-watch — the "watch GitHub" reflex. Alerts the operator when something NEW lands on
# GitHub from someone other than us: a review/comment on an open PR (bot or human), or a new issue /
# issue-comment. $0, read-only (gh api). Deduped by a state file; only NEW events alert. So nothing
# on GitHub is missed, and the repo stays responsive.
#   mesh-github-watch --test   smoke test (gh + repo + state substrate)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
source "$HOME/.local/bin/mesh-split-tabs.sh" "" 2>/dev/null || source "$(dirname "$0")/mesh-split-tabs.sh" "" 2>/dev/null || true
declare -F split_tabs >/dev/null \
  || { echo "mesh-github-watch: mesh-split-tabs.sh not found — refusing to run with a tab reader that drops empty fields" >&2; exit 1; }

# Bind ONE `@tsv` issue row to num/who/when/title. `.author.login` is null for a deleted or ghost
# GraphQL author — the PR leg below already guards exactly that with `(r.get("author") or {})` — and
# jq renders null as an EMPTY MIDDLE column, which `IFS=$'\t' read` collapses: createdAt lands in
# $who (so is_ours is tested against a TIMESTAMP and can never match), the title lands in $when, and
# $title — the alert body — comes out empty. The jq keeps the column correctly POSITIONED and empty;
# the placeholder below is what the human line shows, so a ghost author reads as "ghost" and never as
# a blank. Empty would also false-match is_ours (the pattern degenerates to *" "*), silently dropping
# the alert.
issue_fields(){
  split_tabs "$1" num who when title
  [ -n "$who" ] || who="ghost"
}

if [ "${1:-}" = "--test" ]; then
  # EMPTY-MIDDLE-FIELD leg — drives the REAL binding path with the ghost-author row jq emits.
  num=; who=; when=; title=
  issue_fields "$(printf '7\t\t2026-08-25T10:00:00Z\ta bug')"
  [ "$num" = "7" ] && [ "$who" = "ghost" ] && [ "$when" = "2026-08-25T10:00:00Z" ] && [ "$title" = "a bug" ] \
    || { echo "smoke-test: FAIL (ghost-author row shifted: num='$num' who='$who' when='$when' title='$title')"; exit 1; }
  # control: an ordinary row still binds, and the last var still eats the tab-bearing tail
  issue_fields "$(printf '8\toctocat\t2026-08-25T11:00:00Z\tanother\tbug')"
  [ "$num" = "8" ] && [ "$who" = "octocat" ] && [ "$when" = "2026-08-25T11:00:00Z" ] && [ "$title" = "$(printf 'another\tbug')" ] \
    || { echo "smoke-test: FAIL (ordinary row mis-bound: num='$num' who='$who' when='$when' title='$title')"; exit 1; }
  # and the PRODUCER must actually emit that empty column — if jq stopped rendering the null author
  # as an empty field, the leg above would be asserting against a shape that no longer arrives.
  if command -v jq >/dev/null 2>&1; then
    gr="$(echo '{"number":7,"author":{"login":null},"createdAt":"2026-08-25T10:00:00Z","title":"a bug"}' \
          | jq -r '[.number,(.author.login // ""),.createdAt,.title] | @tsv' 2>/dev/null)"
    [ "$gr" = "$(printf '7\t\t2026-08-25T10:00:00Z\ta bug')" ] \
      || { echo "smoke-test: FAIL (the null author no longer renders as an empty column: $(printf '%q' "$gr"))"; exit 1; }
  else
    echo "smoke-test: NOTE — no jq binary here, so the PRODUCER-shape leg did not run (the binding legs above did; gh carries its own -q engine)"
  fi
  command -v gh >/dev/null 2>&1 || { echo "smoke-test: FAIL (no gh)"; exit 1; }
  command -v python3 >/dev/null 2>&1 || { echo "smoke-test: FAIL (no python3)"; exit 1; }
  [ -d "$HOME/lte-workstation/.git" ] || { echo "smoke-test: FAIL (no repo)"; exit 1; }
  [ -d "$HOME/.mesh" ] && [ -w "$HOME/.mesh" ] || { echo "smoke-test: FAIL (no writable ~/.mesh)"; exit 1; }
  # offline check — gh auth status makes a network call that fails under load/transient (2026-06-14 cry-wolf)
  [ -f "$HOME/.config/gh/hosts.yml" ] && grep -q 'oauth_token:' "$HOME/.config/gh/hosts.yml" || { echo "smoke-test: FAIL (gh unauthenticated — no token in ~/.config/gh/hosts.yml)"; exit 1; }
  echo "smoke-test: ok"
  exit 0
fi
cd "$HOME/lte-workstation" 2>/dev/null || exit 0
STATE="$HOME/.mesh/.github-seen"; touch "$STATE"
OURS=" ghIsPureTrash genaforvena "   # our accounts (gh-CLI + operator) — never alert on our own activity
is_ours(){ case "$OURS" in *" $1 "*) return 0;; *) return 1;; esac; }

emit(){ # kind|ref|who|when|body  -> alert once
  local line="$1" id; id="$(printf '%s' "$line" | cut -d'|' -f1-4)"
  grep -qF "$id" "$STATE" 2>/dev/null && return
  echo "$id" >> "$STATE"
  local kind ref who body; IFS='|' read -r kind ref who _ body <<<"$line"
  command -v mesh-tg >/dev/null 2>&1 && mesh-tg "🐙 GitHub: new [$kind] on $ref by $who:
${body}
view: gh $( [ "${ref:0:2}" = "PR" ] && echo "pr view ${ref#PR#} --comments" || echo "issue view ${ref#issue#} --comments")"
}

# --- reviews + comments on OPEN PRs ---
for pr in $(gh pr list --state open --json number -q '.[].number' 2>/dev/null); do
  gh pr view "$pr" --json reviews,comments 2>/dev/null | OURS="$OURS" PR="$pr" python3 -c '
import json,sys,os
d=json.load(sys.stdin); ours=set(os.environ["OURS"].split()); pr=os.environ["PR"]
def clean(s): return " ".join((s or "").split())[:120]
# NO backslash-escaped quotes inside f-strings here: that is a SyntaxError before python 3.12,
# and the 2>/dev/null on this pipeline silenced it — the PR leg was dead while exiting 0.
for r in d.get("reviews",[]):
  a=(r.get("author") or {}).get("login","")
  if a and a not in ours: print("review|PR#{}|{}|{}|{}".format(pr,a,r.get("submittedAt",""),clean(r.get("body"))))
for c in d.get("comments",[]):
  a=(c.get("author") or {}).get("login","")
  if a and a not in ours: print("comment|PR#{}|{}|{}|{}".format(pr,a,c.get("createdAt",""),clean(c.get("body"))))
' 2>/dev/null
done | while IFS= read -r l; do emit "$l"; done

# --- new issues from others ---
gh issue list --state open --json number,title,author,createdAt -q '.[] | [.number,(.author.login // ""),.createdAt,.title] | @tsv' 2>/dev/null \
| while IFS= read -r l; do
    issue_fields "$l"                                # NEVER `IFS=$'\t' read` — see issue_fields
    is_ours "$who" && continue
    emit "issue|issue#$num|$who|$when|$title"
  done
