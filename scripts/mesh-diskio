#!/usr/bin/env bash
# mesh-diskio — node-side DISK I/O PRESSURE sense.
#
# Reads /proc/diskstats to measure read/write throughput and IOPS,
# classifying the disk state as IDLE, ACTIVE, or PRESSURED.
#
# The mesh monitors CPU (load/thermal/PSI), memory (mem_used_pct/PSI),
# thermal (all zones), and network (WiFi/traffic) — but has NO disk I/O
# monitoring. This fills that gap with a real hardware signal from the kernel.
#
# Signal: /proc/diskstats fields 7-14 (sectors read/written, time doing I/O).
# We sample twice, 1s apart, and compute delta throughput + IOPS.
#
# Classification:
#   IDLE      — <10 KB/s throughput AND <5 IOPS → disk barely touched
#   ACTIVE    — moderate I/O → normal workload
#   PRESSURED — >100 KB/s sustained OR >50 IOPS → disk under load
#
# Usage:
#   mesh-diskio              one-line I/O state
#   mesh-diskio --json       machine-readable {state, read_kb_s, write_kb_s, iops, depth}
#   mesh-diskio --test       smoke test (offline, no disk access needed)
#
# Exit codes (honest-exit contract):
#   0 = assessment produced
#   2 = /proc/diskstats unreadable — cannot assess, never faked
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

DISKSTATS="/proc/diskstats"
STATE_FILE="$HOME/.mesh/.diskio-state"

# --- Read /proc/diskstats for the root disk (nvme0n1 or sda) ---
# Returns: total_reads_sectors total_writes_sectors total_reads_io total_writes_io
read_diskstats() {
  local dev="$1"
  awk -v d="$dev" '$3 == d {
    # field  6 = reads completed,  10 = writes completed
    # field  5 = reads merged (skip),  9 = writes merged (skip)
    # field  7 = sectors read,  11 = sectors written
    # field  12 = time doing I/O (ms)
    printf "%d %d %d %d %d\n", $7, $11, $6, $10, $12
  }' "$DISKSTATS" 2>/dev/null
}

# Find the root disk name from mounted root
find_root_disk() {
  local dev
  dev="$(df / 2>/dev/null | tail -1 | awk '{print $1}')"
  dev="$(basename "$dev")"
  # NVMe: nvme0n1p5 → nvme0n1 (strip pN partition suffix)
  if [[ "$dev" =~ ^nvme[0-9]+n[0-9]+p[0-9]+$ ]]; then
    dev="${dev%p[0-9]*}"
  # SATA: sda2 → sda (strip trailing partition number)
  elif [[ "$dev" =~ ^sd[a-z]+[0-9]+$ ]]; then
    dev="${dev%[0-9]}"
  fi
  echo "$dev"
}

# --- Pure classifier (exercised by --test) ---
# classify <read_kb_s> <write_kb_s> <iops> → echoes STATE|reason
classify() {
  local rkb="$1" wkb="$2" iops="$3"
  local total_kb=$(( rkb + wkb ))

  if [ "$total_kb" -lt 10 ] && [ "$iops" -lt 5 ]; then
    printf 'IDLE|read=%s KB/s write=%s KB/s iops=%s — disk barely touched' "$rkb" "$wkb" "$iops"
  elif [ "$total_kb" -gt 100 ] || [ "$iops" -gt 50 ]; then
    printf 'PRESSURED|read=%s KB/s write=%s KB/s iops=%s — disk under load' "$rkb" "$wkb" "$iops"
  else
    printf 'ACTIVE|read=%s KB/s write=%s KB/s iops=%s — moderate I/O' "$rkb" "$wkb" "$iops"
  fi
}

# --- Smoke test ---
if [ "${1:-}" = --test ]; then
  command -v python3 >/dev/null 2>&1 || { echo "smoke-test: FAIL (no python3)"; exit 1; }
  command -v awk >/dev/null 2>&1 || { echo "smoke-test: FAIL (no awk)"; exit 1; }

  fail=0
  # IDLE: low throughput, low IOPS
  r="$(classify 0 0 0)"; s="${r%%|*}"
  [ "$s" = "IDLE" ] || { echo "  FAIL: 0/0 KB/s 0 iops → $s (expected IDLE)"; fail=1; }

  # ACTIVE: moderate throughput
  r="$(classify 50 30 10)"; s="${r%%|*}"
  [ "$s" = "ACTIVE" ] || { echo "  FAIL: 50/30 KB/s 10 iops → $s (expected ACTIVE)"; fail=1; }

  # PRESSURED: high throughput
  r="$(classify 200 50 30)"; s="${r%%|*}"
  [ "$s" = "PRESSURED" ] || { echo "  FAIL: 200/50 KB/s 30 iops → $s (expected PRESSURED)"; fail=1; }

  # PRESSURED: high IOPS even at low throughput
  r="$(classify 5 5 60)"; s="${r%%|*}"
  [ "$s" = "PRESSURED" ] || { echo "  FAIL: 5/5 KB/s 60 iops → $s (expected PRESSURED)"; fail=1; }

  # IDLE: just below thresholds
  r="$(classify 9 0 4)"; s="${r%%|*}"
  [ "$s" = "IDLE" ] || { echo "  FAIL: 9/0 KB/s 4 iops → $s (expected IDLE)"; fail=1; }

  # ACTIVE: just above IDLE
  r="$(classify 10 0 5)"; s="${r%%|*}"
  [ "$s" = "ACTIVE" ] || { echo "  FAIL: 10/0 KB/s 5 iops → $s (expected ACTIVE)"; fail=1; }

  # /proc/diskstats must be readable
  [ -r "$DISKSTATS" ] || { echo "smoke-test: FAIL ($DISKSTATS not readable)"; exit 1; }

  # Root disk must be found and have stats
  _disk="$(find_root_disk)"
  [ -n "$_disk" ] || { echo "smoke-test: FAIL (can't find root disk)"; exit 1; }
  _ds="$(read_diskstats "$_disk")"
  [ -n "$_ds" ] || { echo "smoke-test: FAIL (no stats for $_disk)"; exit 1; }

  [ "$fail" = 0 ] || { echo "smoke-test: FAIL ($fail assertion(s))"; exit 1; }
  echo "smoke-test: ok (classify: 6 assertions + /proc/diskstats readable + root disk=$_disk)"
  exit 0
fi

# --- Find root disk ---
ROOT_DISK="$(find_root_disk)"
[ -n "$ROOT_DISK" ] || { echo "mesh-diskio: can't determine root disk" >&2; exit 2; }

# --- Sample 1: snapshot now ---
now_read="$(read_diskstats "$ROOT_DISK")"
[ -n "$now_read" ] || { echo "mesh-diskio: /proc/diskstats unreadable for $ROOT_DISK" >&2; exit 2; }
now_epoch="$(date +%s)"
read -r nr_sectors nw_sectors nr_ios nw_ios _ <<< "$now_read"

# --- Sample 2: wait 1s, snapshot again ---
sleep 1
later_read="$(read_diskstats "$ROOT_DISK")"
[ -n "$later_read" ] || { echo "mesh-diskio: /proc/diskstats unreadable on second sample" >&2; exit 2; }
later_epoch="$(date +%s)"
read -r lr_sectors lw_sectors lr_ios lw_ios _ <<< "$later_read"

# --- Compute deltas ---
dt=$(( later_epoch - now_epoch ))
[ "$dt" -gt 0 ] || dt=1

# Sectors are 512 bytes each
read_kb=$(( (lr_sectors - nr_sectors) * 512 / 1024 / dt ))
write_kb=$(( (lw_sectors - nw_sectors) * 512 / 1024 / dt ))
iops=$(( (lr_ios - nr_ios + lw_ios - nw_ios) / dt ))

# Clamp negatives (counter wrap or race)
[ "$read_kb" -lt 0 ] && read_kb=0
[ "$write_kb" -lt 0 ] && write_kb=0
[ "$iops" -lt 0 ] && iops=0

# --- Classify ---
fused="$(classify "$read_kb" "$write_kb" "$iops")"
state="${fused%%|*}"
reason="${fused#*|}"

# --- Output ---
ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

if [ "${1:-}" = --json ]; then
  printf '{"state":"%s","read_kb_s":%d,"write_kb_s":%d,"iops":%d,"disk":"%s","ts":"%s"}\n' \
    "$state" "$read_kb" "$write_kb" "$iops" "$ROOT_DISK" "$ts"
else
  printf '[diskio] %s — %s | disk=%s\n' "$state" "$reason" "$ROOT_DISK"
fi
