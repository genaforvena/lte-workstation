#!/usr/bin/env bash
# mesh-watch — the mesh's reflex for watching a tmux window until something happens.
# tmux is the only way to see into a node (CLAUDE.md): never infer agent state from ps /
# ad-hoc ssh — watch the pane. This is the waiting counterpart to mesh-tell --peek.
#
#   mesh-watch <window> --until <pattern>              block until pattern appears in pane
#   mesh-watch <window> --change                       block until the pane's last line changes
#   mesh-watch --node user@ip <window> --until <pat>   same, remote node
#
# Options: --interval N (poll seconds, default 20) · --timeout N (give up, default 3600)
# Exits 0 with the matching/changed tail on stdout; 2 on timeout; 3 if pane unreachable.
set -uo pipefail
node=local
[ "${1:-}" = "--node" ] && { node="$2"; shift 2; }
win="${1:?usage: mesh-watch [--node user@ip] <window> (--until <pattern> | --change) [--interval N] [--timeout N]}"; shift
mode=""; pattern=""; interval=20; timeout=3600
while [ $# -gt 0 ]; do
  case "$1" in
    --until)    mode=until; pattern="$2"; shift 2;;
    --change)   mode=change; shift;;
    --interval) interval="$2"; shift 2;;
    --timeout)  timeout="$2"; shift 2;;
    *) echo "mesh-watch: unknown arg $1" >&2; exit 1;;
  esac
done
[ -n "$mode" ] || { echo "mesh-watch: need --until <pattern> or --change" >&2; exit 1; }

peek(){ # last non-blank lines of the pane, via tmux only
  if [ "$node" = local ]; then
    tmux capture-pane -t "$(hostname):$win" -p 2>/dev/null | grep -vE '^[[:space:]]*$' | tail -15
  else
    ssh -o BatchMode=yes -o ConnectTimeout=10 "$node" \
      "tmux capture-pane -t \$(hostname):$win -p 2>/dev/null | grep -vE '^[[:space:]]*\$' | tail -15"
  fi
}

start=$(date +%s)
baseline=$(peek | tail -1)
[ -n "$baseline" ] || { echo "mesh-watch: pane $win @ $node unreachable/empty" >&2; exit 3; }
miss=0
while :; do
  snap=$(peek)
  last=$(printf '%s\n' "$snap" | tail -1)
  if [ -z "$last" ]; then
    miss=$((miss+1)); [ "$miss" -ge 3 ] && { echo "mesh-watch: pane $win @ $node lost" >&2; exit 3; }
  else
    miss=0
    case "$mode" in
      until)  printf '%s\n' "$snap" | grep -q -- "$pattern" && { printf '%s\n' "$snap"; exit 0; };;
      change) [ "$last" != "$baseline" ] && { printf '%s\n' "$snap"; exit 0; };;
    esac
  fi
  [ $(( $(date +%s) - start )) -ge "$timeout" ] && { echo "mesh-watch: timeout after ${timeout}s" >&2; exit 2; }
  sleep "$interval"
done
