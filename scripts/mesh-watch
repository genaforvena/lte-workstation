#!/usr/bin/env bash
# mesh-watch — the mesh's reflex for watching a tmux window until something happens.
# tmux is the only way to see into a node (CLAUDE.md): never infer agent state from ps /
# ad-hoc ssh — watch the pane. This is the waiting counterpart to mesh-tell --peek.
#
#   mesh-watch <window> --until <pattern>              block until pattern appears in pane
#   mesh-watch <window> --change                       block until the pane's last line changes
#   mesh-watch --node user@ip <window> --until <pat>   same, remote node
#
# Options: --interval N (poll seconds, default 20) · --timeout N (give up, default 3600)
# Exits 0 with the matching/changed tail on stdout; 2 on timeout; 3 if pane unreachable.
set -uo pipefail
[ "${1:-}" = --test ] && {
  command -v tmux >/dev/null 2>&1 || { echo "smoke-test: FAIL (no tmux)"; exit 1; }
  # ISOLATION (live incident 2026-07-14 on mesh-home): this block used to build its fixture in a
  # session named $(hostname) — the node's REAL session name — and, whenever the has-session probe
  # found none, `kill-session -t "$_host"` at the end. Two ways that destroys the sensorium: (a) the
  # probe races mesh-restore/mesh-liveness-loop, which recreate the node session between the probe and
  # the kill, so the test kills the freshly-restored REAL session; (b) with no other session on the
  # server, killing the last one exits tmux and every mind pane dies with it. tmux is append-only
  # (CLAUDE.md) — a smoke test must not be able to reach the node's server at all. Per-invocation
  # TMUX_TMPDIR gives the fixture its own server; the name is a fixture name, never the hostname.
  #
  # `unset TMUX` is LOAD-BEARING, not tidiness: when a test runs from INSIDE a pane ($TMUX set —
  # mesh-doctor's smoke-sweep, a mind running --test in its channel), tmux takes the socket path
  # FROM $TMUX and ignores TMUX_TMPDIR completely. Without the unset, every fixture below lands on
  # the node's DEFAULT server and the kill-server teardown nukes the node's session and every mind
  # pane with it (live incident 2026-07-14 23:00Z: an env-var-guarded kill-server killed a
  # 14-window session — the "isolation" fix was itself the killer).
  # Hard-fail rather than fall back to the shared server.
  _tw_td="$(mktemp -d 2>/dev/null)" || _tw_td=""
  [ -n "$_tw_td" ] || { echo "smoke-test: FAIL (mktemp -d failed — refusing to run tmux fixtures on the node's shared server)"; exit 1; }
  export TMUX_TMPDIR="$_tw_td"
  unset TMUX
  _tw_sock="$_tw_td/tmux-$(id -u)/default"
  # Teardown on ANY exit, incl. a FAIL-exit/SIGTERM mid-block (else the fixture server leaks and its
  # inherited fds can wedge a caller — the 2026-07-10 doctor freeze). Guarded on OUR PRIVATE SOCKET
  # FILE existing — never on $TMUX_TMPDIR: the env var is set even when tmux is talking to the
  # default socket, which is exactly how the guard passed while kill-server destroyed the sensorium.
  # The socket path is a real observable; the env var is a claim.
  trap '[ -S "${_tw_sock:-}" ] && tmux kill-server 2>/dev/null; rm -rf "$_tw_td"' EXIT TERM INT
  # Dry-run: create a temp window with known text, exercise peek() via capture-pane
  _sess="tw-test-$$"
  _win="tw-win-$$"
  tmux new-session -d -s "$_sess" -n "$_win" -x 80 -y 10 'echo unique-marker-1; sleep 30' 2>/dev/null
  sleep 0.3
  # ISOLATION assert (load-bearing, two real observables).
  # (a) our PRIVATE server actually exists — this is what the kill-server teardown is guarded on, so
  #     if the socket isn't here the teardown must be a no-op and the fixture went somewhere else.
  [ -S "$_tw_sock" ] || {
    echo "smoke-test: FAIL (no private tmux socket at $_tw_sock — fixtures are NOT isolated)"; exit 1; }
  # (b) the fixture is INVISIBLE on the node's default server — proof this test cannot reach the node
  #     session or its server. Falsify: drop the `unset TMUX` above and run this from inside a pane —
  #     the fixture appears on the default socket → FAIL (that is the 2026-07-14 killer, caught).
  env -u TMUX_TMPDIR tmux has-session -t "$_sess" 2>/dev/null && {
    echo "smoke-test: FAIL (fixture session '$_sess' is visible on the node's DEFAULT tmux server — not isolated)"; exit 1; }
  # NEVER-THE-NODE assert: nothing in this block may name the node's own session. Falsify: reintroduce
  # the $(hostname) fixture and this trips. (Pattern built by concatenation so the assert never
  # self-matches its own source line.)
  # Two subtleties, both load-bearing, both were broken until 2026-07-14:
  #  - `--`: the pattern starts with '-', so without it grep parses it as a flag and exits 2 with a
  #    usage error — the assert was silently dead (never able to trip) for its whole life.
  #  - the pattern MUST be assembled at runtime: written as a literal, this line would contain the
  #    very text it greps for, so the assert would match its OWN source and fail on a clean file.
  _hn_frag='_host'
  _hn_pat="-s \"\$$_hn_frag\""
  grep -qF -- "$_hn_pat" "$0" && {
    echo "smoke-test: FAIL (test creates a session named \$(hostname) — the node's REAL session; a kill here destroys the sensorium)"; exit 1; }
  _pidx=$(tmux list-panes -t "$_sess:$_win" -F '#{pane_top} #{pane_index}' 2>/dev/null | sort -n | tail -1 | awk '{print $2}')
  _content=$(tmux capture-pane -t "$_sess:$_win${_pidx:+.$_pidx}" -p 2>/dev/null)
  printf '%s' "$_content" | grep -qF 'unique-marker' || { echo "smoke-test: FAIL (peek() cannot read pane content)"; exit 1; }
  echo "smoke-test: ok (peek captures pane, pane-resolution picks bottom pane, fixtures isolated from the node's tmux server)"
  exit 0
}
node=local
[ "${1:-}" = "--node" ] && { node="$2"; shift 2; }
win="${1:?usage: mesh-watch [--node user@ip] <window> (--until <pattern> | --change) [--interval N] [--timeout N]}"; shift
mode=""; pattern=""; interval=20; timeout=3600
while [ $# -gt 0 ]; do
  case "$1" in
    --until)    mode=until; pattern="$2"; shift 2;;
    --change)   mode=change; shift;;
    --interval) interval="$2"; shift 2;;
    --timeout)  timeout="$2"; shift 2;;
    *) echo "mesh-watch: unknown arg $1" >&2; exit 1;;
  esac
done
[ -n "$mode" ] || { echo "mesh-watch: need --until <pattern> or --change" >&2; exit 1; }

peek(){ # last non-blank lines of the pane, via tmux only
  if [ "$node" = local ]; then
    local pidx
    pidx=$(tmux list-panes -t "$(hostname):$win" -F '#{pane_top} #{pane_index}' 2>/dev/null | sort -n | tail -1 | awk '{print $2}')
    tmux capture-pane -t "$(hostname):$win${pidx:+.$pidx}" -p 2>/dev/null | grep -vE '^[[:space:]]*$' | tail -15
  else
    ssh -o BatchMode=yes -o ConnectTimeout=10 "$node" \
      "pidx=\$(tmux list-panes -t \$(hostname):$win -F '#{pane_top} #{pane_index}' 2>/dev/null | sort -n | tail -1 | awk '{print \$2}'); tmux capture-pane -t \$(hostname):$win\${pidx:+.\$pidx} -p 2>/dev/null | grep -vE '^[[:space:]]*\$' | tail -15"
  fi
}

start=$(date +%s)
baseline=$(peek | tail -1)
[ -n "$baseline" ] || { echo "mesh-watch: pane $win @ $node unreachable/empty" >&2; exit 3; }
miss=0
while :; do
  snap=$(peek)
  last=$(printf '%s\n' "$snap" | tail -1)
  if [ -z "$last" ]; then
    miss=$((miss+1)); [ "$miss" -ge 3 ] && { echo "mesh-watch: pane $win @ $node lost" >&2; exit 3; }
  else
    miss=0
    case "$mode" in
      until)  printf '%s\n' "$snap" | grep -q -- "$pattern" && { printf '%s\n' "$snap"; exit 0; };;
      change) [ "$last" != "$baseline" ] && { printf '%s\n' "$snap"; exit 0; };;
    esac
  fi
  [ $(( $(date +%s) - start )) -ge "$timeout" ] && { echo "mesh-watch: timeout after ${timeout}s" >&2; exit 2; }
  sleep "$interval"
done
