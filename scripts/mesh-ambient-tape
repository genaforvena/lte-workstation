#!/usr/bin/env bash
# mesh-ambient-tape — a timestamped dB TIME-SERIES of the always-on ambient mic.
#
# WHY: mesh-ambient-level emits the CURRENT loudness (one overwritten value) — great for "is it loud
# NOW", useless for anything needing HISTORY. Appliance/event detection (a compressor's periodic duty
# cycle, a washer's sustained dB step, a door-beep transient) all need dB OVER TIME, which nothing
# logs today. This tool is STEP-0 of the home-acoustic-sensing design
# (~/.mesh/knowledge/home-acoustic-sensing-fridge-and-beyond-2026-06-25.md): every run it samples the
# mic ONCE and appends a single tab row — ts + rms_db + peak_db + label. The accruing tape is the
# substrate a periodicity/event detector (mesh-rhythm / a future mesh-appliance-acoustic) reads.
# Periodicity needs HOURS of history, so this must start collecting BEFORE any detector is built.
#
# HONEST-DEGRADE (never fabricate a level): when the mic read fails or the node has no mic, the row
# is written with NA dB + an UNREACHABLE/UNKNOWN label — a visible GAP, never a faked silent room.
# A consumer skips NA rows; the gap itself is honest data (mic was down then).
#
#   mesh-ambient-tape          sample now, append one row (create with header if new)
#   mesh-ambient-tape --dry    print the row that WOULD be written; do not touch the tape
#   mesh-ambient-tape --head   print schema/header + last few rows + simple stats
#   mesh-ambient-tape --test   self-test (temp tape): parse, honest-degrade, dry-no-write, header-once
#
# reflex-cadence: */2 * * * *
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"   # cron's minimal PATH lacks ~/.local/bin (sibling mesh-* calls)

TAPE="${MESH_AMBIENT_TAPE:-$HOME/.mesh/ambient-db-tape.tsv}"
MAX_ROWS="${MESH_AMBIENT_TAPE_MAX:-20000}"   # ~28 days at */2; trim oldest beyond this (bounded file)
SCHEMA_VERSION="v1"
HEADER=$'ts\trms_db\tpeak_db\tlabel'

now_iso() { date -u +%Y-%m-%dT%H:%M:%SZ; }

# Sample the mic once -> "rms_db<TAB>peak_db<TAB>label". On any failure emit "NA<TAB>NA<TAB>UNREACHABLE"
# (or UNKNOWN if it ran but gave no parseable numbers) — honest gap, never a fabricated level.
sample_db() {
  local j rc
  j="$(timeout "${MESH_AMBIENT_TAPE_TIMEOUT:-15}" mesh-ambient-level --json 2>/dev/null)"; rc=$?
  if [ "$rc" -ne 0 ] || [ -z "$j" ]; then
    printf 'NA\tNA\tUNREACHABLE'; return
  fi
  # Parse JSON with python3 (always present); honest-fail to UNKNOWN if fields are missing/non-numeric.
  printf '%s' "$j" | python3 -c '
import sys, json
try:
    d = json.load(sys.stdin)
    r = d.get("rms_db"); p = d.get("peak_db"); lab = d.get("label") or "UNKNOWN"
    if not isinstance(r,(int,float)) or not isinstance(p,(int,float)):
        print("NA\tNA\tUNKNOWN"); sys.exit(0)
    print(f"{r:.1f}\t{p:.1f}\t{lab}")
except Exception:
    print("NA\tNA\tUNKNOWN")
' 2>/dev/null || printf 'NA\tNA\tUNKNOWN'
}

build_row() { printf '%s\t%s\n' "$(now_iso)" "$(sample_db)"; }

append_row() {
  local row="$1"
  mkdir -p "$(dirname "$TAPE")"
  if [ ! -f "$TAPE" ]; then
    {
      printf '# mesh-ambient-tape %s — dB time-series of the always-on ambient mic (STEP-0, home-acoustic-sensing).\n' "$SCHEMA_VERSION"
      printf '# cols: ts(UTC ISO)  rms_db(avg, dBFS)  peak_db(dBFS)  label(category). NA/UNREACHABLE = honest gap.\n'
      printf '%s\n' "$HEADER"
    } > "$TAPE"
  fi
  printf '%s\n' "$row" >> "$TAPE"
  # Bound the file: keep header (comment + schema lines) + last MAX_ROWS data rows.
  local datarows
  datarows="$(grep -vc '^#' "$TAPE" 2>/dev/null || echo 0)"
  if [ "$datarows" -gt "$((MAX_ROWS + 1))" ]; then   # +1 for the column-header line
    local tmp="$TAPE.tmp.$$"
    { grep '^#' "$TAPE"; grep -v '^#' "$TAPE" | head -1; grep -v '^#' "$TAPE" | tail -n +2 | tail -n "$MAX_ROWS"; } > "$tmp" \
      && mv -f "$tmp" "$TAPE"
  fi
}

case "${1:-}" in
  --dry)  build_row ;;
  --head)
    [ -f "$TAPE" ] || { echo "mesh-ambient-tape: no tape yet ($TAPE)"; exit 0; }
    grep '^#' "$TAPE"
    grep -v '^#' "$TAPE" | head -1
    echo "..."
    grep -v '^#' "$TAPE" | tail -6
    # simple stats over real (non-NA) rms values
    grep -v '^#' "$TAPE" | tail -n +2 | awk -F'\t' '$2!="NA"{n++; s+=$2; if(min==""||$2<min)min=$2; if(max==""||$2>max)max=$2}
      END{ if(n) printf "rows=%d real-dB: min=%.1f avg=%.1f max=%.1f\n", n, min, s/n, max; else print "no real dB rows yet" }'
    ;;
  --test)
    set +e; fail=0
    tape="$(mktemp -u)"; export MESH_AMBIENT_TAPE="$tape"
    TAPE="$tape"
    # 1. parse a good JSON (plain double-quoted keys inside single-quoted python — same as sample_db)
    out="$(printf '{"label":"QUIET","rms_db":-32.8,"peak_db":-20.4,"duration":1,"ts":"x"}' | python3 -c '
import sys,json
d=json.load(sys.stdin)
print("%.1f\t%.1f\t%s" % (d["rms_db"], d["peak_db"], d["label"]))')"
    [ "$out" = $'-32.8\t-20.4\tQUIET' ] && echo "ok: parse good json" || { echo "FAIL parse: [$out]"; fail=1; }
    # 2. honest-degrade: malformed json -> UNKNOWN (NA dB), never a fabricated level
    deg="$(printf 'not json' | python3 -c '
import sys,json
try:
    d=json.load(sys.stdin); print("PARSED")
except Exception:
    print("NA\tNA\tUNKNOWN")')"
    [ "$deg" = $'NA\tNA\tUNKNOWN' ] && echo "ok: malformed -> honest NA/UNKNOWN" || { echo "FAIL degrade: [$deg]"; fail=1; }
    # 3. --dry must NOT create the tape
    rm -f "$tape"; ( "$0" --dry >/dev/null 2>&1 )
    [ ! -f "$tape" ] && echo "ok: --dry no write" || { echo "FAIL: --dry wrote the tape"; fail=1; }
    # 4. header written ONCE across two appends
    rm -f "$tape"
    append_row "2026-01-01T00:00:00Z"$'\t'"-30.0"$'\t'"-10.0"$'\t'"QUIET"
    append_row "2026-01-01T00:02:00Z"$'\t'"-29.0"$'\t'"-9.0"$'\t'"MODERATE"
    hc="$(grep -c '^ts'"$(printf '\t')" "$tape" 2>/dev/null)"
    dr="$(grep -vc '^#' "$tape")"   # header line + 2 data = 3
    [ "$hc" = "1" ] && [ "$dr" = "3" ] && echo "ok: header once, 2 rows appended" || { echo "FAIL header/rows: hc=$hc dr=$dr"; fail=1; }
    rm -f "$tape"
    [ "$fail" = 0 ] && echo "mesh-ambient-tape --test: PASS" || echo "mesh-ambient-tape --test: FAIL"
    exit "$fail"
    ;;
  -h|--help)
    sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//'
    ;;
  "")
    append_row "$(build_row)"
    ;;
  *)
    echo "mesh-ambient-tape: unknown arg '$1' (try --dry/--head/--test/--help)" >&2; exit 2 ;;
esac
