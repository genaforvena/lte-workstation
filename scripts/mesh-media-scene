#!/usr/bin/env bash
# reflex-cadence: 1-56/5 * * * *
# reflex-state: $HOME/.mesh/.media-scene.state
# reflex-args: --edge
# mesh-media-scene — HOUSEHOLD MEDIA fusion: is the sound in the space MEDIA, and playing WHERE?
# No single sensor answers it: the mic hears energy but not its source; wpctl sees this node's
# own playback only; mesh-imac-media sees the iMac only; the TV never reports itself. Fused:
#   local (wpctl audio streams)  — an app on THIS node actively streaming to a sink
#   imac  (mesh-imac-media)      — VIDEO/AUDIO playback at the iMac (honest exit-2 organ)
#   tv    (BLE presence tape)    — the [TV] beacon in range (weak power/proximity hint)
#   mic   (ambient-db tape)      — room sound energy LOUD/MODERATE/QUIET/SILENCE
# → one scene label:
#   MEDIA         ≥1 accounted source actively playing (src= names them)
#   TV-LIKELY     room is loud, no accounted source, TV beacon in range → probably the TV
#   LIVE-SOUND    room is loud, no accounted source, TV absent → probably live humans
#   SOUND-UNATTRIBUTED  room is loud but the TV axis is dark — can't attribute, say so
#   QUIET         axes readable, nothing playing, room quiet
#   NO-MEDIA      media axes readable + silent, but the mic axis is dark (partial)
#   UNKNOWN       every axis dark — exit 2, never a faked all-clear
# Consumers: mesh-room wake-gating (TV audio phonetically matching the wake word — live
# false-positive 2026-07-07 07:23Z), room-context, operator-mood.
#
# Honest-degraded contract: each axis renders its own non-reading distinctly —
# UNREACHABLE (organ probe failed) / UNAVAILABLE (tool/file absent) / STALE (tape too old)
# — and degraded= lists every dark axis. UNREACHABLE is never rendered as NONE/ABSENT.
#
# HYSTERESIS (chat-review/media-scene-hysteresis-flap, 2026-07-08): --edge requires the SAME new
# scene for MESH_MEDIA_CONFIRM_N (default 2) consecutive raw reads before it posts/updates state;
# a single noisy 5-min sample (mic-level jitter, a BLE-scan miss) no longer flips the board (live:
# Default-string flapped QUIET<->SOUND-UNATTRIBUTED<->TV-LIKELY 13x in <2h on ordinary ambient
# noise). Oscillation resets the streak each tick, so real flapping never confirms; a genuinely
# sustained change still posts within CONFIRM_N ticks. First-ever run still establishes the
# baseline immediately (nothing to debounce against yet).
#
#   mesh-media-scene          one-shot reading (always the current instantaneous read, never debounced)
#   mesh-media-scene --json   machine-readable
#   mesh-media-scene --edge   REFLEX: post [media-scene] to chat only on a CONFIRMED scene change
#   mesh-media-scene --test   smoke test (fixtures + hysteresis dwell + chronic-dark trace-route + all-dark exit-2 + live-read gate)
#
# Exit codes: 0 = ≥1 axis produced a real reading · 2 = all axes dark (honest n/a)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
# wpctl needs the user session bus — absent under cron (the local axis would read UNAVAILABLE forever)
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

# MESH_MEDIA_STATE override wins; else MESH_TEST_SANDBOX=1 diverts state + derived chronic/cooldown
# — pre-fix, --test's live-read leg truncated the LIVE .media-scene.board-cooldown (and the state/
# chronic pair) on this node (task test-live-writes 2026-07-20).
STATE="${MESH_MEDIA_STATE:-$HOME/.mesh/.media-scene.state}"
[ "${MESH_TEST_SANDBOX:-0}" != 1 ] || STATE="${MESH_MEDIA_STATE:-${TMPDIR:-/tmp}/.media-scene.state.sandbox.$$}"
PENDING="${MESH_MEDIA_PENDING:-$HOME/.mesh/.media-scene.pending}"   # debounce: "<candidate>|<streak>"
CONFIRM_N="${MESH_MEDIA_CONFIRM_N:-2}"     # consecutive raw reads required before a scene flip posts
# CHRONIC ATTRIBUTION-DARK (chat-review/mediascene-chronic-unattributable-noise, 2026-07-11): on a
# node where the imac AND tv attribution axes are BOTH chronically unreadable (e.g. ds — no iMac
# organ, no [TV] beacon in range), fuse() can only ever emit QUIET or SOUND-UNATTRIBUTED, so every
# mic LOUD<->QUIET flip becomes a content-free board post that merely echoes the mic level with no
# attribution value to add. Track consecutive ticks where BOTH attribution axes are dark; once that
# streak reaches CHRONIC_N, route the QUIET<->SOUND-UNATTRIBUTED edge to trace instead of the board
# (STATE + --json stay current for consumers); re-arm the board the instant either axis returns a
# real read. MEDIA/TV-LIKELY/LIVE-SOUND carry genuine attribution and always post.
CHRONIC_N="${MESH_MEDIA_CHRONIC_N:-$CONFIRM_N}"            # dark-streak length that marks attribution "chronically" gone
CHRONIC_FILE="${MESH_MEDIA_CHRONIC_FILE:-$STATE.chronic}"  # consecutive ticks BOTH attribution axes (imac,tv) dark
# BOARD COOLDOWN (chat-review/mediascene-board-cooldown, 2026-07-09): CONFIRM_N already filters
# single-tick noise, but a genuinely oscillating room (QUIET<->TV-LIKELY<->QUIET all afternoon)
# still confirms a flip every few ticks, producing ~24 routine board posts/day from one sense.
# Mirrors mesh-cpu-throttle's NOM_COOLDOWN_FILE idiom: a confirmed transition within the cooldown
# window still updates STATE (consumers/--json stay current) but the board line routes to trace
# instead of mesh-chat; a transition past the cooldown window posts normally and rearms the window.
BOARD_COOLDOWN="${MESH_MEDIA_BOARD_COOLDOWN:-900}"
COOLDOWN_FILE="${MESH_MEDIA_COOLDOWN_FILE:-$HOME/.mesh/.media-scene.board-cooldown}"
[ "${MESH_TEST_SANDBOX:-0}" != 1 ] || COOLDOWN_FILE="${MESH_MEDIA_COOLDOWN_FILE:-$STATE.cooldown}"   # rides the sandboxed STATE
PRESENCE_LOG="${MESH_MEDIA_PRESENCE_LOG:-$HOME/.mesh/presence.log}"
MIC_TAPE="${MESH_MEDIA_MIC_TAPE:-$HOME/.mesh/ambient-db-tape.tsv}"
TV_RE="${MESH_MEDIA_TV_RE:-\[TV\]}"
WIN_S="${MESH_MEDIA_WIN_S:-600}"          # freshness window for both tapes
WPCTL_CMD="${MESH_MEDIA_WPCTL_CMD:-wpctl status}"
IMAC_CMD="${MESH_MEDIA_IMAC_CMD:-mesh-imac-media --json}"

MODE=text EDGE=0
case "${1:-}" in
  --json) MODE=json ;;
  --edge) EDGE=1 ;;
esac

now_epoch() { date -u +%s; }
iso_to_epoch() { date -u -d "$1" +%s 2>/dev/null; }
# the attribution-free scene pair — a flip WITHIN this set carries no source info, only mic level
_is_echo() { case "$1" in (QUIET|SOUND-UNATTRIBUTED) return 0 ;; (*) return 1 ;; esac; }

# ---- axis: local playback (this node's PipeWire) → PLAYING|SILENT|UNAVAILABLE ----
# Active stream links in the Audio Streams block look like "> <sink>:playback_FL [active]".
axis_local() {
  local out
  out="$($WPCTL_CMD 2>/dev/null)" || { echo UNAVAILABLE; return; }
  [ -n "$out" ] || { echo UNAVAILABLE; return; }
  if printf '%s\n' "$out" | grep -qE 'playback_F[LR][[:space:]]*\[active\]'; then
    echo PLAYING
  else
    echo SILENT
  fi
}

# ---- axis: iMac playback → VIDEO|AUDIO|NONE|UNREACHABLE|UNAVAILABLE ----
axis_imac() {
  command -v "${IMAC_CMD%% *}" >/dev/null 2>&1 || { echo UNAVAILABLE; return; }
  local j m
  j="$($IMAC_CMD 2>/dev/null)" || { echo UNREACHABLE; return; }
  m="$(printf '%s' "$j" | sed -n 's/.*"media": *"\([A-Z]*\)".*/\1/p')"
  case "$m" in (VIDEO|AUDIO|NONE) echo "$m" ;; (*) echo UNREACHABLE ;; esac
}

# ---- axis: TV BLE beacon → IN-RANGE|ABSENT|STALE|UNAVAILABLE ----
axis_tv() {
  [ -r "$PRESENCE_LOG" ] || { echo UNAVAILABLE; return; }
  local line ts age
  line="$(tail -n 1 "$PRESENCE_LOG" 2>/dev/null)"
  [ -n "$line" ] || { echo UNAVAILABLE; return; }
  ts="$(iso_to_epoch "${line%% *}")" || ts=
  [ -n "$ts" ] || { echo STALE; return; }
  age=$(( $(now_epoch) - ts ))
  [ "$age" -le "$WIN_S" ] || { echo STALE; return; }
  # scan the fresh window (any line whose scan saw the TV counts — BLE scans flap read-to-read)
  if tail -n 5 "$PRESENCE_LOG" | awk -v now="$(now_epoch)" -v win="$WIN_S" \
      '{ cmd="date -u -d \""$1"\" +%s"; cmd|getline t; close(cmd); if (now-t<=win) print }' \
      | grep -qE -- "$TV_RE"; then
    echo IN-RANGE
  else
    echo ABSENT
  fi
}

# ---- axis: room sound energy → LOUD|MODERATE|QUIET|SILENCE|STALE|UNAVAILABLE ----
axis_mic() {
  [ -r "$MIC_TAPE" ] || { echo UNAVAILABLE; return; }
  local line ts lvl
  line="$(tail -n 1 "$MIC_TAPE" 2>/dev/null)"
  [ -n "$line" ] || { echo UNAVAILABLE; return; }
  ts="$(iso_to_epoch "$(printf '%s' "$line" | cut -f1)")" || ts=
  { [ -n "$ts" ] && [ $(( $(now_epoch) - ts )) -le "$WIN_S" ]; } || { echo STALE; return; }
  lvl="$(printf '%s' "$line" | awk -F'\t' '{print $NF}')"
  case "$lvl" in (LOUD|MODERATE|QUIET|SILENCE|CLIPPING) echo "$lvl" ;; (*) echo STALE ;; esac
}

# ---- fuse <local> <imac> <tv> <mic> → "scene|src|degraded" (pure, offline-testable) ----
fuse() {
  local l="$1" i="$2" t="$3" m="$4" src="" deg="" scene readable=0
  case "$l" in (PLAYING|SILENT) readable=$((readable+1)) ;; (*) deg="$deg local" ;; esac
  case "$i" in (VIDEO|AUDIO|NONE) readable=$((readable+1)) ;; (*) deg="$deg imac" ;; esac
  case "$t" in (IN-RANGE|ABSENT) readable=$((readable+1)) ;; (*) deg="$deg tv" ;; esac
  case "$m" in (LOUD|MODERATE|QUIET|SILENCE|CLIPPING) readable=$((readable+1)) ;; (*) deg="$deg mic" ;; esac
  [ "$l" = PLAYING ] && src="$src node-audio"
  [ "$i" = VIDEO ] && src="$src imac-video"
  [ "$i" = AUDIO ] && src="$src imac-audio"
  src="${src# }"; deg="${deg# }"
  if [ "$readable" -eq 0 ]; then scene=UNKNOWN
  elif [ -n "$src" ]; then scene=MEDIA
  else
    case "$m" in
      LOUD|MODERATE|CLIPPING)
        # LIVE-SOUND claims HUMANS — only when every media axis was readable-and-silent;
        # a dark local/imac axis could be the unaccounted source → honest UNATTRIBUTED.
        if [ "$t" = IN-RANGE ]; then scene=TV-LIKELY
        elif [ "$t" = ABSENT ] && [ "$l" = SILENT ] && [ "$i" = NONE ]; then scene=LIVE-SOUND
        else scene=SOUND-UNATTRIBUTED
        fi ;;
      QUIET|SILENCE) scene=QUIET ;;
      *) scene=NO-MEDIA ;;   # media axes readable+silent, mic dark — honest partial
    esac
  fi
  printf '%s|%s|%s\n' "$scene" "${src:--}" "${deg:--}"
}

emit() {  # $1=scene $2=src $3=deg $4..7=axes
  if [ "$MODE" = json ]; then
    printf '{"scene":"%s","src":"%s","degraded":"%s","local":"%s","imac":"%s","tv":"%s","mic":"%s","ts":"%s"}\n' \
      "$1" "$2" "$3" "$4" "$5" "$6" "$7" "$(date -u +%FT%TZ)"
  else
    printf '[media-scene] scene=%s src=%s local=%s imac=%s tv=%s mic=%s degraded=%s\n' \
      "$1" "$2" "$4" "$5" "$6" "$7" "$3"
  fi
}

# ---- Smoke test ----
[ "${1:-}" = --test ] && {
  fail=0
  # TEST-SANDBOX (task test-live-writes 2026-07-20): the live-read leg's bare self-invoke traverses
  # the state/cooldown writes — export so they divert; %y ns sig gates before both exits.
  export MESH_TEST_SANDBOX=1
  _ms_live="$HOME/.mesh/.media-scene.state"; _ms_cd="$HOME/.mesh/.media-scene.board-cooldown"
  _ms_sig="$(stat -c '%y %s' "$_ms_live" 2>/dev/null || echo absent);$(stat -c '%y %s' "$_ms_cd" 2>/dev/null || echo absent)"
  chk() { [ "$2" = "$3" ] || { echo "FAIL: $1 (want '$3' got '$2')"; fail=1; }; }
  # accounted source wins: local playing + loud mic → MEDIA, not TV-LIKELY
  chk media       "$(fuse PLAYING NONE IN-RANGE LOUD)"        'MEDIA|node-audio|-'
  # loud + no source + TV in range → TV-LIKELY (the room false-wake case)
  chk tv-likely   "$(fuse SILENT NONE IN-RANGE LOUD)"         'TV-LIKELY|-|-'
  # loud + no source + TV absent → live humans
  chk live        "$(fuse SILENT NONE ABSENT MODERATE)"       'LIVE-SOUND|-|-'
  # loud but TV axis dark → honest unattributed, tv listed degraded
  chk unattrib    "$(fuse SILENT NONE STALE LOUD)"            'SOUND-UNATTRIBUTED|-|tv'
  # loud + TV absent but a media axis dark → never claim LIVE-SOUND (dark axis could be the source)
  chk unattrib2   "$(fuse SILENT UNREACHABLE ABSENT LOUD)"    'SOUND-UNATTRIBUTED|-|imac'
  # all readable + quiet → QUIET
  chk quiet       "$(fuse SILENT NONE ABSENT SILENCE)"        'QUIET|-|-'
  # imac video + unreadable rest: UNREACHABLE renders in degraded, never as NONE/ABSENT
  chk imacvid     "$(fuse UNAVAILABLE VIDEO STALE STALE)"     'MEDIA|imac-video|local tv mic'
  # ALL axes dark → UNKNOWN with every axis degraded — visibly ≠ QUIET
  chk alldark     "$(fuse UNAVAILABLE UNREACHABLE UNAVAILABLE UNAVAILABLE)" 'UNKNOWN|-|local imac tv mic'
  # end-to-end all-dark run must exit 2 (sandboxed inputs + stubbed probes, no live organs touched)
  d="$(mktemp -d)"; trap 'rm -rf "$d"' EXIT
  out="$(MESH_MEDIA_STATE="$d/state" MESH_MEDIA_PENDING="$d/pending" MESH_MEDIA_PRESENCE_LOG="$d/none" MESH_MEDIA_MIC_TAPE="$d/none" \
         MESH_MEDIA_WPCTL_CMD=false MESH_MEDIA_IMAC_CMD=false bash "${BASH_SOURCE[0]}" 2>/dev/null)"; rc=$?
  [ "$rc" = 2 ] || { echo "FAIL: all-dark must exit 2 (rc=$rc: $out)"; fail=1; }
  printf '%s\n' "$out" | grep -q 'scene=UNKNOWN' || { echo "FAIL: all-dark must render UNKNOWN ($out)"; fail=1; }
  # --edge in the sandbox: writes STATE, posts nothing (mesh-chat stubbed out)
  MESH_MEDIA_STATE="$d/state" MESH_MEDIA_PENDING="$d/pending" MESH_MEDIA_PRESENCE_LOG="$d/none" MESH_MEDIA_MIC_TAPE="$d/none" \
    MESH_MEDIA_WPCTL_CMD=false MESH_MEDIA_IMAC_CMD=false MESH_MEDIA_CHAT_CMD=true MESH_MEDIA_COOLDOWN_FILE="$d/cooldown" \
    bash "${BASH_SOURCE[0]}" --edge >/dev/null 2>&1
  [ "$(cat "$d/state" 2>/dev/null)" = UNKNOWN ] || { echo "FAIL: --edge did not persist state"; fail=1; }
  # HYSTERESIS regression (chat-review/media-scene-hysteresis-flap): a single-tick scene flip must
  # NOT post/update STATE; the SAME new scene sustained for CONFIRM_N (2) consecutive ticks must.
  # Falsify by reverting to the bare `if [ "$scene" != "$prev" ]` gate — tick 2 below would then
  # flip immediately instead of holding.
  d2="$(mktemp -d)"
  hyst_env() { MESH_MEDIA_STATE="$d2/state" MESH_MEDIA_PENDING="$d2/pending" MESH_MEDIA_PRESENCE_LOG="$d2/presence" \
               MESH_MEDIA_MIC_TAPE="$d2/mic" MESH_MEDIA_WPCTL_CMD=false MESH_MEDIA_IMAC_CMD=false \
               MESH_MEDIA_CHAT_CMD=true MESH_MEDIA_COOLDOWN_FILE="$d2/cooldown" "$@"; }
               # ^ cooldown override matters: pre-fix these --edge posts truncated the LIVE
               # .media-scene.board-cooldown whenever the live cooldown had expired (strace-proven,
               # task test-live-writes 2026-07-20) — a time-dependent leak, red only sometimes.
  write_quiet()    { printf '%s no-tv-here\n' "$(date -u +%FT%TZ)" > "$d2/presence"; printf '%s\t-50\tSILENCE\n' "$(date -u +%FT%TZ)" > "$d2/mic"; }
  write_tvlikely() { printf '%s [TV] Samsung 5 Series (40)\n' "$(date -u +%FT%TZ)" > "$d2/presence"; printf '%s\t-30\tLOUD\n' "$(date -u +%FT%TZ)" > "$d2/mic"; }
  write_quiet;    hyst_env bash "${BASH_SOURCE[0]}" --edge >/dev/null 2>&1   # tick1: first-run baseline, posts immediately
  [ "$(cat "$d2/state" 2>/dev/null)" = QUIET ] || { echo "FAIL: hysteresis baseline tick did not establish QUIET"; fail=1; }
  write_tvlikely; hyst_env bash "${BASH_SOURCE[0]}" --edge >/dev/null 2>&1   # tick2: single flip — must NOT post yet
  [ "$(cat "$d2/state" 2>/dev/null)" = QUIET ] || { echo "FAIL: hysteresis single-tick flip posted early (got $(cat "$d2/state" 2>/dev/null))"; fail=1; }
  write_quiet;    hyst_env bash "${BASH_SOURCE[0]}" --edge >/dev/null 2>&1   # tick3: flip back — oscillation resets the TV-LIKELY streak
  [ "$(cat "$d2/state" 2>/dev/null)" = QUIET ] || { echo "FAIL: hysteresis oscillating tick flipped state"; fail=1; }
  write_tvlikely; hyst_env bash "${BASH_SOURCE[0]}" --edge >/dev/null 2>&1   # tick4: TV-LIKELY streak restarts at 1
  write_tvlikely; hyst_env bash "${BASH_SOURCE[0]}" --edge >/dev/null 2>&1   # tick5: 2nd consecutive TV-LIKELY — confirms
  [ "$(cat "$d2/state" 2>/dev/null)" = TV-LIKELY ] || { echo "FAIL: hysteresis sustained 2-tick change did not confirm (got $(cat "$d2/state" 2>/dev/null))"; fail=1; }
  rm -rf "$d2"
  # BOARD COOLDOWN regression (chat-review/mediascene-board-cooldown, 2026-07-09): CONFIRM_N already
  # filters single-tick noise, but a room that keeps confirming real flips every few ticks still
  # spams the board. Two confirmed transitions inside MESH_MEDIA_BOARD_COOLDOWN must post ONCE
  # (chat) and route the rest to trace; STATE updates every time regardless (other consumers/--json
  # stay current). A transition once the cooldown has elapsed posts normally again. Falsify by
  # dropping the cooldown gate — the TV-LIKELY confirm below would then double-post to chat.
  d3="$(mktemp -d)"
  printf '#!/usr/bin/env bash\necho "$*" >> "%s/chat.log"\n' "$d3" > "$d3/fake-chat.sh"
  printf '#!/usr/bin/env bash\necho "$*" >> "%s/trace.log"\n' "$d3" > "$d3/fake-trace.sh"
  chmod +x "$d3/fake-chat.sh" "$d3/fake-trace.sh"
  cd3_env() { MESH_MEDIA_STATE="$d3/state" MESH_MEDIA_PENDING="$d3/pending" MESH_MEDIA_PRESENCE_LOG="$d3/presence" \
              MESH_MEDIA_MIC_TAPE="$d3/mic" MESH_MEDIA_WPCTL_CMD=false MESH_MEDIA_IMAC_CMD=false \
              MESH_MEDIA_COOLDOWN_FILE="$d3/cooldown" \
              MESH_MEDIA_CHAT_CMD="$d3/fake-chat.sh" MESH_MEDIA_TRACE_CMD="$d3/fake-trace.sh" "$@"; }
  write_quiet3()    { printf '%s no-tv-here\n' "$(date -u +%FT%TZ)" > "$d3/presence"; printf '%s\t-50\tSILENCE\n' "$(date -u +%FT%TZ)" > "$d3/mic"; }
  write_tvlikely3() { printf '%s [TV] Samsung 5 Series (40)\n' "$(date -u +%FT%TZ)" > "$d3/presence"; printf '%s\t-30\tLOUD\n' "$(date -u +%FT%TZ)" > "$d3/mic"; }
  write_quiet3
  MESH_MEDIA_BOARD_COOLDOWN=3600 cd3_env bash "${BASH_SOURCE[0]}" --edge >/dev/null 2>&1   # tick1: first-run baseline QUIET — always posts (no prior cooldown)
  write_tvlikely3
  MESH_MEDIA_BOARD_COOLDOWN=3600 cd3_env bash "${BASH_SOURCE[0]}" --edge >/dev/null 2>&1   # tick2: TV-LIKELY streak1 — not confirmed yet
  MESH_MEDIA_BOARD_COOLDOWN=3600 cd3_env bash "${BASH_SOURCE[0]}" --edge >/dev/null 2>&1   # tick3: TV-LIKELY confirms — inside cooldown, must route to trace
  [ "$(cat "$d3/state" 2>/dev/null)" = TV-LIKELY ] || { echo "FAIL: cooldown-suppressed transition must still update STATE"; fail=1; }
  [ "$(wc -l < "$d3/chat.log" 2>/dev/null || echo 0)" = 1 ] || { echo "FAIL: cooldown-window 2nd transition must NOT reach chat (chat.log: $(cat "$d3/chat.log" 2>/dev/null))"; fail=1; }
  [ -s "$d3/trace.log" ] || { echo "FAIL: cooldown-window 2nd transition must reach trace"; fail=1; }
  write_quiet3
  MESH_MEDIA_BOARD_COOLDOWN=0 cd3_env bash "${BASH_SOURCE[0]}" --edge >/dev/null 2>&1   # tick4: QUIET streak1
  MESH_MEDIA_BOARD_COOLDOWN=0 cd3_env bash "${BASH_SOURCE[0]}" --edge >/dev/null 2>&1   # tick5: QUIET confirms — cooldown elapsed (0s) — must post
  [ "$(cat "$d3/state" 2>/dev/null)" = QUIET ] || { echo "FAIL: post-cooldown transition did not confirm QUIET"; fail=1; }
  [ "$(wc -l < "$d3/chat.log" 2>/dev/null || echo 0)" = 2 ] || { echo "FAIL: transition past elapsed cooldown must reach chat (chat.log: $(cat "$d3/chat.log" 2>/dev/null))"; fail=1; }
  rm -rf "$d3"
  # CHRONIC ATTRIBUTION-DARK regression (chat-review/mediascene-chronic-unattributable-noise, 2026-07-11):
  # when BOTH imac AND tv are unreadable for >= CHRONIC_N ticks, a QUIET<->SOUND-UNATTRIBUTED flip is
  # pure mic-level echo and must route to trace, NEVER the board — while STATE still updates. The
  # board re-arms the instant either axis returns a real read; a single transient miss still posts.
  # Falsify by dropping the chronic_dark gate — case (a) below would then double-post to chat.
  d4="$(mktemp -d)"
  printf '#!/usr/bin/env bash\necho "$*" >> "%s/chat.log"\n' "$d4" > "$d4/fake-chat.sh"
  printf '#!/usr/bin/env bash\necho "$*" >> "%s/trace.log"\n' "$d4" > "$d4/fake-trace.sh"
  chmod +x "$d4/fake-chat.sh" "$d4/fake-trace.sh"
  # imac always dark (IMAC_CMD=false → UNREACHABLE); tv toggled via presence file:
  #   empty presence → axis_tv UNAVAILABLE (dark);  fresh [TV] line → IN-RANGE;  fresh non-TV → ABSENT (readable)
  cd4_env() { MESH_MEDIA_STATE="$d4/state" MESH_MEDIA_PENDING="$d4/pending" MESH_MEDIA_PRESENCE_LOG="$d4/presence" \
              MESH_MEDIA_MIC_TAPE="$d4/mic" MESH_MEDIA_WPCTL_CMD=false MESH_MEDIA_IMAC_CMD=false \
              MESH_MEDIA_CHRONIC_FILE="$d4/chronic" MESH_MEDIA_CHRONIC_N=2 MESH_MEDIA_BOARD_COOLDOWN=0 \
              MESH_MEDIA_COOLDOWN_FILE="$d4/cooldown" \
              MESH_MEDIA_CHAT_CMD="$d4/fake-chat.sh" MESH_MEDIA_TRACE_CMD="$d4/fake-trace.sh" "$@"; }
  pres_tvdark() { : > "$d4/presence"; }                                                    # empty → tv UNAVAILABLE (dark)
  pres_absent() { printf '%s no-tv-here\n' "$(date -u +%FT%TZ)" > "$d4/presence"; }         # fresh non-TV → tv ABSENT (readable)
  pres_intv()   { printf '%s [TV] Samsung 5 Series (40)\n' "$(date -u +%FT%TZ)" > "$d4/presence"; }  # fresh [TV] → IN-RANGE
  mic_loud4()   { printf '%s\t-30\tLOUD\n' "$(date -u +%FT%TZ)" > "$d4/mic"; }
  mic_quiet4()  { printf '%s\t-50\tSILENCE\n' "$(date -u +%FT%TZ)" > "$d4/mic"; }
  # (a) both attribution axes dark for the confirm span, then a mic LOUD->QUIET flip → STATE updates, NO board line
  pres_tvdark; mic_loud4;  cd4_env bash "${BASH_SOURCE[0]}" --edge >/dev/null 2>&1   # tick1: baseline SOUND-UNATTRIBUTED posts (first run) — streak1
  pres_tvdark; mic_loud4;  cd4_env bash "${BASH_SOURCE[0]}" --edge >/dev/null 2>&1   # tick2: no change — streak2 (now chronic)
  pres_tvdark; mic_quiet4; cd4_env bash "${BASH_SOURCE[0]}" --edge >/dev/null 2>&1   # tick3: QUIET streak1 — not confirmed
  pres_tvdark; mic_quiet4; cd4_env bash "${BASH_SOURCE[0]}" --edge >/dev/null 2>&1   # tick4: QUIET confirms — chronic echo edge → trace only
  [ "$(cat "$d4/state" 2>/dev/null)" = QUIET ] || { echo "FAIL: chronic-dark echo edge must still update STATE (got $(cat "$d4/state" 2>/dev/null))"; fail=1; }
  [ "$(wc -l < "$d4/chat.log" 2>/dev/null || echo 0)" = 1 ] || { echo "FAIL: chronic-dark LOUD->QUIET flip must NOT reach board (chat.log: $(cat "$d4/chat.log" 2>/dev/null))"; fail=1; }
  [ -s "$d4/trace.log" ] || { echo "FAIL: chronic-dark echo edge must route to trace"; fail=1; }
  # (b) tv returns a real read (IN-RANGE) → board re-arms; MEDIA/TV-LIKELY always post
  pres_intv; mic_loud4; cd4_env bash "${BASH_SOURCE[0]}" --edge >/dev/null 2>&1   # tick5: TV-LIKELY streak1 — streak reset to 0 (tv readable)
  [ "$(cat "$d4/chronic" 2>/dev/null)" = 0 ] || { echo "FAIL: a real tv read must reset the chronic-dark streak (got $(cat "$d4/chronic" 2>/dev/null))"; fail=1; }
  pres_intv; mic_loud4; cd4_env bash "${BASH_SOURCE[0]}" --edge >/dev/null 2>&1   # tick6: TV-LIKELY confirms — not an echo scene → posts
  [ "$(cat "$d4/state" 2>/dev/null)" = TV-LIKELY ] || { echo "FAIL: re-armed TV-LIKELY did not confirm (got $(cat "$d4/state" 2>/dev/null))"; fail=1; }
  [ "$(wc -l < "$d4/chat.log" 2>/dev/null || echo 0)" = 2 ] || { echo "FAIL: TV-LIKELY must reach the board (re-armed) (chat.log: $(cat "$d4/chat.log" 2>/dev/null))"; fail=1; }
  rm -rf "$d4"
  # (c) single transient attribution miss (only imac dark, tv readable) never accumulates chronic → the flip still posts
  d5="$(mktemp -d)"
  printf '#!/usr/bin/env bash\necho "$*" >> "%s/chat.log"\n' "$d5" > "$d5/fake-chat.sh"
  chmod +x "$d5/fake-chat.sh"
  cd5_env() { MESH_MEDIA_STATE="$d5/state" MESH_MEDIA_PENDING="$d5/pending" MESH_MEDIA_PRESENCE_LOG="$d5/presence" \
              MESH_MEDIA_MIC_TAPE="$d5/mic" MESH_MEDIA_WPCTL_CMD=false MESH_MEDIA_IMAC_CMD=false \
              MESH_MEDIA_CHRONIC_FILE="$d5/chronic" MESH_MEDIA_CHRONIC_N=2 MESH_MEDIA_BOARD_COOLDOWN=0 \
              MESH_MEDIA_COOLDOWN_FILE="$d5/cooldown" MESH_MEDIA_CHAT_CMD="$d5/fake-chat.sh" MESH_MEDIA_TRACE_CMD=true "$@"; }
  printf '%s no-tv-here\n' "$(date -u +%FT%TZ)" > "$d5/presence"                                   # tv ABSENT (readable) throughout
  printf '%s\t-50\tSILENCE\n' "$(date -u +%FT%TZ)" > "$d5/mic"; cd5_env bash "${BASH_SOURCE[0]}" --edge >/dev/null 2>&1  # baseline QUIET posts
  printf '%s no-tv-here\n' "$(date -u +%FT%TZ)" > "$d5/presence"; printf '%s\t-30\tLOUD\n' "$(date -u +%FT%TZ)" > "$d5/mic"
  cd5_env bash "${BASH_SOURCE[0]}" --edge >/dev/null 2>&1   # SOUND-UNATTRIBUTED streak1 (imac dark only) — not confirmed
  printf '%s no-tv-here\n' "$(date -u +%FT%TZ)" > "$d5/presence"; printf '%s\t-30\tLOUD\n' "$(date -u +%FT%TZ)" > "$d5/mic"
  cd5_env bash "${BASH_SOURCE[0]}" --edge >/dev/null 2>&1   # SOUND-UNATTRIBUTED confirms — tv readable so NOT chronic → must post
  [ "$(cat "$d5/chronic" 2>/dev/null)" = 0 ] || { echo "FAIL: single-axis miss must not accumulate chronic streak (got $(cat "$d5/chronic" 2>/dev/null))"; fail=1; }
  [ "$(cat "$d5/state" 2>/dev/null)" = SOUND-UNATTRIBUTED ] || { echo "FAIL: transient-miss transition did not confirm (got $(cat "$d5/state" 2>/dev/null))"; fail=1; }
  [ "$(wc -l < "$d5/chat.log" 2>/dev/null || echo 0)" = 2 ] || { echo "FAIL: single transient miss must still post to board (chat.log: $(cat "$d5/chat.log" 2>/dev/null))"; fail=1; }
  rm -rf "$d5"
  [ "$fail" = 0 ] || { echo "smoke-test: FAIL"; exit 1; }
  # Real-read gate: a live run must draw ≥1 axis from real hardware/tape (exit 0), else honest exit 2
  live="$(bash "${BASH_SOURCE[0]}" 2>/dev/null)"; live_rc=$?
  # sandbox honesty gate — before BOTH exits. Falsify: drop the STATE/COOLDOWN_FILE diversions.
  _ms_sig2="$(stat -c '%y %s' "$_ms_live" 2>/dev/null || echo absent);$(stat -c '%y %s' "$_ms_cd" 2>/dev/null || echo absent)"
  if [ "$_ms_sig2" != "$_ms_sig" ]; then
    # HONESTY-GATE ATTRIBUTION (memory a-sandbox-honesty-gate-cannot-separate-a-leak-from-a-collision):
    # a moved live artifact has TWO causes and ONE sample cannot separate them — a leaking sandbox,
    # or a CONCURRENT live writer (this reflex's own cron tick, or any other tool that writes the
    # same path) stamping it inside the test window. The single-sample form blamed the test and went
    # red with nothing wrong (mesh-node-health 2026-08-15, mesh-sound-reflex c5779d6); mesh-land and
    # mesh-doctor both consume this verdict, so a false red BLOCKS LANDING. No lock covers this
    # write path, so attribute by REPEATING: a real leak moves the artifact on EVERY attempt, a
    # collision does not repeat. Drive both directions — leak twice must still FAIL, leak once must
    # print the note and pass.
    if [ -n "${MESH_HONESTY_RETRY:-}" ]; then echo "smoke-test: FAIL (--test stamped a LIVE artifact: '$_ms_sig' → '$_ms_sig2' — moved on BOTH attempts, a real sandbox leak, not a concurrent-writer collision)"; exit 1; fi
    _hr_a="$(stat -c '%y %s' "$_ms_live" 2>/dev/null || echo absent);$(stat -c '%y %s' "$_ms_cd" 2>/dev/null || echo absent)"
    MESH_HONESTY_RETRY=1 "$0" --test >/dev/null 2>&1
    _hr_b="$(stat -c '%y %s' "$_ms_live" 2>/dev/null || echo absent);$(stat -c '%y %s' "$_ms_cd" 2>/dev/null || echo absent)"
    [ "$_hr_b" = "$_hr_a" ] || { echo "smoke-test: FAIL (--test stamped a LIVE artifact: '$_ms_sig' → '$_ms_sig2' — moved on BOTH attempts, a real sandbox leak, not a concurrent-writer collision)"; exit 1; }
    echo "  note: a LIVE artifact moved during attempt 1 but NOT during the re-run — attributed to a concurrent live writer, not a sandbox leak"
  fi
  if [ "$live_rc" = 0 ]; then
    printf '%s\n' "$live" | grep -qE '^\[media-scene\] scene=(MEDIA|TV-LIKELY|LIVE-SOUND|SOUND-UNATTRIBUTED|QUIET|NO-MEDIA) ' || {
      echo "smoke-test: FAIL (live rc=0 but scene malformed/UNKNOWN: $live)"; exit 1; }
    echo "smoke-test: ok (8 fixtures + hysteresis dwell + all-dark rc2 + live read: $live)"; exit 0
  else
    echo "smoke-test: n/a — fixtures + hysteresis dwell ok but every axis dark on this node (honest exit 2)"; exit 2
  fi
}

l="$(axis_local)"; i="$(axis_imac)"; t="$(axis_tv)"; m="$(axis_mic)"
IFS='|' read -r scene src deg <<EOF
$(fuse "$l" "$i" "$t" "$m")
EOF

if [ "$EDGE" = 1 ]; then
  prev="$(cat "$STATE" 2>/dev/null || echo)"
  first_run=0; [ -f "$STATE" ] || first_run=1
  # HYSTERESIS (chat-review/media-scene-hysteresis-flap): a single noisy 5-min sample (mic-level
  # jitter, a BLE-scan miss) must never flip the board — only a SUSTAINED change does. Require
  # CONFIRM_N consecutive raw reads agreeing on the SAME new scene before it's accepted; oscillation
  # (A<->B every tick) resets the streak each time and never confirms. Mirrors the asymmetric-hold
  # idiom already used by mesh-perimeter's gw_net_sev/motion_phy_sev (never lower/flip on one sample)
  # and the grind hollow-lane debounce (2ef1151) applied to a sibling audio-level sense. First-ever
  # run still establishes the baseline immediately (no history to debounce against yet — same as
  # mesh-reflex-census's "first run: no alarm" precedent).
  pcand="" pcount=0
  [ -f "$PENDING" ] && IFS='|' read -r pcand pcount < "$PENDING" 2>/dev/null
  case "$pcount" in ''|*[!0-9]*) pcount=0;; esac
  if [ "$scene" = "$pcand" ]; then pcount=$((pcount+1)); else pcand="$scene"; pcount=1; fi
  printf '%s|%s\n' "$pcand" "$pcount" > "$PENDING"
  # CHRONIC ATTRIBUTION-DARK streak: count consecutive ticks where BOTH imac AND tv are unreadable
  # (a single-axis miss, or either axis returning a real read, resets it → the board re-arms at once).
  imac_dark=1; case "$i" in (VIDEO|AUDIO|NONE) imac_dark=0 ;; esac
  tv_dark=1;   case "$t" in (IN-RANGE|ABSENT) tv_dark=0 ;; esac
  cstreak=0; [ -f "$CHRONIC_FILE" ] && cstreak="$(cat "$CHRONIC_FILE" 2>/dev/null)"
  case "$cstreak" in ''|*[!0-9]*) cstreak=0;; esac
  if [ "$imac_dark" = 1 ] && [ "$tv_dark" = 1 ]; then cstreak=$((cstreak+1)); else cstreak=0; fi
  printf '%s\n' "$cstreak" > "$CHRONIC_FILE"
  chronic_dark=0; [ "$cstreak" -ge "$CHRONIC_N" ] && chronic_dark=1
  if [ "$scene" != "$prev" ] && { [ "$first_run" = 1 ] || [ "$pcount" -ge "$CONFIRM_N" ]; }; then
    printf '%s\n' "$scene" > "$STATE"
    msg="[media-scene] scene=$scene src=$src (was ${prev:-new}) local=$l imac=$i tv=$t mic=$m degraded=$deg"
    chat="${MESH_MEDIA_CHAT_CMD:-mesh-chat}"
    tracer="${MESH_MEDIA_TRACE_CMD:-mesh-trace}"
    if [ "$chronic_dark" = 1 ] && _is_echo "$scene" && _is_echo "$prev"; then
      # both attribution axes dark for >= CHRONIC_N ticks and the flip stays inside the
      # attribution-free pair → pure mic-level echo, route to trace and never touch the board.
      command -v "${tracer%% *}" >/dev/null 2>&1 && $tracer "${msg} (chronic attribution-dark ${cstreak} ticks: imac+tv unreadable, routed to trace not board)" 2>/dev/null || true
    else
      _cd_now=$(now_epoch)
      _cd_last=$(cat "$COOLDOWN_FILE" 2>/dev/null || echo 0)
      case "$_cd_last" in ''|*[!0-9]*) _cd_last=0;; esac
      if [ $((_cd_now - _cd_last)) -ge "$BOARD_COOLDOWN" ]; then
        command -v "${chat%% *}" >/dev/null 2>&1 && MESH_WHO="media-scene@$(hostname)" $chat "$msg" 2>/dev/null || true
        printf '%s\n' "$_cd_now" > "$COOLDOWN_FILE"
      else
        command -v "${tracer%% *}" >/dev/null 2>&1 && $tracer "${msg} (board-cooldown ${BOARD_COOLDOWN}s active, routed to trace)" 2>/dev/null || true
      fi
    fi
    printf '%s\n' "$scene"
  fi
  mesh-state-touch "$STATE" 2>/dev/null || touch "$STATE" 2>/dev/null || true   # mtime=ran-live, content=change-gated
  [ "$scene" = UNKNOWN ] && exit 2
  exit 0
fi

emit "$scene" "$src" "$deg" "$l" "$i" "$t" "$m"
[ "$scene" = UNKNOWN ] && exit 2
exit 0
