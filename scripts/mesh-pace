#!/usr/bin/env bash
# mesh-pace — the SPEND GOVERNOR. One uniform knob so the mesh doesn't drain the 5-hour paid window
# in two hours (operator 2026-06-21: "давай более нежно тратить лимиты ... один глобальный фильтр,
# одинаковый на каждом, выбери число, чтобы пятичасового окна осталось хотя бы чуть-чуть").
#
# It is a tiny min-interval GATE keyed by a label. A work-creating reflex that wakes a PAID mind
# (mesh-feed, mesh-dispatch) asks the gate first and skips this cycle if its key fired too recently:
#
#     mesh-pace feed || exit 0      # in the tool: too soon since last feed -> quietly skip
#
# ONE number controls everything: MESH_PACE_GAP (seconds, in ~/.mesh/restore.env). Bigger = gentler
# = more reserve left in the window. The gate is NON-destructive (no cron rewrite) and trivially
# reverted (MESH_PACE_GAP=0 disables it). Operator-facing paths (channel-tg, reply-watch) and
# health/safety reflexes are NEVER gated — only autonomous work-creation is paced.
#
# RESERVE (budget-aware): if the paid burn is already running hot this 5h window, the effective gap
# stretches automatically (back off harder the closer we are to the wall) — so the knob targets a
# RESERVE, not just a flat cadence. Set MESH_PACE_RESERVE=0 to use a pure flat gap instead.
#
#   mesh-pace <key> [gap]   gate: exit 0 = proceed (records now), exit 1 = skip (too soon). Optional
#                           per-key gap override (seconds) for a lane that needs its own cadence.
#   mesh-pace --check <key> [gap]  READ-ONLY probe: exit 0 = the gate would pass now, exit 1 = it
#                           would hold. Never records — for callers that need the gap state without
#                           consuming it (e.g. mesh-dispatch's idle-exposure tick).
#   mesh-pace --status      show every key: last pass, age, effective gap, allow/skip now
#   mesh-pace --eff-gap [base]  print the effective gap for a base given the current paid burn —
#                           MIN_GAP when the window is cold, base×mult when hot. Handy to see why
#                           dispatch is (or isn't) firing on events.
#   mesh-pace --control-mode  antagonistic controller-pair read: which of eff_gap's two opposed branches
#                           (cold-shrink = inflow / hot-stretch = outflow) is in control, their setpoint
#                           SEPARATION, and whether control is chattering between them (Ruoff 2025).
#   mesh-pace --reset [key] forget last-pass for one key (or all) — next call passes immediately
#   mesh-pace --test        smoke
#
# EVENT-DRIVEN WHEN COLD (operator 2026-07-24 «диспатч событийным, не крон-овым»): the reserve used
# to only STRETCH the gap when burn was hot, so a nearly-empty paid window still held every board
# event for the full flat GAP (18000s here) → the board was passive, owner-direct [task]s waited for
# the next cron poll, minds "didn't wake". eff_gap now also SHRINKS: paid burn < MESH_PACE_COLD_BELOW
# (7/h) → floor to MESH_PACE_MIN_GAP (60s), so the fsnotify board event fires the owner NOW while the
# window has headroom, and the hot-stretch still protects the reserve once burn climbs. Burn is read
# from the hledger labour ledger (mesh-labor --json), the same journal the board is.
# orphan-ok: a GATE consulted by other reflexes (mesh-feed/mesh-dispatch), not itself cron-scheduled.
set -uo pipefail
[ -f "$HOME/.mesh/restore.env" ] && . "$HOME/.mesh/restore.env" 2>/dev/null || true

GAP="${MESH_PACE_GAP:-900}"          # base min seconds between passes of a key (default 15 min)
RESERVE="${MESH_PACE_RESERVE:-1}"    # 1 = stretch the gap when paid burn is hot; 0 = flat gap
MIN_GAP="${MESH_PACE_MIN_GAP:-60}"   # COLD floor: when the paid window is barely touched, shrink the
                                     # gap to THIS so a board event wakes the owner now, not on the
                                     # next cron poll (operator 2026-07-24: диспатч событийным).
SPEND_LOG="${MESH_SPEND_LOG:-$HOME/.mesh/spend.log}"  # raw timestamped turn tape (burden trend reads it)
# HARD-CAP GATE LEDGER: every over_budget() evaluation books one hledger txn recording the decision it
# reached and the (cap, spent) it saw. This turns "did the $-gate ever fail-OPEN on a blind/stale meter
# read or on cap<=0" from a source-reading inference into a balance query (mesh-pace --gate-ledger, or
# `hledger -f <log> balance gate:decision`). Raised by @anp2network (dev.to 3c648); the gate's fail-open
# branches (a >20s meter, an empty/unparseable read, no cap armed) are INVISIBLE at the call site — the
# lane proceeds and nothing records WHY. The ledger makes each such fail-open a standing, countable row.
PACE_GATE_LOG="${MESH_PACE_GATE_LOG:-$HOME/.mesh/pace-gate.journal}"
COLD_BELOW="${MESH_PACE_COLD_BELOW:-7}"  # paid burn/h STRICTLY below this =cold → floor to MIN_GAP.
                                     # 7 = the first hot-staircase step, so cold ends exactly where
                                     # stretch begins — no flat-base band survives between them.
DIR="$HOME/.mesh/pace"; mkdir -p "$DIR" 2>/dev/null || true
now="$(date +%s)"

# Paid burn RIGHT NOW, in turns/hour of the PAID provider over the rolling window. This is the one
# signal both the cold-shrink and the hot-stretch key off. Primary source is the hledger labour
# ledger (operator 2026-07-24 «диспатч через hledger, не рядом» — the pace governor reads the same
# journal the board IS), falling back to mesh-quota's paid/1h, then to -1 = UNKNOWN. UNKNOWN is
# NOT cold and NOT hot: eff_gap falls back to the gentle base, so a blind read never drains the
# window nor freezes it. MESH_PACE_BURN_OVERRIDE short-circuits the probes (hermetic --test).
paid_burn_per_h() {
  if [ -n "${MESH_PACE_BURN_OVERRIDE:-}" ]; then echo "$MESH_PACE_BURN_OVERRIDE"; return; fi
  local j n wh
  # hledger labour ledger: {"window_h":5,"providers":{"anthropic":23,...}} → paid burn/h = n/window_h.
  j="$(mesh-labor --json 2>/dev/null)" || j=""
  if [ -n "$j" ]; then
    n="$(printf '%s' "$j"  | grep -oE '"anthropic":[0-9]+' | grep -oE '[0-9]+' | head -1)"
    wh="$(printf '%s' "$j" | grep -oE '"window_h":[0-9]+'  | grep -oE '[0-9]+' | head -1)"
    if [ -n "$n" ] && [ -n "$wh" ] && [ "$wh" -gt 0 ]; then awk "BEGIN{printf \"%d\", $n/$wh}"; return; fi
  fi
  # fallback: mesh-quota prints "... paid 2/1h 11/5h ..." — pull the paid/1h figure.
  local per1h
  per1h="$(mesh-quota 2>/dev/null | grep -oE 'paid [0-9]+/1h' | grep -oE '[0-9]+' | head -1)"
  [ -n "$per1h" ] && { echo "$per1h"; return; }
  echo -1
}

# How hot is the paid window right now? Returns a multiplier >=1 applied to the base gap.
# The hotter the recent paid burn, the longer we wait. Unknown burn (-1) → multiplier 1.
burn_mult() {
  [ "$RESERVE" = 1 ] || { echo 1; return; }
  local burn; burn="$(paid_burn_per_h)"
  [ "$burn" -ge 0 ] 2>/dev/null || { echo 1; return; }
  # Gentle staircase: <7/h normal, 7-11 -> 1.5x, 12-17 -> 2x, >=18 -> 3x. Tuned for a ~5h window
  # that should last ~5h: a steady ~6-9 paid round-trips/h keeps reserve; bursts get throttled.
  if   [ "$burn" -ge 18 ]; then echo 3
  elif [ "$burn" -ge 12 ]; then echo 2
  elif [ "$burn" -ge 7  ]; then echo 1.5
  else echo 1; fi
}

# HARD $ CAP (operator 2026-07-27 "если траты >$100 за 5ч — минды спят до следующего окна"): when the
# rolling 5h INFERENCE spend is at/over the armed cap (MESH_LABOR_BUDGET_USD), HOLD every paced lane
# unconditionally — dispatch is the only caller, so no paid mind picks up new board work until the
# rolling window recovers (old spend ages out of the 5h tail → spent<cap → auto-resume). Operator-facing
# lanes (channel-tg, reply-watch) DON'T call mesh-pace, so this never gags the operator conversation.
# FAIL-OPEN: an absent/broken/unparseable meter, or no cap armed, never holds. MESH_PACE_GAP=0 (escape
# hatch, checked before this) still fully disables the governor incl. this cap — the manual override.
# MESH_PACE_BUDGET_OVERRIDE=over|under short-circuits the probe for a hermetic --test.
# Bound the gate ledger so an ever-appending decision tape (dispatch calls the gate on every poll) can't
# grow without limit. Called ~1% of books (keyed off $now) so the wc is not paid every dispatch. Trims to
# the last KEEP lines on a TXN BOUNDARY — an hledger txn is a date-header line + two indented posting
# lines, so a naive tail could sever a txn; the awk drops any leading orphan posting lines up to the first
# date header, leaving a journal hledger still parses.
_gate_rotate() {
  local max=30000 keep=15000 n tmp
  n="$(wc -l < "$PACE_GATE_LOG" 2>/dev/null || echo 0)"
  [ "$n" -gt "$max" ] 2>/dev/null || return 0
  tmp="$(mktemp 2>/dev/null)" || return 0
  tail -n "$keep" "$PACE_GATE_LOG" 2>/dev/null | awk 'seen||/^[0-9]/{seen=1;print}' > "$tmp" 2>/dev/null \
    && mv -f "$tmp" "$PACE_GATE_LOG" 2>/dev/null || rm -f "$tmp" 2>/dev/null
}

# book_gate <reason> <cap> <spent> — append one hledger txn recording a hard-cap gate decision. Reasons:
#   over        spent>=cap>0            → the gate HELD (return 0); the cap bit
#   under       cap>0, spent<cap        → proceeded legitimately (headroom)
#   nocap       cap<=0 / no cap armed   → proceeded FAIL-OPEN (governor's $-cap effectively disabled)
#   blind-meter meter read failed/empty → proceeded FAIL-OPEN (a >20s / broken mesh-labor --json)
#   blind-parse cap|spent unparseable   → proceeded FAIL-OPEN (meter returned malformed json)
# Double-entry so `hledger -f <log> balance gate:decision` tallies each reason as a running count; the
# contra `gate:calls` keeps every txn balanced (hledger check passes with no oracle). Synthetic states
# (MESH_PACE_BUDGET_OVERRIDE, set by --test and any hermetic caller) are NEVER booked — the ledger records
# only decisions reached against a REAL meter read, so a test can't forge a fail-open row a watchdog reads.
book_gate() {
  [ -n "${MESH_PACE_BUDGET_OVERRIDE:-}" ] && return 0     # synthetic decision — never book
  local reason="$1" cap="${2:-na}" spent="${3:-na}" ts d t
  ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"; d="${ts%%T*}"; t="${ts#*T}"   # hledger dates are YYYY-MM-DD; time → comment
  { printf '%s * gate %s  ; ts:%s cap:%s spent:%s mode:%s\n' \
        "$d" "$reason" "$t" "$cap" "$spent" "${PACE_GATE_MODE:-gate}"
    printf '    gate:decision:%-12s   1 GATE\n' "$reason"
    printf '    gate:calls                    -1 GATE\n'
  } >> "$PACE_GATE_LOG" 2>/dev/null || true
  [ $((now % 100)) -eq 0 ] && _gate_rotate
  return 0
}

over_budget() {
  case "${MESH_PACE_BUDGET_OVERRIDE:-}" in over) return 0;; under) return 1;; esac
  local j cap spent cls
  # timeout must EXCEED the real meter read or the hard cap is blind: mesh-labor --json measured 12.2s
  # (2026-07-31), so the old `timeout 6` killed the read → empty → return 1 (FAIL-OPEN) EVERY time —
  # the operator's 07-27 $100/5h cap never held though spent had crossed it. 20s clears the read with
  # margin; a genuinely broken/hung meter (>20s) still fails open, as intended — now BOOKED as blind-meter.
  # MESH_PACE_METER_JSON_OVERRIDE injects a meter payload (hermetic --test of the classify+book path
  # WITHOUT MESH_PACE_BUDGET_OVERRIDE, which is booked as synthetic and skips the ledger). It is NOT the
  # budget override: it still flows through the real cap/spent parse + classify, so a bad payload exercises
  # the genuine blind-parse fail-open branch.
  if [ -n "${MESH_PACE_METER_JSON_OVERRIDE+x}" ]; then j="$MESH_PACE_METER_JSON_OVERRIDE"
  else j="$(timeout 20 mesh-labor --json 2>/dev/null)" || { book_gate blind-meter na na; return 1; }
  fi
  [ -n "$j" ] || { book_gate blind-meter na na; return 1; }
  cap="$(printf '%s' "$j"   | grep -oE '"cap":[0-9.]+'   | grep -oE '[0-9.]+' | head -1)"
  spent="$(printf '%s' "$j" | grep -oE '"spent":[0-9.]+' | grep -oE '[0-9.]+' | head -1)"
  [ -n "$cap" ] && [ -n "$spent" ] || { book_gate blind-parse "${cap:-na}" "${spent:-na}"; return 1; }
  # classify once (awk failure → blind-parse, preserving the original fail-open on a broken awk).
  cls="$(awk "BEGIN{ if($cap>0 && $spent>=$cap) print \"over\"; else if($cap>0) print \"under\"; else print \"nocap\" }" 2>/dev/null)"
  case "$cls" in
    over)  book_gate over  "$cap" "$spent"; return 0 ;;
    under) book_gate under "$cap" "$spent"; return 1 ;;
    nocap) book_gate nocap "$cap" "$spent"; return 1 ;;
    *)     book_gate blind-parse "$cap" "$spent"; return 1 ;;
  esac
}

eff_gap() { # base_gap -> effective gap: SHRINK to MIN_GAP when cold, STRETCH by burn_mult when hot.
  local base="$1" burn mult
  [ "$RESERVE" = 1 ] || { echo "$base"; return; }   # reserve off → pure flat base, no shrink/stretch
  burn="$(paid_burn_per_h)"
  # COLD (paid burn strictly below COLD_BELOW, and a real reading — UNKNOWN=-1 is NOT cold): the
  # window is barely touched, so a board event should wake the owner NOW. Floor to MIN_GAP, but
  # NEVER inflate a caller's smaller explicit base — cold-shrink only ever shrinks.
  if [ "$burn" -ge 0 ] 2>/dev/null && [ "$burn" -lt "$COLD_BELOW" ]; then
    if [ "$base" -lt "$MIN_GAP" ]; then echo "$base"; else echo "$MIN_GAP"; fi
    return
  fi
  # WARM/HOT (or UNKNOWN): stretch the gentle base to protect the reserve.
  mult="$(burn_mult)"
  awk -v b="$base" -v m="$mult" 'BEGIN{printf "%d\n", b*m}'
}

# CONTROL-BURDEN TREND (Ziegler 2026, "When Regulation Has Memory: Hysteresis and Control Burden in
# Artificial Agency", arXiv:2606.30975). Finding: the gain a regulator must expend to hold a target is
# PATH-dependent — the same target costs different gain depending on whether the system is moving TOWARD
# a demanding regime or RETURNING from one (a reproducible hysteresis loop), and anticipatory
# stabilisation needs LESS gain than recovery-after-the-fact. mesh-pace's gain (burn_mult) is a
# MEMORYLESS staircase on the 5h-AVERAGE burn: same average → same gain, blind to the recent TREND. So
# when burn is climbing but the 5h average is still cold, the governor holds gain slack and only stretches
# AFTER the average crosses hot — Ziegler's expensive recovery branch, exactly when the $-cap is nearest.
# This read exposes which branch the governor is in. REPORT-ONLY — it never changes eff_gap; the pacing
# knob and any anticipatory pre-stretch stay the operator's call (spend behaviour, not autonomous).
burden_state() { # prints "trend r1h prior1h mult branch" — report-only, no side effect
  local mult r1 r0 out c1 c2 trend branch
  mult="$(burn_mult)"
  c1="$(date -u -d '1 hour ago'  +%Y-%m-%dT%H:%MZ 2>/dev/null)"   # last-1h window opens here
  c2="$(date -u -d '2 hours ago' +%Y-%m-%dT%H:%MZ 2>/dev/null)"   # prior-1h window opens here
  # PAID turns ($5==anthropic) binned by the fixed-width ISO ts (lexical compare = chronological, no
  # mktime/TZ dance): [c1,now]=recent hour, [c2,c1)=prior hour. Missing log → 0 0 (honest, never faked).
  out="$(awk -v c1="$c1" -v c2="$c2" '$5=="anthropic"{ if($1>=c1)a++; else if($1>=c2)b++ } END{printf "%d %d", a+0, b+0}' "$SPEND_LOG" 2>/dev/null)"
  read -r r1 r0 <<<"$out"; r1="${r1:-0}"; r0="${r0:-0}"
  if   [ "$r1" -gt "$r0" ]; then trend=RISING
  elif [ "$r1" -lt "$r0" ]; then trend=FALLING
  else trend=STEADY; fi
  # The memoryless gain LAGS the trend in both directions: RISING while gain is still slack (<1.5x) is
  # the recovery-risk branch (will stretch late); FALLING while gain is still stretched (>1x) over-holds.
  if   [ "$trend" = RISING ]  && awk "BEGIN{exit !($mult < 1.5)}"; then branch="recovery-risk"
  elif [ "$trend" = FALLING ] && awk "BEGIN{exit !($mult > 1)}";   then branch="over-hold"
  else branch="matched"; fi
  printf '%s %s %s %s %s' "$trend" "$r1" "$r0" "$mult" "$branch"
}

burden_line() { # human one-liner over burden_state
  local bs trend r1 r0 mult branch human
  bs="$(burden_state)"; read -r trend r1 r0 mult branch <<<"$bs"
  case "$branch" in
    recovery-risk) human="burn climbing but gain still slack — memoryless staircase will stretch LATE (Ziegler's expensive recovery branch); a trend-anticipatory pre-stretch would cost less" ;;
    over-hold)     human="burn receding but gain still stretched — defending a disturbance already leaving" ;;
    *)             human="gain tracks the trend" ;;
  esac
  printf 'control-burden: paid r1h=%s prior1h=%s trend=%s gain=%sx — %s: %s\n' "$r1" "$r0" "$trend" "$mult" "$branch" "$human"
}

# BUDGET VIABILITY PORTRAIT / MORTALITY MANIFOLD (McShaffrey & Beer, "Viability Space Decomposition",
# arXiv:2605.16753, 2026 — the autopoiesis/viability-constraint lineage: an agent bounded to a viability
# region is an EXTENDED dynamical system where TRANSIENT dynamics can lead to death, so a level check
# ["are we in-bounds NOW"] and a CSD early-warning ["approaching a bifurcation"] are both insufficient —
# you must decompose the state space by SURVIVAL OUTCOME, and the new object is the MORTALITY MANIFOLD:
# the surface past which death is already COMMITTED even though no constraint is yet violated).
#
# The $-cap is exactly such a bounded viability region. mesh-pace already reads its two ENDPOINTS —
# over_budget() = the OVER region (spent>=cap; already dead) and burden_state() = the TREND direction
# (RISING/FALLING, memoryless, no projection). Neither reads the region BETWEEN them: green now, cap not
# yet hit, but the transient (current $-burn) crosses the cap before the sole corrective (dispatch HOLD)
# can take effect. That committed-in-transient region is the mortality manifold, and it was blind.
#
# runway_state projects it. It samples $-spend over time (persisted, two-sample rate like the OOM-ramp
# guard) and classifies the budget viability portrait. REPORT-ONLY: it NEVER changes eff_gap or the gate
# (the pacing knob + any anticipatory pre-hold stay the operator's call — spend behaviour, like --burden).
#   HEADROOM     eta beyond the 5h window — rolling relief keeps spend under the cap; viable.
#   RECEDING     net burn <=0 — old spend ages off faster than new accrues; moving OFF the wall (viable).
#   APPROACHING  eta within the window but beyond the reaction budget — a HOLD now still averts the cap.
#   COMMITTED    eta <= reaction budget (MESH_PACE_REACT_S) — the HOLD cannot bite in time; the crossing
#                is unavoidable at this burn. THE MORTALITY MANIFOLD (distinct from OVER, which is death
#                already realized, and from APPROACHING, where control authority still suffices).
#   OVER         spent>=cap — already in the OVER region (== over_budget; not a manifold read).
#   UNKNOWN      no cap armed / unreadable spend / no usable prior sample / inter-sample interval too
#                short to be a rate (MESH_PACE_RUNWAY_MIN_DT, default 120s) — honest, NEVER a fake alarm.
# The min-interval guard keeps a too-young baseline instead of resampling, so rapid back-to-back calls
# can't manufacture an inflated $/h from a sub-second dt; a real rate emerges once MIN_DT has elapsed.
_fmt_eta() { # seconds -> human eta; "inf"/nonpositive -> ∞ / 0m
  case "$1" in inf) echo "∞"; return;; esac
  awk -v s="$1" 'BEGIN{ if(s+0<=0){print "0m"; exit} if(s<3600) printf "%dm",(s+30)/60; else printf "%.1fh",s/3600 }'
}
runway_state() { # prints "class eta_s spent cap burn_ph" — report-only; persists a sample for the next call
  local j cap spent wh react prev pts pspent dt burn eta win sf
  react="${MESH_PACE_REACT_S:-300}"
  # budget figures: overrides win (hermetic --test), else the labour ledger (same journal over_budget reads).
  cap="${MESH_PACE_CAP_OVERRIDE:-}"; spent="${MESH_PACE_SPENT_OVERRIDE:-}"; wh="${MESH_PACE_WINDOW_H_OVERRIDE:-}"
  if [ -z "$cap" ] || [ -z "$spent" ] || [ -z "$wh" ]; then
    j="$(timeout 20 mesh-labor --json 2>/dev/null)" || j=""   # 12.2s real read; 6s was blind (see over_budget)
    [ -n "$cap" ]   || cap="$(printf '%s' "$j"   | grep -oE '"cap":[0-9.]+'      | grep -oE '[0-9.]+' | head -1)"
    [ -n "$spent" ] || spent="$(printf '%s' "$j" | grep -oE '"spent":[0-9.]+'    | grep -oE '[0-9.]+' | head -1)"
    [ -n "$wh" ]    || wh="$(printf '%s' "$j"    | grep -oE '"window_h":[0-9.]+' | grep -oE '[0-9.]+' | head -1)"
  fi
  wh="${wh:-5}"
  # no cap armed or unreadable spend → UNKNOWN (fail-safe: never a fake all-clear, never a fake alarm)
  if [ -z "$cap" ] || [ -z "$spent" ] || awk "BEGIN{exit !($cap<=0)}"; then printf 'UNKNOWN 0 %s %s 0' "${spent:-?}" "${cap:-?}"; return; fi
  # already over the cap → the OVER region (death realized; == over_budget, not a manifold projection)
  if awk "BEGIN{exit !($spent>=$cap)}"; then printf 'OVER 0 %s %s 0' "$spent" "$cap"; return; fi
  sf="${MESH_PACE_RUNWAY_STATE:-$DIR/runway.state}"
  local min_dt; min_dt="${MESH_PACE_RUNWAY_MIN_DT:-120}"   # a rate over <this many seconds is noise, not a rate
  prev="${MESH_PACE_RUNWAY_PREV:-$(cat "$sf" 2>/dev/null)}"
  read -r pts pspent <<<"$prev"
  if [ -n "$pts" ] && [ -n "$pspent" ] && [ "$pts" -lt "$now" ] 2>/dev/null; then dt=$((now - pts)); else dt=-1; fi
  # LIVE-file path only: refresh the persisted baseline when there's none yet, or when it's old enough to
  # have yielded a stable rate — but KEEP a too-young baseline so a later call gets a real interval (else
  # rapid back-to-back calls would each resample a sub-second dt and manufacture a wildly inflated $/h).
  # An injected PREV (hermetic --test) never touches the file.
  if [ -z "${MESH_PACE_RUNWAY_PREV:-}" ] && { [ "$dt" -lt 0 ] || [ "$dt" -ge "$min_dt" ]; }; then
    printf '%s %s\n' "$now" "$spent" > "$sf" 2>/dev/null || true
  fi
  # no usable prior → can't derive a rate → UNKNOWN (honest, no projection)
  [ "$dt" -ge 0 ] || { printf 'UNKNOWN 0 %s %s 0' "$spent" "$cap"; return; }
  # interval too short for a stable rate → UNKNOWN (the sub-minute-noise guard)
  [ "$dt" -ge "$min_dt" ] || { printf 'UNKNOWN 0 %s %s 0' "$spent" "$cap"; return; }
  # a prior older than the rolling window is not a CURRENT rate → UNKNOWN
  awk "BEGIN{exit !($dt > $wh*3600)}" && { printf 'UNKNOWN 0 %s %s 0' "$spent" "$cap"; return; }
  burn="$(awk "BEGIN{printf \"%.4f\", ($spent-$pspent)/($dt/3600.0)}")"   # net $-burn per hour
  # net burn <=0 → rolling relief exceeds new spend; moving OFF the wall (RECEDING/viable, eta=∞)
  if awk "BEGIN{exit !($burn<=0)}"; then printf 'RECEDING inf %s %s %s' "$spent" "$cap" "$burn"; return; fi
  eta="$(awk "BEGIN{printf \"%.0f\", ($cap-$spent)/$burn*3600}")"         # seconds to cap at current burn
  win="$(awk "BEGIN{printf \"%.0f\", $wh*3600}")"
  if   [ "$eta" -le "$react" ]; then printf 'COMMITTED %s %s %s %s'   "$eta" "$spent" "$cap" "$burn"
  elif [ "$eta" -le "$win" ];   then printf 'APPROACHING %s %s %s %s' "$eta" "$spent" "$cap" "$burn"
  else printf 'HEADROOM %s %s %s %s' "$eta" "$spent" "$cap" "$burn"; fi
}
runway_line() { # human one-liner over runway_state — report-only
  local rs class eta spent cap burn human react
  react="${MESH_PACE_REACT_S:-300}"
  rs="$(runway_state)"; read -r class eta spent cap burn <<<"$rs"
  case "$class" in
    COMMITTED)   human="point of no return CROSSED — at \$$burn/h the cap is hit in $(_fmt_eta "$eta"), sooner than a dispatch HOLD can bite (react ${react}s); holding now cannot avert it (mortality manifold)" ;;
    APPROACHING) human="on course for the cap in $(_fmt_eta "$eta") at \$$burn/h — a HOLD now still averts it" ;;
    HEADROOM)    human="cap $(_fmt_eta "$eta") off at \$$burn/h, beyond the window — rolling relief keeps spend under it" ;;
    RECEDING)    human="net burn \$$burn/h ≤ 0 — spend receding off the cap, moving off the wall" ;;
    OVER)        human="already at/over the \$$cap cap — HOLD active (the OVER region, not a manifold read)" ;;
    *)           human="budget rate not yet derivable (no cap armed, unreadable spend, or no prior sample) — UNKNOWN, no alarm" ;;
  esac
  printf 'budget-runway: spent=$%s cap=$%s burn=$%s/h eta=%s class=%s — %s\n' "$spent" "$cap" "$burn" "$(_fmt_eta "$eta")" "$class" "$human"
}

# ── ANTAGONISTIC CONTROLLER PAIR: CONTROL MODE, SETPOINT SEPARATION, METASTABLE SWITCHING ──
# LITERATURE (homeostasis/allostasis/ultrastability — cross-domain transfer to a sensor mesh, 2026-08-04,
# genome mind). LIVE source: Ruoff HP, "Flux organizations and control modes in antagonistically combined
# negative feedback loops", bioRxiv 2025.11.09.687434 (v1 2025-11-10, v2; Univ. of Stavanger, CC0) —
# retrieved via the bioRxiv details API. Foundation it builds on: Drengstig T, Jolma IW, Ni XY, Thorsen K,
# Xu XM, Ruoff P, "A Basic Set of Homeostatic Controller Motifs", Biophys J 103(9):2000-2010, 2012,
# doi 10.1016/j.bpj.2012.09.033 (PMC3491718).
#
# CONCEPT (Ruoff 2025, from the abstract + highlights): when TWO ANTAGONISTIC integral controllers act on
# the SAME controlled variable — one INFLOW (adds), one OUTFLOW (removes), the insulin/glucagon arrangement
# — "dependent on the controllers relative setpoints two types of compensatory flux regulations occur,
# which have been termed DELEGATED and ISOLATED control." In delegated control one feedback submits its
# entire compensatory flux and the other is the actual controller, neutralizing the excess; in isolated
# control one controller's flux is negligible and the other regulates alone. A THIRD mode is METASTABLE
# control: "additions or removals of the controller variable can cause a SWITCH to the antagonistic
# partner's control regime, but resets to its original control mode once additions or removals stop." The
# load-bearing parameter throughout is the SEPARATION between the two setpoints — the 2012 antagonistic-pair
# result requires Aset_in < Aset_out, and it is that gap which decides which mode you land in.
#
# WHERE THIS TOOL STOPS SHORT: mesh-pace IS an antagonistic pair and does not know it. eff_gap (:172) has
# TWO opposed branches on one controlled variable (paid burn/h): the COLD branch SHRINKS the gap to MIN_GAP
# (60s) — an INFLOW controller, it ADDS work-creation flux — and the HOT branch STRETCHES the base by
# burn_mult (:87) — an OUTFLOW controller, it REMOVES flux. Their setpoints are COLD_BELOW (burn<7 → cold)
# and burn_mult's first step (burn>=7 → 1.5x). Those are the SAME NUMBER: separation = 0. The header
# comment at :43-45 states the coincidence as a FEATURE ("cold ends exactly where stretch begins — no
# flat-base band survives between them"); Ruoff's result says a zero-separation antagonistic pair is
# precisely the metastable-prone configuration — there is no dead band in which either controller can hold
# delegated control, so every crossing of 7/h hands the variable to the antagonist. And the handover here
# is not gentle: at the boundary the controller output jumps MIN_GAP=60s ↔ GAP*1.5=27000s, a ~450x
# discontinuity in released cadence at a single threshold with zero hysteresis. Nothing measured this.
# DISTINCT from the two reads already on this file: --burden (Ziegler) reads the TREND vs the gain's lag
# (one memoryless staircase, is it early or late); --runway (McShaffrey & Beer) projects the $-transient
# against the cap. Neither asks WHICH of the two antagonistic branches is in control, whether control is
# being handed back and forth, or how far apart their setpoints are. Also NOT mesh-homeostasis's
# ULTRASTABLE-EXHAUSTED (same fix re-fired K times) nor regulator_verified (was the loop ever proven live)
# — this is the mode of a PAIR, a question a single-controller homeostat cannot pose.
#
# WHAT THIS SHIPS: the MEASUREMENT half only, report-only, like --burden and --runway. It reconstructs the
# governor's OWN input (paid burn/h = paid turns in the trailing RATE_H window / RATE_H, the same quantity
# paid_burn_per_h reads from the labour ledger) at fixed steps over the recent span FROM spend.log, labels
# each sample COLD/HOT by the live COLD_BELOW setpoint, and counts REGIME CROSSINGS. Honest limits: this is
# a RECONSTRUCTION from the turn tape, not a recording of what eff_gap actually returned (the governor keeps
# no such history) — a sample is what the cold/hot split WOULD have been on that tape; and a thin/absent
# tape renders UNKNOWN, never a fake ISOLATED. The FIX (separate the two setpoints — give the pair a dead
# band / hysteresis so a burn hovering at 7/h stops swinging the cadence 450x) is a SPEND-BEHAVIOUR change
# and stays the operator's call, exactly as the pacing knob and the anticipatory pre-stretch do.
CM_HOURS="${MESH_PACE_CM_HOURS:-24}"        # span of history to classify
CM_STEP_S="${MESH_PACE_CM_STEP_S:-900}"     # sampling step within the span
CM_RATE_H="${MESH_PACE_CM_RATE_H:-5}"       # trailing window the burn RATE is taken over (the 5h paid window)
CM_MIN_SAMPLES="${MESH_PACE_CM_MIN_SAMPLES:-8}"  # below this, UNKNOWN — never classify off a stub
CM_META="${MESH_PACE_CM_META:-3}"           # >=this many handovers in the span = METASTABLE chatter

control_mode_state() { # prints "class crossings samples regime_now cold_sp hot_sp sep gain_lo gain_hi"
  local cold_sp hot_sp sep gain_lo gain_hi
  cold_sp="$COLD_BELOW"; hot_sp="$COLD_BELOW"   # burn<COLD_BELOW = cold branch; burn>=COLD_BELOW = first hot step
  sep=$((hot_sp - cold_sp))
  gain_lo="$MIN_GAP"
  gain_hi="$(awk -v g="$GAP" 'BEGIN{printf "%d", g*1.5}')"   # base x burn_mult's FIRST hot step
  # reserve off → eff_gap returns the flat base and NEITHER branch exists; there is no pair to be in a mode.
  if [ "$RESERVE" != 1 ]; then
    printf 'DISABLED 0 0 na %s %s %s %s %s' "$cold_sp" "$hot_sp" "$sep" "$gain_lo" "$gain_hi"; return
  fi
  # Sample boundaries as ISO minute strings (lexical compare = chronological, the same idiom burden_state
  # uses — no mktime, so this works under mawk too). printf's %()T is a bash BUILTIN: no fork per sample.
  local -a lo hi
  local e t n i
  n=0
  for (( e = now - CM_HOURS*3600; e <= now; e += CM_STEP_S )); do
    TZ=UTC printf -v t '%(%Y-%m-%dT%H:%MZ)T' "$e";                    hi[n]="$t"
    TZ=UTC printf -v t '%(%Y-%m-%dT%H:%MZ)T' "$((e - CM_RATE_H*3600))"; lo[n]="$t"
    n=$((n+1))
  done
  [ "$n" -ge "$CM_MIN_SAMPLES" ] || { printf 'UNKNOWN 0 %s na %s %s %s %s %s' "$n" "$cold_sp" "$hot_sp" "$sep" "$gain_lo" "$gain_hi"; return; }
  # One awk pass: count PAID turns ($5==anthropic) falling in each (lo,hi] sample window, divide by RATE_H
  # to get the same burn/h paid_burn_per_h reports (integer truncation, as awk's %d there does), split at
  # COLD_BELOW, and count adjacent-sample regime CHANGES. Missing/empty tape → 0 usable samples → UNKNOWN.
  local out cls cr rn
  out="$(awk -v N="$n" -v LOS="$(IFS=,; echo "${lo[*]}")" -v HIS="$(IFS=,; echo "${hi[*]}")" \
             -v RH="$CM_RATE_H" -v SP="$COLD_BELOW" '
    BEGIN{ split(LOS,L,","); split(HIS,H,","); rows=0 }
    $5=="anthropic"{ rows++; for(i=1;i<=N;i++) if($1>L[i] && $1<=H[i]) c[i]++ }
    END{
      if(rows==0){ print "NOTAPE 0 na"; exit }
      cross=0; prev=""
      for(i=1;i<=N;i++){
        burn=int((c[i]+0)/RH)
        r=(burn<SP)?"COLD":"HOT"
        if(prev!="" && r!=prev) cross++
        prev=r
      }
      print cross" "N" "prev
    }' "$SPEND_LOG" 2>/dev/null)"
  # awk prints "cross N regime"; the NOTAPE sentinel comes back as "NOTAPE 0 na".
  set -- $out; cr="${1:-}"; rn="${3:-na}"
  case "$cr" in
    NOTAPE|''|*[!0-9]*) printf 'UNKNOWN 0 0 na %s %s %s %s %s' "$cold_sp" "$hot_sp" "$sep" "$gain_lo" "$gain_hi"; return ;;
  esac
  if   [ "$cr" -ge "$CM_META" ]; then cls=METASTABLE
  elif [ "$cr" -gt 0 ];          then cls=SWITCHING
  elif [ "$rn" = HOT ];          then cls=ISOLATED-HOT
  else                                cls=ISOLATED-COLD; fi
  printf '%s %s %s %s %s %s %s %s %s' "$cls" "$cr" "$n" "$rn" "$cold_sp" "$hot_sp" "$sep" "$gain_lo" "$gain_hi"
}

control_mode_line() { # human one-liner over control_mode_state — report-only
  local cs cls cr ns rn csp hsp sep glo ghi ratio human
  cs="$(control_mode_state)"; read -r cls cr ns rn csp hsp sep glo ghi <<<"$cs"
  ratio="$(awk -v a="$ghi" -v b="$glo" 'BEGIN{ if(b+0>0) printf "%.0f", a/b; else printf "?" }')"
  case "$cls" in
    METASTABLE)   human="the antagonistic pair is handing control back and forth ($cr handovers in ${CM_HOURS}h) with setpoint separation ${sep}/h — no dead band, so each crossing of ${csp}/h swings released cadence ${glo}s↔${ghi}s (${ratio}x). Ruoff's metastable regime; a hysteresis gap between the cold and hot setpoints is the named remedy (operator's call — spend behaviour)" ;;
    SWITCHING)    human="$cr regime handover(s) in ${CM_HOURS}h — a real burn transition, not yet chatter; watch it against the ${ratio}x cadence discontinuity at ${csp}/h" ;;
    ISOLATED-HOT) human="the OUTFLOW branch (stretch) regulated alone all span — the cold/inflow branch's flux was negligible (Ruoff's isolated control)" ;;
    ISOLATED-COLD) human="the INFLOW branch (cold-shrink to MIN_GAP) regulated alone all span — the hot/outflow branch never engaged (Ruoff's isolated control)" ;;
    DISABLED)     human="MESH_PACE_RESERVE=0 — eff_gap returns the flat base, neither branch exists, so there is no antagonistic pair to be in a mode" ;;
    *)            human="not enough paid-turn tape in the span to reconstruct the burn regimes — UNKNOWN, no claim" ;;
  esac
  printf 'control-mode: %s · crossings=%s/%s samples · now=%s · setpoints cold<%s/h hot>=%s/h sep=%s/h · gain %ss↔%ss — %s\n' \
    "$cls" "$cr" "$ns" "$rn" "$csp" "$hsp" "$sep" "$glo" "$ghi" "$human"
}

case "${1:-}" in
  --test)
    command -v awk >/dev/null 2>&1 || { echo "smoke-test: FAIL (no awk)"; exit 1; }
    # TRAP-CLEAN the smoke keys: a fresh-key gate call RECORDS state (echo now > file) BEFORE the test's
    # own rm; if the run is KILLED between the two (mesh-doctor gates every --test at timeout 12, and this
    # suite is spawned from a cron watchdog), that key LEAKS. 104 such `__smoke_<pid>`/`__smoke_chk_<pid>`
    # keys had piled up in ~/.mesh/pace since 07-15 — a fossil of every timed-out run. Clean our own keys
    # on ANY exit path, including SIGTERM (timeout's default kill) and INT, so no aborted run can litter.
    _smoke_cleanup() { rm -f "$DIR"/__smoke_$$ "$DIR"/__smoke_*_$$ 2>/dev/null; }
    trap _smoke_cleanup EXIT
    trap '_smoke_cleanup; exit 143' TERM INT
    # Isolate the gap-logic assertions from LIVE budget: default the whole suite to under-cap, so a
    # real over-budget window (which SHOULD hold every lane) can't fail the fresh-key-passes tests.
    # The HARD $-cap assertions below re-set this to over/under explicitly per invocation.
    export MESH_PACE_BUDGET_OVERRIDE=under
    # Isolate from the LIVE meter too: the real-gate calls below (fresh-key pass/hold, --check read-only)
    # don't override burn, so each would spawn `mesh-labor --json` — a ~12s hledger read (2026-07-31) —
    # inside eff_gap. Five such calls = ~60s, which is why the whole suite ran 60-95s and NEVER fit inside
    # mesh-doctor's 12s --test window (so the spend governor's own gate went unassessed every hourly pass).
    # UNKNOWN(-1) keeps eff_gap's mult at 1 (no cold-shrink, no stretch), so every record/age assertion
    # holds identically — burn is not what these tests probe. The burn-SPECIFIC tests below (cold-shrink,
    # hot-stretch, burden trend) set MESH_PACE_BURN_OVERRIDE explicitly per-invocation and still win.
    export MESH_PACE_BURN_OVERRIDE=-1
    k="__smoke_$$"; rm -f "$DIR/$k"
    if ! "$0" "$k" 1 >/dev/null 2>&1; then echo "smoke-test: FAIL (first call should pass)"; exit 1; fi
    if "$0" "$k" 999999 >/dev/null 2>&1; then echo "smoke-test: FAIL (second call should be gated)"; rm -f "$DIR/$k"; exit 1; fi
    rm -f "$DIR/$k"
    # --check: the READ-ONLY probe (chat-review/dispatch-exposure-ticks-on-pace-skipped-passes) —
    # answers "would the gate hold right now" WITHOUT consuming the gap (exit-0 on the real gate
    # RECORDS now, so a caller that only wants to know would burn the reserve by asking).
    k2="__smoke_chk_$$"; rm -f "$DIR/$k2"
    "$0" --check "$k2" 999999 >/dev/null 2>&1 || { echo "smoke-test: FAIL (--check on a fresh key should report would-pass)"; rm -f "$DIR/$k2"; exit 1; }
    [ -f "$DIR/$k2" ] && { echo "smoke-test: FAIL (--check recorded state — it must be read-only)"; rm -f "$DIR/$k2"; exit 1; }
    "$0" "$k2" 1 >/dev/null 2>&1   # real gate records now
    "$0" --check "$k2" 999999 >/dev/null 2>&1 && { echo "smoke-test: FAIL (--check should report would-hold on a fresh record)"; rm -f "$DIR/$k2"; exit 1; }
    rm -f "$DIR/$k2"
    # COLD-SHRINK / HOT-STRETCH (operator 2026-07-24: диспатч событийный — a cold window must release
    # the slot in ~MIN_GAP, not the flat base, so the fsnotify board event wakes the owner NOW; a hot
    # window still stretches to protect the reserve). Drive the burn deterministically via the override.
    # RED before the cold-shrink existed: eff-gap of a big base returned the flat base regardless of burn.
    eg_cold="$(MESH_PACE_BURN_OVERRIDE=0  MESH_PACE_RESERVE=1 "$0" --eff-gap 18000)"
    [ "$eg_cold" = "$MIN_GAP" ] || { echo "smoke-test: FAIL (cold burn must floor eff-gap to MIN_GAP=$MIN_GAP, got $eg_cold)"; exit 1; }
    eg_hot="$(MESH_PACE_BURN_OVERRIDE=20 MESH_PACE_RESERVE=1 "$0" --eff-gap 18000)"
    [ "$eg_hot" = 54000 ] || { echo "smoke-test: FAIL (hot burn 20/h must stretch 18000x3=54000, got $eg_hot)"; exit 1; }
    eg_unk="$(MESH_PACE_BURN_OVERRIDE=-1 MESH_PACE_RESERVE=1 "$0" --eff-gap 18000)"
    [ "$eg_unk" = 18000 ] || { echo "smoke-test: FAIL (unknown burn must fall back to the gentle base 18000, got $eg_unk)"; exit 1; }
    # BEHAVIOURAL: a key last-passed MIN_GAP+1s ago is RELEASED when cold but still HELD when hot —
    # the operator's "released-slot by event, not by cron poll" made falsifiable. Old flat gap held both.
    k3="__smoke_cold_$$"; echo "$((now - (MIN_GAP + 1)))" > "$DIR/$k3"
    MESH_PACE_BURN_OVERRIDE=0  MESH_PACE_RESERVE=1 "$0" --check "$k3" 18000 >/dev/null 2>&1 || { echo "smoke-test: FAIL (cold: a slot idle >MIN_GAP must be RELEASED, not held to the base gap)"; rm -f "$DIR/$k3"; exit 1; }
    MESH_PACE_BURN_OVERRIDE=20 MESH_PACE_RESERVE=1 "$0" --check "$k3" 18000 >/dev/null 2>&1 && { echo "smoke-test: FAIL (hot: same slot must still HOLD to protect the reserve)"; rm -f "$DIR/$k3"; exit 1; }
    rm -f "$DIR/$k3"
    # HARD $ CAP (operator 2026-07-27 "траты >$100/5ч → минды спят"): over the rolling-5h cap EVERY
    # paced lane holds — even a fresh key whose gap has fully elapsed — and the hold does NOT record
    # state (so it re-evaluates every tick and auto-resumes when the window recovers). Budget state
    # driven hermetically via MESH_PACE_BUDGET_OVERRIDE. RED before the fix: a fresh key passed regardless.
    k4="__smoke_cap_$$"; rm -f "$DIR/$k4"
    MESH_PACE_GAP=900 MESH_PACE_BUDGET_OVERRIDE=over  "$0" "$k4" 1 >/dev/null 2>&1 && { echo "smoke-test: FAIL (over cap: a fresh key must HOLD, not pass)"; rm -f "$DIR/$k4"; exit 1; }
    [ -f "$DIR/$k4" ] && { echo "smoke-test: FAIL (over-cap hold must NOT record state)"; rm -f "$DIR/$k4"; exit 1; }
    MESH_PACE_GAP=900 MESH_PACE_BUDGET_OVERRIDE=under "$0" "$k4" 1 >/dev/null 2>&1 || { echo "smoke-test: FAIL (under cap: a fresh key must pass normally)"; rm -f "$DIR/$k4"; exit 1; }
    rm -f "$DIR/$k4"
    # --check must mirror the hold so mesh-dispatch's read-only probe agrees with the real gate.
    k5="__smoke_capchk_$$"; rm -f "$DIR/$k5"
    MESH_PACE_GAP=900 MESH_PACE_BUDGET_OVERRIDE=over  "$0" --check "$k5" 1 >/dev/null 2>&1 && { echo "smoke-test: FAIL (over cap: --check must report would-hold)"; rm -f "$DIR/$k5"; exit 1; }
    MESH_PACE_GAP=900 MESH_PACE_BUDGET_OVERRIDE=under "$0" --check "$k5" 1 >/dev/null 2>&1 || { echo "smoke-test: FAIL (under cap: --check must report would-pass)"; rm -f "$DIR/$k5"; exit 1; }
    rm -f "$DIR/$k5"
    # CONTROL-BURDEN TREND (Ziegler 2026) — hermetic: a synthetic spend.log + a burn override so the
    # gain (mult) is deterministic. RED before the trend read: nothing distinguished a climbing from a
    # receding window; the memoryless staircase reported the SAME gain for both.
    _n="$(date -u +%s)"
    _bl_up="$(mktemp)"     # 3 paid turns in the last hour, 1 in the prior hour → RISING
    for _m in 5 20 40; do printf '%s turn genome claude anthropic paid x\n' "$(date -u -d "@$((_n-_m*60))" +%Y-%m-%dT%H:%MZ)"; done >>"$_bl_up"
    printf '%s turn genome claude anthropic paid x\n' "$(date -u -d "@$((_n-90*60))" +%Y-%m-%dT%H:%MZ)" >>"$_bl_up"
    _bs="$(SPEND_LOG="$_bl_up" MESH_PACE_BURN_OVERRIDE=2 MESH_PACE_RESERVE=1 burden_state)"
    read -r _tr _r1 _r0 _mu _br <<<"$_bs"
    [ "$_tr" = RISING ]        || { echo "smoke-test: FAIL (burden: 3-in-1h vs 1-prior must read RISING, got '$_bs')"; rm -f "$_bl_up"; exit 1; }
    [ "$_br" = recovery-risk ] || { echo "smoke-test: FAIL (burden: RISING with slack gain=${_mu}x must be recovery-risk, got '$_bs')"; rm -f "$_bl_up"; exit 1; }
    _bl_dn="$(mktemp)"     # 1 paid turn in the last hour, 4 in the prior hour → FALLING
    printf '%s turn genome claude anthropic paid x\n' "$(date -u -d "@$((_n-40*60))" +%Y-%m-%dT%H:%MZ)" >>"$_bl_dn"
    for _m in 70 80 90 100; do printf '%s turn genome claude anthropic paid x\n' "$(date -u -d "@$((_n-_m*60))" +%Y-%m-%dT%H:%MZ)"; done >>"$_bl_dn"
    _bs2="$(SPEND_LOG="$_bl_dn" MESH_PACE_BURN_OVERRIDE=20 MESH_PACE_RESERVE=1 burden_state)"
    read -r _tr2 _x _y _mu2 _br2 <<<"$_bs2"
    [ "$_tr2" = FALLING ]  || { echo "smoke-test: FAIL (burden: 1-in-1h vs 4-prior must read FALLING, got '$_bs2')"; rm -f "$_bl_up" "$_bl_dn"; exit 1; }
    [ "$_br2" = over-hold ] || { echo "smoke-test: FAIL (burden: FALLING with stretched gain=${_mu2}x must be over-hold, got '$_bs2')"; rm -f "$_bl_up" "$_bl_dn"; exit 1; }
    # opencode (free) turns must NOT count as paid burn: a log of only opencode reads 0/0 → STEADY
    _bl_free="$(mktemp)"
    for _m in 5 20 40; do printf '%s turn health opencode opencode paid x\n' "$(date -u -d "@$((_n-_m*60))" +%Y-%m-%dT%H:%MZ)"; done >>"$_bl_free"
    _bs3="$(SPEND_LOG="$_bl_free" MESH_PACE_BURN_OVERRIDE=2 MESH_PACE_RESERVE=1 burden_state)"
    read -r _tr3 _u _v _w _z <<<"$_bs3"
    [ "$_tr3" = STEADY ] || { echo "smoke-test: FAIL (burden: free/opencode turns must not count as paid burn, got '$_bs3')"; rm -f "$_bl_up" "$_bl_dn" "$_bl_free"; exit 1; }
    rm -f "$_bl_up" "$_bl_dn" "$_bl_free"
    # BUDGET VIABILITY PORTRAIT / MORTALITY MANIFOLD (McShaffrey & Beer 2026) — hermetic: drive spent/cap/
    # window via overrides + inject the prior sample so the $-burn (and thus eta) is deterministic. The
    # RED-first witness for the mortality-manifold DISTINCTION is the COMMITTED vs APPROACHING split at the
    # react threshold: collapse the `eta<=react → COMMITTED` branch into APPROACHING and leg (r) goes RED —
    # the whole point of the axis (past the manifold a HOLD can't avert) vanishes and every crossing reads
    # as still-avertable. State file is a temp so the live runway.state is never touched by --test.
    _rst="$(mktemp)"; rm -f "$_rst"   # empty: exercises the no-prior UNKNOWN path
    _rw() { MESH_PACE_RUNWAY_STATE="$_rst" MESH_PACE_CAP_OVERRIDE="$1" MESH_PACE_SPENT_OVERRIDE="$2" \
            MESH_PACE_WINDOW_H_OVERRIDE=5 MESH_PACE_RUNWAY_PREV="$3" MESH_PACE_REACT_S=300 runway_state | awk '{print $1}'; }
    # (r) COMMITTED: spent 99/100, +9$ over the last 300s → 108$/h → eta ~33s ≤ react 300 → past the manifold
    _c="$(_rw 100 99 "$((now-300)) 90")"
    [ "$_c" = COMMITTED ] || { echo "smoke-test: FAIL (runway: eta≤react must read COMMITTED/mortality-manifold, got '$_c')"; rm -f "$_rst"; exit 1; }
    # (s) APPROACHING: spent 95/100, +3$ over the last hour → 3$/h → eta 6000s (react<eta<5h window) → avertable
    _a="$(_rw 100 95 "$((now-3600)) 92")"
    [ "$_a" = APPROACHING ] || { echo "smoke-test: FAIL (runway: react<eta<window must read APPROACHING, got '$_a')"; rm -f "$_rst"; exit 1; }
    # (t) HEADROOM: spent 50/100, +1$/h → eta 50h ≫ window → rolling relief keeps it under
    _h="$(_rw 100 50 "$((now-3600)) 49")"
    [ "$_h" = HEADROOM ] || { echo "smoke-test: FAIL (runway: eta≫window must read HEADROOM, got '$_h')"; rm -f "$_rst"; exit 1; }
    # (u) RECEDING: spent fell 60→50 → net burn <0 → moving off the wall
    _rc="$(_rw 100 50 "$((now-3600)) 60")"
    [ "$_rc" = RECEDING ] || { echo "smoke-test: FAIL (runway: negative net burn must read RECEDING, got '$_rc')"; rm -f "$_rst"; exit 1; }
    # (v) OVER: spent≥cap → the OVER region
    _o="$(_rw 100 100 "$((now-60)) 90")"
    [ "$_o" = OVER ] || { echo "smoke-test: FAIL (runway: spent≥cap must read OVER, got '$_o')"; rm -f "$_rst"; exit 1; }
    # (w) UNKNOWN — no cap armed (cap 0): honest, never a fake alarm
    _u="$(_rw 0 50 "$((now-3600)) 40")"
    [ "$_u" = UNKNOWN ] || { echo "smoke-test: FAIL (runway: no cap armed must read UNKNOWN, got '$_u')"; rm -f "$_rst"; exit 1; }
    # (x) UNKNOWN — no prior sample (empty state, no injected PREV): can't derive a rate
    _un="$(MESH_PACE_RUNWAY_STATE="$_rst" MESH_PACE_CAP_OVERRIDE=100 MESH_PACE_SPENT_OVERRIDE=95 MESH_PACE_WINDOW_H_OVERRIDE=5 runway_state | awk '{print $1}')"
    [ "$_un" = UNKNOWN ] || { echo "smoke-test: FAIL (runway: no prior sample must read UNKNOWN, got '$_un')"; rm -f "$_rst"; exit 1; }
    # (y) UNKNOWN — prior too young (dt<MIN_DT): a sub-interval rate is noise, not a rate (would-be COMMITTED suppressed)
    _uy="$(_rw 100 99 "$((now-30)) 90")"
    [ "$_uy" = UNKNOWN ] || { echo "smoke-test: FAIL (runway: dt<MIN_DT must read UNKNOWN not a noisy rate, got '$_uy')"; rm -f "$_rst"; exit 1; }
    rm -f "$_rst"
    # GATE LEDGER (dev.to 3c648 @anp2network): every over_budget() decision books one hledger txn, so
    # "did the $-gate ever FAIL OPEN on cap<=0 or a stale/blind read" is a balance query not a source read.
    # Hermetic via MESH_PACE_METER_JSON_OVERRIDE (the classify+book path against an injected meter payload,
    # NOT the synthetic BUDGET_OVERRIDE which is deliberately never booked). RED-first: delete either the
    # book_gate calls in over_budget or the --gate-ledger tally and these assertions go red — an empty
    # journal reports 0 for every reason. The live journal is untouched: PACE_GATE_LOG points at a temp.
    _gl="$(mktemp)"; rm -f "$_gl"
    unset MESH_PACE_BUDGET_OVERRIDE   # the injected-meter path must run the REAL classify, not the synthetic short-circuit
    MESH_PACE_GATE_LOG="$_gl" MESH_PACE_METER_JSON_OVERRIDE='{"cap":100,"spent":150}' "$0" __smoke_gl_$$ 1 >/dev/null 2>&1 && { echo "smoke-test: FAIL (gate-ledger: spent>cap must HOLD)"; rm -f "$_gl" "$DIR/__smoke_gl_$$"; exit 1; }
    MESH_PACE_GATE_LOG="$_gl" MESH_PACE_METER_JSON_OVERRIDE='{"cap":100,"spent":50}'  "$0" __smoke_gl_$$ 1 >/dev/null 2>&1 || { echo "smoke-test: FAIL (gate-ledger: spent<cap must PASS)"; rm -f "$_gl" "$DIR/__smoke_gl_$$"; exit 1; }
    MESH_PACE_GATE_LOG="$_gl" MESH_PACE_METER_JSON_OVERRIDE='{"cap":0,"spent":50}'    "$0" __smoke_glf_$$ 1 >/dev/null 2>&1 || { echo "smoke-test: FAIL (gate-ledger: cap<=0 must FAIL-OPEN/pass)"; rm -f "$_gl" "$DIR"/__smoke_gl*_$$; exit 1; }
    MESH_PACE_GATE_LOG="$_gl" MESH_PACE_METER_JSON_OVERRIDE='{"garbage":1}'           "$0" __smoke_glp_$$ 1 >/dev/null 2>&1 || { echo "smoke-test: FAIL (gate-ledger: unparseable meter must FAIL-OPEN/pass)"; rm -f "$_gl" "$DIR"/__smoke_gl*_$$; exit 1; }
    rm -f "$DIR"/__smoke_gl*_$$
    grep -q 'gate:decision:over ' "$_gl"        || { echo "smoke-test: FAIL (gate-ledger: over decision not booked)"; rm -f "$_gl"; exit 1; }
    grep -q 'gate:decision:under ' "$_gl"       || { echo "smoke-test: FAIL (gate-ledger: under decision not booked)"; rm -f "$_gl"; exit 1; }
    grep -q 'gate:decision:nocap ' "$_gl"       || { echo "smoke-test: FAIL (gate-ledger: nocap fail-open not booked)"; rm -f "$_gl"; exit 1; }
    grep -q 'gate:decision:blind-parse ' "$_gl" || { echo "smoke-test: FAIL (gate-ledger: blind-parse fail-open not booked)"; rm -f "$_gl"; exit 1; }
    _fo="$(MESH_PACE_GATE_LOG="$_gl" "$0" --gate-ledger 2>/dev/null | grep 'fail-open' | grep -oE ': *[0-9]+' | head -1 | grep -oE '[0-9]+')"
    [ "${_fo:-x}" = 2 ] || { echo "smoke-test: FAIL (gate-ledger: --gate-ledger must tally the 2 fail-open decisions (nocap+blind-parse), got '${_fo:-<none>}')"; rm -f "$_gl"; exit 1; }
    if command -v hledger >/dev/null 2>&1; then
      hledger -f "$_gl" check >/dev/null 2>&1 || { echo "smoke-test: FAIL (gate-ledger: journal must pass hledger check — balanced double-entry)"; rm -f "$_gl"; exit 1; }
    fi
    rm -f "$_gl"
    # ANTAGONISTIC CONTROLLER PAIR / CONTROL MODE (Ruoff 2025) — hermetic: three synthetic turn tapes
    # drive the REAL control_mode_state (no override short-circuits its classifier; only the tape and the
    # span are injected, exactly as the --burden legs do). The three fixtures are the three modes the
    # literature distinguishes, and they must come apart:
    #   (a) 1 paid turn/h  → trailing-5h burn 1/h  → the COLD/inflow branch alone   → ISOLATED-COLD, 0 crossings
    #   (b) 10 paid turns/h → trailing-5h burn 10/h → the HOT/outflow branch alone   → ISOLATED-HOT,  0 crossings
    #   (c) 50-turn bursts at -23h/-15h/-7h → the trailing rate crosses 7/h up and back down three times
    #       → METASTABLE (>=CM_META handovers) — the regime the ZERO setpoint separation makes reachable.
    # RED-first witnesses (each run from a scratch copy, seen RED before this shipped):
    #   m1 crossing counter pinned to 0        → (c) reads ISOLATED-COLD → leg (c) RED
    #   m2 regime hardcoded HOT (burn ignored) → (a) reads ISOLATED-HOT  → leg (a) RED
    #   m3 classifier returns UNKNOWN always   → all three legs RED
    _cm_tape() { : >"$1"; local _e; for _e in $2; do TZ=UTC printf '%(%Y-%m-%dT%H:%MZ)T turn genome claude anthropic paid x\n' "$((now-_e))"; done >>"$1"; }
    _cm_secs=""; for _h in $(seq 0 30); do _cm_secs="$_cm_secs $((_h*3600))"; done          # (a) 1/h over 30h
    _cm_a="$(mktemp)"; _cm_tape "$_cm_a" "$_cm_secs"
    _cs="$(SPEND_LOG="$_cm_a" control_mode_state)"; read -r _cls _cr _ns _rn _ <<<"$_cs"
    [ "$_cls" = ISOLATED-COLD ] || { echo "smoke-test: FAIL (control-mode: 1 paid turn/h = burn 1/h must be the cold/inflow branch alone → ISOLATED-COLD, got '$_cs')"; rm -f "$_cm_a"; exit 1; }
    [ "$_cr" = 0 ] || { echo "smoke-test: FAIL (control-mode: a steady cold tape must show ZERO regime handovers, got '$_cs')"; rm -f "$_cm_a"; exit 1; }
    _cm_secs=""; for _h in $(seq 0 30); do for _i in 0 6 12 18 24 30 36 42 48 54; do _cm_secs="$_cm_secs $((_h*3600+_i*60))"; done; done   # (b) 10/h over 30h
    _cm_b="$(mktemp)"; _cm_tape "$_cm_b" "$_cm_secs"
    _cs2="$(SPEND_LOG="$_cm_b" control_mode_state)"; read -r _cls2 _cr2 _ <<<"$_cs2"
    [ "$_cls2" = ISOLATED-HOT ] || { echo "smoke-test: FAIL (control-mode: 10 paid turns/h = burn 10/h must be the hot/outflow branch alone → ISOLATED-HOT, got '$_cs2')"; rm -f "$_cm_a" "$_cm_b"; exit 1; }
    [ "$_cr2" = 0 ] || { echo "smoke-test: FAIL (control-mode: a steady hot tape must show ZERO regime handovers, got '$_cs2')"; rm -f "$_cm_a" "$_cm_b"; exit 1; }
    _cm_secs=""; for _b in 23 15 7; do for _i in $(seq 0 49); do _cm_secs="$_cm_secs $((_b*3600 - _i*36))"; done; done   # (c) 3 bursts of 50
    _cm_c="$(mktemp)"; _cm_tape "$_cm_c" "$_cm_secs"
    _cs3="$(SPEND_LOG="$_cm_c" control_mode_state)"; read -r _cls3 _cr3 _ <<<"$_cs3"
    [ "$_cls3" = METASTABLE ] || { echo "smoke-test: FAIL (control-mode: bursts crossing 7/h up-and-down must read METASTABLE, got '$_cs3')"; rm -f "$_cm_a" "$_cm_b" "$_cm_c"; exit 1; }
    [ "$_cr3" -ge "$CM_META" ] 2>/dev/null || { echo "smoke-test: FAIL (control-mode: METASTABLE needs >=$CM_META handovers, got '$_cs3')"; rm -f "$_cm_a" "$_cm_b" "$_cm_c"; exit 1; }
    # the two ISOLATED modes must not be the same verdict — a classifier that collapsed them would pass
    # both legs above only if it also lost the regime, so assert the split explicitly.
    [ "$_cls" != "$_cls2" ] || { echo "smoke-test: FAIL (control-mode: cold-alone and hot-alone must be DISTINCT modes)"; rm -f "$_cm_a" "$_cm_b" "$_cm_c"; exit 1; }
    # honest UNKNOWN: too few samples to classify (never a fake ISOLATED off a stub span)
    _cs4="$(SPEND_LOG="$_cm_b" CM_HOURS=1 control_mode_state)"; read -r _cls4 _ <<<"$_cs4"
    [ "$_cls4" = UNKNOWN ] || { echo "smoke-test: FAIL (control-mode: fewer than $CM_MIN_SAMPLES samples must render UNKNOWN, got '$_cs4')"; rm -f "$_cm_a" "$_cm_b" "$_cm_c"; exit 1; }
    # reserve off = no antagonistic pair exists at all (eff_gap returns the flat base) → DISABLED, not a mode
    _cs5="$(SPEND_LOG="$_cm_b" RESERVE=0 control_mode_state)"; read -r _cls5 _ <<<"$_cs5"
    [ "$_cls5" = DISABLED ] || { echo "smoke-test: FAIL (control-mode: RESERVE=0 has neither branch → DISABLED, got '$_cs5')"; rm -f "$_cm_a" "$_cm_b" "$_cm_c"; exit 1; }
    rm -f "$_cm_a" "$_cm_b" "$_cm_c"
    echo "smoke-test: ok (gate passes when stale, skips when fresh; --check read-only; cold-shrink→MIN_GAP=${MIN_GAP}s, hot-stretch, unknown→base; HARD \$-cap holds over-budget + auto-resumes; gate-ledger books over/under/nocap/blind-* per decision, --gate-ledger tallies fail-open; budget-runway COMMITTED/APPROACHING/HEADROOM/RECEDING/OVER/UNKNOWN portrait; control-mode splits ISOLATED-COLD/ISOLATED-HOT/METASTABLE + UNKNOWN/DISABLED on the antagonistic pair; GAP=${GAP}s reserve=${RESERVE})"
    exit 0 ;;

  --eff-gap)
    # debug/probe: print the effective gap for a base, given the current (or overridden) paid burn.
    # Used by --test and handy operationally to see whether the window is cold (→MIN_GAP) or hot.
    base="${2:-$GAP}"; eff_gap "$base"; exit 0 ;;

  --burden)
    # control-burden trend read (Ziegler 2026 hysteresis) — report-only, never changes pacing.
    burden_line; exit 0 ;;

  --runway)
    # budget viability portrait / mortality-manifold read (McShaffrey & Beer 2026) — report-only, never
    # changes pacing. Projects when the $-burn transient crosses the cap vs. when a HOLD can still avert it.
    runway_line; exit 0 ;;

  --control-mode)
    # antagonistic inflow/outflow controller-pair read (Ruoff 2025) — report-only, never changes pacing.
    # Which of the two opposed eff_gap branches is in control, and is control being handed back and forth.
    control_mode_line; exit 0 ;;

  --status)
    echo "mesh-pace · base GAP=${GAP}s reserve=${RESERVE} (mult=$(burn_mult)x) · as of $(date -u +%H:%MZ)"
    burden_line
    runway_line
    control_mode_line
    printf "  %-14s %8s %8s %8s  %s\n" key last_age eff_gap remain now
    shopt -s nullglob
    any=0
    for f in "$DIR"/*; do
      [ -f "$f" ] || continue
      k="$(basename "$f")"; [ "${k#__smoke}" = "$k" ] || continue
      last="$(cat "$f" 2>/dev/null || echo 0)"
      # DATA-SHAPE guard (not a name guard): a pace key file holds a single bare epoch integer.
      # Skip anything else — e.g. runway.state = "epoch spent$" (2 fields) would make $((now-last))
      # a syntax error and truncate the table. A name guard would age out the moment a 2nd non-key
      # state file lands beside it; the shape is the invariant. any=1 sits BELOW this so a dir of
      # only non-key files honestly reports "(no keys recorded yet)".
      case "$last" in ''|*[!0-9]*) continue;; esac
      any=1
      age=$((now-last)); eg="$(eff_gap "$GAP")"; rem=$((eg-age))
      if [ "$rem" -le 0 ]; then state="PASS"; rem=0; else state="skip"; fi
      printf "  %-14s %7ds %7ds %7ds  %s\n" "$k" "$age" "$eg" "$rem" "$state"
    done
    [ "$any" = 1 ] || echo "  (no keys recorded yet)"
    exit 0 ;;

  --check)
    # READ-ONLY probe (chat-review/dispatch-exposure-ticks-on-pace-skipped-passes): same decision as
    # the gate, but NEVER records — exit 0 = the gate would pass right now, exit 1 = it would hold.
    # For callers that need the gap state without consuming it (mesh-dispatch's idle-exposure tick
    # must pause on a pass the governor guarantees routes nothing — asking via the real gate would
    # itself burn the reserve, the pace-noop-consumes-slot bug in probe form).
    key="${2:-}"; [ -n "$key" ] || { echo "usage: mesh-pace --check <key> [gap]"; exit 1; }
    [ "${GAP:-0}" = 0 ] && exit 0
    PACE_GATE_MODE=check over_budget && exit 1   # HARD $ CAP: over rolling-5h cap → the gate would hold
    base="${3:-$GAP}"; gap="$(eff_gap "$base")"
    f="$DIR/$key"; last="$(cat "$f" 2>/dev/null || echo 0)"
    [ $((now - last)) -ge "$gap" ] && exit 0
    exit 1 ;;

  --gate-ledger)
    # The BALANCE QUERY the ledger exists to answer: how many times did the $-gate reach each decision —
    # and crucially how often it FAILED OPEN (nocap/blind-*) instead of holding. Source-reading the gate
    # tells you the branches EXIST; this tells you which ones FIRED, and how often. hledger if present
    # (real double-entry balance), else an awk tally over the same journal — the answer is identical.
    if [ ! -s "$PACE_GATE_LOG" ]; then echo "gate-ledger: empty ($PACE_GATE_LOG) — no hard-cap decision booked yet"; exit 0; fi
    echo "gate-ledger: $PACE_GATE_LOG"
    if command -v hledger >/dev/null 2>&1; then
      hledger -f "$PACE_GATE_LOG" balance gate:decision --no-total --flat 2>/dev/null \
        || awk '/gate:decision:/{split($1,a,":"); c[a[3]]++} END{for(k in c) printf "  %8d  gate:decision:%s\n", c[k], k}' "$PACE_GATE_LOG"
    else
      awk '/gate:decision:/{split($1,a,":"); c[a[3]]++} END{for(k in c) printf "  %8d  gate:decision:%s\n", c[k], k}' "$PACE_GATE_LOG"
    fi
    # highlight the fail-open count — the number the dev.to question actually asked for
    fo="$(awk '/gate:decision:(nocap|blind-meter|blind-parse)/{n++} END{print n+0}' "$PACE_GATE_LOG")"
    held="$(awk '/gate:decision:over /{n++} END{print n+0}' "$PACE_GATE_LOG")"
    echo "  ── fail-open (nocap/blind, cap NOT enforced): $fo    held (cap enforced): $held"
    exit 0 ;;

  --reset)
    if [ -n "${2:-}" ]; then rm -f "$DIR/$2" && echo "reset: $2"; else rm -f "$DIR"/* 2>/dev/null; echo "reset: all keys"; fi
    exit 0 ;;

  ""|-h|--help)
    echo "usage: mesh-pace <key> [gap] | --check <key> [gap] | --status | --eff-gap [base] | --burden | --runway | --gate-ledger | --reset [key] | --test"
    echo "  knob: MESH_PACE_GAP (seconds, default 900) in ~/.mesh/restore.env — bigger = gentler"
    [ "${1:-}" = "" ] && exit 1 || exit 0 ;;

  -*)
    echo "usage: mesh-pace <key> [gap] | --check <key> [gap] | --status | --eff-gap [base] | --burden | --runway | --gate-ledger | --reset [key] | --test"; exit 1 ;;

  *)
    key="$1"
    # GAP=0 disables the governor entirely (escape hatch).
    [ "${GAP:-0}" = 0 ] && exit 0
    over_budget && exit 1          # HARD $ CAP: over rolling-5h cap → hold this paced lane (no record)
    base="${2:-$GAP}"; gap="$(eff_gap "$base")"
    f="$DIR/$key"; last="$(cat "$f" 2>/dev/null || echo 0)"
    if [ $((now - last)) -ge "$gap" ]; then
      echo "$now" > "$f"; exit 0          # proceed
    fi
    exit 1                                 # too soon — caller should skip this cycle
    ;;
esac
