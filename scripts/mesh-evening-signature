#!/usr/bin/env bash
# mesh-evening-signature — temporal fusion: normal vs UNUSUAL evening profile.
# Reads sensors.log and compares the current window's sensor patterns against
# the historic baseline for this hour-of-day. Detects deviations: unusual
# light levels, unexpected audio/motion activity, absent expected signals.
#
# Baseline: same hour-of-day, last N days (default 7). Current window: last
# 30 minutes. Sensors fused: phone_light, wifi_rssi variance (motion proxy),
# phone_battery temp (ambient proxy), body activity.
#
# Output:
#   NORMAL     — current pattern matches historic baseline
#   UNUSUAL    — one or more sensors deviate significantly from baseline
#   NOISY      — current pattern is erratic vs baseline
#   INSUFFICIENT — <3 historic samples (log too new)
#   --json     — per-sensor deviation scores
#
#   mesh-evening-signature             one-shot temporal verdict
#   mesh-evening-signature --json      machine-readable scores
#   mesh-evening-signature --test      smoke test
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

LOG="${MESH_SENSOR_LOG:-$HOME/.mesh/sensors.log}"
STATE="$HOME/.mesh/.evening-signature.state"

if [ "${1:-}" = --test ]; then
  command -v python3 >/dev/null 2>&1 || { echo "smoke-test: FAIL (no python3)"; exit 1; }
  [ -f "$LOG" ] || { echo "smoke-test: n/a (no sensors.log yet)"; exit 0; }
  echo "smoke-test: ok"; exit 0
fi

MODE=text; [ "${1:-}" = --json ] && MODE=json
TS=$(date -u +%Y-%m-%dT%H:%M:%SZ)
HOUR="$(date +%H)"

if [ ! -s "$LOG" ]; then
  if [ "$MODE" = json ]; then printf '{"verdict":"INSUFFICIENT","reason":"no sensors.log","sensors":{},"ts":"%s"}\n' "$TS"
  else echo "[evening-signature] INSUFFICIENT — no sensors.log yet"; fi
  exit 0
fi

result="$(python3 - "$LOG" "$MODE" "$HOUR" 2>/dev/null <<'PYEOF'
import sys, json
from collections import defaultdict
from datetime import datetime, timezone, timedelta

log_path = sys.argv[1]
mode = sys.argv[2]
current_hour = int(sys.argv[3])

NOW = datetime.now(timezone.utc)
CURRENT = timedelta(minutes=30)
HISTORIC = timedelta(hours=1)
HISTORIC_DAYS = 7

def parse_ts(s):
    s = s.strip().rstrip('Z')
    if 'T' in s:
        return datetime.fromisoformat(s).replace(tzinfo=timezone.utc)
    return None

current_data = defaultdict(list)
historic_data = defaultdict(list)

try:
    with open(log_path) as f:
        for line in f:
            parts = line.strip().split(None, 3)
            if len(parts) < 4: continue
            ts = parse_ts(parts[0])
            if not ts: continue
            sen = parts[2]
            val = parts[3].strip()
            age = NOW - ts
            if age <= CURRENT:
                current_data[sen].append(val)
            if timedelta(hours=1) <= age <= timedelta(days=HISTORIC_DAYS):
                h_ts = ts.astimezone()
                if h_ts.hour == current_hour:
                    historic_data[sen].append(val)
except FileNotFoundError:
    pass

sensors_out = {}
deviations = 0
total_sensors = 0

def parse_light(v):
    try: return float(v)
    except: return None

def parse_wifi(v):
    try: return float(v.split()[-1])
    except: return None

def parse_temp(v):
    try: return float(v)
    except: return None

c_vals = [parse_light(v) for v in current_data.get('phone_light', []) if parse_light(v) is not None]
h_vals = [parse_light(v) for v in historic_data.get('phone_light', []) if parse_light(v) is not None]
if len(h_vals) >= 3:
    total_sensors += 1
    h_avg = sum(h_vals) / len(h_vals)
    h_std = (sum((v - h_avg)**2 for v in h_vals) / len(h_vals))**0.5 or 1
    c_avg = sum(c_vals) / len(c_vals) if c_vals else None
    dev = 0
    if c_avg is not None:
        dev = abs(c_avg - h_avg) / max(h_std, 1)
        if dev > 2.0: deviations += 1
    sensors_out['light'] = {'current_avg': c_avg, 'historic_avg': round(h_avg, 1), 'z_score': round(dev, 2)}
elif c_vals and len(h_vals) == 0:
    total_sensors += 1
    deviations += 1
    sensors_out['light'] = {'current_avg': sum(c_vals)/len(c_vals) if c_vals else None, 'historic_avg': None, 'z_score': None, 'note': 'no historic baseline'}
else:
    sensors_out['light'] = {'current_avg': None, 'historic_avg': None, 'z_score': None}

c_rssi = [parse_wifi(v) for v in current_data.get('wifi_rssi', []) if parse_wifi(v) is not None]
h_rssi = [parse_wifi(v) for v in historic_data.get('wifi_rssi', []) if parse_wifi(v) is not None]
if len(h_rssi) >= 6:
    total_sensors += 1
    c_var = max(c_rssi) - min(c_rssi) if len(c_rssi) > 1 else 0
    h_var_vals = []
    for i in range(0, len(h_rssi), 2):
        window = h_rssi[i:i+2]
        h_var_vals.append(max(window) - min(window) if len(window) > 1 else 0)
    h_var_avg = sum(h_var_vals) / len(h_var_vals)
    h_var_std = (sum((v - h_var_avg)**2 for v in h_var_vals) / len(h_var_vals))**0.5 or 1
    dev = abs(c_var - h_var_avg) / max(h_var_std, 1)
    if dev > 2.0: deviations += 1
    sensors_out['wifi_motion'] = {'current_var': round(c_var, 1), 'historic_var': round(h_var_avg, 1), 'z_score': round(dev, 2)}
else:
    sensors_out['wifi_motion'] = {'current_var': None, 'historic_var': None, 'z_score': None}

c_temp = [parse_temp(v) for v in current_data.get('phone_battery', []) if parse_temp(v) is not None]
h_temp = [parse_temp(v) for v in historic_data.get('phone_battery', []) if parse_temp(v) is not None]
if len(h_temp) >= 3:
    total_sensors += 1
    h_avg = sum(h_temp) / len(h_temp)
    h_std = (sum((v - h_avg)**2 for v in h_temp) / len(h_temp))**0.5 or 0.5
    c_avg = sum(c_temp) / len(c_temp) if c_temp else None
    dev = 0
    if c_avg is not None:
        dev = abs(c_avg - h_avg) / max(h_std, 0.5)
        if dev > 2.0: deviations += 1
    sensors_out['battery_temp'] = {'current_avg': c_avg, 'historic_avg': round(h_avg, 1), 'z_score': round(dev, 2)}
else:
    sensors_out['battery_temp'] = {'current_avg': None, 'historic_avg': None, 'z_score': None}

n_historic = len(h_vals) + len(h_rssi) + len(h_temp)
if total_sensors == 0 or n_historic < 3:
    verdict = "INSUFFICIENT"
    reason = "not enough historic data (need >=3 samples)"
elif deviations >= total_sensors:
    verdict = "NOISY"
    reason = f"all {total_sensors} sensor(s) deviate from baseline"
elif deviations > 0:
    verdict = "UNUSUAL"
    reason = f"{deviations}/{total_sensors} sensor(s) deviate from baseline"
else:
    verdict = "NORMAL"
    reason = f"all {total_sensors} sensor(s) match historic profile"

if mode == "json":
    print(json.dumps({"verdict": verdict, "reason": reason, "sensors": sensors_out, "deviations": deviations, "total_sensors": total_sensors, "hour": current_hour, "ts": datetime.utcnow().strftime("%Y-%m-%dT%H:%M:%SZ")}))
else:
    print(f"[evening-signature] {verdict} — {reason}")
PYEOF
)"
if [ -z "$result" ]; then
  if [ "$MODE" = json ]; then printf '{"verdict":"INSUFFICIENT","reason":"analysis error","sensors":{},"ts":"%s"}\n' "$TS"
  else echo "[evening-signature] INSUFFICIENT — analysis error"; fi
  exit 0
fi
printf '%s\n' "$result"
