#!/usr/bin/env bash
# reflex-cadence: */15 * * * *
# reflex-args: --edge
# doctor-artifact: $HOME/.mesh/.nvme-internal-gradient.state 1800 sys
# mesh-nvme-internal-gradient — relation between two thermal locations on one NVMe controller.
#
# Sensor 1 and Sensor 2 are distinct live hwmon channels.  Their difference can expose a
# controller-internal hotspot that neither absolute temperature can identify alone.  Both axes
# must be readable; missing or malformed sysfs is UNKNOWN (exit 2), never a fabricated zero.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"

ROOT="${MESH_NVME_INTERNAL_ROOT:-/sys/class/nvme}"
STATE="${MESH_NVME_INTERNAL_STATE:-${HOME:-/root}/.mesh/.nvme-internal-gradient.state}"
THRESHOLD_MC="${MESH_NVME_INTERNAL_THRESHOLD_MC:-10000}"

read_label() {
  local hw="$1" label="$2" f raw
  for f in "$hw"/temp*_label; do
    [ -r "$f" ] || continue
    [ "$(tr -d '\r\n' <"$f" 2>/dev/null)" = "$label" ] || continue
    raw="$(tr -d '[:space:]' <"${f%_label}_input" 2>/dev/null)" || continue
    case "$raw" in ''|*[!0-9-]*) continue ;; esac
    printf '%s|%s\n' "$raw" "${f%_label}_input"
    return 0
  done
  return 1
}

read_pair() {
  local root="${MESH_NVME_INTERNAL_ROOT:-$ROOT}" ctrl hw s1 s2
  shopt -s nullglob
  for ctrl in "$root"/nvme[0-9]*; do
    [ -d "$ctrl" ] || continue
    for hw in "$ctrl"/hwmon*; do
      [ -d "$hw" ] || continue
      s1="$(read_label "$hw" 'Sensor 1' 2>/dev/null || true)"
      s2="$(read_label "$hw" 'Sensor 2' 2>/dev/null || true)"
      if [ -n "$s1" ] && [ -n "$s2" ]; then
        printf '%s|%s\n%s|%s\n' "${ctrl##*/}" "$s1" "${ctrl##*/}" "$s2"
        shopt -u nullglob
        return 0
      fi
    done
  done
  shopt -u nullglob
  return 2
}

classify() {
  local delta="$1" threshold="$2"
  case "$delta" in ''|*[!0-9-]*) return 2 ;; esac
  [ "${delta#-}" -ge "$threshold" ] && printf 'INTERNAL-GRADIENT' || printf 'INTERNAL-COUPLED'
}

if [ "${1:-}" = --test ]; then
  [ "$(classify 10000 10000)" = INTERNAL-GRADIENT ] || { echo 'smoke-test: FAIL (threshold relation)'; exit 1; }
  [ "$(classify -9999 10000)" = INTERNAL-COUPLED ] || { echo 'smoke-test: FAIL (negative sub-threshold relation)'; exit 1; }
  td="$(mktemp -d)" || exit 1
  trap 'rm -rf "$td"' EXIT
  mkdir -p "$td/nvme0/hwmon0"
  printf 'nvme\n' >"$td/nvme0/hwmon0/name"
  printf 'Sensor 1\n' >"$td/nvme0/hwmon0/temp2_label"
  printf '42000\n' >"$td/nvme0/hwmon0/temp2_input"
  printf 'Sensor 2\n' >"$td/nvme0/hwmon0/temp3_label"
  printf '57000\n' >"$td/nvme0/hwmon0/temp3_input"
  pair="$(MESH_NVME_INTERNAL_ROOT="$td" read_pair)" || { echo 'smoke-test: FAIL (fixture pair)'; exit 1; }
  [ "$(printf '%s\n' "$pair" | wc -l)" -eq 2 ] || { echo 'smoke-test: FAIL (fixture pair cardinality)'; exit 1; }
  MESH_NVME_INTERNAL_ROOT="$td/missing" read_pair >/dev/null 2>&1 && { echo 'smoke-test: FAIL (missing sysfs succeeded)'; exit 1; }
  live="$(read_pair)" || { echo 'smoke-test: n/a (NVMe Sensor 1 + Sensor 2 pair unavailable)'; exit 2; }
  echo "smoke-test: ok (fixture relation + REAL NVMe Sensor 1/Sensor 2 read: $live)"
  exit 0
fi

pair="$(read_pair)" || { echo 'mesh-nvme-internal-gradient: UNKNOWN — Sensor 1 and Sensor 2 are not both readable' >&2; exit 2; }
s1_line="$(printf '%s\n' "$pair" | sed -n '1p')"
s2_line="$(printf '%s\n' "$pair" | sed -n '2p')"
s1="${s1_line#*|}"; s1="${s1%%|*}"
s2="${s2_line#*|}"; s2="${s2%%|*}"
delta=$((s2 - s1)); abs="$delta"; [ "$abs" -lt 0 ] && abs=$(( -abs ))
verdict="$(classify "$delta" "$THRESHOLD_MC")" || exit 1
mkdir -p "$(dirname "$STATE")" 2>/dev/null || exit 1
printf '%s|sensor1_mC=%s|sensor2_mC=%s|delta_mC=%s\n' "$verdict" "$s1" "$s2" "$delta" >"$STATE" || exit 1
mesh-state-touch "$STATE" >/dev/null 2>&1 || { echo 'mesh-nvme-internal-gradient: UNKNOWN — could not stamp live state' >&2; exit 1; }
ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
if [ "${1:-}" = --json ]; then
  printf '{"verdict":"%s","sensor1_mC":%s,"sensor2_mC":%s,"delta_mC":%s,"source":"%s","observed_at":"%s"}\n' "$verdict" "$s1" "$s2" "$delta" "$ROOT" "$ts"
else
  printf '[nvme-internal-gradient] %s — Sensor1=%.1fC Sensor2=%.1fC delta=%+.1fC observed_at=%s\n' "$verdict" "$(awk -v v="$s1" 'BEGIN{print v/1000}')" "$(awk -v v="$s2" 'BEGIN{print v/1000}')" "$(awk -v v="$delta" 'BEGIN{print v/1000}')" "$ts"
fi
