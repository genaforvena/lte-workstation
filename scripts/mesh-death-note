#!/usr/bin/env bash
# mesh-death-note — record that a supervised child is dying, and NAME THE SIGNAL.
#
# WHY THIS EXISTS. mesh-supervise's cause-of-death leg had exactly one evidence source:
# mesh-kill-events, a KERNEL JOURNAL tap scoped to oom|segv (its own header says so, and its whole
# corpus is 10848 oom + 11 segv). A TERM or KILL sent by a USERSPACE process writes nothing to dmesg.
# So every group-kill death rendered as a bare "RESTART (was dead)" with no cause — indistinguishable
# from a clean exit, a hang-reap, or a child that simply fell over. That is an exclusion allowlist
# whose failure direction is SILENCE, and it is why a four-children-died-together episode stayed
# unanswerable. The kernel's signal_generate tracepoint is not reachable here (perf_event_paranoid=4;
# perf, bpf and auditd are all root-only on this node), so the cheap plane is trap-side, in the child.
#
# WHAT IT CANNOT DO, said out loud because the answer must never be silence: SIGKILL runs no trap, by
# construction. A child killed with -9 writes NOTHING here, and neither does one that dies before it
# arms. mesh-supervise therefore renders a death with no note as UNKNOWN-SIGNAL — never as no-signal.
# This tool names what it saw; the supervisor is responsible for naming what it could not see.
#
# Deliberately its own tape, not supervise.log: the supervisor's log is the record of what the
# SUPERVISOR did, and folding a child's self-report into it makes two subjects share one column.
# orphan-ok: called from the signal traps of supervised children, never scheduled.
set -uo pipefail
MESH="${MESH_DIR:-$HOME/.mesh}"
TAPE="${MESH_DEATH_TAPE:-$MESH/supervise-deaths.log}"

[ "${1:-}" = --test ] && {
  td="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
  trap 'rm -rf "$td"' EXIT
  trap 'rm -rf "$td"; trap - EXIT; exit 143' INT TERM HUP
  f=0
  # a note names the tool, the pid and the SIGNAL — the signal is the whole point, so assert it by name
  MESH_DEATH_TAPE="$td/t.log" "$0" demo TERM 4242 || { echo "  FAIL: writing a note exited non-zero"; f=1; }
  grep -qE 'DEATH tool=demo pid=4242 sig=TERM' "$td/t.log" \
    || { echo "  FAIL: the note does not carry tool/pid/sig (got: $(cat "$td/t.log" 2>/dev/null))"; f=1; }
  # APPEND, never truncate: two deaths are two rows. A note that overwrites its predecessor turns a
  # four-children-died-together episode — the exact case this was built for — into one row.
  MESH_DEATH_TAPE="$td/t.log" "$0" other INT 77 >/dev/null 2>&1
  [ "$(grep -c DEATH "$td/t.log")" = 2 ] || { echo "  FAIL: the tape does not append (a simultaneous multi-child death would collapse to one row)"; f=1; }
  # a missing signal argument must REFUSE, not write a note with an empty signal: a row that says a
  # death happened but cannot name the signal is exactly the silence this tool exists to remove, and
  # it would read to the supervisor as a successfully-named death.
  MESH_DEATH_TAPE="$td/t.log" "$0" demo "" 1 >/dev/null 2>&1 \
    && { echo "  FAIL: an empty signal was accepted — an unnamed note reads as a named death"; f=1; }
  [ "$(grep -c DEATH "$td/t.log")" = 2 ] || { echo "  FAIL: the refused call still wrote a row"; f=1; }
  # an unwritable tape must not wedge the DYING child: this runs inside a signal trap, so a failure
  # here must be quiet-and-non-fatal to the child's own exit path.
  MESH_DEATH_TAPE="/proc/definitely/not/writable" "$0" demo TERM 9 >/dev/null 2>&1
  [ "$?" -le 1 ] || { echo "  FAIL: an unwritable tape produced an unexpected exit — a note must never wedge the child's exit"; f=1; }
  # ── TWO SIGNALS, OR THE GATE IS VACUOUS (2026-08-29, found on the FIRST live drive) ─────────────
  # The four children shipped their traps as `trap "mesh-death-note <name> \$_sig \$\$" "$_sig"` —
  # \$_sig, escaped, so the name was expanded at SIGNAL time. By then the install loop has finished
  # and _sig holds its LAST value, so every signal was recorded as HUP. Measured live: a real SIGTERM
  # to the supervised dram-bw-sampler wrote `sig=HUP`. That is worse than the silence it replaced,
  # because the supervisor prints it with full confidence — a constant wearing a signal name.
  # A fixture that sends ONE signal passes the broken form and the correct one alike. So: drive a real
  # child twice with two DIFFERENT signals and require each note to name the signal actually sent —
  # then run the BROKEN idiom through the same arm and require it to fail, which is what makes this a
  # gate instead of a decoration.
  _dn_spawn(){ # $1=form(named|deferred) $2=loop(bg|fg) $3=tape -> echoes the child's pid
    local f="$td/c-$1-$2.sh"
    {
      echo '#!/usr/bin/env bash'
      printf 'export MESH_DEATH_TAPE=%s\n' "$3"
      printf 'DN=%s\n' "$0"
      case "$1" in
        named)    echo 'for _sig in INT TERM HUP; do trap "\"$DN\" kid $_sig \$\$ 2>/dev/null; exit 0" "$_sig"; done' ;;
        deferred) echo 'for _sig in INT TERM HUP; do trap "\"$DN\" kid \$_sig \$\$ 2>/dev/null; exit 0" "$_sig"; done' ;;
      esac
      case "$2" in
        bg) echo 'while :; do sleep 5 & wait $! 2>/dev/null; done' ;;
        fg) echo 'while :; do sleep 5; done' ;;
      esac
    } > "$f"
    # stdout/stderr to /dev/null, NOT inherited: this runs inside $( ), and a backgrounded child
    # holding the capture pipe open makes the substitution block until the child exits — the harness
    # hangs instead of the test failing, which reads as a broken suite rather than a broken subject.
    chmod +x "$f"; "$f" >/dev/null 2>&1 & echo $!
  }
  _dn_drive(){ # $1=form $2=loop $3=signal $4=tape -> echoes "<alive|dead> <sig-in-tape-or-none>"
    local pid st sig
    pid="$(_dn_spawn "$1" "$2" "$4")"; sleep 0.4
    kill -"$3" "$pid" 2>/dev/null; sleep 1.2
    if kill -0 "$pid" 2>/dev/null; then st=alive; kill -9 "$pid" 2>/dev/null; else st=dead; fi
    wait "$pid" 2>/dev/null
    sig="$(grep -oE 'sig=[A-Z0-9]+' "$4" 2>/dev/null | tail -1 | cut -d= -f2)"
    echo "$st ${sig:-none}"
  }
  # the CORRECT idiom, two different signals, each named as sent. TERM and HUP, deliberately — see
  # the SIGINT arm below for why INT cannot be one of the two.
  : > "$td/two.log"; r="$(_dn_drive named bg TERM "$td/two.log")"
  [ "$r" = "dead TERM" ] || { echo "  FAIL: a TERM'd child must die and its note must say TERM (got: $r)"; f=1; }
  : > "$td/two.log"; r="$(_dn_drive named bg HUP "$td/two.log")"
  [ "$r" = "dead HUP" ] || { echo "  FAIL: a HUP'd child must die and its note must say HUP (got: $r)"; f=1; }
  # ── THE INT ARM OF EVERY SUPERVISED CHILD'S TRAP IS DEAD CODE, AND THAT IS A FACT ABOUT HOW THE
  #    SUPERVISOR STARTS THEM. mesh-supervise launches with `setsid bash -lc "$start" &` — asynchronous
  #    — and POSIX has a non-interactive shell set INT (and QUIT) to SIG_IGN in an async child. Bash
  #    will not install a trap for a signal ignored on entry, silently. Measured on the live
  #    dram-bw-sampler the supervisor had just restarted: /proc/<pid>/status SigIgn carried SIGINT
  #    while HUP and TERM read as caught. So `trap … INT` in these children fires only for a HAND-RUN
  #    in a terminal, never for the supervised case this whole plane exists for — and an INT sent to a
  #    supervised child does not even kill it. Gated here so nobody reads "INT TERM HUP" as three
  #    covered signals, and so that a future bash or start-path that changes this is noticed.
  : > "$td/two.log"; r="$(_dn_drive named bg INT "$td/two.log")"
  [ "$r" = "alive none" ] || { echo "  FAIL: a background-started child must IGNORE INT outright (bash cannot trap a signal ignored on entry) — if this now dies or names INT, the supervised INT arm has changed and the children's trap lists should be revisited (got: $r)"; f=1; }
  # THE MUTANT that shipped: deferred expansion. It must MISNAME a TERM as the loop's last value.
  # If this ever reads TERM the arm above has stopped discriminating and both are worthless.
  : > "$td/two.log"; r="$(_dn_drive deferred bg TERM "$td/two.log")"
  [ "$r" = "dead HUP" ] || { echo "  FAIL: the deferred-expansion mutant must still misname TERM as HUP — if it does not, the two-signal arm above no longer discriminates (got: $r)"; f=1; }
  # ── A TRAP BEHIND A FOREGROUND SLEEP IS A TRAP THAT DOES NOT RUN ────────────────────────────────
  # bash defers a caught signal until the current FOREGROUND external command returns. Adding these
  # traps to loops that slept inline (`sleep 180` in selfcare, `sleep 600` in snapshot) therefore made
  # those children SURVIVE a TERM they used to die on instantly — the trap replaced the default
  # disposition and then did not run. `sleep & wait` is interruptible. Both arms drive it for real.
  : > "$td/two.log"; r="$(_dn_drive named fg TERM "$td/two.log")"
  [ "$r" = "alive none" ] || { echo "  FAIL: the control is wrong — a foreground sleep MUST defer the handler, leaving the child alive and the tape empty (got: $r)"; f=1; }
  : > "$td/two.log"; r="$(_dn_drive named bg TERM "$td/two.log")"
  [ "$r" = "dead TERM" ] || { echo "  FAIL: with the sleep backgrounded and waited on, the handler must run at once (got: $r)"; f=1; }
  [ "$f" = 0 ] || { echo "smoke-test: FAIL (death-note tape drifted)"; exit 1; }
  echo "smoke-test: ok (death note: names tool/pid/SIGNAL · TWO trappable signals driven, each named as sent, with the deferred-expansion mutant still misnaming · SIGINT proven ignored-on-entry for a background-started child, so that arm is dead for the supervised case · a foreground sleep proven to defer the handler and a backgrounded one proven not to · appends so simultaneous deaths stay distinct · refuses an unnamed signal rather than writing a note that reads as named · an unwritable tape never wedges the dying child)"
  exit 0
}

name="${1:-}"; sig="${2:-}"; pid="${3:-$PPID}"
[ -n "$name" ] && [ -n "$sig" ] || {
  echo "usage: mesh-death-note <tool-name> <SIGNAL> [pid]" >&2; exit 2; }
mkdir -p "$(dirname "$TAPE")" 2>/dev/null || true
# Never fatal: this runs inside a dying child's signal trap. A tape it cannot write is a lost note,
# which the supervisor renders as UNKNOWN-SIGNAL — the honest word — not a reason to wedge the exit.
printf '%s DEATH tool=%s pid=%s sig=%s\n' "$(date -u +%FT%TZ)" "$name" "$pid" "$sig" >> "$TAPE" 2>/dev/null || exit 1
exit 0
