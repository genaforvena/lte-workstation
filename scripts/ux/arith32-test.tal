( arith32-test.tal — drives the 32-bit primitives DIRECTLY so each one gets its own )
( truth table, and so the carry between the low and the high word has a precise mutant )
( target. Results print as 8 hex digits: at this level hex is the honest rendering — the )
( carry boundary reads as 0000ffff -> 00010000 instead of hiding inside a decimal. )
(                                                                                        )
( input : three newline-terminated decimal tokens — op, A, B )
(         op 0 = w-add (A+B)   1 = w-sub (A-B)   2 = w-cmp (1 iff A>=B) )
(            3 = w-mul16 (A*B, both taken as 16-bit)   4 = w-mul32 (A*B, B 16-bit) )
( output: 8 hex digits + newline, halt rc 0 )
(                                                                                        )
( The 32-bit decimal INPUT path is itself w-accdigit, i.e. w-mul32 + w-add on every )
( token — so a broken carry cannot even get its own operands read in correctly. That is )
( deliberate: it means no test here can pass by accident with the carry removed. )
(                                                                                        )
( zero page 00..3f is this harness's; 40..5f belongs to arith32.tal. )
( op=00 tok=02 accH=04 accL=06 opA_hi=08 opA_lo=0a opB_hi=0c opB_lo=0e )

|0100
    ;on-console #10 DEO2
    BRK

@on-console
    #12 DEI
    DUP #0a NEQ ,&digit JCN
    POP
    ;token-done JMP2
    &digit
    #30 SUB #00 SWP                  ( digit as a short )
    ;push-digit JMP2

( acc = acc*10 + digit, in 32 bits, via the library's own primitives )
@push-digit ( digit* -- )
    #04 LDZ2 #40 STZ2                ( A = acc )
    #06 LDZ2 #42 STZ2
    ;w-accdigit JSR2
    #40 LDZ2 #04 STZ2                ( acc = A )
    #42 LDZ2 #06 STZ2
    BRK

@token-done
    #02 LDZ #00 EQU ,&t0 JCN
    #02 LDZ #01 EQU ,&t1 JCN
    ,&t2 JMP
    &t0
    #06 LDZ2 #00 STZ2                ( op = acc low word )
    ,&next JMP
    &t1
    #04 LDZ2 #08 STZ2                ( A = acc )
    #06 LDZ2 #0a STZ2
    ,&next JMP
    &next
    #0000 #04 STZ2                   ( acc = 0 )
    #0000 #06 STZ2
    #02 LDZ INC #02 STZ              ( tok++ )
    BRK
    &t2
    #04 LDZ2 #0c STZ2                ( B = acc )
    #06 LDZ2 #0e STZ2
    ;run JMP2

@run
    #08 LDZ2 #40 STZ2                ( A -> the library's A )
    #0a LDZ2 #42 STZ2
    #0c LDZ2 #44 STZ2                ( B -> the library's B )
    #0e LDZ2 #46 STZ2
    #00 LDZ2 #0000 EQU2 ,&do-add JCN
    #00 LDZ2 #0001 EQU2 ,&do-sub JCN
    #00 LDZ2 #0002 EQU2 ,&do-cmp JCN
    #00 LDZ2 #0003 EQU2 ,&do-w-mul16 JCN
    ,&do-mul32 JMP
    &do-add   ;w-add JSR2 ,&out JMP
    &do-sub   ;w-sub JSR2 ,&out JMP
    &do-cmp   ;w-cmp JSR2 #00 SWP #42 STZ2 #0000 #40 STZ2 ,&out JMP
    &do-w-mul16 #0a LDZ2 #4c STZ2 #0e LDZ2 #4e STZ2 ;w-mul16 JSR2 ,&out JMP
    &do-mul32 #0e LDZ2 #4e STZ2 ;w-mul32 JSR2
    &out
    #40 LDZ2 ;emit-hex16 JSR2
    #42 LDZ2 ;emit-hex16 JSR2
    #0a #18 DEO
    #80 #0f DEO
    BRK

@emit-hex16 ( v* -- )
    DUP2 #0c SFT2 #000f AND2 ;emit-nib JSR2
    DUP2 #08 SFT2 #000f AND2 ;emit-nib JSR2
    DUP2 #04 SFT2 #000f AND2 ;emit-nib JSR2
    #000f AND2 ;emit-nib JSR2
    JMP2r

@emit-nib ( n* -- )
    NIP
    DUP #0a LTH ,&dig JCN
    #37 ADD #18 DEO
    JMP2r
    &dig
    #30 ADD #18 DEO
    JMP2r

~arith32.tal
