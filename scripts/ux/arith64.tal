( arith64.tal — 64-bit quad-word arithmetic on a 16-bit machine.                          )
(                                                                                        )
( WHY THIS EXISTS: arith32 lifted the ceiling once, and the corpus has lived under 32     )
( bits since. This lifts it again, on the operator's call. It is deliberately the SAME    )
( shape as arith32 — fixed register file, fully unrolled, every carry an explicit         )
( comparison — because the carry chain is now THREE links long instead of one, and a      )
( chain is only as honest as its least-tested link.                                       )
(                                                                                        )
( REPRESENTATION: a 64-bit value is four shorts in the zero page, MOST significant first, )
( two bytes apart — the same "hi first" order arith32 uses, extended. So A's words are     )
( A3 A2 A1 A0 at 60 62 64 66, and A0 is the one that wraps first.                         )
(                                                                                        )
( zero page: A=60/62/64/66  B=68/6a/6c/6e   t0=70 t1=72 t2=74 t3=76                       )
(            c0=78 c1=7a c2=7c   Y=7e   m0=80 m1=82 m2=84 m3=86   k=88 kt=8a              )
(            [40..5f stays arith32's, 00..3f stays the test harness's]                    )
(                                                                                        )
( CARRY DETECTION is unsigned-wrap detection, exactly as in arith32: a+b wrapped exactly  )
( when the sum is LESS than either addend. There is no carry flag on this machine.        )
( What is NEW here and is the whole risk of this file: each word past the first takes a   )
( carry IN as well as producing one OUT, so the addend is added in TWO steps and EITHER   )
( step can wrap. Capture only the first and the failure is silent, plausible and rare —   )
( it needs the incoming carry to land exactly on 0xffff. Every one of those links is a    )
( separate deletable line, and test-arith64 requires each deletion to go RED on its own.  )
(                                                                                        )
( CLOBBERS: q-mul16 and q-mul32 call arith32's w-mul16, so they destroy arith32's A, X    )
( and t0..t6 (40..58). A caller holding a live 32-bit value there must save it first.     )

@q-add ( -- )   ( A = A + B; carry out of the top word leaves the 64-bit range and is the )
                ( caller's domain problem, same convention as arith32's w-mul32 )
    ( word 0 — the only word with no carry in )
    #66 LDZ2 #6e LDZ2 ADD2 #70 STZ2                        ( t0 = A0 + B0, wrapping )
    #70 LDZ2 #66 LDZ2 LTH2 #00 SWP #78 STZ2                ( c0 = t0 < A0 )
    #70 LDZ2 #66 STZ2
    ( word 1 )
    #64 LDZ2 #6c LDZ2 ADD2 #72 STZ2                        ( t1 = A1 + B1 )
    #72 LDZ2 #64 LDZ2 LTH2 #00 SWP #7a STZ2                ( c1 = t1 < A1 )
    #72 LDZ2 #78 LDZ2 ADD2 #74 STZ2                        ( t2 = t1 + c0 )
    #74 LDZ2 #72 LDZ2 LTH2 #00 SWP #7a LDZ2 ADD2 #7a STZ2  ( c1 += t2 < t1 )
    #74 LDZ2 #64 STZ2
    ( word 2 )
    #62 LDZ2 #6a LDZ2 ADD2 #72 STZ2                        ( t1 = A2 + B2 )
    #72 LDZ2 #62 LDZ2 LTH2 #00 SWP #7c STZ2                ( c2 = t1 < A2 )
    #72 LDZ2 #7a LDZ2 ADD2 #74 STZ2                        ( t2 = t1 + c1 )
    #74 LDZ2 #72 LDZ2 LTH2 #00 SWP #7c LDZ2 ADD2 #7c STZ2  ( c2 += t2 < t1 )
    #74 LDZ2 #62 STZ2
    ( word 3 — nothing above it to carry into )
    #60 LDZ2 #68 LDZ2 ADD2 #7c LDZ2 ADD2 #60 STZ2
    JMP2r

@q-sub ( -- )   ( A = A - B )
    ( word 0 )
    #66 LDZ2 #6e LDZ2 LTH2 #00 SWP #78 STZ2                ( c0 = borrow = A0 < B0 )
    #66 LDZ2 #6e LDZ2 SUB2 #66 STZ2
    ( word 1 )
    #64 LDZ2 #6c LDZ2 LTH2 #00 SWP #7a STZ2                ( c1 = A1 < B1 )
    #64 LDZ2 #6c LDZ2 SUB2 #72 STZ2                        ( t1 = A1 - B1 )
    #72 LDZ2 #78 LDZ2 LTH2 #00 SWP #7a LDZ2 ADD2 #7a STZ2  ( c1 += t1 < c0 )
    #72 LDZ2 #78 LDZ2 SUB2 #64 STZ2
    ( word 2 )
    #62 LDZ2 #6a LDZ2 LTH2 #00 SWP #7c STZ2                ( c2 = A2 < B2 )
    #62 LDZ2 #6a LDZ2 SUB2 #72 STZ2                        ( t1 = A2 - B2 )
    #72 LDZ2 #7a LDZ2 LTH2 #00 SWP #7c LDZ2 ADD2 #7c STZ2  ( c2 += t1 < c1 )
    #72 LDZ2 #7a LDZ2 SUB2 #62 STZ2
    ( word 3 )
    #60 LDZ2 #68 LDZ2 SUB2 #7c LDZ2 SUB2 #60 STZ2
    JMP2r

@q-cmp ( -- flag )   ( 1 iff A >= B — decided at the FIRST word that differs, top down )
    #60 LDZ2 #68 LDZ2 GTH2 ,&yes JCN
    #60 LDZ2 #68 LDZ2 LTH2 ,&no JCN
    #62 LDZ2 #6a LDZ2 GTH2 ,&yes JCN
    #62 LDZ2 #6a LDZ2 LTH2 ,&no JCN
    #64 LDZ2 #6c LDZ2 GTH2 ,&yes JCN
    #64 LDZ2 #6c LDZ2 LTH2 ,&no JCN
    #66 LDZ2 #6e LDZ2 LTH2 ,&no JCN
    &yes #01 JMP2r
    &no  #00 JMP2r

( q-mul16 — A = A * Y, Y 16-bit. Each word's 16x16 product is a full 32 bits, so the high )
( half is the carry into the next word: this is long multiplication, one digit per word.  )
( The carry ADD can itself wrap [product-low + carry-in], and that wrap belongs in the    )
( outgoing carry — its own mutant in the test. )
@q-mul16 ( -- )
    #7e LDZ2 #4e STZ2                                      ( arith32's Y, set once )
    ( word 0 )
    #66 LDZ2 #4c STZ2 ;w-mul16 JSR2
    #42 LDZ2 #66 STZ2                                      ( A0 = product low )
    #40 LDZ2 #88 STZ2                                      ( k = product high = carry )
    ( word 1 )
    #64 LDZ2 #4c STZ2 ;w-mul16 JSR2
    #42 LDZ2 #88 LDZ2 ADD2 #8a STZ2                        ( kt = plo + k )
    #8a LDZ2 #42 LDZ2 LTH2 #00 SWP #40 LDZ2 ADD2 #88 STZ2  ( k = phi + [kt < plo] )
    #8a LDZ2 #64 STZ2
    ( word 2 )
    #62 LDZ2 #4c STZ2 ;w-mul16 JSR2
    #42 LDZ2 #88 LDZ2 ADD2 #8a STZ2
    #8a LDZ2 #42 LDZ2 LTH2 #00 SWP #40 LDZ2 ADD2 #88 STZ2
    #8a LDZ2 #62 STZ2
    ( word 3 — only the low half can still land inside 64 bits )
    #60 LDZ2 #4c STZ2 ;w-mul16 JSR2
    #42 LDZ2 #88 LDZ2 ADD2 #60 STZ2
    JMP2r

( q-mul32 — A = A[low 32] * B[low 32], the FULL 64-bit product. This is the operation that )
( 32 bits could not hold and the reason the ceiling was worth lifting: a sum of squares of )
( 32-bit values needs it. Built as four 16x16 partials placed at their own word offsets and )
( accumulated through q-add, so the carry logic is not written a second time — a partial   )
( placed at the wrong word is then a one-line mutant. )
@q-mul32 ( -- )
    #66 LDZ2 #80 STZ2                                      ( m0 = A0 )
    #64 LDZ2 #82 STZ2                                      ( m1 = A1 )
    #6e LDZ2 #84 STZ2                                      ( m2 = B0 )
    #6c LDZ2 #86 STZ2                                      ( m3 = B1 )
    #0000 #60 STZ2 #0000 #62 STZ2 #0000 #64 STZ2 #0000 #66 STZ2   ( A = 0 )
    ( a0*b0 -> words 1,0 )
    #80 LDZ2 #4c STZ2 #84 LDZ2 #4e STZ2 ;w-mul16 JSR2
    #0000 #68 STZ2 #0000 #6a STZ2 #40 LDZ2 #6c STZ2 #42 LDZ2 #6e STZ2
    ;q-add JSR2
    ( a0*b1 -> words 2,1 )
    #80 LDZ2 #4c STZ2 #86 LDZ2 #4e STZ2 ;w-mul16 JSR2
    #0000 #68 STZ2 #40 LDZ2 #6a STZ2 #42 LDZ2 #6c STZ2 #0000 #6e STZ2
    ;q-add JSR2
    ( a1*b0 -> words 2,1 )
    #82 LDZ2 #4c STZ2 #84 LDZ2 #4e STZ2 ;w-mul16 JSR2
    #0000 #68 STZ2 #40 LDZ2 #6a STZ2 #42 LDZ2 #6c STZ2 #0000 #6e STZ2
    ;q-add JSR2
    ( a1*b1 -> words 3,2 )
    #82 LDZ2 #4c STZ2 #86 LDZ2 #4e STZ2 ;w-mul16 JSR2
    #40 LDZ2 #68 STZ2 #42 LDZ2 #6a STZ2 #0000 #6c STZ2 #0000 #6e STZ2
    ;q-add JSR2
    JMP2r

( q-accdigit — the decimal-input step, A = A*10 + digit. Every ROM that reads a 64-bit )
( value off the console runs its operands through this, so a broken carry cannot even get )
( its own inputs parsed correctly. )
@q-accdigit ( digit* -- )
    #6e STZ2                         ( B0 = digit )
    #0000 #68 STZ2 #0000 #6a STZ2 #0000 #6c STZ2
    #000a #7e STZ2                   ( Y = 10 )
    ;q-mul16 JSR2
    ;q-add JSR2
    JMP2r
