( route.tal — prefix router: the tiny mesh message demux. )
( FIRST input line = prefix; config travels in-band, canonical text. )
( Each later line: starts-with-prefix -> stdout (18), else -> stderr (19). )
( Held bytes on the match path ARE prefix(0..midx-1) — replay from the )
( prefix buffer, no line buffer needed. EOF with a held partial -> stderr )
( (an incomplete line never counts as a match); halt #80. )
( zp: 00 state (0 cfg / 1 match / 2 stream), 01 dest, 02 plen, 03 midx; )
( prefix buffer zp 10..2f, cap 32 bytes. )

|0100                        ( reset vector )
    ;on-console #10 DEO2     ( install Console/vector )
    BRK

@on-console
    #17 DEI #04 NEQ ,&live JCN    ( EOF is far: trampoline via absolute jump )
    ;on-console/eof JMP2          ( -> flush any held, halt )
    &live
    #17 DEI #01 NEQ ,&skip JCN    ( only stdin bytes )
    #12 DEI                       ( c )
    #00 LDZ #00 EQU ,&cfg JCN
    #00 LDZ #01 EQU ,&match JCN
    &stream                       ( state 2: line's fate decided )
    DUP #01 LDZ DEO               ( emit c to dest )
    #0a EQU ,&newline JCN
    BRK
    &newline
    #01 #00 STZ #00 #03 STZ       ( state=1, midx=0 )
    BRK
    &skip BRK

    &cfg                          ( state 0: reading the prefix line )
    DUP #0a EQU ,&cfg-done JCN
    #02 LDZ #20 LTH ,&cfg-store JCN
    POP BRK                       ( over cap: drop byte )
    &cfg-store
    #02 LDZ #10 ADD STZ           ( prefix[plen] = c )
    #02 LDZ INC #02 STZ           ( plen++ )
    BRK
    &cfg-done
    POP #01 #00 STZ #00 #03 STZ   ( state=1, midx=0 )
    BRK

    &match                        ( state 1: at byte midx, all held so far )
    #02 LDZ #00 EQU ,&hit-empty JCN
    DUP #03 LDZ #10 ADD LDZ EQU ,&adv JCN
    #19 #01 STZ                   ( mismatch: dest=stderr )
    ;flush JSR2                   ( replay held prefix(0..midx-1) )
    #02 #00 STZ                   ( state=2 )
    ;on-console/stream JMP2       ( c itself streams to stderr )
    &adv
    POP                           ( c == prefix[midx]: hold it )
    #03 LDZ INC DUP #03 STZ       ( midx++ )
    #02 LDZ EQU ,&hit JCN         ( midx == plen -> full match )
    BRK
    &hit
    #18 #01 STZ                   ( dest=stdout )
    ;flush JSR2                   ( emit the whole prefix )
    #02 #00 STZ                   ( state=2 )
    BRK
    &hit-empty
    #18 #01 STZ #02 #00 STZ       ( empty prefix: every line matches )
    ;on-console/stream JMP2

    &eof
    #00 LDZ #01 EQU #03 LDZ #00 NEQ AND ,&eof-flush JCN
    ,&halt JMP
    &eof-flush
    #19 #01 STZ                   ( held partial -> stderr )
    ;flush JSR2
    &halt
    #80 #0f DEO                   ( System/state: halt, exit 0 )
    BRK

@flush ( -- ; emits prefix(0..midx-1) to dest )
    #00                           ( i )
    &loop
    DUP #03 LDZ LTH ,&go JCN      ( i < midx ? )
    POP JMP2r
    &go
    DUP #10 ADD LDZ #01 LDZ DEO   ( emit prefix[i] to dest )
    INC ,&loop JMP
