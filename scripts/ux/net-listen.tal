( net-listen.tal — the step-2 gate ROM for the network device (0xd0): it BINDS. )
(                                                                                        )
( net-echo dials out; this one is the thing that ANSWERS, which is the half that lets a )
( travelling ROM land on a node with no shell at all. It is the smallest program that can )
( prove the inbound path: bind an address it was handed, wait for a caller, read what the )
( caller sent, and reply with something the caller could not have produced by itself. )
(                                                                                        )
( input  : one line on stdin — the bind address, colon-separated 'tcp:host:port'. The )
(          host is always WRITTEN OUT; 'tcp:*:port' is the explicit any-address form. )
( output : nothing on stdout on success — the answer goes to the PEER, tagged 'uxn:' + )
(          the bytes received, and the ROM halts rc 0. )
(          "NA" + newline, rc 2 — bind refused, nobody called, or an empty read. )
(          "NODEV" + newline, rc 3 — this emulator's 0xd0 device is absent or too old. )
(                                                                                        )
( THE TAG IS THE POINT. A reply that merely echoed the bytes back would pass against a )
( plain TCP echo, against a stray socat, against the caller reading its own buffer — the )
( round trip would be asserted and the ROM never once involved. 'uxn:' can only come from )
( this program, so the caller's assert is about the ROM and not about the port. )
(                                                                                        )
( NODEV IS NOT NA. On an emulator with no 0xd0 page the device ports read back 0, and 0 )
( is Disconnected — so "no network in this build" would otherwise arrive as "the bind )
( failed". The ROM asks first: action d0 Identify writes a magic into the length register )
( that bare memory cannot fake. It is compared as an ORDERING — device d0, step >= 02 — )
( because this ROM needs BIND, which no step-1 emulator has; pinning the whole word would )
( instead make it refuse every future step of its own device. )
(                                                                                        )
( THE WAIT IS THE DEVICE'S, NOT A SPIN. Reading the state of an inbound lane with no )
( connection blocks for one UXN_NET_TIMEOUT and answers Bound if nobody called, so this )
( loop costs three deadlines and no CPU. A ROM polling a zero-timeout state port would )
( burn a core to sit still. )
(                                                                                        )
( zero-page: tries=00 ptr=02 len=04 i=06 got=08 )

|0100
    #0000 #d4 DEO2           ( clear the length register: a device-less page reads this back )
    #d0 #da DEO              ( action d0 Identify — only the DEVICE answers )
    #d4 DEI #d0 NEQ ,&nodev JCN   ( high byte: is this our device at all )
    #d5 DEI #02 LTH ,&nodev JCN   ( low byte: the STEP. Bind arrived in step 2, so a )
                                  ( connect-only emulator [d001] is refused BY NAME )
    ;on-console #10 DEO2
    ;uri-buf #02 STZ2        ( the one input line accumulates into the address buffer )
    BRK
    &nodev ;no-dev JMP2

@on-console
    #12 DEI
    DUP #0a EQU ,&nl JCN
    #02 LDZ2 STA             ( byte -> ram[ptr] )
    #02 LDZ2 INC2 #02 STZ2
    BRK
    &nl
    POP
    ;serve JMP2

@serve
    #00 #02 LDZ2 STA         ( NUL-terminate the address in place )
    #01 #df DEO              ( SELECT an inbound lane FIRST — channel 0 is the outbound )
                             ( lane, and binding on it is refused by the device )
    ;uri-buf #dd DEO2        ( the low byte of the bindaddr port IS the bind trigger )
    #03 #00 STZ              ( at most three waits, each one device deadline long )
    ;wait JMP2
    ( NO 'did it bind?' READ HERE, deliberately: on an inbound lane the state read IS the )
    ( accept, so a check for Bound would consume the first wait and answer Connected the )
    ( moment a caller arrived — reading a healthy bind as a failure. The wait loop below )
    ( already carries the whole answer: 6 nobody-yet, 2/3 a caller, 4 the bind was refused. )

@wait
    #da DEI                  ( WAITS for a caller — the device's deadline, not a spin )
    DUP #02 EQU ,&go JCN     ( Connected )
    DUP #03 EQU ,&go JCN     ( HasData )
    #06 EQU ,&again JCN      ( still Bound: the listener is up, nobody called yet )
    ;na JMP2                 ( Unbound/Disconnected: the listener itself is gone )
    &again
    #00 LDZ #01 SUB #00 STZ
    #00 LDZ #00 EQU ,&spent JCN
    ;wait JMP2
    &spent ;na JMP2
    &go POP ;recv JMP2

@recv
    #0100 #d4 DEO2           ( read up to 256 bytes )
    ;in-buf #d6 DEO2         ( the low byte of the read port receives )
    #d4 DEI2 #08 STZ2        ( got = the length the device actually moved )
    #08 LDZ2 #0000 EQU2 ,&empty JCN
    #0000 #06 STZ2
    &cp                      ( copy the payload in behind the tag )
    ;in-buf #06 LDZ2 ADD2 LDA
    ;out-body #06 LDZ2 ADD2 STA
    #06 LDZ2 INC2 #06 STZ2
    #06 LDZ2 #08 LDZ2 NEQ2 ,&cp JCN
    #08 LDZ2 #0004 ADD2 #04 STZ2           ( len = the 4-byte tag + got )
    #04 LDZ2 #d4 DEO2
    ;out-buf #d8 DEO2                      ( the low byte of the write port sends it )
    #d4 DEI2 #04 LDZ2 NEQ2 ,&short JCN     ( a SHORT WRITE is not a success )
    #80 #0f DEO              ( halt, exit 0 )
    BRK
    &empty ;na JMP2
    &short ;na JMP2

@na
    ;na-str ;emit JSR2
    #82 #0f DEO              ( halt, exit 2 — a claim about the LINK )
    BRK

@no-dev
    ;nodev-str ;emit JSR2
    #83 #0f DEO              ( halt, exit 3 — a claim about THIS EMULATOR, not the link )
    BRK

( emit: print the NUL-terminated string at the address on the stack. )
@emit                        ( str* -- )
    &l LDAk #00 EQU ,&d JCN
    LDAk #18 DEO INC2 ,&l JMP
    &d POP2
    JMP2r

@na-str "NA 0a 00
@nodev-str "NODEV 0a 00

( the tag is DATA and every buffer after it is a pad, so it goes FIRST: bytes written past )
( the last pad are what sets the ROM's length, and a tag at the end pads the file to 1.3K )
( for four bytes of payload. )
@out-buf  "uxn 3a          ( the tag: 'uxn:' — four bytes no echo server can produce )
@out-body $200
@uri-buf  $200
@in-buf   $200
