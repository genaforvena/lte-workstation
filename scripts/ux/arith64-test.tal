( arith64-test.tal — drives the 64-bit primitives DIRECTLY so each one gets its own truth )
( table, and so EVERY link of the three-link carry chain has a precise mutant target.     )
( Results print as 16 hex digits: at this level hex is the honest rendering — a carry     )
( crossing word 1 into word 2 reads as 0000ffffffffffff -> 0001000000000000 instead of    )
( disappearing into the middle of a decimal.                                              )
(                                                                                        )
( input : three newline-terminated decimal tokens — op, A, B                              )
(         op 0 = q-add (A+B)   1 = q-sub (A-B)   2 = q-cmp (1 iff A>=B)                   )
(            3 = q-mul16 (A*B, B taken as 16-bit)   4 = q-mul32 (A*B, both as 32-bit)     )
( output: 16 hex digits + newline, halt rc 0                                              )
(                                                                                        )
( The 64-bit decimal INPUT path is itself q-accdigit, i.e. q-mul16 + q-add on every token, )
( so no test here can pass by accident with a carry removed — a broken carry corrupts the  )
( operands before the operation under test ever runs.                                      )
(                                                                                        )
( zero page 00..3f is this harness's: 00 op · 02 tok · 04..0a acc · 0c..12 A · 14..1a B.   )
( 40..5f is arith32.tal's register file, 60..8b is arith64.tal's.                          )

|0100
    ;on-console #10 DEO2
    BRK

@on-console
    #12 DEI
    DUP #0a NEQ ,&digit JCN
    POP
    ;token-done JMP2
    &digit
    #30 SUB #00 SWP                  ( digit as a short )
    ;push-digit JMP2

( acc = acc*10 + digit, in 64 bits, via the library's own primitives )
@push-digit ( digit* -- )
    #04 LDZ2 #60 STZ2                ( A = acc )
    #06 LDZ2 #62 STZ2
    #08 LDZ2 #64 STZ2
    #0a LDZ2 #66 STZ2
    ;q-accdigit JSR2
    #60 LDZ2 #04 STZ2                ( acc = A )
    #62 LDZ2 #06 STZ2
    #64 LDZ2 #08 STZ2
    #66 LDZ2 #0a STZ2
    BRK

@token-done
    #02 LDZ #00 EQU ,&t0 JCN
    #02 LDZ #01 EQU ,&t1 JCN
    ,&t2 JMP
    &t0
    #0a LDZ2 #00 STZ2                ( op = acc's least significant word )
    ,&next JMP
    &t1
    #04 LDZ2 #0c STZ2                ( A = acc )
    #06 LDZ2 #0e STZ2
    #08 LDZ2 #10 STZ2
    #0a LDZ2 #12 STZ2
    ,&next JMP
    &next
    #0000 #04 STZ2                   ( acc = 0 )
    #0000 #06 STZ2
    #0000 #08 STZ2
    #0000 #0a STZ2
    #02 LDZ INC #02 STZ              ( tok++ )
    BRK
    &t2
    #04 LDZ2 #14 STZ2                ( B = acc )
    #06 LDZ2 #16 STZ2
    #08 LDZ2 #18 STZ2
    #0a LDZ2 #1a STZ2
    ;run JMP2

@run
    #0c LDZ2 #60 STZ2                ( A -> the library's A )
    #0e LDZ2 #62 STZ2
    #10 LDZ2 #64 STZ2
    #12 LDZ2 #66 STZ2
    #14 LDZ2 #68 STZ2                ( B -> the library's B )
    #16 LDZ2 #6a STZ2
    #18 LDZ2 #6c STZ2
    #1a LDZ2 #6e STZ2
    #00 LDZ2 #0000 EQU2 ,&do-add JCN
    #00 LDZ2 #0001 EQU2 ,&do-sub JCN
    #00 LDZ2 #0002 EQU2 ,&do-cmp JCN
    #00 LDZ2 #0003 EQU2 ,&do-mul16 JCN
    ,&do-mul32 JMP
    &do-add   ;q-add JSR2 ,&out JMP
    &do-sub   ;q-sub JSR2 ,&out JMP
    &do-cmp   ;q-cmp JSR2 #00 SWP #66 STZ2
              #0000 #60 STZ2 #0000 #62 STZ2 #0000 #64 STZ2 ,&out JMP
    &do-mul16 #1a LDZ2 #7e STZ2 ;q-mul16 JSR2 ,&out JMP
    &do-mul32 ;q-mul32 JSR2
    &out
    #60 LDZ2 ;emit-hex16 JSR2
    #62 LDZ2 ;emit-hex16 JSR2
    #64 LDZ2 ;emit-hex16 JSR2
    #66 LDZ2 ;emit-hex16 JSR2
    #0a #18 DEO
    #80 #0f DEO
    BRK

@emit-hex16 ( v* -- )
    DUP2 #0c SFT2 #000f AND2 ;emit-nib JSR2
    DUP2 #08 SFT2 #000f AND2 ;emit-nib JSR2
    DUP2 #04 SFT2 #000f AND2 ;emit-nib JSR2
    #000f AND2 ;emit-nib JSR2
    JMP2r

@emit-nib ( n* -- )
    NIP
    DUP #0a LTH ,&dig JCN
    #37 ADD #18 DEO
    JMP2r
    &dig
    #30 ADD #18 DEO
    JMP2r

~arith32.tal
~arith64.tal
