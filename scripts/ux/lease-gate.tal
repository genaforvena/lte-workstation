( lease-gate.tal — reflex lease-vs-cadence gate, ported from mesh-reflex-health )
( eff_maxage(@auto): a watchdog lease MUST be >= 2x the producer's cadence, )
( else it flaps STALE every cycle while the reflex is perfectly healthy. )
( input  : argv "<cadence-seconds>" "<lease-seconds>" (uxncli feeds them nl-terminated) )
( verdict: prints "OK\n" and halts green iff lease >= 2*cadence, else "RED\n" )
( DOMAIN: ints are 16-bit. Any parse overflow (value > 65535) or cad > 32767 )
( (2*cad would wrap) answers "NA\n" + halt #82 (rc 2, honest n/a) — never a )
( wrapped verdict (2026-07-23: 67335 wrapped to 1799 = false RED; 33000/60000 )
( wrapped the threshold to 464 = false GREEN; found by mesh-rom-calibrate). )
( zero-page vars: cad=00 lease=02 acc=04 tok=06 ovf=07 )

|0100                        ( reset vector )
    ;on-console #10 DEO2     ( install Console/vector )
    BRK

@on-console
    #12 DEI                  ( Console/read -> byte )
    DUP #0a NEQ ,&digit JCN  ( not newline -> accumulate a digit )
    POP                      ( newline: drop it, finalize the token )
    #06 LDZ #00 EQU ,&first JCN
    #04 LDZ2 #02 STZ2        ( 2nd token -> lease = acc )
    ,&decide JMP
    &first
    #04 LDZ2 #00 STZ2        ( 1st token -> cad = acc )
    #0000 #04 STZ2           ( acc = 0 )
    #01 #06 STZ              ( tok = 1 )
    BRK
    &digit
    #30 SUB                  ( byte-'0' -> digit d )
    ( 16-bit overflow pre-check: acc*10+d > 65535 iff acc > 6553, or acc == 6553 && d > 5 )
    #04 LDZ2 #1999 GTH2 ,&ovf-set JCN
    DUP #05 GTH #04 LDZ2 #1999 EQU2 AND ,&ovf-set JCN
    &digit-acc
    #00 SWP                  ( promote to short )
    #04 LDZ2 #000a MUL2      ( acc*10 )
    ADD2
    #04 STZ2                 ( acc = acc*10 + digit )
    BRK
    &ovf-set
    #01 #07 STZ              ( ovf = 1; keep consuming, value is garbage but flagged )
    ,&digit-acc JMP
    &decide
    #07 LDZ ,&na JCN         ( parse overflowed somewhere -> domain n/a )
    #00 LDZ2 #7fff GTH2 ,&na JCN  ( cad > 32767 -> 2*cad would wrap -> n/a )
    #00 LDZ2 #0002 MUL2      ( threshold = 2*cad )
    #02 LDZ2                 ( lease )
    GTH2                     ( threshold > lease  -> RED )
    ,&red JCN
    ;ok-str ;emit JSR2
    ,&halt JMP
    &red
    ;red-str ;emit JSR2
    &halt
    #80 #0f DEO              ( System/state: 0x80 -> halt, exit code 0 — modern state&0x7f convention )
    BRK
    &na
    ;na-str ;emit JSR2
    #82 #0f DEO              ( halt, exit 2 — honest domain n/a, never a wrapped verdict )
    BRK

@emit ( str* -- )
    &loop
    LDAk #00 EQU ,&done JCN
    LDAk #18 DEO
    INC2 ,&loop JMP
    &done
    POP2
    JMP2r

@ok-str  "OK  0a 00
@red-str "RED 0a 00
@na-str  "NA  0a 00
