( rot13.tal — one-hop pipe-stage spike: stdin -> ROT13 -> stdout )
( behavior-as-payload demo: transport stays ssh, the ROM is the program )
( stdin bytes arrive Console/type=1; EOF arrives type=4 -> halt #80 clean )

|0100                        ( reset vector )
    ;on-console #10 DEO2     ( install Console/vector )
    BRK

@on-console
    #17 DEI #04 EQU ,&eof JCN     ( type 4 = EOF -> halt )
    #17 DEI #01 NEQ ,&pass JCN    ( only stdin bytes )
    #12 DEI                       ( c )
    DUP #60 GTH ,&low JCN         ( c > 0x60 -> lowercase range? )
    DUP #40 GTH ,&up JCN          ( c > 0x40 -> uppercase range? )
    &emit
    #18 DEO
    BRK
    &pass BRK
    &low
    DUP #7a GTH ,&emit JCN        ( past 'z' -> raw )
    #61 ;rot JSR2
    ,&emit JMP
    &up
    DUP #5a GTH ,&emit JCN        ( past 'Z' -> raw )
    #41 ;rot JSR2
    ,&emit JMP
    &eof
    #80 #0f DEO                   ( System/state: halt, exit 0 )
    BRK

@rot ( c base -- c' )
    SWP OVR SUB                   ( base d=c-base )
    #0d ADD                       ( base d+13 )
    DUP #19 GTH ,&wrap JCN        ( d+13 > 25 -> wrap )
    &join ADD JMP2r
    &wrap #1a SUB ,&join JMP
