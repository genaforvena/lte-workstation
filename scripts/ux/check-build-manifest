#!/usr/bin/env python3
"""Validate the UXN generated-output inventory against its sources and files."""

from __future__ import annotations

import csv
import hashlib
import sys
from pathlib import Path, PurePosixPath


ROOT = Path(__file__).resolve().parent
MANIFEST = ROOT / "uxn-build-manifest.tsv"
FIELDS = ("output", "kind", "inputs", "recipe", "sha256")


def fail(message: str) -> int:
    print(f"uxn-build-manifest: FAIL: {message}", file=sys.stderr)
    return 1


def main() -> int:
    try:
        with MANIFEST.open(encoding="utf-8", newline="") as stream:
            reader = csv.DictReader(stream, delimiter="\t")
            if tuple(reader.fieldnames or ()) != FIELDS:
                return fail(f"expected columns: {' '.join(FIELDS)}")
            rows = list(reader)
    except OSError as exc:
        return fail(f"cannot read {MANIFEST}: {exc}")

    outputs: dict[str, dict[str, str]] = {}
    for number, row in enumerate(rows, start=2):
        output = row["output"]
        path = PurePosixPath(output)
        if path.is_absolute() or ".." in path.parts or output in outputs:
            return fail(f"line {number}: unsafe or duplicate output {output!r}")
        if row["kind"] not in {"rom", "symbols", "binary"}:
            return fail(f"line {number}: unknown output kind {row['kind']!r}")
        if not row["recipe"].strip() or not row["sha256"].strip():
            return fail(f"line {number}: recipe and sha256 are required")
        if row["kind"] == "binary" and row["sha256"] != "-":
            return fail(f"line {number}: platform-specific binary {output!r} must not pin a host sha256")
        if row["kind"] != "binary" and len(row["sha256"]) != 64:
            return fail(f"line {number}: {row['kind']} output {output!r} needs a sha256")
        inputs = [item for item in row["inputs"].split(";") if item]
        if not inputs:
            return fail(f"line {number}: output {output!r} has no declared inputs")
        for item in inputs:
            input_path = PurePosixPath(item)
            if input_path.is_absolute() or ".." in input_path.parts or not (ROOT / item).is_file():
                return fail(f"line {number}: missing or unsafe input {item!r} for {output!r}")
        outputs[output] = row

    actual: set[str] = set()
    actual.update(path.relative_to(ROOT).as_posix() for path in ROOT.rglob("*.rom") if path.is_file())
    actual.update(path.relative_to(ROOT).as_posix() for path in ROOT.rglob("*.rom.sym") if path.is_file())
    bin_dir = ROOT / "bin"
    if bin_dir.is_dir():
        actual.update(path.relative_to(ROOT).as_posix() for path in bin_dir.iterdir() if path.is_file())
    unlisted = sorted(actual - outputs.keys())
    if unlisted:
        return fail(f"unlisted generated output(s): {', '.join(unlisted)}")
    missing = sorted(set(outputs) - actual)
    required_missing = [name for name in missing if outputs[name]["kind"] == "rom"]
    if required_missing:
        return fail(f"missing pinned ROM output(s): {', '.join(required_missing)}")

    checked = 0
    for output in sorted(actual):
        row = outputs[output]
        expected = row["sha256"]
        if expected == "-":
            if row["kind"] != "binary":
                return fail(f"present output {output!r} has no recorded sha256")
            continue
        actual_sha = hashlib.sha256((ROOT / output).read_bytes()).hexdigest()
        if actual_sha != expected:
            return fail(f"sha256 mismatch for {output}: expected {expected}, got {actual_sha}")
        checked += 1

    print(
        f"uxn-build-manifest: PASS ({len(outputs)} declared outputs; "
        f"{len(actual)} present, {checked} hash-verified)"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
