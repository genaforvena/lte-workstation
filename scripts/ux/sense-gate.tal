( sense-gate.tal — a STRUCTURAL real-read gate: the third gate CLASS for the Uxn pilot. )
( Where lease-gate is one ratio and band-gate is one range, this is the COMPOUND )
( predicate a sense's --test actually needs: a read is REAL only if it carries )
( enough axes/samples (count), is recent enough (freshness), and has moved )
( (variance). Each of those is a hollow-sense failure mode a green --test sailed )
( past — the mag/gyro driver race (0 axes, green 5 days), the frozen HAL cache )
( (age infinite, byte-identical, green), the change-gated emitter that never fires )
( (var 0, green 10 days). The ROM owns the three-way AND and names the first axis )
( that fails; the HOST owns measuring count/age/var (no floats, no sum-of-squares )
( in the 16-bit machine — same split as series-stats, where the host sorts and the )
( ROM reduces). )
( input  : argv "<min_n>" "<n>" "<max_age>" "<age>" "<min_var>" "<var>" )
(          [uxncli feeds them nl-terminated] )
(          a floor/ceiling of 0 means "no requirement on that axis" (partial spec); )
(          ALL three zero means "no structural check at all" -> NA (refuse to )
(          rubber-stamp a read nothing was asked about — a check asserting nothing )
(          passes everything, the silent-green trap). )
( verdict: "OK"        iff every non-zero floor/ceiling holds )
(          "RED count" first failed axis named (n < min_n) )
(          "RED age"                          (age > max_age) )
(          "RED var"                          (var < min_var) )
(          "NA"       parse overflow OR empty spec; halts. )
( DOMAIN:  16-bit ints; a token > 65535 overflows the parse -> NA rc 2 (never a )
( wrapped verdict — a 5-day-stale age cannot be represented and must refuse, not )
( wrap to a plausible young number). In-domain boundary pairs still verdict. )
( zero-page: min_n=00 n=02 max_age=04 age=06 min_var=08 var=0a acc=0c tok=0e ovf=0f )

|0100                        ( reset vector )
    ;on-console #10 DEO2     ( install Console/vector )
    BRK

@on-console
    #12 DEI                  ( Console/read -> byte )
    DUP #0a NEQ ,&digit JCN  ( not newline -> accumulate a digit )
    POP                      ( newline: drop it, finalize the token )
    ( store acc at zptr[tok*2]; fields are stride-2: 00 02 04 06 08 0a )
    #0c LDZ2                 ( value = acc )
    #0e LDZ DUP ADD          ( addr = tok*2, a byte in 0..10 )
    STZ2                     ( zptr[tok*2] = acc )
    #0000 #0c STZ2           ( acc = 0 )
    #0e LDZ INC #0e STZ      ( tok++ )
    #0e LDZ #06 EQU ,&decide JCN ( 6 tokens stored -> decide, else await next )
    BRK
    &digit
    #30 SUB                  ( byte-'0' -> digit d )
    ( 16-bit overflow pre-check, same guard as lease-gate: acc*10+d > 65535 iff )
    ( acc > 6553, OR (acc == 6553 && d > 5). Sticky flag — keep consuming, refuse at decide. )
    #0c LDZ2 #1999 GTH2 ,&ovf-set JCN
    DUP #05 GTH #0c LDZ2 #1999 EQU2 AND ,&ovf-set JCN
    &digit-acc
    #00 SWP                  ( promote digit to short )
    #0c LDZ2 #000a MUL2      ( acc*10 )
    ADD2                     ( acc*10 + d )
    #0c STZ2                 ( acc = acc*10 + d )
    BRK
    &ovf-set
    #01 #0f STZ              ( ovf = 1 )
    ,&digit-acc JMP
    &decide
    #0f LDZ ,&na JCN         ( parse overflowed somewhere -> domain n/a )
    ( empty spec: min_n==0 && max_age==0 && min_var==0 -> refuse to rubber-stamp )
    #00 LDZ2 #0000 EQU2
    #04 LDZ2 #0000 EQU2 AND
    #08 LDZ2 #0000 EQU2 AND
    ,&na JCN
    ( count axis: n < min_n  (skipped when min_n == 0 — no count requirement) )
    #00 LDZ2 #0000 EQU2 ,&ck-age JCN
    #02 LDZ2 #00 LDZ2 LTH2 ,&red-count JCN
    &ck-age
    ( freshness axis: age > max_age  (skipped when max_age == 0) )
    #04 LDZ2 #0000 EQU2 ,&ck-var JCN
    #06 LDZ2 #04 LDZ2 GTH2 ,&red-age JCN
    &ck-var
    ( variance axis: var < min_var  (skipped when min_var == 0) )
    #08 LDZ2 #0000 EQU2 ,&ok JCN
    #0a LDZ2 #08 LDZ2 LTH2 ,&red-var JCN
    &ok
    ;ok-str ;emit JSR2
    ,&halt JMP
    &red-count
    ;redc-str ;emit JSR2
    ,&halt JMP
    &red-age
    ;reda-str ;emit JSR2
    ,&halt JMP
    &red-var
    ;redv-str ;emit JSR2
    ,&halt JMP
    &na
    ;na-str ;emit JSR2
    #82 #0f DEO              ( halt, exit 2 — honest domain n/a, never a wrapped verdict; same as lease-gate )
    BRK
    &halt
    #80 #0f DEO              ( System/state: 0x80 -> halt, exit 0 — verdict is TEXT (OK/RED); rc only means "ran" )
    BRK

@emit ( str* -- )
    &loop
    LDAk #00 EQU ,&done JCN
    LDAk #18 DEO
    INC2 ,&loop JMP
    &done
    POP2
    JMP2r

@ok-str   "OK 0a 00
( reasons spelled in hex: uxnasm ends a "string at the first space, so the space (20) and the )
( word are emitted as bytes. A human running the ROM directly still reads "RED count", "RED age", etc. )
@redc-str "RED 20 63 6f 75 6e 74 0a 00
@reda-str "RED 20 61 67 65 0a 00
@redv-str "RED 20 76 61 72 0a 00
@na-str   "NA 0a 00
