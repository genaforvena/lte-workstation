( hop-dial.tal — the SENDER half of the hop's net lane: a uxp1 packet over TCP. )
(                                                                                        )
( The pipe lane's transport is ssh, which needs a shell, a key and an account on the far )
( node. This one needs a socket. The far node runs hop-serve.rom and nothing else — no )
( shell at all — which is the whole point of teaching the hop to bind. )
(                                                                                        )
( input  : argv[1] = the address, colon-separated 'tcp:host:port'. )
(          stdin   = the packet, RAW BYTES [header line + rom + payload]. NULs included: )
(                    a byte arrives as type 1, EOF as type 4, so binary survives. )
( output : whatever the far node writes back, verbatim on stdout, rc 0. )
(          "NA" + newline, rc 2 — no link, a zero-length write, or nothing came back. )
(          "NODEV" + newline, rc 3 — this emulator has no 0xd0 device. )
(                                                                                        )
( TYPE 4 ARRIVES TWICE and conflating them loses the packet: console_arguments ends the )
( argv run with '\n' at CONSOLE_END [4], and stdin EOF is ALSO type 4. A phase flag in )
( zp 00 tells them apart — without it the ROM dials before a single payload byte lands. )
(                                                                                        )
( SHORT WRITES ARE NORMAL on a socket and the device REPORTS them rather than retrying )
( silently, so the send loop advances by what was ACTUALLY written, never by what was )
( asked for. A zero-length write is a refusal, not a retry: spinning on it would turn a )
( dead peer into a hang, which is the one failure that reads green from outside. )
(                                                                                        )
( THE READ SIDE ENDS ON THE PEER, NOT ON A TIMER: length 0 with state Disconnected means )
( the far node closed and we have everything; length 0 while still Connected means it is )
( merely slow, and that is bounded by device deadlines rather than by a spin — three )
( while waiting for the answer to START, one after it has begun. )
(                                                                                        )
( zero-page: phase=00 aptr=02 pptr=04 plen=06 sent=08 chunk=0a tries=0c i=0e )

|0100
    #0000 #d4 DEO2           ( clear the length register: a device-less page reads this back )
    #d0 #da DEO              ( action d0 Identify — only the DEVICE answers )
    #d4 DEI #d0 NEQ ,&nodev JCN
    #d5 DEI #01 LTH ,&nodev JCN   ( dialing needs step >= 1 )
    ;on-console #10 DEO2
    ;addr-buf #02 STZ2
    ;pkt-buf #04 STZ2
    BRK
    &nodev ;no-dev JMP2

@on-console
    #17 DEI #04 EQU ,&end JCN     ( type 4 — end of ARGV or end of STDIN, see the header )
    #17 DEI #01 EQU ,&std JCN     ( type 1 — a stdin byte )
    #12 DEI #02 LDZ2 STA          ( otherwise an argv byte )
    #02 LDZ2 INC2 #02 STZ2
    BRK
    &std
    #12 DEI #04 LDZ2 STA
    #04 LDZ2 INC2 #04 STZ2
    BRK
    &end
    #00 LDZ #00 EQU ,&argv-done JCN
    ;send JMP2                    ( phase 1: stdin ended — dial and send )
    &argv-done
    #01 #00 STZ
    #00 #02 LDZ2 STA              ( NUL-terminate the address in place )
    BRK

@send
    #04 LDZ2 ;pkt-buf SUB2 #06 STZ2        ( plen = pptr - pkt-buf )
    #06 LDZ2 #0000 EQU2 ,&empty JCN
    ;addr-buf #d2 DEO2                     ( the low byte of the addr port IS the dial )
    #da DEI #02 LTH ,&bad JCN              ( 0 Disconnected / 1 Connecting are refusals )
    #0000 #08 STZ2
    &w
    #06 LDZ2 #08 LDZ2 SUB2 #0a STZ2        ( chunk = plen - sent )
    #0a LDZ2 #0400 GTH2 ,&cap JCN
    ,&wgo JMP
    &cap #0400 #0a STZ2
    &wgo
    #0a LDZ2 #d4 DEO2
    ;pkt-buf #08 LDZ2 ADD2 #d8 DEO2        ( the low byte of the write port sends it )
    #d4 DEI2 #0000 EQU2 ,&bad JCN          ( wrote nothing: refuse, never spin )
    #08 LDZ2 #d4 DEI2 ADD2 #08 STZ2        ( advance by what was ACTUALLY written )
    #08 LDZ2 #06 LDZ2 NEQ2 ,&w JCN
    #03 #0c STZ
    ;recv JMP2
    &empty ;na JMP2
    &bad ;na JMP2

@recv
    #00 #10 STZ                  ( nothing received yet — an empty answer is NA, not rc 0 )
    &r
    #0400 #d4 DEO2
    ;in-buf #d6 DEO2
    #d4 DEI2 #0000 EQU2 ,&r0 JCN
    #01 #10 STZ
    #0000 #0e STZ2
    &p
    ;in-buf #0e LDZ2 ADD2 LDA #18 DEO
    #0e LDZ2 INC2 #0e STZ2
    #0e LDZ2 #d4 DEI2 NEQ2 ,&p JCN
    #01 #0c STZ                  ( PATIENT for the first byte, IMPATIENT after: nothing )
                                 ( can half-close a uxn socket [the uxn2 map has no )
                                 ( shutdown], so a finished peer is only knowable by one )
                                 ( expired deadline. Keeping 3 here charged every hop three )
                                 ( idle timeouts after the answer was already in hand. )
    ,&r JMP
    &r0
    #da DEI #00 EQU ,&done JCN   ( Disconnected — the peer closed, we have it all )
    #0c LDZ #01 SUB #0c STZ
    #0c LDZ #00 EQU ,&done JCN   ( out of patience: whatever came is what there is )
    ,&r JMP
    &done
    #10 LDZ #00 EQU ,&nothing JCN
    #80 #0f DEO                  ( halt, exit 0 )
    BRK
    &nothing ;na JMP2

@na
    ;na-str ;emit JSR2
    #82 #0f DEO                  ( halt, exit 2 — a claim about the LINK )
    BRK

@no-dev
    ;nodev-str ;emit JSR2
    #83 #0f DEO                  ( halt, exit 3 — a claim about THIS EMULATOR )
    BRK

@emit                            ( str* -- )
    &l LDAk #00 EQU ,&d JCN
    LDAk #18 DEO INC2 ,&l JMP
    &d POP2
    JMP2r

@na-str "NA 0a 00
@nodev-str "NODEV 0a 00

@addr-buf $100
@in-buf   $400
@pkt-buf  $6000
