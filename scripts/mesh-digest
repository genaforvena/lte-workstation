#!/usr/bin/env bash
# mesh-digest — BRAINLESS daily summary of what changed, for the operator. $0 by default
# (pure git log + file mtimes + greps); a cheap mind can prettify but is never required.
#   mesh-digest          print today's digest to stdout
#   mesh-digest --send   also send it to the operator's Telegram (via mesh-tg)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
REPO="${MESH_REPO:-$HOME/lte-workstation}"; K="$HOME/.mesh/knowledge"; CHAT="$HOME/.mesh/chat.log"
if [ "${1:-}" = "--test" ]; then
  for x in date mktemp git find grep head basename xargs sed tailscale rm cat python3; do
    command -v "$x" >/dev/null 2>&1 || { echo "smoke-test: FAIL (no $x)"; exit 1; }
  done
  [ -d "$REPO/.git" ] || { echo "smoke-test: FAIL (no repo)"; exit 1; }
  [ -d "$K" ] || { echo "smoke-test: FAIL (no knowledge dir)"; exit 1; }
  [ -f "$CHAT" ] && [ -r "$CHAT" ] || { echo "smoke-test: FAIL (no readable chat log)"; exit 1; }
  tailscale status >/dev/null 2>&1 || { echo "smoke-test: FAIL (tailscale unavailable)"; exit 1; }
  # Artifact test: digest must render and contain the expected header (proves git+grep pipeline works)
  out="$("$0" 2>/dev/null)" || { echo "smoke-test: FAIL (digest render errored)"; exit 1; }
  # [[ ]] substring match, NOT printf|grep -q: under pipefail, grep -q exiting at first
  # match SIGPIPEs the printf on a big digest → spurious rc=141 FAIL (flaky doctor red)
  [[ "$out" == *'mesh digest'* ]] || { echo "smoke-test: FAIL (rendered digest missing header — render pipeline broken)"; exit 1; }
  [[ "$out" == *'coordination (territorialization'* ]] || { echo "smoke-test: FAIL (territorialization instrument not wired into render)"; exit 1; }
  [[ "$out" == *'capacity-asymmetry'* ]] || { echo "smoke-test: FAIL (capacity-asymmetry instrument not wired into render)"; exit 1; }
  echo "smoke-test: ok ($(printf '%s' "$out" | wc -l) lines rendered)"; exit 0
fi
DAY="$(date -u +%Y-%m-%d)"
F="$(mktemp)"
{
  echo "🌿 mesh digest — $DAY (UTC)"
  # LEAD WITH WHAT NEEDS THE OPERATOR: the digest is for an away human, so surface OPERATOR-RELEVANT
  # events first — security ([lan-new-device]), safety ([router-hot]), and explicit flags/blockers —
  # distinct from the INTERNAL churn ([strand]/[drift]/[doctor]) the mesh self-handles (those are in
  # self-healing + novelty below). Usually empty = reassuring; when not, it's the thing to act on.
  echo; echo "── ⚠ NEEDS YOU ──"
  # CURRENT critical state first: is egress geo-blocked RIGHT NOW? (the core vulnerability — RU egress
  # → Anthropic 403 → cloud minds die). Direct from the egress-health state, not event-grepping.
  es=$(cat "$HOME/.mesh/.egress-state" 2>/dev/null)
  if [ "$es" = BAD ]; then
    echo "• 🚨 EGRESS GEO-BLOCKED NOW — cloud minds at risk. Run mesh-fix-egress. ($(tail -1 "$HOME/.mesh/egress-health.log" 2>/dev/null | sed 's/.*BAD //' | cut -c1-60))"
  else
    echo "• ✓ egress healthy ($(grep -aoE 'egress=[A-Z]+|iso=[A-Z]+' "$HOME/.mesh/egress-health.log" 2>/dev/null | tail -1 | cut -d= -f2 || echo NL))"
  fi
  cutoff=$(date -u -d "@$(( $(date -u +%s) - 86400 ))" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)
  # Only what genuinely needs a human AND can't self-resolve: NEW devices on the LAN (a security fact
  # to review — no auto-recovery). Self-healing alarms (doctor/health/drift/router-hot) are summarised
  # in self-healing below; transient [flag]/[incident] are excluded (no resolution tracking → stale).
  # author-filtered (lan-watch@) so prose that MENTIONS the tag (a [done] about the tool) isn't counted.
  nd=$(grep -aE "lan-watch@[^ ]+ +:: +\[lan-new-device\]" "$CHAT" 2>/dev/null | awk -v d="$cutoff" '$1 >= d' | sed 's/  ::  / /' | cut -c1-130 | tail -6)
  if [ -n "$nd" ]; then echo "• NEW device(s) on your home network — review if unexpected:"; printf '%s\n' "$nd" | sed 's/^/  - /'
  else echo "• ✓ no new devices on your home network"; fi
  # DERIVE the pending decisions from PLAN's "⛔ DECISIONS AWAITING YOU" numbered block so this line
  # never goes stale (a hardcoded list silently omitted the robot + drifts as decisions resolve).
  PLAN="$HOME/.mesh/PLAN.md"
  decs=$(grep -aE '^[0-9]+\. \*\*' "$PLAN" 2>/dev/null | sed -E 's/^[0-9]+\. \*\*//; s/\*\*.*//; s/ *\([^)]*\)//; s/ *$//' | paste -sd '|' - 2>/dev/null | sed 's/|/ · /g')
  ndec=$(grep -acE '^[0-9]+\. \*\*' "$PLAN" 2>/dev/null)
  if [ -n "$decs" ]; then echo "• ${ndec} decision(s) await your input → top of ~/.mesh/PLAN.md ($decs)"
  else echo "• decisions await your input → top of ~/.mesh/PLAN.md"; fi
  # then the highest-information (Shannon-surprise) events — what was genuinely NOVEL. (mesh-novelty)
  if command -v mesh-novelty >/dev/null 2>&1; then
    echo; echo "── novelty (most surprising, by bits) ──"
    mesh-novelty --window 60 2>/dev/null | grep -aE '^[[:space:]]+[0-9]' | head -5 | grep -a . || echo "• (all routine today)"
  fi
  # SELF-HEALING, quantified: proactive proof for an away operator that the mesh tended itself —
  # incidents auto-recovered + mean-time-to-recovery over the last 24h. (mesh-reliability)
  if command -v mesh-reliability >/dev/null 2>&1; then
    echo; echo "── self-healing (24h) ──"
    mesh-reliability --window 24 2>/dev/null | grep -a . || echo "• reliability: (unavailable)"
  fi
  echo; echo "── code (git, today) ──"
  ( cd "$REPO" 2>/dev/null && git log --since="$DAY 00:00" --pretty='• %s' 2>/dev/null | head -20 ) | grep -a . || echo "• (no commits)"
  echo; echo "── knowledge (gossiped, changed today) ──"
  find "$K" -name '*.md' -newermt "$DAY 00:00" 2>/dev/null | xargs -rn1 basename 2>/dev/null | sed 's/^/• /' | grep -a . || echo "• (none)"
  echo; echo "── web-of-trust (provenance, today) ──"
  grep -h "$DAY" "$K"/provenance-*.log 2>/dev/null | sed -E 's/^[^ ]+  /• /' | head -8 | grep -a . || echo "• (no new SEEN/VOUCH)"
  echo; echo "── notable (chat: news/done/task, recent) ──"
  grep -aE '\[news\]|\[done\]|\[task\]' "$CHAT" 2>/dev/null | tail -6 | sed 's/  ::  / /;s/^/• /' | cut -c1-130 | grep -a . || echo "• (nothing flagged)"
  echo; echo "── reachability ──"
  echo "• tag:lte-node active peers: $(tailscale status 2>/dev/null | grep -c 'active')"
  # COORDINATION TERRITORIALIZATION — DeLanda's "degree of territorialization" (assemblage theory's
  # concrete self-measurement: the adjustable parameter of how HOMOGENIZED / concentrated an assemblage
  # is; high = identity fixed onto few components, low = dispersed/heterogeneous). Operationalized here
  # as: what share of the last-24h board AGENCY (coordination acts) originates on a SINGLE node? Doctrine
  # asserts "no fixed mind / don't planner-centralize" ([[no-fixed-mind-stigmergic-skeleton]]) — this
  # MEASURES that claim instead of repeating it. The network/egress layer is SPOF-hardened; the
  # COORDINATION layer was never measured — 100% from one node = the assemblage has re-territorialized
  # onto a coordination SPOF (a node whose loss silences all coordination), even with role diversity.
  # $0, board-only, no inference. Reflex-cadence inherited from mesh-digest's own scheduling.
  echo; echo "── coordination (territorialization, 24h) ──"
  whos=$(awk -F'  ::  ' -v d="$cutoff" 'NF>1 { n=split($1,a," "); if (a[1] >= d) print a[n] }' "$CHAT" 2>/dev/null)
  if [ -n "$whos" ]; then
    total=$(printf '%s\n' "$whos" | grep -c .)
    ranked=$(printf '%s\n' "$whos" | sed 's/.*@//' | sort | uniq -c | sort -rn)
    topn=$(printf '%s\n' "$ranked" | head -1 | awk '{print $1}')
    topnode=$(printf '%s\n' "$ranked" | head -1 | awk '{$1="";sub(/^ /,"");print}')
    nnode=$(printf '%s\n' "$ranked" | grep -c .)
    nrole=$(printf '%s\n' "$whos" | sort -u | grep -c .)
    pct=$(( topn * 100 / (total>0?total:1) ))
    band="spread"; [ "$pct" -ge 90 ] && band="HIGH — coordination SPOF (re-territorialized onto one node)"
    echo "• ${pct}% of coordination from ${topnode} · ${nnode} node(s), ${nrole} role(s), ${total} acts/24h · territorialization=${band}"
  else
    echo "• (no board agency in last 24h)"
  fi
  # CAPACITY-ASYMMETRY (the axis territorialization-above does NOT measure) — LITERATURE (live review,
  # what's NEW in D&G/assemblage theory 2023-2026): Will Atkinson, "Field Theory and Assemblage Theory:
  # Toward a Constructive Dialogue", Theory, Culture & Society 41(x), 2024 (sagepub doi
  # 10.1177/02632764231167774). Its core charge: assemblage theory richly describes WHAT connects to what
  # (the flat rhizome — every point to every other) but UNDER-theorizes the ASYMMETRY OF CAPACITY-TO-AFFECT
  # — some components have vastly more power to alter the whole than others, and that asymmetry STRUCTURES
  # the assemblage. (DeLanda's own ground: a CAPACITY is not a property and is relational + asymmetric — a
  # knife's capacity to cut is real only in conjunction with the cuttable; some couplings dominate.)
  #
  # THE GAP THIS NAMES: the territorialization block ABOVE measures concentration of board AGENCY (who ACTS
  # most). Capacity-to-affect is ORTHOGONAL: whose CHANGE/FAILURE propagates furthest. A near-SILENT node
  # (low territorialization — posts almost nothing) can hold enormous capacity-to-affect — the sole egress,
  # the substrate-holder, the only offerer of a fungible cap, the steward that lands everyone's tree. The
  # mesh's self-image is the FLAT rhizome ([[no-fixed-mind-stigmergic-skeleton]], [[all-is-text-prediction-discipline]]
  # — every node a peer); but the field is NOT flat in capacity, and the whole SPOF lineage (substrate
  # single-writer can strand the mesh; body-only senses; coordination-on-one-node) is exactly this
  # unmeasured asymmetry. Territorialization catches the SPOF that TALKS a lot; it is blind to the silent
  # one that everything DEPENDS on.
  #
  # DISTINCT from the four D&G axes already embodied: territorialization (THIS file, agency concentration);
  # relations-of-exteriority (mesh-organ cap-scope fungible|bound — component autonomy); the rhizome/plane
  # of consistency (mesh-sensor-tape — open self-declaring sense-plane); desire-as-production (mesh-needs —
  # productive forage). Capacity-asymmetry is the POWER/positioning axis none of them measure.
  # WIRED FIX (instrument-first, read-only): a conservative "capacity-asymmetry / blast-radius" line beside
  # the territorialization band. It scores declared live organ capacities from mesh-organs, weighting sole
  # offerers highest. This is not a full dependency graph, so it reports silent capacity concentration rather
  # than taking action or naming hard SPOFs.
  echo; echo "── capacity-asymmetry (assemblage, organ blast-radius) ──"
  if command -v mesh-organs >/dev/null 2>&1; then
    organs_json="$(timeout 20 mesh-organs --json 2>/dev/null || true)"
    cap_line="$(ORGANS_JSON="$organs_json" python3 - <<'PY'
import json
import os
import re

raw = os.environ.get("ORGANS_JSON", "").strip()
skip = {"", "-", "(none)", "(offline)", "(unreachable)", "(no", "data)", "(ssh", "fail)"}

def tokens(value):
    out = []
    for token in re.split(r"[, \t\r\n]+", value or ""):
        token = token.strip()
        if not token or token in skip or token.startswith("("):
            continue
        out.append(token)
    return out

try:
    rows = json.loads(raw)
except Exception:
    print("• capacity map unavailable (mesh-organs unreadable)")
    raise SystemExit

nodes = []
counts = {}
for row in rows:
    node = row.get("node") or "?"
    try:
        live = int(row.get("live") or 0)
    except Exception:
        live = 0
    try:
        total = int(row.get("total") or 0)
    except Exception:
        total = 0
    caps = tokens(row.get("senses", "")) + tokens(row.get("actuators", ""))
    caps = sorted(set(caps))
    if live <= 0 and not caps:
        continue
    nodes.append((node, caps, live, total))
    for cap in caps:
        counts[cap] = counts.get(cap, 0) + 1

if not nodes:
    print("• capacity map unavailable (no live organ rows)")
    raise SystemExit

scores = []
for node, caps, live, total in nodes:
    unique = [cap for cap in caps if counts.get(cap, 0) == 1]
    score = sum(1.0 / max(counts.get(cap, 1), 1) for cap in caps) + (0.05 * live)
    scores.append((score, node, unique, live, total))

all_score = sum(score for score, *_ in scores) or 1.0
score, node, unique, live, total = max(scores)
pct = round(score * 100 / all_score)
band = "spread"
if pct >= 60 or len(unique) >= 3:
    band = "HIGH - capacity-to-affect concentrated"
elif pct >= 40 or unique:
    band = "WATCH - asymmetric capacity"
unique_text = ", ".join(unique[:6]) if unique else "none"
print(f"• {pct}% capacity-to-affect in {node} · unique organs={unique_text} · live={live}/{total} · nodes={len(nodes)} · asymmetry={band}")
PY
)"
    printf '%s\n' "${cap_line:-• capacity map unavailable (empty result)}"
  else
    echo "• capacity map unavailable (mesh-organs missing)"
  fi
} > "$F"
cat "$F"
if [ "${1:-}" = "--send" ]; then
  if command -v mesh-tg >/dev/null 2>&1; then mesh-tg "$(cat "$F")" >/dev/null && echo "[sent to operator Telegram]"; else echo "[mesh-tg not found]"; fi
fi
rm -f "$F"
