#!/usr/bin/env bash
# mesh-digest — BRAINLESS daily summary of what changed, for the operator. $0 by default
# (pure git log + file mtimes + greps); a cheap mind can prettify but is never required.
#   mesh-digest          print today's digest to stdout
#   mesh-digest --send   also send it to the operator's Telegram (via mesh-tg)
set -uo pipefail
REPO="${MESH_REPO:-$HOME/lte-workstation}"; K="$HOME/.mesh/knowledge"; CHAT="$HOME/.mesh/chat.log"
if [ "${1:-}" = "--test" ]; then
  for x in date mktemp git find grep head basename xargs sed tailscale rm cat; do
    command -v "$x" >/dev/null 2>&1 || { echo "smoke-test: FAIL (no $x)"; exit 1; }
  done
  [ -d "$REPO/.git" ] || { echo "smoke-test: FAIL (no repo)"; exit 1; }
  [ -d "$K" ] || { echo "smoke-test: FAIL (no knowledge dir)"; exit 1; }
  [ -f "$CHAT" ] && [ -r "$CHAT" ] || { echo "smoke-test: FAIL (no readable chat log)"; exit 1; }
  tailscale status >/dev/null 2>&1 || { echo "smoke-test: FAIL (tailscale unavailable)"; exit 1; }
  echo "smoke-test: ok"
  exit 0
fi
DAY="$(date -u +%Y-%m-%d)"
F="$(mktemp)"
{
  echo "🌿 mesh digest — $DAY (UTC)"
  # LEAD WITH SIGNAL: the highest-information (Shannon-surprise) events first, so an absent
  # operator sees what was genuinely NOVEL before the routine volume. (mesh-novelty)
  if command -v mesh-novelty >/dev/null 2>&1; then
    echo; echo "── novelty (most surprising, by bits) ──"
    mesh-novelty --window 60 2>/dev/null | grep -aE '^[[:space:]]+[0-9]' | head -5 | grep -a . || echo "• (all routine today)"
  fi
  # SELF-HEALING, quantified: proactive proof for an away operator that the mesh tended itself —
  # incidents auto-recovered + mean-time-to-recovery over the last 24h. (mesh-reliability)
  if command -v mesh-reliability >/dev/null 2>&1; then
    echo; echo "── self-healing (24h) ──"
    mesh-reliability --window 24 2>/dev/null | grep -a . || echo "• reliability: (unavailable)"
  fi
  echo; echo "── code (git, today) ──"
  ( cd "$REPO" 2>/dev/null && git log --since="$DAY 00:00" --pretty='• %s' 2>/dev/null | head -20 ) | grep -a . || echo "• (no commits)"
  echo; echo "── knowledge (gossiped, changed today) ──"
  find "$K" -name '*.md' -newermt "$DAY 00:00" 2>/dev/null | xargs -rn1 basename 2>/dev/null | sed 's/^/• /' | grep -a . || echo "• (none)"
  echo; echo "── web-of-trust (provenance, today) ──"
  grep -h "$DAY" "$K"/provenance-*.log 2>/dev/null | sed -E 's/^[^ ]+  /• /' | head -8 | grep -a . || echo "• (no new SEEN/VOUCH)"
  echo; echo "── notable (chat: news/done/task, recent) ──"
  grep -aE '\[news\]|\[done\]|\[task\]' "$CHAT" 2>/dev/null | tail -6 | sed 's/  ::  / /;s/^/• /' | cut -c1-130 | grep -a . || echo "• (nothing flagged)"
  echo; echo "── reachability ──"
  echo "• tag:lte-node active peers: $(tailscale status 2>/dev/null | grep -c 'active')"
} > "$F"
cat "$F"
if [ "${1:-}" = "--send" ]; then
  if command -v mesh-tg >/dev/null 2>&1; then mesh-tg "$(cat "$F")" >/dev/null && echo "[sent to operator Telegram]"; else echo "[mesh-tg not found]"; fi
fi
rm -f "$F"
