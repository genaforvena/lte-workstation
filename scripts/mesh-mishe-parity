#!/usr/bin/env python3
"""Compare bounded cleaner shadow observations with durable task-ledger transitions."""
import argparse
from bisect import bisect_right
from datetime import datetime, timedelta, timezone
import json
import os
from pathlib import Path
import re
import sys


STATUSES = {"open", "active", "complete", "rejected", "blocked"}
EVENT_RE = re.compile(r"(\d+):(open|active|complete|rejected|blocked)\Z")
COUNT_RE = re.compile(r"^CLEANER: .*\btask-epoch=(\d+) task-event-count=(\d+) task-events=([^\n]+)$")
LEDGER_TIME_RE = re.compile(r"^(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ)\b")
IDENTITY_RE = re.compile(r"[0-9a-f]{32,64}\Z")
KINDS = {"pane", "task", "prediction", "critical"}


def unknown(reason: str) -> int:
    # Reasons are fixed strings and never include paths, task descriptions or feed bytes.
    print(f"mishe cleaner parity: UNKNOWN reason={reason}; authority=legacy")
    return 2


def timestamp(value: str) -> datetime:
    return datetime.fromisoformat(value.removesuffix("Z") + "+00:00")


def single(pattern: str, text: str) -> str | None:
    matches = re.findall(pattern, text)
    return matches[0] if len(matches) == 1 else None


def feed_class():
    core = os.environ.get("MESH_MISHE_CORE")
    if core:
        sys.path.insert(0, str(Path(core) / "src"))
    try:
        from mishe_tauftauf.feed import Feed
        return Feed
    except ModuleNotFoundError:
        selected = Path(os.environ.get("MESH_MISHE_PYTHON", str(Path.home() / ".mesh/venvs/mishe-tauftauf/bin/python")))
        if selected.is_file() and selected.resolve() != Path(sys.executable).resolve():
            os.execv(str(selected), [str(selected), __file__, *sys.argv[1:]])
        raise


def closed_window(channel: str, window: str, legacy_path: Path, projected_path: Path,
                  max_latency: int) -> int:
    """Compare attributable IDs only; timestamp proximity never invents a match."""
    try:
        left, right = window.split("/", 1)
        if not re.fullmatch(r"\d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ", left) or \
                not re.fullmatch(r"\d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ", right):
            raise ValueError
        start, end = timestamp(left), timestamp(right)
        if not re.fullmatch(r"[a-z][a-z0-9-]*", channel) or max_latency < 1 or \
                start >= end or end.timestamp() + max_latency > datetime.now(timezone.utc).timestamp():
            raise ValueError
    except (ValueError, TypeError):
        print("mishe parity: UNKNOWN reason=window")
        return 2

    def read(path: Path, expected: set[str]):
        rows = []
        invalid = 0
        with path.open(encoding="utf-8") as stream:
            for line in stream:
                try:
                    row = json.loads(line)
                    if not isinstance(row, dict):
                        raise ValueError
                    if "channel" not in row:
                        raise ValueError
                    if row["channel"] != channel:
                        continue
                    if set(row) != expected or not IDENTITY_RE.fullmatch(row["event_id"]) or row["kind"] not in KINDS:
                        raise ValueError
                    when = timestamp(row["at"])
                    bound = end if expected == legacy_fields else end + timedelta(seconds=max_latency)
                    if not start <= when < bound:
                        continue
                    if "feed_seq" in row and (type(row["feed_seq"]) is not int or row["feed_seq"] < 1 or
                                              row["source"] not in {"top-pane", "task-ledger", "prediction", "critical"}):
                        raise ValueError
                    rows.append((row["event_id"], row["kind"], when, row.get("feed_seq")))
                except (ValueError, TypeError, KeyError, UnicodeError):
                    invalid += 1
        return rows, invalid

    legacy_fields = {"channel", "event_id", "kind", "at"}
    projected_fields = legacy_fields | {"source", "feed_seq"}
    try:
        legacy, invalid_legacy = read(legacy_path, legacy_fields)
        projected, invalid_projected = read(projected_path, projected_fields)
    except (OSError, UnicodeError):
        print("mishe parity: UNKNOWN reason=evidence")
        return 2
    if not legacy:
        print("mishe parity: UNKNOWN sample=0 missing=0 late=0 duplicate=0 "
              f"invalid={invalid_legacy + invalid_projected} freshness=UNKNOWN")
        return 2
    if not projected:
        print(f"mishe parity: UNKNOWN sample={len(legacy)} missing=UNKNOWN late=UNKNOWN duplicate=0 "
              f"invalid={invalid_legacy + invalid_projected} freshness=UNKNOWN")
        return 2
    seen_legacy, seen_projected = {}, {}
    for item in legacy:
        seen_legacy.setdefault(item[0], []).append(item)
    for item in projected:
        seen_projected.setdefault(item[0], []).append(item)
    duplicate = sum(len(items) - 1 for items in seen_legacy.values()) + \
                sum(len(items) - 1 for items in seen_projected.values())
    invalid = invalid_legacy + invalid_projected
    seq_ids = {}
    for event_id, _, _, seq in projected:
        prior = seq_ids.setdefault(seq, event_id)
        if prior != event_id:
            invalid += 1
    missing = 0
    late = 0
    latencies = []
    for event_id, items in seen_legacy.items():
        matches = seen_projected.get(event_id, [])
        if not matches:
            missing += 1
            continue
        if len(items) != 1 or len(matches) != 1 or items[0][1] != matches[0][1]:
            invalid += 1
            continue
        delta = (matches[0][2] - items[0][2]).total_seconds()
        if delta < 0:
            invalid += 1
        elif delta > max_latency:
            late += 1
        else:
            latencies.append(delta)
    extra = len(seen_projected.keys() - seen_legacy.keys())
    freshness = "UNKNOWN" if not projected else f"{max(0, int((end - max(item[2] for item in projected)).total_seconds()))}s"
    state = "FAIL" if missing or late or duplicate or invalid or extra else "PASS"
    print(f"mishe parity: {state} channel={channel} sample={len(seen_legacy)} matched={len(latencies)} "
          f"missing={missing} late={late} duplicate={duplicate} invalid={invalid} extra={extra} "
          f"freshness={freshness} latency-max={max(latencies) if latencies else 0:.0f}s")
    return 1 if state == "FAIL" else 0


def main() -> int:
    home = Path(os.environ.get("MESH_MISHE_HOME", str(Path.home() / ".mesh/mishe-tauftauf")))
    log = Path(os.environ.get("MESH_MISHE_CHAT_LOG", str(Path.home() / ".mesh/chat.log")))
    baseline_path = Path(os.environ.get("MESH_MISHE_PARITY_BASELINE", str(home / "cleaner-parity-baseline.json")))
    try:
        baseline = json.loads(baseline_path.read_text(encoding="utf-8"))
        if set(baseline) != {"epoch", "time"} or type(baseline["epoch"]) is not int or baseline["epoch"] < 0:
            raise ValueError
        start = timestamp(baseline["time"])
        if start.tzinfo is None or start > datetime.now(timezone.utc):
            raise ValueError
    except (OSError, UnicodeError, ValueError, TypeError, KeyError):
        return unknown("baseline")

    events = []
    all_events = []
    try:
        with log.open(encoding="utf-8") as stream:
            for epoch, line in enumerate(stream, 1):
                if "[task-ledger]" not in line:
                    continue
                current = re.search(r"/current=i:(\d+)", line)
                if current is None or f"/steps/{current.group(1)}/owner=s:cleaner" not in line:
                    continue
                status = single(r"(?:^| \| )/status=s:([^\s|]+)", line)
                stamp = LEDGER_TIME_RE.match(line)
                if status not in STATUSES or stamp is None:
                    return unknown("ledger")
                when = timestamp(stamp.group(1))
                all_events.append((epoch, status, when))
                if epoch > baseline["epoch"]:
                    if when < start:
                        return unknown("baseline-window")
                    events.append((epoch, status, when))
            log_end = epoch if "epoch" in locals() else 0
    except (OSError, UnicodeError, ValueError):
        return unknown("ledger")
    if baseline["epoch"] > log_end:
        return unknown("baseline-epoch")

    try:
        Feed = feed_class()
        observations = [entry for entry in Feed(home).entries()
                        if entry.source == "observation/cleaner" and timestamp(entry.timestamp) >= start]
    except (OSError, UnicodeError, ValueError, ImportError):
        return unknown("feed")
    if not observations or not events:
        return unknown("no-transition")

    epochs = [event[0] for event in all_events]
    observed = {}
    latest_epoch = baseline["epoch"]
    latest_time = start
    considered = 0
    first_frame_epoch = None
    for index, entry in enumerate(observations):
        if entry.body.strip() == "STATE: UNKNOWN":
            if index == len(observations) - 1:
                return unknown("observation")
            continue
        lines = [line for line in entry.body.splitlines() if line.startswith("CLEANER:")]
        if len(lines) != 1 or "UNKNOWN" in entry.body:
            return unknown("observation")
        match = COUNT_RE.fullmatch(lines[0])
        if match is None:
            return unknown("observation")
        observed_epoch, count = int(match.group(1)), int(match.group(2))
        if observed_epoch < baseline["epoch"]:
            continue
        considered += 1
        if first_frame_epoch is None:
            first_frame_epoch = observed_epoch
        recent = [] if match.group(3) == "NONE" else match.group(3).split(",")
        if len(recent) > 16 or count != bisect_right(epochs, observed_epoch) or \
                (recent and observed_epoch != int(recent[-1].split(":", 1)[0])) or \
                observed_epoch < latest_epoch or observed_epoch > log_end:
            return unknown("observation-count")
        expected = [(e, s) for e, s, _ in all_events[:count]][-len(recent):] if recent else []
        parsed = []
        for item in recent:
            found = EVENT_RE.fullmatch(item)
            if found is None:
                return unknown("observation-event")
            parsed.append((int(found.group(1)), found.group(2)))
        if parsed != expected:
            return unknown("observation-event")
        observed_at = timestamp(entry.timestamp)
        for e, s in parsed:
            observed.setdefault(e, (s, observed_at))
        latest_epoch = observed_epoch
        latest_time = observed_at
    if not considered:
        return unknown("no-observation")
    if any(epoch <= first_frame_epoch and epoch not in observed for epoch, _, _ in events):
        return unknown("prehistory")

    missing = pending = 0
    latencies = []
    for epoch, status, when in events:
        if epoch in observed:
            if observed[epoch][0] != status:
                return unknown("observation-event")
            latency = (observed[epoch][1] - when).total_seconds()
            if latency < 0:
                return unknown("observation-time")
            latencies.append(latency)
        elif epoch <= latest_epoch:
            missing += 1
        else:
            pending += 1
    state = "FAIL" if missing else "PENDING" if pending else "PASS"
    covered = len(latencies)
    latency = f"{max(latencies):.0f}s" if latencies else "na"
    print(f"mishe cleaner parity: {state} covered={covered} missing={missing} pending={pending} "
          f"latency-max={latency} baseline-epoch={baseline['epoch']} "
          f"window={baseline['time']}..{latest_time.isoformat().replace('+00:00', 'Z')}; authority=legacy")
    return 1 if missing else 0


if __name__ == "__main__":
    parser = argparse.ArgumentParser()
    parser.add_argument("--channel")
    parser.add_argument("--closed-window")
    parser.add_argument("--legacy-events", type=Path)
    parser.add_argument("--projected-events", type=Path)
    parser.add_argument("--max-latency-seconds", type=int, default=180)
    args = parser.parse_args()
    if args.channel or args.closed_window:
        if not args.channel or not args.closed_window:
            print("mishe parity: UNKNOWN reason=arguments")
            sys.exit(2)
        root = Path(os.environ.get("MESH_MISHE_HOME", str(Path.home() / ".mesh/mishe-tauftauf"))) / "parity"
        sys.exit(closed_window(args.channel, args.closed_window,
                               args.legacy_events or root / "legacy.jsonl",
                               args.projected_events or root / "projected.jsonl",
                               args.max_latency_seconds))
    sys.exit(main())
