#!/usr/bin/env bash
# reflex-cadence: 17-59/10 * * * *
# doctor-artifact: $HOME/.mesh/.telephony-posture.state 1800 phone
# mesh-telephony-posture — Redmi body's SIM/telephony registration posture.
#
# This is a new body signal: the phone's telephony service reports whether its SIM is ready,
# whether data is connected, the radio's selected network type, and roaming state. It is not
# the serving-cell identity/signal axis (mesh-cell-info/mesh-cell-signal), nor SSH reachability.
# A reachable phone with a real `termux-telephony-deviceinfo` response is a reading even when
# Android says data is disconnected or the network type is unknown; an unreachable phone or
# malformed/empty response is UNKNOWN and exits 2. No default posture is invented.
#
#   mesh-telephony-posture       one live reading
#   mesh-telephony-posture --json machine-readable reading
#   mesh-telephony-posture --test parser fixtures + REAL phone read
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6)
export HOME
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes" 2>/dev/null || true

MESH_DIR="${MESH_DIR:-$HOME/.mesh}"
STATE="${MESH_TELEPHONY_POSTURE_STATE:-$MESH_DIR/.telephony-posture.state}"
PHONE_PORT="${PHONE_SSH_PORT:-8022}"
PHONE_USER="${PHONE_USER:-u0_a380}"

parse_deviceinfo() {
  python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    raise SystemExit(1)
required = ("sim_state", "data_state", "network_type", "network_roaming")
if not isinstance(d, dict) or any(k not in d for k in required):
    raise SystemExit(1)
if not isinstance(d["network_roaming"], bool):
    raise SystemExit(1)
print("sim_state=%s|data_state=%s|network_type=%s|roaming=%s|operator=%s|country=%s" % (
    d["sim_state"], d["data_state"], d["network_type"],
    str(d["network_roaming"]).lower(), d.get("network_operator_name", ""),
    d.get("network_country_iso", "")))
'
}

phone_ip() {
  if [ -n "${MESH_TELEPHONY_POSTURE_IP:-}" ]; then
    printf '%s\n' "$MESH_TELEPHONY_POSTURE_IP"
  else
    mesh-phone-ip 2>/dev/null
  fi
}

read_remote() {
  local ip
  ip="$(phone_ip)" || return 2
  [ -n "$ip" ] || return 2
  timeout 20 ssh -p "$PHONE_PORT" -o BatchMode=yes -o ConnectTimeout=8 \
    -o StrictHostKeyChecking=accept-new "${PHONE_USER}@${ip}" \
    'timeout 12 termux-telephony-deviceinfo' </dev/null 2>/dev/null
}

if [ "${1:-}" = --test ]; then
  fixture='{"sim_state":"ready","data_state":"connected","network_type":"lte","network_roaming":false,"network_operator_name":"MTS RUS","network_country_iso":"ru"}'
  expected='sim_state=ready|data_state=connected|network_type=lte|roaming=false|operator=MTS RUS|country=ru'
  [ "$(printf '%s' "$fixture" | parse_deviceinfo)" = "$expected" ] || {
    echo 'smoke-test: FAIL (deviceinfo parser fixture)'; exit 1;
  }
  printf '%s' '{"sim_state":"ready"}' | parse_deviceinfo >/dev/null 2>&1 && {
    echo 'smoke-test: FAIL (incomplete deviceinfo accepted)'; exit 1;
  }
  live="$(read_remote 2>/dev/null)" || {
    echo 'smoke-test: n/a (phone unreachable — parser passed; no reading invented)'; exit 2;
  }
  parsed="$(printf '%s' "$live" | parse_deviceinfo 2>/dev/null)" || {
    echo 'smoke-test: FAIL (phone returned malformed deviceinfo)'; exit 1;
  }
  echo "smoke-test: ok (parser + REAL termux-telephony-deviceinfo read: $parsed)"
  exit 0
fi

live="$(read_remote 2>/dev/null)" || {
  echo 'mesh-telephony-posture: UNKNOWN — phone/Termux telephony organ unreachable' >&2
  exit 2
}
reading="$(printf '%s' "$live" | parse_deviceinfo 2>/dev/null)" || {
  echo 'mesh-telephony-posture: UNKNOWN — malformed/empty termux-telephony-deviceinfo response' >&2
  exit 2
}
mkdir -p "$(dirname "$STATE")" 2>/dev/null || exit 1
ts="$(date -u +%FT%TZ)"
printf '%s|source=termux-telephony-deviceinfo|ts=%s\n' "$reading" "$ts" >"$STATE" || exit 1
mesh-state-touch "$STATE" >/dev/null 2>&1 || {
  echo 'mesh-telephony-posture: failed to stamp live state' >&2; exit 1
}
if [ "${1:-}" = --json ]; then
  printf '{"%s","source":"termux-telephony-deviceinfo","ts":"%s"}\n' \
    "$(printf '%s' "$reading" | sed 's/|/","/g;s/=/":"/g')" "$ts"
else
  printf '[telephony-posture] %s\n' "$reading"
fi
