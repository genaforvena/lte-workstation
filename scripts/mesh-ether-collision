#!/usr/bin/env bash
# reflex-cadence: */10 * * * *
# reflex-args: --edge
# doctor-artifact: $HOME/.mesh/.ether-collision.state 1800 sys
# mesh-ether-collision — Ethernet collision/error pressure from the NIC's own counters.
#
# Reads the physical NIC's ethtool counters for single/multiple collisions and aborted
# transmissions.  A real zero is CLEAN; an unreadable NIC or absent counters is UNKNOWN
# (exit 2), never a fabricated zero.  The state file is rewritten on every successful
# read, including --edge when the verdict does not change.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME="$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6)"
export HOME

MESH="${MESH_DIR:-$HOME/.mesh}"
STATE="${MESH_ETHER_COLLISION_STATE:-$MESH/.ether-collision.state}"
IFACE="${MESH_ETHER_COLLISION_IFACE:-}"

iface() {
  if [ -n "$IFACE" ]; then printf '%s\n' "$IFACE"; return; fi
  for p in /sys/class/net/*/device; do
    [ -e "$p" ] || continue
    n="${p%/device}"; n="${n##*/}"
    [ "$n" != lo ] && printf '%s\n' "$n" && return 0
  done
  return 2
}

read_counters() {
  local dev="$1" line k v single=0 multi=0 aborted=0 found=0
  while IFS= read -r line; do
    k="${line%%:*}"; v="${line##*:}"
    k="$(printf '%s' "$k" | tr -d '[:space:]')"
    v="$(printf '%s' "$v" | tr -d '[:space:]')"
    case "$k:$v" in
      tx_single_collisions:[0-9]*) single="$v"; found=$((found+1)) ;;
      tx_multi_collisions:[0-9]*)  multi="$v"; found=$((found+1)) ;;
      tx_aborted:[0-9]*)            aborted="$v"; found=$((found+1)) ;;
    esac
  done < <(ethtool -S "$dev" 2>/dev/null)
  [ "$found" -eq 3 ] || return 2
  printf '%s %s %s\n' "$single" "$multi" "$aborted"
}

classify() {
  local s="$1" m="$2" a="$3"
  if [ "$s" -eq 0 ] && [ "$m" -eq 0 ] && [ "$a" -eq 0 ]; then
    printf 'CLEAN'
  else
    printf 'COLLISION_PRESSURE'
  fi
}

if [ "${1:-}" = --test ]; then
  [ "$(classify 0 0 0)" = CLEAN ] || { echo 'smoke-test: FAIL (clean classifier)'; exit 1; }
  [ "$(classify 1 0 0)" = COLLISION_PRESSURE ] || { echo 'smoke-test: FAIL (single collision classifier)'; exit 1; }
  [ "$(classify 0 2 1)" = COLLISION_PRESSURE ] || { echo 'smoke-test: FAIL (multi/abort classifier)'; exit 1; }
  d="$(iface 2>/dev/null)" || { echo 'smoke-test: n/a (no physical NIC)'; exit 2; }
  c="$(read_counters "$d")" || { echo "smoke-test: n/a (NIC $d lacks required live counters)"; exit 2; }
  set -- $c
  [ "$#" -eq 3 ] || { echo "smoke-test: FAIL (malformed live counters: $c)"; exit 1; }
  echo "smoke-test: ok (classifier + REAL ethtool read: $d single=$1 multi=$2 aborted=$3)"
  exit 0
fi

d="$(iface 2>/dev/null)" || { echo 'mesh-ether-collision: UNKNOWN — no physical NIC' >&2; exit 2; }
c="$(read_counters "$d")" || { echo "mesh-ether-collision: UNKNOWN — required ethtool counters unreadable on $d" >&2; exit 2; }
set -- $c
s="$1"; m="$2"; a="$3"; verdict="$(classify "$s" "$m" "$a")"
mkdir -p "$MESH" 2>/dev/null || true
previous=""
[ -r "$STATE" ] && previous="$(head -1 "$STATE" 2>/dev/null)"
printf '%s|iface=%s|single=%s|multi=%s|aborted=%s\n' "$verdict" "$d" "$s" "$m" "$a" > "$STATE"
ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
if [ "${1:-}" = --edge ] && [ "$previous" = "${verdict}|iface=$d|single=$s|multi=$m|aborted=$a" ]; then exit 0; fi
printf '[ether-collision-%s] iface=%s single=%s multi=%s aborted=%s @ %s\n' \
  "$(printf '%s' "$verdict" | tr '[:upper:]' '[:lower:]')" "$d" "$s" "$m" "$a" "$ts"
