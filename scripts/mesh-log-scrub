#!/usr/bin/env python3
"""mesh-log-scrub — pipe filter that masks secrets BEFORE they land in ~/.mesh/*.log.

Stdin → stdout; replaces tokens, OAuth codes, passwords, and high-entropy strings
with REDACTED placeholders. One line at a time, no buffering delay.

  echo "BOT_TOKEN=abc123&code=secret" | mesh-log-scrub    → BOT_TOKEN=REDACTED&code=REDACTED
  mesh-log-scrub < leaky.log > clean.log                   → batch mode

  mesh-log-scrub --test        self-test with a fixture line (used by mesh-verify / smoke)
  mesh-log-scrub --list        show all patterns (table for documentation)

Design principle: safe by default — be overbroad (mask anything that LOOKS like a
secret) rather than narrow (miss a leak). All patterns are non-destructive on
normal prose (no false positives on IPs, dates, MACs).
"""
import sys, re

PATTERNS = [
    # 1. Named secret variables (most specific, checked first)
    (re.compile(r'\b(BOT_TOKEN|TG_TOKEN|TELEGRAM_BOT_TOKEN|TELEGRAM_TOKEN|API_KEY|ACCESS_KEY|SECRET_KEY|PRIVATE_KEY|YANDEX_OAUTH|YC_IAM_TOKEN|AWS_SECRET_ACCESS_KEY|GITHUB_TOKEN|GITLAB_TOKEN|SLACK_TOKEN|DISCORD_TOKEN|OPENAI_API_KEY|ANTHROPIC_API_KEY)=[^\s&]+', re.I),
     r'\1=REDACTED'),
    # 2. URL query parameters with secret semantics
    (re.compile(r'([?&])(code|state|access_token|refresh_token|auth_token|session_token|id_token|assertion)=[^\s&]+', re.I),
     r'\1\2=REDACTED'),
    # 3. Common credential key names (any context)
    (re.compile(r'\b(password|passwd|secret|apikey|api_key|api-secret|secret_key)\s*[:=]\s*[^\s&,;)]+', re.I),
     r'\1=REDACTED'),
    # 4. Generic token/key in any format (8+ char value to reduce false positives)
    (re.compile(r'\b(token|refresh_token|access_token|auth_token|api_key|apikey|key)\s*[:=]\s*["\']?([a-zA-Z0-9_\-=+./]{8,})(["\']?(?:\s|$|[&,;)]))', re.I),
     r'\1=REDACTED\3'),
    # 5. Google OAuth token prefix (ya29.)
    (re.compile(r'\bya29\.[a-zA-Z0-9_\-=+./]+\b'),
     r'TOKEN_REDACTED'),
    # 6. Tailscale auth key prefix (tskey- or tskey-auth-... )
    (re.compile(r'\btskey[a-zA-Z0-9-]+\b'),
     r'TSKEY_REDACTED'),
    # 7. AWS Access Key ID (AKIA + 16) — exactly 20 chars, BELOW the 35-char catch-all, so it needs
    #    its own rule (standard secret-scanner target; identifies the account + is half the credential).
    (re.compile(r'\bAKIA[0-9A-Z]{16}\b'),
     r'AWS_AKID_REDACTED'),
    # 7b. HTTP auth headers: "Bearer <tok>" / "Basic <b64>" — the value carries NO key= prefix and
    #     short API tokens (<35 chars) slip past the catch-all (found live: 'Authorization: Bearer
    #     sk-ant-…' passed through unredacted, verify rotation 2026-06-12af).
    (re.compile(r'\b(Bearer|Basic)\s+[A-Za-z0-9._\-=+/]{8,}', re.I),
     r'\1 REDACTED'),
    # 7c. Vendor key prefixes (sk- = Anthropic/OpenAI): bare short test/scoped keys, same gap as 7b.
    (re.compile(r'\bsk-[A-Za-z0-9_\-]{8,}\b'),
     r'SK_REDACTED'),
    # 7d. Groq key prefix (gsk_): introduced to the mesh 2026-06-12 (~/.mesh/groq.env). Explicit
    #     coverage so it's redacted even if a future Groq key is shorter than the 35-char catch-all.
    (re.compile(r'\bgsk_[A-Za-z0-9_\-]{8,}'),
     r'GSK_REDACTED'),
    # 8. Any high-entropy 35+ char sequence (catches JWT segments, long raw tokens)
    (re.compile(r'\b[a-zA-Z0-9_-]{35,}\b'),
     r'TOKEN_REDACTED'),
    # 8. SSH private key blocks (multiline — DOTALL so . matches newlines)
    (re.compile(r'-----BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY-----.*?-----END (RSA |EC |OPENSSH )?PRIVATE KEY-----', re.DOTALL),
     r'-----BEGIN PRIVATE KEY----- REDACTED -----END PRIVATE KEY-----'),
]

FIXTURE = (
    # 1-3: named secret vars, URL params, password
    'BOT_TOKEN=12345:ABCdefGHIjklMNOpqrstUVwxyz-Test '
    '&code=ac_test12345&state=xyz789 '
    'password=s3cret! '
    'API_KEY=sk-abc123def456ghi789jkl '
    '/callback?code=4/0AeaYSB&state=random_state '
    'GITHUB_TOKEN=ghp_abc123def456ghi789jklmno '
    # 4: generic token= / key= (not named)
    'token=gho_abc123def456ghi789jklmno key=AQVabc123def456 '
    # 5-6: ya29. and tskey- prefixes
    'ya29.a0AfH6SMBabc123def456ghi789jklmno tskey-auth-XXXXXXXXXXXXXXX '
    # 7: AWS Access Key ID (20 chars — below the 35-char catch-all, needs its own rule)
    'aws AKIAIOSFODNN7EXAMPLE key '
    # 7b/7c/7d: auth headers + bare vendor keys (short — below the catch-all) incl. Groq gsk_
    'Authorization: Bearer fake_short_tok123 and sk-ant-fakekey1234567890 gsk_shortGroqKey123 '
    # 8: JWT token segments (35+ char)
    'long_token=eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIn0.abcdefghijklmnopqrstuvwxyz1234567890 '
    # operators test: already-clean values survive unchanged
    'operator typed: password=REDACTED and BOT_TOKEN=REDACTED '
    'plain text stays as is 192.168.1.1'
)

def sanitize(text):
    for pat, repl in PATTERNS:
        text = pat.sub(repl, text)
    return text

def main():
    if len(sys.argv) > 1:
        arg = sys.argv[1]
        if arg == '--test':
            before = FIXTURE
            after = sanitize(before)
            print("--- fixture input ---")
            print(before)
            print("--- scrubbed output ---")
            print(after)
            had_redacted = after.count('REDACTED')
            print(f"--- REDACTED count: {had_redacted} (expect >= 20) ---")
            sys.exit(0 if had_redacted >= 20 else 1)
        elif arg == '--list':
            print(f"{'#':<4} {'Pattern':<55} {'Example input':<50} {'Output'}")
            print("-" * 130)
            for i, (pat, repl) in enumerate(PATTERNS, 1):
                example = "auth_code=secret123"
                out = pat.sub(repl, example)
                print(f"{i:<4} {pat.pattern[:54]:<55} {example:<50} {out}")
            sys.exit(0)
    in_key = False; key_buf = ''
    for line in sys.stdin:
        if in_key:
            key_buf += line
            if '-----END' in line and 'PRIVATE KEY' in line:
                in_key = False
                sys.stdout.write(sanitize(key_buf.rstrip('\n')) + '\n')
                key_buf = ''
        elif '-----BEGIN' in line and 'PRIVATE KEY' in line:
            in_key = True; key_buf = line
        else:
            sys.stdout.write(sanitize(line.rstrip('\n')) + '\n')
        sys.stdout.flush()
    if key_buf:
        sys.stdout.write(sanitize(key_buf.rstrip('\n')) + '\n')
        sys.stdout.flush()

if __name__ == '__main__':
    main()
