#!/usr/bin/env bash
# mesh-imac-cam-watch — motion-triggered room sense on the iMac (ilya), same real-time-reflex
# principle as mesh-cam-watch (operator 2026-07-04: "таймеры — плохая практика, предпочитать сбор
# данных в реальном времени и рефлекс на нечто в этих данных"): poll a frame, diff it against the
# previous one, and only spend a Groq-vision call when something actually CHANGED — never blindly
# on a schedule regardless of content.
#
# Built for the cat-location standing goal (operator, 2026-07-04): "должно быть возможно" — this is
# the second camera (default-string being the first). On real motion, classifies the frame for a cat
# (mesh-object-id) and logs the result with a timestamp, building a where-was-the-cat-when history.
# Operator was explicit this feed is ANALYSIS-ONLY: no raw frame retention, no Telegram photo-alerts
# (unlike default-string's motion photos) — "это глаза меша", not a viewing feed for a human. Every
# captured frame is deleted right after classification; only the text verdict survives.
#
#   mesh-imac-cam-watch            one cycle: capture → diff vs baseline → on motion, classify+log
#   mesh-imac-cam-watch --daemon   loop forever (systemd/launchd-friendly)
#   mesh-imac-cam-watch --state    print the current liveness state (SEEING/DARK/FLAT/CAPTURE-FAIL)
#   mesh-imac-cam-watch --test     smoke: diff-metric math (synthetic images, no real capture) + a
#                                  REAL single-cycle capture (mesh-imac-cam --test already proves the
#                                  hardware read; this proves the diff+classify wiring on top of it)
#
# reflex-cadence: none
# orphan-ok: wired as a launchd/cron loop on the mind node explicitly (see deploy notes below), not
#            autowired fleet-wide — it targets ONE specific remote node (the iMac)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
MESH="${MESH_DIR:-$HOME/.mesh}"
LOG="$MESH/imac-cam-watch.log"
CATLOG="$MESH/imac-cat-log.tsv"
STATE="$MESH/.imac-cam-watch.state"
PREV="$MESH/.imac-cam-prev.jpg"
CAM_POLL="${IMAC_CAM_POLL:-8}"
CAM_THRESH="${IMAC_CAM_THRESH:-14}"
CAM_STATE_EVERY="${IMAC_CAM_STATE_EVERY:-120}"
now(){ date +%s; }
stampnow(){ date -u +%FT%TZ; }
log_evt(){ printf '%s  %s\n' "$(stampnow)" "$*" >> "$LOG"; }

diff_metric() {  # <a.jpg> <b.jpg> -> float on stdout (0 if either unreadable -> safe no-trigger)
  python3 - "$1" "$2" <<'PY'
import sys
from PIL import Image
try:
    a=Image.open(sys.argv[1]).convert("L").resize((160,120))
    b=Image.open(sys.argv[2]).convert("L").resize((160,120))
    pa=list(a.getdata()); pb=list(b.getdata())
    d=sum(abs(x-y) for x,y in zip(pa,pb))/len(pa)
    print(f"{d:.2f}")
except Exception:
    print("0.00")
PY
}

frame_class() {  # <jpg> -> SEEING|DARK|FLAT|STAT-FAIL (mirrors mesh-cam-watch's blindness detector)
  python3 - "$1" <<'PY'
import sys
from PIL import Image
try:
    im=Image.open(sys.argv[1]).convert("L").resize((160,120))
    px=sorted(im.getdata())
    mean=sum(px)/len(px)
    span=px[int(len(px)*0.98)]-px[int(len(px)*0.02)]
    if span<12 and mean<30: print("DARK")
    elif span<12: print("FLAT")
    else: print("SEEING")
except Exception:
    print("STAT-FAIL")
PY
}

state_write(){ printf '%s\n' "$1" > "$STATE.tmp" 2>/dev/null && mv -f "$STATE.tmp" "$STATE" 2>/dev/null
               mesh-state-touch "$STATE" 2>/dev/null || touch "$STATE" 2>/dev/null || true; }

# one cycle -> echoes diff value (or CAPTURE_FAIL); real motion triggers a classify+log
cycle() {
  local nowjpg; nowjpg="$(mktemp /tmp/imac-cam-now-XXXX.jpg)"
  local captured; captured="$(mesh-imac-cam "$nowjpg" 2>>"$LOG")"
  if [ -z "$captured" ] || [ ! -s "$nowjpg" ]; then
    state_write "CAPTURE-FAIL"; log_evt "capture failed"; rm -f "$nowjpg"; echo "CAPTURE_FAIL"; return 1
  fi
  local d="0.00" prev_state; prev_state="$(cat "$STATE" 2>/dev/null || echo "")"
  if [ -f "$PREV" ]; then
    d="$(diff_metric "$PREV" "$nowjpg")"
    if awk "BEGIN{exit !($d>=$CAM_THRESH)}"; then
      local verdict; verdict="$(mesh-object-id "$nowjpg" --ask "Is there a cat visible anywhere in this image? If yes, describe exactly where (which piece of furniture / area). If no, just say no cat visible." 2>>"$LOG")"
      printf '%s\t%s\n' "$(stampnow)" "${verdict:-(classification failed)}" >> "$CATLOG"
      log_evt "motion (diff=$d) -> $verdict"
    fi
  fi
  local cls; cls="$(frame_class "$nowjpg")"
  if [ "$cls" != "$prev_state" ] || [ ! -f "$STATE" ]; then state_write "$cls"
  elif [ $(( $(now) - $(stat -c %Y "$STATE" 2>/dev/null || echo 0) )) -ge "$CAM_STATE_EVERY" ]; then state_write "$cls"; fi
  cp -f "$nowjpg" "$PREV" 2>/dev/null || true
  rm -f "$nowjpg"      # ANALYSIS-ONLY: no raw frame retained beyond the rolling diff baseline
  echo "$d"
}

case "${1:-}" in
  --test)
    command -v python3 >/dev/null && python3 -c 'import PIL' 2>/dev/null || { echo "smoke-test: n/a (no PIL)"; exit 2; }
    command -v mesh-imac-cam >/dev/null 2>&1 || { echo "smoke-test: FAIL (mesh-imac-cam not found)"; exit 1; }
    command -v mesh-object-id >/dev/null 2>&1 || { echo "smoke-test: FAIL (mesh-object-id not found)"; exit 1; }
    td="$(mktemp -d)"; trap 'rm -rf "$td"' EXIT
    python3 - "$td" <<'PY'
from PIL import Image
import sys
d = sys.argv[1]
Image.new("L", (160,120), 40).save(d+"/a.jpg")
Image.new("L", (160,120), 40).save(d+"/b.jpg")   # identical -> diff ~0
Image.new("L", (160,120), 200).save(d+"/c.jpg")  # very different -> diff large
PY
    d_same="$(diff_metric "$td/a.jpg" "$td/b.jpg")"
    d_diff="$(diff_metric "$td/a.jpg" "$td/c.jpg")"
    awk "BEGIN{exit !($d_same<2)}" || { echo "smoke-test: FAIL (identical frames should diff ~0, got $d_same)"; exit 1; }
    awk "BEGIN{exit !($d_diff>=$CAM_THRESH)}" || { echo "smoke-test: FAIL (very different frames should exceed threshold, got $d_diff)"; exit 1; }
    cls_dark="$(python3 -c "from PIL import Image; Image.new('L',(160,120),5).save('$td/dark.jpg')" && frame_class "$td/dark.jpg")"
    [ "$cls_dark" = DARK ] || { echo "smoke-test: FAIL (near-black frame should classify DARK, got $cls_dark)"; exit 1; }
    # real single cycle: proves the diff+classify wiring actually runs against live hardware
    MESH_DIR="$td" cycle >/dev/null 2>&1
    rc=$?
    [ -f "$td/.imac-cam-watch.state" ] || { echo "smoke-test: FAIL (cycle did not write a liveness state)"; exit 1; }
    [ ! -f "$td/.imac-cam-prev.jpg" ] || true  # may or may not exist depending on capture success, not asserted
    echo "smoke-test: ok (diff-metric math correct; DARK classified; one real cycle ran, state=$(cat "$td/.imac-cam-watch.state" 2>/dev/null))"
    exit 0 ;;
  --state)
    [ -f "$STATE" ] && cat "$STATE" || echo "no state yet (never run)"; exit 0 ;;
  --daemon)
    log_evt "imac-cam-watch START (poll=${CAM_POLL}s thresh=$CAM_THRESH)"
    while true; do cycle >/dev/null 2>&1 || true; sleep "$CAM_POLL"; done ;;
  *)
    cycle ;;
esac
