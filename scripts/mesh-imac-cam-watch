#!/usr/bin/env bash
# mesh-imac-cam-watch — motion-triggered room sense on the iMac (ilya), same real-time-reflex
# principle as mesh-cam-watch (operator 2026-07-04: "таймеры — плохая практика, предпочитать сбор
# данных в реальном времени и рефлекс на нечто в этих данных"): poll a frame, diff it against the
# previous one, and only spend a Groq-vision call when something actually CHANGED — never blindly
# on a schedule regardless of content.
#
# Built for the cat-location standing goal (operator, 2026-07-04): "должно быть возможно" — this is
# the second camera (default-string being the first). On real motion, classifies the frame for a cat
# (mesh-object-id) AND for who's in frame (mesh-face-recognize: Ilya/Rozalia/Nobody/Stranger — same
# reflex mesh-cam-watch already runs on ds), logging both with a timestamp: a where-was-the-cat-when
# history plus a who-was-in-the-room-when one. An unrecognized visitor logs as "Stranger" only —
# never guessed at by name, no consent to identify a specific third party.
# Operator was explicit this feed is ANALYSIS-ONLY: no raw frame retention, no Telegram photo-alerts
# (unlike default-string's motion photos) — "это глаза меша", not a viewing feed for a human. Every
# captured frame is deleted right after classification; only the text verdict survives.
#
#   mesh-imac-cam-watch            one cycle: capture → diff vs baseline → on motion, classify+log
#   mesh-imac-cam-watch --daemon   loop forever (systemd/launchd-friendly)
#   mesh-imac-cam-watch --state    print the current liveness state (SEEING/DARK/COVERED/FLAT/CAPTURE-FAIL)
#   mesh-imac-cam-watch --test     smoke: diff-metric math (synthetic images, no real capture) + a
#                                  REAL single-cycle capture (mesh-imac-cam --test already proves the
#                                  hardware read; this proves the diff+classify wiring on top of it)
#
# reflex-cadence: none
# orphan-ok: wired as a launchd/cron loop on the mind node explicitly (see deploy notes below), not
#            autowired fleet-wide — it targets ONE specific remote node (the iMac)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
MESH="${MESH_DIR:-$HOME/.mesh}"
LOG="$MESH/imac-cam-watch.log"
CATLOG="$MESH/imac-cat-log.tsv"
PERSONLOG="$MESH/imac-person-log.tsv"
STATE="$MESH/.imac-cam-watch.state"
PREV="$MESH/.imac-cam-prev.jpg"
CAM_POLL="${IMAC_CAM_POLL:-8}"
CAM_THRESH="${IMAC_CAM_THRESH:-14}"
CAM_STATE_EVERY="${IMAC_CAM_STATE_EVERY:-120}"
CAM_COOLDOWN="${IMAC_CAM_COOLDOWN:-450}"   # min gap between Groq-vision classify calls; 450s keeps sustained-motion under the 500k/day TPD budget (task imac-cam-cooldown-tpd-budget; was 45s → exhausted TPD in ~2.4h)
LASTF="$MESH/.imac-cam-last-classify"
MOTIONF="$MESH/.imac-cam-last-motion"   # epoch of the last threshold crossing — stamped on EVERY
                                        # motion, INCLUDING classify-cooldown-suppressed ones, so a
                                        # consumer (mesh-bruno scene-hold) can prove "no motion since
                                        # the last CATLOG row"; the cooldown gates only the paid calls
# COVERED-lens discriminator (ported from mesh-cam-watch cam-covered-classifier, task imac-cam-watch-no-covered-class):
# a covered lens (shutter/tape/cap) is a FLAT DARK field (sd≈0), NOT a DARK room the eye still SEES (real sensor
# noise sd≳2). Without this split a blind iMac lens falls to DARK and the cat/room senses go silently hollow.
CAM_COVERED_SD="${IMAC_CAM_COVERED_SD:-1.5}"        # luma stddev below this (AND mean<30) = COVERED, not DARK
CAM_COVERED_DWELL="${IMAC_CAM_COVERED_DWELL:-3600}" # continuous-COVERED seconds before the ONE [cam-covered] board line
COVSINCE="$MESH/.imac-cam-covered-since"   # "<epoch_covered_began> <announced 0|1>" — cleared when the lens opens
now(){ date +%s; }
stampnow(){ date -u +%FT%TZ; }
log_evt(){ printf '%s  %s\n' "$(stampnow)" "$*" >> "$LOG"; }

diff_metric() {  # <a.jpg> <b.jpg> -> float on stdout (0 if either unreadable -> safe no-trigger)
  python3 - "$1" "$2" <<'PY'
import sys
from PIL import Image
try:
    a=Image.open(sys.argv[1]).convert("L").resize((160,120))
    b=Image.open(sys.argv[2]).convert("L").resize((160,120))
    pa=list(a.getdata()); pb=list(b.getdata())
    d=sum(abs(x-y) for x,y in zip(pa,pb))/len(pa)
    print(f"{d:.2f}")
except Exception:
    print("0.00")
PY
}

frame_class() {  # <jpg> -> SEEING|DARK|COVERED|FLAT|STAT-FAIL (mirrors mesh-cam-watch's blindness detector)
  python3 - "$1" "$CAM_COVERED_SD" <<'PY'
import sys
from PIL import Image
try:
    # NEAREST resample: subsample, do NOT smooth — smoothing (bicubic default) averages away the very
    # sensor-noise variance that separates a COVERED flat field (sd≈0) from a DARK room the eye SEES
    # (sd≳2). The covered discriminator is a variance read, so it must survive the downscale.
    im=Image.open(sys.argv[1]).convert("L").resize((160,120), Image.NEAREST)
    raw=list(im.getdata()); n=len(raw)
    mean=sum(raw)/n
    var=sum((p-mean)**2 for p in raw)/n
    sd=var**0.5
    covered_sd=float(sys.argv[2])
    px=sorted(raw)
    span=px[int(n*0.98)]-px[int(n*0.02)]   # p2-p98 spread: ignores stuck pixels
    if mean<30 and sd<covered_sd: print("COVERED")   # flat dark field: shutter/tape/cap — the eye is BLIND
    elif span<12 and mean<30: print("DARK")          # near-black but real sensor noise: unlit room, eye SEES
    elif span<12: print("FLAT")                      # uniform but lit: bright obstruction
    else: print("SEEING")
except Exception:
    print("STAT-FAIL")
PY
}

# cam_board — edge board post (best-effort). The covered-dwell one-shot uses it. Board-only: this feed is
# ANALYSIS-ONLY (operator 2026-07-04 — no Telegram photo-alerts on the iMac eye, unlike default-string).
cam_board(){ command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="imac-cam-watch@$(hostname)" mesh-chat "$1" >/dev/null 2>&1 || true; }

# covered_dwell <cls> — track continuous-COVERED time in COVSINCE; the FIRST cycle past CAM_COVERED_DWELL
# fires exactly ONE [cam-covered] board line, guarded by an announced flag so it never repeats within an
# episode. Any non-COVERED frame clears COVSINCE (resets the episode). Purely a side-effect on the board;
# does not transform the class the caller writes to STATE.
covered_dwell() {
  local cls="$1" nowt; nowt="$(now)"
  if [ "$cls" != COVERED ]; then rm -f "$COVSINCE" 2>/dev/null || true; return 0; fi
  local since="" ann=""
  [ -f "$COVSINCE" ] && read -r since ann < "$COVSINCE" 2>/dev/null
  [[ "${since:-}" =~ ^[0-9]+$ ]] || { since="$nowt"; ann=0; }
  [[ "${ann:-}" =~ ^[01]$ ]] || ann=0
  if [ "$ann" != 1 ] && [ $(( nowt - since )) -ge "$CAM_COVERED_DWELL" ]; then
    local mins=$(( (nowt - since) / 60 ))
    cam_board "[cam-covered] iMac (ilya) camera lens BLIND ${mins}min+ (flat dark field mean<30 sd<${CAM_COVERED_SD}: shutter/tape/cap — NOT a dark room). Cat/room senses on this eye degraded until the lens is uncovered."
    ann=1
  fi
  printf '%s %s\n' "$since" "$ann" > "$COVSINCE" 2>/dev/null || true
}

state_write(){ printf '%s\n' "$1" > "$STATE.tmp" 2>/dev/null && mv -f "$STATE.tmp" "$STATE" 2>/dev/null
               mesh-state-touch "$STATE" 2>/dev/null || touch "$STATE" 2>/dev/null || true; }

# one cycle -> echoes diff value (or CAPTURE_FAIL); real motion triggers a classify+log
cycle() {
  local nowjpg; nowjpg="$(mktemp /tmp/imac-cam-now-XXXX.jpg)"
  local captured; captured="$(mesh-imac-cam "$nowjpg" 2>>"$LOG")"
  if [ -z "$captured" ] || [ ! -s "$nowjpg" ]; then
    state_write "CAPTURE-FAIL"; log_evt "capture failed"; rm -f "$nowjpg"; echo "CAPTURE_FAIL"; return 1
  fi
  local d="0.00" prev_state; prev_state="$(cat "$STATE" 2>/dev/null || echo "")"
  if [ -f "$PREV" ]; then
    d="$(diff_metric "$PREV" "$nowjpg")"
    if awk "BEGIN{exit !($d>=$CAM_THRESH)}"; then
      # COOLDOWN (2026-07-04: continuous motion — e.g. someone sitting at the desk — crossed the
      # diff threshold on nearly every 8s poll, firing a Groq vision call each time with no gate and
      # blowing through the shared daily vision-model quota in minutes). Gate the two classify calls
      # the same way mesh-cam-watch already gates its own alert actions on ds — cheap diff math still
      # runs every cycle (keeps liveness fresh), only the paid calls are throttled.
      local lastc=0 nowt; nowt="$(now)"; [ -f "$LASTF" ] && lastc="$(cat "$LASTF" 2>/dev/null || echo 0)"
      echo "$nowt" > "$MOTIONF" 2>/dev/null || true   # every crossing, cooldown or not — see MOTIONF note
      if [ $(( nowt - lastc )) -ge "$CAM_COOLDOWN" ]; then
        echo "$nowt" > "$LASTF"
        local verdict; verdict="$(mesh-object-id "$nowjpg" --ask "Is there a cat visible anywhere in this image? If yes, describe exactly where (which piece of furniture / area). If no, just say no cat visible." 2>>"$LOG")"
        printf '%s\t%s\n' "$(stampnow)" "${verdict:-(classification failed)}" >> "$CATLOG"
        # WHO'S IN FRAME (operator 2026-07-04: "мб сможете различать нас (розалию, меня, кота, гостей)")
        # reuses the existing mesh-face-recognize reflex (Groq vision, same one mesh-cam-watch already
        # runs on ds) — zero-shot Ilya/Rozalia/Nobody/Stranger; an unnamed visitor stays "Stranger",
        # never guessed at by name (no consent to identify a third party specifically).
        local who; who="$(mesh-face-recognize "$nowjpg" 2>>"$LOG" | tr -d '\r' | tail -n1)"
        printf '%s\t%s\n' "$(stampnow)" "${who:-(recognition failed)}" >> "$PERSONLOG"
        log_evt "motion (diff=$d) -> cat: $verdict | who: ${who:-?}"
      fi
    fi
  fi
  local cls; cls="$(frame_class "$nowjpg")"
  covered_dwell "$cls"    # >dwell one-shot [cam-covered] board alert (side-effect; STATE still records COVERED)
  if [ "$cls" != "$prev_state" ] || [ ! -f "$STATE" ]; then state_write "$cls"
  elif [ $(( $(now) - $(stat -c %Y "$STATE" 2>/dev/null || echo 0) )) -ge "$CAM_STATE_EVERY" ]; then state_write "$cls"; fi
  cp -f "$nowjpg" "$PREV" 2>/dev/null || true
  rm -f "$nowjpg"      # ANALYSIS-ONLY: no raw frame retained beyond the rolling diff baseline
  echo "$d"
}

case "${1:-}" in
  --test)
    command -v python3 >/dev/null && python3 -c 'import PIL' 2>/dev/null || { echo "smoke-test: n/a (no PIL)"; exit 2; }
    command -v mesh-imac-cam >/dev/null 2>&1 || { echo "smoke-test: FAIL (mesh-imac-cam not found)"; exit 1; }
    command -v mesh-object-id >/dev/null 2>&1 || { echo "smoke-test: FAIL (mesh-object-id not found)"; exit 1; }
    command -v mesh-face-recognize >/dev/null 2>&1 || { echo "smoke-test: FAIL (mesh-face-recognize not found)"; exit 1; }
    td="$(mktemp -d)"; trap 'rm -rf "$td"' EXIT
    python3 - "$td" <<'PY'
from PIL import Image
import sys
d = sys.argv[1]
Image.new("L", (160,120), 40).save(d+"/a.jpg")
Image.new("L", (160,120), 40).save(d+"/b.jpg")   # identical -> diff ~0
Image.new("L", (160,120), 200).save(d+"/c.jpg")  # very different -> diff large
PY
    d_same="$(diff_metric "$td/a.jpg" "$td/b.jpg")"
    d_diff="$(diff_metric "$td/a.jpg" "$td/c.jpg")"
    awk "BEGIN{exit !($d_same<2)}" || { echo "smoke-test: FAIL (identical frames should diff ~0, got $d_same)"; exit 1; }
    awk "BEGIN{exit !($d_diff>=$CAM_THRESH)}" || { echo "smoke-test: FAIL (very different frames should exceed threshold, got $d_diff)"; exit 1; }
    # blindness classifier fixtures (cam-covered-classifier): the split is VARIANCE — a COVERED flat field
    # (sd≈0, lens blocked) vs a DARK room the eye still SEES (real low-freq structure sd≳2). JPEG DCT-quantizes
    # away per-pixel WHITE noise, so the DARK fixture must be a LOW-FREQUENCY ramp, which JPEG preserves.
    python3 - "$td" <<'PY'
from PIL import Image
import sys
d=sys.argv[1]
Image.new("L",(160,120),15).save(d+"/covered.jpg")     # flat dark field sd~0 → COVERED (lens blocked)
dk=Image.new("L",(160,120))                             # smooth ramp 10..21: sd~3, span~10 (<12), mean~15
dk.putdata([10 + (x*11)//160 for y in range(120) for x in range(160)])
dk.save(d+"/darkroom.jpg")                              # noisy/structured near-black → DARK (eye SEES)
PY
    cls_cov="$(frame_class "$td/covered.jpg")"
    [ "$cls_cov" = COVERED ] || { echo "smoke-test: FAIL (flat dark field should classify COVERED, got $cls_cov)"; exit 1; }
    [ "$cls_cov" = DARK ] && { echo "smoke-test: FAIL (a COVERED flat field must not read DARK — the conflation bug)"; exit 1; }
    cls_dark="$(frame_class "$td/darkroom.jpg")"
    [ "$cls_dark" = DARK ] || { echo "smoke-test: FAIL (structured near-black room should classify DARK, got $cls_dark)"; exit 1; }
    [ "$cls_dark" = COVERED ] && { echo "smoke-test: FAIL (a noisy DARK room must not read COVERED — sd discriminator broke)"; exit 1; }
    # covered-dwell one-shot: fires exactly ONE [cam-covered] board line past the dwell, never within an
    # episode. Hermetic — stub cam_board + point COVSINCE at the sandbox.
    _ovd="$(mktemp -d)"; COVSINCE="$_ovd/since"; CAM_COVERED_DWELL=3600
    _bc="$_ovd/board"; cam_board(){ printf '%s\n' "$1" >> "$_bc"; }
    rm -f "$_bc" "$COVSINCE"
    covered_dwell COVERED    # fresh (since=now) → under dwell → arms since-stamp, NO board post
    [ -s "$_bc" ] && { echo "smoke-test: FAIL (a sub-dwell COVERED must NOT post [cam-covered])"; exit 1; }
    printf '%s 0\n' "$(( $(now) - 4000 ))" > "$COVSINCE"   # backdate past dwell → next call fires ONE alert
    covered_dwell COVERED
    [ "$(wc -l < "$_bc")" = 1 ] || { echo "smoke-test: FAIL (dwelled COVERED should post exactly ONE [cam-covered], got $(wc -l < "$_bc"))"; exit 1; }
    covered_dwell COVERED    # already announced → must NOT repeat within the episode
    [ "$(wc -l < "$_bc")" = 1 ] || { echo "smoke-test: FAIL ([cam-covered] repeated within one episode)"; exit 1; }
    covered_dwell SEEING     # left COVERED → clears the episode
    [ -f "$COVSINCE" ] && { echo "smoke-test: FAIL (a non-COVERED frame must clear the dwell episode)"; exit 1; }
    rm -rf "$_ovd"
    # cooldown TPD-budget guard (task imac-cam-cooldown-tpd-budget): default must be the
    # budget-safe 450s (falsifiable — reverting :39 to 45 fails this), and the env override must win.
    if [ -z "${IMAC_CAM_COOLDOWN:-}" ]; then
      [ "$CAM_COOLDOWN" = 450 ] || { echo "smoke-test: FAIL (CAM_COOLDOWN default should be 450, got $CAM_COOLDOWN)"; exit 1; }
    fi
    ovr_cd="$(IMAC_CAM_COOLDOWN=137 bash -c 'echo "${IMAC_CAM_COOLDOWN:-450}"')"
    [ "$ovr_cd" = 137 ] || { echo "smoke-test: FAIL (IMAC_CAM_COOLDOWN override not honored, got $ovr_cd)"; exit 1; }
    # motion stamp (scene-hold contract, 2026-07-16): a threshold crossing must stamp MOTIONF even
    # while the classify COOLDOWN suppresses the paid calls — the stamp is what lets mesh-bruno
    # prove "no motion since the last CATLOG row"; a crossing that goes unstamped would let a
    # cooldown-suppressed scene change ride inside a held "no cat" claim. Hermetic: stub the
    # capture+classifiers, sandbox every artifact the cycle writes.
    _mt="$(mktemp -d)"
    LOG="$_mt/log" CATLOG="$_mt/catlog" PERSONLOG="$_mt/personlog" STATE="$_mt/state" \
      PREV="$_mt/prev.jpg" LASTF="$_mt/lastclassify" MOTIONF="$_mt/lastmotion" COVSINCE="$_mt/covsince"
    cp "$td/a.jpg" "$PREV"
    mesh-imac-cam(){ cp "$td/c.jpg" "$1" && echo "$1"; }   # frame very different from PREV → crossing
    mesh-object-id(){ echo "stub verdict"; }
    mesh-face-recognize(){ echo "Nobody"; }
    now > "$LASTF"    # classify cooldown ACTIVE
    cycle >/dev/null 2>&1
    [ -s "$MOTIONF" ] || { echo "smoke-test: FAIL (a threshold crossing under cooldown must still stamp .imac-cam-last-motion)"; exit 1; }
    [ -s "$CATLOG" ] && { echo "smoke-test: FAIL (an active cooldown must still suppress the classify — CATLOG got a row)"; exit 1; }
    unset -f mesh-imac-cam mesh-object-id mesh-face-recognize
    rm -rf "$_mt"
    # real single cycle: proves the diff+classify wiring actually runs against live hardware.
    # MESH was already resolved at script startup — a MESH_DIR= prefix here would NOT retroactively
    # redirect it, so reassign the derived path globals directly before calling the function.
    LOG="$td/imac-cam-watch.log" CATLOG="$td/imac-cat-log.tsv" PERSONLOG="$td/imac-person-log.tsv" STATE="$td/.imac-cam-watch.state" PREV="$td/.imac-cam-prev.jpg" MOTIONF="$td/.imac-cam-last-motion" LASTF="$td/.imac-cam-last-classify" COVSINCE="$td/.imac-cam-covered-since"
    cycle >/dev/null 2>&1
    rc=$?
    [ -f "$STATE" ] || { echo "smoke-test: FAIL (cycle did not write a liveness state)"; exit 1; }
    echo "smoke-test: ok (diff-metric math correct; COVERED/DARK split + dwell one-shot verified; one real cycle ran, state=$(cat "$STATE" 2>/dev/null))"
    exit 0 ;;
  --state)
    [ -f "$STATE" ] && cat "$STATE" || echo "no state yet (never run)"; exit 0 ;;
  --daemon)
    log_evt "imac-cam-watch START (poll=${CAM_POLL}s thresh=$CAM_THRESH)"
    while true; do cycle >/dev/null 2>&1 || true; sleep "$CAM_POLL"; done ;;
  *)
    cycle ;;
esac
