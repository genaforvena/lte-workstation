#!/usr/bin/env python3
"""Read or atomically switch synthetic Mesh wake authority."""
import argparse
import json
import sys
from mesh_mishe_delivery import BoundaryError, read_authority, switch


def main():
    parser = argparse.ArgumentParser()
    sub = parser.add_subparsers(dest="command", required=True)
    read = sub.add_parser("read")
    read.add_argument("channel")
    change = sub.add_parser("switch")
    change.add_argument("channel")
    change.add_argument("--to", required=True, choices=("legacy", "mishe"))
    change.add_argument("--expect-generation", required=True, type=int)
    change.add_argument("--feed-seq", required=True, type=int)
    args = parser.parse_args()
    try:
        value = read_authority(args.channel) if args.command == "read" else switch(
            args.channel, args.to, args.expect_generation, args.feed_seq)
    except (BoundaryError, ValueError, OSError, ImportError) as exc:
        print(f"mesh-mishe-authority: UNKNOWN {exc}", file=sys.stderr)
        return 2
    print(json.dumps(value, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
