#!/usr/bin/env python3
"""Read, preflight or atomically switch Mesh wake authority."""
import argparse
import json
import sys
from mesh_mishe_delivery import BoundaryError, preflight, read_authority, switch


def main():
    parser = argparse.ArgumentParser()
    sub = parser.add_subparsers(dest="command", required=True)
    read = sub.add_parser("read")
    read.add_argument("channel")
    allowed = sub.add_parser("legacy-allowed")
    allowed.add_argument("channel")
    change = sub.add_parser("switch")
    change.add_argument("channel")
    change.add_argument("--to", required=True, choices=("legacy", "mishe"))
    change.add_argument("--expect-generation", required=True, type=int)
    change.add_argument("--feed-seq", required=True, type=int)
    probe = sub.add_parser("preflight")
    probe.add_argument("channel")
    probe.add_argument("--expect-generation", required=True, type=int)
    probe.add_argument("--feed-seq", required=True, type=int)
    args = parser.parse_args()
    try:
        value = (switch(args.channel, args.to, args.expect_generation, args.feed_seq)
                 if args.command == "switch" else
                 preflight(args.channel, args.expect_generation, args.feed_seq)
                 if args.command == "preflight" else read_authority(args.channel))
    except (BoundaryError, ValueError, OSError, ImportError) as exc:
        print(f"mesh-mishe-authority: UNKNOWN {exc}", file=sys.stderr)
        return 2
    if args.command == "legacy-allowed":
        print(f"{args.channel}: authority={value['authority']} generation={value['generation']}")
        return 0 if value["authority"] == "legacy" else 1
    if args.command == "preflight":
        print(json.dumps(value, sort_keys=True))
        return 0 if value["ready"] else 2
    print(json.dumps(value, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
