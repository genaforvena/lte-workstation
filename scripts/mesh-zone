#!/usr/bin/env bash
# mesh-zone — derive a room-level zone map from multi-node BLE presence logs.
# Reads ~/.mesh/presence.log on this node + remote scanning peers (via SSH).
# For each device seen by ≥1 node, assigns it to the node with highest RSSI.
# Writes ~/.mesh/zone-map.txt (human) and ~/.mesh/zone-map.json (machine).
#
#   mesh-zone              compute from this node + auto-discovered scanning peers
#   mesh-zone --show       print current zone map
#   mesh-zone --loop [s]   recompute every N sec (default 300)
#
# Consumed by: zone-aware actuator routing, any reflex needing room-level context.
# Design ref: ~/.mesh/knowledge/presence-zone-inference.md

set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
MESH="$HOME/.mesh"
SELF="$(hostname)"
MAP_TXT="$MESH/zone-map.txt"
MAP_JSON="$MESH/zone-map.json"
mkdir -p "$MESH"

case "${1:-}" in
  --show)
    [ -f "$MAP_TXT" ] && cat "$MAP_TXT" || echo "(no zone map yet — run mesh-zone first)"
    exit 0 ;;
  --loop)
    iv="${2:-300}"
    echo "[mesh-zone] zone map recompute every ${iv}s on $SELF"
    while true; do
      : > "$MESH/mesh-zone.beat"
      "$0" 2>/dev/null || true
      sleep "$iv"
    done
    exit 0 ;;
esac

# Collect local log
local_log=$(cat "$MESH/presence.log" 2>/dev/null || true)

# Collect remote peer logs (try known scanning peers)
peer_data=""
for peer in "imozerov@100.73.170.56"; do
  peerhost=$(ssh -o ConnectTimeout=3 -o StrictHostKeyChecking=no "$peer" hostname 2>/dev/null) || continue
  [ "$peerhost" = "$SELF" ] && continue
  peerlog=$(ssh -o ConnectTimeout=3 -o StrictHostKeyChecking=no "$peer" \
    "cat ~/.mesh/presence.log 2>/dev/null" 2>/dev/null) || continue
  peer_data="${peer_data}${peerlog}"$'\n'
done

python3 - "$SELF" "$MAP_TXT" "$MAP_JSON" <<PY
import sys, json, re, collections
self_node, map_txt, map_json = sys.argv[1], sys.argv[2], sys.argv[3]

local_log  = """${local_log}"""
peer_data  = """${peer_data}"""
all_logs   = local_log + "\n" + peer_data

# Parse: "ts node n=X devices=[rssi|mac|name rssi|mac|name ...]"
# Split on " -digits|MAC|" boundary so names containing ] or spaces work fine.
ENTRY_SPLIT = re.compile(r' (?=-\d+\|[0-9A-Fa-f:]{17}\|)')
ENTRY_RE    = re.compile(r'^(-\d+)\|([0-9A-Fa-f:]{17})\|(.*)$')

# mac -> {node -> best_rssi, name}
devices = collections.defaultdict(lambda: {"nodes": {}, "name": "?"})

for line in all_logs.splitlines():
    line = line.strip()
    if not line:
        continue
    parts = line.split()
    if len(parts) < 2:
        continue
    node = parts[1]
    m = re.search(r'devices=\[(.+)\]$', line)
    if not m:
        continue
    block = m.group(1)
    for entry in ENTRY_SPLIT.split(block):
        em = ENTRY_RE.match(entry.strip())
        if not em:
            continue
        rssi_s, mac, name = em.group(1), em.group(2).upper(), em.group(3).strip()
        try:
            rssi = int(rssi_s)
        except ValueError:
            continue
        mac = mac.upper()
        try:
            rssi = int(rssi_s)
        except ValueError:
            continue
        d = devices[mac]
        if node not in d["nodes"] or rssi > d["nodes"][node]:
            d["nodes"][node] = rssi
        if name not in ("?", ""):
            d["name"] = name

if not devices:
    print("no presence data found in logs")
    sys.exit(1)

ts = __import__('datetime').datetime.utcnow().strftime('%Y-%m-%dT%H:%MZ')
zones = collections.defaultdict(list)
zone_map = {}

for mac, info in sorted(devices.items()):
    node_rssis = info["nodes"]
    best_node  = max(node_rssis, key=lambda n: node_rssis[n])
    multi      = len(node_rssis) > 1
    zone_map[mac] = {
        "name": info["name"], "zone": best_node,
        "rssi": node_rssis,   "multi_node": multi
    }
    zones[best_node].append((node_rssis[best_node], mac, info["name"]))

with open(map_txt, 'w') as f:
    f.write(f"=== zone map @ {ts} ===\n")
    for node in sorted(zones):
        label = node + (" ← this node" if node == self_node else "")
        f.write(f"\n[{label}]\n")
        for rssi, mac, name in sorted(zones[node], reverse=True):
            tag = " *" if zone_map[mac]["multi_node"] else "  "
            f.write(f"{tag} {rssi:4d} dBm  {mac}  {name}\n")
    f.write("\n(* seen by ≥2 nodes, assigned by strongest signal)\n")

with open(map_json, 'w') as f:
    json.dump({"ts": ts, "self": self_node, "devices": zone_map}, f, indent=2)

print(open(map_txt).read())
PY
