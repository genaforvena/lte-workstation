#!/usr/bin/env bash
# mesh-heavy-drain — retry heavy jobs deferred by mesh-heavy-run.
#
# A resource refusal is temporary state. This reflex drains the durable queue when the node recovers;
# mesh-heavy-run rechecks the live budget and pressure gate before every launch.
# reflex-cadence: */2 * * * *
# reflex-args: --run
# orphan-ok: cron/reflex queue drain; serialized and idempotent.
set -u -o pipefail
export PATH="$HOME/.local/bin:$PATH"

case "${1:---run}" in
  --run) exec mesh-heavy-run --drain ;;
  --test)
    expected='mesh-heavy-run --drain'
    actual="${MESH_HEAVY_DRAIN_CMD:-mesh-heavy-run} --drain"
    [ "$actual" = "$expected" ] || { echo 'smoke-test: FAIL (drain command contract changed)' >&2; exit 1; }
    echo 'smoke-test: ok (resource-deferred heavy jobs have a recurring drain)' ;;
  *) echo "usage: $0 [--run|--test]" >&2; exit 2 ;;
esac
