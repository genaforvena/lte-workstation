#!/usr/bin/env bash
# mesh-msg-pane — the MESSAGE/EVENT sub-pane of a channel window (operator 2026-06-21). The top of each
# channel window splits into two sub-panes: STATE (mesh-dash <role> — a live, ephemeral, read-latest
# snapshot) and MESSAGES (this tool). The split is VISUAL — state and events are physically separate
# panes, which is simpler than mixing them with sticky-region logic in one render (operator: "не
# усложняй — пусть каждый топ-пейн имеет под-пейн, чтобы они были разделены визуально").
#
# Why a separate mechanism from the state pane: a message is a DISCRETE FACT and the ONLY copy of it —
# there is no next sample to re-carry it, so (unlike state) it must NOT just be read-latest. Two jobs:
#   1) ALWAYS-VISIBLE: render the event tape as a full-frame surface (header + recent lines fit to the
#      pane + a per-frame tick footer) so nothing important scrolls into oblivion off-screen.
#   2) PUSH-ON-ARRIVAL: when a new line lands, deliver the message ITSELF to the mind at-least-once
#      (edge-delivery, idle-gated so never mid-turn) — the mind does not wait for an interval to find it.
#
#   mesh-msg-pane <channel>          render loop + push new lines to the mind (runs IN the message pane)
#   mesh-msg-pane <channel> --once   one render + one push pass (test / tick)
#   mesh-msg-pane --test             smoke
#
# Tape: ~/.mesh/msg/<channel>.log (producer: mesh-msg). Push cursor: ~/.mesh/msg/.<channel>.pushed
# (a count of lines already delivered → at-least-once, no re-push of old events on restart).
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
S="$(hostname)"
MSGDIR="$HOME/.mesh/msg"
REFRESH="${MESH_MSG_REFRESH:-15}"
ts(){ date -u +%FT%TZ; }

# Mind pane = BOTTOM pane (largest pane_top) — same convention as mesh-pane-consume / mesh-tell. A 3-pane
# window (state | messages on top, mind below) keeps the mind as the bottom pane, so this still resolves.
mind_pane(){ tmux list-panes -t "$S:$1" -F '#{pane_top} #{pane_index}' 2>/dev/null | sort -n | tail -1 | awk '{print $2}'; }
# Idle-gate (engine-agnostic, double-capture the mind pane): a working TUI redraws, an idle one is static.
mind_idle(){ local ch="$1" p a b; p="$(mind_pane "$ch")"
  a="$(tmux capture-pane -t "$S:$ch.${p:-1}" -p -S -6 2>/dev/null)"; [ -z "$a" ] && return 1
  sleep 2.5; b="$(tmux capture-pane -t "$S:$ch.${p:-1}" -p -S -6 2>/dev/null)"; [ "$a" = "$b" ]; }

render(){ # <channel> — always-visible full frame: header + recent tape fit to pane + tick footer
  local ch="$1" rows; rows="$(tmux display -t "$S:$ch" -p '#{pane_height}' 2>/dev/null)"; rows="${rows:-12}"
  local body=$(( rows > 6 ? rows - 4 : 6 ))
  clear
  printf 'MESSAGES — %s   (event tape · push-on-arrival · NOT state)\n' "$ch"
  printf -- '----------------------------------------------------------------\n'
  if [ -s "$MSGDIR/$ch.log" ]; then tail -n "$body" "$MSGDIR/$ch.log"; else printf '  (no events yet)\n'; fi
  printf -- '\n-- msg-pane live %s · refresh %ss · new lines push to mind at-least-once · frozen = dead --\n' "$(ts)" "$REFRESH"
}

push_new(){ # <channel> — deliver not-yet-pushed lines to the mind (idle-gated, at-least-once)
  local ch="$1" log="$MSGDIR/$ch.log" cur="$MSGDIR/.$ch.pushed" total pushed new
  [ -f "$log" ] || return 0
  total="$(wc -l < "$log" 2>/dev/null)"; total="${total:-0}"
  pushed="$(cat "$cur" 2>/dev/null)"; pushed="${pushed:-0}"
  [ "$total" -le "$pushed" ] && return 0
  mind_idle "$ch" || return 0   # mind busy — retry next pass (cursor NOT advanced → at-least-once)
  new="$(sed -n "$((pushed+1)),${total}p" "$log" | tr '\n' '|')"
  mesh-tell "$ch" "[$ch msg] event(s) arrived: ${new} — act on it or ack with one terse line (this is a pushed FACT, not a state read)" >/dev/null 2>&1
  echo "$total" > "$cur"
}

# ---- test ----
if [ "${1:-}" = --test ]; then
  command -v tmux >/dev/null 2>&1 || { echo "smoke-test: FAIL (no tmux)"; exit 1; }
  command -v mesh-tell >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-tell)"; exit 1; }
  mkdir -p "$MSGDIR"
  r="$(render __selftest)"; case "$r" in *"MESSAGES — __selftest"*) : ;; *) echo "smoke-test: FAIL (render header)"; exit 1;; esac
  case "$r" in *"push to mind at-least-once"*) : ;; *) echo "smoke-test: FAIL (render footer)"; exit 1;; esac
  echo "smoke-test: ok (always-visible render + idle-gated push-on-arrival; state stays on mesh-dash)"; exit 0
fi

ch="${1:?usage: mesh-msg-pane <channel> [--once]}"; shift || true
mkdir -p "$MSGDIR"; [ -f "$MSGDIR/$ch.log" ] || : > "$MSGDIR/$ch.log"
tmux has-session -t "$S" 2>/dev/null || { echo "mesh-msg-pane: no tmux session '$S'" >&2; exit 1; }

if [ "${1:-}" = --once ]; then render "$ch"; push_new "$ch"; exit 0; fi
while :; do render "$ch"; push_new "$ch" || true; sleep "$REFRESH"; done
