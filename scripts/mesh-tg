#!/usr/bin/env bash
# mesh-tg — outgoing bridge: mesh -> the operator's Telegram (the @openclam bot).
# Pairs with proxy-bot's owner-mirror (incoming TG -> mesh-chat). Together the bot is a
# comms channel synced with the tmux nervous system of text.
#
#   mesh-tg "<msg>"     send one message to the operator now
#   mesh-tg --file <path> [caption]
#                       upload a file to the operator: the API method is picked from the
#                       extension (photo/voice/audio/video/animation, else document), so an
#                       image arrives as an image and an .ogg as a playable voice note.
#                       Caption capped at Telegram's 1024 chars.
#   mesh-tg --watch     tail mesh-chat and forward IMPORTANT lines ([ALERT]/[news]/@tg/
#                       @operator) to the operator's Telegram (deduped, no loops)
#
# Token/chat from ~/.config/remote-access/env. sendMessage has no single-consumer limit,
# so a --watch may run on every node without conflicting with proxy-bot's getUpdates poll.
set -uo pipefail
# Force a UTF-8 locale so bash's ${text:0:N} slicing lands on CHARACTER boundaries, not bytes.
# C.UTF-8 is universally shipped (glibc ≥2.35) and is independent of whether the caller's env had
# LANG/LC_CTYPE set — a systemd unit or cron may inherit LC_CTYPE=C, under which slicing reverts
# to byte-semantics and the multibyte-chunking fix below silently regresses to the original bug.
# Without this, head -c / tail -c + chunking splits Cyrillic (2-byte UTF-8) codepoints → malformed
# payload → Telegram rejects or displays garbage (port of gf-borrowing d4e0271, 2026-07-19).
export LC_ALL=C.UTF-8

# chunk_one — split $1 into (first 3900 chars, rest), returned in the globals CHUNK / REST.
# A FUNCTION (not inline in send) so --test can exercise the EXACT split send() uses: a mutation that
# reverts to byte-chunking must RED the test, not pass silently against a parallel slice. Char-based
# (not byte-based) so multibyte Cyrillic codepoints are never split (port of gf-borrowing d4e0271).
# Defined early (before --test) so the test can drive it directly.
#
# GLOBALS, not a tab-separated stdout line (2026-08-15, found live by the operator: "вечно эта
# проблема"). The old shape printed "chunk<TAB>rest" and send() consumed it with
# `IFS=$'\t' read -r chunk text`, but **`read` stops at the first NEWLINE** — so a multi-line message
# was silently truncated to its FIRST LINE and the remainder was dropped before any curl ran. The send
# reported ok:true, tg-sent.log logged a (newline-flattened) excerpt, and every gate stayed green,
# because the payload was mangled UPSTREAM of everything that checks delivery. The operator got
# "В Termux вставь одной строкой:" with the command missing. A tab-separated stdout contract cannot be
# fixed by reading it more carefully either — the payload may contain tabs as well, so no in-band
# delimiter is safe for arbitrary text. Out-of-band (globals) is the only split with no forbidden byte.
chunk_one(){ CHUNK="${1:0:3900}"; REST="${1:3900}"; }

# log_excerpt — one-line, CHARACTER-truncated excerpt for tg-sent.log. `head -c 120` (the shape both
# writers used until 2026-08-04) is the SAME byte-vs-char bug the chunking comment above documents,
# one file lower down: the operator's traffic is Russian, so a 120-BYTE cut lands mid-codepoint and
# leaves tg-sent.log invalid UTF-8 — `tail` on it dies ("stream did not contain valid UTF-8") and the
# reply-watchdog that reads it reads a corrupt file. Found by the --file caption doing exactly that.
log_excerpt(){ printf '%s' "${1:0:120}" | tr '\n' ' '; }

# tg_file_method — map a path to the Telegram API method + its form field, tab-separated.
# A FUNCTION (not inline in send_file) for the same reason as chunk_one: --test drives the EXACT
# mapping the send path uses, so a mutation reds. Extension-based on purpose — the operator's eye
# is the consumer, and sendDocument for a .jpg arrives as a grey file row instead of a picture.
tg_file_method(){
  local base="${1##*/}" ext
  ext="$(printf '%s' "${base##*.}" | tr 'A-Z' 'a-z')"
  [ "$ext" = "$base" ] && ext=""            # no dot at all -> no extension, not "the whole name"
  case "$ext" in
    jpg|jpeg|png|webp)         printf '%s\t%s' sendPhoto photo ;;
    gif)                       printf '%s\t%s' sendAnimation animation ;;
    mp4|mov|mkv)               printf '%s\t%s' sendVideo video ;;
    ogg|oga|opus)              printf '%s\t%s' sendVoice voice ;;
    mp3|m4a|wav|flac|aac)      printf '%s\t%s' sendAudio audio ;;
    *)                         printf '%s\t%s' sendDocument document ;;
  esac
}
# ── --help guard (pub/argv-is-payload-tools-fire-on-help, 2026-07-15) ──────────────────────────────
# argv IS this tool's payload, so the universal discovery gesture WAS the action: `--help` sent the
# literal string '--help' down the send path. Proven live on the operator at 03:18Z (mesh-tg-update
# --help mailed him a commit digest; mesh-tg --help texted him '--help'). The safe way to ask what a
# thing does must not BE the thing — so this comes FIRST, before any dispatch, sandbox gate or config
# read. usage() renders this file's own header block, so it can never drift from the docs above.
usage(){ sed -n '2,/^[^#]/p' "$0" | sed -n 's/^# \?//p'; }
case "${1:-}" in -h|--help) usage; exit 0 ;; esac

ENVF="$HOME/.config/remote-access/env"
if [ "${1:-}" = "--test" ]; then
  command -v curl >/dev/null 2>&1 || { echo "smoke-test: FAIL (no curl)"; exit 1; }
  # CHUNKING gate (port of gf-borrowing d4e0271, 2026-07-19): chunk_one — the EXACT split send() uses —
  # must cut on CHARACTER boundaries, not bytes. `head -c 3900` on Cyrillic (2-byte UTF-8) splits a
  # codepoint in two → chunk1 ends on a dangling 0xd0..0xd1 lead byte → invalid UTF-8 → Telegram rejects
  # or stores garbled. The operator's TG traffic is heavily Russian — silent corruption, not a nit.
  # This drives chunk_one directly (not a parallel slice), so mutating chunk_one to the byte-form REDS.
  command -v python3 >/dev/null 2>&1 || { echo "smoke-test: FAIL (no python3 for UTF-8 validity check)"; exit 1; }
  _cytest="$(printf 'а%.0s' {1..5000})"   # 5000 Cyrillic 'а' = 10000 UTF-8 bytes
  [ "${#_cytest}" = 5000 ] || { echo "smoke-test: FAIL (locale not UTF-8: 5000 Cyrillic chars measured ${#_cytest} — slicing will be byte-based, the original bug)"; exit 1; }
  chunk_one "$_cytest"; _chunk1="$CHUNK"; _rest="$REST"
  { [ "${#_chunk1}" = 3900 ] && [ "${#_rest}" = 1100 ]; } \
    || { echo "smoke-test: FAIL (chunk_one sizes wrong: ${#_chunk1}+${#_rest} != 5000 chars)"; exit 1; }
  # NEWLINE gate (2026-08-15, found live): chunk_one must carry a MULTI-LINE payload through whole.
  # The pre-fix shape emitted "chunk<TAB>rest" on stdout and send() consumed it with `read`, which
  # stops at the first newline — a multi-line message was truncated to line 1 and the rest DROPPED,
  # with ok:true reported. Assert the full round-trip, incl. a TAB in the payload (the other byte an
  # in-band delimiter would eat) and a trailing newline (which `$(...)` capture would have stripped).
  # The TAB leg is about OUR split only — measured on the live API 2026-08-15, Telegram itself renders
  # a TAB in message text as a SPACE, so an end-to-end round-trip equality can never hold for a tabbed
  # payload; the newline round-trip DOES hold verbatim (blank lines included) and is the wire artifact.
  printf -v _nl 'line1\n\nline2\ttabbed\nline3\n'   # printf -v, not $(...): capture would STRIP the trailing \n
  chunk_one "$_nl"
  [ "$CHUNK" = "$_nl" ] \
    || { echo "smoke-test: FAIL (chunk_one truncated a multi-line/tabbed payload: sent $(printf '%q' "$CHUNK"), want $(printf '%q' "$_nl"))"; exit 1; }
  [ -z "$REST" ] || { echo "smoke-test: FAIL (chunk_one left a remainder on a short payload: $(printf '%q' "$REST"))"; exit 1; }
  # ...and the same for a payload that CROSSES the 3900 boundary with newlines on both sides of it,
  # so the loop's second iteration is covered too (chunk1+rest must reassemble to the original).
  printf -v _nl2 'a\n%s\nb\n' "$_cytest"            # 5000 Cyrillic chars wrapped in newlines
  chunk_one "$_nl2"
  [ "$CHUNK$REST" = "$_nl2" ] \
    || { echo "smoke-test: FAIL (chunk_one lost bytes across the 3900-char boundary: ${#CHUNK}+${#REST} != ${#_nl2})"; exit 1; }
  printf '%s' "$_chunk1" | python3 -c "import sys; sys.stdin.buffer.read().decode('utf-8')" 2>/dev/null \
    || { echo "smoke-test: FAIL (chunk_one's first chunk is not valid UTF-8 — multibyte codepoint split, the d4e0271 bug class)"; exit 1; }
  printf '%s' "$_rest" | python3 -c "import sys; sys.stdin.buffer.read().decode('utf-8')" 2>/dev/null \
    || { echo "smoke-test: FAIL (chunk_one's remainder is not valid UTF-8 — multibyte codepoint split, the d4e0271 bug class)"; exit 1; }
  [ -f "$ENVF" ] && { set -a; . "$ENVF"; set +a; }
  TOKEN="${BOT_TOKEN:-}"; CHAT="${CHAT_ID:-}"
  [ -n "$TOKEN" ] && [ -n "$CHAT" ] || { echo "smoke-test: FAIL (BOT_TOKEN/CHAT_ID not set in $ENVF)"; exit 1; }
  resp="$(curl -s -m 10 "https://api.telegram.org/bot${TOKEN}/getMe" 2>/dev/null)"
  printf '%s' "$resp" | grep -q '"ok":true' || { echo "smoke-test: FAIL (telegram getMe failed)"; exit 1; }
  # TEST-SANDBOX gate: a send attempted under MESH_TEST_SANDBOX=1 must be SUPPRESSED (exit 0, no
  # sendMessage) — the doctor smoke sweep exports it so a tool's unsandboxed --test can't spam the
  # operator (the test-guardian-peer flood class). Safe to exercise: the gate exits before any curl.
  _sup="$(MESH_TEST_SANDBOX=1 "$0" "sandbox probe — must never reach Telegram" 2>&1)"; _rc=$?
  { [ "$_rc" = 0 ] && printf '%s' "$_sup" | grep -q 'SUPPRESSED'; } \
    || { echo "smoke-test: FAIL (MESH_TEST_SANDBOX gate broken: rc=$_rc out='$_sup')"; exit 1; }
  # FILE-METHOD gate: tg_file_method — the EXACT mapping send_file uses — must route by extension.
  # sendDocument for a .jpg is not a broken send, it is a WORSE one (grey file row, no preview), so
  # the failure is invisible to any ok:true check and only the mapping can catch it.
  for _case in "a.jpg:sendPhoto:photo" "a.JPEG:sendPhoto:photo" "a.png:sendPhoto:photo" \
               "a.ogg:sendVoice:voice" "a.mp3:sendAudio:audio" "a.mp4:sendVideo:video" \
               "a.gif:sendAnimation:animation" "a.txt:sendDocument:document" \
               "/tmp/no-extension:sendDocument:document" "/x.d/plain:sendDocument:document"; do
    _p="${_case%%:*}"; _want="${_case#*:}"
    _got="$(tg_file_method "$_p" | tr '\t' ':')"
    [ "$_got" = "$_want" ] || { echo "smoke-test: FAIL (tg_file_method '$_p' -> '$_got', want '$_want')"; exit 1; }
  done
  # LOG-EXCERPT gate (2026-08-04, found live): the tg-sent.log writers truncated by BYTES, so a
  # Cyrillic caption/message was cut mid-codepoint and CORRUPTED the log the reply-watchdog reads
  # (`tail` refused it: "stream did not contain valid UTF-8"). Same class as the chunking gate above,
  # different consumer. Drives log_excerpt directly, so a revert to `head -c` reds.
  _lx="$(log_excerpt "$(printf 'я%.0s' {1..200})")"
  [ "${#_lx}" = 120 ] || { echo "smoke-test: FAIL (log_excerpt cut to ${#_lx} chars, want 120 — byte-based truncation)"; exit 1; }
  printf '%s' "$_lx" | python3 -c "import sys; sys.stdin.buffer.read().decode('utf-8')" 2>/dev/null \
    || { echo "smoke-test: FAIL (log_excerpt output is not valid UTF-8 — it would corrupt tg-sent.log)"; exit 1; }
  [ "$(log_excerpt "$(printf 'a\nb')")" = "a b" ] \
    || { echo "smoke-test: FAIL (log_excerpt left a newline — one send would become two log rows)"; exit 1; }
  # FILE-REFUSAL gate: a bad path must FAIL LOUD, never exit 0 having sent nothing (the silent-fallback
  # class). Both cases return before any curl, so this is network-free.
  _mt="$(mktemp)"   # 0 bytes
  for _bad in "/nonexistent/definitely-not-here.png" "$_mt"; do
    # MESH_TEST_SANDBOX=0 on purpose: doctor exports the flag for every child --test, and this arm
    # re-invokes the tool ITSELF — under an inherited flag the send returns early SUPPRESSED rc=0
    # before the path is ever validated, so the refusal this arm asserts never happens and a green
    # tool reds. The dedicated sandbox gates below set the flag themselves and are unaffected.
    _out="$(MESH_TEST_SANDBOX=0 "$0" --file "$_bad" 2>&1)"; _rc=$?
    { [ "$_rc" != 0 ] && printf '%s' "$_out" | grep -qi 'FAILED'; } \
      || { echo "smoke-test: FAIL (--file '$_bad' should refuse loudly: rc=$_rc out='$_out')"; rm -f "$_mt"; exit 1; }
  done
  # ...and the sandbox suppression must cover the FILE path too, not just the text path.
  printf 'x' > "$_mt"
  _sup="$(MESH_TEST_SANDBOX=1 "$0" --file "$_mt" "sandbox probe" 2>&1)"; _rc=$?
  { [ "$_rc" = 0 ] && printf '%s' "$_sup" | grep -q 'SUPPRESSED'; } \
    || { echo "smoke-test: FAIL (--file bypasses MESH_TEST_SANDBOX: rc=$_rc out='$_sup')"; rm -f "$_mt"; exit 1; }
  rm -f "$_mt"
  # LIVE upload (opt-in, MESH_TG_LIVE_FILE=1): the only assertion that exercises the thing this wraps
  # — every gate above drives stubs. Off by default because it messages the operator for real; run it
  # by hand after touching the upload path ("a wrapper's test must exercise the thing it wraps").
  _live="n/a"
  if [ "${MESH_TG_LIVE_FILE:-0}" = 1 ]; then
    _lf="$(mktemp --suffix=.txt)"; printf 'mesh-tg --file live gate %s\n' "$(date -u +%FT%TZ)" > "$_lf"
    if send_file "$_lf" "mesh-tg --file live gate"; then _live="ok"; else
      echo "smoke-test: FAIL (live --file upload: ${SEND_ERR:-?})"; rm -f "$_lf"; exit 1; fi
    rm -f "$_lf"
  fi
  echo "smoke-test: ok (bot=$(printf '%s' "$resp" | python3 -c 'import json,sys;print(json.load(sys.stdin).get("result",{}).get("username","?"))' 2>/dev/null) + MESH_TEST_SANDBOX send-suppression gate + --file method/refusal gates, live-upload=$_live)"
  exit 0
fi
# TEST-SANDBOX gate (chat-review/doctor-smoke-sandbox-net, 2026-07-02): MESH_TEST_SANDBOX=1 marks a
# smoke-sweep context (mesh-doctor exports it around every child --test) — NEVER send real Telegram
# from it; a tool whose --test forgot to gate its own outbound would otherwise spam the operator.
# Suppressed send = exit 0 (success to the caller: the message was intentionally not delivered).
if [ "${MESH_TEST_SANDBOX:-0}" = 1 ]; then
  echo "mesh-tg: MESH_TEST_SANDBOX — real Telegram send SUPPRESSED (smoke-sweep context): ${*:-}" >&2
  exit 0
fi
[ -f "$ENVF" ] && { set -a; . "$ENVF"; set +a; }
TOKEN="${BOT_TOKEN:-}"; CHAT="${CHAT_ID:-}"
[ -n "$TOKEN" ] && [ -n "$CHAT" ] || { echo "mesh-tg: BOT_TOKEN/CHAT_ID not set in $ENVF" >&2; exit 1; }

# GUARD (2026-06-10 leak): mesh-tg is the operator's PERSONAL channel ONLY. The sign-guard now lives
# in the SHARED mesh-tg-guard (gf-borrowing-4 — single source of truth for all ~11 TG senders): it
# refuses a negative (group/channel) id, a wrong-positive id, and enforces the personal allowlist.
# Bootstrap fallback (guard binary absent) keeps the critical inline checks — never open the channel.
if command -v mesh-tg-guard >/dev/null 2>&1; then
  mesh-tg-guard --check "$CHAT" personal >/dev/null || exit 3   # prints the REFUSED reason to stderr
else
  case "$CHAT" in -*) echo "mesh-tg: REFUSED — CHAT_ID=$CHAT is a group/channel (mesh-tg-guard absent; inline fallback). Fix $ENVF." >&2; exit 3 ;; esac
  if [ -n "${MESH_OWNER_CHAT:-}" ] && [ "$CHAT" != "$MESH_OWNER_CHAT" ]; then
    echo "mesh-tg: REFUSED — CHAT_ID=$CHAT != MESH_OWNER_CHAT (mesh-tg-guard absent; inline fallback). Fix $ENVF." >&2; exit 3
  fi
fi

# resp_check — the ONE place a Telegram API response becomes a verdict, plus the 403 rising-edge alert
# and its recovery. Shared by send() and send_file(): a file upload must reach the operator's
# blocked-bot alarm exactly like a text send does, and two copies of a debounce drift apart.
resp_check(){ # $1 raw response  -> 0 delivered / 1 failed (sets SEND_ERR, SEND_ERR_CODE)
  local resp="$1" err_code err_desc
  err_code=$(printf '%s' "$resp" | sed -nE 's/.*"error_code":([0-9]+).*/\1/p')
  err_desc=$(printf '%s' "$resp" | sed -nE 's/.*"description":"([^"]*)".*/\1/p')
  if printf '%s' "$resp" | grep -q '"ok":true'; then
    SEND_ERR=""; SEND_ERR_CODE=0
    # Recover from prior 403 (bot unblocked) → post recovery to board
    if [ -f "$HOME/.mesh/.tg-403-state" ] && [ "$(cat "$HOME/.mesh/.tg-403-state" 2>/dev/null)" = 403 ]; then
      echo OK > "$HOME/.mesh/.tg-403-state"
      command -v mesh-chat >/dev/null 2>&1 && \
        mesh-chat "[alert] mesh-tg: chat_id=${CHAT} RECOVERED — send succeeded after previous 403 (bot unblocked by operator)." >/dev/null 2>&1 || true
    fi
    return 0
  fi
  SEND_ERR="${err_desc:-unknown (curl/network)}"
  SEND_ERR_CODE="${err_code:-0}"
  if [ "$SEND_ERR_CODE" = 403 ]; then
    # debounce: only alert on rising edge (not on every retry/chunk)
    if [ ! -f "$HOME/.mesh/.tg-403-state" ] || [ "$(cat "$HOME/.mesh/.tg-403-state" 2>/dev/null)" != 403 ]; then
      echo 403 > "$HOME/.mesh/.tg-403-state"
      command -v mesh-chat >/dev/null 2>&1 && \
        mesh-chat "[alert] mesh-tg: chat_id=${CHAT} blocked/deleted — Telegram returned 403 (bot blocked by user). Operator cannot be reached via TG." >/dev/null 2>&1 || true
    fi
  fi
  return 1
}

send(){ # $1 text  $2 silent(true/false)  — VERIFIES delivery (Telegram ok:true), not just curl exit
  # Telegram caps a message at 4096 chars; longer = rejected. Auto-chunk so long sends don't silently fail.
  local text="$1" silent="${2:-false}" chunk resp
  while [ -n "$text" ]; do
    # Chunk by CHARACTERS (Telegram's 4096 limit is on UTF-16/Unicode chars, not bytes). `head -c`/
    # `tail -c +` (the pre-2026-07-19 shape) split multibyte Cyrillic codepoints in two — chunk1 ended
    # on a dangling lead byte (0xd0..0xd1 for Cyrillic), chunk2 began on a continuation byte (0x80..0xbf),
    # both invalid UTF-8 → Telegram rejected or stored garbled. Ported from guy-fawxible d4e0271.
    chunk_one "$text"; chunk="$CHUNK"; text="$REST"
    resp=$(curl -s -X POST "https://api.telegram.org/bot${TOKEN}/sendMessage" \
      --data-urlencode "chat_id=${CHAT}" --data-urlencode "text=$chunk" \
      -d "disable_notification=${silent}" 2>/dev/null)
    resp_check "$resp" || return 1
  done
  SEND_ERR_CODE=0
  return 0
}

# send_file — upload one file, VERIFYING delivery (ok:true) like send(). No chunking: a file is
# atomic to Telegram, so the failure mode here is the SIZE ceiling (50 MB for a bot upload) and the
# 1024-char caption cap — both refused/trimmed up front with a readable reason, because the raw API
# error for an oversize upload is a bare 413 the caller cannot act on.
send_file(){ # $1 path  $2 caption  -> 0 delivered / 1 failed (sets SEND_ERR, SEND_ERR_CODE)
  local path="$1" caption="${2:-}" method field resp bytes
  if [ ! -f "$path" ]; then SEND_ERR="no such file: $path"; SEND_ERR_CODE=0; return 1; fi
  if [ ! -r "$path" ]; then SEND_ERR="not readable: $path"; SEND_ERR_CODE=0; return 1; fi
  bytes=$(wc -c < "$path" 2>/dev/null || echo 0)
  if [ "$bytes" -le 0 ]; then SEND_ERR="empty file (0 bytes): $path"; SEND_ERR_CODE=0; return 1; fi
  if [ "$bytes" -gt 52428800 ]; then
    SEND_ERR="file is ${bytes} bytes — over Telegram's 50 MB bot-upload ceiling: $path"; SEND_ERR_CODE=0; return 1
  fi
  IFS=$'\t' read -r method field < <(tg_file_method "$path")
  caption="${caption:0:1024}"   # Telegram caption cap is 1024 CHARS (LC_ALL=C.UTF-8 keeps this char-wise)
  local -a form=( -F "chat_id=${CHAT}" -F "${field}=@\"${path}\"" )
  [ -n "$caption" ] && form+=( -F "caption=${caption}" )
  # -m 300: an upload is minutes-scale on a slow uplink; the text path's implicit default would cut it.
  resp=$(curl -s -m 300 -X POST "https://api.telegram.org/bot${TOKEN}/${method}" "${form[@]}" 2>/dev/null)
  resp_check "$resp"
}

# Stop the operator "typing…" indicator (mesh-voice-rx started it on ingress). mesh-tg is the TEXT
# reply path the tg mind uses; without this, only the VOICE path (mesh-voice-tx) cleared it, so a
# text reply left the typing bubble refreshing forever. Best-effort, no-op if the helper is absent.
TYPING_HELPER="$HOME/.local/bin/mesh-tg-typing"
stop_typing(){ [ -x "$TYPING_HELPER" ] && "$TYPING_HELPER" --stop >/dev/null 2>&1 || true; }

case "${1:-}" in
  --watch)
    LOG="$HOME/.mesh/chat.log"; touch "$LOG"
    HOST="$(hostname)"
    echo "[mesh-tg] forwarding IMPORTANT $HOST lines -> operator TG"
    tail -n0 -F "$LOG" 2>/dev/null | while IFS= read -r line; do
      # only important news
      echo "$line" | grep -qiE '\[ALERT\]|\[news\]|@tg\b|@operator\b' || continue
      # never re-forward incoming (operator's own mirrored msgs) -> no loop
      echo "$line" | grep -qiE 'tg:operator|mesh-tg' && continue
      send "📡 [$HOST] $line"
    done ;;
  --file)
    [ -n "${2:-}" ] || { echo "usage: mesh-tg --file <path> [caption]" >&2; exit 1; }
    _fpath="$2"; shift 2
    if send_file "$_fpath" "$*"; then
      stop_typing   # a delivered file is a reply too — clear the typing bubble like the text path
      echo "sent to operator TG: $(basename "$_fpath") ($(IFS=$'\t' read -r m _ < <(tg_file_method "$_fpath"); echo "$m"))"
      printf '%sZ  [file] %s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%S)" "$_fpath" \
        "$(log_excerpt "$*")" >> "$HOME/.mesh/tg-sent.log" 2>/dev/null || true
    else
      echo "file send FAILED: ${SEND_ERR:-unknown (curl/network)} (code: ${SEND_ERR_CODE:-0})" >&2
      [ "${SEND_ERR_CODE:-0}" = 403 ] && exit 3
      exit 1
    fi ;;
  "" ) echo "usage: mesh-tg \"<msg>\" | mesh-tg --file <path> [caption] | mesh-tg --watch" >&2; exit 1 ;;
  * ) if send "$*"; then
        stop_typing   # reply delivered -> clear the typing bubble (covers the text reply path)
        echo "sent to operator TG"
        # record the verified reply so the reply-watchdog (mesh-tg-reply-watch) can tell a real
        # reply went out vs. operator-message-stranded-in-silence. Timestamp = UTC ISO, matches voice-in.log.
        printf '%sZ  %s\n' "$(date -u +%Y-%m-%dT%H:%M:%S)" "$(log_excerpt "$*")" >> "$HOME/.mesh/tg-sent.log" 2>/dev/null || true
      else
        echo "send FAILED: ${SEND_ERR:-unknown (curl/network)} (code: ${SEND_ERR_CODE:-0})" >&2
        [ "${SEND_ERR_CODE:-0}" = 403 ] && exit 3
      fi ;;
esac
