#!/usr/bin/env bash
# mesh-tg — outgoing bridge: mesh -> the operator's Telegram (the @openclam bot).
# Pairs with proxy-bot's owner-mirror (incoming TG -> mesh-chat). Together the bot is a
# comms channel synced with the tmux nervous system of text.
#
#   mesh-tg "<msg>"     send one message to the operator now
#   mesh-tg --watch     tail mesh-chat and forward IMPORTANT lines ([ALERT]/[news]/@tg/
#                       @operator) to the operator's Telegram (deduped, no loops)
#
# Token/chat from ~/.config/remote-access/env. sendMessage has no single-consumer limit,
# so a --watch may run on every node without conflicting with proxy-bot's getUpdates poll.
set -uo pipefail
if [ "${1:-}" = "--test" ]; then
  command -v curl >/dev/null 2>&1 || { echo "smoke-test: FAIL (no curl)"; exit 1; }
fi
ENVF="$HOME/.config/remote-access/env"
[ -f "$ENVF" ] && { set -a; . "$ENVF"; set +a; }
TOKEN="${BOT_TOKEN:-}"; CHAT="${CHAT_ID:-}"
[ -n "$TOKEN" ] && [ -n "$CHAT" ] || { echo "mesh-tg: BOT_TOKEN/CHAT_ID not set in $ENVF" >&2; exit 1; }

# GUARD (2026-06-10 leak): mesh-tg is the operator's PERSONAL channel ONLY. A negative chat_id
# (-100…) is a group/channel — refuse to send there, ever. Personal DMs have positive ids.
# Optional hard pin: set MESH_OWNER_CHAT in env to require an exact match.
case "$CHAT" in
  -*) echo "mesh-tg: REFUSED — CHAT_ID=$CHAT is a group/channel, not the operator's personal chat. Fix $ENVF." >&2; exit 3 ;;
esac
if [ -n "${MESH_OWNER_CHAT:-}" ] && [ "$CHAT" != "$MESH_OWNER_CHAT" ]; then
  echo "mesh-tg: REFUSED — CHAT_ID=$CHAT != MESH_OWNER_CHAT=$MESH_OWNER_CHAT. Fix $ENVF." >&2; exit 3
fi
if [ "${1:-}" = "--test" ]; then
  resp="$(curl -s -m 10 "https://api.telegram.org/bot${TOKEN}/getMe" 2>/dev/null)"
  printf '%s' "$resp" | grep -q '"ok":true' || { echo "smoke-test: FAIL (telegram getMe failed)"; exit 1; }
  echo "smoke-test: ok"
  exit 0
fi

send(){ # $1 text  $2 silent(true/false)  — VERIFIES delivery (Telegram ok:true), not just curl exit
  # Telegram caps a message at 4096 chars; longer = rejected. Auto-chunk so long sends don't silently fail.
  local text="$1" silent="${2:-false}" chunk resp
  while [ -n "$text" ]; do
    chunk=$(printf '%s' "$text" | head -c 3900); text=$(printf '%s' "$text" | tail -c +3901)
    resp=$(curl -s -X POST "https://api.telegram.org/bot${TOKEN}/sendMessage" \
      --data-urlencode "chat_id=${CHAT}" --data-urlencode "text=$chunk" \
      -d "disable_notification=${silent}" 2>/dev/null)
    printf '%s' "$resp" | grep -q '"ok":true' || { SEND_ERR=$(printf '%s' "$resp" | sed -nE 's/.*"description":"([^"]*)".*/\1/p'); return 1; }
  done
  return 0
}

case "${1:-}" in
  --watch)
    LOG="$HOME/.mesh/chat.log"; touch "$LOG"
    HOST="$(hostname)"
    echo "[mesh-tg] forwarding IMPORTANT $HOST lines -> operator TG"
    tail -n0 -F "$LOG" 2>/dev/null | while IFS= read -r line; do
      # only important news
      echo "$line" | grep -qiE '\[ALERT\]|\[news\]|@tg\b|@operator\b' || continue
      # never re-forward incoming (operator's own mirrored msgs) -> no loop
      echo "$line" | grep -qiE 'tg:operator|mesh-tg' && continue
      send "📡 [$HOST] $line"
    done ;;
  "" ) echo "usage: mesh-tg \"<msg>\" | mesh-tg --watch" >&2; exit 1 ;;
  * ) send "$*" && echo "sent to operator TG" || echo "send FAILED: ${SEND_ERR:-unknown (curl/network)}" >&2 ;;
esac
