#!/usr/bin/env bash
# mesh-tg — outgoing bridge: mesh -> the operator's Telegram (the @openclam bot).
# Pairs with proxy-bot's owner-mirror (incoming TG -> mesh-chat). Together the bot is a
# comms channel synced with the tmux nervous system of text.
#
#   mesh-tg "<msg>"     send one message to the operator now
#   mesh-tg --watch     tail mesh-chat and forward IMPORTANT lines ([ALERT]/[news]/@tg/
#                       @operator) to the operator's Telegram (deduped, no loops)
#
# Token/chat from ~/.config/remote-access/env. sendMessage has no single-consumer limit,
# so a --watch may run on every node without conflicting with proxy-bot's getUpdates poll.
set -uo pipefail
ENVF="$HOME/.config/remote-access/env"
if [ "${1:-}" = "--test" ]; then
  command -v curl >/dev/null 2>&1 || { echo "smoke-test: FAIL (no curl)"; exit 1; }
  [ -f "$ENVF" ] && { set -a; . "$ENVF"; set +a; }
  TOKEN="${BOT_TOKEN:-}"; CHAT="${CHAT_ID:-}"
  [ -n "$TOKEN" ] && [ -n "$CHAT" ] || { echo "smoke-test: FAIL (BOT_TOKEN/CHAT_ID not set in $ENVF)"; exit 1; }
  resp="$(curl -s -m 10 "https://api.telegram.org/bot${TOKEN}/getMe" 2>/dev/null)"
  printf '%s' "$resp" | grep -q '"ok":true' || { echo "smoke-test: FAIL (telegram getMe failed)"; exit 1; }
  echo "smoke-test: ok (bot=$(printf '%s' "$resp" | python3 -c 'import json,sys;print(json.load(sys.stdin).get("result",{}).get("username","?"))' 2>/dev/null))"
  exit 0
fi
[ -f "$ENVF" ] && { set -a; . "$ENVF"; set +a; }
TOKEN="${BOT_TOKEN:-}"; CHAT="${CHAT_ID:-}"
[ -n "$TOKEN" ] && [ -n "$CHAT" ] || { echo "mesh-tg: BOT_TOKEN/CHAT_ID not set in $ENVF" >&2; exit 1; }

# GUARD (2026-06-10 leak): mesh-tg is the operator's PERSONAL channel ONLY. The sign-guard now lives
# in the SHARED mesh-tg-guard (gf-borrowing-4 — single source of truth for all ~11 TG senders): it
# refuses a negative (group/channel) id, a wrong-positive id, and enforces the personal allowlist.
# Bootstrap fallback (guard binary absent) keeps the critical inline checks — never open the channel.
if command -v mesh-tg-guard >/dev/null 2>&1; then
  mesh-tg-guard --check "$CHAT" personal >/dev/null || exit 3   # prints the REFUSED reason to stderr
else
  case "$CHAT" in -*) echo "mesh-tg: REFUSED — CHAT_ID=$CHAT is a group/channel (mesh-tg-guard absent; inline fallback). Fix $ENVF." >&2; exit 3 ;; esac
  if [ -n "${MESH_OWNER_CHAT:-}" ] && [ "$CHAT" != "$MESH_OWNER_CHAT" ]; then
    echo "mesh-tg: REFUSED — CHAT_ID=$CHAT != MESH_OWNER_CHAT (mesh-tg-guard absent; inline fallback). Fix $ENVF." >&2; exit 3
  fi
fi

send(){ # $1 text  $2 silent(true/false)  — VERIFIES delivery (Telegram ok:true), not just curl exit
  # Telegram caps a message at 4096 chars; longer = rejected. Auto-chunk so long sends don't silently fail.
  local text="$1" silent="${2:-false}" chunk resp err_code err_desc
  while [ -n "$text" ]; do
    chunk=$(printf '%s' "$text" | head -c 3900); text=$(printf '%s' "$text" | tail -c +3901)
    resp=$(curl -s -X POST "https://api.telegram.org/bot${TOKEN}/sendMessage" \
      --data-urlencode "chat_id=${CHAT}" --data-urlencode "text=$chunk" \
      -d "disable_notification=${silent}" 2>/dev/null)
    err_code=$(printf '%s' "$resp" | sed -nE 's/.*"error_code":([0-9]+).*/\1/p')
    err_desc=$(printf '%s' "$resp" | sed -nE 's/.*"description":"([^"]*)".*/\1/p')
    if printf '%s' "$resp" | grep -q '"ok":true'; then
  # Recover from prior 403 (bot unblocked) → post recovery to board
  if [ -f "$HOME/.mesh/.tg-403-state" ] && [ "$(cat "$HOME/.mesh/.tg-403-state" 2>/dev/null)" = 403 ]; then
    echo OK > "$HOME/.mesh/.tg-403-state"
    command -v mesh-chat >/dev/null 2>&1 && \
      mesh-chat "[alert] mesh-tg: chat_id=${CHAT} RECOVERED — sendMessage succeeded after previous 403 (bot unblocked by operator)." >/dev/null 2>&1 || true
  fi
    else
      SEND_ERR="${err_desc:-unknown (curl/network)}"
      SEND_ERR_CODE="${err_code:-0}"
      if [ "$SEND_ERR_CODE" = 403 ]; then
        # debounce: only alert on rising edge (not on every retry/chunk)
        if [ ! -f "$HOME/.mesh/.tg-403-state" ] || [ "$(cat "$HOME/.mesh/.tg-403-state" 2>/dev/null)" != 403 ]; then
          echo 403 > "$HOME/.mesh/.tg-403-state"
          command -v mesh-chat >/dev/null 2>&1 && \
            mesh-chat "[alert] mesh-tg: chat_id=${CHAT} blocked/deleted — Telegram returned 403 (bot blocked by user). Operator cannot be reached via TG." >/dev/null 2>&1 || true
        fi
      fi
      return 1
    fi
  done
  SEND_ERR_CODE=0
  return 0
}

# Stop the operator "typing…" indicator (mesh-voice-rx started it on ingress). mesh-tg is the TEXT
# reply path the tg mind uses; without this, only the VOICE path (mesh-voice-tx) cleared it, so a
# text reply left the typing bubble refreshing forever. Best-effort, no-op if the helper is absent.
TYPING_HELPER="$HOME/.local/bin/mesh-tg-typing"
stop_typing(){ [ -x "$TYPING_HELPER" ] && "$TYPING_HELPER" --stop >/dev/null 2>&1 || true; }

case "${1:-}" in
  --watch)
    LOG="$HOME/.mesh/chat.log"; touch "$LOG"
    HOST="$(hostname)"
    echo "[mesh-tg] forwarding IMPORTANT $HOST lines -> operator TG"
    tail -n0 -F "$LOG" 2>/dev/null | while IFS= read -r line; do
      # only important news
      echo "$line" | grep -qiE '\[ALERT\]|\[news\]|@tg\b|@operator\b' || continue
      # never re-forward incoming (operator's own mirrored msgs) -> no loop
      echo "$line" | grep -qiE 'tg:operator|mesh-tg' && continue
      send "📡 [$HOST] $line"
    done ;;
  "" ) echo "usage: mesh-tg \"<msg>\" | mesh-tg --watch" >&2; exit 1 ;;
  * ) if send "$*"; then
        stop_typing   # reply delivered -> clear the typing bubble (covers the text reply path)
        echo "sent to operator TG"
        # record the verified reply so the reply-watchdog (mesh-tg-reply-watch) can tell a real
        # reply went out vs. operator-message-stranded-in-silence. Timestamp = UTC ISO, matches voice-in.log.
        printf '%sZ  %s\n' "$(date -u +%Y-%m-%dT%H:%M:%S)" "$(printf '%s' "$*" | head -c 120 | tr '\n' ' ')" >> "$HOME/.mesh/tg-sent.log" 2>/dev/null || true
      else
        echo "send FAILED: ${SEND_ERR:-unknown (curl/network)} (code: ${SEND_ERR_CODE:-0})" >&2
        [ "${SEND_ERR_CODE:-0}" = 403 ] && exit 3
      fi ;;
esac
