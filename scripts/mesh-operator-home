#!/usr/bin/env bash
# reflex-cadence: 1-59/5 * * * *
# reflex-args: --edge
# mesh-operator-home — "is the operator physically home?" oracle.
# Combines phone-on-LAN (strongest), operator BLE devices in range, and Tailscale phone status
# into a single HOME / AWAY / UNCERTAIN verdict. AWAY is additionally guarded by local
# attendance counter-evidence (SIGNAL 4): all three positive signals anchor to the PHONE, so a
# phone dead at home blacks out every axis at once — dark sensors are not evidence of absence.
# SIGNAL 5 (gen-pair fusion 2026-07-08): a fresh mesh-cam-watch face-rec sighting of Ilya on a peer
# node (its ~/.mesh/.cam-face-state) is the same class of counter-evidence via a different modality
# (vision, not keypress/BLE) — see mesh-cam-watch's FACE-STATE section.
#
# Config (all node-local via ~/.mesh/nodes or env):
#   PHONE_LAN_IPS          — space-sep LAN IPs to ping (source: nodes)
#   PHONE_TS_IP            — Tailscale IP of the operator's phone (for fallback check)
#   MESH_OP_BLE_DEVICES    — colon-sep BLE device name substrings to check (default: Quest)
#                            Bose excluded: stationary desk speaker broadcasts BLE 24/7 in standby
#   MESH_OP_BLE_RSSI       — minimum RSSI (negative, default -82) = "nearby, not just in range"
#   MESH_OP_HOME_STALE_MIN — presence.log age threshold for BLE stale (default 5)
#   MESH_OP_ATT_STALE_MIN  — .attendance.cache age threshold before a live probe (default 10)
#   MESH_FUSE_PEER/MESH_FUSE_LABEL — cam-sighting peer (default: default-string, same peer as the
#                            existing BLE fuse) · MESH_OP_CAM_STALE_MIN — sighting freshness (default 10)
#
#   mesh-operator-home           verdict + reason
#   mesh-operator-home --json    machine-readable {"status":"HOME","reason":"..."}
#   mesh-operator-home --edge    REFLEX: post [op-home]/[op-away] on state change; wire to */5 cron
#   mesh-operator-home --test
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes" 2>/dev/null

OP_BLE_DEVICES="${MESH_OP_BLE_DEVICES:-Quest}"
OP_BLE_RSSI="${MESH_OP_BLE_RSSI:--82}"
OP_HOME_STALE_MIN="${MESH_OP_HOME_STALE_MIN:-5}"
PHONE_TS_IP="${PHONE_TS_IP:-}"  # set in ~/.mesh/nodes (node-local; no hardcoded default in genome)
PRESENCE_LOG="$HOME/.mesh/presence.log"
OP_STATE="$HOME/.mesh/.op-home.state"
AXES_TAPE="${MESH_OP_AXES_LOG:-$HOME/.mesh/op-home-axes.log}"
AX_REDUN_PCT="${MESH_OP_AXES_REDUN_PCT:-70}"   # measured pairwise redundancy at/above which a co-probed pair folds to one witness   # per-eval axis-vote tape (asocial discount)
AX_MIN_N="${MESH_OP_ASOCIAL_MIN_N:-24}"     # min records before ANY axis may be called stuck (~2h @ */5)
AX_WINDOW="${MESH_OP_ASOCIAL_WINDOW:-288}"  # tape records examined (~24h @ */5)
AX_KEEP="${MESH_OP_AXES_KEEP:-2000}"        # tape retention (~7d @ */5); this tool is its sole writer
PHONE_ID="$HOME/.mesh/.phone-id"        # learned STABLE home-WiFi MAC of the phone (IP-drift anchor)
NOW="$(date +%s)"

_verdict() {
  local lan=$1 ble=$2 ts=$3 att=${4:-0}
  if   [ "$lan" = 1 ]; then echo HOME
  elif [ "$ble" = 1 ]; then echo HOME
  elif [ "$ts"  = 1 ]; then echo UNCERTAIN
  elif [ "$att" = 1 ]; then echo UNCERTAIN   # phone dark on all axes BUT a person-corroborated
                                             # attendance read at the workstation — never a
                                             # determinate AWAY against live counter-evidence
  else echo AWAY; fi
}

# _calibration <lan> <ble> <ts> <att> <cam> [stuck] [collapse] → "<support> <agree>/<M> <lone_modality>" (pure, report-only).
# SOCIAL CONFIDENCE CALIBRATION — LIVE REVIEW 2026-07-28 (management cybernetics / agentic-AI systems
# theory, a concept the mesh did NOT embody). Source: Miehling et al., "Agentic AI Needs a Systems
# Theory", IBM Research, arXiv:2503.00237 §3.3 ("Prediction and interaction enables metacognition"):
# metacognition emerges when an agent "calibrate[s] its confidence estimates against estimates of the
# group … yielding SHARED REPRESENTATIONS — internal models that encode both individual AND group-level
# confidence signals", and error-detection = "the disagreement between the decision variable and the
# confidence variable" (Yeung 2004; Fleming & Daw 2017). Grounded in VSM: this is the missing calibration
# in a System-1 sensor federation — many estimators voting on ONE fact with no measure of who is out of
# consensus.
#
# THE GAP vs honest-fusion: the mesh's honest-fusion rule handles the SILENT input (unreachable → UNKNOWN,
# dark sensors ≠ evidence of absence). It says nothing about the LOUD-BUT-LONE input — a source
# confidently asserting HOME with no independent modality to corroborate it. That is exactly the failure
# the header's HAND-CODED Bose exclusion patched by hand ("stationary desk speaker broadcasts BLE 24/7 …
# excluded"): a BLE source that confidently voted HOME against the true consensus, caught only because a
# human noticed and hardcoded it out. This sidecar GENERALISES that fix — it MEASURES, per read, whether
# the HOME verdict is corroborated across INDEPENDENT modalities or rests on one possibly-miscalibrated
# source, so a future silent broadcaster surfaces as `support=lone` instead of needing another manual
# exclusion.
#
# Independence matters for corroboration (the header: "all three positive signals anchor to the PHONE").
# So consensus is counted across MODALITY GROUPS, not raw signals:
#   PHONE = lan OR ts   (network presence of the one phone — lan & ts are the same device)
#   BLE   = ble         (radio)   ·   ATT = att (attendance/keypress)   ·   CAM = cam (vision)
# home-positive modalities M_pos of the 4 groups:
#   >=2 → corroborated (independent modalities agree — a calibrated, high-group-confidence HOME)
#    1  → lone:<modality> (single source, the miscalibration-risk shape — no group to calibrate against)
#    0  → absent (no positive evidence; the honest-AWAY case, NOT a dissent — never flagged)
# Report-only: it NEVER changes status (a lone phone-on-LAN is still a legitimate HOME); it annotates the
# verdict with its group-support so a downstream reader/reflex knows a HOME rests on one modality.
#
# ASOCIAL-BIAS DISCOUNT (live review swarm-asocial-bias-zealot-corroboration-2026-08-18): counting
# agreeing modalities is NOT corroboration. Zakir, Carletti, Dorigo & Reina, "Bio-inspired decision
# making in robot swarms under biases" (arXiv:2509.07561v2, submitted 2025-09-09, rev 2026-06-14)
# unify THREE sources of asocial dynamics — a STUBBORN agent (zealot) that favours one option
# regardless of the world, a CORRUPTED channel, and genuine INDEPENDENT discovery — into a SINGLE
# term (probability eta per update, split into eta_a/eta_b). They are mathematically indistinguishable
# INSIDE the opinion dynamics: from agreement alone a swarm cannot tell a stuck source from a real
# second witness. That is exactly this sidecar's blind spot — the header above claims it
# "GENERALISES" the hand-coded Bose exclusion, but it does not: the Bose speaker (BLE beacon voting
# HOME 24/7 = a textbook zealot) plus a live phone read gives n=2 -> `corroborated`. Two votes, one
# witness.
#
# A zealot is not detectable from AGREEMENT; it is detectable from RESPONSIVENESS. An axis whose vote
# has been constant-positive across a window in which the FUSED VERDICT DID CHANGE is asocial by
# construction (eta ~ 1) and carries no evidence. `_asocial` measures that from the axis tape and
# `_calibration` DISCOUNTS such axes out of the support count.
#
# The status-varied guard is load-bearing and is the doctrine's own "value-frozen is honest calm"
# (CLAUDE.md, mesh-psi): if the operator simply never left, EVERY axis is constant and constancy is
# TRUE, not stuck. Constancy is only evidence of asociality against a world that moved.
#
# _in_csv <needle> <csv> → true if needle is a member of the comma-list.
_in_csv() { case ",${2:-}," in (*",$1,"*) return 0 ;; (*) return 1 ;; esac; }
#
# _asocial <tape> [min_n] [window] → "<stuck-csv|-> <n>/<min_n> <varied 0|1>"   (pure w.r.t. the tape)
#   stuck   = axes that voted 1 on EVERY one of the last <window> records, when n >= min_n AND the
#             fused status took >= 2 distinct values in that window. Never guesses: a thin window
#             (n < min_n) or a frozen world (varied=0) yields "-" — i.e. it degrades to the old
#             count, never to a fabricated accusation.
#   n/min_n = the COVERAGE of the judgement, published beside it so a reader can never mistake
#             "no stuck axis" for "checked and clean" when the tape is thin.
_asocial() {
  local tape="$1" min_n="${2:-24}" win="${3:-288}"
  [ -s "$tape" ] || { printf -- '- 0/%s 0\n' "$min_n"; return 0; }
  tail -n "$win" -- "$tape" 2>/dev/null | awk -v min_n="$min_n" '
    /^[0-9]+ / {
      n++
      for (i = 2; i <= NF; i++) {
        eq = index($i, "=");  if (eq == 0) continue
        k = substr($i, 1, eq-1); v = substr($i, eq+1)
        if (k == "status") { st[v] = 1; continue }
        if (!(k in seen)) { seen[k] = 1; pos[k] = 0 }
        if (v == "1") pos[k]++
      }
    }
    END {
      varied = 0; for (x in st) varied++
      varied = (varied >= 2) ? 1 : 0
      stuck = ""
      if (n >= min_n && varied) {
        split("phone ble att cam", ax, " ")           # deterministic order, never for-in
        for (j = 1; j <= 4; j++)
          if ((ax[j] in seen) && pos[ax[j]] == n)
            stuck = (stuck == "" ? ax[j] : stuck "," ax[j])
      }
      printf "%s %d/%d %d\n", (stuck == "" ? "-" : stuck), n, min_n, varied
    }'
}

#
# ── DECLARED vs MEASURED INDEPENDENCE (live review, predictive processing / Bayesian brain, 2026-08-20)
# LITERATURE: Vincent Bouttier, Renaud Jardri & Sophie Denève, "Circular Belief Propagation for
# Approximate Probabilistic Inference" (arXiv:2403.12106, cs.AI, 17 Mar 2024) — the algorithmic core of
# the same lab's circular-inference account of psychosis (Jardri & Denève, "Circular inferences in
# schizophrenia", Brain 136(11):3227, 2013). Verbatim, §2.2: "a message m_{i→j} is computed based on all
# messages m_{k→i} received by the sender node except the opposite message m_{j→i}, therefore preventing
# this message from being reverberated and thus counted twice." That MESSAGE EXCLUSION PRINCIPLE is what
# makes belief propagation exact — and it is exact ONLY on acyclic graphs: "in the presence of cycles,
# the same evidence travels multiple times through loops of the graph, and is mistaken for new evidence
# … correcting for these loops of length 2 is no longer sufficient." CBP's answer is not a bigger
# hand-drawn graph. It is two FITTED scalars in the update (their Eq. 4, BP = (α,κ,β,γ)=(1,1,1,1)):
# α_ij per edge "decorrelates opposite messages", κ_i per node "fights the belief amplifications caused
# by messages being reverberated" — an exponent on the whole product of incoming messages, i.e. a
# DAMPING of accumulated support learned from data rather than declared by the modeller.
#
# WHAT WE HAD, AND WHY IT IS THE α-ONLY HALF: `_calibration`'s modality partition (PHONE = lan OR ts,
# "lan & ts are the same device") is precisely an exclusion applied to ONE known length-2 loop, drawn by
# hand. `_asocial` then discounts an axis that is CONSTANT-positive across a moved world. Neither is κ.
# Both are declarations about the graph; nothing in this tool ever MEASURED whether two axes it calls
# independent actually behave independently — the sidecar's own founding complaint ("agreement cannot
# separate a zealot from a second witness") one level up, aimed at the partition instead of the votes.
# Note the live 2026 precision review (Lao-Rodríguez, Cacciato-Salcedo & Malmierca, Front. Psychol.
# 17:1887747, 2026) is entirely the GAIN story — it does not cite Jardri/Denève and does not address
# reverberation at all; the architectural half of precision is genuinely under-integrated, not just here.
#
# WHAT THIS ADDS: `_redundancy` measures pairwise redundancy R = I(a;b)/min(H(a),H(b)) straight off the
# axis tape and collapses a co-probed pair above threshold to ONE witness before `_calibration` counts.
# Two hard honesty rules, both learned from the live tape (n=1349, 2026-08-20) and both asserted below:
#
#   1. NEVER measure an axis against the FUSED VERDICT. status is a deterministic function of the very
#      votes on the line, so I(status;ble|phone)=0.124 bits on the live tape is a readout of the
#      decision tree, not of the world. Redundancy here is axis-vs-axis only; `status` is skipped.
#   2. A pair with NO co-positive record is `n/a`, never 0. att and cam are probed ONLY on the
#      would-be-AWAY path (phone and ble both dark), so phone~att can never be co-positive — and a naive
#      reading of the live tape scores phone~att R=0.58, the single highest number on it, which is the
#      CONDITIONAL PROBE GATE showing through, not shared evidence. A statistic over a conditionally
#      probed tape measures the gate. Rendering that 0.58 as redundancy would collapse the exact pair
#      SIGNAL 4 exists to keep separate.
#
# What it found on the live tape, which is the point of measuring rather than declaring: phone~ble
# (the only unconditionally co-probed pair, 817 co-positive records) measures R=0.012 — genuinely
# independent, so the sidecar's dominant `corroborated 2/4` is honest and is now honest by MEASUREMENT.
# And `cam` has voted 1 exactly ZERO times in 1349 records: its entropy is 0, its redundancy is
# undefined against everything, and it has been silently padding the `/4` denominator — a verdict
# advertising four modality groups while one of them has never once spoken. That is published as
# `mute:` rather than quietly folded, because a mute axis and an absent axis are different claims.
#
# _redundancy <tape> [min_n] [window] [thresh_pct] → "<collapse-csv|-> <mute-csv|-> <n>/<min_n> <detail>"
#   collapse = co-probed pairs "a~b" whose R >= thresh_pct (fold to one witness). Requires n >= min_n.
#   mute     = axes present on the tape that voted 1 on NO record in the window (zero-entropy padding).
#   n/min_n  = coverage of the judgement, published beside it so "no collapse" can never read as
#              "checked and clean" on a thin tape.
#   detail   = per-pair "a~b=<pct>" or "a~b=n/a" (never co-positive → the gate, unanswerable here).
_redundancy() {
  local tape="$1" min_n="${2:-24}" win="${3:-288}" thresh="${4:-70}"
  [ -s "$tape" ] || { printf -- '- - 0/%s -\n' "$min_n"; return 0; }
  tail -n "$win" -- "$tape" 2>/dev/null | awk -v min_n="$min_n" -v thresh="$thresh" '
    function log2(x) { return log(x) / log(2) }
    /^[0-9]+ / {
      n++
      for (i = 2; i <= NF; i++) {
        eq = index($i, "="); if (eq == 0) continue
        k = substr($i, 1, eq-1); v = substr($i, eq+1)
        if (k == "status") continue            # RULE 1: the verdict is a function of these votes.
        val[k, n] = v; seen[k] = 1
        if (v == "1") pos[k]++
      }
    }
    END {
      split("phone ble att cam", ax, " ")       # deterministic order, never for-in
      mute = ""; collapse = ""; detail = ""
      for (j = 1; j <= 4; j++) {
        a = ax[j]
        if (!(a in seen)) continue
        if (pos[a] + 0 == 0) mute = (mute == "" ? a : mute "," a)
      }
      if (n >= min_n) {
        for (j = 1; j <= 4; j++) for (m = j+1; m <= 4; m++) {
          a = ax[j]; b = ax[m]
          if (!(a in seen) || !(b in seen)) continue
          delete c; delete ma; delete mb
          t = 0; cop = 0
          for (r = 1; r <= n; r++) {
            va = val[a, r]; vb = val[b, r]
            if (va == "" || vb == "") continue
            c[va "" vb]++; ma[va]++; mb[vb]++; t++
            if (va == "1" && vb == "1") cop++
          }
          # RULE 2: no co-positive record → this tape cannot answer the pair (conditional probe gate).
          if (t == 0 || cop == 0) { detail = detail (detail == "" ? "" : ",") a "~" b "=n/a"; continue }
          Ha = 0; for (x in ma) { p = ma[x]/t; if (p > 0) Ha -= p * log2(p) }
          Hb = 0; for (x in mb) { p = mb[x]/t; if (p > 0) Hb -= p * log2(p) }
          hmin = (Ha < Hb ? Ha : Hb)
          if (hmin < 1e-9) { detail = detail (detail == "" ? "" : ",") a "~" b "=n/a"; continue }
          I = 0
          for (x in c) {
            p = c[x]/t; pa = ma[substr(x,1,1)]/t; pb = mb[substr(x,2,1)]/t
            if (p > 0 && pa > 0 && pb > 0) I += p * log2(p / (pa * pb))
          }
          R = I / hmin; if (R < 0) R = 0; if (R > 1) R = 1
          pct = int(R * 100 + 0.5)
          detail = detail (detail == "" ? "" : ",") a "~" b "=" pct
          if (pct >= thresh) collapse = (collapse == "" ? "" : collapse ",") a "~" b
        }
      }
      printf "%s %s %d/%d %s\n", (collapse == "" ? "-" : collapse), (mute == "" ? "-" : mute), \
             n, min_n, (detail == "" ? "-" : detail)
    }'
}

# _calibration <lan> <ble> <ts> <att> <cam> [stuck-csv] [collapse-csv]
#   collapse-csv: "a~b" pairs MEASURED redundant by `_redundancy` — the fitted-kappa half. When both
#   members of a pair survive the asocial filter as positive, they are ONE witness, so the later one is
#   folded out of the support count exactly as lan/ts are folded by the hand-drawn PHONE group. The
#   difference from that group is the whole point: this fold is measured off the tape, not declared here.
_calibration() {
  local lan=$1 ble=$2 ts=$3 att=${4:-0} cam=${5:-0} stuck=${6:--} collapse=${7:--}
  local phone=0; { [ "$lan" = 1 ] || [ "$ts" = 1 ]; } && phone=1
  local n=0 lone=- excl=0 exl=- counted="" fold=- pair a b
  _cal_axis() {   # <name> <vote> — count a positive axis, unless it is a discounted (asocial) one
    [ "$2" = 1 ] || return 0
    if _in_csv "$1" "$stuck"; then excl=$((excl+1)); [ "$exl" = - ] && exl="$1" || exl="$exl,$1"
    else n=$((n+1)); lone="$1"; counted="$counted,$1"; fi
  }
  _cal_axis phone "$phone"; _cal_axis ble "$ble"; _cal_axis att "$att"; _cal_axis cam "$cam"
  # Fold measured-redundant pairs: both counted → drop the second, one witness not two.
  if [ "$collapse" != - ] && [ -n "$collapse" ]; then
    local IFS=,
    for pair in $collapse; do
      a="${pair%%~*}"; b="${pair##*~}"
      [ -n "$a" ] && [ -n "$b" ] && [ "$a" != "$b" ] || continue
      if _in_csv "$a" "${counted#,}" && _in_csv "$b" "${counted#,}"; then
        n=$((n-1)); counted=",$(printf '%s' "${counted#,}" | tr ',' '\n' | grep -vx "$b" | paste -sd, -)"
        [ "$fold" = - ] && fold="$pair" || fold="$fold,$pair"
        lone="$(printf '%s' "${counted#,}" | cut -d, -f1)"; [ -n "$lone" ] || lone=-
      fi
    done
  fi
  local support
  if   [ "$n" -ge 2 ]; then support=corroborated; lone=-
  elif [ "$n" -eq 1 ]; then support=lone
  elif [ "$excl" -gt 0 ]; then support=asocial; lone=-   # positive evidence exists but EVERY source
                                                         # of it is non-responsive — the Bose shape,
                                                         # which used to read `corroborated`
  else support=absent; lone=-; fi
  printf '%s %s/4 %s %s %s\n' "$support" "$n" "$lone" "$exl" "$fold"
}

_live_macs() {  # from `ip neigh`-format lines on stdin, print lladdr MACs of ONLY live-state entries.
  # LIVE = REACHABLE (kernel-confirmed) / DELAY / PROBE (being confirmed right now). A STALE / FAILED /
  # INCOMPLETE entry lingers for a DEPARTED device (the 2026-07-06 stale-ARP false-HOME) → never counts.
  awk '/ REACHABLE| DELAY| PROBE/{for(i=1;i<=NF;i++) if($i=="lladdr") print $(i+1)}' | tr 'A-F' 'a-f'
}

_la_mac() {  # true if MAC's first octet has the locally-administered bit set (a randomized device).
  # Android randomizes its per-SSID MAC (LA bit set); routers/PCs use universal (burned-in) MACs.
  # We anchor "this host is the phone" to the LA bit so we never mis-learn the router/iMac.
  local o; o="$(printf '%s' "$1" | cut -d: -f1)"
  case "$o" in [0-9a-fA-F][0-9a-fA-F]) [ $(( 0x$o & 2 )) -ne 0 ] ;; *) return 1 ;; esac
}

# _cam_counts <who> <age_seconds> <stale_min> -> prints 1|0 (pure). SIGNAL 5 fold logic (gen-pair
# fusion, cam-watch × mesh-operator-home): a fresh cam-watch face-rec sighting of Ilya on a peer node
# counts as the SAME class of AWAY counter-evidence as SIGNAL 4 attendance — a vision-based "the
# operator is physically in a room on the mesh" fact independent of his phone. Malformed/missing age
# (peer unreachable, empty read) never counts — honest-fusion: blind input, not faked evidence.
_cam_counts() {
  local who="$1" age="$2" stale_min="$3"
  case "$age" in ''|*[!0-9]*) echo 0; return 0 ;; esac
  if [ "$who" = Ilya ] && [ "$age" -le $(( stale_min * 60 )) ]; then echo 1; else echo 0; fi
}

# _board_decision <status> <board_prev> <away_min> <min_dur> <transition> → board|trace|none (pure).
# The MIN_DURATION flood gate (chat-review/op-home-duration-threshold 2026-06-26): a SHORT absence is a
# real transition but board NOISE (was 4 posts/2h incl a 15min step-out; also a criticality-cascade
# source). Mirror the thermal STRESSED-flap pattern (CLAUDE.md: routine low-value churn lives in the
# TRACE by design). Length is unknown at away-time, so the [op-away] board post is DELAYED until AWAY
# has PERSISTED >= MIN_DURATION; a return before then = the whole away-period was short → both edges
# route to trace, the board never sees it. Returns where THIS edge goes:
#   board = significant (away crossed threshold / return from an announced absence)
#   trace = a transition not (yet) board-worthy (short flap)   ·   none = no change worth noting
_board_decision() {
  local status="$1" bprev="$2" amin="$3" mind="$4" trans="$5"
  if [ "$status" = AWAY ]; then
    if   [ "$bprev" != AWAY ] && [ "$amin" -ge "$mind" ]; then echo board   # absence became significant
    elif [ "$trans" = 1 ];                                then echo trace   # fresh sub-threshold AWAY
    else echo none; fi                                                      # steady (announced or sub-thr)
  else
    if   [ "$bprev" = AWAY ] && [ "$status" = HOME ]; then echo board  # return from announced absence (HOME=confirmed)
    elif [ "$bprev" = AWAY ];                                      then echo trace  # UNCERTAIN after AWAY: dwell-gate, not board
    elif [ "$trans" = 1 ];                                         then echo trace  # short-flap return / other edge
    else echo none; fi
  fi
}

[ "${1:-}" = --test ] && {
  # Real dep check across ALL THREE fusion axes.
  fail=0
  command -v ping     >/dev/null 2>&1 || { echo "  FAIL: ping missing — SIGNAL 1 (phone-on-LAN) dead"; fail=1; }
  command -v python3  >/dev/null 2>&1 || { echo "  FAIL: python3 missing — SIGNAL 3 (tailscale-status) pipe dies"; fail=1; }
  command -v tailscale>/dev/null 2>&1 || { echo "  FAIL: tailscale missing — SIGNAL 3 (phone TS status) has no source"; fail=1; }
  # Dry-run: exercise the VERDICT fusion against synthetic signal combinations.
  # The decision tree: LAN→HOME else BLE→HOME else TS→UNCERTAIN else attendance→UNCERTAIN else AWAY.
  # 5 branches, test every combination to catch a logic rot.
  # FALSIFIABLE: swap a threshold → an assertion FAILs.
  _f=0
  [ "$(_verdict 1 0 0)" = HOME      ] || { echo "  FAIL: LAN=1 → HOME"; _f=1; }
  [ "$(_verdict 1 1 0)" = HOME      ] || { echo "  FAIL: LAN=1 + BLE=1 → HOME"; _f=1; }
  [ "$(_verdict 1 0 1)" = HOME      ] || { echo "  FAIL: LAN=1 + TS=1 → HOME (LAN wins)"; _f=1; }
  [ "$(_verdict 0 1 0)" = HOME      ] || { echo "  FAIL: BLE=1 → HOME"; _f=1; }
  [ "$(_verdict 0 1 1)" = HOME      ] || { echo "  FAIL: BLE=1 + TS=1 → HOME (BLE wins)"; _f=1; }
  [ "$(_verdict 0 0 1)" = UNCERTAIN ] || { echo "  FAIL: only TS=1 → UNCERTAIN"; _f=1; }
  [ "$(_verdict 0 0 0)" = AWAY      ] || { echo "  FAIL: all=0 → AWAY"; _f=1; }
  # SIGNAL 4 attendance counter-evidence (2026-07-05 5h false-AWAY: phone dead at home = all
  # phone axes dark at once; attendance PHYSICAL/NEARBY must downgrade AWAY → UNCERTAIN, never HOME).
  [ "$(_verdict 0 0 0 1)" = UNCERTAIN ] || { echo "  FAIL: phone dark + attendance=1 → UNCERTAIN (not AWAY)"; _f=1; }
  [ "$(_verdict 0 0 0 0)" = AWAY      ] || { echo "  FAIL: phone dark + attendance=0 → AWAY"; _f=1; }
  [ "$(_verdict 1 0 0 1)" = HOME      ] || { echo "  FAIL: LAN=1 + attendance=1 → HOME (LAN wins)"; _f=1; }
  [ "$(_verdict 0 0 1 1)" = UNCERTAIN ] || { echo "  FAIL: TS=1 + attendance=1 → UNCERTAIN"; _f=1; }
  # Debounce: AWAY requires MESH_OP_AWAY_MISSES; HOME/BLE fire instantly (not tested here — needs mock run).
  # LA-MAC anchor: the phone's randomized MAC reads locally-administered; the router's universal does not.
  _la_mac ca:dc:f3:77:04:53 || { echo "  FAIL: LA-MAC: a randomized (phone) MAC must read locally-administered"; _f=1; }
  _la_mac 94:83:c4:68:07:66 && { echo "  FAIL: LA-MAC: a universal (router) MAC must NOT read as randomized"; _f=1; }
  # SIGNAL 5 cam-sighting fold (gen-pair fusion, cam-watch × mesh-operator-home 2026-07-08): a fresh
  # face-rec sighting of Ilya counts; a stranger/nobody, a stale sighting, or a malformed/unreachable
  # read never does (honest-fusion — a blind peer is not faked counter-evidence).
  [ "$(_cam_counts Ilya 60 10)" = 1 ]     || { echo "  FAIL: cam Ilya fresh(60s<=10m) must count"; _f=1; }
  [ "$(_cam_counts Ilya 700 10)" = 0 ]    || { echo "  FAIL: cam Ilya stale(700s>10m) must NOT count"; _f=1; }
  [ "$(_cam_counts Stranger 5 10)" = 0 ]  || { echo "  FAIL: cam Stranger must NOT count"; _f=1; }
  [ "$(_cam_counts Nobody 5 10)" = 0 ]    || { echo "  FAIL: cam Nobody must NOT count"; _f=1; }
  [ "$(_cam_counts Ilya '' 10)" = 0 ]     || { echo "  FAIL: cam malformed age (peer unreachable) must NOT count"; _f=1; }
  [ "$(_cam_counts Ilya abc 10)" = 0 ]    || { echo "  FAIL: cam non-numeric age must NOT count"; _f=1; }
  # STALE-ARP false-HOME regression (operator 2026-07-06, flagged live while on a walk): a departed
  # phone's MAC lingers STALE in `ip neigh` for minutes — it must NOT count as presence; only a
  # REACHABLE/DELAY/PROBE entry does. Predicted-HOME-but-actually-AWAY, banked so it can't recur.
  _nfix='192.168.8.50 dev wlan0 lladdr ca:dc:f3:77:04:53 STALE
192.168.8.60 dev wlan0 lladdr aa:bb:cc:dd:ee:ff REACHABLE
192.168.8.70 dev wlan0  FAILED'
  printf '%s\n' "$_nfix" | _live_macs | grep -qi 'ca:dc:f3:77:04:53' && { echo "  FAIL: STALE phone MAC counted as live (stale-ARP false-HOME regression)"; _f=1; }
  printf '%s\n' "$_nfix" | _live_macs | grep -qi 'aa:bb:cc:dd:ee:ff' || { echo "  FAIL: REACHABLE MAC not recognized as live"; _f=1; }
  # MIN_DURATION board-flood gate (chat-review/op-home-duration-threshold): the [op-away] board post
  # is DELAYED until AWAY persists >= MIN_DUR; a short away→home flap routes BOTH edges to trace.
  # FALSIFIABLE: drop the >= threshold or the board_prev guard → an assertion FAILs. (min_dur=20)
  [ "$(_board_decision AWAY ''     5  20 1)" = trace ] || { echo "  FAIL: fresh short AWAY (5m<20) → trace, not board"; _f=1; }
  [ "$(_board_decision AWAY ''     25 20 0)" = board ] || { echo "  FAIL: AWAY held 25m>=20 (no transition) → DELAYED board promote"; _f=1; }
  [ "$(_board_decision AWAY AWAY   30 20 0)" = none  ] || { echo "  FAIL: already-announced AWAY steady → none (no re-post)"; _f=1; }
  [ "$(_board_decision HOME AWAY   0  20 1)" = board ] || { echo "  FAIL: return from an announced absence → board"; _f=1; }
  [ "$(_board_decision HOME ''     0  20 1)" = trace ] || { echo "  FAIL: short-flap return (never announced) → trace, not board"; _f=1; }
  [ "$(_board_decision HOME HOME   0  20 0)" = none  ] || { echo "  FAIL: steady HOME → none"; _f=1; }
  # UNCERTAIN dwell-gate (chat-review/ophome-uncertain-dwell): UNCERTAIN after an announced AWAY must
  # NOT board instantly — route to trace (dwell-gate); only HOME after AWAY boards immediately.
  [ "$(_board_decision UNCERTAIN AWAY 0  20 1)" = trace ] || { echo "  FAIL: UNCERTAIN after AWAY → trace (dwell-gate, not board)"; _f=1; }
  [ "$(_board_decision HOME AWAY   0  20 1)" = board ] || { echo "  FAIL: HOME after AWAY → board (confirmed return)"; _f=1; }
  # SOCIAL CONFIDENCE CALIBRATION (arXiv:2503.00237 §3.3 — corroboration across INDEPENDENT modalities).
  # FALSIFIABLE: the lone-source flag is the whole point — a single confident HOME (the Bose/broadcaster
  # shape the header excludes by hand) must read `lone`, NOT `corroborated`.
  [ "$(_calibration 0 1 0 0 0)" = "lone 1/4 ble - -"     ] || { echo "  FAIL: BLE-only (Bose shape) → lone:ble, not corroborated"; _f=1; }
  [ "$(_calibration 1 0 0 0 0)" = "lone 1/4 phone - -"   ] || { echo "  FAIL: phone-LAN-only → lone:phone (legit HOME but single-modality)"; _f=1; }
  [ "$(_calibration 1 0 1 0 0)" = "lone 1/4 phone - -"   ] || { echo "  FAIL: LAN+TS both phone-anchored → still ONE modality (lone), not corroborated"; _f=1; }
  [ "$(_calibration 1 0 0 0 1)" = "corroborated 2/4 - - -" ] || { echo "  FAIL: phone + cam (2 independent modalities) → corroborated"; _f=1; }
  [ "$(_calibration 0 1 0 1 0)" = "corroborated 2/4 - - -" ] || { echo "  FAIL: BLE + attendance → corroborated"; _f=1; }
  [ "$(_calibration 0 0 0 0 0)" = "absent 0/4 - - -"     ] || { echo "  FAIL: no positive modality → absent (honest-AWAY, never a dissent flag)"; _f=1; }
  # ---- ASOCIAL-BIAS DISCOUNT (arXiv:2509.07561 — a zealot, a corrupted channel and an independent
  # discovery are ONE term; agreement cannot separate them, responsiveness can). Sandboxed: the tape
  # fixtures live in a temp dir, so the test NEVER writes the durable tape it exists to check.
  [ "$(_calibration 1 0 0 0 1 cam)" = "lone 1/4 phone cam -" ] || { echo "  FAIL: a stuck cam must be DISCOUNTED → lone:phone, not corroborated"; _f=1; }
  [ "$(_calibration 0 1 0 0 1 ble,cam)" = "asocial 0/4 - ble,cam -" ] || { echo "  FAIL: every positive modality stuck → support=asocial (the Bose shape), not corroborated"; _f=1; }
  [ "$(_calibration 1 0 0 0 1 att)" = "corroborated 2/4 - - -" ] || { echo "  FAIL: a stuck axis that did NOT vote must not be discounted away"; _f=1; }
  _axd="$(mktemp -d)"; _axt="$_axd/tape"
  # (a) THIN window — 5 records, ble constant-positive, world varied: must NOT accuse (coverage < min_n).
  : > "$_axt"; _i=0; while [ "$_i" -lt 5 ]; do
      _st=HOME; [ $(( _i % 2 )) = 1 ] && _st=AWAY
      printf '%s phone=%s ble=1 att=0 cam=0 status=%s\n' "$_i" "$(( _i % 2 ))" "$_st" >> "$_axt"; _i=$((_i+1)); done
  [ "$(_asocial "$_axt" 24 288)" = "- 5/24 1" ] || { echo "  FAIL: thin tape (5<24) must render '-' with its COVERAGE, never an accusation: $(_asocial "$_axt" 24 288)"; _f=1; }
  # (b) FROZEN WORLD — 30 records, ble constant-positive, status NEVER changes: constancy is HONEST.
  : > "$_axt"; _i=0; while [ "$_i" -lt 30 ]; do
      printf '%s phone=1 ble=1 att=0 cam=0 status=HOME\n' "$_i" >> "$_axt"; _i=$((_i+1)); done
  [ "$(_asocial "$_axt" 24 288)" = "- 30/24 0" ] || { echo "  FAIL: frozen world (varied=0) must NOT call a constant axis stuck: $(_asocial "$_axt" 24 288)"; _f=1; }
  # (c) THE ZEALOT — 30 records, world moved HOME/AWAY, ble voted 1 every single time, phone tracked it.
  : > "$_axt"; _i=0; while [ "$_i" -lt 30 ]; do
      _st=HOME; _p=1; [ $(( _i % 2 )) = 1 ] && { _st=AWAY; _p=0; }
      printf '%s phone=%s ble=1 att=0 cam=0 status=%s\n' "$_i" "$_p" "$_st" >> "$_axt"; _i=$((_i+1)); done
  [ "$(_asocial "$_axt" 24 288)" = "ble 30/24 1" ] || { echo "  FAIL: a constant-positive axis against a MOVING verdict must read stuck:ble: $(_asocial "$_axt" 24 288)"; _f=1; }
  # (d) end-to-end: that zealot + a live phone read must NOT be 'corroborated' any more.
  _z="$(_asocial "$_axt" 24 288 | cut -d' ' -f1)"
  [ "$(_calibration 1 1 0 0 0 "$_z")" = "lone 1/4 phone ble -" ] || { echo "  FAIL: zealot-BLE + live phone must degrade corroborated → lone:phone (discounted ble)"; _f=1; }
  # (e) an axis that genuinely varies is never stuck (guards against 'everything constant enough').
  : > "$_axt"; _i=0; while [ "$_i" -lt 30 ]; do
      _st=HOME; [ $(( _i % 2 )) = 1 ] && _st=AWAY
      printf '%s phone=%s ble=%s att=0 cam=0 status=%s\n' "$_i" "$(( _i % 2 ))" "$(( _i % 2 ))" "$_st" >> "$_axt"; _i=$((_i+1)); done
  [ "$(_asocial "$_axt" 24 288)" = "- 30/24 1" ] || { echo "  FAIL: a responsive axis must never be called stuck: $(_asocial "$_axt" 24 288)"; _f=1; }
  # (f) an ABSENT tape is coverage 0, never a verdict.
  [ "$(_asocial "$_axd/nope" 24 288)" = "- 0/24 0" ] || { echo "  FAIL: missing tape → '- 0/24 0' (no coverage), not silence"; _f=1; }

  # ---- MEASURED REDUNDANCY (arXiv:2403.12106 — BP's exclusion principle is exact only on acyclic
  # graphs; CBP's kappa DAMPS accumulated support instead of trusting a hand-drawn partition). Each
  # fixture is written into the SAME sandbox dir, so the test never touches the durable tape.
  # (g) TWO READS OF ONE WITNESS — phone and ble co-positive on every record, perfectly locked. This is
  # the shape the hand-drawn PHONE group folds for lan/ts and cannot see anywhere else. Must collapse.
  : > "$_axt"; _i=0; while [ "$_i" -lt 30 ]; do
      _v=$(( _i % 2 ))
      printf '%s phone=%s ble=%s att=0 cam=0 status=HOME\n' "$_i" "$_v" "$_v" >> "$_axt"; _i=$((_i+1)); done
  read -r _rc _rm _rn _rd <<EOF_G
$(_redundancy "$_axt" 24 288 70)
EOF_G
  [ "$_rc" = "phone~ble" ] || { echo "  FAIL: two perfectly locked co-positive axes must MEASURE redundant → collapse phone~ble (got '$_rc', detail=$_rd)"; _f=1; }
  case "$_rd" in *phone~ble=100*) : ;; *) echo "  FAIL: locked pair must report R=100, not '$_rd'"; _f=1 ;; esac
  # (h) end-to-end kappa: that measured pair must degrade corroborated → lone, WITHOUT any hand-declared
  # group and WITHOUT the asocial filter firing (both axes vary — `_asocial` is structurally blind here).
  [ "$(_asocial "$_axt" 24 288 | cut -d' ' -f1)" = "-" ] || { echo "  FAIL: fixture (g) must be invisible to the asocial filter — else (h) proves nothing new"; _f=1; }
  [ "$(_calibration 1 1 0 0 0 - "$_rc")" = "lone 1/4 phone - phone~ble" ] || { echo "  FAIL: a MEASURED-redundant pair must fold to one witness: $(_calibration 1 1 0 0 0 - "$_rc")"; _f=1; }
  # (i) INDEPENDENT axes must NOT collapse — the guard against 'fold everything that ever agrees'.
  # phone and ble co-positive 1 record in 4; R is small, the pair stands as two witnesses.
  : > "$_axt"; _i=0; while [ "$_i" -lt 40 ]; do
      printf '%s phone=%s ble=%s att=0 cam=0 status=HOME\n' "$_i" "$(( (_i/2) % 2 ))" "$(( _i % 2 ))" >> "$_axt"; _i=$((_i+1)); done
  read -r _rc _rm _rn _rd <<EOF_I
$(_redundancy "$_axt" 24 288 70)
EOF_I
  [ "$_rc" = "-" ] || { echo "  FAIL: independent co-probed axes must NOT collapse (got '$_rc', detail=$_rd)"; _f=1; }
  [ "$(_calibration 1 1 0 0 0 - "$_rc")" = "corroborated 2/4 - - -" ] || { echo "  FAIL: no measured redundancy → corroborated stands"; _f=1; }
  # (j) THE CONDITIONAL PROBE GATE — att is probed ONLY when phone is dark, so phone~att is never
  # co-positive. On the LIVE tape that pair scores the highest raw R on the file (0.58) purely from the
  # gate. It MUST render n/a, never a number, and must never collapse the pair SIGNAL 4 keeps separate.
  : > "$_axt"; _i=0; while [ "$_i" -lt 30 ]; do
      _p=$(( _i % 2 )); printf '%s phone=%s ble=0 att=%s cam=0 status=HOME\n' "$_i" "$_p" "$(( 1 - _p ))" >> "$_axt"; _i=$((_i+1)); done
  read -r _rc _rm _rn _rd <<EOF_J
$(_redundancy "$_axt" 24 288 70)
EOF_J
  [ "$_rc" = "-" ] || { echo "  FAIL: a never-co-positive pair must NEVER collapse (that is the probe gate, not evidence): got '$_rc'"; _f=1; }
  case "$_rd" in *phone~att=n/a*) : ;; *) echo "  FAIL: a never-co-positive pair must render n/a, never 0 and never a number: '$_rd'"; _f=1 ;; esac
  # (k) THE MUTE AXIS — cam voted 1 on zero of 1349 live records. Zero entropy: redundancy undefined,
  # and it silently pads the /4 denominator. Must be NAMED, and must not be confused with 'independent'.
  case "$_rm" in *cam*) : ;; *) echo "  FAIL: an axis with zero positive votes must be reported MUTE, got '$_rm'"; _f=1 ;; esac
  case "$_rd" in *ble~cam=n/a*) : ;; *) echo "  FAIL: a zero-entropy axis has UNDEFINED redundancy (n/a), never 0: '$_rd'"; _f=1 ;; esac
  # (l) coverage + absent tape: never a verdict without the records behind it.
  [ "$_rn" = "30/24" ] || { echo "  FAIL: redundancy must publish its coverage, got '$_rn'"; _f=1; }
  [ "$(_redundancy "$_axt" 999 288 70)" = "- ble,cam 30/999 -" ] || { echo "  FAIL: below min_n → NO pair verdict at all, mute+coverage only: $(_redundancy "$_axt" 999 288 70)"; _f=1; }
  [ "$(_redundancy "$_axd/nope" 24 288 70)" = "- - 0/24 -" ] || { echo "  FAIL: missing tape → coverage 0, no verdict"; _f=1; }
  # (m) CONSTANT-POSITIVE axis: co-positive records EXIST (so the (j) gate does not catch it) but its
  # entropy is 0, so R = I/min(H) is 0/0 — UNDEFINED, and rendering that as 0 would advertise a zealot
  # as a measured-independent second witness. n/a is the only honest cell. (`_asocial` catches the
  # zealot from responsiveness; this asserts the redundancy lane does not silently contradict it.)
  : > "$_axt"; _i=0; while [ "$_i" -lt 30 ]; do
      printf '%s phone=%s ble=1 att=0 cam=0 status=HOME\n' "$_i" "$(( _i % 2 ))" >> "$_axt"; _i=$((_i+1)); done
  read -r _rc _rm _rn _rd <<EOF_M
$(_redundancy "$_axt" 24 288 70)
EOF_M
  case "$_rd" in *phone~ble=n/a*) : ;; *) echo "  FAIL: a zero-entropy (constant-positive) axis has UNDEFINED redundancy, never 0: '$_rd'"; _f=1 ;; esac
  [ "$_rc" = "-" ] || { echo "  FAIL: an undefined-R pair must never be folded: '$_rc'"; _f=1; }
  rm -rf "$_axd"
  [ "$_f" != 0 ] && { echo "smoke-test: FAIL (verdict/board-gate/calibration decision logic drifted)"; exit 1; }
  [ "$fail" != 0 ] && { echo "smoke-test: FAIL (fusion-axis dep missing — see above)"; exit 1; }
  echo "smoke-test: ok (verdict logic: 11 combinations × 4 fusion axes + 8 board-gate cases + 6 cam-sighting fold cases + 9 calibration cases + 6 asocial-discount tape cases + 7 measured-redundancy tape cases + deps)"; exit 0
}

EDGE=0; [ "${1:-}" = --edge ] && EDGE=1
MODE=text; [ "${1:-}" = --json ] && MODE=json

# ---- SIGNAL 1: phone on home WiFi (phone-centric; IP-drift + MAC-randomization robust) ----
# The operator's position IS the phone's position — he is HOME iff his phone is on the home WiFi
# (operator 2026-06-19: "моё положение нужно мерить по телефону"). Pinging a STATIC configured IP
# is fragile — the DHCP lease drifts and MIUI flaps the phone off WiFi (sshd dies), so a stale IP
# reads false-AWAY. Robust path: learn the phone's STABLE home-SSID MAC (Android randomizes per-SSID
# but keeps it stable), then detect that MAC on the LAN even after the IP drifts.
phone_lan_ok=0; phone_reason=""
phone_mac="$(cat "$PHONE_ID" 2>/dev/null | grep -oiE '([0-9a-f]{2}:){5}[0-9a-f]{2}' | head -1 | tr 'A-F' 'a-f')"

# 1a-pre: live discovery each eval (task op-home-stale-phone-ip 2026-07-06) — mesh-phone-ip
# (TS→LAN probe→ADB→last-good cache) supplies a candidate even where PHONE_LAN_IPS is unset
# (ds ran with NO config → SIGNAL 1 iterated over nothing → structural false-AWAY) or stale
# (DHCP .146→.203 drift). A cached/registry guess is safe to ADD here: a candidate only counts
# after the ping + LA-MAC gate below — discovery widens the list, verification decides.
# LAN-semantics guard: SIGNAL 1 means "phone on home WiFi", so accept only RFC1918 addresses —
# a Tailscale/CGNAT IP (100.64/10) can answer over LTE with the operator far from home.
if command -v mesh-phone-ip >/dev/null 2>&1; then
  dip="$(timeout 20 mesh-phone-ip 2>/dev/null | grep -oE '^[0-9.]+$' | head -1)"
  case "$dip" in
    192.168.*|10.*|172.1[6-9].*|172.2[0-9].*|172.3[01].*)
      case " ${PHONE_LAN_IPS:-} " in
        *" $dip "*) ;;
        *) PHONE_LAN_IPS="${PHONE_LAN_IPS:-} $dip" ;;
      esac ;;
  esac
fi

# 1a: ping the configured phone IPs; on a hit, (re)learn the phone's MAC from ARP if it is a
# randomized (LA) MAC — self-calibrating + drift-correcting, and it won't latch onto the router/iMac
# if DHCP ever hands a configured IP to a non-phone (their MACs are universal, so they're rejected).
for lip in ${PHONE_LAN_IPS:-}; do
  # A phone in WiFi power-save/doze ignores the FIRST ping (radio asleep) → a single -c1 probe reads
  # false-AWAY though the phone is home on WiFi (operator 2026-06-19 "детектируете дома я или нет
  # неправильно"; proven: -c1 missed it, -c3 caught it at 205ms = radio waking). Send a few quick
  # packets — ping returns 0 if ANY is answered, so the 2nd/3rd wakes-and-catches a dozing phone.
  if ping -c 3 -W 1 "$lip" >/dev/null 2>&1; then
    m="$(ip neigh show "$lip" 2>/dev/null | grep -oiE '([0-9a-f]{2}:){5}[0-9a-f]{2}' | head -1 | tr 'A-F' 'a-f')"
    if [ -n "$m" ] && _la_mac "$m"; then
      phone_mac="$m"; printf '%s' "$m" > "$PHONE_ID" 2>/dev/null
      phone_lan_ok=1; phone_reason="phone on home WiFi ($lip)"; break
    elif [ -z "$m" ]; then
      phone_lan_ok=1; phone_reason="phone on home WiFi ($lip)"; break   # ping ok, ARP not resolved
    fi
    # a non-LA MAC answered this IP → that's a PC, not the phone — keep looking.
  fi
done

# 1a-v6: IPv6 link-local ND probe (chat-review/op-home-ipv6-nd-probe 2026-07-06). The phone's
# stable home-SSID MAC (EUI-64) yields a deterministic link-local — fe80::c8dc:f3ff:fe77:453%<if>.
# Android answers ND while often ignoring IPv4 ping (proven live on ds). Derive the LL from the
# learned MAC and probe it; on hit, verify via _live_macs (same STALE-filter as 1b). Throttled
# to one probe per sweep cycle so it never hammers the interface.
if [ "$phone_lan_ok" = 0 ] && [ -n "$phone_mac" ]; then
  # EUI-64: split MAC into halves, insert ff:fe, flip the universal/local bit.
  m="${phone_mac//:/}"; m1="${m:0:6}"; m2="${m:6}"
  # flip the 7th bit of the first byte (universal/local bit for EUI-64)
  b1=$(( 0x${m1:0:2} ^ 0x02 )); printf -v m1f '%02x%s' "$b1" "${m1:2}"
  iid="${m1f:0:4}:${m1f:4:2}ff:fe${m2:0:2}:${m2:2}"
  ll="fe80::${iid}"
  # detect the outbound interface (for the %scope id) from the default route
  ll_if="$(ip -6 route show default 2>/dev/null | awk '{print $5}' | head -1)"
  [ -n "$ll_if" ] || ll_if="wlan0"
  if ping6 -c 3 -W 1 -I "$ll_if" "$ll" >/dev/null 2>&1; then
    neigh_macs="$(ip neigh 2>/dev/null | _live_macs)"
    case " $(printf '%s ' $neigh_macs)" in
      *" $phone_mac "*) phone_lan_ok=1; phone_reason="phone on home WiFi (IPv6 LL probe $ll)";;
    esac
  fi
fi

# 1b: IP-drift recovery — no configured IP was the phone, but we know its stable MAC. Sweep the
# home /24 to populate the ARP cache (root-free: the kernel learns MACs from ping replies), then
# check whether the phone's MAC is present = it rejoined home WiFi on a NEW IP. Throttled so it is
# only a fallback and never hammers the LAN more than once per MESH_OP_SWEEP_MIN minutes.
if [ "$phone_lan_ok" = 0 ] && [ -n "$phone_mac" ]; then
  SWEEP_TS="$HOME/.mesh/.op-home-sweep.ts"
  # Sanitize the throttle stamp: a corrupted file (seen live 2026-07-06: two concatenated
  # no-newline writes → 20-digit value) makes NOW-last hugely negative → the sweep NEVER fires
  # again → ARP never populated → permanent false-AWAY/UNCERTAIN on a node whose 1a IPs miss.
  # Any non-numeric / future / overlong stamp resets to 0 (= sweep now); newline-terminated write.
  last="$(head -c 32 "$SWEEP_TS" 2>/dev/null | grep -oE '^[0-9]{1,10}' || echo 0)"
  { [ -n "$last" ] && [ "$last" -le "$NOW" ]; } 2>/dev/null || last=0
  if [ $(( NOW - last )) -ge $(( ${MESH_OP_SWEEP_MIN:-4} * 60 )) ]; then
    printf '%s\n' "$NOW" > "$SWEEP_TS" 2>/dev/null
    myip="$(ip -4 route get 1.1.1.1 2>/dev/null | grep -oE 'src [0-9.]+' | awk '{print $2}')"
    case "$myip" in
      192.168.*|10.*|172.1[6-9].*|172.2[0-9].*|172.3[01].*)
        prefix="${myip%.*}"
        # -c3 not -c1: same doze rationale as 1a — a phone in WiFi power-save ignores the first
        # packet, so a -c1 sweep never wakes it and the MAC never lands in ARP (proven 2026-06-19).
        seq 1 254 | xargs -P 64 -I{} ping -c3 -W1 "$prefix.{}" >/dev/null 2>&1 || true ;;
    esac
  fi
  # capture the ARP cache into a var (NOT 'grep -q' in a pipe — pipefail+SIGPIPE would false-miss),
  # then membership-test the learned MAC — but ONLY entries in a LIVE neighbor state.
  # THE STALE-ARP FALSE-HOME (2026-07-06, operator flagged live): `ip neigh` lists a departed
  # device's MAC in STALE state for minutes after it leaves (kernel demotes REACHABLE→STALE, and
  # only a later failed probe turns it FAILED/INCOMPLETE). The operator walked out WITH his phone,
  # its ARP entry lingered STALE, and this membership test — matching ANY state — flapped op-home to
  # HOME, so a day-summary told him he was home while on a walk. A STALE/FAILED/INCOMPLETE entry is
  # NOT proof of presence; only REACHABLE (kernel-confirmed live) / DELAY / PROBE (being confirmed
  # right now, post-sweep-ping) count as "the phone is here". Departed phone -> no live entry -> AWAY.
  neigh_macs="$(ip neigh 2>/dev/null | _live_macs)"
  case " $(printf '%s ' $neigh_macs)" in
    *" $phone_mac "*) phone_lan_ok=1; phone_reason="phone MAC live on home WiFi (IP drifted from config)";;
  esac
fi

# ---- SIGNAL 2: operator BLE device at strong RSSI (from cached log) ----
ble_home=0; ble_device=""; ble_rssi=0
if [ -s "$PRESENCE_LOG" ]; then
  log_age=$(( (NOW - $(date +%s -r "$PRESENCE_LOG" 2>/dev/null || echo $NOW)) / 60 ))
  if [ "$log_age" -le "$OP_HOME_STALE_MIN" ]; then
    IFS=':' read -ra DEVS <<< "$OP_BLE_DEVICES"
    while IFS= read -r scan_line; do
      for dev_name in "${DEVS[@]}"; do
        # extract RSSI for this device name: format -RSSI|MAC|NAME
        rssi="$(printf '%s' "$scan_line" | grep -oE '\-[0-9]+\|[^|]+\|[^| ]*'"$dev_name" | grep -oE '^\-[0-9]+' | head -1)"
        if [ -n "$rssi" ] && [ "$rssi" -ge "$OP_BLE_RSSI" ]; then
          ble_home=1; ble_device="$dev_name"; ble_rssi="$rssi"; break 2
        fi
      done
    done < <(tail -12 "$PRESENCE_LOG")
  fi
fi

# ---- SIGNAL 3: Tailscale phone status (skipped if PHONE_TS_IP unset) ----
ts_phone_online=0
if [ -n "$PHONE_TS_IP" ]; then
  tailscale status --json 2>/dev/null | python3 -c "
import json,sys
d=json.load(sys.stdin)
for p in (d.get('Peer') or {}).values():
    ips = p.get('TailscaleIPs') or []
    if '$PHONE_TS_IP' in ips and p.get('Online'):
        print('online')
        break
" 2>/dev/null | grep -q online && ts_phone_online=1
fi

# ---- SIGNAL 4: local attendance counter-evidence (the workstation, not the phone) ----
# All three signals above anchor to the PHONE (LAN MAC / named BLE / Tailscale). A phone that dies
# AT home (battery dead; MIUI kills sshd — the Redmi goes dark for days) blacks out every axis at
# once, and the tree asserted a determinate AWAY for as long as the phone was down (proven
# 2026-07-05: 5h of AWAY while mesh-attendance read NEARBY at this desk). Dark sensors are not
# evidence of absence — before asserting AWAY, consult the attendance fusion (person-specific,
# appliance-proof: keypress IRQ + personal-classified BLE). PHYSICAL/NEARBY downgrades the would-be
# AWAY to an honest UNCERTAIN — never to HOME (a body at the desk is not identity; a personal BLE
# device can be one left home). REMOTE/UNATTENDED/UNKNOWN/blind = no counter-evidence → AWAY stands.
# Only probed on the would-be-AWAY path, so the 3 positive branches pay zero extra cost.
att_present=0; att_verdict=""
if [ "$phone_lan_ok" = 0 ] && [ "$ble_home" = 0 ] && [ "$ts_phone_online" = 0 ]; then
  ATT_CACHE="$HOME/.mesh/.attendance.cache"
  att_age=$(( NOW - $(date +%s -r "$ATT_CACHE" 2>/dev/null || echo 0) ))
  if [ -s "$ATT_CACHE" ] && [ "$att_age" -le $(( ${MESH_OP_ATT_STALE_MIN:-10} * 60 )) ]; then
    att_verdict="$(head -1 "$ATT_CACHE" | awk '{print $2}')"
  elif command -v mesh-attendance >/dev/null 2>&1; then
    att_verdict="$(timeout 20 mesh-attendance 2>/dev/null | head -1 | awk '{print $2}')"
  fi
  case "$att_verdict" in PHYSICAL|NEARBY) att_present=1 ;; esac
fi

# ---- SIGNAL 5: cam-watch face-rec sighting (vision counter-evidence, gen-pair fusion 2026-07-08) ----
# mesh-cam-watch's person_present() already recognizes Ilya/Rozalia/Stranger/Nobody on every motion
# event and stamps it to ~/.mesh/.cam-face-state (a `-state` artifact — fleet-visible, see mesh-cam-
# watch). A phone dark on every axis (SIGNAL 1-3) does NOT mean the operator left if a camera on
# another mesh node just recognized him in frame — same doctrine as SIGNAL 4, a different modality
# (vision, not keypress/BLE). Only probed on the would-be-AWAY path (zero extra cost otherwise), and
# only Ilya (not Rozalia/Stranger/Nobody) counts, and only if the sighting is fresh — a stale/covered/
# unreachable camera degrades to no-evidence, never a faked HOME.
# MESH_OP_CAM_PROBE overrides the peer read for --test (must print "<who>|<age_seconds>" or nothing).
cam_present=0; cam_who=""; cam_age=""
if [ "$phone_lan_ok" = 0 ] && [ "$ble_home" = 0 ] && [ "$ts_phone_online" = 0 ]; then
  _cam_out=""
  if [ -n "${MESH_OP_CAM_PROBE:-}" ]; then
    _cam_out="$("$MESH_OP_CAM_PROBE" 2>/dev/null)"
  elif command -v mesh-peer-addr >/dev/null 2>&1; then
    _cam_peer="${MESH_FUSE_PEER:-}"
    if [ -z "$_cam_peer" ]; then
      _cam_ip="$(mesh-peer-addr "${MESH_FUSE_LABEL:-default-string}" 2>/dev/null || true)"
      [ -n "$_cam_ip" ] && _cam_peer="${MESH_PEER_USER:-$(whoami)}@$_cam_ip"
    fi
    [ -n "$_cam_peer" ] && _cam_out="$(timeout 6 ssh -o ConnectTimeout=4 -o BatchMode=yes \
      -o StrictHostKeyChecking=accept-new "$_cam_peer" \
      'f="$HOME/.mesh/.cam-face-state"; [ -s "$f" ] || exit 1; w=$(cat "$f"); a=$(( $(date +%s) - $(stat -c %Y "$f" 2>/dev/null || echo 0) )); printf "%s|%s" "$w" "$a"' \
      2>/dev/null)"
  fi
  if [ -n "$_cam_out" ]; then
    cam_who="${_cam_out%%|*}"; cam_age="${_cam_out#*|}"
    [ "$(_cam_counts "$cam_who" "$cam_age" "${MESH_OP_CAM_STALE_MIN:-10}")" = 1 ] && cam_present=1
  fi
fi

# ---- VERDICT ----
status=UNCERTAIN; reason=""
if [ "$phone_lan_ok" = 1 ]; then
  status=HOME; reason="${phone_reason:-phone on home WiFi}"
elif [ "$ble_home" = 1 ]; then
  status=HOME; reason="operator BLE device '$ble_device' at ${ble_rssi} dBm"
elif [ "$ts_phone_online" = 1 ]; then
  # TS online but not on LAN → likely away-mobile (Tailscale works remotely)
  status=UNCERTAIN; reason="phone Tailscale online but not on LAN (mobile?)"
elif [ "$att_present" = 1 ]; then
  status=UNCERTAIN; reason="phone dark on all axes, but attendance reads $att_verdict at the workstation"
elif [ "$cam_present" = 1 ]; then
  status=UNCERTAIN; reason="phone dark on all axes, but camera face-rec sighted Ilya on ${MESH_FUSE_LABEL:-default-string} ${cam_age}s ago"
elif [ "$phone_lan_ok" = 0 ] && [ "$ts_phone_online" = 0 ]; then
  status=AWAY; reason="phone not on LAN, not on Tailscale"
fi

# SOCIAL CONFIDENCE CALIBRATION sidecar (report-only, verdict-preserving; see _calibration): annotate
# the verdict with how many INDEPENDENT modalities corroborate it, so a HOME resting on one
# possibly-miscalibrated source (the Bose/broadcaster shape) surfaces as support=lone.
# The tape is appended on EVERY eval, unconditionally — never gated on a change. A tape written only
# when the value moves has zero entropy in the very axis it exists to measure (CLAUDE.md: the
# room-sense confidence=high 253/253 shape), and constancy is precisely the signal here.
_cal_phone=0; { [ "$phone_lan_ok" = 1 ] || [ "$ts_phone_online" = 1 ]; } && _cal_phone=1
printf '%s phone=%s ble=%s att=%s cam=%s status=%s\n' \
  "$NOW" "$_cal_phone" "$ble_home" "$att_present" "$cam_present" "$status" >> "$AXES_TAPE" 2>/dev/null || true
# Retention: this tool is the tape's ONLY writer, so it owns the trim (CLAUDE.md retention rule).
_ax_lines=$(wc -l < "$AXES_TAPE" 2>/dev/null || echo 0)
case "$_ax_lines" in (*[!0-9]*|'') _ax_lines=0 ;; esac
if [ "$_ax_lines" -gt $(( AX_KEEP * 2 )) ]; then
  tail -n "$AX_KEEP" -- "$AXES_TAPE" > "$AXES_TAPE.tmp" 2>/dev/null && mv -f "$AXES_TAPE.tmp" "$AXES_TAPE" 2>/dev/null || rm -f "$AXES_TAPE.tmp" 2>/dev/null
fi

read -r ax_stuck ax_cov ax_varied <<EOF_AX
$(_asocial "$AXES_TAPE" "$AX_MIN_N" "$AX_WINDOW")
EOF_AX

read -r red_collapse red_mute red_cov red_detail <<EOF_RED
$(_redundancy "$AXES_TAPE" "$AX_MIN_N" "$AX_WINDOW" "$AX_REDUN_PCT")
EOF_RED

read -r cal_support cal_agree cal_lone cal_stuck cal_fold <<EOF_CAL
$(_calibration "$phone_lan_ok" "$ble_home" "$ts_phone_online" "$att_present" "$cam_present" "$ax_stuck" "$red_collapse")
EOF_CAL

if [ "$MODE" = json ]; then
  printf '{"status":"%s","reason":"%s","phone_lan":%s,"ble_home":%s,"ts_online":%s,"cam_sighting":%s,"support":"%s","modalities":"%s","lone":"%s","discounted":"%s","asocial_coverage":"%s","world_varied":%s,"redundant_folded":"%s","redundancy":"%s","mute_axes":"%s","redundancy_coverage":"%s"}\n' \
    "$status" "$reason" "$phone_lan_ok" "$ble_home" "$ts_phone_online" "$cam_present" "$cal_support" "$cal_agree" "$cal_lone" "$cal_stuck" "$ax_cov" "$ax_varied" "$cal_fold" "$red_detail" "$red_mute" "$red_cov"
  exit 0
fi

if [ "$EDGE" = 1 ]; then
  prev="$(cat "$OP_STATE" 2>/dev/null || echo)"
  MISSF="$HOME/.mesh/.op-home-awaymiss"
  # DEBOUNCE the AWAY transition: the phone flaps off WiFi (MIUI/power-save — see phone-sshd-dies-miui-
  # killing) so a single missed ping would falsely fire [op-away]. Require N consecutive AWAY reads before
  # declaring it. HOME/UNCERTAIN still fire instantly (want a fast "operator's back"). (2026-06-15 false fire.)
  if [ "$status" = AWAY ]; then
    misses=$(( $(cat "$MISSF" 2>/dev/null || echo 0) + 1 ))
    printf '%s' "$misses" > "$MISSF"
    if [ "$misses" -lt "${MESH_OP_AWAY_MISSES:-2}" ]; then
      [ -n "$prev" ] && printf '%s' "$prev" > "$OP_STATE"   # not yet confirmed away — hold prev, stay silent
      exit 0
    fi
  else
    rm -f "$MISSF" 2>/dev/null                              # any non-AWAY read clears the debounce counter
  fi
  printf '%s' "$status" > "$OP_STATE"                        # confirmed verdict (debounce 'was' + change ref)

  # ---- MIN_DURATION board-flood gate (chat-review/op-home-duration-threshold 2026-06-26) ----
  # Route via _board_decision (above): board for a SIGNIFICANT absence/return, trace for a short flap,
  # silence for steady state. The [op-away] board post is DELAYED — AWAY must persist >= MIN_DURATION —
  # so a quick step-out-and-back leaves the board untouched (both edges fall to trace).
  MIN_DUR_MIN="${MESH_OP_MIN_DURATION_MIN:-20}"
  BOARD_STATE_F="$HOME/.mesh/.op-home.board-state"          # last status actually POSTED to the board
  AWAY_SINCE_F="$HOME/.mesh/.op-home.away-since"            # epoch the current AWAY period was confirmed
  board_prev="$(cat "$BOARD_STATE_F" 2>/dev/null || echo)"
  transition=0; [ "$status" != "${prev:-}" ] && transition=1

  away_min=0
  if [ "$status" = AWAY ]; then
    [ -s "$AWAY_SINCE_F" ] || printf '%s' "$NOW" > "$AWAY_SINCE_F"   # stamp away-start once per period
    away_since="$(cat "$AWAY_SINCE_F" 2>/dev/null || echo "$NOW")"
    case "$away_since" in (*[!0-9]*|'') away_since="$NOW";; esac
    away_min=$(( (NOW - away_since) / 60 ))
  else
    rm -f "$AWAY_SINCE_F" 2>/dev/null                       # operator back / ambiguous — reset the period
  fi

  decision="$(_board_decision "$status" "${board_prev:-}" "$away_min" "$MIN_DUR_MIN" "$transition")"
  tag="$(printf '%s' "$status" | tr 'A-Z' 'a-z')"
  case "$decision" in
    board)
      printf '%s' "$status" > "$BOARD_STATE_F"
      msg="[op-${tag}] operator ${status}: ${reason} (was ${board_prev:-new})"
      command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="op-home@$(hostname)" mesh-chat "$msg" 2>/dev/null || true
      printf '%s\n' "$status" ;;
    trace)
      command -v mesh-trace >/dev/null 2>&1 && MESH_WHO="op-home@$(hostname)" \
        mesh-trace "op-home: ${status} (${reason}) — short/sub-threshold, trace-only (board gate: significant absence >= ${MIN_DUR_MIN}m)" >/dev/null 2>&1 || true
      printf '%s\n' "$status" ;;
    *) : ;;   # none — steady state, stay silent
  esac
  exit 0
fi

printf '%s — %s\n' "$status" "$reason"
# One report-only line: the verdict's group-support. `lone` on a HOME = single-modality (Bose-risk shape).
case "$cal_support" in
  corroborated) printf '  calibration: corroborated (%s responsive independent modalities agree)\n' "$cal_agree" ;;
  lone)         printf '  calibration: LONE source (%s) — verdict rests on one modality, no group to calibrate against\n' "$cal_lone" ;;
  asocial)      printf '  calibration: ASOCIAL support (%s) — every positive modality is non-responsive (constant vote across a window in which the verdict DID change); agreement here is one witness counted twice\n' "$cal_stuck" ;;
  absent)       : ;;  # no positive evidence — the honest-AWAY case, nothing to flag
esac
[ "$cal_stuck" != - ] && [ "$cal_support" != asocial ] && \
  printf '  calibration: discounted %s as asocial (constant-positive over %s records)\n' "$cal_stuck" "$ax_cov"
# Publish the COVERAGE of the asocial judgement, never let "no stuck axis" pass as "checked".
[ "$ax_varied" = 0 ] && printf '  calibration: asocial check n/a — verdict never changed in the window (%s); constancy is honest here\n' "$ax_cov"
# MEASURED redundancy (arXiv:2403.12106 kappa) — a fold is one witness recovered from two votes.
[ "$cal_fold" != - ] && \
  printf '  calibration: folded %s — measured redundant (R>=%s%%) on the axis tape, counted ONCE not twice\n' "$cal_fold" "$AX_REDUN_PCT"
[ "$red_detail" != - ] && \
  printf '  calibration: pairwise redundancy %s over %s records (n/a = never co-positive: att/cam are probed only when the phone axes are dark, so that pair measures the GATE, not shared evidence)\n' "$red_detail" "$red_cov"
# A mute axis is not an absent one: it pads the /4 denominator with a modality that never spoke.
[ "$red_mute" != - ] && \
  printf '  calibration: MUTE axis %s — zero positive votes in %s records; it is padding the /4 denominator, not corroborating anything\n' "$red_mute" "$red_cov"
exit 0
