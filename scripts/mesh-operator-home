#!/usr/bin/env bash
# reflex-cadence: 1-59/5 * * * *
# reflex-args: --edge
# mesh-operator-home — "is the operator physically home?" oracle.
# Combines phone-on-LAN (strongest), operator BLE devices in range, and Tailscale phone status
# into a single HOME / AWAY / UNCERTAIN verdict. AWAY is additionally guarded by local
# attendance counter-evidence (SIGNAL 4): all three positive signals anchor to the PHONE, so a
# phone dead at home blacks out every axis at once — dark sensors are not evidence of absence.
# SIGNAL 5 (gen-pair fusion 2026-07-08): a fresh mesh-cam-watch face-rec sighting of Ilya on a peer
# node (its ~/.mesh/.cam-face-state) is the same class of counter-evidence via a different modality
# (vision, not keypress/BLE) — see mesh-cam-watch's FACE-STATE section.
#
# Config (all node-local via ~/.mesh/nodes or env):
#   PHONE_LAN_IPS          — space-sep LAN IPs to ping (source: nodes)
#   PHONE_TS_IP            — Tailscale IP of the operator's phone (for fallback check)
#   MESH_OP_BLE_DEVICES    — colon-sep BLE device name substrings to check (default: Quest)
#                            Bose excluded: stationary desk speaker broadcasts BLE 24/7 in standby
#   MESH_OP_BLE_RSSI       — minimum RSSI (negative, default -82) = "nearby, not just in range"
#   MESH_OP_HOME_STALE_MIN — presence.log age threshold for BLE stale (default 5)
#   MESH_OP_ATT_STALE_MIN  — .attendance.cache age threshold before a live probe (default 10)
#   MESH_FUSE_PEER/MESH_FUSE_LABEL — cam-sighting peer (default: default-string, same peer as the
#                            existing BLE fuse) · MESH_OP_CAM_STALE_MIN — sighting freshness (default 10)
#
#   mesh-operator-home           verdict + reason
#   mesh-operator-home --json    machine-readable {"status":"HOME","reason":"..."}
#   mesh-operator-home --edge    REFLEX: post [op-home]/[op-away] on state change; wire to */5 cron
#   mesh-operator-home --test
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes" 2>/dev/null

OP_BLE_DEVICES="${MESH_OP_BLE_DEVICES:-Quest}"
OP_BLE_RSSI="${MESH_OP_BLE_RSSI:--82}"
OP_HOME_STALE_MIN="${MESH_OP_HOME_STALE_MIN:-5}"
PHONE_TS_IP="${PHONE_TS_IP:-}"  # set in ~/.mesh/nodes (node-local; no hardcoded default in genome)
PRESENCE_LOG="$HOME/.mesh/presence.log"
OP_STATE="$HOME/.mesh/.op-home.state"
PHONE_ID="$HOME/.mesh/.phone-id"        # learned STABLE home-WiFi MAC of the phone (IP-drift anchor)
NOW="$(date +%s)"

_verdict() {
  local lan=$1 ble=$2 ts=$3 att=${4:-0}
  if   [ "$lan" = 1 ]; then echo HOME
  elif [ "$ble" = 1 ]; then echo HOME
  elif [ "$ts"  = 1 ]; then echo UNCERTAIN
  elif [ "$att" = 1 ]; then echo UNCERTAIN   # phone dark on all axes BUT a person-corroborated
                                             # attendance read at the workstation — never a
                                             # determinate AWAY against live counter-evidence
  else echo AWAY; fi
}

_live_macs() {  # from `ip neigh`-format lines on stdin, print lladdr MACs of ONLY live-state entries.
  # LIVE = REACHABLE (kernel-confirmed) / DELAY / PROBE (being confirmed right now). A STALE / FAILED /
  # INCOMPLETE entry lingers for a DEPARTED device (the 2026-07-06 stale-ARP false-HOME) → never counts.
  awk '/ REACHABLE| DELAY| PROBE/{for(i=1;i<=NF;i++) if($i=="lladdr") print $(i+1)}' | tr 'A-F' 'a-f'
}

_la_mac() {  # true if MAC's first octet has the locally-administered bit set (a randomized device).
  # Android randomizes its per-SSID MAC (LA bit set); routers/PCs use universal (burned-in) MACs.
  # We anchor "this host is the phone" to the LA bit so we never mis-learn the router/iMac.
  local o; o="$(printf '%s' "$1" | cut -d: -f1)"
  case "$o" in [0-9a-fA-F][0-9a-fA-F]) [ $(( 0x$o & 2 )) -ne 0 ] ;; *) return 1 ;; esac
}

# _cam_counts <who> <age_seconds> <stale_min> -> prints 1|0 (pure). SIGNAL 5 fold logic (gen-pair
# fusion, cam-watch × mesh-operator-home): a fresh cam-watch face-rec sighting of Ilya on a peer node
# counts as the SAME class of AWAY counter-evidence as SIGNAL 4 attendance — a vision-based "the
# operator is physically in a room on the mesh" fact independent of his phone. Malformed/missing age
# (peer unreachable, empty read) never counts — honest-fusion: blind input, not faked evidence.
_cam_counts() {
  local who="$1" age="$2" stale_min="$3"
  case "$age" in ''|*[!0-9]*) echo 0; return 0 ;; esac
  if [ "$who" = Ilya ] && [ "$age" -le $(( stale_min * 60 )) ]; then echo 1; else echo 0; fi
}

# _board_decision <status> <board_prev> <away_min> <min_dur> <transition> → board|trace|none (pure).
# The MIN_DURATION flood gate (chat-review/op-home-duration-threshold 2026-06-26): a SHORT absence is a
# real transition but board NOISE (was 4 posts/2h incl a 15min step-out; also a criticality-cascade
# source). Mirror the thermal STRESSED-flap pattern (CLAUDE.md: routine low-value churn lives in the
# TRACE by design). Length is unknown at away-time, so the [op-away] board post is DELAYED until AWAY
# has PERSISTED >= MIN_DURATION; a return before then = the whole away-period was short → both edges
# route to trace, the board never sees it. Returns where THIS edge goes:
#   board = significant (away crossed threshold / return from an announced absence)
#   trace = a transition not (yet) board-worthy (short flap)   ·   none = no change worth noting
_board_decision() {
  local status="$1" bprev="$2" amin="$3" mind="$4" trans="$5"
  if [ "$status" = AWAY ]; then
    if   [ "$bprev" != AWAY ] && [ "$amin" -ge "$mind" ]; then echo board   # absence became significant
    elif [ "$trans" = 1 ];                                then echo trace   # fresh sub-threshold AWAY
    else echo none; fi                                                      # steady (announced or sub-thr)
  else
    if   [ "$bprev" = AWAY ] && [ "$status" = HOME ]; then echo board  # return from announced absence (HOME=confirmed)
    elif [ "$bprev" = AWAY ];                                      then echo trace  # UNCERTAIN after AWAY: dwell-gate, not board
    elif [ "$trans" = 1 ];                                         then echo trace  # short-flap return / other edge
    else echo none; fi
  fi
}

[ "${1:-}" = --test ] && {
  # Real dep check across ALL THREE fusion axes.
  fail=0
  command -v ping     >/dev/null 2>&1 || { echo "  FAIL: ping missing — SIGNAL 1 (phone-on-LAN) dead"; fail=1; }
  command -v python3  >/dev/null 2>&1 || { echo "  FAIL: python3 missing — SIGNAL 3 (tailscale-status) pipe dies"; fail=1; }
  command -v tailscale>/dev/null 2>&1 || { echo "  FAIL: tailscale missing — SIGNAL 3 (phone TS status) has no source"; fail=1; }
  # Dry-run: exercise the VERDICT fusion against synthetic signal combinations.
  # The decision tree: LAN→HOME else BLE→HOME else TS→UNCERTAIN else attendance→UNCERTAIN else AWAY.
  # 5 branches, test every combination to catch a logic rot.
  # FALSIFIABLE: swap a threshold → an assertion FAILs.
  _f=0
  [ "$(_verdict 1 0 0)" = HOME      ] || { echo "  FAIL: LAN=1 → HOME"; _f=1; }
  [ "$(_verdict 1 1 0)" = HOME      ] || { echo "  FAIL: LAN=1 + BLE=1 → HOME"; _f=1; }
  [ "$(_verdict 1 0 1)" = HOME      ] || { echo "  FAIL: LAN=1 + TS=1 → HOME (LAN wins)"; _f=1; }
  [ "$(_verdict 0 1 0)" = HOME      ] || { echo "  FAIL: BLE=1 → HOME"; _f=1; }
  [ "$(_verdict 0 1 1)" = HOME      ] || { echo "  FAIL: BLE=1 + TS=1 → HOME (BLE wins)"; _f=1; }
  [ "$(_verdict 0 0 1)" = UNCERTAIN ] || { echo "  FAIL: only TS=1 → UNCERTAIN"; _f=1; }
  [ "$(_verdict 0 0 0)" = AWAY      ] || { echo "  FAIL: all=0 → AWAY"; _f=1; }
  # SIGNAL 4 attendance counter-evidence (2026-07-05 5h false-AWAY: phone dead at home = all
  # phone axes dark at once; attendance PHYSICAL/NEARBY must downgrade AWAY → UNCERTAIN, never HOME).
  [ "$(_verdict 0 0 0 1)" = UNCERTAIN ] || { echo "  FAIL: phone dark + attendance=1 → UNCERTAIN (not AWAY)"; _f=1; }
  [ "$(_verdict 0 0 0 0)" = AWAY      ] || { echo "  FAIL: phone dark + attendance=0 → AWAY"; _f=1; }
  [ "$(_verdict 1 0 0 1)" = HOME      ] || { echo "  FAIL: LAN=1 + attendance=1 → HOME (LAN wins)"; _f=1; }
  [ "$(_verdict 0 0 1 1)" = UNCERTAIN ] || { echo "  FAIL: TS=1 + attendance=1 → UNCERTAIN"; _f=1; }
  # Debounce: AWAY requires MESH_OP_AWAY_MISSES; HOME/BLE fire instantly (not tested here — needs mock run).
  # LA-MAC anchor: the phone's randomized MAC reads locally-administered; the router's universal does not.
  _la_mac ca:dc:f3:77:04:53 || { echo "  FAIL: LA-MAC: a randomized (phone) MAC must read locally-administered"; _f=1; }
  _la_mac 94:83:c4:68:07:66 && { echo "  FAIL: LA-MAC: a universal (router) MAC must NOT read as randomized"; _f=1; }
  # SIGNAL 5 cam-sighting fold (gen-pair fusion, cam-watch × mesh-operator-home 2026-07-08): a fresh
  # face-rec sighting of Ilya counts; a stranger/nobody, a stale sighting, or a malformed/unreachable
  # read never does (honest-fusion — a blind peer is not faked counter-evidence).
  [ "$(_cam_counts Ilya 60 10)" = 1 ]     || { echo "  FAIL: cam Ilya fresh(60s<=10m) must count"; _f=1; }
  [ "$(_cam_counts Ilya 700 10)" = 0 ]    || { echo "  FAIL: cam Ilya stale(700s>10m) must NOT count"; _f=1; }
  [ "$(_cam_counts Stranger 5 10)" = 0 ]  || { echo "  FAIL: cam Stranger must NOT count"; _f=1; }
  [ "$(_cam_counts Nobody 5 10)" = 0 ]    || { echo "  FAIL: cam Nobody must NOT count"; _f=1; }
  [ "$(_cam_counts Ilya '' 10)" = 0 ]     || { echo "  FAIL: cam malformed age (peer unreachable) must NOT count"; _f=1; }
  [ "$(_cam_counts Ilya abc 10)" = 0 ]    || { echo "  FAIL: cam non-numeric age must NOT count"; _f=1; }
  # STALE-ARP false-HOME regression (operator 2026-07-06, flagged live while on a walk): a departed
  # phone's MAC lingers STALE in `ip neigh` for minutes — it must NOT count as presence; only a
  # REACHABLE/DELAY/PROBE entry does. Predicted-HOME-but-actually-AWAY, banked so it can't recur.
  _nfix='192.168.8.50 dev wlan0 lladdr ca:dc:f3:77:04:53 STALE
192.168.8.60 dev wlan0 lladdr aa:bb:cc:dd:ee:ff REACHABLE
192.168.8.70 dev wlan0  FAILED'
  printf '%s\n' "$_nfix" | _live_macs | grep -qi 'ca:dc:f3:77:04:53' && { echo "  FAIL: STALE phone MAC counted as live (stale-ARP false-HOME regression)"; _f=1; }
  printf '%s\n' "$_nfix" | _live_macs | grep -qi 'aa:bb:cc:dd:ee:ff' || { echo "  FAIL: REACHABLE MAC not recognized as live"; _f=1; }
  # MIN_DURATION board-flood gate (chat-review/op-home-duration-threshold): the [op-away] board post
  # is DELAYED until AWAY persists >= MIN_DUR; a short away→home flap routes BOTH edges to trace.
  # FALSIFIABLE: drop the >= threshold or the board_prev guard → an assertion FAILs. (min_dur=20)
  [ "$(_board_decision AWAY ''     5  20 1)" = trace ] || { echo "  FAIL: fresh short AWAY (5m<20) → trace, not board"; _f=1; }
  [ "$(_board_decision AWAY ''     25 20 0)" = board ] || { echo "  FAIL: AWAY held 25m>=20 (no transition) → DELAYED board promote"; _f=1; }
  [ "$(_board_decision AWAY AWAY   30 20 0)" = none  ] || { echo "  FAIL: already-announced AWAY steady → none (no re-post)"; _f=1; }
  [ "$(_board_decision HOME AWAY   0  20 1)" = board ] || { echo "  FAIL: return from an announced absence → board"; _f=1; }
  [ "$(_board_decision HOME ''     0  20 1)" = trace ] || { echo "  FAIL: short-flap return (never announced) → trace, not board"; _f=1; }
  [ "$(_board_decision HOME HOME   0  20 0)" = none  ] || { echo "  FAIL: steady HOME → none"; _f=1; }
  # UNCERTAIN dwell-gate (chat-review/ophome-uncertain-dwell): UNCERTAIN after an announced AWAY must
  # NOT board instantly — route to trace (dwell-gate); only HOME after AWAY boards immediately.
  [ "$(_board_decision UNCERTAIN AWAY 0  20 1)" = trace ] || { echo "  FAIL: UNCERTAIN after AWAY → trace (dwell-gate, not board)"; _f=1; }
  [ "$(_board_decision HOME AWAY   0  20 1)" = board ] || { echo "  FAIL: HOME after AWAY → board (confirmed return)"; _f=1; }
  [ "$_f" != 0 ] && { echo "smoke-test: FAIL (verdict/board-gate decision logic drifted)"; exit 1; }
  [ "$fail" != 0 ] && { echo "smoke-test: FAIL (fusion-axis dep missing — see above)"; exit 1; }
  echo "smoke-test: ok (verdict logic: 11 combinations × 4 fusion axes + 8 board-gate cases + 6 cam-sighting fold cases + deps)"; exit 0
}

EDGE=0; [ "${1:-}" = --edge ] && EDGE=1
MODE=text; [ "${1:-}" = --json ] && MODE=json

# ---- SIGNAL 1: phone on home WiFi (phone-centric; IP-drift + MAC-randomization robust) ----
# The operator's position IS the phone's position — he is HOME iff his phone is on the home WiFi
# (operator 2026-06-19: "моё положение нужно мерить по телефону"). Pinging a STATIC configured IP
# is fragile — the DHCP lease drifts and MIUI flaps the phone off WiFi (sshd dies), so a stale IP
# reads false-AWAY. Robust path: learn the phone's STABLE home-SSID MAC (Android randomizes per-SSID
# but keeps it stable), then detect that MAC on the LAN even after the IP drifts.
phone_lan_ok=0; phone_reason=""
phone_mac="$(cat "$PHONE_ID" 2>/dev/null | grep -oiE '([0-9a-f]{2}:){5}[0-9a-f]{2}' | head -1 | tr 'A-F' 'a-f')"

# 1a-pre: live discovery each eval (task op-home-stale-phone-ip 2026-07-06) — mesh-phone-ip
# (TS→LAN probe→ADB→last-good cache) supplies a candidate even where PHONE_LAN_IPS is unset
# (ds ran with NO config → SIGNAL 1 iterated over nothing → structural false-AWAY) or stale
# (DHCP .146→.203 drift). A cached/registry guess is safe to ADD here: a candidate only counts
# after the ping + LA-MAC gate below — discovery widens the list, verification decides.
# LAN-semantics guard: SIGNAL 1 means "phone on home WiFi", so accept only RFC1918 addresses —
# a Tailscale/CGNAT IP (100.64/10) can answer over LTE with the operator far from home.
if command -v mesh-phone-ip >/dev/null 2>&1; then
  dip="$(timeout 20 mesh-phone-ip 2>/dev/null | grep -oE '^[0-9.]+$' | head -1)"
  case "$dip" in
    192.168.*|10.*|172.1[6-9].*|172.2[0-9].*|172.3[01].*)
      case " ${PHONE_LAN_IPS:-} " in
        *" $dip "*) ;;
        *) PHONE_LAN_IPS="${PHONE_LAN_IPS:-} $dip" ;;
      esac ;;
  esac
fi

# 1a: ping the configured phone IPs; on a hit, (re)learn the phone's MAC from ARP if it is a
# randomized (LA) MAC — self-calibrating + drift-correcting, and it won't latch onto the router/iMac
# if DHCP ever hands a configured IP to a non-phone (their MACs are universal, so they're rejected).
for lip in ${PHONE_LAN_IPS:-}; do
  # A phone in WiFi power-save/doze ignores the FIRST ping (radio asleep) → a single -c1 probe reads
  # false-AWAY though the phone is home on WiFi (operator 2026-06-19 "детектируете дома я или нет
  # неправильно"; proven: -c1 missed it, -c3 caught it at 205ms = radio waking). Send a few quick
  # packets — ping returns 0 if ANY is answered, so the 2nd/3rd wakes-and-catches a dozing phone.
  if ping -c 3 -W 1 "$lip" >/dev/null 2>&1; then
    m="$(ip neigh show "$lip" 2>/dev/null | grep -oiE '([0-9a-f]{2}:){5}[0-9a-f]{2}' | head -1 | tr 'A-F' 'a-f')"
    if [ -n "$m" ] && _la_mac "$m"; then
      phone_mac="$m"; printf '%s' "$m" > "$PHONE_ID" 2>/dev/null
      phone_lan_ok=1; phone_reason="phone on home WiFi ($lip)"; break
    elif [ -z "$m" ]; then
      phone_lan_ok=1; phone_reason="phone on home WiFi ($lip)"; break   # ping ok, ARP not resolved
    fi
    # a non-LA MAC answered this IP → that's a PC, not the phone — keep looking.
  fi
done

# 1a-v6: IPv6 link-local ND probe (chat-review/op-home-ipv6-nd-probe 2026-07-06). The phone's
# stable home-SSID MAC (EUI-64) yields a deterministic link-local — fe80::c8dc:f3ff:fe77:453%<if>.
# Android answers ND while often ignoring IPv4 ping (proven live on ds). Derive the LL from the
# learned MAC and probe it; on hit, verify via _live_macs (same STALE-filter as 1b). Throttled
# to one probe per sweep cycle so it never hammers the interface.
if [ "$phone_lan_ok" = 0 ] && [ -n "$phone_mac" ]; then
  # EUI-64: split MAC into halves, insert ff:fe, flip the universal/local bit.
  m="${phone_mac//:/}"; m1="${m:0:6}"; m2="${m:6}"
  # flip the 7th bit of the first byte (universal/local bit for EUI-64)
  b1=$(( 0x${m1:0:2} ^ 0x02 )); printf -v m1f '%02x%s' "$b1" "${m1:2}"
  iid="${m1f:0:4}:${m1f:4:2}ff:fe${m2:0:2}:${m2:2}"
  ll="fe80::${iid}"
  # detect the outbound interface (for the %scope id) from the default route
  ll_if="$(ip -6 route show default 2>/dev/null | awk '{print $5}' | head -1)"
  [ -n "$ll_if" ] || ll_if="wlan0"
  if ping6 -c 3 -W 1 -I "$ll_if" "$ll" >/dev/null 2>&1; then
    neigh_macs="$(ip neigh 2>/dev/null | _live_macs)"
    case " $(printf '%s ' $neigh_macs)" in
      *" $phone_mac "*) phone_lan_ok=1; phone_reason="phone on home WiFi (IPv6 LL probe $ll)";;
    esac
  fi
fi

# 1b: IP-drift recovery — no configured IP was the phone, but we know its stable MAC. Sweep the
# home /24 to populate the ARP cache (root-free: the kernel learns MACs from ping replies), then
# check whether the phone's MAC is present = it rejoined home WiFi on a NEW IP. Throttled so it is
# only a fallback and never hammers the LAN more than once per MESH_OP_SWEEP_MIN minutes.
if [ "$phone_lan_ok" = 0 ] && [ -n "$phone_mac" ]; then
  SWEEP_TS="$HOME/.mesh/.op-home-sweep.ts"
  # Sanitize the throttle stamp: a corrupted file (seen live 2026-07-06: two concatenated
  # no-newline writes → 20-digit value) makes NOW-last hugely negative → the sweep NEVER fires
  # again → ARP never populated → permanent false-AWAY/UNCERTAIN on a node whose 1a IPs miss.
  # Any non-numeric / future / overlong stamp resets to 0 (= sweep now); newline-terminated write.
  last="$(head -c 32 "$SWEEP_TS" 2>/dev/null | grep -oE '^[0-9]{1,10}' || echo 0)"
  { [ -n "$last" ] && [ "$last" -le "$NOW" ]; } 2>/dev/null || last=0
  if [ $(( NOW - last )) -ge $(( ${MESH_OP_SWEEP_MIN:-4} * 60 )) ]; then
    printf '%s\n' "$NOW" > "$SWEEP_TS" 2>/dev/null
    myip="$(ip -4 route get 1.1.1.1 2>/dev/null | grep -oE 'src [0-9.]+' | awk '{print $2}')"
    case "$myip" in
      192.168.*|10.*|172.1[6-9].*|172.2[0-9].*|172.3[01].*)
        prefix="${myip%.*}"
        # -c3 not -c1: same doze rationale as 1a — a phone in WiFi power-save ignores the first
        # packet, so a -c1 sweep never wakes it and the MAC never lands in ARP (proven 2026-06-19).
        seq 1 254 | xargs -P 64 -I{} ping -c3 -W1 "$prefix.{}" >/dev/null 2>&1 || true ;;
    esac
  fi
  # capture the ARP cache into a var (NOT 'grep -q' in a pipe — pipefail+SIGPIPE would false-miss),
  # then membership-test the learned MAC — but ONLY entries in a LIVE neighbor state.
  # THE STALE-ARP FALSE-HOME (2026-07-06, operator flagged live): `ip neigh` lists a departed
  # device's MAC in STALE state for minutes after it leaves (kernel demotes REACHABLE→STALE, and
  # only a later failed probe turns it FAILED/INCOMPLETE). The operator walked out WITH his phone,
  # its ARP entry lingered STALE, and this membership test — matching ANY state — flapped op-home to
  # HOME, so a day-summary told him he was home while on a walk. A STALE/FAILED/INCOMPLETE entry is
  # NOT proof of presence; only REACHABLE (kernel-confirmed live) / DELAY / PROBE (being confirmed
  # right now, post-sweep-ping) count as "the phone is here". Departed phone -> no live entry -> AWAY.
  neigh_macs="$(ip neigh 2>/dev/null | _live_macs)"
  case " $(printf '%s ' $neigh_macs)" in
    *" $phone_mac "*) phone_lan_ok=1; phone_reason="phone MAC live on home WiFi (IP drifted from config)";;
  esac
fi

# ---- SIGNAL 2: operator BLE device at strong RSSI (from cached log) ----
ble_home=0; ble_device=""; ble_rssi=0
if [ -s "$PRESENCE_LOG" ]; then
  log_age=$(( (NOW - $(date +%s -r "$PRESENCE_LOG" 2>/dev/null || echo $NOW)) / 60 ))
  if [ "$log_age" -le "$OP_HOME_STALE_MIN" ]; then
    IFS=':' read -ra DEVS <<< "$OP_BLE_DEVICES"
    while IFS= read -r scan_line; do
      for dev_name in "${DEVS[@]}"; do
        # extract RSSI for this device name: format -RSSI|MAC|NAME
        rssi="$(printf '%s' "$scan_line" | grep -oE '\-[0-9]+\|[^|]+\|[^| ]*'"$dev_name" | grep -oE '^\-[0-9]+' | head -1)"
        if [ -n "$rssi" ] && [ "$rssi" -ge "$OP_BLE_RSSI" ]; then
          ble_home=1; ble_device="$dev_name"; ble_rssi="$rssi"; break 2
        fi
      done
    done < <(tail -12 "$PRESENCE_LOG")
  fi
fi

# ---- SIGNAL 3: Tailscale phone status (skipped if PHONE_TS_IP unset) ----
ts_phone_online=0
if [ -n "$PHONE_TS_IP" ]; then
  tailscale status --json 2>/dev/null | python3 -c "
import json,sys
d=json.load(sys.stdin)
for p in (d.get('Peer') or {}).values():
    ips = p.get('TailscaleIPs') or []
    if '$PHONE_TS_IP' in ips and p.get('Online'):
        print('online')
        break
" 2>/dev/null | grep -q online && ts_phone_online=1
fi

# ---- SIGNAL 4: local attendance counter-evidence (the workstation, not the phone) ----
# All three signals above anchor to the PHONE (LAN MAC / named BLE / Tailscale). A phone that dies
# AT home (battery dead; MIUI kills sshd — the Redmi goes dark for days) blacks out every axis at
# once, and the tree asserted a determinate AWAY for as long as the phone was down (proven
# 2026-07-05: 5h of AWAY while mesh-attendance read NEARBY at this desk). Dark sensors are not
# evidence of absence — before asserting AWAY, consult the attendance fusion (person-specific,
# appliance-proof: keypress IRQ + personal-classified BLE). PHYSICAL/NEARBY downgrades the would-be
# AWAY to an honest UNCERTAIN — never to HOME (a body at the desk is not identity; a personal BLE
# device can be one left home). REMOTE/UNATTENDED/UNKNOWN/blind = no counter-evidence → AWAY stands.
# Only probed on the would-be-AWAY path, so the 3 positive branches pay zero extra cost.
att_present=0; att_verdict=""
if [ "$phone_lan_ok" = 0 ] && [ "$ble_home" = 0 ] && [ "$ts_phone_online" = 0 ]; then
  ATT_CACHE="$HOME/.mesh/.attendance.cache"
  att_age=$(( NOW - $(date +%s -r "$ATT_CACHE" 2>/dev/null || echo 0) ))
  if [ -s "$ATT_CACHE" ] && [ "$att_age" -le $(( ${MESH_OP_ATT_STALE_MIN:-10} * 60 )) ]; then
    att_verdict="$(head -1 "$ATT_CACHE" | awk '{print $2}')"
  elif command -v mesh-attendance >/dev/null 2>&1; then
    att_verdict="$(timeout 20 mesh-attendance 2>/dev/null | head -1 | awk '{print $2}')"
  fi
  case "$att_verdict" in PHYSICAL|NEARBY) att_present=1 ;; esac
fi

# ---- SIGNAL 5: cam-watch face-rec sighting (vision counter-evidence, gen-pair fusion 2026-07-08) ----
# mesh-cam-watch's person_present() already recognizes Ilya/Rozalia/Stranger/Nobody on every motion
# event and stamps it to ~/.mesh/.cam-face-state (a `-state` artifact — fleet-visible, see mesh-cam-
# watch). A phone dark on every axis (SIGNAL 1-3) does NOT mean the operator left if a camera on
# another mesh node just recognized him in frame — same doctrine as SIGNAL 4, a different modality
# (vision, not keypress/BLE). Only probed on the would-be-AWAY path (zero extra cost otherwise), and
# only Ilya (not Rozalia/Stranger/Nobody) counts, and only if the sighting is fresh — a stale/covered/
# unreachable camera degrades to no-evidence, never a faked HOME.
# MESH_OP_CAM_PROBE overrides the peer read for --test (must print "<who>|<age_seconds>" or nothing).
cam_present=0; cam_who=""; cam_age=""
if [ "$phone_lan_ok" = 0 ] && [ "$ble_home" = 0 ] && [ "$ts_phone_online" = 0 ]; then
  _cam_out=""
  if [ -n "${MESH_OP_CAM_PROBE:-}" ]; then
    _cam_out="$("$MESH_OP_CAM_PROBE" 2>/dev/null)"
  elif command -v mesh-peer-addr >/dev/null 2>&1; then
    _cam_peer="${MESH_FUSE_PEER:-}"
    if [ -z "$_cam_peer" ]; then
      _cam_ip="$(mesh-peer-addr "${MESH_FUSE_LABEL:-default-string}" 2>/dev/null || true)"
      [ -n "$_cam_ip" ] && _cam_peer="${MESH_PEER_USER:-$(whoami)}@$_cam_ip"
    fi
    [ -n "$_cam_peer" ] && _cam_out="$(timeout 6 ssh -o ConnectTimeout=4 -o BatchMode=yes \
      -o StrictHostKeyChecking=accept-new "$_cam_peer" \
      'f="$HOME/.mesh/.cam-face-state"; [ -s "$f" ] || exit 1; w=$(cat "$f"); a=$(( $(date +%s) - $(stat -c %Y "$f" 2>/dev/null || echo 0) )); printf "%s|%s" "$w" "$a"' \
      2>/dev/null)"
  fi
  if [ -n "$_cam_out" ]; then
    cam_who="${_cam_out%%|*}"; cam_age="${_cam_out#*|}"
    [ "$(_cam_counts "$cam_who" "$cam_age" "${MESH_OP_CAM_STALE_MIN:-10}")" = 1 ] && cam_present=1
  fi
fi

# ---- VERDICT ----
status=UNCERTAIN; reason=""
if [ "$phone_lan_ok" = 1 ]; then
  status=HOME; reason="${phone_reason:-phone on home WiFi}"
elif [ "$ble_home" = 1 ]; then
  status=HOME; reason="operator BLE device '$ble_device' at ${ble_rssi} dBm"
elif [ "$ts_phone_online" = 1 ]; then
  # TS online but not on LAN → likely away-mobile (Tailscale works remotely)
  status=UNCERTAIN; reason="phone Tailscale online but not on LAN (mobile?)"
elif [ "$att_present" = 1 ]; then
  status=UNCERTAIN; reason="phone dark on all axes, but attendance reads $att_verdict at the workstation"
elif [ "$cam_present" = 1 ]; then
  status=UNCERTAIN; reason="phone dark on all axes, but camera face-rec sighted Ilya on ${MESH_FUSE_LABEL:-default-string} ${cam_age}s ago"
elif [ "$phone_lan_ok" = 0 ] && [ "$ts_phone_online" = 0 ]; then
  status=AWAY; reason="phone not on LAN, not on Tailscale"
fi

if [ "$MODE" = json ]; then
  printf '{"status":"%s","reason":"%s","phone_lan":%s,"ble_home":%s,"ts_online":%s,"cam_sighting":%s}\n' \
    "$status" "$reason" "$phone_lan_ok" "$ble_home" "$ts_phone_online" "$cam_present"
  exit 0
fi

if [ "$EDGE" = 1 ]; then
  prev="$(cat "$OP_STATE" 2>/dev/null || echo)"
  MISSF="$HOME/.mesh/.op-home-awaymiss"
  # DEBOUNCE the AWAY transition: the phone flaps off WiFi (MIUI/power-save — see phone-sshd-dies-miui-
  # killing) so a single missed ping would falsely fire [op-away]. Require N consecutive AWAY reads before
  # declaring it. HOME/UNCERTAIN still fire instantly (want a fast "operator's back"). (2026-06-15 false fire.)
  if [ "$status" = AWAY ]; then
    misses=$(( $(cat "$MISSF" 2>/dev/null || echo 0) + 1 ))
    printf '%s' "$misses" > "$MISSF"
    if [ "$misses" -lt "${MESH_OP_AWAY_MISSES:-2}" ]; then
      [ -n "$prev" ] && printf '%s' "$prev" > "$OP_STATE"   # not yet confirmed away — hold prev, stay silent
      exit 0
    fi
  else
    rm -f "$MISSF" 2>/dev/null                              # any non-AWAY read clears the debounce counter
  fi
  printf '%s' "$status" > "$OP_STATE"                        # confirmed verdict (debounce 'was' + change ref)

  # ---- MIN_DURATION board-flood gate (chat-review/op-home-duration-threshold 2026-06-26) ----
  # Route via _board_decision (above): board for a SIGNIFICANT absence/return, trace for a short flap,
  # silence for steady state. The [op-away] board post is DELAYED — AWAY must persist >= MIN_DURATION —
  # so a quick step-out-and-back leaves the board untouched (both edges fall to trace).
  MIN_DUR_MIN="${MESH_OP_MIN_DURATION_MIN:-20}"
  BOARD_STATE_F="$HOME/.mesh/.op-home.board-state"          # last status actually POSTED to the board
  AWAY_SINCE_F="$HOME/.mesh/.op-home.away-since"            # epoch the current AWAY period was confirmed
  board_prev="$(cat "$BOARD_STATE_F" 2>/dev/null || echo)"
  transition=0; [ "$status" != "${prev:-}" ] && transition=1

  away_min=0
  if [ "$status" = AWAY ]; then
    [ -s "$AWAY_SINCE_F" ] || printf '%s' "$NOW" > "$AWAY_SINCE_F"   # stamp away-start once per period
    away_since="$(cat "$AWAY_SINCE_F" 2>/dev/null || echo "$NOW")"
    case "$away_since" in (*[!0-9]*|'') away_since="$NOW";; esac
    away_min=$(( (NOW - away_since) / 60 ))
  else
    rm -f "$AWAY_SINCE_F" 2>/dev/null                       # operator back / ambiguous — reset the period
  fi

  decision="$(_board_decision "$status" "${board_prev:-}" "$away_min" "$MIN_DUR_MIN" "$transition")"
  tag="$(printf '%s' "$status" | tr 'A-Z' 'a-z')"
  case "$decision" in
    board)
      printf '%s' "$status" > "$BOARD_STATE_F"
      msg="[op-${tag}] operator ${status}: ${reason} (was ${board_prev:-new})"
      command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="op-home@$(hostname)" mesh-chat "$msg" 2>/dev/null || true
      printf '%s\n' "$status" ;;
    trace)
      command -v mesh-trace >/dev/null 2>&1 && MESH_WHO="op-home@$(hostname)" \
        mesh-trace "op-home: ${status} (${reason}) — short/sub-threshold, trace-only (board gate: significant absence >= ${MIN_DUR_MIN}m)" >/dev/null 2>&1 || true
      printf '%s\n' "$status" ;;
    *) : ;;   # none — steady state, stay silent
  esac
  exit 0
fi

printf '%s — %s\n' "$status" "$reason"
exit 0
