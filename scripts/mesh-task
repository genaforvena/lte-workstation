#!/usr/bin/env python3
# orphan-ok: on-demand task-chain coordinator; invoked by minds and board dispatch, not a cron reflex
"""mesh-task: durable ordered task chains with explicit inter-mind hand-off.

Task-state records in chat.log are authoritative; JSON files are derived caches.
Completion requires an artifact and opens
exactly one successor and writes the successor's handoff before posting its task.
"""
from __future__ import annotations

import json
import errno
import hashlib
import calendar
import contextlib
import fcntl
import os
import re
import subprocess
import sys
import tempfile
import time
from pathlib import Path

from mesh_task_log import replay as replay_task_log, replay_cached as replay_task_log_cached, encode as encode_task_state, decode as decode_task_state
from mesh_task_log import eligibility, independent_ready
from mesh_task_log import ORIGIN_FIELDS
from mesh_task_log import EVENT_BYTES


ROOT = Path(os.environ.get("MESH_DIR", str(Path.home() / ".mesh")))


def node_local_roots() -> tuple[Path, Path]:
    """The node-local roots that hold artifacts since they left the genome tree (2026-09-16)."""
    return (Path(os.environ.get("MESH_EVIDENCE_ROOT", str(ROOT / "evidence"))),
            Path(os.environ.get("MESH_PLANS_DIR", str(ROOT / "plans"))))


def resolve_node_local(path: Path) -> Path:
    """Map a legacy in-repo evidence/plan path onto its node-local root.

    Receipts, artifacts, audits, chat-range reviews and plan files moved out of the genome tree on
    2026-09-16
    (docs/EVIDENCE-MOVED.md, mesh-evidence-dir). Ledger rows are deliberately NOT rewritten, so a row
    \u2014 or a mind copying a path out of one \u2014 keeps the old spelling, naming a file that really exists
    under the node's root. A bare `.exists()` then refuses real evidence as missing.

    Mirrors mesh-evidence-dir's mapping and substitutes ONLY when the mapped target exists, so a
    genuinely absent artifact is still absent and the missing-artifact guard keeps its teeth.
    """
    if path.exists():
        return path
    evidence, plans = node_local_roots()
    arms = (("docs/task-receipts/", evidence / "receipts"),
            ("task-receipts/", evidence / "receipts"),
            ("docs/chat-range-reviews/", evidence / "chat-range-reviews"),
            ("docs/audits/", evidence / "audits"),
            ("audits/", evidence / "audits"),
            ("artifacts/", evidence / "artifacts"),
            ("docs/task-plans/", plans),
            ("task-plans/", plans),
            ("docs/plans/", plans),
            ("docs/", plans))
    text = str(path)
    for legacy, root in arms:
        marker = "/" + legacy
        at = text.rfind(marker)
        if at != -1:
            rest = text[at + len(marker):]
        elif text.startswith(legacy):
            rest = text[len(legacy):]
        else:
            continue
        # the generic docs/ arm is only for a plan written directly under docs/ (docs/x.plan.tsv);
        # anything else under docs/ is ordinary repository documentation and passes through unchanged
        if legacy == "docs/" and not rest.endswith(".plan.tsv"):
            continue
        candidate = root / rest
        if candidate.exists():
            return candidate
    return path
CHAINS = Path(os.environ.get("MESH_TASK_DIR", str(ROOT / "task-chains")))
ACTOR = os.environ.get("MESH_TASK_ACTOR", os.environ.get("MESH_WHO", "mesh-task"))
COORDINATOR = os.environ.get("MESH_TASK_COORDINATOR", "witness")
LEASE_SECONDS = int(os.environ.get("MESH_TASK_LEASE_SECONDS", "1800"))
MAX_UNBLOCK_ATTEMPTS = 3
MAX_UNBLOCK_DEPTH = 2
# Park-quiet TTL (2026-09-18 unblock flood, operator ask "drain ledger from unblock tasks" +
# "dead letter queue"): the live ledger reached 692 unblock resolvers and ~2400 of the last
# 3000 chat.log lines were [task-ledger] re-emits, because _refresh_unblock_resolver saved
# `unblock_reused_at=now()` on EVERY sweep pass (every 5 min) for every covered resolver —
# 692 pointless appends per pass on a 135MB log, and each save re-contended the owner lock
# that hands out work. This TTL makes `unblock_reused_at` mean what its name implies: a park
# marker good for UNBLOCK_QUIET_SECONDS. A resolver whose gate is unchanged, that is drained,
# or whose next attempt is not due yet is not touched again until the TTL expires; state
# changes (dispatch, take, retry append, unblock) keep flowing because every other writer
# saves with fresh facts. `unblock-sweep --quiet` returns count-only lines (sweep r=2 per
# chain per pass is revision noise, not news). Zero config = the flood is dead by default;
# set 0 to restore the old touch-every-pass behavior verbatim.
UNBLOCK_QUIET_SECONDS = int(os.environ.get("MESH_TASK_UNBLOCK_QUIET_SECONDS", "14400"))


def _env_float(name: str, default: float) -> float:
    try:
        return float(os.environ.get(name, default))
    except (TypeError, ValueError):
        return default


# Bounded lock acquisition: a stuck holder must fail LOUD, never hang a
# take/done into a timeout(1) kill (rc=124, chat.log 76984-77026). Reads
# (queue/status/replay/check) never take these locks; only mutations do, and
# each mutation holds them only across its own mutate+append.
LOCK_TIMEOUT_SECONDS = _env_float("MESH_TASK_LOCK_TIMEOUT", 30.0)
LOCK_POLL_BASE_SECONDS = 0.05
LOCK_POLL_CAP_SECONDS = 0.5
EMIT_TIMEOUT_SECONDS = _env_float("MESH_TASK_EMIT_TIMEOUT", 30.0)
MAX_SWEEP_META_YIELDS = 3
_SWEEP_META_YIELD_COUNT = 0
_SWEEP_META_YIELD_OVERFLOWED = 0
MAX_DISPATCH_RETRIES = int(os.environ.get("MESH_TASK_DISPATCH_RETRIES", "3"))
DRAIN_MARKER = os.environ.get("MESH_TASK_DRAIN_MARKER", "operator-drained")
LAST_EMIT_ERROR = ""
SAFE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._/-]{0,119}$")
TASK_METADATA_KEYS = ("repository", "scope", "artifact_root", "revision", "next_command",
                      "tags", "design_artifact")
DEFAULT_PRIORITY = 0
_records = None

MACHINE_PARAMETER_CONTRACT = (
    " machine-owned parameter selection: choose all not-yet-frozen parameters from repository/runtime evidence; "
    "record the chosen seed, ranges, and arm ordering, model revision, corpus/dataset manifests "
    "(including CSV/JSON/TSV inputs), dataset split and sample budget, cross-validation folds/repeats "
    "where applicable (or record not applicable when the frozen design has no CV field), "
    "training hyperparameters, metrics and decision thresholds, stopping rule, and resource and wall-time caps "
    "with rationale before execution; preserve any frozen registration unchanged; verify the result; "
    "do not wait for the operator to pick or freeze them."
)
MACHINE_RESOURCE_CONTRACT = (
    " resource ownership: treat temporary GPU/CPU/memory/headroom scarcity as queued retry state; "
    "choose an available node/slot or retry cadence from live mesh evidence, record the resource "
    "decision and evidence in the artifact, and do not wait for the operator to reschedule it. "
    "For a GPU-bound job on mesh-home, use mesh-heavy-run with MESH_HEAVY_GPU_PREEMPT=1 and the "
    "task's measured minimum-free-VRAM threshold; its bounded mesh-gpu-lease may pause only "
    "mesh-managed GPU services, then restores their prior active state on completion or expiry. "
    "If the declared headroom still cannot be reached, services are restored and the job stays queued."
)
MACHINE_PREREQUISITE_CONTRACT = (
    " missing-prerequisite recovery: before rejecting, inspect repo, ledger, and live mesh; reuse an "
    "exact active prerequisite task or create/link one, then do mesh-owned work and evidence-based "
    "decisions/registrations without waiting. Keep parent queued/typed-blocked until gate passes. "
    "If external data unavailable, substitute honestly or record exact event/retry condition. "
    "Reject only invalid, duplicate, out-of-scope, or unsafe work with evidence."
)


def autonomous_task_description(description: str) -> str:
    """Make prerequisites, experiment choices, and transient resources owner obligations."""
    result = description.rstrip()
    lower = result.lower()
    if "missing-prerequisite recovery:" not in lower:
        result += MACHINE_PREREQUISITE_CONTRACT
        lower = result.lower()
    if (re.search(r"\b(?:experiments?|studies?|parameters?|params?|benchmarks?|ablations?|replications?)\b", result, re.I)
            and "machine-owned parameter selection" not in lower):
        result += MACHINE_PARAMETER_CONTRACT
        lower = result.lower()
    if (re.search(r"\b(?:gpu|cuda|cpu|memory|ram|headroom|resource(?:s)?)\b", result, re.I)
            and "resource ownership" not in lower):
        result += MACHINE_RESOURCE_CONTRACT
    return result


def task_records(allow_missing: bool = False) -> dict:
    global _records
    if _records is None:
        log = ROOT / "chat.log"
        if allow_missing and not log.exists():
            _records = {}
        elif os.environ.get("MESH_TASK_REPLAY_CACHE", "on") == "off":
            _records = replay_task_log(log)
        else:
            _records = replay_task_log_cached(log)
    return _records


def latest_chain_record(chain: str):
    """Fast-path previous-record lookup for ONE chain (fix-double-replay-emit-timeout,
    2026-09-17): save() used to full-replay 83k-line chat.log (~16-22s) and then the
    append subprocess replayed it AGAIN (~16-22s), so every mutation ran ~35s+ against
    a 30s emit timeout. This scans for this chain's ledger lines only (cheap memcmp
    prefilter; decode just the hits) and returns its latest record, or None when the
    chain is absent OR the hits don't form a clean 1..N run. The full replay inside
    append() stays the canonical gate (revision + transition + origin checks under
    lock) — a wrong answer here can only surface as a clear ReplayError retry, never
    as silent corruption."""
    log = ROOT / "chat.log"
    if not log.exists():
        return None
    try:
        needle = re.compile(rb'/chain=s:' + re.escape(chain).encode() + rb' \|')
    except (TypeError, ValueError):
        return None
    hits = {}
    try:
        with log.open('rb') as source:
            for line in source:
                if not needle.search(line):
                    continue
                match = EVENT_BYTES.match(line.rstrip(b'\n'))
                if not match:
                    continue
                try:
                    record = decode_task_state(match.group(2))
                except (ValueError, TypeError, KeyError):
                    return None
                try:
                    revision = record['revision']
                except (TypeError, KeyError):
                    return None
                hits[revision] = record
    except OSError:
        return None
    if not hits:
        return None
    ordered = sorted(hits)
    if ordered != list(range(1, ordered[-1] + 1)):
        return None
    return hits[ordered[-1]]


def chain_states():
    """Read canonical chains exclusively from the append-only text log."""
    records = task_records()
    for chain, record in sorted(records.items()):
        yield path_for(chain), json.loads(json.dumps(record["data"]))


def die(message: str, code: int = 2) -> None:
    print(f"mesh-task: {message}", file=sys.stderr)
    raise SystemExit(code)


def check_name(value: str, label: str) -> str:
    if not SAFE.fullmatch(value) or value.startswith("-"):
        die(f"invalid {label} '{value}' (use letters, numbers, '.', '_', '/', '-')")
    return value


def priority_of(step: dict) -> int:
    """Return the single numeric ordering key shared by queue and audit."""
    value = step.get("priority", DEFAULT_PRIORITY)
    try:
        return int(value)
    except (TypeError, ValueError):
        die(f"invalid priority on task {step.get('id', 'unknown')}: {value!r}")


def priority_label(step: dict) -> str:
    return str(priority_of(step))


def path_for(chain: str) -> Path:
    check_name(chain, "chain")
    return CHAINS / (chain.replace("/", "__") + ".json")


def context_path(owner: str) -> Path:
    return ROOT / "task-context" / (owner.replace("/", "__") + ".json")


def task_metadata(data: dict, step: dict) -> dict:
    metadata = dict(data.get("task_context") or {})
    metadata.update({key: step[key] for key in TASK_METADATA_KEYS if step.get(key) is not None})
    return {key: value for key, value in metadata.items() if value not in (None, "")}


def metadata_suffix(data: dict, step: dict) -> str:
    metadata = task_metadata(data, step)
    labels = (("repository", "repository"), ("scope", "scope"),
              ("artifact_root", "artifact-root"), ("revision", "revision"),
              ("next_command", "next-command"), ("tags", "tags"),
              ("design_artifact", "design_artifact"))
    return "".join(f" {label}={metadata[key]}" for key, label in labels if key in metadata)


def validate_artifact_scope(data: dict, step: dict, artifact_path: Path) -> None:
    metadata = task_metadata(data, step)
    root = metadata.get("artifact_root") or metadata.get("repository")
    if not root:
        return
    expected = Path(root).expanduser().resolve()
    # A task may pin its artifacts to a tree (artifact_root/repository), but artifacts have lived under
    # the node's evidence and plans roots since 2026-09-16 (docs/EVIDENCE-MOVED.md). Accept those roots
    # too: the guard keeps an artifact inside the task's own tree, it does not forbid the node's roots.
    for candidate in (expected, *node_local_roots()):
        try:
            artifact_path.relative_to(candidate)
            return
        except ValueError:
            continue
    die(f"artifact {artifact_path} is outside expected repository {expected}")


def reject_ephemeral_artifact_path(artifact_path: Path) -> None:
    """A done receipt must survive the temp directory that produced it."""
    resolved = artifact_path.expanduser().resolve()
    configured_tmp = os.environ.get("TMPDIR") or tempfile.gettempdir()
    roots = (Path("/tmp"), Path("/dev/shm"), Path(configured_tmp).expanduser())
    for candidate in roots:
        root = candidate.resolve()
        if resolved == root or root in resolved.parents:
            die(f"ephemeral artifact path cannot settle a task: {resolved} (under {root})")


IMPL_SLUG_VERBS = frozenset({
    "implement", "fix", "build", "wire", "land", "add", "split", "patch",
    "repair", "migrate", "refactor", "implement-safe-delete", "rework", "harden",
    "determinize",
})
IMPL_OWNERS = frozenset({"genome"})
PROSE_SUFFIXES = frozenset({".md", ".markdown", ".txt", ".rst"})


PANE_ROLES = frozenset({
    "steward", "check", "verify", "codex", "worker", "minds", "dev",
    "reflexes", "organs", "tg", "models", "sound", "sense", "witness", "chat",
})


def validate_implementation_artifact(step: dict, artifact_path: Path, result: str) -> None:
    """Implementation steps settle only on executables (or plans listing them),
    wired to a top pane. Receipts are receipts, not artifacts.

    A step needs implementation when its slug's first token is an implementation
    verb or its owner is an implementation lane — unless the step declares itself
    receipt-only via the exact `receipt-only` tag. Three hard checks:
    1. prose suffix (.md/.txt/...) → refused, always;
    2. the artifact must be executable, or a .tsv plan naming at least one
       existing executable path (absolute or repo-relative) expected when
       implemented — anything else is a paragraph about the work, not the work;
    3. the result must name the observing top pane as `pane:<role>` with a
       `mesh-dash` role — an artifact no pane observes is waste.
    """
    if has_task_tag(step, "receipt-only"):
        return
    slug = str(step.get("slug") or "")
    first_token = slug.split("-")[0].split("_")[0].lower() if slug else ""
    needs_impl = first_token in IMPL_SLUG_VERBS or step.get("owner") in IMPL_OWNERS
    if not needs_impl:
        return
    if artifact_path.suffix.lower() in PROSE_SUFFIXES:
        die(f"implementation step {step.get('id')} cannot settle on prose artifact "
            f"{artifact_path.name}: receipts are receipts, not artifacts — point at "
            f"the changed executable, a test, or a plan listing executables, "
            f"or tag the step receipt-only")
    if artifact_path.suffix.lower() == ".tsv":
        try:
            text = artifact_path.read_text(encoding="utf-8")
        except OSError:
            text = ""
        root = Path.cwd()
        found = False
        for token in text.replace("\t", " ").replace("\n", " ").split():
            candidate = Path(token).expanduser()
            if not candidate.is_absolute():
                candidate = root / candidate
            if candidate.is_file() and os.access(candidate, os.X_OK):
                found = True
                break
        if not found:
            die(f"implementation step {step.get('id')} plan artifact "
                f"{artifact_path.name} lists no existing executable: a plan must "
                f"name the executables expected when implemented")
    elif not os.access(artifact_path, os.X_OK):
        die(f"implementation step {step.get('id')} artifact {artifact_path.name} "
            f"is not executable: point at the executable (or a .tsv plan listing "
            f"executables), or tag the step receipt-only")
    panes = {m.group(1) for m in re.finditer(r"pane:([a-z-]+)", result or "")}
    if not (panes & PANE_ROLES):
        die(f"implementation step {step.get('id')} names no observing top pane: "
            f"add pane:<role> to the result ({'/'.join(sorted(PANE_ROLES))}) — "
            f"an artifact no pane observes is waste")


def update_context(owner: str, chain: str, step: dict, remove: bool = False) -> None:
    if owner:
        reconcile_context(owner)


def active_tasks_for_owner(records: dict, owner: str, excluding: str = "") -> list[dict]:
    """Return active claims for one owner, normalizing legacy slash-qualified owners."""
    requested = normalize_owner(owner)
    return [{"task": step["id"], "owner": requested, "status": step["status"]}
            for record in records.values() for step in record["data"]["steps"]
            if normalize_owner(step.get("owner") or "") == requested
            and step.get("status") in ("active", "claimed")
            and step.get("id") != excluding]


def active_contexts(owner: str, excluding: str = "") -> list[dict]:
    """Derive active ownership from chain records, not disposable context caches."""
    return active_tasks_for_owner(task_records(), owner, excluding)


def active_task_limit() -> int:
    """Bound concurrent independent claims; an explicit lower limit remains available."""
    try:
        return max(1, int(os.environ.get("MESH_TASK_MAX_ACTIVE", "3")))
    except ValueError:
        return 3


def check_eligibility(records: dict, task: str, mode: str, owner: str) -> int:
    """Apply the bounded active-task capacity at the dispatch boundary too."""
    verdict = eligibility(records, task, mode, owner)
    if verdict != 0 or mode != "dispatch":
        return verdict
    matches = []
    for record in records.values():
        data = record["data"]
        for step in data["steps"]:
            alias = re.sub(r"[\W_]+", "-", step["id"].lower()).strip("-")
            if task in (step["id"], alias):
                matches.append((data, step))
    if len(matches) != 1:
        return verdict
    data, step = matches[0]
    if data.get("chain", "").startswith("unblock/"):
        return verdict
    claim_owner = step.get("owner") or owner
    return 2 if len(active_tasks_for_owner(records, claim_owner, step["id"])) >= active_task_limit() else 0


def reconcile_context(owner: str) -> int:
    """Rebuild owner pointers, including completed turns, without reading caches."""
    path = context_path(owner)
    contexts = []
    for _, data in chain_states():
        for step in data["steps"]:
            if step.get("owner") != owner or step.get("status") not in ("active", "blocked", "done", "claimed"):
                continue
            context = {"chain": data["chain"], "step": step["slug"], "task": step["id"],
                         "owner": owner, "status": step["status"],
                         "started": step.get("started"), "finished": step.get("finished"),
                         "lease_until": step.get("lease_until"),
                         "last_progress": step.get("last_progress"), "artifact": step.get("artifact") or step.get("progress_artifact"),
                         "next_action": step.get("next_action"), "next_update": step.get("next_update"),
                         "retry": step.get("retry")}
            context.update(task_metadata(data, step))
            contexts.append(context)
    if contexts:
        save(path, contexts)
    elif path.exists():
        path.unlink()
    return len(contexts)


def import_chains() -> None:
    """Explicit one-time import. Existing log records always win over caches."""
    pending = []
    records = task_records()
    for path in sorted(CHAINS.glob("*.json")):
        data = json.loads(path.read_text(encoding="utf-8"))
        encode_task_state(data, 1)  # Validate all inputs before the first append.
        if path != path_for(data["chain"]):
            die(f"chain filename does not match identity: {path}")
        if data["chain"] not in records:
            pending.append((path, data))
    for path, data in pending:
        save(path, data)
    verified = replay_task_log(ROOT / "chat.log") if records else {}
    for _, data in pending:
        if verified[data["chain"]]["data"] != data:
            die(f"import verification mismatch: {data['chain']}", 1)
    print(f"imported={len(pending)} verified={len(verified)} source={ROOT / 'chat.log'}")


def rebuild() -> None:
    """Materialize disposable caches solely from the text log."""
    records = replay_task_log(ROOT / "chat.log")
    owners = set()
    for chain, record in sorted(records.items()):
        save(path_for(chain), record["data"])
        owners.update(step["owner"] for step in record["data"]["steps"] if step.get("owner"))
    for owner in sorted(owners):
        reconcile_context(owner)
    print(f"rebuilt={len(records)} owners={len(owners)} source={ROOT / 'chat.log'}")


def now() -> str:
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


def future(seconds: int = LEASE_SECONDS) -> str:
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(time.time() + seconds))


def actor() -> str:
    return ACTOR.split("@")[0].split("/")[-1]


def normalize_owner(owner: str) -> str:
    """Use the same post-slash window identity as actor()."""
    return owner.rsplit("/", 1)[-1]


def canonicalize_owners(data: dict) -> None:
    """Migrate slash-qualified service/window owners at a mutation boundary."""
    for step in data.get("steps", []):
        if step.get("owner"):
            step["owner"] = normalize_owner(step["owner"])


def require_owner(step: dict) -> None:
    if actor() != step["owner"]:
        die(f"exact owner required: task owner={step['owner']} actor={actor()}")


def require_owner_or_coordinator(step: dict) -> None:
    if actor() not in (step.get("owner"), COORDINATOR):
        die(f"exact owner or coordinator required: task owner={step.get('owner')} "
            f"coordinator={COORDINATOR} actor={actor()}")


def independent_marked(step: dict) -> bool:
    reason = step.get("independent_reason")
    return isinstance(reason, str) and bool(reason.strip())


def status_from_current(data: dict) -> str:
    """Keep chain status tied to its ordered head after side-step transitions."""
    head = data["steps"][data["current"]]
    if head.get("status") == "blocked":
        return "blocked"
    if head.get("status") in ("active", "claimed", "running"):
        return "active"
    if head.get("status") == "open":
        return "open"
    return data.get("status", "open")


def artifact_digest(path: Path) -> str:
    if path.is_dir():
        die(f"artifact must be a file: {path}")
    return hashlib.sha256(path.read_bytes()).hexdigest()


def has_task_tag(step: dict, wanted: str) -> bool:
    """Match one exact comma-separated task metadata tag."""
    return wanted in {tag.strip() for tag in str(step.get("tags") or "").split(",") if tag.strip()}


def audit_finding_manifest(artifact_path: Path) -> Path:
    return Path(str(artifact_path) + ".findings.json")


def validate_audit_findings(step: dict, artifact_path: Path) -> tuple[Path, int, int]:
    """Require each tagged audit finding to be reasoned away or routed to an exact task."""
    manifest_path = audit_finding_manifest(artifact_path)
    if not manifest_path.is_file():
        die(f"audit finding manifest does not exist: {manifest_path}")
    try:
        payload = json.loads(manifest_path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        die(f"audit finding manifest is unreadable: {manifest_path}: {exc}")
    findings = payload.get("findings") if isinstance(payload, dict) and payload.get("version") == 1 else None
    if not isinstance(findings, list) or not findings:
        die("audit finding manifest requires version=1 and at least one finding disposition")

    records = task_records()
    seen: set[str] = set()
    actionable = 0
    for number, finding in enumerate(findings, 1):
        if not isinstance(finding, dict):
            die(f"audit finding {number} must be an object")
        finding_id = finding.get("id")
        if not isinstance(finding_id, str) or not finding_id.strip() or finding_id in seen:
            die(f"audit finding {number} requires a unique nonempty id")
        seen.add(finding_id)
        if finding.get("actionable") is False:
            reason = finding.get("reason")
            if not isinstance(reason, str) or not reason.strip():
                die(f"audit finding {finding_id} marked non-actionable requires a reason")
            continue
        if finding.get("actionable") is not True:
            die(f"audit finding {finding_id} requires boolean actionable")
        actionable += 1
        target = finding.get("task")
        expected_owner = finding.get("owner")
        if not isinstance(target, str) or "/" not in target or not target.strip():
            die(f"audit finding {finding_id} requires an exact chain/step task id")
        if target == step.get("id"):
            die(f"audit finding {finding_id} cannot route to its own audit task")
        if not isinstance(expected_owner, str) or not expected_owner.strip():
            die(f"audit finding {finding_id} requires an exact owner")
        matches = []
        for record in records.values():
            data = record.get("data", {})
            for target_step in data.get("steps", []):
                if target_step.get("id") == target:
                    matches.append((data, target_step))
        if not matches:
            die(f"audit finding {finding_id} task {target} does not exist")
        if len(matches) != 1:
            die(f"audit finding {finding_id} task {target} is ambiguous")
        target_data, target_step = matches[0]
        actual_owner = target_step.get("owner")
        if actual_owner != expected_owner:
            die(f"audit finding {finding_id} owner mismatch for {target}: expected {expected_owner}, got {actual_owner or '-'}")
        status = target_step.get("status")
        if status == "open":
            current = target_data.get("current")
            if (not isinstance(current, int) or not 0 <= current < len(target_data.get("steps", []))
                    or target_data["steps"][current].get("id") != target
                    or target_data.get("dispatch") != "sent"):
                die(f"audit finding {finding_id} task {target} is open but not durably dispatched")
        elif status in ("active", "claimed", "blocked"):
            pass
        elif status == "done":
            if not target_step.get("artifact") or not target_step.get("artifact_sha256"):
                die(f"audit finding {finding_id} completed task {target} lacks artifact evidence")
        elif status == "rejected":
            if not target_step.get("rejected_reason"):
                die(f"audit finding {finding_id} rejected task {target} lacks a reason")
        else:
            die(f"audit finding {finding_id} task {target} has unusable status {status or '-'}")
    return manifest_path, len(findings), actionable


def chat_command() -> str:
    """Find the co-installed board writer without relying on a reflex PATH.

    A task transition uses its sibling writer already.  Dispatch must use the
    same resolution, otherwise a cron/reflex can durably create an open task
    and fail only when it tries to tell the owner about it.
    """
    configured = os.environ.get("MESH_TASK_CHAT_CMD")
    if configured:
        return configured
    sibling = Path(__file__).resolve().with_name("mesh-chat")
    if sibling.is_file() and os.access(sibling, os.X_OK):
        return str(sibling)
    return "mesh-chat"


def emit(marker: str, body: str) -> bool:
    global LAST_EMIT_ERROR
    LAST_EMIT_ERROR = ""
    command = chat_command()
    # ON-BEHALF-OF (chat-review/mesh-chat-author-misattribution, 2026-09-17): a coordinator
    # boarding a row ABOUT another mind's claim (witness recovery for tg-owned claims boarded
    # as tg@) states the real author via MESH_CHAT_ON_BEHALF_OF; mesh-chat validates it and
    # the self-derive override never rewrites it. Passed explicitly (not just inherited env)
    # so the authorship survives whatever env the board writer is invoked under.
    args = [command]
    obo = os.environ.get("MESH_CHAT_ON_BEHALF_OF", "")
    if obo:
        args += ["--on-behalf-of", obo]
    args.append(f"[{marker}] {body}")
    try:
        result = subprocess.run(args, check=False,
                                text=True, capture_output=True,
                                timeout=EMIT_TIMEOUT_SECONDS)
        if result.returncode == 0:
            return True
        detail = (result.stderr or result.stdout or "no helper output").strip().replace("\n", " ")
        LAST_EMIT_ERROR = f"chat rc={result.returncode}: {detail[:240]}"
        return False
    except subprocess.TimeoutExpired:
        # A hung board writer must not hold chain+owner locks forever.
        LAST_EMIT_ERROR = f"chat emit timeout after {EMIT_TIMEOUT_SECONDS:g}s"
        return False
    except OSError as exc:
        # Callers decide whether a missing board helper is retryable or transition-blocking.
        LAST_EMIT_ERROR = f"chat exec error: {exc}"
        return False


def require_emit(marker: str, body: str) -> None:
    """Refuse a state transition whose hledger-visible board event was not written."""
    if not emit(marker, body):
        die(f"board event failed for [{marker}]; chain state was not changed", 1)


def save(path: Path, data: dict) -> None:
    # Contexts are disposable pointers. Chain states must reach chat.log first.
    previous = None
    accepted = None
    if isinstance(data, dict) and "chain" in data and "steps" in data and path.parent == CHAINS:
        # Fast path (fix-double-replay-emit-timeout): the previous record comes from a
        # per-chain scan, not a full replay — append() replays canonically under lock.
        # Fall back to the full replay only when the fast path declines (gap/oddity).
        previous = latest_chain_record(data["chain"])
        if previous is None and (ROOT / "chat.log").exists():
            records = task_records()
            previous = records.get(data["chain"])
        if previous is None or previous["data"] != data:
            revision = previous["revision"] + 1 if previous else 1
            payload = encode_task_state(data, revision).removeprefix("[task-ledger] ")
            # Never hardcode the sibling writer here: a test harness that sandboxes the board
            # via MESH_TASK_CHAT_CMD must have save() honor it too, or synthetic fixture chains
            # append to the live chat.log (2026-09-16 flood00-04). Same resolution as emit().
            command = chat_command()
            try:
                result = subprocess.run([command, "--task-state", payload],
                                        env=dict(os.environ, MESH_DIR=str(ROOT)),
                                        text=True, capture_output=True, check=False,
                                        timeout=EMIT_TIMEOUT_SECONDS)
            except subprocess.TimeoutExpired:
                die(f"task-state append timed out after {EMIT_TIMEOUT_SECONDS:g}s; cache not changed", 1)
            if result.returncode:
                die(f"task-state append failed; cache not changed: {result.stderr.strip()}", 1)
            if _records is not None:
                _records[data["chain"]] = decode_task_state(payload)
            accepted = revision
    if path.exists():
        try:
            if json.loads(path.read_text(encoding="utf-8")) == data:
                if path.parent == CHAINS and isinstance(data, dict) and "chain" in data:
                    # No new append: the accepted revision is whatever the log holds now.
                    latest = latest_chain_record(data["chain"])
                    if latest is not None and latest["data"] == data:
                        accepted = latest["revision"]
                    if accepted is not None:
                        note_fastpos(data["chain"], accepted)
                return
        except (OSError, UnicodeDecodeError, json.JSONDecodeError):
            pass
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=f".{path.name}.", dir=str(path.parent), text=True)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(data, handle, ensure_ascii=False, indent=2)
            handle.write("\n")
        os.replace(tmp, path)
    finally:
        try:
            os.unlink(tmp)
        except FileNotFoundError:
            pass
    if path.parent == CHAINS and isinstance(data, dict) and "chain" in data and accepted is not None:
        # Cache file is now byte-current with the accepted append.
        note_fastpos(data["chain"], accepted)


@contextlib.contextmanager
def resource_locks(resources: set[str]):
    """Keep a receipt atomic only against its chain and owning mind.

    The task ledger itself serializes and revision-checks its append. Holding
    one coordinator-wide lock around an external board writer turns a delayed
    receipt for one chain into a mesh-wide stop. Chain locks preserve the
    receipt-before-state ordering that prevents stale re-dispatches; owner
    locks preserve cross-chain active-capacity checks. Names are hashed so a
    lock filename never interprets a task or owner identifier as a path.

    Acquisition is BOUNDED: LOCK_EX|LOCK_NB with exponential backoff plus
    pid/time jitter to decorrelate thundering-herd retries. A holder that
    outlives MESH_TASK_LOCK_TIMEOUT refuses the waiter LOUD (lock-timeout)
    instead of hanging it into a timeout(1) kill.
    """
    lock_dir = CHAINS / ".locks"
    lock_dir.mkdir(parents=True, exist_ok=True)
    handles = []
    try:
        for resource in sorted(resources):
            digest = hashlib.sha256(resource.encode("utf-8")).hexdigest()
            handle = (lock_dir / f"{digest}.lock").open("a+", encoding="utf-8")
            handles.append(handle)
            _acquire_bounded(handle, resource)
        yield
    finally:
        for handle in reversed(handles):
            if handle.closed:
                continue
            try:
                fcntl.flock(handle.fileno(), fcntl.LOCK_UN)
            except OSError:
                pass
            handle.close()


def _acquire_bounded(handle, resource: str) -> None:
    """Take one LOCK_EX within LOCK_TIMEOUT_SECONDS or die with lock-timeout."""
    deadline = time.monotonic() + max(0.1, LOCK_TIMEOUT_SECONDS)
    delay = LOCK_POLL_BASE_SECONDS
    while True:
        try:
            fcntl.flock(handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
            return
        except OSError as exc:
            if exc.errno not in (errno.EACCES, errno.EAGAIN):
                raise
        now = time.monotonic()
        if now >= deadline:
            try:
                handle.close()
            except OSError:
                pass
            die(f"lock-timeout waiting for '{resource}' after {LOCK_TIMEOUT_SECONDS:g}s; "
                f"another mesh-task holds it — retry with backoff, do not queue behind it silently", 2)
        jitter = ((time.monotonic_ns() ^ (os.getpid() << 16)) % 1000) / 1000.0 * delay
        time.sleep(delay + jitter)
        delay = min(delay * 2.0, LOCK_POLL_CAP_SECONDS)


def mutation_resources(argv: list[str]) -> set[str]:
    """Return the smallest deterministic lock set for one mutation command."""
    command = argv[0]
    resources = {f"owner:{actor()}"}
    chain_commands = {"create", "take", "independent", "done", "reject", "ignore", "progress",
                      "reprioritize", "annotate", "block", "wait-for", "clear-wait", "resume",
                      "recover", "dispatch", "reschedule", "reassign"}
    if command in chain_commands and len(argv) > 1:
        if command == "dispatch" and argv[1].startswith("--"):
            resources.add("maintenance:dispatch-retry")
        else:
            resources.add(f"chain:{argv[1]}")
    elif command == "reschedule-task" and len(argv) > 1:
        resources.add(f"chain:{argv[1].rsplit('/', 1)[0]}")
    elif command == "reassign-owner" and len(argv) > 2:
        resources.update((f"owner:{normalize_owner(argv[1])}", f"owner:{normalize_owner(argv[2])}"))
    elif command == "reconcile" and len(argv) > 1:
        resources.add(f"owner:{normalize_owner(argv[1])}")
    elif command == "unblock-sweep":
        resources.add(f"sweep:{normalize_owner(argv[1]) if len(argv) > 1 else 'all'}")
    elif command in {"import", "rebuild"}:
        resources.add(f"maintenance:{command}")
    elif command == "route-unowned":
        resources.add("maintenance:route-unowned")
    return resources


def load(chain: str) -> tuple[Path, dict]:
    path = path_for(chain)
    record = fast_chain_record(chain)
    if record is None:
        record = task_records().get(chain)
    if record is not None:
        data = json.loads(json.dumps(record["data"]))
        canonicalize_owners(data)
        return path, data
    die(f"chain '{chain}' is absent from chat.log (create it, or explicitly import existing chains)")


def fast_chain_record(chain: str):
    """Guarded cache read for mutation entry (fix-double-replay-emit-timeout, 2026-09-17):
    load() used to full-replay the 83k-line chat.log (~25s) and then the append
    subprocess replayed it AGAIN (~25s) — every mutation ran ~35s+ against the 30s
    emit timeout with no lock holder at all. This returns the chain's record from
    the disposable chain cache when the log is provably untouched since the last
    successful save (same inode + size + mtime-ns, recorded beside the revision the
    append gate accepted). ANY mismatch — or a missing/stale sidecar — falls back to
    the canonical replay. A wrong answer here cannot corrupt: save()/append() still
    revision- and transition-check under lock, so staleness surfaces as a clear
    ReplayError retry, never a silent write."""
    try:
        sidecar = CHAINS / ".fastpos.json"
        pos = json.loads(sidecar.read_text(encoding="utf-8"))
        entry = pos.get("rev", {}).get(chain)
        logpos = pos.get("log", {})
        log = ROOT / "chat.log"
        st = log.stat()
        if (entry is None or logpos.get("ino") != st.st_ino
                or logpos.get("size") != st.st_size
                or logpos.get("mtime_ns") != st.st_mtime_ns):
            return None
        data = json.loads(path_for(chain).read_text(encoding="utf-8"))
        if not isinstance(data, dict) or data.get("chain") != chain:
            return None
        return {"revision": entry, "data": data}
    except (OSError, ValueError, TypeError, KeyError):
        return None


def note_fastpos(chain: str, revision: int) -> None:
    """Record the accepted revision + log identity after a successful save."""
    try:
        log = ROOT / "chat.log"
        st = log.stat()
        sidecar = CHAINS / ".fastpos.json"
        try:
            pos = json.loads(sidecar.read_text(encoding="utf-8"))
            if not isinstance(pos, dict):
                pos = {}
        except (OSError, ValueError):
            pos = {}
        rev = pos.get("rev")
        if not isinstance(rev, dict):
            rev = {}
        rev[chain] = revision
        pos["rev"] = rev
        pos["log"] = {"ino": st.st_ino, "size": st.st_size, "mtime_ns": st.st_mtime_ns}
        tmp_fd, tmp = tempfile.mkstemp(prefix=".fastpos.", dir=str(CHAINS), text=True)
        try:
            with os.fdopen(tmp_fd, "w", encoding="utf-8") as handle:
                json.dump(pos, handle)
                handle.write("\n")
            os.replace(tmp, sidecar)
        finally:
            try:
                os.unlink(tmp)
            except FileNotFoundError:
                pass
    except OSError:
        pass


def step_for(data: dict, ref: str) -> tuple[int, dict]:
    for index, step in enumerate(data["steps"]):
        if ref in (str(index + 1), step["slug"], step["id"]):
            return index, step
    die(f"step '{ref}' is not in chain '{data['chain']}'")


def post_task(data: dict, index: int) -> bool:
    step = data["steps"][index]
    # The chain owner is already an exact mind/window assignment.  Emit the
    # bare-window grammar so non-code owners (for example haunt) are routed
    # directly; mesh-task/<window> is the slash-form code route and redirects
    # non-code windows to a code-capable worker.
    assignment = f" → owner: {step['owner']}" if step.get("owner") else ""
    owner_tag = f", owner:{step['owner']}" if step.get("owner") else ""
    independent_note = (f" independent-step: {step['independent_reason']}"
                        if independent_marked(step) else "")
    if has_task_tag(step, "audit-followthrough"):
        settlement = (
            f" Run: mesh-task take {data['chain']} {step['slug']}; write <artifact>.findings.json, then "
            f"`mesh-task done {data['chain']} {step['slug']} <artifact> [result]`. "
            "Every finding must map to an exact task+owner or carry a non-actionable reason; "
            "this tagged task cannot reject to bypass the finding manifest."
        )
    else:
        settlement = (
            f" Run: mesh-task take {data['chain']} {step['slug']};"
            f" close in the structured ledger with either `mesh-task done {data['chain']} {step['slug']} <artifact> [result]`"
            f" or `mesh-task reject {data['chain']} {step['slug']} <reason>`."
        )
    return emit("task", f"{step['id']}{assignment} — {step['description']}{independent_note}"
                f"{metadata_suffix(data, step)}"
                f"{settlement}"
                " A board [done] line alone does not close the task ledger."
                f" task:{step['id']}, ask:{data.get('ask') or '-'}{owner_tag}, status:open")


def post_autoland_task(data: dict, completed: dict) -> bool:
    """Ask the genome to land the work represented by a completed ledger step.

    The board post is always paired with a ledger chain minted at post time
    (see mint_autoland_chain): the completed chain remains authoritative, while
    the genome gets an actionable landing request with enough provenance to
    write a useful commit message. Generated landing requests are excluded so
    settling one cannot create an endless auto-land → done → auto-land loop.
    """
    task_id = completed["id"]
    if task_id.startswith("autoland/") or completed.get("slug", "").startswith("autoland-"):
        return True
    result = completed.get("result") or completed.get("description") or "completed ledger work"
    scope = metadata_suffix(data, completed).strip() or "scope=repository work described by the task"
    suggested = f"Implement {task_id}: {result}"
    suggested_quoted = json.dumps(suggested, ensure_ascii=False)
    land_id = f"autoland/{task_id}/land"
    body = (f"autoland/{task_id} → owner: genome — land completed ledger work. "
            f"Suggested commit subject: {suggested_quoted}; "
            f"Why/context: {completed.get('description', 'completed ledger task')}; "
            f"Scope: {scope}; "
            f"Verification: Artifact: {completed['artifact']} "
            f"artifact-sha256:{completed['artifact_sha256']}; "
            f"ledger:{land_id} (chain autoland/{task_id} minted at post time); "
            f"task:autoland/{task_id}, owner:genome, status:open")
    return emit("task", body)


def mint_autoland_chain(data: dict, completed: dict) -> bool:
    """Mint the ledger chain for a board autoland post at post time.

    Every board [task] autoland/… post gets a matching chain
    autoland/<completed-step-id> with a single genome-owned `land` step, so the
    landing obligation is tracked from birth instead of surfacing only when a
    witness review notices the board-only post. Idempotent: an existing chain
    file is left alone. Generated landing requests never mint (loop guard).
    """
    task_id = completed["id"]
    if task_id.startswith("autoland/") or completed.get("slug", "").startswith("autoland-"):
        return True
    chain = f"autoland/{task_id}"
    try:
        check_name(chain, "chain")
    except SystemExit:
        return False
    land_path = path_for(chain)
    if land_path.exists():
        return True
    try:
        priority = int(completed.get("priority", DEFAULT_PRIORITY))
    except (TypeError, ValueError):
        priority = DEFAULT_PRIORITY
    description = (f"Land completed ledger step {task_id}: "
                   f"{completed.get('result') or completed.get('description') or 'completed ledger work'}. "
                   f"Artifact: {completed.get('artifact')} "
                   f"artifact-sha256:{completed.get('artifact_sha256')}. "
                   f"Board post: autoland/{task_id}.")
    land_data = {"version": 2, "chain": chain, "ask": data.get("ask"),
                 "created": now(), "status": "open", "current": 0,
                 "steps": [{"id": f"{chain}/land", "owner": "genome", "slug": "land",
                            "description": description, "priority": priority,
                            "status": "open"}]}
    save(land_path, land_data)
    return True


def ensure_autoland_task(path: Path, data: dict, completed: dict) -> bool:
    """Post and durably record the landing request, retrying incomplete receipts."""
    if completed.get("autoland_task_posted"):
        return True
    if not mint_autoland_chain(data, completed):
        return False
    if not post_autoland_task(data, completed):
        return False
    completed["autoland_task_posted"] = now()
    save(path, data)
    return True


def handoff(data: dict, index: int, completed: dict) -> bool:
    step = data["steps"][index]
    if not step.get("owner"):
        return emit("handoff", f"{data['chain']}: {completed['id']} completed with artifact "
                    f"{completed['artifact']}; successor task:{step['id']} awaits assignment")
    if completed.get("status") == "rejected":
        evidence = (f"predecessor {completed['id']} is rejected; reason="
                    f"{completed.get('rejected_reason', 'missing')}")
    else:
        evidence = f"{completed['id']} completed with artifact {completed['artifact']}"
    text = (f"chain {data['chain']} advanced: {evidence}; next is {step['id']} for mind {step['owner']}. "
            f"Expected scope:{metadata_suffix(data, step)} "
            f"Run: mesh-task take {data['chain']} {step['slug']}; verify the artifact before acting. "
            "After recording the handoff, reset the recipient context with /clear and submit it "
            "through tmux: tmux send-keys -t <pane> -l '/clear'; tmux send-keys -t <pane> C-m "
            "(carriage return, the submit key).")
    command = os.environ.get("MESH_TASK_HANDOFF_CMD", "mesh-handoff")
    try:
        result = subprocess.run([command, step["owner"], text], check=False,
                                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        return False
    if result.returncode != 0:
        return False
    return emit("handoff", f"{data['chain']}: {completed['id']} → {step['id']} ({step['owner']})")


def dispatch(path: Path, data: dict) -> None:
    """Deliver the current successor, retaining a loud retryable failure on disk."""
    index = data["current"]
    if index == 0:
        ok = post_task(data, index)
    else:
        ok = handoff(data, index, data["steps"][index - 1]) and post_task(data, index)
    if ok:
        data.pop("dispatch_error", None)
        data["dispatch"] = "sent"
        # A delivered task is queued for its exact owner, not unowned work.  If
        # the owner does not take it before this receipt window expires, audit
        # turns it into a recovery candidate and witness re-dispatches it.
        # Preserve its first eligible time across redeliveries so new arrivals
        # cannot repeatedly reset an older task's place in the queue.
        data["steps"][index].setdefault("queued_at", now())
        data["steps"][index]["dispatched_at"] = now()
        data["steps"][index]["dispatch_until"] = future()
        save(path, data)
        return
    data["dispatch"] = "failed"
    detail = f" ({LAST_EMIT_ERROR})" if LAST_EMIT_ERROR else ""
    data["dispatch_error"] = f"{now()}: handoff or board task post failed{detail}; run mesh-task dispatch {data['chain']}"
    save(path, data)
    emit("yield", f"{data['chain']}: successor {data['steps'][index]['id']} was NOT dispatched — {data['dispatch_error']}")
    die(data["dispatch_error"], 1)


def create(chain: str, plan: str, ask: str = "") -> None:
    check_name(chain, "chain")
    path = path_for(chain)
    if path.exists() or chain in task_records():
        die(f"chain '{chain}' already exists; refusing to overwrite")
    rows = []
    metadata = {}
    origin = {}
    for lineno, raw in enumerate(Path(plan).read_text(encoding="utf-8").splitlines(), 1):
        stripped = raw.strip()
        if not stripped:
            continue
        if stripped.startswith("#"):
            header = stripped[1:].strip()
            key, separator, value = header.partition("=")
            key = key.strip()
            if separator and key in TASK_METADATA_KEYS:
                metadata[key] = value.strip()
            elif key.startswith("origin."):
                field = key[7:]
                if field not in ORIGIN_FIELDS:
                    die(f"unknown origin header '{key}'")
                if field in origin:
                    die(f"duplicate origin header '{key}'")
                if not separator:
                    die(f"origin header '{key}' requires a value")
                origin[field] = value.strip()
            continue
        fields = raw.split("\t", 3)
        if len(fields) == 3:
            owner, slug, description = (x.strip() for x in fields)
            priority = DEFAULT_PRIORITY
        elif len(fields) == 4:
            owner, slug, raw_priority, description = (x.strip() for x in fields)
            try:
                priority = int(raw_priority)
            except ValueError:
                die(f"plan line {lineno} has a non-integer priority")
        else:
            die(f"plan line {lineno} must be owner<TAB>step-slug<TAB>description or owner<TAB>step-slug<TAB>priority<TAB>description")
        if owner and owner != "-":
            check_name(owner, f"owner on line {lineno}")
            owner = normalize_owner(owner)
        else:
            owner = None
        check_name(slug, f"step on line {lineno}")
        if not description:
            die(f"plan line {lineno} has an empty description")
        description = autonomous_task_description(description)
        if any(s["slug"] == slug for s in rows):
            die(f"plan repeats step slug '{slug}'")
        rows.append({"id": f"{chain}/{slug}", "owner": owner, "slug": slug,
                     "description": description, "priority": priority,
                     "status": "open", **metadata})
    if not rows:
        die("plan has no steps")
    if origin and set(origin) != set(ORIGIN_FIELDS):
        die("origin envelope requires all six nonempty fields")
    if origin and any(not value for value in origin.values()):
        die("origin envelope requires all six nonempty fields")
    if origin:
        for existing_chain, record in task_records().items():
            existing = record['data'].get('origin') or {}
            if existing.get('source') == origin['source']:
                die(f"origin.source '{origin['source']}' already exists in chain '{existing_chain}' "
                    f"(status: {record['data'].get('status', 'unknown')})")
    if ask.startswith("ask:"): ask = ask[4:]
    if ask: check_name(ask, "ask")
    data = {"version": 2, "chain": chain, "ask": ask or None, "created": now(), "status": "open",
            "current": 0, "steps": rows}
    if metadata:
        data["task_context"] = metadata
    if origin:
        data["origin"] = origin
    save(path, data)
    dispatch(path, data)
    print(f"created {chain}: {len(rows)} step(s) → {path}")


def take(chain: str, ref: str) -> None:
    path, data = load(chain)
    index, step = step_for(data, ref)
    independent = independent_ready(data, index, step)
    if index != data["current"] and not independent:
        die(f"step {step['id']} is not the current step (current: {data['steps'][data['current']]['id']})")
    if not step.get("owner"):
        candidate = actor()
        check_name(candidate, "claiming mind")
        if candidate == "mesh-task":
            die("set MESH_TASK_ACTOR to the mind claiming this unassigned task")
        step["owner"] = candidate
    require_owner(step)
    if step.get("waiting_for"):
        die(f"step {step['id']} is waiting for {step['waiting_for']}; it is not claimable")
    if step["status"] == "active":
        print(f"already active {step['id']}")
        return
    if step["status"] != "open" or (data["status"] not in ("open", "active")
                                      and not independent):
        die(f"step {step['id']} is {step['status']}; it is not claimable")
    active = active_contexts(step["owner"], step["id"])
    # A blocked parent is made actionable by an exact-owner resolver.  The
    # resolver must remain takeable even while its owner has unrelated active
    # work; otherwise the capacity guard strands the very recovery path that
    # is supposed to clear the parent.
    resolver = data.get("chain", "").startswith("unblock/")
    if len(active) >= active_task_limit() and not resolver:
        die(f"owner {step['owner']} already has active task {active[0].get('task', 'unknown')}; "
            "settle or type-block it before taking another")
    step["status"] = "active"
    step["started"] = now(); step["lease_until"] = future(); step["last_progress"] = step["started"]
    data["status"] = "active"
    bypass_note = (f" independent of blocked {data['steps'][data['current']]['id']}:"
                   f" {step['independent_reason']}" if independent else "")
    require_emit("taking", f"{step['id']}: {ACTOR} — {step['description']}{bypass_note}"
                 f"{metadata_suffix(data, step)}"
                 f" ; task:{step['id']}, ask:{data.get('ask') or '-'}, owner:{step['owner']}, lease:{step['lease_until']}, status:claimed")
    save(path, data)
    update_context(step["owner"], data["chain"], step)
    print(f"claimed {step['id']}")


def mark_independent(chain: str, ref: str, reason: str) -> None:
    """Let the exact owner attest that a later open step can proceed alone."""
    reason = " ".join(reason.split())
    if not reason:
        die("independence reason is required")
    path, data = load(chain)
    index, step = step_for(data, ref)
    require_owner(step)
    if index <= data["current"]:
        die(f"step {step['id']} is not later than the current chain head")
    if data.get("status") not in ("blocked", "active"):
        die(f"chain {chain} is {data.get('status', 'unknown')}; it cannot expose independent work")
    if data["steps"][data["current"]].get("status") != "blocked":
        die("independent pickup may be marked only while the current step is blocked")
    if step.get("status") != "open" or step.get("waiting_for"):
        die(f"step {step['id']} is not an ungated open step")
    if independent_marked(step):
        if step["independent_reason"] == reason:
            print(f"already independent {step['id']}: {reason}")
            return
        die(f"step {step['id']} already has a different independence reason")
    step["independent_reason"] = reason
    step["independent_at"] = now()
    step["independent_dispatch"] = "pending"
    save(path, data)
    if not post_task(data, index):
        step["independent_dispatch"] = "failed"
        step["independent_dispatch_error"] = f"{now()}: board task post failed"
        save(path, data)
        die(f"independent step {step['id']} is recorded but task delivery failed", 1)
    step["dispatched_at"] = now()
    step["independent_dispatch"] = "sent"
    step.pop("independent_dispatch_error", None)
    save(path, data)
    update_context(step["owner"], data["chain"], step)
    print(f"independent step available {step['id']}: {reason}")


def done(chain: str, ref: str, artifact: str, result: str) -> None:
    path, data = load(chain)
    index, step = step_for(data, ref)
    require_owner(step)
    artifact_named = Path(artifact).expanduser().resolve()
    artifact_path = resolve_node_local(artifact_named)
    if step["status"] == "done":
        # An already-done row may hold EITHER spelling (rows are not rewritten when a corpus moves), so
        # compare the resolved form of what it recorded rather than the raw string.
        recorded = resolve_node_local(Path(step.get("artifact") or ".").expanduser())
        if recorded == artifact_path and step.get("artifact_sha256") == artifact_digest(artifact_path):
            if not ensure_autoland_task(path, data, step):
                emit("yield", f"{step['id']}: completed, but genome auto-land task was not posted; retry the landing request")
                print(f"mesh-task: WARNING: genome auto-land task was not posted for {step['id']}", file=sys.stderr)
            resume_cleared_parent(data, step)
            print(f"already done {step['id']} (same artifact)"); return
        die(f"step {step['id']} is already done with a different artifact")
    independent = index != data["current"] and independent_marked(step)
    if (index != data["current"] and not independent) or step["status"] != "active":
        die(f"step {step['id']} is not active; take it before settling")
    if not artifact_path.exists():
        die(f"artifact does not exist: {artifact} (a claim is not complete without evidence)")
    reject_ephemeral_artifact_path(artifact_path)
    validate_artifact_scope(data, step, artifact_named)
    validate_implementation_artifact(step, artifact_path, result)
    if has_task_tag(step, "audit-followthrough"):
        manifest_path, finding_count, actionable_count = validate_audit_findings(step, artifact_path)
        step.update(finding_manifest=str(manifest_path),
                    finding_manifest_sha256=artifact_digest(manifest_path),
                    finding_count=finding_count,
                    actionable_finding_count=actionable_count)
    step.update(status="done", finished=now(), artifact=str(artifact_path),
                artifact_sha256=artifact_digest(artifact_path), result=result or "verified")
    if independent:
        data["status"] = status_from_current(data)
    else:
        next_index = index + 1
        while next_index < len(data["steps"]) and data["steps"][next_index].get("status") in (
                "done", "ignored"):
            next_index += 1
        if next_index >= len(data["steps"]):
            data["status"] = "complete"
            data["current"] = len(data["steps"]) - 1
        elif data["steps"][next_index].get("status") == "rejected":
            data["status"] = "rejected"
            data["current"] = next_index
        else:
            data["current"] = next_index
            data["status"] = status_from_current(data)
            data["dispatch"] = "waiting" if data["steps"][next_index].get("waiting_for") else "pending"
    require_emit("done", f"{step['id']}: artifact={artifact_path} — {step['result']}"
                 f"{metadata_suffix(data, step)}"
                 f" ; task:{step['id']}, ask:{data.get('ask') or '-'}, owner:{step['owner']}, artifact-sha256:{step['artifact_sha256']}, status:done")
    save(path, data)
    if not ensure_autoland_task(path, data, step):
        emit("yield", f"{step['id']}: completed, but genome auto-land task was not posted; retry the landing request")
        print(f"mesh-task: WARNING: genome auto-land task was not posted for {step['id']}", file=sys.stderr)
    update_context(step["owner"], data["chain"], step, remove=True)
    release_waiters(step["id"])
    resume_cleared_parent(data, step)
    if independent:
        print(f"settled independent step {step['id']}; current remains {data['steps'][data['current']]['id']}")
        return
    if data["status"] == "complete":
        print(f"complete {chain}: final artifact {artifact_path}")
        return
    if data["steps"][data["current"]].get("status") != "open":
        print(f"settled {step['id']}; current step remains {data['steps'][data['current']]['id']} "
              f"[{data['steps'][data['current']]['status']}]")
        return
    if data["steps"][data["current"]].get("waiting_for"):
        print(f"settled {step['id']}; current step waits for {data['steps'][data['current']]['waiting_for']}")
        return
    dispatch(path, data)
    print(f"settled {step['id']}; handed off {data['steps'][next_index]['id']} to {data['steps'][next_index]['owner']}")


def progress(chain: str, ref: str, artifact: str, next_action: str, deadline: str) -> None:
    path, data = load(chain); index, step = step_for(data, ref); require_owner(step)
    if ((index != data["current"] and not independent_marked(step))
            or step["status"] != "active"):
        die(f"step {step['id']} is not active")
    artifact_named = Path(artifact).expanduser().resolve()
    artifact_path = resolve_node_local(artifact_named)
    if not artifact_path.exists(): die(f"progress artifact does not exist: {artifact}")
    validate_artifact_scope(data, step, artifact_named)
    step.update(last_progress=now(), lease_until=future(), progress_artifact=str(artifact_path),
                next_action=next_action, next_update=deadline)
    require_emit("progress", f"{step['id']}: artifact={artifact_path} next={next_action} update={deadline} lease={step['lease_until']}"
                 f"{metadata_suffix(data, step)} ; task:{step['id']}, ask:{data.get('ask') or '-'}")
    save(path, data); update_context(step["owner"], data["chain"], step)
    print(f"renewed {step['id']} until {step['lease_until']}")


def reprioritize(chain: str, ref: str, raw_priority: str) -> None:
    path, data = load(chain)
    index, step = step_for(data, ref)
    require_owner_or_coordinator(step)
    try:
        priority = int(raw_priority)
    except ValueError:
        die(f"priority must be an integer: {raw_priority!r}")
    previous = priority_of(step)
    if previous == priority:
        print(f"priority unchanged {step['id']}={priority}")
        return
    step["priority"] = priority
    require_emit("priority", f"{step['id']}: {previous} -> {priority} by {ACTOR}"
                 f" ; task:{step['id']}, owner:{step.get('owner') or '-'}, priority:{priority}")
    save(path, data)
    print(f"reprioritized {step['id']}: {previous} -> {priority}")


def reassign_owner(old_owner: str, new_owner: str, reason: str) -> None:
    """Move unfinished work from an absent owner without breaking unblock identity."""
    old_owner = normalize_owner(check_name(old_owner, "old owner"))
    new_owner = normalize_owner(check_name(new_owner, "new owner"))
    reason = reason.strip()
    if not reason:
        die("reassignment reason is required")
    if old_owner == new_owner:
        die("old and new owner must differ")
    if actor() != COORDINATOR:
        die(f"coordinator required: coordinator={COORDINATOR} actor={actor()}")
    snapshots = [(path, data) for path, data in chain_states()]
    terminal = {"done", "rejected", "ignored"}
    selected = []
    blocked_parents = {}
    for path, data in snapshots:
        for index, step in enumerate(data.get("steps", [])):
            if step.get("owner") != old_owner or step.get("status") in terminal:
                continue
            if step.get("status") in ("active", "claimed"):
                die(f"refusing to reassign active task {step['id']}; settle or block it first")
            selected.append((path, data, index))
            if (step.get("status") == "blocked" and not data.get("chain", "").startswith("unblock/")
                    and index == data.get("current")):
                blocked_parents[data["chain"]] = unblock_identity(new_owner, step, data["chain"])
    if not selected:
        print(f"reassigned owner={old_owner} -> {new_owner} tasks=0")
        return
    changed = []
    dispatch_failures = []
    for path, data in snapshots:
        parent_identity = blocked_parents.get(data.get("unblock_parent"))
        if parent_identity:
            data["unblock_for"] = parent_identity
        touched = False
        for step in data.get("steps", []):
            if step.get("owner") == old_owner and step.get("status") not in terminal:
                step["owner"] = new_owner
                touched = True
        if not touched and not parent_identity:
            continue
        index = data.get("current")
        if touched and isinstance(index, int) and 0 <= index < len(data.get("steps", [])):
            step = data["steps"][index]
            if step.get("owner") == new_owner and step.get("status") == "open":
                data["dispatch"] = "pending"
                step.pop("dispatched_at", None)
                step.pop("dispatch_until", None)
        require_emit("reassigned", f"{data['chain']}: owner {old_owner} -> {new_owner}; reason={reason}"
                     f" ; task:{data.get('chain')}, owner:{new_owner}, status:{data.get('status', 'open')}")
        save(path, data)
        changed.append((path, data))
    for path, data in changed:
        index = data.get("current")
        if (isinstance(index, int) and 0 <= index < len(data.get("steps", []))
                and data.get("steps", [])[index].get("owner") == new_owner
                and data.get("steps", [])[index].get("status") == "open"
                and data.get("dispatch") == "pending"):
            # One chain's board post failing must not strand the rest mid-loop
            # (measured: 11 of 16 re-dispatches sent, then a transient post
            # failure aborted the run leaving 5 pending with no summary).
            # Collect failures and report them all at the end, still loud.
            try:
                dispatch(path, data)
            except SystemExit as exc:
                dispatch_failures.append((data.get("chain", str(path)), exc.code))
    if dispatch_failures:
        for chain, code in dispatch_failures:
            print(f"reassign dispatch failed {chain} rc={code}; run mesh-task dispatch {chain}", file=sys.stderr)
        die(f"reassigned {len(changed)} tasks with {len(dispatch_failures)} dispatch failures (ownership moved; re-run mesh-task dispatch per chain above)")
    for path, data in changed:
        if data.get("chain", "").startswith("unblock/"):
            continue
        for step in data.get("steps", []):
            if step.get("status") == "blocked" and step.get("owner") == new_owner:
                ensure_unblock_task(data, step)
    reconcile_context(old_owner)
    reconcile_context(new_owner)
    print(f"reassigned owner={old_owner} -> {new_owner} tasks={len(changed)}")


def _is_mind_window(name: str) -> bool:
    """tmux window names are not all minds: a stray shell window (e.g. `bash`)
    sorts before every mind lane and would otherwise capture routed work into
    an owner that never reads the board (measured 2026-09-11: 16 unblock/bash
    orphans, all OPEN_UNOWNED forever). Mirror the mind roster filter
    mesh-dash uses: never route to a shell/reflex/monitor pane."""
    if name in {"bash", "shell", "sh", "reflex"}:
        return False
    if name.startswith("mon:"):
        return False
    return True


def reassign(chain: str, new_owner: str, reason: str) -> None:
    """Move one queued chain to a live mind without breaking unblock identity.

    Coordinator-only load-shedding: a busy owner's queued (never active)
    chain moves to a live mind, so per-owner serial discipline (the dispatch
    queue suppresses an owner's rows while it holds an active claim) cannot
    wedge routable work behind one slow claim. Active, non-open, and
    prerequisite-gated steps are refused; settle, block, or clear-wait those
    first. The new owner must staff a live mind window, or the move would
    mint a fresh unroutable row.
    """
    if actor() != COORDINATOR:
        die(f"coordinator required: coordinator={COORDINATOR} actor={actor()}")
    new_owner = normalize_owner(check_name(new_owner, "new owner"))
    reason = reason.strip()
    if not reason:
        die("reassignment reason is required")
    path, data = load(chain)
    index = data.get("current")
    if not isinstance(index, int) or not 0 <= index < len(data.get("steps", [])):
        die(f"chain {chain} has no current step")
    step = data["steps"][index]
    old_owner = normalize_owner(step.get("owner") or "")
    if not old_owner:
        die(f"chain {chain} current step has no owner")
    if old_owner == new_owner:
        die("old and new owner must differ")
    if step.get("status") in ("active", "claimed", "running"):
        die(f"refusing to reassign active task {step['id']}; settle or block it first")
    if step.get("status") != "open":
        die(f"refusing to reassign non-open task {step['id']} status={step.get('status')}")
    if step.get("waiting_for"):
        die(f"refusing to reassign prerequisite-gated task {step['id']}; clear-wait or complete the prerequisite first")
    if new_owner not in live_owners() or not _is_mind_window(new_owner):
        die(f"new owner {new_owner} staffs no live mind window; refusing to mint an unroutable row")
    step["owner"] = new_owner
    data["dispatch"] = "pending"
    step.pop("dispatched_at", None)
    step.pop("dispatch_until", None)
    require_emit("reassigned", f"{data['chain']}: owner {old_owner} -> {new_owner}; reason={reason}"
                 f" ; task:{data.get('chain')}, owner:{new_owner}, status:{data.get('status', 'open')}")
    save(path, data)
    if data.get("dispatch") == "pending":
        try:
            dispatch(path, data)
        except SystemExit as exc:
            die(f"reassigned {step['id']} but dispatch failed rc={exc.code}; run mesh-task dispatch {chain}")
    reconcile_context(old_owner)
    reconcile_context(new_owner)
    print(f"reassigned {step['id']} owner={old_owner} -> {new_owner}")


# Declared ownerless-routing table (operator-witness-dispatch-e051d618):
# chain-prefix/slug evidence for routing an ownerless step to an exact owner.
# Every entry is evidence-backed (a prior same-class chain owned by that window);
# anything without a hit is reported, never silently defaulted.
ROUTE_UNOWNED_TABLE = (
    ("health-warning", None, "health"),            # health-warning/*/triage -> health
    ("health-stale-systemd-doctor", None, "health"),
    ("literature-", None, "discover"),             # literature-*/... -> discover
    (None, "junkload", "health"),                  # *-junkload-*/... load axis -> health
    (None, "junk-load", "health"),                 # incl. typo slug /riage chain
    (None, "analyze-observation", "health"),       # 2*-window analyze-observation -> health
)
ROUTE_UNOWNED_STALE_DAYS = 7


def suggest_route_owner(chain: str, step: dict) -> tuple[str | None, str]:
    """Return (owner|None, reason) for one ownerless step; None means mind-decides."""
    slug = step.get("slug", "")
    lowered = f"{chain} {slug} {step.get('id', '')}".lower()
    for prefix, infix, owner in ROUTE_UNOWNED_TABLE:
        if prefix is not None and not chain.startswith(prefix):
            continue
        if infix is not None and infix not in lowered:
            continue
        return owner, f"table-hit prefix={prefix} infix={infix}"
    return None, "no-table-hit"


def route_unowned(apply: bool = False, limit: int = 0) -> None:
    """Distribute ownerless queued steps to exact owners (dry-run unless --apply).

    Dry-run prints one REVIEW|ROUTE|STALE-REVIEW row per ownerless current step
    and mutates nothing. --apply assigns table hits via the coordinator path
    (open, non-active, non-gated steps only; new owner must staff a live mind
    window) and reports the rest. Anything older than ROUTE_UNOWNED_STALE_DAYS
    without a table hit renders STALE-REVIEW for a mind to reject or re-queue.
    """
    if apply and actor() != COORDINATOR:
        die(f"coordinator required: coordinator={COORDINATOR} actor={actor()}")
    live = live_owners() if apply else set()
    now = time.time()
    routed = 0
    for _, data in chain_states():
        if data.get("status") not in ("open", "active", "blocked"):
            continue
        index = data.get("current")
        if not isinstance(index, int) or not 0 <= index < len(data.get("steps", [])):
            continue
        step = data["steps"][index]
        if step.get("owner") or step.get("status") != "open" or step.get("waiting_for"):
            continue
        owner, reason = suggest_route_owner(data["chain"], step)
        stamp = step.get("queued_at") or step.get("dispatched_at") or data.get("created", "")
        age_days = (now - epoch_iso(stamp)) / 86400 if epoch_iso(stamp) else -1
        if owner is None:
            verdict = "STALE-REVIEW" if 0 <= age_days > ROUTE_UNOWNED_STALE_DAYS else "REVIEW"
            print(f"{verdict}\t{step['id']}\t-\t{reason} age_days={age_days:.1f}")
            continue
        if not apply:
            print(f"ROUTE\t{step['id']}\t{owner}\t{reason}")
            continue
        if owner not in live or not _is_mind_window(owner):
            print(f"REVIEW\t{step['id']}\t{owner}\tunroutable: no live mind window; {reason}")
            continue
        path, fresh = load(data["chain"])
        fstep = fresh["steps"][fresh["current"]]
        if fstep.get("owner") or fstep.get("status") != "open" or fstep.get("waiting_for"):
            print(f"REVIEW\t{step['id']}\t{owner}\traced: step changed under scan")
            continue
        fstep["owner"] = owner
        fresh["dispatch"] = "pending"
        fstep.pop("dispatched_at", None)
        fstep.pop("dispatch_until", None)
        require_emit("routed", f"{fresh['chain']}: owner - -> {owner}; reason=route-unowned {reason}"
                     f" ; task:{fresh['chain']}, owner:{owner}, status:{fresh.get('status', 'open')}")
        save(path, fresh)
        reconcile_context(owner)
        print(f"ROUTED\t{step['id']}\t{owner}\t{reason}")
        routed += 1
        if limit and routed >= limit:
            break
    if apply:
        print(f"route-unowned: routed={routed}")


def annotate(chain: str, ref: str, tags: str, design_artifact: str) -> None:
    path, data = load(chain)
    index, step = step_for(data, ref)
    require_owner_or_coordinator(step)
    tags = tags.strip()
    design_artifact = design_artifact.strip()
    if not tags or not design_artifact:
        die("tags and design_artifact are required")
    for tag in tags.split(','):
        check_name(tag.strip(), "tag")
    previous = (step.get("tags"), step.get("design_artifact"))
    if previous == (tags, design_artifact):
        print(f"annotation unchanged {step['id']}")
        return
    step.update(tags=tags, design_artifact=design_artifact)
    require_emit("annotated", f"{step['id']}: tags={tags} design_artifact={design_artifact} by {ACTOR}"
                 f" ; task:{step['id']}, owner:{step.get('owner') or '-'}, tags:{tags}")
    save(path, data)
    print(f"annotated {step['id']}: tags={tags} design_artifact={design_artifact}")


def block(chain: str, ref: str, reason_type: str, needs: str, retry: str) -> None:
    path, data = load(chain)
    index, step = step_for(data, ref)
    require_owner(step)
    if reason_type not in ("operator-input", "external-event", "dependency", "capability", "safety", "experiment-contract"):
        die("blocked reason must be one of operator-input, external-event, dependency, capability, safety, experiment-contract")
    if ((index != data["current"] and not independent_marked(step))
            or step["status"] != "active"):
        die(f"step {step['id']} is not active; take it before blocking")
    epoch = int(step.get("block_epoch", 0)) + 1
    step.update(status="blocked", blocked=now(), block_epoch=epoch, parent_chain=data["chain"],
                blocker_type=reason_type, needs=needs, retry=retry)
    data["status"] = status_from_current(data)
    require_emit("blocked", f"{step['id']}: reason={reason_type} needs={needs} retry={retry} ; task:{step['id']}, ask:{data.get('ask') or '-'}")
    save(path, data)
    update_context(step["owner"], data["chain"], step)
    unblock_chain = ensure_unblock_task(data, step)
    if unblock_chain:
        emit("task", f"{step['id']}: unblock task available at {unblock_chain}/resolve; "
             f"resume only after its artifact-backed result")
    print(f"blocked {step['id']}")


def registry_invariants():
    """Parse AGENTS.md's ```invariant-registry block. Returns (rev, [row dicts])."""
    import re as _re
    root = Path(os.environ.get("MESH_GENOME", str(Path(__file__).resolve().parent.parent)))
    text = (root / "AGENTS.md").read_text()
    m = _re.search(r"```invariant-registry\n(.*?)```", text, flags=_re.S)
    if not m:
        die("no ```invariant-registry block in AGENTS.md")
    block = m.group(1)
    rm = _re.search(r"^rev:\s*(\S+)", block, flags=_re.M)
    rows = []
    for ln in block.splitlines():
        if not ln.startswith("id="):
            continue
        rows.append(dict(p.split("=", 1) for p in ln.split(" | ") if "=" in p))
    return (rm.group(1) if rm else "unknown"), rows


def preflight(chain: str, ref: str) -> None:
    """Gate a resource-blocker claim against the invariant registry (read-only).
    A blocked capability/dependency step whose needs/retry names a registry domain must cite
    the registry rev AND record the invariant's preflight check in its artifact. Exit 0 = pass
    (or not-applicable), 2 = RED (claim invalid) or UNKNOWN (conflicting rows route to owner)."""
    path, data = load(chain)
    _, step = step_for(data, ref)
    if step.get("status") != "blocked" or step.get("blocker_type") not in ("capability", "dependency"):
        print(f"preflight: {step['id']} n/a (not a blocked resource claim)")
        return
    rev, rows = registry_invariants()
    hay = f"{step.get('needs', '')} {step.get('retry', '')}".lower()
    matched = [r for r in rows if r.get("id", "").split(".")[0].lower() in hay]
    if not matched:
        print(f"preflight: {step['id']} n/a (no registry domain named)")
        return
    by_scope_domain: dict = {}
    for r in rows:
        by_scope_domain.setdefault((r.get("scope"), r.get("id", "").split(".")[0]), []).append(r)
    for (scope, domain), group in by_scope_domain.items():
        if len({g.get("preflight") for g in group}) > 1 and len({g.get("precedence") for g in group}) == 1:
            die(f"preflight UNKNOWN: conflicting registry rows for {scope}/{domain} at equal "
                f"precedence — route to {group[0].get('owner')} window, both rows preserved")
    art = step.get("artifact") or step.get("progress_artifact")
    body = ""
    if art:
        for cand in (Path(str(art)),
                     Path(os.environ.get("MESH_GENOME", str(Path(__file__).resolve().parent.parent))) / str(art)):
            try:
                body = cand.read_text()
                break
            except OSError:
                continue
    problems = []
    if f"rev: {rev}" not in body and f"rev:{rev}" not in body and rev not in body:
        problems.append(f"artifact cites no registry rev (want {rev})")
    for r in matched:
        check = (r.get("preflight") or "").split("+")[0].strip().split()[0]
        if check and check not in body:
            problems.append(f"artifact records no '{check}' preflight for {r.get('id')}")
    if problems:
        die(f"preflight RED for {step['id']}: " + "; ".join(problems))
    print(f"preflight: {step['id']} PASS (rev {rev}, {[r.get('id') for r in matched]})")


def unblock(chain: str, ref: str, event: str, internal: bool = False) -> None:
    path, data = load(chain)
    index, step = step_for(data, ref)
    if ((index != data["current"] and not independent_marked(step))
            or step["status"] != "blocked"):
        die(f"step {step['id']} is not the blocked current step")
    if not internal:
        require_owner(step)
    step.update(status="active", resumed=now(), resume_event=event, lease_until=future(), last_progress=now())
    for key in ("blocked", "parent_chain", "blocker_type", "needs", "retry"):
        step.pop(key, None)
    data["status"] = status_from_current(data)
    require_emit("resume", f"{step['id']}: event={event} lease={step['lease_until']} ; task:{step['id']}, ask:{data.get('ask') or '-'}")
    save(path, data); update_context(step["owner"], data["chain"], step)
    print(f"resumed {step['id']}")


def wait_for(chain: str, ref: str, prerequisite: str) -> None:
    """Return blocked work to the queue behind one exact prerequisite task."""
    check_name(prerequisite, "prerequisite task")
    path, data = load(chain)
    index, step = step_for(data, ref)
    require_owner(step)
    if ((index != data["current"] and not independent_marked(step))
            or step["status"] != "blocked"):
        die(f"step {step['id']} is not the blocked current step")
    if prerequisite == step["id"]:
        die("a task cannot wait for itself")
    prereq_matches = [(other, idx, candidate)
                      for _, other in chain_states()
                      for idx, candidate in enumerate(other["steps"])
                      if candidate["id"] == prerequisite]
    if len(prereq_matches) != 1:
        die(f"prerequisite task '{prerequisite}' was not found exactly once")
    prereq_data, prereq_index, prereq_step = prereq_matches[0]
    if prereq_data.get("chain") == data.get("chain") and prereq_index > index:
        die(f"prerequisite '{prerequisite}' is a future step in the same chain: "
            f"wait-for would make this successor non-runnable by unparking {step['id']}; "
            f"keep {step['id']} blocked, mark the successor independent, complete it, "
            f"then resume {step['id']} without wait-for")
    if prereq_step.get("status") != "done" and not independent_ready(
            prereq_data, prereq_index, prereq_step):
        prereq_current = prereq_data.get("current")
        runnable_now = (
            prereq_data.get("status") in ("open", "active")
            and prereq_index == prereq_current
            and prereq_step.get("status") == "open"
            and not prereq_step.get("waiting_for")
        )
        resume_then_run = (
            prereq_index == prereq_current
            and prereq_step.get("status") == "blocked"
        )
        if prereq_step.get("waiting_for"):
            die(f"prerequisite '{prerequisite}' is itself parked waiting for "
                f"{prereq_step.get('waiting_for')}; wait for that root prerequisite instead")
        if not (runnable_now or resume_then_run):
            head = prereq_data["steps"][prereq_current]["id"] if isinstance(
                prereq_current, int) and 0 <= prereq_current < len(
                prereq_data.get("steps", [])) else "unknown"
            die(f"prerequisite '{prerequisite}' is not runnable: chain "
                f"{prereq_data.get('chain')} is {prereq_data.get('status')} "
                f"at {head}; wait for its blocked head or a runnable step instead")
    step.update(status="open", waiting_for=prerequisite, queued_at=now())
    for key in ("blocked", "blocker_type", "needs", "retry", "lease_until"):
        step.pop(key, None)
    data["status"] = status_from_current(data)
    if index == data["current"]:
        data["dispatch"] = "waiting"
    require_emit("queued", f"{step['id']}: waiting_for={prerequisite}; original task returned to queue"
                 f" ; task:{step['id']}, owner:{step['owner']}, status:open")
    save(path, data)
    update_context(step["owner"], data["chain"], step, remove=True)
    if prereq_step.get("status") == "done":
        release_waiters(prerequisite)
    else:
        print(f"queued {step['id']} waiting for {prerequisite}")


def clear_wait(chain: str, ref: str, reason: str) -> None:
    """Release a parked wait whose prerequisite can never arrive.

    Waiting behind a future step of the same chain, or behind a step that is
    queued behind another blocked head, strands both sides: the prerequisite
    cannot complete until the waiter advances, and the waiter cannot advance
    until the prerequisite completes. The exact owner (or the coordinator
    repairing a dead wait) clears the park with evidence, returning the step
    to dispatchable work instead of an eternal QUEUED row.
    """
    reason = " ".join(reason.split())
    if not reason:
        die("clear-wait reason is required")
    path, data = load(chain)
    index, step = step_for(data, ref)
    require_owner_or_coordinator(step)
    prerequisite = step.get("waiting_for")
    if step.get("status") != "open" or not prerequisite:
        die(f"step {step['id']} is not parked waiting for a prerequisite")
    step.pop("waiting_for", None)
    step.pop("released_by", None)
    # Dependency time is not queue time. Aging restarts when the step becomes
    # runnable again, not while it was parked behind an unrunnable wait.
    step["queued_at"] = now()
    step["wait_cleared"] = now()
    step["wait_cleared_reason"] = reason
    if index == data["current"]:
        data["dispatch"] = "pending"
    require_emit("resume", f"{step['id']}: parked wait for {prerequisite} cleared: {reason}; "
                 f"returned step is dispatchable"
                 f" ; task:{step['id']}, owner:{step['owner']}, status:open")
    save(path, data)
    if index == data["current"]:
        dispatch(path, data)
    elif independent_ready(data, index, step):
        if not post_task(data, index):
            emit("yield", f"{step['id']}: unparked but task delivery failed")
        else:
            step["dispatched_at"] = now()
            save(path, data)
    update_context(step["owner"], data["chain"], step)
    print(f"unparked {step['id']} (was waiting for {prerequisite})")


def release_waiters(completed_task: str) -> None:
    """Dispatch queued originals whose exact prerequisite has just completed."""
    for waiting_path, waiting_data in list(chain_states()):
        for index, waiting_step in enumerate(waiting_data["steps"]):
            if waiting_step.get("status") != "open" or waiting_step.get("waiting_for") != completed_task:
                continue
            waiting_step.pop("waiting_for", None)
            waiting_step["released_by"] = completed_task
            # Dependency time is not queue time. Aging starts when this task
            # becomes runnable, not while it waits for its prerequisite.
            waiting_step["queued_at"] = now()
            if index == waiting_data["current"]:
                waiting_data["dispatch"] = "pending"
            require_emit("resume", f"{waiting_step['id']}: prerequisite DONE {completed_task}; returned task is dispatchable"
                         f" ; task:{waiting_step['id']}, owner:{waiting_step['owner']}, status:open")
            save(waiting_path, waiting_data)
            if index == waiting_data["current"]:
                dispatch(waiting_path, waiting_data)
            elif independent_ready(waiting_data, index, waiting_step):
                if not post_task(waiting_data, index):
                    emit("yield", f"{waiting_step['id']}: released but task delivery failed")
                    continue
                waiting_step["dispatched_at"] = now()
                save(waiting_path, waiting_data)


def unblock_identity(owner: str, step: dict, parent_chain: str = "") -> str:
    """Return the exact parent/blocker epoch identity.

    The blocked timestamp is deliberately part of the key: two parents with
    identical prose, and two blocker epochs on one parent, are different
    obligations. This also makes old resolver records unable to mask a new
    blocked epoch.
    """
    raw = "|".join((owner, step.get("parent_chain", "") or parent_chain, step.get("id", ""),
                     str(step.get("block_epoch", "")), step.get("blocked", ""),
                     step.get("blocker_type", "unknown"), step.get("needs", ""),
                     step.get("retry", "")))
    # Keep the ledger key short enough for mesh-log-scrub while retaining the
    # full identity in resolver metadata below.
    return hashlib.sha256(raw.encode("utf-8")).hexdigest()[:32]


def unblock_depth(data: dict) -> int:
    """Count recovery ancestors so blocked recovery work cannot spawn forever."""
    depth = 0
    current = data
    seen = set()
    records = task_records()
    while current and current.get("chain", "").startswith("unblock/"):
        chain = current["chain"]
        if chain in seen:
            return MAX_UNBLOCK_DEPTH + 1
        seen.add(chain)
        depth += 1
        parent = current.get("unblock_parent")
        if not parent:
            break
        parent_record = records.get(parent)
        if not parent_record:
            # Legacy resolver records can outlive their parent chain. Count the
            # known ancestry and let the next generated hop bring the depth
            # into an exact, cycle-checkable chain.
            break
        current = parent_record.get("data")
    return depth


def cleared_unblock_event(data: dict, step: dict) -> str | None:
    """Return the owner-declared resume event for a cleared resolver result."""
    if not data.get("chain", "").startswith("unblock/") or step.get("status") != "done":
        return None
    result = step.get("result", "")
    if not re.search(r"(?:^|\s)unblock=cleared(?:\s|$)", result):
        return None
    match = re.search(r"(?:^|\s)event=([A-Za-z0-9._/-]+)(?:\s|$)", result)
    return match.group(1) if match else f"resolver-cleared:{step['id']}"


def unresolved_retry_backoff(attempt: int) -> int:
    """Bound repeated retries when the same concrete prerequisite is absent."""
    # The first retry is immediate so a partial resolver can hand work to the
    # next owner. Later identical failures need time for an external event or
    # another mind's prerequisite work; otherwise periodic sweeps manufacture
    # an unbounded resolver fan-out.
    return min(3600, 300 * (2 ** max(0, attempt - 2)))


def resume_cleared_parent(data: dict, step: dict) -> None:
    """Resume exactly one blocked parent after its owner proves the dependency cleared."""
    event = cleared_unblock_event(data, step)
    if not event:
        return
    identity = data.get("unblock_for")
    parents = []
    for _, candidate in chain_states():
        for parent in candidate.get("steps", []):
            if (candidate.get("status") in ("blocked", "active") and parent.get("status") == "blocked"
                    and unblock_identity(parent.get("owner"), parent, candidate.get("chain", "")) == identity
                    and data.get("unblock_parent") == candidate.get("chain")):
                parents.append((candidate["chain"], parent["id"]))
    if len(parents) != 1:
        emit("yield", f"{step['id']}: unblock=cleared but expected one blocked parent, found {len(parents)}")
        return
    parent_chain, parent_step = parents[0]
    # A cross-mind recovery resolver may clear a resolver owned by another
    # mind.  This is an internal, exact-parent transition; the child resolver
    # already supplied the artifact and its owner was checked by done().
    unblock(parent_chain, parent_step, event, internal=True)


def drained_resolver(candidate: dict) -> bool:
    """True when a terminal resolver was closed by an authorized drain.

    A drain closes a resolver because the blocker is decided to be irreducible, not
    because an automatic attempt failed. Without this, the sweep treats the drain as
    a failed attempt and mints a fresh successor for the same epoch, so the drain
    only renames the row it closed.
    """
    steps = candidate.get("steps", [])
    index = candidate.get("current", 0)
    if not isinstance(index, int) or not (0 <= index < len(steps)):
        return False
    return DRAIN_MARKER in (steps[index].get("rejected_reason") or "")


def root_unblock_prerequisite(data: dict) -> str:
    """Walk `unblock_parent` ancestry to the deepest non-unblock chain.

    Legacy resolver records can outlive their parent chain, so an unreadable
    ancestor ends the walk and names the last chain that was still resolvable.
    """
    records = task_records()
    current = data
    seen = set()
    root = data.get("unblock_parent") or "-"
    while current and current.get("chain", "").startswith("unblock/"):
        if current["chain"] in seen:
            break
        seen.add(current["chain"])
        parent = current.get("unblock_parent")
        if not parent:
            break
        root = parent
        record = records.get(parent)
        current = record.get("data") if record else None
    return root


def meta_unblock_yield(data: dict, step: dict) -> None:
    """Record once that a blocked resolver stops here instead of minting a resolver.

    The 2026-09-16 inventory (~/.mesh/evidence/unblock-mess-20260916/inventory.md)
    found 275 of 627 unblock steps (95 still open) were resolvers minted for other
    resolvers: the sweep matched every blocked step, including `unblock/` chains,
    so a resourceless resolver minted a successor instead of parking. A resolver's
    blocker is the original task's prerequisite, so another resolver adds a hop and
    a queue row without adding authority. One deduped [yield] names the root
    prerequisite; the ancestry cap stays as a backstop for legacy records.
    """
    if data.get("unblock_meta_yield"):
        return
    global _SWEEP_META_YIELD_COUNT, _SWEEP_META_YIELD_OVERFLOWED
    message = (f"{step['id']}: blocker is itself an unblock resolver; no resolver is minted "
               f"for recovery work. Root prerequisite={root_unblock_prerequisite(data)}; its exact "
               f"owner still owes an artifact-backed result or an evidenced block with the exact "
               f"retry edge (retry={step.get('retry', 'unspecified')}, "
               f"ancestry-depth={unblock_depth(data)} cap={MAX_UNBLOCK_DEPTH})")
    if _SWEEP_META_YIELD_COUNT < MAX_SWEEP_META_YIELDS:
        if emit("yield", message):
            _SWEEP_META_YIELD_COUNT += 1
            data["unblock_meta_yield"] = now()
            save(path_for(data["chain"]), data)
        return
    _SWEEP_META_YIELD_OVERFLOWED += 1
    if _SWEEP_META_YIELD_OVERFLOWED == 1:
        emit("yield", f"unblock-sweep: {MAX_SWEEP_META_YIELDS} meta-yields posted; "
                      f"further resolver-for-resolver yields this sweep park in the sweep log, "
                      f"one line per chain — the per-chain unblock_meta_yield mark stays queryable")
    # Overflow detail rides the sweep's own stdout (the reflex cron log), never the board.
    print(f"meta-yield-overflow {step['id']}: {message}")
    data["unblock_meta_yield"] = now()
    save(path_for(data["chain"]), data)


def report_unblock_attempt_exhaustion(data: dict) -> None:
    """Leave one durable explanation when a blocked epoch reaches its retry cap."""
    if data.get("unblock_retry_exhausted") or int(data.get("unblock_attempt", 1)) < MAX_UNBLOCK_ATTEMPTS:
        return
    index = data.get("current", 0)
    steps = data.get("steps", [])
    if not isinstance(index, int) or not (0 <= index < len(steps)):
        return
    step = steps[index]
    if cleared_unblock_event(data, step):
        return
    if emit("yield", f"{step['id']}: automatic resolver attempts exhausted at {MAX_UNBLOCK_ATTEMPTS}; "
            f"the parent remains blocked until retry={step.get('result', 'an evidenced prerequisite change')}"):
        data["unblock_retry_exhausted"] = now()
        save(path_for(data["chain"]), data)


def _unblock_pair_cover(parent_chain: str, parent_step: str, epoch: str, owner: str,
                        identity: str) -> dict | None:
    """Return the canonical resolver for one (parent, step, epoch, owner) pair.

    Pre-guard resolvers lack unblock_parent/unblock_step, so they match by the
    legacy identity instead. Earliest-created wins: later same-pair chains are
    historical duplicate mints, never the canonical record.
    """
    matches = [c for _, c in chain_states()
               if (c.get("unblock_parent") == parent_chain
                   and c.get("unblock_step") == parent_step
                   and str(c.get("unblock_epoch", "")) == epoch
                   and (c.get("steps", [{}])[0].get("owner") == owner or not owner))
               or (not c.get("unblock_parent") and c.get("unblock_for") == identity)]
    if not matches:
        return None
    return min(matches, key=lambda c: c.get("created", ""))


def _unblock_retry_date(cover: dict, rstep: dict, step: dict) -> float:
    """When the next attempt on an existing resolver is due.

    An explicit ISO date in the live parent gate wins while the gate is
    unchanged (same blocker_type/needs/retry as the snapshot taken at mint) —
    a rejected resolver for an unchanged external-event gate must not re-mint
    before its retry date. Otherwise the terminal timestamp plus the attempt
    backoff applies.
    """
    gate_now = [step.get("blocker_type", ""), step.get("needs", ""), step.get("retry", "")]
    if cover.get("unblock_gate") and list(cover["unblock_gate"]) == gate_now:
        for text in (step.get("retry", ""), step.get("needs", "")):
            match = re.search(r"20\d\d-\d\d-\d\dT\d\d:\d\d:\d\dZ", text or "")
            if match:
                return epoch_iso(match.group(0))
    terminal_at = (rstep.get("finished") or rstep.get("rejected") or cover.get("created", ""))
    return epoch_iso(terminal_at) + unresolved_retry_backoff(int(cover.get("unblock_attempt", 1)))


def _append_unblock_retry(path: Path, cover: dict, rstep: dict) -> None:
    """Append the due fresh attempt as a successor step on the same chain.

    The ledger forbids terminal→open transitions — only a successor step with
    recovery_action + a real recovery_artifact (+sha256) + recovered_from may
    follow a rejection. The due receipt is a real file under MESH_DIR (one per
    attempt, bounded by MAX_UNBLOCK_ATTEMPTS on the chain counter). The previous
    step is left byte-identical, which the replay gate requires.
    """
    attempt = int(cover.get("unblock_attempt", 1)) + 1
    receipt_dir = ROOT / "unblock-due"
    receipt_dir.mkdir(parents=True, exist_ok=True)
    receipt = receipt_dir / (cover["chain"].replace("/", "__") + f"-attempt-{attempt}.md")
    receipt.write_text(
        f"# unblock retry due\n\nchain: {cover['chain']}\nparent: {cover.get('unblock_parent')}\n"
        f"step: {cover.get('unblock_step')}\nepoch: {cover.get('unblock_epoch')}\n"
        f"attempt: {attempt}\ndecided: {now()}\n")
    digest = hashlib.sha256(receipt.read_bytes()).hexdigest()
    owner = rstep.get("owner", "")
    new_step = {"id": f"{cover['chain']}/resolve-retry-{attempt}", "owner": owner,
                "slug": f"resolve-retry-{attempt}",
                "description": f"{rstep.get('description', '')} (retry attempt {attempt} after due date)",
                "priority": 90, "status": "open", "next_update": now(),
                "recovery_action": "retry-after-date", "recovery_artifact": str(receipt),
                "recovery_artifact_sha256": digest, "recovered_from": rstep.get("id", "")}
    cover["steps"].append(new_step)
    cover["current"] = len(cover["steps"]) - 1
    cover["status"] = "open"
    cover["unblock_attempt"] = attempt
    cover["dispatch"] = "pending"


def _resolver_parked(cover: dict) -> bool:
    """True when the resolver was reuse-touched recently enough to leave alone.

    The flood class (2026-09-18): every 5-minute sweep re-saved every covered
    resolver — `unblock_reused_at=now()` plus a `next_update=now()` on the step
    — so 692 quiet resolvers each appended a fresh [task-ledger] revision to a
    135MB log every pass and re-contended the owner lock. A parked resolver has
    no news: same gate, no due retry, nothing cleared. Returns True only when
    UNBLOCK_QUIET_SECONDS > 0 AND the marker is parseable; a missing/garbage
    marker (legacy record) is never parked, so the first pass after upgrade
    stamps once and subsequent passes fall quiet.
    """
    if UNBLOCK_QUIET_SECONDS <= 0:
        return False
    try:
        age = time.time() - epoch_iso(cover.get("unblock_reused_at", ""))
    except (TypeError, ValueError):
        return False
    return 0 <= age < UNBLOCK_QUIET_SECONDS


def _refresh_unblock_resolver(cover_chain: str, step: dict) -> str:
    """Reuse the existing pair resolver: touch its edge, redrive when due.

    Returns the same chain in every case — the caller never mints while a pair
    resolver exists. A due retry appends ONE successor attempt on the same chain
    (the only terminal exit the ledger allows); attempts stay bounded by
    MAX_UNBLOCK_ATTEMPTS on the chain's own counter. A parked resolver (touched
    inside UNBLOCK_QUIET_SECONDS) is skipped entirely: no save, no append, no
    print, no dispatch — an unchanged blocked row that was reuse-confirmed
    minutes ago carries zero news for the board or the next sweep pass.
    """
    path, cover = load(cover_chain)
    steps = cover.get("steps", [])
    index = cover.get("current", 0)
    rstep = steps[index] if isinstance(index, int) and 0 <= index < len(steps) else {}
    status = cover.get("status")
    live = status in ("open", "active", "claimed")
    terminal = status in ("complete", "rejected")
    cleared = cleared_unblock_event(cover, rstep) if terminal else None
    attempt = int(cover.get("unblock_attempt", 1))
    if terminal and not cleared and not drained_resolver(cover) and attempt >= MAX_UNBLOCK_ATTEMPTS:
        report_unblock_attempt_exhaustion(cover)
    due = (status == "rejected" and not cleared and not drained_resolver(cover)
           and attempt < MAX_UNBLOCK_ATTEMPTS
           and _unblock_retry_date(cover, rstep, step) <= time.time())
    # Park gate: after the exhausted/due verdicts are computed, an unchanged
    # resolver touched recently is left byte-identical. Everything below this
    # gate mutates durable state; everything above it is a pure read.
    if _resolver_parked(cover) and not due and not cleared and status == cover.get("status"):
        return cover_chain
    if due:
        _append_unblock_retry(path, cover, rstep)
        print(f"unblock-reuse: fresh attempt on {cover_chain}; no new chain minted")
    else:
        if not live:
            print(f"dedupe-guard: refused duplicate resolver for {step.get('id', '')}; "
                  f"covered by {cover_chain} (status={status})")
        rstep["next_update"] = now()
    cover["unblock_reused_at"] = now()
    save(path, cover)
    if cover.get("dispatch") == "pending":
        dispatch(path, cover)
    return cover_chain


def ensure_unblock_task(data: dict, step: dict) -> str | None:
    """Materialize exactly one resolver, never a resolver for a resolver."""
    owner = step.get("owner")
    if not owner:
        return None
    if data.get("chain", "").startswith("unblock/"):
        meta_unblock_yield(data, step)
        return None
    # One chain per (parent, step, epoch, owner) (2026-09-17: reuse-resolver-
    # per-parent-epoch; honor-rejected-resolver-retry-date). The sweep used to
    # mint a new chain per poll — the attempt number in the digest made every
    # retry a NEW chain by construction — and the epoch was recorded but never a
    # reuse key. Now the pair is the key: an existing resolver is returned, its
    # retry/next_update edge touched, and it is redriven when due; a new chain
    # mints only when no resolver exists for the pair.
    _pchain, _pstep = data.get("chain", ""), step.get("id", "")
    _epoch = str(step.get("block_epoch", ""))
    _identity = unblock_identity(owner, step, data.get("chain", ""))
    _cover = _unblock_pair_cover(_pchain, _pstep, _epoch, owner, _identity)
    if _cover:
        return _refresh_unblock_resolver(_cover["chain"], step)
    resolver_owner = owner
    identity = _identity
    # No resolver exists for the pair: mint the one and only chain for it. The
    # digest is deterministic on the pair identity (no attempt number), so even
    # a re-mint after manual deletion returns the same name. The gate snapshot
    # below lets later sweeps tell an unchanged gate from a new epoch.
    digest = hashlib.sha256(identity.encode("utf-8")).hexdigest()[:16]
    chain = f"unblock/{resolver_owner}/{digest}"
    if chain in task_records():
        return chain
    operator_policy = ""
    blocker_text = " ".join(str(step.get(key, "")) for key in
                             ("blocker_type", "needs", "retry", "description"))
    operator_directed = (step.get("blocker_type") == "operator-input"
                         or bool(re.search(r"\boperator\b", blocker_text, re.I)))
    if operator_directed:
        operator_policy = (
            " Operator agreement is assumed for this recovery; do not ask for permission. "
            "Derive the exact operational prerequisite and implement it when safe, or write "
            "an artifact-backed operator-action packet naming the exact command, input, or "
            "condition needed. Split every mesh-internal sub-step out as an owned task and "
            "execute it now — only the exact external atom (physical hands, third-party "
            "approval, operator credential) waits. Only remain blocked on a concrete external "
            "capability or missing datum, never on approval."
        )
    rejected_parent = data.get("status") == "rejected"
    if rejected_parent:
        recovery_policy = (
            " This parent was recently rejected because prerequisite state was absent. Inspect its "
            "reason against the live repository, task ledger, and board; find exact active work or "
            "create narrowly scoped prerequisite task(s), then implement the mesh-owned parts. Link "
            "those tasks with mesh-task wait-for where appropriate. Do not repeat the rejection or "
            "run a gated comparison early. Make mesh-owned registration and execution decisions from "
            "the frozen protocol without waiting for approval. If a required external datum cannot be "
            "sourced or honestly substituted, leave an artifact-backed typed blocker naming the exact "
            "missing datum and retry event, while completing independent internal prerequisites. "
            "When every required gate is satisfied, create a fresh exact-owner task for the comparison, "
            "link it to this rejected history and its gate artifacts, and preserve downstream sequence. "
            "Do not use mesh-task recover on the rejected step: that command only activates its first successor."
        )
    else:
        recovery_policy = ""
    next_action = ("create a fresh exact-owner successor task linked to the rejected history and gate artifacts"
                   if rejected_parent else "resume the original task only if the prerequisite is actually satisfied")
    parent_artifact = (step.get("progress_artifact") or step.get("artifact") or
                       data.get("progress_artifact") or data.get("artifact") or "-")
    parent_context = (
        f" Parent context: parent={step.get('id', '-')}; parent-ask={data.get('ask') or '-'};"
        f" parent-description={step.get('description') or '-'};"
        f" parent-progress-artifact={parent_artifact};"
        f" parent-last-progress={step.get('last_progress') or data.get('last_progress') or '-'};"
        f" parent-next-action={step.get('next_action') or data.get('next_action') or '-'};"
        f" blocked-at={step.get('blocked') or '-'}; block-epoch={step.get('block_epoch') or '-'}."
    )
    description = (f"Resolve blocker for {owner}: {step['id']} — "
                   f"reason={step.get('blocker_type', 'unknown')}; "
                   f"needs={step.get('needs', 'unspecified')}; "
                   f"retry={step.get('retry', 'unspecified')}. "
                   f"{parent_context} "
                   f"Mesh decides mesh-internal steps from evidence without asking the operator: "
                   f"derive prerequisites, make registrations, and implement fixes yourself; "
                   f"operator agreement is assumed for recovery work. "
                   f"Diagnose the blocker and create or implement the narrowest safe in-scope "
                   f"prerequisite/fix first. Park or reject only with evidence that the required "
                   f"authority or external state is irreducible. Produce an artifact-backed result, "
                   f"then {next_action}."
                   f"{operator_policy}{recovery_policy}")
    unblock_data = {
        "version": 2, "chain": chain, "ask": None, "created": now(),
        "status": "open", "current": 0, "dispatch": "pending",
        "unblock_for": identity,
        "unblock_parent": data.get("chain", ""),
        "unblock_step": step.get("id", ""),
        "unblock_epoch": step.get("block_epoch", ""),
        "unblock_attempt": 1,
        "unblock_gate": [step.get("blocker_type", ""), step.get("needs", ""),
                         step.get("retry", "")],
        "steps": [{"id": f"{chain}/resolve", "owner": resolver_owner, "slug": "resolve",
                    "description": description, "priority": 90, "status": "open"}],
    }
    path = path_for(chain)
    save(path, unblock_data)
    dispatch(path, unblock_data)
    return chain


def unblock_sweep(owner: str | None = None) -> None:
    """Backfill resolvers for blocked work and recent missing-prerequisite rejections."""
    global _SWEEP_META_YIELD_COUNT, _SWEEP_META_YIELD_OVERFLOWED
    _SWEEP_META_YIELD_COUNT = 0
    _SWEEP_META_YIELD_OVERFLOWED = 0
    if owner:
        check_name(owner, "owner")
    created = []
    skipped_unblock = 0
    before = set(task_records())
    for _, data in list(chain_states()):
        if data.get("chain", "").startswith("unblock/"):
            # Unblock-on-unblock recursion (2026-09-16 inventory: 275 of 627
            # unblock steps minted for other resolvers, depth 4). A resolver's
            # blocker is the original task's prerequisite, so a resolver is never
            # a parent — skip before step matching so the sweep spends zero
            # iterations and zero meta-yields on them. ensure_unblock_task keeps
            # its own unblock/ guard as the backstop for direct calls.
            skipped_unblock += 1
            continue
        steps = data.get("steps", [])
        for index, step in enumerate(steps):
            if owner and step.get("owner") != owner:
                continue
            recovery_step = step
            if step.get("status") == "rejected":
                # Keep this reflex bounded to actionable recent dependency failures;
                # historical and policy-invalid rejections are not reopened forever.
                reason = step.get("rejected_reason", "")
                rejected_at = epoch_iso(step.get("rejected", ""))
                missing_prerequisite = bool(re.search(
                    r"\b(?:missing|absent|not[_ -](?:registered|started|preflighted|approved)|"
                    r"prerequisite|premature|unavailable|not available)\b", reason, re.I))
                recent = rejected_at > 0 and time.time() - rejected_at <= 86400
                if (data.get("status") != "rejected" or index != data.get("current")
                        or not missing_prerequisite or not recent):
                    continue
                rejected_stamp = step.get("rejected", "")
                recovery_step = dict(step)
                recovery_step.update(
                    status="blocked", parent_chain=data.get("chain", ""),
                    block_epoch=f"rejected:{rejected_stamp}", blocked=rejected_stamp,
                    blocker_type="missing-prerequisite",
                    needs=reason,
                    retry="retry after the exact missing prerequisite is implemented or its external event arrives",
                )
            elif step.get("status") != "blocked":
                continue
            chain = ensure_unblock_task(data, recovery_step)
            if chain and chain not in before and chain not in created:
                created.append(chain)
    for chain in created:
        print(f"unblock-task {chain}")
    print(f"unblock-sweep owner={owner or 'all'} created={len(created)} skipped-unblock={skipped_unblock}")


def retry_dispatch(chain: str) -> None:
    path, data = load(chain)
    if data["status"] not in ("open", "active") or data["steps"][data["current"]]["status"] != "open":
        die(f"chain '{chain}' has no open current step to dispatch")
    if data.get("dispatch") == "sent":
        die(f"chain '{chain}' current step was already dispatched; it must be taken before further work")
    dispatch(path, data)
    print(f"dispatched {data['steps'][data['current']]['id']}")


def dispatch_retry_candidates() -> list[tuple[Path, dict, str]]:
    """Collect chains whose delivery failed or whose unclaimed lease expired."""
    current = time.time()
    found = []
    for path, data in chain_states():
        steps = data.get("steps", [])
        index = data.get("current")
        if not isinstance(index, int) or not 0 <= index < len(steps):
            continue
        step = steps[index]
        if data.get("status") not in ("open", "active") or step.get("status") != "open":
            continue
        if step.get("waiting_for"):
            continue
        if data.get("dispatch") == "failed":
            found.append((path, data, "failed"))
            continue
        if data.get("dispatch") == "sent":
            queued_until = max(epoch_iso(step.get("reschedule_until", "")),
                               epoch_iso(step.get("dispatch_until", "")))
            if 0 < queued_until < current:
                found.append((path, data, "expired"))
                continue
        for other in steps:
            if independent_marked(other) and other.get("status") == "open" \
                    and other.get("independent_dispatch") == "failed" and not other.get("waiting_for"):
                found.append((path, data, f"independent-failed:{other['id']}"))
                break
    return found


def retry_failed_dispatches(limit: int = 0) -> None:
    """Re-dispatch failed/expired rows under coordinator identity, bounded per row."""
    if actor() != COORDINATOR:
        die(f"coordinator required: coordinator={COORDINATOR} actor={actor()}")
    try:
        max_retries = max(0, int(os.environ.get("MESH_TASK_DISPATCH_RETRIES", str(MAX_DISPATCH_RETRIES))))
    except ValueError:
        max_retries = MAX_DISPATCH_RETRIES
    candidates = dispatch_retry_candidates()
    retried = succeeded = failed = exhausted = 0
    failures = []
    for path, data, reason in candidates:
        if limit and retried >= limit:
            break
        attempts = int(data.get("dispatch_attempts", 0) or 0)
        if attempts >= max_retries:
            exhausted += 1
            if not data.get("dispatch_retry_exhausted"):
                emit("yield", f"{data['chain']}: dispatch retries exhausted at {max_retries}; "
                     f"reason={reason}; needs a hand")
                data["dispatch_retry_exhausted"] = now()
                save(path, data)
            continue
        if reason.startswith("independent-failed:"):
            target_id = reason.split(":", 1)[1]
            target = next((s for s in data["steps"] if s.get("id") == target_id), None)
            data["dispatch_attempts"] = attempts + 1
            data.pop("dispatch_retry_exhausted", None)
            path, data = load(data["chain"])
            target = next((s for s in data["steps"] if s.get("id") == target_id), None)
            if target is None or target.get("independent_dispatch") != "failed":
                continue
            retried += 1
            index = data["steps"].index(target)
            if post_task(data, index):
                target["dispatched_at"] = now()
                target["independent_dispatch"] = "sent"
                target.pop("independent_dispatch_error", None)
                save(path, data)
                succeeded += 1
            else:
                target["independent_dispatch"] = "failed"
                target["independent_dispatch_error"] = f"{now()}: board task post failed"
                save(path, data)
                failed += 1
                failures.append(data["chain"])
            continue
        data["dispatch_attempts"] = attempts + 1
        data.pop("dispatch_retry_exhausted", None)
        if data.get("dispatch") == "sent":
            data["dispatch"] = "pending"
        path, live = load(data["chain"])
        live["dispatch_attempts"] = data["dispatch_attempts"]
        live.pop("dispatch_retry_exhausted", None)
        if live.get("dispatch") == "sent":
            live["dispatch"] = "pending"
        retried += 1
        try:
            dispatch(path, live)
            succeeded += 1
        except SystemExit as exc:
            failed += 1
            failures.append(f"{live.get('chain', str(path))} rc={exc.code}")
    print(f"dispatch-retry candidates={len(candidates)} retried={retried} "
          f"succeeded={succeeded} failed={failed} exhausted={exhausted} max_retries={max_retries}")
    if failures:
        die(f"dispatch-retry failures: {'; '.join(failures)}", 1)


def reschedule(path: Path, data: dict) -> None:
    """Re-deliver an unclaimed current step without changing task ownership."""
    if data.get("status") not in ("open", "active"):
        die(f"chain '{data['chain']}' is {data.get('status', 'unknown')}; it cannot be re-scheduled")
    index = data["current"]
    step = data["steps"][index]
    state = step.get("status")
    if state == "open":
        require_emit("yield", f"{step['id']}: unclaimed dispatch re-scheduled to exact owner {step['owner']}")
    else:
        die(f"step {step['id']} is {state}; an active task never expires — explicitly reject or complete it")
    step["rescheduled_at"] = now()
    step["reschedule_until"] = future()
    data["status"] = "open"
    # A repeated delivery is intentional after a missed receipt; do not let the
    # ordinary dispatch guard mistake it for duplicate completion work.
    data["dispatch"] = "pending"
    update_context(step["owner"], data["chain"], step)
    dispatch(path, data)
    print(f"re-scheduled {step['id']} to {step['owner']}")


def reject(chain: str, ref: str, reason: str) -> None:
    """Close current active or blocked work with an explicit explanation."""
    if not reason.strip():
        die("reject reason is required")
    path, data = load(chain)
    index, step = step_for(data, ref)
    require_owner(step)
    if has_task_tag(step, "audit-followthrough"):
        die(f"audit-followthrough task {step['id']} cannot be rejected; complete it with a finding manifest or block it with an exact retry edge")
    if ((index != data["current"] and not independent_marked(step))
            or step["status"] not in ("active", "blocked")):
        die(f"step {step['id']} is not active or blocked; take it before rejecting")
    step.update(status="rejected", rejected=now(), rejected_reason=reason.strip())
    if index == data["current"]:
        data["status"] = "rejected"
    else:
        data["status"] = status_from_current(data)
    require_emit("rejected", f"{step['id']}: reason={step['rejected_reason']}"
                 f" ; task:{step['id']}, ask:{data.get('ask') or '-'}, owner:{step['owner']}, status:rejected")
    save(path, data)
    update_context(step["owner"], data["chain"], step, remove=True)
    print(f"rejected {step['id']}: {step['rejected_reason']}")


def ignore(chain: str, ref: str, reason: str) -> None:
    """Backward-compatible spelling; new records use REJECTED."""
    reject(chain, ref, reason)


def reschedule_chain(chain: str) -> None:
    path, data = load(chain)
    reschedule(path, data)


def reschedule_task(task: str) -> None:
    """Recover a current task by its durable task id, for periodic witnesses."""
    for path, data in chain_states():
        index = data.get("current")
        steps = data.get("steps", [])
        if isinstance(index, int) and 0 <= index < len(steps) and steps[index].get("id") == task:
            reschedule(path, data)
            return
    die(f"current task '{task}' was not found")


def recover(chain: str, ref: str, action: str, artifact: str, reason: str) -> None:
    """Recover the first successor of a rejected head with owner evidence.

    Rejection is history, not permission to skip verification.  The exact
    successor owner must present a durable artifact; only then may the chain
    be reopened, or explicitly held when the dependency remains unresolved.
    """
    if action not in ("reactivate", "hold"):
        die("recovery action must be reactivate or hold")
    if not reason.strip():
        die("recovery reason is required")
    path, data = load(chain)
    index, step = step_for(data, ref)
    require_owner(step)
    artifact_path = resolve_node_local(Path(artifact).expanduser().resolve())
    if not artifact_path.exists():
        die(f"recovery artifact does not exist: {artifact}")
    digest = artifact_digest(artifact_path)
    prior = (step.get("recovery_action"), step.get("recovery_artifact"),
             step.get("recovery_reason"))
    current = (action, str(artifact_path), reason.strip())
    if prior == current and ((action == "hold" and step.get("status") == "blocked") or
                             (action == "reactivate" and step.get("status") == "open" and
                              data.get("status") == "open")):
        print(f"already recovered {step['id']} action={action}")
        return
    if data.get("status") != "rejected":
        die(f"chain '{chain}' is {data.get('status', 'unknown')}; recovery requires a rejected chain")
    rejected_index = data["current"]
    rejected = data["steps"][rejected_index]
    if rejected.get("status") != "rejected":
        die(f"chain '{chain}' current step is not rejected")
    if index != rejected_index + 1:
        die(f"recovery must target the first successor after rejected task {rejected['id']}")
    if step.get("recovery_action") and prior != current:
        die(f"step {step['id']} already has a different recovery disposition")
    step.update(recovery_action=action, recovery_artifact=str(artifact_path),
                recovery_artifact_sha256=digest, recovery_reason=reason.strip(),
                recovered_from=rejected["id"], recovered_at=now())
    data["current"] = index
    if action == "reactivate":
        step["status"] = "open"
        data["status"] = "open"
        data["dispatch"] = "pending"
        require_emit("recovered", f"{step['id']}: reactivated after rejected predecessor {rejected['id']}"
                     f" artifact={artifact_path} artifact-sha256:{digest} reason={reason.strip()}"
                     f" ; task:{step['id']}, owner:{step['owner']}, status:open")
    else:
        step.update(status="blocked", blocker_type="dependency", needs=reason.strip(),
                    retry="owner-authorized recovery evidence")
        data["status"] = "blocked"
        data["dispatch"] = "held"
        require_emit("held", f"{step['id']}: held after rejected predecessor {rejected['id']}"
                     f" artifact={artifact_path} artifact-sha256:{digest} reason={reason.strip()}"
                     f" ; task:{step['id']}, owner:{step['owner']}, status:blocked")
    save(path, data)
    update_context(step["owner"], data["chain"], step, remove=action == "reactivate")
    if action == "reactivate":
        dispatch(path, data)
    print(f"recovered {step['id']} action={action} artifact={artifact_path}")


def status(chain: str) -> None:
    _, data = load(chain)
    print(f"{data['chain']} [{data['status']}] ({data['current'] + 1}/{len(data['steps'])})")
    for n, step in enumerate(data["steps"], 1):
        print(f"  {n}. {step['id']} [{step['status']}] owner={step['owner']}" +
              f" priority={priority_label(step)}" +
              (f" tags={step.get('tags', '-')} design_artifact={step.get('design_artifact', '-')}"
               if step.get("tags") or step.get("design_artifact") else "") +
              (f" lease={step['lease_until']}" if "lease_until" in step else "") +
              (f" independent_reason={step['independent_reason']}"
               f" independent_dispatch={step.get('independent_dispatch', 'unknown')}" if independent_marked(step) else "") +
              (f" blocker={step['blocker_type']} retry={step['retry']}"
               if step.get("status") == "blocked" and "blocker_type" in step else "") +
              (f" artifact={step['artifact']}" if "artifact" in step else ""))
    if data.get("dispatch") in ("pending", "failed"):
        print(f"  dispatch={data['dispatch']} {data.get('dispatch_error', '')}")


def reconcile(owner: str) -> None:
    check_name(owner, "owner")
    if actor() != owner:
        die(f"exact owner required: context owner={owner} actor={actor()}")
    count = reconcile_context(owner)
    print(f"reconciled task context for {owner}: {count} canonical pointer(s)")


def live_owners() -> set[str]:
    override = os.environ.get("MESH_TASK_LIVE_OWNERS")
    if override is not None: return set(override.split())
    result = subprocess.run(["tmux", "list-windows", "-a", "-F", "#{window_name}"],
                            text=True, capture_output=True, check=False)
    return set(result.stdout.split()) if result.returncode == 0 else set()


def audit() -> None:
    live = live_owners(); current = time.time(); rows = []

    def order_key(bucket: int, data: dict, index: int, step: dict, incident: int):
        stamp = step.get("queued_at") or step.get("dispatched_at") or data.get("created", "")
        resolver = data.get("chain", "").startswith("unblock/")
        work_class = 0 if incident == 0 else (1 if resolver else 2)
        return (bucket, -queue_age_bucket(stamp, current), work_class,
                -priority_of(step), epoch_iso(stamp), data["chain"], index)

    for path, data in chain_states():
        if data.get("status") not in ("open", "active", "blocked", "complete", "ignored", "rejected"): continue
        current_index = data["current"]
        for index, step in enumerate(data["steps"]):
            state = step.get("status")
            incident = 0 if re.search(r"(?:^|\s)priority:incident\s*$", step.get("description", ""), re.I) else 1
            rank = -priority_of(step)
            # Age cohorts advance daily, so class and priority cannot bury older
            # work forever; FIFO breaks any remaining tie within the cohort.
            terminal_key = order_key(4, data, index, step, incident)
            if state == "done":
                rows.append((terminal_key, f"DONE\t{step['owner']}\t{step['id']}\t"
                             f"artifact={step.get('artifact', 'missing')}"))
                continue
            if state == "ignored":
                rows.append((terminal_key, f"IGNORED\t{step.get('owner') or '-'}\t{step['id']}\t"
                             f"reason={step.get('ignored_reason', 'missing')}"))
                continue
            if state == "rejected":
                rows.append((terminal_key, f"REJECTED\t{step.get('owner') or '-'}\t{step['id']}\t"
                             f"reason={step.get('rejected_reason', 'missing')}"))
                continue
            if data.get("status") == "rejected" and index > current_index:
                predecessor = data["steps"][current_index]["id"]
                rows.append((order_key(2, data, index, step, incident),
                             f"HELD_REJECTED\t{step.get('owner') or '-'}\t{step['id']}\t"
                             f"predecessor={predecessor} action=recover-{step.get('recovery_action', 'required')}"))
                continue
            if state == "open":
                bucket = 0 if index == current_index else 3
                if step.get("waiting_for"):
                    rows.append((order_key(2, data, index, step, incident),
                                 f"QUEUED\t{step['owner']}\t{step['id']}\twaiting_for={step['waiting_for']} dispatch=waiting"))
                    continue
                queued_until = max(epoch_iso(step.get("reschedule_until", "")),
                                   epoch_iso(step.get("dispatch_until", "")))
                if (data["chain"].startswith("health-warning/")
                        and data.get("dispatch") == "sent"
                        and queued_until < current):
                    rows.append((order_key(2, data, index, step, incident),
                                 f"HELD_EXPIRED\t{step['owner']}\t{step['id']}\t"
                                 "retry=next fresh health warning"))
                    continue
                independent = independent_ready(data, index, step)
                open_owner = step.get("owner") or "-"
                if index == current_index and queued_until < current and not independent and not step.get("waiting_for"):
                    # OPEN_UNOWNED is un-owned by definition: deterministic over
                    # chat.log state, the audit row carries "-" regardless of any
                    # stale owner field on the open step.
                    verdict = "OPEN_UNOWNED"
                    open_owner = "-"
                else:
                    verdict = ("READY_INDEPENDENT" if independent else
                               "QUEUED" if index != current_index or queued_until >= current else "OPEN_UNOWNED")
                    if verdict == "OPEN_UNOWNED":
                        open_owner = "-"
                rows.append((order_key(0 if independent else bucket, data, index, step, incident),
                             f"{verdict}\t{open_owner}\t{step['id']}\t"
                             f"current={data['steps'][current_index]['id']} dispatch={step.get('independent_dispatch') if independent else data.get('dispatch','unknown')}"
                             f"{(' independent_reason=' + step['independent_reason']) if independent else ''}"))
                continue
            if state == "blocked":
                if index != current_index and not independent_marked(step):
                    continue
                rows.append((order_key(2, data, index, step, incident),
                             f"BLOCKED\t{step['owner']}\t{step['id']}\t{step.get('blocker_type','unknown')}\t{step.get('retry','unspecified')}"
                             f"{(' independent_reason=' + step['independent_reason']) if index != current_index and independent_marked(step) else ''}"))
                continue
            if index != current_index and not independent_marked(step):
                continue
            lease = epoch_iso(step.get("lease_until", "1970-01-01T00:00:00Z"))
            verdict = "RUNNING" if lease >= current else "OVERDUE"
            rows.append((order_key(1, data, index, step, incident),
                         f"{verdict}\t{step['owner']}\t{step['id']}\tlease={step.get('lease_until','missing')}"
                         f"{(' independent_reason=' + step['independent_reason']) if index != current_index else ''}"))
    for _, row in sorted(rows):
        print(row)


def dispatch_queue(owner: str | None = None) -> None:
    """Emit current and explicitly independent claimable tasks by owner."""
    if owner is not None:
        owner = normalize_owner(check_name(owner, "owner"))
    rows = []
    for _, data in chain_states():
        for index, step in enumerate(data["steps"]):
            independent = independent_ready(data, index, step)
            current = (index == data["current"] and data.get("status") == "open"
                       and step.get("status") == "open" and not step.get("waiting_for"))
            if not (current or independent) or data.get("status") not in ("open", "active", "blocked"):
                continue
            if owner is not None:
                assigned_owner = normalize_owner(step["owner"]) if step.get("owner") else None
                if assigned_owner and assigned_owner != owner:
                    continue
                if not assigned_owner and len(active_tasks_for_owner(task_records(), owner)) >= active_task_limit():
                    continue
            if (step.get("owner") and not data["chain"].startswith("unblock/")
                    and len(active_tasks_for_owner(task_records(), step["owner"], step["id"])) >= active_task_limit()):
                continue
            incident = bool(re.search(r"(?:^|\s)priority:incident\s*$", step.get("description", ""), re.I))
            stamp = step.get("queued_at") or step.get("dispatched_at") or data.get("created", "")
            resolver = data["chain"].startswith("unblock/")
            work_class = 0 if incident else (1 if resolver else 2)
            rows.append((-queue_age_bucket(stamp), work_class, -priority_of(step),
                         epoch_iso(stamp), data["chain"], index, step))
    for _, _, _, _, _, _, step in sorted(rows, key=lambda row: row[:6]):
        print(f"{step.get('owner') or '-'}\t{step['id']}\t"
              f"{priority_label(step)}\t{step.get('description', '')}"
              f" tags={step.get('tags', '-')} design_artifact={step.get('design_artifact', '-') }"
              f"{(' independent_reason=' + step['independent_reason']) if independent_marked(step) else ''}")


def epoch_iso(value: str) -> float:
    try: return calendar.timegm(time.strptime(value, "%Y-%m-%dT%H:%M:%SZ"))
    except ValueError: return 0


def queue_age_bucket(stamp: str, current: float | None = None) -> int:
    """Return full age intervals since a task became eligible for dispatch."""
    try:
        interval = max(1, int(os.environ.get("MESH_TASK_QUEUE_AGING_SECONDS", "86400")))
    except ValueError:
        interval = 86400
    age = max(0, (time.time() if current is None else current) - epoch_iso(stamp))
    return int(age // interval)


