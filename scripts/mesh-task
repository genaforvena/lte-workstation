        blocked_audit = run("audit")
        if "BLOCKED\tbeta\tdemo/verify\toperator-input\tevent:csv-arrives" not in blocked_audit.stdout:
            die("self-test blocked task was not queryable", 1)
        run("resume", "demo", "verify", "csv-arrives"); run("done", "demo", "verify", str(artifact), "verified pane:witness")
        state = json.loads((root / "mesh/chains/demo.json").read_text())
        if state["current"] != 2 or state["dispatch"] != "sent": die("self-test second handoff missing", 1)
        env["MESH_TASK_ACTOR"] = "gamma"
        env["MESH_TASK_LEASE_SECONDS"] = "-1"
        run("take", "demo", "close")
        env.pop("MESH_TASK_LEASE_SECONDS")
        env["MESH_TASK_LIVE_OWNERS"] = "gamma"
        if "OVERDUE\tgamma\tdemo/close" not in run("audit").stdout: die("self-test overdue classification failed", 1)
        env["MESH_TASK_LIVE_OWNERS"] = ""
        if "OVERDUE\tgamma\tdemo/close" not in run("audit").stdout: die("self-test overdue classification must not depend on owner liveness", 1)
        env.pop("MESH_TASK_LIVE_OWNERS")
        run("progress", "demo", "close", str(artifact), "close", "2026-09-08T02:00:00Z")
        wrong_key = run("done", "demo", "not-the-key", str(artifact), expect=2)
        if "is not in chain" not in wrong_key.stderr: die("self-test wrong-key close was accepted", 1)
        run("done", "demo", "close", str(artifact), "closed pane:witness")
        run("done", "demo", "close", str(artifact), "closed pane:witness")
        # Autoland-mints-ledger probe (witness-autoland-posts-mint-ledger): settling
        # the demo chain must mint a genome-owned landing chain at post time and cite
        # it on the board — or the next board-only autoland post is untracked again.
        # FALSIFIABLE: revert ensure_autoland_task to post-without-mint and both FAILs fire.
        land_path = root / "mesh/chains" / ("autoland/demo/close".replace("/", "__") + ".json")
        if not land_path.exists():
            die("self-test autoland post did not mint a ledger chain at post time", 1)
        land_state = json.loads(land_path.read_text())
        if land_state["steps"][0]["owner"] != "genome" or land_state["steps"][0]["slug"] != "land":
            die("self-test autoland chain is not a genome-owned land step", 1)
        land_status = run("status", "autoland/demo/close")
        if "genome" not in land_status.stdout or "/land" not in land_status.stdout:
            die("self-test autoland chain is not routable via status", 1)
        if "ledger:autoland/demo/close/land" not in board.read_text():
            die("self-test autoland board post does not cite its ledger chain", 1)
        if not context.exists() or '"status": "done"' not in context.read_text():
            die("self-test completed task context was not retained for the final turn", 1)
        final = run("status", "demo")
        if "demo [complete]" not in final.stdout: die("self-test chain did not complete", 1)

        # Rejected predecessors remain terminal history. Their first
        # successor is visible as a hold until its exact owner supplies
        # artifact-backed recovery evidence.
        recovery_plan = root / "recovery.tsv"
        recovery_plan.write_text("alpha\thead\trejected head\nbeta\tcontinue\tcontinue after repair\ngamma\tverify\tverify later\n")
        env["MESH_TASK_ACTOR"] = "alpha"
        run("create", "recovery", str(recovery_plan)); run("take", "recovery", "head")
        run("reject", "recovery", "head", "verification failed")
        held = run("audit")
        if "HELD_REJECTED\tbeta\trecovery/continue\tpredecessor=recovery/head" not in held.stdout:
            die("self-test rejected successor was not exposed as a terminal-predecessor hold")
        wrong_recovery = run("recover", "recovery", "continue", "reactivate", str(artifact), "repair evidence", expect=2)
        if "exact owner required" not in wrong_recovery.stderr:
            die("self-test recovery accepted the wrong owner")
        env["MESH_TASK_ACTOR"] = "beta"
        run("recover", "recovery", "continue", "reactivate", str(artifact), "repair evidence")
        recovered = json.loads((root / "mesh/chains/recovery.json").read_text())
        if recovered["status"] != "open" or recovered["current"] != 1:
            die("self-test recovery did not reopen the first successor")
        if recovered["steps"][0]["status"] != "rejected" or recovered["steps"][1]["status"] != "open":
            die("self-test recovery changed rejection history or successor status")
        repeat = run("recover", "recovery", "continue", "reactivate", str(artifact), "repair evidence")
        if "already recovered recovery/continue" not in repeat.stdout:
            die("self-test recovery was not idempotent")

        hold_plan = root / "hold.tsv"
        hold_plan.write_text("alpha\thead\trejected head\nbeta\tcontinue\tunresolved verification\n")
        env["MESH_TASK_ACTOR"] = "alpha"
        run("create", "hold-recovery", str(hold_plan)); run("take", "hold-recovery", "head")
        run("reject", "hold-recovery", "head", "operator gate unresolved")
        env["MESH_TASK_ACTOR"] = "beta"
        run("recover", "hold-recovery", "continue", "hold", str(artifact), "operator gate unresolved")
        held_state = json.loads((root / "mesh/chains/hold-recovery.json").read_text())
        if held_state["status"] != "blocked" or held_state["steps"][1]["status"] != "blocked":
            die("self-test hold disposition did not preserve unresolved dependency")

        independent_plan = root / "independent.tsv"
        independent_plan.write_text("alpha\thead\tblocked prerequisite\nbeta\tverify\tindependent follow-up\n")
        env["MESH_TASK_ACTOR"] = "alpha"
        run("create", "independent", str(independent_plan))
        run("take", "independent", "head")
        run("block", "independent", "head", "external-event", "prerequisite", "retry after event")
        env["MESH_TASK_ACTOR"] = "beta"
        run("independent", "independent", "verify", "owner confirms no dependency on head")
        if run("check", "dispatch", "independent/verify", "beta").returncode != 0:
            die("self-test independent step was not dispatch eligible")
        if "independent/verify" not in run("queue", "--dispatch", "--owner", "beta").stdout:
            die("self-test owner queue omitted independent step")
        if "READY_INDEPENDENT\tbeta\tindependent/verify" not in run("audit").stdout:
            die("self-test audit omitted independent step state")
        run("take", "independent", "verify")
        run("done", "independent", "verify", str(artifact), "independent proof pane:witness")
        if "BLOCKED\talpha\tindependent/head" not in run("audit").stdout:
            die("self-test independent completion hid the blocked predecessor")
        env["MESH_TASK_ACTOR"] = "alpha"
        run("resume", "independent", "head", "prerequisite-ready")
        run("done", "independent", "head", str(artifact), "prerequisite complete pane:witness")
        if "independent [complete]" not in run("status", "independent").stdout:
            die("self-test ordered completion did not skip its settled independent step")
        # dispatch --retry driver: failed + expired rows redeliver under coordinator.
        retry_plan = root / "retry.tsv"
        retry_plan.write_text("alpha\ta\tfirst retry task\nalpha\tb\tsecond retry task\n")
        env["MESH_TASK_ACTOR"] = "alpha"
        run("create", "retry-failed", str(retry_plan))
        run("take", "retry-failed", "a")
        env["MESH_TASK_HANDOFF_FAIL"] = "1"
        run("done", "retry-failed", "a", str(artifact), "first done", expect=1)
        env.pop("MESH_TASK_HANDOFF_FAIL")
        expired_plan = root / "expired.tsv"
        expired_plan.write_text("alpha\ta\texpired lease task\n")
        env["MESH_TASK_LEASE_SECONDS"] = "-30"
        run("create", "retry-expired", str(expired_plan))
        env.pop("MESH_TASK_LEASE_SECONDS")
        env["MESH_TASK_ACTOR"] = "beta"
        refused = run("dispatch", "--retry", expect=2)
        if "coordinator required" not in refused.stderr:
            die("self-test dispatch --retry accepted a non-coordinator actor", 1)
        env["MESH_TASK_ACTOR"] = "witness"
        env["MESH_TASK_COORDINATOR"] = "witness"
        retry_out = run("dispatch", "--retry")
        import re as _re
        _m = _re.search(r"succeeded=(\d+)", retry_out.stdout)
        if not _m or int(_m.group(1)) < 2:
            die(f"self-test dispatch --retry did not redeliver both rows: {retry_out.stdout.strip()}", 1)
        healed = json.loads((root / "mesh/chains/retry-failed.json").read_text())
        if healed["dispatch"] != "sent" or int(healed.get("dispatch_attempts", 0)) != 1:
            die("self-test dispatch --retry did not mark the failed row sent with one attempt", 1)
        cap_plan = root / "cap.tsv"
        cap_plan.write_text("alpha\ta\tfirst cap task\nalpha\tb\tsecond cap task\n")
        env["MESH_TASK_ACTOR"] = "alpha"
        run("create", "retry-cap", str(cap_plan))
        run("take", "retry-cap", "a")
        env["MESH_TASK_HANDOFF_FAIL"] = "1"
        run("done", "retry-cap", "a", str(artifact), "cap done", expect=1)
        env.pop("MESH_TASK_HANDOFF_FAIL")
        env["MESH_TASK_ACTOR"] = "witness"
        env["MESH_TASK_DISPATCH_RETRIES"] = "0"
        cap_out = run("dispatch", "--retry")
        if "retried=0" not in cap_out.stdout or "exhausted=" not in cap_out.stdout:
            die(f"self-test dispatch --retry ignored the retry bound: {cap_out.stdout.strip()}", 1)
        import re as _re2
        if int(_re2.search(r"exhausted=(\d+)", cap_out.stdout).group(1)) < 1:
            die(f"self-test dispatch --retry exhausted nothing at cap 0: {cap_out.stdout.strip()}", 1)
        env.pop("MESH_TASK_DISPATCH_RETRIES")
        env["MESH_TASK_ACTOR"] = "alpha"
        # preflight gate (operator/constant-forgetting-20260916): a blocked resource claim
        # naming a registry domain is RED until its artifact cites the rev and records the
        # check; a recorded one passes; conflicting rows render UNKNOWN to the owner.
        pf_plan = root / "pf.tsv"
        pf_plan.write_text("alpha\tgpu-step\tresolve gpu contention\n")
        run("create", "preflight-demo", str(pf_plan))
        run("take", "preflight-demo", "gpu-step")
        run("block", "preflight-demo", "gpu-step", "capability", "gpu vram contention", "event:gpu-free")
        red = run("preflight", "preflight-demo", "gpu-step", expect=2)
        if "preflight RED" not in red.stderr:
            die("self-test preflight accepted a check-less resource claim", 1)
        pf_art = root / "pf-artifact.md"
        _live_rev, _ = registry_invariants()
        pf_art.write_text(f"rev: {_live_rev}\n\nollama ps: empty; managed-ownership read: mesh-owned.\n")
        run("resume", "preflight-demo", "gpu-step", "gpu-check-recorded")
        run("progress", "preflight-demo", "gpu-step", str(pf_art), "await gpu free", "2026-09-17T00:00:00Z")
        run("block", "preflight-demo", "gpu-step", "capability", "gpu vram contention", "event:gpu-free")
        if "PASS" not in run("preflight", "preflight-demo", "gpu-step").stdout:
            die("self-test preflight rejected a recorded check", 1)
        pf_art.write_text("rev: 20000101.0\n\nollama ps: empty.\n")
        run("resume", "preflight-demo", "gpu-step", "gpu-check-rerecorded")
        run("progress", "preflight-demo", "gpu-step", str(pf_art), "await gpu free", "2026-09-17T00:00:00Z")
        run("block", "preflight-demo", "gpu-step", "capability", "gpu vram contention", "event:gpu-free")
        stale = run("preflight", "preflight-demo", "gpu-step", expect=2)
        if "no registry rev" not in stale.stderr:
            die("self-test preflight accepted a stale rev", 1)
        conflict_genome = root / "conflict-genome"
        conflict_genome.mkdir()
        (conflict_genome / "AGENTS.md").write_text(
            "# C\n- `mesh:1` — node-owned x\n\n```invariant-registry\nrev: 1\n"
            "id=gpu.a | owner=tg | scope=node | precedence=10 | source=s | preflight=ollama ps\n"
            "id=gpu.b | owner=tg | scope=node | precedence=10 | source=s | preflight=nvidia-smi\n```\n")
        unknown = run("preflight", "preflight-demo", "gpu-step", expect=2,
                      env_extra={"MESH_GENOME": str(conflict_genome)})
        if "UNKNOWN" not in unknown.stderr:
            die("self-test preflight resolved a conflict instead of routing UNKNOWN", 1)
        # Lock-contention triage (chat.log 76984-77026 rc=124): a stuck holder
        # must refuse waiters LOUD within MESH_TASK_LOCK_TIMEOUT, never hang a
        # take into a timeout(1) kill; and a hung board writer must not hold
        # chain+owner locks forever (MESH_TASK_EMIT_TIMEOUT).
        import fcntl as _fcntl
        import hashlib as _hashlib
        import threading as _threading
        lock_plan = root / "lock.tsv"
        lock_plan.write_text("alpha\tinspect\tlock contention probe\n")
        run("create", "lockdemo", str(lock_plan))
        lock_file = root / "mesh/chains/.locks" / (_hashlib.sha256(b"chain:lockdemo").hexdigest() + ".lock")
        lock_file.parent.mkdir(parents=True, exist_ok=True)
        _release = _threading.Event()
        def _hold():
            with lock_file.open("a+", encoding="utf-8") as _h:
                _fcntl.flock(_h.fileno(), _fcntl.LOCK_EX)
                _release.wait(timeout=15)
                _fcntl.flock(_h.fileno(), _fcntl.LOCK_UN)
        _t = _threading.Thread(target=_hold, daemon=True)
        _t.start()
        _deadline = time.time() + 5
        while time.time() < _deadline:
            try:
                with lock_file.open("a+", encoding="utf-8") as _probe:
                    _fcntl.flock(_probe.fileno(), _fcntl.LOCK_EX | _fcntl.LOCK_NB)
                    _fcntl.flock(_probe.fileno(), _fcntl.LOCK_UN)
                time.sleep(0.05)
            except OSError:
                break
        _start = time.time()
        refused = run("take", "lockdemo", "inspect", expect=2,
                      env_extra={"MESH_TASK_LOCK_TIMEOUT": "1"})
        _waited = time.time() - _start
        _release.set()
        _t.join(timeout=20)
        if "lock-timeout" not in refused.stderr:
            die(f"self-test lock contention hung or mis-reported: {refused.stderr.strip()}", 1)
        if _waited > 10:
            die(f"self-test lock-timeout exceeded its bound: {_waited:.1f}s", 1)
        run("take", "lockdemo", "inspect")
        slow_chat = fake / "slow-chat"
        slow_chat.write_text("#!/bin/sh\nsleep 30\n")
        slow_chat.chmod(0o755)
        hung = run("done", "lockdemo", "inspect", str(artifact), "slow board proof",
                   expect=1, env_extra={"MESH_TASK_CHAT_CMD": str(slow_chat),
                                        "MESH_TASK_EMIT_TIMEOUT": "1"})
        if "board event failed" not in hung.stderr:
            die(f"self-test hung board writer was not refused loud: {hung.stderr.strip()}", 1)
        run("done", "lockdemo", "inspect", str(artifact), "lock triage proof pane:witness")
        # Parallel annotate across distinct chains under one owner all succeed.
        import concurrent.futures as _futures
        for _i in range(8):
            _p = root / f"par{_i}.tsv"
            _p.write_text(f"alpha\tstep{_i}\tparallel leg {_i}\n")
            run("create", f"pardemo{_i}", str(_p))
        with _futures.ThreadPoolExecutor(max_workers=8) as _pool:
            _results = list(_pool.map(lambda _i: run("annotate", f"pardemo{_i}", f"step{_i}", "evidence", str(artifact)), range(8)))
        if any(_r.returncode != 0 for _r in _results):
            die("self-test parallel mutation under one owner failed", 1)
        # route-unowned (operator-witness-dispatch-e051d618): dry-run reports,
        # --apply assigns table hits via the coordinator path, unknowns stay.
        _rp = root / "routeplan.tsv"
        _rp.write_text("-\ttriage\townerless health-warning triage\n")
        run("create", "health-warning-routedemo", str(_rp))
        _mp = root / "mysteryplan.tsv"
        _mp.write_text("-\tpuzzle\townerless step with no table hit\n")
        run("create", "mystery-thing", str(_mp))
        _dry = run("route-unowned")
        if "ROUTE\thealth-warning-routedemo/triage\thealth" not in _dry.stdout:
            die(f"self-test route-unowned dry-run missed table hit: {_dry.stdout.strip()}", 1)
        if "REVIEW\tmystery-thing/puzzle" not in _dry.stdout:
            die(f"self-test route-unowned dry-run missed unknown: {_dry.stdout.strip()}", 1)
        run("route-unowned", "--apply", expect=2)
        _live = {"MESH_TASK_ACTOR": "witness", "MESH_TASK_LIVE_OWNERS": "health discover witness"}
        _applied = run("route-unowned", "--apply", env_extra=_live)
        if "ROUTED\thealth-warning-routedemo/triage\thealth" not in _applied.stdout:
            die(f"self-test route-unowned --apply missed routing: {_applied.stdout.strip()}", 1)
        _st = run("status", "health-warning-routedemo")
        if "owner" not in _st.stdout and "health" not in _st.stdout:
            die(f"self-test route-unowned --apply did not persist owner: {_st.stdout.strip()}", 1)
        _q = run("queue", "--dispatch", "--owner=health")
        if "health-warning-routedemo/triage" not in _q.stdout:
            die("self-test routed step missing from owner dispatch queue", 1)
        _q2 = run("queue", "--dispatch", "--owner=discover")
        if "mystery-thing/puzzle" not in _q2.stdout:
            die("self-test unowned step missing from shared dispatch pool", 1)
    print("mesh-task: smoke-test ok (ordered tasks, independent pickup, exact owner, leases, blockers, artifacts)")


def main(argv: list[str]) -> None:
    if not argv or argv[0] in ("-h", "--help"):
        print("usage: mesh-task create <chain> <plan.tsv> [ask-key] | take <chain> <step> | independent <chain> <step> <reason> | done <chain> <step> <artifact> [result]")
        print("       plan.tsv rows: owner<TAB>step<TAB>description (priority 0) or owner<TAB>step<TAB>priority<TAB>description")
        print("       independent <chain> <step> <reason> (owner attests a later step can proceed while the current step is blocked)")
        print("       mesh-task progress <chain> <step> <artifact> <next-action> <next-update> | reprioritize <chain> <step> <priority> | annotate <chain> <step> <tags> <design_artifact> | block <chain> <step> <type> <needs> <retry>")
        print("       mesh-task reject <chain> <step> <reason> | recover <chain> <step> <reactivate|hold> <artifact> <reason> | wait-for <chain> <step> <prerequisite-task> | clear-wait <chain> <step> <reason> | resume <chain> <step> <event> | dispatch <chain> | dispatch --retry [--limit=N] | reschedule <chain> | reschedule-task <task> | unblock-sweep <owner> | reassign-owner <old> <new> <reason> | reassign <chain> <new-owner> <reason> | route-unowned [--apply] [--limit=N] | status <chain> | reconcile <owner> | preflight <chain> <step> | --test")
        print("       mesh-task replay --json  (read structured task-state records from chat.log)")
        print("       mesh-task queue --dispatch [--owner <mind>]  (canonical task-ledger dispatch order; optional exact-mind scope)")
        print("       mesh-task import | rebuild  (import existing chains; rebuild disposable caches)")
        print("       mesh-task check <dispatch|resume|pending> <task-id> <owner>  (0 eligible, 2 refused, 3 untracked, 1 unreadable)")
        return
    if argv[0] == "--test": test(); return
    command = argv[0]
    if command == "check" and len(argv) == 4:
        try:
            records = replay_task_log(Path(os.environ.get("MESH_CHAT_LOG", str(ROOT / "chat.log"))))
            raise SystemExit(check_eligibility(records, argv[2], argv[1], argv[3]))
        except (OSError, ValueError) as exc:
            die(str(exc), 1)
    if command == "replay" and argv[1:] == ["--json"]:
        try:
            records = replay_task_log(Path(os.environ.get("MESH_CHAT_LOG", str(ROOT / "chat.log"))))
            if not records:
                die("chat.log has no structured task-state records; chain recovery is not yet available", 2)
            print(json.dumps(records, ensure_ascii=False, sort_keys=True))
        except (OSError, ValueError) as exc:
            die(str(exc), 1)
        return
    if command == "queue" and argv[1:] in (["--dispatch"], ["--sort", "priority"]):
        dispatch_queue()
        return
    if command == "queue" and len(argv) == 3 and argv[1] == "--dispatch" and argv[2].startswith("--owner="):
        dispatch_queue(argv[2].split("=", 1)[1])
        return
    if command == "queue" and len(argv) == 4 and argv[1:3] == ["--dispatch", "--owner"]:
        dispatch_queue(argv[3])
        return
    mutating = {"create", "take", "independent", "done", "reject", "ignore", "progress", "reprioritize", "annotate", "block", "wait-for", "clear-wait", "resume", "recover", "dispatch",
                "reschedule", "reschedule-task", "unblock-sweep", "reassign-owner", "reassign", "route-unowned", "reconcile", "import", "rebuild"}
    # The append-only task ledger arbitrates its own revision. A mutation only
    # serializes the chain and owner resources it can actually conflict with;
    # a slow board helper for one chain cannot halt unrelated mesh work.
    lock = resource_locks(mutation_resources(argv)) if command in mutating else contextlib.nullcontext()
    with lock:
        try:
            if command in ("create", "import"):
                task_records(allow_missing=True)
            if command == "create" and len(argv) in (3, 4): create(*argv[1:])
            elif command == "take" and len(argv) == 3: take(*argv[1:])
            elif command == "independent" and len(argv) >= 4: mark_independent(argv[1], argv[2], " ".join(argv[3:]))
            elif command == "done" and len(argv) >= 4: done(argv[1], argv[2], argv[3], " ".join(argv[4:]))
            elif command == "ignore" and len(argv) >= 3: ignore(argv[1], argv[2], " ".join(argv[3:]))
            elif command == "reject" and len(argv) >= 3: reject(argv[1], argv[2], " ".join(argv[3:]))
            elif command == "progress" and len(argv) == 6: progress(*argv[1:])
            elif command == "reprioritize" and len(argv) == 4: reprioritize(*argv[1:])
            elif command == "annotate" and len(argv) == 5: annotate(*argv[1:])
            elif command == "block" and len(argv) == 6: block(*argv[1:])
            elif command == "preflight" and len(argv) == 3: preflight(*argv[1:])
            elif command == "wait-for" and len(argv) == 4: wait_for(*argv[1:])
            elif command == "clear-wait" and len(argv) >= 4: clear_wait(argv[1], argv[2], " ".join(argv[3:]))
            elif command == "resume" and len(argv) == 4: unblock(*argv[1:])
            elif command == "dispatch" and argv[1:] in (["--retry"], ["--retry-all"]): retry_failed_dispatches()
            elif command == "dispatch" and len(argv) == 3 and argv[1] == "--retry": retry_failed_dispatches(int(argv[2].split("=", 1)[1]) if argv[2].startswith("--limit=") else 0)
            elif command == "dispatch" and len(argv) == 2: retry_dispatch(*argv[1:])
            elif command == "reschedule" and len(argv) == 2: reschedule_chain(argv[1])
            elif command == "reschedule-task" and len(argv) == 2: reschedule_task(argv[1])
            elif command == "recover" and len(argv) >= 5: recover(argv[1], argv[2], argv[3], argv[4], " ".join(argv[5:]))
            elif command == "unblock-sweep" and len(argv) == 1: unblock_sweep()
            elif command == "unblock-sweep" and len(argv) == 2: unblock_sweep(argv[1])
            elif command == "reassign-owner" and len(argv) >= 4: reassign_owner(argv[1], argv[2], " ".join(argv[3:]))
            elif command == "reassign" and len(argv) >= 4: reassign(argv[1], argv[2], " ".join(argv[3:]))
            elif command == "route-unowned": route_unowned(
                apply="--apply" in argv[1:],
                limit=int(next((a.split("=", 1)[1] for a in argv[1:] if a.startswith("--limit=")), 0)))
            elif command == "status" and len(argv) == 2: status(argv[1])
            elif command == "reconcile" and len(argv) == 2: reconcile(argv[1])
            elif command == "audit" and len(argv) == 1: audit()
            elif command == "import" and len(argv) == 1: import_chains()
            elif command == "rebuild" and len(argv) == 1: rebuild()
            else: die("invalid arguments (use --help)")
        except (OSError, ValueError) as exc:
            die(str(exc), 1)


if __name__ == "__main__":
    main(sys.argv[1:])
