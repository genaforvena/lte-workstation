#!/usr/bin/env bash
# mesh-health-state — aggregated .mesh-health artifact for all health loops.
# Reads the individual per-aspect state files (~/.mesh/.*-state) and fuses them
# into one canonical verdict.  Every health tool (mesh-health, mesh-hw-health,
# mesh-card --refresh, mesh-fleet-health) can read this instead of re-probing.
#
#   mesh-health-state         print verdict + detail; write ~/.mesh/.mesh-health
#   mesh-health-state --json  machine-readable JSON to stdout
#   mesh-health-state --check read-only check, no write
#   mesh-health-state --test  smoke test (synthetic state files)
# reflex-cadence: */3 * * * *
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
MESH="$HOME/.mesh"
OUT="$MESH/.mesh-health"

ts(){ date -u +%FT%TZ; }

# Known health state files and their logical names.
# Format: name|file|acceptable-values (first = "good")
DECLARE=(
  "hw|.hw-health.state|HW: OK"
  "reflex|.reflex-health-state|OK"
  "stress|.stress-state|CALM OK"
  "egress|.egress-state|OK"
  "therm|.therm-state|OK"
  "router_thermal|.router-thermal-state|cool OK"
  "resource|.resource-guard-state|OK"
  "mind|.mind-state-health|OK"
)

agg_verdict(){ # reads DECLARE + /tmp/.mesh-health-state-checks; echoes OK|WARN|FAIL
  local fail=0 warn=0
  local v
  for v in /tmp/.mesh-health-state-ok /tmp/.mesh-health-state-warn /tmp/.mesh-health-state-fail; do
    [ -f "$v" ] && rm -f "$v"
  done
  for entry in "${DECLARE[@]}"; do
    local name="${entry%%|*}" rest="${entry#*|}"
    local file="${rest%%|*}" acceptable="${rest#*|}"
    local verdict
    verdict=$(cat "$MESH/$file" 2>/dev/null || echo "MISSING")
    local good=0
    for a in $acceptable; do
      case "$verdict" in
        "$a"|"$a"*) good=1; ;;
      esac
    done
    if [ "$good" = 1 ]; then
      echo "$verdict" > "/tmp/.mesh-health-state-ok"
    else
      case "$verdict" in
        FAIL*|STALE*|CRITICAL*|STRESSED*|fail*|stale*)
          echo "$verdict" > "/tmp/.mesh-health-state-fail"; fail=1 ;;
        *)
          echo "$verdict" > "/tmp/.mesh-health-state-warn"; warn=1 ;;
      esac
    fi
  done
  rm -f /tmp/.mesh-health-state-ok /tmp/.mesh-health-state-warn /tmp/.mesh-health-state-fail
  [ "$fail" = 1 ] && echo FAIL && return
  [ "$warn" = 1 ] && echo WARN && return
  echo OK
}

agg_json(){
  local verdict="$1"
  local checks="{"
  local sep=""
  for entry in "${DECLARE[@]}"; do
    local name="${entry%%|*}" rest="${entry#*|}"
    local file="${rest%%|*}"
    local val
    val=$(cat "$MESH/$file" 2>/dev/null || echo "MISSING")
    val="${val%%$'\n'*}"
    val=$(printf '%s' "$val" | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read().strip()))' 2>/dev/null || echo '"?"')
    checks="$checks${sep}\"$name\":{\"verdict\":$val,\"source\":\"$file\"}"
    sep=","
  done
  checks="$checks}"
  printf '{"ts":"%s","hostname":"%s","verdict":"%s","checks":%s}\n' "$(ts)" "$(hostname)" "$verdict" "$checks"
}

if [ "${1:-}" = --test ]; then
  TMP="$(mktemp -d)"
  trap 'rm -rf "$TMP"' EXIT
  mkdir -p "$TMP/.mesh"
  MESH="$TMP/.mesh"
  OUT="$MESH/.mesh-health"
  # Create synthetic state files
  echo "HW: OK" > "$MESH/.hw-health.state"
  echo "OK" > "$MESH/.reflex-health-state"
  echo "CALM" > "$MESH/.stress-state"
  echo "OK" > "$MESH/.egress-state"
  echo "OK" > "$MESH/.therm-state"
  echo "cool" > "$MESH/.router-thermal-state"
  echo "OK" > "$MESH/.resource-guard-state"
  echo "OK" > "$MESH/.mind-state-health"
  # All healthy → OK
  v=$(agg_verdict)
  [ "$v" = OK ] || { echo "smoke-test: FAIL (all-ok verdict=$v)"; exit 1; }
  # One FAIL → overall FAIL
  echo "FAIL: disk dead" > "$MESH/.hw-health.state"
  v=$(agg_verdict)
  [ "$v" = FAIL ] || { echo "smoke-test: FAIL (hw-fail verdict=$v)"; exit 1; }
  # Reset hw
  echo "HW: OK" > "$MESH/.hw-health.state"
  # One WARN → overall WARN
  echo "WARN: load high" > "$MESH/.stress-state"
  v=$(agg_verdict)
  [ "$v" = WARN ] || { echo "smoke-test: FAIL (stress-warn verdict=$v)"; exit 1; }
  # Missing file → MESSING
  rm -f "$MESH/.egress-state"
  v=$(agg_verdict)
  [ "$v" = WARN ] || { echo "smoke-test: FAIL (missing-file verdict=$v)"; exit 1; }
  # --json output parses
  out=$(agg_json "OK")
  printf '%s' "$out" | python3 -m json.tool >/dev/null 2>&1 || { echo "smoke-test: FAIL (json not parseable)"; exit 1; }
  echo "smoke-test: ok (all-verdict + degraded + json-parse)"
  exit 0
fi

# Main
v=$(agg_verdict)
json=$(agg_json "$v")
printf '%s\n' "$json" > "$OUT"

if [ "${1:-}" = --json ]; then
  printf '%s\n' "$json"
elif [ "${1:-}" = --check ]; then
  echo "mesh-health-state: $v — $(hostname) @ $(ts)"
  printf '%s' "$json" | python3 -c "
import json,sys
d=json.load(sys.stdin)
for name,ch in d.get('checks',{}).items():
    print(f'  {name}: {ch[\"verdict\"]} ({ch[\"source\"]})')
" 2>/dev/null
  [ "$v" = FAIL ] && exit 1
  exit 0
else
  echo "mesh-health-state: $v — $(hostname) @ $(ts)"
  printf '%s' "$json" | python3 -c "
import json,sys
d=json.load(sys.stdin)
for name,ch in d.get('checks',{}).items():
    print(f'  {name}: {ch[\"verdict\"]} ({ch[\"source\"]})')
" 2>/dev/null
  exit 0
fi
