#!/usr/bin/env bash
# mesh-health-state — aggregated .mesh-health artifact for all health loops.
# Reads the individual per-aspect state files (~/.mesh/.*-state) and fuses them
# into one canonical verdict.  Every health tool (mesh-health, mesh-hw-health,
# mesh-card --refresh, mesh-fleet-health) can read this instead of re-probing.
#
#   mesh-health-state         print verdict + detail; write ~/.mesh/.mesh-health
#   mesh-health-state --json  machine-readable JSON to stdout
#   mesh-health-state --check read-only check, no write
#   mesh-health-state --test  smoke test (synthetic state files)
# reflex-cadence: */3 * * * *
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
MESH="$HOME/.mesh"
OUT="$MESH/.mesh-health"

ts(){ date -u +%FT%TZ; }

# ============================ PASK'S PRUNE: DERIVATIONS MUST DIFFER ============================
# (literature review 2026-08-26, second-order cybernetics — Pask's entailment meshes / THOUGHTSTICKER,
# via Heylighen, "Bootstrapping knowledge representations: from entailment meshes via semantic nets to
# learning webs", Kybernetes 30(5/6) 2001, pespmc1.vub.ac.be/Papers/Pask-Bootstrapping.pdf, pp.6-8.
# Artifact: docs/reviews/second-order-cyb-pask-prune-derivational-ambiguity-health-state-2026-08-26.md)
#
# THE RULE, verbatim: "The main function of the Prune operation is to discover structural ambiguities
# or conflicts in a mesh. An ambiguity arises when different topics are derived in the same way. In
# that case, there is no way to distinguish the topics within the mesh."
#
# It is a check on the REPRESENTATION, not on the measurement, and it runs BEFORE any incident: for
# every verdict a tool can emit, write down the premises it is derived from; if two DISTINCT verdicts
# carry the SAME premise set, the tool cannot tell them apart no matter how correct each probe is.
# This tool had a live instance of exactly that, and it was three topics deep, not two:
#
#   (a) an aspect genuinely DEGRADED,
#   (b) an aspect whose state file is ABSENT — never written, or the organ does not exist on this node,
#   (c) an aspect reporting a token the registry below has simply never learned,
#
# all derived identically: "not in the acceptable set" -> WARN. MEASURED on this node 2026-08-26T00:33Z,
# where the whole node had been reading WARN: stress=WARM, mind=IDLE (both HEALTHY words this registry
# does not know) and router_thermal=unreachable-down (a router we could not reach — a COVERAGE fact,
# not a health fact). Zero aspects were actually degraded. The one word could not say so.
#
# Pask's four repairs are merge-topics / ADD-TOPIC / split-topic / merge-coherences. This takes ADD
# TOPIC, the minimal one: each entry may declare a fourth field, the tokens that mean UNMEASURED for
# THAT aspect, so "unmeasured" acquires a derivation of its own instead of sharing "degraded"'s. A
# token in neither set is a REGISTRY GAP and is named as such — never silently folded into the
# acceptable set, which would be the guard-widening this doctrine refuses (CLAUDE.md, an-exclusion-
# allowlist-fails-toward-silence-so-invert-the-polarity).
#
# THE AGGREGATE WORD IS DELIBERATELY UNCHANGED: OK|WARN|FAIL, same mapping as before (unmeasured and
# unrecognized both still WARN, absent still WARN, FAIL* still FAIL). A new top-level word would
# outrun every consumer's alphabet (CLAUDE.md, a-new-verdict-word-must-be-in-the-consumers-alphabet)
# for no gain — grepped 2026-08-26, NOTHING in the genome parses this file's `verdict` string; the
# readers are a human, a mind, and mesh-pulse (which reads FRESHNESS only). So the ambiguity is
# resolved where it is actually read: the per-check `class` field, the `coverage` term, and the
# render, which now decomposes the WARN instead of asserting it.
#
# Known health state files and their logical names.
# Format: name|file|acceptable-values (first = "good")[|tokens-that-mean-UNMEASURED-for-this-aspect]
# Both sets are prefix-matched, exactly like the acceptable set has always been.
DECLARE=(
  "hw|.hw-health.state|HW: OK"
  "reflex|.reflex-health-state|OK"
  "stress|.stress-state|CALM OK"
  "egress|.egress-state|OK"
  "therm|.therm-state|OK"
  "router_thermal|.router-thermal-state|cool OK|unreachable"
  "resource|.resource-guard-state|OK"
  "mind|.mind-state-health|OK"
)

decl_fields(){  # $1=DECLARE entry -> sets _dn/_df/_da/_du (name, file, acceptable, unmeasured)
  local rest
  _dn="${1%%|*}"; rest="${1#*|}"
  _df="${rest%%|*}"; rest="${rest#*|}"
  _du=""
  case "$rest" in *"|"*) _du="${rest#*|}"; _da="${rest%%|*}" ;; *) _da="$rest" ;; esac
}

check_value(){  # $1=state file -> the value to RENDER (unchanged wording: absent still reads MISSING)
  cat "$MESH/$1" 2>/dev/null || echo "MISSING"
}

check_class(){  # $1=state file  $2=acceptable set  $3=unmeasured set -> good|fail|unmeasured|unrecognized
  local v a
  # ABSENCE IS READ FROM THE FILESYSTEM, NEVER FROM A SENTINEL STRING. Deciding it by the word
  # "MISSING" would make a state file whose CONTENT is that word indistinguishable from one that does
  # not exist — the very ambiguity this block is here to remove, one ring down.
  [ -r "$MESH/$1" ] || { echo unmeasured; return; }
  v=$(cat "$MESH/$1" 2>/dev/null); v="${v%%$'\n'*}"
  for a in $2; do case "$v" in "$a"|"$a"*) echo good; return ;; esac; done
  # HARD FAIL OUTRANKS A DECLARED UNMEASURED TOKEN, always: a declaration must never be able to buy
  # silence for a real failure, so the one ordering that can only fail LOUD is the one taken.
  case "$v" in FAIL*|STALE*|CRITICAL*|STRESSED*|fail*|stale*) echo fail; return ;; esac
  for a in $3; do case "$v" in "$a"|"$a"*) echo unmeasured; return ;; esac; done
  echo unrecognized
}

agg_verdict(){ # reads DECLARE + /tmp/.mesh-health-state-checks; echoes OK|WARN|FAIL
  local fail=0 warn=0
  local v
  for v in /tmp/.mesh-health-state-ok /tmp/.mesh-health-state-warn /tmp/.mesh-health-state-fail; do
    [ -f "$v" ] && rm -f "$v"
  done
  for entry in "${DECLARE[@]}"; do
    local _dn _df _da _du cls
    decl_fields "$entry"
    # The AGGREGATE mapping is byte-identical to what it always was — good->OK, hard fail->FAIL,
    # everything else (absent / unmeasured / unrecognized) -> WARN. What changed is that the three
    # WARN sources now have three different derivations, and agg_json/the render publish which.
    cls=$(check_class "$_df" "$_da" "$_du")
    case "$cls" in
      good) ;;
      fail) fail=1 ;;
      *)    warn=1 ;;
    esac
  done
  rm -f /tmp/.mesh-health-state-ok /tmp/.mesh-health-state-warn /tmp/.mesh-health-state-fail
  [ "$fail" = 1 ] && echo FAIL && return
  [ "$warn" = 1 ] && echo WARN && return
  echo OK
}

agg_json(){
  local verdict="$1"
  local checks="{"
  local sep=""
  local n_decl=0 n_meas=0 unmeas_l="" unrec_l="" degr_l=""
  for entry in "${DECLARE[@]}"; do
    local _dn _df _da _du val cls
    decl_fields "$entry"
    cls=$(check_class "$_df" "$_da" "$_du")
    val=$(check_value "$_df")
    val="${val%%$'\n'*}"
    val=$(printf '%s' "$val" | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read().strip()))' 2>/dev/null || echo '"?"')
    checks="$checks${sep}\"$_dn\":{\"verdict\":$val,\"source\":\"$_df\",\"class\":\"$cls\"}"
    sep=","
    n_decl=$((n_decl+1))
    case "$cls" in
      unmeasured)   unmeas_l="$unmeas_l${unmeas_l:+,}$_dn" ;;
      unrecognized) unrec_l="$unrec_l${unrec_l:+,}$_dn"; n_meas=$((n_meas+1)) ;;
      fail)         degr_l="$degr_l${degr_l:+,}$_dn"; n_meas=$((n_meas+1)) ;;
      *)            n_meas=$((n_meas+1)) ;;
    esac
  done
  checks="$checks}"
  # COVERAGE TRAVELS WITH THE VERDICT (CLAUDE.md, a-senses-coverage-is-window-over-cadence / the
  # honest-fusion rule): an aspect nobody could measure is not an aspect that is fine, and it is not
  # an aspect that is degraded either. measured/declared says how much of the node this word covers.
  printf '{"ts":"%s","hostname":"%s","verdict":"%s","coverage":"%s/%s","unmeasured":"%s","unrecognized":"%s","failing":"%s","checks":%s}\n' \
    "$(ts)" "$(hostname)" "$verdict" "$n_meas" "$n_decl" "$unmeas_l" "$unrec_l" "$degr_l" "$checks"
}

if [ "${1:-}" = --test ]; then
  TMP="$(mktemp -d)"
  trap 'rm -rf "$TMP"' EXIT
  mkdir -p "$TMP/.mesh"
  MESH="$TMP/.mesh"
  OUT="$MESH/.mesh-health"
  # Create synthetic state files
  echo "HW: OK" > "$MESH/.hw-health.state"
  echo "OK" > "$MESH/.reflex-health-state"
  echo "CALM" > "$MESH/.stress-state"
  echo "OK" > "$MESH/.egress-state"
  echo "OK" > "$MESH/.therm-state"
  echo "cool" > "$MESH/.router-thermal-state"
  echo "OK" > "$MESH/.resource-guard-state"
  echo "OK" > "$MESH/.mind-state-health"
  # All healthy → OK
  v=$(agg_verdict)
  [ "$v" = OK ] || { echo "smoke-test: FAIL (all-ok verdict=$v)"; exit 1; }
  # One FAIL → overall FAIL
  echo "FAIL: disk dead" > "$MESH/.hw-health.state"
  v=$(agg_verdict)
  [ "$v" = FAIL ] || { echo "smoke-test: FAIL (hw-fail verdict=$v)"; exit 1; }
  # Reset hw
  echo "HW: OK" > "$MESH/.hw-health.state"
  # One WARN → overall WARN
  echo "WARN: load high" > "$MESH/.stress-state"
  v=$(agg_verdict)
  [ "$v" = WARN ] || { echo "smoke-test: FAIL (stress-warn verdict=$v)"; exit 1; }
  # Missing file → MESSING
  rm -f "$MESH/.egress-state"
  v=$(agg_verdict)
  [ "$v" = WARN ] || { echo "smoke-test: FAIL (missing-file verdict=$v)"; exit 1; }
  # --json output parses
  out=$(agg_json "OK")
  printf '%s' "$out" | python3 -m json.tool >/dev/null 2>&1 || { echo "smoke-test: FAIL (json not parseable)"; exit 1; }
  echo "smoke-test: ok (all-verdict + degraded + json-parse)"

  # ---- PASK PRUNE arms: DISTINCT TOPICS MUST HAVE DISTINCT DERIVATIONS (see the block at the top).
  # Restore a clean fixture first — the arms above left hw/stress mutated and .egress-state deleted.
  echo "HW: OK" > "$MESH/.hw-health.state"; echo "CALM" > "$MESH/.stress-state"; echo "OK" > "$MESH/.egress-state"
  # (1) THE AMBIGUITY ITSELF, and it is the arm that was RED before this landed: an ABSENT aspect and
  #     an aspect reporting an unknown token used to derive identically ("not acceptable" -> WARN).
  #     They must now be two topics. This fails the moment the classes collapse again.
  rm -f "$MESH/.router-thermal-state"
  _c_absent=$(check_class .router-thermal-state "cool OK" "unreachable")
  echo "WARM" > "$MESH/.stress-state"
  _c_unrec=$(check_class .stress-state "CALM OK" "")
  [ "$_c_absent" = unmeasured ] && [ "$_c_unrec" = unrecognized ] \
    || { echo "smoke-test: FAIL (an ABSENT aspect and an UNKNOWN-TOKEN aspect are not distinguishable: absent=$_c_absent unknown=$_c_unrec)"; exit 1; }
  [ "$_c_absent" != "$_c_unrec" ] \
    || { echo "smoke-test: FAIL (two distinct topics share one derivation — the Prune ambiguity is back)"; exit 1; }
  # (2) a DECLARED unmeasured token gets its own derivation, distinct from a degraded one on the SAME
  #     aspect. Without the 4th DECLARE field both are 'unrecognized' and the coverage term is a lie.
  echo "unreachable-down" > "$MESH/.router-thermal-state"
  [ "$(check_class .router-thermal-state "cool OK" "unreachable")" = unmeasured ] \
    || { echo "smoke-test: FAIL (a declared UNMEASURED token did not classify as unmeasured)"; exit 1; }
  [ "$(check_class .router-thermal-state "cool OK" "")" = unrecognized ] \
    || { echo "smoke-test: FAIL (the DECLARATION is not what is doing the work — the same token classifies unmeasured with an empty unmeasured-set)"; exit 1; }
  # (3) THE DECLARATION MUST NEVER BUY SILENCE FOR A REAL FAILURE: a hard-fail token that ALSO matches
  #     the aspect's unmeasured prefix still reads fail. Ordering is the whole guard.
  echo "FAIL: unreachable and on fire" > "$MESH/.router-thermal-state"
  [ "$(check_class .router-thermal-state "cool OK" "FAIL unreachable")" = fail ] \
    || { echo "smoke-test: FAIL (a declared unmeasured token outranked a HARD FAIL — a declaration bought silence)"; exit 1; }
  # (4) ABSENCE IS A FILESYSTEM FACT, NOT A STRING. A state file whose CONTENT is the sentinel must not
  #     read as absent, or the fix re-creates the ambiguity it removes one ring down.
  echo "MISSING" > "$MESH/.router-thermal-state"
  [ "$(check_class .router-thermal-state "cool OK" "unreachable")" = unrecognized ] \
    || { echo "smoke-test: FAIL (a file CONTAINING the sentinel read as an ABSENT file)"; exit 1; }
  # (5) NO FAKED ALL-CLEAR: an unmeasured aspect keeps the aggregate at WARN, never OK — the honest-
  #     fusion rule. (And the aggregate alphabet stays OK|WARN|FAIL: no new word reaches a consumer.)
  echo "cool" > "$MESH/.router-thermal-state"; echo "CALM" > "$MESH/.stress-state"
  [ "$(agg_verdict)" = OK ] || { echo "smoke-test: FAIL (all-good fixture is not OK — the control arm is broken)"; exit 1; }
  rm -f "$MESH/.router-thermal-state"
  [ "$(agg_verdict)" = WARN ] || { echo "smoke-test: FAIL (an UNMEASURED aspect did not hold the aggregate at WARN — a faked all-clear)"; exit 1; }
  # (6) COVERAGE IS PUBLISHED AND COUNTS: one absent aspect out of the eight declared.
  out=$(agg_json "WARN")
  printf '%s' "$out" | grep -q '"coverage":"7/8"' \
    || { echo "smoke-test: FAIL (coverage term missing or miscounted with 1 of 8 aspects absent): $out"; exit 1; }
  printf '%s' "$out" | grep -q '"unmeasured":"router_thermal"' \
    || { echo "smoke-test: FAIL (the unmeasured aspect is not NAMED in the reading): $out"; exit 1; }
  printf '%s' "$out" | grep -q '"class":"unmeasured"' \
    || { echo "smoke-test: FAIL (per-check class is not published — the distinction exists nowhere a reader can see it): $out"; exit 1; }
  echo "smoke-test: ok (Pask prune: an ABSENT aspect, a DECLARED-unmeasured one, an unknown TOKEN and a genuine FAIL each derive differently; a declaration cannot outrank a hard fail; absence is a filesystem fact not a string; an unmeasured aspect still holds the aggregate at WARN; coverage + names are published)"
  exit 0
fi

# Main
v=$(agg_verdict)
json=$(agg_json "$v")
# --check is DOCUMENTED read-only (:9) and used to write $OUT anyway. mesh-pulse watches this file's
# FRESHNESS (mesh-pulse:113), so a hand-run --check refreshed the very liveness evidence it claims
# only to inspect — the dry-run-forges-its-own-evidence class (CLAUDE.md, a-dry-run-that-writes-the-
# liveness-log-forges-its-own-evidence). The cadenced run and --json still write.
if [ "${1:-}" != --check ]; then
  printf '%s\n' "$json" > "$OUT"
fi

if [ "${1:-}" = --json ]; then
  printf '%s\n' "$json"
elif [ "${1:-}" = --check ]; then
  echo "mesh-health-state: $v — $(hostname) @ $(ts)"
  printf '%s' "$json" | python3 -c "
import json,sys
d=json.load(sys.stdin)
# Pask prune: a reading that cannot say WHY it is not OK is a reading whose topics share a derivation.
print(f'  coverage: {d.get(\"coverage\",\"?\")} aspects measured'
      + (f' | unmeasured: {d[\"unmeasured\"]}' if d.get('unmeasured') else '')
      + (f' | token-not-in-registry: {d[\"unrecognized\"]}' if d.get('unrecognized') else '')
      + (f' | FAILING: {d[\"failing\"]}' if d.get('failing') else ' | failing: none'))
for name,ch in d.get('checks',{}).items():
    print(f'  {name}: {ch[\"verdict\"]} [{ch.get(\"class\",\"?\")}] ({ch[\"source\"]})')
" 2>/dev/null
  [ "$v" = FAIL ] && exit 1
  exit 0
else
  echo "mesh-health-state: $v — $(hostname) @ $(ts)"
  printf '%s' "$json" | python3 -c "
import json,sys
d=json.load(sys.stdin)
# Pask prune: a reading that cannot say WHY it is not OK is a reading whose topics share a derivation.
print(f'  coverage: {d.get(\"coverage\",\"?\")} aspects measured'
      + (f' | unmeasured: {d[\"unmeasured\"]}' if d.get('unmeasured') else '')
      + (f' | token-not-in-registry: {d[\"unrecognized\"]}' if d.get('unrecognized') else '')
      + (f' | FAILING: {d[\"failing\"]}' if d.get('failing') else ' | failing: none'))
for name,ch in d.get('checks',{}).items():
    print(f'  {name}: {ch[\"verdict\"]} [{ch.get(\"class\",\"?\")}] ({ch[\"source\"]})')
" 2>/dev/null
  exit 0
fi
