#!/usr/bin/env bash
# mesh-battery-rate - local battery electrical flow sense.
# Reads sysfs battery telemetry and reports charge/discharge power in watts.
# This complements mesh-power: mesh-power knows AC/BATTERY and capacity, while this sense perceives
# the instantaneous electrical rate (how fast the node is charging or burning energy).
#
#   mesh-battery-rate         one power-flow line
#   mesh-battery-rate --json  machine-readable {state,watts,status,battery,source,ts}
#   mesh-battery-rate --test  fixture-backed parser/classifier smoke test
#
# Exit codes:
#   0 = real battery-rate artifact produced
#   2 = no readable battery rate source on this node; never fakes a reading
set -uo pipefail

PS="${MESH_POWER_SUPPLY_DIR:-/sys/class/power_supply}"

find_battery() {
  for b in "$PS"/BAT* "$PS"/battery; do
    [ -d "$b" ] || continue
    if [ -r "$b/power_now" ] || { [ -r "$b/voltage_now" ] && { [ -r "$b/current_now" ] || [ -r "$b/current_avg" ]; }; }; then
      printf '%s\n' "$b"
      return 0
    fi
  done
  return 2
}

read_rate() {
  local b="$1" uw="" uv="" ua="" source=""
  if [ -r "$b/power_now" ]; then
    uw="$(cat "$b/power_now" 2>/dev/null)"
    source="power_now"
  else
    uv="$(cat "$b/voltage_now" 2>/dev/null)"
    if [ -r "$b/current_now" ]; then
      ua="$(cat "$b/current_now" 2>/dev/null)"
      source="voltage_now*current_now"
    else
      ua="$(cat "$b/current_avg" 2>/dev/null)"
      source="voltage_now*current_avg"
    fi
    [ -n "$uv" ] && [ -n "$ua" ] || return 2
    uw="$(awk -v uv="$uv" -v ua="$ua" 'BEGIN{printf "%.0f", (uv * ua) / 1000000}')"
  fi
  [ -n "$uw" ] || return 2
  awk -v uw="$uw" -v source="$source" 'BEGIN{
    if (uw !~ /^[0-9]+([.][0-9]+)?$/) exit 2
    printf "%.2f %s\n", uw / 1000000, source
  }'
}

classify_rate() {
  awk -v watts="$1" -v status="$2" 'BEGIN{
    s=toupper(status)
    if (s ~ /DISCHARG/) state="DISCHARGING"
    else if (s ~ /CHARG/) state="CHARGING"
    else state="UNKNOWN"
    if (watts >= 20) load="HIGH"
    else if (watts >= 8) load="MODERATE"
    else load="LOW"
    print state, load
  }'
}

if [ "${1:-}" = --test ]; then
  command -v awk >/dev/null 2>&1 || { echo "smoke-test: FAIL (no awk)"; exit 1; }
  td="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
  trap 'rm -rf "$td"' EXIT
  mkdir -p "$td/BAT0"
  printf '12000000\n' > "$td/BAT0/power_now"
  got="$(MESH_POWER_SUPPLY_DIR="$td" bash "$0" --json 2>/dev/null || true)"
  printf '%s\n' "$got" | grep -q '"watts":12.00' || { echo "smoke-test: FAIL (power_now fixture: $got)"; exit 1; }
  rm -f "$td/BAT0/power_now"
  printf '11000000\n' > "$td/BAT0/voltage_now"
  printf '2000000\n' > "$td/BAT0/current_now"
  got="$(MESH_POWER_SUPPLY_DIR="$td" bash "$0" --json 2>/dev/null || true)"
  printf '%s\n' "$got" | grep -q '"watts":22.00' || { echo "smoke-test: FAIL (voltage/current fixture: $got)"; exit 1; }
  class="$(classify_rate 22 Discharging)"
  [ "$class" = "DISCHARGING HIGH" ] || { echo "smoke-test: FAIL (classifier got $class)"; exit 1; }
  rm -rf "$td/BAT0"
  if MESH_POWER_SUPPLY_DIR="$td" bash "$0" >/dev/null 2>&1; then
    echo "smoke-test: FAIL (missing battery should exit 2)"
    exit 1
  fi
  echo "smoke-test: ok (battery rate fixtures + missing-source exit)"
  exit 0
fi

b="$(find_battery)" || { echo "battery-rate: UNREACHABLE - no readable battery rate source" >&2; exit 2; }
read -r watts source <<<"$(read_rate "$b" 2>/dev/null || true)"
[ -n "${watts:-}" ] || { echo "battery-rate: UNREACHABLE - battery rate unreadable" >&2; exit 2; }
status="$(cat "$b/status" 2>/dev/null || echo unknown)"
read -r state load <<<"$(classify_rate "$watts" "$status")"
bname="$(basename "$b")"
ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

case "${1:-}" in
  --json)
    printf '{"state":"%s","load":"%s","watts":%s,"status":"%s","battery":"%s","source":"%s","ts":"%s"}\n' \
      "$state" "$load" "$watts" "$status" "$bname" "$source" "$ts"
    ;;
  *)
    printf '[battery-rate] %s %s %.2fW status=%s battery=%s source=%s\n' \
      "$state" "$load" "$watts" "$status" "$bname" "$source"
    ;;
esac
