#!/usr/bin/env bash
# mesh-gate-evolve — deploy shim for the uxn gates-as-data autopoiesis reflex (stage 4b,
# spec docs/superpowers/specs/2026-07-23-uxn-predicate-engine-design.md).
#
# The real tool lives WITH its ROMs and admission harness at scripts/uxn/mesh-gate-evolve (its
# $here-relative ledger/evaluator/test resolution needs the genome dir — not sync-tools-deployed).
# This thin exec makes it PATH-visible and autowirable, closing the never-wired-reflex hole
# (cc617e5) for the admission door: stage 3 built mesh-gate-admission, and until this cadence
# NOTHING walked through it unattended. Each firing drives at most one candidate to a logged
# verdict (~/.mesh/gate-admission.log) — drain a parked candidate first, else one mesh-relay
# proposal from the gate-goals rotation; capacity-capped so generated rows never flood the ledger.
# Cadence 6-hourly: one relay call per firing max, and a REJECT is a completed run — the
# artifact is the VERDICT, not an admission.
# reflex-cadence: 37 */6 * * * (four verdict chances a day)
set -eu
REPO="${MESH_REPO:-$HOME/lte-workstation}"
TARGET="$REPO/scripts/uxn/mesh-gate-evolve"
[ -x "$TARGET" ] || { echo "mesh-gate-evolve: n/a — no genome checkout at $TARGET (set MESH_REPO)" >&2; exit 2; }
exec "$TARGET" "$@"
