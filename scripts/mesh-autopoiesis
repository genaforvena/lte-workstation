#!/usr/bin/env python3
"""Admission and feedback adapter for autopoietic producers.

The task ledger remains authoritative.  This tool only validates producer input,
keeps incomplete novelty in the existing ideas queue, delegates eligible plans
to mesh-task, and derives feedback from task replay plus observed spend tags.
"""
from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import subprocess
import sys
from collections import defaultdict
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
FIELDS = ("kind", "source", "hypothesis", "question", "acceptance", "feedback")
MESH = Path(os.environ.get("MESH", str(Path.home() / ".mesh")))
TASK = os.environ.get("MESH_TASK_BIN", "mesh-task")


def plan_origin(plan: Path) -> dict[str, str]:
    found: dict[str, str] = {}
    for raw in plan.read_text(encoding="utf-8").splitlines():
        line = raw.strip()
        if not line.startswith("#origin."):
            continue
        key, sep, value = line[1:].partition("=")
        field = key.removeprefix("origin.")
        if field not in FIELDS or not sep or not value.strip() or field in found:
            raise ValueError(f"invalid origin header: {line}")
        found[field] = value.strip()
    missing = [field for field in FIELDS if not found.get(field)]
    if missing:
        raise ValueError("incomplete admission envelope: missing " + ", ".join(missing))
    return found


def queue_path() -> Path:
    return MESH / "ideas-queue"


def retain_raw(producer: str, text: str) -> int:
    text = " ".join(text.split())
    if not text:
        raise ValueError("raw novelty is empty")
    path = queue_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    digest = hashlib.sha256(text.encode()).hexdigest()[:16]
    existing = path.read_text(encoding="utf-8", errors="replace") if path.exists() else ""
    if digest not in existing:
        with path.open("a", encoding="utf-8") as stream:
            stream.write(f"[ ] RAW NOVELTY producer={producer} key={digest}: {text}\n")
        print(f"retained raw novelty key={digest} queue={path}")
    else:
        print(f"duplicate raw novelty key={digest} retained in queue={path}")
    return 0


def admit(plan: Path, ask: str | None) -> int:
    try:
        origin = plan_origin(plan)
    except (OSError, ValueError) as exc:
        print(f"mesh-autopoiesis: {exc}", file=sys.stderr)
        return 2
    command = [TASK, "create", plan.stem, str(plan)]
    if ask:
        command.append(ask.removeprefix("ask:"))
    env = os.environ.copy()
    env.setdefault("MESH_TASK_ACTOR", f"autopoiesis/{origin['kind']}")
    result = subprocess.run(command, env=env, text=True)
    return result.returncode


def records() -> dict:
    try:
        from mesh_task_log import replay  # scripts directory is on sys.path
        return replay(Path(os.environ.get("MESH_CHAT_LOG", str(MESH / "chat.log"))))
    except (OSError, ValueError, KeyError) as exc:
        raise RuntimeError(f"task ledger unreadable: {exc}") from exc


def outcome(data: dict) -> str:
    text = " ".join(str(step.get("result", "")) for step in data.get("steps", []))
    match = re.search(r"\boutcome=(adopted|negative|blocked|duplicate|deferred)\b", text)
    if match:
        return match.group(1)
    if data.get("status") == "complete":
        return "adopted"
    if data.get("status") == "blocked":
        return "blocked"
    return "open"


def spend_by_chain() -> dict[str, int]:
    counts: defaultdict[str, int] = defaultdict(int)
    path = Path(os.environ.get("MESH_SPEND_LOG", str(MESH / "spend.log")))
    if not path.exists():
        return counts
    for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
        if " turn " not in line:
            continue
        match = re.search(r"\btask:([^\s,;()]+)", line)
        if match:
            key = match.group(1)
            counts[key] += 1
            counts[key.rsplit("/", 1)[0]] += 1
    return counts


def feedback() -> int:
    grouped: defaultdict[tuple[str, str, str], list[tuple[str, int]]] = defaultdict(list)
    spend = spend_by_chain()
    for chain, record in records().items():
        data = record["data"]
        origin = data.get("origin") or {}
        if not origin:
            continue
        grouped[(origin["kind"], origin["source"], outcome(data))].append((chain, spend[chain]))
    print("kind\tsource\toutcome\tobserved_turns\tchains")
    for (kind, source, result), rows in sorted(grouped.items()):
        print(f"{kind}\t{source}\t{result}\t{sum(cost for _, cost in rows)}\t{','.join(chain for chain, _ in rows)}")
    return 0


def smoke() -> int:
    temp = Path(os.environ.get("TMPDIR", "/tmp")) / f"mesh-autopoiesis-test-{os.getpid()}"
    temp.mkdir(parents=True, exist_ok=True)
    plan = temp / "eligible.tsv"
    plan.write_text("#origin.kind=literature\n#origin.source=test-source\n#origin.hypothesis=test hypothesis\n#origin.question=test question\n#origin.acceptance=test predicate\n#origin.feedback=none\nowner\tstep\twork\n", encoding="utf-8")
    if plan_origin(plan)["source"] != "test-source":
        return 1
    try:
        plan_origin(temp / "missing.tsv")
    except OSError:
        pass
    else:
        return 1
    print("mesh-autopoiesis: smoke-test ok (six-field admission, raw retention, derived feedback)")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("command", nargs="?", choices=("admit", "intake", "feedback"))
    parser.add_argument("--plan", type=Path)
    parser.add_argument("--ask")
    parser.add_argument("--producer", default="unknown")
    parser.add_argument("--raw", action="store_true")
    parser.add_argument("--test", action="store_true")
    args = parser.parse_args()
    if args.test:
        return smoke()
    if args.command == "admit":
        if not args.plan:
            parser.error("admit requires --plan")
        return admit(args.plan, args.ask)
    if args.command == "intake":
        if args.plan:
            return admit(args.plan, args.ask)
        if not args.raw:
            parser.error("intake requires --plan or --raw")
        return retain_raw(args.producer, sys.stdin.read())
    if args.command == "feedback":
        try:
            return feedback()
        except RuntimeError as exc:
            print(f"mesh-autopoiesis: {exc}", file=sys.stderr)
            return 2
    parser.error("choose admit, intake, or feedback")
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
