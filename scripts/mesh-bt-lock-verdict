#!/usr/bin/env bash
# mesh-bt-lock-verdict — the AFTER artifact for 6b31aa7 ("bt-census joins the presence stack's
# adapter lock"). A commit whose effect is never re-measured is a claim, so this tool re-derives
# the same split the fix was argued from, restricted to rows/messages AFTER the cutover, and
# reports its own STATISTICAL POWER instead of a bare verdict.
#
# TWO LEGS, and they do NOT have the same power — the difference is the whole point:
#
#   KERNEL leg (strong).  "Bluetooth: hci0: Opcode 0x0401 failed: -16" is the controller REFUSING
#   an HCI_Inquiry with EBUSY — the collision itself, one message per collided tick. BEFORE
#   (2026-08-14 → 2026-08-19T11:00Z, spanning 3 boots): 42 at :30, 41 at :49, 0 at :11, 4 scattered.
#   bt-census runs 11-59/19 → :11 :30 :49; the presence stack occupies :30 (mesh-presence */10) and
#   :49 (mesh-presence-fuse-stream 19,49 → mesh-presence). :11 is bt-census ALONE and never refused:
#   an internal control that rules out "the adapter is just flaky". Per-tick refusal rate ≈ 34%, so
#   n clean ticks give P(0 | unchanged) = 0.66^n — EIGHT ticks at one slot is already p<0.04, and
#   :30+:49 together reach that in ~8 hours.
#
#   ZERO-ROW leg (weak).  mesh-presence's zero-device rate, 3.51% (17/484) at :30 vs 0.58%
#   (14/2421) across its five other slots. This is the DOWNSTREAM harm and the number the fix was
#   filed against, but the excess is only ~2.9pp: 24h of :30 rows (~14-24 samples) expects ~0.5
#   excess zeros, so observing zero of them is ~60% likely even if NOTHING was fixed. Reaching
#   p<0.05 needs ~85 clean :30 rows ≈ 6 days. The board task asked for 24h "to have power"; on this
#   leg 24h has none. Both windows are printed so neither claim can borrow the other's power.
#
# Renders n/a (exit 2) when the journal cannot be read — a missing journal is not a clean adapter.
# Posts the verdict to the board ONCE, when the kernel leg first goes ripe (latch), then keeps
# rendering it on stdout forever; the latch is printed, so a muted notice is never invisible.
#
# RETIREMENT: this is a bounded measurement, not a standing sense. Once BOTH legs are ripe and the
# board carries the verdict (posted=yes, and the zero-row leg past its ~6-day window), delete the
# cron line and attic the tool — an hourly reflex re-deriving a settled number is noise, and a
# permanently green one nobody reads is the dead-lane shape.
#
# reflex-cadence: 5 * * * *
set -u

CUT="${MESH_BTLOCK_CUT:-2026-08-19T11:00:00Z}"
CENSUS_LOG="${MESH_BT_CRONLOG:-$HOME/.mesh/bt-census.cron.log}"
PRESENCE_LOG="${MESH_PRESENCE_LOG:-$HOME/.mesh/presence.log}"
LATCH="${MESH_BTLOCK_LATCH:-$HOME/.mesh/.bt-lock-verdict.posted}"
KERN_MIN_TICKS="${MESH_BTLOCK_MINTICKS:-8}"   # per-slot ticks for p<0.05 at the measured 34% base rate
ZERO_MIN_ROWS="${MESH_BTLOCK_MINROWS:-85}"    # :30 rows for p<0.05 at the measured 3.51% base rate
SLOTS="30 49"                                 # the collided slots; 11 is the bt-census-alone control
MODE_TEST=0; POST=1
for a in "$@"; do case "$a" in --test) MODE_TEST=1;; --no-post) POST=0;; esac; done

# minute-of-hour histogram of EBUSY inquiry refusals in [$1, $2), across boots (_TRANSPORT=kernel
# spans them; `journalctl -k` would silently restrict to the CURRENT boot and undercount).
# $2 is OPTIONAL and omitting it means "to now" — which is right for the AFTER window and WRONG for
# any BEFORE control: an unbounded --since makes the control an ever-happened indicator, reached by
# simply waiting, so it can only ever go one way. Pass the cutover as $2 for anything pre-fix.
# Accepts journalctl's `@<epoch>` form, so a caller can hand it $CUT without a second time constant.
kern_refusals() {
  local -a q=(--since "$1")
  [ -n "${2:-}" ] && q+=(--until "$2")
  journalctl "${q[@]}" -o short-iso _TRANSPORT=kernel 2>/dev/null \
    | grep 'Opcode 0x0401 failed' | awk '{split($1,a,"T"); print substr(a[2],4,2)}'
}
# ticks actually EXECUTED at a slot since the cutover — bt-census logs one line per run (census or
# honest n/a), each ending "@ <host> <ts>". A wall-clock count would credit ticks the node was down
# for and manufacture power out of downtime.
census_ticks() { awk -v c="$1" -v m="$2" '{t=$NF} t>c && substr(t,15,2)==m {n++} END{print n+0}' "$CENSUS_LOG" 2>/dev/null; }

# 0.66^n, printed as the p-value the ripeness threshold is derived from
p_clean() { awk -v n="$1" 'BEGIN{printf "%.4f", 0.66^n}'; }

verdict() {
  local ts_journal
  ts_journal="$(journalctl --since "$CUT" -o short-iso -n 1 _TRANSPORT=kernel 2>/dev/null | tail -1)"
  if ! journalctl --since "$CUT" -n 1 -o short-iso >/dev/null 2>&1; then
    echo "bt-lock-verdict: n/a (journal unreadable — cannot distinguish a clean adapter from a blind one)" >&2
    return 2
  fi
  local hist tot_ref=0 tot_tick=0 out="" ripe=1
  hist="$(kern_refusals "$CUT" | sort | uniq -c)"
  for m in $SLOTS; do
    local r t
    r="$(printf '%s\n' "$hist" | awk -v m="$m" '$2==m{print $1}')"; r="${r:-0}"
    t="$(census_ticks "$CUT" "$m")"
    tot_ref=$(( tot_ref + r )); tot_tick=$(( tot_tick + t ))
    [ "$t" -ge "$KERN_MIN_TICKS" ] || ripe=0
    out="$out :$m=$r/$t"
  done
  local ctrl
  ctrl="$(printf '%s\n' "$hist" | awk '$2=="11"{print $1}')"; ctrl="${ctrl:-0}"
  local z30 n30 zr nr
  z30="$(awk -v c="$CUT" '{t=$1} t>c && substr(t,15,2)=="30" {n++; if($3=="n=0") z++} END{print z+0}' "$PRESENCE_LOG" 2>/dev/null)"
  n30="$(awk -v c="$CUT" '{t=$1} t>c && substr(t,15,2)=="30"' "$PRESENCE_LOG" 2>/dev/null | wc -l)"
  zr="$(awk -v c="$CUT" '{t=$1} t>c && substr(t,15,2)!="30" {n++; if($3=="n=0") z++} END{print z+0}' "$PRESENCE_LOG" 2>/dev/null)"
  nr="$(awk -v c="$CUT" '{t=$1} t>c && substr(t,15,2)!="30"' "$PRESENCE_LOG" 2>/dev/null | wc -l)"

  local kv
  if [ "$tot_tick" -eq 0 ]; then kv="UNRIPE(no ticks yet)"
  elif [ "$ripe" = 0 ]; then kv="UNRIPE(need ${KERN_MIN_TICKS}/slot)"
  elif [ "$tot_ref" -eq 0 ]; then kv="HEALED"
  else kv="STILL-COLLIDING"; fi

  printf 'bt-lock-verdict since=%s kernel=%s refusals=%d/%d ticks%s ctrl:11=%s p_if_unchanged=%s | zero-row=%s :30=%d/%d other=%d/%d (need %d at :30) | posted=%s\n' \
    "$CUT" "$kv" "$tot_ref" "$tot_tick" "$out" "$ctrl" "$(p_clean "$tot_tick")" \
    "$( [ "$n30" -ge "$ZERO_MIN_ROWS" ] && echo ripe || echo UNRIPE )" \
    "$z30" "$n30" "$zr" "$nr" "$ZERO_MIN_ROWS" "$( [ -f "$LATCH" ] && echo yes || echo no )"

  if [ "$POST" = 1 ] && [ "$kv" = "HEALED" -o "$kv" = "STILL-COLLIDING" ] && [ ! -f "$LATCH" ] \
     && command -v mesh-chat >/dev/null 2>&1; then
    mesh-chat "[fyi] bt-lock-verdict (AFTER artifact for 6b31aa7): kernel leg $kv — $tot_ref EBUSY inquiry refusals in $tot_tick post-fix ticks at$out (control :11=$ctrl), p=$(p_clean "$tot_tick") if unchanged. BEFORE was 42/:30 + 41/:49 over 5d. zero-row leg still UNRIPE ($n30/$ZERO_MIN_ROWS rows at :30, needs ~6d)." >/dev/null 2>&1 \
      && date -u +%Y-%m-%dT%H:%M:%SZ > "$LATCH"
  fi
  return 0
}

if [ "$MODE_TEST" = 1 ]; then
  P=0; F=0
  ok() { P=$((P+1)); }
  bad() { F=$((F+1)); echo "FAIL: $*" >&2; }
  TD="$(mktemp -d)"; trap 'rm -rf "$TD"' EXIT

  # census_ticks counts only post-cutover lines at the named slot, and counts the RUN not the clock
  CENSUS_LOG="$TD/c.log"
  cat > "$CENSUS_LOG" <<'L'
PRESENT n=1 x @ mesh-home 2026-08-19T10:30:14Z
PRESENT n=1 x @ mesh-home 2026-08-19T11:30:14Z
bt-census: UNREACHABLE (adapter scan-locked) @ mesh-home 2026-08-19T12:30:02Z
PRESENT n=1 x @ mesh-home 2026-08-19T12:49:14Z
L
  [ "$(census_ticks 2026-08-19T11:00:00Z 30)" = 2 ] && ok || bad "census_ticks :30 post-cutover: $(census_ticks 2026-08-19T11:00:00Z 30)"
  [ "$(census_ticks 2026-08-19T11:00:00Z 49)" = 1 ] && ok || bad "census_ticks :49"
  [ "$(census_ticks 2026-08-19T11:00:00Z 11)" = 0 ] && ok || bad "census_ticks :11 must be 0"
  [ "$(census_ticks 2026-08-19T09:00:00Z 30)" = 3 ] && ok || bad "cutover must move the count"
  # a downed node must NOT earn ticks: wall-clock would say 2 here, the log says 0
  : > "$CENSUS_LOG"; [ "$(census_ticks 2026-08-19T11:00:00Z 30)" = 0 ] && ok || bad "empty census log must yield 0 ticks, not wall-clock"

  # p_clean is the real 0.66^n, and the ripeness threshold actually lands under 0.05
  [ "$(p_clean 8)" = "0.0360" ] && ok || bad "p_clean 8: $(p_clean 8)"
  [ "$(p_clean 0)" = "1.0000" ] && ok || bad "p_clean 0 must be certainty: $(p_clean 0)"
  awk -v p="$(p_clean "$KERN_MIN_TICKS")" 'BEGIN{exit !(p<0.05)}' && ok || bad "KERN_MIN_TICKS=$KERN_MIN_TICKS gives p=$(p_clean "$KERN_MIN_TICKS") — not <0.05"
  # the weak leg's threshold must also be honest: 0.9649^ZERO_MIN_ROWS < 0.05
  awk -v n="$ZERO_MIN_ROWS" 'BEGIN{exit !(0.9649^n<0.05)}' && ok || bad "ZERO_MIN_ROWS=$ZERO_MIN_ROWS underpowered"
  # ...and 24h of :30 rows (24) must be visibly NOT enough — the task premise this tool corrects
  awk 'BEGIN{exit !(0.9649^24>0.05)}' && ok || bad "24h of :30 rows would already be powered — premise correction is wrong"

  # zero-row split: seeded so :30 carries the excess, and rows at/below the cutover are excluded
  PRESENCE_LOG="$TD/p.log"
  cat > "$PRESENCE_LOG" <<'L'
2026-08-19T10:30:10Z mesh-home n=0 devices=[]
2026-08-19T11:30:10Z mesh-home n=0 devices=[]
2026-08-19T12:30:10Z mesh-home n=4 devices=[x]
2026-08-19T12:40:10Z mesh-home n=0 devices=[]
2026-08-19T12:50:10Z mesh-home n=2 devices=[x]
L
  c=2026-08-19T11:00:00Z
  [ "$(awk -v c=$c '{t=$1} t>c && substr(t,15,2)=="30"{n++; if($3=="n=0") z++} END{print z+0"/"n+0}' "$PRESENCE_LOG")" = "1/2" ] && ok || bad ":30 zero split"
  [ "$(awk -v c=$c '{t=$1} t>c && substr(t,15,2)!="30"{n++; if($3=="n=0") z++} END{print z+0"/"n+0}' "$PRESENCE_LOG")" = "1/2" ] && ok || bad "other-slot zero split"

  # kern_refusals must read a REAL journal and must span boots — assert the query the tool ships
  # with actually returns the known BEFORE shape (:30 and :49 dominant, :11 absent). Exit 2 where
  # there is no journal to read rather than passing on a stub.
  if journalctl -n 1 >/dev/null 2>&1; then
    # A window that STRADDLES the 2026-08-19T05:48Z reboot: narrow enough to stay sub-second on a
    # multi-GB journal, wide enough that the boot-spanning claim is falsifiable. It is CLOSED at
    # the tool's own cutover — derived from $CUT, never re-typed, so the two cannot drift — because
    # the :11 leg below is a BEFORE control and an open-ended one is not a control at all.
    WS="@$(date -u -d "2026-08-19T05:00:00Z" +%s)"
    WE="@$(date -u -d "$CUT" +%s)"
    if ! journalctl --since "$WS" --until "$WE" -n 1 -o short-iso 2>/dev/null | grep -q .; then
      echo "bt-lock-verdict --test: n/a — journal no longer covers the BEFORE window ($WS..$WE); a rotated-away window is not a clean adapter" >&2; exit 2
    fi
    h="$(kern_refusals "$WS" "$WE" | sort | uniq -c)"
    [ -n "$h" ] && ok || bad "kern_refusals returned nothing over a window known to contain refusals"
    printf '%s\n' "$h" | awk '$2=="30"{f=1} END{exit !f}' && ok || bad "BEFORE window must show :30 refusals"
    printf '%s\n' "$h" | awk '$2=="11"{f=1} END{exit f}' && ok || bad ":11 control must be clean in the BEFORE window"
    # MUTATION — the bound must be LOAD-BEARING, not decorative. Widen the same window past the
    # cutover (drop --until, i.e. exactly the query this tool shipped with) and the :11 control MUST
    # go red: that is the 2026-08-21T21:11:15Z failure reproduced on purpose, one stray refusal two
    # days after the cutover turning a control into a latch. Assertable only while the journal still
    # carries a post-cutover :11 — say so LOUDLY rather than pass on an empty premise.
    # The precondition is read SEPARATELY from the assertion on purpose. Collapsing them into one
    # widened scan is 20s cheaper and costs the gate its RED path: defang the widened read (bound
    # it) and a single-number arm goes quiet instead of failing, which is the silent-fallback shape.
    # Two reads, and this arm has been SEEN red — see the mutation note in the commit.
    if [ "$(kern_refusals "$WE" | grep -cx 11)" -gt 0 ]; then
      printf '%s\n' "$(kern_refusals "$WS" | sort | uniq -c)" | awk '$2=="11"{f=1} END{exit !f}' \
        && ok || bad "MUTATION: widening the window past the cutover must BREAK the :11 control — it did not, so the bound proves nothing"
    else
      echo "bt-lock-verdict --test: NOTE — mutation arm unassertable: no post-cutover :11 refusal left in the journal, so the bound is not load-bearing right now" >&2
    fi
    # the boot-spanning claim, asserted STRICTLY: `-k` silently restricts to the current boot, so
    # over a window containing a reboot it must return FEWER lines than _TRANSPORT=kernel. Both
    # sides carry the SAME bounds — an unbounded control against a bounded subject compares windows,
    # not transports.
    a="$(kern_refusals "$WS" "$WE" | wc -l)"
    b="$(journalctl -k --since "$WS" --until "$WE" -o short-iso 2>/dev/null | grep -c 'Opcode 0x0401 failed')"
    [ "$a" -gt "$b" ] && ok || bad "_TRANSPORT=kernel ($a) must span MORE than -k ($b) across a reboot"
  else
    echo "bt-lock-verdict --test: n/a — no readable journal (kernel leg unassertable)" >&2; exit 2
  fi

  # The latch state must be PUBLISHED — a muted notice that does not say it is muted is invisible.
  # Asserted on the RENDERED LINE, never by grepping this file for the format string: such a grep
  # matches its own text, and a sed that breaks the printf breaks the pattern with it (measured —
  # the source-text version of this gate stayed green through exactly that mutation).
  POST=0; LATCH="$TD/latch"; rm -f "$LATCH"
  v="$(verdict)" || bad "verdict returned rc=$? on a live node"
  case "$v" in *"posted=no"*) ok;; *) bad "unlatched verdict must render posted=no: $v";; esac
  case "$v" in *"since=$CUT"*) ok;; *) bad "verdict must name its cutover: $v";; esac
  case "$v" in *"ctrl:11="*) ok;; *) bad "verdict must carry the :11 control cell: $v";; esac
  date -u +%FT%TZ > "$LATCH"
  v="$(verdict)"
  case "$v" in *"posted=yes"*) ok;; *) bad "latched verdict must render posted=yes: $v";; esac

  echo "mesh-bt-lock-verdict --test: $P passed, $F failed"
  [ "$F" = 0 ] || exit 1
  exit 0
fi

verdict
