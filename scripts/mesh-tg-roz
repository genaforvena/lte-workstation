#!/usr/bin/env bash
# mesh-tg-roz — send a Telegram message to Rozalia (ROZ_CHAT_ID).
# The tg-roz window mind calls this to reply to her.
#
#   mesh-tg-roz "Hello from the mesh!"
#   mesh-tg-roz "Привет, да!" --parse-mode Markdown
#
# Config: BOT_TOKEN in ~/.mesh/bot.env (same bot as mesh-voice-rx)
#         ROZ_CHAT_ID in ~/.mesh/nodes or env
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes" 2>/dev/null
ENVF="$HOME/.config/remote-access/env"
[ -f "$ENVF" ] && { set -a; . "$ENVF"; set +a; }

TEXT="${1:?usage: mesh-tg-roz <text>}"
CHAT="${ROZ_CHAT_ID:?ROZ_CHAT_ID not set — add to ~/.mesh/nodes}"
TOKEN="${BOT_TOKEN:?BOT_TOKEN not set — add to ~/.mesh/bot.env}"
PARSE="${2:-}"

[ "${1:-}" = --test ] && {
  command -v curl >/dev/null 2>&1 || { echo "smoke-test: FAIL (no curl)"; exit 1; }
  [ -n "$TOKEN" ] || { echo "smoke-test: FAIL (no BOT_TOKEN)"; exit 1; }
  [ -n "$CHAT" ]  || { echo "smoke-test: FAIL (no ROZ_CHAT_ID)"; exit 1; }
  # Verify Telegram bot API is reachable and token is valid (same pattern as mesh-tg)
  resp="$(curl -s -m 10 "https://api.telegram.org/bot${TOKEN}/getMe" 2>/dev/null)" || { echo "smoke-test: FAIL (Telegram API unreachable)"; exit 1; }
  printf '%s' "$resp" | grep -q '"ok":true' || { echo "smoke-test: FAIL (telegram getMe failed — bad token?)"; exit 1; }
  botname=$(printf '%s' "$resp" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('result',{}).get('first_name','?'))" 2>/dev/null)
  # --doc must REFUSE a missing file rather than posting an empty/partial document into a real
  # person's chat. Asserted by driving the flag, not by reading the source: the send path is the
  # one branch of this tool whose failure is visible to someone outside the mesh.
  if bash "${BASH_SOURCE[0]}" --doc /nonexistent-mesh-tg-roz-fixture.docx >/dev/null 2>&1; then
    echo "smoke-test: FAIL (--doc accepted a missing file)"; exit 1; fi
  echo "smoke-test: ok (bot=$botname, chat=$CHAT; --doc refuses a missing file)"; exit 0
}

# --doc <file> [caption]: send a FILE, not text. Added 2026-08-18 — the operator asked for a
# prepared document to reach Rozalia in Telegram and this tool could only carry a string, so the
# delivery would otherwise have happened out-of-band via a hand-rolled curl that leaves no [OUT]
# line in roz-in.log and no 403 handling. A channel tool that cannot carry the artifact the channel
# is used for pushes every real delivery outside the channel's own record.
if [ "$TEXT" = --doc ]; then
  DOC="${2:?usage: mesh-tg-roz --doc <file> [caption]}"
  [ -f "$DOC" ] || { echo "mesh-tg-roz: no such file: $DOC" >&2; exit 1; }
  CAP="${3:-}"
  dargs=(-s -f "https://api.telegram.org/bot${TOKEN}/sendDocument"
         -F "chat_id=${CHAT}" -F "document=@${DOC}")
  [ -n "$CAP" ] && dargs+=(-F "caption=${CAP}")
  dout="$(curl "${dargs[@]}" 2>&1)"
  printf '%s' "$dout" | python3 -c "import json,sys; d=json.load(sys.stdin); print('sent ok, msg_id=' + str(d['result']['message_id']))" 2>/dev/null \
    || { echo "mesh-tg-roz: document send failed: $dout" >&2; exit 1; }
  printf '[OUT] %s mesh: [document] %s%s\n' "$(date -u +%H:%MZ)" "$(basename "$DOC")" "${CAP:+ | $CAP}" >> "$HOME/.mesh/roz-in.log"
  exit 0
fi

args=(-s -f "https://api.telegram.org/bot${TOKEN}/sendMessage"
      -d "chat_id=${CHAT}"
      --data-urlencode "text=${TEXT}")
[ -n "$PARSE" ] && args+=(-d "parse_mode=${PARSE}")
out="$(curl "${args[@]}" 2>&1)"
if err_code=$(printf '%s' "$out" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('error_code',0))" 2>/dev/null) && [ "$err_code" = 403 ]; then
  # debounced board alert on blocked/deleted chat
  state="$HOME/.mesh/.tg-roz-403-state"
  if [ ! -f "$state" ] || [ "$(cat "$state" 2>/dev/null)" != 403 ]; then
    echo 403 > "$state"
    command -v mesh-chat >/dev/null 2>&1 && \
      mesh-chat "[alert] mesh-tg-roz: chat_id=${CHAT} blocked/deleted — Telegram returned 403 (bot blocked by user). Cannot reach Rozalia via TG." >/dev/null 2>&1 || true
  fi
  echo "mesh-tg-roz: send FAILED (403) — bot blocked by chat $CHAT" >&2; exit 3
fi
printf '%s' "$out" | python3 -c "import json,sys; d=json.load(sys.stdin); print('sent ok, msg_id=' + str(d['result']['message_id']))" 2>/dev/null \
  || { echo "mesh-tg-roz: send failed: $out" >&2; exit 1; }
# recover from prior 403 (bot unblocked)
state="$HOME/.mesh/.tg-roz-403-state"
if [ -f "$state" ] && [ "$(cat "$state" 2>/dev/null)" = 403 ]; then
  echo OK > "$state"
  command -v mesh-chat >/dev/null 2>&1 && \
    mesh-chat "[alert] mesh-tg-roz: chat_id=${CHAT} recovered — sendMessage succeeded after previous 403 (bot unblocked)." >/dev/null 2>&1 || true
fi
# Log sent reply to roz-in.log so the tg-roz data pane shows conversation history
ts="$(date -u +%H:%MZ)"
printf '[OUT] %s mesh: %s\n' "$ts" "$TEXT" >> "$HOME/.mesh/roz-in.log"
