#!/usr/bin/env bash
# mesh-tg-roz — send a Telegram message to Rozalia (ROZ_CHAT_ID).
# The tg-roz window mind calls this to reply to her.
#
#   mesh-tg-roz "Hello from the mesh!"
#   mesh-tg-roz "Привет, да!" --parse-mode Markdown
#   mesh-tg-roz --reciprocity        # the outbound/inbound ASYMMETRY reading
#
# Config: BOT_TOKEN in ~/.mesh/bot.env (same bot as mesh-voice-rx)
#         ROZ_CHAT_ID in ~/.mesh/nodes or env
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes" 2>/dev/null
ENVF="$HOME/.config/remote-access/env"
[ -f "$ENVF" ] && { set -a; . "$ENVF"; set +a; }

ROZLOG="$HOME/.mesh/roz-in.log"
STRANGERS_LOG="$HOME/.mesh/tg-strangers.log"
ROZ_OFFSET_F="$HOME/.mesh/.roz-channel.offset"
ASYM_STATE="$HOME/.mesh/.tg-roz-asym-state"

# --------------------------------------------------------------------------------
# RECIPROCITY — the arms-race ASYMMETRY axis (added 2026-08-22; review:
# docs/reviews/extended-phenotype-arms-race-asymmetry-rare-enemy-tg-roz-2026-08-22.md)
#
# Until now the ONLY resistance this tool could see was a 403 — the recipient
# blocking the bot. McLean, Herberstein & Kokko (Proc R Soc B 2024,
# doi:10.1098/rspb.2024.1052) is the formal scrutiny of the informal argument
# behind that design: per-encounter cost asymmetry (we spend a curl, she spends
# attention) does NOT predict that resistance appears, because the rare-enemy
# side of the tug of war pushes the other way — selection to resist is diluted by
# how rare the encounter is. So a hard block is the LAST signal that would ever
# fire, and every graded degree of "answering less" is invisible to a 403 gate.
# This reads the graded axis instead: how long the current unanswered OUTBOUND run
# is, against the distribution of runs THIS channel has actually produced.
#
# It is not a fault and it does not gate the send — the channel belongs to her,
# not to us. It publishes an asymmetry the send path could not previously state.
# --------------------------------------------------------------------------------
roz_winch() {   # is the [IN] writer's target window present? (mesh-roz-channel exits
                # silently without it, so its absence means the inbound lane is dead)
  command -v tmux >/dev/null 2>&1 || { echo na; return; }
  if tmux has-session -t "$(hostname):tg-roz" 2>/dev/null; then echo present; else echo absent; fi
}

roz_reciprocity() {
  python3 - "$ROZLOG" "$STRANGERS_LOG" "$ROZ_OFFSET_F" "$(roz_winch)" <<'PY'
import sys, os

log, strangers, offset_f, winch = sys.argv[1:5]

def emit(pairs):
    print(' '.join('%s=%s' % kv for kv in pairs))

if not os.path.exists(log):
    emit([('run','na'),('thr','na'),('p90','na'),('n',0),('out',0),('in',0),
          ('lag','na'),('winch',winch),('coverage','none'),('state','unknown'),
          ('since','na(no-log)')])
    raise SystemExit(0)

runs=[]; cur=0; nout=0; nin=0
with open(log, encoding='utf-8', errors='replace') as fh:
    for line in fh:
        if line.startswith('[OUT]'):
            cur += 1; nout += 1
        elif line.startswith('[IN]'):
            nin += 1; runs.append(cur); cur = 0

n = len(runs)
# The threshold is DERIVED from this channel's own completed runs, never a pinned
# constant: a run is "asymmetric" when it is longer than ~90% of the runs this
# channel has actually produced. Too few completed runs to place a percentile ->
# a MARKED default (p90=na in the output), never a silent number.
if n >= 5:
    s = sorted(runs)
    p90 = s[min(n - 1, int(round(0.9 * (n - 1))))]
    thr = max(3, p90 + 1)
else:
    p90 = 'na'; thr = 3

# COVERAGE. The [IN] half of this log is written by mesh-roz-channel, not by this
# tool. If that poller is behind its own input (offset < tg-strangers.log lines) or
# its target window is gone, an unanswered run is a WRITER failure and says nothing
# about the recipient. Silence with a dead writer is UNKNOWN, never "she did not
# answer" — the verdict is HELD, not cleared.
lag = 'na'; cov = 'ok'
try:
    with open(strangers, encoding='utf-8', errors='replace') as fh:
        lc = sum(1 for _ in fh)
    off = int((open(offset_f).read().strip() or '0'))
    lag = lc - off
    if lag > 0:
        cov = 'partial'
except Exception:
    cov = 'partial'
if winch != 'present':
    cov = 'partial'

state = 'unknown' if cov != 'ok' else ('asymmetric' if cur >= thr else 'reciprocal')

# 'since' would be the better axis (age of the last inbound line) and it is NOT
# available: mesh-roz-channel:41 cuts the inbound timestamp with a character class
# that omits '-', so every [IN] line carries the truncated stem of its ISO date.
# Rendered na WITH its cause rather than filled with a plausible 0.
emit([('run', cur), ('thr', thr), ('p90', p90), ('n', n), ('out', nout), ('in', nin),
      ('lag', lag), ('winch', winch), ('coverage', cov), ('state', state),
      ('since', 'na(inbound-ts-truncated-by-roz-channel)')])
PY
}

roz_field() { printf '%s\n' "$1" | tr ' ' '\n' | sed -n "s/^$2=//p"; }

# Reported AFTER the [OUT] line is appended, so the run includes the message just
# sent — a run read before its own append reports the outgoing state, not this one.
roz_asym_report() {
  local r st run thr
  r="$(roz_reciprocity 2>/dev/null)" || return 0
  [ -n "$r" ] || return 0
  echo "mesh-tg-roz: reciprocity $r" >&2
  st="$(roz_field "$r" state)"; run="$(roz_field "$r" run)"; thr="$(roz_field "$r" thr)"
  if [ "$st" = asymmetric ]; then
    # Edge-triggered: one board post per crossing, never one per send.
    if [ "$(cat "$ASYM_STATE" 2>/dev/null)" != asym ]; then
      echo asym > "$ASYM_STATE"
      command -v mesh-chat >/dev/null 2>&1 && \
        mesh-chat "[fyi] mesh-tg-roz: outbound run of ${run} unanswered message(s) to Rozalia, over this channel's own p90 (thr=${thr}) — $r. Not a fault, not a block (no 403): the graded resistance a 403 gate can never show (rare-enemy principle, McLean/Herberstein/Kokko 2024)." >/dev/null 2>&1 || true
    fi
  elif [ "$st" = reciprocal ]; then
    # Recovery is SILENT by design — an edge that also posts on its way back wakes a
    # reader twice per episode for a channel that simply resumed.
    rm -f "$ASYM_STATE" 2>/dev/null || true
  fi
  # state=unknown: the state file is left EXACTLY as it stands. An exemption that
  # cannot place its subject in the excusing window holds the verdict, never clears it.
}

if [ "${1:-}" = --reciprocity ]; then roz_reciprocity; exit 0; fi

TEXT="${1:?usage: mesh-tg-roz <text>}"
CHAT="${ROZ_CHAT_ID:?ROZ_CHAT_ID not set — add to ~/.mesh/nodes}"
TOKEN="${BOT_TOKEN:?BOT_TOKEN not set — add to ~/.mesh/bot.env}"
PARSE="${2:-}"

[ "${1:-}" = --test ] && {
  command -v curl >/dev/null 2>&1 || { echo "smoke-test: FAIL (no curl)"; exit 1; }
  [ -n "$TOKEN" ] || { echo "smoke-test: FAIL (no BOT_TOKEN)"; exit 1; }
  [ -n "$CHAT" ]  || { echo "smoke-test: FAIL (no ROZ_CHAT_ID)"; exit 1; }
  # Verify Telegram bot API is reachable and token is valid (same pattern as mesh-tg)
  resp="$(curl -s -m 10 "https://api.telegram.org/bot${TOKEN}/getMe" 2>/dev/null)" || { echo "smoke-test: FAIL (Telegram API unreachable)"; exit 1; }
  printf '%s' "$resp" | grep -q '"ok":true' || { echo "smoke-test: FAIL (telegram getMe failed — bad token?)"; exit 1; }
  botname=$(printf '%s' "$resp" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('result',{}).get('first_name','?'))" 2>/dev/null)
  # --doc must REFUSE a missing file rather than posting an empty/partial document into a real
  # person's chat. Asserted by driving the flag, not by reading the source: the send path is the
  # one branch of this tool whose failure is visible to someone outside the mesh.
  if bash "${BASH_SOURCE[0]}" --doc /nonexistent-mesh-tg-roz-fixture.docx >/dev/null 2>&1; then
    echo "smoke-test: FAIL (--doc accepted a missing file)"; exit 1; fi
  # Reciprocity axis — driven, never grepped. Three fixtures: run counting + the
  # corpus-derived threshold, the WRITER-LAG blindness, and the live verdict.
  tf="$(mktemp -d)"; mkdir -p "$tf/.mesh"
  { for _ in 1 2 3 4 5 6; do printf '[OUT] 00:00Z mesh: x\n[IN]  t  Rozalia: y\n'; done
    for _ in 1 2 3 4; do printf '[OUT] 00:00Z mesh: x\n'; done; } > "$tf/.mesh/roz-in.log"
  : > "$tf/.mesh/tg-strangers.log"; echo 0 > "$tf/.mesh/.roz-channel.offset"
  r="$(HOME="$tf" ROZ_CHAT_ID="$CHAT" BOT_TOKEN="$TOKEN" bash "${BASH_SOURCE[0]}" --reciprocity 2>/dev/null)"
  case "$r" in
    *"run=4 thr=3 p90=1 n=6 "*) : ;;
    *) rm -rf "$tf"; echo "smoke-test: FAIL (reciprocity misread the fixture: $r)"; exit 1 ;;
  esac
  # winch=present is the ONLY way the fixture can reach a verdict; if this node has no
  # tg-roz window the inbound lane is dead and that must be LOUD, not excused.
  case "$r" in
    *"winch=present"*"coverage=ok"*"state=asymmetric"*) : ;;
    *"winch=present"*) rm -rf "$tf"; echo "smoke-test: FAIL (fixture run 4 >= thr 3 did not read asymmetric: $r)"; exit 1 ;;
    *) rm -rf "$tf"; echo "smoke-test: FAIL (tg-roz window absent — mesh-roz-channel cannot write [IN], the inbound half of this channel is dead: $r)"; exit 1 ;;
  esac
  # Writer lag must HOLD the verdict, not clear it: same log, poller behind its input.
  printf 'a\nb\n' > "$tf/.mesh/tg-strangers.log"
  r2="$(HOME="$tf" ROZ_CHAT_ID="$CHAT" BOT_TOKEN="$TOKEN" bash "${BASH_SOURCE[0]}" --reciprocity 2>/dev/null)"
  case "$r2" in
    *"lag=2"*"coverage=partial"*"state=unknown"*) : ;;
    *) rm -rf "$tf"; echo "smoke-test: FAIL (writer lag did not render the run unknown: $r2)"; exit 1 ;;
  esac
  rm -rf "$tf"
  echo "smoke-test: ok (bot=$botname, chat=$CHAT; --doc refuses a missing file; reciprocity: run/thr from the corpus, writer-lag -> unknown)"; exit 0
}

# --doc <file> [caption]: send a FILE, not text. Added 2026-08-18 — the operator asked for a
# prepared document to reach Rozalia in Telegram and this tool could only carry a string, so the
# delivery would otherwise have happened out-of-band via a hand-rolled curl that leaves no [OUT]
# line in roz-in.log and no 403 handling. A channel tool that cannot carry the artifact the channel
# is used for pushes every real delivery outside the channel's own record.
if [ "$TEXT" = --doc ]; then
  DOC="${2:?usage: mesh-tg-roz --doc <file> [caption]}"
  [ -f "$DOC" ] || { echo "mesh-tg-roz: no such file: $DOC" >&2; exit 1; }
  CAP="${3:-}"
  dargs=(-s -f "https://api.telegram.org/bot${TOKEN}/sendDocument"
         -F "chat_id=${CHAT}" -F "document=@${DOC}")
  [ -n "$CAP" ] && dargs+=(-F "caption=${CAP}")
  dout="$(curl "${dargs[@]}" 2>&1)"
  printf '%s' "$dout" | python3 -c "import json,sys; d=json.load(sys.stdin); print('sent ok, msg_id=' + str(d['result']['message_id']))" 2>/dev/null \
    || { echo "mesh-tg-roz: document send failed: $dout" >&2; exit 1; }
  printf '[OUT] %s mesh: [document] %s%s\n' "$(date -u +%H:%MZ)" "$(basename "$DOC")" "${CAP:+ | $CAP}" >> "$HOME/.mesh/roz-in.log"
  roz_asym_report
  exit 0
fi

args=(-s -f "https://api.telegram.org/bot${TOKEN}/sendMessage"
      -d "chat_id=${CHAT}"
      --data-urlencode "text=${TEXT}")
[ -n "$PARSE" ] && args+=(-d "parse_mode=${PARSE}")
out="$(curl "${args[@]}" 2>&1)"
if err_code=$(printf '%s' "$out" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('error_code',0))" 2>/dev/null) && [ "$err_code" = 403 ]; then
  # debounced board alert on blocked/deleted chat
  state="$HOME/.mesh/.tg-roz-403-state"
  if [ ! -f "$state" ] || [ "$(cat "$state" 2>/dev/null)" != 403 ]; then
    echo 403 > "$state"
    command -v mesh-chat >/dev/null 2>&1 && \
      mesh-chat "[alert] mesh-tg-roz: chat_id=${CHAT} blocked/deleted — Telegram returned 403 (bot blocked by user). Cannot reach Rozalia via TG." >/dev/null 2>&1 || true
  fi
  echo "mesh-tg-roz: send FAILED (403) — bot blocked by chat $CHAT" >&2; exit 3
fi
printf '%s' "$out" | python3 -c "import json,sys; d=json.load(sys.stdin); print('sent ok, msg_id=' + str(d['result']['message_id']))" 2>/dev/null \
  || { echo "mesh-tg-roz: send failed: $out" >&2; exit 1; }
# recover from prior 403 (bot unblocked)
state="$HOME/.mesh/.tg-roz-403-state"
if [ -f "$state" ] && [ "$(cat "$state" 2>/dev/null)" = 403 ]; then
  echo OK > "$state"
  command -v mesh-chat >/dev/null 2>&1 && \
    mesh-chat "[alert] mesh-tg-roz: chat_id=${CHAT} recovered — sendMessage succeeded after previous 403 (bot unblocked)." >/dev/null 2>&1 || true
fi
# Log sent reply to roz-in.log so the tg-roz data pane shows conversation history
ts="$(date -u +%H:%MZ)"
printf '[OUT] %s mesh: %s\n' "$ts" "$TEXT" >> "$HOME/.mesh/roz-in.log"
roz_asym_report
