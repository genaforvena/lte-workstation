#!/usr/bin/env bash
# orphan-ok: outward-facing submission — fires only when the operator runs it with --send
# mesh-hire-submit — turn the prepared hire package into a real submission, in one paste.
#
# The hire lane's blocker is not knowledge, it is a CREDENTIAL: everything else (patch, tests,
# PR body, disclosure comment) is on disk and verified. This tool exists so the operator's part
# is exactly one action — drop a token in ~/.mesh/secrets/github-hire.env — and nothing else is
# left to hand-typing under the wrong identity (the genaforvena/ghIsPureTrash mix-up this lane
# was created to avoid).
#
#   mesh-hire-submit              dry-run: assert package + credential, print the exact calls
#   mesh-hire-submit --send       actually comment, fork, push, open the PR (irreversible, outward)
#   mesh-hire-submit --test       gates; exit 2 when the credential organ is absent
#
# Every mode re-reads the TARGET's rule set through mesh-hire-scan first: a REJECT or an
# UNKNOWN verdict refuses the send, because the document that permits and the document that
# prohibits are different files and only the permitting one is ever handed to you.
#
# Credential file (operator's hands, mode 600):
#   echo 'GH_HIRE_TOKEN=ghp_...' > ~/.mesh/secrets/github-hire.env && chmod 600 ~/.mesh/secrets/github-hire.env
# Classic PAT, scope `public_repo` ONLY — fork+comment+PR on a public repo need nothing more,
# and public_repo cannot reach the account's private repos. `workflow` is NOT needed: the patch
# touches src/ts only (asserted below, so a future package that DOES touch .github/workflows
# fails loudly instead of 403-ing at push time).
set -uo pipefail

PKG="${MESH_HIRE_PKG:-$HOME/.mesh/hire/trovu-391}"
CRED="${MESH_HIRE_CRED:-$HOME/.mesh/secrets/github-hire.env}"
IDENT="${MESH_HIRE_IDENT:-$HOME/.mesh/hire/identity.txt}"
LOG="${MESH_HIRE_LOG:-$HOME/.mesh/hire.log}"
UPSTREAM="${MESH_HIRE_UPSTREAM:-trovu/trovu}"
ISSUE="${MESH_HIRE_ISSUE:-391}"
BRANCH="${MESH_HIRE_BRANCH:-warn-on-dot-in-keyword}"
BASE="${MESH_HIRE_BASE:-master}"
API="https://api.github.com"

say() { printf '%s\n' "$*"; }
die() { printf 'FAIL: %s\n' "$*" >&2; exit 1; }

# --- the identity is READ, never assumed: whatever handle identity.txt names is who we must be.
expected_login() {
  [ -r "$IDENT" ] || return 1
  sed -n 's#^github\.com/\([A-Za-z0-9-]\+\).*#\1#p' "$IDENT" | head -1
}

# --- package assertions (run in every mode; no token needed) -------------------------------
check_package() {
  local rc=0 f
  for f in PR-BODY.md TRY-COMMENT.md README.md; do
    [ -s "$PKG/$f" ] || { say "package: MISSING $f"; rc=1; }
  done
  local patch bundle
  patch=$(ls "$PKG"/*.patch 2>/dev/null | head -1)
  bundle=$(ls "$PKG"/*.bundle 2>/dev/null | head -1)
  [ -s "$patch" ]  || { say "package: no .patch";  rc=1; }
  [ -s "$bundle" ] || { say "package: no .bundle"; rc=1; }

  local login; login=$(expected_login) || { say "package: identity.txt names no handle"; return 1; }
  [ -n "$login" ] || { say "package: identity.txt names no handle"; rc=1; }

  # the commit must already be authored as the lane's identity, not the operator's own
  if [ -s "$patch" ] && ! grep -qi "^From: .*${login}" "$patch"; then
    say "package: patch author is NOT $login (would submit under the wrong identity)"; rc=1
  fi
  # a package touching .github/workflows needs a scope this tool does not ask for
  if [ -s "$patch" ] && grep -q '^diff --git a/\.github/workflows/' "$patch"; then
    say "package: patch touches .github/workflows — needs the 'workflow' scope, re-ask the operator"; rc=1
  fi
  # the bundle must actually carry the branch we intend to push
  if [ -s "$bundle" ] && ! git bundle list-heads "$bundle" 2>/dev/null | grep -q "refs/heads/${BRANCH}$"; then
    say "package: bundle carries no refs/heads/$BRANCH"; rc=1
  fi
  [ $rc -eq 0 ] && say "package: OK ($PKG, author=$login, branch=$BRANCH)"
  return $rc
}

# --- acceptance (the rule set of the TARGET, read at send time, not remembered) ---------------
# Cycle 2 measured the failure this closes: the permitting document and the prohibiting document
# are DIFFERENT FILES, and the payer hands you the permitting one (tenstorrent's bounty T&C is
# clean while its CONTRIBUTING.md threatens a permanent ban for exactly this lane's act). A
# package can sit on disk for days while a maintainer adds that rule, so the verdict is taken
# fresh here and never carried from the cycle that built the package.
check_acceptance() {
  command -v mesh-hire-scan >/dev/null 2>&1 || {
    say "acceptance: SCANNER ABSENT (mesh-hire-scan) — refusing; an unread rule set is not a clean one"
    return 1; }
  local out verdict
  out=$(mesh-hire-scan --repo "$UPSTREAM" 2>&1)
  verdict=$(printf '%s' "$out" | awk -F': ' '/^verdict:/{print $2; exit}')
  case "$verdict" in
    ACCEPT|SILENT) say "acceptance: $verdict on $UPSTREAM ($(printf '%s' "$out" | sed -n 's/^rule-files-read: //p'))"; return 0 ;;
    REJECT)  say "acceptance: REJECT on $UPSTREAM — refusing to send"
             printf '%s\n' "$out" | grep '  BAN ' | sed 's/^/  /'
             return 1 ;;
    *)       say "acceptance: UNKNOWN on $UPSTREAM (a rule file could not be read) — refusing"
             printf '%s\n' "$out" | grep -i 'FAILED-TO-FETCH' | sed 's/^/  /'
             return 1 ;;
  esac
}

# --- credential (absent = exit 2, the organ is simply not here yet) --------------------------
load_cred() {
  [ -r "$CRED" ] || return 2
  # shellcheck disable=SC1090
  . "$CRED"
  [ -n "${GH_HIRE_TOKEN:-}" ] || return 2
  local mode; mode=$(stat -c %a "$CRED" 2>/dev/null)
  [ "$mode" = "600" ] || say "credential: WARN mode $mode (want 600) on $CRED"
  return 0
}

# assert WHO the token is and WHAT it may do — a token is not an identity until the API says so
check_cred() {
  local want; want=$(expected_login)
  local hdr body login scopes
  hdr=$(mktemp); body=$(curl -sS -D "$hdr" -o - -H "Authorization: Bearer $GH_HIRE_TOKEN" \
        -H "Accept: application/vnd.github+json" "$API/user" 2>/dev/null)
  login=$(printf '%s' "$body" | sed -n 's/.*"login"[ ]*:[ ]*"\([^"]*\)".*/\1/p' | head -1)
  scopes=$(tr -d '\r' < "$hdr" | sed -n 's/^[Xx]-[Oo][Aa]uth-[Ss]copes:[ ]*//p' | head -1)
  rm -f "$hdr"
  [ -n "$login" ] || die "credential: token rejected by $API/user"
  [ "$login" = "$want" ] || die "credential: token is '$login', identity.txt names '$want' — refusing"
  case ",$scopes," in
    *,public_repo,*|*,repo,*) : ;;
    *) die "credential: scopes [$scopes] carry neither public_repo nor repo" ;;
  esac
  say "credential: OK login=$login scopes=[$scopes]"
}

gh_post() { # path json
  curl -sS -X POST -H "Authorization: Bearer $GH_HIRE_TOKEN" -H "Accept: application/vnd.github+json" \
       -d "$2" "$API/$1"
}
json_str() { python3 -c 'import json,sys; print(json.dumps(sys.stdin.read()))'; }

# the disclosure comment's first line is a file header, not part of the message
try_body() { sed '1{/^# /d}' "$PKG/TRY-COMMENT.md" | sed '1{/^$/d}'; }

do_send() {
  local login; login=$(expected_login)
  say "== 1/4 disclosure comment on $UPSTREAM#$ISSUE"
  if curl -sS "$API/repos/$UPSTREAM/issues/$ISSUE/comments" | grep -q "\"login\": *\"$login\""; then
    say "   skip — $login already commented"
  else
    gh_post "repos/$UPSTREAM/issues/$ISSUE/comments" "{\"body\":$(try_body | json_str)}" \
      | grep -q '"html_url"' || die "comment failed"
    say "   posted"
  fi

  say "== 2/4 fork $UPSTREAM"
  local repo="${UPSTREAM##*/}"
  if curl -sS "$API/repos/$login/$repo" | grep -q '"full_name"'; then
    say "   skip — $login/$repo exists"
  else
    gh_post "repos/$UPSTREAM/forks" '{}' >/dev/null
    local i
    for i in $(seq 1 30); do
      curl -sS "$API/repos/$login/$repo" | grep -q '"full_name"' && break
      sleep 2
    done
    curl -sS "$API/repos/$login/$repo" | grep -q '"full_name"' || die "fork did not appear after 60s"
    say "   forked"
  fi

  say "== 3/4 push $BRANCH from the bundle"
  local tmp bundle; tmp=$(mktemp -d); bundle=$(ls "$PKG"/*.bundle | head -1)
  git -C "$tmp" init -q . || die "git init"
  git -C "$tmp" fetch -q "$bundle" "$BRANCH:$BRANCH" || die "bundle fetch"
  git -C "$tmp" push -q "https://x-access-token:$GH_HIRE_TOKEN@github.com/$login/$repo.git" \
      "$BRANCH:$BRANCH" || die "push"
  rm -rf "$tmp"
  say "   pushed $login/$repo:$BRANCH"

  say "== 4/4 open PR against $UPSTREAM:$BASE"
  local title out
  title=$(sed -n '1{s/^#\+ *//;p}' "$PKG/PR-BODY.md")
  out=$(gh_post "repos/$UPSTREAM/pulls" \
    "{\"title\":$(printf '%s' "$title" | json_str),\"head\":\"$login:$BRANCH\",\"base\":\"$BASE\",\"body\":$(sed '1{/^#\+ /d}' "$PKG/PR-BODY.md" | json_str)}")
  printf '%s' "$out" | grep -q '"html_url"' || { printf '%s\n' "$out" >&2; die "PR creation failed"; }
  local url; url=$(printf '%s' "$out" | sed -n 's/.*"html_url"[ ]*:[ ]*"\([^"]*pull[^"]*\)".*/\1/p' | head -1)
  say "   PR: $url"
  printf '%s  submit  %s  %s\n' "$(date -u +%FT%TZ)" "$UPSTREAM#$ISSUE" "$url" >> "$LOG"
}

case "${1:-}" in
  --test)
    rc=0
    check_package || rc=1
    check_acceptance || rc=1
    if load_cred; then
      check_cred || rc=1
    else
      say "credential: ABSENT ($CRED) — the operator's step, nothing else to do here"
      [ $rc -eq 0 ] && exit 2 || exit 1
    fi
    exit $rc ;;
  --send)
    check_package || die "package not sendable"
    check_acceptance || die "target's own rule set refuses this lane — see the citation above"
    load_cred; c=$?
    [ $c -eq 2 ] && { say "credential: ABSENT ($CRED) — cannot send"; exit 2; }
    check_cred
    do_send ;;
  ""|--check)
    check_package || exit 1
    check_acceptance || exit 1
    if load_cred; then check_cred; say "READY — run: mesh-hire-submit --send"
    else say "credential: ABSENT ($CRED)"
         say "operator: echo 'GH_HIRE_TOKEN=ghp_...' > $CRED && chmod 600 $CRED   # classic PAT, scope public_repo"
         exit 2; fi ;;
  *) sed -n '2,20p' "$0"; exit 1 ;;
esac
