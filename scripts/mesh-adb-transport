#!/usr/bin/env bash
# reflex-cadence: */5 * * * *
# mesh-adb-transport — the DEVICE-PRODUCED transport-liveness artifact for an adb-attached body.
#
# WHY THIS EXISTS. `mesh-minds`'s attached-node lane derives a phone's reach from the freshness of
# the artifacts its organs relay onto THIS node. Every one of those artifacts is written by a reflex
# that runs HERE, and our own liveness-touch convention deliberately makes such an mtime mean "the
# reflex ran", never "the far end answered" — so no arrangement of them can prove the phone is
# reachable, let alone commandable. Measured 2026-08-25 on mesh-home: `adb devices` EMPTY (Note 3
# sitting on USB in MTP mode, 04e8:6860) while `~/.mesh/.light-craft-state` was 13s old carrying
# `UNKNOWN ... reason=adb-unreachable` — a freshly written record of NOT reaching the device, counted
# as proof the device was reached — and `~/.mesh/.climate-state` was 312s old carrying `inputs=2/3`,
# a fusion that stays fresh with the phone dark. Between them note3 published `act: speaker torch`
# and mesh-sense-map proposed flashing a torch over a transport that could not carry the command.
#
# WHAT IT PRODUCES. One artifact whose mtime moves ONLY when the PHONE ITSELF answered:
#   ~/.mesh/.note3-adb-transport   (override: MESH_ADB_TRANSPORT_STATE)
# The round trip is `adb -s <serial> shell getprop ro.serialno` and the answer must EQUAL the serial
# we dialled — a value only the device can supply; a dark transport returns an error or nothing, and
# a wrong answer is never written. Device uptime rides along so the CONTENT moves too, not just the
# mtime (a constant-content liveness file leaves its content axis unchecked).
#
# NO `mesh-state-touch` HERE, ON PURPOSE. That convention exists to decouple ran-live from
# value-changed for reflexes whose state is a LOCAL derivation; touching this file on every eval
# would forge precisely the evidence it exists to carry. A failed probe writes NOTHING and the
# artifact ages honestly into UNKNOWN.
#
# ...which makes this tape a numerator, so the RUN ROW is written UNCONDITIONALLY to
#   ~/.mesh/adb-transport.log
# on every attempt with its outcome. A dead prober and a dark phone both leave the artifact stale;
# only the run log tells them apart.
#
# Config (~/.mesh/nodes — never hardcode topology in the genome):
#   MESH_NOTE3_ADB_NODE      local | user@ip of the adb-hosting node   (default: local)
#   MESH_NOTE3_ADB_SERIAL    adb serial                                (default: 4d00553d61ab90b7)
#   MESH_ADB_TRANSPORT_STATE artifact path                             (default: ~/.mesh/.note3-adb-transport)
#
# Honest contract:  0 = the device answered, artifact written · 2 = honest n/a (no adb binary, adb
# node unreachable, or the device is simply not attached — the normal dark state, not a defect) ·
# 1 = a real defect: the device is LISTED as `device` but the round trip did not come back as itself.
#
#   mesh-adb-transport          probe once, write the artifact on success, always write the run row
#   mesh-adb-transport --test   offline arms (poisoned adb on PATH) + a live real round trip
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes" 2>/dev/null || true

NODE="${MESH_NOTE3_ADB_NODE:-local}"
SER="${MESH_NOTE3_ADB_SERIAL:-4d00553d61ab90b7}"
STATE="${MESH_ADB_TRANSPORT_STATE:-$HOME/.mesh/.note3-adb-transport}"
RUNLOG="${MESH_ADB_TRANSPORT_RUNLOG:-$HOME/.mesh/adb-transport.log}"

now_utc() { date -u +%Y-%m-%dT%H:%M:%SZ; }

# node_sh <cmd> — run on the adb-hosting node (local, or over SSH when the phone hangs off a peer).
node_sh() {
  if [ "$NODE" = local ]; then bash -c "$1"
  else ssh -o BatchMode=yes -o ConnectTimeout=6 "$NODE" "$1"; fi
}

# run_row <verdict> <detail> — the DENOMINATOR. Written on every attempt, whatever happened.
run_row() {
  mkdir -p "$(dirname "$RUNLOG")" 2>/dev/null
  printf '%s serial=%s node=%s verdict=%s %s\n' "$(now_utc)" "$SER" "$NODE" "$1" "$2" >> "$RUNLOG"
}

# probe_once — echoes "<verdict> <detail>"; writes STATE only on `reached`.
probe_once() {
  if ! command -v adb >/dev/null 2>&1 && [ "$NODE" = local ]; then
    echo "na no-adb-binary"; return 2
  fi
  local devs
  devs="$(node_sh "adb devices 2>/dev/null" 2>/dev/null)" || { echo "na adb-node-unreachable"; return 2; }
  if ! printf '%s\n' "$devs" | tr -d '\r' | grep -q "^$SER[[:space:]]\+device$"; then
    # Distinguish "not attached at all" from "attached but unauthorized/offline" — both are n/a for
    # reach, but the word is the whole point of a run row.
    local why=not-attached
    printf '%s\n' "$devs" | tr -d '\r' | grep -q "^$SER[[:space:]]" && why=attached-not-device
    echo "na $why"; return 2
  fi
  local answer
  answer="$(node_sh "adb -s $SER shell getprop ro.serialno 2>/dev/null" 2>/dev/null | tr -d '\r\n')"
  if [ "$answer" != "$SER" ]; then
    # Listed as `device` but it did not come back as ITSELF: the transport is not carrying commands.
    echo "fail round-trip-mismatch got='${answer:-<empty>}'"; return 1
  fi
  local up
  up="$(node_sh "adb -s $SER shell cat /proc/uptime 2>/dev/null" 2>/dev/null | tr -d '\r\n' | awk '{print $1}')"
  [ -n "$up" ] || up=na
  mkdir -p "$(dirname "$STATE")" 2>/dev/null
  local tmp; tmp="$(mktemp "${STATE}.XXXXXX")" || { echo "fail state-tmp"; return 1; }
  printf 'REACHED %s serial=%s ro.serialno=%s device_uptime_s=%s node=%s\n' \
    "$(now_utc)" "$SER" "$answer" "$up" "$NODE" > "$tmp"
  mv -f "$tmp" "$STATE" || { rm -f "$tmp"; echo "fail state-write"; return 1; }
  echo "reached device_uptime_s=$up"; return 0
}

if [ "${1:-}" = --test ]; then
  f=0
  fake="$(mktemp -d)"
  stub="$fake/.local/bin"; mkdir -p "$stub" "$fake/.mesh"
  # The subject re-exports PATH as "$HOME/.local/bin:$PATH", so a stub anywhere else LOSES the race
  # to the real binary. It goes in the fake home's own .local/bin, and the child runs under env -i.
  printf 'export MESH_NOTE3_ADB_NODE=local\nexport MESH_NOTE3_ADB_SERIAL=FIXTURESERIAL\n' > "$fake/.mesh/nodes"
  mk_adb() { # mk_adb <devices-output> <getprop-answer>
    cat > "$stub/adb" <<STUB
#!/usr/bin/env bash
case "\$*" in
  devices) printf '%s\n' "$1" ;;
  *getprop\ ro.serialno*) printf '%s\n' "$2" ;;
  *proc/uptime*) printf '4242.42 999.99\n' ;;
  *) exit 1 ;;
esac
STUB
    chmod +x "$stub/adb"
  }
  run_fake() { env -i HOME="$fake" PATH="/usr/bin:/bin" bash "$0"; }
  st="$fake/.mesh/.note3-adb-transport"; rl="$fake/.mesh/adb-transport.log"

  # arm 1 — DARK TRANSPORT (adb devices empty): no artifact, and a run row all the same.
  mk_adb "List of devices attached" "FIXTURESERIAL"
  run_fake >/dev/null 2>&1; rc=$?
  [ "$rc" = 2 ] || { echo "  FAIL: dark transport must be honest n/a (rc=$rc)"; f=1; }
  [ -e "$st" ] && { echo "  FAIL: dark transport WROTE the device artifact"; f=1; }
  grep -q 'verdict=na not-attached' "$rl" 2>/dev/null || { echo "  FAIL: no run row for the dark attempt (numerator-only tape)"; f=1; }

  # arm 2 — LIVE TRANSPORT: the device answers as itself -> artifact appears, content carries the
  # device's OWN uptime (so the content axis moves, not just the mtime).
  mk_adb "List of devices attached
FIXTURESERIAL	device" "FIXTURESERIAL"
  run_fake >/dev/null 2>&1; rc=$?
  [ "$rc" = 0 ] || { echo "  FAIL: live transport must succeed (rc=$rc)"; f=1; }
  grep -q '^REACHED .*ro.serialno=FIXTURESERIAL device_uptime_s=4242.42' "$st" 2>/dev/null \
    || { echo "  FAIL: artifact missing the device-produced round-trip answer: $(cat "$st" 2>/dev/null)"; f=1; }

  # arm 3 — THE LIE: listed as `device` but the round trip comes back as something else. This is the
  # only arm that separates a device-produced artifact from a locally-minted one; it must REFUSE to
  # advance the artifact (mtime unchanged) and must be a DEFECT, not an n/a.
  before="$(stat -c %Y "$st" 2>/dev/null)"
  mk_adb "List of devices attached
FIXTURESERIAL	device" "SOMEONEELSE"
  sleep 1
  run_fake >/dev/null 2>&1; rc=$?
  [ "$rc" = 1 ] || { echo "  FAIL: round-trip mismatch must be a defect (rc=$rc)"; f=1; }
  after="$(stat -c %Y "$st" 2>/dev/null)"
  [ "$before" = "$after" ] || { echo "  FAIL: a MISMATCHED round trip advanced the artifact ($before -> $after)"; f=1; }
  grep -q 'verdict=fail round-trip-mismatch' "$rl" 2>/dev/null || { echo "  FAIL: mismatch not named in the run log"; f=1; }

  # arm 4 — the run log is the DENOMINATOR: one row per attempt, all three arms, no silences.
  rows="$(wc -l < "$rl" 2>/dev/null || echo 0)"
  [ "$rows" = 3 ] || { echo "  FAIL: run log must carry a row per attempt (got $rows, expected 3)"; f=1; }
  rm -rf "$fake"
  [ "$f" != 0 ] && { echo "smoke-test: FAIL"; exit 1; }

  # LIVE ARM. The n/a boundary here is ORGAN-ABSENT, not device-dark, and the difference decides
  # whether this reflex ever gets wired at all: `mesh-autowire` SKIPs a tool whose --test exits 2, so
  # exiting 2 merely because the phone is in MTP mode today would leave the probe permanently
  # unwired — and then the device-gate artifact is never produced and the phone reads unreached
  # FOREVER, a false absence dressed as honesty. A dark transport is this tool's WANTED verdict, and
  # producing it required a real read (`adb devices` was actually consulted through the adb host).
  # Absent means the organ is absent: no adb binary, or the adb-hosting node cannot be reached.
  # The production STATE is the artifact mesh-minds reads for note3's REACH, so a --test must never
  # advance it: a dry run that writes the liveness record forges the evidence it exists to check —
  # and the advance would carry no run row either, since run_row is the caller's job. The live arm
  # keeps the real transport read and redirects BOTH writes to its own paths.
  live="$(mktemp -d)"; STATE="$live/state"; RUNLOG="$live/run.log"
  out="$(probe_once)"; rc=$?
  run_row "${out%% *}" "${out#* }"
  case "$out" in
    "na no-adb-binary"*|"na adb-node-unreachable"*)
      rm -rf "$live"
      echo "smoke-test: n/a (4 offline arms pass; adb organ absent on $NODE — $out)"; exit 2 ;;
  esac
  if [ "$rc" = 0 ] && ! grep -q "^REACHED .*ro.serialno=$SER" "$STATE" 2>/dev/null; then
    rm -rf "$live"
    echo "smoke-test: FAIL (live round trip claimed success but wrote no device-produced artifact)"; exit 1
  fi
  [ -s "$RUNLOG" ] || { rm -rf "$live"; echo "smoke-test: FAIL (live attempt left no run row)"; exit 1; }
  rm -rf "$live"
  case $rc in
    0) echo "smoke-test: ok (3 poisoned-adb arms + run-log denominator + LIVE round trip: $out)"; exit 0 ;;
    2) echo "smoke-test: ok (3 poisoned-adb arms + run-log denominator + LIVE transport read: $out"
       echo "            — the phone is dark and the artifact was correctly NOT written)"; exit 0 ;;
    *) echo "smoke-test: FAIL (device listed but the round trip did not come back as itself: $out)"; exit 1 ;;
  esac
fi

out="$(probe_once)"; rc=$?
verdict="${out%% *}"; detail="${out#* }"
run_row "$verdict" "$detail"
echo "$out"
exit $rc
