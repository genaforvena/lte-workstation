#!/usr/bin/env bash
# mesh-boot-integrity-recorder — record live TPM PCR 0/7 evidence per boot.
#
# The TPM device is root-only on this node, so the production command is the
# existing non-interactive sudo lane. A read failure is loud and never becomes
# a plausible empty or stale record.

set -euo pipefail

OUTPUT="${MESH_BOOT_INTEGRITY_OUTPUT:-$HOME/.mesh/boot-integrity.jsonl}"
TPM_CMD="${MESH_BOOT_INTEGRITY_TPM_CMD:-}"

if [[ -n "$TPM_CMD" ]]; then
  TPM_READ=("$TPM_CMD")
else
  TPM_READ=(sudo -n tpm2_pcrread)
fi

tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT

if ! "${TPM_READ[@]}" sha256:0,7 >"$tmp" 2>&1; then
  echo "mesh-boot-integrity-recorder: TPM PCR read failed" >&2
  sed -n '1,20p' "$tmp" >&2
  exit 2
fi

bank=""
pcr0=""
pcr7=""
while IFS= read -r line; do
  if [[ "$line" =~ ^[[:space:]]*(sha256):[[:space:]]*$ ]]; then
    bank="${BASH_REMATCH[1]}"
  elif [[ "$line" =~ ^[[:space:]]*0[[:space:]]*:[[:space:]]*0x([[:xdigit:]]+)[[:space:]]*$ ]]; then
    pcr0="${BASH_REMATCH[1]}"
  elif [[ "$line" =~ ^[[:space:]]*7[[:space:]]*:[[:space:]]*0x([[:xdigit:]]+)[[:space:]]*$ ]]; then
    pcr7="${BASH_REMATCH[1]}"
  fi
done <"$tmp"

if [[ "$bank" != sha256 ]] || [[ ! "$pcr0" =~ ^[[:xdigit:]]{64}$ ]] || [[ ! "$pcr7" =~ ^[[:xdigit:]]{64}$ ]]; then
  echo "mesh-boot-integrity-recorder: invalid sha256 PCR 0/7 response" >&2
  sed -n '1,20p' "$tmp" >&2
  exit 2
fi

boot_id=$(< /proc/sys/kernel/random/boot_id)
ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)

if [[ "${1:-}" == --test ]]; then
  printf 'mesh-boot-integrity-recorder --test: PASS (live TPM read, boot=%s, PCR 0/7 present)\n' "$boot_id"
  exit 0
fi

mkdir -p "$(dirname -- "$OUTPUT")"
printf '{"schema":"mesh-boot-integrity/v1","ts":"%s","boot_id":"%s","bank":"%s","pcr":{"0":"%s","7":"%s"}}\n' \
  "$ts" "$boot_id" "$bank" "$pcr0" "$pcr7" >>"$OUTPUT"

printf '%s\n' "$OUTPUT"
