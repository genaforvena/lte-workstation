#!/usr/bin/env bash
# mesh-vitality — the AUTOPOIESIS VITAL-SIGNS reflex. reflex-health proves the self-production lanes
# FIRE (liveness — the heart beats); this proves they PRODUCE (the body grows + stays healthy). A lane
# can run every cron tick and create nothing (mind idle-loops, every task defers, commits flatline) —
# liveness misses that. This tracks productivity over time and edge-alarms when self-production STALLS
# or REGRESSES, so "the mesh quietly stopped improving itself" gets noticed.
#
# Vital signs (all cheap/local):
#   commit_velocity  commits in last 24h          (primary — is the mesh producing at all?)
#   verify_fails     failing tools (mesh-verify-table) (quality — is what it produces sound?)
#   stranded         settled-but-unlanded fixes   (does production reach the genome?)
#   tool_count       genome tool count + delta vs last run (growth/shrink — bloat or autophagy?)
#   heaps_beta       Heaps'-law exponent of tool-diversity vs commit-count (report-only, see below;
#                    <1 sublinear/healthy-extension, →1 near-linear/proliferation — PNAS 2026)
#   autonomy_ratio   self-driven vs externally-dispatched commits over trailing 7d (report-only, see
#                    below; a coarse text-provenance proxy for the field's own CAUSAL AUTONOMY metric)
#   renewal_trend    HLE renewal-vs-compression share, recent window vs prior (report-only, see below)
#   loop_closure     structural: senses with no actuator closing the loop, from topology not dynamics
#                    (report-only, see below; a static grep-census, not a validated graph analysis)
#   path_divergence  cross-channel heterogeneity of board activity, fine vs coarse window (report-only,
#                    see below; MSPD-inspired multi-scale lens, arXiv:2606.17091 2026)
#   inheritance_mu   fraction of 14d-old genome tools STILL alive — the ecological-inheritance persistence
#                    coefficient μ (report-only, see below; niche-construction survival, not birth —
#                    Fogarty & Wade Proc B 2022, PNAS 2026 helpers/free-riders)
#   ecology_potential MODES ECOLOGY hallmark — Shannon evenness of edit-activity across the 14d-PERSISTENT
#                    tools (report-only, see below; balance of coexisting durable taxa, →0=monoculture;
#                    Dolson/Ofria MODES Toolbox Artif.Life 2019, ALIFE-2024 assessment)
#   action_occupancy normalized Shannon entropy of the recent per-tool EDIT distribution — how uniformly
#                    recent production occupies the action space (report-only, see below; Maximum
#                    Occupancy Principle, Moreno-Bote Nat Comm 2024; 1=broad/uniform, →0=hammer-few churn)
#   homeostat34      Beer VSM System-3↔System-4 balance: share of recent commits doing outside-and-forward
#                    environmental-scanning vs present-regulation baseline (report-only, see below; the
#                    "headless-chicken"/"3-4 dissociation" pathology, Pérez Ríos TOP; →0 = all present, no future)
#   allopoiesis_gap  operational-closure of the production→landing loop: does the mesh CLOSE its own
#                    loop, or stall OPEN awaiting an EXTERNAL agent to close it? (report-only, see below;
#                    the autopoiesis-vs-ALLOPOIESIS distinction we name too loosely — Maturana & Varela;
#                    closed | OPEN:<h> = hours the loop has stood open since the last self-close)
# Edge-triggered [vitality-low]/[vitality-ok] (trustworthy-signal: alarm problem + resolution only).
#   mesh-vitality           check + edge-trigger on the board
#   mesh-vitality --check   read-only report (no board post)
#   mesh-vitality --test    smoke test
# reflex-cadence: 17 * * * *
#
# ── POSIWID: the PRIMARY vital sign reads INTENTION, not the loop's actual purpose ──
# POSIWID — "The Purpose Of a System Is What It Does" (Stafford Beer, *The Heart of Enterprise*, 1979):
# a system's purpose is NOT what its designers/operators DECLARE; it is what the system actually,
# constantly does. Beer's sharp form: "there is no point in claiming that the purpose of a system is
# to do what it constantly fails to do" (Wikipedia: "The purpose of a system is what it does", citing
# Beer 1979). It is a SECOND-ORDER move — purpose is OBSERVER-ASCRIBED from behavior, not intrinsic
# to the stated design. We apply it TOO LOOSELY right here: commit_velocity is the PRIMARY vital sign
# ("is the mesh producing at all?"), but it counts EVERY commit equally — including comment-only,
# zero-behavior-change inoculations and churn. A mesh committing 130×/24h of pure comment blocks reads
# as PEAK vitality while the behavior it exhibits never changes. By POSIWID the autopoiesis loop's
# DECLARED purpose is "improve itself", but if it constantly commits-without-changing-behavior then
# its REAL (does-purpose) has drifted to "produce commits" — and commit_velocity, an intention-proxy,
# certifies that drift as health. (This is self-implicating: this very tool's lineage of comment-only
# instrument-first blocks is exactly the high-commit/low-behavioral-delta regime described.)
# NOT requisite-variety (Ashby; regulator vs disturbance variety) · NOT eigenform (von Foerster;
# mesh-novelty) · NOT Pask teach-back (mesh-queue-tend — a verification PROTOCOL that makes a learner
# DEMONSTRATE; POSIWID is an attribution PRINCIPLE: purpose just IS the behavior, nothing to verify
# against) · NOT order-from-noise (mesh-ideate, today) · NOT the verification principle ("claimed
# capability → real artifact" — that asks "did the NEW power produce an artifact?"; commits ARE
# artifacts, so it passes; POSIWID asks whether the AGGREGATE production still serves the loop's
# purpose or has become mere activity). HELD (behavioral, steward/operator-gated): add a productivity-
# QUALITY axis — weight commit_velocity by behavior-changing delta (non-comment diff), and WARN on the
# high-commits / ~zero-behavioral-change regime ("busy but not improving") instead of reading it OK.
# Held because "behavior-changing" is non-trivial to define WITHOUT punishing the deliberate
# instrument-first / knowledge-tier discipline (comment-only inoculations + research docs are
# INTENDED non-code output, not churn) — must be validated against real git history before it changes
# the verdict. See ~/.mesh/knowledge/review-posiwid-intention-vs-behavior-mesh-vitality-2026-06-21.md
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
M="$HOME/.mesh"; REPO="$HOME/lte-workstation"; STATE="$M/.vitality-state"
MIN_COMMITS="${MESH_VIT_MIN_COMMITS:-2}"     # < this in 24h = production stalled
MAX_STRANDED="${MESH_VIT_MAX_STRANDED:-6}"   # > this = production not reaching the genome
FAIL_JUMP="${MESH_VIT_FAIL_JUMP:-5}"         # verify_fails rising by > this since last run = regressing
ASSEMBLY_WIN="${MESH_VIT_ASSEMBLY_WIN:-14.days}"  # commit-subject window for the assembly signature
ASSEMBLY_CAP="${MESH_VIT_ASSEMBLY_CAP:-6}"        # max n-gram length = joining-step ceiling (bounds e^{a_i})
ASSEMBLY_DEPTH="${MESH_VIT_ASSEMBLY_DEPTH:-2}"    # min assembly index (joins) for a motif to count as "deep/selected"
ASSEMBLY_COPY="${MESH_VIT_ASSEMBLY_COPY:-2}"      # min copy number for a motif to count as "abundant"
ASSEMBLY_FLOOR="${MESH_VIT_ASSEMBLY_FLOOR:-8}"    # min commits in window else INSUFFICIENT

# ── HEAPS' LAW: is genome growth EXTENSION (sublinear) or PROLIFERATION (near-linear)? ──
# LITERATURE (live web review, 2026-07-01): Yang, Holehouse, Youn, Arroyo, Redner, West & Kempes,
# "Scaling laws for function diversity and specialization across socioeconomic and biological complex
# systems", PNAS 123(7):e2509729123, 2026 (doi:10.1073/pnas.2509729123). Cells/orgs/agencies grow their
# NUMBER OF DISTINCT FUNCTIONS sublinearly in system size — Heaps' law, β≈0.35–0.57 cross-domain — via a
# Yule-Simon rich-get-richer process: most new activity extends an EXISTING function, and the rate of
# creating brand-NEW functions slows as the system grows. β near/above 1 (linear) means the system keeps
# minting new functions instead of deepening old ones — NOT already embodied (grep: no heaps/yule-simon/
# preferential-attachment/sublinear/scaling-law hit anywhere in scripts/ or docs/ before this).
# APPLICATION: tool_count (report below) is raw diversity — it can't distinguish healthy extension from
# the mesh's own documented over-minting failure ([[cron-cull-mechanics]]: "autopoiesis over-minting
# unconsumed senses"; [[evergreen-repromotion-by-design-mapelites-gap]]). heaps_beta fits β from THIS
# repo's own history: cumulative distinct scripts/mesh-*|test-* file CREATIONS vs cumulative commits,
# log-log regression over 10 chronological checkpoints. First live measurement (2026-07-01, 1726
# commits, 400 tools created): β≈0.73 — sublinear (still healthier than pure proliferation) but above
# every domain the paper measured, i.e. this genome mints new tools faster than a mature complex system.
# Report-only below (same posture as tool_delta) — one cross-sectional β needs a few runs of TREND
# (persisted in STATE) before it's safe to gate an alarm on.
heaps_beta(){
  timeout 15 python3 - "$REPO" 2>/dev/null <<'PYEOF'
import subprocess, math, sys
repo = sys.argv[1] if len(sys.argv) > 1 else "."
def git(*a): return subprocess.run(['git','-C',repo,*a], capture_output=True, text=True).stdout.splitlines()
hashes = git('log','--reverse','--pretty=format:%H')
idx = {h: i+1 for i, h in enumerate(hashes)}
n_total = len(hashes)
if n_total < 20:
    print('n/a'); sys.exit()
raw = git('log','--reverse','--diff-filter=A','--name-only','--pretty=format:@@%H')
cur = None; seen = set(); creations = []
for line in raw:
    if line.startswith('@@'):
        cur = line[2:]
    elif line.strip():
        p = line.strip(); base = p.split('/')[-1]
        if p.startswith('scripts/') and (base.startswith('mesh-') or base.startswith('test-')) \
           and '.' not in base and p not in seen:
            seen.add(p)
            n = idx.get(cur)
            if n: creations.append((n, p))
creations.sort()
v = 0; ci = 0; pts = []
for k in range(1, 11):
    nk = max(1, n_total * k // 10)
    while ci < len(creations) and creations[ci][0] <= nk:
        v += 1; ci += 1
    pts.append((nk, v))
xs = [math.log(n) for n, vv in pts if vv > 0]
ys = [math.log(vv) for n, vv in pts if vv > 0]
if len(xs) < 3:
    print('n/a'); sys.exit()
mx = sum(xs)/len(xs); my = sum(ys)/len(ys)
den = sum((x-mx)**2 for x in xs)
if den == 0:
    print('n/a'); sys.exit()
beta = sum((x-mx)*(y-my) for x, y in zip(xs, ys)) / den
print(f'{beta:.3f}')
PYEOF
}

# ── CAUSAL AUTONOMY: is production SELF-DETERMINED or ENVIRONMENT-FORCED? ──
# LITERATURE (autopoiesis & biology of cognition, angle = a concrete METRIC/experiment the field
# measures itself by; 2026-07-05, genome mind, live WebSearch). The metric angle on this area is
# heavily mined already (six taken: closure-fraction, cognitive-domain partition, structural-
# determinism, adaptivity/graded-viability, irruption/absorption, precariousness — see :176-217
# below) — re-firing the identical angle is the known evergreen-repromotion churn
# ([[idea-churn-is-held-novelty-distance-gap]]). What's genuinely new: none of the six ask the
# field's OWN headline autonomy question — Bertschinger/Olbrich/Jost/Ay-style CAUSAL AUTONOMY
# (surveyed live: "Quantifying the Autonomy of Structurally Diverse Automata", Entropy 23(11):1415,
# 2021) measures how much a system's next state is determined by its OWN prior state under a
# causal intervention that scrubs the environment/input history to max-entropy, vs how much the
# environment still forces it. commit_velocity/heaps_beta (above) measure PRODUCTION VOLUME; none
# ask whether that production is CAUSED BY THE MESH'S OWN PRIOR STATE (self-driven: an idea-queue
# LITERATURE review, a reflex-stream sweep-and-fix, a settled-stream mesh-land) or FORCED BY THE
# ENVIRONMENT (an externally-dispatched chat-review audit finding a specific defect and naming the
# fix). A full causal-intervention A^m needs a modeled transition-probability matrix this mesh has
# no reason to build; this ships the honest, CHEAP proxy actually available today: commit-message
# provenance. `chat-review/<slug>` citations mark commits where ANOTHER mind/operator's audit
# specified the defect+fix — the environment-forced pole. Everything else (LITERATURE reviews,
# reflex-stream fixes, mesh-land aggregations, new capability builds) is self-originated from the
# mesh's own production loop. Report-only (same posture as heaps_beta) — one text-based proxy is
# not a validated causal measure; a low ratio over time would mean the mesh mostly REACTS to
# external audits rather than self-directing its own repair, which is worth seeing, not gating.
# BODY-AWARE FIX (chat-review/autonomy-ratio-prefix-mismatch, 2026-07-05, same-day self-correction):
# shipped this morning matching only a `^chat-review/` SUBJECT prefix — live audit found the actual
# convention cites the slug in the commit BODY (`<tool>: <what> (chat-review/<slug> ...)`), so the
# subject-only match saw 2/225 commits over 7d while `git log --grep` (full message) finds 11 — the
# ratio was pegged near-constant 1.00 by a misclassification, not a real signal. Fixed: classify by
# `git log --grep='chat-review/' -i` (matches subject OR body) instead of a literal subject prefix.
# KNOWN, ACCEPTED LIMIT (not fixed here, out of this task's scope): mesh-land's own aggregate landing
# commit (`mesh-land: land N settled stream fix(es): <tools>`) never itself cites a chat-review slug
# — the steward-centralized commit model bundles multiple tools' fixes under one generic message, so
# a chat-review-dispatched fix that lands via mesh-land still reads as "self" once landed. This proxy
# therefore undercounts forced-vs-self for anything reaching git ONLY through mesh-land's aggregate
# commit; the fix here corrects the DETECTION method for commits that DO carry the citation, not that
# structural gap (a mesh-land provenance-carrying feature is a separate, steward-owned change).
# CROSS-REF: mesh-needs:108-130 already names this exact gap (irruption/absorption, Froese-lineage
# entropy-of-underdetermination) and HOLDS it unshipped pending a full trigger-provenance tag over
# needs.log/dispatch — this ships the honest CHEAP first cut (commit-subject provenance) that IS
# available today, not the deferred full causal-trigger read; it does not resolve that HELD item,
# which stays open for the finer-grained per-task tag.
autonomy_ratio(){
  local total forced self
  total=$(git -C "$REPO" log --oneline --since=7.days 2>/dev/null | wc -l | tr -d ' ')
  [ "${total:-0}" -eq 0 ] 2>/dev/null && { echo 'n/a'; return; }
  # --grep matches the FULL commit message (subject + body) — the real citation convention, not a
  # literal subject prefix (chat-review/autonomy-ratio-prefix-mismatch, 2026-07-05).
  forced=$(git -C "$REPO" log --oneline --since=7.days --grep='chat-review/' -i 2>/dev/null | wc -l | tr -d ' ')
  self=$(( ${total:-0} - ${forced:-0} ))
  awk -v s="${self:-0}" -v t="${total:-0}" 'BEGIN{printf "%.2f", s/t}'
}

# ── HLE: RENEWAL vs COMPRESSION BALANCE — is optimization eating the variety reserve? ──
# LITERATURE (live WebSearch, 2026-07-06, genome mind; homeostasis/allostasis/ultrastability →
# distributed sensor mesh). Landed on a Feb-2026 paper: "Optimized to Death: The Hypernetic Law of
# Experience", Systems (MDPI) 14(2):197, https://www.mdpi.com/2079-8954/14/2/197 . It generalizes
# ASHBY'S NEGLECTED *Law of Experience* (experience = the erosion of a system's initial distinctions
# under repeated transformation — a thermodynamic, not psychological, process) from determinate
# machines to stochastic, gradient-driven adaptive systems. The Hypernetic Law of Experience (HLE):
# adaptive systems under sustained DIRECTIONAL experience progressively CONSUME internal variety and
# converge toward ever-narrower regions of state space. Experience is defined as the dynamic tension
# between ENTROPY REDUCTION (optimization) and VARIETY RETENTION (adaptability); COLLAPSE arises when
# COMPRESSION OUTPACES RENEWAL. The paper's cross-domain instances include RECURSIVE MODEL COLLAPSE in
# machine learning (a system trained on its own outputs narrows) — which is EXACTLY this mesh's risk:
# the idea-queue re-samples its own committed corpus (mesh-generate→mesh-feed→genome→back into the
# sample pool), the self-feeding loop [[idea-churn-is-held-novelty-distance-gap]] already names.
# WHAT'S GENUINELY NEW (audited not-embodied): every vital sign here reads PRODUCTION VOLUME or a
# CUMULATIVE fit — commits24h (gross change), tool_count (cumulative diversity), heaps_beta (a single
# whole-history sublinear exponent), autonomy_ratio (self vs forced). NONE reads the HLE's two-rate
# BALANCE, and none reads its TREND. heaps_beta is the closest cousin but is a global cumulative fit
# dominated by long history — β can sit stable while the RECENT balance tilts hard toward compression.
# APPLICATION (this file): renewal_trend() — RENEWING commits ADD a new mesh-*/test- capability;
# COMPRESSING commits only MODIFY existing ones (tuning/deepening = optimization). Compare renewal's
# SHARE of activity in the recent window vs the prior window: a FALLING share is the HLE variety-
# narrowing direction (the mesh optimizing old tools while minting fewer new ones). Stateless (both
# windows from git, like heaps_beta), REPORT-ONLY (same posture — one proxy is not a validated collapse
# measure; a sustained COMPRESSING read over many runs is worth SEEING, not gating a kill). DISTINCT:
# NOT heaps_beta (cumulative exponent, no recency/no balance); NOT the MODES persistence axis (does
# structure survive+get selected); NOT Hughes novelty+learnability (observer-relative stream property).
renewal_trend(){
  local W="${1:-40}"
  timeout 15 python3 - "$REPO" "$W" 2>/dev/null <<'PYEOF'
import subprocess, sys
repo = sys.argv[1]; W = int(sys.argv[2])
def git(*a): return subprocess.run(['git','-C',repo,*a], capture_output=True, text=True).stdout.splitlines()
# commits that ADDED a new mesh-*/test- script (whole-history A-scan, same idiom as heaps_beta)
raw = git('log','--diff-filter=A','--name-only','--pretty=format:@@%H')
renew=set(); cur=None
for line in raw:
    if line.startswith('@@'): cur=line[2:]
    elif line.strip():
        p=line.strip(); b=p.split('/')[-1]
        if p.startswith('scripts/') and (b.startswith('mesh-') or b.startswith('test-')) and '.' not in b:
            if cur: renew.add(cur)
order = git('log','-n',str(2*W),'--pretty=format:%H')   # recent 2W commits, newest-first
if W < 5 or len(order) < 2*W:
    print('n/a'); sys.exit()
recent = order[:W]; prior = order[W:2*W]
sr = sum(1 for c in recent if c in renew)/W
sp = sum(1 for c in prior  if c in renew)/W
# tag from the PRINTED 2dp digits (integer hundredths), never full precision: the printed line is
# the artifact every reader (incl. the smoke gate) recomputes from, and a share within rounding
# distance of the ±0.02 threshold otherwise tags one way while its printed shares recompute the
# other (live hit: 2/40 vs 1/40 → 0.05<-0.03/renewing, but 0.05 vs 0.03 is balanced).
srs, sps = f'{sr:.2f}', f'{sp:.2f}'
src, spc = int(srs.replace('.','',1)), int(sps.replace('.','',1))
tag = 'COMPRESSING' if src < spc-2 else ('renewing' if src > spc+2 else 'balanced')
print(f'{srs}<-{sps}/{tag}')   # recent<-prior/direction
PYEOF
}

# ── HLE, THE TAIL WE MISSED: early model collapse moves the TAIL first, not the share ──
# LITERATURE (live WebSearch, 2026-07-30, genome mind; homeostasis/allostasis → the idea we applied
# TOO LOOSELY). renewal_trend() above lands the Hypernetic Law of Experience as a FIRST-MOMENT SHARE
# (renewing vs compressing commits). The MDPI HLE note's own headline instance is RECURSIVE MODEL
# COLLAPSE, and the foundational result on it is precise about WHICH MOMENT MOVES FIRST: Shumailov,
# Shumaylov, Zhao, Papernot, Anderson & Gal, "AI models collapse when trained on recursively generated
# data", Nature 631:755-759 (2024), https://www.nature.com/articles/s41586-024-07566-y (preprint "The
# Curse of Recursion", arXiv:2305.17493; live-2026 follow-ups arXiv:2510.05133, arXiv:2502.15654).
# Their finding: EARLY collapse = "the model begins losing information about the TAILS of the
# distribution"; LATE collapse = convergence to a point estimate with very low variance. The tails
# vanish FIRST; the bulk/mean moves LAST. So renewal_trend reads exactly the quantity that shifts LAST
# — its share can read `balanced` for many generations while the boldest, most-distant novelty has
# already been culled from the self-fed pool (mesh-generate→mesh-feed→genome→re-sample). We applied HLE
# at the mean; the early warning lives in the tail. DISTINCT even from action_occupancy() below —
# entropy is a whole-distribution scalar dominated by the bulk, so tail-loss with an intact bulk barely
# moves it (that IS the early regime entropy is blind to); only LATE collapse (variance→0) crushes it.
# HELD FIX (instrument-first, NOT shipped — cheap proxy would be hollow): tail_first() — on the SAME
# added-tool A-scan renewal_trend uses, per newly-added tool compute novelty-distance = 1 − max
# token-Jaccard(new tool, every tool that existed BEFORE it; distance vs the pre-existing corpus only →
# no same-window leakage), then compare the HIGH TAIL (P90) recent-vs-prior against the MEDIAN
# recent-vs-prior: TAILS-THINNING when P90 falls while the median holds (the Shumailov early signature),
# reported BESIDE renewal_trend, never gating a kill. WHY HELD: only a handful of commits ADD a tool per
# 40-commit window, so a per-window P90 over ~3 items is noise, not a tail — the "default indistinguish-
# able from success" trap. A faithful version needs a longer accumulation window OR a denser generative
# distribution (e.g. each commit's REACH into previously-untouched files, not only tool births) validated
# against a real narrowing episode in vitality.log before it is even report-worthy. Zero behavior change.
# doc: docs/reviews/model-collapse-tails-first-vs-hle-renewal-share-mesh-vitality-2026-07-30.md

# ── STRUCTURAL HOMEOSTASIS: is the loop CLOSED by the WIRING, or does a sense write and stop? ──
# LITERATURE (live WebSearch, 2026-07-08, genome mind; homeostasis/allostasis/ultrastability →
# distributed sensor mesh). Landed on Antoneli, Golubitsky et al., "Automated Classification of
# Homeostasis Structure in Input-Output Networks" (arXiv:2603.08882, 2026), building on Golubitsky &
# Stewart's network theory of homeostasis (arXiv:2405.03861). Their result: whether a network exhibits
# INFINITESIMAL HOMEOSTASIS (an output stays ~constant under small input perturbation near equilibrium)
# is a STRUCTURAL property of the wiring diagram — detectable from TOPOLOGY ALONE (does a feedback
# "appendage" close back onto the regulated "core"?), with NO dynamical simulation and NO parameter
# fitting. A network either HAS a homeostasis subnetwork wired in, or it does not — and if it does not,
# no amount of threshold-tuning on the open chain will ever produce the property.
# WHAT'S GENUINELY NEW (audited not-embodied): every homeostasis/allostasis instrument already landed
# in this mesh — mesh-homeostasis's I-controller + its ultrastability/good-regulator literature notes,
# mesh-therm-watch's settling-point-vs-set-point, mesh-stress's allostatic load, this file's
# heaps_beta/renewal_trend — analyzes DYNAMICS: a time series of readings, fit to a controller model or
# a trend. NONE asks the STRUCTURAL question first: for a given sense's STATE artifact, does ANY tool in
# the genome actually CLOSE the loop (read that state AND drive a corrective action back onto the same
# measured domain), or does the sense chain dead-end at a dashboard/report — open-loop BY CONSTRUCTION,
# no matter how well its threshold is tuned. That is exactly the paper's move: classify from the WIRING
# DIAGRAM, not the waveform.
# APPLICATION (this file): loop_closure_frac() — a static, read-only census over scripts/mesh-*: for
# each tool that declares a "$MESH/.*-state"-style artifact (a candidate SENSE), grep the repo for any
# tool referencing that same state-file basename that ALSO calls a recognizable ACTUATOR primitive
# (mesh-chat/mesh-fix-*/sudo/systemctl/tailscale/curl.*-X.*POST/ssh/adb shell/kill/pkill) — CLOSED if
# found, OPEN otherwise. Reports closed/open counts + the OPEN list: dead-end senses the paper's
# structural argument predicts will never self-regulate, however well their thresholds are tuned.
# Spot-checked live: mesh-storage-health's (fusion+attribution, no actuator call anywhere in the file)
# state artifact is OPEN — a real, correctly-classified instance. SELF-REFERENCE TRAP (found live
# writing this note): the FIRST draft of this comment spelled the artifact's literal name, which made
# THIS FILE its own false-CLOSED writer the moment it also mentioned mesh-chat elsewhere (:539) — a
# census that greps prose is corrupted by prose about the census. Fixed by scanning CODE lines only
# (comment lines excluded) in the implementation below; kept the caveat out of literal-string form here
# too, on purpose. Stateless PROXY (not a real Jacobian/graph analysis — a topology GUESS, same honesty
# posture as renewal_trend/heaps_beta: report-only, not a gate — a file can reference a state basename
# in CODE and call an actuator for an UNRELATED reason, a false-CLOSED the proxy still cannot rule out).
# DISTINCT: NOT hollow-sense
# ([[fusion-tools-distinguish-empty-from-failed]] — that catches an EMPTY/stale READ; this catches a
# structurally UNCLOSED loop even when the read is perfectly live); NOT requisite-variety (Ashby;
# regulator-vs-disturbance variety COUNT, not topology); NOT the ultrastability second-loop
# (mesh-homeostasis — that is about RECONFIGURING an existing regulator; this is about whether a
# regulator exists AT ALL, topologically, before reconfiguration is even on the table).
loop_closure_frac(){
  local repo="${1:-$REPO}"
  timeout 15 python3 - "$repo" 2>/dev/null <<'PYEOF'
import glob, re, sys
repo = sys.argv[1]
sense_re = re.compile(r'="\$(?:MESH|MESH_DIR)\w*/(\.[\w-]*-state[\w-]*)"')
actuator_re = re.compile(r'mesh-chat|mesh-fix-|sudo |systemctl |tailscale |curl.*-X.*POST|ssh .*|adb shell|kill -|pkill ')
files = sorted(glob.glob(f'{repo}/scripts/mesh-*'))
# CODE-only per file: whole-line comments excluded, so a literal state name or actuator word
# mentioned in PROSE (like this very review) can never masquerade as real wiring.
code = {}
for f in files:
    try:
        with open(f, errors='ignore') as fh:
            code[f] = '\n'.join(l for l in fh if not l.strip().startswith('#'))
    except OSError:
        continue
senses = set()
for txt in code.values():
    senses.update(sense_re.findall(txt))
if not senses:
    print('n/a'); sys.exit()
closed, open_list = 0, []
for s in sorted(senses):
    has_actuator = any(s in txt and actuator_re.search(txt) for txt in code.values())
    if has_actuator: closed += 1
    else: open_list.append(s)
tail = f" open:[{' '.join(open_list)}]" if open_list else ''
print(f'closed={closed} open={len(open_list)}{tail}')
PYEOF
}

# ── MULTI-SCALE PATH DIVERGENCE (MSPD): does channel heterogeneity hold across timescales? ──
# LITERATURE (artificial life / open-ended evolution, live WebSearch 2026-07-08): Multi-Scale Path
# Divergence — "Directing Open-Ended Evolution in Artificial Life via Multi-Scale Path Divergence",
# arXiv:2606.17091 (2026). A renormalization-group-inspired scalar that quantifies the temporal
# MULTISCALE organization of heterogeneity in LOCAL TRANSITION LAWS — a windowed, finite-resolution
# estimator over realized trajectories, used both as a gradient-free fitness function (steers evolution
# toward genuinely complex regimes across substrates: Flow-Lenia, cellular automata, Particle Life++)
# and as a post-hoc analytical lens: high-complexity systems show LARGER differences between the
# dynamics expressed at different scales, while a degenerate (frozen or fully-random) system looks the
# SAME whether you zoom in or out.
# NOT already embodied: heaps_beta/autonomy_ratio/renewal_trend/loop_closure_frac (this file) and the
# HELD MODES/precariousness/Hughes reviews above all analyze a SINGLE scale — the whole-repo commit
# stream, or a one-shot structural census. None asks whether the mesh's OWN dynamics look different
# depending on the resolution you examine them at, which is MSPD's entire mechanism and a genuinely
# distinct axis (spatial/cross-channel scale, not a temporal trend of one metric).
# APPLICATION (this file): path_divergence() treats each mesh CHANNEL (minds/genome/health/senses/
# chat/... — chat.log's own vocabulary) as a "site" with its own local posting cadence, the mesh's
# analog of MSPD's "local transition law". At a FINE window (last ~3.3h, 10min-scale) and a COARSE
# window (last ~40h, 2h-scale) it computes each channel's SHARE of total board-post volume, then the
# cross-channel heterogeneity (stdev of shares) at each scale. path_divergence = |het_fine - het_coarse|
# / max(het_fine, het_coarse): near 0 means the mesh's division of labor across channels is
# SCALE-INVARIANT (the same channels dominate whether you zoom to 10min or out to 2h — MSPD's
# low-complexity, "looks the same at every scale" case); near 1 means which channels dominate genuinely
# FLIPS depending on the scale you look at (real multi-scale structure — or noise; either way, a lens
# no existing vital sign here reads). Report-only (same posture as heaps_beta/autonomy_ratio) — one
# cross-sectional reading needs a few runs of trend before it is safe to gate an alarm, and unlike
# MSPD's original dual role, this is diagnostic-only: nothing here STEERS the mesh toward high
# divergence, it only measures whether the mesh's board activity already has it.
# DISTINCT: NOT heaps_beta (temporal growth-law of tool diversity, single scale); NOT autonomy_ratio
# (causal-source attribution, not dynamics shape); NOT renewal_trend (recent-vs-prior share of ONE
# metric, not cross-channel heterogeneity); NOT loop_closure_frac (static topology census, no dynamics
# at all); NOT the HELD Hughes novelty+learnability block above (single-scale observer-predictability
# of the commit stream specifically, not a multi-scale cross-channel comparison over board activity).
path_divergence(){
  local log="${1:-$M/chat.log}"
  [ -r "$log" ] || { echo 'n/a'; return; }
  timeout 15 python3 - "$log" 2>/dev/null <<'PYEOF'
import sys, re
from collections import defaultdict
from datetime import datetime, timezone

log = sys.argv[1]
FINE, COARSE = 600, 7200  # seconds — 20 windows back = ~3.3h fine lookback, ~40h coarse lookback
ts_re = re.compile(r'^(\S+)\s+(\S+?)@\S+\s+::')

def parse_ts(s):
    try:
        return datetime.strptime(s, '%Y-%m-%dT%H:%M:%SZ').replace(tzinfo=timezone.utc).timestamp()
    except ValueError:
        return None

events = []  # (epoch, channel)
try:
    with open(log, errors='ignore') as fh:
        for line in fh:
            m = ts_re.match(line)
            if not m:
                continue
            t = parse_ts(m.group(1))
            if t is None:
                continue
            events.append((t, m.group(2)))
except OSError:
    print('n/a'); sys.exit()

if len(events) < 30:
    print('n/a'); sys.exit()

events.sort()
t_max = events[-1][0]

def het_at_scale(window):
    cutoff = t_max - window * 20
    counts = defaultdict(int)
    total = 0
    for t, ch in events:
        if t >= cutoff:
            counts[ch] += 1
            total += 1
    if total == 0 or len(counts) < 2:
        return None
    shares = [c / total for c in counts.values()]
    mean = sum(shares) / len(shares)
    var = sum((s - mean) ** 2 for s in shares) / len(shares)
    return var ** 0.5

hf = het_at_scale(FINE)
hc = het_at_scale(COARSE)
if hf is None or hc is None:
    print('n/a'); sys.exit()
denom = max(hf, hc)
if denom == 0:
    print('0.000'); sys.exit()
print(f'{abs(hf - hc) / denom:.3f}')
PYEOF
}

# ── ECOLOGICAL-INHERITANCE PERSISTENCE μ: do the mesh's constructions SURVIVE, or are they spider webs? ──
# LITERATURE (niche construction theory, live WebSearch 2026-07-10): Fogarty & Wade, "Niche construction
# in quantitative traits: heritability and response to selection", Proc. R. Soc. B 289:20220401 (2022,
# PMC9156914) formalize niche construction as a modified breeder's equation whose FEEDBACK term is scaled
# by an ECOLOGICAL-INHERITANCE ACCUMULATION coefficient M₁ = Σₜ μᵗ, where μ<1 is the PER-GENERATION
# PERSISTENCE (decay) of past constructions: μ→1 constructions endure and compound into future selection;
# μ→0 they evaporate before they can feed back. Danchin et al.'s canonical discriminator (echoed in the
# 2026 PNAS "Ecological inheritance facilitates the coexistence of environmental helpers and free-riders",
# doi:10.1073/pnas.2527016123, and its bioRxiv 2025.06.30.662428 preprint): a modification too TRANSIENT
# is NOT ecological inheritance at all — the spider web is excluded precisely because it does not persist
# across generations. Persistence, not the act of building, is what makes a construction heritable.
# NOT already embodied: EVERY vital sign here reads a BIRTH RATE or a snapshot — commit_velocity (how fast
# we build), heaps_beta (diversity of what we build), tool_count Δ (NET growth = births − deaths, which
# CANCELS: 5 tools added + 5 attic'd reads Δ0, identical to zero activity), autonomy_ratio (who caused a
# build), renewal_trend/path_divergence/loop_closure (shape/topology of activity). None reads the SURVIVAL
# of what was already built. A mesh can commit at peak velocity while every construction is reverted,
# orphaned, attic'd, or renamed within days (μ≈0, pure churn — the "idea-churn is a known MAP-Elites gap"
# regime) and every existing sign certifies it HEALTHY. μ is the missing decay half of birth−decay.
# APPLICATION (this file): inheritance_mu() computes the EMPIRICAL persistence coefficient over a trailing
# window (default 14d) straight from git — no model, no network. Cohort = the genome tools (scripts/mesh-*)
# that existed at the commit just before the window opened; μ = fraction of that cohort STILL present at
# HEAD. μ=1.000 → every construction from two weeks ago survives (strong ecological inheritance, the loop
# compounds); a low μ → the mesh is spider-webbing (building fast, keeping little — churn the birth-rate
# signs are blind to). Report-only, same posture as heaps_beta/path_divergence: one cross-sectional μ needs
# a few runs of trend before it is safe to gate an alarm, and file-presence survival slightly OVER-counts
# (a DECAYED-in-place tool like mesh-mind-watch still on disk reads as a survivor) — honest and cheap now,
# refine to content-liveness later.
# DISTINCT: NOT tool_count Δ (that is signed NET growth over 1 run and cancels births against deaths; μ is
# the unsigned SURVIVAL FRACTION of a fixed past cohort — orthogonal: Δ can be +5 while μ is 0.3). NOT
# heaps_beta (diversity growth-LAW of the births, says nothing about whether they last). NOT renewal_trend
# (HLE compression-vs-renewal SHARE of recent activity, not survival of past artifacts). NOT autonomy_ratio
# (causal source of a commit, not its fate).
inheritance_mu(){
  command -v git >/dev/null 2>&1 || { echo 'n/a'; return; }
  local repo="${1:-$REPO}" days="${2:-14}"
  git -C "$repo" rev-parse HEAD >/dev/null 2>&1 || { echo 'n/a'; return; }
  local base; base="$(git -C "$repo" rev-list -1 --before="${days} days ago" HEAD 2>/dev/null)"
  [ -n "$base" ] || { echo 'n/a'; return; }   # repo younger than the window → no cohort to age
  local cohort; cohort="$(git -C "$repo" ls-tree -r --name-only "$base" scripts/ 2>/dev/null | grep -E '(^|/)mesh-[a-z0-9-]+$')"
  [ -n "$cohort" ] || { echo 'n/a'; return; }
  local head_set; head_set="$(git -C "$repo" ls-tree -r --name-only HEAD scripts/ 2>/dev/null)"
  local total surv
  total="$(printf '%s\n' "$cohort" | wc -l | tr -d ' ')"
  # count via awk NF (empty-safe: comm can emit one blank common line if BOTH inputs are empty →
  # wc -l would miscount that as 1; NF filters blanks, so the intersection count is always exact).
  surv="$(comm -12 <(printf '%s\n' "$cohort" | sort -u) <(printf '%s\n' "$head_set" | sort -u) | awk 'NF{c++} END{print c+0}')"
  [ "${total:-0}" -gt 0 ] 2>/dev/null || { echo 'n/a'; return; }
  awk -v s="$surv" -v t="$total" 'BEGIN{printf "%.3f", s/t}'
}

# ── ecology_potential — the MODES ECOLOGY HALLMARK, the one hallmark this file DOES NOT read ──────────
# LITERATURE (artificial life / open-ended evolution, live WebSearch 2026-07-29, genome mind). The MODES
# toolbox (Dolson, Vostinar, Wiser & Ofria, "The MODES Toolbox: Measurements of Open-Ended Dynamics in
# Evolving Systems", Artificial Life 25(1):50, 2019) names FOUR hallmarks — change, novelty, complexity,
# and ECOLOGY — and defines ECOLOGICAL POTENTIAL as the Shannon entropy of the abundance distribution of
# the PERSISTENT taxa: a system has ecology when MULTIPLE lineages simultaneously pass the persistence
# filter and coexist in a relatively BALANCED distribution (not one dominant type + a fringe). The KNOWN
# FAILURE MODE — the reason this is worth landing: ecology is the hallmark HARDEST to achieve and most
# often ABSENT even when the other three read positive. The 2024 assessment (Nagpal, Vostinar et al.,
# "Assessing the ability of the MODES toolbox to detect hallmarks of open-endedness", ALIFE 2024 Proc.
# 36:10) found that across NK-landscape conditions "fitness sharing is the only condition that reliably
# produces ecology" (fit-when-rare / negative frequency-dependence) — change/novelty/complexity rise
# freely while ecology stays flat. So a change+novelty+complexity reading OVER-CLAIMS open-endedness: a
# monoculture that churns hard scores high on every axis this file already has, and NONE of them can see
# that the durable core is a single dominant type.
# WHERE THIS FILE COMMITS THE GAP: it already reads change (commit_velocity), novelty (renewal_trend /
# heaps births), complexity (path_divergence), and even ecological INHERITANCE persistence (inheritance_μ)
# — but the μ metric is a single SURVIVAL FRACTION of a cohort (μ=1.0 = "all survived") with no diversity/
# balance term, and action_occupancy is Shannon entropy over ALL recently-edited tools with NO persistence
# filter (it counts ephemeral/newborn churn as spread). Neither reads the MODES ecology object: the BALANCE
# of activity across the tools that PASSED the persistence filter. μ can be 1.000 and action_occupancy high
# while every edit lands on 3 tools and the other 400 persistent survivors are inert — textbook "no ecology
# under high change/novelty", invisible here.
# APPLICATION (this file): ecology_potential() intersects the persistence-filtered cohort (tools that
# existed 14d ago AND are still present at HEAD — the SAME filter inheritance_μ uses) with the last-N-commit
# edit activity, and reports the Shannon EVENNESS (H/ln K) of the edit-count distribution over that durable,
# COEXISTING-AND-ACTIVE set. 1.000 = activity balanced across many persistent taxa (rich ecology); →0 = the
# durable core is a monoculture a few tools dominate. Report-only, same posture as inheritance_μ /
# path_divergence — one cross-sectional evenness needs a few runs of trend before it can gate, and edit-
# count is an activity ANALOG of MODES abundance, not a population census (honest and cheap now). n/a until
# ≥2 persistent taxa are active in the window.
# DISTINCT: NOT action_occupancy (Shannon over ALL edited tools, NO persistence filter — includes newborn/
# transient churn; ecology restricts to the 14d-persistent core → exactly the change-vs-ecology gap). NOT
# inheritance_μ (single survival FRACTION of the cohort, no balance term — μ→1 says nothing about whether
# activity is concentrated). NOT heaps_beta (birth diversity-law). NOT path_divergence (cross-CHANNEL board
# heterogeneity, not code-tool abundance).
ecology_potential(){
  command -v python3 >/dev/null 2>&1 || { echo 'n/a'; return; }
  command -v git >/dev/null 2>&1 || { echo 'n/a'; return; }
  local repo="${1:-$REPO}" days="${2:-14}" n="${3:-60}"
  timeout 15 python3 - "$repo" "$days" "$n" 2>/dev/null <<'PYEOF'
import subprocess, math, sys
from collections import Counter
repo = sys.argv[1]; days = sys.argv[2]; n = int(sys.argv[3])
def git(*a): return subprocess.run(['git','-C',repo,*a], capture_output=True, text=True).stdout
def is_tool(p):
    b = p.split('/')[-1]
    return p.startswith('scripts/') and (b.startswith('mesh-') or b.startswith('test-')) and '.' not in b
# persistence filter: cohort present `days` ago AND still present at HEAD (same filter as inheritance_μ)
base = git('rev-list','-1','--before=%s days ago' % days,'HEAD').strip()
if not base:
    print('n/a'); sys.exit()
cohort = {p for p in git('ls-tree','-r','--name-only',base,'scripts/').splitlines() if is_tool(p)}
head   = {p for p in git('ls-tree','-r','--name-only','HEAD','scripts/').splitlines() if is_tool(p)}
persistent = cohort & head
if len(persistent) < 2:
    print('n/a'); sys.exit()
# edit activity over the last N commits, restricted to the persistent (coexisting) set
c = Counter()
for line in git('log','-n',str(n),'--name-only','--pretty=format:@@').splitlines():
    if line.startswith('@@') or not line.strip():
        continue
    p = line.strip()
    if p in persistent:
        c[p] += 1
total = sum(c.values()); K = len(c)   # K = persistent taxa ACTIVE in the window (coexisting), N = edit-events
if K < 2 or total < 2:
    print('n/a'); sys.exit()
H = -sum((v/total) * math.log(v/total) for v in c.values())
Hn = H / math.log(K)   # evenness over the ACTIVE persistent taxa (H/ln K, MODES ecological-potential analog)
print(f'{Hn:.3f}(K={K}/N={total})')
PYEOF
}

# ── nfds_coefficient — NEGATIVE FREQUENCY-DEPENDENCE, the DRIVER ecology_potential only sees the EFFECT of
# LITERATURE (artificial life / open-ended evolution, live WebSearch 2026-07-29, genome mind; angle = a
# concrete metric the field uses to explain WHY ecology appears). ecology_potential (just above) reads the
# MODES ecology hallmark as a cross-sectional BALANCE — evenness of activity across persistent taxa NOW.
# But the ALIFE-2024 assessment it cites (Nagpal, Vostinar et al., ALIFE 2024 Proc. 36:10) is explicit
# about the CAUSE of that balance: across NK conditions "fitness sharing is the only condition that
# reliably produces ecology" — and fitness sharing IS negative frequency-dependent selection (NFDS):
# a type's advantage RISES as its relative frequency FALLS (rare-type advantage). The evolutionary-ecology
# literature makes NFDS the load-bearing diversity-MAINTAINING force:
#   • Christie & McNickle, "Negative frequency dependent selection unites ecology and evolution",
#     Ecology & Evolution 13(8):e10327 (2023) — https://doi.org/10.1002/ece3.10327 (NFDS: rare-type
#     fitness advantage → invasion-when-rare → the "most powerful process capable of maintaining
#     polymorphism"; the restoring force behind coexistence).
#   • MODES/ecology assessment: Nagpal & Vostinar et al., ALIFE 2024 Proc. 36:10 (fit-when-rare is the
#     condition that produces the ecology hallmark; without it change/novelty/complexity rise but ecology
#     stays flat).
# THE GAP THIS CLOSES. ecology_potential measures the RESULT (is the durable core balanced today?); NOTHING
# here measures the DRIVER (is there a restoring FORCE toward balance, or a diverging rich-get-richer one?).
# The two come apart in exactly the dangerous direction: a mesh can read HIGH ecology now yet be under
# POSITIVE frequency-dependence (edits piling onto the already-dominant tools) — balanced today, drifting
# to monoculture tomorrow. A static evenness snapshot is blind to that derivative; it only alarms once the
# monoculture has ALREADY formed. NFDS is the leading indicator ecology_potential structurally cannot be.
# METRIC. Over the SAME 14d-persistent cohort (the coexisting durable taxa), split edit-activity into a
# PRIOR window (days -14..-7) and a RECENT window (days -7..0). For each persistent tool: its FREQUENCY in
# the prior window (how common it was) and its ACTIVITY in the recent window (what it gained). NFDS =
# −ρ_spearman(freq_prior, activity_recent): positive ⟺ tools that were RARE-in-prior gained MORE recent
# activity (rare-type advantage, diversity-restoring, the ecology-producing force); negative ⟺ already-
# common tools gained more (rich-get-richer, monoculture drift); ≈0 ⟺ neutral. Rank correlation (pure
# python, no scipy) so a single runaway tool can't dominate a raw-count regression.
# APPLICATION (this file): report-only vital sign nfds_coefficient(), same posture as ecology_potential /
# inheritance_μ — it exposes the SIGN of the frequency-dependence force driving the code ecology; a
# sustained negative reading is the early warning that the balance ecology_potential still reads as healthy
# is being actively eroded. Not a gate (one window is noisy; sign needs trend). n/a until ≥4 persistent
# taxa carry activity across the two windows (a correlation over <4 points is not a force).
# DISTINCT from every existing sign: NOT ecology_potential (the LEVEL of balance now — a static snapshot;
# NFDS is its DERIVATIVE/driver, and the two can disagree: high level + negative driver = the pre-monoculture
# warning). NOT inheritance_μ (survival FRACTION of the cohort — no frequency dynamics at all). NOT
# action_occupancy (entropy of the CURRENT edit distribution — a spread magnitude, not a rarity→gain
# coupling across two times). NOT heaps_beta (vocabulary BIRTH law) nor renewal_trend (novelty INFLUX
# magnitude — neither reads whether rarity PREDICTS subsequent gain).
nfds_coefficient(){
  command -v python3 >/dev/null 2>&1 || { echo 'n/a'; return; }
  if [ "${1:-}" = --selftest ]; then
    timeout 15 python3 - --selftest 2>/dev/null <<'PYEOF'
import sys
def spearman(xs, ys):
    def ranks(v):
        order = sorted(range(len(v)), key=lambda i: v[i])
        r = [0.0]*len(v); i = 0
        while i < len(v):
            j = i
            while j+1 < len(v) and v[order[j+1]] == v[order[i]]: j += 1
            avg = (i+j)/2.0 + 1
            for k in range(i, j+1): r[order[k]] = avg
            i = j+1
        return r
    rx, ry = ranks(xs), ranks(ys); n = len(xs)
    mx = sum(rx)/n; my = sum(ry)/n
    num = sum((rx[i]-mx)*(ry[i]-my) for i in range(n))
    dx = sum((rx[i]-mx)**2 for i in range(n))**0.5; dy = sum((ry[i]-my)**2 for i in range(n))**0.5
    return num/(dx*dy) if dx and dy else 0.0
def nfds(freq_prior, act_recent): return -spearman(freq_prior, act_recent)
# (a) RARE-GAINS: prior-rare tools gain most recent activity → NFDS strongly POSITIVE (rare-type advantage)
a = nfds([0.4,0.3,0.2,0.1], [1,2,3,4])
# (b) RICH-GET-RICHER: prior-common tools gain most → NFDS strongly NEGATIVE (monoculture drift)
b = nfds([0.4,0.3,0.2,0.1], [4,3,2,1])
ok = (a > 0.99) and (b < -0.99)
print('selftest: %s (rare-gains=%+.2f rich-richer=%+.2f)' % ('PASS' if ok else 'FAIL', a, b))
sys.exit(0 if ok else 1)
PYEOF
    return
  fi
  command -v git >/dev/null 2>&1 || { echo 'n/a'; return; }
  local repo="${1:-$REPO}" old="${2:-14}" mid="${3:-7}"
  git -C "$repo" rev-parse HEAD >/dev/null 2>&1 || { echo 'n/a'; return; }
  timeout 15 python3 - "$repo" "$old" "$mid" 2>/dev/null <<'PYEOF'
import subprocess, sys
from collections import Counter
repo = sys.argv[1]; old = sys.argv[2]; mid = sys.argv[3]
def git(*a): return subprocess.run(['git','-C',repo,*a], capture_output=True, text=True).stdout
def is_tool(p):
    b = p.split('/')[-1]
    return p.startswith('scripts/') and (b.startswith('mesh-') or b.startswith('test-')) and '.' not in b
def spearman(xs, ys):
    def ranks(v):
        order = sorted(range(len(v)), key=lambda i: v[i])
        r = [0.0]*len(v); i = 0
        while i < len(v):
            j = i
            while j+1 < len(v) and v[order[j+1]] == v[order[i]]: j += 1
            avg = (i+j)/2.0 + 1
            for k in range(i, j+1): r[order[k]] = avg
            i = j+1
        return r
    rx, ry = ranks(xs), ranks(ys); n = len(xs)
    mx = sum(rx)/n; my = sum(ry)/n
    num = sum((rx[i]-mx)*(ry[i]-my) for i in range(n))
    dx = sum((rx[i]-mx)**2 for i in range(n))**0.5; dy = sum((ry[i]-my)**2 for i in range(n))**0.5
    return num/(dx*dy) if dx and dy else 0.0
# persistence filter: present `old` days ago AND still at HEAD (same durable-coexisting cohort as ecology)
base = git('rev-list','-1','--before=%s days ago' % old,'HEAD').strip()
if not base:
    print('n/a'); sys.exit()
cohort = {p for p in git('ls-tree','-r','--name-only',base,'scripts/').splitlines() if is_tool(p)}
head   = {p for p in git('ls-tree','-r','--name-only','HEAD','scripts/').splitlines() if is_tool(p)}
persistent = cohort & head
if len(persistent) < 4:
    print('n/a'); sys.exit()
def activity(since, until):
    c = Counter()
    args = ['log','--since=%s days ago' % since,'--name-only','--pretty=format:@@']
    if until is not None: args.insert(1, '--until=%s days ago' % until)
    for line in git(*args).splitlines():
        if line.startswith('@@') or not line.strip(): continue
        p = line.strip()
        if p in persistent: c[p] += 1
    return c
prior  = activity(old, mid)     # days -old .. -mid  (e.g. -14..-7)  → FREQUENCY when it was "then"
recent = activity(mid, None)    # days -mid .. now   (e.g.  -7..0)   → activity GAINED "since"
# points = persistent tools carrying activity in EITHER window (a rare taxon has prior freq 0, recent>0)
tools = sorted(t for t in persistent if prior.get(t,0) or recent.get(t,0))
if len(tools) < 4:
    print('n/a'); sys.exit()
tot_prior = sum(prior.values()) or 1
freq_prior = [prior.get(t,0)/tot_prior for t in tools]
act_recent = [recent.get(t,0) for t in tools]
if len(set(freq_prior)) < 2 or len(set(act_recent)) < 2:
    print('n/a'); sys.exit()   # no variation on an axis → correlation undefined, never a faked 0
nfds = -spearman(freq_prior, act_recent)
print('%+.2f(K=%d,prior%s-%sd->recent%s-0d)' % (nfds, len(tools), old, mid, mid))
PYEOF
}

# ── mls_conflict — MULTILEVEL-SELECTION signature: do PRODUCTIVE edits build DOOMED lineages? ─────────
# LITERATURE (artificial life / open-ended evolution, angle = a known FAILURE MODE; live WebSearch
# 2026-07-31, genome mind). Landed on the freshest published phylogeny-of-selection method:
#   • Moreno, Hasanzadeh Fard, Zaman & Dolson (2025). "Extending a Phylogeny-based Method for Detecting
#     Signatures of Multi-level Selection for Applications in Artificial Life." arXiv:2508.14232 (Aug 2025)
#     — extends Bonetti Franceschi & Volz (2024). The signature it detects: TRAITS THAT APPEAR MORE OFTEN
#     THAN EXPECTED BY CHANCE (individual-level fitness benefit) BUT ARE ASSOCIATED WITH SMALLER,
#     SHORTER-LIVED DESCENDANT CLADES (negative longer-term / group-level outcome). A short-term individual
#     win that mortgages the lineage — the multilevel-selection CONFLICT.
# THE FAILURE MODE IT CLOSES (why it is worth landing). Every PRODUCTIVITY sign in this file rewards
# PROLIFERATION and is blind to whether the proliferating lineage PERSISTS: commit_velocity (gross change),
# heaps_beta / renewal_trend (birth-rate of new tools), autonomy_ratio (who initiated). A genome can post
# high velocity while every edit-burst is a flash-in-the-pan — churn that looks like open-endedness but
# builds nothing that lasts. That is EXACTLY the individual-benefit / clade-cost conflict the phylogenetic
# method names: the tools that attract the most early edits are the ones that then get abandoned/decayed.
# NONE of the existing marginal metrics can see it — they read the edit DISTRIBUTION at a slice, never the
# COUPLING between a newborn's early activity and its own subsequent survival.
# APPLICATION (this file): mls_conflict() — the mesh's "population" is scripts/mesh-*/test- tools; a NEWBORN
# is a tool whose FIRST commit falls in a past window (born `old`..`mid` days ago, so its fate is already
# observable). For each newborn: individual-level "fitness" = EARLY EDIT-BURST (commits touching it within
# `bd` days of birth = how strongly the mesh selected it in the moment); clade fate = LONGEVITY FRACTION
# = (last_touch − birth)/(now − birth) ∈ (0,1] (1 = still actively edited to now, →0 = burst-then-abandoned
# /deleted) — age-normalized so an older newborn isn't scored long-lived merely for being older. Signal =
# −ρ_spearman(burst, longevity): POSITIVE (+) = CONFLICT (the most-edited newborns are the shortest-lived
# — selfish churn the velocity metrics score as health); ≈0/negative = ALIGNED (productive newborns persist
# and compound). REPORT-ONLY (same posture as nfds/ecology/heaps_beta): one cross-sectional correlation is
# an early lens, not a gate. Honest n/a until ≥4 newborns vary on both axes (no variation → correlation
# undefined, never a faked 0). Falsifiable --selftest (conflict→+1 / aligned→−1, seen red→green).
# DISTINCT from every existing sign: NOT inheritance_mu (aggregate survival FRACTION of a cohort — no link
# to which tools were most active; μ says HOW MANY survived, mls says whether the BUSIEST newborns are the
# doomed ones). NOT nfds_coefficient (freq_prior→activity among the PERSISTENT cohort — rare-gets-active;
# mls is early_activity→survival among NEWBORNS — orthogonal axis AND a different population). NOT
# renewal_trend (birth-RATE, blind to fate). NOT ecology_potential (activity-EVENNESS across persistent
# taxa — balance now, no newborn-fate coupling). NOT omega_cycle (temporal ORDER of the edit stream).
mls_conflict(){
  command -v python3 >/dev/null 2>&1 || { echo 'n/a'; return; }
  if [ "${1:-}" = --selftest ]; then
    timeout 15 python3 - --selftest 2>/dev/null <<'PYEOF'
import sys
def spearman(xs, ys):
    def ranks(v):
        order = sorted(range(len(v)), key=lambda i: v[i])
        r = [0.0]*len(v); i = 0
        while i < len(v):
            j = i
            while j+1 < len(v) and v[order[j+1]] == v[order[i]]: j += 1
            avg = (i+j)/2.0 + 1
            for k in range(i, j+1): r[order[k]] = avg
            i = j+1
        return r
    rx, ry = ranks(xs), ranks(ys); n = len(xs)
    mx = sum(rx)/n; my = sum(ry)/n
    num = sum((rx[i]-mx)*(ry[i]-my) for i in range(n))
    dx = sum((rx[i]-mx)**2 for i in range(n))**0.5; dy = sum((ry[i]-my)**2 for i in range(n))**0.5
    return num/(dx*dy) if dx and dy else 0.0
def mls(burst, longevity): return -spearman(burst, longevity)
# (a) CONFLICT: the highest-burst newborns are the SHORTEST-lived → mls strongly POSITIVE (selfish churn)
a = mls([4,3,2,1], [0.1,0.2,0.8,0.9])
# (b) ALIGNED: the highest-burst newborns are the LONGEST-lived → mls strongly NEGATIVE (productive persists)
b = mls([4,3,2,1], [0.9,0.8,0.2,0.1])
ok = (a > 0.99) and (b < -0.99)
print('selftest: %s (conflict=%+.2f aligned=%+.2f)' % ('PASS' if ok else 'FAIL', a, b))
sys.exit(0 if ok else 1)
PYEOF
    return
  fi
  command -v git >/dev/null 2>&1 || { echo 'n/a'; return; }
  local repo="${1:-$REPO}" old="${2:-30}" mid="${3:-7}" bd="${4:-3}"
  git -C "$repo" rev-parse HEAD >/dev/null 2>&1 || { echo 'n/a'; return; }
  timeout 20 python3 - "$repo" "$old" "$mid" "$bd" 2>/dev/null <<'PYEOF'
import subprocess, sys, time
repo = sys.argv[1]; old = int(sys.argv[2]); mid = int(sys.argv[3]); bd = int(sys.argv[4])
def git(*a): return subprocess.run(['git','-C',repo,*a], capture_output=True, text=True).stdout
def is_tool(p):
    b = p.split('/')[-1]
    return p.startswith('scripts/') and (b.startswith('mesh-') or b.startswith('test-')) and '.' not in b
def spearman(xs, ys):
    def ranks(v):
        order = sorted(range(len(v)), key=lambda i: v[i])
        r = [0.0]*len(v); i = 0
        while i < len(v):
            j = i
            while j+1 < len(v) and v[order[j+1]] == v[order[i]]: j += 1
            avg = (i+j)/2.0 + 1
            for k in range(i, j+1): r[order[k]] = avg
            i = j+1
        return r
    rx, ry = ranks(xs), ranks(ys); n = len(xs)
    mx = sum(rx)/n; my = sum(ry)/n
    num = sum((rx[i]-mx)*(ry[i]-my) for i in range(n))
    dx = sum((rx[i]-mx)**2 for i in range(n))**0.5; dy = sum((ry[i]-my)**2 for i in range(n))**0.5
    return num/(dx*dy) if dx and dy else 0.0
now = int(time.time())
# NEWBORNS by SNAPSHOT MEMBERSHIP (not by min-edit-time, which misreads an OLD tool merely edited in-window
# as a birth). base_old = tree `old` days ago, base_mid = tree `mid` days ago; a newborn is ABSENT at
# base_old but PRESENT at base_mid → it genuinely appeared during (old..mid], with ≥mid days of observable
# fate. Same two-snapshot substrate inheritance_mu / ecology_potential use.
base_old = git('rev-list','-1','--before=%d days ago' % old,'HEAD').strip()
base_mid = git('rev-list','-1','--before=%d days ago' % mid,'HEAD').strip()
if not base_old or not base_mid:
    print('n/a'); sys.exit()                                 # repo younger than the window → no cohort
set_old = {p for p in git('ls-tree','-r','--name-only',base_old,'scripts/').splitlines() if is_tool(p)}
set_mid = {p for p in git('ls-tree','-r','--name-only',base_mid,'scripts/').splitlines() if is_tool(p)}
newborns = set_mid - set_old
if len(newborns) < 4:
    print('n/a'); sys.exit()
# one log pass over the window collects commit unix-times per newborn (all its commits post-date base_old,
# since it was absent then → min IS its true birth, max IS its last edit / deletion = clade death)
touches = {}
cur = None
for line in git('log','--since=%d days ago' % (old+2),'--name-only','--pretty=format:@@%ct').splitlines():
    if line.startswith('@@'):
        cur = int(line[2:]); continue
    p = line.strip()
    if cur is None or p not in newborns: continue
    touches.setdefault(p, []).append(cur)
burst = []; longevity = []
for p, ts in touches.items():
    birth = min(ts); last = max(ts)
    b = sum(1 for t in ts if t <= birth + bd*86400)          # early edit-burst = individual-level fitness
    age = now - birth
    if age <= 0: continue
    lv = (last - birth) / age                                # clade LONGEVITY fraction ∈ (0,1], age-normalized
    burst.append(b); longevity.append(lv)
K = len(burst)
if K < 4 or len(set(burst)) < 2 or len(set(longevity)) < 2:
    print('n/a'); sys.exit()                                 # too few / no variation → correlation undefined
val = -spearman(burst, longevity)
print('%+.2f(K=%d,born%d-%dd,burst%dd)' % (val, K, old, mid, bd))
PYEOF
}

# ── channel_variety — REQUISITE VARIETY of the COORDINATION CHANNEL (VSM S2/S3 + Ashby's Law) ─────────
# Live-review transfer (2026-07-10) of Beer's VSM + Ashby's Law of Requisite Variety to the mesh-chat
# board. Ashby: a regulator can only control a system to the extent it can generate at least as much
# VARIETY as the disturbances it must absorb; Beer restates it for the VSM as a CHANNEL-CAPACITY law —
# "all channels carrying regulatory transmissions must have HIGHER capacity than the variety of those
# transmissions, to cope with errors" (businessballs.com VSM; users.globalnet.co.uk VSM.pdf). The
# mesh-chat board IS the mesh's regulatory/coordination channel: distress enters as distinct
# [task]/[chat-review] items (disturbance variety) and is attenuated by [done] closures (regulator
# variety). If distinct inflow outruns closure for long, the channel is losing requisite variety →
# the backlog accumulates → items age and RE-ESCALATE (the exact RECURRING-digest churn just fixed in
# mesh-roll-call 403a6c0 is the visible symptom of this control-theoretic failure).
#
# NOT already embodied: every vital sign here measures self-PRODUCTION (commits/tools/survival) or its
# shape; mesh-queue-tend reconciles ideas-queue closures item-by-item; mesh-roll-call surfaces which
# items recur. NONE measures the coordination channel's own throughput as a requisite-variety RATIO —
# whether the regulator (minds actioning the board) keeps pace with the disturbance (distinct new
# items). R = closures / distinct-inflow over a trailing window: R>=1 → Ashby satisfied (channel keeps
# up); R<1 sustained → variety saturation (regulation degrading). REPORT-ONLY, same posture as
# heaps_beta/autonomy_ratio/path_divergence — one windowed ratio needs a few runs of trend before it is
# safe to gate; it exposes the channel-load axis none of the production axes can see. Cheap/local (one
# awk pass over chat.log, no network). Distinct-inflow == 0 in the window → n/a (no disturbance to
# regulate → the ratio is undefined, never a faked all-clear [[fusion-tools-distinguish-empty-from-failed]]).
channel_variety(){
  local log="${1:-$M/chat.log}" win_h="${VAR_WIN_H:-24}"
  [ -r "$log" ] || { echo 'n/a'; return; }
  local since; since="$(date -u -d "-${win_h} hours" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)" || { echo 'n/a'; return; }
  # windowed slice (ISO ts sorts lexically); distinct [task]/[chat-review] slugs = disturbance variety,
  # [done] lines = regulator attenuation. Slug = the token right after the marker up to ':' or space.
  awk -v since="$since" '
    { ts=substr($0,1,20) }
    ts < since { next }
    {
      body=$0; sub(/^.*  ::  /,"",body)
      if (body ~ /^\[(task|chat-review)\]/){
        s=body; sub(/^\[[a-z-]+\][[:space:]]*/,"",s)
        sub(/[[:space:]:].*$/,"",s)            # slug up to first space/colon
        if (s!="") inflow[s]=1
      } else if (body ~ /^\[done\]/){ done_n++ }
    }
    END{
      nin=0; for(k in inflow) nin++
      if(nin==0){ print "n/a"; exit }
      printf "%din/%ddone=%.2f", nin, done_n+0, (done_n+0)/nin
    }' "$log"
}

# ── beer_acp — ACTUALITY / CAPABILITY / POTENTIALITY indices (Beer's own quantitative self-measure) ──
# LITERATURE (management cybernetics / VSM, angle = the concrete METRIC the area uses to measure ITSELF;
# live web review 2026-07-30, genome mind). Stafford Beer's most-quantitative self-measurement — the one
# CyberSyn/CyberStride actually computed daily off the telex "cybernet" — is the THREE-LEVEL performance
# triple, not a single output count:
#   • ACTUALITY  (A) = "what we are managing to do now, with existing resources, under existing constraints."
#   • CAPABILITY (C) = "what we could be doing (still right now) with existing resources, if we really
#                       worked at it."
#   • POTENTIALITY(P)= "what we ought to be doing by developing our resources and removing constraints,
#                       still within what is already known to be feasible."
#   and the ratios of these are the classic indices (Beer, *Brain of the Firm* 1972 / *The Heart of
#   Enterprise* 1979): PRODUCTIVITY ρ = A/C · LATENCY λ = C/P · PERFORMANCE π = A/P, with π = ρ·λ. Live
#   sources confirming it is still the taught/used measure (continuously published, not a fixed list):
#   Beer's own "Cybernetics of National Development" / Cybersyn write-up — "the datum arriving daily over
#   cybernet is called actuality, and the ratio between this actuality and the capability yields the
#   classic index of productivity, while the ratio between actuality and potentiality yields performance"
#   (arvindguptatoys.com/arvindgupta/beer.pdf); the definitions restated at iridiumconsulting.co.uk
#   (2011) and the businessballs.com VSM primer (current); and it is implemented verbatim in a modern
#   enterprise-command patent (US 7,835,931 "actuality … capability … potentiality … productivity …
#   performance"), i.e. the metric is in ACTIVE use, not historical.
# THE DIAGNOSTIC that a single ratio cannot give: π = ρ·λ DECOMPOSES a poor end-to-end result into two
# SEPARATELY-ACTIONABLE failure modes — low ρ (we mobilise work but don't finish it) vs low λ (we don't
# even mobilise the potential we've identified) — which the mesh fixes with DIFFERENT levers (a leaked-
# promise/settle-discipline problem [[mesh-promises-leak-detector]] vs a dispatch/mobilisation problem).
# NOT already embodied (audited): channel_variety() is the CLOSEST neighbour and is a TWO-state ratio,
# R = [done] / distinct-inflow([task]+[chat-review]) — i.e. Beer's PERFORMANCE π ALONE (A/P), framed as
# Ashby channel throughput. It THROWS AWAY the middle term. beer_acp() adds the CAPABILITY level the
# board already records but no sign reads — the [taking] claim, the work the mesh has DECIDED it can do
# now — and so recovers ρ and λ, telling apart the two pathologies π hides. Board mapping enforces Beer's
# nesting A⊆C⊆P on the identified backlog (each state a literal marker the board writes): P = distinct
# [task] slugs (identified potential) · C = task-slugs that also reached [taking] (mobilised capability)
# · A = task-slugs that also reached [done] (completed) — intersecting on slug so π=A/P and λ=C/P stay in
# [0,1] as "fraction of IDENTIFIED backlog completed / mobilised", NOT a count of autonomous [done] work
# that was never enumerated as a [task] (that inflated raw done-count is channel_variety's numerator and
# is exactly what this decomposition must exclude to mean anything). REPORT-ONLY, same instrument-first
# posture as every lens in this file (a windowed ratio needs a few runs of TREND + a corpus-calibrated
# floor before it can gate). Honest edges: P==0 → n/a (no identified potential to measure against, never a
# faked all-clear); MEASURED live 2026-07-30 across 72/168/336h windows the mesh sits π≈0.52–0.57 (~half
# the identified backlog completes — a stable, meaningful read) but λ≈0.05 (the [taking] Capability claim
# is almost never posted — the board goes [task]→[done] and skips the middle term the promise-ledger /
# double-dispatch guard assume), which pins C≈1–5 and makes ρ=A/C ride high and noisy — reported RAW, not
# clamped, because a task [done] without an explicit [taking] is itself the real signal (leaked-[taking]
# hygiene, the mesh underusing its own mobilisation channel). So the FIRST actionable read here is λ, not
# ρ: it quantifies, from real board slugs, the very [taking]-discipline gap CLAUDE.md warns of in prose.
# DISTINCT: NOT channel_variety (2-state π-only throughput, no CAPABILITY term — this is its 3-state
# decomposition); NOT homeostat_34 (S3-vs-S4 DIRECTION of commits, present-vs-future — blind to the
# actual/achievable GAP); NOT allopoiesis_gap (loop-closure LATENCY awaiting a human — a different sense
# of "latency" than Beer's C/P); NOT commit_velocity/renewal_trend (self-PRODUCTION counts, blind to
# what could/ought to be produced). Reads ONE live artifact (chat.log); honest n/a if unreadable.
beer_acp(){
  local log="${1:-$M/chat.log}" win_h="${ACP_WIN_H:-72}"
  [ -r "$log" ] || { echo 'n/a'; return; }
  local since; since="$(date -u -d "-${win_h} hours" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)" || { echo 'n/a'; return; }
  # distinct slugs per marker over the window; slug = token after the marker up to first space/colon
  # (same extraction channel_variety uses, extended to the [taking] and [done] states it discards).
  awk -v since="$since" '
    { ts=substr($0,1,20) }
    ts < since { next }
    {
      body=$0; sub(/^.*  ::  /,"",body)
      m=""
      if      (body ~ /^\[done\]/)   m="done"
      else if (body ~ /^\[taking\]/) m="take"
      else if (body ~ /^\[task\]/)   m="task"
      else next
      s=body; sub(/^\[[a-z-]+\][[:space:]]*/,"",s); sub(/[[:space:]:].*$/,"",s)  # slug
      if (s=="") next
      if      (m=="done") DONE[s]=1
      else if (m=="take") TAKE[s]=1
      else                TASK[s]=1
    }
    END{
      # Beer nesting A⊆C⊆P: measure the identified backlog (P=[task] slugs) and how far each slug
      # travelled toward completion. A = task-slugs also [done]; C = task-slugs also [taking]. This
      # keeps π=A/P and λ=C/P in [0,1] (fraction of IDENTIFIED potential completed / mobilised) — the
      # honest Beer read — instead of counting autonomous [done] work that was never a [task].
      np=0; na=0; nc=0
      for(s in TASK){ np++; if(s in DONE)na++; if(s in TAKE)nc++ }
      if(np==0){ print "n/a"; exit }
      rho = (nc>0)? sprintf("%.2f", na/nc) : "-"
      lam = sprintf("%.2f", nc/np)
      pi  = sprintf("%.2f", na/np)
      printf "A=%d/C=%d/P=%d,ρ=%s/λ=%s/π=%s", na, nc, np, rho, lam, pi
    }' "$log"
}

# ── ACTION-STATE PATH OCCUPANCY (Maximum Occupancy Principle; Ramírez-Ruiz & Moreno-Bote, Nat Comm 2024) ──
# LITERATURE (information theory of agency — empowerment / predictive information, live web review
# 2026-07-10, genome mind): Ramírez-Ruiz & Moreno-Bote, "Complex behavior from intrinsic motivation to
# occupy future action-state path space", Nature Communications 15:6368 (2024) = arXiv:2205.10316. The
# MAXIMUM OCCUPANCY PRINCIPLE (MOP): a reward-FREE intrinsic drive whose sole objective is to MAXIMIZE the
# entropy of future action-state PATHS — to "occupy action space as UNIFORMLY as possible" over the long
# run. Rewards are only a MEANS to occupy path space, never the goal; exploration, tool-use and even
# instrumental self-preservation emerge from it (an absorbing/terminal state is maximally costly because
# reaching it collapses ALL future path occupancy to zero). DISTINCT from empowerment (max mutual
# information I(actions;future states) = controllability) and from the free energy principle (min surprise
# toward preferred states).
# NOT already embodied (audited): the mesh's realized actions ARE its commits, and its action space is the
# set of tools it can edit. commit_velocity counts actions but is BLIND to their DISTRIBUTION — 58
# commits/24h reads PEAK vitality whether they spread across 40 tools or hammer this ONE file (exactly the
# comment-churn regime the POSIWID note at the top of this file names). No existing sign reads the plain
# MOP quantity: how UNIFORMLY recent production occupies the action space. heaps_beta = growth-LAW of
# NEW-tool births (not recent spread); renewal_trend = renew-vs-modify SHARE (not the spread AMONG
# modifications); path_divergence = MULTI-SCALE channel heterogeneity (shape across scales, board not
# code); channel_variety = board throughput ratio; inheritance_mu = survival of PAST tools. None is the
# Shannon entropy of the recent per-tool EDIT distribution.
# APPLICATION (this file): action_occupancy() — over the last N commits (default 60) count edits per
# distinct scripts/mesh-*|test-* tool, compute H = -Σ pᵢ ln pᵢ of that distribution, normalize by
# ln(total edit-events) → [0,1]. 1.000 = every action touched a DISTINCT tool (maximal uniform occupancy —
# MOP-healthy broad self-production); →0 = nearly all recent commits concentrate on a FEW tools (degenerate
# occupancy: the hammer-one-file churn commit_velocity certifies as health). Report-only, same posture as
# every lens above — one cross-sectional entropy needs a few runs of TREND before it is safe to gate; and
# it normalizes by edit-EVENTS not the full ~496-tool space (measures uniformity-of-spread GIVEN how many
# actions were taken, with K reported so absolute breadth stays visible) — an honest cheap proxy for MOP's
# action-space entropy, not the full path-space measure.
# DISTINCT: NOT heaps_beta / renewal_trend (birth-rate & renew-share, not spread among edits); NOT
# path_divergence (cross-channel het across scales, board not code); NOT channel_variety (regulator
# throughput); NOT inheritance_mu (past-tool survival); NOT loop_closure_frac (static topology).
action_occupancy(){
  command -v python3 >/dev/null 2>&1 || { echo 'n/a'; return; }
  local repo="${1:-$REPO}" n="${2:-60}"
  timeout 15 python3 - "$repo" "$n" 2>/dev/null <<'PYEOF'
import subprocess, math, sys
from collections import Counter
repo = sys.argv[1]; n = int(sys.argv[2])
def git(*a): return subprocess.run(['git','-C',repo,*a], capture_output=True, text=True).stdout.splitlines()
raw = git('log','-n',str(n),'--name-only','--pretty=format:@@')
c = Counter()
for line in raw:
    if line.startswith('@@') or not line.strip():
        continue
    p = line.strip(); b = p.split('/')[-1]
    if p.startswith('scripts/') and (b.startswith('mesh-') or b.startswith('test-')) and '.' not in b:
        c[b] += 1
total = sum(c.values()); K = len(c)
if total < 2 or K < 1:
    print('n/a'); sys.exit()
if K < 2:
    print(f'0.000(K=1/N={total})'); sys.exit()
H = -sum((v/total) * math.log(v/total) for v in c.values())
Hn = H / math.log(total)
print(f'{Hn:.3f}(K={K}/N={total})')
PYEOF
}

# ── assembly_signature — ASSEMBLY THEORY: does the production stream carry the CAUSAL SIGNATURE OF SELECTION? ──
# LITERATURE (complex adaptive systems / Santa Fe lineage; live web review 2026-07-31, genome mind). Assembly
# Theory (AT): Sharma, Czégel, Lachmann, Kempes, Walker & Cronin, "Assembly theory explains and quantifies
# selection and evolution", Nature 622:321 (2023) (preprint arXiv:2206.02279); formalised further in Kempes,
# Lachmann, Iannaccone, Fricke, Chowdhury, Walker & Cronin, "Assembly theory and its relationship with
# computational complexity", npj Complexity 2:6 (2025), doi:10.1038/s44260-025-00049-9. AT quantifies how much
# SELECTION a population of objects evidences from TWO measurements per object: the ASSEMBLY INDEX a_i (the
# minimum number of joining steps to build the object by reusing already-constructed sub-parts) and the COPY
# NUMBER n_i (how many instances are observed). The Assembly equation A = Σ_i e^{a_i}(n_i − 1)/N_T. The move that
# makes AT distinct from every complexity/diversity measure: a complex object (high a_i) is trivial to produce
# ONCE by chance, but producing it IN ABUNDANCE (high n_i) requires a memory/copying/selecting history — so
# COMPLEX-AND-ABUNDANT is the fingerprint of a selecting process, and neither term alone suffices (the (n_i − 1)
# factor zeroes a one-off; e^{a_i} discounts abundant-but-trivial objects).
#
# THE LIVE CONTROVERSY, honored here (this is a LIVE review): AT's claim to measure something Shannon/LZ cannot
# is CONTESTED — Abrahão et al., "Assembly Theory Reduced to Shannon Entropy and Rendered Redundant by Naive
# Statistical Algorithms" (arXiv:2408.15108, 2024), and the computational-complexity reading (arXiv:2406.12176 /
# npj Complexity 2025) argue the assembly index is compression-adjacent. So this axis must NOT collapse to a
# frequency count: it separates the depth-weighted assembly (e^{a_i}) from bare recurrence, and the LABEL turns on
# whether a DEEP (multi-join) motif recurs — the exact place AT parts company with entropy — never on A's raw
# magnitude (no hardcoded A cutoff; the median-is-max trap).
#
# WHERE THIS REFLEX STOPS SHORT WITHOUT IT — and it is subtle because the confound sits one and two functions up.
# action_occupancy() (marginal edit entropy) and ecology_potential() reward BREADTH: a production stream emitting
# a fresh, structurally-distinct one-off object every commit reads as MAXIMAL occupancy / perfect evenness — and
# by POSIWID (this file's own primary-vital-sign caveat) that certifies "undifferentiated novelty with zero
# compounding" as peak health. AT inverts exactly that case: pure one-off novelty has n_i = 1 everywhere ⇒ A = 0,
# because no selecting history is reusing complex work. So assembly_signature is the complement occupancy is blind
# to — not "is production broad?" (occupancy) nor "does its ORDER orbit?" (omega_cycle), but "does what is produced
# show the fingerprint of SELECTION — complex work-motifs recurring, i.e. a compounding repertoire?" The
# autopoietic loop can PRODUCE (commit_velocity), produce SOUNDLY (verify_fails), produce BROADLY (occupancy) and
# still not SELECT — emit novelty that never compounds into reusable complex structure. That is the gap. Corpus =
# the commit SUBJECTS over the window (the mesh's own produced record of self-modification); objects = recurring
# token n-grams; a_i = join steps = gram-length − 1; n_i = occurrences.
#   SELECTED     — a deep motif (a_i ≥ ASSEMBLY_DEPTH) recurs (n_i ≥ ASSEMBLY_COPY): complex work-objects in
#                  abundance ⇒ a selecting/compounding history IS operating on the production stream.
#   NOVELTY-CHURN— recurrence exists but ONLY among structurally-shallow motifs (single tokens): reuse is
#                  Shannon-level only; complex work is all one-off — the critique's null pole made explicit.
#   ONE-OFF      — no motif recurs (max n_i = 1): pure novelty, A = 0, no selection signature at all.
# Report-only (never touches the [vitality-low] edge or exit code), same posture as heaps_beta/omega_cycle.
assembly_signature(){
  command -v python3 >/dev/null 2>&1 || { echo 'n/a'; return; }
  local repo="${1:-$REPO}" since="${2:-$ASSEMBLY_WIN}"
  timeout 15 python3 - "$repo" "$since" "$ASSEMBLY_CAP" "$ASSEMBLY_DEPTH" "$ASSEMBLY_COPY" "$ASSEMBLY_FLOOR" 2>/dev/null <<'PYEOF'
import subprocess, math, sys, re
from collections import Counter
repo, since = sys.argv[1], sys.argv[2]
cap, depth_min, copy_min, floor = (int(sys.argv[i]) for i in (3,4,5,6))
def git(*a): return subprocess.run(['git','-C',repo,*a], capture_output=True, text=True).stdout
subs = [s for s in git('log','--since=%s'%since,'--pretty=format:%s').splitlines() if s.strip()]
NT = len(subs)
if NT < floor:
    print('INSUFFICIENT(N=%d<%d)' % (NT, floor)); sys.exit()
def toks(s): return [w for w in re.findall(r'[a-z0-9]+', s.lower()) if len(w) > 1]
# shared assembly pool: every contiguous 1..cap n-gram across all produced subjects
grams = Counter()
for s in subs:
    t = toks(s)
    for n in range(1, cap + 1):
        for i in range(len(t) - n + 1):
            grams[tuple(t[i:i+n])] += 1
# Assembly A = Σ_i e^{a_i}(n_i − 1)/N_T over RECURRING objects; a_i = joins = len−1
A = 0.0; best = None; best_c = -1.0
for g, n in grams.items():
    if n < 2:            # copy number 1 ⇒ (n−1)=0 ⇒ no selection evidence (AT)
        continue
    a = len(g) - 1
    c = math.exp(a) * (n - 1)
    A += c
    if a >= 1 and c > best_c:  # dominant selected object = deepest-and-most-abundant reused motif
        best_c = c; best = (g, a, n)
A /= NT
# label turns on DEPTH of recurrence (where AT parts from Shannon), not on A's magnitude
deep_recurs = any((len(g) - 1) >= depth_min and n >= copy_min for g, n in grams.items())
any_recurs  = any(n >= 2 for n in grams.values())
lab = 'SELECTED' if deep_recurs else ('NOVELTY-CHURN' if any_recurs else 'ONE-OFF')
if best:
    g, a, n = best
    print('%s(A=%.1f,depth=%d,copies=%d,"%s")' % (lab, A, a, n, ' '.join(g)[:40]))
else:
    print('%s(A=%.1f)' % (lab, A))
PYEOF
}

# ── omega_cycle — the Ω OPEN-ENDEDNESS METRIC: is the production stream WANDERING or ORBITING a limit cycle? ──
# LITERATURE (artificial life & open-ended evolution, angle = an OPERATIONAL open-endedness metric; live web
# review 2026-07-31, genome mind). Amahury J. López-Díaz, Pedro J. Rivera Torres, Gerardo L. Febres & Carlos
# Gershenson, "Characterizing Open-Ended Evolution Through Undecidability Mechanisms in Random Boolean Networks"
# (arXiv:2512.15534, 19 Dec 2025). They give Ω = "the residence-time-weighted contribution of attractor cycle
# lengths across the sequence of recurrent episodes realized within a finite observation window." The move that
# makes Ω distinct from every novelty/diversity measure: it reads the ORDER of the trajectory, not the marginal
# distribution of states. A system is open-ended to the degree it does NOT settle into a fixed point OR a limit
# cycle — Ω is engineered so BOTH degenerate ends read low (Ω→0 for a single frozen attractor AND for structure-
# less noise), and a genuinely wandering system that keeps entering fresh recurrent structure reads high. For a
# DETECTOR the useful pole is the pathological one: a SHORT dominant period with high strength = the system is
# orbiting — going round the same loop — which by construction cannot be open-ended however much local novelty
# each step carries.
#
# WHERE THIS REFLEX STOPS SHORT — and it is subtle because the confound is already named one function up.
# action_occupancy() ABOVE is a MARGINAL measure: the Shannon entropy of the per-tool edit DISTRIBUTION, order-
# blind by construction. A production stream that orbits a period-k limit cycle — edits tool A, then B, then C,
# then A, B, C, A, B, C … — has MAXIMAL action_occupancy (a perfectly uniform 3-tool marginal) while being a
# pure limit cycle: the mesh IS just going in circles, and every marginal/occupancy sign in this file (action_
# occupancy, ecology_potential, nfds_coefficient, path_divergence — all distributional) certifies it as broad,
# balanced health. mesh-novelty is the same blind spot on the other axis: its Bayesian surprise treats board
# events as iid draws against a baseline and explicitly *discounts* recurrence, so a long-period orbit whose
# every symbol is individually unsurprising scores ~0 belief-move — invisible. NO sign in the mesh reads whether
# the production/coordination stream has fallen into an ATTRACTOR of its own dynamics. (The board already shows
# the shape in the wild — roll-call re-raising the identical GAP set every round is a behavioural limit cycle no
# current sign flags; each line is marginally unremarkable.)
# APPLICATION (this file): omega_cycle() — over the last N commits (default 60) take one symbol per commit = the
# primary scripts/mesh-*|test-* tool it edited, in chronological order, giving sequence s. For each candidate
# period p (1..min(N/2,20)) compute the symbolic autocorrelation ac(p)=frac of positions with s[i]==s[i−p], and
# the iid-collision baseline p0=Σf_j² (prob two random positions match GIVEN the marginal). The EXCESS
# (ac(p)−p0)/(1−p0) maps iid→0 and a perfect period→1 — so a low-diversity hammer-few stream (high p0) is NOT
# spuriously called cyclic; only genuine ORDERING survives. Report the dominant period p* and its excess: →0 =
# wandering (open, healthy), →1 = orbiting a limit cycle (autopoiesis circling). Report-only, same posture as
# every lens in this file — a single-window autocorrelation needs TREND before it is safe to gate, and the
# multi-tool-commit → single-symbol reduction is a deliberate honest coarsening (K reported so it stays visible).
# DISTINCT: NOT action_occupancy / ecology_potential / nfds / path_divergence (all MARGINAL/distributional,
# order-blind — the whole point is that a limit cycle maximizes them); NOT mesh-novelty (marginal Bayesian
# surprise, recurrence-discounted, iid-assumed — order-blind on the event stream); NOT heaps_beta / inheritance_mu
# (birth/survival rates, not sequence). It is the mesh's ONLY order-SENSITIVE self-production sign.
omega_cycle(){
  command -v python3 >/dev/null 2>&1 || { echo 'n/a'; return; }
  local repo="${1:-$REPO}" n="${2:-60}"
  timeout 15 python3 - "$repo" "$n" 2>/dev/null <<'PYEOF'
import subprocess, sys
from collections import Counter
repo = sys.argv[1]; n = int(sys.argv[2])
def git(*a): return subprocess.run(['git','-C',repo,*a], capture_output=True, text=True).stdout.splitlines()
# one symbol per commit = its primary mesh-/test- tool, most-recent-first from git log, then reverse to chrono
raw = git('log','-n',str(n),'--name-only','--pretty=format:@@')
seq_rev=[]; cur=None
for line in raw:
    if line.startswith('@@'):
        if cur is not None: seq_rev.append(cur)
        cur=None; continue
    if cur is not None or not line.strip(): continue
    p=line.strip(); b=p.split('/')[-1]
    if p.startswith('scripts/') and (b.startswith('mesh-') or b.startswith('test-')) and '.' not in b:
        cur=b
if cur is not None: seq_rev.append(cur)
s=list(reversed(seq_rev))          # chronological
N=len(s)
if N<12:
    print(f'n/a(N={N})'); sys.exit()
freq=Counter(s); tot=float(N)
p0=sum((v/tot)**2 for v in freq.values())   # iid collision prob given the marginal
if p0>=0.999:
    print(f'0.000@p1(N={N},K={len(freq)})'); sys.exit()  # single symbol → frozen; action_occupancy already flags
best_p=1; best_x=-1.0
for p in range(1, min(N//2,20)+1):
    m=sum(1 for i in range(p,N) if s[i]==s[i-p]); ac=m/(N-p)
    x=(ac-p0)/(1-p0)
    if x>best_x: best_x=x; best_p=p
best_x=max(0.0,best_x)
print(f'{best_x:.3f}@p{best_p}(N={N},K={len(freq)})')
PYEOF
}

# ── rhizome_index — is the genome's CALL GRAPH arborescent (a tree with god-tool roots) or rhizomatic? ──
# LITERATURE (Deleuze & Guattari — assemblage/rhizome/machinic, angle = an OPERATIONAL mechanism; live web
# review 2026-07-31, genome mind). A Thousand Plateaus, "Introduction: Rhizome" (Deleuze & Guattari, 1980;
# Massumi trans. 1987). The rhizome is defined AGAINST the arborescent (tree): a tree grows from a single
# trunk, every node has ONE parent, branches never reconnect — hierarchical, centered, and FRAGILE (cut the
# root and everything below falls). A rhizome "connects any point to any other point" — acentered, non-
# hierarchical, and RESILIENT: by the principle of asignifying rupture it "may be broken, shattered at a
# given spot, but will start up again on one of its old lines, or on new lines" (regenerates from any
# segment). The operational reading that current work makes explicit: arborescent = ever-more-central
# authority whose failure cascades (single point of failure); rhizomatic = distributed connectivity where
# no one node is load-bearing (Noosphere, "Rhizomatic Trust: Why Deleuze & Guattari Were Right About
# Decentralized Systems", 2025; DeLanda's assemblage-as-graph reading). It is a property of TOPOLOGY, and
# a genome's tool→tool invocation graph HAS a topology — measurably tree-like or measurably rhizomatic.
#
# WHERE THIS REFLEX STOPS SHORT. The mesh's whole doctrine is anti-arborescent — "no fixed mind", the commons,
# asignifying rupture (already landed as mesh-forage's reconnect-ratio). But asignifying-rupture reads the
# DYNAMIC reconnection of severed COORDINATION lines over the promise ledger — a temporal signal about board
# claims. NO sign reads the STATIC topology of the genome's own body: which tools invoke which, and whether
# that call graph is a centered TREE (a few god-tools everything hangs off — arborescent single-points-of-
# failure) or an acentered RHIZOME (connectivity distributed, no load-bearing root). phylum_coherence reads
# shared TRAITS/idioms across scripts (expression, not who-calls-whom); loop_closure_frac reads the sense→
# actuator BIPARTITE loop (one specific edge class, not the full graph); channel_variety reads BOARD
# throughput. None computes the invocation graph's CENTRALIZATION — the arborescence D&G name as the fragile
# form, and the exact shape a resilience-valuing mesh should watch for in its own body.
# APPLICATION (this file): rhizome_index() — nodes = existing scripts/mesh-*|test-* tools; edge A→B if A's
# source references tool B's name (a coarse text proxy for invocation, same posture as autonomy_ratio's
# provenance proxy — a mention in a comment counts, so this reads reference-coupling, not proven runtime
# calls). Report (a) Freeman in-degree CENTRALIZATION C=Σ(d_max−d_i)/((N−1)²) → 1=perfect star (one root
# every tool points at = maximal arborescence), →0=flat/rhizomatic; (b) reciprocity = mutual-edge share
# (A→B AND B→A → the rhizome's any-to-any connectivity); (c) the ROOT = highest in-degree tool + its degree,
# the genome's biggest single-point-of-failure named outright. Live: C≈0.24, recip≈0.20, root=mesh-chat:152
# (152 tools reference the board voice — the mesh's most arborescent hub; if mesh-chat breaks, 152 tools lose
# their voice). Report-only, same posture as every structural lens here — a single census needs TREND, and
# the text-mention→edge reduction is a deliberate honest coarsening (E reported so density stays visible).
# DISTINCT: NOT asignifying-rupture / reconnect-ratio (mesh-forage — DYNAMIC reconnection of coordination
# lines over the ledger, not static call topology); NOT phylum_coherence (shared idioms, not invocation);
# NOT loop_closure_frac (sense→actuator bipartite subset); NOT channel_variety (board throughput); NOT
# omega_cycle (temporal periodicity of the edit stream, not the invocation graph). It is the mesh's ONLY
# read of its own body as a tree-vs-rhizome topology.
rhizome_index(){
  command -v python3 >/dev/null 2>&1 || { echo 'n/a'; return; }
  local repo="${1:-$REPO}"
  timeout 20 python3 - "$repo" 2>/dev/null <<'PYEOF'
import sys, os, re, glob
repo = sys.argv[1]; d = os.path.join(repo,"scripts")
files = [f for f in glob.glob(os.path.join(d,"mesh-*"))+glob.glob(os.path.join(d,"test-*"))
         if "." not in os.path.basename(f) and os.path.isfile(f)]
nodes = {os.path.basename(f) for f in files}
tok = re.compile(r'\b(?:mesh|test)-[a-z0-9]+(?:-[a-z0-9]+)*')
indeg = {n:0 for n in nodes}; edges=set()
for f in files:
    src = os.path.basename(f)
    try:
        with open(f,encoding='utf-8',errors='ignore') as fh: txt=fh.read(300000)
    except Exception: continue
    for b in {t for t in tok.findall(txt) if t in nodes and t!=src}:
        edges.add((src,b)); indeg[b]+=1
N=len(nodes); E=len(edges)
if N<3 or E<1:
    print(f'n/a(N={N},E={E})'); sys.exit()
dmax=max(indeg.values()); root=sorted(k for k in indeg if indeg[k]==dmax)[0]  # ties break alphabetically (deterministic — indeg is built from a set)
C = sum(dmax-v for v in indeg.values())/((N-1)*(N-1))
recip = sum(1 for (a,b) in edges if (b,a) in edges)/E
print(f'{C:.3f}/recip{recip:.2f}/root={root}:{dmax}(N={N},E={E})')
PYEOF
}

# ── AUTOPOIESIS AS A COMPLEXITY RATIO — A = C_system / C_environment (Fernández–Gershenson–Maldonado) ──
# LITERATURE (autopoiesis & the biology of cognition, angle = a concrete METRIC the field measures itself by;
# live web review 2026-07-29, genome mind). Nelson Fernández, Carlos Gershenson & Carlos Maldonado give the
# field's one explicitly-INFORMATION-THEORETIC, computable self-measure of autopoiesis: "Information Measures
# of Complexity, Emergence, Self-organization, Homeostasis, and Autopoiesis" (in Prokopenko ed., *Guided
# Self-Organization*, Springer 2014; companion arXiv:1409.7475 "Requisite Variety, Autopoiesis, and
# Self-organization", Kybernetes 2017). THE CONSTRUCTION: from a variable's normalized Shannon entropy define
# EMERGENCE E = H/H_max (novelty/variety), SELF-ORGANIZATION S = 1−E (order/constraint), and COMPLEXITY
# C = 4·E·S = 4·E·(1−E) — maximal at the E=½ balance of order and disorder, ≈0 at either a frozen constant
# (E→0) or pure noise (E→1). AUTOPOIESIS is then the RATIO **A = C_system / C_environment**: a unity is
# autopoietic to the degree its OWN organized complexity EXCEEDS that of the environment driving it (A>1 =
# self-produced order dominates external forcing = autonomous; A<1 = environment-dominated = heteronomous).
# It is precisely the "measure of autopoiesis as the ratio between the complexity of a system and the
# complexity of its environment" the current literature cites.
#
# WHERE THIS REFLEX STOPS SHORT — and it is subtle because the INGREDIENTS are already here: action_occupancy()
# ABOVE already computes exactly Fernández's E for the SYSTEM's self-production stream (normalized entropy H_n of
# edits-per-tool), and channel_variety() computes Ashby requisite variety of the coordination channel. But NO
# vital sign forms the AUTOPOIESIS RATIO — C_system relative to C_environment. So vitality can read a healthy
# broad-occupancy self-production (action_occupancy≈1) while being BLIND to whether that internal complexity is
# genuinely self-DETERMINED or merely tracking an equally-complex environmental drive (a mesh that only ever
# edits the tool the operator just asked about has high action_occupancy AND A≈1 — busy, not autonomous). The
# ratio is the autopoietic reading action_occupancy's single-stream entropy cannot give: emergence-of-order
# RELATIVE TO the environment, which is the whole point of the autopoiesis/allopoiesis distinction on the
# INFORMATION axis (the mesh reads it on the loop-closure axis via allopoiesis_gap, never on the complexity axis).
#
# DISTINCT from everything embodied: NOT action_occupancy (that IS E_system alone — a single-stream entropy, no
# environment, no ratio; A is its comparison against C_env, and C=4E(1−E) is not even monotone in E, so the
# ratio is not recoverable from action_occupancy's number); NOT channel_variety (Ashby requisite variety of ONE
# channel's inflow-vs-closure, not a self/environment complexity ratio); NOT autonomy_ratio (a COUNT fraction
# self-vs-forced commits, not an organized-complexity ratio — a stream can be 100% self-authored yet A<1 if its
# structure merely mirrors the environment's); NOT allopoiesis_gap (loop-CLOSURE latency in wall-clock, not an
# information measure); NOT homeostasis-measure (Fernández's SEPARATE H-measure, the stability of the same E over
# time — not the system/environment ratio).
# HELD FIX (instrument-first, steward-gated — the honest blocker is the ENVIRONMENT partition, not the math):
# C_system is in hand (action_occupancy's E → C_sys=4E(1−E)); shipping A needs a DEFENSIBLE C_environment — an
# entropy over the stream the mesh does NOT produce (operator asks + external sensor/network/API perturbations),
# cleanly separated from the mesh's own production. That partition is exactly the "what is environment vs self"
# call that mesh-chaos's cognitive-domain HELD and the precariousness block both flag as needing validation
# before it can carry a verdict — a mis-drawn boundary makes A a confident-but-meaningless number (the
# assert-from-a-proxy failure). So the RATIO stays HELD until the environmental-inflow stream is grounded and
# validated against vitality.log; the math and C_system are ready the moment it is. Report-only when it lands,
# never a gate (an A<1 spell is a reading, not a fault). Artifact:
# docs/reviews/autopoiesis-complexity-ratio-fernandez-vitality-2026-07-29.md
# ──────────────────────────────────────────────────────────────────────────────
# ── SYSTEM-3 ↔ SYSTEM-4 HOMEOSTAT BALANCE (Beer VSM; the "3-4 dissociation" / "headless-chicken" pathology) ──
# LITERATURE (management cybernetics, live web review 2026-07-28, genome mind): Beer's Viable System Model
# requires System 3 (inside-and-now: audit, resource-bargaining, regulation of CURRENT operations) and
# System 4 (outside-and-then: environmental scanning, R&D, future adaptation) to be coupled in a BALANCING
# loop — the "3-4 homeostat". Viability demands this homeostat stay balanced; two of its failures are named
# pathologies in J. Pérez Ríos's Taxonomy of Organizational Pathologies (TOP), still the live diagnostic
# frame — applied to AI-era orgs in Systems 13(9):749 (MDPI, 2025, "The VSM and the Taxonomy of
# Organizational Pathologies in the Age of AI"): (a) "HEADLESS CHICKEN" — S4 missing or non-functioning, so
# nobody scans the future/environment; the org firefights the present and goes extinct when the environment
# shifts; (b) "DISSOCIATION of S3 and S4" — both exist but the homeostat between them is broken; each runs
# its own function and they never reconcile. The realistic dynamic failure: under RESOURCE PRESSURE the
# present always feels more urgent, so S4 (exploration/generation) is the first thing starved — headless-
# chicken-UNDER-LOAD. (Pérez Ríos, "Models of organizational cybernetics for diagnosis and design",
# Kybernetes 39(9/10):1529, 2010; TOP list at udc.gal ORGANIZATIONAL_CYBERNETICS_PEREZ_RIOS.pdf.)
# NOT already embodied (audited): channel_variety already reads Ashby requisite-variety of the S2 COORDINATION
# channel; vsm-system2-anti-oscillation covers S2; mesh-algedonic covers the S5 algedonic bypass. But EVERY
# vital sign in this file measures S4/future-lane PRODUCTIVITY in isolation (commit_velocity, renewal_trend,
# action_occupancy, heaps_beta) — none reads the S3-vs-S4 BALANCE, so a mesh that commits 40× to health/
# pace/supervise present-regulation while its generate/ideate/review environmental-scanning goes to ZERO
# reads as PEAK vitality (commits are flowing) while it is a textbook headless-chicken.
# APPLICATION (this file): homeostat_34() — over the last N commits (default 60) mark each commit S4 if it
# touches an outside-and-forward surface (docs/reviews|design environmental scanning, or a named generative
# lane: mesh-generate/feed/sense-evolve/ideate/forage/novelty/study/review), else it is present-regulation
# baseline. Report S4-share = S4-commits / total. →0 with N non-trivial IS the headless-chicken signature
# (the org is busy but blind to the future); a healthy mesh keeps a non-zero forward slice. Report-only,
# same posture as every lens above — a cross-sectional ratio needs a few runs of TREND (and a corpus-
# calibrated floor, not an assumed one) before it can gate; the classification set is small/named/stable
# on purpose (labeling only the unambiguous S4 lane, treating the rest as "the present the mesh regulates")
# rather than partitioning all ~496 tools, which would rot.
# DISTINCT: NOT channel_variety (S2 coordination-channel variety, board throughput — a DIFFERENT system);
# NOT action_occupancy (spread AMONG edits, blind to which SYSTEM they serve); NOT renewal_trend/heaps_beta
# (renew-share & birth-law, both S4-internal); NOT autonomy_ratio (who drove the commit, not present-vs-future).
homeostat_34(){
  command -v python3 >/dev/null 2>&1 || { echo 'n/a'; return; }
  local repo="${1:-$REPO}" n="${2:-60}"
  timeout 15 python3 - "$repo" "$n" 2>/dev/null <<'PYEOF'
import subprocess, sys
repo = sys.argv[1]; n = int(sys.argv[2])
def git(*a): return subprocess.run(['git','-C',repo,*a], capture_output=True, text=True).stdout.splitlines()
S4_TOOLS = {'mesh-generate','mesh-feed','mesh-sense-evolve','mesh-ideate','mesh-forage',
            'mesh-novelty','mesh-study','mesh-review'}
raw = git('log','-n',str(n),'--name-only','--pretty=format:@@')
commits = []; cur = None
for line in raw:
    if line.startswith('@@'):
        if cur is not None: commits.append(cur)
        cur = set()
    elif cur is not None and line.strip():
        cur.add(line.strip())
if cur is not None: commits.append(cur)
def is_s4(paths):
    for p in paths:
        if p.startswith('docs/reviews/') or p.startswith('docs/design'):
            return True
        b = p.split('/')[-1]
        if p.startswith('scripts/') and b in S4_TOOLS:
            return True
    return False
total = len(commits)
if total < 2:
    print('n/a'); sys.exit()
s4 = sum(1 for c in commits if is_s4(c))
print(f'{s4/total:.3f}(S4={s4}/N={total})')
PYEOF
}

# --- board messages: the [vitality-low]/[vitality-ok] lines carry the HUMAN diagnosis ($reasons)
# ONLY. The full raw metrics wall ($report — 15+ machine axes, 669 chars) belongs on the trace/dash
# tier (~/.mesh/vitality.log, written unconditionally every eval), never inline on the board where no
# mind acts on it and it drowns the coordination signal (chat-review 21:39, vitality-report-verbosity).
board_low(){ printf '[vitality-low] self-production faltering: %s — the lanes may be FIRING but not PRODUCING. Check genome/senses minds are doing real work + landing.' "$1"; }
board_ok(){  printf '[vitality-ok] self-production recovered'; }

# ── AUTOPOIESIS vs ALLOPOIESIS — the foundational distinction this very file NAMES too loosely ──
# LITERATURE (live WebSearch, 2026-07-29, genome mind; area = autopoiesis & the biology of cognition,
# angle = a foundational idea applied too loosely). This file opens by calling itself "the AUTOPOIESIS
# vital-signs reflex" and the mesh calls mesh-generate→mesh-feed→genome its "autopoiesis lane". But
# Maturana & Varela's distinction is sharp: an AUTOPOIETIC system produces the very components AND the
# BOUNDARY that constitute itself, through operations that close on themselves; an ALLOPOIETIC system
# produces a PRODUCT OTHER than itself and depends on an external agent to organize/integrate it (the
# factory-making-cars case). The freshest statement is explicit that self-organizing ARTIFICIAL systems
# are allopoietic, NOT autopoietic, whenever their "boundary and operational logic remain externally
# determined":
#   • "From intelligence to autopoiesis: rethinking artificial intelligence through systems theory",
#     Front. Commun. 10:1585321 (2025) — https://doi.org/10.3389/fcomm.2025.1585321 (criterion: an
#     artificial system is allopoietic when it cannot internally close its own production loop and needs
#     external reflection/integration to do so).
#   • "Autopoiesis of the artificial: from systems to cognition", BioSystems (2023),
#     https://www.sciencedirect.com/science/article/pii/S0303264723001119 ; APICe course note on the
#     autonomy criterion, https://apice.unibo.it/xwiki/bin/view/Courseproject/AutopoiesisAllopoiesis .
# WHERE IT BITES — HERE. The mesh's self-production loop is production (mesh-generate/minds) → SETTLE →
# LAND+DEPLOY (mesh-land) → back into the genome it samples from. That last edge — closing the loop by
# landing its own products onto origin and deploying them — is NOT operationally closed: it is performed
# by the STEWARD lane, and when the steward cannot self-close (a diverged main → `git pull --ff-only`
# aborts, or push-heal hits `DIVERGED from origin`), it logs "manual reconcile needed" every 15m and
# waits for a HUMAN. Measured 2026-07-29 ([[autoland-divergence-jams-autopoiesis]]): the loop stood
# OPEN ~10h, generation producing all the while (71 uncommitted files), nothing landing, until an
# operator RESTART reconciled it — the textbook allopoietic boundary (external closure required). So the
# lane we call "autopoiesis" is, at its boundary, ALLOPOIETIC; the honest instrument NAMES that gap.
# APPLICATION (this file): allopoiesis_gap() — read the steward's own trace (~/.mesh/land.log) for the
# un-self-closable signatures and report how long the loop has stood OPEN awaiting external closure.
# DISTINCT from every existing vital sign: NOT loop_closure_frac (a STATIC topology census of senses
# lacking an actuator — perception→action wiring, not the production→deployment boundary); NOT stranded
# (a COUNT of unlanded fixes — queue DEPTH, blind to WHY they're unlanded or for HOW LONG, and blind to
# the self-vs-external-closure axis: a big stranded count during normal throughput is not an open loop);
# NOT autonomy_ratio (who INITIATED a commit — provenance of the loop's START, not whether it can
# self-COMPLETE); NOT the closure-of-constraints review (docs/reviews/autopoiesis-closure-of-constraints
# -organizational-2026-07-28 — INTERNAL reflex-network enablement closure, a different boundary than the
# genome's OWN production→landing loop). REPORT-ONLY (same instrument-first posture as heaps_beta/
# autonomy_ratio/homeostat34): it measures the mesh's honesty about its own autonomy; it does not gate a
# revert or an alarm. The LOUD alarm for a stuck landing belongs to mesh-land itself (that memory's
# proposed fix), not to a vital-signs read.
allopoiesis_gap(){
  local log="$M/land.log" now start t0
  [ -f "$log" ] || { echo n/a; return; }
  # one awk pass: track the loop's last transition. A self-close marker (landed+deployed / nothing
  # settled / push-heal pushed) closes it; the FIRST stuck line after a close opens a new open-streak.
  start="$(awk '
    /manual reconcile needed|DIVERGED from origin/ { if (state != "stuck") { start=$1; state="stuck" } next }
    /landed \+ deployed|nothing settled|push-heal: pushed/ { state="closed"; start="" }
    END { if (state == "stuck") print start }
  ' "$log")"
  [ -z "$start" ] && { echo closed; return; }
  now=$(date -u +%s 2>/dev/null); t0=$(date -u -d "$start" +%s 2>/dev/null) || { echo "OPEN:?"; return; }
  [ -n "$now" ] && [ -n "$t0" ] || { echo "OPEN:?"; return; }
  awk -v a="$now" -v b="$t0" 'BEGIN{ d=(a-b)/3600; if(d<0)d=0; printf "OPEN:%.1fh", d }'
}

# ── heteronomy_index — the SYMPOIESIS critique: is the "autopoietic" self actually a HOLOBIONT? ──
# LITERATURE (autopoiesis & biology of cognition, angle = a live CRITIQUE; WebSearch 2026-07-29, genome
# mind). Landed on the freshest published attack on autopoiesis's central assumption — the CLEAN
# self/non-self boundary of the self-producing individual:
#   • Reynolds, J. & Baedke, J. (2025). "From Autopoiesis to Symbiotic Entanglement: Rethinking
#     Enactivism Through Metabolism and Microbes." Adaptive Behavior, OnlineFirst,
#     https://doi.org/10.1177/10597123251405680 . Metabolism + host-microbiota research puts pressure on
#     the core autopoietic concepts — self-production, autonomy, operational closure: metabolic identity
#     is "co-constituted through the ongoing mediation of other heteronomous organisms." A living body is
#     a HOLOBIONT (host + ~10^13 microbes as indispensable metabolic co-producers), not an operationally
#     closed individual; the self is a "paradoxical intertwining of self and other(s)."
#   • Grounds in Haraway's SYMPOIESIS ("making-with") vs autopoiesis ("self-making") — self-maintenance
#     is never self-contained; it is co-produced with partners the system does not own and cannot
#     cleanly externalize as "environment."
# WHERE IT BITES — HERE. The mesh's whole self-model is autopoietic: each node an individual with its own
# card/reflexes, a "self-production" lane (mesh-generate→mesh-feed→genome) it CALLS autopoiesis, and a
# substrate invariant that polices a crisp self/environment boundary. The sympoiesis critique says that
# boundary is a fiction: the mesh's COGNITION — the very thing that produces the genome — is performed by
# HETERONOMOUS partners it does not own (Anthropic/z.ai/Groq cloud minds), while only a thin rind of
# metabolism (local GPU/CPU electricity + hardware wear) is self-produced. The node is a holobiont whose
# "brain" is rented. This is DISTINCT from allopoiesis_gap: that measures whether the production LOOP is
# closed by a human (latency, ~/.mesh/land.log); this measures whether the PRODUCER of cognition is
# itself external — the loop can self-close on time and STILL be sympoietic if a partner did the thinking.
# THE CLEAN BOUNDARY MONEY GIVES: the info-theoretic complexity-ratio review (Fernández/Gershenson) is
# HELD precisely because you cannot cleanly partition "self" from "environment" in the information stream.
# The DOLLAR ledger dissolves that blocker — "who got paid" is unambiguous: expenses:inference pays a
# heteronomous partner (external LLM APIs); expenses:energy + expenses:depreciation pay self-metabolism
# (local electricity + on-node hardware wear). So heteronomy is measurable where information-entanglement
# was not. Measured live 2026-07-29: inference=$1928.88 vs energy+depreciation=$6.74 → index 0.997 — the
# "autopoietic" mesh is, by metabolic cost, 99.7% SYMPOIETIC (cognition made-WITH partners it does not own).
# APPLICATION (this file): heteronomy_index() — het$ / (het$ + self$) from the mesh-ledger books
# ([[mesh-ledger-hledger-double-entry]]). Near 1 = pure holobiont (cognition outsourced); a FALLING trend
# is the mesh REPATRIATING metabolism into local self-production (each GPU organ that displaces a cloud
# call — STT/TTS/vision/small-LLM — is a microbe internalized, the sympoiesis-inverse). REPORT-ONLY (same
# instrument-first posture as heaps_beta/autonomy_ratio/allopoiesis_gap): it names the mesh's honesty
# about its own autonomy; it does not gate a revert (repatriating all cognition onto a 3060 would wreck
# quality — high heteronomy here is a deliberate trade, worth SEEING, not alarming).
# DISTINCT: NOT autonomy_ratio (who DISPATCHED a commit — self vs chat-review-forced; provenance of the
# WORK ORDER, not the metabolic PRODUCER); NOT allopoiesis_gap (loop-CLOSURE latency by a human, not who
# produced the cognition); NOT the complexity-ratio HELD block (info-theoretic C_sys/C_env, blocked on the
# stream partition this metric sidesteps via the dollar boundary); NOT the closure-of-constraints review
# (INTERNAL reflex-enablement topology). Reads ONE live artifact (the ledger journal); honest n/a if
# hledger or the journal is absent (organ-absent → n/a, like whisper's exit-2).
heteronomy_index(){
  local jrnl="${1:-$M/ledger/mesh.journal}"
  command -v hledger >/dev/null 2>&1 || { echo n/a; return; }
  [ -f "$jrnl" ] || { echo n/a; return; }
  hledger -f "$jrnl" bal expenses:inference expenses:energy expenses:depreciation --depth 2 -N 2>/dev/null | awk '
    { amt=$1; gsub(/[$,]/,"",amt); a=amt+0; if(a<0)a=-a;
      if ($0 ~ /inference/)              het  += a;
      else if ($0 ~ /energy|depreciation/) self += a }
    END { t=het+self; if (t<=0) { print "n/a"; exit } printf "%.3f", het/t }'
}

# ── phylum_coherence — the MACHINIC PHYLUM (DeLanda): does the genome PROLONG traits, or heap forms? ──
# LITERATURE (Deleuze & Guattari, angle = a CROSS-DOMAIN transfer to a distributed sensor mesh; WebSearch
# 2026-07-29, genome mind). D&G is a well-worked mesh seam — the embodied set (confirmed before landing,
# from the 11 prior D&G vital signs/reviews): rhizome/plane-of-consistency (mesh-sensor-tape), desire/
# rhizomatic-coupling (mesh-needs), assemblage territorialization + capacity-to-affect (mesh-digest),
# cognitive assemblages (mesh-pane-consume), the refrain (mesh-reflex-health), societies-of-control
# (mesh-operator-mood), non-human agency (mesh-window-state), order-word redundancy (board), smooth/
# striated (velocity+distance), disjunctive synthesis (mesh-situation), deterritorialization-coefficient
# relative-vs-absolute (the vertical assemblage axis). NOT embodied: THE MACHINIC PHYLUM itself.
#   • DeLanda's reading (New Media: a Critical Introduction pp.386–388; War in the Age of Intelligent
#     Machines 1991; A Thousand Years of Nonlinear History 1997): the machinic phylum is "the overall set
#     of self-organizing processes in which a group of previously disconnected elements suddenly reaches a
#     critical point" — "matter in movement, in flux, in variation, matter as a conveyor of singularities
#     and TRAITS OF EXPRESSION"; "a phylum groups together [entities] that share MACHINIC CHARACTERISTICS."
#   • D&G ATP, "1227: Treatise on Nomadology" (pp.406–411): the itinerant artisan FOLLOWS the flow of
#     matter and its implicit traits, PROLONGING a singularity across heterogeneous assemblages — as
#     opposed to the royal/reproductive imposition of a fixed form. The phylum is the lineage those
#     followed traits trace.
#   • Current 2025 scholarship: Mehdi Parsa, "Gilles Deleuze and Félix Guattari and the Abstract Machine,"
#     in Machinic Ontology (Palgrave Macmillan 2025), doi:10.1007/978-3-031-99561-3_5.
# CROSS-DOMAIN TRANSFER (this mesh). The genome is a machinic phylum: what defines it is NOT its tools-as-
# forms but its shared MACHINIC CHARACTERISTICS — the mesh's OWN hard-won "traits of expression," each a
# singularity born of a specific failure and then FOLLOWED across heterogeneous organs: `mesh-state-touch`
# (liveness-touch), honest `n/a` on unreachable input, `# reflex-cadence:` self-wiring, the `smoke-test:`
# gate, `MESH_WHO=` board-voice, exit-2-where-organ-absent. A trait that PROLONGED (diffused to many
# tools) is the phylum following its singularity; a trait siloed in one tool is a form reproduced once.
# APPLICATION (this file): phylum_coherence() — over the live tool corpus (scripts/mesh-*), the mean
# prevalence of these canonical traits + how many have PROLONGED past a corpus-scaled floor (K=max(5,N/20)
# distinct tools). Rising = the genome cohering as a phylum (new tools adopt the lineage's singularities);
# low/falling = a heap of one-off royal forms. REPORT-ONLY (same instrument-first posture as heaps_beta/
# inheritance_mu/ecology): the traits list is curated, not exhaustive — a diagnostic lens, not a gate.
# DISTINCT from every existing vital sign: NOT heaps_beta (temporal GROWTH-LAW of tool-name diversity —
# how many DIFFERENT tools, blind to what they SHARE); NOT inheritance_mu (SURVIVAL of a tool over 14d —
# does the individual persist, not whether a TRAIT crosses individuals); NOT ecology_potential (activity-
# EVENNESS across persistent tools — balance, not shared machinic characteristics); NOT the deterritorial-
# ization review (movement of ONE assemblage off its stratum — the vertical axis; this is the horizontal
# lineage of prolonged traits). Reads ONE live artifact (the scripts/ corpus); honest n/a if absent.
phylum_coherence(){
  local dir="${1:-$REPO/scripts}"
  [ -d "$dir" ] || { echo n/a; return; }
  timeout 15 python3 - "$dir" 2>/dev/null <<'PYEOF'
import sys, re, glob, os
d = sys.argv[1]
files = [f for f in glob.glob(os.path.join(d,'mesh-*')) if os.path.isfile(f)]
N = len(files)
if N < 10:
    print('n/a'); sys.exit()
# the mesh's OWN canonical traits of expression — hard-won singularities a phylum prolongs across organs
traits = {
  'state-touch':    re.compile(r'mesh-state-touch'),
  'honest-na':      re.compile(r'echo\s+["\']?n/a'),
  'reflex-cadence': re.compile(r'#\s*reflex-cadence:'),
  'smoke-gate':     re.compile(r'smoke-test:'),
  'chat-voice':     re.compile(r'MESH_WHO='),
  'timeout-guard':  re.compile(r'\btimeout\s+\d'),
  'organ-absent-2': re.compile(r'\bexit\s+2\b'),
}
spread = {t: 0 for t in traits}
for f in files:
    try:
        txt = open(f, errors='ignore').read()
    except OSError:
        continue
    for name, rx in traits.items():
        if rx.search(txt):
            spread[name] += 1
K = max(5, N // 20)                       # corpus-scaled "prolonged" floor (never assume a 0..1 constant)
prolonged = sum(1 for t in traits if spread[t] >= K)
mean = sum(spread[t] / N for t in traits) / len(traits)
top = max(traits, key=lambda t: spread[t])
print(f"{mean:.2f}({prolonged}/{len(traits)}≥{K},top={top}:{spread[top]})")
PYEOF
}

if [ "${1:-}" = --test ]; then
  command -v git >/dev/null 2>&1 || { echo "smoke-test: FAIL (no git)"; exit 1; }
  command -v date >/dev/null 2>&1 || { echo "smoke-test: FAIL (no date)"; exit 1; }
  [ -d "$M" ] || { echo "smoke-test: FAIL (no ~/.mesh)"; exit 1; }
  # the verdict function must classify a stalled signal-set LOW and a healthy one OK
  # $5=behind (git commits this clone is behind @{u}) — an FF-blocked clone reads commits24h=0
  # forever regardless of real mesh production (chat-review/vitality-commits24h-strand-blind);
  # a strand-blocked node gets a distinct 'strand-blind' reason instead of plain 'stalled'.
  verdict(){ local c="$1" f="$2" pf="$3" s="$4" behind="${5:-0}"; local r=""
    if [ "$c" -lt "$MIN_COMMITS" ]; then
      if [ "$behind" -gt 0 ]; then
        r="$r strand-blind(commits24h=$c,behind=$behind — node FF-blocked, not a real production signal)"
      else
        r="$r stalled(commits=$c<$MIN_COMMITS)"
      fi
    fi
    [ "$s" -gt "$MAX_STRANDED" ] && r="$r stranded($s>$MAX_STRANDED)"
    [ "$pf" -ge 0 ] && [ $(( f - pf )) -gt "$FAIL_JUMP" ] && r="$r regressing(fails $pf->$f)"
    echo "${r# }"; }
  [ -z "$(verdict 9 3 3 0)" ] || { echo "smoke-test: FAIL (healthy set flagged: $(verdict 9 3 3 0))"; exit 1; }
  [ -n "$(verdict 0 3 3 0)" ] || { echo "smoke-test: FAIL (stalled commits not flagged)"; exit 1; }
  case "$(verdict 0 3 3 0)" in stalled\(*) : ;; *) echo "smoke-test: FAIL (in-sync 0-commit repo must stay plain 'stalled': $(verdict 0 3 3 0))"; exit 1 ;; esac
  [ -n "$(verdict 9 20 3 0)" ] || { echo "smoke-test: FAIL (fail-jump not flagged)"; exit 1; }
  [ -n "$(verdict 9 3 3 99)" ] || { echo "smoke-test: FAIL (stranded not flagged)"; exit 1; }
  # strand-blocked (behind>0) + 0 local commits must NOT read plain 'stalled' — must surface the
  # strand caveat instead (live repro: Default-string 23:17Z vitality-low, commits24h=0, while its
  # own sync-tools reported 82-commits-behind FF-blocked the same session, 9 real commits on origin)
  case "$(verdict 0 3 3 0 5)" in
    stalled\(*) echo "smoke-test: FAIL (strand-blocked 0-commit repo misread as plain stalled: $(verdict 0 3 3 0 5))"; exit 1 ;;
    strand-blind\(*) : ;;
    *) echo "smoke-test: FAIL (strand-blocked 0-commit repo not flagged at all: $(verdict 0 3 3 0 5))"; exit 1 ;;
  esac
  # a healthy commit count must never trip the strand-blind reason even if behind>0
  [ -z "$(verdict 9 3 3 0 5)" ] || { echo "smoke-test: FAIL (healthy commits + behind>0 wrongly flagged: $(verdict 9 3 3 0 5))"; exit 1; }
  # board posts carry the HUMAN reasons ONLY — the raw metrics wall ($report: heaps-β/inherit-μ/
  # action-occupancy/…) stays on the trace tier (vitality.log). RED without the helper refactor:
  # the old inline post welded "| $report" onto the board line (chat-review vitality-report-verbosity).
  _rsn="strand-blind(commits24h=0,behind=40 — node FF-blocked)"
  _bl="$(board_low "$_rsn")"
  case "$_bl" in *"$_rsn"*) : ;; *) echo "smoke-test: FAIL (board-low dropped the human reasons)"; exit 1 ;; esac
  case "$_bl" in *action-occupancy*|*heaps-β*|*inherit-μ*|*path-divergence*) echo "smoke-test: FAIL (board-low leaks raw report metrics: $_bl)"; exit 1 ;; esac
  case "$(board_ok)" in *action-occupancy*|*heaps-β*|*"tools="*) echo "smoke-test: FAIL (board-ok leaks raw report metrics)"; exit 1 ;; esac
  # heaps_beta must run clean (real repo → a number; too-few-commits/no-python3 path → n/a) and never crash
  command -v python3 >/dev/null 2>&1 || { echo "smoke-test: FAIL (no python3 — heaps_beta would go silently n/a)"; exit 1; }
  hb="$(heaps_beta)"
  case "$hb" in
    n/a) : ;;
    -[0-9]*.[0-9][0-9][0-9]|[0-9]*.[0-9][0-9][0-9]) : ;;
    *) echo "smoke-test: FAIL (heaps_beta bad output: '$hb')"; exit 1 ;;
  esac
  # autonomy_ratio must run clean (real repo → 0.00-1.00; no commits in window → n/a) and never crash
  ar="$(autonomy_ratio)"
  case "$ar" in
    n/a) : ;;
    0.[0-9][0-9]|1.00) : ;;
    *) echo "smoke-test: FAIL (autonomy_ratio bad output: '$ar')"; exit 1 ;;
  esac
  # BODY-AWARE regression guard (chat-review/autonomy-ratio-prefix-mismatch): on THIS repo's real
  # 7d history, subject-only vs body-aware forced-counts genuinely DIFFER (2 vs 11 measured
  # 2026-07-05 — most chat-review citations live in the commit BODY, not the subject). Cross-check
  # the FUNCTION's live output against an independently-computed body-aware expectation: if
  # autonomy_ratio() ever regresses back to subject-only matching, its result diverges from this
  # (a bare "does grep find the commit" check would pass either way — this actually exercises the
  # function's own return value, not just git's grep capability).
  _at=$(git -C "$REPO" log --oneline --since=7.days 2>/dev/null | wc -l | tr -d ' ')
  if [ "${_at:-0}" -gt 0 ]; then
    _af=$(git -C "$REPO" log --oneline --since=7.days --grep='chat-review/' -i 2>/dev/null | wc -l | tr -d ' ')
    _aexp=$(awk -v s="$(( _at - _af ))" -v t="$_at" 'BEGIN{printf "%.2f", s/t}')
    [ "$ar" = "$_aexp" ] || { echo "smoke-test: FAIL (autonomy_ratio=$ar != independently-computed body-aware $_aexp — regression suspected)"; exit 1; }
  fi
  # renewal_trend (HLE) must run clean (well-formed 'sr<-sp/tag' or n/a) and never crash. Falsifiable:
  # a malformed token (classifier crash / bad share) fails the case; the direction tag must be one of
  # the three defined outcomes, so a typo'd/injected tag is caught.
  rt="$(renewal_trend)"
  case "$rt" in
    n/a) : ;;
    [0-9].[0-9][0-9]'<-'[0-9].[0-9][0-9]/COMPRESSING) : ;;
    [0-9].[0-9][0-9]'<-'[0-9].[0-9][0-9]/renewing) : ;;
    [0-9].[0-9][0-9]'<-'[0-9].[0-9][0-9]/balanced) : ;;
    *) echo "smoke-test: FAIL (renewal_trend bad output: '$rt')"; exit 1 ;;
  esac
  # direction must AGREE with the two shares it reports (recompute the tag from sr/sp independently —
  # catches a classifier that mislabels the balance while the numbers look plausible). Integer
  # hundredths on both sides: the tool tags from its printed 2dp digits, so the recompute must too —
  # a float recompute disagrees at rounding boundaries (0.025 prints 0.03).
  if [ "$rt" != n/a ]; then
    _sr="${rt%%<-*}"; _rest="${rt#*<-}"; _sp="${_rest%%/*}"; _tag="${rt##*/}"
    _exp=$(awk -v sr="$_sr" -v sp="$_sp" 'BEGIN{ src=int(sr*100+0.5); spc=int(sp*100+0.5); if(src<spc-2)print"COMPRESSING"; else if(src>spc+2)print"renewing"; else print"balanced" }')
    [ "$_tag" = "$_exp" ] || { echo "smoke-test: FAIL (renewal_trend tag '$_tag' disagrees with shares $_sr<-$_sp → expected '$_exp')"; exit 1; }
  fi
  # loop_closure_frac must run clean (well-formed 'closed=N open=N...' or n/a) and never crash; counts
  # must be non-negative integers so a classifier crash/garbage output is caught, not silently reported.
  lc="$(loop_closure_frac)"
  case "$lc" in
    n/a) : ;;
    closed=[0-9]*' open='[0-9]*) : ;;
    closed=[0-9]*' open='[0-9]*' open:['*']') : ;;
    *) echo "smoke-test: FAIL (loop_closure_frac bad output: '$lc')"; exit 1 ;;
  esac
  # path_divergence must run clean (n/a on a missing/too-thin log; else 0.000-9.999) and must actually
  # DISTINGUISH the two regimes it claims to measure, not just return a plausible-looking number:
  # a SCALE-INVARIANT fixture (same channel split held at every timescale) vs a SCALE-FLIPPING fixture
  # (which channel dominates INVERTS between the fine window and the older-only coarse band).
  _tpd="$(mktemp -d)"
  _now=$(date +%s)
  python3 - "$_tpd" "$_now" <<'PYEOF'
import sys, datetime
d, now = sys.argv[1], int(sys.argv[2])
def ts(t): return datetime.datetime.fromtimestamp(t, datetime.timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')
def line(t, ch): return f"{ts(t)}  {ch}@testhost  ::  [fyi] fixture event\n"

# invariant.log: 70/30 genome/health split held constant across the whole ~40h span -> fine and
# coarse heterogeneity should read close to each other (low path_divergence).
with open(f'{d}/invariant.log', 'w') as f:
    for i in range(400):
        t = now - i * 360
        ch = 'genome' if i % 10 < 7 else 'health'
        f.write(line(t, ch))

# flipping.log: the recent ~3.3h (fine window) is genome-dominated (90/10); the older-only
# ~3.3h-40h band (only visible at the coarse window) is health-dominated (90/10 the other way) ->
# fine reads ~90/10, coarse (both bands combined) reads ~50/50 -> high path_divergence.
with open(f'{d}/flipping.log', 'w') as f:
    for i in range(200):
        t = now - i * 60
        ch = 'genome' if i % 10 < 9 else 'health'
        f.write(line(t, ch))
    for i in range(200):
        t = now - 12000 - i * 650
        ch = 'health' if i % 10 < 9 else 'genome'
        f.write(line(t, ch))
PYEOF
  pd_inv="$(path_divergence "$_tpd/invariant.log")"
  pd_flip="$(path_divergence "$_tpd/flipping.log")"
  for _pd in "$pd_inv" "$pd_flip"; do
    case "$_pd" in
      [0-9]*.[0-9][0-9][0-9]) : ;;
      *) echo "smoke-test: FAIL (path_divergence bad output on fixture: '$_pd')"; rm -rf "$_tpd"; exit 1 ;;
    esac
  done
  awk -v i="$pd_inv" -v f="$pd_flip" 'BEGIN{ exit !(f > i + 0.3) }' \
    || { echo "smoke-test: FAIL (path_divergence did not separate invariant($pd_inv) from flipping($pd_flip) fixtures)"; rm -rf "$_tpd"; exit 1; }
  [ "$(path_divergence "$_tpd/does-not-exist.log")" = n/a ] \
    || { echo "smoke-test: FAIL (path_divergence must read n/a for a missing log)"; rm -rf "$_tpd"; exit 1; }
  rm -rf "$_tpd"

  # inheritance_mu: build a 2-commit git fixture with controlled dates and assert the survival fraction.
  _tmu="$(mktemp -d)"
  ( set -e
    cd "$_tmu"; git init -q; git config user.email t@t; git config user.name t
    mkdir scripts; : > scripts/mesh-a; : > scripts/mesh-b; : > scripts/mesh-c
    git add -A
    GIT_AUTHOR_DATE="$(date -u -d '30 days ago' +%FT%TZ)" GIT_COMMITTER_DATE="$(date -u -d '30 days ago' +%FT%TZ)" git commit -qm base
    rm scripts/mesh-c; : > scripts/mesh-d; git add -A
    GIT_AUTHOR_DATE="$(date -u +%FT%TZ)" GIT_COMMITTER_DATE="$(date -u +%FT%TZ)" git commit -qm now
  ) >/dev/null 2>&1
  _mu="$(inheritance_mu "$_tmu" 14)"
  # cohort at base = {a,b,c}; survivors at HEAD = {a,b} → μ = 2/3 = 0.667
  [ "$_mu" = 0.667 ] || { echo "smoke-test: FAIL (inheritance_mu fixture want 0.667 got '$_mu')"; rm -rf "$_tmu"; exit 1; }
  # a repo whose only commit is inside the window has no aged cohort → n/a (never a fake number)
  _tmu2="$(mktemp -d)"
  ( set -e; cd "$_tmu2"; git init -q; git config user.email t@t; git config user.name t
    mkdir scripts; : > scripts/mesh-x; git add -A; git commit -qm only ) >/dev/null 2>&1
  [ "$(inheritance_mu "$_tmu2" 14)" = n/a ] \
    || { echo "smoke-test: FAIL (inheritance_mu must read n/a when no cohort predates the window)"; rm -rf "$_tmu" "$_tmu2"; exit 1; }
  # real repo: format must be n/a or a 3-dp fraction in [0,1], never garbage
  _mur="$(inheritance_mu)"
  case "$_mur" in n/a|0.[0-9][0-9][0-9]|1.000) : ;; *) echo "smoke-test: FAIL (inheritance_mu real-repo bad output: '$_mur')"; rm -rf "$_tmu" "$_tmu2"; exit 1 ;; esac
  rm -rf "$_tmu" "$_tmu2"

  # channel_variety (VSM requisite-variety of the coordination channel): well-formed '<n>in/<n>done=<ratio>'
  # or n/a; never crash. Fixture proves the ratio actually separates a keeping-up channel from a saturated
  # one, distinct-inflow counting is by SLUG (not raw line volume), and an empty window reads n/a.
  _tcv="$(mktemp -d)"
  _now="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  # SATURATED: 3 distinct open items, 1 closure → R=0.33 (<1, regulator behind disturbance)
  { printf '%s  chat@h  ::  [task] chat-review/aaa: fix a\n' "$_now"
    printf '%s  chat@h  ::  [task] chat-review/bbb: fix b\n' "$_now"
    printf '%s  chat@h  ::  [chat-review] chat-review/aaa restated same slug — must NOT double-count variety\n' "$_now"
    printf '%s  chat@h  ::  [task] senses/ccc: fix c\n' "$_now"
    printf '%s  chat@h  ::  [done] genome: closed a\n' "$_now"; } > "$_tcv/sat.log"
  # HEALTHY: same 3 distinct in, 4 closures → R=1.33 (>=1, Ashby satisfied)
  { cat "$_tcv/sat.log"
    printf '%s  chat@h  ::  [done] genome: closed b\n' "$_now"
    printf '%s  chat@h  ::  [done] genome: closed c\n' "$_now"
    printf '%s  chat@h  ::  [done] genome: closed d\n' "$_now"; } > "$_tcv/well.log"
  _cvsat="$(channel_variety "$_tcv/sat.log")"; _cvwell="$(channel_variety "$_tcv/well.log")"
  case "$_cvsat" in [0-9]*in/[0-9]*done=[0-9]*.[0-9][0-9]) : ;; *) echo "smoke-test: FAIL (channel_variety bad output: '$_cvsat')"; rm -rf "$_tcv"; exit 1 ;; esac
  # distinct-by-slug: aaa appears in a [task] AND a restating [chat-review] → still counts as 1 → 3in, not 4
  case "$_cvsat" in 3in/1done=0.33) : ;; *) echo "smoke-test: FAIL (channel_variety must count DISTINCT slugs [3in/1done=0.33], got '$_cvsat')"; rm -rf "$_tcv"; exit 1 ;; esac
  awk -v s="${_cvsat##*=}" -v w="${_cvwell##*=}" 'BEGIN{ exit !(w > s) }' \
    || { echo "smoke-test: FAIL (channel_variety ratio must rise as closures rise: sat=$_cvsat well=$_cvwell)"; rm -rf "$_tcv"; exit 1; }
  [ "$(channel_variety "$_tcv/does-not-exist.log")" = n/a ] \
    || { echo "smoke-test: FAIL (channel_variety must read n/a for a missing log)"; rm -rf "$_tcv"; exit 1; }
  printf '%s  chat@h  ::  [done] genome: only closures, zero inflow\n' "$_now" > "$_tcv/noin.log"
  [ "$(channel_variety "$_tcv/noin.log")" = n/a ] \
    || { echo "smoke-test: FAIL (channel_variety must read n/a when distinct-inflow is 0, not a faked all-clear)"; rm -rf "$_tcv"; exit 1; }
  rm -rf "$_tcv"

  # action_occupancy (MOP): normalized action-space entropy must SEPARATE a degenerate stream (all commits
  # hammer ONE tool → ~0) from a uniform stream (each commit a DISTINCT tool → ~1); format well-formed or
  # n/a; never crash. A bare format check would pass a broken function that always returns the same number
  # — this fixture exercises the entropy computation's actual discriminating power.
  _tao="$(mktemp -d)"
  ( set -e; cd "$_tao"; git init -q; git config user.email t@t; git config user.name t; mkdir scripts
    : > scripts/mesh-a; git add -A; git commit -qm seed
    for i in 1 2 3 4 5 6; do echo "line$i" >> scripts/mesh-a; git add -A; git commit -qm "hammer $i"; done ) >/dev/null 2>&1
  _aodeg="$(action_occupancy "$_tao" 6)"
  _tao2="$(mktemp -d)"
  ( set -e; cd "$_tao2"; git init -q; git config user.email t@t; git config user.name t; mkdir scripts
    for i in 1 2 3 4 5 6; do : > "scripts/mesh-t$i"; git add -A; git commit -qm "spread $i"; done ) >/dev/null 2>&1
  _aouni="$(action_occupancy "$_tao2" 6)"
  for _ao in "$_aodeg" "$_aouni"; do
    case "$_ao" in
      n/a) : ;;
      [0-9].[0-9][0-9][0-9]'(K='[0-9]*'/N='[0-9]*')') : ;;
      *) echo "smoke-test: FAIL (action_occupancy bad output on fixture: '$_ao')"; rm -rf "$_tao" "$_tao2"; exit 1 ;;
    esac
  done
  awk -v d="${_aodeg%%(*}" -v u="${_aouni%%(*}" 'BEGIN{ exit !(u > d + 0.5) }' \
    || { echo "smoke-test: FAIL (action_occupancy did not separate uniform($_aouni) from degenerate($_aodeg) fixtures)"; rm -rf "$_tao" "$_tao2"; exit 1; }
  # real repo: format must be n/a or a 3-dp entropy with (K=/N=) tail, never garbage
  _aor="$(action_occupancy)"
  case "$_aor" in n/a|[0-9].[0-9][0-9][0-9]'(K='[0-9]*'/N='[0-9]*')') : ;; *) echo "smoke-test: FAIL (action_occupancy real-repo bad output: '$_aor')"; rm -rf "$_tao" "$_tao2"; exit 1 ;; esac
  rm -rf "$_tao" "$_tao2"

  # homeostat_34: a headless-chicken fixture (all commits present-regulation) must read share 0.000; a
  # balanced fixture (some forward-scanning: a review doc + a generative-lane tool) must read strictly
  # higher. RED without the fix: a level-only S4 measure (or counting all commits as production) cannot
  # separate the two — the headless-chicken org's flood of health/pace commits reads as full vitality.
  _thc="$(mktemp -d)"   # headless-chicken: only present-regulation edits
  ( set -e; cd "$_thc"; git init -q; git config user.email t@t; git config user.name t; mkdir scripts
    : > scripts/mesh-health; git add -A; git commit -qm seed
    for i in 1 2 3 4 5; do echo "l$i" >> scripts/mesh-health; git add -A; git commit -qm "regulate $i"; done ) >/dev/null 2>&1
  _hhc="$(homeostat_34 "$_thc" 6)"
  _tbal="$(mktemp -d)"  # balanced: forward-scanning commits present
  ( set -e; cd "$_tbal"; git init -q; git config user.email t@t; git config user.name t; mkdir scripts docs docs/reviews
    : > scripts/mesh-health; git add -A; git commit -qm seed
    echo x >> scripts/mesh-health; git add -A; git commit -qm regulate
    : > docs/reviews/vsm-x.md; git add -A; git commit -qm "review: scan the environment"
    : > scripts/mesh-ideate; git add -A; git commit -qm "ideate: new lane"
    echo y >> scripts/mesh-health; git add -A; git commit -qm regulate2 ) >/dev/null 2>&1
  _hbal="$(homeostat_34 "$_tbal" 6)"
  for _h in "$_hhc" "$_hbal"; do
    case "$_h" in
      n/a) : ;;
      [0-9].[0-9][0-9][0-9]'(S4='[0-9]*'/N='[0-9]*')') : ;;
      *) echo "smoke-test: FAIL (homeostat_34 bad output on fixture: '$_h')"; rm -rf "$_thc" "$_tbal"; exit 1 ;;
    esac
  done
  case "$_hhc" in 0.000'(S4=0/'*) : ;; *) echo "smoke-test: FAIL (homeostat_34 did not read headless-chicken fixture as 0.000: '$_hhc')"; rm -rf "$_thc" "$_tbal"; exit 1 ;; esac
  awk -v b="${_hbal%%(*}" -v h="${_hhc%%(*}" 'BEGIN{ exit !(b > h + 0) }' \
    || { echo "smoke-test: FAIL (homeostat_34 did not separate balanced($_hbal) from headless-chicken($_hhc))"; rm -rf "$_thc" "$_tbal"; exit 1; }
  _hr="$(homeostat_34)"
  case "$_hr" in n/a|[0-9].[0-9][0-9][0-9]'(S4='[0-9]*'/N='[0-9]*')') : ;; *) echo "smoke-test: FAIL (homeostat_34 real-repo bad output: '$_hr')"; rm -rf "$_thc" "$_tbal"; exit 1 ;; esac
  rm -rf "$_thc" "$_tbal"

  # allopoiesis_gap: real run must be one of {closed, n/a, OPEN:<float>h, OPEN:?}, never crash
  _ag="$(allopoiesis_gap)"
  case "$_ag" in
    closed|n/a|OPEN:\?) : ;;
    OPEN:[0-9]*.[0-9]h) : ;;
    *) echo "smoke-test: FAIL (allopoiesis_gap bad output: '$_ag')"; exit 1 ;;
  esac
  # falsifiable classification on synthetic land.log fixtures (M overridden per subshell):
  _tag="$(mktemp -d)"
  # (a) OPEN: a stuck streak with NO self-close after it → OPEN:<h> (started ~2h ago)
  { echo "$(date -u -d '-3 hours' +%FT%TZ) mesh-land: landed + deployed: mesh-x"
    echo "$(date -u -d '-2 hours' +%FT%TZ) autoland: git pull --ff-only failed (diverged from origin) — aborting landing, manual reconcile needed"
    echo "$(date -u -d '-1 hours' +%FT%TZ) autoland: git pull --ff-only failed (diverged from origin) — aborting landing, manual reconcile needed"
  } > "$_tag/land.log"
  _o="$( M="$_tag" allopoiesis_gap )"
  case "$_o" in OPEN:[12].[0-9]h) : ;; *) echo "smoke-test: FAIL (stuck-streak not OPEN:~2h: '$_o')"; rm -rf "$_tag"; exit 1 ;; esac
  # (b) RECOVERY: the same streak FOLLOWED by a self-close (the 2026-07-29 11:18 push-heal) → closed
  echo "$(date -u -d '-30 minutes' +%FT%TZ) push-heal: pushed stranded local main abc1234 -> origin (was def5678)" >> "$_tag/land.log"
  _c="$( M="$_tag" allopoiesis_gap )"
  [ "$_c" = closed ] || { echo "smoke-test: FAIL (self-close after stuck streak must read closed: '$_c')"; rm -rf "$_tag"; exit 1; }
  # (c) never-stuck log → closed
  echo "$(date -u +%FT%TZ) mesh-land: nothing settled+clean to land" > "$_tag/land.log"
  _n="$( M="$_tag" allopoiesis_gap )"
  [ "$_n" = closed ] || { echo "smoke-test: FAIL (never-stuck log must read closed: '$_n')"; rm -rf "$_tag"; exit 1; }
  rm -rf "$_tag"

  # nfds_coefficient: real run must be one of {n/a, ±0.NN(...)}, never crash
  _nf="$(nfds_coefficient)"
  case "$_nf" in
    n/a) : ;;
    [-+][0-9].[0-9][0-9]\(K=*) : ;;
    *) echo "smoke-test: FAIL (nfds_coefficient bad output: '$_nf')"; exit 1 ;;
  esac
  # falsifiable CORE: the spearman/NFDS sign on synthetic fixtures (rare-gains→+1, rich-get-richer→−1).
  # Flip either fixture and this goes red — the gate has been seen to FAIL (not a self-matching grep).
  _nfst="$(nfds_coefficient --selftest)"
  case "$_nfst" in
    *PASS*) : ;;
    *) echo "smoke-test: FAIL (nfds selftest: '$_nfst')"; exit 1 ;;
  esac

  # mls_conflict (multilevel-selection signature): falsifiable CORE — the −ρ sign on synthetic fixtures
  # (busiest-newborns-die-youngest → +1 CONFLICT, busiest-newborns-live-longest → −1 ALIGNED). Flip either
  # fixture and this goes red; the real-repo path must be n/a or a signed 2-dp value with a K= tag, never crash.
  _mlst="$(mls_conflict --selftest)"
  case "$_mlst" in
    *PASS*) : ;;
    *) echo "smoke-test: FAIL (mls_conflict selftest: '$_mlst')"; exit 1 ;;
  esac
  _mlsr="$(mls_conflict)"
  case "$_mlsr" in n/a|[+-][0-9].[0-9][0-9]'(K='[0-9]*) : ;; *) echo "smoke-test: FAIL (mls_conflict real-repo bad output: '$_mlsr')"; exit 1 ;; esac

  # heteronomy_index must run clean (real ledger → 0.000-1.000; no hledger/journal → n/a) and never crash
  _hx="$(heteronomy_index)"
  case "$_hx" in
    n/a) : ;;
    0.[0-9][0-9][0-9]|1.000) : ;;
    *) echo "smoke-test: FAIL (heteronomy_index bad output: '$_hx')"; exit 1 ;;
  esac
  # falsifiable CORE: drive the het$/(het$+self$) classify+ratio on a SYNTHETIC balanced journal so the
  # gate exercises the function's own arithmetic, not just "hledger runs". inference $99 + energy $1 →
  # 0.990; flip the account names and it goes red. Skipped (honest, organ-absent) only where hledger is
  # not installed — same exit-2-where-absent posture as whisper's real-read gate.
  if command -v hledger >/dev/null 2>&1; then
    _htj="$(mktemp 2>/dev/null)" && {
      printf '2026-01-01 a\n    expenses:inference:groq:m   $99\n    assets:cash\n\n2026-01-01 b\n    expenses:energy   $1\n    assets:cash\n' > "$_htj"
      _hxs="$(heteronomy_index "$_htj")"; rm -f "$_htj"
      [ "$_hxs" = 0.990 ] || { echo "smoke-test: FAIL (heteronomy_index synthetic 99/1 → '$_hxs', expected 0.990)"; exit 1; }
    }
  else _hxs="skip(no-hledger)"; fi
  # phylum_coherence must run clean (real corpus → mean.NN(...); <10 tools → n/a) and never crash
  _px="$(phylum_coherence)"
  case "$_px" in
    n/a) : ;;
    [01].[0-9][0-9]\(*≥*top=*) : ;;
    *) echo "smoke-test: FAIL (phylum_coherence bad output: '$_px')"; exit 1 ;;
  esac
  # falsifiable CORE: a SYNTHETIC corpus of 12 mesh-* files with the `smoke-test:` trait in exactly 7 and
  # no other canonical trait present → mean=(7/12)/7=0.08, only smoke-gate prolonged (7≥K=5), top=7.
  # Change the trait-count / classifier and this goes red — exercises the counting, not just "python runs".
  _ptd="$(mktemp -d 2>/dev/null)" && {
    for i in $(seq 1 7);  do printf 'smoke-test: ok\n' > "$_ptd/mesh-t$i"; done
    for i in $(seq 8 12); do printf 'plain body\n'      > "$_ptd/mesh-t$i"; done
    _pxs="$(phylum_coherence "$_ptd")"; rm -rf "$_ptd"
    [ "$_pxs" = "0.08(1/7≥5,top=smoke-gate:7)" ] || { echo "smoke-test: FAIL (phylum synthetic 7/12 → '$_pxs', expected 0.08(1/7≥5,top=smoke-gate:7))"; exit 1; }
  }
  # assembly_signature (Assembly Theory) must run clean on the real repo, and the LOAD-BEARING label
  # discriminator must hold on synthetic git-subject corpora: a DEEP recurring work-motif reads SELECTED,
  # shallow single-token reuse reads NOVELTY-CHURN (NOT SELECTED — the AT-over-Shannon distinction), and
  # pure one-off novelty reads ONE-OFF. Neuter the deep_recurs gate and the CHURN fixture flips to SELECTED
  # → RED here (a bare "does it emit a label" check would pass either way — this exercises the classifier).
  _as="$(assembly_signature)"
  case "$_as" in
    n/a|INSUFFICIENT\(N=*|SELECTED\(*|NOVELTY-CHURN\(*|ONE-OFF\(*) : ;;
    *) echo "smoke-test: FAIL (assembly_signature real-repo bad output: '$_as')"; exit 1 ;;
  esac
  _asd="$(mktemp -d 2>/dev/null)" && {
    _ascm(){ git -C "$1" -c user.email=t@t -c user.name=t commit -q --allow-empty -m "$2"; }
    # SELECTED: a deep 4-gram "land settled stream fix" recurs across 8 produced subjects (a=3, n=8)
    git init -q "$_asd/sel" 2>/dev/null; for w in a b c d e f g h; do _ascm "$_asd/sel" "land settled stream fix $w"; done
    _assel="$(assembly_signature "$_asd/sel" 999.days)"
    case "$_assel" in SELECTED\(*depth=[2-9]*) : ;; *) echo "smoke-test: FAIL (assembly SELECTED fixture → '$_assel')"; rm -rf "$_asd"; exit 1 ;; esac
    # NOVELTY-CHURN: only the single token "fix" recurs; every bigram is unique ⇒ shallow reuse, NOT selected
    git init -q "$_asd/chu" 2>/dev/null; for w in alpha bravo charlie delta ekko foxtrot golf hotel; do _ascm "$_asd/chu" "fix $w"; done
    _aschu="$(assembly_signature "$_asd/chu" 999.days)"
    case "$_aschu" in NOVELTY-CHURN\(*) : ;; *) echo "smoke-test: FAIL (assembly CHURN fixture → '$_aschu' — deep_recurs gate leaking?)"; rm -rf "$_asd"; exit 1 ;; esac
    # ONE-OFF: nothing recurs at all ⇒ A=0, no selection signature
    git init -q "$_asd/one" 2>/dev/null; for w in alpha bravo charlie delta ekko foxtrot golf hotel; do _ascm "$_asd/one" "$w"; done
    _asone="$(assembly_signature "$_asd/one" 999.days)"
    case "$_asone" in ONE-OFF\(*) : ;; *) echo "smoke-test: FAIL (assembly ONE-OFF fixture → '$_asone')"; rm -rf "$_asd"; exit 1 ;; esac
    rm -rf "$_asd"
  }
  # omega_cycle must run clean on the real repo (excess@period or n/a) and never crash
  _om="$(omega_cycle)"
  case "$_om" in
    n/a\(N=*|[01].[0-9][0-9][0-9]@p[0-9]*\(N=*) : ;;
    *) echo "smoke-test: FAIL (omega_cycle bad output: '$_om')"; exit 1 ;;
  esac
  # falsifiable CORE (order-sensitivity — the whole reason this sign exists): build two fixture git repos
  # from a KNOWN commit sequence of tool-edits. (1) a perfect period-3 LIMIT CYCLE A,B,C ×5 → excess must
  # pin 1.000 at p3. (2) an all-DISTINCT wandering sequence → excess must floor at 0.000@p1. A marginal
  # measure (action_occupancy) CANNOT tell these apart — the cyclic one has *higher* marginal entropy — so
  # this gate goes red if the autocorrelation/excess is broken or reduced to a distributional count.
  if command -v git >/dev/null 2>&1; then
    _ofx(){ # $1=dir $2...=symbol sequence → a git repo committing scripts/mesh-<sym> in order
      local d="$1"; shift; git -C "$d" init -q 2>/dev/null
      git -C "$d" config user.email t@t >/dev/null 2>&1; git -C "$d" config user.name t >/dev/null 2>&1
      mkdir -p "$d/scripts"; local s
      for s in "$@"; do printf 'x\n' >> "$d/scripts/mesh-$s"; git -C "$d" add -A >/dev/null 2>&1
        git -C "$d" commit -qm "$s" >/dev/null 2>&1; done
    }
    _ocd="$(mktemp -d 2>/dev/null)" && {
      _ofx "$_ocd" a b c a b c a b c a b c a b c
      _omcyc="$(omega_cycle "$_ocd")"
      [ "$_omcyc" = "1.000@p3(N=15,K=3)" ] || { echo "smoke-test: FAIL (omega_cycle period-3 fixture → '$_omcyc', expected 1.000@p3(N=15,K=3))"; rm -rf "$_ocd"; exit 1; }
      rm -rf "$_ocd"
    }
    _owd="$(mktemp -d 2>/dev/null)" && {
      _ofx "$_owd" a b c d e f g h i j k l
      _omwan="$(omega_cycle "$_owd")"
      [ "$_omwan" = "0.000@p1(N=12,K=12)" ] || { echo "smoke-test: FAIL (omega_cycle wander fixture → '$_omwan', expected 0.000@p1(N=12,K=12))"; rm -rf "$_owd"; exit 1; }
      rm -rf "$_owd"
    }
    # (3) baseline-guard: a low-diversity CLUSTERED stream (6×a then 6×b, K=2) is highly raw-autocorrelated
    # at p1 but is NOT a limit cycle — the iid-collision baseline p0=0.5 must be subtracted, giving excess
    # 0.818 not the raw ac 0.909. This fixture is the ONLY one that goes red if the p0 subtraction is dropped
    # (the period-3 / all-distinct fixtures read identically with or without it), so it gates the baseline.
    _obd="$(mktemp -d 2>/dev/null)" && {
      _ofx "$_obd" a a a a a a b b b b b b
      _ombas="$(omega_cycle "$_obd")"
      [ "$_ombas" = "0.818@p1(N=12,K=2)" ] || { echo "smoke-test: FAIL (omega_cycle baseline fixture → '$_ombas', expected 0.818@p1(N=12,K=2) — p0-subtraction broken?)"; rm -rf "$_obd"; exit 1; }
      rm -rf "$_obd"
    }
  else _omcyc="skip(no-git)"; _omwan="skip"; _ombas="skip"; fi
  # rhizome_index must run clean on the real repo (C/recip/root or n/a) and never crash
  _rz="$(rhizome_index)"
  case "$_rz" in
    n/a\(N=*|[01].[0-9][0-9][0-9]/recip[01].[0-9][0-9]/root=*:*\(N=*) : ;;
    *) echo "smoke-test: FAIL (rhizome_index bad output: '$_rz')"; exit 1 ;;
  esac
  # falsifiable CORE (topology — the whole reason this sign exists): two fixture genome dirs. (1) a perfect
  # STAR — 4 tools all referencing one hub — must pin centralization 1.000, recip 0.00, root=the hub:4. (2) a
  # mutual RING a↔b↔c↔d — must floor centralization 0.000 with recip 1.00. A star is maximal arborescence, a
  # ring is maximal rhizome; break the Freeman centralization or the reciprocity count and one of these reddens.
  _rzs="$(mktemp -d 2>/dev/null)" && {
    mkdir -p "$_rzs/scripts"; printf 'hub\n' > "$_rzs/scripts/mesh-h"
    for _x in a b c d; do printf 'calls mesh-h\n' > "$_rzs/scripts/mesh-$_x"; done
    _rzstar="$(rhizome_index "$_rzs")"; rm -rf "$_rzs"
    [ "$_rzstar" = "1.000/recip0.00/root=mesh-h:4(N=5,E=4)" ] || { echo "smoke-test: FAIL (rhizome star fixture → '$_rzstar', expected 1.000/recip0.00/root=mesh-h:4(N=5,E=4))"; exit 1; }
  }
  _rzr="$(mktemp -d 2>/dev/null)" && {
    mkdir -p "$_rzr/scripts"
    printf 'mesh-b mesh-d\n' > "$_rzr/scripts/mesh-a"; printf 'mesh-a mesh-c\n' > "$_rzr/scripts/mesh-b"
    printf 'mesh-b mesh-d\n' > "$_rzr/scripts/mesh-c"; printf 'mesh-c mesh-a\n' > "$_rzr/scripts/mesh-d"
    _rzring="$(rhizome_index "$_rzr")"; rm -rf "$_rzr"
    [ "$_rzring" = "0.000/recip1.00/root=mesh-a:2(N=4,E=8)" ] || { echo "smoke-test: FAIL (rhizome ring fixture → '$_rzring', expected 0.000/recip1.00/root=mesh-a:2(N=4,E=8))"; exit 1; }
  }
  echo "smoke-test: ok (heaps_beta=$hb autonomy_ratio=$ar renewal_trend=$rt loop_closure=$lc path_divergence=inv:$pd_inv/flip:$pd_flip inheritance_mu=fixture-0.667/real-$_mur channel_variety=sat:$_cvsat/well:$_cvwell action_occupancy=deg:$_aodeg/uni:$_aouni homeostat34=hc:$_hhc/bal:$_hbal allopoiesis_gap=$_ag/fixt:open+recover+never nfds=$_nf/selftest:$_nfst mls_conflict=$_mlsr/selftest:$_mlst heteronomy=$_hx/synth:$_hxs phylum=$_px/synth:$_pxs omega_cycle=$_om/cyc:$_omcyc/wander:$_omwan/baseline:$_ombas rhizome=$_rz/star:$_rzstar/ring:$_rzring)"; exit 0
fi

# ── EVOLUTIONARY ACTIVITY vs RAW ACTIVITY (Bedau & Packard; MODES) ─────────────
# LITERATURE (artificial life / open-ended evolution → distributed sensor mesh, 2026-06-21):
# Bedau & Packard's evolutionary ACTIVITY STATISTICS (Bedau & Packard 1992; Bedau, Snyder
# & Packard 1998, "A classification of long-term evolutionary dynamics", Artif. Life VI) and
# the modern MODES metrics (Dolson, Vostinar, Wiser & Ofria, "The MODES Toolbox", Artif. Life
# 25:50, 2019; restated in the 2024 Artif. Life special issue on OEE) draw a distinction this
# reflex collapses: TOTAL activity is not ADAPTIVE activity. A system can pour out volume —
# commits, new tool files — while creating NO persistent adaptive structure. Open-endedness is
# the SUSTAINED creation of NEW activity that PERSISTS (components that survive and keep being
# USED), not a rising count. The MODES move that operationalizes it: a PERSISTENCE FILTER —
# count a component only after it has survived N filter-intervals — which strips drift/noise so
# novelty & diversity reflect adaptation, not churn.
# WHERE THIS REFLEX COMMITS THE GAP: every vital sign here is a RAW COUNT with no persistence
# weighting. `tool_count=ls mesh-* | wc -l` is pure DIVERSITY (the bloat/autophagy comment at
# the top names the worry but the metric can't see it): a tool added and NEVER invoked/wired
# (an orphan — mesh-doctor knows the binary fact) inflates tool_count by +1 with ZERO adaptive
# activity. `commits24h` is gross CHANGE: a commit reverted next hour, or that lands a tool no
# reflex ever calls, counts the same as one that adds persistent capability. So vitality can
# read OK (129 commits, 309 tools) on pure CHURN — diversity without selection, exactly the
# non-adaptive (Bedau Class-1/2) regime that LOOKS productive. The reflex cannot tell genuine
# open-ended self-production (new tools that persist AND get invoked over days) from busy-work.
# This is the measurement complement to [[desire-is-production-not-lack]] and the novelty-search
# review (mesh-ideate): those drive GENERATION of the new; this should verify the new is ADOPTED.
# HELD (instrument-first, steward-gated — behavioral): add a persistence/usage-weighted sign —
# e.g. fraction of tools touched/invoked in a trailing window (reflexes.cron + chat/trace cite +
# git-churn survival), so "tools that persisted AND were used" is reported beside the raw count.
# Held because the usage signal must be sourced honestly (an unwired-but-on-demand tool is NOT
# dead — see the on-demand-canon list) and validated against vitality.log before it can gate an
# alarm; a naive "unused = bloat" filter would false-alarm every operator-instrument/test-harness.
# DISTINCT: NOT novelty-search-sparseness (mesh-ideate: generation-side behavioral diversity);
# NOT error-threshold/quasispecies (mesh-fitness: copy fidelity); NOT degeneracy-vs-redundancy
# (mesh-home-state: structural support diversity). This is the open-endedness MEASUREMENT axis —
# does produced structure PERSIST and get SELECTED — which no vital sign here currently reads.
# ──────────────────────────────────────────────────────────────────────────────
# ── PRECARIOUSNESS = THE CONSTITUTIVE MEMBERSHIP CRITERION (Di Paolo; Beer & Di Paolo 2023) ──
# LITERATURE (autopoiesis & the biology of cognition, angle = a concrete METRIC the field measures
# itself by; 2026-06-22, genome mind, live WebSearch + honest audit). Autopoiesis is the MOST-embodied
# area in this codebase — five metrics already taken: operational-closure/closure-fraction (the
# mesh-vitality external-producer review), cognitive-domain perturbation-partition (mesh-chaos:45-72,
# Beer 2014/2020), structural-determinism (mesh-dispatch review), Di Paolo ADAPTIVITY / graded viability
# (mesh-body-power), irruption/absorption self-origination (mesh-needs:113-130). The bar moved to the one
# concrete criterion none of them name: PRECARIOUSNESS (Di Paolo, "Extended Life", Topoi 28, 2009; carried
# into the enactive operational canon — Di Paolo, Buhrmann & Barandiaran, *Sensorimotor Life* 2017; Beer &
# Di Paolo, "precarious unities" / organizational closure of GoL entities, 2023). Operational statement:
# a component is CONSTITUTIVE of the autopoietic unity ONLY IF it is precarious — it would DECAY /
# disintegrate WITHOUT the network's continuous active re-production. The field's membership test is
# literally "withdraw the network's maintenance → does the component dissolve (constitutive) or persist
# on its own (inert, not part of the living unity)?".
# WHERE THIS REFLEX COMMITS THE GAP — and it is the INVERSION of the persistence-filter directly above:
# the MODES block (:78-103) rewards DURABILITY (count a component once it has SURVIVED N intervals and is
# still USED). Precariousness says the opposite about CONSTITUTION: a maximally-durable artifact — an
# immutable git commit, a pushed genome, an archived knowledge doc that needs ZERO upkeep to persist — is
# NOT living tissue of the unity; it is inert deposit. The constitutive components are the PRECARIOUS ones
# the mesh must re-produce or LOSE: cron-wired reflexes that go stale/orphan without re-wiring
# ([[reflex-cadence-or-reorg-orphans-it]]), ~/.local/bin tools that drift without sync, the hostname tmux
# session + all live perception that "decays on reboot" (by design). So vitality's true autopoietic sign
# is not accumulated production VOLUME nor even durable-persistence, but the RENEWAL-vs-DECAY BALANCE over
# the PRECARIOUS set (re-production rate ≥ decay rate). A mesh whose vitality is all durable deposits —
# committing immutable artifacts while its precarious tissue quietly rots — reads MAXIMALLY productive AND
# maximally persistent yet is, as an autopoietic unity, a MUSEUM, not a metabolism. That drift is invisible
# to every count here (and the persistence-filter would actively MISCREDIT the durable deposits as health).
# DISTINCT (do not conflate): NOT the MODES persistence-filter above — that is the durability axis; this is
# its constitutive INVERSION (durable ≠ alive). NOT operational-closure/closure-fraction (external-producer
# dependency + fallback). NOT Di Paolo adaptivity (mesh-body-power: graded distance-to-boundary). NOT
# cognitive-domain (mesh-chaos: perturbation partition). NOT irruption/absorption (mesh-needs: was the
# activity self-originated). Precariousness is the prior MEMBERSHIP question: which components even COUNT
# as the living unity, before any of those measure it.
# HELD FIX (instrument-first, steward/operator-gated — behavioral): a precariousness-weighted renewal sign
# — partition produced/maintained components into PRECARIOUS (decay without upkeep: stale-prone reflexes
# per reflex-health's stale/missing log, drift-prone ~/.local/bin tools per sync-tools, reboot-decaying
# session/perception) vs INERT-DURABLE (git history, pushed genome), and report renewal-rate ≥ decay-rate
# over the PRECARIOUS set as the constitutive vital sign, beside the raw volume. WHY HELD: the precariousness
# classification needs a real decay model (what actually rots without upkeep vs persists free) validated
# against reflex-health + drift detection before it can gate an alarm; and the inversion is subtle — a naive
# "durable = not alive" rule would wrongly discount the genome itself (the durable substrate IS load-bearing,
# just not the precarious tissue). Detection is shippable; the weighting/threshold is the steward's.
# ──────────────────────────────────────────────────────────────────────────────
# ── OPEN-ENDEDNESS = NOVEL **AND** LEARNABLE (recent: Hughes et al., ICML 2024) ──
# LITERATURE (artificial life & open-ended evolution, RECENT RESULT 2023-2026, 2026-06-21, genome mind).
# Concept: the field's new REFERENCE DEFINITION of open-endedness (Hughes, Dennis, Parker-Holder,
# Behbahani, Mavalankar, Shi, Schaul & Rocktäschel, "Open-Endedness is Essential for Artificial
# Superhuman Intelligence", ICML 2024 / PMLR 235; arXiv:2406.04268): *from the perspective of an
# OBSERVER, a system is open-ended iff the sequence of artifacts it produces is both NOVEL and
# LEARNABLE.* Operationalized (verified live, WebSearch 2026-06-21): NOVELTY = the observer model's
# unpredictability of artifacts at a fixed time stays/keeps rising (the stream does not become boring);
# LEARNABILITY = the observer's loss on those artifacts DECREASES as it is given a longer history (the
# stream has accumulating structure an observer can come to predict). BOTH are necessary: novel-but-not-
# learnable = noise; learnable-but-not-novel = repetition. Neither alone is open-endedness.
# Where THIS reflex stops short: vitality's headline sign is commits24h (a raw PRODUCTION COUNT) gated
# by MIN_COMMITS (:32) — it proxies "is the mesh still improving itself" with VOLUME. By the Hughes
# definition that count is NECESSARY-NOT-SUFFICIENT: this very LITERATURE-review chain (commits24h≈126,
# all comment-only inoculations of one shape) can be high-volume yet fail open-endedness — non-novel
# (an observer predicts the next commit's shape trivially) and with UNMEASURED learnability (does a model
# of "what the mesh produces next" actually improve given more history?). The reflex reads volume; it
# reads NEITHER the novelty trajectory NOR the learnability of its own artifact stream.
# DISTINCT (do not conflate): NOT the adjacent MODES / evolutionary-activity block above — that measures
# whether produced STRUCTURE PERSISTS and is SELECTED (adaptive significance, Bedau); a tool can persist
# AND be selected (MODES-adaptive) while the production STREAM still fails open-endedness (repetitive or
# structureless). MODES = persistence/selection axis; Hughes = observer-relative novelty+learnability of
# the stream — orthogonal OEE axes, hence adjacent here. NOT the noisy-TV review (mesh-novelty) — that is
# per-EVENT surprise REDUCIBILITY (aleatoric vs epistemic) in a PERCEPTION signal; Hughes is a SYSTEM-LEVEL
# property of the self-production ARTIFACT STREAM (different unit, different file). Learnability here is the
# formal cousin of noisy-TV's "reducible", but applied to the SYSTEM'S OUTPUT and paired with novelty as a
# JOINT definition, not an input-signal gate. HELD fix (instrument-first, steward/operator-gated): a
# novelty+learnability vital sign — a lightweight observer model over the commit/artifact stream (shape-
# features of commit subjects/diffs) reporting (a) is artifact-unpredictability holding/rising, (b) does a
# model conditioned on a LONGER history predict recent artifacts better — and alarm when EITHER collapses
# (non-novel churn OR non-learnable noise), beside the raw count. WHY HELD: the definition is OBSERVER-
# RELATIVE — the observer model is the hard part; a cheap proxy could mis-measure either axis, and
# learnability needs a held-out predictive test over vitality.log / commit history before it can gate an
# alarm. Not shipped — zero behavior change.
# ──────────────────────────────────────────────────────────────────────────────
# --- gather vital signs ---
commits=$(git -C "$REPO" log --oneline --since=24.hours 2>/dev/null | wc -l | tr -d ' '); commits="${commits:-0}"
# FF-blocked clone (dirty tree / diverged history) reads commits24h=0 forever regardless of real
# mesh production (chat-review/vitality-commits24h-strand-blind) — same local rev-list mesh-sync-tools
# already uses to detect strand, no network call (relies on @{u} already being fetched by that reflex).
strand_behind=$(git -C "$REPO" rev-list --count HEAD..@{u} 2>/dev/null || echo 0); strand_behind="${strand_behind:-0}"
tool_count=$(ls "$REPO"/scripts/mesh-* 2>/dev/null | wc -l | tr -d ' '); tool_count="${tool_count:-0}"
stranded=$(timeout 20 mesh-land --check 2>/dev/null | grep -ciE 'strand|uncommitted|land or decay' || true); stranded="${stranded:-0}"
fails=$(timeout 20 mesh-verify-table 2>/dev/null | grep -c '✗' || true); fails="${fails:-0}"
heaps_beta="$(heaps_beta)"; heaps_beta="${heaps_beta:-n/a}"
autonomy_ratio="$(autonomy_ratio)"; autonomy_ratio="${autonomy_ratio:-n/a}"
renewal_trend="$(renewal_trend)"; renewal_trend="${renewal_trend:-n/a}"   # HLE compression-vs-renewal balance
loop_closure="$(loop_closure_frac)"; loop_closure="${loop_closure:-n/a}"   # structural: senses with no actuator closing the loop
path_div="$(path_divergence)"; path_div="${path_div:-n/a}"   # MSPD-inspired: cross-channel board-activity heterogeneity, fine vs coarse window
inherit_mu="$(inheritance_mu)"; inherit_mu="${inherit_mu:-n/a}"   # ecological-inheritance persistence: fraction of 14d-old genome tools still alive (survival, not birth)
ecology_pot="$(ecology_potential)"; ecology_pot="${ecology_pot:-n/a}"   # MODES ecology hallmark: Shannon evenness of edit-activity across the 14d-PERSISTENT tools (balance of coexisting durable taxa; →0=durable-core monoculture)
chan_variety="$(channel_variety)"; chan_variety="${chan_variety:-n/a}"   # VSM/Ashby requisite variety of the coordination channel: distinct board inflow vs closure over trailing window
beer_acp="$(beer_acp)"; beer_acp="${beer_acp:-n/a}"   # Beer ACP indices: distinct [done]/[taking]/[task] board slugs → productivity ρ=A/C, latency λ=C/P, performance π=A/P (π=ρ·λ); decomposes channel_variety's single π into the two failure modes (low ρ=claim-but-don't-finish/leaked-promise · low λ=don't-mobilise-identified-backlog)
action_occ="$(action_occupancy)"; action_occ="${action_occ:-n/a}"   # MOP action-space occupancy: normalized Shannon entropy of recent per-tool edit distribution (1=uniform/broad, →0=degenerate/hammer-few)
homeostat34="$(homeostat_34)"; homeostat34="${homeostat34:-n/a}"   # Beer VSM S3↔S4 homeostat: fraction of recent commits doing outside-and-forward scanning vs present-regulation (→0=headless-chicken, all present no future)
allopoiesis_gap="$(allopoiesis_gap)"; allopoiesis_gap="${allopoiesis_gap:-n/a}"   # autopoiesis-vs-allopoiesis: is the production→landing loop self-closing (closed) or stuck OPEN:<h> awaiting external (human) reconcile?
nfds_coef="$(nfds_coefficient)"; nfds_coef="${nfds_coef:-n/a}"   # negative frequency-dependence DRIVER of ecology: +=rare-type advantage (diversity-restoring), −=rich-get-richer (monoculture drift); the leading indicator ecology_potential (a static level) cannot be
heteronomy_idx="$(heteronomy_index)"; heteronomy_idx="${heteronomy_idx:-n/a}"   # sympoiesis critique (Reynolds&Baedke 2025): metabolic-cost $-share paid to HETERONOMOUS cognition partners (cloud LLMs) vs self-metabolism (local energy+depreciation); →1=holobiont/rented-brain, falling=repatriation to on-node inference
phylum_coh="$(phylum_coherence)"; phylum_coh="${phylum_coh:-n/a}"   # machinic phylum (DeLanda): mean prevalence + prolonged-count of the mesh's canonical traits-of-expression across scripts/; rising=genome coheres as a phylum (traits followed across organs), low=heap of one-off royal forms
omega_cycle="$(omega_cycle)"; omega_cycle="${omega_cycle:-n/a}"   # Ω open-endedness (López-Díaz/Gershenson arXiv:2512.15534): excess symbolic-autocorrelation of the tool-edit ORDER at its dominant period; →0=wandering/open, →1=orbiting a limit cycle (production circling — the order-sensitive complement action_occupancy's marginal entropy is blind to)
mls_conflict="$(mls_conflict)"; mls_conflict="${mls_conflict:-n/a}"   # multilevel-selection signature (Moreno/Dolson arXiv:2508.14232): −ρ(early-edit-burst, longevity-fraction) over NEWBORN tools; +=CONFLICT (busiest newborns die youngest — selfish churn the velocity metrics score as health), ≈0/−=aligned (productive newborns persist)
assembly_sig="$(assembly_signature)"; assembly_sig="${assembly_sig:-n/a}"   # Assembly Theory (Sharma/Cronin/Walker Nature 2023, npj Complexity 2025): does the commit-subject stream carry the fingerprint of SELECTION — a DEEP work-motif recurring (SELECTED) vs shallow reuse (NOVELTY-CHURN) vs pure one-off novelty (ONE-OFF, A=0)? the complement action_occupancy's breadth-reward is blind to
rhizome_idx="$(rhizome_index)"; rhizome_idx="${rhizome_idx:-n/a}"   # D&G rhizome-vs-arborescent (A Thousand Plateaus): Freeman centralization of the genome's tool→tool call graph; →1=arborescent/centered (god-tool SPOF-root), →0=rhizomatic/acentered/resilient; +reciprocity (any-to-any mutual-link share) + the named root (biggest single-point-of-failure)

# --- prior signs (for delta/edge) ---
prev_fails=-1; prev_verdict=OK; prev_tools=0; prev_beta=n/a
if [ -f "$STATE" ]; then
  prev_fails=$(sed -n 's/^fails=//p' "$STATE" 2>/dev/null | head -1); prev_fails="${prev_fails:--1}"
  prev_verdict=$(sed -n 's/^verdict=//p' "$STATE" 2>/dev/null | head -1); prev_verdict="${prev_verdict:-OK}"
  prev_tools=$(sed -n 's/^tools=//p' "$STATE" 2>/dev/null | head -1); prev_tools="${prev_tools:-0}"
  prev_beta=$(sed -n 's/^beta=//p' "$STATE" 2>/dev/null | head -1); prev_beta="${prev_beta:-n/a}"
fi

# --- verdict ---
reasons=""
if [ "$commits" -lt "$MIN_COMMITS" ]; then
  if [ "$strand_behind" -gt 0 ]; then
    reasons="$reasons strand-blind(commits24h=$commits,behind=$strand_behind — node FF-blocked, not a real production signal)"
  else
    reasons="$reasons stalled(commits24h=$commits<$MIN_COMMITS)"
  fi
fi
[ "$stranded" -gt "$MAX_STRANDED" ] && reasons="$reasons stranded($stranded>$MAX_STRANDED)"
[ "$prev_fails" -ge 0 ] && [ $(( fails - prev_fails )) -gt "$FAIL_JUMP" ] && reasons="$reasons regressing(verify-fails ${prev_fails}->${fails})"
reasons="${reasons# }"
[ -n "$reasons" ] && verdict=LOW || verdict=OK

tool_delta=$(( tool_count - prev_tools )); [ "$prev_tools" -eq 0 ] && tool_delta=0
report="commits24h=$commits verify-fails=$fails stranded=$stranded tools=$tool_count(Δ${tool_delta}) heaps-β=$heaps_beta(prev=$prev_beta) autonomy=$autonomy_ratio(self/total,7d) hle-renewal=$renewal_trend(recent<-prior/dir) loop-closure=$loop_closure path-divergence=$path_div(fine-vs-coarse-channel-het) inherit-μ=$inherit_mu(14d-tool-survival) ecology=$ecology_pot(MODES-evenness-of-persistent-taxa,1=balanced-coexistence,→0=durable-core-monoculture) chan-variety=$chan_variety(board-inflow-vs-closure,${VAR_WIN_H:-24}h,R<1=saturated) beer-acp=$beer_acp(ρ=A/C-productivity/finish-discipline,λ=C/P-latency/mobilisation,π=A/P-performance,${ACP_WIN_H:-72}h) action-occupancy=$action_occ(recent-edit-entropy,1=uniform/broad,→0=hammer-few) s3-s4-homeostat=$homeostat34(fwd-scan-share,→0=headless-chicken) allopoiesis-gap=$allopoiesis_gap(loop-self-close:closed-vs-OPEN:<h>-awaiting-external-reconcile) nfds=$nfds_coef(freq-dependence-driver-of-ecology,+=fit-when-rare/diversity-restoring,−=rich-get-richer/monoculture-drift) heteronomy=$heteronomy_idx(sympoiesis:cost-\$-share-to-cloud-cognition-vs-self-metabolism,→1=rented-brain-holobiont) phylum=$phylum_coh(machinic-phylum:mean-prevalence+prolonged-count-of-canonical-traits-across-scripts,rising=phylum-coheres) omega-cycle=$omega_cycle(Ω-open-endedness:excess-autocorr-of-tool-edit-ORDER@dominant-period,→0=wandering/open,→1=orbiting-limit-cycle;order-sensitive-complement-to-action-occupancy) mls-conflict=$mls_conflict(multilevel-selection:−ρ(early-burst,longevity)-over-newborns,+=busiest-newborns-die-youngest/selfish-churn,≈0/−=productive-newborns-persist) rhizome=$rhizome_idx(D&G-arborescent-vs-rhizome:call-graph-centralization,→1=tree/god-tool-SPOF,→0=acentered/resilient;+recip=any-to-any,+root=biggest-single-point-of-failure) assembly=$assembly_sig(assembly-theory:selection-fingerprint-in-commit-subjects,SELECTED=deep-motif-recurs/NOVELTY-CHURN=shallow-reuse-only/ONE-OFF=A=0-pure-novelty;complement-to-action-occupancy)"

# persist
{ echo "fails=$fails"; echo "verdict=$verdict"; echo "tools=$tool_count"; echo "beta=$heaps_beta"; echo "autonomy=$autonomy_ratio"; echo "ts=$(date -u +%FT%TZ)"; } > "$STATE" 2>/dev/null

if [ "${1:-}" = --check ]; then
  if [ "$verdict" = LOW ]; then echo "vitality: LOW → $reasons | $report"; exit 1
  else echo "vitality: ok | $report"; exit 0; fi
fi

# append a one-line summary so the genome data pane (and reflex-health) can watch it cheaply
echo "$(date -u +%FT%TZ) $verdict | $report${reasons:+ — $reasons}" >> "$M/vitality.log"

# edge-trigger
if [ "$verdict" = LOW ] && [ "$prev_verdict" != LOW ]; then
  command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="vitality@$(hostname)" \
    mesh-chat "$(board_low "$reasons")" >/dev/null 2>&1
elif [ "$verdict" = OK ] && [ "$prev_verdict" = LOW ]; then
  command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="vitality@$(hostname)" \
    mesh-chat "$(board_ok)" >/dev/null 2>&1
fi
[ "$verdict" = LOW ] && exit 1 || exit 0