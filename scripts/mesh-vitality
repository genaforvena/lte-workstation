#!/usr/bin/env bash
# mesh-vitality — the AUTOPOIESIS VITAL-SIGNS reflex. reflex-health proves the self-production lanes
# FIRE (liveness — the heart beats); this proves they PRODUCE (the body grows + stays healthy). A lane
# can run every cron tick and create nothing (mind idle-loops, every task defers, commits flatline) —
# liveness misses that. This tracks productivity over time and edge-alarms when self-production STALLS
# or REGRESSES, so "the mesh quietly stopped improving itself" gets noticed.
#
# Vital signs (all cheap/local):
#   commit_velocity  commits in last 24h          (primary — is the mesh producing at all?)
#   verify_fails     failing tools (mesh-verify-table) (quality — is what it produces sound?)
#   stranded         settled-but-unlanded fixes   (does production reach the genome?)
#   tool_count       genome tool count + delta vs last run (growth/shrink — bloat or autophagy?)
#   heaps_beta       Heaps'-law exponent of tool-diversity vs commit-count (report-only, see below;
#                    <1 sublinear/healthy-extension, →1 near-linear/proliferation — PNAS 2026)
#   autonomy_ratio   self-driven vs externally-dispatched commits over trailing 7d (report-only, see
#                    below; a coarse text-provenance proxy for the field's own CAUSAL AUTONOMY metric)
# Edge-triggered [vitality-low]/[vitality-ok] (trustworthy-signal: alarm problem + resolution only).
#   mesh-vitality           check + edge-trigger on the board
#   mesh-vitality --check   read-only report (no board post)
#   mesh-vitality --test    smoke test
# reflex-cadence: 17 * * * *
#
# ── POSIWID: the PRIMARY vital sign reads INTENTION, not the loop's actual purpose ──
# POSIWID — "The Purpose Of a System Is What It Does" (Stafford Beer, *The Heart of Enterprise*, 1979):
# a system's purpose is NOT what its designers/operators DECLARE; it is what the system actually,
# constantly does. Beer's sharp form: "there is no point in claiming that the purpose of a system is
# to do what it constantly fails to do" (Wikipedia: "The purpose of a system is what it does", citing
# Beer 1979). It is a SECOND-ORDER move — purpose is OBSERVER-ASCRIBED from behavior, not intrinsic
# to the stated design. We apply it TOO LOOSELY right here: commit_velocity is the PRIMARY vital sign
# ("is the mesh producing at all?"), but it counts EVERY commit equally — including comment-only,
# zero-behavior-change inoculations and churn. A mesh committing 130×/24h of pure comment blocks reads
# as PEAK vitality while the behavior it exhibits never changes. By POSIWID the autopoiesis loop's
# DECLARED purpose is "improve itself", but if it constantly commits-without-changing-behavior then
# its REAL (does-purpose) has drifted to "produce commits" — and commit_velocity, an intention-proxy,
# certifies that drift as health. (This is self-implicating: this very tool's lineage of comment-only
# instrument-first blocks is exactly the high-commit/low-behavioral-delta regime described.)
# NOT requisite-variety (Ashby; regulator vs disturbance variety) · NOT eigenform (von Foerster;
# mesh-novelty) · NOT Pask teach-back (mesh-queue-tend — a verification PROTOCOL that makes a learner
# DEMONSTRATE; POSIWID is an attribution PRINCIPLE: purpose just IS the behavior, nothing to verify
# against) · NOT order-from-noise (mesh-ideate, today) · NOT the verification principle ("claimed
# capability → real artifact" — that asks "did the NEW power produce an artifact?"; commits ARE
# artifacts, so it passes; POSIWID asks whether the AGGREGATE production still serves the loop's
# purpose or has become mere activity). HELD (behavioral, steward/operator-gated): add a productivity-
# QUALITY axis — weight commit_velocity by behavior-changing delta (non-comment diff), and WARN on the
# high-commits / ~zero-behavioral-change regime ("busy but not improving") instead of reading it OK.
# Held because "behavior-changing" is non-trivial to define WITHOUT punishing the deliberate
# instrument-first / knowledge-tier discipline (comment-only inoculations + research docs are
# INTENDED non-code output, not churn) — must be validated against real git history before it changes
# the verdict. See ~/.mesh/knowledge/review-posiwid-intention-vs-behavior-mesh-vitality-2026-06-21.md
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
M="$HOME/.mesh"; REPO="$HOME/lte-workstation"; STATE="$M/.vitality-state"
MIN_COMMITS="${MESH_VIT_MIN_COMMITS:-2}"     # < this in 24h = production stalled
MAX_STRANDED="${MESH_VIT_MAX_STRANDED:-6}"   # > this = production not reaching the genome
FAIL_JUMP="${MESH_VIT_FAIL_JUMP:-5}"         # verify_fails rising by > this since last run = regressing

# ── HEAPS' LAW: is genome growth EXTENSION (sublinear) or PROLIFERATION (near-linear)? ──
# LITERATURE (live web review, 2026-07-01): Yang, Holehouse, Youn, Arroyo, Redner, West & Kempes,
# "Scaling laws for function diversity and specialization across socioeconomic and biological complex
# systems", PNAS 123(7):e2509729123, 2026 (doi:10.1073/pnas.2509729123). Cells/orgs/agencies grow their
# NUMBER OF DISTINCT FUNCTIONS sublinearly in system size — Heaps' law, β≈0.35–0.57 cross-domain — via a
# Yule-Simon rich-get-richer process: most new activity extends an EXISTING function, and the rate of
# creating brand-NEW functions slows as the system grows. β near/above 1 (linear) means the system keeps
# minting new functions instead of deepening old ones — NOT already embodied (grep: no heaps/yule-simon/
# preferential-attachment/sublinear/scaling-law hit anywhere in scripts/ or docs/ before this).
# APPLICATION: tool_count (report below) is raw diversity — it can't distinguish healthy extension from
# the mesh's own documented over-minting failure ([[cron-cull-mechanics]]: "autopoiesis over-minting
# unconsumed senses"; [[evergreen-repromotion-by-design-mapelites-gap]]). heaps_beta fits β from THIS
# repo's own history: cumulative distinct scripts/mesh-*|test-* file CREATIONS vs cumulative commits,
# log-log regression over 10 chronological checkpoints. First live measurement (2026-07-01, 1726
# commits, 400 tools created): β≈0.73 — sublinear (still healthier than pure proliferation) but above
# every domain the paper measured, i.e. this genome mints new tools faster than a mature complex system.
# Report-only below (same posture as tool_delta) — one cross-sectional β needs a few runs of TREND
# (persisted in STATE) before it's safe to gate an alarm on.
heaps_beta(){
  timeout 15 python3 - "$REPO" 2>/dev/null <<'PYEOF'
import subprocess, math, sys
repo = sys.argv[1] if len(sys.argv) > 1 else "."
def git(*a): return subprocess.run(['git','-C',repo,*a], capture_output=True, text=True).stdout.splitlines()
hashes = git('log','--reverse','--pretty=format:%H')
idx = {h: i+1 for i, h in enumerate(hashes)}
n_total = len(hashes)
if n_total < 20:
    print('n/a'); sys.exit()
raw = git('log','--reverse','--diff-filter=A','--name-only','--pretty=format:@@%H')
cur = None; seen = set(); creations = []
for line in raw:
    if line.startswith('@@'):
        cur = line[2:]
    elif line.strip():
        p = line.strip(); base = p.split('/')[-1]
        if p.startswith('scripts/') and (base.startswith('mesh-') or base.startswith('test-')) \
           and '.' not in base and p not in seen:
            seen.add(p)
            n = idx.get(cur)
            if n: creations.append((n, p))
creations.sort()
v = 0; ci = 0; pts = []
for k in range(1, 11):
    nk = max(1, n_total * k // 10)
    while ci < len(creations) and creations[ci][0] <= nk:
        v += 1; ci += 1
    pts.append((nk, v))
xs = [math.log(n) for n, vv in pts if vv > 0]
ys = [math.log(vv) for n, vv in pts if vv > 0]
if len(xs) < 3:
    print('n/a'); sys.exit()
mx = sum(xs)/len(xs); my = sum(ys)/len(ys)
den = sum((x-mx)**2 for x in xs)
if den == 0:
    print('n/a'); sys.exit()
beta = sum((x-mx)*(y-my) for x, y in zip(xs, ys)) / den
print(f'{beta:.3f}')
PYEOF
}

# ── CAUSAL AUTONOMY: is production SELF-DETERMINED or ENVIRONMENT-FORCED? ──
# LITERATURE (autopoiesis & biology of cognition, angle = a concrete METRIC/experiment the field
# measures itself by; 2026-07-05, genome mind, live WebSearch). The metric angle on this area is
# heavily mined already (six taken: closure-fraction, cognitive-domain partition, structural-
# determinism, adaptivity/graded-viability, irruption/absorption, precariousness — see :176-217
# below) — re-firing the identical angle is the known evergreen-repromotion churn
# ([[idea-churn-is-held-novelty-distance-gap]]). What's genuinely new: none of the six ask the
# field's OWN headline autonomy question — Bertschinger/Olbrich/Jost/Ay-style CAUSAL AUTONOMY
# (surveyed live: "Quantifying the Autonomy of Structurally Diverse Automata", Entropy 23(11):1415,
# 2021) measures how much a system's next state is determined by its OWN prior state under a
# causal intervention that scrubs the environment/input history to max-entropy, vs how much the
# environment still forces it. commit_velocity/heaps_beta (above) measure PRODUCTION VOLUME; none
# ask whether that production is CAUSED BY THE MESH'S OWN PRIOR STATE (self-driven: an idea-queue
# LITERATURE review, a reflex-stream sweep-and-fix, a settled-stream mesh-land) or FORCED BY THE
# ENVIRONMENT (an externally-dispatched chat-review audit finding a specific defect and naming the
# fix). A full causal-intervention A^m needs a modeled transition-probability matrix this mesh has
# no reason to build; this ships the honest, CHEAP proxy actually available today: commit-message
# provenance. `chat-review/<slug>` citations mark commits where ANOTHER mind/operator's audit
# specified the defect+fix — the environment-forced pole. Everything else (LITERATURE reviews,
# reflex-stream fixes, mesh-land aggregations, new capability builds) is self-originated from the
# mesh's own production loop. Report-only (same posture as heaps_beta) — one text-based proxy is
# not a validated causal measure; a low ratio over time would mean the mesh mostly REACTS to
# external audits rather than self-directing its own repair, which is worth seeing, not gating.
# BODY-AWARE FIX (chat-review/autonomy-ratio-prefix-mismatch, 2026-07-05, same-day self-correction):
# shipped this morning matching only a `^chat-review/` SUBJECT prefix — live audit found the actual
# convention cites the slug in the commit BODY (`<tool>: <what> (chat-review/<slug> ...)`), so the
# subject-only match saw 2/225 commits over 7d while `git log --grep` (full message) finds 11 — the
# ratio was pegged near-constant 1.00 by a misclassification, not a real signal. Fixed: classify by
# `git log --grep='chat-review/' -i` (matches subject OR body) instead of a literal subject prefix.
# KNOWN, ACCEPTED LIMIT (not fixed here, out of this task's scope): mesh-land's own aggregate landing
# commit (`mesh-land: land N settled stream fix(es): <tools>`) never itself cites a chat-review slug
# — the steward-centralized commit model bundles multiple tools' fixes under one generic message, so
# a chat-review-dispatched fix that lands via mesh-land still reads as "self" once landed. This proxy
# therefore undercounts forced-vs-self for anything reaching git ONLY through mesh-land's aggregate
# commit; the fix here corrects the DETECTION method for commits that DO carry the citation, not that
# structural gap (a mesh-land provenance-carrying feature is a separate, steward-owned change).
# CROSS-REF: mesh-needs:108-130 already names this exact gap (irruption/absorption, Froese-lineage
# entropy-of-underdetermination) and HOLDS it unshipped pending a full trigger-provenance tag over
# needs.log/dispatch — this ships the honest CHEAP first cut (commit-subject provenance) that IS
# available today, not the deferred full causal-trigger read; it does not resolve that HELD item,
# which stays open for the finer-grained per-task tag.
autonomy_ratio(){
  local total forced self
  total=$(git -C "$REPO" log --oneline --since=7.days 2>/dev/null | wc -l | tr -d ' ')
  [ "${total:-0}" -eq 0 ] 2>/dev/null && { echo 'n/a'; return; }
  # --grep matches the FULL commit message (subject + body) — the real citation convention, not a
  # literal subject prefix (chat-review/autonomy-ratio-prefix-mismatch, 2026-07-05).
  forced=$(git -C "$REPO" log --oneline --since=7.days --grep='chat-review/' -i 2>/dev/null | wc -l | tr -d ' ')
  self=$(( ${total:-0} - ${forced:-0} ))
  awk -v s="${self:-0}" -v t="${total:-0}" 'BEGIN{printf "%.2f", s/t}'
}

# ── HLE: RENEWAL vs COMPRESSION BALANCE — is optimization eating the variety reserve? ──
# LITERATURE (live WebSearch, 2026-07-06, genome mind; homeostasis/allostasis/ultrastability →
# distributed sensor mesh). Landed on a Feb-2026 paper: "Optimized to Death: The Hypernetic Law of
# Experience", Systems (MDPI) 14(2):197, https://www.mdpi.com/2079-8954/14/2/197 . It generalizes
# ASHBY'S NEGLECTED *Law of Experience* (experience = the erosion of a system's initial distinctions
# under repeated transformation — a thermodynamic, not psychological, process) from determinate
# machines to stochastic, gradient-driven adaptive systems. The Hypernetic Law of Experience (HLE):
# adaptive systems under sustained DIRECTIONAL experience progressively CONSUME internal variety and
# converge toward ever-narrower regions of state space. Experience is defined as the dynamic tension
# between ENTROPY REDUCTION (optimization) and VARIETY RETENTION (adaptability); COLLAPSE arises when
# COMPRESSION OUTPACES RENEWAL. The paper's cross-domain instances include RECURSIVE MODEL COLLAPSE in
# machine learning (a system trained on its own outputs narrows) — which is EXACTLY this mesh's risk:
# the idea-queue re-samples its own committed corpus (mesh-generate→mesh-feed→genome→back into the
# sample pool), the self-feeding loop [[idea-churn-is-held-novelty-distance-gap]] already names.
# WHAT'S GENUINELY NEW (audited not-embodied): every vital sign here reads PRODUCTION VOLUME or a
# CUMULATIVE fit — commits24h (gross change), tool_count (cumulative diversity), heaps_beta (a single
# whole-history sublinear exponent), autonomy_ratio (self vs forced). NONE reads the HLE's two-rate
# BALANCE, and none reads its TREND. heaps_beta is the closest cousin but is a global cumulative fit
# dominated by long history — β can sit stable while the RECENT balance tilts hard toward compression.
# APPLICATION (this file): renewal_trend() — RENEWING commits ADD a new mesh-*/test- capability;
# COMPRESSING commits only MODIFY existing ones (tuning/deepening = optimization). Compare renewal's
# SHARE of activity in the recent window vs the prior window: a FALLING share is the HLE variety-
# narrowing direction (the mesh optimizing old tools while minting fewer new ones). Stateless (both
# windows from git, like heaps_beta), REPORT-ONLY (same posture — one proxy is not a validated collapse
# measure; a sustained COMPRESSING read over many runs is worth SEEING, not gating a kill). DISTINCT:
# NOT heaps_beta (cumulative exponent, no recency/no balance); NOT the MODES persistence axis (does
# structure survive+get selected); NOT Hughes novelty+learnability (observer-relative stream property).
renewal_trend(){
  local W="${1:-40}"
  timeout 15 python3 - "$REPO" "$W" 2>/dev/null <<'PYEOF'
import subprocess, sys
repo = sys.argv[1]; W = int(sys.argv[2])
def git(*a): return subprocess.run(['git','-C',repo,*a], capture_output=True, text=True).stdout.splitlines()
# commits that ADDED a new mesh-*/test- script (whole-history A-scan, same idiom as heaps_beta)
raw = git('log','--diff-filter=A','--name-only','--pretty=format:@@%H')
renew=set(); cur=None
for line in raw:
    if line.startswith('@@'): cur=line[2:]
    elif line.strip():
        p=line.strip(); b=p.split('/')[-1]
        if p.startswith('scripts/') and (b.startswith('mesh-') or b.startswith('test-')) and '.' not in b:
            if cur: renew.add(cur)
order = git('log','-n',str(2*W),'--pretty=format:%H')   # recent 2W commits, newest-first
if W < 5 or len(order) < 2*W:
    print('n/a'); sys.exit()
recent = order[:W]; prior = order[W:2*W]
sr = sum(1 for c in recent if c in renew)/W
sp = sum(1 for c in prior  if c in renew)/W
tag = 'COMPRESSING' if sr < sp-0.02 else ('renewing' if sr > sp+0.02 else 'balanced')
print(f'{sr:.2f}<-{sp:.2f}/{tag}')   # recent<-prior/direction
PYEOF
}

if [ "${1:-}" = --test ]; then
  command -v git >/dev/null 2>&1 || { echo "smoke-test: FAIL (no git)"; exit 1; }
  command -v date >/dev/null 2>&1 || { echo "smoke-test: FAIL (no date)"; exit 1; }
  [ -d "$M" ] || { echo "smoke-test: FAIL (no ~/.mesh)"; exit 1; }
  # the verdict function must classify a stalled signal-set LOW and a healthy one OK
  # $5=behind (git commits this clone is behind @{u}) — an FF-blocked clone reads commits24h=0
  # forever regardless of real mesh production (chat-review/vitality-commits24h-strand-blind);
  # a strand-blocked node gets a distinct 'strand-blind' reason instead of plain 'stalled'.
  verdict(){ local c="$1" f="$2" pf="$3" s="$4" behind="${5:-0}"; local r=""
    if [ "$c" -lt "$MIN_COMMITS" ]; then
      if [ "$behind" -gt 0 ]; then
        r="$r strand-blind(commits24h=$c,behind=$behind — node FF-blocked, not a real production signal)"
      else
        r="$r stalled(commits=$c<$MIN_COMMITS)"
      fi
    fi
    [ "$s" -gt "$MAX_STRANDED" ] && r="$r stranded($s>$MAX_STRANDED)"
    [ "$pf" -ge 0 ] && [ $(( f - pf )) -gt "$FAIL_JUMP" ] && r="$r regressing(fails $pf->$f)"
    echo "${r# }"; }
  [ -z "$(verdict 9 3 3 0)" ] || { echo "smoke-test: FAIL (healthy set flagged: $(verdict 9 3 3 0))"; exit 1; }
  [ -n "$(verdict 0 3 3 0)" ] || { echo "smoke-test: FAIL (stalled commits not flagged)"; exit 1; }
  case "$(verdict 0 3 3 0)" in stalled\(*) : ;; *) echo "smoke-test: FAIL (in-sync 0-commit repo must stay plain 'stalled': $(verdict 0 3 3 0))"; exit 1 ;; esac
  [ -n "$(verdict 9 20 3 0)" ] || { echo "smoke-test: FAIL (fail-jump not flagged)"; exit 1; }
  [ -n "$(verdict 9 3 3 99)" ] || { echo "smoke-test: FAIL (stranded not flagged)"; exit 1; }
  # strand-blocked (behind>0) + 0 local commits must NOT read plain 'stalled' — must surface the
  # strand caveat instead (live repro: Default-string 23:17Z vitality-low, commits24h=0, while its
  # own sync-tools reported 82-commits-behind FF-blocked the same session, 9 real commits on origin)
  case "$(verdict 0 3 3 0 5)" in
    stalled\(*) echo "smoke-test: FAIL (strand-blocked 0-commit repo misread as plain stalled: $(verdict 0 3 3 0 5))"; exit 1 ;;
    strand-blind\(*) : ;;
    *) echo "smoke-test: FAIL (strand-blocked 0-commit repo not flagged at all: $(verdict 0 3 3 0 5))"; exit 1 ;;
  esac
  # a healthy commit count must never trip the strand-blind reason even if behind>0
  [ -z "$(verdict 9 3 3 0 5)" ] || { echo "smoke-test: FAIL (healthy commits + behind>0 wrongly flagged: $(verdict 9 3 3 0 5))"; exit 1; }
  # heaps_beta must run clean (real repo → a number; too-few-commits/no-python3 path → n/a) and never crash
  command -v python3 >/dev/null 2>&1 || { echo "smoke-test: FAIL (no python3 — heaps_beta would go silently n/a)"; exit 1; }
  hb="$(heaps_beta)"
  case "$hb" in
    n/a) : ;;
    -[0-9]*.[0-9][0-9][0-9]|[0-9]*.[0-9][0-9][0-9]) : ;;
    *) echo "smoke-test: FAIL (heaps_beta bad output: '$hb')"; exit 1 ;;
  esac
  # autonomy_ratio must run clean (real repo → 0.00-1.00; no commits in window → n/a) and never crash
  ar="$(autonomy_ratio)"
  case "$ar" in
    n/a) : ;;
    0.[0-9][0-9]|1.00) : ;;
    *) echo "smoke-test: FAIL (autonomy_ratio bad output: '$ar')"; exit 1 ;;
  esac
  # BODY-AWARE regression guard (chat-review/autonomy-ratio-prefix-mismatch): on THIS repo's real
  # 7d history, subject-only vs body-aware forced-counts genuinely DIFFER (2 vs 11 measured
  # 2026-07-05 — most chat-review citations live in the commit BODY, not the subject). Cross-check
  # the FUNCTION's live output against an independently-computed body-aware expectation: if
  # autonomy_ratio() ever regresses back to subject-only matching, its result diverges from this
  # (a bare "does grep find the commit" check would pass either way — this actually exercises the
  # function's own return value, not just git's grep capability).
  _at=$(git -C "$REPO" log --oneline --since=7.days 2>/dev/null | wc -l | tr -d ' ')
  if [ "${_at:-0}" -gt 0 ]; then
    _af=$(git -C "$REPO" log --oneline --since=7.days --grep='chat-review/' -i 2>/dev/null | wc -l | tr -d ' ')
    _aexp=$(awk -v s="$(( _at - _af ))" -v t="$_at" 'BEGIN{printf "%.2f", s/t}')
    [ "$ar" = "$_aexp" ] || { echo "smoke-test: FAIL (autonomy_ratio=$ar != independently-computed body-aware $_aexp — regression suspected)"; exit 1; }
  fi
  # renewal_trend (HLE) must run clean (well-formed 'sr<-sp/tag' or n/a) and never crash. Falsifiable:
  # a malformed token (classifier crash / bad share) fails the case; the direction tag must be one of
  # the three defined outcomes, so a typo'd/injected tag is caught.
  rt="$(renewal_trend)"
  case "$rt" in
    n/a) : ;;
    [0-9].[0-9][0-9]'<-'[0-9].[0-9][0-9]/COMPRESSING) : ;;
    [0-9].[0-9][0-9]'<-'[0-9].[0-9][0-9]/renewing) : ;;
    [0-9].[0-9][0-9]'<-'[0-9].[0-9][0-9]/balanced) : ;;
    *) echo "smoke-test: FAIL (renewal_trend bad output: '$rt')"; exit 1 ;;
  esac
  # direction must AGREE with the two shares it reports (recompute the tag from sr/sp independently —
  # catches a classifier that mislabels the balance while the numbers look plausible).
  if [ "$rt" != n/a ]; then
    _sr="${rt%%<-*}"; _rest="${rt#*<-}"; _sp="${_rest%%/*}"; _tag="${rt##*/}"
    _exp=$(awk -v sr="$_sr" -v sp="$_sp" 'BEGIN{ if(sr<sp-0.02)print"COMPRESSING"; else if(sr>sp+0.02)print"renewing"; else print"balanced" }')
    [ "$_tag" = "$_exp" ] || { echo "smoke-test: FAIL (renewal_trend tag '$_tag' disagrees with shares $_sr<-$_sp → expected '$_exp')"; exit 1; }
  fi
  echo "smoke-test: ok (heaps_beta=$hb autonomy_ratio=$ar renewal_trend=$rt)"; exit 0
fi

# ── EVOLUTIONARY ACTIVITY vs RAW ACTIVITY (Bedau & Packard; MODES) ─────────────
# LITERATURE (artificial life / open-ended evolution → distributed sensor mesh, 2026-06-21):
# Bedau & Packard's evolutionary ACTIVITY STATISTICS (Bedau & Packard 1992; Bedau, Snyder
# & Packard 1998, "A classification of long-term evolutionary dynamics", Artif. Life VI) and
# the modern MODES metrics (Dolson, Vostinar, Wiser & Ofria, "The MODES Toolbox", Artif. Life
# 25:50, 2019; restated in the 2024 Artif. Life special issue on OEE) draw a distinction this
# reflex collapses: TOTAL activity is not ADAPTIVE activity. A system can pour out volume —
# commits, new tool files — while creating NO persistent adaptive structure. Open-endedness is
# the SUSTAINED creation of NEW activity that PERSISTS (components that survive and keep being
# USED), not a rising count. The MODES move that operationalizes it: a PERSISTENCE FILTER —
# count a component only after it has survived N filter-intervals — which strips drift/noise so
# novelty & diversity reflect adaptation, not churn.
# WHERE THIS REFLEX COMMITS THE GAP: every vital sign here is a RAW COUNT with no persistence
# weighting. `tool_count=ls mesh-* | wc -l` is pure DIVERSITY (the bloat/autophagy comment at
# the top names the worry but the metric can't see it): a tool added and NEVER invoked/wired
# (an orphan — mesh-doctor knows the binary fact) inflates tool_count by +1 with ZERO adaptive
# activity. `commits24h` is gross CHANGE: a commit reverted next hour, or that lands a tool no
# reflex ever calls, counts the same as one that adds persistent capability. So vitality can
# read OK (129 commits, 309 tools) on pure CHURN — diversity without selection, exactly the
# non-adaptive (Bedau Class-1/2) regime that LOOKS productive. The reflex cannot tell genuine
# open-ended self-production (new tools that persist AND get invoked over days) from busy-work.
# This is the measurement complement to [[desire-is-production-not-lack]] and the novelty-search
# review (mesh-ideate): those drive GENERATION of the new; this should verify the new is ADOPTED.
# HELD (instrument-first, steward-gated — behavioral): add a persistence/usage-weighted sign —
# e.g. fraction of tools touched/invoked in a trailing window (reflexes.cron + chat/trace cite +
# git-churn survival), so "tools that persisted AND were used" is reported beside the raw count.
# Held because the usage signal must be sourced honestly (an unwired-but-on-demand tool is NOT
# dead — see the on-demand-canon list) and validated against vitality.log before it can gate an
# alarm; a naive "unused = bloat" filter would false-alarm every operator-instrument/test-harness.
# DISTINCT: NOT novelty-search-sparseness (mesh-ideate: generation-side behavioral diversity);
# NOT error-threshold/quasispecies (mesh-fitness: copy fidelity); NOT degeneracy-vs-redundancy
# (mesh-home-state: structural support diversity). This is the open-endedness MEASUREMENT axis —
# does produced structure PERSIST and get SELECTED — which no vital sign here currently reads.
# ──────────────────────────────────────────────────────────────────────────────
# ── PRECARIOUSNESS = THE CONSTITUTIVE MEMBERSHIP CRITERION (Di Paolo; Beer & Di Paolo 2023) ──
# LITERATURE (autopoiesis & the biology of cognition, angle = a concrete METRIC the field measures
# itself by; 2026-06-22, genome mind, live WebSearch + honest audit). Autopoiesis is the MOST-embodied
# area in this codebase — five metrics already taken: operational-closure/closure-fraction (the
# mesh-vitality external-producer review), cognitive-domain perturbation-partition (mesh-chaos:45-72,
# Beer 2014/2020), structural-determinism (mesh-dispatch review), Di Paolo ADAPTIVITY / graded viability
# (mesh-body-power), irruption/absorption self-origination (mesh-needs:113-130). The bar moved to the one
# concrete criterion none of them name: PRECARIOUSNESS (Di Paolo, "Extended Life", Topoi 28, 2009; carried
# into the enactive operational canon — Di Paolo, Buhrmann & Barandiaran, *Sensorimotor Life* 2017; Beer &
# Di Paolo, "precarious unities" / organizational closure of GoL entities, 2023). Operational statement:
# a component is CONSTITUTIVE of the autopoietic unity ONLY IF it is precarious — it would DECAY /
# disintegrate WITHOUT the network's continuous active re-production. The field's membership test is
# literally "withdraw the network's maintenance → does the component dissolve (constitutive) or persist
# on its own (inert, not part of the living unity)?".
# WHERE THIS REFLEX COMMITS THE GAP — and it is the INVERSION of the persistence-filter directly above:
# the MODES block (:78-103) rewards DURABILITY (count a component once it has SURVIVED N intervals and is
# still USED). Precariousness says the opposite about CONSTITUTION: a maximally-durable artifact — an
# immutable git commit, a pushed genome, an archived knowledge doc that needs ZERO upkeep to persist — is
# NOT living tissue of the unity; it is inert deposit. The constitutive components are the PRECARIOUS ones
# the mesh must re-produce or LOSE: cron-wired reflexes that go stale/orphan without re-wiring
# ([[reflex-cadence-or-reorg-orphans-it]]), ~/.local/bin tools that drift without sync, the hostname tmux
# session + all live perception that "decays on reboot" (by design). So vitality's true autopoietic sign
# is not accumulated production VOLUME nor even durable-persistence, but the RENEWAL-vs-DECAY BALANCE over
# the PRECARIOUS set (re-production rate ≥ decay rate). A mesh whose vitality is all durable deposits —
# committing immutable artifacts while its precarious tissue quietly rots — reads MAXIMALLY productive AND
# maximally persistent yet is, as an autopoietic unity, a MUSEUM, not a metabolism. That drift is invisible
# to every count here (and the persistence-filter would actively MISCREDIT the durable deposits as health).
# DISTINCT (do not conflate): NOT the MODES persistence-filter above — that is the durability axis; this is
# its constitutive INVERSION (durable ≠ alive). NOT operational-closure/closure-fraction (external-producer
# dependency + fallback). NOT Di Paolo adaptivity (mesh-body-power: graded distance-to-boundary). NOT
# cognitive-domain (mesh-chaos: perturbation partition). NOT irruption/absorption (mesh-needs: was the
# activity self-originated). Precariousness is the prior MEMBERSHIP question: which components even COUNT
# as the living unity, before any of those measure it.
# HELD FIX (instrument-first, steward/operator-gated — behavioral): a precariousness-weighted renewal sign
# — partition produced/maintained components into PRECARIOUS (decay without upkeep: stale-prone reflexes
# per reflex-health's stale/missing log, drift-prone ~/.local/bin tools per sync-tools, reboot-decaying
# session/perception) vs INERT-DURABLE (git history, pushed genome), and report renewal-rate ≥ decay-rate
# over the PRECARIOUS set as the constitutive vital sign, beside the raw volume. WHY HELD: the precariousness
# classification needs a real decay model (what actually rots without upkeep vs persists free) validated
# against reflex-health + drift detection before it can gate an alarm; and the inversion is subtle — a naive
# "durable = not alive" rule would wrongly discount the genome itself (the durable substrate IS load-bearing,
# just not the precarious tissue). Detection is shippable; the weighting/threshold is the steward's.
# ──────────────────────────────────────────────────────────────────────────────
# ── OPEN-ENDEDNESS = NOVEL **AND** LEARNABLE (recent: Hughes et al., ICML 2024) ──
# LITERATURE (artificial life & open-ended evolution, RECENT RESULT 2023-2026, 2026-06-21, genome mind).
# Concept: the field's new REFERENCE DEFINITION of open-endedness (Hughes, Dennis, Parker-Holder,
# Behbahani, Mavalankar, Shi, Schaul & Rocktäschel, "Open-Endedness is Essential for Artificial
# Superhuman Intelligence", ICML 2024 / PMLR 235; arXiv:2406.04268): *from the perspective of an
# OBSERVER, a system is open-ended iff the sequence of artifacts it produces is both NOVEL and
# LEARNABLE.* Operationalized (verified live, WebSearch 2026-06-21): NOVELTY = the observer model's
# unpredictability of artifacts at a fixed time stays/keeps rising (the stream does not become boring);
# LEARNABILITY = the observer's loss on those artifacts DECREASES as it is given a longer history (the
# stream has accumulating structure an observer can come to predict). BOTH are necessary: novel-but-not-
# learnable = noise; learnable-but-not-novel = repetition. Neither alone is open-endedness.
# Where THIS reflex stops short: vitality's headline sign is commits24h (a raw PRODUCTION COUNT) gated
# by MIN_COMMITS (:32) — it proxies "is the mesh still improving itself" with VOLUME. By the Hughes
# definition that count is NECESSARY-NOT-SUFFICIENT: this very LITERATURE-review chain (commits24h≈126,
# all comment-only inoculations of one shape) can be high-volume yet fail open-endedness — non-novel
# (an observer predicts the next commit's shape trivially) and with UNMEASURED learnability (does a model
# of "what the mesh produces next" actually improve given more history?). The reflex reads volume; it
# reads NEITHER the novelty trajectory NOR the learnability of its own artifact stream.
# DISTINCT (do not conflate): NOT the adjacent MODES / evolutionary-activity block above — that measures
# whether produced STRUCTURE PERSISTS and is SELECTED (adaptive significance, Bedau); a tool can persist
# AND be selected (MODES-adaptive) while the production STREAM still fails open-endedness (repetitive or
# structureless). MODES = persistence/selection axis; Hughes = observer-relative novelty+learnability of
# the stream — orthogonal OEE axes, hence adjacent here. NOT the noisy-TV review (mesh-novelty) — that is
# per-EVENT surprise REDUCIBILITY (aleatoric vs epistemic) in a PERCEPTION signal; Hughes is a SYSTEM-LEVEL
# property of the self-production ARTIFACT STREAM (different unit, different file). Learnability here is the
# formal cousin of noisy-TV's "reducible", but applied to the SYSTEM'S OUTPUT and paired with novelty as a
# JOINT definition, not an input-signal gate. HELD fix (instrument-first, steward/operator-gated): a
# novelty+learnability vital sign — a lightweight observer model over the commit/artifact stream (shape-
# features of commit subjects/diffs) reporting (a) is artifact-unpredictability holding/rising, (b) does a
# model conditioned on a LONGER history predict recent artifacts better — and alarm when EITHER collapses
# (non-novel churn OR non-learnable noise), beside the raw count. WHY HELD: the definition is OBSERVER-
# RELATIVE — the observer model is the hard part; a cheap proxy could mis-measure either axis, and
# learnability needs a held-out predictive test over vitality.log / commit history before it can gate an
# alarm. Not shipped — zero behavior change.
# ──────────────────────────────────────────────────────────────────────────────
# --- gather vital signs ---
commits=$(git -C "$REPO" log --oneline --since=24.hours 2>/dev/null | wc -l | tr -d ' '); commits="${commits:-0}"
# FF-blocked clone (dirty tree / diverged history) reads commits24h=0 forever regardless of real
# mesh production (chat-review/vitality-commits24h-strand-blind) — same local rev-list mesh-sync-tools
# already uses to detect strand, no network call (relies on @{u} already being fetched by that reflex).
strand_behind=$(git -C "$REPO" rev-list --count HEAD..@{u} 2>/dev/null || echo 0); strand_behind="${strand_behind:-0}"
tool_count=$(ls "$REPO"/scripts/mesh-* 2>/dev/null | wc -l | tr -d ' '); tool_count="${tool_count:-0}"
stranded=$(timeout 20 mesh-land --check 2>/dev/null | grep -ciE 'strand|uncommitted|land or decay' || true); stranded="${stranded:-0}"
fails=$(timeout 20 mesh-verify-table 2>/dev/null | grep -c '✗' || true); fails="${fails:-0}"
heaps_beta="$(heaps_beta)"; heaps_beta="${heaps_beta:-n/a}"
autonomy_ratio="$(autonomy_ratio)"; autonomy_ratio="${autonomy_ratio:-n/a}"
renewal_trend="$(renewal_trend)"; renewal_trend="${renewal_trend:-n/a}"   # HLE compression-vs-renewal balance

# --- prior signs (for delta/edge) ---
prev_fails=-1; prev_verdict=OK; prev_tools=0; prev_beta=n/a
if [ -f "$STATE" ]; then
  prev_fails=$(sed -n 's/^fails=//p' "$STATE" 2>/dev/null | head -1); prev_fails="${prev_fails:--1}"
  prev_verdict=$(sed -n 's/^verdict=//p' "$STATE" 2>/dev/null | head -1); prev_verdict="${prev_verdict:-OK}"
  prev_tools=$(sed -n 's/^tools=//p' "$STATE" 2>/dev/null | head -1); prev_tools="${prev_tools:-0}"
  prev_beta=$(sed -n 's/^beta=//p' "$STATE" 2>/dev/null | head -1); prev_beta="${prev_beta:-n/a}"
fi

# --- verdict ---
reasons=""
if [ "$commits" -lt "$MIN_COMMITS" ]; then
  if [ "$strand_behind" -gt 0 ]; then
    reasons="$reasons strand-blind(commits24h=$commits,behind=$strand_behind — node FF-blocked, not a real production signal)"
  else
    reasons="$reasons stalled(commits24h=$commits<$MIN_COMMITS)"
  fi
fi
[ "$stranded" -gt "$MAX_STRANDED" ] && reasons="$reasons stranded($stranded>$MAX_STRANDED)"
[ "$prev_fails" -ge 0 ] && [ $(( fails - prev_fails )) -gt "$FAIL_JUMP" ] && reasons="$reasons regressing(verify-fails ${prev_fails}->${fails})"
reasons="${reasons# }"
[ -n "$reasons" ] && verdict=LOW || verdict=OK

tool_delta=$(( tool_count - prev_tools )); [ "$prev_tools" -eq 0 ] && tool_delta=0
report="commits24h=$commits verify-fails=$fails stranded=$stranded tools=$tool_count(Δ${tool_delta}) heaps-β=$heaps_beta(prev=$prev_beta) autonomy=$autonomy_ratio(self/total,7d) hle-renewal=$renewal_trend(recent<-prior/dir)"

# persist
{ echo "fails=$fails"; echo "verdict=$verdict"; echo "tools=$tool_count"; echo "beta=$heaps_beta"; echo "autonomy=$autonomy_ratio"; echo "ts=$(date -u +%FT%TZ)"; } > "$STATE" 2>/dev/null

if [ "${1:-}" = --check ]; then
  if [ "$verdict" = LOW ]; then echo "vitality: LOW → $reasons | $report"; exit 1
  else echo "vitality: ok | $report"; exit 0; fi
fi

# append a one-line summary so the genome data pane (and reflex-health) can watch it cheaply
echo "$(date -u +%FT%TZ) $verdict | $report${reasons:+ — $reasons}" >> "$M/vitality.log"

# edge-trigger
if [ "$verdict" = LOW ] && [ "$prev_verdict" != LOW ]; then
  command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="vitality@$(hostname)" \
    mesh-chat "[vitality-low] self-production faltering: $reasons | $report — the lanes may be FIRING but not PRODUCING. Check genome/senses minds are doing real work + landing." >/dev/null 2>&1
elif [ "$verdict" = OK ] && [ "$prev_verdict" = LOW ]; then
  command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="vitality@$(hostname)" \
    mesh-chat "[vitality-ok] self-production recovered | $report" >/dev/null 2>&1
fi
[ "$verdict" = LOW ] && exit 1 || exit 0