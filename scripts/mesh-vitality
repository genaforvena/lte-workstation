#!/usr/bin/env bash
# mesh-vitality — the AUTOPOIESIS VITAL-SIGNS reflex. reflex-health proves the self-production lanes
# FIRE (liveness — the heart beats); this proves they PRODUCE (the body grows + stays healthy). A lane
# can run every cron tick and create nothing (mind idle-loops, every task defers, commits flatline) —
# liveness misses that. This tracks productivity over time and edge-alarms when self-production STALLS
# or REGRESSES, so "the mesh quietly stopped improving itself" gets noticed.
#
# Vital signs (all cheap/local):
#   commit_velocity  commits in last 24h          (primary — is the mesh producing at all?)
#   verify_fails     failing tools (mesh-verify-table) (quality — is what it produces sound?)
#   stranded         settled-but-unlanded fixes   (does production reach the genome?)
#   tool_count       genome tool count + delta vs last run (growth/shrink — bloat or autophagy?)
# Edge-triggered [vitality-low]/[vitality-ok] (trustworthy-signal: alarm problem + resolution only).
#   mesh-vitality           check + edge-trigger on the board
#   mesh-vitality --check   read-only report (no board post)
#   mesh-vitality --test    smoke test
# reflex-cadence: 17 * * * *
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
M="$HOME/.mesh"; REPO="$HOME/lte-workstation"; STATE="$M/.vitality-state"
MIN_COMMITS="${MESH_VIT_MIN_COMMITS:-2}"     # < this in 24h = production stalled
MAX_STRANDED="${MESH_VIT_MAX_STRANDED:-6}"   # > this = production not reaching the genome
FAIL_JUMP="${MESH_VIT_FAIL_JUMP:-5}"         # verify_fails rising by > this since last run = regressing

if [ "${1:-}" = --test ]; then
  command -v git >/dev/null 2>&1 || { echo "smoke-test: FAIL (no git)"; exit 1; }
  command -v date >/dev/null 2>&1 || { echo "smoke-test: FAIL (no date)"; exit 1; }
  [ -d "$M" ] || { echo "smoke-test: FAIL (no ~/.mesh)"; exit 1; }
  # the verdict function must classify a stalled signal-set LOW and a healthy one OK
  verdict(){ local c="$1" f="$2" pf="$3" s="$4"; local r=""
    [ "$c" -lt "$MIN_COMMITS" ] && r="$r stalled(commits=$c<$MIN_COMMITS)"
    [ "$s" -gt "$MAX_STRANDED" ] && r="$r stranded($s>$MAX_STRANDED)"
    [ "$pf" -ge 0 ] && [ $(( f - pf )) -gt "$FAIL_JUMP" ] && r="$r regressing(fails $pf->$f)"
    echo "${r# }"; }
  [ -z "$(verdict 9 3 3 0)" ] || { echo "smoke-test: FAIL (healthy set flagged: $(verdict 9 3 3 0))"; exit 1; }
  [ -n "$(verdict 0 3 3 0)" ] || { echo "smoke-test: FAIL (stalled commits not flagged)"; exit 1; }
  [ -n "$(verdict 9 20 3 0)" ] || { echo "smoke-test: FAIL (fail-jump not flagged)"; exit 1; }
  [ -n "$(verdict 9 3 3 99)" ] || { echo "smoke-test: FAIL (stranded not flagged)"; exit 1; }
  echo "smoke-test: ok"; exit 0
fi

# ── EVOLUTIONARY ACTIVITY vs RAW ACTIVITY (Bedau & Packard; MODES) ─────────────
# LITERATURE (artificial life / open-ended evolution → distributed sensor mesh, 2026-06-21):
# Bedau & Packard's evolutionary ACTIVITY STATISTICS (Bedau & Packard 1992; Bedau, Snyder
# & Packard 1998, "A classification of long-term evolutionary dynamics", Artif. Life VI) and
# the modern MODES metrics (Dolson, Vostinar, Wiser & Ofria, "The MODES Toolbox", Artif. Life
# 25:50, 2019; restated in the 2024 Artif. Life special issue on OEE) draw a distinction this
# reflex collapses: TOTAL activity is not ADAPTIVE activity. A system can pour out volume —
# commits, new tool files — while creating NO persistent adaptive structure. Open-endedness is
# the SUSTAINED creation of NEW activity that PERSISTS (components that survive and keep being
# USED), not a rising count. The MODES move that operationalizes it: a PERSISTENCE FILTER —
# count a component only after it has survived N filter-intervals — which strips drift/noise so
# novelty & diversity reflect adaptation, not churn.
# WHERE THIS REFLEX COMMITS THE GAP: every vital sign here is a RAW COUNT with no persistence
# weighting. `tool_count=ls mesh-* | wc -l` is pure DIVERSITY (the bloat/autophagy comment at
# the top names the worry but the metric can't see it): a tool added and NEVER invoked/wired
# (an orphan — mesh-doctor knows the binary fact) inflates tool_count by +1 with ZERO adaptive
# activity. `commits24h` is gross CHANGE: a commit reverted next hour, or that lands a tool no
# reflex ever calls, counts the same as one that adds persistent capability. So vitality can
# read OK (129 commits, 309 tools) on pure CHURN — diversity without selection, exactly the
# non-adaptive (Bedau Class-1/2) regime that LOOKS productive. The reflex cannot tell genuine
# open-ended self-production (new tools that persist AND get invoked over days) from busy-work.
# This is the measurement complement to [[desire-is-production-not-lack]] and the novelty-search
# review (mesh-ideate): those drive GENERATION of the new; this should verify the new is ADOPTED.
# HELD (instrument-first, steward-gated — behavioral): add a persistence/usage-weighted sign —
# e.g. fraction of tools touched/invoked in a trailing window (reflexes.cron + chat/trace cite +
# git-churn survival), so "tools that persisted AND were used" is reported beside the raw count.
# Held because the usage signal must be sourced honestly (an unwired-but-on-demand tool is NOT
# dead — see the on-demand-canon list) and validated against vitality.log before it can gate an
# alarm; a naive "unused = bloat" filter would false-alarm every operator-instrument/test-harness.
# DISTINCT: NOT novelty-search-sparseness (mesh-ideate: generation-side behavioral diversity);
# NOT error-threshold/quasispecies (mesh-fitness: copy fidelity); NOT degeneracy-vs-redundancy
# (mesh-home-state: structural support diversity). This is the open-endedness MEASUREMENT axis —
# does produced structure PERSIST and get SELECTED — which no vital sign here currently reads.
# ──────────────────────────────────────────────────────────────────────────────
# ── OPEN-ENDEDNESS = NOVEL **AND** LEARNABLE (recent: Hughes et al., ICML 2024) ──
# LITERATURE (artificial life & open-ended evolution, RECENT RESULT 2023-2026, 2026-06-21, genome mind).
# Concept: the field's new REFERENCE DEFINITION of open-endedness (Hughes, Dennis, Parker-Holder,
# Behbahani, Mavalankar, Shi, Schaul & Rocktäschel, "Open-Endedness is Essential for Artificial
# Superhuman Intelligence", ICML 2024 / PMLR 235; arXiv:2406.04268): *from the perspective of an
# OBSERVER, a system is open-ended iff the sequence of artifacts it produces is both NOVEL and
# LEARNABLE.* Operationalized (verified live, WebSearch 2026-06-21): NOVELTY = the observer model's
# unpredictability of artifacts at a fixed time stays/keeps rising (the stream does not become boring);
# LEARNABILITY = the observer's loss on those artifacts DECREASES as it is given a longer history (the
# stream has accumulating structure an observer can come to predict). BOTH are necessary: novel-but-not-
# learnable = noise; learnable-but-not-novel = repetition. Neither alone is open-endedness.
# Where THIS reflex stops short: vitality's headline sign is commits24h (a raw PRODUCTION COUNT) gated
# by MIN_COMMITS (:32) — it proxies "is the mesh still improving itself" with VOLUME. By the Hughes
# definition that count is NECESSARY-NOT-SUFFICIENT: this very LITERATURE-review chain (commits24h≈126,
# all comment-only inoculations of one shape) can be high-volume yet fail open-endedness — non-novel
# (an observer predicts the next commit's shape trivially) and with UNMEASURED learnability (does a model
# of "what the mesh produces next" actually improve given more history?). The reflex reads volume; it
# reads NEITHER the novelty trajectory NOR the learnability of its own artifact stream.
# DISTINCT (do not conflate): NOT the adjacent MODES / evolutionary-activity block above — that measures
# whether produced STRUCTURE PERSISTS and is SELECTED (adaptive significance, Bedau); a tool can persist
# AND be selected (MODES-adaptive) while the production STREAM still fails open-endedness (repetitive or
# structureless). MODES = persistence/selection axis; Hughes = observer-relative novelty+learnability of
# the stream — orthogonal OEE axes, hence adjacent here. NOT the noisy-TV review (mesh-novelty) — that is
# per-EVENT surprise REDUCIBILITY (aleatoric vs epistemic) in a PERCEPTION signal; Hughes is a SYSTEM-LEVEL
# property of the self-production ARTIFACT STREAM (different unit, different file). Learnability here is the
# formal cousin of noisy-TV's "reducible", but applied to the SYSTEM'S OUTPUT and paired with novelty as a
# JOINT definition, not an input-signal gate. HELD fix (instrument-first, steward/operator-gated): a
# novelty+learnability vital sign — a lightweight observer model over the commit/artifact stream (shape-
# features of commit subjects/diffs) reporting (a) is artifact-unpredictability holding/rising, (b) does a
# model conditioned on a LONGER history predict recent artifacts better — and alarm when EITHER collapses
# (non-novel churn OR non-learnable noise), beside the raw count. WHY HELD: the definition is OBSERVER-
# RELATIVE — the observer model is the hard part; a cheap proxy could mis-measure either axis, and
# learnability needs a held-out predictive test over vitality.log / commit history before it can gate an
# alarm. Not shipped — zero behavior change.
# ──────────────────────────────────────────────────────────────────────────────
# --- gather vital signs ---
commits=$(git -C "$REPO" log --oneline --since=24.hours 2>/dev/null | wc -l | tr -d ' '); commits="${commits:-0}"
tool_count=$(ls "$REPO"/scripts/mesh-* 2>/dev/null | wc -l | tr -d ' '); tool_count="${tool_count:-0}"
stranded=$(timeout 20 mesh-land --check 2>/dev/null | grep -ciE 'strand|uncommitted|land or decay' || true); stranded="${stranded:-0}"
fails=$(timeout 20 mesh-verify-table 2>/dev/null | grep -c '✗' || true); fails="${fails:-0}"

# --- prior signs (for delta/edge) ---
prev_fails=-1; prev_verdict=OK; prev_tools=0
if [ -f "$STATE" ]; then
  prev_fails=$(sed -n 's/^fails=//p' "$STATE" 2>/dev/null | head -1); prev_fails="${prev_fails:--1}"
  prev_verdict=$(sed -n 's/^verdict=//p' "$STATE" 2>/dev/null | head -1); prev_verdict="${prev_verdict:-OK}"
  prev_tools=$(sed -n 's/^tools=//p' "$STATE" 2>/dev/null | head -1); prev_tools="${prev_tools:-0}"
fi

# --- verdict ---
reasons=""
[ "$commits" -lt "$MIN_COMMITS" ] && reasons="$reasons stalled(commits24h=$commits<$MIN_COMMITS)"
[ "$stranded" -gt "$MAX_STRANDED" ] && reasons="$reasons stranded($stranded>$MAX_STRANDED)"
[ "$prev_fails" -ge 0 ] && [ $(( fails - prev_fails )) -gt "$FAIL_JUMP" ] && reasons="$reasons regressing(verify-fails ${prev_fails}->${fails})"
reasons="${reasons# }"
[ -n "$reasons" ] && verdict=LOW || verdict=OK

tool_delta=$(( tool_count - prev_tools )); [ "$prev_tools" -eq 0 ] && tool_delta=0
report="commits24h=$commits verify-fails=$fails stranded=$stranded tools=$tool_count(Δ${tool_delta})"

# persist
{ echo "fails=$fails"; echo "verdict=$verdict"; echo "tools=$tool_count"; echo "ts=$(date -u +%FT%TZ)"; } > "$STATE" 2>/dev/null

if [ "${1:-}" = --check ]; then
  if [ "$verdict" = LOW ]; then echo "vitality: LOW → $reasons | $report"; exit 1
  else echo "vitality: ok | $report"; exit 0; fi
fi

# append a one-line summary so the genome data pane (and reflex-health) can watch it cheaply
echo "$(date -u +%FT%TZ) $verdict | $report${reasons:+ — $reasons}" >> "$M/vitality.log"

# edge-trigger
if [ "$verdict" = LOW ] && [ "$prev_verdict" != LOW ]; then
  command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="vitality@$(hostname)" \
    mesh-chat "[vitality-low] self-production faltering: $reasons | $report — the lanes may be FIRING but not PRODUCING. Check genome/senses minds are doing real work + landing." >/dev/null 2>&1
elif [ "$verdict" = OK ] && [ "$prev_verdict" = LOW ]; then
  command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="vitality@$(hostname)" \
    mesh-chat "[vitality-ok] self-production recovered | $report" >/dev/null 2>&1
fi
[ "$verdict" = LOW ] && exit 1 || exit 0