#!/usr/bin/env bash
# reflex-cadence: 23-59/30 * * * *
# mesh-correlate — DATA-DRIVEN idea source #3 (operator 2026-06-20): mine the sensor tape
# for SURPRISING cross-stream structure and emit ONE idea-as-hypothesis to ideas-queue.
#
# Why this exists: mesh-ideate's CONNECTION/LITERATURE spaces are FINITE (~666 organ pairs,
# ~14 concepts) and WILL repeat. But the sensor data changes continuously, so mining it is an
# INEXHAUSTIBLE, GROUNDED idea source — a correlation found in REAL data is a real observation
# (a real diff in real data), not a synthetic combination. A surfaced pattern is a HYPOTHESIS;
# the mind that picks it up is the value filter (causal? spurious? useful anyway?).
# Reads ~/.mesh/sensor-tape.tsv (mesh-sensor-tape, step 0). Design: knowledge/design-correlation-miner-2026-06-20.md
#
# Two analyses, best finding emitted:
#   LIFT       — co-occurrence: when A reads x, B tends to read y, far more than chance
#                (lift = P(x,y)/(P(x)P(y)) >> 1, min support). Surfaces SURPRISING links.
#   PREDICTION — A at t predicts B at t+1, beating the majority-class baseline (objective value
#                metric: beats baseline → real finding; else discard). Operator's escalation.
#
# Honest-fusion: NOLOG/STALE/UNKNOWN tokens = no real reading → treated as MISSING (excluded from
# counts), never a fabricated value. Per-sense FAULT_TOKENS (DEGRADED/REJECTED/UNREACHABLE on the
# senses whose own writer doctrine says so) are missing too — a fault verdict is not a state, and a
# near-constant fault axis pairs cheaply with anything otherwise. Same-sensor-FAMILY pairs (shared
# inputs / known fusions) are excluded so we surface the non-obvious, not the tautological
# (light↔presence is boring).
#
#   mesh-correlate           emit ONE best finding to ideas-queue (floor-gated, like mesh-ideate)
#   mesh-correlate --lift     only the co-occurrence analysis
#   mesh-correlate --predict  only the prediction analysis
#   mesh-correlate --dry      print ALL candidate findings to stdout, do NOT append (preview)
#   mesh-correlate --list     alias for --dry
#   mesh-correlate --posture  DIAMETRIC read (over-particularization <-> apophenia): does the miner sit
#                             deaf (real structure below the emit floor) or credulous? report-only, no write
#   mesh-correlate --test     smoke test (planted correlation + family-exclusion + missing-value, no queue write)
set -uo pipefail
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
export PATH="$PATH:$HOME/.local/bin"

MESH="${MESH:-$HOME/.mesh}"
TAPE="${TAPE:-$MESH/sensor-tape.tsv}"
Q="$MESH/ideas-queue"
LOCK="$MESH/.ideas-queue.lock"
STATE="$MESH/.correlate-state"             # recently-emitted relationship keys (one/line, capped)
SEEDS="$MESH/.correlation-seeds"           # freshest empirically-coupled pairs → SEED mesh-ideate (operator 2026-06-20)
SEED_MAX="${CORRELATE_SEED_MAX:-12}"
RECENT_MAX="${CORRELATE_RECENT_MAX:-40}"
MIN_SUPPORT="${CORRELATE_MIN_SUPPORT:-8}"  # min co-occurring bins — below this it's noise
MIN_LIFT="${CORRELATE_MIN_LIFT:-1.8}"      # lift must exceed this to count as structure
PRED_MARGIN="${CORRELATE_PRED_MARGIN:-0.15}" # predictor must beat baseline by this to count
PRED_PERM="${CORRELATE_PRED_PERM:-1000}"     # permutation-null size (≥1000 so a genuine signal clears Bonferroni)
PRED_ALPHA="${CORRELATE_PRED_ALPHA:-0.05}"   # PRED emits ONLY if perm p-value < ALPHA (else overfit fluke)
PRED_MINDENS="${CORRELATE_PRED_MINDENS:-0.15}" # PRED input-DENSITY floor: a pair whose usable evidence (both
                                             # senses present) covers < this fraction of the window is
                                             # STRUCTURALLY untrustworthy (a biased slice of whenever the
                                             # sparse sense happened to be sensed) — gated BEFORE significance,
                                             # which can't catch selection bias. 0 disables.
CLOCK_GATE="${CORRELATE_CLOCK_GATE:-1}"      # LIFT clock-gate control (see occupancy_band()); 0 disables.
CLOCK_BAND_MAX="${CORRELATE_CLOCK_BAND_MAX:-12}"     # a token confined to <= this many contiguous hours is clock-gated
PRED_CLOCKBASE="${CORRELATE_PRED_CLOCKBASE:-1}"      # PRED: make the HOUR compete as a baseline predictor; 0 disables
OCCASION_GAP_H="${CORRELATE_OCCASION_GAP_H:-1}"      # LIFT: two co-occurrences less than this many hours apart are
                                                     # the SAME occasion (flap gate — see the LIFT loop). 0 disables.
REGIME_GATE="${CORRELATE_REGIME_GATE:-1}"            # LIFT regime-shift gate (see the REGIME GATE block); 0 disables.
REGIME_COVER="${CORRELATE_REGIME_COVER:-0.30}"       # a token whose FIRST reading covers < this fraction of the window
                                                     # has no history over most of it — re-measure inside its own era.
ts(){ date -u +%FT%TZ; }

recent_has(){ [ -f "$STATE" ] && grep -qxF "$1" "$STATE"; }
recent_add(){ printf '%s\n' "$1" >> "$STATE"; tail -n "$RECENT_MAX" "$STATE" > "$STATE.tmp" 2>/dev/null && mv "$STATE.tmp" "$STATE"; }

# SEED mesh-ideate (operator 2026-06-20 "связь между корреляциями и генерацией идей"): write the
# freshest empirically-coupled pair so the connection generator fuses a DATA-grounded pair, not a
# random one — the value filter moved upstream. $1=key (kind:A:B), $2=idea-text (evidence in 1st paren).
write_seed(){
  local k="$1" txt="$2" kind rest a b ev
  kind="${k%%:*}"; rest="${k#*:}"; a="${rest%%:*}"; b="${rest#*:}"
  [ -z "$a" ] || [ -z "$b" ] && return 0
  # the STAT parenthetical (not the leading "(auto, real data)") — the one with lift/samples numbers
  ev="$(printf '%s' "$txt" | grep -oE '\((lift |[0-9]+ samples)[^)]*\)' | head -1 | tr -d '()')"
  [ -z "$ev" ] && ev="$kind"
  ev="${ev#"$kind" }"                                                # drop a redundant leading "lift "
  # dedup: don't pile the same pair if it's already an unconsumed seed
  [ -f "$SEEDS" ] && grep -qF "$(printf '%s\t%s\t' "$a" "$b")" "$SEEDS" && return 0
  # SEED-LAUNDERING gate (genome 2026-06-21): also skip a relationship ALREADY emitted as a
  # CORRELATION idea (recent_has → key in .correlate-state). Without this, once mesh-ideate
  # CONSUMES the seed (pops+deletes it from $SEEDS, scripts/mesh-ideate:35-38), the line-above
  # unconsumed-seed dedup no longer matches, so the next run RE-seeds the same emitted pair →
  # mesh-ideate re-mints a CONNECTION idea under ITS OWN key namespace, bypassing this tool's
  # emit suppression. That laundered ONE spurious pair (home_state↔desk, raw-bin lift 1.01 —
  # verified SPURIOUS, board 10:12) into 4 mind-dispatches on 2026-06-21. This mirrors the emit
  # suppression on the SEED path so the two agree — a pure consistency fix, NOT a new policy:
  # a genuinely new pair is never in STATE, and STATE is RECENT_MAX-capped so a relationship
  # ages out and becomes re-seedable later (matches emit behavior, not a permanent mute).
  recent_has "$k" && return 0
  printf '%s\t%s\t%s\t%s\n' "$a" "$b" "$kind" "$ev" >> "$SEEDS"
  tail -n "$SEED_MAX" "$SEEDS" > "$SEEDS.tmp" 2>/dev/null && mv "$SEEDS.tmp" "$SEEDS"
}

# analyze <tape> -> sorted candidate findings, one per line: score<TAB>kind<TAB>key<TAB>idea-text
analyze() {
  CORR_TAPE="$1" CORR_MIN_SUPPORT="$MIN_SUPPORT" CORR_MIN_LIFT="$MIN_LIFT" \
  CORR_PRED_MARGIN="$PRED_MARGIN" CORR_PRED_PERM="$PRED_PERM" CORR_PRED_ALPHA="$PRED_ALPHA" \
  CORR_PRED_MINDENS="$PRED_MINDENS" \
  CORR_CLOCK_GATE="$CLOCK_GATE" CORR_CLOCK_BAND_MAX="$CLOCK_BAND_MAX" \
  CORR_PRED_CLOCKBASE="$PRED_CLOCKBASE" CORR_OCCASION_GAP_H="$OCCASION_GAP_H" \
  CORR_REGIME_GATE="$REGIME_GATE" CORR_REGIME_COVER="$REGIME_COVER" \
  CORR_MODE="${2:-both}" python3 - <<'PY'
import os, sys, collections, random, datetime as _dt

TAPE=os.environ["CORR_TAPE"]
MIN_SUP=int(os.environ["CORR_MIN_SUPPORT"])
MIN_LIFT=float(os.environ["CORR_MIN_LIFT"])
PRED_MARGIN=float(os.environ["CORR_PRED_MARGIN"])
PRED_PERM=int(os.environ.get("CORR_PRED_PERM","300"))
PRED_ALPHA=float(os.environ.get("CORR_PRED_ALPHA","0.05"))
PRED_MINDENS=float(os.environ.get("CORR_PRED_MINDENS","0.15"))
CLOCK_BAND_MAX=int(os.environ.get("CORR_CLOCK_BAND_MAX","12"))     # token confined to <= this many hours = clock-gated
CLOCK_BAND_COVER=float(os.environ.get("CORR_CLOCK_BAND_COVER","0.9"))
CLOCK_GATE_ON=os.environ.get("CORR_CLOCK_GATE","1")!="0"           # 0 disables (mutation-testing / A-B)
CLOCK_BASE_ON=os.environ.get("CORR_PRED_CLOCKBASE","1")!="0"       # PRED clock baseline; 0 = old two-baseline behaviour
OCCASION_GAP_H=float(os.environ.get("CORR_OCCASION_GAP_H","1"))    # LIFT flap gate: <this many hours apart = SAME occasion; 0 off
REGIME_GATE_ON=os.environ.get("CORR_REGIME_GATE","1")!="0"         # LIFT regime-shift gate; 0 disables (mutation-testing / A-B)
REGIME_COVER=float(os.environ.get("CORR_REGIME_COVER","0.30"))     # token-history coverage below which the era is re-measured
random.seed(20260621)   # FIXED seed → the significance gate is a deterministic, reproducible decision
MODE=os.environ.get("CORR_MODE","both")
NOT_A_READING={"NOLOG","STALE","UNKNOWN",""}

# FAULT_TOKENS — per-sense, NOT global (2026-07-28, correlation-body-state-presence review). DEGRADED/
# REJECTED/UNREACHABLE are sensor-side FAULT VERDICTS on the senses below, verified against each
# writer's own doctrine comment (not guessed): body-state's DEGRADED = "one or more sensors
# unreachable", REJECTED = "phone UP, key REJECTED — not offline"; activity-tempo's DEGRADED = "one or
# more signals weak/unavailable, cannot assess"; social-context's DEGRADED = "phone unreachable /
# audio unavailable, cannot assess"; perimeter's UNREACHABLE = "canary/gateway/BLE adapter down". On
# this tape body_state is 100% fault rows and social 96.7% — a near-constant pairs cheaply with
# anything (the high-base-rate inflation this tool already guards against, arriving through a door
# NOT_A_READING didn't cover). NOT a blanket DEGRADED exclude: DEGRADED can be a legitimate WORLD-STATE
# for some other sense ("the thing I sense is degraded" != "I failed to sense") — only listed here once
# a writer's own text says the token means "no reading", same evidence bar as the FAMILY dict below.
FAULT_TOKENS={
 "body_state":{"DEGRADED","REJECTED"},
 "social":{"DEGRADED"},
 "tempo":{"DEGRADED"},
 "perimeter":{"UNREACHABLE"},
}

# ── CIRCULAR INFERENCE / BELIEF REVERBERATION (Jardri & Denève, "Circular inferences in schizophrenia",
# Brain 136:3227, 2013; predictive processing & the Bayesian brain, read-only). FOUNDATIONAL idea applied
# TOO LOOSELY by the FAMILY dict below. In a hierarchical Bayesian network, descending priors and
# ascending evidence must be kept SEPARATE — if a fused belief is allowed to flow back DOWN and re-enter
# as if it were independent sensory evidence of its own input, the SAME observation is COUNTED TWICE; the
# network becomes pathologically overconfident and learns "unshakable causal relationships between
# unrelated events" (Jardri-Denève). The brain prevents this with INHIBITORY loops that exactly
# compensate the excitatory ones (a controlled E/I ratio). The FAMILY dict is mesh-correlate's
# inhibition: it tries to suppress "tautological" pairs so a correlation can't be a belief reverberating
# against itself. But it applies the principle TOO LOOSELY — it is a STATIC, COARSE, ORIGIN-based
# partition (OCC = occupancy-node fusions / PHONE = phone senses / NODE = node-level), NOT the actual
# fusion-DERIVATION graph. The gap: a derived state is fused FROM raw senses in a DIFFERENT family, and a
# cross-family ancestor pair therefore is NOT excluded — e.g. `home_state` (OCC) is computed by
# mesh-home-state FROM `body_motion`/`light`/`wifi` (all PHONE); `room_activity` (OCC) and `situation`
# (NODE) likewise fold in phone/occupancy senses. Correlating a fused node against its OWN ancestor is
# CIRCULAR BY CONSTRUCTION: the lift is high and looks "real," but it is the fused belief reverberating
# back as evidence of itself — a meaningless coincidence promoted to a trusted high-level coupling, then
# re-dispatched. VERIFIED IN THIS FILE'S OWN HISTORY: the `body_motion→room_activity` "PERFECTLY
# deterministic predictor" (see the INPUT-DENSITY FLOOR comments at the test + the p 0.070→0.047 wobble)
# was treated as a statistical fluke needing a density floor — but its DEEPER cause is circular inference
# (a node correlated with its fusion-ancestor across the coarse family boundary). DISTINCT from: the
# seed-laundering gate above (that stops RE-EMITTING an already-surfaced pair; this is not MINING a
# tautological pair at all); the home_state↔desk SPURIOUS review (a stuck-SENSOR coincidence, raw-bin
# lift ~1.01 — here the lift is genuinely HIGH yet still meaningless); eigenform (temporal self-baseline)
# and the additive-score degeneracy review (cross-axis support). It is the message-passing / SPATIAL
# double-count, not a temporal one.
# HELD (instrument-first, behavioral — NOT shipped): replace the coarse origin-FAMILY exclusion with (or
# add beside it) a DERIVATION-ANCESTRY exclusion — a small provenance edge-set {derived_state: {raw
# inputs it fuses}} (home_state←{body_motion,light,wifi,ambient}, room_activity←{…}, situation←{…}) drawn
# from each fusion tool's actual inputs; exclude a pair when one sense is a derivation-ancestor of the
# other, REGARDLESS of family. Held because the edge-set must be read from the fusion tools' real inputs
# (drift-prone if hand-maintained) and because over-broad ancestry exclusion could mute a genuine
# common-cause coupling that is NOT definitional — validate against ~/.mesh/sensor-tape.tsv first. Same
# instrument-before-actuator discipline as this session's other reviews.
# ── EMPOWERMENT (LITERATURE, information theory of agency — HELD, not shipped, read-only marker):
# review-empowerment-metric-2026-06-20.md proposed the still-unbuilt actuator-side companion to this
# tool's sense-side analyses — ℰ(s)=max_p(a|s) I(A_T;S_T|s), the channel capacity from the mesh's own
# actuator firings to the sensor changes they cause, computed the same way as this tool's PREDICTION
# analysis (I(fired_A_at_t; ΔS_at_{t+1})) but sourced from an actuator-firing record the sensor tape
# doesn't have yet. That proposal never specified WHICH kind of channel to measure, and the distinction
# matters: Tiomkin, Salge & Polani, "Process empowerment for robust intrinsic motivation", J. Phys.
# Complexity 6 035011 (2025), doi:10.1088/2632-072X/adf2ec, reformulates classical empowerment's OPEN-LOOP action sequence
# A={a1,...,aT} (a plan committed to upfront) as a CLOSED-LOOP one A={π(s1),...,π(sT)} — each action
# conditioned on the state actually OBSERVED at that step, not a fixed script — because a real
# controller reacts mid-sequence, and an open-loop channel-capacity estimate collapses under exactly
# the perturbations a closed-loop policy is robust to.
# THIS MESH IS ALMOST ENTIRELY CLOSED-LOOP (every reflex here reacts to freshly-read state, never
# executes a blind fixed script) — e.g. scripts/mesh-channel-keepalive's shed→diagnose-banner→
# relaunch-or-quota-fallback chain picks its relaunch action FROM the banner it observes after
# shedding, not from a predetermined plan. If the eventual actuator-empowerment metric measures such a
# chain as a fixed open-loop sequence (input: "shed then relaunch", ignoring that WHICH relaunch was
# state-conditioned), it will systematically UNDER-credit exactly the adaptive reflexes that are
# working well BY adapting — the inverse of the paper's own robustness claim, but the same root cause:
# an open-loop measure blind to feedback the real controller used. When review-empowerment-metric's
# proposal is eventually built, any MULTI-STEP actuator chain's mutual-information estimate must
# condition on the state observed at each intermediate step, not just the initial firing + final
# outcome. Not shipped: the base actuator-empowerment metric this refines doesn't exist yet either (no
# actuator-firing record on the sensor tape) — this is a specification note for whoever builds it, not
# a standalone change. Full citation: knowledge/review-process-empowerment-closed-loop-2026-07-05.md.
# Sensor FAMILIES — pairs WITHIN a family share inputs / are known fusions → tautological, excluded.
FAMILY={
 "home_state":"OCC","household":"OCC","room_sense":"OCC","room_activity":"OCC",
 "tempo":"OCC","social":"OCC","presence":"OCC",
 "body_state":"PHONE","body_motion":"PHONE","body_power":"PHONE","wifi":"PHONE","light":"PHONE","desk":"PHONE",
 "situation":"NODE","perimeter":"NODE","psi":"NODE","ambient":"NODE",
}

rows=[]; cols=None
with open(TAPE) as f:
    for line in f:
        line=line.rstrip("\n")
        if not line or line.startswith("#"): continue
        parts=line.split("\t")
        if cols is None:
            cols=parts; continue
        if len(parts)!=len(cols): continue
        rows.append(dict(zip(cols,parts)))

senses=[c for c in (cols or []) if c!="ts"]
# real value or None (missing) — a per-sense fault verdict is missing too, not a state
def val(r,c):
    v=r.get(c,"")
    if v in NOT_A_READING: return None
    if v in FAULT_TOKENS.get(c,()): return None
    return v

# ── CLOCK-GATE control (2026-07-25) ───────────────────────────────────────────────────────────
# FOURTH verified confound class, and the only one that is STRUCTURAL rather than statistical: a
# sense whose LABEL is computed FROM the wall clock cannot be reported as correlating with any
# diurnal sense — that pairing is the sun, not structure. The instance: `light=DARK <-> ambient=
# NIGHT-QUIET`, episode-lift 2.2 / 8 episodes of 79 / 242.7h — the LIFT lane's FIRST and, over the
# full extent of ~/.mesh/correlate.log (424 runs, 2026-07-14→07-25), ONLY emitted finding.
# It is spurious BY CONSTRUCTION, readable in the producer's own source — scripts/mesh-ambient-clock:
#     if [ "$label" = "QUIET" ] && { [ "$HOUR" -ge 23 ] || [ "$HOUR" -le 5 ]; }; then label="NIGHT-QUIET"
# NIGHT-QUIET *is* QUIET ∧ (23:00–05:00). So it can only exist in 7 of 24 hours, and the light
# sensor reads DARK in those hours because of the sun. Measured on the live tape: restricted to
# that window the lift is EXACTLY 1.000 (8 of 15 episodes) — zero information beyond the clock.
# Why the obvious control does NOT work: stratifying by fixed 6h blocks leaves partial lift 1.32
# (still "surviving"), because the producer's 23–05 gate STRADDLES two blocks. A guessed strata
# width is only as good as its alignment with a gate it does not know about. So the band is read
# from the DATA instead: the narrowest contiguous circular hour window covering ~all of a token's
# readings. Self-calibrating, nothing to rot — cf. the corpus-rank rule in CLAUDE.md.
# Why this cannot suppress a genuine finding (the worry that HELD the three fixes below): inside
# the band is the ONLY place a gated token can occur at all, so a real association must show there.
# Outside it, the "co-occurrence" is both tokens being absent together — which is the clock.
def _hour(r):
    try: return _dt.datetime.fromisoformat(r["ts"].replace("Z","+00:00")).hour
    except Exception: return None

def occupancy_band(rs, col, tok, cover=CLOCK_BAND_COVER):
    """Narrowest CONTIGUOUS circular hour window holding >= cover of tok's readings.
       Returns (start_hour, width) or None when the token has no usable timestamps."""
    hrs=[h for h in (_hour(r) for r in rs if val(r,col)==tok) if h is not None]
    if not hrs: return None
    cnt=[0]*24
    for h in hrs: cnt[h]+=1
    need=cover*len(hrs); best=None
    for s in range(24):
        run=0
        for w in range(1,25):
            run+=cnt[(s+w-1)%24]
            if run>=need:
                if best is None or w<best[1]: best=(s,w)
                break
    return best

_TS_WARNED=[False]
def _rowdt(k):
    """Row k's timestamp as a datetime, or None if unparseable."""
    try:
        return _dt.datetime.fromisoformat(rows[k]["ts"].replace("Z","+00:00"))
    except Exception:
        return None

def occasions(spans):
    """Distinct OCCASIONS among (start_idx,end_idx) episode spans: consecutive spans whose
       wall-clock gap (previous END → next START) is < OCCASION_GAP_H are ONE occasion.
       Gap 0 disables (occasions == episodes). Unparseable timestamps FAIL OPEN — a
       suppression gate that silently mutes on a parse error would delete findings for a
       reason no one can see; it says so once on stderr instead."""
    if OCCASION_GAP_H<=0 or not spans: return len(spans)
    gap=_dt.timedelta(hours=OCCASION_GAP_H)
    n=0; last_end=None
    for s,e in sorted(spans):
        ts_s=_rowdt(s); ts_e=_rowdt(e)
        if ts_s is None or ts_e is None:
            if not _TS_WARNED[0]:
                print("occasion-gate: OFF for this tape — timestamps unparseable, so occasions "
                      "cannot be separated from episodes (failing OPEN, not muting)", file=sys.stderr)
                _TS_WARNED[0]=True
            return len(spans)
        if last_end is None or (ts_s-last_end)>=gap: n+=1
        last_end=ts_e
    return n

def episode_lift(rs, A, B, x, y):
    """Episode-collapsed lift of (A=x, B=y) over rs — the same measure the LIFT loop uses,
       factored so the band-restricted recomputation is the SAME arithmetic, not a lookalike."""
    seq=[(val(r,A),val(r,B)) for r in rs]
    ep=[]; prev=object()
    for p in seq:
        if p!=prev: ep.append(p)
        prev=p
    al=[(a,b) for a,b in ep if a is not None and b is not None]
    m=len(al)
    if not m: return None,0
    nxy=sum(1 for a,b in al if a==x and b==y)
    ca=sum(1 for a,b in al if a==x); cb=sum(1 for a,b in al if b==y)
    if not (nxy and ca and cb): return None,nxy
    return nxy*m/(ca*cb), nxy

# time window for the emitted idea
def window_h():
    if len(rows)<2: return 0.0
    try:
        import datetime as dt
        a=dt.datetime.fromisoformat(rows[0]["ts"].replace("Z","+00:00"))
        b=dt.datetime.fromisoformat(rows[-1]["ts"].replace("Z","+00:00"))
        return round((b-a).total_seconds()/3600.0,1)
    except Exception:
        return 0.0
W=window_h(); N=len(rows)

# ── DIAMETRIC POSTURE (read-only; MODE=posture) ─────────────────────────────────────────────────────
# LITERATURE (live review, 2026-07-29): Brett P. Andersen, Mark Miller & John Vervaeke, "Predictive
# processing and relevance realization: exploring convergent solutions to the frame problem",
# Phenomenology and the Cognitive Sciences 24:359-380 (2025; doi:10.1007/s11097-022-09850-6). RR is
# opponent processing between two OPPOSITE pathologies of relevance, named via the DIAMETRIC model of
# autism<->psychosis (Crespi & Badcock): the AUTISM pole = over-precision / hyper-PARTICULARIZATION —
# every input treated as too specific, weak central coherence, real structure filtered as noise (false
# NEGATIVES); the PSYCHOSIS pole = under-precision / hyper-COMPRESSION = APOPHENIA — pattern and meaning
# seen everywhere (false POSITIVES). Healthy RR is the dynamic BALANCE between them, not a fixed rule.
#   HOW IT BITES HERE: this tool is a heavily-engineered ANTI-APOPHENIA device — permutation null,
# Bonferroni over the pair family, five confound classes, occasion/clock/density gates, "default toward
# silence". That is the whole PSYCHOSIS-pole guard, and it is thorough. NOTHING here measures the OTHER
# pole: whether the accumulated suppression has swung the miner into hyper-particularization, where a
# real-but-moderate coupling is filtered as noise. And the two poles present the SAME SURFACE — a
# 0-finding run (over correlate.log's 424-run history, ONE finding) is AMBIGUOUS between "no structure
# exists" (correct silence) and "structure exists but sits below the floor" (over-particularization
# pathology). emit-rate / mtime CANNOT tell them apart — you must look at the effect-size distribution
# the gates are THROWING AWAY. Same shape as the hollow-sense / impasse blind spot (mesh-sensorium
# --impasse) from the RR frame-BREAKING side, here on the correlation lane. This lens reuses the LIFT
# lane's own episode-collapse + episode-lift, so it measures the real gauntlet's floor, not a re-derived
# one. DISTINCT from the in-file apophenia machinery (that is the psychosis-pole GUARD; this MEASURES
# which pole the miner sits at) and from mesh-precision's diametric NAME-drop (it cites the model as its
# own one-pole caveat; this instruments the balance on the actual pattern detector). Report-only, no
# queue write, no gate change — a mirror the miner holds up to its own posture.
if MODE=="posture":
    APO_FRAC=float(os.environ.get("CORR_APO_FRAC","0.30"))
    examined=[]; starved=0
    for i in range(len(senses)):
        for j in range(i+1,len(senses)):
            A,B=senses[i],senses[j]
            if FAMILY.get(A)==FAMILY.get(B): continue          # same family → tautological (as the LIFT lane)
            # SAME episode-collapse + episode-lift as the LIFT lane (line ~351): a persistent joint state
            # is ONE episode, so support = distinct co-occurrences, not sampled rows. A gap (None) breaks
            # a run. We take each pair's STRONGEST episode-lift = the best real coupling it carries.
            seq=[(val(r,A),val(r,B)) for r in rows]
            epis=[]; prev=object()
            for p in seq:
                if p!=prev: epis.append(p)
                prev=p
            aligned=[p for p in epis if p[0] is not None and p[1] is not None]
            M=len(aligned)
            if M<MIN_SUP:
                starved+=1; continue                            # too few episodes to assess — frame/coverage limit
            cA=collections.Counter(p[0] for p in aligned)
            cB=collections.Counter(p[1] for p in aligned)
            cAB=collections.Counter(aligned)
            best=0.0
            for (x,y),nxy in cAB.items():
                if nxy<MIN_SUP: continue
                best=max(best, nxy*M/(cA[x]*cB[y]))
            examined.append(best)
    P=len(examined)
    print("mesh-correlate posture (diametric: over-particularization <-> apophenia)")
    print(f"  cross-family pairs: {P} examined (>= {MIN_SUP} episodes), {starved} data-starved "
          f"(excluded — frame/coverage limit, NOT the diametric axis)")
    if P==0:
        print("  VERDICT: NO-DATA — no cross-family pair carries enough episodes to assess posture (honest n/a).")
        sys.exit(0)
    mx=max(examined); above=sum(1 for b in examined if b>=MIN_LIFT)
    ex=sorted(examined); p50=ex[P//2]; p90=ex[min(P-1,int(P*0.9))]
    print(f"  strongest co-occurrence lift observed: {mx:.2f} (emit floor MIN_LIFT={MIN_LIFT:.2f})")
    print(f"  pairs clearing the floor: {above}/{P} ({100.0*above/P:.0f}%)  [p50 lift {p50:.2f}, p90 {p90:.2f}]")
    if mx<MIN_LIFT:
        print("  VERDICT: OVER-PARTICULARIZED (autism pole) — the emit floor sits ABOVE the data's strongest coupling.")
        print("  LIFT-lane silence is STRUCTURAL, not absence of structure: 0-finding runs hide sub-floor "
              "couplings the gate treats as noise (false negatives). Lower CORRELATE_MIN_LIFT or gather denser data to reach them.")
        sys.exit(3)
    if above/P>=APO_FRAC:
        print("  VERDICT: APOPHENIC-LEAN (psychosis pole) — a large fraction of pairs clear the co-occurrence floor.")
        print("  The LIFT gate is permissive; the entire false-positive burden rests on the downstream "
              "confound/clock/occasion/Bonferroni guards (spurious emits if any leaks). Watch the confound gates.")
        sys.exit(4)
    print("  VERDICT: BALANCED — the co-occurrence floor sits between deaf and credulous.")
    print(f"  {above} of {P} cross-family pairs carry floor-clearing structure for the downstream guards "
          f"to adjudicate; neither structurally silent nor flooded.")
    sys.exit(0)

cands=[]  # (score, kind, key, idea)

# ---- LIFT (co-occurrence; symmetric, so unordered pairs) ----
if MODE in ("both","lift"):
    for i in range(len(senses)):
        for j in range(i+1,len(senses)):
            A,B=senses[i],senses[j]
            if FAMILY.get(A)==FAMILY.get(B): continue          # same family → tautological
            # Collapse temporal AUTOCORRELATION: a joint state that persists across many sampled
            # rows is ONE episode, not many independent co-occurrences. Count maximal runs of the
            # same (A,B) pair once (a missing-value gap also breaks a run). Support = DISTINCT
            # episodes, so MIN_SUPPORT means "co-occurred on N separate occasions" — what makes a
            # link surprising, not "one long stretch the */10 tape happened to sample N times".
            # ── FLAP / OCCASION-SEPARATION gate (2026-07-27) ─────────────────────────────────────
            # The collapse above breaks a run whenever EITHER axis changes value. So a single
            # incident in which ONE axis FLAPS manufactures arbitrarily many "distinct episodes"
            # that are NOT separate occasions — they are one event sampled through a chattering
            # sensor. MIN_SUPPORT's stated meaning ("co-occurred on N separate occasions", above)
            # is then satisfied by ONE thing happening once. VERIFIED live 2026-07-27 on the
            # body_state=REJECTED <-> presence=SOME finding (lift 1.9, "9 distinct episodes of
            # 212", window 304.7h): 8 of those 9 episodes lie inside ONE 10.8h phone-auth incident
            # (2026-07-24T20:10Z→2026-07-25T07:00Z) where body_state chattered REJECTED↔DEGRADED
            # every 20–40min; the 9th is a separate incident today. Effective support = 2, not 9,
            # and with 2 occasions no association is establishable at any lift.
            # So SUPPORT is now counted in OCCASIONS: consecutive (x,y) episodes whose wall-clock
            # gap is < OCCASION_GAP_H are ONE occasion. LIFT itself is unchanged (episode counts) —
            # this replaces only the gate, i.e. the claim "on N separate occasions".
            # Default 1h is calibrated against the live tape, both directions measured:
            #   body_state=REJECTED<->presence=SOME  10 episodes →  2 occasions  (killed: one flap)
            #   light=DARK<->ambient=NIGHT-QUIET      9 episodes →  9 occasions  (kept: 9 nights,
            #     genuinely separated — it is dropped by the CLOCK gate instead, its own class)
            # i.e. the gate distinguishes "9 nights" from "1 chatter", which is exactly its job.
            seq=[(val(r,A),val(r,B)) for r in rows]   # time-ordered, may hold None
            epis=[]; prev=object()
            for k,p in enumerate(seq):
                if p!=prev: epis.append((p,k,k))
                else: epis[-1]=(epis[-1][0],epis[-1][1],k)   # extend the run's END index
                prev=p
            aligned=[(p,s,e) for p,s,e in epis if p[0] is not None and p[1] is not None]
            M=len(aligned)
            if M<MIN_SUP: continue
            cA=collections.Counter(p[0] for p,_,_ in aligned)
            cB=collections.Counter(p[1] for p,_,_ in aligned)
            cAB=collections.Counter(p for p,_,_ in aligned)
            spans=collections.defaultdict(list)
            for p,s,e in aligned: spans[p].append((s,e))
            best=None
            for (x,y),nxy in cAB.items():
                if nxy<MIN_SUP: continue
                lift=nxy*M/(cA[x]*cB[y])
                if lift<MIN_LIFT: continue
                occ=occasions(spans[(x,y)])
                if occ<MIN_SUP:
                    # LOUD, never silent — a discarded candidate must be distinguishable from
                    # "nothing found today" (same rule as the clock-gate below).
                    print(f"occasion-gate: DROPPED {A}={x} <-> {B}={y} (lift {lift:.2f}, {nxy} episodes) "
                          f"— those episodes are only {occ} separate occasion(s) once co-occurrences "
                          f"less than {OCCASION_GAP_H:g}h apart are merged: ONE incident with a "
                          f"flapping sensor, not {nxy} independent co-occurrences", file=sys.stderr)
                    continue
                sc=lift*occ
                if best is None or sc>best[0]: best=(sc,x,y,lift,nxy,occ)
            # CAVEAT — STUCK-SENSOR / COLLAPSE-INFLATION blind spot (verified 2026-06-21, the
            # home_state=ACTIVE <-> desk=AWAY finding, episode-lift 2.2): this lift is on EPISODE
            # counts, and honest-fusion (line ~145) drops only explicit not-a-reading tokens (None) —
            # it CANNOT tell a sensor STUCK in a plausible ALLCAPS state (e.g. mesh-home-state's
            # WiFi-RSSI-RANGE false ACTIVE, ~[[review-fat-tail-range-dispersion...]] — home flips
            # ASLEEP->ACTIVE at 03:30 with body=STILL + dark and stays stuck 90min) from a real one.
            # A long stuck run collapses to ONE episode against a small M, so it weighs the SAME as a
            # genuine brief co-occurrence and pairs with whatever else is constant overnight (iMac
            # asleep -> desk=AWAY) -> a manufactured "episode" link. The tell: that finding had
            # RAW-BIN lift ~1.01 (no association) and split day-lift 0.71 vs night-lift 1.80 — the
            # whole signal was a nocturnal sensor-artifact x time-of-day confound, not structure.
            # SECOND VERIFIED INSTANCE (2026-06-21): situation=WATCH <-> presence=NONE, episode-lift 1.8
            # but RAW per-row lift only 1.26 — the same collapse-inflation tell. Two confounds stacked:
            # (a) presence=NONE is a NEAR-CONSTANT token (base rate 0.775 of 209 bins — the named-person
            # sensor rarely fires, phone often offline → conflates "no one" with "couldn't see anyone"),
            # so it pairs cheaply with anything; (b) TOD — at UTC 00-04 nearly every row is BOTH WATCH and
            # NONE (night/unattended common-cause). presence is NOT a load-bearing input to situation's
            # WATCH posture (mesh-situation: PHYSICAL is context-only) → not circular-by-construction
            # either, just confounded. Adds a DISTINCT inflation source to the held fix below: a
            # HIGH-BASE-RATE token (marginal >> 0.5), not only a STUCK one, fabricates lift — also
            # flag/down-rank a pair where one token's base rate is extreme.
            # HELD fix (instrument-first, not auto-shipped — could suppress genuine findings; validate
            # vs the seed history first): also compute the RAW-BIN lift and emit it alongside, and
            # DOWN-RANK / flag any finding where episode-lift >> raw-bin lift (collapse-driven = likely
            # a stuck/degraded input or a TOD confound); optionally time-of-day-stratify the support.
            # THIRD CONFOUND CLASS — REGIME-SHIFT / NEW-SENSE SHORT-HISTORY (verified 2026-07-08,
            # desk=AT-DESK-TYPING <-> psi=CALM, episode-lift 2.7 / 19 episodes of 274 / 436h): this one
            # does NOT show the collapse-inflation tell above — raw-bin lift (4.1) was HIGHER than
            # episode-lift (2.7), and AT-DESK-TYPING episodes span all 24h (not a TOD artifact either).
            # Root cause instead: desk's AT-DESK-TYPING state was a brand-new capability (mesh-desk-state
            # INPUT axis, added 2026-07-05) with ZERO history before that date, while mesh-psi's own
            # PHANTOM-IO QUARANTINE redefinition (landed 2026-07-03) made psi read CALM far more often
            # from 07-04 onward (CALM rate 0.39 -> 0.94, a step change in the INSTRUMENT, not the
            # hardware — traces.log shows the node still 85-97C/swap-THRASHING through 07-04, i.e.
            # genuinely stressed by mesh-stress/mesh-therm-watch AFTER psi had already shifted calm). So
            # EVERY AT-DESK-TYPING sample falls inside the post-quarantine "psi reads calmer" regime by
            # construction, while other desk states' marginals are diluted by weeks of the noisier
            # pre-quarantine era — the full-window lift measures "which token's data happens to start
            # after psi's definition changed," not any desk<->psi coupling. Restricting the comparison to
            # the SAME window AT-DESK-TYPING has data in (2026-07-05+) killed the effect: P(CALM|typing)
            # 0.902 vs P(CALM|other desk state, same window) 0.938 — essentially equal. NO LONGER HELD:
            # SHIPPED 2026-08-17 as the REGIME GATE below (a second instance, tempo=SILENT <-> ambient=
            # MODERATE, made the class recurrent and gave it a clean drop threshold) — if the winning x's
            # (or y's) FIRST timestamp covers < REGIME_COVER of the window, the episode-lift is re-measured
            # inside that token's own era and the finding is dropped when it does not survive; neither the
            # collapse-inflation tell nor a base-rate check catches this class. Full writeup:
            # knowledge/correlation-investigation-desk-attyping-psi-calm-spurious-2026-07-08.md.
            # CLOCK-GATE CONTROL (2026-07-25) — see occupancy_band() above for the full derivation.
            # If EITHER token is confined to a narrow contiguous hour band, re-run the SAME episode-lift
            # restricted to that band (the only hours the gated token can occur in). No surviving
            # association there = the finding was the clock. Drop it LOUDLY on stderr — a silently
            # discarded candidate is indistinguishable from "nothing found today" (the silent-fallback
            # rule in CLAUDE.md), and this lane's whole output is one finding per half-hour at most.
            # ── CORRECTED-LIFT CARRY (2026-08-18) ────────────────────────────────────────────
            # Both gates below RE-MEASURE the lift inside the only window where the finding can
            # be honest (the clock band / the token's own era) and decide on THAT number. Until
            # today they then THREW IT AWAY: the emit block printed the full-window `lift`, i.e.
            # the number the gate had just disqualified. Live instance that forced this
            # (room_activity=QUIET <-> desk=AWAY, emitted 2026-08-18T14:53Z): published "lift 6.0
            # — NOT a random pairing, the DATA flagged it", while the regime gate's own deciding
            # number was 1.80 against a floor of 1.80 — a 3.3x overstatement of a finding that
            # passed by 0.005. Worse, the idea text ENUMERATES the other guards applied
            # ("autocorrelation-collapsed ... occasion ..."), so the omission reads as a complete
            # provenance list and a downstream reader takes 6.0 at face value. A gate that
            # corrects a statistic must publish the CORRECTED one; the uncorrected number is
            # evidence about the confound, not about the coupling.
            # It also has to drive the SCORE — `sc=lift*occ` ranked this pair by its inflated
            # magnitude, so a regime-corrected marginal outbids honest pairs for the one emit
            # slot per run.
            # NOT fixed here, filed instead: that finding was admitted by DRIFT, not evidence —
            # over 7 logged verdicts (10:53Z→14:23Z) the episode count was PINNED at 16 while the
            # in-era lift crept 1.66→1.78 and crossed the floor at 14:53Z, because the era ENDS at
            # wallclock-now, so the corrected lift moves even when the sensors observe nothing. Any
            # pair parked near the floor is admitted eventually by waiting, and "recently emitted"
            # then blocks re-adjudication. Full derivation + the spuriousness proof (in-era lift
            # falls to 1.15 once both senses' blind tokens are excluded — the two senses share the
            # phone organ, and desk=AWAY is unreachable while the phone is down):
            # docs/correlation-investigation-room-activity-quiet-desk-away-spurious-2026-08-18.md
            # (docs/, not knowledge/ — knowledge/ is gitignored, so the two writeups cited below
            # do not land with the code and are absent from a fresh clone).
            corr=[]   # (lift, episodes, why) appended by each gate that RE-MEASURED and PASSED
            if best and CLOCK_GATE_ON:
                sc,x,y,lift,nxy,occ=best
                bands=[(b,who) for b,who in ((occupancy_band(rows,A,x),f"{A}={x}"),
                                             (occupancy_band(rows,B,y),f"{B}={y}"))
                       if b and b[1]<=CLOCK_BAND_MAX]
                if bands:
                    (s,w),who=min(bands,key=lambda t:t[0][1])
                    inband=[r for r in rows if _hour(r) is not None and ((_hour(r)-s)%24)<w]
                    l2,n2=episode_lift(inband,A,B,x,y)
                    if l2 is None or l2<MIN_LIFT:
                        print(f"clock-gate: DROPPED {A}={x} <-> {B}={y} (lift {lift:.2f}, {nxy} episodes) "
                              f"— {who} is confined to {s:02d}:00-{(s+w)%24:02d}:00 ({w}h); inside that band "
                              f"lift is {('n/a' if l2 is None else f'{l2:.2f}')} ({n2} episodes) < {MIN_LIFT} "
                              f"— time-of-day confound, not structure", file=sys.stderr)
                        best=None
                    else:
                        corr.append((l2,n2,f"re-measured inside {who}'s {s:02d}:00-{(s+w)%24:02d}:00 band"))
            # ── REGIME GATE (2026-08-17) — the THIRD confound class above, no longer HELD ──────────
            # SECOND VERIFIED INSTANCE, and the one that settled it: tempo=SILENT <-> ambient=MODERATE,
            # episode-lift 3.80 / 8 occasions / 8 episodes of 171 / 815.8h. tempo=SILENT requires
            # light=DARK (mesh-activity-tempo:467) and the light axis was PINNED UNKNOWN by an outgrown
            # gate until c71a92c (2026-08-15T05:23Z) — so SILENT was UNREACHABLE BY CONSTRUCTION for 30
            # of the window's 34 days. All 27 SILENT rows land in the last 5.7% of the tape, inside a
            # stretch where ambient happened to read MODERATE almost always (0.578 of era rows vs 0.295
            # over the full window). The lift measures WHICH REGIME THE TOKEN'S DATA STARTS IN, not any
            # coupling: restricted to the era SILENT can occur in at all, lift is EXACTLY 1.00 (8 of 9
            # episodes) — the same zero-information signature the clock gate found for NIGHT-QUIET.
            # Conditioning confirms it independently: P(MODERATE | tempo readable at all) = 0.972 vs
            # P(MODERATE | SILENT) = 0.963 → lift 0.99. Both axes are gated on the SAME phone-over-ssh
            # organ (tempo's tamper axis; ambient-clock reads presence.log from mesh-arrivals), so what
            # co-occurs is the organ answering, not the room being at rest.
            # Why this cannot suppress a genuine finding (the worry that HELD it since 2026-07-08): the
            # era begins at the token's FIRST reading — before it, the token cannot occur at all, so
            # every "co-occurrence" outside is both tokens being absent together. Identical argument to
            # the clock gate's band, on the time axis instead of the hour axis. Full derivation:
            # knowledge/correlation-investigation-tempo-silent-ambient-moderate-spurious-2026-08-17.md.
            if best and REGIME_GATE_ON:
                sc,x,y,lift,nxy,occ=best
                firsts=[]
                for col,tok in ((A,x),(B,y)):
                    ds=[d for d in (_rowdt(k) for k in range(len(rows)) if val(rows[k],col)==tok)
                        if d is not None]
                    if ds: firsts.append((min(ds),f"{col}={tok}"))
                t0=_rowdt(0); t1=_rowdt(len(rows)-1)
                span=(t1-t0).total_seconds() if (t0 and t1) else 0.0
                if len(firsts)<2 or span<=0:
                    # FAIL OPEN, loudly — a suppression gate that mutes on a parse error deletes
                    # findings for a reason nobody can see (same rule as the occasion gate).
                    print(f"regime-gate: OFF for {A}={x} <-> {B}={y} — timestamps unparseable, so a "
                          f"token's history cannot be dated (failing OPEN, not muting)", file=sys.stderr)
                else:
                    late,who=max(firsts)
                    cover=(t1-late).total_seconds()/span
                    if cover<REGIME_COVER:
                        era=[rows[k] for k in range(len(rows))
                             if (_rowdt(k) is None or _rowdt(k)>=late)]
                        l2,n2=episode_lift(era,A,B,x,y)
                        if l2 is None or l2<MIN_LIFT:
                            print(f"regime-gate: DROPPED {A}={x} <-> {B}={y} (lift {lift:.2f}, {nxy} "
                                  f"episodes) — {who} has NO history before {late.isoformat()} "
                                  f"({cover*100:.1f}% of the window); inside its own era lift is "
                                  f"{('n/a' if l2 is None else f'{l2:.2f}')} ({n2} episodes) < {MIN_LIFT} "
                                  f"— regime shift / new-sense short history, not structure", file=sys.stderr)
                            best=None
                        else:
                            corr.append((l2,n2,f"re-measured inside {who}'s own era "
                                               f"(since {late.isoformat()}, {cover*100:.1f}% of the window)"))
            if best:
                sc,x,y,lift,nxy,occ=best
                key=f"lift:{A}:{B}"
                # The LOAD-BEARING lift is the most-corrected one a gate decided on (gates run in
                # series, each narrowing to a window where the finding can be honest). Publish THAT,
                # and say what was corrected and what the uncorrected number was — a reader must be
                # able to see the gap, since it is the size of the confound.
                if corr:
                    elift,enxy,ewhy=min(corr,key=lambda c:c[0])
                    prov=(f"lift {elift:.2f} ({enxy} episodes), {ewhy} — the full-window lift is "
                          f"{lift:.1f} but that number is CONFOUNDED (it is what the gate corrected "
                          f"away); {elift:.2f} vs the {MIN_LIFT:g} floor is the whole margin this "
                          f"finding has")
                    sc=elift*occ
                else:
                    elift=lift
                    prov=f"lift {lift:.1f}, no gate had to re-measure it"
                idea=(f"CORRELATION (auto, real data): when {A} reads {x}, {B} tends to read {y} "
                      f"({prov}; {occ} distinct occasions / {nxy} episodes of {M}, window {W}h; "
                      f"autocorrelation-collapsed so a persistent run counts once, and episodes less than "
                      f"{OCCASION_GAP_H:g}h apart count as ONE occasion so a flapping sensor cannot "
                      f"manufacture support). Causal, spurious, or useful anyway? "
                      f"Investigate against reality; if a real pattern, propose a fused sense / a reflex; "
                      f"if spurious, discard with one line why.")
                cands.append((sc,"LIFT",key,idea))

# ---- PREDICTION (A at t -> B at t+1; ordered + time-shifted) ----
if MODE in ("both","predict"):
    pred_pending=[]   # (pval,acc,base,T,A,B) for every margin-passer — Bonferroni-corrected after the scan
    n_tested=0        # every cross-family pair with enough data = ONE hypothesis examined (the MC family)
    for A in senses:
        for B in senses:
            if A==B: continue
            if FAMILY.get(A)==FAMILY.get(B): continue
            samples=[]  # (a_t, b_t, b_next)
            shours=[]   # hour-of-day of each sample's t, index-aligned with samples (CLOCK baseline)
            for k in range(len(rows)-1):
                a=val(rows[k],A); bt=val(rows[k],B); bn=val(rows[k+1],B)
                if a is not None and bn is not None:
                    samples.append((a,bt,bn)); shours.append(_hour(rows[k]))
            T=len(samples)
            if T<MIN_SUP: continue
            # INPUT-DENSITY FLOOR (orthogonal to MIN_SUP and to Bonferroni): MIN_SUP is an ABSOLUTE
            # co-occurrence count and Bonferroni controls the family-wise error across pairs — NEITHER
            # asks what FRACTION of the window the evidence covers. A sense sensed in only a small slice
            # of bins (body_motion: ~13 real of ~114, the phone offline the rest) can still hit MIN_SUP
            # and even clear a significance test, yet its samples are a SELECTION-BIASED sub-window (only
            # whenever the phone was online), not a representative draw — significance can't catch that.
            # Refuse to TEST such a pair at all (so it also doesn't inflate the Bonferroni denominator):
            # its evidence covers too little of the window to trust, by design. Default-toward-silence.
            if N>1 and (T/(N-1))<PRED_MINDENS: continue
            n_tested+=1   # this pair HAD enough data to be a candidate → it counts as a hypothesis tested
            cB=collections.Counter(bn for _,_,bn in samples)
            maj=max(cB.values())/T                               # majority-class baseline
            # PERSISTENCE baseline: predict B_{t+1}=B_t (nothing changes). During a long stable run
            # this is ~100%, so a predictor that merely rides autocorrelation can't beat it. A real
            # LEADING indicator must beat the STRONGER of the two trivial predictors.
            pn=sum(1 for _,bt,_ in samples if bt is not None)
            pok=sum(1 for _,bt,bn in samples if bt is not None and bt==bn)
            pers=pok/pn if pn else 0.0
            # CLOCK baseline: predict B_{t+1} from the HOUR ALONE (same in-sample lookup form as `acc`).
            # The LIFT clock-gate above does not reach this lane, and the same confound lives here — found
            # by this tool's OWN clock-confound fixture: with the LIFT gate on, that fixture still emitted
            # "light at t predicts ambient at t+1 — 100% vs 53% baseline, perm-p 0.001" purely because
            # ambient's NIGHT-QUIET is computed FROM the hour (mesh-ambient-clock:1009). Significance
            # cannot catch it: the link IS perfectly real, it is just the clock wearing a sensor's name.
            # So make the clock COMPETE — a leading indicator must beat the hour, not merely beat chance.
            # Deliberately conservative: 24 buckets can out-resolve a 2-token predictor, so this baseline
            # errs toward SILENCE (this file's stated default) and can cost a genuine finding whose target
            # is strongly diurnal. That trade is priced against the lane's actual record — over the full
            # extent of correlate.log (424 runs, 2026-07-14→07-25) it emitted ONE finding, a clock
            # confound. CORRELATE_PRED_CLOCKBASE=0 restores the old two-baseline behaviour.
            clockb=0.0
            if CLOCK_BASE_ON and T:
                _byh=collections.defaultdict(collections.Counter)
                for _h,(_,_,_bn) in zip(shours,samples):
                    if _h is not None: _byh[_h][_bn]+=1
                _cov=sum(sum(c.values()) for c in _byh.values())
                if _cov: clockb=sum(c.most_common(1)[0][1] for c in _byh.values())/_cov
            base=max(maj,pers,clockb)
            def _lookup_acc(sm):
                by=collections.defaultdict(collections.Counter)
                for a,_,bn in sm: by[a][bn]+=1
                return sum(c.most_common(1)[0][1] for c in by.values())/len(sm)
            acc=_lookup_acc(samples)
            if acc>base+PRED_MARGIN:
                # IN-SAMPLE accuracy OVERFITS (a K-bucket lookup on few samples beats the baseline by
                # chance, the more so the fewer samples / more buckets). Per-candidate PERMUTATION p
                # (shuffle the next-state labels PRED_PERM times, recompute the SAME lookup accuracy) =
                # the chance of this acc under no real link. COLLECT it here; the MULTIPLE-COMPARISON
                # correction happens after the full scan. mesh-leadlag's lesson: scanning ~O(senses^2)
                # pairs is many lottery tickets — an uncorrected per-pair alpha=0.05 lets ~(#pairs*0.05)
                # flukes through. PROVEN here: body_motion→room_activity p wobbled 0.070→0.047 on ONE new
                # sample and slipped a per-pair gate (it is 1 of ~9 expected chance hits over 188 pairs).
                _aa=[s[0] for s in samples]; _bb=[s[1] for s in samples]; _lab=[s[2] for s in samples]
                _ge=0
                for _ in range(PRED_PERM):
                    random.shuffle(_lab)
                    if _lookup_acc(list(zip(_aa,_bb,_lab)))>=acc-1e-12: _ge+=1
                pval=(_ge+1)/(PRED_PERM+1)          # add-one unbiased estimator
                pred_pending.append((pval,acc,base,T,A,B))

    # MULTIPLE-COMPARISON correction: Bonferroni over the candidates actually permutation-tested. A
    # candidate emits only if its per-pair p clears ALPHA/(#tested) — controls the family-wise error of
    # the pair scan (the simpler conservative cousin of mesh-leadlag's global-max null). honest-empty
    # when nothing clears; a GENUINE strong predictor (p≈1/PRED_PERM) still clears even a tight threshold.
    # Bonferroni denominator = n_tested (EVERY pair we examined), NOT just the margin-passers: the
    # family-wise error comes from how many hypotheses we LOOKED at, and the margin is itself a selection
    # filter (correcting only over passers undercounts — it let body_motion→room_activity through at
    # _npred=1 → threshold back to 0.05 → emitted the p=0.047 fluke). n_tested is the honest count.
    _thr=(PRED_ALPHA/n_tested) if n_tested else PRED_ALPHA
    for pval,acc,base,T,A,B in pred_pending:
        if pval>=_thr: continue                      # not significant after correction → suppress
        sc=(acc-base)*T
        key=f"pred:{A}:{B}"
        idea=(f"PREDICTION (auto, real data): {A} at t predicts {B} at t+1 — {acc*100:.0f}% vs "
              f"{base*100:.0f}% baseline (max of majority-class + persistence; {T} samples, window "
              f"{W}h; perm-p {pval:.3f} < {_thr:.4f} Bonferroni over {n_tested} tested). Real leading "
              f"indicator or fluke? Verify it holds on fresh data; if real, worth a reflex.")
        cands.append((sc,"PRED",key,idea))

cands.sort(key=lambda c:-c[0])
for sc,kind,key,idea in cands:
    print(f"{sc:.3f}\t{kind}\t{key}\t{idea}")
PY
}

# ---------------- modes ----------------
mode="both"; append=1
case "${1:-}" in
  --lift)    mode="lift" ;;
  --predict) mode="predict" ;;
  --dry|--list) append=0 ;;
  --posture) mode="posture"; append=0 ;;   # diametric read; handled below (never reaches append path)
  --test) : ;;   # handled below
  "" ) : ;;
  *) echo "usage: mesh-correlate [--lift|--predict|--dry|--list|--posture|--test]" >&2; exit 2 ;;
esac

if [ "${1:-}" = "--test" ]; then
  command -v python3 >/dev/null 2>&1 || { echo "smoke-test: FAIL (no python3)"; exit 1; }
  _td="$(mktemp -d)"; trap 'rm -rf "$_td"' EXIT
  tp="$_td/tape.tsv"
  {
    echo "# test tape"
    printf 'ts\ttempo\tpsi\thome_state\thousehold\tlight\n'
    # 16 rows ALTERNATING so the planted cross-family link tempo=BUSTLE<->psi=STALLED recurs as
    # 8 DISTINCT EPISODES (not one persistent run) → lift = 8*16/(8*8) = 2.0 (>= MIN_LIFT 1.8) on
    # episode-collapsed counts. Alternation makes every row its own episode (no collapse here), so
    # this proves the episode counter passes a genuinely-recurring link.
    # SAME-FAMILY perfect link home_state<->household (both OCC) MUST be excluded.
    # light column is all UNKNOWN (missing) — MUST never appear in a finding.
    for n in $(seq 1 16); do
      if [ $((n % 2)) -eq 1 ]; then
        printf '2026-06-20T%02d:00:00Z\tBUSTLE\tSTALLED\tACTIVE_SOCIAL\tACTIVE\tUNKNOWN\n' "$n"
      else
        printf '2026-06-20T%02d:00:00Z\tSILENT\tCALM\tQUIET\tIDLE\tUNKNOWN\n' "$n"
      fi
    done
  } > "$tp"
  out="$(MESH="$_td" TAPE="$tp" CORRELATE_MIN_SUPPORT=8 bash "$0" --dry 2>&1)" \
    || { echo "smoke-test: FAIL (analyze errored: $out)"; exit 1; }
  echo "$out" | grep -q 'tempo' && echo "$out" | grep -qi 'BUSTLE.*STALLED\|STALLED.*BUSTLE' \
    || { echo "smoke-test: FAIL (planted tempo<->psi correlation not found: $out)"; exit 1; }
  echo "$out" | grep -qE 'home_state.*household|household.*home_state' \
    && { echo "smoke-test: FAIL (same-family home_state/household pair NOT excluded: $out)"; exit 1; }
  echo "$out" | grep -q 'light' \
    && { echo "smoke-test: FAIL (all-UNKNOWN 'light' leaked into a finding — missing-value not honored: $out)"; exit 1; }
  # below support → no finding (honest empty, not an error)
  out2="$(MESH="$_td" TAPE="$tp" CORRELATE_MIN_SUPPORT=50 bash "$0" --dry 2>&1)"
  echo "$out2" | grep -qE 'CORRELATION \(auto|PREDICTION \(auto' && { echo "smoke-test: FAIL (fired below min-support: $out2)"; exit 1; }
  # AUTOCORRELATION REGRESSION: one LONG persistent run (20 identical rows) is ONE episode, not 20.
  # Pre-fix this produced a strong spurious LIFT finding (support 20) AND a 100% "prediction"; post-fix
  # episode-collapse → support 1 (no lift) and the persistence baseline → no prediction. Must be EMPTY.
  tp2="$_td/persist.tsv"
  {
    printf 'ts\ttempo\tpsi\thome_state\thousehold\tlight\n'
    for n in $(seq 1 20); do
      printf '2026-06-20T%02d:00:00Z\tBUSTLE\tSTALLED\tACTIVE_SOCIAL\tACTIVE\tUNKNOWN\n' "$n"
    done
  } > "$tp2"
  pout="$(MESH="$_td" TAPE="$tp2" CORRELATE_MIN_SUPPORT=8 bash "$0" --dry 2>&1)"
  echo "$pout" | grep -qE 'CORRELATION \(auto|PREDICTION \(auto' \
    && { echo "smoke-test: FAIL (autocorrelation not collapsed — a single 20-row persistent run produced a finding: $pout)"; exit 1; }
  # FLAP / OCCASION-SEPARATION REGRESSION (2026-07-27, the body_state=REJECTED<->presence=SOME case).
  # The episode collapse above breaks a run whenever EITHER axis changes — so ONE incident in which
  # ONE axis FLAPS manufactures arbitrarily many "distinct episodes" with ZERO temporal separation,
  # and MIN_SUPPORT ("co-occurred on N separate occasions", line ~275) is satisfied by a single event.
  # This tape is BYTE-IDENTICAL to the positive-control tape above EXCEPT the timestamps: the same 8
  # alternating BUSTLE<->STALLED episodes, compressed from 1h spacing to 10min spacing so the whole
  # thing is ONE 2.5h incident. The correlation structure is unchanged; only the SEPARATION is gone.
  # Pre-fix both fire identically (support 8, lift 2.0) — that is the defect. Post-fix: hourly fires,
  # compressed does NOT, and the drop is announced LOUDLY on stderr (never a silent discard).
  tp5="$_td/flap.tsv"
  {
    printf 'ts\ttempo\tpsi\thome_state\thousehold\tlight\n'
    for n in $(seq 0 15); do
      _m=$((n*10)); _hh=$((_m/60)); _mm=$((_m%60))
      if [ $((n % 2)) -eq 0 ]; then
        printf '2026-06-20T%02d:%02d:00Z\tBUSTLE\tSTALLED\tACTIVE_SOCIAL\tACTIVE\tUNKNOWN\n' "$_hh" "$_mm"
      else
        printf '2026-06-20T%02d:%02d:00Z\tSILENT\tCALM\tQUIET\tIDLE\tUNKNOWN\n' "$_hh" "$_mm"
      fi
    done
  } > "$tp5"
  fl="$(MESH="$_td" TAPE="$tp5" CORRELATE_MIN_SUPPORT=8 bash "$0" --dry 2>&1)"
  echo "$fl" | grep -q 'CORRELATION (auto' \
    && { echo "smoke-test: FAIL (8 episodes inside ONE 2.5h flap counted as 8 separate occasions — occasion gate not applied: $fl)"; exit 1; }
  echo "$fl" | grep -q 'occasion-gate: DROPPED' \
    || { echo "smoke-test: FAIL (flap candidate discarded SILENTLY — a dropped candidate must be announced: $fl)"; exit 1; }
  # FALSIFIER: the gate must key on SEPARATION, not on the tape being short/dense. Same flap tape,
  # gap knob disabled → the finding MUST come back. If it stays suppressed, something else is
  # suppressing it and the test above proves nothing about the occasion gate.
  fl0="$(MESH="$_td" TAPE="$tp5" CORRELATE_MIN_SUPPORT=8 CORRELATE_OCCASION_GAP_H=0 bash "$0" --dry 2>&1)"
  echo "$fl0" | grep -q 'CORRELATION (auto' \
    || { echo "smoke-test: FAIL (occasion gate disabled and the flap finding still did not appear — the suppression above was NOT the occasion gate: $fl0)"; exit 1; }
  # REGIME-SHIFT REGRESSION (2026-08-17, the tempo=SILENT<->ambient=MODERATE case). A token with NO
  # HISTORY over most of the window pairs cheaply with whatever the recent regime happens to read: here
  # tempo=SILENT exists only in the last 20 of 100 hourly bins, and psi reads CALM through exactly that
  # stretch. Full-window episode-lift = 10*100/(10*20) = 5.0 with 10 well-separated occasions — clears
  # MIN_SUP, the occasion gate, the collapse check and any base-rate test. Inside SILENT's OWN era the
  # lift is exactly 1.00 (CALM is every episode there), i.e. zero information beyond "the token's data
  # starts in that regime". Pre-fix this fires as a finding; post-fix it is dropped LOUDLY.
  tp6="$_td/regime.tsv"
  {
    printf 'ts\ttempo\tpsi\n'
    for n in $(seq 0 99); do
      _d=$((20 + n/24)); _h=$((n%24))
      if [ "$n" -lt 80 ]; then                       # old regime: SILENT impossible, psi never CALM
        if [ $((n % 2)) -eq 0 ]; then _t=BUSTLE; else _t=RESTING; fi
        _p=STALLED
      else                                            # new regime: SILENT reachable, psi always CALM
        if [ $((n % 2)) -eq 0 ]; then _t=SILENT; else _t=RESTING; fi
        _p=CALM
      fi
      printf '2026-06-%02dT%02d:00:00Z\t%s\t%s\n' "$_d" "$_h" "$_t" "$_p"
    done
  } > "$tp6"
  rg="$(MESH="$_td" TAPE="$tp6" CORRELATE_MIN_SUPPORT=8 bash "$0" --dry 2>&1)"
  echo "$rg" | grep -q 'CORRELATION (auto' \
    && { echo "smoke-test: FAIL (a token with no history over 80% of the window produced a finding — regime gate not applied: $rg)"; exit 1; }
  echo "$rg" | grep -q 'regime-gate: DROPPED' \
    || { echo "smoke-test: FAIL (regime candidate discarded SILENTLY — a dropped candidate must be announced: $rg)"; exit 1; }
  # FALSIFIER: the gate must key on the token's HISTORY, not on the tape being synthetic. Same tape,
  # gate disabled → the finding MUST come back; if it stays suppressed the test above proves nothing.
  rg0="$(MESH="$_td" TAPE="$tp6" CORRELATE_MIN_SUPPORT=8 CORRELATE_REGIME_GATE=0 bash "$0" --dry 2>&1)"
  echo "$rg0" | grep -q 'CORRELATION (auto' \
    || { echo "smoke-test: FAIL (regime gate disabled and the finding still did not appear — the suppression above was NOT the regime gate: $rg0)"; exit 1; }
  # CORRECTED-LIFT PUBLICATION (2026-08-18) — the gates RE-MEASURE, so the re-measured number is the
  # one the finding rests on; publishing the full-window number instead overstates it by the exact size
  # of the confound the gate just removed. Live instance: room_activity=QUIET <-> desk=AWAY entered the
  # ideas-queue as "lift 6.0 ... NOT a random pairing", while the regime gate's deciding number was 1.80
  # against a 1.80 floor. Fixture: SILENT has history over only the last ~23% of the window (regime gate
  # fires) but psi=CALM tracks it INSIDE that era too, so the corrected lift (2.00) SURVIVES the floor —
  # the pass path the drop-legs above never exercise. Full-window lift is 8.3. Assert three things: the
  # published lift is the corrected one, the confounded one is disclosed AS confounded (never as "the"
  # lift), and the SCORE that wins the one emit slot per run is computed on the corrected number.
  tp7="$_td/corrected.tsv"
  {
    printf 'ts\ttempo\tpsi\n'
    for n in $(seq 0 99); do
      _d=$((20 + n/24)); _h=$((n%24))
      if [ "$n" -lt 75 ]; then                       # old regime: SILENT impossible, psi never CALM
        if [ $((n % 2)) -eq 0 ]; then _t=BUSTLE; else _t=RESTING; fi
        _p=STALLED
      else                                            # new regime: SILENT reachable AND tracked by CALM
        if [ $((n % 2)) -eq 0 ]; then _t=SILENT; _p=CALM; else _t=RESTING; _p=STALLED; fi
      fi
      printf '2026-06-%02dT%02d:00:00Z\t%s\t%s\n' "$_d" "$_h" "$_t" "$_p"
    done
  } > "$tp7"
  cl="$(MESH="$_td" TAPE="$tp7" CORRELATE_MIN_SUPPORT=8 bash "$0" --dry 2>&1)"
  echo "$cl" | grep -q 'CORRELATION (auto' \
    || { echo "smoke-test: FAIL (a regime-gated pair whose CORRECTED lift clears the floor must still emit — the gate is over-suppressing: $cl)"; exit 1; }
  echo "$cl" | grep -q 'lift 2\.00' \
    || { echo "smoke-test: FAIL (finding does not publish the gate-CORRECTED lift 2.00 — it is quoting a number no gate decided on: $cl)"; exit 1; }
  echo "$cl" | grep -qE 'lift 8\.3,' \
    && { echo "smoke-test: FAIL (finding presents the CONFOUNDED full-window lift 8.3 as its lift — that is the number the regime gate corrected away: $cl)"; exit 1; }
  echo "$cl" | grep -q 'CONFOUNDED' \
    || { echo "smoke-test: FAIL (the full-window lift is quoted without being marked confounded — a reader cannot see the gap: $cl)"; exit 1; }
  awk 'NR==1{ if ($1+0 > 30) { exit 1 } }' <<<"$cl" \
    || { echo "smoke-test: FAIL (candidate SCORED on the confounded lift — an inflated pair outbids honest ones for the one emit slot: $(head -1 <<<"$cl"))"; exit 1; }
  # INPUT-DENSITY FLOOR REGRESSION (the body_motion→room_activity structural case): a PERFECTLY
  # deterministic predictor (body_motion ∈ {MOVE,STILL} → psi STALLED/CALL at t+1) that is present in
  # only 14 of 100 bins (14% density) CLEARS MIN_SUP + margin + permutation/Bonferroni — yet its 14
  # samples are a biased slice of whenever the phone was sensed. It MUST be suppressed by the default
  # density floor, and emit ONLY when the floor is disabled (proves the gate is the deciding factor,
  # not significance). body_motion(PHONE)/psi(NODE) are cross-family so the pair isn't excluded.
  tp3="$_td/sparse.tsv"
  {
    printf 'ts\tbody_motion\tpsi\n'
    pm=0; occ=0
    for n in $(seq 1 100); do
      if [ "$pm" = 1 ]; then ps=STALLED; else ps=CALM; fi   # psi at t depends on motion at t-1
      if [ $((n % 7)) -eq 0 ]; then
        occ=$((occ+1))
        if [ $((occ % 2)) -eq 1 ]; then bm=MOVE; pm=1; else bm=STILL; pm=2; fi
      else
        bm=UNKNOWN; pm=0
      fi
      printf '2026-06-20T%02d:%02d:00Z\t%s\t%s\n' $((n/60)) $((n%60)) "$bm" "$ps"
    done
  } > "$tp3"
  dOFF="$(MESH="$_td" TAPE="$tp3" CORRELATE_MIN_SUPPORT=8 CORRELATE_PRED_MINDENS=0 bash "$0" --dry 2>&1)"
  echo "$dOFF" | grep -qi 'PREDICTION (auto.*body_motion' \
    || { echo "smoke-test: FAIL (density floor OFF: sparse deterministic predictor should still emit: $dOFF)"; exit 1; }
  dDEF="$(MESH="$_td" TAPE="$tp3" CORRELATE_MIN_SUPPORT=8 bash "$0" --dry 2>&1)"
  echo "$dDEF" | grep -qi 'PREDICTION (auto' \
    && { echo "smoke-test: FAIL (density floor ON/default: 14%-coverage predictor not suppressed: $dDEF)"; exit 1; }
  # floor-gate: a queue with an open [ ] item holds the emit
  printf '%s\n' '[ ] pending work' > "$_td/ideas-queue"
  fout="$(MESH="$_td" TAPE="$tp" CORRELATE_MIN_SUPPORT=8 IDEATE_FLOOR=1 bash "$0" 2>&1)"
  echo "$fout" | grep -qi 'hold' || { echo "smoke-test: FAIL (floor-gate did not hold on non-empty queue: $fout)"; exit 1; }
  grep -qc '^\[ \] pending work' "$_td/ideas-queue" && [ "$(grep -c '^\[ \]' "$_td/ideas-queue")" = 1 ] \
    || { echo "smoke-test: FAIL (floor-gate appended despite hold)"; exit 1; }
  # real emit into an EMPTY queue → exactly one CORRELATION/PREDICTION [ ] line appended
  : > "$_td/ideas-queue"
  MESH="$_td" TAPE="$tp" CORRELATE_MIN_SUPPORT=8 IDEATE_FLOOR=1 bash "$0" >/dev/null 2>&1
  [ "$(grep -cE '^\[ \] (CORRELATION|PREDICTION) \(auto, real data\)' "$_td/ideas-queue")" = 1 ] \
    || { echo "smoke-test: FAIL (emit did not append exactly one finding: $(cat "$_td/ideas-queue"))"; exit 1; }
  # ── CLOCK-GATE: a CLOCK-CONFOUNDED pair must NOT be emitted (2026-07-25) ────────────────────
  # The live instance: light=DARK <-> ambient=NIGHT-QUIET, episode-lift 2.2 / 8 episodes of 79 —
  # this lane's first and (over correlate.log's full 424-run extent) ONLY finding, and spurious by
  # construction: mesh-ambient-clock:1009 computes NIGHT-QUIET as QUIET ∧ (HOUR>=23 || HOUR<=5), so
  # the label cannot exist outside 7 of 24 hours, and light reads DARK in those hours because of the
  # sun. Fixture reproduces that shape exactly: DARK+NIGHT-QUIET at 01:00 on 8 days, LIT+QUIET at
  # 13:00 — 8 alternating episodes of 16, pooled lift 8*16/(8*8) = 2.0, over MIN_LIFT.
  tp3="$_td/tape-clock.tsv"
  {
    printf 'ts\tlight\tambient\n'
    for d in $(seq 1 8); do
      printf '2026-06-%02dT01:00:00Z\tDARK\tNIGHT-QUIET\n' "$d"
      printf '2026-06-%02dT13:00:00Z\tLIT\tQUIET\n' "$d"
    done
  } > "$tp3"
  # (a) the control is LOAD-BEARING — with it OFF the fixture really does trip the miner. Without
  #     this half the assertion below could pass because the fixture was under threshold all along
  #     (a gate you have not seen fail is not a gate; here the RED run lives IN the suite).
  out="$(MESH="$_td" TAPE="$tp3" CORRELATE_MIN_SUPPORT=8 CORRELATE_CLOCK_GATE=0 bash "$0" --dry 2>&1)"
  echo "$out" | grep -q 'NIGHT-QUIET' \
    || { echo "smoke-test: FAIL (clock-confound fixture does not trip the miner with the gate OFF — the gate below would assert nothing: $out)"; exit 1; }
  # (b) with the control ON the finding is gone...
  out="$(MESH="$_td" TAPE="$tp3" CORRELATE_MIN_SUPPORT=8 bash "$0" --dry 2>&1)"
  echo "$out" | grep -qE '^[0-9.]+\s+LIFT.*NIGHT-QUIET' \
    && { echo "smoke-test: FAIL (clock-confounded light<->ambient pair emitted as a finding: $out)"; exit 1; }
  # (c) ...and it went LOUDLY. A silently-dropped candidate is indistinguishable from a dead miner.
  echo "$out" | grep -q 'clock-gate: DROPPED' \
    || { echo "smoke-test: FAIL (candidate dropped SILENTLY — no clock-gate notice in the output: $out)"; exit 1; }
  # (d) the PRED lane carries the SAME confound and the LIFT gate does not reach it. Found by this
  #     very fixture: with CORRELATE_PRED_CLOCKBASE=0 it emits "light at t predicts ambient at t+1
  #     — 100% vs 53% baseline, perm-p 0.001". Perfectly significant, and it is just the clock.
  #     RED half first (gate off ⇒ the confound really is emitted), then the control must kill it.
  out="$(MESH="$_td" TAPE="$tp3" CORRELATE_MIN_SUPPORT=8 CORRELATE_PRED_CLOCKBASE=0 bash "$0" --dry 2>&1)"
  echo "$out" | grep -qE '^[0-9.]+\s+PRED' \
    || { echo "smoke-test: FAIL (clock-confound fixture does not trip the PRED lane with the clock baseline OFF — the gate below would assert nothing: $out)"; exit 1; }
  out="$(MESH="$_td" TAPE="$tp3" CORRELATE_MIN_SUPPORT=8 bash "$0" --dry 2>&1)"
  echo "$out" | grep -qE '^[0-9.]+\s+PRED' \
    && { echo "smoke-test: FAIL (clock-confounded PREDICTION emitted — the hour predicts the target as well as the 'predictor' does: $out)"; exit 1; }

  # (e) NO WOLF — and it must exercise the DROP DECISION, not just the band filter. The all-hours
  #     tp fixture cannot do that: BUSTLE spans a 15h band (> CLOCK_BAND_MAX), so the control never
  #     runs on it and the assertion would hold no matter what the drop decided. Measured: mutating
  #     the drop to fire unconditionally left that check GREEN — a gate asserting nothing.
  #     This fixture puts the gated token INSIDE a narrow band and keeps a real association there:
  #     NIGHT-QUIET occurs only at 01:00/02:00 (2h band), and within it DARK tracks NIGHT-QUIET
  #     while LIT tracks MODERATE → in-band lift 2.0, must SURVIVE. That is the exact semantics
  #     claimed: a real link shows up inside the only hours the gated token can occur in.
  #     20 days, not 8: the 01:00/02:00 alternation COLLAPSES across the midnight boundary (day d's
  #     02:00 pair equals day d+1's 01:00 pair), so 8 days yields only 4 co-occurring episodes —
  #     under MIN_SUPPORT, and the fixture would read "no finding" for a reason that has nothing to
  #     do with the control. The 13:00 row keeps the band a strict SUBSET of the tape.
  tp4="$_td/tape-inband.tsv"
  {
    printf 'ts\tlight\tambient\n'
    for d in $(seq 1 20); do
      if [ $((d % 2)) -eq 1 ]; then
        printf '2026-06-%02dT01:00:00Z\tDARK\tNIGHT-QUIET\n' "$d"
        printf '2026-06-%02dT02:00:00Z\tLIT\tMODERATE\n'     "$d"
      else
        printf '2026-06-%02dT01:00:00Z\tLIT\tMODERATE\n'     "$d"
        printf '2026-06-%02dT02:00:00Z\tDARK\tNIGHT-QUIET\n' "$d"
      fi
      printf '2026-06-%02dT13:00:00Z\tLIT\tQUIET\n' "$d"
    done
  } > "$tp4"
  out="$(MESH="$_td" TAPE="$tp4" CORRELATE_MIN_SUPPORT=8 bash "$0" --dry 2>&1)"
  echo "$out" | grep -qE '^[0-9.]+\s+LIFT.*NIGHT-QUIET' \
    || { echo "smoke-test: FAIL (clock-gate suppressed a link that HOLDS INSIDE the gated token's own band — crying wolf: $out)"; exit 1; }

  # ── FAULT-VOCAB EXCLUSION (2026-07-28, correlation-body-state-presence review) ────────────────
  # (a) body_state is in FAULT_TOKENS — its DEGRADED half is a sensor-fault verdict, not a body
  #     reading, so it must be treated as MISSING (same as UNKNOWN), not as a value that can pair.
  #     Byte-identical shape to the tp positive control (16 hourly rows, perfectly alternating,
  #     lift 2.0 pre-fix) — RED half first, else this proves nothing about the exclusion.
  tp6="$_td/tape-fault.tsv"
  {
    printf 'ts\tbody_state\tpsi\n'
    for n in $(seq 1 16); do
      if [ $((n % 2)) -eq 1 ]; then v=DEGRADED; p=STALLED; else v=OK; p=CALM; fi
      printf '2026-06-20T%02d:00:00Z\t%s\t%s\n' "$n" "$v" "$p"
    done
  } > "$tp6"
  out="$(MESH="$_td" TAPE="$tp6" CORRELATE_MIN_SUPPORT=8 bash "$0" --dry 2>&1)"
  echo "$out" | grep -qi 'body_state' \
    && { echo "smoke-test: FAIL (body_state=DEGRADED fault verdict paired as a real value: $out)"; exit 1; }
  # (b) NOT a blanket DEGRADED exclude: the SAME token on a sense NOT in FAULT_TOKENS (home_state,
  #     cross-family vs psi) must still be usable as a genuine value and the pairing must fire —
  #     proving the exclusion is per-sense, not a global string match on "DEGRADED".
  tp7="$_td/tape-degraded-legit.tsv"
  {
    printf 'ts\thome_state\tpsi\n'
    for n in $(seq 1 16); do
      if [ $((n % 2)) -eq 1 ]; then v=DEGRADED; p=STALLED; else v=ACTIVE; p=CALM; fi
      printf '2026-06-20T%02d:00:00Z\t%s\t%s\n' "$n" "$v" "$p"
    done
  } > "$tp7"
  out="$(MESH="$_td" TAPE="$tp7" CORRELATE_MIN_SUPPORT=8 bash "$0" --dry 2>&1)"
  echo "$out" | grep -qi 'home_state.*DEGRADED\|DEGRADED.*home_state' \
    || { echo "smoke-test: FAIL (home_state=DEGRADED treated as fault when it is NOT in FAULT_TOKENS — exclusion leaked past its per-sense scope: $out)"; exit 1; }

  # ── DIAMETRIC POSTURE (--posture): the miner must be able to name BOTH poles, not just guard one.
  #    RED-first: each verdict fixture is paired with a control that flips it, so a verdict that could
  #    never fire (a gate you have not seen fail) is caught.
  # (1) OVER-PARTICULARIZED — tempo(OCC)/psi(NODE)/light(PHONE) all decorrelated (different periods):
  #     enough episodes (M>=8) but no cross-family pair reaches MIN_LIFT → floor sits above the ceiling.
  tpP="$_td/posture-weak.tsv"
  {
    printf 'ts\ttempo\tpsi\tlight\n'
    for n in $(seq 1 16); do
      if [ $((n % 2)) -eq 1 ]; then tpv=BUSTLE; else tpv=SILENT; fi          # period 2
      if [ $(((n-1)/2 % 2)) -eq 0 ]; then psv=STALLED; else psv=CALM; fi     # period 4 (decorrelated from tempo)
      if [ $((n % 3)) -eq 0 ]; then liv=DARK; else liv=LIT; fi               # period 3
      printf '2026-06-20T%02d:00:00Z\t%s\t%s\t%s\n' "$n" "$tpv" "$psv" "$liv"
    done
  } > "$tpP"
  wv="$(MESH="$_td" TAPE="$tpP" CORRELATE_MIN_SUPPORT=4 bash "$0" --posture 2>&1)"; wrc=$?
  echo "$wv" | grep -q 'OVER-PARTICULARIZED' && [ "$wrc" = 3 ] \
    || { echo "smoke-test: FAIL (posture: decorrelated tape should read OVER-PARTICULARIZED rc3, got rc$wrc: $wv)"; exit 1; }
  # FALSIFIER: drop the floor below the observed ceiling → the verdict MUST flip off OVER-PARTICULARIZED
  # (proves it keys on floor-vs-ceiling, not on the tape being sparse/short).
  wf="$(MESH="$_td" TAPE="$tpP" CORRELATE_MIN_SUPPORT=4 CORRELATE_MIN_LIFT=0.5 bash "$0" --posture 2>&1)"
  echo "$wf" | grep -q 'OVER-PARTICULARIZED' \
    && { echo "smoke-test: FAIL (posture: floor lowered below the data ceiling and it STILL read over-particularized — verdict not keyed on the floor: $wf)"; exit 1; }
  # (2) APOPHENIC — the alternating positive-control tape ($tp): every column tracks every other, so
  #     all cross-family pairs clear the floor (fraction 1.0 >= APO_FRAC).
  av="$(MESH="$_td" TAPE="$tp" CORRELATE_MIN_SUPPORT=8 bash "$0" --posture 2>&1)"; arc=$?
  echo "$av" | grep -q 'APOPHENIC-LEAN' && [ "$arc" = 4 ] \
    || { echo "smoke-test: FAIL (posture: fully-correlated tape should read APOPHENIC-LEAN rc4, got rc$arc: $av)"; exit 1; }
  # (3) BALANCED — one strong pair (tempo<->psi, lift 2.0) among several decorrelated ones (light,
  #     ambient period-shifted) → a minority clears the floor (< APO_FRAC), max lift still >= floor.
  tpB="$_td/posture-balanced.tsv"
  {
    printf 'ts\ttempo\tpsi\tlight\tambient\n'
    for n in $(seq 1 16); do
      if [ $((n % 2)) -eq 1 ]; then tpv=BUSTLE; psv=STALLED; else tpv=SILENT; psv=CALM; fi   # strong pair
      if [ $((n % 3)) -eq 0 ]; then liv=DARK; else liv=LIT; fi                                # noise
      if [ $(((n+1) % 3)) -eq 0 ]; then amv=LOUD; else amv=QUIET; fi                          # noise
      printf '2026-06-20T%02d:00:00Z\t%s\t%s\t%s\t%s\n' "$n" "$tpv" "$psv" "$liv" "$amv"
    done
  } > "$tpB"
  bv="$(MESH="$_td" TAPE="$tpB" CORRELATE_MIN_SUPPORT=4 bash "$0" --posture 2>&1)"; brc=$?
  echo "$bv" | grep -q 'BALANCED' && [ "$brc" = 0 ] \
    || { echo "smoke-test: FAIL (posture: one-strong-among-noise tape should read BALANCED rc0, got rc$brc: $bv)"; exit 1; }

  echo "smoke-test: ok (planted correlation found; same-family excluded; UNKNOWN treated missing; below-support empty; autocorrelation-collapsed (persistent run → no finding); floor-gate holds; emit appends one; clock-confound dropped loudly + LIFT+PRED gates proven load-bearing + no-wolf holds a link that survives INSIDE the band; regime-shift (no history over 80% of the window) dropped loudly + falsifier; a gate-CORRECTED lift that SURVIVES is the number published+scored (confounded full-window lift disclosed as confounded); per-sense fault-vocab excluded + not blanket; DIAMETRIC posture names all three poles: over-particularized(rc3)+falsifier / apophenic(rc4) / balanced(rc0))"
  exit 0
fi

# DIAMETRIC POSTURE — read-only diagnostic; runs the LIFT gauntlet in report mode and exits with the
# verdict rc (0 balanced / 3 over-particularized / 4 apophenic). Intercepted HERE so its rc propagates
# instead of being swallowed by the generic analyze/append path below (which treats rc!=0 as failure).
if [ "${1:-}" = "--posture" ]; then
  [ -f "$TAPE" ] || { echo "mesh-correlate --posture: no tape yet ($TAPE) — mesh-sensor-tape must run first" >&2; exit 2; }
  analyze "$TAPE" "posture"; exit $?
fi

[ -f "$TAPE" ] || { echo "$(ts) mesh-correlate: no tape yet ($TAPE) — mesh-sensor-tape must run first" >&2; exit 1; }

# analyze's stdout is the candidate list; its stderr carries the CLOCK-GATE drop notices (and any real
# python error). Both must reach the LOG, not just a transient terminal: a candidate discarded in
# silence is indistinguishable from "nothing found today", and this lane emits at most one finding per
# half-hour, so a silent drop reads as a dead miner. (The silent-fallback rule, CLAUDE.md.)
_gates="$(mktemp)"; trap 'rm -f "$_gates"' EXIT
raw="$(analyze "$TAPE" "$mode" 2>"$_gates")" || { echo "$(ts) mesh-correlate: analyze failed: $(cat "$_gates")" >&2; exit 1; }
[ -s "$_gates" ] && while IFS= read -r _gl; do echo "$(ts) mesh-correlate: $_gl"; done < "$_gates"

# Seed the connection generator with the TOP finding's pair (whenever real structure exists) — this
# is independent of the floor gate: even when the queue is busy and we hold below, mesh-ideate should
# still get the freshest data-grounded pair to fuse once the queue drains. NOT on --dry/--list
# (append=0): a preview must be side-effect-free, else threshold-probing pollutes the seed file.
if [ "$append" = 1 ] && [ -n "$raw" ]; then
  IFS=$'\t' read -r _sc _kind _tk _ttext <<< "$(printf '%s\n' "$raw" | head -1)"
  [ -n "$_tk" ] && write_seed "$_tk" "$_ttext"
fi

if [ "$append" = 0 ]; then
  if [ -z "$raw" ]; then echo "$(ts) mesh-correlate: no correlation/prediction meets thresholds (need more data — honest empty, not a failure)"; else echo "$raw"; fi
  exit 0
fi

# FLOOR gate (append mode) — seed a genuinely-empty queue, one provocation at a time (mesh-ideate
# discipline). Skip if real/novel work already pends so this stays a gentle source, not a treadmill.
floor="${IDEATE_FLOOR:-1}"
open=$(grep -c '^\[ \]' "$Q" 2>/dev/null); open="${open:-0}"
if [ "$open" -ge "$floor" ]; then
  echo "$(ts) mesh-correlate: queue has $open open idea(s) (>= floor $floor) — hold, not piling on"
  # mtime-touch (shared primitive, NOT a bare touch) — the fire-on-event tool's STATE file holds
  # only the recent-emitted-keys cache, so the mtime DOESN'T advance on a no-finding run and
  # a stale-mtime watchdog (mesh-reflex-health, mesh-doctor theater-check) false-fires as
  # "hollow cron-green with no fresh artifact". The hold path IS a successful cron eval:
  # the watch ran, the threshold held, no finding was emitted. Stamp the liveness without
  # polluting the recent-keys cache content. (Same fix as mesh-cooscillate:613, applied here
  # for the same reason — 2026-06-27 audit of fire-on-event tools.)
  mesh-state-touch "$STATE"
  exit 0
fi

# Pick the highest-score candidate not recently emitted (non-repeat across relationships).
idea=""; key=""
while IFS=$'\t' read -r sc kind k text; do
  [ -z "$text" ] && continue
  recent_has "$k" && continue
  idea="$text"; key="$k"; break
done <<< "$raw"

[ -z "$idea" ] && { echo "$(ts) mesh-correlate: no fresh finding (none meet thresholds, or all recently emitted)"; mesh-state-touch "$STATE"; exit 0; }

# Append under the shared queue lock — same flock mesh-queue-tend/mesh-generate take, so a bare
# >> append can't be lost against a concurrent full-file rewrite (mv swaps the inode mid-append).
exec 9>"$LOCK" 2>/dev/null || true
flock -w 30 9 2>/dev/null || true
printf '[ ] %s\n' "$idea" >> "$Q"
recent_add "$key"
echo "$(ts) mesh-correlate: +1 finding -> ideas-queue ($key)"
