#!/usr/bin/env bash
# orphan-ok: on-demand consent-gated iMac camera/mic probe — pulled by hand or a task, never scheduled.
# mesh-imac-media-probe — consent-aware on-demand camera/mic probe for imac-rozalia.
#
#   mesh-imac-media-probe --inventory
#       No capture. SSH to ilya@100.121.88.110, assert the 3 discovery predicates
#       (camera VID:PID 1452:34059, mic input channels > 0, sample rate != 0).
#       rc 0 = pass, 1 = predicate fail, 2 = organ unreachable.
#   mesh-imac-media-probe --capture --consent <file> [--out <dir>]
#       Capture ONE JPEG frame via the FaceTime HD camera over SSH, using the
#       iMac's own /usr/bin/python + AVFoundation (no binary installed there).
#       The consent file must exist and be non-empty (operator-signed text).
#       WITHOUT --consent the capture is refused — inventory alone never implies
#       a stream, and no frame is ever taken silently.
#       Artifact lands under $(mesh-evidence-dir --mkdir imac-media).
#       rc 0 = fresh non-zero JPEG on disk, 3 = capture blocked (likely macOS
#       TCC camera prompt — a person at the machine must Allow once),
#       2 = ssh/unreachable, 1 = predicate fail.
#   mesh-imac-media-probe --test
#       Selftest: live --inventory (real hardware read), consent-gate refusal
#       (capture without --consent must fail LOUD naming consent), --help.
#       Never captures in --test.
#
# Source: knowledge/capability-imac-face-time-camera-microphone-20260916.md
# (3/3 predicates, 0 bytes captured — inventory is not streamability).
set -u
HOST="ilya@100.121.88.110"
SSH=(ssh -o BatchMode=yes -o ConnectTimeout=8 "$HOST")

usage() { sed -n '2,/^# Source/p' "$0" | sed 's/^# \{0,1\}//'; }

inventory() {
    local out
    out="$("${SSH[@]}" 'system_profiler SPCameraDataType SPAudioDataType 2>/dev/null')" || {
        echo "UNREACHABLE: ssh to $HOST failed"; return 2; }
    local fail=0
    echo "$out" | grep -q "VendorID_1452 ProductID_34059" \
        && echo "predicate camera VID:PID 1452:34059: pass" \
        || { echo "predicate camera VID:PID 1452:34059: FAIL"; fail=1; }
    echo "$out" | grep -E -q "Input Channels: [1-9]" \
        && echo "predicate mic channels>0: pass" \
        || { echo "predicate mic channels>0: FAIL"; fail=1; }
    echo "$out" | grep -E -q "Current SampleRate: [1-9]" \
        && echo "predicate mic samplerate!=0: pass" \
        || { echo "predicate mic samplerate!=0: FAIL"; fail=1; }
    return "$fail"
}

capture() {
    local consent="$1" outdir="$2"
    [ -n "$consent" ] && [ -s "$consent" ] || {
        echo "REFUSED: --capture needs --consent <non-empty operator consent file>; no frame taken"; return 4; }
    inventory >/dev/null || { echo "REFUSED: inventory predicates fail — capture runs only on a passing organ"; return 1; }
    local stamp tmp
    stamp="$(date -u +%Y%m%dT%H%M%SZ)"
    tmp="/tmp/imac-frame-$stamp.jpg"
    # One still via the iMac's own system python + AVFoundation. Synchronous:
    # run the loop up to 12s, then exit whether or not a frame arrived.
    "${SSH[@]}" "/usr/bin/python - '$tmp' <<'PYEOF'
import sys, time
import AVFoundation as AV
import Cocoa
tmp = sys.argv[1]
got = []
def cb(s, sample, err):
    if sample is not None:
        rep = AV.AVCaptureStillImageOutput.jpegStillImageNSDataRepresentation_(sample)
        if rep is not None:
            open(tmp, 'wb').write(bytes(rep))
            got.append(True)
    Cocoa.CFRunLoopStop(Cocoa.CFRunLoopGetCurrent())
dev = AV.AVCaptureDevice.defaultDeviceWithMediaType_(AV.AVMediaTypeVideo)
sess = AV.AVCaptureSession.alloc().init()
inp, err = AV.AVCaptureDeviceInput.deviceInputWithDevice_error_(dev, None)
if inp is None:
    print('NO-INPUT'); sys.exit(0)
sess.addInput_(inp)
still = AV.AVCaptureStillImageOutput.alloc().init()
sess.addOutput_(still)
sess.startRunning()
time.sleep(2)
conn = still.connectionWithMediaType_(AV.AVMediaTypeVideo)
still.captureStillImageAsynchronouslyFromConnection_completionHandler_(conn, cb)
Cocoa.CFRunLoopRunInMode(Cocoa.kCFRunLoopDefaultMode, 10.0, False)
sess.stopRunning()
print('FRAME' if got else 'NO-FRAME')
PYEOF" || { echo "UNREACHABLE: ssh capture leg failed"; return 2; }
    local size
    size="$("${SSH[@]}" "ls -l '$tmp' 2>/dev/null | awk '{print \$5}'")"
    if [ -z "$size" ] || [ "$size" -eq 0 ] 2>/dev/null; then
        echo "BLOCKED: no frame arrived (likely macOS TCC camera prompt — a person at the iMac must Allow once, then retry). Nothing captured."
        return 3
    fi
    mkdir -p "$outdir"
    scp -q -o BatchMode=yes -o ConnectTimeout=8 "$HOST:$tmp" "$outdir/frame-$stamp.jpg" || {
        echo "UNREACHABLE: scp of frame failed"; return 2; }
    "${SSH[@]}" "rm -f '$tmp'" 2>/dev/null
    [ -s "$outdir/frame-$stamp.jpg" ] \
        && echo "FRAME: $outdir/frame-$stamp.jpg ($size bytes, consent: $consent)" \
        || { echo "FAIL: frame lost in transfer"; return 1; }
    return 0
}

cmd="${1:---help}"
case "$cmd" in
    --help|-h) usage; exit 0 ;;
    --inventory) inventory; exit $? ;;
    --capture)
        shift
        consent=""; outdir=""
        while [ $# -gt 0 ]; do
            case "$1" in --consent) consent="${2:-}"; shift 2;; --out) outdir="${2:-}"; shift 2;; *) echo "unknown flag $1"; exit 2;; esac
        done
        [ -z "$outdir" ] && outdir="$(mesh-evidence-dir --mkdir imac-media)"
        capture "$consent" "$outdir"; exit $? ;;
    --test)
        fail=0
        inventory || { echo "TEST-FAIL: live inventory"; fail=1; }
        if "$0" --capture 2>&1 | grep -q "REFUSED"; then
            echo "TEST-OK: capture without --consent refused LOUD"
        else echo "TEST-FAIL: consent gate silent"; fail=1; fi
        "$0" --help >/dev/null 2>&1 || { echo "TEST-FAIL: --help"; fail=1; }
        [ "$fail" -eq 0 ] && echo "TEST: PASS" || echo "TEST: FAIL"
        exit "$fail" ;;
    *) echo "unknown: $cmd"; usage; exit 2 ;;
esac
