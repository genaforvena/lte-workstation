#!/usr/bin/env bash
# reflex-cadence: */5 * * * *
# reflex-args: --edge
# mesh-powerbtn — physical POWER-BUTTON-PRESS sense: has a human pressed this node's chassis
# power button since the last check? Source: the kernel wakeup-source subsystem
# (/sys/class/wakeup/wakeup*/{name,event_count}), matched to the two ACPI power-button device
# classes (LNXPWRBN = fixed power button, PNP0C0C = control-method power button — laptops often
# wire both and either can fire). event_count is a monotonic kernel counter incremented on every
# real button-press IRQ (from suspend OR while awake); it is NOT a poll, so a cron sampling it a
# few minutes apart cannot miss a press between samples the way an instantaneous read could.
#
# WHY this is a NEW, distinct real-world sense (not in the existing perception set):
#   - mesh-lid watches ACPI lid open/close events, not the power button.
#   - mesh-kbd-activity / mesh-pointer-presence watch i8042/evdev interrupt lines; the power
#     button is a separate ACPI fixed-event device, invisible to both.
#   - A power-button press is RARE and high-signal: it means someone physically touched the
#     chassis power control — attempting shutdown, forced-suspend-wake, or (unattended) a
#     physical-access/tamper event. No current sense reports it.
#
# HONEST degradation: a node without the kernel wakeup-source class (no /sys/class/wakeup — a
# container, or a kernel built without CONFIG_PM_SLEEP wakeup accounting) OR with neither
# LNXPWRBN nor PNP0C0C present (desktop with no power-button ACPI object wired that way) is
# UNREACHABLE for this sense -> exit 2, NEVER a faked "no press" QUIET.
#
#   mesh-powerbtn            one-shot: delta since last recorded count -> PRESSED(n) or QUIET
#   mesh-powerbtn --json     {"verdict":...,"delta":N,"total":N,"ts":...}
#   mesh-powerbtn --edge     emit ONLY on PRESSED (cron/stream-friendly); persists counter always
#   mesh-powerbtn --test     pure classify truth-table (offline) + honest hardware-read gate
#
# Exit codes: 0 = read landed (QUIET is a real assessment, not an error); 2 = UNREACHABLE (no
# wakeup-source class, or no power-button wakeup device on this node).
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

MESH="$HOME/.mesh"
STATE="${MESH_PWRBTN_STATE:-$MESH/.powerbtn.state}"
WAKEUP_ROOT="${MESH_PWRBTN_WAKEUP_ROOT:-/sys/class/wakeup}"

# pure classifier (no I/O): delta since last recorded total -> verdict
classify() { # $1=delta
  local d="$1"
  if [ "$d" -gt 0 ] 2>/dev/null; then echo "PRESSED"; else echo "QUIET"; fi
}

# sum event_count across every wakeup-source device whose name matches an ACPI power-button
# class (LNXPWRBN = fixed power button, PNP0C0C = control-method power button). Echoes "" if
# the wakeup class is absent or no match is found — the caller treats that as UNREACHABLE.
pwrbtn_total() {
  local root="$1" f name ec total="" found=0
  for f in "$root"/wakeup*/name; do
    [ -r "$f" ] || continue
    name="$(cat "$f" 2>/dev/null)"
    case "$name" in
      LNXPWRBN*|PNP0C0C*)
        ec="$(cat "${f%/name}/event_count" 2>/dev/null)"
        [ -n "$ec" ] || continue
        total=$(( ${total:-0} + ec )); found=1
        ;;
    esac
  done
  [ "$found" = 1 ] && echo "$total"
}

if [ "${1:-}" = --test ]; then
  fail=0
  [ "$(classify 0)"  = QUIET   ] || { echo "  FAIL: delta=0 -> QUIET";   fail=1; }
  [ "$(classify 1)"  = PRESSED ] || { echo "  FAIL: delta=1 -> PRESSED"; fail=1; }
  [ "$(classify 5)"  = PRESSED ] || { echo "  FAIL: delta=5 -> PRESSED"; fail=1; }
  g="$(classify "")" 2>/dev/null; [ "$g" = QUIET ] || { echo "  FAIL: garbage delta must fall through to QUIET, got '$g'"; fail=1; }

  # synthetic wakeup-source tree: two power-button devices (5+2=7) + one unrelated device (ignored)
  td="$(mktemp -d)"; trap 'rm -rf "$td"' EXIT
  mkdir -p "$td/wakeup0" "$td/wakeup1" "$td/wakeup2"
  printf 'LNXPWRBN:00\n' > "$td/wakeup0/name"; printf '5\n' > "$td/wakeup0/event_count"
  printf 'PNP0C0C:00\n'  > "$td/wakeup1/name"; printf '2\n' > "$td/wakeup1/event_count"
  printf 'ADP0\n'        > "$td/wakeup2/name"; printf '99\n' > "$td/wakeup2/event_count"
  sum="$(pwrbtn_total "$td")"
  [ "$sum" = 7 ] || { echo "  FAIL: synthetic total expected 7 got '$sum'"; fail=1; }

  # no power-button device present -> UNREACHABLE (empty, not 0)
  td2="$(mktemp -d)"; mkdir -p "$td2/wakeup0"
  printf 'ADP0\n' > "$td2/wakeup0/name"; printf '3\n' > "$td2/wakeup0/event_count"
  none="$(pwrbtn_total "$td2")"; rm -rf "$td2"
  [ -z "$none" ] || { echo "  FAIL: no-pwrbtn-device tree should yield empty total, got '$none'"; fail=1; }

  # absent wakeup class entirely -> UNREACHABLE
  absent="$(pwrbtn_total "$td/nonexistent")"
  [ -z "$absent" ] || { echo "  FAIL: absent wakeup root should yield empty total, got '$absent'"; fail=1; }

  [ "$fail" = 0 ] || { echo "smoke-test: FAIL"; exit 1; }

  # REAL hardware-read gate: this node's actual /sys/class/wakeup, live.
  live="$(pwrbtn_total "$WAKEUP_ROOT")"
  if [ -z "$live" ]; then
    echo "smoke-test: n/a (no LNXPWRBN/PNP0C0C wakeup-source device on this node — UNREACHABLE, honest)"; exit 2
  fi
  case "$live" in
    ''|*[!0-9]*) echo "smoke-test: FAIL (live read not a plain integer: '$live')"; exit 1 ;;
  esac
  echo "smoke-test: ok (classify:4 + synthetic-sum:1 + no-device:1 + absent-root:1 assertions; sense LIVE — current total=$live event(s))"
  exit 0
fi

total="$(pwrbtn_total "$WAKEUP_ROOT")"
[ -n "$total" ] || exit 2

mkdir -p "$MESH" 2>/dev/null || true
prev="$(cat "$STATE" 2>/dev/null || true)"
[ -n "$prev" ] || prev="$total"   # first run: seed baseline, no phantom delta from pre-mesh history

delta=$(( total - prev ))
[ "$delta" -lt 0 ] && delta=0     # guard against a counter reset (reboot race)
verdict="$(classify "$delta")"
ts="$(date -u +%FT%TZ)"

printf '%s\n' "$total" > "$STATE"
mesh-state-touch "$STATE" 2>/dev/null || touch "$STATE" 2>/dev/null || true

if [ "${1:-}" = --json ]; then
  printf '{"verdict":"%s","delta":%d,"total":%d,"ts":"%s"}\n' "$verdict" "$delta" "$total" "$ts"
  exit 0
fi

if [ "${1:-}" = --edge ]; then
  [ "$verdict" = PRESSED ] && printf '[powerbtn] PRESSED — %d press(es) since last check (total=%d) @ %s\n' "$delta" "$total" "$ts"
  exit 0
fi

printf '[powerbtn] %s — delta=%d total=%d @ %s\n' "$verdict" "$delta" "$total" "$ts"
