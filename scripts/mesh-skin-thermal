#!/usr/bin/env bash
# orphan-ok: on-demand chassis-skin thermal-gradient sense — the ACPI skin/chassis thermal zones
#   (/sys/class/thermal/thermal_zone*, e.g. SEN1..SEN6, B0D4, acpitz) are a real hardware signal the
#   node could perceive but did not yet interpret as a SPATIAL map. Pulled when asked (like
#   mesh-cooling-load / mesh-airtime); --edge is board-capable but this is not a scheduled reflex.
# mesh-skin-thermal — the chassis SKIN thermal-GRADIENT sense: how UNEVENLY the physical body of the
# node is heated across its multiple ACPI skin sensors.
#
# Why this is a NEW sense (no existing thermal tool perceives it):
#   Every current thermal sense reduces the zone array to ONE scalar and throws the spatial structure
#   away — mesh-therm-watch keys on the HOTTEST zone (alarms), mesh-therm-headroom on a single COOLEST
#   chassis zone (an ambient floor proxy), mesh-temp-display on x86_pkg_temp (the CPU die), and
#   mesh-cooling-load on the cooling CONTROLLER. None reads the SPREAD across the skin sensors. But a
#   laptop's placement lives in that spread: on an open desk the skin sensors sit close together (even
#   dissipation); on a soft surface with a choked vent, or with a heat source on one side (sun, radiator,
#   a hand resting on the palmrest), the chassis heats ASYMMETRICALLY and the max-min skin spread widens
#   — a PLACEMENT / VENTILATION signal that is distinct from "how hot is the CPU" and invisible to every
#   scalar thermal sense. The coolest skin sensor doubles as a room-ambient-coupled floor.
#
# Skin sensors = the readable thermal zones EXCEPT the CPU die (x86_pkg_temp/coretemp), the static
# firmware controller (INT3400 ~ fixed 20C), internal-device sensors (iwlwifi/nvme), and the CPU-junction
# device proxies (B0D*: they track package temp, not a chassis location, and would just re-measure CPU
# heat). Needs >=2 to form a gradient; otherwise it is honestly n/a (exit 2), never a faked even reading.
#
#   mesh-skin-thermal          one compact line (level + spread + hotspot/floor)
#   mesh-skin-thermal --json   machine-readable JSON
#   mesh-skin-thermal --edge   emit only on level change (2-consecutive debounce) — board-capable
#   mesh-skin-thermal --test   synthetic fixture smoke test + live real-read gate (>=2 skin zones)
#
# Levels (by spread, °C; tunable via env):
#   TIGHT     spread <  MESH_SKIN_TIGHT (8)   — evenly cooled: open, ventilated surface
#   GRADIENT  spread <  MESH_SKIN_STEEP (20)  — normal exhaust-side warmth; one corner runs hotter
#   STEEP     spread >= MESH_SKIN_STEEP (20)  — strong asymmetry: heavy load OR one-sided/blocked airflow
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

PS="${MESH_THERMAL_DIR:-/sys/class/thermal}"
TIGHT="${MESH_SKIN_TIGHT:-8}"
STEEP="${MESH_SKIN_STEEP:-20}"
STATE="${MESH_SKIN_STATE:-$HOME/.mesh/.skin-thermal-state}"
PEND="${STATE}.pending"

# Exclude: CPU die (x86_pkg_temp, coretemp*), static firmware controller (INT3400*), and
# internal-device sensors (iwlwifi*, nvme*, pch*). Everything else with a plausible temp is skin.
_is_skin_type() {
  case "$1" in
    x86_pkg_temp|coretemp*|INT3400*|iwlwifi*|nvme*|pch*|B0D*|acpitz-virtual*) return 1 ;;
    *) return 0 ;;
  esac
}

# Emit: "<label>\t<reason>\t<spread_c>\t<hot_type>\t<hot_c>\t<cold_type>\t<cold_c>\t<n>"
read_skin() {
  local z ty milli c
  local hot_type="" hot_c="" cold_type="" cold_c="" n=0
  for z in "$PS"/thermal_zone*; do
    [ -d "$z" ] || continue
    [ -r "$z/type" ] || continue
    [ -r "$z/temp" ] || continue
    ty="$(cat "$z/type" 2>/dev/null | tr -d '\n')"
    milli="$(cat "$z/temp" 2>/dev/null | tr -d '\n')"
    [ -n "$ty" ] || continue
    case "$milli" in ''|*[!0-9-]*) continue ;; esac
    _is_skin_type "$ty" || continue
    # milli-°C → °C (one decimal). Drop implausible sensors (<10°C or >=100°C): dead/static/bogus.
    c="$(awk -v m="$milli" 'BEGIN{printf "%.1f", m/1000.0}')"
    awk -v c="$c" 'BEGIN{exit !(c>=10.0 && c<100.0)}' || continue
    n=$((n+1))
    if [ -z "$hot_c" ] || awk -v a="$c" -v b="$hot_c" 'BEGIN{exit !(a>b)}'; then
      hot_c="$c"; hot_type="$ty"
    fi
    if [ -z "$cold_c" ] || awk -v a="$c" -v b="$cold_c" 'BEGIN{exit !(a<b)}'; then
      cold_c="$c"; cold_type="$ty"
    fi
  done
  [ "$n" -ge 2 ] || return 1
  local spread; spread="$(awk -v h="$hot_c" -v l="$cold_c" 'BEGIN{printf "%.1f", h-l}')"
  local label reason
  read -r label reason < <(awk -v s="$spread" -v t="$TIGHT" -v st="$STEEP" 'BEGIN{
    if (s < t)  { print "TIGHT evenly-cooled:open-ventilated-surface"; exit }
    if (s < st) { print "GRADIENT normal-exhaust-side-warmth"; exit }
    print "STEEP strong-asymmetry:heavy-load-or-blocked-airflow"
  }')
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$label" "$reason" "$spread" "$hot_type" "$hot_c" "$cold_type" "$cold_c" "$n"
}

# ── smoke test ───────────────────────────────────────────────────────────────
if [ "${1:-}" = --test ]; then
  command -v awk >/dev/null 2>&1 || { echo "smoke-test: FAIL (no awk)"; exit 1; }
  command -v mktemp >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mktemp)"; exit 1; }
  td="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
  trap 'rm -rf "$td"' EXIT
  mkzone() { mkdir -p "$td/thermal_zone$1"; printf '%s\n' "$2" > "$td/thermal_zone$1/type"; printf '%s\n' "$3" > "$td/thermal_zone$1/temp"; }
  # Fixture: a STEEP chassis — exhaust-side skin 58C, edge 33C → spread 25C. Plus CPU/controller/device
  # zones that MUST be excluded (each set HOTTER than the true skin hotspot, so a missed exclusion would
  # visibly corrupt hot_type/spread).
  mkzone 0 INT3400\ Thermal 20000     # static controller — excluded
  mkzone 1 SEN1 58000                 # skin (hotspot)
  mkzone 2 SEN5 33000                 # skin (floor)
  mkzone 3 SEN6 42000                 # skin
  mkzone 4 B0D4 91000                 # CPU-junction proxy — excluded (else it would falsely be hottest)
  mkzone 5 x86_pkg_temp 92000         # CPU die — excluded
  mkzone 6 iwlwifi_1 70000            # radio — excluded
  got="$(MESH_THERMAL_DIR="$td" "$0" --json 2>/dev/null || true)"
  printf '%s\n' "$got" | grep -q '"label":"STEEP"' || { echo "smoke-test: FAIL (fixture should be STEEP: $got)"; exit 1; }
  printf '%s\n' "$got" | grep -q '"spread_c":25.0' || { echo "smoke-test: FAIL (spread should be 25.0, CPU/junction not excluded?: $got)"; exit 1; }
  printf '%s\n' "$got" | grep -q '"hot_type":"SEN1"' || { echo "smoke-test: FAIL (hotspot should be SEN1; B0D4/pkg leaked in?: $got)"; exit 1; }
  printf '%s\n' "$got" | grep -q '"cold_type":"SEN5"' || { echo "smoke-test: FAIL (floor should be SEN5: $got)"; exit 1; }
  printf '%s\n' "$got" | grep -q '"skin_sensors":3' || { echo "smoke-test: FAIL (should count 3 skin sensors: $got)"; exit 1; }
  # TIGHT fixture: all skin within 5C → evenly cooled
  td2="$td/tight"; mkdir -p "$td2"
  for i in 0 1 2; do mkdir -p "$td2/thermal_zone$i"; done
  printf 'SEN1\n' > "$td2/thermal_zone0/type"; printf '40000\n' > "$td2/thermal_zone0/temp"
  printf 'SEN2\n' > "$td2/thermal_zone1/type"; printf '43000\n' > "$td2/thermal_zone1/temp"
  printf 'SEN3\n' > "$td2/thermal_zone2/type"; printf '44000\n' > "$td2/thermal_zone2/temp"
  got2="$(MESH_THERMAL_DIR="$td2" "$0" --json 2>/dev/null || true)"
  printf '%s\n' "$got2" | grep -q '"label":"TIGHT"' || { echo "smoke-test: FAIL (tight fixture should be TIGHT: $got2)"; exit 1; }
  # honest n/a: <2 skin zones (only a CPU die present) → exit 2, never a faked reading
  td3="$td/lone"; mkdir -p "$td3/thermal_zone0"
  printf 'x86_pkg_temp\n' > "$td3/thermal_zone0/type"; printf '60000\n' > "$td3/thermal_zone0/temp"
  MESH_THERMAL_DIR="$td3" "$0" --json >/dev/null 2>&1; rc=$?
  [ "$rc" = 2 ] || { echo "smoke-test: FAIL (lone CPU die should be honest n/a exit 2, got rc=$rc)"; exit 1; }
  # ── live real-read gate: the sense must produce a real gradient from >=2 skin zones on this node ──
  real="$(env -u MESH_THERMAL_DIR "$0" --json 2>/dev/null)"; rrc=$?
  if [ "$rrc" = 2 ]; then
    echo "smoke-test: n/a — <2 chassis skin sensors on this node (honest hardware n/a)"; exit 2
  fi
  [ "$rrc" = 0 ] || { echo "smoke-test: FAIL (real read rc=$rrc)"; exit 1; }
  echo "$real" | grep -qE '"skin_sensors":[2-9]' || { echo "smoke-test: FAIL (live read must parse >=2 skin sensors: $real)"; exit 1; }
  echo "$real" | grep -qE '"spread_c":[0-9]' || { echo "smoke-test: FAIL (live read must yield a numeric spread: $real)"; exit 1; }
  echo "smoke-test: ok (STEEP/TIGHT classifier + exclusion of CPU/controller/radio + honest n/a + live gradient read)"
  exit 0
fi

# ── one read ─────────────────────────────────────────────────────────────────
readout="$(read_skin)" || {
  echo "skin-thermal: UNREACHABLE — <2 readable chassis skin sensors" >&2
  exit 2
}
IFS=$'\t' read -r label reason spread hot_type hot_c cold_type cold_c n <<<"$readout"
ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

emit_json() {
  printf '{"label":"%s","reason":"%s","spread_c":%s,"hot_type":"%s","hot_c":%s,"cold_type":"%s","cold_c":%s,"skin_sensors":%s,"ts":"%s"}\n' \
    "$label" "$reason" "$spread" "$hot_type" "$hot_c" "$cold_type" "$cold_c" "$n" "$ts"
}
emit_text() {
  printf '[skin-thermal] %s — %s | spread %s°C | hotspot %s %s°C / floor %s %s°C (%s skin sensors)\n' \
    "$label" "$reason" "$spread" "$hot_type" "$hot_c" "$cold_type" "$cold_c" "$n"
}

case "${1:-}" in
  --json) emit_json ;;
  --edge)
    mkdir -p "$(dirname "$STATE")" 2>/dev/null || true
    confirmed=""; [ -r "$STATE" ] && confirmed="$(head -n1 "$STATE" 2>/dev/null)"
    cand=""; cnt=0
    if [ -r "$PEND" ]; then IFS=$'\t' read -r cand cnt < "$PEND" 2>/dev/null || true; fi
    [ -n "$cnt" ] 2>/dev/null || cnt=0
    if [ -z "$confirmed" ]; then
      # first run — seed the confirmed level silently (no board spam on startup)
      printf '%s\n' "$label" > "$STATE"
      printf '%s\t0\n' "$label" > "$PEND"
    elif [ "$label" = "$confirmed" ]; then
      printf '%s\t0\n' "$label" > "$PEND"          # back on the confirmed level — clear any pending
    else
      if [ "$label" = "$cand" ]; then cnt=$((cnt+1)); else cand="$label"; cnt=1; fi
      if [ "$cnt" -ge 2 ]; then
        printf '%s\n' "$label" > "$STATE"           # 2-consecutive confirmed → commit + emit
        printf '%s\t0\n' "$label" > "$PEND"
        emit_text
      else
        printf '%s\t%s\n' "$cand" "$cnt" > "$PEND"  # pending, not yet confirmed — no emit
      fi
    fi
    # liveness-touch: ran-live (mtime) is decoupled from value-changed (content). A dead cron never
    # runs → never touches → honest-STALE; a long-stable level never false-STALEs. Shared primitive.
    mesh-state-touch --create "$STATE" >/dev/null 2>&1 || touch "$STATE" 2>/dev/null || true
    ;;
  *) emit_text ;;
esac
