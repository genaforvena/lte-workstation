#!/usr/bin/env bash
# orphan-ok: on-demand attribution fold — pure stdout read of mesh-keypresence (live kbd-IRQ sample)
#            + mesh-stress --json (already-scheduled cached thermal/load/mind-count fusion); no state
#            artifact of its own, no edge/alert logic, so scheduling it adds nothing a mind/board-post
#            can't get by invoking it on demand — pulled when a load/thermal event needs a WHO verdict.
# mesh-load-attrib — cross-sense fusion: is THIS node's current load/heat HUMAN-DRIVEN (operator at
# the keyboard), MIND-DRIVEN (many mind panes churning with nobody physically present), or
# BACKGROUND-LOAD (elevated load with few/no minds — a cron/test fan-out, not a mind or a human)?
#
# Why this is new: mesh-stress fuses temp+load+mind-count into a THERMAL-RISK level but has zero
# concept of WHO is causing the load — a STRESSED verdict looks identical whether the operator is
# hammering the keyboard, 8 minds are mid-conversation, or mesh-doctor's --test fan-out is grinding
# in the background. mesh-keypresence senses a human at THIS node's keyboard but knows nothing about
# system load. No existing sense crosses these two. Motivating case (this board, 2026-07-08 17:4x):
# chat-review/doctor-no-preflight-mempressure-gate cites "3 independent manual defers of the same
# OOM-kill condition" — each defer was a mind reading load/swap and guessing at the cause by hand.
# This gives that guess a name, cheaply, every time.
#
# Inputs:
#   mesh-keypresence <win>   LIVE kbd-IRQ sample (this node's own keyboard only) -> ACTIVE|QUIET|
#                            UNREACHABLE(no dedicated kbd IRQ — e.g. a headless node)
#   mesh-stress --json       CACHED-cheap local read (no --probe: no SSH/curl of its own) -> load_norm,
#                            minds (tmux mind-window count, mesh-stress's own accounting)
#   mesh-wifi-motion         CACHED-cheap RF room-motion (reads the wifi.log tape a sibling reflex
#                            writes; no scan of its own) -> EMPTY(STILL)|MOVING(MOTION)|UNCERTAIN|
#                            UNKNOWN(exit 2 = unreachable/stale tape). This is the ROOM-PRESENCE axis.
#
# The occupancy cross (2026-07-10): keypresence answers "is a human AT THIS KEYBOARD" but is BLIND to a
# person who is physically in the room and NOT typing — both read human=QUIET. So a MIND-SWARM verdict
# could mean "13 minds burning in an EMPTY room" or "13 minds burning while the operator sits on the
# couch reading" — the same line, two very different situations. Folding wifi-motion (passive RF, works
# through a covered webcam, phone-free) adds the missing ROOM axis and lets the burn verdicts carry an
# occupancy qualifier no single sensor gives:
#   occupancy=UNATTENDED           MIND-SWARM/BACKGROUND-LOAD + room=EMPTY  -> burn, nobody in the room
#   occupancy=PRESENT-NOT-TYPING   MIND-SWARM/BACKGROUND-LOAD + room=MOVING -> a body is here, not at desk
#   occupancy=AT-DESK              HUMAN-INTERACTIVE (a human is at the keyboard by definition)
#   occupancy=UNKNOWN              burn verdict but room axis dark/UNCERTAIN -> honest can't-tell
#   occupancy=n/a                  no burn to attribute (IDLE/UNATTRIBUTED/DEGRADED)
# The occupancy qualifier is PURELY ADDITIVE — the six-word verdict vocabulary below is UNCHANGED, so
# every existing consumer that greps the verdict token is untouched. room=UNKNOWN (wifi-motion exit 2)
# renders VISIBLY distinct from room=EMPTY (a genuine STILL read) — an unreachable RF axis is never
# silently folded into "empty room", exactly as human=UNKNOWN is never folded into QUIET.
#
# Verdict vocabulary (a CONTRACT — do not rename):
#   HUMAN-INTERACTIVE   human=ACTIVE -> a person is physically typing here right now; load is
#                       explained regardless of its level (a human can also run a heavy build)
#   MIND-SWARM          human!=ACTIVE AND load_norm>=hot AND minds>=heavy -> load tracks the mind
#                       count with nobody at the keyboard — the running minds are the likely burn
#   BACKGROUND-LOAD     human!=ACTIVE AND load_norm>=hot AND minds<heavy -> loaded but NOT mind-
#                       attributable — cron/test-fan-out/other process is the likelier cause
#   IDLE                human!=ACTIVE AND load_norm<hot -> nothing to attribute, node is calm
#   UNATTRIBUTED        human is known QUIET but the load axis is dark (mesh-stress unreadable) ->
#                       honest "can't tell if it's loaded", never a faked IDLE
#   DEGRADED            BOTH axes dark (kbd unreachable AND load unreadable) -> exit 2, honest n/a
#
# HONEST-DEGRADED (the no-faked-reading rule): human=UNREACHABLE (no dedicated kbd IRQ on this node)
# is rendered as its OWN state, "UNKNOWN" — NEVER folded into QUIET. A MIND-SWARM/BACKGROUND-LOAD/IDLE
# verdict reached with human=UNKNOWN still says so in the line (e.g. "human=UNKNOWN(no-kbd)") so a
# reader never mistakes "we couldn't check for a human" for "we checked and nobody was there".
#
#   mesh-load-attrib            one-line verdict + signals (human kbd window default 3s)
#   mesh-load-attrib <win>      custom keypresence sample window in seconds
#   mesh-load-attrib --json     machine-readable
#   mesh-load-attrib --test     fixture smoke test (pure classify()) + real-read gate (live kbd +
#                                stress sample on THIS host)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

LOAD_NORM_HOT="${MESH_LOADATTR_LOAD_HOT:-1.0}"     # load1/nproc >= this counts as "loaded" (matches
                                                    # mesh-stress's own climbing-escalation gate)
MIND_HEAVY="${MESH_LOADATTR_MIND_HEAVY:-6}"        # matches mesh-stress's HEAVY_MINDS default

read_human(){  # <win> -> ACTIVE|QUIET|UNKNOWN (live mesh-keypresence sample)
  local win="$1" out rc
  out="$(mesh-keypresence "$win" 2>/dev/null)"; rc=$?
  if [ "$rc" -eq 2 ]; then echo UNKNOWN; return; fi
  case "$out" in *ACTIVE*) echo ACTIVE ;; *) echo QUIET ;; esac
}

read_system(){  # -> "<load_norm> <minds>" or "? ?" (live mesh-stress --json, no --probe: local-cheap)
  local j ln m
  j="$(mesh-stress --json 2>/dev/null)"
  ln="$(printf '%s' "$j" | grep -oP '(?<="load_norm":)[0-9.]+' | head -1)"
  m="$(printf '%s' "$j" | grep -oP '(?<="minds":)[0-9]+' | head -1)"
  echo "${ln:-?} ${m:-?}"
}

read_room(){  # -> EMPTY|MOVING|UNCERTAIN|UNKNOWN (cached RF room-motion; exit 2 => honest UNKNOWN)
  local out rc
  out="$(mesh-wifi-motion 2>/dev/null)"; rc=$?
  [ "$rc" -eq 2 ] && { echo UNKNOWN; return; }   # unreachable / stale tape — NEVER faked as EMPTY
  case "$out" in
    *MOTION*)    echo MOVING ;;
    *STILL*)     echo EMPTY ;;
    *UNCERTAIN*) echo UNCERTAIN ;;
    *)           echo UNKNOWN ;;                 # unparseable output — honest UNKNOWN, not EMPTY
  esac
}

occupancy(){  # $1=verdict $2=room -> AT-DESK|UNATTENDED|PRESENT-NOT-TYPING|UNKNOWN|n/a (additive qualifier)
  local v="$1" room="$2"
  case "$v" in
    HUMAN-INTERACTIVE) echo AT-DESK ;;
    MIND-SWARM|BACKGROUND-LOAD)
      case "$room" in
        EMPTY)  echo UNATTENDED ;;               # a burn with nobody physically in the room
        MOVING) echo PRESENT-NOT-TYPING ;;       # a body is here, just not at the keyboard
        *)      echo UNKNOWN ;;                   # UNCERTAIN/UNKNOWN room -> honest can't-tell
      esac ;;
    *) echo n/a ;;                                # IDLE/UNATTRIBUTED/DEGRADED — no burn to attribute
  esac
}

classify(){  # $1=human $2=load_norm $3=minds $4=load_hot $5=mind_heavy -> verdict
  local human="$1" ln="$2" minds="$3" hot="$4" heavy="$5"
  [ "$human" = ACTIVE ] && { echo HUMAN-INTERACTIVE; return; }
  if [ "$ln" = "?" ]; then
    [ "$human" = UNKNOWN ] && { echo DEGRADED; return; }
    echo UNATTRIBUTED; return
  fi
  if awk "BEGIN{exit !($ln>=$hot)}"; then
    if [ "$minds" != "?" ] && [ "$minds" -ge "$heavy" ] 2>/dev/null; then echo MIND-SWARM; return; fi
    echo BACKGROUND-LOAD; return
  fi
  echo IDLE
}

if [ "${1:-}" = --test ]; then
  f=0
  # HUMAN-INTERACTIVE wins regardless of load/minds
  [ "$(classify ACTIVE 3.0 9 1.0 6)" = HUMAN-INTERACTIVE ] || { echo "FAIL: human=ACTIVE must win"; f=1; }
  # MIND-SWARM: quiet human, hot load, heavy minds
  [ "$(classify QUIET 1.5 8 1.0 6)" = MIND-SWARM ] || { echo "FAIL: hot+heavy-minds must be MIND-SWARM"; f=1; }
  # BACKGROUND-LOAD: quiet human, hot load, few minds (the doctor-fan-out case)
  [ "$(classify QUIET 1.5 1 1.0 6)" = BACKGROUND-LOAD ] || { echo "FAIL: hot+few-minds must be BACKGROUND-LOAD"; f=1; }
  # IDLE: quiet human, cool load
  [ "$(classify QUIET 0.30 8 1.0 6)" = IDLE ] || { echo "FAIL: cool load must be IDLE"; f=1; }
  # UNATTRIBUTED: human known QUIET but load axis dark
  [ "$(classify QUIET "?" "?" 1.0 6)" = UNATTRIBUTED ] || { echo "FAIL: quiet+dark-load must be UNATTRIBUTED"; f=1; }
  # DEGRADED: both axes dark
  [ "$(classify UNKNOWN "?" "?" 1.0 6)" = DEGRADED ] || { echo "FAIL: both-dark must be DEGRADED"; f=1; }
  # UNKNOWN human still classifies off a readable load axis (never silently treated as QUIET)
  [ "$(classify UNKNOWN 1.5 8 1.0 6)" = MIND-SWARM ] || { echo "FAIL: kbd-unknown+hot+heavy must still classify MIND-SWARM"; f=1; }
  # occupancy() qualifier — additive room axis, does NOT touch the verdict vocabulary
  [ "$(occupancy HUMAN-INTERACTIVE EMPTY)" = AT-DESK ] || { echo "FAIL: human-interactive must be AT-DESK regardless of room"; f=1; }
  [ "$(occupancy MIND-SWARM EMPTY)" = UNATTENDED ] || { echo "FAIL: mind-swarm+empty-room must be UNATTENDED"; f=1; }
  [ "$(occupancy MIND-SWARM MOVING)" = PRESENT-NOT-TYPING ] || { echo "FAIL: mind-swarm+moving-room must be PRESENT-NOT-TYPING"; f=1; }
  [ "$(occupancy BACKGROUND-LOAD EMPTY)" = UNATTENDED ] || { echo "FAIL: background-load+empty-room must be UNATTENDED"; f=1; }
  # room=UNKNOWN (unreachable RF) must render as UNKNOWN, NEVER silently as UNATTENDED(empty)
  [ "$(occupancy MIND-SWARM UNKNOWN)" = UNKNOWN ] || { echo "FAIL: unreachable room must be UNKNOWN, not faked UNATTENDED"; f=1; }
  [ "$(occupancy MIND-SWARM UNCERTAIN)" = UNKNOWN ] || { echo "FAIL: uncertain room must be UNKNOWN"; f=1; }
  [ "$(occupancy IDLE EMPTY)" = n/a ] || { echo "FAIL: no-burn verdict must be occupancy=n/a"; f=1; }
  # real-read gate: both live inputs must actually produce a reading on THIS host (short window)
  rh="$(read_human 1)"
  case "$rh" in ACTIVE|QUIET|UNKNOWN) ;; *) echo "FAIL: live read_human() gave unrecognized '$rh'"; f=1 ;; esac
  read -r rln rmn <<<"$(read_system)"
  if [ "$rln" = "?" ] && [ "$rmn" = "?" ]; then
    echo "FAIL: live read_system() returned both dark on a real host (mesh-stress broken?)"; f=1
  fi
  # real-read gate for the room axis: read_room() must yield a recognized token (EMPTY/MOVING/UNCERTAIN
  # honest reads, UNKNOWN honest-unreachable) — never empty/garbage that would poison occupancy()
  rr="$(read_room)"
  case "$rr" in EMPTY|MOVING|UNCERTAIN|UNKNOWN) ;; *) echo "FAIL: live read_room() gave unrecognized '$rr'"; f=1 ;; esac
  [ "$f" = 0 ] && echo "smoke-test: PASS (6 classify + 7 occupancy fixtures + 3 live real-read assertions)" || { echo "smoke-test: FAIL"; exit 1; }
  exit 0
fi

WIN="${MESH_LOADATTR_WIN:-3}"
case "${1:-}" in
  --json) : ;;
  ''|*[!0-9]*) : ;;
  *) WIN="$1" ;;
esac

human="$(read_human "$WIN")"
read -r ln minds <<<"$(read_system)"
verdict="$(classify "$human" "$ln" "$minds" "$LOAD_NORM_HOT" "$MIND_HEAVY")"
room="$(read_room)"
occ="$(occupancy "$verdict" "$room")"

if [ "${1:-}" = --json ] || [ "${2:-}" = --json ]; then
  printf '{"verdict":"%s","human":"%s","load_norm":"%s","minds":"%s","room":"%s","occupancy":"%s","load_norm_hot":%s,"mind_heavy":%s}\n' \
    "$verdict" "$human" "$ln" "$minds" "$room" "$occ" "$LOAD_NORM_HOT" "$MIND_HEAVY"
else
  printf '[load-attrib] %s (human=%s load_norm=%s/hot=%s minds=%s/heavy=%s room=%s occupancy=%s)\n' \
    "$verdict" "$human" "$ln" "$LOAD_NORM_HOT" "$minds" "$MIND_HEAVY" "$room" "$occ"
fi

[ "$verdict" = DEGRADED ] && exit 2
exit 0
