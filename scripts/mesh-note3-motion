#!/usr/bin/env bash
# reflex-cadence: 4-59/5 * * * *
# reflex-args: --edge
# mesh-note3-motion — the Note3's OWN accelerometer (MPU6500, /sys/class/sensors/accelerometer_sensor/
# raw_data) as a MOVED/STILL edge sense for its fixed craft-room location, via the SAME adb->ds relay
# mesh-baro/mesh-note3-desk already use.
#
# WHY THIS IS NEW: capability-note3-ir-proximity-gesture-20260707.md's sensor census found the MPU6500
# accel reads LIVE with no enable step (raw_data=16178,-45,-1237, stable across reads a second apart)
# but flagged it "not pre-built" (PLAN doctrine: note the find, wire on demand). mesh-note3-desk already
# fuses this same phone's proximity+light into DESK OCCUPANCY; nothing reads the Note3's own
# accelerometer, which answers a different question neither of those two can: has the PHONE ITSELF been
# touched, picked up, or reoriented since the last read — a tamper/handling edge for a device that
# otherwise just sits fixed in the craft room. (raw_data is on-change/cached per this HAL, not a live
# vibration stream, so the honest sense here is a discrete MOVED/STILL edge from comparing successive
# vectors, not continuous IMU data.)
#
# Honest contract: adb/ssh unreachable OR raw_data unparsable -> UNREACHABLE, exit 2, never fake a
# reading. Orientation semantics (which physical face is "up") are NOT claimed — verifying axis-to-
# physical-orientation mapping would need hands in the craft room, which this node doesn't have,
# so the verdict stays in the sensor's own coordinate frame (raw vector + Euclidean delta) rather than
# a fabricated "face up/down" label (no-fabricated-physical-descriptions).
#
#   mesh-note3-motion            one-shot verdict (INIT|STILL|MOVED) + vector + delta
#   mesh-note3-motion --json     machine-readable
#   mesh-note3-motion --edge     debounced state write; board post ONLY on a STILL<->MOVED transition
#   mesh-note3-motion --test     fixture-driven classifier + sensor-fault smoke test + live read-gate
#
# Exit: 0 = assessed (INIT/STILL/MOVED)
#       1 = a CODE fault — the classifier/parse/relay/sensor-fault contract is violated (--test only)
#       2 = nothing could be MEASURED. TWO different claims share this code, and the message says
#           which: the adb body is unreachable (the LANE), or a live well-formed reading came back
#           and the ACCELEROMETER behind it is railed / reports no gravity (the ORGAN). Both are an
#           honest n/a and neither is ever faked into a verdict. See sensor_fault() below — as of
#           2026-08-22 this node's Note3 takes the ORGAN branch on every read: x and y are dead.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && [ -z "${MESH_SKIP_NODES_SOURCE:-}" ] && . "$HOME/.mesh/nodes"

MESH="${MESH_DIR:-$HOME/.mesh}"; mkdir -p "$MESH" 2>/dev/null || true
STATE="$MESH/.note3-motion-state"          # "verdict|x|y|z|ts"
EDGE_STATE="$MESH/.note3-motion-edge"      # last POSTED verdict (for --edge dedup)

# Note3 body is the SAME fixed adb->ds relay mesh-baro/mesh-note3-desk use; falls back to the
# baro node vars so a single ~/.mesh/nodes entry covers every Note3-body sense.
NOTE3_ADB_NODE="${MESH_NOTE3_ADB_NODE:-${MESH_BARO_ADB_NODE:-}}"
NOTE3_ADB_SERIAL="${MESH_NOTE3_ADB_SERIAL:-${MESH_BARO_ADB_SERIAL:-}}"
# Ambient noise band unknown yet (first-cut, generous): MPU6500 default full-scale is commonly
# +-2g = 16384 LSB/g, so 400 raw units is ~2.4% of 1g — well above read-to-read jitter on a resting
# phone (observed live: 16178,-45,-1237 then 16247,-414,-104 a few seconds apart, delta ~380) yet far
# below an actual pick-up/reorientation (which swings a full axis by thousands of units).
MOVE_THRESH="${MESH_NOTE3_MOTION_THRESH:-900}"

# ── SENSOR-FAULT GATE (added 2026-08-22 — the rails are the SENSOR, measured) ─────────────
# int16 saturation: an axis parked on either rail is the ADC pinned at ±2g full scale, not a
# measurement. A railed axis is a PERFECTLY-FORMED INTEGER, so the shape gate in
# note3_accel_raw() passes on it and the classifier happily differences a constant.
RAIL_LO=-32768
RAIL_HI=32767
# Gravity floor. SCALE IS DERIVED FROM THIS NODE'S OWN PAIRED READING, never a datasheet: the
# sysfs lane read z=17123 at the same instant the native HAL client read 10.3017 m/s² →
# 17123/(10.3017/9.80665) = 16302 LSB/g. Floor = a tenth of that; below it the device reports
# no gravity, which a phone not in sustained free fall cannot do. (16302/10)^2 = 2683044.
GRAV_FLOOR_MAG2=2683044
#
# MEASURED HARDWARE STATE OF THIS SENSOR (mesh-home + Note3 4d00553d61ab90b7, re-confirmed
# 2026-08-22T15:0xZ through THREE independent paths that agree to the LSB, so it is the sensor
# and not the adb path and not a unit/parse bug):
#   sysfs raw_data                    : -32768,32767,17196
#   Android HAL (dumpsys sensorservice): last=<-19.6, 19.6, 10.3> m/s²   (19.6133 = 2×9.80665)
#   SSP hub self-test (accelerometer_sensor/selftest): -3,98.5,97.0,21.8 → NEGATIVE result code
# -32768/32767 are INT16_MIN/INT16_MAX and −19.6/+19.6 m/s² is the same ±2g full scale expressed
# in physical units by a completely different consumer. X and Y are SATURATED — dead hardware.
# Only Z is real (17196/16302 = 1.055 g, gravity on a phone lying flat).
#
# AND THE LIVE AXIS LATCHES: raw_data advances once when a HAL listener is enabled, then holds
# bit-identical (measured 2026-08-19 on the uxn lane; re-seen here — 5 reads in ~8s returned
# 17196 byte-identical). So NOBODY MAY READ A SEQUENCE OF THESE VALUES AS MOTION, and the
# historical [note3-motion] MOVED posts on the board are latch/rail TRANSITIONS, not handling:
# their deltas (2245 · 2267 · 2450 · 2466 · 7014 · 17144 · 22022 · 30685 · 32890 · 45910) are
# far outside anything |Δz| can produce (z spans ~15.4k..17.2k → max ~1.7k), and 32768 IS the
# rail-to-rail distance. Sibling: scripts/uxn/mesh-note3-uxn-accel, which carries the same two
# gates and deliberately carries NO reflex-cadence for exactly this reason.
#
# sensor_fault <x> <y> <z> -> prints a reason on stdout and returns 1 when the reading is
# well-formed but MEASURES NOTHING; prints nothing and returns 0 when the vector is usable.
# Pure function — no I/O — directly testable. It runs on the LIVE path, not only in --test:
# a --test that asserts a physical invariant the runtime does not enforce lets the reflex post
# MOVED/STILL off a constant for as long as the hardware stays broken.
sensor_fault() {
  local x="$1" y="$2" z="$3" railed="" a n
  for a in "x:$x" "y:$y" "z:$z"; do
    n="${a#*:}"
    if [ "$n" -le "$RAIL_LO" ] || [ "$n" -ge "$RAIL_HI" ]; then railed="$railed ${a%%:*}"; fi
  done
  if [ -n "$railed" ]; then
    printf 'axis/axes railed at int16 saturation:%s (%s,%s,%s) — the ADC is pinned at ±2g full scale, dead hardware no genome edit can clear; the adb lane is PROVEN by this very reply, so do not heal the link\n' "$railed" "$x" "$y" "$z"
    return 1
  fi
  if [ "$(( x*x + y*y + z*z ))" -lt "$GRAV_FLOOR_MAG2" ]; then
    printf 'reading carries no gravity (%s,%s,%s, |a| < 0.1 g) — three tidy integers that measure nothing, a driver no-data sentinel (magnetic_sensor/raw_data on this same phone reads -1,-1,-1), not a reading\n' "$x" "$y" "$z"
    return 1
  fi
  return 0
}

# note3_accel_raw — live "x,y,z" from the MPU6500 sysfs node. Empty + rc1 on any failure (adb down,
# ssh down, malformed output). Test override: NOTE3_MOTION_RAW_OVERRIDE skips the network entirely.
note3_accel_raw() {
  local out
  if [ -n "${NOTE3_MOTION_RAW_OVERRIDE:-}" ]; then
    out="$NOTE3_MOTION_RAW_OVERRIDE"
  else
    [ -z "$NOTE3_ADB_NODE" ] && return 1
    local ser=""; [ -n "$NOTE3_ADB_SERIAL" ] && ser="-s $NOTE3_ADB_SERIAL"
    if [ "$NOTE3_ADB_NODE" = local ]; then
      out="$(timeout 15 adb $ser shell 'cat /sys/class/sensors/accelerometer_sensor/raw_data' 2>/dev/null)"
    else
      out="$(timeout 20 ssh -o BatchMode=yes -o ConnectTimeout=8 -o StrictHostKeyChecking=accept-new \
        "$NOTE3_ADB_NODE" "adb $ser shell 'cat /sys/class/sensors/accelerometer_sensor/raw_data'" </dev/null 2>/dev/null)"
    fi
  fi
  out="$(printf '%s' "$out" | tr -d '[:space:]')"
  printf '%s' "$out" | grep -qE '^-?[0-9]+,-?[0-9]+,-?[0-9]+$' || return 1
  printf '%s' "$out"
}

# classify <x> <y> <z> <prev_x|""> <prev_y> <prev_z> <thresh> -> "VERDICT DELTA"
# DELTA is "-" for INIT (no prior vector to compare against). Pure function — no I/O — directly testable.
classify() {
  local x="$1" y="$2" z="$3" px="$4" py="$5" pz="$6" thresh="$7"
  if [ -z "$px" ]; then printf 'INIT -\n'; return; fi
  python3 -c "
import math
d = math.sqrt(($x-$px)**2 + ($y-$py)**2 + ($z-$pz)**2)
print(('MOVED' if d >= $thresh else 'STILL'), '%.0f' % d)
"
}

# is_relay_run <arg1> <adb_node> -> rc0 when this is a SCHEDULED --edge poll on a RELAY node
# (adb_node is a non-empty remote host, i.e. NOT "local"). A relay reaches the SAME physical Note3
# by SSH-ing to the direct-adb owner, so its cron poll is pure redundancy — a double board post +
# divergence from racing the same on-change HAL cache — with zero added resilience (the relay read
# already fails whenever the owner is down). The direct-adb owner (adb_node="local") is the sole
# scheduled poster; on-demand reads (no-arg/--json) stay available from any node. Pure — testable.
is_relay_run() { [ "$1" = --edge ] && [ -n "$2" ] && [ "$2" != local ]; }

# ─── --test: fixture-driven classifier + live adb read-gate ────────────────
if [ "${1:-}" = --test ]; then
  command -v python3 >/dev/null 2>&1 || { echo "smoke-test: FAIL (no python3)"; exit 1; }
  _f=0

  r="$(classify 16178 -45 -1237 "" "" "" "$MOVE_THRESH")"
  [ "$(echo "$r" | awk '{print $1}')" = INIT ] || { echo "  FAIL: no prior vector must be INIT, got '$r'"; _f=1; }

  r="$(classify 16200 -50 -1250 16178 -45 -1237 900)"
  [ "$(echo "$r" | awk '{print $1}')" = STILL ] || { echo "  FAIL: tiny jitter (delta~26) should be STILL, got '$r'"; _f=1; }

  r="$(classify -16000 100 200 16178 -45 -1237 900)"
  [ "$(echo "$r" | awk '{print $1}')" = MOVED ] || { echo "  FAIL: axis flip (phone flipped) should be MOVED, got '$r'"; _f=1; }

  r="$(classify 16178 -45 -1237 16178 -45 -1237 900)"
  [ "$(echo "$r" | awk '{print $1}')" = STILL ] || { echo "  FAIL: identical vector (delta=0) should be STILL, got '$r'"; _f=1; }
  [ "$(echo "$r" | awk '{print $2}')" = "0" ]   || { echo "  FAIL: identical vector delta should print 0, got '$r'"; _f=1; }

  # parse gate: malformed raw_data must be rejected by note3_accel_raw, never silently accepted
  NOTE3_MOTION_RAW_OVERRIDE="not,a,vector,x" note3_accel_raw >/dev/null 2>&1 && { echo "  FAIL: malformed raw_data must be rejected"; _f=1; }
  NOTE3_MOTION_RAW_OVERRIDE="1,2,3" note3_accel_raw >/dev/null 2>&1 || { echo "  FAIL: well-formed raw_data must be accepted"; _f=1; }

  # ── sensor-fault gate (sensor_fault): the physics, not the parse ──
  # These four fixtures are the ones the OLD magnitude check could not express: it asserted a
  # scalar band (1000 < |a| < 40000) which a single railed axis can sit inside.
  sensor_fault 16178 -45 -1237 >/dev/null || { echo "  FAIL: a healthy resting vector must not be a sensor fault"; _f=1; }
  sensor_fault -32768 32767 17123 >/dev/null && { echo "  FAIL: both x and y on the int16 rails must be a sensor fault"; _f=1; }
  sensor_fault 100 32767 200 >/dev/null && { echo "  FAIL: a SINGLE railed axis must be a sensor fault (|a| stays in the old plausible band)"; _f=1; }
  sensor_fault -1 -1 -1 >/dev/null && { echo "  FAIL: the driver no-data sentinel (-1,-1,-1) must be a sensor fault — it passes shape AND rails"; _f=1; }
  case "$(sensor_fault -32768 32767 17123 2>&1)" in *"railed at int16 saturation"*) : ;; *) echo "  FAIL: the railed reason must name int16 saturation"; _f=1 ;; esac
  case "$(sensor_fault -1 -1 -1 2>&1)" in *"no gravity"*) : ;; *) echo "  FAIL: the sentinel reason must name the missing gravity"; _f=1 ;; esac

  # ── relay-node gate (is_relay_run): scheduled --edge on a RELAY skips; owner + on-demand don't ──
  is_relay_run --edge imozerov@100.125.157.75 || { echo "  FAIL: --edge on a relay node must skip"; _f=1; }
  is_relay_run --edge local                    && { echo "  FAIL: --edge on the direct-adb owner must NOT skip"; _f=1; }
  is_relay_run --edge ''                        && { echo "  FAIL: --edge with no adb node must NOT skip (n/a path handles it)"; _f=1; }
  is_relay_run --json imozerov@100.125.157.75  && { echo "  FAIL: on-demand --json from a relay must NOT skip"; _f=1; }
  is_relay_run '' imozerov@100.125.157.75      && { echo "  FAIL: on-demand no-arg from a relay must NOT skip"; _f=1; }
  # integration: a real relay --edge run must write NOTHING to the board (falsify by reverting the gate)
  _rsd="$(mktemp -d)"; _rboard="$_rsd/chat.log"; : > "$_rboard"
  MESH_DIR="$_rsd" MESH_SKIP_NODES_SOURCE=1 MESH_NOTE3_MOTION_BOARD="$_rboard" \
    MESH_NOTE3_ADB_NODE='relay@203.0.113.9' MESH_BARO_ADB_NODE='' "$0" --edge >/dev/null 2>&1
  [ -s "$_rboard" ] && { echo "  FAIL: relay --edge wrote to the board (should skip): $(cat "$_rboard")"; _f=1; }
  rm -rf "$_rsd" 2>/dev/null || true

  # integration: a RAILED reading on the --edge path must exit 2 and post only the FAULT edge —
  # never MOVED/STILL (falsify by deleting the sensor_fault call on the live path: this goes red).
  _fsd="$(mktemp -d)"; _fboard="$_fsd/chat.log"; : > "$_fboard"
  MESH_DIR="$_fsd" MESH_SKIP_NODES_SOURCE=1 MESH_NOTE3_MOTION_BOARD="$_fboard" \
    NOTE3_MOTION_RAW_OVERRIDE='-32768,32767,17123' MESH_NOTE3_ADB_NODE=local MESH_BARO_ADB_NODE='' \
    "$0" --edge >/dev/null 2>&1; _frc=$?
  [ "$_frc" = 2 ] || { echo "  FAIL: a railed live read on --edge must exit 2 (honest n/a), got rc=$_frc"; _f=1; }
  grep -q 'MOVED\|STILL' "$_fboard" 2>/dev/null && { echo "  FAIL: a railed read posted a MOVED/STILL verdict: $(cat "$_fboard")"; _f=1; }
  grep -q 'SENSOR-FAULT' "$_fboard" 2>/dev/null || { echo "  FAIL: a railed read must post the SENSOR-FAULT edge once, board was: $(cat "$_fboard")"; _f=1; }
  [ -s "$_fsd/.note3-motion-state" ] && { echo "  FAIL: a railed read must not write the verdict state (it would poison the next delta)"; _f=1; }
  # and the fault edge is DEBOUNCED — a second railed run must not repost
  MESH_DIR="$_fsd" MESH_SKIP_NODES_SOURCE=1 MESH_NOTE3_MOTION_BOARD="$_fboard" \
    NOTE3_MOTION_RAW_OVERRIDE='-32768,32767,17124' MESH_NOTE3_ADB_NODE=local MESH_BARO_ADB_NODE='' \
    "$0" --edge >/dev/null 2>&1
  [ "$(grep -c 'SENSOR-FAULT' "$_fboard" 2>/dev/null)" = 1 ] || { echo "  FAIL: the SENSOR-FAULT edge must post ONCE, not every poll: $(grep -c 'SENSOR-FAULT' "$_fboard")"; _f=1; }
  rm -rf "$_fsd" 2>/dev/null || true

  # ── live adb read-gate (mesh-land treats exit 2 = honest n/a as a pass) ──
  if [ -z "$NOTE3_ADB_NODE" ]; then
    [ "$_f" = 0 ] || { echo "smoke-test: FAIL (classifier contract violated)"; exit 1; }
    echo "smoke-test: n/a (MESH_NOTE3_ADB_NODE/MESH_BARO_ADB_NODE unset — Note3 body not configured on this node)"
    exit 2
  fi
  _live="$(note3_accel_raw)"
  if [ -z "$_live" ]; then
    [ "$_f" = 0 ] || { echo "smoke-test: FAIL (classifier contract violated)"; exit 1; }
    echo "smoke-test: n/a (adb body unreachable — Note3 accel sense unavailable)"
    exit 2
  fi
  _x="$(echo "$_live" | cut -d, -f1)"; _y="$(echo "$_live" | cut -d, -f2)"; _z="$(echo "$_live" | cut -d, -f3)"
  # A live reply exists, so the LANE is proven. What is left to judge is the ORGAN, and that is a
  # DIFFERENT claim wearing a different exit code. The old gate here was a scalar magnitude band
  # (1000 < |a| < 40000) that fired FAIL/exit 1 — a code-fault verdict on dead hardware, i.e. a
  # permanent RED no edit to this file can ever clear, which strands every unrelated fix behind
  # an autoland gate that will never go green. Sibling reasoning: scripts/uxn/mesh-note3-uxn-accel.
  if ! _why="$(sensor_fault "$_x" "$_y" "$_z")"; then
    [ "$_f" = 0 ] || { echo "smoke-test: FAIL (unit/integration contract violated — see the FAIL lines above; this is a CODE fault, not the dead organ below)"; exit 1; }
    echo "smoke-test: n/a — the lane is GREEN and the ORGAN is dead: $_why"
    exit 2
  fi
  [ "$_f" = 0 ] || { echo "smoke-test: FAIL (classify/parse/live-read contract violated)"; exit 1; }
  echo "smoke-test: ok (5 classifier + parse-gate + 6 sensor-fault unit + 5 relay-gate unit + 2 integration + LIVE adb read $_live, unrailed and carrying gravity)"
  exit 0
fi

# ─── relay-node gate: only the direct-adb owner runs the scheduled --edge poll (see is_relay_run) ─
if is_relay_run "${1:-}" "$NOTE3_ADB_NODE"; then
  echo "note3-motion: relay-skip (adb owner=$NOTE3_ADB_NODE; scheduled poll deferred to the direct-adb owner — no double board post)"
  exit 0
fi

# ─── live read ───────────────────────────────────────────────────────────
raw="$(note3_accel_raw)"
if [ -z "$raw" ]; then
  echo "note3-motion: UNREACHABLE (adb body offline/unreadable)" >&2
  [ "${1:-}" = --json ] && printf '{"verdict":"UNREACHABLE"}\n'
  exit 2
fi
x="$(echo "$raw" | cut -d, -f1)"; y="$(echo "$raw" | cut -d, -f2)"; z="$(echo "$raw" | cut -d, -f3)"

# ─── sensor-fault gate: a well-formed reading that MEASURES NOTHING is not a verdict ──────
# This runs on the LIVE path, not only in --test. With x and y pinned on the rails they are
# CONSTANTS, so they contribute exactly 0 to the Euclidean delta and every MOVED/STILL verdict
# below is |Δz| wearing a three-axis name — differencing a constant. The state file is left
# UNTOUCHED (writing a railed vector would poison the next delta too), and --edge posts the
# fault ONCE, debounced through the same EDGE_STATE, so the mesh learns the organ is dead
# instead of learning nothing. Rare and loud, never a plausible constant.
if ! why="$(sensor_fault "$x" "$y" "$z")"; then
  ts_f="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  case "${1:-}" in
    --json) printf '{"verdict":"SENSOR-FAULT","x":%s,"y":%s,"z":%s,"reason":"%s","ts":"%s"}\n' \
              "$x" "$y" "$z" "$(printf '%s' "$why" | tr -d '"')" "$ts_f" ;;
    --edge)
      prev_posted=""; [ -f "$EDGE_STATE" ] && prev_posted="$(cat "$EDGE_STATE" 2>/dev/null)"
      if [ "$prev_posted" != SENSOR-FAULT ]; then
        board="${MESH_NOTE3_MOTION_BOARD:-$MESH/chat.log}"
        printf '%s  note3-motion@%s  ::  [note3-motion] SENSOR-FAULT — %s\n' \
          "$ts_f" "$(hostname)" "$why" >> "$board" 2>/dev/null || true
        printf 'SENSOR-FAULT\n' > "$EDGE_STATE"
      fi
      echo "note3-motion: SENSOR-FAULT — $why" >&2 ;;
    *) echo "note3-motion: SENSOR-FAULT — $why" >&2 ;;
  esac
  exit 2
fi

px=""; py=""; pz=""
if [ -f "$STATE" ]; then
  IFS='|' read -r _pv px py pz _pts < "$STATE" 2>/dev/null || true
fi

result="$(classify "$x" "$y" "$z" "${px:-}" "${py:-}" "${pz:-}" "$MOVE_THRESH")"
verdict="$(echo "$result" | awk '{print $1}')"
delta="$(echo "$result" | awk '{print $2}')"
ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

printf '%s|%s|%s|%s|%s\n' "$verdict" "$x" "$y" "$z" "$ts" > "$STATE"
mesh-state-touch "$STATE" 2>/dev/null || touch "$STATE" 2>/dev/null || true   # ran-live liveness, independent of value-changed

case "${1:-}" in
  --json)
    printf '{"verdict":"%s","x":%s,"y":%s,"z":%s,"delta":"%s","ts":"%s"}\n' "$verdict" "$x" "$y" "$z" "$delta" "$ts"
    ;;
  --edge)
    prev_posted=""
    [ -f "$EDGE_STATE" ] && prev_posted="$(cat "$EDGE_STATE" 2>/dev/null)"
    if [ "$verdict" != "$prev_posted" ] && [ "$verdict" != INIT ]; then
      board="${MESH_NOTE3_MOTION_BOARD:-$MESH/chat.log}"
      ts_board="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
      printf '%s  note3-motion@%s  ::  [note3-motion] %s (delta=%s vs prior read)\n' "$ts_board" "$(hostname)" "$verdict" "$delta" >> "$board" 2>/dev/null || true
      printf '%s\n' "$verdict" > "$EDGE_STATE"
    elif [ "$verdict" = INIT ]; then
      printf '%s\n' "$verdict" > "$EDGE_STATE"
    fi
    printf 'note3-motion: %s (delta=%s)\n' "$verdict" "$delta"
    ;;
  *)
    printf 'note3-motion: %s (x=%s y=%s z=%s delta=%s)\n' "$verdict" "$x" "$y" "$z" "$delta"
    ;;
esac
exit 0
