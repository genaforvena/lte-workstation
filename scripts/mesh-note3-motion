#!/usr/bin/env bash
# reflex-cadence: 4-59/5 * * * *
# reflex-args: --edge
# mesh-note3-motion — the Note3's OWN accelerometer (MPU6500, /sys/class/sensors/accelerometer_sensor/
# raw_data) as a MOVED/STILL edge sense for its fixed craft-room location, via the SAME adb->ds relay
# mesh-baro/mesh-note3-desk already use.
#
# WHY THIS IS NEW: capability-note3-ir-proximity-gesture-20260707.md's sensor census found the MPU6500
# accel reads LIVE with no enable step (raw_data=16178,-45,-1237, stable across reads a second apart)
# but flagged it "not pre-built" (PLAN doctrine: note the find, wire on demand). mesh-note3-desk already
# fuses this same phone's proximity+light into DESK OCCUPANCY; nothing reads the Note3's own
# accelerometer, which answers a different question neither of those two can: has the PHONE ITSELF been
# touched, picked up, or reoriented since the last read — a tamper/handling edge for a device that
# otherwise just sits fixed in the craft room. (raw_data is on-change/cached per this HAL, not a live
# vibration stream, so the honest sense here is a discrete MOVED/STILL edge from comparing successive
# vectors, not continuous IMU data.)
#
# Honest contract: adb/ssh unreachable OR raw_data unparsable -> UNREACHABLE, exit 2, never fake a
# reading. Orientation semantics (which physical face is "up") are NOT claimed — verifying axis-to-
# physical-orientation mapping would need hands in the craft room, which this node doesn't have,
# so the verdict stays in the sensor's own coordinate frame (raw vector + Euclidean delta) rather than
# a fabricated "face up/down" label (no-fabricated-physical-descriptions).
#
#   mesh-note3-motion            one-shot verdict (INIT|STILL|MOVED) + vector + delta
#   mesh-note3-motion --json     machine-readable
#   mesh-note3-motion --edge     debounced state write; board post ONLY on a STILL<->MOVED transition
#   mesh-note3-motion --test     fixture-driven classifier smoke test + live adb read-gate
#
# Exit: 0 = assessed (INIT/STILL/MOVED) · 2 = adb body unreachable (honest n/a, never faked)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes"

MESH="${MESH_DIR:-$HOME/.mesh}"; mkdir -p "$MESH" 2>/dev/null || true
STATE="$MESH/.note3-motion-state"          # "verdict|x|y|z|ts"
EDGE_STATE="$MESH/.note3-motion-edge"      # last POSTED verdict (for --edge dedup)

# Note3 body is the SAME fixed adb->ds relay mesh-baro/mesh-note3-desk use; falls back to the
# baro node vars so a single ~/.mesh/nodes entry covers every Note3-body sense.
NOTE3_ADB_NODE="${MESH_NOTE3_ADB_NODE:-${MESH_BARO_ADB_NODE:-}}"
NOTE3_ADB_SERIAL="${MESH_NOTE3_ADB_SERIAL:-${MESH_BARO_ADB_SERIAL:-}}"
# Ambient noise band unknown yet (first-cut, generous): MPU6500 default full-scale is commonly
# +-2g = 16384 LSB/g, so 400 raw units is ~2.4% of 1g — well above read-to-read jitter on a resting
# phone (observed live: 16178,-45,-1237 then 16247,-414,-104 a few seconds apart, delta ~380) yet far
# below an actual pick-up/reorientation (which swings a full axis by thousands of units).
MOVE_THRESH="${MESH_NOTE3_MOTION_THRESH:-900}"

# note3_accel_raw — live "x,y,z" from the MPU6500 sysfs node. Empty + rc1 on any failure (adb down,
# ssh down, malformed output). Test override: NOTE3_MOTION_RAW_OVERRIDE skips the network entirely.
note3_accel_raw() {
  local out
  if [ -n "${NOTE3_MOTION_RAW_OVERRIDE:-}" ]; then
    out="$NOTE3_MOTION_RAW_OVERRIDE"
  else
    [ -z "$NOTE3_ADB_NODE" ] && return 1
    local ser=""; [ -n "$NOTE3_ADB_SERIAL" ] && ser="-s $NOTE3_ADB_SERIAL"
    if [ "$NOTE3_ADB_NODE" = local ]; then
      out="$(timeout 15 adb $ser shell 'cat /sys/class/sensors/accelerometer_sensor/raw_data' 2>/dev/null)"
    else
      out="$(timeout 20 ssh -o BatchMode=yes -o ConnectTimeout=8 -o StrictHostKeyChecking=accept-new \
        "$NOTE3_ADB_NODE" "adb $ser shell 'cat /sys/class/sensors/accelerometer_sensor/raw_data'" </dev/null 2>/dev/null)"
    fi
  fi
  out="$(printf '%s' "$out" | tr -d '[:space:]')"
  printf '%s' "$out" | grep -qE '^-?[0-9]+,-?[0-9]+,-?[0-9]+$' || return 1
  printf '%s' "$out"
}

# classify <x> <y> <z> <prev_x|""> <prev_y> <prev_z> <thresh> -> "VERDICT DELTA"
# DELTA is "-" for INIT (no prior vector to compare against). Pure function — no I/O — directly testable.
classify() {
  local x="$1" y="$2" z="$3" px="$4" py="$5" pz="$6" thresh="$7"
  if [ -z "$px" ]; then printf 'INIT -\n'; return; fi
  python3 -c "
import math
d = math.sqrt(($x-$px)**2 + ($y-$py)**2 + ($z-$pz)**2)
print(('MOVED' if d >= $thresh else 'STILL'), '%.0f' % d)
"
}

# ─── --test: fixture-driven classifier + live adb read-gate ────────────────
if [ "${1:-}" = --test ]; then
  command -v python3 >/dev/null 2>&1 || { echo "smoke-test: FAIL (no python3)"; exit 1; }
  _f=0

  r="$(classify 16178 -45 -1237 "" "" "" "$MOVE_THRESH")"
  [ "$(echo "$r" | awk '{print $1}')" = INIT ] || { echo "  FAIL: no prior vector must be INIT, got '$r'"; _f=1; }

  r="$(classify 16200 -50 -1250 16178 -45 -1237 900)"
  [ "$(echo "$r" | awk '{print $1}')" = STILL ] || { echo "  FAIL: tiny jitter (delta~26) should be STILL, got '$r'"; _f=1; }

  r="$(classify -16000 100 200 16178 -45 -1237 900)"
  [ "$(echo "$r" | awk '{print $1}')" = MOVED ] || { echo "  FAIL: axis flip (phone flipped) should be MOVED, got '$r'"; _f=1; }

  r="$(classify 16178 -45 -1237 16178 -45 -1237 900)"
  [ "$(echo "$r" | awk '{print $1}')" = STILL ] || { echo "  FAIL: identical vector (delta=0) should be STILL, got '$r'"; _f=1; }
  [ "$(echo "$r" | awk '{print $2}')" = "0" ]   || { echo "  FAIL: identical vector delta should print 0, got '$r'"; _f=1; }

  # parse gate: malformed raw_data must be rejected by note3_accel_raw, never silently accepted
  NOTE3_MOTION_RAW_OVERRIDE="not,a,vector,x" note3_accel_raw >/dev/null 2>&1 && { echo "  FAIL: malformed raw_data must be rejected"; _f=1; }
  NOTE3_MOTION_RAW_OVERRIDE="1,2,3" note3_accel_raw >/dev/null 2>&1 || { echo "  FAIL: well-formed raw_data must be accepted"; _f=1; }

  # ── live adb read-gate (mesh-land treats exit 2 = honest n/a as a pass) ──
  if [ -z "$NOTE3_ADB_NODE" ]; then
    [ "$_f" = 0 ] || { echo "smoke-test: FAIL (classifier contract violated)"; exit 1; }
    echo "smoke-test: n/a (MESH_NOTE3_ADB_NODE/MESH_BARO_ADB_NODE unset — Note3 body not configured on this node)"
    exit 2
  fi
  _live="$(note3_accel_raw)"
  if [ -z "$_live" ]; then
    [ "$_f" = 0 ] || { echo "smoke-test: FAIL (classifier contract violated)"; exit 1; }
    echo "smoke-test: n/a (adb body unreachable — Note3 accel sense unavailable)"
    exit 2
  fi
  _x="$(echo "$_live" | cut -d, -f1)"; _y="$(echo "$_live" | cut -d, -f2)"; _z="$(echo "$_live" | cut -d, -f3)"
  _ok="$(python3 -c "
import math
m = math.sqrt($_x**2 + $_y**2 + $_z**2)
print(1 if 1000 < m < 40000 else 0)
" 2>/dev/null)"
  [ "$_ok" = 1 ] || { echo "  FAIL: live vector magnitude implausible for an accelerometer at rest: $_live"; _f=1; }
  [ "$_f" = 0 ] || { echo "smoke-test: FAIL (classify/parse/live-read contract violated)"; exit 1; }
  echo "smoke-test: ok (5 classifier + parse-gate assertions + LIVE adb read $_live)"
  exit 0
fi

# ─── live read ───────────────────────────────────────────────────────────
raw="$(note3_accel_raw)"
if [ -z "$raw" ]; then
  echo "note3-motion: UNREACHABLE (adb body offline/unreadable)" >&2
  [ "${1:-}" = --json ] && printf '{"verdict":"UNREACHABLE"}\n'
  exit 2
fi
x="$(echo "$raw" | cut -d, -f1)"; y="$(echo "$raw" | cut -d, -f2)"; z="$(echo "$raw" | cut -d, -f3)"

px=""; py=""; pz=""
if [ -f "$STATE" ]; then
  IFS='|' read -r _pv px py pz _pts < "$STATE" 2>/dev/null || true
fi

result="$(classify "$x" "$y" "$z" "${px:-}" "${py:-}" "${pz:-}" "$MOVE_THRESH")"
verdict="$(echo "$result" | awk '{print $1}')"
delta="$(echo "$result" | awk '{print $2}')"
ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

printf '%s|%s|%s|%s|%s\n' "$verdict" "$x" "$y" "$z" "$ts" > "$STATE"
mesh-state-touch "$STATE" 2>/dev/null || touch "$STATE" 2>/dev/null || true   # ran-live liveness, independent of value-changed

case "${1:-}" in
  --json)
    printf '{"verdict":"%s","x":%s,"y":%s,"z":%s,"delta":"%s","ts":"%s"}\n' "$verdict" "$x" "$y" "$z" "$delta" "$ts"
    ;;
  --edge)
    prev_posted=""
    [ -f "$EDGE_STATE" ] && prev_posted="$(cat "$EDGE_STATE" 2>/dev/null)"
    if [ "$verdict" != "$prev_posted" ] && [ "$verdict" != INIT ]; then
      board="${MESH_NOTE3_MOTION_BOARD:-$MESH/chat.log}"
      ts_board="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
      printf '%s  note3-motion@%s  ::  [note3-motion] %s (delta=%s vs prior read)\n' "$ts_board" "$(hostname)" "$verdict" "$delta" >> "$board" 2>/dev/null || true
      printf '%s\n' "$verdict" > "$EDGE_STATE"
    elif [ "$verdict" = INIT ]; then
      printf '%s\n' "$verdict" > "$EDGE_STATE"
    fi
    printf 'note3-motion: %s (delta=%s)\n' "$verdict" "$delta"
    ;;
  *)
    printf 'note3-motion: %s (x=%s y=%s z=%s delta=%s)\n' "$verdict" "$x" "$y" "$z" "$delta"
    ;;
esac
exit 0
