#!/usr/bin/env bash
# mesh-board-unstale — scan board for [taking] claims >30min old with no [done]/update
# from same agent. Converts back to [task] via [task-unstale] marker for re-dispatch.
# Complements mesh-failover (catches claims that rot without a [mind-limited] trigger).
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
BOARD="${BOARD:-$HOME/.mesh/chat.log}"
NOW=$(date -u +%s)
STALE=$((30 * 60))

_scan_board() {
  local board="$1" now="$2" stale="$3"
  TODAY=$(date -u +%Y-%m-%d)
  SESS=$(hostname)
  grep "^${TODAY}T" "$board" 2>/dev/null | grep ' ::  \[taking\]' | while IFS= read -r line; do
    ts=$(echo "$line" | cut -d' ' -f1)
    agent=$(echo "$line" | sed 's/^[^ ]*  \([^ ]*\)  ::.*/\1/')
    desc=$(echo "$line" | sed 's/.* ::  \[taking\] //')
    [ -z "$desc" ] && continue

    taskname=$(echo "$desc" | sed 's/^\([^ :–—]*[ :–—]\{0,2\}[^ :–—]*\)[ :–—].*/\1/' | sed 's/[ –—]*$//')
    [ -z "$taskname" ] && taskname=$(echo "$desc" | cut -c1-40)
    [ ${#taskname} -lt 3 ] && taskname=$(echo "$desc" | cut -c1-40)

    ts_sec=$(date -u -d "$(echo "$ts" | sed 's/Z$//')" +%s 2>/dev/null) || continue
    [ $((now - ts_sec)) -lt "$stale" ] && continue

    grep "^${TODAY}T" "$board" 2>/dev/null | grep ' ::  \[done\]' | grep -qF "$taskname" && continue

    newer=$(grep "^${TODAY}T" "$board" 2>/dev/null | grep ' ::  \[taking\]' | grep -F "$agent" | while IFS= read -r l; do
      lts=$(echo "$l" | cut -d' ' -f1)
      [ "$lts" \> "$ts" ] 2>/dev/null && echo "$l"
    done)
    [ -n "$newer" ] && continue

    grep "^${TODAY}T" "$board" 2>/dev/null | grep '\[task-unstale\]' | grep -qF "$taskname" && continue

    age=$((now - ts_sec))
    MESH_WHO="board-unstale@${SESS}" mesh-chat \
      "[task-unstale] ${desc} (was [taking] by ${agent} at $(echo "$ts" | cut -dT -f2 | cut -d. -f1), no [done] in ${age}s)"
  done
}

if [ "${1:-}" = "--test" ]; then
  command -v mesh-chat >/dev/null 2>&1 || { echo "FAIL (no mesh-chat)"; exit 1; }
  TMPBOARD=$(mktemp)
  CAPTURE=$(mktemp)
  trap 'rm -f "$TMPBOARD" "$CAPTURE"' EXIT

  mesh-chat() { printf '%s\n' "$*" >> "$CAPTURE"; }

  # Test 1: stale claim (>30min old, no [done]) → should unstale
  STALE_TS=$(date -u -d "-35 minutes" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo "2026-06-18T13:00:00Z")
  cat > "$TMPBOARD" << BOARD
${STALE_TS}  agent-alpha  ::  [taking] fix-the-foo: investigate widget crasher
2026-06-18T14:00:00Z  agent-beta  ::  [taking] bar thing — a normal task
2026-06-18T14:01:00Z  agent-beta  ::  [done] bar thing — a normal task
BOARD
  _scan_board "$TMPBOARD" "$(date -u +%s)" 1800
  if grep -q 'fix-the-foo' "$CAPTURE"; then
    echo "  ok: stale claim detected"
  else
    echo "  FAIL: stale claim not detected"
    cat "$CAPTURE"; exit 1
  fi
  if grep -q 'bar thing' "$CAPTURE"; then
    echo "  FAIL: completed claim spuriously unstaled"
    exit 1
  fi
  echo "  ok: completed claim not unstaled"

  # Test 2: fresh claim (under 30min) → should NOT be unstaled
  > "$TMPBOARD"
  FRESH_TS=$(date -u -d "-10 minutes" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo "2026-06-18T14:20:00Z")
  cat > "$TMPBOARD" << BOARD
${FRESH_TS}  agent-gamma  ::  [taking] fresh-task: still working
BOARD
  > "$CAPTURE"
  _scan_board "$TMPBOARD" "$(date -u +%s)" 1800
  if [ -s "$CAPTURE" ]; then
    echo "  FAIL: fresh claim unstaled"
    exit 1
  fi
  echo "  ok: fresh claim not unstaled"

  echo "smoke-test: ok"
  exit 0
fi

_scan_board "$BOARD" "$NOW" "$STALE"
