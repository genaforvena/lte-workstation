#!/usr/bin/env bash
# orphan-ok: on-demand NVIDIA GPU cooling diagnosis; no periodic consumer currently needs fan duty.
# mesh-gpu-fan — NVIDIA driver's live GPU fan duty percentage.
# This is the percentage reported by the driver, not RPM and not inferred from temperature.
# Unavailable GPU/driver data is UNKNOWN (exit 2).
#
#   mesh-gpu-fan          one live reading
#   mesh-gpu-fan --json   machine-readable reading
#   mesh-gpu-fan --test   fixture parser + a real hardware read
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"

SMI="${MESH_GPU_FAN_SMI:-nvidia-smi}"

read_fan() {
  local raw first index pct
  raw="$("$SMI" --query-gpu=index,fan.speed --format=csv,noheader,nounits 2>/dev/null)" || return 2
  first="$(printf '%s\n' "$raw" | sed '/^[[:space:]]*$/d' | head -n1)"
  [ -n "$first" ] || return 2
  IFS=',' read -r index pct _rest <<<"$first"
  index="$(printf '%s' "${index:-}" | tr -d '[:space:]')"
  pct="$(printf '%s' "${pct:-}" | tr -d '[:space:]')"
  case "$index" in ''|*[!0-9]*) return 2;; esac
  case "$pct" in ''|*[!0-9]*) return 2;; esac
  [ "$pct" -le 100 ] || return 2
  printf '%s %s\n' "$index" "$pct"
}

if [ "${1:-}" = --test ]; then
  td="$(mktemp -d)" || { echo 'mesh-gpu-fan --test: FAIL (mktemp)' >&2; exit 1; }
  trap 'rm -rf "$td"' EXIT
  cat >"$td/smi" <<'EOF'
#!/usr/bin/env bash
printf '0, 37\n'
EOF
  chmod +x "$td/smi"
  fixture="$(MESH_GPU_FAN_SMI="$td/smi" "$0" --json)" || {
    echo 'mesh-gpu-fan --test: FAIL (fixture read)' >&2; exit 1;
  }
  [[ "$fixture" == *'"gpu_index":0,"fan_speed_percent":37'* ]] || {
    echo "mesh-gpu-fan --test: FAIL (fixture parse: $fixture)" >&2; exit 1;
  }
  cat >"$td/smi" <<'EOF'
#!/usr/bin/env bash
printf '0, N/A\n'
EOF
  chmod +x "$td/smi"
  MESH_GPU_FAN_SMI="$td/smi" "$0" --json >/dev/null 2>&1
  rc=$?
  [ "$rc" -eq 2 ] || { echo "mesh-gpu-fan --test: FAIL (N/A must exit 2, got $rc)" >&2; exit 1; }

  live="$("$0" --json 2>/dev/null)"
  rc=$?
  if [ "$rc" -eq 2 ]; then
    echo 'mesh-gpu-fan --test: n/a — fixture passed; live NVIDIA fan data unavailable (exit 2)' >&2
    exit 2
  fi
  [[ "$live" =~ \"fan_speed_percent\":[0-9]+ ]] || {
    echo "mesh-gpu-fan --test: FAIL (live reading malformed: $live)" >&2; exit 1;
  }
  echo "mesh-gpu-fan --test: PASS (fixture, N/A exit-2, real NVIDIA driver read: $live)"
  exit 0
fi

mode=text
case "${1:-}" in
  '') ;;
  --json) mode=json;;
  *) echo 'usage: mesh-gpu-fan [--json|--test]' >&2; exit 1;;
esac

reading="$(read_fan)" || {
  echo 'gpu-fan: UNREACHABLE — nvidia-smi did not provide a numeric fan.speed' >&2
  exit 2
}
read -r gpu_index percent <<<"$reading"
if [ "$mode" = json ]; then
  printf '{"gpu_index":%s,"fan_speed_percent":%s,"source":"nvidia-smi"}\n' "$gpu_index" "$percent"
else
  printf '[gpu-fan] gpu_index=%s fan_speed_percent=%s (driver-reported duty; not RPM)\n' "$gpu_index" "$percent"
fi
