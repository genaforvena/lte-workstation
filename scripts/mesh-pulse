#!/usr/bin/env bash
# mesh-pulse — detector LIVENESS layer: "what detects when the detector itself died?" (operator
# 2026-06-21). A detector that fails SILENT reads identical to "all-clear" — the most dangerous
# reading (a dead sensor and a real green look the same). mesh-doctor was cron-orphaned and blind
# for 28h; mesh-resource-guard froze 5 days, trusted as live; reflex-health watched only 5 of ~18
# detectors and could not watch ITSELF. This layer closes that.
#
# TWO MECHANISMS, by design:
#   1. PULSE — every detector leaves a per-run heartbeat (a `.beat` touched EVERY run, even on
#      no-news). Absence-of-pulse against a dumb clock is the alarm — we detect death by SILENCE,
#      not by an active probe (an active probe dies the same silent death). For detectors that
#      already rewrite a per-run artifact (a log/state) we reuse THAT as the beat (no edit needed);
#      silent-on-no-news detectors (edge/alert tools) call `mesh-pulse beat <name>` explicitly.
#   2. OUTSIDE-THE-LOOP GROUNDING — `mesh-pulse check` runs from a SYSTEMD timer, a categorically
#      different substrate than the user crontab that drops everything at once on a reorg (the
#      actual, repeated failure mode). So if cron dies wholesale, the systemd-grounded checker
#      still fires and sees every cron pulse go stale — INCLUDING doctor and reflex-health. The
#      regress terminates not in a smarter watcher (it dies too) but in the SIMPLEST possible one
#      on a more durable substrate. `--export` writes a one-line summary a PEER node can read to
#      ground THIS box from off-node (the final terminator: a dead box can't fake a remote pulse).
#
#   mesh-pulse beat <name>     touch this detector's heartbeat (call once per run; safe, never fails caller)
#   mesh-pulse check           grade every detector's freshness vs the cadence table; edge-post stale/ok
#   mesh-pulse check --quiet   same, no stdout (systemd mode)
#   mesh-pulse table           print the cadence registry (the source of truth)
#   mesh-pulse status          read-only one-line-per-detector report (no board post)
#   mesh-pulse --export        write ~/.mesh/.pulse-summary (one line, peer-readable)
#   mesh-pulse --install       write + enable the systemd --user timer that grounds this from off-cron
#   mesh-pulse --test          smoke test
#
# NOT a cron reflex (no # reflex-cadence header — deliberately): the whole point is to live OUTSIDE
# cron. It is wired as a systemd --user timer (mesh-pulse-check.timer). autowire must not pull it in.
# orphan-ok: systemd-grounded via mesh-pulse-check.timer (`mesh-pulse --install`) — off-cron BY DESIGN,
# so the cron-orphan check must not flag it (it is wired, just not to crontab — that's the whole point).
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
M="${MESH_DIR:-$HOME/.mesh}"
PULSE="$M/pulse"
STATE="$M/.pulse-check-state"     # last verdict per detector (edge-trigger memory)
SUMMARY="$M/.pulse-summary"       # one-line peer-readable export
ts(){ date -u +%FT%TZ; }
now(){ date +%s; }

# ── max_age DERIVATION (single source of truth = the LIVE cron stride; never a duplicated literal) ──
# (chat-review/maxage-from-cadence 2026-06-24) — the registry's max-age column is an INTENT token, not a
# number; see the registry header below for @auto / @auto=PARENT / @cond / <literal>.
CRON_SRC="${MESH_CRON_SRC:-$M/reflexes.cron}"
cron_stride_s(){ # <tool> → its cron stride in SECONDS (0 = no derivable schedule found)
  local tool="$1" line min hr
  line="$(grep -hwE -- "$tool" "$CRON_SRC" 2>/dev/null | grep -vE '^[[:space:]]*#' | head -1)"
  [ -n "$line" ] || line="$(crontab -l 2>/dev/null | grep -hwE -- "$tool" | grep -vE '^[[:space:]]*#' | head -1)"
  [ -n "$line" ] || { echo 0; return; }
  min="$(printf '%s\n' "$line" | awk '{print $1}')"; hr="$(printf '%s\n' "$line" | awk '{print $2}')"
  case "$min" in
    \*/[0-9]*)        echo $(( ${min#*/} * 60 ));;           # */N            → every N min
    [0-9]*-*/[0-9]*)  echo $(( ${min##*/} * 60 ));;          # M-E/N          → every N min (stepped range)
    *[,?]*)           echo 0;;                               # list / unsupported → un-derivable
    [0-9]*)           case "$hr" in                          # bare minute → consult the HOUR field
                        \*)         echo 3600;;              # M * * * *     → hourly
                        \*/[0-9]*)  echo $(( ${hr#*/} * 3600 ));;  # M */H * * * → every H hours
                        *)          echo 86400;;             # M H * * *     → daily
                      esac;;
    *)                echo 0;;
  esac
}
eff_maxage(){ # <intent-token> <tool> → max_age seconds, or "skip" (conditional-write / un-derivable)
  local raw="$1" tool="$2" s
  case "$raw" in
    @cond)    echo skip;;                                                          # not watchable, ever
    @auto)    s="$(cron_stride_s "$tool")";          [ "${s:-0}" -gt 0 ] && echo $((s*2)) || echo skip;;
    @auto=*)  s="$(cron_stride_s "${raw#@auto=}")";  [ "${s:-0}" -gt 0 ] && echo $((s*2)) || echo skip;;
    *)        echo "$raw";;                                                        # explicit literal
  esac
}

# ── DEBOUNCE (watchdog-debounce 2026-06-24): a detector flips STALE only after N>=2 CONSECUTIVE failed
# probes. A SINGLE transient fail (torn read of the beat, a daemon mid-restart) stays OK → no false-DOWN
# alarm. Counter persisted per-detector across runs in ~/.mesh/.debounce/<key>; first OK resets it. Only
# the scheduled `check` mutates; read-only `status`/`--export` PEEK (a manual look can't force a DOWN). ──
DEBOUNCE_DIR="${MESH_DEBOUNCE_DIR:-$M/.debounce}"
DEBOUNCE_N="${MESH_DEBOUNCE_N:-2}"
debounce(){ # <key> <ok|fail> [peek] → effective verdict UP|DOWN; mutates the counter UNLESS peek
  local key="$1" probe="$2" mode="${3:-}" f n
  key="$(printf '%s' "$key" | tr -c 'A-Za-z0-9._-' '_')"
  f="$DEBOUNCE_DIR/$key"; mkdir -p "$DEBOUNCE_DIR" 2>/dev/null || true
  n="$(cat "$f" 2>/dev/null || echo 0)"; [ "$n" -eq "$n" ] 2>/dev/null || n=0
  if [ "$probe" = ok ]; then [ "$mode" = peek ] || rm -f "$f" 2>/dev/null || true; echo UP; return; fi
  n=$((n+1)); [ "$mode" = peek ] || printf '%s\n' "$n" > "$f" 2>/dev/null || true
  [ "$n" -ge "$DEBOUNCE_N" ] && echo DOWN || echo UP
}

# ---- the cadence registry: SOURCE OF TRUTH for what MUST beat -------------------------------------
# name | reuse-artifact (per-run file already written, or "-" for beat-only) | MAX-AGE INTENT TOKEN | tool-match
# MAX-AGE IS DERIVED, NOT A LITERAL (chat-review/maxage-from-cadence 2026-06-24 — ends the phantom-stale
# whack-a-mole; no more hand-patched numbers drifting out of sync with cron). The 3rd column is an INTENT
# token resolved by eff_maxage() against the LIVE cron stride (single source of truth = reflexes.cron/
# crontab):
#   @auto        → max_age = (this tool's cron stride)×2. SELF-ADJUSTS to a throttle (the throttle IS in
#                  the cron we read) → the old 4500s widening for the 2026-06-24 /30 throttle is now moot.
#   @auto=PARENT → derive from PARENT's stride (a reflex sub-called by another, with no own cron line).
#   @cond        → CONDITIONAL-WRITE (feed/generate: `pace_gate||exit 0` WITHOUT a beat on quiet/all-busy
#                  ticks) → mtime is NOT liveness at ANY threshold → NOT WATCHABLE, excluded outright.
#                  cadence×2 would only move the phantom to a longer fuse (the feed lesson, mesh-reflex-
#                  health:47) — so feed is @cond here, NOT the 3000s I earlier band-aided it to.
#   <number>     → explicit literal, only for a detector with no derivable cron line.
# Widen the WATCHDOG to match real cron, never the reverse — see root_cause_hint below + memory
# autowire-add-only-cadence-drift-false-dead. tool-match → node-aware: a detector not in THIS node's
# crontab is skipped (not its node's reflex).
registry(){ cat <<EOF
doctor|$M/doctor.log|@auto|mesh-doctor
reflex-health|$M/.reflex-health-state|@auto|mesh-reflex-health
health-state|$M/.mesh-health|@auto|mesh-health-state
therm-watch|$M/.therm-state|@auto|mesh-therm-watch
vpn-health|$M/vpn-health.log|@auto|mesh-vpn-health
vpn-watchdog|-|@auto|mesh-vpn-watchdog
feed|$M/feed.log|@cond|mesh-feed
sense-evolve|$M/sense-evolve.log|@auto|mesh-sense-evolve
fleet-health|$M/.fleet-health.cache|@auto|mesh-fleet-health
gate-watch|$M/.gate-state|@auto|mesh-gate-watch
stress|-|@auto|mesh-stress
net-drop|-|@auto|mesh-net-drop
hw-health|-|@auto|mesh-hw-health
watchtower|-|@auto|mesh-watchtower
criticality|-|@auto|mesh-criticality
algedonic|-|@auto|mesh-algedonic
psi|-|@auto|mesh-psi
EOF
}

# freshest mtime among the reuse-artifact and the explicit beat (epoch; 0 if neither exists).
last_beat(){ # <name> <artifact>
  local name="$1" art="$2" b="$PULSE/$1.beat" m=0 t
  [ "$art" != "-" ] && [ -e "$art" ] && { t=$(stat -c %Y "$art" 2>/dev/null || echo 0); [ "$t" -gt "$m" ] && m=$t; }
  [ -e "$b" ] && { t=$(stat -c %Y "$b" 2>/dev/null || echo 0); [ "$t" -gt "$m" ] && m=$t; }
  echo "$m"
}

cron_has(){ crontab -l 2>/dev/null | grep -vE '^\s*#' | grep -q "$1"; }

beat(){ # <name> — never fail the caller; atomic touch
  local name="${1:?}"; mkdir -p "$PULSE" 2>/dev/null || true
  : > "$PULSE/$name.beat" 2>/dev/null || true
}

# grade every detector → fills global arrays; returns 0 always. Result lines: "name verdict age max"
grade(){
  local n; CNT=0; STALE=0; OK=0; SKIP=0; RESULT=""
  local cronlist; cronlist="$(crontab -l 2>/dev/null | grep -vE '^\s*#')"
  while IFS='|' read -r name art maxage tool; do
    [ -n "${name:-}" ] || continue
    local eff; eff="$(eff_maxage "$maxage" "$tool")"
    # @cond conditional-write (feed/generate) OR un-derivable cron → NOT watchable by mtime, EVER
    if [ "$eff" = skip ]; then
      RESULT+="$name SKIP - cond"$'\n'; SKIP=$((SKIP+1)); continue
    fi
    # node-aware: detector not scheduled here → not this node's responsibility
    if ! printf '%s' "$cronlist" | grep -q "$tool"; then
      RESULT+="$name SKIP - $eff"$'\n'; SKIP=$((SKIP+1)); continue
    fi
    CNT=$((CNT+1))
    local mt age v raw
    mt="$(last_beat "$name" "$art")"
    if [ "$mt" -eq 0 ]; then age=-1; raw=fail
    else age=$(( $(now) - mt )); [ "$age" -gt "$eff" ] && raw=fail || raw=ok; fi
    # DEBOUNCE: a detector flips STALE only after N>=2 CONSECUTIVE fails; one transient fail stays OK (no alarm).
    # DB_MODE=peek (read-only status/--export) reads the counter without advancing it.
    if [ "$raw" = fail ]; then
      [ "$(debounce "pulse.$name" fail "${DB_MODE:-}")" = DOWN ] && v=STALE || v=OK
    else
      debounce "pulse.$name" ok "${DB_MODE:-}" >/dev/null; v=OK
    fi
    [ "$v" = STALE ] && STALE=$((STALE+1)) || OK=$((OK+1))
    RESULT+="$name $v $age $eff"$'\n'
  done < <(registry)
  printf '%s' "$RESULT"
}

# root_cause_hint <res> — spare the operator re-chasing a BENIGN stale. A detector that was deliberately
# THERMAL-THROTTLED or whose cron cadence DRIFTED still BEATS — just slower than max_age — so its age is
# finite and only modestly over max (≤3× here). A truly dead one never beat (age=-1) or is long past
# (>3×max). Several detectors modestly-over together = systemic (a cron-wide throttle/pause), not N
# independent deaths — the exact false alarm this mesh keeps re-chasing (cf. the 2026-06-24 /10→/30
# autopoiesis throttle that aged psi/sense-evolve past their 1500s registry max). The tag is a HINT
# ('?') + a VERIFY step, NEVER a suppression: it is emitted ONLY when NO detector is missing or long-dead,
# so a real death never gets a benign label — the alert stays scary whenever anything is actually gone.
root_cause_hint(){
  local res="$1" slow=0 dead=0 missing=0 name v age max
  while read -r name v age max; do
    [ "$v" = STALE ] || continue
    if [ "${age:-0}" -eq -1 ] 2>/dev/null; then missing=$((missing+1))
    elif [ "${age:-0}" -le $((max*3)) ] 2>/dev/null; then slow=$((slow+1))
    else dead=$((dead+1)); fi
  done <<< "$res"
  [ "$missing" -gt 0 ] || [ "$dead" -gt 0 ] && return 0   # any real-death candidate → no benign tag
  [ "$slow" -ge 1 ] || return 0
  local who; if [ "$slow" -ge 2 ]; then who="$slow detectors only modestly past max (still beating, slower) → SYSTEMIC: thermal-throttle|cadence-drift, NOT $slow deaths"; else who="beating, just slower than max_age → thermal-throttle|cadence-drift"; fi
  printf ' [root-cause? %s. VERIFY before re-chasing: mesh-reflex-health --check; compare each tool cron stride vs its `# reflex-cadence` header — if cron was deliberately throttled, widen the WATCHDOG max_age (here + mesh-reflex-health), do NOT speed cron.]' "$who"
}

case "${1:-}" in
  beat)   beat "${2:?mesh-pulse beat <name>}"; ;;
  table)  registry ;;
  --install)
    # Plant the outside-the-loop grounding: a systemd --user timer (a substrate independent of the
    # crontab that drops everything at once on a reorg). Idempotent — safe to re-run on any node.
    ud="$HOME/.config/systemd/user"; mkdir -p "$ud"
    cat > "$ud/mesh-pulse-check.service" <<'UNIT'
[Unit]
Description=mesh-pulse detector-liveness check — outside-the-loop grounding for the cron reflex layer
Documentation=man:mesh-pulse

[Service]
Type=oneshot
ExecStart=%h/.local/bin/mesh-pulse check --quiet
Nice=10
UNIT
    cat > "$ud/mesh-pulse-check.timer" <<'UNIT'
[Unit]
Description=Run mesh-pulse check every 5 min (systemd substrate, independent of the user crontab)

[Timer]
OnBootSec=2min
OnUnitActiveSec=5min
Persistent=true

[Install]
WantedBy=timers.target
UNIT
    systemctl --user daemon-reload 2>/dev/null || { echo "mesh-pulse --install: no systemd --user here — grounding NOT planted" >&2; exit 1; }
    systemctl --user enable --now mesh-pulse-check.timer 2>/dev/null
    loginctl enable-linger "$(id -un)" 2>/dev/null || true   # fire without an active login session
    echo "mesh-pulse --install: systemd timer planted + enabled (next: $(systemctl --user list-timers mesh-pulse-check.timer --no-pager 2>/dev/null | awk 'NR==2{print $1,$2,$3}'))"
    ;;
  status|check|--export)
    mkdir -p "$M" "$PULSE"
    # only the SCHEDULED `check` mutates the debounce counter; read-only status/--export PEEK it
    DB_MODE=peek; [ "${1:-}" = check ] && DB_MODE=""
    res="$(grade)"
    stale="$(printf '%s' "$res" | awk '$2=="STALE"{print $1}' | tr '\n' ' ' | sed 's/ $//')"
    nstale=$(printf '%s' "$res" | awk '$2=="STALE"{c++} END{print c+0}')
    nok=$(printf '%s' "$res" | awk '$2=="OK"{c++} END{print c+0}')
    summ="$(ts) pulse: $nok ok, $nstale stale${stale:+ — STALE: $stale}"
    # always refresh the peer-readable export
    printf '%s\n' "$summ" > "$SUMMARY"
    if [ "${1:-}" = status ]; then
      printf '%s\n' "$summ"
      printf '%s' "$res" | awk '{printf "  %-16s %-5s age=%ss / max=%ss\n",$1,$2,$3,$4}'
      exit 0
    fi
    [ "${1:-}" = --export ] && { printf '%s\n' "$summ"; exit 0; }
    # check: edge-trigger the board on a stale→ok / ok→stale transition (trustworthy signal, no spam)
    prev="$(cat "$STATE" 2>/dev/null || echo '')"
    # Dash-readable verdict: green → "0stale" (consistent with sibling reflexes' OK/CALM tokens),
    # stale → "Nstale: <list>". The raw token surfaces in the dash edge-state column, so it must NOT
    # read as the scary word "STALE=" when 0 are stale (that mis-flagged a healthy detector layer).
    cur="${nstale}stale${stale:+: $stale}"
    if [ "$cur" != "$prev" ]; then
      if [ "$nstale" -gt 0 ]; then
        mesh-chat "[pulse-stale] DETECTOR(S) SILENT past their cadence — liveness LOST, their 'all-clear' is now untrustworthy: $stale.$(root_cause_hint "$res") (mesh-pulse status for ages; this is the outside-the-loop systemd grounding, so a stale doctor/reflex-health here means the in-cron watchdog itself died.)" >/dev/null 2>&1 || true
      else
        mesh-chat "[pulse-ok] all $nok detectors beating within cadence again (was: $prev)." >/dev/null 2>&1 || true
      fi
    fi
    # Write the verdict EVERY run, not only on transition: the dash ages the 'pulse-check' edge line by
    # this file's mtime, so an on-change-only write makes a stable 'all-beating' verdict read as a dead
    # reflex after one cadence (this is the detector-liveness grounding layer — a false-stale HERE could
    # make a mind wrongly conclude the whole grounding died). mtime = last-RUN (liveness); content = last
    # verdict. The board alert above stays edge-gated (content is identical when stable → no spam).
    printf '%s\n' "$cur" > "$STATE"
    [ "${2:-}" = --quiet ] || printf '%s\n' "$summ"
    ;;
  --test)
    fails=0; td="$(mktemp -d)"; trap 'rm -rf "$td"' EXIT
    # 1. registry parses to N well-formed rows (4 |-fields each)
    bad=$(registry | awk -F'|' 'NF!=4{c++} END{print c+0}')
    [ "$bad" = 0 ] || { echo "smoke-test: FAIL (registry has $bad malformed rows)"; fails=1; }
    nrows=$(registry | grep -c .)
    [ "$nrows" -ge 15 ] || { echo "smoke-test: FAIL (registry only $nrows rows, expected ~17)"; fails=1; }
    # 2. beat is atomic + never fails + creates the file
    MESH_DIR="$td" "$0" beat selftest || { echo "smoke-test: FAIL (beat returned nonzero)"; fails=1; }
    [ -e "$td/pulse/selftest.beat" ] || { echo "smoke-test: FAIL (beat did not create .beat)"; fails=1; }
    # 3. freshest-of(artifact,beat): a fresh beat must read OK; an OLD one STALE
    mkdir -p "$td/pulse"; : > "$td/pulse/x.beat"
    age_fresh=$(( $(date +%s) - $(stat -c %Y "$td/pulse/x.beat") )); [ "$age_fresh" -lt 60 ] || { echo "smoke-test: FAIL (fresh beat age $age_fresh)"; fails=1; }
    touch -d '@1000' "$td/pulse/x.beat"
    age_old=$(( $(date +%s) - $(stat -c %Y "$td/pulse/x.beat") )); [ "$age_old" -gt 4200 ] || { echo "smoke-test: FAIL (old beat not old: $age_old)"; fails=1; }
    # 4. NO reflex-cadence header (must NOT be autowired into cron — it lives on systemd)
    grep -q '^# reflex-cadence' "$0" && { echo "smoke-test: FAIL (mesh-pulse must NOT carry a reflex-cadence — it is systemd-grounded, off-cron)"; fails=1; }
    # 5. DERIVATION (maxage-from-cadence): eff_maxage resolves @auto→cron-stride×2 AND keeps @cond EXCLUDED
    _tcron="$td/cron"; printf '%s\n' \
      '*/10 * * * * $HOME/.local/bin/mesh-foo >> x 2>&1' \
      '7-59/30 * * * * $HOME/.local/bin/mesh-bar --edge' \
      '23 * * * * $HOME/.local/bin/mesh-hourly' > "$_tcron"
    _str(){ CRON_SRC="$_tcron" cron_stride_s "$1"; }
    _d(){   CRON_SRC="$_tcron" eff_maxage "$1" "$2"; }
    [ "$(_str mesh-foo)"    = 600 ]  || { echo "smoke-test: FAIL (*/10 stride≠600: $(_str mesh-foo))"; fails=1; }
    [ "$(_str mesh-hourly)" = 3600 ] || { echo "smoke-test: FAIL (hourly stride≠3600: $(_str mesh-hourly))"; fails=1; }
    [ "$(_d @auto mesh-foo)"        = 1200 ] || { echo "smoke-test: FAIL (@auto */10 ≠ cron×2=1200: $(_d @auto mesh-foo))"; fails=1; }
    [ "$(_d @auto=mesh-bar mesh-x)" = 3600 ] || { echo "smoke-test: FAIL (@auto=PARENT ≠ parent stride×2=3600)"; fails=1; }
    [ "$(_d @cond mesh-feed)"       = skip ] || { echo "smoke-test: FAIL (conditional-write feed NOT excluded)"; fails=1; }
    [ "$(_d @auto mesh-nonexistent)" = skip ] || { echo "smoke-test: FAIL (@auto w/ no cron line must skip)"; fails=1; }
    [ "$(_d 6300 mesh-x)"           = 6300 ] || { echo "smoke-test: FAIL (explicit literal not preserved)"; fails=1; }
    # 6. feed is @cond (the conditional-write exclusion — NOT the 3000s literal I earlier band-aided)
    registry | grep -qE '^feed\|.*\|@cond\|' || { echo "smoke-test: FAIL (feed must be @cond, not a watched literal)"; fails=1; }
    # 7. DEBOUNCE (watchdog-debounce): 1 fail = still UP, 2 consecutive = DOWN, a success resets; peek read-only
    _dbd="$td/db"; _db(){ DEBOUNCE_DIR="$_dbd" debounce "$@"; }
    [ "$(_db t1 fail)" = UP ]   || { echo "smoke-test: FAIL (debounce: 1st fail must stay UP)"; fails=1; }
    [ "$(_db t1 fail)" = DOWN ] || { echo "smoke-test: FAIL (debounce: 2nd CONSECUTIVE fail must flip DOWN)"; fails=1; }
    [ "$(_db t1 ok)"   = UP ]   || { echo "smoke-test: FAIL (debounce: success must flip UP)"; fails=1; }
    [ "$(_db t1 fail)" = UP ]   || { echo "smoke-test: FAIL (debounce: counter must RESET after success)"; fails=1; }
    [ "$(_db t2 fail peek)" = UP ] && [ "$(_db t2 fail peek)" = UP ] || { echo "smoke-test: FAIL (debounce peek must NOT mutate the counter)"; fails=1; }
    [ "$fails" = 0 ] && echo "smoke-test: ok (registry well-formed + token-derived max_age [@auto=cron×2, @cond excluded] + DEBOUNCE [1 fail=UP, 2 consec=DOWN, success resets, peek read-only]; beat atomic/safe; freshest-of staleness; off-cron by design)"
    exit "$fails" ;;
  *)
    grep -E '^#( |$)' "$0" | sed -E 's/^# ?//' | sed -n '1,30p'
    exit 0 ;;
esac
