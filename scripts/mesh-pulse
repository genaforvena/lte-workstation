#!/usr/bin/env bash
# mesh-pulse — detector LIVENESS layer: "what detects when the detector itself died?" (operator
# 2026-06-21). A detector that fails SILENT reads identical to "all-clear" — the most dangerous
# reading (a dead sensor and a real green look the same). mesh-doctor was cron-orphaned and blind
# for 28h; mesh-resource-guard froze 5 days, trusted as live; reflex-health watched only 5 of ~18
# detectors and could not watch ITSELF. This layer closes that.
#
# TWO MECHANISMS, by design:
#   1. PULSE — every detector leaves a per-run heartbeat (a `.beat` touched EVERY run, even on
#      no-news). Absence-of-pulse against a dumb clock is the alarm — we detect death by SILENCE,
#      not by an active probe (an active probe dies the same silent death). For detectors that
#      already rewrite a per-run artifact (a log/state) we reuse THAT as the beat (no edit needed);
#      silent-on-no-news detectors (edge/alert tools) call `mesh-pulse beat <name>` explicitly.
#   2. OUTSIDE-THE-LOOP GROUNDING — `mesh-pulse check` runs from a SYSTEMD timer, a categorically
#      different substrate than the user crontab that drops everything at once on a reorg (the
#      actual, repeated failure mode). So if cron dies wholesale, the systemd-grounded checker
#      still fires and sees every cron pulse go stale — INCLUDING doctor and reflex-health. The
#      regress terminates not in a smarter watcher (it dies too) but in the SIMPLEST possible one
#      on a more durable substrate. `--export` writes a one-line summary a PEER node can read to
#      ground THIS box from off-node (the final terminator: a dead box can't fake a remote pulse).
#
#   mesh-pulse beat <name>     touch this detector's heartbeat (call once per run; safe, never fails caller)
#   mesh-pulse check           grade every detector's freshness vs the cadence table; edge-post stale/ok
#   mesh-pulse check --quiet   same, no stdout (systemd mode)
#   mesh-pulse table           print the cadence registry (the source of truth)
#   mesh-pulse status          read-only one-line-per-detector report (no board post)
#   mesh-pulse --export        write ~/.mesh/.pulse-summary (one line, peer-readable)
#   mesh-pulse --install       write + enable the systemd --user timer that grounds this from off-cron
#   mesh-pulse --test          smoke test
#
# NOT a cron reflex (no # reflex-cadence header — deliberately): the whole point is to live OUTSIDE
# cron. It is wired as a systemd --user timer (mesh-pulse-check.timer). autowire must not pull it in.
# orphan-ok: systemd-grounded via mesh-pulse-check.timer (`mesh-pulse --install`) — off-cron BY DESIGN,
# so the cron-orphan check must not flag it (it is wired, just not to crontab — that's the whole point).
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
M="${MESH_DIR:-$HOME/.mesh}"
PULSE="$M/pulse"
STATE="$M/.pulse-check-state"     # last verdict per detector (edge-trigger memory)
SUMMARY="$M/.pulse-summary"       # one-line peer-readable export
ts(){ date -u +%FT%TZ; }
now(){ date +%s; }

# ---- the cadence registry: SOURCE OF TRUTH for what MUST beat -------------------------------------
# name | reuse-artifact (per-run file already written, or "-" for beat-only) | max_age_s (≈cadence×2+margin) | tool-match
# max_age derives from the cron cadence: a detector silent longer than this is DEAD-not-quiet.
# tool-match → node-aware: a detector not in THIS node's crontab is skipped (not its node's reflex).
registry(){ cat <<EOF
doctor|$M/doctor.log|7500|mesh-doctor
reflex-health|$M/.reflex-health-state|1500|mesh-reflex-health
health-state|$M/.mesh-health|660|mesh-health-state
therm-watch|$M/.therm-state|900|mesh-therm-watch
vpn-health|$M/vpn-health.log|1500|mesh-vpn-health
vpn-watchdog|-|600|mesh-vpn-watchdog
feed|$M/feed.log|660|mesh-feed
sense-evolve|$M/sense-evolve.log|1500|mesh-sense-evolve
fleet-health|$M/.fleet-health.cache|1500|mesh-fleet-health
gate-watch|$M/.gate-state|900|mesh-gate-watch
stress|-|900|mesh-stress
net-drop|-|900|mesh-net-drop
hw-health|-|4200|mesh-hw-health
watchtower|-|4200|mesh-watchtower
criticality|-|4200|mesh-criticality
algedonic|-|1500|mesh-algedonic
psi|-|1500|mesh-psi
EOF
}

# freshest mtime among the reuse-artifact and the explicit beat (epoch; 0 if neither exists).
last_beat(){ # <name> <artifact>
  local name="$1" art="$2" b="$PULSE/$1.beat" m=0 t
  [ "$art" != "-" ] && [ -e "$art" ] && { t=$(stat -c %Y "$art" 2>/dev/null || echo 0); [ "$t" -gt "$m" ] && m=$t; }
  [ -e "$b" ] && { t=$(stat -c %Y "$b" 2>/dev/null || echo 0); [ "$t" -gt "$m" ] && m=$t; }
  echo "$m"
}

cron_has(){ crontab -l 2>/dev/null | grep -vE '^\s*#' | grep -q "$1"; }

beat(){ # <name> — never fail the caller; atomic touch
  local name="${1:?}"; mkdir -p "$PULSE" 2>/dev/null || true
  : > "$PULSE/$name.beat" 2>/dev/null || true
}

# grade every detector → fills global arrays; returns 0 always. Result lines: "name verdict age max"
grade(){
  local n; CNT=0; STALE=0; OK=0; SKIP=0; RESULT=""
  local cronlist; cronlist="$(crontab -l 2>/dev/null | grep -vE '^\s*#')"
  while IFS='|' read -r name art maxage tool; do
    [ -n "${name:-}" ] || continue
    # node-aware: detector not scheduled here → not this node's responsibility
    if ! printf '%s' "$cronlist" | grep -q "$tool"; then
      RESULT+="$name SKIP - $maxage"$'\n'; SKIP=$((SKIP+1)); continue
    fi
    CNT=$((CNT+1))
    local mt age v
    mt="$(last_beat "$name" "$art")"
    if [ "$mt" -eq 0 ]; then age=-1; v=STALE
    else age=$(( $(now) - mt )); [ "$age" -gt "$maxage" ] && v=STALE || v=OK; fi
    [ "$v" = STALE ] && STALE=$((STALE+1)) || OK=$((OK+1))
    RESULT+="$name $v $age $maxage"$'\n'
  done < <(registry)
  printf '%s' "$RESULT"
}

case "${1:-}" in
  beat)   beat "${2:?mesh-pulse beat <name>}"; ;;
  table)  registry ;;
  --install)
    # Plant the outside-the-loop grounding: a systemd --user timer (a substrate independent of the
    # crontab that drops everything at once on a reorg). Idempotent — safe to re-run on any node.
    ud="$HOME/.config/systemd/user"; mkdir -p "$ud"
    cat > "$ud/mesh-pulse-check.service" <<'UNIT'
[Unit]
Description=mesh-pulse detector-liveness check — outside-the-loop grounding for the cron reflex layer
Documentation=man:mesh-pulse

[Service]
Type=oneshot
ExecStart=%h/.local/bin/mesh-pulse check --quiet
Nice=10
UNIT
    cat > "$ud/mesh-pulse-check.timer" <<'UNIT'
[Unit]
Description=Run mesh-pulse check every 5 min (systemd substrate, independent of the user crontab)

[Timer]
OnBootSec=2min
OnUnitActiveSec=5min
Persistent=true

[Install]
WantedBy=timers.target
UNIT
    systemctl --user daemon-reload 2>/dev/null || { echo "mesh-pulse --install: no systemd --user here — grounding NOT planted" >&2; exit 1; }
    systemctl --user enable --now mesh-pulse-check.timer 2>/dev/null
    loginctl enable-linger "$(id -un)" 2>/dev/null || true   # fire without an active login session
    echo "mesh-pulse --install: systemd timer planted + enabled (next: $(systemctl --user list-timers mesh-pulse-check.timer --no-pager 2>/dev/null | awk 'NR==2{print $1,$2,$3}'))"
    ;;
  status|check|--export)
    mkdir -p "$M" "$PULSE"
    res="$(grade)"
    stale="$(printf '%s' "$res" | awk '$2=="STALE"{print $1}' | tr '\n' ' ' | sed 's/ $//')"
    nstale=$(printf '%s' "$res" | awk '$2=="STALE"{c++} END{print c+0}')
    nok=$(printf '%s' "$res" | awk '$2=="OK"{c++} END{print c+0}')
    summ="$(ts) pulse: $nok ok, $nstale stale${stale:+ — STALE: $stale}"
    # always refresh the peer-readable export
    printf '%s\n' "$summ" > "$SUMMARY"
    if [ "${1:-}" = status ]; then
      printf '%s\n' "$summ"
      printf '%s' "$res" | awk '{printf "  %-16s %-5s age=%ss / max=%ss\n",$1,$2,$3,$4}'
      exit 0
    fi
    [ "${1:-}" = --export ] && { printf '%s\n' "$summ"; exit 0; }
    # check: edge-trigger the board on a stale→ok / ok→stale transition (trustworthy signal, no spam)
    prev="$(cat "$STATE" 2>/dev/null || echo '')"
    cur="STALE=$stale"
    if [ "$cur" != "$prev" ]; then
      if [ "$nstale" -gt 0 ]; then
        mesh-chat "[pulse-stale] DETECTOR(S) SILENT past their cadence — liveness LOST, their 'all-clear' is now untrustworthy: $stale. (mesh-pulse status for ages; this is the outside-the-loop systemd grounding, so a stale doctor/reflex-health here means the in-cron watchdog itself died.)" >/dev/null 2>&1 || true
      else
        mesh-chat "[pulse-ok] all $nok detectors beating within cadence again (was: ${prev#STALE=})." >/dev/null 2>&1 || true
      fi
    fi
    # Write the verdict EVERY run, not only on transition: the dash ages the 'pulse-check' edge line by
    # this file's mtime, so an on-change-only write makes a stable 'all-beating' verdict read as a dead
    # reflex after one cadence (this is the detector-liveness grounding layer — a false-stale HERE could
    # make a mind wrongly conclude the whole grounding died). mtime = last-RUN (liveness); content = last
    # verdict. The board alert above stays edge-gated (content is identical when stable → no spam).
    printf '%s\n' "$cur" > "$STATE"
    [ "${2:-}" = --quiet ] || printf '%s\n' "$summ"
    ;;
  --test)
    fails=0; td="$(mktemp -d)"; trap 'rm -rf "$td"' EXIT
    # 1. registry parses to N well-formed rows (4 |-fields each)
    bad=$(registry | awk -F'|' 'NF!=4{c++} END{print c+0}')
    [ "$bad" = 0 ] || { echo "smoke-test: FAIL (registry has $bad malformed rows)"; fails=1; }
    nrows=$(registry | grep -c .)
    [ "$nrows" -ge 15 ] || { echo "smoke-test: FAIL (registry only $nrows rows, expected ~17)"; fails=1; }
    # 2. beat is atomic + never fails + creates the file
    MESH_DIR="$td" "$0" beat selftest || { echo "smoke-test: FAIL (beat returned nonzero)"; fails=1; }
    [ -e "$td/pulse/selftest.beat" ] || { echo "smoke-test: FAIL (beat did not create .beat)"; fails=1; }
    # 3. freshest-of(artifact,beat): a fresh beat must read OK; an OLD one STALE
    mkdir -p "$td/pulse"; : > "$td/pulse/x.beat"
    age_fresh=$(( $(date +%s) - $(stat -c %Y "$td/pulse/x.beat") )); [ "$age_fresh" -lt 60 ] || { echo "smoke-test: FAIL (fresh beat age $age_fresh)"; fails=1; }
    touch -d '@1000' "$td/pulse/x.beat"
    age_old=$(( $(date +%s) - $(stat -c %Y "$td/pulse/x.beat") )); [ "$age_old" -gt 4200 ] || { echo "smoke-test: FAIL (old beat not old: $age_old)"; fails=1; }
    # 4. NO reflex-cadence header (must NOT be autowired into cron — it lives on systemd)
    grep -q '^# reflex-cadence' "$0" && { echo "smoke-test: FAIL (mesh-pulse must NOT carry a reflex-cadence — it is systemd-grounded, off-cron)"; fails=1; }
    [ "$fails" = 0 ] && echo "smoke-test: ok (registry well-formed; beat atomic/safe; freshest-of staleness; off-cron by design)"
    exit "$fails" ;;
  *)
    grep -E '^#( |$)' "$0" | sed -E 's/^# ?//' | sed -n '1,30p'
    exit 0 ;;
esac
