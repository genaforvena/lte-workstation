#!/usr/bin/env bash
# mesh-mind-compact — keep every mind's CONTEXT lean (and quota usage low) by sending /compact to IDLE
# minds. /compact is the UNIVERSAL context lever — both engines accept it — but the TRIGGER differs by
# engine (operator 2026-06-17 "call /compact for these minds … depending on the mind"):
#   • opencode minds (senses/health/chat): context-% is readable from the footer → THRESHOLD-compact
#     (fire when context % >= pct). opencode does NOT auto-compact, so this is where it matters.
#   • claude minds (minds/genome/tg): the footer shows only a per-turn token delta, no context-% — and
#     claude AUTO-compacts near the limit. So we INTERVAL-compact (every MESH_COMPACT_INTERVAL when idle)
#     to keep it proactively lean / quota down, rather than chase an unreadable %.
# Called standalone via cron (--high-tokens, the unified reflex) or by mesh-tick as a pre-nudge gate.
#
#   mesh-mind-compact [window ...]    interval-compact named windows (default: all mind windows)
#   mesh-mind-compact --status        show last-compact timestamps for all mind windows
#   mesh-mind-compact --high-tokens [pct]  THE REFLEX: per-engine compact — opencode>pct%, claude on interval
#   mesh-mind-compact --test          smoke test
#
# Env: MESH_COMPACT_INTERVAL  — seconds between compacts per mind (default 2700 = 45 min)
#      MESH_MIND_WINDOWS       — space-separated mind windows (default: minds genome tg senses health chat)
#
# Exit 0: compact sent (or already fresh). Exit 1: mind not idle (skip). Exit 2: n/a.
# reflex-cadence: */10 * * * *
# reflex-args: --high-tokens
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/restore.env" ] && . "$HOME/.mesh/restore.env" 2>/dev/null || true   # honor MESH_* overrides
SESS="$(hostname)"
INTERVAL="${MESH_COMPACT_INTERVAL:-2700}"   # 45 min default
STATE_DIR="$HOME/.mesh"
# the full mind-window set to keep lean (was the stale plan/dev/discover/sense). DEDICATED var —
# deliberately NOT MESH_MIND_WORKERS (that is the autopoiesis FEED worker pool = genome only; reusing
# it shrank the compact set to one window). Compaction covers EVERY mind window, not the feed pool.
WINDOWS="${MESH_MIND_WINDOWS:-minds genome tg senses health chat}"
WORKERS="$WINDOWS"   # alias used by --status / default-targets path below

# CONTEXT LEVER (operator 2026-07-06 over TG "заменить /compact на /clear"): the idle-mind context reset
# is now /clear, not /compact. /compact summarizes the conversation and continues — carrying a summary
# blob forward every turn and paying a summarization call; /clear wipes context so the mind re-orients
# from the DURABLE COMMONS (board chat.log, MEMORY.md, voice-in.log, its dash pane, mission files) on the
# next wake. Cheaper on quota AND truer to the mesh doctrine (no cached state; liveness is a lease;
# re-observe live; reboot = clean reincarnation). SAFE ONLY with the end-of-session handoff discipline —
# every mind must persist in-flight state to a board [task]/[fyi] or memory BEFORE it idles, since /clear
# (unlike /compact's summary) carries nothing forward. Only fires on IDLE minds (bare prompt). Revert:
# MESH_CONTEXT_CMD=/compact.
CTX_CMD="${MESH_CONTEXT_CMD:-/clear}"

# [compact] is routine housekeeping, NOT board conversation. Operator task compact-noise (2026-06-20):
# 189 [compact] lines were flooding mesh-chat, drowning real coordination. Record each compaction to a
# local timestamped log instead; the board stays for actual coordination, and `--status` still surfaces
# per-mind compaction state on demand. (No board consumer reads [compact] — verified before rerouting.)
clog(){ printf '%s %s\n' "$(date -u +%FT%TZ)" "$*" >> "$STATE_DIR/compact.log" 2>/dev/null || true; }

# Helper: read cooldown epoch from rlmark file (format: epoch|count or raw epoch)
rl_epoch() { cat "$1" 2>/dev/null | cut -d'|' -f1 || echo 0; }

# compact_still_stuck — pure text check (operates on already-captured pane text, no live tmux call, so
# it's directly fixture-testable): true if the bottom of the pane still shows $CTX_CMD sitting unsubmitted
# on an input line. Mirrors mesh-mind-state's input_stuck_text/WEDGED-INPUT detection — the SAME harness
# bug (C-m eaten, submission never lands) that tool proved live 2026-07-06 16:18Z/17:32Z.
compact_still_stuck() { # $1=pane capture text
  local esc; esc="$(printf '%s' "$CTX_CMD" | sed 's/[.[\*^$/]/\\&/g')"
  printf '%s\n' "$1" | tail -8 | grep -qE '^[[:space:]]*[❯›][[:space:]]+'"$esc"'[[:space:]]*$'
}

# send the context lever ($CTX_CMD = /clear by default, /compact if reverted) to a window's MIND pane
# (bottom), via paste-buffer + C-m — reliable for any TUI. SUBMIT-VERIFY (chat-review/mindcompact-
# verify-render-then-submit 2026-07-06, REWORK of the 643a306 fixed-1s check): the fixed-1s absence
# check FALSE-PASSED live TWICE post-643a306 (18:30:16Z stamped→18:32:17Z wedged; 19:00:08Z stamped→
# 19:25Z wedged) — under TUI redraw lag (thermal throttle) the pane can still be mid-repaint at +1s,
# so a transient/incomplete frame doesn't match the stuck pattern and the check reads a false "cleared".
# Fix inverts the check into two bounded polls instead of one fixed sleep: (1) after pasting, POLL until
# the input line actually RENDERS $CTX_CMD before ever sending C-m — sending Enter against a screen that
# hasn't caught up to the paste is exactly what let a truly-stuck submission slip past; (2) after C-m,
# POLL-CLEARED with escalating waits (1/2/4s) — giving a lagging redraw repeated chances to catch up
# before concluding "still stuck" — instead of trusting one fixed-delay sample. Final failure (both
# attempts exhausted) sends one last C-u so the pane is never left carrying the phantom command text for
# a watchdog to trip on. THE ONE SEND PATH: both --high-tokens and the manual TARGETS loop call this —
# no duplicated inline paste-buffer block that a fix to one path could miss.
send_compact() { # $1=win → 0 verified-submitted, 1 harness ate it (both attempts) — caller must not stamp
  local win="$1" pidx pane cb64 attempt cap w rendered
  pidx="$(tmux list-panes -t "${SESS}:${win}" -F '#{pane_top} #{pane_index}' 2>/dev/null | sort -n | tail -1 | awk '{print $2}')"
  pane="${SESS}:${win}${pidx:+.$pidx}"
  cb64="$(printf '%s' "$CTX_CMD" | base64 | tr -d '\n')"
  for attempt in 1 2; do
    tmux send-keys -t "$pane" C-u 2>/dev/null || true; sleep 0.1
    echo "$cb64" | base64 -d | tmux load-buffer -b mc$$ - 2>/dev/null
    tmux paste-buffer -p -d -b mc$$ -t "$pane" 2>/dev/null
    rendered=""
    for w in 0.2 0.3 0.5 1 1; do
      sleep "$w"
      cap="$(tmux capture-pane -t "$pane" -p 2>/dev/null)"
      compact_still_stuck "$cap" && { rendered=1; break; }
    done
    if [ -z "$rendered" ]; then
      [ "$attempt" = 1 ] && echo "$(date -u +%Y-%m-%dT%H:%MZ) compact[$win]: paste never rendered, retrying once" >&2
      continue
    fi
    tmux send-keys -t "$pane" C-m 2>/dev/null
    for w in 1 2 4; do
      sleep "$w"
      cap="$(tmux capture-pane -t "$pane" -p 2>/dev/null)"
      compact_still_stuck "$cap" || return 0
    done
    [ "$attempt" = 1 ] && echo "$(date -u +%Y-%m-%dT%H:%MZ) compact[$win]: '$CTX_CMD' not submitted, retrying once" >&2
  done
  tmux send-keys -t "$pane" C-u 2>/dev/null || true
  echo "$(date -u +%Y-%m-%dT%H:%MZ) compact[$win]: SEND FAILED — '$CTX_CMD' still in input after retry (harness ate the submission); NOT stamping" >&2
  clog "SEND-FAIL $win: $CTX_CMD stuck after retry — not stamped"
  return 1
}

if [ "${1:-}" = --test ]; then
  command -v tmux >/dev/null 2>&1 || { echo "smoke-test: FAIL (no tmux)"; exit 1; }
  command -v mesh-mind-state >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-mind-state)"; exit 1; }
  command -v base64 >/dev/null 2>&1 || { echo "smoke-test: FAIL (no base64)"; exit 1; }
  # create a temp session with 2 panes stacked vertically (top=data, bottom=mind)
  _ts="test-compact-$$"
  tmux new-session -d -s "$_ts" -x 80 -y 10 'echo data-pane; sleep 60' 2>/dev/null
  tmux split-window -t "$_ts:0.0" -v 'echo mind-pane; sleep 60' 2>/dev/null
  sleep 0.3
  # the pane-resolution logic: sort by pane_top, pick last = bottom = mind pane
  _pidx="$(tmux list-panes -t "${_ts}:0" -F '#{pane_top} #{pane_index}' 2>/dev/null \
    | sort -n | tail -1 | awk '{print $2}')"
  _content="$(tmux capture-pane -t "${_ts}:0.${_pidx}" -p 2>/dev/null | tr -d '[:space:]')"
  tmux kill-session -t "$_ts" 2>/dev/null
  printf '%s' "$_content" | grep -q 'mind-pane' || {
    echo "smoke-test: FAIL (pane-resolution picked wrong pane — content='$_content')"; exit 1
  }
  # SUBMIT-VERIFY (chat-review/mindcompact-clear-submit-verify 2026-07-06): compact_still_stuck must
  # detect the harness-ate-the-Enter case (the literal $CTX_CMD sitting unsubmitted on an input line) and
  # clear once the line is empty/changed. Falsify: neuter the grep in compact_still_stuck and this trips.
  s="$(printf '❯ %s\n────\n  ⏵⏵ auto mode on · ← for agents\n' "$CTX_CMD")"
  compact_still_stuck "$s" || { echo "smoke-test: FAIL (stuck '$CTX_CMD' in input line not detected)"; exit 1; }
  s="$(printf '❯ \n────\n  ⏵⏵ auto mode on · ← for agents\n')"
  compact_still_stuck "$s" && { echo "smoke-test: FAIL (empty input line falsely flagged stuck)"; exit 1; }
  s="$(printf 'some output\n❯ \n  ⏵⏵ auto mode on · ← for agents\n')"
  compact_still_stuck "$s" && { echo "smoke-test: FAIL (submitted+cleared pane falsely flagged stuck)"; exit 1; }
  # RENDER-THEN-SUBMIT, live end-to-end (chat-review/mindcompact-verify-render-then-submit 2026-07-06):
  # send_compact must (a) wait for the pasted text to actually RENDER before ever sending C-m, and
  # (b) poll-cleared with escalating waits rather than trust one fixed sample. A mock pane that reads
  # the pasted chars instantly but delays echoing them (render lag) and delays clearing after Enter
  # (submit lag) — both delays comfortably inside send_compact's poll bounds — models the live 18:30Z/
  # 19:00Z incidents (redraw lag under thermal throttle). Falsify: revert send_compact to
  # paste→sleep-0.5→C-m→sleep-1→check-once and this mock (1.2s render lag > that fixed 0.5s pre-C-m
  # gap) starts failing/false-passing.
  _mock="$(mktemp)"; cat > "$_mock" <<'MOCKEOF'
#!/usr/bin/env bash
# fake TUI: char-at-a-time so it can honor send_compact's leading C-u (0x15) as a real clear-line —
# same as a real terminal app, not literal text — then delays the RENDER and the post-Enter CLEAR to
# model redraw lag.
n="$1"; render_delay="$2"; submit_delay="$3"
stty -echo -icanon time 0 min 1 2>/dev/null
buf=""
while :; do
  IFS= read -r -n1 ch
  case "$ch" in
    $'\x15') buf="" ;;
    $'\r'|$'\n') break ;;
    *) buf+="$ch" ;;
  esac
  [ "${#buf}" -ge "$n" ] && break
done
sleep "$render_delay"
printf '%s' "❯ $buf"
IFS= read -r -n1 ch
sleep "$submit_delay"
printf '\r'
sleep 5
MOCKEOF
  chmod +x "$_mock"
  _tcmd="/xtest"; _tlen=${#_tcmd}
  _oldsess="$SESS"; _oldctx="$CTX_CMD"
  # case A: renders late (1.2s) + clears late (0.3s) — both within bound — must still succeed (rc=0)
  _ts2="test-compact-render-$$"
  tmux new-session -d -s "$_ts2" -x 80 -y 10 'sleep 30' 2>/dev/null
  tmux split-window -t "$_ts2:0.0" -v -l 5 "$_mock $_tlen 1.2 0.3" 2>/dev/null
  sleep 0.3
  SESS="$_ts2"; CTX_CMD="$_tcmd"
  send_compact 0; _rcA=$?
  tmux kill-session -t "$_ts2" 2>/dev/null
  [ "$_rcA" -eq 0 ] || { SESS="$_oldsess"; CTX_CMD="$_oldctx"; rm -f "$_mock"
    echo "smoke-test: FAIL (send_compact rc=$_rcA against a slow-render/slow-clear mock that should still succeed)"; exit 1; }
  # case B: never renders (10s, past the ~3s render-poll bound on both attempts) — must fail (rc=1) and
  # send a final cleanup C-u (never leave the phantom text sitting in the input for a watchdog to trip on)
  _ts3="test-compact-norender-$$"
  tmux new-session -d -s "$_ts3" -x 80 -y 10 'sleep 30' 2>/dev/null
  tmux split-window -t "$_ts3:0.0" -v -l 5 "$_mock $_tlen 10 0" 2>/dev/null
  sleep 0.3
  SESS="$_ts3"
  send_compact 0; _rcB=$?
  tmux kill-session -t "$_ts3" 2>/dev/null
  SESS="$_oldsess"; CTX_CMD="$_oldctx"; rm -f "$_mock"
  [ "$_rcB" -eq 1 ] || { echo "smoke-test: FAIL (send_compact rc=$_rcB against a never-renders mock — should be 1, not stamped)"; exit 1; }
  # structural: the final-failure path must issue a cleanup C-u before declaring SEND FAILED (else a
  # double-fail leaves the phantom command text sitting in the pane for mind-state's WEDGED-INPUT
  # watchdog to trip on, per the live 19:26:47Z/19:31:58Z recurrences)
  awk '/^send_compact\(\) \{/,/^}/' "$0" | grep -B3 'SEND FAILED' | grep -qF 'C-u' || {
    echo "smoke-test: FAIL (final-failure path has no cleanup C-u before SEND FAILED)"; exit 1; }
  # ONE SEND PATH: both call sites must route through send_compact — no duplicated inline paste-buffer
  # block that a fix to one path could miss (falsify: re-inline a second paste-buffer block below).
  _sc_calls="$(grep -cF 'send_compact "$win"' "$0")"
  [ "$_sc_calls" -ge 2 ] || { echo "smoke-test: FAIL (send_compact not called from both --high-tokens and the manual TARGETS loop — found $_sc_calls call sites)"; exit 1; }
  # (pattern built via concatenation so this assertion line itself doesn't literally contain the
  # substring it searches for — else it would always count itself as a second match)
  _pbpat="paste-buffer -p -d -b mc"'$$'
  _pb_count="$(grep -cF "$_pbpat" "$0")"
  [ "$_pb_count" -eq 1 ] || { echo "smoke-test: FAIL (more than one paste-buffer send block in the file — duplicated send path, found $_pb_count)"; exit 1; }
  echo "smoke-test: ok (pane-resolution picks bottom/mind pane, send_compact uses paste-buffer+C-m, submit-verify detects a stuck/cleared input line, one send path)"; exit 0
fi

# THE UNIFIED REFLEX — per-engine context compaction across all mind windows.
#   opencode (context-% readable): compact when state IDLE and pct >= THRESHOLD.
#   claude   (context-% '?'):      compact when state IDLE and last-compact older than INTERVAL.
# Only ever compacts an IDLE mind (never interrupts a working turn). 10-min hard cooldown + rlmark guard.
if [ "${1:-}" = --high-tokens ]; then
  THRESHOLD="${2:-60}"; shift 2 2>/dev/null || shift
  now=$(date +%s); compacted=""
  for win in $WINDOWS; do
    f="$STATE_DIR/.compact-${win}"; last=0; [ -f "$f" ] && last=$(cat "$f" 2>/dev/null || echo 0)
    [ $(( now - last )) -lt 600 ] && continue  # 10min hard cooldown per mind
    rlmark="$STATE_DIR/.rl-cooldown-${win}"
    [ -f "$rlmark" ] && [ "$now" -lt "$(rl_epoch "$rlmark")" ] && continue
    stats="$(mesh-mind-state --stats "$win" 2>/dev/null | awk -v w="$win" '$1==w{print; exit}')"
    [ -z "$stats" ] && continue                                   # absent window
    # tab-sep: 1=WINDOW 2=STATE 3=MODEL 4=TOKENS 5=PCT 6=DOLLARS
    state="$(printf '%s' "$stats" | cut -f2 | tr -d ' ')"
    pct="$(printf '%s' "$stats" | cut -f5 | tr -d ' ')"
    [ "$state" = IDLE ] || continue                               # never interrupt a working mind
    why=""
    if [ -n "$pct" ] && [ "$pct" != "?" ]; then
      # opencode — readable %: threshold trigger
      pct_n="${pct%\%}"
      case "$pct_n" in (*[!0-9]*|"") continue;; esac
      [ "$pct_n" -ge "$THRESHOLD" ] || continue
      why="ctx ${pct}≥${THRESHOLD}%"
    else
      # claude (or stats unreadable) — interval trigger
      [ $(( now - last )) -ge "$INTERVAL" ] || continue
      why="interval $(( (now-last)/60 ))m"
    fi
    if send_compact "$win"; then
      printf '%s' "$now" > "$f"
      compacted="$compacted ${win}(${why})"
    fi
  done
  [ -n "$compacted" ] && clog "$CTX_CMD →$compacted"
  exit 0
fi

if [ "${1:-}" = --status ]; then
  now=$(date +%s)
  for win in $WORKERS; do
    f="$STATE_DIR/.compact-${win}"
    if [ -f "$f" ]; then
      ts=$(cat "$f" 2>/dev/null || echo 0)
      age=$(( now - ts ))
      echo "$win: last compact ${age}s ago ($(date -d "@$ts" +%H:%MZ 2>/dev/null || date -r "$ts" +%H:%MZ 2>/dev/null || echo '?'))"
    else
      echo "$win: never compacted"
    fi
  done
  exit 0
fi

# If windows specified as args, use those; else default workers
TARGETS="${*:-$WORKERS}"
[ -z "${TARGETS// /}" ] && { echo "mesh-mind-compact: no targets"; exit 2; }

now=$(date +%s)
did_compact=0

for win in $TARGETS; do
  f="$STATE_DIR/.compact-${win}"
  last=0; [ -f "$f" ] && last=$(cat "$f" 2>/dev/null || echo 0)
  age=$(( now - last ))

  # Skip if recently compacted
  if [ "$age" -lt "$INTERVAL" ]; then
    echo "$(date -u +%Y-%m-%dT%H:%MZ) compact[$win]: fresh (${age}s < ${INTERVAL}s) — skip"
    continue
  fi

  # Skip if rate-limited / shed (cooldown file set by channel-keepalive)
  rlmark="$STATE_DIR/.rl-cooldown-${win}"
  if [ -f "$rlmark" ] && [ "$now" -lt "$(rl_epoch "$rlmark")" ]; then
    echo "$(date -u +%Y-%m-%dT%H:%MZ) compact[$win]: rate-limited (rlmark active) — skip"
    continue
  fi

  # Only compact when IDLE (not mid-turn)
  state="$(mesh-mind-state "$win" 2>/dev/null | head -1 | cut -f1)"
  if [ "$state" != "IDLE" ]; then
    echo "$(date -u +%Y-%m-%dT%H:%MZ) compact[$win]: state=$state — skip (not idle)"
    continue
  fi

  echo "$(date -u +%Y-%m-%dT%H:%MZ) compact[$win]: sending $CTX_CMD (last=${age}s ago)"
  if send_compact "$win"; then
    printf '%s' "$now" > "$f"
    did_compact=$(( did_compact + 1 ))
  fi
done

[ "$did_compact" -gt 0 ] && clog "$CTX_CMD sent to $did_compact mind(s): $TARGETS"

exit 0
