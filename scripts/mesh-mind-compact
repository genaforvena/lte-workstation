  # ...and the empty box after a successful submit must read CLEAR, or the ladder never confirms.
  s="$(cat <<EOF
  ┃  earlier assistant output, wrapped
  ┃
                                                                            ┃
                                                                            ┃
                                                                            ┃
                                                                            ┃  Build · GLM-5.2 Z.AI Coding Plan
                                                                            ╹▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀
