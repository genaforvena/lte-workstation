)"
  compact_still_stuck "$s" && { echo "smoke-test: FAIL (a SUBMITTED '$CTX_CMD' still visible in the opencode transcript flagged as unsubmitted)"; exit 1; }
  # ...and the box char must not turn ANY boxed line into a stuck verdict: only a line that is the
