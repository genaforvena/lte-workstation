  s="$(printf '  \xe2\x94\x83  mesh-chat "posting %s notes"\n  \xe2\x94\x83\n  \xe2\x94\x83  Build\n' "$CTX_CMD")"
  compact_still_stuck "$s" && { echo "smoke-test: FAIL (a boxed line merely CONTAINING '$CTX_CMD' flagged stuck)"; exit 1; }

  # BARE-ENV / CRON-LOCALE (chat-review/mindcompact-render-verify-cron-locale): cron hands this script
  # an env with no LANG/LC_ALL (verified live: LC_CTYPE=POSIX under env -i) — under the C locale, grep's
  # [❯›] bracket expression is byte-wise, not character-wise, so compact_still_stuck's regex silently
  # never matched a real NBSP-prompt fixture when this reflex actually fired from cron. Reproduce cron's
  # bare env exactly (env -i) against the locale-probe block + compact_still_stuck extracted verbatim
  # from this file (so the test tracks the real code, not a copy) and confirm the NBSP fixture still
  # reads STUCK. Falsify: comment out the "cron env is bare" locale-probe block near the top of this
  # file — the extraction yields nothing, LC_ALL stays unset under env -i, and this fails.
  _localetest="$(mktemp)"
  sed -n '/^# cron env is bare/,/^esac$/p' "$0" > "$_localetest"
  sed -n '/^compact_still_stuck() {/,/^}/p' "$0" >> "$_localetest"
  cat >> "$_localetest" <<'DRIVER'
CTX_CMD="/clear"
fixture="$(printf '❯\xc2\xa0/clear\n────\n  ⏵⏵ auto mode on\n')"
compact_still_stuck "$fixture" && echo STUCK || echo CLEAR
DRIVER
  _bare_out="$(env -i HOME="$HOME" PATH="/usr/bin:/bin" bash "$_localetest" 2>&1)"
  rm -f "$_localetest"
  [ "$_bare_out" = "STUCK" ] || { echo "smoke-test: FAIL (bare-env/cron-locale NBSP fixture not flagged stuck — got '$_bare_out')"; exit 1; }
  # RENDER-THEN-SUBMIT, live end-to-end (chat-review/mindcompact-verify-render-then-submit 2026-07-06):
  # send_compact must (a) wait for the pasted text to actually RENDER before ever sending C-m, and
  # (b) poll-cleared with escalating waits rather than trust one fixed sample. A mock pane that reads
  # the pasted chars instantly but delays echoing them (render lag) and delays clearing after Enter
  # (submit lag) — both delays comfortably inside send_compact's poll bounds — models the live 18:30Z/
  # 19:00Z incidents (redraw lag under thermal throttle). Falsify: revert send_compact to
  # paste→sleep-0.5→C-m→sleep-1→check-once and this mock (1.2s render lag > that fixed 0.5s pre-C-m
  # gap) starts failing/false-passing.
  _mock="$(mktemp)"; cat > "$_mock" <<'MOCKEOF'
#!/usr/bin/env bash
# fake TUI: char-at-a-time so it can honor send_compact's leading C-u (0x15) as a real clear-line —
# same as a real terminal app, not literal text — then delays the RENDER and the post-Enter CLEAR to
# model redraw lag.
n="$1"; render_delay="$2"; submit_delay="$3"
stty -echo -icanon time 0 min 1 2>/dev/null
buf=""
while :; do
  IFS= read -r -n1 ch
  case "$ch" in
    $'\x15') buf="" ;;
    $'\r'|$'\n') break ;;
    *) buf+="$ch" ;;
  esac
  [ "${#buf}" -ge "$n" ] && break
done
sleep "$render_delay"
printf '%s' "❯ $buf"
IFS= read -r -n1 ch
sleep "$submit_delay"
printf '\r'
sleep 5
MOCKEOF
  chmod +x "$_mock"
  _tcmd="/xtest"; _tlen=${#_tcmd}
  _oldsess="$SESS"; _oldctx="$CTX_CMD"; _oldrl="$RENDER_LADDER"; _oldcl="$CLEAR_LADDER"
  # IDLE-RECHECK stubs (2026-07-21): the mock panes have no real mind-state, so send_compact's pre-C-m
  # recheck gets an injectable state reader — IDLE for the legacy cases A/B/C (recheck passes; proves the
  # new gate doesn't disturb them), WORKING for case D below (recheck must abort pre-C-m).
  printf '#!/usr/bin/env bash\nprintf '\''IDLE\\t-\\t-\\n'\''\n' > "$_cd/state-idle"
  printf '#!/usr/bin/env bash\nprintf '\''WORKING\\t-\\t-\\n'\''\n' > "$_cd/state-working"
  chmod +x "$_cd/state-idle" "$_cd/state-working"
  export MESH_COMPACT_STATE_CMD="$_cd/state-idle"
  # case A: renders late (1.2s) + clears late (0.3s) — both within the PRODUCTION ladder — must still
  # succeed (rc=0). No override: proves the real default ladders (not just a shortened test ladder)
  # tolerate this much lag.
  _ts2="test-compact-render-$$"
  tmux new-session -d -s "$_ts2" -x 80 -y 10 'sleep 30' 2>/dev/null
  tmux split-window -t "$_ts2:0.0" -v -l 5 "$_mock $_tlen 1.2 0.3" 2>/dev/null
  sleep 0.3
  SESS="$_ts2"; CTX_CMD="$_tcmd"
  send_compact 0; _rcA=$?
  tmux kill-session -t "$_ts2" 2>/dev/null
  [ "$_rcA" -eq 0 ] || { SESS="$_oldsess"; CTX_CMD="$_oldctx"; rm -f "$_mock"
    echo "smoke-test: FAIL (send_compact rc=$_rcA against a slow-render/slow-clear mock that should still succeed)"; exit 1; }
  # case B: never renders at all → must fail (rc=1) and send a cleanup C-u (nothing but our own stray
  # paste is on the line — safe to clear; never leave phantom text sitting in the input for mind-
  # state's WEDGED-INPUT watchdog to trip on). SHORT ladder override (test-only) keeps this fast — the
  # mock's 10s delay only needs to outlast the ladder, not the real ~30s production floor.
  RENDER_LADDER="0.1 0.2"; CLEAR_LADDER="0.1 0.2"
  _ts3="test-compact-norender-$$"
  tmux new-session -d -s "$_ts3" -x 80 -y 10 'sleep 30' 2>/dev/null
  tmux split-window -t "$_ts3:0.0" -v -l 5 "$_mock $_tlen 10 0" 2>/dev/null
  sleep 0.3
  SESS="$_ts3"
  send_compact 0; _rcB=$?
  _pidxB="$(tmux list-panes -t "${_ts3}:0" -F '#{pane_top} #{pane_index}' 2>/dev/null | sort -n | tail -1 | awk '{print $2}')"
  _capB="$(tmux capture-pane -t "${_ts3}:0.${_pidxB}" -p 2>/dev/null)"
  tmux kill-session -t "$_ts3" 2>/dev/null
  [ "$_rcB" -eq 1 ] || { RENDER_LADDER="$_oldrl"; CLEAR_LADDER="$_oldcl"; SESS="$_oldsess"; CTX_CMD="$_oldctx"; rm -f "$_mock"
    echo "smoke-test: FAIL (send_compact rc=$_rcB against a never-renders mock — should be 1, not stamped)"; exit 1; }
