# THE UNIFIED REFLEX — per-claim (event) reset + a UNIVERSAL idle backstop across all minds.
#   EVENT     (any engine): clear when IDLE and a completion marker posted since last clear (primary).
#   INTERVAL  (any engine): clear when IDLE and idle ≥ MESH_COMPACT_INTERVAL — the operator's "clear every
#                           idle mind after N min" (2026-07-16); fires regardless of engine or readable %.
#   THRESHOLD (opencode):   additionally clear EARLY when IDLE and context % ≥ THRESHOLD, before INTERVAL.
# Trigger precedence lives in the pure clear_reason() (fixture-tested). Only ever clears an IDLE mind
# (never interrupts a working turn). MIN_COOLDOWN hard floor + rlmark guard. WINDOWS = the live session.
if [ "${1:-}" = --high-tokens ]; then
  THRESHOLD="${2:-60}"; shift 2 2>/dev/null || shift
  now=$(date +%s); compacted=""
  for win in $WINDOWS; do
    f="$STATE_DIR/.compact-${win}"; last=0; [ -f "$f" ] && last=$(cat "$f" 2>/dev/null || echo 0)
    [ $(( now - last )) -lt "$MIN_COOLDOWN" ] && continue  # anti-thrash floor (also caps event cadence)
    rlmark="$STATE_DIR/.rl-cooldown-${win}"
    [ -f "$rlmark" ] && [ "$now" -lt "$(rl_epoch "$rlmark")" ] && continue
    stats="$(mesh-mind-state --stats "$win" 2>/dev/null | awk -v w="$win" '$1==w{print; exit}')"
    [ -z "$stats" ] && continue                                   # absent window
    # tab-sep: 1=WINDOW 2=STATE 3=MODEL 4=TOKENS 5=PCT 6=DOLLARS
    state="$(printf '%s' "$stats" | cut -f2 | tr -d ' ')"
    model="$(printf '%s' "$stats" | cut -f3 | sed 's/^ *//;s/ *$//')"
    tok="$(printf '%s' "$stats" | cut -f4 | tr -d ' ')"
    pct="$(printf '%s' "$stats" | cut -f5 | tr -d ' ')"
    [ "$state" = IDLE ] || continue                               # never interrupt a working mind
    why="$(clear_reason "$win" "$last" "$pct" "$now")"            # pure precedence: post-claim > interval > ctx%
    [ -n "$why" ] || continue
    bg_gate "$win" || continue                                    # layer-2: never strand a running/undelivered bg batch
    handoff_gate "$win" || continue                               # snapshot-then-clear: stale handoff → defer
    warn_if_no_clear_trace "$win"
    if send_compact "$win"; then
      printf '%s' "$now" > "$f"
      compacted="$compacted ${win}(${why})"
      # LEDGER: record the clear (when · ctx% · tok · handoff coverage) so clears are fixed by numbers,
      # not blind. Best-effort — never let the ledger break the reflex. engine ← MODEL (Opus/claude vs opencode).
      case "$model" in *[Oo]pus*|*[Cc]laude*|*[Ss]onnet*|*[Hh]aiku*) _eng=claude;; *) _eng=opencode;; esac
      command -v mesh-clear-log >/dev/null 2>&1 && mesh-clear-log --record "$win" "$why" "${pct:-?}" "${tok:-?}" compact-reflex "$_eng" >/dev/null 2>&1 || true
    fi
  done
  [ -n "$compacted" ] && clog "$CTX_CMD →$compacted"
  exit 0
fi

if [ "${1:-}" = --status ]; then
  now=$(date +%s)
  for win in $WORKERS; do
    f="$STATE_DIR/.compact-${win}"
    if [ -f "$f" ]; then
      ts=$(cat "$f" 2>/dev/null || echo 0)
      age=$(( now - ts ))
      echo "$win: last compact ${age}s ago ($(date -d "@$ts" +%H:%MZ 2>/dev/null || date -r "$ts" +%H:%MZ 2>/dev/null || echo '?'))"
    else
      echo "$win: never compacted"
    fi
  done
  exit 0
fi

# If windows specified as args, use those; else default workers
TARGETS="${*:-$WORKERS}"
[ -z "${TARGETS// /}" ] && { echo "mesh-mind-compact: no targets"; exit 2; }

now=$(date +%s)
did_compact=0

for win in $TARGETS; do
  f="$STATE_DIR/.compact-${win}"
  last=0; [ -f "$f" ] && last=$(cat "$f" 2>/dev/null || echo 0)
  age=$(( now - last ))

  # Skip if recently compacted
  if [ "$age" -lt "$INTERVAL" ]; then
    echo "$(date -u +%Y-%m-%dT%H:%MZ) compact[$win]: fresh (${age}s < ${INTERVAL}s) — skip"
    continue
  fi

  # Skip if rate-limited / shed (cooldown file set by channel-keepalive)
  rlmark="$STATE_DIR/.rl-cooldown-${win}"
  if [ -f "$rlmark" ] && [ "$now" -lt "$(rl_epoch "$rlmark")" ]; then
    echo "$(date -u +%Y-%m-%dT%H:%MZ) compact[$win]: rate-limited (rlmark active) — skip"
    continue
  fi

  # Only compact when IDLE (not mid-turn)
  state="$(mesh-mind-state "$win" 2>/dev/null | head -1 | cut -f1)"
  if [ "$state" != "IDLE" ]; then
    echo "$(date -u +%Y-%m-%dT%H:%MZ) compact[$win]: state=$state — skip (not idle)"
    continue
  fi

  if ! bg_gate "$win"; then                                       # layer-2: never strand a running/undelivered bg batch
    echo "$(date -u +%Y-%m-%dT%H:%MZ) compact[$win]: bg batch running/undelivered — skip"
    continue
  fi
  if ! handoff_gate "$win"; then                                  # snapshot-then-clear: stale handoff → defer
    echo "$(date -u +%Y-%m-%dT%H:%MZ) compact[$win]: handoff stale and could not be refreshed — skip"
    continue
  fi
  echo "$(date -u +%Y-%m-%dT%H:%MZ) compact[$win]: sending $CTX_CMD (last=${age}s ago)"
  warn_if_no_clear_trace "$win"
  if send_compact "$win"; then
    printf '%s' "$now" > "$f"
    did_compact=$(( did_compact + 1 ))
    # LEDGER: manual-target clear (no ctx read on this path) — record it anyway so no clear goes unlogged.
    command -v mesh-clear-log >/dev/null 2>&1 && mesh-clear-log --record "$win" "interval ${age}s" "?" "?" compact-manual "?" >/dev/null 2>&1 || true
  fi
done

[ "$did_compact" -gt 0 ] && clog "$CTX_CMD sent to $did_compact mind(s): $TARGETS"

exit 0
