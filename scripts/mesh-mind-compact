  clear_has_trace genome && { rm -rf "$_cd"; echo "smoke-test: FAIL (clear_has_trace counted a post outside the lookback window)"; exit 1; }
  # warn_if_no_clear_trace must log [clear-no-trace] to compact.log on miss, and stay silent on a hit
