stty -echo -icanon time 0 min 1 2>/dev/null
buf=""
while :; do
  IFS= read -r -n1 ch
  case "$ch" in
    $'\x15') buf="" ;;
    $'\r'|$'\n') break ;;
    *) buf+="$ch" ;;
  esac
