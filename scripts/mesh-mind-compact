  s="$(printf ' Claude Code v2.1.220\n Opus 5 (1M context)\n ~/lte-workstation\n\n\n\xe2\x9d\xaf %s\n\n\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\n\xe2\x9d\xaf\xc2\xa0\n\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\n  \xe2\x8f\xb5\xe2\x8f\xb5 auto mode on (shift+tab to cycle)\n' "$CTX_CMD")"
  compact_still_stuck "$s" && { echo "smoke-test: FAIL (claude's echoed submitted '$CTX_CMD' above an EMPTY composer read as still-stuck — the confirm-never shape)"; exit 1; }
  # ...guard: a composer genuinely holding $CTX_CMD BELOW such an echo must still read STUCK.
  s="$(printf '\xe2\x9d\xaf %s\n\n\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\n\xe2\x9d\xaf\xc2\xa0%s\n\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\n  \xe2\x8f\xb5\xe2\x8f\xb5 auto mode on\n' "$CTX_CMD" "$CTX_CMD")"
  compact_still_stuck "$s" || { echo "smoke-test: FAIL (stuck composer below a transcript echo not detected)"; exit 1; }
  # NBSP prompt (chat-review/mindcompact-render-verify-cron-locale): live frames render '❯' + U+00A0
  # (non-breaking space, C2 A0) + $CTX_CMD, not a plain ASCII space. Falsify: drop the nbsp
  # alternation from compact_still_stuck's regex and this stops matching.
  s="$(printf '❯\xc2\xa0%s\n────\n  ⏵⏵ auto mode on · ← for agents\n' "$CTX_CMD")"
  compact_still_stuck "$s" || { echo "smoke-test: FAIL (NBSP-prompt '$CTX_CMD' not detected as stuck)"; exit 1; }
  # OPENCODE BOX PROMPT, AT ITS LIVE DISTANCE FROM THE BOTTOM (board task:mind-compact 2026-07-25,
  # priority:incident). Half this node's minds run opencode, whose input line is '┃' (U+2503) + spaces
  # + $CTX_CMD — no chevron — AND sits ~13 lines above the pane bottom, under the box border, a hints
