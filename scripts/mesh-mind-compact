)"
  compact_still_stuck "$s" && { echo "smoke-test: FAIL (empty opencode input box falsely flagged stuck)"; exit 1; }
  # THE SUBMITTED COMMAND LIVES ON, IN THE TRANSCRIPT. opencode renders a sent user message with the
  # SAME '┃  ' prefix, so a reader that scans the whole capture (the obvious "fix" for the geometry
  # problem) would read the just-sent '$CTX_CMD' as still sitting unsubmitted — the post-Enter ladder
  # would never confirm, nothing would ever stamp, and the reflex would look identical to the bug it
  # replaced. The window is anchored to the LAST '┃' line (the box's own status row) for exactly this
  # reason. Falsify: drop the head/tail anchoring and scan all of "$1" — this fires.
  s="$(cat <<EOF
  ┃  $CTX_CMD
  ┃
                                                                            ┃
                                                                            ┃
                                                                            ┃
                                                                            ┃  Build · GLM-5.2 Z.AI Coding Plan
                                                                            ╹▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀
