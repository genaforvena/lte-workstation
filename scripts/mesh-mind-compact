  warn_if_no_clear_trace senses
  grep -q 'clear-no-trace' "$_cd/compact.log" 2>/dev/null || { rm -rf "$_cd"; echo "smoke-test: FAIL (warn_if_no_clear_trace did not log on a traceless window)"; exit 1; }
  printf '%s  genome@testhost  ::  [done] real work\n' "$_now_iso" > "$CHAT_LOG"; rm -f "$_cd/compact.log"
  warn_if_no_clear_trace genome
  [ -s "$_cd/compact.log" ] && { rm -rf "$_cd"; echo "smoke-test: FAIL (warn_if_no_clear_trace logged despite a real recent trace)"; exit 1; }
  # EVENT TRIGGER (guy-fawxible per-claim reset): clear_has_completion must fire on a completion marker
  # posted AFTER the last clear, ignore completions BEFORE it, ignore non-completion posts, distinguish
  # windows. Falsify by dropping the marker filter or the cutoff comparison.
  CTX_CMD="/clear"
  _clr="$(date -u -d '@'"$(( $(date +%s) - 300 ))" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)"   # last clear = 5m ago
  _clr_epoch=$(( $(date +%s) - 300 ))
  _new="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  printf '%s  genome@testhost  ::  [done] finished claim work\n' "$_new" > "$CHAT_LOG"
  clear_has_completion genome "$_clr_epoch" || { rm -rf "$_cd"; echo "smoke-test: FAIL (clear_has_completion missed a [done] posted after last clear)"; exit 1; }
  clear_has_completion senses "$_clr_epoch" && { rm -rf "$_cd"; echo "smoke-test: FAIL (clear_has_completion matched a window that posted no completion)"; exit 1; }
  # a plain [fyi] (non-completion) must NOT trigger a per-claim reset
  printf '%s  genome@testhost  ::  [fyi] just context, not done\n' "$_new" > "$CHAT_LOG"
  clear_has_completion genome "$_clr_epoch" && { rm -rf "$_cd"; echo "smoke-test: FAIL (clear_has_completion fired on a non-completion [fyi])"; exit 1; }
  # a completion BEFORE the last clear must NOT re-trigger (each completion counts once)
  printf '2020-01-01T00:00:00Z  genome@testhost  ::  [claim-done] ancient\n' > "$CHAT_LOG"
  clear_has_completion genome "$_clr_epoch" && { rm -rf "$_cd"; echo "smoke-test: FAIL (clear_has_completion counted a completion older than the last clear)"; exit 1; }
  # CLEAR_REASON precedence (2026-07-16 universal idle backstop): post-claim > interval(any engine) >
  # ctx%(opencode early). The KEY new invariant: idle ≥ INTERVAL clears EVEN WITH a readable LOW % — the
  # old else-branch let a readable-% engine skip the time-based clear, so an idle opencode mind below its
  # %-threshold sat un-cleared forever. Falsify: nest the interval check under the `pct != ?` else (the
  # old structure) and the readable-low-% interval case below returns empty.
  INTERVAL=900; THRESHOLD=60; CTX_CMD="/clear"; : > "$CHAT_LOG"; _now=$(date +%s)
  [ -z "$(clear_reason w $((_now-60)) '?' $_now)" ] || { rm -rf "$_cd"; echo "smoke-test: FAIL (clear_reason cleared a FRESH idle mind, unreadable %)"; exit 1; }
  case "$(clear_reason w $((_now-1000)) '?' $_now)" in interval*) : ;; *) rm -rf "$_cd"; echo "smoke-test: FAIL (clear_reason did not interval-clear an idle mind past INTERVAL, unreadable %)"; exit 1;; esac
  case "$(clear_reason w $((_now-1000)) '10%' $_now)" in interval*) : ;; *) rm -rf "$_cd"; echo "smoke-test: FAIL (clear_reason skipped the UNIVERSAL interval clear because % was readable+low — the old else-branch bug)"; exit 1;; esac
  case "$(clear_reason w $((_now-60)) '80%' $_now)" in ctx*) : ;; *) rm -rf "$_cd"; echo "smoke-test: FAIL (clear_reason did not early-clear a bloated opencode mind at ctx≥THRESHOLD)"; exit 1;; esac
  [ -z "$(clear_reason w $((_now-60)) '30%' $_now)" ] || { rm -rf "$_cd"; echo "smoke-test: FAIL (clear_reason cleared a fresh idle opencode mind below THRESHOLD)"; exit 1; }
  printf '%s  w@h  ::  [done] finished\n' "$(date -u +%FT%TZ)" > "$CHAT_LOG"
  case "$(clear_reason w $((_now-60)) '?' $_now)" in post-claim) : ;; *) rm -rf "$_cd"; echo "smoke-test: FAIL (clear_reason post-claim did not win over a fresh idle window)"; exit 1;; esac
  : > "$CHAT_LOG"
  # RESOLVE_WINDOWS (2026-07-16): the default must read the LIVE session (self-maintaining — covers every
  # planted channel, not a drifting hardcoded list); MESH_MIND_WINDOWS pins an explicit set; no reachable
