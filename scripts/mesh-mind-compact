  CTX_CMD="/clear"; CLEAR_TRACE_LOOKBACK=1800
  clear_has_trace genome || { rm -rf "$_cd"; echo "smoke-test: FAIL (clear_has_trace missed a real recent chat.log post)"; exit 1; }
  clear_has_trace senses && { rm -rf "$_cd"; echo "smoke-test: FAIL (clear_has_trace matched a window that never posted)"; exit 1; }
