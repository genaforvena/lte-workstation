#!/usr/bin/env bash
# mesh-mind-compact — keep every mind's CONTEXT lean (and quota usage low) by sending /clear to IDLE
# minds. The context lever is /clear ONLY — /compact is RETIRED mesh-wide (operator 2026-07-18: "compact
# надо убирать вообще, везде только clear"); the tool name is kept for its callers/cron. The TRIGGER
# differs by engine (operator 2026-06-17 "clear these minds … depending on the mind"):
#   • opencode minds (senses/health/chat): context-% is readable from the footer → THRESHOLD-clear
#     (fire when context % >= pct). opencode does NOT auto-compact, so this is where it matters.
#   • claude minds (minds/genome/tg): the footer shows only a per-turn token delta, no context-% — and
#     claude AUTO-compacts near the limit. So we INTERVAL-clear (every MESH_COMPACT_INTERVAL when idle)
#     to keep it proactively lean / quota down, rather than chase an unreadable %.
# EVENT trigger — clear AFTER EVERY CLAIM (operator 2026-07-14 "minds should be cleared much more often",
# adopted from guy-fawxible's per-claim reset): the interval/threshold above are only BACKSTOPS. The
# primary lever is that an IDLE mind which has posted a completion marker ([done]/[claim-done]/[yield])
# to the board SINCE its last clear gets /cleared now — regardless of engine, %, or interval. By the
# handoff discipline a completed claim means state is already externalized, so this is the safe, ideal
# moment to reset: freshest context per unit of work. A short hard floor (MESH_COMPACT_MIN_COOLDOWN)
# prevents thrash; the interval still catches minds that idle without finishing a claim.
# Called standalone via cron (--high-tokens, the unified reflex) or by mesh-tick as a pre-nudge gate.
#
#   mesh-mind-compact [window ...]    interval-compact named windows (default: all mind windows)
#   mesh-mind-compact --status        show last-compact timestamps for all mind windows
#   mesh-mind-compact --high-tokens [pct]  THE REFLEX: post-claim (event) + opencode>pct% + claude interval
#   mesh-mind-compact --test          smoke test
#
# Env: MESH_COMPACT_INTERVAL     — seconds between interval-clears of an unfinished-but-idle mind (default 2700 = 45 min)
#      MESH_COMPACT_MIN_COOLDOWN — hard floor between clears of the same mind, incl. the post-claim path (default 180 = 3 min)
#      MESH_MIND_WINDOWS         — space-separated mind windows (default: minds genome tg senses health chat)
#
# Exit 0: compact sent (or already fresh). Exit 1: mind not idle (skip). Exit 2: n/a.
# reflex-cadence: */10 * * * *
# reflex-args: --high-tokens
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/restore.env" ] && . "$HOME/.mesh/restore.env" 2>/dev/null || true   # honor MESH_* overrides

# cron env is bare (LANG/LC_ALL unset → C locale) — under C locale, grep's bracket expression
# [❯›] treats these multi-byte UTF-8 glyphs byte-wise instead of as whole characters, and the live
# prompt renders a NON-BREAKING SPACE (U+00A0, C2 A0) after the glyph rather than an ASCII space — so
# compact_still_stuck's regex silently never matched when this reflex actually fired from cron
# (chat-review/mindcompact-render-verify-cron-locale). Probe for a real UTF-8 locale rather than
# blindly forcing one that might not exist on the box (that would itself silently fall back to C and
# reproduce the exact bug).
case "${LC_ALL:-}" in
  *[Uu][Tt][Ff]-?8*) : ;;  # already UTF-8, leave it alone
  *)
    for _cand in C.UTF-8 C.utf8 en_US.UTF-8; do
      locale -a 2>/dev/null | grep -qiFx "$_cand" && { export LC_ALL="$_cand"; break; }
    done
    unset _cand
    ;;
esac

SESS="$(hostname)"
INTERVAL="${MESH_COMPACT_INTERVAL:-2700}"   # 45 min default — interval backstop for an idle-but-unfinished mind
MIN_COOLDOWN="${MESH_COMPACT_MIN_COOLDOWN:-180}"   # hard floor between clears per mind (anti-thrash); also
                                                   # the fastest cadence the post-claim event trigger can fire
STATE_DIR="$HOME/.mesh"
# WINDOW SET — the minds to keep lean. SELF-MAINTAINING: default to the node's LIVE session windows
# (whatever mesh-restore actually planted) rather than a hand-maintained list. The old hardcoded default
# "minds genome tg senses health chat" DRIFTED — this node runs a 14-channel set (…room pub discover
# sound vpn bruno witness models), so 8 idle minds were NEVER auto-cleared and the operator had to /clear
# them by hand (2026-07-16). Deriving from the live session covers every channel — present and future —
# including ones absent from the MESH_MIND_CHANNELS allowlist (e.g. witness, planted outside that gate by
# mesh-restore). Non-mind windows (the bare `bash` window, data panes → mesh-mind-state reports
# DEAD-SHELL, never IDLE) are filtered by the state==IDLE gate in the loops below, so listing them here is
# harmless. Override with MESH_MIND_WINDOWS to pin an explicit set; falls back to the historical default
# when no live session is reachable (e.g. the --test sandbox, or cron before mesh-restore has run).
resolve_windows() {
  if [ -n "${MESH_MIND_WINDOWS:-}" ]; then printf '%s' "$MESH_MIND_WINDOWS"; return 0; fi
  local live; live="$(tmux list-windows -t "$SESS" -F '#{window_name}' 2>/dev/null | tr '\n' ' ')"
  if [ -n "${live// /}" ]; then printf '%s' "${live% }"; else printf '%s' "minds genome tg senses health chat"; fi
}
WINDOWS="$(resolve_windows)"
WORKERS="$WINDOWS"   # alias used by --status / default-targets path below

# CONTEXT LEVER (operator 2026-07-06 over TG "заменить /compact на /clear"): the idle-mind context reset
# is now /clear, not /compact. /compact summarizes the conversation and continues — carrying a summary
# blob forward every turn and paying a summarization call; /clear wipes context so the mind re-orients
# from the DURABLE COMMONS (board chat.log, MEMORY.md, voice-in.log, its dash pane, mission files) on the
# next wake. Cheaper on quota AND truer to the mesh doctrine (no cached state; liveness is a lease;
# re-observe live; reboot = clean reincarnation). SAFE ONLY with the end-of-session handoff discipline —
# every mind must persist in-flight state to a board [task]/[fyi] or memory BEFORE it idles, since /clear
# carries nothing forward. Only fires on IDLE minds (bare prompt).
#
# /compact is RETIRED across the mesh (operator 2026-07-18: "compact надо убирать вообще, везде только
# clear"). The context lever is /clear ONLY — no summary tier, no revert. Do NOT reintroduce a /compact
# fallback: the whole safety model (handoff snapshot, coverage gate, clear-log meter) is built for /clear.
CTX_CMD="/clear"

# ── ACTION-UNAWARENESS AT THE CLEAR BOUNDARY (LITERATURE, live review 2026-07-07, genome mind) ──
# Concept: Torresan, Suzuki, Kanai & Baltieri, "Active inference for action-unaware agents"
# (arXiv:2508.12027, Aug 2025). The paper splits active-inference agents into ACTION-AWARE (have an
# efference-copy signal — they KNOW their own last action and use that knowledge directly to plan) vs
# ACTION-UNAWARE (no efference copy — they must INFER their own recent motor behaviour from
# observations before they can plan the next policy). Their empirical finding: action-unaware agents
# reach performance comparable to action-aware ones, but only because they spend an explicit inference
# step reconstructing "what did I just do" from what's observable, rather than assuming the knowledge
# is simply there.
# Where this lands, precisely: /clear (above) is a hard efference-copy wipe — the pre-clear mind's
# internal record of its own last actions is gone. The CONTEXT LEVER comment above already names the
# fix this tool relies on: "the end-of-session handoff discipline — every mind must persist in-flight
# state to a board [task]/[fyi] or memory BEFORE it idles." That is the ACTION-AWARE design (the
# pre-reset self writes down its own efference copy on purpose) — sound when followed, but this reflex
# fires on bare-prompt IDLE alone (:~85, mind_alive/prompt check) and has NO check that the discipline
# was actually honored. A mind interrupted mid-task, or one that drifted idle without posting, gets
# /clear'd anyway — its successor wakes genuinely action-UNAWARE (no board post to infer "what I was
# doing" from) but the mesh does not treat it as such; it just starts fresh on whatever the next
# task-feed hands it, silently dropping the interrupted work.
# LANDED (observability step, 2026-07-07): clear_has_trace() below checks chat.log for a board post
# from this window in the trailing MESH_CLEAR_TRACE_LOOKBACK (default 30min) before /clear fires; if
# none is found, a [clear-no-trace] WARN is logged (compact.log, same as SEND-FAIL/SEND-UNCONFIRMED —
# not the board, to avoid chat noise on routine idle windows) instead of silently clearing blind.
# Deliberately WARN-only, not skip-and-defer: a skip-gate risks turning a legitimately-
# idle-with-nothing-to-report window (health/chat/senses idle clean is normal) into a permanent stall
# — that escalation stays HELD until the false-positive rate is observed for real across window types.
# This step alone converts the trust-based handoff discipline into a CHECKED, LOGGED one: an operator
# or mesh-reflex-health can now grep chat.log for [clear-no-trace] and see exactly which clears fired
# on a mind with no externalized trace, instead of it being invisible. Discard candidate ruled OUT:
# applying full expected-free-energy action inference to mesh minds is not warranted — the paper's
# mechanism is for sub-symbolic motor/navigation agents inferring continuous state from continuous
# observation; a text-native mind's "action" is already a discrete, loggable board post, so the fix is
# "verify the log happened," not "infer the unobserved action."

# [compact] is routine housekeeping, NOT board conversation. Operator task compact-noise (2026-06-20):
# 189 [compact] lines were flooding mesh-chat, drowning real coordination. Record each compaction to a
# local timestamped log instead; the board stays for actual coordination, and `--status` still surfaces
# per-mind compaction state on demand. (No board consumer reads [compact] — verified before rerouting.)
clog(){ printf '%s %s\n' "$(date -u +%FT%TZ)" "$*" >> "$STATE_DIR/compact.log" 2>/dev/null || true; }

# Helper: read cooldown epoch from rlmark file (format: epoch|count or raw epoch)
rl_epoch() { cat "$1" 2>/dev/null | cut -d'|' -f1 || echo 0; }

# compact_still_stuck — pure text check (operates on already-captured pane text, no live tmux call, so
# it's directly fixture-testable): true if the bottom of the pane still shows $CTX_CMD sitting unsubmitted
# on an input line. Mirrors mesh-mind-state's input_stuck_text/WEDGED-INPUT detection — the SAME harness
# bug (C-m eaten, submission never lands) that tool proved live 2026-07-06 16:18Z/17:32Z.
compact_still_stuck() { # $1=pane capture text
  local esc; esc="$(printf '%s' "$CTX_CMD" | sed 's/[.[\*^$/]/\\&/g')"
  # live frames render the prompt as '❯' + U+00A0 (non-breaking space, UTF-8 C2 A0) + $CTX_CMD, not a
  # plain ASCII space — [[:space:]] alone never matches NBSP, so accept either explicitly
  # (chat-review/mindcompact-render-verify-cron-locale).
  local nbsp=$'\xc2\xa0'
  printf '%s\n' "$1" | tail -8 | grep -qE '^[[:space:]]*[❯›]('"$nbsp"'|[[:space:]])+'"$esc"'[[:space:]]*$'
}

# POLL LADDERS (chat-review/mindcompact-render-verify-cron-locale, health amendment 2026-07-07T01:56Z):
# env-overridable so --test can keep its mocks fast while production gets real patience. Health
# reproduced the 20:30Z-01:30Z SEND FAILED streak live and found the ORIGINAL diagnosis (locale/NBSP)
# wrong: compact_still_stuck already matched the real frame under en_US.UTF-8, C.UTF-8, AND plain C
# (all three tested) — the locale export above is harmless but fixes nothing. The REAL cause: under a
# "whisper-storm"-starved TUI, the render-wait (was ~3s) and post-C-m clear-wait (was ~7s) budgets were
# too short — the redraw was simply slow, not stuck (manual paste+single-C-m submitted instantly once
# load fell). Floored both ladders to ~30s so a starved-but-working TUI gets real time.
RENDER_LADDER="${MESH_COMPACT_RENDER_LADDER:-0.2 0.3 0.5 1 2 4 8 15}"
CLEAR_LADDER="${MESH_COMPACT_CLEAR_LADDER:-1 2 4 8 15}"

# send the context lever ($CTX_CMD = /clear by default, /compact if reverted) to a window's MIND pane
# (bottom), via paste-buffer + C-m — reliable for any TUI. SUBMIT-VERIFY (chat-review/mindcompact-
# verify-render-then-submit 2026-07-06, REWORK of the 643a306 fixed-1s check): the fixed-1s absence
# check FALSE-PASSED live TWICE post-643a306 (18:30:16Z stamped→18:32:17Z wedged; 19:00:08Z stamped→
# 19:25Z wedged) — under TUI redraw lag (thermal throttle) the pane can still be mid-repaint at +1s,
# so a transient/incomplete frame doesn't match the stuck pattern and the check reads a false "cleared".
# Fix inverts the check into two bounded polls instead of one fixed sleep: (1) after pasting, POLL until
# the input line actually RENDERS $CTX_CMD before ever sending C-m — sending Enter against a screen that
# hasn't caught up to the paste is exactly what let a truly-stuck submission slip past; (2) after C-m,
# POLL-CLEARED with escalating waits — giving a lagging redraw repeated chances to catch up before
# concluding "still stuck" — instead of trusting one fixed-delay sample. THE ONE SEND PATH: both
# --high-tokens and the manual TARGETS loop call this — no duplicated inline paste-buffer block that a
# fix to one path could miss.
#
# NEVER-C-u-AFTER-COMMIT (health amendment 2026-07-07T01:56Z): once C-m has actually been sent, the
# input line MAY legitimately still be mid-flight through a starved TUI — a cleanup C-u at that point
# (the OLD unconditional final-failure C-u, and the OLD retry-loop's leading C-u on a 2nd attempt) can
# KILL a submission that was seconds from landing (exactly what happened live: 11 "SEND FAILED"s where
# the real Enter had gone through, just slower than the poll ladder's patience). So: a cleanup C-u is
# safe ONLY when C-m was NEVER sent (nothing but our own stray paste is on the line — clearing it is
# harmless); once committed, on a clear-ladder timeout we STOP touching the pane entirely and leave it
# for mesh-mind-state's independent WEDGED-INPUT watchdog to judge on its own schedule, rather than
# gambling that our giving-up implies failure.

# clear_has_trace — action-unawareness gate (see literature block above). Only meaningful ahead of
# /clear (a /compact carries its own summary forward, nothing to check). Returns 0 if this window
# posted to chat.log (self-derived "$win@host" tag — see mesh-chat derive_who) within the trailing
# MESH_CLEAR_TRACE_LOOKBACK seconds; 1 if no such trace (WARN-only caller, never blocks the send).
CLEAR_TRACE_LOOKBACK="${MESH_CLEAR_TRACE_LOOKBACK:-1800}"
CHAT_LOG="$STATE_DIR/chat.log"
clear_has_trace() { # $1=win → 0 recent board-post trace found, 1 none
  local win="$1" cutoff
  [ "$CTX_CMD" = "/clear" ] || return 0   # only /clear destroys the efference copy; nothing to gate
  [ -f "$CHAT_LOG" ] || return 1
  cutoff="$(date -u -d "@$(( $(date +%s) - CLEAR_TRACE_LOOKBACK ))" +%Y-%m-%dT%H:%M 2>/dev/null)" || return 0
  awk -v win="$win" -v cutoff="$cutoff" '
    length($0) >= 16 {
      ts = substr($0, 1, 16)
      if (ts >= cutoff && $0 ~ ("[ \t]" win "@[^ \t]+[ \t]+::")) { found=1; exit }
    }
    END { exit !found }
  ' "$CHAT_LOG"
}

# clear_has_completion — the EVENT trigger (guy-fawxible per-claim reset, operator 2026-07-14). Returns 0
# if this window posted a COMPLETION marker ([done]/[claim-done]/[yield]) to chat.log SINCE its last clear
# ($1=win, $2=last-clear-epoch) — i.e. it just finished a claimed unit of work and, by the handoff
# discipline, has already externalized its state. That is the ideal moment to /clear: freshest context per
# unit of work, ahead of the interval/threshold backstops. Engine-agnostic (opencode minds finish claims
# too). Only meaningful for /clear — /compact carries its summary forward, so there is nothing to reset by
# claim. The last-clear cutoff (not a fixed lookback) means each completion counts exactly once: after the
# clear fires, $last advances past that [done] line so the same completion can't re-trigger.
clear_has_completion() { # $1=win $2=since_epoch → 0 completion posted since, 1 none
  local win="$1" since="${2:-0}" cutoff
  [ "$CTX_CMD" = "/clear" ] || return 1                 # /compact keeps its summary — no per-claim reset
  [ -f "$CHAT_LOG" ] || return 1
  case "$since" in (*[!0-9]*|"") since=0;; esac
  cutoff="$(date -u -d "@$since" +%Y-%m-%dT%H:%M 2>/dev/null)" || return 1
  awk -v win="$win" -v cutoff="$cutoff" '
    length($0) >= 16 {
      ts = substr($0, 1, 16)
      if (ts >= cutoff && $0 ~ ("[ \t]" win "@[^ \t]+[ \t]+::") \
          && $0 ~ /\[(done|claim-done|yield)\]/) { found=1; exit }
    }
    END { exit !found }
  ' "$CHAT_LOG"
}

# warn_if_no_clear_trace — call immediately before send_compact at every call site; logs, never blocks.
warn_if_no_clear_trace() { # $1=win
  clear_has_trace "$1" || {
    echo "$(date -u +%Y-%m-%dT%H:%MZ) compact[$1]: [clear-no-trace] no board post in last ${CLEAR_TRACE_LOOKBACK}s — clearing anyway (WARN-only, see literature block)" >&2
    clog "[clear-no-trace] $1: firing /clear with no chat.log trace in last ${CLEAR_TRACE_LOOKBACK}s"
  }
}

# clear_reason — PURE trigger decision (fixture-testable; no live tmux). Given an ALREADY-IDLE window
# (the caller enforces state==IDLE — we never interrupt a working mind), echo the reason to /clear it
# now, or nothing to skip. Precedence:
#   1. post-claim — a completion marker ([done]/[claim-done]/[yield]) posted since the last clear.
#   2. interval   — idle ≥ INTERVAL: the UNIVERSAL backstop (ANY engine) — the operator's "clear every
#                   idle mind after N min" (2026-07-16). Deliberately ABOVE the %-threshold so a
#                   readable-% engine (opencode) still gets the time-based clear it used to MISS while
#                   sitting idle below its %-threshold (the old else-branch only ran the interval when %
#                   was unreadable, so idle opencode minds could sit un-cleared indefinitely).
#   3. ctx %      — opencode only (readable %): an EARLY clear when context ≥ THRESHOLD, before INTERVAL.
# INTERVAL / THRESHOLD / CTX_CMD / CHAT_LOG are globals set by the caller.
clear_reason() { # $1=win $2=last_clear_epoch $3=pct $4=now  → echoes reason | empty=skip
  local win="$1" last="$2" pct="$3" now="$4" idle
  idle=$(( now - last ))
  if clear_has_completion "$win" "$last"; then echo "post-claim"; return 0; fi
  if [ "$idle" -ge "$INTERVAL" ]; then echo "interval $(( idle/60 ))m"; return 0; fi
  if [ -n "$pct" ] && [ "$pct" != "?" ]; then
    local pct_n="${pct%\%}"
    case "$pct_n" in (*[!0-9]*|"") return 0;; esac
    [ "$pct_n" -ge "$THRESHOLD" ] && { echo "ctx ${pct}≥${THRESHOLD}%"; return 0; }
  fi
  return 0
}

send_compact() { # $1=win → 0 verified-submitted, 1 not confirmed (caller must not stamp)
  local win="$1" pidx pane cb64 attempt cap w rendered committed=0
  pidx="$(tmux list-panes -t "${SESS}:${win}" -F '#{pane_top} #{pane_index}' 2>/dev/null | sort -n | tail -1 | awk '{print $2}')"
  pane="${SESS}:${win}${pidx:+.$pidx}"
  cb64="$(printf '%s' "$CTX_CMD" | base64 | tr -d '\n')"
  for attempt in 1 2; do
    tmux send-keys -t "$pane" C-u 2>/dev/null || true; sleep 0.1
    echo "$cb64" | base64 -d | tmux load-buffer -b mc$$ - 2>/dev/null
    tmux paste-buffer -p -d -b mc$$ -t "$pane" 2>/dev/null
    rendered=""
    for w in $RENDER_LADDER; do
      sleep "$w"
      cap="$(tmux capture-pane -t "$pane" -p 2>/dev/null)"
      compact_still_stuck "$cap" && { rendered=1; break; }
    done
    if [ -z "$rendered" ]; then
      [ "$attempt" = 1 ] && echo "$(date -u +%Y-%m-%dT%H:%MZ) compact[$win]: paste never rendered, retrying once" >&2
      continue
    fi
    tmux send-keys -t "$pane" C-m 2>/dev/null
    committed=1   # Enter is now in flight — from here on, NEVER C-u this pane (see header note above)
    for w in $CLEAR_LADDER; do
      sleep "$w"
      cap="$(tmux capture-pane -t "$pane" -p 2>/dev/null)"
      compact_still_stuck "$cap" || return 0
    done
    break   # committed but unconfirmed — stop; a 2nd attempt's leading C-u would risk killing an
            # in-flight-but-merely-slow submission
  done
  if [ "$committed" = 1 ]; then
    echo "$(date -u +%Y-%m-%dT%H:%MZ) compact[$win]: '$CTX_CMD' submitted but not confirmed cleared (slow TUI?) — leaving pane untouched for the wedge detector; NOT stamping" >&2
    clog "SEND-UNCONFIRMED $win: $CTX_CMD submitted, clear not observed — not stamped, pane left untouched"
  else
    tmux send-keys -t "$pane" C-u 2>/dev/null || true
    echo "$(date -u +%Y-%m-%dT%H:%MZ) compact[$win]: SEND FAILED — '$CTX_CMD' paste never rendered after retry; NOT stamping" >&2
    clog "SEND-FAIL $win: $CTX_CMD paste never rendered — not stamped"
  fi
  return 1
}

if [ "${1:-}" = --test ]; then
  # Sandbox STATE_DIR FIRST (before any clog() calls) so test writes don't pollute live ~/.mesh
  # (memory: reflex-test-must-sandbox-outbound). clog() at line 103 + send_compact calls
  # will use this temp directory, not the live state directory.
  _cd="$(mktemp -d)"; STATE_DIR="$_cd"; CHAT_LOG="$_cd/chat.log"

  # SHARED-SERVER ISOLATION (live incident 2026-07-14 22:44:59Z on mesh-home): these fixtures used to
  # run on the node's DEFAULT tmux server — the append-only sensorium itself. On a server whose only
  # remaining sessions are this test's fixtures, an inline `kill-session` ends the LAST session and
  # tmux exits, taking the whole server down; that night the node session had already gone, this test's
  # kill-session finished the server off, and case B below had to start a brand-new one (which then
  # became the server mesh-restore rebuilt the node session in). A test must never be able to touch the
  # node's server at all. Same fix as mesh-quota-react/mesh-tell: a per-invocation TMUX_TMPDIR relocates
  # the DEFAULT socket for the fixtures AND every inheriting subprocess with one env var and zero
  # tool-code changes. Hard-fail if we cannot isolate — never fall back to the shared server.
  _mc_td="$(mktemp -d 2>/dev/null)" || _mc_td=""
  [ -n "$_mc_td" ] || { rm -rf "$_cd"; echo "smoke-test: FAIL (mktemp -d failed — refusing to run tmux fixtures on the node's shared server)"; exit 1; }
  export TMUX_TMPDIR="$_mc_td"
  # `unset TMUX` is LOAD-BEARING: from INSIDE a pane ($TMUX set — doctor's smoke-sweep, or a mind
  # running --test in its channel) tmux takes the socket path FROM $TMUX and ignores TMUX_TMPDIR, so
  # the fixtures land on the node's DEFAULT server and the teardown kill-server takes the node session
  # + every mind pane with it (live incident 2026-07-14 23:00Z, 14-window session killed).
  unset TMUX
  _mc_sock="$_mc_td/tmux-$(id -u)/default"

  # EXIT trap kills every test session (live case 2026-07-07 on ds: doctor's `timeout 12` SIGTERM'd
  # the test between new-session and its inline kill-session — the norender mock blocks on read
  # forever, so test-compact-norender-* sessions leaked hourly, one per doctor run, until swept).
  # Inline kill-sessions below stay (fast path); this is the can't-leak backstop for TERM/INT/FAIL-exit.
  # The kill-server teardown is guarded on OUR PRIVATE SOCKET FILE existing — never on $TMUX_TMPDIR,
  # which stays set even when tmux is talking to the DEFAULT socket; that false guard is exactly what
  # let kill-server reach the node's server. Socket path = real observable; env var = a claim.
  trap 'for _s in "test-compact-$$" "test-compact-render-$$" "test-compact-norender-$$" "test-compact-noclear-$$" "test-compact-rw-$$"; do tmux kill-session -t "$_s" 2>/dev/null; done; [ -S "${_mc_sock:-}" ] && tmux kill-server 2>/dev/null; rm -rf "$_cd" "$_mc_td"' EXIT TERM INT

  command -v tmux >/dev/null 2>&1 || { rm -rf "$_cd"; echo "smoke-test: FAIL (no tmux)"; exit 1; }
  command -v mesh-mind-state >/dev/null 2>&1 || { rm -rf "$_cd"; echo "smoke-test: FAIL (no mesh-mind-state)"; exit 1; }
  command -v base64 >/dev/null 2>&1 || { rm -rf "$_cd"; echo "smoke-test: FAIL (no base64)"; exit 1; }
  # create a temp session with 2 panes stacked vertically (top=data, bottom=mind)
  _ts="test-compact-$$"
  tmux new-session -d -s "$_ts" -x 80 -y 10 'echo data-pane; sleep 60' 2>/dev/null
  tmux split-window -t "$_ts:0.0" -v 'echo mind-pane; sleep 60' 2>/dev/null
  sleep 0.3
  # ISOLATION (load-bearing, two real observables): our private server exists (what the kill-server
  # teardown is guarded on), and the fixture is INVISIBLE to the node's default tmux server — i.e.
  # this test cannot reach, let alone kill, the node session or its server. Falsify: drop the
  # `unset TMUX` above and run from inside a pane → the fixture appears on the default socket → FAIL.
  [ -S "$_mc_sock" ] || {
    echo "smoke-test: FAIL (no private tmux socket at $_mc_sock — fixtures are NOT isolated)"; exit 1; }
  env -u TMUX_TMPDIR tmux has-session -t "$_ts" 2>/dev/null && {
