#!/usr/bin/env bash
# orphan-ok: on-demand NIC receive-path inspection; sampled manually when investigating unhandled frames
# mesh-nic-rx-nohandler — kernel-observed frames with no protocol handler.
# Reads /sys/class/net/<physical>/statistics/rx_nohandler, a monotonic kernel counter for
# packets received by a NIC but not delivered to a protocol handler. This is distinct from
# carrier state, route reachability, and ordinary RX byte/packet volume.
#
# Honest contract: no readable physical interface is UNREACHABLE (exit 2); no zero/default
# is substituted for a missing counter. A successful run writes the live counter to state.
set -euo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6)
export HOME

MESH="${MESH_DIR:-$HOME/.mesh}"
STATE="${MESH_RX_NOHANDLER_STATE:-$MESH/.nic-rx-nohandler-state}"
SYS_NET="${MESH_RX_NOHANDLER_SYS_NET:-/sys/class/net}"

read_counter() {
  local root="$1" dir iface value
  for dir in "$root"/*; do
    [ -d "$dir" ] || continue
    iface="${dir##*/}"
    [ "$iface" != lo ] || continue
    # /device identifies a kernel-backed physical device; do not mistake virtual links for hardware.
    [ -e "$dir/device" ] || continue
    [ -r "$dir/statistics/rx_nohandler" ] || continue
    value="$(tr -d '[:space:]' < "$dir/statistics/rx_nohandler" 2>/dev/null)"
    [[ "$value" =~ ^[0-9]+$ ]] || continue
    printf '%s\t%s\n' "$iface" "$value"
    return 0
  done
  return 1
}

if [ "${1:-}" = --test ]; then
  td="$(mktemp -d)"
  trap 'rm -rf "$td"' EXIT
  mkdir -p "$td/fixture/device" "$td/fixture/statistics"
  printf '17\n' > "$td/fixture/statistics/rx_nohandler"
  got="$(read_counter "$td")" || { echo 'smoke-test: FAIL (fixture counter unreadable)'; exit 1; }
  [ "$got" = $'fixture\t17' ] || { echo "smoke-test: FAIL (fixture parse: $got)"; exit 1; }

  live="$(read_counter "$SYS_NET" 2>/dev/null)" || {
    echo "smoke-test: n/a (no readable physical rx_nohandler under $SYS_NET)"
    exit 2
  }
  iface="${live%%$'\t'*}"
  value="${live##*$'\t'}"
  [[ "$iface" != lo && "$value" =~ ^[0-9]+$ ]] || {
    echo "smoke-test: FAIL (live rx_nohandler malformed: $live)"
    exit 1
  }
  echo "smoke-test: ok (fixture + REAL $iface rx_nohandler=$value)"
  exit 0
fi

live="$(read_counter "$SYS_NET" 2>/dev/null)" || {
  echo "mesh-nic-rx-nohandler: UNREACHABLE — no readable physical rx_nohandler under $SYS_NET" >&2
  exit 2
}
iface="${live%%$'\t'*}"
value="${live##*$'\t'}"
mkdir -p "$(dirname "$STATE")"
ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
printf 'iface=%s|rx_nohandler=%s|ts=%s\n' "$iface" "$value" "$ts" > "$STATE"
mesh-state-touch "$STATE"

case "${1:-}" in
  --json) printf '{"interface":"%s","rx_nohandler":%s,"source":"%s","ts":"%s"}\n' "$iface" "$value" "$SYS_NET/$iface/statistics/rx_nohandler" "$ts" ;;
  '') printf '[nic-rx-nohandler] iface=%s rx_nohandler=%s\n' "$iface" "$value" ;;
  *) echo "mesh-nic-rx-nohandler: unknown arg '$1'" >&2; exit 2 ;;
esac
