#!/usr/bin/env python3
# orphan-ok: on-demand process-churn snapshot — two-sample fork/context-switch RATE
#   from /proc/stat, sampled when asked (like mesh-irq-rate), not scheduled.
"""mesh-proc-churn — the node's PROCESS-CHURN sense from /proc/stat.

Reads /proc/stat twice and computes two RATE signals no other mesh sense reads:
  * fork rate  — delta of the cumulative `processes` counter (new process
                 spawns/second: fork()/clone()). A fork STORM = a runaway shell
                 loop, a mind respawn-loop, a cron pile-up, or a fork bomb.
  * ctxt rate  — delta of the cumulative `ctxt` counter (context switches/second):
                 the kernel's SCHEDULING THRASH. High ctxt with low fork = too many
                 runnable threads contending for the CPUs (mind storm on a hot node).
Plus the instantaneous procs_running / procs_blocked snapshot (queue depth / D-state).

WHY THIS IS NEW — distinct from every existing load/CPU sense:
  mesh-loadavg      → runnable-QUEUE DEPTH (how many wait), not spawn/switch RATE
  mesh-psi/-memory  → resource STALL pressure (waiting on mem/io/cpu), not churn
  mesh-cpu-throttle → thermal performance LOSS, not scheduling activity
  mesh-irq-rate     → hardware INTERRUPT rate, a different /proc file entirely
  mesh-proc-churn   → how fast the node SPAWNS and SWITCHES — its metabolic tempo.
On a busy multi-mind node (this IdeaPad runs ~350 forks/s under a full reflex load)
a sudden 5x spike is a fork-loop signature the queue-depth view cannot see.

HONEST: exit 2 (UNREACHABLE) when /proc/stat is unreadable or lacks the counters — a
  sandboxed/exotic kernel gets a BLIND report, never a fabricated 0. No state file, so
  nothing to decay: every run is a fresh two-sample read (not change-gated → no
  mesh-state-touch needed, same as mesh-irq-rate).
"""
import json
import os
import sys
import time

STAT = os.environ.get("MESH_STAT_PATH", "/proc/stat")
STAT2 = os.environ.get("MESH_STAT_PATH2", STAT)
SLEEP_SECS = float(os.environ.get("MESH_CHURN_SAMPLE_SECS", "1"))

# fork/s classification bands (calibrated on a busy mesh node ~350/s = its BUSY baseline;
# an idle Linux desktop sits ~2-10/s). Labels are descriptive, not alarms.
FORK_ACTIVE = 10
FORK_BUSY = 100
FORK_STORM = 500


def parse_stat(path):
    """Return {'ctxt','processes','procs_running','procs_blocked'} or None if the file
    is unreadable OR lacks the two cumulative counters we require (honest BLIND)."""
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as fh:
            lines = fh.read().splitlines()
    except OSError:
        return None
    out = {}
    for line in lines:
        parts = line.split()
        if len(parts) < 2:
            continue
        key = parts[0]
        if key in ("ctxt", "processes", "procs_running", "procs_blocked"):
            try:
                out[key] = int(parts[1])
            except ValueError:
                continue
    # ctxt + processes are the load-bearing counters — absent → unusable read.
    if "ctxt" not in out or "processes" not in out:
        return None
    return out


def classify(fork_rate):
    if fork_rate < FORK_ACTIVE:
        return "QUIET"
    if fork_rate < FORK_BUSY:
        return "ACTIVE"
    if fork_rate < FORK_STORM:
        return "BUSY"
    return "STORM"


def compute(before, after, elapsed):
    elapsed = max(elapsed, 0.001)
    fork_rate = max(0.0, (after["processes"] - before["processes"]) / elapsed)
    ctxt_rate = max(0.0, (after["ctxt"] - before["ctxt"]) / elapsed)
    return fork_rate, ctxt_rate


def _test():
    import tempfile

    td = tempfile.TemporaryDirectory()
    try:
        s1 = os.path.join(td.name, "stat1")
        s2 = os.path.join(td.name, "stat2")
        with open(s1, "w", encoding="utf-8") as fh:
            fh.write(
                "cpu  1 2 3 4 5 6 7 8\n"
                "ctxt 1000\n"
                "processes 500\n"
                "procs_running 3\n"
                "procs_blocked 0\n"
            )
        with open(s2, "w", encoding="utf-8") as fh:
            fh.write(
                "cpu  9 9 9 9 9 9 9 9\n"
                "ctxt 9200\n"       # +8200 over 1s
                "processes 700\n"   # +200 forks over 1s → BUSY band
                "procs_running 11\n"
                "procs_blocked 1\n"
            )
        a = parse_stat(s1)
        b = parse_stat(s2)
        if a is None or b is None:
            print("smoke-test: FAIL (fixture parse failed)")
            return 1
        # REAL-READ GATE: assert the live /proc/stat actually yields the counters here
        # (not just the offline fixtures) — a reachable-but-hollow read must fail --test.
        live = parse_stat(STAT)
        if live is None or "ctxt" not in live or "processes" not in live:
            print("smoke-test: FAIL (live /proc/stat lacks ctxt/processes counters)")
            return 1
        fork_rate, ctxt_rate = compute(a, b, 1.0)
        if round(fork_rate) != 200 or round(ctxt_rate) != 8200:
            print(f"smoke-test: FAIL (rates wrong: fork={fork_rate} ctxt={ctxt_rate})")
            return 1
        if classify(fork_rate) != "BUSY":
            print(f"smoke-test: FAIL (classify({fork_rate}) != BUSY)")
            return 1
        if classify(5) != "QUIET" or classify(50) != "ACTIVE" or classify(999) != "STORM":
            print("smoke-test: FAIL (classify bands wrong)")
            return 1
        if b["procs_running"] != 11 or b["procs_blocked"] != 1:
            print("smoke-test: FAIL (snapshot fields wrong)")
            return 1
        # honest BLIND: unreadable path → None (never a fabricated 0)
        if parse_stat("/nonexistent/stat") is not None:
            print("smoke-test: FAIL (missing file should not parse)")
            return 1
        # a /proc/stat lacking the required counters → None, not a partial fake
        s3 = os.path.join(td.name, "stat3")
        with open(s3, "w", encoding="utf-8") as fh:
            fh.write("cpu 1 2 3\nintr 5\n")
        if parse_stat(s3) is not None:
            print("smoke-test: FAIL (stat without ctxt/processes should be BLIND)")
            return 1
        print("smoke-test: ok (parse/rate/classify/snapshot + live-read gate + BLIND on missing/partial)")
        return 0
    finally:
        td.cleanup()


def main():
    args = sys.argv[1:]
    if "--test" in args:
        raise SystemExit(_test())

    start = parse_stat(STAT)
    if start is None:
        print("mesh-proc-churn: /proc/stat unreadable or missing ctxt/processes — UNREACHABLE", file=sys.stderr)
        raise SystemExit(2)
    start_ts = time.time()
    if STAT2 == STAT:
        time.sleep(max(SLEEP_SECS, 0.0))
    end = parse_stat(STAT2)
    if end is None:
        print("mesh-proc-churn: /proc/stat unreadable or missing ctxt/processes — UNREACHABLE", file=sys.stderr)
        raise SystemExit(2)
    end_ts = time.time()

    elapsed = max(end_ts - start_ts, 0.001)
    fork_rate, ctxt_rate = compute(start, end, elapsed)
    level = classify(fork_rate)
    running = end.get("procs_running", "?")
    blocked = end.get("procs_blocked", "?")

    if "--json" in args:
        print(json.dumps({
            "level": level,
            "fork_per_s": round(fork_rate, 1),
            "ctxt_per_s": round(ctxt_rate, 1),
            "elapsed_s": round(elapsed, 3),
            "procs_running": running,
            "procs_blocked": blocked,
            "forks_total": end["processes"],
            "ctxt_total": end["ctxt"],
            "ts": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        }))
        raise SystemExit(0)

    print(f"[proc-churn] {level} — {fork_rate:.1f} forks/s, {ctxt_rate:.0f} ctxt-sw/s "
          f"over {elapsed:.2f}s | running={running} blocked={blocked} "
          f"| forks-total={end['processes']}")


if __name__ == "__main__":
    main()
