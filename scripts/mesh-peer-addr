#!/usr/bin/env bash
# mesh-peer-addr — find the best reachable address for a mesh peer.
#
# Tries Tailscale IP first (ping -c1 -W1), falls back to LAN IP if Tailscale is down.
# Reads peer map from ~/.mesh/nodes (or hardcoded fallback).
#
# Usage:
#   mesh-peer-addr <peer-name>   return the best reachable address
#
# The peer map format (in ~/.mesh/nodes or hardcoded):
#   <peer-hostname>\t<tailscale-ip>\t<lan-ip>
#
# Example:
#   mesh-peer-addr ilya    → "100.107.198.111" (if Tailscale up)
#   mesh-peer-addr ilya    → "192.168.8.242" (if Tailscale down)

set -euo pipefail

# --- peer map ----------------------------------------------------------
PEER_MAP="${PEER_MAP:-}"
if [[ -z "$PEER_MAP" ]]; then
# Hardcoded map if ~/.mesh/nodes not present
    # Format: <hostname>\t<tailscale-ip>\t<lan-ip>
    cat <<'EOF' > /tmp/peer_map.tmp
IdeaPad	100.73.170.56	192.168.8.241
ilya	100.107.198.111	192.168.8.242
default-string	100.125.157.75	100.125.157.75
Redmi	100.103.99.16	100.103.99.16
router	100.105.241.84	192.168.8.1
EOF
    PEER_MAP="$(cat /tmp/peer_map.tmp)"
fi

# --- smoke test ---------------------------------------------------------
if [ "${1:-}" = "--test" ]; then
    command -v ping >/dev/null 2>&1 || { echo "smoke-test: FAIL (ping not found)"; exit 1; }
    echo "smoke-test: ok"; exit 0
fi

# --- lookup peer --------------------------------------------------------
if [[ $# -lt 1 ]]; then
    echo "usage: mesh-peer-addr <peer-name>" >&2
    exit 1
fi

PEER_NAME="$1"
TS_IP=""
LAN_IP=""
while read -r host ts_ip lan_ip; do
    if [[ "$host" == "$PEER_NAME" ]]; then
        TS_IP="$ts_ip"
        LAN_IP="$lan_ip"
        break
    fi
done <<<"$PEER_MAP"

if [[ -z "$TS_IP" ]]; then
    echo "mesh-peer-addr: unknown peer '$PEER_NAME'" >&2
    echo "  known peers:" >&2
    while read -r host ts_ip lan_ip; do
        echo "    $host: ts=$ts_ip lan=$lan_ip" >&2
    done <<<"$PEER_MAP"
    exit 1
fi

# --- try Tailscale IP ----------------------------------------------------
if ping -c 1 -W 1 "$TS_IP" >/dev/null 2>&1; then
    echo "$TS_IP"
    exit 0
fi

# --- fall back to LAN IP -----------------------------------------------
echo "$LAN_IP"