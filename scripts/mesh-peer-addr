#!/usr/bin/env bash
# mesh-peer-addr — find the best reachable address for a mesh peer.
#
# Tries Tailscale IP first (ping -c1 -W1), falls back to a node-local LAN IP if Tailscale is down.
# Reads peer map from ~/.mesh/nodes.
#
# Usage:
#   mesh-peer-addr <peer-name>   return the best reachable address
#
# The peer map format (built from ~/.mesh/nodes, or injected via $PEER_MAP):
#   <peer-hostname>\t<tailscale-ip>\t<lan-ip>[ <lan-ip>...]
#
# Example:
#   mesh-peer-addr ilya    → "<tailscale-ip>" (if Tailscale up)
#   mesh-peer-addr ilya    → "<lan-ip>" (if Tailscale down, LAN ip answers)
#
# live=reachable, NOT tailscale-only (operator 2026-06-19). LAN candidates come from the SAME
# node-local contract mesh-health:66 / mesh-fleet-health:20 / mesh-lan-presence:23 already read —
# MESH_LAN_FALLBACK="Host:lan-ip ..." plus PHONE_LAN_IPS for the phone body. There is one map, not
# a second one invented here.
#
# 2026-07-15: for 26d this tool's LAN column WAS the tailscale column — the MESH_NODES parser wrote
# ts_ip into both, MESH_LAN_FALLBACK was read NOWHERE, and "falls back to LAN IP" fell back to the
# corpse it was rescuing you from. The operator wrote that map the day the router's tailscale died
# and it was never consulted. The gate passed throughout by INJECTING a PEER_MAP row with lan!=ts —
# a shape the live parser could not emit — so it guarded a path that did not exist. Every gate below
# drives the REAL parser off a REAL nodes file; none may inject PEER_MAP.

set -euo pipefail

smoke_test() {
    command -v mktemp >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mktemp)"; exit 1; }
    command -v chmod >/dev/null 2>&1 || { echo "smoke-test: FAIL (no chmod)"; exit 1; }
    command -v grep >/dev/null 2>&1 || { echo "smoke-test: FAIL (no grep)"; exit 1; }
    tmpd="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp failed)"; exit 1; }
    trap 'rm -rf "$tmpd"' EXIT
    fail=0

    # A REAL nodes file — the gate's whole point. The retired gate hand-injected
    # PEER_MAP=$'peer\t100.64.1.2\t192.168.8.20\n', a row with lan!=ts that the live parser could
    # never produce, so it asserted the fallback against a path that did not exist. Everything below
    # runs `env -u PEER_MAP`: the parser must EARN the third column from this file.
    # MESH_NODES bare + MESH_LAN_FALLBACK exported mirrors the operator's real file (nodes:6 vs :34)
    # and pins the "export " strip — without it the fallback arm never matches.
    mkdir -p "$tmpd/home/.mesh"
    cat >"$tmpd/home/.mesh/nodes" <<'EOF'
MESH_NODES="peer:root@100.64.1.2 lonely:root@100.64.1.9 Redmi:u0_a380@100.64.1.3"
export MESH_LAN_FALLBACK="peer:192.168.8.20"  # comment tail must not be parsed as an entry
export PHONE_LAN_IPS="192.168.8.146"
EOF
    _run() {  # _run <reachable-ip...> -- <args...>  → drive the real parser with a stubbed ping
        local ips=() a
        while [ "${1:-}" != "--" ]; do ips+=("$1"); shift; done
        shift
        { printf '#!/usr/bin/env bash\n'
          for a in "${ips[@]}"; do printf 'for x in "$@"; do [ "$x" = "%s" ] && exit 0; done\n' "$a"; done
          printf 'exit 1\n'; } >"$tmpd/ping"
        chmod +x "$tmpd/ping"
        env -u PEER_MAP HOME="$tmpd/home" PATH="$tmpd:$PATH" "$0" "$@" 2>&1
    }

    # 1. THE IDENTITY-FUNCTION ASSERTION: the parser must emit lan != ts. This is the bug itself —
    #    for 26d every row read "ts=X lan=X", so "fall back to LAN" returned the corpse.
    out="$(_run -- __nosuch__ || true)"
    printf '%s\n' "$out" | grep -q 'peer: ts=100.64.1.2 lan=192.168.8.20' \
      || { echo "  FAIL: LAN column is not parsed from MESH_LAN_FALLBACK (identity map?): $(printf '%s' "$out" | grep -m1 'peer:')"; fail=1; }

    # 2. tailscale up → tailscale IP wins (unchanged contract)
    out="$(_run 100.64.1.2 -- peer)"
    [ "$out" = "100.64.1.2" ] || { echo "  FAIL: preferred-IP output wrong: $out"; fail=1; }

    # 3. THE LIVE FAILURE, off the real parser: tailscale silent, LAN answers → LAN IP.
    #    This is the router case measured 2026-07-15 (ping 100.105.241.84 rc=1, ping 192.168.8.1 rc=0).
    out="$(_run 192.168.8.20 -- peer)"
    [ "$out" = "192.168.8.20" ] || { echo "  FAIL: LAN fallback not returned when tailscale is down: $out"; fail=1; }

    # 4. A LAN addr is only returned if it ANSWERS — an unpinged fallback just moves the corpse.
    out="$(_run 10.255.255.1 -- peer)"
    [ "$(printf '%s\n' "$out" | tail -1)" = "100.64.1.2" ] || { echo "  FAIL: expected ts guess when nothing answers: $out"; fail=1; }
    printf '%s\n' "$out" | grep -q 'both silent' \
      || { echo "  FAIL: exhausted fallback must be LOUD on stderr, not a silent guess"; fail=1; }

    # 5. No fallback entry → ts guess + a stderr note naming the gap (contract: never an empty stdout)
    out="$(_run 10.255.255.1 -- lonely)"
    [ "$(printf '%s\n' "$out" | tail -1)" = "100.64.1.9" ] || { echo "  FAIL: peer without fallback must still yield an addr: $out"; fail=1; }
    printf '%s\n' "$out" | grep -q 'no MESH_LAN_FALLBACK entry' \
      || { echo "  FAIL: missing-fallback case must say so: $out"; fail=1; }

    # 6. PHONE_LAN_IPS is part of the same contract (mesh-fleet-health:21) — the phone body resolves
    #    off it with no MESH_LAN_FALLBACK row of its own.
    out="$(_run 192.168.8.146 -- Redmi)"
    [ "$out" = "192.168.8.146" ] || { echo "  FAIL: PHONE_LAN_IPS not honored for the phone body: $out"; fail=1; }

    # 7. --candidates is the MAP, and its whole reason for existing is that it must NOT collapse
    #    onto the resolver's guess. Driven with NOTHING reachable: the resolver returns the ts addr
    #    alone (the corpse), while --candidates must still yield BOTH addresses. If it ever prints
    #    one line here it has become the resolver and mesh-sense-map is back to classifying a
    #    corpse — the live GL-MT3000 row that read `unreach` at 0.7ms.
    out="$(_run 10.255.255.1 -- --candidates peer)"
    [ "$(printf '%s\n' "$out" | wc -l)" = 2 ] \
      || { echo "  FAIL: --candidates must yield the SET even when nothing answers, got: $(printf '%s' "$out" | tr '\n' ' ')"; fail=1; }
    [ "$(printf '%s\n' "$out" | head -1)" = "100.64.1.2" ] \
      || { echo "  FAIL: --candidates must put the tailscale addr first: $out"; fail=1; }
    [ "$(printf '%s\n' "$out" | tail -1)" = "192.168.8.20" ] \
      || { echo "  FAIL: --candidates dropped the LAN addr — the identity-map bug, one mode over: $out"; fail=1; }
    #    It must also never PING: a map read that silently costs a probe per peer would put
    #    mesh-sense-map's per-run leg budget at the mercy of a tool it only asked for a list.
    { printf '#!/usr/bin/env bash\ntouch "%s/ping-was-called"\nexit 0\n' "$tmpd"; } >"$tmpd/ping"
    chmod +x "$tmpd/ping"
    rm -f "$tmpd/ping-was-called"
    env -u PEER_MAP HOME="$tmpd/home" PATH="$tmpd:$PATH" "$0" --candidates peer >/dev/null 2>&1 || true
    [ -e "$tmpd/ping-was-called" ] \
      && { echo "  FAIL: --candidates pinged — it is a map read, not a resolution"; fail=1; }
    #    An unknown peer must FAIL, never print an empty set a caller would read as "no addresses".
    env -u PEER_MAP HOME="$tmpd/home" PATH="$tmpd:$PATH" "$0" --candidates __nosuch__ >/dev/null 2>&1 \
      && { echo "  FAIL: --candidates on an unknown peer exited 0"; fail=1; }

    [ "$fail" = 0 ] && { echo "smoke-test: ok"; exit 0; } || { echo "smoke-test: FAIL"; exit 1; }
}

# --- peer map ----------------------------------------------------------
PEER_MAP="${PEER_MAP:-}"
if [[ -z "$PEER_MAP" ]]; then
    # Source from ~/.mesh/nodes (plantability: no hardcoded IPs).
    # Format: MESH_NODES="name:user@ts-ip ..." — we extract name → ts-ip pairs.
    # A fresh plant without ~/.mesh/nodes has an empty map;
    # operator adds entries per local topology.
    NODES_FILE="$HOME/.mesh/nodes"
    if [ -f "$NODES_FILE" ]; then
        _nodes=""; _lan_map=""; _phone_ips=""
        while IFS='=' read -r k v; do
            # keys arrive both bare (MESH_NODES="...") and exported (export MESH_LAN_FALLBACK="...",
            # ~/.mesh/nodes:34). IFS='=' puts the whole "export NAME" in $k — strip it or the arm
            # below silently never matches, which is how the fallback stayed unread while looking wired.
            k="${k#export }"; k="${k%"${k##*[![:space:]]}"}"; k="${k#"${k%%[![:space:]]*}"}"
            # Take the QUOTED value, then stop — nodes:34 carries a trailing `# comment` after the
            # closing quote, and `${v%\"}` cannot strip a quote that is not the last character, so
            # the comment (and the quote) would ride into the map as bogus entries.
            if [ "${v#\"}" != "$v" ]; then v="${v#\"}"; v="${v%%\"*}"; else v="${v%%#*}"; fi
            case "$k" in
                MESH_NODES|MESH_NODES_INNER) _nodes+=" $v" ;;
                MESH_LAN_FALLBACK)           _lan_map+=" $v" ;;
                PHONE_LAN_IPS)               _phone_ips+=" $v" ;;
            esac
        done < "$NODES_FILE"

        # LAN candidates for a peer label: MESH_LAN_FALLBACK entries, plus PHONE_LAN_IPS for the
        # phone body (same case as mesh-fleet-health:21).
        _lan_for() {
            local name="$1" entry out=""
            for entry in $_lan_map; do
                [ "${entry%%:*}" = "$name" ] && out+="${entry#*:} "
            done
            case "$name" in Redmi|phone) out+="$_phone_ips " ;; esac
            printf '%s' "${out% }"
        }

        for entry in $_nodes; do
            name="${entry%%:*}"
            rest="${entry#*:}"
            # rest may be "local" (no IP) or "user@ip" — extract IP
            ts_ip="${rest##*@}"
            [ "$ts_ip" = "$rest" ] && ts_ip=""   # "local" — no IP
            [ -n "$ts_ip" ] || continue
            lan_ips="$(_lan_for "$name")"
            # No node-local LAN entry → the LAN column is EMPTY, never a copy of the tailscale IP.
            # A duplicated column is what made the fallback an identity function.
            PEER_MAP+="${name}"$'\t'"${ts_ip}"$'\t'"${lan_ips}"$'\n'
        done
    fi
fi

# --- smoke test ---------------------------------------------------------
if [ "${1:-}" = "--test" ]; then
    smoke_test
fi

# --- lookup peer --------------------------------------------------------
MODE="resolve"
if [ "${1:-}" = "--candidates" ]; then MODE="candidates"; shift; fi

if [[ $# -lt 1 ]]; then
    echo "usage: mesh-peer-addr [--candidates] <peer-name>" >&2
    exit 1
fi

PEER_NAME="$1"
TS_IP=""
LAN_IP=""
while read -r host ts_ip lan_ip; do
    if [[ "$host" == "$PEER_NAME" ]]; then
        TS_IP="$ts_ip"
        LAN_IP="$lan_ip"
        break
    fi
done <<<"$PEER_MAP"

if [[ -z "$TS_IP" ]]; then
    echo "mesh-peer-addr: unknown peer '$PEER_NAME'" >&2
    echo "  known peers:" >&2
    while read -r host ts_ip lan_ip; do
        echo "    $host: ts=$ts_ip lan=$lan_ip" >&2
    done <<<"$PEER_MAP"
    exit 1
fi

# --- --candidates: the MAP, not a verdict --------------------------------
# A caller that wants to classify a peer ITSELF (mesh-sense-map's third bit: refused vs mute vs
# unreachable) cannot use the resolver's answer — the resolver collapses "no address answered"
# onto the tailscale address as a GUESS, which is exactly the corpse the caller must not classify
# over. So expose the candidate SET, pinged by nobody, and let the caller do its own measuring.
# One map, one parser: this shares the whole body above rather than re-reading ~/.mesh/nodes.
if [ "$MODE" = "candidates" ]; then
    printf '%s\n' "$TS_IP"
    for _ip in $LAN_IP; do printf '%s\n' "$_ip"; done
    exit 0
fi

# --- try Tailscale IP ----------------------------------------------------
if ping -c 1 -W 1 "$TS_IP" >/dev/null 2>&1; then
    echo "$TS_IP"
    exit 0
fi

# --- fall back to a LAN IP that ANSWERS ---------------------------------
# Returning an unpinged LAN address would just move the corpse one column over.
for _ip in $LAN_IP; do
    if ping -c 1 -W 2 "$_ip" >/dev/null 2>&1; then
        echo "$_ip"
        exit 0
    fi
done

# --- last resort: the tailscale IP we already know does not answer -------
# Contract preserved (33 callers expect an address on stdout, many discard the rc), but this is a
# guess, not a resolution — say so on stderr, where it cannot corrupt a $(...) capture. Silent here
# is exactly the bug this tool shipped for 26 days.
if [ -n "$LAN_IP" ]; then
    echo "mesh-peer-addr: $PEER_NAME unreachable — ts $TS_IP and LAN [$LAN_IP] both silent; returning ts addr as a guess" >&2
else
    echo "mesh-peer-addr: $PEER_NAME unreachable — ts $TS_IP silent and no MESH_LAN_FALLBACK entry; returning ts addr as a guess" >&2
fi
echo "$TS_IP"
