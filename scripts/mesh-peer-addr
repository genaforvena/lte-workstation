#!/usr/bin/env bash
# mesh-peer-addr — find the best reachable address for a mesh peer.
#
# Tries Tailscale IP first (ping -c1 -W1), falls back to LAN IP if Tailscale is down.
# Reads peer map from ~/.mesh/nodes (or hardcoded fallback).
#
# Usage:
#   mesh-peer-addr <peer-name>   return the best reachable address
#
# The peer map format (in ~/.mesh/nodes or hardcoded):
#   <peer-hostname>\t<tailscale-ip>\t<lan-ip>
#
# Example:
#   mesh-peer-addr ilya    → "<tailscale-ip>" (if Tailscale up)
#   mesh-peer-addr ilya    → "<lan-ip>" (if Tailscale down)

set -euo pipefail

smoke_test() {
    command -v mktemp >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mktemp)"; exit 1; }
    command -v chmod >/dev/null 2>&1 || { echo "smoke-test: FAIL (no chmod)"; exit 1; }
    command -v grep >/dev/null 2>&1 || { echo "smoke-test: FAIL (no grep)"; exit 1; }
    tmpd="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp failed)"; exit 1; }
    trap 'rm -rf "$tmpd"' EXIT

    cat >"$tmpd/ping" <<'EOF'
#!/usr/bin/env bash
for arg in "$@"; do
  [ "$arg" = "100.64.1.2" ] && exit 0
done
exit 1
EOF
    chmod +x "$tmpd/ping"

    out="$(PATH="$tmpd:$PATH" PEER_MAP=$'peer\t100.64.1.2\t192.168.8.20\n' "$0" peer 2>&1)" \
      || { echo "smoke-test: FAIL (preferred-IP resolution failed: $out)"; exit 1; }
    [ "$out" = "100.64.1.2" ] || { echo "smoke-test: FAIL (preferred-IP output wrong: $out)"; exit 1; }

    cat >"$tmpd/ping" <<'EOF'
#!/usr/bin/env bash
exit 1
EOF
    chmod +x "$tmpd/ping"

    out="$(PATH="$tmpd:$PATH" PEER_MAP=$'peer\t100.64.1.2\t192.168.8.20\n' "$0" peer 2>&1)" \
      || { echo "smoke-test: FAIL (fallback-IP resolution failed: $out)"; exit 1; }
    [ "$out" = "192.168.8.20" ] || { echo "smoke-test: FAIL (fallback-IP output wrong: $out)"; exit 1; }

    echo "smoke-test: ok"; exit 0
}

# --- peer map ----------------------------------------------------------
PEER_MAP="${PEER_MAP:-}"
if [[ -z "$PEER_MAP" ]]; then
    # Source from ~/.mesh/nodes (plantability: no hardcoded IPs).
    # Format: MESH_NODES="name:user@ts-ip ..." — we extract name → ts-ip pairs.
    # A fresh plant without ~/.mesh/nodes has an empty map;
    # operator adds entries per local topology.
    NODES_FILE="$HOME/.mesh/nodes"
    if [ -f "$NODES_FILE" ]; then
        while IFS='=' read -r k v; do
            case "$k" in
                MESH_NODES|MESH_NODES_INNER)
                    v="${v#\"}"; v="${v%\"}"
                    for entry in $v; do
                        name="${entry%%:*}"
                        rest="${entry#*:}"
                        # rest may be "local" (no IP) or "user@ip" — extract IP
                        ts_ip="${rest##*@}"
                        [ "$ts_ip" = "$rest" ] && ts_ip=""   # "local" — no IP
                        [ -n "$ts_ip" ] && PEER_MAP+="${name}"$'\t'"${ts_ip}"$'\t'"${ts_ip}"$'\n'
                    done ;;
            esac
        done < "$NODES_FILE"
    fi
fi

# --- smoke test ---------------------------------------------------------
if [ "${1:-}" = "--test" ]; then
    smoke_test
fi

# --- lookup peer --------------------------------------------------------
if [[ $# -lt 1 ]]; then
    echo "usage: mesh-peer-addr <peer-name>" >&2
    exit 1
fi

PEER_NAME="$1"
TS_IP=""
LAN_IP=""
while read -r host ts_ip lan_ip; do
    if [[ "$host" == "$PEER_NAME" ]]; then
        TS_IP="$ts_ip"
        LAN_IP="$lan_ip"
        break
    fi
done <<<"$PEER_MAP"

if [[ -z "$TS_IP" ]]; then
    echo "mesh-peer-addr: unknown peer '$PEER_NAME'" >&2
    echo "  known peers:" >&2
    while read -r host ts_ip lan_ip; do
        echo "    $host: ts=$ts_ip lan=$lan_ip" >&2
    done <<<"$PEER_MAP"
    exit 1
fi

# --- try Tailscale IP ----------------------------------------------------
if ping -c 1 -W 1 "$TS_IP" >/dev/null 2>&1; then
    echo "$TS_IP"
    exit 0
fi

# --- fall back to LAN IP -----------------------------------------------
echo "$LAN_IP"
