#!/usr/bin/env bash
# mesh-supervise — the SUPERVISOR (OTP-style "ensure children alive, restart the dead"). Portable:
# cron-driven, no systemd dependency, so it works on phones/termux too. Closes the self-healing gap —
# bare background loops (mesh-chat/snapshot/trace/provenance/selfcare/session-watchdog) have NO
# supervisor and die permanently on crash/OOM until the next reboot; this restarts them within a tick.
# Complements mesh-restore (which starts them @reboot) by covering mid-life death.
# Registry (trusted local config, like crontab): ~/.mesh/supervise.list  -> name | pgrep-pattern | start-cmd
# See docs/eternity-and-its-fields.md (supervision tree).
#
#   mesh-supervise           check all; restart any dead child
#   mesh-supervise --status  show each child's state
set -uo pipefail
[ "${1:-}" = --test ] && {
  command -v pgrep  >/dev/null 2>&1 || { echo "smoke-test: FAIL (no pgrep)"; exit 1; }
  command -v flock  >/dev/null 2>&1 || { echo "smoke-test: FAIL (no flock)"; exit 1; }
  command -v mktemp >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mktemp)"; exit 1; }
  command -v grep   >/dev/null 2>&1 || { echo "smoke-test: FAIL (no grep)"; exit 1; }
  command -v rm     >/dev/null 2>&1 || { echo "smoke-test: FAIL (no rm)"; exit 1; }
  tmp="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp failed)"; exit 1; }
  trap 'rm -rf "$tmp"' EXIT
  mkdir -p "$tmp/.mesh" || { echo "smoke-test: FAIL (no tmp mesh dir)"; exit 1; }
  # ABSENT REGISTRY = LOUD FAIL. This is the bug state that ran silently for a month; asserting it here
  # is the gate. Watched red against the old `exit 0` guard, green after. Temp HOME throughout — a test
  # that wrote the real supervise.log would forge the liveness evidence it exists to check (09f7914).
  out="$(HOME="$tmp" timeout 10 "$0" 2>&1)"; rc=$?
  [ "$rc" = 1 ] || { echo "smoke-test: FAIL (absent registry must exit 1, got rc=$rc — a silent exit 0 is how the supervisor supervised nothing for a month)"; exit 1; }
  printf '%s\n' "$out" | grep -q 'supervising NOTHING' || { echo "smoke-test: FAIL (absent registry did not say so on stderr: $out)"; exit 1; }
  grep -q 'FAIL no registry' "$tmp/.mesh/supervise.log" 2>/dev/null || { echo "smoke-test: FAIL (absent registry left no line in supervise.log — the artifact a human reads stayed empty, which is the original bug)"; exit 1; }
  rm -f "$tmp/.mesh/supervise.log"
  # An EMPTY registry is honest, not a fault: zero declared children, rc 0.
  : > "$tmp/.mesh/supervise.list"
  HOME="$tmp" timeout 10 "$0" >/dev/null 2>&1 || { echo "smoke-test: FAIL (an EMPTY registry is an honest zero-children state, must exit 0)"; exit 1; }
  cat > "$tmp/.mesh/supervise.list" <<'EOF'
demo|definitely-no-such-process-pattern-12345|echo should-not-run
EOF
  out="$(HOME="$tmp" timeout 10 "$0" --status 2>&1)" || {
    echo "smoke-test: FAIL (status dry-run failed: $out)"; exit 1;
  }
  printf '%s\n' "$out" | grep -q '^  DOWN demo' || {
    echo "smoke-test: FAIL (status output missing DOWN demo: $out)"; exit 1;
  }
  # cause-of-death (chat-review/wire-kill-events): a RESTART must cite a matching, recent
  # mesh-kill-events tape entry in the log line; a genuinely dead child with no matching tape entry
  # gets a plain RESTART line (no fabricated cause).
  cat > "$tmp/.mesh/kill-events.log" <<EOF
$(date -u +%FT%TZ) kill-event victim=mesh-kill-events-test-victim pid=4242 kind=oom rss=123 vm=456
EOF
  cat > "$tmp/.mesh/supervise.list" <<'EOF'
demo|definitely-no-such-process-pattern-12345|echo should-not-run
codvictim|mesh-kill-events-test-victim|echo should-not-run-2
EOF
  # MESH_SUP_NOTIFY=0 keeps the existing assertions free of the OTP-style broadcast added
  # 2026-07-19 (otherwise the live-path restart would call the real mesh-chat on PATH and
  # pollute the board with test runs).
  HOME="$tmp" MESH_SUP_NOTIFY=0 timeout 10 "$0" >/dev/null 2>&1
  grep -qE 'RESTART codvictim \(was dead\) \(cause: kind=oom pid=4242, [0-9]+s ago\) -> echo' "$tmp/.mesh/supervise.log" || {
    echo "smoke-test: FAIL (matching kill-events tape entry not cited in RESTART log line)"; exit 1;
  }
  grep -qE 'RESTART demo \(was dead\) -> echo' "$tmp/.mesh/supervise.log" || {
    echo "smoke-test: FAIL (a dead child with no matching tape entry must get a plain RESTART line)"; exit 1;
  }
  grep -qE 'RESTART demo \(was dead\) \(cause:' "$tmp/.mesh/supervise.log" && {
    echo "smoke-test: FAIL (demo has no matching victim — must not fabricate a cause)"; exit 1;
  }
  # OTP-style link-broadcast (STUDY 2026-07-19): on a DOWN->RESTART transition, announce_down
  # posts to the local mesh-chat board AND fans out to peer mind-nodes via mesh-tell --node.
  # Idempotent per down-period (flag file, cleared on UP return). Mutation-falsifiable: drop
  # the `touch "$af"` and the idempotency assertion fails; drop the mesh-chat call and the
  # local-marker assertion fails; drop the mesh-tell loop and the peer-marker assertion fails.
  stubbin="$(mktemp -d)"
  cat > "$stubbin/mesh-chat" <<'STUB'
#!/usr/bin/env bash
echo "$@" >> "$MESH_CHAT_MARKER"
STUB
  chmod +x "$stubbin/mesh-chat"
  cat > "$stubbin/mesh-tell" <<'STUB'
#!/usr/bin/env bash
[ "$1" = "--node" ] && echo "$2:$4" >> "$MESH_TELL_MARKER"
STUB
  chmod +x "$stubbin/mesh-tell"
  rm -f "$tmp/.mesh/supervise.log" "$tmp/.mesh/.sup-announced-demo"
  cat > "$tmp/.mesh/supervise.list" <<'EOF'
demo|definitely-no-such-process-pattern-12345|echo should-not-run
EOF
  MESH_CHAT_MARKER="$tmp/chat.marker" MESH_TELL_MARKER="$tmp/tell.marker" \
    MESH_SUP_PEERS="peer-a:role peer-b:role $(hostname):role" \
    HOME="$tmp" PATH="$stubbin:$PATH" timeout 10 "$0" >/dev/null 2>&1
  grep -q "^\[restart\] $(hostname): supervised 'demo' died" "$tmp/chat.marker" || {
    echo "smoke-test: FAIL (local mesh-chat broadcast did not fire on restart)"; rm -rf "$stubbin"; exit 1; }
  grep -q 'peer-a' "$tmp/tell.marker" || {
    echo "smoke-test: FAIL (peer-a not notified via mesh-tell --node)"; rm -rf "$stubbin"; exit 1; }
  grep -q 'peer-b' "$tmp/tell.marker" || {
    echo "smoke-test: FAIL (peer-b not notified via mesh-tell --node)"; rm -rf "$stubbin"; exit 1; }
  grep -q "^$(hostname):" "$tmp/tell.marker" && {
    echo "smoke-test: FAIL (self-leak: announce notified this node as a peer)"; rm -rf "$stubbin"; exit 1; }
  [ -f "$tmp/.mesh/.sup-announced-demo" ] || {
    echo "smoke-test: FAIL (idempotency flag .sup-announced-demo not set after announce)"; rm -rf "$stubbin"; exit 1; }
  # Second run while still DOWN: announce must NOT fire again (one signal per death).
  rm -f "$tmp/chat.marker" "$tmp/tell.marker"
  MESH_CHAT_MARKER="$tmp/chat.marker" MESH_TELL_MARKER="$tmp/tell.marker" \
    MESH_SUP_PEERS="peer-a:role" \
    HOME="$tmp" PATH="$stubbin:$PATH" timeout 10 "$0" >/dev/null 2>&1
  [ -f "$tmp/chat.marker" ] && {
    echo "smoke-test: FAIL (announce fired again while still DOWN - idempotency flag broken)"; rm -rf "$stubbin"; exit 1; }
  # clear_announce on UP return: a live child must clear the flag so the next death re-announces.
  rm -f "$tmp/.mesh/supervise.log"
  cat > "$tmp/.mesh/supervise.list" <<EOF
demo|sleep-for-supervise-test-$$|sleep 30
EOF
  setsid bash -c "exec -a sleep-for-supervise-test-$$ sleep 30" >/dev/null 2>&1 &
  sleep 0.3
  HOME="$tmp" PATH="$stubbin:$PATH" timeout 10 "$0" >/dev/null 2>&1
  [ -f "$tmp/.mesh/.sup-announced-demo" ] && {
    echo "smoke-test: FAIL (clear_announce did not remove the flag when child returned UP)"; rm -rf "$stubbin"; kill %1 2>/dev/null; exit 1; }
  kill %1 2>/dev/null; wait 2>/dev/null
  rm -rf "$stubbin"
  # LIVENESS-TOUCH (2026-07-19): a healthy pass must touch the heartbeat so reflex-health / a
  # reflex-vanished census can see the supervisor RAN, not just "no RESTART in supervise.log".
  # The run above had a live child → clean pass → HB must exist + be fresh.
  [ -f "$tmp/.mesh/.supervise.heartbeat" ] || {
    echo "smoke-test: FAIL (healthy pass left no .supervise.heartbeat — SCHEDULED ≠ RAN, the original census-blind-spot bug)"; exit 1; }
  # Negative discriminator: an ABSENT REGISTRY is a FAIL (exit 1, broken state) and must NOT touch
  # the heartbeat — broken-state-must-not-look-alive is the same rule as f215c9e's absent-registry
  # FAIL line. If this goes RED the touch is on the wrong path (before the registry guard).
  rm -rf "${tmp2:-}" 2>/dev/null; tmp2="$(mktemp -d)"; mkdir -p "$tmp2/.mesh"
  precount=$(find "$tmp2/.mesh" -name '.supervise.heartbeat' 2>/dev/null | wc -l)
  HOME="$tmp2" timeout 10 "$0" >/dev/null 2>&1
  postcount=$(find "$tmp2/.mesh" -name '.supervise.heartbeat' 2>/dev/null | wc -l)
  [ "$precount" = "$postcount" ] || {
    echo "smoke-test: FAIL (absent-registry FAIL path touched the heartbeat — broken state must not look alive)"; exit 1; }
  rm -rf "$tmp2"
  echo "smoke-test: ok"; exit 0
}
export PATH="$HOME/.local/bin:$PATH"
MESH="$HOME/.mesh"; REG="$MESH/supervise.list"; LOG="$MESH/supervise.log"; LOCK="$MESH/.supervise.lock"; HB="$MESH/.supervise.heartbeat"
mkdir -p "$MESH"
# LIVENESS-TOUCH (chat-review/conditional-write-liveness-touch 2026-06-25, doctrine 2026-07-15):
# this supervisor wrote NOTHING on a healthy pass — only SKIP/FAIL/RESTART lines hit supervise.log,
# so a long-stable node (all children UP, no restarts) left ZERO artifact. reflex-health/pulse age by
# mtime, and a reflex-vanished census (pub 2026-07-19 03:23) read that as "gone from schedule" → false
# unwiring claim that nearly invalidated the OTP-broadcast [done] at 03:04. SCHEDULED ≠ RAN. So every
# real pass touches HB on the way out — decoupling ran-live (mtime) from value-changed (LOG content).
# Deliberately NOT touched on: --status (dry-run), flock-SKIP (another supervisor ran, not this one),
# absent-registry FAIL (broken state must not look alive — the original silent-no-op bug, f215c9e).
# A MISSING REGISTRY IS A FAULT, NOT A REST STATE — this guard was `exit 0` and silent, and that is the
# whole reason the supervisor supervised nothing from 2026-06-13 to 2026-07-15 with every surface green.
# mesh-liveness-loop schedules this tool every 120s and logs ONLY rc!=0, so exit 0 meant ~450 no-op runs
# a day left zero trace anywhere: no supervise.log to age, nothing for reflex-health/doctor to read. Being
# SCHEDULED is this tool's claim to run; if it is called and has no children it is broken, and it must say
# so on the artifact a human reads (severity binds to the claim, not to a node name — f215c9e). An EMPTY
# registry is a different, honest state: the operator declared zero children, so the loop below is a no-op
# and rc stays 0. Only ABSENT is the fault.
[ -f "$REG" ] || {
  echo "$(date -u +%FT%TZ) FAIL no registry ($REG) — supervising NOTHING; mesh-restore should have registered its infra loops" >> "$LOG"
  echo "no registry ($REG) — supervising NOTHING (run mesh-restore to register the infra loops)" >&2
  exit 1
}
# A restore and cron tick may overlap. Serialize checks so they cannot launch
# duplicate children. Restarted children must close FD 9 or they inherit and
# hold this lock for their entire lifetime.
exec 9>"$LOCK"
flock -n 9 || { echo "$(date -u +%FT%TZ) SKIP: another supervisor is already running" >> "$LOG"; exit 0; }
stamp(){ date -u +%FT%TZ; }
STATUS=0; [ "${1:-}" = --status ] && STATUS=1
uid=$(id -u)

# OTP-style restart intensity: if a child restarts more than RMAX times in RWIN seconds, it's a
# PERSISTENT fault (not a transient crash) — stop restarting it and escalate to a mind, instead of
# fail-looping forever and masking the real problem. (Erlang/OTP supervisor semantics.)
RMAX="${MESH_SUP_MAXR:-5}"; RWIN="${MESH_SUP_WINSEC:-600}"
ok_to_restart(){  # $1=name → 0 = restart allowed; 1 = storming (skip + alert once)
  local name="$1" f="$MESH/.sup-restarts-$name" now cnt; now=$(date +%s)
  { [ -f "$f" ] && awk -v n="$now" -v w="$RWIN" '($1+w)>n' "$f"; echo "$now"; } > "$f.tmp" 2>/dev/null && mv "$f.tmp" "$f"
  cnt=$(wc -l < "$f" 2>/dev/null || echo 1)
  if [ "$cnt" -gt "$RMAX" ]; then
    local sf="$MESH/.sup-storm-$name"
    if [ ! -f "$sf" ]; then
      echo "$(stamp) STORM $name: $cnt restarts in ${RWIN}s — STOP restarting (persistent fault, escalating)" >> "$LOG"
      command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="supervise@$(hostname)" \
        mesh-chat "[storm] $(hostname): $name restart-storm ($cnt× in ${RWIN}s) — supervisor STOPPED auto-restart (persistent fault, needs a mind). OTP restart-intensity." >/dev/null 2>&1
      touch "$sf"
    fi
    return 1
  fi
  rm -f "$MESH/.sup-storm-$name" 2>/dev/null   # healthy → clear any storm flag
  return 0
}

# cause-of-death lookup (chat-review/wire-kill-events, consumer of mesh-kill-events' tape): a dead
# child restarted here otherwise gets no explanation in the log — was it OOM-killed, did it segfault,
# or just exit cleanly? ~/.mesh/kill-events.log names the kernel-killed victim/pid/kind; match its
# recorded victim comm against this child's pgrep pattern or registry name (best-effort substring —
# false negative if neither string contains the comm is fine, this is forensic enrichment not a gate).
KILL_TAPE="${MESH_KILL_EVENTS_TAPE:-$MESH/kill-events.log}"
cause_of_death(){ # $1=pgrep-pattern $2=name -> " (cause: kind=oom pid=1234, 42s ago)" or "" if none found
  local pat="$1" name="$2" window="${MESH_SUP_CAUSE_WINDOW:-1800}" now line victim vts vepoch age kind pid
  [ -r "$KILL_TAPE" ] || return 0
  now=$(date +%s)
  while IFS= read -r line; do
    victim="$(printf '%s' "$line" | grep -oE 'victim=[^ ]+' | cut -d= -f2)"
    [ -n "$victim" ] || continue
    case "$pat" in *"$victim"*) ;; *) case "$name" in *"$victim"*) ;; *) continue ;; esac ;; esac
    vts="$(printf '%s' "$line" | awk '{print $1}')"
    vepoch="$(date -d "$vts" +%s 2>/dev/null)" || continue
    age=$(( now - vepoch ))
    [ "$age" -ge 0 ] && [ "$age" -le "$window" ] || continue
    kind="$(printf '%s' "$line" | grep -oE 'kind=[a-z]+' | cut -d= -f2)"
    pid="$(printf '%s' "$line" | grep -oE 'pid=[0-9]+' | cut -d= -f2)"
    printf ' (cause: kind=%s pid=%s, %ss ago)' "$kind" "$pid" "$age"
    return 0
  done < <(tail -n 200 "$KILL_TAPE" 2>/dev/null | tac)
}

# OTP-style exit-signal BROADCAST (STUDY Erlang/OTP supervision, idea-queue 2026-07-19):
# In Erlang, `link/1` + `process_flag(trap_exit, true)` means a supervisor traps a child's exit
# signal and DELIVERS it to every linked process — siblings learn "X died", and in distributed
# Erlang the same signal crosses node boundaries via `monitor_node/2`. Our supervisor had only
# the local half of this: detect dead child → restart → write to supervise.log. NO sibling knew,
# no peer node knew — the operator and other minds found out by accident (pane stale, board
# quiet). Each supervisor was an isolated tree. This function is the missing broadcast.
#
# Implementation: on a DOWN→RESTART transition we (a) post a [restart] line to the local
# mesh-chat board — the bus the other minds on THIS node already read (the local-link analog),
# and (b) fan the same message out to each declared peer mind-node via `mesh-tell --node chat`
# — the cross-node analog. Once per down-transition: a `.sup-announced-$name` flag is touched
# on first announce and only cleared by `clear_announce` when the child returns UP, so a child
# that stays down across N cron polls announces ONCE (the OTP rule is "each exit signal is
# delivered", not "delivered per poll" — a long death is still one death).
#
# Skipped when MESH_SUP_NOTIFY=0 (test isolation). Skipped in --status (dry-run). Skipped on
# the [storm] path (ok_to_restart already broadcasts there). Cross-node fan-out is best-effort:
# any peer error is swallowed — an unreachable peer must never delay the local restart.
MESH_SUP_NOTIFY="${MESH_SUP_NOTIFY:-1}"
announce_down(){  # $1=name $2=cod  (cod includes leading " (cause: ...)" or "")
  [ "$MESH_SUP_NOTIFY" = 1 ] || return 0
  local name="$1" cod="$2" af="$MESH/.sup-announced-$name" msg
  [ -f "$af" ] && return 0   # already announced this down-period — OTP: one exit signal per death
  msg="[restart] $(hostname): supervised '$name' died${cod} — supervisor restarting. OTP link-broadcast."
  command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="supervise@$(hostname)" mesh-chat "$msg" >/dev/null 2>&1 || true
  touch "$af"
  # Peer fan-out — distributed-Erlang analog (monitor_node): the same exit signal crosses to
  # peer mind-nodes so a peer's room/tg/health learns its sibling on this node just died.
  # MESH_SUP_PEERS overrides the peer list (test fixture); default pulls MESH_NODES from
  # ~/.mesh/nodes. Bare peer names — mesh-tell resolves via mesh-peer-addr.
  command -v mesh-tell >/dev/null 2>&1 || return 0
  local self line peers p
  self="$(hostname)"
  peers="${MESH_SUP_PEERS:-}"
  if [ -z "$peers" ] && [ -r "${MESH_SUP_NODES_FILE:-$HOME/.mesh/nodes}" ]; then
    peers="$(grep -oE 'MESH_NODES="[^"]*"' "${MESH_SUP_NODES_FILE:-$HOME/.mesh/nodes}" | head -1 | sed -E 's/^MESH_NODES="//; s/"$//')"
  fi
  for p in $peers; do
    p="${p%%:*}"
    [ -n "$p" ] && [ "$p" != "$self" ] || continue
    timeout 15 mesh-tell --node "$p" chat "$msg" >/dev/null 2>&1 || true
  done
}
clear_announce(){  # $1=name — child back UP: clear the flag so the next death re-announces
  rm -f "$MESH/.sup-announced-$1" 2>/dev/null || true
}

while IFS='|' read -r name pat start; do
  name="${name#"${name%%[![:space:]]*}"}"; name="${name%"${name##*[![:space:]]}"}"   # trim
  case "$name" in ''|\#*) continue;; esac
  pat="$(printf '%s' "$pat" | xargs)"; start="$(printf '%s' "$start" | xargs)"
  if pgrep -u "$uid" -f -- "$pat" >/dev/null 2>&1; then
    # WEDGED check: process is up, but if it publishes a liveness beat and the beat is stale
    # (>1800s, longer than any loop interval), the loop is hung — restart it (intel audit 2026-06-10)
    beat="$MESH/$name.beat"
    if [ -f "$beat" ] && [ $(( $(date +%s) - $(stat -c %Y "$beat") )) -gt 1800 ]; then
      if [ "$STATUS" = 1 ]; then echo "  WEDGED $name  (beat stale, would restart: $start)"
      elif ok_to_restart "$name"; then
        echo "$(stamp) WEDGED $name (beat stale) -> kill+restart $start" >> "$LOG"
        pkill -u "$uid" -f -- "$pat" 2>/dev/null
        setsid bash -lc "$start" 9>&- >/dev/null 2>&1 &
        announce_down "$name" " (wedged: beat stale)"
      fi
    else
      [ "$STATUS" = 1 ] && echo "  UP   $name"
      clear_announce "$name"   # child back UP — re-arm announce for the next death
    fi
  elif [ "$STATUS" = 1 ]; then echo "  DOWN $name  (would restart: $start)"
  elif ok_to_restart "$name"; then
    cod="$(cause_of_death "$pat" "$name" 2>/dev/null)"
    echo "$(stamp) RESTART $name (was dead)${cod} -> $start" >> "$LOG"
    setsid bash -lc "$start" 9>&- >/dev/null 2>&1 &   # start-cmd is trusted local config (operator/steward-owned)
    announce_down "$name" "$cod"
  fi
done < "$REG"
[ "$STATUS" = 1 ] && exit 0 || true
# Clean pass (all children checked, no early-exit): refresh the liveness heartbeat. NOT reached on
# --status, flock-SKIP, or absent-registry FAIL — those are dry-run / not-this-run / broken-state.
touch "$HB"
