#!/usr/bin/env bash
# mesh-supervise — the SUPERVISOR (OTP-style "ensure children alive, restart the dead"). Portable:
# cron-driven, no systemd dependency, so it works on phones/termux too. Closes the self-healing gap —
# bare background loops (mesh-chat/snapshot/trace/provenance/selfcare/session-watchdog) have NO
# supervisor and die permanently on crash/OOM until the next reboot; this restarts them within a tick.
# Complements mesh-restore (which starts them @reboot) by covering mid-life death.
# Registry (trusted local config, like crontab): ~/.mesh/supervise.list  -> name | pgrep-pattern | start-cmd
# See docs/eternity-and-its-fields.md (supervision tree).
#
#   mesh-supervise           check all; restart any dead child
#   mesh-supervise --status  show each child's state
set -uo pipefail
# ── LIVENESS IS A CLAIM ABOUT *OUR* CHILD, NOT A SUBSTRING OF ANYONE'S CMDLINE ──────────────────
# `pgrep -u $uid -f -- "$pat"` greens the child whenever ANY of this user's cmdlines contains the
# pattern text. Two ways that fires with no child alive, both demonstrated on this node 2026-08-16
# (witness, task supervise-liveness-is-a-substring-not-a-child):
#   · PATH-BLIND — the supervised `/home/…/.local/bin/mesh-dram-bw --sampler` was dead (2 RESTARTs,
#     none since) while a developer's hand-run `bash scripts/mesh-dram-bw --sampler` held the
#     pattern. A run at 18:37 returned rc=0 and wrote nothing: a healthy verdict over a corpse.
#   · A PROBE STRING IS ITSELF A CMDLINE — `exec -a 'cat <pat>' sleep 8` reads ALIVE, and the
#     observer's own probe shell self-matched before the decoy even existed.
# The fix is not a better regex; it is to stop asking about TEXT. pgrep still selects candidates
# (cheap, portable), then each candidate must prove it is running the registered START-CMD's own
# program: an argv ELEMENT equal to it — `bash /home/…/mesh-dram-bw --sampler` has that element,
# `bash -lc "<the whole line as one arg>"` and `exec -a` never do. Same shape as mesh-dram-bw's
# perf_sessions(): match on the question, then confirm against the answer.
# The token to match on is the thing that IDENTIFIES the child, which is not always argv[0]: for a
# start-cmd of the form `bash /path/foo --loop` the interpreter name matches every other bash on the
# node (argv[0] is literally `bash`), so the script path is the identifying token. Skip leading
# VAR=… assignments; step past an interpreter to its script; never step onto a flag.
prog_token(){   # $1 = start-cmd → the token that names this child
  local t first= next=
  for t in $1; do
    case "$t" in [A-Za-z_]*=*) continue;; esac
    if [ -z "$first" ]; then first="$t"; continue; fi
    next="$t"; break
  done
  [ -n "$first" ] || return 1
  case "${first##*/}" in
    bash|sh|dash|zsh|ksh|ash|busybox|env|python|python3|perl|ruby|node)
      # …and a start-cmd that is an interpreter with NO script (`bash -lc '<inline loop>'`) has no
      # identifying token at all. Say so (rc 1) instead of matching on "bash", which would green the
      # child off any shell on the node — the caller degrades loudly.
      case "$next" in ''|-*) return 1;; *) printf '%s' "$next"; return 0;; esac ;;
  esac
  printf '%s' "$first"
}
# ── ALIVE IS NOT RUNNING: A CGROUP-FROZEN CHILD IS BYTE-IDENTICAL TO A HEALTHY ONE ────────────────
# child_pids() above answers "does a process of ours exist and is it the registered program". Both
# stay TRUE for a child that has been stopped dead: /proc/<pid> exists, cmdline is right, comm is
# right, the pidfile is valid — and it executes not one instruction. Measured on this node
# (kernel 6.8.0-138, uid 1000, cgroup v2, 2026-08-21; health's verify arm of discover's
# delegated-cgroup capability): a supervised child moved into a cgroup with `cgroup.freeze=1` reads
# UP here byte-identical to alive, while its beat log stops. That is the same shape as
# "executable and loadable are different claims" — EXISTING and RUNNING are different claims.
#
# THE SEPARATING READ, and why it is these two files and not the obvious ones:
#  · /proc/<pid>/stat state is **S** while cgroup-frozen — the SAME letter as a healthy sleeping
#    loop (measured: S before freeze, S during, S after). So stat CANNOT see a cgroup freeze. It
#    does see the sibling case: SIGSTOP renders **T** (and ptrace-stop **t**), which is equally a
#    stopped child reading UP today. Both are checked, for different faults.
#  · cgroup.events `frozen 1` — NOT cgroup.freeze. A descendant frozen by an ANCESTOR reads its own
#    cgroup.freeze as `0` while cgroup.events says `frozen 1` (measured, discover arm D): the KNOB
#    is not the STATE. Reading the knob would miss every freeze imposed from above, which is the
#    likely real case (any same-uid process can write a sibling scope's cgroup.freeze — 30/30
#    accepted, measured — so a mind can freeze another mind's whole scope).
# Both reads are unprivileged plain reads one field away from the /proc/<pid>/cmdline this function
# already opens; cost is two file reads per live candidate.
#
# REPORT-ONLY, DELIBERATELY. A frozen child is not restarted here: (a) the freeze is a deliberate
# write by SOMETHING, and thawing races that writer blind; (b) the freeze may sit on an ancestor
# shared with other scopes, so un-freezing has a blast radius the supervisor cannot see; (c) kill is
# not a clean out either — measured, SIGTERM does reap a frozen `sleep` (fatal signals wake the task
# to die), but a child that TRAPS SIGTERM — which every mesh loop and every mind engine does — cannot
# run its handler while frozen, so `kill` degrades to a hang exactly for the children we care about.
# This sense has never fired in production; per doctrine it measures before it actuates. It escalates
# through the SAME one-signal-per-episode path a death uses, so a mind sees it.
#
# HONEST ABSENCE: no /proc/<pid>/cgroup (v1-only, termux/android, a hidepid mount) or an unreadable
# cgroup.events yields NOT-halted, never a FROZEN verdict — "we could not look" must never read as
# "we looked and it is stopped", and a false FROZEN would escalate a healthy child to a mind.
#
# THE BOUND, STATED SO THE COVERAGE IS NOT OVERREAD (measured mesh-home 2026-08-21): on THIS node all
# three registered children — snapshot, selfcare, dram-bw-sampler — sit in the supervisor's OWN cgroup
# (app.slice/mesh-liveness-loop.service), because mesh-liveness-loop spawns both. A cgroup freeze of
# that cgroup therefore freezes THE SUPERVISOR TOO, and a detector inside the thing it detects reports
# nothing — the self-defeating shape ("is this reversible FROM OUTSIDE ITSELF?"). So of the two legs:
#   · the stat T/t leg (SIGSTOP, ptrace-stop) is LIVE for these children today — a per-process stop
#     does not touch the supervisor, and it is the leg that fires on the current registry.
#   · the cgroup.events leg is LATENT here and becomes real the moment a child lives in a cgroup the
#     supervisor does not share — a mind pane's tmux-spawn scope, a per-batch cgroup, a child on a
#     node whose registry is not spawned by the liveness loop. It costs one read either way.
# Do NOT read a green pass as "no child is frozen"; read it as "no child we can still see is halted".
# Catching a freeze of the loop's own cgroup needs a watcher OUTSIDE it, which this is not.
CGROOT="${MESH_SUP_CGROOT:-/sys/fs/cgroup}"
pid_halted(){   # $1=pid → prints "frozen"|"stopped"|"traced" + rc 0 when the pid exists but cannot run
  local pid="$1" st cg ev
  st="$(awk '{print $3}' "/proc/$pid/stat" 2>/dev/null)"
  case "$st" in
    T) printf 'stopped'; return 0 ;;   # SIGSTOP/SIGTSTP — a stopped child also reads UP today
    t) printf 'traced';  return 0 ;;   # ptrace-stop — same: exists, does nothing
  esac
  cg="$(cut -d: -f3 "/proc/$pid/cgroup" 2>/dev/null | grep -m1 '^/')" || return 1
  [ -n "$cg" ] || return 1
  ev="$CGROOT$cg/cgroup.events"
  [ -r "$ev" ] || return 1
  grep -qx 'frozen 1' "$ev" 2>/dev/null && { printf 'frozen'; return 0; }
  return 1
}
halted_pids(){  # $1=pids → "<n>/<total> <reason>" when ANY pid is halted; empty when all can run
  local pids="$1" pid r total=0 n=0 why=
  for pid in $pids; do
    total=$((total+1))
    r="$(pid_halted "$pid")" && { n=$((n+1)); [ -n "$why" ] || why="$r"; }
  done
  [ "$n" -gt 0 ] || return 0
  printf '%s/%s %s' "$n" "$total" "$why"
}
child_pids(){   # $1=pgrep-pattern $2=start-cmd → pids of OUR child (empty = genuinely DOWN)
  local pat="$1" prog base pid comm
  prog="$(prog_token "$2")" || {
    # UNVERIFIABLE ROW — an inline `bash -lc '…'` start-cmd names nothing this can bind to. Degrade
    # to the old substring match rather than declare it dead forever (that would restart-loop), and
    # LOG it: the weakness is then visible in the artifact a human reads instead of silent.
    [ -f "$MESH/.sup-unverifiable" ] || { echo "$(stamp) DEGRADED: start-cmd names no program to bind to (inline interpreter) — liveness for it falls back to a bare cmdline substring" >> "$LOG"; touch "$MESH/.sup-unverifiable"; }
    pgrep -u "$uid" -f -- "$pat" 2>/dev/null; return 0
  }
  base="${prog##*/}"
  # Honest degradation: without a readable /proc there is no argv to confirm against, so fall back
  # to the old text match rather than declaring every child dead and restart-looping. Says so once.
  if [ ! -r /proc/self/cmdline ]; then
    [ -f "$MESH/.sup-noproc" ] || { echo "$(stamp) DEGRADED: no readable /proc — liveness falls back to a bare cmdline substring (see supervise-liveness-is-a-substring-not-a-child)" >> "$LOG"; touch "$MESH/.sup-noproc"; }
    pgrep -u "$uid" -f -- "$pat" 2>/dev/null; return 0
  fi
  for pid in $(pgrep -u "$uid" -f -- "$pat" 2>/dev/null); do
    [ "$pid" = "$$" ] && continue
    [ -r "/proc/$pid/cmdline" ] || continue
    if tr '\0' '\n' < "/proc/$pid/cmdline" 2>/dev/null | grep -Fxq -- "$prog"; then echo "$pid"; continue; fi
    # A child that re-execs under its own name (a compiled binary, or one that rewrites argv) has
    # no such element — accept comm, but NEVER for an interpreter name: a script child's comm is
    # `bash`, and so is every probe shell's, so that leg would hand the blindness straight back.
    comm="$(cat "/proc/$pid/comm" 2>/dev/null)"
    case "$comm" in
      bash|sh|dash|zsh|ksh|ash|busybox|env|timeout|setsid|nohup|flock|sudo|python3|perl|'') continue;;
    esac
    [ "$comm" = "$base" ] && echo "$pid"
  done
}

[ "${1:-}" = --test ] && {
  command -v pgrep  >/dev/null 2>&1 || { echo "smoke-test: FAIL (no pgrep)"; exit 1; }
  command -v flock  >/dev/null 2>&1 || { echo "smoke-test: FAIL (no flock)"; exit 1; }
  command -v mktemp >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mktemp)"; exit 1; }
  command -v grep   >/dev/null 2>&1 || { echo "smoke-test: FAIL (no grep)"; exit 1; }
  command -v rm     >/dev/null 2>&1 || { echo "smoke-test: FAIL (no rm)"; exit 1; }
  tmp="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp failed)"; exit 1; }
  # INTERRUPT SAFETY (2026-08-25, task test-forgery-and-supervise-tests-leak-across-their-longest-window).
  # The trap here used to be `rm -rf "$tmp"` ALONE, while the EXISTS≠RUNS arm below starts a child
  # whose script is `trap "" TERM; sleep 60` and then FREEZES it into a cgroup of its own. That child
  # ignores SIGTERM by construction and a frozen `sleep` never advances, so an interrupt anywhere
  # across that arm left a PERMANENTLY frozen process plus an orphan
  # /sys/fs/cgroup/…/mesh-sup-frztest-$$ that nothing on the node reaps — and deleting `$tmp` out from
  # under it did not touch either. `_frz_clean` handled exactly this, but only on the explicit FAIL
  # branches; it was never trapped. It is defined further down, so dispatch by name AT SIGNAL TIME.
  # ONE trap statement per signal set: a second `trap … EXIT` silently REPLACES the first
  # (`a-bash-exit-trap-does-run-under-sigterm`). EXIT is the load-bearing arm — bash runs it under
  # SIGTERM, and only SIGKILL leaks past it; INT/TERM/HUP are here to make the exit status honest.
  _sup_test_clean() {
    declare -F _frz_clean >/dev/null 2>&1 && _frz_clean          # thaws, then -9, then rmdir
    # …and the same reap with _frz_clean not yet defined: a frozen cgroup must never outlive us.
    [ -n "${_frz_cg:-}" ] && [ -d "$_frz_cg" ] && {
      [ -w "$_frz_cg/cgroup.freeze" ] && { echo 0 > "$_frz_cg/cgroup.freeze"; } 2>/dev/null
      rmdir "$_frz_cg/g" "$_frz_cg" 2>/dev/null; }
    # every fixture child is $$-scoped in its own argv, so this can only ever name OUR children —
    # never a real supervised mesh process (`a-name-matching-stop-kills-your-other-selves`).
    local p
    for p in $(pgrep -u "$(id -u)" -f -- "-$$ --loop" 2>/dev/null) \
             $(pgrep -u "$(id -u)" -f -- "sleep-for-supervise-test-$$" 2>/dev/null); do
      [ "$p" = "$$" ] || kill -9 "$p" 2>/dev/null
    done
    rm -rf "${stubbin:-}" "${stubbin2:-}" "${tmp2:-}" "$tmp" 2>/dev/null
  }
  trap '_sup_test_clean' EXIT
  trap '_sup_test_clean; trap - EXIT; exit 130' INT
  trap '_sup_test_clean; trap - EXIT; exit 143' TERM HUP
  mkdir -p "$tmp/.mesh" || { echo "smoke-test: FAIL (no tmp mesh dir)"; exit 1; }
  # ABSENT REGISTRY = LOUD FAIL. This is the bug state that ran silently for a month; asserting it here
  # is the gate. Watched red against the old `exit 0` guard, green after. Temp HOME throughout — a test
  # that wrote the real supervise.log would forge the liveness evidence it exists to check (09f7914).
  out="$(HOME="$tmp" timeout 10 "$0" 2>&1)"; rc=$?
  [ "$rc" = 1 ] || { echo "smoke-test: FAIL (absent registry must exit 1, got rc=$rc — a silent exit 0 is how the supervisor supervised nothing for a month)"; exit 1; }
  printf '%s\n' "$out" | grep -q 'supervising NOTHING' || { echo "smoke-test: FAIL (absent registry did not say so on stderr: $out)"; exit 1; }
  grep -q 'FAIL no registry' "$tmp/.mesh/supervise.log" 2>/dev/null || { echo "smoke-test: FAIL (absent registry left no line in supervise.log — the artifact a human reads stayed empty, which is the original bug)"; exit 1; }
  rm -f "$tmp/.mesh/supervise.log"
  # An EMPTY registry is honest, not a fault: zero declared children, rc 0.
  : > "$tmp/.mesh/supervise.list"
  HOME="$tmp" timeout 10 "$0" >/dev/null 2>&1 || { echo "smoke-test: FAIL (an EMPTY registry is an honest zero-children state, must exit 0)"; exit 1; }
  cat > "$tmp/.mesh/supervise.list" <<'EOF'
demo|definitely-no-such-process-pattern-12345|echo should-not-run
EOF
  out="$(HOME="$tmp" timeout 10 "$0" --status 2>&1)" || {
    echo "smoke-test: FAIL (status dry-run failed: $out)"; exit 1;
  }
  printf '%s\n' "$out" | grep -q '^  DOWN demo' || {
    echo "smoke-test: FAIL (status output missing DOWN demo: $out)"; exit 1;
  }
  # cause-of-death (chat-review/wire-kill-events): a RESTART must cite a matching, recent
  # mesh-kill-events tape entry in the log line; a genuinely dead child with no matching tape entry
  # gets a plain RESTART line (no fabricated cause).
  cat > "$tmp/.mesh/kill-events.log" <<EOF
$(date -u +%FT%TZ) kill-event victim=mesh-kill-events-test-victim pid=4242 kind=oom rss=123 vm=456
EOF
  cat > "$tmp/.mesh/supervise.list" <<'EOF'
demo|definitely-no-such-process-pattern-12345|echo should-not-run
codvictim|mesh-kill-events-test-victim|echo should-not-run-2
EOF
  # MESH_SUP_NOTIFY=0 keeps the existing assertions free of the OTP-style broadcast added
  # 2026-07-19 (otherwise the live-path restart would call the real mesh-chat on PATH and
  # pollute the board with test runs).
  HOME="$tmp" MESH_SUP_NOTIFY=0 timeout 10 "$0" >/dev/null 2>&1
  grep -qE 'RESTART codvictim \(was dead\) \(cause: kind=oom pid=4242, [0-9]+s ago\) -> echo' "$tmp/.mesh/supervise.log" || {
    echo "smoke-test: FAIL (matching kill-events tape entry not cited in RESTART log line)"; exit 1;
  }
  # A child with no matching kernel entry and no death note must NOT get a fabricated cause — and,
  # since the signal plane landed, must not get SILENCE either: an unexplained death has to say which
  # plane was blind. (This arm asserted "a plain RESTART line" and went RED the moment the plane
  # started appending its abstention; it was landed red at 11:14Z on 2026-08-29. The intent it was
  # written for — never invent a cause — is unchanged and is what it now checks.)
  grep -qE 'RESTART demo \(was dead\) \(cause: UNKNOWN-SIGNAL' "$tmp/.mesh/supervise.log" || {
    echo "smoke-test: FAIL (a dead child with no kernel entry and no death note must render an explicit UNKNOWN-SIGNAL abstention naming the blind plane — silence here is the original fault: $(grep 'RESTART demo' "$tmp/.mesh/supervise.log" 2>/dev/null))"; exit 1;
  }
  grep -qE 'RESTART demo \(was dead\) \(cause: (kind|signal)=' "$tmp/.mesh/supervise.log" && {
    echo "smoke-test: FAIL (demo has no matching victim and no note — must not fabricate a kind= or a signal=)"; exit 1;
  }
  # OTP-style link-broadcast (STUDY 2026-07-19): on a DOWN->RESTART transition, announce_down
  # posts to the local mesh-chat board AND fans out to peer mind-nodes via mesh-tell --node.
  # Idempotent per down-period (flag file, cleared on UP return). Mutation-falsifiable: drop
  # the `touch "$af"` and the idempotency assertion fails; drop the mesh-chat call and the
  # local-marker assertion fails; drop the mesh-tell loop and the peer-marker assertion fails.
  stubbin="$(mktemp -d)"
  cat > "$stubbin/mesh-chat" <<'STUB'
#!/usr/bin/env bash
echo "$@" >> "$MESH_CHAT_MARKER"
STUB
  chmod +x "$stubbin/mesh-chat"
  cat > "$stubbin/mesh-tell" <<'STUB'
#!/usr/bin/env bash
[ "$1" = "--node" ] && echo "$2:$4" >> "$MESH_TELL_MARKER"
STUB
  chmod +x "$stubbin/mesh-tell"
  rm -f "$tmp/.mesh/supervise.log" "$tmp/.mesh/.sup-announced-demo"
  cat > "$tmp/.mesh/supervise.list" <<'EOF'
demo|definitely-no-such-process-pattern-12345|echo should-not-run
EOF
  MESH_CHAT_MARKER="$tmp/chat.marker" MESH_TELL_MARKER="$tmp/tell.marker" \
    MESH_SUP_PEERS="peer-a:role peer-b:role $(hostname):role" \
    HOME="$tmp" PATH="$stubbin:$PATH" timeout 10 "$0" >/dev/null 2>&1
  grep -q "^\[restart\] $(hostname): supervised 'demo' died" "$tmp/chat.marker" || {
    echo "smoke-test: FAIL (local mesh-chat broadcast did not fire on restart)"; rm -rf "$stubbin"; exit 1; }
  grep -q 'peer-a' "$tmp/tell.marker" || {
    echo "smoke-test: FAIL (peer-a not notified via mesh-tell --node)"; rm -rf "$stubbin"; exit 1; }
  grep -q 'peer-b' "$tmp/tell.marker" || {
    echo "smoke-test: FAIL (peer-b not notified via mesh-tell --node)"; rm -rf "$stubbin"; exit 1; }
  grep -q "^$(hostname):" "$tmp/tell.marker" && {
    echo "smoke-test: FAIL (self-leak: announce notified this node as a peer)"; rm -rf "$stubbin"; exit 1; }
  [ -f "$tmp/.mesh/.sup-announced-demo" ] || {
    echo "smoke-test: FAIL (idempotency flag .sup-announced-demo not set after announce)"; rm -rf "$stubbin"; exit 1; }
  # Second run while still DOWN: announce must NOT fire again (one signal per death).
  rm -f "$tmp/chat.marker" "$tmp/tell.marker"
  MESH_CHAT_MARKER="$tmp/chat.marker" MESH_TELL_MARKER="$tmp/tell.marker" \
    MESH_SUP_PEERS="peer-a:role" \
    HOME="$tmp" PATH="$stubbin:$PATH" timeout 10 "$0" >/dev/null 2>&1
  [ -f "$tmp/chat.marker" ] && {
    echo "smoke-test: FAIL (announce fired again while still DOWN - idempotency flag broken)"; rm -rf "$stubbin"; exit 1; }
  # clear_announce on UP return: a live child must clear the flag so the next death re-announces.
  rm -f "$tmp/.mesh/supervise.log"
  cat > "$tmp/.mesh/supervise.list" <<EOF
demo|sleep-for-supervise-test-$$|sleep 30
EOF
  setsid bash -c "exec -a sleep-for-supervise-test-$$ sleep 30" >/dev/null 2>&1 &
  sleep 0.3
  HOME="$tmp" PATH="$stubbin:$PATH" timeout 10 "$0" >/dev/null 2>&1
  [ -f "$tmp/.mesh/.sup-announced-demo" ] && {
    echo "smoke-test: FAIL (clear_announce did not remove the flag when child returned UP)"; rm -rf "$stubbin"; kill %1 2>/dev/null; exit 1; }
  kill %1 2>/dev/null; wait 2>/dev/null
  rm -rf "$stubbin"
  # LIVENESS-TOUCH (2026-07-19): a healthy pass must touch the heartbeat so reflex-health / a
  # reflex-vanished census can see the supervisor RAN, not just "no RESTART in supervise.log".
  # The run above had a live child → clean pass → HB must exist + be fresh.
  [ -f "$tmp/.mesh/.supervise.heartbeat" ] || {
    echo "smoke-test: FAIL (healthy pass left no .supervise.heartbeat — SCHEDULED ≠ RAN, the original census-blind-spot bug)"; exit 1; }
  # Negative discriminator: an ABSENT REGISTRY is a FAIL (exit 1, broken state) and must NOT touch
  # the heartbeat — broken-state-must-not-look-alive is the same rule as f215c9e's absent-registry
  # FAIL line. If this goes RED the touch is on the wrong path (before the registry guard).
  rm -rf "${tmp2:-}" 2>/dev/null; tmp2="$(mktemp -d)"; mkdir -p "$tmp2/.mesh"
  precount=$(find "$tmp2/.mesh" -name '.supervise.heartbeat' 2>/dev/null | wc -l)
  HOME="$tmp2" timeout 10 "$0" >/dev/null 2>&1
  postcount=$(find "$tmp2/.mesh" -name '.supervise.heartbeat' 2>/dev/null | wc -l)
  [ "$precount" = "$postcount" ] || {
    echo "smoke-test: FAIL (absent-registry FAIL path touched the heartbeat — broken state must not look alive)"; exit 1; }
  rm -rf "$tmp2"

  # ── LIVENESS IS A CLAIM ABOUT OUR CHILD, NOT A SUBSTRING (task
  #    supervise-liveness-is-a-substring-not-a-child, witness 2026-08-16 18:38Z). All three legs
  #    were watched RED against the pre-fix `pgrep -u $uid -f -- "$pat"`: it greened the decoy, it
  #    greened the wrong-path copy, and it logged NOTHING where a RESTART was owed.
  _sup_kill(){ local p; for p in $(pgrep -f -- "$1" 2>/dev/null); do [ "$p" = "$$" ] || kill "$p" 2>/dev/null; done; }
  rm -f "$tmp/.mesh/supervise.log" "$tmp/.mesh/.sup-restarts-supchild"
  mkdir -p "$tmp/deployed" "$tmp/repo"
  printf '#!/usr/bin/env bash\nsleep 45\n' > "$tmp/deployed/supchild-$$"
  cp "$tmp/deployed/supchild-$$" "$tmp/repo/supchild-$$"
  chmod +x "$tmp/deployed/supchild-$$" "$tmp/repo/supchild-$$"
  cat > "$tmp/.mesh/supervise.list" <<EOF
supchild|supchild-$$ --loop|$tmp/deployed/supchild-$$ --loop
EOF
  # (1) POSITIVE FIRST — a check this strict is worthless if it can never green. The real deployed
  #     child, started exactly as the supervisor starts it, must read UP.
  setsid bash -lc "$tmp/deployed/supchild-$$ --loop" >/dev/null 2>&1 &
  sleep 0.5
  out="$(HOME="$tmp" MESH_SUP_NOTIFY=0 timeout 10 "$0" --status 2>&1)"
  case "$out" in *"UP   supchild"*) :;;
    *) _sup_kill "supchild-$$"; echo "smoke-test: FAIL (the genuinely-running deployed child must read UP: $out)"; exit 1;; esac
  _sup_kill "$tmp/deployed/supchild-$$"; sleep 0.3
  # (2) PATH-BLIND — a hand-run copy at a DIFFERENT path with the same basename and the same
  #     pattern must not stand in for the deployed child. This is the live 18:37Z incident.
  setsid bash -lc "$tmp/repo/supchild-$$ --loop" >/dev/null 2>&1 &
  sleep 0.5
  out="$(HOME="$tmp" MESH_SUP_NOTIFY=0 timeout 10 "$0" --status 2>&1)"
  case "$out" in *"DOWN supchild"*) :;;
    *) _sup_kill "supchild-$$"; echo "smoke-test: FAIL (a hand-run copy at another path masked the dead supervised child: $out)"; exit 1;; esac
  _sup_kill "$tmp/repo/supchild-$$"; sleep 0.3
  # (3) DECOY + THE RESTART IT OWES — a process whose cmdline merely CONTAINS the pattern must not
  #     green it, and the real run must log RESTART. Pre-fix this wrote nothing at all.
  setsid bash -c "exec -a 'supchild-$$ --loop' sleep 45" >/dev/null 2>&1 &
  sleep 0.5
  out="$(HOME="$tmp" MESH_SUP_NOTIFY=0 timeout 10 "$0" --status 2>&1)"
  case "$out" in *"DOWN supchild"*) :;;
    *) _sup_kill "supchild-$$"; echo "smoke-test: FAIL (an exec -a decoy holding the pattern read as the live child: $out)"; exit 1;; esac
  HOME="$tmp" MESH_SUP_NOTIFY=0 timeout 10 "$0" >/dev/null 2>&1
  grep -q "RESTART supchild (was dead)" "$tmp/.mesh/supervise.log" 2>/dev/null || {
    _sup_kill "supchild-$$"; echo "smoke-test: FAIL (child dead behind a decoy — supervisor logged no RESTART: $(cat "$tmp/.mesh/supervise.log" 2>/dev/null))"; exit 1; }
  _sup_kill "supchild-$$"; sleep 0.2
  # (4) AN INTERPRETER IS NOT AN IDENTITY. A start-cmd of `bash <script>` has argv[0] == "bash" on
  #     the child AND on every probe shell on the node, so matching the first token would hand the
  #     blindness straight back. The script path is the identifying token.
  [ "$(prog_token "FOO=1 BAR=2 /usr/bin/thing --flag")" = /usr/bin/thing ] || {
    echo "smoke-test: FAIL (prog_token must skip leading VAR= assignments)"; exit 1; }
  [ "$(prog_token "bash /opt/x/child.sh --loop")" = /opt/x/child.sh ] || {
    echo "smoke-test: FAIL (prog_token must step past an interpreter to its script)"; exit 1; }
  prog_token "bash -lc 'thing'" >/dev/null 2>&1 && {
    echo "smoke-test: FAIL (an inline interpreter start-cmd names nothing bindable — prog_token must say so, not answer 'bash')"; exit 1; }
  # …and that row must degrade LOUDLY, not silently: the fallback writes its own DEGRADED line.
  rm -f "$tmp/.mesh/supervise.log" "$tmp/.mesh/.sup-unverifiable"
  cat > "$tmp/.mesh/supervise.list" <<EOF
inline|no-such-inline-child-pattern-$$|bash -lc 'sleep 45'
EOF
  HOME="$tmp" MESH_SUP_NOTIFY=0 timeout 10 "$0" --status >/dev/null 2>&1
  grep -q 'DEGRADED: start-cmd names no program to bind to' "$tmp/.mesh/supervise.log" 2>/dev/null || {
    echo "smoke-test: FAIL (an unverifiable row fell back to substring matching without saying so)"; exit 1; }
  rm -f "$tmp/.mesh/supervise.log" "$tmp/.mesh/.sup-restarts-interp"
  printf '#!/usr/bin/env bash\nsleep 45\n' > "$tmp/deployed/supkid-$$"; chmod +x "$tmp/deployed/supkid-$$"
  cat > "$tmp/.mesh/supervise.list" <<EOF
interp|supkid-$$ --loop|bash $tmp/deployed/supkid-$$ --loop
EOF
  setsid bash -c "sleep 45 # supkid-$$ --loop" >/dev/null 2>&1 &   # a shell merely MENTIONING it
  sleep 0.5
  out="$(HOME="$tmp" MESH_SUP_NOTIFY=0 timeout 10 "$0" --status 2>&1)"
  case "$out" in *"DOWN interp"*) :;;
    *) _sup_kill "supkid-$$"; echo "smoke-test: FAIL (a bash shell mentioning the pattern greened a 'bash <script>' child: $out)"; exit 1;; esac
  setsid bash -lc "bash $tmp/deployed/supkid-$$ --loop" >/dev/null 2>&1 &
  sleep 0.5
  out="$(HOME="$tmp" MESH_SUP_NOTIFY=0 timeout 10 "$0" --status 2>&1)"
  case "$out" in *"UP   interp"*) :;;
    *) _sup_kill "supkid-$$"; echo "smoke-test: FAIL (the real 'bash <script>' child must still read UP: $out)"; exit 1;; esac
  _sup_kill "supkid-$$"; sleep 0.2

  # ── (5) EXISTS ≠ RUNS: a REAL cgroup freeze, not a fixture (mindstate-loop-is-the-only-freeze-
  #     detector-and-is-unwired, 2026-08-21). Drives an actual child into an actual cgroup and
  #     actually freezes it, because the whole finding is that every SIMULATED liveness check passes.
  #     Exits 2 (honest n/a) where cgroup v2 delegation is absent (termux/android, a root-only tree) —
  #     never green-by-not-looking.
  _frz_par="$(cut -d: -f3 /proc/self/cgroup 2>/dev/null | grep -m1 '^/')"
  _frz_cg=""
  if [ -n "$_frz_par" ] && [ -d "/sys/fs/cgroup$_frz_par" ]; then
    _frz_cg="/sys/fs/cgroup$(dirname "$_frz_par")/mesh-sup-frztest-$$"
    # NESTED on purpose: the child goes in the GRANDCHILD and the freeze is written on the PARENT,
    # so the child's OWN cgroup.freeze stays "0" while it is frozen solid. That is the real shape
    # (a mind freezing another mind's whole scope), and it is the only arm that can tell the two
    # candidate reads apart — a pid_halted() written against cgroup.freeze passes a same-cgroup
    # freeze and fails here.
    mkdir -p "$_frz_cg/g" 2>/dev/null || _frz_cg=""
    [ -n "$_frz_cg" ] && [ -w "$_frz_cg/cgroup.freeze" ] && [ -r "$_frz_cg/g/cgroup.events" ] || { rmdir "$_frz_cg/g" "$_frz_cg" 2>/dev/null; _frz_cg=""; }
  fi
  if [ -z "$_frz_cg" ]; then
    echo "smoke-test: n/a (no writable delegated cgroup v2 subtree here — the EXISTS≠RUNS arm cannot run; every other arm passed)"; exit 2
  fi
  # IDEMPOTENT ON PURPOSE: it is called on every explicit FAIL branch, once on the success path, AND
  # from the EXIT trap — so a second call must be a silent no-op, not a write to a cgroup that is
  # already gone. `> "$f" 2>/dev/null` cannot suppress the SHELL's own open failure
  # (`a-stderr-null-after-a-redirection-cannot-suppress-the-open-failure`), so gate on -d/-w and
  # clear the state afterwards; a --test that prints errors while passing teaches readers to ignore stderr.
  _frz_clean(){
    # Reap the process GROUP, not just the pid: the fixture is `trap "" TERM; sleep 60`, so -9 on the
    # shell alone orphans its inner `sleep` to init for up to 60s. It is started under `setsid`, which
    # makes it its own session/group leader, so -$_frz_pid names exactly OUR two processes and can
    # never reach anything else. Thaw FIRST — a -9 lands but does not reap while the cgroup is frozen.
    [ -n "${_frz_pid:-}" ] && { [ -w "${_frz_cg:-}/cgroup.freeze" ] && { echo 0 > "$_frz_cg/cgroup.freeze"; } 2>/dev/null
                                kill -9 -- "-$_frz_pid" 2>/dev/null || kill -9 "$_frz_pid" 2>/dev/null
                                sleep 0.4; }
    [ -n "${_frz_cg:-}" ] && [ -d "$_frz_cg" ] && rmdir "$_frz_cg/g" "$_frz_cg" 2>/dev/null
    rm -rf "${stubbin2:-}" 2>/dev/null
    _frz_pid=""; _frz_cg=""      # a second call reaps nothing and writes nowhere
  }
  rm -f "$tmp/.mesh/supervise.log" "$tmp/.mesh/.sup-halted-frz" "$tmp/chat.marker"
  stubbin2="$(mktemp -d)"
  printf '#!/usr/bin/env bash\necho "$@" >> "$MESH_CHAT_MARKER"\n' > "$stubbin2/mesh-chat"; chmod +x "$stubbin2/mesh-chat"
  printf '#!/usr/bin/env bash\ntrap "" TERM\nsleep 60\n' > "$tmp/deployed/frzkid-$$"; chmod +x "$tmp/deployed/frzkid-$$"
  cat > "$tmp/.mesh/supervise.list" <<EOF
frz|frzkid-$$ --loop|$tmp/deployed/frzkid-$$ --loop
EOF
  setsid "$tmp/deployed/frzkid-$$" --loop >/dev/null 2>&1 &
  sleep 0.6
  _frz_pid="$(pgrep -u "$(id -u)" -f -- "frzkid-$$ --loop" | head -1)"
  [ -n "$_frz_pid" ] || { _frz_clean; echo "smoke-test: FAIL (EXISTS≠RUNS arm could not start its child)"; exit 1; }
  # CONTROL ARM FIRST — unfrozen, this exact child must read UP. Without it a FROZEN verdict below
  # could come from the row simply never matching (the gate would pass for the wrong reason).
  out="$(HOME="$tmp" MESH_SUP_NOTIFY=0 timeout 10 "$0" --status 2>&1)"
  case "$out" in *"UP   frz"*) :;;
    *) _frz_clean; echo "smoke-test: FAIL (control arm: the unfrozen child must read UP: $out)"; exit 1;; esac
  echo "$_frz_pid" > "$_frz_cg/g/cgroup.procs" 2>/dev/null || { _frz_clean; echo "smoke-test: FAIL (could not migrate the child into the test cgroup)"; exit 1; }
  echo 1 > "$_frz_cg/cgroup.freeze" 2>/dev/null || { _frz_clean; echo "smoke-test: FAIL (cgroup.freeze write refused)"; exit 1; }
  sleep 0.4
  # THE KNOB IS NOT THE STATE. Assert the premise pid_halted is built on, so a kernel where it
  # stopped holding goes RED here instead of silently making the detector blind again.
  [ "$(cat "$_frz_cg/g/cgroup.freeze" 2>/dev/null)" = 0 ] || { _frz_clean; echo "smoke-test: FAIL (an ancestor-frozen child now reports its OWN cgroup.freeze as 1 — the premise for reading cgroup.events instead no longer holds; re-derive pid_halted)"; exit 1; }
  grep -qx 'frozen 1' "$_frz_cg/g/cgroup.events" || { _frz_clean; echo "smoke-test: FAIL (ancestor freeze did not propagate to the child's cgroup.events — this arm is not measuring a freeze)"; exit 1; }
  # The blindness this arm exists for: assert the OLD evidence still all says healthy, so a future
  # reader can see the verdict is not riding on the process having vanished.
  [ -d "/proc/$_frz_pid" ] || { _frz_clean; echo "smoke-test: FAIL (frozen child vanished — this arm is measuring the wrong thing)"; exit 1; }
  [ "$(awk '{print $3}' "/proc/$_frz_pid/stat" 2>/dev/null)" = S ] || { _frz_clean; echo "smoke-test: FAIL (frozen child's /proc stat state is not 'S' — the premise that stat cannot see a cgroup freeze no longer holds on this kernel; re-derive pid_halted)"; exit 1; }
  out="$(HOME="$tmp" MESH_SUP_NOTIFY=0 timeout 10 "$0" --status 2>&1)"
  case "$out" in *"FROZEN frz"*) :;;
    *) _frz_clean; echo "smoke-test: FAIL (a REALLY cgroup-frozen child did not read FROZEN — the exact hole this arm exists for: $out)"; exit 1;; esac
  # …and the non-dry-run path must LOG it, escalate ONCE, and never restart it.
  MESH_CHAT_MARKER="$tmp/chat.marker" HOME="$tmp" PATH="$stubbin2:$PATH" timeout 10 "$0" >/dev/null 2>&1
  grep -q "HALTED frz (1/1 frozen)" "$tmp/.mesh/supervise.log" 2>/dev/null || { _frz_clean; echo "smoke-test: FAIL (frozen child left no HALTED line in supervise.log: $(cat "$tmp/.mesh/supervise.log" 2>/dev/null))"; exit 1; }
  grep -q "^\[halted\] $(hostname): supervised 'frz' is 1/1 frozen" "$tmp/chat.marker" 2>/dev/null || { _frz_clean; echo "smoke-test: FAIL (a halted child was logged but never escalated to the board — nothing will fix it on its own: $(cat "$tmp/chat.marker" 2>/dev/null))"; exit 1; }
  grep -q "RESTART frz" "$tmp/.mesh/supervise.log" 2>/dev/null && { _frz_clean; echo "smoke-test: FAIL (supervisor restarted a frozen child — report-only by design; a duplicate child is worse than a stopped one)"; exit 1; }
  [ -f "$tmp/.mesh/.sup-halted-frz" ] || { _frz_clean; echo "smoke-test: FAIL (halt episode left no .sup-halted-frz flag — the next tick would re-escalate every 120s)"; exit 1; }
  rm -f "$tmp/.mesh/supervise.log"
  HOME="$tmp" MESH_SUP_NOTIFY=0 timeout 10 "$0" >/dev/null 2>&1
  grep -q "HALTED frz" "$tmp/.mesh/supervise.log" 2>/dev/null && { _frz_clean; echo "smoke-test: FAIL (halt re-announced while still frozen — one signal per episode)"; exit 1; }
  # RECOVERY: thawed, the same child must read UP again and re-arm the signal.
  echo 0 > "$_frz_cg/cgroup.freeze"; sleep 0.4
  out="$(HOME="$tmp" MESH_SUP_NOTIFY=0 timeout 10 "$0" --status 2>&1)"
  case "$out" in *"UP   frz"*) :;;
    *) _frz_clean; echo "smoke-test: FAIL (a thawed child must read UP again: $out)"; exit 1;; esac
  HOME="$tmp" MESH_SUP_NOTIFY=0 timeout 10 "$0" >/dev/null 2>&1
  [ -f "$tmp/.mesh/.sup-halted-frz" ] && { _frz_clean; echo "smoke-test: FAIL (thawed child did not clear .sup-halted-frz — a second freeze would be silent)"; exit 1; }
  # SIGSTOP is the sibling fault and must ALSO be caught (state 'T', not a cgroup freeze at all).
  kill -STOP "$_frz_pid"; sleep 0.3
  out="$(HOME="$tmp" MESH_SUP_NOTIFY=0 timeout 10 "$0" --status 2>&1)"
  case "$out" in *"FROZEN frz"*"stopped"*) :;;
    *) kill -CONT "$_frz_pid"; _frz_clean; echo "smoke-test: FAIL (a SIGSTOPped child read UP — it exists and cannot run either: $out)"; exit 1;; esac
  kill -CONT "$_frz_pid"
  _frz_clean
  # ── THE SIGNAL PLANE: THE NOTE IS READ, AND ARMING IS A CLAIM ABOUT THE RUNNING CHILD ───────────
  # (2026-08-29, task supervise-death-cannot-name-a-userspace-signal.) Two things are gated here.
  # FIRST, a death note must reach the RESTART line — that is the whole plane. SECOND, and this is the
  # arm that was RED on the first live drive: the arming verdict must come from the process, not from
  # the file. Pre-fix this grepped the binary on disk, so all four of this node's children — started
  # 07:48Z, trap deployed 10:50Z — read ARMED while none of them could name a signal at all, and a
  # real SIGTERM produced "this child IS armed, so the likely causes are SIGKILL … or a death before
  # the trap was installed": two confident hypotheses, neither true, the true one absent.
  _sup_arm_bin(){ # $1=path $2=armed|plain — a fixture child, with or without the trap marker
    { echo '#!/usr/bin/env bash'
      [ "$2" = armed ] && echo '# mesh-death-note (marker: this child carries the trap)'
      echo 'while :; do sleep 5 & wait $! 2>/dev/null; done'; } > "$1"
    chmod +x "$1"
  }
  _sup_arm_drive(){ # $1=word-under-test $2=armed|plain $3=stale|fresh -> echoes the RESTART line
    local nm="arm$1$$" bd="$tmp/armbin-$1"
    mkdir -p "$bd"; _sup_arm_bin "$bd/$nm" "$2"
    # binary mtime BEFORE the child starts = the child loaded this text; touching it AFTER means the
    # running process predates its own deployed trap, which is exactly the stale-text case.
    [ "$3" = fresh ] && touch -d '1 hour ago' "$bd/$nm"
    printf '%s|%s --loop|%s/%s --loop\n' "$nm" "$nm" "$bd" "$nm" > "$tmp/.mesh/supervise.list"
    rm -f "$tmp/.mesh/supervise.log" "$tmp/.mesh/.sup-restarts-$nm" "$tmp/.mesh/.sup-armed-$nm"
    if [ "$1" != unobserved ]; then
      setsid bash -lc "$bd/$nm --loop" >/dev/null 2>&1 &
      sleep 0.6
      # a REAL gap, not a same-second tie: /proc mtimes are whole seconds, and a fixture that leans on
      # the tie-break rule is testing the tie-break, not the case it claims to be about.
      [ "$3" = stale ] && { sleep 1.2; touch "$bd/$nm"; }   # binary now NEWER than the running process
      HOME="$tmp" PATH="$bd:$PATH" MESH_SUP_NOTIFY=0 timeout 10 "$0" >/dev/null 2>&1   # observe it UP
      _sup_kill "$bd/$nm --loop"; sleep 0.4
    fi
    HOME="$tmp" PATH="$bd:$PATH" MESH_SUP_NOTIFY=0 MESH_DEATH_TAPE="$tmp/.mesh/empty-deaths.log" \
      timeout 10 "$0" >/dev/null 2>&1
    _sup_kill "$bd/$nm --loop"
    grep "RESTART $nm" "$tmp/.mesh/supervise.log" 2>/dev/null | tail -1
  }
  : > "$tmp/.mesh/empty-deaths.log"
  line="$(_sup_arm_drive armed armed fresh)"
  case "$line" in *"WAS observed running armed text"*) :;;
    *) echo "smoke-test: FAIL (a child observed running text NEWER than its deployed trap must render as armed: $line)"; exit 1;; esac
  line="$(_sup_arm_drive stale armed stale)"
  case "$line" in *"DEPLOYED but never LOADED"*) :;;
    *) echo "smoke-test: FAIL (a child whose running text PREDATES its deployed trap must say so — this is the live 2026-08-29 case where four unarmed children all read ARMED: $line)"; exit 1;; esac
  case "$line" in *"WAS observed running armed text"*)
    echo "smoke-test: FAIL (the stale-text case rendered as armed — the arming verdict is reading the disk again: $line)"; exit 1;; esac
  line="$(_sup_arm_drive unarmed plain fresh)"
  case "$line" in *"carries NO death-note trap at all"*) :;;
    *) echo "smoke-test: FAIL (a tool with no trap must render as absent-plane, not as a quiet one: $line)"; exit 1;; esac
  line="$(_sup_arm_drive unobserved armed fresh)"
  case "$line" in *"never observed this child UP"*) :;;
    *) echo "smoke-test: FAIL (a child the supervisor never saw UP must render UNKNOWN arming, never armed: $line)"; exit 1;; esac
  # …and the note itself must reach the log line, outranking every arming word above.
  nm="notechild$$"; bd="$tmp/armbin-note"; mkdir -p "$bd"; _sup_arm_bin "$bd/$nm" armed
  printf '%s|%s --loop|%s/%s --loop\n' "$nm" "$nm" "$bd" "$nm" > "$tmp/.mesh/supervise.list"
  rm -f "$tmp/.mesh/supervise.log" "$tmp/.mesh/.sup-restarts-$nm"
  printf '%s DEATH tool=%s pid=31337 sig=TERM\n' "$(date -u +%FT%TZ)" "$nm" > "$tmp/.mesh/deaths.log"
  HOME="$tmp" PATH="$bd:$PATH" MESH_SUP_NOTIFY=0 MESH_DEATH_TAPE="$tmp/.mesh/deaths.log" \
    timeout 10 "$0" >/dev/null 2>&1
  _sup_kill "$bd/$nm --loop"
  grep -qE "RESTART $nm \(was dead\) \(cause: signal=TERM pid=31337, [0-9]+s ago, self-reported\)" "$tmp/.mesh/supervise.log" || {
    echo "smoke-test: FAIL (a death note naming the signal did not reach the RESTART line: $(grep "RESTART $nm" "$tmp/.mesh/supervise.log" 2>/dev/null))"; exit 1; }
  # A NOTE FOR ANOTHER CHILD IS NOT THIS CHILD'S NOTE. The match is on the whole tool= field, so a
  # name that is a prefix of another's must not borrow its death — that is the cheapest way to turn
  # this plane into a confident liar (dram-bw would otherwise wear dram-bw-sampler's signal).
  rm -f "$tmp/.mesh/supervise.log" "$tmp/.mesh/.sup-restarts-$nm"
  printf '%s DEATH tool=%s-sibling pid=999 sig=HUP\n' "$(date -u +%FT%TZ)" "$nm" > "$tmp/.mesh/deaths.log"
  HOME="$tmp" PATH="$bd:$PATH" MESH_SUP_NOTIFY=0 MESH_DEATH_TAPE="$tmp/.mesh/deaths.log" \
    timeout 10 "$0" >/dev/null 2>&1
  _sup_kill "$bd/$nm --loop"
  grep -qE "RESTART $nm .*(signal=|self-reported)" "$tmp/.mesh/supervise.log" && {
    echo "smoke-test: FAIL (a sibling's death note was read as this child's: $(grep "RESTART $nm" "$tmp/.mesh/supervise.log"))"; exit 1; }

  echo "smoke-test: ok (registry/cause-of-death/announce/heartbeat + THE SIGNAL PLANE: a death note naming the signal reaches the RESTART line, a sibling's note never does, and the four arming words are driven from real /proc start times vs real binary mtimes — armed, stale-text (DEPLOYED but never LOADED: the live 2026-08-29 case), unarmed, unobserved + liveness bound to OUR child: positive UP, wrong-path DOWN, decoy DOWN + RESTART logged + EXISTS≠RUNS: a child frozen by its ANCESTOR (own cgroup.freeze still 0) reads FROZEN not UP while /proc and stat 'S' still say healthy, logged + escalated once + never restarted, thaw returns UP and re-arms, SIGSTOP caught too)"; exit 0
}
export PATH="$HOME/.local/bin:$PATH"
MESH="$HOME/.mesh"; REG="$MESH/supervise.list"; LOG="$MESH/supervise.log"; LOCK="$MESH/.supervise.lock"; HB="$MESH/.supervise.heartbeat"
mkdir -p "$MESH"
# LIVENESS-TOUCH (chat-review/conditional-write-liveness-touch 2026-06-25, doctrine 2026-07-15):
# this supervisor wrote NOTHING on a healthy pass — only SKIP/FAIL/RESTART lines hit supervise.log,
# so a long-stable node (all children UP, no restarts) left ZERO artifact. reflex-health/pulse age by
# mtime, and a reflex-vanished census (pub 2026-07-19 03:23) read that as "gone from schedule" → false
# unwiring claim that nearly invalidated the OTP-broadcast [done] at 03:04. SCHEDULED ≠ RAN. So every
# real pass touches HB on the way out — decoupling ran-live (mtime) from value-changed (LOG content).
# Deliberately NOT touched on: --status (dry-run), flock-SKIP (another supervisor ran, not this one),
# absent-registry FAIL (broken state must not look alive — the original silent-no-op bug, f215c9e).
# A MISSING REGISTRY IS A FAULT, NOT A REST STATE — this guard was `exit 0` and silent, and that is the
# whole reason the supervisor supervised nothing from 2026-06-13 to 2026-07-15 with every surface green.
# mesh-liveness-loop schedules this tool every 120s and logs ONLY rc!=0, so exit 0 meant ~450 no-op runs
# a day left zero trace anywhere: no supervise.log to age, nothing for reflex-health/doctor to read. Being
# SCHEDULED is this tool's claim to run; if it is called and has no children it is broken, and it must say
# so on the artifact a human reads (severity binds to the claim, not to a node name — f215c9e). An EMPTY
# registry is a different, honest state: the operator declared zero children, so the loop below is a no-op
# and rc stays 0. Only ABSENT is the fault.
[ -f "$REG" ] || {
  echo "$(date -u +%FT%TZ) FAIL no registry ($REG) — supervising NOTHING; mesh-restore should have registered its infra loops" >> "$LOG"
  echo "no registry ($REG) — supervising NOTHING (run mesh-restore to register the infra loops)" >&2
  exit 1
}
# A restore and cron tick may overlap. Serialize checks so they cannot launch
# duplicate children. Restarted children must close FD 9 or they inherit and
# hold this lock for their entire lifetime.
exec 9>"$LOCK"
flock -n 9 || { echo "$(date -u +%FT%TZ) SKIP: another supervisor is already running" >> "$LOG"; exit 0; }
stamp(){ date -u +%FT%TZ; }
STATUS=0; [ "${1:-}" = --status ] && STATUS=1
uid=$(id -u)

# OTP-style restart intensity: if a child restarts more than RMAX times in RWIN seconds, it's a
# PERSISTENT fault (not a transient crash) — stop restarting it and escalate to a mind, instead of
# fail-looping forever and masking the real problem. (Erlang/OTP supervisor semantics.)
RMAX="${MESH_SUP_MAXR:-5}"; RWIN="${MESH_SUP_WINSEC:-600}"
ok_to_restart(){  # $1=name → 0 = restart allowed; 1 = storming (skip + alert once)
  local name="$1" f="$MESH/.sup-restarts-$name" now cnt; now=$(date +%s)
  { [ -f "$f" ] && awk -v n="$now" -v w="$RWIN" '($1+w)>n' "$f"; echo "$now"; } > "$f.tmp" 2>/dev/null && mv "$f.tmp" "$f"
  cnt=$(wc -l < "$f" 2>/dev/null || echo 1)
  if [ "$cnt" -gt "$RMAX" ]; then
    local sf="$MESH/.sup-storm-$name"
    if [ ! -f "$sf" ]; then
      echo "$(stamp) STORM $name: $cnt restarts in ${RWIN}s — STOP restarting (persistent fault, escalating)" >> "$LOG"
      command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="supervise@$(hostname)" \
        mesh-chat "[storm] $(hostname): $name restart-storm ($cnt× in ${RWIN}s) — supervisor STOPPED auto-restart (persistent fault, needs a mind). OTP restart-intensity." >/dev/null 2>&1
      touch "$sf"
    fi
    return 1
  fi
  rm -f "$MESH/.sup-storm-$name" 2>/dev/null   # healthy → clear any storm flag
  return 0
}

# cause-of-death lookup (chat-review/wire-kill-events, consumer of mesh-kill-events' tape): a dead
# child restarted here otherwise gets no explanation in the log — was it OOM-killed, did it segfault,
# or just exit cleanly? ~/.mesh/kill-events.log names the kernel-killed victim/pid/kind; match its
# recorded victim comm against this child's pgrep pattern or registry name (best-effort substring —
# false negative if neither string contains the comm is fine, this is forensic enrichment not a gate).
KILL_TAPE="${MESH_KILL_EVENTS_TAPE:-$MESH/kill-events.log}"
kernel_cause(){ # $1=pgrep-pattern $2=name -> " (cause: kind=oom pid=1234, 42s ago)" or "" if none found
  local pat="$1" name="$2" window="${MESH_SUP_CAUSE_WINDOW:-1800}" now line victim vts vepoch age kind pid
  [ -r "$KILL_TAPE" ] || return 0
  now=$(date +%s)
  while IFS= read -r line; do
    victim="$(printf '%s' "$line" | grep -oE 'victim=[^ ]+' | cut -d= -f2)"
    [ -n "$victim" ] || continue
    case "$pat" in *"$victim"*) ;; *) case "$name" in *"$victim"*) ;; *) continue ;; esac ;; esac
    vts="$(printf '%s' "$line" | awk '{print $1}')"
    vepoch="$(date -d "$vts" +%s 2>/dev/null)" || continue
    age=$(( now - vepoch ))
    [ "$age" -ge 0 ] && [ "$age" -le "$window" ] || continue
    kind="$(printf '%s' "$line" | grep -oE 'kind=[a-z]+' | cut -d= -f2)"
    pid="$(printf '%s' "$line" | grep -oE 'pid=[0-9]+' | cut -d= -f2)"
    printf ' (cause: kind=%s pid=%s, %ss ago)' "$kind" "$pid" "$age"
    return 0
  done < <(tail -n 200 "$KILL_TAPE" 2>/dev/null | tac)
}

# ── THE SIGNAL PLANE (2026-08-29, task supervise-death-cannot-name-a-userspace-signal) ────────────
# kernel_cause above can name exactly TWO things, oom and segv, because its only evidence is
# mesh-kill-events — a kernel journal tap scoped to those two kinds and nothing else (10848 oom + 11
# segv across its whole corpus). A TERM or KILL from a USERSPACE process writes nothing to dmesg, so
# a group-killed child rendered identically to a clean exit, a hang-reap, or one that fell over. That
# is an exclusion allowlist whose failure direction is SILENCE, and it is why a four-children-died-
# together episode could not be answered at all.
# The kernel's signal_generate tracepoint is out of reach here (perf_event_paranoid=4 — perf, bpf and
# auditd are all root-only on this node), so the second plane is trap-side: each supervised child now
# writes a note naming the signal it is dying on, and this reads it.
DEATH_TAPE="${MESH_DEATH_TAPE:-$MESH/supervise-deaths.log}"
death_note(){ # $1=registry name -> "signal=TERM pid=123, 4s ago", rc 1 if no note in window
  local name="$1" window="${MESH_SUP_CAUSE_WINDOW:-1800}" now line ts epoch age sig pid
  [ -r "$DEATH_TAPE" ] || return 1
  now=$(date +%s)
  while IFS= read -r line; do
    # anchored on the whole field: a bare substring would let 'dram-bw' match 'dram-bw-sampler' and
    # attribute one child's death to another — the cheapest way to turn this plane into a liar.
    case "$line" in *" tool=$name "*) ;; *) continue ;; esac
    ts="$(printf '%s' "$line" | awk '{print $1}')"
    epoch="$(date -d "$ts" +%s 2>/dev/null)" || continue
    age=$(( now - epoch ))
    [ "$age" -ge 0 ] && [ "$age" -le "$window" ] || continue
    sig="$(printf '%s' "$line" | grep -oE 'sig=[A-Z0-9]+' | cut -d= -f2)"
    pid="$(printf '%s' "$line" | grep -oE 'pid=[0-9]+' | cut -d= -f2)"
    [ -n "$sig" ] || continue          # a note that cannot name its signal is not a naming
    printf 'signal=%s pid=%s, %ss ago' "$sig" "$pid" "$age"
    return 0
  done < <(tail -n 200 "$DEATH_TAPE" 2>/dev/null | tac)
  return 1
}
# Is this child even ABLE to leave a note? The silences are different and must not share a word.
#
# THIS CHECK ONCE READ THE DISK AND WAS WRONG ON ITS FIRST LIVE DRIVE (2026-08-29, this task). It did
# `command -v <tool>` then grepped that FILE for 'death-note' — a question about a file on disk,
# standing in for a claim about a PROCESS. Every one of this node's four supervised children was
# started at 07:48Z and the trap was deployed at 10:50Z, so all four were running text that had never
# heard of the signal plane, and all four read ARMED. Driven: a real SIGTERM to the live
# dram-bw-sampler produced no note and the log said "this child IS armed, so the likely causes are
# SIGKILL … or a death before the trap was installed" — two confident hypotheses, both false, with the
# true one (the running text predates the trap) not among them. A LANDED AND DEPLOYED FIX IS NOT A
# LOADED ONE, and a long-lived supervised loop is exactly where those come apart.
#
# So arming is decided from the RUNNING child — and it must be recorded WHILE IT IS UP, because at
# cause-of-death time the pid is gone and nothing about it can be read any more. /proc/<pid>'s own
# mtime is the process start time (verified against `ps -o lstart=` on this node, to the second); a
# start older than the binary's mtime means the text in memory is not the text on disk.
# Four words, four different remedies, and NONE of them may be silence:
#   armed      — running text carries the trap: a missing note means SIGKILL, or a handler deferred
#                behind a foreground command.
#   stale-text — the plane is deployed but this process never loaded it. Restart arms it.
#   unarmed    — the tool has no death-note trap at all. The plane is absent here, not quiet.
#   unobserved — the supervisor never saw this child UP, so its arming is unknown. Never "armed".
arming_observe(){ # $1=name $2=pgrep-pattern $3=live pids — record what the RUNNING child can do
  local name="$1" pat="$2" pids="$3" tool bin word bmt='' pst oldest='' p
  tool="${pat%% *}"
  bin="$(command -v "$tool" 2>/dev/null)"
  if [ -z "$bin" ] || [ ! -r "$bin" ] || ! grep -q 'death-note' "$bin" 2>/dev/null; then
    word=unarmed
  else
    bmt="$(stat -c %Y "$bin" 2>/dev/null)" || bmt=''
    # the OLDEST live instance decides: if ANY running copy predates the deployed trap, this child's
    # signal plane is not something the supervisor may claim.
    for p in $pids; do
      pst="$(stat -c %Y "/proc/$p" 2>/dev/null)" || continue
      [ -n "$pst" ] || continue
      if [ -z "$oldest" ] || [ "$pst" -lt "$oldest" ]; then oldest="$pst"; fi
    done
    # STRICTLY newer. /proc mtimes are whole seconds, so a child that started in the same second the
    # binary was deployed is genuinely undecidable — and "armed" is the optimistic word, which is the
    # wrong direction for something whose whole job is publishing a blind spot. A tie therefore reads
    # stale-text, whose remedy (restart it) is correct and harmless under either truth.
    if   [ -z "$bmt" ] || [ -z "$oldest" ]; then word=unobserved
    elif [ "$oldest" -gt "$bmt" ];          then word=armed
    else                                          word=stale-text; fi
  fi
  printf '%s started=%s deployed=%s seen=%s\n' "$word" \
    "$( [ -n "$oldest" ] && date -u -d "@$oldest" +%FT%TZ || echo n/a )" \
    "$( [ -n "$bmt" ]    && date -u -d "@$bmt"    +%FT%TZ || echo n/a )" \
    "$(stamp)" > "$MESH/.sup-armed-$name" 2>/dev/null || true
}
arming_recall(){ # $1=name -> the recorded line, or 'unobserved' — deliberately NOT cleared on restart:
  # it is the last thing known about the incarnation that just died, and the next UP pass overwrites it.
  local f="$MESH/.sup-armed-$1"
  [ -r "$f" ] && [ -s "$f" ] && { head -1 "$f"; return 0; }
  printf 'unobserved started=n/a deployed=n/a seen=never\n'
}
# THE ARBITER. Order matters: the kernel plane is authoritative where it speaks (it sees deaths no
# trap can), the note plane covers the userspace signals the kernel is silent about, and what is left
# is rendered as an EXPLICIT abstention that names which plane was blind. It never invents a cause —
# UNKNOWN-SIGNAL asserts nothing about how the child died — but it never returns silence either,
# because silence is precisely what made a real kill indistinguishable from a clean exit.
cause_of_death(){ # $1=pgrep-pattern $2=name
  local k n arm word rest
  k="$(kernel_cause "$1" "$2" 2>/dev/null)"
  [ -n "$k" ] && { printf '%s' "$k"; return 0; }
  if n="$(death_note "$2" 2>/dev/null)"; then
    printf ' (cause: %s, self-reported)' "$n"; return 0
  fi
  arm="$(arming_recall "$2")"; word="${arm%% *}"; rest="${arm#* }"
  case "$word" in
    armed)      printf ' (cause: UNKNOWN-SIGNAL — no kernel oom/segv and no death note, and this child WAS observed running armed text (%s), so the likely causes are SIGKILL, which runs no trap by construction, or a handler deferred behind a foreground command)' "$rest" ;;
    stale-text) printf ' (cause: UNKNOWN-SIGNAL — no kernel oom/segv and no death note, and this child was running text OLDER than its own deployed trap (%s): the signal plane was DEPLOYED but never LOADED by this process, so no signal it received could ever have been named. A restart arms it.)' "$rest" ;;
    unarmed)    printf ' (cause: UNKNOWN-SIGNAL — no kernel oom/segv, and this child carries NO death-note trap at all, so no userspace signal can be named for it; the signal plane is absent here, not quiet)' ;;
    *)          printf ' (cause: UNKNOWN-SIGNAL — no kernel oom/segv and no death note, and the supervisor never observed this child UP (%s), so whether it could name a signal at all is unknown)' "$rest" ;;
  esac
  return 0
}

# OTP-style exit-signal BROADCAST (STUDY Erlang/OTP supervision, idea-queue 2026-07-19):
# In Erlang, `link/1` + `process_flag(trap_exit, true)` means a supervisor traps a child's exit
# signal and DELIVERS it to every linked process — siblings learn "X died", and in distributed
# Erlang the same signal crosses node boundaries via `monitor_node/2`. Our supervisor had only
# the local half of this: detect dead child → restart → write to supervise.log. NO sibling knew,
# no peer node knew — the operator and other minds found out by accident (pane stale, board
# quiet). Each supervisor was an isolated tree. This function is the missing broadcast.
#
# Implementation: on a DOWN→RESTART transition we (a) post a [restart] line to the local
# mesh-chat board — the bus the other minds on THIS node already read (the local-link analog),
# and (b) fan the same message out to each declared peer mind-node via `mesh-tell --node chat`
# — the cross-node analog. Once per down-transition: a `.sup-announced-$name` flag is touched
# on first announce and only cleared by `clear_announce` when the child returns UP, so a child
# that stays down across N cron polls announces ONCE (the OTP rule is "each exit signal is
# delivered", not "delivered per poll" — a long death is still one death).
#
# Skipped when MESH_SUP_NOTIFY=0 (test isolation). Skipped in --status (dry-run). Skipped on
# the [storm] path (ok_to_restart already broadcasts there). Cross-node fan-out is best-effort:
# any peer error is swallowed — an unreachable peer must never delay the local restart.
MESH_SUP_NOTIFY="${MESH_SUP_NOTIFY:-1}"
announce_down(){  # $1=name $2=cod  (cod includes leading " (cause: ...)" or "")
  [ "$MESH_SUP_NOTIFY" = 1 ] || return 0
  local name="$1" cod="$2" af="$MESH/.sup-announced-$name" msg
  [ -f "$af" ] && return 0   # already announced this down-period — OTP: one exit signal per death
  msg="[restart] $(hostname): supervised '$name' died${cod} — supervisor restarting. OTP link-broadcast."
  command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="supervise@$(hostname)" mesh-chat "$msg" >/dev/null 2>&1 || true
  touch "$af"
  # Peer fan-out — distributed-Erlang analog (monitor_node): the same exit signal crosses to
  # peer mind-nodes so a peer's room/tg/health learns its sibling on this node just died.
  # MESH_SUP_PEERS overrides the peer list (test fixture); default pulls MESH_NODES from
  # ~/.mesh/nodes. Bare peer names — mesh-tell resolves via mesh-peer-addr.
  command -v mesh-tell >/dev/null 2>&1 || return 0
  local self line peers p
  self="$(hostname)"
  peers="${MESH_SUP_PEERS:-}"
  if [ -z "$peers" ] && [ -r "${MESH_SUP_NODES_FILE:-$HOME/.mesh/nodes}" ]; then
    peers="$(grep -oE 'MESH_NODES="[^"]*"' "${MESH_SUP_NODES_FILE:-$HOME/.mesh/nodes}" | head -1 | sed -E 's/^MESH_NODES="//; s/"$//')"
  fi
  for p in $peers; do
    p="${p%%:*}"
    [ -n "$p" ] && [ "$p" != "$self" ] || continue
    timeout 15 mesh-tell --node "$p" chat "$msg" >/dev/null 2>&1 || true
  done
}
announce_halted(){  # $1=name $2="<n>/<total> <reason>" — a child that exists but cannot run
  # One signal per HALT EPISODE, same rule as a death (the caller owns the .sup-halted-<name> flag).
  # Routed to the board rather than the trace: unlike a crash, nothing here will fix it — the
  # supervisor deliberately does not thaw (see pid_halted), so a mind has to look.
  [ "$MESH_SUP_NOTIFY" = 1 ] || return 0
  command -v mesh-chat >/dev/null 2>&1 || return 0
  MESH_WHO="supervise@$(hostname)" mesh-chat "[halted] $(hostname): supervised '$1' is $2 — the process EXISTS and reads UP to every liveness view, and executes nothing. Supervisor did NOT restart it (thawing races whoever froze it, and a SIGTERM-trapping child cannot run its handler while frozen). Needs a mind: find the writer, then thaw or kill -9." >/dev/null 2>&1 || true
}
clear_announce(){  # $1=name — child back UP: clear the flag so the next death re-announces
  rm -f "$MESH/.sup-announced-$1" 2>/dev/null || true
}

while IFS='|' read -r name pat start; do
  name="${name#"${name%%[![:space:]]*}"}"; name="${name%"${name##*[![:space:]]}"}"   # trim
  case "$name" in ''|\#*) continue;; esac
  pat="$(printf '%s' "$pat" | xargs)"; start="$(printf '%s' "$start" | xargs)"
  pids="$(child_pids "$pat" "$start")"
  if [ -n "$pids" ]; then
    # Record what the LIVE child can do, while it is still alive to be asked — after it dies nothing
    # about it is readable, and a disk-only answer is how this leg called four unarmed children armed.
    # Skipped on --status: that is a dry-run and writes nothing.
    [ "$STATUS" = 1 ] || arming_observe "$name" "$pat" "$pids"
    # HALTED check FIRST: a frozen/stopped child passes every test below it (its beat may even be
    # fresh if it was frozen seconds ago), so this must be asked before "is it up". See pid_halted().
    halt="$(halted_pids "$pids")"
    if [ -n "$halt" ]; then
      if [ "$STATUS" = 1 ]; then echo "  FROZEN $name  ($halt — exists but cannot run; NOT restarted)"
      else
        hf="$MESH/.sup-halted-$name"
        if [ ! -f "$hf" ]; then
          echo "$(stamp) HALTED $name ($halt) [pids: $(echo $pids)] — exists but cannot run; report-only, NOT restarted" >> "$LOG"
          announce_halted "$name" "$halt"
          touch "$hf"
        fi
      fi
      continue
    fi
    rm -f "$MESH/.sup-halted-$name" 2>/dev/null   # runnable again → re-arm the halt signal
    # WEDGED check: process is up, but if it publishes a liveness beat and the beat is stale
    # (>1800s, longer than any loop interval), the loop is hung — restart it (intel audit 2026-06-10)
    beat="$MESH/$name.beat"
    if [ -f "$beat" ] && [ $(( $(date +%s) - $(stat -c %Y "$beat") )) -gt 1800 ]; then
      if [ "$STATUS" = 1 ]; then echo "  WEDGED $name  (beat stale, would restart: $start)"
      elif ok_to_restart "$name"; then
        echo "$(stamp) WEDGED $name (beat stale) -> kill+restart $start [pids: $(echo $pids)]" >> "$LOG"
        # by PID, never `pkill -f -- "$pat"`: the kill direction of the same blindness is worse than
        # the read direction — it reaps every shell, pane or mesh-tell whose cmdline merely MENTIONS
        # the pattern, including the operator's own (memory: pkill-f-kills-its-own-wrapper-shell).
        kill $pids 2>/dev/null
        setsid bash -lc "$start" 9>&- >/dev/null 2>&1 &
        announce_down "$name" " (wedged: beat stale)"
      fi
    else
      [ "$STATUS" = 1 ] && echo "  UP   $name"
      clear_announce "$name"   # child back UP — re-arm announce for the next death
    fi
  elif [ "$STATUS" = 1 ]; then echo "  DOWN $name  (would restart: $start)"
  elif ok_to_restart "$name"; then
    cod="$(cause_of_death "$pat" "$name" 2>/dev/null)"
    echo "$(stamp) RESTART $name (was dead)${cod} -> $start" >> "$LOG"
    setsid bash -lc "$start" 9>&- >/dev/null 2>&1 &   # start-cmd is trusted local config (operator/steward-owned)
    announce_down "$name" "$cod"
  fi
done < "$REG"
[ "$STATUS" = 1 ] && exit 0 || true
# Clean pass (all children checked, no early-exit): refresh the liveness heartbeat. NOT reached on
# --status, flock-SKIP, or absent-registry FAIL — those are dry-run / not-this-run / broken-state.
touch "$HB"
