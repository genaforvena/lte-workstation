#!/usr/bin/env bash
# orphan-ok: on-demand camera ORGAN (operator/mind-invoked single-frame capture; the shutter is an
#   ACTUATOR side-effect — screen wakes, shutter sound — so never cron-wire it, and its --test
#   defaults to read-only reachability asserts, full capture only under MESH_NOTE3_CAM_TEST_CAPTURE=1)
# mesh-note3-cam — pull ONE real JPEG frame from the Note 3 (SM-N900, Android 5.0, ADB-only body).
#
# HOW (no APK sideload — stock Samsung camera, proven live 2026-07-06 18:49Z, 2.6MB 4128x2322 frame):
#   wake (keyevent 224) → am start com.sec.android.app.camera/.Camera → WAIT FOR FOCUS: on this
#   Android 5 body `input keyevent 82` does NOT dismiss the swipe keyguard (mCurrentFocus stays
#   StatusBar and a queued shutter fires only minutes later — the 21:53 ghost frame); an `input
#   swipe` up does, so swipe ONLY while focus ≠ camera (a blind swipe on a focused viewfinder
#   flips Samsung camera modes) → shutter (KEYCODE_CAMERA 27) → poll DCIM for a file NEWER than
#   the pre-capture newest (name-sorted; Samsung names are timestamps) → size-stable check (file
#   may still be writing) → adb pull → rm from phone (don't silt its storage) → screen off (26).
#   The pre/post diff is load-bearing: pulling the pre-existing newest would pass a STALE frame
#   off as a live capture — never do that.
#
# Read path (mesh-baro ADB-relay convention): the phone hangs off ds over USB/tcp; any node runs this
# by relaying adb over SSH. Node-local config in ~/.mesh/nodes (never hardcode topology in genome):
#   MESH_NOTE3_ADB_NODE    local | user@ip of the adb-hosting node   (default: local)
#   MESH_NOTE3_ADB_SERIAL  adb serial                                 (default: 4d00553d61ab90b7)
#   MESH_NOTE3_CAM_SETTLE  seconds for camera app focus/settle        (default: 4)
#
# Honest contract: adb node/phone unreachable → exit 2 (honest n/a, mesh-land passes it);
# phone REACHABLE but no NEW verified-JPEG frame → exit 1 (a real defect, not an n/a).
#
#   mesh-note3-cam [out.jpg]   capture one frame (default ~/.mesh/note3-cam-last.jpg)
#   mesh-note3-cam --test      read-only asserts (device+camera-pkg+DCIM real reads);
#                              MESH_NOTE3_CAM_TEST_CAPTURE=1 adds the full capture gate
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes" 2>/dev/null || true

NODE="${MESH_NOTE3_ADB_NODE:-local}"
SER="${MESH_NOTE3_ADB_SERIAL:-4d00553d61ab90b7}"
SETTLE="${MESH_NOTE3_CAM_SETTLE:-4}"
DCIM="/sdcard/DCIM/Camera"
CAM_PKG="com.sec.android.app.camera"

# node_sh <cmd...> — run on the adb-hosting node (local or over SSH). Android 5.0's toybox lacks
# head/tail, so all sorting/parsing happens on OUR side; remote commands stay primitive.
node_sh() {
  if [ "$NODE" = local ]; then bash -c "$1"
  else ssh -o BatchMode=yes -o ConnectTimeout=6 "$NODE" "$1"; fi
}
adb_sh() { node_sh "adb -s $SER shell '$1'"; }

is_jpeg() { [ -s "$1" ] && [ "$(od -An -tx1 -N3 "$1" 2>/dev/null | tr -d ' ')" = ffd8ff ]; }

newest_frame() { adb_sh "ls $DCIM/ 2>/dev/null" | tr -d '\r' | grep -E '\.jpg$' | sort | tail -1; }

phone_up() { node_sh "adb devices 2>/dev/null" | grep -q "^$SER[[:space:]]*device"; }

if [ "${1:-}" = --test ]; then
  f=0
  # offline fixture: the JPEG-magic gate must pass real magic and reject non-JPEG bytes.
  tj="$(mktemp)"; printf '\xff\xd8\xff\xe0fixture' > "$tj"
  is_jpeg "$tj" || { echo "  FAIL: is_jpeg must accept ffd8ff magic"; f=1; }
  printf 'not a jpeg' > "$tj"
  is_jpeg "$tj" && { echo "  FAIL: is_jpeg must reject non-JPEG bytes"; f=1; }
  rm -f "$tj"
  [ "$f" != 0 ] && { echo "smoke-test: FAIL"; exit 1; }
  # live gate (read-only — the shutter is an actuator, not exercised by default):
  phone_up || { echo "smoke-test: n/a (Note 3 not attached on $NODE — honest unreachable)"; exit 2; }
  adb_sh "pm list packages $CAM_PKG" | grep -q "$CAM_PKG" \
    || { echo "smoke-test: FAIL (camera package $CAM_PKG missing on reachable phone)"; exit 1; }
  adb_sh "ls $DCIM/.. 2>/dev/null" | grep -q . \
    || { echo "smoke-test: FAIL (DCIM not listable on reachable phone — hollow organ)"; exit 1; }
  if [ "${MESH_NOTE3_CAM_TEST_CAPTURE:-0}" = 1 ]; then
    out="$(mktemp -u --suffix=.jpg)"
    "$0" "$out" >/dev/null || { echo "smoke-test: FAIL (full capture gate produced no frame)"; exit 1; }
    is_jpeg "$out" || { echo "smoke-test: FAIL (capture gate: not a JPEG)"; exit 1; }
    rm -f "$out"
    echo "smoke-test: ok (2 magic fixtures + live pkg/DCIM reads + FULL capture gate)"; exit 0
  fi
  echo "smoke-test: ok (2 magic fixtures + live device/pkg/DCIM reads; capture gate off — actuator)"; exit 0
fi

OUT="${1:-$HOME/.mesh/note3-cam-last.jpg}"
mkdir -p "$(dirname "$OUT")"

phone_up || { echo "[note3-cam] UNREACHABLE — Note 3 not attached on $NODE"; exit 2; }

pre="$(newest_frame)"
adb_sh "input keyevent 224; am start -n $CAM_PKG/.Camera" >/dev/null 2>&1
# wait until the camera actually HOLDS focus; swipe-dismiss the keyguard only while it doesn't
# (StatusBar focus = lockscreen up; a shutter sent then is silently queued — the ghost-frame bug).
focused=0
for _ in 1 2 3 4 5 6 7 8; do
  if adb_sh "dumpsys window windows | grep mCurrentFocus" | grep -q "$CAM_PKG"; then focused=1; break; fi
  adb_sh "input swipe 540 1600 540 300 200" >/dev/null 2>&1
  sleep 1
done
[ "$focused" = 1 ] || { adb_sh "input keyevent 26" >/dev/null 2>&1
                        echo "[note3-cam] FAIL — camera never took focus (keyguard held?)"; exit 1; }
sleep "$SETTLE"
adb_sh "input keyevent 27" >/dev/null 2>&1

# poll for a frame newer than the pre-capture newest; then require its size stable across 1s
# (Samsung writes in place — an early pull truncates the JPEG).
new=""; tries=0
while [ "$tries" -lt 14 ]; do
  cand="$(newest_frame)"
  if [ -n "$cand" ] && [ "$cand" != "$pre" ]; then new="$cand"; break; fi
  tries=$((tries+1)); sleep 1
done
[ -n "$new" ] || { adb_sh "input keyevent 26" >/dev/null 2>&1
                   echo "[note3-cam] FAIL — shutter fired but no new frame appeared in $DCIM"; exit 1; }
sz1=""; sz2=""
for _ in 1 2 3 4 5; do
  sz1="$(adb_sh "ls -l $DCIM/$new" | tr -d '\r' | awk '{print $4}')"
  sleep 1
  sz2="$(adb_sh "ls -l $DCIM/$new" | tr -d '\r' | awk '{print $4}')"
  [ -n "$sz1" ] && [ "$sz1" = "$sz2" ] && break
done

tmp_remote="/tmp/note3-cam-pull-$$.jpg"
if [ "$NODE" = local ]; then
  adb -s "$SER" pull "$DCIM/$new" "$OUT" >/dev/null 2>&1
else
  node_sh "adb -s $SER pull $DCIM/$new $tmp_remote" >/dev/null 2>&1
  scp -q -o BatchMode=yes "$NODE:$tmp_remote" "$OUT" 2>/dev/null
  node_sh "rm -f $tmp_remote" 2>/dev/null
fi
adb_sh "rm $DCIM/$new; input keyevent 26" >/dev/null 2>&1

is_jpeg "$OUT" || { echo "[note3-cam] FAIL — pulled artifact is not a valid JPEG"; exit 1; }
echo "[note3-cam] frame: $OUT ($(stat -c %s "$OUT") bytes, phone-file $new)"
exit 0
