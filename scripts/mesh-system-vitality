#!/usr/bin/env bash
# reflex-cadence: 2-59/15 * * * *
# reflex-args: --edge
# mesh-system-vitality — cross-sense fusion: IS THIS NODE'S HARDWARE HEALTHY AS A WHOLE?
# Combines 4 hardware-health senses into a single vitality verdict no single sensor gives.
#
# Inputs (all best-effort, each independently OFFLINE-able; 2+ missing → DEGRADED):
#   mesh-node-health     .node-health-state      HEALTHY|DEGRADED|CRITICAL|UNKNOWN
#   mesh-battery         .battery-state          HEALTHY|AGED|CRITICAL|ON_BATTERY|LOW_BATTERY|CHARGING|FULL|NO_BATTERY|OFFLINE
#   mesh-cpufreq         .cpufreq-state          NOMINAL|BOOST|REDUCED|THROTTLED|IDLE|OFFLINE
#   mesh-disk-latency    .disk-latency-state     FAST|NORMAL|SLOW|STALLED|UNKNOWN|OFFLINE
#
# Why this fusion is NEW (not duplicating mesh-node-health):
#   - mesh-node-health fuses 4 senses about CPU/CRYPTO/NETWORK (entropy/sockstat/swap/loadavg) — it
#     answers "is the kernel-software subsystem healthy?" (entropy, sockets, swapping, CPU load).
#   - mesh-system-vitality adds the THREE missing hardware axes:
#       1. POWER       (mesh-battery: node's own battery health, wear level, on-mains/on-battery)
#       2. THERMAL     (mesh-cpufreq: actual CPU clock state — boost, nominal, reduced, throttled)
#       3. STORAGE     (mesh-disk-latency: I/O completion time — fast, normal, slow, stalled)
#   - These axes are distinct from node-health (which is software-resource-oriented). A node can
#     have healthy entropy + sockets + swap + loadavg AND STILL be in trouble (battery worn,
#     CPU thermally throttled, disk slow) — mesh-system-vitality catches what node-health misses.
#
# Bands (FALSIFIABLE: change a band rule → test flips):
#   CRITICAL      any input is CRITICAL or THROTTLED or STALLED        — nature follows source:
#                                                                    hardware axis → imminent hardware failure
#                                                                    node-health → software/kernel exhaustion
#   DEGRADED      any input is DEGRADED/AGED/LOW_BATTERY/SLOW/REDUCED  — 1+ subsystem suboptimal
#   HEALTHY       all 4 inputs nominal                                — node's hardware is healthy
#   DEGRADED      2+ inputs OFFLINE (can't assess vitality)            — explicitly different from HEALTHY
#   DEGRADED      1 input OFFLINE (1-missing)                           — partial degradation
#   TRANSITION    any input is INITIAL (cold-start, not yet read)        — first observation
#
#   mesh-system-vitality        one-shot verdict to stdout
#   mesh-system-vitality --edge emit only on verdict change (cron reflex)
#   mesh-system-vitality --json machine-readable {label, reason, inputs, ts}
#   mesh-system-vitality --test smoke test (pure classifier, no state-file reads)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

STATE="$HOME/.mesh/.system-vitality-state"
MESH="${MESH_DIR:-$HOME/.mesh}"
STALE_S=1800  # 30min — generous enough for mesh-battery (*/15) which is the longest cadence

# Severity ranks (higher = worse). Used for the "worst-of" classification.
# CRITICAL=4, DEGRADED-tier (3), GOOD-tier (2), unknown=1, offline=0.
severity() {
  case "$1" in
    CRITICAL|THROTTLED|STALLED)                   echo 4 ;;
    DEGRADED|AGED|LOW_BATTERY|SLOW|REDUCED)       echo 3 ;;
    HEALTHY|NOMINAL|FAST|ON_BATTERY|CHARGING|FULL|NO_BATTERY) echo 2 ;;
    INITIAL|TRANSITION)                          echo 2 ;;  # cold-start, treat as nominal for max
    UNKNOWN|NORMAL)                              echo 2 ;;  # nominal-ish
    IDLE|BOOST)                                   echo 2 ;;  # nominal
    OFFLINE)                                     echo 0 ;;
    *)                                            echo 1 ;;  # unrecognized → treat as low
  esac
}

# --- read helpers (all return OFFLINE on missing/stale/unreadable) ---
read_node_health() {
  local f="$1" v now m
  [ -f "$f" ] || { echo "OFFLINE"; return; }
  now=$(date +%s); m=$(stat -c %Y "$f" 2>/dev/null || echo "$now")
  if [ $((now - m)) -gt "$STALE_S" ]; then echo "OFFLINE"; return; fi
  v="$(head -1 "$f" 2>/dev/null | cut -d'|' -f1)"
  case "$v" in
    HEALTHY|DEGRADED|CRITICAL|UNKNOWN) printf '%s' "$v" ;;
    *) echo "OFFLINE" ;;
  esac
}
read_battery() {
  local f="$1" v now m
  [ -f "$f" ] || { echo "OFFLINE"; return; }
  now=$(date +%s); m=$(stat -c %Y "$f" 2>/dev/null || echo "$now")
  if [ $((now - m)) -gt "$STALE_S" ]; then echo "OFFLINE"; return; fi
  v="$(head -1 "$f" 2>/dev/null | cut -d'|' -f1)"
  case "$v" in
    HEALTHY|AGED|CRITICAL|ON_BATTERY|LOW_BATTERY|CHARGING|FULL|NO_BATTERY) printf '%s' "$v" ;;
    *) echo "OFFLINE" ;;
  esac
}
read_cpufreq() {
  local f="$1" v now m
  [ -f "$f" ] || { echo "OFFLINE"; return; }
  now=$(date +%s); m=$(stat -c %Y "$f" 2>/dev/null || echo "$now")
  if [ $((now - m)) -gt "$STALE_S" ]; then echo "OFFLINE"; return; fi
  v="$(head -1 "$f" 2>/dev/null | cut -d'|' -f1)"
  case "$v" in
    NOMINAL|BOOST|REDUCED|THROTTLED|IDLE) printf '%s' "$v" ;;
    *) echo "OFFLINE" ;;
  esac
}
read_disk_latency() {
  local f="$1" v now m
  [ -f "$f" ] || { echo "OFFLINE"; return; }
  now=$(date +%s); m=$(stat -c %Y "$f" 2>/dev/null || echo "$now")
  if [ $((now - m)) -gt "$STALE_S" ]; then echo "OFFLINE"; return; fi
  v="$(head -1 "$f" 2>/dev/null | cut -d'|' -f1)"
  case "$v" in
    FAST|NORMAL|SLOW|STALLED) printf '%s' "$v" ;;
    *) echo "OFFLINE" ;;
  esac
}
# read_cpu_temp_band → HOT|CALM|"" — corroborator for the cpufreq=THROTTLED CRITICAL gate.
# Reads the CPU package temp (x86_pkg_temp thermal zone, else the hottest CPU-ish zone) live from
# sysfs. HOT (≥ MESH_VITALITY_CPU_HOT, default 82°C ≈ within ~8°C of the 90°C crit) = a genuine
# thermal emergency where a THROTTLED clock IS the failure edge. CALM = cold silicon, so a low
# clock is a held cap, not an emergency. "" (temp unreadable) = unknown → conservative, leaves
# THROTTLED escalating to CRITICAL.
read_cpu_temp_band() {
  local hot="${MESH_VITALITY_CPU_HOT:-82}" t="" mc=-1 z ztype zt
  # prefer the package sensor; fall back to hottest x86/coretemp/SEN zone
  for z in /sys/class/thermal/thermal_zone*; do
    [ -r "$z/temp" ] || continue
    ztype="$(cat "$z/type" 2>/dev/null)"
    zt="$(cat "$z/temp" 2>/dev/null)"; case "$zt" in ''|*[!0-9]*) continue ;; esac
    if [ "$ztype" = "x86_pkg_temp" ]; then t="$zt"; break; fi
    case "$ztype" in x86_pkg_temp|*coretemp*|B0D4|SEN*) [ "$zt" -gt "$mc" ] && mc="$zt" ;; esac
  done
  [ -z "$t" ] && [ "$mc" -ge 0 ] && t="$mc"
  [ -z "$t" ] && { printf ''; return; }
  t=$(( t / 1000 ))
  if [ "$t" -ge "$hot" ]; then printf 'HOT'; else printf 'CALM'; fi
}

# --- classifier (pure, offline-testable) ---
# classify_vitality <node_health> <battery> <cpufreq> <disk> [therm] → "LABEL|reason"
# pure, offline-testable. therm (optional 5th arg: HOT|CALM|"") corroborates cpufreq=THROTTLED
# the same way psi-memory corroborates swap in mesh-node-health (cdc7693): a low cur/max freq
# ratio reads THROTTLED whether it is an ACTIVE thermal emergency OR a HELD cap (thermald /
# intel_pstate pinning scaling_max_freq to shed steady-state heat) — the latter is the mitigation
# WORKING, not "imminent hardware failure". So THROTTLED only escalates to CRITICAL when the CPU is
# actually hot right now (therm=HOT); therm=CALM downgrades it to DEGRADED; therm="" (unknown, e.g.
# legacy 4-arg callers) keeps the conservative THROTTLED→CRITICAL.
classify_vitality() {
  local nh="$1" bat="$2" cpu="$3" dsk="$4" therm="${5:-}"
  # cpufreq=THROTTLED downgrade gate: a THROTTLED-by-ratio verdict with a genuinely cold CPU is a
  # held cap / power-saving, not an emergency (you cannot be throttling toward failure at 50°C).
  local cpu_downgraded=0
  if [ "$cpu" = "THROTTLED" ] && [ "$therm" = "CALM" ]; then cpu_downgraded=1; fi
  # 1. Count OFFLINE inputs — explicit missing list, prioritize this over classification so the
  # consumer sees "we don't know" rather than a confident (and possibly wrong) "DEGRADED".
  local missing=""
  [ "$nh"  = "OFFLINE" ] && missing="${missing}node-health,"
  [ "$bat" = "OFFLINE" ] && missing="${missing}battery,"
  [ "$cpu" = "OFFLINE" ] && missing="${missing}cpufreq,"
  [ "$dsk" = "OFFLINE" ] && missing="${missing}disk-latency,"
  missing="${missing%,}"
  local degen=0
  [ "$nh"  = "OFFLINE" ] && degen=$((degen+1))
  [ "$bat" = "OFFLINE" ] && degen=$((degen+1))
  [ "$cpu" = "OFFLINE" ] && degen=$((degen+1))
  [ "$dsk" = "OFFLINE" ] && degen=$((degen+1))
  if [ "$degen" -ge 2 ]; then
    echo "DEGRADED|missing: $missing (2+ inputs offline — can't assess vitality)"
    return
  fi
  if [ "$degen" -eq 1 ]; then
    echo "DEGRADED|missing: $missing (1 input offline, can't fully assert)"
    return
  fi
  # 2. CRITICAL: any input is CRITICAL-tier. Label follows the NATURE of the critical source —
  # hardware axes (battery/cpufreq-thermal/disk) escalate to 'imminent hardware failure',
  # node-health (software: swap/entropy/loadavg) to 'software/kernel exhaustion'. Conflating
  # them mislabels an OOM/swap-CRITICAL as hardware failure (health 2026-07-19 00:58Z live).
  if [ "$nh" = "CRITICAL" ] || [ "$bat" = "CRITICAL" ] || [ "$bat" = "LOW_BATTERY" ] || { [ "$cpu" = "THROTTLED" ] && [ "$cpu_downgraded" = 0 ]; } || [ "$dsk" = "STALLED" ]; then
    local why=""
    [ "$nh"  = "CRITICAL"    ] && why="${why}node-health=CRITICAL,"
    [ "$bat" = "CRITICAL"    ] && why="${why}battery=CRITICAL,"
    [ "$bat" = "LOW_BATTERY" ] && why="${why}battery=LOW_BATTERY,"
    { [ "$cpu" = "THROTTLED" ] && [ "$cpu_downgraded" = 0 ]; } && why="${why}cpufreq=THROTTLED,"
    [ "$dsk" = "STALLED"     ] && why="${why}disk=STALLED,"
    # Nature of the CRITICAL: hardware axis vs software/kernel (node-health). Both can be true.
    local hw_crit=0 sw_crit=0 nature=""
    { [ "$bat" = "CRITICAL" ] || [ "$bat" = "LOW_BATTERY" ] || { [ "$cpu" = "THROTTLED" ] && [ "$cpu_downgraded" = 0 ]; } || [ "$dsk" = "STALLED" ]; } && hw_crit=1
    [ "$nh" = "CRITICAL" ] && sw_crit=1
    if [ "$hw_crit" = 1 ] && [ "$sw_crit" = 1 ]; then
      nature="hardware failure + software/kernel exhaustion"
    elif [ "$hw_crit" = 1 ]; then
      nature="imminent hardware failure"
    else
      nature="software/kernel exhaustion (swap/entropy/loadavg)"
    fi
    echo "CRITICAL|${why%,} ($nature)"
    return
  fi
  # 3. DEGRADED: any input is DEGRADED-tier (suboptimal but not critical)
  if [ "$nh" = "DEGRADED" ] || [ "$bat" = "AGED" ] || [ "$bat" = "ON_BATTERY" ] || [ "$cpu" = "REDUCED" ] || { [ "$cpu" = "THROTTLED" ] && [ "$cpu_downgraded" = 1 ]; } || [ "$dsk" = "SLOW" ]; then
    local why=""
    [ "$nh"  = "DEGRADED" ] && why="${why}node-health=DEGRADED,"
    [ "$bat" = "AGED"      ] && why="${why}battery=AGED,"
    [ "$bat" = "ON_BATTERY" ] && why="${why}battery=ON_BATTERY,"
    [ "$cpu" = "REDUCED"   ] && why="${why}cpufreq=REDUCED,"
    { [ "$cpu" = "THROTTLED" ] && [ "$cpu_downgraded" = 1 ]; } && why="${why}cpufreq=THROTTLED(therm=CALM→held cap, not emergency),"
    [ "$dsk" = "SLOW"      ] && why="${why}disk=SLOW,"
    echo "DEGRADED|${why%,} (1+ subsystem suboptimal)"
    return
  fi
  # 4. HEALTHY: all 4 inputs nominal
  echo "HEALTHY|node-health=$nh battery=$bat cpufreq=$cpu disk=$dsk (all subsystems nominal)"
}

# --- Test mode ---
if [ "${1:-}" = --test ]; then
  fail=0
  # CRITICAL — any one input critical
  r="$(classify_vitality CRITICAL NOMINAL NOMINAL FAST)"
  echo "$r" | grep -q '^CRITICAL' || { echo "  FAIL CRITICAL-node-health: got=$r"; fail=1; }
  r="$(classify_vitality HEALTHY CRITICAL NOMINAL FAST)"
  echo "$r" | grep -q '^CRITICAL' || { echo "  FAIL CRITICAL-battery: got=$r"; fail=1; }
  r="$(classify_vitality HEALTHY NOMINAL THROTTLED FAST)"
  echo "$r" | grep -q '^CRITICAL' || { echo "  FAIL CRITICAL-cpufreq: got=$r"; fail=1; }
  r="$(classify_vitality HEALTHY NOMINAL NOMINAL STALLED)"
  echo "$r" | grep -q '^CRITICAL' || { echo "  FAIL CRITICAL-disk: got=$r"; fail=1; }
  r="$(classify_vitality HEALTHY LOW_BATTERY NOMINAL FAST)"
  echo "$r" | grep -q '^CRITICAL' || { echo "  FAIL CRITICAL-low-battery: got=$r"; fail=1; }
  # CRITICAL priority: beats DEGRADED
  r="$(classify_vitality DEGRADED AGED THROTTLED SLOW)"
  echo "$r" | grep -q '^CRITICAL' || { echo "  FAIL CRITICAL-priority: got=$r (should be CRITICAL, not DEGRADED)"; fail=1; }
  # CRITICAL: list the specific subsystem
  r="$(classify_vitality HEALTHY CRITICAL NOMINAL FAST)"
  echo "$r" | grep -q 'battery=CRITICAL' || { echo "  FAIL CRITICAL-detail-battery: got=$r"; fail=1; }
  # DEGRADED — any one input degraded
  r="$(classify_vitality DEGRADED NOMINAL NOMINAL FAST)"
  echo "$r" | grep -q '^DEGRADED' || { echo "  FAIL DEGRADED-node-health: got=$r"; fail=1; }
  r="$(classify_vitality HEALTHY AGED NOMINAL FAST)"
  echo "$r" | grep -q '^DEGRADED' || { echo "  FAIL DEGRADED-battery-aged: got=$r"; fail=1; }
  r="$(classify_vitality HEALTHY ON_BATTERY NOMINAL FAST)"
  echo "$r" | grep -q '^DEGRADED' || { echo "  FAIL DEGRADED-battery-on-battery: got=$r"; fail=1; }
  r="$(classify_vitality HEALTHY NOMINAL REDUCED FAST)"
  echo "$r" | grep -q '^DEGRADED' || { echo "  FAIL DEGRADED-cpufreq-reduced: got=$r"; fail=1; }
  r="$(classify_vitality HEALTHY NOMINAL NOMINAL SLOW)"
  echo "$r" | grep -q '^DEGRADED' || { echo "  FAIL DEGRADED-disk-slow: got=$r"; fail=1; }
  # DEGRADED detail: list the specific subsystem
  r="$(classify_vitality HEALTHY AGED NOMINAL FAST)"
  echo "$r" | grep -q 'battery=AGED' || { echo "  FAIL DEGRADED-detail-aged: got=$r"; fail=1; }
  # HEALTHY: all nominal
  r="$(classify_vitality HEALTHY FULL NOMINAL FAST)"
  echo "$r" | grep -q '^HEALTHY' || { echo "  FAIL HEALTHY: got=$r"; fail=1; }
  # HEALTHY: NO_BATTERY is a valid steady-state (desktop, no battery present)
  r="$(classify_vitality HEALTHY NO_BATTERY NOMINAL FAST)"
  echo "$r" | grep -q '^HEALTHY' || { echo "  FAIL HEALTHY-no-battery: got=$r"; fail=1; }
  # HEALTHY: BOOST is OK (turbo active)
  r="$(classify_vitality HEALTHY FULL BOOST FAST)"
  echo "$r" | grep -q '^HEALTHY' || { echo "  FAIL HEALTHY-boost: got=$r"; fail=1; }
  # HEALTHY: NORMAL disk is OK
  r="$(classify_vitality HEALTHY FULL NOMINAL NORMAL)"
  echo "$r" | grep -q '^HEALTHY' || { echo "  FAIL HEALTHY-normal-disk: got=$r"; fail=1; }
  # HEALTHY: IDLE cpu is OK
  r="$(classify_vitality HEALTHY FULL IDLE FAST)"
  echo "$r" | grep -q '^HEALTHY' || { echo "  FAIL HEALTHY-idle: got=$r"; fail=1; }
  # DEGRADED: 2+ OFFLINE
  r="$(classify_vitality OFFLINE OFFLINE NOMINAL FAST)"
  echo "$r" | grep -q '^DEGRADED' || { echo "  FAIL DEGRADED-2-offline: got=$r"; fail=1; }
  echo "$r" | grep -q 'node-health' || { echo "  FAIL DEGRADED-2 should list node-health: got=$r"; fail=1; }
  # DEGRADED: all 4 OFFLINE
  r="$(classify_vitality OFFLINE OFFLINE OFFLINE OFFLINE)"
  echo "$r" | grep -q '^DEGRADED' || { echo "  FAIL DEGRADED-4-offline: got=$r"; fail=1; }
  # DEGRADED: 1 OFFLINE (1-missing)
  r="$(classify_vitality HEALTHY OFFLINE NOMINAL FAST)"
  echo "$r" | grep -q '^DEGRADED' || { echo "  FAIL DEGRADED-1-offline: got=$r"; fail=1; }
  echo "$r" | grep -q 'battery' || { echo "  FAIL DEGRADED-1 should list battery: got=$r"; fail=1; }
  # CRITICAL beats DEGRADED in priority
  r="$(classify_vitality DEGRADED NOMINAL NOMINAL SLOW)"
  echo "$r" | grep -q '^DEGRADED' || { echo "  FAIL DEGRADED-priority: got=$r"; fail=1; }
  # --- health baton 2026-07-19 00:58Z (system-vitality-stale-and-mislabeled):
  # node-health=CRITICAL is SOFTWARE/kernel exhaustion (swap/entropy/loadavg), NOT hardware
  # failure. The hard-coded '(imminent hardware failure)' suffix on every CRITICAL verdict
  # mislabelled an OOM-driven swap=CRITICAL as 'imminent hardware failure' for 15min. The label
  # must follow the NATURE of the critical input — honest-fusion, same family as the swap-PSI
  # downgrade (a verdict that hides its own meaning is a false signal). Falsify: drop the
  # hw_crit/sw_crit split below and the node-health-only case flips back to 'hardware failure'.
  # (1) node-health CRITICAL ALONE → 'software/kernel exhaustion' (NOT 'hardware failure')
  r="$(classify_vitality CRITICAL NOMINAL NOMINAL FAST)"
  echo "$r" | grep -q '^CRITICAL' || { echo "  FAIL CRITICAL-node-health still CRITICAL: got=$r"; fail=1; }
  echo "$r" | grep -q 'software/kernel exhaustion' || { echo "  FAIL node-health-only CRITICAL must say 'software/kernel exhaustion': got=$r"; fail=1; }
  echo "$r" | grep -vq 'imminent hardware failure' || { echo "  FAIL node-health-only CRITICAL must NOT say 'imminent hardware failure': got=$r"; fail=1; }
  # (2) battery CRITICAL ALONE → 'imminent hardware failure' (battery IS hardware)
  r="$(classify_vitality HEALTHY CRITICAL NOMINAL FAST)"
  echo "$r" | grep -q 'imminent hardware failure' || { echo "  FAIL battery-only CRITICAL must say 'imminent hardware failure': got=$r"; fail=1; }
  # (3) cpufreq THROTTLED+HOT ALONE → 'imminent hardware failure' (thermal IS hardware)
  r="$(classify_vitality HEALTHY NOMINAL THROTTLED FAST HOT)"
  echo "$r" | grep -q 'imminent hardware failure' || { echo "  FAIL thermal-only CRITICAL must say 'imminent hardware failure': got=$r"; fail=1; }
  # (4) disk STALLED ALONE → 'imminent hardware failure' (disk IS hardware)
  r="$(classify_vitality HEALTHY NOMINAL NOMINAL STALLED)"
  echo "$r" | grep -q 'imminent hardware failure' || { echo "  FAIL disk-only CRITICAL must say 'imminent hardware failure': got=$r"; fail=1; }
  # (5) node-health CRITICAL + battery CRITICAL → both natures named (rare but covered)
  r="$(classify_vitality CRITICAL CRITICAL NOMINAL FAST)"
  echo "$r" | grep -q 'hardware failure' || { echo "  FAIL combined CRITICAL should name hardware failure: got=$r"; fail=1; }
  echo "$r" | grep -q 'software/kernel exhaustion' || { echo "  FAIL combined CRITICAL should also name software/kernel exhaustion: got=$r"; fail=1; }
  # cpufreq=THROTTLED downgrade gate (therm corroborator):
  #   THROTTLED + therm=CALM (cold CPU) → DEGRADED, not CRITICAL (held cap, not emergency)
  r="$(classify_vitality HEALTHY NOMINAL THROTTLED FAST CALM)"
  echo "$r" | grep -q '^DEGRADED' || { echo "  FAIL THROTTLED-cold-downgrade: got=$r (should be DEGRADED)"; fail=1; }
  echo "$r" | grep -q 'held cap' || { echo "  FAIL THROTTLED-cold-reason: got=$r"; fail=1; }
  #   THROTTLED + therm=HOT (hot CPU) → stays CRITICAL (real thermal emergency)
  r="$(classify_vitality HEALTHY NOMINAL THROTTLED FAST HOT)"
  echo "$r" | grep -q '^CRITICAL' || { echo "  FAIL THROTTLED-hot-critical: got=$r (should be CRITICAL)"; fail=1; }
  #   THROTTLED + therm="" (unknown) → conservative, stays CRITICAL (legacy 4-arg behavior preserved)
  r="$(classify_vitality HEALTHY NOMINAL THROTTLED FAST)"
  echo "$r" | grep -q '^CRITICAL' || { echo "  FAIL THROTTLED-unknown-critical: got=$r (should be CRITICAL)"; fail=1; }
  #   downgrade must not mask a REAL critical from another input
  r="$(classify_vitality CRITICAL NOMINAL THROTTLED FAST CALM)"
  echo "$r" | grep -q '^CRITICAL' || { echo "  FAIL THROTTLED-cold-but-nh-critical: got=$r (should be CRITICAL)"; fail=1; }
  [ "$fail" = 1 ] && { echo "smoke-test: FAIL"; exit 1; }
  echo "smoke-test: ok (32 fusion assertions: CRITICAL×5+1-priority+1-detail+5-nature-labels [hw/sw/combined], DEGRADED×5+1-detail, HEALTHY×5, OFFLINE×2+1+1-detail, throttle-gate×5)"
  exit 0
fi

# --- Live read path ---
# REFRESH fast-cadence inputs first (health 2026-07-19 00:58Z, system-vitality-stale-and-
# mislabeled): node-health/cpufreq/disk-latency are cron-wired at 2-59/5 but system-vitality
# runs at 2-59/15, so the read below could otherwise see a verdict 5-10min stale (the live
# incident: at 00:47 system-vitality captured node-health=CRITICAL from the 00:42 cycle, held
# it for 15min while node-health itself downgraded at 00:57). Force-refresh collapses the lag
# to <1s — mirrors mesh-node-health's own refresh pattern for ITS 4 inputs (lines 502-513,
# hollow-fusion fix 2026-07-03). mesh-battery is on the SAME */15 cadence, so no refresh
# (would just race its own cron line). All three are pure local reads (~ms); a tool that
# errors/vanishes still reads OFFLINE below — honest rail stays.
# MESH_SYSTEM_VITALITY_NO_REFRESH=1 lets --test fixtures skip this.
if [ -z "${MESH_SYSTEM_VITALITY_NO_REFRESH:-}" ]; then
  for _t in mesh-node-health mesh-cpufreq mesh-disk-latency; do
    command -v "$_t" >/dev/null 2>&1 && "$_t" >/dev/null 2>&1 || true
  done
fi
nh="$(read_node_health "$MESH/.node-health-state")"
bat="$(read_battery "$MESH/.battery-state")"
cpu="$(read_cpufreq "$MESH/.cpufreq-state")"
dsk="$(read_disk_latency "$MESH/.disk-latency-state")"
therm="$(read_cpu_temp_band)"

result="$(classify_vitality "$nh" "$bat" "$cpu" "$dsk" "$therm")"
label="${result%%|*}"
reason="${result#*|}"

TS=$(date -u +%Y-%m-%dT%H:%M:%SZ)
# capture prev BEFORE overwriting STATE — reading it after the write would always see the label
# just written (permanent --edge no-op, mirrors the mesh-storage-health fix for the same class
# of bug); do the read/write in the right order here.
prev=""; [ -f "$STATE" ] && prev="$(head -1 "$STATE" 2>/dev/null | cut -d'|' -f1)" || true
# Write state + touch liveness on EVERY successful run
printf '%s|node-health=%s|battery=%s|cpufreq=%s|disk=%s|%s\n' "$label" "$nh" "$bat" "$cpu" "$dsk" "$reason" > "$STATE"
mesh-state-touch "$STATE"

# --- Output ---
if [ "${1:-}" = --json ]; then
  printf '{"label":"%s","reason":"%s","inputs":{"node_health":"%s","battery":"%s","cpufreq":"%s","disk_latency":"%s"},"ts":"%s"}\n' \
    "$label" "$reason" "$nh" "$bat" "$cpu" "$dsk" "$TS"
  exit 0
fi
if [ "${1:-}" = --edge ]; then
  [ "$prev" = "$label" ] && exit 0
  printf '[vitality-%s] %s — %s\n' "$(printf '%s' "$label" | tr '[:upper:]' '[:lower:]')" "$label" "$reason"
  exit 0
fi
printf '[vitality-%s] %s — %s\n' "$(printf '%s' "$label" | tr '[:upper:]' '[:lower:]')" "$label" "$reason"
