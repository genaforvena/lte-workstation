#!/usr/bin/env bash
# mesh-harden-ssh — safely close the SSH lateral-movement surface the audit flagged
# ("any tag:lte-node can attempt PASSWORD login on :22 — weak/default password = mesh-wide risk").
# Disables password + keyboard-interactive auth, leaving KEY auth only. NEVER risks lockout:
#   - refuses unless the real user has an authorized_keys (else disabling passwords = lockout),
#   - applies UNDER mesh-dms: a fresh KEY login is verified after the change; if it fails (or this
#     dies), the dead-man's switch auto-reverts. (Substrate doctrine: the SSH path is contended —
#     apply under DMS, cancel only after verify. Coordinate before running on a shared node.)
#
#   mesh-harden-ssh --check     posture: password-auth state + key-auth readiness  (read-only)
#   mesh-harden-ssh --apply     disable password/kbd-interactive auth, DMS-protected  (root)
#   mesh-harden-ssh --revert    remove the hardening drop-in, restore default        (root)
#   mesh-harden-ssh --test      smoke test
#
# Run PER-NODE (local). The change is substrate — one writer at a time; mark mesh-trace.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
DROP=/etc/ssh/sshd_config.d/50-mesh-harden.conf
RUSER="${SUDO_USER:-$USER}"                       # the human whose key access must survive
SSH_UNIT="ssh"; systemctl list-unit-files 2>/dev/null | grep -qE '^sshd\.service' && SSH_UNIT="sshd"

# does the real (login) user have an authorized key? without one, disabling passwords = lockout.
key_present() {
  local ak; ak="$(eval echo "~$RUSER")/.ssh/authorized_keys"
  [ -s "$ak" ]
}

case "${1:-}" in
  --test)
    { command -v sshd >/dev/null 2>&1 || [ -x /usr/sbin/sshd ]; } || { echo "smoke-test: FAIL (no sshd)"; exit 1; }
    command -v mesh-dms >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-dms)"; exit 1; }
    echo "smoke-test: ok"; exit 0 ;;

  --check|"")
    echo "node: $(hostname)   login-user: $RUSER"
    pa="$(sudo -n sshd -T 2>/dev/null | grep -iE '^passwordauthentication' || true)"
    echo "password-auth (effective): ${pa:-unknown (need root: sudo mesh-harden-ssh --check)}"
    if key_present; then
      echo "key-auth: READY — $RUSER has authorized_keys → safe to disable passwords"
    else
      echo "key-auth: NOT READY — $RUSER has NO authorized_keys → DO NOT --apply (lockout risk)"
    fi
    [ -f "$DROP" ] && echo "hardening: APPLIED ($DROP)" || echo "hardening: not applied"
    ;;

  --revert)
    [ "$(id -u)" = 0 ] || exec sudo "$0" --revert
    rm -f "$DROP"
    sshd -t && systemctl reload "$SSH_UNIT" && echo "reverted: password auth back to sshd default"
    ;;

  --apply)
    key_present || { echo "REFUSING: $RUSER has no ~/.ssh/authorized_keys — disabling passwords would LOCK YOU OUT." >&2; exit 1; }
    [ "$(id -u)" = 0 ] || exec sudo -E "$0" --apply
    command -v mesh-trace >/dev/null 2>&1 && mesh-trace "ssh-harden: disabling PasswordAuthentication on $(hostname) under DMS (rollback: rm $DROP)" >/dev/null 2>&1 || true
    # Apply under a dead-man's switch. verify = a FRESH key login as the real user still works.
    change="mkdir -p /etc/ssh/sshd_config.d && printf 'PasswordAuthentication no\nKbdInteractiveAuthentication no\n' > '$DROP' && sshd -t && systemctl reload $SSH_UNIT"
    verify="sudo -u '$RUSER' ssh -o BatchMode=yes -o ConnectTimeout=6 -o StrictHostKeyChecking=no '$RUSER'@localhost true"
    rollback="rm -f '$DROP' && systemctl reload $SSH_UNIT"
    mesh-dms 60 "$rollback" "$verify" "$change" \
      && echo "hardened: password auth disabled, key login verified (DMS cancelled)" \
      || echo "NOT hardened: verify failed → DMS auto-reverted (access preserved)"
    ;;

  *) echo "usage: mesh-harden-ssh --check|--apply|--revert|--test"; exit 2 ;;
esac
