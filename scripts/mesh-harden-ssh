#!/usr/bin/env bash
# mesh-harden-ssh — safely close the SSH lateral-movement surface the audit flagged
# ("any tag:lte-node can attempt PASSWORD login on :22 — weak/default password = mesh-wide risk").
# Disables password + keyboard-interactive auth, leaving KEY auth only. NEVER risks lockout:
#   - refuses unless the real user has an authorized_keys (else disabling passwords = lockout),
#   - applies UNDER mesh-dms: a fresh KEY login is verified after the change; if it fails (or this
#     dies), the dead-man's switch auto-reverts. (Substrate doctrine: the SSH path is contended —
#     apply under DMS, cancel only after verify. Coordinate before running on a shared node.)
#
#   mesh-harden-ssh --check     posture: password-auth state + key-auth readiness  (read-only)
#   mesh-harden-ssh --apply     disable password/kbd-interactive auth, DMS-protected  (root)
#   mesh-harden-ssh --revert    remove the hardening drop-in, restore default        (root)
#   mesh-harden-ssh --test      smoke test
#
# Run PER-NODE (local). The change is substrate — one writer at a time; mark mesh-trace.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
DROP=/etc/ssh/sshd_config.d/50-mesh-harden.conf
RUSER="${SUDO_USER:-${USER:-$(id -un)}}"           # the human whose key access must survive
SSH_UNIT="ssh"; systemctl list-unit-files 2>/dev/null | grep -qE '^sshd\.service' && SSH_UNIT="sshd"

# does the real (login) user have an authorized key? without one, disabling passwords = lockout.
key_present() {
  local ak; ak="$(eval echo "~$RUSER")/.ssh/authorized_keys"
  [ -s "$ak" ]
}

case "${1:-}" in
  --test)
    { command -v sshd >/dev/null 2>&1 || [ -x /usr/sbin/sshd ]; } || { echo "smoke-test: FAIL (no sshd)"; exit 1; }
    command -v mesh-dms >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-dms)"; exit 1; }
    echo "smoke-test: ok"; exit 0 ;;

  --check|"")
    echo "node: $(hostname)   login-user: $RUSER"
    pa="$(sudo -n sshd -T 2>/dev/null | grep -iE '^passwordauthentication' || true)"
    echo "password-auth (effective): ${pa:-unknown (need root: sudo mesh-harden-ssh --check)}"
    if key_present; then
      echo "key-auth: READY — $RUSER has authorized_keys → safe to disable passwords"
    else
      echo "key-auth: NOT READY — $RUSER has NO authorized_keys → DO NOT --apply (lockout risk)"
    fi
    [ -f "$DROP" ] && echo "hardening: APPLIED ($DROP)" || echo "hardening: not applied"
    ;;

  --revert)
    [ "$(id -u)" = 0 ] || exec sudo "$0" --revert
    rm -f "$DROP"
    sshd -t && systemctl reload "$SSH_UNIT" && echo "reverted: password auth back to sshd default"
    ;;

  --apply)
    key_present || { echo "REFUSING: $RUSER has no ~/.ssh/authorized_keys — disabling passwords would LOCK YOU OUT." >&2; exit 1; }
    [ "$(id -u)" = 0 ] || exec sudo -E "$0" --apply
    command -v mesh-trace >/dev/null 2>&1 && mesh-trace "ssh-harden: disabling PasswordAuthentication on $(hostname) under DMS (rollback: rm $DROP)" >/dev/null 2>&1 || true
    # Apply under a dead-man's switch. The change writes our drop-in AND neutralizes any conflicting
    # 'PasswordAuthentication/KbdInteractiveAuthentication yes' elsewhere — OpenSSH uses the FIRST
    # value, so an earlier-sorted file (Ubuntu cloud images ship 50-cloud-init.conf with passwords ON,
    # which sorts before 50-mesh-harden.conf) would SHADOW our drop-in and silently leave passwords on.
    # verify requires the EFFECTIVE `sshd -T` showing passwordauthentication=no (the 2026-06-13 phaedra
    # bug: tool said 'hardened' while sshd -T still said yes) AND that KEY auth remains viable so we're
    # not locked out. Key-viability is proven END-TO-END by a self-loopback key login when the login
    # user happens to hold a self-key; but on the STANDARD mesh topology `~$RUSER/.ssh/authorized_keys`
    # holds only REMOTE nodes' pubkeys (for peers connecting IN) and the user has no self-login key, so
    # that loopback ALWAYS fails and the change false-reverts — the real reason ds sat unhardened for
    # 24h+ (2026-07-08). So: self-loopback is a BONUS signal; when it's absent, fall back to the
    # structural guarantee (pubkeyauthentication on + $RUSER has a non-empty authorized_keys). The
    # pre-apply key_present() refusal + password-off-required core keep this sound against lockout.
    change="mkdir -p /etc/ssh/sshd_config.d && printf 'PasswordAuthentication no\nKbdInteractiveAuthentication no\n' > '$DROP' && for f in /etc/ssh/sshd_config /etc/ssh/sshd_config.d/*.conf; do [ \"\$f\" = '$DROP' ] && continue; [ -f \"\$f\" ] && sed -i -E 's/^([[:space:]]*(PasswordAuthentication|KbdInteractiveAuthentication)[[:space:]]+[Yy][Ee][Ss].*)\$/#\\1 # mesh-harden-shadow/' \"\$f\"; done && sshd -t && systemctl reload $SSH_UNIT"
    verify="[ \"\$(sshd -T 2>/dev/null | awk '/^passwordauthentication/{print \$2}')\" = no ] && { sudo -u '$RUSER' ssh -o BatchMode=yes -o ConnectTimeout=6 -o StrictHostKeyChecking=no '$RUSER'@localhost true 2>/dev/null || { [ \"\$(sshd -T 2>/dev/null | awk '/^pubkeyauthentication/{print \$2}')\" = yes ] && [ -s \"\$(eval echo ~'$RUSER')/.ssh/authorized_keys\" ]; }; }"
    rollback="rm -f '$DROP'; sed -i -E 's/^#(([[:space:]]*(PasswordAuthentication|KbdInteractiveAuthentication)[[:space:]]+[Yy][Ee][Ss].*)) # mesh-harden-shadow\$/\\1/' /etc/ssh/sshd_config /etc/ssh/sshd_config.d/*.conf 2>/dev/null; systemctl reload $SSH_UNIT"
    # THREE OUTCOMES, THREE WORDS ({#ccd8c67d}): mesh-dms grew exit 3 = the CHANGE COMMAND itself
    # failed, so nothing was applied and nothing was reverted. Collapsing that into "verify failed →
    # auto-reverted" would tell the operator the box was rolled back to a safe state when in fact the
    # apply never ran — the same one-word-for-two-worlds defect, one layer out from the tool it calls.
    _hd_rc=0; mesh-dms 60 "$rollback" "$verify" "$change" || _hd_rc=$?
    case "$_hd_rc" in
      0) echo "hardened: password auth EFFECTIVELY disabled (sshd -T verified no), key login verified (DMS cancelled)" ;;
      3) echo "NOT hardened: the CHANGE COMMAND failed — nothing was applied and nothing was reverted; sshd config is as it was. See ~/.mesh/dms/lifecycle.log (change-failed row) for its rc." ;;
      *) echo "NOT hardened: verify failed (key login broke OR effective passwordauth still != no) → DMS auto-reverted (access preserved)" ;;
    esac
    ;;

  *) echo "usage: mesh-harden-ssh --check|--apply|--revert|--test"; exit 2 ;;
esac
