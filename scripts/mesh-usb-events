#!/usr/bin/env bash
# mesh-usb-events — USB attach/detach DELTA layer: turn the wired bus's device-set change
# into an EVENT. mesh-usb is the stateless snapshot ("what is plugged in"); this reflex is
# the missing wired equivalent of mesh-lan-newdevice (LAN arrivals) / mesh-presence (BLE):
# it diffs the device set against ~/.mesh/.usb-set and emits to ~/.mesh/usb-attach.log
#   [usb-attach] <product> [vid:pid]   /   [usb-detach] <product> [vid:pid]
# (NOT usb-events.log — that name is mesh-autowire's stdout journal for this tool; sharing it
# would drown the rare-event stream in per-run QUIET chatter — the gpu-activity.log collision.)
# A plug/unplug is a DELIBERATE physical act — the highest-confidence "operator is at the
# machine interacting" signal (stronger than passive GPU/keypress presence; live proof: the
# operator re-plugging the webcam 2026-07-02 ~10:23Z, which nothing emitted).
# Find: capability-usb-attach-events-20260702.md.
#
# Design constraints (each one is a logged mesh failure class):
#   - Diff KEY = <vid:pid>\t<product> ONLY — the webcam re-enumerated with a different
#     removable class on replug; class/speed drift must not fire phantom events.
#   - FIRST RUN = baseline only, zero events — never replay the whole inventory as attaches
#     (the reviving-offset-reflex-replays-backlog trap).
#   - BLIND bus (mesh-usb exit 2) → propagate exit 2 and DO NOT touch .usb-set — a transient
#     blind read must not diff as "everything detached" then replay attaches on recovery.
#   - State ~/.mesh/.usb-events-state written EVERY run (mtime = liveness); line 1 token is
#     the consumer grammar: ATTACH | DETACH | QUIET | BLIND (mesh-operator-focus usb_lift
#     reads the leading caps run — token set is a consumer contract).
#   - Board post is rare + env-gated (MESH_USB_EVENTS_CHAT=0 silences; --test sandboxes it).
#
#   mesh-usb-events          one delta pass: diff, emit events, write state + log
#   mesh-usb-events --status last state reading, no new scan
#   mesh-usb-events --test   fixture baseline/attach/detach/re-enum/BLIND + real-read gate
#
# reflex-cadence: */5 * * * *
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

# mesh-usb resolution: sibling of $0 first (source run uses source mesh-usb — which has
# --list before the deployed copy does; deployed run uses the deployed sibling), env override.
USB_BIN="${MESH_USB_BIN:-}"
if [ -z "$USB_BIN" ]; then
  _sib="$(cd "$(dirname "$0")" 2>/dev/null && pwd)/mesh-usb"
  [ -x "$_sib" ] && USB_BIN="$_sib" || USB_BIN="mesh-usb"
fi
SETF="${MESH_USB_SET:-$HOME/.mesh/.usb-set}"
STATE="${MESH_USB_EVENTS_STATE:-$HOME/.mesh/.usb-events-state}"
LOG="${MESH_USB_EVENTS_LOG:-$HOME/.mesh/usb-attach.log}"
CHAT="${MESH_USB_EVENTS_CHAT:-1}"

current_set(){ # stable diff key: <vid:pid>\t<product> — drops removable+speed (re-enum drift)
  "$USB_BIN" --list | awk -F'\t' 'NF>=2 {print $2 "\t" $1}' | LC_ALL=C sort -u
}

emit(){ # $1=attach|detach $2=key-line "<vid:pid>\t<product>"
  local kind="$1" vidpid prod ts
  vidpid="${2%%$'\t'*}"; prod="${2#*$'\t'}"
  ts="$(date -u +%FT%TZ)"
  printf '%s [usb-%s] %s [%s]\n' "$ts" "$kind" "$prod" "$vidpid" >>"$LOG"
  if [ "$CHAT" = 1 ] && command -v mesh-chat >/dev/null 2>&1; then
    mesh-chat "[usb-$kind] $prod [$vidpid] — wired peripheral $kind on $(hostname) (deliberate physical act = operator at machine)" >/dev/null 2>&1 || true
  fi
}

# run one delta pass against whatever SETF/STATE/LOG/USB_BIN point at (test drives this too)
delta_pass(){
  local cur rc att det n_att n_det total token detail
  cur="$(current_set)"; rc=$?
  if [ "$rc" = 2 ]; then
    # BLIND bus: honest n/a — keep last-known-good set untouched (no phantom detach flood)
    mkdir -p "$(dirname "$STATE")" 2>/dev/null
    printf 'BLIND bus-unreadable\n' >"$STATE"
    echo "mesh-usb-events: BLIND — bus unreadable (mesh-usb exit 2); set kept, no events" >&2
    return 2
  fi
  [ "$rc" = 0 ] || { echo "mesh-usb-events: mesh-usb --list failed rc=$rc" >&2; return 1; }
  mkdir -p "$(dirname "$SETF")" 2>/dev/null

  if [ ! -f "$SETF" ]; then
    # first run: baseline only — NEVER replay the inventory as attach events
    printf '%s\n' "$cur" | grep -v '^$' >"$SETF"
    total=$(grep -c . "$SETF" 2>/dev/null || true)
    printf 'QUIET 0/0 %s baseline\n' "${total:-0}" >"$STATE"
    echo "[usb-events] baseline: ${total:-0} device(s) recorded, no events (first run)"
    return 0
  fi

  att="$(printf '%s\n' "$cur" | grep -v '^$' | LC_ALL=C comm -13 "$SETF" - 2>/dev/null)"
  det="$(printf '%s\n' "$cur" | grep -v '^$' | LC_ALL=C comm -23 "$SETF" - 2>/dev/null)"
  n_att=0; n_det=0
  [ -n "$att" ] && n_att=$(printf '%s\n' "$att" | grep -c .)
  [ -n "$det" ] && n_det=$(printf '%s\n' "$det" | grep -c .)

  [ -n "$att" ] && while IFS= read -r l; do [ -n "$l" ] && emit attach "$l"; done <<<"$att"
  [ -n "$det" ] && while IFS= read -r l; do [ -n "$l" ] && emit detach "$l"; done <<<"$det"

  printf '%s\n' "$cur" | grep -v '^$' >"$SETF"
  total=$(grep -c . "$SETF" 2>/dev/null || true)
  token=QUIET; detail=""
  if   [ "$n_att" -gt 0 ]; then token=ATTACH; detail=" last=$(printf '%s\n' "$att" | tail -1 | cut -f2)"
  elif [ "$n_det" -gt 0 ]; then token=DETACH; detail=" last=$(printf '%s\n' "$det" | tail -1 | cut -f2)"
  fi
  printf '%s %s/%s %s%s\n' "$token" "$n_att" "$n_det" "${total:-0}" "$detail" >"$STATE"

  # log hygiene (events are rare; this is a backstop, same trim shape as gpu-activity)
  if [ -f "$LOG" ] && [ "$(wc -l <"$LOG" 2>/dev/null || echo 0)" -gt 10000 ]; then
    tail -n 5000 "$LOG" >"$LOG.tmp" && mv "$LOG.tmp" "$LOG"
  fi
  echo "[usb-events] $token +$n_att/-$n_det (${total:-0} on bus)$detail"
  return 0
}

if [ "${1:-}" = "--test" ]; then
  fail=0
  td=$(mktemp -d); trap 'cd /; rm -rf "$td"' EXIT
  fx="$td/bus"
  mkdir -p "$fx/1-5"; printf 'Integrated Camera' >"$fx/1-5/product"
  echo 174f >"$fx/1-5/idVendor"; echo 118d >"$fx/1-5/idProduct"
  echo fixed >"$fx/1-5/removable"; echo 480 >"$fx/1-5/speed"
  # sandbox ALL outbound + state into the temp dir (reflex --test must sandbox outbound).
  # NOTE: SETF/STATE/LOG/CHAT were already resolved at script top — reassign them HERE, not
  # via the MESH_* env names (those only affect a fresh process, not this one's delta_pass).
  SETF="$td/set"; STATE="$td/state"; LOG="$td/log"; CHAT=0
  export MESH_USB_DIR="$fx"   # consumed by the mesh-usb child process

  # 1. first run = baseline, zero events
  delta_pass >/dev/null || { echo "  FAIL: baseline pass rc!=0"; fail=1; }
  [ -s "$td/log" ] && { echo "  FAIL: baseline emitted events (backlog-replay trap)"; fail=1; }
  grep -q '^QUIET 0/0 1 baseline' "$td/state" || { echo "  FAIL: baseline state → $(cat "$td/state" 2>/dev/null)"; fail=1; }

  # 2. attach: a new peripheral appears → [usb-attach] fires, state token ATTACH
  mkdir -p "$fx/2-1"; printf 'Kingston DataTraveler' >"$fx/2-1/product"
  echo 0951 >"$fx/2-1/idVendor"; echo 1666 >"$fx/2-1/idProduct"
  echo removable >"$fx/2-1/removable"; echo 5000 >"$fx/2-1/speed"
  delta_pass >/dev/null || { echo "  FAIL: attach pass rc!=0"; fail=1; }
  grep -q '\[usb-attach\] Kingston DataTraveler \[0951:1666\]' "$td/log" || { echo "  FAIL: attach event not logged"; fail=1; }
  grep -q '^ATTACH 1/0 2' "$td/state" || { echo "  FAIL: attach state → $(cat "$td/state" 2>/dev/null)"; fail=1; }

  # 3. detach: it vanishes → [usb-detach] fires, state token DETACH
  rm -rf "$fx/2-1"
  delta_pass >/dev/null || { echo "  FAIL: detach pass rc!=0"; fail=1; }
  grep -q '\[usb-detach\] Kingston DataTraveler \[0951:1666\]' "$td/log" || { echo "  FAIL: detach event not logged"; fail=1; }
  grep -q '^DETACH 0/1 1' "$td/state" || { echo "  FAIL: detach state → $(cat "$td/state" 2>/dev/null)"; fail=1; }

  # 4. re-enumeration drift: removable class + speed change, same vid:pid+product → NO event
  echo removable >"$fx/1-5/removable"; echo 5000 >"$fx/1-5/speed"
  n0=$(grep -c . "$td/log")
  delta_pass >/dev/null || { echo "  FAIL: re-enum pass rc!=0"; fail=1; }
  n1=$(grep -c . "$td/log")
  [ "$n0" = "$n1" ] || { echo "  FAIL: re-enum class/speed drift fired a phantom event"; fail=1; }
  grep -q '^QUIET 0/0 1' "$td/state" || { echo "  FAIL: re-enum state → $(cat "$td/state" 2>/dev/null)"; fail=1; }

  # 5. BLIND: unreadable bus → exit 2, set file UNTOUCHED (no phantom detach flood)
  sum0=$(cksum "$td/set")
  MESH_USB_DIR="$td/nonexistent" delta_pass >/dev/null 2>&1
  [ $? -eq 2 ] || { echo "  FAIL: blind bus must return 2"; fail=1; }
  sum1=$(cksum "$td/set")
  [ "$sum0" = "$sum1" ] || { echo "  FAIL: blind pass touched the set file"; fail=1; }
  grep -q '^BLIND' "$td/state" || { echo "  FAIL: blind state → $(cat "$td/state" 2>/dev/null)"; fail=1; }

  # REAL-READ GATE (verification principle): the actual bus must yield a well-formed scan.
  # No USB bus on this node = honest n/a exit 2, never fake green.
  unset MESH_USB_DIR
  real="$("$USB_BIN" --list 2>/dev/null)"; rrc=$?
  if [ "$rrc" = 2 ]; then
    echo "smoke-test: n/a — no readable USB bus on this node (mesh-usb BLIND)"
    exit 2
  fi
  [ "$rrc" = 0 ] || { echo "  FAIL: real mesh-usb --list rc=$rrc"; fail=1; }
  badcols=$(printf '%s\n' "$real" | awk -F'\t' 'NF && NF!=4{bad=1} END{print bad+0}')
  [ "$badcols" = 0 ] || { echo "  FAIL: real --list lines not 4-column TSV (hollow interface)"; fail=1; }
  nreal=$(printf '%s\n' "$real" | grep -c .)

  [ "$fail" = 0 ] && { echo "smoke-test: ok (baseline-no-replay, attach+detach fire, re-enum drift silent, BLIND keeps set, real bus: $nreal device(s) 4-col TSV)"; exit 0; } \
                  || { echo "smoke-test: FAIL"; exit 1; }
fi

if [ "${1:-}" = "--status" ]; then
  if [ -s "$STATE" ]; then
    printf '[usb-events] %s (as of %s)\n' "$(cat "$STATE")" \
      "$(date -u -r "$STATE" +%FT%TZ 2>/dev/null || echo '?')"
    exit 0
  fi
  echo "[usb-events] no state yet — run mesh-usb-events for a pass"; exit 2
fi

delta_pass
