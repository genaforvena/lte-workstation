#!/usr/bin/env bash
# mesh-tick — the node mind's closing tick. Call at the end of every task.
#
# If this node's claude window is idle at an empty prompt, injects the
# handoff message and presses Enter — keeping the mind alive without operator.
# If the window is busy (mid-task), exits 1 without touching it.
#
#   mesh-tick "what was done; what to do next"
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"

MSG="${*:?usage: mesh-tick \"handoff message\"}"
SESSION="$(hostname)"

snapshot="$(tmux capture-pane -t "${SESSION}:claude" -p -S -5 2>/dev/null)"

if echo "$snapshot" | grep -qE '❯\s*$'; then
    tmux send-keys -t "${SESSION}:claude" -l "$MSG"
    sleep 0.2
    tmux send-keys -t "${SESSION}:claude" Enter
    echo "[tick]: ${MSG:0:80}..."
else
    echo "[tick] claude window is busy — not injecting" >&2
    exit 1
fi
