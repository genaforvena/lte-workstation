#!/usr/bin/env bash
# mesh-tick — the node mind's closing tick. Call at the end of every task.
#
# Checks if the agent window (default: claude) is idle at an empty prompt.
# If idle, injects the given message and presses Enter — keeping the mind alive.
# If busy (mid-task), prints a warning and exits 1 without touching the window.
#
#   mesh-tick "what was done; what to do next"
#   mesh-tick --win opencode "task for opencode"   (target a different window)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"

WIN="claude"
[ "${1:-}" = "--win" ] && { WIN="$2"; shift 2; }
MSG="${*:?usage: mesh-tick [--win <window>] \"handoff message\"}"
SESSION="$(hostname)"

# Capture the last few lines of the target window
snapshot="$(tmux capture-pane -t "${SESSION}:${WIN}" -p -S -5 2>/dev/null)"

# Idle = prompt line contains only the shell prompt marker with nothing after it
if echo "$snapshot" | grep -qE '❯\s*$'; then
    tmux send-keys -t "${SESSION}:${WIN}" -l "$MSG"
    sleep 0.2
    tmux send-keys -t "${SESSION}:${WIN}" Enter
    echo "[tick -> ${WIN}]: ${MSG:0:80}..."
else
    echo "[tick] ${WIN} is busy — not injecting" >&2
    exit 1
fi
