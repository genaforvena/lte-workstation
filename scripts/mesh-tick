#!/usr/bin/env bash
# mesh-tick — cron-driven steward heartbeat (*/5 * * * *).
# Only fires when Claude is idle. Input line is always 3rd from bottom.
export PATH="$HOME/.local/bin:$PATH"
SESSION="$(hostname)"
pane="${SESSION}:claude"

bottom="$(tmux capture-pane -t "$pane" -p -S -3 2>/dev/null)"
status_line="$(echo "$bottom" | tail -1)"
input_line="$(echo "$bottom" | head -1)"

# Don't interrupt mid-response
if ! echo "$status_line" | grep -q 'auto mode'; then
    echo "$(date -u +%H:%MZ) tick: busy — skip"
    exit 0
fi

content="$(echo "$input_line" | grep -o '❯.*' | sed 's/❯[[:space:]]*//' | tr -d '[:space:]')"

if [ -n "$content" ]; then
    echo "$(date -u +%H:%MZ) tick: submit [${content:0:60}]"
    tmux send-keys -t "$pane" Enter
else
    echo "$(date -u +%H:%MZ) tick: idle — nudge"
    tmux send-keys -t "$pane" -l "tick"
    sleep 0.1
    tmux send-keys -t "$pane" Enter
fi
