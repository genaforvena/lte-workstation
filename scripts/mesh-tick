#!/usr/bin/env bash
# mesh-tick [user@host] [window] — BREATHING reflex. No arg: breathe THIS node's claude mind; user@host:
# breathe a PEER's over ssh (mutual / neighbour-keeps-you-breathing); window: which mind window to breathe
# (default claude — e.g. `mesh-tick local opencode`). Idle via DOUBLE-CAPTURE (animation).
# When idle: ALWAYS reliable self-feed (C-u clear -> type nudge -> Enter) — guarantees a wake; don't trust
# stale input (Enter on it is a no-op -> stays idle). Operator: "the point is sending it."
set -uo pipefail
[ "${1:-}" = --test ] && { command -v tmux >/dev/null 2>&1 || { echo "smoke-test: FAIL (no tmux)"; exit 1; }; echo "smoke-test: ok"; exit 0; }
export PATH="$HOME/.local/bin:$PATH"
TGT="${1:-local}"; WIN="${2:-claude}"; ROLE="${3:-general}"
run(){ if [ "$TGT" = local ]; then bash -c "$1"; else ssh -o BatchMode=yes -o ConnectTimeout=8 "$TGT" "$1"; fi; }
RHOST="$(run hostname 2>/dev/null)"; [ -z "$RHOST" ] && { echo "$(date -u +%H:%MZ) tick[$TGT:$WIN]: unreachable"; exit 0; }
# CHANNEL convention: top=DATA, bottom=MIND. Capture+drive the BOTTOM pane (largest pane_top) — never
# the refreshing data pane (which reads as always-busy → mind never gets nudged).
pidx="$(run "tmux list-panes -t '${RHOST}:${WIN}' -F '#{pane_top} #{pane_index}' 2>/dev/null | sort -n | tail -1 | awk '{print \$2}'")"
pane="${RHOST}:${WIN}${pidx:+.$pidx}"
# ROLE-STREAMS (operator: "one mind plans+fills plans, others check, other verify — streams of
# messages, otherwise you stop"). Parallel specialised streams feed the board; the PLANNER folds
# their findings into PLAN + drives fixes. No single serial loop = no single point that stalls.
case "$ROLE" in
  plan)   NUDGE="plan-stream — you are the PLANNER. Read ~/.mesh/PLAN.md + ~/.mesh/chat.log (fold in any [check]/[verify]/[done] findings from the other streams). Pick the HIGHEST-VALUE open item, break it into a concrete next step, and DO it or assign it to a mind. Then UPDATE ~/.mesh/PLAN.md to current reality + next priorities — keep it the living source of direction. Drive work FORWARD; don't just health-check. Commit+push genuine artifacts; sparse Telegram." ;;
  check)  NUDGE="check-stream — you are the CHECKER. Run mesh-doctor (comprehensive). Detect CHANGE: mesh-lan-presence --nodes + tailscale status (a peer back? a reflex down? egress regressed?). Post a [check] line to mesh-chat with any FAIL/WARN/change so the PLANNER can act (or '[check] all green' once if nothing, sparingly). Report, don't fix substrate. Keep it tight." ;;
  verify) NUDGE="verify-stream — you are the VERIFIER. Reality-check ONE declared capability/tool/reflex (rotate over time): does it ACTUALLY work — real artifact / exit 0 / no hang / parses? Verify against reality, don't trust status. If you find a flaw (hollow declaration, hang, syntax error, broken default, hardcoded-offline-peer), post [verify] to mesh-chat with tool + file:line + evidence so the PLANNER/steward fixes it. If it works, post a one-line [verify] confirmation occasionally." ;;
  *)      NUDGE="tick — heartbeat. Orient: read ~/.mesh/chat.log + inboxes, check reflexes (mesh-egress-health, mesh-supervise --status). Then ADVANCE: (1) an assigned [task] for you on the board? do it. (2) else read ~/.mesh/PLAN.md + ~/.mesh/knowledge/ and take ONE bounded step toward an open plan item, OR capability-discovery, OR mine a field, OR propose an idea. IDLE = DISCOVER, never just sleep. Self-tending mesh mind; verify against reality; don't act blindly. ALWAYS coordinate via mesh-chat: post [taking] when you start, [done]+result when you finish — report so the other minds and the steward see it." ;;
esac
NB64="$(printf '%s' "$NUDGE" | base64 | tr -d '\n')"
cap(){ run "tmux capture-pane -t '$pane' -p -S -8 2>/dev/null"; }
# mind-beat: a LOCAL claude that is alive stamps its beat so mesh-mind-watch can tell mind-down from
# node-down. Animating/timer = provably thinking → stamp on its behalf (reliable, no agent memory).
mindbeat(){ [ "$TGT" = local ] && [ "$WIN" = claude ] && command -v mesh-mind-stamp >/dev/null 2>&1 && mesh-mind-stamp >/dev/null 2>&1 || true; }
c1="$(cap)"; [ -z "$c1" ] && { echo "$(date -u +%H:%MZ) tick[$TGT:$WIN]: no-pane"; exit 0; }
sleep 1.5; c2="$(cap)"
[ "$c1" != "$c2" ] && { mindbeat; echo "$(date -u +%H:%MZ) tick[$TGT:$WIN]: busy (animating) — skip"; exit 0; }
printf '%s\n' "$c2" | grep -qE '[0-9]+s .*token' && { mindbeat; echo "$(date -u +%H:%MZ) tick[$TGT:$WIN]: busy (timer) — skip"; exit 0; }
echo "$(date -u +%H:%MZ) tick[$TGT:$WIN]: idle — self-feed nudge"
run "tmux send-keys -t '$pane' C-u; sleep 0.1; tmux send-keys -t '$pane' -l \"\$(echo $NB64 | base64 -d)\"; sleep 0.3; tmux send-keys -t '$pane' C-m"
