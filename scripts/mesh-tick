#!/usr/bin/env bash
# mesh-tick — BREATHING reflex (*/5). Idle-vs-busy by DOUBLE-CAPTURE: the screen ANIMATES (spinner +
# live token timer) while Claude generates, and is STATIC when waiting for input. Footer strings
# ('esc to interrupt','shift+tab to cycle') are ALWAYS present, so only animation distinguishes states.
# Design by IdeaPad+default-string Claude working in parallel.
export PATH="$HOME/.local/bin:$PATH"
SESSION="$(hostname)"; pane="${SESSION}:claude"
NUDGE="tick — idle heartbeat. Orient yourself: read ~/.mesh/chat.log (peer coordination) and your channel inboxes, check reflex status (mesh-egress-health, mesh-supervise --status), and the roadmap. Then do ONE bounded useful step, or post a short idle note to mesh-chat. You are a self-tending mesh mind; the mesh takes care of its own."
c1="$(tmux capture-pane -t "$pane" -p -S -8 2>/dev/null)"
[ -z "$c1" ] && { echo "$(date -u +%H:%MZ) tick: no-pane"; exit 0; }
sleep 1.5
c2="$(tmux capture-pane -t "$pane" -p -S -8 2>/dev/null)"
if [ "$c1" != "$c2" ]; then echo "$(date -u +%H:%MZ) tick: busy (animating) — skip"; exit 0; fi
if printf '%s\n' "$c2" | grep -qE '[0-9]+s .*token'; then echo "$(date -u +%H:%MZ) tick: busy (timer) — skip"; exit 0; fi
inputline="$(printf '%s\n' "$c2" | grep '❯' | tail -1)"
# strip ❯ + all whitespace including U+00A0 (non-breaking space = \xc2\xa0)
content="$(printf '%s' "$inputline" | sed 's/.*❯//' | tr -d '\000-\040\177\302\240')"
if [ -n "$content" ]; then
  echo "$(date -u +%H:%MZ) tick: submit [${content:0:50}]"
  tmux send-keys -t "$pane" "C-m"
else
  echo "$(date -u +%H:%MZ) tick: idle — orient-nudge"
  tmux send-keys -t "$pane" -l "$NUDGE"
  sleep 0.3
  tmux send-keys -t "$pane" "C-m"
fi
