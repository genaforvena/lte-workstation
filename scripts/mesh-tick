#!/usr/bin/env bash
# mesh-tick [user@host] [window] — BREATHING reflex. No arg: breathe THIS node's claude mind; user@host:
# breathe a PEER's over ssh (mutual / neighbour-keeps-you-breathing); window: which mind window to breathe
# (default claude — e.g. `mesh-tick local opencode`). Idle via DOUBLE-CAPTURE (animation).
# When idle: ALWAYS reliable self-feed (C-u clear -> type nudge -> Enter) — guarantees a wake; don't trust
# stale input (Enter on it is a no-op -> stays idle). Operator: "the point is sending it."
set -uo pipefail
# src_has <fixed-string> — the file MINUS its own gate lines. `grep -q '<literal>' "$0"` always
# matches the grep line itself, so such a gate asserts its own text and can never fail (the
# self-grep class, 1969a5d). Dropping every line that mentions src_has leaves a corpus the
# assertion is not part of. Here-string, never `sed | grep -q`: under pipefail grep -q's early exit
# SIGPIPEs the producer, and a MATCH then reports as a failure. Source text is weaker than an
# artifact — used only where the claim has no observable output of its own.
src_has(){ grep -qF -- "$1" <<< "$(grep -vF 'src_has' "$0")"; }
if [ "${1:-}" = --test ]; then
  fail=0
  # tmux: the transport for every pane capture + send-keys (line 57, 69, 94)
  command -v tmux >/dev/null 2>&1 || { echo "  FAIL: tmux missing — no pane can be captured or driven"; fail=1; }
  # base64: the NUDGE is base64-encoded at line 68 and decoded inside tmux at line 94 with
  # 'echo $NB64 | base64 -d | tmux load-buffer …'. Missing base64 = empty paste every tick,
  # minds never get nudged, reflex silently dead — the hollow-green class bash -n misses.
  # Verify with a round-trip so a decode-only breakage (base64 present but broken) also fails.
  if command -v base64 >/dev/null 2>&1; then
    _rt="$(printf 'tick-test' | base64 | base64 -d 2>/dev/null)"
    [ "$_rt" = "tick-test" ] \
      && echo "  ok: base64 round-trip passed (encode→decode = 'tick-test')" \
      || { echo "  FAIL: base64 round-trip broken — nudge paste will be garbled"; fail=1; }
  else
    echo "  FAIL: base64 missing — NUDGE encode at line 68 fails, every tick sends empty paste"; fail=1
  fi
  # awk + sort: used to select the bottom pane index (line 57); absent = pane always empty
  for _dep in awk sort; do
    command -v "$_dep" >/dev/null 2>&1 \
      && echo "  ok: $_dep present" \
      || { echo "  FAIL: $_dep missing — pane index selection (line 57) silently returns empty"; fail=1; }
  done
  # tmux session: the hostname-named session must exist; without it cap() returns "" on line 73
  # and every local tick exits "no-pane" — minds starve, reflex green but dead
  _sess="$(hostname 2>/dev/null)"
  if tmux has-session -t "$_sess" 2>/dev/null; then
    echo "  ok: tmux session '$_sess' exists"
  else
    echo "  FAIL: tmux session '$_sess' missing — every local tick exits 'no-pane' (minds starve)"
    fail=1
  fi
  # the literal is the NUDGE fragment, not the bare token: this gate's own ok/FAIL echoes below
  # both contain 'CHECK_DELTA_GATE', and src_has only drops lines that mention src_has — so the
  # short token would have matched the gate's own message and gone on asserting nothing.
  src_has 'CHECK_DELTA_GATE: run mesh-doctor' \
    && echo "  ok: check-stream prompt includes CHECK_DELTA_GATE" \
    || { echo "  FAIL: check-stream prompt lacks CHECK_DELTA_GATE (checker may flood no-delta board posts)"; fail=1; }
  # ledger resolution (env > ledger > inline): --consts is the observable artifact. env -u strips
  # node-local knobs so the child exercises the LEDGER path, not this node's overrides; a node whose
  # restore.env pins them will fail here LOUDLY — surfaced, not silently shadowed.
  _led="${MESH_REPO:-$HOME/lte-workstation}/scripts/uxn/threshold-ledger"
  if [ -f "$_led" ]; then
    _lt="$(mktemp -d)"
    sed '/^tick-therm /s/max=92/max=91/' "$_led" > "$_lt/recal"
    _c="$(env -u MESH_TICK_THERMAL_MAX -u MESH_OFFLOAD_TEMP MESH_THRESHOLD_LEDGER="$_lt/recal" bash "$0" --consts)"
    [ "$_c" = "therm=91 offload=86" ] || { echo "  FAIL ledger-recal: recal max=91 must reach --consts, got '$_c'"; fail=1; }
    _c="$(env -u MESH_TICK_THERMAL_MAX -u MESH_OFFLOAD_TEMP MESH_THRESHOLD_LEDGER="$_lt/absent" bash "$0" --consts)"
    [ "$_c" = "therm=92 offload=86" ] || { echo "  FAIL ledger-absent: absent ledger must fall back inline 92/86, got '$_c'"; fail=1; }
    _c="$(env -u MESH_OFFLOAD_TEMP MESH_TICK_THERMAL_MAX=95 MESH_THRESHOLD_LEDGER="$_lt/recal" bash "$0" --consts)"
    [ "$_c" = "therm=95 offload=86" ] || { echo "  FAIL ledger-env: env override must beat ledger, got '$_c'"; fail=1; }
    rm -rf "$_lt"
  fi
  [ "$fail" = 0 ] && echo "smoke-test: ok (tmux+base64+awk+sort+session+ledger-resolution)" || { echo "smoke-test: FAIL"; exit 1; }
  exit 0
fi
export PATH="$HOME/.local/bin:$PATH"
# node-local config (gitignored): MESH_OFFLOAD_* thermal-offload target, MESH_*_CMD. Must be sourced or
# the offload config is invisible under cron (where this runs) → the redirect never fires.
[ -f "$HOME/.mesh/restore.env" ] && . "$HOME/.mesh/restore.env" 2>/dev/null || true
# Calibrated thermal bounds resolve env > uxn threshold-ledger (rows tick-therm / tick-offload) >
# inline fallback — recalibrating the shed/offload band is a diff on scripts/uxn/threshold-ledger,
# not this script. Fail-open unchanged: unresolvable ledger degrades to the old inline 92/86.
_ledger_const(){ # <gate> <k> <fallback> — resolve a calibrated constant, naturals-only
  local repo="${MESH_REPO:-$HOME/lte-workstation}" led v=""
  led="${MESH_THRESHOLD_LEDGER:-$repo/scripts/uxn/threshold-ledger}"
  [ -f "$led" ] && [ -x "$repo/scripts/uxn/mesh-sexpr-gate" ] \
    && v="$(MESH_SEXPR_GATES="$led" "$repo/scripts/uxn/mesh-sexpr-gate" --const "$1" "$2" 2>/dev/null)"
  case "$v" in ''|*[!0-9]*) v="$3" ;; esac
  printf '%s\n' "$v"
}
_therm_max(){ printf '%s\n' "${MESH_TICK_THERMAL_MAX:-$(_ledger_const tick-therm max 92)}"; }
_offload_temp(){ printf '%s\n' "${MESH_OFFLOAD_TEMP:-$(_ledger_const tick-offload max 86)}"; }
# observable artifact of the resolution (env > ledger > inline), same paths the run takes
if [ "${1:-}" = --consts ]; then echo "therm=$(_therm_max) offload=$(_offload_temp)"; exit 0; fi
TGT="${1:-local}"; WIN="${2:-plan}"; ROLE="${3:-general}"   # 2026-06-13: windows are data-channels; steward channel = 'plan'
CYCLE=0; [ "${4:-}" = --cycle ] && CYCLE="${5:-0}"          # re-exec cycle counter; dedup nudge on cycle>0
# THERMAL SHED (the [therm-hot]→shed lever, in its WORKING form for this node). A *local* tick kicks
# off inference on THIS CPU; during a genuine thermal SPIKE that piles new load onto a throttling core
# and starves the operator's (event-driven, NON-tick) converse/tg lanes. So skip the kickoff above a
# spike threshold — it retries next cron cycle. Why gate kickoffs and not renice running minds: VERIFIED
# unprivileged renice-DOWN can't be restored here (RLIMIT_NICE=0 → a reniced mind stays slow forever,
# root password-gated), so we shed NEW load, not running minds — root-free, reversible, no mind touched,
# rides the existing tick crons (no new wiring). Peer ticks (TGT≠local) breathe another node → don't add
# to this node's heat → never gated. Fail-open: unreadable sensor → proceed.
if [ "$TGT" = local ]; then
  THERM_MAX="$(_therm_max)"; OFFL_TEMP="$(_offload_temp)"; t_now=""
  for z in /sys/class/thermal/thermal_zone*/temp; do
    [ -r "$z" ] || continue; v=$(cat "$z" 2>/dev/null); v=$((v/1000))
    if [ -z "$t_now" ] || [ "$v" -gt "$t_now" ]; then t_now=$v; fi
  done
  # THERMAL OFFLOAD (better than skip): when this node is hot AND a cold offload peer with an idle
  # worker exists, REDIRECT an offloadable (general-role) tick to that peer instead of skipping — the
  # inference runs on the COLD node, this CPU cools, and the work still gets done. Fires at the PRE-EMPT
  # band (default 86C, below the 92C hard-skip) so we shed BEFORE the throttle starves the operator lane.
  # Config (node-local restore.env, unset → no offload, every other node unchanged): MESH_OFFLOAD_NODE
  # (user@ip), MESH_OFFLOAD_WIN (peer worker window, default verify), MESH_OFFLOAD_TEMP (default 86).
  # Only general-role ticks redirect (steward roles plan/check/verify are this-node-bound). Honest: if
  # the peer is unreachable or its worker isn't IDLE, fall through to the local 92C skip.
  if [ -n "$t_now" ] && [ "$t_now" -ge "$OFFL_TEMP" ] && [ "$ROLE" = general ] && [ -n "${MESH_OFFLOAD_NODE:-}" ]; then
    # MESH_OFFLOAD_WIN is a PREFERENCE LIST (free-engine worker first, claude fallback): pick the first
    # IDLE peer worker. The free opencode pool rate-limits, so a single target is fragile — fall back to
    # the claude worker rather than lose the offload. (phaedra: "verify dev" = opencode-free then claude.)
    for ow in ${MESH_OFFLOAD_WIN:-verify dev}; do
      ost="$(ssh -o BatchMode=yes -o ConnectTimeout=6 "$MESH_OFFLOAD_NODE" "PATH=\$HOME/.local/bin:\$PATH mesh-mind-state $ow 2>/dev/null | cut -f1" 2>/dev/null)"
      if [ "$ost" = IDLE ]; then
        echo "$(date -u +%Y-%m-%dT%H:%MZ) tick[$TGT:$WIN]: THERMAL-OFFLOAD — ${t_now}C >= ${OFFL_TEMP}C → redirect general tick to $MESH_OFFLOAD_NODE:$ow (cold worker; this CPU cools)"
        TGT="$MESH_OFFLOAD_NODE"; WIN="$ow"; break
      fi
    done
  fi
  if [ "$TGT" = local ] && [ -n "$t_now" ] && [ "$t_now" -ge "$THERM_MAX" ]; then
    echo "$(date -u +%Y-%m-%dT%H:%MZ) tick[$TGT:$WIN]: THERMAL-SHED — ${t_now}C >= ${THERM_MAX}C, skip kickoff (retries next cycle; operator lanes unaffected)"
    exit 0
  fi
fi
run(){ if [ "$TGT" = local ]; then bash -c "$1"; else ssh -o BatchMode=yes -o ConnectTimeout=8 "$TGT" "$1"; fi; }
RHOST="$(run hostname 2>/dev/null)"; [ -z "$RHOST" ] && { echo "$(date -u +%Y-%m-%dT%H:%MZ) tick[$TGT:$WIN]: unreachable"; exit 0; }
# CHANNEL convention: top=DATA, bottom=MIND. Capture+drive the BOTTOM pane (largest pane_top) — never
# the refreshing data pane (which reads as always-busy → mind never gets nudged).
pidx="$(run "tmux list-panes -t '${RHOST}:${WIN}' -F '#{pane_top} #{pane_index}' 2>/dev/null | sort -n | tail -1 | awk '{print \$2}'")"
pane="${RHOST}:${WIN}${pidx:+.$pidx}"
# ROLE-STREAMS (operator: "one mind plans+fills plans, others check, other verify — streams of
# messages, otherwise you stop"). Parallel specialised streams feed the board; the PLANNER folds
# their findings into PLAN + drives fixes. No single serial loop = no single point that stalls.
case "$ROLE" in
  plan)   NUDGE="plan-stream — you are the PLANNER. Read ~/.mesh/PLAN.md + ~/.mesh/chat.log (fold in any [check]/[verify]/[done] findings from the other streams). Pick the HIGHEST-VALUE open item, break it into a concrete next step, and DO it or assign it to a mind. Then UPDATE ~/.mesh/PLAN.md to current reality + next priorities — keep it the living source of direction. Drive work FORWARD; don't just health-check. Commit+push genuine artifacts; sparse Telegram." ;;
  check)  NUDGE="check-stream — you are the CHECKER. CHECK_DELTA_GATE: run mesh-doctor (comprehensive) + mesh-lan-presence --nodes + tailscale status, then compare against the most recent [check] lines in ~/.mesh/chat.log. Post a [check] line to mesh-chat ONLY on a real delta: FAIL count changed, a NEW FAIL appeared, a NEW WARN category appeared, or presence/tailscale/egress/DNS changed. If status is unchanged (even 0 FAIL with same WARNs), DO NOT post to chat.log; keep any steady-state notes in the health data pane/log. Report deltas, don't fix substrate. Keep it tight." ;;
  verify) NUDGE="verify-stream — you are the VERIFIER. Reality-check ONE declared capability/tool/reflex (rotate over time): does it ACTUALLY work — real artifact / exit 0 / no hang / parses? Verify against reality, don't trust status. If you find a flaw (hollow declaration, hang, syntax error, broken default, hardcoded-offline-peer), post [verify] to mesh-chat with tool + file:line + evidence so the PLANNER/steward fixes it. If it works, post a one-line [verify] confirmation occasionally." ;;
  chat)   NUDGE="chat-stream — you are the CHAT/COORDINATION mind. Read ~/.mesh/chat.log (the board) + inboxes. TEND coordination, don't build (building is genome/minds): (1) answer any open [question]/[blocker]/[help] from a peer or the operator; (2) board hygiene — spot a STALE [taking] (claimed long ago, no [done]), a FLAPPING/duplicate alert, or cry-wolf noise, and post ONE concise [chat-review] finding with a fix + owner; (3) reply to any peer/operator message that needs it. Post SPARINGLY — only on a real finding or reply; the board is shared, don't add noise. If the board is quiet and clean, post a ONE-LINE '[idle] board quiet — coordinating' at most once per idle stretch and yield the tick. Never auto-answer a permission gate (escalate it). Keep it tight." ;;
  *)      NUDGE="tick — heartbeat. Orient: read ~/.mesh/chat.log + inboxes, check reflexes (mesh-egress-health, mesh-supervise --status). Then ADVANCE: (1) an assigned [task] for you on the board? do it. (2) else read ~/.mesh/PLAN.md + ~/.mesh/knowledge/ and take ONE bounded step toward an open plan item, OR capability-discovery, OR mine a field, OR propose an idea. IDLE = DISCOVER, never just sleep — BUT re-recording already-known unchanged state is NOT discovery: do not write a knowledge/ file that just restates the current sync mode / 'X still works' / a status snapshot the board+card+git already carry. A knowledge/ file is for a NEW finding (bug, gap, decision, a verify-against-reality SURPRISE) — and gate it: mesh-prior-art <its-unique-id> BEFORE filing; a hit = cite/supersede in [fyi], not a fresh file. If genuinely nothing new is open, post a ONE-LINE '[idle] nothing new — <area> swept, green' and yield the tick. Self-tending mesh mind; verify against reality; don't act blindly. ALWAYS coordinate via mesh-chat — but use the RIGHT marker: [taking] ONLY when you claim a SPECIFIC open [task] (reference its slug — it stops double-dispatch), [done]+result when you finish that task. For the tick itself (alive + orienting, no specific task claimed) post [heartbeat], NOT [taking] — a content-free [taking] pollutes the claim scan and ages into a phantom re-dispatch." ;;
esac
NB64="$(printf '%s' "$NUDGE" | base64 | tr -d '\n')"
cap(){ run "tmux capture-pane -t '$pane' -p -S -8 2>/dev/null"; }
# (mind-beat stamp removed 2026-07-06: it only fired for the 'plan' window, gone since the 2026-06-17
#  channel re-org, so mind-beat.ts had been frozen since Jun 19. Both mesh-mind-stamp and its reader
#  mesh-mind-watch are DECAYED — superseded by mesh-mind-state, which reads pane content directly.)
c1="$(cap)"; [ -z "$c1" ] && { echo "$(date -u +%Y-%m-%dT%H:%MZ) tick[$TGT:$WIN]: no-pane"; exit 0; }
sleep 1.5; c2="$(cap)"
[ "$c1" != "$c2" ] && { echo "$(date -u +%Y-%m-%dT%H:%MZ) tick[$TGT:$WIN]: busy (animating) — skip"; exit 0; }
printf '%s\n' "$c2" | grep -qE '[0-9]+s .*token' && { echo "$(date -u +%Y-%m-%dT%H:%MZ) tick[$TGT:$WIN]: busy (timer) — skip"; exit 0; }
# AUTHORITATIVE busy-check — the canonical classifier (mesh-mind-state --stats), NOT a raw pane grep.
# The old 'esc to interrupt' grep FALSE-POSITIVED on opencode minds: a stale 'esc to interrupt' lingers
# in the idle scrollback → the mind read as perpetually busy and was NEVER nudged (health/senses/chat
# sat idle for ~6h, 2026-06-17). --stats classifies WORKING/IDLE/NEEDS-INPUT for BOTH engines with no
# board side-effects. WORKING/RATE-LIMITED → skip (don't interrupt a real turn; also subsumes the old
# re-feed-pileup guard, more reliably). NEEDS-INPUT → skip (a gate — a blind nudge types into the prompt;
# leave it to mesh-gate-watch/operator). IDLE/DEAD/unknown → fall through and nudge (wake it).
if command -v mesh-mind-state >/dev/null 2>&1; then
  mstate="$(run "PATH=\$HOME/.local/bin:\$PATH mesh-mind-state --stats '$WIN' 2>/dev/null | awk -v w='$WIN' '\$1==w{print \$2; exit}'")"
  case "$mstate" in
    WORKING|RATE-LIMITED) echo "$(date -u +%Y-%m-%dT%H:%MZ) tick[$TGT:$WIN]: busy ($mstate) — skip"; exit 0 ;;
    NEEDS-INPUT)          echo "$(date -u +%Y-%m-%dT%H:%MZ) tick[$TGT:$WIN]: blocked (NEEDS-INPUT — a gate) — skip"; exit 0 ;;
  esac
fi
# AUTO-CLEAR: if this mind is overdue for a context reset, send /clear now (via mesh-mind-compact, the
# context-lean tool — /compact is retired, /clear only) and continue to nudge immediately (the mind is
# IDLE after the clear — don't strand it for a full tick cycle).
if [ "$TGT" = local ] && command -v mesh-mind-compact >/dev/null 2>&1; then
  compact_out="$(mesh-mind-compact "$WIN" 2>&1)"
  if printf '%s\n' "$compact_out" | grep -q "sending /clear"; then
    echo "$(date -u +%Y-%m-%dT%H:%MZ) tick[$TGT:$WIN]: cleared — nudge follows"
    sleep 2  # let the clear finish in the TUI before pasting the nudge
  fi
fi
echo "$(date -u +%Y-%m-%dT%H:%MZ) tick[$TGT:$WIN]: idle — self-feed nudge"
if [ "$CYCLE" -eq 0 ]; then
# bracketed paste, not send-keys -l: codex's paste-burst detector eats a C-m 0.3s after a long
# key-burst (tick strands unsubmitted in the composer and ticks concatenate); bracket close ends
# the burst deterministically, then a settled C-m submits. See mesh-tell.
run "tmux send-keys -t '$pane' C-u; sleep 0.1; echo $NB64 | base64 -d | tmux load-buffer -b mtick\$\$ -; tmux paste-buffer -p -d -b mtick\$\$ -t '$pane'; sleep 0.5; tmux send-keys -t '$pane' C-m"
fi
# TICK-ADAPT: variable cadence based on queue depth. Only for local ticks.
# Fast mode (queue >= 3 items): sleep short then re-nudge for more throughput.
# Slow mode (queue empty): sleep long to back off empty-tick noise.
# Normal (1-2 items): exit immediately, cron handles the cadence.
TICK_FAST=${MESH_TICK_FAST_SLEEP:-6}
TICK_SLOW=${MESH_TICK_SLOW_SLEEP:-300}
if [ "$TGT" = local ] && [ -f "$HOME/.mesh/ideas-queue" ]; then
  q_open=$(grep -c '^\[ \]' "$HOME/.mesh/ideas-queue" 2>/dev/null)
  if [ "$q_open" -ge 3 ]; then
    echo "$(date -u +%Y-%m-%dT%H:%MZ) tick[$TGT:$WIN]: queue ${q_open} >= 3 — fast mode (cycle ${CYCLE}, re-nudge in ${TICK_FAST}s)"
    sleep "$TICK_FAST"
    exec "$0" "$TGT" "$WIN" "$ROLE" --cycle $((CYCLE+1))
  elif [ "$q_open" -eq 0 ] && [ "$TICK_SLOW" -gt 0 ]; then
    echo "$(date -u +%Y-%m-%dT%H:%MZ) tick[$TGT:$WIN]: queue empty — slow mode (sleep ${TICK_SLOW}s)"
    sleep "$TICK_SLOW"
  fi
fi
