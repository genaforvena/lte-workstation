#!/usr/bin/env bash
# mesh-tick — cron-driven steward heartbeat (*/5 * * * *).
# Only fires when Claude is idle. Input line is always 3rd from bottom.
export PATH="$HOME/.local/bin:$PATH"
SESSION="$(hostname)"
pane="${SESSION}:claude"

bottom="$(tmux capture-pane -t "$pane" -p -S -3 2>/dev/null)"
status_line="$(echo "$bottom" | tail -1)"
input_line="$(echo "$bottom" | head -1)"

# Skip when Claude is actively rendering (esc to interrupt only appears mid-response)
if echo "$status_line" | grep -q 'esc to interrupt'; then
    echo "$(date -u +%H:%MZ) tick: busy — skip"
    exit 0
fi

# strip ❯ and all whitespace including non-breaking space (U+00A0, \xc2\xa0)
content="$(echo "$input_line" | grep -o '❯.*' | sed 's/❯//' | tr -d '\000-\040\177\302\240')"

if [ -n "$content" ]; then
    echo "$(date -u +%H:%MZ) tick: submit [${content:0:60}]"
    tmux send-keys -t "$pane" "C-m"
else
    echo "$(date -u +%H:%MZ) tick: idle — nudge"
    tmux send-keys -t "$pane" -l "tick"
    sleep 0.3
    tmux send-keys -t "$pane" "C-m"
fi
