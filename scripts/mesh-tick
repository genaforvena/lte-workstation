#!/usr/bin/env bash
# mesh-tick — BREATHING reflex (*/5). Wakes the IDLE claude mind via the PROVEN reliable self-feed:
#   C-u (clear input) -> send-keys -l (type) -> Enter (submit).
# Idle-vs-busy by DOUBLE-CAPTURE (animation): footer text (esc-to-interrupt/shift+tab) is ALWAYS present
# so only the spinner animation distinguishes states. NBSP (U+00A0) trailing the ❯ is cleared by C-u.
export PATH="$HOME/.local/bin:$PATH"
SESSION="$(hostname)"; pane="${SESSION}:claude"
NUDGE="tick — idle heartbeat. Orient yourself: read ~/.mesh/chat.log (peer coordination) and your channel inboxes, check reflex status (mesh-egress-health, mesh-supervise --status, mesh-breath), and the roadmap. Then do ONE bounded useful step, or post a short idle note to mesh-chat. You are a self-tending mesh mind; the mesh takes care of its own."
selffeed(){ tmux send-keys -t "$pane" C-u; sleep 0.1; tmux send-keys -t "$pane" -l "$1"; sleep 0.2; tmux send-keys -t "$pane" Enter; }
c1="$(tmux capture-pane -t "$pane" -p -S -8 2>/dev/null)"
[ -z "$c1" ] && { echo "$(date -u +%H:%MZ) tick: no-pane"; exit 0; }
sleep 1.5
c2="$(tmux capture-pane -t "$pane" -p -S -8 2>/dev/null)"
[ "$c1" != "$c2" ] && { echo "$(date -u +%H:%MZ) tick: busy (animating) — skip"; exit 0; }
printf '%s\n' "$c2" | grep -qE '[0-9]+s .*token' && { echo "$(date -u +%H:%MZ) tick: busy (timer) — skip"; exit 0; }
inputline="$(printf '%s\n' "$c2" | grep '❯' | tail -1)"
content="$(printf '%s' "$inputline" | sed -e 's/.*❯//' -e 's/\xc2\xa0//g' | tr -d '[:space:]')"
if [ -n "$content" ]; then
  echo "$(date -u +%H:%MZ) tick: submit-existing [${content:0:40}]"; tmux send-keys -t "$pane" Enter
else
  echo "$(date -u +%H:%MZ) tick: idle — self-feed orient-nudge"; selffeed "$NUDGE"
fi
