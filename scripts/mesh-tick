#!/usr/bin/env bash
# mesh-tick [user@host] — BREATHING reflex. No arg: breathe THIS node's claude mind; user@host: breathe a
# PEER's over ssh (mutual / neighbour-keeps-you-breathing). Idle via DOUBLE-CAPTURE (animation).
# When idle: ALWAYS reliable self-feed (C-u clear -> type nudge -> Enter) — guarantees a wake; don't trust
# stale input (Enter on it is a no-op -> stays idle). Operator: "the point is sending it."
export PATH="$HOME/.local/bin:$PATH"
TGT="${1:-local}"
run(){ if [ "$TGT" = local ]; then bash -c "$1"; else ssh -o BatchMode=yes -o ConnectTimeout=8 "$TGT" "$1"; fi; }
RHOST="$(run hostname 2>/dev/null)"; [ -z "$RHOST" ] && { echo "$(date -u +%H:%MZ) tick[$TGT]: unreachable"; exit 0; }
pane="${RHOST}:claude"
NUDGE="tick — idle heartbeat. Orient: read ~/.mesh/chat.log + your inboxes, check reflexes (mesh-egress-health, mesh-supervise --status, mesh-breath) + roadmap. Do ONE bounded step or post an idle note to mesh-chat. Self-tending mesh mind; the mesh takes care of its own."
NB64="$(printf '%s' "$NUDGE" | base64 | tr -d '\n')"
cap(){ run "tmux capture-pane -t '$pane' -p -S -8 2>/dev/null"; }
c1="$(cap)"; [ -z "$c1" ] && { echo "$(date -u +%H:%MZ) tick[$TGT]: no-pane"; exit 0; }
sleep 1.5; c2="$(cap)"
[ "$c1" != "$c2" ] && { echo "$(date -u +%H:%MZ) tick[$TGT]: busy (animating) — skip"; exit 0; }
printf '%s\n' "$c2" | grep -qE '[0-9]+s .*token' && { echo "$(date -u +%H:%MZ) tick[$TGT]: busy (timer) — skip"; exit 0; }
echo "$(date -u +%H:%MZ) tick[$TGT]: idle — self-feed nudge"
run "tmux send-keys -t '$pane' C-u; sleep 0.1; tmux send-keys -t '$pane' -l \"\$(echo $NB64 | base64 -d)\"; sleep 0.3; tmux send-keys -t '$pane' C-m"
