#!/usr/bin/env bash
# mesh-tick — the BREATHING reflex (*/5). Wake the IDLE claude mind and feed it back into mesh state.
# BUSY is detected by 'esc to interrupt' (shown ONLY while rendering). The mode footer ('auto mode on'
# etc.) confirms a live waiting prompt. Earlier bug: 'shift+tab to cycle' is ALWAYS present (idle AND
# busy), so the tick fired during rendering and its keystrokes got eaten.
export PATH="$HOME/.local/bin:$PATH"
SESSION="$(hostname)"; pane="${SESSION}:claude"
NUDGE="tick — idle heartbeat. Orient yourself: read ~/.mesh/chat.log (peer coordination) and your channel inboxes, check reflex status (mesh-egress-health, mesh-supervise --status, mesh-breath), and the roadmap. Then do ONE bounded useful step, or post a short idle note to mesh-chat. You are a self-tending mesh mind; the mesh takes care of its own."
cap="$(tmux capture-pane -t "$pane" -p -S -12 2>/dev/null)"
[ -z "$cap" ] && { echo "$(date -u +%H:%MZ) tick: no-pane"; exit 0; }
# BUSY (rendering) -> skip. This is the fix: 'esc to interrupt' shows only mid-response.
if printf '%s\n' "$cap" | grep -q 'esc to interrupt'; then
  echo "$(date -u +%H:%MZ) tick: busy — skip"; exit 0; fi
# must be at a live waiting prompt
if ! printf '%s\n' "$cap" | grep -qE 'auto mode on|accept edits|plan mode|bypass'; then
  echo "$(date -u +%H:%MZ) tick: no-prompt — skip"; exit 0; fi
inputline="$(printf '%s\n' "$cap" | grep '❯' | tail -1)"
content="$(printf '%s' "$inputline" | sed 's/.*❯[[:space:]]*//' | tr -d '[:space:]')"
if [ -n "$content" ]; then
  echo "$(date -u +%H:%MZ) tick: submit [${content:0:50}]"; tmux send-keys -t "$pane" Enter
else
  echo "$(date -u +%H:%MZ) tick: idle — orient-nudge"
  tmux send-keys -t "$pane" -l "$NUDGE"; sleep 0.15; tmux send-keys -t "$pane" Enter
fi
