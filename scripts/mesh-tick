#!/usr/bin/env bash
# mesh-tick — heartbeat press into this node's claude window.
# If the input buffer has content: Enter submits it.
# If empty: Tab+Enter nudges the steward awake.
SESSION="$(hostname)"
pane="${SESSION}:claude"
# capture enough lines to see the ❯ input line (it sits above the status bar)
line="$(tmux capture-pane -t "$pane" -p -S -5 2>/dev/null | grep -o '❯.*' | tail -1 | sed 's/❯[[:space:]]*//' | tr -d '[:space:]')"
if [ -n "$line" ]; then
    echo "$(date -u +%H:%MZ) tick: submitting [${line:0:60}]"
    tmux send-keys -t "$pane" Enter
else
    echo "$(date -u +%H:%MZ) tick: empty — nudging"
    tmux send-keys -t "$pane" -l "tick"
    sleep 0.1
    tmux send-keys -t "$pane" Enter
fi
