#!/usr/bin/env bash
# mesh-tick — cron heartbeat (*/5). The mesh's BREATHING reflex: when the claude mind is idle, feed it
# back into the mesh state so it SEES what's happening and takes the next step (not a bare 'tick').
# Idle is detected by the footer hint 'shift+tab to cycle' (shows ONLY when waiting for input — precise,
# unlike bare 'auto mode' which appears in content). Position-independent: finds ❯ input line anywhere.
export PATH="$HOME/.local/bin:$PATH"
SESSION="$(hostname)"; pane="${SESSION}:claude"
NUDGE="tick — idle heartbeat. Orient yourself: read ~/.mesh/chat.log (peer coordination) and your channel inboxes, check reflex status (mesh-egress-health, mesh-supervise --status, mesh-breath), and the roadmap. Then do ONE bounded useful step, or post a short idle note to mesh-chat. You are a self-tending mesh mind; the mesh takes care of its own."
cap="$(tmux capture-pane -t "$pane" -p -S -12 2>/dev/null)"
[ -z "$cap" ] && { echo "$(date -u +%H:%MZ) tick: no-pane"; exit 0; }
# IDLE only when the waiting-footer hint is present; else mid-response/dialog -> skip
if ! printf '%s\n' "$cap" | grep -q 'shift+tab to cycle'; then
  echo "$(date -u +%H:%MZ) tick: busy — skip"; exit 0
fi
inputline="$(printf '%s\n' "$cap" | grep '❯' | tail -1)"
content="$(printf '%s' "$inputline" | sed 's/.*❯[[:space:]]*//' | tr -d '[:space:]')"
if [ -n "$content" ]; then
  echo "$(date -u +%H:%MZ) tick: submit [${content:0:50}]"
  tmux send-keys -t "$pane" Enter
else
  echo "$(date -u +%H:%MZ) tick: idle — orient-nudge"
  tmux send-keys -t "$pane" -l "$NUDGE"; sleep 0.15; tmux send-keys -t "$pane" Enter
fi
