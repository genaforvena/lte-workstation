#!/usr/bin/env bash
# mesh-tick [user@host] [window] — BREATHING reflex. No arg: breathe THIS node's claude mind; user@host:
# breathe a PEER's over ssh (mutual / neighbour-keeps-you-breathing); window: which mind window to breathe
# (default claude — e.g. `mesh-tick local opencode`). Idle via DOUBLE-CAPTURE (animation).
# When idle: ALWAYS reliable self-feed (C-u clear -> type nudge -> Enter) — guarantees a wake; don't trust
# stale input (Enter on it is a no-op -> stays idle). Operator: "the point is sending it."
set -uo pipefail
if [ "${1:-}" = --test ]; then
  fail=0
  # tmux: the transport for every pane capture + send-keys (line 57, 69, 94)
  command -v tmux >/dev/null 2>&1 || { echo "  FAIL: tmux missing — no pane can be captured or driven"; fail=1; }
  # base64: the NUDGE is base64-encoded at line 68 and decoded inside tmux at line 94 with
  # 'echo $NB64 | base64 -d | tmux load-buffer …'. Missing base64 = empty paste every tick,
  # minds never get nudged, reflex silently dead — the hollow-green class bash -n misses.
  # Verify with a round-trip so a decode-only breakage (base64 present but broken) also fails.
  if command -v base64 >/dev/null 2>&1; then
    _rt="$(printf 'tick-test' | base64 | base64 -d 2>/dev/null)"
    [ "$_rt" = "tick-test" ] \
      && echo "  ok: base64 round-trip passed (encode→decode = 'tick-test')" \
      || { echo "  FAIL: base64 round-trip broken — nudge paste will be garbled"; fail=1; }
  else
    echo "  FAIL: base64 missing — NUDGE encode at line 68 fails, every tick sends empty paste"; fail=1
  fi
  # awk + sort: used to select the bottom pane index (line 57); absent = pane always empty
  for _dep in awk sort; do
    command -v "$_dep" >/dev/null 2>&1 \
      && echo "  ok: $_dep present" \
      || { echo "  FAIL: $_dep missing — pane index selection (line 57) silently returns empty"; fail=1; }
  done
  # tmux session: the hostname-named session must exist; without it cap() returns "" on line 73
  # and every local tick exits "no-pane" — minds starve, reflex green but dead
  _sess="$(hostname 2>/dev/null)"
  if tmux has-session -t "$_sess" 2>/dev/null; then
    echo "  ok: tmux session '$_sess' exists"
  else
    echo "  FAIL: tmux session '$_sess' missing — every local tick exits 'no-pane' (minds starve)"
    fail=1
  fi
  [ "$fail" = 0 ] && echo "smoke-test: ok (tmux+base64+awk+sort+session)" || { echo "smoke-test: FAIL"; exit 1; }
  exit 0
fi
export PATH="$HOME/.local/bin:$PATH"
# node-local config (gitignored): MESH_OFFLOAD_* thermal-offload target, MESH_*_CMD. Must be sourced or
# the offload config is invisible under cron (where this runs) → the redirect never fires.
[ -f "$HOME/.mesh/restore.env" ] && . "$HOME/.mesh/restore.env" 2>/dev/null || true
TGT="${1:-local}"; WIN="${2:-plan}"; ROLE="${3:-general}"   # 2026-06-13: windows are data-channels; steward channel = 'plan'
CYCLE=0; [ "${4:-}" = --cycle ] && CYCLE="${5:-0}"          # re-exec cycle counter; dedup nudge on cycle>0
# THERMAL SHED (the [therm-hot]→shed lever, in its WORKING form for this node). A *local* tick kicks
# off inference on THIS CPU; during a genuine thermal SPIKE that piles new load onto a throttling core
# and starves the operator's (event-driven, NON-tick) converse/tg lanes. So skip the kickoff above a
# spike threshold — it retries next cron cycle. Why gate kickoffs and not renice running minds: VERIFIED
# unprivileged renice-DOWN can't be restored here (RLIMIT_NICE=0 → a reniced mind stays slow forever,
# root password-gated), so we shed NEW load, not running minds — root-free, reversible, no mind touched,
# rides the existing tick crons (no new wiring). Peer ticks (TGT≠local) breathe another node → don't add
# to this node's heat → never gated. Fail-open: unreadable sensor → proceed.
if [ "$TGT" = local ]; then
  THERM_MAX="${MESH_TICK_THERMAL_MAX:-92}"; t_now=""
  for z in /sys/class/thermal/thermal_zone*/temp; do
    [ -r "$z" ] || continue; v=$(cat "$z" 2>/dev/null); v=$((v/1000))
    if [ -z "$t_now" ] || [ "$v" -gt "$t_now" ]; then t_now=$v; fi
  done
  # THERMAL OFFLOAD (better than skip): when this node is hot AND a cold offload peer with an idle
  # worker exists, REDIRECT an offloadable (general-role) tick to that peer instead of skipping — the
  # inference runs on the COLD node, this CPU cools, and the work still gets done. Fires at the PRE-EMPT
  # band (default 86C, below the 92C hard-skip) so we shed BEFORE the throttle starves the operator lane.
  # Config (node-local restore.env, unset → no offload, every other node unchanged): MESH_OFFLOAD_NODE
  # (user@ip), MESH_OFFLOAD_WIN (peer worker window, default verify), MESH_OFFLOAD_TEMP (default 86).
  # Only general-role ticks redirect (steward roles plan/check/verify are this-node-bound). Honest: if
  # the peer is unreachable or its worker isn't IDLE, fall through to the local 92C skip.
  if [ -n "$t_now" ] && [ "$t_now" -ge "${MESH_OFFLOAD_TEMP:-86}" ] && [ "$ROLE" = general ] && [ -n "${MESH_OFFLOAD_NODE:-}" ]; then
    # MESH_OFFLOAD_WIN is a PREFERENCE LIST (free-engine worker first, claude fallback): pick the first
    # IDLE peer worker. The free opencode pool rate-limits, so a single target is fragile — fall back to
    # the claude worker rather than lose the offload. (phaedra: "verify dev" = opencode-free then claude.)
    for ow in ${MESH_OFFLOAD_WIN:-verify dev}; do
      ost="$(ssh -o BatchMode=yes -o ConnectTimeout=6 "$MESH_OFFLOAD_NODE" "PATH=\$HOME/.local/bin:\$PATH mesh-mind-state $ow 2>/dev/null | cut -f1" 2>/dev/null)"
      if [ "$ost" = IDLE ]; then
        echo "$(date -u +%Y-%m-%dT%H:%MZ) tick[$TGT:$WIN]: THERMAL-OFFLOAD — ${t_now}C >= ${MESH_OFFLOAD_TEMP:-86}C → redirect general tick to $MESH_OFFLOAD_NODE:$ow (cold worker; this CPU cools)"
        TGT="$MESH_OFFLOAD_NODE"; WIN="$ow"; break
      fi
    done
  fi
  if [ "$TGT" = local ] && [ -n "$t_now" ] && [ "$t_now" -ge "$THERM_MAX" ]; then
    echo "$(date -u +%Y-%m-%dT%H:%MZ) tick[$TGT:$WIN]: THERMAL-SHED — ${t_now}C >= ${THERM_MAX}C, skip kickoff (retries next cycle; operator lanes unaffected)"
    exit 0
  fi
fi
run(){ if [ "$TGT" = local ]; then bash -c "$1"; else ssh -o BatchMode=yes -o ConnectTimeout=8 "$TGT" "$1"; fi; }
RHOST="$(run hostname 2>/dev/null)"; [ -z "$RHOST" ] && { echo "$(date -u +%Y-%m-%dT%H:%MZ) tick[$TGT:$WIN]: unreachable"; exit 0; }
# CHANNEL convention: top=DATA, bottom=MIND. Capture+drive the BOTTOM pane (largest pane_top) — never
# the refreshing data pane (which reads as always-busy → mind never gets nudged).
pidx="$(run "tmux list-panes -t '${RHOST}:${WIN}' -F '#{pane_top} #{pane_index}' 2>/dev/null | sort -n | tail -1 | awk '{print \$2}'")"
pane="${RHOST}:${WIN}${pidx:+.$pidx}"
# ROLE-STREAMS (operator: "one mind plans+fills plans, others check, other verify — streams of
# messages, otherwise you stop"). Parallel specialised streams feed the board; the PLANNER folds
# their findings into PLAN + drives fixes. No single serial loop = no single point that stalls.
case "$ROLE" in
  plan)   NUDGE="plan-stream — you are the PLANNER. Read ~/.mesh/PLAN.md + ~/.mesh/chat.log (fold in any [check]/[verify]/[done] findings from the other streams). Pick the HIGHEST-VALUE open item, break it into a concrete next step, and DO it or assign it to a mind. Then UPDATE ~/.mesh/PLAN.md to current reality + next priorities — keep it the living source of direction. Drive work FORWARD; don't just health-check. Commit+push genuine artifacts; sparse Telegram." ;;
  check)  NUDGE="check-stream — you are the CHECKER. Run mesh-doctor (comprehensive). Detect CHANGE: mesh-lan-presence --nodes + tailscale status (a peer back? a reflex down? egress regressed?). Post a [check] line to mesh-chat with any FAIL/WARN/change so the PLANNER can act (or '[check] all green' once if nothing, sparingly). Report, don't fix substrate. Keep it tight." ;;
  verify) NUDGE="verify-stream — you are the VERIFIER. Reality-check ONE declared capability/tool/reflex (rotate over time): does it ACTUALLY work — real artifact / exit 0 / no hang / parses? Verify against reality, don't trust status. If you find a flaw (hollow declaration, hang, syntax error, broken default, hardcoded-offline-peer), post [verify] to mesh-chat with tool + file:line + evidence so the PLANNER/steward fixes it. If it works, post a one-line [verify] confirmation occasionally." ;;
  *)      NUDGE="tick — heartbeat. Orient: read ~/.mesh/chat.log + inboxes, check reflexes (mesh-egress-health, mesh-supervise --status). Then ADVANCE: (1) an assigned [task] for you on the board? do it. (2) else read ~/.mesh/PLAN.md + ~/.mesh/knowledge/ and take ONE bounded step toward an open plan item, OR capability-discovery, OR mine a field, OR propose an idea. IDLE = DISCOVER, never just sleep — BUT re-recording already-known unchanged state is NOT discovery: do not write a knowledge/ file that just restates the current sync mode / 'X still works' / a status snapshot the board+card+git already carry. A knowledge/ file is for a NEW finding (bug, gap, decision, a verify-against-reality SURPRISE). If genuinely nothing new is open, post a ONE-LINE '[idle] nothing new — <area> swept, green' and yield the tick. Self-tending mesh mind; verify against reality; don't act blindly. ALWAYS coordinate via mesh-chat: post [taking] when you start, [done]+result when you finish — report so the other minds and the steward see it." ;;
esac
NB64="$(printf '%s' "$NUDGE" | base64 | tr -d '\n')"
cap(){ run "tmux capture-pane -t '$pane' -p -S -8 2>/dev/null"; }
# mind-beat: a LOCAL claude that is alive stamps its beat so mesh-mind-watch can tell mind-down from
# node-down. Animating/timer = provably thinking → stamp on its behalf (reliable, no agent memory).
mindbeat(){ [ "$TGT" = local ] && [ "$WIN" = plan ] && command -v mesh-mind-stamp >/dev/null 2>&1 && mesh-mind-stamp >/dev/null 2>&1 || true; }
c1="$(cap)"; [ -z "$c1" ] && { echo "$(date -u +%Y-%m-%dT%H:%MZ) tick[$TGT:$WIN]: no-pane"; exit 0; }
sleep 1.5; c2="$(cap)"
[ "$c1" != "$c2" ] && { mindbeat; echo "$(date -u +%Y-%m-%dT%H:%MZ) tick[$TGT:$WIN]: busy (animating) — skip"; exit 0; }
printf '%s\n' "$c2" | grep -qE '[0-9]+s .*token' && { mindbeat; echo "$(date -u +%Y-%m-%dT%H:%MZ) tick[$TGT:$WIN]: busy (timer) — skip"; exit 0; }
# "esc to interrupt"/"esc to cancel" = a mid-turn agent that is momentarily STATIC (between tool calls,
# no animation/timer in the 1.5s window) — the gap that let a long tick get re-fed ~10x + pile up. Only
# shows during an active turn (the TUI replaces it with the prompt when done), so it never blocks a real idle.
printf '%s\n' "$c2" | grep -qiE 'esc to interrupt|esc to cancel' && { mindbeat; echo "$(date -u +%Y-%m-%dT%H:%MZ) tick[$TGT:$WIN]: busy (interruptible turn) — skip"; exit 0; }
# AUTO-COMPACT: if this mind is overdue for /compact, send it now and then continue to nudge
# immediately (the mind is IDLE after compact — don't strand it for a full tick cycle).
if [ "$TGT" = local ] && command -v mesh-mind-compact >/dev/null 2>&1; then
  compact_out="$(mesh-mind-compact "$WIN" 2>&1)"
  if printf '%s\n' "$compact_out" | grep -q "sending /compact"; then
    echo "$(date -u +%Y-%m-%dT%H:%MZ) tick[$TGT:$WIN]: compacted — nudge follows"
    sleep 2  # let compact finish in the TUI before pasting the nudge
  fi
fi
echo "$(date -u +%Y-%m-%dT%H:%MZ) tick[$TGT:$WIN]: idle — self-feed nudge"
if [ "$CYCLE" -eq 0 ]; then
# bracketed paste, not send-keys -l: codex's paste-burst detector eats a C-m 0.3s after a long
# key-burst (tick strands unsubmitted in the composer and ticks concatenate); bracket close ends
# the burst deterministically, then a settled C-m submits. See mesh-tell.
run "tmux send-keys -t '$pane' C-u; sleep 0.1; echo $NB64 | base64 -d | tmux load-buffer -b mtick\$\$ -; tmux paste-buffer -p -d -b mtick\$\$ -t '$pane'; sleep 0.5; tmux send-keys -t '$pane' C-m"
fi
# TICK-ADAPT: variable cadence based on queue depth. Only for local ticks.
# Fast mode (queue >= 3 items): sleep short then re-nudge for more throughput.
# Slow mode (queue empty): sleep long to back off empty-tick noise.
# Normal (1-2 items): exit immediately, cron handles the cadence.
TICK_FAST=${MESH_TICK_FAST_SLEEP:-6}
TICK_SLOW=${MESH_TICK_SLOW_SLEEP:-300}
if [ "$TGT" = local ] && [ -f "$HOME/.mesh/ideas-queue" ]; then
  q_open=$(grep -c '^\[ \]' "$HOME/.mesh/ideas-queue" 2>/dev/null)
  if [ "$q_open" -ge 3 ]; then
    echo "$(date -u +%Y-%m-%dT%H:%MZ) tick[$TGT:$WIN]: queue ${q_open} >= 3 — fast mode (cycle ${CYCLE}, re-nudge in ${TICK_FAST}s)"
    sleep "$TICK_FAST"
    exec "$0" "$TGT" "$WIN" "$ROLE" --cycle $((CYCLE+1))
  elif [ "$q_open" -eq 0 ] && [ "$TICK_SLOW" -gt 0 ]; then
    echo "$(date -u +%Y-%m-%dT%H:%MZ) tick[$TGT:$WIN]: queue empty — slow mode (sleep ${TICK_SLOW}s)"
    sleep "$TICK_SLOW"
  fi
fi
