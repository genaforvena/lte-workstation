#!/usr/bin/env bash
# mesh-hledger-reconcile — report-only reconciliation of independent coordination sources.
#
# The board and source feeds remain authoritative. This tool freezes one UTC cutoff, records a
# watermark for every source, classifies disagreement, and never edits a journal or routes work.
# reflex-cadence: 27 * * * *
# reflex-args: --run
set -euo pipefail

MESH="${MESH:-${HOME:-/tmp}/.mesh}"
# A deployed copy lives in ~/.local/bin, so its dirname is not the genome checkout. Follow the
# repository contract used by the other genome tools; keep the explicit replay override first.
REPO="${MESH_RECON_REPO:-${MESH_REPO:-${HOME:-/tmp}/lte-workstation}}"
LOG="${MESH_CHAT_LOG:-$MESH/chat.log}"
OUT="${MESH_RECON_OUTPUT:-$MESH/reconciliation/latest.txt}"
CUTOFF=""

if [ "${1:-}" = --test ]; then
  if [ -f "$REPO/tests/test-mesh-hledger-reconcile.sh" ]; then
    bash "$REPO/tests/test-mesh-hledger-reconcile.sh"
  else
    bash -n "$0"
    echo 'mesh-hledger-reconcile --test: PASS (syntax; external fixture unavailable)'
  fi
  exit 0
fi

usage(){
  cat <<'EOF'
mesh-hledger-reconcile — hourly, frozen-cutoff, report-only source reconciliation
  --cutoff ISO-8601-UTC   use an explicit frozen cutoff (default: invocation time)
  --output PATH           write the receipt (default: ~/.mesh/reconciliation/latest.txt)
  --help                  show this help

Sources: board/chat, task replay, git history, receipt artifacts, and the existing accounting
checks. Missing or unavailable sources are UNKNOWN. Adjustment policy is PROPOSE_ONLY.
EOF
}
while [ "$#" -gt 0 ]; do
  case "$1" in
    --cutoff) CUTOFF="${2:-}"; shift 2;;
    --output) OUT="${2:-}"; shift 2;;
    --run) shift;;
    --help|-h) usage; exit 0;;
    *) echo "mesh-hledger-reconcile: unknown argument: $1" >&2; exit 2;;
  esac
done

if [ -z "$CUTOFF" ]; then CUTOFF="$(date -u +%Y-%m-%dT%H:%M:%SZ)"; fi
if ! date -u -d "$CUTOFF" '+%Y-%m-%dT%H:%M:%SZ' >/dev/null 2>&1; then
  echo "mesh-hledger-reconcile: invalid cutoff: $CUTOFF" >&2; exit 2
fi
mkdir -p "$(dirname "$OUT")"
T="$(mktemp -d -t mesh-hledger-reconcile.XXXXXX)"
trap 'rm -rf "$T"' EXIT

sha(){ sha256sum "$1" | awk '{print $1}'; }
emit_file_source(){
  local name="$1" path="$2" count hash mtime
  if [ ! -f "$path" ]; then
    printf 'source=%s status=UNKNOWN reason=unavailable path=%s\n' "$name" "$path"; return
  fi
  count="$(awk -v cut="$CUTOFF" 'NF && $1 <= cut {n++} END {print n+0}' "$path")"
  hash="$(sha "$path")"; mtime="$(stat -c %Y "$path" 2>/dev/null || echo UNKNOWN)"
  printf 'source=%s status=KNOWN count=%s watermark=count:%s,sha256:%s,mtime:%s\n' \
    "$name" "$count" "$count" "$hash" "$mtime"
}
emit_file_source board "$LOG" >/dev/null

task_out="$T/tasks"
if task_text="$(mesh-task replay --json 2>/dev/null)"; then
  printf '%s' "$task_text" > "$task_out"
  task_count="$(printf '%s' "$task_text" | grep -o '"id"' | wc -l | tr -d ' ')"
  task_hash="$(sha "$task_out")"
  printf 'source=task status=KNOWN count=%s watermark=sha256:%s\n' "$task_count" "$(sha "$task_out")" >/dev/null
else
  task_count=UNKNOWN
  task_hash=UNKNOWN
  printf 'source=task status=UNKNOWN reason=unavailable\n' >/dev/null
fi

artifact_dir="$REPO/docs/task-receipts"
if [ -d "$artifact_dir" ]; then
  artifact_count="$(find "$artifact_dir" -type f ! -newermt "$CUTOFF" -print 2>/dev/null | wc -l | tr -d ' ')"
  artifact_hash="$(find "$artifact_dir" -type f ! -newermt "$CUTOFF" -print0 2>/dev/null | sort -z | xargs -0r sha256sum | sha256sum | awk '{print $1}')"
  printf 'source=artifacts status=KNOWN count=%s watermark=count:%s,sha256:%s,cutoff:%s\n' \
    "$artifact_count" "$artifact_count" "${artifact_hash:-EMPTY}" "$CUTOFF" >/dev/null
else
  artifact_count=UNKNOWN
  artifact_hash=UNKNOWN
  printf 'source=artifacts status=UNKNOWN reason=unavailable path=%s\n' "$artifact_dir" >/dev/null
fi

if git -C "$REPO" rev-parse --git-dir >/dev/null 2>&1; then
  git_count="$(git -C "$REPO" log --since='1970-01-01' --until="$CUTOFF" --format='%H' | wc -l | tr -d ' ')"
  git_hash="$(git -C "$REPO" log --since='1970-01-01' --until="$CUTOFF" --format='%H' | sha256sum | awk '{print $1}')"
  printf 'source=git status=KNOWN count=%s watermark=count:%s,sha256:%s,cutoff:%s\n' "$git_count" "$git_count" "$git_hash" "$CUTOFF" >/dev/null
else
  git_count=UNKNOWN
  git_hash=UNKNOWN
  printf 'source=git status=UNKNOWN reason=unavailable\n' >/dev/null
fi

check_source(){
  local name="$1" bin="$2"
  if ! command -v "$bin" >/dev/null 2>&1; then printf 'source=%s status=UNKNOWN reason=unavailable\n' "$name"; return; fi
  if timeout 30 "$bin" --check >/dev/null 2>&1; then
    printf 'source=%s status=KNOWN verdict=PASS\n' "$name"
  else
    local rc=$?; if [ "$rc" -eq 124 ]; then printf 'source=%s status=UNKNOWN reason=timeout\n' "$name"; else printf 'source=%s status=KNOWN verdict=FAIL\n' "$name"; fi
  fi
}
promises_status="$(check_source promises mesh-promises)"
ledger_status="$(check_source ledger mesh-ledger)"
labor_status="$(check_source labor mesh-labor)"

board_count="$(awk -v cut="$CUTOFF" 'NF && $1 <= cut && $0 ~ /\[task\]/ {n++} END {print n+0}' "$LOG" 2>/dev/null || echo UNKNOWN)"
if [ "$board_count" = UNKNOWN ] || [ "$task_count" = UNKNOWN ]; then
  printf 'difference_class=UNKNOWN reason=source-unavailable\n' >/dev/null
elif [ "$board_count" -eq "$task_count" ]; then
  printf 'difference_class=MATCH board_tasks=%s replay_tasks=%s\n' "$board_count" "$task_count" >/dev/null
else
  printf 'difference_class=SOURCE_ONLY board_tasks=%s replay_tasks=%s\n' "$board_count" "$task_count" >/dev/null
fi
{
  printf 'cadence=hourly\ncutoff=%s\n' "$CUTOFF"
  emit_file_source board "$LOG"
  if [ "$task_count" = UNKNOWN ]; then printf 'source=task status=UNKNOWN reason=unavailable\n'; else printf 'source=task status=KNOWN count=%s watermark=count:%s,sha256:%s\n' "$task_count" "$task_count" "$task_hash"; fi
  if [ "$artifact_count" = UNKNOWN ]; then printf 'source=artifacts status=UNKNOWN reason=unavailable path=%s\n' "$artifact_dir"; else printf 'source=artifacts status=KNOWN count=%s watermark=count:%s,sha256:%s,cutoff:%s\n' "$artifact_count" "$artifact_count" "$artifact_hash" "$CUTOFF"; fi
  if [ "$git_count" = UNKNOWN ]; then printf 'source=git status=UNKNOWN reason=unavailable\n'; else printf 'source=git status=KNOWN count=%s watermark=count:%s,sha256:%s,cutoff:%s\n' "$git_count" "$git_count" "$git_hash" "$CUTOFF"; fi
  printf '%s\n' "$promises_status" "$ledger_status" "$labor_status"
  if [ "$board_count" = UNKNOWN ] || [ "$task_count" = UNKNOWN ]; then printf 'difference_class=UNKNOWN reason=source-unavailable\n'; elif [ "$board_count" -eq "$task_count" ]; then printf 'difference_class=MATCH board_tasks=%s replay_tasks=%s\n' "$board_count" "$task_count"; else printf 'difference_class=SOURCE_ONLY board_tasks=%s replay_tasks=%s\n' "$board_count" "$task_count"; fi
  printf 'difference_classes=MATCH,SOURCE_ONLY,LEDGER_ONLY,STATE_MISMATCH,DUPLICATE,LATE,UNAVAILABLE,UNKNOWN\n'
  printf 'adjustment_policy=PROPOSE_ONLY\n'
} > "$OUT"
echo "mesh-hledger-reconcile: wrote $OUT cutoff=$CUTOFF"
