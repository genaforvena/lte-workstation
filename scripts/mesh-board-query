#!/usr/bin/env python3
"""Read-only query surface for distributed metadata in the mesh text board."""
import json
import os
import re
import sys

LINE = re.compile(r"^(?P<ts>\S+)\s{2}(?P<who>\S+)\s{2}::\s{2}(?P<body>.*)$")
TERM = re.compile(r"^(?P<key>[A-Za-z_][A-Za-z0-9_.-]*)(?P<op>!=|~=|=)(?P<value>.+)$")


def parse(line):
    match = LINE.match(line.rstrip("\n"))
    if not match:
        return None
    body = match.group("body")
    main, sep, tail = body.partition(" ; ")
    tags = {}
    if sep:
        for item in tail.split(","):
            if ":" in item:
                key, value = item.split(":", 1)
                tags[key.strip()] = value.strip()
    who = match.group("who")
    window, at, node = who.rpartition("@")
    marker_match = re.match(r"^\[([^]]+)\]\s*(.*)$", main)
    marker = marker_match.group(1) if marker_match else ""
    text = marker_match.group(2) if marker_match else main
    return {"ts": match.group("ts"), "who": who, "window": window if at else who,
            "node": node if at else "", "marker": marker, "body": text,
            "tags": tags, "line": line.rstrip("\n")}


def field(record, key):
    return record.get(key, record["tags"].get(key, ""))


def matches(record, expression):
    def predicate(token):
        match = TERM.match(token)
        if not match:
            raise ValueError("invalid predicate %r (use field=value, field!=value, or field~=text)" % token)
        actual, expected, op = str(field(record, match.group("key"))), match.group("value"), match.group("op")
        return actual == expected if op == "=" else actual != expected if op == "!=" else expected.lower() in actual.lower()
    groups = re.split(r"\s+OR\s+", expression.strip(), flags=re.I)
    return any(all(predicate(token) for token in re.split(r"\s+AND\s+", group.strip(), flags=re.I) if token)
               for group in groups if group.strip())


def query(argv):
    json_out, count = "--json" in argv, "--count" in argv
    args = [arg for arg in argv[1:] if arg not in ("--json", "--count")]
    if not args or args[0] in ("-h", "--help"):
        print("usage: mesh-board-query <field=value [AND|OR ...]> [--json|--count]")
        print("fields: ts who window node marker body and ; key:value metadata tags")
        return 0
    path = os.environ.get("MESH_BOARD_LOG", os.path.join(os.environ.get("MESH_DIR", os.path.expanduser("~/.mesh")), "chat.log"))
    try:
        with open(path, encoding="utf-8", errors="replace") as stream:
            records = [record for line in stream if (record := parse(line)) and matches(record, " ".join(args))]
    except OSError as exc:
        print("mesh-board-query: n/a — cannot read %s: %s" % (path, exc), file=sys.stderr)
        return 2
    if count:
        print(len(records))
    elif json_out:
        for record in records:
            print(json.dumps({key: value for key, value in record.items() if key != "line"}, ensure_ascii=False, sort_keys=True))
    else:
        for record in records:
            print(record["line"])
    return 0 if records else 1


def selftest():
    import tempfile
    with tempfile.TemporaryDirectory() as td:
        path = os.path.join(td, "chat.log")
        with open(path, "w", encoding="utf-8") as stream:
            stream.write("2026-09-06T00:00:01Z  genome@alpha  ::  [task] repair ; owner:genome, status:open, task:repair\n")
            stream.write("2026-09-06T00:00:02Z  tg@beta  ::  [fyi] observed ; status:done\n")
            stream.write("2026-09-06T00:00:03Z  health@alpha  ::  [task] inspect uuid ; owner:health, status:open\n")
        old = os.environ.get("MESH_BOARD_LOG")
        os.environ["MESH_BOARD_LOG"] = path
        try:
            assert query(["mesh-board-query", "marker=task", "AND", "node=alpha", "--count"]) == 0
            assert query(["mesh-board-query", "owner=genome", "--count"]) == 0
            assert query(["mesh-board-query", "body~=uuid", "OR", "window=tg", "--count"]) == 0
            assert query(["mesh-board-query", "status!=done", "--count"]) == 0
            assert query(["mesh-board-query", "marker=missing", "--count"]) == 1
        finally:
            if old is None: os.environ.pop("MESH_BOARD_LOG", None)
            else: os.environ["MESH_BOARD_LOG"] = old
    print("smoke-test: ok (envelope fields + metadata tags + AND/OR/contains/not-equal queries + count/no-match exit)")
    return 0


if __name__ == "__main__":
    if "--test" in sys.argv: sys.exit(selftest())
    sys.exit(query(sys.argv))
