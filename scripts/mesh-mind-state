# EXACT-NAME GATE (chat-review/mindstate-prefix-answers-for-another-window): every tmux read below
# (`-t "$(hostname):$win"`) resolves $win through tmux TARGET matching, which prefix/fnmatch-matches —
# so `gen` reads the `genome` pane and reports genome's state under the name `gen`, rc=0. The old
# exit-7 guard (~:1101) is exact-match but sits BELOW the read and only fires when state is
# DEAD/DEAD-SHELL — a phantom name that prefixes a LIVE window never gets there, so ABSENT could only
# ever fire for a name matching NOTHING (which is all its `zzz-bogus` test ever drove). Decide absence
# from the NAME, before any read: a window is the one whose name matches exactly, or it is absent.
# Live blast radius: mesh-dispatch's own default pool is "dev discover sense" and there is no `sense`
# window (the set has `senses`) — it read senses' state under the name `sense`; and
# mesh-mind-control:503 leans on ABSENT to catch an `owner:` mis-tag, which silently dispatched to
# whatever window the mis-tag happened to prefix. REMOTE (--node) still resolves via tmux matching:
# the guard is local-only, matching the existing exit-7 scope, since checking costs a second ssh.
if [ "$node" = local ]; then
  tmux list-windows -t "$(hostname)" -F '#{window_name}' 2>/dev/null | grep -qx "$win" \
    || { printf 'ABSENT\tno such window: %s\n' "$win"; exit 7; }
fi
_raw="$(peek_win "$win" "$node")"
out="$(classify_win "$win" "$node" "$_raw")"
state="${out%%	*}"
# WEDGED-INPUT overlay (chat-review/dispatch-picker-blind-to-wedge): this single-window CLI path is what
# mesh-mind-control's state_of()/_pick_agentic reads. Without this call it reports a pane stuck on an
# un-submitted input line (the '/clear' harness-eats-Enter bug) as plain IDLE, so dispatch keeps ranking
# the wedged window top-tier idle_claude and re-targeting it every tick. Mirror watch_tick's own
# wedge_state call (:480), sharing the SAME $MESH/.mind-input-$win memory so the CLI path and the --watch
# loop agree instead of diverging. Two consecutive single-window invocations with the same stuck ❯-line →
# 2nd prints WEDGED-INPUT (each CLI call is one tick; the memory file persists between them).
_wstate="$(wedge_state "$win" "$state" "$_raw")"
if [ "$_wstate" != "$state" ]; then
  out="$_wstate	input stuck (never submitted): $(input_stuck_text "$_raw")"
  state="$_wstate"
fi
# Distinguish absent window from truly dead mind: an absent local window returns ABSENT/exit-7,
# not DEAD/exit-5 — callers (mesh-supervise, mesh-borrowed-brain) must not treat a missing
# channel as a mind outage (the channel simply wasn't built yet, e.g. pre-mesh-restore).
if { [ "$state" = DEAD ] || [ "$state" = DEAD-SHELL ]; } && [ "$node" = local ]; then
  # DEAD-SHELL included as defense-in-depth: a genuinely shed pane lives on a REAL window (grep matches
  # → stays DEAD-SHELL), so only a truly ABSENT window falls through here — even if some future tmux
  # tty-fallback quirk resurfaces the misclassification the pane_comms pidx-gate above now prevents.
  tmux list-windows -t "$(hostname)" -F '#{window_name}' 2>/dev/null | grep -qx "$win" \
    || { printf 'ABSENT\tno such window: %s\n' "$win"; exit 7; }
fi
printf '%s\n' "$out"
case "$state" in NEEDS-INPUT) exit 4;; DEAD) exit 5;; RATE-LIMITED) exit 6;; DEAD-SHELL) exit 8;; AUTH-DEAD) exit 9;; *) exit 0;; esac
