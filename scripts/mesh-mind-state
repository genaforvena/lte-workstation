  split_tabs "$(printf '%s\t%s\t%s\t%s\n' '' '87.1K' '9' '1.25')" _sm _st _sp _sd
  [ -z "$_sm" ] && [ "$_st" = 87.1K ] && [ "$_sp" = 9 ] && [ "$_sd" = 1.25 ] \
    || { echo "smoke-test: FAIL (a row with an empty MODEL column split as model='$_sm' tokens='$_st' pct='$_sp' \$='$_sd' — the fields shifted left, so the token count renders as the model name and the cost is dropped)"; exit 1; }
  # an empty MIDDLE column shifts everything after it, and drops the last one entirely
  split_tabs "$(printf '%s\t%s\t%s\t%s\n' 'MiMo' '' '9' '1.25')" _mm _mt _mp _md
  { [ "$_mm" = MiMo ] && [ -z "$_mt" ] && [ "$_mp" = 9 ] && [ "$_md" = 1.25 ]; } \
    || { echo "smoke-test: FAIL (a row with an empty TOKENS column split as model='$_mm' tokens='$_mt' pct='$_mp' \$='$_md')"; exit 1; }
  # a trailing empty column (free model, no cost) must stay empty, not borrow the tail
  split_tabs "$(printf '%s\t%s\t%s\t%s\n' 'MiMo' '87.1K' '9' '')" _fm _ft _fp _fd
  { [ "$_fm" = MiMo ] && [ "$_ft" = 87.1K ] && [ "$_fp" = 9 ] && [ -z "$_fd" ]; } \
    || { echo "smoke-test: FAIL (a row with an empty COST column split as model='$_fm' tokens='$_ft' pct='$_fp' \$='$_fd')"; exit 1; }
  # agy OAuth re-login screen (token expired) → NEEDS-INPUT, not UNKNOWN: it's literally waiting for the
  # operator to paste an authorization code. agy-specific markers (no other engine shows a Google OAuth URL).
  s="$(printf ' Open the URL below in your browser:\n https://accounts.google.com/o/oauth2/auth?client_id=x\n After authenticating, paste it below:\n authorization code...\n  shift+up/down Navigate\n' | classify)"
