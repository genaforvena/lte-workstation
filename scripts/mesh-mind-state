  # negative control: arbitrary operator text, flag still unset → alert-only, no auto-fire
  : > "$_wa_sendf"; : > "$_wa_tellf"
  _wa_op="$(printf '❯ какой-то длинный текст оператора\n────\n  ⏵⏵ auto mode on (shift+tab to cycle) · ← for agents\n')"
  watch_tick wauto2 "$_wa_op" >/dev/null 2>/dev/null
  watch_tick wauto2 "$_wa_op" >/dev/null 2>/dev/null
  _wa_o2="$(watch_tick wauto2 "$_wa_op" 2>&1 >/dev/null)"
  case "$_wa_o2" in *'[mind-wedged]'*) :;; *) _wafail "wedge on operator text never alerted: $_wa_o2";; esac
  [ ! -s "$_wa_sendf" ] && [ ! -s "$_wa_tellf" ] \
    || _wafail "operator text auto-fired without MESH_WEDGE_RECOVER=1 — must stay alert-only (sendkeys=$(cat "$_wa_sendf") tell=$(cat "$_wa_tellf"))"
  unset -f tmux mesh-tell; rm -rf "$MESH"; rm -f "$_wa_sendf" "$_wa_tellf"; MESH="$_wa_wmesh"; MIND_DEBOUNCE_SEC="$_dbo2"; unset MESH_ALERT_DRYRUN

  # ── mindwedged-autofire-case-to-trace (chat-review 2026-07-08) ──────────────────────────────────
  # The auto-fire /clear|/model wedge is proven self-recovering within this same run (previous
  # fixture above), so its alert must route to trace, not the board — mirroring mind-unblocked's own
  # trace-diversion for un-paired recoveries. Arbitrary operator text keeps the board post (genuinely
  # needs eyes). No MESH_ALERT_DRYRUN here — dryrun short-circuits alert() before the routing choice,
