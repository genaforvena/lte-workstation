#!/usr/bin/env bash
# mesh-mind-state — classify what a mind's tmux pane is doing: WORKING / NEEDS-INPUT / IDLE / DEAD.
# The amux idea (state from ANSI-stripped scrollback, no hooks into the agent) adopted tmux-native,
# after 2026-06-12: ds's mind sat HOURS on a permission prompt — UP for supervise, DEAD for work.
# NEEDS-INPUT is the blind state: liveness checks see a live pane, work checks see no progress.
#
#   mesh-mind-state <window> [--node user@ip]   classify one mind window (prints STATE + evidence line)
#   mesh-mind-state --stats [win ...]           per-window state + model/tokens/pct/dollars (opencode usage)
#   mesh-mind-state --watch [win ...]           classify mind windows (default: plan health verify work);
#                                               edge-triggered [mind-blocked]/[mind-unblocked] board alerts
#                                               + cross-tick WEDGED-INPUT → [mind-wedged] (see below)
#   mesh-mind-state --loop [win ...]            REPORT-ONLY action-turnover read: repeat concentration
#                                               of each mind pane's ACTION lines (see the block at
#                                               ~:520). STATIC names NO cause — a reasoning loop, a
#                                               hung tool call and a FROZEN/stopped process all render
#                                               identically from a pane. Never posts, never alerts.
#   mesh-mind-state --test                      smoke test (classifier exercised on golden pane texts)
#
# Exit (single window): 0 WORKING/IDLE/UNKNOWN · 4 NEEDS-INPUT · 5 DEAD · 6 RATE-LIMITED · 7 ABSENT ·
#                        8 DEAD-SHELL (bare shell, no mind engine) · 9 AUTH-DEAD (logged out — 'Not
#                        logged in'/'/login', re-login needed — see classify). --watch exits 0.
#
# DEAD-SHELL (process-truth override, chat-review/shed-pane-dead-shell-misclassified 2026-07-07): a
# SHED/killed mind can leave its login shell attached to the pane with NO mind engine anywhere in its
# process tree, while the frozen screen still paints the LAST mind frame (idle footer / prompt glyph)
# — pane TEXT ALONE is byte-identical to a live idle mind (the classifier's own documented LIMITATION
# above DEAD-BEFORE-IDLE). Live: a shed pane's text classified WEDGED-INPUT (the ❯-glyph shell prompt
# read as a mind's ready prompt, and a nudge sitting unexecuted in it read as "stuck input"), and
# mesh-tell/mesh-pane-consume then blindly send-keys'd prompts into it — bash EXECUTED them as real
# shell commands, not a benign wedge. Fix: query the pane's ACTUAL live processes via its controlling
# tty (ps -t, not descendant-PID walking — covers a backgrounded/job-controlled engine that owns the
# tty without being the pane's foreground process group) and override to DEAD-SHELL when no known
# mind-engine command is present. Authoritative over pane text, same "process-truth beats display"
# principle channel-keepalive's PID-based shed already uses, now folded into the classifier itself.
#
# SHED-RATE-LIMITED (chat-review/shed-pane-dead-shell-misclassified 2026-07-07, classifier half wired
# 2026-07-19): a QUOTA-shed mind IS a bare shell — channel-keepalive kills the engine to stop the
# spin, then writes a '--- SHED until HH:MMZ (rate-limit wall, shed #N) ---' banner INTO the pane
# (channel-keepalive:597). pane_is_bare_shell truthfully reports no engine (the kill is the point),
# so every quota-shed read DEAD-SHELL to pane-text consumers — the very misclassification the 2026-
# 07-07 fix wrote the banner to prevent, left UNREAD at the classifier for 12 days. classify_win
# greps the pane for that banner BEFORE declaring DEAD-SHELL; if present, the state is RATE-LIMITED
# (auto-resumes at HH:MMZ) — semantics consumers already handle by routing work elsewhere. The
# banner's tight literal shape (anchored, HH:MMZ, shed #N) makes an accidental match in agent prose
# essentially impossible. A genuinely-killed mind (no banner) still reads DEAD-SHELL as before.
#
# WEDGED-INPUT (--watch only — needs cross-tick memory, a single snapshot can't see it): an operator
# message can sit UNSUBMITTED in the input line for HOURS while the pane reads healthy IDLE — the
# harness ate the Enter (live case 2026-07-06 16:18Z: weather coords sat in genome's input, session
# jsonl proved the msg never arrived; every watcher read IDLE). Detection: the SAME non-empty
# input-line text below a ready prompt on 2+ consecutive ticks while classification=IDLE. Distinct
# from NEEDS-INPUT (the AGENT asking) — here the harness ate a submission. Recovery that worked live:
# C-u then re-inject via mesh-tell; MESH_WEDGE_RECOVER=1 automates exactly that sequence (default off).
# MESH_ALERT_DRYRUN=1 → print would-be alerts, don't send.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
MESH="$HOME/.mesh"; mkdir -p "$MESH"
CARD="$HOME/.mesh-card"

# state_rc — the single-window CLI's state → exit-code contract, in ONE place so it can be DRIVEN.
# Callers key on these numbers (mesh-supervise, mesh-mind-control, mesh-borrowed-brain, dispatch),
# so a wrong or missing code is a silent routing bug, not a cosmetic one.
# WHY IT IS A FUNCTION: this mapping used to be one inline `case` on the CLI's last line, and its only
# gates were two greps for its own source text — `grep -q 'AUTH-DEAD) exit 9;;' "$0"` and the same for
# DEAD-SHELL/8. Those are self-asserting: the grep line matches itself, so the gate passed even against
# a deleted mapping, and 4/5/6/0 had no gate at all. Driving a function over the whole table asserts
# the behaviour and covers every state, which is what the source-greps only looked like they did.
# (Renaming a state without updating this table still lands in *) → 0; that is the DEFAULT-is-healthy
# risk the table's explicit unknown-state row pins.)
state_rc() { # $1=state → echoes the CLI exit code for it
  case "$1" in
    NEEDS-INPUT)  echo 4 ;;
    DEAD)         echo 5 ;;
    RATE-LIMITED) echo 6 ;;
    ABSENT)       echo 7 ;;
    DEAD-SHELL)   echo 8 ;;
    AUTH-DEAD)    echo 9 ;;
    *)            echo 0 ;;
  esac
}

# card_gates_minds — true (0) iff this node's card is HANDS-OFF: a `minds:` line present but naming no
# known engine (card-capability-authoritative — a node decommissions its minds by blanking the line, not
# deleting it). No card, or no `minds:` line at all, or a `minds:` line naming a known engine → false
# (1), i.e. not gated. Mirrors mesh-mind-keepalive:89-93. Extracted into a function (not inlined at the
# --watch call site) so --test can drive it directly against fixture cards without a live tmux dispatch.
card_gates_minds() { # $1=card path (default $CARD)
  local card="${1:-$CARD}"
  [ -f "$card" ] || return 1
  grep -qiE '^[[:space:]]*minds:' "$card" || return 1
  grep -iE '^[[:space:]]*minds:' "$card" | grep -qwE 'claude|opencode|gemini|codex' && return 1
  return 0
}

# Patterns are engine-agnostic where possible; the dialog shapes are Claude Code's today — extend per
# engine as their dialogs are met in the wild. Checked in priority order: dialog beats spinner beats prompt.
# canonical wall regex (DRY — knowledge/inter-tool-inconsistency-canonical-definitions-2026-06-14).
# Source the shared source if deployed; else fall back to an inline copy so this tool never breaks
# on genome drift. Was a private regex here that MISSED resets/429/overloaded/upgrade-to-pro.
[ -r "$HOME/.local/bin/mesh-patterns.sh" ] && . "$HOME/.local/bin/mesh-patterns.sh" 2>/dev/null
: "${MESH_RL_RE:=hit your (usage|session) limit|usage limit reached|rate.?limit|429|too many requests|quota.*(exhaust|exceed)|out of credits|purchase more credits|upgrade to (pro|team)|try again (at|later|in)|resets? (at )?[0-9]|overloaded}"
# STRONG subset — phrases an ENGINE STOP banner uses but agent prose essentially never does. These
# match anywhere (minus prompt-glyph lines). The rest of MESH_RL_RE (bare rate-limit, overloaded,
# try-again, resets, quota) ALSO appears in a mind's own SUMMARY PROSE when it writes ABOUT quotas
# (operator FP 2026-06-15: plan wrote "rate-limit walls cascading"; sense held the AGENTIC-FAILOVER
# design doc literally containing "RATE-LIMITED") → those broad tokens only count on a TERSE banner.
: "${MESH_STRONG_RL_RE:=hit your (usage|session) limit|usage limit reached|too many requests|429|out of credits|purchase more credits|upgrade to (pro|team)}"
MESH_RL_BANNER_MAXLEN="${MESH_RL_BANNER_MAXLEN:-100}"  # an engine banner is terse; agent prose is long-form

# option_dialog_question <full-pane-text> — the QUESTION an option dialog is asking: the last
# non-empty, non-border line ABOVE the first '❯ 1.'/'› 1.' option. claude's AskUserQuestion renders
# question → option list → keybinding footer ("Enter to select · ↑/↓ to navigate · Esc to cancel";
# the "Tab/Arrow keys" wording is the same shape). Only the FOOTER falls inside the bottom-8 window
# classify reads, so both the board reason and the operator's TG ping rendered the KEYBINDINGS as the
# reason a mind was blocked — "waiting on input — Enter to select · Tab/Arrow keys to navigate · Esc
# to cancel" (chat-review/mind-blocked-reason-is-the-keybinding-footer 2026-07-15: 3 board posts,
# steward blocked ~2h behind a question nobody could read). The real dialog put its question 11
# non-empty lines above the footer, so reaching back is the only way to see it.
# Prints nothing when the shape isn't there — callers then keep their existing evidence line.
option_dialog_question() {
  printf '%s\n' "$1" | awk '
    /(❯|›)[[:space:]]*1\./ { print last; exit }
    # a border/checkbox-header row is not a question; keep looking further up
    /[^[:space:][:punct:]─│┌┐└┘━┃╭╮╰╯☐✔←→]/ { last=$0 }
  ' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//'
}

classify() { # stdin: pane text (last lines, blank-stripped). prints "STATE<TAB>evidence"
  local txt tail8 q
  txt="$(cat)"
  [ -n "$txt" ] || { printf 'DEAD\tempty pane\n'; return; }
  # Only the bottom 8 lines — that's where a TUI's live status bar / dialog actually sits. Scanning
  # deeper matches QUOTED patterns in agent output (this very tool misclassified its own author's
  # pane as RATE-LIMITED off a test fixture shown in a diff). Residual risk accepted: output that
  # quotes a dialog right at the bottom still fools it.
  tail8="$(printf '%s\n' "$txt" | tail -8)"
  local ev
  # DEEP-SCAN the strictly-live spinner (wider than tail8). A mid-turn claude spinner can be pushed
  # ABOVE the bottom-8 window by a tall tool-result box + a 'paste again to expand' hint rendered
  # between the spinner and the input prompt — then every bottom-8 check misses it and classify falls
  # through to UNKNOWN, poisoning the who's-WORKING signal minds dispatches on (live 2026-07-22: genome
  # 14:13 + health 14:20 both read UNKNOWN mid-turn; chat-review/mindstate-live-spinner-above-tail8).
  # Only the TIGHTEST strictly-live glyphs are deep-scanned — the TIMER-spinner ('… (57s'/'… (2m', the
  # … glyph + a bracketed time, which newer builds render WITHOUT 'esc to interrupt') and 'esc to
  # interrupt' itself. Both are live-turn-only and effectively never appear in prose/dialog/idle
  # footers, so the wider window does NOT reopen the quoted-pattern risk that keeps the rest at tail8
  # (the prose-collidable spinner WORDS Working/Thinking/Loading stay bottom-8 below). Time unit is
  # REQUIRED ([ms]) so a bare '(2)' in output can't false-fire.
  local tail24
  tail24="$(printf '%s\n' "$txt" | tail -24)"
  ev="$(printf '%s\n' "$tail24" | grep -m1 -E 'esc (to )?interrupt|…[[:space:]]*\([0-9]+[ms]')" \
    && { printf 'WORKING\t%s\n' "$ev"; return; }
  # strictly-LIVE markers first: these appear only while a turn is actually running (a dialog or
  # quota stop never shows 'esc to interrupt'); past-tense '✻ Crunched for 4m' must NOT match
  # agy (Antigravity CLI) renders a live spinner-panel while a turn runs: "Working…/Thinking…/Generating…/
  # Loading…" (its busy FOOTER is "esc to cancel", handled below — NOT here, because the permission dialog
  # shares that footer). These spinner WORDS appear only mid-turn and never in the permission dialog, so
  # they're a safe pre-dialog WORKING signal. Word-bounded so a quoted "…overworking…" can't false-fire.
  ev="$(printf '%s\n' "$tail8" | grep -m1 -E \
    'esc (to )?interrupt|…[[:space:]]*\([0-9]+m?|ing\.\.\.[[:space:]]*\([0-9]|(^|[[:space:]])(Working|Thinking|Generating|Loading)\.\.\.([[:space:]]|$)')" \
    && { printf 'WORKING\t%s\n' "$ev"; return; }
  ev="$(printf '%s\n' "$tail8" | grep -m1 -E \
    'Do you want to (proceed|make this edit|create|delete|allow)|Do you trust the contents|[❯›] 1\. Yes|Esc to cancel|Tab to amend|\(y/[Nn]\)[[:space:]]*$|Select an option|[Pp]ress [Ee]nter to continue|to grant|Allow once|Always allow|authorization code|paste it below|accounts\.google\.com/o/oauth2')" \
    && {
      # An option dialog's evidence is its keybinding FOOTER — useless as a "why is this mind
      # blocked" reason. Reach back past the bottom-8 window for the actual question. Gated on the
      # footer+option-list shape (the reach-back returns empty without a '❯ 1.' option list), so
      # permission/confirm dialogs keep the evidence line their summarize_reason cases key on.
      if printf '%s\n' "$tail8" | grep -qE 'Enter to select|Select an option'; then
        q="$(option_dialog_question "$txt")"
        [ -n "$q" ] && ev="$q"
      fi
      printf 'NEEDS-INPUT\t%s\n' "$ev"; return; }
  # LOGGED-OUT → AUTH-DEAD (chat-review/mindstate-loggedout-not-idle 2026-07-10): a claude pane whose
  # OAuth expired renders '⎿ Not logged in · Please run /login' ABOVE the SAME idle footer a healthy
  # idle mind shows, so classify used to read IDLE. dispatch() (gates on '= IDLE') then routed
  # owner-tagged work to it, and mesh-tell's ack-probe can NEVER see a WORKING indicator (no engine
  # starts without auth) → NOACK → retry-then-[dispatch-noack] loop forever (2 tasks stuck for hours,
  # 2026-07-10; matches memory mind-401-needs-engine-restart, but the classifier had no detector).
  # DISTINCT state (exit 9), NOT NEEDS-INPUT (which means the AGENT is asking a question): a logged-out
  # pane has no agent at all — it needs a human re-login + engine restart. Consumers skip/HOLD it like
  # DEAD-SHELL and alert ONCE, never treat it as an answerable prompt. Checked AFTER WORKING (a running
  # turn is authed) and excluding input-box lines (❯/›) so a mind merely TYPING about /login isn't misread.
  # BANNER-SHAPE, not substring (2026-08-18): the old read was a bare `grep 'Please run /login'` over
  # the pane tail, so a mind's own PROSE about a logged-out window became the verdict — live FP the
  # same day on mesh-home:health, which had just posted "…my window was 403 auth-dead … the handoff's
  # tail showing Please run /login · API Error: 403" and was classified AUTH-DEAD while perfectly
  # healthy. That is not cosmetic: mesh-tell REFUSES on this state and dispatch HOLDs on rc 9, so the
  # mind was silenced for talking about the incident — and channel-keepalive's new AUTH-DEAD arm KILLS
  # on it. Decided by the SHARED auth_is_dead (mesh-patterns.sh): terse line AND the phrase LEADS the
  # line after glyph-strip. Inline fallback keeps the same two rules if the lib isn't deployed.
  if printf '%s\n' "$tail8" | { command -v auth_is_dead >/dev/null 2>&1 && auth_is_dead \
       || grep -vE '^[[:space:]]*[❯›]' | sed -E 's/^[[:space:]]*([●⏺⎿│*•▪◆·>-]+[[:space:]]*)?//' \
          | awk 'length($0)<=100' | grep -qiE '^(not logged in|please run /login|invalid api key)'; }; then
    ev="$(printf '%s\n' "$tail8" | grep -vE '^[[:space:]]*[❯›]' \
          | sed -E 's/^[[:space:]]*([●⏺⎿│*•▪◆·>-]+[[:space:]]*)?//' | awk 'length($0)<=100' \
          | grep -m1 -iE '^(not logged in|please run /login|invalid api key)')"
    printf 'AUTH-DEAD\t%s\n' "$ev"; return
  fi
  # RATE-LIMITED only from a real STOP banner — NOT from the input box. The composing/draft line
  # (and tab-completion ghost text) starts with the prompt glyph ❯/› and often carries quota words
  # (a mind drafting a message ABOUT rate limits, a recalled command, a tab suggestion) — that is
  # the mind's INPUT, not its STATE. The genuine quota banner ("■ You've hit your usage limit…")
  # never starts with the prompt glyph. So drop prompt-glyph lines before the quota match.
  # (operator-reported false-positive 2026-06-15: plan window read RATE-LIMITED off a tab suggestion
  # in the input box.)
  # Decide RATE-LIMITED via the SHARED rl_is_walled (mesh-patterns.sh) — the ONE banner-shape gate:
  # drops prompt-glyph input lines; STRONG phrases match any length; broad tokens only on a TERSE line
  # (a mind's long-form prose discussing quotas is NOT its state); and a banner ABOVE a live ready
  # footer / spinner is STALE → not walled (operator FP 2026-06-15: discover/sense recovered after
  # their 2:20pm reset but the old banner sat in scrollback). Inline two-tier fallback if the lib is
  # absent (no recovered-guard then — but WORKING above already caught the spinner-recovered case).
  # Strip board-echo lines before the RL check: a board relay of "[mind-limited] node:win quota-exhausted"
  # matches quota.*(exhaust) in MESH_RL_RE → false RATE-LIMITED for the pane that displayed the echo.
  # Board lines have the form "TIMESTAMP  who@node  ::  body" (mesh-chat uses DOUBLE spaces).
  # grep -vE with single spaces silently fails to strip them — corrected to double spaces (37629dc bug).
  local tail8_noboard
  tail8_noboard="$(printf '%s\n' "$tail8" | grep -vE '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:Z]+  [^ ]+  ::  ')"
  if printf '%s\n' "$tail8_noboard" | rl_is_walled 2>/dev/null \
     || { ! command -v rl_is_walled >/dev/null 2>&1 \
          && printf '%s\n' "$tail8_noboard" | grep -vE '^[[:space:]]*[❯›]' \
             | awk -v m="${MESH_RL_BANNER_MAXLEN:-100}" 'length($0)<=m' | grep -qiE "$MESH_RL_RE"; }; then
    # BOTTOM-MOST match, not top-down -m1: the real STOP banner renders BELOW any prose that also
    # happens to mention quota words, so a first-match pick quotes the prose instead of the banner
    # (matches rl_is_walled's own most-recent-signal doctrine above — state = what's newest in the pane).
    ev="$(printf '%s\n' "$tail8_noboard" | grep -vE '^[[:space:]]*[❯›]' | grep -iE "$MESH_STRONG_RL_RE" | tail -1)"
    [ -n "$ev" ] || ev="$(printf '%s\n' "$tail8_noboard" | grep -vE '^[[:space:]]*[❯›]' \
             | awk -v m="${MESH_RL_BANNER_MAXLEN:-100}" 'length($0)<=m' | grep -iE "$MESH_RL_RE" | tail -1)"
    printf 'RATE-LIMITED\t%s\n' "$ev"; return
  fi
  # agy BUSY footer = "esc to cancel" (claude uses "esc to interrupt", caught in WORKING above). agy's
  # PERMISSION dialog ALSO shows "esc to cancel", but that already returned NEEDS-INPUT above (the dialog
  # body — "Do you want to proceed?/1. Yes" — matches first). So reaching here WITH "esc to cancel" and NO
  # dialog means agy is mid-turn but the spinner WORD scrolled out of the bottom 8 → WORKING, not UNKNOWN.
  ev="$(printf '%s\n' "$tail8" | grep -m1 -E 'esc to cancel')" \
    && { printf 'WORKING\t%s\n' "$ev"; return; }
  # IDLE = ready prompt with NO turn running. Bare-prompt regex alone is fragile (border lines /
  # trailing pad / leading indent push the '❯ ' line around), so also match POSITIVE ready-footers.
  # Safe BY ORDERING: a working pane always carries a spinner / 'esc to interrupt' caught by WORKING
  # above, so reaching here means no turn is running — the footer then means genuinely idle.
  #   ⏵⏵ auto mode on        → Claude Code / gemini ready footer (older builds; working adds 'esc to interrupt')
  #   ? for shortcuts.*agents → Claude Code new-style idle footer (2026-06-13+ builds)
  #   ›  Use /…              → codex ready prompt (working shows '◦ Working … esc to interrupt' → WORKING)
  #   gpt-X.Y [size] · ~/…   → codex bare model footer when the input box is empty/ghosted
  #   Ask anything           → opencode idle input prompt (new MiMo/Zen UI layout)
  #   ctrl+p commands · OpenCode → opencode 1.16.x bottom status bar when idle (no spinner)
  # (new-UI patterns originated by the ds mind, stranded behind a blocked FF — ported here additively
  #  so the whole mesh detects new-build idle footers; the ds --watch divergence is left for ds reconcile.)
  # DEAD-BEFORE-IDLE (death truth, 2026-06-15): a killed mind leaves claude's last footer FROZEN in
  # scrollback (⏵⏵ auto mode on / ❯) with a fresh shell prompt below it. The IDLE footer match below
  # scans the bottom 8 lines and would match that STALE footer → a dead mind reads IDLE. So check the
  # LAST line for a bare shell prompt FIRST: a '$'/'%' prompt on the final line means the TUI exited,
  # regardless of any footer text above it. (A LIVE idle mind's last line is its footer/❯, never a
  # shell prompt, so this never false-DEADs a real idle mind.)
  printf '%s\n' "$txt" | tail -1 | grep -qE '\$[[:space:]]*$|%[[:space:]]*$' \
    && { printf 'DEAD\tbare shell prompt below stale footer (TUI exited)\n'; return; }
  # IDLE = ready footer with NO turn running and NO shell prompt below it.
  # LIMITATION (death truth, canon): if a kill leaves the frozen footer with NO shell prompt visible
  # (alt-screen not yet restored), the pane is BYTE-IDENTICAL to a live idle mind — pane text alone
  # CANNOT tell them apart. That residual case is why the process-truth layer (channel-keepalive's PID
  # check) is authoritative for relaunch/shed decisions; this display layer is best-effort.
  # NB '\? for shortcuts' (bare) is agy's idle footer — claude's variant '… · ← for agents' also matches
  # it. Safe by ordering: a working agy carries the Working.../Thinking…/esc-interrupt panel caught above,
  # so reaching here with that footer means the input box is empty = genuinely idle.
  # claude's idle footer varies by permission mode: '⏵⏵ auto mode on' (acceptEdits) AND
  # '⏵⏵ bypass permissions on' (bypassPermissions) — match BOTH, plus the mode-agnostic '← for agents'
  # suffix (a WORKING claude shows 'esc to interrupt', caught earlier, so reaching here = genuinely idle).
  # Without the bypass variant every bypassPermissions mind read UNKNOWN at its ready prompt (the all-
  # claude switch 2026-06-25 surfaced this — half the minds showed UNKNOWN in the minds dash).
  printf '%s\n' "$tail8" | grep -qE '^❯[[:space:]]*$|❯ $|^›[[:space:]]*$|⏵⏵ (auto mode|bypass permissions|plan mode) on|← for agents|›[[:space:]]+Use /|^[[:space:]]*Use /skills to list|\? for shortcuts|Ask anything|ctrl\+p commands|[[:space:]]*gpt-[0-9a-zA-Z.-]+([[:space:]]+(mini|medium|max|ultra|pro|nano))?[[:space:]]*·[[:space:]]*~/' \
    && { printf 'IDLE\tready prompt, no turn running\n'; return; }
  printf 'UNKNOWN\t%s\n' "$(printf '%s\n' "$txt" | tail -1 | cut -c1-60)"
}

# ── DEAD-SHELL: process-truth override (see header) ──────────────────────────────────────────────
MIND_ENGINE_RE='^(claude|opencode|codex|gemini|agy)$'
# pane_comms <win> <node> -> one live process COMM per line, from the mind pane's controlling tty (NOT
# descendant-PID walking — a backgrounded/job-controlled engine can own the tty without being the
# pane's foreground process-group leader, verified live: claude sat off pane_current_command yet was
# still attached to the pty). Overridable via MESH_MIND_STATE_COMMS_CMD so --test can point this at a
# hermetic fixture without depending on this tool's own tmux/ssh glue.
pane_comms() {
  local win="$1" node="$2"
  if [ -n "${MESH_MIND_STATE_COMMS_CMD:-}" ]; then eval "$MESH_MIND_STATE_COMMS_CMD"; return; fi
  # list-panes correctly ERRORS on a nonexistent window (empty pidx); display-message does NOT — it
  # silently falls back to the session's active pane's real tty (verified: bogus window → /dev/pts/0,
  # exit 0), which would make ps find a real shell and misclassify ANY absent window as DEAD-SHELL. So
  # gate the tty lookup on pidx: no pane found → emit nothing → pane_is_bare_shell fail-opens (:184) →
  # text-classify → DEAD → the ABSENT/exit-7 guard fires. (fix chat-review/mindstate-absent-vs-deadshell)
  local cmd="pidx=\$(tmux list-panes -t \"\$(hostname):$win\" -F '#{pane_top} #{pane_index}' 2>/dev/null | sort -n | tail -1 | awk '{print \$2}'); [ -n \"\$pidx\" ] || exit 0; tty=\$(tmux display-message -p -t \"\$(hostname):$win.\$pidx\" '#{pane_tty}' 2>/dev/null); [ -n \"\$tty\" ] && ps -t \"\$tty\" -o comm= 2>/dev/null"
  if [ "$node" = local ]; then bash -c "$cmd"
  else ssh -o BatchMode=yes -o ConnectTimeout=8 "$node" "$cmd"; fi
}
# pane_is_bare_shell <win> <node> -> 0 (true) iff the pane's LIVE processes hold no known mind engine.
# Fail-open on an unreadable probe (empty comm list) — never fabricate DEAD-SHELL from a probe failure;
# the text classifier still applies in that case.
pane_is_bare_shell() {
  local win="$1" node="$2" comms
  comms="$(pane_comms "$win" "$node")"
  [ -n "$comms" ] || return 1
  printf '%s\n' "$comms" | grep -qE "$MIND_ENGINE_RE" && return 1
  return 0
}
# classify_win <win> <node> <raw-pane-text> -> STATE<TAB>evidence, same shape as classify(). The
# process-truth check runs FIRST and wins over any text-derived state (WEDGED-INPUT included — a
# shell prompt can look identical to a mind's, but it can never BE one).
classify_win() {
  local win="$1" node="$2" raw="$3"
  if pane_is_bare_shell "$win" "$node"; then
    # SHED-RATE-LIMITED (see header): a quota-shed pane IS a bare shell (channel-keepalive killed
    # the engine), but it is NOT dead — keepalive wrote a '--- SHED until HH:MMZ ---' banner into
    # the pane exactly so this classifier could tell. Grep the pane for the banner BEFORE declaring
    # DEAD-SHELL; if present, the mind is RATE-LIMITED (auto-resumes at HH:MMZ), not dead. Banner's
    # tight literal shape (anchored, HH:MMZ, shed #N) cannot appear in agent prose by accident.
    # LAST match, not first: after a re-shed the scrollback holds banner #1 ABOVE banner #2, so a
    # first-match read quotes an EXPIRED window (live 2026-07-20: room/chat reported shed #1 up to
    # 18h stale while keepalive had already posted shed #2).
    local shed_line
    shed_line="$(printf '%s\n' "$raw" | grep -E '^--- SHED until [0-9]{2}:[0-9]{2}Z \(rate-limit wall, shed #[0-9]+\) ---$' | tail -n 1)"
    if [ -n "$shed_line" ]; then
      printf 'RATE-LIMITED\t%s\n' "$(sanitize_quote "$shed_line")"
      return
    fi
    printf 'DEAD-SHELL\tbare shell — no mind-engine process on this pane'"'"'s tty (shed/killed)\n'
    return
  fi
  printf '%s\n' "$raw" | classify
}

# sanitize_quote — neutralize quoted pane text so a banner/board-relay shown in a mind's pane can't be
# mis-parsed as a REAL board event by other scrapers (the phaedra:chat echo-loop, chat-review 2026-06-17:
# verify's quota banner was being re-quoted into [mind-blocked] and re-acted on). Drops full board-relay
# lines (TIMESTAMP who@node :: body), de-fangs marker brackets [x]->(x) and the '  ::  ' field separator,
# and collapses to a single line (a multi-line board post is itself a parse hazard). The OUTER
# [mind-blocked]/[mind-limited] marker is added by the caller AFTER this, so it stays intact.
sanitize_quote(){
  printf '%s\n' "$1" \
    | grep -vE '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:Z]+  [^ ]+  ::  ' \
    | sed 's/\[/(/g; s/\]/)/g; s/  ::  / : /g' \
    | tr '\n' ' ' | sed 's/  */ /g; s/ *$//'
}

# summarize_reason — turn the raw matched TUI line ($ev) into a SHORT, board-safe label.
# $ev is the first line matching the NEEDS-INPUT regex, which for a permission dialog is the
# raw status-bar buffer ("┃ Allow once Allow always Reject ctrl+f fullscreen …") — that whole
# buffer was leaking onto the board (chat-review 2026-06-18 board-noise task). The board wants
# a 1-line SUMMARY of WHY a mind is blocked; the full prompt still goes to the mind's pane +
# stderr (above). Known dialog shapes map to a canonical label; anything else is length-capped
# so the raw buffer can never flood the board again.
summarize_reason(){
  local s; s="$(sanitize_quote "$1")"
  case "$s" in
    *"Allow once"*|*"Always allow"*|*"Allow always"*|*"to grant"*) echo "permission gate (Allow/Reject)";;
    *"Do you want to proceed"*|*"1. Yes"*)                         echo "confirm prompt (Yes/No)";;
    *"(y/n)"*|*"(y/N)"*|*"(Y/n)"*)                                 echo "y/n confirm prompt";;
    # keyed on the option dialog's keybinding FOOTER, not on "Select an option" — a string claude
    # never renders, which made this label unreachable and dropped the footer into the catch-all
    # below, so the board's reason WAS the keybindings. Reached only when option_dialog_question()
    # found no question to reach back for; normally $ev is the question and takes the catch-all.
    *"Enter to select"*|*"Select an option"*)                      echo "option-select prompt";;
    *"press Enter to continue"*)                                   echo "press-Enter prompt";;
    *) if [ "${#s}" -gt 60 ]; then echo "${s:0:60}…"; else echo "$s"; fi;;
  esac
}

MIND_DEBOUNCE_SEC="${MESH_MIND_DEBOUNCE_SEC:-5}"

mind_state_file() { local win=$1; echo "$MESH/.mind-state-$win"; }
mind_since_file() { local win=$1; echo "$MESH/.mind-state-since-$win"; }
mind_seen_file()  { local win=$1; echo "$MESH/.mind-state.seen-$win"; }

mind_transition_due() {
  local state=$1 prev=$2 posted=$3 age=$4
  case "$state" in
    NEEDS-INPUT|RATE-LIMITED|WEDGED-INPUT)
      [ "$posted" = "$state" ] && return 1
      [ "$age" -ge "$MIND_DEBOUNCE_SEC" ] || return 1
      return 0
      ;;
    *)
      # keyed on $posted (the last ALERTED state), not $prev: by the time a non-transition frame
      # reaches this check, $prev has already been overwritten to the current $state on the flip
      # frame (see the caller's transition bookkeeping) — so a $prev check here is always comparing
      # $state against itself and can never see the state it recovered FROM. $posted only changes
      # when an alert actually fires, so it survives the flip and still names the blocked state
      # (mindstate-unblocked-edge-unreachable 2026-07-06: this made [mind-unblocked] unreachable —
      # 13 entry alerts in board history, 0 recoveries ever).
      case "$posted" in NEEDS-INPUT|RATE-LIMITED|WEDGED-INPUT) : ;; *) return 1 ;; esac
      [ "$posted" = "$state" ] && return 1
      [ "$age" -ge "$MIND_DEBOUNCE_SEC" ] || return 1
      return 0
      ;;
  esac
}

# split_tabs <line> <var>... — assign the line's TAB-separated fields one per var, PRESERVING
# EMPTY ONES; the last var takes the remaining tail, like `read` does.
# `IFS=$'\t' read -r` cannot do this: tab is IFS *whitespace*, so bash collapses a RUN of tabs
# into one delimiter AND strips leading/trailing ones — every empty field vanishes and the fields
# after it shift LEFT. The extractors below emit a fixed 4-column row with any column possibly
# empty, so this is not hypothetical: a pane whose bottom 15 lines carry the opencode status bar
# but no `Build ·` line yields "\t87.1K\t9\t1.25", which `read` splits as model=87.1K tokens=9
# pct=1.25 dollars='' — the TOKEN COUNT rendered as the model name and the cost silently dropped.
# (Same defect, same week, in mesh-load-audit: cda823df.) Deliberately a local copy — mesh-* tools
# are standalone by convention and there is no sourced lib; if a third site needs it, that is the
# moment to make it shared rather than a fourth private predicate.
# The definition MOVED to the shared library (mesh-split-tabs.sh) once the mesh-wide sweep found
# the same defect live in six more files. Two private copies was the moment named in this very
# comment; six was past it. Sourced hard and loud below — an inline fallback would be copy three.
source "$HOME/.local/bin/mesh-split-tabs.sh" "" 2>/dev/null || source "$(dirname "$0")/mesh-split-tabs.sh" "" 2>/dev/null || true
declare -F split_tabs >/dev/null \
  || { echo "mesh-mind-state: mesh-split-tabs.sh not found — refusing to run with a tab reader that drops empty fields" >&2; exit 1; }

# ── per-mind usage extractors (defined before --test so the smoke test can exercise them) ───────────
# extract opencode usage metrics from pane text (bottom lines)
# output: model<TAB>tokens<TAB>pct<TAB>dollars  (one field per column, empty if not found)
extract_oc_metrics() {
  local txt="$1" tail15 model tokens pct dollars line
  tail15="$(printf '%s\n' "$txt" | tail -15)"
  # Model: from "Build · <Name> [OpenCode Go|OpenCode Zen|Nvidia|...]" line
  # Cut at the first "OpenCode", "Nvidia", " · ", " [", or wide spacing to isolate model name
  model="$(printf '%s\n' "$tail15" | grep -m1 'Build ·' \
    | sed 's/.*Build · *//; s/[[:space:]][[:space:]]\+.*//; s/  .*//; s/ \[.*//; s/ · [0-9].*//; s/ · low.*//; s/[[:space:]]*OpenCode.*//; s/[[:space:]]*Nvidia.*//; s/[[:space:]]*~\/.*//; s/[[:space:]]*\/~.*//' \
    | tr -d '[:space:]')"
  # Status bar line with tokens and %: "[esc interrupt] 87.1K (9%) [· $1.25] ctrl+p commands"
  line="$(printf '%s\n' "$tail15" | grep -m1 -E '[0-9]+\.[0-9]+K[[:space:]]+\([0-9]+%' | tr -d '[:space:]')"
  if [ -n "$line" ]; then
    tokens="$(printf '%s\n' "$line" | grep -oE '[0-9]+\.[0-9]+K' | head -1)"
    pct="$(printf '%s\n' "$line" | grep -oE '\([0-9]+%' | tr -d '()' | head -1)"
    # Dollars: present only for paid models (· $X.XX)
    dollars="$(printf '%s\n' "$line" | grep -oE '\$[0-9]+\.[0-9]+' | head -1 | tr -d '$')"
  fi
  printf '%s\t%s\t%s\t%s\n' "${model:-}" "${tokens:-}" "${pct:-}" "${dollars:-}"
}

# extract agy (Antigravity CLI) metrics. agy's steady footer shows ONLY the live model, e.g.
#   "? for shortcuts                                   Gemini 3.5 Flash (Medium)"
# tokens + session cost live behind its INTERACTIVE /usage slash command (ContextPanel/CreditsPanel are
# toggle-only, never in the steady footer) and the per-generation store is protobuf — so tokens/pct/$ are
# NOT scrapeable from the pane (honest n/a, never faked). The footer model is AUTHORITATIVE over
# settings.json (a live /model switch isn't persisted there — verified 2026-06-19: settings said Sonnet
# while the pane ran Gemini 3.5 Flash). output: model<TAB>tokens<TAB>pct<TAB>dollars (last three empty).
extract_agy_metrics() {
  local txt="$1" tail8 model
  tail8="$(printf '%s\n' "$txt" | tail -8)"
  # model = trailing field of the footer line ending in a tier paren (Low|Medium|High|Max|Thinking);
  # strip everything up to the last 2+-space gutter. Covers Gemini/Claude/GPT labels alike.
  model="$(printf '%s\n' "$tail8" | grep -m1 -E '\((Low|Medium|High|Max|Thinking)\)[[:space:]]*$' \
    | sed -E 's/.*[[:space:]]{2,}//; s/^[[:space:]]+//; s/[[:space:]]+$//')"
  printf '%s\t\t\t\n' "${model:-}"
}

# extract codex metrics. codex's footer carries the live model on its "gpt-<ver> <effort> · ~/path" line
# (e.g. "gpt-5.4-mini medium · ~/lte-workstation") — scrape it like agy. Tokens/cost live behind codex's
# interactive /status (the working spinner shows a transient per-turn token count, not context) → n/a here.
# output: model<TAB>tokens<TAB>pct<TAB>dollars (last three empty).
extract_codex_metrics() {
  local txt="$1" tail8 model
  tail8="$(printf '%s\n' "$txt" | tail -8)"
  model="$(printf '%s\n' "$tail8" | grep -m1 -oE 'gpt-[0-9a-zA-Z.-]+([[:space:]]+(minimal|low|medium|high|max))?' \
    | head -1 | sed -E 's/[[:space:]]+/ /g; s/[[:space:]]+$//')"
  printf '%s\t\t\t\n' "${model:-}"
}

# claude_default_model — the FLEET default claude model (e.g. "Opus 4.8"), read live from the newest
# claude session JSONL's last `model` field. WHY a global read, not per-pane: claude's footer carries no
# model, and a pane can't be mapped to its session from outside the process (cmdline is bare `claude`, no
# session id in env/fd; and mesh-restore launches every claude mind within ~2s at boot, so PID-start-time
# can't disambiguate them — verified 2026-06-19). Every mesh claude mind launches via the SAME
# MESH_CLAUDE_CMD with no --model, so they share the account default → one global read is accurate for the
# fleet (a per-window /model override would NOT be reflected — acceptable: none use it). 60s cache.
claude_default_model() {
  local cache="$MESH/.claude-model" age=999 now newest m
  now="$(date +%s)"; [ -f "$cache" ] && age=$(( now - $(stat -c %Y "$cache" 2>/dev/null || echo 0) ))
  if [ "$age" -gt 60 ]; then
    newest="$(ls -t "$HOME"/.claude/projects/*/*.jsonl 2>/dev/null | head -1)"
    m="$(tail -c 200000 "$newest" 2>/dev/null | grep -oE '"model":"claude-[a-z0-9-]+"' | tail -1 \
         | sed -E 's/.*"(claude-[a-z0-9-]+)".*/\1/')"
    # friendly: claude-opus-4-8 -> "Opus 4.8" · claude-sonnet-4-6 -> "Sonnet 4.6"
    m="$(printf '%s' "$m" | sed -E 's/^claude-//; s/-([0-9]+)-([0-9]+).*$/ \1.\2/; s/^(.)/\u\1/')"
    printf '%s' "$m" > "$cache" 2>/dev/null || true
  fi
  cat "$cache" 2>/dev/null
}

# extract claude metrics. The pane footer carries NOTHING scrapeable (no model/tokens/ctx by default —
# verified on live panes: just "⏵⏵ auto mode on · ← for agents"). Model comes from the fleet default
# (claude_default_model); tokens/ctx/$ are quota-tracked via mesh-spend (claude = subscription quota, not
# per-call $) and live behind interactive /cost + /context → honest n/a here.
extract_claude_metrics() {
  printf '%s\t\t\t\n' "$(claude_default_model)"
}

# extract_metrics — engine-sniff the pane, then call the right extractor so every mind engine renders in
# the --stats table. Order matters: opencode (inline metrics) → codex (gpt footer) → agy (tier-paren
# model) → claude (auto-mode/agents footer) → opencode default.
extract_metrics() {
  local txt="$1" foot
  foot="$(printf '%s\n' "$txt" | tail -8)"
  if   printf '%s\n' "$foot" | grep -qE 'OpenCode|Build ·|ctrl\+p commands'; then
    extract_oc_metrics "$txt"
  elif printf '%s\n' "$foot" | grep -qE 'gpt-[0-9a-zA-Z.-]+([[:space:]]+(minimal|low|medium|high|max))?[[:space:]]*·[[:space:]]*~/|Use /skills to list available skills'; then
    extract_codex_metrics "$txt"
  elif printf '%s\n' "$foot" | grep -qE '\((Low|Medium|High|Max|Thinking)\)[[:space:]]*$'; then
    extract_agy_metrics "$txt"
  elif printf '%s\n' "$foot" | grep -qE '⏵⏵ auto mode on|← for agents|\? for shortcuts|esc to interrupt'; then
    extract_claude_metrics "$txt"
  else
    extract_oc_metrics "$txt"   # default (returns empties for an unknown footer)
  fi
}

# ── WEDGED-INPUT detection (mind-state-wedged-input 2026-07-06) ──────────────────────────────────
# input_stuck_text — extract the CANDIDATE stuck text from a pane: the last prompt-glyph line in the
# bottom 8 that carries non-space content after the glyph (the live input box sits just above the
# footer; earlier ❯-lines up the scrollback are past submissions). Ghost PLACEHOLDERS are not input —
# they render in an empty input box and would false-wedge if they persist across ticks: claude's
# '❯ Try "..."' suggestion, codex's '› Find and fix a bug...' example, opencode's 'Ask anything',
# codex's '› Use /...' hint. Real operator text never takes those exact leading shapes.
input_stuck_text(){ # $1=raw pane text → stuck-candidate text on stdout ('' if none)
  local last t
  # LAST prompt-glyph line FIRST (content or not) — that's the live input box. Filtering for
  # content before taking tail -1 (the old bug) would skip a bare live '❯ ' and fall back to an
  # earlier EXECUTED ❯-line still in the bottom-8 window (e.g. a submitted '/clear'), false-WEDGING
  # on scrollback. Test trailing content ONLY on that one line — never fall back to an earlier line.
  last="$(printf '%s\n' "$1" | tail -8 | grep -E '^[[:space:]]*[❯›]' | tail -1)"
  t="$(printf '%s' "$last" | grep -E '^[[:space:]]*[❯›][[:space:]]+[^[:space:]]' \
       | sed -E 's/^[[:space:]]*[❯›][[:space:]]+//; s/[[:space:]]+$//')"
  case "$t" in 'Try "'*|'Ask anything'*|'Use /'*|'Find and fix a bug'*) t="";; esac
  printf '%s' "$t"
}

# wedge_state — cross-tick overlay: prints the (possibly upgraded) state. Memory = one file per
# window holding last tick's input-line text. Same non-empty text 2 ticks running while IDLE →
# WEDGED-INPUT. Any non-IDLE tick or an emptied/changed input line clears the memory (a WORKING
# turn or live typing means the harness is eating keys fine).
wedge_state(){ # $1=win $2=classified-state $3=raw pane text → state on stdout
  local win=$1 state=$2 raw=$3 stuck prev wf="$MESH/.mind-input-$1"
  [ "$state" = IDLE ] || { rm -f "$wf" 2>/dev/null; printf '%s' "$state"; return; }
  stuck="$(input_stuck_text "$raw")"
  prev="$(cat "$wf" 2>/dev/null || true)"
  if [ -n "$stuck" ]; then printf '%s' "$stuck" > "$wf"; else rm -f "$wf" 2>/dev/null; fi
  if [ -n "$stuck" ] && [ "$stuck" = "$prev" ]; then printf 'WEDGED-INPUT'; else printf '%s' "$state"; fi
}

peek_win() { # $1=window  $2=node(local|user@ip) — bottom pane (MIND), like mesh-tell
  local win="$1" node="$2" cmd
  # Fixture seam, same shape as MESH_MIND_STATE_COMMS_CMD: override the pane READ so --test can
  # drive the REAL single-window CLI end-to-end (classify_win, the wedge overlay and the state→rc
  # mapping all still run for real — only the bytes coming off tmux are supplied). Without this the
  # CLI's exit codes could only ever be asserted by grepping for their own source text.
  [ -n "${MESH_MIND_STATE_PEEK_CMD:-}" ] && { eval "$MESH_MIND_STATE_PEEK_CMD"; return; }
  cmd="pidx=\$(tmux list-panes -t \"\$(hostname):$win\" -F '#{pane_top} #{pane_index}' 2>/dev/null | sort -n | tail -1 | awk '{print \$2}'); tmux capture-pane -t \"\$(hostname):$win\${pidx:+.\$pidx}\" -p 2>/dev/null | grep -vE '^[[:space:]]*\$' | tail -25"
  if [ "$node" = local ]; then bash -c "$cmd"
  else ssh -o BatchMode=yes -o ConnectTimeout=8 "$node" "$cmd"; fi
}

# ── REASONING LOOP (--loop, REPORT-ONLY): second-order regulation of the mind's OWN inference ──────
# Source (live literature, read 2026-08-14): Xinrun Wang, Chang Yang, He Zhao, Zhuoyi Lin, Shuyue Hu,
# *The Agent Use of Agent Beings: Agent Cybernetics Is the Missing Science of Foundation Agents*,
# **arXiv:2605.10754v1** (submitted 11 May 2026). §2 states the second-order move formally — "a
# second-order regulator R′ acts on the space of first-order regulators: R′:ℋ→𝒦(R)" — and its Agent
# Design Principle 5 (§3.1) makes it OPERATIONAL rather than philosophical: "A sufficiently autonomous
# agent must monitor and regulate its own inferential process, not merely its external actions…
# detecting looping behavior, declining confidence, and reasoning inconsistencies", which "includes
# detecting STRUCTURALLY IDENTICAL ACTIONS ACROSS MANY STEPS (reasoning loop), mis-calibrated
# confidence estimates, or inference drift from task specification".
#
# THE GAP IT NAMES. Every mind watcher in the mesh reads a pane either for MOTION or for a BLOCK:
# classify() above answers "moving / asking / dead"; wedge_state answers "is an input line stuck";
# mesh-pane-watch flags a DATA pane whose bytes are byte-IDENTICAL across cycles (a frozen render);
# mesh-unit-churn catches a crash-LOOPING systemd unit; mesh-criticality measures redispatch max-repeat
# on the BOARD. A mind grinding the same tool call with the same argument twenty times is the exact
# complement of all of them: its pane advances every second (pane-watch's hash keeps changing), it
# carries a live spinner (classify reads WORKING), nothing sits in its input line (wedge_state silent),
# it never crashes (no supervisor edge) and the board sees nothing — while it bills a paid turn per
# cycle. The header of this file calls NEEDS-INPUT "the blind state: liveness checks see a live pane,
# work checks see no progress". REPEATING is the OTHER blind state, and today nothing in the fleet
# looks for it. This is the first read of it — measurement before any actuation.
#
# THERE IS NO SCROLLBACK TO MINE (measured on mesh-home 2026-08-14, and it re-shapes the mechanism).
# The first draft of this read captured `-S -400` and counted repeats in one shot. Live, EVERY mind pane
# on this node reports `#{alternate_on}=1` — claude, opencode and the rest all hold tmux's ALTERNATE
# screen, which accumulates NO history: `capture-pane -S -2000` returned 40-41 lines (the visible frame)
# for 9 of 10 windows, and `#{history_size}` was 0 for genome/job/senses/witness. A one-shot read would
# therefore have been a HOLLOW sense — permanently n/a, green by never looking at anything (the
# `--test`-passes-but-the-organ-is-blind shape this codebase has paid for repeatedly). So the read is
# CROSS-TICK, like WEDGED-INPUT above: each tick samples the visible frame, merges it into a per-window
# ring by the longest overlap with the previous frame (a frame re-seen unchanged appends NOTHING — an
# idle pane must never accumulate its own still image into a fake loop), and the verdict is computed
# over the ring's last LOOP_WIN_S seconds. Sampling piggybacks on the EXISTING --watch cadence (no new
# cron line, no autowire collision); --loop reports the ring and also samples, so a manual sequence of
# calls builds its own evidence. Actions that scroll past between two ticks are simply never seen —
# an honest under-count, never an invented one.
#
# WHAT IS MEASURED (a count, not an inference): over the sampled ACTION lines in the ring, the repeat
# concentration of their CANONICAL form. An action line is a `●`/`⏺` bullet WHOSE NEXT NON-EMPTY LINE
# IS A `⎿` CONTINUATION — that structural pairing is what separates a tool call from assistant PROSE,
# which the Claude render bullets identically. Two canonical forms:
#   `● Tool(arg)` + `⎿ …`   → "Tool(arg)"     — structural identity INCLUDES the argument: `Read(a)`
#                                               and `Read(b)` are different actions.
#   `● <description>` + `⎿ …` → "Bash:<description>" — a Bash call renders its DESCRIPTION on the
#                                               bullet; the `$ <cmd>` echo under it is visible only
#                                               WHILE the command runs (measured live: a completed
#                                               call shows its OUTPUT there instead), so keying on the
#                                               command would make identity depend on WHEN we sampled.
#                                               The description is stable across running/completed.
# The statistic is TURNOVER over TICKS, not a count of events (loop_sample documents the two measured
# facts about the pane that rule counting out): each tick taken while the window is classified WORKING
# records a digest of the frame's action SET, and the verdict is STATIC / TURNING-OVER / n/a as
# documented at loop_report. Fewer than LOOP_MIN_TICKS WORKING samples → honest **n/a**, never
# TURNING-OVER: an idle pane, a pane sampled too few times, and an engine whose render dialect we do
# not parse (opencode/agy/codex) all yield nothing, and "we could not look" must never read as "we
# looked and it is fine".
#
# LIMITS, stated because they bound the verdict (report-only is the honest response to both):
#  · the RENDERER truncates long arguments with an ellipsis, and we truncate at LOOP_ARG_CAP on top of
#    that — two long DISTINCT commands can render identically → over-report. Contrariwise an argument
#    carrying a timestamp/pid makes a genuine repeat look distinct → under-report. Both are silent.
#  · a Bash action's identity is a MODEL-AUTHORED description, so two different commands sharing one
#    description merge, and one command re-described differently splits. For "is the mind doing the
#    same thing again" that label is arguably the better signal — but it is a label, not the bytes.
#  · this reads the PANE (doctrine: tmux is the only way to see into a node), not the engine's session
#    JSONL, so it sees what a human sees and no more.
#  · the mesh's own idiom is NOT covered by the paper: a reflex-driven mind legitimately re-runs one
#    command per turn (a poll). Repetition is therefore EVIDENCE, not a fault — which is why nothing
#    here alerts, sheds, or feeds a state. Wiring an edge-trigger before this is calibrated live would
#    be the cry-wolf shape the algedonic/habituation work already paid for once.
LOOP_LINES="${MESH_MIND_LOOP_LINES:-400}"              # capture depth per sample (frame + any history)
LOOP_MIN_TICKS="${MESH_MIND_LOOP_MIN_TICKS:-6}"        # below this many samples: honest n/a
LOOP_MIN_REPEATS="${MESH_MIND_LOOP_MIN_REPEATS:-4}"    # consecutive identical action-set ticks for STATIC
LOOP_MIN_SPAN_S="${MESH_MIND_LOOP_MIN_SPAN_S:-900}"    # ...which must ALSO cover this much wall time.
                                                       # A tick count alone is cadence-relative: a hand-run
                                                       # sampler at 2s reached streak=4 in SIX SECONDS on
                                                       # this node and reported STATIC for a mind that was
                                                       # perfectly busy. The span floor makes the verdict a
                                                       # claim about the MIND (15 min of unchanging visible
                                                       # action) instead of a claim about how fast we looked.
LOOP_ARG_CAP="${MESH_MIND_LOOP_ARG_CAP:-80}"           # argument chars kept in the canonical form
LOOP_WIN_S="${MESH_MIND_LOOP_WIN_S:-3600}"             # ring rows older than this are not counted. 1h
                                                       # = 6 ticks of the 600s --watch cadence that
                                                       # drives the sampler (mesh-liveness-loop:44),
                                                       # i.e. exactly LOOP_MIN_TICKS. A loop faster
                                                       # than the tick is INVISIBLE to this read.
# THE FLOOR EQUALS THE CEILING, and that is why this read renders almost nothing (measured 2026-08-21,
# senses, task mindstate-loop-is-the-only-freeze-detector-and-is-unwired). At a 600s sampler cadence a
# 3600s window can hold at most 6 rows, and only WORKING ticks are admitted — so LOOP_MIN_TICKS=6
# demands 6 of 6 ticks WORKING, i.e. a mind that was mid-turn at every single sample for a solid hour.
# One idle tick and the verdict is n/a. Live on this node the same minute: ALL 15 mind windows n/a,
# best ticks=4 (genome), most ticks=0. So the answer to "should --loop get a cron cadence" is NO — not
# for the reason it was asked (blind to an idle freeze) but for a stronger one: a scheduled reader
# would emit n/a for the whole fleet almost always, which is the hollow-sense shape this codebase
# already pays for. The freeze case it half-caught is answered where it is a FACT and not an
# inference — mesh-supervise's pid_halted() (cgroup.events `frozen 1` / stat 'T'), which needs no
# window, no streak and no 15-minute wait, and catches an IDLE freeze this read structurally cannot.
# The ratio is a CALIBRATION question (lower the floor, widen the window, or sample faster) and is
# deliberately NOT guessed at here: changing it without live data would trade a silent n/a for a
# confident wrong verdict. Re-derive before quoting — this arithmetic is a function of BOTH constants
# and of mesh-liveness-loop's cadence, and any of the three can move.
LOOP_RING_MAX="${MESH_MIND_LOOP_RING_MAX:-400}"        # hard cap on ring rows kept per window

# loop_actions — stdin: raw pane text → one CANONICAL action per line (see the block above).
# The tool-name gate is deliberately tight (`Word` or `Word Word`, each Capitalized): assistant PROSE
# is rendered with the very same `●` bullet, so a loose `.*(` would count sentences like
# "● Reading the file (again)" as actions and manufacture a loop out of a mind that merely narrates.
loop_actions() {
  awk -v cap="$LOOP_ARG_CAP" '
    { line=$0; sub(/^[[:space:]]+/,"",line); if (line=="") next
      # CONFIRMATION: a bullet is an ACTION only if the next non-empty line is its ⎿ continuation.
      # Without this every narrated sentence would count, and a mind that merely writes prose in a
      # consistent voice would read as a loop.
      if (pend!="") {
        # RUNNING vs COMPLETED, from the continuation itself: a Bash call shows `$ <cmd>` there ONLY
        # while it runs and its OUTPUT once it finishes. That flip is the only evidence in the pane
        # that separates ONE long action from the SAME action started again (see loop_report).
        if (line ~ /^⎿[^A-Za-z0-9]{0,6}\$ /) print "R\t" pend
        else if (line ~ /^⎿/) print "C\t" pend
        pend=""
      }
      if (line ~ /^(●|⏺)/) {
        rest=line; sub(/^(●|⏺)[^A-Za-z]*/,"",rest)
        # NB the separator after the bullet is stripped with [^A-Za-z]* because the live render uses a
        # NBSP in places, which glibc does not classify as [[:space:]].
        if (match(rest, /^[A-Z][A-Za-z]*( [A-Z][A-Za-z]*)?\(/)) {
          tool=substr(rest,1,RLENGTH-1); arg=substr(rest,RLENGTH+1)
          sub(/\)[[:space:]]*$/,"",arg); gsub(/[[:space:]]+/," ",arg)
          if (length(arg)>cap) arg=substr(arg,1,cap)
          pend=tool "(" arg ")"
        } else {
          gsub(/[[:space:]]+/," ",rest)
          if (length(rest)>cap) rest=substr(rest,1,cap)
          if (rest!="") pend="Bash:" rest
        }
      }
    }
    # a trailing candidate whose continuation has not rendered yet stays UNCONFIRMED (dropped here,
    # picked up on the next tick once its ⎿ line exists).
  '
}

loop_key()       { printf '%s' "$1" | tr -c 'A-Za-z0-9._-' '_'; }   # node@win → a safe file key
loop_ring_file() { echo "$MESH/.mind-loop-$(loop_key "$1")"; }       # ts<TAB>digest<TAB>lead action

# loop_sample — $1=key $2=raw pane text $3=classified state. Records ONE row per tick: a digest of the
# frame's ACTION SET (canonical actions, deduped and sorted) plus its lead action, for later comparison.
# Silent, report-only, cheap enough to ride every --watch tick.
#
# SAMPLED ONLY WHILE THE STATE IS **WORKING**. That gate is not a nicety, it is what makes the axis mean
# anything: an IDLE pane also shows an unchanging action set, and calling that a loop would flag every
# resting mind in the fleet. Composed with classify() instead of duplicating it, the reading becomes the
# precise thing the header calls the other blind state — "classified WORKING for N consecutive ticks
# while the visible actions never changed".
#
# TWO MEASURED FACTS ABOUT THE SURFACE, both of which shaped this (mesh-home, 2026-08-14):
#  1. There is no scrollback: every mind pane holds tmux's ALTERNATE screen (`#{alternate_on}=1`,
#     `#{history_size}=0` on genome/job/senses/witness), so `capture-pane -S -2000` returns the ~41-line
#     visible frame. A one-shot "count repeats in the history" read is impossible; this is why the read
#     is cross-tick at all.
#  2. The frame is not a faithful tail of the transcript: a single large rendered block (a diff) can
#     occupy the whole frame while newer short calls are ABSENT from the capture entirely — measured by
#     issuing 7 identical probes and finding none of them in the frame, which showed one older Update
#     block. So COUNTING repeated actions from the pane is not sound, at any cadence. What IS sound is
#     comparing successive frames' action sets: TURNOVER of the visible action content.
loop_sample() {
  local key="$1" raw="$2" state="${3:-}" ring acts digest lead now
  [ "$state" = WORKING ] || return 0
  ring="$(loop_ring_file "$key")"; now="$(date +%s)"
  acts="$(printf '%s\n' "$raw" | loop_actions | cut -f2- | sort -u | grep -v '^$' || true)"
  [ -n "$acts" ] || return 0
  digest="$(printf '%s\n' "$acts" | cksum | awk '{print $1}')"
  lead="$(printf '%s\n' "$acts" | head -1)"
  printf '%s\t%s\t%s\n' "$now" "$digest" "$lead" >> "$ring" 2>/dev/null || true
  if [ "$(wc -l < "$ring" 2>/dev/null || echo 0)" -gt "$LOOP_RING_MAX" ]; then
    tail -n "$LOOP_RING_MAX" "$ring" > "$ring.tmp" 2>/dev/null && mv "$ring.tmp" "$ring"
  fi
}

# loop_report — $1=key → "<VERDICT>\tticks=<n> sets=<u> streak=<k> streak-span=<s>s lead=<action>"
# over the ring rows inside LOOP_WIN_S. Verdicts:
#   STATIC        the frame's action SET was byte-identical across >=LOOP_MIN_REPEATS CONSECUTIVE ticks
#                 spanning >=LOOP_MIN_SPAN_S seconds, while the window was classified WORKING.
#                 BOTH conditions are required: ticks alone measure the sampler, not the mind.
#                 **STATIC NAMES NO CAUSE, and the verdict line says so.** The word this file was
#                 built around ("reasoning loop") is only ONE of at least three states that render
#                 identically here, and their remedies are opposite:
#                   · a reasoning loop — the mind is running, repeating itself   → interrupt / re-prompt
#                   · a hung tool call — one action started and never returned    → kill the tool
#                   · a FROZEN or STOPPED process — the mind executes nothing at all, and the pane is
#                     simply the last frame it painted                            → thaw / kill -9
#                 The third was measured on this node 2026-08-21 (health's verify arm of discover's
#                 delegated-cgroup capability): a cgroup-frozen pane reads WORKING here for tick after
#                 tick with a byte-frozen evidence string, and --loop flips STATIC on it — correctly,
#                 but for a reason it cannot see. It is one bit apart from a live loop from the pane,
#                 and the pane is all this reads. THE SEPARATING READ IS NOT HERE: it is
#                 mesh-supervise's pid_halted() (/proc/<pid>/stat 'T'/'t', and cgroup.events
#                 `frozen 1` — never cgroup.freeze, which reads 0 under an ancestor's freeze). Ask
#                 that of the pane's pid before acting on a STATIC.
#   TURNING-OVER  the visible action set keeps changing.
#   n/a           fewer than LOOP_MIN_TICKS WORKING samples in the window — too little evidence.
# CONSECUTIVE streak, not global share: an interleaved frame (a big older block co-resident with a new
# call) breaks the streak honestly, where a share statistic would have kept accumulating.
loop_report() {
  local ring rows n u streak sspan lead verdict
  ring="$(loop_ring_file "$1")"
  rows="$(awk -F'\t' -v cut="$(( $(date +%s) - LOOP_WIN_S ))" '$1+0>=cut{print}' "$ring" 2>/dev/null || true)"
  n="$(printf '%s\n' "$rows" | grep -c '.' || true)"
  if [ "${n:-0}" -lt "$LOOP_MIN_TICKS" ]; then
    printf 'n/a\tticks=%s (<%s WORKING samples in %ss — idle/blocked, an unparsed engine dialect, or too few ticks yet)\n' "${n:-0}" "$LOOP_MIN_TICKS" "$LOOP_WIN_S"
    return
  fi
  u="$(printf '%s\n' "$rows" | cut -f2 | sort -u | grep -c '.' || true)"
  # longest run of consecutive identical digests, its wall span, and the lead action of that run
  IFS=$'\t' read -r streak sspan lead <<<"$(printf '%s\n' "$rows" | awk -F'\t' '
    { if($2==prev){ run++; if(rs==""){rs=pts} } else { run=1; rs=$1 }
      if(run>best){ best=run; bspan=$1-rs; blead=$3 }
      prev=$2; pts=$1 }
    END{ printf "%d\t%d\t%s", best+0, bspan+0, blead }')"
  verdict=TURNING-OVER
  { [ "${streak:-0}" -ge "$LOOP_MIN_REPEATS" ] && [ "${sspan:-0}" -ge "$LOOP_MIN_SPAN_S" ]; } && verdict=STATIC
  # STATIC IS AN OBSERVATION, NOT A DIAGNOSIS — carried IN the line, because a consumer reads the
  # line and not this comment. See the cause note at the top of loop_report.
  if [ "$verdict" = STATIC ]; then
    printf '%s\tticks=%s sets=%s streak=%s streak-span=%ss lead=%s cause=UNSEPARATED(reasoning-loop|hung-tool-call|frozen-or-stopped-process; separate it with mesh-supervise pid_halted / cgroup.events on the pane pid, NOT from here)\n' \
      "$verdict" "$n" "$u" "${streak:-0}" "${sspan:-0}" "${lead:-?}"
  else
    printf '%s\tticks=%s sets=%s streak=%s streak-span=%ss lead=%s\n' "$verdict" "$n" "$u" "${streak:-0}" "${sspan:-0}" "${lead:-?}"
  fi
}

# peek_win_deep — like peek_win but with SCROLLBACK: a loop lives in history, not in the last frame.
peek_win_deep() { # $1=window $2=node(local|user@ip)
  [ -n "${MESH_MIND_STATE_LOOPCAP_CMD:-}" ] && { eval "$MESH_MIND_STATE_LOOPCAP_CMD"; return; }
  local win="$1" node="$2" cmd
  cmd="pidx=\$(tmux list-panes -t \"\$(hostname):$win\" -F '#{pane_top} #{pane_index}' 2>/dev/null | sort -n | tail -1 | awk '{print \$2}'); tmux capture-pane -t \"\$(hostname):$win\${pidx:+.\$pidx}\" -p -S -$LOOP_LINES 2>/dev/null"
  if [ "$node" = local ]; then bash -c "$cmd"
  else ssh -o BatchMode=yes -o ConnectTimeout=8 "$node" "$cmd"; fi
}

# COOLDOWN: suppress repeated block/limited alerts for the same window
cooldown_file() { local win=$1 state=$2; echo "$MESH/.mind-state-cooldown-$win-$state"; }
cooldown_check() {
  local win=$1 state=$2 cooldown_sec=$3
  local cf=$(cooldown_file "$win" "$state") now=$(date +%s)
  if [ -f "$cf" ]; then
    local last=$(cat "$cf")
    if [ $((now - last)) -lt "$cooldown_sec" ]; then return 1; fi
  fi
  return 0
}
cooldown_set() { local win=$1 state=$2; local cf=$(cooldown_file "$win" "$state"); echo "$(date +%s)" > "$cf"; }
BLOCK_COOLDOWN="${MESH_BLOCK_COOLDOWN:-60}"
LIMITED_COOLDOWN="${MESH_LIMITED_COOLDOWN:-300}"
UNBLOCK_COOLDOWN="${MESH_UNBLOCK_COOLDOWN:-60}"   # chat-review/mindunblocked-cooldown-asymmetry floor

# announced_file/mark/consume — chat-review/mindunblocked-cooldown-asymmetry: the 3 entry branches
# below (blocked/limited/wedged) each gate on cooldown_check, but a flap faster than the cooldown
# suppresses the ENTRY post while mind_transition_due still fires the RECOVERY later — so
# [mind-unblocked] posted unconditionally, with no paired entry on the board (live: 28 unblocked vs
# 8 entries in one 220-line window). Track whether THIS episode's entry actually reached the board;
# the recovery consumes that mark and only posts if it was set, else it has nothing to pair with and
# is routed to trace instead (still recorded, just not board noise).
announced_file(){ echo "$MESH/.mind-state-announced-$1"; }
announced_mark(){ : > "$(announced_file "$1")"; }
announced_consume(){ local f; f="$(announced_file "$1")"; [ -f "$f" ] && { rm -f "$f"; return 0; }; return 1; }

alert(){ if [ -n "${MESH_ALERT_DRYRUN:-}" ]; then echo "[dryrun] would alert: $1" >&2; return; fi
  local msg="$1"
  # win = the actual WINDOW ("<hostname>:<window> ..." right after the bracket tag), NOT the tag
  # itself. Discovered fixing mindunblocked-cooldown-asymmetry: the old pattern (greedy .*\[ before
  # a single bracket pair) captured the bracket's OWN contents ("mind-blocked"/"mind-wedged"/...),
  # so cooldown_file/announced_file were keyed by ALERT TYPE, not per-window — every window's
  # NEEDS-INPUT alert shared ONE cooldown file, silently cross-suppressing sibling windows, and
  # (fatal to THIS fix) an entry's "mind-blocked" mark could never pair with its own recovery's
  # "mind-unblocked" lookup, since the two tags never key the same file.
  local win=$(echo "$msg" | sed -nE 's/^\[[^]]+\][[:space:]]*[^:[:space:]]+:([^[:space:]]+).*/\1/p')
  if echo "$msg" | grep -q "\[mind-blocked\]"; then
    cooldown_check "$win" "NEEDS-INPUT" "$BLOCK_COOLDOWN" && { cooldown_set "$win" "NEEDS-INPUT"; announced_mark "$win"; MESH_WHO="mind-state@$(hostname)" mesh-chat "$msg" >/dev/null 2>&1; }
  elif echo "$msg" | grep -q "\[mind-limited\]"; then
    cooldown_check "$win" "RATE-LIMITED" "$LIMITED_COOLDOWN" && { cooldown_set "$win" "RATE-LIMITED"; announced_mark "$win"; MESH_WHO="mind-state@$(hostname)" mesh-chat "$msg" >/dev/null 2>&1; }
  elif echo "$msg" | grep -q "\[mind-wedged\]"; then
    # chat-review/mindwedged-autofire-case-to-trace (2026-07-08): the caller passes route=trace for
    # the proven-self-recovering case (mesh-injected /clear|/model, matched at the watch_tick call
    # site) — same trace-diversion mind-unblocked already does for un-paired recoveries below.
    if [ "$2" = trace ]; then
      command -v mesh-trace >/dev/null 2>&1 && MESH_WHO="mind-state@$(hostname)" mesh-trace "$msg" >/dev/null 2>&1
    else
      cooldown_check "$win" "WEDGED-INPUT" "$LIMITED_COOLDOWN" && { cooldown_set "$win" "WEDGED-INPUT"; announced_mark "$win"; MESH_WHO="mind-state@$(hostname)" mesh-chat "$msg" >/dev/null 2>&1; }
    fi
  elif echo "$msg" | grep -q "\[mind-unblocked\]"; then
    if announced_consume "$win" && cooldown_check "$win" "UNBLOCKED" "$UNBLOCK_COOLDOWN"; then
      cooldown_set "$win" "UNBLOCKED"; MESH_WHO="mind-state@$(hostname)" mesh-chat "$msg" >/dev/null 2>&1
    else
      command -v mesh-trace >/dev/null 2>&1 && MESH_WHO="mind-state@$(hostname)" mesh-trace "$msg" >/dev/null 2>&1
    fi
  else
    MESH_WHO="mind-state@$(hostname)" mesh-chat "$msg" >/dev/null 2>&1
  fi
}

# watch_tick — the real --watch per-window body, extracted so --test can drive it directly as a
# LOOP-LEVEL fixture (two consecutive calls = two frames) instead of only unit-testing
# mind_transition_due in isolation with hand-picked args that never occur in real invocation
# (mindstate-unblocked-edge-unreachable 2026-07-06: a direct fn-call test greened at :486 while the
# real wiring never reached that code shape — falsifiable here by reverting the posted-based checks).
watch_tick() {
  local w="$1" raw="$2" node="${3:-local}"
  local out state ev wstate _stuck now statef sincef seenf prev since posted transition age prompt_lines _wtxt _wpidx
  out="$(classify_win "$w" "$node" "$raw")"
  state="${out%%	*}"; ev="${out#*	}"
  # REASONING-LOOP SAMPLER (report-only, see the --loop block at ~:520): ride this existing cadence so
  # the ring fills without a second cron line. Writes only its own per-window ring file; it cannot
  # change $state, $ev, an alert, or an exit code. Failures here are swallowed on purpose — a broken
  # sampler must never take the state watcher down with it.
  if [ "$node" = local ]; then loop_sample "$w" "$raw" "$state" 2>/dev/null || true
  else loop_sample "$node@$w" "$raw" "$state" 2>/dev/null || true; fi
  # WEDGED-INPUT overlay: cross-tick (see header). Runs on every frame — non-IDLE frames clear the
  # per-window input memory inside wedge_state, so a WORKING turn between two identical-text idles
  # resets the 2-tick requirement.
  wstate="$(wedge_state "$w" "$state" "$raw")"
  if [ "$wstate" != "$state" ]; then
    state=$wstate
    _stuck="$(sanitize_quote "$(input_stuck_text "$raw")")"
    ev="input line stuck ≥2 ticks, never submitted: '${_stuck:0:40}'"
  fi
  now="$(date +%s)"
  statef="$(mind_state_file "$w")"
  sincef="$(mind_since_file "$w")"
  seenf="$(mind_seen_file "$w")"
  prev="$(cat "$statef" 2>/dev/null || echo NONE)"
  since="$(cat "$sincef" 2>/dev/null || echo "$now")"
  posted="$(cat "$seenf" 2>/dev/null || echo NONE)"
  # TRANSITION bookkeeping (chat-review/mind-state-watch-drops-transition 2026-07-05): a state flip
  # updates the state/since artifacts and RESETS the age baseline (since=now → age=0), then falls
  # through to the print below. The window's status line MUST be emitted every pass, or mesh-dash
  # minds drops that channel for a whole frame on every WORKING↔IDLE flip (the old bare `continue`
  # skipped the print). The alert block stays gated to NON-transition frames (transition=0), so it
  # fires exactly when it did before — the old `continue` skipped it on the flip frame, and the
  # age=0 reset would debounce-gate it here anyway; the flag makes that invariant explicit.
  transition=0
  if [ "$state" != "$prev" ]; then
    echo "$state" > "$statef"
    echo "$now" > "$sincef"
    since="$now"; transition=1
  fi
  [ -f "$sincef" ] || echo "$now" > "$sincef"
  age=$((now - since))
  echo "$w: $state — $ev"
  if [ "$transition" = 0 ] && mind_transition_due "$state" "$prev" "$posted" "$age"; then
    echo "$state" > "$seenf"
    if [ "$state" = NEEDS-INPUT ]; then
    # Summarize: classification evidence ($ev) is the concise reason. Full raw prompt goes
    # to the mind's own pane (for operator SSH inspection) and stderr (for retainability in
    # the mind's scrollback). The board gets only the summary — no raw TUI noise.
    prompt_lines="$(printf '%s\n' "$raw" | grep -vE '^[[:space:]]*$' | tail -8)"
    # same bottom-8 blindness as classify: the TG ping sends head -3 of this, which for an option
    # dialog is the tail of the option list — the operator got keybindings and no question. Lead
    # with the question when the dialog has one.
    dq="$(option_dialog_question "$raw")"
    [ -n "$dq" ] && prompt_lines="$dq
$prompt_lines"
    echo "full block-prompt for $w: ${prompt_lines}" >&2
    # BOARD reason: prefer the extracted dialog question (dq) over raw $ev — same fix the TG path
    # already got at :594 (chat-review/mindblocked-board-summary-skips-dq, 2026-07-21). $ev is the
    # bottom-8 classification evidence, which for an option dialog is the tail of the option list
    # (keybindings/filler), so board-only readers got the cut-off reason while TG got the question.
    # Fall back to $ev when the block isn't a question-bearing dialog (dq empty).
    alert "[mind-blocked] $(hostname):$w waiting on input — $(summarize_reason "${dq:-$ev}")"
    command -v mesh-tg >/dev/null 2>&1 && mesh-tg "🤖 $(hostname):$w ждёт ввода:
$(sanitize_quote "$(printf '%s' "$prompt_lines" | head -3)")
Ответь 'одобряю $w' (разрешу один раз) или 'отклони $w'. Не форсю — твоё решение." >/dev/null 2>&1 || true
    elif [ "$state" = RATE-LIMITED ]; then
      alert "[mind-limited] $(hostname):$w quota-exhausted — '$(sanitize_quote "$ev")' — route work elsewhere (mesh-relay/other minds)"
    elif [ "$state" = WEDGED-INPUT ]; then
      # chat-review/mindwedged-autofire-case-to-trace (2026-07-08): classify BEFORE alerting, so a
      # proven-self-recovering wedge (mesh-injected /clear|/model, matched below) can route its alert
      # to trace instead of the board — this class was 13/220 (10.5%) identical board lines in one
      # session, each self-recovering within minutes via the auto-fire right below. Arbitrary/operator
      # text always keeps the board post (genuinely needs eyes), even if MESH_WEDGE_RECOVER=1 also
      # auto-fires the C-u+resend for it. Falsify: hardcode _wroute=chat and the /clear fixture's
      # trace-routing assertion fails (line still lands on the board).
      _wtxt="$(input_stuck_text "$raw")"
      case "$_wtxt" in
        /clear|/model|"/model "*) _wauto=1; _wroute=trace ;;
        *) _wauto="${MESH_WEDGE_RECOVER:-0}"; _wroute=chat ;;
      esac
      alert "[mind-wedged] $(hostname):$w — $ev — harness ate the submission (pane reads IDLE); recover: C-u in the pane, then mesh-tell $w the text (MESH_WEDGE_RECOVER=1 automates)" "$_wroute"
      # Auto-recovery: the exact sequence minds proved live 2026-07-06 16:18Z — C-u clears the
      # phantom line, a fresh mesh-tell re-injects+submits. CAVEAT (still gates the general case):
      # the captured text is the pane's RENDERING of the input line — single line, width-truncated;
      # for arbitrary/operator text a truncated re-send could mangle it worse than a lost
      # submission, so that stays MESH_WEDGE_RECOVER-gated, the operator's call.
      if [ "$_wauto" = 1 ]; then
        _wpidx="$(tmux list-panes -t "$(hostname):$w" -F '#{pane_top} #{pane_index}' 2>/dev/null | sort -n | tail -1 | awk '{print $2}')"
        tmux send-keys -t "$(hostname):$w${_wpidx:+.$_wpidx}" C-u 2>/dev/null
        sleep 1
        command -v mesh-tell >/dev/null 2>&1 && [ -n "$_wtxt" ] && mesh-tell "$w" "$_wtxt" >/dev/null 2>&1
      fi
    elif [ "$posted" = NEEDS-INPUT ] || [ "$posted" = RATE-LIMITED ] || [ "$posted" = WEDGED-INPUT ]; then
      # chat-review/mindstate-unblocked-healthy-gate (live-reproduced 2026-07-06T18:20Z): this branch
      # only checked $posted was a blocked state — it never checked what the NEW state actually IS,
      # so a blocked mind going UNREACHABLE (tmux capture failing, a card-gated node's pane vanishing)
      # posted "[mind-unblocked] ... now UNKNOWN" — read as an all-clear when it's really LOSS OF
      # OBSERVATION. Live false all-clears: phaedra:chat 18:20:21Z + ds:genome 18:20:33Z, both "now
      # UNKNOWN". seenf is ALREADY advanced above (line 445) regardless of which state this is — that
      # part stays unconditional, so a genuine later recovery to IDLE/WORKING can still fire cleanly.
      # Only the BOARD CLAIM needs the healthy-state gate: honest-fusion says an unreachable mind
      # renders UNKNOWN, never an "unblocked" claim.
      case "$state" in
        IDLE|WORKING) alert "[mind-unblocked] $(hostname):$w now $state" ;;
        *) : ;;   # UNKNOWN/DEAD/ABSENT/etc — seenf already advanced, no false all-clear
      esac
    fi
  fi
}

if [ "${1:-}" = --test ]; then
  command -v tmux >/dev/null 2>&1 || { echo "smoke-test: FAIL (no tmux)"; exit 1; }

  # ── FIXTURE SOCKET HYGIENE (chat-review/test-tmux-fixture-leaks-server-on-timeout 2026-07-17) ──────
  # The DEAD-SHELL fixture below spawns a DETACHED tmux server on a PRIVATE socket (mindstateshell$$) and
  # frees it only on the happy path (kill-server at block end). Under mesh-doctor's parallel smoke STORM
  # this --test blows timeout 12 → SIGTERM lands mid-fixture → bash skips the tail cleanup on an unhandled
  # fatal signal → the detached server (its OWN daemon, outside our process tree) is immortal (6 live
  # mindstateshell servers were accreting on this node). Two guards, twin of mesh-tell's:
  #  (1) a TRAP reaping every socket THIS run created, on EXIT/TERM/INT (EXIT alone insufficient — bash
  #      runs the EXIT trap on a TERM only when TERM is itself trapped);
  #  (2) reap-on-entry draining prior storm-killed fixtures (socket embeds the creator $$) with a DEAD pid;
  #      a live pid = concurrent doctor/hand run → leave it.
  _fx_socks=""
  _fx_dir="/tmp/tmux-$(id -u)"
