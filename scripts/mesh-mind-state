  case "$_bl" in *'What database should we migrate to'*) :;; *) _dqfail "board reason drops the question (dq) — got: $_bl";; esac
  case "$_bl" in *'Tab to amend'*|*'Esc to cancel'*) _dqfail "board reason leaks the filler footer instead of the question: $_bl";; esac
  unset -f mesh-tg; rm -rf "$MESH"; MESH="$_dq_wmesh"; MIND_DEBOUNCE_SEC="$_dbo4"; unset MESH_ALERT_DRYRUN

  # ── mindwedged-autofire-case-to-trace (chat-review 2026-07-08) ──────────────────────────────────
  # The auto-fire /clear|/model wedge is proven self-recovering within this same run (previous
  # fixture above), so its alert must route to trace, not the board — mirroring mind-unblocked's own
  # trace-diversion for un-paired recoveries. Arbitrary operator text keeps the board post (genuinely
  # needs eyes). No MESH_ALERT_DRYRUN here — dryrun short-circuits alert() before the routing choice,
  # so this exercises the real chat-vs-trace branch. Falsify: hardcode _wroute=chat at the call site
  # and the /clear assertion below fails (board gets the line instead of trace).
  _wr_wmesh="$MESH"; MESH="$(mktemp -d)"
