#!/usr/bin/env bash
# mesh-mind-state — classify what a mind's tmux pane is doing: WORKING / NEEDS-INPUT / IDLE / DEAD.
# The amux idea (state from ANSI-stripped scrollback, no hooks into the agent) adopted tmux-native,
# after 2026-06-12: ds's mind sat HOURS on a permission prompt — UP for supervise, DEAD for work.
# NEEDS-INPUT is the blind state: liveness checks see a live pane, work checks see no progress.
#
#   mesh-mind-state <window> [--node user@ip]   classify one mind window (prints STATE + evidence line)
#   mesh-mind-state --stats [win ...]           per-window state + model/tokens/pct/dollars (opencode usage)
#   mesh-mind-state --watch [win ...]           classify mind windows (default: plan health verify work);
#                                               edge-triggered [mind-blocked]/[mind-unblocked] board alerts
#   mesh-mind-state --test                      smoke test (classifier exercised on golden pane texts)
#
# Exit (single window): 0 WORKING/IDLE/UNKNOWN · 4 NEEDS-INPUT · 5 DEAD · 6 RATE-LIMITED · 7 ABSENT. --watch exits 0.
# MESH_ALERT_DRYRUN=1 → print would-be alerts, don't send.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
MESH="$HOME/.mesh"; mkdir -p "$MESH"

# Patterns are engine-agnostic where possible; the dialog shapes are Claude Code's today — extend per
# engine as their dialogs are met in the wild. Checked in priority order: dialog beats spinner beats prompt.
# canonical wall regex (DRY — knowledge/inter-tool-inconsistency-canonical-definitions-2026-06-14).
# Source the shared source if deployed; else fall back to an inline copy so this tool never breaks
# on genome drift. Was a private regex here that MISSED resets/429/overloaded/upgrade-to-pro.
[ -r "$HOME/.local/bin/mesh-patterns.sh" ] && . "$HOME/.local/bin/mesh-patterns.sh" 2>/dev/null
: "${MESH_RL_RE:=hit your (usage|session) limit|usage limit reached|rate.?limit|429|too many requests|quota.*(exhaust|exceed)|out of credits|purchase more credits|upgrade to (pro|team)|try again (at|later|in)|resets? (at )?[0-9]|overloaded}"
# STRONG subset — phrases an ENGINE STOP banner uses but agent prose essentially never does. These
# match anywhere (minus prompt-glyph lines). The rest of MESH_RL_RE (bare rate-limit, overloaded,
# try-again, resets, quota) ALSO appears in a mind's own SUMMARY PROSE when it writes ABOUT quotas
# (operator FP 2026-06-15: plan wrote "rate-limit walls cascading"; sense held the AGENTIC-FAILOVER
# design doc literally containing "RATE-LIMITED") → those broad tokens only count on a TERSE banner.
: "${MESH_STRONG_RL_RE:=hit your (usage|session) limit|usage limit reached|too many requests|429|out of credits|purchase more credits|upgrade to (pro|team)}"
MESH_RL_BANNER_MAXLEN="${MESH_RL_BANNER_MAXLEN:-100}"  # an engine banner is terse; agent prose is long-form

classify() { # stdin: pane text (last lines, blank-stripped). prints "STATE<TAB>evidence"
  local txt tail8
  txt="$(cat)"
  [ -n "$txt" ] || { printf 'DEAD\tempty pane\n'; return; }
  # Only the bottom 8 lines — that's where a TUI's live status bar / dialog actually sits. Scanning
  # deeper matches QUOTED patterns in agent output (this very tool misclassified its own author's
  # pane as RATE-LIMITED off a test fixture shown in a diff). Residual risk accepted: output that
  # quotes a dialog right at the bottom still fools it.
  tail8="$(printf '%s\n' "$txt" | tail -8)"
  local ev
  # strictly-LIVE markers first: these appear only while a turn is actually running (a dialog or
  # quota stop never shows 'esc to interrupt'); past-tense '✻ Crunched for 4m' must NOT match
  ev="$(printf '%s\n' "$tail8" | grep -m1 -E \
    'esc (to )?interrupt|…[[:space:]]*\([0-9]+m?|ing\.\.\.[[:space:]]*\([0-9]')" \
    && { printf 'WORKING\t%s\n' "$ev"; return; }
  ev="$(printf '%s\n' "$tail8" | grep -m1 -E \
    'Do you want to (proceed|make this edit|create|delete|allow)|❯ 1\. Yes|Esc to cancel|Tab to amend|\(y/[Nn]\)[[:space:]]*$|Select an option|press Enter to continue|to grant|Allow once|Always allow')" \
    && { printf 'NEEDS-INPUT\t%s\n' "$ev"; return; }
  # RATE-LIMITED only from a real STOP banner — NOT from the input box. The composing/draft line
  # (and tab-completion ghost text) starts with the prompt glyph ❯/› and often carries quota words
  # (a mind drafting a message ABOUT rate limits, a recalled command, a tab suggestion) — that is
  # the mind's INPUT, not its STATE. The genuine quota banner ("■ You've hit your usage limit…")
  # never starts with the prompt glyph. So drop prompt-glyph lines before the quota match.
  # (operator-reported false-positive 2026-06-15: plan window read RATE-LIMITED off a tab suggestion
  # in the input box.)
  # Decide RATE-LIMITED via the SHARED rl_is_walled (mesh-patterns.sh) — the ONE banner-shape gate:
  # drops prompt-glyph input lines; STRONG phrases match any length; broad tokens only on a TERSE line
  # (a mind's long-form prose discussing quotas is NOT its state); and a banner ABOVE a live ready
  # footer / spinner is STALE → not walled (operator FP 2026-06-15: discover/sense recovered after
  # their 2:20pm reset but the old banner sat in scrollback). Inline two-tier fallback if the lib is
  # absent (no recovered-guard then — but WORKING above already caught the spinner-recovered case).
  # Strip board-echo lines before the RL check: a board relay of "[mind-limited] node:win quota-exhausted"
  # matches quota.*(exhaust) in MESH_RL_RE → false RATE-LIMITED for the pane that displayed the echo.
  # Board lines have the form "TIMESTAMP  who@node  ::  body" (mesh-chat uses DOUBLE spaces).
  # grep -vE with single spaces silently fails to strip them — corrected to double spaces (37629dc bug).
  local tail8_noboard
  tail8_noboard="$(printf '%s\n' "$tail8" | grep -vE '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:Z]+  [^ ]+  ::  ')"
  if printf '%s\n' "$tail8_noboard" | rl_is_walled 2>/dev/null \
     || { ! command -v rl_is_walled >/dev/null 2>&1 \
          && printf '%s\n' "$tail8_noboard" | grep -vE '^[[:space:]]*[❯›]' \
             | awk -v m="${MESH_RL_BANNER_MAXLEN:-100}" 'length($0)<=m' | grep -qiE "$MESH_RL_RE"; }; then
    ev="$(printf '%s\n' "$tail8_noboard" | grep -vE '^[[:space:]]*[❯›]' | grep -m1 -iE "$MESH_STRONG_RL_RE" \
          || printf '%s\n' "$tail8_noboard" | grep -vE '^[[:space:]]*[❯›]' \
             | awk -v m="${MESH_RL_BANNER_MAXLEN:-100}" 'length($0)<=m' | grep -m1 -iE "$MESH_RL_RE")"
    printf 'RATE-LIMITED\t%s\n' "$ev"; return
  fi
  # IDLE = ready prompt with NO turn running. Bare-prompt regex alone is fragile (border lines /
  # trailing pad / leading indent push the '❯ ' line around), so also match POSITIVE ready-footers.
  # Safe BY ORDERING: a working pane always carries a spinner / 'esc to interrupt' caught by WORKING
  # above, so reaching here means no turn is running — the footer then means genuinely idle.
  #   ⏵⏵ auto mode on        → Claude Code / gemini ready footer (older builds; working adds 'esc to interrupt')
  #   ? for shortcuts.*agents → Claude Code new-style idle footer (2026-06-13+ builds)
  #   ›  Use /…              → codex ready prompt (working shows '◦ Working … esc to interrupt' → WORKING)
  #   Ask anything           → opencode idle input prompt (new MiMo/Zen UI layout)
  #   ctrl+p commands · OpenCode → opencode 1.16.x bottom status bar when idle (no spinner)
  # (new-UI patterns originated by the ds mind, stranded behind a blocked FF — ported here additively
  #  so the whole mesh detects new-build idle footers; the ds --watch divergence is left for ds reconcile.)
  # DEAD-BEFORE-IDLE (death truth, 2026-06-15): a killed mind leaves claude's last footer FROZEN in
  # scrollback (⏵⏵ auto mode on / ❯) with a fresh shell prompt below it. The IDLE footer match below
  # scans the bottom 8 lines and would match that STALE footer → a dead mind reads IDLE. So check the
  # LAST line for a bare shell prompt FIRST: a '$'/'%' prompt on the final line means the TUI exited,
  # regardless of any footer text above it. (A LIVE idle mind's last line is its footer/❯, never a
  # shell prompt, so this never false-DEADs a real idle mind.)
  printf '%s\n' "$txt" | tail -1 | grep -qE '\$[[:space:]]*$|%[[:space:]]*$' \
    && { printf 'DEAD\tbare shell prompt below stale footer (TUI exited)\n'; return; }
  # IDLE = ready footer with NO turn running and NO shell prompt below it.
  # LIMITATION (death truth, canon): if a kill leaves the frozen footer with NO shell prompt visible
  # (alt-screen not yet restored), the pane is BYTE-IDENTICAL to a live idle mind — pane text alone
  # CANNOT tell them apart. That residual case is why the process-truth layer (channel-keepalive's PID
  # check) is authoritative for relaunch/shed decisions; this display layer is best-effort.
  printf '%s\n' "$tail8" | grep -qE '^❯[[:space:]]*$|❯ $|^›[[:space:]]*$|⏵⏵ auto mode on|›[[:space:]]+Use /|^[[:space:]]*Use /skills to list|\? for shortcuts[^$]*agents|Ask anything|ctrl\+p commands' \
    && { printf 'IDLE\tready prompt, no turn running\n'; return; }
  printf 'UNKNOWN\t%s\n' "$(printf '%s\n' "$txt" | tail -1 | cut -c1-60)"
}

# sanitize_quote — neutralize quoted pane text so a banner/board-relay shown in a mind's pane can't be
# mis-parsed as a REAL board event by other scrapers (the phaedra:chat echo-loop, chat-review 2026-06-17:
# verify's quota banner was being re-quoted into [mind-blocked] and re-acted on). Drops full board-relay
# lines (TIMESTAMP who@node :: body), de-fangs marker brackets [x]->(x) and the '  ::  ' field separator,
# and collapses to a single line (a multi-line board post is itself a parse hazard). The OUTER
# [mind-blocked]/[mind-limited] marker is added by the caller AFTER this, so it stays intact.
sanitize_quote(){
  printf '%s\n' "$1" \
    | grep -vE '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:Z]+  [^ ]+  ::  ' \
    | sed 's/\[/(/g; s/\]/)/g; s/  ::  / : /g' \
    | tr '\n' ' ' | sed 's/  */ /g; s/ *$//'
}

if [ "${1:-}" = --test ]; then
  command -v tmux >/dev/null 2>&1 || { echo "smoke-test: FAIL (no tmux)"; exit 1; }
  s="$(printf ' Do you want to proceed?\n ❯ 1. Yes\n   2. No\n' | classify)"
  case "$s" in NEEDS-INPUT*) :;; *) echo "smoke-test: FAIL (dialog → $s)"; exit 1;; esac
  s="$(printf '✻ Whirring… (21m · 18k tokens · esc to interrupt)\n' | classify)"
  case "$s" in WORKING*) :;; *) echo "smoke-test: FAIL (spinner → $s)"; exit 1;; esac
  s="$(printf 'some output\n❯ \n' | classify)"
  case "$s" in IDLE*) :;; *) echo "smoke-test: FAIL (prompt → $s)"; exit 1;; esac
  s="$(printf '' | classify)"
  case "$s" in DEAD*) :;; *) echo "smoke-test: FAIL (empty → $s)"; exit 1;; esac
  # DEATH TRUTH (2026-06-15): a killed mind's STALE footer in scrollback with a fresh shell prompt
  # below it must read DEAD, not IDLE (the IDLE footer match would otherwise win on the stale footer).
  s="$(printf '❯ \n  ⏵⏵ auto mode on (shift+tab to cycle) · ← for agents\nimozerov@host:~/lte-workstation$ \n' | classify)"
  case "$s" in DEAD*) :;; *) echo "smoke-test: FAIL (stale footer + shell prompt below → should be DEAD: $s)"; exit 1;; esac
  s="$(printf '■ You'"'"'ve hit your usage limit. Upgrade or try again at 6:03 PM.\n› \n' | classify)"
  case "$s" in RATE-LIMITED*) :;; *) echo "smoke-test: FAIL (quota → $s)"; exit 1;; esac
  # REGRESSION (operator 2026-06-15): quota words in the INPUT BOX (draft / tab suggestion) are the
  # mind's input, not its state — must NOT read RATE-LIMITED. The prompt-glyph line is excluded.
  s="$(printf 'some output\n❯ should we retry after we hit the usage limit?\n' | classify)"
  case "$s" in RATE-LIMITED*) echo "smoke-test: FAIL (input-box quota text → false RATE-LIMITED: $s)"; exit 1;; esac
  # REGRESSION (operator 2026-06-15): a mind's own long-form SUMMARY PROSE that mentions quotas is
  # the mind's OUTPUT, not its STATE. The plan window read RATE-LIMITED off a 150+ char summary line.
  s="$(printf 'Noted but no action: rate-limit walls cascading (09:56-10:05) are designed thermal/quota backpressure via channel-keepalive, not a fault — just fewer hands during the cooldown.\n────\n❯ \n  ⏵⏵ auto mode on (shift+tab to cycle) · ← for agents\n' | classify)"
  case "$s" in RATE-LIMITED*) echo "smoke-test: FAIL (summary-prose quota text → false RATE-LIMITED: $s)"; exit 1;; esac
  case "$s" in IDLE*) :;; *) echo "smoke-test: FAIL (idle mind w/ quota prose should be IDLE → $s)"; exit 1;; esac
  # REGRESSION: a mind HOLDING a design-doc task ABOUT rate-limiting (the literal token RATE-LIMITED
  # in its task text) must not self-classify RATE-LIMITED (sense window, 2026-06-15).
  s="$(printf 'on a rate-limited claude worker auto-re-routes to an idle FREE-engine worker (opencode/codex). Propose the trigger (mind-state RATE-LIMITED → re-dispatch its open task) plus the de-dup so it does not double-build the same work.\n❯ \n  ? for shortcuts · ← for agents\n' | classify)"
  case "$s" in RATE-LIMITED*) echo "smoke-test: FAIL (task-text-about-ratelimit → false RATE-LIMITED: $s)"; exit 1;; esac
  # a TERSE genuine non-strong banner ("rate limit exceeded") must STILL read RATE-LIMITED
  s="$(printf 'API request failed: rate limit exceeded\n› \n' | classify)"
  case "$s" in RATE-LIMITED*) :;; *) echo "smoke-test: FAIL (terse rate-limit banner → $s)"; exit 1;; esac
  # REGRESSION (operator 2026-06-15): a STALE quota banner in scrollback ABOVE a live idle footer is
  # history — the mind recovered after its reset. Must read IDLE, not RATE-LIMITED (this starved
  # dispatch: discover/sense recovered but were excluded from the idle pool).
  s="$(printf '⎿  You'"'"'ve hit your session limit · resets 2:20pm (Europe/Moscow)\n   /upgrade to increase your usage limit.\n✻ Worked for 1s\n❯ \n  ⏵⏵ auto mode on (shift+tab to cycle) · ← for agents\n' | classify)"
  case "$s" in RATE-LIMITED*) echo "smoke-test: FAIL (stale banner above idle footer → false RATE-LIMITED: $s)"; exit 1;; esac
  case "$s" in IDLE*) :;; *) echo "smoke-test: FAIL (recovered mind should be IDLE → $s)"; exit 1;; esac
  # idle Claude-Code/gemini ready footer (no spinner) → IDLE
  s="$(printf '❯ \n────\n  ⏵⏵ auto mode on (shift+tab to cycle) · ← for agents\n' | classify)"
  case "$s" in IDLE*) :;; *) echo "smoke-test: FAIL (auto-mode idle footer → $s)"; exit 1;; esac
  # idle codex ready prompt → IDLE
  s="$(printf '› Use /skills to list available skills\n  gpt-5.4-mini medium · ~/lte-workstation\n' | classify)"
  case "$s" in IDLE*) :;; *) echo "smoke-test: FAIL (codex ready prompt → $s)"; exit 1;; esac
  # Claude Code new-style idle footer (2026-06-13+ builds with ? for shortcuts · ← for agents)
  s="$(printf '❯ Try "fix typecheck errors"\n────────────────────\n  ? for shortcuts · ← for agents\n' | classify)"
  case "$s" in IDLE*) :;; *) echo "smoke-test: FAIL (cc new idle footer → $s)"; exit 1;; esac
  # opencode idle prompt (MiMo/Zen UI: Ask anything... visible at bottom)
  s="$(printf '┃  Ask anything... "Fix a TODO in the codebase"\n┃\n┃  Build · MiMo V2.5 Free OpenCode Zen\n' | classify)"
  case "$s" in IDLE*) :;; *) echo "smoke-test: FAIL (opencode Ask-anything idle → $s)"; exit 1;; esac
  # opencode 1.16.x idle: input box empty, status bar shows "ctrl+p commands • OpenCode 1.16.2"
  s="$(printf '┃\n┃\n┃  Build · MiMo V2.5 Free OpenCode Zen                    ~/lte-workstation:main\n╹▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀\n                                52.1K (26%%)  ctrl+p commands    • OpenCode 1.16.2\n' | classify)"
  case "$s" in IDLE*) :;; *) echo "smoke-test: FAIL (opencode 1.16 ctrl+p idle → $s)"; exit 1;; esac
  # ORDERING SAFETY: a WORKING pane that ALSO shows the auto-mode footer must stay WORKING, not IDLE
  s="$(printf '✻ Booping… (38s · ↓ 1.8k tokens · esc to interrupt)\n  ⏵⏵ auto mode on (shift+tab to cycle) · esc to interrupt\n' | classify)"
  case "$s" in WORKING*) :;; *) echo "smoke-test: FAIL (working+footer must stay WORKING → $s)"; exit 1;; esac
  # ORDERING SAFETY: opencode 1.16 WORKING pane shows esc interrupt AND ctrl+p commands — must stay WORKING
  s="$(printf '■■■■■⬝⬝⬝  esc interrupt  101.4K (10%%) · $0.36  ctrl+p commands    • OpenCode 1.16.2\n' | classify)"
  case "$s" in WORKING*) :;; *) echo "smoke-test: FAIL (opencode working + ctrl+p footer must stay WORKING → $s)"; exit 1;; esac
  # ECHO-LOOP GUARD (chat-review/phaedra-chat-echo-loop): quoted pane text containing board markers /
  # a board-relay line / the '::' separator must be de-fanged before it's embedded in a [mind-blocked]
  # post, else another scraper re-parses the quote as a real event. FALSIFIABLE: drop sanitize_quote's
  # bracket sed and this FAILs (the [verify] survives).
  q="$(sanitize_quote '2026-06-17T10:00:00Z  who@node  ::  [verify] mesh-x: exit 1, fail
keep this  [mind-limited] quota banner')"
  case "$q" in
    *'[verify]'*|*'[mind-limited]'*) echo "smoke-test: FAIL (sanitize_quote left a live board marker: $q)"; exit 1;; esac
  case "$q" in *'::'*) echo "smoke-test: FAIL (sanitize_quote left the '::' board separator: $q)"; exit 1;; esac
  printf '%s' "$q" | grep -q '^[0-9]\{4\}-' && { echo "smoke-test: FAIL (sanitize_quote left a full board-relay line: $q)"; exit 1; }
  case "$q" in *'keep this'*) :;; *) echo "smoke-test: FAIL (sanitize_quote dropped real prompt content: $q)"; exit 1;; esac
  echo "smoke-test: ok"; exit 0
fi

peek_win() { # $1=window  $2=node(local|user@ip) — bottom pane (MIND), like mesh-tell
  local win="$1" node="$2" cmd
  cmd="pidx=\$(tmux list-panes -t \"\$(hostname):$win\" -F '#{pane_top} #{pane_index}' 2>/dev/null | sort -n | tail -1 | awk '{print \$2}'); tmux capture-pane -t \"\$(hostname):$win\${pidx:+.\$pidx}\" -p 2>/dev/null | grep -vE '^[[:space:]]*\$' | tail -25"
  if [ "$node" = local ]; then bash -c "$cmd"
  else ssh -o BatchMode=yes -o ConnectTimeout=8 "$node" "$cmd"; fi
}

# extract opencode usage metrics from pane text (bottom lines)
# output: model<TAB>tokens<TAB>pct<TAB>dollars  (one field per column, empty if not found)
extract_oc_metrics() {
  local txt="$1" tail15 model tokens pct dollars line
  tail15="$(printf '%s\n' "$txt" | tail -15)"
  # Model: from "Build · <Name> [OpenCode Go|OpenCode Zen|Nvidia|...]" line
  # Cut at the first "OpenCode", "Nvidia", " · ", " [", or wide spacing to isolate model name
  model="$(printf '%s\n' "$tail15" | grep -m1 'Build ·' \
    | sed 's/.*Build · *//; s/[[:space:]][[:space:]]\+.*//; s/  .*//; s/ \[.*//; s/ · [0-9].*//; s/ · low.*//; s/[[:space:]]*OpenCode.*//; s/[[:space:]]*Nvidia.*//; s/[[:space:]]*~\/.*//; s/[[:space:]]*\/~.*//' \
    | tr -d '[:space:]')"
  # Status bar line with tokens and %: "[esc interrupt] 87.1K (9%) [· $1.25] ctrl+p commands"
  line="$(printf '%s\n' "$tail15" | grep -m1 -E '[0-9]+\.[0-9]+K[[:space:]]+\([0-9]+%' | tr -d '[:space:]')"
  if [ -n "$line" ]; then
    tokens="$(printf '%s\n' "$line" | grep -oE '[0-9]+\.[0-9]+K' | head -1)"
    pct="$(printf '%s\n' "$line" | grep -oE '\([0-9]+%' | tr -d '()' | head -1)"
    # Dollars: present only for paid models (· $X.XX)
    dollars="$(printf '%s\n' "$line" | grep -oE '\$[0-9]+\.[0-9]+' | head -1 | tr -d '$')"
  fi
  printf '%s\t%s\t%s\t%s\n' "${model:-}" "${tokens:-}" "${pct:-}" "${dollars:-}"
}

# COOLDOWN: suppress repeated block/limited alerts for the same window
cooldown_file() { local win=$1 state=$2; echo "$MESH/.mind-state-cooldown-$win-$state"; }
cooldown_check() {
  local win=$1 state=$2 cooldown_sec=$3
  local cf=$(cooldown_file "$win" "$state") now=$(date +%s)
  if [ -f "$cf" ]; then
    local last=$(cat "$cf")
    if [ $((now - last)) -lt "$cooldown_sec" ]; then return 1; fi
  fi
  return 0
}
cooldown_set() { local win=$1 state=$2; local cf=$(cooldown_file "$win" "$state"); echo "$(date +%s)" > "$cf"; }
BLOCK_COOLDOWN="${MESH_BLOCK_COOLDOWN:-60}"
LIMITED_COOLDOWN="${MESH_LIMITED_COOLDOWN:-300}"

alert(){ if [ -n "${MESH_ALERT_DRYRUN:-}" ]; then echo "[dryrun] would alert: $1" >&2; return; fi
  local msg="$1"
  local win=$(echo "$msg" | sed -n 's/.*\[\([^]]*\)\].*/\1/p')
  if echo "$msg" | grep -q "\[mind-blocked\]"; then
    cooldown_check "$win" "NEEDS-INPUT" "$BLOCK_COOLDOWN" && { cooldown_set "$win" "NEEDS-INPUT"; MESH_WHO="mind-state@$(hostname)" mesh-chat "$msg" >/dev/null 2>&1; }
  elif echo "$msg" | grep -q "\[mind-limited\]"; then
    cooldown_check "$win" "RATE-LIMITED" "$LIMITED_COOLDOWN" && { cooldown_set "$win" "RATE-LIMITED"; MESH_WHO="mind-state@$(hostname)" mesh-chat "$msg" >/dev/null 2>&1; }
  elif echo "$msg" | grep -q "\[mind-unblocked\]"; then
    MESH_WHO="mind-state@$(hostname)" mesh-chat "$msg" >/dev/null 2>&1
  else
    MESH_WHO="mind-state@$(hostname)" mesh-chat "$msg" >/dev/null 2>&1
  fi
}

if [ "${1:-}" = --stats ]; then
  shift
  node=local; [ "${1:-}" = "--node" ] && { node="$2"; shift 2; }
  wins=("$@")
  [ ${#wins[@]} -gt 0 ] || mapfile -t wins < <(tmux list-windows -t "$(hostname)" -F '#{window_name}' 2>/dev/null | grep -vxE 'shell|reflex|sh|mon:.*')
  printf '%-10s\t%-12s\t%-12s\t%-7s\t%-5s\t%s\n' WINDOW STATE MODEL TOKENS PCT DOLLARS
  for w in "${wins[@]}"; do
    raw="$(peek_win "$w" "$node" 2>/dev/null || true)"
    [ -n "$raw" ] || { printf '%-10s\t%-12s\t%s\n' "$w" ABSENT; continue; }
    out="$(printf '%s\n' "$raw" | classify)"
    state="${out%%	*}"; ev="${out#*	}"
    IFS=$'\t' read -r model tokens pct dollars _ <<<"$(extract_oc_metrics "$raw")"
    [ -n "$dollars" ] && dollars="\$$dollars"
    printf '%-10s\t%-12s\t%-12s\t%-7s\t%-5s\t%s\n' "$w" "$state" "${model:-?}" "${tokens:-?}" "${pct:-?}" "${dollars:-}"
  done
  exit 0
fi

if [ "${1:-}" = --watch ]; then
  shift; wins=("$@")
  # AUTO-DISCOVER all mind-bearing windows (operator 2026-06-13: no hardcoded special list — a new
  # channel must appear in the wall automatically). A mind channel = any window EXCEPT pure infra
  # (shell=exec, reflex=loop-host, sh=stray). Everything else carries a mind in its bottom pane.
  [ ${#wins[@]} -gt 0 ] || mapfile -t wins < <(tmux list-windows -t "$(hostname)" -F '#{window_name}' 2>/dev/null | grep -vxE 'shell|reflex|sh|mon:.*')
   for w in "${wins[@]}"; do
    raw="$(peek_win "$w" local)"           # full pane text BEFORE classification
    out="$(printf '%s\n' "$raw" | classify)"
    state="${out%%	*}"; ev="${out#*	}"
    statef="$HOME/.mesh/.mind-state-$w"
    prev="$(cat "$statef" 2>/dev/null || echo NONE)"
    echo "$state" > "$statef"
    echo "$w: $state — $ev"
    if [ "$state" = NEEDS-INPUT ] && [ "$prev" != NEEDS-INPUT ]; then
      # Auto-peek + escalate: include the ACTUAL prompt lines so the operator can decide
      # without SSH-ing. The peer never presses the choice — it's read-only observation.
      prompt_lines="$(sanitize_quote "$(printf '%s\n' "$raw" | grep -vE '^[[:space:]]*$' | tail -8)")"
      alert "[mind-blocked] $(hostname):$w waiting on input — '$(sanitize_quote "$ev")' — Prompt: ${prompt_lines}"
      command -v mesh-tg >/dev/null 2>&1 && mesh-tg "🤖 $(hostname):$w ждёт ввода:
$prompt_lines
Ответь 'одобряю $w' (разрешу один раз) или 'отклони $w'. Не форсю — твоё решение." >/dev/null 2>&1 || true
    elif [ "$state" = RATE-LIMITED ] && [ "$prev" != RATE-LIMITED ]; then
      alert "[mind-limited] $(hostname):$w quota-exhausted — '$(sanitize_quote "$ev")' — route work elsewhere (mesh-relay/other minds)"
    elif [ "$state" != NEEDS-INPUT ] && [ "$state" != RATE-LIMITED ] && { [ "$prev" = NEEDS-INPUT ] || [ "$prev" = RATE-LIMITED ]; }; then
      alert "[mind-unblocked] $(hostname):$w now $state"
    fi
  done
  exit 0
fi

node=local
win="${1:?usage: mesh-mind-state <window> [--node user@ip] | --watch | --test}"; shift || true
[ "${1:-}" = "--node" ] && { node="$2"; shift 2; }
out="$(peek_win "$win" "$node" | classify)"
state="${out%%	*}"
# Distinguish absent window from truly dead mind: an absent local window returns ABSENT/exit-7,
# not DEAD/exit-5 — callers (mesh-supervise, mesh-borrowed-brain) must not treat a missing
# channel as a mind outage (the channel simply wasn't built yet, e.g. pre-mesh-restore).
if [ "$state" = DEAD ] && [ "$node" = local ]; then
  tmux list-windows -t "$(hostname)" -F '#{window_name}' 2>/dev/null | grep -qx "$win" \
    || { printf 'ABSENT\tno such window: %s\n' "$win"; exit 7; }
fi
printf '%s\n' "$out"
case "$state" in NEEDS-INPUT) exit 4;; DEAD) exit 5;; RATE-LIMITED) exit 6;; *) exit 0;; esac
