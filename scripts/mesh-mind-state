  _unk_frame="$(printf 'some totally unrecognized pane content\nrandom garbage line 2\nnothing matches here\n')"
  watch_tick tugly "$_wedged_frame" >/dev/null 2>/dev/null                       # tick 1: first sighting
  watch_tick tugly "$_wedged_frame" >/dev/null 2>/dev/null                       # tick 2: transition frame, no alert yet
  _u3="$(watch_tick tugly "$_wedged_frame" 2>&1 >/dev/null)"                     # tick 3: settled WEDGED-INPUT → alert
  case "$_u3" in *'[mind-wedged]'*) :;; *) _loopfail "healthy-gate fixture: wedge tick never alerted: $_u3";; esac
  _u4="$(watch_tick tugly "$_unk_frame" 2>&1 >/dev/null)"                        # tick 4: flip to UNKNOWN — silent (flip frame)
  case "$_u4" in *'[mind-unblocked]'*) _loopfail "healthy-gate fixture: [mind-unblocked] fired on the flip frame: $_u4";; esac
  _u5="$(watch_tick tugly "$_unk_frame" 2>&1 >/dev/null)"                        # tick 5: settled UNKNOWN, non-transition
  case "$_u5" in *'[mind-unblocked]'*) _loopfail "wedged→UNKNOWN must NOT post [mind-unblocked] (loss of observation, not recovery): $_u5";; esac
  [ "$(cat "$(mind_seen_file tugly)" 2>/dev/null)" = UNKNOWN ] \
    || _loopfail "seenf must still advance to UNKNOWN even though the board claim is suppressed"
  rm -rf "$MESH"; MESH="$_wmesh3"; MIND_DEBOUNCE_SEC="$_dbo"; unset MESH_ALERT_DRYRUN

  # ── wedge-recover-narrow-autofire (chat-review 2026-07-07) ───────────────────────────────────────
  # 25/220 board lines (~11%) this session were the WEDGED-INPUT wedge on a short, mesh-INJECTED
  # slash-command ('/clear', '/model default|sonnet|haiku') — never operator prose. Those now
  # auto-fire the C-u+resend recovery by DEFAULT (no MESH_WEDGE_RECOVER flag); arbitrary/operator
  # text still requires the flag (the truncation-risk case is real there, unchanged behavior).
  # Stub tmux/mesh-tell hermetically (same convention as the mesh-chat/mesh-trace stubs above) so
  # this never touches a real pane. Falsify: drop the /clear|/model case match and both assertions
  # below fail (the /clear case stops auto-firing; equivalently, removing the else-branch gate
  # would make the operator-text case wrongly auto-fire too).
  _wa_wmesh="$MESH"; MESH="$(mktemp -d)"
  _dbo2="$MIND_DEBOUNCE_SEC"; MIND_DEBOUNCE_SEC=0
  export MESH_ALERT_DRYRUN=1
  # watch_tick calls happen inside $(...) command substitution below (to also capture the alert
  # text), which forks a subshell — a stub writing to a plain var wouldn't survive back to this
  # scope, so the stubs append to FILES instead.
  _wa_sendf="$(mktemp)"; _wa_tellf="$(mktemp)"
  tmux(){ case "$1" in list-panes) echo "0 0";; send-keys) printf '%s\n' "$*" >> "$_wa_sendf";; esac; }
