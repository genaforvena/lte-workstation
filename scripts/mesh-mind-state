  case "$_mu_board" in *'[mind-unblocked]'*) :;; *) unset -f mesh-chat mesh-trace; MESH="$_mu_wmesh"; echo "smoke-test: FAIL (paired recovery must reach the board, got board='$_mu_board' trace='$_mu_trace')"; exit 1;; esac
  [ ! -f "$(announced_file muwin)" ] || { unset -f mesh-chat mesh-trace; MESH="$_mu_wmesh"; echo "smoke-test: FAIL (announced mark must be consumed after a paired recovery)"; exit 1; }
  unset -f mesh-chat mesh-trace; rm -rf "$MESH"; MESH="$_mu_wmesh"

  # ── DEAD-SHELL (chat-review/shed-pane-dead-shell-misclassified 2026-07-07) ───────────────────────
  # REAL bash-pane fixture: a private tmux socket + a genuinely spawned `bash` process (not a mocked
  # string) — ps -t <tty> truly queries it, proving pane_is_bare_shell works against actual process
  # reality, per the task's own ask ("test with a real bash pane fixture"). Isolated socket, killed at
  # the end — never touches this node's shared hostname session (same pattern mesh-tell's ack_probe
  # fixture already uses).
  _dsl="mindstateshell$$"
  tmux -L "$_dsl" new-session -d -s t -x 80 -y 10 'exec bash --norc --noprofile' 2>/dev/null; _fx_track "$_dsl"
  sleep 0.3
  _dstty="$(tmux -L "$_dsl" display-message -p -t t:0.0 '#{pane_tty}' 2>/dev/null)"
  if [ -n "$_dstty" ]; then
    export MESH_MIND_STATE_COMMS_CMD="ps -t '$_dstty' -o comm= 2>/dev/null"
    pane_is_bare_shell fakewin local \
      || { tmux -L "$_dsl" kill-server 2>/dev/null; unset MESH_MIND_STATE_COMMS_CMD; echo "smoke-test: FAIL (real bash-only pane must classify as bare-shell)"; exit 1; }
    # full integration: classify_win must override to DEAD-SHELL for this real fixture even when the
    # pane TEXT looks exactly like a live idle mind (frozen footer/prompt glyph) — the whole point.
    s="$(classify_win fakewin local "$(printf 'some stale frozen mind footer\n❯ \n  ⏵⏵ auto mode on · ← for agents\n')")"
    case "$s" in DEAD-SHELL*) :;; *) tmux -L "$_dsl" kill-server 2>/dev/null; unset MESH_MIND_STATE_COMMS_CMD; echo "smoke-test: FAIL (classify_win on a real bash-only pane should override to DEAD-SHELL, got: $s)"; exit 1;; esac
    unset MESH_MIND_STATE_COMMS_CMD
  else
    echo "smoke-test: SKIP (could not resolve fixture pane tty — private tmux socket issue, not this feature)"
  fi
  tmux -L "$_dsl" kill-server 2>/dev/null
  # ── SHED-RATE-LIMITED (chat-review/shed-pane-dead-shell-misclassified, classifier half) ─────────
  # A bare-shell pane with channel-keepalive's SHED banner in it must classify RATE-LIMITED, NOT
  # DEAD-SHELL — the engine was killed by the shed (rate-limit wall), not by a crash/exit, and the
  # banner is the visible signal keepalive writes for exactly this reader. Hermetic mock: the engine
  # comm list is empty (bare shell) but the pane text carries the literal '--- SHED until HH:MMZ ---'
  # line channel-keepalive:597 emits. RED-FIRST: drop the banner-grep in classify_win and the first
  # assert fails (RATE-LIMITED collapses back to DEAD-SHELL); drop the DEAD-SHELL fallback and the
  # second assert fails (a bare shell with NO banner no longer reads DEAD-SHELL). Banner literal is
  # tight enough that agent prose cannot match it.
  export MESH_MIND_STATE_COMMS_CMD="printf 'bash\n'"   # bare shell — engine killed by the shed
  _shed_pane="$(printf '❯ \n--- SHED until 14:32Z (rate-limit wall, shed #3) ---\n  ⏵⏵ auto mode on · ← for agents\n')"
  s="$(classify_win fakewin local "$_shed_pane")"
  case "$s" in RATE-LIMITED*) :;; *) unset MESH_MIND_STATE_COMMS_CMD; echo "smoke-test: FAIL (bare-shell pane WITH SHED banner must read RATE-LIMITED, not DEAD-SHELL — got: $s)"; exit 1;; esac
  # NEGATIVE direction (same bare shell, NO banner): a genuinely-killed/crashed mind still reads
  # DEAD-SHELL — the banner-grep is a SHED-to-RATE-LIMITED upgrade only, never a free pass to RL.
  s="$(classify_win fakewin local "$(printf 'some stale frozen mind footer\n❯ \n  ⏵⏵ auto mode on · ← for agents\n')")"
  case "$s" in DEAD-SHELL*) :;; *) unset MESH_MIND_STATE_COMMS_CMD; echo "smoke-test: FAIL (bare-shell pane with NO SHED banner must still read DEAD-SHELL — got: $s)"; exit 1;; esac
  # banner-shape gate: a NEAR-miss banner (missing the trailing ' ---', say) must NOT match — the
  # tight literal is the only thing keeping agent prose out. A loose `grep -F 'SHED until'` here
  # would falsely read a mind DISCUSSING its shed as RATE-LIMITED.
  s="$(classify_win fakewin local "$(printf '❯ \n--- SHED until 14:32Z (rate-limit wall, shed #3) — typo, no closing dash-dash\n')")"
  case "$s" in DEAD-SHELL*) :;; *) unset MESH_MIND_STATE_COMMS_CMD; echo "smoke-test: FAIL (a near-miss banner must NOT match — tight literal is the anti-false-positive gate, got: $s)"; exit 1;; esac
  unset MESH_MIND_STATE_COMMS_CMD
  # NEGATIVE control (hermetic mock — the real-process case above already proves the bare-shell path;
  # this proves a mind engine's presence is NOT swallowed, i.e. the check isn't an always-true stub):
  export MESH_MIND_STATE_COMMS_CMD="printf 'bash\nclaude\n'"
  pane_is_bare_shell fakewin local \
    && { unset MESH_MIND_STATE_COMMS_CMD; echo "smoke-test: FAIL (a pane with a live claude comm must NOT classify as bare-shell)"; exit 1; }
  s="$(classify_win fakewin local "$(printf 'some output\n❯ \n  ⏵⏵ auto mode on · ← for agents\n')")"
  case "$s" in DEAD-SHELL*) echo "smoke-test: FAIL (classify_win must not override a pane with a live mind engine: $s)"; exit 1;; esac
  case "$s" in IDLE*) :;; *) echo "smoke-test: FAIL (with a live engine present, text classification should proceed normally → $s)"; exit 1;; esac
  unset MESH_MIND_STATE_COMMS_CMD
  # fail-open: an UNREADABLE probe (empty comm list) must NEVER fabricate DEAD-SHELL — the text
  # classifier still applies (falsify: drop the `[ -n "$comms" ]` guard and this trips).
  export MESH_MIND_STATE_COMMS_CMD="true"   # prints nothing
  pane_is_bare_shell fakewin local \
    && { unset MESH_MIND_STATE_COMMS_CMD; echo "smoke-test: FAIL (an unreadable probe must fail-open, not claim bare-shell)"; exit 1; }
  unset MESH_MIND_STATE_COMMS_CMD
  # The table above asserts state_rc's numbers. It cannot show the CLI still ROUTES through it —
  # and the obvious anchor is a trap: an absent window exits 7 from its own guard well ABOVE the
  # mapping, so `$0 zzz-absent` stays green even if the last line is replaced by `exit 0`. (Measured:
  # that was this gate's first cut and the mutant survived it.) Drive the REAL CLI on a window that
  # EXISTS, with the pane read supplied by the fixture seam, and require the non-zero code to come
  # out the far end. Needs a live tmux — where there is none the CLI path is genuinely unobservable,
  # so say so rather than pass quietly.
  _rw="$(tmux list-windows -t "$(hostname)" -F '#{window_name}' 2>/dev/null | head -1)"
  if [ -n "$_rw" ]; then
    _arc=0
    MESH_MIND_STATE_PEEK_CMD="printf 'deploy-heal...\n⎿ Not logged in · Please run /login\n⏸ ? for shortcuts · ← for agents\n'" \
    MESH_MIND_STATE_COMMS_CMD='printf "claude\n"' \
      "$0" "$_rw" >/dev/null 2>&1 || _arc=$?
    [ "$_arc" = 9 ] || { echo "smoke-test: FAIL (real CLI on a logged-out pane exited $_arc, want 9 — the state→rc mapping is not on the CLI's path)"; exit 1; }
  else
    echo "  note: no live tmux — CLI end-to-end exit-code path not observable here (state_rc table still asserted)"
  fi
  # ABSENT vs DEAD-SHELL (chat-review/mindstate-absent-vs-deadshell-tmux-fallback): a GENUINELY absent
  # window must return ABSENT/exit-7, not DEAD-SHELL/exit-8. Was broken because tmux display-message
  # silently falls back to the active pane's real tty for a nonexistent window (list-panes correctly
  # errors) → ps found a real shell → DEAD-SHELL for any absent window, never reaching the exit-7 guard.
  # Drive the real CLI path on a window name guaranteed absent from any tmux session. (Falsify: revert
  # either the pane_comms pidx-gate or the widened exit-7 guard → this returns 8.)
  "$0" "zzz-bogus-nonexistent-$$" >/dev/null 2>&1; _abrc=$?
  [ "$_abrc" -eq 7 ] || { echo "smoke-test: FAIL (absent window must be ABSENT/exit-7, got exit $_abrc — display-message tty-fallback misclassifies it as DEAD-SHELL)"; exit 1; }
  # PREFIX GATE (chat-review/mindstate-prefix-answers-for-another-window): the zzz-bogus assert above
  # only ever drives a name matching NOTHING — the case that always worked. tmux target matching is
  # prefix/fnmatch, so the case that BROKE is a phantom name that prefixes a LIVE window: it read that
  # window's pane and returned its state, rc=0, under the asked-for name. Drive the REAL path against
  # the REAL session: derive a strict prefix of a live window that is not itself a window name, and
  # assert it reads ABSENT/exit-7 — never the neighbour's state. Falsify: delete the exact-name gate
  # above peek_win and this returns 0 + the neighbour's classification.
  # Honest n/a (exit 2, mesh-land counts it a pass) where there is no session/window to derive from —
  # never a fake green.
  # The donor window MUST classify LIVE (rc 0 = IDLE/WORKING), not a bare shell: a DEAD-SHELL donor
  # (the `bash` window) makes this assert VACUOUS — its phantom prefix classifies DEAD-SHELL and so
  # reaches the OLD exit-7 guard, returning ABSENT for the wrong reason and passing against the bug.
  # (Observed: with the fix reverted, a `bas`/`bash` donor still printed ok.) Only a LIVE donor never
  # reaches that guard, which is precisely where the prefix bug lives.
  _live=""; _pfx=""
  mapfile -t _wins < <(tmux list-windows -t "$(hostname)" -F '#{window_name}' 2>/dev/null)
  for _w in "${_wins[@]}"; do
    [ "${#_w}" -ge 3 ] || continue
    _cand="${_w:0:$(( ${#_w} - 1 ))}"                       # strict prefix: drop the last char
    printf '%s\n' "${_wins[@]}" | grep -qx "$_cand" && continue   # must not itself be a real window
    "$0" "$_w" >/dev/null 2>&1; [ $? -eq 0 ] || continue          # donor must be a LIVE mind window
    _live="$_w"; _pfx="$_cand"; break
  done
  if [ -z "$_pfx" ]; then
    echo "smoke-test: n/a (no LIVE mind window to derive a strict prefix from — prefix gate needs a live session)"; exit 2
  fi
  # control: the FULL name must still classify LIVE (rc 0, never 7) — proves the gate rejects only the
  # phantom, and did not just break every read.
  "$0" "$_live" >/dev/null 2>&1; _fullrc=$?
  [ "$_fullrc" -eq 0 ] || { echo "smoke-test: FAIL (exact-name gate broke the REAL live window '$_live' — got exit $_fullrc)"; exit 1; }
  _pfxout="$("$0" "$_pfx" 2>&1)"; _pfxrc=$?
  [ "$_pfxrc" -eq 7 ] || { echo "smoke-test: FAIL (phantom '$_pfx' prefixes live window '$_live' — must be ABSENT/exit-7, got exit $_pfxrc: '$_pfxout' — tmux prefix-matching answered for another window)"; exit 1; }
  printf '%s' "$_pfxout" | grep -q '^ABSENT' || { echo "smoke-test: FAIL (phantom '$_pfx' must print ABSENT, got '$_pfxout')"; exit 1; }
  echo "smoke-test: ok (DEAD-SHELL: real bash-pane fixture classifies bare-shell + classify_win overrides a mind-like frozen frame; live-engine mock stays untouched; unreadable probe fails open; CLI exit code wired; absent window → ABSENT/exit-7 not DEAD-SHELL; phantom prefix '$_pfx' of live '$_live' → ABSENT/exit-7, real name still classifies)"

  # CARD GATE (chat-review/mindstate-card-gate 2026-07-06): --watch must never read/alert on a
  # HANDS-OFF node's panes. Falsify: remove the `card_gates_minds && exit 0` line from --watch (or
  # blank card_gates_minds's body) and these trip.
  _cf="$(mktemp)"
  printf 'minds: \n' > "$_cf"    # blanked line present, no known engine — HANDS-OFF (phaedra's live shape)
  card_gates_minds "$_cf" || { echo "smoke-test: FAIL (blank 'minds:' line should gate — card_gates_minds returned false)"; rm -f "$_cf"; exit 1; }
  printf 'minds: claude\n' > "$_cf"
  card_gates_minds "$_cf" && { echo "smoke-test: FAIL ('minds: claude' should NOT gate — card_gates_minds returned true)"; rm -f "$_cf"; exit 1; }
  printf 'role: sense\n' > "$_cf"   # no minds: line at all — not gated (mirrors mesh-mind-keepalive's own behavior)
  card_gates_minds "$_cf" && { echo "smoke-test: FAIL (card with no 'minds:' line at all should NOT gate)"; rm -f "$_cf"; exit 1; }
  rm -f "$_cf"
  card_gates_minds /no/such/card-file && { echo "smoke-test: FAIL (missing card file should NOT gate)"; exit 1; }
  # (the old `grep card_gates_minds && exit 0` self-grep was vacuous — 1969a5d class; the e2e
  # below IS the gate for the same invariant, asserting the artifact instead of the source text)
  # end-to-end: a real --watch invocation under a HANDS-OFF card must exit 0 with ZERO output — proving
  # the gate fires before AUTO-DISCOVER/tmux/board calls (safe to actually run: it must exit before
  # touching this node's real tmux session, so this can't leak a false alert about live windows).
  _sandbox="$(mktemp -d)"; mkdir -p "$_sandbox/.mesh"; printf 'minds: \n' > "$_sandbox/.mesh-card"
  _wout="$(HOME="$_sandbox" "$0" --watch 2>&1)"; _wrc=$?
  rm -rf "$_sandbox"
  [ "$_wrc" -eq 0 ] && [ -z "$_wout" ] || { echo "smoke-test: FAIL (--watch under a HANDS-OFF card should exit 0 silently — got rc=$_wrc out='$_wout')"; exit 1; }

  # ── REASONING-LOOP READ (--loop): extractor, the WORKING sampling gate, and the two verdict floors ──
  # The knobs are folded into LOOP_* at LOAD time, so a `MESH_MIND_LOOP_x=… fn` prefix would NOT rebind
  # them here (the export-does-not-rebind-a-load-time-global trap this codebase has been bitten by);
  # the test sets the LOOP_* globals directly and restores them.
  _lhome="$(mktemp -d)"; mkdir -p "$_lhome/.mesh"
  _l_MESH="$MESH"; MESH="$_lhome/.mesh"
  _l_min="$LOOP_MIN_TICKS" _l_rep="$LOOP_MIN_REPEATS" _l_span="$LOOP_MIN_SPAN_S" _l_win="$LOOP_WIN_S"
  _nb=$'\xc2\xa0'   # the NBSP the live render puts between ⎿ and the `$` — the real dialect, not a guess
  _fx_tool="● Read(scripts/a.sh)
  ⎿  Read 30 lines
● Web Search(\"pask entailment\")
  ⎿  · Did 1 search in 8s"
  _fx_bash="● Probing the ring
  ⎿${_nb} \$ mesh-mind-state --loop genome"
  _fx_prose="● The CV is read, and the correction is landed.

● Reading the file (again) and moving on.

● One more sentence with no continuation line."
  # 1. tool call with argument → confirmed, COMPLETED, argument part of the identity
  _o="$(printf '%s\n' "$_fx_tool" | loop_actions)"
  printf '%s' "$_o" | grep -qx "C	Read(scripts/a.sh)" || { echo "smoke-test: FAIL (--loop extractor missed a tool call: '$_o')"; rm -rf "$_lhome"; exit 1; }
  printf '%s' "$_o" | grep -qx 'C	Web Search("pask entailment")' || { echo "smoke-test: FAIL (--loop extractor missed a two-word tool name: '$_o')"; rm -rf "$_lhome"; exit 1; }
  # 2. a Bash call: identity is the DESCRIPTION, state R, and the NBSP separator of the LIVE render must parse
  _o="$(printf '%s\n' "$_fx_bash" | loop_actions)"
  [ "$_o" = "R	Bash:Probing the ring" ] || { echo "smoke-test: FAIL (--loop extractor on the live NBSP \`⎿ \$ cmd\` dialect: got '$_o')"; rm -rf "$_lhome"; exit 1; }
  # 3. PROSE is bulleted identically and must yield NOTHING — including a sentence carrying parentheses,
  #    which a loose `.*(` gate would have counted as a tool call and turned narration into a loop.
  _o="$(printf '%s\n' "$_fx_prose" | loop_actions)"
  [ -z "$_o" ] || { echo "smoke-test: FAIL (--loop extractor counted assistant prose as actions: '$_o')"; rm -rf "$_lhome"; exit 1; }
  # 4. the WORKING gate: an IDLE frame records nothing (an idle pane's action set is unchanging too, and
  #    without this gate every resting mind in the fleet would read STATIC)
  loop_sample lt "$_fx_tool" IDLE; [ ! -s "$(loop_ring_file lt)" ] || { echo "smoke-test: FAIL (--loop sampled a non-WORKING frame)"; rm -rf "$_lhome"; exit 1; }
  loop_sample lt "$_fx_tool" WORKING
  [ "$(wc -l < "$(loop_ring_file lt)")" = 1 ] || { echo "smoke-test: FAIL (--loop did not record a WORKING sample)"; rm -rf "$_lhome"; exit 1; }
  loop_sample lt "$_fx_prose" WORKING   # no actions in the frame → nothing to record
  [ "$(wc -l < "$(loop_ring_file lt)")" = 1 ] || { echo "smoke-test: FAIL (--loop recorded an action-less frame)"; rm -rf "$_lhome"; exit 1; }
  # 5. n/a floor: too few samples is NOT a verdict
  LOOP_MIN_TICKS=6 LOOP_MIN_REPEATS=4 LOOP_MIN_SPAN_S=900 LOOP_WIN_S=3600
  case "$(loop_report lt)" in n/a*) : ;; *) echo "smoke-test: FAIL (--loop gave a verdict on 1 sample: '$(loop_report lt)')"; rm -rf "$_lhome"; exit 1 ;; esac
  # 6. STATIC: 6 consecutive identical action-set digests, 600s apart (the real --watch cadence)
  _now=$(date +%s); : > "$(loop_ring_file ls)"
  for _i in 5 4 3 2 1 0; do printf '%s\t111\tRead(scripts/a.sh)\n' "$((_now - _i*600))" >> "$(loop_ring_file ls)"; done
  case "$(loop_report ls)" in STATIC*streak=6*) : ;; *) echo "smoke-test: FAIL (--loop missed a 6-tick/50-min static streak: '$(loop_report ls)')"; rm -rf "$_lhome"; exit 1 ;; esac
  # 6b. STATIC MUST NOT NAME A CAUSE (task mindstate-loop-is-the-only-freeze-detector-and-is-unwired,
  #     2026-08-21). A cgroup-frozen pane and a genuine reasoning loop are ONE BIT APART from here and
  #     their remedies are opposite (thaw/kill-9 vs interrupt/re-prompt), so the line must carry the
  #     disjunction and point at the read that separates it. Asserted on the OUTPUT, not on a comment:
  #     a cause in prose is a claim nobody's consumer ever sees.
  case "$(loop_report ls)" in *"cause=UNSEPARATED"*) : ;; *) echo "smoke-test: FAIL (a STATIC verdict shipped without its cause disjunction — a consumer reads STATIC as 'reasoning loop' and re-prompts a STOPPED process: '$(loop_report ls)')"; rm -rf "$_lhome"; exit 1 ;; esac
  case "$(loop_report ls)" in *frozen-or-stopped-process*) : ;; *) echo "smoke-test: FAIL (STATIC's cause list omits the frozen/stopped case — the one this node measured live: '$(loop_report ls)')"; rm -rf "$_lhome"; exit 1 ;; esac
  case "$(loop_report ls)" in *cgroup.events*) : ;; *) echo "smoke-test: FAIL (STATIC names alternatives but not the read that separates them — an unactionable disjunction: '$(loop_report ls)')"; rm -rf "$_lhome"; exit 1 ;; esac
  # …and the neutral verdict must stay clean: a cause clause on TURNING-OVER would be noise.
  : > "$(loop_ring_file lc)"; _nowc=$(date +%s)
  for _i in 5 4 3 2 1 0; do printf '%s\t%s\tRead(scripts/a.sh)\n' "$((_nowc - _i*600))" "$(( 200 + _i ))" >> "$(loop_ring_file lc)"; done
  case "$(loop_report lc)" in *cause=*) echo "smoke-test: FAIL (TURNING-OVER carries a cause clause: '$(loop_report lc)')"; rm -rf "$_lhome"; exit 1 ;; esac
  # 7. TURNING-OVER: same 6 ticks, but the set changes every other tick → the CONSECUTIVE streak breaks
  : > "$(loop_ring_file lv)"
  for _i in 5 4 3 2 1 0; do printf '%s\t%s\tRead(scripts/a.sh)\n' "$((_now - _i*600))" "$(( 111 + _i % 2 ))" >> "$(loop_ring_file lv)"; done
  case "$(loop_report lv)" in TURNING-OVER*) : ;; *) echo "smoke-test: FAIL (--loop called an alternating set STATIC: '$(loop_report lv)')"; rm -rf "$_lhome"; exit 1 ;; esac
  # 8. THE SPAN FLOOR: the SAME 6 identical digests sampled 2s apart are a fast sampler, not a stuck mind
  #    (measured live: a 2s hand-run sampler hit streak=4 in 6 seconds on a perfectly busy pane)
  : > "$(loop_ring_file lf)"
  for _i in 5 4 3 2 1 0; do printf '%s\t111\tRead(scripts/a.sh)\n' "$((_now - _i*2))" >> "$(loop_ring_file lf)"; done
  case "$(loop_report lf)" in TURNING-OVER*) : ;; *) echo "smoke-test: FAIL (--loop called a 10-second streak STATIC — span floor not enforced: '$(loop_report lf)')"; rm -rf "$_lhome"; exit 1 ;; esac
  LOOP_MIN_TICKS="$_l_min"; LOOP_MIN_REPEATS="$_l_rep"; LOOP_MIN_SPAN_S="$_l_span"; LOOP_WIN_S="$_l_win"; MESH="$_l_MESH"
  rm -rf "$_lhome"

  echo "smoke-test: ok (+ WEDGED-INPUT: 2-tick same-text wedge, 1-tick/changed/empty/ghost/WORKING-reset all stay IDLE, edge alert-due + dedupe + recovery plumbing + loop-level [mind-wedged]→[mind-unblocked] round trip, + card-gated --watch: HANDS-OFF card exits 0 silently before any tmux/board call, engine-declared card runs, + mindunblocked-cooldown-asymmetry: suppressed entry leaves no mark + un-paired recovery routes to trace / fresh entry marks + paired recovery board-posts and consumes the mark, + mindstate-unblocked-healthy-gate: wedged→UNKNOWN advances seenf silently (no false all-clear), wedged→IDLE still alerts, + --loop action-turnover read: tool/two-word/NBSP-\$-dialect extraction, prose-with-parens yields nothing, WORKING-only sampling, n/a floor, STATIC at 6 ticks x 50min, alternating sets and a 10-second streak both TURNING-OVER, and STATIC ships its cause DISJUNCTION + the separating read while TURNING-OVER stays cause-free)"; exit 0
fi

if [ "${1:-}" = --loop ]; then
  # REPORT-ONLY (see the block at ~:520): prints a repeat-concentration read per mind window and does
  # not post, alert, shed, or feed any state. Exit 2 = honest n/a (nothing readable anywhere), the
  # code mesh-land counts as a pass.
  shift
  node=local; [ "${1:-}" = "--node" ] && { node="$2"; shift 2; }
  wins=("$@")
  [ ${#wins[@]} -gt 0 ] || mapfile -t wins < <(tmux list-windows -t "$(hostname)" -F '#{window_name}' 2>/dev/null | grep -vxE 'shell|reflex|sh|mon:.*')
  [ ${#wins[@]} -gt 0 ] || { echo "loop: n/a (no mind windows on this node)"; exit 2; }
  read_any=0
  for w in "${wins[@]}"; do
    key="$w"; [ "$node" = local ] || key="$node@$w"
    raw="$(peek_win_deep "$w" "$node" 2>/dev/null || true)"
    if [ -z "$raw" ]; then printf '%-10s\tn/a\t%s\n' "$w" "pane unreadable"; continue; fi
    # classify FIRST: the sampler only records WORKING ticks (see loop_sample), so the CLI path must
    # supply the same state the --watch path does, or a hand-run --loop would poison the ring with
    # idle frames the reflex would never have recorded.
    st="$(classify_win "$w" "$node" "$raw")"; st="${st%%	*}"
    loop_sample "$key" "$raw" "$st"
    line="$(loop_report "$key")"
    case "$line" in n/a*) : ;; *) read_any=1 ;; esac
    printf '%-10s\t%s\n' "$w" "$line"
  done
  [ "$read_any" = 1 ] || exit 2
  exit 0
fi

if [ "${1:-}" = --stats ]; then
  shift
  node=local; [ "${1:-}" = "--node" ] && { node="$2"; shift 2; }
  wins=("$@")
  [ ${#wins[@]} -gt 0 ] || mapfile -t wins < <(tmux list-windows -t "$(hostname)" -F '#{window_name}' 2>/dev/null | grep -vxE 'shell|reflex|sh|mon:.*')
  printf '%-10s\t%-12s\t%-12s\t%-7s\t%-5s\t%s\n' WINDOW STATE MODEL TOKENS PCT DOLLARS
  for w in "${wins[@]}"; do
    raw="$(peek_win "$w" "$node" 2>/dev/null || true)"
    [ -n "$raw" ] || { printf '%-10s\t%-12s\t%s\n' "$w" ABSENT; continue; }
    out="$(classify_win "$w" "$node" "$raw")"
    state="${out%%	*}"; ev="${out#*	}"
    split_tabs "$(extract_metrics "$raw")" model tokens pct dollars
    [ -n "$dollars" ] && dollars="\$$dollars"
    printf '%-10s\t%-12s\t%-12s\t%-7s\t%-5s\t%s\n' "$w" "$state" "${model:-?}" "${tokens:-?}" "${pct:-?}" "${dollars:-}"
  done
  exit 0
fi

if [ "${1:-}" = --watch ]; then
  shift; wins=("$@")
  # CARD-GATED (chat-review/mindstate-card-gate 2026-07-06): a HANDS-OFF node's panes must never even
  # be READ, let alone alerted on. Live false-positive: phaedra (minds-off card since 2026-06-25) still
  # had --watch read its panes and post [mind-unblocked] phaedra:chat 18:20:21Z. Single-window direct
  # invocation (below, no --watch) stays UNGATED — that path is a diagnostic query ("what is THIS
  # window doing right now"), not an autonomous alerting reflex. Exits BEFORE any tmux/board call.
  card_gates_minds && exit 0
  # AUTO-DISCOVER all mind-bearing windows (operator 2026-06-13: no hardcoded special list — a new
  # channel must appear in the wall automatically). A mind channel = any window EXCEPT pure infra
  # (shell=exec, reflex=loop-host, sh=stray). Everything else carries a mind in its bottom pane.
  [ ${#wins[@]} -gt 0 ] || mapfile -t wins < <(tmux list-windows -t "$(hostname)" -F '#{window_name}' 2>/dev/null | grep -vxE 'shell|reflex|sh|mon:.*')
  for w in "${wins[@]}"; do
    watch_tick "$w" "$(peek_win "$w" local)" local
  done
  exit 0
fi

node=local
win="${1:?usage: mesh-mind-state <window> [--node user@ip] | --watch | --loop | --stats | --test}"; shift || true
[ "${1:-}" = "--node" ] && { node="$2"; shift 2; }
# EXACT-NAME GATE (chat-review/mindstate-prefix-answers-for-another-window): every tmux read below
# (`-t "$(hostname):$win"`) resolves $win through tmux TARGET matching, which prefix/fnmatch-matches —
# so `gen` reads the `genome` pane and reports genome's state under the name `gen`, rc=0. The old
# exit-7 guard (~:1101) is exact-match but sits BELOW the read and only fires when state is
# DEAD/DEAD-SHELL — a phantom name that prefixes a LIVE window never gets there, so ABSENT could only
# ever fire for a name matching NOTHING (which is all its `zzz-bogus` test ever drove). Decide absence
# from the NAME, before any read: a window is the one whose name matches exactly, or it is absent.
# Live blast radius: mesh-dispatch's own default pool is "dev discover sense" and there is no `sense`
# window (the set has `senses`) — it read senses' state under the name `sense`; and
# mesh-mind-control:503 leans on ABSENT to catch an `owner:` mis-tag, which silently dispatched to
# whatever window the mis-tag happened to prefix. REMOTE (--node) still resolves via tmux matching:
# the guard is local-only, matching the existing exit-7 scope, since checking costs a second ssh.
if [ "$node" = local ]; then
  tmux list-windows -t "$(hostname)" -F '#{window_name}' 2>/dev/null | grep -qx "$win" \
    || { printf 'ABSENT\tno such window: %s\n' "$win"; exit 7; }
fi
_raw="$(peek_win "$win" "$node")"
out="$(classify_win "$win" "$node" "$_raw")"
state="${out%%	*}"
# WEDGED-INPUT overlay (chat-review/dispatch-picker-blind-to-wedge): this single-window CLI path is what
# mesh-mind-control's state_of()/_pick_agentic reads. Without this call it reports a pane stuck on an
# un-submitted input line (the '/clear' harness-eats-Enter bug) as plain IDLE, so dispatch keeps ranking
# the wedged window top-tier idle_claude and re-targeting it every tick. Mirror watch_tick's own
# wedge_state call (:480), sharing the SAME $MESH/.mind-input-$win memory so the CLI path and the --watch
# loop agree instead of diverging. Two consecutive single-window invocations with the same stuck ❯-line →
# 2nd prints WEDGED-INPUT (each CLI call is one tick; the memory file persists between them).
_wstate="$(wedge_state "$win" "$state" "$_raw")"
if [ "$_wstate" != "$state" ]; then
  out="$_wstate	input stuck (never submitted): $(input_stuck_text "$_raw")"
  state="$_wstate"
fi
# Distinguish absent window from truly dead mind: an absent local window returns ABSENT/exit-7,
# not DEAD/exit-5 — callers (mesh-supervise, mesh-borrowed-brain) must not treat a missing
# channel as a mind outage (the channel simply wasn't built yet, e.g. pre-mesh-restore).
if { [ "$state" = DEAD ] || [ "$state" = DEAD-SHELL ]; } && [ "$node" = local ]; then
  # DEAD-SHELL included as defense-in-depth: a genuinely shed pane lives on a REAL window (grep matches
  # → stays DEAD-SHELL), so only a truly ABSENT window falls through here — even if some future tmux
  # tty-fallback quirk resurfaces the misclassification the pane_comms pidx-gate above now prevents.
  tmux list-windows -t "$(hostname)" -F '#{window_name}' 2>/dev/null | grep -qx "$win" \
    || { printf 'ABSENT\tno such window: %s\n' "$win"; exit 7; }
fi
printf '%s\n' "$out"
exit "$(state_rc "$state")"
