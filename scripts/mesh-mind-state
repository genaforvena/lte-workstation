  # ── WEDGED-INPUT cells (mind-state-wedged-input 2026-07-06) ── sandbox the cross-tick memory
  _wmesh="$MESH"; MESH="$(mktemp -d)"
  _wpane="$(printf '❯ 55.75 37.62 — seed it and wire the sense\n────\n  ⏵⏵ auto mode on (shift+tab to cycle) · ← for agents\n')"
