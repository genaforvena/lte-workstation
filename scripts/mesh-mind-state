  _wa_clear="$(printf '❯ /clear\n────\n  ⏵⏵ auto mode on (shift+tab to cycle) · ← for agents\n')"
  watch_tick wauto "$_wa_clear" >/dev/null 2>/dev/null
  watch_tick wauto "$_wa_clear" >/dev/null 2>/dev/null
  _wa_o1="$(watch_tick wauto "$_wa_clear" 2>&1 >/dev/null)"
