  # negative control: arbitrary operator text → board, not trace
  _wr_board=""; _wr_trace=""
  watch_tick wroute2 "$_wa_op" >/dev/null 2>/dev/null
  watch_tick wroute2 "$_wa_op" >/dev/null 2>/dev/null
  watch_tick wroute2 "$_wa_op" >/dev/null 2>/dev/null
  case "$_wr_board" in *'[mind-wedged]'*) :;; *) _wrfail "operator-text wedge did not route to board: trace=$_wr_trace board=$_wr_board";; esac
