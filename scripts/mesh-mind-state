  # ── mindunblocked-cooldown-asymmetry (chat-review 2026-07-06) ───────────────────────────────────
  # The 3 entry branches (blocked/limited/wedged) gate on cooldown_check, but the OLD [mind-unblocked]
  # branch posted unconditionally — a flap faster than the entry cooldown suppressed the entry post
  # (no board line) while the recovery still fired later, un-paired (live: 28 unblocked vs 8 entries
  # in one 220-line window). alert() now consumes an per-win "announced" mark left by a REAL entry
  # post; an un-paired recovery (mark absent) routes to trace instead of the board. Stub mesh-chat/
  # mesh-trace as local functions (bash resolves the bare command name through the function table
  # first — same convention as mesh-turbo-lid/mesh-land's own outbound-capture tests) so this is
  # hermetic, no live board/trace side effect. Falsify: revert the unblocked branch to the old
  # unconditional post and every assertion below fails.
  _mu_wmesh="$MESH"; MESH="$(mktemp -d)"
  _mu_board=""; _mu_trace=""
  mesh-chat(){ _mu_board="$_mu_board|$*"; }
  mesh-trace(){ _mu_trace="$_mu_trace|$*"; }
  # cooldown-suppressed entry (simulate: cooldown already armed) → no board post, no announced mark
  cooldown_set muwin NEEDS-INPUT
  alert "[mind-blocked] $(hostname):muwin waiting on input — test"
  [ -z "$_mu_board" ] || { unset -f mesh-chat mesh-trace; MESH="$_mu_wmesh"; echo "smoke-test: FAIL (cooldown-suppressed entry must NOT board-post: $_mu_board)"; exit 1; }
  [ ! -f "$(announced_file muwin)" ] || { unset -f mesh-chat mesh-trace; MESH="$_mu_wmesh"; echo "smoke-test: FAIL (suppressed entry must leave NO announced mark)"; exit 1; }
  # recovery for this un-announced episode → must route to TRACE, never the board
  _mu_board=""; _mu_trace=""
  alert "[mind-unblocked] $(hostname):muwin now WORKING"
  [ -z "$_mu_board" ] || { unset -f mesh-chat mesh-trace; MESH="$_mu_wmesh"; echo "smoke-test: FAIL (un-paired recovery must NOT reach the board: $_mu_board)"; exit 1; }
  case "$_mu_trace" in *'[mind-unblocked]'*) :;; *) unset -f mesh-chat mesh-trace; MESH="$_mu_wmesh"; echo "smoke-test: FAIL (un-paired recovery must be routed to trace, got: $_mu_trace)"; exit 1;; esac
  # a FRESH entry (cooldown clear) → board-announces + leaves the mark
  rm -f "$(cooldown_file muwin NEEDS-INPUT)" "$(cooldown_file muwin UNBLOCKED)"
  _mu_board=""; _mu_trace=""
  alert "[mind-blocked] $(hostname):muwin waiting on input — test2"
  case "$_mu_board" in *'[mind-blocked]'*) :;; *) unset -f mesh-chat mesh-trace; MESH="$_mu_wmesh"; echo "smoke-test: FAIL (fresh entry must board-post, got: $_mu_board)"; exit 1;; esac
  [ -f "$(announced_file muwin)" ] || { unset -f mesh-chat mesh-trace; MESH="$_mu_wmesh"; echo "smoke-test: FAIL (fresh entry must leave an announced mark)"; exit 1; }
  # the PAIRED recovery → board-announced, and the mark is consumed (one-shot pairing)
  _mu_board=""; _mu_trace=""
  alert "[mind-unblocked] $(hostname):muwin now WORKING"
  case "$_mu_board" in *'[mind-unblocked]'*) :;; *) unset -f mesh-chat mesh-trace; MESH="$_mu_wmesh"; echo "smoke-test: FAIL (paired recovery must reach the board, got board='$_mu_board' trace='$_mu_trace')"; exit 1;; esac
  [ ! -f "$(announced_file muwin)" ] || { unset -f mesh-chat mesh-trace; MESH="$_mu_wmesh"; echo "smoke-test: FAIL (announced mark must be consumed after a paired recovery)"; exit 1; }
  unset -f mesh-chat mesh-trace; rm -rf "$MESH"; MESH="$_mu_wmesh"

  # ── DEAD-SHELL (chat-review/shed-pane-dead-shell-misclassified 2026-07-07) ───────────────────────
  # REAL bash-pane fixture: a private tmux socket + a genuinely spawned `bash` process (not a mocked
  # string) — ps -t <tty> truly queries it, proving pane_is_bare_shell works against actual process
  # reality, per the task's own ask ("test with a real bash pane fixture"). Isolated socket, killed at
  # the end — never touches this node's shared hostname session (same pattern mesh-tell's ack_probe
  # fixture already uses).
  _dsl="mindstateshell$$"
  tmux -L "$_dsl" new-session -d -s t -x 80 -y 10 'exec bash --norc --noprofile' 2>/dev/null
  sleep 0.3
  _dstty="$(tmux -L "$_dsl" display-message -p -t t:0.0 '#{pane_tty}' 2>/dev/null)"
  if [ -n "$_dstty" ]; then
    export MESH_MIND_STATE_COMMS_CMD="ps -t '$_dstty' -o comm= 2>/dev/null"
    pane_is_bare_shell fakewin local \
      || { tmux -L "$_dsl" kill-server 2>/dev/null; unset MESH_MIND_STATE_COMMS_CMD; echo "smoke-test: FAIL (real bash-only pane must classify as bare-shell)"; exit 1; }
    # full integration: classify_win must override to DEAD-SHELL for this real fixture even when the
    # pane TEXT looks exactly like a live idle mind (frozen footer/prompt glyph) — the whole point.
    s="$(classify_win fakewin local "$(printf 'some stale frozen mind footer\n❯ \n  ⏵⏵ auto mode on · ← for agents\n')")"
    case "$s" in DEAD-SHELL*) :;; *) tmux -L "$_dsl" kill-server 2>/dev/null; unset MESH_MIND_STATE_COMMS_CMD; echo "smoke-test: FAIL (classify_win on a real bash-only pane should override to DEAD-SHELL, got: $s)"; exit 1;; esac
    unset MESH_MIND_STATE_COMMS_CMD
  else
    echo "smoke-test: SKIP (could not resolve fixture pane tty — private tmux socket issue, not this feature)"
  fi
  tmux -L "$_dsl" kill-server 2>/dev/null
  # NEGATIVE control (hermetic mock — the real-process case above already proves the bare-shell path;
  # this proves a mind engine's presence is NOT swallowed, i.e. the check isn't an always-true stub):
  export MESH_MIND_STATE_COMMS_CMD="printf 'bash\nclaude\n'"
  pane_is_bare_shell fakewin local \
    && { unset MESH_MIND_STATE_COMMS_CMD; echo "smoke-test: FAIL (a pane with a live claude comm must NOT classify as bare-shell)"; exit 1; }
  s="$(classify_win fakewin local "$(printf 'some output\n❯ \n  ⏵⏵ auto mode on · ← for agents\n')")"
  case "$s" in DEAD-SHELL*) echo "smoke-test: FAIL (classify_win must not override a pane with a live mind engine: $s)"; exit 1;; esac
  case "$s" in IDLE*) :;; *) echo "smoke-test: FAIL (with a live engine present, text classification should proceed normally → $s)"; exit 1;; esac
  unset MESH_MIND_STATE_COMMS_CMD
  # fail-open: an UNREADABLE probe (empty comm list) must NEVER fabricate DEAD-SHELL — the text
  # classifier still applies (falsify: drop the `[ -n "$comms" ]` guard and this trips).
  export MESH_MIND_STATE_COMMS_CMD="true"   # prints nothing
  pane_is_bare_shell fakewin local \
    && { unset MESH_MIND_STATE_COMMS_CMD; echo "smoke-test: FAIL (an unreadable probe must fail-open, not claim bare-shell)"; exit 1; }
  unset MESH_MIND_STATE_COMMS_CMD
  # single-window CLI must exit 8 for DEAD-SHELL (mirrors the 4/5/6/7 convention) — source guard since
  # the live process check can't be forced through the CLI path hermetically here.
  grep -q 'DEAD-SHELL) exit 8;;' "$0" || { echo "smoke-test: FAIL (single-window CLI missing DEAD-SHELL exit 8)"; exit 1; }
  # ABSENT vs DEAD-SHELL (chat-review/mindstate-absent-vs-deadshell-tmux-fallback): a GENUINELY absent
  # window must return ABSENT/exit-7, not DEAD-SHELL/exit-8. Was broken because tmux display-message
  # silently falls back to the active pane's real tty for a nonexistent window (list-panes correctly
  # errors) → ps found a real shell → DEAD-SHELL for any absent window, never reaching the exit-7 guard.
  # Drive the real CLI path on a window name guaranteed absent from any tmux session. (Falsify: revert
  # either the pane_comms pidx-gate or the widened exit-7 guard → this returns 8.)
  "$0" "zzz-bogus-nonexistent-$$" >/dev/null 2>&1; _abrc=$?
  [ "$_abrc" -eq 7 ] || { echo "smoke-test: FAIL (absent window must be ABSENT/exit-7, got exit $_abrc — display-message tty-fallback misclassifies it as DEAD-SHELL)"; exit 1; }
  # PREFIX GATE (chat-review/mindstate-prefix-answers-for-another-window): the zzz-bogus assert above
  # only ever drives a name matching NOTHING — the case that always worked. tmux target matching is
  # prefix/fnmatch, so the case that BROKE is a phantom name that prefixes a LIVE window: it read that
  # window's pane and returned its state, rc=0, under the asked-for name. Drive the REAL path against
  # the REAL session: derive a strict prefix of a live window that is not itself a window name, and
  # assert it reads ABSENT/exit-7 — never the neighbour's state. Falsify: delete the exact-name gate
  # above peek_win and this returns 0 + the neighbour's classification.
  # Honest n/a (exit 2, mesh-land counts it a pass) where there is no session/window to derive from —
  # never a fake green.
  # The donor window MUST classify LIVE (rc 0 = IDLE/WORKING), not a bare shell: a DEAD-SHELL donor
  # (the `bash` window) makes this assert VACUOUS — its phantom prefix classifies DEAD-SHELL and so
  # reaches the OLD exit-7 guard, returning ABSENT for the wrong reason and passing against the bug.
  # (Observed: with the fix reverted, a `bas`/`bash` donor still printed ok.) Only a LIVE donor never
  # reaches that guard, which is precisely where the prefix bug lives.
  _live=""; _pfx=""
  mapfile -t _wins < <(tmux list-windows -t "$(hostname)" -F '#{window_name}' 2>/dev/null)
  for _w in "${_wins[@]}"; do
    [ "${#_w}" -ge 3 ] || continue
    _cand="${_w:0:$(( ${#_w} - 1 ))}"                       # strict prefix: drop the last char
    printf '%s\n' "${_wins[@]}" | grep -qx "$_cand" && continue   # must not itself be a real window
    "$0" "$_w" >/dev/null 2>&1; [ $? -eq 0 ] || continue          # donor must be a LIVE mind window
    _live="$_w"; _pfx="$_cand"; break
  done
  if [ -z "$_pfx" ]; then
    echo "smoke-test: n/a (no LIVE mind window to derive a strict prefix from — prefix gate needs a live session)"; exit 2
  fi
  # control: the FULL name must still classify LIVE (rc 0, never 7) — proves the gate rejects only the
  # phantom, and did not just break every read.
  "$0" "$_live" >/dev/null 2>&1; _fullrc=$?
  [ "$_fullrc" -eq 0 ] || { echo "smoke-test: FAIL (exact-name gate broke the REAL live window '$_live' — got exit $_fullrc)"; exit 1; }
  _pfxout="$("$0" "$_pfx" 2>&1)"; _pfxrc=$?
  [ "$_pfxrc" -eq 7 ] || { echo "smoke-test: FAIL (phantom '$_pfx' prefixes live window '$_live' — must be ABSENT/exit-7, got exit $_pfxrc: '$_pfxout' — tmux prefix-matching answered for another window)"; exit 1; }
  printf '%s' "$_pfxout" | grep -q '^ABSENT' || { echo "smoke-test: FAIL (phantom '$_pfx' must print ABSENT, got '$_pfxout')"; exit 1; }
  echo "smoke-test: ok (DEAD-SHELL: real bash-pane fixture classifies bare-shell + classify_win overrides a mind-like frozen frame; live-engine mock stays untouched; unreadable probe fails open; CLI exit code wired; absent window → ABSENT/exit-7 not DEAD-SHELL; phantom prefix '$_pfx' of live '$_live' → ABSENT/exit-7, real name still classifies)"

  # CARD GATE (chat-review/mindstate-card-gate 2026-07-06): --watch must never read/alert on a
  # HANDS-OFF node's panes. Falsify: remove the `card_gates_minds && exit 0` line from --watch (or
  # blank card_gates_minds's body) and these trip.
  _cf="$(mktemp)"
  printf 'minds: \n' > "$_cf"    # blanked line present, no known engine — HANDS-OFF (phaedra's live shape)
  card_gates_minds "$_cf" || { echo "smoke-test: FAIL (blank 'minds:' line should gate — card_gates_minds returned false)"; rm -f "$_cf"; exit 1; }
  printf 'minds: claude\n' > "$_cf"
  card_gates_minds "$_cf" && { echo "smoke-test: FAIL ('minds: claude' should NOT gate — card_gates_minds returned true)"; rm -f "$_cf"; exit 1; }
  printf 'role: sense\n' > "$_cf"   # no minds: line at all — not gated (mirrors mesh-mind-keepalive's own behavior)
  card_gates_minds "$_cf" && { echo "smoke-test: FAIL (card with no 'minds:' line at all should NOT gate)"; rm -f "$_cf"; exit 1; }
  rm -f "$_cf"
  card_gates_minds /no/such/card-file && { echo "smoke-test: FAIL (missing card file should NOT gate)"; exit 1; }
  grep -qF 'card_gates_minds && exit 0' "$0" || { echo "smoke-test: FAIL (--watch no longer calls the card gate)"; exit 1; }
  # end-to-end: a real --watch invocation under a HANDS-OFF card must exit 0 with ZERO output — proving
  # the gate fires before AUTO-DISCOVER/tmux/board calls (safe to actually run: it must exit before
  # touching this node's real tmux session, so this can't leak a false alert about live windows).
  _sandbox="$(mktemp -d)"; mkdir -p "$_sandbox/.mesh"; printf 'minds: \n' > "$_sandbox/.mesh-card"
  _wout="$(HOME="$_sandbox" "$0" --watch 2>&1)"; _wrc=$?
  rm -rf "$_sandbox"
  [ "$_wrc" -eq 0 ] && [ -z "$_wout" ] || { echo "smoke-test: FAIL (--watch under a HANDS-OFF card should exit 0 silently — got rc=$_wrc out='$_wout')"; exit 1; }

  echo "smoke-test: ok (+ WEDGED-INPUT: 2-tick same-text wedge, 1-tick/changed/empty/ghost/WORKING-reset all stay IDLE, edge alert-due + dedupe + recovery plumbing + loop-level [mind-wedged]→[mind-unblocked] round trip, + card-gated --watch: HANDS-OFF card exits 0 silently before any tmux/board call, engine-declared card runs, + mindunblocked-cooldown-asymmetry: suppressed entry leaves no mark + un-paired recovery routes to trace / fresh entry marks + paired recovery board-posts and consumes the mark, + mindstate-unblocked-healthy-gate: wedged→UNKNOWN advances seenf silently (no false all-clear), wedged→IDLE still alerts)"; exit 0
fi

if [ "${1:-}" = --stats ]; then
  shift
  node=local; [ "${1:-}" = "--node" ] && { node="$2"; shift 2; }
  wins=("$@")
  [ ${#wins[@]} -gt 0 ] || mapfile -t wins < <(tmux list-windows -t "$(hostname)" -F '#{window_name}' 2>/dev/null | grep -vxE 'shell|reflex|sh|mon:.*')
  printf '%-10s\t%-12s\t%-12s\t%-7s\t%-5s\t%s\n' WINDOW STATE MODEL TOKENS PCT DOLLARS
  for w in "${wins[@]}"; do
    raw="$(peek_win "$w" "$node" 2>/dev/null || true)"
    [ -n "$raw" ] || { printf '%-10s\t%-12s\t%s\n' "$w" ABSENT; continue; }
    out="$(classify_win "$w" "$node" "$raw")"
    state="${out%%	*}"; ev="${out#*	}"
    IFS=$'\t' read -r model tokens pct dollars _ <<<"$(extract_metrics "$raw")"
    [ -n "$dollars" ] && dollars="\$$dollars"
    printf '%-10s\t%-12s\t%-12s\t%-7s\t%-5s\t%s\n' "$w" "$state" "${model:-?}" "${tokens:-?}" "${pct:-?}" "${dollars:-}"
  done
  exit 0
fi

if [ "${1:-}" = --watch ]; then
  shift; wins=("$@")
  # CARD-GATED (chat-review/mindstate-card-gate 2026-07-06): a HANDS-OFF node's panes must never even
  # be READ, let alone alerted on. Live false-positive: phaedra (minds-off card since 2026-06-25) still
  # had --watch read its panes and post [mind-unblocked] phaedra:chat 18:20:21Z. Single-window direct
  # invocation (below, no --watch) stays UNGATED — that path is a diagnostic query ("what is THIS
  # window doing right now"), not an autonomous alerting reflex. Exits BEFORE any tmux/board call.
  card_gates_minds && exit 0
  # AUTO-DISCOVER all mind-bearing windows (operator 2026-06-13: no hardcoded special list — a new
  # channel must appear in the wall automatically). A mind channel = any window EXCEPT pure infra
  # (shell=exec, reflex=loop-host, sh=stray). Everything else carries a mind in its bottom pane.
  [ ${#wins[@]} -gt 0 ] || mapfile -t wins < <(tmux list-windows -t "$(hostname)" -F '#{window_name}' 2>/dev/null | grep -vxE 'shell|reflex|sh|mon:.*')
  for w in "${wins[@]}"; do
    watch_tick "$w" "$(peek_win "$w" local)" local
  done
  exit 0
fi

