#!/usr/bin/env python3
"""Privacy-scoped, idempotent token-usage JSONL recorder.

The input is an observation event, never a transcript.  The recorder keeps only
the whitelisted attribution/usage fields and uses the lifecycle identity as its
deduplication key.  A conflict is retained in a separate audit stream and is a
failure; it never overwrites the first observation.
"""
import argparse
import fcntl
import hashlib
import json
import os
from pathlib import Path
import sys
from datetime import datetime, timezone

USAGE_FIELDS = ("total", "input", "cached_input", "output", "reasoning")
RAW_FIELDS = ("type", "engine", "provider", "model", "thread-id", "turn-id",
              "window", "observed_at", "received_at", "usage")


def canonical(value):
    return json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=False)


def iso_time(value):
    if value is None:
        return None
    if isinstance(value, str) and value:
        return value
    if isinstance(value, (int, float)):
        return datetime.fromtimestamp(value, timezone.utc).isoformat().replace("+00:00", "Z")
    return datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")


def clean_int(value):
    return value if isinstance(value, int) and not isinstance(value, bool) and value >= 0 else None


def normalize(event):
    if not isinstance(event, dict):
        raise ValueError("event is not an object")
    engine = event.get("engine")
    if not isinstance(engine, str) or not engine:
        client = event.get("client", "")
        engine = "codex" if isinstance(client, str) and client.startswith("codex") else None
    thread = event.get("thread_id", event.get("thread-id"))
    turn = event.get("turn_id", event.get("turn-id"))
    if not isinstance(engine, str) or not engine or not isinstance(thread, str) or not thread or not isinstance(turn, str) or not turn:
        raise ValueError("missing engine, thread-id, or turn-id")
    usage_in = event.get("usage") if isinstance(event.get("usage"), dict) else {}
    usage = {}
    source = {}
    for field in USAGE_FIELDS:
        value = usage_in.get(field)
        if field not in usage_in:
            usage[field], source[field] = None, "missing"
        elif clean_int(value) is None:
            usage[field], source[field] = None, "invalid"
        else:
            usage[field], source[field] = value, "provider"
    raw = {k: event[k] for k in RAW_FIELDS if k in event}
    if "client" in event and "engine" not in raw:
        raw["engine"] = engine
    raw["engine"] = engine
    raw["thread-id"] = thread
    raw["turn-id"] = turn
    raw["usage"] = {k: usage_in[k] for k in USAGE_FIELDS if k in usage_in}
    return {
        "schema_version": 1,
        "event_key": f"{engine}:{thread}:{turn}",
        "observed_at": iso_time(event.get("observed_at", event.get("received_at"))),
        "engine": engine,
        "provider": event.get("provider") if isinstance(event.get("provider"), str) else None,
        "model": event.get("model") if isinstance(event.get("model"), str) else None,
        "thread_id": thread,
        "turn_id": turn,
        "window": event.get("window") if isinstance(event.get("window"), str) else None,
        "usage": usage,
        "source": source,
        "parser_version": "token-usage-recorder-20260908.v2",
        "raw": raw,
    }


def secure_store(path):
    path.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(path, 0o700)
    for name in ("records.jsonl", "conflicts.jsonl", "quarantine.jsonl", ".lock"):
        candidate = path / name
        if candidate.exists():
            os.chmod(candidate, 0o600)


def append_json(path, row):
    with path.open("a", encoding="utf-8") as fh:
        os.chmod(path, 0o600)
        fh.write(canonical(row) + "\n")
        fh.flush()
        os.fsync(fh.fileno())


def record(event, store):
    secure_store(store)
    lock_path = store / ".lock"
    with lock_path.open("a+") as lock:
        os.chmod(lock_path, 0o600)
        fcntl.flock(lock, fcntl.LOCK_EX)
        try:
            row = normalize(event)
        except ValueError as exc:
            append_json(store / "quarantine.jsonl", {"reason": str(exc), "raw": {k: event[k] for k in RAW_FIELDS if isinstance(event, dict) and k in event}})
            return "quarantined", str(exc)
        records = store / "records.jsonl"
        existing = {}
        if records.exists():
            for line in records.read_text(encoding="utf-8").splitlines():
                try:
                    old = json.loads(line)
                    if old.get("event_key"):
                        existing[old["event_key"]] = old
                except json.JSONDecodeError:
                    append_json(store / "conflicts.jsonl", {"reason": "malformed-record", "line": line})
        prior = existing.get(row["event_key"])
        if prior is not None:
            if canonical(prior) == canonical(row):
                return "duplicate", row["event_key"]
            conflict = {"reason": "identity-conflict", "event_key": row["event_key"], "existing": prior, "incoming": row}
            append_json(store / "conflicts.jsonl", conflict)
            return "conflict", row["event_key"]
        append_json(records, row)
        return "recorded", row["event_key"]


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--store", default=os.path.expanduser("~/.mesh/token-usage"))
    source = ap.add_mutually_exclusive_group(required=True)
    source.add_argument("--event-file")
    source.add_argument("--event-json")
    source.add_argument("--replay")
    args = ap.parse_args()
    store = Path(args.store)
    events = []
    if args.event_file:
        events = [json.loads(Path(args.event_file).read_text(encoding="utf-8"))]
    elif args.event_json:
        events = [json.loads(args.event_json)]
    else:
        events = [json.loads(line) for line in Path(args.replay).read_text(encoding="utf-8").splitlines() if line.strip()]
    counts = {"recorded": 0, "duplicate": 0, "conflict": 0, "quarantined": 0}
    for event in events:
        status, detail = record(event, store)
        counts[status] += 1
        if len(events) == 1:
            print(f"{status}: {detail}")
    if len(events) > 1:
        print("replay: " + ", ".join(f"{n} {k}" for k, n in counts.items() if n))
    return 1 if counts["conflict"] or counts["quarantined"] else 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, json.JSONDecodeError, ValueError) as exc:
        print(f"token-recorder: {exc}", file=sys.stderr)
        raise SystemExit(2)
