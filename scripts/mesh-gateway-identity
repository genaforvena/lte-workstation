#!/usr/bin/env bash
# reflex-cadence: */10 * * * *
# mesh-gateway-identity — LAN gateway link-layer identity canary (ARP-spoof / router-swap sense).
#
# Why this is new:
#   mesh-lan-newdevice watches NEW MACs arriving; mesh-router-watch reads the router's thermals;
#   nothing attests that a KNOWN critical binding stays stable: the default gateway IP -> MAC pair.
#   A silent change in that binding is exactly what an ARP-spoof/MITM looks like from this vantage
#   (also fires on a legit router hardware swap — a change the mesh should notice either way).
#   Reads `ip route` (default gw + dev) + `ip neigh` (lladdr) — no root, radio/network-passive.
#
# Verdict vocabulary (a CONTRACT — consumers grep these tokens, do not rename):
#   STABLE   gateway MAC matches the learned baseline
#   CHANGED  same gateway IP, DIFFERENT MAC than baseline (the canary edge; auto-rebaselines so a
#            flip-back fires its own CHANGED — every flip is an edge, no alarm latching)
#   NEW      first-ever observation, or the default gateway IP itself moved (different network —
#            MACs across different gateways are incomparable, so learn fresh, never false-CHANGED)
# Honesty contract: no default route, or no resolvable neighbor entry after one ARP prime
#   -> exit 2 (cannot attest the binding), NEVER a fake STABLE.
# Baseline is CHANGE-GATED (rewritten only on NEW/CHANGED) -> mesh-state-touch on every
#   successful eval so a long-stable binding never decays to a false-STALE.
#
#   mesh-gateway-identity          one compact line
#   mesh-gateway-identity --json   machine-readable JSON
#   mesh-gateway-identity --test   fixture smoke test + live real-read gate
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

MESH="${MESH_DIR:-$HOME/.mesh}"
BASELINE="$MESH/.gw-identity-state"        # gw|mac|first_seen_ts
OFFLINEFILE="$MESH/.gw-identity-offline"   # dedupe marker for the one-shot UNREACHABLE stderr line
mkdir -p "$MESH" 2>/dev/null || true

# Fixture hooks (test sandbox): when set, read these files instead of running ip, and never ping.
ROUTE_FIX="${MESH_GW_ROUTE_FILE:-}"
NEIGH_FIX="${MESH_GW_NEIGH_FILE:-}"

route_read() {  # -> "gw<TAB>dev" from the first default route, or fail
  local out
  if [ -n "$ROUTE_FIX" ]; then out="$(cat "$ROUTE_FIX" 2>/dev/null)"
  else out="$(ip route show default 2>/dev/null)"; fi
  printf '%s\n' "$out" | awk '$1=="default"{
    gw=""; dev=""
    for(i=2;i<=NF;i++){ if($i=="via") gw=$(i+1); if($i=="dev") dev=$(i+1) }
    if(gw!=""){ printf "%s\t%s\n", gw, dev; exit 0 }
  }' | grep .
}

neigh_read() {  # $1=gw $2=dev -> lowercase mac, or fail (FAILED/INCOMPLETE carry no lladdr)
  local gw="$1" dev="$2" out
  if [ -n "$NEIGH_FIX" ]; then out="$(cat "$NEIGH_FIX" 2>/dev/null)"
  else out="$(ip neigh show "$gw" ${dev:+dev "$dev"} 2>/dev/null)"; fi
  printf '%s\n' "$out" | awk -v gw="$gw" '$1==gw{
    for(i=2;i<=NF;i++) if($i=="lladdr"){ print tolower($(i+1)); exit 0 }
  }' | grep -E '^([0-9a-f]{2}:){5}[0-9a-f]{2}$'
}

if [ "${1:-}" = --test ]; then
  command -v awk >/dev/null 2>&1 || { echo "smoke-test: FAIL (no awk)"; exit 1; }
  command -v ip  >/dev/null 2>&1 || { echo "smoke-test: FAIL (no ip — cannot read route/neigh)"; exit 1; }
  td="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
  trap 'rm -rf "$td"' EXIT
  printf 'default via 192.168.8.1 dev wlan0 proto dhcp metric 600\n' > "$td/route"
  printf '192.168.8.1 dev wlan0 lladdr 94:83:c4:68:07:66 REACHABLE\n'  > "$td/neigh"
  run() { MESH_DIR="$td/mesh" MESH_GW_ROUTE_FILE="$td/route" MESH_GW_NEIGH_FILE="$td/neigh" "$0" --json; }

  got="$(run)" || { echo "smoke-test: FAIL (first fixture read)"; exit 1; }
  printf '%s' "$got" | grep -q '"label":"NEW"'     || { echo "smoke-test: FAIL (first read -> NEW: $got)"; exit 1; }
  got="$(run)" || { echo "smoke-test: FAIL (second fixture read)"; exit 1; }
  printf '%s' "$got" | grep -q '"label":"STABLE"'  || { echo "smoke-test: FAIL (same binding -> STABLE: $got)"; exit 1; }

  printf '192.168.8.1 dev wlan0 lladdr de:ad:be:ef:00:01 REACHABLE\n' > "$td/neigh"
  got="$(run)" || { echo "smoke-test: FAIL (flipped fixture read)"; exit 1; }
  printf '%s' "$got" | grep -q '"label":"CHANGED"' || { echo "smoke-test: FAIL (mac flip -> CHANGED: $got)"; exit 1; }
  printf '%s' "$got" | grep -q '"was":"94:83:c4:68:07:66"' || { echo "smoke-test: FAIL (CHANGED carries was=: $got)"; exit 1; }
  got="$(run)" || { echo "smoke-test: FAIL (post-flip read)"; exit 1; }
  printf '%s' "$got" | grep -q '"label":"STABLE"'  || { echo "smoke-test: FAIL (auto-rebaseline -> STABLE: $got)"; exit 1; }

  printf 'default via 10.0.0.1 dev wlan0\n' > "$td/route"
  printf '10.0.0.1 dev wlan0 lladdr aa:bb:cc:dd:ee:ff STALE\n' > "$td/neigh"
  got="$(run)" || { echo "smoke-test: FAIL (gw-moved fixture read)"; exit 1; }
  printf '%s' "$got" | grep -q '"label":"NEW"'     || { echo "smoke-test: FAIL (gw moved -> NEW, never false-CHANGED: $got)"; exit 1; }

  printf '10.0.0.1 dev wlan0 FAILED\n' > "$td/neigh"
  run >/dev/null 2>&1; rc=$?
  [ "$rc" = 2 ] || { echo "smoke-test: FAIL (unresolvable neighbor -> exit 2, got rc=$rc)"; exit 1; }
  : > "$td/route"
  run >/dev/null 2>&1; rc=$?
  [ "$rc" = 2 ] || { echo "smoke-test: FAIL (no default route -> exit 2, got rc=$rc)"; exit 1; }

  # real-read gate: the live route+ARP must yield a MAC-shaped reading (state sandboxed so the
  # node's real baseline is untouched; a fresh sandbox can only render NEW, never a CHANGED post).
  real="$(MESH_DIR="$td/mesh-real" "$0" --json 2>/dev/null)"; rc=$?
  if [ "$rc" = 2 ]; then echo "smoke-test: n/a (no attestable default gateway on this node right now)"; exit 2; fi
  [ "$rc" = 0 ] || { echo "smoke-test: FAIL (live read rc=$rc)"; exit 1; }
  printf '%s' "$real" | grep -qE '"mac":"([0-9a-f]{2}:){5}[0-9a-f]{2}"' || { echo "smoke-test: FAIL (live read yields no MAC: $real)"; exit 1; }
  echo "smoke-test: ok (fixture NEW/STABLE/CHANGED/gw-move/exit-2 paths + live gateway MAC read)"
  exit 0
fi

JSON=0
for a in "$@"; do [ "$a" = --json ] && JSON=1; done

unreachable() {
  [ -f "$OFFLINEFILE" ] || { echo "gateway-identity: UNREACHABLE — $1" >&2; : > "$OFFLINEFILE"; }
  exit 2
}

r="$(route_read)" || unreachable "no default route (cannot attest a gateway binding)"
gw="${r%%$'\t'*}"; dev="${r#*$'\t'}"

mac="$(neigh_read "$gw" "$dev")" || {
  # one ARP prime, live mode only — a quiet cache is normal, an unresolvable gateway is not
  if [ -z "$NEIGH_FIX" ]; then
    ping -c1 -W1 "$gw" >/dev/null 2>&1 || true
    mac="$(neigh_read "$gw" "$dev")" || unreachable "gateway $gw has no resolvable neighbor entry"
  else
    unreachable "gateway $gw has no resolvable neighbor entry"
  fi
}
rm -f "$OFFLINEFILE" 2>/dev/null || true

ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
host="$(hostname)"
label=NEW; was=""; first_seen="$ts"
if [ -r "$BASELINE" ]; then
  IFS='|' read -r bgw bmac bts < "$BASELINE" || true
  if [ "$bgw" = "$gw" ] && [ "$bmac" = "$mac" ]; then label=STABLE; first_seen="$bts"
  elif [ "$bgw" = "$gw" ] && [ -n "${bmac:-}" ]; then label=CHANGED; was="$bmac"
  fi
fi

# change-gated baseline write + unconditional liveness touch (mtime = ran-live, content = value)
if [ "$label" != STABLE ]; then
  printf '%s|%s|%s\n' "$gw" "$mac" "$first_seen" > "$BASELINE"
fi
mesh-state-touch "$BASELINE" 2>/dev/null || true

# the canary edge reaches the board (live mode only; fixtures never post)
if [ "$label" = CHANGED ] && [ -z "$NEIGH_FIX" ] && [ -z "$ROUTE_FIX" ] && command -v mesh-chat >/dev/null 2>&1; then
  mesh-chat "[fyi] gateway-identity: CHANGED — gw $gw now $mac (was $was) on $host. ARP-spoof/MITM or router swap; verify the router." >/dev/null 2>&1 || true
fi

if [ "$JSON" = 1 ]; then
  printf '{"label":"%s","gw":"%s","mac":"%s","dev":"%s","was":%s,"first_seen":"%s","host":"%s","ts":"%s"}\n' \
    "$label" "$gw" "$mac" "$dev" "${was:+\"$was\"}" "$first_seen" "$host" "$ts" | sed 's/"was":,/"was":null,/'
else
  printf '[gateway-identity] %s gw=%s mac=%s dev=%s%s since=%s @ %s %s\n' \
    "$label" "$gw" "$mac" "$dev" "${was:+ was=$was}" "$first_seen" "$host" "$ts"
fi
