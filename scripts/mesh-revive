#!/usr/bin/env bash
# mesh-revive — connectivity self-heal reflex: crawl out of internet-starvation, SAFELY. $0, no mind.
# Detects loss of internet, tries GENTLE REVERSIBLE recovery, alerts the operator. A temporary bond:
# fires on starvation, acts, releases. By default it does NOT flip substrate aggressively (the
# operator's "be reasonable" + "don't break the VPN"); the egress fallback is opt-in.
#
#   mesh-revive --check     one probe + heal attempt; print result
#   mesh-revive --loop [s]  watch every N sec (default 60); heal + alert on starvation
#
# MESH_REVIVE_FALLBACK=1  → if starving AND egress rides an exit-node, drop it to restore DIRECT
#                           internet (fully reversible; re-set when the path returns). Opt-in.
set -uo pipefail
PROBES=(1.1.1.1 8.8.8.8 9.9.9.9)
FLAG="$HOME/.mesh/.revive-starving"
REVIVE_EXITNODE_SAVE="$HOME/.mesh/.revive-exitnode"
note(){ printf '%s  mesh-revive: %s\n' "$(date -u +%H:%M:%SZ)" "$*"; }

internet_up(){
  local ip
  # HTTPS probes (primary)
  for ip in "${PROBES[@]}"; do
    curl -s -o /dev/null --max-time 5 "https://$ip" 2>/dev/null && return 0
  done
  # non-HTTPS fallback: ping (survives TLS/cert issues)
  for ip in "${PROBES[@]}"; do
    ping -c 1 -W 3 "$ip" 2>/dev/null && return 0
  done
  return 1
}

heal(){
  note "starving — gentle reversible recovery"
  # 1) re-up tailscale (idempotent; restores the mesh control path)
  timeout 15 tailscale up 2>/dev/null && note "  tailscale re-upped" || true
  # 2) opt-in: if egress rides a (now-dead) exit-node, fall back to DIRECT to restore own internet
  if [ "${MESH_REVIVE_FALLBACK:-0}" = 1 ]; then
    local exitnode_ip; exitnode_ip="$(tailscale status --json 2>/dev/null | python3 -c 'import json,sys;d=json.load(sys.stdin);ips=(d.get("ExitNodeStatus") or {}).get("TailscaleIPs") or [];print(ips[0].split("/")[0] if ips else "")' 2>/dev/null)"
    if [ -n "$exitnode_ip" ] && ! internet_up; then
      note "  saving exit-node $exitnode_ip -> $REVIVE_EXITNODE_SAVE; dropping to direct egress"
      echo "$exitnode_ip" > "$REVIVE_EXITNODE_SAVE"
      timeout 15 tailscale set --exit-node= 2>/dev/null && note "  fell back to direct egress" || true
    fi
  fi
}

restore_exitnode(){
  if [ -f "$REVIVE_EXITNODE_SAVE" ]; then
    local saved_ip; saved_ip="$(cat "$REVIVE_EXITNODE_SAVE" 2>/dev/null || true)"
    if [ -n "$saved_ip" ]; then
      timeout 15 tailscale set --exit-node="$saved_ip" 2>/dev/null && note "  restored exit-node $saved_ip" || true
    fi
    rm -f "$REVIVE_EXITNODE_SAVE"
  fi
}

alert(){ command -v mesh-tg >/dev/null 2>&1 && mesh-tg "$*" >/dev/null 2>&1 || true; }

cycle(){
  if internet_up; then
    restore_exitnode
    if [ -f "$FLAG" ]; then note "RECOVERED"; alert "🌿 mesh-revive: internet RECOVERED on $(hostname)"; rm -f "$FLAG"; fi
    return 0
  fi
  heal
  if internet_up; then
    restore_exitnode
    note "healed"; [ -f "$FLAG" ] && { alert "🌿 mesh-revive: $(hostname) crawled out of starvation (self-healed)"; rm -f "$FLAG"; }
  else
    note "STILL starving after heal"
    [ -f "$FLAG" ] || { alert "⚠️ mesh-revive: $(hostname) internet starvation — self-heal didn't restore. Path may need you."; touch "$FLAG"; }
  fi
}

case "${1:-}" in
  --test) command -v tailscale >/dev/null 2>&1 && command -v curl >/dev/null 2>&1 && { echo "smoke-test: ok"; exit 0; } || { echo "smoke-test: FAIL (needs tailscale + curl)"; exit 1; } ;;
  --loop) iv="${2:-60}"; note "watching every ${iv}s (self-heal on starvation; fallback=$([ "${MESH_REVIVE_FALLBACK:-0}" = 1 ] && echo on || echo off))"
          while true; do cycle; sleep "$iv"; done ;;
  ""|--check) cycle ;;
  *) echo "usage: mesh-revive [--check | --loop [sec]]   (MESH_REVIVE_FALLBACK=1 for direct-egress fallback)" >&2; exit 1 ;;
esac
