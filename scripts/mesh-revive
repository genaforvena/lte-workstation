#!/usr/bin/env bash
# mesh-revive — connectivity self-heal reflex: crawl out of internet-starvation, SAFELY.
# Detects N consecutive internet failures → escalating recovery:
#   (1) restart tailscale
#   (2) drop exit-node (reversible)
#   (3) alert operator via board + tg + sms
# Gentle reversible recovery, never touches default-string VPN.
#
#   mesh-revive --check        one probe + heal attempt; print result
#   mesh-revive --loop [s]     watch every N sec (default 60); heal + alert on starvation
#
# Consecutive-fail threshold: MESH_REVIVE_THRESHOLD (default 3)
set -uo pipefail
PROBES=(1.1.1.1 8.8.8.8 9.9.9.9)
THRESHOLD="${MESH_REVIVE_THRESHOLD:-3}"
FLAG="$HOME/.mesh/.revive-starving"
FAIL_CNT="$HOME/.mesh/.revive-fails"
REVIVE_EXITNODE_SAVE="$HOME/.mesh/.revive-exitnode"
note(){ printf '%s  mesh-revive: %s\n' "$(date -u +%H:%M:%SZ)" "$*"; }

internet_up(){
  local ip
  for ip in "${PROBES[@]}"; do
    curl -s -o /dev/null --max-time 5 "https://$ip" 2>/dev/null && return 0
  done
  for ip in "${PROBES[@]}"; do
    ping -c 1 -W 3 "$ip" 2>/dev/null && return 0
  done
  return 1
}

heal(){
  note "starving — gentle reversible recovery"
  # (1) restart tailscale (idempotent; restores the mesh control path)
  timeout 15 tailscale up 2>/dev/null && note "  (1) tailscale re-upped" || true
  # (2) drop exit-node if still starving — automatic, reversible
  local exitnode_ip
  exitnode_ip="$(tailscale status --json 2>/dev/null | python3 -c '
import json,sys
d=json.load(sys.stdin)
ips=(d.get("ExitNodeStatus") or {}).get("TailscaleIPs") or []
print(ips[0].split("/")[0] if ips else "")
' 2>/dev/null)"
  if [ -n "$exitnode_ip" ] && ! internet_up; then
    note "  (2) saving exit-node $exitnode_ip -> $REVIVE_EXITNODE_SAVE; dropping to direct egress"
    echo "$exitnode_ip" > "$REVIVE_EXITNODE_SAVE"
    timeout 15 tailscale set --exit-node= 2>/dev/null && note "  (2) fell back to direct egress" || true
  fi
}

restore_exitnode(){
  if [ -f "$REVIVE_EXITNODE_SAVE" ]; then
    local saved_ip; saved_ip="$(cat "$REVIVE_EXITNODE_SAVE" 2>/dev/null || true)"
    if [ -n "$saved_ip" ]; then
      timeout 15 tailscale set --exit-node="$saved_ip" 2>/dev/null && note "  restored exit-node $saved_ip" || true
    fi
    rm -f "$REVIVE_EXITNODE_SAVE"
  fi
}

alert(){
  local msg="$1"; shift
  command -v mesh-tg  >/dev/null 2>&1 && mesh-tg  "$msg" >/dev/null 2>&1 || true
  command -v mesh-chat >/dev/null 2>&1 && mesh-chat "$msg" >/dev/null 2>&1 || true
}
alert_sms(){
  local msg="$*"
  command -v mesh-sms >/dev/null 2>&1 && mesh-sms "$msg" >/dev/null 2>&1 || true
}

cycle(){
  if internet_up; then
    restore_exitnode
    if [ -f "$FLAG" ]; then
      note "RECOVERED"
      alert "🌿 mesh-revive: internet RECOVERED on $(hostname)"
    fi
    rm -f "$FLAG" "$FAIL_CNT" 2>/dev/null
    return 0
  fi
  # track consecutive failures
  local n=0
  [ -f "$FAIL_CNT" ] && n="$(cat "$FAIL_CNT" 2>/dev/null || echo 0)"
  n=$((n + 1))
  echo "$n" > "$FAIL_CNT"
  if [ "$n" -lt "$THRESHOLD" ]; then
    note "internet down (fail $n/$THRESHOLD — waiting before heal)"
    return 1
  fi
  # threshold reached — heal
  heal
  if internet_up; then
    restore_exitnode
    note "healed after $n failures"
    rm -f "$FAIL_CNT" "$FLAG" 2>/dev/null
    alert "🌿 mesh-revive: $(hostname) crawled out of starvation (self-healed after ${n} failures)"
  else
    note "STILL starving after heal (${n} consecutive failures)"
    if [ -f "$FLAG" ]; then
      # (3) already alerted once — escalate via SMS
      alert_sms "⚠️ mesh-revive ESCALATED: $(hostname) still starving after heal. Manual intervention needed."
    else
      # (3) first alert — board + tg
      alert "⚠️ mesh-revive: $(hostname) internet starvation (${n} failures) — self-heal failed. Path may need you."
      touch "$FLAG"
    fi
  fi
}

case "${1:-}" in
  --test)
    command -v tailscale >/dev/null 2>&1 || { echo "smoke-test: FAIL (no tailscale)"; exit 1; }
    command -v curl      >/dev/null 2>&1 || { echo "smoke-test: FAIL (no curl)"; exit 1; }
    # Verify THRESHOLD is a positive integer
    [ "$THRESHOLD" -ge 1 ] 2>/dev/null || { echo "smoke-test: FAIL (MESH_REVIVE_THRESHOLD=$THRESHOLD is not a positive integer)"; exit 1; }
    echo "smoke-test: ok"; exit 0 ;;
  --loop) iv="${2:-60}"; note "watching every ${iv}s (threshold=${THRESHOLD})"
          while true; do cycle; sleep "$iv"; done ;;
  ""|--check) cycle ;;
  *) echo "usage: mesh-revive [--check | --loop [sec]]   MESH_REVIVE_THRESHOLD (default 3)" >&2; exit 1 ;;
esac
