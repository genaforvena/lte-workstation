#!/usr/bin/env bash
# mesh-revive — connectivity self-heal reflex: crawl out of internet-starvation, SAFELY.
# Detects N consecutive internet failures → escalating recovery:
#   (1) restart tailscale
#   (2) drop exit-node (reversible)
#   (3) alert operator via board + tg + sms
# Gentle reversible recovery, never touches default-string VPN.
#
#   mesh-revive --check        one probe + heal attempt; print result
#   mesh-revive --loop [s]     watch every N sec (default 60); heal + alert on starvation
#
# Consecutive-fail threshold: MESH_REVIVE_THRESHOLD (default 3)
set -uo pipefail
PROBES=(1.1.1.1 8.8.8.8 9.9.9.9)
THRESHOLD="${MESH_REVIVE_THRESHOLD:-3}"
FLAG="$HOME/.mesh/.revive-starving"
FAIL_CNT="$HOME/.mesh/.revive-fails"
REVIVE_EXITNODE_SAVE="$HOME/.mesh/.revive-exitnode"
note(){ printf '%s  mesh-revive: %s\n' "$(date -u +%H:%M:%SZ)" "$*"; }

# TEST-SANDBOX gate (extends chat-review/doctor-smoke-sandbox-net, same convention as mesh-say:114
# / mesh-sms:35 / mesh-chat:188). MESH_TEST_SANDBOX=1 marks a smoke-sweep context — mesh-doctor
# exports it around EVERY child --test (mesh-doctor:166, :923) and fires the hourly :23 sweep.
# The two actuators below are SUBSTRATE: `tailscale up` and an exit-node swap change the path this
# node is reached through, and no --test may ever pull that lever. Guarded at the ACTUATOR rather
# than the CLI branch, so every route in is covered by construction — --check, --loop, and a
# wrapper's --test alike (mesh-selfcare:110 was the live leak: its green "smoke-test: ok" ran
# `tailscale up` + `set --exit-node=` hourly, with this very variable already sitting in its env).
sandboxed(){ [ "${MESH_TEST_SANDBOX:-0}" = 1 ]; }

internet_up(){
  local ip
  for ip in "${PROBES[@]}"; do
    curl -s -o /dev/null --max-time 5 "https://$ip" 2>/dev/null && return 0
  done
  for ip in "${PROBES[@]}"; do
    ping -c 1 -W 3 "$ip" 2>/dev/null && return 0
  done
  return 1
}

heal(){
  if sandboxed; then
    note "MESH_TEST_SANDBOX — heal SUPPRESSED (smoke-sweep context): substrate untouched"
    return 0
  fi
  note "starving — gentle reversible recovery"
  # (1) restart tailscale (idempotent; restores the mesh control path)
  timeout 15 tailscale up 2>/dev/null && note "  (1) tailscale re-upped" || true
  # (2) drop exit-node if still starving — automatic, reversible
  local exitnode_ip
  exitnode_ip="$(tailscale status --json 2>/dev/null | python3 -c '
import json,sys
d=json.load(sys.stdin)
ips=(d.get("ExitNodeStatus") or {}).get("TailscaleIPs") or []
print(ips[0].split("/")[0] if ips else "")
' 2>/dev/null)"
  if [ -n "$exitnode_ip" ] && ! internet_up; then
    note "  (2) saving exit-node $exitnode_ip -> $REVIVE_EXITNODE_SAVE; dropping to direct egress"
    echo "$exitnode_ip" > "$REVIVE_EXITNODE_SAVE"
    timeout 15 tailscale set --exit-node= 2>/dev/null && note "  (2) fell back to direct egress" || true
  fi
}

restore_exitnode(){
  if sandboxed; then
    [ -f "$REVIVE_EXITNODE_SAVE" ] && note "MESH_TEST_SANDBOX — exit-node restore SUPPRESSED (smoke-sweep context)"
    return 0
  fi
  if [ -f "$REVIVE_EXITNODE_SAVE" ]; then
    local saved_ip; saved_ip="$(cat "$REVIVE_EXITNODE_SAVE" 2>/dev/null || true)"
    if [ -n "$saved_ip" ]; then
      timeout 15 tailscale set --exit-node="$saved_ip" 2>/dev/null && note "  restored exit-node $saved_ip" || true
    fi
    rm -f "$REVIVE_EXITNODE_SAVE"
  fi
}

alert(){
  local msg="$1"; shift
  command -v mesh-tg  >/dev/null 2>&1 && mesh-tg  "$msg" >/dev/null 2>&1 || true
  command -v mesh-chat >/dev/null 2>&1 && mesh-chat "$msg" >/dev/null 2>&1 || true
}
alert_sms(){
  local msg="$*"
  command -v mesh-sms >/dev/null 2>&1 && mesh-sms "$msg" >/dev/null 2>&1 || true
}

cycle(){
  if internet_up; then
    restore_exitnode
    if [ -f "$FLAG" ]; then
      note "RECOVERED"
      alert "🌿 mesh-revive: internet RECOVERED on $(hostname)"
    fi
    rm -f "$FLAG" "$FAIL_CNT" 2>/dev/null
    return 0
  fi
  # track consecutive failures
  local n=0
  [ -f "$FAIL_CNT" ] && n="$(cat "$FAIL_CNT" 2>/dev/null || echo 0)"
  n=$((n + 1))
  echo "$n" > "$FAIL_CNT"
  if [ "$n" -lt "$THRESHOLD" ]; then
    note "internet down (fail $n/$THRESHOLD — waiting before heal)"
    return 1
  fi
  # threshold reached — heal
  heal
  if internet_up; then
    restore_exitnode
    note "healed after $n failures"
    rm -f "$FAIL_CNT" "$FLAG" 2>/dev/null
    alert "🌿 mesh-revive: $(hostname) crawled out of starvation (self-healed after ${n} failures)"
  else
    note "STILL starving after heal (${n} consecutive failures)"
    if [ -f "$FLAG" ]; then
      # (3) already alerted once — escalate via SMS
      alert_sms "⚠️ mesh-revive ESCALATED: $(hostname) still starving after heal. Manual intervention needed."
    else
      # (3) first alert — board + tg
      alert "⚠️ mesh-revive: $(hostname) internet starvation (${n} failures) — self-heal failed. Path may need you."
      touch "$FLAG"
    fi
  fi
}

case "${1:-}" in
  --test)
    command -v tailscale >/dev/null 2>&1 || { echo "smoke-test: FAIL (no tailscale)"; exit 1; }
    command -v curl      >/dev/null 2>&1 || { echo "smoke-test: FAIL (no curl)"; exit 1; }
    command -v python3   >/dev/null 2>&1 || { echo "smoke-test: FAIL (no python3)"; exit 1; }
    command -v ping      >/dev/null 2>&1 || { echo "smoke-test: FAIL (no ping)"; exit 1; }
    # Verify THRESHOLD is a positive integer
    [ "$THRESHOLD" -ge 1 ] 2>/dev/null || { echo "smoke-test: FAIL (MESH_REVIVE_THRESHOLD=$THRESHOLD is not a positive integer)"; exit 1; }
    # Dry-run: exercise the threshold counter logic with a mock internet_up that always fails.
    # Uses a temp dir + overridden state files to avoid touching live state.
    _td="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
    trap 'rm -rf "$_td"' EXIT
    _flag="$_td/.revive-starving"
    _fcnt="$_td/.revive-fails"
    _save="$_td/.revive-exitnode"
    # Write a mini-script that sources the real functions but overrides globals + internet_up
    cat > "$_td/test_revive.sh" <<'TESTEOF'
#!/usr/bin/env bash
set -uo pipefail
# Source the real script's functions by defining them inline (extracted from mesh-revive)
PROBES=(1.1.1.1 8.8.8.8 9.9.9.9)
THRESHOLD="${MESH_REVIVE_THRESHOLD:-3}"
FLAG="${1:-}"
FAIL_CNT="${2:-}"
REVIVE_EXITNODE_SAVE="${3:-}"
note(){ :; }  # suppress output in test
alert(){ :; }
alert_sms(){ :; }
# Mock: always fail
internet_up(){ return 1; }
heal(){ :; }  # don't actually heal in test
restore_exitnode(){ :; }
# --- cycle function (copied from mesh-revive) ---
cycle(){
  if internet_up; then
    restore_exitnode
    rm -f "$FLAG" "$FAIL_CNT" 2>/dev/null
    return 0
  fi
  local n=0
  [ -f "$FAIL_CNT" ] && n="$(cat "$FAIL_CNT" 2>/dev/null || echo 0)"
  n=$((n + 1))
  echo "$n" > "$FAIL_CNT"
  if [ "$n" -lt "$THRESHOLD" ]; then
    return 1
  fi
  heal
  return 0
}
# --- Test 1: fail counter increments below threshold ---
rm -f "$FLAG" "$FAIL_CNT"
cycle; cycle  # 2 fails, threshold=3 → should NOT trigger heal
n="$(cat "$FAIL_CNT")"
[ "$n" = "2" ] || { echo "FAIL: fail counter got $n, want 2"; exit 1; }
[ ! -f "$FLAG" ] || { echo "FAIL: flag set before threshold"; exit 1; }
# --- Test 2: third fail reaches threshold ---
cycle  # 3rd fail → threshold reached
n="$(cat "$FAIL_CNT")"
[ "$n" = "3" ] || { echo "FAIL: fail counter got $n, want 3"; exit 1; }
# --- Test 3: recovery clears counter and flag ---
internet_up(){ return 0; }  # now succeeds
touch "$FLAG"
cycle  # should clear everything
[ ! -f "$FAIL_CNT" ] || { echo "FAIL: fail counter not cleared on recovery"; exit 1; }
[ ! -f "$FLAG" ] || { echo "FAIL: flag not cleared on recovery"; exit 1; }
echo "PASS"
TESTEOF
    chmod +x "$_td/test_revive.sh"
    _result="$(THRESHOLD=3 bash "$_td/test_revive.sh" "$_flag" "$_fcnt" "$_save" 2>&1)"
    case "$_result" in
      *PASS) ;;
      *)     echo "smoke-test: FAIL ($_result)"; exit 1 ;;
    esac
    # TEST-SANDBOX gate: drive THIS script's real --check to the heal threshold and assert the
    # substrate is untouched. Deliberately drives "$0", not the copied cycle() fixture above — a
    # fixture that reimplements the function cannot witness the actuator. Starvation is forced by
    # shimming curl+ping to fail, so the gate asserts the same thing on a healthy node as on a
    # starving one (never vacuous: without the shims this node's live internet returns early and
    # heal() is never reached). The tailscale shim is the oracle — an independent mechanism the
    # code under test cannot satisfy by claiming success. Anchored on HOME, not PATH: the shim dir
    # is $sb/.local/bin precisely because wrappers re-export PATH="$HOME/.local/bin:$PATH"
    # (mesh-selfcare:18) and would otherwise shadow a PATH-prepended shim.
    _sb="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
    trap 'rm -rf "$_td" "$_sb"' EXIT
    mkdir -p "$_sb/.local/bin" "$_sb/.mesh"
    printf '#!/usr/bin/env bash\nexit 1\n' > "$_sb/.local/bin/curl"
    printf '#!/usr/bin/env bash\nexit 1\n' > "$_sb/.local/bin/ping"
    cat > "$_sb/.local/bin/tailscale" <<EOF
#!/usr/bin/env bash
echo "\$*" >> "$_sb/ts-calls.log"
[ "\${1:-}" = status ] && [ "\${2:-}" = --json ] && echo '{"ExitNodeStatus":{"TailscaleIPs":["100.83.12.34/32"]}}'
exit 0
EOF
    chmod +x "$_sb/.local/bin/curl" "$_sb/.local/bin/ping" "$_sb/.local/bin/tailscale"
    : > "$_sb/ts-calls.log"
    HOME="$_sb" MESH_TEST_SANDBOX=1 MESH_REVIVE_THRESHOLD=1 PATH="$_sb/.local/bin:$PATH" \
      bash "$0" --check >/dev/null 2>&1
    # (a) the actuator must have been REACHED — else the gate proves nothing (threshold=1 + a
    #     failing internet_up means cycle() ran heal(); status --json is heal()'s own exit-node read)
    grep -qE '^(up|set --exit-node|status --json)' "$_sb/ts-calls.log" && {
      echo "smoke-test: FAIL (MESH_TEST_SANDBOX gate broken: --check touched tailscale [$(tr '\n' ';' < "$_sb/ts-calls.log")] — a smoke-sweep must never change the substrate)"; exit 1; }
    # (b) the suppression must be VISIBLE, not silent, and it must be heal() that got suppressed
    _sup="$(HOME="$_sb" MESH_TEST_SANDBOX=1 MESH_REVIVE_THRESHOLD=1 PATH="$_sb/.local/bin:$PATH" bash "$0" --check 2>&1)"
    printf '%s' "$_sup" | grep -q 'heal SUPPRESSED' \
      || { echo "smoke-test: FAIL (sandboxed --check reached threshold but printed no heal-SUPPRESSED marker: ${_sup:0:120})"; exit 1; }
    # (c) unsandboxed, the SAME fixture must reach the actuator — proves (a) is the guard biting,
    #     not the shims/threshold failing to drive heal() at all (a green that means nothing).
    # env -u, not just a fresh HOME: mesh-doctor:166 EXPORTS MESH_TEST_SANDBOX=1 around this --test,
    # so the control child inherits it and heal() is suppressed for the wrong reason — the control
    # then fails against a healthy tool. (Caught live: bare `--test` green, doctor's `--test` red.)
    : > "$_sb/ts-calls.log"; rm -f "$_sb/.mesh/.revive-fails"
    env -u MESH_TEST_SANDBOX HOME="$_sb" MESH_REVIVE_THRESHOLD=1 PATH="$_sb/.local/bin:$PATH" bash "$0" --check >/dev/null 2>&1
    grep -qE '^up$' "$_sb/ts-calls.log" \
      || { echo "smoke-test: FAIL (control: an UNsandboxed --check at threshold did not reach heal() — the gate above is vacuous)"; exit 1; }
    # restore_exitnode() is the OTHER substrate actuator and the fixture above cannot reach it —
    # cycle() only calls it when internet_up SUCCEEDS, and the starvation shims force the opposite
    # branch. Two actuators, two paths: a guard driven at one call site is not a guard asserted at
    # both (mutation-checked — removing restore_exitnode's guard passed the starvation gate green).
    : > "$_sb/ts-calls.log"; rm -f "$_sb/.mesh/.revive-fails"
    printf '#!/usr/bin/env bash\nexit 0\n' > "$_sb/.local/bin/curl"   # internet UP → the restore branch
    echo "100.83.12.34" > "$_sb/.mesh/.revive-exitnode"
    HOME="$_sb" MESH_TEST_SANDBOX=1 PATH="$_sb/.local/bin:$PATH" bash "$0" --check >/dev/null 2>&1
    grep -q 'set --exit-node=100.83.12.34' "$_sb/ts-calls.log" && {
      echo "smoke-test: FAIL (MESH_TEST_SANDBOX gate broken: --check restored an exit-node [$(tr '\n' ';' < "$_sb/ts-calls.log")] — a smoke-sweep must never change the substrate)"; exit 1; }
    # control: unsandboxed, the same fixture MUST reach the restore — else the assert above is vacuous
    : > "$_sb/ts-calls.log"; echo "100.83.12.34" > "$_sb/.mesh/.revive-exitnode"
    env -u MESH_TEST_SANDBOX HOME="$_sb" PATH="$_sb/.local/bin:$PATH" bash "$0" --check >/dev/null 2>&1
    grep -q 'set --exit-node=100.83.12.34' "$_sb/ts-calls.log" \
      || { echo "smoke-test: FAIL (control: an UNsandboxed --check did not restore the saved exit-node — the restore gate above is vacuous)"; exit 1; }
    echo "smoke-test: ok (threshold counter + recovery logic + MESH_TEST_SANDBOX substrate-suppression gate on BOTH actuators (heal + exit-node restore), each w/ a reached-actuator control)"; exit 0 ;;
  --loop) iv="${2:-60}"; note "watching every ${iv}s (threshold=${THRESHOLD})"
          while true; do cycle; sleep "$iv"; done ;;
  ""|--check) cycle ;;
  *) echo "usage: mesh-revive [--check | --loop [sec]]   MESH_REVIVE_THRESHOLD (default 3)" >&2; exit 1 ;;
esac
