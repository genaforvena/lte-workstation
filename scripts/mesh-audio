#!/usr/bin/env bash
# mesh-audio — probe audio input/output capability on this node.
# smoke-test: --test checks /dev/snd/ accessible
#
# Read-only: lists ALSA capture/playback devices, pipewire/pulse status,
# group membership, and the raw device nodes. Does NOT record or play.
#
#   mesh-audio              compact one-line summary
#   mesh-audio --verbose    detailed device listing
#   mesh-audio --test       smoke test (exit 0 if /dev/snd/ exists)
set -uo pipefail

if [ "${1:-}" = --test ]; then
  [ -d /dev/snd ] && echo "smoke-test: ok" && exit 0 || { echo "smoke-test: FAIL (no /dev/snd)"; exit 1; }
fi

HOST="$(hostname)"; ts="$(date -u +%FT%TZ)"
in_audio=0; id -nG 2>/dev/null | grep -qw audio && in_audio=1
has_pulse=0; command -v pactl >/dev/null 2>&1 && has_pulse=1
has_pipewire=0; command -v pipewire >/dev/null 2>&1 && has_pipewire=1

# Count capture + playback ALSA devices
capture=0; playback=0
for d in /dev/snd/pcm*; do
  [ -c "$d" ] || continue
  case "$d" in *c) capture=$((capture+1)) ;; *p) playback=$((playback+1)) ;; esac
done

# List card names
cards=""
for c in /proc/asound/card*/id; do
  [ -f "$c" ] && cards="$cards $(cat "$c" 2>/dev/null)"
done

if [ "${1:-}" = --verbose ]; then
  echo "=== mesh-audio @ $ts — $HOST ==="
  echo "cards:${cards}"
  echo "capture_devices: $capture"
  echo "playback_devices: $playback"
  echo "audio_group: $in_audio (1=member)"
  echo "pulseaudio: $has_pulse (1=found)"
  echo "pipewire: $has_pipewire (1=found)"
  echo "devices:"
  for d in /dev/snd/pcm*; do [ -c "$d" ] && echo "  $(basename "$d")"; done
  echo "ALSA capture:"
  command -v arecord >/dev/null 2>&1 && arecord -l 2>/dev/null | head -5 || echo "  (no arecord)"
  echo "ALSA playback:"
  command -v aplay >/dev/null 2>&1 && aplay -l 2>/dev/null | head -5 || echo "  (no aplay)"
else
  echo "$ts  $HOST  capture=$capture  playback=$playback  audio_group=$in_audio  cards=[${cards# }]"
fi

exit 0
