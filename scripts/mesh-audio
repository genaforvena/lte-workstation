#!/usr/bin/env bash
# mesh-audio — probe audio input/output capability on this node.
# smoke-test: --test checks /dev/snd/ accessible
#
# Read-only: lists ALSA capture/playback devices, pipewire/pulse status,
# group membership, and the raw device nodes. Does NOT record or play.
#
#   mesh-audio              compact one-line summary
#   mesh-audio --verbose    detailed device listing
#   mesh-audio --test       smoke test (exit 0 if /dev/snd/ exists)
set -uo pipefail

if [ "${1:-}" = --test ]; then
  command -v hostname >/dev/null 2>&1 || { echo "smoke-test: FAIL (no hostname)"; exit 1; }
  command -v id >/dev/null 2>&1 || { echo "smoke-test: FAIL (no id)"; exit 1; }
  found=0
  for d in /dev/snd/pcm*; do
    [ -c "$d" ] || continue
    found=1
    break
  done
  # ABSENT vs BROKEN. /dev/snd exists on a cardless box too (seq+timer are always there), so
  # "no pcm nodes" alone cannot tell a machine with no sound hardware from one whose driver
  # died. The card layer is the discriminator: no /proc/asound at all, or an asound that
  # enumerated no soundcard, means there is no organ here and nothing that could produce —
  # that is rc 2 (n/a), NOT a fault. A card the kernel DID enumerate with no pcm node behind
  # it is a real break and stays FAIL. Reported as FAIL, this made every audio-less node
  # (phaedra) permanently red and dragged mesh-sensorium's whole suite down with it.
  cards=""; [ -r /proc/asound/cards ] && cards="$(cat /proc/asound/cards 2>/dev/null)"
  has_card=0
  case "$cards" in ''|*'no soundcards'*) has_card=0 ;; *) has_card=1 ;; esac
  if [ "$found" -eq 0 ] && [ "$has_card" -eq 0 ]; then
    echo "smoke-test: n/a — no audio organ on $(hostname 2>/dev/null || echo this node) (no pcm device node and no soundcard in /proc/asound/cards$([ -d /proc/asound ] || echo '; /proc/asound absent')). Tool fixtures passed."
    exit 2
  fi
  [ -d /dev/snd ] || { echo "smoke-test: FAIL (no /dev/snd)"; exit 1; }
  [ "$found" -eq 1 ] || { echo "smoke-test: FAIL (no pcm device nodes while /proc/asound/cards enumerates a card — the organ is present and its nodes are missing)"; exit 1; }
  [ -r /proc/asound/cards ] || { echo "smoke-test: FAIL (no readable /proc/asound/cards)"; exit 1; }
  echo "smoke-test: ok"; exit 0
fi

HOST="$(hostname)"; ts="$(date -u +%FT%TZ)"
in_audio=0; id -nG 2>/dev/null | grep -qw audio && in_audio=1
has_pulse=0; command -v pactl >/dev/null 2>&1 && has_pulse=1
has_pipewire=0; command -v pipewire >/dev/null 2>&1 && has_pipewire=1

# Count capture + playback ALSA devices
capture=0; playback=0
for d in /dev/snd/pcm*; do
  [ -c "$d" ] || continue
  case "$d" in *c) capture=$((capture+1)) ;; *p) playback=$((playback+1)) ;; esac
done

# List card names
cards=""
for c in /proc/asound/card*/id; do
  [ -f "$c" ] && cards="$cards $(cat "$c" 2>/dev/null)"
done

if [ "${1:-}" = --verbose ]; then
  echo "=== mesh-audio @ $ts — $HOST ==="
  echo "cards:${cards}"
  echo "capture_devices: $capture"
  echo "playback_devices: $playback"
  echo "audio_group: $in_audio (1=member)"
  echo "pulseaudio: $has_pulse (1=found)"
  echo "pipewire: $has_pipewire (1=found)"
  echo "devices:"
  for d in /dev/snd/pcm*; do [ -c "$d" ] && echo "  $(basename "$d")"; done
  echo "ALSA capture:"
  command -v arecord >/dev/null 2>&1 && arecord -l 2>/dev/null | head -5 || echo "  (no arecord)"
  echo "ALSA playback:"
  command -v aplay >/dev/null 2>&1 && aplay -l 2>/dev/null | head -5 || echo "  (no aplay)"
else
  echo "$ts  $HOST  capture=$capture  playback=$playback  audio_group=$in_audio  cards=[${cards# }]"
fi

exit 0
