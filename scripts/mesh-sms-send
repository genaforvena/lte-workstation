#!/usr/bin/env bash
# mesh-sms-send — SMS actuator: send an SMS via the phone body.
# Consent-gated: requires MESH_SMS_CONSENT=1 env var or --force flag.
# Logs the send event to ~/.mesh/traces.log.
#
#   mesh-sms-send <number> <message…>
#   MESH_SMS_CONSENT=1 mesh-sms-send +1234567890 "hello"
#   mesh-sms-send --force +1234567890 "hello"
#   mesh-sms-send --test             smoke test (deps + phone reachability, no SMS sent)
#
# Phone is registry-resolved (~/.mesh/nodes / PHONE_IP env var / LAN fallback).
# Exit 2 = phone unreachable (n/a, not a failed send — honest-organ contract).
# Exit 3 = consent not given.
set -euo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes" 2>/dev/null || true

PHONE_PORT="${PHONE_SSH_PORT:-8022}"

if [ "${1:-}" = --test ]; then
  command -v ssh >/dev/null 2>&1 || { echo "smoke-test: FAIL (no ssh)"; exit 1; }
  pip="${PHONE_IP:-$(mesh-peer-addr Redmi 2>/dev/null || mesh-peer-addr redmi 2>/dev/null || true)}"
  [ -n "$pip" ] || { echo "smoke-test: n/a (no phone in registry)"; exit 2; }
  timeout 10 ssh -p "$PHONE_PORT" -o BatchMode=yes -o ConnectTimeout=6 \
    -o StrictHostKeyChecking=accept-new "${PHONE_USER:-u0_a386}@$pip" \
    'command -v termux-sms-send' </dev/null >/dev/null 2>&1 \
    || { echo "smoke-test: n/a (phone unreachable or termux-sms-send missing)"; exit 2; }
  echo "smoke-test: ok (no SMS sent in --test mode)"; exit 0
fi

# parse flags and positional args
FORCE=0
NUMBER=""
MSG_PARTS=()
for arg in "$@"; do
  case "$arg" in
    --force) FORCE=1;;
    --test)  ;; # handled above
    *)
      if [ -z "$NUMBER" ]; then
        NUMBER="$arg"
      else
        MSG_PARTS+=("$arg")
      fi;;
  esac
done

[ -n "$NUMBER" ] || { echo "usage: mesh-sms-send [--force] <number> <message…>" >&2; exit 1; }
[ "${#MSG_PARTS[@]}" -gt 0 ] || { echo "usage: mesh-sms-send [--force] <number> <message…>" >&2; exit 1; }
MESSAGE="${MSG_PARTS[*]}"

# consent gate
if [ "$FORCE" != 1 ] && [ "${MESH_SMS_CONSENT:-}" != "1" ]; then
  echo "SMS not sent — set MESH_SMS_CONSENT=1 or use --force" >&2
  exit 3
fi

# resolve phone IP
pip="${PHONE_IP:-$(mesh-peer-addr Redmi 2>/dev/null || mesh-peer-addr redmi 2>/dev/null || true)}"
if [ -z "$pip" ]; then
  for try_ip in ${PHONE_LAN_IPS:-}; do  # gitignored ~/.mesh/nodes; no LAN IPs in public genome
    if timeout 6 ssh -p "$PHONE_PORT" -o BatchMode=yes -o ConnectTimeout=4 \
       -o StrictHostKeyChecking=accept-new \
       "${PHONE_USER:-u0_a386}@${try_ip}" 'echo ok' </dev/null >/dev/null 2>&1; then
      pip="$try_ip"; break
    fi
  done
fi
[ -n "$pip" ] || { echo "phone unreachable — SMS NOT sent (n/a)" >&2; exit 2; }

PUSER="${PHONE_USER:-u0_a386}"

# escape message for safe remote shell single-quoting: replace ' with '\''
esc_msg="$(printf '%s' "$MESSAGE" | sed "s/'/'\\\\''/g")"
esc_num="$(printf '%s' "$NUMBER" | sed "s/'/'\\\\''/g")"

rc=0
timeout 30 ssh -p "$PHONE_PORT" -o BatchMode=yes -o ConnectTimeout=8 \
  -o StrictHostKeyChecking=accept-new "${PUSER}@${pip}" \
  "termux-sms-send -n '${esc_num}' '${esc_msg}'" </dev/null || rc=$?

if [ $rc -eq 124 ] || [ $rc -eq 255 ]; then
  echo "phone unreachable during send — SMS NOT sent (n/a)" >&2; exit 2
fi

if [ $rc -ne 0 ]; then
  echo "termux-sms-send returned rc=$rc — SMS may not have been sent" >&2; exit 1
fi

# log to trace
msglen="${#MESSAGE}"
[ -x "$HOME/.local/bin/mesh-trace" ] && \
  MESH_WHO="mesh-sms-send@$(hostname)" "$HOME/.local/bin/mesh-trace" \
  "[sms-sent] to=${NUMBER} len=${msglen}" >/dev/null 2>&1 || true

echo "[sms-sent] to=${NUMBER} len=${msglen}"
