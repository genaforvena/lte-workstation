#!/usr/bin/env bash
# reflex-cadence: */15 * * * *
# mesh-link-duplex — negotiated physical-NIC duplex sense.
#
# Reads the kernel's live /sys/class/net/<iface>/duplex value for a non-loopback interface
# with a device backing it. Carrier and link speed are separate signals; duplex tells whether
# the negotiated physical link is full or half duplex. No readable physical duplex file means
# UNKNOWN and exit 2 — never infer full duplex from carrier or speed.
#
# Usage: mesh-link-duplex | mesh-link-duplex --json | mesh-link-duplex --test
set -u
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

MESH="${MESH_DIR:-$HOME/.mesh}"
ROOT="${MESH_LINK_DUPLEX_ROOT:-/sys/class/net}"
STATE="${MESH_LINK_DUPLEX_STATE:-$MESH/.link-duplex-state}"

read_duplex() {
  local root="${MESH_LINK_DUPLEX_ROOT:-$ROOT}" d iface value
  for d in "$root"/*; do
    [ -d "$d" ] || continue
    iface="${d##*/}"
    [ "$iface" != lo ] || continue
    [ -e "$d/device" ] || continue
    [ -r "$d/duplex" ] || continue
    value="$(tr -d '[:space:]' <"$d/duplex" 2>/dev/null || true)"
    case "$value" in
      full|half) printf '%s\t%s\n' "$iface" "$value"; return 0 ;;
    esac
  done
  return 1
}

render() {
  local iface="$1" duplex="$2" now
  now="$(date -u +%FT%TZ)"
  if [ "${MODE:-}" = --json ]; then
    printf '{"interface":"%s","duplex":"%s","ts":"%s"}\n' "$iface" "$duplex" "$now"
  else
    printf '[link-duplex] %s — interface=%s duplex=%s\n' "$(printf '%s' "$duplex" | tr '[:lower:]' '[:upper:]')" "$iface" "$duplex"
  fi
}

if [ "${1:-}" = --test ]; then
  td="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
  trap 'rm -rf "$td"' EXIT
  mkdir -p "$td/eth0/device" "$td/lo/device"
  printf 'full\n' >"$td/eth0/duplex"
  printf 'unknown\n' >"$td/lo/duplex"
  got="$(MESH_LINK_DUPLEX_ROOT="$td" read_duplex)" || { echo "smoke-test: FAIL (fixture read)"; exit 1; }
  [ "$got" = $'eth0\tfull' ] || { echo "smoke-test: FAIL (fixture selected [$got])"; exit 1; }

  empty="$td/empty"; mkdir -p "$empty/no-device"; printf 'full\n' >"$empty/no-device/duplex"
  if MESH_LINK_DUPLEX_ROOT="$empty" read_duplex >/dev/null 2>&1; then
    echo "smoke-test: FAIL (interface without device was accepted)"; exit 1
  fi

  live="$(MESH_LINK_DUPLEX_ROOT=/sys/class/net read_duplex 2>/dev/null)" || {
    echo "smoke-test: n/a (no readable physical-NIC duplex file on $(hostname))" >&2
    exit 2
  }
  iface="${live%%$'\t'*}"; duplex="${live##*$'\t'}"
  case "$iface:$duplex" in
    *:full|*:half) echo "smoke-test: ok (fixture + REAL duplex read: interface=$iface duplex=$duplex)"; exit 0 ;;
    *) echo "smoke-test: FAIL (malformed live duplex row: $live)"; exit 1 ;;
  esac
fi

MODE="${1:-}"
case "$MODE" in ''|--json) ;; *) echo "usage: mesh-link-duplex [--json|--test]" >&2; exit 1 ;; esac
live="$(read_duplex 2>/dev/null)" || {
  mkdir -p "$(dirname "$STATE")" 2>/dev/null || true
  printf 'UNKNOWN|no-readable-physical-duplex\n' >"$STATE" 2>/dev/null || true
  echo "mesh-link-duplex: no readable physical-NIC duplex file — UNKNOWN" >&2
  exit 2
}
iface="${live%%$'\t'*}"; duplex="${live##*$'\t'}"
mkdir -p "$(dirname "$STATE")" 2>/dev/null || true
printf 'duplex=%s interface=%s\n' "$duplex" "$iface" >"$STATE"
render "$iface" "$duplex"
