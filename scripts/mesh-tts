#!/usr/bin/env bash
# mesh-tts — speak TEXT in a natural (Piper neural) voice, on this node or another.
# Offline, on-device. Falls back to spd-say if Piper or the voice isn't usable.
#
#   mesh-tts ryan "hello there"                  # speak locally, ryan voice
#   mesh-tts amy  "and a reply" <ts-ip>   # synth here, play on that node's speakers
set -uo pipefail

# Players are defined ABOVE the --test dispatch so the test drives THESE functions, not a copy of
# them. MESH_TTS_ALSA_DEV picks the ALSA device (`null` = a real aplay run that emits nothing —
# what --test uses to exercise the player without speaking into the room at 03:00).
play_local() {
    aplay -q ${MESH_TTS_ALSA_DEV:+-D "$MESH_TTS_ALSA_DEV"} "$1" 2>/dev/null || paplay "$1" 2>/dev/null
}
play_remote() {  # $1 = local wav
    scp -q -o BatchMode=yes -o ConnectTimeout=8 "$1" "$MESH_TTS_USER_R:/tmp/mesh-tts.wav" 2>/dev/null \
      && ssh -o BatchMode=yes -o ConnectTimeout=8 "$MESH_TTS_USER_R" \
           'export XDG_RUNTIME_DIR=/run/user/$(id -u); pw-play /tmp/mesh-tts.wav 2>/dev/null || paplay /tmp/mesh-tts.wav 2>/dev/null || aplay -q /tmp/mesh-tts.wav 2>/dev/null' 2>/dev/null
}

# --test honestly verifies a WORKING TTS path (the primitive mesh-say + operator-speech delegate to):
# SYNTHESIZE a one-word sample to a throwaway /tmp file and validate it (>1KB), never PLAY aloud /
# send. A mere `-x piper` smoke-greened a present-but-BROKEN piper (missing lib/arch/voice) — and also
# wrongly FAILed when piper was absent though spd-say is the documented fallback. Honest outcomes:
# piper synth works → ok · piper present-but-broken + no spd-say → FAIL · spd-say fallback → ok ·
# no engine at all → n/a (exit 2, node has no speech role, not a defect).
if [ "${1:-}" = --test ]; then
  # PLAY gates first — this is the half that was missing, and mesh-doctor only ever runs `--test`,
  # so leaving them in a separate flag would have left the reported defect ungated in practice.
  # ~9s, inside mesh-autowire's 30s test budget. n/a (no aplay / no null device / voice gate
  # suppressed) does NOT fail the tool — it means this node cannot assert the play path, which is
  # a fact about the node, not a defect.
  _pout="$("$0" --test-play 2>&1)"; _prc=$?
  case "$_prc" in
    1) printf '%s\n' "$_pout"; echo "smoke-test: FAIL (play path)"; exit 1 ;;
    2) _play_note=" (play path n/a: $(printf '%s' "$_pout" | tail -1))" ;;
    *) _play_note=" + play path asserted" ;;
  esac
  # SYNTH-side gate, dispatched here for the same reason the play gate is: mesh-doctor only ever
  # runs `--test`, so a gate left behind its own flag is a gate nothing runs.
  _cout="$("$0" --test-clone 2>&1)"; _crc=$?
  case "$_crc" in
    1) printf '%s\n' "$_cout"; echo "smoke-test: FAIL (clone rc branch)"; exit 1 ;;
    2) _play_note="$_play_note (clone rc branch n/a: $(printf '%s' "$_cout" | tail -1))" ;;
    *) _play_note="$_play_note + clone rc branch asserted" ;;
  esac
  _P="$HOME/.mesh/piper/piper/piper"; _V="$HOME/.mesh/piper/voices"; _piper_seen=0
  if [ -x "$_P" ]; then
    _piper_seen=1; _vm="$(ls "$_V"/*.onnx 2>/dev/null | head -1)"
    if [ -n "$_vm" ]; then
      _tw="$(mktemp "${TMPDIR:-/tmp}"/mtts-test-XXXXXX.wav)"
      printf 'тест\n' | "$_P" -m "$_vm" -f "$_tw" >/dev/null 2>&1
      { [ -s "$_tw" ] && [ "$(stat -c%s "$_tw" 2>/dev/null || echo 0)" -gt 1000 ]; } && { rm -f "$_tw"; echo "smoke-test: ok (piper: $(basename "$_vm" .onnx))$_play_note"; exit 0; }
      rm -f "$_tw"
    fi
  fi
  command -v spd-say >/dev/null 2>&1 && { echo "smoke-test: ok (spd-say fallback)$_play_note"; exit 0; }
  [ "$_piper_seen" = 1 ] && { echo "smoke-test: FAIL (piper present but produced no audio + no spd-say fallback)"; exit 1; }
  echo "smoke-test: n/a (no TTS engine on this node)"; exit 2
fi

# --test-play: assert the PLAY path, which the synth-only test above never touched — the whole
# defect discover reported (played=1 from the wav's SIZE, player rc discarded) lived in a branch
# no gate exercised. Silent: real aplay against ALSA's `null` device, never the speakers.
if [ "${1:-}" = --test-play ]; then
  fail(){ echo "TEST FAIL: $*"; exit 1; }
  # Same leak class as --test-clone below (this file had ZERO traps): every exit path here had to
  # remember its own `rm`, and a signal — or the next `fail` added without one — left $_tw and the
  # $_stub PATH-shim dir behind. No accept-loop server in this block, so a guarded rm is enough.
  _tw=""; _stub=""
  _tp_cleanup(){ [ -n "${_tw:-}" ] && rm -f "$_tw"; [ -n "${_stub:-}" ] && rm -rf "$_stub"; return 0; }
  trap '_tp_cleanup' EXIT
  trap '_tp_cleanup; exit 130' INT
  trap '_tp_cleanup; exit 143' TERM
  trap '_tp_cleanup; exit 129' HUP
  command -v aplay >/dev/null 2>&1 || { echo "smoke-test: n/a (no aplay on this node)"; exit 2; }
  aplay -L 2>/dev/null | grep -q '^null' || { echo "smoke-test: n/a (no ALSA null device to play into)"; exit 2; }
  _tw="$(mktemp "${TMPDIR:-/tmp}"/mtts-play-XXXXXX.wav)"
  # a real, valid wav — a truncated one would fail for the wrong reason
  ffmpeg -hide_banner -loglevel error -y -f lavfi -i "sine=frequency=440:duration=0.2" \
         -ar 22050 -ac 1 "$_tw" 2>/dev/null || { rm -f "$_tw"; echo "smoke-test: n/a (no ffmpeg to build a fixture)"; exit 2; }

  echo "gate 1: play_local SUCCEEDS on a real silent device and reports rc 0"
  MESH_TTS_ALSA_DEV=null play_local "$_tw"; _rc=$?
  [ "$_rc" = 0 ] || { rm -f "$_tw"; fail "play_local into the null device should be rc 0, got $_rc"; }

  echo "gate 2: play_local FAILS on a bad device and reports it — the rc must be readable"
  # paplay is play_local's second arm; neutralise it so this asserts the aplay arm's failure and
  # not whether a PulseAudio server happens to be up on the test node.
  _stub="$(mktemp -d "${TMPDIR:-/tmp}"/mtts-stub-XXXXXX)"; printf '#!/bin/sh\nexit 7\n' > "$_stub/paplay"
  chmod +x "$_stub/paplay"
  MESH_TTS_ALSA_DEV=mesh-tts-no-such-device PATH="$_stub:$PATH" play_local "$_tw"; _rc=$?
  [ "$_rc" != 0 ] || { rm -rf "$_tw" "$_stub"; fail "play_local into a bogus device must NOT report rc 0"; }

  # THE TEST MUST NOT EAT THE CLONE DAEMON'S ADMISSION BUDGET. Gates 3+4 each drive the WHOLE
  # script, and the whole script synthesizes through mesh-voice-say → the warm clone daemon. Those
  # two drives were this node's entire «тест» clone load (197 of 198 synths in 24h were the fixture,
  # exactly 1 was a real utterance): under mesh-doctor's parallel `37 * * * *` sweep they filled
  # MESH_CLONE_MAXDEPTH=3, refused EACH OTHER (`BUSY refused at depth 3/3` with no live traffic in
  # flight at 16:38:28), and left the daemon grinding synths for clients that had already gone
  # (`abandoned in queue after 19.26s (client gone)`). Cost of that: any REAL utterance landing in
  # the sweep window gets rc=8, and mesh-voice-say --test's own live gate degrades to n/a exactly
  # when the daemon is busiest — a gate that goes quiet under load. Same fix mesh-note3-say took
  # (2ed5b25 comment at its :166): the LIVE clone path is mesh-voice-say --test's gate to assert,
  # not ours; what WE are gating here is the PLAYER. So stub the synth with a fixture wav — it costs
  # zero admission, and it makes gates 3+4 node-independent (they no longer need piper OR a live
  # daemon to produce a wav). Serialization was the other candidate and is worse: sharing one slot
  # would make mesh-voice-say --test WAIT behind us, i.e. lengthen the very hold that starves it.
  _vsmark="$_stub/mesh-voice-say-ran"
  printf '#!/bin/sh\ntouch %s\ncp %s "$2" 2>/dev/null\nexit 0\n' "$_vsmark" "$_tw" > "$_stub/mesh-voice-say"
  chmod +x "$_stub/mesh-voice-say"

  echo "gate 3: a PLAYBACK failure falls through to the fallback (the regression itself)"
  # Drive the whole script with a player that cannot succeed and a stubbed spd-say that records
  # that it ran. Before the fix, played=1 was set from the wav's size and this marker never appeared.
  _mark="$_stub/spd-say-ran"
  printf '#!/bin/sh\ntouch %s\nexit 0\n' "$_mark" > "$_stub/spd-say"; chmod +x "$_stub/spd-say"
  # MESH_CLONE_SOCK points at a path that cannot exist: belt-and-braces, so that even a drive which
  # somehow bypassed the PATH stub still cannot reach the live daemon from inside a test.
  _err="$(MESH_TTS_ALSA_DEV=mesh-tts-no-such-device PATH="$_stub:$PATH" \
            MESH_CLONE_SOCK="$_stub/no-such-clone.sock" \
            "$0" ryan "тест" 2>&1 >/dev/null)"; _src=$?
  case "$_err" in
    *"suppressed"*) rm -rf "$_tw" "$_stub"; echo "smoke-test: n/a (voice gate suppressed the test utterance)"; exit 2 ;;
  esac
  [ -f "$_vsmark" ] || { rm -rf "$_tw" "$_stub"
    fail "the test's synth must go to the stub, never to the live clone daemon — the stub was never called (stderr: $_err)"; }
  [ -f "$_mark" ] || { rm -rf "$_tw" "$_stub"
    fail "a failed playback must fall through to the fallback — spd-say never ran (stderr: $_err)"; }
  case "$_err" in
    *"PLAYBACK failed"*) ;;
    *) rm -rf "$_tw" "$_stub"
       fail "the failure must be named as PLAYBACK, not left to read as synthesis (stderr: $_err)" ;;
  esac
  [ "$_src" = 0 ] || { rm -rf "$_tw" "$_stub"; fail "fallback succeeded, so exit must be 0 (got $_src)"; }

  echo "gate 4: nothing played at all is a NON-ZERO exit, not a silent success"
  printf '#!/bin/sh\nexit 1\n' > "$_stub/spd-say"; chmod +x "$_stub/spd-say"
  rm -f "$_vsmark"   # re-assert per DRIVE: one marker left by gate 3 would green a gate-4 daemon call
  MESH_TTS_ALSA_DEV=mesh-tts-no-such-device PATH="$_stub:$PATH" \
    MESH_CLONE_SOCK="$_stub/no-such-clone.sock" "$0" ryan "тест" >/dev/null 2>&1
  _src=$?
  [ -f "$_vsmark" ] || { rm -rf "$_tw" "$_stub"
    fail "gate 4's drive reached the live clone daemon instead of the stub"; }
  rm -rf "$_tw" "$_stub"
  [ "$_src" != 0 ] || fail "no player and no fallback must exit non-zero, got 0"

  echo "smoke-test: ok — play-rc readable, playback-failure falls through, nothing-played exits non-zero, zero clone admission consumed"
  exit 0
fi

# --test-clone: assert the SYNTH-SIDE rc branch — that a clone failure is NAMED on stderr and named
# CORRECTLY. The defect this gates: `if ! mesh-voice-say … 2>/dev/null` had no rc branch, so a
# SATURATED daemon (rc=8) and a DEAD one (rc=5) both produced exit 0 with empty stderr while the
# voice silently became piper's. A naive grep for "case" would pass a fix that still muted the wrong
# stream, so this drives the WHOLE script against a real socket that really refuses, and reads the
# stderr the operator would read. Both directions are asserted, because one canned string for every
# failure is the 07-18 voice-tx misdiagnosis this whole contract exists to prevent.
if [ "${1:-}" = --test-clone ]; then
  fail(){ echo "TEST FAIL: $*"; exit 1; }
  # FIXTURE REGISTRY + TRAP (task:voice-say-and-tts-tests-leak-accept-loop-servers) — the same bug
  # mesh-voice-say --test had, wearing a second name: the stub below ends in
  # `while True: c,_ = s.accept()` and this file had ZERO traps, so a SIGINT/SIGTERM (or any early
  # `exit` added between the spawn and the reap at the end of gate 1) left an immortal accept-loop
  # server plus its mktemp -d. `fail` exits 1, so it is exactly such an early exit. Explicit reaps
  # stay as the fast path but DEREGISTER, so cleanup can never kill a recycled pid.
  _fx_pids=" "; _fx_dirs=" "
  _fx_pid(){ _fx_pids="${_fx_pids}$1 "; }
  _fx_dir(){ _fx_dirs="${_fx_dirs}$1 "; }
  _fx_reap(){ kill "$1" 2>/dev/null; wait "$1" 2>/dev/null; _fx_pids="${_fx_pids/ $1 / }"; }
  _fx_rmdir(){ rm -rf "$1"; _fx_dirs="${_fx_dirs/ $1 / }"; }
  _fx_cleanup(){
    local _x
    for _x in $_fx_pids; do kill "$_x" 2>/dev/null; done
    for _x in $_fx_pids; do wait "$_x" 2>/dev/null; done
    for _x in $_fx_dirs; do rm -rf "$_x"; done
    _fx_pids=" "; _fx_dirs=" "
  }
  trap '_fx_cleanup' EXIT
  trap '_fx_cleanup; exit 130' INT
  trap '_fx_cleanup; exit 143' TERM
  trap '_fx_cleanup; exit 129' HUP
  command -v python3 >/dev/null 2>&1 || { echo "smoke-test: n/a (no python3 to stand up a refusing socket)"; exit 2; }
  command -v mesh-voice-say >/dev/null 2>&1 || { echo "smoke-test: n/a (no mesh-voice-say on this node)"; exit 2; }
  _cd="$(mktemp -d "${TMPDIR:-/tmp}"/mtts-clone-XXXXXX)"
  _fx_dir "$_cd"
  # spd-say is stubbed silent: on a node without piper the drive falls through to it, and a test
  # must never speak into the room. Playback goes to ALSA's null device for the same reason.
  printf '#!/bin/sh\nexit 0\n' > "$_cd/spd-say"; chmod +x "$_cd/spd-say"
  _drive(){ MESH_TTS_ALSA_DEV=null PATH="$_cd:$PATH" MESH_CLONE_SOCK="$1" \
              "$0" ryan "тест" 2>&1 >/dev/null; }

  echo "gate 1: a REFUSING daemon (BUSY = healthy but saturated) must be named as SATURATED"
  python3 - "$_cd/busy.sock" <<'PY' &
import socket, sys, threading
s = socket.socket(socket.AF_UNIX); s.bind(sys.argv[1]); s.listen(4)
def h(c):
    b = b""
    while b"\n" not in b:
        d = c.recv(65536)
        if not d: break
        b += d
    c.sendall(b"BUSY\t3/3\n"); c.close()
while True:
    c, _ = s.accept(); threading.Thread(target=h, args=(c,), daemon=True).start()
PY
  _bpid=$!
  _fx_pid "$_bpid"
  for _i in $(seq 30); do [ -S "$_cd/busy.sock" ] && break; sleep 0.1; done
  [ -S "$_cd/busy.sock" ] || { _fx_reap "$_bpid"; _fx_rmdir "$_cd"; echo "smoke-test: n/a (refusing-socket fixture never came up)"; exit 2; }
  _berr="$(_drive "$_cd/busy.sock")"
  _fx_reap "$_bpid"
  case "$_berr" in
    *"suppressed"*) _fx_rmdir "$_cd"; echo "smoke-test: n/a (voice gate suppressed the test utterance)"; exit 2 ;;
  esac
  case "$_berr" in
    *SATURATED*) ;;
    *) _fx_rmdir "$_cd"; fail "a refused clone must be NAMED on mesh-tts's own stderr — got: ${_berr:-<empty>}" ;;
  esac
  case "$_berr" in
    *UNREACHABLE*|*"clone-down"*) _fx_rmdir "$_cd"
      fail "a SATURATED daemon must not read as a dead one (the canned-hint trap): $_berr" ;;
  esac

  echo "gate 2: an UNREACHABLE daemon must read as a dead SERVICE, not as saturation"
  _uerr="$(_drive "$_cd/no-such.sock")"
  _fx_rmdir "$_cd"
  case "$_uerr" in
    *UNREACHABLE*) ;;
    *) fail "an unreachable daemon must be named as such — got: ${_uerr:-<empty>}" ;;
  esac
  case "$_uerr" in
    *SATURATED*) fail "a dead daemon must not read as saturation: $_uerr" ;;
  esac

  echo "smoke-test: ok — clone failure is named on stderr, and rc=8 and rc=5 are named differently"
  exit 0
fi
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes"
PIPER="$HOME/.mesh/piper/piper/piper"
VOICES="$HOME/.mesh/piper/voices"
VOICE="${1:?usage: mesh-tts <voice> <text> [node]}"
TEXT="${2:?text required}"
NODE="${3:-local}"
USER_R="${MESH_TTS_USER:-imozerov}"
export XDG_RUNTIME_DIR="/run/user/$(id -u)"

# FILLER-STRIP (operator 2026-07-05): strip leading thinking-fillers («Секунду, думаю» etc.)
# before synthesis. Filler-only → exit 0 (silence is the honest reply, never speak the filler).
TEXT="$(printf '%s' "$TEXT" | python3 -c '
import re,sys
t=sys.stdin.read()
F=re.compile(r"^\s*(так[,\s]*|секунд[ауоуочеек]*[,\s]*|секу(нд)?[ау]?[,\s]*|подумаю[,\s]*|думаю[,\s]*|щас[,\s]*|сейчас[,\s]*|момент[,\s]*|мгновенье[,\s]*|окей[,\s]*|ну[,\s]*|blip\b[,\s]*)+", re.IGNORECASE)
s=F.sub("",t).lstrip(" ,.—:—…").strip()
sys.stdout.write(s)
')"
[ -n "$TEXT" ] || { echo "mesh-tts: filler-only → suppressed (silence)" >&2; exit 0; }

# voice gate (operator 2026-06-24): suppress if the TARGET node is silenced/overheating. Local play →
# local gate; remote play → check the remote node over ssh. Fail-OPEN if the gate isn't installed.
if command -v mesh-voice-gate >/dev/null 2>&1; then
  if [ "$NODE" = local ]; then
    mesh-voice-gate || { echo "mesh-tts: suppressed (voice gate)" >&2; exit 0; }
  else
    mesh-voice-gate --node "$USER_R@$NODE" || { echo "mesh-tts: suppressed (voice gate on $NODE)" >&2; exit 0; }
  fi
fi

MESH_TTS_USER_R="$USER_R@$NODE"   # play_remote (defined above --test) reads this

played=0; synthesized=0; play_rc=0
WAV="$(mktemp "${TMPDIR:-/tmp}"/mesh-tts-XXXXXX.wav)"
# THE MESH SPEAKS IN THE OPERATOR'S OWN VOICE. Synthesize via the warm clone daemon (mesh-voice-say);
# synth is LOCAL even for remote playback (we scp the wav), so the clone works regardless of $NODE.
# Piper/ruslan is the LOUD fallback only when the clone daemon is down (silent slide to a generic
# voice is the trap). The positional VOICE arg ($1) now selects the piper FALLBACK voice only.
# AND SAY WHY, LOUDLY, BRANCHED ON THE DAEMON'S ACTUAL rc. This was the THIRD caller of the clone
# primitive and the only one with no rc branch at all: `if ! mesh-voice-say … 2>/dev/null` swallowed
# both the rc AND mesh-voice-say's own warning, so rc=8 (healthy but SATURATED) and rc=5 (daemon
# DOWN) were indistinguishable from success — mesh-tts exited 0 with EMPTY stderr while the voice the
# room hears silently changed from the operator's to piper/ruslan (reproduced twice, 2026-08-16
# 16:38/16:40). Its two siblings (mesh-note3-say, mesh-voice-tx) were fixed; this one was never
# asserted at — a rule asserted at one call site is not asserted.
if mesh-voice-say "$TEXT" "$WAV" 2>/dev/null; then :; else
    vs_rc=$?
    case "$vs_rc" in
      5) echo "mesh-tts: CLONE DAEMON UNREACHABLE → falling back to piper/$VOICE (fix mesh-voice-clone.service)" >&2;;
      8) echo "mesh-tts: clone REFUSED — daemon healthy but SATURATED (queue full at MESH_CLONE_MAXDEPTH); it answered in ms, so this is not a slow synth and not a dead service → piper/$VOICE fallback" >&2;;
      7) echo "mesh-tts: clone synth TIMEOUT on ${#TEXT}-char text — daemon busy/slow, NOT down; chunk the text or raise MESH_CLONE_TIMEOUT → piper/$VOICE fallback" >&2;;
      *) echo "mesh-tts: clone synth failed (rc=$vs_rc, not a daemon-down signal) → piper/$VOICE fallback" >&2;;
    esac
    [ -x "$PIPER" ] && [ -f "$VOICES/$VOICE.onnx" ] \
      && printf '%s\n' "$TEXT" | "$PIPER" -m "$VOICES/$VOICE.onnx" -f "$WAV" 2>/dev/null || true
fi
# `played` IS A CLAIM ABOUT THE PLAYER, NOT ABOUT THE FILE. It used to be set to 1 by reaching
# this branch at all — i.e. on the SYNTHESIZED WAV's SIZE — while play_local's rc was discarded.
# So a node whose player exits non-zero (no sink, no ALSA, ssh refused for a remote play) reported
# success, the spd-say fallback never fired (it is gated on played=0, which then meant only
# "synthesis failed"), and every caller inherited the false claim. Reported by discover 2026-07-24.
#
# HONEST LIMIT, stated because the fix is easy to over-read: an rc gate catches a player that
# FAILS. It cannot catch a sink that ACCEPTS the stream and emits nothing — on this very node
# `aplay -q` returns 0 with the audio stack hardware-dead. That is the [[bose-usb-sink-is-not-
# speaker-sounds]] case and it needs real audibility measurement (mesh-audible), not an exit code.
# played=1 therefore means "the player accepted it", which is strictly more than it used to mean
# and strictly less than "the room heard it".
if [ -s "$WAV" ] && [ "$(stat -c%s "$WAV" 2>/dev/null)" -gt 1000 ]; then
    synthesized=1
    if [ "$NODE" = local ]; then play_local "$WAV"; else play_remote "$WAV"; fi
    play_rc=$?
    [ "$play_rc" = 0 ] && played=1
fi
rm -f "$WAV"

fb_rc=0
if [ "$played" = 0 ]; then          # fallback: robotic but functional
    # Name WHICH stage failed — a playback failure that prints nothing reads as a synthesis
    # failure, and the two have completely different fixes.
    [ "$synthesized" = 1 ] && \
      echo "mesh-tts: synthesis ok but PLAYBACK failed (rc=$play_rc on $NODE) — trying spd-say" >&2
    SAFE_TEXT=$(printf '%s' "$TEXT" | tr -d "'\\\\\"")
    if [ "$NODE" = local ]; then
        timeout 30 spd-say -w "$SAFE_TEXT" 2>/dev/null
    else
        ssh -o BatchMode=yes -o ConnectTimeout=8 "$USER_R@$NODE" \
            "export XDG_RUNTIME_DIR=/run/user/\$(id -u); export PULSE_SERVER=unix:/run/user/\$(id -u)/pulse/native; timeout 30 spd-say -w \"$SAFE_TEXT\"" 2>/dev/null
    fi
    fb_rc=$?
    [ "$fb_rc" = 0 ] && played=1
fi

# Exit status is the claim callers read. Falling off the end with the last command's rc meant a
# node that played nothing could still exit 0.
if [ "$played" = 0 ]; then
    echo "mesh-tts: NOTHING PLAYED (synth=$synthesized, player rc=$play_rc, spd-say rc=$fb_rc)" >&2
    exit 1
fi
exit 0
