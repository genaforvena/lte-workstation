#!/usr/bin/env bash
# orphan-ok: on-demand loadavg poll — sampled (not continuous); loadavg changes per-second
#   under load, a polled sample is fine.
# mesh-loadavg — the kernel's LOAD-AVERAGE-TREND sense: a snapshot of /proc/loadavg (1/5/15 min).
#
# The Linux kernel exposes a 3-number moving average of run-queue depth:
#   load1  — 1-min exponentially-decayed average (most responsive to spikes)
#   load5  — 5-min smoothed (typical)
#   load15 — 15-min smoothed (sustained)
#
# A single number is ambiguous (high load1 = spike, or recovery? declining or already-declined?).
# The TREND across all three resolves that: load1>load5>load15 = rising; load1<load5<load15 = falling.
#
# Distinct from mesh-stress which reads load1 only and outputs a single CALM/BUSY/STALLED level.
# This tool reads all three averages and classifies the TREND (rising/falling/stable/spike) plus
# the relative load level (light/overloaded). The two axes together tell you:
#   "load is RISING but still LIGHT" = "spike that the system is absorbing"
#   "load is RISING and OVERLOADED" = "real problem, escalate"
#
# Classification (FALSIFIABLE via --test, priority order — change a threshold → tests flip):
#   OVERLOADED   load1 > 2*nproc   — system is running more than 2x its core count
#   SPIKE        load1 > load5 + load1 > 2*load5  — single-sample jump (recent spike)
#   RISING       load1 > load5 > load15  — sustained increase
#   FALLING      load1 < load5 < load15  — sustained decrease
#   STABLE       load1 ≈ load5 ≈ load15  — sustained steady
#   LIGHT        load1 < nproc/2  — system has plenty of capacity
#   UNKNOWN      /proc unreadable (defensive; never a faked "STABLE")
#
# Honest-exit contract:
#   0 = verdict produced (one of the bands above)
#   2 = /proc/loadavg missing or unreadable — never a fabricated load average
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
STATE="$HOME/.mesh/.loadavg-state"

# parse_loadavg <file> → echoes "l1 l5 l15" or returns 1
parse_loadavg() {
  local f="$1"
  [ -r "$f" ] || return 1
  # /proc/loadavg: "0.10 0.05 0.01 1/1366 7005" — first 3 fields are load1/load5/load15
  awk '{print $1, $2, $3}' "$f" 2>/dev/null
}

# classify_loadavg <l1> <l5> <l15> <nproc> → "LABEL|reason" — pure, offline-testable
classify_loadavg() {
  local l1="$1" l5="$2" l15="$3" nproc="$4"
  # Defensive: non-numeric
  if ! printf '%f' "$l1" >/dev/null 2>&1 || ! printf '%f' "$l5" >/dev/null 2>&1 || ! printf '%f' "$l15" >/dev/null 2>&1; then
    echo "UNKNOWN|non-numeric input (l1=$l1 l5=$l5 l15=$l15)"
    return
  fi
  if [ -z "$nproc" ] || [ "$nproc" -le 0 ] 2>/dev/null; then
    echo "UNKNOWN|nproc unavailable"
    return
  fi
  # OVERLOADED: load1 > 2*nproc
  local overload_thr=$(( nproc * 2 ))
  if [ "$(awk "BEGIN{print ($l1 > $overload_thr) ? 1 : 0}")" = "1" ]; then
    echo "OVERLOADED|l1=$l1 > 2*nproc=$overload_thr (system saturated)"
    return
  fi
  # SPIKE: load1 > load5 AND load1 > 2*load5 (sharp recent jump)
  if [ "$(awk "BEGIN{print ($l1 > $l5 && $l1 > 2*$l5) ? 1 : 0}")" = "1" ]; then
    echo "SPIKE|l1=$l1 > 2*l5=$(awk "BEGIN{print 2*$l5}") (recent sharp jump)"
    return
  fi
  # RISING: load1 > load5 > load15
  if [ "$(awk "BEGIN{print ($l1 > $l5 && $l5 > $l15) ? 1 : 0}")" = "1" ]; then
    echo "RISING|l1=$l1 > l5=$l5 > l15=$l15 (sustained increase)"
    return
  fi
  # FALLING: load1 < load5 < load15
  if [ "$(awk "BEGIN{print ($l1 < $l5 && $l5 < $l15) ? 1 : 0}")" = "1" ]; then
    echo "FALLING|l1=$l1 < l5=$l5 < l15=$l15 (sustained decrease)"
    return
  fi
  # LIGHT: load1 < nproc/2
  local light_thr
  light_thr="$(awk "BEGIN{print $nproc/2}")"
  if [ "$(awk "BEGIN{print ($l1 < $light_thr) ? 1 : 0}")" = "1" ]; then
    echo "LIGHT|l1=$l1 < nproc/2=$light_thr (plenty of capacity)"
    return
  fi
  # STABLE: load1 ≈ load5 ≈ load15 (no clear trend)
  echo "STABLE|l1=$l1 l5=$l5 l15=$l15 (no clear trend, nproc=$nproc)"
}

if [ "${1:-}" = --test ]; then
  fail=0
  # OVERLOADED: l1=20, nproc=8 → l1 > 2*8=16
  r="$(classify_loadavg 20 5 2 8)"
  echo "$r" | grep -q '^OVERLOADED' || { echo "  FAIL OVERLOADED l1=20 nproc=8: got=$r"; fail=1; }
  # OVERLOADED boundary: l1=16, nproc=8 → l1 = 2*8 = 16 (NOT overload, falls through to RISING).
  # l5=8, l15=2 so l1=16 > l5=8 > l15=2 → RISING (not SPIKE, since l1=16 NOT > 2*l5=16).
  r="$(classify_loadavg 16 8 2 8)"
  echo "$r" | grep -q '^RISING' || { echo "  FAIL OVERLOADED-boundary l1=16 nproc=8: got=$r (should fall through to RISING)"; fail=1; }
  # SPIKE: l1=10, l5=2, l15=1, nproc=8 → 10 < 2*8=16 (not OVERLOADED) AND 10>2 AND 10>2*2=4
  r="$(classify_loadavg 10 2 1 8)"
  echo "$r" | grep -q '^SPIKE' || { echo "  FAIL SPIKE l1=10 l5=2 nproc=8: got=$r"; fail=1; }
  # RISING: l1=4, l5=2, l15=1 (4 > 2 > 1)
  r="$(classify_loadavg 4 2 1 4)"
  echo "$r" | grep -q '^RISING' || { echo "  FAIL RISING l1=4 l5=2 l15=1: got=$r"; fail=1; }
  # FALLING: l1=1, l5=2, l15=4 (1 < 2 < 4)
  r="$(classify_loadavg 1 2 4 4)"
  echo "$r" | grep -q '^FALLING' || { echo "  FAIL FALLING l1=1 l5=2 l15=4: got=$r"; fail=1; }
  # STABLE: l1=2, l5=2, l15=2 (all equal)
  r="$(classify_loadavg 2 2 2 4)"
  echo "$r" | grep -q '^STABLE' || { echo "  FAIL STABLE l1=l5=l15=2: got=$r"; fail=1; }
  # LIGHT: l1=1, nproc=8 → 1 < 8/2=4
  r="$(classify_loadavg 1 1 1 8)"
  echo "$r" | grep -q '^LIGHT' || { echo "  FAIL LIGHT l1=1 nproc=8: got=$r"; fail=1; }
  # LIGHT boundary: l1=4, nproc=8 → 4 = 8/2 (NOT light, falls through to STABLE)
  r="$(classify_loadavg 4 4 4 8)"
  echo "$r" | grep -q '^STABLE' || { echo "  FAIL LIGHT-boundary l1=4: got=$r"; fail=1; }
  # Non-numeric: any non-numeric
  r="$(classify_loadavg abc 1 1 4)"
  echo "$r" | grep -q '^UNKNOWN' || { echo "  FAIL UNKNOWN-nonnumeric: got=$r"; fail=1; }
  # nproc=0 (defensive)
  r="$(classify_loadavg 1 1 1 0)"
  echo "$r" | grep -q '^UNKNOWN' || { echo "  FAIL UNKNOWN-nproc0: got=$r"; fail=1; }
  # Priority: OVERLOADED > SPIKE > RISING (l1=20, l5=2, l15=1, nproc=8: OVERLOADED takes priority)
  r="$(classify_loadavg 20 2 1 8)"
  echo "$r" | grep -q '^OVERLOADED' || { echo "  FAIL priority OVERLOADED > SPIKE: got=$r"; fail=1; }
  # Priority: SPIKE > RISING (l1=10, l5=2, l15=1, nproc=8: SPIKE wins over RISING)
  r="$(classify_loadavg 10 2 1 8)"
  echo "$r" | grep -q '^SPIKE' || { echo "  FAIL priority SPIKE > RISING: got=$r"; fail=1; }
  # Priority: RISING > LIGHT (l1=4, l5=2, l15=1, nproc=8: RISING wins over LIGHT even though l1 > nproc/2)
  r="$(classify_loadavg 4 2 1 8)"
  echo "$r" | grep -q '^RISING' || { echo "  FAIL priority RISING > LIGHT: got=$r"; fail=1; }
  [ "$fail" = 1 ] && { echo "smoke-test: FAIL"; exit 1; }
  echo "  ok: classify (15 cases: OVERLOADED×2, SPIKE, RISING, FALLING, STABLE, LIGHT×2, UNKNOWN×2, priority×3)"
  # REAL-READ gate: reachability ≠ producing. The /proc file must be readable AND parse to
  # 3 floats or the sense is hollow (green test with no real artifact).
  _proc="/proc/loadavg"
  [ -r "$_proc" ] || { echo "smoke-test: n/a (/proc/loadavg unreadable — kernel not Linux? /procfs missing?); classify-logic ok"; exit 2; }
  _tup="$(parse_loadavg "$_proc")" || { echo "smoke-test: n/a (parse failed); classify-logic ok"; exit 2; }
  echo "smoke-test: ok (classify: 15 cases + REAL loadavg read: $_tup)"
  exit 0
fi

# --- Live read path ---
_proc="/proc/loadavg"
[ -r "$_proc" ] || {
  printf 'UNREACHABLE %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$STATE"
  mesh-state-touch "$STATE"
  echo "mesh-loadavg: $_proc not readable (kernel not Linux? /procfs missing?) — not an alarm" >&2
  exit 2
}
tup="$(parse_loadavg "$_proc")"
[ -n "$tup" ] || {
  printf 'UNREACHABLE %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$STATE"
  mesh-state-touch "$STATE"
  echo "mesh-loadavg: parse failed (tup='$tup') — not an alarm" >&2
  exit 2
}

# Get nproc (core count) for the relative-load bands
nproc="$(nproc 2>/dev/null)"
[ -n "$nproc" ] || nproc=1

l1="$(printf '%s' "$tup" | awk '{print $1}')"
l5="$(printf '%s' "$tup" | awk '{print $2}')"
l15="$(printf '%s' "$tup" | awk '{print $3}')"

result="$(classify_loadavg "$l1" "$l5" "$l15" "$nproc")"
label="${result%%|*}"
reason="${result#*|}"

TS=$(date -u +%Y-%m-%dT%H:%M:%SZ)
# Write state + touch liveness on EVERY successful run (mtime = ran-live, content = value-changed)
printf '%s|l1=%s|l5=%s|l15=%s|nproc=%s|%s\n' "$label" "$l1" "$l5" "$l15" "$nproc" "$reason" > "$STATE"
mesh-state-touch "$STATE"

# --- Output ---
if [ "${1:-}" = --json ]; then
  printf '{"label":"%s","reason":"%s","load1":%s,"load5":%s,"load15":%s,"nproc":%s,"ts":"%s"}\n' \
    "$label" "$reason" "$l1" "$l5" "$l15" "$nproc" "$TS"
  exit 0
fi
printf '[load-%s] %s — l1=%s l5=%s l15=%s (nproc=%s) | %s\n' \
  "$(printf '%s' "$label" | tr '[:upper:]' '[:lower:]')" "$label" "$l1" "$l5" "$l15" "$nproc" "$reason"
