PY
  : > "$amb/ideas-queue"; : > "$amb/.cooscillate-common-mode"
  PATH="$amb/bin:$PATH" MESH="$amb" COOSC_WIFI="$wab" COOSC_WIFI_IMAC="" COOSC_PRESENCE="$pab" \
    COOSC_WINDOW_H=48 COOSC_BIN_S=300 COOSC_MIN_OVERLAP=6 COOSC_MIN_R=0.6 IDEATE_FLOOR=1 bash "$0" >/dev/null 2>&1
  grep -Eq 'FixtureBeacon.*wifi AP|wifi AP.*FixtureBeacon' "$amb/.cooscillate-common-mode" 2>/dev/null \
    || { echo "smoke-test: FAIL (AMBIGUOUS BLE × local wifi not classified common-mode — the DV8235×TP-Link leak): $(cat "$amb/.cooscillate-common-mode" 2>/dev/null)"; exit 1; }
  if grep -Eq 'FixtureBeacon.*wifi AP|wifi AP.*FixtureBeacon' "$amb/ideas-queue" 2>/dev/null; then echo "smoke-test: FAIL (AMBIGUOUS BLE × local wifi dispatched to ideas-queue — the leak reopened): $(cat "$amb/ideas-queue")"; exit 1; fi
  # NO OVER-REACH: a CONFIRMED-PERSONAL device × local wifi is NOT common-mode (stays eligible = zone-anchor).
  if grep -Eq 'Carry.*wifi AP|wifi AP.*Carry' "$amb/.cooscillate-common-mode" 2>/dev/null; then echo "smoke-test: FAIL (PERSONAL BLE × local wifi wrongly classified common-mode — over-reach suppressed a zone-anchor pair): $(cat "$amb/.cooscillate-common-mode")"; exit 1; fi
  # ZONE-ANCHOR FRAMING FOR PERSONAL × WiFi-AP (this fix, 2026-07-12): classify() now tags a "wifi "
  # channel APPLIANCE (a WiFi access point is FIXED infrastructure), so a PERSONAL device × WiFi-AP
  # pair must EMIT the zone-anchor headline naming the AP a "fixed WiFi access point" — NOT the old
  # generic "co-moving-device cluster as one presence" reading (an AP can never be one co-moving
  # carrier). Real-data recurrence: Quest 3 × wifi ASUS. (--dry previews all candidates pre-dispatch.)
  ambdry="$(PATH="$amb/bin:$PATH" MESH="$amb" COOSC_WIFI="$wab" COOSC_WIFI_IMAC="" COOSC_PRESENCE="$pab" COOSC_WINDOW_H=48 COOSC_BIN_S=300 COOSC_MIN_OVERLAP=6 COOSC_MIN_R=0.6 bash "$0" --dry 2>&1)"
  carryap="$(printf '%s\n' "$ambdry" | grep -E 'Carry.*wifi AP|wifi AP.*Carry')"
  [ -n "$carryap" ] \
    || { echo "smoke-test: FAIL (personal × WiFi-AP pair no longer previews in --dry): $ambdry"; exit 1; }
  printf '%s\n' "$carryap" | grep -q 'STATIONARY (fixed WiFi access point)' \
    || { echo "smoke-test: FAIL (personal × WiFi-AP did not get zone-anchor 'fixed WiFi access point' framing — classify wifi→APPLIANCE missing): $carryap"; exit 1; }
  printf '%s\n' "$carryap" | grep -q 'zone-anchor localizer' \
    || { echo "smoke-test: FAIL (personal × WiFi-AP zone-anchor tail missing localizer proposal): $carryap"; exit 1; }
  printf '%s\n' "$carryap" | grep -q 'co-moving-device cluster as one presence' \
    && { echo "smoke-test: FAIL (personal × WiFi-AP wrongly kept the generic co-moving headline — an AP cannot co-move): $carryap"; exit 1; }
  # seed write + floor-gate parity with mesh-correlate
  MESH="$_td" COOSC_PRESENCE="$tp" COOSC_WINDOW_H=48 COOSC_MIN_OVERLAP=6 IDEATE_FLOOR=1 bash "$0" >/dev/null 2>&1
  n="$(grep -c '^\[ \] CO-OSCILLATION' "$_td/ideas-queue" 2>/dev/null)"; n="${n:-0}"
  [ "$n" = "1" ] || { echo "smoke-test: FAIL (expected exactly 1 emitted finding, got $n): $(cat "$_td/ideas-queue" 2>/dev/null)"; exit 1; }
  [ -s "$_td/.correlation-seeds" ] || { echo "smoke-test: FAIL (no seed written for mesh-ideate)"; exit 1; }
  grep -qF "$(printf 'PhoneA\tWatchB')" "$_td/.correlation-seeds" || grep -qF "$(printf 'WatchB\tPhoneA')" "$_td/.correlation-seeds" \
    || { echo "smoke-test: FAIL (seed pair not the in-sync PhoneA/WatchB): $(cat "$_td/.correlation-seeds")"; exit 1; }
  # floor-gate: a busy queue must HOLD
  printf '[ ] something open\n' > "$_td/ideas-queue"
  out2="$(MESH="$_td" COOSC_PRESENCE="$tp" COOSC_WINDOW_H=48 COOSC_MIN_OVERLAP=6 IDEATE_FLOOR=1 bash "$0" 2>&1)"
  echo "$out2" | grep -qi 'hold' || { echo "smoke-test: FAIL (floor-gate did not hold on non-empty queue): $out2"; exit 1; }
  echo "smoke-test: ok (in-sync pair found & ranked top; anti-phase detected; one finding emitted; seed written; floor-gate holds)"
  exit 0
fi

[ -f "$PRESENCE" ] || { echo "$(ts) mesh-cooscillate: no presence log yet ($PRESENCE) — need a live numeric source" >&2; exit 1; }

raw="$(analyze "$PRESENCE")" || { echo "$(ts) mesh-cooscillate: analyze failed" >&2; exit 1; }

is_local_wifi_label(){ case "$1" in wifi\ imac-*) return 1 ;; wifi\ *) return 0 ;; *) return 1 ;; esac; }
is_ble_nonpersonal_label(){
  # A BLE label that is NOT a CONFIRMED personal/mobile carrier — mesh-presence classifies it APPLIANCE
  # or AMBIGUOUS (or a name-pattern appliance when the classifier is absent). The zone-anchor reading
  # (personal × fixed-AP) NEEDS a known mobile carrier; a stationary appliance OR an AMBIGUOUS device
  # cannot supply one, so its co-fluctuation with a SAME-NODE local wifi AP is same-node wifi/BT coex /
  # RF common-mode (one combined front-end — here Intel 9460/9560 Jefferson Peak, btusb 8087:0aaa), not
  # a co-moving presence cluster. Real-data leak this closes (3rd recurrence): DV8235 × wifi TP-Link_97E0_5G
  # r=-0.78 2026-07-10 — DV8235 is a 24/7 fixture-beacon (ambient-clock treats it so) that mesh-presence
  # will only call AMBIGUOUS, so it slipped past the APPLIANCE-only check and reached the ideas-queue;
  # the prior LE-Bose×N7 (2026-06-25) and [TV]AU7002×Wi-Fi-1202 (2026-07-02) were APPLIANCE and already
  # caught. Only a CONFIRMED PERSONAL device × local wifi stays eligible (zone-anchor). [[honest-pushback-not-yesman]]
  case "$1" in wifi\ *|BLE\ device-count|"") return 1 ;; esac
  if command -v mesh-presence >/dev/null 2>&1; then
    case "$(mesh-presence --classify "$1" 2>/dev/null | head -1)" in
      APPLIANCE|AMBIGUOUS) return 0 ;;
      PERSONAL) return 1 ;;
    esac
  fi
  case "$1" in *TV*|*Samsung*|*LG*|*Bravia*|*Display*|*Monitor*|*Bose*|*SoundLink*|*JBL*|*Speaker*|*Soundbar*|*Scale*|*beacon*|*iBeacon*|*LE-*) return 0 ;; esac
  return 1
}
is_local_wifi_wifi_key(){ case "$1" in *"wifi imac-"*) return 1 ;; coosc:wifi*:wifi*) return 0 ;; *) return 1 ;; esac; }
is_common_mode_key(){
  local key="$1" rest a b
  rest="${key#coosc:}"; a="${rest%%:*}"; b="${rest#*:}"
  is_local_wifi_wifi_key "$key" && return 0              # same-node AP×AP → common-mode
  case "$key" in *"wifi imac-"*) return 1 ;; esac        # cross-node propagation pair → novel
  if is_local_wifi_label "$a" && is_ble_nonpersonal_label "$b"; then return 0; fi
  if is_local_wifi_label "$b" && is_ble_nonpersonal_label "$a"; then return 0; fi
  return 1
}

# COMMON-MODE REFLEX (operator 2026-06-20 CONNECTION task): two co-located WiFi APs on the SAME node
# vantage fluctuating in near-lockstep (|r|>0.95) share an RF environment driver (presence/body-
# absorption / interference floor) — a genuine common-fate signal, not a novel discovery. Emit
# [common-mode] to the durable trace so downstream (leadlag/rhythm) can fuse the pair into one 'RF
# environment health' channel or watch for DIVERGENCE (a locked pair decoupling = a localized AP fault).
# Keys are label-sanitized "wifi <ssid>" (label() turns colons→space/dash). TWO guards beyond the |r| gate:
#  (1) EXCLUDE cross-node pairs (one side "wifi imac-<ssid>", the iMac vantage) — those are two NODES'
#      views of the field (the propagation/divergence signal the cross-node bridge exists to find), the
#      OPPOSITE of co-located; sweeping them into common-mode would fuse away exactly that signal.
#      Co-located = BOTH sides are LOCAL same-vantage APs.
#  (2) FLOOD-GATE the durable-trace emit on a state file (each pair+sign once) — the */30 reflex would
#      otherwise re-emit the identical [common-mode] line every run (mirror mesh-land's POSTED_STATE).
CM_STATE="$MESH/.cooscillate-common-mode"
if [ "$mode" != "dry" ] && [ -n "$raw" ]; then
  touch "$CM_STATE" 2>/dev/null || true
  printf '%s\n' "$raw" | while IFS=$'\t' read -r sc kind key idea; do
    [ -z "$idea" ] && continue
    is_common_mode_key "$key" || continue
    r_str="$(printf '%s' "$idea" | grep -oE '\(r=[^)]*\)' | head -1 | tr -d '()')"
    r_val="${r_str#r=}"
    # Same-node AP×AP is very common, so only trace near-lockstep pairs. Stationary appliance×Wi-Fi
    # is rarer and already passed analyze()'s corrected p/effect gates, so trace it at the candidate bar.
    if is_local_wifi_wifi_key "$key"; then
      awk -v r="$r_val" 'BEGIN { if (r+0 > 0.95 || r+0 < -0.95) exit 0; else exit 1 }' || continue
    fi
    sign=$(awk -v r="$r_val" 'BEGIN{ print (r+0<0)?"anti":"sync" }')
    needle="$(printf '%s\t%s' "$key" "$sign")"
    grep -qF "$needle" "$CM_STATE" 2>/dev/null && continue   # already emitted this pair+sign → no re-flood
    printf '%s\n' "$needle" >> "$CM_STATE"
    command -v mesh-trace >/dev/null 2>&1 && mesh-trace "[common-mode] $key | $r_str ($sign) | stationary/common-mode RF environment — no co-moving presence cluster; watch for DIVERGENCE (decouple = localized fault)" >/dev/null 2>&1 || true
  done
fi

# ── COMMON-MODE pairs are NOT a novelty question — strip them from the MIND-DISPATCH paths ──────────
# A LOCAL wifi×wifi pair is two STATIONARY APs (a router cannot move); per the mobility taxonomy at the
# top of this file that is `appliance × appliance → pure common-mode → least informative` — and the
# COMMON-MODE REFLEX above ALREADY recognises it, tracing [common-mode] + a divergence-watch. Same for a
# NON-PERSONAL BLE device (mesh-presence --classify = APPLIANCE *or* AMBIGUOUS) × a LOCAL Wi-Fi AP:
# real-data task 2026-06-30, `[TV] Samsung AU7002 65 TV` × `wifi Wi-Fi 1202`, r=-0.90/11 Δ-steps/
# p_corr=0.044 (APPLIANCE); and 2026-07-10, `DV8235` × `wifi TP-Link_97E0_5G`, r=-0.78/17 Δ-steps/
# p_corr=0.010 — DV8235 is a 24/7 fixture-beacon that mesh-presence only calls AMBIGUOUS, so it slipped
# past the old APPLIANCE-only check and reached the ideas-queue (the 3rd recurrence of this class; the
# two prior deadend traces asked for exactly this screen). Neither a fixed appliance NOR an unconfirmed
# (AMBIGUOUS) device can be one co-moving presence carrier with a fixed AP; on ONE node's combined wifi+BT
# front-end the anti-phase is same-node coex / RF common-mode or small-n coincidence. Do NOT mint a fused
# presence sense from it. Yet these pairs were flowing into the ideas-queue as fresh "same carrier/zone,
# shared driver, or coincidence?" provocations, burning a mind to re-derive a coupling the tool can classify.
# So: keep common-mode pairs in trace/preview, but EXCLUDE them from mesh-ideate seeds and ideas-queue.
# CROSS-NODE (imac vantage = propagation/divergence), CONFIRMED-personal×wifi (mobile vs fixed AP =
# zone-anchor) and BLE×BLE (genuine co-movement) stay eligible.
raw_novel="$(printf '%s\n' "$raw" | while IFS=$'\t' read -r _s _k _key _t; do
  [ -z "$_t" ] && continue
  is_common_mode_key "$_key" && continue
  printf '%s\t%s\t%s\t%s\n' "$_s" "$_k" "$_key" "$_t"
done)"

# Seed the connection generator with the TOP finding's pair (independent of the floor gate, but
# NOT on --dry: a preview must be side-effect-free, else threshold-probing pollutes the seed file).
# Seeds from $raw_novel so a common-mode router pair never becomes a mesh-ideate CONNECTION idea either.
if [ "$mode" != "dry" ] && [ -n "$raw_novel" ]; then
  IFS=$'\t' read -r _sc _kind _tk _ttext <<< "$(printf '%s\n' "$raw_novel" | head -1)"
  [ -n "$_tk" ] && write_seed "$_tk" "$_ttext"
fi

if [ "$mode" = "dry" ]; then
  if [ -z "$raw" ]; then echo "$(ts) mesh-cooscillate: no pair fluctuates in sync above threshold (need more data / more live numeric streams — honest empty, not a failure)"; else echo "$raw"; fi
  exit 0
fi

# FLOOR gate — seed a genuinely-empty queue, one provocation at a time (mesh-ideate discipline).
floor="${IDEATE_FLOOR:-1}"
open=$(grep -c '^\[ \]' "$Q" 2>/dev/null); open="${open:-0}"
if [ "$open" -ge "$floor" ]; then
  echo "$(ts) mesh-cooscillate: queue has $open open idea(s) (>= floor $floor) — hold, not piling on"
  # mtime-touch (shared primitive, NOT a bare touch) — the fire-on-event tool's STATE file holds
  # only the recent-emitted-keys cache, so the mtime DOESN'T advance on a no-finding run and
  # a stale-mtime watchdog (mesh-reflex-health, mesh-doctor theater-check) false-fires as
  # "hollow cron-green with no fresh artifact". The hold path IS a successful cron eval:
  # the watch ran, the threshold held, no finding was emitted. Stamp the liveness without
  # polluting the recent-keys cache content.
  mesh-state-touch "$STATE"
  exit 0
fi

idea=""; key=""
while IFS=$'\t' read -r sc kind k text; do
  [ -z "$text" ] && continue
  recent_has "$k" && continue
  idea="$text"; key="$k"; break
done <<< "$raw_novel"

[ -z "$idea" ] && { echo "$(ts) mesh-cooscillate: no fresh finding (none meet thresholds, or all recently emitted)"; mesh-state-touch "$STATE"; exit 0; }

exec 9>"$LOCK" 2>/dev/null || true
flock -w 30 9 2>/dev/null || true
printf '[ ] %s\n' "$idea" >> "$Q"
recent_add "$key"
echo "$(ts) mesh-cooscillate: +1 finding -> ideas-queue ($key)"
