#!/usr/bin/env bash
# reflex-cadence: 23 */4 * * *
# mesh-study — the ETERNAL RESEARCH CHANNEL. The mesh stays current with the FIELDS it is made of
# (docs/eternity-and-its-fields.md): always scan, read, think, try. On a cadence it pulls recent
# discourse on ONE field, and a mind distills what's relevant + ONE thing worth TRYING here -> study
# log (+ roadmap). Staying intellectually alive, not just operationally. $0 fetch (HN Algolia JSON);
# the mind-distill is gated like mesh-reflect (autonomy flip = MESH_STUDY_AUTO=1).
# Sources: ~/.mesh/study-fields.list  (field | source-url)
#
#   mesh-study --brief   fetch + print a brief for the next field ($0)
#   mesh-study           distill+record (if MESH_STUDY_AUTO=1 + claude); else stamp brief to study.log
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
MESH="$HOME/.mesh"; FIELDS="$MESH/study-fields.list"; LOG="$MESH/study.log"; OFF="$MESH/.study-rotor"
mkdir -p "$MESH"

# --- the --test dispatch lives ABOVE the registry guard, and must stay there. ---
# It sat BELOW it until 2026-07-15 (guard :16, dispatch :53), so on a node with no registry the
# script exited 0 at the guard and the ENTIRE test block was dead code: `mesh-study --test` printed
# one line ("no fields registry"), not a single assertion, and still returned rc=0. autowire gated on
# that rc=0 and wired a lane that could never produce here — two cron lanes (study + study-bridge),
# four runs each, zero briefs, green everywhere. A prerequisite guard placed above a --test disarms
# the gate with the very condition the gate exists to detect: the gate was alive ONLY on a node where
# the lane was already alive, and silent on exactly the node it needed to fail on.
# (chat-review/study-lane-dead-since-migration-reports-exit-0; discover 15:30, health-verified 15:41.)
# Tighter than 974d864, where the test at least RAN and asserted stubs.
[ "${1:-}" = --test ] && {
  fail=0
  command -v curl >/dev/null 2>&1 || { echo "FAIL: curl not found"; fail=1; }
  command -v python3 >/dev/null 2>&1 || { echo "FAIL: python3 not found"; fail=1; }
  # dry-run the JSON parsing pipeline with mock data
  echo '{"hits":[{"title":"mesh study test","url":"https://example.com","points":42}]}' \
    | python3 -c '
import sys,json
try: d=json.load(sys.stdin)
except: sys.exit(1)
for h in d.get("hits",[]):
    t=h.get("title",""); u=h.get("url",""); p=h.get("points",0)
    if t: print(f"- {t}  [{p}pts]  {u}")
' >/dev/null 2>&1 || { echo "FAIL: json parsing pipeline broken"; fail=1; }
  # hermetic dedupe + EMPTY-marker test (finding-study-lane-hollow-20260705.md): fresh HOME so
  # study.log/study-fields.list/curl are all fixtures, re-exec via HOME= like mesh-supervise's pattern.
  # The temp HOME is also what keeps this test from FORGING the artifact discover's detector reads:
  # study.log is the lane's liveness evidence, so --test must never write the real one (09f7914).
  _td="$(mktemp -d)"; mkdir -p "$_td/.mesh" "$_td/bin"
  printf '#!/bin/sh\ncat <<'"'"'EOF'"'"'\n{"hits":[{"title":"seen item","url":"https://fake.example/seen","points":1},{"title":"new item","url":"https://fake.example/new","points":2}]}\nEOF\n' > "$_td/bin/curl"
  chmod +x "$_td/bin/curl"
  echo "testfield | https://fake.example/search_by_date?query=test&tags=story" > "$_td/.mesh/study-fields.list"
  echo "https://fake.example/seen" > "$_td/.mesh/study.log"
  _out="$(HOME="$_td" PATH="$_td/bin:$PATH" timeout 10 "$0" --brief 2>&1)"
  printf '%s' "$_out" | grep -q "new item" || { echo "FAIL: dedupe test — a genuinely new item was dropped: $_out"; fail=1; }
  printf '%s' "$_out" | grep -q "seen item" && { echo "FAIL: dedupe test — an already-served URL was not filtered: $_out"; fail=1; }
  printf '#!/bin/sh\necho '"'"'{"hits":[]}'"'"'\n' > "$_td/bin/curl"
  rm -f "$_td/.mesh/study.log"
  _out2="$(HOME="$_td" PATH="$_td/bin:$PATH" timeout 10 "$0" --brief 2>&1)"
  printf '%s' "$_out2" | grep -q "(EMPTY —" || { echo "FAIL: 0-hit fetch was not marked EMPTY: $_out2"; fail=1; }
  rm -rf "$_td"
  [ "$fail" = 0 ] && echo "smoke-test: all deps ok" || { echo "smoke-test: FAIL"; exit 1; }

  # PREREQUISITE GATE — the REAL registry, not the fixture. Everything above ran in a temp HOME and
  # therefore passes on a node where the lane is stone dead; this is the only assertion that looks at
  # what mesh-study will actually read at 23 */4. It sits BEFORE the network gate deliberately: a
  # missing registry is a LOCAL fact and must not hide behind an offline exit 2.
  # Severity follows the lane's own CLAIM TO RUN — never a node name, which ages out (TG_HOST):
  #   wired in cron, no registry -> FAIL. A lane scheduled to produce that cannot produce.
  #   not wired,     no registry -> exit 2 n/a. Nothing claims to run; autowire SKIPs, honestly,
  #                                 which is what should have happened on 2026-07-14.
  _nf=0; [ -f "$FIELDS" ] && _nf="$(grep -vcE '^\s*#|^\s*$' "$FIELDS" 2>/dev/null || echo 0)"
  if [ "${_nf:-0}" -lt 1 ]; then
    if crontab -l 2>/dev/null | grep -q 'mesh-study\([^-]\|$\)'; then
      echo "smoke-test: FAIL — mesh-study is WIRED in cron but has no usable fields registry ($FIELDS)."
      echo "  A lane scheduled to produce that cannot produce: every run stamps 'no fields registry' and stops."
      echo "  Plant it:  cp \$MESH_REPO/study-fields.list.example $FIELDS"
      exit 1
    fi
    echo "smoke-test: n/a (no fields registry + lane not wired — cp study-fields.list.example to $FIELDS to enable)"
    exit 2
  fi
  echo "smoke-test: registry ok (${_nf} fields declared)"

  # THE GATE MUST READ WHAT THE LANE READS. The real-read gate below fetches its OWN hardcoded URL:
  # that proves HN is reachable and the JSON pipeline parses — NOT that THIS registry can produce.
  # A malformed src sails straight past it and lands in the honest "(EMPTY)" branch, so the lane goes
  # quiet while the gate stays green (the 07-15 inline-comment bug: every field 0 hits, --test green).
  # So parse every declared source EXACTLY as brief() will, and assert it is a whitespace-free
  # http(s) URL. Local and free — no per-field curl, since autowire bounds --test at timeout 30.
  _bad=0
  while IFS= read -r _l; do
    _s="$(printf '%s' "${_l#*|}" | sed 's/[[:space:]]*#.*$//' | xargs)"
    case "$_s" in
      http://*|https://*) ;;
      *) echo "smoke-test: FAIL — registry source is not an http(s) URL: '$_s'"; _bad=1; continue ;;
    esac
    case "$_s" in
      *[[:space:]]*) echo "smoke-test: FAIL — registry source has whitespace (unstripped inline comment?): '$_s'"; _bad=1 ;;
    esac
  done < <(grep -vE '^\s*#|^\s*$' "$FIELDS")
  [ "$_bad" = 0 ] || exit 1
  echo "smoke-test: registry sources well-formed (${_nf}/${_nf})"

  # real-read gate: reachability != producing (mesh-mag doctrine) — a live search_by_date fetch
  # for a broad/known-fresh field must yield >=1 item, not just "curl didn't error".
  _cutoff=$(( $(date +%s) - 30*86400 ))
  _real="$(curl -s -m 15 "https://hn.algolia.com/api/v1/search_by_date?query=CRDT&tags=story&numericFilters=created_at_i%3E${_cutoff}" 2>/dev/null)"
  [ -n "$_real" ] || { echo "smoke-test: n/a (HN Algolia unreachable — real-read gate skipped, offline)"; exit 2; }
  _n="$(printf '%s' "$_real" | python3 -c 'import sys,json
try: d=json.load(sys.stdin)
except Exception: d={}
print(len(d.get("hits",[])))' 2>/dev/null)"
  [ "${_n:-0}" -ge 1 ] || { echo "smoke-test: FAIL (real search_by_date fetch yielded 0 items — hollow, not just unreachable)"; exit 1; }
  echo "smoke-test: real-read ok (${_n} live hits)"
  exit 0
}

# A missing prerequisite is a FAILURE, not a success. This was `exit 0` until 2026-07-15: the cron log
# filled with a plausible constant ("no fields registry", 1 distinct line, every run) while rc=0 told
# cron, mesh-reflex-health and mesh-doctor the lane was fine. The registry ships as
# study-fields.list.example (genome root) — it is pure runtime state that lived on IdeaPad and did not
# travel in the 07-14 migration, which is why absence must be loud rather than assumed-intentional.
[ -f "$FIELDS" ] || { echo "no fields registry ($FIELDS) — cp study-fields.list.example to it" >&2; exit 1; }
mapfile -t F < <(grep -vE '^\s*#|^\s*$' "$FIELDS")
[ ${#F[@]} -eq 0 ] && { echo "no fields — $FIELDS has no uncommented entries" >&2; exit 1; }
r=$(( $(cat "$OFF" 2>/dev/null || echo 0) % ${#F[@]} )); echo $((r+1)) > "$OFF"   # rotate fields each run
line="${F[$r]}"
# strip a TRAILING inline comment before parsing. grep -vE '^\s*#' above only drops WHOLE-line
# comments, so `field | url  # 20 hits` used to carry " # 20 hits" into $src -> curl got a URL with
# spaces in it -> 0 hits -> the honest "(EMPTY)" branch, on every field, forever. A registry that is
# present, well-intentioned and hollow — indistinguishable from a field that is merely quiet. Caught
# 2026-07-15 by driving the real cron path after planting the example (the --test missed it: its
# real-read gate fetches its OWN hardcoded URL, so it proved HN was reachable while the registry it
# was gating produced nothing). The format invites the annotation; the parser must tolerate it.
field="$(printf '%s' "${line%%|*}" | sed 's/[[:space:]]*#.*$//' | xargs)"
src="$(printf '%s' "${line#*|}" | sed 's/[[:space:]]*#.*$//' | xargs)"

seen_urls(){ grep -oE 'https?://[^ ]+' "$LOG" 2>/dev/null | sort -u; }
# search_by_date (not relevance) so a 3-4-word phrase can't freeze onto the same evergreen
# top-points page forever; the recency window is computed HERE (not baked into study-fields.list)
# so it never goes stale. finding-study-lane-hollow-20260705.md.
fetch(){
  local win="${MESH_STUDY_WINDOW_DAYS:-30}" cutoff url dedupe
  cutoff=$(( $(date +%s) - win*86400 ))
  case "$src" in
    *numericFilters=*) url="${src}" ;;
    *) url="${src}&numericFilters=created_at_i%3E${cutoff}" ;;
  esac
  dedupe="$(mktemp)"; seen_urls > "$dedupe" 2>/dev/null
  curl -s -m 20 "$url" 2>/dev/null | python3 -c '
import sys,json
try: d=json.load(sys.stdin)
except Exception: sys.exit()
for h in d.get("hits",[])[:6]:
    t=h.get("title") or h.get("story_title") or ""
    u=h.get("url") or ("https://news.ycombinator.com/item?id="+str(h.get("objectID","")))
    p=h.get("points",0)
    if t: print(f"- {t}  [{p}pts]  {u}")
' | grep -vFf "$dedupe" 2>/dev/null
  rm -f "$dedupe"
}
brief(){
  echo "=== study: $field ($(date -u +%FT%TZ)) ==="; echo "(source: $src)"
  local items; items="$(fetch)"
  if [ -z "$items" ]; then echo "(EMPTY — query returned nothing new: 0 fresh hits, or all seen before)"
  else printf '%s\n' "$items"
  fi
}
[ "${1:-}" = --brief ] && { brief; exit 0; }

B="$(brief)"
if [ "${MESH_STUDY_AUTO:-0}" = 1 ] && command -v claude >/dev/null 2>&1; then
  out=$(timeout 240 claude -p "You are the mesh studying '$field', one of the fields it is made of
(docs/eternity-and-its-fields.md). From these recent items write 2-4 lines: what is genuinely relevant
to a self-resilient autonomous mesh, and ONE concrete thing worth TRYING here. Skip noise/hype.
ITEMS:
$B" --dangerously-skip-permissions 2>/dev/null || true)
  [ -n "$out" ] && { printf '\n=== %s study:%s ===\n%s\n' "$(date -u +%FT%TZ)" "$field" "$out" >> "$LOG"; echo "distilled -> study.log"; } || echo "[no distillation]"
else
  { echo; echo "$B"; echo "(awaiting a mind to distill -> what to try)"; } >> "$LOG"
  echo "brief stamped to study.log ($field) — enable MESH_STUDY_AUTO=1 + autonomy to self-distill"
fi
