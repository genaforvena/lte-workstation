#!/usr/bin/env bash
# reflex-cadence: 23 */4 * * *
# mesh-study — the ETERNAL RESEARCH CHANNEL. The mesh stays current with the FIELDS it is made of
# (docs/eternity-and-its-fields.md): always scan, read, think, try. On a cadence it pulls recent
# discourse on ONE field, and a mind distills what's relevant + ONE thing worth TRYING here -> study
# log (+ roadmap). Staying intellectually alive, not just operationally. $0 fetch (HN Algolia JSON);
# the mind-distill is gated like mesh-reflect (autonomy flip = MESH_STUDY_AUTO=1).
# Sources: ~/.mesh/study-fields.list  (field | source-url)
#
#   mesh-study --brief   fetch + print a brief for the next field ($0)
#   mesh-study           distill+record (if MESH_STUDY_AUTO=1 + claude); else stamp brief to study.log
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
MESH="$HOME/.mesh"; FIELDS="$MESH/study-fields.list"; LOG="$MESH/study.log"; OFF="$MESH/.study-rotor"
mkdir -p "$MESH"
[ -f "$FIELDS" ] || { echo "no fields registry ($FIELDS)"; exit 0; }
mapfile -t F < <(grep -vE '^\s*#|^\s*$' "$FIELDS")
[ ${#F[@]} -eq 0 ] && { echo "no fields"; exit 0; }
r=$(( $(cat "$OFF" 2>/dev/null || echo 0) % ${#F[@]} )); echo $((r+1)) > "$OFF"   # rotate fields each run
line="${F[$r]}"; field="$(printf '%s' "${line%%|*}" | xargs)"; src="$(printf '%s' "${line#*|}" | xargs)"

seen_urls(){ grep -oE 'https?://[^ ]+' "$LOG" 2>/dev/null | sort -u; }
# search_by_date (not relevance) so a 3-4-word phrase can't freeze onto the same evergreen
# top-points page forever; the recency window is computed HERE (not baked into study-fields.list)
# so it never goes stale. finding-study-lane-hollow-20260705.md.
fetch(){
  local win="${MESH_STUDY_WINDOW_DAYS:-30}" cutoff url dedupe
  cutoff=$(( $(date +%s) - win*86400 ))
  case "$src" in
    *numericFilters=*) url="${src}" ;;
    *) url="${src}&numericFilters=created_at_i%3E${cutoff}" ;;
  esac
  dedupe="$(mktemp)"; seen_urls > "$dedupe" 2>/dev/null
  curl -s -m 20 "$url" 2>/dev/null | python3 -c '
import sys,json
try: d=json.load(sys.stdin)
except Exception: sys.exit()
for h in d.get("hits",[])[:6]:
    t=h.get("title") or h.get("story_title") or ""
    u=h.get("url") or ("https://news.ycombinator.com/item?id="+str(h.get("objectID","")))
    p=h.get("points",0)
    if t: print(f"- {t}  [{p}pts]  {u}")
' | grep -vFf "$dedupe" 2>/dev/null
  rm -f "$dedupe"
}
brief(){
  echo "=== study: $field ($(date -u +%FT%TZ)) ==="; echo "(source: $src)"
  local items; items="$(fetch)"
  if [ -z "$items" ]; then echo "(EMPTY — query returned nothing new: 0 fresh hits, or all seen before)"
  else printf '%s\n' "$items"
  fi
}
[ "${1:-}" = --test ] && {
  fail=0
  command -v curl >/dev/null 2>&1 || { echo "FAIL: curl not found"; fail=1; }
  command -v python3 >/dev/null 2>&1 || { echo "FAIL: python3 not found"; fail=1; }
  # dry-run the JSON parsing pipeline with mock data
  echo '{"hits":[{"title":"mesh study test","url":"https://example.com","points":42}]}' \
    | python3 -c '
import sys,json
try: d=json.load(sys.stdin)
except: sys.exit(1)
for h in d.get("hits",[]):
    t=h.get("title",""); u=h.get("url",""); p=h.get("points",0)
    if t: print(f"- {t}  [{p}pts]  {u}")
' >/dev/null 2>&1 || { echo "FAIL: json parsing pipeline broken"; fail=1; }
  # hermetic dedupe + EMPTY-marker test (finding-study-lane-hollow-20260705.md): fresh HOME so
  # study.log/study-fields.list/curl are all fixtures, re-exec via HOME= like mesh-supervise's pattern.
  _td="$(mktemp -d)"; mkdir -p "$_td/.mesh" "$_td/bin"
  printf '#!/bin/sh\ncat <<'"'"'EOF'"'"'\n{"hits":[{"title":"seen item","url":"https://fake.example/seen","points":1},{"title":"new item","url":"https://fake.example/new","points":2}]}\nEOF\n' > "$_td/bin/curl"
  chmod +x "$_td/bin/curl"
  echo "testfield | https://fake.example/search_by_date?query=test&tags=story" > "$_td/.mesh/study-fields.list"
  echo "https://fake.example/seen" > "$_td/.mesh/study.log"
  _out="$(HOME="$_td" PATH="$_td/bin:$PATH" timeout 10 "$0" --brief 2>&1)"
  printf '%s' "$_out" | grep -q "new item" || { echo "FAIL: dedupe test — a genuinely new item was dropped: $_out"; fail=1; }
  printf '%s' "$_out" | grep -q "seen item" && { echo "FAIL: dedupe test — an already-served URL was not filtered: $_out"; fail=1; }
  printf '#!/bin/sh\necho '"'"'{"hits":[]}'"'"'\n' > "$_td/bin/curl"
  rm -f "$_td/.mesh/study.log"
  _out2="$(HOME="$_td" PATH="$_td/bin:$PATH" timeout 10 "$0" --brief 2>&1)"
  printf '%s' "$_out2" | grep -q "(EMPTY —" || { echo "FAIL: 0-hit fetch was not marked EMPTY: $_out2"; fail=1; }
  rm -rf "$_td"
  [ "$fail" = 0 ] && echo "smoke-test: all deps ok" || { echo "smoke-test: FAIL"; exit 1; }
  # real-read gate: reachability != producing (mesh-mag doctrine) — a live search_by_date fetch
  # for a broad/known-fresh field must yield >=1 item, not just "curl didn't error".
  _cutoff=$(( $(date +%s) - 30*86400 ))
  _real="$(curl -s -m 15 "https://hn.algolia.com/api/v1/search_by_date?query=CRDT&tags=story&numericFilters=created_at_i%3E${_cutoff}" 2>/dev/null)"
  [ -n "$_real" ] || { echo "smoke-test: n/a (HN Algolia unreachable — real-read gate skipped, offline)"; exit 2; }
  _n="$(printf '%s' "$_real" | python3 -c 'import sys,json
try: d=json.load(sys.stdin)
except Exception: d={}
print(len(d.get("hits",[])))' 2>/dev/null)"
  [ "${_n:-0}" -ge 1 ] || { echo "smoke-test: FAIL (real search_by_date fetch yielded 0 items — hollow, not just unreachable)"; exit 1; }
  echo "smoke-test: real-read ok (${_n} live hits)"
  exit 0
}
[ "${1:-}" = --brief ] && { brief; exit 0; }

B="$(brief)"
if [ "${MESH_STUDY_AUTO:-0}" = 1 ] && command -v claude >/dev/null 2>&1; then
  out=$(timeout 240 claude -p "You are the mesh studying '$field', one of the fields it is made of
(docs/eternity-and-its-fields.md). From these recent items write 2-4 lines: what is genuinely relevant
to a self-resilient autonomous mesh, and ONE concrete thing worth TRYING here. Skip noise/hype.
ITEMS:
$B" --dangerously-skip-permissions 2>/dev/null || true)
  [ -n "$out" ] && { printf '\n=== %s study:%s ===\n%s\n' "$(date -u +%FT%TZ)" "$field" "$out" >> "$LOG"; echo "distilled -> study.log"; } || echo "[no distillation]"
else
  { echo; echo "$B"; echo "(awaiting a mind to distill -> what to try)"; } >> "$LOG"
  echo "brief stamped to study.log ($field) — enable MESH_STUDY_AUTO=1 + autonomy to self-distill"
fi
