#!/usr/bin/env bash
# mesh-study — the ETERNAL RESEARCH CHANNEL. The mesh stays current with the FIELDS it is made of
# (docs/eternity-and-its-fields.md): always scan, read, think, try. On a cadence it pulls recent
# discourse on ONE field, and a mind distills what's relevant + ONE thing worth TRYING here -> study
# log (+ roadmap). Staying intellectually alive, not just operationally. $0 fetch (HN Algolia JSON);
# the mind-distill is gated like mesh-reflect (autonomy flip = MESH_STUDY_AUTO=1).
# Sources: ~/.mesh/study-fields.list  (field | source-url)
#
#   mesh-study --brief   fetch + print a brief for the next field ($0)
#   mesh-study           distill+record (if MESH_STUDY_AUTO=1 + claude); else stamp brief to study.log
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
MESH="$HOME/.mesh"; FIELDS="$MESH/study-fields.list"; LOG="$MESH/study.log"; OFF="$MESH/.study-rotor"
mkdir -p "$MESH"
[ -f "$FIELDS" ] || { echo "no fields registry ($FIELDS)"; exit 0; }
mapfile -t F < <(grep -vE '^\s*#|^\s*$' "$FIELDS")
[ ${#F[@]} -eq 0 ] && { echo "no fields"; exit 0; }
r=$(( $(cat "$OFF" 2>/dev/null || echo 0) % ${#F[@]} )); echo $((r+1)) > "$OFF"   # rotate fields each run
line="${F[$r]}"; field="$(printf '%s' "${line%%|*}" | xargs)"; src="$(printf '%s' "${line#*|}" | xargs)"

fetch(){ curl -s -m 20 "$src" 2>/dev/null | python3 -c '
import sys,json
try: d=json.load(sys.stdin)
except Exception: sys.exit()
for h in d.get("hits",[])[:6]:
    t=h.get("title") or h.get("story_title") or ""
    u=h.get("url") or ("https://news.ycombinator.com/item?id="+str(h.get("objectID","")))
    p=h.get("points",0)
    if t: print(f"- {t}  [{p}pts]  {u}")
'; }
brief(){ echo "=== study: $field ($(date -u +%FT%TZ)) ==="; echo "(source: $src)"; fetch; }
[ "${1:-}" = --test ] && {
  fail=0
  command -v curl >/dev/null 2>&1 || { echo "FAIL: curl not found"; fail=1; }
  command -v python3 >/dev/null 2>&1 || { echo "FAIL: python3 not found"; fail=1; }
  # dry-run the JSON parsing pipeline with mock data
  echo '{"hits":[{"title":"mesh study test","url":"https://example.com","points":42}]}' \
    | python3 -c '
import sys,json
try: d=json.load(sys.stdin)
except: sys.exit(1)
for h in d.get("hits",[]):
    t=h.get("title",""); u=h.get("url",""); p=h.get("points",0)
    if t: print(f"- {t}  [{p}pts]  {u}")
' >/dev/null 2>&1 || { echo "FAIL: json parsing pipeline broken"; fail=1; }
  [ "$fail" = 0 ] && echo "smoke-test: all deps ok" || echo "smoke-test: FAIL"
  exit "$fail"
}
[ "${1:-}" = --brief ] && { brief; exit 0; }

B="$(brief)"
if [ "${MESH_STUDY_AUTO:-0}" = 1 ] && command -v claude >/dev/null 2>&1; then
  out=$(timeout 240 claude -p "You are the mesh studying '$field', one of the fields it is made of
(docs/eternity-and-its-fields.md). From these recent items write 2-4 lines: what is genuinely relevant
to a self-resilient autonomous mesh, and ONE concrete thing worth TRYING here. Skip noise/hype.
ITEMS:
$B" --dangerously-skip-permissions 2>/dev/null || true)
  [ -n "$out" ] && { printf '\n=== %s study:%s ===\n%s\n' "$(date -u +%FT%TZ)" "$field" "$out" >> "$LOG"; echo "distilled -> study.log"; } || echo "[no distillation]"
else
  { echo; echo "$B"; echo "(awaiting a mind to distill -> what to try)"; } >> "$LOG"
  echo "brief stamped to study.log ($field) — enable MESH_STUDY_AUTO=1 + autonomy to self-distill"
fi
