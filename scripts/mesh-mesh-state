#!/usr/bin/env bash
# reflex-cadence: 2-59/5 * * * *
# reflex-args: --edge
# mesh-mesh-state — MESH INFRASTRUCTURE HEALTH: a 4-input fusion of the mesh's connectivity layer.
# Complements the existing per-component health tools with a single "is the mesh as a whole
# healthy?" verdict the steward/operator can read at a glance.
#
# Inputs (all read from state files — no live probes, so this tool itself is cheap):
#   mesh-selfcare      .selfcare-state    "<host> tg=up|down inet=up|down mesh=up|down"
#   mesh-egress-health .egress-state      "OK" / "BAD" / "SKIP"
#   mesh-vpn-health    (no state file; live call)
#   mesh-watchtower    .watchtower-state  numeric hash
#
# Each input classifies as HEALTHY / DEGRADED / UNKNOWN:
#   - selfcare HEALTHY iff all of tg/inet/mesh are 'up'; DEGRADED if any 'down'
#   - egress HEALTHY iff 'OK'; DEGRADED iff 'BAD' or 'SKIP'
#   - vpn HEALTHY iff reachable; DEGRADED iff down (live call, no state file)
#   - watchtower HEALTHY iff state file present and recent; DEGRADED otherwise
#
# Combined verdict (FALSIFIABLE via --test):
#   HEALTHY   all 4 inputs HEALTHY
#   DEGRADED  exactly 1 input DEGRADED (or 1 UNKNOWN with rest healthy)
#   BROKEN    2+ inputs DEGRADED (mesh has multiple broken paths)
#   DEGRADED  2+ inputs UNKNOWN → DEGRADED with explicit missing list
#                             (never a confident HEALTHY when 2+ senses are unreachable — same
#                              honest-fusion contract as mesh-physical-context, mesh-rhythm-state)
#   UNKNOWN   1 missing (single-input degradation)
#
# Honest-fusion: 2+ inputs UNREACHABLE → DEGRADED with the explicit missing list, never a
# confident HEALTHY. A consumer reading the state file sees "DEGRADED|missing: vpn,watchtower"
# — VISIBLY DISTINCT from a genuine "1 path down" verdict.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes" 2>/dev/null || true

STATE="$HOME/.mesh/.mesh-state"
MESH="${MESH_DIR:-$HOME/.mesh}"
STALE_S=600
# mesh-watchtower's own reflex-cadence is 13-59/30 (fires every 30 min, not every 5), so the
# shared 600s (10 min) STALE_S always reads it as stale even when healthy — a permanent false
# UNKNOWN, not a real degradation (live-verified 2026-07-01: age 36m, cron alive). Give it its
# own threshold sized to its actual cadence + a buffer, same "judge vs the reflex's own cadence,
# not a flat threshold" fix as mesh-reflex-health's DEAD-vs-cadence-drift class.
WT_STALE_S=3900

# classify_selfcare <state-file> → echoes HEALTHY|DEGRADED|UNKNOWN
# state format: "<host> tg=up|down inet=up|down mesh=up|down"
classify_selfcare() {
  local f="$1" v now m
  [ -f "$f" ] || { echo "UNKNOWN"; return; }
  now=$(date +%s); m=$(stat -c %Y "$f" 2>/dev/null || echo "$now")
  if [ $((now - m)) -gt "$STALE_S" ]; then echo "UNKNOWN"; return; fi
  v="$(head -1 "$f" 2>/dev/null)"
  if printf '%s' "$v" | grep -qE 'tg=up.*inet=up.*mesh=up' 2>/dev/null; then
    echo "HEALTHY"
  else
    echo "DEGRADED"
  fi
}

# classify_egress <state-file> → echoes HEALTHY|DEGRADED|UNKNOWN
# state format: "OK" / "BAD" / "SKIP"  (mesh-egress-health writes a single label)
classify_egress() {
  local f="$1" v now m
  [ -f "$f" ] || { echo "UNKNOWN"; return; }
  now=$(date +%s); m=$(stat -c %Y "$f" 2>/dev/null || echo "$now")
  if [ $((now - m)) -gt "$STALE_S" ]; then echo "UNKNOWN"; return; fi
  v="$(head -1 "$f" 2>/dev/null | awk '{print $1}')"
  [ "$v" = "OK" ] && { echo "HEALTHY"; return; }
  echo "DEGRADED"
}

# classify_vpn <host> <port> <user> → echoes HEALTHY|DEGRADED
# mesh-vpn-health is read-only — but calling it on every fusion eval is too heavy. We do a
# lightweight SSH reachability probe (one TCP+exec) — NOT the full VPN-cert check. The full check
# is in mesh-vpn-health itself, which writes its own state; the fusion just needs liveness.
classify_vpn() {
  local target="$1"
  [ -n "$target" ] || { echo "UNKNOWN"; return; }
  if [ -f "$HOME/.mesh/.vpn-health.state" ]; then
    local v
    v="$(head -1 "$HOME/.mesh/.vpn-health.state" 2>/dev/null | awk '{print $1}')"
    if [ "$v" = "DOWN" ] || [ "$v" = "DEGRADED" ]; then
      echo "DEGRADED"
      return
    fi
  fi
  if timeout 5 ssh -o BatchMode=yes -o ConnectTimeout=3 \
       -o StrictHostKeyChecking=accept-new "$target" \
       'echo ok' </dev/null >/dev/null 2>&1; then
    echo "HEALTHY"
  else
    echo "UNKNOWN"
  fi
}

# classify_watchtower <state-file> → echoes HEALTHY|DEGRADED|UNKNOWN
# mesh-watchtower writes its state with epoch seconds embedded (or a hash). Just check freshness.
classify_watchtower() {
  local f="$1" now m
  [ -f "$f" ] || { echo "UNKNOWN"; return; }
  now=$(date +%s); m=$(stat -c %Y "$f" 2>/dev/null || echo "$now")
  if [ $((now - m)) -gt "$WT_STALE_S" ]; then echo "UNKNOWN"; return; fi
  echo "HEALTHY"
}

# classify_mesh_state <sc> <eg> <vp> <wt> → "LABEL|reason" — pure, offline-testable
# Bands: 0 DEGRADED → HEALTHY; 1 DEGRADED → DEGRADED; 2+ DEGRADED → BROKEN;
# 2+ UNKNOWN → DEGRADED with missing list (the safety rail).
classify_mesh_state() {
  local sc="$1" eg="$2" vp="$3" wt="$4"
  local degraded_count=0 unknown_count=0
  local missing=""
  [ "$sc" = "DEGRADED" ] && degraded_count=$((degraded_count+1))
  [ "$eg" = "DEGRADED" ] && degraded_count=$((degraded_count+1))
  [ "$vp" = "DEGRADED" ] && degraded_count=$((degraded_count+1))
  [ "$wt" = "DEGRADED" ] && degraded_count=$((degraded_count+1))
  [ "$sc" = "UNKNOWN" ] && unknown_count=$((unknown_count+1)) && missing="${missing}selfcare,"
  [ "$eg" = "UNKNOWN" ] && unknown_count=$((unknown_count+1)) && missing="${missing}egress,"
  [ "$vp" = "UNKNOWN" ] && unknown_count=$((unknown_count+1)) && missing="${missing}vpn,"
  [ "$wt" = "UNKNOWN" ] && unknown_count=$((unknown_count+1)) && missing="${missing}watchtower,"
  missing="${missing%,}"
  if [ "$unknown_count" -ge 2 ]; then
    echo "DEGRADED|missing: $missing (mesh health can't be asserted — too many senses unreachable)"
    return
  fi
  if [ "$degraded_count" -ge 2 ]; then
    echo "BROKEN|2+ paths down (selfcare=$sc egress=$eg vpn=$vp watchtower=$wt)"
    return
  fi
  if [ "$degraded_count" -eq 1 ]; then
    # Identify which one is degraded
    local which=""
    [ "$sc" = "DEGRADED" ] && which="selfcare"
    [ "$eg" = "DEGRADED" ] && which="egress"
    [ "$vp" = "DEGRADED" ] && which="vpn"
    [ "$wt" = "DEGRADED" ] && which="watchtower"
    echo "DEGRADED|path down: $which (others healthy)"
    return
  fi
  if [ "$unknown_count" -eq 1 ]; then
    echo "DEGRADED|missing: $missing (one sense unreachable, can't fully assert)"
    return
  fi
  echo "HEALTHY|all 4 mesh paths up"
}

# read_prev_label <state-file> → echoes the stored LABEL (field before '|'), empty if absent.
# MUST be called BEFORE STATE is overwritten — otherwise --edge compares the value to itself.
read_prev_label() {
  local f="$1" p=""
  [ -f "$f" ] && read -r p _ < "$f" 2>/dev/null
  printf '%s' "${p%%|*}"
}

if [ "${1:-}" = --test ]; then
  fail=0
  # HEALTHY: all 4 healthy
  r="$(classify_mesh_state HEALTHY HEALTHY HEALTHY HEALTHY)"
  [ "$r" = "HEALTHY|all 4 mesh paths up" ] || { echo "  FAIL HEALTHY all: got=$r"; fail=1; }
  # DEGRADED: 1 down (each of the 4 paths)
  r="$(classify_mesh_state DEGRADED HEALTHY HEALTHY HEALTHY)"
  [ "$r" = "DEGRADED|path down: selfcare (others healthy)" ] || { echo "  FAIL DEGRADED-selfcare: got=$r"; fail=1; }
  r="$(classify_mesh_state HEALTHY DEGRADED HEALTHY HEALTHY)"
  [ "$r" = "DEGRADED|path down: egress (others healthy)" ] || { echo "  FAIL DEGRADED-egress: got=$r"; fail=1; }
  r="$(classify_mesh_state HEALTHY HEALTHY DEGRADED HEALTHY)"
  [ "$r" = "DEGRADED|path down: vpn (others healthy)" ] || { echo "  FAIL DEGRADED-vpn: got=$r"; fail=1; }
  r="$(classify_mesh_state HEALTHY HEALTHY HEALTHY DEGRADED)"
  [ "$r" = "DEGRADED|path down: watchtower (others healthy)" ] || { echo "  FAIL DEGRADED-watchtower: got=$r"; fail=1; }
  # BROKEN: 2+ down
  r="$(classify_mesh_state DEGRADED DEGRADED HEALTHY HEALTHY)"
  [ "$r" = "BROKEN|2+ paths down (selfcare=DEGRADED egress=DEGRADED vpn=HEALTHY watchtower=HEALTHY)" ] || { echo "  FAIL BROKEN-2: got=$r"; fail=1; }
  r="$(classify_mesh_state DEGRADED DEGRADED DEGRADED HEALTHY)"
  echo "$r" | grep -q '^BROKEN' || { echo "  FAIL BROKEN-3: got=$r"; fail=1; }
  r="$(classify_mesh_state DEGRADED DEGRADED DEGRADED DEGRADED)"
  echo "$r" | grep -q '^BROKEN' || { echo "  FAIL BROKEN-4: got=$r"; fail=1; }
  # DEGRADED with missing: 2+ UNKNOWN → DEGRADED (safety rail)
  r="$(classify_mesh_state UNKNOWN UNKNOWN HEALTHY HEALTHY)"
  echo "$r" | grep -q '^DEGRADED' || { echo "  FAIL DEGRADED 2-unknown: got=$r"; fail=1; }
  echo "$r" | grep -q 'selfcare' || { echo "  FAIL DEGRADED should list selfcare: got=$r"; fail=1; }
  echo "$r" | grep -q 'egress' || { echo "  FAIL DEGRADED should list egress: got=$r"; fail=1; }
  r="$(classify_mesh_state UNKNOWN UNKNOWN UNKNOWN HEALTHY)"
  echo "$r" | grep -q '^DEGRADED' || { echo "  FAIL DEGRADED 3-unknown: got=$r"; fail=1; }
  r="$(classify_mesh_state UNKNOWN UNKNOWN UNKNOWN UNKNOWN)"
  echo "$r" | grep -q '^DEGRADED' || { echo "  FAIL DEGRADED 4-unknown: got=$r"; fail=1; }
  # 1 UNKNOWN + others healthy → DEGRADED (single-input degradation; can't fully assert HEALTHY)
  r="$(classify_mesh_state UNKNOWN HEALTHY HEALTHY HEALTHY)"
  [ "$r" = "DEGRADED|missing: selfcare (one sense unreachable, can't fully assert)" ] || { echo "  FAIL 1-unknown + healthy: got=$r"; fail=1; }
  # UNKNOWN + DEGRADED → still DEGRADED, identified by the degraded path (mixed signal)
  r="$(classify_mesh_state DEGRADED UNKNOWN HEALTHY HEALTHY)"
  [ "$r" = "DEGRADED|path down: selfcare (others healthy)" ] || { echo "  FAIL UNKNOWN+DEGRADED: got=$r"; fail=1; }
  # --- read_prev_label + --edge ordering regression: prev MUST be captured before the write,
  #     else --edge compares the value to itself and never emits (the silent-forever reflex bug) ---
  _wd="$(mktemp -d)"; _sf="$_wd/s"
  [ -z "$(read_prev_label "$_sf")" ] || { echo "  FAIL read_prev_label missing-file should be empty"; fail=1; }
  printf 'BROKEN|2+ paths down (selfcare=DEGRADED egress=DEGRADED vpn=HEALTHY watchtower=HEALTHY)\n' > "$_sf"
  [ "$(read_prev_label "$_sf")" = "BROKEN" ] || { echo "  FAIL read_prev_label label-extract: got=$(read_prev_label "$_sf")"; fail=1; }
  printf 'HEALTHY|all 4 mesh paths up\n' > "$_sf"
  [ "$(read_prev_label "$_sf")" = "HEALTHY" ] || { echo "  FAIL read_prev_label HEALTHY: got=$(read_prev_label "$_sf")"; fail=1; }
  rm -rf "$_wd"
  [ "$fail" = 1 ] && { echo "smoke-test: FAIL"; exit 1; }
  echo "  ok: classify (12 cases: HEALTHY×1, DEGRADED×4-by-path, BROKEN×3, 2+UNKNOWN×3, 1UNKNOWN×1, MIXED×1)"
  echo "  ok: read_prev_label (3 cases: missing→empty, BROKEN, HEALTHY) — guards the --edge prev-capture ordering"
  echo "smoke-test: ok (12 fusion + 3 edge-ordering = 15 assertions)"
  exit 0
fi

# --- Live read path ---
sc="$(classify_selfcare "$MESH/.selfcare-state")"
eg="$(classify_egress "$MESH/.egress-state")"
# watchtower: read its state file (no live call — too heavy for a 5-min fusion)
wt="$(classify_watchtower "$MESH/.watchtower-state")"
# vpn: live SSH reachability probe to phaedra (or the configured VPN host from .mesh/nodes)
vpn_target="$(grep -oE 'phaedra:[^ ]+' ~/.mesh/nodes 2>/dev/null | head -1 | cut -d: -f2)"
vp="$(classify_vpn "$vpn_target")"

result="$(classify_mesh_state "$sc" "$eg" "$vp" "$wt")"
label="${result%%|*}"
reason="${result#*|}"

# Capture the PRIOR label BEFORE overwriting STATE — otherwise --edge reads the value we just
# wrote, prev_label always equals label, and the reflex NEVER emits a transition (silent-forever).
prev_label="$(read_prev_label "$STATE")"

TS=$(date -u +%Y-%m-%dT%H:%M:%SZ)
# Write state + touch liveness on EVERY successful run (mtime = ran-live, content = value-changed)
printf '%s|%s\n' "$label" "$reason" > "$STATE"
mesh-state-touch "$STATE"

# --- Output ---
if [ "${1:-}" = --json ]; then
  printf '{"label":"%s","reason":"%s","inputs":{"selfcare":"%s","egress":"%s","vpn":"%s","watchtower":"%s"},"ts":"%s"}\n' \
    "$label" "$reason" "$sc" "$eg" "$vp" "$wt" "$TS"
  exit 0
fi
if [ "${1:-}" = --edge ]; then
  # prev_label was captured ABOVE, before the write — emit only on a real transition.
  [ "$prev_label" = "$label" ] && exit 0
  printf '[mesh-%s] %s — %s\n' "$(printf '%s' "$label" | tr '[:upper:]' '[:lower:]')" "$label" "$reason"
  exit 0
fi
printf '[mesh-%s] %s — %s\n' "$(printf '%s' "$label" | tr '[:upper:]' '[:lower:]')" "$label" "$reason"
