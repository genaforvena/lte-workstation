#!/usr/bin/env bash
# mesh-breath — verify HOW each node breathes (its access path actually works), so the steward never
# re-discovers reachability mid-task and never falsely says "blocked on access". Our breath = text over
# SSH in tmux. Read-only probes. See knowledge/how-nodes-breathe.md.
set -uo pipefail
NODES=(
  "default-string|imozerov@100.125.157.75"
  "ilya|ilya@100.107.198.111"
  "redmi-10|-p 8022 u0_a386@100.103.99.16"
  "router-GL-MT3000|root@100.92.205.67"
)
echo "=== mesh-breath $(date -u +%FT%TZ) — does each node breathe? (ssh/Tailscale) ==="
printf "%-20s %-7s %s\n" NODE BREATH VIA
for e in "${NODES[@]}"; do
  name="${e%%|*}"; args="${e#*|}"
  if timeout 10 ssh -o BatchMode=yes -o ConnectTimeout=6 $args 'echo ok' 2>/dev/null | grep -q ok; then
    printf "%-20s %-7s ssh %s\n" "$name" "OK" "$args"
  else
    printf "%-20s %-7s ssh %s  (down — try LAN/phone-hop alt)\n" "$name" "DOWN" "$args"
  fi
done
