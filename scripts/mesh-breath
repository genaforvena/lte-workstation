#!/usr/bin/env bash
# mesh-breath — verify HOW each node breathes (its access path actually works), so the steward never
# re-discovers reachability mid-task and never falsely says "blocked on access". Our breath = text over
# SSH in tmux. Read-only probes. See knowledge/how-nodes-breathe.md.
set -uo pipefail
if [ "${1:-}" = --test ]; then
  command -v ssh >/dev/null 2>&1 || { echo "smoke-test: FAIL (no ssh)"; exit 1; }
  command -v timeout >/dev/null 2>&1 || { echo "smoke-test: FAIL (no timeout)"; exit 1; }
  [ -f "$HOME/.mesh/nodes" ] && [ ! -r "$HOME/.mesh/nodes" ] && { echo "smoke-test: FAIL (~/.mesh/nodes unreadable)"; exit 1; }

  # Dry-run: test the core parsing logic with a synthetic nodes file
  # (no actual SSH connections — just verify the parser extracts name/args/port correctly)
  test_nodes=$(mktemp)
  cat > "$test_nodes" <<'EOF'
MESH_NODES="idea:imozerov@100.73.170.56 phaedra:root@38.49.216.141 phone:u0_a386@192.168.8.146:8022 local:local"
EOF

  # Source the test file and run the parsing logic in a subshell
  nodes_out=$(
    NODES_FILE="$test_nodes"
    NODES=()
    if [ -f "$NODES_FILE" ]; then
      while IFS='=' read -r k v; do
        case "$k" in MESH_NODES|MESH_NODES_INNER)
          v="${v#\"}"; v="${v%\"}"
          for entry in $v; do
            name="${entry%%:*}"; rest="${entry#*:}"
            [ "$rest" = "local" ] && continue
            NODES+=("$name|$rest")
          done ;;
        esac
      done < "$NODES_FILE"
    fi
    # Simulate the output loop (without SSH)
    for e in "${NODES[@]}"; do
      name="${e%%|*}"; args="${e#*|}"; port=""
      case "$args" in *@*:[0-9]*) port="${args##*:}"; args="${args%:*}";; esac
      [ -z "$port" ] && case "$args" in u0_a*@*) port="8022";; esac
      printf '%s|%s|%s\n' "$name" "$args" "${port:-22}"
    done
  )
  rm -f "$test_nodes"

  # Verify parser output
  echo "$nodes_out" | grep -q '^idea|imozerov@100.73.170.56|22$' \
    || { echo "smoke-test: FAIL (parser: idea node)"; exit 1; }
  echo "$nodes_out" | grep -q '^phaedra|root@38.49.216.141|22$' \
    || { echo "smoke-test: FAIL (parser: phaedra node)"; exit 1; }
  echo "$nodes_out" | grep -q '^phone|u0_a386@192.168.8.146|8022$' \
    || { echo "smoke-test: FAIL (parser: phone node with port)"; exit 1; }
  # local entry should be skipped
  echo "$nodes_out" | grep -q '^local|' && { echo "smoke-test: FAIL (local entry not skipped)"; exit 1; }

  echo "smoke-test: ok (deps + parser dry-run verified)"; exit 0
fi
# Source node list from ~/.mesh/nodes (plantability: no hardcoded IPs).
# Format: MESH_NODES="name:user@ip-or-local name2:user2@ip2:port ..."
# Optional :port suffix for non-22 sshd (phone bodies run on 8022).
NODES_FILE="$HOME/.mesh/nodes"
NODES=()
if [ -f "$NODES_FILE" ]; then
  while IFS='=' read -r k v; do
    case "$k" in MESH_NODES|MESH_NODES_INNER)
      v="${v#\"}"; v="${v%\"}"
      for entry in $v; do
        name="${entry%%:*}"; rest="${entry#*:}"
        [ "$rest" = "local" ] && continue   # skip localhost entries
        NODES+=("$name|$rest")
      done ;;
    esac
  done < "$NODES_FILE"
fi
[ ${#NODES[@]} -eq 0 ] && { echo "mesh-breath: no peer nodes in ~/.mesh/nodes — nothing to check"; exit 0; }
echo "=== mesh-breath $(date -u +%FT%TZ) — does each node breathe? (ssh/Tailscale) ==="
printf "%-20s %-7s %s\n" NODE BREATH VIA
for e in "${NODES[@]}"; do
  name="${e%%|*}"; args="${e#*|}"; port=""
  case "$args" in *@*:[0-9]*) port="${args##*:}"; args="${args%:*}";; esac
  # Termux phone bodies listen on 8022, not 22 (PHONE_SSH_PORT doctrine default). NOTE: keep
  # the :port form OUT of ~/.mesh/nodes for now — mesh-peer-addr/mesh-verify don't parse it.
  [ -z "$port" ] && case "$args" in u0_a*@*) port="${PHONE_SSH_PORT:-8022}";; esac
  if timeout 10 ssh ${port:+-p "$port"} -o BatchMode=yes -o ConnectTimeout=6 $args 'echo ok' 2>/dev/null | grep -q ok; then
    printf "%-20s %-7s ssh %s\n" "$name" "OK" "$args${port:+ -p $port}"
  else
    printf "%-20s %-7s ssh %s  (down — try LAN/phone-hop alt)\n" "$name" "DOWN" "$args${port:+ -p $port}"
  fi
done
