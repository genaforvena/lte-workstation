#!/usr/bin/env bash
# reflex-cadence: 3-58/5 * * * *
# reflex-args: --edge
# mesh-room-activity — room ACTIVITY-LEVEL fusion: HOW is the room being used?
#
# Folds six existing sense organs into a richer signal than occupancy alone.
# No single sensor gives activity level; the fusion does.
#   motion (body):    CARRIED/HANDLED/COVERED/STILL/UNKNOWN  (strongest: handled=active, carried=transition)
#   audio (local):    SILENCE/QUIET/MODERATE/LOUD/CLIPPING   (sound energy in the room)
#   wifi (node-local): STILL/MOTION/UNCERTAIN + WEAK/MODERATE/STRONG intensity  (device-free RSSI-drift
#                     motion radar — reads the NODE's own nmcli tape ~/.mesh/wifi.log, NO phone needed,
#                     so it survives the phone/body going offline; self-degrades to UNCERTAIN on stale tape)
#   ble (local):      count + closest device + rssi          (who/what is near)
#   light (phone):    DARK/DIM/MODERATE/LIT/BRIGHT           (context: dark = likely night/low activity)
#   media (lan):      AWAKE:<n>/NONE/UNKNOWN — which media renderers (TV/DIAL) answer SSDP right now.
#                     READ-ONLY on mesh-upnp-census's STATE artifact (~/.mesh/.upnp-census — its header
#                     blesses exactly this: consume the artifact, don't re-sweep). Device-level truth the
#                     mic can't give: a MUTED/paused TV is still AWAKE; a TV in standby is NOT. Derived
#                     signals (senses 2026-07-03): renderer awake + sound energy = firm media session
#                     (SSDP corroborates what audio alone could only guess); renderer awake + EMPTY room
#                     = "media LEFT-ON" annotation. Stale/missing census = UNREACHABLE (degraded), never NONE.
#
# Verdicts (activity level, not binary occupancy):
#   QUIET   — occupied/still: reading, desk work, sleeping, parked phone
#   ACTIVE  — person moving/engaged: walking, typing, cooking, handling phone
#   SOCIAL  — multiple activity signs: conversation, media playing, collaborative work
#   EMPTY   — all signals agree no one is present
#   UNCERTAIN — conflicting or missing data (distinguishable from EMPTY — never fakes all-clear)
#
# Honest-fusion contract:
#   - An UNREACHABLE input (phone offline, mic n/a, BLE scan locked) is rendered
#     as "[UNREACHABLE] <what>" in the degraded list, NOT silently treated as empty.
#   - If >1 axis is unreachable AND no axis confirms occupancy, verdict is UNCERTAIN
#     with degraded="unreachable" — visibly different from a genuine EMPTY room.
#   - Genuine empty: all axes empty, all reachable. Unreachable: any axis failed to read.
#
# Exit: 0 = verdict produced; 2 = cannot assess at all (all inputs unreachable)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
MESH_DIR="${MESH_DIR:-$HOME/.mesh}"
[ -f "$MESH_DIR/nodes" ] && . "$MESH_DIR/nodes" 2>/dev/null || true

# --- Config ---
MODE="${1:-oneshot}"
STATE="$MESH_DIR/.room-activity.state"
PENDING="$MESH_DIR/.room-activity.pending"
OFFLINE_FLAG="$MESH_DIR/.room-activity-offline"
# Resolve the phone LAN-FIRST: mesh-phone-ip does LAN discovery (the phone is often OFF Tailscale but
# reachable on the home LAN). mesh-peer-addr returns ONLY the Tailscale IP — CLOSED when the phone drops
# off the tailnet → this sense would falsely read phone-offline though it's reachable on LAN (observed
# 2026-06-21). Reachability is still gated by the tcp probe below, so a stale cached IP degrades honestly.
# GATE the probe behind MODE: the hermetic --test / --sample-media / --fuse-fixture modes NEVER use
# PHONE_IP (only _sample_light does, in the live path), and each --test fixture subshell re-execs this
# script → resolving here re-ran a ~10s live mesh-phone-ip probe 8× (phone offline), blowing mesh-doctor's
# 12s smoke budget → recurring false-FAIL. Only the live sampling path resolves it.
case "$MODE" in
  --test|--sample-media|--fuse-fixture) PHONE_IP="${PHONE_IP:-}" ;;
  *)
    PHONE_IP="${PHONE_IP:-$(mesh-phone-ip 2>/dev/null | tail -1)}"
    [ -n "$PHONE_IP" ] || PHONE_IP="$(mesh-peer-addr Redmi 2>/dev/null || true)"
    ;;
esac
PHONE_PORT="${PHONE_SSH_PORT:-8022}"
PHONE_USER="${PHONE_USER:-u0_a380}"

TS="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
HOST="$(hostname)"

# --- Smoke test (EARLY — before any live sense probe) ---
# The old --test ran the full fusion FIRST (phone probes time out ~16s with the phone offline)
# then merely echoed "ok" REGARDLESS of result — asserting nothing, yet slow enough to bust
# mesh-doctor's 12s smoke timeout → recurring false-FAIL cry-wolf (the rotating-smoke-FAIL class).
# This checks the tool's real dependency contract instead — the five sense organs it fuses + the
# python3 json helper must exist — which actually catches dependency/rename drift (the old test
# could not) and runs in <0.1s with NO live/outbound probe. (A logic-level smoke would need the
# inline classifier extracted into a callable function — noted as a follow-up.)
if [ "$MODE" = "--test" ]; then
  fail=0
  for d in python3 mesh-body-motion mesh-wifi-motion mesh-light mesh-presence mesh-ambient-level; do
    command -v "$d" >/dev/null 2>&1 || { echo "  FAIL: missing fused-sense dep: $d"; fail=1; }
  done

  # media-axis fixtures (senses 2026-07-03): hermetic + fast — temp state files + --sample-media /
  # --fuse-fixture subprocess drives; still no live/outbound probe (mesh-doctor 12s budget holds).
  _td="$(mktemp -d)"; trap 'rm -rf "$_td"' EXIT
  _chk() { [ "$2" = "$3" ] || { echo "  FAIL: $1 → '$2' (want '$3')"; fail=1; }; }
  # fresh PRESENT with a tv renderer + a router → AWAKE:1 (router/server kinds don't count)
  printf 'sig=x\nPRESENT n=2 192.168.8.130=tv,media 192.168.8.1=router @ h ts\n' > "$_td/c1"
  _chk "fresh tv census"    "$(MESH_ROOM_MEDIA_STATE="$_td/c1" bash "$0" --sample-media)" "AWAKE:1|1"
  # fresh EMPTY → NONE, reachable
  printf 'sig=\nEMPTY n=0 (lan-ok) @ h ts\n' > "$_td/c2"
  _chk "fresh empty census" "$(MESH_ROOM_MEDIA_STATE="$_td/c2" bash "$0" --sample-media)" "NONE|1"
  # STALE census → UNKNOWN + unreachable (the honest-degraded assert: stale is NEVER read as NONE)
  touch -d '2000-01-01' "$_td/c1"
  _chk "stale census"       "$(MESH_ROOM_MEDIA_STATE="$_td/c1" bash "$0" --sample-media)" "UNKNOWN|0"
  _chk "missing census"     "$(MESH_ROOM_MEDIA_STATE="$_td/nope" bash "$0" --sample-media)" "UNKNOWN|0"
  # fusion: renderer awake + LOUD → SOCIAL media session (device-level corroboration)
  f1="$(FIX_AUDIO=LOUD FIX_AUDIO_R=1 FIX_MEDIA=AWAKE:1 FIX_MEDIA_R=1 bash "$0" --fuse-fixture)"
  case "$f1" in SOCIAL\|media\ session*) : ;; *) echo "  FAIL: LOUD+awake fuse → '$f1' (want SOCIAL|media session…)"; fail=1 ;; esac
  # fusion: renderer awake + MODERATE (body offline) → ACTIVE media session
  f2="$(FIX_AUDIO=MODERATE FIX_AUDIO_R=1 FIX_MEDIA=AWAKE:1 FIX_MEDIA_R=1 bash "$0" --fuse-fixture)"
  case "$f2" in ACTIVE\|media\ session*) : ;; *) echo "  FAIL: MODERATE+awake fuse → '$f2' (want ACTIVE|media session…)"; fail=1 ;; esac
  # fusion: empty room + renderer awake → verdict stays EMPTY, reason gains the left-on annotation
  f3="$(FIX_BODY=STILL FIX_BODY_R=1 FIX_AUDIO=SILENCE FIX_AUDIO_R=1 FIX_WIFI=STILL FIX_WIFI_R=1 \
        FIX_LIGHT=LOW FIX_LIGHT_R=1 FIX_BLE=NONE FIX_BLE_R=1 FIX_MEDIA=AWAKE:1 FIX_MEDIA_R=1 bash "$0" --fuse-fixture)"
  case "$f3" in EMPTY\|*media\ left-on*) : ;; *) echo "  FAIL: empty+awake fuse → '$f3' (want EMPTY|…media left-on…)"; fail=1 ;; esac
  # fusion: media axis unreachable → visibly degraded, never a silent all-clear
  f4="$(FIX_AUDIO=QUIET FIX_AUDIO_R=1 bash "$0" --fuse-fixture)"
  case "$f4" in *media:unreachable*) : ;; *) echo "  FAIL: unreachable media not in degraded: '$f4'"; fail=1 ;; esac

  [ "$fail" = 0 ] && { echo "smoke-test: ok — fused-sense deps present + media-axis fixtures: 8 (sample fresh/empty/stale/missing + fuse session/moderate/left-on/degraded; hermetic, no live probe)"; exit 0; } \
                  || { echo "smoke-test: FAIL (dependency or media-axis contract broken)"; exit 1; }
fi

# --- Helpers ---
json_escape() { python3 -c 'import json,sys; print(json.dumps(sys.stdin.read()))'; }

# --- Sense sampling (each returns via globals: value, reach, raw) ---

_sample_body() {
  body_val="UNKNOWN"; body_reach=0; body_raw=""
  local out
  out="$(timeout 15 mesh-body-motion 2>/dev/null)" || return 0
  if [ -n "$out" ]; then
    body_reach=1
    body_raw="$out"
    case "$out" in
      *CARRIED*) body_val="CARRIED" ;;
      *HANDLED*) body_val="HANDLED" ;;
      *COVERED*) body_val="COVERED" ;;
      *STILL*)   body_val="STILL"   ;;
    esac
  fi
}

_sample_audio() {
  audio_val="UNKNOWN"; audio_reach=0; audio_raw=""
  local out
  if command -v mesh-ambient-level >/dev/null 2>&1; then
    out="$(timeout 5 mesh-ambient-level 2>/dev/null)" || true
    if [ -n "$out" ]; then
      audio_reach=1
      audio_raw="$out"
      if printf '%s' "$out" | grep -q 'CLIPPING'; then
        audio_val="CLIPPING"
      elif printf '%s' "$out" | grep -q 'LOUD'; then
        audio_val="LOUD"
      elif printf '%s' "$out" | grep -q 'MODERATE'; then
        audio_val="MODERATE"
      elif printf '%s' "$out" | grep -q 'QUIET'; then
        audio_val="QUIET"
      elif printf '%s' "$out" | grep -q 'SILENCE'; then
        audio_val="SILENCE"
      fi
    fi
  fi
}

_sample_wifi() {
  # mesh-wifi-motion is NODE-LOCAL device-free radar (reads ~/.mesh/wifi.log, the node's own nmcli
  # tape — NO phone dependency; self-degrades to exit 2 / UNCERTAIN on a stale or thin tape). The old
  # code gated this axis behind PHONE_IP tcp-reachability, which falsely marked it UNREACHABLE whenever
  # the phone dropped — losing a perfectly good device-free motion axis exactly when body-motion (the
  # OTHER motion sense, on the phone) is ALSO down. Call it directly and let its OWN honest-degraded
  # path drive reachability: exit!=0 (UNCERTAIN/stale → empty stdout) => axis stays unreachable.
  wifi_val="UNKNOWN"; wifi_reach=0; wifi_raw=""; wifi_intensity="NONE"
  local out rc=0
  out="$(timeout 12 mesh-wifi-motion 2>/dev/null)" || rc=$?
  if [ "$rc" -eq 0 ] && [ -n "$out" ]; then
    wifi_raw="$out"
    case "$out" in
      *MOTION*)    wifi_val="MOTION"; wifi_reach=1 ;;
      *STILL*)     wifi_val="STILL";  wifi_reach=1 ;;
      *UNCERTAIN*) wifi_val="UNCERTAIN" ;;            # can't-assess => NOT a trustworthy axis (reach=0)
    esac
    # thread the intensity enrichment (WEAK/MODERATE/STRONG/NONE) through for the fusion to grade motion
    case "$out" in *intensity=*) wifi_intensity="${out##*intensity=}"; wifi_intensity="${wifi_intensity%% *}" ;; esac
  fi
}

_sample_light() {
  light_val="UNKNOWN"; light_reach=0; light_raw=""
  if [ -z "$PHONE_IP" ] || ! timeout 2 bash -c "echo >/dev/tcp/$PHONE_IP/$PHONE_PORT" 2>/dev/null; then
    return 0
  fi
  local out
  out="$(timeout 10 mesh-light 2>/dev/null)" || true
  if [ -n "$out" ]; then
    light_reach=1
    light_raw="$out"
    if printf '%s' "$out" | grep -qE 'BRIGHT|LIT|MODERATE'; then
      light_val="LIT"
    elif printf '%s' "$out" | grep -qE 'DARK|DIM'; then
      light_val="LOW"
    fi
  fi
}

_sample_ble() {
  ble_val="NONE"; ble_reach=0; ble_raw=""
  local out
  out="$(timeout 15 mesh-presence 3 2>/dev/null)" || true
  if [ -n "$out" ]; then
    ble_reach=1
    ble_raw="$out"
    local count=0
    count="$(printf '%s' "$out" | grep -cE '^-?[0-9]+\|')" || true
    if [ "$count" -gt 0 ]; then
      local strong
      strong="$(printf '%s' "$out" | grep -iE 'JBL|AirPods|Galaxy Buds|Pixel|iPhone|Redmi|Watch|Band' | head -1)"
      if [ -n "$strong" ]; then
        ble_val="PERSONAL:STRONG"
      else
        local any="$(printf '%s' "$out" | grep -v '^?' | head -1)"
        if [ -n "$any" ]; then
          ble_val="DEVICES:$count"
        else
          ble_val="UNKNOWN:$count"
        fi
      fi
    fi
  fi
}

_sample_media() {
  # LAN media renderers awake, from mesh-upnp-census's STATE (read-only, no re-sweep). The file is
  # rewritten unconditionally every census run → mtime IS liveness; older than ~3 cron strides
  # (census cadence 15m) or missing → UNREACHABLE, visibly distinct from a genuine NONE.
  media_val="UNKNOWN"; media_reach=0; media_raw=""
  local f="${MESH_ROOM_MEDIA_STATE:-$MESH_DIR/.upnp-census}" stale="${MESH_ROOM_MEDIA_STALE:-2700}"
  [ -f "$f" ] || return 0
  local mt age; mt="$(stat -c %Y "$f" 2>/dev/null || echo 0)"; age=$(( $(date +%s) - mt ))
  [ "$age" -le "$stale" ] || return 0
  local line; line="$(sed -n 2p "$f" 2>/dev/null)"
  case "$line" in
    PRESENT\ *)
      media_reach=1; media_raw="$line"
      local n=0 tok kinds
      for tok in $line; do
        case "$tok" in *=*) kinds="${tok#*=}";; *) continue;; esac
        case ",$kinds," in *,tv,*|*,media,*) n=$((n+1)) ;; esac   # renderer kinds only — a NAS "server"/router awake isn't room media
      done
      if [ "$n" -gt 0 ]; then media_val="AWAKE:$n"; else media_val="NONE"; fi ;;
    EMPTY\ *) media_reach=1; media_raw="$line"; media_val="NONE" ;;
  esac
}

# --- Fusion engine ---
_fuse_activity() {
  verdict="UNCERTAIN"
  reason=""
  degraded=""
  confidence="low"
  local degraded_parts=()

  [ "$body_reach"  = 1 ] || degraded_parts+=("body:unreachable")
  [ "$audio_reach" = 1 ] || degraded_parts+=("audio:unreachable")
  [ "$wifi_reach"  = 1 ] || degraded_parts+=("wifi:unreachable")
  [ "$light_reach" = 1 ] || degraded_parts+=("light:unreachable")
  [ "$ble_reach"   = 1 ] || degraded_parts+=("ble:unreachable")
  [ "$media_reach" = 1 ] || degraded_parts+=("media:unreachable")

  local reachable=0
  [ "$body_reach"  = 1 ] && reachable=$((reachable + 1))
  [ "$audio_reach" = 1 ] && reachable=$((reachable + 1))
  [ "$wifi_reach"  = 1 ] && reachable=$((reachable + 1))
  [ "$light_reach" = 1 ] && reachable=$((reachable + 1))
  [ "$ble_reach"   = 1 ] && reachable=$((reachable + 1))
  [ "$media_reach" = 1 ] && reachable=$((reachable + 1))

  local media_awake=0
  case "$media_val" in AWAKE:*) media_awake=1 ;; esac

  # Count occupancy-confirming signals
  local occupancy_signals=0
  [ "$body_val"  = "CARRIED" ]       && occupancy_signals=$((occupancy_signals + 2))
  [ "$body_val"  = "HANDLED" ]       && occupancy_signals=$((occupancy_signals + 2))
  [ "$wifi_val"  = "MOTION" ]        && occupancy_signals=$((occupancy_signals + 1))
  [ "$audio_val" = "MODERATE" ]      && occupancy_signals=$((occupancy_signals + 1))
  [ "$audio_val" = "LOUD" ]          && occupancy_signals=$((occupancy_signals + 2))
  [ "$audio_val" = "CLIPPING" ]      && occupancy_signals=$((occupancy_signals + 2))
  case "$ble_val" in
    PERSONAL:STRONG) occupancy_signals=$((occupancy_signals + 1)) ;;
    DEVICES:*|UNKNOWN:*) occupancy_signals=$((occupancy_signals + 1)) ;;
  esac

  # Determine verdict by fusion rules (priority-ordered)
  if [ "$body_val" = "CARRIED" ] || [ "$body_val" = "HANDLED" ]; then
    verdict="ACTIVE"
    reason="body=$body_val (phone in motion)"
    confidence="high"
  elif [ "$audio_val" = "CLIPPING" ] || [ "$audio_val" = "LOUD" ]; then
    if [ "$wifi_val" = "MOTION" ] || [ "$body_val" = "CARRIED" ]; then
      verdict="SOCIAL"
      reason="loud audio + motion → social/multi-person activity"
      confidence="medium"
    elif [ "$media_awake" = 1 ]; then
      # two independent organs corroborate a media session: acoustic energy (mic) + a renderer
      # answering SSDP (device-level truth) — firmer than "loud audio" alone can ever be
      verdict="SOCIAL"
      reason="media session — renderer awake ($media_val) + audio=$audio_val"
      confidence="high"
    else
      verdict="ACTIVE"
      reason="audio=$audio_val (significant sound energy)"
      confidence="medium"
    fi
  elif [ "$media_awake" = 1 ] && [ "$audio_val" = "MODERATE" ]; then
    # the old body=STILL+MODERATE path could only guess "media playing?"; the census confirms it,
    # and this path also survives the phone/body being offline entirely
    verdict="ACTIVE"
    reason="media session at moderate volume — renderer awake ($media_val) + audio=MODERATE"
    confidence="medium"
  elif [ "$wifi_val" = "MOTION" ]; then
    if [ "$wifi_intensity" = "STRONG" ] && { [ "$audio_val" = "MODERATE" ] || [ "$audio_val" = "LOUD" ] || [ "$audio_val" = "CLIPPING" ]; }; then
      verdict="SOCIAL"
      reason="STRONG device-free motion + audible sound → vigorous/multi-person activity"
      confidence="medium"
    elif [ "$audio_val" = "MODERATE" ]; then
      verdict="ACTIVE"
      reason="WiFi motion (intensity=$wifi_intensity) + moderate audio"
      confidence="medium"
    else
      verdict="ACTIVE"
      reason="WiFi motion detected (intensity=$wifi_intensity)"
      [ "$wifi_intensity" = "STRONG" ] && confidence="high" || confidence="medium"
    fi
  elif [ "$body_val" = "STILL" ] && [ "$audio_val" = "SILENCE" ] && [ "$wifi_val" = "STILL" ] \
       && [ "$ble_val" = "NONE" ] && [ "$light_val" = "LOW" ]; then
    verdict="EMPTY"
    reason="all signals still/silent/dark/no-BLE → room empty"
    confidence="high"
  elif [ "$body_val" = "STILL" ] && [ "$audio_val" = "SILENCE" ] && [ "$wifi_val" = "STILL" ] \
       && [ "$ble_val" = "NONE" ] && [ "$light_val" = "LIT" ]; then
    verdict="EMPTY"
    reason="all signals still/silent/no-BLE (lights on, but no activity)"
    confidence="medium"
  elif [ "$body_val" = "STILL" ] || [ "$body_val" = "COVERED" ]; then
    if [ "$audio_val" = "SILENCE" ] || [ "$audio_val" = "QUIET" ]; then
      verdict="QUIET"
      reason="body=$body_val + quiet audio → still/calm activity"
      confidence="medium"
    elif [ "$audio_val" = "MODERATE" ]; then
      verdict="ACTIVE"
      reason="body=$body_val + moderate audio (media playing?)"
      confidence="low"
    else
      verdict="QUIET"
      reason="body=$body_val, audio=$audio_val — low activity"
      confidence="low"
    fi
  elif [ "$occupancy_signals" -gt 0 ]; then
    # Some signals suggest presence but no specific motion pattern
    verdict="UNCERTAIN"
    reason="some occupancy signals ($occupancy_signals) but no clear activity pattern"
    confidence="low"
  elif [ "$reachable" -eq 0 ]; then
    verdict="UNCERTAIN"
    reason="no sensors reachable — cannot assess room state"
    confidence="low"
  elif [ "$reachable" -le 2 ]; then
    verdict="UNCERTAIN"
    reason="insufficient data (${reachable} of 6 sensors reachable)"
    confidence="low"
  else
    verdict="UNCERTAIN"
    reason="mixed/inconclusive signals: body=$body_val audio=$audio_val wifi=$wifi_val light=$light_val ble=$ble_val media=$media_val"
    confidence="low"
  fi

  # Derived LEFT-ON signal: a renderer answering SSDP in a room every other axis reads as empty —
  # the TV was left on (or is idling awake). Annotation only: the verdict stays EMPTY (the ROOM is
  # empty; the anomaly is the device), lower-case wording so no consumer's verdict-token grep trips.
  if [ "$verdict" = "EMPTY" ] && [ "$media_awake" = 1 ]; then
    reason="$reason; media left-on (renderer awake in empty room: $media_val)"
  fi

  # Build degraded string
  if [ ${#degraded_parts[@]} -gt 0 ]; then
    local IFS=","; degraded="${degraded_parts[*]}"
  else
    degraded="none"
  fi

  # Adjust confidence if degraded
  if [ "$degraded" != "none" ]; then
    case "$confidence" in
      high) confidence="medium (degraded)" ;;
      medium) confidence="low (degraded)" ;;
    esac
  fi
}

# --- Hidden fixture modes (hermetic --test harness: no live probes, pure function drive) ---
if [ "$MODE" = "--sample-media" ]; then
  _sample_media
  printf '%s|%s\n' "$media_val" "$media_reach"
  exit 0
fi
if [ "$MODE" = "--fuse-fixture" ]; then
  body_val="${FIX_BODY:-UNKNOWN}";   body_reach="${FIX_BODY_R:-0}"
  audio_val="${FIX_AUDIO:-UNKNOWN}"; audio_reach="${FIX_AUDIO_R:-0}"
  wifi_val="${FIX_WIFI:-UNKNOWN}";   wifi_reach="${FIX_WIFI_R:-0}"; wifi_intensity="${FIX_WIFI_INT:-NONE}"
  light_val="${FIX_LIGHT:-UNKNOWN}"; light_reach="${FIX_LIGHT_R:-0}"
  ble_val="${FIX_BLE:-NONE}";        ble_reach="${FIX_BLE_R:-0}"
  media_val="${FIX_MEDIA:-UNKNOWN}"; media_reach="${FIX_MEDIA_R:-0}"
  _fuse_activity
  printf '%s|%s|%s\n' "$verdict" "$reason" "$degraded"
  exit 0
fi

# --- Main ---
MODE_VAL="${1:-oneshot}"

# Sample all axes
_sample_body
_sample_audio
_sample_wifi
_sample_light
_sample_ble
_sample_media

# Run fusion engine
_fuse_activity

# Build signals string
signals="body=$body_val($body_reach) audio=$audio_val($audio_reach) wifi=$wifi_val/$wifi_intensity($wifi_reach) light=$light_val($light_reach) ble=$ble_val($ble_reach) media=$media_val($media_reach)"

# Output based on mode
case "$MODE_VAL" in
  --json)
    printf '{"verdict":"%s","confidence":"%s","degraded":"%s","reason":"%s","signals":"%s","ts":"%s"}\n' \
      "$verdict" "$confidence" "$degraded" "$reason" "$signals" "$TS"
    ;;
  --edge)
    PEND="$MESH_DIR/.room-activity.pending"
    prev="$(cat "$STATE" 2>/dev/null || true)"
    pending="$(cat "$PEND" 2>/dev/null || true)"
    pverdict="${pending%%:*}"; pcount="${pending##*:}"
    if [ -z "$prev" ]; then
      printf '%s\n' "$verdict" > "$STATE"
      rm -f "$PEND"
    elif [ "$verdict" = "$prev" ]; then
      rm -f "$PEND"
    elif [ "$verdict" = "$pverdict" ]; then
      pcount=$(( ("${pcount:-0}") + 1 ))
      if [ "$pcount" -ge 2 ]; then
        printf '%s\n' "$verdict" > "$STATE"
        rm -f "$PEND"
        # Misha dormant-by-default (operator 2026-06-24, tier-1): defer to mesh-room-sense's occupancy
        # authority (.room-sense.occ sidecar = PRESENT+high = non-audio: cam/kbd/body/BLE/wifi). Only emit
        # the WAKE-SIGNAL edge line if the room is CONFIRMED-occupied — never wake Misha off ambient sound.
        # STATE still updates (data panes read it); only the reactive wake signal is gated.
        # MISHA_CONFIRMED_ONLY=0 opts out (legacy behavior).
        _occ="$(cat "$MESH_DIR/.room-sense.occ" 2>/dev/null || echo unconfirmed)"
        if [ "${MISHA_CONFIRMED_ONLY:-1}" != 1 ] || [ "$_occ" = "confirmed" ]; then
          printf '[room-activity] %s on %s: %s (%s) | conf=%s degraded=%s | signals: %s\n' \
            "$verdict" "$HOST" "$reason" "$TS" "$confidence" "$degraded" "$signals"
        fi
      else
        printf '%s:%d\n' "$verdict" "$pcount" > "$PEND"
      fi
    else
      printf '%s:1\n' "$verdict" > "$PEND"
    fi
    [ -e "$STATE" ] && touch "$STATE" 2>/dev/null
    ;;
  *)
    printf 'room-activity: %s — %s | conf=%s degraded=[%s] | signals: %s\n' \
      "$verdict" "$reason" "$confidence" "$degraded" "$signals"
    ;;
esac
