#!/usr/bin/env bash
# mesh-room-activity — room ACTIVITY fusion: audio-energy + body-motion + light
# → QUIET / ACTIVE / SOCIAL. No single sense gives room-social-activity — audio
# says "loud/quiet", body says "still/moving", light says "dark/lit"; fused
# they distinguish a quiet empty room from a quiet occupied room from a party.
#
# Fusion:
#   QUIET   = audio=SILENT/QUIET + body=STILL → room still and quiet
#   ACTIVE  = audio=MODERATE/LOUD OR body=CARRIED/HANDLED → someone active
#   SOCIAL  = audio=MODERATE/LOUD AND body=CARRIED/HANDLED → active AND moving
#   DARK    = any state + light=DARK + no audio/body activity → dark rest
#   DEGRADED = inputs weak (but phone reachable)
#   Exit 2  = phone unreachable — cannot assess
#
#   mesh-room-activity            one-shot room activity label
#   mesh-room-activity --edge     emit only on state change (2-consecutive)
#   mesh-room-activity --json     machine-readable
#   mesh-room-activity --test     smoke test (exit 2 = phone unreachable)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

STATE="$HOME/.mesh/.room-activity.state"
OFFLINEFILE="$HOME/.mesh/.room-activity-offline"

if [ "${1:-}" = --test ]; then
  command -v mesh-audio-energy >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-audio-energy)"; exit 1; }
  command -v mesh-body-motion >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-body-motion)"; exit 1; }
  command -v mesh-light >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-light)"; exit 1; }
  mesh-light --test >/dev/null 2>&1; rc=$?
  [ "$rc" = 2 ] && { echo "smoke-test: n/a (phone unreachable — no room activity)"; exit 2; }
  [ "$rc" = 0 ] || { echo "smoke-test: FAIL (mesh-light --test rc=$rc)"; exit 1; }
  echo "smoke-test: ok"; exit 0
fi

MODE=text; [ "${1:-}" = --json ] && MODE=json
EDGE=0; [ "${1:-}" = --edge ] && EDGE=1
TS=$(date -u +%H:%M:%SZ)

# --- Audio energy (phone, ~4s) ---
ae_j="$(timeout 15 mesh-audio-energy --json 2>/dev/null)" || ae_j=""
if [ -n "$ae_j" ]; then
  audio_state="$(printf '%s' "$ae_j" | grep -oE '"state":"[^"]*"' | cut -d'"' -f4)"
  audio_rms="$(printf '%s' "$ae_j" | grep -oE '"rms":[0-9.]+' | cut -d: -f2)"
else
  audio_state="UNKNOWN"; audio_rms=""
fi
# Audio energy can fail if no mic consent — treat as unknown, not unreachable
if [ -z "$audio_state" ] || [ "$audio_state" = "UNKNOWN" ]; then
  phone_unreachable=0
  audio_state="UNKNOWN"
fi

# --- Body motion ---
bm_out="$(timeout 12 mesh-body-motion 2>/dev/null)"; bm_rc=$?
if [ "$bm_rc" = 2 ]; then
  phone_unreachable=1
  bm_state="UNKNOWN"; bm_steps=""
else
  phone_unreachable=0
  bm_tag="$(printf '%s' "$bm_out" | grep -oE '\[body-[a-z]+\]' | tr -d '[]')"
  case "${bm_tag##*-}" in
    still)   bm_state="STILL";;
    carried) bm_state="CARRIED";;
    handled) bm_state="HANDLED";;
    covered) bm_state="COVERED";;
    *)       bm_state="UNKNOWN";;
  esac
  bm_steps="$(printf '%s' "$bm_out" | grep -oE 'Δ[+-][0-9]+' | tr -d 'Δ+' | head -1)"
  bm_steps="${bm_steps:-0}"
fi

# --- Ambient light ---
light="$(timeout 10 mesh-light 2>/dev/null || true)"
# mesh-light emits 5 levels — map DARK/DIM→DARK, MODERATE/LIT/BRIGHT→LIT (matches mesh-room-sense)
if printf '%s' "$light" | grep -qE 'BRIGHT|LIT|MODERATE'; then
  light_state="LIT"
elif printf '%s' "$light" | grep -qE 'DARK|DIM'; then
  light_state="DARK"
else
  light_state="UNKNOWN"
fi

# --- Honest-degraded ---
if [ "$phone_unreachable" = 1 ]; then
  if [ ! -f "$OFFLINEFILE" ]; then echo "room-activity: phone unreachable — cannot assess" >&2; touch "$OFFLINEFILE"; fi
  exit 2
fi
rm -f "$OFFLINEFILE"

# --- Fusion ---
activity=""; reason=""; signals="audio=${audio_state}(rms=${audio_rms:-?}) body=${bm_state} light=${light_state}"

if [ "$audio_state" = "UNKNOWN" ] && [ "$bm_state" = "UNKNOWN" ]; then
  activity="DEGRADED"; reason="both audio and body unavailable"
elif [ "$audio_state" = "LOUD" ] && { [ "$bm_state" = "CARRIED" ] || [ "$bm_state" = "HANDLED" ]; }; then
  activity="SOCIAL"; reason="loud room, someone active"
elif [ "$audio_state" = "LOUD" ] && [ "$bm_state" = "STILL" ]; then
  activity="ACTIVE"; reason="loud room (audio), occupant still"
elif [ "$audio_state" = "MODERATE" ] && { [ "$bm_state" = "CARRIED" ] || [ "$bm_state" = "HANDLED" ]; }; then
  activity="SOCIAL"; reason="moderate audio + body active"
elif [ "$audio_state" = "MODERATE" ] || [ "$bm_state" = "CARRIED" ] || [ "$bm_state" = "HANDLED" ]; then
  activity="ACTIVE"; reason="moderate audio or body active"
elif [ "$bm_state" = "COVERED" ]; then
  activity="QUIET"; reason="phone covered (pocket/face-down)"
elif [ "$light_state" = "DARK" ] && [ "$bm_state" = "STILL" ]; then
  activity="DARK"; reason="dark room, occupant still"
elif [ "$light_state" = "LIT" ] && [ "$bm_state" = "STILL" ]; then
  activity="QUIET"; reason="quiet lit room, occupant still"
elif [ "$audio_state" = "SILENT" ] || [ "$audio_state" = "QUIET" ]; then
  activity="QUIET"; reason="audio quiet, no body activity"
elif [ "$bm_state" = "STILL" ]; then
  activity="QUIET"; reason="occupant still, no significant audio"
else
  activity="DEGRADED"; reason="mixed/unclear signals"
fi

if [ "$MODE" = json ]; then
  printf '{"activity":"%s","audio_state":"%s","body_state":"%s","light":"%s","reason":"%s","ts":"%s"}\n' \
    "$activity" "$audio_state" "$bm_state" "$light_state" "$reason" "$TS"
  exit 0
fi

if [ "$EDGE" = 1 ]; then
  PENDING="${STATE%.state}.pending"
  confirmed="$(cat "$STATE" 2>/dev/null || true)"
  pending_line="$(cat "$PENDING" 2>/dev/null || true)"
  pending="${pending_line%%:*}"; pcount="${pending_line##*:}"; pcount="${pcount:-0}"
  if [ -z "$confirmed" ]; then
    printf '%s\n' "$activity" > "$STATE"; rm -f "$PENDING"
  elif [ "$activity" = "$confirmed" ]; then
    rm -f "$PENDING"
  elif [ "$activity" = "$pending" ]; then
    pcount=$((pcount + 1))
    if [ "$pcount" -ge 2 ]; then
      printf '%s\n' "$activity" > "$STATE"; rm -f "$PENDING"
      printf '[room-activity] %s — %s | %s\n' "$activity" "$reason" "$signals"
    else
      printf '%s:%d\n' "$activity" "$pcount" > "$PENDING"
    fi
  else
    printf '%s:1\n' "$activity" > "$PENDING"
  fi
  exit 0
fi

printf '[room-activity] %s — %s | %s\n' "$activity" "$reason" "$signals"
