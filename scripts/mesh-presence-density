#!/usr/bin/env bash
# reflex-cadence: 2-59/5 * * * *
# reflex-args: --edge
# mesh-presence-density — cross-sense fusion: HOW BUSY IS THE ROOM?
# Combines 4 senses into a single density classification no single sensor gives.
#
# Inputs (all best-effort, each independently OFFLINE-able; 2+ missing → DEGRADED):
#   mesh-presence        .presence-state      n=count + attribution=personal:N,appliance:N,ambiguous:N
#   mesh-room-sense      .room-sense.state    PRESENT/EMPTY/UNCERTAIN
#   mesh-activity-tempo  .activity-tempo.state BUSTLE/RESTING/SILENT/INITIAL
#   mesh-light           .light-state         DARK/DIM/MODERATE/LIT/BRIGHT/OFFLINE
#
# No single sensor answers "is the room crowded or empty?" — presence count says "N devices"
# but not whether they're active; activity-tempo says "BUSTLE" but not how many people;
# room-sense says "PRESENT" but not the magnitude. Fused, they give a single density band.
#
# Classification (FALSIFIABLE via --test, priority order):
#   CROWDED   n>=8 OR (n>=5 AND activity=BUSTLE)   — many people or active crowd
#   BUSY      n>=3 OR (n>=2 AND activity=BUSTLE)     — some activity
#   MODERATE  n>=1                                     — at least one person
#   EMPTY     n=0                                       — no one here (room sense = EMPTY preferred)
#   DEGRADED  2+ inputs OFFLINE                        — can't tell, never a confident label
#
# Honest-fusion: 2+ OFFLINE → DEGRADED with explicit missing list (a consumer reading
# "DEGRADED|missing: presence,activity-tempo" sees that 2 senses are unreachable — never
# confused with "EMPTY" which is the strong claim "0 devices, room empty, 0 activity").
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes" 2>/dev/null || true

STATE="$HOME/.mesh/.presence-density-state"
MESH="${MESH_DIR:-$HOME/.mesh}"
STALE_S=600

# read_presence_count <state> → echoes integer count of BLE devices, or OFFLINE
# mesh-presence writes `count=N strongest=...` (first field is "count=N", not "n=N").
read_presence_count() {
  local f="$1" v now m
  [ -f "$f" ] || { echo "OFFLINE"; return; }
  now=$(date +%s); m=$(stat -c %Y "$f" 2>/dev/null || echo "$now")
  if [ $((now - m)) -gt "$STALE_S" ]; then echo "OFFLINE"; return; fi
  v="$(head -1 "$f" 2>/dev/null | grep -oE 'count=[0-9]+' | head -1 | cut -d= -f2)"
  [ -n "$v" ] || { echo "OFFLINE"; return; }
  printf '%s' "$v"
}

# read_room_sense <state> → echoes PRESENT|EMPTY|UNCERTAIN|OFFLINE
read_room_sense() {
  local f="$1" v now m
  [ -f "$f" ] || { echo "OFFLINE"; return; }
  now=$(date +%s); m=$(stat -c %Y "$f" 2>/dev/null || echo "$now")
  if [ $((now - m)) -gt "$STALE_S" ]; then echo "OFFLINE"; return; fi
  v="$(head -1 "$f" 2>/dev/null | awk '{print $1}' | cut -d'|' -f1)"  # LABEL|dwell_s=N|.. → LABEL
  case "$v" in
    PRESENT|EMPTY|UNCERTAIN) printf '%s' "$v" ;;
    *) echo "UNCERTAIN" ;;
  esac
}

# read_activity_tempo <state> → echoes BUSTLE|RESTING|SILENT|INITIAL|OFFLINE
read_activity_tempo() {
  local f="$1" v now m
  [ -f "$f" ] || { echo "OFFLINE"; return; }
  now=$(date +%s); m=$(stat -c %Y "$f" 2>/dev/null || echo "$now")
  if [ $((now - m)) -gt "$STALE_S" ]; then echo "OFFLINE"; return; fi
  v="$(head -1 "$f" 2>/dev/null | awk '{print $1}' | cut -d'|' -f1)"  # LABEL|dwell_s=N|.. → LABEL
  case "$v" in
    BUSTLE|RESTING|SILENT|INITIAL) printf '%s' "$v" ;;
    *) echo "INITIAL" ;;
  esac
}

# read_light <state> → echoes DARK|DIM|MODERATE|LIT|BRIGHT|OFFLINE
read_light() {
  local f="$1" v now m
  [ -f "$f" ] || { echo "OFFLINE"; return; }
  now=$(date +%s); m=$(stat -c %Y "$f" 2>/dev/null || echo "$now")
  if [ $((now - m)) -gt "$STALE_S" ]; then echo "OFFLINE"; return; fi
  v="$(head -1 "$f" 2>/dev/null | cut -d'|' -f1)"
  case "$v" in
    DARK|DIM|MODERATE|LIT|BRIGHT) printf '%s' "$v" ;;
    *) echo "OFFLINE" ;;
  esac
}

# classify_density <count> <room> <tempo> <light> → "LABEL|reason" — pure, offline-testable
classify_density() {
  local n="$1" room="$2" tempo="$3" light="$4"
  # Compute degraded list FIRST (2+ missing → DEGRADED takes priority over non-numeric count).
  local degraded=""
  [ "$n" = "OFFLINE" ] && degraded="${degraded}presence,"
  [ "$room" = "OFFLINE" ] && degraded="${degraded}room-sense,"
  [ "$tempo" = "OFFLINE" ] && degraded="${degraded}activity-tempo,"
  [ "$light" = "OFFLINE" ] && degraded="${degraded}light,"
  degraded="${degraded%,}"
  local degen=0
  [ "$n" = "OFFLINE" ] && degen=$((degen+1))
  [ "$room" = "OFFLINE" ] && degen=$((degen+1))
  [ "$tempo" = "OFFLINE" ] && degen=$((degen+1))
  [ "$light" = "OFFLINE" ] && degen=$((degen+1))
  if [ "$degen" -ge 2 ]; then
    echo "DEGRADED|missing: $degraded (too many senses unreachable for confident verdict)"
    return
  fi
  # Defensive: count is non-numeric (1 OFFLINE doesn't trigger DEGRADED above; treat as degraded too)
  if ! printf '%d' "$n" >/dev/null 2>&1; then
    if [ "$n" = "OFFLINE" ]; then
      echo "DEGRADED|missing: presence (1 sense offline, can't fully assert)"
    else
      echo "DEGRADED|non-numeric count (n=$n)"
    fi
    return
  fi
  # CROWDED: many people OR (some people AND active tempo)
  if [ "$n" -ge 8 ] || { [ "$n" -ge 5 ] && [ "$tempo" = "BUSTLE" ]; }; then
    if [ "$n" -ge 8 ]; then
      echo "CROWDED|n=$n (many devices, room=$room, tempo=$tempo)"
    else
      echo "CROWDED|n=$n tempo=BUSTLE (active crowd)"
    fi
    return
  fi
  # BUSY: some activity
  if [ "$n" -ge 3 ] || { [ "$n" -ge 2 ] && [ "$tempo" = "BUSTLE" ]; }; then
    if [ "$n" -ge 3 ]; then
      echo "BUSY|n=$n (multiple devices, tempo=$tempo)"
    else
      echo "BUSY|n=$n tempo=BUSTLE (some activity)"
    fi
    return
  fi
  # MODERATE: at least one person
  if [ "$n" -ge 1 ]; then
    echo "MODERATE|n=$n (at least one device, room=$room, tempo=$tempo)"
    return
  fi
  # EMPTY: no devices — only confident when room-sense agrees
  if [ "$room" = "EMPTY" ] || [ "$n" = "0" ]; then
    echo "EMPTY|n=0 room=$room (no devices present)"
    return
  fi
  # n=0 but room not empty (e.g. UNCERTAIN) → still EMPTY as the strong claim
  echo "EMPTY|n=$n (no devices)"
}

if [ "${1:-}" = --test ]; then
  fail=0
  # CROWDED: n>=8
  r="$(classify_density 10 PRESENT BUSTLE MODERATE)"
  echo "$r" | grep -q '^CROWDED' || { echo "  FAIL CROWDED-n10: got=$r"; fail=1; }
  # CROWDED: n>=5 AND BUSTLE
  r="$(classify_density 6 PRESENT BUSTLE DIM)"
  echo "$r" | grep -q '^CROWDED' || { echo "  FAIL CROWDED-n6-bustle: got=$r"; fail=1; }
  # CROWDED: n=5 with BUSTLE
  r="$(classify_density 5 PRESENT BUSTLE DIM)"
  echo "$r" | grep -q '^CROWDED' || { echo "  FAIL CROWDED-n5-bustle: got=$r"; fail=1; }
  # CROWDED: n=4 with RESTING (NOT crowd, falls through to BUSY)
  r="$(classify_density 4 PRESENT RESTING DIM)"
  echo "$r" | grep -q '^BUSY' || { echo "  FAIL n4-resting: got=$r (should be BUSY)"; fail=1; }
  # CROWDED: n=5 with RESTING (NOT crowd, falls through to BUSY)
  r="$(classify_density 5 PRESENT RESTING DIM)"
  echo "$r" | grep -q '^BUSY' || { echo "  FAIL n5-resting: got=$r (should be BUSY)"; fail=1; }
  # BUSY: n>=3
  r="$(classify_density 4 PRESENT RESTING DIM)"
  echo "$r" | grep -q '^BUSY' || { echo "  FAIL BUSY-n4: got=$r"; fail=1; }
  # BUSY: n>=2 AND BUSTLE
  r="$(classify_density 2 PRESENT BUSTLE DIM)"
  echo "$r" | grep -q '^BUSY' || { echo "  FAIL BUSY-n2-bustle: got=$r"; fail=1; }
  # BUSY: n=3 with RESTING
  r="$(classify_density 3 PRESENT RESTING DIM)"
  echo "$r" | grep -q '^BUSY' || { echo "  FAIL BUSY-n3-resting: got=$r"; fail=1; }
  # MODERATE: n=1
  r="$(classify_density 1 PRESENT RESTING DIM)"
  [ "$r" = "MODERATE|n=1 (at least one device, room=PRESENT, tempo=RESTING)" ] || { echo "  FAIL MODERATE-n1: got=$r"; fail=1; }
  # MODERATE: n=2 with RESTING (NOT enough for BUSY)
  r="$(classify_density 2 PRESENT RESTING DIM)"
  echo "$r" | grep -q '^MODERATE' || { echo "  FAIL MODERATE-n2-resting: got=$r"; fail=1; }
  # EMPTY: n=0 + room=EMPTY
  r="$(classify_density 0 EMPTY SILENT DARK)"
  [ "$r" = "EMPTY|n=0 room=EMPTY (no devices present)" ] || { echo "  FAIL EMPTY-n0-empty: got=$r"; fail=1; }
  # EMPTY: n=0 + room=PRESENT (room sense stale, n=0 wins)
  r="$(classify_density 0 PRESENT SILENT DARK)"
  echo "$r" | grep -q '^EMPTY' || { echo "  FAIL EMPTY-n0-present: got=$r"; fail=1; }
  # DEGRADED: 2 OFFLINE
  r="$(classify_density OFFLINE PRESENT BUSTLE MODERATE)"
  echo "$r" | grep -q '^DEGRADED' || { echo "  FAIL DEGRADED 2-offline: got=$r"; fail=1; }
  echo "$r" | grep -q 'presence' || { echo "  FAIL DEGRADED should list presence: got=$r"; fail=1; }
  # DEGRADED: 3 OFFLINE
  r="$(classify_density OFFLINE OFFLINE BUSTLE MODERATE)"
  echo "$r" | grep -q '^DEGRADED' || { echo "  FAIL DEGRADED 3-offline: got=$r"; fail=1; }
  # DEGRADED: all 4 OFFLINE
  r="$(classify_density OFFLINE OFFLINE OFFLINE OFFLINE)"
  echo "$r" | grep -q '^DEGRADED' || { echo "  FAIL DEGRADED 4-offline: got=$r"; fail=1; }
  # 1 missing (single) — should NOT trigger DEGRADED-with-missing (only 1 missing); but n=OFFLINE
  # is non-numeric so it triggers the "1-missing-can't-fully-assert" path. The honest read is
  # "DEGRADED|missing: presence (1 sense offline)" — distinct from the 2+ DEGRADED case.
  r="$(classify_density OFFLINE PRESENT BUSTLE MODERATE)"
  echo "$r" | grep -q '^DEGRADED' || { echo "  FAIL 1-missing: got=$r (should be DEGRADED)"; fail=1; }
  echo "$r" | grep -q 'presence' || { echo "  FAIL 1-missing should list presence in missing: got=$r"; fail=1; }
  # Non-numeric count
  r="$(classify_density abc PRESENT BUSTLE MODERATE)"
  echo "$r" | grep -q '^DEGRADED' || { echo "  FAIL non-numeric count: got=$r"; fail=1; }
  [ "$fail" = 1 ] && { echo "smoke-test: FAIL"; exit 1; }
  echo "  ok: classify (19 cases: CROWDED×3, BUSY×4, MODERATE×2, EMPTY×2, DEGRADED×4, 1-missing, non-numeric)"
  # multi-field vocab-contract assert: room-sense enriches as LABEL|dwell_s=N|changes_24h=N.
  _mf="$(mktemp)"; printf 'PRESENT|dwell_s=120|changes_24h=5\n' > "$_mf"
  _got="$(read_room_sense "$_mf")"; rm -f "$_mf"
  [ "$_got" = PRESENT ] || { echo "smoke-test: FAIL (read_room_sense on LABEL|dwell_s= gave '$_got', expected PRESENT — dwell enrichment collapsed it to UNCERTAIN)"; exit 1; }
  echo "smoke-test: ok (19 fusion assertions + multi-field label parse)"
  exit 0
fi

# --- Live read path ---
n="$(read_presence_count "$MESH/.presence-state")"
room="$(read_room_sense "$MESH/.room-sense.state")"
tempo="$(read_activity_tempo "$MESH/.activity-tempo.state")"
light="$(read_light "$MESH/.light-state")"

result="$(classify_density "$n" "$room" "$tempo" "$light")"
label="${result%%|*}"
reason="${result#*|}"

TS=$(date -u +%Y-%m-%dT%H:%M:%SZ)
# Write state + touch liveness on EVERY successful run (mtime = ran-live, content = value-changed)
printf '%s|n=%s|room=%s|tempo=%s|light=%s|%s\n' "$label" "$n" "$room" "$tempo" "$light" "$reason" > "$STATE"
mesh-state-touch "$STATE"

# --- Output ---
if [ "${1:-}" = --json ]; then
  printf '{"label":"%s","reason":"%s","inputs":{"presence":%s,"room":"%s","tempo":"%s","light":"%s"},"ts":"%s"}\n' \
    "$label" "$reason" "$n" "$room" "$tempo" "$light" "$TS"
  exit 0
fi
if [ "${1:-}" = --edge ]; then
  prev=""; [ -f "$STATE" ] && read -r prev _ < "$STATE" 2>/dev/null || true
  prev_label="${prev%%|*}"
  [ "$prev_label" = "$label" ] && exit 0
  printf '[density-%s] %s — %s\n' "$(printf '%s' "$label" | tr '[:upper:]' '[:lower:]')" "$label" "$reason"
  exit 0
fi
printf '[density-%s] %s — %s\n' "$(printf '%s' "$label" | tr '[:upper:]' '[:lower:]')" "$label" "$reason"
