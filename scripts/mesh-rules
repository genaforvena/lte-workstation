#!/usr/bin/env bash
# mesh-rules — validate/show the editable engine-neutral procedural contract.
# The source is deliberately plain Markdown: operators can add, edit, or remove one rule bullet.
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
usage() { printf 'usage: %s --check [MESH.md] | --show [MESH.md]\n' "$0" >&2; }
mode="${1:---check}"
file="${2:-$root/MESH.md}"

case "$mode" in
  --show)
    test -r "$file" || { echo "mesh-rules: missing $file" >&2; exit 2; }
    cat "$file"
    ;;
  --check)
    test -r "$file" || { echo "mesh-rules: missing $file" >&2; exit 2; }
    python3 - "$file" <<'PY'
import re, sys
from pathlib import Path

p = Path(sys.argv[1])
text = p.read_text()
ids = re.findall(r'^- `([^`]+)` — ', text, flags=re.M)
if not ids:
    raise SystemExit("mesh-rules: no rule bullets found")
bad = [x for x in ids if not re.fullmatch(r"mesh:[0-9]+", x)]
if bad:
    raise SystemExit("mesh-rules: invalid rule id(s): " + ", ".join(bad))
dupes = sorted({x for x in ids if ids.count(x) > 1})
if dupes:
    raise SystemExit("mesh-rules: duplicate rule id(s): " + ", ".join(dupes))
required = ("node-owned", "external-event", "before/after evidence", "MESH.md", "mesh-unblock")
missing = [x for x in required if x not in text]
if missing:
    raise SystemExit("mesh-rules: missing contract text: " + ", ".join(missing))
print(f"mesh-rules: PASS ({len(ids)} unique rules; source={p})")
PY
    ;;
  *) usage; exit 2 ;;
esac
