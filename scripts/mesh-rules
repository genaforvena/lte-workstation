#!/usr/bin/env bash
# mesh-rules — validate/show the editable engine-neutral procedural contract.
# The source is deliberately plain Markdown: operators can add, edit, or remove one rule bullet.
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
usage() { printf 'usage: %s --check [MESH.md] | --show [MESH.md]\n' "$0" >&2; }
mode="${1:---check}"
file="${2:-$root/MESH.md}"

case "$mode" in
  --show)
    test -r "$file" || { echo "mesh-rules: missing $file" >&2; exit 2; }
    cat "$file"
    ;;
  --check)
    test -r "$file" || { echo "mesh-rules: missing $file" >&2; exit 2; }
    python3 - "$file" <<'PY'
import re, sys
from pathlib import Path

p = Path(sys.argv[1])
text = p.read_text()
ids = re.findall(r'^- `([^`]+)` — ', text, flags=re.M)
if not ids:
    raise SystemExit("mesh-rules: no rule bullets found")
bad = [x for x in ids if not re.fullmatch(r"mesh:[0-9]+", x)]
if bad:
    raise SystemExit("mesh-rules: invalid rule id(s): " + ", ".join(bad))
dupes = sorted({x for x in ids if ids.count(x) > 1})
if dupes:
    raise SystemExit("mesh-rules: duplicate rule id(s): " + ", ".join(dupes))
required = ("node-owned", "external-event", "before/after evidence", "MESH.md", "mesh-unblock")
missing = [x for x in required if x not in text]
if missing:
    raise SystemExit("mesh-rules: missing contract text: " + ", ".join(missing))
# Invariant registry: fenced ```invariant-registry block with `rev: N` + typed rows.
m = re.search(r"```invariant-registry\n(.*?)```", text, flags=re.S)
if not m:
    raise SystemExit("mesh-rules: missing ```invariant-registry block")
block = m.group(1)
rm = re.search(r"^rev:\s*(\S+)", block, flags=re.M)
if not rm:
    raise SystemExit("mesh-rules: invariant-registry has no rev:")
rows = [ln for ln in block.splitlines() if ln.startswith("id=")]
if not rows:
    raise SystemExit("mesh-rules: invariant-registry has no rows")
seen, rids = {}, []
for ln in rows:
    kv = dict(p.split("=", 1) for p in ln.split(" | ") if "=" in p)
    for f in ("id", "owner", "scope", "precedence", "source", "preflight"):
        if f not in kv or not kv[f].strip():
            raise SystemExit(f"mesh-rules: registry row missing field {f}: {ln[:80]}")
    try:
        int(kv["precedence"])
    except ValueError:
        raise SystemExit(f"mesh-rules: registry precedence not an integer: {ln[:80]}")
    rids.append(kv["id"])
dupes_r = sorted({x for x in rids if rids.count(x) > 1})
if dupes_r:
    raise SystemExit("mesh-rules: duplicate registry id(s): " + ", ".join(dupes_r))
print(f"mesh-rules: PASS ({len(ids)} unique rules; registry rev={rm.group(1)} rows={len(rows)}; source={p})")
PY
    ;;
  *) usage; exit 2 ;;
esac
