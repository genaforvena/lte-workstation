#!/usr/bin/env python3
# orphan-ok: on-demand (chat agent, invoked by operator need not cron)
"""mesh-chat-agent — answers the OPERATOR in the chat room (typed OR voice), in their language,
and speaks the reply. Makes the chat a real conversation. Free model (opencode), with memory.

Watches ~/.mesh/chat.log; when the operator posts (WHO like imozerov@…, or voice@…), it replies
via opencode in the operator's language (Russian if they write Russian), posts the reply to chat
as 'меш', and speaks it. Ignores agents and itself — no loops.

Config: CA_VOICE (ryan)  CA_MIND (opencode|claude)
"""
import os, subprocess, time, re, shutil, sys

def _source_nodes():
    """Source ~/.mesh/nodes into os.environ."""
    p = os.path.expanduser("~/.mesh/nodes")
    if not os.path.exists(p): return
    with open(p) as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith("#"): continue
            if "=" in line:
                k, v = line.split("=", 1)
                k, v = k.strip(), v.strip().strip('"').strip("'")
                if k and k not in os.environ: os.environ[k] = v

_source_nodes()

LOG       = os.path.expanduser(os.environ.get("CA_LOG", "~/.mesh/chat.log"))
VOICE     = os.environ.get("CA_VOICE", "ryan")
MIND      = os.environ.get("CA_MIND", "opencode")
SELF      = "меш"
MESH_TTS  = os.path.expanduser(os.environ.get("MESH_TTS", "~/.local/bin/mesh-tts"))
MESH_CHAT = os.path.expanduser(os.environ.get("MESH_CHAT", "~/.local/bin/mesh-chat"))
HISTORY   = []

OPERATOR  = re.compile(os.environ.get("CA_OPERATOR_PATTERN", r"^(imozerov@|voice@|оператор|operator)"), re.I)
IGNORE    = re.compile(r"(меш|steward|babysitter|session-|mesh-say|mesh-trace)", re.I)

def parse(line):
    m = re.match(r"^\S+\s+(.+?)\s+::\s+(.*)$", line)     # "TS  WHO  ::  msg"
    return (m.group(1).strip(), m.group(2).strip()) if m else (None, None)

def is_operator(who, msg):
    if not who or IGNORE.search(who): return False
    if msg.startswith(("[task]","[taking]","[done]","COORD","RESTORE","said aloud:")): return False
    return bool(OPERATOR.search(who))

PROMPT = ("Ты — голос меша lte-workstation, ведёшь живой разговор с оператором. "
          "Отвечай НА ТОМ ЖЕ ЯЗЫКЕ, что и оператор (по-русски, если он пишет по-русски). "
          "Коротко: 1-3 живых предложения, без markdown и списков. Можешь выполнять read-only "
          "команды (mesh-health, mesh-census, tailscale status), чтобы ответить.\n\n"
          "Разговор:\n{convo}\n\nОператор: \"{t}\"\nМеш:")

# shell-command scaffolding the model may append to its answer — strip so only NL prose is spoken
# (chat-review 2026-06-19; shared with mesh-converse). Markers absent from genuine prose; conservative.
SCAFFOLD = re.compile(
    r'\(\s*(?:mesh-|tailscale)'
    r'|(?<![\w./-])mesh-[a-z0-9-]+\s*(?:\||$)'
    r'|(?<![\w./-])tailscale\b[^.!?\n]*\|'
    r'|\|\s*(?:grep|awk|wc|sed|head|tail|cut|sort|uniq)\b',
    re.I)

def clean(out):
    lines = [l for l in out.splitlines() if l.strip()
             and l.strip()[0] not in "█┃╹▀⬝✦✻●▣╭╰│╮╯─━⏵⎿"
             and not any(k in l.lower() for k in ("tokens","ctrl+","opencode","build ·","esc to","· $"))]
    cut = []
    for l in lines:
        m = SCAFFOLD.search(l)
        head = (l[:m.start()] if m else l).strip()
        if head:
            cut.append(head)
    return " ".join((cut or lines)[-8:]).strip()

def think(text):
    prompt = PROMPT.format(convo="\n".join(HISTORY[-8:]), t=text.replace('"', "'"))
    try:
        if MIND == "claude":
            r = subprocess.run(["claude","-p",prompt], capture_output=True, text=True, timeout=150)
            reply = r.stdout.strip()
        else:
            r = subprocess.run(["opencode","run",prompt], capture_output=True, text=True, timeout=150)
            reply = clean(r.stdout.strip())
    except Exception as e:
        reply = f"сбой: {str(e)[:40]}"
    HISTORY.append(f"Оператор: {text}"); HISTORY.append(f"Меш: {reply}")
    return reply or "(пусто)"

def post(msg):
    subprocess.run([MESH_CHAT, msg[:400]], capture_output=True, env={**os.environ, "MESH_WHO": SELF})

def speak(msg):
    if os.path.exists(MESH_TTS):
        subprocess.run([MESH_TTS, VOICE, msg[:500], "local"], capture_output=True, timeout=90)

def main():
    if len(sys.argv) > 1 and sys.argv[1] == "--test":
        if not shutil.which("python3"):
            print("smoke-test: FAIL (no python3)")
            raise SystemExit(1)
        if not os.path.isfile(LOG):
            print(f"smoke-test: FAIL (chat log unreadable: {LOG})")
            raise SystemExit(1)
        if not os.access(MESH_CHAT, os.X_OK):
            print(f"smoke-test: FAIL (mesh-chat not executable: {MESH_CHAT})")
            raise SystemExit(1)
        who, msg = parse("2026-06-12T00:00:00Z imozerov@node :: привет, mesh")
        if who != "imozerov@node" or msg != "привет, mesh":
            print("smoke-test: FAIL (parse)")
            raise SystemExit(1)
        if not is_operator("imozerov@node", "привет"):
            print("smoke-test: FAIL (operator detection)")
            raise SystemExit(1)
        if is_operator("меш", "привет"):
            print("smoke-test: FAIL (self-ignore)")
            raise SystemExit(1)
        print("smoke-test: ok")
        raise SystemExit(0)

    print("[chat-agent] слушаю чат — отвечаю оператору (текст или голос) на его языке.", flush=True)
    with open(LOG) as f:
        f.seek(0, 2)                                     # start at the end (only new messages)
        while True:
            line = f.readline()
            if not line:
                time.sleep(0.4); continue
            who, msg = parse(line.rstrip("\n"))
            if not msg or not is_operator(who, msg):
                continue
            print(f"[chat-agent] operator: {msg!r}", flush=True)
            reply = think(msg)
            post(reply)
            speak(reply)

if __name__ == "__main__":
    main()
