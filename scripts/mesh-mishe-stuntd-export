#!/usr/bin/env python3
"""Export pinned, privacy-validated cleaner pairs for local stuntd training."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
from pathlib import Path
import sys
import tempfile


def core_modules():
    core = Path(os.environ.get("MESH_MISHE_CORE", str(Path.home() / "mishe-tauftauf")))
    sys.path.insert(0, str(core / "src"))
    from mishe_tauftauf.external_view import safe_publish_delta_view
    from mishe_tauftauf.feed import Feed

    return safe_publish_delta_view, Feed


def export(manifest: Path, home: Path, output: Path, minimum: int) -> tuple[int, int]:
    safe_pair, Feed = core_modules()
    feed = {entry.sequence: entry for entry in Feed(home).entries()}
    seen_pairs: set[str] = set()
    rows: list[dict[str, str]] = []
    counts = {"yes": 0, "no": 0}
    for number, line in enumerate(manifest.read_text(encoding="utf-8").splitlines(), 1):
        if not line.strip():
            continue
        try:
            case = json.loads(line)
            if not isinstance(case, dict) or case.get("question_version") != "projected-pair-v1.1":
                raise ValueError("question version")
            label = case.get("expected_label")
            if not isinstance(case.get("basis"), str) or not case["basis"].strip():
                raise ValueError("label provenance")
            previous_seq, current_seq = case["previous_feed_sequence"], case["current_feed_sequence"]
            if not isinstance(previous_seq, int) or not isinstance(current_seq, int) or previous_seq > current_seq:
                raise ValueError("sequence")
            before, after = feed[previous_seq], feed[current_seq]
            if before.source != "observation/cleaner" or after.source != "observation/cleaner":
                raise ValueError("source")
            pair = safe_pair(before.body, after.body)
            if case.get("kind") == "invalid-prior-guard" and label == "unknown":
                if pair is not None:
                    raise ValueError("invalid guard accepted")
                continue
            if label not in counts:
                raise ValueError("label")
            digest = hashlib.sha256(pair.encode("utf-8")).hexdigest() if pair is not None else ""
            if not digest or digest != case.get("pair_sha256") or digest in seen_pairs:
                raise ValueError("pair validation or duplicate")
        except (KeyError, TypeError, ValueError, json.JSONDecodeError) as exc:
            raise ValueError(f"invalid labeled case on line {number}: {exc}") from exc
        seen_pairs.add(digest)
        counts[label] += 1
        rows.append({"text": pair, "answer": "true" if label == "yes" else "false"})
    if len(rows) < minimum or not all(counts.values()):
        raise ValueError(f"insufficient independent labels: total={len(rows)} yes={counts['yes']} no={counts['no']} required={minimum}")
    output.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    fd, temporary = tempfile.mkstemp(prefix=".stuntd-export-", dir=output.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            for row in rows:
                stream.write(json.dumps(row, ensure_ascii=True, sort_keys=True) + "\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.chmod(temporary, 0o600)
        os.replace(temporary, output)
    finally:
        Path(temporary).unlink(missing_ok=True)
    return counts["yes"], counts["no"]


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--manifest", required=True, type=Path)
    parser.add_argument("--home", type=Path, default=Path.home() / ".mesh/mishe-tauftauf")
    parser.add_argument("--output", required=True, type=Path)
    parser.add_argument("--min-examples", type=int, default=300)
    args = parser.parse_args()
    if args.min_examples < 2:
        parser.error("minimum must be at least two")
    try:
        yes, no = export(args.manifest, args.home, args.output, args.min_examples)
    except (OSError, UnicodeError, ValueError, ImportError) as exc:
        print(f"mesh-mishe-stuntd-export: UNKNOWN {exc}", file=sys.stderr)
        return 2
    print(f"mesh-mishe-stuntd-export: PASS total={yes + no} yes={yes} no={no}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
