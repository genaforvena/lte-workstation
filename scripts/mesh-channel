#!/usr/bin/env bash
# mesh-channel — a CHANNEL (operator, 2026-06-11): a tmux WINDOW with two panes —
#   TOP = the SOURCE (live updates), BOTTOM = a MIND session (callable; claude default).
# A reflex pulls new source updates, FILTERS them, and CONDITIONALLY feeds them into the mind's
# prompt box via tmux KEYSTROKES. mind != channel: the channel is the plumbing; the mind is slotted in.
#
#   mesh-channel <name> <source-file> [filter-cmd] [mind-cmd]
#     ensures the 2-pane window exists, then feeds NEW filtered source lines into the mind pane.
#     source-file : a file that grows with updates (top pane tails it live)
#     filter-cmd  : reads a source line on stdin → emits the PROMPT to feed (empty = skip). default: pass-through
#     mind-cmd    : command for the bottom pane. default: claude
#   Run by cron = the channel's heartbeat. State: ~/.mesh/channel/<name>.seen (lines already fed).
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
S="$(hostname)"; CH="$HOME/.mesh/channel"
if [ "${1:-}" = --test ]; then
  command -v tmux >/dev/null 2>&1 || { echo "smoke-test: FAIL (no tmux)"; exit 1; }
  tmux has-session -t "$S" 2>/dev/null || { echo "smoke-test: FAIL (no session $S)"; exit 1; }
  tmux list-windows -t "$S" -F '#{window_name}' 2>/dev/null >/dev/null || { echo "smoke-test: FAIL (tmux session unreadable)"; exit 1; }
  echo "smoke-test: ok"
  exit 0
fi
mkdir -p "$CH"
name="${1:?usage: mesh-channel <name> <source-file> [filter] [mind-cmd]}"
src="${2:?need source-file}"; filter="${3:-cat}"; mindcmd="${4:-claude}"
# UNIFORM-SESSION topology-awareness (2026-06-13): if the requested mind's binary is NOT present on
# this node, the bottom pane must NOT launch an absent binary (→ dead opencode/claude→bash pane; the
# storm class). Use the same REMOTE-NOTE the uniform manifest shows. Checked with the full mind-launch
# PATH (~/.opencode/bin, nvm) so an installed-but-not-in-login-PATH mind still counts as present.
_mbin="${mindcmd%% *}"
if ! bash -lc "export PATH=\"\$HOME/.opencode/bin:\$HOME/.bun/bin:\$HOME/.local/bin:\$PATH\"; [ -s \"\$HOME/.nvm/nvm.sh\" ] && . \"\$HOME/.nvm/nvm.sh\" >/dev/null 2>&1; command -v $_mbin" >/dev/null 2>&1; then
  mindcmd="echo; echo \"  channel $name — mind $_mbin is REMOTE on this node (not installed); source above is live\"; exec bash -l"
fi
WIN="$name"; seenf="$CH/$name.seen"; touch "$src"
[ -f "$seenf" ] || wc -l < "$src" > "$seenf"   # first run: start from NOW (don't flood the mind with history)
tmux has-session -t "$S" 2>/dev/null || { echo "no session $S"; exit 1; }

# (1) ensure the CHANNEL window: top pane = live source, bottom pane = mind session.
# Wrap the mind so its pane survives the mind exiting (drops to a login shell) — keeps the window a
# 2-pane channel that mesh-channel-keepalive can relaunch into, instead of the pane vanishing.
mw="bash -lc 'cd \$HOME/lte-workstation 2>/dev/null; $mindcmd; exec bash -l'"
if ! tmux list-windows -t "$S" -F '#{window_name}' 2>/dev/null | grep -qx "$WIN"; then
  tmux new-window -d -t "$S" -n "$WIN" "echo '== channel:$name — SOURCE (live) =='; tail -n 5 -F '$src'"
  tmux split-window -v -t "$S:$WIN" "$mw"             # bottom pane = the MIND
  tmux select-layout -t "$S:$WIN" even-vertical 2>/dev/null || true
  echo "channel '$name' created: top=source($src), bottom=mind($mindcmd)"
  sleep 2   # let the mind session start before first feed
elif ! tmux list-panes -t "$S:$WIN" -F '#{pane_index}' 2>/dev/null | grep -qx 1; then
  # window exists but is single-pane. If the lone pane is the source/a bare shell (legacy --watch
  # window) → add the MIND below. But if a LIVE occupant is in there (a mind TUI, an ssh) it IS the
  # mind slot — add the SOURCE above it instead (-b), never a second mind. Append-only either way.
  ppid=$(tmux display -p -t "$S:$WIN.0" '#{pane_pid}' 2>/dev/null)
  occ="$(pgrep -P "$ppid" 2>/dev/null | xargs -r ps -o args= -p 2>/dev/null)"
  if [ -z "$occ" ] || printf '%s' "$occ" | grep -qE '(^|/)tail '; then
    tmux split-window -v -t "$S:$WIN" "$mw"
    echo "channel '$name' upgraded: added mind($mindcmd) as bottom pane"
  else
    tmux split-window -vb -d -t "$S:$WIN.0" "echo '== channel:$name — SOURCE (live) =='; tail -n 5 -F '$src'"
    echo "channel '$name' upgraded: added source($src) above existing live pane (kept as mind slot)"
  fi
  tmux select-layout -t "$S:$WIN" even-vertical 2>/dev/null || true
  sleep 2
fi
# the MIND is the BOTTOM-most pane (largest pane_top) — same selector as mesh-tell/mesh-feed/
# mesh-mind-state. Hardcoded .1 broke whenever panes died/were added and indexes shifted.
mp=$(tmux list-panes -t "$S:$WIN" -F '#{pane_top} #{pane_index}' 2>/dev/null | sort -n | tail -1 | awk '{print $2}')
MINDPANE="$S:$WIN.${mp:-1}"

# (2) feed NEW source lines into the mind, conditionally (filter decides + shapes)
seen=$(cat "$seenf" 2>/dev/null || echo 0); total=$(wc -l < "$src")
[ "$total" -le "$seen" ] && { echo "channel[$name]: no new source lines"; exit 0; }
fed=0
tail -n +"$((seen+1))" "$src" | while IFS= read -r line; do
  [ -z "${line//[[:space:]]/}" ] && continue
  prompt="$(printf '%s' "$line" | bash -c "$filter" 2>/dev/null || true)"
  [ -z "${prompt//[[:space:]]/}" ] && continue          # filter said skip
  # keystroke-feed into the mind's prompt box (C-u clear, bracketed paste, settle, C-m submit —
  # paste-buffer -p not send-keys -l: codex's paste-burst detector eats a fast C-m, see mesh-tell)
  tmux send-keys -t "$MINDPANE" C-u 2>/dev/null; sleep 0.1
  printf '%s' "$prompt" | tmux load-buffer -b mch$$ - 2>/dev/null
  tmux paste-buffer -p -d -b mch$$ -t "$MINDPANE" 2>/dev/null; sleep 0.5
  tmux send-keys -t "$MINDPANE" C-m 2>/dev/null
  fed=$((fed+1))
done
echo "$total" > "$seenf"
echo "channel[$name]: fed $((total-seen)) new source line(s) → mind pane (filtered)"
