#!/usr/bin/env bash
# orphan-ok: on-demand kernel PTY allocation read; scheduled consumers are not yet defined
# mesh-pty-count — live count of allocated pseudo-terminals from procfs.
#
# This is a direct kernel reading: it reports how many PTY slots are currently allocated on
# this node.  Missing or malformed procfs is unreachable, never a fabricated zero.
# Exit codes: 0 = real reading emitted; 2 = procfs input unavailable or invalid.
set -u
set -o pipefail

PTY_FILE="${MESH_PTY_COUNT_FILE:-/proc/sys/kernel/pty/nr}"

read_count() {
  local value
  [ -r "$PTY_FILE" ] || return 2
  value="$(tr -d '[:space:]' <"$PTY_FILE" 2>/dev/null)" || return 2
  case "$value" in
    ''|*[!0-9]*) return 2 ;;
  esac
  printf '%s\n' "$value"
}

if [ "${1:-}" = --test ]; then
  td="$(mktemp -d "${TMPDIR:-/tmp}/mesh-pty-count.XXXXXX")" || exit 1
  trap 'rm -rf "$td"' EXIT
  printf '17\n' >"$td/nr"
  fixture="$(MESH_PTY_COUNT_FILE="$td/nr" "$0" --json)" || {
    echo 'smoke-test: FAIL (fixture PTY read)'; exit 1;
  }
  printf '%s\n' "$fixture" | grep -q '"pty_count":17' || {
    echo 'smoke-test: FAIL (fixture value)'; exit 1;
  }
  printf 'not-a-count\n' >"$td/bad"
  if MESH_PTY_COUNT_FILE="$td/bad" "$0" --json >/dev/null 2>&1; then
    echo 'smoke-test: FAIL (malformed procfs read succeeded)'; exit 1
  fi
  live_rc=0
  live="$(MESH_PTY_COUNT_FILE=/proc/sys/kernel/pty/nr "$0" --json 2>/dev/null)" || live_rc=$?
  case "$live_rc" in
    0) printf '%s\n' "$live" | grep -Eq '"status":"LIVE"|"pty_count":[0-9]+' || {
         echo 'smoke-test: FAIL (live read had no numeric artifact)'; exit 1;
       } ;;
    2) echo 'smoke-test: n/a (kernel PTY procfs unavailable)'; exit 2 ;;
    *) echo "smoke-test: FAIL (live read rc=$live_rc)"; exit 1 ;;
  esac
  echo "smoke-test: ok (fixture + REAL /proc/sys/kernel/pty/nr read: $(printf '%s' "$live" | sed -n 's/.*\"pty_count\":\([0-9][0-9]*\).*/\1/p'))"
  exit 0
fi

count="$(read_count)" || {
  echo "mesh-pty-count: UNKNOWN — cannot read $PTY_FILE" >&2
  exit 2
}
timestamp="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
case "${1:-}" in
  --json)
    printf '{"status":"LIVE","pty_count":%s,"source":"%s","observed_at":"%s"}\n' \
      "$count" "$PTY_FILE" "$timestamp"
    ;;
  *)
    printf '[pty-count] LIVE — allocated_ptys=%s observed_at=%s source=%s\n' \
      "$count" "$timestamp" "$PTY_FILE"
    ;;
esac
