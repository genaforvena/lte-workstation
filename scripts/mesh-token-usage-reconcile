#!/usr/bin/env python3
"""Informational reconciliation for normalized token-usage rows."""
import argparse
import json
from pathlib import Path


def canonical(value):
    return json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=False)


def reconcile(row):
    usage = row.get("usage") if isinstance(row.get("usage"), dict) else {}
    total, input_tokens = usage.get("total"), usage.get("input")
    output = usage.get("output")
    cached, reasoning = usage.get("cached_input"), usage.get("reasoning")
    missing = [name for name, value in (("total", total), ("input", input_tokens), ("output", output))
               if not isinstance(value, int) or isinstance(value, bool) or value < 0]
    if missing:
        total_check = "missing"
        status = "missing"
    else:
        total_check = "match" if total == input_tokens + output else "mismatch"
        status = "pass" if total_check == "match" else "mismatch"

    non_additive = "pass"
    non_additive_errors = []
    if cached is not None:
        if not isinstance(cached, int) or isinstance(cached, bool) or cached < 0 or (isinstance(input_tokens, int) and cached > input_tokens):
            non_additive = "mismatch"
            non_additive_errors.append("cached_input is not a non-negative subset of input")
    if reasoning is not None:
        if not isinstance(reasoning, int) or isinstance(reasoning, bool) or reasoning < 0 or (isinstance(output, int) and reasoning > output):
            non_additive = "mismatch"
            non_additive_errors.append("reasoning is not a non-negative detail of output")
    if non_additive == "mismatch":
        status = "mismatch"
    result = {"status": status, "total_check": total_check, "non_additive": non_additive}
    if missing:
        result["missing_fields"] = missing
    if non_additive_errors:
        result["non_additive_errors"] = non_additive_errors
    return {**row, "reconciliation": result}


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--records", required=True)
    ap.add_argument("--output", required=True)
    args = ap.parse_args()
    rows = []
    for line in Path(args.records).read_text(encoding="utf-8").splitlines():
        if line.strip():
            rows.append(reconcile(json.loads(line)))
    counts = {"pass": 0, "missing": 0, "mismatch": 0}
    for row in rows:
        status = row["reconciliation"]["status"]
        counts[status] += 1
    report = {"schema_version": 1, "rows": rows,
              "summary": {"rows": len(rows), **counts}}
    Path(args.output).write_text(canonical(report) + "\n", encoding="utf-8")
    print("reconciliation: " + ", ".join(f"{k}={v}" for k, v in report["summary"].items()))


if __name__ == "__main__":
    main()
