#!/usr/bin/env bash
# mesh-freshness — the ONE shared data-pane freshness idiom (sourceable lib + standalone self-test).
#
# Liveness is a LEASE at the RENDER layer too (operator 2026-06-21, liveness-lease PART 3): a pane must
# be UNABLE to show a confident value whose freshness it can't prove. Default on ANY failure = a visible
# UNKNOWN/STALE, NEVER a silent last-value. This standardizes the age-stamp/STALE idiom that grew
# copy-pasted across panes (mesh-dash age_of, mesh-situation age_min, mesh-sensorium mark) into one
# place so every pane renders freshness the same honest way.
#
# Source it:  . "$(command -v mesh-freshness)"   (defines the functions; the standalone block is skipped)
# Standalone: mesh-freshness --test | --stamp
#
# Functions:
#   fresh_age_s <file>            -> integer seconds since mtime; returns 1 (no output) if file missing
#   fresh_human <seconds>         -> "12s" / "5m" / "3h" / "2d"
#   fresh_mark  <file> <val> [ttl]-> "val (age)" | "val (age STALE)" past ttl | "UNKNOWN (...)" if
#                                    the file is missing OR the value is empty   (the never-last-value renderer)
#   fresh_val   <val> <age_s> [ttl]-> same, for a value whose age is already known (not file-backed)
#   fresh_stamp                   -> "⟳ frame HH:MM:SSZ" — a pane's own advancing render-lease line

fresh_age_s(){ [ -e "$1" ] || return 1; echo $(( $(date +%s) - $(stat -c %Y "$1" 2>/dev/null || echo 0) )); }

fresh_human(){ local a="${1:-0}"; case "$a" in ''|*[!0-9]*) a=0;; esac
  if   [ "$a" -ge 86400 ]; then echo "$((a/86400))d"
  elif [ "$a" -ge 3600 ];  then echo "$((a/3600))h"
  elif [ "$a" -ge 60 ];    then echo "$((a/60))m"
  else echo "${a}s"; fi; }

fresh_mark(){ local f="$1" v="$2" ttl="${3:-1800}" a
  if ! a="$(fresh_age_s "$f")"; then echo "UNKNOWN (no data — never written)"; return; fi
  [ -n "$v" ] || { echo "UNKNOWN (empty — source produced nothing, age $(fresh_human "$a"))"; return; }
  if [ "$a" -gt "$ttl" ]; then echo "$v ($(fresh_human "$a") STALE)"; else echo "$v ($(fresh_human "$a"))"; fi; }

fresh_val(){ local v="$1" a="$2" ttl="${3:-1800}"
  { [ -z "$v" ] || [ -z "$a" ]; } && { echo "UNKNOWN (no data)"; return; }
  case "$a" in *[!0-9]*) echo "UNKNOWN (no data)"; return;; esac
  if [ "$a" -gt "$ttl" ]; then echo "$v ($(fresh_human "$a") STALE)"; else echo "$v ($(fresh_human "$a"))"; fi; }

fresh_stamp(){ echo "⟳ frame $(date -u +%H:%M:%SZ)"; }

# Standalone ONLY (skipped when sourced — guarded so sourcing never runs the parent's args here).
if [ "${BASH_SOURCE[0]}" = "${0}" ]; then
  case "${1:-}" in
    --stamp) fresh_stamp ;;
    --test)
      fail=0
      [ "$(fresh_human 5)" = 5s ]       || { echo "FAIL human-s"; fail=1; }
      [ "$(fresh_human 120)" = 2m ]     || { echo "FAIL human-m"; fail=1; }
      [ "$(fresh_human 7200)" = 2h ]    || { echo "FAIL human-h"; fail=1; }
      [ "$(fresh_human 172800)" = 2d ]  || { echo "FAIL human-d"; fail=1; }
      t="$(mktemp)"; echo x >"$t"
      case "$(fresh_mark "$t" hello 1800)" in hello\ \(*s\)|hello\ \(*m\)) : ;; *) echo "FAIL mark-fresh: $(fresh_mark "$t" hello)"; fail=1;; esac
      touch -d '@1' "$t" 2>/dev/null
      case "$(fresh_mark "$t" hello 1800)" in *STALE*) : ;; *) echo "FAIL mark-stale: $(fresh_mark "$t" hello 1800)"; fail=1;; esac
      case "$(fresh_mark /no/such/file-xyz val)" in UNKNOWN*) : ;; *) echo "FAIL mark-missing: $(fresh_mark /no/such/file-xyz val)"; fail=1;; esac
      case "$(fresh_mark "$t" '' 1800)" in UNKNOWN*) : ;; *) echo "FAIL mark-empty: $(fresh_mark "$t" '')"; fail=1;; esac
      case "$(fresh_val v '')" in UNKNOWN*) : ;; *) echo "FAIL val-noage"; fail=1;; esac
      case "$(fresh_val v 99999 1800)" in *STALE*) : ;; *) echo "FAIL val-stale"; fail=1;; esac
      case "$(fresh_val v 5 1800)" in v\ \(5s\)) : ;; *) echo "FAIL val-fresh: $(fresh_val v 5 1800)"; fail=1;; esac
      fresh_stamp | grep -q '⟳ frame [0-9][0-9]:[0-9][0-9]:[0-9][0-9]Z' || { echo "FAIL stamp"; fail=1; }
      rm -f "$t"
      [ "$fail" = 0 ] && echo "smoke-test: ok (fresh_age_s/human/mark/val/stamp — UNKNOWN-not-last-value verified)" && exit 0
      echo "smoke-test: FAIL"; exit 1 ;;
    *) echo "mesh-freshness — sourceable freshness lib. usage (standalone): mesh-freshness --test | --stamp" >&2; exit 0 ;;
  esac
fi
