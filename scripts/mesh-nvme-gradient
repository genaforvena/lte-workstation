#!/usr/bin/env bash
# reflex-cadence: */15 * * * *
# mesh-nvme-gradient — RELATIONAL storage-thermal sense.
#
# Reads the live NVMe controller composite temperatures and compares the pair.  mesh-nvme-temp
# already exposes each controller's own temperature; this sense adds the joint signal: one drive
# running materially hotter than its peer.  A missing peer is UNKNOWN, never a fabricated gradient.
#
#   mesh-nvme-gradient          one live relation line
#   mesh-nvme-gradient --json   machine-readable relation
#   mesh-nvme-gradient --test   fixtures + real-read gate
#
# Exit 2 means fewer than two readable NVMe controller temperatures.  A successful run always
# refreshes STATE liveness through the shared mesh-state-touch primitive.
set -uo pipefail

ROOT="${MESH_NVME_GRADIENT_ROOT:-/sys/class/nvme}"
STATE="${MESH_NVME_GRADIENT_STATE:-${HOME:-/root}/.mesh/.nvme-gradient.state}"
THRESHOLD_MC="${MESH_NVME_GRADIENT_THRESHOLD_MC:-10000}"

read_pairs() {
  local controller f raw name
  shopt -s nullglob
  for controller in "$ROOT"/nvme*; do
    [ -d "$controller" ] || continue
    f=""
    for f in "$controller"/hwmon*/temp1_input; do
      [ -r "$f" ] || continue
      raw="$(cat "$f" 2>/dev/null)" || continue
      case "$raw" in ''|*[!0-9-]*) continue ;; esac
      name="${controller##*/}"
      printf '%s|%s\n' "$name" "$raw"
      break
    done
  done
}

run() {
  local rows count=0 name raw min= max= min_name= max_name delta relation
  rows="$(read_pairs)"
  while IFS='|' read -r name raw; do
    [ -n "${name:-}" ] || continue
    count=$((count + 1))
    if [ -z "$min" ] || [ "$raw" -lt "$min" ]; then min="$raw"; min_name="$name"; fi
    if [ -z "$max" ] || [ "$raw" -gt "$max" ]; then max="$raw"; max_name="$name"; fi
  done <<<"$rows"
  [ "$count" -ge 2 ] || return 2
  delta=$((max - min))
  if [ "$delta" -ge "$THRESHOLD_MC" ]; then relation=THERMAL-GRADIENT; else relation=BALANCED; fi

  mkdir -p "$(dirname "$STATE")" 2>/dev/null || return 1
  printf '%s|delta_mc=%s|hot=%s|cold=%s|controllers=%s\n' \
    "$relation" "$delta" "$max_name" "$min_name" "$count" >"$STATE" || return 1
  command -v mesh-state-touch >/dev/null 2>&1 || return 1
  mesh-state-touch "$STATE" >/dev/null 2>&1 || return 1

  if [ "${1:-}" = --json ]; then
    printf '{"relation":"%s","delta_mc":%s,"hot_controller":"%s","cold_controller":"%s","controllers":%s}\n' \
      "$relation" "$delta" "$max_name" "$min_name" "$count"
  else
    printf '[nvme-gradient] %s — delta=%.1fC hot=%s cold=%s controllers=%s\n' \
      "$relation" "$(awk -v m="$delta" 'BEGIN { printf "%.1f", m/1000 }')" "$max_name" "$min_name" "$count"
  fi
}

if [ "${1:-}" = --test ]; then
  td="$(mktemp -d)" || exit 1
  trap 'rm -rf "$td"' EXIT
  mkdir -p "$td/nvme0/hwmon0" "$td/nvme1/hwmon1"
  printf '40000\n' >"$td/nvme0/hwmon0/temp1_input"
  printf '55000\n' >"$td/nvme1/hwmon1/temp1_input"
  fixture="$(MESH_NVME_GRADIENT_ROOT="$td" MESH_NVME_GRADIENT_STATE="$td/state" "$0" --json 2>&1)" || {
    echo "smoke-test: FAIL (fixture relation read: $fixture)"; exit 1;
  }
  printf '%s\n' "$fixture" | grep -q '"relation":"THERMAL-GRADIENT"' || {
    echo "smoke-test: FAIL (fixture relation missing: $fixture)"; exit 1;
  }
  printf '%s\n' "$fixture" | grep -q '"delta_mc":15000' || {
    echo "smoke-test: FAIL (fixture delta missing: $fixture)"; exit 1;
  }
  MESH_NVME_GRADIENT_ROOT="$td/missing" MESH_NVME_GRADIENT_STATE="$td/missing-state" "$0" >/dev/null 2>&1
  rc=$?
  if [ "$rc" -eq 0 ]; then
    echo 'smoke-test: FAIL (missing controllers returned success)'; exit 1
  fi
  [ "$rc" -eq 2 ] || { echo "smoke-test: FAIL (missing controllers rc=$rc, want 2)"; exit 1; }
  rows="$(read_pairs)"
  [ "$(printf '%s\n' "$rows" | awk 'NF{n++} END{print n+0}')" -ge 2 ] || {
    echo 'smoke-test: n/a (fewer than two readable live NVMe controllers)'; exit 2;
  }
  echo "smoke-test: ok (fixture relation + REAL NVMe controller read: $rows)"
  exit 0
fi

case "${1:-}" in
  --json|"") run "${1:-}" || { rc=$?; echo "mesh-nvme-gradient: UNKNOWN — fewer than two readable NVMe controller temperatures" >&2; exit "$rc"; } ;;
  *) echo "usage: mesh-nvme-gradient [--json|--test]" >&2; exit 2 ;;
esac
