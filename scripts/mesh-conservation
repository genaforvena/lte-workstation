#!/usr/bin/env bash
# reflex-cadence: */10 * * * *
# mesh-conservation — Lenovo IdeaPad/ThinkPad battery CONSERVATION MODE sense.
# Reads the ideapad_acpi / thinkpad_acpi `conservation_mode` sysfs toggle, which caps
# battery charge at ~55-60% to extend cell longevity (the reason a plugged-in battery
# reads "Not charging" well below 100%). Distinct from charge % / voltage / cycle count
# (mesh-node-power): those describe the battery's STATE; this describes the EC's CHARGE
# POLICY. A flip — operator toggled Lenovo Vantage, or a firmware reset — is an actionable
# event: the battery-longevity strategy changed.
#
# Usage:
#   mesh-conservation            one-shot status line
#   mesh-conservation --json     machine-readable
#   mesh-conservation --watch    emit on change (default 30s poll)
#   mesh-conservation --test     smoke test (asserts a real EC read yields 0/1)
#
# Honest-exit contract (shared with mesh-lid / mesh-mag):
#   0 = reading produced (recognized 0/1, or the raw code surfaced if the EC reports an
#       unexpected value — never guessed)
#   2 = N/A — no conservation_mode sysfs node (non-Lenovo node, desktop, VM, phone). The
#       sense simply does not apply here; NOT a failure.
#   1 = FAIL — the sysfs node EXISTS but is unreadable or returns garbage (real fault).
#   Never fakes a reading.
#
# Change-gated state: ~/.mesh/.conservation-state holds "on"|"off"|"<raw>". Content is
# rewritten only when the value CHANGES; mtime is refreshed EVERY successful run via
# mesh-state-touch (ran-live decoupled from value-changed — see the conditional-write
# false-stale class, mesh-activity-tempo f3f84c1).
set -euo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

GLOB="${MESH_CONSERVATION_GLOB:-/sys/bus/platform/drivers/ideapad_acpi/VPC*/conservation_mode}"
STATE="$HOME/.mesh/.conservation-state"

# find the (first) readable conservation_mode sysfs node; empty + return 1 if none.
find_node() {
  local f
  for f in $GLOB; do
    [ -r "$f" ] && { printf '%s\n' "$f"; return 0; }
  done
  return 1
}

# read + normalize the value at <node>: echo "on"|"off"|"<raw-int>"; return 1 on garbage.
read_mode() {
  local node="$1" raw
  raw="$(cat "$node" 2>/dev/null)" || return 1
  raw="$(printf '%s' "$raw" | tr -d '[:space:]')"
  case "$raw" in
    ''|*[!0-9]*) return 1 ;;    # empty / non-numeric → garbage, never fake
  esac
  case "$raw" in
    1) printf 'on\n' ;;
    0) printf 'off\n' ;;
    *) printf '%s\n' "$raw" ;;  # unknown EC code → surface raw, do not guess
  esac
}

# persist + keep-live: rewrite content only on change; always refresh mtime (ran-live).
touch_state() {
  command -v mesh-state-touch >/dev/null 2>&1 && mesh-state-touch "$STATE" || touch "$STATE" 2>/dev/null || true
}
write_state() {  # <value>
  local val="$1" prev
  prev="$(cat "$STATE" 2>/dev/null || true)"
  if [ "$val" != "$prev" ]; then
    mkdir -p "$(dirname "$STATE")"
    printf '%s\n' "$val" > "$STATE"
  fi
  touch_state
}

# one read: emits the normalized value on stdout; handles honest-exit on the way.
read_once() {
  local node val
  node="$(find_node)" || { echo "mesh-conservation: n/a (no conservation_mode sysfs node — non-Lenovo node)" >&2; exit 2; }
  val="$(read_mode "$node")" || { echo "mesh-conservation: FAIL (conservation_mode present but unreadable/garbage at $node)" >&2; exit 1; }
  write_state "$val"
  printf '%s\n' "$val"
}

ts(){ date -u +%FT%TZ; }

case "${1:-}" in
  --test)
    # A node without ideapad/thinkpad ACPI conservation_mode (desktop / VM / router / phone)
    # is NOT broken — the sense is just N/A. Distinguish DEPENDENCY ABSENT (→ exit 2 n/a)
    # from PRESENT-but-unreadable/garbage (→ exit 1 FAIL). The live-read gate asserts a real
    # EC read yields a recognized 0/1 — reachability of the sysfs node ≠ producing a value.
    node="$(find_node)" || { echo "smoke-test: n/a (no conservation_mode sysfs node: non-Lenovo node)"; exit 2; }
    val="$(read_mode "$node")" || { echo "smoke-test: FAIL (conservation_mode present but unreadable/garbage at $node)"; exit 1; }
    case "$val" in
      on)  echo "smoke-test: ok (conservation on — battery charge-capped for longevity)" ;;
      off) echo "smoke-test: ok (conservation off — charges to full)" ;;
      *)   echo "smoke-test: FAIL (conservation_mode live read unrecognized: $val)"; exit 1 ;;
    esac
    ;;
  --json)
    val="$(read_once)"
    cap=false; [ "$val" = on ] && cap=true
    printf '{"node":"%s","conservation":"%s","charge_cap":%s,"ts":"%s"}\n' \
      "$(hostname)" "$val" "$cap" "$(ts)"
    ;;
  --watch)
    interval="${2:-30}"
    previous=""
    while true; do
      val="$(read_once 2>/dev/null)" || val=unknown
      if [ "$val" != "$previous" ]; then
        printf '%s conservation=%s\n' "$(ts)" "$val"
        previous="$val"
      fi
      sleep "$interval"
    done
    ;;
  "")
    val="$(read_once)"
    case "$val" in
      on)  printf 'conservation=on (charge capped ~55-60%% for battery longevity)\n' ;;
      off) printf 'conservation=off (charges to full; charge-cap policy disabled)\n' ;;
      *)   printf 'conservation=%s (unrecognized EC code — surfaced raw, not guessed)\n' "$val" ;;
    esac
    ;;
  *)
    echo "usage: mesh-conservation [--test|--json|--watch [seconds]]" >&2
    exit 2
    ;;
esac
