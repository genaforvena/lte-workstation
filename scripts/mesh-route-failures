#!/usr/bin/env bash
# reflex-cadence: */5 * * * *
# reflex-args: --edge
# mesh-route-failures — kernel route-failure sense from IPv4/IPv6 SNMP counters.
#
# IpOutNoRoutes / Ip6OutNoRoutes are cumulative kernel counters for packets the host
# tried to send while it had no route. This is a distinct network signal from bytes,
# link quality, or interface state: a live link can still have a routing failure.
# The counters are lifetime-since-boot evidence; this tool publishes both values and
# never turns an unreadable proc file into zero.
#
# Honest contract:
#   both proc inputs readable and parseable -> exit 0, state rewritten every run
#   either input unavailable/unparseable -> PARTIAL/UNKNOWN and exit 2
#
#   mesh-route-failures           one live reading
#   mesh-route-failures --edge    emit only when the verdict changes
#   mesh-route-failures --json    machine-readable reading
#   mesh-route-failures --test    fixture parser + real /proc read gate
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

MESH="${MESH_DIR:-$HOME/.mesh}"
STATE="${MESH_ROUTE_FAILURES_STATE:-$MESH/.route-failures.state}"
SNMP_FILE="${MESH_SNMP_FILE:-/proc/net/snmp}"
SNMP6_FILE="${MESH_SNMP6_FILE:-/proc/net/snmp6}"

read_ipv4() {
  awk '
    $1 == "Ip:" && seen == 0 { for (i = 1; i <= NF; i++) if ($i == "OutNoRoutes") col = i; seen = 1; next }
    $1 == "Ip:" && col { if ($col ~ /^[0-9]+$/) { print $col; found=1; exit 0 } }
    END { if (!found) exit 1 }
  ' "$1" 2>/dev/null
}

read_ipv6() {
  awk '$1 == "Ip6OutNoRoutes" && $2 ~ /^[0-9]+$/ { print $2; found=1; exit }
       END { if (!found) exit 1 }' "$1" 2>/dev/null
}

classify() {
  if [ "$1" -eq 0 ] && [ "$2" -eq 0 ]; then echo CLEAN; else echo ROUTE-FAILURES; fi
}

if [ "${1:-}" = --test ]; then
  td="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
  trap 'rm -rf "$td"' EXIT
  cat >"$td/snmp" <<'EOF'
Ip: Forwarding DefaultTTL InReceives InHdrErrors InAddrErrors ForwDatagrams InUnknownProtos InDiscards InDelivers OutRequests OutDiscards OutNoRoutes ReasmTimeout ReasmReqds ReasmOKs ReasmFails FragOKs FragFails FragCreates
Ip: 2 64 100 0 0 0 0 0 100 80 0 7 0 0 0 0 0 0 0
EOF
  cat >"$td/snmp6" <<'EOF'
Ip6InReceives                    20
Ip6OutNoRoutes                   11
EOF
  v4="$(read_ipv4 "$td/snmp")" || { echo "smoke-test: FAIL (IPv4 fixture)"; exit 1; }
  v6="$(read_ipv6 "$td/snmp6")" || { echo "smoke-test: FAIL (IPv6 fixture)"; exit 1; }
  [ "$v4" = 7 ] && [ "$v6" = 11 ] || { echo "smoke-test: FAIL (fixture values: $v4/$v6)"; exit 1; }
  [ "$(classify 0 0)" = CLEAN ] || { echo "smoke-test: FAIL (zero counters)"; exit 1; }
  [ "$(classify 7 0)" = ROUTE-FAILURES ] || { echo "smoke-test: FAIL (nonzero counter)"; exit 1; }
  # The final leg is deliberately live: parser fixtures alone do not prove this organ can read here.
  [ -r "$SNMP_FILE" ] && [ -r "$SNMP6_FILE" ] || { echo "smoke-test: n/a (kernel SNMP proc inputs unavailable)"; exit 2; }
  live4="$(read_ipv4 "$SNMP_FILE")" || { echo "smoke-test: n/a (IPv4 OutNoRoutes unreadable)"; exit 2; }
  live6="$(read_ipv6 "$SNMP6_FILE")" || { echo "smoke-test: n/a (IPv6 Ip6OutNoRoutes unreadable)"; exit 2; }
  case "$live4:$live6" in *[!0-9:]*|'') echo "smoke-test: n/a (live counters invalid)"; exit 2;; esac
  echo "smoke-test: ok (fixture parse + live proc read ipv4=$live4 ipv6=$live6)"
  exit 0
fi

mode=plain; json=0
for arg in "$@"; do
  case "$arg" in --edge) mode=edge;; --json) json=1;; esac
done

v4="$(read_ipv4 "$SNMP_FILE")" || { echo "route-failures: IPv4 counter unavailable" >&2; exit 2; }
v6="$(read_ipv6 "$SNMP6_FILE")" || { echo "route-failures: IPv6 counter unavailable" >&2; exit 2; }
case "$v4:$v6" in *[!0-9:]*|'') echo "route-failures: invalid counter" >&2; exit 2;; esac

verdict="$(classify "$v4" "$v6")"
line="verdict=$verdict ipv4=$v4 ipv6=$v6 source=/proc/net/snmp,/proc/net/snmp6"
mkdir -p "$(dirname "$STATE")" 2>/dev/null || { echo "route-failures: state directory unavailable" >&2; exit 1; }
prev="$(sed -n 's/^verdict=\([^ ]*\).*/\1/p' "$STATE" 2>/dev/null || true)"
printf '%s\n' "$line" >"$STATE" || { echo "route-failures: state write failed" >&2; exit 1; }

if [ "$json" = 1 ]; then
  printf '{"verdict":"%s","ipv4":%s,"ipv6":%s,"source":"/proc/net/snmp,/proc/net/snmp6"}\n' "$verdict" "$v4" "$v6"
elif [ "$mode" = edge ] && [ "$prev" = "$verdict" ]; then
  exit 0
else
  echo "$line"
fi
