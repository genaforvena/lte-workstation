#!/usr/bin/env bash
# mesh-voice-grind — the DRIVER that closes the «грайнд» verb lane: a voice note whose first word is
# the verb becomes N granular remixes delivered to the operator's Telegram.
#
# Operator, 2026-08-21: «хочется просто говорить „грайнд"… рассчитываю, что грайнд ункельным всё
# нормально размешается по НЕСКОЛЬКО РАЗ, ну типа там много вариантов». So the unit of delivery is a
# SET of variants, never one file — one render answers a different request than the one he made.
#
# WHY THIS TOOL EXISTS AT ALL. mesh-voice-verb was written, its --test was green, and NOTHING CALLED
# IT — grep across ~/.local/bin, scripts/ and cron returned only the file itself. It detected, cut,
# and placed a file in ~/.mesh/inbox, and nothing on this node reads that inbox. So the operator said
# «Грайнд Миша» (VOICE, 2026-08-21T14:46:32Z) and got silence, while every artifact a reviewer would
# look at — the tool, its tests, its doctrine header — read as a working feature. That is the
# never-wired-reflex shape, and the missing half was not detection but DELIVERY.
#
#   mesh-voice-grind <audio.oga> [transcript-hint]   detect verb; if it fired, grind + deliver
#   mesh-voice-grind --test
#
# Env: MESH_VOICE_GRIND_N (default 3 variants) · MESH_VOICE_GRIND_LOG · MESH_VOICE_GRIND_NOTIFY=off
set -uo pipefail
MESH="${MESH_DIR:-$HOME/.mesh}"
LOG="${MESH_VOICE_GRIND_LOG:-$MESH/voice-grind.log}"
N="${MESH_VOICE_GRIND_N:-3}"
BIN="$HOME/.local/bin"

log() { printf '%s  %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >> "$LOG"; }

# Delivery is the point of the tool, so it is a NAMED function with one caller path — never an
# inline `|| true`. A send that fails must be loud in the log, because the operator's evidence that
# the lane works is the file arriving, and a silent send failure is indistinguishable from the
# never-wired state this tool was built to end.
deliver() {  # <file> <caption>
  [ "${MESH_VOICE_GRIND_NOTIFY:-on}" = off ] && { log "deliver SKIPPED (NOTIFY=off): $1"; return 0; }
  if "$BIN/mesh-tg" --file "$1" "$2" >/dev/null 2>&1; then log "delivered: $1"; return 0; fi
  log "DELIVER FAILED: $1 (mesh-tg --file rc=$?)"; return 1
}

if [ "${1:-}" = "--test" ]; then
  fail=0
  for t in mesh-voice-verb mesh-room-music mesh-tg; do
    [ -x "$BIN/$t" ] || { echo "smoke-test: FAIL (no $BIN/$t)"; fail=1; }
  done
  [ "$fail" = 0 ] || exit 1
  # The gate that matters is NOT "the binaries exist" — that is the [ -x ] trap (executable and
  # working are different claims). Assert the CONTRACT this driver actually depends on: that
  # mesh-voice-verb answers in JSON and exits 2 when no verb fired. Drive it against a real silent
  # wav, where the honest answer is "no verb", and assert BOTH the rc and the json shape.
  q="$(mktemp -d)"; trap 'rm -rf "$q"' EXIT
  if command -v ffmpeg >/dev/null 2>&1; then
    ffmpeg -v quiet -f lavfi -i anullsrc=r=16000:cl=mono -t 2 -c:a libopus "$q/s.oga" </dev/null
    out="$("$BIN/mesh-voice-verb" "$q/s.oga" "тишина без глагола" --json 2>/dev/null)"; rc=$?
    [ "$rc" = 2 ] || { echo "smoke-test: FAIL (no-verb rc=$rc, expected 2 — the driver's skip path reads rc)"; exit 1; }
    [ "$out" = "null" ] || { echo "smoke-test: FAIL (no-verb --json printed '$out', expected null)"; exit 1; }
  else
    echo "smoke-test: SKIP-PART (no ffmpeg — could not drive the real no-verb contract)"
  fi
  # And assert the hint short-circuit is WIRED HERE: a hint whose first word is not a verb must cost
  # no whisper pass. Measured by wall-clock: a real pass on this node is seconds, the short-circuit
  # is milliseconds. A generous ceiling — this asserts "did not transcribe", not a performance SLO.
  if [ -f "$q/s.oga" ]; then
    t0=$(date +%s%N); "$BIN/mesh-voice-verb" "$q/s.oga" "просто разговор ни о чём" --json >/dev/null 2>&1
    dt=$(( ($(date +%s%N) - t0) / 1000000 ))
    [ "$dt" -lt 2000 ] || { echo "smoke-test: FAIL (hint short-circuit took ${dt}ms — the hint is not reaching mesh-voice-verb)"; exit 1; }
  fi
  echo "smoke-test: ok (verb contract driven for real: rc=2 + json null on a no-verb note; hint short-circuits without a whisper pass; deliver path named)"
  exit 0
fi

[ -n "${1:-}" ] || { echo "usage: mesh-voice-grind <audio.oga> [transcript-hint] | --test" >&2; exit 64; }
SRC="$1"; HINT="${2:-}"
[ -f "$SRC" ] || { echo "no such file: $SRC" >&2; exit 1; }

# ── 1. did the verb fire? ────────────────────────────────────────────────────────────────────────
J="$("$BIN/mesh-voice-verb" "$SRC" "$HINT" --json 2>/dev/null)"; VRC=$?
[ "$VRC" = 2 ] && exit 0                       # no verb — the overwhelmingly common case, silent by design
CUT="$(printf '%s' "$J" | python3 -c 'import json,sys; d=json.load(sys.stdin) or {}; print(d.get("dest") or "")' 2>/dev/null)"
HEARD="$(printf '%s' "$J" | python3 -c 'import json,sys; d=json.load(sys.stdin) or {}; print(d.get("heard") or "")' 2>/dev/null)"
REF="$(printf '%s' "$J" | python3 -c 'import json,sys; d=json.load(sys.stdin) or {}; print(d.get("refused") or "")' 2>/dev/null)"
if [ -n "$REF" ]; then
  # A refusal is an OUTCOME and it goes to him. The one thing this lane must never do is eat the
  # verb silently: he said the word, so something must come back, even if it is "слишком коротко".
  log "refused heard=$HEARD: $REF"
  [ "${MESH_VOICE_GRIND_NOTIFY:-on}" = off ] || "$BIN/mesh-tg" "Услышал «$HEARD», но грайндить нечего: $REF" >/dev/null 2>&1
  exit 1
fi
[ -n "$CUT" ] && [ -f "$CUT" ] || { log "verb fired but no cut file (json=$J)"; exit 1; }
log "fired heard=$HEARD cut=$CUT hint=${HINT:0:60}"
[ "${MESH_VOICE_GRIND_NOTIFY:-on}" = off ] || "$BIN/mesh-tg" "Услышал «$HEARD» → взял хвост в грайнд, гоню $N варианта(ов). Пришлю мп3-шками." >/dev/null 2>&1

# ── 2. grind N variants ──────────────────────────────────────────────────────────────────────────
# Each --remix derives its own recipe (mesh-sound-reflex's character-driven params + the recency
# repellent), so N invocations of the SAME source give N different renders — that is exactly the
# "много вариантов" he asked for, and it is why this is a loop and not a batch flag.
ok=0; failed=0
for i in $(seq 1 "$N"); do
  out="$("$BIN/mesh-room-music" --remix "$CUT" 2>&1 | tail -1)"
  if [ -f "$out" ]; then
    ok=$((ok+1)); log "variant $i/$N: $out"
    deliver "$out" "грайнд «$HEARD» — вариант $i из $N" || true
  else
    failed=$((failed+1)); log "variant $i/$N FAILED: ${out:0:200}"
  fi
done

# ── 3. say what actually happened ────────────────────────────────────────────────────────────────
# Report the COUNT, including the failures. "Готово" after 1 of 3 rendered is the summary-asserting-
# a-leg-that-did-not-fire shape; he asked for several variants and a partial set is a partial answer.
log "done heard=$HEARD ok=$ok failed=$failed"
if [ "$ok" = 0 ]; then
  [ "${MESH_VOICE_GRIND_NOTIFY:-on}" = off ] || "$BIN/mesh-tg" "Грайнд «$HEARD»: ни один из $N вариантов не отрендерился. Смотрю в $LOG." >/dev/null 2>&1
  exit 1
fi
[ "$failed" = 0 ] || { [ "${MESH_VOICE_GRIND_NOTIFY:-on}" = off ] || "$BIN/mesh-tg" "Грайнд «$HEARD»: доехало $ok из $N, $failed упало (лог: $LOG)." >/dev/null 2>&1; }
exit 0
