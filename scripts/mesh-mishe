#!/usr/bin/env bash
# mesh-mishe — hand the mesh's working culture to a machine that will never clone this repo.
#
# The vector is a SKILL, not a deploy. `--seed` packs skills/mishe-mishe-to-tauftauf/ into one
# self-extracting, human-READABLE shell file (plain heredocs, no base64, nothing fetched) that
# plants it at ~/.claude/skills/ and proves the core runs. That file is the whole delivery: send
# it, they run it, done. A `git clone` of lte-workstation is deploying a system — a different act,
# and the person we are planting for will not do it.
#
#   mesh-mishe --seed [out.sh]   write the seed (default ~/.mesh/mishe-seed.sh)
#   mesh-mishe --show            print the seed to stdout
#   mesh-mishe --test            plant the seed into a throwaway HOME and drive it
#
# orphan-ok: on-demand — a seed is generated when there is a person to hand it to, never on a timer.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

REPO="${MESH_REPO:-$HOME/lte-workstation}"
SKILL_DIR="${MESH_MISHE_SKILL:-$REPO/skills/mishe-mishe-to-tauftauf}"
DELIM='__MISHE_SEED_EOF__'

# Files are listed explicitly, not globbed: a glob silently ships whatever happens to be in the
# directory (an editor swapfile, a stray note), and silently ships NOTHING if the path is wrong.
FILES='SKILL.md core/mishe reference/planting.md reference/seed.md reference/reflexes.md'

emit_seed() {
  local missing=""
  for f in $FILES; do [ -f "$SKILL_DIR/$f" ] || missing="$missing $f"; done
  if [ -n "$missing" ]; then
    echo "mesh-mishe: missing from $SKILL_DIR:$missing" >&2; return 1
  fi
  # A payload line equal to the heredoc delimiter would end the heredoc early and silently
  # truncate a file. Refuse rather than ship a half file.
  for f in $FILES; do
    if grep -qxF "$DELIM" "$SKILL_DIR/$f"; then
      echo "mesh-mishe: $f contains the heredoc delimiter — refusing to emit a truncatable seed" >&2
      return 1
    fi
  done

  cat <<'HEADER'
#!/bin/sh
# mishe mishe to tauftauf — a seed. Run it: sh mishe-seed.sh
#
# It writes ~/.claude/skills/mishe-mishe-to-tauftauf/ and ~/.mishe/bin/mishe, then runs the core's
# self-test. Nothing else: no network, no package manager, no clone, nothing scheduled, nothing
# outside your home directory. Every byte below is plain text you can read before running it.
set -u
DEST="${MISHE_SKILL_DEST:-$HOME/.claude/skills/mishe-mishe-to-tauftauf}"
mkdir -p "$DEST/core" "$DEST/reference" "$HOME/.mishe/bin" || exit 1
HEADER

  for f in $FILES; do
    printf '\n# ---------- %s\ncat > "$DEST/%s" <<'"'"'%s'"'"'\n' "$f" "$f" "$DELIM"
    cat "$SKILL_DIR/$f"
    printf '%s\n' "$DELIM"
  done

  cat <<'FOOTER'

cp "$DEST/core/mishe" "$HOME/.mishe/bin/mishe" && chmod +x "$HOME/.mishe/bin/mishe" || exit 1

echo
echo "planted:"
echo "  skill  $DEST"
echo "  core   $HOME/.mishe/bin/mishe"
echo
"$HOME/.mishe/bin/mishe" --test || { echo "the core did not pass its own test — stop here."; exit 1; }
echo
echo "Next — and this is the part that is not optional:"
echo "  1. Open Claude Code here and say: use the mishe-mishe-to-tauftauf skill."
echo "  2. Its first move is to ASK YOU what you actually do. Answer in your own words."
echo "  3. Nothing is scheduled, nothing is installed, and nothing runs on its own. On purpose."
echo
echo "A file on disk is not a planting. It is planted when you have read an answer about your own"
echo "real work and can say whether it was useful or wrong."
FOOTER
}

case "${1:-}" in
  --show) emit_seed ;;
  --seed)
    out="${2:-$HOME/.mesh/mishe-seed.sh}"
    mkdir -p "$(dirname "$out")" || exit 1
    emit_seed > "$out.part" || { rm -f "$out.part"; exit 1; }
    mv "$out.part" "$out" && chmod +x "$out" || exit 1
    echo "seed: $out ($(wc -c < "$out" | tr -d ' ') bytes, $(wc -l < "$out" | tr -d ' ') lines)"
    ;;
  --test)
    fails=0
    td=$(mktemp -d) || exit 1
    trap 'rm -rf "$td"' EXIT
    ok(){ printf '  ok   %s\n' "$1"; }
    bad(){ printf '  FAIL %s\n' "$1"; fails=$((fails+1)); }

    if ! emit_seed > "$td/seed.sh" 2>"$td/err"; then
      bad "seed did not emit: $(head -1 "$td/err")"
      echo "mesh-mishe --test: $fails FAILED"; exit 1
    fi
    ok "seed emits"

    # Scheduler shims. `crontab` is per-USER, not per-HOME: a `HOME=$td crontab -l` check reads the
    # REAL crontab and so asserts nothing about the plant — seen live, a mutant that scheduled a job
    # wrote into the operator's own crontab and the gate still passed on the following mutant's run,
    # having read the leftover line. Shim the schedulers on PATH instead and assert nobody called one.
    mkdir -p "$td/shim"
    for s in crontab launchctl at systemd-run; do
      printf '#!/bin/sh\necho "%s $*" >> "%s/scheduled.calls"\nexit 0\n' "$s" "$td" > "$td/shim/$s"
      chmod +x "$td/shim/$s"
    done
    # Installer shims, same positive-evidence shape and for the same reason as the schedulers above.
    # The seed's own claim is "no package manager"; until now nothing measured it, and the pressure
    # to break it is now NAMED in the doctrine we ship — planting.md tells the reader that a tmux
    # session buys shared perception, and the obvious wrong next move is for some later hand to make
    # the plant helpfully run `brew install tmux`. A paid step the READER chooses is the whole point;
    # a paid step the SEED takes on their behalf is exactly the zero-dependency promise broken. Note
    # `tmux` itself is shimmed: it is not an installer, but a seed that STARTS a session has also
    # stopped being a file-writer, and that is the same defect wearing the other hat.
    for s in brew port apt-get apt yum dnf pacman npm pip pip3 gem cargo curl wget tmux; do
      printf '#!/bin/sh\necho "%s $*" >> "%s/installed.calls"\nexit 0\n' "$s" "$td" > "$td/shim/$s"
      chmod +x "$td/shim/$s"
    done

    # Plant into a throwaway HOME. This is the real assertion: not that the seed exists, but that
    # a stranger running it on a clean machine ends up with a core that works.
    H="$td/home"; mkdir -p "$H"
    if HOME="$H" PATH="$td/shim:$PATH" sh "$td/seed.sh" > "$td/plant.out" 2>&1; then ok "seed plants in a clean HOME"
    else bad "seed failed to plant: $(tail -3 "$td/plant.out" | tr '\n' ' ')"; fi

    grep -q 'mishe --test: ok' "$td/plant.out" && ok "planted core passes its own test" \
      || bad "planted core did not pass its own test"

    [ -x "$H/.mishe/bin/mishe" ] && ok "core is executable" || bad "core is not executable"
    [ -f "$H/.claude/skills/mishe-mishe-to-tauftauf/SKILL.md" ] && ok "skill lands in ~/.claude/skills" \
      || bad "skill did not land in ~/.claude/skills"

    # Every file must arrive BYTE-IDENTICAL. A heredoc that ate a line would still leave a
    # plausible file behind, and a truncated doctrine reads exactly like a short one.
    diffs=0
    for f in $FILES; do
      cmp -s "$SKILL_DIR/$f" "$H/.claude/skills/mishe-mishe-to-tauftauf/$f" || { diffs=$((diffs+1)); echo "       differs: $f"; }
    done
    [ "$diffs" = 0 ] && ok "all $(set -- $FILES; echo $#) files arrive byte-identical" || bad "$diffs file(s) corrupted in transit"

    # And the artifact that matters: the planted core can actually be USED, not just tested.
    HOME="$H" MISHE_HOME="$H/.mishe" "$H/.mishe/bin/mishe" board "[task] first-thing prove this works" >/dev/null 2>&1
    out=$(HOME="$H" MISHE_HOME="$H/.mishe" "$H/.mishe/bin/mishe" open 2>&1)
    case "$out" in *first-thing*) ok "a claim written on the planted node is visible as open";;
      *) bad "the planted node lost a claim";; esac

    # Nothing may have been scheduled. Day-one cron is the named trap, and the shims above make the
    # evidence positive (a recorded call) rather than an absence read off someone else's crontab.
    if [ -s "$td/scheduled.calls" ]; then bad "the seed scheduled something: $(tr '\n' ';' < "$td/scheduled.calls")"
    else ok "the seed scheduled nothing (crontab/launchctl/at/systemd-run shimmed, none called)"; fi

    # …AND NOTHING MAY HAVE BEEN INSTALLED OR FETCHED. Same evidence shape: a recorded call, not an
    # absence inferred from a package list that belongs to the machine and not to the plant.
    if [ -s "$td/installed.calls" ]; then bad "the seed installed/fetched something: $(tr '\n' ';' < "$td/installed.calls")"
    else ok "the seed installed nothing (brew/port/apt/yum/dnf/pacman/npm/pip/gem/cargo/curl/wget/tmux shimmed, none called)"; fi

    if [ "$fails" = 0 ]; then echo "mesh-mishe --test: ok"; exit 0
    else echo "mesh-mishe --test: $fails FAILED"; exit 1; fi
    ;;
  ''|--help|-h) sed -n '2,15p' "$0" ;;
  *) echo "mesh-mishe: unknown option '${1}' (try --help)" >&2; exit 2 ;;
esac
