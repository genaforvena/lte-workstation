#!/usr/bin/env bash
# orphan-ok: on-demand relation probe; cadence wiring waits for this source to be landed
# mesh-io-congestion — correlate physical disk activity with kernel I/O stall.
#
# This is a relation, not a selector: /proc/diskstats supplies completed disk I/O and
# /proc/pressure/io supplies scheduler-visible I/O stall.  The joint state COUPLED means
# both axes are live and elevated; the two *_WITHOUT_* states preserve cases where only
# one axis is elevated.  A missing or malformed axis is UNKNOWN (exit 2), never quiet.
#
#   mesh-io-congestion          one-line live relation
#   mesh-io-congestion --json   machine-readable relation
#   mesh-io-congestion --edge   emit only when the relation label changes
#   mesh-io-congestion --test   classifier fixtures + REAL procfs reads
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

MESH="${MESH_DIR:-$HOME/.mesh}"
STATE="${MESH_IO_CONGESTION_STATE:-$MESH/.io-congestion.state}"
PROC_PRESSURE="${MESH_IO_CONGESTION_PRESSURE:-/proc/pressure/io}"
DISKSTATS="${MESH_IO_CONGESTION_DISKSTATS:-/proc/diskstats}"
SAMPLE="${MESH_IO_CONGESTION_SAMPLE:-0.2}"

read_psi() {
  local line some full
  [ -r "$PROC_PRESSURE" ] || return 2
  line="$(cat "$PROC_PRESSURE" 2>/dev/null)" || return 2
  some="$(printf '%s\n' "$line" | awk '$1=="some" {for(i=2;i<=NF;i++) if($i ~ /^avg10=/){sub(/^avg10=/,"",$i); print $i; exit}}')"
  full="$(printf '%s\n' "$line" | awk '$1=="full" {for(i=2;i<=NF;i++) if($i ~ /^avg10=/){sub(/^avg10=/,"",$i); print $i; exit}}')"
  case "$some|$full" in
    ''\|*|*\|''|*[!0-9.\|]*) return 2 ;;
  esac
  printf '%s|%s\n' "$some" "$full"
}

# Sum completed reads+writes over non-virtual block devices.  Diskstats is an accumulator,
# so the relation uses a delta, not the lifetime counter itself.
read_disk_ops() {
  [ -r "$DISKSTATS" ] || return 2
  awk '$3 !~ /^(loop|ram|sr|fd)[0-9]+$/ {sum += $4 + $8} END {if (NR == 0) exit 2; print sum+0}' "$DISKSTATS" 2>/dev/null
}

classify() { # <ops_per_sec> <psi_some_avg10> <psi_full_avg10>
  awk -v ops="$1" -v some="$2" -v full="$3" 'BEGIN {
    if (ops !~ /^[0-9]+([.][0-9]+)?$/ || some !~ /^[0-9]+([.][0-9]+)?$/ || full !~ /^[0-9]+([.][0-9]+)?$/) { print "UNKNOWN"; exit }
    busy = (ops >= 1); stalled = (some >= 5 || full > 0)
    if (busy && stalled) print "COUPLED"
    else if (busy) print "DISK_ACTIVITY_WITHOUT_STALL"
    else if (stalled) print "STALL_WITHOUT_DISK_ACTIVITY"
    else print "QUIET"
  }'
}

live_read() {
  local p1 p2 p3 p4 ops1 ops2 elapsed ops_rate
  p1="$(read_psi)" || return 2
  ops1="$(read_disk_ops)" || return 2
  p2="$(date +%s%N)"
  sleep "$SAMPLE"
  p3="$(date +%s%N)"
  p4="$(read_psi)" || return 2
  ops2="$(read_disk_ops)" || return 2
  elapsed="$(awk -v a="$p2" -v b="$p3" 'BEGIN {printf "%.6f", (b-a)/1000000000}')"
  ops_rate="$(awk -v a="$ops1" -v b="$ops2" -v e="$elapsed" 'BEGIN {d=b-a; if (d<0 || e<=0) exit 1; printf "%.3f", d/e}')" || return 2
  printf '%s|%s|%s|%s\n' "$ops_rate" "${p4%%|*}" "${p4#*|}" "$elapsed"
}

if [ "${1:-}" = --test ]; then
  td="$(mktemp -d)" || { echo 'smoke-test: FAIL (mktemp)'; exit 1; }
  trap 'rm -rf "$td"' EXIT
  printf 'some avg10=6.00 avg60=0 total=1\nfull avg10=0.00 avg60=0 total=0\n' >"$td/pressure"
  printf '8 0 sda 10 0 0 0 10 0 0 0 0 0 0\n' >"$td/diskstats"
  [ "$(classify 0 6.00 0.00)" = STALL_WITHOUT_DISK_ACTIVITY ] || { echo 'smoke-test: FAIL (stall-only relation)'; exit 1; }
  [ "$(classify 2 0.00 0.00)" = DISK_ACTIVITY_WITHOUT_STALL ] || { echo 'smoke-test: FAIL (disk-only relation)'; exit 1; }
  [ "$(classify 2 6.00 0.00)" = COUPLED ] || { echo 'smoke-test: FAIL (joint relation)'; exit 1; }
  [ "$(classify bad 0 0)" = UNKNOWN ] || { echo 'smoke-test: FAIL (malformed input)'; exit 1; }
  live="$(live_read 2>/dev/null || true)"
  [ -n "$live" ] || { echo 'smoke-test: n/a (no readable live /proc pressure+diskstats)'; exit 2; }
  IFS='|' read -r ops some full elapsed <<< "$live"
  case "$ops|$some|$full|$elapsed" in *\|\|*|*[!0-9.|]*) echo 'smoke-test: FAIL (live relation parse incomplete)'; exit 1;; esac
  echo "smoke-test: ok (3 relation fixtures + REAL /proc reads: ops/s=$ops some_avg10=$some full_avg10=$full)"
  exit 0
fi

live="$(live_read 2>/dev/null || true)"
[ -n "$live" ] || { echo "mesh-io-congestion: UNKNOWN — cannot read $PROC_PRESSURE and $DISKSTATS" >&2; exit 2; }
IFS='|' read -r ops some full elapsed <<< "$live"
label="$(classify "$ops" "$some" "$full")"
[ "$label" != UNKNOWN ] || { echo 'mesh-io-congestion: UNKNOWN — malformed live relation' >&2; exit 2; }
mkdir -p "$(dirname "$STATE")" 2>/dev/null || exit 1
ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
printf 'label=%s|disk_ops_s=%s|psi_some_avg10=%s|psi_full_avg10=%s|sample_s=%s|ts=%s\n' \
  "$label" "$ops" "$some" "$full" "$elapsed" "$ts" >"$STATE" || exit 1
mesh-state-touch "$STATE" >/dev/null 2>&1 || { echo 'mesh-io-congestion: UNKNOWN — state liveness stamp failed' >&2; exit 1; }

if [ "${1:-}" = --json ]; then
  printf '{"label":"%s","disk_ops_s":%s,"psi_some_avg10":%s,"psi_full_avg10":%s,"sample_s":%s,"ts":"%s"}\n' \
    "$label" "$ops" "$some" "$full" "$elapsed" "$ts"
elif [ "${1:-}" != --edge ]; then
  printf '[io-congestion-%s] %s — disk_ops/s=%s psi_some_avg10=%s%% psi_full_avg10=%s%%\n' \
    "$(printf '%s' "$label" | tr '[:upper:]' '[:lower:]')" "$label" "$ops" "$some" "$full"
fi
exit 0
