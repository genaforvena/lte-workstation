#!/usr/bin/env bash
# mesh-ss-altport — add/remove alternate port for SS tunnel on phaedra
# Some carriers (Megafon RU) block port 443 to foreign IPs but allow port 80.
# Creates a systemd-managed socat TCP redirect: alt-port → 443.
#
#   mesh-ss-altport <port>        add redirect + print SS URI for that port
#   mesh-ss-altport --remove <port>  remove the redirect
#   mesh-ss-altport --list        show all redirects
#   mesh-ss-altport --test        smoke test
set -euo pipefail
PHAEDRA="phaedra"
SS_HOST="38.49.216.141"
SS_PORT=443

do_test() {
  local f=0
  command -v ssh >/dev/null 2>&1 || { echo "FAIL: ssh missing"; f=1; }
  command -v nc >/dev/null 2>&1 || { echo "FAIL: nc missing"; f=1; }
  [ "$f" = 0 ] || exit 1
  # Check phaedra reachable
  timeout 5 ssh -o StrictHostKeyChecking=no "$PHAEDRA" "echo ok" 2>/dev/null || { echo "FAIL: phaedra unreachable"; exit 2; }
  ssh "$PHAEDRA" "command -v socat" 2>/dev/null || { echo "FAIL: socat not installed on phaedra"; exit 2; }
  echo "smoke-test: ok"; exit 0
}

LIST=0; REMOVE=""
case "${1:-}" in
  --test) do_test;;
  --list) LIST=1; shift;;
  --remove) REMOVE="$2"; shift 2;;
  [0-9]*) PORT="$1"; shift;;
  *) echo "usage: $0 <port> | --remove <port> | --list | --test"; exit 1;;
esac

PASSWORD="OkzGhzr0B4Rod6L4S0KAvxJffSPUAfKSJh6X+32IJmg="
METHOD="chacha20-ietf-poly1305"

if [ "$LIST" = 1 ]; then
  echo "SS alternate port redirects on $PHAEDRA:"
  ssh "$PHAEDRA" "systemctl list-units --all 'ss-alt-*' 2>/dev/null | grep -E 'ss-alt-'" || echo "(none)"
  exit 0
fi

if [ -n "$REMOVE" ]; then
  UNIT="ss-alt-$REMOVE"
  ssh "$PHAEDRA" "sudo systemctl disable --now $UNIT 2>/dev/null; sudo rm -f /etc/systemd/system/$UNIT.service; sudo systemctl daemon-reload" 2>&1 | tail -2
  echo "mesh-ss-altport: removed port $REMOVE redirect"
  exit $?
fi

# Check if port is already in use on phaedra
if ssh "$PHAEDRA" "ss -tlnp | grep -q ':$PORT '" 2>/dev/null; then
  echo "mesh-ss-altport: port $PORT already in use on $PHAEDRA" >&2
  exit 1
fi

# Create systemd unit on phaedra
UNIT="ss-alt-$PORT"
ssh "$PHAEDRA" "sudo tee /etc/systemd/system/$UNIT.service > /dev/null" << EOF
[Unit]
Description=SS alternate port redirect ($PORT→$SS_PORT)
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/socat TCP-LISTEN:$PORT,reuseaddr,fork TCP:127.0.0.1:$SS_PORT
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF
ssh "$PHAEDRA" "sudo systemctl daemon-reload && sudo systemctl enable --now $UNIT" 2>&1 | tail -2

sleep 1
if ssh "$PHAEDRA" "systemctl is-active $UNIT" 2>/dev/null | grep -q active; then
  echo "mesh-ss-altport: port $PORT redirect active ($UNIT)"
else
  echo "mesh-ss-altport: FAIL — port $PORT redirect not active" >&2
  exit 1
fi

# Generate SS URI
SS_URI="ss://$(printf '%s:%s' "$METHOD" "$PASSWORD" | base64 -w0 | tr '+/' '-_' | tr -d '=')@${SS_HOST}:${PORT}#mesh-lte-bypass-${PORT}"
echo "  URI:   $SS_URI"
echo "  Host:  ${SS_HOST}:${PORT}"
echo "  —"
echo "  Tell operator to import this config with port ${PORT}"
