#!/usr/bin/env bash
# mesh-ss-altport — add/remove alternate port for SS tunnel on phaedra
# Some carriers (Megafon RU) block port 443 to foreign IPs but allow port 80.
# Creates a systemd-managed socat TCP redirect: alt-port → 443.
#
#   mesh-ss-altport <port>        add redirect + print SS URI for that port
#   mesh-ss-altport --remove <port>  remove the redirect
#   mesh-ss-altport --list        show all redirects
#   mesh-ss-altport --test        smoke test
set -euo pipefail
PHAEDRA="phaedra"
SSH_CMD="ssh -o StrictHostKeyChecking=no -o ConnectTimeout=10"
SS_HOST="38.49.216.141"
SS_PORT=443

do_test() {
  local fail=0
  for dep in ssh timeout base64 tr tail grep mktemp; do
    command -v "$dep" >/dev/null 2>&1 || { echo "FAIL: $dep missing"; fail=1; }
  done
  [ "$fail" = 0 ] || exit 1

  # Negative control: without ssh the real runtime must fail immediately.
  if env -i PATH=/tmp/empty HOME="$HOME" /bin/bash "$0" 8080 >/dev/null 2>&1; then
    echo "FAIL: missing ssh did not fail the runtime"
    exit 1
  fi

  td="$(mktemp -d /tmp/mesh-ss-altport-test.XXXXXX)" || { echo "FAIL: mktemp"; exit 1; }
  trap 'rm -rf "$td"' EXIT
  mkdir -p "$td/bin" "$td/home"
  cat > "$td/bin/ssh" <<'EOF'
#!/usr/bin/env bash
log="${MESH_SS_ALTPORT_LOG:-/tmp/mesh-ss-altport.log}"
printf '%s\n' "SSH: $*" >> "$log"
case " $* " in
  *" echo ok "*) exit 0 ;;
  *" command -v socat "*) printf '%s\n' /usr/bin/socat; exit 0 ;;
  *" ss -tlnp | grep -q ':8080 '"*) exit 1 ;;
  *" sudo tee /etc/systemd/system/ss-alt-8080.service > /dev/null "*) cat > "${MESH_SS_ALTPORT_UNIT_OUT:?missing unit out file}"; exit 0 ;;
  *" sudo systemctl daemon-reload && sudo systemctl enable --now ss-alt-8080 "*) printf '%s\n' "Created symlink /etc/systemd/system/multi-user.target.wants/ss-alt-8080.service → /etc/systemd/system/ss-alt-8080.service."; printf '%s\n' "Started ss-alt-8080.service."; exit 0 ;;
  *" systemctl is-active ss-alt-8080 "*) printf '%s\n' active; exit 0 ;;
esac
printf '%s\n' "unexpected ssh command: $*" >> "$log"
exit 99
EOF
  chmod +x "$td/bin/ssh"
  export HOME="$td/home"
  export PATH="$td/bin:$PATH"
  export MESH_SS_ALTPORT_LOG="$td/ssh.log"
  export MESH_SS_ALTPORT_UNIT_OUT="$td/ss-alt-8080.service"

  out="$("$0" 8080 2>&1)" || { echo "FAIL: dry-run runtime errored: $out"; exit 1; }
  printf '%s\n' "$out" | grep -q 'mesh-ss-altport: port 8080 redirect active (ss-alt-8080)' \
    || { echo "FAIL: active confirmation missing: $out"; exit 1; }
  printf '%s\n' "$out" | grep -q "ss://.*@${SS_HOST}:8080#mesh-lte-bypass-8080" \
    || { echo "FAIL: SS URI missing/changed: $out"; exit 1; }
  [ -r "$MESH_SS_ALTPORT_UNIT_OUT" ] || { echo "FAIL: unit file not captured"; exit 1; }
  grep -q "ExecStart=/usr/bin/socat TCP-LISTEN:8080,reuseaddr,fork TCP:127.0.0.1:${SS_PORT}" "$MESH_SS_ALTPORT_UNIT_OUT" \
    || { echo "FAIL: unit content drifted"; exit 1; }
  grep -q 'sudo tee /etc/systemd/system/ss-alt-8080.service' "$MESH_SS_ALTPORT_LOG" \
    || { echo "FAIL: tee command not exercised"; exit 1; }
  grep -q 'systemctl is-active ss-alt-8080' "$MESH_SS_ALTPORT_LOG" \
    || { echo "FAIL: active check not exercised"; exit 1; }
  echo "smoke-test: ok (ssh negative control + stubbed unit/URI dry-run verified)"
  exit 0
}

LIST=0; REMOVE=""
case "${1:-}" in
  --test) do_test;;
  --list) LIST=1; shift;;
  --remove) REMOVE="$2"; shift 2;;
  [0-9]*) PORT="$1"; shift;;
  *) echo "usage: $0 <port> | --remove <port> | --list | --test"; exit 1;;
esac

PASSWORD="OkzGhzr0B4Rod6L4S0KAvxJffSPUAfKSJh6X+32IJmg="
METHOD="chacha20-ietf-poly1305"

if [ "$LIST" = 1 ]; then
  echo "SS alternate port redirects on $PHAEDRA:"
  $SSH_CMD "$PHAEDRA" "systemctl list-units --all 'ss-alt-*' 2>/dev/null | grep -E 'ss-alt-'" || echo "(none)"
  exit 0
fi

if [ -n "$REMOVE" ]; then
  UNIT="ss-alt-$REMOVE"
  $SSH_CMD "$PHAEDRA" "sudo systemctl disable --now $UNIT 2>/dev/null; sudo rm -f /etc/systemd/system/$UNIT.service; sudo systemctl daemon-reload" 2>&1 | tail -2
  echo "mesh-ss-altport: removed port $REMOVE redirect"
  exit $?
fi

# Check if port is already in use on phaedra
if $SSH_CMD "$PHAEDRA" "ss -tlnp | grep -q ':$PORT '" 2>/dev/null; then
  echo "mesh-ss-altport: port $PORT already in use on $PHAEDRA" >&2
  exit 1
fi

# Create systemd unit on phaedra
UNIT="ss-alt-$PORT"
$SSH_CMD "$PHAEDRA" "sudo tee /etc/systemd/system/$UNIT.service > /dev/null" << EOF
[Unit]
Description=SS alternate port redirect ($PORT→$SS_PORT)
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/socat TCP-LISTEN:$PORT,reuseaddr,fork TCP:127.0.0.1:$SS_PORT
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF
$SSH_CMD "$PHAEDRA" "sudo systemctl daemon-reload && sudo systemctl enable --now $UNIT" 2>&1 | tail -2

sleep 1
if $SSH_CMD "$PHAEDRA" "systemctl is-active $UNIT" 2>/dev/null | grep -q active; then
  echo "mesh-ss-altport: port $PORT redirect active ($UNIT)"
else
  echo "mesh-ss-altport: FAIL — port $PORT redirect not active" >&2
  exit 1
fi

# Generate SS URI
SS_URI="ss://$(printf '%s:%s' "$METHOD" "$PASSWORD" | base64 -w0 | tr '+/' '-_' | tr -d '=')@${SS_HOST}:${PORT}#mesh-lte-bypass-${PORT}"
echo "  URI:   $SS_URI"
echo "  Host:  ${SS_HOST}:${PORT}"
echo "  —"
echo "  Tell operator to import this config with port ${PORT}"
