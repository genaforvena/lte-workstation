#!/usr/bin/env bash
# salama-regrind — re-grind an operator track with the LANE's derive engine.
#
# Operator, 2026-08-21 (via tg): the 06:34-06:44 batch varied FILTER BANDS
# (l840/l560/l120 ... -c1-300_2000-16000) and he called that "самое неинтересное".
# He asked for the diversity the lane gets on home recordings: measure the source's
# character -> mesh-sound-reflex --derive -> render through mesh-room-music, each
# derive repelled off the already-rendered params log.
#
# WHY THIS SLICES THE TRACK (measured before writing a line of it): running the lane's
# derive 10x on ONE character vector does NOT reproduce the lane's diversity. Dry-run,
# 6 derives off the whole-file measure of dub-flight: the sequence CYCLES WITH PERIOD 3
# (4,5,6 byte-identical to 1,2,3) and every axis he wants moved is PINNED —
# `m q ek 5 en 8 sw 0 snap nofill rv 0.3 env 0` constant across all six, with only l/ss/s
# and `c` (the bands!) moving. Naively "using the lane's derive" would have re-delivered
# exactly the boring thing under a better name.
# The lane's diversity on home recordings does not come from re-deriving one record — it
# comes from each record having its OWN character. So the faithful translation to a single
# long track is to give the derive many different WINDOWS of it. Verified: 4 segments of
# dub-flight move ek/en (7/12 vs 3/4), fg -12 vs nofill, l, ss and s — real derive axes,
# with the bands stripped out of the comparison.
#
# THE LANE'S LIVE TICK IS NOT TOUCHED: MESH_RMC_PARAMS_LOG points at a private store, so
# the repellent this batch builds is its own and the lane's params log neither grows nor
# steers from it (it is the same env var the reflex itself uses to sandbox --test).
set -uo pipefail

SRC="${1:?usage: salama-regrind <track.mp3> <n> [tag]}"
N="${2:-10}"
TAG="${3:-$(basename "${SRC%.*}")}"
MESH="$HOME/.mesh"
LOG="$MESH/salama-grind.log"
PARAMS="$MESH/salama-params.log"        # private repellent store — NOT the lane's
WORK="${SALAMA_WORK:-$MESH/salama-work}"
SEG_LEN="${SALAMA_SEG_LEN:-30}"
CAND="${SALAMA_CAND:-20}"               # windows measured, before selecting the spread N
DELIVER="${SALAMA_DELIVER:-1}"

export MESH_RMC_PARAMS_LOG="$PARAMS"
# SR_WORN_LOG IS WHAT ACTUALLY ENGAGES THE REPELLENT (corrected after the first 20, 2026-08-21).
# MESH_RMC_PARAMS_LOG only says where renders are LOGGED. The wear term the operator asked for —
# "каждый следующий derive отталкивался репеллентом от уже отрендеренных" — is read by derive from
# SR_WORN_LOG (mesh-sound-reflex: `worn_log = os.environ.get("SR_WORN_LOG", "")`), and unset it
# silently yields `worn none` on every line. The first run shipped 20 renders that way: 17 distinct
# recipes, and sw/rv/env PINNED across all twenty. With it set, four derives off ONE character
# vector come back distinct and move exactly those axes (sw 0/33/50, rv 0.3/0.15, env 0/4/25).
# Seeding it with the EXISTING log (not a fresh one) makes each new render repel off everything
# already sent, so a second pass adds material instead of repeating it.
export SR_WORN_LOG="${SALAMA_WORN_LOG:-$PARAMS}"
mkdir -p "$WORK/$TAG"; : >> "$LOG"; : >> "$PARAMS"

say(){ printf '%s %s\n' "$(date -u +%FT%TZ)" "$*" | tee -a "$LOG" >&2; }
kv(){ printf '%s' "$1" | grep -o "(^| )$2=[0-9.]*" -E | tail -1 | cut -d= -f2; }

dur="$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$SRC" 2>/dev/null | cut -d. -f1)"
[ -n "$dur" ] && [ "$dur" -gt 0 ] || { say "FATAL $TAG: cannot read duration of $SRC"; exit 1; }
say "BEGIN $TAG src=$SRC dur=${dur}s n=$N cand=$CAND seg=${SEG_LEN}s params=$PARAMS"

# ── 1. sample CAND windows and MEASURE each (the lane's own measure tract) ──────────────
span=$(( dur - SEG_LEN )); [ "$span" -lt 1 ] && span=1
: > "$WORK/$TAG/cand.tsv"
for i in $(seq 0 $((CAND-1))); do
  off=$(( span * i / CAND ))
  w="$WORK/$TAG/seg-$off.wav"
  [ -s "$w" ] || ffmpeg -v error -ss "$off" -t "$SEG_LEN" -i "$SRC" -ac 1 -ar 44100 "$w" -y 2>/dev/null
  [ -s "$w" ] || { say "  skip off=$off (ffmpeg produced nothing)"; continue; }
  m="$(mesh-soundscape --measure "$w" 2>/dev/null | tail -1)"
  case "$m" in MEASURE\ off=*) : ;; *) say "  skip off=$off (unmeasurable: ${m:-empty})"; continue ;; esac
  # first match = the window's own axis; the f-prefixed twin is the whole-segment fold
  g(){ printf '%s' "$m" | grep -oE "(^|[[:space:]])$1=[0-9.]+" | head -1 | cut -d= -f2; }
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$off" "$w" "$(g dyn)" "$(g act)" "$(g rich)" "$(g move)" "$(g cent)" "$(g beats)" "$(g dur)" \
    >> "$WORK/$TAG/cand.tsv"
done
nc=$(wc -l < "$WORK/$TAG/cand.tsv")
say "MEASURED $nc/$CAND windows of $TAG"
[ "$nc" -ge "$N" ] || { say "FATAL $TAG: only $nc measurable windows, need $N"; exit 1; }

# ── 2. pick the N most SPREAD-APART characters (greedy farthest-point) ──────────────────
# Every candidate is a real window of his track, so this selects, it never invents. Spread
# on the DERIVE axes (dyn/act/rich/move/cent + beat period) is what makes the derive move;
# picking the top-N by score would instead cluster them (and the score's upper tail is
# anti-rhythmic — CLAUDE.md).
python3 - "$WORK/$TAG/cand.tsv" "$N" > "$WORK/$TAG/pick.tsv" <<'PY'
import sys
rows=[l.rstrip('\n').split('\t') for l in open(sys.argv[1]) if l.strip()]
n=int(sys.argv[2])
def beat_ms(win,beats):
    try:
        w=float(win); b=float(beats)
    except ValueError: return 500
    if b<1 or w<=0: return 500
    v=w/b*1000.0
    return int(v) if 250<=v<=1200 else 500
pts=[]
for r in rows:
    off,w,dyn,act,rich,move,cent,beats,win=r[:9]
    f=lambda x,d: float(x) if x else d
    pts.append(dict(off=off,wav=w,dyn=f(dyn,.3),act=f(act,.3),rich=f(rich,.6),
                    move=f(move,.14),cent=f(cent,1100.),bms=beat_ms(win,beats)))
# normalise each axis over the candidate pool itself (self-calibrating; no assumed 0..1)
ax=['dyn','act','rich','move','cent','bms']
lo={a:min(p[a] for p in pts) for a in ax}; hi={a:max(p[a] for p in pts) for a in ax}
def nrm(p,a):
    s=hi[a]-lo[a]
    return 0.0 if s<=0 else (p[a]-lo[a])/s
def d(p,q): return sum((nrm(p,a)-nrm(q,a))**2 for a in ax)**.5
# seed at the pair that is farthest apart, then greedily add the point farthest from the set
best=(-1,0,1)
for i in range(len(pts)):
    for j in range(i+1,len(pts)):
        dd=d(pts[i],pts[j])
        if dd>best[0]: best=(dd,i,j)
sel=[pts[best[1]],pts[best[2]]]
rest=[p for k,p in enumerate(pts) if k not in (best[1],best[2])]
while len(sel)<n and rest:
    far=max(rest,key=lambda p:min(d(p,s) for s in sel))
    sel.append(far); rest.remove(far)
sel.sort(key=lambda p:int(p['off']))
for p in sel[:n]:
    print('\t'.join([p['off'],p['wav'],f"{p['dyn']:.3f}",f"{p['act']:.3f}",
                     f"{p['rich']:.3f}",f"{p['move']:.3f}",f"{p['cent']:.1f}",str(p['bms'])]))
PY
np=$(wc -l < "$WORK/$TAG/pick.tsv")
say "SELECTED $np windows by character spread (offsets: $(cut -f1 "$WORK/$TAG/pick.tsv" | tr '\n' ' '))"

# ── 3. derive -> render -> verify -> deliver, one at a time ────────────────────────────
i=0; ok=0
# READ THE PICK LIST ON FD 3, NOT STDIN (bug, first run 2026-08-21). ffmpeg reads stdin by default
# (that is what -nostdin exists for), and mesh-room-music runs ffmpeg inside this loop — so the
# child ate bytes out of pick.tsv mid-stream and the next `read` started off-by-a-character. The
# audio was unaffected (the wav path came from the same line) but the LABELS drifted: off=31 logged
# and captioned as off=1, off=60 as off=0. One caption reached the operator naming the wrong place
# in his own track. Classic loop-stdin capture; fd 3 makes the children's stdin irrelevant.
while IFS=$'\t' read -r off wav dyn act rich move cent bms <&3; do
  i=$((i+1))
  r="$(mesh-sound-reflex --derive "$dyn" "$act" "$rich" "$move" "$cent" "$bms" drop 2>/dev/null)"
  case "$r" in
    RECIPE*) : ;;
    *) say "  [$i/$np] $TAG off=$off DERIVE-REFUSED: ${r:-empty}"; continue ;;
  esac
  args="${r#RECIPE }"; args="${args%% ~ *}"; meta="${r#* ~ }"
  say "  [$i/$np] $TAG off=${off}s char(dyn=$dyn act=$act rich=$rich move=$move cent=$cent beat=${bms}ms) :: $args"
  # ONE src TAG FOR THE WHOLE TRACK, not one per window (corrected after track 1, 2026-08-21).
  # The repellent's wear is computed PER SOURCE by matching the params-log `src=` field, so tagging
  # every window `salama/dub-flight@237s` made each render a source of its own with no history:
  # all ten lines came back `worn none`, the repellent never engaged, and two of the ten derives
  # (#4 and #7) were IDENTICAL once the bands were stripped — the exact duplication the operator
  # asked to avoid. The window spread alone had been carrying the diversity. The offset still
  # belongs in the log and the TG caption (it says WHERE in his track the mix was cut from); it just
  # must not be part of the identity the repellent keys on.
  out="$(MESH_RMC_AUTOMIX="$args" MESH_RMC_META="src=salama/$TAG $meta off=${off}s" \
         timeout 600 mesh-room-music --remix "$wav" 2>&1)"; rc=$?
  case "$out" in
    /*.mp3|/*.mp3$'\n'*) track="$(printf '%s' "$out" | tail -1)" ;;
    *) say "  [$i/$np] $TAG off=$off RENDER-FAILED rc=$rc: $(printf '%s' "$out" | tail -1)"; continue ;;
  esac
  [ -s "$track" ] || { say "  [$i/$np] $TAG off=$off RENDER-EMPTY: $track"; continue; }
  # CROSS-ATTRIBUTION GUARD: OUTROOT is shared with the live lane, and mesh-room-music's
  # FRESH gate picks the newest mp3 by mtime — so a lane render landing inside our window
  # would be handed back to us as ours. The filename encodes the recipe, so assert OUR
  # grain length is in it. Cheap, and it fails loud instead of shipping someone else's track.
  lval="$(printf '%s' "$args" | grep -oE ' l [0-9]+' | awk '{print $2}')"
  case "$(basename "$track")" in
    l${lval}_*) : ;;
    *) say "  [$i/$np] $TAG off=$off ATTRIBUTION-MISMATCH: recipe l=$lval but got $(basename "$track") — refusing to ship a track this batch did not render"; continue ;;
  esac
  ok=$((ok+1))
  say "  [$i/$np] $TAG off=$off RENDERED $(basename "$track") ($(du -h "$track" | cut -f1))"
  if [ "$DELIVER" = 1 ]; then
    cap="salama · $TAG @${off}s · $args"
    if mesh-room-music --deliver "$track" "$cap" "Salama $TAG" own >/dev/null 2>&1; then
      say "  [$i/$np] $TAG off=$off DELIVERED"
    else
      say "  [$i/$np] $TAG off=$off DELIVERY-FAILED (track kept: $track)"
    fi
  fi
done 3< "$WORK/$TAG/pick.tsv"
say "END $TAG rendered=$ok/$np"
[ "$ok" -gt 0 ]
