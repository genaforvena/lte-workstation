#!/usr/bin/env bash
# mesh-claim-cleanup — scan board for stale [taking] claims >30min with no [done]/update.
# Posts [task-unstale] to re-open stale tasks. Complements mesh-failover.
#
#   mesh-claim-cleanup         scan + unstale (posts to mesh-chat)
#   mesh-claim-cleanup --dry   scan + report only
#   mesh-claim-cleanup --test  deps smoke
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
CHATLOG="${CHATLOG:-$HOME/.mesh/chat.log}"
NOW=$(date -u +%s)
STALE_SEC="${MESH_CLAIM_STALE:-1800}"

[ "${1:-}" = --test ] && {
  command -v date >/dev/null 2>&1 || { echo "smoke-test: FAIL (no date)"; exit 1; }
  command -v grep >/dev/null 2>&1 || { echo "smoke-test: FAIL (no grep)"; exit 1; }
  # dry-run: feed mock chat.log with a stale claim, verify it is detected
  _td="$(mktemp -d)"
  printf '2000-01-01T00:00:00Z  any@node  ::  [taking] test: stale claim\n' >"$_td/chatlog"
  CHATLOG="$_td/chatlog" "${BASH_SOURCE[0]}" --dry 2>/dev/null; _rc=$?
  rm -rf "$_td"
  [ "$_rc" = 0 ] || { echo "smoke-test: FAIL (dry-run on stale claim expected exit 0, got $_rc)"; exit 1; }
  echo "smoke-test: ok"; exit 0
}

DRY=0; [ "${1:-}" = --dry ] && DRY=1
[ -f "$CHATLOG" ] || { echo "no chat.log"; exit 0; }

stale=0
while IFS= read -r line; do
  ts_raw="${line:0:20}"
  take_ts=$(date -u -d "${ts_raw}" +%s 2>/dev/null) || continue
  age=$(( NOW - take_ts ))
  [ "$age" -lt "$STALE_SEC" ] && continue
  rest="${line:25}"
  sender="${rest%%  ::  *}"
  msg="${rest#*  ::  }"
  taken="${msg#*\[taking\] }"
  # Extract agent key (first 30 chars of the taken task, stripped)
  agent_key="$(printf '%s' "$taken" | sed 's/[^a-zA-Z0-9 -]//g' | head -c 30)"
  [ -z "$agent_key" ] && continue
  # Check for [done] referencing the same task (agent key in same line)
  done_match=$(grep -c '\[done\]' "$CHATLOG" 2>/dev/null || true)
  if [ "$done_match" -gt 0 ]; then
    # Find the most recent [done]
    last_done=$(grep '\[done\]' "$CHATLOG" 2>/dev/null | tail -1)
    last_done_ts="${last_done:0:25}"
    last_done_clean="${last_done_ts%Z }"
    last_done_epoch=$(date -u -d "${last_done_clean}" +%s 2>/dev/null || echo 0)
    # If the most recent [done] is AFTER this taking, consider it handled
    [ "$last_done_epoch" -gt "$take_ts" ] && continue
  fi
  if [ "$DRY" = 1 ]; then
    printf 'STALE [taking] by %s (%s): %s (age=%ds)\n' "$sender" "$ts_raw" "$taken" "$age"
  else
    post="[task-unstale] $taken (was [taking] by $sender, stale ${age}s)"
    mesh-channel chat "$CHATLOG" 'mesh-chat-filter' opencode --post "$post" 2>/dev/null || true
    printf 'UNSTALE %s: %s\n' "$sender" "$taken"
  fi
  stale=$(( stale + 1 ))
done < <(grep -F '[taking]' "$CHATLOG" 2>/dev/null || true)
[ "$stale" -eq 0 ] && echo "No stale claims"
exit 0
