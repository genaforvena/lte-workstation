#!/usr/bin/env bash
# Event-driven task-view refresh. Cron remains the missed-event/age backstop.
# reflex-cadence: */5 * * * *
# reflex-args: --window 290 --debounce 1 $HOME/.mesh/chat.log -- mesh-task-journal
set -euo pipefail

export PATH="$HOME/.local/bin:$PATH"
MESH_DIR="${MESH_DIR:-$HOME/.mesh}"
TASK_LOCK="${MESH_TASK_WATCH_LOCK:-$MESH_DIR/.fsnotify-tasks.lock}"

if [[ "${1:-}" == --test ]]; then
  command -v mesh-fsnotify >/dev/null 2>&1 || {
    echo 'mesh-task-watch --test: n/a (mesh-fsnotify unavailable)' >&2
    exit 2
  }
  mesh-fsnotify --test >/dev/null 2>&1 || {
    echo 'mesh-task-watch --test: n/a (mesh-fsnotify mechanism failed)' >&2
    exit 2
  }
  td="$(mktemp -d)"
  trap 'rm -rf "$td"' EXIT
  target="$td/chat.log"
  fired="$td/fired"
  : >"$target"
  printf '#!/bin/sh\nprintf "fired\\n" >>"%s"\n' "$fired" >"$td/fire"
  chmod +x "$td/fire"
  MESH_TASK_WATCH_LOCK="$td/lock" "$0" --window 4 --debounce 0 \
    "$target" -- "$td/fire" >/dev/null 2>&1 &
  watcher=$!
  sleep 0.4
  printf 'event\n' >>"$target"
  for _ in $(seq 1 20); do
    [[ -s "$fired" ]] && break
    sleep 0.1
  done
  kill "$watcher" 2>/dev/null || true
  wait "$watcher" 2>/dev/null || true
  grep -q fired "$fired" || {
    echo 'mesh-task-watch --test: FAIL (write did not trigger command)' >&2
    exit 1
  }
  echo 'mesh-task-watch --test: PASS (chat.log write triggers task replay)'
  exit 0
fi

export MESH_FSNOTIFY_LOCK="$TASK_LOCK"
exec mesh-fsnotify "$@"
