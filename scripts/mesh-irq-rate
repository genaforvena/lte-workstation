#!/usr/bin/env python3
# orphan-ok: on-demand kernel interrupt snapshot; sampled when asked, not scheduled
"""mesh-irq-rate — interrupt activity sense from /proc/interrupts (+ softirq load).

Reads /proc/interrupts twice, computes the per-second interrupt rate, and reports
the busiest line. Exit 2 if interrupts are unreadable; never fabricates a reading.

THE CLASSIFIED AXIS IS THE **DEVICE** RATE, NOT THE TOTAL. /proc/interrupts carries two
populations under one sum: NUMBERED lines are real hardware IRQs, and LETTERED lines
(LOC/CAL/RES/TLB/...) are architecture bookkeeping — the local timer tick and scheduler
IPIs, which scale with cores x kernel HZ and carry no device signal at all. Classifying
their SUM made the verdict track the WRONG THING here: on mesh-home (16 cores, CONFIG_HZ=1000)
the bookkeeping floor alone runs ~2400-22000/s, dwarfing a device population of ~50-1100/s,
so the level moved with C-STATE RESIDENCY (how many cores are ticking) rather than with
device activity. Measured 2026-08-18, same node, same morning:
  * busy window 08:07-08:12Z: 12/12 samples BURST under the old bands (QUIET<500,
    ACTIVE<5000, BURST>=5000) -- including full rest -- and `top=` named LOC, the clock,
    in 7 of 8 of them. A clock tick is not a wakeup source.
  * deep-rest window 08:31Z, paired old/new alternating n=8: the old total swung
    2386 -> 20901/s (8.8x, one sample crossing QUIET->ACTIVE) while the device axis over
    the same eight pairs stayed 57-615/s. The flip was bookkeeping, not devices.
Worse than noisy, the total also INVERTS the order between two real workloads (below).
A 1M-block direct read (950 MB/s) produced total=22712/s with only 604 device irq/s, while
8x 64k parallel reads produced a LOWER total=15158/s with 8314 device irq/s -- 14x more
device interrupts, ranked lower by the total. At the extremes old and new agree (both say
BURST under saturated IO); it is the middle, and the attribution, that the total gets wrong.

Measured device-axis corpus, this node, at the tool's OWN 1s window (basis for the
bands below; a 10s window reads far lower — a rate is only comparable to a band that
was calibrated at the same window):
    passive rest, n=30       min 43 / p50 147 / p90 688 / p95 909 / max 1132 per s
    1x 1M direct read        604/s   <- high THROUGHPUT, low interrupt rate (coalescing);
                                        this is an interrupt sense, not a bandwidth sense
    8x 64k parallel reads    8314 - 20593/s
The axis is BIMODAL here, and the middle band has no steady occupant (measured
2026-08-18, load held 1.2s BEFORE the 1s window opens so no sample straddles a ramp):
    1 stream, 64k/128k/256k  1053 - 1383/s  (n=9; 8 of 9 QUIET, one 1383 boundary jitter)
    2 streams, 64k           9620 - 17527/s (n=6; ALL BURST)
There is no load between them: one stream plateaus at the QUIET ceiling, two jump
past the BURST floor. So an ACTIVE reading on this node is a TRANSITION — a window
straddling a load starting or stopping — not a regime. A first ladder read ACTIVE
5744/s at 2x64k and did NOT survive repetition: that sample caught the ramp, the
same shape as [[a-counter-delta-straddles-the-change-instant]]. ACTIVE is kept (the
band is real arithmetic and another node's device population will occupy it), but
nothing here should read a steady ACTIVE as a named load.
THE QUIET CEILING IS LOAD-BEARING, NOT COSMETIC: one ordinary IO stream sits at
~1090/s, so a QUIET_MAX pushed below ~1200 makes a single reader a permanent ACTIVE
— the resting-state-is-a-level failure this whole axis exists to remove, one band up.
IRQ 67 (xhci_hcd, the USB controller carrying this node's SOLE uplink dongle) was the
top device in 30/30 rest samples at 86% of the device axis (p50; up to 98%), so here the
device axis is very nearly the uplink's interrupt load — which is why `top-dev` publishes
its SHARE: a level driven by one device is a different fact from broad activity.
Both `dev` and `kern` are published beside `total` so no reader can mistake the narrow
claim for the wide one, and `top-dev`/`top-kern` are ranked within their own population.

Also samples /proc/softirqs (read by NO other mesh tool — discover 2026-07-03) for
the busiest softirq's per-second delta AND its top-CPU CONCENTRATION share. The
concentration is the load-bearing signal: NET_RX pinned ~99% to one CPU means RPS
isn't spreading receive-softirq work → single-CPU network-RX-vs-mind contention the
per-CPU-summing interrupt view can't see (the middle layer between irq-rate and
nic-drops). honest-fusion: if /proc/softirqs is unreadable the softirq block reports
UNAVAILABLE (never a fabricated 0) while the interrupt reading stands on its own.
"""
import json
import os
import re
import sys
import time

import signal
# SIGTERM MUST UNWIND, or every `finally` in this file is decorative. Python's DEFAULT SIGTERM
# disposition terminates the interpreter WITHOUT running finally blocks (and without
# TemporaryDirectory.__exit__), so a correct-looking cleanup never runs. The signal is not
# hypothetical: GNU `timeout` — which wraps this tool at its call sites and wraps EVERY `--test` in
# mesh-doctor's hourly sweep and in mesh-autowire — puts its child in its OWN process group and
# signals the GROUP, so this process gets the TERM. sys.exit() from the handler raises SystemExit in
# the main thread, which is what actually unwinds. SIGKILL stays uncatchable; that half is
# mesh-tmp-guard's sweep. Pattern and the measured mechanism: eb5b8e7, scripts/mesh-spend.
for _sig in (signal.SIGTERM, signal.SIGHUP):
    signal.signal(_sig, lambda _s, _f: sys.exit(128 + _s))

SNAPSHOT = os.environ.get("MESH_IRQ_PATH", "/proc/interrupts")
SNAPSHOT2 = os.environ.get("MESH_IRQ_PATH2", SNAPSHOT)
SOFTIRQ_PATH = os.environ.get("MESH_SOFTIRQ_PATH", "/proc/softirqs")
SOFTIRQ_PATH2 = os.environ.get("MESH_SOFTIRQ_PATH2", SOFTIRQ_PATH)
SLEEP_SECS = float(os.environ.get("MESH_IRQ_SAMPLE_SECS", "1"))


def parse_snapshot(path):
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as fh:
            lines = fh.read().splitlines()
    except OSError:
        return None

    totals = {}
    for line in lines:
        if not line.strip() or line.lstrip().startswith("CPU"):
            continue
        m = re.match(r"^\s*([^:]+):\s+(.*)$", line)
        if not m:
            continue
        irq = m.group(1).strip()
        rest = m.group(2).split()
        counts = []
        for tok in rest:
            if re.fullmatch(r"\d+", tok):
                counts.append(int(tok))
            else:
                break
        if not counts:
            continue
        desc = " ".join(rest[len(counts):]).strip()
        totals[irq] = {"total": sum(counts), "desc": desc}
    return totals


def sum_totals(snapshot):
    return sum(row["total"] for row in snapshot.values())


def is_device(name):
    """True for a real hardware IRQ line, False for architecture bookkeeping.

    /proc/interrupts is two tables stacked: the numbered section is the IRQ number
    (a device), the lettered section is per-arch kernel counters (LOC/CAL/RES/TLB/
    NMI/IPIn/...). Split on 'is the label a number', NOT on a list of known names —
    a name list is only as good as the names it knows and silently reclassifies
    every counter a future kernel or a different arch adds."""
    return str(name).strip().isdigit()


def split_totals(snapshot):
    """(device_total, kernel_total) — the two populations summed apart."""
    dev = ker = 0
    for name, row in snapshot.items():
        if is_device(name):
            dev += row["total"]
        else:
            ker += row["total"]
    return dev, ker


def delta_top(before, after, want_device=None):
    """Busiest line by delta. want_device=True ranks only hardware IRQs, False only
    kernel bookkeeping, None the whole file (legacy). Ranking across BOTH is what
    made `top=` report LOC on every sample — the clock is not a wakeup source."""
    keys = set(before) | set(after)
    best = None
    for irq in keys:
        if want_device is not None and is_device(irq) != want_device:
            continue
        b = before.get(irq, {"total": 0, "desc": ""})
        a = after.get(irq, {"total": 0, "desc": ""})
        d = a["total"] - b["total"]
        cand = (d, irq, a["desc"] or b["desc"])
        if best is None or cand[0] > best[0] or (cand[0] == best[0] and cand[1] < best[1]):
            best = cand
    return best or (0, "-", "")


def parse_softirqs(path):
    """Return {name: [per-CPU counts]} (per-CPU RETAINED, not summed — the skew is
    the signal) or None if the file is unreadable (→ honest UNAVAILABLE, never 0)."""
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as fh:
            lines = fh.read().splitlines()
    except OSError:
        return None
    out = {}
    for line in lines:
        if not line.strip() or line.lstrip().startswith("CPU"):
            continue
        m = re.match(r"^\s*([^:]+):\s+(.*)$", line)
        if not m:
            continue
        name = m.group(1).strip()
        counts = [int(t) for t in m.group(2).split() if re.fullmatch(r"\d+", t)]
        if counts:
            out[name] = counts
    return out


def softirq_hotspot(before, after):
    """Busiest softirq by total delta (the 'what's hot right now' RATE context).
    Returns (name, total_delta, top_cpu_index, top_cpu_share) or None if no activity.
    NOTE: over a short window the busiest is usually SCHED/RCU (kernel background,
    naturally spread) — so this is rate context, NOT the pinning signal; NET_RX
    concentration below is the standing pathology (a pinned-but-quiet softirq is
    invisible here)."""
    best = None
    for name in set(before) | set(after):
        b = before.get(name, [])
        a = after.get(name, [])
        n = max(len(a), len(b))
        deltas = [max(0, (a[i] if i < len(a) else 0) - (b[i] if i < len(b) else 0)) for i in range(n)]
        tot = sum(deltas)
        if tot <= 0:
            continue
        top_cpu = max(range(len(deltas)), key=lambda i: deltas[i])
        share = deltas[top_cpu] / tot
        cand = (tot, name, top_cpu, share)
        if best is None or cand[0] > best[0] or (cand[0] == best[0] and cand[1] < best[1]):
            best = cand
    if best is None:
        return None
    return (best[1], best[0], best[2], best[3])


def cpu_concentration(snapshot, name):
    """Top-CPU share of a named softirq from CUMULATIVE per-CPU counts — the standing
    RPS-spread signal (share≈1.0 = one CPU carries nearly all of it → not spreading).
    Cumulative (not delta) because RPS/IRQ-affinity is a standing config, so a quiet
    window doesn't erase the pinning. Returns (top_cpu_index, share) or None if absent
    or zero-total (→ honest 'no data', never a fabricated 0)."""
    if snapshot is None or name not in snapshot:
        return None
    counts = snapshot[name]
    tot = sum(counts)
    if tot <= 0 or not counts:
        return None
    top_cpu = max(range(len(counts)), key=lambda i: counts[i])
    return (top_cpu, counts[top_cpu] / tot)


# Bands on the DEVICE rate only, calibrated against this node's measured corpus
# (passive rest n=30: p50 147, p95 909, max 1132; saturated small-block IO 8314-20593)
# — never an assumed scale. All three are reachable here in both directions; the old absolute
# bands on the TOTAL were not (BURST was the resting state). Overridable so a node
# with a different device population is not pinned to mesh-home's numbers.
QUIET_MAX = float(os.environ.get("MESH_IRQ_QUIET_MAX", "1200"))   # passive rest maxed at 1132/s (n=30)
BURST_MIN = float(os.environ.get("MESH_IRQ_BURST_MIN", "6000"))   # saturated IO floor was 8314/s


def classify(rate):
    """Classify the DEVICE interrupt rate. Passing the total here is the bug this
    band set exists to fix — see the module docstring."""
    if rate < QUIET_MAX:
        return "QUIET"
    if rate < BURST_MIN:
        return "ACTIVE"
    return "BURST"


if "--test" in sys.argv[1:]:
    import tempfile
    td = tempfile.TemporaryDirectory()
    try:
        s1 = os.path.join(td.name, "snap1")
        s2 = os.path.join(td.name, "snap2")
        with open(s1, "w", encoding="utf-8") as fh:
            fh.write(
                "           CPU0       CPU1\n"
                "  1:          1          2  i8042\n"
                "  9:          3          4  acpi\n"
            )
        with open(s2, "w", encoding="utf-8") as fh:
            fh.write(
                "           CPU0       CPU1\n"
                "  1:        301        302  i8042\n"
                "  9:          5          4  acpi\n"
            )
        a = parse_snapshot(s1)
        b = parse_snapshot(s2)
        if a is None or b is None:
            print("smoke-test: FAIL (fixture parse failed)")
            raise SystemExit(1)
        if sum_totals(a) != 10 or sum_totals(b) != 612:
            print(f"smoke-test: FAIL (fixture totals wrong: {sum_totals(a)} {sum_totals(b)})")
            raise SystemExit(1)
        top = delta_top(a, b)
        if top[0] != 600 or top[1].strip() != "1" or top[2] != "i8042":
            print(f"smoke-test: FAIL (top delta wrong: {top})")
            raise SystemExit(1)
        rate = (sum_totals(b) - sum_totals(a)) / 1.0
        # 602 device irq/s is QUIET under the corpus-calibrated bands (passive rest here
        # reaches 1132/s). This leg asserted ACTIVE when the bands were the old absolute
        # 500/5000 set — the assertion moved with the calibration, deliberately.
        if classify(rate) != "QUIET":
            print(f"smoke-test: FAIL (classify({rate}) = {classify(rate)}, want QUIET)")
            raise SystemExit(1)
        if parse_snapshot("/nonexistent/interrupts") is not None:
            print("smoke-test: FAIL (missing file should not parse)")
            raise SystemExit(1)
        # --- softirq hotspot: per-CPU concentration is the signal ---
        ss1 = os.path.join(td.name, "soft1")
        ss2 = os.path.join(td.name, "soft2")
        with open(ss1, "w", encoding="utf-8") as fh:
            fh.write(
                "                    CPU0       CPU1\n"
                "      NET_RX:       1000         10\n"
                "       SCHED:        500        500\n"
            )
        with open(ss2, "w", encoding="utf-8") as fh:
            fh.write(
                # NET_RX +990 on CPU0, +10 on CPU1 → 99% pinned to CPU0 (the real find)
                "                    CPU0       CPU1\n"
                "      NET_RX:       1990         20\n"
                "       SCHED:        600        600\n"
            )
        sa = parse_softirqs(ss1)
        sb = parse_softirqs(ss2)
        if sa is None or sb is None:
            print("smoke-test: FAIL (softirq fixture parse failed)")
            raise SystemExit(1)
        hs = softirq_hotspot(sa, sb)
        if hs is None:
            print("smoke-test: FAIL (softirq hotspot None on active fixture)")
            raise SystemExit(1)
        hs_name, hs_delta, hs_cpu, hs_share = hs
        # NET_RX delta 1000 > SCHED delta 200 → busiest; pinned to CPU0 at 990/1000
        if hs_name != "NET_RX" or hs_delta != 1000 or hs_cpu != 0 or round(hs_share, 2) != 0.99:
            print(f"smoke-test: FAIL (softirq hotspot wrong: {hs})")
            raise SystemExit(1)
        # honest UNAVAILABLE: unreadable /proc/softirqs → None, never a fabricated 0
        if parse_softirqs("/nonexistent/softirqs") is not None:
            print("smoke-test: FAIL (missing softirqs should not parse)")
            raise SystemExit(1)
        # no-activity (identical snapshots) → None, not a zero-share hotspot
        if softirq_hotspot(sa, sa) is not None:
            print("smoke-test: FAIL (idle softirq should yield no hotspot)")
            raise SystemExit(1)
        # NET_RX standing concentration from cumulative counts (the find): 1990/2010≈0.99
        conc = cpu_concentration(sb, "NET_RX")
        if conc is None or conc[0] != 0 or round(conc[1], 2) != 0.99:
            print(f"smoke-test: FAIL (net_rx concentration wrong: {conc})")
            raise SystemExit(1)
        # absent softirq → None (honest 'no data', not a fabricated share)
        if cpu_concentration(sb, "NONEXISTENT_SOFTIRQ") is not None:
            print("smoke-test: FAIL (absent softirq should give no concentration)")
            raise SystemExit(1)
        # --- THE REGRESSION: device axis vs the bookkeeping-dominated total ---
        # Fixture reproduces mesh-home's real shape: a quiet device population under a
        # huge timer/IPI floor. Old code classified the SUM and could only say BURST.
        d1 = os.path.join(td.name, "dev1")
        d2 = os.path.join(td.name, "dev2")
        with open(d1, "w", encoding="utf-8") as fh:
            fh.write(
                "           CPU0       CPU1\n"
                " 67:          0          0  IR-PCI-MSI 1-edge xhci_hcd\n"
                " 90:          0          0  IR-PCI-MSI 2-edge nvme0q1\n"
                "LOC:          0          0  Local timer interrupts\n"
                "CAL:          0          0  Function call interrupts\n"
            )
        with open(d2, "w", encoding="utf-8") as fh:
            fh.write(
                # devices +90 total (QUIET), bookkeeping +9000 (would be BURST on the sum)
                "           CPU0       CPU1\n"
                " 67:         40         20  IR-PCI-MSI 1-edge xhci_hcd\n"
                " 90:         20         10  IR-PCI-MSI 2-edge nvme0q1\n"
                "LOC:       4000       4000  Local timer interrupts\n"
                "CAL:        500        500  Function call interrupts\n"
            )
        da = parse_snapshot(d1)
        db = parse_snapshot(d2)
        if da is None or db is None:
            print("smoke-test: FAIL (device/kernel fixture parse failed)")
            raise SystemExit(1)
        if not is_device("67") or not is_device(" 90 "):
            print("smoke-test: FAIL (a numbered /proc/interrupts line is a device IRQ)")
            raise SystemExit(1)
        if is_device("LOC") or is_device("CAL") or is_device("IPI0"):
            print("smoke-test: FAIL (a lettered line is kernel bookkeeping, not a device)")
            raise SystemExit(1)
        dev_b, ker_b = split_totals(da)
        dev_a, ker_a = split_totals(db)
        if (dev_a - dev_b, ker_a - ker_b) != (90, 9000):
            print(f"smoke-test: FAIL (split wrong: dev+{dev_a - dev_b} ker+{ker_a - ker_b}, want 90/9000)")
            raise SystemExit(1)
        # the sum must NOT be what decides the level
        if classify(float(sum_totals(db) - sum_totals(da))) != "BURST":
            print("smoke-test: FAIL (fixture no longer reproduces the bookkeeping-BURST it guards)")
            raise SystemExit(1)
        if classify(float(dev_a - dev_b)) != "QUIET":
            print(f"smoke-test: FAIL (90 device irq/s under a 9000/s timer floor must read QUIET, "
                  f"got {classify(float(dev_a - dev_b))} — the level is riding the total again)")
            raise SystemExit(1)
        # top-dev must name a DEVICE even though LOC dwarfs every device line
        dtop = delta_top(da, db, want_device=True)
        if dtop[1].strip() != "67" or dtop[0] != 60:
            print(f"smoke-test: FAIL (top device irq wrong: {dtop} — the clock is not a wakeup source)")
            raise SystemExit(1)
        ktop = delta_top(da, db, want_device=False)
        if ktop[1].strip() != "LOC" or ktop[0] != 8000:
            print(f"smoke-test: FAIL (top kernel counter wrong: {ktop})")
            raise SystemExit(1)
        # both band edges reachable on the device axis (a band never seen cross is not a band)
        if classify(8314.5) != "BURST" or classify(1132.0) != "QUIET" or classify(147.0) != "QUIET":
            print("smoke-test: FAIL (measured corpus 147/1132 rest and 8314 saturated must land "
                  "QUIET/QUIET/BURST)")
            raise SystemExit(1)
        # ...and PIN THE EDGES. The corpus points alone do not straddle the old 500/5000
        # bands, so a revert to them passed every corpus assertion above while restoring
        # exactly the calibration this fix exists to remove.
        for _r, _want in ((1199.0, "QUIET"), (1201.0, "ACTIVE"), (2000.0, "ACTIVE"),
                          (5999.0, "ACTIVE"), (6001.0, "BURST"), (9000.0, "BURST")):
            if classify(_r) != _want:
                print(f"smoke-test: FAIL (band edge moved: classify({_r}) = {classify(_r)}, want {_want} "
                      f"— 1199/s sits inside this node's measured passive-rest range and is not ACTIVE)")
                raise SystemExit(1)
        # --- END-TO-END: the MAIN PATH, not just the helpers ---
        # Every helper leg above passed with `level = classify(rate)` and
        # `delta_top(..., want_device=None)` restored in main — a rule asserted in a
        # helper is not asserted at the call site. Run the real script on the fixtures.
        import subprocess
        _env = dict(os.environ, MESH_IRQ_PATH=d1, MESH_IRQ_PATH2=d2,
                    MESH_IRQ_SAMPLE_SECS="1", MESH_SOFTIRQ_PATH="/nonexistent/softirqs",
                    MESH_SOFTIRQ_PATH2="/nonexistent/softirqs")
        _r = subprocess.run([sys.executable, os.path.abspath(__file__), "--json"],
                            capture_output=True, text=True, timeout=60, env=_env)
        if _r.returncode != 0:
            print(f"smoke-test: FAIL (end-to-end --json rc={_r.returncode}: {_r.stderr.strip()[:200]})")
            raise SystemExit(1)
        _j = json.loads(_r.stdout)
        if _j["level"] != "QUIET":
            print(f"smoke-test: FAIL (end-to-end level={_j['level']}, want QUIET — 90 device irq/s "
                  f"under a 9000/s timer floor; the live path is classifying the total again)")
            raise SystemExit(1)
        if _j["level_axis"] != "device":
            print("smoke-test: FAIL (end-to-end .level_axis must name the classified axis)")
            raise SystemExit(1)
        if (_j["device_per_s"], _j["kernel_per_s"], _j["irq_per_s"]) != (90.0, 9000.0, 9090.0):
            print(f"smoke-test: FAIL (end-to-end rates wrong: {_j['device_per_s']}/"
                  f"{_j['kernel_per_s']}/{_j['irq_per_s']}, want 90/9000/9090)")
            raise SystemExit(1)
        if _j["top_irq"].strip() != "67" or _j["top_kernel_irq"].strip() != "LOC":
            print(f"smoke-test: FAIL (end-to-end top wrong: dev={_j['top_irq']!r} "
                  f"kern={_j['top_kernel_irq']!r} — the clock is ranking as a device again)")
            raise SystemExit(1)
        _r2 = subprocess.run([sys.executable, os.path.abspath(__file__)],
                             capture_output=True, text=True, timeout=60, env=_env)
        if "[irq-rate] QUIET" not in _r2.stdout or "top-dev=67" not in _r2.stdout:
            print(f"smoke-test: FAIL (end-to-end human line wrong: {_r2.stdout.strip()[:220]})")
            raise SystemExit(1)
        # BOTH rates AND both top lines — the top-kern half was droppable without a
        # single leg noticing until this assertion named it (mutation-checked).
        if ("dev=90.0/s" not in _r2.stdout or "kern=9000.0/s" not in _r2.stdout
                or "top-dev=67" not in _r2.stdout or "top-kern=LOC" not in _r2.stdout):
            print(f"smoke-test: FAIL (human line must publish BOTH populations: {_r2.stdout.strip()[:220]})")
            raise SystemExit(1)

        # --- LIVE READ: the real /proc/interrupts must actually carry both populations ---
        # A fixture-only gate cannot catch a node where the split silently degenerates.
        live = parse_snapshot("/proc/interrupts")
        if live is not None:
            l_dev, l_ker = split_totals(live)
            if l_dev <= 0 or l_ker <= 0:
                print(f"smoke-test: FAIL (live /proc/interrupts split degenerate: dev={l_dev} ker={l_ker} "
                      f"— one population empty means the classifier is reading the other one whole)")
                raise SystemExit(1)
        print("smoke-test: ok (irq parse/delta/classify + device-vs-bookkeeping split + band reachability + live split + softirq hotspot/skew/unavailable/idle + net_rx concentration)")
        raise SystemExit(0)
    finally:
        td.cleanup()


start = parse_snapshot(SNAPSHOT)
if start is None:
    print("mesh-irq-rate: /proc/interrupts not readable — UNREACHABLE", file=sys.stderr)
    raise SystemExit(2)
soft_start = parse_softirqs(SOFTIRQ_PATH)   # None → softirq block UNAVAILABLE, interrupts still stand
start_ts = time.time()
if SNAPSHOT2 == SNAPSHOT:
    time.sleep(max(SLEEP_SECS, 0.0))
end = parse_snapshot(SNAPSHOT2)
if end is None:
    print("mesh-irq-rate: /proc/interrupts not readable — UNREACHABLE", file=sys.stderr)
    raise SystemExit(2)
soft_end = parse_softirqs(SOFTIRQ_PATH2)
end_ts = time.time()

if SNAPSHOT2 == SNAPSHOT:
    elapsed = max(end_ts - start_ts, 0.001)
else:
    # Two distinct snapshot paths: the caller supplied both sides, so no time actually
    # passed here — the window is the one they declare (MESH_IRQ_SAMPLE_SECS), not the
    # ~1ms it took to read two files. Dividing by that 1ms fabricates a 1000x rate.
    elapsed = max(SLEEP_SECS, 0.001)
before = sum_totals(start)
after = sum_totals(end)
rate = max(0.0, (after - before) / elapsed)              # TOTAL — context, never the verdict
dev_before, ker_before = split_totals(start)
dev_after, ker_after = split_totals(end)
dev_rate = max(0.0, (dev_after - dev_before) / elapsed)  # the classified axis
ker_rate = max(0.0, (ker_after - ker_before) / elapsed)  # timer + IPI bookkeeping
level = classify(dev_rate)
top_rate, top_irq, top_desc = delta_top(start, end, want_device=True)
desc = top_desc or "?"
ktop_rate, ktop_irq, _ktop_desc = delta_top(start, end, want_device=False)
# cores from any parsed row (all rows carry one count per CPU); HZ only if the kernel
# config is readable — the floor note states what is known, never an invented number.
_ncpu = 0
try:
    with open(SNAPSHOT, "r", encoding="utf-8", errors="replace") as _fh:
        for _l in _fh:
            if _l.lstrip().startswith("CPU"):
                _ncpu = len(_l.split())
                break
except OSError:
    _ncpu = 0
_hz = None
try:
    with open("/boot/config-" + os.uname().release, "r", encoding="utf-8", errors="replace") as _fh:
        for _l in _fh:
            if _l.startswith("CONFIG_HZ="):
                _hz = _l.strip().split("=", 1)[1]
                break
except OSError:
    _hz = None
if _ncpu and _hz:
    _floor = f"{_ncpu}c x {_hz}Hz"
elif _ncpu:
    _floor = f"{_ncpu}c, kernel HZ unknown"
else:
    _floor = "core count unknown"

softirq_ok = soft_start is not None and soft_end is not None
hotspot = softirq_hotspot(soft_start, soft_end) if softirq_ok else None
if hotspot is not None:
    si_name, si_delta, si_cpu, si_share = hotspot
    si_rate = round(si_delta / elapsed, 1)
    si_share_r = round(si_share, 3)
else:
    si_name = si_rate = si_cpu = si_share_r = None

# NET_RX standing concentration (the find): top-CPU share from cumulative counts
netrx = cpu_concentration(soft_end, "NET_RX") if softirq_ok else None
if netrx is not None:
    nrx_cpu, nrx_share = netrx[0], round(netrx[1], 3)
else:
    nrx_cpu = nrx_share = None

if "--json" in sys.argv[1:]:
    print(json.dumps({
        "level": level,
        "level_axis": "device",       # WHICH rate .level classifies — a reader must never
                                      # assume it is .irq_per_s (the total), which on a
                                      # many-core high-HZ node is ~98% timer/IPI bookkeeping
        "irq_per_s": round(rate, 1),  # TOTAL (unchanged meaning — legacy readers)
        "device_per_s": round(dev_rate, 1),
        "kernel_per_s": round(ker_rate, 1),
        "kernel_floor_basis": _floor,
        "top_kernel_irq": ktop_irq,
        "top_kernel_delta": ktop_rate,
        "elapsed_s": round(elapsed, 3),
        "total_before": before,
        "total_after": after,
        "top_irq": top_irq,       # busiest DEVICE irq (was: busiest line of any kind,
        "top_delta": top_rate,    # which made this LOC — the clock — on every sample)
        "top_per_s": round(top_rate / elapsed, 1),
        # share of the device axis carried by that one IRQ — 1.0 means the "device rate"
        # IS one device's rate. None (not 0) when the axis is idle: no share exists.
        "top_share_of_device": (round((top_rate / elapsed) / dev_rate, 3) if dev_rate > 0 else None),
        "top_desc": desc,
        # additive softirq keys — None (not 0) when /proc/softirqs is unreadable
        "softirq_available": softirq_ok,
        "softirq_top": si_name,
        "softirq_top_per_s": si_rate,
        "softirq_top_cpu": si_cpu,
        "softirq_cpu_share": si_share_r,
        "net_rx_top_cpu": nrx_cpu,        # standing NET_RX pinning (RPS-spread signal)
        "net_rx_cpu_share": nrx_share,    # ≈1.0 = receive-softirq pinned to one CPU
        "ts": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
    }))
    raise SystemExit(0)

if not softirq_ok:
    softirq_str = " | softirq=UNAVAILABLE"
else:
    top_str = f"softirq-top={si_name}:{si_rate}/s" if hotspot is not None else "softirq-top=idle"
    if netrx is not None:
        pin = "PINNED" if nrx_share >= 0.90 else "spread"
        nrx_str = f" net-rx cpu{nrx_cpu}={nrx_share*100:.0f}%({pin})"
    else:
        nrx_str = " net-rx=n/a"
    softirq_str = f" | {top_str}{nrx_str}"
_dev_share = (dev_rate / rate * 100.0) if rate > 0 else 0.0
_top_share_str = f"{(top_rate / elapsed) / dev_rate * 100.0:.0f}%" if dev_rate > 0 else "n/a"
print(
    f"[irq-rate] {level} — dev={dev_rate:.1f}/s (device IRQs — THE classified axis, "
    f"{_dev_share:.1f}% of total) | kern={ker_rate:.1f}/s (timer+IPI bookkeeping, "
    f"floor scales {_floor} — carries no device signal) | total={rate:.1f}/s over {elapsed:.2f}s "
    f"| top-dev={top_irq}:{top_rate / elapsed:.1f}/s ({_top_share_str} of dev axis) {desc} "
    f"| top-kern={ktop_irq}:{ktop_rate / elapsed:.1f}/s"
    f"{softirq_str}"
)
