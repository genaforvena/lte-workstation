#!/usr/bin/env bash
# mesh-selftest — unified test runner for all mesh tools (ported from guy-fawxible/gf-selftest).
# Runs every tool's `--test` and summarizes: ok, n-a (not applicable), FAIL.
# Exit 0 = all ok, exit 1 = any FAIL (exit 2 n-a are acceptable — tool present but condition not met).
#
# Usage:
#   mesh-selftest              run all tests (SLOW — runs 450+ tools)
#   mesh-selftest --quick      fast subset (critical tools only)
#   mesh-selftest <glob>       test scripts matching glob (e.g. 'mesh-{url,chat}*')
#   mesh-selftest --counts     group by status, show counts
#   mesh-selftest --list       list testable tools (those with --test)
set -uo pipefail

COUNTS=0; LIST=0; QUICK=0; PATTERN="${1:-.}"
case "${1:-}" in
  --counts) COUNTS=1; PATTERN="." ;;
  --list)   LIST=1; PATTERN="." ;;
  --quick)  QUICK=1; PATTERN="." ;;
esac

# Find all testable tools
tools=()
for f in scripts/mesh-$PATTERN; do
  [ -f "$f" ] && [ -x "$f" ] && "$f" --test >/dev/null 2>&1 && tools+=("$f")
done

# Alternatively, check for --test capability without running
if [ "$LIST" = 1 ]; then
  echo "Testable mesh tools:"
  for f in scripts/mesh-*; do
    [ -f "$f" ] && [ -x "$f" ] && grep -q "\--test" "$f" && echo "  $(basename "$f")"
  done | sort
  exit 0
fi

# Quick mode: only critical tools (hardening-relevant)
CRITICAL="mesh-url-watch|mesh-nudge|mesh-chat|mesh-tick|mesh-supervise|mesh-reflexes|mesh-doctor"

# Run tests
ok=0; na=0; fail=0; failed_tools=()
echo "Running tests $([ "$QUICK" = 1 ] && echo '(quick mode — critical tools only)' || echo '(SLOW — all tools)')..."
for f in scripts/mesh-*; do
  [ -f "$f" ] || continue
  [ -x "$f" ] || continue
  grep -q "\--test" "$f" || continue

  name="$(basename "$f")"

  # Quick mode: skip non-critical
  if [ "$QUICK" = 1 ]; then
    printf '%s' "$name" | grep -qE "$CRITICAL" || continue
  fi

  out="$(timeout 5 "$f" --test 2>&1)"
  rc=$?
  [ "$rc" = 124 ] && rc=1  # timeout → FAIL

  case "$rc" in
    0)
      ((ok++))
      [ "$COUNTS" = 0 ] && printf '%-40s ok\n' "$name"
      ;;
    2)
      ((na++))
      [ "$COUNTS" = 0 ] && printf '%-40s n/a (%s)\n' "$name" "$(printf '%s' "$out" | head -1 | cut -c1-60)"
      ;;
    *)
      ((fail++))
      failed_tools+=("$name")
      [ "$COUNTS" = 0 ] && printf '%-40s FAIL\n' "$name" && printf '  %s\n' "$out" | head -5
      ;;
  esac
done

# Summary
echo ""
echo "Selftest summary:"
printf '  ok    = %3d\n' "$ok"
printf '  n/a   = %3d (not applicable)\n' "$na"
printf '  FAIL  = %3d\n' "$fail"

if [ "$fail" -gt 0 ]; then
  echo ""
  echo "Failed tools:"
  printf '  %s\n' "${failed_tools[@]}"
  exit 1
else
  exit 0
fi
