#!/usr/bin/env bash
# orphan-ok: on-demand (phone call actuator, invoked by need not cron)
# mesh-call — place a phone call via the phone body (termux-telephony-call).
# Emergency escalation fallback when Telegram is down. Opens the dialer with the
# given number; on most phones this pre-fills the number and the user taps Call.
# Supports auto-hangup via --duration (best-effort: closes the dialer/call screen).
#
# Config: uses PHONE_SSH_PORT and PHONE_USER from env or ~/.mesh/nodes.
# Phone resolved via mesh-phone-ip (TS → LAN → ADB tunnel).
# Consent: calls cost money — operator deliberately wired this.
#
#   mesh-call <number>              place call (opens dialer)
#   mesh-call <number> --duration N auto-hangup after N seconds (best-effort)
#   mesh-call <number> --duration N  (N before or after duration flag)
#   mesh-call --test                 smoke test
#
# Exit codes (matches mesh-act/mesh-sms):
#   0 = call initiated (dialer opened)
#   1 = config error
#   2 = phone unreachable
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes"

PHONE_PORT="${PHONE_SSH_PORT:-8022}"
PHONE_USER="${PHONE_USER:-u0_a380}"
SSH_OPTS="-o BatchMode=yes -o ConnectTimeout=6 -o StrictHostKeyChecking=accept-new"

if [ "${1:-}" = "--test" ]; then
  for x in ssh mesh-phone-ip; do
    command -v "$x" >/dev/null 2>&1 || { echo "smoke-test: FAIL (no $x)"; exit 1; }
  done
  pip="$(mesh-phone-ip 2>/dev/null)" || { echo "smoke-test: n/a (no phone IP — Redmi not in registry?)"; exit 2; }
  result="$(timeout 10 ssh $SSH_OPTS -p "$PHONE_PORT" "${PHONE_USER}@${pip}" \
    "command -v termux-telephony-call >/dev/null 2>&1 && echo ok || echo missing" 2>/dev/null)" || {
    echo "smoke-test: n/a (phone unreachable at ${PHONE_USER}@${pip}:${PHONE_PORT})"; exit 2
  }
  [ "$result" = ok ] || { echo "smoke-test: FAIL (termux-telephony-call not found on phone)"; exit 1; }
  echo "smoke-test: ok (phone=${pip})"; exit 0
fi

[ $# -ge 1 ] || { echo "usage: mesh-call <number> [--duration N]" >&2; exit 1; }

# Parse arguments: number is first positional, extract --duration
number="$1"; shift
duration=""
while [ $# -gt 0 ]; do
  case "$1" in
    --duration) duration="$2"; shift 2 ;;
    *) echo "mesh-call: unknown option '$1'" >&2; exit 1 ;;
  esac
done

[ -n "$number" ] || { echo "mesh-call: no number provided" >&2; exit 1; }
[ -z "$duration" ] || [ "$duration" -gt 0 ] 2>/dev/null || { echo "mesh-call: --duration must be a positive number" >&2; exit 1; }

pip="$(mesh-phone-ip 2>/dev/null)" || { echo "mesh-call: phone IP unresolved (TS + LAN unreachable)" >&2; exit 2; }

# Sanitize number (strip anything that isn't digits, +, or #)
safe_num="$(printf '%s' "$number" | sed 's/[^0-9+#*]//g')"
[ -n "$safe_num" ] || { echo "mesh-call: invalid number after sanitization" >&2; exit 1; }
[ "$safe_num" = "$number" ] || echo "mesh-call: sanitized number '$safe_num' (was '$number')" >&2

echo "mesh-call: dialing $safe_num via ${PHONE_USER}@${pip}:${PHONE_PORT}"

if [ -n "$duration" ]; then
  # Place call in background, hangup after duration
  timeout "$duration" ssh $SSH_OPTS -p "$PHONE_PORT" "${PHONE_USER}@${pip}" \
    "termux-telephony-call '${safe_num}'" </dev/null 2>/dev/null &
  call_pid=$!
  # Wait for duration, then attempt hangup via multiple methods
  sleep "$duration" 2>/dev/null
  # Best-effort hangup: try pkill dialer, close dialogs, etc.
  ssh $SSH_OPTS -p "$PHONE_PORT" "${PHONE_USER}@${pip}" \
    "pkill -f 'com.google.android.dialer' 2>/dev/null; pkill -f 'com.android.dialer' 2>/dev/null; \
     pkill -f 'com.android.incallui' 2>/dev/null; \
     am broadcast -a android.intent.action.CLOSE_SYSTEM_DIALOGS >/dev/null 2>&1; \
     am start -a android.intent.action.MAIN -c android.intent.category.HOME >/dev/null 2>&1" </dev/null 2>/dev/null || true
  wait "$call_pid" 2>/dev/null || true
  echo "mesh-call: completed (duration ${duration}s)"
else
  # Non-blocking call — open dialer and return immediately
  ssh $SSH_OPTS -p "$PHONE_PORT" "${PHONE_USER}@${pip}" \
    "termux-telephony-call '${safe_num}'" </dev/null 2>/dev/null &
  call_pid=$!
  disown "$call_pid" 2>/dev/null || true
  echo "mesh-call: dialer opened for ${safe_num} (call in background)"
fi

exit 0
