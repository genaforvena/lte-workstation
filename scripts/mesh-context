#!/usr/bin/env bash
# orphan-ok: on-demand (home context fusion, unwired by design — run when needed)
# mesh-context — cross-sense fusion: unified "what's happening at home" picture
#
# Reads state from existing senses (no subprocess calls — fast, compositional).
# Distinguishes UNREACHABLE (sensor can't report) from EMPTY (genuinely nobody).
#
# Sense inputs:
#   .room-sense.state    → PRESENT/EMPTY/UNCERTAIN (room occupancy)
#   .situation.state     → NOMINAL/WATCH/ALERT (mesh posture)
#   .household.state     → ACTIVE/ASLEEP/AWAY/UNCERTAIN (household mode)
#   arrivals.state       → named devices + counts (who's physically around)
#   .op-home.state       → HOME/AWAY/UNCERTAIN (operator presence)
#
# Output classes:
#   HOME_ACTIVE   — people present + activity (someone home and doing something)
#   HOME_QUIET    — people present, low activity (resting, TV on, etc.)
#   HOME_EMPTY    — confidently no one home (all senses agree)
#   UNCERTAIN     — can't tell (critical senses unreachable or disagree)
#
#   mesh-context              one-shot fusion, print + board post
#   mesh-context --json       machine-readable
#   mesh-context --test       smoke test
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

MESH="$HOME/.mesh"
ROOM_STATE="$MESH/.room-sense.state"
SIT_STATE="$MESH/.situation.state"
HH_STATE="$MESH/.household.state"
ARR_STATE="$MESH/arrivals.state"
OP_HOME="$MESH/.op-home.state"

# Pure gate decision: post to board only when the message changed from last (suppress identical
# consecutive posts — context is a STATE channel, only transitions are signal). rc 0 = post, 1 = skip.
context_should_post() { [ "$1" != "$2" ]; }

# --- Test ---
if [ "${1:-}" = --test ]; then
  command -v python3 >/dev/null 2>&1 || { echo "smoke-test: FAIL (no python3)"; exit 1; }
  # Hermetic: empty state files → must produce UNCERTAIN (not fake EMPTY)
  td="$(mktemp -d)"
  mkdir -p "$td/.mesh"
  touch "$td/.mesh/.room-sense.state" "$td/.mesh/.situation.state" "$td/.mesh/.household.state"
  out="$(HOME="$td" "$0" --json 2>/dev/null)"
  rm -rf "$td"
  verdict="$(printf '%s' "$out" | python3 -c 'import sys,json; print(json.load(sys.stdin).get("verdict",""))' 2>/dev/null)"
  [ "$verdict" = "UNCERTAIN" ] || { echo "smoke-test: FAIL (empty state gave '$verdict', expected UNCERTAIN)"; exit 1; }
  # state-change gate: identical → suppress; changed or first-ever → post
  context_should_post "X" ""  || { echo "smoke-test: FAIL (first post should fire)"; exit 1; }
  context_should_post "A" "B" || { echo "smoke-test: FAIL (changed state should post)"; exit 1; }
  context_should_post "A" "A" && { echo "smoke-test: FAIL (identical state should suppress)"; exit 1; }
  echo "smoke-test: ok"; exit 0
fi

# --- Read state files ---
room=""
[ -f "$ROOM_STATE" ] && room="$(cat "$ROOM_STATE" 2>/dev/null)"

situation=""
[ -f "$SIT_STATE" ] && situation="$(cat "$SIT_STATE" 2>/dev/null)"

household=""
[ -f "$HH_STATE" ] && household="$(cat "$HH_STATE" 2>/dev/null)"

op_home=""
[ -f "$OP_HOME" ] && op_home="$(cat "$OP_HOME" 2>/dev/null)"

CTX_STATE="$MESH/.context-state"   # last board message posted (state-change gate)

# Arrivals: count named devices
arrivals_count=0
arrivals_names=""
if [ -f "$ARR_STATE" ]; then
  arrivals_count=$(awk '$2 > 0 { c++ } END { print c+0 }' "$ARR_STATE" 2>/dev/null)
  arrivals_names=$(awk '$2 > 0 { printf "%s ", $1 }' "$ARR_STATE" 2>/dev/null)
fi

# --- Fusion logic ---
verdict="UNCERTAIN"
signals=""
reasons=""
unreachable=""
phone_ok=0

# Determine phone reachability from room-sense
case "$room" in
  PRESENT|EMPTY) phone_ok=1 ;;
  UNCERTAIN) phone_ok=0 ;;
esac

# Count evidence sources
evidence_present=0
evidence_absent=0

# Room sense
case "$room" in
  PRESENT) evidence_present=$((evidence_present + 1)); signals="${signals}room:PRESENT " ;;
  EMPTY)   evidence_absent=$((evidence_absent + 1)); signals="${signals}room:EMPTY " ;;
  UNCERTAIN) signals="${signals}room:UNCERTAIN " ;;
  *)       unreachable="${unreachable}room " ;;
esac

# Household state
case "$household" in
  ACTIVE|ACTIVE_SOCIAL) evidence_present=$((evidence_present + 1)); signals="${signals}household:${household} " ;;
  ASLEEP)               evidence_present=$((evidence_present + 1)); signals="${signals}household:ASLEEP " ;;
  AWAY)                 evidence_absent=$((evidence_absent + 1)); signals="${signals}household:AWAY " ;;
  UNCERTAIN)            signals="${signals}household:UNCERTAIN " ;;
  *)                    unreachable="${unreachable}household " ;;
esac

# Operator home
case "$op_home" in
  HOME)       evidence_present=$((evidence_present + 1)); signals="${signals}op:HOME " ;;
  AWAY)       evidence_absent=$((evidence_absent + 1)); signals="${signals}op:AWAY " ;;
  UNCERTAIN)  signals="${signals}op:UNCERTAIN " ;;
  *)          unreachable="${unreachable}op " ;;
esac

# Arrivals
if [ "$arrivals_count" -gt 0 ]; then
  evidence_present=$((evidence_present + 1))
  signals="${signals}arrivals:${arrivals_count}(${arrivals_names}) "
fi

# Situation
case "$situation" in
  NOMINAL)  signals="${signals}situation:NOMINAL " ;;
  WATCH)    signals="${signals}situation:WATCH " ;;
  ALERT)    signals="${signals}situation:ALERT " ;;
  *)        unreachable="${unreachable}situation " ;;
esac

# --- Verdict ---
# UNREACHABLE: critical senses (room, op) can't report → UNCERTAIN, never fake EMPTY
critical_unreachable=""
case "$room" in
  "") critical_unreachable="${critical_unreachable}room-sense " ;;
esac
case "$op_home" in
  "") critical_unreachable="${critical_unreachable}operator-home " ;;
esac

if [ -n "$critical_unreachable" ]; then
  verdict="UNCERTAIN"
  reasons="critical senses unreachable: ${critical_unreachable}"
elif [ "$phone_ok" -eq 0 ] && [ "$arrivals_count" -eq 0 ]; then
  # Phone offline + no BLE arrivals → can't confirm occupancy either way
  verdict="UNCERTAIN"
  reasons="phone offline, no BLE arrivals — cannot confirm occupancy"
elif [ "$evidence_present" -ge 2 ]; then
  # Multiple signals say "someone here"
  if [ "$household" = "ASLEEP" ] || [ "$household" = "QUIET_NIGHT" ]; then
    verdict="HOME_QUIET"
    reasons="signals indicate rest (household=${household})"
  else
    verdict="HOME_ACTIVE"
    reasons="multiple senses confirm presence + activity"
  fi
elif [ "$evidence_present" -ge 1 ] && [ "$evidence_absent" -eq 0 ]; then
  # At least one positive signal, no contradictions
  if [ "$household" = "ASLEEP" ] || [ "$household" = "QUIET_NIGHT" ]; then
    verdict="HOME_QUIET"
    reasons="weak signal + rest context"
  else
    verdict="HOME_ACTIVE"
    reasons="single positive signal"
  fi
elif [ "$evidence_present" -eq 0 ] && [ "$evidence_absent" -ge 1 ] && [ -z "$critical_unreachable" ] && [ "$phone_ok" -eq 1 ]; then
  # All senses agree: empty, and all senses are reachable
  verdict="HOME_EMPTY"
  reasons="all reachable senses agree: empty"
else
  verdict="UNCERTAIN"
  reasons="mixed or insufficient signals"
fi

# --- Confidence ---
confidence="low"
case "$verdict" in
  HOME_ACTIVE|HOME_EMPTY)
    if [ "$phone_ok" -eq 1 ] && [ "$arrivals_count" -gt 0 ]; then
      confidence="high"
    elif [ "$phone_ok" -eq 1 ]; then
      confidence="medium"
    else
      confidence="low"
    fi
    ;;
  HOME_QUIET)
    confidence="medium"
    ;;
  UNCERTAIN)
    confidence="none"
    ;;
esac

# --- Summary ---
context="mesh-context: $verdict (${confidence} confidence) — $reasons | signals: ${signals:-none} | unreachable: ${unreachable:-none}"

# --- Save artifact ---
artifact_file="$MESH/.context"
printf '%s\n' "$verdict" > "$artifact_file"

# --- JSON output ---
if [ "${1:-}" = --json ]; then
  printf '{"verdict":"%s","confidence":"%s","reasons":"%s","signals":"%s","unreachable":"%s","phone_ok":%s,"arrivals":%d,"arrivals_names":"%s","ts":"%s"}\n' \
    "$verdict" "$confidence" "$reasons" "$signals" "$unreachable" "$phone_ok" "$arrivals_count" "$arrivals_names" "$(date -u +%FT%TZ)"
  exit 0
fi

# --- Board post (gated on state change — suppress identical consecutive posts) ---
board_msg="[context] $verdict ($confidence): $reasons | unreachable: ${unreachable:-none}"
last_msg=""
[ -f "$CTX_STATE" ] && last_msg="$(cat "$CTX_STATE" 2>/dev/null)"
if context_should_post "$board_msg" "$last_msg"; then
  MESH_WHO="context@$(hostname)" ~/.local/bin/mesh-chat "$board_msg" 2>/dev/null
  printf '%s\n' "$board_msg" > "$CTX_STATE"
fi

printf '%s\n' "$context"
