# mesh-gpu-accounting.service — boot-time enable of NVIDIA per-process accounting (root SYSTEM unit).
# orphan-ok: node-specific SYSTEM unit (GPU node only); deploy where an RTX/accounting-capable GPU lives.
#
# Accounting mode is DRIVER STATE, not durable — it does not survive a driver unload/reload and (with
# persistence_mode Disabled) the driver may unload when no client holds it. Without this, mesh-gpu-ledger
# reads an empty accounted list and honestly renders UNKNOWN, but the charged lane goes dark. This oneshot
# re-asserts the mode at boot so per-organ GPU-ms accounting survives a reboot.
#
# Install (root, GPU node only):
#   sudo cp scripts/mesh-gpu-accounting.service /etc/systemd/system/mesh-gpu-accounting.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now mesh-gpu-accounting.service
# After enabling, RESTART long-lived GPU organs (ollama, mesh-voice-clone-daemon, mesh-room-gigaam) so
# they enter the accounting ring — a process started BEFORE the enable is never accounted (reads $0/0ms).

[Unit]
Description=Enable NVIDIA per-process GPU accounting (mesh-gpu-ledger source)
After=nvidia-persistenced.service
Wants=nvidia-persistenced.service

[Service]
Type=oneshot
ExecStart=/usr/bin/nvidia-smi --accounting-mode=1
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
