#!/usr/bin/env bash
# mesh-stress — ONE fused "is the operator channel at risk?" read, designed to fire BEFORE the
# 92°C thermal throttle that starves the operator channel (our known failure mode: converse-timeouts
# under 5-8 concurrent minds — IdeaPad hit 94°C on 2026-06-13). It fuses two pressures:
#
#   THERMAL pressure (predicts the throttle):  node temp + load/nproc + mind-count
#   CHANNEL pressure (kills the channel sans heat): egress geo-block + router thermal
#
# The whole point is to PRE-EMPT, not report a fait accompli. Bands are calibrated to THIS node's
# real temp curve (see the threshold block below): STRESSED enters the 95-97°C active-throttle zone,
# and a hot-but-climbing node (sustained load + many minds) is escalated one band so we shed a mind
# WHILE there's still headroom — not after the operator channel already went dark.
#
# FUSION, not re-probe: the live signals are all LOCAL+free (procfs/sysfs/tmux). The remote signals
# (router temp over SSH, egress quality over curl) are read from the SIBLING reflexes' cached state
# files (.router-thermal-state, .egress-state, .therm-state) that mesh-router-watch / mesh-egress-health
# / mesh-therm-watch already write on cron — so mesh-stress adds ZERO SSH/curl heat of its own.
# (--probe refreshes those live first, for an on-demand read.)
#
#   mesh-stress            one fused line + level
#   mesh-stress --json     machine-readable
#   mesh-stress --check    exit 1 if STRESSED or worse (cron gate), else 0
#   mesh-stress --alert    cron mode: --check + edge-triggered [mesh-stress]/[mesh-calm] board post
#   mesh-stress --probe    refresh router+egress sibling state LIVE first (slow: SSH+curl), then read
#   mesh-stress --test     smoke test
#
# reflex-cadence: */5 * * * *
# reflex-args: --alert
# Was NEVER cron-wired despite --alert being documented "cron mode" — it carried NO cadence header, so
# mesh-autowire never picked it up and .stress-state went 3-DAYS stale (last write Jun 17), darkening
# the stress axis for every fresh-gated consumer (mesh-algedonic STALE_S, mesh-reflex-health). Same
# orphaned-reflex class as the mesh-therm-watch header gap. */5 matches the sibling thermal/edge
# reflexes (therm-watch/egress/router-watch). --alert writes .stress-state EVERY run now (mtime stays
# fresh = liveness) while board posting stays hysteretic + escalation-only (no cry-wolf).
#
# Biosemiotic decoupling check (literature landing, Méndez-Veras 2025, "The Holobiont as a Biosemiotic
# System: Health and Dysbiosis Signals in the Human Gut Microbiome", Biosemiotics 18:403-430,
# doi:10.1007/s12304-025-09627-9): health is framed there as SEMIOTIC COHERENCE — synchronized,
# context-appropriate signaling across independent agents — and dysbiosis as those signals coming
# UNSYNCED from each other, not any one metabolite alone reading "abnormal". Applied here: temp is
# causally coupled to load+minds (heat follows sustained work); if minds+load stay HEAVY while
# thermal_zone reports the SAME bit-exact value run after run, that's the two signals decoupling —
# the sysfs read has gone stale/stuck, not the node actually calm. Same hollow-sense failure class as
# mesh-mag racing akm09918 with -n 1 (CLAUDE.md verification-principle) — a frozen sensor under load
# must be surfaced, never silently trusted as CALM.
#
# Allostatic-load landing (literature review 2026-07-06): McEwen & Stellar's ALLOSTATIC LOAD model —
# the cost of stability is not any single excursion but the CUMULATIVE WEAR of repeated regulatory
# accommodation: a system forced to adapt again and again pays a second-order price even while every
# instantaneous reading currently reads normal. Recent operationalization: Ororbia & Friston et al.,
# "Surprise! Using Physiological Stress for Allostatic Regulation Under the Active Inference Framework"
# (arXiv:2406.08471, 2024) — casts that load as ACCUMULATED surprise driving regulation. mesh-stress was
# purely first-order + anticipatory (it pre-empts the NEXT throttle) but had NO memory of how OFTEN this
# node has already had to be regulated. This axis adds that missing second order: count the durable
# regulatory-intervention edges this node logged over a window ([cpu-throttling]/[node-hot]/[therm-hot]/
# [hw-fail] — the mesh's own accommodations, NOT recoveries, NOT mesh-stress's own marker, which would
# self-count into a loop). A node currently COOL but regulated many times recently carries chronic load
# the thermal bands cannot see. The bump is WARM-CAPPED (watch-only, exactly like the pkg-watts leading
# input) so an uncalibrated intervention-rate threshold can NEVER gate dispatch — it surfaces chronicity
# for a human/steward to read, it does not shed. (On THIS pathologically-hot node the axis saturates —
# honestly: it IS under chronic thermal regulation; the axis is most INFORMATIVE on a node currently cool
# that has been flapping.)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
{ "$HOME/.local/bin/mesh-pulse" beat stress; } >/dev/null 2>&1 || true  # liveness heartbeat (mesh-pulse): edge/alert reflex is silent-on-no-news → needs an explicit per-run pulse

MESH_DIR="${MESH_DIR:-$HOME/.mesh}"
STATE="$MESH_DIR/.stress-state"

# Calibrated temp bands resolve env > uxn threshold-ledger (row stress-thermal) > inline fallback —
# same pattern as mesh-therm-watch's therm-alarm. The ledger keeps this node's WARM/STRESSED/CRIT °C
# beside host-therm and therm-alarm (the two other same-axis splits on the host temp sensor), so a
# recalibration is a one-line diff on scripts/uxn/threshold-ledger, not a hunt across three tools.
# Fail-safe: unreadable ledger / non-natural → the inline fallback, never a blank band.
_ledger_const() { # <gate> <k> <fallback> — resolve a calibrated constant, naturals-only
  local repo="${MESH_REPO:-$HOME/lte-workstation}" led v=""
  led="${MESH_THRESHOLD_LEDGER:-$repo/scripts/uxn/threshold-ledger}"
  [ -f "$led" ] && [ -x "$repo/scripts/uxn/mesh-sexpr-gate" ] \
    && v="$(MESH_SEXPR_GATES="$led" "$repo/scripts/uxn/mesh-sexpr-gate" --const "$1" "$2" 2>/dev/null)"
  case "$v" in ''|*[!0-9]*) v="$3" ;; esac
  printf '%s\n' "$v"
}

# The ABSOLUTE arm was CALIBRATED against this node's temp curve of 2026-06-13 (therm.log, 167
# samples): p50=90 p75=94 p90=97 p95=100 max=102 — the GPE0x6E storm (PLAN 0d, operator-gated) kept
# the baseline pathologically hot, sitting INSIDE the 93-97°C throttle/starvation zone:
#   WARM 90   = p50, the storm baseline: hot but normal-for-now (informational)
#   STRESSED 95 = active-throttle zone (95-97), ~11% of the time — shed a mind if you can
#   CRITICAL 98 = near the 100-102°C thermal-shutdown ceiling, ~11% — shed NOW
#
# THAT REGIME ENDED, and a band nailed to a finished regime reads as ETERNAL CALM (2026-07-24,
# board stress-thermal-bands-stale). The live curve on the SAME node — therm.log 07-18..07-24,
# n=1718 — is p50=64 p75=67 p90=69 p95=70 p99=72 max=76, with the share of samples ≥90°C EXACTLY
# 0.000%: the whole thermal axis could not leave CALM by temperature, and every WARM this tool
# reported came from the pkg-watts leading input instead. Re-fitting the three numbers to today's
# corpus would only re-arm the same trap for the next regime change, so WARM gets a SECOND,
# RELATIVE arm and the tool takes the stricter of the two:
#     WARM_C = min(warm_abs, running_p50 + WARM_DELTA)
# The running p50 is this node's own recent median (therm_curve below). On the storm curve p50=90
# ⇒ min(90,98)=90 — the absolute arm wins and nothing moves; on the live curve p50=64 ⇒ 72, which
# ~1.3% of samples cross: "unusually hot FOR THIS NODE". A fixed offset, NOT a percentile: a
# percentile-mapped band fires on x% of samples by construction forever and would manufacture
# pressure on a genuinely healthy node.
# STRESSED/CRIT DELIBERATELY STAY ABSOLUTE — they are the throttle/shutdown HAZARD lines and they
# gate a shed + the board alarm; scaling them to a cool node's median would post CRITICAL at 80°C
# on a node 15°C from any hazard (the mirror failure: manufactured alarm instead of eternal calm).
# An alarm band that does not fire because there IS no alarm is honest; an INFORMATIONAL band that
# CANNOT fire is the defect this fixes. The standing detector lives in --test: WARM_C must
# intersect the observed corpus (≤ max over the window) or the gate goes RED — that is what would
# have caught the 2026-06-13 bands going stale without a human re-deriving percentiles by hand.
# Calibration home is the ledger row (warm/stressed/crit/wd); env pins the ABSOLUTE arm, and the
# relative arm may only LOWER it.
WARM_ABS_C="${MESH_STRESS_WARM_C:-$(_ledger_const stress-thermal warm 90)}"
STRESSED_C="${MESH_STRESS_HOT_C:-$(_ledger_const stress-thermal stressed 95)}"
CRIT_C="${MESH_STRESS_CRIT_C:-$(_ledger_const stress-thermal crit 98)}"
WARM_DELTA="${MESH_STRESS_WARM_DELTA:-$(_ledger_const stress-thermal wd 8)}"
THERM_LOG="${MESH_STRESS_THERM_LOG:-$MESH_DIR/therm.log}"
CURVE_DAYS="${MESH_STRESS_CURVE_DAYS:-7}"      # window of the running median
CURVE_MIN_N="${MESH_STRESS_CURVE_MIN_N:-200}"  # below this the median is not a median — stay absolute

# therm_curve — the node's OWN recent temp curve from mesh-therm-watch's log (the same cross-tier
# max mesh-stress reads live, so the corpus and the reading are one population). Prints
# "<p50> <max> <n>" for the window, rc=1 when there is no usable corpus (absent log, too few
# samples, no date(1) — honest n/a, never a fabricated median: the caller then keeps the absolute
# band, which is the pre-2026-07-24 behaviour, not a guess).
therm_curve(){
  local cut vals
  [ -r "$THERM_LOG" ] || return 1
  cut="$(date -u -d "-${CURVE_DAYS} days" +%FT%TZ 2>/dev/null)" || return 1
  [ -n "$cut" ] || return 1
  vals="$(awk -v cut="$cut" '$1 >= cut && match($0, /max=[0-9]+/) {print substr($0, RSTART+4, RLENGTH-4)+0}' \
            "$THERM_LOG" 2>/dev/null | sort -n)"
  [ -n "$vals" ] || return 1
  printf '%s\n' "$vals" | awk -v minn="$CURVE_MIN_N" '
    {a[NR]=$1} END{ if (NR < minn) exit 1; printf "%d %d %d\n", a[int((NR+1)/2)], a[NR], NR }'
}

# Effective WARM: min(absolute, running p50 + delta). BAND_SRC records which arm bound it, so
# --status/--json say out loud whether the axis is self-calibrated or fell back to absolute —
# a silent fallback here is exactly how the stale band hid for six weeks.
WARM_C="$WARM_ABS_C"; BAND_SRC=absolute; CURVE_P50=-1; CURVE_MAX=-1; CURVE_N=0
if [ "${MESH_STRESS_RELCAL:-on}" != off ]; then
  # NEVER `set -- $_tc` here: this runs at top level, where the positional args are the tool's
  # own ARGV (--status/--json/--alert) — parsing the curve would eat the verb.
  if _tc="$(therm_curve)"; then
    read -r CURVE_P50 CURVE_MAX CURVE_N <<EOF
$_tc
EOF
    _rel=$(( CURVE_P50 + WARM_DELTA ))
    [ "$_rel" -lt "$WARM_C" ] && { WARM_C="$_rel"; BAND_SRC=p50; }
  fi
  unset _tc _rel
fi
# Snapshot of the band ACTUALLY IN FORCE at load. --test's reachability gate asserts THIS, not a
# re-derivation from the ledger: the later dry-runs pin WARM_C/STRESSED_C/CRIT_C to fixed numbers,
# and a gate that re-derives its own input would assert the ledger instead of the running band
# (an operator's MESH_STRESS_WARM_C pin or a disabled relative arm would sail straight past it).
WARM_C_ATLOAD="$WARM_C"
# A node that's WARM but carrying sustained load on many minds is CLIMBING, not coasting — escalate
# one band so the shed happens on the way up. These are the conditions under which we saw 94°C.
HEAVY_MINDS="${MESH_STRESS_HEAVY_MINDS:-6}"
# Consecutive samples of an unchanged temp reading under heavy load before calling it decoupled
# (not a temp threshold — a COHERENCE threshold between two signals that should move together).
TEMPWATCH="$MESH_DIR/.stress-tempwatch"

# Thermal source globs (env-overridable so --test can drive fixture trees; see read_local).
STRESS_ZONE_GLOB="${MESH_STRESS_ZONE_GLOB:-/sys/class/thermal/thermal_zone*/temp}"
STRESS_HWMON_GLOB="${MESH_STRESS_HWMON_GLOB:-/sys/class/hwmon/hwmon*/temp*_input}"
FROZEN_STREAK_N="${MESH_STRESS_FROZEN_STREAK:-3}"

lvl_num(){ case "$1" in CALM)echo 0;; WARM)echo 1;; STRESSED)echo 2;; CRITICAL)echo 3;; *)echo 0;; esac; }
lvl_name(){ case "$1" in 0)echo CALM;; 1)echo WARM;; 2)echo STRESSED;; 3)echo CRITICAL;; esac; }
worse(){ [ "$(lvl_num "$1")" -ge "$(lvl_num "$2")" ] && echo "$1" || echo "$2"; }
lvl_floor(){ case "$1" in CRITICAL)echo "$CRIT_C";; STRESSED)echo "$STRESSED_C";; WARM)echo "$WARM_C";; *)echo -100;; esac; }

# Which TIER does a level transition belong on? (pure → testable, no side-effects)
#   board = the genuine shed-NOW coordination alarm: escalation INTO CRITICAL (≥98°C,
#           ~2°C from the thermal-shutdown ceiling a box has literally frozen at).
#   trace = routine STRESSED-flap + every recovery → the durable HISTORY tier, OFF the
#           coordination board. On a chronically-throttled node STRESSED (95-97°C) is the
#           RESTING state, not news; posting its entry/recovery each cycle drowned the
#           board (~10 thermal posts / 220 lines). Liveness already lives in .stress-state
#           mtime, so trace loses nothing. No tool greps the markers (board is human-read),
#           so re-tiering is vocab-safe.
post_tier(){  # args: cur prev  -> board|trace|none
  local cn pn; cn=$(lvl_num "$1"); pn=$(lvl_num "$2")
  [ "$cn" = "$pn" ] && { echo none; return; }
  if   [ "$cn" -ge 3 ] && [ "$cn" -gt "$pn" ]; then echo board   # → CRITICAL (alarm)
  elif [ "$cn" -ge 2 ] && [ "$cn" -gt "$pn" ]; then echo trace   # → STRESSED (routine)
  elif [ "$pn" -ge 2 ] && [ "$cn" -lt 2 ];     then echo trace   # recovery out of alarm
  else echo none; fi
}

# Asymmetric schmitt hysteresis for the --alert EDGE poster ONLY (point-in-time --status/--json/--check
# stay raw). The temp curve dithers right at the band floors (verified: crosses 95°C 9× and 98°C 6× in
# 40 samples), so a bare level-change edge would spam [mesh-stress]/[mesh-calm] pairs. Rule: escalate
# IMMEDIATELY (fast to alarm), but downgrade a band only once temp has dropped HYST below that band's
# floor (slow to clear) — same intent as mesh-therm-watch's 5°C band. Walks down one level per run.
HYST="${MESH_STRESS_HYST_C:-3}"
effective_level(){  # raw=$1 prev=$2 temp=$3 → hysteresis-adjusted level for edge decisions
  local raw="$1" prev="$2" t="$3" rn pn eff floor
  rn=$(lvl_num "$raw"); pn=$(lvl_num "$prev"); eff=$pn
  [ "$rn" -ge "$pn" ] && { echo "$raw"; return; }            # escalate / same → accept now
  while [ "$eff" -gt "$rn" ]; do                              # downgrade: clear each floor by HYST
    floor=$(lvl_floor "$(lvl_name "$eff")")
    if [ "$t" -lt $((floor - HYST)) ] 2>/dev/null; then eff=$((eff-1)); else break; fi
  done
  lvl_name "$eff"
}

# track_temp: pure-ish streak counter (only side effect is persisting $TEMPWATCH so the streak
# survives across cron invocations). Streak grows only while minds+load stay HEAVY AND temp is
# bit-identical to the previous sample; any change in either resets it to 0 — self-correcting, so
# a rapid burst of manual calls during genuinely-cool conditions can't accumulate false alarm state
# for long (the very next sample where load/minds drop clears it).
track_temp(){  # cur_temp minds load_norm -> prints updated streak, persists it
  local cur="$1" mm="$2" ln="$3" prev_t prev_s streak
  if [ -r "$TEMPWATCH" ]; then read -r prev_t prev_s < "$TEMPWATCH"; else prev_t=""; prev_s=0; fi
  if [ "$mm" -ge "$HEAVY_MINDS" ] 2>/dev/null && awk "BEGIN{exit !($ln > 1.0)}" 2>/dev/null && [ "$cur" = "$prev_t" ] 2>/dev/null; then
    streak=$((prev_s + 1))
  else
    streak=0
  fi
  mkdir -p "$MESH_DIR" 2>/dev/null
  echo "$cur $streak" > "$TEMPWATCH" 2>/dev/null
  echo "$streak"
}

# --- live LOCAL signals (free) -------------------------------------------------
read_local() {
  nproc=$(nproc 2>/dev/null || echo 1)
  load1=$(awk '{print $1}' /proc/loadavg 2>/dev/null || echo 0)
  load_norm=$(awk "BEGIN{if($nproc>0)printf \"%.2f\",$load1/$nproc; else print 0}")
  # TWO TIERS — thermal_zone AND hwmon (2026-07-16, same family as mesh-therm/mesh-vitals 2026-07-15):
  # thermal_zone* is an Intel/ACPI-laptop assumption. AMD desktops expose no thermal_zone at all
  # (mesh-home has only cooling_device*); the CPU die temp lives in hwmon (k10temp). Zone-only left
  # this node's whole thermal axis blind — temp=-1 in every assess, so a real 95C+ climb could never
  # trip STRESSED/CRITICAL. Cross-tier max, numeric-validated; -1 survives only when NO tier reads.
  temp=-1
  for tf in $STRESS_ZONE_GLOB $STRESS_HWMON_GLOB; do
    [ -r "$tf" ] || continue
    t=$(cat "$tf" 2>/dev/null) || continue
    case "$t" in ''|*[!0-9]*) continue ;; esac
    tc=$(( t / 1000 ))
    [ "$tc" -gt "$temp" ] && temp=$tc
  done
  # Mind-count = tmux mind-windows (the mesh's own "N minds" accounting), excluding the non-mind
  # execution/board windows (shell, chat). Each mind is a heat source; the count predicts the climb.
  # grep -c already prints 0 (exit 1) on no match — a trailing `|| echo 0` would emit a SECOND
  # 0, making minds="0 0" (the double-zero seen on the board). Default the empty (tmux-absent)
  # case instead.
  minds=$(tmux list-windows -t "$(hostname)" -F '#{window_name}' 2>/dev/null \
            | grep -ivxE 'shell|chat' | grep -c . 2>/dev/null)
  minds=${minds:-0}
}

# --- cached sibling reflex state (free; --probe refreshes live first) ----------
# PACKAGE-WATTS (leading thermal input, genome/package-power-shed-wire 2026-07-02): mesh-package-power
# writes .package-power-state (LOW/NORMAL/HIGH + watts) every */5 run. Watt-draw LEADS coretemp — it
# jumps the instant minds start burning, before the die heats — so a fresh HIGH is an early warning the
# temp bands can't give yet. FRESH-GATED unlike the other siblings: the producer is new (may not be
# cron-wired yet on a given node) and its HIGH threshold is PROVISIONAL (15 W, one day of telemetry) —
# a stale HIGH must decay to "?" (honest-fusion: unknown, never a fake pressure), and the bump is capped
# at WARM (watch-only) below so an uncalibrated threshold can never gate dispatch. Recalibrate from
# ~/.mesh/power.log, then consider letting it feed the climbing escalation.
PKG_FRESH_MIN="${MESH_STRESS_PKG_FRESH_MIN:-15}"   # 3× the producer's */5 cadence
read_pkg_state(){
  local f="$MESH_DIR/.package-power-state"
  [ -f "$f" ] || { echo "?"; return; }
  find "$f" -mmin "-$PKG_FRESH_MIN" 2>/dev/null | grep -q . || { echo "?"; return; }
  awk '{print $1; exit}' "$f" 2>/dev/null || echo "?"
}
pkg_lead(){ # $1=pkg_s $2=thermal → thermal with the leading bump (CALM→WARM only, see above)
  if [ "$1" = HIGH ] && [ "$2" = CALM ]; then echo WARM; else echo "$2"; fi
}
# GPU-ATTRIBUTION sidecar (genome/gpu-presence-wire 2026-07-02): the iGPU sits INSIDE package-0
# RAPL, so its draw is already in pkg_s watts — but RAPL can't say WHAT burns. mesh-gpu-activity's
# IDLE/LIGHT/BUSY attributes a pkg-HIGH: gpu BUSY → media/graphics burn, gpu IDLE → CPU mind-burn.
# Attribution ONLY (reason-string tag + json field) — it never moves the level. Same fresh-gate
# discipline as read_pkg_state (find: capability-igpu-activity-20260702.md).
read_gpu_state(){
  local f="$MESH_DIR/.gpu-activity-state"
  [ -f "$f" ] || { echo "?"; return; }
  find "$f" -mmin "-$PKG_FRESH_MIN" 2>/dev/null | grep -q . || { echo "?"; return; }
  awk '{print $1; exit}' "$f" 2>/dev/null || echo "?"
}
# MEMORY pressure (genome/swap-stress-axis-wire 2026-07-03, per the 06:50Z [design]): mesh-swap-rate
# writes .swap-rate.state (`IDLE|...` / `LIGHT|...` / `THRASHING|...`, first pipe-field = verdict)
# every */5 --edge run. THRASHING (≥500 pg/s sustained swap) is a memory-bound stall the thermal bands
# can NEVER see — a box paging that hard is degrading NOW even while cool. FRESH-GATED like pkg/gpu:
# the state is cached, so a dead swap-rate cron would freeze a stale THRASHING that falsely holds
# dispatch — honest-fusion demands a stale read decay to "?" (no fake pressure), never a blind alarm.
SWAP_FRESH_MIN="${MESH_STRESS_SWAP_FRESH_MIN:-15}"   # 3× the producer's */5 cadence (matches PKG_FRESH_MIN)
read_swap_state(){
  local f="$MESH_DIR/.swap-rate.state"
  [ -f "$f" ] || { echo "?"; return; }
  find "$f" -mmin "-$SWAP_FRESH_MIN" 2>/dev/null | grep -q . || { echo "?"; return; }
  cut -d'|' -f1 "$f" 2>/dev/null || echo "?"
}
# ALLOSTATIC LOAD (second-order wear — see the landing comment in the header). Counts this node's own
# durable regulatory-intervention edges over a rolling window from the board's append-only log. ISO-8601
# UTC timestamps are fixed-width → lexically sortable, so the window cutoff is a plain string compare (no
# per-line date-parse). HONEST-FUSION: no readable log → -1 (unknown, never faked as zero-or-pressure).
ALLO_WINDOW_H="${MESH_STRESS_ALLO_WINDOW_H:-6}"
ALLO_HIGH="${MESH_STRESS_ALLO_HIGH:-8}"          # >= this many interventions in the window = chronic load
allostatic_load(){   # -> integer count of this node's regulatory-intervention edges in the last window, or -1 if no log
  # Resolve the log path LAZILY from the current MESH_DIR (not a parse-time global) so a test cell that
  # reassigns MESH_DIR reads ITS fixture, never leaking the live board log. MESH_STRESS_CHATLOG overrides.
  local log="${MESH_STRESS_CHATLOG:-$MESH_DIR/chat.log}"
  [ -r "$log" ] || { echo -1; return; }
  local cutoff host
  cutoff=$(date -u -d "$ALLO_WINDOW_H hours ago" +%FT%TZ 2>/dev/null) || { echo -1; return; }
  host=$(hostname 2>/dev/null)
  # line shape: "<ISO-ts>  <who>@<host>  ::  [marker] ...". Field 1 = ts, field 2 = who@host (the POSTER,
  # so cross-node gossip about another box is excluded), marker in the body. Recoveries ([therm-cool]/
  # [node-ok]) and mesh-stress's own [mesh-stress] marker are deliberately NOT in the set.
  awk -v cut="$cutoff" -v host="$host" '
    $1 >= cut && index($2, host) && $0 ~ /\[(cpu-throttling|node-hot|therm-hot|hw-fail)\]/ { n++ }
    END { print n+0 }
  ' "$log" 2>/dev/null || echo -1
}
# REACTIVE SCOPE / WEAR-NARROWED BOUNDARY (literature review 2026-07-24 — the RSM landing).
# The allostatic-load axis above COUNTS accommodation; it never moves anything. That is exactly the
# critique the Reactive Scope Model was built on: allostatic load is a cost ACCOUNT that never feeds
# back into the control law, so a node that has been baking at 94°C for six hours is judged by the
# same 98°C line as one that just got there for the first time. RSM's claim is sharper and testable —
# "physiological 'wear and tear' accrues when mediators are in the reactive range, and over time, this
# wear and tear can LOWER THE THRESHOLD for homeostatic overload" (Gilmour, Best & Currie, J Exp Biol
# 228(6):jeb249395, 2025). The dynamics are formalised in Wright, Buch, Beattie, Gormally, Romero &
# Fefferman, "A mathematical representation of the reactive scope model", J Math Biol 2023
# (PMC10468437): dM/dt = −r₁·θ(y−R), dR/dt = −r₂·θ(y−P) + r₃·θ(P−y)·θ(M−R). Two boundaries, not one:
#   R = the CURRENT reactive↔overload boundary — narrows while the mediator sits above the predictive
#       threshold P, and heals back up while it rests below P;
#   M = the CEILING R may heal back to — it drops only when overload is genuinely entered, and it
#       does NOT come back. The signature that separates RSM from a plain decaying counter: after an
#       overload episode, ANY amount of rest leaves the node with permanently less headroom.
# Mapping here: P = WARM_C (the resting-hot line), R starts at CRIT_C (the shed-NOW line), M = CRIT_C.
# Units are TENTHS of °C so the integration has resolution without floats.
#
# REPORT-ONLY, WARM-CAPPED — like pkg-watts and allostatic-load, and for the same reason: r₁/r₂/r₃ are
# UNCALIBRATED here (biology's rates are not this node's), so the narrowed R must never be the line the
# verdict is actually taken against. It reports lost headroom; the calibrated bands still decide. And R
# is floored at STRESSED_C: a wear axis may never invent an alarm BELOW an already-calibrated band.
# On THIS node (≥STRESSED ~22% of the time under the GPE storm) R will ride that floor — which is
# precisely RSM's reading of an animal in chronic overload, and the honest thing for it to say.
# Path resolved LAZILY inside scope_update from the CURRENT MESH_DIR (never a parse-time global): a
# test cell that reassigns MESH_DIR must read ITS fixture, or the live node's own worn scope leaks in
# and fails an unrelated assertion three cells away — which is exactly what happened when it was one.
# MESH_STRESS_SCOPE_STATE overrides.
SCOPE_WEAR_H="${MESH_STRESS_SCOPE_WEAR_H:-5}"    # r₂: tenths °C the boundary narrows per hour above P
SCOPE_HEAL_H="${MESH_STRESS_SCOPE_HEAL_H:-10}"   # r₃: tenths °C it heals per hour while resting below P
SCOPE_PERM_H="${MESH_STRESS_SCOPE_PERM_H:-2}"    # r₁: tenths °C the CEILING loses per hour in overload
SCOPE_WARN="${MESH_STRESS_SCOPE_WARN:-10}"       # tenths of lost headroom before the WATCH bump
# Pure integrator: no clock, no files, no globals mutated → --test drives every branch off fixtures.
# args: R M temp_c dt_secs  → echoes "R M" (tenths). Caller supplies dt; dt=0 is a no-op by construction
# (a 5-minute reflex and an ad-hoc --status must integrate wall-clock, never per-call).
scope_step(){ # R M temp dt
  local R="$1" M="$2" t="$3" dt="$4" floor=$(( STRESSED_C * 10 )) ceil=$(( CRIT_C * 10 ))
  case "$dt" in ''|*[!0-9]*) dt=0 ;; esac
  # OVERLOAD FIRST: y ≥ R (the CURRENT boundary, not the nominal one) is what costs the ceiling. Ordering
  # matters — checking against CRIT_C instead would make M immune to wear the moment R has descended.
  if [ "$t" -ge $(( R / 10 )) ] 2>/dev/null; then
    M=$(( M - SCOPE_PERM_H * dt / 3600 ))
    [ "$M" -lt "$floor" ] && M=$floor
  fi
  if [ "$t" -ge "$WARM_C" ] 2>/dev/null; then
    R=$(( R - SCOPE_WEAR_H * dt / 3600 ))          # in the reactive range → scope shrinks
  else
    R=$(( R + SCOPE_HEAL_H * dt / 3600 ))          # resting → heals, but only toward M
  fi
  [ "$R" -gt "$M" ] && R=$M                        # THE RSM SIGNATURE: the ceiling caps the recovery
  [ "$R" -lt "$floor" ] && R=$floor
  [ "$M" -gt "$ceil" ] && M=$ceil
  printf '%s %s\n' "$R" "$M"
}
# Read → step → persist. Unconditional write, so the state's mtime IS liveness (the conditional-write
# false-STALE trap in CLAUDE.md). Sets globals scope_r / scope_m (tenths) and scope_lost.
scope_update(){ # $1=temp
  local t="$1" now R M last dt out f
  f="${MESH_STRESS_SCOPE_STATE:-$MESH_DIR/.stress-scope}"
  now=$(date +%s)
  if [ -r "$f" ]; then read -r R M last _ < "$f" 2>/dev/null; fi
  case "${R:-}" in ''|*[!0-9]*) R=$(( CRIT_C * 10 )) ;; esac
  case "${M:-}" in ''|*[!0-9]*) M=$(( CRIT_C * 10 )) ;; esac
  case "${last:-}" in ''|*[!0-9]*) last=$now ;; esac
  dt=$(( now - last )); [ "$dt" -lt 0 ] && dt=0     # clock stepped backwards → integrate nothing
  # temp=-1 (no thermal organ) is NOT a cool reading — an unknown mediator must not be integrated as
  # rest, or a dead sensor would silently "heal" the node's scope back to full. Hold the state.
  if [ "$t" -lt 0 ] 2>/dev/null; then dt=0; fi
  out="$(scope_step "$R" "$M" "$t" "$dt")"
  scope_r="${out% *}"; scope_m="${out#* }"
  scope_lost=$(( CRIT_C * 10 - scope_r ))
  printf '%s %s %s\n' "$scope_r" "$scope_m" "$now" > "$f" 2>/dev/null || true
}

# THERMAL-REGULATORY REGIME (foresight axis — closes the mesh-therm-regime producer↔consumer link,
# chat MCC 2026-07-11). The raw temp bands above see only WHERE THE THERMOMETER IS NOW; they are
# structurally blind to a node LOSING its regulatory RESERVE while still cool — CSD variance+lag-1
# autocorr both rising ∧ DFA long-range complexity lost = the BRITTLE hidden regime. mesh-therm-regime
# fuses therm-watch's STATE+CSD+DFA into one regime verdict; it was built on-demand ("meaningful only
# when a consumer actually asks") and had NO consumer (grep -rl: refs=1, itself) — THIS is that
# consumer. FRESH-GATED read of the cached .therm-regime.state, refreshed on the */5 --alert reflex +
# --probe below (same cadence as the pkg/gpu/swap producers); a dead refresh decays to "?" → no bump
# (honest-fusion, never a faked foresight signal). MESH_STRESS_REGIME overrides for --test injection.
REGIME_FRESH_MIN="${MESH_STRESS_REGIME_FRESH_MIN:-15}"   # 3× the */5 refresh cadence (matches PKG_FRESH_MIN)
read_regime_state(){   # -> BRITTLE|SLIDING|HOT-STABLE|WATCH|HEALTHY|CRITICAL|UNKNOWN | ?
  [ -n "${MESH_STRESS_REGIME:-}" ] && { echo "$MESH_STRESS_REGIME"; return; }
  local f="$MESH_DIR/.therm-regime.state"
  [ -f "$f" ] || { echo "?"; return; }
  find "$f" -mmin "-$REGIME_FRESH_MIN" 2>/dev/null | grep -q . || { echo "?"; return; }
  awk '{print $1; exit}' "$f" 2>/dev/null || echo "?"    # field 1 of "REGIME<tab>now<tab>csd<tab>dfa<tab>ts"
}
# OPERATOR-CHANNEL axis (voice-rx-functional-blindspot, 2026-07-28): the INBOUND half of "is the
# operator channel at risk". router/egress above are OUTBOUND proxies — none is the channel itself, so
# a voice-rx DNS outage (2026-07-25 01:41–01:47Z DEAF) moved NO axis and this tool, named after that
# exact risk, flagged nothing. mesh-voice-rx now writes .voice-rx-state on EVERY poll (mtime=liveness,
# field1=OK|ERR:<class>); read it as a first-class axis. ABSENT file = no operator channel on this node
# → "?" (honest unknown, never a faked all-clear NOR a faked alarm). PRESENT-but-stale = the poller
# was running and wedged/died → real signal (STALE). Fresh ERR:* = the channel is impaired right now.
VOICE_RX_FRESH_MIN="${MESH_STRESS_VOICE_RX_FRESH_MIN:-5}"   # voice-rx long-polls ~every 25s idle, ~3s on error → 5min is 12× the idle cadence
read_voice_rx_state(){   # -> OK | ERR:<class> | STALE | ?
  [ -n "${MESH_STRESS_VOICE_RX:-}" ] && { echo "$MESH_STRESS_VOICE_RX"; return; }   # --test / injection
  local f="$MESH_DIR/.voice-rx-state"
  [ -f "$f" ] || { echo "?"; return; }   # no writer here → no signal, not an alarm
  find "$f" -mmin "-$VOICE_RX_FRESH_MIN" 2>/dev/null | grep -q . || { echo "STALE"; return; }
  awk '{print $1; exit}' "$f" 2>/dev/null || echo "?"    # field 1 of "<status>\t<iso-ts>"
}
# EGRESS CAUSE (2026-08-14, chat-review/stress-egress-bad-mislabeled-geoblock). `.egress-state` is a
# BINARY OK/BAD bit, and this tool used to read "BAD" as "geo-blocked → channel literally down" —
# CRITICAL + "run mesh-fix-egress NOW". But mesh-egress-health fires BAD for two orthogonal mechanisms:
# a 403 geo-block (the Anthropic round-trip is DEAD — a real channel outage) and a country MISMATCH
# (the round-trip works; we are merely egressing somewhere unexpected — a risk, not an outage). The bit
# could not tell them apart, so a working channel paged as a down one: measured on mesh-home 2026-08-14,
# every BAD sample carried anthropic=405 (function alive) with ZERO 403s all day, while stress sat
# CRITICAL and situation=ALERT. mesh-egress-health now writes the cause in `.egress-cause` beside the
# bit; we read it. NO sidecar (older writer, other node) ⇒ cause "?" ⇒ the old conservative CRITICAL
# stands — an absent cause is not evidence of a benign one (never a faked all-clear).
read_egress_cause(){   # -> egress_cause (OK|GEOBLOCK|ISO-MISMATCH|ISO-DRIFT|?), egress_fn (PRESERVED|IMPAIRED|UNKNOWN|?)
  egress_cause="?"; egress_fn="?"
  if [ -n "${MESH_STRESS_EGRESS_CAUSE:-}" ]; then set -- $MESH_STRESS_EGRESS_CAUSE   # --test / injection
  else
    local f="$MESH_DIR/.egress-cause"; [ -f "$f" ] || return 0
    set -- $(cat "$f" 2>/dev/null)
  fi
  [ -n "${1:-}" ] && egress_cause="$1"
  case "${2:-}" in qfunc=*) egress_fn="${2#qfunc=}" ;; esac
}
# Pure fusion rule (no clock, no files → --test drives every branch). CRITICAL is reserved for the
# channel actually being DOWN; a degraded-but-working egress is a WATCH signal, not a page.
egress_channel(){  # $1=egress_s $2=egress_cause $3=egress_fn -> CALM|WARM|CRITICAL
  # ISO-DRIFT is read BEFORE the bit, because it is the one cause that arrives with the bit reading OK:
  # since 2026-08-22 mesh-egress-health stops pinning BAD for a country mismatch whose Anthropic
  # round-trip is alive (the bit is cause-blind to ~9 other readers, which escalated off it for 46h).
  # The pin rotting is still worth WATCHING, so the drift keeps its WARM band here — the only place in
  # the mesh that reads the cause at all. Function evidence is required: an ISO-DRIFT with no PRESERVED
  # falls through to the bit rather than minting a watch out of nothing.
  case "$2" in ISO-DRIFT) [ "$3" = PRESERVED ] && { echo WARM; return; } ;; esac
  case "$1" in BAD) ;; *) echo CALM; return ;; esac
  case "$2" in
    ISO-MISMATCH) [ "$3" = PRESERVED ] && { echo WARM; return; } ;;  # older writer/other node: same call
  esac
  echo CRITICAL   # GEOBLOCK, an impaired/unknown function, or no cause sidecar at all
}
read_siblings() {
  therm_s=$(cat "$MESH_DIR/.therm-state" 2>/dev/null || echo "?")            # HOT / OK
  router_s=$(cat "$MESH_DIR/.router-thermal-state" 2>/dev/null || echo "?")  # hot / cool
  egress_s=$(cat "$MESH_DIR/.egress-state" 2>/dev/null || echo "?")          # OK / BAD
  read_egress_cause                                                          # -> egress_cause, egress_fn
  voicerx_s=$(read_voice_rx_state)                                         # OK / ERR:<class> / STALE / ?
  pkg_s=$(read_pkg_state)                                                    # LOW / NORMAL / HIGH / ?
  gpu_s=$(read_gpu_state)                                                    # IDLE / LIGHT / BUSY / ?
  swap_s=$(read_swap_state)                                                  # IDLE / LIGHT / THRASHING / ?
  allo_n=$(allostatic_load)                                                  # N interventions in window, or -1
  regime_s=$(read_regime_state)                                             # BRITTLE/SLIDING/.../? (foresight)
}

assess() {
  read_local
  read_siblings

  # THERMAL pressure from the live local trio.
  local thermal=CALM
  if   [ "$temp" -ge "$CRIT_C" ] 2>/dev/null; then thermal=CRITICAL
  elif [ "$temp" -ge "$STRESSED_C" ] 2>/dev/null; then thermal=STRESSED
  elif [ "$temp" -ge "$WARM_C" ] 2>/dev/null; then thermal=WARM
  fi
  # Climbing escalation: WARM/STRESSED + sustained load + many minds → bump one band (fire on the way up).
  climbing=no
  if [ "$(lvl_num "$thermal")" -ge 1 ] && [ "$(lvl_num "$thermal")" -le 2 ]; then
    if awk "BEGIN{exit !($load_norm > 1.0)}" && [ "$minds" -ge "$HEAVY_MINDS" ] 2>/dev/null; then
      thermal=$(lvl_name $(( $(lvl_num "$thermal") + 1 ))); climbing=yes
    fi
  fi

  # Coherence check: heavy load that never moves the temp reading is a decoupled (stuck) sensor,
  # not a calm node — escalate to at least STRESSED rather than trust a reading that stopped
  # tracking its own cause.
  # A node with NO thermal organ (temp=-1 from every tier) has no reading to be decoupled — a
  # constant -1 under heavy load is blindness, not a stuck sensor; never escalate on it.
  if [ "$temp" -ge 0 ]; then
    streak=$(track_temp "$temp" "$minds" "$load_norm")
  else
    streak=0
  fi
  decoupled=no
  if [ "$streak" -ge "$FROZEN_STREAK_N" ]; then
    decoupled=yes
    thermal=$(worse "$thermal" STRESSED)
  fi

  # Leading watt-draw bump — AFTER the climbing block on purpose: a provisional pkg-HIGH may only
  # produce WARM (watch), never feed the WARM→STRESSED climbing escalation that gates dispatch.
  leading=no
  if [ "$(pkg_lead "$pkg_s" "$thermal")" != "$thermal" ]; then
    thermal=WARM; leading=yes
  fi

  # CHANNEL pressure from cached sibling reflexes — the operator channel dies without heat too.
  local channel=CALM
  [ "$router_s" = hot ] && channel=$(worse "$channel" STRESSED)   # LAN+egress at risk
  # egress: CRITICAL only for a channel that is actually DOWN (403 geo-block / round-trip impaired /
  # cause unknown); a wrong-country egress whose Anthropic round-trip is alive is WARM (see egress_channel).
  channel=$(worse "$channel" "$(egress_channel "$egress_s" "${egress_cause:-?}" "${egress_fn:-?}")")
  # OPERATOR CHANNEL (inbound): a fresh voice-rx error OR a wedged/dead poller (STALE) is the actual
  # channel impaired — STRESSED, matching router=hot (a WATCH-level "at risk", not the CRITICAL hard-
  # down egress geo-block gets). "?"/OK never escalate: absent writer = no signal, OK = channel up.
  case "$voicerx_s" in ERR:*|STALE) channel=$(worse "$channel" STRESSED) ;; esac

  # MEMORY pressure — a memory-bound stall (heavy sustained swap) degrades the node without heat,
  # invisible to the thermal bands. Fresh THRASHING → STRESSED (stale already decayed to "?" above).
  local memory=CALM
  [ "$swap_s" = THRASHING ] && memory=$(worse "$memory" STRESSED)

  level=$(worse "$thermal" "$channel")
  level=$(worse "$level" "$memory")

  # ALLOSTATIC LOAD (second-order): chronic regulatory wear the instantaneous bands can't see. A node
  # regulated >= ALLO_HIGH times in the window is under chronic load even when currently cool. WARM-
  # CAPPED like pkg-watts (worse() floors at WARM, never lifts an already-elevated band) so this can
  # only ever raise the WATCH signal, never gate dispatch off an uncalibrated intervention-rate.
  chronic=no
  if [ "${allo_n:-0}" -ge "$ALLO_HIGH" ] 2>/dev/null; then
    level=$(worse "$level" WARM); chronic=yes
  fi

  # THERMAL-REGULATORY FORESIGHT (mesh-therm-regime fusion): the raw bands are blind to a node LOSING
  # regulatory reserve while still cool. regime=BRITTLE (CSD precursor ∧ DFA complexity-loss on a
  # NOT-hot box) IS that hidden slide — surface it as WATCH. WARM-capped like pkg/allostatic (worse()
  # floors at WARM): an advisory precursor raises the watch signal, NEVER gates dispatch. SLIDING
  # (hot ∧ corroborated precursor) is already ≥WARM from the temp bands → reason-annotated only, no bump.
  brittle=no
  if [ "$regime_s" = BRITTLE ]; then
    level=$(worse "$level" WARM); brittle=yes
  fi

  # REACTIVE SCOPE (RSM): integrate the wear-narrowed boundary over the elapsed wall-clock and surface
  # LOST HEADROOM. WARM-capped like the two axes above — the narrowed R is REPORTED, never the line the
  # verdict is taken against (uncalibrated rates must not gate; see the landing comment).
  scope_update "$temp"
  worn=no
  if [ "${scope_lost:-0}" -ge "$SCOPE_WARN" ] 2>/dev/null; then
    level=$(worse "$level" WARM); worn=yes
  fi
}

reason_str() {
  # temp=-1 is "no thermal organ read", not a temperature — render the honest unknown, never a
  # plausible number (JSON keeps the numeric -1 sentinel; this is the human/board surface).
  local tdisp="${temp}C"; [ "$temp" -lt 0 ] 2>/dev/null && tdisp="?(no-organ)"
  local r="temp=$tdisp load=${load_norm} minds=${minds}"
  # Which WARM band is in force, and on what corpus — a band is only readable next to its
  # calibration (the stale-band failure was invisible precisely because the number stood alone).
  if [ "$BAND_SRC" = p50 ]; then r="$r warm@${WARM_C}C(p50=${CURVE_P50}+${WARM_DELTA},n=${CURVE_N})"
  else r="$r warm@${WARM_C}C(abs)"; fi
  [ "$climbing" = yes ] && r="$r climbing↑"
  [ "$pkg_s" = HIGH ] && { r="$r pkg-watts=HIGH"; [ "${leading:-no}" = yes ] && r="$r(leading↑)"
    # attribution: what is burning the watts (LIGHT/? stay untagged — ambiguous is not evidence)
    case "${gpu_s:-?}" in BUSY) r="$r(burn:gpu)";; IDLE) r="$r(burn:cpu)";; esac; }
  [ "$decoupled" = yes ] && r="$r temp-frozen(decoupled)"
  [ "$router_s" = hot ] && r="$r router=HOT"
  # Name the MECHANISM, never just the bit — "egress=BAD" alone was read as "geo-blocked" for months.
  [ "$egress_s" = BAD ] && r="$r egress=BAD(${egress_cause:-?},fn=${egress_fn:-?})"
  [ "$egress_s" != BAD ] && [ "${egress_cause:-?}" = ISO-DRIFT ] && r="$r egress=DRIFT(fn=${egress_fn:-?})"
  case "$voicerx_s" in
    ERR:*) r="$r operator-channel=${voicerx_s}" ;;                    # e.g. operator-channel=ERR:dns
    STALE) r="$r operator-channel=STALE(poller-wedged?)" ;;
  esac
  [ "$swap_s" = THRASHING ] && r="$r swap=THRASHING"
  if [ "${allo_n:-x}" = -1 ]; then r="$r allostatic-load=?"
  elif [ -n "${allo_n:-}" ]; then r="$r allostatic-load=${allo_n}/${ALLO_WINDOW_H}h"; fi
  [ "${chronic:-no}" = yes ] && r="$r chronic↑"
  # Reactive scope: report the boundary and the ceiling in °C, and flag a ceiling that has itself been
  # lost (M < nominal = an overload episode already spent headroom that rest cannot return).
  if [ -n "${scope_r:-}" ]; then
    r="$r scope=$(( scope_r / 10 )).$(( scope_r % 10 ))C"
    [ "${scope_m:-0}" -lt $(( CRIT_C * 10 )) ] 2>/dev/null && r="$r ceiling=$(( scope_m / 10 )).$(( scope_m % 10 ))C(spent)"
    [ "${worn:-no}" = yes ] && r="$r headroom-lost↑"
  fi
  case "${regime_s:-}" in
    BRITTLE) r="$r regime=BRITTLE(reserve-loss↑)";;   # cool but de-regulating — the temp bands miss this
    SLIDING) r="$r regime=SLIDING↑";;                 # hot ∧ corroborated precursor — heading toward throttle
  esac
  echo "$r"
}

# Is `mesh-fix-egress` an ACTION on THIS node, or a clean no-op? It exits 2 by design where the node
# offers no VPN egress (no VPN_EGRESS_* in ~/.mesh/nodes — mesh-home since the 2026-08-11 nesting
# rollback), so prescribing it there demands an action that cannot run. Prescribe the remedy only where
# it applies; elsewhere say what the operator can actually do. (MESH_STRESS_FIX_EGRESS_RC drives --test.)
egress_remedy(){  # -> the operator instruction for a down/degraded egress on THIS node
  local rc="${MESH_STRESS_FIX_EGRESS_RC:-}"
  [ -n "$rc" ] || { mesh-fix-egress --test >/dev/null 2>&1; rc=$?; }
  [ "$rc" = 2 ] && { echo "mesh-fix-egress is n/a on this node (offers no VPN egress) → check the UPSTREAM path (router/gateway VPN) and ~/.mesh/egress.conf's expected ISO"; return; }
  echo "mesh-fix-egress NOW"
}
advice() {
  case "$level" in
    CRITICAL) [ "$egress_s" = BAD ] && [ "$(egress_channel "$egress_s" "${egress_cause:-?}" "${egress_fn:-?}")" = CRITICAL ] &&
                { echo "egress DOWN (${egress_cause:-?}, function ${egress_fn:-?}) → $(egress_remedy)"; return; }
              echo "at/over throttle → auto new-load shed ACTIVE (tick-skip + dispatch-hold ≥92C). Sustained = the running mind set alone overheats this box → operator lever: fewer MESH_MIND_CHANNELS / re-enable offload. Do NOT pause a running mind (loses work; mesh-supervise has no thermal shed)";;
    STRESSED) [ "$router_s" = hot ] && { echo "router hot → check gateway airflow/load"; return; }
              [ "$swap_s" = THRASHING ] && { echo "memory THRASHING (≥500 pg/s sustained swap) → box is paging hard, memory-bound stall (not heat) → free RAM / shed a mind"; return; }
              echo "in the 95-97C throttle zone → new-load auto-hold is engaging; don't pile heavy work. Running minds are NOT shed (by design — shed new load, never touch a running mind)";;
    WARM)     [ "${egress_cause:-?}" = ISO-DRIFT ] && [ "${egress_fn:-?}" = PRESERVED ] &&
                { echo "egress exits the WRONG country ($egress_cause) but the Anthropic round-trip is ALIVE — NOT an outage: reconcile ~/.mesh/egress.conf's MESH_EGRESS_ISO with the path that now carries this node (see the DRIFT line's via= in ~/.mesh/egress-health.log)"; return; }
              [ "$egress_s" = BAD ] && [ "${egress_cause:-?}" = ISO-MISMATCH ] && [ "${egress_fn:-?}" = PRESERVED ] &&
                { echo "egress exits the WRONG country but the Anthropic round-trip is ALIVE (anth ok) — a risk to watch, NOT a geo-block: verify ~/.mesh/egress.conf's expected ISO still matches this node's real path"; return; }
              echo "watch — load/heat building";;
    *)        echo "ok";;
  esac
}

case "${1:-}" in
  --test)
    [ -r /proc/loadavg ] || { echo "smoke-test: FAIL (/proc/loadavg)"; exit 1; }
    command -v nproc >/dev/null 2>&1 || { echo "smoke-test: FAIL (nproc)"; exit 1; }
    command -v awk   >/dev/null 2>&1 || { echo "smoke-test: FAIL (awk)"; exit 1; }
    mkdir -p "$MESH_DIR" 2>/dev/null || { echo "smoke-test: FAIL (no ~/.mesh)"; exit 1; }
    assess
    case "$level" in CALM|WARM|STRESSED|CRITICAL) : ;; *) echo "smoke-test: FAIL (bad level '$level')"; exit 1;; esac
    # THERMAL TWO-TIER (2026-07-16): the hwmon-only node (AMD/mesh-home — zero thermal_zone*) must be
    # READ, not blind. Zone-only left temp=-1 here for weeks while k10temp read 60C — a blind axis
    # whose own --test stayed green because nothing drove the read. Fixture-driven via the globs.
    _hf=$(mktemp -d); mkdir -p "$_hf/hwmon0" "$_hf/zone0"
    echo 67000 > "$_hf/hwmon0/temp1_input"
    STRESS_ZONE_GLOB="$_hf/nozone*/temp" STRESS_HWMON_GLOB="$_hf/hwmon*/temp*_input" read_local
    [ "$temp" = 67 ] || { rm -rf "$_hf"; echo "smoke-test: FAIL (hwmon-only node must read its CPU temp from the hwmon tier, got temp=$temp)"; exit 1; }
    echo 71000 > "$_hf/zone0/temp"
    STRESS_ZONE_GLOB="$_hf/zone*/temp" STRESS_HWMON_GLOB="$_hf/hwmon*/temp*_input" read_local
    [ "$temp" = 71 ] || { rm -rf "$_hf"; echo "smoke-test: FAIL (cross-tier max: zone 71C over hwmon 67C, got temp=$temp)"; exit 1; }
    STRESS_ZONE_GLOB="$_hf/nozone*/temp" STRESS_HWMON_GLOB="$_hf/nohwmon*/temp*_input" read_local
    [ "$temp" = -1 ] || { rm -rf "$_hf"; echo "smoke-test: FAIL (no thermal organ anywhere must stay -1, never a fake reading, got temp=$temp)"; exit 1; }
    # EGRESS CAUSE (chat-review/stress-egress-bad-mislabeled-geoblock): a BAD bit is not a geo-block.
    ec=0
    [ "$(egress_channel OK OK PRESERVED)"           = CALM ]     || { echo "  FAIL: egress OK must not touch the channel band"; ec=1; }
    [ "$(egress_channel '?' '?' '?')"               = CALM ]     || { echo "  FAIL: an absent egress writer is no signal, not pressure"; ec=1; }
    [ "$(egress_channel BAD GEOBLOCK IMPAIRED)"     = CRITICAL ] || { echo "  FAIL: a real 403 geo-block must still be CRITICAL"; ec=1; }
    [ "$(egress_channel BAD ISO-MISMATCH PRESERVED)" = WARM ]    || { echo "  FAIL: wrong country + LIVE Anthropic round-trip is a WATCH, not a channel-down page"; ec=1; }
    [ "$(egress_channel BAD ISO-MISMATCH IMPAIRED)" = CRITICAL ] || { echo "  FAIL: wrong country AND an impaired round-trip is a real outage"; ec=1; }
    [ "$(egress_channel BAD '?' '?')"               = CRITICAL ] || { echo "  FAIL: BAD with NO cause sidecar must stay conservatively CRITICAL (no faked all-clear)"; ec=1; }
    # ISO-DRIFT (2026-08-22, task egress-iso-pin-tracks-the-route-and-nothing-derives-it): mesh-egress-health
    # no longer pins the BINARY bit to BAD for a country mismatch whose Anthropic round-trip is alive — the
    # bit could not carry that distinction and ~9 cause-blind readers escalated off it (mesh-digest
    # "GEO-BLOCKED NOW", mesh-algedonic pain 0.7, mesh-mesh-state DEGRADED). It writes state OK + cause
    # ISO-DRIFT instead. This tool DOES read the cause, so the drift must keep its WATCH here — otherwise
    # the fix trades a false page for a blind spot and nothing in the mesh watches the pin rot at all.
    [ "$(egress_channel OK ISO-DRIFT PRESERVED)"    = WARM ]     || { echo "  FAIL: a country DRIFT with a live round-trip must stay a WATCH here — the bit going OK must not make it invisible"; ec=1; }
    [ "$(egress_channel OK ISO-DRIFT '?')"          = CALM ]     || { echo "  FAIL: an ISO-DRIFT cause with no function evidence must not manufacture a watch off an OK bit"; ec=1; }
    [ "$ec" = 0 ] || { echo "smoke-test: FAIL (egress cause fusion drifted)"; exit 1; }
    # the sidecar reader, incl. the injection path and a missing file
    _ed=$(mktemp -d); _mdsave="$MESH_DIR"; MESH_DIR="$_ed"
    read_egress_cause; [ "$egress_cause" = "?" ] && [ "$egress_fn" = "?" ] || { rm -rf "$_ed"; MESH_DIR="$_mdsave"; echo "smoke-test: FAIL (missing .egress-cause must read '?/?', never a benign default)"; exit 1; }
    printf 'ISO-MISMATCH qfunc=PRESERVED anth=405\n' > "$_ed/.egress-cause"
    read_egress_cause; [ "$egress_cause" = ISO-MISMATCH ] && [ "$egress_fn" = PRESERVED ] || { rm -rf "$_ed"; MESH_DIR="$_mdsave"; echo "smoke-test: FAIL (cause sidecar parse: got '$egress_cause'/'$egress_fn')"; exit 1; }
    rm -rf "$_ed"; MESH_DIR="$_mdsave"
    # end-to-end: the fused level + the operator string, both directions, with the thermal bands pinned away
    ( WARM_C=900 STRESSED_C=901 CRIT_C=902
      MESH_STRESS_EGRESS_CAUSE='ISO-MISMATCH qfunc=PRESERVED anth=405' MESH_STRESS_FIX_EGRESS_RC=2
      export MESH_STRESS_EGRESS_CAUSE MESH_STRESS_FIX_EGRESS_RC
      assess; egress_s=BAD; read_egress_cause
      level=$(worse CALM "$(egress_channel BAD "$egress_cause" "$egress_fn")")
      [ "$level" = WARM ] || { echo "smoke-test: FAIL (working-but-wrong-country egress must fuse to WARM, got $level)"; exit 1; }
      reason_str | grep -q 'egress=BAD(ISO-MISMATCH,fn=PRESERVED)' || { echo "smoke-test: FAIL (the report must name the mechanism, not just the bit)"; exit 1; }
      advice | grep -q 'geo-block' || { echo "smoke-test: FAIL (the WARM advice must say what it is NOT)"; exit 1; }
      advice | grep -q 'mesh-fix-egress NOW' && { echo "smoke-test: FAIL (a working channel must never demand mesh-fix-egress)"; exit 1; }
      level=CRITICAL; egress_cause=GEOBLOCK egress_fn=IMPAIRED
      advice | grep -q 'egress DOWN (GEOBLOCK' || { echo "smoke-test: FAIL (a real geo-block must still page)"; exit 1; }
      advice | grep -q 'n/a on this node' || { echo "smoke-test: FAIL (an inapplicable remedy must not be prescribed — mesh-fix-egress exits 2 here)"; exit 1; }
      MESH_STRESS_FIX_EGRESS_RC=0 advice | grep -q 'mesh-fix-egress NOW' || { echo "smoke-test: FAIL (where the remedy DOES apply it must still be prescribed)"; exit 1; }
    ) || exit 1
    temp=-1 load_norm=0 minds=0 climbing=no decoupled=no router_s=cool egress_s=OK pkg_s=? gpu_s=? swap_s=? allo_n=-1 regime_s=? leading=no chronic=no brittle=no
    reason_str | grep -q 'temp=?(no-organ)' || { rm -rf "$_hf"; echo "smoke-test: FAIL (temp=-1 must render as the honest '?(no-organ)', not a plausible number)"; exit 1; }
    rm -rf "$_hf"
    # Live-read gate on a node WITH a thermal organ: assess must produce a real temp (this is the
    # gate that would have gone red on mesh-home — k10temp present, temp=-1). Honest n/a otherwise.
    if ls /sys/class/thermal/thermal_zone*/temp /sys/class/hwmon/hwmon*/temp*_input >/dev/null 2>&1; then
      assess
      [ "$temp" -ge 0 ] 2>/dev/null || { echo "smoke-test: FAIL (thermal sensors exist on $(hostname) but assess read temp=$temp — the axis is blind)"; exit 1; }
    fi
    # --- BAND REACHABILITY: the standing detector for the stale-band class (2026-07-24) ---------
    # The 2026-06-13 bands (fitted to the GPE storm, p50=90) survived six weeks past the end of that
    # regime and NOTHING went red: the axis simply reported CALM forever, and "never fires" is
    # indistinguishable from "nothing happened" unless something checks the band against the corpus.
    # So: the WARM band in force must INTERSECT this node's own observed curve — a band above every
    # temperature the node has ever reached is decorative, not calibrated. Pure read of therm.log
    # (this test writes NOTHING it later reads). Absent/short corpus = LOUD skip, never a silent pass.
    # Remedy when RED: lower wd in scripts/uxn/threshold-ledger (a data diff), or ask why the node
    # runs so far below its own median spread. The hazard bands (STRESSED/CRIT) are deliberately NOT
    # checked here — an alarm band that no observation crosses is honest; see the header.
    if _tc="$(therm_curve)"; then
      read -r _p50 _cmax _cn <<EOF
$_tc
EOF
      [ "$WARM_C_ATLOAD" -le "$_cmax" ] || { echo "smoke-test: FAIL (thermal band UNREACHABLE — the WARM band in force is ${WARM_C_ATLOAD}C (${BAND_SRC}) but this node's own curve over ${CURVE_DAYS}d never exceeded ${_cmax}C (p50=${_p50}, n=${_cn}): the thermal axis cannot leave CALM, exactly the 2026-06-13 stale-band failure)"; exit 1; }
      echo "band-reachability: ok (WARM=${WARM_C_ATLOAD}C[$BAND_SRC] vs corpus p50=${_p50} max=${_cmax} n=${_cn})"
      unset _tc _p50 _cmax _cn
    else
      echo "band-reachability: skip — no usable corpus at $THERM_LOG (<${CURVE_MIN_N} samples in ${CURVE_DAYS}d); the WARM band cannot be checked against this node"
    fi
    # Dry-run the LOAD-BEARING edge logic the live `assess` above can NEVER reach: it only ever sees
    # ONE point on the temp curve, so effective_level() (the asymmetric schmitt hysteresis that decides
    # every [mesh-stress]/[mesh-calm] edge) and worse() went wholly untested — a flipped >= or a wrong
    # HYST sign would silently spam or suppress the stress edges while --test stayed green (the exact
    # test/code-drift class fixed for mesh-relay 2026-06-17). Pin the bands so the asserts are
    # deterministic regardless of env overrides, then check the DOCUMENTED invariants.
    WARM_C=90 STRESSED_C=95 CRIT_C=98 HYST=3
    [ "$(effective_level STRESSED CALM 50)" = STRESSED ] || { echo "smoke-test: FAIL (escalation must be immediate: STRESSED over CALM → STRESSED)"; exit 1; }
    [ "$(effective_level WARM WARM 90)"     = WARM ]     || { echo "smoke-test: FAIL (same level must hold)"; exit 1; }
    [ "$(effective_level CALM STRESSED 93)" = STRESSED ] || { echo "smoke-test: FAIL (downgrade fired before temp cleared floor-HYST: 93 is not < 95-3=92, must stay STRESSED)"; exit 1; }
    [ "$(effective_level CALM STRESSED 91)" = WARM ]     || { echo "smoke-test: FAIL (downgrade must walk ONE band: 91 < 92 clears STRESSED → WARM, not straight to CALM)"; exit 1; }
    [ "$(effective_level CALM CRITICAL 50)" = CALM ]     || { echo "smoke-test: FAIL (a cold node must downgrade all the way to CALM)"; exit 1; }
    [ "$(worse CALM CRITICAL)"              = CRITICAL ] || { echo "smoke-test: FAIL (worse() must pick the higher band)"; exit 1; }
    # post_tier(): the board is the shed-NOW alarm only; routine flap + recoveries → trace.
    [ "$(post_tier CRITICAL STRESSED)" = board ] || { echo "smoke-test: FAIL (→CRITICAL must hit the board)"; exit 1; }
    [ "$(post_tier CRITICAL CALM)"     = board ] || { echo "smoke-test: FAIL (→CRITICAL must hit the board)"; exit 1; }
    [ "$(post_tier STRESSED WARM)"     = trace ] || { echo "smoke-test: FAIL (routine →STRESSED must go to trace, not the board)"; exit 1; }
    [ "$(post_tier STRESSED CALM)"     = trace ] || { echo "smoke-test: FAIL (routine →STRESSED must go to trace)"; exit 1; }
    [ "$(post_tier WARM STRESSED)"     = trace ] || { echo "smoke-test: FAIL (recovery out of alarm → trace)"; exit 1; }
    [ "$(post_tier CALM CRITICAL)"     = trace ] || { echo "smoke-test: FAIL (recovery → trace)"; exit 1; }
    [ "$(post_tier WARM CALM)"         = none ]  || { echo "smoke-test: FAIL (sub-alarm change → no post)"; exit 1; }
    [ "$(post_tier STRESSED STRESSED)" = none ]  || { echo "smoke-test: FAIL (no change → no post)"; exit 1; }
    # track_temp: the biosemiotic coherence streak (temp decoupled from its own cause = load+minds).
    _td=$(mktemp -d); MESH_DIR="$_td" TEMPWATCH="$_td/.stress-tempwatch" HEAVY_MINDS=6 FROZEN_STREAK_N=3
    [ "$(track_temp 90 6 1.5)" = 0 ] || { echo "smoke-test: FAIL (track_temp: first-ever sample has no prior to match, streak must start at 0)"; exit 1; }
    [ "$(track_temp 90 6 1.5)" = 1 ] || { echo "smoke-test: FAIL (track_temp: repeated identical temp under heavy load must increment streak)"; exit 1; }
    [ "$(track_temp 90 6 1.5)" = 2 ] || { echo "smoke-test: FAIL (track_temp: streak must keep climbing while unmoved+heavy)"; exit 1; }
    [ "$(track_temp 91 6 1.5)" = 0 ] || { echo "smoke-test: FAIL (track_temp: temp actually moving must reset streak to 0)"; exit 1; }
    track_temp 90 6 1.5 >/dev/null; track_temp 90 6 1.5 >/dev/null
    [ "$(track_temp 90 2 1.5)" = 0 ] || { echo "smoke-test: FAIL (track_temp: minds dropping below HEAVY_MINDS must reset streak)"; exit 1; }
    rm -rf "$_td"
    # pkg-watts leading input: fresh-gate honesty + the WARM-cap on the bump.
    _pd=$(mktemp -d); MESH_DIR="$_pd"
    [ "$(read_pkg_state)" = "?" ] || { echo "smoke-test: FAIL (missing pkg state must read '?', not a level)"; exit 1; }
    echo "HIGH 15.32W" > "$_pd/.package-power-state"
    [ "$(read_pkg_state)" = HIGH ] || { echo "smoke-test: FAIL (fresh pkg state must read its level)"; exit 1; }
    touch -d '20 minutes ago' "$_pd/.package-power-state"
    [ "$(read_pkg_state)" = "?" ] || { echo "smoke-test: FAIL (stale pkg HIGH must decay to '?' — honest-fusion, no fake pressure)"; exit 1; }
    rm -rf "$_pd"
    [ "$(pkg_lead HIGH CALM)" = WARM ]     || { echo "smoke-test: FAIL (pkg HIGH on a CALM node must lead to WARM)"; exit 1; }
    [ "$(pkg_lead HIGH WARM)" = WARM ]     || { echo "smoke-test: FAIL (pkg bump is capped at WARM — no double-bump)"; exit 1; }
    [ "$(pkg_lead HIGH STRESSED)" = STRESSED ] || { echo "smoke-test: FAIL (pkg must never touch an already-elevated band)"; exit 1; }
    [ "$(pkg_lead LOW CALM)" = CALM ]      || { echo "smoke-test: FAIL (pkg LOW must not bump)"; exit 1; }
    [ "$(pkg_lead '?' CALM)" = CALM ]      || { echo "smoke-test: FAIL (pkg unknown must not bump — unknown is not pressure)"; exit 1; }
    # gpu attribution sidecar: fresh-gate honesty + reason tag (never a level change).
    _gd=$(mktemp -d); MESH_DIR="$_gd"
    [ "$(read_gpu_state)" = "?" ] || { echo "smoke-test: FAIL (missing gpu state must read '?')"; exit 1; }
    echo "BUSY 42.0% 900MHz" > "$_gd/.gpu-activity-state"
    [ "$(read_gpu_state)" = BUSY ] || { echo "smoke-test: FAIL (fresh gpu state must read its level)"; exit 1; }
    touch -d '20 minutes ago' "$_gd/.gpu-activity-state"
    [ "$(read_gpu_state)" = "?" ] || { echo "smoke-test: FAIL (stale gpu state must decay to '?')"; exit 1; }
    rm -rf "$_gd"
    temp=70 load_norm=1.2 minds=5 climbing=no decoupled=no router_s=cool egress_s=OK leading=yes
    pkg_s=HIGH gpu_s=BUSY swap_s=IDLE
    reason_str | grep -q 'pkg-watts=HIGH(leading↑)(burn:gpu)' || { echo "smoke-test: FAIL (gpu BUSY must attribute pkg-HIGH as burn:gpu)"; exit 1; }
    gpu_s=IDLE
    reason_str | grep -q '(burn:cpu)' || { echo "smoke-test: FAIL (gpu IDLE must attribute pkg-HIGH as burn:cpu)"; exit 1; }
    gpu_s=LIGHT
    reason_str | grep -q 'burn:' && { echo "smoke-test: FAIL (gpu LIGHT is ambiguous — must not tag)"; exit 1; }
    gpu_s=BUSY pkg_s=LOW
    reason_str | grep -q 'burn:' && { echo "smoke-test: FAIL (no pkg-HIGH → no attribution tag)"; exit 1; }
    # MEMORY axis: fresh-gate honesty (missing/fresh/stale) + the dispatched fusion assertion
    # (fresh THRASHING lifts an otherwise-cool node to ≥STRESSED; IDLE leaves it untouched).
    _md=$(mktemp -d); MESH_DIR="$_md" TEMPWATCH="$_md/.stress-tempwatch"
    [ "$(read_swap_state)" = "?" ] || { echo "smoke-test: FAIL (missing swap state must read '?')"; exit 1; }
    printf 'THRASHING|swap_pps=900|window=3s\n' > "$_md/.swap-rate.state"
    [ "$(read_swap_state)" = THRASHING ] || { echo "smoke-test: FAIL (fresh swap state must read its verdict token)"; exit 1; }
    touch -d '20 minutes ago' "$_md/.swap-rate.state"
    [ "$(read_swap_state)" = "?" ] || { echo "smoke-test: FAIL (stale THRASHING must decay to '?' — honest-fusion, a dead swap-rate cron must not fake memory pressure)"; exit 1; }
    # Fusion: pin the thermal bands unreachable so live temp cannot cloud the memory-axis assertion.
    WARM_C=900 STRESSED_C=901 CRIT_C=902
    printf 'THRASHING|swap_pps=900\n' > "$_md/.swap-rate.state"
    assess; [ "$(lvl_num "$level")" -ge 2 ] || { echo "smoke-test: FAIL (fresh THRASHING must lift level ≥STRESSED even on a cool node — the whole point of the memory axis)"; exit 1; }
    printf 'IDLE|swap_pps=1\n' > "$_md/.swap-rate.state"
    assess; [ "$level" = CALM ] || { echo "smoke-test: FAIL (IDLE swap must not raise level; a cool node stays CALM — memory axis must be additive-only, no phantom pressure)"; exit 1; }
    rm -rf "$_md"
    # ALLOSTATIC-LOAD axis: the counter (window + poster-host + marker-set filtering) and the WARM-capped
    # fusion bump. Fixture board log with a KNOWN mix so the count is deterministic; ISO ts drive the window.
    _ad=$(mktemp -d); _host=$(hostname); _alog="$_ad/chat.log"
    _recent=$(date -u -d '1 hour ago' +%FT%TZ); _old=$(date -u -d '10 hours ago' +%FT%TZ)
    {
      echo "$_recent  node-care@$_host  ::  [node-hot] $_host HOT :: temp=95C"          # in-window self intervention ✓
      echo "$_recent  stress@$_host  ::  [cpu-throttling] $_host +2 pkg throttle"       # in-window self intervention ✓
      echo "$_recent  therm@$_host  ::  [therm-cool] $_host recovered"                  # recovery — NOT counted
      echo "$_recent  stress@$_host  ::  [mesh-stress] $_host STRESSED"                 # self-marker — NOT counted (loop guard)
      echo "$_old     node-care@$_host  ::  [node-hot] $_host HOT"                       # out-of-window — NOT counted
      echo "$_recent  node-care@other-box-xyz  ::  [node-hot] other-box-xyz HOT"        # other poster host — NOT counted
      echo "$_recent  resguard@$_host  ::  [node-pressure] $_host NODE-PRESSURE: SwapFree 3MB"  # MEMORY axis, distinct marker (chat-review/node-hot-marker-axis-collision) — NOT counted here
    } > "$_alog"
    MESH_STRESS_CHATLOG="$_alog" ALLO_WINDOW_H=6
    [ "$(allostatic_load)" = 2 ] || { echo "smoke-test: FAIL (allostatic_load must count EXACTLY the 2 in-window THERMAL self interventions [node-hot]+[cpu-throttling] — excluding recovery, self-marker, out-of-window, other-host, AND resguard's [node-pressure] memory-axis line; got '$(allostatic_load)')"; exit 1; }
    MESH_STRESS_CHATLOG="$_ad/nope.log"
    [ "$(allostatic_load)" = -1 ] || { echo "smoke-test: FAIL (missing chat.log must read -1 — honest unknown, never a fake 0)"; exit 1; }
    unset MESH_STRESS_CHATLOG
    # Fusion via the REAL assess() path: pin thermal bands unreachable so live temp reads CALM, feed a log
    # with >=ALLO_HIGH self-interventions (at $_ad/chat.log, found via MESH_DIR) → assess must FLOOR at WARM
    # (watch), and NEVER exceed it (no dispatch gating). Then a sub-threshold log must leave it untouched.
    for i in $(seq 1 9); do echo "$_recent  node-care@$_host  ::  [node-hot] $_host HOT #$i"; done > "$_alog"
    MESH_DIR="$_ad" TEMPWATCH="$_ad/.tw" WARM_C=900 STRESSED_C=901 CRIT_C=902 ALLO_HIGH=8 ALLO_WINDOW_H=6
    assess
    [ "$level" = WARM ] && [ "$chronic" = yes ] || { echo "smoke-test: FAIL (chronic load ≥ALLO_HIGH must lift a cool node to WARM via assess; got level=$level chronic=$chronic)"; exit 1; }
    [ "$(lvl_num "$level")" -lt 2 ] || { echo "smoke-test: FAIL (allostatic bump is WARM-capped — must NEVER reach STRESSED / gate dispatch)"; exit 1; }
    : > "$_alog"   # empty log = 0 interventions
    assess
    [ "$chronic" = no ] || { echo "smoke-test: FAIL (sub-threshold load must NOT bump — additive-only, no phantom chronic)"; exit 1; }
    rm -rf "$_ad"
    # REACTIVE-SCOPE axis (RSM, 2026-07-24). Drives the PURE integrator over fixtures — the whole point
    # is the mechanism the allostatic counter above does NOT have: wear MOVES the boundary, and an
    # overload episode spends the CEILING so rest can never give it back.
    WARM_C=90 STRESSED_C=95 CRIT_C=98
    SCOPE_WEAR_H=5 SCOPE_HEAL_H=10 SCOPE_PERM_H=2 SCOPE_WARN=10
    _nom=$(( CRIT_C * 10 ))
    # (a) one hour in the reactive range (P=90 ≤ y < R) narrows the boundary by exactly r₂, ceiling intact
    set -- $(scope_step "$_nom" "$_nom" 92 3600)
    [ "$1" = $(( _nom - 5 )) ] && [ "$2" = "$_nom" ] || { echo "smoke-test: FAIL (RSM: 1h above P must narrow R by r₂ and leave M whole; got R=$1 M=$2)"; exit 1; }
    # (b) resting below P heals it back — and the heal is CAPPED at M, never past the nominal line
    set -- $(scope_step $(( _nom - 5 )) "$_nom" 80 3600)
    [ "$1" = "$_nom" ] || { echo "smoke-test: FAIL (RSM: rest must heal R toward M; got R=$1)"; exit 1; }
    set -- $(scope_step "$_nom" "$_nom" 80 36000)
    [ "$1" = "$_nom" ] || { echo "smoke-test: FAIL (RSM: heal must be CAPPED at M — an un-capped recovery is a decaying counter, not a reactive scope; got R=$1)"; exit 1; }
    # (c) THE SIGNATURE. y ≥ R is overload: the ceiling drops, permanently. Then ten hours of perfect
    #     rest must still leave the node BELOW its nominal boundary — this is the assertion that fails
    #     if wear is implemented as a counter that merely decays back to full.
    set -- $(scope_step "$_nom" "$_nom" 99 36000)
    _wr="$1"; _wm="$2"
    [ "$_wm" -lt "$_nom" ] || { echo "smoke-test: FAIL (RSM: overload must spend the CEILING M; got M=$_wm)"; exit 1; }
    set -- $(scope_step "$_wr" "$_wm" 70 360000)
    [ "$1" = "$_wm" ] && [ "$1" -lt "$_nom" ] || { echo "smoke-test: FAIL (RSM signature: after an overload episode, unlimited rest must NOT restore the nominal boundary — headroom is spent, not borrowed; got R=$1 M=$_wm nominal=$_nom)"; exit 1; }
    # (d) the floor: a wear axis may never invent an alarm BELOW an already-calibrated band
    set -- $(scope_step $(( STRESSED_C * 10 )) $(( STRESSED_C * 10 )) 99 360000)
    [ "$1" = $(( STRESSED_C * 10 )) ] || { echo "smoke-test: FAIL (RSM: R must floor at the calibrated STRESSED band, never below; got R=$1)"; exit 1; }
    # (e) dt=0 integrates nothing (an ad-hoc --status must not advance the wear clock per CALL)
    set -- $(scope_step "$_nom" "$_nom" 99 0)
    [ "$1" = "$_nom" ] && [ "$2" = "$_nom" ] || { echo "smoke-test: FAIL (RSM: dt=0 must be a no-op; got R=$1 M=$2)"; exit 1; }
    # (f) a DEAD thermal organ (temp=-1) must hold the state, not read as restful cooling — otherwise a
    #     broken sensor silently heals the scope back to full (the silent-fallback trap).
    _sd=$(mktemp -d); MESH_DIR="$_sd" MESH_STRESS_SCOPE_STATE="$_sd/.stress-scope"
    printf '%s %s %s\n' $(( _nom - 30 )) $(( _nom - 20 )) $(( $(date +%s) - 36000 )) > "$MESH_STRESS_SCOPE_STATE"
    scope_update -1
    [ "$scope_r" = $(( _nom - 30 )) ] || { echo "smoke-test: FAIL (RSM: temp=-1 (no organ) must HOLD the scope, never heal it; got R=$scope_r)"; exit 1; }
    # and the WARM-capped fusion: a measurably narrowed scope raises WATCH and nothing more.
    TEMPWATCH="$_sd/.tw" WARM_C=900 STRESSED_C=901 CRIT_C=902
    printf '%s %s %s\n' 8990 9000 "$(date +%s)" > "$MESH_STRESS_SCOPE_STATE"   # R 1.0C below the 902 nominal
    assess
    [ "$worn" = yes ] && [ "$level" = WARM ] || { echo "smoke-test: FAIL (lost headroom must lift a cool node to WARM; got level=$level worn=$worn)"; exit 1; }
    [ "$(lvl_num "$level")" -lt 2 ] || { echo "smoke-test: FAIL (scope bump is WARM-capped — an uncalibrated wear rate must NEVER gate dispatch)"; exit 1; }
    rm -rf "$_sd"; unset MESH_STRESS_SCOPE_STATE
    # THERMAL-REGULATORY FORESIGHT axis (mesh-therm-regime consumer, MCC link 2026-07-11): BRITTLE
    # (reserve-loss on a cool box) must lift a cool node to WARM via assess (WATCH), WARM-capped
    # (never gate dispatch). HEALTHY and a stale/absent '?' must leave it untouched (honest-degrade).
    _rd=$(mktemp -d); MESH_DIR="$_rd" TEMPWATCH="$_rd/.tw" WARM_C=900 STRESSED_C=901 CRIT_C=902
    MESH_STRESS_REGIME=BRITTLE assess
    [ "$level" = WARM ] && [ "$brittle" = yes ] || { echo "smoke-test: FAIL (regime=BRITTLE must lift a cool node to WARM via assess — the hidden reserve-loss the temp bands miss; got level=$level brittle=$brittle)"; exit 1; }
    [ "$(lvl_num "$level")" -lt 2 ] || { echo "smoke-test: FAIL (BRITTLE bump is WARM-capped — must NEVER reach STRESSED / gate dispatch on an advisory precursor)"; exit 1; }
    MESH_STRESS_REGIME=HEALTHY assess
    [ "$brittle" = no ] || { echo "smoke-test: FAIL (regime=HEALTHY must NOT bump — additive-only, no phantom foresight pressure)"; exit 1; }
    MESH_STRESS_REGIME='?' assess
    [ "$brittle" = no ] || { echo "smoke-test: FAIL (stale/absent regime '?' must NOT bump — honest-degrade, a dead therm-regime must not fake foresight)"; exit 1; }
    rm -rf "$_rd"
    # OPERATOR-CHANNEL axis (voice-rx-functional-blindspot, 2026-07-28): the INBOUND channel health that
    # was ZERO signal before today. Two directions: (1) the freshness read of a REAL .voice-rx-state file
    # (fresh OK vs an mtime-aged file → STALE — the wedged-poller case) and (2) the assess() fusion
    # (fresh ERR:* / STALE lift a cool node to STRESSED; OK and absent '?' leave it untouched). Break
    # either arm and this goes RED. Note the STALE arm exercises the actual find -mmin path, NOT injection.
    _vd=$(mktemp -d); MESH_DIR="$_vd"
    [ "$(read_voice_rx_state)" = "?" ] || { echo "smoke-test: FAIL (absent .voice-rx-state must read '?' — a node with no operator channel gives NO signal, never a fake alarm)"; exit 1; }
    printf 'OK\t2026-07-28T00:00:00Z\n' > "$_vd/.voice-rx-state"
    [ "$(read_voice_rx_state)" = OK ] || { echo "smoke-test: FAIL (fresh .voice-rx-state must read its status token OK)"; exit 1; }
    printf 'ERR:dns\t2026-07-28T00:00:00Z\n' > "$_vd/.voice-rx-state"
    [ "$(read_voice_rx_state)" = "ERR:dns" ] || { echo "smoke-test: FAIL (fresh ERR must read the full status token ERR:dns — the 2026-07-25 DEAF class)"; exit 1; }
    touch -d '20 minutes ago' "$_vd/.voice-rx-state"
    [ "$(read_voice_rx_state)" = STALE ] || { echo "smoke-test: FAIL (mtime-aged .voice-rx-state must read STALE — a wedged/dead poller freezes mtime; this is the liveness half of the axis)"; exit 1; }
    # Fusion via the REAL assess() path — pin thermal bands unreachable so live temp reads CALM.
    TEMPWATCH="$_vd/.tw" WARM_C=900 STRESSED_C=901 CRIT_C=902
    MESH_STRESS_VOICE_RX=ERR:dns assess
    [ "$level" = STRESSED ] || { echo "smoke-test: FAIL (fresh voice-rx ERR:dns must lift a cool node to STRESSED — the operator channel is impaired; got level=$level)"; exit 1; }
    reason_str | grep -q 'operator-channel=ERR:dns' || { echo "smoke-test: FAIL (a voice-rx ERR must be NAMED in the reason string, not silently folded into the level)"; exit 1; }
    MESH_STRESS_VOICE_RX=STALE assess
    [ "$level" = STRESSED ] || { echo "smoke-test: FAIL (STALE voice-rx (wedged poller) must lift a cool node to STRESSED; got level=$level)"; exit 1; }
    MESH_STRESS_VOICE_RX=OK assess
    [ "$level" = CALM ] || { echo "smoke-test: FAIL (voice-rx OK must leave a cool node CALM — the channel is up, no phantom pressure; got level=$level)"; exit 1; }
    MESH_STRESS_VOICE_RX='?' assess
    [ "$level" = CALM ] || { echo "smoke-test: FAIL (absent voice-rx '?' must NOT escalate — honest-fusion, no writer = no signal, never a faked all-clear NOR a faked alarm; got level=$level)"; exit 1; }
    rm -rf "$_vd"
    echo "smoke-test: ok (level=$level; hysteresis+worse+post_tier+track_temp+pkg-lead+gpu-attr+mem-axis+allostatic-load+reactive-scope(RSM: wear narrows R, overload spends M, rest cannot restore it, floored at the calibrated band, dt=0 and dead-organ hold)+regime-foresight+operator-channel(voice-rx: fresh ERR/STALE→STRESSED, OK/absent→no-bump; STALE via real mtime read) dry-runs verified)"; exit 0
    ;;
  --probe)
    # Refresh the remote sibling state LIVE (heat cost: 1 SSH + 1 curl) before reading the fusion.
    command -v mesh-router-watch  >/dev/null 2>&1 && mesh-router-watch  >/dev/null 2>&1 || true
    command -v mesh-egress-health >/dev/null 2>&1 && mesh-egress-health >/dev/null 2>&1 || true
    command -v mesh-therm-watch   >/dev/null 2>&1 && mesh-therm-watch   >/dev/null 2>&1 || true
    command -v mesh-therm-regime  >/dev/null 2>&1 && timeout 4 mesh-therm-regime >/dev/null 2>&1 || true  # refresh .therm-regime.state (foresight axis)
    assess
    printf 'mesh-stress: %s — %s  | %s\n' "$level" "$(reason_str)" "$(advice)"
    [ "$(lvl_num "$level")" -ge 2 ] && exit 1 || exit 0
    ;;
  --json)
    assess
    printf '{"level":"%s","level_num":%s,"temp_c":%s,"load_norm":%s,"minds":%s,"climbing":"%s","decoupled":"%s","therm_state":"%s","router_state":"%s","egress_state":"%s","voice_rx_state":"%s","pkg_state":"%s","pkg_leading":"%s","gpu_state":"%s","swap_state":"%s","allostatic_load":%s,"allostatic_window_h":%s,"chronic":"%s","regime_state":"%s","brittle":"%s","warm_c":%s,"warm_band":"%s","curve_p50":%s,"curve_max":%s,"curve_n":%s}\n' \
      "$level" "$(lvl_num "$level")" "$temp" "$load_norm" "$minds" "$climbing" "$decoupled" "$therm_s" "$router_s" "$egress_s" "${voicerx_s:-?}" "$pkg_s" "${leading:-no}" "${gpu_s:-?}" "${swap_s:-?}" "${allo_n:--1}" "$ALLO_WINDOW_H" "${chronic:-no}" "${regime_s:-?}" "${brittle:-no}" "$WARM_C" "$BAND_SRC" "$CURVE_P50" "$CURVE_MAX" "$CURVE_N"
    [ "$(lvl_num "$level")" -ge 2 ] && exit 1 || exit 0
    ;;
  --check)
    assess
    [ "$(lvl_num "$level")" -ge 2 ] && { echo "$level — $(reason_str)"; exit 1; }
    exit 0
    ;;
  --alert)
    # Keep the foresight axis LIVE on the */5 reflex cadence: refresh .therm-regime.state (the on-demand
    # fusion has no cron of its own; this consumer's reflex IS its heartbeat) so the many cheap cached
    # consumers below read fresh. Guarded + timeout'd; a failure just decays the axis to "?" in assess.
    command -v mesh-therm-regime >/dev/null 2>&1 && timeout 4 mesh-therm-regime >/dev/null 2>&1 || true
    assess
    prev=$(cat "$STATE" 2>/dev/null || echo CALM)
    cur=$(effective_level "$level" "$prev" "$temp")   # hysteresis: kills boundary dither-spam
    mkdir -p "$MESH_DIR"; echo "$cur" > "$STATE"       # write EVERY run → mtime stays fresh (liveness for
    # fresh-gated consumers: mesh-algedonic STALE_S, mesh-reflex-health). Content is idempotent when
    # unchanged; the board POST below still gates on prev!=cur so there is NO new board spam.
    if [ "$prev" != "$cur" ]; then
      # Tier the edge (post_tier above). The board (mesh-chat) is the COORDINATION tier —
      # reserved for the shed-NOW alarm (escalation into CRITICAL). Routine STRESSED-flap
      # and recoveries go to the durable TRACE tier so chronic thermal noise stops drowning
      # coordination. A hysteretic de-escalation (e.g. CRIT→STRESSED) walks one band/run and
      # stays elevated (no post); the recovery edge fires once when it clears STRESSED.
      case "$(post_tier "$cur" "$prev")" in
        board)
          command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="stress@$(hostname)" \
            mesh-chat "[mesh-stress] $(hostname) $cur — $(reason_str) → $(advice)" >/dev/null 2>&1 ;;
        trace)
          command -v mesh-trace >/dev/null 2>&1 && MESH_WHO="stress@$(hostname)" \
            mesh-trace "[stress] $(hostname) $cur — $(reason_str)" >/dev/null 2>&1 ;;
      esac
    fi
    [ "$(lvl_num "$cur")" -ge 2 ] && exit 1 || exit 0
    ;;
  ""|--status)
    assess
    printf 'mesh-stress: %s — %s  | %s\n' "$level" "$(reason_str)" "$(advice)"
    [ "$(lvl_num "$level")" -ge 2 ] && exit 1 || exit 0
    ;;
  *)
    echo "usage: mesh-stress [--status|--json|--check|--alert|--probe|--test]" >&2; exit 2
    ;;
esac
