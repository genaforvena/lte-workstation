#!/usr/bin/env bash
# mesh-observer-effect — ask, AS A CLASS, the question we have so far rediscovered one incident at a
# time: DOES RUNNING A SENSE MOVE A QUANTITY THAT SENSE REPORTS?
#
#   mesh-observer-effect [--tool <name>]   probe one subject (default: every DECLARED subject)
#   mesh-observer-effect --sweep           the scheduled pass (cron form; bounded + resumable)
#   mesh-observer-effect --census          list subjects and their declaration state, run nothing
#   mesh-observer-effect --json            machine-readable rows
#   mesh-observer-effect --test            smoke test (hermetic scratch HOME; red AND green fixtures)
#
# EXIT: RC IS ABOUT THE RUN, NEVER ABOUT THE FINDING. 0 the pass completed (whatever it found) ·
#       2 no subject declared a probe · 3 another sweep already running (skipped) · 4 truncated at
#       the wall-clock bound (a PARTIAL pass — never read it as a clean one; the summary carries
#       swept=n/N). The finding lives in the ledger, the summary and the board post. Set
#       MESH_OE_FINDING_RC=1 to opt a caller back into `1 = contamination found`.
#
# WHY THIS EXISTS. The named instances are already six-plus and every one was found by hand, in
# isolation, after it had already lied: a `--test` that writes the very liveness log a human reads
# (mesh-test-forgery, which covers exactly that ONE narrow case and nothing else); a probe that mints
# the uevents it then counts as device churn; reading mesh-light incrementing its own change counter;
# a census whose top talker is the observer itself; a cmdline-substring probe that counts its own
# reader; a self-source grep that always matches its own line and therefore can never fail. They are
# ONE shape. This is the instrument for the shape.
#
# ── THE CONTROL ARM IS THE WHOLE DESIGN, NOT AN EXTRA ────────────────────────────────────────────
# Running a sense twice and diffing its output measures NOTHING. Drift is the null hypothesis: on
# this node ~150 durable quantities move on their own every ten minutes, so "it changed after I ran
# it" is the expected reading for a clean sense. Every subject therefore gets TWO windows of equal
# length, and the arithmetic is the difference between them:
#
#     A = read ─────[ CONTROL: window W, ZERO extra runs ]───── B = read
#     B = read ─────[ TREATMENT: window W, K extra runs  ]───── C = read
#
# Each arm is bounded by exactly two reads, so the contamination of the BOUNDARY reads is common-mode
# and cancels; the only asymmetry between the arms is the K extra runs. Hence
#
# and the estimator is NOT "excess over drift, divided by K". That was the first version and it was
# WRONG, caught by this tool's own red fixture reading 0.996 units/read where the truth was exactly
# 1. The reason is worth keeping: THE CONTROL ARM'S OWN DELTA IS PART CONTAMINATION. Read A is a
# read, so d_ctrl already carries one read's worth of it, and taking d_ctrl/elapsed as pure "drift"
# then subtracts that contamination back out of the treatment arm. Write the model down instead:
#
#     Q(t) = drift·t + c·(reads so far)
#     d_ctrl  = drift·el_c + 1·c              ← the closing read B
#     d_treat = drift·el_t + (K+1)·c          ← the K treatment runs AND the closing read C
#
# Two equations, two unknowns. With r = el_t/el_c,
#
#     c = ( d_treat − r·d_ctrl ) / ( K + 1 − r )      ← units moved PER READ, exact
#
# The K+1−r denominator is the whole correction; K alone biases every verdict toward `accumulator`,
# i.e. toward declaring a contaminated sense innocent, which is the direction that must never be
# taken by accident. Elapsed times are MEASURED, not assumed equal, so a slow subject whose K runs
# genuinely lengthen the treatment window is not billed for the extra drift it really did accrue.
#
# The windows are normalised by their MEASURED elapsed time rather than assumed equal, because a slow
# subject's K runs make the treatment window genuinely longer and an unnormalised comparison would
# then bill ordinary drift as contamination. Both elapsed values are published in every row.
#
# ── THE SECOND ARM: A LEVEL OFFSET IS INVISIBLE TO A DELTA ───────────────────────────────────────
# Half the named class is NOT a per-read increment. "A census whose top talker is the observer" and
# "a cmdline-substring probe that counts its own reader" are CONSTANT offsets: the sense counts +1
# for itself on every single read, so its delta across runs is ZERO and the arm above is structurally
# blind to it. That blindness is not acceptable, so the second arm asks the identity question
# directly, WITHOUT running extra copies of a possibly-expensive or side-effecting sense:
#
#     SOLO      = read                                    (nothing else alive)
#     SELF      = read while J decoys wear the SUBJECT'S OWN NAME in their argv   (exec -a)
#     NEUTRAL   = read while J decoys wear an UNRELATED name                       (exec -a)
#
# A sense that counts processes by a name matching itself reads J higher under SELF than under
# NEUTRAL. The NEUTRAL arm is the control: it carries the same process count and the same scheduler
# load, so anything that moves in BOTH arms is load, not identity, and is reported as such. A decoy
# is a `sleep`, never a copy of the subject — the arm must not be more dangerous than the fault.
#
# ── THE TWO FAILURE DIRECTIONS, BOTH OF WHICH MUST BE LOUD ───────────────────────────────────────
#  1. TOO EXPENSIVE TO RUN TWICE. A BLE scan, a camera grab, a phone round-trip. Such a subject must
#     self-exclude LOUDLY — verdict `na` with the measured cost and the budget it blew — and NEVER
#     pass quietly as clean. The cost is MEASURED by one timed run, not guessed from the name.
#  2. A QUANTITY THAT LEGITIMATELY MOVES ON EVERY READ. A monotonic accumulator (a byte counter, an
#     uptime, a clock) moves because TIME passed, not because it was read — and it moves in the
#     CONTROL arm too, which is exactly how the two are told apart. It gets its own word,
#     `accumulator`, and is never rendered as contamination.
#
# ── WHAT `na` MEANS AND WHY IT IS NOT `clean` ────────────────────────────────────────────────────
# A subject that declared no probe, blew the cost budget, failed to run, or emitted no comparable
# numeric key is counted as `na` with its reason, in its own column. It is NEVER folded into the
# clean count and never omitted from the census — a subject that vanishes from a report reads as a
# subject that passed. Coverage travels with every summary: swept=n/N, and per subject the number of
# keys compared against the number the read produced.
#
# ── THE POLARITY OF THE SUBJECT GATE, AND WHY IT IS AN ALLOWLIST HERE ────────────────────────────
# A subject is probed only if it DECLARES a pure-read invocation in its own header:
#
#     # observer-probe: <argv that performs a READ and nothing else>
#     # observer-probe: skip <why>          ← declared unprobeable; still a census row, never silent
#
# This is the subject declaring its own discipline, and the unlisted case fails LOUD as an `na` row
# in a census that publishes its own denominator — not toward silence. The polarity matters for a
# reason that is not stylistic: this category holds `mesh-say`, `mesh-act`, `mesh-tg-roz` and
# `mesh-cam-watch`. An exclusion denylist that had merely never heard of an actuator would drive it
# K+1 times, and the failure would be a message actually sent.
#
# ── THIS TOOL MUST NOT BE THE THING IT DETECTS ───────────────────────────────────────────────────
# It never probes itself. Its `--test` diverts the durable ledger to a scratch file and then ASSERTS
# the production ledger's size is unchanged — an observer-contamination detector that contaminated
# its own record would be the joke writing itself. And note the standing reflexive cost, stated
# rather than hidden: probing a subject RUNS it, so this instrument perturbs whatever it measures.
# That is inherent to the question and is the reason every verdict here is a statement about a
# DIFFERENCE BETWEEN TWO ARMS and never about an absolute reading.
#
# reflex-cadence: 17 5 * * *
# reflex-args: --sweep
# reflex-state: ~/.mesh/observer-effect-verdicts.log

set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"

MESH="$HOME/.mesh"
LEDGER="$MESH/observer-effect-verdicts.log"     # the DURABLE verdict tape a human reads
LOCKFILE="$MESH/.observer-effect.lock"
CURSOR="$MESH/.observer-effect.cursor"
SELF_NAME="mesh-observer-effect"

WINDOW="${MESH_OE_WINDOW:-20}"            # seconds per arm
RUNS="${MESH_OE_RUNS:-4}"                 # K extra runs in the treatment window
MIN_PER_READ="${MESH_OE_MIN_PER_READ:-1.0}"   # units/read below which we refuse to attribute
COST_BUDGET="${MESH_OE_COST_BUDGET:-15}"  # seconds; a slower subject self-excludes LOUDLY
DECOYS="${MESH_OE_DECOYS:-3}"             # J decoys for the name-census arm
WALL_BOUND="${MESH_OE_WALL_BOUND:-2400}"  # whole-sweep wall clock; overrun => exit 4, PARTIAL
BOARD="${MESH_OE_BOARD:-1}"
REPLICATE="${MESH_OE_REPLICATE:-1}"       # confirm a CONTAMINATED call on a SECOND independent pair
SWEEP_DEADLINE=""                         # set by do_sweep; probe_one skips replication it cannot fit
# The one name every --test fixture wears. The forgery gate greps the ledger's APPENDED region for
# it, so the gate's predicate and the fixtures share ONE definition and cannot drift apart.
FIXTURE_MARK="mesh-oe-"

MODE=one; ONE_TOOL=""; JSON=0
ORIG_ARGS=("$@")
while [ $# -gt 0 ]; do
  case "$1" in
    --tool) ONE_TOOL="${2:-}"; shift 2 ;;
    --sweep) MODE=sweep; shift ;;
    --census) MODE=census; shift ;;
    --json) JSON=1; shift ;;
    --window) WINDOW="${2:-}"; shift 2 ;;
    --runs) RUNS="${2:-}"; shift 2 ;;
    --min-per-read) MIN_PER_READ="${2:-}"; shift 2 ;;
    --test) MODE=test; shift ;;
    -h|--help) sed -n '2,12p' "$0"; exit 0 ;;
    *) echo "unknown arg: $1" >&2; exit 64 ;;
  esac
done
[ -n "$ONE_TOOL" ] && MODE=one
[ "$MODE" = one ] && [ -z "$ONE_TOOL" ] && MODE=sweep

_self_path() { local p="$0"; case "$p" in /*) ;; *) p="$PWD/$p" ;; esac; echo "$p"; }
_now() { date -u +%Y-%m-%dT%H:%M:%SZ; }
_epoch_ms() { date +%s%3N; }

# ── SUBJECT DISCOVERY ────────────────────────────────────────────────────────────────────────────
# Every mesh-* on PATH is a census candidate; only a DECLARED one is probed. Read the declaration
# from the script's own header, and read it by GRAMMAR (the first `# observer-probe:` line), never
# by a loose grep for the string anywhere in the file — this file itself is full of that string.
_declared_probe() {
  local f="$1"
  [ -r "$f" ] || return 1
  head -c 8192 "$f" 2>/dev/null | grep -m1 -E '^# observer-probe:[[:space:]]*' | sed -E 's/^# observer-probe:[[:space:]]*//'
}

_subjects() {
  # Walk PATH, not one hardcoded dir: `command -v` is what actually resolves a subject, so the
  # census denominator must be built from the same resolution order or it undercounts silently.
  local d p b
  for d in ${PATH//:/ }; do
    [ -d "$d" ] || continue
    for p in "$d"/mesh-*; do
      [ -f "$p" ] && [ -x "$p" ] || continue
      b="$(basename "$p")"
      [ "$b" = "$SELF_NAME" ] && continue        # never probe itself
      echo "$b"
    done
  done | sort -u
}

# ── NUMERIC EXTRACTION ───────────────────────────────────────────────────────────────────────────
# Parse BY POSITION, not by name alone: a repeated key is kept as key#N so two occurrences of
# `dropped=` cannot collapse onto one row and net each other out. Handles `k=v` and `k: v`.
_parse_nums() {
  awk '
    function emit(k, v) { cnt[k]++; printf "%s#%d\t%s\n", k, cnt[k], v }
    {
      line = $0
      s = line
      while (match(s, /[A-Za-z][A-Za-z0-9_.:-]*=[-+]?[0-9]+(\.[0-9]+)?/)) {
        tok = substr(s, RSTART, RLENGTH)
        eq = index(tok, "=")
        emit(substr(tok, 1, eq-1), substr(tok, eq+1))
        s = substr(s, RSTART + RLENGTH)
      }
      if (match(line, /^[[:space:]]*[A-Za-z][A-Za-z0-9_ .-]*:[[:space:]]*[-+]?[0-9]+(\.[0-9]+)?[[:space:]]*$/)) {
        c = index(line, ":")
        k = substr(line, 1, c-1); gsub(/^[[:space:]]+|[[:space:]]+$/, "", k); gsub(/[[:space:]]+/, "_", k)
        v = substr(line, c+1);    gsub(/^[[:space:]]+|[[:space:]]+$/, "", v)
        emit(k, v)
      }
    }
  '
}

# Run a declared probe once, bounded. stdout+stderr are the reading. Returns rc of the probe.
_run_probe() {
  local argv="$1"
  timeout -k 5 "$COST_BUDGET" bash -c "$argv" 2>&1
}

# ── THE ARITHMETIC ───────────────────────────────────────────────────────────────────────────────
# Three readings + two measured elapsed times + K -> one verdict word per key. Kept in python3 for
# honest float math; a key absent from ANY of the three reads is `na`, never silently dropped.
_verdict() {
  python3 - "$1" "$2" "$3" "$4" "$5" "$6" "$7" <<'PY'
import sys
fa, fb, fc, el_c, el_t, K, minpr = sys.argv[1:8]
el_c, el_t, K, minpr = float(el_c), float(el_t), float(K), float(minpr)

def load(p):
    d = {}
    try:
        for line in open(p):
            if '\t' not in line: continue
            k, v = line.rstrip('\n').split('\t', 1)
            try: d[k] = float(v)
            except ValueError: pass
    except OSError: pass
    return d

A, B, C = load(fa), load(fb), load(fc)
keys_seen = set(A) | set(B) | set(C)
common = sorted(set(A) & set(B) & set(C))
rows, counts = [], {}
for k in common:
    d_ctrl  = B[k] - A[k]
    d_treat = C[k] - B[k]
    # Solve drift and per-read contamination jointly; see the model in the header. The denominator
    # is K+1-r because the CLOSING READ of each arm is itself a read.
    r        = (el_t / el_c) if el_c > 0 else 1.0
    denom    = (K + 1.0) - r
    per_read = ((d_treat - r * d_ctrl) / denom) if abs(denom) > 1e-9 else 0.0
    excess   = per_read * K

    if d_ctrl == 0 and d_treat == 0:
        w = 'clean'
    elif abs(per_read) >= minpr and abs(excess) > abs(d_ctrl):
        w = 'contaminated'
    elif d_ctrl != 0 and d_treat != 0 and (d_ctrl > 0) == (d_treat > 0) and abs(per_read) < minpr:
        w = 'accumulator'
    else:
        w = 'drift'
    counts[w] = counts.get(w, 0) + 1
    rows.append((w, k, d_ctrl, d_treat, per_read, el_c, el_t))

na_keys = len(keys_seen) - len(common)
if   counts.get('contaminated'): subject = 'CONTAMINATED'
elif counts.get('drift'):        subject = 'UNATTRIBUTABLE'
elif counts.get('accumulator'):  subject = 'ACCUMULATOR'
elif counts.get('clean'):        subject = 'CLEAN'
else:                            subject = 'NA'

print("SUBJECT\t%s\t%d\t%d\t%d\t%d\t%d\t%d" % (
    subject, len(common), len(keys_seen), na_keys,
    counts.get('contaminated',0), counts.get('accumulator',0), counts.get('drift',0)))
for w, k, dc, dt, pr, ec, et in sorted(rows, key=lambda r: {'contaminated':0,'drift':1,'accumulator':2,'clean':3}[r[0]]):
    if w == 'clean':
        # A static key is the majority, so it gets a COMPACT one-field row instead of a KEY row:
        # the `^KEY` consumers (the report flattening, the confirm arm's candidate scan) never see
        # it as evidence — but the confirm arm CAN still tell "static on pair 2" (strong refutation)
        # apart from "absent on pair 2" (genuinely unmeasurable).
        print("STATIC\t%s" % k)
        continue
    print("KEY\t%s\t%s\td_ctrl=%g\td_treat=%g\tper_read=%.3g\telapsed=%.1f/%.1fs" % (w, k, dc, dt, pr, ec, et))
PY
}

# ── ARM 2: THE NAME-CENSUS PROBE ─────────────────────────────────────────────────────────────────
# J decoys wearing the subject's own name vs J wearing an unrelated one. Never a copy of the subject.
_decoys_up() {
  local tag="$1" n="$2" i
  DECOY_PIDS=()
  for i in $(seq 1 "$n"); do
    bash -c "exec -a '$tag' sleep 120" >/dev/null 2>&1 &
    DECOY_PIDS+=("$!")
  done
  # BLOCK ON THE HANDSHAKE, never on a sleep: assert the decoys are actually alive and wearing the
  # name before reading, or the arm silently measures nothing and reports it as a negative.
  local waited=0 alive
  while [ "$waited" -lt 30 ]; do
    alive=0
    for i in "${DECOY_PIDS[@]}"; do kill -0 "$i" 2>/dev/null && alive=$((alive+1)); done
    [ "$alive" -eq "$n" ] && return 0
    waited=$((waited+1)); sleep 0.1
  done
  return 1
}
_decoys_down() {
  local i
  for i in ${DECOY_PIDS[@]+"${DECOY_PIDS[@]}"}; do kill "$i" 2>/dev/null; done
  wait ${DECOY_PIDS[@]+"${DECOY_PIDS[@]}"} 2>/dev/null
  DECOY_PIDS=()
}

# ── ONE name-arm pass ──────────────────────────────────────────────────────────────────────────
# Solo + neutral/self/neutral reads under a tag. Echoes a verdict-shaped block: a KEY row (with
# the ident carried as per_read=) per key whose drift-cancelled identity excess clears J*0.75,
# a STATIC row per key that sat still. The shape is deliberate: _confirm_arm reads it unchanged,
# so the identity claim replicates on a second independent pass with NO new constant — the pass-2
# bar is the same J*0.75, and the verdict is the SIGN it holds. On decoy failure prints the reason
# and returns nonzero. READ ORDER IS THE CONTROL HERE, AND IT MUST BE BALANCED (see below).
_name_pass() {
  local argv="$1" name="$2" tmp="$3" tag="$4"
  # This arm used to read solo, self, neutral and score (self-solo)-(neutral-solo) — an expression
  # identically equal to self-neutral, so the solo read contributed NOTHING and what remained was
  # the difference between two CONSECUTIVE reads. Any quantity that moves per read landed in it
  # whole and was attributed to the decoys' NAMES: measured 2026-08-30, the mesh-oe-flip fixture,
  # which counts no processes at all, was called `self-counting: v#1 ident=+10`. So the neutral
  # condition is read TWICE, on either side of the self read, and the self read is compared against
  # their MIDPOINT — which is the drift-expected value at the self read's own position, so a
  # constant per-read drift cancels exactly instead of being renamed as identity. And one pass is
  # ONE observation of a noisy difference: balancing the read order cancels systematic drift, but
  # nothing about VARIANCE — measured on a live sweep, mesh-net-io's bursty byte counters came back
  # SELF-COUNTING on idents of -159, +2094 and -940 against sleeping decoys that emit no traffic,
  # with the signs disagreeing between keys of the same quantity. So a candidate replicates on a
  # second independent pass and must hold its SIGN there, exactly as the delta arm's candidates do.
  _run_probe "$argv" | _parse_nums > "$tmp/na_solo$tag" 2>/dev/null

  if ! _decoys_up "oe-neutral-decoy" "$DECOYS"; then
    _decoys_down; printf 'neutral-decoys-would-not-start\n'; return 1
  fi
  _run_probe "$argv" | _parse_nums > "$tmp/na_neu1$tag" 2>/dev/null
  _decoys_down

  if ! _decoys_up "$name --observer-effect-decoy" "$DECOYS"; then
    _decoys_down; printf 'decoys-would-not-start\n'; return 1
  fi
  _run_probe "$argv" | _parse_nums > "$tmp/na_self$tag" 2>/dev/null
  _decoys_down

  if ! _decoys_up "oe-neutral-decoy" "$DECOYS"; then
    _decoys_down; printf 'neutral-decoys-would-not-start\n'; return 1
  fi
  _run_probe "$argv" | _parse_nums > "$tmp/na_neu2$tag" 2>/dev/null
  _decoys_down

  python3 - "$tmp/na_neu1$tag" "$tmp/na_self$tag" "$tmp/na_neu2$tag" "$DECOYS" <<'PY'
import sys
def load(p):
    d = {}
    try:
        for line in open(p):
            if '\t' not in line: continue
            k, v = line.rstrip('\n').split('\t', 1)
            try: d[k] = float(v)
            except ValueError: pass
    except OSError: pass
    return d
neu1, slf, neu2 = load(sys.argv[1]), load(sys.argv[2]), load(sys.argv[3])
J = float(sys.argv[4])
thr = J * 0.75
common = set(neu1) & set(slf) & set(neu2)
for k in sorted(common):
    # IDENTITY EXCESS, drift-cancelled. The self read sits BETWEEN the two neutral reads, so the
    # neutral midpoint is what this key would have read at that position under drift alone. What is
    # left over is the part that depends on the decoys wearing the subject's OWN NAME — which is
    # the only thing this arm is entitled to claim.
    ident = slf[k] - (neu1[k] + neu2[k]) / 2.0
    if abs(ident) >= thr:
        print("KEY\tcontaminated\t%s\tident=%+g\tper_read=%g\tJ=%g" % (k, ident, ident, J))
    else:
        print("STATIC\t%s" % k)
PY
}

# Squeeze a verdict-shaped block's KEY rows onto one tab-free line for the probe_one row.
_name_hits_flat() {
  grep '^KEY' | cut -f3- | tr '\t' ' ' | paste -sd';' - | cut -c1-300
}

_name_census_arm() {
  # echoes: "<word>\t<detail>"  — self-counting | clean | unconfirmed | na:<reason>
  local argv="$1" name="$2" tmp="$3" out1
  if ! out1="$(_name_pass "$argv" "$name" "$tmp" 1)"; then
    printf 'na\t%s\n' "$out1"; return
  fi
  if [ -z "$out1" ]; then
    printf 'na\tno-comparable-key\n'; return
  fi
  if ! printf '%s\n' "$out1" | grep -q '^KEY'; then
    local nkeys; nkeys="$(printf '%s\n' "$out1" | grep -c '^STATIC')"
    printf 'clean\t%d key(s) unmoved by %s self-named decoys\n' "$nkeys" "$DECOYS"; return
  fi
  # A candidate on ONE pass is variance until it agrees with itself twice. Replicate on a second
  # independent pass and confirm on the SIGN via the shared _confirm_arm — the bar is the same
  # J*0.75 the first pass used, so no new constant is minted. Unreplicated renders UNCONFIRMED,
  # never self-counting: SELF-COUNTING is the verdict this tool exists to issue, so an over-call
  # there is worse than an over-call anywhere else.
  local thr; thr="$(awk -v j="$DECOYS" 'BEGIN{printf "%g", j*0.75}')"
  local hits1; hits1="$(printf '%s\n' "$out1" | _name_hits_flat)"
  if [ "$REPLICATE" != "1" ]; then
    printf 'unconfirmed\tself-count candidate NOT confirmed: replication disabled (MESH_OE_REPLICATE=0): %s\n' "$hits1"; return
  fi
  if ! _replication_fits; then
    printf 'unconfirmed\tself-count candidate NOT confirmed: does not fit the sweep wall bound: %s\n' "$hits1"; return
  fi
  local out2
  if ! out2="$(_name_pass "$argv" "$name" "$tmp" 2)"; then
    printf 'na\t%s\n' "$out2"; return
  fi
  printf '%s\n' "$out1" > "$tmp/na_pass1"
  printf '%s\n' "$out2" > "$tmp/na_pass2"
  local cline cword cdetail
  cline="$(_confirm_arm "$tmp/na_pass1" "$tmp/na_pass2" "$thr")"
  cword="$(printf '%s' "$cline" | cut -f1)"; cdetail="$(printf '%s' "$cline" | cut -f2-)"
  case "$cword" in
    confirmed) printf 'self-counting\theld: %s\n' "$cdetail" ;;
    *)         printf 'unconfirmed\tNOT confirmed on pair 2: %s\n' "$cdetail" ;;
  esac
}

# ── PROBE ONE SUBJECT ────────────────────────────────────────────────────────────────────────────
# ── THE FORGERY PREDICATE (ATTRIBUTION, NOT LEVEL) ───────────────────────────────────────────────
# Given the ledger's size BEFORE a run, decide whether THIS process forged a row in it. Reads only
# the region appended past that offset and looks for the fixture name only --test can produce, so a
# legitimate concurrent writer (this tool's own cron sweep, which overlaps --test by construction on
# a wired node) is named as another writer rather than accused. A SHRUNK tape cannot be attributed
# at all and says so — an arm that cannot measure must never report the clean answer.
#   echoes: forged:<n> | grown:<bytes> | untouched | unattributable:shrank
_ledger_forgery_verdict() {
  local before="$1" path="$2" after appended n
  after="$(stat -c %s "$path" 2>/dev/null || echo 0)"
  if [ "$after" -lt "$before" ]; then printf 'unattributable:shrank\n'; return; fi
  appended="$(tail -c "+$((before + 1))" "$path" 2>/dev/null)"
  n="$(printf '%s\n' "$appended" | grep -c "$FIXTURE_MARK" 2>/dev/null)"
  if [ "${n:-0}" -gt 0 ]; then printf 'forged:%s\n' "$n"
  elif [ "$after" != "$before" ]; then printf 'grown:%s\n' "$((after - before))"
  else printf 'untouched\n'; fi
}

# ── ONE (control, treatment) PAIR ────────────────────────────────────────────────────────────────
# Writes A<tag> B<tag> C<tag> under $tmp and echoes the two MEASURED elapsed times. Factored out so
# a candidate can be replicated on a second, independent pair without duplicating the sequence.
_delta_pass() {
  local argv="$1" tmp="$2" tag="$3" ta tb tc i step
  ta=$(_epoch_ms); _run_probe "$argv" | _parse_nums > "$tmp/A$tag"
  sleep "$WINDOW"                                     # CONTROL: zero extra runs
  tb=$(_epoch_ms); _run_probe "$argv" | _parse_nums > "$tmp/B$tag"
  step=$(awk -v w="$WINDOW" -v k="$RUNS" 'BEGIN{printf "%.2f", w/k}')
  for i in $(seq 1 "$RUNS"); do                       # TREATMENT: K extra runs
    sleep "$step"; _run_probe "$argv" >/dev/null 2>&1
  done
  tc=$(_epoch_ms); _run_probe "$argv" | _parse_nums > "$tmp/C$tag"
  awk -v a="$ta" -v b="$tb" -v c="$tc" 'BEGIN{printf "%.2f %.2f", (b-a)/1000, (c-b)/1000}'
}

# Can a second pair still finish inside the sweep's own wall bound? Outside a sweep there is no
# deadline and the answer is yes. A replication that would be TRUNCATED must not be started: a
# half-run pair would be read as a sign flip, i.e. the wall bound would silently manufacture
# acquittals. Skipping renders UNCONFIRMED, which is the honest word for "not measured".
_replication_fits() {
  [ -z "$SWEEP_DEADLINE" ] && return 0
  local need; need=$(awk -v w="$WINDOW" 'BEGIN{printf "%d", 2*w + 30}')
  [ "$(( $(date +%s) + need ))" -le "$SWEEP_DEADLINE" ]
}

# ── THE CONFIRM ARM ──────────────────────────────────────────────────────────────────────────────
# Reads two _verdict outputs (or two name-pass outputs — both are KEY rows carrying a per_read=
# token plus STATIC rows for the clean keys). A key called `contaminated` in pass 1 is CONFIRMED
# only if pass 2 saw the SAME SIGN on that key's per_read and still cleared the threshold. Sign,
# not magnitude: a magnitude rule would be a second constant, and it is the SIGN that carries the
# mechanism. A candidate that is STATIC on pair 2 is REFUTED (it sat still — the strongest
# acquittal this arm can produce); one that is ABSENT on pair 2 is UNMEASURABLE (the key the
# second pass cannot see at all, e.g. mesh-drop-stages d#4). The two cases get their own words
# because conflating them reads a genuine hole in the measurement as a refutation.
_confirm_arm() {
  python3 - "$1" "$2" "$MIN_PER_READ" <<'PY_CONFIRM'
import sys
p1, p2, minpr = sys.argv[1], sys.argv[2], float(sys.argv[3])

def keys(path):
    out, static = {}, set()
    try:
        for line in open(path):
            f = line.rstrip('\n').split('\t')
            if not f: continue
            if f[0] == 'STATIC' and len(f) >= 2:
                static.add(f[1]); continue
            if f[0] != 'KEY' or len(f) < 6: continue
            word, key = f[1], f[2]
            pr = None
            for tok in f[3:]:
                if tok.startswith('per_read='):
                    try: pr = float(tok.split('=', 1)[1])
                    except ValueError: pr = None
            out[key] = (word, pr)
    except OSError: pass
    return out, static

a, _sa = keys(p1)
b, sb = keys(p2)
cand = [k for k, (w, pr) in a.items() if w == 'contaminated' and pr is not None]
if not cand:
    print("unconfirmed\tno candidate key carried a per_read to replicate"); raise SystemExit

conf, flip, refuted, gone = [], [], [], []
for k in sorted(cand):
    pr1 = a[k][1]
    if k not in b or b[k][1] is None:
        if k in sb:
            refuted.append("%s(static on pair 2)" % k)
        else:
            gone.append("%s(absent in pair 2)" % k)
        continue
    pr2 = b[k][1]
    if (pr1 > 0) == (pr2 > 0) and abs(pr2) >= minpr:
        conf.append("%s(%+.3g then %+.3g)" % (k, pr1, pr2))
    else:
        flip.append("%s(%+.3g then %+.3g)" % (k, pr1, pr2))

detail = []
if conf: detail.append("held: " + "; ".join(conf[:4]))
if flip: detail.append("flipped/faded: " + "; ".join(flip[:4]))
if refuted: detail.append("refuted-static: " + "; ".join(refuted[:3]))
if gone: detail.append("unmeasurable: " + "; ".join(gone[:3]))
print(("confirmed" if conf else "unconfirmed") + "\t" + " | ".join(detail))
PY_CONFIRM
}

probe_one() {
  local name="$1"
  # SELF-REFUSAL ON THE REAL PATH, not merely an omission from the subject walk. The omission alone
  # was a VACUOUS gate — proved by mutation: deleting it changed no output, because the census only
  # ever prints DECLARED subjects and this tool declares nothing. And it declares nothing only by
  # luck: its own --test fixtures write `# observer-probe:` lines at column 0 inside heredocs, and
  # the only thing keeping them out of the header parse is that they sit past the bounded scan. A
  # detector that probed itself would be measuring its own perturbation and calling it the world's.
  if [ "$name" = "$SELF_NAME" ]; then
    printf '%s\tNA\tself-refused: the observer never probes itself\t-\t-\n' "$name"; return 0
  fi
  local path; path="$(command -v "$name" 2>/dev/null)"
  local argv=""
  [ -n "$path" ] && argv="$(_declared_probe "$path")"

  if [ -z "$argv" ]; then
    printf '%s\tNA\tundeclared\t-\t-\n' "$name"; return 0
  fi
  case "$argv" in
    skip\ *|skip) printf '%s\tNA\tdeclared-skip: %s\t-\t-\n' "$name" "${argv#skip }"; return 0 ;;
  esac

  local tmp; tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' RETURN

  # COST GATE — MEASURED, never guessed from the name. A subject that blows the budget self-excludes
  # LOUDLY as na and is never billed as clean.
  local t0 t1 cost rc
  t0=$(_epoch_ms); _run_probe "$argv" > "$tmp/probe0" 2>&1; rc=$?; t1=$(_epoch_ms)
  cost=$(awk -v a="$t0" -v b="$t1" 'BEGIN{printf "%.2f", (b-a)/1000}')
  if [ "$rc" -ne 0 ]; then
    printf '%s\tNA\tprobe-rc=%d cost=%ss\t-\t-\n' "$name" "$rc" "$cost"; return 0
  fi
  if awk -v c="$cost" -v b="$COST_BUDGET" 'BEGIN{exit !(c > b/2)}'; then
    printf '%s\tNA\ttoo-expensive: one read cost %ss, budget %ss (K+3 reads would cost ~%ss)\t-\t-\n' \
      "$name" "$cost" "$COST_BUDGET" "$(awk -v c="$cost" -v k="$RUNS" 'BEGIN{printf "%.0f", c*(k+3)}')"
    return 0
  fi

  # ── ARM 1: control window, then treatment window ──
  local el_c el_t
  read -r el_c el_t <<<"$(_delta_pass "$argv" "$tmp" 1)"

  local out; out="$(_verdict "$tmp/A1" "$tmp/B1" "$tmp/C1" "$el_c" "$el_t" "$RUNS" "$MIN_PER_READ")"
  local sline; sline="$(printf '%s\n' "$out" | grep -m1 '^SUBJECT')"
  local verdict cmp seen nak nc nacc nd
  IFS=$'\t' read -r _ verdict cmp seen nak nc nacc nd <<<"$sline"

  # ── ARM 1b: REPLICATION. One pair is ONE observation of a noisy difference, so a large |per_read|
  # is exactly what a drifting quantity produces by chance — the first live pass called 4 subjects
  # CONTAMINATED on a NEGATIVE per_read over monotone byte counters, where "each read subtracts"
  # has no mechanism. A real per-read effect keeps its SIGN across an independent pair; noise flips
  # it about half the time. So a candidate is CONFIRMED by sign, not by clearing a bigger constant —
  # no new threshold is minted. An unreplicated candidate gets its OWN word, UNCONFIRMED: it is
  # never folded into CONTAMINATED (which would keep the over-call) and never into clean.
  local repl="n/a"
  if [ "$verdict" = "CONTAMINATED" ]; then
    if [ "$REPLICATE" != "1" ]; then
      repl="skipped: replication disabled (MESH_OE_REPLICATE=0)"; verdict="UNCONFIRMED"
    elif ! _replication_fits; then
      repl="skipped: does not fit the sweep wall bound"; verdict="UNCONFIRMED"
    else
      local el_c2 el_t2 out2 cline cword cdetail
      read -r el_c2 el_t2 <<<"$(_delta_pass "$argv" "$tmp" 2)"
      out2="$(_verdict "$tmp/A2" "$tmp/B2" "$tmp/C2" "$el_c2" "$el_t2" "$RUNS" "$MIN_PER_READ")"
      printf '%s\n' "$out"  > "$tmp/pass1"
      printf '%s\n' "$out2" > "$tmp/pass2"
      cline="$(_confirm_arm "$tmp/pass1" "$tmp/pass2")"
      cword="$(printf '%s' "$cline" | cut -f1)"; cdetail="$(printf '%s' "$cline" | cut -f2-)"
      case "$cword" in
        confirmed)   repl="confirmed on pair 2: $cdetail" ;;
        *)           repl="NOT confirmed on pair 2: $cdetail"; verdict="UNCONFIRMED" ;;
      esac
    fi
  fi

  # ── ARM 2: the name-census / self-count probe ──
  local narm nword ndetail
  narm="$(_name_census_arm "$argv" "$name" "$tmp")"
  nword="$(printf '%s' "$narm" | cut -f1)"; ndetail="$(printf '%s' "$narm" | cut -f2-)"
  if [ "$nword" = "self-counting" ]; then
    case "$verdict" in CONTAMINATED) ;; *) verdict="SELF-COUNTING" ;; esac
  elif [ "$nword" = "unconfirmed" ]; then
    # A name-arm candidate that did not hold its sign on the second pass is a candidate, not a
    # finding — same word as the delta arm's. A CONFIRMED delta finding stands: the arms make
    # different claims, and one arm's unreplicated candidate does not acquit the other's proof.
    case "$verdict" in CONTAMINATED) ;; *) verdict="UNCONFIRMED" ;; esac
  fi

  # Flatten the per-key detail onto ONE line with tabs squeezed out: this row is itself
  # tab-delimited, so an embedded tab or newline would truncate the field at the first one and the
  # evidence behind the verdict would silently vanish from the report.
  local keyrows; keyrows="$(printf '%s\n' "$out" | grep '^KEY' | head -6 \
      | sed 's/^KEY\t//' | tr '\t' ' ' | paste -sd '|' - | sed 's/|/ | /g')"
  printf '%s\t%s\tkeys=%s/%s na_keys=%s contaminated=%s accumulator=%s drift=%s cost=%ss window=%s/%ss K=%s | replication=%s | name-arm=%s: %s\t%s\t%s\n' \
    "$name" "$verdict" "$cmp" "$seen" "$nak" "$nc" "$nacc" "$nd" "$cost" "$el_c" "$el_t" "$RUNS" \
    "$repl" "$nword" "$ndetail" "$keyrows" "$argv"
  return 0
}

# ── CENSUS (declaration state only; runs nothing) ────────────────────────────────────────────────
do_census() {
  local n_all=0 n_dec=0 n_skip=0 name path argv
  while read -r name; do
    [ -z "$name" ] && continue
    n_all=$((n_all+1))
    path="$(command -v "$name" 2>/dev/null)"; argv=""
    [ -n "$path" ] && argv="$(_declared_probe "$path")"
    if [ -z "$argv" ]; then
      continue
    elif case "$argv" in skip*) true ;; *) false ;; esac; then
      n_skip=$((n_skip+1)); printf '  %-26s declared-skip: %s\n' "$name" "${argv#skip }"
    else
      n_dec=$((n_dec+1)); printf '  %-26s probe: %s\n' "$name" "$argv"
    fi
  done < <(_subjects)
  printf 'observer-effect census: declared=%d declared-skip=%d undeclared=%d of %d mesh-* on PATH\n' \
    "$n_dec" "$n_skip" "$((n_all - n_dec - n_skip))" "$n_all"
  printf 'coverage: %d/%d probeable — the remainder are na, NEVER clean.\n' "$n_dec" "$n_all"
  [ "$n_dec" -eq 0 ] && return 2
  return 0
}

# ── THE SWEEP ────────────────────────────────────────────────────────────────────────────────────
do_sweep() {
  local started; started=$(date +%s)
  SWEEP_DEADLINE=$(( started + WALL_BOUND ))   # probe_one declines a replication it cannot fit
  local subjects=() name
  if [ -n "$ONE_TOOL" ]; then
    subjects=("$ONE_TOOL")
  else
    while read -r name; do
      [ -z "$name" ] && continue
      local p a; p="$(command -v "$name" 2>/dev/null)"; a=""
      [ -n "$p" ] && a="$(_declared_probe "$p")"
      [ -n "$a" ] && subjects+=("$name")
    done < <(_subjects)
  fi

  if [ "${#subjects[@]}" -eq 0 ]; then
    echo "observer-effect: NO SUBJECT DECLARES a '# observer-probe:' header — nothing was measured."
    echo "  This is na, not clean. Declare one on a sense and re-run; see --census."
    return 2
  fi

  # THE DENOMINATOR IS THE WHOLE POPULATION, NOT THE DECLARED SUBSET. `swept=11/11` reads as full
  # coverage; it is 11 of 713. An undeclared sense is na — untested — and folding it out of the
  # summary makes the report say the opposite of what it knows.
  local n_pop; n_pop="$(_subjects | wc -l)"
  local n_undeclared=$(( n_pop - ${#subjects[@]} ))
  [ -n "$ONE_TOOL" ] && n_undeclared=0 && n_pop=1
  local n_cont=0 n_self=0 n_acc=0 n_clean=0 n_unattr=0 n_na=0 n_unconf=0 swept=0 truncated=0
  local rows=() row
  for name in "${subjects[@]}"; do
    if [ $(( $(date +%s) - started )) -ge "$WALL_BOUND" ]; then truncated=1; break; fi
    row="$(probe_one "$name")"
    rows+=("$row")
    swept=$((swept+1))
    case "$(printf '%s' "$row" | cut -f2)" in
      CONTAMINATED)   n_cont=$((n_cont+1)) ;;
      UNCONFIRMED)    n_unconf=$((n_unconf+1)) ;;
      SELF-COUNTING)  n_self=$((n_self+1)) ;;
      ACCUMULATOR)    n_acc=$((n_acc+1)) ;;
      UNATTRIBUTABLE) n_unattr=$((n_unattr+1)) ;;
      CLEAN)          n_clean=$((n_clean+1)) ;;
      *)              n_na=$((n_na+1)) ;;
    esac
    printf '%s\n' "$name" > "$CURSOR" 2>/dev/null   # per-subject, never once at the end of the pass
  done

  local ts; ts="$(_now)"
  local summary
  summary="observer-effect: swept=${swept}/${#subjects[@]} declared=${#subjects[@]}/${n_pop} contaminated=${n_cont} unconfirmed=${n_unconf} self-counting=${n_self} accumulator=${n_acc} clean=${n_clean} unattributable=${n_unattr} na=$(( n_na + n_undeclared )) (of which undeclared=${n_undeclared}) window=${WINDOW}s K=${RUNS} min-per-read=${MIN_PER_READ} replicate=${REPLICATE}"
  [ "$truncated" -eq 1 ] && summary="$summary PARTIAL(wall-bound ${WALL_BOUND}s — NOT a clean pass)"

  if [ "$JSON" -eq 1 ]; then
    printf '{"ts":"%s","swept":%d,"subjects":%d,"contaminated":%d,"unconfirmed":%d,"self_counting":%d,"accumulator":%d,"clean":%d,"unattributable":%d,"na":%d,"partial":%s,"rows":[' \
      "$ts" "$swept" "${#subjects[@]}" "$n_cont" "$n_unconf" "$n_self" "$n_acc" "$n_clean" "$n_unattr" "$n_na" \
      "$([ "$truncated" -eq 1 ] && echo true || echo false)"
    local first=1
    for row in ${rows[@]+"${rows[@]}"}; do
      local rn rv rd
      rn="$(printf '%s' "$row" | cut -f1)"; rv="$(printf '%s' "$row" | cut -f2)"; rd="$(printf '%s' "$row" | cut -f3)"
      [ "$first" -eq 1 ] || printf ','; first=0
      printf '{"subject":"%s","verdict":"%s","detail":"%s"}' "$rn" "$rv" "$(printf '%s' "$rd" | sed 's/"/\\"/g')"
    done
    printf ']}\n'
  else
    for row in ${rows[@]+"${rows[@]}"}; do
      printf '%-26s %-15s %s\n' "$(printf '%s' "$row" | cut -f1)" "$(printf '%s' "$row" | cut -f2)" "$(printf '%s' "$row" | cut -f3)"
      local kr; kr="$(printf '%s' "$row" | cut -f4)"
      [ -n "$kr" ] && printf '    %s\n' "$kr"
    done
    echo "$summary"
  fi

  # DURABLE TAPE — the RUN row is written unconditionally, carrying this attempt's own health, so a
  # silence in the ledger is departure and never a quiet clean pass.
  mkdir -p "$MESH" 2>/dev/null
  { printf '%s RUN %s\n' "$ts" "$summary"
    for row in ${rows[@]+"${rows[@]}"}; do
      printf '%s VERDICT %s %s :: %s\n' "$ts" "$(printf '%s' "$row" | cut -f1)" \
        "$(printf '%s' "$row" | cut -f2)" "$(printf '%s' "$row" | cut -f3)"
    done
  } >> "$LEDGER" 2>/dev/null

  if [ "$BOARD" = 1 ] && [ $((n_cont + n_self)) -gt 0 ] && command -v mesh-chat >/dev/null 2>&1; then
    local shown; shown="$(for row in ${rows[@]+"${rows[@]}"}; do
      case "$(printf '%s' "$row" | cut -f2)" in CONTAMINATED|SELF-COUNTING)
        printf '%s(%s) ' "$(printf '%s' "$row" | cut -f1)" "$(printf '%s' "$row" | cut -f2)" ;; esac
    done)"
    mesh-chat "[fyi] observer-effect: $((n_cont + n_self)) sense(s) move a quantity they report when RUN — ${shown}— measured against a CONTROL window of equal length in which the sense was not run, so ordinary drift is subtracted rather than assumed away. na=${n_na} could not be tested and are NOT counted clean, and unconfirmed=${n_unconf} moved a quantity on ONE pair but did not hold their SIGN on a second independent pair — those are candidates, not findings. Tape: $LEDGER" >/dev/null 2>&1
  fi

  # EXIT CODE IS ABOUT THE RUN, NEVER ABOUT THE FINDING. This used to `return 1` whenever anything
  # was contaminated, and every scheduler on this node reads a non-zero rc as "the tool broke":
  # measured 2026-08-30, mesh-cron-catchup logged `outcome=failed rc=1 ... alerted=FAILED ... slot
  # CLOSED, a hand is the only re-runner` for a sweep that ran perfectly and FOUND something. A
  # detector whose success is exit 1 is permanently broken to the thing that launches it, and the
  # alert it raises names the wrong fault. The finding rides the ledger, the summary and the board;
  # rc carries only whether the pass completed. A caller that genuinely wants the yes/no in the rc
  # opts in with MESH_OE_FINDING_RC=1.
  [ "$truncated" -eq 1 ] && return 4          # NOT a complete pass — an honest run failure
  if [ "${MESH_OE_FINDING_RC:-0}" = "1" ] && [ $((n_cont + n_self)) -gt 0 ]; then return 1; fi
  return 0
}

# ── SELF TEST ────────────────────────────────────────────────────────────────────────────────────
do_test() {
  local fails=0 d real_before
  d="$(mktemp -d)"; trap 'rm -rf "$d"' RETURN
  real_before="$(stat -c %s "$LEDGER" 2>/dev/null || echo 0)"
  mkdir -p "$d/.mesh" "$d/bin"
  ok()  { printf '  ok   %s\n' "$1"; }
  bad() { printf '  FAIL %s\n' "$1"; fails=$((fails+1)); }

  # --- RED fixture: a sense whose counter increments on every read (the mesh-light shape) ---
  cat > "$d/bin/mesh-oe-red" <<'EOS'
#!/usr/bin/env bash
# observer-probe: mesh-oe-red
f="${OE_RED_STATE:-$HOME/.mesh/.oe-red}"
n=$(cat "$f" 2>/dev/null || echo 0); n=$((n+1)); echo "$n" > "$f"
echo "red: reads=$n static=7"
EOS
  # --- GREEN fixture: nothing moves at all ---
  cat > "$d/bin/mesh-oe-green" <<'EOS'
#!/usr/bin/env bash
# observer-probe: mesh-oe-green
echo "green: static=7 also=42"
EOS
  # --- ACCUMULATOR fixture: moves with TIME, not with reads ---
  cat > "$d/bin/mesh-oe-acc" <<'EOS'
#!/usr/bin/env bash
# observer-probe: mesh-oe-acc
echo "acc: elapsed=$(date +%s) static=7"
EOS
  # --- EXPENSIVE fixture: must self-exclude LOUDLY as na ---
  cat > "$d/bin/mesh-oe-slow" <<'EOS'
#!/usr/bin/env bash
# observer-probe: mesh-oe-slow
sleep 3; echo "slow: v=1"
EOS
  # --- SELF-COUNTING fixture: counts processes whose argv carries its own name ---
  cat > "$d/bin/mesh-oe-census" <<'EOS'
#!/usr/bin/env bash
# observer-probe: mesh-oe-census
n=$(ps -eo args= 2>/dev/null | grep -c 'mesh-oe-census')
echo "census: procs=$n static=7"
EOS
  # --- SIGN-FLIP fixture: a candidate on pair 1 whose effect REVERSES on pair 2 ---
  # This is the noise case in deterministic clothing. Pair 1 spans reads 2..8 and sees a positive
  # per-read effect; pair 2 spans 9..15 and sees the negative one. Nothing about the magnitude
  # changes — only the SIGN — so it separates a real mechanism from a number that merely moved.
  cat > "$d/bin/mesh-oe-flip" <<'EOS'
#!/usr/bin/env bash
# observer-probe: mesh-oe-flip
f="${OE_FLIP_STATE:-$HOME/.oe-flip}"
n=$(cat "$f" 2>/dev/null || echo 0); n=$((n+1)); echo "$n" > "$f"
if [ "$n" -le 8 ]; then echo "flip: v=$((100 + n*10))"; else echo "flip: v=$((100 - n*10))"; fi
EOS
  # --- NAME-VARIANCE fixture: a bursty byte counter whose name-arm ident is pure variance ---
  # Deterministic lookup over the read index n (probe0=1, pair1=2..8, pair2=9..15, name
  # passes=16..23). Pair 1 sees a large NEGATIVE per_read (a CONTAMINATED candidate by chance),
  # pair 2 a large POSITIVE one (sign flip); name pass 1 sees ident=+5000 (a self-count candidate
  # by chance), pass 2 sees the key STATIC (strong refutation). Neither arm may call it a finding.
  cat > "$d/bin/mesh-oe-namevar" <<'EOS'
#!/usr/bin/env bash
# observer-probe: mesh-oe-namevar
f="${OE_NAMEVAR_STATE:-$HOME/.oe-namevar}"
n=$(cat "$f" 2>/dev/null || echo 0); n=$((n+1)); echo "$n" > "$f"
case "$n" in
  3) v=100 ;; 8) v=-100 ;; 15) v=50 ;; 18) v=5000 ;;
  *) v=0 ;;
esac
echo "var: bytes=$v static=7"
EOS
  # --- FREEZE fixture: a candidate on pair 1 that sits STATIC on pair 2 (strong refutation) ---
  cat > "$d/bin/mesh-oe-freeze" <<'EOS'
#!/usr/bin/env bash
# observer-probe: mesh-oe-freeze
f="${OE_FREEZE_STATE:-$HOME/.oe-freeze}"
n=$(cat "$f" 2>/dev/null || echo 0); n=$((n+1)); echo "$n" > "$f"
if [ "$n" -le 8 ]; then v=$((n*10)); else v=80; fi
echo "frz: level=$v static=7"
EOS
  # --- VANISH fixture: a candidate on pair 1 whose key is ABSENT on pair 2 (unmeasurable) ---
  # The mesh-drop-stages d#4 shape: _confirm_arm must not call this a refutation.
  cat > "$d/bin/mesh-oe-vanish" <<'EOS'
#!/usr/bin/env bash
# observer-probe: mesh-oe-vanish
f="${OE_VANISH_STATE:-$HOME/.oe-vanish}"
n=$(cat "$f" 2>/dev/null || echo 0); n=$((n+1)); echo "$n" > "$f"
if [ "$n" -le 8 ]; then echo "van: gone=$((n*10)) static=7"; else echo "van: static=7"; fi
EOS
  # --- UNDECLARED fixture: must be na, never clean ---
  cat > "$d/bin/mesh-oe-mute" <<'EOS'
#!/usr/bin/env bash
echo "mute: v=1"
EOS
  chmod +x "$d/bin"/mesh-oe-*

  run() {
    local tool="$1"; shift
    env HOME="$d" PATH="$d/bin:$PATH" \
        MESH_OE_WINDOW=2 MESH_OE_RUNS=4 MESH_OE_COST_BUDGET=4 MESH_OE_DECOYS=3 MESH_OE_BOARD=0 \
        OE_RED_STATE="$d/.mesh/.oe-red" \
        bash "$(_self_path)" --tool "$tool" "$@" 2>&1
  }

  local out
  out="$(run mesh-oe-red)"
  case "$out" in *CONTAMINATED*) ok "red fixture (counter moves per READ) -> CONTAMINATED" ;;
                 *) bad "red fixture not CONTAMINATED: $out" ;; esac
  case "$out" in *per_read=1*) ok "red fixture reports per_read=1 (the units-per-read number)" ;;
                 *) bad "red fixture did not report per_read=1: $out" ;; esac

  out="$(run mesh-oe-green)"
  case "$out" in *CLEAN*) ok "green fixture -> CLEAN" ;; *) bad "green fixture not CLEAN: $out" ;; esac

  out="$(run mesh-oe-acc)"
  case "$out" in *ACCUMULATOR*) ok "accumulator (moves with TIME) gets its OWN word, not contamination" ;;
                 *) bad "accumulator misworded: $out" ;; esac
  case "$out" in *CONTAMINATED*) bad "accumulator billed as CONTAMINATED: $out" ;;
                 *) ok "accumulator is not billed as contamination" ;; esac

  out="$(run mesh-oe-slow)"
  case "$out" in *NA*too-expensive*) ok "expensive subject self-excludes LOUDLY as na with its cost" ;;
                 *) bad "expensive subject did not self-exclude loudly: $out" ;; esac
  case "$out" in *CLEAN*) bad "expensive subject passed as CLEAN — the exact forbidden direction: $out" ;;
                 *) ok "expensive subject is NOT counted clean" ;; esac

  out="$(run mesh-oe-census)"
  case "$out" in *SELF-COUNTING*|*name-arm=self-counting*) ok "self-counting fixture caught by the NAME arm (delta arm is blind to it)" ;;
                 *) bad "self-counting fixture missed: $out" ;; esac

  # ── REPLICATION: a candidate must hold its SIGN on an independent pair ──────────────────────
  out="$(run mesh-oe-flip)"
  case "$out" in *UNCONFIRMED*) ok "sign-flipping candidate -> UNCONFIRMED, not CONTAMINATED" ;;
                 *) bad "sign-flipping candidate not UNCONFIRMED: $out" ;; esac
  case "$out" in *CONTAMINATED*) bad "sign-flipping candidate billed as CONTAMINATED — the over-call this arm exists to stop: $out" ;;
                 *) ok "sign-flipping candidate is not billed as contamination" ;; esac
  case "$out" in *CLEAN*) bad "sign-flipping candidate passed as CLEAN: $out" ;;
                 *) ok "sign-flipping candidate is not clean either — it is a candidate, and says so" ;; esac
  case "$out" in *"NOT confirmed on pair 2"*) ok "the row NAMES why it was not confirmed (sign, on pair 2)" ;;
                 *) bad "row does not say why replication failed: $out" ;; esac
  # THE NAME ARM'S OWN CONTROL. mesh-oe-flip moves on EVERY read and counts no process anywhere, so
  # any identity claim about it is drift wearing the decoys' name. Before the read order was
  # balanced this fixture came back `self-counting: v#1 ident=+10 (J=3)`.
  case "$out" in *"name-arm=clean"*) ok "name arm is NOT fooled by a per-read drifting subject (its control is real)" ;;
                 *) bad "name arm claimed identity on a subject that counts nothing: $out" ;; esac
  case "$out" in *SELF-COUNTING*) bad "a drifting subject was verdicted SELF-COUNTING: $out" ;;
                 *) ok "a drifting subject is not verdicted SELF-COUNTING" ;; esac

  out="$(run mesh-oe-red)"
  case "$out" in *"replication=confirmed"*) ok "a REAL per-read effect holds its sign and is confirmed" ;;
                 *) bad "red fixture was not confirmed on pair 2: $out" ;; esac

  # ── THE NAME ARM'S NOISE TERM: a bursty quantity must agree with itself twice ──────────────
  # mesh-oe-namevar's name-arm ident is pure variance (+5000 on pass 1 by chance, STATIC on pass
  # 2). Before this arm replicated, a single J*0.75 point estimate called live mesh-net-io byte
  # counters SELF-COUNTING on idents of -159/+2094/-940 against sleeping decoys. Mutation gate:
  # delete the second pass and this fixture comes back SELF-COUNTING.
  out="$(run mesh-oe-namevar)"
  case "$out" in *SELF-COUNTING*) bad "variance on a bursty counter verdicted SELF-COUNTING: $out" ;;
                 *) ok "a bursty quantity whose ident is pure variance is NOT verdicted SELF-COUNTING" ;; esac
  case "$out" in *UNCONFIRMED*) ok "the variance fixture is a candidate (UNCONFIRMED), not a finding" ;;
                 *) bad "variance fixture did not render UNCONFIRMED: $out" ;; esac
  case "$out" in *"name-arm=unconfirmed"*) ok "the NAME arm replicated and refused to confirm on one pass" ;;
                 *) bad "the name arm did not replicate the variance fixture: $out" ;; esac
  # ...while the TRUE census still replicates and holds its sign on both passes.
  out="$(run mesh-oe-census)"
  case "$out" in *"name-arm=self-counting"*held:*) ok "a REAL identity effect holds its sign and replicates" ;;
                 *) bad "census fixture was not confirmed on pair 2: $out" ;; esac

  # ── STATIC vs ABSENT on pair 2 get their own words ─────────────────────────────────────────
  # mesh-oe-freeze's candidate sits STATIC on pair 2 (strong refutation); mesh-oe-vanish's key is
  # ABSENT there (the mesh-drop-stages d#4 shape — genuinely unmeasurable). Before _verdict emitted
  # STATIC rows both read as one 'unmeasurable'. Mutation gate: drop the STATIC rows and the freeze
  # fixture can no longer be told apart from the vanish one.
  out="$(run mesh-oe-freeze)"
  case "$out" in *UNCONFIRMED*refuted-static*) ok "a candidate STATIC on pair 2 is refuted, by name" ;;
                 *) bad "frozen candidate did not render UNCONFIRMED/refuted-static: $out" ;; esac
  out="$(run mesh-oe-vanish)"
  case "$out" in *UNCONFIRMED*unmeasurable*) ok "a candidate ABSENT on pair 2 is unmeasurable, by name" ;;
                 *) bad "vanished candidate did not render UNCONFIRMED/unmeasurable: $out" ;; esac

  # An UNREPLICATED candidate must never wear CONTAMINATED: not measured is not proven.
  out="$(env HOME="$d" PATH="$d/bin:$PATH" MESH_OE_WINDOW=2 MESH_OE_RUNS=4 MESH_OE_COST_BUDGET=4              MESH_OE_DECOYS=3 MESH_OE_BOARD=0 MESH_OE_REPLICATE=0 OE_RED_STATE="$d/.mesh/.oe-red"              bash "$(_self_path)" --tool mesh-oe-red 2>&1)"
  case "$out" in *UNCONFIRMED*) ok "replication disabled -> UNCONFIRMED, never a bare CONTAMINATED" ;;
                 *) bad "unreplicated candidate did not render UNCONFIRMED: $out" ;; esac

  # ── RC IS ABOUT THE RUN ─────────────────────────────────────────────────────────────────────
  # A completed pass exits 0 whatever it found. cron-catchup read the old `1 = found` as a FAILED
  # fire and closed the slot saying a hand was the only re-runner.
  env HOME="$d" PATH="$d/bin:$PATH" MESH_OE_WINDOW=2 MESH_OE_RUNS=4 MESH_OE_COST_BUDGET=4       MESH_OE_DECOYS=3 MESH_OE_BOARD=0 OE_RED_STATE="$d/.mesh/.oe-red"       bash "$(_self_path)" --tool mesh-oe-red >/dev/null 2>&1
  case "$?" in 0) ok "a COMPLETED pass that FOUND contamination still exits 0 (rc is the run, not the finding)" ;;
               *) bad "a completed pass exited non-zero merely because it found something" ;; esac
  env HOME="$d" PATH="$d/bin:$PATH" MESH_OE_WINDOW=2 MESH_OE_RUNS=4 MESH_OE_COST_BUDGET=4       MESH_OE_DECOYS=3 MESH_OE_BOARD=0 MESH_OE_FINDING_RC=1 OE_RED_STATE="$d/.mesh/.oe-red"       bash "$(_self_path)" --tool mesh-oe-red >/dev/null 2>&1
  case "$?" in 1) ok "MESH_OE_FINDING_RC=1 opts a caller back into rc=1 on a finding" ;;
               *) bad "the opt-in finding rc did not fire" ;; esac

  out="$(run mesh-oe-mute)"
  case "$out" in *NA*undeclared*) ok "undeclared subject -> na with reason" ;;
                 *) bad "undeclared subject not na: $out" ;; esac
  case "$out" in *CLEAN*) bad "undeclared subject counted CLEAN: $out" ;; *) ok "undeclared is not clean" ;; esac

  # census publishes its own denominator
  out="$(env HOME="$d" PATH="$d/bin:$PATH" MESH_OE_BOARD=0 bash "$(_self_path)" --census 2>&1)"
  case "$out" in *"coverage:"*"NEVER clean"*) ok "census publishes coverage and says na is never clean" ;;
                 *) bad "census lacks coverage line: $out" ;; esac

  # the sweep summary must carry na in its OWN column
  out="$(env HOME="$d" PATH="$d/bin:$PATH" MESH_OE_WINDOW=2 MESH_OE_RUNS=2 MESH_OE_COST_BUDGET=4 \
             MESH_OE_BOARD=0 OE_RED_STATE="$d/.mesh/.oe-red" bash "$(_self_path)" --sweep 2>&1)"
  case "$out" in *na=*) ok "sweep summary carries na= as its own column" ;; *) bad "sweep summary has no na= column: $out" ;; esac
  case "$out" in *swept=*) ok "sweep summary carries swept=n/N coverage" ;; *) bad "no swept=n/N: $out" ;; esac
  # the denominator must be the WHOLE population, not the declared subset: an undeclared sense is
  # untested, and a summary that omits it claims a coverage it does not have.
  case "$out" in *undeclared=*) ok "sweep summary counts UNDECLARED senses into na, with its own term" ;;
                 *) bad "sweep summary hides the undeclared population: $out" ;; esac
  case "$out" in *declared=*/*) ok "sweep summary publishes declared/population coverage" ;;
                 *) bad "no declared=n/N coverage: $out" ;; esac
  case "$out" in *unconfirmed=*) ok "sweep summary carries unconfirmed= as its own column" ;;
                 *) bad "sweep summary folds unconfirmed candidates away: $out" ;; esac

  # THE DETECTOR MUST NOT BE THE THING IT DETECTS: the production ledger must carry no row THIS
  # TEST wrote. The predicate used to be the ledger's SIZE either side of the run, and that is a
  # LEVEL, not an attribution — it cannot tell a forging test from a legitimate concurrent writer.
  # Measured 2026-08-30: mesh-cron-catchup fired the missed 05:17 daily slot MID-TEST, a real sweep
  # appended 2569 bytes, and this arm accused the test of forging its own record. The sweep takes
  # ~5min and this test ~6min on a node where both are cron-wired, so that false red is routine
  # rather than a race. It also failed toward SILENCE at the other end: a forged row plus an equal
  # rotation reads as untouched. So attribute instead — read only the bytes appended past the
  # opening offset and look for the fixture names only this test can produce.
  local fv; fv="$(_ledger_forgery_verdict "$real_before" "$LEDGER")"
  case "$fv" in
    untouched)  ok "--test did NOT write the durable ledger it exists to keep honest" ;;
    grown:*)    ok "--test wrote no fixture row to the durable ledger (it grew by ${fv#grown:} B from ANOTHER writer — attribution, not level, is the predicate)" ;;
    forged:*)   bad "--test wrote ${fv#forged:} fixture row(s) into the production ledger — it forged its own record" ;;
    *)          bad "--test could not attribute whether it forged a row: $fv — re-run" ;;
  esac

  # THE PREDICATE ITSELF, driven over all four of its outcomes on a scratch tape. The arm above can
  # only ever exercise whichever one this run happened to land in; without these it is one live
  # branch and three untested ones.
  local lp="$d/forgery-tape"
  printf 'a row that was already on the tape before the run\n' > "$lp"
  local base; base="$(stat -c %s "$lp")"   # MUST be non-zero, or the shrink case cannot be posed
  case "$(_ledger_forgery_verdict "$base" "$lp")" in untouched) ok "forgery predicate: an untouched tape is untouched" ;;
    *) bad "forgery predicate called an untouched tape $(_ledger_forgery_verdict "$base" "$lp")" ;; esac
  printf '%s RUN observer-effect: swept=1/1 contaminated=0\n' "$(_now)" >> "$lp"
  case "$(_ledger_forgery_verdict "$base" "$lp")" in grown:*) ok "forgery predicate: ANOTHER writer's row is growth, not forgery" ;;
    *) bad "forgery predicate accused another writer's row: $(_ledger_forgery_verdict "$base" "$lp")" ;; esac
  printf '%s VERDICT %sred CONTAMINATED :: keys=1/1\n' "$(_now)" "$FIXTURE_MARK" >> "$lp"
  case "$(_ledger_forgery_verdict "$base" "$lp")" in forged:*) ok "forgery predicate: a FIXTURE row in the appended region is forgery" ;;
    *) bad "forgery predicate missed a fixture row: $(_ledger_forgery_verdict "$base" "$lp")" ;; esac
  : > "$lp"
  case "$(_ledger_forgery_verdict "$base" "$lp")" in unattributable:*) ok "forgery predicate: a SHRUNK tape is unattributable, never clean" ;;
    *) bad "forgery predicate read a shrunk tape as $(_ledger_forgery_verdict "$base" "$lp")" ;; esac

  # It must never probe itself — asserted on the REAL path (ask it to, by name, and watch it
  # refuse), never by the absence of a name from a listing that omits every undeclared tool anyway.
  out="$(run "$SELF_NAME")"
  case "$out" in *self-refused*) ok "the tool REFUSES to probe itself when asked by name" ;;
                 *) bad "the tool did not self-refuse: $out" ;; esac
  case "$out" in *CLEAN*|*CONTAMINATED*|*ACCUMULATOR*) bad "the tool actually probed itself: $out" ;;
                 *) ok "self-refusal yields no verdict about itself" ;; esac

  if [ "$fails" -eq 0 ]; then echo "mesh-observer-effect --test: PASS"; return 0; fi
  echo "mesh-observer-effect --test: FAIL ($fails)"; return 1
}

case "$MODE" in
  test)   do_test; exit $? ;;
  census) do_census; exit $? ;;
esac

# One sweep at a time: the cadence CAN land on top of a live run, and two sweeps probing the same
# subject would each be the other's contamination.
if [ -z "${MESH_OE_LOCKED:-}" ] && command -v flock >/dev/null 2>&1; then
  export MESH_OE_LOCKED=1
  mkdir -p "$MESH" 2>/dev/null
  flock -n -o -E 3 "$LOCKFILE" bash "$(_self_path)" ${ORIG_ARGS[@]+"${ORIG_ARGS[@]}"}
  exit $?
fi

do_sweep; exit $?
