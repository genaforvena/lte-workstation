#!/usr/bin/env bash
# mesh-tg-update — push the operator a CONCISE "what changed" Telegram update, on change only.
# Operator 2026-06-13: "I need to receive updates on what changed." A REFLEX (not a mind) so it
# never goes stale on a rate-limited/blocked mind — cron-polled, marker-deduped, SILENT when nothing
# new. Sources are zero-inference (git + board), same as mesh-since/mesh-digest.
#
#   mesh-tg-update            send an update IF something changed since the last send; else silent
#   mesh-tg-update --force    send the current window even if already reported (manual "what's up")
#   mesh-tg-update --dry      print what WOULD be sent, don't send, don't advance the marker
#   mesh-tg-update --test     smoke: deps + a real dry render, no send
#
# Marker: ~/.mesh/.tg-update-marker (last-reported ISO ts). First run looks back 30m.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
M="$HOME/.mesh"; REPO="$HOME/lte-workstation"; MARK="$M/.tg-update-marker"

if [ "${1:-}" = --test ]; then
  for x in git grep awk date sed; do command -v "$x" >/dev/null 2>&1 || { echo "smoke-test: FAIL (no $x)"; exit 1; }
  done
  command -v mesh-tg >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-tg sender)"; exit 1; }
  [ -d "$REPO/.git" ] || { echo "smoke-test: FAIL (no repo at $REPO)"; exit 1; }
  out="$(SINCE="2026-01-01T00:00:00Z" "$0" --dry 2>&1)" || { echo "smoke-test: FAIL (dry render errored)"; exit 1; }
  printf '%s' "$out" | grep -q '.' || { echo "smoke-test: FAIL (empty dry render over all-time)"; exit 1; }
  echo "smoke-test: ok"; exit 0
fi

MODE="auto"; case "${1:-}" in --force) MODE=force ;; --dry) MODE=dry ;; esac

# window start: marker, or env override (--test), or 30m ago
if [ -n "${SINCE:-}" ]; then start="$SINCE"
elif [ -f "$MARK" ]; then start="$(cat "$MARK" 2>/dev/null)"
else start="$(date -u -d '30 minutes ago' +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)"; fi
now="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

# --- collect change since `start` (zero-inference) ---
# 1) landed commits (subjects only — the durable artifacts)
commits="$(git -C "$REPO" log --since="$start" --pretty='%s' 2>/dev/null | grep -vE '^Merge ' | head -8)"
ncommit="$(printf '%s' "$commits" | grep -c . )"
# 2) board signal since start: [done] count + GENUINE problem signals only (not self-resolving
#    [check] doctor-WARN churn — the operator wants real change, not routine tending noise).
#    [escalate:tg-window] from mesh-situation is also included so a situation ALERT reaches
#    the operator even when the tg-mind is dead or rate-limited (direct reflex fallback).
board="$(awk -v s="$start" '$1 > s' "$M/chat.log" 2>/dev/null)"
ndone="$(printf '%s\n' "$board" | grep -c '\[done\]')"
alerts="$(printf '%s\n' "$board" \
  | grep -oE '\[(gap|organ-down|health-fail|drift|strand|mind-blocked|mind-limited|escalate[^]]*)\][^|]*' \
  | sed 's/  */ /g' | cut -c1-72 | sort -u | head -4)"

# nothing new → stay silent (no spam), don't advance marker on a no-op
if [ "$MODE" != force ] && [ "${ncommit:-0}" -eq 0 ] && [ "${ndone:-0}" -eq 0 ] && [ -z "$alerts" ]; then
  [ "$MODE" = dry ] && echo "(no change since $start — would stay silent)"
  exit 0
fi

# --- compose a CONCISE message (not the full board — the operator asked for "what changed") ---
msg="🔄 mesh update — $(date -u +%H:%MZ)"
if [ "${ncommit:-0}" -gt 0 ]; then
  msg="$msg"$'\n'"📦 landed ($ncommit):"
  msg="$msg"$'\n'"$(printf '%s' "$commits" | sed 's/^/  • /')"
fi
[ "${ndone:-0}" -gt 0 ] && msg="$msg"$'\n'"✅ ${ndone} task(s) completed on the board"
if [ -n "$alerts" ]; then
  msg="$msg"$'\n'"⚠ signals:"
  msg="$msg"$'\n'"$(printf '%s' "$alerts" | sed 's/^/  /')"
fi
# health one-liner (live, cheap)
h="$(mesh-vitals 2>/dev/null | head -1 | grep -oE 'temp:[0-9]+C')"
[ -n "$h" ] && msg="$msg"$'\n'"🌡 $h"

if [ "$MODE" = dry ]; then
  printf '%s\n' "$msg"; exit 0
fi

# send + advance marker only on a real send
if mesh-tg "$msg" >/dev/null 2>&1; then
  echo "$now" > "$MARK"
  echo "$(date -u +%Y-%m-%dT%H:%MZ) tg-update: sent ($ncommit commit / $ndone done) → marker=$now"
else
  echo "$(date -u +%Y-%m-%dT%H:%MZ) tg-update: SEND FAILED (mesh-tg) — marker NOT advanced (will retry)" >&2
  exit 1
fi
