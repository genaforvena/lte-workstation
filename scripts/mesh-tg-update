#!/usr/bin/env bash
# mesh-tg-update — push the operator a CONCISE "what changed" Telegram update, on change only.
# Operator 2026-06-13: "I need to receive updates on what changed." A REFLEX (not a mind) so it
# never goes stale on a rate-limited/blocked mind — cron-polled, marker-deduped, SILENT when nothing
# new. Sources are zero-inference (git + board), same as mesh-since/mesh-digest.
#
#   mesh-tg-update            send an update IF something changed since the last send; else silent
#   mesh-tg-update --force    send the current window even if already reported (manual "what's up")
#   mesh-tg-update --dry      print what WOULD be sent, don't send, don't advance the marker
#   mesh-tg-update --test     smoke: deps + a real dry render, no send
#
# Besides landed commits / [done]s / failure-signals, the digest carries an "⏳ awaiting your call"
# section: operator-gated/route-to-operator/consent items scanned from the board (wide window),
# deduped by intent-sig, resolved+already-delivered dropped, each delivered ONCE (~/.mesh/.tg-awaiting-sent
# ledger). Without it a standing decision never reaches TG and re-cycles as roll-call GAPs for days.
# (--sig "<text>" prints the intent-key for that text — a debug/seed helper.)
#
# Marker: ~/.mesh/.tg-update-marker (last-reported ISO ts). First run looks back 30m.
#
# reflex-cadence: 0 */6 * * *
# Operator 2026-06-24: "хочу получать апдейты — много разработки, следить сложно." This tool was
# BUILT for exactly that (his same ask 2026-06-13) but was never scheduled — the reason he wasn't
# getting updates. Wire it on-change every 6h: silent when nothing changed, marker-deduped → roughly
# a couple meaningful "what landed" digests a day (his "пару раз в день"), sparse not spammy.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
M="$HOME/.mesh"; REPO="$HOME/lte-workstation"; MARK="$M/.tg-update-marker"
CHAT_LOG="${TG_CHAT_LOG:-$M/chat.log}"
AWAIT_LEDGER="${TG_AWAIT_LEDGER:-$M/.tg-awaiting-sent}"   # sigs already delivered to TG (deliver each once)
AWAIT_LOOKBACK_H="${AWAIT_LOOKBACK_H:-48}"               # operator-gated items recur for DAYS → scan wide

# order/punct/stopword-invariant intent-key over a board subject (kin to mesh-roll-call's propose_sig):
# keys on the SUBJECT, dropping the route-marker words themselves so "→ OPERATOR (route to tg)" chrome
# never anchors a sig. Conservative: empty-on-all-stopwords → caller skips.
norm_sig(){ printf '%s' "$1" | tr 'A-Z' 'a-z' | tr -cs 'a-z0-9' ' ' | tr ' ' '\n' \
  | grep -vxE '(the|a|an|to|of|for|and|or|is|it|its|on|in|at|by|be|as|this|that|with|from|new|now|once|operator|operators|tg|route|ask|fyi|gated|call|decision|action|needs|awaiting)' \
  | sort -u | tr '\n' ' ' | sed -E 's/[[:space:]]+$//'; }

# candidate sig (arg) RESOLVED by some board [done]/[taking]/[resolving]? (resolving sigs on stdin)
# token-overlap, not exact: a worker's "done" line rarely echoes the ask verbatim. Require >=2 shared
# content tokens AND >=50% of the candidate's tokens covered — specific enough not to wrongly silence
# an unrelated standing ask (the failure we're fixing), loose enough to catch a real resolve.
sig_resolved(){
  local cand="$1"; [ -n "$cand" ] || return 1
  local -a c=($cand); local nc=${#c[@]} need; [ "$nc" -gt 0 ] || return 1
  need=$(( (nc+1)/2 )); [ "$need" -ge 2 ] || need=2
  local rl ov w
  while IFS= read -r rl; do
    [ -n "$rl" ] || continue
    ov=0; for w in $cand; do case " $rl " in *" $w "*) ov=$((ov+1));; esac; done
    [ "$ov" -ge "$need" ] && [ "$ov" -ge 2 ] && return 0
  done
  return 1
}

if [ "${1:-}" = --sig ]; then shift; norm_sig "$*"; echo; exit 0; fi

if [ "${1:-}" = --test ]; then
  for x in git grep awk date sed; do command -v "$x" >/dev/null 2>&1 || { echo "smoke-test: FAIL (no $x)"; exit 1; }
  done
  command -v mesh-tg >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-tg sender)"; exit 1; }
  [ -d "$REPO/.git" ] || { echo "smoke-test: FAIL (no repo at $REPO)"; exit 1; }
  out="$(SINCE="2026-01-01T00:00:00Z" "$0" --dry 2>&1)" || { echo "smoke-test: FAIL (dry render errored)"; exit 1; }
  printf '%s' "$out" | grep -q '.' || { echo "smoke-test: FAIL (empty dry render over all-time)"; exit 1; }

  # --- awaiting-call section: fixture board, isolated ledger, NO send (dry) ---
  _td="$(mktemp -d)"; trap 'rm -rf "$_td"' EXIT
  _cl="$_td/chat.log"; _lg="$_td/ledger"
  _t1="$(date -u -d '-1 hour'    +%Y-%m-%dT%H:%M:%SZ)"
  _t2="$(date -u -d '-2 hours'   +%Y-%m-%dT%H:%M:%SZ)"
  _t3="$(date -u -d '-90 minutes' +%Y-%m-%dT%H:%M:%SZ)"
  _t4="$(date -u -d '-80 minutes' +%Y-%m-%dT%H:%M:%SZ)"
  {
    printf '%s  discover@n  ::  [fyi] discover → OPERATOR (route to tg): vacuum serial photo under dustbin unlocks lidar node\n' "$_t1"
    printf '%s  pub@n  ::  [fyi] external posting operator-gated: phaedra public ingress awaiting operator decision\n' "$_t2"
    printf '%s  discover@n  ::  [fyi] discover → OPERATOR: gizmo frobnicator needs operator consent to onboard\n' "$_t3"
    printf '%s  land@n  ::  [done] gizmo frobnicator onboard consent — resolved, operator approved\n' "$_t4"
  } > "$_cl"
  ao="$(TG_CHAT_LOG="$_cl" TG_AWAIT_LEDGER="$_lg" AWAIT_LOOKBACK_H=48 "$0" --dry 2>&1)"
  printf '%s' "$ao" | grep -q 'awaiting your call' || { echo "test: FAIL (no awaiting-call section)"; exit 1; }
  printf '%s' "$ao" | grep -qi 'vacuum'  || { echo "test: FAIL (route-to-operator item missing)"; exit 1; }
  printf '%s' "$ao" | grep -qi 'phaedra' || { echo "test: FAIL (operator-gated item missing)"; exit 1; }
  printf '%s' "$ao" | grep -qi 'gizmo'   && { echo "test: FAIL (resolved item NOT excluded)"; exit 1; }
  [ -s "$_lg" ]                          && { echo "test: FAIL (dry render wrote the ledger)"; exit 1; }
  # ledger suppression: seed the vacuum sig as already-delivered → must drop on next render (phaedra stays)
  vsig="$("$0" --sig 'discover operator route tg vacuum serial photo under dustbin unlocks lidar node')"
  printf '%s\n' "$vsig" > "$_lg"
  ao2="$(TG_CHAT_LOG="$_cl" TG_AWAIT_LEDGER="$_lg" AWAIT_LOOKBACK_H=48 "$0" --dry 2>&1)"
  printf '%s' "$ao2" | grep -qi 'vacuum'  && { echo "test: FAIL (already-delivered item NOT suppressed)"; exit 1; }
  printf '%s' "$ao2" | grep -qi 'phaedra' || { echo "test: FAIL (non-delivered item wrongly suppressed)"; exit 1; }
  rm -rf "$_td"; trap - EXIT
  echo "smoke-test: ok"; exit 0
fi

MODE="auto"; case "${1:-}" in --force) MODE=force ;; --dry) MODE=dry ;; esac

# window start: marker, or env override (--test), or 30m ago
if [ -n "${SINCE:-}" ]; then start="$SINCE"
elif [ -f "$MARK" ]; then start="$(cat "$MARK" 2>/dev/null)"
else start="$(date -u -d '30 minutes ago' +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)"; fi
now="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

# --- collect change since `start` (zero-inference) ---
# 1) landed commits (subjects only — the durable artifacts)
commits="$(git -C "$REPO" log --since="$start" --pretty='%s' 2>/dev/null | grep -vE '^Merge ' | head -8)"
ncommit="$(printf '%s\n' "$commits" | awk 'NF{c++} END{print c+0}')"
# 2) board signal since start: [done] count + GENUINE problem signals only (not self-resolving
#    [check] doctor-WARN churn — the operator wants real change, not routine tending noise).
#    [escalate:tg-window] from mesh-situation is also included so a situation ALERT reaches
#    the operator even when the tg-mind is dead or rate-limited (direct reflex fallback).
board="$(awk -v s="$start" '$1 > s' "$CHAT_LOG" 2>/dev/null)"
ndone="$(printf '%s\n' "$board" | grep -c '\[done\]')"
alerts="$(printf '%s\n' "$board" \
  | grep -oE '\[(gap|organ-down|health-fail|drift|strand|mind-blocked|mind-limited|escalate[^]]*)\][^|]*' \
  | sed 's/  */ /g' | cut -c1-72 | sort -u | head -4)"

# 3) operator-gated items AWAITING THE OPERATOR'S CALL — consent/substrate/route-to-operator asks.
#    The `alerts` grep above matches only FAILURE markers, so a standing DECISION (vacuum serial photo,
#    phaedra ingress, ds-7B pull, router offline) never reaches TG and re-cycles as roll-call GAPs for
#    days. Scan a WIDER window than the change-window, dedup by intent-sig, drop resolved + already-
#    delivered, deliver each ONCE (ledger). Complements build_recurring (escalates recurring PROPOSEs
#    on the BOARD but cannot push an operator-only item to TG).
awstart="$(date -u -d "${AWAIT_LOOKBACK_H} hours ago" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo "$start")"
# Match EXPLICIT routed asks only — a direct "→ OPERATOR (/:" address, route-to-tg/operator, ask:operator,
# or an operator-gated declaration. Deliberately NOT every prose mention of "operator" (the arrow arm is
# anchored to a following '(' or ':' so "→ operator's call" / "→ operator-hands" prose never matches), and
# meta lines ([design]/[chat-review]/[verify]/BATON/DIGEST/PROPOSE/RESOLVING) are excluded — those are
# analysis, not a standing ask. Tight-and-correct: under-deliver (item still lives on the board) beats
# re-flooding the operator with every GAP restatement.
opre='→[[:space:]]*operator[[:space:]]*(\(|:)|route[[:space:]]*→[[:space:]]*operator|route to (tg|operator)|ask:[[:space:]]*operator|operator-gated'
metaexcl='roll-call DIGEST|\[(done|taking|idle|resolving|design|chat-review|verify)\]|BATON|PROPOSE|RESOLVING'
resolved_sigs="$(awk -v s="$awstart" 'index($0,"  ::  ")>0 && $1 > s' "$CHAT_LOG" 2>/dev/null \
  | grep -aiE '\[(done|taking|resolving)\]' \
  | sed -E 's/^.*  ::  //; s/^\[[a-zA-Z-]+\][[:space:]]*//' \
  | while IFS= read -r r; do [ -n "$r" ] && printf '%s\n' "$(norm_sig "$r")"; done | sort -u)"
awaiting="$(awk -v s="$awstart" 'index($0,"  ::  ")>0 && $1 > s' "$CHAT_LOG" 2>/dev/null \
  | grep -aivE "$metaexcl" \
  | grep -aiE "$opre" \
  | tac \
  | sed -E 's/^.*  ::  //; s/^\[[a-zA-Z-]+\][[:space:]]*//; s/[[:space:]]+/ /g' \
  | while IFS= read -r subj; do
      subj="$(printf '%s' "$subj" | cut -c1-100)"; [ -n "$subj" ] || continue
      sig="$(norm_sig "$subj")"; [ -n "$sig" ] || continue
      printf '%s\n' "$resolved_sigs" | sig_resolved "$sig" && continue
      if [ "$MODE" != force ]; then grep -qxF "$sig" "$AWAIT_LEDGER" 2>/dev/null && continue; fi
      printf '%s\t%s\n' "$sig" "$subj"
    done \
  | awk -F'\t' '!seen[$1]++{print $2"\t"$1}' | head -4)"

# nothing new → stay silent (no spam), don't advance marker on a no-op
if [ "$MODE" != force ] && [ "${ncommit:-0}" -eq 0 ] && [ "${ndone:-0}" -eq 0 ] && [ -z "$alerts" ] && [ -z "$awaiting" ]; then
  [ "$MODE" = dry ] && echo "(no change since $start — would stay silent)"
  exit 0
fi

# --- compose a CONCISE message (not the full board — the operator asked for "what changed") ---
msg="🔄 mesh update — $(date -u +%H:%MZ)"
if [ "${ncommit:-0}" -gt 0 ]; then
  msg="$msg"$'\n'"📦 landed ($ncommit):"
  msg="$msg"$'\n'"$(printf '%s' "$commits" | sed 's/^/  • /')"
fi
[ "${ndone:-0}" -gt 0 ] && msg="$msg"$'\n'"✅ ${ndone} task(s) completed on the board"
if [ -n "$alerts" ]; then
  msg="$msg"$'\n'"⚠ signals:"
  msg="$msg"$'\n'"$(printf '%s' "$alerts" | sed 's/^/  /')"
fi
if [ -n "$awaiting" ]; then
  msg="$msg"$'\n'"⏳ awaiting your call:"
  msg="$msg"$'\n'"$(printf '%s\n' "$awaiting" | cut -f1 | cut -c1-72 | sed 's/^/  • /')"
fi
# health one-liner (live, cheap)
h="$(mesh-vitals 2>/dev/null | head -1 | grep -oE 'temp:[0-9]+C')"
[ -n "$h" ] && msg="$msg"$'\n'"🌡 $h"

if [ "$MODE" = dry ]; then
  printf '%s\n' "$msg"; exit 0
fi

# send + advance marker only on a real send
if mesh-tg "$msg" >/dev/null 2>&1; then
  echo "$now" > "$MARK"
  [ -n "$awaiting" ] && printf '%s\n' "$awaiting" | cut -f2 >> "$AWAIT_LEDGER"   # mark these delivered (once)
  echo "$(date -u +%Y-%m-%dT%H:%MZ) tg-update: sent ($ncommit commit / $ndone done / $(printf '%s\n' "$awaiting" | awk 'NF{c++}END{print c+0}') awaiting) → marker=$now"
else
  echo "$(date -u +%Y-%m-%dT%H:%MZ) tg-update: SEND FAILED (mesh-tg) — marker NOT advanced (will retry)" >&2
  exit 1
fi
