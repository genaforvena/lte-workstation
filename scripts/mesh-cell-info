#!/usr/bin/env bash
# reflex-cadence: 14-59/15 * * * *
# reflex-args: --edge
# doctor-artifact: $HOME/.mesh/.cell-info-state 3600 phone
#   ^ smoke-theater gate (mesh-doctor): .cell-info-state is rewritten on EVERY successful read
#     (first-run seed + the steady update, both BEFORE the change-check), so phone-reachable +
#     state >3600s stale ⟹ the sense silently isn't producing despite a green --test. Phone offline
#     (exit 2) → gate skips (honest n/a). This header was MISSING since the tool's creation
#     (git -S 'reflex-cadence' empty) → autowire skipped it → .cell-info-state sat ~18d stale while
#     --test stayed green. Same root cause + fix as mesh-gyro (9d) / mesh-mag (5d). Offset 14 is
#     clear of the other phone-SSH /15 reads (mag=4, gyro=9, deploy-phone-capture=2) so they never
#     stack on one SSH window.
# mesh-cell-info — the mesh's CELL-TOWER sense: read the phone BODY's serving cell tower info
# via termux-telephony-cellinfo over SSH. Alternative location + signal quality sense.
# Light probe, no wake-lock needed. Posts [cell-tower-changed] to board on TAC/CI change —
# DEBOUNCED + FUSION-GATED (chat-review/cellinfo-tower-debounce 2026-07-06):
#   * N>=2 consecutive samples must agree before a change COMMITS (CELL_DEBOUNCE_N) — a
#     single-sample flap (weak-cell roaming at edge-of-range, RSRP -107..-120 live) never posts.
#   * Ping-pong guard: re-committing a ci we LEFT within CELL_RECENT_S (default 7200s) is
#     suppressed — live 2026-07-06: ci cycled back to 134795011 in 4 posts/3.5h, stationary.
#   * Fusion gate (discover 14:09Z): operator-home=HOME (fresh ~/.mesh/.op-home.state) means the
#     phone is physically home — a tower change is indoor RESELECTION, not motion: posts
#     [cell-reselection] (signal-environment note), NEVER [cell-tower-changed]. Genuine travel
#     = tower change + home lost (AWAY/UNCERTAIN/UNKNOWN → [cell-tower-changed] as before).
#
#   mesh-cell-info               current serving cell → JSON summary (monitor mode, posts on change)
#   mesh-cell-info --json        current serving cell → JSON (no state tracking)
#   mesh-cell-info --edge        one-shot check, post to board on change via mesh-chat
#   mesh-cell-info --neighbors   the DISCARDED non-serving cells → PCI/RSRP set + hash; posts
#                                [cell-neighbors-changed] on set change (coarse GPS/wifi-free
#                                motion sense — outdoor analog of the wifi [room-moved] signal;
#                                see ~/.mesh/knowledge/capability-cell-neighbor-fingerprint-20260701.md)
#   mesh-cell-info --test        smoke test
#   mesh-cell-info --forget      reset cell state (next run re-seeds silently)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes"

STATE="$HOME/.mesh/.cell-info-state"
OFFLINEFILE="$HOME/.mesh/.cell-info-offline"
PHONE_PORT="${PHONE_SSH_PORT:-8022}"
PHONE_USER="${PHONE_USER:-u0_a380}"
DEBOUNCE_N="${CELL_DEBOUNCE_N:-2}"          # consecutive samples required to commit a tower change
RECENT_S="${CELL_RECENT_S:-7200}"           # ping-pong window: returning to a ci left <this ago = suppressed
OPHOME_STATE="${CELL_OPHOME_STATE:-$HOME/.mesh/.op-home.state}"
OPHOME_FRESH_S="${CELL_OPHOME_FRESH_S:-3600}"  # stale op-home verdict → UNKNOWN (fail-open to motion)

# Core parse: termux-telephony-cellinfo JSON array → the serving-cell summary. Prefer the REGISTERED
# cell, fall back to the first. Factored into PARSE_PY (verbatim from the old inline block) so --test
# can dry-run it on a fixture without a phone — the serving-cell selection is the tool's reason to
# exist and the old dep-only smoke never touched it.
PARSE_PY='
import json, sys
try:
    cells = json.load(sys.stdin)
except Exception:
    print("parse-error"); sys.exit(1)
if not isinstance(cells, list) or len(cells) == 0:
    print("no-cells"); sys.exit(0)
# prefer registered cell; fall back to first
serving = None
for c in cells:
    if c.get("registered") is True:
        serving = c
        break
if serving is None:
    serving = cells[0]
# build a compact summary
ci = serving.get("ci", 0)
tac = serving.get("tac", 0)
dbm = serving.get("dbm", 0)
typ = serving.get("type", "?")
reg = serving.get("registered", False)
rsrp = serving.get("rsrp")
rsrq = serving.get("rsrq")
op = "%s-%s" % (serving.get("mcc","?"), serving.get("mnc","?"))
print(json.dumps({
    "ci": ci, "tac": tac, "type": typ, "dbm": dbm,
    "registered": reg, "rsrp": rsrp, "rsrq": rsrq,
    "operator": op, "pci": serving.get("pci")
}))
'

# Neighbor-set parse: same cell list, minus whichever cell PARSE_PY picked as serving. termux
# throws away nothing — the neighbor (registered:false) cells are visible-but-not-camped towers,
# a coarse RF fingerprint of the phone's surroundings. A stable hash of the set (order-independent)
# is what --neighbors diffs against, so a re-ordered-but-identical read never false-fires.
NEIGH_PARSE_PY='
import json, sys, hashlib
try:
    cells = json.load(sys.stdin)
except Exception:
    print("parse-error"); sys.exit(1)
if not isinstance(cells, list):
    print("parse-error"); sys.exit(1)
serving_idx = None
for i, c in enumerate(cells):
    if c.get("registered") is True:
        serving_idx = i
        break
if serving_idx is None and cells:
    serving_idx = 0
neighbors = [c for i, c in enumerate(cells) if i != serving_idx]
compact = sorted((c.get("pci"), c.get("ci"), c.get("rsrp")) for c in neighbors)
h = hashlib.sha1(repr(compact).encode()).hexdigest()[:12]
print(json.dumps({
    "count": len(neighbors),
    "total_cells": len(cells),
    "neighbors": [{"pci": c.get("pci"), "ci": c.get("ci"), "tac": c.get("tac"),
                    "rsrp": c.get("rsrp"), "type": c.get("type", "?")} for c in neighbors],
    "hash": h,
}))
'

# PURE change-decision (debounce + ping-pong + fusion gate) — no I/O, --test drives it on fixtures.
# argv: 1=committed_ci 2=committed_tac 3=new_ci 4=new_tac 5=pending("ci tac n"|"") 6=recent("ci:t;..."|"")
#       7=now_epoch 8=home(HOME|AWAY|UNCERTAIN|UNKNOWN) 9=debounce_n 10=recent_s
# stdout: "commit|post|pending|recent"  commit=0/1  post=motion|reselect|none
#   hold   (n<debounce_n): commit=0, pending carries the candidate+count, recent passes through
#   commit (n>=debounce_n): pending clears, the LEFT tower joins recent (pruned to recent_s, cap 8);
#     post=none if new ci was left <recent_s ago (ping-pong), reselect if operator is HOME
#     (indoor reselection ≠ motion), else motion. Only called when new != committed (bash gates).
DECIDE_PY='
import sys
a = sys.argv
old_ci, new_ci, new_tac = a[1], a[3], a[4]
pend, recent_str = a[5].strip(), a[6].strip()
now, home, dn, rs = int(a[7]), a[8], int(a[9]), int(a[10])
p = pend.split()
p_ci, p_tac, p_n = (p[0], p[1], int(p[2])) if len(p) == 3 else ("", "", 0)
recent = []
for tok in recent_str.split(";"):
    if ":" in tok:
        c, _, t = tok.rpartition(":")
        try: recent.append((c, int(t)))
        except ValueError: pass
n = p_n + 1 if (p_ci == new_ci and p_tac == new_tac) else 1
if n >= dn:
    recent = [(c, t) for (c, t) in recent if now - t <= rs]
    if any(c == new_ci for (c, _) in recent): post = "none"      # ping-pong: back to a tower just left
    elif home == "HOME":                      post = "reselect"  # physically home: reselection, not motion
    else:                                     post = "motion"
    if old_ci: recent.append((old_ci, now))
    recent = recent[-8:]
    print("1|%s||%s" % (post, ";".join("%s:%d" % (c, t) for c, t in recent)))
else:
    print("0|none|%s %s %d|%s" % (new_ci, new_tac, n, recent_str))
'

if [ "${1:-}" = "--test" ]; then
  for x in ssh python3 mesh-phone-ip; do
    command -v "$x" >/dev/null 2>&1 || { echo "smoke-test: FAIL (no $x)"; exit 1; }
  done
  # Dry-run the serving-cell parse (no phone) — the core the dep-only smoke never touched. Assert it
  # picks the REGISTERED cell over the first, extracts the operator, handles [] (no-cells), and falls
  # back to the first cell when none is registered.
  _f=0
  fix='[{"ci":111,"tac":11,"type":"GSM","registered":false},{"ci":222,"tac":22,"type":"LTE","registered":true,"mcc":"250","mnc":"01"}]'
  got_ci="$(printf '%s' "$fix" | python3 -c "$PARSE_PY" 2>/dev/null | python3 -c 'import json,sys; print(json.load(sys.stdin).get("ci"))' 2>/dev/null)"
  [ "$got_ci" = 222 ] || { echo "  FAIL: serving cell should be the REGISTERED one (ci=222), got '$got_ci'"; _f=1; }
  got_op="$(printf '%s' "$fix" | python3 -c "$PARSE_PY" 2>/dev/null | python3 -c 'import json,sys; print(json.load(sys.stdin).get("operator"))' 2>/dev/null)"
  [ "$got_op" = "250-01" ] || { echo "  FAIL: operator should be 250-01, got '$got_op'"; _f=1; }
  none="$(printf '[]' | python3 -c "$PARSE_PY" 2>/dev/null)"
  [ "$none" = "no-cells" ] || { echo "  FAIL: empty array should be no-cells, got '$none'"; _f=1; }
  ff="$(printf '%s' '[{"ci":333,"tac":33,"registered":false}]' | python3 -c "$PARSE_PY" 2>/dev/null | python3 -c 'import json,sys; print(json.load(sys.stdin).get("ci"))' 2>/dev/null)"
  [ "$ff" = 333 ] || { echo "  FAIL: no registered cell should fall back to first (ci=333), got '$ff'"; _f=1; }
  # neighbor-set parse (fixture has 1 registered + 1 non-registered → 1 neighbor, the non-registered one)
  neigh_fix="$(printf '%s' "$fix" | python3 -c "$NEIGH_PARSE_PY" 2>/dev/null)"
  ncount="$(printf '%s' "$neigh_fix" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("count"))' 2>/dev/null)"
  [ "$ncount" = 1 ] || { echo "  FAIL: neighbor set should exclude the registered cell (count=1), got '$ncount'"; _f=1; }
  nci="$(printf '%s' "$neigh_fix" | python3 -c 'import json,sys; print(json.load(sys.stdin)["neighbors"][0].get("ci"))' 2>/dev/null)"
  [ "$nci" = 111 ] || { echo "  FAIL: neighbor should be the non-registered cell (ci=111), got '$nci'"; _f=1; }
  h1="$(printf '%s' "$neigh_fix" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("hash"))' 2>/dev/null)"
  h2="$(printf '%s' "$fix" | python3 -c "$NEIGH_PARSE_PY" 2>/dev/null | python3 -c 'import json,sys; print(json.load(sys.stdin).get("hash"))' 2>/dev/null)"
  [ -n "$h1" ] && [ "$h1" = "$h2" ] || { echo "  FAIL: neighbor-set hash must be stable across identical input"; _f=1; }
  [ "$_f" = 0 ] || { echo "smoke-test: FAIL (serving-cell / neighbor parse contract)"; exit 1; }
  # DEBOUNCE + PING-PONG + FUSION GATE (chat-review/cellinfo-tower-debounce): drive the pure
  # DECIDE_PY on fixtures — each cell falsifies one guard (a mutation that neuters the guard
  # fails exactly its cell).
  _dec() { python3 -c "$DECIDE_PY" "$@" 2>/dev/null; }
  # (1) ONE differing sample must NOT post — it becomes a pending candidate (n=1)
  _g="$(_dec 111 11 222 22 '' '' 1000 AWAY 2 7200)"
  [ "$_g" = "0|none|222 22 1|" ] || { echo "  FAIL debounce: single sample must hold as pending, got '$_g'"; _f=1; }
  # (2) SECOND consecutive sample commits + posts motion (away, no recent history)
  _g="$(_dec 111 11 222 22 '222 22 1' '' 1000 AWAY 2 7200)"
  [ "$_g" = "1|motion||111:1000" ] || { echo "  FAIL debounce: 2nd consecutive must commit+motion, got '$_g'"; _f=1; }
  # (3) a THIRD cell resets the streak — pending must restart at n=1, never inherit the count
  _g="$(_dec 111 11 444 44 '222 22 1' '' 1000 AWAY 2 7200)"
  [ "$_g" = "0|none|444 44 1|" ] || { echo "  FAIL debounce: new candidate must reset streak to 1, got '$_g'"; _f=1; }
  # (4) PING-PONG: returning to a ci left 100s ago (inside 7200s) commits SILENTLY
  _g="$(_dec 333 33 222 22 '222 22 1' '222:900' 1000 AWAY 2 7200)"
  [ "$_g" = "1|none||222:900;333:1000" ] || { echo "  FAIL ping-pong: recent-ci return must suppress the post, got '$_g'"; _f=1; }
  # (5) a STALE recent entry (left >7200s ago) must NOT suppress — genuine re-visit posts
  _g="$(_dec 333 33 222 22 '222 22 1' '222:100' 9000 AWAY 2 7200)"
  [ "$_g" = "1|motion||333:9000" ] || { echo "  FAIL ping-pong: stale recent must be pruned (post fires), got '$_g'"; _f=1; }
  # (6) FUSION GATE: operator HOME → reselection (signal environment), never motion
  _g="$(_dec 111 11 222 22 '222 22 1' '' 1000 HOME 2 7200)"
  [ "$_g" = "1|reselect||111:1000" ] || { echo "  FAIL fusion: HOME must gate motion→reselect, got '$_g'"; _f=1; }
  # (7) UNKNOWN home state fails OPEN to motion (an unknown gate input must not eat the signal)
  _g="$(_dec 111 11 222 22 '222 22 1' '' 1000 UNKNOWN 2 7200)"
  [ "$_g" = "1|motion||111:1000" ] || { echo "  FAIL fusion: UNKNOWN home must fail-open to motion, got '$_g'"; _f=1; }
  [ "$_f" = 0 ] || { echo "smoke-test: FAIL (debounce/ping-pong/fusion decision contract)"; exit 1; }
  # REAL-READ GATE (verification principle: assert a real hardware read produces data, not just the
  # offline classifier — the mesh-mag/mesh-gyro precedent). Only runs when the phone is reachable;
  # unreachable = honest n/a (exit 2), never a fake green.
  _mpip="$(mesh-phone-ip 2>/dev/null)"
  _n=0
  if [ -n "$_mpip" ]; then
    _live="$(timeout 15 ssh -p "$PHONE_PORT" -o BatchMode=yes -o ConnectTimeout=8 \
      -o StrictHostKeyChecking=accept-new "${PHONE_USER}@$_mpip" \
      "timeout 10 termux-telephony-cellinfo" </dev/null 2>/dev/null)"
    _n="$(printf '%s' "$_live" | python3 -c 'import json,sys
try:
    d=json.load(sys.stdin)
    print(len(d) if isinstance(d, list) else 0)
except Exception:
    print(0)' 2>/dev/null)"
    [ -n "$_n" ] || _n=0
    [ "$_n" -ge 1 ] 2>/dev/null || { echo "smoke-test: n/a (termux-telephony-cellinfo returned <1 parsed cell — sense not producing; classify-logic ok)"; exit 2; }
  fi
  echo "smoke-test: ok (deps + serving-cell parse + neighbor-set parse/hash + debounce/ping-pong/fusion 7-cell decision battery$( [ -n "$_mpip" ] && echo " + REAL read: ${_n} cell(s)" || echo " (phone unreachable, real-read gate skipped)" ))"; exit 0
fi

[ "${1:-}" = "--forget" ] && { rm -f "$STATE"; echo "cell state forgotten — next run re-seeds"; exit 0; }

pip="$(mesh-phone-ip 2>/dev/null)"
[ -n "$pip" ] || { if [ ! -f "$OFFLINEFILE" ]; then echo "phone unreachable (no network path)" >&2; touch "$OFFLINEFILE"; fi; exit 2; }
rm -f "$OFFLINEFILE"

json="$(timeout 15 ssh -p "$PHONE_PORT" -o BatchMode=yes -o ConnectTimeout=8 \
  -o StrictHostKeyChecking=accept-new "${PHONE_USER}@$pip" \
  "timeout 10 termux-telephony-cellinfo" </dev/null 2>/dev/null)"
[ -n "$json" ] || { if [ ! -f "$OFFLINEFILE" ]; then echo "phone unreachable or no cell info" >&2; touch "$OFFLINEFILE"; fi; exit 2; }

# Parse the registered cell (or first cell if none registered) via the shared PARSE_PY (defined above,
# also dry-run by --test). termux-telephony-cellinfo returns a JSON array of cells (LTE/NR/GSM/…).
summary="$(printf '%s' "$json" | python3 -c "$PARSE_PY" 2>/dev/null)"

[ -n "$summary" ] && [ "$summary" != "parse-error" ] || { echo "unparseable cell info from phone" >&2; exit 1; }

# Output --json mode: print summary, no state tracking, exit
if [ "${1:-}" = "--json" ]; then
  printf '%s\n' "$summary"
  exit 0
fi

# --neighbors mode: the cells termux sees but does NOT camp on — visible-but-not-registered towers.
# Gated on the set HASH (not a single field, order-independent), so a re-ordered-but-identical read
# never false-fires. Separate state file from the serving-cell STATE above (independent axes).
if [ "${1:-}" = "--neighbors" ]; then
  neigh="$(printf '%s' "$json" | python3 -c "$NEIGH_PARSE_PY" 2>/dev/null)"
  [ -n "$neigh" ] && [ "$neigh" != "parse-error" ] || { echo "unparseable cell info from phone" >&2; exit 1; }
  new_hash=$(printf '%s' "$neigh" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("hash",""))')
  nstate="$HOME/.mesh/.cell-neighbors-state"
  old_hash=""; [ -f "$nstate" ] && old_hash="$(cat "$nstate" 2>/dev/null)"
  if [ -f "$nstate" ] && [ -n "$old_hash" ] && [ "$old_hash" != "$new_hash" ]; then
    count=$(printf '%s' "$neigh" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("count",0))')
    command -v mesh-chat >/dev/null 2>&1 && \
      mesh-chat "[cell-neighbors-changed] neighbor set changed: n=$count hash=$new_hash" >/dev/null 2>&1
  fi
  printf '%s\n' "$new_hash" > "$nstate" 2>/dev/null
  printf '%s\n' "$neigh"
  exit 0
fi

# State tracking for change detection. 4-line state (rewritten EVERY successful read — mtime stays
# the liveness signal for the doctor-artifact gate): committed ci / committed tac / pending
# "ci tac n" / recent "ci:epoch;...". A legacy 2-line file reads as empty pending+recent.
old_ci=""; old_tac=""; old_pend=""; old_recent=""
if [ -f "$STATE" ]; then
  old_ci=$(sed -n '1p' "$STATE"); old_tac=$(sed -n '2p' "$STATE")
  old_pend=$(sed -n '3p' "$STATE"); old_recent=$(sed -n '4p' "$STATE")
fi

new_ci=$(printf '%s' "$summary" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("ci",""))')
new_tac=$(printf '%s' "$summary" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("tac",""))')

# First run or forced: seed state without alert
if [ ! -f "$STATE" ]; then
  printf '%s\n%s\n\n\n' "$new_ci" "$new_tac" > "$STATE"
  # print summary, no alert on first run
  printf '%s\n' "$summary"
  exit 0
fi

# Fast path — same serving cell as committed: clear any pending candidate (its streak broke),
# refresh mtime, done. The decision fn never runs in steady state (cheap cron).
if [ "$new_ci" = "$old_ci" ] && [ "$new_tac" = "$old_tac" ]; then
  printf '%s\n%s\n\n%s\n' "$old_ci" "$old_tac" "$old_recent" > "$STATE"
  if [ "${1:-}" = "--edge" ]; then : ; else printf '%s\n' "$summary"; fi
  exit 0
fi

# Differing sample → debounce + ping-pong + fusion gate (pure DECIDE_PY above).
# operator-home input: a FRESH committed verdict, else UNKNOWN (fail-open: an unknown home
# state must keep the motion signal alive, never silently eat it).
home="UNKNOWN"
if [ -f "$OPHOME_STATE" ]; then
  _age=$(( $(date +%s) - $(stat -c %Y "$OPHOME_STATE" 2>/dev/null || echo 0) ))
  [ "$_age" -le "$OPHOME_FRESH_S" ] && home="$(cat "$OPHOME_STATE" 2>/dev/null || echo UNKNOWN)"
fi
decision="$(python3 -c "$DECIDE_PY" "$old_ci" "$old_tac" "$new_ci" "$new_tac" \
  "$old_pend" "$old_recent" "$(date +%s)" "$home" "$DEBOUNCE_N" "$RECENT_S" 2>/dev/null)"
if [ -z "$decision" ]; then
  # decide failed (corrupt state line?) — fall back to the raw single-sample edge rather than
  # going silently dead (a dead detector reads identical to all-clear); re-seed clean state.
  echo "cell-decide failed — raw single-sample edge fallback" >&2
  decision="1|motion||"
fi
IFS='|' read -r d_commit d_post d_pend d_recent <<< "$decision"

c_ci="$old_ci"; c_tac="$old_tac"
[ "$d_commit" = 1 ] && { c_ci="$new_ci"; c_tac="$new_tac"; }
printf '%s\n%s\n%s\n%s\n' "$c_ci" "$c_tac" "$d_pend" "$d_recent" > "$STATE"

# --edge or default: post the committed change (debounced; ping-pong commits stay silent)
if [ "$d_post" != none ] && [ "${1:-}" != "--json" ]; then
  cell_msg=$(printf '%s' "$summary" | POST_KIND="$d_post" python3 -c '
import json,sys,os
d=json.load(sys.stdin)
ci=d.get("ci","?"); tac=d.get("tac","?"); typ=d.get("type","?")
dbm=d.get("dbm","?"); op=d.get("operator","?")
rsrp=d.get("rsrp"); rsrq=d.get("rsrq")
sig = "%sdBm" % dbm
if rsrp is not None: sig += " (rsrp=%sdBm)" % rsrp
if os.environ.get("POST_KIND") == "reselect":
    print("[cell-reselection] %s ci=%s tac=%s %s %s — serving-cell reselection while HOME (signal environment, not motion)" % (typ, ci, tac, sig, op))
else:
    print("[cell-tower-changed] %s ci=%s tac=%s %s %s %s" % (typ, ci, tac, sig, op, "registered" if d.get("registered") else "neighbor"))
')
  command -v mesh-chat >/dev/null 2>&1 && mesh-chat "$cell_msg" >/dev/null 2>&1
  printf '%s\n' "$summary"
  exit 0
fi

# No post (debounce hold / ping-pong suppression): silent on --edge, print on default
if [ "${1:-}" = "--edge" ]; then : ; else printf '%s\n' "$summary"; fi
exit 0
