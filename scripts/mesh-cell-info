#!/usr/bin/env bash
# mesh-cell-info — the mesh's CELL-TOWER sense: read the phone BODY's serving cell tower info
# via termux-telephony-cellinfo over SSH. Alternative location + signal quality sense.
# Light probe, no wake-lock needed. Posts [cell-tower-changed] to board on TAC/CI change.
#
#   mesh-cell-info               current serving cell → JSON summary (monitor mode, posts on change)
#   mesh-cell-info --json        current serving cell → JSON (no state tracking)
#   mesh-cell-info --edge        one-shot check, post to board on change via mesh-chat
#   mesh-cell-info --test        smoke test
#   mesh-cell-info --forget      reset cell state (next run re-seeds silently)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes"

STATE="$HOME/.mesh/.cell-info-state"
PHONE_PORT="${PHONE_SSH_PORT:-8022}"
PHONE_USER="${PHONE_USER:-u0_a380}"

if [ "${1:-}" = "--test" ]; then
  for x in ssh python3 mesh-phone-ip; do
    command -v "$x" >/dev/null 2>&1 || { echo "smoke-test: FAIL (no $x)"; exit 1; }
  done
  echo "smoke-test: ok"; exit 0
fi

[ "${1:-}" = "--forget" ] && { rm -f "$STATE"; echo "cell state forgotten — next run re-seeds"; exit 0; }

pip="$(mesh-phone-ip 2>/dev/null)"
[ -n "$pip" ] || { echo "phone unreachable (no network path)" >&2; exit 2; }

json="$(timeout 15 ssh -p "$PHONE_PORT" -o BatchMode=yes -o ConnectTimeout=8 \
  -o StrictHostKeyChecking=accept-new "${PHONE_USER}@$pip" \
  "timeout 10 termux-telephony-cellinfo" </dev/null 2>/dev/null)"
[ -n "$json" ] || { echo "phone unreachable or no cell info" >&2; exit 2; }

# Parse the registered cell (or first cell if none registered). termux-telephony-cellinfo returns
# a JSON array of cells (LTE, NR, GSM, etc.). We pick the serving cell: registered: true.
summary="$(printf '%s' "$json" | python3 -c '
import json, sys
try:
    cells = json.load(sys.stdin)
except Exception:
    print("parse-error"); sys.exit(1)
if not isinstance(cells, list) or len(cells) == 0:
    print("no-cells"); sys.exit(0)
# prefer registered cell; fall back to first
serving = None
for c in cells:
    if c.get("registered") is True:
        serving = c
        break
if serving is None:
    serving = cells[0]
# build a compact summary
ci = serving.get("ci", 0)
tac = serving.get("tac", 0)
dbm = serving.get("dbm", 0)
typ = serving.get("type", "?")
reg = serving.get("registered", False)
rsrp = serving.get("rsrp")
rsrq = serving.get("rsrq")
op = "%s-%s" % (serving.get("mcc","?"), serving.get("mnc","?"))
print(json.dumps({
    "ci": ci, "tac": tac, "type": typ, "dbm": dbm,
    "registered": reg, "rsrp": rsrp, "rsrq": rsrq,
    "operator": op, "pci": serving.get("pci")
}))
' 2>/dev/null)"

[ -n "$summary" ] && [ "$summary" != "parse-error" ] || { echo "unparseable cell info from phone" >&2; exit 1; }

# Output --json mode: print summary, no state tracking, exit
if [ "${1:-}" = "--json" ]; then
  printf '%s\n' "$summary"
  exit 0
fi

# State tracking for change detection
old_ci=""; old_tac=""
[ -f "$STATE" ] && old_ci=$(head -1 "$STATE") && old_tac=$(sed -n '2p' "$STATE")

new_ci=$(printf '%s' "$summary" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("ci",""))')
new_tac=$(printf '%s' "$summary" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("tac",""))')

# Detect change
changed=0
if [ -n "$old_ci" ] && [ -n "$new_ci" ] && [ "$old_ci" != "$new_ci" ]; then changed=1; fi
if [ -n "$old_tac" ] && [ -n "$new_tac" ] && [ "$old_tac" != "$new_tac" ]; then changed=1; fi

# First run or forced: seed state without alert
if [ ! -f "$STATE" ]; then
  printf '%s\n%s\n' "$new_ci" "$new_tac" > "$STATE"
  # print summary, no alert on first run
  printf '%s\n' "$summary"
  exit 0
fi

# Update state
printf '%s\n%s\n' "$new_ci" "$new_tac" > "$STATE"

# --edge or default: post to board if changed
if [ "$changed" = 1 ] && [ "${1:-}" != "--json" ]; then
  cell_msg=$(printf '%s' "$summary" | python3 -c '
import json,sys
d=json.load(sys.stdin)
ci=d.get("ci","?"); tac=d.get("tac","?"); typ=d.get("type","?")
dbm=d.get("dbm","?"); op=d.get("operator","?")
rsrp=d.get("rsrp"); rsrq=d.get("rsrq")
sig = "%sdBm" % dbm
if rsrp is not None: sig += " (rsrp=%sdBm)" % rsrp
print("[cell-tower-changed] %s ci=%s tac=%s %s %s %s" % (typ, ci, tac, sig, op, "registered" if d.get("registered") else "neighbor"))
')
  command -v mesh-chat >/dev/null 2>&1 && mesh-chat "$cell_msg" >/dev/null 2>&1
  printf '%s\n' "$summary"
  exit 0
fi

# No change: silent on default, print on --edge
if [ "${1:-}" = "--edge" ]; then : ; else printf '%s\n' "$summary"; fi
exit 0
