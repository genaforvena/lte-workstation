#!/usr/bin/env bash
# mesh-presence — a BLE PRESENCE SENSE: scan for nearby Bluetooth devices and report each one's
# RSSI (signal strength = rough proximity) as text. One node's snapshot of "what is near me".
# smoke-test: --test checks bluetoothctl available + adapter powered
#
# The mesh-wide value (later): the SAME device seen by multiple nodes, compared by RSSI, gives
# zonal localization — no GPS, just relative signal. This is the per-node primitive that feeds it.
#
#   mesh-presence              scan (default 10s) -> rssi|mac|name lines, strongest (closest) first
#   mesh-presence <seconds>    custom scan window
#   mesh-presence --log        also append a snapshot line to ~/.mesh/presence.log
#   mesh-presence --loop [s]   scan + log every N sec (default 60); supervisable continuous sensor
#   mesh-presence --json       ONE structured record (status/count/types/proximity/churn/trend/
#                              attribution/personal_presence/familiarity/devices[]) instead of the
#                              prose block — every sibling sense (light/body-motion/wifi-motion/
#                              tamper) already has this; presence was the one core sense a consumer
#                              had to re-parse from dense key=val text. Honest-degraded: status=
#                              busy|suspect|suspect_wedge|unreachable carries the SAME exit code as
#                              the text path and nulls every field this scan never actually computed
#                              (never a fabricated count/attribution on a degraded read).
#   mesh-presence --test       smoke test (exit 0 if BT adapter ready)
#
# reflex-cadence: */10 * * * *
# reflex-args: --log
# Keeps ~/.mesh/presence.log fresh under the dash/sensorium 900s staleness threshold (mesh-sensorium
# marks the PRESENCE line STALE >15m). Only mesh-presence-fuse was cron'd (30m, writes a DIFFERENT
# file) so the raw presence sense drifted stale with no continuous loop/daemon — wired 2026-06-25.
#
# Read-only (BLE scan only; never connects). Exit 0 with a real scan artifact (including a genuine
# zero-device scan when the adapter knew no devices), exit 2 if the local Bluetooth sense is
# unreachable, exit 3 for a degraded read with NO trustworthy artifact — adapter scan-locked (BUSY)
# OR an n=0 that is SUSPECT (devices known but none gave a fresh RSSI = race-cleared cache, not an
# authoritative empty). Honest-fusion: a degraded read is never emitted as a confident empty.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"

classify_proximity() {
  local rssi="${1:-}"
  case "$rssi" in ''|*[!0-9-]*) echo UNKNOWN; return;; esac
  if [ "$rssi" -ge -55 ]; then echo IMMEDIATE
  elif [ "$rssi" -ge -70 ]; then echo NEAR
  elif [ "$rssi" -ge -85 ]; then echo ROOM
  else echo EDGE; fi
}

# median_csv <"r1,r2,...,rN"> → median RSSI integer (empty if no numeric values). Lower-middle for
# even counts (fine for dBm bucketing). Used to DEBOUNCE the proximity bucket: BLE RSSI jitters ±5-10
# dBm frame-to-frame, so a device sitting near a bucket boundary (e.g. -70 NEAR/ROOM) otherwise flaps.
median_csv() {
  printf '%s' "${1:-}" | tr ',' '\n' | grep -E '^-?[0-9]+$' | sort -n \
    | awk '{a[NR]=$1} END{ if(NR==0) exit; print a[int((NR+1)/2)] }'
}

# classify_proximity_smoothed <mac> <history_file> <instantaneous_rssi> → proximity bucket from the
# MEDIAN of the device's rolling RSSI window (a debounce). Falls back to the instantaneous reading when
# there are <2 samples (first sighting), so a new device still classifies immediately. FIDELITY ONLY on
# the bucket — the per-device line still reports the raw current RSSI; honest-degrades to UNKNOWN exactly
# as classify_proximity does when the value is non-numeric.
classify_proximity_smoothed() {
  local mac="$1" file="$2" inst="$3" csv med
  csv="$(grep "^${mac}|" "$file" 2>/dev/null | head -1 | cut -d'|' -f2)"
  case "$csv" in
    *,*) med="$(median_csv "$csv")"; [ -n "$med" ] && { classify_proximity "$med"; return; } ;;
  esac
  classify_proximity "$inst"
}

# qualify_empty <known_device_count> → EMPTY | SUSPECT. An n=0 scan is only a CONFIDENT empty when
# the adapter also knew no devices (EMPTY); if it knew devices but none gave a fresh RSSI, the cache
# was race-cleared or all are out-of-range → SUSPECT, never emitted as an authoritative all-clear.
qualify_empty() {
  [ "${1:-0}" -gt 0 ] 2>/dev/null && echo SUSPECT || echo EMPTY
}

# classify_personal_presence — ROOM-LEVEL signal: "what's the dominant personal-presence pattern
# in this room right now?" Derived from per-device attribution × trend × proximity. Captures in ONE
# token what a consumer (mesh-room-context, room-mind) would otherwise re-parse from the per-device
# lines, AND adds a directional signal (ARRIVING/DEPARTING) that no existing sense exposes.
#
# Bands (FALSIFIABLE via --test, each branch has a discriminated counter):
#   ACTIVE_NEAR   ≥1 personal device, dominant proximity IMMEDIATE/NEAR (and not moving)
#   ACTIVE_FAR    ≥1 personal device, dominant proximity ROOM/EDGE (and not moving)
#   ARRIVING      ≥1 personal device with clear APPROACHING direction (overrides proximity —
#                 a real human moving is more informative than just being in the room)
#   DEPARTING     ≥1 personal device with clear RECEDING direction
#   INITIAL       ≥1 personal device but all trend=INITIAL (just first-seen, no direction yet)
#   AMBIGUOUS     n>0 but no clear PERSONAL devices; only AMBIGUOUS (RANDOM-MAC) — could be a
#                 privacy-rotating person, UNVERIFIED
#   APPLIANCE     n>0, no personal, no ambiguous — only APPLIANCE-attribution devices (no person-zone)
#   EMPTY         n=0, no known devices (truly empty room; the wedge case is gated earlier as exit 3)
#   UNKNOWN       unreachable empty state (defensive; the wedge is already exit 3 above)
#
# Args: <pers_appr> <pers_rec> <pers_stab> <pers_init> <pers_near> <pers_far> <amb_count> <n>
classify_personal_presence() {
  local pa="$1" pr="$2" ps="$3" pi="$4" pnr="$5" pfr="$6" amb="$7" n="$8"
  local ptotal=$((pa+pr+ps+pi))
  # Personal direction takes priority (a moving person > a static one)
  if [ "$ptotal" -gt 0 ]; then
    local dir_total=$((pa+pr+ps))
    if [ "$dir_total" -gt 0 ]; then
      # ARRIVING: approaching > receding AND approaching > stable, with a real margin (≥2 above
      # the others' average — debounce against single-device noise)
      if [ "$pa" -ge "$pr" ] && [ "$pa" -ge "$ps" ] && [ "$pa" -gt $(( (pr+ps) / 2 + 1 )) ]; then
        echo "ARRIVING"; return
      fi
      # DEPARTING: receding > approaching AND receding > stable, with a real margin
      if [ "$pr" -ge "$pa" ] && [ "$pr" -ge "$ps" ] && [ "$pr" -gt $(( (pa+ps) / 2 + 1 )) ]; then
        echo "DEPARTING"; return
      fi
      # STABLE direction — classify by proximity
      if [ "$pnr" -gt 0 ]; then echo "ACTIVE_NEAR"; return; fi
      if [ "$pfr"  -gt 0 ]; then echo "ACTIVE_FAR";  return; fi
      # Direction counts >0 but proximity unclassifiable (e.g. all RSSI unknown) → conservative FAR
      echo "ACTIVE_FAR"; return
    fi
    # All personal are INITIAL — just first-seen, no direction yet
    if [ "$pnr" -gt 0 ]; then echo "ACTIVE_NEAR"; return; fi
    echo "ACTIVE_FAR"
    return
  fi
  # No PERSONAL devices at all
  if [ "$n" -eq 0 ]; then
    # Wedge (n=0 + known>0) is already exit 3 above; here only the truly-empty n=0 + known=0 path
    # reaches us. UNKNOWN is defensive (catches a future n=0 path that bypasses the wedge gate).
    echo "EMPTY"; return
  fi
  # n>0 but no personal — could be AMBIGUOUS (RANDOM-MAC devices, possibly a person) or pure APPLIANCE
  if [ "$amb" -gt 0 ]; then echo "AMBIGUOUS"; return; fi
  echo "APPLIANCE"
}

# wedge_empty <n> <known> <discovering> → WEDGE | EMPTY. qualify_empty's blind spot: a HOLLOW WEDGE
# (adapter Powered+Discovering yet perceiving nothing) ALSO blanks the device cache, so known==0 →
# qualify_empty grades it CONFIDENT EMPTY (the documented faked-all-clear, ble-adapter-wedges-hollow).
# Discriminate by the adapter fingerprint: our scan has ended and we hold the scan-lock, so a HEALTHY
# radio has quiesced (Discovering: no) while a wedge leaves discovery stuck-on. n=0 + known=0 +
# discovering=yes = wedge → SUSPECT, never an authoritative empty. Any contact (n>0/known>0) or a
# quiesced radio → EMPTY (a genuine vacancy still reads confidently empty).
wedge_empty() {
  { [ "${1:-0}" -eq 0 ] && [ "${2:-0}" -eq 0 ] && [ "${3:-no}" = yes ]; } 2>/dev/null && echo WEDGE || echo EMPTY
}

# --- RSSI trend tracking ---
# Rolling window of RSSI readings per MAC, stored in .presence-rssi-history.
# Format: one line per MAC, "MAC|rss1,rss2,...,rssN|last_seen_epoch" (csv up to TREND_WINDOW entries;
# the trailing epoch is additive — legacy "MAC|csv" 2-field lines still parse, see gap-aware note above).
# Trend classification compares first-half avg to second-half avg:
#   APPROACHING — signal improving (second-half avg > first-half avg + 5 dBm)
#   RECEDING    — signal degrading  (second-half avg < first-half avg - 5 dBm)
#   STABLE      — within noise floor (|delta| <= 5 dBm)
#   INITIAL     — only 1 sample (no direction yet)
# The 5 dBm threshold is ~1 order-of-magnitude in dBm (RSSI is logarithmic);
# real motion produces 10-20 dBm swings, so 5 dBm filters single-read noise.
TREND_WINDOW="${MESH_PRESENCE_TREND_WINDOW:-5}"
TREND_THRESHOLD="${MESH_PRESENCE_TREND_THRESHOLD:-5}"
# GAP-AWARE history (2026-06-25 fidelity): the rolling RSSI window is TIME-BLIND — it keeps the last N
# readings regardless of the gaps between them. At the */10 cron cadence a device that LEFT and RETURNED
# an hour later blends its stale pre-absence samples into the median (debounce) AND the trend, so a
# returning phone reads its OLD proximity/direction, not where it actually is now. Stamp each history
# line with a last-seen epoch: a sighting older than the GAP TTL starts a FRESH window (current visit
# only); lines older than the PRUNE TTL are dropped (bounds the file against dead transients + rotated
# random-MAC churn). The epoch is an ADDITIVE 3rd field — every existing reader does `cut -d'|' -f2`
# (the csv), so they are invariant; legacy 2-field lines (no epoch) are treated as never-gapped + kept.
HISTORY_GAP_TTL="${MESH_PRESENCE_HISTORY_GAP_TTL:-1800}"      # 30m unseen → returning device resets its window
HISTORY_PRUNE_TTL="${MESH_PRESENCE_HISTORY_PRUNE_TTL:-10800}" # 3h unseen → drop the dead MAC line
# TREND_FILE initialized after MESH is set (see below)

# ── VOLATILITY-COUPLED LEARNING RATE (Hierarchical Gaussian Filter — Mathys et al.) ───────────────
# LITERATURE (predictive processing & the Bayesian brain — an OPERATIONAL mechanism): the optimal
# update step for a belief is NOT fixed — it should scale with the ENVIRONMENT'S VOLATILITY. The
# Hierarchical Gaussian Filter (Christoph Mathys et al., "A Bayesian foundation for individual learning
# under uncertainty", Front. Hum. Neurosci. 5:39, 2011; "Uncertainty in perception and the Hierarchical
# Gaussian Filter", Front. Hum. Neurosci. 8:825, 2014) is the canonical operational mechanism: a higher
# level tracks the VOLATILITY of the level below and MODULATES its learning rate — high volatility ⇒ high
# learning rate (weight recent evidence, react fast); low volatility ⇒ low learning rate (integrate
# long, denoise). Dynamic-learning-rate variant: replace tonic volatility with a second random walk so
# volatility itself drifts. The core: ONE detector cannot be optimally sensitive across signals of
# DIFFERENT volatility — the rate must adapt per-signal.
#   THE GAP HERE: this trend detector uses a FIXED TREND_WINDOW (5) and a FIXED TREND_THRESHOLD (5 dBm)
#   for EVERY MAC — a fixed effective learning rate, blind to each device's intrinsic RSSI VOLATILITY.
#   A device with reliably jittery RSSI (high EXPECTED uncertainty — a flaky radio / multipath corner)
#   false-fires APPROACHING/RECEDING on noise; a device that has been ROCK-STABLE for hours (low expected
#   uncertainty) needs a SMALLER delta to flag a genuine move, yet must clear the same 5 dBm and so lags
#   real motion. The HGF prescription: couple the window/threshold (the learning rate) to that MAC's
#   recently-estimated RSSI volatility — integrate longer + demand a larger delta where the device is
#   intrinsically noisy, react faster where it has been quiet (an UNEXPECTED-uncertainty spike on a
#   previously-stable device = real motion).
#   DISTINCT from prior predictive-processing reviews: NOT aberrant-precision / noise-vs-volatility
#   (review-aberrant-precision-noise-vs-volatility, on mesh-precision) — that is the PRECISION WEIGHT
#   (how much a prediction error colors the fused estimate); THIS is the LEARNING RATE (how fast the
#   baseline/prior itself moves), a different parameter of the same generative model, on a different file
#   (a trend DETECTOR, not a reliability MEASURE). NOT epistemic-value/active-disambiguation
#   (review-epistemic-value-active-disambiguation — that is ACTION-side, which sense to actuate to reduce
#   uncertainty); this is perception-side update-rate. NOT noisy-TV reducible-vs-irreducible surprise
#   (mesh-novelty). NOT precision-weighting's small-world limit (mesh-precision, today).
#   HELD (instrument-first, steward/operator-gated): track a per-MAC RSSI volatility estimate (e.g. the
#   variance of recent deltas) and scale TREND_WINDOW / TREND_THRESHOLD from it, instead of the two fixed
#   constants. WHY HELD: a volatility-adaptive threshold could SUPPRESS genuine slow motion (over-smoothing
#   a "noisy" device) or chatter on a stable one if mis-tuned — it must be validated against the real
#   .presence-rssi-history (do adaptive params actually cut false APPROACHING/RECEDING without missing the
#   10-20 dBm real-motion swings the fixed 5 dBm was chosen to catch?) before replacing the constants.
#   INSTRUMENT-FIRST STEP SHIPPED (2026-07-06): the adaptive-THRESHOLD rewrite stays HELD (it could
#   over-smooth genuine slow motion), but its prerequisite — a per-MAC RSSI volatility estimate — now
#   ships as an ANNOTATION only: rssi_trend_conf() grades each directional trend FIRM|TENTATIVE by
#   whether the between-halves delta clears that MAC's own step-to-step jitter (consecutive-delta
#   pstdev). This is exactly the "variance of recent deltas" the HGF prescription names, surfaced as
#   trend_conf (per-device, --json) + trend_tentative (aggregate). It changes NO trend token or
#   threshold — 0 suppression risk — so a fusion consumer can discount noise-grade trends today AND the
#   real .presence-rssi-history now accumulates the FIRM/TENTATIVE signal the adaptive rewrite must be
#   validated against before it can replace the two constants.
#
# classify_trend <csv_of_rssis> → APPROACHING|RECEDING|STABLE|INITIAL
classify_trend() {
  local csv="$1"
  local count
  count="$(printf '%s' "$csv" | tr ',' '\n' | wc -l)"
  [ "$count" -ge 2 ] || { echo INITIAL; return; }

  local mid=$(( count / 2 ))
  # first half avg — use awk with NR guard for empty input
  local favg
  favg="$(printf '%s' "$csv" | tr ',' '\n' | head -n "$mid" | awk 'NR>0{s+=$1;n++}END{if(n>0)printf "%.1f",s/n;else print "0"}')"
  # second half avg
  local savg
  savg="$(printf '%s' "$csv" | tr ',' '\n' | tail -n +"$((mid+1))" | awk 'NR>0{s+=$1;n++}END{if(n>0)printf "%.1f",s/n;else print "0"}')"

  local delta
  delta="$(python3 -c "print(f'{$savg - $favg:.1f}')" 2>/dev/null || echo "0")"

  if python3 -c "exit(0 if float('$delta') > $TREND_THRESHOLD else 1)" 2>/dev/null; then
    echo APPROACHING
  elif python3 -c "exit(0 if float('$delta') < -$TREND_THRESHOLD else 1)" 2>/dev/null; then
    echo RECEDING
  else
    echo STABLE
  fi
}

# rssi_trend_conf <csv_of_rssis> → FIRM | TENTATIVE | NA — a signal-to-noise QUALIFIER on a
# directional trend (the instrument-first, 0-suppression first step toward the HELD volatility-coupled
# learning rate above). It ANNOTATES whether the between-halves RSSI shift that made classify_trend say
# APPROACHING/RECEDING actually clears the device's OWN step-to-step jitter — it does NOT change the
# trend token or TREND_THRESHOLD, so it cannot over-smooth a genuine slow trend (the exact risk that
# HELD the adaptive-threshold rewrite). A fusion consumer (room-sense personal_presence) can DISCOUNT a
# TENTATIVE ARRIVING/DEPARTING instead of trusting a noise-grade one.
#   NA        — no direction to qualify: STABLE/INITIAL (|delta| <= TREND_THRESHOLD) or < 2 samples
#   FIRM      — |between-halves delta| >= max(TREND_THRESHOLD, jitter_sd): the shift stands clear of noise
#   TENTATIVE — a directional delta that does NOT clear the device's own jitter (could be noise)
# jitter_sd = population stddev of the consecutive first-differences (r[i+1]-r[i]) — the device's
# intrinsic RSSI volatility, exactly the "variance of recent deltas" the HGF gap note names. A clean
# monotone ramp has near-zero jitter_sd (all steps equal) → FIRM; a device bouncing ±10 dBm has a large
# jitter_sd that a modest between-halves delta can't clear → TENTATIVE. FALSIFIABLE via --test.
rssi_trend_conf() {
  MPT="$TREND_THRESHOLD" python3 - "$1" <<'PY'
import sys, os, statistics
vals = []
for x in sys.argv[1].split(","):
    x = x.strip()
    try: vals.append(float(x))
    except Exception: pass
if len(vals) < 2:
    print("NA"); raise SystemExit
thr = float(os.environ.get("MPT", "5"))
mid = len(vals) // 2                      # matches classify_trend's head/tail split exactly
first, second = vals[:mid], vals[mid:]
favg = sum(first) / len(first) if first else 0.0
savg = sum(second) / len(second) if second else 0.0
delta = savg - favg
if abs(delta) <= thr:                     # not a directional trend (classify_trend → STABLE) → nothing to qualify
    print("NA"); raise SystemExit
diffs = [vals[i + 1] - vals[i] for i in range(len(vals) - 1)]
jitter_sd = statistics.pstdev(diffs) if len(diffs) >= 2 else 0.0
print("FIRM" if abs(delta) >= max(thr, jitter_sd) else "TENTATIVE")
PY
}

# Update rolling history for one MAC. Args: mac rssi history_file [now_epoch]
# Gap-aware: if the device's previous sighting is older than HISTORY_GAP_TTL, the stale pre-gap window
# is DISCARDED (the device left and came back — its old RSSI is not evidence about where it is now), so
# the median/trend reflect only the current visit. Every line is (re)written with a last-seen epoch
# AND a session_start epoch (additive 4th field, fidelity 2026-06-28) — when this CONTINUOUS session
# began. A line rewritten without a gap inherits its prev session_start; a gap-reset stamps now. Purely
# additive — every existing 3-field reader (cut -d'|' -f3 for last-seen) is unchanged.
update_rssi_history() {
  local mac="$1" rssi="$2" file="$3" now="${4:-$(date +%s)}"
  local line prev last session_start
  line="$(grep "^${mac}|" "$file" 2>/dev/null | head -1)"
  prev="$(printf '%s' "$line" | cut -d'|' -f2)"
  last="$(printf '%s' "$line" | cut -d'|' -f3)"
  session_start="$(printf '%s' "$line" | cut -d'|' -f4)"
  case "$last" in ''|*[!0-9]*) last="" ;; esac   # legacy/2-field or corrupt → treat as never-gapped
  case "$session_start" in ''|*[!0-9]*) session_start="" ;; esac   # legacy/3-field → treated below
  # stale-gap: a sighting older than the gap TTL → drop the pre-gap window, start fresh this visit
  if [ -n "$prev" ] && [ -n "$last" ] && [ "$(( now - last ))" -gt "$HISTORY_GAP_TTL" ]; then
    prev=""
    session_start=""
  fi
  # session_start inheritance: a continuous-session device keeps its original start; a gap-reset
  # (or a legacy 3-field line, or a first-seen device) gets a fresh stamp = now.
  [ -n "$session_start" ] || session_start="$now"
  local new_csv
  if [ -n "$prev" ]; then
    # append new reading, trim to TREND_WINDOW
    new_csv="${prev},${rssi}"
    local count
    count="$(printf '%s' "$new_csv" | tr ',' '\n' | wc -l)"
    if [ "$count" -ge "$TREND_WINDOW" ]; then
      new_csv="$(printf '%s' "$new_csv" | tr ',' '\n' | tail -n "$TREND_WINDOW" | tr '\n' ',' | sed 's/,$//')"
    fi
  else
    new_csv="$rssi"
  fi
  # replace the line, stamping the current sighting time as the additive 3rd field
  # and the current session's start time as the additive 4th field.
  sed -i "/^${mac}|/d" "$file" 2>/dev/null
  printf '%s|%s|%s|%s\n' "$mac" "$new_csv" "$now" "$session_start" >> "$file"
}

# Prune dead MACs from the history: drop any line whose last-seen epoch is older than HISTORY_PRUNE_TTL.
# Bounds the file against transients + rotated random-address churn (each privacy-MAC rotation otherwise
# leaves a permanent one-off line). Legacy lines with no/corrupt epoch ($3) are MIGRATED in place —
# stamped with `now` and kept — so they enter the TTL lifecycle and age out on a later run instead of
# lingering forever (the pre-stamp backlog was ~1.5k dead lines that would never self-heal, since a
# rotated random MAC is never seen again to gain an epoch on its own). A migrated line's stale csv is
# never used for trend unless that MAC reappears (then update_rssi_history's gap-reset handles it).
# The 4th session_start field (fidelity 2026-06-28) is preserved if present; legacy 3-field lines that
# get migrate-stamped gain a fresh session_start = now (migrated-stamp treats them as never-seen-before,
# so the familiarity classifier won't read a 4-month-old session as a 4-month-old "current" presence).
# Cheap: one awk pass.
prune_rssi_history() {
  local file="$1" now="${2:-$(date +%s)}" tmp
  [ -f "$file" ] || return 0
  tmp="$(mktemp 2>/dev/null)" || return 0
  if awk -F'|' -v now="$now" -v ttl="$HISTORY_PRUNE_TTL" '
       { last=$3; ss=$4
         if (last=="" || last !~ /^[0-9]+$/) { print $1"|"$2"|"now"|"now } # legacy/corrupt → migrate-stamp + fresh session_start
         else if ((now-last) <= ttl)         { print $1"|"$2"|"last"|"ss }   # fresh enough → keep (preserve session_start)
         # else: epoch older than the prune TTL → drop
       }' "$file" > "$tmp" 2>/dev/null; then
    # Migration pass for 3-field (legacy 3-field) lines: any line that has a numeric last-seen but no
    # 4th session_start field. These need a session_start stamp on the next prune so familiarity
    # doesn't read a 4-month-old continuous presence as 0s (a 3-field line becomes 4-field with
    # session_start=$now, treating it as a fresh-session device on the very next read). The migrate
    # runs SEPARATELY so the per-line prune logic above stays clean.
    awk -F'|' -v now="$now" '
      NF==3 && $3 ~ /^[0-9]+$/ { print $1"|"$2"|"$3"|"now; next }
      { print }
    ' "$tmp" > "$tmp.2" 2>/dev/null && mv "$tmp.2" "$tmp"
    mv "$tmp" "$file"
  else
    rm -f "$tmp"
  fi
}

# Read trend for one MAC from history file
get_trend() {
  local mac="$1" file="$2"
  local csv
  csv="$(grep "^${mac}|" "$file" 2>/dev/null | head -1 | cut -d'|' -f2)"
  [ -n "$csv" ] && classify_trend "$csv" || echo INITIAL
}

# Read the trend CONFIDENCE (FIRM|TENTATIVE|NA) for one MAC from the same history line.
get_trend_conf() {
  local mac="$1" file="$2"
  local csv
  csv="$(grep "^${mac}|" "$file" 2>/dev/null | head -1 | cut -d'|' -f2)"
  [ -n "$csv" ] && rssi_trend_conf "$csv" || echo NA
}

# ROOM FAMILIARITY (fidelity 2026-06-28): the existing 1-field state captures the CURRENT snapshot
# (count, churn, trend, attribution, personal_presence) but NOT how long the longest-running device
# has been continuously present. "All devices are <5min old" (STRANGER — could be a new arrival) and
# "longest device has been here 4h" (FAMILIAR — settled presence) are physically different room
# rhythms that the existing fields cannot tell apart. Distinct from `churn` (a per-scan Δ) and
# `trend` (RSSI direction over the rolling window) — FAMILIARITY is a session-AGE aggregator
# independent of proximity or movement.
#
#   classify_familiarity <max_session_age_s> → STRANGER|MIXED|FAMILIAR|INITIAL
#     INITIAL    no devices in range (no session to classify)
#     STRANGER   longest session < 5 min          — recent arrival / unfamiliar / first-seen
#     MIXED      5 min ≤ session < 30 min         — recently-arrived or transient occupancy
#     FAMILIAR   session ≥ 30 min                  — long-running presence, settled
# Bands (FALSIFIABLE: change the 300/1800 thresholds → tests flip). The 5/30 boundaries align with
# the 5/30 dwell bands used by mesh-tamper and mesh-light so cross-sense vocabulary stays consistent.
classify_familiarity() {
  local s="${1:-}"
  # INITIAL: empty / non-numeric / negative (= no devices in range, the honest no-presence case).
  # A 0s session is a real stranger (arrived in the current second), whereas negative (-1) means no devices.
  if [ -z "$s" ] || ! [ "$s" -ge 0 ] 2>/dev/null; then echo "INITIAL|no devices in range"; return; fi
  if [ "$s" -lt 300 ];  then echo "STRANGER|<5min (recent arrival)"; return; fi
  if [ "$s" -lt 1800 ]; then echo "MIXED|5-30min (transient presence)"; return; fi
  echo "FAMILIAR|30min+ (settled presence)"
}

# session_max_age <history_file> <now_epoch> → echoes integer seconds, the maximum session age among
# devices CURRENTLY seen in this scan (i.e. live within the gap TTL). A device with last-seen older
# than the gap TTL is in a separate, earlier session — its session_start is preserved in the file but
# does NOT count toward the "longest running device RIGHT NOW" measure (would manufacture a stale
# 4h-old "FAMILIAR" from a device that left an hour ago). Pure, file-bound.
session_max_age() {
  local f="$1" now="$2"
  [ -f "$f" ] || { echo -1; return; }
  awk -F'|' -v now="$now" -v gap="$HISTORY_GAP_TTL" '
    BEGIN { max = -1 }
    $4 ~ /^[0-9]+$/ && $3 ~ /^[0-9]+$/ {
      if ((now - $3) > gap) next         # not currently in a session (left + hasnt returned yet)
      age = now - $4
      if (age > max) max = age
    }
    END { print max }' "$f"
}

# Person-attributability split (2026-06-21): the appliance-vs-person trap — a TV/speaker/beacon
# advertises a named BLE device exactly like a phone, so a raw device COUNT (or even the type mix)
# cannot tell "a human is here" from "appliances are on" (see memory appliance-vs-person-fusion-trap).
# classify_device names the TYPE; this names what the device's presence is ATTRIBUTABLE TO:
#   PERSONAL  — carried/worn ON a body (phone, smartwatch, fitness band, earbuds, VR) → a (weak but
#               real) person-specific corroborator: a human is plausibly present.
#   APPLIANCE — a fixed fixture present whether or not a person is (TV, speaker, smart-scale, beacon).
#   AMBIGUOUS — unclassifiable name → neither asserted (honest: not folded into either bucket).
# Person-patterns are matched FIRST so a "Samsung Galaxy" phone resolves PERSONAL, not APPLIANCE on the
# bare *Samsung* (the TV pattern). This is a NEW derived field — existing types=/proximity= vocab is
# unchanged (cross-sense-vocab contract). It is a corroborator, NEVER sufficient alone for a person
# verdict: an unknown-name personal device may read AMBIGUOUS, and an appliance can spoof a worn name.
classify_attribution() {  # name [addrtype:public|random|unknown] → PERSONAL | APPLIANCE | AMBIGUOUS
  local name="$1" addrtype="${2:-}"
  case "$name" in
    # person-CARRIED / person-WORN — attributable to a human body being present
    *Phone*|*Redmi*|*Pixel*|*iPhone*|*Galaxy*|*OnePlus*|*Armor*|*Rugged*)        echo PERSONAL; return ;;
    *AirPods*|*Buds*|*Earbuds*|*Headphone*|*Watch*|*Band*|*Quest*|*Oculus*|*Pico*) echo PERSONAL; return ;;
    # fixed appliances / infrastructure — present independent of any person
    *TV*|*Samsung*|*LG*|*Bravia*|*Display*|*Monitor*)                            echo APPLIANCE; return ;;
    *Bose*|*SoundLink*|*JBL*|*Sony*|*Speaker*|*Soundbar*)                        echo APPLIANCE; return ;;
    *Scale*|*Weight*|*beacon*|*iBeacon*|*LE-*)                                   echo APPLIANCE; return ;;
  esac
  # Name is unclassifiable. Before falling to AMBIGUOUS, consult the BLE ADDRESS TYPE (classify_addrtype):
  # a RANDOM (locally-administered) address is a PRIVACY address that ONLY phones/wearables advertise
  # (they rotate identity for privacy) — fixed appliances use stable PUBLIC OUI addresses. So a nameless
  # random-addr contact is a (weak but spec-grounded) PERSON corroborator, recovering exactly the
  # "unknown-name personal device reads AMBIGUOUS" gap this field's own header acknowledges. Name ALWAYS
  # outranks addrtype (a named device is the stronger signal — handled by the returns above). PUBLIC/unknown
  # stays AMBIGUOUS: a nameless public MAC is NOT asserted APPLIANCE (too many device classes share public
  # OUIs — honest-degraded, never over-claimed). addrtype empty (legacy single-arg call) → AMBIGUOUS as before.
  case "$addrtype" in
    random) echo PERSONAL; return ;;
  esac
  echo AMBIGUOUS
}

# classify_addrtype — fidelity enrichment (2026-06-22) for UNNAMED ("?") devices: is the BLE address
# PUBLIC (universally-administered OUI → a fixed, vendor-identifiable appliance that simply isn't in our
# name-map) or RANDOM (a locally-administered BLE privacy address → typically a phone/wearable rotating
# its identity)? Turns an opaque "?" — including the CLOSEST device in the room — into an honest hint
# about WHAT the unidentified contact is, without claiming a name we don't have.
#
# Two sources, preferred-then-fallback (both honest, no DB/network):
#   1. AUTHORITATIVE: bluetoothctl's own "AddressType:" line from `info <mac>`, IF the stack emits it.
#      (Verified 2026-06-22: this node's bluetoothctl does NOT emit it — so source 2 carries the signal
#      here; the parse is kept so a stack that DOES emit it is used directly.)
#   2. FALLBACK from the MAC's locally-administered bit (0x02 of the first octet): BLE random addresses
#      (resolvable/non-resolvable/static — the privacy addresses phones & wearables advertise) are ALWAYS
#      locally administered; IEEE-assigned PUBLIC vendor addresses are universally administered. A real,
#      deterministic discriminator from bytes we already hold (e.g. Quest 4A→random, a TV 5C→public).
# A malformed/absent MAC with no AddressType → "unknown" (honest-degraded; never silently called public).
classify_addrtype() {  # <mac> [bluetoothctl-info-blob] → public | random | unknown
  local mac="$1" info="${2:-}" atype first
  atype="$(printf '%s' "$info" | sed -nE 's/^[[:space:]]*AddressType:[[:space:]]*([a-z]+).*/\1/p' | head -1)"
  case "$atype" in public) echo public; return ;; random) echo random; return ;; esac
  first="$(printf '%s' "$mac" | cut -d: -f1)"
  case "$first" in [0-9A-Fa-f][0-9A-Fa-f]) ;; *) echo unknown; return ;; esac
  if (( 0x$first & 0x2 )); then echo random; else echo public; fi
}

# emit_presence_json <status> [reason] — single-line JSON summary of the CURRENT scan, or a degraded
# status when the scan could not produce a trustworthy reading (status: ok|busy|suspect|suspect_wedge|
# unreachable). The already-computed aggregate fields (count/types/proximity/churn/trend/attribution/
# personal_presence/familiarity) plus a per-device array are read from the CALLER's globals (n, known,
# strongest_name, summary_types, ..., device_lines) — the same values the text path already prints, so
# this is purely a machine-readable parallel surface (cross-sense-vocab-contract: text output byte-
# identical, JSON only emitted when --json is passed). Honest-degraded: on any non-ok status the
# aggregate fields are explicitly null (not just empty/absent) — a JSON consumer reading status!=ok
# can never mistake "not computed" for "computed and genuinely zero/empty".
emit_presence_json() {
  local status="$1" reason="${2:-}"
  PSTATUS="$status" PREASON="$reason" PHOST="${HOST:-$(hostname)}" PTS="${ts:-$(date -u +%FT%TZ)}" \
  PN="${n:-}" PKNOWN="${known:-}" \
  PSTRONGNAME="${strongest_name:-}" PSTRONGRSSI="${strongest_rssi:-}" \
  PTYPES="${summary_types:-}" PPROX="${summary_proximity:-}" \
  PNEW="${new_count:-}" PGONE="${gone_count:-}" PSTABLE="${stable_count:-}" \
  PTA="${trend_approaching:-}" PTR="${trend_receding:-}" PTST="${trend_stable:-}" PTI="${trend_initial:-}" \
  PTT="${trend_tentative:-}" \
  PATP="${attr_personal:-}" PATA="${attr_appliance:-}" PATM="${attr_ambiguous:-}" \
  PUP="${unid_public:-}" PUR="${unid_random:-}" PUU="${unid_unknown:-}" \
  PPP="${pers_presence_tok:-}" PFAM="${familiarity_tok:-}" PSESS="${session_max_s:-}" \
  PDEVICES="${device_lines:-}" \
  python3 - <<'PY'
import json, os

def i(v):
    try: return int(v)
    except Exception: return None

def counts(s):
    d = {}
    for tok in (s or "").split():
        if ":" in tok:
            k, v = tok.split(":", 1)
            try: d[k] = int(v)
            except Exception: pass
    return d

status = os.environ["PSTATUS"]
rec = {"status": status, "host": os.environ["PHOST"], "ts": os.environ["PTS"]}
if os.environ.get("PREASON"):
    rec["reason"] = os.environ["PREASON"]
rec["count"] = i(os.environ.get("PN"))
rec["known"] = i(os.environ.get("PKNOWN"))
if status == "ok":
    sname = os.environ.get("PSTRONGNAME") or None
    rec["strongest"] = ({"name": sname, "rssi": i(os.environ.get("PSTRONGRSSI"))}
                         if sname and sname != "none" else None)
    rec["types"] = counts(os.environ.get("PTYPES"))
    rec["proximity"] = counts(os.environ.get("PPROX"))
    rec["churn"] = {"new": i(os.environ.get("PNEW")), "gone": i(os.environ.get("PGONE")),
                     "stable": i(os.environ.get("PSTABLE"))}
    rec["trend"] = {"approaching": i(os.environ.get("PTA")), "receding": i(os.environ.get("PTR")),
                     "stable": i(os.environ.get("PTST")), "initial": i(os.environ.get("PTI")),
                     "tentative": i(os.environ.get("PTT"))}
    rec["attribution"] = {"personal": i(os.environ.get("PATP")), "appliance": i(os.environ.get("PATA")),
                           "ambiguous": i(os.environ.get("PATM"))}
    rec["unidentified"] = {"public": i(os.environ.get("PUP")), "random": i(os.environ.get("PUR")),
                            "unknown": i(os.environ.get("PUU"))}
    rec["personal_presence"] = os.environ.get("PPP") or None
    rec["familiarity"] = os.environ.get("PFAM") or None
    sess = i(os.environ.get("PSESS"))
    rec["session_max_s"] = sess if (sess is not None and sess >= 0) else None
    devices = []
    for line in (os.environ.get("PDEVICES") or "").splitlines():
        if not line:
            continue
        parts = line.split("|")
        if len(parts) < 6:
            continue
        rssi, mac, name, dtype, prox, trend = parts[:6]
        trend_conf = parts[6] if len(parts) >= 7 else "NA"   # additive: legacy 6-field lines → NA
        devices.append({"rssi": i(rssi), "mac": mac, "name": name, "type": dtype,
                         "proximity": prox, "trend": trend, "trend_conf": trend_conf})
    rec["devices"] = devices
else:
    for k in ("strongest", "types", "proximity", "churn", "trend", "attribution",
              "unidentified", "personal_presence", "familiarity", "session_max_s", "devices"):
        rec[k] = None
print(json.dumps(rec, separators=(",", ":")))
PY
}

if [ "${1:-}" = --test ]; then
  command -v bluetoothctl >/dev/null 2>&1 || { echo "smoke-test: FAIL (no bluetoothctl)"; exit 1; }
  bluetoothctl show 2>/dev/null | grep -q 'Powered: yes' || { echo "smoke-test: FAIL (BT not powered)"; exit 1; }
  _f=0
  [ "$(classify_proximity -45)" = IMMEDIATE ] || { echo "  FAIL: -45 should be IMMEDIATE"; _f=1; }
  [ "$(classify_proximity -65)" = NEAR ] || { echo "  FAIL: -65 should be NEAR"; _f=1; }
  [ "$(classify_proximity -80)" = ROOM ] || { echo "  FAIL: -80 should be ROOM"; _f=1; }
  [ "$(classify_proximity -90)" = EDGE ] || { echo "  FAIL: -90 should be EDGE"; _f=1; }
  [ "$(classify_proximity nope)" = UNKNOWN ] || { echo "  FAIL: non-numeric should be UNKNOWN"; _f=1; }
  # median-smoothed proximity (debounce, FALSIFIABLE): median ignores a transient spike; <2 samples → instantaneous
  [ "$(median_csv "-70,-72,-68,-90,-69")" = "-70" ] || { echo "  FAIL: median_csv should be -70"; _f=1; }
  [ -z "$(median_csv "")" ] || { echo "  FAIL: median_csv of empty should be empty"; _f=1; }
  _mtd="$(mktemp -d)"; _mhf="$_mtd/h"
  printf '%s\n' 'AA:BB:CC:DD:EE:0F|-66,-67,-68,-90,-67' > "$_mhf"   # one -90 spike; median -67 → NEAR (not EDGE)
  [ "$(classify_proximity_smoothed AA:BB:CC:DD:EE:0F "$_mhf" -90)" = NEAR ] || { echo "  FAIL: smoothed should ignore the -90 spike → NEAR"; _f=1; }
  printf '%s\n' 'AA:BB:CC:DD:EE:1F|-80' > "$_mhf"                    # single sample → fall back to instantaneous
  [ "$(classify_proximity_smoothed AA:BB:CC:DD:EE:1F "$_mhf" -50)" = IMMEDIATE ] || { echo "  FAIL: <2 samples should use instantaneous → IMMEDIATE"; _f=1; }
  rm -rf "$_mtd"
  # honest-degraded empty qualifier (FALSIFIABLE): n=0 with known devices = SUSPECT (never faked empty)
  [ "$(qualify_empty 5)" = SUSPECT ] || { echo "  FAIL: n=0 with known devices should be SUSPECT"; _f=1; }
  [ "$(qualify_empty 0)" = EMPTY ] || { echo "  FAIL: n=0 with no known devices should be confident EMPTY"; _f=1; }
  [ "$(qualify_empty '')" = EMPTY ] || { echo "  FAIL: empty count should default to EMPTY"; _f=1; }
  # hollow-wedge discriminator (FALSIFIABLE): only n=0 + known=0 + discovery-stuck-on = WEDGE
  [ "$(wedge_empty 0 0 yes)" = WEDGE ] || { echo "  FAIL: n=0 known=0 discovering=yes should be WEDGE"; _f=1; }
  [ "$(wedge_empty 0 0 no)" = EMPTY ] || { echo "  FAIL: n=0 known=0 quiesced should be confident EMPTY"; _f=1; }
  [ "$(wedge_empty 0 0 '')" = EMPTY ] || { echo "  FAIL: missing discovery flag should default EMPTY (don't cry wedge on a read glitch)"; _f=1; }
  [ "$(wedge_empty 0 3 yes)" = EMPTY ] || { echo "  FAIL: known>0 is the cache-race SUSPECT path, not WEDGE"; _f=1; }
  [ "$(wedge_empty 2 0 yes)" = EMPTY ] || { echo "  FAIL: n>0 means devices seen, never WEDGE"; _f=1; }
  # trend classifier assertions (FALSIFIABLE: change threshold → assertion fails)
  [ "$(classify_trend "-60,-55,-50,-45,-40")" = APPROACHING ] || { echo "  FAIL: improving RSSI should be APPROACHING"; _f=1; }
  [ "$(classify_trend "-40,-45,-50,-55,-60")" = RECEDING ] || { echo "  FAIL: degrading RSSI should be RECEDING"; _f=1; }
  [ "$(classify_trend "-50,-51,-50,-49,-50")" = STABLE ] || { echo "  FAIL: steady RSSI should be STABLE"; _f=1; }
  [ "$(classify_trend "-50")" = INITIAL ] || { echo "  FAIL: single sample should be INITIAL"; _f=1; }
  [ "$(classify_trend "-60,-55,-50")" = APPROACHING ] || { echo "  FAIL: 3-sample improving should be APPROACHING"; _f=1; }
  # rssi_trend_conf: signal-to-noise QUALIFIER on directional trends (FALSIFIABLE both ways — drop the
  # jitter_sd term and the TENTATIVE case flips to FIRM; keep the token/threshold untouched so this can
  # never suppress a real trend). Verified by construction above the function.
  [ "$(rssi_trend_conf "-60,-55,-50,-45,-40")" = FIRM ]      || { echo "  FAIL: clean strong ramp (delta 12.5, jitter_sd 0) should be FIRM"; _f=1; }
  [ "$(rssi_trend_conf "-80,-78,-60,-45,-40")" = FIRM ]      || { echo "  FAIL: large move (delta ~31) must stay FIRM despite some jitter"; _f=1; }
  [ "$(rssi_trend_conf "-75,-70,-55,-80,-52")" = TENTATIVE ] || { echo "  FAIL: directional delta (~10) that can't clear jitter_sd (~20) must be TENTATIVE"; _f=1; }
  [ "$(rssi_trend_conf "-50,-51,-50,-49,-50")" = NA ]        || { echo "  FAIL: non-directional (STABLE) trend must be NA (nothing to qualify)"; _f=1; }
  [ "$(rssi_trend_conf "-50")" = NA ]                        || { echo "  FAIL: <2 samples must be NA"; _f=1; }
  # rolling history: append 3 readings, verify window trims to TREND_WINDOW
  _td="$(mktemp -d)"; _tf="$_td/history"
  update_rssi_history "AA:BB:CC:DD:EE:01" "-60" "$_tf"
  update_rssi_history "AA:BB:CC:DD:EE:01" "-55" "$_tf"
  update_rssi_history "AA:BB:CC:DD:EE:01" "-50" "$_tf"
  _csv="$(grep 'AA:BB:CC:DD:EE:01' "$_tf" | cut -d'|' -f2)"
  [ "$_csv" = "-60,-55,-50" ] || { echo "  FAIL: history csv expected '-60,-55,-50' got '$_csv'"; _f=1; }
  # append beyond window → trims to last TREND_WINDOW entries
  update_rssi_history "AA:BB:CC:DD:EE:01" "-45" "$_tf"
  update_rssi_history "AA:BB:CC:DD:EE:01" "-40" "$_tf"
  _csv="$(grep 'AA:BB:CC:DD:EE:01' "$_tf" | cut -d'|' -f2)"
  [ "$_csv" = "-55,-50,-45,-40" ] || [ "$_csv" = "-60,-55,-50,-45,-40" ] || { echo "  FAIL: trimmed history unexpected '$_csv'"; _f=1; }
  _tr="$(get_trend "AA:BB:CC:DD:EE:01" "$_tf")"
  [ "$_tr" = APPROACHING ] || { echo "  FAIL: 3-sample improving history should be APPROACHING, got '$_tr'"; _f=1; }
  rm -rf "$_td"
  # gap-aware history + prune (FALSIFIABLE: change the TTL gate → these flip)
  _gtd="$(mktemp -d)"; _ghf="$_gtd/h"; _gnow=1000000000
  printf '%s\n' "AA:BB:CC:DD:EE:02|-60,-58,-59|$((_gnow-4000))" > "$_ghf"   # last seen 4000s > 1800 gap TTL
  update_rssi_history "AA:BB:CC:DD:EE:02" "-80" "$_ghf" "$_gnow"
  [ "$(grep '^AA:BB:CC:DD:EE:02|' "$_ghf" | cut -d'|' -f2)" = "-80" ] || { echo "  FAIL: stale-gap device should reset to a fresh window"; _f=1; }
  printf '%s\n' "AA:BB:CC:DD:EE:03|-60,-58|$((_gnow-300))" > "$_ghf"        # 300s < gap TTL → normal append
  update_rssi_history "AA:BB:CC:DD:EE:03" "-57" "$_ghf" "$_gnow"
  [ "$(grep '^AA:BB:CC:DD:EE:03|' "$_ghf" | cut -d'|' -f2)" = "-60,-58,-57" ] || { echo "  FAIL: recent device should append, not reset"; _f=1; }
  printf '%s\n' "AA:BB:CC:DD:EE:04|-60,-58" > "$_ghf"                       # legacy 2-field (no epoch) → back-compat append
  update_rssi_history "AA:BB:CC:DD:EE:04" "-57" "$_ghf" "$_gnow"
  [ "$(grep '^AA:BB:CC:DD:EE:04|' "$_ghf" | cut -d'|' -f2)" = "-60,-58,-57" ] || { echo "  FAIL: legacy no-epoch line should append (back-compat)"; _f=1; }
  [ "$(grep '^AA:BB:CC:DD:EE:04|' "$_ghf" | cut -d'|' -f3)" = "$_gnow" ] || { echo "  FAIL: updated line must carry the now epoch as 3rd field"; _f=1; }
  printf '%s\n' "OLD:00|-60|$((_gnow-20000))" "NEW:00|-60|$((_gnow-100))" "LEG:00|-60" > "$_ghf"
  prune_rssi_history "$_ghf" "$_gnow"
  grep -q '^OLD:00|' "$_ghf" && { echo "  FAIL: prune should drop a MAC older than the prune TTL"; _f=1; }
  grep -q '^NEW:00|' "$_ghf" || { echo "  FAIL: prune should keep a recently-seen MAC"; _f=1; }
  grep -q '^LEG:00|' "$_ghf" || { echo "  FAIL: prune should keep a legacy (no-epoch) line"; _f=1; }
  [ "$(grep '^LEG:00|' "$_ghf" | cut -d'|' -f3)" = "$_gnow" ] || { echo "  FAIL: prune should MIGRATE-stamp a legacy line with now (so it ages out, not lingers forever)"; _f=1; }
  rm -rf "$_gtd"
  # person-attributability split (FALSIFIABLE: the appliance-vs-person line the trap needs)
  [ "$(classify_attribution "iPhone 14")" = PERSONAL ]        || { echo "  FAIL: phone should be PERSONAL"; _f=1; }
  [ "$(classify_attribution "Mi Smart Band 7")" = PERSONAL ]  || { echo "  FAIL: fitness band should be PERSONAL"; _f=1; }
  [ "$(classify_attribution "Galaxy Buds Pro")" = PERSONAL ]  || { echo "  FAIL: earbuds should be PERSONAL"; _f=1; }
  [ "$(classify_attribution "[TV] Samsung 5 Series")" = APPLIANCE ] || { echo "  FAIL: TV should be APPLIANCE"; _f=1; }
  [ "$(classify_attribution "Bose SoundLink")" = APPLIANCE ]  || { echo "  FAIL: speaker should be APPLIANCE"; _f=1; }
  [ "$(classify_attribution "?")" = AMBIGUOUS ]               || { echo "  FAIL: unknown name should be AMBIGUOUS"; _f=1; }
  # the discriminating case: a Samsung *phone* must NOT collapse to APPLIANCE on the bare *Samsung* (TV) pattern
  [ "$(classify_attribution "Samsung Galaxy S21")" = PERSONAL ] || { echo "  FAIL: Samsung Galaxy phone must be PERSONAL, not APPLIANCE"; _f=1; }
  [ "$(classify_attribution "iPhone")" != "$(classify_attribution "Samsung 5 Series")" ] || { echo "  FAIL: person vs appliance must be distinguishable"; _f=1; }
  # --classify CLI exposure dispatches to the SAME classifier (single-source; consumers reuse it,
  # never re-implement the person/appliance pattern lists → no cross-sense-vocab drift)
  [ "$( "$0" --classify "iPhone 14" )" = PERSONAL ] || { echo "  FAIL: --classify CLI should dispatch to classifier (PERSONAL)"; _f=1; }
  [ "$( "$0" --classify "[TV] Samsung 5 Series" )" = APPLIANCE ] || { echo "  FAIL: --classify CLI should return APPLIANCE"; _f=1; }
  # --classify CLI must FORWARD the optional addrtype 2nd arg (the 2026-06-26 gap: the dispatch dropped
  # it, so a nameless RANDOM-addr device read AMBIGUOUS at the CLI even though classify_attribution
  # would fuse it PERSONAL — leaving cross-node person-zone perpetually UNKNOWN).
  [ "$( "$0" --classify "?" random )" = PERSONAL ]  || { echo "  FAIL: --classify CLI must forward addrtype 2nd arg (nameless RANDOM → PERSONAL)"; _f=1; }
  [ "$( "$0" --classify "?" public )" = AMBIGUOUS ] || { echo "  FAIL: --classify CLI nameless PUBLIC must stay AMBIGUOUS"; _f=1; }
  # --addrtype CLI exposes the MAC→address-type discriminator as single source (consumers derive the
  # personal corroborator from a MAC without re-implementing the U/L-bit logic).
  [ "$( "$0" --addrtype "4A:18:79:30:A3:0F" )" = random ] || { echo "  FAIL: --addrtype CLI locally-administered MAC → random"; _f=1; }
  [ "$( "$0" --addrtype "64:3E:0F:48:72:3E" )" = public ] || { echo "  FAIL: --addrtype CLI universally-administered MAC → public"; _f=1; }
  [ "$( "$0" --addrtype "zz:zz" )" = unknown ]           || { echo "  FAIL: --addrtype CLI malformed MAC → unknown (never silently public)"; _f=1; }
  # MAC address-type enrichment (FALSIFIABLE on both sources: authoritative AddressType + MAC U/L-bit fallback)
  [ "$(classify_addrtype "AA:BB:CC:DD:EE:FF" "$(printf 'Name: x\n\tAddressType: public\n')")" = public ] || { echo "  FAIL: authoritative AddressType public"; _f=1; }
  [ "$(classify_addrtype "64:3E:0F:48:72:3E" "$(printf '\tAddressType: random\n')")" = random ] || { echo "  FAIL: authoritative AddressType random must override public-looking MAC"; _f=1; }
  [ "$(classify_addrtype "4A:18:79:30:A3:0F" "")" = random ] || { echo "  FAIL: locally-administered MAC (0x4A&0x02) should be random"; _f=1; }
  [ "$(classify_addrtype "64:3E:0F:48:72:3E" "")" = public ] || { echo "  FAIL: universally-administered MAC (0x64&0x02=0) should be public"; _f=1; }
  [ "$(classify_addrtype "zz:zz" "")" = unknown ] || { echo "  FAIL: malformed MAC with no AddressType must be unknown, never silently public"; _f=1; }
  # attribution × addrtype FUSION (2026-06-26 fidelity): a NAMELESS contact's BLE address type breaks the
  # AMBIGUOUS tie. RANDOM (privacy-rotating) → PERSONAL (phone/wearable hint); PUBLIC/unknown/absent stay
  # AMBIGUOUS (never over-claimed APPLIANCE). Name OUTRANKS addrtype (a named device keeps its name verdict).
  [ "$(classify_attribution "?" random)"  = PERSONAL ]   || { echo "  FAIL: nameless RANDOM addr should fuse to PERSONAL (privacy-rotating = person device)"; _f=1; }
  [ "$(classify_attribution "?" public)"  = AMBIGUOUS ]  || { echo "  FAIL: nameless PUBLIC addr must stay AMBIGUOUS (not over-claimed APPLIANCE)"; _f=1; }
  [ "$(classify_attribution "?" unknown)" = AMBIGUOUS ]  || { echo "  FAIL: nameless unknown-addr must stay AMBIGUOUS"; _f=1; }
  [ "$(classify_attribution "?")"         = AMBIGUOUS ]  || { echo "  FAIL: nameless with NO addrtype must stay AMBIGUOUS (legacy single-arg back-compat)"; _f=1; }
  [ "$(classify_attribution "iPhone" public)"        = PERSONAL ]  || { echo "  FAIL: named person device must OUTRANK a public addr → PERSONAL"; _f=1; }
  [ "$(classify_attribution "Bose SoundLink" random)" = APPLIANCE ] || { echo "  FAIL: named appliance must OUTRANK a random addr → APPLIANCE"; _f=1; }
  # personal_presence (room-level, FALSIFIABLE: change the margin/dominance rule → these flip)
  # Direction overrides proximity when the margin is clear (> runner-up/2 + 1).
  [ "$(classify_personal_presence 3 0 0 0 2 1 0 4)" = ARRIVING ]   || { echo "  FAIL: 3 appr/0 rec/0 stab should ARRIVE"; _f=1; }
  [ "$(classify_personal_presence 0 3 0 0 1 2 0 4)" = DEPARTING ]  || { echo "  FAIL: 0 appr/3 rec/0 stab should DEPART"; _f=1; }
  # STABLE + dominant proximity → ACTIVE_NEAR/ACTIVE_FAR
  [ "$(classify_personal_presence 0 0 2 0 2 0 0 3)" = ACTIVE_NEAR ] || { echo "  FAIL: 2 stable personal with 2 NEAR should ACTIVE_NEAR"; _f=1; }
  [ "$(classify_personal_presence 0 0 2 0 0 2 0 3)" = ACTIVE_FAR ]  || { echo "  FAIL: 2 stable personal with 0 NEAR/2 FAR should ACTIVE_FAR"; _f=1; }
  # All INITIAL (just first-seen) → ACTIVE_FAR/NEAR by proximity
  [ "$(classify_personal_presence 0 0 0 2 1 1 0 3)" = ACTIVE_NEAR ] || { echo "  FAIL: 2 INITIAL personal with NEAR should ACTIVE_NEAR"; _f=1; }
  [ "$(classify_personal_presence 0 0 0 2 0 2 0 3)" = ACTIVE_FAR ]  || { echo "  FAIL: 2 INITIAL personal with 0 NEAR should ACTIVE_FAR"; _f=1; }
  # Tie / small margin: direction should NOT override — falls through to proximity, NEAR wins ties
  [ "$(classify_personal_presence 1 1 1 0 1 1 0 3)" = ACTIVE_NEAR ] || { echo "  FAIL: 1/1/1 tied direction with 1 NEAR/1 FAR should ACTIVE_NEAR (proximity wins on no-clear-direction)"; _f=1; }
  # No personal at all — empty room, no wedge here (that's exit 3 above)
  [ "$(classify_personal_presence 0 0 0 0 0 0 0 0)" = EMPTY ]       || { echo "  FAIL: no devices should be EMPTY"; _f=1; }
  # No personal + only AMBIGUOUS (RANDOM-MAC) — could be a privacy-rotating person
  [ "$(classify_personal_presence 0 0 0 0 0 0 2 2)" = AMBIGUOUS ]   || { echo "  FAIL: n>0, no personal, 2 AMBIGUOUS should be AMBIGUOUS"; _f=1; }
  # No personal + only APPLIANCE-attribution — no person-zone signal
  [ "$(classify_personal_presence 0 0 0 0 0 0 0 3)" = APPLIANCE ]   || { echo "  FAIL: n>0, no personal, no ambiguous should be APPLIANCE"; _f=1; }
  [ "$_f" = 0 ] || { echo "smoke-test: FAIL"; exit 1; }
  # --- FAMILIARITY classifier + session_max_age (fidelity 2026-06-28) ---
  # FALSIFIABLE: change the 300/1800 thresholds → these flip.
  _ff=0
  # INITIAL: no devices (s=-1)
  r="$(classify_familiarity -1)"
  echo "$r" | grep -q '^INITIAL' || { echo "  FAIL familiarity INITIAL -1s: got=$r"; _ff=1; }
  # STRANGER: 0s (device arrived this second)
  r="$(classify_familiarity 0)"
  echo "$r" | grep -q '^STRANGER' || { echo "  FAIL familiarity STRANGER 0s: got=$r"; _ff=1; }
  # INITIAL: empty / non-numeric
  r="$(classify_familiarity '')"
  echo "$r" | grep -q '^INITIAL' || { echo "  FAIL familiarity INITIAL empty: got=$r"; _ff=1; }
  # STRANGER: 299s (just under 5min boundary)
  r="$(classify_familiarity 299)"
  echo "$r" | grep -q '^STRANGER' || { echo "  FAIL familiarity STRANGER 299s: got=$r"; _ff=1; }
  # STRANGER: 60s
  r="$(classify_familiarity 60)"
  echo "$r" | grep -q '^STRANGER' || { echo "  FAIL familiarity STRANGER 60s: got=$r"; _ff=1; }
  # MIXED: 300s (boundary)
  r="$(classify_familiarity 300)"
  echo "$r" | grep -q '^MIXED' || { echo "  FAIL familiarity MIXED 300s: got=$r"; _ff=1; }
  # MIXED: 1500s
  r="$(classify_familiarity 1500)"
  echo "$r" | grep -q '^MIXED' || { echo "  FAIL familiarity MIXED 1500s: got=$r"; _ff=1; }
  # FAMILIAR: 1800s (boundary)
  r="$(classify_familiarity 1800)"
  echo "$r" | grep -q '^FAMILIAR' || { echo "  FAIL familiarity FAMILIAR 1800s: got=$r"; _ff=1; }
  # FAMILIAR: 86400s (24h)
  r="$(classify_familiarity 86400)"
  echo "$r" | grep -q '^FAMILIAR' || { echo "  FAIL familiarity FAMILIAR 86400s: got=$r"; _ff=1; }
  # session_max_age: pure, file-bound. Build a synthetic history file.
  _ftd="$(mktemp -d)"; _fhf="$_ftd/h"; _fnow=1000000000
  # One device with session_start = now-300, last_seen = now-30 → currently-in-session, age=300
  printf 'AA:BB:CC:DD:EE:01|-50,-50|%d|%d\n' $((_fnow-30)) $((_fnow-300)) > "$_fhf"
  # A second device, session_start = now-4000, last_seen = now-5000 (>gap TTL=1800) → NOT current
  printf 'BB:CC:DD:EE:FF:02|-50|%d|%d\n' $((_fnow-5000)) $((_fnow-4000)) >> "$_fhf"
  # A third device, session_start = now-200, last_seen = now → current, age=200
  printf 'CC:DD:EE:FF:00:03|-50|%d|%d\n' "$_fnow" $((_fnow-200)) >> "$_fhf"
  _mx="$(session_max_age "$_fhf" "$_fnow")"
  [ "$_mx" = "300" ] || { echo "  FAIL session_max_age: max of (300, 200)=300, got=$_mx"; _ff=1; }
  rm -rf "$_ftd"
  # Empty history file → -1
  _etd="$(mktemp -d)"; _ehf="$_etd/h"
  _em="$(session_max_age "$_ehf" "$_fnow")"
  [ "$_em" = "-1" ] || { echo "  FAIL session_max_age: empty file → -1, got=$_em"; _ff=1; }
  rm -rf "$_etd"
  [ "$_ff" = 0 ] || { echo "smoke-test: FAIL (familiarity + session_max_age assertions)"; exit 1; }
  # --- emit_presence_json fixtures (pure — sets the globals the emitter reads, no BLE scan) ---
  _jf=0
  HOST="testhost"; ts="2026-07-04T12:00:00Z"
  n=3; known=3; strongest_name="iPhone 14"; strongest_rssi="-52"
  summary_types="PHONE:1 TV:1 "; summary_proximity="IMMEDIATE:1 ROOM:1 "
  new_count=1; gone_count=0; stable_count=2
  trend_approaching=1; trend_receding=0; trend_stable=1; trend_initial=1; trend_tentative=1
  attr_personal=1; attr_appliance=1; attr_ambiguous=1
  unid_public=0; unid_random=1; unid_unknown=0
  pers_presence_tok="ACTIVE_NEAR"; familiarity_tok="MIXED"; session_max_s=600
  # device 1 carries the additive 7th trend_conf field; device 2 is a LEGACY 6-field line → parser defaults NA
  device_lines="-52|AA:BB:CC:DD:EE:01|iPhone 14|PHONE|IMMEDIATE|APPROACHING|TENTATIVE"$'\n'"-80|AA:BB:CC:DD:EE:02|[TV] Samsung|TV|ROOM|STABLE"$'\n'
  _jrec="$(emit_presence_json ok)"
  printf '%s' "_jrec" >/dev/null  # (silence unused-var linters on some shells)
  printf '%s' "$_jrec" | python3 -c 'import json,sys
d=json.load(sys.stdin)
assert d["status"]=="ok" and d["count"]==3 and d["known"]==3, d
assert d["strongest"]=={"name":"iPhone 14","rssi":-52}, d
assert d["types"]=={"PHONE":1,"TV":1}, d
assert d["proximity"]=={"IMMEDIATE":1,"ROOM":1}, d
assert d["churn"]=={"new":1,"gone":0,"stable":2}, d
assert d["attribution"]=={"personal":1,"appliance":1,"ambiguous":1}, d
assert d["personal_presence"]=="ACTIVE_NEAR" and d["familiarity"]=="MIXED" and d["session_max_s"]==600, d
assert d["trend"]["tentative"]==1, d
assert len(d["devices"])==2 and d["devices"][0]["mac"]=="AA:BB:CC:DD:EE:01" and d["devices"][0]["proximity"]=="IMMEDIATE", d
assert d["devices"][0]["trend_conf"]=="TENTATIVE", d
assert d["devices"][1]["trend_conf"]=="NA", d   # legacy 6-field line → NA, never a fabricated confidence
' 2>/dev/null || { echo "  FAIL: emit_presence_json ok record malformed (got: $_jrec)"; _jf=1; }
  # session_max_s=-1 (no current session) must render null, not a fake -1 age
  session_max_s=-1
  _jrec2="$(emit_presence_json ok)"
  printf '%s' "$_jrec2" | python3 -c 'import json,sys; d=json.load(sys.stdin); assert d["session_max_s"] is None, d' 2>/dev/null \
    || { echo "  FAIL: session_max_s=-1 should render null (got: $_jrec2)"; _jf=1; }
  # Honest-degraded: a non-ok status nulls every aggregate field — count/known survive (real, if known
  # at the time of the call) but nothing downstream of them is fabricated.
  n=0; known=4
  _jrec3="$(emit_presence_json suspect "cache cleared by a concurrent scan")"
  printf '%s' "$_jrec3" | python3 -c 'import json,sys
d=json.load(sys.stdin)
assert d["status"]=="suspect" and d["reason"]=="cache cleared by a concurrent scan", d
assert d["count"]==0 and d["known"]==4, d
for k in ("strongest","types","proximity","churn","trend","attribution","unidentified","personal_presence","familiarity","session_max_s","devices"):
    assert d[k] is None, (k, d)
' 2>/dev/null || { echo "  FAIL: emit_presence_json suspect record must null every aggregate field (got: $_jrec3)"; _jf=1; }
  # unreachable path: no scan ran at all, count/known also unknown (never fabricated as 0)
  unset n known
  _jrec4="$(emit_presence_json unreachable "adapter not powered")"
  printf '%s' "$_jrec4" | python3 -c 'import json,sys
d=json.load(sys.stdin)
assert d["status"]=="unreachable" and d["reason"]=="adapter not powered", d
assert d["count"] is None and d["known"] is None, d
' 2>/dev/null || { echo "  FAIL: emit_presence_json unreachable record wrong (got: $_jrec4)"; _jf=1; }
  unset HOST ts n known strongest_name strongest_rssi summary_types summary_proximity \
    new_count gone_count stable_count trend_approaching trend_receding trend_stable trend_initial trend_tentative \
    attr_personal attr_appliance attr_ambiguous unid_public unid_random unid_unknown \
    pers_presence_tok familiarity_tok session_max_s device_lines
  [ "$_jf" = 0 ] || { echo "smoke-test: FAIL (emit_presence_json assertions)"; exit 1; }
  echo "smoke-test: ok (BT ready + proximity:5 + median-smooth:4 + qualify-empty:3 + wedge-empty:5 + trend:5 + trend-conf:5 + rolling-history:3 + gap-aware+prune:6 + attribution:8 + classify-cli:5 + addrtype-cli:3 + addrtype:5 + attr×addrtype-fusion:6 + personal-presence:10 + familiarity:8 + session_max_age:2 + presence-json:4 assertions)"; exit 0
fi
# --classify <name> [addrtype:public|random|unknown]: pure name→class lookup
# (PERSONAL|APPLIANCE|AMBIGUOUS), NO BLE scan. Single source of the person-vs-appliance classifier so
# consumers (mesh-presence-fuse's zonal map) never duplicate the pattern lists and drift from this
# sense's vocab. The OPTIONAL 2nd arg is the BLE address type: a nameless RANDOM (privacy) address
# resolves PERSONAL where name alone reads AMBIGUOUS — so cross-node consumers can recover unnamed
# phones/wearables (the dual-vantage person-zone gap). Honest: an empty/missing name → AMBIGUOUS.
if [ "${1:-}" = --classify ]; then
  classify_attribution "${2:-}" "${3:-}"; exit 0
fi
# --addrtype <mac> [bluetoothctl-info-blob]: pure MAC→address-type lookup (public|random|unknown), NO
# BLE scan. Single source of the address-type discriminator so consumers derive the personal-device
# corroborator (random = locally-administered privacy address) from a MAC without re-implementing the
# U/L-bit logic. Honest: a malformed/absent MAC → unknown (never silently public).
if [ "${1:-}" = --addrtype ]; then
  classify_addrtype "${2:-}" "${3:-}"; exit 0
fi
if [ "${1:-}" = --loop ]; then
  iv="${2:-60}"
  echo "[mesh-presence] continuous BLE scan every ${iv}s on $(hostname)"
  while true; do
    : > "${HOME}/.mesh/mesh-presence.beat"
    "$0" --log 2>/dev/null || true
    sleep "$iv"
  done
  exit 0
fi

WIN=10; LOGIT=0; json_mode=0
for a in "$@"; do case "$a" in --log) LOGIT=1;; --json) json_mode=1;; [0-9]*) WIN="$a";; esac; done
HOST="$(hostname)"; MESH="$HOME/.mesh"; LOG="$MESH/presence.log"; mkdir -p "$MESH"
TREND_FILE="$MESH/.presence-rssi-history"
command -v bluetoothctl >/dev/null 2>&1 || {
  [ "$json_mode" = 1 ] && emit_presence_json unreachable "no bluetoothctl"
  echo "mesh-presence: no bluetoothctl" >&2; exit 1
}
bluetoothctl show 2>/dev/null | grep -q 'Powered: yes' || {
  [ "$json_mode" = 1 ] && emit_presence_json unreachable "BT adapter not powered"
  echo "mesh-presence: BT adapter not powered — BLE sense unreachable" >&2; exit 2
}

# Single-writer the adapter. BlueZ keeps ONE discovery session per adapter, ref-counted per
# D-Bus client; when concurrent scanners overlap, one client's scan-off clears the RSSI cache
# while another is mid-query → a clean-but-empty result that masquerades as "0 devices in range".
# Serialize scans with a lock so callers take turns instead of colliding. If the lock genuinely
# can't be acquired (a wedged holder), report BUSY with a distinct exit (3) — never a spurious 0
# (empty ≠ failed). Lock auto-releases when this process exits (fd 9 closes); --loop re-acquires
# per iteration since each scan is a fresh "$0" subprocess.
if command -v flock >/dev/null 2>&1; then
  exec 9>"$MESH/presence.scan.lock"
  if ! flock -w $(( WIN + 25 )) 9; then
    ts="$(date -u +%FT%TZ)"
    if [ "$json_mode" = 1 ]; then
      emit_presence_json busy "adapter scan-locked by another scanner > $((WIN+25))s"
    else
      echo "=== mesh-presence $HOST @ $ts — BUSY (adapter scan-locked by another scanner > $((WIN+25))s; NOT an empty reading) ==="
    fi
    exit 3
  fi
fi

# Settle the adapter before we StartDiscovery. The flock serializes scans, but a prior holder's
# StopDiscovery can still be DRAINING at the instant it releases the lock (BlueZ adapter-level
# discovery-off is async, issued before the holder exits). Starting our scan into that teardown is
# the ref-count race that clears the RSSI cache → a spurious 0 (observed 2026-06-18: a manual scan
# read 0 while raw bluetoothctl saw 6 devices; retry read 7). A short settle lets the handoff finish.
sleep 0.4

# hold an active scan for WIN seconds (pipe stays open → bluetoothctl keeps scanning), query during it
{ echo "scan on"; sleep "$WIN"; } | bluetoothctl >/dev/null 2>&1 &
scanpid=$!
sleep $(( WIN > 3 ? WIN - 2 : 1 ))   # let discovery populate, query while scan still live

ts="$(date -u +%FT%TZ)"; NOW="$(date +%s)"; rows=""; n=0; known=0
unid_public=0; unid_random=0; unid_unknown=0   # address-type split of UNNAMED ("?") contacts
for mac in $(bluetoothctl devices 2>/dev/null | awk '/^Device/{print $2}'); do
  known=$((known+1))               # devices the adapter knows (cache) — used to qualify an n=0 read
  info="$(bluetoothctl info "$mac" 2>/dev/null)"
  rssi="$(printf '%s' "$info" | grep -oE 'RSSI: 0x[0-9a-f]+ \(-?[0-9]+\)' | grep -oE '\(-?[0-9]+\)' | tr -d '()')"
  [ -n "$rssi" ] || continue   # no fresh RSSI = not currently in range
  name="$(printf '%s' "$info" | sed -nE 's/^\s*Name: (.*)/\1/p' | head -1)"; name="${name:-?}"
  if [ "$name" = "?" ]; then    # unnamed contact → classify its BLE address type for an honest hint
    case "$(classify_addrtype "$mac" "$info")" in
      public) unid_public=$((unid_public+1)) ;;
      random) unid_random=$((unid_random+1)) ;;
      *)      unid_unknown=$((unid_unknown+1)) ;;
    esac
  fi
  rows="${rows}${rssi}|${mac}|${name}"$'\n'
  n=$((n+1))
done
wait "$scanpid" 2>/dev/null || true

# Honest-degraded path (2026-06-21): an n=0 read is AMBIGUOUS — a genuinely empty room and a
# race-cleared RSSI cache (the documented spurious-zero: a concurrent scanner's scan-off blanks every
# device's RSSI mid-query → all devices skipped) are indistinguishable from the count alone, and the
# bare "0 device(s) in range" silently poisons presence-fuse/perimeter/situation with a FALSE all-clear.
# Qualify by the cache: if the adapter knew devices but NONE yielded a fresh RSSI, the signal was
# cleared/out-of-range → SUSPECT, not authoritative-empty → emit a degraded reading and exit 3 (the
# same "no reliable read" code as adapter-busy), never a faked empty. known==0 stays a confident EMPTY.
if [ "$n" -eq 0 ] && [ "$(qualify_empty "$known")" = SUSPECT ]; then
  if [ "$json_mode" = 1 ]; then
    emit_presence_json suspect "0 of $known known device(s) gave a fresh RSSI (cache cleared by a concurrent scan OR all out-of-range)"
  else
    echo "=== mesh-presence $HOST @ $ts — SUSPECT: 0 of $known known device(s) gave a fresh RSSI (cache cleared by a concurrent scan OR all out-of-range) — NOT an authoritative empty ==="
  fi
  [ "$LOGIT" = 1 ] && echo "$ts $HOST n=0 SUSPECT known=$known" >> "$LOG"
  exit 3
fi

# Hollow-wedge guard (2026-06-25): n=0 with known=0 grades CONFIDENT EMPTY above — but a wedged radio
# ALSO blanks the cache (known=0), slipping through as a faked all-clear (the documented blind spot
# that a 42h-dark adapter and ds's USB adapter both hit). Discriminate by the adapter fingerprint: our
# scan has ended (wait above) and we hold the scan-lock, so a HEALTHY adapter has quiesced
# (Discovering: no); a wedge leaves discovery stuck-on. Let the async StopDiscovery drain, then sample
# the flag — stuck-on + zero contacts = wedge → degraded exit 3, never an authoritative empty. A
# genuine vacancy (healthy, quiesced) still reads confidently EMPTY below.
if [ "$n" -eq 0 ] && [ "$known" -eq 0 ]; then
  sleep 1.5   # let our scan's async StopDiscovery drain on a healthy adapter before sampling the flag
  disc="$(bluetoothctl show 2>/dev/null | sed -nE 's/.*Discovering:[[:space:]]*(yes|no).*/\1/p' | head -1)"
  if [ "$(wedge_empty "$n" "$known" "${disc:-no}")" = WEDGE ]; then
    if [ "$json_mode" = 1 ]; then
      emit_presence_json suspect_wedge "0 device(s) AND discovery stuck-on after scan — suspected wedged radio (Powered+Discovering but hollow)"
    else
      echo "=== mesh-presence $HOST @ $ts — SUSPECT(wedge): 0 device(s) AND discovery stuck-on after scan — suspected wedged radio (Powered+Discovering but hollow); power-cycle to revive, NOT an authoritative empty ==="
    fi
    [ "$LOGIT" = 1 ] && echo "$ts $HOST n=0 SUSPECT-wedge known=0 discovering=$disc" >> "$LOG"
    exit 3
  fi
fi

sorted="$(printf '%s' "$rows" | sed '/^$/d' | sort -t'|' -k1 -rn)"
if [ "$json_mode" = 0 ]; then
  echo "=== mesh-presence $HOST @ $ts — $n device(s) in range (rssi|mac|name, closest first) ==="
  printf '%s\n' "$sorted" | sed '/^$/d'
fi
# NOTE: the --log append to presence.log is deferred to AFTER the attribution loop below,
# so the snapshot line can carry the person/appliance/ambiguous breakdown as a trailing
# additive field (single-source: mesh-sensorium reads attribution from this SAME line, no
# cross-file .presence-state guard). The n=/devices=[...] anchors are unchanged; consumers
# that parse them (mesh-ambient-clock, oscilloscope, cooscillate — all greedy `devices=\[...\]`
# to the last `]`) are invariant to the trailing ` attribution=...` field (no `]` in it; proven).
# --- Enrichment: device type classification + presence tracking ---
classify_device() {
  local name="$1"
  case "$name" in
    *Quest*|*Oculus*|*Pico*)           echo "VR" ;;
    *Bose*|*SoundLink*|*JBL*|*Sony*|*Headphone*|*Earbuds*|*AirPods*|*Buds*)  echo "AUDIO" ;;
    *TV*|*Samsung*|*LG*|*Bravia*|*Display*|*Monitor*)  echo "TV" ;;
    *Phone*|*Redmi*|*Pixel*|*iPhone*|*Galaxy*|*OnePlus*)  echo "PHONE" ;;
    *Armor*|*Armor*|*Rugged*)          echo "PHONE" ;;
    *DV*|*Scale*|*Weight*)             echo "DEVICE" ;;
    *LE-*|*beacon*|*iBeacon*)          echo "BEACON" ;;
    *)                                  echo "UNKNOWN" ;;
  esac
}

device_lines=""
type_counts=""
trend_approaching=0; trend_receding=0; trend_stable=0; trend_initial=0; trend_tentative=0
# Per-PERSONAL counters (FALSIFIABLE: classify_personal_presence asserts on these)
trend_pers_approaching=0; trend_pers_receding=0; trend_pers_stable=0; trend_pers_initial=0
prox_pers_near=0; prox_pers_far=0   # IMMEDIATE+NEAR / ROOM+EDGE counts of PERSONAL devices only
attr_personal=0; attr_appliance=0; attr_ambiguous=0
while IFS='|' read -r rssi mac name; do
  [ -z "$name" ] && continue
  dtype="$(classify_device "$name")"
  # Fuse the BLE address type into attribution: a nameless RANDOM-addr contact (privacy-rotating →
  # phone/wearable) recovers as a PERSONAL corroborator instead of opaque AMBIGUOUS. No info-blob here
  # (that lives in the inventory loop above), so classify_addrtype uses its MAC locally-administered-bit
  # fallback — deterministic, no network/DB. Name still outranks addrtype inside classify_attribution.
  attr="$(classify_attribution "$name" "$(classify_addrtype "$mac")")"
  case "$attr" in
    PERSONAL)  attr_personal=$((attr_personal + 1)) ;;
    APPLIANCE) attr_appliance=$((attr_appliance + 1)) ;;
    AMBIGUOUS) attr_ambiguous=$((attr_ambiguous + 1)) ;;
  esac
  # update rolling RSSI history FIRST, so the smoothed proximity bucket includes the current reading.
  # NOW (shared across all devices in this scan) drives the gap-aware reset + the last-seen stamp.
  update_rssi_history "$mac" "$rssi" "$TREND_FILE" "$NOW"
  prox="$(classify_proximity_smoothed "$mac" "$TREND_FILE" "$rssi")"
  trend="$(get_trend "$mac" "$TREND_FILE")"
  tconf="$(get_trend_conf "$mac" "$TREND_FILE")"
  case "$trend" in
    APPROACHING) trend_approaching=$((trend_approaching + 1)) ;;
    RECEDING)    trend_receding=$((trend_receding + 1)) ;;
    STABLE)      trend_stable=$((trend_stable + 1)) ;;
    INITIAL)     trend_initial=$((trend_initial + 1)) ;;
  esac
  # Count directional trends whose SNR is noise-grade (TENTATIVE) — the aggregate "how much of the
  # trend signal could be jitter" a fusion consumer should discount. Only APPROACHING/RECEDING carry a
  # conf; STABLE/INITIAL are NA.
  [ "$tconf" = TENTATIVE ] && trend_tentative=$((trend_tentative + 1))
  # Per-PERSONAL trend+proximity (feeds the room-level personal_presence signal below)
  if [ "$attr" = "PERSONAL" ]; then
    case "$trend" in
      APPROACHING) trend_pers_approaching=$((trend_pers_approaching + 1)) ;;
      RECEDING)    trend_pers_receding=$((trend_pers_receding + 1)) ;;
      STABLE)      trend_pers_stable=$((trend_pers_stable + 1)) ;;
      INITIAL)     trend_pers_initial=$((trend_pers_initial + 1)) ;;
    esac
    case "$prox" in
      IMMEDIATE|NEAR) prox_pers_near=$((prox_pers_near + 1)) ;;
      ROOM|EDGE)      prox_pers_far=$((prox_pers_far + 1)) ;;
      *)              ;;  # UNKNOWN proximity — not counted (the room-level signal still classifies)
    esac
  fi
  device_lines="${device_lines}${rssi}|${mac}|${name}|${dtype}|${prox}|${trend}|${tconf}"$'\n'
  type_counts="${type_counts}${dtype}=1 "
done <<< "$sorted"

# Bound the history file: drop MACs unseen past the prune TTL (dead transients + rotated random addrs).
prune_rssi_history "$TREND_FILE" "$NOW"

# Deferred --log write (counts now computed): snapshot line carries the attribution breakdown
# as a trailing additive field. n=/devices=[...] anchors are byte-identical to the old format.
if [ "$LOGIT" = 1 ]; then
  devlist="$(printf '%s' "$sorted" | sed '/^$/d' | tr '\n' ' ' | sed 's/ $//')"
  echo "$ts $HOST n=$n devices=[$devlist] attribution=personal:$attr_personal,appliance:$attr_appliance,ambiguous:$attr_ambiguous unidentified=public:$unid_public,random:$unid_random,unknown:$unid_unknown" >> "$LOG"
fi

summary_types=""
for t in VR AUDIO TV PHONE DEVICE BEACON UNKNOWN; do
  cnt=0
  while IFS='|' read -r _ _ _ dt _ _; do
    [ "$dt" = "$t" ] && cnt=$((cnt + 1))
  done <<< "$device_lines"
  [ "$cnt" -gt 0 ] && summary_types="${summary_types}${t}:${cnt} "
done

summary_proximity=""
for p in IMMEDIATE NEAR ROOM EDGE UNKNOWN; do
  cnt=0
  while IFS='|' read -r _ _ _ _ pr _; do
    [ "$pr" = "$p" ] && cnt=$((cnt + 1))
  done <<< "$device_lines"
  [ "$cnt" -gt 0 ] && summary_proximity="${summary_proximity}${p}:${cnt} "
done

strongest_rssi=""; strongest_name=""
if [ -n "$sorted" ]; then
  strongest_rssi="$(printf '%s' "$sorted" | head -1 | cut -d'|' -f1)"
  strongest_name="$(printf '%s' "$sorted" | head -1 | cut -d'|' -f3)"
fi

DEV_STATE="$MESH/.presence-devices"
prev_macs="$(cat "$DEV_STATE" 2>/dev/null || true)"

# ROOM FAMILIARITY: compute the longest CURRENT session (devices live within HISTORY_GAP_TTL)
# AFTER the history update + prune (prune ran above at line ~661), so stale lines are gone.
# session_max_s=0 is the honest "no devices in range" case → classify_familiarity returns INITIAL.
session_max_s="$(session_max_age "$TREND_FILE" "$NOW")"
curr_macs="$(printf '%s' "$sorted" | sed '/^$/d' | cut -d'|' -f2 | sort -u)"
new_count=0; gone_count=0; stable_count=0
while IFS= read -r mac; do
  [ -z "$mac" ] && continue
  if printf '%s\n' "$prev_macs" | grep -Fxq "$mac"; then
    stable_count=$((stable_count + 1))
  else
    new_count=$((new_count + 1))
  fi
done <<< "$curr_macs"
while IFS= read -r mac; do
  [ -z "$mac" ] && continue
  printf '%s\n' "$curr_macs" | grep -Fxq "$mac" || gone_count=$((gone_count + 1))
done <<< "$prev_macs"
printf '%s\n' "$curr_macs" > "$DEV_STATE"

# Computed ONCE (was re-invoked separately for .presence-state and the prose line below); the JSON
# emitter reuses these same two tokens so all three surfaces (state file / prose / --json) agree by
# construction, never by re-deriving the same classification three times from three call sites.
pers_presence_tok="$(classify_personal_presence "$trend_pers_approaching" "$trend_pers_receding" \
   "$trend_pers_stable" "$trend_pers_initial" "$prox_pers_near" "$prox_pers_far" \
   "$attr_ambiguous" "$n")"
familiarity_full="$(classify_familiarity "$session_max_s")"
familiarity_tok="${familiarity_full%%|*}"

printf 'count=%d strongest=%s(%s) types=%s proximity=%s churn=new:%d,gone:%d,stable:%d trend=approaching:%d,receding:%d,stable:%d,initial:%d attribution=personal:%d,appliance:%d,ambiguous:%d unidentified=public:%d,random:%d,unknown:%d personal_presence=%s familiarity=%s session_max_s=%d trend_tentative=%d\n' \
  "$n" "${strongest_name:-none}" "${strongest_rssi:-0}" "${summary_types:-none}" \
  "${summary_proximity:-none}" "$new_count" "$gone_count" "$stable_count" \
  "$trend_approaching" "$trend_receding" "$trend_stable" "$trend_initial" \
  "$attr_personal" "$attr_appliance" "$attr_ambiguous" \
  "$unid_public" "$unid_random" "$unid_unknown" \
  "$pers_presence_tok" "$familiarity_tok" "$session_max_s" "$trend_tentative" > "$MESH/.presence-state"

if [ "$json_mode" = 1 ]; then
  emit_presence_json ok
else
  echo "---"
  echo "inventory: $n devices | strongest: ${strongest_name:-none} (${strongest_rssi:-0} dBm) | types: ${summary_types:-none} | proximity: ${summary_proximity:-none} | churn: new=${new_count} gone=${gone_count} stable=${stable_count} | trend: approaching=${trend_approaching} receding=${trend_receding} stable=${trend_stable} initial=${trend_initial} tentative=${trend_tentative} | attribution: personal=${attr_personal} appliance=${attr_appliance} ambiguous=${attr_ambiguous} | unidentified: public=${unid_public} random=${unid_random} unknown=${unid_unknown} | personal_presence: $pers_presence_tok (pers-trend: approaching=${trend_pers_approaching} receding=${trend_pers_receding} stable=${trend_pers_stable} initial=${trend_pers_initial}; pers-prox: near=${prox_pers_near} far=${prox_pers_far}) | familiarity: $familiarity_full (session_max_s=$session_max_s)"
fi

exit 0
