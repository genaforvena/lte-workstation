#!/usr/bin/env bash
# mesh-presence — a BLE PRESENCE SENSE: scan for nearby Bluetooth devices and report each one's
# RSSI (signal strength = rough proximity) as text. One node's snapshot of "what is near me".
# smoke-test: --test checks bluetoothctl available + adapter powered
#
# The mesh-wide value (later): the SAME device seen by multiple nodes, compared by RSSI, gives
# zonal localization — no GPS, just relative signal. This is the per-node primitive that feeds it.
#
#   mesh-presence              scan (default 10s) -> rssi|mac|name lines, strongest (closest) first
#   mesh-presence <seconds>    custom scan window
#   mesh-presence --log        also append a snapshot line to ~/.mesh/presence.log
#   mesh-presence --loop [s]   scan + log every N sec (default 60); supervisable continuous sensor
#   mesh-presence --test       smoke test (exit 0 if BT adapter ready)
#
# Read-only (BLE scan only; never connects). Exit 0 with results, 1 if no adapter / nothing in range.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"

if [ "${1:-}" = --test ]; then
  command -v bluetoothctl >/dev/null 2>&1 || { echo "smoke-test: FAIL (no bluetoothctl)"; exit 1; }
  bluetoothctl show 2>/dev/null | grep -q 'Powered: yes' || { echo "smoke-test: FAIL (BT not powered)"; exit 1; }
  echo "smoke-test: ok"; exit 0
fi
if [ "${1:-}" = --loop ]; then
  iv="${2:-60}"
  echo "[mesh-presence] continuous BLE scan every ${iv}s on $(hostname)"
  while true; do
    : > "${HOME}/.mesh/mesh-presence.beat"
    "$0" --log 2>/dev/null || true
    sleep "$iv"
  done
  exit 0
fi

WIN=10; LOGIT=0
for a in "$@"; do case "$a" in --log) LOGIT=1;; [0-9]*) WIN="$a";; esac; done
HOST="$(hostname)"; MESH="$HOME/.mesh"; LOG="$MESH/presence.log"; mkdir -p "$MESH"
command -v bluetoothctl >/dev/null 2>&1 || { echo "mesh-presence: no bluetoothctl" >&2; exit 1; }
bluetoothctl show 2>/dev/null | grep -q 'Powered: yes' || { echo "mesh-presence: BT adapter not powered" >&2; exit 1; }

# Single-writer the adapter. BlueZ keeps ONE discovery session per adapter, ref-counted per
# D-Bus client; when concurrent scanners overlap, one client's scan-off clears the RSSI cache
# while another is mid-query → a clean-but-empty result that masquerades as "0 devices in range".
# Serialize scans with a lock so callers take turns instead of colliding. If the lock genuinely
# can't be acquired (a wedged holder), report BUSY with a distinct exit (3) — never a spurious 0
# (empty ≠ failed). Lock auto-releases when this process exits (fd 9 closes); --loop re-acquires
# per iteration since each scan is a fresh "$0" subprocess.
if command -v flock >/dev/null 2>&1; then
  exec 9>"$MESH/presence.scan.lock"
  if ! flock -w $(( WIN + 25 )) 9; then
    ts="$(date -u +%FT%TZ)"
    echo "=== mesh-presence $HOST @ $ts — BUSY (adapter scan-locked by another scanner > $((WIN+25))s; NOT an empty reading) ==="
    exit 3
  fi
fi

# hold an active scan for WIN seconds (pipe stays open → bluetoothctl keeps scanning), query during it
{ echo "scan on"; sleep "$WIN"; } | bluetoothctl >/dev/null 2>&1 &
scanpid=$!
sleep $(( WIN > 3 ? WIN - 2 : 1 ))   # let discovery populate, query while scan still live

ts="$(date -u +%FT%TZ)"; rows=""; n=0
for mac in $(bluetoothctl devices 2>/dev/null | awk '/^Device/{print $2}'); do
  info="$(bluetoothctl info "$mac" 2>/dev/null)"
  rssi="$(printf '%s' "$info" | grep -oE 'RSSI: 0x[0-9a-f]+ \(-?[0-9]+\)' | grep -oE '\(-?[0-9]+\)' | tr -d '()')"
  [ -n "$rssi" ] || continue   # no fresh RSSI = not currently in range
  name="$(printf '%s' "$info" | sed -nE 's/^\s*Name: (.*)/\1/p' | head -1)"; name="${name:-?}"
  rows="${rows}${rssi}|${mac}|${name}"$'\n'
  n=$((n+1))
done
wait "$scanpid" 2>/dev/null || true

sorted="$(printf '%s' "$rows" | sed '/^$/d' | sort -t'|' -k1 -rn)"
echo "=== mesh-presence $HOST @ $ts — $n device(s) in range (rssi|mac|name, closest first) ==="
printf '%s\n' "$sorted" | sed '/^$/d'
if [ "$LOGIT" = 1 ]; then
  devlist="$(printf '%s' "$sorted" | sed '/^$/d' | tr '\n' ' ' | sed 's/ $//')"
  echo "$ts $HOST n=$n devices=[$devlist]" >> "$LOG"
fi
# --- Enrichment: device type classification + presence tracking ---
classify_device() {
  local name="$1"
  case "$name" in
    *Quest*|*Oculus*|*Pico*)           echo "VR" ;;
    *Bose*|*SoundLink*|*JBL*|*Sony*|*Headphone*|*Earbuds*|*AirPods*|*Buds*)  echo "AUDIO" ;;
    *TV*|*Samsung*|*LG*|*Bravia*|*Display*|*Monitor*)  echo "TV" ;;
    *Phone*|*Redmi*|*Pixel*|*iPhone*|*Galaxy*|*OnePlus*)  echo "PHONE" ;;
    *Armor*|*Armor*|*Rugged*)          echo "PHONE" ;;
    *DV*|*Scale*|*Weight*)             echo "DEVICE" ;;
    *LE-*|*beacon*|*iBeacon*)          echo "BEACON" ;;
    *)                                  echo "UNKNOWN" ;;
  esac
}

device_lines=""
type_counts=""
while IFS='|' read -r rssi mac name; do
  [ -z "$name" ] && continue
  dtype="$(classify_device "$name")"
  device_lines="${device_lines}${rssi}|${mac}|${name}|${dtype}"$'\n'
  type_counts="${type_counts}${dtype}=1 "
done <<< "$sorted"

summary_types=""
for t in VR AUDIO TV PHONE DEVICE BEACON UNKNOWN; do
  cnt=0
  while IFS='|' read -r _ _ _ dt; do
    [ "$dt" = "$t" ] && cnt=$((cnt + 1))
  done <<< "$device_lines"
  [ "$cnt" -gt 0 ] && summary_types="${summary_types}${t}:${cnt} "
done

strongest_rssi=""; strongest_name=""
if [ -n "$sorted" ]; then
  strongest_rssi="$(printf '%s' "$sorted" | head -1 | cut -d'|' -f1)"
  strongest_name="$(printf '%s' "$sorted" | head -1 | cut -d'|' -f3)"
fi

printf 'count=%d strongest=%s(%s) types=%s\n' "$n" "${strongest_name:-none}" "${strongest_rssi:-0}" "${summary_types:-none}" > "$MESH/.presence-state"

if [ "$n" -gt 0 ]; then
  echo "---"
  echo "inventory: $n devices | strongest: ${strongest_name:-none} (${strongest_rssi:-0} dBm) | types: ${summary_types:-none}"
fi

[ "$n" -gt 0 ] && exit 0 || exit 1
