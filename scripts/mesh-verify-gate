#!/usr/bin/env bash
# mesh-verify-gate — gate the verify-stream tick so it fires on CHANGE, not every cycle.
#
# The verify-stream saturated the genome core (~40 tools verified, 10 flaws fixed). Re-treading green
# tools every */6 is an ALIVE mind burning scarce quota + heat for no new signal (verify-mind flagged it
# 2026-06-13T23:26, "verification-saturation"). Drive the verify mind ONLY when there's something to
# re-check:
#   (a) a NEW commit since the last verify  → the high-value regression-guard (fast), OR
#   (b) >= STALE_MIN since the last verify   → a slow drift-baseline (catch env-drift, not just code).
# Else skip silently (no quota draw). Implements the verify-mind's commit-TRIGGERED recommendation while
# keeping drift-catching. The cron still fires every */6 but this gate is cheap (git rev-parse + a stat).
#
#   mesh-verify-gate          gate; if due, drive the verify mind via mesh-tick (exec)
#   mesh-verify-gate --test   smoke (asserts the gate decision on all four cases)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
REPO="${MESH_REPO:-$HOME/lte-workstation}"
STATE="${MESH_VERIFY_STATE:-$HOME/.mesh/.verify-gate}"   # "<sha> <epoch>"
STALE_MIN="${MESH_VERIFY_STALE_MIN:-120}"

# DUE if: no prior state, OR a new commit since last verify, OR >= stale_min since last (drift-baseline).
# Shared by --test AND the live path so the test guards the REAL decision (no copy-drift).
gate_due(){ # $1=statefile $2=sha $3=now-epoch $4=stale_min  -> echo DUE|SKIP
  local lsha lts
  if ! read -r lsha lts < "$1" 2>/dev/null; then echo DUE; return; fi
  [ "$2" != "$lsha" ] && { echo DUE; return; }
  [ "$(( $3 - ${lts:-0} ))" -ge "$(( $4 * 60 ))" ] && { echo DUE; return; }
  echo SKIP
}

if [ "${1:-}" = --test ]; then
  for x in git mesh-tick mktemp; do command -v "$x" >/dev/null 2>&1 || { echo "smoke-test: FAIL (no $x)"; exit 1; }; done
  t="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }; trap 'rm -rf "$t"' EXIT; now=1000000
  [ "$(gate_due "$t/none" abc $now 120)" = DUE ]  || { echo "smoke-test: FAIL (no-state must be DUE)"; exit 1; }
  printf 'abc %s\n' "$now" > "$t/s"
  [ "$(gate_due "$t/s" abc $now 120)" = SKIP ]    || { echo "smoke-test: FAIL (same-sha+recent must SKIP)"; exit 1; }
  [ "$(gate_due "$t/s" xyz $now 120)" = DUE ]     || { echo "smoke-test: FAIL (new-sha must be DUE)"; exit 1; }
  printf 'abc %s\n' "$((now-8000))" > "$t/s"
  [ "$(gate_due "$t/s" abc $now 120)" = DUE ]     || { echo "smoke-test: FAIL (stale must be DUE)"; exit 1; }
  echo "smoke-test: ok"; exit 0
fi

sha="$(git -C "$REPO" rev-parse HEAD 2>/dev/null || echo nogit)"
now="$(date -u +%s)"
if [ "$(gate_due "$STATE" "$sha" "$now" "$STALE_MIN")" = DUE ]; then
  printf '%s %s\n' "$sha" "$now" > "$STATE"
  exec mesh-tick local verify verify
fi
exit 0   # not due → silent skip (the saving)
