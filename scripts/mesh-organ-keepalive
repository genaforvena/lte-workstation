#!/usr/bin/env bash
# mesh-organ-keepalive — tend this node's declared ORGANS. The symmetric half of mesh-mind-keepalive:
# mind-keepalive keeps a declared MIND on-air; this keeps each declared ORGAN (sense/actuator) LIVE and
# reachable via its tmux channel. The card (capability = live contract) declares what the node IS; this
# reflex holds the organ half true — a declared organ that goes dark is detected, gently remedied where
# possible (sudo-free), and escalated to the chat board so the mesh (and operator) know an organ failed.
#
#   mesh-organ-keepalive            probe declared organs; ensure the organs tmux channel; alert on dark
#   mesh-organ-keepalive --status   report only (no remedy, no alert)
#   mesh-organ-keepalive --power    goal-attainment POWER report (read-only) — reliability-weighted
#                                   capability, NOT a count of what is declared. See below.
#   mesh-organ-keepalive --test     smoke test (exit 0 if card readable / no organs declared)
#
# ── GOAL-ATTAINMENT POWER: breadth counted is not power (live review 2026-08-14) ────────────────────
# LITERATURE (cross-domain transfer to a distributed sensor mesh). Heitzig & Potham, "A Fair Objective
# for Human-Empowerment-Preserving AI: Desiderata, Design, and Likely Behavioral Consequences",
# arXiv:2608.08240 (8 Aug 2026). Its axiomatic derivation of an agent's POWER over a goal set forces a
# functional form the mesh does not use anywhere. Desideratum I5, "Reliability Preference" (a DUAL
# Pigou-Dalton condition): transferring capability from a LESS attainable goal to a MORE attainable one
# must INCREASE power. Together with I1-I4/I6-I7 it forces
#     I_h(s) = log2 Σ_{g} C_h^g(s)^ζ ,  ζ > 1   (strictly CONVEX aggregation over goals)
# where C_h^g ∈ [0,1] is the (discounted) probability that party h ATTAINS goal g. Note what ζ=1 with
# C≡1 degenerates to: log2(number of goals) — a pure BREADTH COUNT. That is exactly what this mesh
# reports as capability today (`mesh-organs` → "live":11,"total":11; the card's senses:/actuators:
# lines; mesh-organ --list). The axiom says a count is not power: half-attaining ten goals is WEAKER
# than reliably attaining five, and no count can see the difference.
# WHERE WE'D BEEN: empowerment as channel capacity (mesh-algedonic --agency-capacity), multi-agent
# interference (--agency-actors), discounted empowerment on the board (mesh-promises --empowerment),
# plasticity/the observation→action dual, PID synergy. Every one of them scores an information FLOW or
# CAPACITY of a single scalar channel. NONE scores a party's power over a GOAL SET, and nothing in the
# mesh weights a declared capability by whether it is actually attained.
# THE TRANSFER (this file, because it owns the probe): C_h^g is estimable here and nowhere else — the
# per-organ probe below is a Bernoulli trial on "can this node attain capability g right now?". It was
# never recorded: the reflex logged only EDGES (DARK/REMEDIED/UP), so the attainment RATE that C is
# never existed. `--power` reads the new per-probe ledger and reports I_power = log2 Σ Ĉ^ζ against the
# breadth read I_count = log2(#declared) the fleet map uses.
# THE HONEST-NA RULE THIS EXPOSES (live on this node): probe()'s catch-all `*) return 0` means an organ
# with no probe case reads LIVE unconditionally — 6 of mesh-home's 11 declared organs (irq,
# docker-compute, volume, tv, dlna-tv, shadowsocks) have NO probe at all. Their C is NOT 1.0; it is
# UNKNOWN. --power EXCLUDES them (never counts an unprobed organ as attained — missing evidence renders
# na, never 0 and never 1) and names them, so the gap between breadth and power says WHICH cause it came
# from: unprobed capability vs measured flakiness.
# WHAT Ĉ IS AND IS NOT (a-senses-coverage-is-window-over-cadence): the probe is INSTANTANEOUS and this
# reflex is driven every 600s by mesh-liveness-loop, so Ĉ is the probability the organ is attainable AT
# A PROBE INSTANT — a Bernoulli over sampled instants, which is exactly the quantity a router needs
# ("can I reach it if I ask now?"), and is NOT a duty cycle. An outage shorter than the cadence is
# invisible to it, and no gap in this ledger licenses a claim about the time BETWEEN probes.
# Deferred, with the reason: the paper's POPULATION-level aggregate P(s) = -log2 Σ_h 2^{-ξ I_h(s)}
# (desiderata P4 "Disempowerment Focus" + P6 inequality aversion — a fleet number a strong node cannot
# flatter) is NOT built here. It needs the per-node I_h fanned in across peers, which lives in
# mesh-organs' SSH loop, not in this node-local reflex. --power prints a machine-readable POWER line so
# that fold is a one-liner when it is built. Review: docs/reviews/
# info-theory-agency-goal-attainment-power-reliability-weighted-capability-organ-keepalive-2026-08-14.md
#
# DECLARATION-GATED: only organs the card declares are tended (operator: "only organs, only minds, none,
# both, anything"). Undeclared → not forced. tmux-native: an organ's live presence is its channel window
# + a passing probe; we observe whether it works, not parse its contents.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
S="$(hostname)"; MESH="$HOME/.mesh"; CARD="${MESH_CARD:-$HOME/.mesh-card}"
LOG="$MESH/organ-keepalive.log"; WIN="${MESH_ORGAN_WIN:-organs}"
# per-probe attainment ledger (the C_h^g estimator's only input). SEPARATE from $LOG on purpose: $LOG
# is the edge/liveness log a human and mesh-reflex-health read, and a --test must never write the
# artifact it checks (09f7914). MESH_ORGAN_ATTAIN_LOG lets --test point it at a scratch file.
ATTAIN_LOG="${MESH_ORGAN_ATTAIN_LOG:-$MESH/organ-attain.log}"
ts(){ date -u +%FT%TZ; }
mkdir -p "$MESH" 2>/dev/null || true

# ── DEBOUNCE (watchdog-debounce 2026-06-24): a declared organ joins the DARK alarm set only after N>=2
# CONSECUTIVE dark runs. A single transient (an organ mid-restart — e.g. the overhear daemon restarting)
# is logged but NOT alarmed. Counter persisted per-organ across runs in ~/.mesh/.debounce/; first OK
# (or a successful remedy) resets it. This sits ON TOP of the existing remedy+re-probe (sub-second) and
# the edge-gate flag (alarm-once): debounce adds cross-RUN tolerance the single-run mechanisms can't. ──
DEBOUNCE_DIR="${MESH_DEBOUNCE_DIR:-$MESH/.debounce}"
DEBOUNCE_N="${MESH_DEBOUNCE_N:-2}"
debounce(){ # <key> <ok|fail> → effective verdict UP|DOWN (persists the consecutive-fail counter)
  local key="$1" probe="$2" f n
  key="$(printf '%s' "$key" | tr -c 'A-Za-z0-9._-' '_')"
  f="$DEBOUNCE_DIR/$key"; mkdir -p "$DEBOUNCE_DIR" 2>/dev/null || true
  n="$(cat "$f" 2>/dev/null || echo 0)"; [ "$n" -eq "$n" ] 2>/dev/null || n=0
  if [ "$probe" = ok ]; then rm -f "$f" 2>/dev/null || true; echo UP; return; fi
  n=$((n+1)); printf '%s\n' "$n" > "$f" 2>/dev/null || true
  [ "$n" -ge "$DEBOUNCE_N" ] && echo DOWN || echo UP
}

# ── UP-DEBOUNCE (organ-down-flap-debounce 2026-06-26): the SYMMETRIC half of debounce(). The down EDGE is
# already held N>=2 (debounce above); this holds the up EDGE the same way — a down-announced organ must read
# LIVE for N>=2 CONSECUTIVE cycles before [organ-up] posts. A single live blip (an organ flapping) routes to
# the TRACE tier and KEEPS the down marker, so the board never churns [organ-up]…[organ-down] on a flap.
# Distinct from repeat-suppress (which de-dups a steady HELD-down organ): this debounces the up TRANSITION.
# Counter persisted per-organ in ~/.mesh/.debounce/up.<key>; ANY dark cycle resets it (streak broken). ──
UP_DEBOUNCE_N="${MESH_UP_DEBOUNCE_N:-$DEBOUNCE_N}"
up_debounce(){ # <key> <live|dark> → HELD|WAIT (consecutive-live counter; gates the recovery announce)
  local key="$1" probe="$2" f n
  key="$(printf '%s' "$key" | tr -c 'A-Za-z0-9._-' '_')"
  f="$DEBOUNCE_DIR/up.$key"; mkdir -p "$DEBOUNCE_DIR" 2>/dev/null || true
  if [ "$probe" = dark ]; then rm -f "$f" 2>/dev/null || true; echo WAIT; return; fi
  n="$(cat "$f" 2>/dev/null || echo 0)"; [ "$n" -eq "$n" ] 2>/dev/null || n=0
  n=$((n+1)); printf '%s\n' "$n" > "$f" 2>/dev/null || true
  [ "$n" -ge "$UP_DEBOUNCE_N" ] && echo HELD || echo WAIT
}

# ── REPEAT-SUPPRESS (organ-down-repeat-suppress 2026-06-26): board-post [organ-down] ONCE on the
# up->down edge; while the organ STAYS down, route the steady-state re-confirm to the TRACE tier, never
# re-cry it to the board; post [organ-up] ONCE on recovery. Per-organ marker in ~/.mesh/.organ-announced/
# (an organ has a marker IFF its [organ-down] was posted and its [organ-up] has not). Replaces the old
# single combined-set .organ-dark-flag whose all-clear reset re-announced a persistently-down organ each
# time the dark SET fluctuated or briefly cleared ('light' re-cried 04:02/08:19/12:28/16:17, identical
# msg, while stably down) and which had NO recovery announce at all. Sits ATOP debounce (which still
# gates the down EDGE at N>=2) — this only de-dups the ANNOUNCE. ──
ANNOUNCED_DIR="${MESH_ANNOUNCED_DIR:-$MESH/.organ-announced}"
# announce_action <down|live> <marker_present:0|1> → DOWN|UP|RECONFIRM|NONE. PURE (no side effects) so
# the edge/dedup logic is unit-testable without firing the board; the live loop emits off its verdict.
announce_action(){
  case "$1:$2" in
    down:0) echo DOWN ;;        # up->down edge: board [organ-down] once + set marker
    down:1) echo RECONFIRM ;;   # still down: steady-state re-confirm → TRACE, NOT the board
    live:1) echo UP ;;          # down->up edge: board [organ-up] once + clear marker
    *)      echo NONE ;;        # live + not-announced (normal), or anything else: silent
  esac
}
# organ_attrib <organ> → the partitioned cause clause, preserving the OTP rest_for_one attribution
# (light = phone lux + webcam fallback → an UPSTREAM/sensor-path outage, NOT local hardware; don't
# misdirect a reader to "check hardware"). Per-organ now (the old code partitioned a combined set).
# chat-review/default-string-mic-organdown-unclaimed (2026-07-08): the generic-organ fallback carried
# no "owner:" tag, so scan_orphans (mesh-mind-control:231, requires an owner: tag on every marker
# class including [organ-down]'s bare [fyi]-shaped post) could never route a stalled organ-down fault
# — live cost: Default-string's mic sat DARK 7.5h+ with zero board engagement. light stays untagged:
# it's an upstream/sensor-path outage, not local hardware senses owns fixing.
organ_attrib(){
  case "$1" in
    light) printf 'upstream-degraded: %s — sensor path unavailable (body/phone lux + webcam fallback both down), NOT local hardware; clears when the upstream returns.' "$1" ;;
    *)     printf 'declared organ DARK: %s — probe fails, no sudo-free fix. Check hardware/permits or mesh-card --refresh (drift?). (owner: senses/%s)' "$1" "$S" ;;
  esac
}
# status_label <organ> <LIVE|DARK> → the human-facing status token. Light is an honest degraded
# upstream path, not a local hardware darkness, so keepalive should say so even when the probe fails.
status_label(){
  case "$1:$2" in
    light:DARK) echo UPSTREAM-DEGRADED ;;
    *)          echo "$2" ;;
  esac
}
# announce_organ <organ> <DOWN|RECONFIRM|UP|NONE> — emit the action's side effect: board on the
# up->down / down->up EDGES, trace on the steady-state re-confirm. The marker is the single source of
# truth for "currently announced down". A missing mesh-chat/mesh-trace degrades silently (logged).
announce_organ(){
  local o="$1" act="$2" marker="$ANNOUNCED_DIR/$o"
  case "$act" in
    DOWN)
      mkdir -p "$ANNOUNCED_DIR" 2>/dev/null || true; : > "$marker" 2>/dev/null || true
      echo "$(ts) DOWN-edge $o → board [organ-down]" >>"$LOG"
      command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="organ-keepalive@$S" mesh-chat "[organ-down] $S: $(organ_attrib "$o")" >/dev/null 2>&1 || true ;;
    RECONFIRM)
      echo "$(ts) still-dark $o (steady-state — suppressed from board, re-confirm to trace)" >>"$LOG"
      command -v mesh-trace >/dev/null 2>&1 && mesh-trace "[organ-still-down] $S: $o still dark (steady-state re-confirm; board-announced once on the down-edge, suppressed since)" >/dev/null 2>&1 || true ;;
    UP)
      rm -f "$marker" 2>/dev/null || true
      echo "$(ts) UP-edge $o → board [organ-up]" >>"$LOG"
      command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="organ-keepalive@$S" mesh-chat "[organ-up] $S: $o recovered — declared organ live again." >/dev/null 2>&1 || true ;;
  esac
}

# sudo-free liveness probe per organ. exit 0 = alive.
# PROBE_KIND is set as a side effect (real | catchall) so callers can tell "probed and passed" from
# "no probe exists for this class, so `return 0` fabricated a pass". Set ONCE at the top and flipped
# ONLY in the catch-all — deliberately not a second case list, which would drift from this one
# (two-renderings-of-a-value-must-be-canonicalized). probe() is called unsubshelled, so this sticks.
PROBE_KIND=real
probe(){
  PROBE_KIND=real
  case "$1" in
    ble)      bluetoothctl show 2>/dev/null | grep -q 'Powered: yes' ;;
    wifi)     nmcli -t radio wifi 2>/dev/null | grep -q enabled ;;
    mic)      arecord -l 2>/dev/null | grep -q '^card' ;;
    camera)   ls /dev/video0 >/dev/null 2>&1 && { command -v ffmpeg >/dev/null 2>&1 || command -v fswebcam >/dev/null 2>&1 || command -v v4l2-ctl >/dev/null 2>&1 || python3 -c 'import imageio_ffmpeg' 2>/dev/null; } ;;
    serial)   ls /dev/ttyUSB* /dev/ttyACM* >/dev/null 2>&1 && { command -v screen >/dev/null 2>&1 || command -v minicom >/dev/null 2>&1 || command -v picocom >/dev/null 2>&1 || command -v cu >/dev/null 2>&1; } ;;
    power)    ls /sys/class/power_supply/ 2>/dev/null | grep -q . ;;
    # light: real steady-state assertion, not the catch-all return-0 (false-green fix, chaos
    # steady-state hypothesis). mesh-light honest-exit: 0 = level assessed (phone lux OR webcam
    # luma fallback), 2 = cannot read → DARK. Per-node honest under phone-down (IdeaPad webcam
    # LIVE, ilya no-webcam DARK). --status = no alarm. See review-chaos-steady-state-falsegreen-*.
    light)    command -v mesh-light >/dev/null 2>&1 && mesh-light --status >/dev/null 2>&1 ;;
    link-flap) command -v mesh-link-flap >/dev/null 2>&1 && mesh-link-flap --test >/dev/null 2>&1 ;;
    lid)      command -v mesh-lid >/dev/null 2>&1 && mesh-lid --test >/dev/null 2>&1 ;;
    speaker)  aplay -l 2>/dev/null | grep -q '^card' ;;
    tts)      command -v termux-tts-speak >/dev/null 2>&1 ;;
    sms)      command -v termux-sms-send  >/dev/null 2>&1 ;;
    battery)  command -v termux-battery-status >/dev/null 2>&1 ;;
    location) command -v termux-location >/dev/null 2>&1 ;;
    voice-out:bose) aplay -l 2>/dev/null | grep -qi bose ;;
    notify)   command -v mesh-notify >/dev/null 2>&1 && mesh-notify --check >/dev/null 2>&1 ;;
    *)        PROBE_KIND=catchall; return 0 ;;   # unknown organ class: don't false-alarm
  esac
}
# append one Bernoulli trial to the attainment ledger: <ts> <node> <organ> <ok|dark> <real|catchall> <mode>
# A catchall row is recorded but is NOT evidence of attainment — --power excludes it rather than
# reading its fabricated `ok` as C=1.
attain_record(){ # <organ> <ok|dark> <mode>
  printf '%s %s %s %s %s %s\n' "$(ts)" "$S" "$1" "$2" "$PROBE_KIND" "$3" >>"$ATTAIN_LOG" 2>/dev/null || true
}
# gentle, sudo-free remedy attempt (best-effort). returns 0 if it tried something.
remedy(){
  case "$1" in
    wifi) nmcli radio wifi on >/dev/null 2>&1 ;;
    ble)  command -v rfkill >/dev/null 2>&1 && rfkill unblock bluetooth >/dev/null 2>&1 ;;
    *)    return 1 ;;
  esac
}

# read declared organs from the card (senses: + actuators:)
declared_organs(){
  [ -r "$CARD" ] || return 0
  awk '/^[[:space:]]*senses:/{sub(/^[[:space:]]*senses:[[:space:]]*/,""); print}
       /^[[:space:]]*actuators:/{sub(/^[[:space:]]*actuators:[[:space:]]*/,""); print}' "$CARD" \
    | tr ' ' '\n' | grep -vE '^\(none\)$|^$' | sort -u
}

organs="$(declared_organs)"
if [ "${1:-}" = --test ]; then
  # Real dependency + dry-run self-check (was: unconditional 'smoke-test: ok', which could never FAIL
  # even with the parser or escalation path broken). Two load-bearing deps:
  #  - awk: declared_organs() parses the card's senses:/actuators: lines with awk. No awk => it reads
  #    ZERO organs from ANY card => the reflex silently no-ops, tending/alerting NOTHING (green-but-dead).
  #  - mesh-chat: the ONLY escalation path for a DARK organ (the alert below). Absent, darkness is
  #    detected but the warning silently vanishes — the reflex is mute, dead for its one purpose.
  # Plus a dry-run: $organs was just parsed from the live card above; confirm the parse ran clean.
  # Prove: `bash mesh-organ-keepalive --test` (PASS) vs a PATH without awk (FAIL — parser blind).
  fail=0
  if command -v awk >/dev/null 2>&1; then
    echo "  ok: awk present — card organ-parse (declared_organs) can run"
  else
    echo "  FAIL: awk missing — declared_organs() reads nothing; reflex tends NO organ on any node"; fail=1
  fi
  if command -v mesh-chat >/dev/null 2>&1; then
    echo "  ok: mesh-chat present — dark-organ escalation can reach the board"
  else
    echo "  FAIL: mesh-chat missing — a DARK organ would be detected but never escalated (reflex mute)"; fail=1
  fi
  if [ -r "$CARD" ]; then
    echo "  ok: card readable — parsed $(printf '%s' "$organs" | grep -c .) declared organ(s): $(echo $organs | tr '\n' ' ')"
  else
    echo "  ok: no card yet (fresh node — reflex correctly no-ops)"
  fi
  # DEBOUNCE asserts (watchdog-debounce): 1 dark = NOT alarmed (UP), 2 consecutive = alarmed (DOWN), recovery resets
  _dbd="$(mktemp -d)"; _db(){ DEBOUNCE_DIR="$_dbd" debounce "$@"; }
  [ "$(_db organ.x fail)" = UP ]   || { echo "  FAIL: debounce 1st dark must NOT alarm (UP)"; fail=1; }
  [ "$(_db organ.x fail)" = DOWN ] || { echo "  FAIL: debounce 2nd CONSECUTIVE dark must alarm (DOWN)"; fail=1; }
  [ "$(_db organ.x ok)"   = UP ]   || { echo "  FAIL: debounce recovery must flip UP"; fail=1; }
  [ "$(_db organ.x fail)" = UP ]   || { echo "  FAIL: debounce counter must RESET after recovery"; fail=1; }
  # UP-DEBOUNCE asserts (organ-down-flap-debounce): 1 live = NOT yet recovered (WAIT), 2 consec = HELD, a dark cycle resets
  _ub(){ DEBOUNCE_DIR="$_dbd" UP_DEBOUNCE_N=2 up_debounce "$@"; }
  [ "$(_ub organ.y live)" = WAIT ] || { echo "  FAIL: up-debounce 1st live must NOT yet announce recovery (WAIT)"; fail=1; }
  [ "$(_ub organ.y live)" = HELD ] || { echo "  FAIL: up-debounce 2nd CONSECUTIVE live must announce recovery (HELD)"; fail=1; }
  [ "$(_ub organ.y dark)" = WAIT ] || { echo "  FAIL: up-debounce a dark cycle must break the live streak (WAIT)"; fail=1; }
  [ "$(_ub organ.y live)" = WAIT ] || { echo "  FAIL: up-debounce counter must RESET after a dark cycle"; fail=1; }
  rm -rf "$_dbd"
  # REPEAT-SUPPRESS asserts (organ-down-repeat-suppress): board ONCE on each edge, trace in between
  [ "$(announce_action down 0)" = DOWN ]      || { echo "  FAIL: down + not-announced must board [organ-down] (DOWN)"; fail=1; }
  [ "$(announce_action down 1)" = RECONFIRM ] || { echo "  FAIL: down + already-announced must suppress→trace (RECONFIRM)"; fail=1; }
  [ "$(announce_action live 1)" = UP ]        || { echo "  FAIL: live + was-announced must board [organ-up] (UP)"; fail=1; }
  [ "$(announce_action live 0)" = NONE ]      || { echo "  FAIL: live + not-announced must be silent (NONE)"; fail=1; }
  # organ_attrib owner-tag asserts (chat-review/default-string-mic-organdown-unclaimed): a generic
  # organ's fallback must now carry an owner: tag (scan_orphans-routable); light stays untagged
  # (upstream-degraded, not local hardware — unchanged regression guard).
  case "$(organ_attrib mic)" in
    *"owner:"*) echo "  ok: organ_attrib(generic) carries an owner: tag" ;;
    *) echo "  FAIL: organ_attrib(generic) missing owner: tag — [organ-down] would stay unroutable"; fail=1 ;;
  esac
  case "$(organ_attrib light)" in
    *"owner:"*) echo "  FAIL: organ_attrib(light) must stay untagged (upstream-degraded, not senses' fix)"; fail=1 ;;
    *) echo "  ok: organ_attrib(light) unchanged, no owner: tag" ;;
  esac
  # ── goal-attainment POWER asserts (arXiv:2608.08240 I5) ────────────────────────────────────────
  # The test writes to its OWN ledger and asserts the REAL one is untouched — a --test that appended
  # to $ATTAIN_LOG would forge the very attainment evidence --power weighs (09f7914).
  _real_before="$( (wc -c <"$ATTAIN_LOG") 2>/dev/null || echo 0)"
  _pd="$(mktemp -d)"; _pnow="$(date -u +%FT%TZ)"
  # (a) PROBE_KIND separates a genuine probe from probe()'s fabricating catch-all
  probe mic >/dev/null 2>&1; [ "$PROBE_KIND" = real ] \
    || { echo "  FAIL: PROBE_KIND must read 'real' for a class probe() actually tests"; fail=1; }
  probe __no_such_organ_class__ >/dev/null 2>&1; [ "$PROBE_KIND" = catchall ] \
    || { echo "  FAIL: PROBE_KIND must read 'catchall' for an organ with NO probe (its pass is fabricated)"; fail=1; }
  _al_save="$ATTAIN_LOG"; ATTAIN_LOG="$_pd/w"; attain_record zzz ok tests; ATTAIN_LOG="$_al_save"
  grep -q " zzz ok catchall tests$" "$_pd/w" 2>/dev/null \
    || { echo "  FAIL: attain_record must append '<organ> <verdict> <kind> <mode>' (the C estimator's only input)"; fail=1; }
  printf 'senses: alpha beta\nactuators: gamma delta\n' >"$_pd/card"
  : >"$_pd/led"
  for _i in 1 2 3 4 5 6; do echo "$_pnow $S alpha ok real reflex" >>"$_pd/led"; done
  for _i in 1 2 3;       do echo "$_pnow $S beta ok real reflex"   >>"$_pd/led"; done
  for _i in 1 2 3;       do echo "$_pnow $S beta dark real reflex" >>"$_pd/led"; done
  for _i in 1 2 3 4 5 6; do echo "$_pnow $S gamma ok catchall reflex" >>"$_pd/led"; done
  _pw(){ MESH_CARD="$_pd/card" MESH_ORGAN_ATTAIN_LOG="$1" MESH_ORGAN_POWER_ZETA=2 \
         MESH_ORGAN_POWER_MIN_N=5 MESH_ORGAN_POWER_DAYS=7 MESH_ORGAN_POWER_GAP_BITS=0.5 \
         bash "$0" --power 2>/dev/null; }
  _po="$(_pw "$_pd/led" | grep '^POWER ')"
  # THE load-bearing assert: gamma has SIX 'ok' rows but no real probe — counting it would read
  # measured=3. An organ whose pass is fabricated must not raise power (na, never 1).
  case "$_po" in
    *"measured=2"*) echo "  ok: --power excludes the catch-all organ despite its 'ok' rows (C=na, not 1)" ;;
    *) echo "  FAIL: --power counted an UNPROBED organ as attained — [$_po]"; fail=1 ;;
  esac
  case "$_po" in
    *"I_power=0.322"*) : ;;
    *) echo "  FAIL: --power I = log2(Σ C^ζ) wrong; fixture (C=1, C=0.5, ζ=2) must give 0.322 — [$_po]"; fail=1 ;;
  esac
  case "$_po" in
    *verdict=RELIABILITY_INFLATED*) : ;;
    *) echo "  FAIL: breadth 4 vs power 0.322 bits must read RELIABILITY_INFLATED — [$_po]"; fail=1 ;;
  esac
  # a mesh whose declared breadth IS reliably attained must NOT be flagged (no cry-wolf)
  : >"$_pd/led2"; printf 'senses: alpha beta\n' >"$_pd/card"
  for _i in 1 2 3 4 5 6; do echo "$_pnow $S alpha ok real reflex" >>"$_pd/led2"
                            echo "$_pnow $S beta ok real reflex"  >>"$_pd/led2"; done
  case "$(_pw "$_pd/led2" | grep '^POWER ')" in
    *verdict=POWER_OK*) echo "  ok: fully-attained declared breadth reads POWER_OK (gate does not cry wolf)" ;;
    *) echo "  FAIL: 2 organs, both always attained, must read POWER_OK"; fail=1 ;;
  esac
  # no evidence renders NA, never a power of 0 (an empty ledger is not a dead fleet)
  : >"$_pd/led3"
  case "$(_pw "$_pd/led3" | grep '^POWER ')" in
    *verdict=POWER_NA*I_power=na*|*I_power=na*verdict=POWER_NA*) echo "  ok: empty ledger → POWER_NA with I_power=na (not 0)" ;;
    *) echo "  FAIL: an empty attainment ledger must render POWER_NA/na, never a power of 0"; fail=1 ;;
  esac
  # --power is read-only: it must not touch the ledger it reads
  [ "$(wc -c <"$_pd/led2")" = "$( _pw "$_pd/led2" >/dev/null; wc -c <"$_pd/led2")" ] \
    || { echo "  FAIL: --power wrote to its own input ledger (a report must not feed its estimator)"; fail=1; }
  rm -rf "$_pd"
  [ "$( (wc -c <"$ATTAIN_LOG") 2>/dev/null || echo 0)" = "$_real_before" ] \
    || { echo "  FAIL: --test appended to the REAL attainment ledger — it would forge its own evidence"; fail=1; }
  [ "$fail" = 0 ] && { echo "smoke-test: ok (deps + debounce [1 dark=quiet, 2 consec=alarm, recovery resets] + up-debounce [1 live=withhold, 2 consec=recover, dark resets] + repeat-suppress [down-edge once, steady-state→trace, up-edge once] + organ-attrib-owner-tag [generic tagged, light untagged] + goal-attainment power [catch-all organ excluded, I=log2ΣC^ζ, no-cry-wolf, empty→NA, read-only, test writes no real ledger])"; exit 0; } || { echo "smoke-test: FAIL (missing dep — parser blind or escalation mute — or debounce/up-debounce/repeat-suppress/organ-attrib-owner-tag/goal-attainment-power regressed)"; exit 1; }
fi
if [ "${1:-}" = --power ]; then
  # READ-ONLY. Writes nothing — not $LOG, not $ATTAIN_LOG (a report that feeds its own input would
  # forge the evidence it exists to weigh).
  ZETA="${MESH_ORGAN_POWER_ZETA:-2}"          # I5 Reliability Preference forces ζ>1 (convex over goals)
  DAYS="${MESH_ORGAN_POWER_DAYS:-7}"
  MIN_N="${MESH_ORGAN_POWER_MIN_N:-5}"        # below this an organ's Ĉ is a guess → na, not 0 and not 1
  GAP="${MESH_ORGAN_POWER_GAP_BITS:-0.5}"
  cutoff="$(date -u -d "$DAYS days ago" +%FT%TZ 2>/dev/null || echo 0000-01-01T00:00:00Z)"
  echo "=== organ goal-attainment power @ $(ts) — $S ==="
  echo "(Heitzig & Potham arXiv:2608.08240, desiderata I1-I7 → I = log2 Σ_g C_g^ζ, ζ>1: breadth counted"
  echo " is NOT power. C = observed probe attainment rate; an UNPROBED organ's C is unknown, not 1.)"
  echo "  window ${DAYS}d since $cutoff · ζ=$ZETA · min-n=$MIN_N · ledger $ATTAIN_LOG"
  awk -v cutoff="$cutoff" -v me="$S" -v zeta="$ZETA" -v minn="$MIN_N" -v gapcut="$GAP" \
      -v declared="$(echo $organs)" -v ledger="$ATTAIN_LOG" '
    function l2(x){ return log(x)/log(2) }
    BEGIN{
      nd=split(declared, D, " ")
      while((getline line < ledger) > 0){
        n=split(line, F, " ")
        if(n < 5) continue
        if(F[1] < cutoff) continue
        if(F[2] != me) continue
        org=F[3]; verdict=F[4]; kind=F[5]
        if(kind != "real"){ catchall[org]=1; continue }   # fabricated pass — evidence of nothing
        tot[org]++; if(verdict=="ok") okc[org]++
      }
      printf "  %-16s %-9s %5s %7s %9s\n", "organ", "probe", "n", "C-hat", "C^zeta"
      sumz=0; measured=0; unprobed=0; thin=0
      for(i=1;i<=nd;i++){
        o=D[i]
        if(o in tot && tot[o]>=minn){
          c=okc[o]/tot[o]; z=c^zeta; sumz+=z; measured++
          printf "  %-16s %-9s %5d %7.3f %9.3f\n", o, "real", tot[o], c, z
        } else if(o in tot){
          thin++; printf "  %-16s %-9s %5d %7s %9s  (n<%d — excluded)\n", o, "real", tot[o], "na", "na", minn
        } else if(o in catchall){
          unprobed++; printf "  %-16s %-9s %5s %7s %9s  (probe() catch-all returns 0 — excluded)\n", o, "NONE", "-", "na", "na"
        } else {
          unprobed++; printf "  %-16s %-9s %5s %7s %9s  (no trial in window — excluded)\n", o, "?", "-", "na", "na"
        }
      }
      icount = (nd>0) ? l2(nd) : 0
      if(measured==0 || sumz<=0){
        printf "\n  declared=%d measured=0 — verdict: POWER_NA (no attainment evidence in window; the\n", nd
        printf "  breadth read log2(%d)=%.3f bits stands UNBACKED — that is not a power of 0, it is unknown)\n", nd, icount
        printf "POWER node=%s declared=%d measured=0 I_count=%.3f I_power=na gap=na verdict=POWER_NA\n", me, nd, icount
        exit 0
      }
      ipow = l2(sumz)
      imeas = l2(measured)
      gap_unprobed = icount - imeas      # breadth the mesh counts but never probed / too few trials
      gap_flaky    = imeas - ipow        # measured organs that do not always attain
      gap = icount - ipow
      printf "\n  declared (breadth the fleet map counts) : %d  → I_count = log2(%d) = %.3f bits\n", nd, nd, icount
      printf "  measured (real probe, n>=%d)             : %d\n", minn, measured
      printf "  I_power = log2(Σ C^%s over measured)      = %.3f bits\n", zeta, ipow
      printf "  gap = %.3f bits = %.3f (unprobed/thin: %d organ(s)) + %.3f (flaky: measured C<1)\n", gap, gap_unprobed, unprobed+thin, gap_flaky
      if(gap >= gapcut+0){
        cause = (gap_unprobed >= gap_flaky) ? "UNPROBED breadth" : "measured FLAKINESS"
        printf "  verdict: RELIABILITY_INFLATED — the capability count overstates attainment power by\n"
        printf "  %.3f bits; dominant cause: %s. I5 (dual Pigou-Dalton): capability spread over goals\n", gap, cause
        printf "  it does not reliably attain is LESS power than the same capability concentrated.\n"
        v="RELIABILITY_INFLATED"
      } else {
        printf "  verdict: POWER_OK — breadth and attainment power agree within %.3f bits\n", gapcut
        v="POWER_OK"
      }
      printf "POWER node=%s declared=%d measured=%d I_count=%.3f I_power=%.3f gap=%.3f verdict=%s\n", me, nd, measured, icount, ipow, gap, v
    }' </dev/null
  exit 0
fi
[ -z "$organs" ] && { echo "$(ts) no organs declared — no-op" >>"$LOG"; [ "${1:-}" = --status ] && echo "  $S: no organs declared"; exit 0; }

# NOTE (2026-06-13, operator): no standalone 'organs' window. It was an EMPTY mindless handle
# (no data/mind/loop) — exactly the special hand-managed window the channel/stream principle rejects.
# This keepalive runs headless via cron (*/10) + alerts DARK organs to the board; an organ's live
# presence belongs in the health channel / on the board, not in a bare shell window nobody watches.

rm -f "$MESH/.organ-dark-flag" 2>/dev/null || true   # legacy: retired by per-organ markers (one-time tidy)
for o in $organs; do
  # marker presence reflects PRIOR announce state (down-announced & not yet up-announced); compared
  # against this run's verdict to decide the EDGE. Read once before probe/debounce mutate anything.
  mp=0; [ -e "$ANNOUNCED_DIR/$o" ] && mp=1
  # one Bernoulli trial per organ per RUN, recorded before any remedy/re-probe (the remedy's re-probe
  # is a repair, not a fresh trial). Recorded only on the reflex path: --status is called ad hoc by
  # mesh-organs from any node, and an irregularly-sampled rate is not the cron-cadence rate --power
  # claims to estimate (a-senses-coverage-is-window-over-cadence).
  if probe "$o"; then pverdict=ok; else pverdict=dark; fi
  [ "${1:-}" = --status ] || attain_record "$o" "$pverdict" reflex
  if [ "$pverdict" = ok ]; then
    if [ "${1:-}" = --status ]; then echo "  $S:$o — $(status_label "$o" LIVE)"; continue; fi
    debounce "organ.$o" ok >/dev/null   # healthy → reset the consecutive-dark counter
    if [ "$(announce_action live "$mp")" = UP ]; then
      # down->up recovery: gate [organ-up] on the LIVE state being HELD >=N consecutive cycles
      # (organ-down-flap-debounce). A sub-threshold live blip → trace + KEEP the marker (still 'down'),
      # so a flapping organ never churns the board with a premature [organ-up].
      if [ "$(up_debounce "organ.$o" live)" = HELD ]; then
        announce_organ "$o" UP
      else
        echo "$(ts) recovering? $o (live but held <${UP_DEBOUNCE_N} consecutive — [organ-up] withheld, marker kept)" >>"$LOG"
        command -v mesh-trace >/dev/null 2>&1 && mesh-trace "[organ-recovering] $S: $o live again but held <${UP_DEBOUNCE_N} consecutive cycles — recovery debounced, [organ-up] withheld" >/dev/null 2>&1 || true
      fi
    fi
  else
    if [ "${1:-}" = --status ]; then echo "  $S:$o — $(status_label "$o" DARK)"; continue; fi
    up_debounce "organ.$o" dark >/dev/null   # a dark cycle breaks any live-recovery streak (reset up-counter)
    # declared but probe fails: try a gentle remedy, re-probe
    if remedy "$o" && sleep 1 && probe "$o"; then
      echo "$(ts) REMEDIED $o (was dark, recovered)" >>"$LOG"
      debounce "organ.$o" ok >/dev/null   # recovered → reset
      announce_organ "$o" "$(announce_action live "$mp")"   # remedied = recovery edge → [organ-up] once
    else
      # DEBOUNCE: only ALARM after N>=2 CONSECUTIVE dark runs — a single transient (organ mid-restart,
      # e.g. overhear) is logged but NOT yet alarmed (kills the false-DOWN the operator flagged 2026-06-24).
      if [ "$(debounce "organ.$o" fail)" = DOWN ]; then
        echo "$(ts) DARK $o (probe failed ${DEBOUNCE_N}+ consecutive, no sudo-free remedy)" >>"$LOG"
        # up->down edge → board [organ-down] ONCE; steady-state (already announced) → trace re-confirm.
        announce_organ "$o" "$(announce_action down "$mp")"
      else
        echo "$(ts) dark? $o (probe failed once — debounced, not yet alarmed)" >>"$LOG"
        # debounce limbo (not confirmed-down, not live): leave announce state untouched → NONE.
      fi
    fi
  fi
done
exit 0
