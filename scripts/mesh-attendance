#!/usr/bin/env bash
# orphan-ok: on-demand attendance fusion, mind/fusion-invoked live (LIVE-ONLY class — it folds
#   keypresence + sessions, themselves live mind-probes); no cron cache by design.
# mesh-attendance — PHYSICAL-vs-REMOTE attendance fusion: is a human AT this machine, shelled in
#   over the network, merely nearby — or is the node truly unattended?
#
# WHY this is a NEW derived signal (no single sensor, and no existing fusion, gives it):
#   - mesh-room-sense / mesh-room-activity answer "is the ROOM occupied / how active" by folding
#     mic + light + motion + BLE — environment signals an appliance can fake (a TV drives mic-LOUD,
#     a speaker shows as a BLE device). They do NOT separate a body physically at THIS node from a
#     remote SSH operator from a person merely in the room. That physical-vs-remote split is
#     invisible to every existing fusion.
#   - This fuses three PERSON-SPECIFIC, appliance-PROOF channels nothing else combines:
#       PHYSICAL  = mesh-keypresence              (keyboard IRQ — only a body at THIS machine bumps it)
#       REMOTE    = mesh-sessions                 (utmp remote logins — a human shelled in over the net)
#       NEARBY    = mesh-presence --classify pers  (the operator's PERSONAL BLE in proximity)
#     No appliance can fake a keypress, an SSH login, or a personal-classified device — so this is
#     robust to the appliance-vs-person trap BY CONSTRUCTION (it never reads mic-loud or a raw
#     device count, the two signals an appliance spoofs).
#
# HONEST-fusion contract (the no-silent-all-clear rule):
#   - Each channel renders its OWN reachability. keypresence exit-2 (headless / no physical kbd) →
#     PHYSICAL=UNKNOWN, visibly distinct from QUIET (kbd present, no keypress in window).
#     mesh-sessions exit-2 (utmp unreadable) → REMOTE=UNKNOWN. A stale/field-less presence.log →
#     NEARBY=UNKNOWN. UNATTENDED is asserted ONLY when all three channels are reachable AND negative;
#     if any channel is blind, the verdict degrades to UNKNOWN — never a faked UNATTENDED that could
#     hide a person the blind channel would have seen.
#   - keypress QUIET is NOT "absent": a person can sit and read. Only ACTIVE positively asserts a
#     body at the keyboard; QUIET/UNKNOWN stay agnostic. NEARBY and REMOTE carry the other positives.
#   - A FOREIGN remote login (public source IP) always surfaces as a flag, even under PHYSICAL —
#     it is security-relevant regardless of who else is attending.
#
# Verdict vocab (stable — text consumers grep these):
#   PHYSICAL    — keypress ACTIVE: a body is physically typing at this machine (un-spoofable)
#   NEARBY      — no keypress, but the operator's personal BLE is in proximity (in the room, not typing)
#   REMOTE      — no physical/nearby evidence, but >=1 remote login session is active
#   UNATTENDED  — all three channels reachable and negative (no keypress, no personal BLE, no remote)
#   UNKNOWN     — >=1 channel blind and no positive evidence: cannot honestly assert unattended
#   Flags appended: "+remote:N" (a remote session co-exists with a physical/nearby human),
#                   "FOREIGN-LOGIN!" (a remote session from a PUBLIC IP — escalate)
#
# ARRIVAL axis (cross-sense fusion: mesh-wake EDGE × this attendance LEVEL — a signal neither gives):
#   The verdict above is a LEVEL (who is here now). mesh-wake reports the discrete SUSPEND→RESUME
#   EDGE (the machine just woke) — a coarse arrival cue on its own: an idle-timer or scheduled task
#   can resume an EMPTY desk, so a fresh wake alone never proves a person returned. Folding the wake
#   edge together with the person-corroborated attendance level yields a "did the operator just
#   ARRIVE at THIS desk" signal no single sensor reports:
#     JUST-RETURNED  — fresh wake AND a body is corroborated present (PHYSICAL/NEARBY) → operator back
#     AUTO-WAKE      — fresh wake but UNATTENDED → machine woke with nobody here (timer/scheduled)
#     WAKE-UNVERIFIED— fresh wake but presence channels can't corroborate (REMOTE/UNKNOWN level)
#     STEADY         — no recent wake edge (AWAKE this boot, or resumed long ago) → not an arrival
#     UNKNOWN        — mesh-wake UNREACHABLE (can't read suspend history) → NOT a faked STEADY
#   Honest-fusion: a blind wake channel renders arrival=UNKNOWN (visibly distinct from STEADY), never
#   a silent "no arrival". Additive — the LEVEL verdict/flags vocab is unchanged; arrival is a new field.
#
# Usage:
#   mesh-attendance          one-line fused verdict + per-channel detail (incl. ARRIVAL line)
#   mesh-attendance --json   machine-readable {verdict, flags, physical, nearby, remote, arrival, wake, ts}
#   mesh-attendance --test   pure fusion-matrix smoke (no probes)
#
# Exit: 0 = verdict assessed (incl UNKNOWN) · 2 = ALL three channels unreachable (total sensory loss)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
HOST="$(hostname)"

# --- pure fusion (testable, no I/O): channel states -> verdict ---------------------------------
# PHYS  ∈ ACTIVE | QUIET | UNKNOWN
# NEARBY∈ PRESENT | ABSENT | UNKNOWN
# REMOTE∈ MESH | FOREIGN | QUIET | UNKNOWN
fuse_verdict() {  # <phys> <nearby> <remote>
  local PHYS="$1" NEARBY="$2" REMOTE="$3" positive=""
  [ "$PHYS" = ACTIVE ] && positive=PHYSICAL
  [ -z "$positive" ] && [ "$NEARBY" = PRESENT ] && positive=NEARBY
  [ -z "$positive" ] && { [ "$REMOTE" = MESH ] || [ "$REMOTE" = FOREIGN ]; } && positive=REMOTE
  if [ -n "$positive" ]; then echo "$positive"; return; fi
  # no positive — assert UNATTENDED only if every channel is reachable AND negative
  if [ "$PHYS" = QUIET ] && [ "$NEARBY" = ABSENT ] && [ "$REMOTE" = QUIET ]; then
    echo UNATTENDED; return
  fi
  echo UNKNOWN   # >=1 blind channel could hide a person -> honest-degraded, never faked unattended
}
fuse_flags() {  # <verdict> <remote> <remote_n>
  local V="$1" REMOTE="$2" N="${3:-0}" f=""
  [ "$REMOTE" = FOREIGN ] && f="${f} FOREIGN-LOGIN!"
  { [ "$V" = PHYSICAL ] || [ "$V" = NEARBY ]; } && { [ "$REMOTE" = MESH ] || [ "$REMOTE" = FOREIGN ]; } && f="${f} +remote:${N}"
  echo "${f# }"
}
# --- fuse_arrival <wake_verdict> <attendance_verdict> -> ARRIVAL (pure, testable, no I/O) -------
# Folds the mesh-wake EDGE (AWAKE | FRESH-WAKE | WAKED | UNREACHABLE) with this fusion's LEVEL.
# Only a FRESH-WAKE is an arrival candidate; corroboration by the level decides the kind. A blind
# wake channel (UNREACHABLE) -> UNKNOWN (never a faked STEADY). Verdict vocab above is untouched.
fuse_arrival() {  # <wake> <level>
  local W="$1" L="$2"
  [ "$W" = UNREACHABLE ] && { echo UNKNOWN; return; }   # can't read the edge -> honest unknown
  if [ "$W" = FRESH-WAKE ]; then
    case "$L" in
      PHYSICAL|NEARBY) echo JUST-RETURNED ;;            # woke + a body is corroborated here
      UNATTENDED)      echo AUTO-WAKE ;;                # woke but every channel says nobody home
      *)               echo WAKE-UNVERIFIED ;;          # REMOTE/UNKNOWN — woke, can't corroborate
    esac
    return
  fi
  echo STEADY   # AWAKE (never suspended) or WAKED (resumed long ago) -> no recent arrival edge
}
# --- remote_state <live_mesh> <stale_mesh> <foreign_n>  -> "STATE LIVE_N" --------------------
# Liveness-is-a-lease gate (testable, no I/O): utmp keeps a half-open SSH session AFTER the peer
# drops (TCP keepalive reaps it minutes later), so a dead mesh peer's lingering session would
# inflate REMOTE — reading a gone attendee as live. We cross-check each MESH session IP for
# reachability and count only the REACHABLE ones as live; unreachable mesh sessions are stale.
# FOREIGN session IPs are NEVER reachability-gated: a public source often drops ICMP even on a
# LIVE login, so ping-gating them could HIDE a real foreign attendee — a security regression.
remote_state() {  # <live_mesh> <stale_mesh> <foreign_n>
  local lm="$1" sm="$2" fn="$3"
  if [ "$fn" -gt 0 ]; then echo "FOREIGN $((fn + lm))"; return; fi   # foreign never gated; mesh added
  if [ "$lm" -gt 0 ]; then echo "MESH $lm"; return; fi
  echo "QUIET 0"   # only stale half-open mesh sessions (or none) -> no LIVE remote attendance
}
# --- recent_personal_max <presence-lines-blob> <age-limit-sec> <now-epoch> -> max personal count --
# BLE-flutter debounce (testable; now-epoch passed in so it is pure). A single BLE scan often DROPS a
# device that is still in the room (missed advertisement), so reading only the latest scan flips
# NEARBY PRESENT->ABSENT on noise — and the verdict NEARBY->REMOTE with it. We instead take the MAX
# attribution=personal:N across the last few scans that are WITHIN the staleness window: a person does
# not teleport out on one missed advert, so any recent in-window sighting holds NEARBY=PRESENT; only
# sustained absence across the window yields ABSENT. Echoes -1 if NO in-window line carries the field
# (caller keeps UNKNOWN). Staleness/field gates on the LATEST line are applied by the caller first.
recent_personal_max() {  # <blob> <age-limit> <now-epoch>
  local blob="$1" lim="$2" now="$3" mx=-1 ln lts lep age lp
  while IFS= read -r ln; do
    [ -n "$ln" ] || continue
    lts="$(printf '%s' "$ln" | grep -oE '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z')"
    [ -n "$lts" ] || continue
    lep="$(date -d "$lts" +%s 2>/dev/null)" || continue
    age=$(( now - lep ))
    [ "$age" -ge 0 ] && [ "$age" -le "$lim" ] || continue   # only in-window scans count
    lp="$(printf '%s' "$ln" | grep -oE 'attribution=personal:[0-9]+' | grep -oE '[0-9]+$')"
    [ -n "$lp" ] || continue
    [ "$lp" -gt "$mx" ] && mx="$lp"
  done <<<"$blob"
  echo "$mx"
}

if [ "${1:-}" = --test ]; then
  _f=0
  ck(){ local got="$1" want="$2" msg="$3"; [ "$got" = "$want" ] || { echo "  FAIL: $msg (got '$got' want '$want')"; _f=1; }; }
  # --- verdict matrix (FALSIFIABLE: change the precedence -> these fail) ---
  ck "$(fuse_verdict ACTIVE ABSENT QUIET)"   PHYSICAL   "ACTIVE keypress -> PHYSICAL"
  ck "$(fuse_verdict ACTIVE PRESENT MESH)"   PHYSICAL   "ACTIVE wins over nearby/remote"
  ck "$(fuse_verdict QUIET PRESENT QUIET)"   NEARBY     "personal BLE present, not typing -> NEARBY"
  ck "$(fuse_verdict QUIET PRESENT MESH)"    NEARBY     "nearby wins over remote"
  ck "$(fuse_verdict QUIET ABSENT MESH)"     REMOTE     "remote session only -> REMOTE"
  ck "$(fuse_verdict QUIET ABSENT FOREIGN)"  REMOTE     "foreign remote still REMOTE verdict"
  ck "$(fuse_verdict UNKNOWN ABSENT MESH)"   REMOTE     "positive remote despite blind physical"
  ck "$(fuse_verdict QUIET ABSENT QUIET)"    UNATTENDED "all reachable + negative -> UNATTENDED"
  # honest-degraded: a blind channel must BLOCK an UNATTENDED assertion
  ck "$(fuse_verdict QUIET UNKNOWN QUIET)"   UNKNOWN    "BLE blind -> cannot assert unattended"
  ck "$(fuse_verdict UNKNOWN ABSENT QUIET)"  UNKNOWN    "physical blind + no positive -> UNKNOWN"
  ck "$(fuse_verdict UNKNOWN UNKNOWN UNKNOWN)" UNKNOWN  "total blind -> UNKNOWN"
  # --- flags ---
  ck "$(fuse_flags PHYSICAL MESH 2)"   "+remote:2"               "physical + co-existing mesh remote"
  ck "$(fuse_flags NEARBY MESH 1)"     "+remote:1"               "nearby + co-existing remote"
  ck "$(fuse_flags REMOTE FOREIGN 1)"  "FOREIGN-LOGIN!"          "foreign login surfaces as flag"
  ck "$(fuse_flags PHYSICAL FOREIGN 1)" "FOREIGN-LOGIN! +remote:1" "foreign flagged even under PHYSICAL"
  ck "$(fuse_flags UNATTENDED QUIET 0)" ""                       "no flags when quiet"
  # --- remote_state: liveness-is-a-lease gate (stale half-open sessions excluded) ---
  ck "$(remote_state 2 0 0)" "MESH 2"    "2 reachable mesh -> MESH 2"
  ck "$(remote_state 1 1 0)" "MESH 1"    "1 live + 1 stale mesh -> MESH 1 (dead peer excluded)"
  ck "$(remote_state 0 2 0)" "QUIET 0"   "all mesh sessions stale -> QUIET (no LIVE remote)"
  ck "$(remote_state 0 0 1)" "FOREIGN 1" "foreign login -> FOREIGN 1"
  ck "$(remote_state 1 0 1)" "FOREIGN 2" "foreign never gated, live mesh added"
  ck "$(remote_state 0 1 1)" "FOREIGN 1" "foreign counted even when mesh all stale"
  # --- recent_personal_max: BLE-flutter debounce (fixed now-epoch so the window math is deterministic) ---
  _now="$(date -d '2026-06-21T23:00:00Z' +%s)"
  _inA="2026-06-21T22:59:30Z host devices=[..] attribution=personal:1,appliance:2,ambiguous:3"   # 30s, pers1
  _in0="2026-06-21T22:59:40Z host devices=[..] attribution=personal:0,appliance:1,ambiguous:2"   # 20s, pers0
  _old="2026-06-21T22:00:00Z host devices=[..] attribution=personal:5,appliance:0,ambiguous:0"   # 1h, out-of-window
  ck "$(recent_personal_max "$_inA" 900 "$_now")" 1  "in-window pers1 -> 1"
  ck "$(recent_personal_max "$_in0" 900 "$_now")" 0  "in-window pers0 -> 0"
  ck "$(recent_personal_max "$(printf '%s\n%s\n' "$_in0" "$_inA")" 900 "$_now")" 1 "latest 0 but recent 1 -> 1 (debounced dropout)"
  ck "$(recent_personal_max "$(printf '%s\n%s\n' "$_in0" "$_old")" 900 "$_now")" 0 "old pers5 excluded by age -> 0"
  ck "$(recent_personal_max "$_old" 900 "$_now")" -1 "no in-window line -> -1 (caller keeps UNKNOWN)"
  ck "$(recent_personal_max "" 900 "$_now")" -1 "empty -> -1"
  # --- fuse_arrival: wake EDGE × attendance LEVEL (FALSIFIABLE arrival matrix) ---
  ck "$(fuse_arrival FRESH-WAKE PHYSICAL)"   JUST-RETURNED   "fresh wake + body typing -> JUST-RETURNED"
  ck "$(fuse_arrival FRESH-WAKE NEARBY)"     JUST-RETURNED   "fresh wake + personal BLE near -> JUST-RETURNED"
  ck "$(fuse_arrival FRESH-WAKE UNATTENDED)" AUTO-WAKE       "fresh wake + nobody home -> AUTO-WAKE"
  ck "$(fuse_arrival FRESH-WAKE REMOTE)"     WAKE-UNVERIFIED "fresh wake + only remote -> WAKE-UNVERIFIED"
  ck "$(fuse_arrival FRESH-WAKE UNKNOWN)"    WAKE-UNVERIFIED "fresh wake + blind level -> WAKE-UNVERIFIED"
  ck "$(fuse_arrival AWAKE PHYSICAL)"        STEADY          "never suspended -> STEADY (no arrival edge)"
  ck "$(fuse_arrival WAKED NEARBY)"          STEADY          "resumed long ago -> STEADY"
  ck "$(fuse_arrival UNREACHABLE PHYSICAL)"  UNKNOWN         "wake blind -> UNKNOWN, never faked STEADY"
  [ "$_f" = 0 ] || { echo "smoke-test: FAIL"; exit 1; }
  echo "smoke-test: ok (fusion 11 + flags 5 + remote-liveness-gate 6 + ble-debounce 6 + arrival 8 = 36 assertions; appliance-proof + lease-honest + flutter-debounced + wake-corroborated arrival)"; exit 0
fi

JSON=0; [ "${1:-}" = --json ] && JSON=1

# ---- PHYSICAL channel: mesh-keypresence (2s window to keep the fusion fast) --------------------
PHYS=UNKNOWN; phys_detail="keypresence unreachable"
if command -v mesh-keypresence >/dev/null 2>&1; then
  kp_out="$(mesh-keypresence 2 2>/dev/null)"; kp_rc=$?
  if [ "$kp_rc" = 2 ]; then
    PHYS=UNKNOWN; phys_detail="no physical keyboard on $HOST (headless / IRQ absent — NOT 'quiet')"
  elif printf '%s' "$kp_out" | grep -q ACTIVE; then
    PHYS=ACTIVE; phys_detail="keyboard ACTIVE — a body is typing here"
  else
    PHYS=QUIET; phys_detail="keyboard QUIET (no keypress in window — not proof of absence)"
  fi
fi

# ---- REMOTE channel: mesh-sessions, reachability-gated (liveness-is-a-lease) -------------------
# mesh-sessions reads utmp (honest to its source), but utmp lingers a half-open session after the
# peer drops. We classify via its --json (mesh[] vs foreign[]), then ping-gate the MESH peers only
# so a DEAD mesh peer's stale session is not counted as live attendance. FOREIGN is never gated.
REMOTE=UNKNOWN; REMOTE_N=0; STALE_MESH=0; rem_detail="sessions unreadable (utmp)"
if command -v mesh-sessions >/dev/null 2>&1; then
  sess_json="$(timeout 5 mesh-sessions --json 2>/dev/null)"; sess_rc=$?
  if [ "$sess_rc" != 2 ] && [ -n "$sess_json" ]; then
    mesh_ips="$(printf '%s' "$sess_json"    | grep -oP '"mesh":\[\K[^]]*'    | grep -oE '([0-9]{1,3}\.){3}[0-9]{1,3}' || true)"
    foreign_ips="$(printf '%s' "$sess_json" | grep -oP '"foreign":\[\K[^]]*' | grep -oE '([0-9]{1,3}\.){3}[0-9]{1,3}' || true)"
    live_mesh=0; STALE_MESH=0
    for ip in $mesh_ips; do
      if timeout 2 ping -c1 -W2 "$ip" >/dev/null 2>&1; then live_mesh=$((live_mesh + 1)); else STALE_MESH=$((STALE_MESH + 1)); fi
    done
    foreign_n="$(printf '%s\n' $foreign_ips | grep -c . || true)"; [ -n "$foreign_n" ] || foreign_n=0
    read -r REMOTE REMOTE_N <<<"$(remote_state "$live_mesh" "$STALE_MESH" "$foreign_n")"
    case "$REMOTE" in
      MESH)    rem_detail="$REMOTE_N live remote mesh login(s)" ;;
      FOREIGN) rem_detail="$REMOTE_N remote login(s), >=1 from a PUBLIC IP — escalate" ;;
      QUIET)   rem_detail="no LIVE remote logins (local/tmux only)" ;;
    esac
    [ "$STALE_MESH" -gt 0 ] && rem_detail="$rem_detail; $STALE_MESH stale half-open session(s) excluded (peer unreachable — lingering utmp, not live)"
  fi
fi

# ---- NEARBY channel: personal BLE from presence.log (age-gated, single-source attribution) -----
# Use the presence reflex's last line (cheap, no fresh scan). Honest: a stale tape or a line
# lacking the attribution= field -> UNKNOWN (we cannot assess), never ABSENT.
NEARBY=UNKNOWN; near_detail="presence.log unavailable"
NEAR_AGE_LIMIT="${MESH_ATTEND_BLE_STALE:-900}"
pl_line="$(tail -1 "$HOME/.mesh/presence.log" 2>/dev/null || true)"
if [ -n "$pl_line" ]; then
  pl_ts="$(printf '%s' "$pl_line" | grep -oE '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z')"
  pl_age=""
  if [ -n "$pl_ts" ]; then
    ep="$(date -d "$pl_ts" +%s 2>/dev/null)" && pl_age=$(( $(date +%s) - ep ))
  fi
  pers="$(printf '%s' "$pl_line" | grep -oE 'attribution=personal:[0-9]+' | grep -oE '[0-9]+$')"
  if [ -z "$pl_age" ] || [ "$pl_age" -gt "$NEAR_AGE_LIMIT" ]; then
    NEARBY=UNKNOWN; near_detail="presence tape STALE (${pl_age:-?}s old > ${NEAR_AGE_LIMIT}s — feeder down, cannot assess BLE)"
  elif [ -z "$pers" ]; then
    NEARBY=UNKNOWN; near_detail="presence line lacks attribution field (older format) — cannot split personal"
  elif [ "$pers" -ge 1 ]; then
    NEARBY=PRESENT; near_detail="$pers personal BLE device(s) in proximity (${pl_age}s ago)"
  else
    # latest scan saw 0 personal — but a single dropped BLE advert is common noise. Debounce over the
    # last few in-window scans (recent_personal_max): any recent sighting holds PRESENT; only sustained
    # absence -> ABSENT. Keeps the verdict from fluttering NEARBY<->REMOTE on one missed scan.
    DEB_N="${MESH_ATTEND_BLE_DEBOUNCE:-3}"
    rmax="$(recent_personal_max "$(tail -n "$DEB_N" "$HOME/.mesh/presence.log" 2>/dev/null)" "$NEAR_AGE_LIMIT" "$(date +%s)")"
    if [ "$rmax" -ge 1 ]; then
      NEARBY=PRESENT; near_detail="personal BLE seen within last $DEB_N scans (latest scan 0 — debounced single-scan dropout)"
    else
      NEARBY=ABSENT;  near_detail="no personal BLE across last $DEB_N scans (${pl_age}s) — sustained absence"
    fi
  fi
fi

# total sensory loss -> exit 2 (honest: nothing was perceivable on any channel)
if [ "$PHYS" = UNKNOWN ] && [ "$REMOTE" = UNKNOWN ] && [ "$NEARBY" = UNKNOWN ]; then
  echo "[attendance] UNREACHABLE on $HOST — all three channels blind (keypresence + sessions + presence all unreadable)" >&2
  exit 2
fi

V="$(fuse_verdict "$PHYS" "$NEARBY" "$REMOTE")"
FLAGS="$(fuse_flags "$V" "$REMOTE" "$REMOTE_N")"

# ---- ARRIVAL axis: fold the mesh-wake EDGE into the attendance LEVEL ---------------------------
# mesh-wake reports the discrete SUSPEND→RESUME event (exit 2 = UNREACHABLE: can't read history).
# A blind/absent wake channel -> WAKE=UNREACHABLE -> arrival=UNKNOWN (honest, never a faked STEADY).
WAKE=UNREACHABLE; wake_detail="mesh-wake unavailable (cannot read suspend history)"
if command -v mesh-wake >/dev/null 2>&1; then
  wk_json="$(timeout 9 mesh-wake --json 2>/dev/null)"; wk_rc=$?
  if [ "$wk_rc" != 2 ] && [ -n "$wk_json" ]; then
    wv="$(printf '%s' "$wk_json" | grep -oE '"verdict":"[^"]*"' | head -1 | cut -d'"' -f4)"
    case "$wv" in
      AWAKE|FRESH-WAKE|WAKED)
        WAKE="$wv"
        wage="$(printf '%s' "$wk_json" | grep -oE '"age_sec":[0-9]+' | head -1 | cut -d: -f2)"
        wake_detail="wake=$wv${wage:+ (last resume ${wage}s ago)}" ;;
    esac
  fi
fi
ARRIVAL="$(fuse_arrival "$WAKE" "$V")"
ts="$(date -u +%FT%TZ)"

if [ "$JSON" = 1 ]; then
  printf '{"ts":"%s","host":"%s","verdict":"%s","flags":"%s","physical":"%s","nearby":"%s","remote":"%s","remote_n":%s,"arrival":"%s","wake":"%s"}\n' \
    "$ts" "$HOST" "$V" "$FLAGS" "$PHYS" "$NEARBY" "$REMOTE" "${REMOTE_N:-0}" "$ARRIVAL" "$WAKE"
  exit 0
fi

echo "[attendance] ${V}${FLAGS:+  ($FLAGS)} @ $HOST"
echo "  PHYSICAL: $PHYS — $phys_detail"
echo "  NEARBY:   $NEARBY — $near_detail"
echo "  REMOTE:   $REMOTE — $rem_detail"
echo "  ARRIVAL:  $ARRIVAL — $wake_detail"
exit 0
