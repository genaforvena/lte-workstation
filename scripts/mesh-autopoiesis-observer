#!/usr/bin/env python3
# reflex-cadence: 17 * * * *
# reflex-args: --run
"""Materialize and admit one bounded autopoiesis observation request per hour."""
from __future__ import annotations

import hashlib
import os
import re
import subprocess
import sys
from datetime import datetime, timedelta, timezone
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
MESH = Path(os.environ.get("MESH", str(Path.home() / ".mesh")))
WINDOW_HOURS = 2
TIMESTAMP = re.compile(r"^(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ)\b")
SOURCES = ("chat.log", "witness.log", "sensors.log")


def now() -> datetime:
    raw = os.environ.get("MESH_OBSERVER_NOW")
    if raw:
        return datetime.strptime(raw, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc)
    return datetime.now(timezone.utc)


def window() -> tuple[datetime, datetime]:
    end = now().replace(minute=0, second=0, microsecond=0)
    return end - timedelta(hours=WINDOW_HOURS), end


def source_events(path: Path, start: datetime, end: datetime) -> tuple[list[str], int, list[str]]:
    unique: dict[str, str] = {}
    rows = 0
    errors: list[str] = []
    for lineno, raw in enumerate(path.read_text(encoding="utf-8", errors="replace").splitlines(), 1):
        match = TIMESTAMP.match(raw)
        if not match:
            continue
        try:
            observed = datetime.strptime(match.group(1), "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc)
        except ValueError:
            errors.append(f"{path.name}:{lineno}: invalid timestamp")
            continue
        if not start <= observed < end:
            continue
        rows += 1
        normalized = " ".join(raw.split())
        key = hashlib.sha256(f"{path.name}\n{normalized}".encode()).hexdigest()
        unique.setdefault(key, normalized)
    return list(unique.values()), rows, errors


def report_path(source_key: str) -> Path:
    return MESH / "autopoiesis-observation" / "analysis" / f"{source_key.removeprefix('observation-window:')}.md"


def plan_path(source_key: str) -> Path:
    return MESH / "autopoiesis-observation" / "plans" / f"{source_key.removeprefix('observation-window:')}.tsv"


def observe() -> int:
    start, end = window()
    suffix = f"{start:%Y%m%dT%H0000Z}-{end:%H}0000Z"
    source_key = f"observation-window:{suffix}"
    details: list[tuple[str, int, int, list[str]]] = []
    incomplete: list[str] = []
    all_events: list[str] = []
    for name in SOURCES:
        path = MESH / name
        if not path.is_file() or not os.access(path, os.R_OK):
            incomplete.append(f"{name}: unreadable or missing")
            details.append((name, 0, 0, []))
            continue
        try:
            events, rows, errors = source_events(path, start, end)
        except OSError as exc:
            incomplete.append(f"{name}: {exc}")
            details.append((name, 0, 0, []))
            continue
        if not events:
            incomplete.append(f"{name}: no timestamped event in window")
        if errors:
            incomplete.extend(errors)
        details.append((name, rows, len(events), errors))
        all_events.extend(f"{name}:{event}" for event in events)

    report = report_path(source_key)
    report.parent.mkdir(parents=True, exist_ok=True)
    total_rows = sum(row_count for _, row_count, _, _ in details)
    total_unique = len(all_events)
    deduplicated = total_rows - total_unique
    lines = [
        "# Hourly autopoiesis observation request",
        "",
        f"source={source_key}",
        f"window_start={start:%Y-%m-%dT%H:%M:%SZ}",
        f"window_end={end:%Y-%m-%dT%H:%M:%SZ}",
        "interval=[start,end)",
        "evidence_complete=" + ("yes" if not incomplete else "no"),
        f"source_rows={total_rows}",
        f"unique_events={total_unique}",
        f"deduplicated_events={deduplicated}",
        "",
        "| source | rows | unique events |",
        "|---|---:|---:|",
    ]
    lines.extend(f"| {name} | {rows} | {unique} |" for name, rows, unique, _ in details)
    if incomplete:
        lines += ["", "## Admission deferred", ""] + [f"- {item}" for item in incomplete]
    else:
        lines += ["", "Admission evidence is complete: all durable source tapes are readable, "
                  "covered the bounded window, and exact duplicate events were removed."]
    report.write_text("\n".join(lines) + "\n", encoding="utf-8")

    if incomplete:
        print(f"deferred: incomplete admission evidence source={source_key} report={report}")
        return 0

    plan = plan_path(source_key)
    plan.parent.mkdir(parents=True, exist_ok=True)
    plan.write_text(
        "\n".join([
            "#tags=autopoiesis,observation",
            "#origin.kind=need",
            f"#origin.source={source_key}",
            "#origin.hypothesis=the retained mesh tapes contain analyzable recent observations",
            f"#origin.question=what bounded signal emerges from {start:%Y-%m-%dT%H:%M:%SZ} through {end:%Y-%m-%dT%H:%M:%SZ}?",
            f"#origin.acceptance=read and classify the complete evidence report at {report}",
            "#origin.feedback=adopt a warranted follow-up or retain a negative result; do not retry incomplete evidence",
            f"health\tanalyze-observation\tAnalyze the deduplicated prior-two-hour observation report: {report}",
            "",
        ]),
        encoding="utf-8",
    )
    admit = os.environ.get("MESH_AUTOPOIESIS_BIN", str(ROOT / "scripts" / "mesh-autopoiesis"))
    result = subprocess.run([admit, "admit", "--plan", str(plan)], text=True)
    if result.returncode == 0:
        print(f"admitted source={source_key} report={report} unique_events={total_unique}")
    else:
        print(f"admission-not-created source={source_key} report={report} rc={result.returncode}")
    return result.returncode


def smoke() -> int:
    if WINDOW_HOURS != 2 or len(SOURCES) != 3:
        return 1
    start, end = window()
    if (end - start).total_seconds() != 7200:
        return 1
    print("mesh-autopoiesis-observer: smoke-test ok (hour bucket, two-hour bound, three durable sources)")
    return 0


if __name__ == "__main__":
    if "--test" in sys.argv:
        raise SystemExit(smoke())
    if "--run" not in sys.argv:
        print("usage: mesh-autopoiesis-observer --run | --test", file=sys.stderr)
        raise SystemExit(2)
    raise SystemExit(observe())
