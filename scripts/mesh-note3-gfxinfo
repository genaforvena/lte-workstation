#!/usr/bin/env bash
# reflex-cadence: 11-59/5 * * * *
# doctor-artifact: $HOME/.mesh/.note3-gfxinfo.state 1200 phone
# mesh-note3-gfxinfo — honest Note3 rendered-UI sample from dumpsys gfxinfo.
set -uo pipefail

SERIAL="${MESH_NOTE3_SERIAL:-4d00553d61ab90b7}"
MESH_DIR="${MESH_DIR:-${HOME:-/tmp}/.mesh}"
EVIDENCE_ROOT="${MESH_EVIDENCE_ROOT:-${HOME:-/tmp}/.mesh/evidence}/note3-gfxinfo-20260920"
RAW="${EVIDENCE_ROOT}/gfxinfo.raw"
STATE="${MESH_NOTE3_GFXINFO_STATE:-$MESH_DIR/.note3-gfxinfo.state}"
RUNLOG="${MESH_NOTE3_GFXINFO_RUNLOG:-$MESH_DIR/note3-gfxinfo.log}"

now_utc() { date -u +%Y-%m-%dT%H:%M:%SZ; }

parse_dump() {
  awk '
    /Graphics info for pid [0-9]+ \[/ {
      if (pid != "") exit
      if (pid == "") {
        line=$0
        match(line, /pid [0-9]+ \[[^]]+\]/)
        token=substr(line, RSTART, RLENGTH)
        sub(/^pid /, "", token)
        split(token, a, / \[/)
        pid=a[1]
        package=a[2]
        sub(/\]$/, "", package)
      }
    }
    /^Profile data in ms:/ { profile=1 }
    /^View hierarchy:/ { views_section=1 }
    profile && /Draw:/ { profile_rows++ }
    views_section && /ViewRootImpl/ { roots++ }
    END {
      if (pid != "" && package != "" && (profile_rows > 0 || roots > 0))
        printf "pid=%s|package=%s|profile_rows=%d|view_roots=%d\n", pid, package, profile_rows, roots
    }
  '
}

unknown() {
  local reason=${1:-unknown} ts=${2:-$(now_utc)}
  printf 'status=UNKNOWN reason=%s observed_at=%s age_s=0 pid=unknown package=unknown\n' "$reason" "$ts"
  return 2
}

read_dump() {
  if [ -n "${MESH_NOTE3_GFXINFO_RAW_OVERRIDE:-}" ]; then
    printf '%s\n' "$MESH_NOTE3_GFXINFO_RAW_OVERRIDE"
  else
    timeout 20 adb -s "$SERIAL" shell dumpsys gfxinfo 2>/dev/null | tr -d '\r'
  fi
}

probe() {
  local ts dump parsed
  ts="$(now_utc)"
  dump="$(read_dump)" || { unknown adb_unreachable "$ts"; return 2; }
  [ -n "$dump" ] || { unknown empty_gfxinfo "$ts"; return 2; }
  parsed="$(printf '%s\n' "$dump" | parse_dump)"
  [ -n "$parsed" ] || { unknown missing_graphics_surface "$ts"; return 2; }
  printf 'status=OK observed_at=%s age_s=0 %s\n' "$ts" "$parsed"
}

write_reading() {
  local reading="$1" tmp
  mkdir -p "$(dirname "$STATE")" "$(dirname "$RUNLOG")" "$EVIDENCE_ROOT" || return 1
  tmp="$(mktemp "${STATE}.XXXXXX")" || return 1
  printf '%s\n' "$reading" >"$tmp" && mv -f "$tmp" "$STATE" || { rm -f "$tmp"; return 1; }
  printf '%s %s\n' "$(now_utc)" "$reading" >>"$RUNLOG" || return 1
}

if [ "${1:-}" = --test ]; then
  fixture=$'Applications Graphics Acceleration Info:\nGraphics info for pid 4242 [com.example.ui]:\nProfile data in ms:\nDraw:\nView hierarchy:\n  ViewRootImpl #0: 22 views'
  expected="$(printf '%s\n' "$fixture" | parse_dump)"
  printf '%s\n' "$expected" | grep -q 'pid=4242' || { echo 'smoke-test: FAIL (pid parse)'; exit 1; }
  printf '%s\n' "$expected" | grep -q 'package=com.example.ui' || { echo 'smoke-test: FAIL (package parse)'; exit 1; }
  printf '%s\n' "$expected" | grep -q 'view_roots=1' || { echo 'smoke-test: FAIL (view-root parse)'; exit 1; }
  bad=$'Applications Graphics Acceleration Info:\nnot a graphics block'
  [ -z "$(printf '%s\n' "$bad" | parse_dump)" ] || { echo 'smoke-test: FAIL (hollow dump accepted)'; exit 1; }
  out="$(probe)"; rc=$?
  case "$rc" in
    0) echo "smoke-test: ok (fixture + LIVE ADB read: $out)"; exit 0 ;;
    2) echo "smoke-test: n/a (fixture parse passed; LIVE ADB unavailable: $out)"; exit 2 ;;
    *) echo "smoke-test: FAIL (live read rc=$rc: $out)"; exit 1 ;;
  esac
fi

reading="$(probe)"; rc=$?
if [ -n "${MESH_NOTE3_GFXINFO_RAW_OVERRIDE:-}" ]; then
  mkdir -p "$EVIDENCE_ROOT" && printf '%s\n' "$MESH_NOTE3_GFXINFO_RAW_OVERRIDE" >"$RAW"
elif [ "$rc" -eq 0 ]; then
  mkdir -p "$EVIDENCE_ROOT"
  read_dump >"$RAW" || true
fi
write_reading "$reading" || { echo 'mesh-note3-gfxinfo: failed to write state/log' >&2; exit 1; }
printf '%s\n' "$reading"
exit "$rc"
