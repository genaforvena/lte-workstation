#!/usr/bin/env bash
# mesh-devcd-catch — CATCH the kernel's devcoredump before it deletes itself.
#
# WHY (discover find 2026-08-21T08:07Z, health verify 08:24:27Z + report
# ~/.mesh/knowledge/verify-devcoredump-fault-evidence-channel-mesh-home-20260821.md, probe
# ~/.mesh/knowledge/probe-devcoredump-fault-evidence-mesh-home-20260821.sh → rc 0
# "armed, empty, produced-for, unwatched"):
#
# When a driver's firmware crashes, the kernel takes a forensic dump and publishes it at
# /sys/class/devcoredump/devcdN/data. **It then DELETES it — and the retention on THIS kernel is
# exactly 300 s.** That number is not an upstream #define quoted from memory; health extracted it
# from this running kernel's own binary: KASLR slide 0x28e00000 off _stext, dev_coredumpm+0x216
# reads `mov $0x493e0,%ecx; call queue_delayed_work_on` = 300000 jiffies, and
# /boot/config-6.8.0-138-generic has CONFIG_HZ=1000 → 300 s. There is NO knob to extend it: the
# devcoredump class carries exactly one attribute, `disabled`.
#
# **THIS IS WHY THE TOOL IS A LISTENER AND NOT A CADENCE.** A */5 cron races a 300 s self-deleting
# artifact and will silently miss dumps — and the miss looks exactly like "no crash happened". The
# channel needs something that copies the dump out THE MOMENT IT APPEARS. So the primary mode is
# --listen: an unprivileged `udevadm monitor --kernel --subsystem-match=devcoredump` reader that
# extracts on the `add` uevent, milliseconds in, not minutes.
#
# WHY THIS NODE SPECIFICALLY: the sole uplink is an RTL8822BU USB dongle that wedges (moved through
# five USB paths, faulting at every one — CLAUDE.local.md). `rtw88_core` IS a registered devcoredump
# producer (imports dev_coredumpv, carries the fw-crash dump path; probe leg D). So today every
# firmware crash on the node's ONLY path destroys its own evidence unwatched — and health measured
# that the fault VIEW was inverted relative to that evidence: mesh-hw-fault-watch's radio alphabet
# was (fail|error|timed out), so `firmware crash, start reset and recover`, `Firmware Coredump Nth`
# and `fw crash dump's length is 0` all NO-MATCHED while `dump fw fifo fail` matched — it paged
# exactly when the dump could NOT be taken and was silent for the 300 s a real dump was readable.
# That half is FIXED and landed (ffd48e6, 'crash' added to the alphabet). This tool is the other
# half: the alphabet now tells us a dump EXISTS; this takes the dump.
#
#   mesh-devcd-catch                one SWEEP pass: capture any live dump now (the cron BACKSTOP)
#   mesh-devcd-catch --sweep        same, explicit
#   mesh-devcd-catch --listen       THE PRIMARY: block on uevents, capture the instant one appears
#   mesh-devcd-catch --status       channel arm state + listener state + last capture (no capture)
#   mesh-devcd-catch --list         the dumps captured on disk (size, failing device, sha256)
#   mesh-devcd-catch --test         smoke test (exit 2 where the class is absent)
#   mesh-devcd-catch --test-fast    the FAST CORE of that suite — what mesh-doctor drives (see below)
#
# TWO LAYERS, DELIBERATELY, AND THEY ARE NOT REDUNDANT:
#   · --listen is the catch. Registered in ~/.mesh/supervise.list, so mesh-supervise (every 120 s
#     from the always-on, systemd Restart=always mesh-liveness-loop) restarts it if it dies.
#   · --sweep is the BACKSTOP for the listener's own death window. Coverage is window/cadence
#     (a-senses-coverage-is-window-over-cadence): the artifact lives 300 s, the sweep runs every
#     60 s, so a dump born while the listener is down still gets ~5 chances. The sweep also REPAIRS
#     the listener: it self-registers in ~/.mesh/supervise.list, RUNS mesh-supervise, and re-reads
#     listener_pid to see whether that worked — a backstop that silently carries the load is a
#     backstop nobody fixes, and a detector whose only actuator is a human's attention is not a loop.
#     The board post sits behind that OUTCOME, so a listener repaired inside one tick wakes nobody.
#
# Design constraints:
#   - ARMING NEEDS NO PRIVILEGE, READING THE DUMP DOES. `udevadm monitor` receives as uid 1000
#     (asserted for real, off the tmux path, in health's probe leg F). But devcdN/data is 0600 root,
#     so extraction is one `sudo -n cat` (NOPASSWD here). --test asserts that privilege path for
#     REAL against a live root-owned sysfs file, never by assuming it.
#   - THE MODE BIT IS NOT THE READ (a-mode-bit-is-not-the-write, one ring out): we never gate on
#     `[ -r data ]`. We ATTEMPT the read and check the bytes that came back. A 0-byte result is a
#     FAILURE, never a capture — an empty .bin filed as evidence is the plausible-constant trap.
#   - A FAILED CAPTURE IS NOT MARKED SEEN, so the sweep retries inside the remaining window; but a
#     key that has failed $FAILCAP times is retired LOUDLY, so a permanently unreadable dump cannot
#     hot-loop the listener.
#   - ABSOLUTE PATHS FOR EVERY HELPER. cron's PATH is /usr/bin:/bin and health lost a probe leg to
#     exactly this (modinfo is /usr/sbin) while the summary still printed a verdict. Any n/a leg
#     here makes the summary say UNASSERTED — never a pass.
#   - LOUD: every capture writes the durable ledger ~/.mesh/devcd-catch.log, calls mesh-trace, and
#     posts one board [fyi]. The ledger is DELIBERATELY NOT the cron stdout log — sharing them
#     double-counts the rate (the lesson from mesh-exit-node-lan-heal).
#   - DEPLOYING THIS TOOL KILLS ITS OWN LISTENER (measured while building it, 2026-08-21): bash
#     reads a script incrementally, so `cp` over ~/.local/bin/mesh-devcd-catch truncates the file
#     under the running --listen and it dies mid-read. That is survivable BY DESIGN, not by luck —
#     mesh-supervise restarts it within 120s and the */1 sweep covers the gap — but if you deploy
#     during a live 300s window, sweep once by hand afterwards.
#   - **READ THE CAPTURE RATE AS THE DONGLE FAULT RATE.** A rising count is the RTL8822BU degrading;
#     it is not a node quietly healing itself.
#   - WE NEVER WRITE TO devcdN/data. Writing frees the dump immediately — it would destroy the
#     artifact for any other reader inside the window. We only read.
#   - WE NEVER FIRE A DUMP. /sys/kernel/debug/ieee80211/phy4/rtw88/fw_crash exists on this node and
#     is FORBIDDEN: it crashes the firmware of the SOLE UPLINK, i.e. it severs the channel the
#     result would be reported over — self-defeating, not reversible from outside itself.
#
# test-fast: yes
# THE FULL SUITE IS LONGER THAN EVERY RUNNER'S CAP ON THIS NODE, so it declares a FAST CORE.
# Measured 2026-08-29T00:50Z on this node, arm by arm: `--test` = 37.8s wall, rc=0 — D (two live
# `udevadm monitor` windows) 6.0s, I (the listener's own event loop, driven twice) 14.8s, J2 (the
# red arm, which by construction waits out MESH_DEVCD_AWAIT for a restart that never comes) 12.2s
# and J4 4.3s, against 1.2s for ALL the rest. mesh-doctor drives every tool's gate twice: the
# parallel probe grants `timeout 12` and the serial confirm grants 60s, so this suite could only
# ever TIME OUT on the probe — and did, at 22:23Z (cron) and 22:45:49Z (--comprehensive), which is
# why a tool that is rc=0 by hand sat in FAIL(stale) and could not leave: leaving that bucket needs
# a confirm that COMPLETES, and the confirm is what times out. A gate no runner can reach is not a
# gate. So `--test-fast` runs the cheap legs (~1.3s, well inside the 12s probe cap) and is what the
# doctor drives; `--test` stays the WHOLE suite and is what mesh-land runs at landing under its
# 180s per-candidate budget — the strong claim is not weakened, it is given the runner that can
# afford it.
# WHAT THE FAST CORE KEEPS, and why this split is not the usual "drop the slow arms": the legs the
# doctor now drives include J0/J1/J3, i.e. the USER-unset actuator arm from 8fc2cafc. That is the
# regression that made this tool interesting — a `--test` that died on an unset USER and so read
# RED exactly in the cron/systemd environment the tool runs in — and a speed-up that quietly
# dropped it would leave the doctor confirming a suite that no longer covers the defect it was
# stamped red for. The gate below MUTATES the USER fallback away and requires the FAST core to go
# red, so that coverage cannot be lost silently.
# Keep the split honest in BOTH directions: a new cheap gate belongs in the fast core, and if the
# fast core ever outgrows the probe cap the doctor is blind again (the boundary gate measures it).
# task:mesh-devcd-catch, 2026-08-29.
#
# reflex-cadence: * * * * *
# reflex-args: --sweep
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

CLASS="${DEVCD_CLASS:-/sys/class/devcoredump}"     # override exists for --test's synthetic arm ONLY
STATE_DIR="${MESH_STATE_DIR:-$HOME/.mesh}"
DUMP_DIR="${MESH_DEVCD_DIR:-$STATE_DIR/devcd}"
LEDGER="${MESH_DEVCD_LEDGER:-$STATE_DIR/devcd-catch.log}"
SEEN="${MESH_DEVCD_SEEN:-$STATE_DIR/.devcd-catch-seen}"
LOCK="${MESH_DEVCD_LOCK:-$STATE_DIR/.devcd-catch.lock}"
CHAT="${MESH_DEVCD_CHAT:-1}"
KEEP="${MESH_DEVCD_KEEP:-20}"          # newest N .bin kept
MAXMB="${MESH_DEVCD_MAXMB:-512}"       # and total bytes capped
FAILCAP="${MESH_DEVCD_FAILCAP:-5}"     # retire a key after this many failed reads
CHATCAP="${MESH_DEVCD_CHATCAP:-6}"     # board posts per rolling hour; a burst collapses to one line
# ── the listener's own actuator (see heal_listener) ──────────────────────────────────────────────
SUPREG="${MESH_DEVCD_SUPREG:-$STATE_DIR/supervise.list}"        # mesh-supervise's registry
SUPCMD="${MESH_DEVCD_SUPERVISE_CMD:-mesh-supervise}"            # the actuator; a --test seam
HEALLOG="${MESH_DEVCD_HEAL_LEDGER:-$STATE_DIR/devcd-catch-listener-restarts.log}"
AWAIT="${MESH_DEVCD_AWAIT:-10}"        # half-second polls to wait for a setsid'd restart to appear
RESTARTCAP="${MESH_DEVCD_RESTARTCAP:-3}"   # repairs per 24h above which the RATE itself goes loud

SUDO=/usr/bin/sudo; UDEVADM=/usr/bin/udevadm; SHA=/usr/bin/sha256sum
STAT=/usr/bin/stat; FLOCK=/usr/bin/flock; TIMEOUT=/usr/bin/timeout
STDBUF=/usr/bin/stdbuf; JOURNALCTL=/usr/bin/journalctl

mkdir -p "$STATE_DIR" "$DUMP_DIR"
now(){ date -u +%Y-%m-%dT%H:%M:%SZ; }
say(){ printf '%s\n' "$*"; }

# ── SIGNING OUR OWN PROBE ────────────────────────────────────────────────────────────────────────
# Arms D and I raise a real synthetic uevent to prove the receive leg is alive. That mints 8 events
# on /dev/{full,kmsg,mem,null,port,random,urandom,zero}, and mesh-device-churn — which reads
# /sys/kernel/uevent_seqnum and cannot read a signature at all — then reports CHURN. Nothing in
# between used to say the enumeration was OURS, and attributing one such burst cost 35 hours.
#
# So the probe signs itself at the source, in SYNTH_UUID, which mesh-udev-stream records as its own
# tape column. Not by device set and not by burst size: an 8-event mem burst is a PROXY for identity
# and its failure direction is silence — the day something else enumerates those same eight nodes,
# a fingerprint would swallow it.
#
# `udevadm trigger --uuid` cannot do this: it takes no argument and mints a fresh random uuid per
# device (measured, udevadm 255). Writing `change <uuid>` into each device's sysfs `uevent` file is
# the same syscall udevadm makes, minus the discarded identity.
# BASH_SOURCE[0], never $0. `command -v "$0"` resolves a bare invocation through PATH to the
# DEPLOYED twin, so a mutant or a scratch copy would silently source the library next to the
# installed file instead of the one beside itself — measured here, and it cost a red control run.
MESH_UEVENT_SIG_OK=0
for _mus in "${MESH_UEVENT_SIG_LIB:-}" "$HOME/.local/bin/mesh-uevent-sig.sh" \
            "$(dirname "$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null)")/mesh-uevent-sig.sh"; do
  [ -n "$_mus" ] && [ -r "$_mus" ] && . "$_mus" && { MESH_UEVENT_SIG_OK=1; break; }
done
unset _mus

# Fires the receive-leg probe. PROBE_PATH names WHICH path it took — `signed`, `unsigned` or `none`
# — so a missing library degrades to the old unsigned trigger LOUDLY (arm D prints it) instead of
# quietly reverting the attribution. The word is a variable, not stdout, because arm I captures this
# call's output as a udevadm line layout and a stray sentence there would be parsed as one.
PROBE_PATH=none
probe_uevent(){
  PROBE_PATH=none
  if [ "$MESH_UEVENT_SIG_OK" = 1 ] \
     && mesh_uevent_trigger_signed mesh-devcd-catch "$SUDO -n" /sys/class/mem/*; then
    PROBE_PATH=signed; return 0
  fi
  if "$SUDO" -n "$UDEVADM" trigger --action=change --subsystem-match=mem 2>/dev/null; then
    PROBE_PATH=unsigned; return 0
  fi
  return 1
}
probe_path_say(){
  case "$PROBE_PATH" in
    signed)   say "   probe: SIGNED synth-uuid=$(mesh_uevent_sig_uuid mesh-devcd-catch) on /sys/class/mem/* — this burst is attributable to devcd-catch on mesh-udev-stream's tape, by signature and not by device set";;
    unsigned) say "   probe: UNSIGNED fallback (mesh-uevent-sig.sh $( [ "$MESH_UEVENT_SIG_OK" = 1 ] && echo 'loaded, but the signed write failed' || echo 'not found' )) — this burst WILL read as unattributed device churn";;
    *)        say "   probe: NOT FIRED — no privileged path to raise a uevent at all";;
  esac
}

# ── loudness ────────────────────────────────────────────────────────────────────────────────────
# NB: args are joined with REAL tabs here. `ledger "a\tb"` in a double-quoted bash string writes a
# literal backslash-t, not a separator — awk -F'\t' would then see one field and every rate query
# (the board cap, --status) would silently read zero. Pass fields as separate ARGS.
ledger(){ local IFS=$'\t'; printf '%s\t%s\n' "$(now)" "$*" >>"$LEDGER"; }
trace(){ command -v mesh-trace >/dev/null 2>&1 && mesh-trace "devcd-catch: $*" >/dev/null 2>&1; }
board(){ # one [fyi] per capture, capped per rolling hour so a crash-loop cannot storm the board
  [ "$CHAT" = 1 ] || return 0
  command -v mesh-chat >/dev/null 2>&1 || return 0
  local cutoff n; cutoff=$(date -u -d '-1 hour' +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)
  n=$(awk -v c="$cutoff" -F'\t' '$1>=c && $2 ~ /^captured/' "$LEDGER" 2>/dev/null | wc -l)
  if [ "${n:-0}" -gt "$CHATCAP" ]; then
    [ "$n" -eq $((CHATCAP+1)) ] && mesh-chat "[fyi] devcd-catch: BURST — >$CHATCAP dumps captured in the last hour; board posts suppressed, read the ledger $LEDGER and mesh-devcd-catch --list. A rising capture rate IS the RTL8822BU fault rate." >/dev/null 2>&1
    return 0
  fi
  mesh-chat "$*" >/dev/null 2>&1
}

# ── the seen-set ────────────────────────────────────────────────────────────────────────────────
seen_status(){ [ -f "$SEEN" ] && awk -F'\t' -v k="$1" '$1==k{print $2}' "$SEEN" | tail -1; }
seen_fails(){  [ -f "$SEEN" ] && awk -F'\t' -v k="$1" '$1==k && $2=="fail"' "$SEEN" | wc -l || echo 0; }
seen_mark(){   printf '%s\t%s\t%s\n' "$1" "$2" "$(now)" >>"$SEEN"; }

# ONE guard, taken by BOTH entrypoints. The listener and the */1 cron sweep share the seen-set and
# the dump dir; without this they interleave and one dump gets filed twice (which would make the
# capture rate stop meaning the fault rate). Never nest a with_lock inside a with_lock.
with_lock(){ exec 9>"$LOCK" || return 1; "$FLOCK" -w 30 9 || { say "busy: another mesh-devcd-catch holds $LOCK"; return 1; }; "$@"; local r=$?; exec 9>&-; return $r; }

# ── capture ONE dump directory. The only code path; --listen and --sweep both come here ─────────
capture_one(){
  local d="$1" dev key mt fdev drv out part size sha ctx fails
  dev=$(basename "$d")
  # sysfs class-device dir mtime is instantiation, i.e. when the kernel created this dump. Reading
  # an ATTRIBUTE restamps the attribute, not the directory (a-sysfs-attribute-mtime-is-dentry-...),
  # so the pair (devname, dir-mtime) is a stable identity for one dump across devcdN reuse.
  mt=$("$STAT" -c %Y "$d" 2>/dev/null || echo 0)
  key="$dev@$mt"

  case "$(seen_status "$key")" in
    captured) return 3 ;;                    # already ours
    retired)  return 3 ;;
  esac
  fails=$(seen_fails "$key")
  if [ "${fails:-0}" -ge "$FAILCAP" ]; then
    seen_mark "$key" retired
    ledger retired "$key" "unreadable after $fails attempts"
    trace "RETIRED $key — unreadable after $fails attempts"
    board "[fyi] devcd-catch: a live devcoredump ($key) was UNREADABLE after $fails attempts and is now retired — the 300s window will close on uncaptured evidence. Check sudo -n and $CLASS/$dev/data."
    return 2
  fi

  fdev=$(readlink -f "$d/failing_device" 2>/dev/null)
  drv=$(basename "$(readlink -f "$d/failing_device/driver" 2>/dev/null)" 2>/dev/null)
  [ -n "$drv" ] && [ "$drv" != "." ] || drv=unknown

  # The dump's OWN identity goes in the filename, not just the capture clock: a name keyed only on
  # the moment collides for two captures in the same second and the later one overwrites the earlier
  # (a-name-keyed-on-the-moment-cannot-converge-on-re-processing). Found by a mutant drill, 2026-08-21.
  out="$DUMP_DIR/$(date -u +%Y%m%dT%H%M%SZ)-$dev-$drv-$mt.bin"
  local _i=0; while [ -e "$out" ]; do _i=$((_i+1)); out="${out%.bin}.$_i.bin"; [ "$_i" -gt 50 ] && break; done
  part="$out.part"
  # THE MODE BIT IS NOT THE READ: attempt it, then judge the BYTES. Direct read first (a synthetic
  # fixture and a future non-root-owned attr both work without privilege); sudo -n only if needed.
  if ! cat "$d/data" >"$part" 2>/dev/null || [ ! -s "$part" ]; then
    "$SUDO" -n cat "$d/data" >"$part" 2>/dev/null
  fi
  size=$("$STAT" -c %s "$part" 2>/dev/null || echo 0)
  if [ "${size:-0}" -le 0 ]; then
    rm -f "$part"
    seen_mark "$key" fail
    ledger FAILED "$key" "dev=$dev drv=$drv read returned 0 bytes (attempt $((fails+1))/$FAILCAP)"
    trace "FAILED read of $CLASS/$dev/data (0 bytes, attempt $((fails+1))/$FAILCAP)"
    return 2
  fi
  mv -f "$part" "$out"
  sha=$("$SHA" "$out" 2>/dev/null | cut -d' ' -f1)

  # journal context: the driver lines that bracket this dump. Bounded, and it is CONTEXT, not proof.
  ctx=$("$JOURNALCTL" -k --since '-3 min' --no-pager 2>/dev/null \
        | grep -iE 'rtw_?[0-9a-z]+|devcoredump|firmware coredump|fw crash|Bluetooth' | tail -12)

  { echo "captured:      $(now)"
    echo "key:           $key"
    echo "class-device:  $CLASS/$dev"
    echo "failing-device:${fdev:-unknown}"
    echo "driver:        $drv"
    echo "bytes:         $size"
    echo "sha256:        $sha"
    echo "retention:     300s on this kernel (dev_coredumpm 300000 jiffies @ CONFIG_HZ=1000) —"
    echo "               the kernel copy is gone; THIS file is the only remaining evidence."
    echo "--- kernel journal, -3min ---"
    printf '%s\n' "$ctx"
  } >"${out%.bin}.meta"

  seen_mark "$key" captured
  ledger captured "$key" "drv=$drv bytes=$size sha=$sha file=$out"
  trace "CAPTURED $key drv=$drv ${size}B -> $out"
  board "[fyi] devcd-catch: CAUGHT a devcoredump before the kernel's 300s deleted it — $dev, driver=$drv, ${size} bytes, sha ${sha:0:12}. Evidence: $out (+ .meta). ${drv} is the sole-uplink combo chip if it reads rtw_8822bu — a rising capture rate IS the dongle fault rate, not a self-heal."
  say "captured $key drv=$drv ${size}B -> $out"
  return 0
}

prune(){ ( _prune ); }
_prune(){
  local n bytes f
  cd "$DUMP_DIR" 2>/dev/null || return 0
  n=$(ls -1t *.bin 2>/dev/null | wc -l)
  if [ "${n:-0}" -gt "$KEEP" ]; then
    ls -1t *.bin 2>/dev/null | tail -n +$((KEEP+1)) | while read -r f; do
      rm -f "$f" "${f%.bin}.meta"; ledger pruned "$f" "over keep=$KEEP"
    done
  fi
  bytes=$(du -sb "$DUMP_DIR" 2>/dev/null | cut -f1)
  while [ "${bytes:-0}" -gt $((MAXMB*1024*1024)) ]; do
    f=$(ls -1t *.bin 2>/dev/null | tail -1); [ -n "$f" ] || break
    rm -f "$f" "${f%.bin}.meta"; ledger pruned "$f" "over maxmb=$MAXMB"
    bytes=$(du -sb "$DUMP_DIR" 2>/dev/null | cut -f1)
  done
}

# The PATTERN is a --test seam, the PROBE is not: arm J drives this exact pgrep, against a real
# spawned child, with only the matched token swapped. It has to be — this node's production listener
# is normally UP, so a test that used the live pattern could never reach the DOWN branch at all, and
# a seam that handed back a pid would prove nothing but the seam.
LISTEN_PAT="${MESH_DEVCD_LISTEN_PAT:-(mesh-devcd-catch|devcd-catch).*--listen}"
listener_pid(){ pgrep -u "$(id -u)" -f -- "$LISTEN_PAT" 2>/dev/null | head -1; }

# ── THE LISTENER HAS AN ACTUATOR, SO THE ALERT SITS BEHIND THE ACTUATOR ──────────────────────────
# Until 2026-08-27 this branch NAMED mesh-supervise in a board post and never called it: a detector
# whose only actuator is the operator's attention
# (a-detector-without-a-re-applier-leaves-the-operators-hands-as-the-loop). Three things changed and
# only the second is the point:
#   · the sweep SELF-REGISTERS in mesh-supervise's registry, because a supervisor with no row for
#     this child is an actuator that cannot fire;
#   · it RUNS the supervisor and then RE-READS listener_pid to find out whether that worked. The
#     re-read is POLLED, not instant — mesh-supervise starts children with `setsid … &`, so asking
#     once, immediately, reads DOWN through a perfectly successful restart;
#   · the board post fires on the ACTUATOR'S OUTCOME, never on the fault
#     (an-alert-wired-to-the-fault-not-to-its-actuators-outcome). A listener that died and came back
#     inside one tick wakes nobody.
# The held edge is NOT lost. Every repair writes its own ledger ($HEALLOG, deliberately separate
# from $LEDGER so a repair rate can never be double-counted against the capture rate), and the hold
# is BOUNDED BY ITS OWN ARITHMETIC: more than $RESTARTCAP repairs in 24 h and the RATE itself goes
# to the board. A healer that silences the fault it rides on erases the RTL8822BU signal this whole
# tool exists to publish (a-healers-re-apply-rate-is-a-floor-on-the-fault-rate).
heal_ledger(){ local IFS=$'\t'; printf '%s\t%s\n' "$(now)" "$*" >>"$HEALLOG"; }

# rc 0 = a devcd-catch row is in the registry after this call. Idempotent by design: the sweep runs
# every 60 s and must never append a second row.
sup_register(){
  local bin row hdr=0
  [ -n "${SUPREG:-}" ] || return 1
  if [ -f "$SUPREG" ] && grep -qE '^[[:space:]]*devcd-catch[[:space:]]*\|' "$SUPREG"; then return 0; fi
  # NEVER register the twin we happen to be RUNNING as. A hand-run from the genome would otherwise
  # register scripts/mesh-devcd-catch, and mesh-land rewrites that file under the running listener
  # (see the deploy note at the top). Only the deployed path is a supervisable identity, and if it
  # is not there we register nothing and say so — a row pointing at a non-existent binary is a
  # supervisor that restarts forever and never succeeds.
  bin="$HOME/.local/bin/mesh-devcd-catch"
  [ -x "$bin" ] || { heal_ledger REGISTER-SKIPPED "$SUPREG" "no executable at $bin"; return 1; }
  [ -f "$SUPREG" ] || hdr=1
  # an existing registry whose last line has no newline would otherwise swallow our row into it
  if [ -s "$SUPREG" ] && [ -n "$(tail -c1 "$SUPREG" 2>/dev/null)" ]; then printf '\n' >>"$SUPREG" || return 1; fi
  row="devcd-catch|mesh-devcd-catch --listen|$bin --listen"
  { [ "$hdr" = 1 ] && printf '%s\n' '# supervise.list — name | pgrep-pattern | start-cmd  (mesh-supervise)'
    printf '%s\n' "$row"; } >>"$SUPREG" 2>/dev/null || return 1
  ledger listener-registered "$SUPREG" "$row"
  heal_ledger REGISTERED "$SUPREG" "$row"
  trace "self-registered in $SUPREG: $row"
  return 0
}

await_listener(){   # poll for a setsid'd restart to show up; echoes the pid, rc 1 if none appeared
  local i lp
  for i in $(seq 1 "${AWAIT:-10}"); do
    lp=$(listener_pid); [ -n "$lp" ] && { printf '%s' "$lp"; return 0; }
    sleep 0.5
  done
  return 1
}

# The two board surfaces. Both are throttled, and NEITHER fires on the bare fault.
listener_alert(){   # $1 = what actually happened, in the actuator's own terms
  local note="$STATE_DIR/.devcd-catch-downnote" cutoff reps
  [ "$CHAT" = 1 ] || return 0
  command -v mesh-chat >/dev/null 2>&1 || return 0
  [ -f "$note" ] && [ $(( $(date +%s) - $("$STAT" -c %Y "$note" 2>/dev/null || echo 0) )) -le 3600 ] && return 0
  cutoff=$(date -u -d '-24 hours' +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)
  reps=$(awk -v c="$cutoff" -F'\t' '$1>=c && $2=="REPAIRED"' "$HEALLOG" 2>/dev/null | wc -l)
  : >"$note"
  mesh-chat "[fyi] devcd-catch: the --listen daemon is DOWN and the SUPERVISOR DID NOT BRING IT BACK — $1. The 60s sweep is now the only cover for a 300s artifact, so dumps are being missed. Registry $SUPREG, restart ledger $HEALLOG (${reps:-0} silent repair(s) in the last 24h). Needs a mind." >/dev/null 2>&1
}
rate_alert(){   # a healer that hides its own workload erases the fault signal it rides on
  local note="$STATE_DIR/.devcd-catch-ratenote" cutoff reps
  [ "$CHAT" = 1 ] || return 0
  command -v mesh-chat >/dev/null 2>&1 || return 0
  cutoff=$(date -u -d '-24 hours' +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)
  reps=$(awk -v c="$cutoff" -F'\t' '$1>=c && $2=="REPAIRED"' "$HEALLOG" 2>/dev/null | wc -l)
  [ "${reps:-0}" -gt "$RESTARTCAP" ] || return 0
  [ -f "$note" ] && [ $(( $(date +%s) - $("$STAT" -c %Y "$note" 2>/dev/null || echo 0) )) -le 21600 ] && return 0
  : >"$note"
  mesh-chat "[fyi] devcd-catch: the --listen daemon has been restarted ${reps}x in 24h (cap $RESTARTCAP) — each one silent by design, but this RATE is not. The listener is dying repeatedly; the ledger is $HEALLOG. A repaired listener is not a healthy one, and every death is a window where only the 60s sweep covered a 300s artifact." >/dev/null 2>&1
}

heal_listener(){   # rc 0 = listener up after this call, 1 = still down
  local rc lp
  ledger listener-down sweep "no --listen process; only the 60s backstop covers the 300s window"
  sup_register
  if ! command -v "${SUPCMD%% *}" >/dev/null 2>&1; then
    # ABSENT IS NOT REPAIRED. Rendering a missing actuator as anything but a failure is the
    # plausible-constant trap one ring out.
    heal_ledger UNREPAIRED actuator-absent "no '${SUPCMD%% *}' on PATH"
    ledger listener-down-unrepaired actuator-absent "${SUPCMD%% *}"
    listener_alert "the supervisor itself is ABSENT (no '${SUPCMD%% *}' on PATH), so nothing will ever restart it"
    say "listener: DOWN and UNREPAIRABLE — no ${SUPCMD%% *} on PATH"
    return 1
  fi
  # $SUPCMD is deliberately UNQUOTED: the --test seam passes a stub with arguments.
  "$TIMEOUT" 20 $SUPCMD >/dev/null 2>&1; rc=$?
  if lp=$(await_listener); then
    heal_ledger REPAIRED "$SUPCMD rc=$rc" "pid=$lp"
    ledger listener-repaired "$SUPCMD" "rc=$rc pid=$lp"
    trace "listener was DOWN; $SUPCMD restarted it -> pid $lp"
    say "listener: WAS DOWN, REPAIRED by $SUPCMD (pid $lp) — board silent by design, see $HEALLOG"
    rate_alert
    return 0
  fi
  heal_ledger UNREPAIRED "$SUPCMD rc=$rc" "still absent after $(( AWAIT / 2 ))s"
  ledger listener-down-unrepaired "$SUPCMD" "rc=$rc"
  listener_alert "ran $SUPCMD (rc=$rc) and listener_pid was still empty $(( AWAIT / 2 ))s later"
  say "listener: DOWN and UNREPAIRED ($SUPCMD rc=$rc) — sweep-only cover"
  return 1
}

# ── SWEEP: one pass. The backstop, and the cron entrypoint ───────────────────────────────────────
do_sweep(){
  local rc=0 d found=0 lp
  [ -d "$CLASS" ] || { say "n/a: $CLASS absent — kernel has no CONFIG_DEV_COREDUMP"; exit 2; }
  for d in "$CLASS"/devcd*; do
    [ -d "$d" ] || continue
    found=$((found+1))
    capture_one "$d"; case $? in 2) rc=1 ;; esac
  done
  prune
  # a backstop that silently carries the load is a backstop nobody fixes — so REPAIR, then report
  # the repair's outcome. See heal_listener().
  lp=$(listener_pid)
  if [ -z "$lp" ] && [ "${MESH_DEVCD_EXPECT_LISTENER:-1}" = 1 ]; then
    heal_listener || rc=1
  fi
  command -v mesh-state-touch >/dev/null 2>&1 && mesh-state-touch "$LEDGER" >/dev/null 2>&1
  [ "$found" -eq 0 ] && say "sweep: no live dump in $CLASS"
  return $rc
}

# ── LISTEN: the primary. Unprivileged uevent receive, capture on `add` ──────────────────────────
do_listen(){
  [ -d "$CLASS" ] || { say "n/a: $CLASS absent — kernel has no CONFIG_DEV_COREDUMP"; exit 2; }
  ledger listener-up "pid=$$" "class=$CLASS"
  trace "listener up (pid $$)"
  # Catch anything already sitting in the window at start-up (a restart mid-window must not lose a
  # dump), THEN block. The verdict is printed, not swallowed: --test's arm I needs it to prove the
  # start-up sweep found nothing, otherwise a capture would not implicate the event loop at all.
  say "startup-sweep: $(with_lock do_sweep 2>&1 | tr '\n' '; ')"
  local line act path d i mon_pid
  # THE LOOP RUNS IN THE MAIN SHELL, VIA PROCESS SUBSTITUTION — NOT `monitor | while read`.
  # Measured 2026-08-21 while building this: with a pipeline, `while read` runs in a SUBSHELL, so the
  # listener is TWO bash pids. Kill the parent and the subshell is reparented to init and keeps
  # running; pgrep still finds a `mesh-devcd-catch --listen`, so mesh-supervise reads UP and never
  # restarts — a leaked half greening the liveness check over a listener whose parent is dead
  # (a-lock-based-singleton-is-blind-to-a-leaked-twin). One pid, and the monitor child is reaped.
  #
  # The receive itself is asserted REAL by --test arm D (a live udevadm takes real kernel uevents off
  # the netlink socket). The MESH_DEVCD_MONITOR_CMD seam exists so arm I can drive THIS loop with
  # real-format lines: no safe trigger can produce a devcoredump `add` on this node, and an
  # unexercised loop body is the half of a listener that quietly does nothing.
  if [ -n "${MESH_DEVCD_MONITOR_CMD:-}" ]; then
    exec 8< <( $MESH_DEVCD_MONITOR_CMD 2>&1 )
  else
    exec 8< <( "$STDBUF" -oL "$UDEVADM" monitor --kernel --subsystem-match=devcoredump 2>&1 )
  fi
  mon_pid=$!
  # EXIT alone leaks under SIGTERM (exit-only-traps-leak-under-sigterm): name every signal that
  # actually reaches this process, or a supervisor's TERM orphans the udevadm child.
  # DEATH NOTE folded into the EXISTING handler (a second trap for these signals would REPLACE this
  # one and leak the monitor). Its own ledger already said "signalled" — but that word is private to
  # this tool and names no SIGNAL, so the supervisor could not read it; the note is the shared plane.
  # $_sig expanded HERE, at trap-INSTALL time — never deferred as \$_sig (see mesh-snapshot's note).
  # Both readers of it: the shared note AND this tool's own private ledger word.
  for _sig in INT TERM HUP; do
    trap "mesh-death-note devcd-catch $_sig \$\$ 2>/dev/null; kill \"\$mon_pid\" 2>/dev/null; ledger listener-down \"pid=\$\$\" \"signalled-$_sig\"; exit 0" "$_sig"
  done
  trap 'kill "$mon_pid" 2>/dev/null' EXIT
  while read -r line <&8; do
    case "$line" in
      KERNEL\[*)
        act=$(printf '%s\n' "$line" | awk '{print $2}')
        path=$(printf '%s\n' "$line" | awk '{print $3}')
        [ "$act" = add ] || continue
        case "$path" in */devcd*) ;; *) continue ;; esac
        d="$CLASS/$(basename "$path")"
        # the attrs are created before the uevent is emitted, but never assume a race away
        for i in 1 2 3 4 5; do
          [ -d "$d" ] && break
          sleep 0.2
        done
        with_lock capture_one "$d"
        with_lock prune
        ;;
    esac
  done
  ledger listener-down "pid=$$" "udevadm monitor stream ended"
  return 1
}

do_status(){
  local dis lp last
  if [ -d "$CLASS" ]; then
    dis=$(cat "$CLASS/disabled" 2>/dev/null)
    case "$dis" in
      0) say "channel:  ARMED (disabled=0) — dumps are taken, and deleted 300s later" ;;
      1) say "channel:  MUTED (disabled=1) — every driver dump is discarded at birth, nothing to catch" ;;
      *) say "channel:  UNREADABLE (disabled='${dis:-<empty>}')" ;;
    esac
    say "live now: $(ls -1d "$CLASS"/devcd* 2>/dev/null | wc -l) dump(s) in $CLASS"
  else
    say "channel:  ABSENT ($CLASS) — no CONFIG_DEV_COREDUMP"
  fi
  lp=$(listener_pid)
  if [ -n "$lp" ]; then say "listener: UP (pid $lp)"
  else say "listener: DOWN — only the 60s sweep covers the 300s window"; fi
  # the repair rate is a first-class reading, not a footnote: every restart is silent on the board
  # by design, so this line and $HEALLOG are the only places the listener's death rate is visible.
  local cut reps lastr
  cut=$(date -u -d '-24 hours' +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)
  reps=$(awk -v c="$cut" -F'\t' '$1>=c && $2=="REPAIRED"' "$HEALLOG" 2>/dev/null | wc -l)
  lastr=$(awk -F'\t' '$2=="REPAIRED"||$2=="UNREPAIRED"' "$HEALLOG" 2>/dev/null | tail -1)
  say "restarts: ${reps:-0} in 24h (cap $RESTARTCAP, then the RATE goes to the board) — ${lastr:-<never repaired>}"
  say "registry: $(grep -qE '^[[:space:]]*devcd-catch[[:space:]]*\|' "$SUPREG" 2>/dev/null && echo "devcd-catch row present in $SUPREG" || echo "NO devcd-catch row in $SUPREG — the sweep will add one")"
  say "captured: $(ls -1 "$DUMP_DIR"/*.bin 2>/dev/null | wc -l) dump(s) in $DUMP_DIR"
  last=$(awk -F'\t' '$2=="captured"' "$LEDGER" 2>/dev/null | tail -1)
  say "last:     ${last:-<none ever captured>}"
}

do_list(){
  local f
  shopt -s nullglob
  for f in "$DUMP_DIR"/*.bin; do
    printf '%s  %10s B  %s\n' "$(basename "$f")" "$("$STAT" -c %s "$f")" \
      "$(grep -a '^failing-device:' "${f%.bin}.meta" 2>/dev/null | sed 's/^failing-device: *//')"
  done
  [ -z "$(ls -A "$DUMP_DIR" 2>/dev/null)" ] && say "no dumps captured yet ($DUMP_DIR empty)"
  return 0
}

# ── TEST ────────────────────────────────────────────────────────────────────────────────────────
# HONESTY OF THIS TEST, stated up front because it is the whole point:
# there is NO safe real trigger on this node. Both registered producers — rtw88_core and bluetooth —
# are the SAME combo chip that carries the sole uplink, so firing a dump severs the channel the
# result would be reported over. Therefore the EXTRACTION path is driven against a SYNTHETIC class
# directory and the summary SAYS SO; everything else — the class, the arm bit, the privilege path,
# and the uevent receive — is asserted for REAL against live kernel state. Any leg that cannot run
# renders UNASSERTED and the summary refuses to pass on it.
do_test(){
  # $1=1 -> FAST CORE only (what mesh-doctor drives; see the `# test-fast: yes` block at the top).
  local _T_FAST="${1:-0}"
  local fail=0 unasserted="" rc out want got n n2
  local td="" td2=""
  [ -d "$CLASS" ] || { say "n/a: $CLASS absent — kernel has no CONFIG_DEV_COREDUMP"; exit 2; }
  say "A  REAL class present: $CLASS"

  # B — armed? (real read of live kernel state)
  local dis; dis=$(cat "$CLASS/disabled" 2>/dev/null)
  case "$dis" in
    0) say "B  REAL armed: disabled=0" ;;
    1) say "B  REAL MUTED: disabled=1 — nothing will ever be catchable until this is 0"; fail=1 ;;
    *) say "B  FAIL: $CLASS/disabled unreadable (got '${dis:-<empty>}')"; fail=1 ;;
  esac

  # C — THE PRIVILEGE PATH, FOR REAL. Extraction is a `sudo -n cat` of a 0600 root sysfs file.
  # Assert it against a live root-owned file under this very class, not by assuming NOPASSWD.
  if "$SUDO" -n cat "$CLASS/disabled" >/dev/null 2>&1; then
    say "C  REAL privilege path live: sudo -n read of a root sysfs file under $CLASS succeeded"
  else
    say "C  n/a UNASSERTED: sudo -n unavailable — a real devcdN/data (0600 root) could NOT be read"
    unasserted="$unasserted C"
  fi

  # D — THE RECEIVE LEG, FOR REAL. A parser that never receives is not a listener.
  # SKIPPED BY THE FAST CORE: two live 6s `udevadm monitor` windows are 6.0s of the suite's 37.8s
  # and cannot be shortened without turning a real receive into a timing race under the doctor's
  # own parallel storm — a flaky red is worse than a leg the summary names as unrun.
  local mon flt seen trig
  if [ "$_T_FAST" = 1 ]; then :; else
  mon=$(mktemp); flt=$(mktemp)
  "$TIMEOUT" 6 "$UDEVADM" monitor --kernel --subsystem-match=devcoredump >"$flt" 2>&1 &
  "$TIMEOUT" 6 "$UDEVADM" monitor --kernel >"$mon" 2>&1 &
  sleep 1
  if probe_uevent; then trig=1; else trig=0; fi
  probe_path_say
  wait 2>/dev/null
  seen=$(grep -c 'KERNEL\[' "$mon" 2>/dev/null)
  if [ "$trig" -eq 0 ]; then
    say "D  n/a UNASSERTED: could not raise a control uevent (no sudo -n) — receive leg NOT asserted"
    unasserted="$unasserted D"
  elif [ "${seen:-0}" -ge 1 ]; then
    say "D  REAL receive live: uid $(id -u) udevadm monitor took $seen kernel uevents off the netlink socket"
    grep -q 'devcoredump' "$flt" || grep -q 'monitor will print' "$flt" \
      || { say "D  FAIL: --subsystem-match=devcoredump was rejected by udevadm $("$UDEVADM" --version)"; fail=1; }
  else
    say "D  FAIL: 0 uevents after a real trigger — the receive leg is DEAD"; fail=1
  fi
  rm -f "$mon" "$flt"
  fi

  # E/F/G — EXTRACTION, on a SYNTHETIC class dir (declared; no safe real trigger exists here)
  td=$(mktemp -d); mkdir -p "$td/class/devcd7" "$td/out" "$td/faildev/driver"
  head -c 4096 /dev/urandom >"$td/class/devcd7/data"
  ln -s "$td/faildev" "$td/class/devcd7/failing_device"
  want=$("$SHA" "$td/class/devcd7/data" | cut -d' ' -f1)
  run_fixture(){ DEVCD_CLASS="$td/class" MESH_DEVCD_DIR="$td/out" MESH_DEVCD_LEDGER="$td/ledger" \
                 MESH_DEVCD_SEEN="$td/seen" MESH_DEVCD_LOCK="$td/lock" MESH_DEVCD_CHAT=0 \
                 MESH_DEVCD_EXPECT_LISTENER=0 MESH_STATE_DIR="$td" bash "$0" --sweep 2>&1; }

  out=$(run_fixture); rc=$?
  got=$("$SHA" "$td"/out/*.bin 2>/dev/null | cut -d' ' -f1)
  if [ "$rc" -eq 0 ] && [ -n "$got" ] && [ "$got" = "$want" ]; then
    say "E  SYNTHETIC extraction: 4096 known bytes captured, sha256 matches the source exactly"
  else
    say "E  FAIL: synthetic extraction did not reproduce the source bytes (rc=$rc want=${want:0:12} got=${got:0:12})"; fail=1
  fi
  grep -q '^bytes:         4096$' "$td"/out/*.meta 2>/dev/null \
    || { say "E  FAIL: .meta sidecar missing or wrong size field"; fail=1; }

  # F — the DEDUP arm: a second sweep over the same dump must capture NOTHING (else the cron
  #     backstop re-files one dump every 60s and the capture rate stops meaning the fault rate)
  run_fixture >/dev/null 2>&1
  # Count the ledger's CAPTURED ROWS, not files: a file count is insensitive because two captures in
  # the same second used to collide on one name (that overwrite bug was found by mutating the dedup
  # early-return away and watching this arm stay green — a-count-guard-cannot-see-a-content-replacement).
  n=$(awk -F'\t' '$2=="captured"' "$td/ledger" 2>/dev/null | wc -l)
  n2=$(ls -1 "$td"/out/*.bin 2>/dev/null | wc -l)
  if [ "$n" -eq 1 ] && [ "$n2" -eq 1 ]; then
    say "F  SYNTHETIC dedup: a re-sweep of the same dump produced 0 further captures (1 ledger row, 1 file)"
  else
    say "F  FAIL: dedup broken — $n captured ledger row(s), $n2 file(s) after two sweeps of ONE dump"; fail=1
  fi

  # G — THE RED ARM, SEEN RED: an UNREADABLE dump must FAIL, must NOT file a 0-byte artifact, and
  #     must NOT mark itself seen (so the remaining window is still retried). A gate never seen
  #     fail is not a gate.
  rm -rf "$td/class2" "$td/out2" "$td/seen2"; mkdir -p "$td/class2/devcd8" "$td/out2"
  : >"$td/class2/devcd8/data"        # zero bytes = the read produced nothing
  out=$(DEVCD_CLASS="$td/class2" MESH_DEVCD_DIR="$td/out2" MESH_DEVCD_LEDGER="$td/ledger2" \
        MESH_DEVCD_SEEN="$td/seen2" MESH_DEVCD_LOCK="$td/lock2" MESH_DEVCD_CHAT=0 \
        MESH_DEVCD_EXPECT_LISTENER=0 MESH_STATE_DIR="$td" bash "$0" --sweep 2>&1); rc=$?
  n2=$(ls -1 "$td"/out2/*.bin 2>/dev/null | wc -l)
  if [ "$rc" -ne 0 ] && [ "${n2:-0}" -eq 0 ] && grep -q 'FAILED' "$td/ledger2" 2>/dev/null \
     && ! grep -q 'captured' "$td/seen2" 2>/dev/null; then
    say "G  RED ARM seen red: a 0-byte dump exits non-zero, files NO artifact, and is not marked seen"
  else
    say "G  FAIL: the empty-read guard did not go red (rc=$rc files=$n2)"; fail=1
  fi

  # H — the FAILCAP retirement, seen fire
  local i; for i in 1 2 3 4 5 6; do
    DEVCD_CLASS="$td/class2" MESH_DEVCD_DIR="$td/out2" MESH_DEVCD_LEDGER="$td/ledger2" \
      MESH_DEVCD_SEEN="$td/seen2" MESH_DEVCD_LOCK="$td/lock2" MESH_DEVCD_CHAT=0 \
      MESH_DEVCD_EXPECT_LISTENER=0 MESH_STATE_DIR="$td" bash "$0" --sweep >/dev/null 2>&1
  done
  if grep -q 'retired' "$td/ledger2" 2>/dev/null; then
    say "H  SYNTHETIC failcap: a permanently unreadable dump retires after $FAILCAP attempts (no hot loop)"
  else
    say "H  FAIL: failcap never retired an unreadable key — the listener could hot-loop"; fail=1
  fi
  # I — SKIPPED BY THE FAST CORE: 14.8s of the suite's 37.8s (a 4s live layout capture plus two
  #     full --listen drives, each of which must sleep past the start-up sweep to stay non-vacuous).
  if [ "$_T_FAST" = 1 ]; then :; else
  # I — THE LISTENER'S OWN LOOP, driven end-to-end. Arms E-H exercise the SWEEP; this exercises the
  #     EVENT path, which is the PRIMARY and is the entire reason this tool is not a cron.
  #     TWO traps are designed out of this arm:
  #      · VACUITY. --listen sweeps once at start-up by design, so a fixture dump that already
  #        exists would be captured whether or not the event loop works at all. So the fixture
  #        script creates the dump only AFTER the start-up sweep has run — exactly the kernel's own
  #        order (device_add, then the uevent) — and the arm asserts the start-up sweep found NOTHING.
  #      · A HAND-WRITTEN LAYOUT. The column layout is the thing a parser gets wrong, so the add row
  #        is spliced into REAL udevadm-255 output captured from this node, never typed out here.
  td2=$(mktemp -d); mkdir -p "$td2/class" "$td2/out" "$td2/src"
  head -c 2048 /dev/urandom >"$td2/src/data"
  want=$("$SHA" "$td2/src/data" | cut -d' ' -f1)
  { "$TIMEOUT" 4 "$UDEVADM" monitor --kernel 2>&1 &
    sleep 1; probe_uevent
    wait 2>/dev/null; } >"$td2/stream" 2>&1
  if ! grep -q 'KERNEL\[' "$td2/stream"; then
    say "I  n/a UNASSERTED: could not capture a real udevadm line layout — listener loop NOT driven"
    unasserted="$unasserted I"
  else
    sed -n 's#^\(KERNEL\[[0-9.]*\] \)change\( *\)/devices/.*#\1add\2/devices/virtual/devcoredump/devcd3 (devcoredump)#p' \
        "$td2/stream" | head -1 >"$td2/addrow"
    if ! grep -q 'devcd3 (devcoredump)' "$td2/addrow"; then
      say "I  FAIL: could not splice a real-format add row out of live udevadm output"; fail=1
    else
      _mk_fixture(){ # $1=action-row file, $2=fixture script path
        { echo '#!/usr/bin/env bash'
          echo "sleep 2"                                   # let the start-up sweep run on an EMPTY class
          echo "mkdir -p '$td2/class/devcd3'"
          echo "cp '$td2/src/data' '$td2/class/devcd3/data'"
          echo "cat '$1'"
          echo "sleep 3"
        } >"$2"; chmod +x "$2"; }
      _drive(){ # $1=fixture script  $2=outdir  $3=tag
        rm -rf "$2"; mkdir -p "$2"
        MESH_DEVCD_MONITOR_CMD="$1" DEVCD_CLASS="$td2/class" MESH_DEVCD_DIR="$2" \
          MESH_DEVCD_LEDGER="$td2/ledger-$3" MESH_DEVCD_SEEN="$td2/seen-$3" \
          MESH_DEVCD_LOCK="$td2/lock-$3" MESH_DEVCD_CHAT=0 MESH_DEVCD_EXPECT_LISTENER=0 \
          MESH_STATE_DIR="$td2" "$TIMEOUT" 25 bash "$0" --listen >"$td2/listen-$3.out" 2>&1
        rm -rf "$td2/class/devcd3"; }
      _mk_fixture "$td2/addrow" "$td2/fix-add"
      _drive "$td2/fix-add" "$td2/out" add
      got=$("$SHA" "$td2"/out/*.bin 2>/dev/null | cut -d' ' -f1)
      n=$(ls -1 "$td2"/out/*.bin 2>/dev/null | wc -l)
      # VACUITY GUARD: the start-up sweep must have found nothing, or this arm proves nothing
      if ! grep -q 'no live dump' "$td2/listen-add.out" 2>/dev/null; then
        say "I  FAIL: VACUOUS — the start-up sweep saw a dump, so a capture does not implicate the loop"; fail=1
      elif [ "$n" -eq 1 ] && [ "$got" = "$want" ]; then
        say "I  LISTENER LOOP driven: start-up sweep found nothing, then a real-format devcoredump"
        say "   add row produced exactly 1 capture with byte-exact contents — the EVENT path works"
      else
        say "I  FAIL: the listener loop did not capture on an add row (files=$n want=${want:0:12} got=${got:0:12})"; fail=1
      fi
      # RED ARM: same fixture, same timing, action flipped to `remove` -> the loop must capture NOTHING
      sed 's#\] add \( *\)#] remove \1#' "$td2/addrow" >"$td2/rmrow"
      _mk_fixture "$td2/rmrow" "$td2/fix-rm"
      _drive "$td2/fix-rm" "$td2/out2" rm
      n2=$(ls -1 "$td2"/out2/*.bin 2>/dev/null | wc -l)
      if [ "${n2:-0}" -eq 0 ]; then
        say "I  RED ARM seen red: the identical stream with action=remove captured 0 — the action"
        say "   gate is real, not an artefact of the dump merely existing"
      else
        say "I  FAIL: a non-add action still captured $n2 file(s) — the action gate does nothing"; fail=1
      fi
    fi
  fi
  rm -rf "$td2"
  fi
  rm -rf "$td"

  # J — THE LISTENER'S ACTUATOR AND WHERE ITS ALERT SITS.
  # The whole point of this arm is that the OUTCOME decides the board post, so it must drive the
  # REAL listener_pid probe — a seam that lets the test hand back a pid would only prove the seam.
  # So the stub supervisor spawns a genuine process whose cmdline the real pgrep pattern matches,
  # and the arm reads what the tool then does. (That stub lives ~8s and is killed here; while it
  # breathes, a concurrent production sweep would read the listener UP off it. Bounded and cheap,
  # and the alternative is a vacuous arm.)
  # Run under env -i with HOME pointed at a fake tree whose .local/bin IS the stub dir — the tool
  # re-exports PATH="$HOME/.local/bin:$PATH" at line 1, so a stub merely PREPENDED to PATH would
  # lose the race to the deployed twin (a-poisoned-binary-can-lose-a-path-race-to-the-real-one).
  local td3 fh stub_rc
  td3=$(mktemp -d); fh="$td3/home"; mkdir -p "$fh/.local/bin" "$fh/.mesh" "$td3/class"
  { echo '#!/usr/bin/env bash'; echo 'printf "%s\n" "$*" >>"'"$td3"'/chat.txt"'; } >"$fh/.local/bin/mesh-chat"
  { echo '#!/usr/bin/env bash'; echo 'exit 0'; } >"$fh/.local/bin/mesh-trace"
  cp "$fh/.local/bin/mesh-trace" "$fh/.local/bin/mesh-state-touch"
  # the child the stub supervisor "restarts": a real cmdline that the real pattern matches
  local jtok; jtok="devcdJ$$-$(basename "$td3")"
  { echo '#!/usr/bin/env bash'; echo 'sleep 8'; } >"$td3/$jtok"; chmod +x "$td3/$jtok"
  { echo '#!/usr/bin/env bash'; echo "setsid bash '$td3/$jtok' --listen >/dev/null 2>&1 &"; echo 'exit 0'; } >"$fh/.local/bin/sup-works"
  { echo '#!/usr/bin/env bash'; echo 'exit 0'; } >"$fh/.local/bin/sup-noop"
  # REAP THE GROUP, NOT THE NAME. The stub supervisor setsid's a `bash <jtok> --listen` whose only
  # statement is `sleep 8`; a pkill on the cmdline pattern kills the WRAPPER and orphans the sleep,
  # which keeps running for the rest of its 8s — and it inherited the sweep's lock fd 9, so the very
  # next _sweep_j blocks in `flock -w 30` until it dies. Measured: J3 cost 8.0s in exactly the runs
  # where nothing slow ran between it and J1 (the fast core), and 0.05s where J2's 12s sat in
  # between — i.e. the arm's cost was being paid by whatever happened to precede it. setsid makes
  # the child its own group leader, so the group IS the stub and nothing else; the guard refuses a
  # pgid equal to our own, which is the one way this could reach the pane that is running it
  # (a-name-matching-stop-kills-your-other-selves).
  _reap_jtok(){
    local _p _pg _own; _own=$(ps -o pgid= -p $$ 2>/dev/null | tr -d ' ')
    for _p in $(pgrep -u "$(id -u)" -f -- "$jtok.*--listen" 2>/dev/null); do
      _pg=$(ps -o pgid= -p "$_p" 2>/dev/null | tr -d ' ')
      [ -n "$_pg" ] && [ "$_pg" != "$_own" ] && kill -TERM -- "-$_pg" 2>/dev/null
      kill -TERM "$_p" 2>/dev/null
    done
    return 0
  }
  # the DEPLOYED path sup_register insists on — absent, it registers nothing and says why, which is
  # correct behaviour but would make J4 assert the refusal instead of the registration
  cp "$fh/.local/bin/sup-noop" "$fh/.local/bin/mesh-devcd-catch"
  chmod +x "$fh/.local/bin/"*
  # USER IS NOT GUARANTEED TO EXIST, AND THIS FILE RUNS UNDER `set -u`. A bare "$USER" here is
  # itself the unbound reference, so with USER unset the expansion dies BEFORE `env -i` starts and
  # J1/J2/J3 fail without ever reaching the actuator they exist to verify — the legs read RED while
  # the actuator is fine. That is the worst direction for this particular arm: it is the only thing
  # standing behind the alert, so a environment-shaped failure looks exactly like a broken healer.
  # cron and systemd both hand a child a much thinner environment than a login shell, and USER is
  # one of the variables that does not survive; `id -un` asks the kernel instead of the environment.
  # THE J LEGS RUN WITH USER UNSET, ON PURPOSE — that is the regression gate, not a detail.
  # This defect passed rc=0 in every login shell and sat unseen from 5fd53d94 (2026-08-27T18:30:22Z)
  # until a cron doctor caught it, because the ONE environment the arm was never driven in is the
  # one the tool actually runs in. Asserting the legs in a friendlier environment than production
  # is how a green suite certifies a broken actuator. Restored below whatever the legs do.
  local _user_had=0 _user_was=""
  [ -n "${USER+x}" ] && { _user_had=1; _user_was="$USER"; }
  unset USER
  if [ -z "$(id -un 2>/dev/null)" ]; then
    say "J0 FAIL: id -un answers nothing, so the USER fallback has no source to draw on"; fail=1
  else
    say "J0 the J legs below run with USER UNSET (the cron/systemd shape), and the child env"
    say "   sources it from the kernel via id -un rather than from the environment"
  fi
  _sweep_j(){ # $1=supervisor name  → runs one sweep against an empty synthetic class
    env -i HOME="$fh" PATH="/usr/bin:/bin" USER="${USER:-$(id -un)}" \
      DEVCD_CLASS="$td3/class" MESH_DEVCD_SUPERVISE_CMD="$1" MESH_DEVCD_AWAIT=8 \
      MESH_DEVCD_LISTEN_PAT="$jtok.*--listen" \
      MESH_DEVCD_EXPECT_LISTENER=1 MESH_DEVCD_CHAT=1 \
      "$TIMEOUT" 60 bash "$0" --sweep 2>&1; }
  # the pattern must be DARK before the actuator runs, or every J leg is vacuous
  if [ -n "$(pgrep -u "$(id -u)" -f -- "$jtok.*--listen" 2>/dev/null)" ]; then
    say "J  FAIL: VACUOUS — the arm's own pattern already matches a live process"; fail=1; fi

  # J1 — the repair works → the board must stay SILENT and the repair must be on the record
  : >"$td3/chat.txt"
  out=$(_sweep_j sup-works); stub_rc=$?
  n=$(grep -c . "$td3/chat.txt" 2>/dev/null); n=${n:-0}
  if grep -q 'REPAIRED' "$fh/.mesh/devcd-catch-listener-restarts.log" 2>/dev/null \
     && grep -q 'listener-repaired' "$fh/.mesh/devcd-catch.log" 2>/dev/null \
     && [ "${n:-0}" -eq 0 ] && [ "$stub_rc" -eq 0 ]; then
    say "J1 ACTUATOR RAN and the alert sat behind its OUTCOME: listener absent -> supervisor called"
    say "   -> listener_pid re-read found the restarted child -> 0 board posts, REPAIRED on the"
    say "   restart ledger. A listener repaired inside one tick wakes nobody."
  else
    say "J1 FAIL: repair path (rc=$stub_rc, board lines=$n, ledger='$(tail -1 "$fh/.mesh/devcd-catch-listener-restarts.log" 2>/dev/null)')"; fail=1
  fi
  _reap_jtok

  # J2 — SKIPPED BY THE FAST CORE: 12.2s, because this arm's whole point is to wait out
  #      MESH_DEVCD_AWAIT for a restart that never arrives. The fast core keeps J3, which is the
  #      other red arm on the same actuator (absent supervisor -> UNREPAIRABLE + a post) and costs
  #      0.05s, so the fast core is never a suite with no red arm in it.
  if [ "$_T_FAST" = 1 ]; then :; else
  # J2 — RED ARM: the identical path with a supervisor that does nothing must POST, and must say so
  # in the actuator's own terms. This is the arm that would go green on the old code by accident,
  # so it also asserts the post NAMES the failed attempt rather than merely naming the remedy.
  : >"$td3/chat.txt"; rm -f "$fh/.mesh/.devcd-catch-downnote"
  out=$(_sweep_j sup-noop); stub_rc=$?
  n=$(grep -c . "$td3/chat.txt" 2>/dev/null); n=${n:-0}
  if [ "${n:-0}" -eq 1 ] && grep -q 'SUPERVISOR DID NOT BRING IT BACK' "$td3/chat.txt" \
     && grep -q 'UNREPAIRED' "$fh/.mesh/devcd-catch-listener-restarts.log" 2>/dev/null \
     && [ "$stub_rc" -ne 0 ]; then
    say "J2 RED ARM seen red: a supervisor that does nothing leaves listener_pid empty -> exactly 1"
    say "   board post, worded as the ACTUATOR's failure, UNREPAIRED on the ledger, sweep rc!=0"
  else
    say "J2 FAIL: unrepaired path (rc=$stub_rc, board lines=$n, post='$(head -c 80 "$td3/chat.txt" 2>/dev/null)')"; fail=1
  fi
  fi

  # J3 — an absent supervisor is UNREPAIRABLE, never repaired (the plausible-constant trap)
  : >"$td3/chat.txt"; rm -f "$fh/.mesh/.devcd-catch-downnote"
  out=$(_sweep_j sup-does-not-exist); stub_rc=$?
  # rc is asserted too: a mutant that logs and posts correctly but RETURNS 0 renders the fault as a
  # clean sweep to cron and to any caller, which is the whole failure this arm exists to catch
  if [ "$stub_rc" -ne 0 ] \
     && grep -q 'actuator-absent' "$fh/.mesh/devcd-catch-listener-restarts.log" 2>/dev/null \
     && grep -q 'supervisor itself is ABSENT' "$td3/chat.txt"; then
    say "J3 an ABSENT supervisor renders UNREPAIRABLE and posts — never silence, which is what a"
    say "   missing actuator would otherwise look like"
  else
    say "J3 FAIL: absent-actuator path did not render unrepairable (rc=$stub_rc)"; fail=1
  fi

  # J4 — SKIPPED BY THE FAST CORE: 4.3s, all of it a third `_sweep_j` whose only purpose is to
  #      prove the registration is idempotent.
  if [ "$_T_FAST" = 1 ]; then :; else
  # J4 — SELF-REGISTRATION is real and IDEMPOTENT (the sweep runs every 60s)
  n=$(grep -cE '^[[:space:]]*devcd-catch[[:space:]]*\|' "$fh/.mesh/supervise.list" 2>/dev/null); n=${n:-0}
  _sweep_j sup-noop >/dev/null 2>&1
  n2=$(grep -cE '^[[:space:]]*devcd-catch[[:space:]]*\|' "$fh/.mesh/supervise.list" 2>/dev/null); n2=${n2:-0}
  if [ "${n:-0}" -eq 1 ] && [ "${n2:-0}" -eq 1 ] \
     && grep -qE '^[[:space:]]*devcd-catch\|mesh-devcd-catch --listen\|.*/\.local/bin/mesh-devcd-catch --listen$' "$fh/.mesh/supervise.list"; then
    say "J4 SELF-REGISTERED one devcd-catch row in a registry that had none, pointing at the"
    say "   DEPLOYED path (never the twin we are running as), and a second sweep added no second row"
  else
    say "J4 FAIL: registry rows after 1 sweep=$n, after 2=$n2 ('$(grep devcd-catch "$fh/.mesh/supervise.list" 2>/dev/null | head -1)')"; fail=1
  fi
  fi
  _reap_jtok
  rm -rf "$td3"
  if [ "$_user_had" -eq 1 ]; then export USER="$_user_was"; else unset USER; fi

  # ---- FAST CORE ENDS HERE ----------------------------------------------------------------------
  # Everything above except the guarded D/I/J2/J4 blocks is cheap (~1.3s measured); --test-fast stops
  # here so mesh-doctor gets a gate inside its 12s probe cap, and --test falls through to the K legs,
  # which are the gates ON the split itself. A fast-core RESULT never wears the full suite's sentence:
  # the legs it did not run are NAMED, so a green fast core cannot be read as the whole claim.
  if [ "$_T_FAST" = 1 ]; then
    [ "$fail" -eq 1 ] && { say "RESULT: mesh-devcd-catch --test-fast FAILED"; return 1; }
    say "RESULT: FAST CORE PASS — A/B/C (class, arm bit, sudo -n read path) REAL against this kernel;"
    say "        E/F/G/H (extraction, dedup, empty-read red arm, failcap) SYNTHETIC; J0/J1/J3 (the"
    say "        actuator and an absent actuator, driven with USER UNSET — the cron/systemd shape)."
    say "        NOT ASSERTED HERE: D (live uevent receive), I (the listener's own event loop and its"
    say "        action gate), J2 (the unrepaired red arm), J4 (idempotent self-registration). Those"
    say "        run under plain --test, which mesh-land drives at landing."
    [ -n "$unasserted" ] && say "        UNASSERTED (node condition):$unasserted"
    return 0
  fi

  # ---- K — THE GATES ON THE SPLIT ITSELF --------------------------------------------------------
  # A fast core is a claim about a RUNNER, so it needs gates no other arm makes: that the doctor will
  # actually route to it, that it fits the runner's cap, and that routing to it did not quietly drop
  # the coverage the tool was last stamped red for.
  local _kbest="" _kload _kout _kt0 _kel _ktry _kmut _krc

  # K1 — the header the doctor greps must BE there. Without it _test_arg falls back to --test and the
  #      split buys nothing: the probe times out exactly as before, silently. Anchored at '^#', so
  #      this grep's own indented line cannot satisfy it — a self-matching gate asserts its own text.
  if grep -Eq '^#[[:space:]]*test-fast:[[:space:]]*yes([^a-z0-9]|$)' "$0"; then
    say "K1 the doctor's routing header is present, so _test_arg drives --test-fast"
  else
    say "K1 FAIL: the '# test-fast: yes' declaration is gone — mesh-doctor will drive the full ${SECONDS}s+ suite under a 12s cap again"; fail=1
  fi

  # K2 — THE BUDGET. Best-of-3 wall, because load can only make this SLOWER: the minimum across
  #      retries is the tightest available upper bound on the quiet cost, and the retries only run
  #      when the first sample is already over budget, so a healthy suite pays one run. Over budget
  #      on a QUIET node is a real regression and fails; over budget on a BUSY one is a NODE
  #      condition and renders UNASSERTED with its numbers — never a silent pass.
  _kload="$(cut -d' ' -f1 /proc/loadavg 2>/dev/null || echo 0)"
  for _ktry in 1 2 3; do
    _kt0="$SECONDS"
    _kout="$(MESH_TEST_SANDBOX=1 "$TIMEOUT" 60 bash "$0" --test-fast 2>&1)"; _krc=$?
    _kel=$(( SECONDS - _kt0 ))
    [ "$_krc" -eq 0 ] || { say "K2 FAIL: --test-fast exited $_krc — the gate the doctor actually drives is red or absent: $(printf '%s' "$_kout" | tail -3 | tr '\n' ' ')"; fail=1; break; }
    { [ -z "$_kbest" ] || [ "$_kel" -lt "$_kbest" ]; } && _kbest="$_kel"
    [ "$_kbest" -le 9 ] && break
    _kload="$(cut -d' ' -f1 /proc/loadavg 2>/dev/null || echo 0)"
  done
  if [ "$_krc" -eq 0 ]; then
    if [ "${_kbest:-99}" -le 9 ]; then
      say "K2 fast core fits the runner: ${_kbest}s best-of-3 against mesh-doctor's 12s parallel-probe cap"
    else
      # Integer compare without bc: load1*10 vs cores*5 (i.e. load1 vs nproc/2).
      local _kl10 _kquiet
      _kl10="${_kload%%.*}$(printf '%s' "${_kload#*.}0" | cut -c1)"
      _kquiet=$(( $(nproc 2>/dev/null || echo 1) * 5 ))
      if [ "${_kl10:-0}" -le "$_kquiet" ] 2>/dev/null; then
        say "K2 FAIL: --test-fast took ${_kbest}s best-of-3 on a QUIET node (load1=$_kload, bar is load1<=$(( _kquiet / 10 )).$(( _kquiet % 10 )) = half of $(nproc 2>/dev/null || echo ?) cores) — the doctor's probe grants 'timeout 12', so the fast core is back to being a gate no runner can reach; move a leg out of it"; fail=1
      else
        say "K2 n/a UNASSERTED: budget unmeasurable here — ${_kbest}s best-of-3 against a 9s bar at load1=$_kload on $(nproc 2>/dev/null || echo ?) cores. Load can only inflate this, so it is a NODE condition, not a verdict on the fast core"
        unasserted="$unasserted K2"
      fi
    fi
  fi

  # K3 — COVERAGE, POSITIVE ARM: the fast core must actually still DRIVE the USER-unset actuator legs
  #      from 8fc2cafc. Asserted on the fast core's OWN output, not on this file's source text.
  if [ "$_krc" -eq 0 ]; then
    if printf '%s' "$_kout" | grep -q 'USER UNSET' \
       && printf '%s' "$_kout" | grep -q '^J1 ACTUATOR RAN' \
       && printf '%s' "$_kout" | grep -q '^J3 an ABSENT supervisor'; then
      say "K3 the fast core still drives the actuator with USER unset (J0/J1/J3 present in its output)"
    else
      say "K3 FAIL: --test-fast no longer carries the USER-unset actuator legs — the doctor would be confirming a suite that dropped the regression this tool was stamped red for"; fail=1
    fi
  fi

  # K4 — COVERAGE, MUTATION ARM: a positive grep proves the legs RAN, never that they still CATCH.
  #      So put 8fc2cafc's defect back — the bare "$USER" that is itself the unbound reference under
  #      `set -u` — in a scratch COPY, and require the FAST core to go red on it. The mutation is
  #      asserted APPLIED first: a sed that silently matched nothing would run the control twice and
  #      report a passing gate (a-failed-fixture-mutation-looks-like-a-passing-gate).
  _kmut="$(mktemp -t mesh-devcd-catch-mut.XXXXXX)"
  sed 's|USER="${USER:-$(id -un)}"|USER="$USER"|' "$0" >"$_kmut"
  if cmp -s "$0" "$_kmut"; then
    say "K4 FAIL: the mutation matched NOTHING, so this arm would have run the control twice and called it a red — the USER fallback has been rewritten or removed"; fail=1
  else
    MESH_TEST_SANDBOX=1 "$TIMEOUT" 60 bash "$_kmut" --test-fast >/dev/null 2>&1; _krc=$?
    if [ "$_krc" -ne 0 ]; then
      say "K4 MUTANT SEEN RED: with the USER fallback reverted to a bare \$USER, --test-fast exits $_krc — the fast core still CATCHES the 8fc2cafc regression, it does not merely mention it"
    else
      say "K4 FAIL: the mutant passed --test-fast (rc=0) — the fast core RUNS the J legs but no longer catches an unset USER, so the doctor's green would mean nothing about that defect"; fail=1
    fi
  fi
  rm -f "$_kmut"

  # summary — a leg that did not run is never asserted by this line
  [ "$fail" -eq 1 ] && { say "RESULT: mesh-devcd-catch --test FAILED"; return 1; }
  if [ -n "$unasserted" ]; then
    say "RESULT: PASS for the legs that RAN — UNASSERTED:$unasserted (their claims are NOT made)."
    say "        Extraction legs E-I are SYNTHETIC by necessity: both devcoredump producers on"
    say "        this node (rtw88_core, bluetooth) are the sole uplink's combo chip, so no dump can"
    say "        be fired without severing the channel the result reports over."
    return 0
  fi
  say "RESULT: PASS — A/B/C/D (class, arm bit, sudo -n read path, live uevent receive) asserted REAL"
  say "        against this kernel; J1-J4 (the listener's actuator, its red arm, an absent actuator,"
  say "        and idempotent self-registration) drive the REAL listener_pid probe against a real"
  say "        spawned child. E-I (extraction, dedup, empty-read red arm, failcap, and the"
  say "        listener's own event loop with its action gate) asserted SYNTHETIC: both devcoredump"
  say "        producers here (rtw88_core, bluetooth) are the sole uplink's combo chip, so firing a"
  say "        real dump would sever the channel the result reports over."
  return 0
}

case "${1:---sweep}" in
  --sweep|"")  with_lock do_sweep ;;
  --listen)    do_listen ;;
  --status)    do_status ;;
  --list)      do_list ;;
  --test)      do_test ;;
  --test-fast) do_test 1 ;;
  -h|--help)   sed -n '/^#   mesh-devcd-catch /,/^#   mesh-devcd-catch --test-fast/p' "$0" | sed 's/^# \{0,3\}//' ;;
  *)           say "unknown mode: $1 (see --help)"; exit 64 ;;
esac
