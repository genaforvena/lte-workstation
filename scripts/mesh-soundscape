#!/usr/bin/env bash
# mesh-soundscape — scan ongoing ambient audio AS AUDIO (not speech) for interesting soundscapes, at
# ANY window size, surface the finds on the sound dash, and feed the best window to grainneukeln for a mix.
#
# Operator's nudge (2026-07-07): "analyze ongoing audio (any sizes of windows) for interesting
# soundscapes … create reflex that would be scanning audio as audio and enrich your top pane. this
# audio should be used to create mixes with grainneukelln." So: a continuous DISCOVERY reflex that
# listens to the room mic, slices each capture at multiple window scales, scores every window for
# acoustic INTERESTINGNESS (dynamics · activity · timbral richness · tonality · spectral movement —
# pure librosa, NO LLM in the measure tract, per the witness-channel operator rule), keeps the best
# window as a clip, and hands it to `mesh-room-music --remix` to become a granular mix. The scanner
# OWNS the ear; grainneukeln OWNS the grind; the sound dash shows what was heard.
#
#   mesh-soundscape --scan          record CAPTURE_SECS from the mic, score windows at every scale,
#                                   log the interesting ones, and (rate-limited) grind the best into a mix
#   mesh-soundscape --show [n]      print the last n soundscape finds (cheap — pure tail, for the dash)
#   mesh-soundscape --test          real-read gate: run the actual analyzer on a synthesized structured
#                                   signal and assert it yields numeric features + a score (no mic/grind)
#
# Consent: this node's mic is always-on with operator consent (memory mic-consent-and-transcribe). The
# only retained audio is the winning clip (SS_DIR), pruned after SS_KEEP_DAYS; everything else is
# transient. Feedback gate: never capture while the mesh itself is making sound (its own TTS/music).
#
# Tunables (env): SS_CAPTURE_SECS=45 · SS_SCALES="3,12,0" (0=whole) · SS_SIL=0.006 (silence floor,
#   float rms) · SS_MIX_THRESHOLD=50 · SS_MIX_GAP_MIN=60 (min minutes between grinds) · SS_KEEP_DAYS=2
#   SS_MIC= (pw-record target; empty = default source) · SS_CLIP_MAX=6 (cap the fed clip, secs — O(n^2))
#
# reflex-cadence: */10 * * * *
# reflex-args: --scan
set -uo pipefail
export PATH="/usr/bin:$HOME/.local/bin:$PATH"          # /usr/bin first: never a snap-confined pw-*/ffmpeg
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"   # pipewire (mic)
MESH="${MESH_DIR:-$HOME/.mesh}"
[ -f "$MESH/nodes" ] && . "$MESH/nodes"

GRAIN_DIR="${GRAIN_DIR:-$HOME/grainneukeln}"
PY="$GRAIN_DIR/.venv/bin/python"
SS_DIR="${SS_DIR:-$MESH/soundscapes}"
SS_LOG="${SS_LOG:-$MESH/soundscape.log}"
SS_MIXSTAMP="$MESH/.soundscape-lastmix"
CAPTURE_SECS="${SS_CAPTURE_SECS:-45}"
SCALES="${SS_SCALES:-3,12,0}"
SIL="${SS_SIL:-0.006}"
# CALIBRATED 2026-07-07 55→50: the score formula (0.28dyn+0.24act+0.20rich+0.14tone+0.14move) is
# softly-normalized and structurally ceilings ~53 on this pipeline's own 16k-mono material — measured
# max over 7 real sources was 53 (quiet home hum 40–49; genuinely-rich operator MUSIC only 51–53), so
# threshold 55 was ABOVE the practical ceiling → the mix lane never fired since inception (hollow sense:
# scans forever, grinds nothing). 50 is the clean data separator — quiet ambience tops at 49, real
# musical content floors at 51 — so the lane grinds genuinely-interesting windows and holds on dull hum.
# (Beat gate SS_MIN_BEATS≥4 + gap SS_MIX_GAP_MIN still bound it; firing = bg grind, no playback.)
MIX_THRESHOLD="${SS_MIX_THRESHOLD:-50}"
MIX_GAP_MIN="${SS_MIX_GAP_MIN:-60}"
KEEP_DAYS="${SS_KEEP_DAYS:-2}"
CLIP_MAX="${SS_CLIP_MAX:-6}"
mkdir -p "$SS_DIR"

# ── the analyzer: read a wav, score every window at every scale, print `WINNER t dur score label`
# (or `WINNER none`) plus a per-window debug block on stderr. Pure librosa — deterministic, no cloud.
analyze() {  # $1 wav  $2 scales-csv  $3 silence-floor  [$4 mode: scan|measure]
  "$PY" - "$1" "$2" "$3" "${4:-scan}" <<'PYEOF'
import sys, os, warnings
warnings.filterwarnings("ignore")
import numpy as np, librosa
path, scales_csv, sil = sys.argv[1], sys.argv[2], float(sys.argv[3])
mode = sys.argv[4] if len(sys.argv) > 4 else "scan"
# The rhythm floor, same values as --scan's gate below (env-overridable there and here alike).
# It lives in the PICK, not just the gate: score's top end is anti-correlated with rhythm (dyn is
# the heaviest term — one transient pins it), so score-max window selection preferentially surfaced
# the least grindable window in the capture, and the gate then declared the whole capture "beatless"
# while a grindable window sat discarded on the debug stderr. Live 2026-07-16: both morning scans
# died that way (score 53/2b, 58/1b). Prefer the best window that CLEARS the floor; fall back to
# plain score-max when nothing does, so a genuinely beatless capture still reports honestly.
MIN_BEATS = int(os.environ.get("SS_MIN_BEATS", "4"))
MIN_DENSITY = float(os.environ.get("SS_MIN_DENSITY", "0.8"))
def none(why):
    # scan and measure share the analyzer but NOT the line format: --scan's caller reads the WINNER
    # line with a fixed 6-var `read`, whose last var absorbs the remainder — so the axes measure mode
    # needs cannot simply be appended there. Two tags, one tract.
    print("MEASURE none" if mode == "measure" else "WINNER none")
    sys.stderr.write("%s\n" % why); sys.exit(0)

try:
    y, sr = librosa.load(path, sr=22050, mono=True)
except Exception as e:
    none("load-fail %s" % e)
n = len(y); total = n / sr if sr else 0.0
if total < 1.0:
    none("too-short %.2fs" % total)

def clip01(x): return max(0.0, min(1.0, float(x)))

def score_window(seg):
    if len(seg) < sr // 2:            # < 0.5s — too small to characterise
        return None
    rms = librosa.feature.rms(y=seg)[0]
    rms_mean = float(rms.mean()); rms_std = float(rms.std())
    if rms_mean < sil:                # near-silent → not a soundscape
        return None
    onset = librosa.onset.onset_strength(y=seg, sr=sr)
    onset_mean = float(onset.mean())
    try:
        contrast = float(librosa.feature.spectral_contrast(y=seg, sr=sr).mean())
    except Exception:
        contrast = 0.0
    flat = float(librosa.feature.spectral_flatness(y=seg)[0].mean())
    cent = librosa.feature.spectral_centroid(y=seg, sr=sr)[0]
    cent_mean = float(cent.mean()); cent_std = float(cent.std())
    # ── interestingness = weighted blend of five audio-as-audio axes, each softened to 0..1 ──
    dyn  = clip01((rms_std / (rms_mean + 1e-6)) / 2.0)   # relative dynamics (swells, hits)
    act  = clip01(onset_mean / 3.0)                       # activity / spectral novelty
    rich = clip01((contrast - 10.0) / 20.0)              # timbral richness (peaks over valleys)
    tone = clip01(1.0 - flat / 0.30)                      # tonality (noise floor penalised)
    move = clip01(cent_std / 1200.0)                      # spectral movement (glides, sweeps)
    score = 100.0 * (0.28*dyn + 0.24*act + 0.20*rich + 0.14*tone + 0.14*move)
    # ── a cheap human-readable character (3 salient tags) ──
    tags = []
    tags.append("dynamic" if dyn > 0.5 else "even")
    tags.append("bright"  if cent_mean > 2000 else "dark")
    tags.append("noisy" if flat > 0.15 else ("tonal" if flat < 0.03 else "mixed"))
    if act > 0.55: tags.append("busy")
    elif act < 0.20: tags.append("sparse")
    return dict(score=score, label="·".join(tags[:3]),
                rms=rms_mean, dyn=dyn, act=act, rich=rich, tone=tone, move=move,
                cent=cent_mean)

scales = []
for tok in scales_csv.split(","):
    tok = tok.strip()
    if not tok: continue
    v = float(tok)
    scales.append(total if v <= 0 else min(v, total))

# the grainneukeln automixer is BEAT-DRIVEN — a beatless window grinds to an empty mp3. Count beats
# per window so the pick can prefer what the grinder can actually use, not just what scored.
def window_beats(seg):
    try:
        _, b = librosa.beat.beat_track(y=seg, sr=sr, units="frames")
        return int(len(b))
    except Exception:
        return 0

best = None; best_off = 0.0; best_dur = 0.0; best_beats = 0          # score-max fallback
ok = None; ok_off = 0.0; ok_dur = 0.0; ok_beats = 0                   # best among floor-clearing
for w in scales:
    step = max(w, 1.0)
    off = 0.0
    while off + min(w, 1.0) <= total + 1e-6:
        s = y[int(off*sr):int((off+w)*sr)]
        r = score_window(s)
        if r is not None:
            nb = window_beats(s)
            dens = nb / w if w > 0 else 0.0
            clears = nb >= MIN_BEATS and dens >= MIN_DENSITY
            sys.stderr.write("  %5.1fs @%5.1fs  score %5.1f  %-24s %2db %.2fb/s%s rms %.4f dyn %.2f act %.2f rich %.2f tone %.2f move %.2f\n"
                             % (w, off, r["score"], r["label"], nb, dens, "*" if clears else " ",
                                r["rms"], r["dyn"], r["act"], r["rich"], r["tone"], r["move"]))
            if best is None or r["score"] > best["score"]:
                best, best_off, best_dur, best_beats = r, off, w, nb
            if clears and (ok is None or r["score"] > ok["score"]):
                ok, ok_off, ok_dur, ok_beats = r, off, w, nb
        off += step

if best is None:
    none("no window scored above the silence floor")
if ok is not None:
    best, best_off, best_dur, best_beats = ok, ok_off, ok_dur, ok_beats
nbeats = best_beats

# ── PITCH-STRUCTURE AXES (file-level, LEVEL-INVARIANT) ────────────────────────────────────────────
# The five score axes above all read ENERGY shape (rms/onset/contrast/flatness/centroid). None of them
# answers "is a pitched INSTRUMENT being played", and mesh-guitar-watch's gate — built out of
# tone/rich/rms/beats — proved it: measured 2026-08-14 against the operator's OWN 85s guitar take
# (recovered from Telegram, the labelled positive), the take failed `rms>=0.10` on 8/8 of its 11s
# chops (median rms .041 = corpus percentile 4.3 — his guitar is QUIETER than 95.7% of the ambient it
# was supposed to stand out from), while the full AND-gate still fired on 5–28% of ambient captures
# EVERY DAY. That is the operator's "всегда не то" in numbers: an axis pointing the wrong way cannot
# be repaired by moving its threshold, and no (tone,rich,beats) threshold that catches him passes
# fewer than ~21% of ambient.
#
# These two axes DO separate it, and they are computed on the WHOLE file (not the score-max window,
# which is chosen by a dyn-heavy ranker — CLAUDE.md "check what your ranker SELECTS FOR") and on
# peak-normalised audio, so recording level cannot re-break them the way it broke `rms`:
#   chent  = entropy of the mean chroma vector, 0..1 (0 = one pitch class, 1 = flat/pitchless)
#   voiced = fraction of frames pyin finds a confident f0 for in the guitar range (70–700 Hz)
# Measured separation, ground truth (8 chops of his take) vs 40 ambient fanout captures:
#   chent  guitar [.978,.990]  ambient [.992,.999]  → CLEAN split, no overlap
#   voiced guitar [.321,.538]  ambient median .000, p75 .096 (one 0.509 outlier)
# CODEC CONTROL (the take arrived as Telegram opus, the ambient as raw wav — a discriminator validated
# across two codecs may be detecting the CODEC): 8 ambient captures opus-round-tripped at TG voice-note
# settings read chent [.993,.999] / voiced median .000 — indistinguishable from their raw selves. The
# separation is the instrument, not the encoder.
def _pitch_axes():
    try:
        import numpy as _np
        yn = y / (float(_np.max(_np.abs(y))) + 1e-9)
        ch = librosa.feature.chroma_cqt(y=yn, sr=sr).mean(axis=1)
        ch = ch / (ch.sum() + 1e-9)
        chent = float(-(ch * _np.log(ch + 1e-12)).sum() / _np.log(12))
        _f0, vflag, _vp = librosa.pyin(yn, fmin=70, fmax=700, sr=sr, frame_length=2048)
        voiced = float(_np.nanmean(vflag.astype(float)))
        return chent, voiced
    except Exception:
        return None, None      # honest n/a — printed as na, never a fabricated 0/1 (either extreme is a verdict)

if mode == "measure":
    # The RAW AXES, which --scan measures and then discards (only `beats` survives there, as a gate).
    # They are the whole point of this mode: mesh-sound-reflex derives the grind recipe from them, so
    # a busy source and a sparse one cannot come out with the same params. k=v so the reader is
    # order-independent and new axes never shift an existing field.
    chent, voiced = _pitch_axes()
    print("MEASURE off=%.2f dur=%.2f score=%.1f label=%s beats=%d dyn=%.3f act=%.3f rich=%.3f "
          "tone=%.3f move=%.3f cent=%.1f rms=%.5f total=%.2f chent=%s voiced=%s"
          % (best_off, best_dur, best["score"], best["label"], nbeats, best["dyn"], best["act"],
             best["rich"], best["tone"], best["move"], best["cent"], best["rms"], total,
             "na" if chent is None else "%.4f" % chent,
             "na" if voiced is None else "%.3f" % voiced))
else:
    print("WINNER %.2f %.2f %.1f %s %d" % (best_off, best_dur, best["score"], best["label"], nbeats))
PYEOF
}

SELF="$(readlink -f "$0")"

# analyze() prints `WINNER none` for THREE different reasons and puts the why on stderr, which --scan
# discarded with 2>/dev/null: a genuinely quiet room ("no window scored above the silence floor"), an
# unreadable capture ("load-fail ..."), and a truncated one ("too-short ...s"). The last two mean the
# MIC/capture is broken, not that the room is quiet — and since the liveness touch happens before the
# check (correctly), a dead mic reads as "live scanner, quiet room" forever. This node's mic has that
# exact history (pw-record stalls, capture wedges surviving restart, the post-reboot audio-group
# deafness). Quiet stays silent by design — the dash must not carry a line per 10min tick — but a
# broken capture is rare and must be LOUD. (2026-08-17)
scan_none_is_fault(){ # $1=the why line from analyze's stderr -> 0 when the CAPTURE is at fault
  case "$1" in
    load-fail*|too-short*) return 0 ;;
    *) return 1 ;;
  esac
}

case "${1:---scan}" in
  # --grind-bg <clip> <timeout> <log> <params-log> <grain-dir>
  # The detached grind + its REPORT. Split out of an inline `setsid bash -c` string 2026-08-17 so
  # --test can drive the exact code that runs in production; see gate G below for what it fixes.
  --grind-bg)
    _gclip="$2"; _gGT="$3"; _gLOG="$4"; _gPARAMS="$5"
    # Byte offset BEFORE the grind: the only region of the shared params log this render could
    # possibly have written. That log is appended by every lane (sound-reflex drops, manual grinds),
    # so `tail -n1` attributes whatever finished last — and no params line names its own output file
    # (1 line in the entire log contains "mp3"), so the guess is unverifiable in principle.
    _gpoff="$(stat -c%s "$_gPARAMS" 2>/dev/null || echo 0)"
    # Named hook, not a PATH prefix: this script re-exports PATH at load (line 31, /usr/bin first),
    # so a test cannot shadow the grinder by prepending a dir — it would silently drive the REAL one.
    _gout="$(timeout "$_gGT" "${SS_GRIND_CMD:-mesh-room-music}" --remix "$_gclip" 2>/dev/null | grep -E '\.mp3$' | tail -1)"
    _gts="$(date -u +%Y-%m-%dT%H:%MZ)"
    # NO `ls -t` FALLBACK. It used to take the newest mp3 in the SHARED output tree whenever the
    # grind returned nothing — reporting another lane's earlier render as THIS scan's "mix ready",
    # params and all. Not a constant standing in for a failure, but someone else's SUCCESS: it reads
    # as a real mix and it steals the attribution. It also made the failure branch unreachable —
    # 87 "mix ready" lines and 0 "mix failed" in the whole log, on a tree holding ~1.1GB of other
    # lanes' renders. No path out of --remix IS the failure, and must be logged as one.
    if [ -n "$_gout" ] && [ "$(stat -c%s "$_gout" 2>/dev/null || echo 0)" -ge 2000 ]; then
      _gn="$(tail -c "+$((_gpoff+1))" "$_gPARAMS" 2>/dev/null | grep -c .)"
      if [ "$_gn" = 1 ]; then
        _gp="$(tail -c "+$((_gpoff+1))" "$_gPARAMS" 2>/dev/null | sed 's/^[^ ]* //')"
      else
        _gp="params unattributed (${_gn} line(s) appended by all lanes during this grind)"
      fi
      echo "$_gts    mix ready: $(basename "$_gout") [${_gp:-?}]" >> "$_gLOG"
    else
      echo "$_gts    mix failed (grind produced no render in ${_gGT}s — no usable beats)" >> "$_gLOG"
    fi
    exit 0 ;;

  --scan)
    # feedback gate — never sample the mesh's own output (TTS / music on the sink)
    if [ -f "$MESH/mesh-speaking" ] || pgrep -x pw-play >/dev/null 2>&1; then
      echo "soundscape: skip (mesh is speaking)"; exit 0
    fi
    [ -x "$PY" ] || { echo "soundscape: FAIL (grainneukeln venv python missing at $PY)"; exit 1; }
    cap="$(mktemp --suffix=.wav)"
    trap 'rm -f "$cap"' EXIT
    # pw-record runs until killed; timeout returns 124 which `true` swallows so the pipe succeeds.
    # RETRY (soundscape-busy-retry): a single open races a momentarily-busy PipeWire source → empty
    # capture → honest-but-hollow exit 2 every scan while the mic is briefly held (TTS tail, another
    # reader). Retry the open a few times so a transient busy self-heals within the pass, matching the
    # phone-SSH retry-once / mesh-mag `-n 2` convention. A genuinely dead/held mic still drains the
    # retries and exits 2 honestly (never a fake capture).
    # SS_FIXTURE_CAP — named hook so --test can drive the REAL scan decision path (capture -> analyze
    # -> none-classification -> log) without a mic. Opt-in by env exactly like SS_GRIND_CMD; unset in
    # production, so the pw-record loop below is untouched. Without it the wiring between analyze()'s
    # stderr and scan_none_is_fault() is untestable, and an untestable wiring is how the discarded
    # reason survived in the first place — reverting the 2>"$_awhy" capture left every gate green.
    if [ -n "${SS_FIXTURE_CAP:-}" ] && [ -r "${SS_FIXTURE_CAP}" ]; then
      cp -f "$SS_FIXTURE_CAP" "$cap"
    else
    SS_TRIES="${SS_TRIES:-3}"; SS_RETRY_SLEEP="${SS_RETRY_SLEEP:-2}"
    for try in $(seq 1 "$SS_TRIES"); do
      timeout "$CAPTURE_SECS" pw-record ${SS_MIC:+--target "$SS_MIC"} --rate 22050 --channels 1 --format s16 "$cap" 2>/dev/null; true
      [ -s "$cap" ] && break
      [ "$try" -lt "$SS_TRIES" ] && sleep "$SS_RETRY_SLEEP"
    done
    fi
    if [ ! -s "$cap" ]; then echo "soundscape: no capture (mic busy/unreachable, ${SS_TRIES}x)"; exit 2; fi

    _awhy="$(mktemp)"
    read -r _tag off dur score label beats < <(analyze "$cap" "$SCALES" "$SIL" 2>"$_awhy" | grep '^WINNER')
    ts="$(date -u +%Y-%m-%dT%H:%MZ)"
    # mtime = liveness (every scan, always) — decouples ran-live from the change-gated log so an
    # mtime-aging watchdog never misreads a long-quiet-but-LIVE scanner as dead (liveness-touch convention)
    touch "$MESH/.soundscape-tick" 2>/dev/null   # bare marker: touch always refreshes mtime + creates if missing
    if [ "${off:-none}" = "none" ] || [ -z "${score:-}" ]; then
      _why="$(head -1 "$_awhy" 2>/dev/null)"; rm -f "$_awhy"
      if scan_none_is_fault "$_why"; then
        # the CAPTURE failed — never silent, or a dead mic is indistinguishable from a quiet room
        echo "$ts  CAPTURE FAULT: $_why — the mic/capture failed, this is NOT a quiet room (scanner heartbeat stays fresh either way)" >> "$SS_LOG"
        [ -t 2 ] && echo "soundscape: CAPTURE FAULT: $_why"
      else
        [ -t 2 ] && echo "soundscape: quiet, nothing scored ($_why)"   # quiet is the common case — no dash line
      fi
      exit 0
    fi
    rm -f "$_awhy"

    scoreint="${score%.*}"; beats="${beats:-0}"; MIN_BEATS="${SS_MIN_BEATS:-4}"
    # RHYTHM DENSITY (beats per second of the winning window) — score alone cannot tell "interesting
    # rhythm" from "one loud bang". `dyn` is this scorer's heaviest term (0.28), so a single transient
    # pins it and tops the corpus: the operator's cough at 02:57:08 scored 65.6 against a median of
    # 41.8 with only 5 beats over a 12s window. Measured over n=215 real records, score>=55 averages
    # 3.6 beats vs 12.2 for everything else — this score is ANTI-CORRELATED with rhythm at its top
    # end, while the automixer it feeds is beat-driven. So the mix lane was preferentially grinding
    # coughs and door slams. beats>=4 alone does not catch it (a cough hallucinates 5).
    # Impulses measure 0.00-0.42 b/s, material that grinds well 1.33-1.58 b/s; 0.8 sits in the gap.
    MIN_DENSITY="${SS_MIN_DENSITY:-0.8}"
    dens="$(awk -v b="$beats" -v w="${dur:-0}" 'BEGIN{ printf "%.2f", (w>0)? b/w : 0 }')"
    LOG_FLOOR="${SS_LOG_FLOOR:-45}"       # only genuinely-interesting finds reach the dash log
    mix="—"

    if [ "$scoreint" -lt "$MIX_THRESHOLD" ] 2>/dev/null; then
      mix="(score<$MIX_THRESHOLD)"
    elif [ "$beats" -lt "$MIN_BEATS" ] 2>/dev/null; then
      mix="(beatless ${beats}b — not grindable)"
    elif awk -v d="$dens" -v md="$MIN_DENSITY" 'BEGIN{exit !(d+0 < md+0)}'; then
      mix="(transient ${dens}b/s — a bang, not a rhythm)"
    else
      # grind candidate — extract the window as a clip. Floor at SS_CLIP_MIN so beat_track has material,
      # cap at SS_CLIP_MAX so the O(n^2) automixer stays fast; center-bounded within the capture.
      CLIP_MIN="${SS_CLIP_MIN:-5}"
      fdur="$(awk -v d="$dur" -v mn="$CLIP_MIN" -v mx="$CLIP_MAX" -v tot="$CAPTURE_SECS" \
                'BEGIN{x=(d<mn)?mn:d; if(x>mx)x=mx; if(x>tot)x=tot; print x}')"
      coff="$(awk -v o="$off" -v d="$dur" -v f="$fdur" -v tot="$CAPTURE_SECS" \
                'BEGIN{c=o+d/2-f/2; if(c<0)c=0; if(c+f>tot)c=tot-f; if(c<0)c=0; printf "%.2f", c}')"
      clip="$SS_DIR/$(date -u +%Y%m%d-%H%M%S)_s${scoreint}.wav"
      ffmpeg -hide_banner -nostats -y -ss "$coff" -t "$fdur" -i "$cap" -ac 1 -ar 44100 "$clip" >/dev/null 2>&1
      last=0; [ -f "$SS_MIXSTAMP" ] && last="$(cat "$SS_MIXSTAMP" 2>/dev/null || echo 0)"
      now="$(date +%s)"; gap=$(( (now - last) / 60 ))
      if [ "$gap" -lt "$MIX_GAP_MIN" ]; then
        mix="(held ${gap}/${MIX_GAP_MIN}m)"
      else
        # grainneukeln is O(n^2) and slow (a short clip can take minutes) — NEVER block the cron scan on
        # it. Stamp NOW (prevents a second concurrent grind), then run detached + hard-timeout-bounded;
        # the background job appends the final mix/verdict line to the log when it finishes.
        echo "$now" > "$SS_MIXSTAMP"
        GT="${SS_GRIND_TIMEOUT:-240}"
        # The body lives in --grind-bg (one code path, drivable by --test). It used to be an inline
        # `setsid bash -c '...'` string that NOTHING could call, which is how its attribution bug
        # survived 87 runs unexamined.
        setsid "$SELF" --grind-bg "$clip" "$GT" "$SS_LOG" "$MESH/room-music-params.log" "$GRAIN_DIR" \
          </dev/null >/dev/null 2>&1 &
        mix="grinding (bg, ≤${GT}s)"
      fi
    fi

    # only surface genuinely-interesting finds (or any grind attempt) on the dash log; quiet/dull windows
    # already touched the heartbeat and need no line
    if [ "$scoreint" -ge "$LOG_FLOOR" ] 2>/dev/null || [ "$mix" != "(score<$MIX_THRESHOLD)" ]; then
      echo "$ts  score $scoreint ${beats}b  [$label]  win ${dur}s@${off}s  -> $mix" >> "$SS_LOG"
    fi
    [ -t 2 ] && echo "soundscape: score $scoreint ${beats}b [$label] -> $mix"
    # prune old clips + trim the log
    find "$SS_DIR" -name '*.wav' -mtime +"$KEEP_DAYS" -delete 2>/dev/null
    tail -n 400 "$SS_LOG" > "$SS_LOG.tmp" 2>/dev/null && mv "$SS_LOG.tmp" "$SS_LOG"
    ;;

  --show)
    n="${2:-5}"
    [ -f "$SS_LOG" ] && tail -n "$n" "$SS_LOG" || echo "  (no scans yet)"
    ;;

  --measure)
    # Run the ear's analyzer on an ARBITRARY file (not a fresh mic capture) and print the raw axes.
    # mesh-records calls this to characterise every archived record, so the measure tract stays here
    # (mesh-soundscape OWNS the ear) instead of a second librosa analyzer drifting out of sync.
    # No side effects: no capture, no grind, no log, no heartbeat touch.
    f="${2:-}"
    [ -n "$f" ] || { echo "usage: mesh-soundscape --measure <wav>" >&2; exit 1; }
    [ -f "$f" ] || { echo "measure: no such file: $f" >&2; exit 1; }
    [ -x "$PY" ] || { echo "measure: n/a (grainneukeln venv python missing at $PY)" >&2; exit 2; }
    # Whole-file scale FIRST (0) so a short record still characterises even if no sub-window scores.
    out="$(analyze "$f" "${SS_MEASURE_SCALES:-0,12,3}" "$SIL" measure 2>/dev/null | grep '^MEASURE')"
    [ -n "$out" ] || { echo "MEASURE none"; exit 2; }
    echo "$out"
    case "$out" in "MEASURE none") exit 2 ;; esac
    ;;

  --test)
    fail() { echo "smoke-test: FAIL ($1)"; exit 1; }
    # ENV-ABSENT is honest-n/a (exit 2), NOT fail: the audio stack + grainneukeln venv only exist on
    # nodes carrying this sense. A headless VM (phaedra) has no pw-record/ffmpeg/venv → the real-read
    # gate can't run → n/a, which mesh-land/fitness treat as a pass (never a fake green). Exit-1 FAIL is
    # reserved for a REAL regression: env present but the analyzer misreads a structured signal. (Was
    # exit-1 on all three → false fitness-revert of a good commit on env-lacking nodes.)
    na() { echo "smoke-test: n/a ($1)"; exit 2; }
    command -v pw-record >/dev/null 2>&1 || na "no pw-record (audio stack absent)"
    command -v ffmpeg >/dev/null 2>&1 || na "no ffmpeg (audio stack absent)"
    [ -x "$PY" ] || na "grainneukeln venv python missing at $PY (sense not installed)"
    # REAL-READ GATE: synthesize a structured signal (tone sweep + amplitude swell) and assert the
    # actual analyzer returns a numeric score + a non-empty label — not just that the code runs.
    tw="$(mktemp --suffix=.wav)"; trap 'rm -f "$tw"' EXIT
    ffmpeg -v quiet -y -f lavfi -i "aevalsrc='0.3*(1+sin(2*PI*0.5*t))*sin(2*PI*(300+200*t)*t)':d=14:s=22050" -ac 1 "$tw" \
      || fail "ffmpeg synth failed"
    win="$(analyze "$tw" "3,12,0" "0.006" 2>/dev/null | grep '^WINNER')"
    echo "  analyzer: $win"
    case "$win" in
      "WINNER none"|"") fail "analyzer scored a structured 14s signal as uninteresting (real-read gate)";;
    esac
    sc="$(awk '{print $4}' <<<"$win")"; lbl="$(awk '{print $5}' <<<"$win")"
    awk -v s="$sc" 'BEGIN{exit !(s+0>0)}' || fail "non-numeric score ($sc)"
    [ -n "$lbl" ] || fail "empty character label"
    # REAL-READ GATE for --measure: the same synthesized signal must come back through the measure
    # mode with the RAW AXES populated — mesh-records/mesh-sound-reflex derive the whole grind recipe
    # from these, so an analyzer that silently stopped emitting them (or a `read`-shifted field) is a
    # regression that would quietly flatten every render back to blind params.
    mout="$("$0" --measure "$tw" 2>/dev/null)"
    echo "  measure: $mout"
    case "$mout" in ""|"MEASURE none") fail "--measure returned nothing for a real 14s signal (real-read gate)";; esac
    for k in off dur score label beats dyn act rich tone move cent; do
      grep -qE "(^| )$k=[^ ]+" <<<"$mout" || fail "--measure line missing axis '$k' (recipe derivation would go blind)"
    done
    mdyn="$(grep -oE '(^| )dyn=[0-9.]+' <<<"$mout" | grep -oE '[0-9.]+')"
    awk -v v="$mdyn" 'BEGIN{exit !(v+0>=0 && v+0<=1)}' || fail "dyn=$mdyn outside 0..1 (axes not normalized)"
    # WINNER must stay a 6-field line: --scan reads it with a fixed 6-var `read` whose last var
    # absorbs the remainder, so any widening here silently corrupts `beats` and the beat gate with it.
    [ "$(awk '{print NF}' <<<"$win")" = 6 ] || fail "WINNER line is not 6 fields — --scan's 6-var read would swallow the rest into beats"
    # SELECTION GATE: score-max must NOT be the pick when a floor-clearing window exists. The fixture
    # poses the live 2026-07-16 conflict: one loud transient (pins dyn -> top score, 2b) + a 2Hz
    # percussive tail (lower score, clears beats>=4 + 0.8b/s). The old score-max pick returned the
    # transient and the scan died "beatless" while grindable material sat discarded on stderr.
    # Floor env pinned so a node's exported SS_MIN_* tuning can't flip the verdict per node.
    cw="$(mktemp --suffix=.wav)"; cerr="$(mktemp)"
    ffmpeg -v quiet -y -f lavfi -i "aevalsrc='0.02*sin(2*PI*220*t) + 0.9*sin(2*PI*440*t)*between(t,1,1.3) + 0.7*exp(-14*mod(t,0.5))*sin(2*PI*330*t)*gte(t,7)':d=14:s=22050" -ac 1 "$cw" \
      || { rm -f "$cw" "$cerr"; fail "ffmpeg conflict synth failed"; }
    cwin="$(SS_MIN_BEATS=4 SS_MIN_DENSITY=0.8 analyze "$cw" "3,12,0" "0.006" 2>"$cerr" | grep '^WINNER')"
    csc="$(awk '{print $4}' <<<"$cwin")"; cdur="$(awk '{print $3}' <<<"$cwin")"; cbeats="$(awk '{print $6}' <<<"$cwin")"
    topsc="$(grep -oE 'score +[0-9.]+' "$cerr" | awk '{if($2+0>m)m=$2+0} END{print m+0}')"
    rm -f "$cw" "$cerr"
    awk -v b="$cbeats" -v d="$cdur" 'BEGIN{exit !(b+0>=4 && d+0>0 && b/d>=0.8)}' \
      || fail "pick took a below-floor window ($cwin) while a floor-clearing one existed — score-max selection is aimed at transients"
    awk -v w="$csc" -v t="$topsc" 'BEGIN{exit !(w+0 < t+0)}' \
      || fail "conflict fixture no longer poses the conflict (winner score $csc IS the capture's top $topsc) — the selection gate is vacuous, retune the fixture"
    # GATE G: the detached grind must never report ANOTHER LANE'S render as its own mix.
    # Found live 2026-08-17: a scan at 18:20 logged `mix ready:` naming a file written at 17:20 by
    # the DROP lane (src=drop/78e23f9c). The cause was `[ -z "$out" ] && out=$(ls -t output/*.mp3 |
    # head -1)` — on a failed grind it grabbed the newest mp3 in the shared tree. That is a silent
    # fallback whose default is someone else's SUCCESS, so it is indistinguishable from a real mix,
    # and it made the failure branch unreachable: 87 "mix ready", 0 "mix failed", ever.
    # Drives the REAL --grind-bg with a stub mesh-room-music on PATH.
    gt="$(mktemp -d)"; mkdir -p "$gt/bin" "$gt/out"
    glog="$gt/ss.log"; gpar="$gt/params.log"
    printf '2026-08-17T17:20:00Z amc l 750 w 4 ~ src=drop/OTHERLANE\n' > "$gpar"
    # a decoy render already in the shared tree — the file the old fallback would have stolen
    head -c 9000 /dev/urandom > "$gt/out/OTHERLANE_2026_08_17_1720.mp3"
    # G1: grind produces NOTHING -> must log mix failed, and must NOT name the decoy
    printf '#!/usr/bin/env bash\nexit 0\n' > "$gt/bin/mesh-room-music"; chmod +x "$gt/bin/mesh-room-music"
    SS_GRIND_CMD="$gt/bin/mesh-room-music" "$SELF" --grind-bg "$gt/clip.wav" 5 "$glog" "$gpar" "$gt"
    g1="$(cat "$glog")"; : > "$glog"
    case "$g1" in
      *"mix failed"*) : ;;
      *) rm -rf "$gt"; fail "a grind that produced no render must log 'mix failed' — got: $g1" ;;
    esac
    case "$g1" in
      *OTHERLANE*) rm -rf "$gt"; fail "a failed grind reported another lane's render as its own mix — the ls -t fallback is back: $g1" ;;
    esac
    # G2: grind SUCCEEDS -> names its OWN render, and quotes only params appended during the grind
    cat > "$gt/bin/mesh-room-music" <<GSTUB
#!/usr/bin/env bash
o="$gt/out/MINE_2026_08_17_1830.mp3"
head -c 9000 /dev/urandom > "\$o"
echo '2026-08-17T18:30:00Z amc l 120 w 5 ~ src=scape/MINE' >> "$gpar"
echo "\$o"
GSTUB
    chmod +x "$gt/bin/mesh-room-music"
    SS_GRIND_CMD="$gt/bin/mesh-room-music" "$SELF" --grind-bg "$gt/clip.wav" 5 "$glog" "$gpar" "$gt"
    g2="$(cat "$glog")"; : > "$glog"
    case "$g2" in
      *"mix ready: MINE_2026_08_17_1830.mp3"*) : ;;
      *) rm -rf "$gt"; fail "a successful grind must name ITS OWN render — got: $g2" ;;
    esac
    case "$g2" in
      *"src=scape/MINE"*) : ;;
      *) rm -rf "$gt"; fail "the params quoted must be the line THIS grind appended — got: $g2" ;;
    esac
    case "$g2" in
      *OTHERLANE*) rm -rf "$gt"; fail "the params quoted belong to another lane (stale tail -n1) — got: $g2" ;;
    esac
    # G3: two lanes append during one grind -> refuse to guess, say so
    cat > "$gt/bin/mesh-room-music" <<GSTUB2
#!/usr/bin/env bash
o="$gt/out/MINE2_2026_08_17_1840.mp3"
head -c 9000 /dev/urandom > "\$o"
printf 'ts amc A ~ src=scape/MINE2\nts amc B ~ src=drop/CONCURRENT\n' >> "$gpar"
echo "\$o"
GSTUB2
    chmod +x "$gt/bin/mesh-room-music"
    SS_GRIND_CMD="$gt/bin/mesh-room-music" "$SELF" --grind-bg "$gt/clip.wav" 5 "$glog" "$gpar" "$gt"
    g3="$(cat "$glog")"; rm -rf "$gt"
    case "$g3" in
      *"params unattributed (2 line(s)"*) : ;;
      *) fail "with 2 lanes appending during one grind the params must read unattributed, not a guess — got: $g3" ;;
    esac
    # GATE H: a BROKEN CAPTURE must not read as a quiet room. analyze() answers `WINNER none` for
    # three different reasons and --scan discarded the why with 2>/dev/null, so an unreadable or
    # truncated capture exited silently exactly like honest quiet — while the liveness touch (which
    # correctly happens first) kept the scanner looking alive. This node's mic wedges for real.
    # Two legs: the analyzer must EMIT a distinguishable reason for each cause (real fixtures, real
    # librosa), and the classifier must sort them.
    hw="$(mktemp -d)"
    printf 'not audio at all' > "$hw/garbage.wav"
    ffmpeg -v quiet -y -f lavfi -i "aevalsrc='0':d=0.4:s=22050" -ac 1 "$hw/short.wav"
    ffmpeg -v quiet -y -f lavfi -i "aevalsrc='0':d=8:s=22050"   -ac 1 "$hw/silent.wav"
    h_load="$(analyze "$hw/garbage.wav" "3,12,0" "$SIL" 2>&1 >/dev/null | head -1)"
    h_short="$(analyze "$hw/short.wav"  "3,12,0" "$SIL" 2>&1 >/dev/null | head -1)"
    h_quiet="$(analyze "$hw/silent.wav" "3,12,0" "$SIL" 2>&1 >/dev/null | head -1)"
    rm -rf "$hw"
    echo "  none-reasons: load='$h_load' short='$h_short' quiet='$h_quiet'"
    # each cause must be distinguishable — if two collapse to one string the classifier cannot sort them
    [ "$h_load" != "$h_quiet" ] && [ "$h_short" != "$h_quiet" ] \
      || fail "a broken capture and a quiet room produce the SAME reason (load='$h_load' short='$h_short' quiet='$h_quiet') — they cannot be told apart"
    scan_none_is_fault "$h_load"  || fail "an unreadable capture must classify as a CAPTURE FAULT (got '$h_load')"
    scan_none_is_fault "$h_short" || fail "a truncated capture must classify as a CAPTURE FAULT (got '$h_short')"
    scan_none_is_fault "$h_quiet" && fail "a genuinely quiet room must NOT classify as a fault (got '$h_quiet') — it would put a line on the dash every 10min tick"
    # leg 3: the WIRING. Legs 1-2 assert analyze() and the classifier separately; reverting the
    # 2>"$_awhy" capture that joins them left both green (caught by mutation). Drive the real --scan.
    hw2="$(mktemp -d)"; mkdir -p "$hw2/mesh"
    printf 'not audio at all' > "$hw2/garbage.wav"
    ffmpeg -v quiet -y -f lavfi -i "aevalsrc='0':d=8:s=22050" -ac 1 "$hw2/silent.wav"
    SS_FIXTURE_CAP="$hw2/garbage.wav" SS_LOG="$hw2/fault.log" MESH_DIR="$hw2/mesh" SS_DIR="$hw2/ss" \
      "$SELF" --scan >/dev/null 2>&1
    grep -q 'CAPTURE FAULT' "$hw2/fault.log" 2>/dev/null \
      || { rm -rf "$hw2"; fail "a --scan whose capture is UNREADABLE wrote no CAPTURE FAULT line — a dead mic still reads as a quiet room (log: '$(cat "$hw2/fault.log" 2>/dev/null | head -1)')"; }
    SS_FIXTURE_CAP="$hw2/silent.wav" SS_LOG="$hw2/quiet.log" MESH_DIR="$hw2/mesh" SS_DIR="$hw2/ss" \
      "$SELF" --scan >/dev/null 2>&1
    if [ -s "$hw2/quiet.log" ]; then
      qline="$(head -1 "$hw2/quiet.log")"; rm -rf "$hw2"
      fail "a genuinely QUIET scan wrote a dash line ('$qline') — that is a line every 10min tick, the spam the silent-quiet design avoids"
    fi
    rm -rf "$hw2"
    echo "smoke-test: ok (analyzer reads a real 14s signal -> score $sc [$lbl]; --measure yields all raw axes; WINNER stays 6 fields; a floor-clearing window beats a higher-scoring transient in the pick; scales+silence-floor+mix-gate wired; a failed grind logs mix-failed and never claims another lane's render, a successful one quotes only its own params; a broken capture is distinguishable from a quiet room and classified a fault; no mic/grind side-effect)"
    ;;

  *) echo "usage: mesh-soundscape --scan | --show [n] | --measure <wav> | --test"; exit 1 ;;
esac
