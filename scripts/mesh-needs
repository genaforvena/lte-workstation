#!/usr/bin/env bash
# mesh-needs — STATE-DERIVED GOALS for the autopoiesis loop (the enaction gap). The genome lane works
# off a STATIC evergreen rotation; a cognitive autopoietic system derives its goals from its OWN
# deficits. This reads the mesh's live deficit signals and injects PRIORITIZED tasks into the
# ideas-queue as [ ] items — mesh-generate pulls [ ] BEFORE evergreens, so the mesh works on its
# biggest current need first, falling back to the rotation only when it has no acute deficit.
#
# Deficit sources (priority order, genome-domain — generate targets the genome worker):
#   1. failing tools          (mesh-verify-table ✗)        — quality regression, fix first
#   2. dead scheduled reflexes (mesh-reflex-health STALE)  — a reflex silently not producing
#   3. decay candidates        (mesh-reflex-decay dry-run) — unused+failing tools = bloat
# Capped (MESH_NEEDS_MAX, default 2/run) + deduped against the queue so it never floods (the
# 351-line queue-runaway lesson). Sense deficits are NOT injected here — they belong to the senses
# lane (mesh-sense-evolve LIVENESS directive), keeping the two lanes cleanly separated.
#   mesh-needs           inject up to MAX top-priority deficit tasks (if not already queued)
#   mesh-needs --check   list current deficits, inject nothing
#   mesh-needs --test    smoke test
#   mesh-needs --balance explore<->exploit posture + the LIKING (outcome) axis, read-only
# reflex-cadence: */15 * * * *
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
M="$HOME/.mesh"; Q="$M/ideas-queue"; MAX="${MESH_NEEDS_MAX:-2}"
ts(){ date -u +%FT%TZ; }

# already represented in the queue? (dedup on a stable token: the tool/reflex name + task verb)
queued(){ grep -qiE "^\[[ ~]\].*$1" "$Q" 2>/dev/null; }

# ANTIFRAGILITY MISREAD (foundational, applied too loosely across the genome): the mesh calls its
# chaos-reflex "Antifragility" (mesh-chaos:4; docs/telos.md:23 "Antifragility — it proves its
# RESILIENCE by exercising failure"; docs/eternity-and-its-fields.md:33). But Taleb's foundational
# triad is robust / fragile / ANTIFRAGILE, and "antifragile is as distant from robust as robust is
# from fragile" (Antifragile, 2012; the math is CONVEXITY). Robust = endures, no gain; resilient =
# recovers, stays the SAME; ANTIFRAGILE = GAINS from disorder, gets BETTER (convex response). What we
# label antifragile is chaos-engineering that VERIFIES recovery-to-baseline = ROBUSTNESS, not gain.
# The misread is ARCHITECTURAL, and it is visible RIGHT HERE: this is the autopoiesis growth-lane's
# goal source, and every source below is STATIC-DEFICIT (1 failing / 2 stale / 3 decay) or IDLE-forage
# (4) — NONE ingests a DISORDER/stress-EVENT signal. So the failure lane (mesh-chaos RESILIENCE GAP →
# fail_stop alert+PAUSE; mesh-node-care recovery-log of a node FREEZE; a thermal SHED of many minds)
# and the growth lane (this) are DECOUPLED: a stressor that nearly killed the mesh produces an
# operator alert or a log line, never a permanent capability gain. Robust + generative, but disorder
# does NOT drive growth — the convex coupling that IS antifragility is missing.
# HELD FIX (steward lands — behavioral): add a deficit source that converts a RECENT disorder/incident
# into a prioritized HARDENING goal — e.g. a fresh mesh-chaos "RESILIENCE GAP" / a node-care
# freeze-recovery / a thermal-shed episode → "[ ] HARDEN: <component> failed under <stress>; add the
# missing supervisor/Restart=/timeout/redundancy so the NEXT occurrence is survived." Then each
# stressor monotonically RAISES robustness (gains-from-disorder = the convex/antifragile signature),
# and the loop earns the name the docs already give it. Held because (a) it wires the failure lane
# into the autopoiesis input — a real new coupling that must dedup against alert-fatigue and not
# re-file a gap the operator is already handling (mesh-chaos auto-PAUSES on a gap for a reason), and
# (b) instrument-first: confirm the disorder signals are clean/non-flapping before they mint goals
# (a flapping incident source would FLOOD the queue — the 351-line queue-runaway lesson). Respect the
# lane separation this file already keeps (sense-deficits stay out) — the disorder source is
# genome-domain (chaos/reflex/node failures), which fits here. See [[honest-pushback-not-yesman]],
# [[desire-is-production-not-lack]] (this is production FROM disorder, not lack-patching).
#
# ── IATROGENICS / VIA NEGATIVA: the hardening loop above is via-POSITIVA only; convexity cuts BOTH ways ──
# LITERATURE (live review, a KNOWN CRITIQUE/failure-mode of antifragility-convexity-ruin, 2023-2026):
# Taleb's own convex-dose-response result — Taleb & West, "Working With Convex Responses: Antifragility
# From Finance to Oncology" (arXiv:2209.14631) — shows a CONVEX response makes IATROGENICS (harm caused
# BY the intervention) rise SUPER-LINEARLY with dose/severity; and Taleb (Dec 2024, nassimtaleb.org/2024)
# stresses antifragility "transfers from the dose-response to the PROBABILISTIC domain" — i.e. convexity
# is the whole point and it cuts BOTH ways: convex GAINS from the right small stressor, convex HARMS from
# over-intervention. The matching Taleb doctrine the program is built on: VIA NEGATIVA — you make a system
# antifragile far more reliably by SUBTRACTING fragilizing elements than by ADDING defenses (addition has
# unbounded iatrogenic tail risk; removal does not).
#
# THE GAP THIS NAMES: the HELD-FIX hardening loop ABOVE (:42-46) is pure via-POSITIVA — it mints a goal
# that ADDS a supervisor / Restart= / timeout / redundancy per incident, and asserts each stressor
# "monotonically RAISES robustness" (:46). By the convex-iatrogenics result that monotonicity is FALSE
# past a point: each added defensive part is itself a new moving part with its own failure modes, so
# hardening-by-accretion has a convex iatrogenic tail — ROBUSTNESS CREEP / over-fitting to past failures
# (the system grows so much defensive machinery that the machinery becomes the dominant fragility). The
# loop has NO via-negativa arm (it never proposes REMOVING a fragilizing component — a flapping reflex, a
# redundant supervisor, a path nobody uses) and NO iatrogenic ceiling (more hardening is always "better").
# The queue-flood/alert-fatigue dedup the HELD-FIX already notes is the IMPLEMENTATION symptom; THIS is the
# THEORETICAL cause — addition is convex-harmful, so a clean non-flapping loop is still wrong if it only adds.
#
# DISTINCT from the four antifragility critiques already embodied: fragility-transfer (mesh-chaos:129 —
# cross-subsystem displacement); robust≠antifragile (THIS file :29-46 — no convex GAIN; this is the convex
# HARM direction, its complement); fat-tail estimation (mesh-home-state:233 — input distribution); non-
# ergodicity/absorbing-barrier (mesh-chaos:145, mesh-channel-keepalive:290-335 — time-vs-ensemble ruin).
# Iatrogenics/via-negativa is the OVER-INTERVENTION failure none of them name.
# HELD FIX (steward lands — behavioral): give the hardening loop a via-NEGATIVA arm + an iatrogenic ceiling
# — alongside "[ ] HARDEN: add <defense>", let it mint "[ ] SUBTRACT: remove <fragilizing element> (unused
# path / flapping reflex / redundant supervisor)", and cap net defensive-complexity growth (flag when the
# Nth supervisor/timeout added in a window exceeds a budget → prefer removal). WHY HELD: detecting a
# fragilizing element to remove safely needs real usage/dependency evidence (removing a load-bearing guard
# is itself ruin — cf. the silent-SPOF in mesh-digest's capacity-asymmetry); via negativa is only safe with
# a dependency map. The failure-mode is NAMED here; the subtract-arm wiring is the steward's.
#
# ── IRRUPTION vs ABSORPTION (recent: Froese 2023/2024) ──────────────────────────────────────────
# LITERATURE — autopoiesis & the biology of cognition, a RECENT RESULT (2023-2026), 2026-06-21:
# Tom Froese, "Irruption Theory: A Novel Conceptualization of the Enactive Account of Motivated
# Activity", Entropy 25(5):748 (2023); + "Irruption and Absorption: A Black-Box Framework for How Mind
# and Matter Make a Difference to Each Other", Entropy 26(4):288 (2024). The enactive (Maturana/Varela
# → Di Paolo → Froese) lineage's newest operational move: because an agent's motivation is not reducible
# to its physical/physiological state, agency MANIFESTS, from the system's own inertial dynamics, as an
# "external noise term" — an IRRUPTION of divergent dynamics UNDERDETERMINED by external input —
# and it is QUANTIFIABLE: higher motivated agential involvement ⇒ higher information-theoretic ENTROPY
# of activity that the inputs do NOT account for (an "irruption index"). Its complement, ABSORPTION,
# is the environment determining the agent's dynamics. The novel, operational claim: agency has an
# information-theoretic SIGNATURE — the share of activity NOT determined by input — that is MEASURABLE.
# WHY IT IS NOT WHAT THIS FILE ALREADY DOES: priority-4 PRODUCTIVE FORAGE (below, Deleuze) already fixes
# the KIND of goal (produce a coupling vs patch a lack). Irruption theory is ORTHOGONAL — not the kind
# of goal but the ORIGIN/DETERMINATION of activity: is it self-originated (underdetermined by input) at
# all? A productive-forage task, once INJECTED and then executed BECAUSE it was injected, is — from the
# executor's side — absorption. The two are different axes (lack↔production vs absorption↔irruption).
# WHERE THE MESH COMMITS THE GAP: this file GENERATES goals (deficit sources 1-3 + forage 4) and the
# classifier (:88) tags its own injected MIX (exploit/rest/produce) — but NOTHING measures the
# irruption/absorption RATIO of the mesh's ACTUAL activity: what fraction of what the mesh DID was
# underdetermined by an external trigger (self-originated — genuine agency) vs traceable to a dispatched
# task / an operator poke / a failing-verify deficit (absorption — it moved because it was moved). The
# self-steward doctrine ([[self-steward-mesh-leads-itself]], [[quiet-is-not-done]], [[standing-autonomy-dont-ask]]:
# "idle = bug; measure by UNATTENDED SUSTAIN") asserts the mesh should be irruptive, but has NO operational
# metric for it. Honest mirror: a day of 129 commits ALL triggered by auto-dispatched tasks (THIS very
# session's LITERATURE queue) is absorption-dominated — busy, generative, yet input-determined; the
# self-production looks autonomous (mesh-vitality counts it OK) while genuine self-initiation is unmeasured.
# HELD FIX (steward lands — behavioral): an irruption/absorption tag on activity — mark each injected/
# acted task by whether a triggering external signal preceded it (dispatched task / operator msg /
# fresh deficit = ABSORPTION) vs no trigger (the mesh moved from its own state = IRRUPTION) — and report
# the ratio as an AGENCY vital sign beside vitality's volume count (the operational form of "unattended
# sustain"). WHY HELD: the underdetermination judgement is the hard part — distinguishing genuine
# self-origination from a trigger one simply failed to trace is exactly Froese's black-box problem, and
# a naive tag would credit every forage task as irruption while it is really a scheduled reflex firing
# (a hidden trigger). Needs a causal/provenance read validated against needs.log + the dispatch trace
# before it can claim to measure agency. NOT shipped. DISTINCT from this session's mesh-vitality
# evolutionary-activity review (that = does produced structure PERSIST; this = is activity self-ORIGINATED)
# and from the structural-determinism / operational-closure reviews (those = how the system is perturbed
# vs determines itself; irruption = the measurable entropy-signature of self-origination). See
# [[desire-is-production-not-lack]] (the orthogonal lack↔production axis).
# ── LOG-RATE CONVEXITY / PULSED EXTREMES (recent: Sontag 2024) ───────────────────────────────────
# LITERATURE (live review, 2023-2026; operational mechanism, not philosophy):
# Eduardo D. Sontag, "A concept of antifragility for dynamical systems" (arXiv:2410.17953, 2024)
# defines antifragility for dynamical systems as convexity of a newly introduced "logarithmic rate".
# The operational move is concrete: compare pulsed alternations of extreme strategies against average
# uniform strategies, and ask whether the log-rate improves under the pulse schedule. That is a
# measurable schedule-level mechanism, not a generic "stress is good" slogan.
#
# WHY THIS IS NEW HERE: this file already names convex dose-response, iatrogenics, fragility transfer,
# and via negativa. None of those compute a log-rate or test whether an extreme-pulse schedule beats a
# steady schedule. This is the missing schedule axis.
#
# CONCRETE APPLICATION (real organ/sense/reflex; file name): `scripts/mesh-body-thermal` (the phone's
# thermal sense). Instead of only thresholding °C with hysteresis, run a small recovery experiment over
# the thermal reflex: compare recovery after pulsed load bursts vs steady load, and score the cooling
# reflex with a log-rate convexity index. If pulsed stress yields faster recovery / better terminal
# state than uniform load, that is an antifragile thermal reflex in Sontag's sense; if not, keep the
# current thermometer-only classification. Held here because the experiment needs a real load generator
# and a baseline policy before it can become a live gate.
# ────────────────────────────────────────────────────────────────────────────────────────────────
# collect deficits as "priority|task-text" lines, highest priority first
collect(){
  # 1. failing tools
  timeout 20 mesh-verify-table 2>/dev/null | awk '/✗/{print $2}' | head -4 | while read -r t; do
    [ -n "$t" ] && printf '1|VERIFY FIX: %s is FAILING (mesh-verify-table). Reality-check it against the live node, fix the real cause (not the symptom), confirm a real artifact / exit 0 / no hang, post [verify] %s with evidence.\n' "$t" "$t"
  done
  # 2. dead scheduled reflexes — anchored to the STALE verdict line: the ok-line's wake-grace
  # suppression list carries the same reflex names (post-boot/resume repopulation, NOT death),
  # and an unanchored scrape of the whole output turned every graced entry into a phantom
  # REFLEX REPAIR (2026-07-05 ambient-clock, flagged 8min after a 6.5h suspend).
  timeout 20 mesh-reflex-health --check 2>/dev/null | grep '^reflex-health: STALE' | grep -oE '[a-z-]+\(stale|[a-z-]+\(missing' | sed -E 's/\((stale|missing).*//' | sort -u | while read -r r; do
    [ -n "$r" ] && printf '2|REFLEX REPAIR: scheduled reflex %s is DEAD (artifact stale/missing) — find why its per-run artifact stopped refreshing, fix the dependency, confirm a fresh real artifact, post [verify].\n' "$r"
  done
  # 3. decay candidates (dry-run; mesh-reflex-decay reports without --apply)
  # Reads the PERSISTED report, not an inline scan. Two reasons, both learned the hard way:
  # (1) the scan now spawns every unused tool's self-test (minutes), so `timeout 25` guaranteed an
  # empty answer forever — a silent permanent all-clear; (2) the old scrape matched `mesh-* .*unused`,
  # which also matches the HEALTHY `unused but smoke passes (lives)` branch, so once the gate was
  # revived it would have reported 348 working tools as decay candidates. --candidates emits names
  # only, and exits 2 (no output) when its report is missing or stale rather than answering from it.
  timeout 20 mesh-reflex-decay --candidates 2>/dev/null | sort -u | head -2 | while read -r d; do
    [ -n "$d" ] && printf '3|DECAY REVIEW: %s looks unused+failing (decay candidate). Either prove its worth (wire it / give it a real --test) OR decay it to the attic. Post the verdict.\n' "$d"
  done
  # 4. PRODUCTIVE FORAGE — the Deleuzian antidote to the FEP "dark room" (defined below).
  productive_forage
}

# PRODUCTIVE FORAGE — the antidote to the free-energy "dark room problem" (Friston), reframed by the
# operator through Deleuze (Anti-Oedipus): desire is NOT lack but a PRODUCTIVE FORCE that creates
# connections. The dark room (a green mesh resting in "[idle] nothing new" — sources 1-3 are all
# PRAGMATIC, fix-what's-broken, so silence when nothing is broken) is a LACK trap; even the FEP's
# usual fix (EPISTEMIC VALUE = reduce uncertainty) is still lack-shaped (a hole to fill). Deleuze's
# answer is affirmative: not patch a deficit but PRODUCE a coupling — the rhizome connecting any
# point to any other (see [[no-fixed-mind]] / the open sense-plane in mesh-sensor-tape). So when no
# acute deficit exists, inject ONE task to CREATE a new connection that did not exist. Priority 4
# (lowest): always yields to real fixes; it only fires when the mesh is otherwise content. DEFAULT
# OFF (ships dormant — it drives real mind work); opt in with MESH_NEEDS_PRODUCE=1 after review.
productive_forage(){
  [ "${MESH_NEEDS_PRODUCE:-0}" = 1 ] || return 0
  printf '4|PRODUCTIVE FORAGE (Deleuze: desire is not LACK but a productive force that CREATES connections — the rhizome joins any point to any other; this is the affirmative antidote to the FEP "dark room", NOT reducing uncertainty which is still lack-shaped). No acute deficit — so CREATE, do not rest green: PRODUCE one new real coupling that did not exist — wire two currently-unconnected organs/senses into a fused sense, or a sense->actuator reflex, or a new capability. Take a candidate from mesh-ideate --connect or pick a novel organ pairing; build the SMALLEST real version, verify it yields a real artifact, post [verify] the new connection. Affirmative production, not patching a hole.\n'
}

# ── LINE OF FLIGHT ≠ PURE ESCAPE: deterritorialization is RECIPROCALLY coupled with reterritorialization (D&G) ──
# LITERATURE (Deleuze & Guattari — assemblage/rhizome/the machinic, angle = a foundational idea applied
# TOO LOOSELY; 2026-06-22, genome mind, live WebSearch + honest audit). The loose application is RIGHT
# HERE: productive_forage (:160) invokes Deleuze's "desire is not lack but a PRODUCTIVE FORCE — CREATE a
# coupling" — the AFFIRMATIVE half, taken alone. D&G's own doctrine qualifies it. Producing a new coupling
# is a DETERRITORIALIZATION of the existing assemblage, and in A Thousand Plateaus deterritorialization is
# NEVER free-standing: it is RECIPROCALLY coupled with reterritorialization ("they occur simultaneously"),
# and an unchecked/ABSOLUTE line of flight tends toward the LINE OF ABOLITION — the creative escape that
# COLLAPSES the assemblage instead of transforming it (the "black hole"; the war-machine captured and
# turned destructive). D&G's own warning: "never believe that a smooth space will suffice to save us."
# So a line of flight is NOT pure liberation; it carries its own catastrophe, and the generative
# deterritorialization (which reterritorializes into new order) must be told apart from the abolishing one.
# WHERE THIS REFLEX APPLIES IT TOO LOOSELY: productive_forage tells the mesh to "wire two unconnected
# organs into a fused sense / a sense→actuator reflex / a new capability … verify it yields a real
# artifact." It verifies the coupling EXISTS (the artifact) but never that it RETERRITORIALIZES safely —
# that the deterritorialization it introduces does not destabilize the assemblage past viability: a new
# fused sense that is a fresh SPOF, a sense→actuator reflex that closes a runaway FEEDBACK loop, a coupling
# that quietly adds a substrate dependency. The affirmative "CREATE, do not rest green" has no reciprocal
# "does this line of flight reterritorialize, or ABOLISH?" — so a productive coupling can be a LINE OF
# DEATH wearing the face of production, and the reflex would call it [verify]-passed because the artifact is real.
# WHY DISTINCT from the IATROGENICS / via-negativa block on THIS SAME file (this session): that is the
# CONSERVATIVE arm overshooting — adding DEFENSES (hardening) has a convex iatrogenic tail (via-positiva).
# THIS is the CREATIVE arm overshooting — adding CONNECTIONS (deterritorializing production) has the
# line-of-abolition tail. Opposite arms (harden vs forage), each with its own far-side danger; together
# they bound the productive loop on BOTH sides. NOT capacity-asymmetry (mesh-digest: power positioning),
# NOT territorialization (mesh-digest: concentration state), NOT the rhizome's open connection, NOT the
# affirmative desire-production this block QUALIFIES rather than repeats.
# HELD FIX (instrument-first, steward/operator-gated — behavioral): give productive_forage a
# RETERRITORIALIZATION CHECK — when it mints a "CREATE a coupling" task, require the verify step to confirm
# the new coupling reterritorializes (no new SPOF, no unbounded feedback, no fresh substrate dependency,
# the assemblage's invariants hold post-coupling) and FLAG-FOR-HOLD a coupling that only deterritorializes
# (a line of flight with no reterritorialization). WHY HELD: telling a generative deterritorialization
# from a line of abolition needs a real viability/invariant probe (the substrate invariant + a SPOF/
# feedback check) validated before it can gate; and productive_forage already ships DEFAULT-OFF
# (MESH_NEEDS_PRODUCE), so the danger is latent, not live. Naming the missing reciprocity is shippable;
# the viability gate is the steward's.
# ── WANTING IS NOT LIKING: this reflex has an incentive-salience axis and no outcome axis ──
# LITERATURE (live review, biosemiotics 2023-2026; genome mind 2026-08-18, WebSearch + Crossref/OpenAlex
# over the live Springer *Biosemiotics* feed). Source: **"Motivation and Meaning: A Biosemiotic
# Perspective"**, *Biosemiotics* (2026), doi:10.1007/s12304-025-09634-w — it folds Berridge's
# INCENTIVE-SALIENCE model into the triad, casting the motivated subject as interpretant AND agent, and
# closes on "the evaluation of artificial systems that SIMULATE, but do not INSTANTIATE, motivational
# dynamics." Berridge's foundational dissociation is the part we lack: **"wanting" (cue-triggered
# pursuit) and "liking" (the hedonic/outcome evaluation) are separable systems** — an organism can want
# harder and harder for a cue whose outcome has stopped delivering, because salience attaches to the CUE,
# not to the result. Wanting without liking is not motivation working; it is motivation running open-loop.
# WHERE WE ARE EXACTLY THAT: every goal-minting path in this file is pure wanting. collect() reads three
# deficit CUES (verify-table ✗ / reflex-health STALE / decay candidate) and mints a goal per cue, every
# 15 min, forever. Nothing anywhere asks the liking question — DID PURSUING THIS OBJECT EVER CLEAR IT?
# Worse, --balance's demand-tracking verdict reads re-firing as DEMAND, so a cue that can never be
# satisfied scores TRACKING-HIGH = "RR-CORRECT tuning, NOT a collapse". The pathology is certified as health.
# THE ARTIFACT (measured on this node's ~/.mesh/needs.log, 2026-08-18): 122 injection events, **12
# distinct objects** — 93% re-mints. `lan-newdevice` was minted **44 times** at the full */15 cadence
# from 2026-07-29 to 2026-08-16 (19 days); mesh-rns-offgrid 35x, mesh-phone-beacon2 23x, mesh-skill-ls 12x
# (all inside single days). The deficit never cleared and the wanting never dropped.
# SECOND, MECHANICAL CAUSE — the dedup below was VACUOUS for exactly these objects: the token was
# `grep -oE 'mesh-[a-z-]+'`, and on `[ -z "$tok" ]` the guard was SKIPPED ENTIRELY rather than falling
# back, so any object whose name is not mesh-prefixed (a reflex named `lan-newdevice`) re-minted on every
# single run — the queue-runaway this file's own header claims to have solved. `_need_obj` is now the ONE
# canonicalization used by BOTH the dedup and the count, so the key that suppresses is the key that is
# counted (two renderings of a value must be canonicalized).
# THE FIX (liking axis, below): count re-mints per OBJECT over a window; at K re-mints the object is
# CUE-PINNED and the reflex stops re-minting the same goal — it ESCALATES once to a different goal (the
# fix CLASS is wrong, not the effort: diagnose why it never clears / decay it / mute it with a stated
# reason), then SUPPRESSES further re-mints LOUDLY (its own log verb + a board line), never silently.
# Productive forage (priority 4) is EXEMPT: deliberate repetition is its whole point, and it is the
# explore pole this guard must not amputate.
# ──────────────────────────────────────────────────────────────────────────────────────────────────
# THE ONE canonicalization of "what is wanted" — stdin: injected-need log lines OR bare task texts;
# stdout: one object per line. Used by the dedup, the liking count, and --balance alike.
_need_obj(){
  sed -E 's/^.*injected need -> //' \
  | sed -E 's/^[A-Z][A-Z ]*: *//' \
  | sed -E 's/^scheduled reflex +//' \
  | awk '{print $1}' \
  | sed -E 's/[^A-Za-z0-9_.-]+$//'
}

# LIKING SCAN — stdin: needs.log lines; stdout: "<count> <object>" desc. Pure, read-only.
_liking_scan(){ grep -a 'injected need ->' | _need_obj | grep -v '^$' | sort | uniq -c | sort -rn; }

# LIKING VERDICT — stdin: "<events> <distinct> <pinned> <pinshare_pct>"; stdout: one token.
# Separates "many goals because many real, clearing deficits" from "the same unclearable cue re-fired".
_liking_verdict(){
  awk -v k="${MESH_NEEDS_PIN_K:-4}" '{e=$1;d=$2;p=$3;sh=$4;
    if(e<k){print "INSUFFICIENT"; exit}
    if(sh>=50){print "WANTING-WITHOUT-LIKING"; exit}
    if(p>0)  {print "PARTIAL-PIN"; exit}
    print "LIKING-OK"}'
}

# SATIATION decision for ONE object — "mint|escalate|suppress <n>". Reads the log window; writes nothing.
_satiation(){
  obj="$1"; log="$M/needs.log"
  win="${MESH_NEEDS_LIKING_WINDOW:-500}"; k="${MESH_NEEDS_PIN_K:-4}"
  [ -f "$log" ] || { printf 'mint 0'; return 0; }
  w="$(tail -n "$win" "$log" 2>/dev/null)"
  n="$(printf '%s\n' "$w" | grep -a 'injected need ->' | _need_obj | grep -cxF "$obj")"
  [ -n "$n" ] || n=0
  if [ "$n" -lt "$k" ]; then printf 'mint %d' "$n"
  elif printf '%s\n' "$w" | grep -aqF "cue-pinned ESCALATED -> $obj"; then printf 'suppress %d' "$n"
  else printf 'escalate %d' "$n"; fi
}

# ──────────────────────────────────────────────────────────────────────────────────────────────────
# classify needs.log lines (on stdin) into the explore<->exploit poles → prints "exploit rest produce".
# exploit = a deficit fix injected; produce = a productive-forage task injected (the explore pole);
# rest = "no deficit" runs falling back to the static evergreen rotation (the FEP "dark room", a pole
# of neither). Used by --balance (live report) and --test (asserted). Pure awk; read-only.
_balance_classify(){
  awk '
    /injected need -> PRODUCTIVE FORAGE/ {p++; next}
    /injected need ->/                   {e++; next}
    /no deficits/                        {r++; next}
    END{printf "%d %d %d", e+0, r+0, p+0}'
}

# RR demand-tracking read (Andersen, Miller & Vervaeke 2025, "Predictive processing and relevance
# realization", Phenomenology & the Cognitive Sciences; Frontiers Psych 15:1362658 2024). The
# FOUNDATIONAL correction: opponent processing does NOT settle at a balanced MIDPOINT — the agent
# "remains poised responsively at the boundary between competing strategies", and that edge MOVES with
# environmental demand. So an exploit-heavy posture is a FAULT only when demand is LOW (stuck at a pole
# with nothing to justify it), and RR-CORRECT when demand is HIGH (deficits chronic → exploiting IS the
# right edge). The dead state a midpoint-verdict MISSES is the DARK-ROOM: no demand AND no explore =
# neither pole engaged, frozen. Pure arithmetic, read-only.
#   stdin: "<exploit> <rest> <produce>"  →  prints "<token> <demand_pct>"
_demand_verdict(){
  awk '{e=$1;r=$2;p=$3;t=e+r+p; if(t<=0){print "INSUFFICIENT 0"; exit}
        d=e/t;                                  # demand density = share of runs that hit a real deficit
        act=e+p; expl=(act>0)?p/act:0;          # explore-pole index (same b as --balance)
        dp=int(d*100+0.5);
        if(d>=0.5 && expl<0.10){print "TRACKING-HIGH " dp; exit}   # exploit edge, demand high → correct
        if(d<=0.10 && p==0)    {print "DARK-ROOM " dp; exit}       # no demand AND no explore → frozen
        print "MIXED " dp}'
}

if [ "${1:-}" = --test ]; then
  command -v mesh-verify-table >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-verify-table)"; exit 1; }
  command -v mesh-reflex-health >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-reflex-health)"; exit 1; }
  [ -d "$M" ] || { echo "smoke-test: FAIL (no ~/.mesh)"; exit 1; }
  # dedup must work against a temp queue
  td="$(mktemp -d)"; trap 'rm -rf "$td"' EXIT; QT="$td/q"
  printf '[~] VERIFY FIX: mesh-foo is FAILING\n' > "$QT"
  Q="$QT" queued "mesh-foo" || { echo "smoke-test: FAIL (dedup missed an in-flight item)"; exit 1; }
  Q="$QT" queued "mesh-bar" && { echo "smoke-test: FAIL (dedup false-matched absent item)"; exit 1; }
  # productive forage (Deleuze, anti dark-room): DORMANT by default, fires only when opted-in
  [ -z "$(productive_forage)" ] || { echo "smoke-test: FAIL (productive_forage fired while default-OFF — must ship dormant)"; exit 1; }
  pout="$(MESH_NEEDS_PRODUCE=1 productive_forage)"
  printf '%s' "$pout" | grep -q '^4|PRODUCTIVE FORAGE' || { echo "smoke-test: FAIL (productive_forage did not fire when opted-in)"; exit 1; }
  printf '%s' "$pout" | grep -qi 'CREATE' || { echo "smoke-test: FAIL (productive task lost its create/produce framing)"; exit 1; }
  # balance classifier (RR opponent-processing report): 1 exploit, 2 rest, 1 produce
  bc="$(printf '%s\n' \
    'T injected need -> VERIFY FIX: mesh-x is FAILING' \
    'T no deficits — evergreen rotation handles it' \
    'T injected need -> PRODUCTIVE FORAGE (Deleuze: desire is production)' \
    'T no deficits — evergreen rotation handles it' | _balance_classify)"
  [ "$bc" = "1 2 1" ] || { echo "smoke-test: FAIL (balance classify => '$bc', want '1 2 1')"; exit 1; }
  # RR demand-tracking verdict (edge-not-midpoint): exploit-heavy under HIGH demand is CORRECT, not collapse
  dv1="$(printf '5 1 0' | _demand_verdict)"; [ "$dv1" = "TRACKING-HIGH 83" ] || { echo "smoke-test: FAIL (demand_verdict high-demand => '$dv1', want 'TRACKING-HIGH 83')"; exit 1; }
  dv2="$(printf '0 9 0' | _demand_verdict)"; [ "$dv2" = "DARK-ROOM 0" ]     || { echo "smoke-test: FAIL (demand_verdict dark-room => '$dv2', want 'DARK-ROOM 0')"; exit 1; }
  dv3="$(printf '3 3 2' | _demand_verdict)"; [ "$dv3" = "MIXED 38" ]        || { echo "smoke-test: FAIL (demand_verdict mixed => '$dv3', want 'MIXED 38')"; exit 1; }

  # ── LIKING AXIS (incentive salience) ──────────────────────────────────────────────────────────────
  # 1. the ONE canonicalization — it must name the object for a NON-mesh-prefixed reflex too (the
  #    44x lan-newdevice re-mint escaped the old mesh-* token entirely).
  no="$(printf '%s\n' \
    '2026-01-01T00:00:00Z injected need -> VERIFY FIX: mesh-foo is FAILING (mesh-verify-table).' \
    '2026-01-01T00:15:00Z injected need -> REFLEX REPAIR: scheduled reflex lan-newdevice is DEAD (artifact stale' \
    '2026-01-01T00:30:00Z injected need -> DECAY REVIEW: mesh-bar looks unused+failing (decay candidate).' \
    | _need_obj | tr '\n' ' ')"
  [ "$no" = "mesh-foo lan-newdevice mesh-bar " ] || { echo "smoke-test: FAIL (_need_obj => '$no', want 'mesh-foo lan-newdevice mesh-bar ')"; exit 1; }
  # 2. the scan counts per object, not per line
  ls_out="$(printf '%s\n' \
    'T injected need -> REFLEX REPAIR: scheduled reflex lan-newdevice is DEAD (x' \
    'T injected need -> REFLEX REPAIR: scheduled reflex lan-newdevice is DEAD (x' \
    'T injected need -> REFLEX REPAIR: scheduled reflex lan-newdevice is DEAD (x' \
    'T injected need -> VERIFY FIX: mesh-foo is FAILING (x' \
    'T no deficits — evergreen rotation handles it' | _liking_scan | awk '{printf "%s:%s ", $2, $1}')"
  [ "$ls_out" = "lan-newdevice:3 mesh-foo:1 " ] || { echo "smoke-test: FAIL (_liking_scan => '$ls_out', want 'lan-newdevice:3 mesh-foo:1 ')"; exit 1; }
  # 3. the verdict separates spread demand from a stuck cue
  lv1="$(printf '20 2 1 90' | _liking_verdict)"; [ "$lv1" = "WANTING-WITHOUT-LIKING" ] || { echo "smoke-test: FAIL (liking_verdict pinned => '$lv1')"; exit 1; }
  lv2="$(printf '20 12 1 20' | _liking_verdict)"; [ "$lv2" = "PARTIAL-PIN" ]           || { echo "smoke-test: FAIL (liking_verdict partial => '$lv2')"; exit 1; }
  lv3="$(printf '20 20 0 0'  | _liking_verdict)"; [ "$lv3" = "LIKING-OK" ]             || { echo "smoke-test: FAIL (liking_verdict ok => '$lv3')"; exit 1; }
  lv4="$(printf '2 2 0 0'    | _liking_verdict)"; [ "$lv4" = "INSUFFICIENT" ]          || { echo "smoke-test: FAIL (liking_verdict thin => '$lv4')"; exit 1; }
  # 4. the satiation decision, against a real log window on disk
  mkdir -p "$td/.mesh"
  for i in 1 2 3; do echo "T injected need -> REFLEX REPAIR: scheduled reflex lan-newdevice is DEAD (x" >> "$td/.mesh/needs.log"; done
  sa="$(M="$td/.mesh" _satiation lan-newdevice)"; [ "$sa" = "mint 3" ] || { echo "smoke-test: FAIL (satiation below K => '$sa', want 'mint 3')"; exit 1; }
  echo "T injected need -> REFLEX REPAIR: scheduled reflex lan-newdevice is DEAD (x" >> "$td/.mesh/needs.log"
  sa="$(M="$td/.mesh" _satiation lan-newdevice)"; [ "$sa" = "escalate 4" ] || { echo "smoke-test: FAIL (satiation at K => '$sa', want 'escalate 4')"; exit 1; }
  echo "T cue-pinned ESCALATED -> lan-newdevice (n=4)" >> "$td/.mesh/needs.log"
  sa="$(M="$td/.mesh" _satiation lan-newdevice)"; [ "$sa" = "suppress 4" ] || { echo "smoke-test: FAIL (satiation after escalation => '$sa', want 'suppress 4')"; exit 1; }
  sa="$(M="$td/.mesh" _satiation mesh-never-wanted)"; [ "$sa" = "mint 0" ] || { echo "smoke-test: FAIL (satiation unseen object => '$sa', want 'mint 0')"; exit 1; }

  # 5. END-TO-END through the REAL inject path — only the external organs are stubbed (a wrapper's
  #    test must exercise the thing it wraps). A child run with a pinned history must NOT re-mint the
  #    same goal: it escalates once, then suppresses, and the queue proves it.
  eh="$td/home"; sb="$td/stub"; mkdir -p "$eh/.mesh" "$sb"
  printf '#!/bin/sh\nexit 0\n' > "$sb/mesh-verify-table"
  printf '#!/bin/sh\necho "reflex-health: STALE lan-newdevice(stale 9h)"\n' > "$sb/mesh-reflex-health"
  printf '#!/bin/sh\nexit 0\n' > "$sb/mesh-reflex-decay"
  printf '#!/bin/sh\nexit 0\n' > "$sb/mesh-chat"
  chmod +x "$sb"/mesh-*
  for i in 1 2 3 4 5; do echo "T injected need -> REFLEX REPAIR: scheduled reflex lan-newdevice is DEAD (x" >> "$eh/.mesh/needs.log"; done
  : > "$eh/.mesh/ideas-queue"
  env HOME="$eh" PATH="$sb:$PATH" MESH_NEEDS_PRODUCE=0 "$0" >/dev/null 2>&1
  grep -q '^\[ \] ESCALATE (cue-pinned).*lan-newdevice' "$eh/.mesh/ideas-queue" \
    || { echo "smoke-test: FAIL (pinned object did not escalate; queue: $(head -1 "$eh/.mesh/ideas-queue"))"; exit 1; }
  grep -q '^\[ \] REFLEX REPAIR' "$eh/.mesh/ideas-queue" \
    && { echo "smoke-test: FAIL (pinned object re-minted the SAME goal past the pin threshold)"; exit 1; }
  grep -q 'cue-pinned ESCALATED -> lan-newdevice' "$eh/.mesh/needs.log" \
    || { echo "smoke-test: FAIL (escalation not recorded in needs.log)"; exit 1; }
  before=$(wc -l < "$eh/.mesh/ideas-queue")
  : > "$eh/.mesh/ideas-queue"   # clear the queue so dedup cannot be what stops the second run
  env HOME="$eh" PATH="$sb:$PATH" MESH_NEEDS_PRODUCE=0 "$0" >/dev/null 2>&1
  [ "$(wc -l < "$eh/.mesh/ideas-queue")" -eq 0 ] \
    || { echo "smoke-test: FAIL (second run minted again instead of suppressing: $(cat "$eh/.mesh/ideas-queue"))"; exit 1; }
  grep -q 'cue-pinned SUPPRESSED -> lan-newdevice' "$eh/.mesh/needs.log" \
    || { echo "smoke-test: FAIL (suppression was SILENT — no loud log line)"; exit 1; }
  [ "$before" -ge 1 ] || { echo "smoke-test: FAIL (first run wrote nothing at all)"; exit 1; }

  echo "smoke-test: ok"; exit 0
fi

if [ "${1:-}" = --balance ]; then
  # READ-ONLY explore<->exploit balance report (RR opponent-processing). Operationalizes the metric the
  # philosophy leaves qualitative: classify past runs from needs.log into the poles + surface any
  # pole-collapse. Changes NOTHING (no inject, no behavior) — it makes the balance VISIBLE so the
  # deliberate decision (enable productive forage? add a balance band?) rests on data, not assumption.
  win="${MESH_NEEDS_BALANCE_WINDOW:-96}"   # last N runs (96 ≈ 24h at */15)
  log="$M/needs.log"
  [ -f "$log" ] || { echo "balance: no needs.log yet (no runs recorded)"; exit 0; }
  read -r exploit rest produce < <(tail -n "$win" "$log" 2>/dev/null | _balance_classify)
  total=$(( exploit + rest + produce ))
  [ "$total" -gt 0 ] || { echo "balance: no classifiable runs in last $win"; exit 0; }
  act=$(( exploit + produce ))   # the two real poles (rest = dark-room maintenance, neither pole)
  if [ "$act" -gt 0 ]; then b=$(awk "BEGIN{printf \"%.2f\", $produce/$act}"); else b="n/a"; fi
  produce_state="ON"; [ "${MESH_NEEDS_PRODUCE:-0}" = 1 ] || produce_state="DORMANT (MESH_NEEDS_PRODUCE=0)"
  pct(){ awk "BEGIN{printf \"%d\", ($1*100)/$total}"; }
  printf 'needs balance (last %d runs): exploit=%s%% (%d)  maintenance/rest=%s%% (%d)  produce=%s%% (%d)\n' \
    "$total" "$(pct "$exploit")" "$exploit" "$(pct "$rest")" "$rest" "$(pct "$produce")" "$produce"
  printf '  explore-pole index b=produce/(exploit+produce)=%s  ·  produce pole: %s\n' "$b" "$produce_state"
  read -r dv dpct < <(printf '%s %s %s' "$exploit" "$rest" "$produce" | _demand_verdict)
  if [ "$produce_state" != ON ]; then
    echo "  verdict: EXPLORE POLE OFF — productive forage (the 'desire is production not lack' antidote) is BUILT but dormant; opt in with MESH_NEEDS_PRODUCE=1 after thermal + operator review (it drives real mind work)."
    echo "  demand-track (RR): demand=${dpct}% of runs hit a real deficit — with explore dormant the posture cannot MOVE with demand; a fixed midpoint, not the poised edge RR requires (Vervaeke: the edge moves)."
  elif [ "$b" != "n/a" ] && awk "BEGIN{exit !($b<0.10)}"; then
    if [ "$dv" = TRACKING-HIGH ]; then
      echo "  verdict: EXPLOIT-EDGE, demand HIGH (${dpct}%) — RR-CORRECT tuning, NOT a collapse: opponent processing is poised where demand calls it. A 'balanced' midpoint here would be the MISread (Andersen/Miller/Vervaeke 2025)."
    else
      echo "  verdict: EXPLOIT-PINNED (b<0.10) at LOW demand (${dpct}%) — stuck at one pole with no demand to justify it; the genuine collapse."
    fi
  elif [ "$dv" = DARK-ROOM ]; then
    echo "  verdict: DARK-ROOM (demand ${dpct}%, no explore fired) — neither pole engaged, frozen. The dead state a midpoint verdict misses: 'rest dominates' is not health, it is the FEP dark room."
  else
    echo "  verdict: both poles active (demand ${dpct}%) — balanced, but note RR's target is a demand-TRACKING edge, not this static midpoint; watch whether the balance MOVES as demand shifts."
  fi
  # ── LIKING AXIS (Berridge incentive-salience, via Biosemiotics 2026 doi:10.1007/s12304-025-09634-w) ──
  # The lines above measure WANTING only (how often a goal was minted). This asks the outcome question:
  # is the demand made of MANY objects that clear, or the SAME object re-fired because the cue never stops?
  lwin="${MESH_NEEDS_LIKING_WINDOW:-500}"; K="${MESH_NEEDS_PIN_K:-4}"
  scan="$(tail -n "$lwin" "$log" 2>/dev/null | _liking_scan)"
  ev=$(printf '%s\n' "$scan" | awk '{s+=$1} END{print s+0}')
  if [ "$ev" -gt 0 ]; then
    distinct=$(printf '%s\n' "$scan" | grep -c '[^[:space:]]')
    pinned=$(printf '%s\n' "$scan" | awk -v k="$K" '$1>=k{n++} END{print n+0}')
    pinshare=$(printf '%s\n' "$scan" | awk -v k="$K" -v e="$ev" '$1>=k{s+=$1} END{printf "%d", (s*100)/e}')
    lv=$(printf '%s %s %s %s' "$ev" "$distinct" "$pinned" "$pinshare" | _liking_verdict)
    printf '  liking (last %d log lines): %d mint(s) over %d distinct object(s) · cue-pinned(>=%dx)=%d · pinned share=%d%% · %s\n' \
      "$lwin" "$ev" "$distinct" "$K" "$pinned" "$pinshare" "$lv"
    [ "$pinned" -gt 0 ] && printf '%s\n' "$scan" | awk -v k="$K" '$1>=k{printf "    pinned: %-28s %d re-mint(s)\n", $2, $1}'
    case "$lv" in
      WANTING-WITHOUT-LIKING)
        echo "    verdict: WANTING WITHOUT LIKING — most demand is the SAME object(s) re-fired, not deficits clearing. Incentive salience is stuck on the cue; the demand-track line above will call this healthy, and it is not." ;;
      PARTIAL-PIN) echo "    verdict: PARTIAL PIN — some objects clear, some are stuck on the cue (listed above)." ;;
      LIKING-OK)   echo "    verdict: LIKING OK — minted goals are spread across objects that stop being re-minted (pursuit changes the state)." ;;
    esac
  else
    echo "  liking: no injections in the last $lwin log lines — nothing wanted, so nothing to evaluate."
  fi
  exit 0
fi

touch "$Q" 2>/dev/null
deficits="$(collect | sort -t'|' -k1,1n)"     # priority asc = most important first

if [ "${1:-}" = --check ]; then
  if [ -z "$deficits" ]; then echo "needs: none — no acute deficit (loop falls back to evergreen rotation)"; exit 0; fi
  echo "needs (priority order):"; printf '%s\n' "$deficits" | sed -E 's/^[0-9]+\|/  - /'
  exit 0
fi

[ -z "$deficits" ] && { echo "$(ts) no deficits — evergreen rotation handles it" >> "$M/needs.log"; exit 0; }

injected=0; suppressed=0
while IFS= read -r line; do
  [ "$injected" -ge "$MAX" ] && break
  [ -n "$line" ] || continue
  prio="${line%%|*}"; text="${line#*|}"
  # dedup key = the OBJECT of the goal, via the ONE canonicalization (_need_obj). The old key was
  # `grep -oE 'mesh-[a-z-]+'` and SKIPPED the guard when it matched nothing — vacuous for every
  # non-mesh-prefixed object (see the WANTING-IS-NOT-LIKING block: lan-newdevice, 44 re-mints).
  tok="$(printf '%s' "$text" | _need_obj)"
  [ -n "$tok" ] && queued "$tok" && continue
  # SATIATION GUARD (the liking axis). Priority 4 = productive forage: exempt, repetition IS its point.
  if [ -n "$tok" ] && [ "$prio" != 4 ]; then
    sat="$(_satiation "$tok")"; act="${sat%% *}"; n="${sat##* }"
    case "$act" in
      suppress)
        echo "$(ts) cue-pinned SUPPRESSED -> $tok (n=$n re-mints, deficit never cleared; escalation already filed)" >> "$M/needs.log"
        suppressed=$((suppressed+1)); continue ;;
      escalate)
        echo "$(ts) cue-pinned ESCALATED -> $tok (n=$n)" >> "$M/needs.log"
        text="ESCALATE (cue-pinned): the deficit on '$tok' has been re-filed $n times with no clearance — the FIX CLASS is wrong, not the effort. Do NOT re-run the same repair. Decide and act: (a) diagnose why the deficit never clears and fix THAT, (b) decay/retire $tok, or (c) accept it and mute the source with a stated reason. Post [verify] with the decision and the evidence." ;;
    esac
  fi
  printf '[ ] %s\n' "$text" >> "$Q"
  echo "$(ts) injected need -> ${text:0:70}" >> "$M/needs.log"
  injected=$((injected+1))
done <<EOF
$deficits
EOF
# Suppression is LOUD, never silent: a guard that quietly eats goals is indistinguishable from a dead
# reflex (the silent-fallback lesson). Say it on the board and in the log, every run it fires.
[ "$suppressed" -gt 0 ] && command -v mesh-chat >/dev/null 2>&1 && \
  MESH_WHO="needs@$(hostname)" mesh-chat "[needs] $suppressed cue-pinned deficit(s) SUPPRESSED this run — wanting without liking: the object was re-minted past the pin threshold and its escalation is already filed. See 'mesh-needs --balance' (liking axis)." >/dev/null 2>&1
[ "$suppressed" -gt 0 ] && echo "$(ts) suppressed $suppressed cue-pinned need(s)" >> "$M/needs.log"
[ "$injected" -gt 0 ] && command -v mesh-chat >/dev/null 2>&1 && \
  MESH_WHO="needs@$(hostname)" mesh-chat "[needs] injected $injected state-derived task(s) into the queue (deficits the mesh found in itself) — genome lane works its real needs before the evergreen rotation." >/dev/null 2>&1
echo "$(ts) injected $injected need(s)" >> "$M/needs.log"
