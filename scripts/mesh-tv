#!/usr/bin/env bash
# mesh-tv — send YouTube/video URL to TV via UPnP/DLNA; control playback
# Usage:
#   mesh-tv <url>          download + play on TV (Sony Bravia)
#   mesh-tv pause          pause
#   mesh-tv play           resume
#   mesh-tv stop           stop
#   mesh-tv status         current transport state
#   mesh-tv --discover     SSDP-discover MediaRenderer IP and save to ~/.mesh/nodes
#   mesh-tv --test         smoke test
# Telegram: /meshtv <url|pause|play|stop|status>
set -uo pipefail
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
export PATH="$HOME/.local/bin:$PATH"

TV_IP="${MESH_TV_IP:-192.168.8.130}"
TV_PORT="${MESH_TV_PORT:-52323}"
CTRL_URL="http://${TV_IP}:${TV_PORT}/upnp/control/AVTransport"
TV_DIR="$HOME/.mesh/tv"
HTTP_PORT="${MESH_TV_HTTP_PORT:-8099}"
# IdeaPad LAN IP for serving files to TV
NODE_LAN_IP="${MESH_NODE_LAN_IP:-$(ip -4 addr show | grep -oP '(?<=inet )192\.168\.[0-9]+\.[0-9]+' | head -1)}"

mkdir -p "$TV_DIR"

AV_NS="urn:schemas-upnp-org:service:AVTransport:1"

_soap() { # action fields_json
  python3 - "$CTRL_URL" "$AV_NS" "$1" "$2" << 'PY'
import sys, urllib.request, json
ctrl, ns, action, fields_json = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
fields = json.loads(fields_json)
def esc(s): return s.replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace('"',"&quot;")
body = ('<?xml version="1.0"?>'
    '<s:Envelope xmlns:s="http://schemas.xmlsoap.org/soap/envelope/"'
    ' s:encodingStyle="http://schemas.xmlsoap.org/soap/encoding/">'
    '<s:Body>'
    f'<u:{action} xmlns:u="{ns}">'
    + "".join(f"<{k}>{v}</{k}>" for k,v in fields.items()) +
    f'</u:{action}>'
    '</s:Body></s:Envelope>')
req = urllib.request.Request(ctrl, data=body.encode("utf-8"),
    headers={"Content-Type": 'text/xml; charset="utf-8"',
             "SOAPAction": f'"{ns}#{action}"', "Connection": "close"},
    method="POST")
try:
    with urllib.request.urlopen(req, timeout=10) as r:
        print(r.read().decode(errors="replace"))
        sys.exit(0)
except Exception as e:
    print(f"SOAP error: {e}", file=sys.stderr); sys.exit(1)
PY
}

# DLNA-capable media server. The bare `python3 -m http.server` speaks HTTP/1.0 and
# IGNORES Range requests (returns 200 + whole file), which makes a 2013 Bravia abort
# the stream → "playback impossible" (operator 2026-06-17). This replacement speaks
# HTTP/1.1, honors byte ranges (206 Partial Content), advertises Accept-Ranges, and
# sends the DLNA contentFeatures/transferMode headers old TVs check before playing.
_serve_py() { cat > "$TV_DIR/serve.py" << 'PYEOF'
import http.server, os, re, sys
DIR, PORT, BIND = sys.argv[1], int(sys.argv[2]), sys.argv[3]
DLNA_FLAGS = "DLNA.ORG_OP=01;DLNA.ORG_CI=0;DLNA.ORG_FLAGS=01700000000000000000000000000000"
class H(http.server.BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"
    def _path(self):
        return os.path.join(DIR, os.path.basename(self.path.split("?",1)[0]))
    def _common(self):
        self.send_header("Accept-Ranges", "bytes")
        self.send_header("Content-Type", "video/mp4")
        self.send_header("transferMode.dlna.org", "Streaming")
        self.send_header("contentFeatures.dlna.org", DLNA_FLAGS)
    def do_HEAD(self):
        p = self._path()
        if not os.path.isfile(p): self.send_error(404); return
        size = os.path.getsize(p)
        self.send_response(200); self._common()
        self.send_header("Content-Length", str(size)); self.end_headers()
    def do_GET(self):
        p = self._path()
        if not os.path.isfile(p): self.send_error(404); return
        size = os.path.getsize(p)
        rng = self.headers.get("Range")
        m = re.match(r"bytes=(\d*)-(\d*)", rng or "")
        if m:
            start = int(m.group(1)) if m.group(1) else 0
            end = int(m.group(2)) if m.group(2) else size - 1
            end = min(end, size - 1)
            if start > end or start >= size:
                self.send_response(416); self.send_header("Content-Range", f"bytes */{size}")
                self.end_headers(); return
            self.send_response(206); self._common()
            self.send_header("Content-Range", f"bytes {start}-{end}/{size}")
        else:
            start, end = 0, size - 1
            self.send_response(200); self._common()
        length = end - start + 1
        self.send_header("Content-Length", str(length)); self.end_headers()
        if self.command == "HEAD": return
        with open(p, "rb") as f:
            f.seek(start); remaining = length
            while remaining > 0:
                chunk = f.read(min(262144, remaining))
                if not chunk: break
                try: self.wfile.write(chunk)
                except (BrokenPipeError, ConnectionResetError): break
                remaining -= len(chunk)
    def log_message(self, *a): pass
http.server.ThreadingHTTPServer((BIND, PORT), H).serve_forever()
PYEOF
}
_ensure_server() {
  # Kill any stale bare http.server (HTTP/1.0, no Range) that an older mesh-tv left running.
  pgrep -f "http.server ${HTTP_PORT}" >/dev/null 2>&1 && pkill -f "http.server ${HTTP_PORT}" 2>/dev/null
  pgrep -f "serve.py .*${HTTP_PORT}" >/dev/null 2>&1 && return 0
  _serve_py
  python3 "$TV_DIR/serve.py" "$TV_DIR" "$HTTP_PORT" "$NODE_LAN_IP" &>/tmp/mesh-tv-http.log &
  sleep 1
  pgrep -f "serve.py .*${HTTP_PORT}" >/dev/null 2>&1 \
    || { echo "[mesh-tv] HTTP server failed to start"; cat /tmp/mesh-tv-http.log 2>/dev/null | tail -3; return 1; }
}

# Read the TV's current transport state (PLAYING/PAUSED_PLAYBACK/STOPPED/TRANSITIONING).
_tv_state() {
  _soap "GetTransportInfo" '{"InstanceID":"0"}' 2>/dev/null \
    | grep -oE 'CurrentTransportState>[^<]+' | sed 's/CurrentTransportState>//' | head -1
}

CMD="${1:-}"
case "$CMD" in
  pause)
    # Sony Bravia AVTransport returns a SOAP 500 fault on Pause yet still pauses — so
    # trust the RESULTING transport state, not the HTTP code (operator 2026-06-17: "add pause").
    _soap "Pause" '{"InstanceID":"0"}' >/dev/null 2>&1; sleep 1
    case "$(_tv_state)" in
      PAUSED_PLAYBACK) echo "[mesh-tv] paused" ;;
      *) echo "[mesh-tv] pause failed (state=$(_tv_state))" ;;
    esac
    ;;
  play)
    _soap "Play" '{"InstanceID":"0","Speed":"1"}' >/dev/null 2>&1; sleep 1
    case "$(_tv_state)" in
      PLAYING|TRANSITIONING) echo "[mesh-tv] resumed" ;;
      *) echo "[mesh-tv] play failed (state=$(_tv_state))" ;;
    esac
    ;;
  stop)
    _soap "Stop" '{"InstanceID":"0"}' >/dev/null 2>&1; sleep 1
    case "$(_tv_state)" in
      STOPPED|NO_MEDIA_PRESENT|"") echo "[mesh-tv] stopped" ;;
      *) echo "[mesh-tv] stop failed (state=$(_tv_state))" ;;
    esac
    ;;
  status)
    s="$(_tv_state)"; echo "${s:-unknown}"
    ;;
  --discover)
    python3 << 'PY' || { echo "SSDP failed"; exit 1; }
import socket, re, json, os, sys, time
sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM, socket.IPPROTO_UDP)
sock.settimeout(4)
sock.setsockopt(socket.IPPROTO_IP, socket.IP_MULTICAST_TTL, 2)
msg = ("M-SEARCH * HTTP/1.1\r\nHOST: 239.255.255.250:1900\r\n"
       'MAN: "ssdp:discover"\r\nMX: 3\r\n'
       "ST: urn:schemas-upnp-org:device:MediaRenderer:1\r\n\r\n")
sock.sendto(msg.encode(), ("239.255.255.250", 1900))
devices = {}
try:
    while True:
        data, addr = sock.recvfrom(4096)
        text = data.decode(errors="replace")
        loc = (re.search(r'Location:\s*(.+)', text, re.I) or [None])[0]
        if loc:
            u = __import__("urllib.parse").urlparse(loc.strip())
            ip = u.hostname or addr[0]
            devices.setdefault(ip, {"ip": ip, "port": u.port or 80, "location": loc.strip(),
                "server": (re.search(r'Server:\s*(.+)', text, re.I) or [""])[0]})
except socket.timeout: pass
if not devices:
    print("No MediaRenderer found"); sys.exit(1)
for d in devices.values():
    print(f"  {d['ip']}:{d['port']}  {d.get('server','')}")
cfg = os.path.expanduser("~/.mesh/nodes")
ip = list(devices.values())[0]["ip"]
if os.path.isfile(cfg):
    with open(cfg) as f:
        lines = [l for l in f if not l.startswith("TV_IP=")]
    lines.append(f"TV_IP={ip}\n")
    with open(cfg, "w") as f: f.writelines(lines)
    print(f"Saved TV_IP={ip} to {cfg}")
PY
    ;;
  --test)
    nc -z -w3 "$TV_IP" "$TV_PORT" 2>/dev/null || { echo "smoke-test: n/a (TV $TV_IP:$TV_PORT unreachable — not a TV node)"; exit 2; }
    command -v yt-dlp >/dev/null 2>&1 || { echo "smoke-test: n/a (yt-dlp not installed — not a TV node)"; exit 2; }
    echo "smoke-test: ok (TV=$TV_IP:$TV_PORT yt-dlp=ok)"
    ;;
  "")
    echo "usage: mesh-tv <url|pause|play|stop|status|--discover|--test>"; exit 1
    ;;
  *)
    URL="$CMD"
    # Log every play invocation so restarts are detectable
    printf '%s [mesh-tv] play: %s (caller: %s)\n' \
      "$(date -u +%Y-%m-%dT%H:%MZ)" "$URL" "${PPID:-?}" \
      >> "$HOME/.mesh/tv-plays.log"
    YTDLP="$HOME/.local/bin/yt-dlp"
    [ -x "$YTDLP" ] || YTDLP="yt-dlp"
    command -v "$YTDLP" >/dev/null 2>&1 || { echo "[mesh-tv] yt-dlp not found"; exit 1; }

    # Resolve youtu.be short links
    URL=$(python3 -c "
import sys,re; u=sys.argv[1]
u=re.sub(r'youtu\\.be/([^?&]+)',r'youtube.com/watch?v=\\1',u)
print(u)" "$URL" 2>/dev/null || echo "$URL")

    echo "[mesh-tv] downloading: $URL"
    TITLE=$("$YTDLP" --get-title --no-playlist "$URL" 2>/dev/null || echo "Video")
    # Quality tuned for a 2013 Sony Bravia (KDL-42W653A): a SINGLE PROGRESSIVE H.264
    # (avc) MP4 capped at 720p. Operator 2026-06-17: "forget 1080p, 720p is fine — the
    # issue is how it plays on this TV." The old set can't decode VP9/AV1 and chokes on
    # high-bitrate 1080p; YouTube's progressive (pre-muxed audio+video) formats top out
    # at 720p (itag 22) anyway, which is exactly what an AVTransport push needs (no DASH).
    FMT="best[ext=mp4][vcodec^=avc][height<=720]/best[ext=mp4][height<=720]/best[height<=720]/best[ext=mp4]/best"
    # Download to now.mp4. --no-continue: always start fresh (no stale .part hijack).
    rm -f "$TV_DIR/now.mp4" "$TV_DIR/now.mp4.part"
    "$YTDLP" -f "$FMT" --no-playlist --no-continue -o "$TV_DIR/now.mp4" "$URL" \
      --newline -q --progress 2>&1 | tail -3
    [ -s "$TV_DIR/now.mp4" ] || { echo "[mesh-tv] download failed"; exit 1; }

    # faststart remux: relocate the moov atom to the FRONT of the file. yt-dlp leaves it
    # at the end, so a progressive-streaming DLNA TV can't begin playback until the whole
    # file arrives — on an old Bravia that surfaces as "playback impossible". A copy-only
    # remux (no re-encode, ~1s) fixes it. Best-effort: skip cleanly if ffmpeg is absent.
    if command -v ffmpeg >/dev/null 2>&1; then
      if ffmpeg -v error -y -i "$TV_DIR/now.mp4" -c copy -movflags +faststart \
           "$TV_DIR/now.fs.mp4" </dev/null 2>/dev/null && [ -s "$TV_DIR/now.fs.mp4" ]; then
        mv -f "$TV_DIR/now.fs.mp4" "$TV_DIR/now.mp4"
        echo "[mesh-tv] faststart: moov relocated to front (progressive-stream ready)"
      else
        rm -f "$TV_DIR/now.fs.mp4"
        echo "[mesh-tv] faststart: skipped (ffmpeg remux failed — serving as-is)"
      fi
    fi

    _ensure_server || exit 1

    # Always play immediately — new URL always interrupts whatever is on.
    SRV_URL="http://${NODE_LAN_IP}:${HTTP_PORT}/now.mp4"
    DIDL="$(python3 -c "
import sys
t,u=sys.argv[1],sys.argv[2]
def e(s): return s.replace('&','&amp;').replace('<','&lt;').replace('>','&gt;').replace('\"','&quot;')
print('<DIDL-Lite xmlns=\"urn:schemas-upnp-org:metadata-1-0/DIDL-Lite/\" xmlns:dc=\"http://purl.org/dc/elements/1.1/\" xmlns:upnp=\"urn:schemas-upnp-org:metadata-1-0/upnp/\"><item id=\"0\" parentID=\"0\" restricted=\"1\"><dc:title>'+e(t)+'</dc:title><upnp:class>object.item.videoItem</upnp:class><res protocolInfo=\"http-get:*:video/mp4:*\">'+e(u)+'</res></item></DIDL-Lite>')" "$TITLE" "$SRV_URL" 2>/dev/null)"
    _soap "SetAVTransportURI" "$(python3 -c "
import sys,json
u,d=sys.argv[1],sys.argv[2]
def e(s): return s.replace('&','&amp;').replace('<','&lt;').replace('>','&gt;').replace('\"','&quot;')
print(json.dumps({'InstanceID':'0','CurrentURI':e(u),'CurrentURIMetaData':e(d)}))" "$SRV_URL" "$DIDL")" >/dev/null \
      || { echo "[mesh-tv] SetAVTransportURI failed"; exit 1; }
    _soap "Play" '{"InstanceID":"0","Speed":"1"}' >/dev/null \
      || { echo "[mesh-tv] Play failed"; exit 1; }
    # Update url-watch dedup so mesh-url-watch cron skips this URL for 600s.
    # Prevents double-play when operator sends /mesh-tv and the cron also picks up the same log line.
    printf '%s\n%s\n' "$URL" "$(date +%s)" > "$HOME/.mesh/.url-watch-lastfired"
    echo "[mesh-tv] playing: $TITLE"
    ;;
esac
