#!/usr/bin/env python3
"""mesh-tv — send a YouTube/video URL to a Sony Bravia TV (DLNA AVTransport).

Usage:
  mesh-tv <url>          play URL on TV (yt-dlp resolves YouTube to direct stream)
  mesh-tv --discover     discover DLNA MediaRenderer on LAN, print IP
  mesh-tv --test         smoke test (deps check; no connection)
  mesh-tv --stop         stop playback (AVTransport Stop)

Discovery: SSDP on LAN → first UPnP MediaRenderer found (any brand).
Override TV IP: TV_IP env var or ~/.mesh/tv.conf.
Sony Bravia DLNA (port from SSDP). No pairing popup — DLNA is open.

YouTube → yt-dlp extracts a direct H.264/MP4 CDN URL the TV plays natively.
Any direct video URL is passed through unchanged.

Exit: 0 = ok; 1 = error; 2 = TV not found/reachable.
"""
import os, sys, json, socket, struct, time, subprocess, urllib.request, urllib.parse
import xml.etree.ElementTree as ET

def _load_env():
    p = os.path.expanduser("~/.mesh/nodes")
    if os.path.exists(p):
        with open(p) as f:
            for line in f:
                line = line.strip()
                if "=" in line and not line.startswith("#"):
                    k, v = line.split("=", 1)
                    k = k.strip(); v = v.strip().strip('"').strip("'")
                    if k and k not in os.environ:
                        os.environ[k] = v
_load_env()

TV_CONF = os.path.expanduser("~/.mesh/tv.conf")
HOST = socket.gethostname()
MESH_DIR = os.path.expanduser("~/.mesh")

def _trace(msg):
    t = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    line = f"{t}  mesh-tv@{HOST}  ::  {msg}"
    os.makedirs(MESH_DIR, exist_ok=True)
    with open(os.path.join(MESH_DIR, "traces.log"), "a") as f:
        f.write(line + "\n")

def _tv_conf():
    """Return (ip, port, ctrl_url) from env/conf, or (None,None,None)."""
    ip = os.environ.get("TV_IP", "")
    port = int(os.environ.get("TV_PORT", "0") or 0)
    ctrl = os.environ.get("TV_CTRL", "")
    if not ip and os.path.exists(TV_CONF):
        with open(TV_CONF) as f:
            for line in f:
                line = line.strip()
                if "=" in line and not line.startswith("#"):
                    k, v = line.split("=", 1); k = k.strip(); v = v.strip().strip('"')
                    if k == "TV_IP": ip = v
                    elif k == "TV_PORT": port = int(v or 0)
                    elif k == "TV_CTRL": ctrl = v
    return (ip or None, port or None, ctrl or None)

def _save_tv_conf(ip, port, ctrl):
    os.makedirs(MESH_DIR, exist_ok=True)
    with open(TV_CONF, "w") as f:
        f.write(f"TV_IP={ip}\nTV_PORT={port}\nTV_CTRL={ctrl}\n")

def discover_dlna(timeout=10):
    """SSDP M-SEARCH for UPnP MediaRenderer. Returns (ip, port, ctrl_url) or (None,None,None)."""
    SSDP = "239.255.255.250"; PORT = 1900
    msg = (b"M-SEARCH * HTTP/1.1\r\n"
           b"HOST: 239.255.255.250:1900\r\n"
           b"MAN: \"ssdp:discover\"\r\n"
           b"MX: 3\r\n"
           b"ST: urn:schemas-upnp-org:device:MediaRenderer:1\r\n\r\n")
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    s.settimeout(timeout)
    s.sendto(msg, (SSDP, PORT))
    deadline = time.time() + timeout
    while time.time() < deadline:
        try:
            data, addr = s.recvfrom(4096)
            txt = data.decode("utf-8", "replace")
            # extract LOCATION header
            loc = ""
            for line in txt.splitlines():
                if line.lower().startswith("location:"):
                    loc = line.split(":", 1)[1].strip()
                    break
            if not loc:
                continue
            parsed = urllib.parse.urlparse(loc)
            ip = parsed.hostname; port = parsed.port or 80
            # fetch device description XML to find AVTransport control URL
            try:
                with urllib.request.urlopen(loc, timeout=6) as r:
                    xml_data = r.read()
            except Exception:
                continue
            ctrl = _find_avtransport_ctrl(xml_data, loc)
            if ctrl:
                return (ip, port, ctrl)
        except socket.timeout:
            break
        except Exception:
            pass
    return (None, None, None)

def _find_avtransport_ctrl(xml_data, base_url):
    """Parse UPnP device description, return AVTransport controlURL (absolute)."""
    try:
        ns = {"u": "urn:schemas-upnp-org:device-1-0"}
        root = ET.fromstring(xml_data)
        for svc in root.iter():
            if svc.tag.endswith("serviceType") and "AVTransport" in (svc.text or ""):
                parent = svc.getparent() if hasattr(svc, "getparent") else None
                # iterate siblings — ET doesn't have getparent, walk the tree
                pass
        # walk all service elements
        for svc in root.iter():
            if not svc.tag.endswith("service"):
                continue
            stype = svc.find(".//{urn:schemas-upnp-org:device-1-0}serviceType")
            if stype is None: stype = svc.find(".//serviceType")
            if stype is None: stype = svc.find("serviceType")
            sctrl = svc.find(".//{urn:schemas-upnp-org:device-1-0}controlURL")
            if sctrl is None: sctrl = svc.find(".//controlURL")
            if sctrl is None: sctrl = svc.find("controlURL")
            if stype is not None and "AVTransport" in (stype.text or "") and sctrl is not None:
                ctrl = (sctrl.text or "").strip()
                if ctrl.startswith("http"):
                    return ctrl
                # relative → absolute
                parsed = urllib.parse.urlparse(base_url)
                base = f"{parsed.scheme}://{parsed.netloc}"
                return base + (ctrl if ctrl.startswith("/") else "/" + ctrl)
    except Exception as e:
        pass
    # Try namespace-less and stripped variants
    try:
        txt = xml_data.decode("utf-8", "replace")
        # strip namespace prefixes for simpler parsing
        import re
        txt2 = re.sub(r' xmlns[^"]*"[^"]*"', "", txt)
        txt2 = re.sub(r'<[a-zA-Z0-9_]+:', "<", txt2)
        txt2 = re.sub(r'</[a-zA-Z0-9_]+:', "</", txt2)
        root2 = ET.fromstring(txt2)
        for svc in root2.iter("service"):
            stype = svc.findtext("serviceType") or ""
            ctrl = svc.findtext("controlURL") or ""
            if "AVTransport" in stype and ctrl:
                if ctrl.startswith("http"):
                    return ctrl
                parsed = urllib.parse.urlparse(base_url)
                base = f"{parsed.scheme}://{parsed.netloc}"
                return base + (ctrl if ctrl.startswith("/") else "/" + ctrl)
    except Exception:
        pass
    return None

def _soap(ctrl_url, action_ns, action, body_fields):
    """POST a UPnP SOAP action. Returns (ok, response_text)."""
    fields_xml = "".join(f"<{k}>{v}</{k}>" for k, v in body_fields.items())
    soap_body = (
        '<?xml version="1.0"?>'
        '<s:Envelope xmlns:s="http://schemas.xmlsoap.org/soap/envelope/"'
        ' s:encodingStyle="http://schemas.xmlsoap.org/soap/encoding/">'
        '<s:Body>'
        f'<u:{action} xmlns:u="{action_ns}">'
        f'{fields_xml}'
        f'</u:{action}>'
        '</s:Body></s:Envelope>'
    )
    headers = {
        "Content-Type": 'text/xml; charset="utf-8"',
        "SOAPAction": f'"{action_ns}#{action}"',
        "Connection": "close",
    }
    req = urllib.request.Request(ctrl_url, data=soap_body.encode("utf-8"), headers=headers, method="POST")
    try:
        with urllib.request.urlopen(req, timeout=10) as r:
            return (True, r.read().decode("utf-8", "replace"))
    except urllib.error.HTTPError as e:
        return (False, f"HTTP {e.code}: {e.read().decode('utf-8','replace')[:200]}")
    except Exception as e:
        return (False, str(e))

DIDL_TMPL = (
    '<DIDL-Lite xmlns="urn:schemas-upnp-org:metadata-1-0/DIDL-Lite/"'
    ' xmlns:dc="http://purl.org/dc/elements/1.1/"'
    ' xmlns:upnp="urn:schemas-upnp-org:metadata-1-0/upnp/">'
    '<item id="0" parentID="0" restricted="1">'
    '<dc:title>{title}</dc:title>'
    '<upnp:class>object.item.videoItem</upnp:class>'
    '<res protocolInfo="http-get:*:video/mp4:*">{uri}</res>'
    '</item></DIDL-Lite>'
)

def _escape_xml(s):
    return s.replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace('"',"&quot;")

def _didl(uri, title="Video"):
    return DIDL_TMPL.format(uri=_escape_xml(uri), title=_escape_xml(title))

AV_NS = "urn:schemas-upnp-org:service:AVTransport:1"

def dlna_play(ctrl_url, media_url, title="Video"):
    """SetAVTransportURI + Play. Returns True on success."""
    ok, resp = _soap(ctrl_url, AV_NS, "SetAVTransportURI", {
        "InstanceID": "0",
        "CurrentURI": _escape_xml(media_url),
        "CurrentURIMetaData": _escape_xml(_didl(media_url, title)),
    })
    if not ok:
        print(f"[mesh-tv] SetAVTransportURI failed: {resp}", file=sys.stderr)
        return False
    ok2, resp2 = _soap(ctrl_url, AV_NS, "Play", {"InstanceID": "0", "Speed": "1"})
    if not ok2:
        print(f"[mesh-tv] Play failed: {resp2}", file=sys.stderr)
        return False
    return True

def dlna_stop(ctrl_url):
    ok, resp = _soap(ctrl_url, AV_NS, "Stop", {"InstanceID": "0"})
    return ok

def resolve_url(url):
    """If YouTube/Vimeo/etc, use yt-dlp to get a direct H.264 MP4 URL the TV can play."""
    video_sites = ("youtube.com", "youtu.be", "vimeo.com", "rutube.ru")
    is_video_site = any(s in url for s in video_sites)
    if not is_video_site:
        return url, os.path.basename(urllib.parse.urlparse(url).path) or "Video"
    ytdlp = os.path.expanduser("~/.local/bin/yt-dlp")
    if not os.path.exists(ytdlp):
        ytdlp = "yt-dlp"
    # best single-file H.264+AAC MP4 (old TV, no VP9, no separate DASH streams)
    fmt = "best[ext=mp4][vcodec^=avc]/best[ext=mp4]/best[protocol=https]/best"
    try:
        r = subprocess.run(
            [ytdlp, "-f", fmt, "--get-url", "--get-title", "--no-playlist", url],
            capture_output=True, text=True, timeout=30
        )
        if r.returncode == 0:
            lines = [l.strip() for l in r.stdout.strip().splitlines() if l.strip()]
            if len(lines) >= 2:
                title = lines[0]; stream_url = lines[-1]
                return stream_url, title
            elif len(lines) == 1:
                return lines[0], "Video"
    except Exception as e:
        print(f"[mesh-tv] yt-dlp error: {e}", file=sys.stderr)
    return url, "Video"  # fallback: pass as-is

if __name__ == "__main__":
    args = sys.argv[1:]

    if "--test" in args:
        errs = []
        # check yt-dlp
        ytdlp = os.path.expanduser("~/.local/bin/yt-dlp")
        if not (os.path.exists(ytdlp) or subprocess.run(["which","yt-dlp"],capture_output=True).returncode==0):
            errs.append("yt-dlp missing")
        # check socket (always ok)
        if errs:
            print("smoke-test: FAIL (" + "; ".join(errs) + ")"); sys.exit(1)
        print("smoke-test: ok (yt-dlp present; DLNA needs TV on LAN)"); sys.exit(0)

    if "--discover" in args:
        ip, port, ctrl = _tv_conf()
        if ip and ctrl:
            print(f"[mesh-tv] TV from config: {ip}:{port} ctrl={ctrl}")
            sys.exit(0)
        print("[mesh-tv] discovering DLNA MediaRenderer via SSDP (10s)...")
        ip, port, ctrl = discover_dlna(10)
        if ip and ctrl:
            print(f"[mesh-tv] found: {ip}:{port} ctrl={ctrl}")
            _save_tv_conf(ip, port, ctrl)
            print(f"[mesh-tv] saved to {TV_CONF}")
        else:
            print("[mesh-tv] no DLNA MediaRenderer found (TV may be off)"); sys.exit(2)
        sys.exit(0)

    if "--stop" in args:
        ip, port, ctrl = _tv_conf()
        if not ctrl:
            ip, port, ctrl = discover_dlna(8)
        if not ctrl:
            print("[mesh-tv] TV not found"); sys.exit(2)
        ok = dlna_stop(ctrl)
        if ok: print("[mesh-tv] stopped")
        else: print("[mesh-tv] stop failed", file=sys.stderr); sys.exit(1)
        sys.exit(0)

    if not args:
        print(__doc__); sys.exit(0)

    url = args[0]
    if not url.startswith("http"):
        print(f"[mesh-tv] not a URL: {url}", file=sys.stderr); sys.exit(1)

    ip, port, ctrl = _tv_conf()
    if not ctrl:
        print("[mesh-tv] discovering TV via SSDP (8s)...")
        ip, port, ctrl = discover_dlna(8)
    if not ctrl:
        _trace(f"TV not found on LAN (url={url})")
        subprocess.run(["mesh-chat", f"[mesh-tv] TV not found on LAN (is it on?). URL: {url}"], capture_output=True)
        subprocess.run(["mesh-tg", f"TV is off or not on LAN — can't play: {url}"], capture_output=True)
        sys.exit(2)

    # Resolve YouTube/video-site URLs to direct stream
    media_url, title = resolve_url(url)
    if media_url != url:
        print(f"[mesh-tv] resolved '{title}': {media_url[:80]}...")

    _trace(f"playing '{title}' on TV {ip} ctrl={ctrl}")
    ok = dlna_play(ctrl, media_url, title)
    if ok:
        _trace(f"TV playing: {title}")
        subprocess.run(["mesh-chat", f"[mesh-tv] playing on TV: {title}"], capture_output=True)
    else:
        _trace(f"TV play FAILED: {url}")
        subprocess.run(["mesh-tg", f"TV found ({ip}) but playback failed. Is it on and not casting?"], capture_output=True)
        sys.exit(1)
