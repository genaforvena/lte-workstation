#!/usr/bin/env bash
# mesh-tv — send a YouTube/video URL to the TV (DLNA primary; Samsung/ADB fallback)
# Usage: mesh-tv <url>
# Telegram: /meshtv <url>  →  this script runs automatically
set -uo pipefail
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

TV_IP="${MESH_TV_IP:-192.168.8.130}"
PHONE_IP="${PHONE_LAN_IP:-192.168.8.203}"
PHONE_ADB_PORT="${PHONE_ADB_PORT:-42939}"

URL="${1:-}"
[ -n "$URL" ] || { echo "usage: mesh-tv <youtube-url>"; exit 1; }

# Normalize youtu.be short links
URL=$(python3 -c "
import sys, re
u = sys.argv[1]
u = re.sub(r'youtu\.be/([^?]+)', r'youtube.com/watch?v=\1', u)
print(u)
" "$URL" 2>/dev/null || echo "$URL")

echo "[mesh-tv] target: $URL"

# ── Method 1: Samsung Tizen WebSocket API ────────────────────────────────────
try_tizen() {
  python3 - "$TV_IP" "$URL" << 'PY' 2>/dev/null
import sys, json, urllib.request, urllib.error
tv, url = sys.argv[1], sys.argv[2]
# Samsung REST API v2
try:
    r = urllib.request.urlopen(f"http://{tv}:8001/api/v2/", timeout=3)
    info = json.load(r)
    print("Tizen detected:", info.get("device",{}).get("modelName","?"))
except Exception as e:
    print(f"Tizen API unavailable: {e}")
    sys.exit(1)
PY
}

# ── Method 2: ADB phone cast ─────────────────────────────────────────────────
try_phone_cast() {
  local adb_dev
  adb_dev=$(adb devices 2>/dev/null | grep "device$" | head -1 | cut -f1)
  [ -n "$adb_dev" ] || { echo "[mesh-tv] no ADB device"; return 1; }
  echo "[mesh-tv] casting via phone ADB ($adb_dev)"
  # Open URL in YouTube app on phone
  adb -s "$adb_dev" shell am start -a android.intent.action.VIEW -d "$URL" 2>/dev/null \
    && echo "[mesh-tv] YouTube opened on phone — tap Cast icon on TV" \
    || return 1
}

# ── Method 3: Samsung legacy port 55000 ──────────────────────────────────────
try_samsung_legacy() {
  nc -z -w2 "$TV_IP" 55000 2>/dev/null || { echo "[mesh-tv] port 55000 closed"; return 1; }
  echo "[mesh-tv] Samsung legacy control available at $TV_IP:55000"
  # Legacy Samsung uses a text protocol — YouTube deeplink
  python3 - "$TV_IP" "$URL" << 'PY' 2>/dev/null
import sys, socket, time, base64
tv, url = sys.argv[1], sys.argv[2]
# Samsung legacy remote protocol
app_string = f'\x64\x00\x19\x00\x00\x00\x69\x70\x20\x61\x64\x64\x72\x65\x73\x73\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00'
try:
    s = socket.socket(); s.connect((tv, 55000)); s.settimeout(3)
    # Simplified key send
    s.send(b'\x00\x00\x00\x0a\x00\x00Samsung\x00')
    time.sleep(0.5)
    print("Legacy connection ok")
    s.close()
except Exception as e:
    print(f"Legacy failed: {e}"); sys.exit(1)
PY
}

# ── Method 4: DLNA AVTransport (Sony/Samsung/any UPnP MediaRenderer) ─────────
# Primary method when Samsung-specific ports are closed (e.g. Sony Bravia, old Samsung)
try_dlna() {
  local ctrl_url
  ctrl_url="${MESH_TV_CTRL:-}"
  if [ -z "$ctrl_url" ] && [ -f "$HOME/.mesh/tv.conf" ]; then
    ctrl_url=$(grep '^TV_CTRL=' "$HOME/.mesh/tv.conf" 2>/dev/null | cut -d= -f2-)
  fi
  # Fallback: guess standard DLNA control URL based on open port
  if [ -z "$ctrl_url" ]; then
    nc -z -w2 "$TV_IP" 52323 2>/dev/null && \
      ctrl_url="http://${TV_IP}:52323/upnp/control/AVTransport"
  fi
  [ -n "$ctrl_url" ] || { echo "[mesh-tv] no DLNA control URL"; return 1; }

  python3 - "$TV_IP" "$URL" "$ctrl_url" << 'PY'
import sys, subprocess, urllib.request, urllib.error, time, os

tv_ip, orig_url, ctrl_url = sys.argv[1], sys.argv[2], sys.argv[3]
AV_NS = "urn:schemas-upnp-org:service:AVTransport:1"

def _esc(s):
    return s.replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace('"',"&quot;")

def _soap(ctrl, action, fields):
    body = ('<?xml version="1.0"?>'
        '<s:Envelope xmlns:s="http://schemas.xmlsoap.org/soap/envelope/"'
        ' s:encodingStyle="http://schemas.xmlsoap.org/soap/encoding/">'
        '<s:Body>'
        f'<u:{action} xmlns:u="{AV_NS}">'
        + "".join(f"<{k}>{v}</{k}>" for k,v in fields.items()) +
        f'</u:{action}>'
        '</s:Body></s:Envelope>')
    req = urllib.request.Request(ctrl,
        data=body.encode("utf-8"),
        headers={"Content-Type": 'text/xml; charset="utf-8"',
                 "SOAPAction": f'"{AV_NS}#{action}"',
                 "Connection": "close"},
        method="POST")
    with urllib.request.urlopen(req, timeout=10) as r:
        return r.read()

# Resolve YouTube/video-site URLs to a direct H.264 CDN URL
media_url = orig_url
title = "Video"
video_sites = ("youtube.com", "youtu.be", "vimeo.com", "rutube.ru")
if any(s in orig_url for s in video_sites):
    ytdlp = os.path.expanduser("~/.local/bin/yt-dlp")
    if not os.path.exists(ytdlp): ytdlp = "yt-dlp"
    fmt = "best[ext=mp4][vcodec^=avc]/best[ext=mp4]/best[protocol=https]/best"
    try:
        r = subprocess.run([ytdlp, "-f", fmt, "--get-url", "--get-title",
                           "--no-playlist", orig_url],
                          capture_output=True, text=True, timeout=30)
        if r.returncode == 0:
            lines = [l.strip() for l in r.stdout.strip().splitlines() if l.strip()]
            if len(lines) >= 2: title, media_url = lines[0], lines[-1]
            elif len(lines) == 1: media_url = lines[0]
            print(f"[dlna] resolved: {title}")
    except Exception as e:
        print(f"[dlna] yt-dlp warn: {e}")

didl = ('<DIDL-Lite xmlns="urn:schemas-upnp-org:metadata-1-0/DIDL-Lite/"'
        ' xmlns:dc="http://purl.org/dc/elements/1.1/"'
        ' xmlns:upnp="urn:schemas-upnp-org:metadata-1-0/upnp/">'
        f'<item id="0" parentID="0" restricted="1">'
        f'<dc:title>{_esc(title)}</dc:title>'
        '<upnp:class>object.item.videoItem</upnp:class>'
        f'<res protocolInfo="http-get:*:video/mp4:*">{_esc(media_url)}</res>'
        '</item></DIDL-Lite>')

_soap(ctrl_url, "SetAVTransportURI", {
    "InstanceID": "0",
    "CurrentURI": _esc(media_url),
    "CurrentURIMetaData": _esc(didl),
})
print(f"[dlna] SetAVTransportURI ok")
_soap(ctrl_url, "Play", {"InstanceID": "0", "Speed": "1"})
print(f"[dlna] Play ok — '{title}' → TV")
PY
}

# Try methods: DLNA first (confirmed open port 52323), then Samsung-specific
try_dlna 2>&1 || \
try_tizen 2>/dev/null || \
try_phone_cast 2>/dev/null || \
try_samsung_legacy 2>/dev/null || \
{ echo "[mesh-tv] all methods failed — TV at $TV_IP may need to be on + DLNA enabled"; exit 1; }
