#!/usr/bin/env python3
"""mesh-tv — send a YouTube/video URL to the Samsung Smart TV (Samsung Tizen 2016+).

Usage:
  mesh-tv <url>          open URL on TV browser
  mesh-tv --discover     find Samsung TV on LAN, print IP
  mesh-tv --test         smoke test (deps check; no connection)
  mesh-tv --key KEY      send a remote key (e.g. KEY_HOME, KEY_PLAY, KEY_PAUSE)

Discovery: SSDP on local LAN → first Samsung TV found.
Override TV IP: TV_IP env var or ~/.mesh/tv.conf.
Samsung Tizen WebSocket API (port 8002). Pairing: TV will show a popup on first connect.

Exit: 0 = ok; 1 = error; 2 = TV not found/reachable.
"""
import os, sys, json, socket, struct, time, subprocess

def _load_env():
    p = os.path.expanduser("~/.mesh/nodes")
    if os.path.exists(p):
        with open(p) as f:
            for line in f:
                line = line.strip()
                if "=" in line and not line.startswith("#"):
                    k, v = line.split("=", 1)
                    k = k.strip(); v = v.strip().strip('"').strip("'")
                    if k and k not in os.environ:
                        os.environ[k] = v
_load_env()

TV_CONF = os.path.expanduser("~/.mesh/tv.conf")
HOST = socket.gethostname()
MESH_DIR = os.path.expanduser("~/.mesh")

def _trace(msg):
    t = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    line = f"{t}  mesh-tv@{HOST}  ::  {msg}"
    os.makedirs(MESH_DIR, exist_ok=True)
    with open(os.path.join(MESH_DIR, "traces.log"), "a") as f:
        f.write(line + "\n")
    print(line, flush=True)

def _tv_ip():
    """Return TV IP from env/conf, or None (caller does SSDP discovery)."""
    ip = os.environ.get("TV_IP", "")
    if ip: return ip
    if os.path.exists(TV_CONF):
        with open(TV_CONF) as f:
            for line in f:
                line = line.strip()
                if line.startswith("TV_IP"):
                    return line.split("=", 1)[1].strip().strip('"')
    return None

def discover_tv(timeout=10):
    """SSDP M-SEARCH, return first Samsung TV IP or None."""
    SSDP = "239.255.255.250"; PORT = 1900
    msg = (b"M-SEARCH * HTTP/1.1\r\n"
           b"HOST: 239.255.255.250:1900\r\n"
           b"MAN: \"ssdp:discover\"\r\n"
           b"MX: 3\r\n"
           b"ST: urn:samsung.com:device:RemoteControlReceiver:1\r\n\r\n")
    # also try generic upnp root device
    msg2 = msg.replace(b"urn:samsung.com:device:RemoteControlReceiver:1", b"ssdp:all")
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    local_ip = os.environ.get("MESH_LAN_IP", "192.168.8.241")
    try: s.bind((local_ip, 0))
    except Exception: pass
    s.settimeout(timeout)
    s.sendto(msg, (SSDP, PORT))
    s.sendto(msg2, (SSDP, PORT))
    deadline = time.time() + timeout
    while time.time() < deadline:
        try:
            data, addr = s.recvfrom(4096)
            txt = data.decode("utf-8", "replace").lower()
            if "samsung" in txt or "tizen" in txt or "smart" in txt:
                ip = addr[0]
                if not ip.startswith("192.168.8.241"):
                    return ip
        except socket.timeout:
            break
        except Exception:
            pass
    return None

def open_url_on_tv(ip, url):
    """Use samsungtvws to open a URL in the TV's browser."""
    try:
        from samsungtvws import SamsungTVWS
    except ImportError:
        print("samsungtvws not installed; run: pip3 install samsungtvws", file=sys.stderr)
        sys.exit(1)
    token_file = os.path.expanduser("~/.mesh/.tv-token.json")
    try:
        tv = SamsungTVWS(host=ip, port=8002, token_file=token_file, timeout=10, name="mesh-tv")
        tv.open()
        # Launch browser with URL via app
        tv.run_app("org.tizen.browser", meta_tag=url)
        tv.close()
        return True
    except Exception as e:
        # fallback: send as deep-link
        try:
            tv2 = SamsungTVWS(host=ip, port=8002, token_file=token_file, timeout=10, name="mesh-tv")
            tv2.open()
            import websocket as ws
            payload = json.dumps({
                "method": "ms.webapps.invoke",
                "params": {
                    "event": "ed.apps.launch",
                    "to": "host",
                    "data": {"appId": "org.tizen.browser", "action_type": "NATIVE_LAUNCH", "metaTag": url}
                }
            })
            tv2._ws.send(payload)
            time.sleep(1)
            tv2.close()
            return True
        except Exception as e2:
            print(f"[mesh-tv] error: {e}; fallback: {e2}", file=sys.stderr)
            return False

def send_key(ip, key):
    try:
        from samsungtvws import SamsungTVWS
        token_file = os.path.expanduser("~/.mesh/.tv-token.json")
        tv = SamsungTVWS(host=ip, port=8002, token_file=token_file, timeout=10, name="mesh-tv")
        tv.open()
        tv.send_key(key)
        tv.close()
        return True
    except Exception as e:
        print(f"[mesh-tv] key error: {e}", file=sys.stderr)
        return False

if __name__ == "__main__":
    args = sys.argv[1:]

    if "--test" in args or (len(args) == 1 and args[0] == "--test"):
        errs = []
        try: import samsungtvws; errs  # noqa
        except ImportError: errs.append("samsungtvws missing (pip3 install samsungtvws)")
        try: import yt_dlp  # noqa
        except ImportError: errs.append("yt-dlp missing (pip3 install yt-dlp)")
        if errs:
            print("smoke-test: FAIL (" + "; ".join(errs) + ")"); sys.exit(1)
        print("smoke-test: ok (samsungtvws + yt-dlp present; TV discovery needs network)"); sys.exit(0)

    if "--discover" in args:
        ip = _tv_ip()
        if ip:
            print(f"[mesh-tv] TV_IP from config: {ip}")
            sys.exit(0)
        print("[mesh-tv] discovering Samsung TV via SSDP (10s)...")
        ip = discover_tv(10)
        if ip:
            print(f"[mesh-tv] found: {ip}")
            # Save to conf
            os.makedirs(MESH_DIR, exist_ok=True)
            with open(TV_CONF, "w") as f:
                f.write(f"TV_IP={ip}\n")
            print(f"[mesh-tv] saved to {TV_CONF}")
        else:
            print("[mesh-tv] no Samsung TV found (TV may be off)"); sys.exit(2)
        sys.exit(0)

    if "--key" in args:
        idx = args.index("--key")
        key = args[idx + 1] if idx + 1 < len(args) else ""
        if not key:
            print("usage: mesh-tv --key KEY_HOME", file=sys.stderr); sys.exit(1)
        ip = _tv_ip() or discover_tv(8)
        if not ip:
            print("[mesh-tv] TV not found"); sys.exit(2)
        ok = send_key(ip, key)
        sys.exit(0 if ok else 1)

    if not args:
        print(__doc__); sys.exit(0)

    url = args[0]
    if not url.startswith("http"):
        print(f"[mesh-tv] not a URL: {url}", file=sys.stderr); sys.exit(1)

    ip = _tv_ip() or discover_tv(8)
    if not ip:
        _trace(f"TV not found on LAN — is it on? (url={url})")
        msg = f"[mesh-tv] TV not found on LAN (is it on?). URL queued: {url}"
        subprocess.run(["mesh-chat", msg], capture_output=True)
        subprocess.run(["mesh-tg", f"TV is off or not on LAN — can't play: {url}"], capture_output=True)
        sys.exit(2)

    _trace(f"opening {url} on TV {ip}")
    ok = open_url_on_tv(ip, url)
    if ok:
        _trace(f"TV opened: {url} @ {ip}")
        subprocess.run(["mesh-chat", f"[mesh-tv] playing on TV {ip}: {url}"], capture_output=True)
    else:
        _trace(f"TV open FAILED: {url} @ {ip}")
        subprocess.run(["mesh-tg", f"TV found ({ip}) but failed to open URL — may need pairing. Check TV screen for permission popup."], capture_output=True)
        sys.exit(1)
