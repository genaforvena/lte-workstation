#!/usr/bin/env bash
# mesh-tv — send YouTube/video URL to TV via UPnP/DLNA; control playback
# Usage:
#   mesh-tv <url>          download + play on TV (Sony Bravia)
#   mesh-tv pause          pause
#   mesh-tv play           resume
#   mesh-tv stop           stop
#   mesh-tv status         current transport state
#   mesh-tv --test         smoke test
# Telegram: /meshtv <url|pause|play|stop|status>
set -uo pipefail
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
export PATH="$HOME/.local/bin:$PATH"

TV_IP="${MESH_TV_IP:-192.168.8.130}"
TV_PORT="${MESH_TV_PORT:-52323}"
CTRL_URL="http://${TV_IP}:${TV_PORT}/upnp/control/AVTransport"
TV_DIR="$HOME/.mesh/tv"
HTTP_PORT="${MESH_TV_HTTP_PORT:-8099}"
# IdeaPad LAN IP for serving files to TV
NODE_LAN_IP="${MESH_NODE_LAN_IP:-$(ip -4 addr show | grep -oP '(?<=inet )192\.168\.[0-9]+\.[0-9]+' | head -1)}"

mkdir -p "$TV_DIR"

AV_NS="urn:schemas-upnp-org:service:AVTransport:1"

_soap() { # action fields_json
  python3 - "$CTRL_URL" "$AV_NS" "$1" "$2" << 'PY'
import sys, urllib.request, json
ctrl, ns, action, fields_json = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
fields = json.loads(fields_json)
def esc(s): return s.replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace('"',"&quot;")
body = ('<?xml version="1.0"?>'
    '<s:Envelope xmlns:s="http://schemas.xmlsoap.org/soap/envelope/"'
    ' s:encodingStyle="http://schemas.xmlsoap.org/soap/encoding/">'
    '<s:Body>'
    f'<u:{action} xmlns:u="{ns}">'
    + "".join(f"<{k}>{v}</{k}>" for k,v in fields.items()) +
    f'</u:{action}>'
    '</s:Body></s:Envelope>')
req = urllib.request.Request(ctrl, data=body.encode("utf-8"),
    headers={"Content-Type": 'text/xml; charset="utf-8"',
             "SOAPAction": f'"{ns}#{action}"', "Connection": "close"},
    method="POST")
try:
    with urllib.request.urlopen(req, timeout=10) as r:
        print(r.read().decode(errors="replace"))
        sys.exit(0)
except Exception as e:
    print(f"SOAP error: {e}", file=sys.stderr); sys.exit(1)
PY
}

_ensure_server() {
  pgrep -f "http.server ${HTTP_PORT}" >/dev/null 2>&1 && return 0
  python3 -m http.server "$HTTP_PORT" --directory "$TV_DIR" \
    --bind "$NODE_LAN_IP" &>/tmp/mesh-tv-http.log &
  sleep 1
  pgrep -f "http.server ${HTTP_PORT}" >/dev/null 2>&1 \
    || { echo "[mesh-tv] HTTP server failed to start"; return 1; }
}

CMD="${1:-}"
case "$CMD" in
  pause)
    _soap "Pause" '{"InstanceID":"0"}' >/dev/null && echo "[mesh-tv] paused" || echo "[mesh-tv] pause failed"
    ;;
  play)
    _soap "Play" '{"InstanceID":"0","Speed":"1"}' >/dev/null && echo "[mesh-tv] resumed" || echo "[mesh-tv] play failed"
    ;;
  stop)
    _soap "Stop" '{"InstanceID":"0"}' >/dev/null && echo "[mesh-tv] stopped" || echo "[mesh-tv] stop failed"
    ;;
  status)
    _soap "GetTransportInfo" '{"InstanceID":"0"}' 2>/dev/null | grep -oE 'CurrentTransportState>[^<]+' | sed 's/CurrentTransportState>//' || echo "unknown"
    ;;
  --test)
    nc -z -w3 "$TV_IP" "$TV_PORT" 2>/dev/null || { echo "smoke-test: n/a (TV $TV_IP:$TV_PORT unreachable — not a TV node)"; exit 2; }
    command -v yt-dlp >/dev/null 2>&1 || { echo "smoke-test: n/a (yt-dlp not installed — not a TV node)"; exit 2; }
    echo "smoke-test: ok (TV=$TV_IP:$TV_PORT yt-dlp=ok)"
    ;;
  "")
    echo "usage: mesh-tv <url|pause|play|stop|status|--test>"; exit 1
    ;;
  *)
    URL="$CMD"
    # Log every play invocation so restarts are detectable
    printf '%s [mesh-tv] play: %s (caller: %s)\n' \
      "$(date -u +%Y-%m-%dT%H:%MZ)" "$URL" "${PPID:-?}" \
      >> "$HOME/.mesh/tv-plays.log"
    YTDLP="$HOME/.local/bin/yt-dlp"
    [ -x "$YTDLP" ] || YTDLP="yt-dlp"
    command -v "$YTDLP" >/dev/null 2>&1 || { echo "[mesh-tv] yt-dlp not found"; exit 1; }

    # Resolve youtu.be short links
    URL=$(python3 -c "
import sys,re; u=sys.argv[1]
u=re.sub(r'youtu\\.be/([^?&]+)',r'youtube.com/watch?v=\\1',u)
print(u)" "$URL" 2>/dev/null || echo "$URL")

    echo "[mesh-tv] downloading: $URL"
    TITLE=$("$YTDLP" --get-title --no-playlist "$URL" 2>/dev/null || echo "Video")
    FMT="best[ext=mp4][vcodec^=avc]/best[ext=mp4]/best"
    # Download to now.mp4. --no-continue: always start fresh (no stale .part hijack).
    rm -f "$TV_DIR/now.mp4" "$TV_DIR/now.mp4.part"
    "$YTDLP" -f "$FMT" --no-playlist --no-continue -o "$TV_DIR/now.mp4" "$URL" \
      --newline -q --progress 2>&1 | tail -3
    [ -s "$TV_DIR/now.mp4" ] || { echo "[mesh-tv] download failed"; exit 1; }

    _ensure_server || exit 1

    # Always play immediately — new URL always interrupts whatever is on.
    SRV_URL="http://${NODE_LAN_IP}:${HTTP_PORT}/now.mp4"
    DIDL="$(python3 -c "
import sys
t,u=sys.argv[1],sys.argv[2]
def e(s): return s.replace('&','&amp;').replace('<','&lt;').replace('>','&gt;').replace('\"','&quot;')
print('<DIDL-Lite xmlns=\"urn:schemas-upnp-org:metadata-1-0/DIDL-Lite/\" xmlns:dc=\"http://purl.org/dc/elements/1.1/\" xmlns:upnp=\"urn:schemas-upnp-org:metadata-1-0/upnp/\"><item id=\"0\" parentID=\"0\" restricted=\"1\"><dc:title>'+e(t)+'</dc:title><upnp:class>object.item.videoItem</upnp:class><res protocolInfo=\"http-get:*:video/mp4:*\">'+e(u)+'</res></item></DIDL-Lite>')" "$TITLE" "$SRV_URL" 2>/dev/null)"
    _soap "SetAVTransportURI" "$(python3 -c "
import sys,json
u,d=sys.argv[1],sys.argv[2]
def e(s): return s.replace('&','&amp;').replace('<','&lt;').replace('>','&gt;').replace('\"','&quot;')
print(json.dumps({'InstanceID':'0','CurrentURI':e(u),'CurrentURIMetaData':e(d)}))" "$SRV_URL" "$DIDL")" >/dev/null \
      || { echo "[mesh-tv] SetAVTransportURI failed"; exit 1; }
    _soap "Play" '{"InstanceID":"0","Speed":"1"}' >/dev/null \
      || { echo "[mesh-tv] Play failed"; exit 1; }
    # Update url-watch dedup so mesh-url-watch cron skips this URL for 600s.
    # Prevents double-play when operator sends /mesh-tv and the cron also picks up the same log line.
    printf '%s\n%s\n' "$URL" "$(date +%s)" > "$HOME/.mesh/.url-watch-lastfired"
    echo "[mesh-tv] playing: $TITLE"
    ;;
esac
