#!/usr/bin/env bash
# mesh-tv — thin forwarder → mesh-tv-dlna (the ONE canonical DLNA caster).
#
# CONSOLIDATED 2026-06-17. Two minds independently fixed the same "playback impossible"
# bug on the 2013 Sony Bravia, but in TWO scripts (mesh-tv and mesh-tv-dlna). Two live
# casters pointed at one TV is the dual-cast restart hazard (memory:
# parallel-minds-same-goal-different-file — "never two casters on one watched actuator";
# it restarted the operator's video). mesh-tv-dlna is the keeper: it's the wired tool
# (mesh-url-watch + mesh-card both call it) and the more complete implementation —
#   * Range-capable HTTP/1.1 server (206 Partial Content + DLNA contentFeatures) — the real
#     fix; with Range the TV fetches the moov atom from the end itself, so faststart is moot.
#   * 403-dodge download: progressive itags 22/18 + `--js-runtimes node` (YouTube anti-bot).
#   * Sony IRCC Pause fallback for the old Bravia; a play-queue; clean URL-switch (no restart).
# Everything mesh-tv had (range server, 720p cap, idempotent play) mesh-tv-dlna already has
# or supersedes. This forwarder keeps the documented `mesh-tv` name + the operator's
# /mesh-tv habit working through the single caster. To restart playback deliberately, call
# mesh-tv-dlna directly. Reversible: this file is just an exec shim.
set -uo pipefail
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
export PATH="$HOME/.local/bin:$PATH"

# --test: verify the forwarding path — mesh-tv-dlna must exist and be executable
if [ "${1:-}" = --test ]; then
  dlna=""
  for _d in mesh-tv-dlna "$HOME/.local/bin/mesh-tv-dlna"; do
    command -v "$_d" >/dev/null 2>&1 && { dlna="$_d"; break; }
  done
  if [ -z "$dlna" ]; then
    echo "smoke-test: FAIL (mesh-tv-dlna not found on PATH or ~/.local/bin — forwarder is dead)"
    exit 1
  fi
  echo "smoke-test: ok (mesh-tv-dlna at $dlna — forwarding path live)"
  exit 0
fi

if command -v mesh-tv-dlna >/dev/null 2>&1; then
  exec mesh-tv-dlna "$@"
fi
echo "[mesh-tv] mesh-tv-dlna not found — mesh-tv is now a forwarder to it (consolidated 2026-06-17)" >&2
exit 1
