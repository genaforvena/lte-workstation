#!/usr/bin/env bash
# reflex-cadence: 4-59/10 * * * *
# mesh-wifi-mimo — NODE WiFi SPATIAL-LINK sense: the MIMO rank (number of spatial
# streams, NSS) and channel width (MHz) the node's WiFi link is actually sustaining.
# Reads `iw dev <iface> link` — the driver's live rate-control MIMO state. A REAL
# hardware signal, orthogonal to everything the mesh already senses on WiFi.
#
# WHY (the gap this fills): the mesh reads its WiFi link's SIGNAL + discards
# (mesh-wifi-quality) and its MODULATION rate MCS + retries (mesh-wifi-contention).
# Neither emits NSS or channel width. Those are the SPATIAL axis: a MIMO link runs
# 2 (or more) independent spatial streams over antenna diversity + multipath. When the
# link collapses 2→1 streams (or 80→40→20 MHz) *while signal dBm barely moves*, the
# cause is PHYSICAL and distinct from weak-signal: an antenna path is obstructed — a
# hand/body/object over the radio, the lid angled shut over the antennas, or multipath
# richness lost — or the AP fell back to a narrower channel under RF interference.
# Signal-strength and MCS can't see this; the spatial rank can. That is the sense:
# "is something physically interfering with the radio path", read from the RF itself.
#
#   mesh-wifi-mimo              one-line spatial-link state
#   mesh-wifi-mimo --json       machine-readable {bssid,tx_nss,rx_nss,width_mhz,rank,...}
#   mesh-wifi-mimo --test       classifier asserts on synthetic `iw link` fixtures
#                               + a real-read gate (live iw link yields numeric rank/width)
#
# THE SIGNAL FIELD IS A BURST MEDIAN, AND IT CAN READ na (2026-08-24, task {#43f0d1be}).
# This sense used to parse `signal:` at face value and publish it. On this node's uplink
# (RTL8822BU) that field RAILS TO A PERFECT 0 dBm ~12% of samples — discover measured 11/90 with
# /proc/net/wireless rendering the SAME instants as -256, health replicated it 16-of-16 coincident
# under a bracket that rules out the inter-read gap. 0 dBm is IN range, well-formed and MAXIMAL, so
# no plausibility bound rejects it (the -256 twin has been guarded since 2026-07-14 precisely
# because it is OUT of range — the same blindness, opposite sign, and the guard did not travel).
#
# Why that mattered HERE more than anywhere else: this organ's whole discriminator is "NSS collapsed
# 2->1 WHILE signal dBm held steady = obstructed antenna path", exported downstream as
# DEGRADED-MIMO-at-strong-signal ("an object placed on the machine"). A rail coinciding with a real
# NSS collapse renders as signal IMPROVED TO MAXIMUM while rank fell — the most emphatic possible
# instance of the inference, manufactured out of a blind moment. 3 of 30 consecutive runs at 20:03Z
# published `signal=0dBm`.
#
# So the signal is now read as a BURST (MESH_WIFI_MIMO_SAMPLES, default 5) and reduced by
# rssi_burst's median over the VALID samples — never a bound on one sample, because health measured
# the rail flipping INSIDE the gap between two adjacent reads (22/100 brackets). The blind fraction
# is published beside the value (`sig_blind=k/n`), so a degrading dongle shows up as a RISING BLIND
# FRACTION rather than as a quieter average. When every link sample is railed we fall back to
# `beacon signal avg` from the station dump — measured 2026-08-24 over 152 samples on this link:
# 6/6 railed link instants had a VALID beacon average, and beacon avg never railed once — and the
# rendering NAMES which surface answered (`sig_src=link|beacon`). When neither is valid the field
# reads `na`: never 0, never a silently carried last value.
#
# Verdict (per-BSSID rolling-max baseline in STATE — honest: DEGRADED only fires once a
# HIGHER rank/width has actually been observed on THIS AP; first sight of an AP = FULL):
#   FULL            rank + width at the best seen on this BSSID — clean MIMO path
#   DEGRADED-MIMO   spatial rank dropped below baseline — likely antenna obstruction
#   NARROW-CHANNEL  channel width fell below baseline — likely RF interference fallback
#   DEGRADED        both collapsed
#   DISCONNECTED    associated to no AP (a real assessment, not an error)
#
# Exit codes:
#   0 = assessment produced (DISCONNECTED included)
#   2 = no wireless interface / `iw` unavailable (honest n/a — unreachable radio, NEVER faked)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

# Both state paths are env-overridable so --test can drive the REAL render path (emit, not just the
# pure helpers) without writing the artifact a watchdog reads for liveness: a dry run that touches
# the liveness record forges the very evidence it exists to check. --test points them at a temp dir
# and then asserts the live .wifi-mimo-last mtime did not move.
STATE_FILE="${MESH_WIFI_MIMO_STATE:-$HOME/.mesh/.wifi-mimo-state}"   # per-BSSID rolling-max baseline: "bssid rank width"
LAST_FILE="${MESH_WIFI_MIMO_LAST:-$HOME/.mesh/.wifi-mimo-last}"      # change-gated content marker + liveness mtime

# --- The RSSI sentinel grammar is SHARED, not private (mesh-patterns.sh) ---
# Four private copies of this predicate existed and no two agreed: mesh-wifi-quality/-rf rejected
# -256 but accepted 0, mesh-wifi-contention rejected 0 but not -256, and this file had no guard at
# all. One blindness with two renderings needs ONE predicate — the same reason MESH_RL_RE lives
# there. Inline fallbacks keep this tool honest on a node without the lib: they are the SAME
# predicate, not a laxer one, so a missing lib can never re-open the hole this commit closes.
source "$HOME/.local/bin/mesh-patterns.sh" 2>/dev/null || true
command -v rssi_valid >/dev/null 2>&1 || { RSSI_GRAMMAR_SRC=inline; rssi_valid() {
  local v="${1:-}"; v="${v% dBm}"; v="${v%dBm}"; v="${v%.}"
  case "$v" in ''|-|NA|na|n/a) return 1;; esac
  case "$v" in *[!0-9.-]*) return 1;; esac
  case "$v" in *.*) v="${v%%.*}";; esac
  case "$v" in ''|-) return 1;; esac
  [ "$v" -lt 0 ] 2>/dev/null || return 1
  [ "$v" -gt "${RSSI_MIN_DBM:--200}" ] 2>/dev/null
}; }
command -v rssi_burst >/dev/null 2>&1 || rssi_burst() {
  awk -v minv="${RSSI_MIN_DBM:--200}" '
    { total++; v=$0; sub(/ ?dBm$/,"",v); sub(/\.$/,"",v)
      if (v !~ /^-?[0-9]+(\.[0-9]+)?$/) next
      n=int(v+0); if (n>=0 || n<=minv) next
      vals[++k]=n }
    END { if (k==0) { printf "na %d %d\n", 0, total; exit }
          for (i=2;i<=k;i++) { t=vals[i]; j=i-1; while (j>=1 && vals[j]>t) { vals[j+1]=vals[j]; j-- } vals[j+1]=t }
          printf "%d %d %d\n", vals[int((k+1)/2)], k, total }'
}

# --rssi-probe <value> — hidden, for gate (m) ONLY: prints "<sentinel|valid> <grammar-src>" and
# exits. It exists so --test can run this file's grammar with the shared lib GENUINELY ABSENT (a
# fake HOME), instead of asserting the inline fallback's equivalence in a comment. Reads no radio,
# writes no state.
if [ "${1:-}" = --rssi-probe ]; then
  if rssi_valid "${2:-}"; then printf 'valid %s\n' "${RSSI_GRAMMAR_SRC:-unknown}"
  else printf 'sentinel %s\n' "${RSSI_GRAMMAR_SRC:-unknown}"; fi
  exit 0
fi

# --- Find the active wireless interface (same idiom as mesh-wifi-quality) ---
# Env-overridable so --test can drive the no-radio branch against a fixture instead of the real sysfs
# (2026-07-15). Same convention as MESH_THERM_ZONE_GLOB / MESH_POWER_SUPPLY_DIR / MESH_CPU_AVGFREQ_ROOT.
# Without it the "no wireless interface" gate is UNFALSIFIABLE on a node that has a radio — and a gate
# nobody can watch fail is exactly what this commit exists to fix.
WIFI_NET_GLOB="${MESH_WIFI_NET_GLOB:-/sys/class/net/*/wireless}"
find_wifi_iface() {
  local f iface=""
  for f in $WIFI_NET_GLOB; do
    [ -d "$f" ] || continue
    iface="$(basename "$(dirname "$f")")"
    break
  done
  echo "$iface"
}

# --- Parse `iw ... link` text on stdin → "<bssid> <tx_bitrate> <tx_width> <tx_nss> <rx_bitrate> <rx_width> <rx_nss> <signal>"
# Emits "DISCONNECTED" (single token) when there is no "Connected to" line.
# NSS: explicit VHT/HE/EHT-NSS token when present; for pure-HT rates derived from the
# HT-MCS index (MCS 0-7 = 1 stream, 8-15 = 2, 16-23 = 3, 24-31 = 4). Missing fields → 0.
parse_link() {
  awk '
    function nss_from(line,   i,n,f,tok,mcs) {
      n = split(line, f, /[ \t]+/)
      # explicit spatial-stream count wins
      for (i = 1; i <= n; i++) if (f[i] ~ /-NSS$/) { return f[i+1]+0 }
      # pure-HT: derive NSS from the HT-MCS index
      for (i = 1; i <= n; i++) if (f[i] == "MCS") { mcs = f[i+1]+0; return int(mcs/8)+1 }
      return 0
    }
    function bitrate_from(line,   i,n,f) {
      n = split(line, f, /[ \t]+/)
      for (i = 1; i <= n; i++) if (f[i] == "MBit/s") return f[i-1]+0
      return 0
    }
    function width_from(line,   i,n,f) {
      n = split(line, f, /[ \t]+/)
      for (i = 1; i <= n; i++) if (f[i] ~ /^[0-9]+MHz$/) { sub(/MHz$/, "", f[i]); return f[i]+0 }
      return 0
    }
    /Connected to/ { for (i=1;i<=NF;i++) if ($i=="to") { bssid=$(i+1); conn=1 } }
    /signal:/      { for (i=1;i<=NF;i++) if ($i=="signal:") sig=$(i+1)+0 }
    /tx bitrate:/  { txb=bitrate_from($0); txw=width_from($0); txn=nss_from($0) }
    /rx bitrate:/  { rxb=bitrate_from($0); rxw=width_from($0); rxn=nss_from($0) }
    END {
      if (!conn) { print "DISCONNECTED"; exit }
      printf "%s %d %d %d %d %d %d %d\n", bssid, txb, txw, txn, rxb, rxw, rxn, sig
    }
  '
}

# --- Signal: a BURST, reduced by median, with a NAMED source and a published blind fraction ---
# WHY not one read: the rail flips inside the millisecond gap between two adjacent reads (health,
# 2026-08-24: 22 of 100 read-proc/read-iw/read-proc brackets had proc CHANGE across the intervening
# iw call), so a single sample is untrustworthy on its face and a cross-surface agreement check is
# not a validity proof either. A median over a burst is the shape that survives.
SIG_SAMPLES="${MESH_WIFI_MIMO_SAMPLES:-5}"

# beacon_avg <iface> -> the station dump's `beacon signal avg` (raw, sentinels included), or "".
# A DIFFERENT estimator on the same radio: averaged over received beacons rather than sampled at
# the instant we asked, which is exactly why it survives an instant the instantaneous field misses.
# Measured on this link 2026-08-24 (152 samples @1s): link signal railed 6 times, beacon avg was
# VALID in all 6 and never railed once. It is a fallback, not a substitute — it is named as its own
# source in the output so nobody reads a beacon average as an instantaneous RSSI.
beacon_avg() {
  iw dev "$1" station dump 2>/dev/null \
    | awk -F'\t' '/^\tbeacon signal avg:/{print $3; exit}' | awk '{print $1}'
}

# signal_read <beacon-candidate>; stdin: one raw `signal:` value per burst sample
#   -> "<dbm|na> <link|beacon|none> <valid> <total>"
# PURE (no iw, no clock) so the mutation gate below can drive the railed case without a radio.
signal_read() {
  local beacon="${1:-}" med valid total b
  read -r med valid total <<<"$(rssi_burst)"
  if [ "$med" != na ]; then printf '%s link %s %s\n' "$med" "$valid" "$total"; return; fi
  if rssi_valid "$beacon"; then
    b="${beacon% dBm}"; b="${b%dBm}"; b="${b%.}"; b="${b%%.*}"
    printf '%s beacon %s %s\n' "$b" "$valid" "$total"; return
  fi
  printf 'na none %s %s\n' "$valid" "$total"
}

# --- Baseline (per-BSSID rolling max of rank + width) ---
read_baseline() { # <bssid> -> "rank width" (0 0 if unseen)
  local bssid="$1"
  [ -r "$STATE_FILE" ] || { echo "0 0"; return; }
  awk -v b="$bssid" '$1==b { print $2, $3; found=1; exit } END { if(!found) print "0 0" }' "$STATE_FILE"
}
write_baseline() { # <bssid> <rank> <width>  (upsert the rolling max, preserve other BSSIDs)
  local bssid="$1" rank="$2" width="$3" tmp
  mkdir -p "$(dirname "$STATE_FILE")" 2>/dev/null
  tmp="$STATE_FILE.$$"
  { [ -r "$STATE_FILE" ] && grep -v -e "^$bssid " "$STATE_FILE" 2>/dev/null; echo "$bssid $rank $width"; } > "$tmp" 2>/dev/null \
    && mv -f "$tmp" "$STATE_FILE" 2>/dev/null || rm -f "$tmp" 2>/dev/null
}

# --- Classify current vs baseline → verdict ---
classify() { # <rank> <width> <base_rank> <base_width> -> verdict
  local rank="$1" width="$2" br="$3" bw="$4"
  local mimo_lo=0 chan_lo=0
  [ "$br" -gt 0 ] && [ "$rank" -lt "$br" ] && mimo_lo=1
  [ "$bw" -gt 0 ] && [ "$width" -lt "$bw" ] && chan_lo=1
  if   [ "$mimo_lo" = 1 ] && [ "$chan_lo" = 1 ]; then echo DEGRADED
  elif [ "$mimo_lo" = 1 ]; then echo DEGRADED-MIMO
  elif [ "$chan_lo" = 1 ]; then echo NARROW-CHANNEL
  else echo FULL
  fi
}

emit() { # <parsed> <json> [sig-quartet] — verdict from a parsed line; updates baseline; writes STATE
         # (change-gated) + touches mtime. The signal quartet is an ARGUMENT, never an exported
         # scratch variable: a generic exported name is loaned to every child this tool spawns.
  local parsed="$1" json="$2" sig_q="${3:-}"
  if [ "$parsed" = DISCONNECTED ]; then
    if [ "$json" = 1 ]; then printf '{"verdict":"DISCONNECTED","bssid":null,"ts":"%s"}\n' "$(date -u +%FT%TZ)"
    else echo "DISCONNECTED|no associated AP"; fi
    return 0
  fi
  local bssid txb txw txn rxb rxw rxn sig
  read -r bssid txb txw txn rxb rxw rxn sig <<<"$parsed"
  # The parsed `sig` field is the RAW driver value and is NOT published — 0 there means "railed or
  # absent", two blindnesses that render identically and neither of which is a reading. What gets
  # published is the burst verdict passed in by the caller (or, for a single-parse caller such as a
  # fixture, that same raw value put through the one grammar so it can still read na).
  local sig_disp sig_src sig_ok sig_n
  read -r sig_disp sig_src sig_ok sig_n <<<"${sig_q:-$(printf '%s\n' "$sig" | signal_read "")}"
  local rank=$txn; [ "$rxn" -gt "$rank" ] && rank=$rxn
  local width=$txw; [ "$rxw" -gt "$width" ] && width=$rxw
  local br bw; read -r br bw <<<"$(read_baseline "$bssid")"
  local verdict; verdict="$(classify "$rank" "$width" "$br" "$bw")"
  # rolling-max baseline upsert
  local nbr=$br nbw=$bw
  [ "$rank" -gt "$nbr" ] && nbr=$rank
  [ "$width" -gt "$nbw" ] && nbw=$width
  write_baseline "$bssid" "$nbr" "$nbw"
  # change-gated content marker + ALWAYS refresh mtime (liveness = ran-live, content = value-changed)
  local marker="$verdict $bssid $rank $width"
  local line_state="$LAST_FILE"
  local prev=""; [ -r "$line_state" ] && prev="$(cat "$line_state" 2>/dev/null)"
  if [ "$marker" != "$prev" ]; then printf '%s\n' "$marker" > "$line_state" 2>/dev/null; fi
  mesh-state-touch "$line_state" 2>/dev/null || touch "$line_state" 2>/dev/null
  if [ "$json" = 1 ]; then
    # signal_dbm is null (never 0) when every sample was blind. signal_src names WHICH surface
    # answered, and signal_blind/signal_samples publish the rail rate so a degrading dongle reads as
    # a rising blind fraction instead of a quieter average.
    local sig_json="null"; [ "$sig_disp" != na ] && sig_json="$sig_disp"
    printf '{"verdict":"%s","bssid":"%s","tx_nss":%d,"rx_nss":%d,"rank":%d,"width_mhz":%d,"base_rank":%d,"base_width":%d,"tx_bitrate":%s,"rx_bitrate":%s,"signal_dbm":%s,"signal_src":"%s","signal_blind":%d,"signal_samples":%d,"ts":"%s"}\n' \
      "$verdict" "$bssid" "$txn" "$rxn" "$rank" "$width" "$nbr" "$nbw" "$txb" "$rxb" "$sig_json" "$sig_src" "$((sig_n - sig_ok))" "$sig_n" "$(date -u +%FT%TZ)"
  else
    local sig_txt="na"; [ "$sig_disp" != na ] && sig_txt="${sig_disp}dBm"
    echo "$verdict|rank=${rank}ss(tx${txn}/rx${rxn})|width=${width}MHz|base=${nbr}ss/${nbw}MHz|signal=${sig_txt}(src=${sig_src},blind=$((sig_n - sig_ok))/${sig_n})|tx=${txb}/rx=${rxb}Mbps|$bssid"
  fi
}

# --------------------------- --test ---------------------------
if [ "${1:-}" = --test ]; then
  fails=0
  # (a) FULL fixture (VHT 2ss 80MHz) parses rank=2 width=80
  full='Connected to 26:48:d7:9b:2d:88 (on wlan0)
	signal: -60 dBm
	tx bitrate: 390.0 MBit/s VHT-MCS 4 80MHz short GI VHT-NSS 2
	rx bitrate: 260.0 MBit/s VHT-MCS 3 80MHz short GI VHT-NSS 2'
  p="$(printf '%s\n' "$full" | parse_link)"
  read -r _b _txb _txw _txn _rxb _rxw _rxn _sig <<<"$p"
  { [ "$_txw" = 80 ] && [ "$_txn" = 2 ] && [ "$_sig" = -60 ]; } \
    || { echo "  FAIL a: FULL parse got '$p' (want width80 nss2 sig-60)"; fails=$((fails+1)); }

  # (b) DEGRADED-MIMO: 1ss @80MHz against baseline 2ss/80
  degm='Connected to AA:BB:CC:DD:EE:FF (on wlan0)
	signal: -58 dBm
	tx bitrate: 195.0 MBit/s VHT-MCS 4 80MHz short GI VHT-NSS 1
	rx bitrate: 195.0 MBit/s VHT-MCS 4 80MHz short GI VHT-NSS 1'
  read -r _b b1 w1 n1 _ <<<"$(printf '%s\n' "$degm" | parse_link)"
  v="$(classify "$n1" "$w1" 2 80)"
  [ "$v" = DEGRADED-MIMO ] || { echo "  FAIL b: 1ss/80 vs 2ss/80 got '$v' (want DEGRADED-MIMO)"; fails=$((fails+1)); }

  # (c) NARROW-CHANNEL: 2ss @40MHz against baseline 2ss/80
  read -r _b _tb tw2 tn2 _ <<<"$(printf 'Connected to X (on wlan0)\n\ttx bitrate: 180.0 MBit/s VHT-MCS 9 40MHz short GI VHT-NSS 2\n\trx bitrate: 180.0 MBit/s VHT-MCS 9 40MHz short GI VHT-NSS 2\n' | parse_link)"
  v="$(classify "$tn2" "$tw2" 2 80)"
  [ "$v" = NARROW-CHANNEL ] || { echo "  FAIL c: 2ss/40 vs 2ss/80 got '$v' (want NARROW-CHANNEL)"; fails=$((fails+1)); }

  # (d) DISCONNECTED: no "Connected to" line
  d="$(printf 'Not connected.\n' | parse_link)"
  [ "$d" = DISCONNECTED ] || { echo "  FAIL d: disconnected got '$d'"; fails=$((fails+1)); }

  # (e) pure-HT MCS→NSS: MCS 12 → 2 streams, MCS 5 → 1 stream
  read -r _b _ _ hn _ <<<"$(printf 'Connected to X (on wlan0)\n\ttx bitrate: 144.0 MBit/s MCS 12 40MHz short GI\n\trx bitrate: 72.0 MBit/s MCS 5 20MHz\n' | parse_link)"
  [ "$hn" = 2 ] || { echo "  FAIL e: HT MCS12 got nss '$hn' (want 2)"; fails=$((fails+1)); }

  # (f) first-sight of a BSSID (baseline 0 0) is FULL, never a false DEGRADED
  v="$(classify 1 20 0 0)"
  [ "$v" = FULL ] || { echo "  FAIL f: first-sight got '$v' (want FULL)"; fails=$((fails+1)); }

  # The render-path gates below call emit for real. Point its two state files at a temp dir first:
  # emit touches the liveness mtime on every successful eval, and a --test that moves it would forge
  # the liveness record the mtime-aging watchdogs read. Asserted, not just intended, at (l).
  _td="$(mktemp -d)"; trap 'rm -rf "$_td"' EXIT
  _live_last="$HOME/.mesh/.wifi-mimo-last"
  _live_mtime_before="$(stat -c %Y "$_live_last" 2>/dev/null || echo absent)"
  STATE_FILE="$_td/state"; LAST_FILE="$_td/last"

  # (h) THE RAIL, DRIVEN END-TO-END THROUGH THE RENDER PATH (task {#43f0d1be}).
  #     A magnitude bound like mesh-wifi-quality's level_valid CANNOT express this — 0 is IN range —
  #     so the gate is a MUTATION, not an assertion about a predicate: take the FULL fixture that
  #     already passes (a), rail its signal line to the exact text this driver emits, and require
  #     the CONSUMER-VISIBLE line not to carry 0 dBm. If someone reverts to face-value parsing this
  #     goes red on the published string, which is the thing that was wrong.
  railed="$(printf '%s\n' "$full" | sed 's/signal: -60 dBm/signal: 0 dBm/')"
  rp="$(printf '%s\n' "$railed" | parse_link)"
  rsig="$(printf '%s\n' "$rp" | awk '{print $NF}')"
  [ "$rsig" = 0 ] || { echo "  FAIL h0: fixture wrong — the railed block must parse a raw sig of 0 (got '$rsig')"; fails=$((fails+1)); }
  out_railed="$(emit "$rp" 0 "$(printf '%s\n' "$rsig" | signal_read "")")"
  printf '%s' "$out_railed" | grep -q 'signal=0dBm' \
    && { echo "  FAIL h: a railed sample reached the published line as 0dBm: $out_railed"; fails=$((fails+1)); }
  printf '%s' "$out_railed" | grep -q 'signal=na(src=none,blind=1/1)' \
    || { echo "  FAIL h2: a fully railed read must publish na + its blind fraction (got: $out_railed)"; fails=$((fails+1)); }
  # and the JSON half — a consumer parsing signal_dbm must get null, never a maximal number
  json_railed="$(emit "$rp" 1 "$(printf '%s\n' "$rsig" | signal_read "")")"
  printf '%s' "$json_railed" | grep -q '"signal_dbm":null' \
    || { echo "  FAIL h3: railed JSON must carry signal_dbm null (got: $json_railed)"; fails=$((fails+1)); }
  printf '%s' "$json_railed" | grep -q '"signal_dbm":0' \
    && { echo "  FAIL h4: railed JSON published 0 dBm"; fails=$((fails+1)); }

  # (i) THE BURST is what survives, not a bound on one sample: a burst with ONE railed sample among
  #     valid ones must publish a real dBm AND still confess the blind sample. This is the shape
  #     health's bracket measurement forced — the rail flips between two adjacent reads, so a run
  #     that rejects the whole read on one bad sample would go dark ~12% of the time for nothing.
  q="$(printf -- '-49\n0\n-51\n' | signal_read "")"
  [ "$q" = "-51 link 2 3" ] || { echo "  FAIL i: mixed burst got '$q' (want '-51 link 2 3')"; fails=$((fails+1)); }
  out_mixed="$(emit "$rp" 0 "$q")"
  printf '%s' "$out_mixed" | grep -q 'signal=-51dBm(src=link,blind=1/3)' \
    || { echo "  FAIL i2: mixed burst must publish the median AND the blind fraction (got: $out_mixed)"; fails=$((fails+1)); }

  # (j) THE FALLBACK IS NAMED, NOT SILENT. discover filed the beacon fallback as UNPROVEN and it was
  #     right to: an unmeasured fallback is a second blind field wearing a plausible number. Measured
  #     2026-08-24 on this link, 152 samples @1s — 6 railed link instants, beacon avg VALID in 6/6,
  #     railed 0 times. So it is wired, and it must SAY it is the beacon that answered.
  q="$(printf -- '0\n0\n' | signal_read '-48 dBm')"
  [ "$q" = "-48 beacon 0 2" ] || { echo "  FAIL j: beacon fallback got '$q' (want '-48 beacon 0 2')"; fails=$((fails+1)); }
  printf '%s' "$(emit "$rp" 0 "$q")" | grep -q 'signal=-48dBm(src=beacon,blind=2/2)' \
    || { echo "  FAIL j2: the beacon value must be published under src=beacon, not as a link reading"; fails=$((fails+1)); }
  # a beacon average that is ITSELF railed rescues nothing — na, never the sentinel of the day
  q="$(printf -- '0\n0\n' | signal_read '0')"
  [ "$q" = "na none 0 2" ] || { echo "  FAIL j3: a railed beacon must not rescue a railed burst (got '$q')"; fails=$((fails+1)); }
  q="$(printf -- '0\n0\n' | signal_read '-256.')"
  [ "$q" = "na none 0 2" ] || { echo "  FAIL j4: the /proc sentinel must not rescue it either (got '$q')"; fails=$((fails+1)); }

  # (k) THE SHARED GRAMMAR IS THE ONE IN USE. The inline fallback exists for a node without the lib
  #     and must be the SAME predicate — if it is ever relaxed, this tool silently re-opens the hole.
  rssi_valid 0    && { echo "  FAIL k: 0 dBm must be rejected by whichever rssi_valid is loaded"; fails=$((fails+1)); }
  rssi_valid -256 && { echo "  FAIL k2: -256 must be rejected by whichever rssi_valid is loaded"; fails=$((fails+1)); }
  rssi_valid -49  || { echo "  FAIL k3: -49 is a real reading"; fails=$((fails+1)); }

  # (m) THE INLINE FALLBACK IS THE SAME PREDICATE — proven with the lib genuinely ABSENT, not
  #     asserted in a comment. Re-runs this file under a fake HOME so `source
  #     $HOME/.local/bin/mesh-patterns.sh` cannot resolve, then drives BOTH sentinels through
  #     whichever copy loaded. A fallback that quietly relaxes the predicate would re-open exactly
  #     the hole this commit closes, on precisely the nodes that have no lib to correct it.
  _fake="$_td/nohome"; mkdir -p "$_fake"
  _fbsrc="$(HOME="$_fake" bash "$0" --rssi-probe -49 2>/dev/null)"
  [ "$_fbsrc" = "valid inline" ] \
    || { echo "  FAIL m: with the lib absent the INLINE grammar must be the live one and accept -49 (got '$_fbsrc')"; fails=$((fails+1)); }
  for _v in 0 0. -256 -256. -0 7 '' abc; do
    _r="$(HOME="$_fake" bash "$0" --rssi-probe "$_v" 2>/dev/null)"
    [ "$_r" = "sentinel inline" ] \
      || { echo "  FAIL m2: inline grammar accepted '$_v' (got '$_r') — the fallback is laxer than the lib"; fails=$((fails+1)); }
  done
  # ...and the lib copy, on this node, agrees sentinel-for-sentinel with the inline one.
  _libsrc="$(bash "$0" --rssi-probe -49 2>/dev/null)"
  case "$_libsrc" in
    "valid mesh-patterns.sh") : ;;
    "valid inline") echo "  note m3: mesh-patterns.sh is not deployed on $(hostname) — the inline grammar is carrying this tool" ;;
    *) echo "  FAIL m3: -49 is a real reading under any grammar (got '$_libsrc')"; fails=$((fails+1)) ;;
  esac

  # (l) THE DRY RUN MUST NOT WRITE THE LIVENESS RECORD. Gates (h)-(j) ran emit for real; if their
  #     state redirection ever breaks, this tool's --test starts refreshing .wifi-mimo-last and the
  #     mtime-aging watchdogs read a dead reflex as alive on the strength of its own self-check.
  _live_mtime_after="$(stat -c %Y "$_live_last" 2>/dev/null || echo absent)"
  [ "$_live_mtime_before" = "$_live_mtime_after" ] \
    || { echo "  FAIL l: --test moved the LIVE liveness artifact $_live_last ($_live_mtime_before -> $_live_mtime_after)"; fails=$((fails+1)); }
  [ -s "$_td/last" ] || { echo "  FAIL l2: the redirected state file was never written — (h)-(j) did not exercise emit's write path"; fails=$((fails+1)); }

  # (g) REAL-READ GATE (CLAUDE.md doctrine): a live radio must yield a numeric rank+width.
  #     Honest n/a when no iface / not associated — required-but-non-blocking (exit-2 class).
  #
  # SELF-NULLIFYING (fixed 2026-07-15) — this gate was written to the doctrine, named after it, and
  # then wrapped in the one condition that switches it off exactly when it should fire: the guard was
  # `[ -z "$iface" ] || ! command -v iw`, so a missing dep or a missing radio SKIPPED the gate and fell
  # through to `smoke-test: PASS`. "honest skip, not a fail" was the bug — an honest skip must be an
  # honest exit 2, not a pass. Third instance of this exact sub-shape (mesh-wifi-heat-attrib 9f5bc51,
  # mesh-cpu-throttle d143ad6) and the class's signature: it survives a CONSCIENTIOUS author, because
  # citing the doctrine and implementing it as a no-op look identical from the test output.
  # It also welded two unrelated causes into one branch ("no wifi iface or iw missing"), so a fixable
  # dep and an absent radio produced the same message — see the note at the runtime iw check.
  iface="$(find_wifi_iface)"
  if ! command -v iw >/dev/null 2>&1; then
    echo "smoke-test: n/a — 'iw' is not installed on $(hostname), so the real-read gate cannot run (a missing DEP, not a missing radio: 'sudo apt install iw'). Classifier assertions (a)-(f) all passed."
    exit 2
  fi
  if [ -z "$iface" ]; then
    echo "smoke-test: n/a — no wireless interface on $(hostname): this node has no radio to read. Classifier assertions (a)-(f) all passed."
    exit 2
  fi
  live="$(iw dev "$iface" link 2>/dev/null | parse_link)"
  if [ "$live" = DISCONNECTED ] || [ -z "$live" ]; then
    # NOT associated is a genuine n/a: the radio is here and readable, it simply has no link right now.
    # Distinct from "no radio" (:above) and from "iw missing" (:above) — three causes, three verdicts.
    echo "smoke-test: n/a — radio $iface is present but not associated on $(hostname), so there is no link to measure. Classifier assertions (a)-(f) all passed."
    exit 2
  fi
  read -r _b _tb _tw ltn _rb _rw lrn _s <<<"$live"
  lrank=$ltn; [ "${lrn:-0}" -gt "$lrank" ] && lrank=$lrn
  if [ "${lrank:-0}" -ge 1 ]; then
    echo "  real-read: OK — live link on $iface yields rank=${lrank}ss"
  else
    echo "  FAIL g: live link on $iface produced no spatial rank (got '$live')"; fails=$((fails+1))
  fi

  [ "$fails" = 0 ] && { echo "smoke-test: PASS (classifier (a)-(f) + rail/burst/fallback mutation gates (h)-(m) + real-read gate: live link on $iface)"; exit 0; } || { echo "smoke-test: FAIL ($fails)"; exit 1; }
fi

# --------------------------- main ---------------------------
json=0; [ "${1:-}" = --json ] && json=1
# A MISSING DEP IS NOT AN ABSENT ORGAN (2026-07-15). This said "iw unavailable — no radio to read
# (n/a)", which is two claims welded together and the second one was FALSE: this branch has only
# established that the `iw` BINARY is missing — it has not looked at the radio at all (that is :212's
# job, which words its own case correctly). On mesh-home the radio was UP the whole time (rtw_8822bu
# wlxbcec43434a22, carrier=1) and CARRYING THIS NODE'S LAN, while the sense reported "no radio" 38/38
# times and the fix was `apt install iw`. A fixable gap rendered as a structural fact is the
# mesh-therm family (dacf6f1): not a faked all-clear, but a message indistinguishable from a
# DIFFERENT fault, which sends the next reader hunting hardware that was never missing.
command -v iw >/dev/null 2>&1 || { echo "mesh-wifi-mimo: 'iw' is not installed (n/a — a missing DEP, not a missing radio: 'sudo apt install iw'; this branch has not read the radio)" >&2; exit 2; }
iface="$(find_wifi_iface)"
[ -n "$iface" ] || { echo "mesh-wifi-mimo: no wireless interface (n/a)" >&2; exit 2; }
# BURST, not a single read (task {#43f0d1be}): one `iw link` per sample, back to back — the rail
# flips inside the gap between two adjacent reads, so consecutive samples are near-independent and
# no sleep is needed. The STRUCTURAL fields (rank/width/bssid) come from the first CONNECTED parse;
# only the signal is reduced across the burst, because the rail is an RSSI phenomenon and the
# bitrate/NSS lines are not implicated by any measurement here.
parsed=""; sigs=""
for _i in $(seq 1 "$SIG_SAMPLES"); do
  _p="$(iw dev "$iface" link 2>/dev/null | parse_link)"
  [ -n "$_p" ] || continue
  [ -n "$parsed" ] || parsed="$_p"
  [ "$_p" = DISCONNECTED ] && continue
  sigs="${sigs}$(printf '%s\n' "$_p" | awk '{print $NF}')
"
done
[ -n "$parsed" ] || { echo "mesh-wifi-mimo: iw link produced no output on $iface (n/a)" >&2; exit 2; }
# Only pay for the station dump when the whole burst came back blind — the fallback exists for the
# rail, not as a second read on every tick.
sig_quartet="$(printf '%s' "$sigs" | signal_read "")"
case "$sig_quartet" in
  na\ none\ *) sig_quartet="$(printf '%s' "$sigs" | signal_read "$(beacon_avg "$iface")")" ;;
esac
emit "$parsed" "$json" "$sig_quartet"
