#!/usr/bin/env bash
# mesh-uvc-metadata — consume one UVC metadata buffer from a V4L2 metadata endpoint.
# reflex-cadence: */10 * * * *
# reflex-artifact: ~/.mesh/uvc-metadata/latest.bin
# The endpoint is intermittently unavailable on some starts; failed reads leave the
# previous artifact intact and return non-zero, while a fresh non-empty buffer is live evidence.
#
# The endpoint is not an image stream.  It is a real diagnostic artifact: one non-empty
# UVCH payload proves that the camera's metadata path is open and streaming.
# The raw buffer is paired with latest.jsonl, whose records retain kernel monotonic timestamps,
# USB frame numbers, flags, and the exact copied UVC payload header.
#
#   mesh-uvc-metadata                 -> ~/.mesh/uvc-metadata/latest.bin
#   mesh-uvc-metadata --test           -> real one-buffer probe in a private temp file
#   mesh-uvc-metadata --parse FILE      -> validate and print timestamped JSONL records
#   MESH_UVC_METADATA_DEV=/dev/video1  -> select the metadata endpoint
#   MESH_UVC_METADATA_ATTEMPTS=10      -> bounded runtime attempts (each has its own timeout)
#   Runtime and --test probes for the same device path share an advisory lock.
set -euo pipefail

export PATH="$HOME/.local/bin:$PATH"
DEV="${MESH_UVC_METADATA_DEV:-/dev/video1}"
OUT="${MESH_UVC_METADATA_OUT:-$HOME/.mesh/uvc-metadata/latest.bin}"
TIMEOUT_S="${MESH_UVC_METADATA_TIMEOUT:-2}"
ATTEMPTS="${MESH_UVC_METADATA_ATTEMPTS:-10}"

usage() {
  cat <<'EOF'
usage: mesh-uvc-metadata [--test] [--device PATH] [--output PATH]
       mesh-uvc-metadata --parse FILE
  Capture one V4L2 UVC metadata buffer, or parse a captured stream as JSONL.
EOF
}

test_mode=0
parse_requested=0
parse_file=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --test) test_mode=1 ;;
    --parse) shift; [ "$#" -gt 0 ] || { echo 'mesh-uvc-metadata: --parse needs a file' >&2; exit 2; }; parse_requested=1; parse_file="$1" ;;
    --device) shift; [ "$#" -gt 0 ] || { echo 'mesh-uvc-metadata: --device needs a path' >&2; exit 2; }; DEV="$1" ;;
    --output) shift; [ "$#" -gt 0 ] || { echo 'mesh-uvc-metadata: --output needs a path' >&2; exit 2; }; OUT="$1" ;;
    -h|--help) usage; exit 0 ;;
    *) echo "mesh-uvc-metadata: unknown argument: $1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

parse_metadata() {
  local input="$1"
  command -v python3 >/dev/null 2>&1 || { echo 'mesh-uvc-metadata: python3 is required to parse UVCH records' >&2; return 2; }
  python3 - "$input" <<'PY'
import json
import struct
import sys

path = sys.argv[1]
try:
    with open(path, "rb") as stream:
        data = stream.read()
except OSError as exc:
    print(f"mesh-uvc-metadata: cannot read {path}: {exc}", file=sys.stderr)
    raise SystemExit(1)

records = []
offset = 0
while offset < len(data):
    remaining = len(data) - offset
    if remaining < 10:
        print(f"mesh-uvc-metadata: truncated UVC metadata prefix at byte {offset}", file=sys.stderr)
        raise SystemExit(1)
    timestamp_ns, sof, header_length, flags = struct.unpack_from("<QHBB", data, offset)
    if header_length < 2:
        print(f"mesh-uvc-metadata: invalid UVC header length {header_length} at byte {offset}", file=sys.stderr)
        raise SystemExit(1)
    record_size = 10 + header_length
    if remaining < record_size:
        print(f"mesh-uvc-metadata: truncated UVC metadata record at byte {offset}", file=sys.stderr)
        raise SystemExit(1)
    header_end = offset + record_size
    records.append({
        "timestamp_ns": timestamp_ns,
        "sof": sof,
        "header_length": header_length,
        "flags": flags,
        "payload_header_hex": data[offset + 10:header_end].hex(),
    })
    offset = header_end

if not records:
    print("mesh-uvc-metadata: no UVC metadata records", file=sys.stderr)
    raise SystemExit(1)
for record in records:
    print(json.dumps(record, separators=(",", ":")))
PY
}

if [ "$parse_requested" = 1 ]; then
  parse_metadata "$parse_file"
  exit $?
fi

command -v v4l2-ctl >/dev/null 2>&1 || { echo 'mesh-uvc-metadata: v4l2-ctl is required' >&2; exit 2; }
command -v timeout >/dev/null 2>&1 || { echo 'mesh-uvc-metadata: timeout is required' >&2; exit 2; }
command -v flock >/dev/null 2>&1 || { echo 'mesh-uvc-metadata: flock is required' >&2; exit 2; }
[ -e "$DEV" ] || { echo "mesh-uvc-metadata: no metadata device $DEV" >&2; exit 1; }
case "$TIMEOUT_S" in ''|*[!0-9]*) echo "mesh-uvc-metadata: invalid timeout '$TIMEOUT_S'" >&2; exit 2;; esac
[ "$TIMEOUT_S" -gt 0 ] || { echo "mesh-uvc-metadata: timeout must be positive" >&2; exit 2; }
case "$ATTEMPTS" in ''|*[!0-9]*) echo "mesh-uvc-metadata: invalid attempt count '$ATTEMPTS'" >&2; exit 2;; esac
[ "$ATTEMPTS" -gt 0 ] || { echo "mesh-uvc-metadata: attempt count must be positive" >&2; exit 2; }

# The scheduled collector and real --test reads must not open one endpoint at once.
# flock releases this descriptor automatically on exit, including after a signal.
LOCK_DIR="$HOME/.mesh/uvc-metadata/locks"
mkdir -p "$LOCK_DIR"
DEV_LOCK_KEY=${DEV//[^a-zA-Z0-9_.-]/_}
exec 9>"$LOCK_DIR/$DEV_LOCK_KEY.lock"
flock -x 9

probe() {
  local dest="$1" rc
  if timeout --signal=TERM --kill-after=2s "${TIMEOUT_S}s" \
      v4l2-ctl --device="$DEV" --stream-mmap --stream-count=1 --stream-to="$dest" >/dev/null 2>&1; then
    :
  else
    rc=$?
    if [ "$rc" -eq 124 ]; then
      echo "mesh-uvc-metadata: metadata read timed out after ${TIMEOUT_S}s from $DEV" >&2
    else
      echo "mesh-uvc-metadata: metadata read failed from $DEV (rc=$rc)" >&2
    fi
    return 1
  fi
  [ -s "$dest" ] || { echo "mesh-uvc-metadata: empty metadata buffer from $DEV" >&2; return 1; }
}

if [ "$test_mode" = 1 ]; then
  tmpdir=$(mktemp -d -t mesh-uvc-metadata.XXXXXX)
  trap 'rm -rf "$tmpdir"' EXIT
  for attempt in $(seq 1 "${MESH_UVC_METADATA_TEST_ATTEMPTS:-10}"); do
    if probe "$tmpdir/sample.bin"; then
      bytes=$(stat -c %s "$tmpdir/sample.bin")
      if ! parse_metadata "$tmpdir/sample.bin" >"$tmpdir/sample.jsonl"; then
        echo "mesh-uvc-metadata: live buffer from $DEV is not a complete UVCH metadata stream" >&2
        exit 1
      fi
      records=$(wc -l <"$tmpdir/sample.jsonl")
      echo "smoke-test: ok (real one-buffer metadata read: $bytes bytes, $records timestamped records from $DEV)"
      exit 0
    fi
    : >"$tmpdir/sample.bin"
    sleep 0.2
  done
  echo "smoke-test: FAIL (real metadata read from $DEV)" >&2
  exit 1
fi

OUT_JSONL="${MESH_UVC_METADATA_JSONL:-${OUT%.bin}.jsonl}"
mkdir -p "$(dirname "$OUT")" "$(dirname "$OUT_JSONL")"
tmp="${OUT}.tmp.$$"
tmp_json="${OUT_JSONL}.tmp.$$"
trap 'rm -f "$tmp" "$tmp_json"' EXIT
for attempt in $(seq 1 "$ATTEMPTS"); do
  # Failed reads can leave bytes behind. Start clean so only a complete, parsed read
  # can become either retained artifact.
  : >"$tmp"
  : >"$tmp_json"
  if probe "$tmp"; then
    if parse_metadata "$tmp" >"$tmp_json"; then
      mv -f "$tmp_json" "$OUT_JSONL"
      mv -f "$tmp" "$OUT"
      echo "mesh-uvc-metadata: captured $(stat -c %s "$OUT") bytes from $DEV -> $OUT and $OUT_JSONL (attempt $attempt/$ATTEMPTS)"
      exit 0
    fi
    echo "mesh-uvc-metadata: rejected malformed UVCH buffer from $DEV" >&2
  fi
  [ "$attempt" -eq "$ATTEMPTS" ] || sleep 0.2
done
exit 1
