#!/usr/bin/env bash
# mesh-uvc-metadata — consume one UVC metadata buffer from a V4L2 metadata endpoint.
# reflex-cadence: */10 * * * *
# reflex-artifact: ~/.mesh/uvc-metadata/latest.bin
# retired 2026-09-09: the metadata endpoint is intermittent and cannot provide
# a trustworthy liveness artifact; keep this probe available for explicit recovery work.
#
# The endpoint is not an image stream.  It is a real diagnostic artifact: one non-empty
# UVCH payload proves that the camera's metadata path is open and streaming.
#
#   mesh-uvc-metadata                 -> ~/.mesh/uvc-metadata/latest.bin
#   mesh-uvc-metadata --test           -> real one-buffer probe in a private temp file
#   MESH_UVC_METADATA_DEV=/dev/video1  -> select the metadata endpoint
set -euo pipefail

export PATH="$HOME/.local/bin:$PATH"
DEV="${MESH_UVC_METADATA_DEV:-/dev/video1}"
OUT="${MESH_UVC_METADATA_OUT:-$HOME/.mesh/uvc-metadata/latest.bin}"
TIMEOUT_S="${MESH_UVC_METADATA_TIMEOUT:-2}"

usage() {
  cat <<'EOF'
usage: mesh-uvc-metadata [--test] [--device PATH] [--output PATH]
  Read exactly one V4L2 UVC metadata buffer and retain a non-empty artifact.
EOF
}

test_mode=0
while [ "$#" -gt 0 ]; do
  case "$1" in
    --test) test_mode=1 ;;
    --device) shift; [ "$#" -gt 0 ] || { echo 'mesh-uvc-metadata: --device needs a path' >&2; exit 2; }; DEV="$1" ;;
    --output) shift; [ "$#" -gt 0 ] || { echo 'mesh-uvc-metadata: --output needs a path' >&2; exit 2; }; OUT="$1" ;;
    -h|--help) usage; exit 0 ;;
    *) echo "mesh-uvc-metadata: unknown argument: $1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

command -v v4l2-ctl >/dev/null 2>&1 || { echo 'mesh-uvc-metadata: v4l2-ctl is required' >&2; exit 2; }
command -v timeout >/dev/null 2>&1 || { echo 'mesh-uvc-metadata: timeout is required' >&2; exit 2; }
[ -e "$DEV" ] || { echo "mesh-uvc-metadata: no metadata device $DEV" >&2; exit 1; }
case "$TIMEOUT_S" in ''|*[!0-9]*) echo "mesh-uvc-metadata: invalid timeout '$TIMEOUT_S'" >&2; exit 2;; esac
[ "$TIMEOUT_S" -gt 0 ] || { echo "mesh-uvc-metadata: timeout must be positive" >&2; exit 2; }

probe() {
  local dest="$1" rc
  if timeout --signal=TERM --kill-after=2s "${TIMEOUT_S}s" \
      v4l2-ctl --device="$DEV" --stream-mmap --stream-count=1 --stream-to="$dest" >/dev/null 2>&1; then
    :
  else
    rc=$?
    if [ "$rc" -eq 124 ]; then
      echo "mesh-uvc-metadata: metadata read timed out after ${TIMEOUT_S}s from $DEV" >&2
    else
      echo "mesh-uvc-metadata: metadata read failed from $DEV (rc=$rc)" >&2
    fi
    return 1
  fi
  [ -s "$dest" ] || { echo "mesh-uvc-metadata: empty metadata buffer from $DEV" >&2; return 1; }
}

if [ "$test_mode" = 1 ]; then
  tmpdir=$(mktemp -d -t mesh-uvc-metadata.XXXXXX)
  trap 'rm -rf "$tmpdir"' EXIT
  for attempt in $(seq 1 "${MESH_UVC_METADATA_TEST_ATTEMPTS:-10}"); do
    if probe "$tmpdir/sample.bin"; then
      bytes=$(stat -c %s "$tmpdir/sample.bin")
      echo "smoke-test: ok (real one-buffer metadata read: $bytes bytes from $DEV)"
      exit 0
    fi
    : >"$tmpdir/sample.bin"
    sleep 0.2
  done
  echo "smoke-test: FAIL (real metadata read from $DEV)" >&2
  exit 1
fi

mkdir -p "$(dirname "$OUT")"
tmp="${OUT}.tmp.$$"
trap 'rm -f "$tmp"' EXIT
probe "$tmp" || exit 1
mv -f "$tmp" "$OUT"
echo "mesh-uvc-metadata: captured $(stat -c %s "$OUT") bytes from $DEV -> $OUT"
