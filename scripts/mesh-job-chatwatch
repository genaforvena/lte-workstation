#!/usr/bin/env python3
"""mesh-job-chatwatch — who has an open conversation with him on hh, and what it says.

  mesh-job-chatwatch [--tg] [--json] [--max N]
  mesh-job-chatwatch --check | --test

# reflex-cadence: 17 */2 * * *
# reflex-args: --tg

The operator asked for exactly this (TG 2026-08-28): «чтобы я видел вот там вот на хэндхантере
кто-то написал из работодателей ... общайтесь с ними там тоже вот в этом в чате». He had no such
channel. `mesh-job-track` sends him отклик-state deltas and `mesh-job-reply` answers приглашения —
but `mesh-job-reply.invited()` selects strictly the negotiations hh marks ПРИГЛАШЕНИЕ, so an
employer who simply WRITES is seen by nothing at all.

The cost of that blindness is measured, not supposed. Т-Банк vacancy 131423444 stood `Interview`
on 2026-08-21, is `rejected` today, and chat 5564836475 was never opened again after 21.08
(`hh-drive.log:26336` is its last read) — whatever Денис wrote between those two states was read
by nobody, and the operator was told nothing: `tg-sent.log` carries not one line naming that
employer after 21.08, while the neighbouring Т-Банк id went out in the 26.08 delta.

WHAT THIS TOOL CLAIMS, AND WHAT IT REFUSES TO CLAIM
---------------------------------------------------
* **It reports; it does not speak.** A message sent under his name is irreversible, so the first
  artifact is a summary TO HIM. Answering stays `mesh-job-reply`'s narrow, armed path.
* **The list cannot name an author, so this tool does not.** hh's chat list renders one preview
  line per conversation. `Vacancy application` means the last event is our own отклик; `Draft:`
  means WE left text unsent in that box; anything else is a real remark whose AUTHOR the list
  simply does not encode. Calling that «работодатель написал» would be a guess wearing a
  verdict's clothes, so the row says `кто-то написал` and carries `author=unknown` until the
  thread leg (not in this version) reads it. A name we did not measure is worse than no name.
* **The unread badge is never the trigger.** Opening a chat marks it read, and three tools plus
  any mind in a pane open chats in this one shared session — so the badge is a bit any reader can
  clear for every other. The trigger is the PREVIEW TEXT changing against our own state file.
* **Coverage rides with the reading.** The chat list is virtualised (~11 rows whatever its true
  length — the lesson `mesh-job-reply.chat_id_for` paid for), so a walk that stops early has seen
  a PREFIX. Every reading publishes rows-seen and whether the walk ended by exhaustion or by its
  own bound; a failed read renders UNKNOWN and never «никто не написал».
* **It stands down for the writer that owns the browser.** The hh driver is single-writer, and a
  `goto` issued while `mesh-job-apply` is mid-form breaks that form. A fresh `~/.mesh/job/.apply.lock`
  means someone else is driving: rc 2, say so, change nothing. (Its `since=` field is the literal
  string `now`, so the file's MTIME is the only usable age — read the mtime, never the field.)

State `~/.mesh/job/chatwatch-state.json`; ledger `~/.mesh/job/chatwatch-verdicts.log` — deliberately
NOT the cron stdout tape, which would double-count what the ledger already carries.
"""
import argparse, json, os, pathlib, re, subprocess, sys, time

os.environ["PATH"] = os.path.expanduser("~/.local/bin") + os.pathsep + os.environ.get("PATH", "/usr/bin:/bin")

HOME = pathlib.Path.home()
MESH = HOME / ".mesh"
JOB = MESH / "job"
STATE = JOB / "chatwatch-state.json"
LEDGER = JOB / "chatwatch-verdicts.log"
LOG = JOB / "hh-drive.log"
LOCK = JOB / ".apply.lock"
HH, TG = "mesh-hh-drive", "mesh-tg"

CHAT_URL = "https://hh.ru/chat"

# Conversations the lane must not touch, by chat id. Future Focus: the operator runs that recruiter
# himself in Telegram (@AlanHRR) and the hh chat was closed as a duplicate — reply-state.json says
# «НЕ ТРОГАТЬ». It is still REPORTED (he asked to SEE), never acted on.
HANDS_OFF = {"5551053686": "оператор ведёт сам в TG (@AlanHRR)"}


def node_env(key, default="off"):
    """Read a node-local switch from ~/.mesh/nodes WITHOUT sourcing it.

    cron hands a reflex an empty environment — no BASH_ENV, no login shell — so a gate reading
    os.environ alone is armed only in a mind's pane. Process env still wins, so a caller can
    override for one run. (Same reader as mesh-job-reply; the lane has no shared lib.)"""
    v = os.environ.get(key)
    if v is not None:
        return v
    try:
        txt = (HOME / ".mesh" / "nodes").read_text(encoding="utf-8", errors="replace")
    except Exception:
        return default
    hit = None
    for line in txt.splitlines():
        m = re.match(r"\s*(?:export\s+)?%s=[\"']?([^\"'#\s]*)" % re.escape(key), line)
        if m:
            hit = m.group(1)
    return hit if hit is not None else default


LOCK_AGE = int(node_env("MESH_JOB_CHATWATCH_LOCK_AGE", "900"))
SCROLLS = int(node_env("MESH_JOB_CHATWATCH_SCROLLS", "12"))


def drive(args, timeout=120):
    return subprocess.run([HH] + args, capture_output=True, text=True, timeout=timeout)


def js(expr, wait=24):
    """One JS expression in the shared browser -> its printed result.

    Reads the driver log from the offset it had BEFORE the send: the browser is shared, and a
    plain tail window slides past our answer whenever another writer is busy."""
    mark = LOG.stat().st_size if LOG.exists() else 0
    drive(["--send", "js " + expr])
    for _ in range(wait):
        time.sleep(2)
        with LOG.open("r", encoding="utf-8", errors="replace") as f:
            f.seek(mark)
            for line in f:
                if line.startswith("[js] "):
                    return line[len("[js] "):].rstrip("\n")
    return None


# Proven live in mesh-job-reply against this account: one row per conversation, id in the data-qa.
CHATS_JS = ('Array.from(document.querySelectorAll("[data-qa^=chatik-open-chat-]")).map('
            'e=>e.getAttribute("data-qa").replace("chatik-open-chat-","")+"|"+'
            'e.innerText.replace(/\\s+/g," ").slice(0,220)).join(" ;; ")')

SCROLL_JS = ('(function(){var l=document.querySelectorAll("[data-qa^=chatik-open-chat-]");'
             'if(!l.length)return "0";var c=l[0].parentElement;'
             'while(c&&c.scrollHeight<=c.clientHeight)c=c.parentElement;'
             'if(c)c.scrollTop=c.scrollHeight;return ""+l.length;})()')

LAST_FAIL = ""


def busy_writer():
    """-> reason string if another writer owns the hh driver, else ''.

    Bound to the lock's MTIME, never its `since=` field: that field is written as the literal
    string `now` and so can never age."""
    try:
        age = time.time() - LOCK.stat().st_mtime
    except FileNotFoundError:
        return ""
    if age < LOCK_AGE:
        return "hh-драйвер занят другим писателем (%s, возраст %ds < %ds)" % (
            LOCK.name, int(age), LOCK_AGE)
    return ""


def ensure_driver():
    if drive(["--alive"]).returncode != 0:
        drive(["--start"], timeout=180)


def classify(preview):
    """One chat-list preview -> (kind, text).

    Three kinds, and the third deliberately does NOT name an author — see the module docstring."""
    p = (preview or "").strip()
    m = re.search(r"\b(Draft|Черновик)\s*:\s*(.+)$", p)
    if m:
        return "draft", m.group(2).strip()
    if re.search(r"(Vacancy application|Отклик на вакансию)\s*$", p):
        return "applied", ""
    return "message", p


def read_chats():
    """-> (rows, complete, err). rows = [{chat, preview}]. complete=False means we saw a PREFIX.

    None rows is «could not read» and is NEVER «no chats»."""
    global LAST_FAIL
    ensure_driver()
    if drive(["--alive"]).returncode != 0:
        LAST_FAIL = "браузерный драйвер не поднялся (mesh-hh-drive --start)"
        return None, False, LAST_FAIL
    if drive(["--goto", CHAT_URL], timeout=180).returncode != 0:
        LAST_FAIL = "драйвер не дошёл до списка чатов"
        return None, False, LAST_FAIL
    time.sleep(5)
    seen, order, complete = {}, [], False
    for _ in range(SCROLLS):
        payload = js(CHATS_JS)
        if payload is None:
            LAST_FAIL = "страница ответила не списком чатов (браузер занят другим писателем?)"
            return (None, False, LAST_FAIL) if not seen else (
                [{"chat": c, "preview": seen[c]} for c in order], False, LAST_FAIL)
        for cell in payload.split(" ;; "):
            cid, _, txt = cell.partition("|")
            cid = cid.strip()
            if cid and cid not in seen:
                seen[cid] = txt.strip()
                order.append(cid)
        before = len(seen)
        js(SCROLL_JS)
        time.sleep(2)
        payload2 = js(CHATS_JS)
        for cell in (payload2 or "").split(" ;; "):
            cid, _, txt = cell.partition("|")
            cid = cid.strip()
            if cid and cid not in seen:
                seen[cid] = txt.strip()
                order.append(cid)
        # A virtualised list that has hit its end simply stops handing back new ids. That — not the
        # window's LENGTH, which stays ~11 rows however long the list is — is the exhaustion signal.
        if len(seen) == before:
            complete = True
            break
    return [{"chat": c, "preview": seen[c]} for c in order], complete, ""


def load():
    try:
        return json.loads(STATE.read_text(encoding="utf-8"))
    except Exception:
        return {}


def save(st):
    STATE.parent.mkdir(parents=True, exist_ok=True)
    STATE.write_text(json.dumps(st, ensure_ascii=False, indent=1), encoding="utf-8")


def ledger(line):
    LEDGER.parent.mkdir(parents=True, exist_ok=True)
    with LEDGER.open("a", encoding="utf-8") as f:
        f.write(time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()) + " " + line + "\n")


def digest(rows, st, cap):
    """Chat rows + our state -> (fresh, live). Pure: no browser, no clock beyond the stamp.

    Factored OUT of main so `--test` can DRIVE it. A gate that greps this file for the string
    `author` would be satisfied by the docstring that explains it and would stay green with the
    branch deleted — the source-text-gate trap CLAUDE.md names. The arms below run this function
    and read what it BUILT."""
    fresh, live = [], 0
    for r in rows[:cap]:
        cid, prev = r["chat"], r["preview"]
        kind, text = classify(prev)
        if kind == "applied":
            st.setdefault(cid, {})["preview"] = prev
            continue
        live += 1
        was = (st.get(cid) or {}).get("preview")
        if was != prev:
            fresh.append({"chat": cid, "kind": kind, "text": text, "preview": prev,
                          "author": "unknown", "hands_off": HANDS_OFF.get(cid, "")})
        st.setdefault(cid, {})["preview"] = prev
        st[cid]["seen"] = time.strftime("%Y-%m-%dT%H:%MZ", time.gmtime())
    return fresh, live


def coverage_word(rows, complete):
    return "полный" if complete else (
        "ПРЕФИКС %d строк (обход упёрся в свой предел, не в конец списка)" % len(rows))


def render_tg(fresh, cov):
    parts = ["hh-чаты, новое (охват: %s):" % cov]
    for f in fresh:
        if f["kind"] == "draft":
            parts.append("📝 chat/%s — В ЭТОМ ЧАТЕ ЛЕЖИТ НАШ НЕОТПРАВЛЕННЫЙ ЧЕРНОВИК: %s"
                         % (f["chat"], f["text"][:400]))
        else:
            parts.append("💬 chat/%s — кто-то написал; кто именно, список чатов не несёт, тред читаю "
                         "отдельно: %s%s" % (f["chat"], f["text"][:400],
                                             ("\n   ! " + f["hands_off"]) if f["hands_off"] else ""))
    return "\n".join(parts)


def selftest():
    ok = True

    def C(cond, label, detail=""):
        nonlocal ok
        ok = ok and bool(cond)
        print(("  ok   " if cond else "  FAIL ") + label + ((" — " + detail) if detail else ""))

    # (1) The three preview kinds, on the REAL strings hh rendered into hh-drive.log:56196.
    k, t = classify("Системный администратор Linux/SRE (DevOps) 13:10 ЕДИНЫЙ ЦУПИС "
                    "Draft: Здравствуйте. Go в продакшене под нагрузкой")
    C(k == "draft" and t.startswith("Здравствуйте"), "черновик распознан как draft", "%s/%s" % (k, t[:20]))
    k, _ = classify("Senior Golang разработчик 15:44 X5, Медиа Vacancy application")
    C(k == "applied", "«Vacancy application» — это наш отклик, а не их реплика", k)
    k, t = classify("Архитектор по ИИ (ML/AI/LLM) 15:46 Норникель Илья, благодарю Вас за уделенное время")
    C(k == "message" and "благодарю" in t, "реальная реплика опознана", k)

    # (2) THE central refusal, DRIVEN not grepped: a real remark is recorded with an UNKNOWN author,
    # and the sentence that reaches him never names one. The list encodes no author; naming one
    # would be a guess wearing a verdict's clothes, sent under his name.
    rows = [{"chat": "111", "preview": "Team Lead Go 12:00 Ромашка Илья, добрый день, когда удобно созвониться?"},
            {"chat": "222", "preview": "Senior Go 11:00 X5, Медиа Vacancy application"},
            {"chat": "333", "preview": "SRE 13:10 ЕДИНЫЙ ЦУПИС Draft: Здравствуйте. Go в продакшене"}]
    st = {}
    fresh, live = digest(rows, st, 40)
    C(len(fresh) == 2 and live == 2, "отклик без переписки не считается репликой", "fresh=%d live=%d" % (len(fresh), live))
    msg = [f for f in fresh if f["kind"] == "message"]
    C(msg and msg[0]["author"] == "unknown", "автор реплики записан unknown",
      msg[0]["author"] if msg else "нет message-строки")
    text = render_tg(fresh, "полный")
    C("работодатель написал" not in text, "в сообщении оператору нет чеканки «работодатель написал»")
    C("кто именно, список чатов не несёт" in text, "сообщение прямо говорит, что автор не измерен")

    # (3) Dedupe: the SAME preview must not reach him twice, a CHANGED one must.
    fresh2, _ = digest(rows, st, 40)
    C(fresh2 == [], "та же реплика второй раз оператору не уходит", "повторно: %d" % len(fresh2))
    rows[0]["preview"] = "Team Lead Go 12:40 Ромашка Илья, тогда завтра в 15:00?"
    fresh3, _ = digest(rows, st, 40)
    C(len(fresh3) == 1 and "завтра" in fresh3[0]["text"], "новая реплика проходит")

    # (4) Hands-off is REPORTED, not dropped — he asked to SEE, and silence about a chat he runs
    # himself would be this tool re-creating the very blindness it exists to end.
    rows4 = [{"chat": "5551053686", "preview": "Head of Engineering DSP 10:00 Future Focus Алан: добрый день"}]
    f4, _ = digest(rows4, {}, 40)
    C(len(f4) == 1 and f4[0]["hands_off"], "чат оператора попадает в сводку", str(f4 and f4[0]["hands_off"])[:40])
    C(f4[0]["hands_off"] in render_tg(f4, "полный"), "и несёт пометку «не трогать» в самом тексте")

    # (5) A read failure must render UNKNOWN, never «никто не написал». Driven with a dead driver.
    old = globals()["drive"]
    globals()["drive"] = lambda a, timeout=120: subprocess.CompletedProcess(a, 1, "", "")
    try:
        r, complete, err = read_chats()
    finally:
        globals()["drive"] = old
    C(r is None and err, "мёртвый драйвер -> UNKNOWN", repr(err)[:60])
    C(r != [], "отказ чтения НЕ рендерится как «чатов нет»")

    # (6) Coverage is a FIELD: a walk cut short by its own bound says PREFIX, and the word reaches
    # the operator inside the message rather than living in a log he never reads.
    C("ПРЕФИКС" in coverage_word([1, 2, 3], False) and coverage_word([], True) == "полный",
      "неполный обход публикуется как префикс")
    C("ПРЕФИКС" in render_tg(fresh3, coverage_word([1, 2, 3], False)),
      "охват едет вместе со сводкой оператору")

    # (7) The stand-down for the writer that owns the browser, and WHY it reads mtime: the lock's
    # own `since=` field is the literal string `now`, so a tool trusting it can never see age.
    import tempfile
    with tempfile.TemporaryDirectory() as d:
        p = pathlib.Path(d) / ".apply.lock"
        p.write_text("pid=probe mode=selftest-holder since=now\n", encoding="utf-8")
        globals()["LOCK"] = p
        C(busy_writer(), "свежий замок -> стоп")
        os.utime(p, (time.time() - LOCK_AGE - 60,) * 2)
        aged = busy_writer()
        C(not aged, "протухший замок не блокирует навсегда")
        C("since=now" in p.read_text(encoding="utf-8") and not aged,
          "решает MTIME, а не поле since= (оно литерал и не стареет)")
        globals()["LOCK"] = JOB / ".apply.lock"

    print("mesh-job-chatwatch --test: " + ("ok" if ok else "FAILED"))
    return 0 if ok else 1


def main():
    ap = argparse.ArgumentParser(prog="mesh-job-chatwatch")
    ap.add_argument("--tg", action="store_true")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--max", type=int, default=40)
    ap.add_argument("--check", action="store_true")
    ap.add_argument("--test", action="store_true")
    a = ap.parse_args()

    if a.test:
        sys.exit(selftest())
    if a.check:
        print("MESH_JOB_CHATWATCH_LOCK_AGE=%s" % LOCK_AGE)
        print("MESH_JOB_CHATWATCH_SCROLLS=%s" % SCROLLS)
        print("замок: %s" % (busy_writer() or "свободен"))
        print("состояние: %s (%d чатов известно)" % (STATE, len(load())))
        sys.exit(0)

    why = busy_writer()
    if why:
        print("mesh-job-chatwatch: n/a — " + why, file=sys.stderr)
        ledger("STANDDOWN %s" % why)
        sys.exit(2)

    rows, complete, err = read_chats()
    if rows is None:
        print("mesh-job-chatwatch: n/a — " + (err or "чтение списка чатов не удалось"), file=sys.stderr)
        ledger("UNKNOWN %s" % (err or "read failed"))
        sys.exit(2)

    st = load()
    fresh, live = digest(rows, st, a.max)
    save(st)
    cov = coverage_word(rows, complete)
    ledger("READ rows=%d coverage=%s live=%d new=%d" % (
        len(rows), "full" if complete else "prefix", live, len(fresh)))

    if a.json:
        print(json.dumps({"rows": len(rows), "complete": complete, "live": live, "new": fresh},
                         ensure_ascii=False, indent=1))
    else:
        print("чатов прочитано: %d (охват: %s) · с перепиской: %d · новых реплик: %d"
              % (len(rows), cov, live, len(fresh)))
        for f in fresh:
            print("  %-8s chat/%s  %s%s" % (f["kind"], f["chat"], f["text"][:120],
                                            ("  [%s]" % f["hands_off"]) if f["hands_off"] else ""))
    if a.tg and fresh:
        subprocess.run([TG, render_tg(fresh, cov)], capture_output=True, text=True)
    sys.exit(0)


if __name__ == "__main__":
    main()
