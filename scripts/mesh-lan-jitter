#!/usr/bin/env bash
# mesh-lan-jitter — gateway RTT JITTER / bufferbloat sense: delay-VARIANCE of the local path.
#
# WHY this is a NEW, distinct real-world signal (senses 2026-07-03): the existing network senses read
# reachability (mesh-lan-health: 1 ping, up/down), own-link RF (mesh-wifi-quality: RSSI/missed beacons),
# L2 drops (mesh-nic-drops) and end-to-end loss (mesh-tcp-retrans). NONE of them perceive delay
# variance — the WiFi airtime contention + router queue depth that makes interactive SSH laggy and
# wobbles RSSI while every reachability check stays green. A 10-ping burst to the default gateway
# measures it directly: mdev IS the jitter, a fat max/min spread IS the bloated queue.
#
# Output (stdout, one line; first token is the verdict — cross-sense vocab contract):
#   CLEAN   gw=<ip> rtt=<min>/<avg>/<max>ms mdev=<m>ms loss=<l>% n=<sent>
#           window=<burst s> cadence=<period s>/<wired|declared> coverage=<window/cadence %> @ <host> <ts>
#   WOBBLY  …  (mdev ≥5ms or max ≥50ms or any loss — contention visible)
#   BLOATED …  (mdev ≥20ms or max ≥200ms — deep queues / airtime starvation)
#   LOSSY   …  (≥20% of the burst lost — beyond jitter, the path is shedding)
# Exit 2 (honest n/a, stderr): no default route, no ping, or the whole burst lost
#   (gateway dark is lan-health's finding — jitter over 0 replies would be a faked reading).
#
# WHY THE READING CARRIES ITS OWN COVERAGE (senses 2026-08-22): the line used to end at `n=10`,
# naming the sample COUNT and nothing about the SPAN it stands for. 10 pings at 0.2s is a ~1.8s
# burst on a 900s cadence — 0.2% of the interval — so `CLEAN` was silently being read as a state
# when it is a sample, and the bursty RTL8822BU flush-queue stalls this sense would catch live in
# the other 99.8%. `window=`/`cadence=`/`coverage=` are now fields, derived per-run (see below), so
# a reader can tell `CLEAN` from `CLEAN over 0.20% of the interval`. The burst was deliberately NOT
# widened: the dongle carries this node's SOLE uplink, and disclosing the sampling is free where
# more radio time is not.
#
# STATE (~/.mesh/.lan-jitter): rewritten UNCONDITIONALLY every run — INCLUDING the unattestable
# ones, where it records the band UNREACHABLE with its reason (mtime = ran-live; no change-gating,
# so no state-touch subtlety). Verdict-band changes append to ~/.mesh/lan-jitter.log; --edge prints
# only on a band change (cron mode).
#
# WHY UNREACHABLE is a RECORDED BAND, not the absence of a record (senses 2026-08-21): the three
# exit-2 paths used to return without writing anything, so the durable tier kept the last POSITIVE
# verdict standing while the gateway was dark — measured here, .lan-jitter read `CLEAN … loss=0%`
# from 10:08Z through a 75-minute gateway blackout whose only trace was 4 stderr lines in the cron
# log. Two wrong readings from one omission: a reader gets a stale all-clear, and the frozen mtime
# ages as if the reflex were DEAD while it was running and honest. "Cannot attest" is a state; it
# gets written like one, and its transitions (X -> UNREACHABLE, UNREACHABLE -> X) land in the log.
#
# reflex-cadence: 8-59/15 * * * *
# reflex-args: --edge
set -uo pipefail

STATE="${MESH_JITTER_STATE:-$HOME/.mesh/.lan-jitter}"
LOG="${MESH_JITTER_LOG:-$HOME/.mesh/lan-jitter.log}"
N="${MESH_JITTER_N:-10}"           # pings per burst
IVL="${MESH_JITTER_IVL:-0.2}"      # inter-ping interval (s) — non-root floor
HOSTN="$(hostname)"
now_ts() { date -u +%Y-%m-%dT%H:%M:%SZ; }

EDGE=0
[ "${1:-}" = "--edge" ] && { EDGE=1; shift; }

# --- cadence / window / coverage -------------------------------------------
# A sense whose burst window is narrower than its cadence reports a SAMPLE, not a state
# (CLAUDE.md), so the reading publishes its own coverage = window / cadence. BOTH sides are
# DERIVED, never constants that rot: the window is ping's OWN reported elapsed time (falling
# back to the (N-1)*IVL the flags imply), and the cadence is parsed from the LIVE wired cron
# line for this tool, falling back to this file's own `# reflex-cadence:` header — the source
# is published beside the number (`cadence=900s/wired` vs `/declared`) because a cadence the
# node does not actually run is a claim about intent, not about what was observed. Retune N,
# IVL or the cron line and the published coverage moves with it. Missing evidence renders
# `na`, never 0.
CRONF="${MESH_JITTER_CRON:-$HOME/.mesh/reflexes.cron}"

cron_period_secs() {  # $1 = 5-field cron spec -> seconds between fires, or "" if not a simple period
  awk -v spec="$1" '
    function expand(f, lo, hi, out,   n,parts,i,it,step,a,b,j,s2,s3) {
      n = split(f, parts, ",")
      for (i = 1; i <= n; i++) {
        it = parts[i]; step = 1
        if (index(it, "/") > 0) { split(it, s2, "/"); it = s2[1]; step = s2[2] + 0; if (step < 1) return 0 }
        if (it == "*") { a = lo; b = hi }
        else if (index(it, "-") > 0) { split(it, s3, "-"); if (s3[1] !~ /^[0-9]+$/ || s3[2] !~ /^[0-9]+$/) return 0; a = s3[1] + 0; b = s3[2] + 0 }
        else { if (it !~ /^[0-9]+$/) return 0; a = it + 0; b = a }
        if (a < lo || b > hi || b < a) return 0
        for (j = a; j <= b; j += step) out[j] = 1
      }
      return 1
    }
    BEGIN {
      if (split(spec, F, /[ \t]+/) != 5) exit 1
      if (F[3] != "*" || F[4] != "*" || F[5] != "*") exit 1   # dom/mon/dow restricted -> not a plain period
      if (!expand(F[1], 0, 59, MIN)) exit 1
      if (!expand(F[2], 0, 23, HR))  exit 1
      k = 0
      for (h = 0; h <= 23; h++) { if (!(h in HR)) continue
        for (m = 0; m <= 59; m++) { if (!(m in MIN)) continue; fire[k++] = h * 60 + m } }
      if (k < 1) exit 1
      # a single fire per day still has a gap: the day wrap (a stepped range CAN collapse to one fire)
      for (i = 0; i < k; i++) gap[i] = (i + 1 < k ? fire[i+1] - fire[i] : fire[0] + 1440 - fire[i])
      for (i = 0; i < k; i++) for (j = i + 1; j < k; j++) if (gap[j] < gap[i]) { t = gap[i]; gap[i] = gap[j]; gap[j] = t }
      printf "%d\n", gap[int(k / 2)] * 60      # median gap between fires, in seconds
    }' 2>/dev/null
}

resolve_cadence() {  # sets CAD_S (seconds, may be empty) and CAD_F (published field value)
  local self line hdr
  CAD_S=""; local src="none"
  self="$(basename "$0")"
  if [ -r "$CRONF" ]; then
    line="$(grep -v '^[[:space:]]*#' "$CRONF" 2>/dev/null | grep -E "(^|/|[[:space:]])${self}([[:space:]]|\$)" | head -1)"
    if [ -n "$line" ]; then
      CAD_S="$(cron_period_secs "$(printf '%s\n' "$line" | awk '{print $1, $2, $3, $4, $5}')")"
      [ -n "$CAD_S" ] && src="wired"
    fi
  fi
  if [ -z "$CAD_S" ]; then
    hdr="$(sed -n 's/^# reflex-cadence:[[:space:]]*//p' "$0" 2>/dev/null | head -1)"
    if [ -n "$hdr" ]; then
      CAD_S="$(cron_period_secs "$hdr")"
      [ -n "$CAD_S" ] && src="declared"
    fi
  fi
  if [ -n "$CAD_S" ]; then CAD_F="${CAD_S}s/$src"; else CAD_F="na"; fi
}

win_secs() {  # $1 = ping transcript -> MEASURED elapsed seconds; falls back to the flags' implied window
  local ms
  ms="$(printf '%s\n' "${1:-}" | grep -oE 'time [0-9]+ms' | tail -1 | grep -oE '[0-9]+')"
  if [ -n "$ms" ]; then awk -v x="$ms" 'BEGIN{printf "%.2f", x/1000}'
  else awk -v n="$N" -v i="$IVL" 'BEGIN{printf "%.2f", (n-1)*i}'; fi
}

cov_pct() {  # $1 = window s, $2 = cadence s -> "0.20%" or na (never a fabricated 0)
  [ -n "${1:-}" ] && [ -n "${2:-}" ] || { echo na; return; }
  awk -v w="$1" -v c="$2" 'BEGIN{ if (c+0 <= 0) { print "na"; exit } printf "%.2f%%", 100*w/c }'
}

# --- classify: pure numeric → verdict token (testable without any ping) ---
classify() {  # $1=mdev(ms) $2=max(ms) $3=loss(%)
  awk -v m="$1" -v x="$2" -v l="$3" 'BEGIN{
    if (l >= 20)            { print "LOSSY";   exit }
    if (m >= 20 || x >= 200){ print "BLOATED"; exit }
    if (m >= 5 || x >= 50 || l > 0) { print "WOBBLY"; exit }
    print "CLEAN"
  }'
}

# --- --test ----------------------------------------------------------------
if [ "${1:-}" = "--test" ]; then
  fails=0; n=0
  ok() { n=$((n+1)); }
  bad() { n=$((n+1)); fails=$((fails+1)); echo "FAIL: $1" >&2; }

  # classifier bands (falsifiable: these flip if thresholds move)
  [ "$(classify 1.2 8.0 0)" = CLEAN ]     && ok || bad "classify clean"
  [ "$(classify 6.0 30 0)" = WOBBLY ]     && ok || bad "classify wobbly mdev"
  [ "$(classify 2.0 60 0)" = WOBBLY ]     && ok || bad "classify wobbly max"
  [ "$(classify 2.0 20 10)" = WOBBLY ]    && ok || bad "classify wobbly loss"
  [ "$(classify 25 100 0)" = BLOATED ]    && ok || bad "classify bloated mdev"
  [ "$(classify 3.0 250 0)" = BLOATED ]   && ok || bad "classify bloated max"
  [ "$(classify 1.0 10 30)" = LOSSY ]     && ok || bad "classify lossy"

  # coverage derivation — falsifiable: move the cron spec and these numbers MUST move
  [ "$(cron_period_secs '8-59/15 * * * *')" = 900 ]   && ok || bad "cron period 8-59/15"
  [ "$(cron_period_secs '*/5 * * * *')" = 300 ]       && ok || bad "cron period */5"
  [ "$(cron_period_secs '7 * * * *')" = 3600 ]        && ok || bad "cron period hourly"
  [ "$(cron_period_secs '0 3 * * *')" = 86400 ]       && ok || bad "cron period daily (single fire = day wrap)"
  [ "$(cron_period_secs '8-20/15 * * * *')" = 3600 ]  && ok || bad "stepped range collapsing to one fire"
  [ -z "$(cron_period_secs '0 3 * * 1')" ]            && ok || bad "dow-restricted must claim no period"
  [ -z "$(cron_period_secs '@daily')" ]               && ok || bad "non-5-field spec must claim no period"
  [ "$(cov_pct 1.81 900)" = "0.20%" ]                 && ok || bad "cov_pct arithmetic"
  [ "$(cov_pct 1.81 '')" = na ]                       && ok || bad "cov_pct na without a cadence"
  [ "$(N=10 IVL=0.2 win_secs 'rtt min/avg/max/mdev = 1/2/3/4 ms')" = "1.80" ] && ok || bad "win_secs fallback to (N-1)*IVL"
  [ "$(win_secs '10 packets transmitted, 10 received, 0% packet loss, time 1810ms')" = "1.81" ] && ok || bad "win_secs measured"

  # sandboxed e2e via PATH stubs (mock ping + ip — NO real burst; the tool has no PATH self-export
  # so the stub dir stays first). Mirrors mesh-lan-health's mock idiom.
  _td="$(mktemp -d)"; trap 'rm -rf "$_td"' EXIT
  printf '#!/bin/sh\necho default via 192.168.8.1 dev wlp0 proto dhcp\n' > "$_td/ip"
  printf '#!/bin/sh\nprintf "10 packets transmitted, 10 received, 0%%%% packet loss, time 1810ms\\nrtt min/avg/max/mdev = 1.234/2.345/8.901/1.567 ms\\n"\n' > "$_td/ping"
  chmod +x "$_td/ip" "$_td/ping"
  printf '%s\n' '8-59/15 * * * * /stub/mesh-lan-jitter --edge' > "$_td/cron"
  export MESH_JITTER_CRON="$_td/cron"
  out1="$(PATH="$_td:$PATH" MESH_JITTER_STATE="$_td/state" MESH_JITTER_LOG="$_td/log" bash "$0")"; rc1=$?
  case "$out1" in CLEAN\ gw=192.168.8.1\ rtt=1.234/2.345/8.901ms\ mdev=1.567ms\ loss=0%*) ok;; *) bad "mock clean line: '$out1'";; esac
  [ $rc1 -eq 0 ] && ok || bad "mock clean rc=$rc1"
  [ -s "$_td/state" ] && ok || bad "STATE not written"
  # window/coverage published as FIELDS (the sample-vs-state disclosure), derived from the live spec
  case "$out1" in *" n=10 window=1.81s cadence=900s/wired coverage=0.20% @ "*) ok;; *) bad "no window/coverage fields: '$out1'";; esac
  grep -q ' window=1.81s cadence=900s/wired coverage=0.20% ' "$_td/state" && ok || bad "STATE missing window/coverage"
  # ROT GATE: retune the wired cadence and the published coverage MUST follow (never a constant)
  printf '%s\n' '*/5 * * * * /stub/mesh-lan-jitter --edge' > "$_td/cron"
  out1b="$(PATH="$_td:$PATH" MESH_JITTER_STATE="$_td/state2" MESH_JITTER_LOG="$_td/log2" bash "$0")"
  case "$out1b" in *" cadence=300s/wired coverage=0.60% @ "*) ok;; *) bad "coverage not re-derived from the live cron: '$out1b'";; esac
  # cron naming no tool -> fall back to this file's own declared header, and SAY so
  : > "$_td/cron"
  out1c="$(PATH="$_td:$PATH" MESH_JITTER_STATE="$_td/state2" MESH_JITTER_LOG="$_td/log2" bash "$0")"
  case "$out1c" in *" cadence=900s/declared coverage=0.20% @ "*) ok;; *) bad "header fallback not used: '$out1c'";; esac
  # a COMMENTED cron line is a tombstone, not a wiring — it must not be read as wired
  printf '%s\n' '#8-59/15 * * * * /stub/mesh-lan-jitter --edge' > "$_td/cron"
  out1d="$(PATH="$_td:$PATH" MESH_JITTER_STATE="$_td/state2" MESH_JITTER_LOG="$_td/log2" bash "$0")"
  case "$out1d" in *" cadence=900s/declared "*) ok;; *) bad "commented cron line read as wired: '$out1d'";; esac
  printf '%s\n' '8-59/15 * * * * /stub/mesh-lan-jitter --edge' > "$_td/cron"
  # --edge same band → silent, exit 0, STATE mtime still refreshed
  touch -d '2000-01-01' "$_td/state"
  out2="$(PATH="$_td:$PATH" MESH_JITTER_STATE="$_td/state" MESH_JITTER_LOG="$_td/log" bash "$0" --edge)"; rc2=$?
  [ $rc2 -eq 0 ] && [ -z "$out2" ] && ok || bad "edge unchanged not silent (rc=$rc2 out=$out2)"
  [ "$(find "$_td/state" -newermt '2020-01-01' | wc -l)" = 1 ] && ok || bad "STATE mtime not refreshed on suppressed edge run"
  # band change → --edge fires + log gains the transition
  printf '#!/bin/sh\nprintf "10 packets transmitted, 10 received, 0%%%% packet loss, time 1810ms\\nrtt min/avg/max/mdev = 2.0/15.0/250.0/30.0 ms\\n"\n' > "$_td/ping"
  out3="$(PATH="$_td:$PATH" MESH_JITTER_STATE="$_td/state" MESH_JITTER_LOG="$_td/log" bash "$0" --edge)"
  case "$out3" in BLOATED\ *) ok;; *) bad "edge fire on band change: '$out3'";; esac
  grep -q 'CLEAN -> BLOATED' "$_td/log" && ok || bad "band transition not logged"
  # whole burst lost → honest exit 2, no verdict — AND the unattestable state is RECORDED.
  # Regression gate for the stale positive: $_td/state still holds BLOATED from the run above,
  # and before the 2026-08-21 fix this run left that POSITIVE standing with a frozen mtime.
  printf '#!/bin/sh\nprintf "10 packets transmitted, 0 received, 100%%%% packet loss, time 1810ms\\n"\n' > "$_td/ping"
  touch -d '2000-01-01' "$_td/state"
  out4="$(PATH="$_td:$PATH" MESH_JITTER_STATE="$_td/state" MESH_JITTER_LOG="$_td/log" bash "$0" 2>/dev/null)"; rc4=$?
  [ $rc4 -eq 2 ] && [ -z "$out4" ] && ok || bad "all-lost burst must exit 2 (rc=$rc4 out=$out4)"
  [ "$(head -1 "$_td/state" | awk '{print $1}')" = UNREACHABLE ] \
    && ok || bad "all-lost burst left a STALE POSITIVE in STATE: '$(head -1 "$_td/state")'"
  [ "$(find "$_td/state" -newermt '2020-01-01' | wc -l)" = 1 ] \
    && ok || bad "STATE mtime not refreshed on an unattestable run (reads as a DEAD reflex)"
  grep -q 'BLOATED -> UNREACHABLE' "$_td/log" && ok || bad "entry into UNREACHABLE not logged"
  # second consecutive unattestable run → mtime re-touched, but NO duplicate transition line
  touch -d '2000-01-01' "$_td/state"
  PATH="$_td:$PATH" MESH_JITTER_STATE="$_td/state" MESH_JITTER_LOG="$_td/log" bash "$0" 2>/dev/null
  [ "$(find "$_td/state" -newermt '2020-01-01' | wc -l)" = 1 ] \
    && [ "$(grep -c 'BLOATED -> UNREACHABLE' "$_td/log")" = 1 ] \
    && ok || bad "repeat unattestable: mtime must refresh, transition must not repeat"
  # recovery → the way BACK out of UNREACHABLE is a logged transition and an --edge fire
  printf '#!/bin/sh\nprintf "10 packets transmitted, 10 received, 0%%%% packet loss, time 1810ms\\nrtt min/avg/max/mdev = 1.234/2.345/8.901/1.567 ms\\n"\n' > "$_td/ping"
  out4b="$(PATH="$_td:$PATH" MESH_JITTER_STATE="$_td/state" MESH_JITTER_LOG="$_td/log" bash "$0" --edge)"
  case "$out4b" in CLEAN\ *) ok;; *) bad "recovery from UNREACHABLE must fire an edge: '$out4b'";; esac
  grep -q 'UNREACHABLE -> CLEAN' "$_td/log" && ok || bad "exit from UNREACHABLE not logged"
  # no default route → honest exit 2, and it records rather than freezing
  printf '#!/bin/sh\nexit 0\n' > "$_td/ip"
  out5="$(PATH="$_td:$PATH" MESH_JITTER_STATE="$_td/state3" MESH_JITTER_LOG="$_td/log3" bash "$0" 2>/dev/null)"; rc5=$?
  [ $rc5 -eq 2 ] && ok || bad "no-gateway must exit 2 (rc=$rc5)"
  case "$(cat "$_td/state3" 2>/dev/null)" in UNREACHABLE\ reason=no\ default\ route*) ok;; *) bad "no-gateway did not record its state: '$(cat "$_td/state3" 2>/dev/null)'";; esac

  # REAL-READ gate: a live burst must yield a real verdict (rc 0, known first token) or honest rc 2.
  live="$(MESH_JITTER_STATE="$_td/lstate" MESH_JITTER_LOG="$_td/llog" bash "$0" 2>&1)"; lrc=$?
  if [ $lrc -eq 0 ]; then
    case "$live" in CLEAN\ *|WOBBLY\ *|BLOATED\ *|LOSSY\ *) ok;; *) bad "live line malformed: $live";; esac
  elif [ $lrc -eq 2 ]; then ok  # honest n/a (no route / gateway dark)
  else bad "live burst rc=$lrc: $live"; fi

  if [ $fails -eq 0 ]; then echo "mesh-lan-jitter --test: ok — $n assertions [7 classify + 11 coverage + 21 mock-e2e + 1 live]"; exit 0
  else echo "mesh-lan-jitter --test: $fails/$n FAILED" >&2; exit 1; fi
fi

# --- main --------------------------------------------------------------------
# Record "cannot attest" as a STATE, then exit 2 (honest n/a — stdout stays verdict-only, so the
# cross-sense vocab contract is untouched and mesh-land still reads exit 2 as a pass).
unattestable() {  # $1 = reason
  local ts prev
  ts="$(now_ts)"
  prev="$(head -1 "$STATE" 2>/dev/null | awk '{print $1}')"
  mkdir -p "$(dirname "$STATE")" 2>/dev/null
  printf '%s\n' "UNREACHABLE reason=$1 window=na cadence=$CAD_F coverage=na @ $HOSTN $ts" > "$STATE"
  if [ "${prev:-}" != UNREACHABLE ]; then
    [ -n "${prev:-}" ] && echo "[lan-jitter] $prev -> UNREACHABLE UNREACHABLE reason=$1 window=na cadence=$CAD_F coverage=na @ $HOSTN $ts" >> "$LOG" \
                       || echo "[lan-jitter] FIRST UNREACHABLE reason=$1 window=na cadence=$CAD_F coverage=na @ $HOSTN $ts" >> "$LOG"
  fi
  echo "lan-jitter: UNREACHABLE ($1)" >&2
  exit 2
}

resolve_cadence
command -v ping >/dev/null 2>&1 || unattestable "no ping binary"
gw="$(ip route show default 2>/dev/null | awk '/default/ {print $3; exit}')"
[ -n "$gw" ] || unattestable "no default route — cannot pick a gateway"

burst="$(ping -c "$N" -i "$IVL" -W 1 "$gw" 2>/dev/null)" || true
loss="$(printf '%s\n' "$burst" | grep -o '[0-9.]*% packet loss' | head -1 | tr -d '% ' | sed 's/packetloss//')"
rtt="$(printf '%s\n' "$burst" | awk -F'= ' '/min\/avg\/max/ {print $2; exit}')"   # "1.2/2.3/8.9/1.5 ms"
if [ -z "$rtt" ] || [ "${loss:-100}" = 100 ]; then
  unattestable "burst to $gw got no replies — gateway dark; jitter unattestable"
fi
rtt="${rtt%% *}"
IFS=/ read -r rmin ravg rmax rmdev <<EOF
$rtt
EOF
loss="${loss:-0}"

band="$(classify "$rmdev" "$rmax" "$loss")"
win="$(win_secs "$burst")"
cov="$(cov_pct "$win" "$CAD_S")"
line="$band gw=$gw rtt=$rmin/$ravg/${rmax}ms mdev=${rmdev}ms loss=$loss% n=$N window=${win}s cadence=$CAD_F coverage=$cov @ $HOSTN $(now_ts)"

prev_band="$(head -1 "$STATE" 2>/dev/null | awk '{print $1}')"
mkdir -p "$(dirname "$STATE")" 2>/dev/null
printf '%s\n' "$line" > "$STATE"

if [ "$band" != "${prev_band:-}" ]; then
  [ -n "${prev_band:-}" ] && echo "[lan-jitter] $prev_band -> $band $line" >> "$LOG" \
                          || echo "[lan-jitter] FIRST $line" >> "$LOG"
  echo "$line"
  exit 0
fi

[ "$EDGE" = 1 ] && exit 0
echo "$line"
