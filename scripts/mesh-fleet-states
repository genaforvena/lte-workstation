#!/usr/bin/env bash
# mesh-fleet-states — every node's edge-trigger reflex states, re-derived live over SSH.
# The fleet's nervous system at a glance: per node, each ~/.mesh/.*-state artifact (value + age).
# PERCEIVE-ANEW: nothing cached — each call walks the live artifacts on every reachable node, so
# a new reflex on ANY node shows up here with zero edits. Consumed by `mesh-dash organs`.
# HONEST-FUSION: an unreachable node prints (ssh fail) — visibly different from (no edge states).
# --likelihood: report-only mode that forwards each sense's TAPE (last-write age + last line) beside
#   its committed value, so a receiver can tell a peer's CONCLUSION from a peer's OBSERVATION.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"

# runs ON each node (pure builtins + stat — survives thin non-login SSH PATH)
REMOTE_SNIPPET='now=$(date +%s); for f in "$HOME"/.mesh/.[a-z]*-state; do
  [ -f "$f" ] || continue; n="${f##*/}"; n="${n#.}"
  case "$n" in mind-state-*) continue;; esac
  m=$(stat -c %Y "$f" 2>/dev/null) || continue
  printf "%s|%s|%s\n" "${n%-state}" "$(head -c 30 "$f" 2>/dev/null | tr "\n|" "  ")" "$((now-m))"
done'

# LIKELIHOOD-SHARING WALK (--likelihood, report-only; the default render is untouched).
# A `.*-state` artifact is a POSTERIOR: an edge-triggered reflex commits it under debounce, and the
# liveness-touch convention re-stamps its mtime on EVERY successful eval. So the two numbers the
# default render carries (value, age) are (sender's prior (+) sender's observation) and (sender's last
# EVAL) — a receiver cannot recover the observation or when it happened. Belief-sharing under active
# inference has a name for that failure and a fix: share the LIKELIHOOD message (your reading of your
# own raw observation), not the posterior, else the receiver inherits the sender's prior as if it were
# evidence (Catal, Van de Maele, Pitliya, Albarracin, Pattisapu & Verbelen, "Belief sharing: a blessing
# or a curse", arXiv:2407.02465, eq. 4 — echo chambers and self-doubt).
# This mode forwards the sense's own TAPE alongside its committed value: the tape's last-write age and
# its last line. Honest naming — `tape` is the last APPEND to the sense's log, NOT necessarily its last
# observation (an edge-gated tape writes only on change); it is the nearest thing to a likelihood the
# mesh persists. A sense with no non-empty tape renders `post-only`: the mesh keeps its conclusion and
# nothing else, so a receiver has no way to weigh it.
# It also walks BOTH suffix families (`.x-state` AND `.x.state`) — the default snippet globs only
# `-state`, leaving the `.state` family invisible cross-node. Widening is confined to this opt-in mode
# so `mesh-dash organs` keeps its exact contract.
LIK_SNIPPET='now=$(date +%s); for f in "$HOME"/.mesh/.[a-z]*-state "$HOME"/.mesh/.[a-z]*.state; do
  [ -f "$f" ] || continue; n="${f##*/}"; n="${n#.}"
  case "$n" in mind-state-*) continue;; esac
  n="${n%-state}"; n="${n%.state}"
  m=$(stat -c %Y "$f" 2>/dev/null) || continue
  v=$(head -c 30 "$f" 2>/dev/null | tr "\n|" "  ")
  t=""; for c in "$HOME/.mesh/$n.log" "$HOME/.mesh/$n-tape.log"; do
    [ -s "$c" ] && { t="$c"; break; }
  done
  if [ -n "$t" ]; then
    tm=$(stat -c %Y "$t" 2>/dev/null || echo 0); ta=$((now-tm))
    ex=$(tail -n 1 "$t" 2>/dev/null | tr "\n|" "  " | cut -c1-46)
  else ta=-1; ex=""; fi
  printf "%s|%s|%s|%s|%s\n" "$n" "$v" "$((now-m))" "$ta" "$ex"
done'

# BODY LAN-FALLBACK: the phone drops off the tailnet often but stays reachable on the home LAN
# (PHONE_LAN_IPS, SSH 8022 as u0_a380). Emitting "(offline)" from the raw Tailscale Online flag is a
# FALSE NEGATIVE — the phone's edge states then read 'body dark' while its sensors produce live data.
# For the phone host only, when Tailscale says not-Online, probe a real LAN-reachable IP and (if found)
# walk its edge states over THAT IP. Echoes the reachable IP + rc 0, else rc 1.
# MESH_PHONE_LAN_PROBE=<cmd> overrides the probe (<cmd> <host> -> echo ip + exit 0) — used by --test.
phone_lan_ip(){
  case "$1" in *[Rr]edmi*|phone|Redmi) ;; *) return 1 ;; esac
  [ -n "${MESH_PHONE_LAN_PROBE:-}" ] && { "$MESH_PHONE_LAN_PROBE" "$1" 2>/dev/null; return; }
  ( export PATH="$HOME/.local/bin:$PATH"
    [ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes" 2>/dev/null
    command -v phone_reachable_ip >/dev/null 2>&1 || . "$HOME/.local/bin/mesh-patterns.sh" 2>/dev/null || exit 1
    phone_reachable_ip 2>/dev/null )
}


age_h(){ local a="$1"
  if   [ "$a" -ge 86400 ]; then echo "$((a/86400))d"
  elif [ "$a" -ge 3600 ];  then echo "$((a/3600))h"
  elif [ "$a" -ge 60 ];    then echo "$((a/60))m"
  else echo "${a}s"; fi
}
# A byte-truncated multibyte tail corrupts the NEXT record, not just its own field. Measured on this
# node 2026-08-18: `head -c 30` / `cut -c1-46` cut inside an em-dash, leaving `\xe2\x80` (2 of 3 bytes)
# at the end of the `social-context` record — and the FOLLOWING `ss-connections|...` line came out RAW,
# pipe-delimited and unrendered, i.e. a peer state silently dropped out of the table. Rendering 200
# records with the partial tail removed renders all 200. Drop invalid sequences once per node.
sanitize_utf8(){
  if command -v iconv >/dev/null 2>&1; then iconv -c -f UTF-8 -t UTF-8 2>/dev/null
  else LC_ALL=C tr -cd '\11\12\15\40-\176'; fi
}
render(){ local n v a
  while IFS='|' read -r n v a; do
    [ -n "$n" ] && printf '  %-22s %-16s age %s\n' "$n" "$v" "$(age_h "$a")"
  done
}

# --likelihood render: committed value + the sense's own tape. `post-only` = the mesh persists this
# sense's conclusion and no raw record, so the reading cannot be weighed against an observation.
render_lik(){ local n v a ta ex
  while IFS='|' read -r n v a ta ex; do
    [ -n "$n" ] || continue
    case "$ta" in -*) printf '  %-22s %-16s age %-5s tape post-only\n' "$n" "$v" "$(age_h "$a")" ;;
                   *) printf '  %-22s %-16s age %-5s tape %-5s %s\n' "$n" "$v" "$(age_h "$a")" "$(age_h "$ta")" "$ex" ;;
    esac
  done
}
# per-node tally: how much of what this node broadcasts is posterior-only
tally_lik(){ local o="$1" tot po
  tot=$(printf '%s\n' "$o" | grep -c '|' 2>/dev/null || echo 0)
  po=$(printf '%s\n' "$o" | awk -F'|' '$4=="-1"' | grep -c '' 2>/dev/null || echo 0)
  [ "$tot" -gt 0 ] && printf '  -- %s/%s posterior-only (no raw tape behind the value)\n' "$po" "$tot"
}
peer_user(){ # registry first: ~/.mesh/nodes carries label:user@ip — topology lives there, not in code
  if [ -f "$HOME/.mesh/nodes" ]; then
    local entry
    entry=$(. "$HOME/.mesh/nodes" 2>/dev/null
            for n in $MESH_NODES; do [ "${n%%:*}" = "$1" ] && { echo "${n#*:}"; break; }; done)
    case "$entry" in *@*) echo "${entry%%@*}"; return 0 ;; esac
  fi
  case "$1" in
    Redmi|phone) echo "u0_a380" ;;
    router|GL-MT3000) echo "root" ;;
    *) echo "${SSH_USER:-$(whoami)}" ;;
  esac
}
peer_name(){ # same normalization as mesh-organs/fleet-health
  case "$1" in
    imozerov-IdeaPad-3-15IIL05) echo "IdeaPad" ;;
    imozerov-Default-string)    echo "default-string" ;;
    "Redmi 10")                 echo "Redmi" ;;
    GL-MT3000)                  echo "router" ;;
    *)                          echo "$1" ;;
  esac
}
peer_port(){ case "$1" in Redmi|phone) echo 8022 ;; *) echo 22 ;; esac; }

if [ "${1:-}" = --test ]; then
  for x in ssh date stat head hostname; do
    command -v "$x" >/dev/null 2>&1 || { echo "smoke-test: FAIL (no $x)"; exit 1; }
  done
  # REAL render: the local wall must parse (a bare node legitimately has none)
  out=$(bash -c "$REMOTE_SNIPPET" 2>&1) || { echo "smoke-test: FAIL (local snippet errored: $out)"; exit 1; }
  if [ -n "$out" ] && ! printf '%s' "$out" | grep -q '|'; then
    echo "smoke-test: FAIL (local wall rendered garbage: $out)"; exit 1
  fi
  # phone LAN-fallback: helper redirects only the phone host, and only when a real probe answers
  td_p=$(mktemp) || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
  printf '#!/bin/sh\necho 192.168.8.203\nexit 0\n' > "$td_p"; chmod +x "$td_p"
  r=$(MESH_PHONE_LAN_PROBE="$td_p" phone_lan_ip "Redmi 10"); rc=$?
  { [ "$r" = "192.168.8.203" ] && [ "$rc" = 0 ]; } || { echo "smoke-test: FAIL (phone host must resolve to LAN IP via probe — got '$r' rc=$rc)"; rm -f "$td_p"; exit 1; }
  if MESH_PHONE_LAN_PROBE="$td_p" phone_lan_ip "imozerov-IdeaPad-3-15IIL05" >/dev/null 2>&1; then
    echo "smoke-test: FAIL (non-phone host must NOT trigger the LAN fallback)"; rm -f "$td_p"; exit 1; fi
  rm -f "$td_p"

  # --- LIKELIHOOD MODE: drives the REAL LIK_SNIPPET + the REAL render_lik ------------------------
  # (posterior-vs-likelihood: docs/reviews/fep-likelihood-vs-posterior-sharing-fleet-states-2026-08-18.md)
  tdl=$(mktemp -d) || { echo "smoke-test: FAIL (mktemp -d)"; exit 1; }
  mkdir -p "$tdl/.mesh"
  # alpha: `-state` suffix WITH a non-empty tape -> a likelihood is forwardable
  printf 'CALM\n' > "$tdl/.mesh/.alpha-state"
  printf 'first\n2026-08-18T00:00:00Z alpha raw=7 CALM\n' > "$tdl/.mesh/alpha.log"
  # beta: `.state` suffix (INVISIBLE to the default walk) with NO tape -> posterior-only
  printf 'HOT\n' > "$tdl/.mesh/.beta.state"
  # gamma: a ZERO-BYTE log is not a tape (the placeholder logs on this node are 0 bytes)
  printf 'DIM\n' > "$tdl/.mesh/.gamma-state"; : > "$tdl/.mesh/gamma.log"
  lout=$(HOME="$tdl" bash -c "$LIK_SNIPPET" 2>/dev/null)
  al=$(printf '%s\n' "$lout" | grep '^alpha|'); be=$(printf '%s\n' "$lout" | grep '^beta|')
  ga=$(printf '%s\n' "$lout" | grep '^gamma|')
  [ -n "$be" ] || { echo "smoke-test: FAIL (likelihood walk missed the .state suffix family — beta invisible)"; rm -rf "$tdl"; exit 1; }
  case "$al" in
    *'|-1|'*) echo "smoke-test: FAIL (a state WITH a non-empty tape reported post-only — the likelihood is there and was not forwarded)"; rm -rf "$tdl"; exit 1 ;;
  esac
  printf '%s' "$al" | grep -q 'alpha raw=7 CALM' \
    || { echo "smoke-test: FAIL (tape excerpt not forwarded — got '$al')"; rm -rf "$tdl"; exit 1; }
  case "$be" in *'|-1|'*) ;; *) echo "smoke-test: FAIL (a state with NO tape must report -1/post-only — got '$be')"; rm -rf "$tdl"; exit 1 ;; esac
  case "$ga" in *'|-1|'*) ;; *) echo "smoke-test: FAIL (a ZERO-BYTE log is not a tape — gamma must be post-only, got '$ga')"; rm -rf "$tdl"; exit 1 ;; esac
  # render_lik: the two verdicts must be distinguishable in the render, not only in the record
  rl=$(printf '%s\n' "$lout" | render_lik)
  printf '%s' "$rl" | grep -q 'beta .*tape post-only' \
    || { echo "smoke-test: FAIL (render_lik must mark a tape-less state post-only)"; rm -rf "$tdl"; exit 1; }
  printf '%s' "$rl" | grep -qE 'alpha .*tape +[0-9]+[smhd]' \
    || { echo "smoke-test: FAIL (render_lik must print the tape age for a state that has one)"; rm -rf "$tdl"; exit 1; }
  # REGRESSION: a byte-truncated multibyte tail on one record used to make the NEXT record render RAW
  # (measured: social-context ending \xe2\x80 dropped ss-connections out of the table). sanitize_utf8
  # must keep BOTH lines rendered. Two spaces = rendered; a bare 'two|' = the raw record leaked.
  pair=$(printf 'one|OK|10|20|tail \xe2\x80\ntwo|OK|10|20|plain\n' | sanitize_utf8 | render_lik)
  n_rendered=$(printf '%s\n' "$pair" | grep -c '^  ')
  [ "$n_rendered" = 2 ] || { echo "smoke-test: FAIL (truncated multibyte tail dropped a record: $n_rendered/2 rendered)"; rm -rf "$tdl"; exit 1; }
  rm -rf "$tdl"

  echo "smoke-test: ok (local wall + phone LAN-fallback host-gating + likelihood walk/render + utf8 record-drop regression)"; exit 0
fi

MODE=default; SNIPPET="$REMOTE_SNIPPET"; RENDER=render
case "${1:-}" in
  --likelihood) MODE=lik; SNIPPET="$LIK_SNIPPET"; RENDER=render_lik ;;
  "") ;;
  *) echo "usage: mesh-fleet-states [--likelihood|--test]" >&2; exit 64 ;;
esac

echo "=== mesh-fleet-states $(date -u +%FT%TZ) ==="
[ "$MODE" = lik ] && echo "(likelihood mode: value = the peer's COMMITTED posterior; tape = its own raw record, last write + last line)"
SELF="$(hostname)"
echo "$SELF (local):"
out=$(bash -c "$SNIPPET" 2>/dev/null | sanitize_utf8)
if [ -n "$out" ]; then printf '%s\n' "$out" | "$RENDER"; [ "$MODE" = lik ] && tally_lik "$out"
else echo "  (no edge states)"; fi

mesh-peers --json 2>/dev/null | python3 -c "
import json, sys
for p in json.load(sys.stdin):
    print(f\"{p['hostname']}|{p['ip']}|{p['online']}\")
" 2>/dev/null | while IFS='|' read -r host ip online; do
  [ -z "$host" ] && continue
  [ "$host" = "$SELF" ] && continue          # self already rendered (generic, not name-hardcoded)
  echo "$host:"
  if [ "$online" != "True" ]; then
    # phone may be Tailscale-offline but LAN-reachable — redirect the edge-state walk to its LAN IP
    lan_ip=$(phone_lan_ip "$host")
    if [ -n "$lan_ip" ]; then ip="$lan_ip"; else echo "  (offline)"; continue; fi
  fi
  pname=$(peer_name "$host"); user=$(peer_user "$pname"); port=$(peer_port "$pname")
  opts=(-o ConnectTimeout=4 -o BatchMode=yes -o StrictHostKeyChecking=accept-new)
  [ "$port" != 22 ] && opts+=(-p "$port")
  out=$(ssh "${opts[@]}" "${user}@${ip}" "$SNIPPET" 2>/dev/null </dev/null | sanitize_utf8)
  rc=$?
  if [ $rc -ne 0 ]; then echo "  (ssh fail)"
  elif [ -n "$out" ]; then printf '%s\n' "$out" | "$RENDER"; [ "$MODE" = lik ] && tally_lik "$out"
  else echo "  (no edge states)"
  fi
done
