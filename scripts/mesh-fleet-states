#!/usr/bin/env bash
# mesh-fleet-states — every node's edge-trigger reflex states, re-derived live over SSH.
# The fleet's nervous system at a glance: per node, each ~/.mesh/.*-state artifact (value + age).
# PERCEIVE-ANEW: nothing cached — each call walks the live artifacts on every reachable node, so
# a new reflex on ANY node shows up here with zero edits. Consumed by `mesh-dash organs`.
# HONEST-FUSION: an unreachable node prints (ssh fail) — visibly different from (no edge states).
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"

# runs ON each node (pure builtins + stat — survives thin non-login SSH PATH)
REMOTE_SNIPPET='now=$(date +%s); for f in "$HOME"/.mesh/.[a-z]*-state; do
  [ -f "$f" ] || continue; n="${f##*/}"; n="${n#.}"
  case "$n" in mind-state-*) continue;; esac
  m=$(stat -c %Y "$f" 2>/dev/null) || continue
  printf "%s|%s|%s\n" "${n%-state}" "$(head -c 30 "$f" 2>/dev/null | tr "\n|" "  ")" "$((now-m))"
done'

# BODY LAN-FALLBACK: the phone drops off the tailnet often but stays reachable on the home LAN
# (PHONE_LAN_IPS, SSH 8022 as u0_a380). Emitting "(offline)" from the raw Tailscale Online flag is a
# FALSE NEGATIVE — the phone's edge states then read 'body dark' while its sensors produce live data.
# For the phone host only, when Tailscale says not-Online, probe a real LAN-reachable IP and (if found)
# walk its edge states over THAT IP. Echoes the reachable IP + rc 0, else rc 1.
# MESH_PHONE_LAN_PROBE=<cmd> overrides the probe (<cmd> <host> -> echo ip + exit 0) — used by --test.
phone_lan_ip(){
  case "$1" in *[Rr]edmi*|phone|Redmi) ;; *) return 1 ;; esac
  [ -n "${MESH_PHONE_LAN_PROBE:-}" ] && { "$MESH_PHONE_LAN_PROBE" "$1" 2>/dev/null; return; }
  ( export PATH="$HOME/.local/bin:$PATH"
    [ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes" 2>/dev/null
    command -v phone_reachable_ip >/dev/null 2>&1 || . "$HOME/.local/bin/mesh-patterns.sh" 2>/dev/null || exit 1
    phone_reachable_ip 2>/dev/null )
}

if [ "${1:-}" = --test ]; then
  for x in ssh date stat head hostname; do
    command -v "$x" >/dev/null 2>&1 || { echo "smoke-test: FAIL (no $x)"; exit 1; }
  done
  # REAL render: the local wall must parse (a bare node legitimately has none)
  out=$(bash -c "$REMOTE_SNIPPET" 2>&1) || { echo "smoke-test: FAIL (local snippet errored: $out)"; exit 1; }
  if [ -n "$out" ] && ! printf '%s' "$out" | grep -q '|'; then
    echo "smoke-test: FAIL (local wall rendered garbage: $out)"; exit 1
  fi
  # phone LAN-fallback: helper redirects only the phone host, and only when a real probe answers
  td_p=$(mktemp) || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
  printf '#!/bin/sh\necho 192.168.8.203\nexit 0\n' > "$td_p"; chmod +x "$td_p"
  r=$(MESH_PHONE_LAN_PROBE="$td_p" phone_lan_ip "Redmi 10"); rc=$?
  { [ "$r" = "192.168.8.203" ] && [ "$rc" = 0 ]; } || { echo "smoke-test: FAIL (phone host must resolve to LAN IP via probe — got '$r' rc=$rc)"; rm -f "$td_p"; exit 1; }
  if MESH_PHONE_LAN_PROBE="$td_p" phone_lan_ip "imozerov-IdeaPad-3-15IIL05" >/dev/null 2>&1; then
    echo "smoke-test: FAIL (non-phone host must NOT trigger the LAN fallback)"; rm -f "$td_p"; exit 1; fi
  rm -f "$td_p"
  echo "smoke-test: ok (local wall + phone LAN-fallback host-gating)"; exit 0
fi

age_h(){ local a="$1"
  if   [ "$a" -ge 86400 ]; then echo "$((a/86400))d"
  elif [ "$a" -ge 3600 ];  then echo "$((a/3600))h"
  elif [ "$a" -ge 60 ];    then echo "$((a/60))m"
  else echo "${a}s"; fi
}
render(){ local n v a
  while IFS='|' read -r n v a; do
    [ -n "$n" ] && printf '  %-22s %-16s age %s\n' "$n" "$v" "$(age_h "$a")"
  done
}
peer_user(){ # registry first: ~/.mesh/nodes carries label:user@ip — topology lives there, not in code
  if [ -f "$HOME/.mesh/nodes" ]; then
    local entry
    entry=$(. "$HOME/.mesh/nodes" 2>/dev/null
            for n in $MESH_NODES; do [ "${n%%:*}" = "$1" ] && { echo "${n#*:}"; break; }; done)
    case "$entry" in *@*) echo "${entry%%@*}"; return 0 ;; esac
  fi
  case "$1" in
    Redmi|phone) echo "u0_a380" ;;
    router|GL-MT3000) echo "root" ;;
    *) echo "${SSH_USER:-$(whoami)}" ;;
  esac
}
peer_name(){ # same normalization as mesh-organs/fleet-health
  case "$1" in
    imozerov-IdeaPad-3-15IIL05) echo "IdeaPad" ;;
    imozerov-Default-string)    echo "default-string" ;;
    "Redmi 10")                 echo "Redmi" ;;
    GL-MT3000)                  echo "router" ;;
    *)                          echo "$1" ;;
  esac
}
peer_port(){ case "$1" in Redmi|phone) echo 8022 ;; *) echo 22 ;; esac; }

echo "=== mesh-fleet-states $(date -u +%FT%TZ) ==="
SELF="$(hostname)"
echo "$SELF (local):"
out=$(bash -c "$REMOTE_SNIPPET" 2>/dev/null)
if [ -n "$out" ]; then printf '%s\n' "$out" | render; else echo "  (no edge states)"; fi

mesh-peers --json 2>/dev/null | python3 -c "
import json, sys
for p in json.load(sys.stdin):
    print(f\"{p['hostname']}|{p['ip']}|{p['online']}\")
" 2>/dev/null | while IFS='|' read -r host ip online; do
  [ -z "$host" ] && continue
  [ "$host" = "$SELF" ] && continue          # self already rendered (generic, not name-hardcoded)
  echo "$host:"
  if [ "$online" != "True" ]; then
    # phone may be Tailscale-offline but LAN-reachable — redirect the edge-state walk to its LAN IP
    lan_ip=$(phone_lan_ip "$host")
    if [ -n "$lan_ip" ]; then ip="$lan_ip"; else echo "  (offline)"; continue; fi
  fi
  pname=$(peer_name "$host"); user=$(peer_user "$pname"); port=$(peer_port "$pname")
  opts=(-o ConnectTimeout=4 -o BatchMode=yes -o StrictHostKeyChecking=accept-new)
  [ "$port" != 22 ] && opts+=(-p "$port")
  out=$(ssh "${opts[@]}" "${user}@${ip}" "$REMOTE_SNIPPET" 2>/dev/null </dev/null)
  rc=$?
  if [ $rc -ne 0 ]; then echo "  (ssh fail)"
  elif [ -n "$out" ]; then printf '%s\n' "$out" | render
  else echo "  (no edge states)"
  fi
done
