#!/usr/bin/env python3
# reflex-cadence: 23 5 * * *
# reflex-args: --scan
# SECOND CADENCE, wired by hand and named here so it is not a phantom: `*/15 * * * * --order`
# (~/.mesh/reflexes.cron, 2026-08-18). A `# reflex-cadence:` header holds ONE schedule and
# mesh-autowire wires one line per tool NAME, so the ordering pass cannot self-wire. It has to run
# between a mind APPENDING an index entry and the NEXT session reading the index — a daily cadence
# would leave every new memory past the read limit for up to 24h, which is the failure below.
"""mesh-memory-recall — which retained memories are actually READ, and which are NOSTALGIA.

WHY (operator 2026-08-15, "memories that do not help predict the future are wasteful nostalgia"):
Still/Sivak/Bell/Crooks, "Thermodynamics of Prediction", PRL 109 120604 (2012) — a system that keeps
memory about its environment retains information about the PAST; only the fraction that predicts the
FUTURE is thermodynamically useful. The rest is "nostalgia", and is DISSIPATIVE (nonpredictive
retained information lower-bounds dissipated work). docs/reviews/info-theory-agency-nostalgia-memory-
depth-2026-07-28.md landed that as the memory-DEPTH axis in `mesh-precision --num` — for NUMERIC
sensor streams only. It was never pointed at the mind's own memory corpus. This is that meter.

WHAT IS ACTUALLY OBSERVABLE (measured on the live archive before this was written — do not soften it):
a memory recall appears in the session transcript as an assistant-initiated Read tool_use whose
file_path is under <project>/memory/, e.g.
    "name":"Read","input":{"file_path":".../memory/<slug>.md"},"caller":{"type":"direct"}
and whose tool_result carries the harness reminder "This memory is N days old.". ALL such reads in
the archive are caller=direct: this harness does NOT auto-inject individual memory files. Only
MEMORY.md (the index) is loaded every session.

THE LIMIT THIS METER CANNOT PASS, stated here because the number is useless without it: an OPENED
memory is a proven use, but a NEVER-OPENED memory is NOT a proven non-use. Every memory's one-line
index entry in MEMORY.md is auto-loaded into every session, and a mind can act on that line without
ever opening the file. So `reads == 0` is a LOWER BOUND on nostalgia — a candidate list for a human
or a mind to judge, never an eviction warrant. A tool that deleted on this signal would be deleting
on evidence it does not have. Report only; there is deliberately no --prune.

Sibling traps already paid for elsewhere in the genome and avoided here:
  - the scan MUST exclude its own session transcript, or it matches the strings it is grepping for
    (the self-matching-grep shape; hit live while building this).
  - a slug in the log whose file is gone is a DELETED memory, not a read of nothing — reported apart.
"""

import calendar
import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path

import signal
# SIGTERM MUST UNWIND, or every `finally` in this file is decorative. Python's DEFAULT SIGTERM
# disposition terminates the interpreter WITHOUT running finally blocks (and without
# TemporaryDirectory.__exit__), so a correct-looking cleanup never runs. The signal is not
# hypothetical: GNU `timeout` — which wraps this tool at its call sites and wraps EVERY `--test` in
# mesh-doctor's hourly sweep and in mesh-autowire — puts its child in its OWN process group and
# signals the GROUP, so this process gets the TERM. sys.exit() from the handler raises SystemExit in
# the main thread, which is what actually unwinds. SIGKILL stays uncatchable; that half is
# mesh-tmp-guard's sweep. Pattern and the measured mechanism: eb5b8e7, scripts/mesh-spend.
for _sig in (signal.SIGTERM, signal.SIGHUP):
    signal.signal(_sig, lambda _s, _f: sys.exit(128 + _s))

HOME = Path.home()
PROJECTS = HOME / ".claude" / "projects"
# NOT memory-recall.log: mesh-autowire redirects a reflex's STDOUT to ~/.mesh/<tool>.log, so a data
# file sharing the tool's basename gets usage text and scan chatter appended into it daily by the
# reflex it belongs to. Caught live — the first autowired line was
#   23 5 * * * mesh-memory-recall >> $HOME/.mesh/memory-recall.log
# which would have corrupted the ledger with its own console output. Data gets a .tsv, logs get .log.
LOG = HOME / ".mesh" / "memory-recall.tsv"
# The INDEX ledger. The nostalgia policy (settled 2026-08-16) names the auto-loaded MEMORY.md index
# — not disk — as the scarce resource, and then quoted its headroom as PROSE on the board: "17.2KB
# of 24.4KB, ~4 weeks". Twelve hours later it was 19.6KB (+2.4KB, corpus 402 -> 452), i.e. the rate
# behind "4 weeks" was wrong by ~20x and no tool would ever have said so — a constant outliving its
# reader, in the very policy that named the constraint. A constraint nothing measures is a slogan.
# So: sample (bytes, entries) into a ledger and DERIVE the rate; never re-state it in prose.
INDEX_LOG = HOME / ".mesh" / "memory-index.tsv"   # ts \t project \t bytes \t entries
# Heartbeat for the change-gated sampler below: without it a corpus that stops growing keeps its
# last CHANGE as the newest sample, and the derived rate freezes at the last burst forever.
INDEX_HEARTBEAT_S = 6 * 3600
# A rate needs a span. Two samples minutes apart divide a rounding error by ~0 and print a number
# with three digits of false precision; below this the block says n/a and says why.
INDEX_MIN_SPAN_S = 3600
BOARD = HOME / ".mesh" / "chat.log"
# The read limit has NO source inside this tool and never will — quoting one from memory is how the
# "17.2KB of 24.4KB, ~4 weeks" prose got 20x wrong. It comes from the operator: the env var when the
# caller has one (a pane, a mind), else the node's own declaration in ~/.mesh/nodes, which is the
# same value the cron reflex would otherwise be blind to (cron carries no shell env, so without this
# the pane and the reflex render two different verdicts for one file).
NODES = HOME / ".mesh" / "nodes"
STATE = HOME / ".mesh" / ".memory-recall.state"
_ONELINE = False

# a memory Read tool_use, as it appears verbatim in a transcript jsonl line
READ_RE = re.compile(
    r'"id":"(?P<tid>toolu_[A-Za-z0-9]+)","name":"Read","input":\{"file_path":"'
    r'(?P<path>[^"]*/memory/(?P<slug>[A-Za-z0-9._-]+)\.md)"\}'
)


def _memory_dirs():
    """project dirs that actually carry a memory/ corpus."""
    if not PROJECTS.is_dir():
        return []
    return [p for p in sorted(PROJECTS.iterdir()) if (p / "memory").is_dir()]


def _self_session():
    """this process's own transcript stem, so the scan never reads its own output.

    A scan that includes the running session matches the very patterns it is searching for the
    moment they are printed — the self-matching-grep shape. Best-effort: the env var is set by the
    harness; absent it we fall back to the newest transcript, which is overwhelmingly this one.
    """
    sid = os.environ.get("CLAUDE_SESSION_ID", "").strip()
    return sid or None


def _chosen_project(dirs):
    """the project dir this working tree belongs to, else the largest corpus.

    dirs[0] is NOT it: taking the first alphabetically joined this node's recall log against another
    project's memory dir and reported a 12-memory corpus with 126 "deleted" on a node holding 400.
    The --test real-path leg had the same bug in kind — it asserted against a foreign archive.
    """
    project = os.environ.get("CLAUDE_PROJECT_SLUG") or \
        "-" + str(Path.cwd().resolve()).strip("/").replace("/", "-")
    for d in dirs:
        if d.name == project:
            return d, True
    return max(dirs, key=lambda d: len(list((d / "memory").glob("*.md")))), False


def _load_state():
    try:
        return json.loads(STATE.read_text())
    except Exception:
        return {}


def _save_state(st):
    try:
        STATE.parent.mkdir(parents=True, exist_ok=True)
        tmp = str(STATE) + ".tmp"
        with open(tmp, "w") as f:
            json.dump(st, f)
        os.replace(tmp, STATE)
    except Exception:
        pass


def _seen_tids():
    """tool_use ids already logged — the dedup key, so a re-scan cannot double-count."""
    seen = set()
    try:
        with open(LOG) as f:
            for line in f:
                parts = line.rstrip("\n").split("\t")
                if len(parts) >= 4:
                    seen.add(parts[3])
    except FileNotFoundError:
        pass
    return seen


def _index_measure(pdir):
    """(bytes, entries) of a project's auto-loaded index, or None if it has no MEMORY.md."""
    idx = pdir / "memory" / "MEMORY.md"
    try:
        b = idx.stat().st_size
    except OSError:
        return None
    n = sum(1 for p in (pdir / "memory").glob("*.md") if p.name != "MEMORY.md")
    return (b, n)


def _index_rows(project=None):
    rows = []
    try:
        with open(INDEX_LOG) as f:
            for line in f:
                p = line.rstrip("\n").split("\t")
                if len(p) < 4:
                    continue
                if project is not None and p[1] != project:
                    continue
                try:
                    rows.append((p[0], p[1], int(p[2]), int(p[3])))
                except ValueError:
                    continue
    except FileNotFoundError:
        pass
    rows.sort()
    return rows


def _index_record(pdir):
    """Append a sample when it CHANGED, or when the last one aged past the heartbeat."""
    m = _index_measure(pdir)
    if m is None:
        return None
    prev = _index_rows(pdir.name)
    if prev:
        pts, _, pb, pn = prev[-1]
        aged = (time.time() - _iso_epoch(pts)) >= INDEX_HEARTBEAT_S
        if (pb, pn) == m and not aged:
            return m
    INDEX_LOG.parent.mkdir(parents=True, exist_ok=True)
    with open(INDEX_LOG, "a") as f:
        f.write("%s\t%s\t%d\t%d\n" % (time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
                                      pdir.name, m[0], m[1]))
    return m


def _iso_epoch(ts):
    try:
        # timegm, not mktime: the stamps are UTC and mktime reads them as LOCAL, which on any
        # node running non-UTC shifts every span by the offset and quietly rescales the rate.
        return float(calendar.timegm(time.strptime(ts[:19], "%Y-%m-%dT%H:%M:%S")))
    except (ValueError, OverflowError):
        return 0.0


def _index_limit():
    """(limit_int_or_None, raw, bad) — env first, then the node declaration. Never a default."""
    lim = os.environ.get("MESH_MEMORY_INDEX_LIMIT", "").strip()
    if not lim:
        try:
            for line in NODES.read_text(errors="replace").splitlines():
                t = line.strip()
                if t.startswith("#"):
                    continue
                t = t[len("export "):].strip() if t.startswith("export ") else t
                if t.startswith("MESH_MEMORY_INDEX_LIMIT="):
                    lim = t.split("=", 1)[1].strip().strip("\"'").split("#")[0].strip()
                    break
        except OSError:
            pass
    if not lim:
        return None, "", False
    try:
        return int(lim), lim, False
    except ValueError:
        return None, lim, True


def _index_facts(project):
    """The MEASURED index-pressure facts, computed once and shared by every rendering. A field is
    None when this tool cannot measure it (no sample, span too short, no operator-supplied limit) —
    never a plausible stand-in. Two renderings of one meter must not be able to disagree, so the
    formatters below own the wording and nothing else owns the arithmetic."""
    f = {"nrows": 0, "ts_n": None, "b_n": None, "n_n": None, "span": None,
         "per_day": None, "ent_day": None, "limit": None, "limit_raw": "",
         "limit_bad": False, "left": None, "days": None}
    rows = _index_rows(project)
    f["nrows"] = len(rows)
    if not rows:
        return f
    ts_n, _, b_n, n_n = rows[-1]
    f.update(ts_n=ts_n, b_n=b_n, n_n=n_n)
    ts_0, _, b_0, n_0 = rows[0]
    f["span"] = _iso_epoch(ts_n) - _iso_epoch(ts_0)
    lim, raw, bad = _index_limit()
    f["limit_raw"] = raw
    f["limit_bad"] = bad
    if lim is not None:
        f["limit"] = lim
        f["left"] = lim - b_n
    if len(rows) < 2 or f["span"] < INDEX_MIN_SPAN_S:
        return f
    f["per_day"] = (b_n - b_0) * 86400.0 / f["span"]
    f["ent_day"] = (n_n - n_0) * 86400.0 / f["span"]
    if f["left"] is not None and f["per_day"] > 0:
        # left/per_day is signed on purpose, but its SIGN changes what the number means: positive
        # is time remaining, negative is time SINCE the ceiling was crossed. Never print it inside
        # one future-tense phrase — the formatters split the two cases by name.
        f["days"] = f["left"] / f["per_day"]
    return f


def _headroom_wide(f):
    if f["limit"] is None:
        if f["limit_bad"]:
            return (f"  index headroom n/a — MESH_MEMORY_INDEX_LIMIT={f['limit_raw']!r} is not an "
                    f"integer byte count")
        return ("  index headroom n/a — MESH_MEMORY_INDEX_LIMIT unset and none declared in "
                "~/.mesh/nodes. The read limit is not measurable from here and this tool will "
                "not quote one from memory.")
    if f["left"] >= 0:
        eta = f"{f['days']:.1f} d" if f["days"] is not None else "no growth measured"
        return f"  index headroom {f['left']} B of {f['limit']} B  ->  {eta} at the measured rate"
    ago = (f"crossed ~{-f['days']:.1f} d ago at the measured rate" if f["days"] is not None
           else "crossed already; no growth measured since")
    return (f"  index headroom OVER by {-f['left']} B of {f['limit']} B limit  ->  {ago}")


def _index_oneline(project):
    """The compact rendering — one line, and it must carry the meter's WORST number. The full
    report is the only place headroom used to appear, and nothing runs it on a cadence; the pane
    ran --oneline and read '629 memories · 134 opened (21%)' as healthy while 11 KB of the index
    was past the limit and never loading. A meter's worst number belongs in its SHORTEST
    rendering, not only its longest."""
    f = _index_facts(project)
    if not f["nrows"]:
        return "  index n/a — no sample yet (run --scan)"
    rate = f"{f['per_day']:+.0f} B/day" if f["per_day"] is not None else "rate n/a (span too short)"
    if f["limit"] is None:
        why = "bad limit" if f["limit_bad"] else "no MESH_MEMORY_INDEX_LIMIT"
        return f"  index {f['b_n']} B · headroom n/a ({why}) · {rate}"
    if f["left"] < 0:
        # 80-col pane: keep the worst number FIRST and the whole line inside the width, so a
        # wrap can never push the crossing off the visible row.
        ago = f", crossed ~{-f['days']:.1f} d ago" if f["days"] is not None else ""
        return (f"  index OVER by {-f['left']} B — {f['b_n']} B of {f['limit']} B{ago}"
                f" · {rate}")
    left_d = f" (~{f['days']:.1f} d)" if f["days"] is not None else ""
    return f"  index {f['b_n']} B of {f['limit']} B · {f['left']} B headroom{left_d} · {rate}"


def _index_block(project):
    """Render the index-pressure block. Every number here is MEASURED or says n/a — the limit has
    no source in this tool, so headroom is printed only when the operator supplies one."""
    f = _index_facts(project)
    out = []
    if not f["nrows"]:
        out.append("  index          n/a — no sample yet (run --scan)")
        return out
    out.append(f"  index          {f['b_n']} B over {f['n_n']} entries "
               f"({f['b_n']/max(1,f['n_n']):.0f} B/entry)  [sampled {f['ts_n'][:16]}Z]")
    if f["per_day"] is None:
        out.append(f"  index growth   n/a — {f['nrows']} sample(s) spanning {f['span']/3600:.1f}h "
                   f"(need >=2 over {INDEX_MIN_SPAN_S/3600:.0f}h); a shorter span prints noise")
        return out
    out.append(f"  index growth   {f['per_day']:+.0f} B/day  ({f['ent_day']:+.1f} entries/day)"
               f"  over {f['span']/3600:.1f}h, {f['nrows']} samples")
    out.append(_headroom_wide(f))
    out.append(_cut_oneline(project).replace("  index cut", "  index cut    ", 1))
    return out


def scan(verbose=True):
    """incrementally scan transcripts; append one row per newly-seen memory Read."""
    dirs = _memory_dirs()
    if not dirs:
        sys.stderr.write("mesh-memory-recall: no project dir carries a memory/ corpus — n/a\n")
        return 2

    self_sid = _self_session()
    state = _load_state()
    seen = _seen_tids()
    rows = []
    scanned = grew = 0

    for pdir in dirs:
        for tf in sorted(pdir.glob("*.jsonl")):
            stem = tf.stem
            if self_sid and stem == self_sid:
                continue  # never scan our own transcript
            try:
                size = tf.stat().st_size
            except OSError:
                continue
            key = str(tf)
            off = state.get(key, 0)
            scanned += 1
            if off >= size:
                continue
            grew += 1
            try:
                with open(tf, "r", errors="replace") as f:
                    f.seek(off)
                    chunk = f.read()
            except OSError:
                continue
            state[key] = size
            for m in READ_RE.finditer(chunk):
                tid = m.group("tid")
                if tid in seen:
                    continue
                seen.add(tid)
                # timestamp: search the WHOLE jsonl line the match sits on. Looking only BACKWARDS
                # loses it — the harness emits "timestamp" after the content block, so a backward
                # scan renders "-" and the report's window collapses to a bare end date.
                ls = chunk.rfind("\n", 0, m.start()) + 1
                le = chunk.find("\n", m.end())
                line = chunk[ls:le if le != -1 else len(chunk)]
                ts = ""
                t = line.find('"timestamp":"')
                if t != -1:
                    ts = line[t + 13:t + 37].split('"')[0]
                rows.append((ts or "-", m.group("slug"), stem, tid, pdir.name))

    if rows:
        rows.sort()
        LOG.parent.mkdir(parents=True, exist_ok=True)
        with open(LOG, "a") as f:
            for r in rows:
                f.write("\t".join(r) + "\n")
    _save_state(state)
    # Sample the index alongside the recall scan: the two answer different halves of the same
    # policy question (what is READ vs what the index COSTS), and the cadence is already right.
    for pdir in dirs:
        _index_record(pdir)
    if verbose:
        print(f"scanned {scanned} transcript(s), {grew} new/grown, +{len(rows)} recall row(s)")
    return 0


def report(project=None):
    dirs = _memory_dirs()
    if not dirs:
        sys.stderr.write("mesh-memory-recall: no memory corpus — n/a\n")
        return 2
    # Pick the corpus by PROJECT, never dirs[0]. Taking the first dir alphabetically reported a
    # 12-memory corpus with "126 deleted" on a node whose real corpus is 395 — it was joining this
    # node's recall log against a DIFFERENT project's memory dir and reading every unmatched slug as
    # a deletion. Default to the project this working tree belongs to.
    if project is None:
        chosen, exact = _chosen_project(dirs)
        if not exact:
            sys.stderr.write(f"mesh-memory-recall: no corpus for this cwd; falling back to the "
                             f"largest ({chosen.name})\n")
    else:
        chosen = next((d for d in dirs if d.name == project), None)
        if chosen is None:
            sys.stderr.write(f"mesh-memory-recall: no corpus for project {project}\n")
            return 2
    mem = chosen / "memory"
    files = {p.stem: p for p in mem.glob("*.md") if p.name != "MEMORY.md"}

    counts, last = {}, {}
    rows_total = 0
    try:
        with open(LOG) as f:
            for line in f:
                parts = line.rstrip("\n").split("\t")
                if len(parts) < 4:
                    continue
                rows_total += 1
                # rows written before the project field existed carry no scope — count them only
                # when the slug resolves in this corpus, never as a foreign-project deletion.
                proj = parts[4] if len(parts) >= 5 else None
                if proj is not None and proj != chosen.name:
                    continue
                ts, slug = parts[0], parts[1]
                if proj is None and slug not in files:
                    continue
                counts[slug] = counts.get(slug, 0) + 1
                if ts > last.get(slug, ""):
                    last[slug] = ts
    except FileNotFoundError:
        sys.stderr.write("mesh-memory-recall: no recall log yet — run --scan first (n/a)\n")
        return 2

    if not counts:
        sys.stderr.write("mesh-memory-recall: recall log is empty — n/a\n")
        return 2

    live = set(files)
    read_live = {s: c for s, c in counts.items() if s in live}
    never = sorted(live - set(read_live))
    orphan = sorted(set(counts) - live)
    total_reads = sum(counts.values())
    span = (min(last.values()), max(last.values())) if last else ("-", "-")

    if _ONELINE:
        # NAME THE SUBJECT IN EVERY RENDERING. The corpus is resolved from CLAUDE_PROJECT_SLUG or,
        # absent it, the CALLER'S CWD (_chosen_project) — so this meter's answer is a function of
        # where it was invoked from, and the compact rendering used to omit that. Measured
        # 2026-08-17: the witness DATA pane (cwd $HOME -> the 12-file -home-mesh-home corpus) read
        # "12 memories · 5 opened (42%)" while the MIND pane of the same window, same second
        # (cwd the genome repo -> 607 files) read "22%". Both honest, 50x apart, and nothing in the
        # line said which corpus it counted — the error flattered us, and the only axis that might
        # have tipped anyone off (a reads window ending 7 days back) read as staleness instead.
        # The full --report always printed `project <name>`; the one-liner now does too.
        pct = 100.0 * len(read_live) / max(1, len(live))
        print(f"  corpus {chosen.name} · {len(live)} memories")
        print(f"  {len(read_live)} opened ({pct:.0f}%) · {len(never)} never "
              f"(nostalgia lower bound) · {total_reads} reads {span[0][:10]}..{span[1][:10]}")
        print(_index_oneline(chosen.name))
        # A SIZE IS NOT A CASUALTY LIST. "OVER by 14890 B" is true and says nothing about WHICH
        # entries stopped loading; the truncation is tail-cut, so the answer is always "the newest".
        print(_cut_oneline(chosen.name))
        return 0

    print("== mesh-memory-recall — retained vs. actually-read (nostalgia meter) ==")
    print(f"  project        {chosen.name}   ({rows_total} rows in log, all projects)")
    print(f"  corpus         {len(live)} memories")
    print(f"  ever opened    {len(read_live)} ({100.0*len(read_live)/max(1,len(live)):.1f}%)")
    print(f"  never opened   {len(never)}  <- NOSTALGIA CANDIDATES (lower bound, see below)")
    print(f"  total reads    {total_reads}   window {span[0][:10]} .. {span[1][:10]}")
    for line in _index_block(chosen.name):
        print(line)
    if orphan:
        print(f"  deleted        {len(orphan)} slug(s) read in the past, file now gone")
    print()
    print("-- most-read (predictive: these earned their keep) --")
    for slug, c in sorted(read_live.items(), key=lambda kv: (-kv[1], kv[0]))[:12]:
        print(f"  {c:3d}  {last.get(slug,'-')[:10]}  {slug}")
    print()
    print(f"-- never opened ({len(never)}) --")
    for slug in never[:40]:
        print(f"       {slug}")
    if len(never) > 40:
        print(f"       … and {len(never)-40} more")
    print()
    print("CAVEAT (binding): reads==0 is a LOWER BOUND on nostalgia, not proof of non-use. Every")
    print("memory's index line in MEMORY.md is auto-loaded each session, so a mind can act on the")
    print("one-liner without opening the file. This is a candidate list for judgement, never an")
    print("eviction warrant — which is why there is no --prune.")
    return 0


def influence():
    """READS are not the whole of use — split index-mediated use from real nostalgia.

    THE OBJECTION THAT MAKES --report UNACTIONABLE ON ITS OWN, and why this exists: pruning on
    reads==0 would delete exactly the memories that might be working THROUGH their index line, since
    MEMORY.md is auto-loaded every session and a mind can act on the one-liner without ever opening
    the file. So "never opened" cannot separate a dead memory from a silently load-bearing one.

    The discriminator: a memory whose slug is USED in the mesh's own output (board posts, commit
    messages) while its file was never read is proof that the INDEX LINE carried it — the cheapest
    possible evidence, already lying in the logs. Four cells:

      read + mentioned   ACTIVE          openly in use
      mentioned, unread  INDEX-MEDIATED  the one-liner is load-bearing — do NOT drop the index line
      read, unmentioned  PRIVATE         consulted, informed work that did not name it
      neither            COLD            the only prune candidate, and still only a candidate

    Scanned sources deliberately EXCLUDE the memory dir itself: a memory's own file and its
    [[wiki-links]] to siblings are cross-references, not use, and counting them would let the corpus
    justify itself (every memory cites others, so all 400 would read as "in use").
    """
    dirs = _memory_dirs()
    if not dirs:
        sys.stderr.write("mesh-memory-recall: no memory corpus — n/a\n")
        return 2
    chosen, _ = _chosen_project(dirs)
    files = {p.stem for p in (chosen / "memory").glob("*.md") if p.name != "MEMORY.md"}
    if not files:
        sys.stderr.write("mesh-memory-recall: empty corpus — n/a\n")
        return 2

    read = set()
    try:
        with open(LOG) as f:
            for line in f:
                parts = line.rstrip("\n").split("\t")
                if len(parts) >= 2 and parts[1] in files:
                    read.add(parts[1])
    except FileNotFoundError:
        sys.stderr.write("mesh-memory-recall: no recall log — run --scan first (n/a)\n")
        return 2

    corpus = []
    if BOARD.exists():
        corpus.append(BOARD.read_text(errors="replace"))
    try:
        corpus.append(subprocess.run(["git", "log", "--format=%B", "-n", "4000"],
                                     capture_output=True, text=True, timeout=60).stdout)
    except Exception:
        pass
    if not corpus:
        sys.stderr.write("mesh-memory-recall: no board and no git log to scan — n/a\n")
        return 2
    blob = "\n".join(corpus)

    mentioned = {s for s in files if s in blob}
    active = read & mentioned
    index_mediated = mentioned - read
    private = read - mentioned
    cold = files - read - mentioned

    print("== mesh-memory-recall --influence — is the INDEX LINE doing the work? ==")
    print(f"  corpus            {len(files)}")
    print(f"  ACTIVE            {len(active)}   read AND named in board/commits")
    print(f"  INDEX-MEDIATED    {len(index_mediated)}   named but NEVER opened — the one-liner carried it")
    print(f"  PRIVATE           {len(private)}   opened but never named")
    print(f"  COLD              {len(cold)}   neither — the only prune candidates")
    print()
    if index_mediated:
        print("-- INDEX-MEDIATED (proof the auto-loaded index line is load-bearing) --")
        for s in sorted(index_mediated)[:15]:
            print(f"       {s}")
        if len(index_mediated) > 15:
            print(f"       … and {len(index_mediated)-15} more")
        print()
    print(f"VERDICT: {len(index_mediated)} memories demonstrably used WITHOUT ever being opened.")
    print("Any prune keyed on reads alone would have dropped those. COLD is a candidate list for")
    print("judgement, not an eviction warrant — a memory can still be load-bearing and unnamed.")
    return 0


# ---------------------------------------------------------------------------
# INDEX ORDERING — which entries the harness's read limit throws away.
#
# MEASURED on this harness 2026-08-18, in a live SessionStart context, not inferred: the auto-load
# of MEMORY.md is HEAD-KEPT / TAIL-CUT. The index came through from line 1 and stopped dead at line
# 110 of 184 (cum 25127 B; line 109 ended at 24939 B, under the 24985 B limit — so the straddling
# line is KEPT and everything after it is dropped), and the only surface was a warning saying "Only
# part of it was loaded" WITHOUT naming which part. Because minds APPEND, the survivors are the
# OLDEST entries and the casualties are the NEWEST: all 74 cut entries were files written in the
# preceding 12.5h. A growing index does not lose old memories — it stops absorbing NEW learning
# entirely, silently, and a mind cannot tell a memory it never wrote from one that was cut.
#
# So the defect is the ORDERING, not the size: trimming bytes only pulls more tail under the cut,
# and the corpus grows faster (+9935 B/day measured) than any hand-trimming keeps up with. Order the
# index worst-last and whatever falls off is the LEAST load-bearing rather than the MOST RECENT.
#
# The ranking uses the signals this meter already owns, and its TIERS are the argument:
#   4 READ RECENTLY   proven use, still warm                       (recall log, <= RECENT_READ_D)
#   3 NEW             written within NEW_D — unproven AND UNPROVABLE: a memory written two hours
#                     ago cannot have been read yet, so any use-only ranking sorts all new learning
#                     to the bottom. This tier exists because that is the exact bug.
#   2 INDEX-MEDIATED  named on the board/in commits but never opened — PROOF the index line itself
#                     did the work, so its line is the last thing that may be dropped (--influence)
#   1 READ ONCE       proven use, cold now
#   0 COLD            never read, never named, not new — the entries that should fall off first
#
# WHY THE ORDER IS BY VALUE DENSITY AND NOT BY TIER. The index holds TWO line shapes: the compacted
# head (bare comma-separated slugs, ~40 memories per line) and the appended tail (one
# `- [Title](slug.md) — hook` per line). A pure tier sort ignores that and pays ~210 B for one
# memory while sinking a 250 B line carrying forty — measured on this node: a tier-only sort cut
# 343 slugs where the file's existing order cut 74. Under a fixed byte ceiling this is a knapsack,
# and the standard greedy is by value/byte. Measured the same minute, cut composition
# (tier4, tier3, tier2, tier1, tier0):
#     file's own order   74 slugs   (1, 73, 0, 0, 0)      <- every casualty is NEW learning
#     tier-only sort    343 slugs   (0, 62, 31, 61, 189)
#     density greedy    167 slugs   (0, 43,  7, 12, 105)  <- shipped
# The weights are a plain doubling ladder (each tier twice the one below) — the least arbitrary
# table that orders the tiers — and the ladder IS the knob: weighting NEW at 16 or 32 rescues new
# entries (43 -> 21 -> 2 cut) by throwing 25-44 index-mediated and 56-64 read-once ones overboard.
# Do not quote these counts anywhere: they are one corpus at one minute, and `--order --check`
# re-derives them (a constant outlives its reader).
#
# WHAT ORDERING CANNOT DO, stated so nobody reads this as "the memory system is fixed": on this node
# ONE DAY of new memories is 95 entries ~= 20 KB against a 24985 B ceiling, so a day of learning
# very nearly fills the entire loadable index by itself. Ordering decides WHICH entries are lost,
# never HOW MANY; only compaction (the dense bare-slug form the head is already in) moves that.
#
NEW_D = 2.0            # days: a write this recent is NEW LEARNING and cannot have been read yet
RECENT_READ_D = 14.0   # days: a read this recent counts as warm, not merely "ever"
TIER_VALUE = {4: 16.0, 3: 8.0, 2: 4.0, 1: 2.0, 0: 1.0}   # doubling ladder; see the note above
UNRESOLVED_VALUE = 1.5   # a pointer this tool cannot resolve to a file: above COLD, below proven


def _corpus_files(pdir):
    return {p.stem: p for p in (pdir / "memory").glob("*.md") if p.name != "MEMORY.md"}


def _line_slugs(line, files):
    """slugs an index line points at — BOTH forms live in the same file today.

    The tail is `- [Title](slug.md) — hook` (one memory per line); the head is the compacted form,
    bare comma-separated slugs many-per-line. A ranker that understood only one form would sort the
    other by nothing at all, so match both and intersect with the corpus (a bare word that is not a
    memory is prose, not a pointer)."""
    s = set(re.findall(r"\(([A-Za-z0-9._-]+)\.md\)", line))
    s |= {w for w in re.findall(r"[a-z0-9][a-z0-9-]{6,}", line) if w in files}
    return s & set(files)


def _use_signals(project, files, use_git=True):
    """(last_read_ts_by_slug, mentioned_set) — the two proven-use axes, both already lying in logs.

    use_git=False for the ORDERING path, and the reason is not cost. `git log` runs against the
    CALLER'S CWD, so the same corpus ranks differently depending on where the tool was invoked from
    — and the cron reflex runs from $HOME, which is not a repo at all. A reflex that rewrites a file
    must be a pure function of node-global state, so the ordering reads the board and the recall log
    (both absolute paths) and nothing that varies with the caller. Measured cost of dropping it on
    this node: git contributed 13 of 99 mention-slugs, all of which were also in the board or are
    one board post away. --influence keeps git; it REPORTS rather than writes."""
    last = {}
    try:
        with open(LOG) as f:
            for line in f:
                parts = line.rstrip("\n").split("\t")
                if len(parts) < 2:
                    continue
                proj = parts[4] if len(parts) >= 5 else None
                if proj is not None and proj != project:
                    continue
                ts, slug = parts[0], parts[1]
                if slug in files and ts > last.get(slug, ""):
                    last[slug] = ts
    except FileNotFoundError:
        pass
    blob = ""
    if BOARD.exists():
        blob += BOARD.read_text(errors="replace")
    if use_git:
        try:
            blob += subprocess.run(["git", "log", "--format=%B", "-n", "4000"],
                                   capture_output=True, text=True, timeout=60).stdout
        except Exception:
            pass
    # the memory dir itself is NEVER scanned: every memory [[wiki-links]] its siblings, so counting
    # those would let the corpus justify its own existence (same rule as --influence).
    mentioned = {s for s in files if s in blob} if blob else set()
    return last, mentioned


def _slug_rank(slug, files, last, mentioned, now):
    """(tier, recency_epoch) for one memory — see the tier table above."""
    try:
        mtime = files[slug].stat().st_mtime
    except OSError:
        mtime = 0.0
    read_ts = last.get(slug)
    read_ep = _iso_epoch(read_ts) if read_ts else 0.0
    if read_ep and (now - read_ep) <= RECENT_READ_D * 86400:
        return (4, read_ep)
    if (now - mtime) <= NEW_D * 86400:
        return (3, mtime)
    if slug in mentioned and not read_ts:
        return (2, mtime)
    if read_ts:
        return (1, read_ep)
    return (0, mtime)


# A line that is not an entry but carries no ORDER of its own: a whole-line HTML comment (the
# index's convention note) or a blank. Hoisting one is safe because it annotates the FILE, not the
# entry beside it; anything else (a heading, a paragraph) does carry order and must not be moved.
_PINNABLE = re.compile(r"^\s*<!--.*-->\s*$")


def _split_index(lines):
    """(pinned head, body) — or None if the file is not the flat list this ranker can reorder.

    A LEADING RUN IS THE WRONG TEST, and the live corpus proved it within a day of 75a4337: the
    ranker ran ONCE (`reordered 37 of 185`), then a mind rewrote MEMORY.md with its `- ` entry on
    line 1 and the convention comment on line 2, and from that write onward EVERY */15 tick printed
    `refusing to reorder a shape this tool does not understand` — the index the whole ordering pass
    exists for went unranked while the two toy corpora reported green every tick. A refusal that is
    permanent is not a safe default; it is the dead lane wearing a careful sentence.

    So the test is per-line and by KIND, not by position. An entry goes in the body. A line that
    annotates the FILE rather than its neighbour — a whole-line HTML comment, or a blank — is
    pinned and hoisted to the top, which cannot change what it says. Anything else (a heading, a
    prose paragraph, a nested list) DOES take meaning from its position, so the refusal stands for
    exactly the shape it was written for. Comments keep their relative order and precede the blanks,
    so a stray trailing blank can never end up above the note it follows."""
    head, blanks, body, unknown = [], [], [], []
    for l in lines:
        if l.startswith("- "):
            body.append(l)
        elif _PINNABLE.match(l):
            head.append(l)
        elif not l.strip():
            blanks.append(l)
        else:
            unknown.append(l)
    if unknown:
        return None
    return head + blanks, body


def _line_value(line, files, last, mentioned, now):
    """(value, bytes) of one index line — value is the SUM over the memories it points at, because
    a compacted line carrying forty slugs is forty pointers, not one."""
    n = len(line.encode()) + 1
    sl = _line_slugs(line, files)
    if not sl:
        return (UNRESOLVED_VALUE, n)
    return (sum(TIER_VALUE[_slug_rank(s, files, last, mentioned, now)[0]] for s in sl), n)


def _order_body(body, files, last, mentioned, now):
    """the reordered body — highest value-per-byte first, so what falls past the read limit is the
    least load-bearing rather than the most recent. Ties break on the line text, so the order is a
    pure function of the inputs (a reorder that is not deterministic rewrites the file every tick)."""
    def key(line):
        v, n = _line_value(line, files, last, mentioned, now)
        return (-(v / n), line)
    return sorted(body, key=key)


# COMPACTION — the only lever on HOW MANY memories fit, and what it costs.
#
# The index holds two line shapes: the dense head (`- slug-a, slug-b, ...`, ~41 B per memory) and
# the appended tail (`- [Title](slug.md) — hook`, ~200 B per memory). Ordering (above) decides WHICH
# entries fall past the read limit; it cannot change how many fit. Rewriting a tail line into the
# dense form is a ~5x byte win per memory, and it is the ONLY thing that moves the count.
#
# WHAT IS LOST, stated plainly because a compaction that reads as free is a compaction nobody audits:
#   - the HOOK. Not lost from the corpus — every memory file carries the same sentence in its
#     `description:` frontmatter (verified 676/676 on this node the day this was written), so the
#     hook in the index is a DUPLICATE and a mind that needs it opens the file. What is lost is the
#     ability to judge relevance WITHOUT opening the file, which is exactly what the index is for.
#     So this is a real trade, not a cleanup: N memories keep a weaker pointer so that M memories
#     that had NO pointer at all get one.
#   - SEPARABILITY. Two memories on one line are one unit to the ranker forever after; a cut line
#     now takes its whole cluster with it. This is why merging is ADJACENT-ONLY: after --order,
#     neighbours already have similar value density, so welding them together is the cheapest weld
#     available. Never merge across the whole body — that welds a warm memory to a cold one and the
#     ranker can never separate them again.
# The line cap makes it converge: a line at the cap stops absorbing, so repeated passes are a no-op.

_TAIL_ENTRY = re.compile(r"^- \[[^\]]*\]\([A-Za-z0-9._-]+\.md\)")
COMPACT_MAX_B = 240      # bytes per dense line — the width the existing head is already written at


def _is_dense(line, files):
    """True when the line is nothing BUT pointers — `- slug-a, slug-b`. Such a line can absorb more
    slugs without losing text, which is what makes a second pass merge yesterday's cluster with
    today's instead of leaving a new small cluster beside it every day."""
    if not line.startswith("- "):
        return False
    toks = [t.strip() for t in line[2:].split(",")]
    return bool(toks) and all(t in files for t in toks)


def _compact_body(body, files):
    """the body with adjacent tail-form/dense lines merged into dense slug lines.

    EVERY POINTER SURVIVES: a candidate contributes `_line_slugs` (its whole resolved set), not just
    the slug in its link — a hook that names a sibling memory is a pointer too, and dropping it
    would be this tool losing a memory to save bytes. A line whose pointers do not resolve at all is
    NOT a candidate: an unresolvable pointer is a deleted-or-misspelt memory to be looked at, and
    compaction must not quietly destroy the only text naming it."""
    out, run = [], []

    def flush():
        if not run:
            return
        seen, order = set(), []
        for s in run:
            if s not in seen:
                seen.add(s)
                order.append(s)
        cur = []
        for s in order:
            trial = "- " + ", ".join(cur + [s])
            if cur and len(trial.encode()) > COMPACT_MAX_B:
                out.append("- " + ", ".join(cur))
                cur = [s]
            else:
                cur.append(s)
        if cur:
            out.append("- " + ", ".join(cur))
        run.clear()

    for l in body:
        sl = _line_slugs(l, files)
        if sl and (_is_dense(l, files) or _TAIL_ENTRY.match(l)):
            run.extend(sorted(sl))
            continue
        flush()
        out.append(l)
    flush()
    return out


def _cut_composition(lines, files, last, mentioned, now, limit):
    """(slugs cut, per-tier counts) — the honest before/after axis for a reorder."""
    cum = 0
    cut = set()
    for l in lines:
        before = cum
        cum += len(l.encode()) + 1
        if before >= limit:
            cut |= _line_slugs(l, files)
    per = {t: 0 for t in TIER_VALUE}
    for s in cut:
        per[_slug_rank(s, files, last, mentioned, now)[0]] += 1
    return len(cut), per


def _index_cut(project, lines=None):
    """WHAT THE READ LIMIT ACTUALLY THROWS AWAY. `OVER by 14890 B` is a SIZE, and a size does not
    say that today's learning is the part being discarded — this names the lines and the newest
    casualty. Head-kept/tail-cut, cumulative bytes, straddling line kept (measured above)."""
    out = {"total": None, "cut": None, "newest_slug": None, "newest_ts": None, "limit": None,
           "slugs": None, "cut_slugs": None, "cut_warm": None}
    dirs = [d for d in _memory_dirs() if d.name == project]
    if not dirs:
        return out
    pdir = dirs[0]
    idx = pdir / "memory" / "MEMORY.md"
    try:
        text = idx.read_text(errors="replace") if lines is None else "\n".join(lines) + "\n"
    except OSError:
        return out
    rows = text.splitlines()
    out["total"] = len(rows)
    limit, _raw, _bad = _index_limit()
    if limit is None:
        return out
    out["limit"] = limit
    cum = 0
    cut = []
    for l in rows:
        before = cum
        cum += len(l.encode()) + 1
        if before >= limit:
            cut.append(l)
    out["cut"] = len(cut)
    files = _corpus_files(pdir)
    # THE LINE IS THE RANKER'S UNIT AND THE LOSS'S UNIT, BUT NOT THE VALUE'S. `77 of 192 lines PAST
    # the limit` cannot say that one cut line took eight memories with it, so a compaction step —
    # the only lever there is on the COUNT — reads as pure headroom while it widens the class of
    # memory a neighbour can sink. Publish both units in the same breath so the trade is visible.
    out["slugs"] = len({s for l in rows for s in _line_slugs(l, files)})
    cut_slugs = {s for l in cut for s in _line_slugs(l, files)}
    out["cut_slugs"] = len(cut_slugs)
    if cut_slugs:
        last, mentioned = _use_signals(project, files, use_git=False)
        now = time.time()
        out["cut_warm"] = sum(1 for s in cut_slugs
                              if _slug_rank(s, files, last, mentioned, now)[0] == 4)
    else:
        out["cut_warm"] = 0
    if not cut:
        return out
    newest = (0.0, None)
    for l in cut:
        for s in _line_slugs(l, files):
            try:
                m = files[s].stat().st_mtime
            except OSError:
                continue
            if m > newest[0]:
                newest = (m, s)
    if newest[1]:
        out["newest_slug"] = newest[1]
        out["newest_ts"] = time.strftime("%Y-%m-%dT%H:%MZ", time.gmtime(newest[0]))
    return out


def _cut_oneline(project):
    c = _index_cut(project)
    if c["total"] is None:
        return "  index cut n/a — no MEMORY.md for this corpus"
    if c["limit"] is None:
        return f"  index cut n/a — no MESH_MEMORY_INDEX_LIMIT ({c['total']} index lines)"
    if not c["cut"]:
        return (f"  index cut: none — all {c['total']} index lines "
                f"({c['slugs']} memories) load")
    newest = (f" · newest cut: {c['newest_slug']} {c['newest_ts']}"
              if c["newest_slug"] else " · newest cut: unresolved")
    return (f"  index cut: {c['cut']} of {c['total']} lines / {c['cut_slugs']} of {c['slugs']} "
            f"MEMORIES past the limit (read-warm {c['cut_warm']}){newest}")


def order_index(check=False, project=None):
    """Order EVERY corpus on this node, not the caller's — measured the first minute this ran in
    cron: `_chosen_project` resolves from CLAUDE_PROJECT_SLUG or the CALLER'S CWD, cron's cwd is
    $HOME, and the reflex dutifully reordered the 12-entry `-home-mesh-home` index while the
    649-entry one it was wired for went untouched ("reordered 10 of 12 index line(s)"). Every other
    rendering in this tool has to pick ONE corpus because it prints one answer; a WRITE does not —
    ordering is per-corpus, independent, and cheap, so there is nothing to choose between."""
    dirs = _memory_dirs()
    if project is not None:
        dirs = [d for d in dirs if d.name == project]
        if not dirs:
            sys.stderr.write(f"mesh-memory-recall: no corpus for project {project}\n")
            return 2
    if not dirs:
        sys.stderr.write("mesh-memory-recall: no memory corpus — n/a\n")
        return 2
    rc = 0
    for pdir in dirs:
        r = _order_one(pdir, check)
        rc = r if r and not rc else rc
    return rc


def _order_one(pdir, check=False):
    idx = pdir / "memory" / "MEMORY.md"
    if not idx.exists():
        return 0          # a corpus with no index has nothing to order — not an error, and not a
                          # line of stderr every 15 minutes for the rest of the node's life
    try:
        st0 = idx.stat()
        text = idx.read_text()
    except OSError as e:
        sys.stderr.write(f"mesh-memory-recall: [{pdir.name}] cannot read index ({e}) — n/a\n")
        return 2
    lines = text.splitlines()
    split = _split_index(lines)
    if split is None:
        sys.stderr.write(f"mesh-memory-recall: [{pdir.name}] index is not a flat `- ` list "
                         f"(structure inside the body) — refusing to reorder a shape this tool "
                         f"does not understand\n")
        return 2
    head, body = split
    files = _corpus_files(pdir)
    last, mentioned = _use_signals(pdir.name, files, use_git=False)
    ordered = head + _order_body(body, files, last, mentioned, time.time())
    # NO LINE MAY BE LOST OR INVENTED. This is a rewrite of the mind's own memory index; a ranker
    # bug must fail closed, not silently drop an entry into the same darkness this fixes.
    if sorted(ordered) != sorted(lines):
        sys.stderr.write(f"mesh-memory-recall: [{pdir.name}] reorder would change the line SET "
                         f"— refusing\n")
        return 1
    before = _index_cut(pdir.name, lines)
    after = _index_cut(pdir.name, ordered)
    moved = sum(1 for a, b in zip(ordered, lines) if a != b)
    if check:
        # DRY RUN WRITES NOTHING — not the index, not a log. A --check that touched either would
        # forge the evidence it exists to check (mesh-guardian, 09f7914).
        print(f"  [{pdir.name}] would reorder {moved} of {len(lines)} line(s) in {idx}")
        lim = _index_limit()[0]
        if lim is None:
            print(f"  [{pdir.name}] cut n/a — no MESH_MEMORY_INDEX_LIMIT and none in ~/.mesh/nodes")
            return 0
        now = time.time()
        for nm, ls in (("before", lines), ("after ", ordered)):
            n, per = _cut_composition(ls, files, last, mentioned, now, lim)
            print(f"  cut {nm}: {n:4d} slug(s) past the limit  "
                  f"(read-warm {per[4]}, NEW {per[3]}, index-mediated {per[2]}, "
                  f"read-once {per[1]}, cold {per[0]})")
        print(f"  newest cut before: {before['newest_slug']} {before['newest_ts']}")
        print(f"  newest cut after : {after['newest_slug']} {after['newest_ts']}")
        return 0
    if moved == 0:
        print(f"  [{pdir.name}] order already worst-last ({len(lines)} lines) · "
              f"{_cut_oneline(pdir.name).strip()}")
        return 0
    # A mind may Write MEMORY.md at any moment and holds no lock. Re-stat immediately before the
    # swap and bail if it moved: losing a mind's just-written entry is the failure this tool exists
    # to prevent, so a concurrent write wins and this retries on the next tick.
    st1 = idx.stat()
    if (st1.st_size, st1.st_mtime_ns) != (st0.st_size, st0.st_mtime_ns):
        sys.stderr.write(f"mesh-memory-recall: [{pdir.name}] index changed under us — skipping "
                         f"this pass\n")
        return 0
    tmp = idx.with_suffix(".md.reorder.tmp")
    tmp.write_text("\n".join(ordered) + "\n")
    os.replace(tmp, idx)     # atomic: a session loading the index can never see a torn file
    print(f"  [{pdir.name}] reordered {moved} of {len(lines)} index line(s) worst-last · "
          f"cut {before['cut']} -> {after['cut']} line(s) past the limit")
    return 0


def compact_index(check=False, project=None):
    """Compact EVERY corpus on this node, for the same reason --order does (see order_index)."""
    dirs = _memory_dirs()
    if project is not None:
        dirs = [d for d in dirs if d.name == project]
        if not dirs:
            sys.stderr.write(f"mesh-memory-recall: no corpus for project {project}\n")
            return 2
    if not dirs:
        sys.stderr.write("mesh-memory-recall: no memory corpus — n/a\n")
        return 2
    rc = 0
    for pdir in dirs:
        r = _compact_one(pdir, check)
        rc = r if r and not rc else rc
    return rc


def _compact_one(pdir, check=False):
    idx = pdir / "memory" / "MEMORY.md"
    if not idx.exists():
        return 0
    try:
        st0 = idx.stat()
        text = idx.read_text()
    except OSError as e:
        sys.stderr.write(f"mesh-memory-recall: [{pdir.name}] cannot read index ({e}) — n/a\n")
        return 2
    lines = text.splitlines()
    split = _split_index(lines)
    if split is None:
        sys.stderr.write(f"mesh-memory-recall: [{pdir.name}] index is not a flat `- ` list "
                         f"(structure inside the body) — refusing to compact a shape this tool "
                         f"does not understand\n")
        return 2
    head, body = split
    files = _corpus_files(pdir)
    packed = head + _compact_body(body, files)
    # NO POINTER MAY BE LOST OR INVENTED. --order guards the line SET; compaction changes the lines
    # BY DESIGN, so its invariant is one level down: the set of memories the index points at, and
    # every non-pointer line, must come through untouched. Fail closed — a compactor bug drops a
    # memory into exactly the darkness this exists to pull memories out of.
    def ptrs(ls):
        return {s for l in ls for s in _line_slugs(l, files)}
    def prose(ls):
        return [l for l in ls if not _line_slugs(l, files)]
    if ptrs(packed) != ptrs(lines) or prose(packed) != prose(lines):
        lost = sorted(ptrs(lines) - ptrs(packed))
        sys.stderr.write(f"mesh-memory-recall: [{pdir.name}] compaction would change what the "
                         f"index points at (lost {len(lost)}: {', '.join(lost[:5])}) — refusing\n")
        return 1
    if packed == lines:
        print(f"  [{pdir.name}] already compact ({len(lines)} lines) · "
              f"{_cut_oneline(pdir.name).strip()}")
        return 0
    before = _index_cut(pdir.name, lines)
    after = _index_cut(pdir.name, packed)
    b_b = sum(len(l.encode()) + 1 for l in lines)
    b_a = sum(len(l.encode()) + 1 for l in packed)
    # THE WIDENING IS THE COST AND IT GOES IN THE SAME BREATH AS THE WIN. Bytes saved reads as pure
    # profit; slugs-per-line says how much a single cut line now costs.
    wide_b = max((len(_line_slugs(l, files)) for l in lines), default=0)
    wide_a = max((len(_line_slugs(l, files)) for l in packed), default=0)
    if check:
        # DRY RUN WRITES NOTHING — not the index, not a log (mesh-guardian, 09f7914).
        print(f"  [{pdir.name}] would compact {len(lines)} -> {len(packed)} line(s), "
              f"{b_b} -> {b_a} B in {idx}")
        print(f"  cut: {before['cut_slugs']} -> {after['cut_slugs']} memories past the limit "
              f"({before['cut']} -> {after['cut']} lines)")
        print(f"  widest line: {wide_b} -> {wide_a} memories (a cut line now costs this many)")
        print(f"  newest cut before: {before['newest_slug']} {before['newest_ts']}")
        print(f"  newest cut after : {after['newest_slug']} {after['newest_ts']}")
        return 0
    # A mind may Write MEMORY.md at any moment and holds no lock (see _order_one).
    st1 = idx.stat()
    if (st1.st_size, st1.st_mtime_ns) != (st0.st_size, st0.st_mtime_ns):
        sys.stderr.write(f"mesh-memory-recall: [{pdir.name}] index changed under us — skipping "
                         f"this pass\n")
        return 0
    tmp = idx.with_suffix(".md.compact.tmp")
    tmp.write_text("\n".join(packed) + "\n")
    os.replace(tmp, idx)     # atomic: a session loading the index can never see a torn file
    print(f"  [{pdir.name}] compacted {len(lines)} -> {len(packed)} line(s), {b_b} -> {b_a} B · "
          f"cut {before['cut_slugs']} -> {after['cut_slugs']} memories · "
          f"widest line {wide_b} -> {wide_a}")
    return 0


def _test():
    """gates. Real path asserted, not just fixtures: the regex must pull a slug out of a REAL
    transcript line from the live archive, or this whole meter is measuring nothing."""
    print("mesh-memory-recall --test")
    # A TEST CHILD MUST NOT INHERIT NODE-LOCAL TUNING. Half the legs below assert what this tool
    # does with NO operator limit; this node declares one in ~/.mesh/nodes, so leaving NODES
    # pointing there would make those legs pass or fail on config instead of on code.
    global NODES
    _saved_nodes = NODES
    NODES = Path("/nonexistent/mesh-memory-recall-test/nodes")
    try:
        return _test_body()
    finally:
        NODES = _saved_nodes


def _test_body():
    rc = 0

    def check(name, cond):
        nonlocal rc
        print(f"  {'ok  ' if cond else 'FAIL'} {name}")
        if not cond:
            rc = 1


    # 1) REAL PATH: the regex parses an actual archive line.
    #
    # The n/a hatch here is the dangerous part and is deliberately NOT reachable by a broken regex:
    # a COARSE, independent probe (two plain literals, no shared pattern with READ_RE) first decides
    # whether this node HAS memory-read lines at all. No candidates -> honest n/a. Candidates present
    # but READ_RE matches none -> RED. Without this split, breaking the regex renders "n/a: nothing
    # to assert against" and the meter reports absence as inapplicability — measured: two mutants
    # (name broken, path segment broken) both exited 2 instead of 1 before this was added.
    dirs = _memory_dirs()
    if not dirs:
        print("  n/a  no memory corpus on this node")
        return 2
    self_sid = _self_session()

    probe_dir, _exact = _chosen_project(dirs)

    def _rg(pattern, maxcount="40"):
        try:
            return subprocess.run(["rg", "-m", maxcount, "--no-messages", "-o", pattern,
                                   str(probe_dir)], capture_output=True, text=True,
                                  timeout=90).stdout
        except Exception:
            return None

    # The coarse probe must share NO literal with READ_RE, or one edit breaks both and the gate
    # renders "n/a: nothing to assert" instead of RED — measured: a mutant flipping "name":"Read"
    # broke the probe too, because the probe quoted the same string ("two methods agreeing is not
    # corroboration" — they were one method). So: anchor the probe on the FILE PATH alone, and test
    # for the Read verb with a plain substring check on the DATA, which no edit to READ_RE touches.
    # The leading .{0,80} is load-bearing: rg -o returns only the matched substring, so without it
    # the tool_use id is cut off and every candidate fails to parse (gate RED for the wrong reason).
    coarse = _rg(r'.{0,80}"file_path":"[^"]*/memory/[^"]*\.md"\}')
    if coarse is None:
        print("  n/a  archive unreadable (rg missing or failed)")
        return 2
    seen_lines = [ln for ln in coarse.splitlines() if not (self_sid and self_sid in ln)]
    candidates = [ln for ln in seen_lines if "Read" in ln]
    if not candidates:
        print("  n/a  this node's archive contains no memory Read at all — nothing to assert")
        return 2

    hit = None
    for line in candidates:
        payload = line.split(":", 1)[-1] if line.startswith("/") else line
        m = READ_RE.search(payload)
        if m:
            hit = m
            break
    check(f"READ_RE matches a REAL archive line ({len(candidates)} candidate(s) present)",
          hit is not None)
    if hit is None:
        # the coarse probe proved the lines exist; a strict-regex miss is a BREAK, not an n/a.
        print("  (coarse probe found memory Reads that READ_RE could not parse — parser is broken)")
        return 1
    check("real slug is non-empty", bool(hit.group("slug")))
    check("real slug is a bare stem, not a path", "/" not in hit.group("slug"))
    check("real tool_use id captured", hit.group("tid").startswith("toolu_"))

    # 2) the exact line shape, held as a fixture so a harness format change goes RED here
    fixture = ('{"timestamp":"2026-08-15T10:00:00.000Z","message":{"content":[{"type":"tool_use",'
               '"id":"toolu_01ABCdef","name":"Read","input":{"file_path":"/home/u/.claude/projects/'
               '-p/memory/some-slug-here.md"},"caller":{"type":"direct"}}]}}')
    m = READ_RE.search(fixture)
    check("fixture parses", m is not None)
    check("fixture slug correct", m and m.group("slug") == "some-slug-here")

    # 3) NEGATIVES — the regex must not claim a read it did not see
    check("a Write to memory/ is NOT a read",
          READ_RE.search(fixture.replace('"name":"Read"', '"name":"Write"')) is None)
    check("a Read of a non-memory path is NOT counted",
          READ_RE.search(fixture.replace("/memory/", "/docs/")) is None)
    _mem_md = READ_RE.search(fixture.replace("some-slug-here.md", "MEMORY.md"))
    check("MEMORY.md index load is distinguishable from a per-memory recall",
          _mem_md is not None and _mem_md.group("slug") == "MEMORY")
    # a slug must be a bare stem: a nested path under memory/ must not smuggle a "/" into it
    _nested = READ_RE.search(fixture.replace("/memory/some-slug-here.md",
                                             "/memory/sub/dir/some-slug-here.md"))
    check("a nested path yields a bare stem or no match",
          _nested is None or "/" not in _nested.group("slug"))

    # 3b) PROJECT SELECTION. The fallback branch is unreachable on a node whose cwd matches its
    #     project, so a mutant swapping it back to dirs[0] survives every other leg — drive it with
    #     a synthetic corpus where the alphabetically-first dir is the SMALLEST. This is the exact
    #     bug that reported "12 memories, 126 deleted" on a 400-memory node.
    import tempfile as _tf
    with _tf.TemporaryDirectory() as _td:
        _td = Path(_td)
        for nm, n in (("-aaa-small", 1), ("-zzz-big", 5)):
            (_td / nm / "memory").mkdir(parents=True)
            for i in range(n):
                (_td / nm / "memory" / f"m{i}.md").write_text("x")
        _dirs = sorted(_td.iterdir())
        _pick, _exact = _chosen_project(_dirs)
        check("project fallback picks the LARGEST corpus, not dirs[0]", _pick.name == "-zzz-big")
        check("fallback reports itself as inexact", _exact is False)
        # ...and the caller's cwd MUST be able to change the answer only when it is not pinned.
        _saved_slug = os.environ.get("CLAUDE_PROJECT_SLUG")
        try:
            os.environ["CLAUDE_PROJECT_SLUG"] = "-aaa-small"
            _p2, _e2 = _chosen_project(_dirs)
            check("an explicit CLAUDE_PROJECT_SLUG beats the largest-corpus fallback",
                  _p2.name == "-aaa-small" and _e2 is True)
        finally:
            os.environ.pop("CLAUDE_PROJECT_SLUG", None)
            if _saved_slug is not None:
                os.environ["CLAUDE_PROJECT_SLUG"] = _saved_slug

    # 4) DEDUP, driven through the REAL scan() — not a set literal.
    #    The earlier version asserted `tid in {tid}`, which is true no matter what the code does;
    #    disabling the dedup branch left it green. This drives two full scans over a fixture
    #    transcript and asserts the log does not grow on the second.
    import tempfile
    global PROJECTS, LOG, STATE
    _saved = (PROJECTS, LOG, STATE)
    try:
        with tempfile.TemporaryDirectory() as td:
            td = Path(td)
            proj = td / "projects" / "-fixture"
            (proj / "memory").mkdir(parents=True)
            (proj / "memory" / "some-slug-here.md").write_text("---\nname: some-slug-here\n---\nx\n")
            (proj / "fixture-session.jsonl").write_text(fixture + "\n")
            PROJECTS, LOG, STATE = td / "projects", td / "recall.log", td / "recall.state"
            scan(verbose=False)
            n1 = len(LOG.read_text().splitlines()) if LOG.exists() else 0
            STATE.unlink(missing_ok=True)      # force a full re-scan: only dedup can save us
            scan(verbose=False)
            n2 = len(LOG.read_text().splitlines()) if LOG.exists() else 0
            check("scan() logs the fixture recall", n1 == 1)
            check("re-scan does NOT double-count (dedup on tool_use id)", n2 == n1)

            # ...and dedup must hold WITHIN one scan too. The cross-scan leg above is carried by
            # _seen_tids() re-reading the log, so it stays green even if the in-loop seen.add() is
            # deleted; only a repeated id inside a single chunk exercises that line.
            (proj / "dup-session.jsonl").write_text(fixture + "\n" + fixture + "\n")
            LOG.unlink(missing_ok=True)
            STATE.unlink(missing_ok=True)
            scan(verbose=False)
            n3 = len(LOG.read_text().splitlines()) if LOG.exists() else 0
            check("a repeated tool_use id within ONE scan logs once", n3 == 1)
    finally:
        PROJECTS, LOG, STATE = _saved

    # 6) --influence: the four cells must PARTITION the corpus, and a slug named on the board but
    #    never read must land in INDEX-MEDIATED (the cell the whole decision rests on). Driven
    #    through the real influence() against a fixture corpus + a fixture board.
    global BOARD
    _saved2 = (PROJECTS, LOG, STATE, BOARD)
    try:
        with tempfile.TemporaryDirectory() as td:
            td = Path(td)
            proj = td / "projects" / "-fixture"
            (proj / "memory").mkdir(parents=True)
            for s in ("slug-read-and-named", "slug-named-only", "slug-read-only", "slug-cold"):
                (proj / "memory" / f"{s}.md").write_text(
                    # every fixture memory cross-links a SIBLING: if influence() ever scanned the
                    # memory dir, these links alone would mark all four as "mentioned" and the COLD
                    # cell would collapse to zero — the corpus justifying its own existence.
                    f"---\nname: {s}\n---\nsee [[slug-cold]] and [[slug-named-only]]\n")
            PROJECTS, LOG, STATE = td / "projects", td / "recall.log", td / "recall.state"
            BOARD = td / "chat.log"
            BOARD.write_text("[fyi] cites slug-read-and-named and slug-named-only\n")
            LOG.write_text("2026-01-01T00:00:00\tslug-read-and-named\ts\tt1\t-fixture\n"
                           "2026-01-01T00:00:00\tslug-read-only\ts\tt2\t-fixture\n")
            import io
            import contextlib
            buf = io.StringIO()
            with contextlib.redirect_stdout(buf):
                irc = influence()
            out = buf.getvalue()

            def cell(nm):
                m = re.search(rf"^  {nm} +(\d+)", out, re.M)
                return int(m.group(1)) if m else -1

            check("--influence runs on a fixture corpus", irc == 0)
            check("ACTIVE = read AND named", cell("ACTIVE") == 1)
            check("INDEX-MEDIATED = named, never opened", cell("INDEX-MEDIATED") == 1)
            check("PRIVATE = opened, never named", cell("PRIVATE") == 1)
            check("COLD survives sibling [[wiki-links]] (memory dir NOT scanned)", cell("COLD") == 1)
            check("the four cells partition the corpus",
                  cell("ACTIVE") + cell("INDEX-MEDIATED") + cell("PRIVATE") + cell("COLD")
                  == cell("corpus") == 4)
    finally:
        PROJECTS, LOG, STATE, BOARD = _saved2

    # 3c) --oneline MUST NAME THE CORPUS IT COUNTED. This meter's subject varies by caller (slug or
    #     cwd), so a rendering that omits it is unfalsifiable: the witness pane read "12 memories ·
    #     5 opened (42%)" off a near-miss corpus for weeks and nothing in the line disagreed with
    #     the mind pane's "607 · 22%". Driven through the real report() against a fixture corpus.
    global _ONELINE
    import tempfile
    _saved4 = (PROJECTS, LOG, STATE, _ONELINE)
    _saved_slug = os.environ.get("CLAUDE_PROJECT_SLUG")
    try:
        import io
        import contextlib
        with tempfile.TemporaryDirectory() as td:
            td = Path(td)
            for nm, n in (("-decoy-tiny", 1), ("-real-corpus", 4)):
                (td / "projects" / nm / "memory").mkdir(parents=True)
                for i in range(n):
                    (td / "projects" / nm / "memory" / f"m{i}.md").write_text("x")
            PROJECTS, LOG, STATE = td / "projects", td / "recall.tsv", td / "recall.state"
            LOG.write_text("2026-01-01T00:00:00\tm0\ts\tt1\t-real-corpus\n"
                           "2026-01-01T00:00:00\tm0\ts\tt2\t-decoy-tiny\n")
            _ONELINE = True
            for want, other in (("-decoy-tiny", "-real-corpus"), ("-real-corpus", "-decoy-tiny")):
                os.environ["CLAUDE_PROJECT_SLUG"] = want
                buf = io.StringIO()
                with contextlib.redirect_stdout(buf):
                    report()
                out = buf.getvalue()
                check(f"--oneline names the corpus it counted ({want})",
                      want in out and other not in out)
    finally:
        PROJECTS, LOG, STATE, _ONELINE = _saved4
        os.environ.pop("CLAUDE_PROJECT_SLUG", None)
        if _saved_slug is not None:
            os.environ["CLAUDE_PROJECT_SLUG"] = _saved_slug

    # 4) INDEX PRESSURE — the policy's scarce resource. Each leg drives _index_block against a
    # hand-written ledger, because the failure this guards is a NUMBER that reads plausibly:
    # a rate off by 20x, or a headroom quoted from a limit nobody measured.
    global INDEX_LOG
    _saved3 = INDEX_LOG
    _saved_lim = os.environ.get("MESH_MEMORY_INDEX_LIMIT")
    try:
        with tempfile.TemporaryDirectory() as td:
            INDEX_LOG = Path(td) / "idx.tsv"
            os.environ.pop("MESH_MEMORY_INDEX_LIMIT", None)

            def block(rows):
                INDEX_LOG.write_text("".join("\t".join(map(str, r)) + "\n" for r in rows))
                return "\n".join(_index_block("proj"))

            # one sample cannot be a rate, and a sub-span pair cannot either
            one = block([("2026-08-16T00:00:00Z", "proj", 10000, 400)])
            check("a single sample renders growth n/a, never 0", "index growth   n/a" in one)
            near = block([("2026-08-16T00:00:00Z", "proj", 10000, 400),
                          ("2026-08-16T00:20:00Z", "proj", 10400, 404)])
            check("a 20-min span is refused (0.33h < 1h), not extrapolated to +28800 B/day",
                  "index growth   n/a" in near)

            # the real shape: +2400 B over 12h is +4800 B/day, ~20x the ~250 B/day that "17.2K of
            # 24.4K, ~4 weeks" implied. The gate is that arithmetic, not the prose.
            wide = block([("2026-08-15T14:00:00Z", "proj", 17200, 402),
                          ("2026-08-16T02:00:00Z", "proj", 19600, 452)])
            check("rate is derived from the span (+2400 B / 12h -> +4800 B/day)",
                  "+4800 B/day" in wide)
            check("entry rate rides the same span (+50 / 12h -> +100/day)", "+100.0 entries" in wide)
            check("no headroom is claimed while MESH_MEMORY_INDEX_LIMIT is unset",
                  "headroom n/a" in wide and "MESH_MEMORY_INDEX_LIMIT unset" in wide)

            os.environ["MESH_MEMORY_INDEX_LIMIT"] = "25000"
            withlim = block([("2026-08-15T14:00:00Z", "proj", 17200, 402),
                             ("2026-08-16T02:00:00Z", "proj", 19600, 452)])
            # 5400 B left at 4800 B/day = 1.1 d. The prose said ~4 weeks from the same two numbers.
            check("headroom + ETA appear once a limit is supplied",
                  "5400 B of 25000 B" in withlim and "1.1 d" in withlim)

            # OVER the limit, left/per_day is NEGATIVE and means "crossed N days AGO" — printed
            # inside the same future-tense phrase as the under-limit case it read as time
            # remaining ("-11045 B -> -1.3 d at the measured rate"). The gate is that no minus
            # sign survives into the ETA and that the wording names the crossing.
            over = block([("2026-08-15T14:00:00Z", "proj", 30000, 402),
                          ("2026-08-16T02:00:00Z", "proj", 32400, 452)])
            over_hr = [l for l in over.splitlines() if "headroom" in l][0]
            check("an over-limit headroom reads as crossed, never as time remaining",
                  "OVER by 7400 B of 25000 B" in over_hr
                  and "crossed ~1.5 d ago" in over_hr
                  and "-" not in over_hr.split("->")[1])

            # THE WORST NUMBER MUST SURVIVE THE SHORT RENDERING. --oneline is the form the pane
            # runs; --report is the form nothing runs on a cadence. Driven through the real
            # report(), not the formatter, because the omission was a `return 0` above the block.
            _saved5 = (PROJECTS, LOG, STATE, _ONELINE)
            _slug5 = os.environ.get("CLAUDE_PROJECT_SLUG")
            try:
                with tempfile.TemporaryDirectory() as od:
                    od = Path(od)
                    (od / "projects" / "-hr" / "memory").mkdir(parents=True)
                    (od / "projects" / "-hr" / "memory" / "m0.md").write_text("x")
                    PROJECTS, LOG, STATE = od / "projects", od / "r.tsv", od / "r.state"
                    LOG.write_text("2026-01-01T00:00:00\tm0\ts\tt1\t-hr\n")
                    INDEX_LOG.write_text("2026-08-15T14:00:00Z\t-hr\t30000\t402\n"
                                         "2026-08-16T02:00:00Z\t-hr\t32400\t452\n")
                    os.environ["CLAUDE_PROJECT_SLUG"] = "-hr"
                    _ONELINE = True
                    buf = io.StringIO()
                    with contextlib.redirect_stdout(buf):
                        report()
                    one = buf.getvalue()
                    check("--oneline carries the over-limit headroom, not only --report",
                          "OVER by 7400 B" in one and "32400 B of 25000 B" in one)
                    check("--oneline says how long ago the ceiling was crossed",
                          "crossed ~1.5 d ago" in one)
                    os.environ.pop("MESH_MEMORY_INDEX_LIMIT", None)
                    buf = io.StringIO()
                    with contextlib.redirect_stdout(buf):
                        report()
                    check("--oneline refuses a headroom with no operator limit",
                          "headroom n/a (no MESH_MEMORY_INDEX_LIMIT)" in buf.getvalue())
                    os.environ["MESH_MEMORY_INDEX_LIMIT"] = "25000"
            finally:
                PROJECTS, LOG, STATE, _ONELINE = _saved5
                os.environ.pop("CLAUDE_PROJECT_SLUG", None)
                if _slug5 is not None:
                    os.environ["CLAUDE_PROJECT_SLUG"] = _slug5

            # A UTC stamp must not be read as LOCAL. The obvious fixture — an ordinary span under
            # TZ=America/New_York — is VACUOUS: mktime applies the same offset to both endpoints
            # and the subtraction cancels it, so timegm and mktime agree and the leg passes for
            # either implementation (measured: the mktime mutant stayed green against it). The one
            # span where local parsing actually diverges is one containing a DST transition, where
            # the offset is not the same at both ends. 2026-11-01, New York, falls back at 02:00
            # local: read as local, 00:00Z..12:00Z is 13 real hours, not 12, and the rate drops
            # 4800 -> 4430 B/day. That difference is the assertion.
            os.environ["TZ"] = "America/New_York"
            time.tzset()
            tzrow = block([("2026-11-01T00:00:00Z", "proj", 17200, 402),
                           ("2026-11-01T12:00:00Z", "proj", 19600, 452)])
            check("a DST-crossing span is parsed as UTC (12h, not 13h -> +4800 B/day)",
                  "+4800 B/day" in tzrow and "over 12.0h" in tzrow)

            # the sampler is change-gated: an unchanged index must not append a row
            os.environ.pop("TZ", None)
            time.tzset()
            with tempfile.TemporaryDirectory() as pd:
                proj = Path(pd) / "-fixture"
                (proj / "memory").mkdir(parents=True)
                (proj / "memory" / "MEMORY.md").write_text("- [a](a.md)\n")
                (proj / "memory" / "a.md").write_text("x")
                INDEX_LOG.write_text("")
                _index_record(proj)
                first = len(_index_rows("-fixture"))
                _index_record(proj)
                check("an unchanged index appends no second row (change-gated)",
                      first == 1 and len(_index_rows("-fixture")) == 1)
                (proj / "memory" / "b.md").write_text("y")
                _index_record(proj)
                check("a changed index does append", len(_index_rows("-fixture")) == 2)
    finally:
        INDEX_LOG = _saved3
        os.environ.pop("MESH_MEMORY_INDEX_LIMIT", None)
        if _saved_lim is not None:
            os.environ["MESH_MEMORY_INDEX_LIMIT"] = _saved_lim

    # 7) THE LIMIT'S SOURCES. A cron reflex carries no shell env, so without the ~/.mesh/nodes
    #    fallback the pane and the reflex would render two different verdicts for one file.
    global NODES
    _saved_n = NODES
    _saved_lim2 = os.environ.get("MESH_MEMORY_INDEX_LIMIT")
    try:
        with tempfile.TemporaryDirectory() as td:
            NODES = Path(td) / "nodes"
            NODES.write_text("# export MESH_MEMORY_INDEX_LIMIT=999   <- commented, must be ignored\n"
                             "export MESH_MEMORY_INDEX_LIMIT=24985\n")
            os.environ.pop("MESH_MEMORY_INDEX_LIMIT", None)
            check("the limit falls back to the node's ~/.mesh/nodes declaration",
                  _index_limit() == (24985, "24985", False))
            os.environ["MESH_MEMORY_INDEX_LIMIT"] = "31000"
            check("an explicit env limit beats the node file", _index_limit()[0] == 31000)
            os.environ.pop("MESH_MEMORY_INDEX_LIMIT", None)
            NODES.write_text("export MESH_MEMORY_INDEX_LIMIT=twenty-five-thousand\n")
            check("a non-integer declaration is refused, not defaulted",
                  _index_limit() == (None, "twenty-five-thousand", True))
            NODES = Path(td) / "absent"
            check("no env and no declaration renders no limit at all",
                  _index_limit() == (None, "", False))
    finally:
        NODES = _saved_n
        os.environ.pop("MESH_MEMORY_INDEX_LIMIT", None)
        if _saved_lim2 is not None:
            os.environ["MESH_MEMORY_INDEX_LIMIT"] = _saved_lim2

    # 8) THE CUT. This is the whole point: "OVER by 14890 B" is a size and names no casualty. The
    #    truncation rule is MEASURED (head-kept, tail-cut, straddling line KEPT) and the gate is
    #    that arithmetic — a fixture where the boundary falls INSIDE a line, so an off-by-one in
    #    either direction goes red.
    _saved6 = (PROJECTS, NODES, LOG, BOARD)
    _saved_lim3 = os.environ.get("MESH_MEMORY_INDEX_LIMIT")
    try:
        with tempfile.TemporaryDirectory() as td:
            td = Path(td)
            mem = td / "projects" / "-cut" / "memory"
            mem.mkdir(parents=True)
            PROJECTS = td / "projects"
            NODES = td / "absent-nodes"
            LOG, BOARD = td / "r.tsv", td / "board.log"   # never the node's real ones: a fixture
            BOARD.write_text("")                          # must not read node-global state
            LOG.write_text("")
            rows = [f"- [e{i}](e{i}.md) — {'x'*80}" for i in range(6)]
            W = len(rows[0].encode()) + 1          # DERIVE the width; do not assume it. The em dash
            # mtimes deliberately NOT monotonic in line order: e3 is the newest, e5 is the LAST
            # cut line. A "newest" that is really "the last one I looked at" answers e5 here.
            ages = {0: 10, 1: 20, 2: 30, 3: 900, 4: 40, 5: 50}
            for i in range(6):
                (mem / f"e{i}.md").write_text("x")
                os.utime(mem / f"e{i}.md", (1_000_000 + ages[i], 1_000_000 + ages[i]))
            (mem / "MEMORY.md").write_text("\n".join(rows) + "\n")
            check("fixture lines are all one width, so the boundary arithmetic is exact",
                  len({len(r.encode()) for r in rows}) == 1)   # is 3 bytes, not 1
            os.environ.pop("MESH_MEMORY_INDEX_LIMIT", None)
            c = _index_cut("-cut")
            check("with no limit the cut is n/a, never 0", c["cut"] is None and c["total"] == 6)
            check("--oneline says WHY the cut is unknown",
                  "no MESH_MEMORY_INDEX_LIMIT" in _cut_oneline("-cut"))
            # a limit landing INSIDE line 3: lines 1-3 load (the straddler is kept), 4-6 are cut.
            # An off-by-one in either direction moves the count and goes red here.
            os.environ["MESH_MEMORY_INDEX_LIMIT"] = str(2 * W + W // 2)
            c = _index_cut("-cut")
            check("the straddling line is KEPT and everything after it is cut (3 of 6)",
                  c["cut"] == 3 and c["total"] == 6)
            check("the newest CUT entry is named, and it is the newest — not the last line",
                  c["newest_slug"] == "e3")
            check("--oneline publishes the cut, not only the size",
                  "3 of 6 lines" in _cut_oneline("-cut")
                  and "e3" in _cut_oneline("-cut"))
            # THE UNIT THE VALUE LIVES IN. A cut LINE may carry one memory or forty, so a line
            # count cannot express what the cut cost. Here they happen to agree (one slug per
            # line); the bundle leg below is the one where they diverge.
            check("--oneline publishes the cut in MEMORIES, not only in lines",
                  "3 of 6 MEMORIES" in _cut_oneline("-cut")
                  and _index_cut("-cut")["cut_slugs"] == 3)
            # A BUNDLE MAKES THE TWO UNITS DIVERGE, and without this leg the memory count is only
            # the line count under another name. Fold e4+e5 into ONE line: the cut is now 2 lines
            # and still 3 memories, so a rendering that counted lines and called them memories
            # reads 2 here and goes red.
            _row = (mem / "MEMORY.md").read_text().splitlines()
            # the LINK form on purpose: the bare-slug form needs >=7 chars and `e4` is two, so a
            # bundle written `- e4, e5` would resolve to nothing and this leg would pass by
            # measuring an empty line against an empty line.
            (mem / "MEMORY.md").write_text(
                "\n".join(_row[:4] + ["- [E4](e4.md), [E5](e5.md)"]) + "\n")
            check("a bundle line cut takes MORE memories than lines with it",
                  _index_cut("-cut")["cut"] == 2
                  and _index_cut("-cut")["cut_slugs"] == 3
                  and "2 of 5 lines / 3 of 6 MEMORIES" in _cut_oneline("-cut"))
            (mem / "MEMORY.md").write_text("\n".join(_row) + "\n")
            # READ-WARM IS THE NUMBER THE WHOLE COMPOSITION ARGUMENT TURNS ON, and 0 is its
            # healthy reading — so a leg that only ever sees a corpus with no reads asserts
            # nothing at all. Make e4 warm and watch the count follow it across the boundary.
            _warm = time.strftime("%Y-%m-%dT%H:%M:%S", time.gmtime(time.time() - 3600))
            LOG.write_text(f"{_warm}\te4\ts\tt1\t-cut\n")
            check("a read-warm memory below the cut is COUNTED, not swallowed by the line count",
                  _index_cut("-cut")["cut_warm"] == 1
                  and "(read-warm 1)" in _cut_oneline("-cut"))
            LOG.write_text(f"{_warm}\te0\ts\tt1\t-cut\n")
            check("a read-warm memory ABOVE the cut is not counted as a casualty",
                  _index_cut("-cut")["cut_warm"] == 0)
            LOG.write_text("")
            os.environ["MESH_MEMORY_INDEX_LIMIT"] = "10000"
            check("an index that fits says so", "none" in _cut_oneline("-cut")
                  and _index_cut("-cut")["cut"] == 0)
            # AGAINST THE BUNDLE AGAIN, not the one-slug-per-line file: with 5 lines carrying 6
            # memories, a fits-branch that printed its LINE count reads "5 memories" and goes red.
            (mem / "MEMORY.md").write_text(
                "\n".join(_row[:4] + ["- [E4](e4.md), [E5](e5.md)"]) + "\n")
            check("an index that fits still says how many MEMORIES load, not how many lines",
                  "6 memories" in _cut_oneline("-cut")
                  and _index_cut("-cut")["total"] == 5
                  and _index_cut("-cut")["cut_slugs"] == 0)
            (mem / "MEMORY.md").write_text("\n".join(_row) + "\n")
    finally:
        PROJECTS, NODES, LOG, BOARD = _saved6
        os.environ.pop("MESH_MEMORY_INDEX_LIMIT", None)
        if _saved_lim3 is not None:
            os.environ["MESH_MEMORY_INDEX_LIMIT"] = _saved_lim3

    # 9) THE ORDER ITSELF.
    now = time.time()
    with tempfile.TemporaryDirectory() as td:
        mem = Path(td) / "memory"
        mem.mkdir(parents=True)
        old = now - 90 * 86400
        for nm, mt in ([("fresh-memory-here", now - 600), ("cold-memory-here", old),
                        ("read-memory-here", old), ("named-memory-here", old)]
                       + [(f"cold-bundle-slug-{i:02d}", old) for i in range(1, 13)]):
            f = mem / f"{nm}.md"
            f.write_text("x")
            os.utime(f, (mt, mt))
        files = {p.stem: p for p in mem.glob("*.md")}
        last = {"read-memory-here": time.strftime("%Y-%m-%dT%H:%M:%S", time.gmtime(now - 3600))}
        ment = {"named-memory-here"}
        r = lambda s: _slug_rank(s, files, last, ment, now)[0]
        check("a warm read outranks a fresh write", r("read-memory-here") > r("fresh-memory-here"))
        check("a fresh write outranks an index-mediated mention",
              r("fresh-memory-here") > r("named-memory-here"))
        check("an index-mediated mention outranks a cold entry",
              r("named-memory-here") > r("cold-memory-here"))
        check("cold is the floor", r("cold-memory-here") == 0)

        fresh_line = "- [Fresh](fresh-memory-here.md) — a hook"
        cold_line = "- [Cold](cold-memory-here.md) — a hook"
        bundle = "- " + ", ".join(f"cold-bundle-slug-{i:02d}" for i in range(1, 6))
        # THE ONE FIXTURE WHERE per-LINE AND per-BYTE DISAGREE, without which "value density" is
        # asserted by nothing: twelve COLD slugs (line value 12) outweigh one fresh entry (8) per
        # LINE, while the padding makes the same line far worse per BYTE.
        fat_bundle = ("- " + ", ".join(f"cold-bundle-slug-{i:02d}" for i in range(1, 13))
                      + " " * 600)
        body = [cold_line, fresh_line, bundle]
        out = _order_body(body, files, last, ment, now)
        check("a NEW entry sorts above a COLD entry of the same width",
              out.index(fresh_line) < out.index(cold_line))
        check("a dense bundle of 5 outranks a single cold entry (value per BYTE, not per line)",
              out.index(bundle) < out.index(cold_line))
        fat = _order_body([fat_bundle, fresh_line], files, last, ment, now)
        check("value is per BYTE: a wide low-value line loses to a narrow high-value one",
              _line_value(fat_bundle, files, last, ment, now)[0]
              > _line_value(fresh_line, files, last, ment, now)[0]      # per-line: bundle wins
              and fat.index(fresh_line) < fat.index(fat_bundle))       # per-byte: fresh wins
        check("the order is deterministic (a non-deterministic ranker rewrites the file every tick)",
              _order_body(body, files, last, ment, now) == out)
        check("_split_index pins a leading comment and refuses structure inside the body",
              _split_index(["<!-- header -->", "- a", "- b"]) == (["<!-- header -->"], ["- a", "- b"])
              and _split_index(["- a", "## section", "- b"]) is None)
        # THE REFUSAL THAT WENT PERMANENT. A mind wrote MEMORY.md with its entry on line 1 and the
        # convention comment on line 2; the leading-run test then refused the live index on every
        # */15 tick while the two toy corpora reported green. A comment annotates the FILE, so
        # hoisting it cannot change what it says — and a heading still must not move.
        check("a comment BELOW the first entry is pinned, not a permanent refusal",
              _split_index(["- a", "<!-- note -->", "- b"])
              == (["<!-- note -->"], ["- a", "- b"]))
        check("a blank line never lands above the note it followed",
              _split_index(["- a", "", "<!-- note -->"]) == (["<!-- note -->", ""], ["- a"]))
        check("structure that DOES take meaning from its position is still refused",
              _split_index(["- a", "prose paragraph", "- b"]) is None
              and _split_index(["- a", "### s", "- b"]) is None)
        check("pinning loses no line and invents none",
              (lambda h, b: sorted(h + b))(*_split_index(["- b", "<!-- n -->", "", "- a"]))
              == sorted(["- b", "<!-- n -->", "", "- a"]))

    # 10) --order END TO END, driven through the real entry point on a fixture corpus whose NEWEST
    #     memory starts below the cut — the exact live shape — plus the two ways this may not fail:
    #     it may not lose a line, and a dry run may not write.
    _saved7 = (PROJECTS, LOG, BOARD, NODES)
    _slug7 = os.environ.get("CLAUDE_PROJECT_SLUG")
    _lim7 = os.environ.get("MESH_MEMORY_INDEX_LIMIT")
    try:
        with tempfile.TemporaryDirectory() as td:
            td = Path(td)
            mem = td / "projects" / "-ord" / "memory"
            mem.mkdir(parents=True)
            PROJECTS, LOG, BOARD = td / "projects", td / "r.tsv", td / "board.log"
            NODES = td / "absent"
            BOARD.write_text("")
            hot = time.strftime("%Y-%m-%dT%H:%M:%S", time.gmtime(now - 3600))
            rows = []
            for i in range(6):
                (mem / f"old{i}.md").write_text("x")
                os.utime(mem / f"old{i}.md", (now - 90 * 86400,) * 2)
                rows.append(f"- [Old{i}](old{i}.md) — {'x'*80}")
            (mem / "brandnew.md").write_text("x")
            rows.append(f"- [New](brandnew.md) — {'x'*80}")          # newest, appended LAST
            (mem / "MEMORY.md").write_text("<!-- head -->\n" + "\n".join(rows) + "\n")
            LOG.write_text(f"{hot}\told0\ts\tt1\t-ord\n")
            os.environ["CLAUDE_PROJECT_SLUG"] = "-ord"
            os.environ["MESH_MEMORY_INDEX_LIMIT"] = "350"
            idx = mem / "MEMORY.md"
            before = _index_cut("-ord")
            check("fixture reproduces the live shape: the NEWEST entry is cut",
                  before["newest_slug"] == "brandnew")
            st_before = idx.stat().st_mtime_ns
            body_before = idx.read_text()
            buf = io.StringIO()
            with contextlib.redirect_stdout(buf):
                orc = order_index(check=True)
            check("--order --check runs", orc == 0)
            check("--order --check WRITES NOTHING (a dry run may not forge its own artifact)",
                  idx.read_text() == body_before and idx.stat().st_mtime_ns == st_before)
            check("--order --check reports the cut composition, not just a count",
                  "NEW" in buf.getvalue() and "cold" in buf.getvalue())
            with contextlib.redirect_stdout(io.StringIO()):
                orc = order_index()
            after = _index_cut("-ord")
            check("--order rewrites the index", orc == 0 and idx.read_text() != body_before)
            check("the newest memory now LOADS (it was past the limit before)",
                  after["newest_slug"] != "brandnew")
            check("no line is lost or invented by the reorder",
                  sorted(idx.read_text().splitlines()) == sorted(body_before.splitlines()))
            check("the pinned header stays first",
                  idx.read_text().splitlines()[0] == "<!-- head -->")
            with contextlib.redirect_stdout(io.StringIO()):
                order_index()
            check("a second pass is a no-op (idempotent, so cron cannot churn the file)",
                  sorted(idx.read_text().splitlines()) == sorted(body_before.splitlines()))
            # A MIND MAY WRITE MEMORY.md AT ANY MOMENT AND HOLDS NO LOCK. Inject a write between the
            # read and the swap: losing a just-written entry is the failure this tool exists to
            # prevent, so the pass must abort and leave the mind's version standing.
            idx.write_text("<!-- head -->\n" + "\n".join(reversed(rows)) + "\n")
            _real_order = _order_body
            racer = {"n": 0}

            def _racing_order(body, files, last, ment, nowarg):
                racer["n"] += 1
                with open(idx, "a") as fh:
                    fh.write("- [Raced](raced.md) — written by another mind mid-pass\n")
                return _real_order(body, files, last, ment, nowarg)

            globals()["_order_body"] = _racing_order
            try:
                buf = io.StringIO()
                with contextlib.redirect_stdout(buf):
                    rrc = order_index()
            finally:
                globals()["_order_body"] = _real_order
            check("a concurrent write aborts the pass instead of clobbering it",
                  racer["n"] == 1 and rrc == 0
                  and idx.read_text().splitlines()[-1].startswith("- [Raced]"))

            # 10b) EVERY CORPUS, NOT THE CALLER'S. Caught by the first live cron tick: cron's cwd is
            #      $HOME, _chosen_project resolved the 12-entry corpus, and the reflex reordered
            #      THAT while the 649-entry index it was wired for went untouched. A second corpus
            #      whose index is in the wrong order must come out ordered too.
            mem2 = td / "projects" / "-ord2" / "memory"
            mem2.mkdir(parents=True)
            for nm in ("aaa-cold-memory-slug", "zzz-fresh-memory-slug"):
                (mem2 / f"{nm}.md").write_text("x")
            os.utime(mem2 / "aaa-cold-memory-slug.md", (now - 90 * 86400,) * 2)
            second = ("- [Cold](aaa-cold-memory-slug.md) — x\n"
                      "- [Fresh](zzz-fresh-memory-slug.md) — x\n")
            (mem2 / "MEMORY.md").write_text(second)
            # ...and a corpus carrying no index at all must be an honest skip, not an error on
            # stderr every 15 minutes forever.
            (td / "projects" / "-noindex" / "memory").mkdir(parents=True)
            os.environ["CLAUDE_PROJECT_SLUG"] = "-ord"     # the caller still names corpus ONE
            err = io.StringIO()
            with contextlib.redirect_stdout(io.StringIO()), contextlib.redirect_stderr(err):
                mrc = order_index()
            got = (mem2 / "MEMORY.md").read_text()
            check("--order orders EVERY corpus, not the one the caller's cwd names",
                  mrc == 0 and got.startswith("- [Fresh]") and got != second)
            check("a corpus with no MEMORY.md is skipped silently, not an error line per tick",
                  "-noindex" not in err.getvalue() and err.getvalue() == "")

            # 10c) THE ORDER MUST NOT DEPEND ON THE CALLER'S CWD. `git log` runs against it, and the
            #      reflex runs from $HOME. Poison `git` on PATH: if the ordering path shells out at
            #      all, the poisoned binary writes a marker file and this goes red.
            bindir = td / "poison"
            bindir.mkdir()
            marker = td / "git-was-called"
            (bindir / "git").write_text(f"#!/bin/sh\ntouch {marker}\nexit 0\n")
            (bindir / "git").chmod(0o755)
            _path = os.environ.get("PATH", "")
            try:
                os.environ["PATH"] = f"{bindir}:{_path}"
                (mem2 / "MEMORY.md").write_text(second)
                with contextlib.redirect_stdout(io.StringIO()):
                    order_index()
            finally:
                os.environ["PATH"] = _path
            check("the ordering pass never shells out to git (cwd-dependent input)",
                  not marker.exists())
    finally:
        PROJECTS, LOG, BOARD, NODES = _saved7
        os.environ.pop("CLAUDE_PROJECT_SLUG", None)
        os.environ.pop("MESH_MEMORY_INDEX_LIMIT", None)
        if _slug7 is not None:
            os.environ["CLAUDE_PROJECT_SLUG"] = _slug7
        if _lim7 is not None:
            os.environ["MESH_MEMORY_INDEX_LIMIT"] = _lim7

    # 11) --compact END TO END. Compaction is the only lever on HOW MANY memories load, and it is a
    #     REWRITE of the mind's own memory index that deliberately destroys text — so the legs that
    #     matter are the ones that say what it may never destroy: a pointer, a prose line, or a
    #     concurrent write. The win itself (bytes down, memories loading up) is asserted too,
    #     because a compactor that refuses everything would pass every safety leg.
    _saved8 = (PROJECTS, LOG, BOARD, NODES)
    _slug8 = os.environ.get("CLAUDE_PROJECT_SLUG")
    _lim8 = os.environ.get("MESH_MEMORY_INDEX_LIMIT")
    try:
        with tempfile.TemporaryDirectory() as td:
            td = Path(td)
            mem = td / "projects" / "-cmp" / "memory"
            mem.mkdir(parents=True)
            PROJECTS, LOG, BOARD = td / "projects", td / "r.tsv", td / "board.log"
            NODES = td / "absent"
            BOARD.write_text("")
            LOG.write_text("")
            rows = ["<!-- head -->"]
            for i in range(8):
                (mem / f"tailslug{i}.md").write_text("x")
                rows.append(f"- [Title Number {i}](tailslug{i}.md) — {'h'*90}")
            (mem / "MEMORY.md").write_text("\n".join(rows) + "\n")
            os.environ["CLAUDE_PROJECT_SLUG"] = "-cmp"
            os.environ["MESH_MEMORY_INDEX_LIMIT"] = "300"
            idx = mem / "MEMORY.md"
            before_txt = idx.read_text()
            st_before = idx.stat().st_mtime_ns
            b4 = _index_cut("-cmp")
            check("fixture reproduces the live shape: tail entries are cut by the limit",
                  b4["cut_slugs"] and b4["cut_slugs"] > 0)
            buf = io.StringIO()
            with contextlib.redirect_stdout(buf):
                crc = compact_index(check=True)
            check("--compact --check runs", crc == 0)
            check("--compact --check WRITES NOTHING (a dry run may not forge its own artifact)",
                  idx.read_text() == before_txt and idx.stat().st_mtime_ns == st_before)
            # THE COST IS PUBLISHED IN THE SAME BREATH AS THE WIN. Bytes-saved alone reads as free.
            check("--compact --check names the widening, not just the bytes saved",
                  "widest line" in buf.getvalue() and " B in " in buf.getvalue())
            with contextlib.redirect_stdout(io.StringIO()):
                crc = compact_index()
            aft = _index_cut("-cmp")
            check("--compact rewrites the index and MORE memories now load",
                  crc == 0 and idx.read_text() != before_txt
                  and aft["cut_slugs"] < b4["cut_slugs"])
            check("every pointer survives compaction",
                  set(re.findall(r"tailslug\d", idx.read_text()))
                  == {f"tailslug{i}" for i in range(8)})
            check("the pinned header stays first", idx.read_text().splitlines()[0] == "<!-- head -->")
            check("a second pass is a no-op (idempotent, so cron cannot churn the file)",
                  (lambda t: (compact_index() or True) and idx.read_text() == t)(idx.read_text()))
            # A LINE CAP IS WHAT MAKES IT CONVERGE, and it is also the separability budget: without
            # it every memory ends on one line and one cut takes the whole corpus.
            check("no compacted line exceeds the cap",
                  all(len(l.encode()) + 1 <= COMPACT_MAX_B + 1
                      for l in idx.read_text().splitlines() if l.startswith("- ")))
            # A POINTER THIS TOOL CANNOT RESOLVE IS THE ONLY TEXT NAMING A MISSING MEMORY.
            files = _corpus_files(td / "projects" / "-cmp")
            orphan = "- [Gone](deleted-memory-slug.md) — the file is gone"
            keep = _compact_body([orphan, "- [T](tailslug0.md) — h"], files)
            check("an unresolvable pointer is passed through, never compacted away",
                  orphan in keep)
            check("a prose line is a barrier, never absorbed into a slug cluster",
                  "some prose" in _compact_body(
                      ["- [T](tailslug0.md) — h", "some prose", "- [U](tailslug1.md) — h"], files))
            # THE GUARD ITSELF MUST BE ABLE TO FAIL. Break the compactor so it drops a pointer and
            # confirm the pass REFUSES rather than writing a lossy index (a gate never seen fail is
            # not a gate).
            _real = _compact_body

            def _lossy(body, f):
                # drop ONE slug off a dense line — a whole-line drop would be invisible here, since
                # by this point the fixture body is a single line and truncating it is a no-op.
                return [l.rsplit(", ", 1)[0] if l.startswith("- ") and ", " in l else l
                        for l in _real(body, f)]

            globals()["_compact_body"] = _lossy
            try:
                good = idx.read_text()
                err = io.StringIO()
                with contextlib.redirect_stdout(io.StringIO()), contextlib.redirect_stderr(err):
                    lrc = compact_index()
            finally:
                globals()["_compact_body"] = _real
            check("a lossy compaction is REFUSED and the index is left standing",
                  lrc == 1 and idx.read_text() == good and "refusing" in err.getvalue())
            # A MIND MAY WRITE MEMORY.md AT ANY MOMENT AND HOLDS NO LOCK (same race as --order).
            (mem / "racer.md").write_text("x")
            idx.write_text("<!-- head -->\n" + "\n".join(rows[1:]) + "\n")
            racer = {"n": 0}

            def _racing_compact(body, f):
                racer["n"] += 1
                with open(idx, "a") as fh:
                    fh.write("- [Raced](racer.md) — written by another mind mid-pass\n")
                return _real(body, f)

            globals()["_compact_body"] = _racing_compact
            try:
                with contextlib.redirect_stdout(io.StringIO()):
                    rrc = compact_index()
            finally:
                globals()["_compact_body"] = _real
            check("a concurrent write aborts the pass instead of clobbering it",
                  racer["n"] == 1 and rrc == 0
                  and idx.read_text().splitlines()[-1].startswith("- [Raced]"))
    finally:
        PROJECTS, LOG, BOARD, NODES = _saved8
        os.environ.pop("CLAUDE_PROJECT_SLUG", None)
        os.environ.pop("MESH_MEMORY_INDEX_LIMIT", None)
        if _slug8 is not None:
            os.environ["CLAUDE_PROJECT_SLUG"] = _slug8
        if _lim8 is not None:
            os.environ["MESH_MEMORY_INDEX_LIMIT"] = _lim8

    return rc


def main():
    global _ONELINE
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help"):
        print("usage: mesh-memory-recall --scan | --report [--oneline] | --influence | "
              "--order [--check] | --compact [--check] | --test")
        return 0
    if args[0] == "--scan":
        return scan()
    if args[0] == "--influence":
        scan(verbose=False)
        return influence()
    if args[0] == "--report":
        _ONELINE = "--oneline" in args
        rc = scan(verbose=False)
        if rc == 2:
            return 2
        return report()
    if args[0] == "--order":
        return order_index(check="--check" in args)
    if args[0] == "--compact":
        return compact_index(check="--check" in args)
    if args[0] == "--test":
        return _test()
    sys.stderr.write(f"mesh-memory-recall: unknown arg {args[0]}\n")
    return 1


if __name__ == "__main__":
    sys.exit(main())
