#!/usr/bin/env python3
# reflex-cadence: 23 5 * * *
# reflex-args: --scan
"""mesh-memory-recall — which retained memories are actually READ, and which are NOSTALGIA.

WHY (operator 2026-08-15, "memories that do not help predict the future are wasteful nostalgia"):
Still/Sivak/Bell/Crooks, "Thermodynamics of Prediction", PRL 109 120604 (2012) — a system that keeps
memory about its environment retains information about the PAST; only the fraction that predicts the
FUTURE is thermodynamically useful. The rest is "nostalgia", and is DISSIPATIVE (nonpredictive
retained information lower-bounds dissipated work). docs/reviews/info-theory-agency-nostalgia-memory-
depth-2026-07-28.md landed that as the memory-DEPTH axis in `mesh-precision --num` — for NUMERIC
sensor streams only. It was never pointed at the mind's own memory corpus. This is that meter.

WHAT IS ACTUALLY OBSERVABLE (measured on the live archive before this was written — do not soften it):
a memory recall appears in the session transcript as an assistant-initiated Read tool_use whose
file_path is under <project>/memory/, e.g.
    "name":"Read","input":{"file_path":".../memory/<slug>.md"},"caller":{"type":"direct"}
and whose tool_result carries the harness reminder "This memory is N days old.". ALL such reads in
the archive are caller=direct: this harness does NOT auto-inject individual memory files. Only
MEMORY.md (the index) is loaded every session.

THE LIMIT THIS METER CANNOT PASS, stated here because the number is useless without it: an OPENED
memory is a proven use, but a NEVER-OPENED memory is NOT a proven non-use. Every memory's one-line
index entry in MEMORY.md is auto-loaded into every session, and a mind can act on that line without
ever opening the file. So `reads == 0` is a LOWER BOUND on nostalgia — a candidate list for a human
or a mind to judge, never an eviction warrant. A tool that deleted on this signal would be deleting
on evidence it does not have. Report only; there is deliberately no --prune.

Sibling traps already paid for elsewhere in the genome and avoided here:
  - the scan MUST exclude its own session transcript, or it matches the strings it is grepping for
    (the self-matching-grep shape; hit live while building this).
  - a slug in the log whose file is gone is a DELETED memory, not a read of nothing — reported apart.
"""

import calendar
import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path

import signal
# SIGTERM MUST UNWIND, or every `finally` in this file is decorative. Python's DEFAULT SIGTERM
# disposition terminates the interpreter WITHOUT running finally blocks (and without
# TemporaryDirectory.__exit__), so a correct-looking cleanup never runs. The signal is not
# hypothetical: GNU `timeout` — which wraps this tool at its call sites and wraps EVERY `--test` in
# mesh-doctor's hourly sweep and in mesh-autowire — puts its child in its OWN process group and
# signals the GROUP, so this process gets the TERM. sys.exit() from the handler raises SystemExit in
# the main thread, which is what actually unwinds. SIGKILL stays uncatchable; that half is
# mesh-tmp-guard's sweep. Pattern and the measured mechanism: eb5b8e7, scripts/mesh-spend.
for _sig in (signal.SIGTERM, signal.SIGHUP):
    signal.signal(_sig, lambda _s, _f: sys.exit(128 + _s))

HOME = Path.home()
PROJECTS = HOME / ".claude" / "projects"
# NOT memory-recall.log: mesh-autowire redirects a reflex's STDOUT to ~/.mesh/<tool>.log, so a data
# file sharing the tool's basename gets usage text and scan chatter appended into it daily by the
# reflex it belongs to. Caught live — the first autowired line was
#   23 5 * * * mesh-memory-recall >> $HOME/.mesh/memory-recall.log
# which would have corrupted the ledger with its own console output. Data gets a .tsv, logs get .log.
LOG = HOME / ".mesh" / "memory-recall.tsv"
# The INDEX ledger. The nostalgia policy (settled 2026-08-16) names the auto-loaded MEMORY.md index
# — not disk — as the scarce resource, and then quoted its headroom as PROSE on the board: "17.2KB
# of 24.4KB, ~4 weeks". Twelve hours later it was 19.6KB (+2.4KB, corpus 402 -> 452), i.e. the rate
# behind "4 weeks" was wrong by ~20x and no tool would ever have said so — a constant outliving its
# reader, in the very policy that named the constraint. A constraint nothing measures is a slogan.
# So: sample (bytes, entries) into a ledger and DERIVE the rate; never re-state it in prose.
INDEX_LOG = HOME / ".mesh" / "memory-index.tsv"   # ts \t project \t bytes \t entries
# Heartbeat for the change-gated sampler below: without it a corpus that stops growing keeps its
# last CHANGE as the newest sample, and the derived rate freezes at the last burst forever.
INDEX_HEARTBEAT_S = 6 * 3600
# A rate needs a span. Two samples minutes apart divide a rounding error by ~0 and print a number
# with three digits of false precision; below this the block says n/a and says why.
INDEX_MIN_SPAN_S = 3600
BOARD = HOME / ".mesh" / "chat.log"
STATE = HOME / ".mesh" / ".memory-recall.state"
_ONELINE = False

# a memory Read tool_use, as it appears verbatim in a transcript jsonl line
READ_RE = re.compile(
    r'"id":"(?P<tid>toolu_[A-Za-z0-9]+)","name":"Read","input":\{"file_path":"'
    r'(?P<path>[^"]*/memory/(?P<slug>[A-Za-z0-9._-]+)\.md)"\}'
)


def _memory_dirs():
    """project dirs that actually carry a memory/ corpus."""
    if not PROJECTS.is_dir():
        return []
    return [p for p in sorted(PROJECTS.iterdir()) if (p / "memory").is_dir()]


def _self_session():
    """this process's own transcript stem, so the scan never reads its own output.

    A scan that includes the running session matches the very patterns it is searching for the
    moment they are printed — the self-matching-grep shape. Best-effort: the env var is set by the
    harness; absent it we fall back to the newest transcript, which is overwhelmingly this one.
    """
    sid = os.environ.get("CLAUDE_SESSION_ID", "").strip()
    return sid or None


def _chosen_project(dirs):
    """the project dir this working tree belongs to, else the largest corpus.

    dirs[0] is NOT it: taking the first alphabetically joined this node's recall log against another
    project's memory dir and reported a 12-memory corpus with 126 "deleted" on a node holding 400.
    The --test real-path leg had the same bug in kind — it asserted against a foreign archive.
    """
    project = os.environ.get("CLAUDE_PROJECT_SLUG") or \
        "-" + str(Path.cwd().resolve()).strip("/").replace("/", "-")
    for d in dirs:
        if d.name == project:
            return d, True
    return max(dirs, key=lambda d: len(list((d / "memory").glob("*.md")))), False


def _load_state():
    try:
        return json.loads(STATE.read_text())
    except Exception:
        return {}


def _save_state(st):
    try:
        STATE.parent.mkdir(parents=True, exist_ok=True)
        tmp = str(STATE) + ".tmp"
        with open(tmp, "w") as f:
            json.dump(st, f)
        os.replace(tmp, STATE)
    except Exception:
        pass


def _seen_tids():
    """tool_use ids already logged — the dedup key, so a re-scan cannot double-count."""
    seen = set()
    try:
        with open(LOG) as f:
            for line in f:
                parts = line.rstrip("\n").split("\t")
                if len(parts) >= 4:
                    seen.add(parts[3])
    except FileNotFoundError:
        pass
    return seen


def _index_measure(pdir):
    """(bytes, entries) of a project's auto-loaded index, or None if it has no MEMORY.md."""
    idx = pdir / "memory" / "MEMORY.md"
    try:
        b = idx.stat().st_size
    except OSError:
        return None
    n = sum(1 for p in (pdir / "memory").glob("*.md") if p.name != "MEMORY.md")
    return (b, n)


def _index_rows(project=None):
    rows = []
    try:
        with open(INDEX_LOG) as f:
            for line in f:
                p = line.rstrip("\n").split("\t")
                if len(p) < 4:
                    continue
                if project is not None and p[1] != project:
                    continue
                try:
                    rows.append((p[0], p[1], int(p[2]), int(p[3])))
                except ValueError:
                    continue
    except FileNotFoundError:
        pass
    rows.sort()
    return rows


def _index_record(pdir):
    """Append a sample when it CHANGED, or when the last one aged past the heartbeat."""
    m = _index_measure(pdir)
    if m is None:
        return None
    prev = _index_rows(pdir.name)
    if prev:
        pts, _, pb, pn = prev[-1]
        aged = (time.time() - _iso_epoch(pts)) >= INDEX_HEARTBEAT_S
        if (pb, pn) == m and not aged:
            return m
    INDEX_LOG.parent.mkdir(parents=True, exist_ok=True)
    with open(INDEX_LOG, "a") as f:
        f.write("%s\t%s\t%d\t%d\n" % (time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
                                      pdir.name, m[0], m[1]))
    return m


def _iso_epoch(ts):
    try:
        # timegm, not mktime: the stamps are UTC and mktime reads them as LOCAL, which on any
        # node running non-UTC shifts every span by the offset and quietly rescales the rate.
        return float(calendar.timegm(time.strptime(ts[:19], "%Y-%m-%dT%H:%M:%S")))
    except (ValueError, OverflowError):
        return 0.0


def _index_block(project):
    """Render the index-pressure block. Every number here is MEASURED or says n/a — the limit has
    no source in this tool, so headroom is printed only when the operator supplies one."""
    rows = _index_rows(project)
    out = []
    if not rows:
        out.append("  index          n/a — no sample yet (run --scan)")
        return out
    ts_n, _, b_n, n_n = rows[-1]
    out.append(f"  index          {b_n} B over {n_n} entries ({b_n/max(1,n_n):.0f} B/entry)"
               f"  [sampled {ts_n[:16]}Z]")
    ts_0, _, b_0, n_0 = rows[0]
    span = _iso_epoch(ts_n) - _iso_epoch(ts_0)
    if len(rows) < 2 or span < INDEX_MIN_SPAN_S:
        out.append(f"  index growth   n/a — {len(rows)} sample(s) spanning {span/3600:.1f}h "
                   f"(need >=2 over {INDEX_MIN_SPAN_S/3600:.0f}h); a shorter span prints noise")
        return out
    per_day = (b_n - b_0) * 86400.0 / span
    out.append(f"  index growth   {per_day:+.0f} B/day  ({(n_n-n_0)*86400.0/span:+.1f} entries/day)"
               f"  over {span/3600:.1f}h, {len(rows)} samples")
    lim = os.environ.get("MESH_MEMORY_INDEX_LIMIT", "").strip()
    if not lim:
        out.append("  index headroom n/a — MESH_MEMORY_INDEX_LIMIT unset. The read limit is not "
                   "measurable from here and this tool will not quote one from memory.")
        return out
    try:
        limit = int(lim)
    except ValueError:
        out.append(f"  index headroom n/a — MESH_MEMORY_INDEX_LIMIT={lim!r} is not an integer byte count")
        return out
    left = limit - b_n
    eta = (f"{left/per_day:.1f} d" if per_day > 0 else "no growth measured")
    out.append(f"  index headroom {left} B of {limit} B  ->  {eta} at the measured rate")
    return out


def scan(verbose=True):
    """incrementally scan transcripts; append one row per newly-seen memory Read."""
    dirs = _memory_dirs()
    if not dirs:
        sys.stderr.write("mesh-memory-recall: no project dir carries a memory/ corpus — n/a\n")
        return 2

    self_sid = _self_session()
    state = _load_state()
    seen = _seen_tids()
    rows = []
    scanned = grew = 0

    for pdir in dirs:
        for tf in sorted(pdir.glob("*.jsonl")):
            stem = tf.stem
            if self_sid and stem == self_sid:
                continue  # never scan our own transcript
            try:
                size = tf.stat().st_size
            except OSError:
                continue
            key = str(tf)
            off = state.get(key, 0)
            scanned += 1
            if off >= size:
                continue
            grew += 1
            try:
                with open(tf, "r", errors="replace") as f:
                    f.seek(off)
                    chunk = f.read()
            except OSError:
                continue
            state[key] = size
            for m in READ_RE.finditer(chunk):
                tid = m.group("tid")
                if tid in seen:
                    continue
                seen.add(tid)
                # timestamp: search the WHOLE jsonl line the match sits on. Looking only BACKWARDS
                # loses it — the harness emits "timestamp" after the content block, so a backward
                # scan renders "-" and the report's window collapses to a bare end date.
                ls = chunk.rfind("\n", 0, m.start()) + 1
                le = chunk.find("\n", m.end())
                line = chunk[ls:le if le != -1 else len(chunk)]
                ts = ""
                t = line.find('"timestamp":"')
                if t != -1:
                    ts = line[t + 13:t + 37].split('"')[0]
                rows.append((ts or "-", m.group("slug"), stem, tid, pdir.name))

    if rows:
        rows.sort()
        LOG.parent.mkdir(parents=True, exist_ok=True)
        with open(LOG, "a") as f:
            for r in rows:
                f.write("\t".join(r) + "\n")
    _save_state(state)
    # Sample the index alongside the recall scan: the two answer different halves of the same
    # policy question (what is READ vs what the index COSTS), and the cadence is already right.
    for pdir in dirs:
        _index_record(pdir)
    if verbose:
        print(f"scanned {scanned} transcript(s), {grew} new/grown, +{len(rows)} recall row(s)")
    return 0


def report(project=None):
    dirs = _memory_dirs()
    if not dirs:
        sys.stderr.write("mesh-memory-recall: no memory corpus — n/a\n")
        return 2
    # Pick the corpus by PROJECT, never dirs[0]. Taking the first dir alphabetically reported a
    # 12-memory corpus with "126 deleted" on a node whose real corpus is 395 — it was joining this
    # node's recall log against a DIFFERENT project's memory dir and reading every unmatched slug as
    # a deletion. Default to the project this working tree belongs to.
    if project is None:
        chosen, exact = _chosen_project(dirs)
        if not exact:
            sys.stderr.write(f"mesh-memory-recall: no corpus for this cwd; falling back to the "
                             f"largest ({chosen.name})\n")
    else:
        chosen = next((d for d in dirs if d.name == project), None)
        if chosen is None:
            sys.stderr.write(f"mesh-memory-recall: no corpus for project {project}\n")
            return 2
    mem = chosen / "memory"
    files = {p.stem: p for p in mem.glob("*.md") if p.name != "MEMORY.md"}

    counts, last = {}, {}
    rows_total = 0
    try:
        with open(LOG) as f:
            for line in f:
                parts = line.rstrip("\n").split("\t")
                if len(parts) < 4:
                    continue
                rows_total += 1
                # rows written before the project field existed carry no scope — count them only
                # when the slug resolves in this corpus, never as a foreign-project deletion.
                proj = parts[4] if len(parts) >= 5 else None
                if proj is not None and proj != chosen.name:
                    continue
                ts, slug = parts[0], parts[1]
                if proj is None and slug not in files:
                    continue
                counts[slug] = counts.get(slug, 0) + 1
                if ts > last.get(slug, ""):
                    last[slug] = ts
    except FileNotFoundError:
        sys.stderr.write("mesh-memory-recall: no recall log yet — run --scan first (n/a)\n")
        return 2

    if not counts:
        sys.stderr.write("mesh-memory-recall: recall log is empty — n/a\n")
        return 2

    live = set(files)
    read_live = {s: c for s, c in counts.items() if s in live}
    never = sorted(live - set(read_live))
    orphan = sorted(set(counts) - live)
    total_reads = sum(counts.values())
    span = (min(last.values()), max(last.values())) if last else ("-", "-")

    if _ONELINE:
        # NAME THE SUBJECT IN EVERY RENDERING. The corpus is resolved from CLAUDE_PROJECT_SLUG or,
        # absent it, the CALLER'S CWD (_chosen_project) — so this meter's answer is a function of
        # where it was invoked from, and the compact rendering used to omit that. Measured
        # 2026-08-17: the witness DATA pane (cwd $HOME -> the 12-file -home-mesh-home corpus) read
        # "12 memories · 5 opened (42%)" while the MIND pane of the same window, same second
        # (cwd the genome repo -> 607 files) read "22%". Both honest, 50x apart, and nothing in the
        # line said which corpus it counted — the error flattered us, and the only axis that might
        # have tipped anyone off (a reads window ending 7 days back) read as staleness instead.
        # The full --report always printed `project <name>`; the one-liner now does too.
        pct = 100.0 * len(read_live) / max(1, len(live))
        print(f"  corpus {chosen.name} · {len(live)} memories")
        print(f"  {len(read_live)} opened ({pct:.0f}%) · {len(never)} never "
              f"(nostalgia lower bound) · {total_reads} reads {span[0][:10]}..{span[1][:10]}")
        return 0

    print("== mesh-memory-recall — retained vs. actually-read (nostalgia meter) ==")
    print(f"  project        {chosen.name}   ({rows_total} rows in log, all projects)")
    print(f"  corpus         {len(live)} memories")
    print(f"  ever opened    {len(read_live)} ({100.0*len(read_live)/max(1,len(live)):.1f}%)")
    print(f"  never opened   {len(never)}  <- NOSTALGIA CANDIDATES (lower bound, see below)")
    print(f"  total reads    {total_reads}   window {span[0][:10]} .. {span[1][:10]}")
    for line in _index_block(chosen.name):
        print(line)
    if orphan:
        print(f"  deleted        {len(orphan)} slug(s) read in the past, file now gone")
    print()
    print("-- most-read (predictive: these earned their keep) --")
    for slug, c in sorted(read_live.items(), key=lambda kv: (-kv[1], kv[0]))[:12]:
        print(f"  {c:3d}  {last.get(slug,'-')[:10]}  {slug}")
    print()
    print(f"-- never opened ({len(never)}) --")
    for slug in never[:40]:
        print(f"       {slug}")
    if len(never) > 40:
        print(f"       … and {len(never)-40} more")
    print()
    print("CAVEAT (binding): reads==0 is a LOWER BOUND on nostalgia, not proof of non-use. Every")
    print("memory's index line in MEMORY.md is auto-loaded each session, so a mind can act on the")
    print("one-liner without opening the file. This is a candidate list for judgement, never an")
    print("eviction warrant — which is why there is no --prune.")
    return 0


def influence():
    """READS are not the whole of use — split index-mediated use from real nostalgia.

    THE OBJECTION THAT MAKES --report UNACTIONABLE ON ITS OWN, and why this exists: pruning on
    reads==0 would delete exactly the memories that might be working THROUGH their index line, since
    MEMORY.md is auto-loaded every session and a mind can act on the one-liner without ever opening
    the file. So "never opened" cannot separate a dead memory from a silently load-bearing one.

    The discriminator: a memory whose slug is USED in the mesh's own output (board posts, commit
    messages) while its file was never read is proof that the INDEX LINE carried it — the cheapest
    possible evidence, already lying in the logs. Four cells:

      read + mentioned   ACTIVE          openly in use
      mentioned, unread  INDEX-MEDIATED  the one-liner is load-bearing — do NOT drop the index line
      read, unmentioned  PRIVATE         consulted, informed work that did not name it
      neither            COLD            the only prune candidate, and still only a candidate

    Scanned sources deliberately EXCLUDE the memory dir itself: a memory's own file and its
    [[wiki-links]] to siblings are cross-references, not use, and counting them would let the corpus
    justify itself (every memory cites others, so all 400 would read as "in use").
    """
    dirs = _memory_dirs()
    if not dirs:
        sys.stderr.write("mesh-memory-recall: no memory corpus — n/a\n")
        return 2
    chosen, _ = _chosen_project(dirs)
    files = {p.stem for p in (chosen / "memory").glob("*.md") if p.name != "MEMORY.md"}
    if not files:
        sys.stderr.write("mesh-memory-recall: empty corpus — n/a\n")
        return 2

    read = set()
    try:
        with open(LOG) as f:
            for line in f:
                parts = line.rstrip("\n").split("\t")
                if len(parts) >= 2 and parts[1] in files:
                    read.add(parts[1])
    except FileNotFoundError:
        sys.stderr.write("mesh-memory-recall: no recall log — run --scan first (n/a)\n")
        return 2

    corpus = []
    if BOARD.exists():
        corpus.append(BOARD.read_text(errors="replace"))
    try:
        corpus.append(subprocess.run(["git", "log", "--format=%B", "-n", "4000"],
                                     capture_output=True, text=True, timeout=60).stdout)
    except Exception:
        pass
    if not corpus:
        sys.stderr.write("mesh-memory-recall: no board and no git log to scan — n/a\n")
        return 2
    blob = "\n".join(corpus)

    mentioned = {s for s in files if s in blob}
    active = read & mentioned
    index_mediated = mentioned - read
    private = read - mentioned
    cold = files - read - mentioned

    print("== mesh-memory-recall --influence — is the INDEX LINE doing the work? ==")
    print(f"  corpus            {len(files)}")
    print(f"  ACTIVE            {len(active)}   read AND named in board/commits")
    print(f"  INDEX-MEDIATED    {len(index_mediated)}   named but NEVER opened — the one-liner carried it")
    print(f"  PRIVATE           {len(private)}   opened but never named")
    print(f"  COLD              {len(cold)}   neither — the only prune candidates")
    print()
    if index_mediated:
        print("-- INDEX-MEDIATED (proof the auto-loaded index line is load-bearing) --")
        for s in sorted(index_mediated)[:15]:
            print(f"       {s}")
        if len(index_mediated) > 15:
            print(f"       … and {len(index_mediated)-15} more")
        print()
    print(f"VERDICT: {len(index_mediated)} memories demonstrably used WITHOUT ever being opened.")
    print("Any prune keyed on reads alone would have dropped those. COLD is a candidate list for")
    print("judgement, not an eviction warrant — a memory can still be load-bearing and unnamed.")
    return 0


def _test():
    """gates. Real path asserted, not just fixtures: the regex must pull a slug out of a REAL
    transcript line from the live archive, or this whole meter is measuring nothing."""
    rc = 0

    def check(name, cond):
        nonlocal rc
        print(f"  {'ok  ' if cond else 'FAIL'} {name}")
        if not cond:
            rc = 1

    print("mesh-memory-recall --test")

    # 1) REAL PATH: the regex parses an actual archive line.
    #
    # The n/a hatch here is the dangerous part and is deliberately NOT reachable by a broken regex:
    # a COARSE, independent probe (two plain literals, no shared pattern with READ_RE) first decides
    # whether this node HAS memory-read lines at all. No candidates -> honest n/a. Candidates present
    # but READ_RE matches none -> RED. Without this split, breaking the regex renders "n/a: nothing
    # to assert against" and the meter reports absence as inapplicability — measured: two mutants
    # (name broken, path segment broken) both exited 2 instead of 1 before this was added.
    dirs = _memory_dirs()
    if not dirs:
        print("  n/a  no memory corpus on this node")
        return 2
    self_sid = _self_session()

    probe_dir, _exact = _chosen_project(dirs)

    def _rg(pattern, maxcount="40"):
        try:
            return subprocess.run(["rg", "-m", maxcount, "--no-messages", "-o", pattern,
                                   str(probe_dir)], capture_output=True, text=True,
                                  timeout=90).stdout
        except Exception:
            return None

    # The coarse probe must share NO literal with READ_RE, or one edit breaks both and the gate
    # renders "n/a: nothing to assert" instead of RED — measured: a mutant flipping "name":"Read"
    # broke the probe too, because the probe quoted the same string ("two methods agreeing is not
    # corroboration" — they were one method). So: anchor the probe on the FILE PATH alone, and test
    # for the Read verb with a plain substring check on the DATA, which no edit to READ_RE touches.
    # The leading .{0,80} is load-bearing: rg -o returns only the matched substring, so without it
    # the tool_use id is cut off and every candidate fails to parse (gate RED for the wrong reason).
    coarse = _rg(r'.{0,80}"file_path":"[^"]*/memory/[^"]*\.md"\}')
    if coarse is None:
        print("  n/a  archive unreadable (rg missing or failed)")
        return 2
    seen_lines = [ln for ln in coarse.splitlines() if not (self_sid and self_sid in ln)]
    candidates = [ln for ln in seen_lines if "Read" in ln]
    if not candidates:
        print("  n/a  this node's archive contains no memory Read at all — nothing to assert")
        return 2

    hit = None
    for line in candidates:
        payload = line.split(":", 1)[-1] if line.startswith("/") else line
        m = READ_RE.search(payload)
        if m:
            hit = m
            break
    check(f"READ_RE matches a REAL archive line ({len(candidates)} candidate(s) present)",
          hit is not None)
    if hit is None:
        # the coarse probe proved the lines exist; a strict-regex miss is a BREAK, not an n/a.
        print("  (coarse probe found memory Reads that READ_RE could not parse — parser is broken)")
        return 1
    check("real slug is non-empty", bool(hit.group("slug")))
    check("real slug is a bare stem, not a path", "/" not in hit.group("slug"))
    check("real tool_use id captured", hit.group("tid").startswith("toolu_"))

    # 2) the exact line shape, held as a fixture so a harness format change goes RED here
    fixture = ('{"timestamp":"2026-08-15T10:00:00.000Z","message":{"content":[{"type":"tool_use",'
               '"id":"toolu_01ABCdef","name":"Read","input":{"file_path":"/home/u/.claude/projects/'
               '-p/memory/some-slug-here.md"},"caller":{"type":"direct"}}]}}')
    m = READ_RE.search(fixture)
    check("fixture parses", m is not None)
    check("fixture slug correct", m and m.group("slug") == "some-slug-here")

    # 3) NEGATIVES — the regex must not claim a read it did not see
    check("a Write to memory/ is NOT a read",
          READ_RE.search(fixture.replace('"name":"Read"', '"name":"Write"')) is None)
    check("a Read of a non-memory path is NOT counted",
          READ_RE.search(fixture.replace("/memory/", "/docs/")) is None)
    _mem_md = READ_RE.search(fixture.replace("some-slug-here.md", "MEMORY.md"))
    check("MEMORY.md index load is distinguishable from a per-memory recall",
          _mem_md is not None and _mem_md.group("slug") == "MEMORY")
    # a slug must be a bare stem: a nested path under memory/ must not smuggle a "/" into it
    _nested = READ_RE.search(fixture.replace("/memory/some-slug-here.md",
                                             "/memory/sub/dir/some-slug-here.md"))
    check("a nested path yields a bare stem or no match",
          _nested is None or "/" not in _nested.group("slug"))

    # 3b) PROJECT SELECTION. The fallback branch is unreachable on a node whose cwd matches its
    #     project, so a mutant swapping it back to dirs[0] survives every other leg — drive it with
    #     a synthetic corpus where the alphabetically-first dir is the SMALLEST. This is the exact
    #     bug that reported "12 memories, 126 deleted" on a 400-memory node.
    import tempfile as _tf
    with _tf.TemporaryDirectory() as _td:
        _td = Path(_td)
        for nm, n in (("-aaa-small", 1), ("-zzz-big", 5)):
            (_td / nm / "memory").mkdir(parents=True)
            for i in range(n):
                (_td / nm / "memory" / f"m{i}.md").write_text("x")
        _dirs = sorted(_td.iterdir())
        _pick, _exact = _chosen_project(_dirs)
        check("project fallback picks the LARGEST corpus, not dirs[0]", _pick.name == "-zzz-big")
        check("fallback reports itself as inexact", _exact is False)
        # ...and the caller's cwd MUST be able to change the answer only when it is not pinned.
        _saved_slug = os.environ.get("CLAUDE_PROJECT_SLUG")
        try:
            os.environ["CLAUDE_PROJECT_SLUG"] = "-aaa-small"
            _p2, _e2 = _chosen_project(_dirs)
            check("an explicit CLAUDE_PROJECT_SLUG beats the largest-corpus fallback",
                  _p2.name == "-aaa-small" and _e2 is True)
        finally:
            os.environ.pop("CLAUDE_PROJECT_SLUG", None)
            if _saved_slug is not None:
                os.environ["CLAUDE_PROJECT_SLUG"] = _saved_slug

    # 4) DEDUP, driven through the REAL scan() — not a set literal.
    #    The earlier version asserted `tid in {tid}`, which is true no matter what the code does;
    #    disabling the dedup branch left it green. This drives two full scans over a fixture
    #    transcript and asserts the log does not grow on the second.
    import tempfile
    global PROJECTS, LOG, STATE
    _saved = (PROJECTS, LOG, STATE)
    try:
        with tempfile.TemporaryDirectory() as td:
            td = Path(td)
            proj = td / "projects" / "-fixture"
            (proj / "memory").mkdir(parents=True)
            (proj / "memory" / "some-slug-here.md").write_text("---\nname: some-slug-here\n---\nx\n")
            (proj / "fixture-session.jsonl").write_text(fixture + "\n")
            PROJECTS, LOG, STATE = td / "projects", td / "recall.log", td / "recall.state"
            scan(verbose=False)
            n1 = len(LOG.read_text().splitlines()) if LOG.exists() else 0
            STATE.unlink(missing_ok=True)      # force a full re-scan: only dedup can save us
            scan(verbose=False)
            n2 = len(LOG.read_text().splitlines()) if LOG.exists() else 0
            check("scan() logs the fixture recall", n1 == 1)
            check("re-scan does NOT double-count (dedup on tool_use id)", n2 == n1)

            # ...and dedup must hold WITHIN one scan too. The cross-scan leg above is carried by
            # _seen_tids() re-reading the log, so it stays green even if the in-loop seen.add() is
            # deleted; only a repeated id inside a single chunk exercises that line.
            (proj / "dup-session.jsonl").write_text(fixture + "\n" + fixture + "\n")
            LOG.unlink(missing_ok=True)
            STATE.unlink(missing_ok=True)
            scan(verbose=False)
            n3 = len(LOG.read_text().splitlines()) if LOG.exists() else 0
            check("a repeated tool_use id within ONE scan logs once", n3 == 1)
    finally:
        PROJECTS, LOG, STATE = _saved

    # 6) --influence: the four cells must PARTITION the corpus, and a slug named on the board but
    #    never read must land in INDEX-MEDIATED (the cell the whole decision rests on). Driven
    #    through the real influence() against a fixture corpus + a fixture board.
    global BOARD
    _saved2 = (PROJECTS, LOG, STATE, BOARD)
    try:
        with tempfile.TemporaryDirectory() as td:
            td = Path(td)
            proj = td / "projects" / "-fixture"
            (proj / "memory").mkdir(parents=True)
            for s in ("slug-read-and-named", "slug-named-only", "slug-read-only", "slug-cold"):
                (proj / "memory" / f"{s}.md").write_text(
                    # every fixture memory cross-links a SIBLING: if influence() ever scanned the
                    # memory dir, these links alone would mark all four as "mentioned" and the COLD
                    # cell would collapse to zero — the corpus justifying its own existence.
                    f"---\nname: {s}\n---\nsee [[slug-cold]] and [[slug-named-only]]\n")
            PROJECTS, LOG, STATE = td / "projects", td / "recall.log", td / "recall.state"
            BOARD = td / "chat.log"
            BOARD.write_text("[fyi] cites slug-read-and-named and slug-named-only\n")
            LOG.write_text("2026-01-01T00:00:00\tslug-read-and-named\ts\tt1\t-fixture\n"
                           "2026-01-01T00:00:00\tslug-read-only\ts\tt2\t-fixture\n")
            import io
            import contextlib
            buf = io.StringIO()
            with contextlib.redirect_stdout(buf):
                irc = influence()
            out = buf.getvalue()

            def cell(nm):
                m = re.search(rf"^  {nm} +(\d+)", out, re.M)
                return int(m.group(1)) if m else -1

            check("--influence runs on a fixture corpus", irc == 0)
            check("ACTIVE = read AND named", cell("ACTIVE") == 1)
            check("INDEX-MEDIATED = named, never opened", cell("INDEX-MEDIATED") == 1)
            check("PRIVATE = opened, never named", cell("PRIVATE") == 1)
            check("COLD survives sibling [[wiki-links]] (memory dir NOT scanned)", cell("COLD") == 1)
            check("the four cells partition the corpus",
                  cell("ACTIVE") + cell("INDEX-MEDIATED") + cell("PRIVATE") + cell("COLD")
                  == cell("corpus") == 4)
    finally:
        PROJECTS, LOG, STATE, BOARD = _saved2

    # 3c) --oneline MUST NAME THE CORPUS IT COUNTED. This meter's subject varies by caller (slug or
    #     cwd), so a rendering that omits it is unfalsifiable: the witness pane read "12 memories ·
    #     5 opened (42%)" off a near-miss corpus for weeks and nothing in the line disagreed with
    #     the mind pane's "607 · 22%". Driven through the real report() against a fixture corpus.
    global _ONELINE
    import tempfile
    _saved4 = (PROJECTS, LOG, STATE, _ONELINE)
    _saved_slug = os.environ.get("CLAUDE_PROJECT_SLUG")
    try:
        import io
        import contextlib
        with tempfile.TemporaryDirectory() as td:
            td = Path(td)
            for nm, n in (("-decoy-tiny", 1), ("-real-corpus", 4)):
                (td / "projects" / nm / "memory").mkdir(parents=True)
                for i in range(n):
                    (td / "projects" / nm / "memory" / f"m{i}.md").write_text("x")
            PROJECTS, LOG, STATE = td / "projects", td / "recall.tsv", td / "recall.state"
            LOG.write_text("2026-01-01T00:00:00\tm0\ts\tt1\t-real-corpus\n"
                           "2026-01-01T00:00:00\tm0\ts\tt2\t-decoy-tiny\n")
            _ONELINE = True
            for want, other in (("-decoy-tiny", "-real-corpus"), ("-real-corpus", "-decoy-tiny")):
                os.environ["CLAUDE_PROJECT_SLUG"] = want
                buf = io.StringIO()
                with contextlib.redirect_stdout(buf):
                    report()
                out = buf.getvalue()
                check(f"--oneline names the corpus it counted ({want})",
                      want in out and other not in out)
    finally:
        PROJECTS, LOG, STATE, _ONELINE = _saved4
        os.environ.pop("CLAUDE_PROJECT_SLUG", None)
        if _saved_slug is not None:
            os.environ["CLAUDE_PROJECT_SLUG"] = _saved_slug

    # 4) INDEX PRESSURE — the policy's scarce resource. Each leg drives _index_block against a
    # hand-written ledger, because the failure this guards is a NUMBER that reads plausibly:
    # a rate off by 20x, or a headroom quoted from a limit nobody measured.
    global INDEX_LOG
    _saved3 = INDEX_LOG
    _saved_lim = os.environ.get("MESH_MEMORY_INDEX_LIMIT")
    try:
        with tempfile.TemporaryDirectory() as td:
            INDEX_LOG = Path(td) / "idx.tsv"
            os.environ.pop("MESH_MEMORY_INDEX_LIMIT", None)

            def block(rows):
                INDEX_LOG.write_text("".join("\t".join(map(str, r)) + "\n" for r in rows))
                return "\n".join(_index_block("proj"))

            # one sample cannot be a rate, and a sub-span pair cannot either
            one = block([("2026-08-16T00:00:00Z", "proj", 10000, 400)])
            check("a single sample renders growth n/a, never 0", "index growth   n/a" in one)
            near = block([("2026-08-16T00:00:00Z", "proj", 10000, 400),
                          ("2026-08-16T00:20:00Z", "proj", 10400, 404)])
            check("a 20-min span is refused (0.33h < 1h), not extrapolated to +28800 B/day",
                  "index growth   n/a" in near)

            # the real shape: +2400 B over 12h is +4800 B/day, ~20x the ~250 B/day that "17.2K of
            # 24.4K, ~4 weeks" implied. The gate is that arithmetic, not the prose.
            wide = block([("2026-08-15T14:00:00Z", "proj", 17200, 402),
                          ("2026-08-16T02:00:00Z", "proj", 19600, 452)])
            check("rate is derived from the span (+2400 B / 12h -> +4800 B/day)",
                  "+4800 B/day" in wide)
            check("entry rate rides the same span (+50 / 12h -> +100/day)", "+100.0 entries" in wide)
            check("no headroom is claimed while MESH_MEMORY_INDEX_LIMIT is unset",
                  "headroom n/a" in wide and "MESH_MEMORY_INDEX_LIMIT unset" in wide)

            os.environ["MESH_MEMORY_INDEX_LIMIT"] = "25000"
            withlim = block([("2026-08-15T14:00:00Z", "proj", 17200, 402),
                             ("2026-08-16T02:00:00Z", "proj", 19600, 452)])
            # 5400 B left at 4800 B/day = 1.1 d. The prose said ~4 weeks from the same two numbers.
            check("headroom + ETA appear once a limit is supplied",
                  "5400 B of 25000 B" in withlim and "1.1 d" in withlim)

            # A UTC stamp must not be read as LOCAL. The obvious fixture — an ordinary span under
            # TZ=America/New_York — is VACUOUS: mktime applies the same offset to both endpoints
            # and the subtraction cancels it, so timegm and mktime agree and the leg passes for
            # either implementation (measured: the mktime mutant stayed green against it). The one
            # span where local parsing actually diverges is one containing a DST transition, where
            # the offset is not the same at both ends. 2026-11-01, New York, falls back at 02:00
            # local: read as local, 00:00Z..12:00Z is 13 real hours, not 12, and the rate drops
            # 4800 -> 4430 B/day. That difference is the assertion.
            os.environ["TZ"] = "America/New_York"
            time.tzset()
            tzrow = block([("2026-11-01T00:00:00Z", "proj", 17200, 402),
                           ("2026-11-01T12:00:00Z", "proj", 19600, 452)])
            check("a DST-crossing span is parsed as UTC (12h, not 13h -> +4800 B/day)",
                  "+4800 B/day" in tzrow and "over 12.0h" in tzrow)

            # the sampler is change-gated: an unchanged index must not append a row
            os.environ.pop("TZ", None)
            time.tzset()
            with tempfile.TemporaryDirectory() as pd:
                proj = Path(pd) / "-fixture"
                (proj / "memory").mkdir(parents=True)
                (proj / "memory" / "MEMORY.md").write_text("- [a](a.md)\n")
                (proj / "memory" / "a.md").write_text("x")
                INDEX_LOG.write_text("")
                _index_record(proj)
                first = len(_index_rows("-fixture"))
                _index_record(proj)
                check("an unchanged index appends no second row (change-gated)",
                      first == 1 and len(_index_rows("-fixture")) == 1)
                (proj / "memory" / "b.md").write_text("y")
                _index_record(proj)
                check("a changed index does append", len(_index_rows("-fixture")) == 2)
    finally:
        INDEX_LOG = _saved3
        os.environ.pop("MESH_MEMORY_INDEX_LIMIT", None)
        if _saved_lim is not None:
            os.environ["MESH_MEMORY_INDEX_LIMIT"] = _saved_lim

    return rc


def main():
    global _ONELINE
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help"):
        print("usage: mesh-memory-recall --scan | --report [--oneline] | --influence | --test")
        return 0
    if args[0] == "--scan":
        return scan()
    if args[0] == "--influence":
        scan(verbose=False)
        return influence()
    if args[0] == "--report":
        _ONELINE = "--oneline" in args
        rc = scan(verbose=False)
        if rc == 2:
            return 2
        return report()
    if args[0] == "--test":
        return _test()
    sys.stderr.write(f"mesh-memory-recall: unknown arg {args[0]}\n")
    return 1


if __name__ == "__main__":
    sys.exit(main())
