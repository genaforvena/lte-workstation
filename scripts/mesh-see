#!/usr/bin/env bash
# mesh-see — turn the camera from a CAPTURE tool into a PERCEPTUAL organ: grab one still
# (mesh-camera) and have a vision-capable mind DESCRIBE it in one neutral sentence. The mesh
# can now answer "what do you see?" — not just "here's a JPEG".
#
# Why a separate tool: mesh-camera produces the artifact (a real JPEG); mesh-see turns that
# artifact into PERCEPTION (text a mind can act on, log to the board, or speak via mesh-say).
# Perceive-don't-store doctrine: the description is text; the frame is overwritten each call.
#
# Backends, cheapest and most private first (same ladder as mesh-object-id / mesh-face-recognize):
#   1. LOCAL ollama qwen3-vl (free, on this node's GPU; a home frame NEVER leaves the house) — DEFAULT
#   2. claude -p + Read       (paid quota path; the original vision path)
# MESH_SEE_MODEL selects: a bare ollama tag (no "/") → local GPU; "claude" → the paid path.
#
# WHY THE LOCAL BACKEND EXISTS (2026-09-21): claude's OAuth session expired and every
# `claude -p` now answers "Failed to authenticate: OAuth session expired and could not be
# refreshed" (measured, not assumed). mesh-see's ONLY vision path was that expired session, so
# the mesh's image-understanding sense went BLIND while `--test` still printed ok — the gate only
# checked that a `claude` binary existed, never that it could actually see. A local qwen3-vl:4b
# was already resident on this node's GPU (`ollama ps`: 4.2 GB, 100% GPU, 8192 ctx) and answers
# the same prompt in ~10s, so the sense was blind for want of a dispatch line. See
# ~/.mesh/knowledge/capability-mesh-see-local-vision-backfill-mesh-home-20260921.md.
#
#   mesh-see                 capture + describe → one neutral sentence on stdout
#   mesh-see --say           also speak the description aloud (mesh-say)
#   mesh-see --chat          also post it to the board (mesh-chat, [see] tag)
#   mesh-see --test          smoke test (camera capture path + a vision mind)
#
# PRIVACY (non-negotiable, matches mesh-eye): the prompt forbids identifying or describing any
# person's appearance — only light / occupancy / general scene. On owned/authorized nodes only.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"

IMG="$HOME/.mesh/cam/last.jpg"
PROMPT="Read the image and describe the scene in ONE neutral sentence (light level, \
whether the space looks occupied or empty, general setting). Do NOT identify, name, or describe \
any person's appearance, clothing, or face. Output only the sentence, nothing else."
OLLAMA_URL="${MESH_OLLAMA_URL:-http://localhost:11434}"
VMODEL="${MESH_SEE_MODEL:-qwen3-vl:4b-instruct}"        # bare tag → local GPU; "claude" → paid path
VISION_NUM_CTX="${MESH_SEE_NUM_CTX:-8192}"              # full-res frame ~4.1k tok > ollama default 4096
VISION_TIMEOUT="${MESH_SEE_TIMEOUT:-120}"

# --- local ollama vision (free, on this node's GPU, frames never leave the house) ---------------
# Request/parse pair shared with mesh-object-id's proven ollama_id(): a camera-resolution base64
# image blows past Linux's per-argv limit if passed inline, so the payload goes to a temp file and
# curl reads it with -d @file.
OLLAMA_REQ_PY='
import base64, json, sys
model, img, prompt, ctx = sys.argv[1], sys.argv[2], sys.argv[3], int(sys.argv[4])
with open(img, "rb") as f:
    b64 = base64.b64encode(f.read()).decode()
json.dump({"model": model, "prompt": prompt, "images": [b64],
           "stream": False, "options": {"temperature": 0.0, "num_ctx": ctx}}, sys.stdout)
'
OLLAMA_RESP_PY='
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(1)
if "error" in d:
    sys.exit(1)
r = (d.get("response") or "").strip()
sys.stdout.write(r)
'

ollama_up(){ curl -s -m 3 "$OLLAMA_URL/api/tags" >/dev/null 2>&1; }

# local_see <img> <prompt> -> sentence on stdout; rc!=0 on ANY failure (never a faked description).
local_see(){
  local req resp
  req="$(mktemp)" || return 1
  python3 -c "$OLLAMA_REQ_PY" "$VMODEL" "$1" "$2" "$VISION_NUM_CTX" > "$req" 2>/dev/null \
    || { rm -f "$req"; return 1; }
  resp="$(curl -s -m "$VISION_TIMEOUT" "$OLLAMA_URL/api/generate" \
            -H "Content-Type: application/json" -d @"$req" 2>/dev/null \
          | python3 -c "$OLLAMA_RESP_PY" 2>/dev/null)"
  local rc=$?; rm -f "$req"
  [ "$rc" -eq 0 ] && [ -n "$resp" ] || return 1
  printf '%s' "$resp"
}

# --- paid path (the original vision path; kept as the quota fallback) ---------------------------
claude_see(){
  command -v claude >/dev/null 2>&1 || return 1
  (cd /tmp && timeout "$VISION_TIMEOUT" claude -p "$1" --allowedTools Read 2>/dev/null) \
    | grep -a . | tail -1 | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' | grep -a .
}

have_local(){ [ "$VMODEL" != claude ] && ollama_up; }

# The --test gate must see REAL sight, not a binary on PATH. The old gate checked only
# `command -v claude` and passed while every claude call answered "Failed to authenticate" — a
# green smoke test over a blind sense. Each backend is now driven end to end before it is called ok.
if [ "${1:-}" = --test ]; then
  mesh-camera --test >/dev/null 2>&1 \
    || { echo "smoke-test: FAIL (no camera capture path — see mesh-camera --test)"; exit 1; }

  if have_local; then
    frame="$IMG"; [ -s "$frame" ] || frame="$(mktemp --suffix=.jpg)" \
      || { echo "smoke-test: FAIL (no scratch frame)"; exit 1; }
    if [ ! -s "$frame" ]; then
      mesh-camera "$frame" >/dev/null 2>&1 \
        || { echo "smoke-test: FAIL (no vision backend: local capture failed and no frame to describe)"; exit 1; }
    fi
    local_see "$frame" "$PROMPT" >/dev/null 2>&1 \
      && { echo "smoke-test: ok (local ollama $VMODEL drove a real frame end to end)"; exit 0; }
    # local model up but the read failed: the paid path may still see
    claude_see "$PROMPT" >/dev/null 2>&1 \
      && { echo "smoke-test: ok (local $VMODEL read failed; paid claude path sees)"; exit 0; }
    echo "smoke-test: FAIL (local $VMODEL and claude -p both returned no description — the sense is BLIND)"; exit 1
  fi

  claude_see "$PROMPT" >/dev/null 2>&1 \
    || { echo "smoke-test: FAIL (no vision mind: $VMODEL unusable and claude -p returned nothing — check auth)"; exit 1; }
  echo "smoke-test: ok (paid claude path sees; local ollama unavailable)"; exit 0
fi

# 1) capture a fresh frame (real artifact or bail)
mesh-camera "$IMG" >/dev/null 2>&1 || { echo "mesh-see: capture failed (camera busy or no frame)" >&2; exit 1; }

# 2) describe it. Local GPU first (free, private); the paid path is the fallback. A dead local
#    read falls through rather than failing the whole organ.
if have_local; then
  desc="$(local_see "$IMG" "$PROMPT")" \
    || echo "mesh-see: local $VMODEL read failed — falling back to claude" >&2
fi
if [ -z "${desc:-}" ]; then
  desc="$(claude_see "$PROMPT")" \
    || { echo "mesh-see: no vision mind could describe the frame (local ollama down and claude unavailable/expired)" >&2; exit 1; }
fi

echo "$desc"

case " $* " in
  *" --say "*)  command -v mesh-say  >/dev/null 2>&1 && mesh-say  "$desc" >/dev/null 2>&1 ;;
esac
case " $* " in
  *" --chat "*) command -v mesh-chat >/dev/null 2>&1 && mesh-chat "[see] $desc" >/dev/null 2>&1 ;;
esac
exit 0
