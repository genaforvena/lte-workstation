#!/usr/bin/env bash
# mesh-see — turn the camera from a CAPTURE tool into a PERCEPTUAL organ: grab one still
# (mesh-camera) and have a vision-capable mind DESCRIBE it in one neutral sentence. The mesh
# can now answer "what do you see?" — not just "here's a JPEG".
#
# Why a separate tool: mesh-camera produces the artifact (a real JPEG); mesh-see turns that
# artifact into PERCEPTION (text a mind can act on, log to the board, or speak via mesh-say).
# Perceive-don't-store doctrine: the description is text; the frame is overwritten each call.
#
#   mesh-see                 capture + describe → one neutral sentence on stdout
#   mesh-see --say           also speak the description aloud (mesh-say)
#   mesh-see --chat          also post it to the board (mesh-chat, [see] tag)
#   mesh-see --test          smoke test (camera capture path + a vision mind)
#
# PRIVACY (non-negotiable, matches mesh-eye): the prompt forbids identifying or describing any
# person's appearance — only light / occupancy / general scene. On owned/authorized nodes only.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"

IMG="$HOME/.mesh/cam/last.jpg"
PROMPT="Read the image at $IMG and describe the scene in ONE neutral sentence (light level, \
whether the space looks occupied or empty, general setting). Do NOT identify, name, or describe \
any person's appearance, clothing, or face. Output only the sentence, nothing else."

have_vision(){ command -v claude >/dev/null 2>&1; }

if [ "${1:-}" = --test ]; then
  mesh-camera --test >/dev/null 2>&1 || { echo "smoke-test: FAIL (no camera capture path — see mesh-camera --test)"; exit 1; }
  have_vision || { echo "smoke-test: FAIL (no vision mind: claude -p)"; exit 1; }
  echo "smoke-test: ok"; exit 0
fi

have_vision || { echo "mesh-see: no vision mind (claude) on this node" >&2; exit 1; }

# 1) capture a fresh frame (real artifact or bail)
mesh-camera "$IMG" >/dev/null 2>&1 || { echo "mesh-see: capture failed (camera busy or no frame)" >&2; exit 1; }

# 2) describe it. Run from /tmp so claude's Read tool isn't scoped to a project; --allowedTools
#    Read keeps it to a single file read (no shell, no writes). Proven vision path.
desc="$(cd /tmp && timeout 120 claude -p "$PROMPT" --allowedTools Read 2>/dev/null \
        | grep -a . | tail -1 | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
[ -n "$desc" ] || { echo "mesh-see: vision mind returned nothing (timeout?)" >&2; exit 1; }

echo "$desc"

case " $* " in
  *" --say "*)  command -v mesh-say  >/dev/null 2>&1 && mesh-say  "$desc" >/dev/null 2>&1 ;;
esac
case " $* " in
  *" --chat "*) command -v mesh-chat >/dev/null 2>&1 && mesh-chat "[see] $desc" >/dev/null 2>&1 ;;
esac
exit 0
