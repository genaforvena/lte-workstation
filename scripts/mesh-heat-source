#!/usr/bin/env bash
# orphan-ok: on-demand advisory — a consumer (minds-allocation, mesh-mode, a thermal-remediation
#            reflex) calls it AT THE MOMENT a node is running hot, to pick the RIGHT remedy. The
#            answer is only meaningful during a hot episode, so it is deliberately NOT cron-wired.
#            Writes .heat-source.state every run (mtime always fresh → no change-gate false-STALE).
#
# mesh-heat-source — CROSS-SENSE FUSION: when a node is HOT, is the heat coming from its own
# WORKLOAD or from the ENVIRONMENT around it? One attribution no single sensor gives.
#
# THE GAP (audited 2026-07-11): mesh-stress / mesh-therm-watch / mesh-cpu-throttle / mesh-resource-guard
# all detect that a node is HOT and all prescribe the SAME remedy — shed a mind / throttle / cool the box.
# But a node at 90°C because 12 minds are cooking it and a node at 90°C because it is 34°C in the room
# are DIFFERENT problems with DIFFERENT fixes: the first wants load shed HERE; the second is ambient —
# shedding load is low-leverage (the whole fleet in that room is baking; relocate work to a node in a
# COOLER room, or cool the room). None of the node-only thermal tools can tell these apart, because the
# discriminator is a CROSS-SENSE one: the node's own die temp vs the ENVIRONMENT temperature vs a SECOND
# node's temp in (or out of) the same room. That fusion is the missing signal.
#
# INPUTS (all read cheap, no re-sensing beyond one /sys read):
#   NODE thermal    thermal_zone*/temp + hwmon*/temp*_input (cross-tier max, live) + cpu-throttle.state field-2
#                   (THROTTLING) — this node is HOT if max die temp >= HOT_C OR it is actively throttling.
#   ENVIRONMENT     .climate-state  out_c=  (outdoor/ambient temp, the shared heat bath the boxes sit in)
#                   → env_signal HOT (>= ENV_HOT_C) / MILD (known & below) / UNKNOWN (missing|stale).
#   PEER thermal    imac-therm.state (a SECOND independent node) — HOT / COOL / UNKNOWN. A second box
#                   hot at the same time is correlated → points at a shared ambient cause, not this
#                   node's private load.
#
# VERDICTS (the WORKLOAD vs ENVIRONMENTAL split is the genuine synergy — a JOINT read no input reaches
# alone; a bare "node is hot" cannot be attributed without the env + peer legs):
#   COOL          node is not hot — attribution moot (still reports the temps).
#   ENVIRONMENTAL node hot AND (environment HOT  OR  a peer node is ALSO hot) → the heat bath is warm;
#                 shedding load here is low-leverage. Remedy: cool the room / move work to a node in a
#                 cooler room, not just throttle this one.
#   WORKLOAD      node hot AND we have POSITIVE evidence the ambient is fine (env MILD or a peer COOL)
#                 and nothing says environmental → the heat is this node's own load. Remedy: shed/throttle HERE.
#   UNATTRIBUTED  node hot but BOTH env and peer are UNKNOWN → we honestly cannot say why. Never silently
#                 collapses to WORKLOAD or ENVIRONMENTAL (that is the honest-degrade rule, below).
#
# HONEST-DEGRADE ([[fusion-tools-distinguish-empty-from-failed]]): a MISSING/STALE input renders that
# axis UNKNOWN and appends "(partial)" — never silently counted as favorable. An UNREACHABLE input is
# visibly different from a genuine calm read: the reason line names every UNKNOWN axis, and if BOTH
# context legs are UNKNOWN while the node is hot the verdict is UNATTRIBUTED, not a guessed cause. If
# this node's OWN die temperature cannot be read at all we cannot even assess → CANNOT-ASSESS, exit 2.
#
#   mesh-heat-source            fold → one verdict + reason line
#   mesh-heat-source --json     machine-readable {verdict, partial, node_c, throttling, env_c, env_signal,
#                               peer, peer_signal, reason, ts}
#   mesh-heat-source --edge     emit ONLY on verdict change (for a stream/board consumer)
#   mesh-heat-source --test     assert the joint attribution rules + a live read yields a valid verdict
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

M="${MESH_DIR:-$HOME/.mesh}"
# MESH_TEST_SANDBOX=1 diverts the every-run state write — pre-fix, --test's live-read leg stamped
# the LIVE .heat-source.state (task test-live-writes 2026-07-20). MESH_DIR override still wins.
STATE="$M/.heat-source.state"
[ "${MESH_TEST_SANDBOX:-0}" != 1 ] || [ -n "${MESH_DIR:-}" ] || STATE="${TMPDIR:-/tmp}/.heat-source.state.sandbox.$$"
FRESH_S="${HEAT_FRESH_S:-1800}"          # a context input older than this is UNKNOWN, not trusted-stale
HOT_C="${HEAT_HOT_C:-80}"                # node die temp (°C) at/above which the node counts as HOT
ENV_HOT_C="${HEAT_ENV_HOT_C:-25}"        # outdoor temp (°C) at/above which the environment contributes heat
NOW="${HEAT_NOW:-$(date +%s)}"
# Thermal source globs (env-overridable so --test can drive fixture trees). TWO TIERS (2026-07-16,
# same family as mesh-stress 8cf5975 / mesh-therm / mesh-vitals): thermal_zone* is an Intel/ACPI
# assumption — AMD desktops (mesh-home) expose NO thermal_zone at all; the die temp lives in hwmon
# (k10temp). Zone-only left this node's own leg blind → CANNOT-ASSESS on every call here.
HEAT_ZONE_GLOB="${MESH_HEAT_ZONE_GLOB:-/sys/class/thermal/thermal_zone*/temp}"
HEAT_HWMON_GLOB="${MESH_HEAT_HWMON_GLOB:-/sys/class/hwmon/hwmon*/temp*_input}"

# ---- pure attribution: the whole fusion logic in one testable function ----------------------------
# args: node_hot(0|1)  env_signal(HOT|MILD|UNKNOWN)  peer_signal(HOT|COOL|UNKNOWN)
# echoes: "<VERDICT> <partial:0|1>"
attribute() {
  local hot="$1" env="$2" peer="$3" partial=0
  [ "$env" = UNKNOWN ] && partial=1
  [ "$peer" = UNKNOWN ] && partial=1
  if [ "$hot" -ne 1 ]; then echo "COOL $partial"; return; fi
  if [ "$env" = HOT ] || [ "$peer" = HOT ]; then echo "ENVIRONMENTAL $partial"; return; fi
  if [ "$env" = MILD ] || [ "$peer" = COOL ]; then echo "WORKLOAD $partial"; return; fi
  # node hot, no environmental signal, no positive "ambient is fine" evidence → both legs blind
  echo "UNATTRIBUTED $partial"
}

# ---- --test: exercise the attribution truth-table + a live read ----------------------------------
if [ "${1:-}" = "--test" ]; then
  # tmp fence — task:doctor-test-tmpdir-cleanup-traps. Re-exec the smoke test ONCE under a private
  # TMPDIR and remove it from the PARENT, so the cleanup cannot be lost to the test's own `exit 1`
  # and cannot be clobbered by an EXIT trap the test sets for itself. A nested --test inherits the
  # guard var and skips its own fence (it is already inside one).
  if [ -z "${MESH_TEST_TMPD:-}" ]; then
    MESH_TEST_TMPD="$(mktemp -d)" || { echo "smoke-test: FAIL (tmp fence: mktemp -d)"; exit 1; }
    trap 'rm -rf "$MESH_TEST_TMPD"' EXIT INT HUP TERM
    export MESH_TEST_TMPD TMPDIR="$MESH_TEST_TMPD" TMP="$MESH_TEST_TMPD" TEMP="$MESH_TEST_TMPD"
    _fence_rc=0; "$0" "$@" || _fence_rc=$?; exit "$_fence_rc"
  fi
  fail=0
  # TEST-SANDBOX (task test-live-writes 2026-07-20): the live-read leg's "$0" traverses the state
  # write — export so it diverts; %y ns sig gate before ok (fixture legs already sandbox MESH_DIR).
  export MESH_TEST_SANDBOX=1
  _hs_live="$HOME/.mesh/.heat-source.state"
  _hs_sig="$(stat -c '%y %s' "$_hs_live" 2>/dev/null || echo absent)"
  chk() { # expected  node_hot env peer
    local want="$1" got; got="$(attribute "$2" "$3" "$4")"
    [ "$got" = "$want" ] || { echo "  FAIL: attribute($2,$3,$4) = '$got', want '$want'"; fail=1; }
  }
  # not hot → COOL regardless of context
  chk "COOL 0"          0 MILD    COOL
  chk "COOL 1"          0 UNKNOWN COOL
  # hot + environmental signal → ENVIRONMENTAL (env hot, OR a peer also hot)
  chk "ENVIRONMENTAL 0" 1 HOT     COOL
  chk "ENVIRONMENTAL 0" 1 MILD    HOT
  chk "ENVIRONMENTAL 1" 1 UNKNOWN HOT
  # hot + positive "ambient fine" evidence, no environmental signal → WORKLOAD
  chk "WORKLOAD 0"      1 MILD    COOL
  chk "WORKLOAD 1"      1 MILD    UNKNOWN
  chk "WORKLOAD 1"      1 UNKNOWN COOL
  # hot + BOTH context legs blind → UNATTRIBUTED, never a guessed cause (honest-degrade core)
  chk "UNATTRIBUTED 1"  1 UNKNOWN UNKNOWN
  # hwmon-only fixture (the mesh-home / AMD shape: ZERO thermal_zone, die temp in k10temp hwmon) —
  # drives the REAL glob read path (never the MESH_HEAT_NODE_C injection hook); MESH_DIR sandboxed
  # so the fixture child cannot stamp the real .heat-source.state
  fx="$(mktemp -d)"; mkdir -p "$fx/hwmon0" "$fx/mesh"
  printf '53875\n' > "$fx/hwmon0/temp1_input"
  printf '47500\n' > "$fx/hwmon0/temp2_input"
  fxrun() { env -u MESH_HEAT_NODE_C -u MESH_HEAT_THROTTLING -u MESH_HEAT_ENV_C -u MESH_HEAT_PEER_SIGNAL \
        MESH_DIR="$fx/mesh" MESH_HEAT_ZONE_GLOB="$fx/zone*/temp" MESH_HEAT_HWMON_GLOB="$fx/hwmon*/temp*_input" \
        "$0" --json 2>/dev/null; }
  fj="$(fxrun)"
  printf '%s' "$fj" | grep -q '"node_c":53' || { echo "  FAIL: hwmon-only fixture → '$fj' (want node_c:53)"; fail=1; }
  # cross-tier max: zone 60C + hwmon 53C → 60 (neither tier shadows the other)
  mkdir -p "$fx/zone0"; printf '60000\n' > "$fx/zone0/temp"
  fj="$(fxrun)"
  printf '%s' "$fj" | grep -q '"node_c":60' || { echo "  FAIL: cross-tier fixture → '$fj' (want node_c:60)"; fail=1; }
  rm -rf "$fx"
  # live gate: a node with ANY readable temp source must assess (exit 0, never CANNOT-ASSESS);
  # a node with none exits 2 honestly — either way honest, fake-green neither
  have_organ=0
  for tf in /sys/class/thermal/thermal_zone*/temp /sys/class/hwmon/hwmon*/temp*_input; do
    [ -r "$tf" ] && { have_organ=1; break; }
  done
  live="$("$0" --json 2>/dev/null)"; lrc=$?
  if [ "$have_organ" -eq 1 ]; then
    [ "$lrc" -eq 0 ] || { echo "smoke-test: FAIL (temp organ present but live --json exit $lrc)"; exit 1; }
  else
    [ "$lrc" -eq 2 ] || { echo "smoke-test: FAIL (no temp organ but live --json exit $lrc, want honest 2)"; exit 1; }
  fi
  v="$(printf '%s' "$live" | grep -oE '"verdict":"[A-Z-]+"' | head -1 | cut -d'"' -f4)"
  case "$v" in COOL|ENVIRONMENTAL|WORKLOAD|UNATTRIBUTED|CANNOT-ASSESS) : ;;
    *) echo "smoke-test: FAIL (live verdict '$v' not in vocab)"; exit 1;; esac
  [ "$have_organ" -eq 1 ] && [ "$v" = CANNOT-ASSESS ] && { echo "smoke-test: FAIL (temp organ present yet verdict CANNOT-ASSESS — node leg blind)"; exit 1; }
  printf '%s' "$live" | grep -q '"reason":"..*"' || { echo "smoke-test: FAIL (empty reason)"; exit 1; }
  [ "$fail" -eq 0 ] || { echo "smoke-test: FAIL (attribution truth-table / fixtures)"; exit 1; }
  # sandbox honesty gate. Falsify: drop the MESH_TEST_SANDBOX diversion at the STATE assignment.
  _hs_sig2="$(stat -c '%y %s' "$_hs_live" 2>/dev/null || echo absent)"
  [ "$_hs_sig2" = "$_hs_sig" ] || { echo "smoke-test: FAIL (--test stamped the LIVE state $_hs_live: '$_hs_sig' → '$_hs_sig2')"; exit 1; }
  echo "smoke-test: ok (9 attribution asserts + 2 tier fixtures + live read → $v)"
  exit 0
fi

# ---- read NODE die temperature (max thermal zone, °C) + throttle state ----------------------------
node_c=""
if [ -n "${MESH_HEAT_NODE_C:-}" ]; then
  node_c="$MESH_HEAT_NODE_C"                       # test/override hook
else
  max=0
  for z in $HEAT_ZONE_GLOB $HEAT_HWMON_GLOB; do   # cross-tier max — see glob comment above
    [ -r "$z" ] || continue
    v="$(cat "$z" 2>/dev/null)"; [ -n "$v" ] || continue
    case "$v" in ''|*[!0-9]*) continue;; esac      # integer millidegrees only
    [ "$v" -gt "$max" ] && max="$v"
  done
  [ "$max" -gt 0 ] && node_c=$(( max / 1000 ))
fi

# throttle corroborator: cpu-throttle.state field-2 == THROTTLING
throttling=no
if [ -n "${MESH_HEAT_THROTTLING:-}" ]; then
  throttling="$MESH_HEAT_THROTTLING"
elif [ -r "$M/cpu-throttle.state" ]; then
  ts_line="$(head -n1 "$M/cpu-throttle.state" 2>/dev/null)"
  [ "$(printf '%s' "$ts_line" | awk '{print $2}')" = THROTTLING ] && throttling=yes
fi

# if we cannot read our own die temp AND have no throttle signal → cannot assess
if [ -z "$node_c" ] && [ "$throttling" = no ]; then
  reason="node die temperature unreadable (no thermal_zone AND no hwmon temp, no throttle state) — cannot assess heat"
  ts="$(date -u +%FT%TZ 2>/dev/null || echo "$NOW")"
  printf 'CANNOT-ASSESS | %s | %s\n' "$reason" "$ts" > "$STATE"
  if [ "${1:-}" = "--json" ]; then
    printf '{"verdict":"CANNOT-ASSESS","partial":1,"node_c":null,"throttling":"%s","env_c":null,"env_signal":"UNKNOWN","peer":"UNKNOWN","peer_signal":"UNKNOWN","reason":"%s","ts":"%s"}\n' "$throttling" "$reason" "$ts"
  else
    printf 'CANNOT-ASSESS — %s\n' "$reason"
  fi
  exit 2
fi

node_hot=0
[ -n "$node_c" ] && [ "$node_c" -ge "$HOT_C" ] && node_hot=1
[ "$throttling" = yes ] && node_hot=1

# ---- read_fresh <file> — echo first line if fresh, else empty (UNKNOWN caller-side) --------------
read_fresh() {
  local f="$1" mt
  [ -r "$f" ] || return 1
  mt="$(stat -c %Y "$f" 2>/dev/null || echo 0)"
  [ $(( NOW - mt )) -le "$FRESH_S" ] || return 1
  head -n1 "$f" 2>/dev/null
}

# ---- ENVIRONMENT leg: outdoor temp from .climate-state ------------------------------------------
env_c=""; env_signal=UNKNOWN
if [ -n "${MESH_HEAT_ENV_C:-}" ]; then
  env_c="$MESH_HEAT_ENV_C"
else
  cl="$(read_fresh "$M/.climate-state" || true)"
  [ -n "$cl" ] && env_c="$(printf '%s' "$cl" | grep -oE 'out_c=-?[0-9.]+' | head -1 | cut -d= -f2)"
fi
if [ -n "$env_c" ]; then
  # integer compare on the whole-degree part (avoid float in shell)
  ei="${env_c%%.*}"; [ -z "$ei" ] && ei=0
  case "$ei" in ''|*[!0-9-]*) env_signal=UNKNOWN;; *)
    if [ "$ei" -ge "$ENV_HOT_C" ]; then env_signal=HOT; else env_signal=MILD; fi ;;
  esac
fi

# ---- PEER leg: a second node's thermal state (imac-therm.state) ----------------------------------
peer=UNKNOWN; peer_signal=UNKNOWN
if [ -n "${MESH_HEAT_PEER_SIGNAL:-}" ]; then
  peer_signal="$MESH_HEAT_PEER_SIGNAL"; peer="${MESH_HEAT_PEER:-override}"
else
  pl="$(read_fresh "$M/imac-therm.state" || true)"
  if [ -n "$pl" ]; then
    peer=imac
    # label after the [imac-therm] tag: NOMINAL/OK/COOL → COOL; HOT/THROTTL/CRIT → HOT
    plab="$(printf '%s' "$pl" | grep -oE '\] *[A-Z-]+' | head -1 | tr -d '] ')"
    case "$plab" in
      HOT|THROTTLING|CRIT*|HIGH|WARM) peer_signal=HOT ;;
      NOMINAL|OK|COOL|IDLE|CALM)      peer_signal=COOL ;;
      *)                              peer_signal=UNKNOWN ;;
    esac
  fi
fi

# ---- fold -----------------------------------------------------------------------------------------
read verdict partial <<<"$(attribute "$node_hot" "$env_signal" "$peer_signal")"

nc_disp="${node_c:-?}"; ec_disp="${env_c:-?}"
partial_tag=""; [ "$partial" -eq 1 ] && partial_tag=" (partial)"

# reason line — names each UNKNOWN axis so a degraded read is visibly distinct from a calm one
unknowns=""
[ "$env_signal" = UNKNOWN ]  && unknowns="${unknowns} env(no fresh climate out_c)"
[ "$peer_signal" = UNKNOWN ] && unknowns="${unknowns} peer(no fresh imac-therm)"
case "$verdict" in
  COOL)          reason="node ${nc_disp}°C < ${HOT_C}°C and not throttling — not hot" ;;
  ENVIRONMENTAL) reason="node HOT (${nc_disp}°C, throttling=${throttling}) AND heat bath is warm (env=${ec_disp}°C/${env_signal}, peer ${peer}=${peer_signal}) — shedding load here is low-leverage; cool the room / relocate to a cooler node" ;;
  WORKLOAD)      reason="node HOT (${nc_disp}°C, throttling=${throttling}) but ambient is fine (env=${ec_disp}°C/${env_signal}, peer ${peer}=${peer_signal}) — heat is this node's own load; shed/throttle HERE" ;;
  UNATTRIBUTED)  reason="node HOT (${nc_disp}°C, throttling=${throttling}) but both context legs blind —${unknowns:- both unknown}; cannot attribute cause" ;;
esac
[ -n "$unknowns" ] && [ "$verdict" != UNATTRIBUTED ] && reason="${reason} [UNKNOWN:${unknowns} ]"

ts="$(date -u +%FT%TZ 2>/dev/null || echo "$NOW")"

# persist (unconditionally every run → mtime always fresh, no change-gate false-STALE)
printf '%s%s | node=%s°C throttling=%s | env=%s°C/%s | peer=%s/%s | %s\n' \
  "$verdict" "$partial_tag" "$nc_disp" "$throttling" "$ec_disp" "$env_signal" "$peer" "$peer_signal" "$ts" > "$STATE"

if [ "${1:-}" = "--json" ]; then
  jnc="${node_c:-null}"; jec="${env_c:-null}"
  printf '{"verdict":"%s","partial":%s,"node_c":%s,"throttling":"%s","env_c":%s,"env_signal":"%s","peer":"%s","peer_signal":"%s","reason":"%s","ts":"%s"}\n' \
    "$verdict" "$partial" "$jnc" "$throttling" "$jec" "$env_signal" "$peer" "$peer_signal" "$reason" "$ts"
  exit 0
fi

if [ "${1:-}" = "--edge" ]; then
  prev_f="$M/.heat-source.verdict"
  prev="$(cat "$prev_f" 2>/dev/null || true)"
  printf '%s' "$verdict" > "$prev_f"
  [ "$verdict" = "$prev" ] && exit 0     # no change → silent
  printf '[heat-source] %s%s — %s\n' "$verdict" "$partial_tag" "$reason"
  exit 0
fi

printf '%s%s — %s\n' "$verdict" "$partial_tag" "$reason"
