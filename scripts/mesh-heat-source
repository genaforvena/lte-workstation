#!/usr/bin/env bash
# orphan-ok: on-demand advisory — a consumer (minds-allocation, mesh-mode, a thermal-remediation
#            reflex) calls it AT THE MOMENT a node is running hot, to pick the RIGHT remedy. The
#            answer is only meaningful during a hot episode, so it is deliberately NOT cron-wired.
#            Writes .heat-source.state every run (mtime always fresh → no change-gate false-STALE).
#
# mesh-heat-source — CROSS-SENSE FUSION: when a node is HOT, is the heat coming from its own
# WORKLOAD or from the ENVIRONMENT around it? One attribution no single sensor gives.
#
# THE GAP (audited 2026-07-11): mesh-stress / mesh-therm-watch / mesh-cpu-throttle / mesh-resource-guard
# all detect that a node is HOT and all prescribe the SAME remedy — shed a mind / throttle / cool the box.
# But a node at 90°C because 12 minds are cooking it and a node at 90°C because it is 34°C in the room
# are DIFFERENT problems with DIFFERENT fixes: the first wants load shed HERE; the second is ambient —
# shedding load is low-leverage (the whole fleet in that room is baking; relocate work to a node in a
# COOLER room, or cool the room). None of the node-only thermal tools can tell these apart, because the
# discriminator is a CROSS-SENSE one: the node's own die temp vs the ENVIRONMENT temperature vs a SECOND
# node's temp in (or out of) the same room. That fusion is the missing signal.
#
# INPUTS (all read cheap, no re-sensing beyond one /sys read):
#   NODE thermal    thermal_zone*/temp + hwmon*/temp*_input + cpu-throttle.state field-2 (THROTTLING).
#                   Every readable sensor is TIERED (cpu / disk / other) and judged against ITS OWN
#                   tier's hot line — the node is HOT if ANY sensor crosses ITS OWN threshold, or it
#                   is actively throttling.
#
# THE ARGMAX WAS AN SSD WEARING A CPU-DIE LABEL (task mesh-heat-source, 2026-08-22).
#   node_c was a bare cross-tier max over both globs. On mesh-home that max is nvme0's "Sensor 1"
#   (70-74°C) and NOT k10temp/Tctl (59-65°C) — measured 3x — so a disk reading was published in a
#   field every consumer reads as the die, and judged against HOT_C=80, a CPU number, while that
#   drive's OWN published warning line is 74.85°C. Two fixes, and dropping the disk tier is NOT one
#   of them (the hottest thing on this node would then go unwatched by the only organ that sees it):
#     (a) ATTRIBUTE the argmax — node_c never travels without node_label / node_src / node_tier, so
#         an attribution is never a bare number [[an-attribution-is-not-a-health-verdict]];
#     (b) THRESHOLD PER TIER — cpu gets HOT_C, a disk gets the CONTROLLER'S OWN temp1_max (sentinel
#         65261850 = 0xFFFF "unset" refused, falling back to HEAT_DISK_HOT_C with the fallback NAMED
#         in node_thr_src), other gets HEAT_OTHER_HOT_C.
#   The crossing sensor is picked by the LARGEST MARGIN OVER ITS OWN LINE, never by scan order
#   [[a-first-match-classifier-reports-the-order-not-the-strongest-reason]] — the globs enumerate
#   hwmon0,1,2… so a first-match hot pick would report the lowest-numbered controller, not the worst.
#   ENVIRONMENT     .climate-state  out_c=  (outdoor/ambient temp, the shared heat bath the boxes sit in)
#                   → env_signal HOT (>= ENV_HOT_C) / MILD (known & below) / UNKNOWN (missing|stale).
#   PEER thermal    imac-therm.state (a SECOND independent node) — HOT / COOL / UNKNOWN. A second box
#                   hot at the same time is correlated → points at a shared ambient cause, not this
#                   node's private load.
#
# VERDICTS (the WORKLOAD vs ENVIRONMENTAL split is the genuine synergy — a JOINT read no input reaches
# alone; a bare "node is hot" cannot be attributed without the env + peer legs):
#   COOL          node is not hot — attribution moot (still reports the temps).
#   ENVIRONMENTAL node hot AND (environment HOT  OR  a peer node is ALSO hot) → the heat bath is warm;
#                 shedding load here is low-leverage. Remedy: cool the room / move work to a node in a
#                 cooler room, not just throttle this one.
#   WORKLOAD      node hot AND we have POSITIVE evidence the ambient is fine (env MILD or a peer COOL)
#                 and nothing says environmental → the heat is this node's own load. Remedy: shed/throttle HERE.
#   UNATTRIBUTED  node hot but BOTH env and peer are UNKNOWN → we honestly cannot say why. Never silently
#                 collapses to WORKLOAD or ENVIRONMENTAL (that is the honest-degrade rule, below).
#
# HONEST-DEGRADE ([[fusion-tools-distinguish-empty-from-failed]]): a MISSING/STALE input renders that
# axis UNKNOWN and appends "(partial)" — never silently counted as favorable. An UNREACHABLE input is
# visibly different from a genuine calm read: the reason line names every UNKNOWN axis, and if BOTH
# context legs are UNKNOWN while the node is hot the verdict is UNATTRIBUTED, not a guessed cause. If
# this node's OWN die temperature cannot be read at all we cannot even assess → CANNOT-ASSESS, exit 2.
#
#   mesh-heat-source            fold → one verdict + reason line
#   mesh-heat-source --json     machine-readable {verdict, partial, node_c, node_label, node_src,
#                               node_tier, node_thr_c, node_thr_src, cpu_c, disk_c, hot_tier,
#                               hot_label, hot_src, hot_c, hot_thr_c, throttling, env_c, env_signal,
#                               peer, peer_signal, reason, ts}. A tier with no sensor renders null/na.
#   mesh-heat-source --edge     emit ONLY on verdict change (for a stream/board consumer)
#   mesh-heat-source --test     assert the joint attribution rules + a live read yields a valid verdict
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

M="${MESH_DIR:-$HOME/.mesh}"
# MESH_TEST_SANDBOX=1 diverts the every-run state write — pre-fix, --test's live-read leg stamped
# the LIVE .heat-source.state (task test-live-writes 2026-07-20). MESH_DIR override still wins.
STATE="$M/.heat-source.state"
[ "${MESH_TEST_SANDBOX:-0}" != 1 ] || [ -n "${MESH_DIR:-}" ] || STATE="${TMPDIR:-/tmp}/.heat-source.state.sandbox.$$"
FRESH_S="${HEAT_FRESH_S:-1800}"          # a context input older than this is UNKNOWN, not trusted-stale
HOT_C="${HEAT_HOT_C:-80}"                # CPU-tier die temp (°C) at/above which that sensor is HOT
DISK_HOT_C="${HEAT_DISK_HOT_C:-70}"      # disk-tier FALLBACK line, used ONLY when the controller
                                         # publishes no real temp1_max (sentinel/absent) — named as
                                         # "disk-default" in node_thr_src so a fallback is never
                                         # mistaken for the drive's own number
OTHER_HOT_C="${HEAT_OTHER_HOT_C:-$HOT_C}"  # unclassified sensors — no tier knowledge, so CPU's line
ENV_HOT_C="${HEAT_ENV_HOT_C:-25}"        # outdoor temp (°C) at/above which the environment contributes heat
NOW="${HEAT_NOW:-$(date +%s)}"
# Thermal source globs (env-overridable so --test can drive fixture trees). TWO TIERS (2026-07-16,
# same family as mesh-stress 8cf5975 / mesh-therm / mesh-vitals): thermal_zone* is an Intel/ACPI
# assumption — AMD desktops (mesh-home) expose NO thermal_zone at all; the die temp lives in hwmon
# (k10temp). Zone-only left this node's own leg blind → CANNOT-ASSESS on every call here.
HEAT_ZONE_GLOB="${MESH_HEAT_ZONE_GLOB:-/sys/class/thermal/thermal_zone*/temp}"
HEAT_HWMON_GLOB="${MESH_HEAT_HWMON_GLOB:-/sys/class/hwmon/hwmon*/temp*_input}"

US=$'\x1f'                              # non-whitespace field sep: an empty field must not collapse
SENTINEL_MAX=65261850                    # 0xFFFF in NVMe's 0.01K encoding = "threshold not
                                         # implemented"; a 65261°C ceiling passes forever, so it is
                                         # refused, never rendered as a number
                                         # [[a-guard-above-every-reachable-value-is-unobservable]]

# ---- tiering: which KIND of thing is this sensor on? ---------------------------------------------
# An EXPLICIT name→tier map, evaluated per sensor. Unknown names land in `other` (loud, and judged
# against the CPU line) rather than being silently folded into the die.
tier_of() {
  case "${1:-}" in
    nvme|nvme*|drivetemp|sd[a-z]|hdd*|ssd*)                   echo disk ;;
    k10temp|k8temp|coretemp|zenpower*|cpu_thermal|x86_pkg_temp|*cpu*|*_pkg_*) echo cpu ;;
    *)                                                        echo other ;;
  esac
}

# real_max_mC <file> — the controller's OWN published ceiling, or nothing. Sentinel and non-numeric
# both return 1: an unset ceiling must render as "no ceiling", never as 65261850.
real_max_mC() {
  local v
  v="$(cat "${1:-/nonexistent}" 2>/dev/null)" || return 1
  case "$v" in ''|*[!0-9-]*) return 1 ;; esac
  [ "$v" -ge "$SENTINEL_MAX" ] 2>/dev/null && return 1
  [ "$v" -le 0 ] 2>/dev/null && return 1
  printf '%s' "$v"
}

# ---- scan_thermal — one US-separated row per readable sensor -------------------------------------
#   tier <US> deg_c <US> label <US> src <US> thr_c <US> thr_src
# src is "<hwmon name>:<hwmonN>" (or "thermal:<zoneN>") so an attribution names the ORGAN, not just
# a number. Nothing here decides hotness; the fold does, per row, against that row's own thr_c.
scan_thermal() {
  local z d f n label raw hname base tier thr thrsrc dmax
  shopt -s nullglob
  for z in $HEAT_ZONE_GLOB; do
    [ -r "$z" ] || continue
    raw="$(cat "$z" 2>/dev/null)"; case "$raw" in ''|*[!0-9]*) continue ;; esac
    d="${z%/temp}"; base="${d##*/}"
    label="$(cat "$d/type" 2>/dev/null)"; [ -n "$label" ] || label="$base"
    tier="$(tier_of "$label")"
    case "$tier" in cpu) thr="$HOT_C"; thrsrc=cpu-default ;;
                    disk) thr="$DISK_HOT_C"; thrsrc=disk-default ;;
                    *) thr="$OTHER_HOT_C"; thrsrc=other-default ;; esac
    printf '%s%s%s%s%s%s%s%s%s%s%s\n' "$tier" "$US" "$(( raw / 1000 ))" "$US" "$label" "$US" "thermal:$base" "$US" "$thr" "$US" "$thrsrc"
  done
  for f in $HEAT_HWMON_GLOB; do
    [ -r "$f" ] || continue
    raw="$(cat "$f" 2>/dev/null)"; case "$raw" in ''|*[!0-9]*) continue ;; esac
    d="${f%/*}"; base="${d##*/}"; n="${f##*/}"; n="${n%_input}"
    hname="$(cat "$d/name" 2>/dev/null)"; [ -n "$hname" ] || hname="$base"
    label="$(cat "$d/${n}_label" 2>/dev/null)"; [ -n "$label" ] || label="$n"
    tier="$(tier_of "$hname")"
    case "$tier" in
      cpu)  thr="$HOT_C"; thrsrc=cpu-default ;;
      disk) # the DRIVE'S own warning line, not a CPU number borrowed from another tier
            if dmax="$(real_max_mC "$d/temp1_max")"; then thr=$(( dmax / 1000 )); thrsrc="drive(temp1_max)"
            else thr="$DISK_HOT_C"; thrsrc=disk-default; fi ;;
      *)    thr="$OTHER_HOT_C"; thrsrc=other-default ;;
    esac
    printf '%s%s%s%s%s%s%s%s%s%s%s\n' "$tier" "$US" "$(( raw / 1000 ))" "$US" "$label" "$US" "$hname:$base" "$US" "$thr" "$US" "$thrsrc"
  done
}

# ---- pure attribution: the whole fusion logic in one testable function ----------------------------
# args: node_hot(0|1)  env_signal(HOT|MILD|UNKNOWN)  peer_signal(HOT|COOL|UNKNOWN)
# echoes: "<VERDICT> <partial:0|1>"
attribute() {
  local hot="$1" env="$2" peer="$3" partial=0
  [ "$env" = UNKNOWN ] && partial=1
  [ "$peer" = UNKNOWN ] && partial=1
  if [ "$hot" -ne 1 ]; then echo "COOL $partial"; return; fi
  if [ "$env" = HOT ] || [ "$peer" = HOT ]; then echo "ENVIRONMENTAL $partial"; return; fi
  if [ "$env" = MILD ] || [ "$peer" = COOL ]; then echo "WORKLOAD $partial"; return; fi
  # node hot, no environmental signal, no positive "ambient is fine" evidence → both legs blind
  echo "UNATTRIBUTED $partial"
}

# ---- --test: exercise the attribution truth-table + a live read ----------------------------------
if [ "${1:-}" = "--test" ]; then
  # tmp fence — task:doctor-test-tmpdir-cleanup-traps. Re-exec the smoke test ONCE under a private
  # TMPDIR and remove it from the PARENT, so the cleanup cannot be lost to the test's own `exit 1`
  # and cannot be clobbered by an EXIT trap the test sets for itself. A nested --test inherits the
  # guard var and skips its own fence (it is already inside one).
  if [ -z "${MESH_TEST_TMPD:-}" ]; then
    MESH_TEST_TMPD="$(mktemp -d)" || { echo "smoke-test: FAIL (tmp fence: mktemp -d)"; exit 1; }
    trap 'rm -rf "$MESH_TEST_TMPD"' EXIT INT HUP TERM
    export MESH_TEST_TMPD TMPDIR="$MESH_TEST_TMPD" TMP="$MESH_TEST_TMPD" TEMP="$MESH_TEST_TMPD"
    _fence_rc=0; "$0" "$@" || _fence_rc=$?; exit "$_fence_rc"
  fi
  fail=0
  # TEST-SANDBOX (task test-live-writes 2026-07-20): the live-read leg's "$0" traverses the state
  # write — export so it diverts; %y ns sig gate before ok (fixture legs already sandbox MESH_DIR).
  export MESH_TEST_SANDBOX=1
  _hs_live="$HOME/.mesh/.heat-source.state"
  _hs_sig="$(stat -c '%y %s' "$_hs_live" 2>/dev/null || echo absent)"
  chk() { # expected  node_hot env peer
    local want="$1" got; got="$(attribute "$2" "$3" "$4")"
    [ "$got" = "$want" ] || { echo "  FAIL: attribute($2,$3,$4) = '$got', want '$want'"; fail=1; }
  }
  # not hot → COOL regardless of context
  chk "COOL 0"          0 MILD    COOL
  chk "COOL 1"          0 UNKNOWN COOL
  # hot + environmental signal → ENVIRONMENTAL (env hot, OR a peer also hot)
  chk "ENVIRONMENTAL 0" 1 HOT     COOL
  chk "ENVIRONMENTAL 0" 1 MILD    HOT
  chk "ENVIRONMENTAL 1" 1 UNKNOWN HOT
  # hot + positive "ambient fine" evidence, no environmental signal → WORKLOAD
  chk "WORKLOAD 0"      1 MILD    COOL
  chk "WORKLOAD 1"      1 MILD    UNKNOWN
  chk "WORKLOAD 1"      1 UNKNOWN COOL
  # hot + BOTH context legs blind → UNATTRIBUTED, never a guessed cause (honest-degrade core)
  chk "UNATTRIBUTED 1"  1 UNKNOWN UNKNOWN
  # hwmon-only fixture (the mesh-home / AMD shape: ZERO thermal_zone, die temp in k10temp hwmon) —
  # drives the REAL glob read path (never the MESH_HEAT_NODE_C injection hook); MESH_DIR sandboxed
  # so the fixture child cannot stamp the real .heat-source.state
  fx="$(mktemp -d)"; mkdir -p "$fx/hwmon0" "$fx/mesh"
  printf '53875\n' > "$fx/hwmon0/temp1_input"
  printf '47500\n' > "$fx/hwmon0/temp2_input"
  fxrun() { env -u MESH_HEAT_NODE_C -u MESH_HEAT_THROTTLING -u MESH_HEAT_ENV_C -u MESH_HEAT_PEER_SIGNAL \
        MESH_DIR="$fx/mesh" MESH_HEAT_ZONE_GLOB="$fx/zone*/temp" MESH_HEAT_HWMON_GLOB="$fx/hwmon*/temp*_input" \
        "$0" --json 2>/dev/null; }
  fj="$(fxrun)"
  printf '%s' "$fj" | grep -q '"node_c":53' || { echo "  FAIL: hwmon-only fixture → '$fj' (want node_c:53)"; fail=1; }
  # cross-tier max: zone 60C + hwmon 53C → 60 (neither tier shadows the other)
  mkdir -p "$fx/zone0"; printf '60000\n' > "$fx/zone0/temp"
  fj="$(fxrun)"
  printf '%s' "$fj" | grep -q '"node_c":60' || { echo "  FAIL: cross-tier fixture → '$fj' (want node_c:60)"; fail=1; }
  rm -rf "$fx"

  # ---- TIERED ATTRIBUTION fixtures (task mesh-heat-source 2026-08-22) ----------------------------
  # Each builds a hwmon tree with real `name`/`_label`/`temp1_max` files and drives the glob path.
  # jf <json> <field> — extract a JSON scalar (string or number) by key
  jf() { printf '%s' "$1" | grep -oE "\"$2\":(\"[^\"]*\"|-?[0-9]+|null)" | head -1 | cut -d: -f2- | tr -d '"'; }
  mk_nvme() { # dir  sensor1_mC  temp1_max_mC(or '' = absent)
    mkdir -p "$1"; printf 'nvme\n' > "$1/name"
    printf '40850\n' > "$1/temp1_input"; printf 'Composite\n' > "$1/temp1_label"
    printf '%s\n' "$2" > "$1/temp2_input"; printf 'Sensor 1\n' > "$1/temp2_label"
    [ -n "${3:-}" ] && printf '%s\n' "$3" > "$1/temp1_max"; return 0
  }
  mk_cpu() { # dir  tctl_mC
    mkdir -p "$1"; printf 'k10temp\n' > "$1/name"
    printf '%s\n' "$2" > "$1/temp1_input"; printf 'Tctl\n' > "$1/temp1_label"
  }
  tier_case() { # name  want_node_c want_tier want_thr want_thr_src want_verdict want_hot_tier want_hot_src
    local nm="$1" j
    j="$(fxrun)"
    local gc gt gth gts gv ght ghs
    gc="$(jf "$j" node_c)"; gt="$(jf "$j" node_tier)"; gth="$(jf "$j" node_thr_c)"
    gts="$(jf "$j" node_thr_src)"; gv="$(jf "$j" verdict)"; ght="$(jf "$j" hot_tier)"; ghs="$(jf "$j" hot_src)"
    local got="$gc|$gt|$gth|$gts|$gv|$ght|$ghs" want="$2|$3|$4|$5|$6|$7|$8"
    [ "$got" = "$want" ] || { echo "  FAIL: tier fixture '$nm' = '$got', want '$want'"; fail=1; }
  }

  # (1) the mesh-home shape: a disk sensor IS the argmax, judged against the DRIVE's own line (74),
  #     NOT the CPU's 80 — and it is BELOW that line, so the node is not hot.
  fx="$(mktemp -d)"; mkdir -p "$fx/mesh"; mk_nvme "$fx/hwmon0" 72000 74850
  tier_case "disk argmax under the drive's own line" 72 disk 74 "drive(temp1_max)" COOL na na
  # (2) same drive 2°C hotter → HOT, and the crossing sensor is ATTRIBUTED (label@organ), not a bare number
  mk_nvme "$fx/hwmon0" 76000 74850
  tier_case "disk over the drive's own line" 76 disk 74 "drive(temp1_max)" UNATTRIBUTED disk "nvme:hwmon0"
  # (3) 0xFFFF sentinel ceiling is REFUSED — the fallback line is used and NAMED as the fallback,
  #     never rendered as a 65261°C ceiling that can never be crossed
  mk_nvme "$fx/hwmon0" 72000 65261850
  tier_case "sentinel ceiling refused → named fallback" 72 disk 70 disk-default UNATTRIBUTED disk "nvme:hwmon0"
  rm -rf "$fx"

  # (4) THE CORE SPLIT: the argmax is the disk (90°C, but its own line is 95) while the CPU at 82 is
  #     over ITS line of 80. A single cross-tier max would call the node hot at 90 and blame the disk;
  #     a disk-tier drop would miss the 90 entirely. Here node_c reports 90 ATTRIBUTED to the disk and
  #     the HOT verdict is attributed to the CPU. [[an-attribution-is-not-a-health-verdict]]
  fx="$(mktemp -d)"; mkdir -p "$fx/mesh"; mk_nvme "$fx/hwmon0" 90000 95000; mk_cpu "$fx/hwmon1" 82000
  tier_case "argmax tier != crossing tier" 90 disk 95 "drive(temp1_max)" UNATTRIBUTED cpu "k10temp:hwmon1"
  rm -rf "$fx"

  # (5) two sensors BOTH over their own lines: the crossing one is the largest MARGIN (cpu +10),
  #     not the first scanned (hwmon0, the disk, +2)
  #     [[a-first-match-classifier-reports-the-order-not-the-strongest-reason]]
  fx="$(mktemp -d)"; mkdir -p "$fx/mesh"; mk_nvme "$fx/hwmon0" 76000 74850; mk_cpu "$fx/hwmon1" 90000
  tier_case "crossing sensor is max margin, not scan order" 90 cpu 80 cpu-default UNATTRIBUTED cpu "k10temp:hwmon1"
  rm -rf "$fx"

  # (6) a tier with NO sensor renders `na`, never 0 — 0 is a temperature
  #     [[a-summary-line-asserts-legs-that-rendered-na]]
  fx="$(mktemp -d)"; mkdir -p "$fx/mesh"; mk_nvme "$fx/hwmon0" 50000 74850
  fj="$(fxrun)"
  [ "$(jf "$fj" cpu_c)" = null ] || { echo "  FAIL: absent cpu tier → cpu_c '$(jf "$fj" cpu_c)', want null"; fail=1; }
  printf '%s' "$fj" | grep -q 'cpu=na°C' || { echo "  FAIL: absent cpu tier not rendered na in the reason: '$fj'"; fail=1; }
  rm -rf "$fx"
  # live gate: a node with ANY readable temp source must assess (exit 0, never CANNOT-ASSESS);
  # a node with none exits 2 honestly — either way honest, fake-green neither
  have_organ=0
  for tf in /sys/class/thermal/thermal_zone*/temp /sys/class/hwmon/hwmon*/temp*_input; do
    [ -r "$tf" ] && { have_organ=1; break; }
  done
  live="$("$0" --json 2>/dev/null)"; lrc=$?
  if [ "$have_organ" -eq 1 ]; then
    [ "$lrc" -eq 0 ] || { echo "smoke-test: FAIL (temp organ present but live --json exit $lrc)"; exit 1; }
  else
    [ "$lrc" -eq 2 ] || { echo "smoke-test: FAIL (no temp organ but live --json exit $lrc, want honest 2)"; exit 1; }
  fi
  v="$(printf '%s' "$live" | grep -oE '"verdict":"[A-Z-]+"' | head -1 | cut -d'"' -f4)"
  case "$v" in COOL|ENVIRONMENTAL|WORKLOAD|UNATTRIBUTED|CANNOT-ASSESS) : ;;
    *) echo "smoke-test: FAIL (live verdict '$v' not in vocab)"; exit 1;; esac
  [ "$have_organ" -eq 1 ] && [ "$v" = CANNOT-ASSESS ] && { echo "smoke-test: FAIL (temp organ present yet verdict CANNOT-ASSESS — node leg blind)"; exit 1; }
  printf '%s' "$live" | grep -q '"reason":"..*"' || { echo "smoke-test: FAIL (empty reason)"; exit 1; }
  [ "$fail" -eq 0 ] || { echo "smoke-test: FAIL (attribution truth-table / fixtures)"; exit 1; }
  # sandbox honesty gate. Falsify: drop the MESH_TEST_SANDBOX diversion at the STATE assignment.
  _hs_sig2="$(stat -c '%y %s' "$_hs_live" 2>/dev/null || echo absent)"
  if [ "$_hs_sig2" != "$_hs_sig" ]; then
    # HONESTY-GATE ATTRIBUTION (memory a-sandbox-honesty-gate-cannot-separate-a-leak-from-a-collision):
    # a moved live artifact has TWO causes and ONE sample cannot separate them — a leaking sandbox,
    # or a CONCURRENT live writer (this reflex's own cron tick, or any other tool that writes the
    # same path) stamping it inside the test window. The single-sample form blamed the test and went
    # red with nothing wrong (mesh-node-health 2026-08-15, mesh-sound-reflex c5779d6); mesh-land and
    # mesh-doctor both consume this verdict, so a false red BLOCKS LANDING. No lock covers this
    # write path, so attribute by REPEATING: a real leak moves the artifact on EVERY attempt, a
    # collision does not repeat. Drive both directions — leak twice must still FAIL, leak once must
    # print the note and pass.
    if [ -n "${MESH_HONESTY_RETRY:-}" ]; then echo "smoke-test: FAIL (--test stamped the LIVE state $_hs_live: '$_hs_sig' → '$_hs_sig2' — moved on BOTH attempts, a real sandbox leak, not a concurrent-writer collision)"; exit 1; fi
    _hr_a="$(stat -c '%y %s' "$_hs_live" 2>/dev/null || echo absent)"
    MESH_HONESTY_RETRY=1 "$0" --test >/dev/null 2>&1
    _hr_b="$(stat -c '%y %s' "$_hs_live" 2>/dev/null || echo absent)"
    [ "$_hr_b" = "$_hr_a" ] || { echo "smoke-test: FAIL (--test stamped the LIVE state $_hs_live: '$_hs_sig' → '$_hs_sig2' — moved on BOTH attempts, a real sandbox leak, not a concurrent-writer collision)"; exit 1; }
    echo "  note: a LIVE artifact moved during attempt 1 but NOT during the re-run — attributed to a concurrent live writer, not a sandbox leak"
  fi
  echo "smoke-test: ok (9 attribution asserts + 2 glob fixtures + 6 tiered-attribution fixtures + live read → $v)"
  exit 0
fi

# ---- read NODE thermal rows, ATTRIBUTED and tiered ------------------------------------------------
# node_c stays the cross-tier argmax (every existing consumer reads it), but it NEVER travels alone:
# node_label / node_src / node_tier say WHAT it is, and node_thr_c / node_thr_src say which line it
# was judged against.
node_c=""; node_label=na; node_src=na; node_tier=na; node_thr=""; node_thr_src=na
cpu_c=""; disk_c=""
hot_tier=na; hot_label=na; hot_src=na; hot_c=""; hot_thr=""
rows=""
if [ -n "${MESH_HEAT_NODE_C:-}" ]; then
  node_c="$MESH_HEAT_NODE_C"                       # test/override hook
  rows="override${US}${node_c}${US}override${US}override${US}${HOT_C}${US}cpu-default"
else
  rows="$(scan_thermal)"
fi

if [ -n "$rows" ]; then
  best_margin=""
  while IFS="$US" read -r r_tier r_c r_label r_src r_thr r_thrsrc; do
    [ -n "${r_c:-}" ] || continue
    case "$r_c" in ''|*[!0-9-]*) continue ;; esac
    # cross-tier argmax → node_c, WITH its attribution
    if [ -z "$node_c" ] || [ "$r_c" -gt "$node_c" ]; then
      node_c="$r_c"; node_label="$r_label"; node_src="$r_src"
      node_tier="$r_tier"; node_thr="$r_thr"; node_thr_src="$r_thrsrc"
    fi
    case "$r_tier" in
      cpu)  { [ -z "$cpu_c" ]  || [ "$r_c" -gt "$cpu_c" ]; }  && cpu_c="$r_c" ;;
      disk) { [ -z "$disk_c" ] || [ "$r_c" -gt "$disk_c" ]; } && disk_c="$r_c" ;;
    esac
    # the CROSSING sensor is the one furthest over ITS OWN line — never the first one scanned
    # [[a-first-match-classifier-reports-the-order-not-the-strongest-reason]]
    if [ "$r_c" -ge "$r_thr" ] 2>/dev/null; then
      m=$(( r_c - r_thr ))
      if [ -z "$best_margin" ] || [ "$m" -gt "$best_margin" ]; then
        best_margin="$m"; hot_tier="$r_tier"; hot_label="$r_label"; hot_src="$r_src"
        hot_c="$r_c"; hot_thr="$r_thr"
      fi
    fi
  done <<EOF
$rows
EOF
  # the override hook has no tiering to attribute
  if [ -n "${MESH_HEAT_NODE_C:-}" ]; then
    node_label=override; node_src=override; node_tier=override
    node_thr="$HOT_C"; node_thr_src=cpu-default
  fi
fi

# throttle corroborator: cpu-throttle.state field-2 == THROTTLING
throttling=no
if [ -n "${MESH_HEAT_THROTTLING:-}" ]; then
  throttling="$MESH_HEAT_THROTTLING"
elif [ -r "$M/cpu-throttle.state" ]; then
  ts_line="$(head -n1 "$M/cpu-throttle.state" 2>/dev/null)"
  [ "$(printf '%s' "$ts_line" | awk '{print $2}')" = THROTTLING ] && throttling=yes
fi

# if we cannot read our own die temp AND have no throttle signal → cannot assess
if [ -z "$node_c" ] && [ "$throttling" = no ]; then
  reason="node die temperature unreadable (no thermal_zone AND no hwmon temp, no throttle state) — cannot assess heat"
  ts="$(date -u +%FT%TZ 2>/dev/null || echo "$NOW")"
  printf 'CANNOT-ASSESS | %s | %s\n' "$reason" "$ts" > "$STATE"
  if [ "${1:-}" = "--json" ]; then
    printf '{"verdict":"CANNOT-ASSESS","partial":1,"node_c":null,"node_label":"na","node_src":"na","node_tier":"na","node_thr_c":null,"node_thr_src":"na","cpu_c":null,"disk_c":null,"hot_tier":"na","hot_label":"na","hot_src":"na","hot_c":null,"hot_thr_c":null,"throttling":"%s","env_c":null,"env_signal":"UNKNOWN","peer":"UNKNOWN","peer_signal":"UNKNOWN","reason":"%s","ts":"%s"}\n' "$throttling" "$reason" "$ts"
  else
    printf 'CANNOT-ASSESS — %s\n' "$reason"
  fi
  exit 2
fi

# HOT = some sensor crossed ITS OWN tier line (never one tier's number applied to another's part)
node_hot=0
[ -n "$hot_c" ] && node_hot=1
if [ "$throttling" = yes ] && [ "$node_hot" -eq 0 ]; then
  node_hot=1; hot_tier=cpu; hot_label=throttling; hot_src="cpu-throttle.state"; hot_c="${node_c:-?}"; hot_thr="$HOT_C"
fi

# ---- read_fresh <file> — echo first line if fresh, else empty (UNKNOWN caller-side) --------------
read_fresh() {
  local f="$1" mt
  [ -r "$f" ] || return 1
  mt="$(stat -c %Y "$f" 2>/dev/null || echo 0)"
  [ $(( NOW - mt )) -le "$FRESH_S" ] || return 1
  head -n1 "$f" 2>/dev/null
}

# ---- ENVIRONMENT leg: outdoor temp from .climate-state ------------------------------------------
env_c=""; env_signal=UNKNOWN
if [ -n "${MESH_HEAT_ENV_C:-}" ]; then
  env_c="$MESH_HEAT_ENV_C"
else
  cl="$(read_fresh "$M/.climate-state" || true)"
  [ -n "$cl" ] && env_c="$(printf '%s' "$cl" | grep -oE 'out_c=-?[0-9.]+' | head -1 | cut -d= -f2)"
fi
if [ -n "$env_c" ]; then
  # integer compare on the whole-degree part (avoid float in shell)
  ei="${env_c%%.*}"; [ -z "$ei" ] && ei=0
  case "$ei" in ''|*[!0-9-]*) env_signal=UNKNOWN;; *)
    if [ "$ei" -ge "$ENV_HOT_C" ]; then env_signal=HOT; else env_signal=MILD; fi ;;
  esac
fi

# ---- PEER leg: a second node's thermal state (imac-therm.state) ----------------------------------
peer=UNKNOWN; peer_signal=UNKNOWN
if [ -n "${MESH_HEAT_PEER_SIGNAL:-}" ]; then
  peer_signal="$MESH_HEAT_PEER_SIGNAL"; peer="${MESH_HEAT_PEER:-override}"
else
  pl="$(read_fresh "$M/imac-therm.state" || true)"
  if [ -n "$pl" ]; then
    peer=imac
    # label after the [imac-therm] tag: NOMINAL/OK/COOL → COOL; HOT/THROTTL/CRIT → HOT
    plab="$(printf '%s' "$pl" | grep -oE '\] *[A-Z-]+' | head -1 | tr -d '] ')"
    case "$plab" in
      HOT|THROTTLING|CRIT*|HIGH|WARM) peer_signal=HOT ;;
      NOMINAL|OK|COOL|IDLE|CALM)      peer_signal=COOL ;;
      *)                              peer_signal=UNKNOWN ;;
    esac
  fi
fi

# ---- fold -----------------------------------------------------------------------------------------
read verdict partial <<<"$(attribute "$node_hot" "$env_signal" "$peer_signal")"

nc_disp="${node_c:-?}"; ec_disp="${env_c:-?}"
partial_tag=""; [ "$partial" -eq 1 ] && partial_tag=" (partial)"

# per-tier maxima render `na` when that tier has NO sensor — never 0, which is a temperature
# [[a-summary-line-asserts-legs-that-rendered-na]]
cpu_disp="${cpu_c:-na}"; disk_disp="${disk_c:-na}"
thr_disp="${node_thr:-?}"
# the attribution that must accompany every number: WHAT won, on WHICH organ, against WHOSE line
attrib="argmax=${nc_disp}°C ${node_label}@${node_src} [${node_tier} tier, line ${thr_disp}°C via ${node_thr_src}]; cpu=${cpu_disp}°C disk=${disk_disp}°C"
crossed="${hot_label}@${hot_src} ${hot_c:-?}°C >= ${hot_thr:-?}°C (${hot_tier} tier)"

# reason line — names each UNKNOWN axis so a degraded read is visibly distinct from a calm one
unknowns=""
[ "$env_signal" = UNKNOWN ]  && unknowns="${unknowns} env(no fresh climate out_c)"
[ "$peer_signal" = UNKNOWN ] && unknowns="${unknowns} peer(no fresh imac-therm)"
case "$verdict" in
  COOL)          reason="no sensor over its own tier line and not throttling — not hot (${attrib})" ;;
  ENVIRONMENTAL) reason="node HOT via ${crossed} (throttling=${throttling}) AND heat bath is warm (env=${ec_disp}°C/${env_signal}, peer ${peer}=${peer_signal}) — shedding load here is low-leverage; cool the room / relocate to a cooler node [${attrib}]" ;;
  WORKLOAD)      reason="node HOT via ${crossed} (throttling=${throttling}) but ambient is fine (env=${ec_disp}°C/${env_signal}, peer ${peer}=${peer_signal}) — heat is this node's own load; shed/throttle HERE [${attrib}]" ;;
  UNATTRIBUTED)  reason="node HOT via ${crossed} (throttling=${throttling}) but both context legs blind —${unknowns:- both unknown}; cannot attribute cause [${attrib}]" ;;
esac
[ -n "$unknowns" ] && [ "$verdict" != UNATTRIBUTED ] && reason="${reason} [UNKNOWN:${unknowns} ]"

ts="$(date -u +%FT%TZ 2>/dev/null || echo "$NOW")"

# persist (unconditionally every run → mtime always fresh, no change-gate false-STALE)
printf '%s%s | node=%s°C(%s@%s/%s tier, line %s°C %s) cpu=%s°C disk=%s°C throttling=%s | env=%s°C/%s | peer=%s/%s | %s\n' \
  "$verdict" "$partial_tag" "$nc_disp" "$node_label" "$node_src" "$node_tier" "$thr_disp" "$node_thr_src" \
  "$cpu_disp" "$disk_disp" "$throttling" "$ec_disp" "$env_signal" "$peer" "$peer_signal" "$ts" > "$STATE"

if [ "${1:-}" = "--json" ]; then
  jnc="${node_c:-null}"; jec="${env_c:-null}"
  jcpu="${cpu_c:-null}"; jdisk="${disk_c:-null}"; jthr="${node_thr:-null}"
  jhc="${hot_c:-null}"; jht="${hot_thr:-null}"
  case "$jhc" in ''|*[!0-9-]*) jhc=null ;; esac
  printf '{"verdict":"%s","partial":%s,"node_c":%s,"node_label":"%s","node_src":"%s","node_tier":"%s","node_thr_c":%s,"node_thr_src":"%s","cpu_c":%s,"disk_c":%s,"hot_tier":"%s","hot_label":"%s","hot_src":"%s","hot_c":%s,"hot_thr_c":%s,"throttling":"%s","env_c":%s,"env_signal":"%s","peer":"%s","peer_signal":"%s","reason":"%s","ts":"%s"}\n' \
    "$verdict" "$partial" "$jnc" "$node_label" "$node_src" "$node_tier" "$jthr" "$node_thr_src" \
    "$jcpu" "$jdisk" "$hot_tier" "$hot_label" "$hot_src" "$jhc" "$jht" \
    "$throttling" "$jec" "$env_signal" "$peer" "$peer_signal" "$reason" "$ts"
  exit 0
fi

if [ "${1:-}" = "--edge" ]; then
  prev_f="$M/.heat-source.verdict"
  prev="$(cat "$prev_f" 2>/dev/null || true)"
  printf '%s' "$verdict" > "$prev_f"
  [ "$verdict" = "$prev" ] && exit 0     # no change → silent
  printf '[heat-source] %s%s — %s\n' "$verdict" "$partial_tag" "$reason"
  exit 0
fi

printf '%s%s — %s\n' "$verdict" "$partial_tag" "$reason"
