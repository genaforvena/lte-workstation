#!/usr/bin/env bash
# mesh-ss-config — generate Shadowsocks client config for the phone LTE bypass
# Operator needs: "самая простая обходилка блокировок для телефона на lte"
# phaedra runs ss-server on 38.49.216.141:443 (chacha20-ietf-poly1305, TCP+UDP).
# WireGuard traffic through SS tunnel bypasses MTS DPI (which drops WG UDP on LTE).
#
# Outputs the ss:// URI for importing into Shadowsocks/v2rayNG clients on the phone.
#   --qr         Generate a QR code (requires qrencode)
#   --json       Machine-readable JSON with full config
#   --push       Push the config to the phone over ADB (when phone is reachable)
#   --test       Smoke-test: check phaedra reachable + SS port open + config readable
#
# reflex-cadence: 0 */6 * * * (every 6 hours — config rarely changes; leading 0, not *, or it fires every minute for 4h)
# reflex-args: --test

PHAEDRA="${MESH_SS_NODE:-phaedra}"
SS_HOST="${MESH_SS_HOST:-38.49.216.141}"
SS_PORT="${MESH_SS_PORT:-443}"

TESTS_PASSED=0; TESTS_FAILED=0
test_ok(){ TESTS_PASSED=$((TESTS_PASSED+1)); echo "  ok: $1"; }
test_fail(){ TESTS_FAILED=$((TESTS_FAILED+1)); echo "  FAIL: $1"; }
json_escape(){ printf '%s' "$1" | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read().strip()))' 2>/dev/null || printf '"%s"' "$1"; }

do_test(){
  command -v ssh >/dev/null 2>&1 && test_ok "ssh present" || test_fail "ssh missing"
  ssh -o StrictHostKeyChecking=no -o ConnectTimeout=5 "$PHAEDRA" "ss -tlnp 2>/dev/null | grep -q :443" 2>/dev/null && test_ok "phaedra SS port 443 listening" || test_fail "phaedra SS port 443 not listening"
  local conf; conf=$(timeout 10 ssh -o StrictHostKeyChecking=no -o ConnectTimeout=5 "$PHAEDRA" "cat /var/lib/shadowsocks-libev/config.json" 2>/dev/null) || { test_fail "cannot read SS config on phaedra"; echo "smoke-test: FAIL"; exit 1; }
  printf '%s' "$conf" | grep -q '"server_port"' && test_ok "SS config has server_port" || test_fail "SS config missing server_port"
  printf '%s' "$conf" | grep -q '"password"' && test_ok "SS config has password" || test_fail "SS config missing password"
  printf '%s' "$conf" | grep -q '"method"' && test_ok "SS config has method" || test_fail "SS config missing method"
  if [ $TESTS_FAILED -gt 0 ]; then echo "smoke-test: FAIL"; exit 1; fi
  echo "smoke-test: ok"
  exit 0
}

QR_MODE=0; JSON_MODE=0; PUSH_MODE=0; WATCH_MODE=0
while [ $# -gt 0 ]; do
  case "$1" in
    --qr) QR_MODE=1; shift;;
    --json) JSON_MODE=1; shift;;
    --push) PUSH_MODE=1; shift;;
    --watch) WATCH_MODE=1; shift;;
    --test) do_test;;
    *) echo "usage: $0 [--qr] [--json] [--push] [--watch] [--test]"; exit 1;;
  esac
done

# Read config from phaedra
CONF=$(timeout 15 ssh -o StrictHostKeyChecking=no -o ConnectTimeout=5 "$PHAEDRA" "cat /var/lib/shadowsocks-libev/config.json" 2>/dev/null) || {
  echo "mesh-ss-config: cannot read SS config from ${PHAEDRA}" >&2; exit 2
}

PASSWORD=$(printf '%s' "$CONF" | sed -n 's/.*"password"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
METHOD=$(printf '%s' "$CONF" | sed -n 's/.*"method"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
SPORT=$(printf '%s' "$CONF" | sed -n 's/.*"server_port"[[:space:]]*:[[:space:]]*\([0-9]*\).*/\1/p')
[ -z "$SPORT" ] && SPORT="$SS_PORT"

# Generate SS URI
SS_URI="ss://$(printf '%s' "${METHOD}:${PASSWORD}" | base64 -w0 | tr '+/' '-_' | tr -d '=')@${SS_HOST}:${SPORT}#mesh-lte-bypass"

if [ "$JSON_MODE" = 1 ]; then
  cat <<JSONEOF
{
  "ss_uri":$(json_escape "$SS_URI"),
  "host":"${SS_HOST}",
  "port":${SPORT},
  "method":"${METHOD}",
  "password":$(json_escape "$PASSWORD"),
  "label":"mesh-lte-bypass",
  "notes":"Shadowsocks tunnel for WG bypass on LTE (MTS DPI blocks WG UDP)"
}
JSONEOF
elif [ "$QR_MODE" = 1 ]; then
  if command -v qrencode >/dev/null 2>&1; then
    echo "$SS_URI" | qrencode -t UTF8 2>/dev/null || {
      echo "mesh-ss-config: qrencode failed — URI below:" >&2
      echo "$SS_URI"
    }
  else
    echo "mesh-ss-config: qrencode not installed. Install it or scan the URI directly:" >&2
    echo "  pkg install qrencode          # Termux" >&2
    echo "  sudo apt install qrencode     # Debian/Ubuntu" >&2
    echo "  brew install qrencode         # macOS" >&2
    echo "URI for manual QR generator:" >&2
    echo "$SS_URI"
  fi
  echo "  Or scan this URI directly from a QR generator app on your phone:" >&2
  echo "  $SS_URI"
elif [ "$WATCH_MODE" = 1 ]; then
  # Poll phaedra for new SS client connections — detects operator phone connecting
  echo "mesh-ss-config --watch :: monitoring SS connections on ${SS_HOST}:${SPORT}"
  echo "  (Ctrl+C to stop)"
  known=""
  while :; do
    current=$(ssh -o StrictHostKeyChecking=no -o ConnectTimeout=5 "$PHAEDRA" "
      ss -tnp 2>/dev/null | grep ':443 ' | grep ESTAB | awk '{print \$4\" \"\$5}'
    " 2>/dev/null)
    if [ "$current" != "$known" ]; then
      [ -n "$known" ] && echo "--- $(date -u +%H:%M:%S) ---"
      echo "$current"
      known="$current"
    fi
    sleep 10
  done
elif [ "$PUSH_MODE" = 1 ]; then
  echo "mesh-ss-config: --push needs ADB-enabled phone. Not yet implemented."
  echo "Install manually with:"
  echo "  $0 --qr   (to scan with phone)"
  echo "  Or enter config: ${SS_HOST}:${SPORT} / ${METHOD} / password from --json"
  exit 2
else
  active=$(timeout 5 ssh -o StrictHostKeyChecking=no -o ConnectTimeout=5 "$PHAEDRA" "ss -tnp 2>/dev/null | grep ':443 ' | grep ESTAB | wc -l" 2>/dev/null || echo "?")
  echo "mesh-ss-config :: Shadowsocks config for LTE bypass (${active} active conn(s))"
  echo "  URI:   ${SS_URI}"
  echo "  Host:  ${SS_HOST}:${SPORT}"
  echo "  Method: ${METHOD}"
  echo "  —"
  echo "  Phone: install v2rayNG/Shadowsocks → paste URI → enable VPN"
  echo "  Watch: $0 --watch  (live monitor for new connections)"
fi