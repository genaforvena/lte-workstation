#!/usr/bin/env bash
# mesh-wifi-newap — RF-neighbor CHANGE sense: detect foreign WiFi APs APPEARING / VANISHING in radio
# range (a neighbour's new router or hotspot, a nearby phone tethering, a portable device arriving) —
# the wireless-broadcast analogue of mesh-lan-newdevice, which only sees devices already ON our LAN.
# The raw AP count is already sensed (mesh-wifiscan); this derives the CHURN (set membership change),
# which a stable count hides — 30 APs last scan and 30 now can still be 2 in, 2 out.
#
# HONEST-DEGRADED: a scan that cannot run (nmcli absent / wifi radio off / scan error) exits 2 — it is
# NEVER reported as "no new APs" (a faked all-clear). "STABLE" is emitted only when a real scan ran and
# genuinely matched the prior set; the first ever run records a BASELINE, not a fake "+0 new".
#
#   mesh-wifi-newap            one read: AP count + new/gone vs last scan + 2.4/5GHz split
#   mesh-wifi-newap --log      also append a tape line to ~/.mesh/wifi-newap.log
#   mesh-wifi-newap --test     smoke test (deps + band classifier)
# reflex-cadence: none   # on-demand: RF-neighbour churn is operator-pulled (see On-demand canon)
# orphan-ok: on-demand RF-neighbour-churn query, operator-pulled — not a scheduled reflex
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
MESH="$HOME/.mesh"; mkdir -p "$MESH"
BASE="$MESH/.wifi-ap-baseline"; LOG="$MESH/wifi-newap.log"
HOST="$(hostname)"

# band_of <chan> → 2.4 | 5 | ? . WiFi channels 1-14 are 2.4GHz; higher are 5GHz (6GHz omitted: rare here
# and indistinguishable by channel number alone). Non-numeric / empty → ? (honest unknown, never guessed).
band_of(){ case "${1:-}" in ''|*[!0-9]*) echo '?';; *) { [ "$1" -ge 1 ] && [ "$1" -le 14 ]; } 2>/dev/null && echo 2.4 || echo 5;; esac; }

if [ "${1:-}" = --test ]; then
  # Logic assertions FIRST — band_of needs no radio and must hold on every node; a dep gate above
  # them would skip the real assertions exactly where they're cheapest to run.
  command -v comm  >/dev/null 2>&1 || { echo "smoke-test: FAIL (no comm)"; exit 1; }
  _f=0
  [ "$(band_of 6)"   = 2.4 ] || { echo "  FAIL: chan 6 → 2.4";   _f=1; }
  [ "$(band_of 11)"  = 2.4 ] || { echo "  FAIL: chan 11 → 2.4";  _f=1; }
  [ "$(band_of 14)"  = 2.4 ] || { echo "  FAIL: chan 14 → 2.4";  _f=1; }
  [ "$(band_of 36)"  = 5   ] || { echo "  FAIL: chan 36 → 5";    _f=1; }
  [ "$(band_of 149)" = 5   ] || { echo "  FAIL: chan 149 → 5";   _f=1; }
  [ "$(band_of '')"  = '?' ] || { echo "  FAIL: empty chan → ?"; _f=1; }
  [ "$(band_of xx)"  = '?' ] || { echo "  FAIL: non-numeric → ?"; _f=1; }
  [ "$_f" = 0 ] || { echo "smoke-test: FAIL"; exit 1; }
  # nmcli is the node-bound organ: absent = this node cannot carry the sense at all (e.g. mesh-home
  # runs iw, no NetworkManager) — honest n/a (exit 2), same claim the runtime gate below makes.
  command -v nmcli >/dev/null 2>&1 || { echo "smoke-test: n/a (no nmcli — node has no NetworkManager; wifi churn sense unreachable here; band_of:7 asserted)"; exit 2; }
  echo "smoke-test: ok (nmcli+comm ready + band_of:7 assertions)"
  exit 0
fi

LOGIT=0; [ "${1:-}" = --log ] && LOGIT=1
ts="$(date -u +%FT%TZ)"

# HONEST unreachable gate — never fake an empty RF field when the radio cannot answer.
command -v nmcli >/dev/null 2>&1 || { echo "mesh-wifi-newap: nmcli absent — wifi sense unreachable" >&2; exit 2; }
nmcli -t -f WIFI radio 2>/dev/null | grep -q '^enabled$' || { echo "mesh-wifi-newap: wifi radio disabled/absent — sense unreachable" >&2; exit 2; }

# Blocking rescan: nmcli's scan is async, so a warm-cache list can race a stale snapshot (see memory
# nmcli-rescan-async-race) — --rescan yes makes it block on a fresh scan. Capture rc to tell a FAILED
# scan from a genuinely sparse field.
raw="$(nmcli -t -f BSSID,SSID,CHAN,SIGNAL dev wifi list --rescan yes 2>/dev/null)"; rc=$?
[ "$rc" -eq 0 ] || { echo "mesh-wifi-newap: wifi scan failed (nmcli rc=$rc) — sense unreachable, NOT an empty RF field" >&2; exit 2; }

# nmcli -t escapes literal colons in the BSSID as '\:' — swap to a sentinel, split on the real ':'
# field separator, then restore. Fields: 1=BSSID 2=SSID 3=CHAN 4=SIGNAL.
parsed="$(printf '%s\n' "$raw" | sed 's/\\:/§/g' | awk -F: 'NF>=4{b=$1; c=$3; gsub("§",":",b); print b"|"c}')"
curb="$(printf '%s\n' "$parsed" | awk -F'|' 'NF&&$1!=""{print $1}' | sort -u)"
n="$(printf '%s\n' "$curb" | grep -c .)"
b24=$(printf '%s\n' "$parsed" | awk -F'|' '$2>=1&&$2<=14{c++} END{print c+0}')
b5=$( printf '%s\n' "$parsed" | awk -F'|' '$2>14{c++}        END{print c+0}')

if [ -s "$BASE" ]; then
  baseb="$(sort -u "$BASE")"
  newl="$(comm -23 <(printf '%s\n' "$curb") <(printf '%s\n' "$baseb") | grep -c . || true)"
  gone="$(comm -13 <(printf '%s\n' "$curb") <(printf '%s\n' "$baseb") | grep -c . || true)"
  newlist="$(comm -23 <(printf '%s\n' "$curb") <(printf '%s\n' "$baseb") | paste -sd, -)"
  if [ "$newl" -eq 0 ] && [ "$gone" -eq 0 ]; then
    verdict="STABLE: same $n AP(s) as last scan"
  else
    verdict="CHURN: +$newl new / -$gone gone vs last scan"
  fi
else
  newl=0; gone=0; newlist=""
  verdict="BASELINE: first scan, $n AP(s) recorded (no prior set to diff)"
fi

printf '%s\n' "$curb" > "$BASE"
echo "=== mesh-wifi-newap $HOST @ $ts — $n AP(s) [2.4GHz:$b24 5GHz:$b5] — $verdict ==="
[ -n "${newlist:-}" ] && echo "new: $newlist"
[ "$LOGIT" = 1 ] && echo "$ts $HOST n=$n new=$newl gone=$gone" >> "$LOG"
exit 0
