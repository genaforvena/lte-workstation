#!/usr/bin/env bash
# reflex-cadence: 3-59/10 * * * *
# reflex-args: --edge
# mesh-psi — the node's RESOURCE-CONTENTION sense (Pressure Stall Information). Reads the kernel's
# /proc/pressure/{cpu,io,memory} — the % of wallclock time tasks were STALLED waiting on each
# resource — and folds it into one CALM/BUSY/STALLED level naming the DOMINANT resource.
#
# Why this is a new sense, not a dup of mesh-stress: mesh-stress reads /proc/loadavg, which CONFLATES
# cause — a load of 5 could be cpu-bound, io-bound, or memory-thrashing, and load counts uninterruptible
# io-wait the same as runnable cpu demand. PSI is what tasks ACTUALLY experience: `some` = ≥1 task
# stalled, `full` = EVERY non-idle task stalled (nothing progresses). It tells you not just "busy" but
# "busy ON WHAT" — the diagnostic mesh-stress is blind to (e.g. this node idles cpu-cool yet sits
# io-stalled ~half the time, which load average hides inside a normal-looking number).
#
#   mesh-psi            one line: level + dominant resource + the three readings
#   mesh-psi --json     machine-readable
#   mesh-psi --edge     emit only on level change (rolling 3-tick debounce) — board reflex
#   mesh-psi --test     smoke test (pure, no /proc read before the gate)
#
# Levels (per resource, worst wins; tunable via env):
#   CALM    = no meaningful stall
#   BUSY    = some-pressure ≥ MESH_PSI_SOME_BUSY (25) or any full pressure — contention, work still flows
#   STALLED = full ≥ MESH_PSI_FULL_STALL (10) or some ≥ MESH_PSI_SOME_STALL (60) — real stalling
# Memory `full` pressure is treated as extra-serious (thrashing): any mem full ≥5 → STALLED.
#
# PHANTOM-IO QUARANTINE (2026-07-03): kernel io-PSI counts iowait-PARKED sleepers as io-stalled —
# a thread idling in io_uring's io_cqring_wait accrues "full" io pressure while doing ZERO disk I/O
# (observed live: ghostty's renderer+io threads pinned /proc/pressure/io full≈68-76% for 2 weeks on
# an IDLE disk, ios_in_progress=0 → the tape's psi column read STALLED 300/300 rows = zero information).
# So when the io axis alone would raise the level, corroborate against REAL disk utilization
# (io_ticks delta over a short window): io-PSI high + disks near-idle = phantom → the io axis is
# QUARANTINED (excluded, loudly annotated), never trusted into a false STALLED. High io-PSI WITH real
# disk busy% passes through untouched. Tunables: MESH_PSI_UTIL_MIN (busy% floor, default 10),
# MESH_PSI_UTIL_WINDOW_MS (sample window, default 500), MESH_PSI_DISKUTIL (test override).
#
# Honest-degraded: a kernel built without CONFIG_PSI has no /proc/pressure → UNAVAILABLE + exit 2,
# never a faked CALM. (VMs/older kernels may lack it; that is reported, not hidden.)
set -uo pipefail
{ "$HOME/.local/bin/mesh-pulse" beat psi; } >/dev/null 2>&1 || true  # liveness heartbeat (mesh-pulse): edge reflex is silent-on-no-news → needs an explicit per-run pulse

# MESH_PSI_STATE exists so --test can drive the --edge state machine into a scratch file. A test that
# ran the real edge path would rewrite .psi.state/.psi.pending — the artifact mesh-reflex-health reads
# for liveness — i.e. it would FORGE the evidence it exists to check (the mesh-guardian trap).
STATE="${MESH_PSI_STATE:-${HOME:-/root}/.mesh/.psi.state}"
SOME_BUSY="${MESH_PSI_SOME_BUSY:-25}"
SOME_STALL="${MESH_PSI_SOME_STALL:-60}"
FULL_STALL="${MESH_PSI_FULL_STALL:-10}"
MEM_FULL_STALL="${MESH_PSI_MEM_FULL_STALL:-5}"
UTIL_MIN="${MESH_PSI_UTIL_MIN:-10}"
MIN_DT="${MESH_PSI_MIN_DT:-60}"   # an interval average below this is noise, not a window → n/a

# ── SAMPLING ALIASING: avg10 read once per 600s sees 1.7% of wallclock (2026-08-14) ──
# The reflex fires every 10 minutes and read ONLY avg10 — a 10-second decaying window. Coverage is
# therefore ~10/600 = 1.7% of the timeline, and the --edge debounce COMPOUNDS it: the same non-CALM
# level must land on TWO CONSECUTIVE ticks, so a burst shorter than ~20 minutes essentially cannot
# raise the level at all. That is not a hypothetical: measured live, `.psi.state` read CALM for 14.2
# days (2026-07-31→08-14) on a node whose bursty real workload — three llama-servers, whisper, the
# grinder — had it at `cpu some avg10=78%, STALLED` the moment a human looked. The band was never
# dead (it fired on 07-31 and re-fires on demand); the sense was simply looking 1.7% of the time and
# its CALM was being read as a claim about the node.
#
# ── AND THE DEBOUNCE OUTLIVED THAT FIX (2026-08-18) ──
# Widening the window (above) made every tick a 100%-coverage reading, but the commit rule on top of
# it still demanded TWO CONSECUTIVE ticks of the SAME level. A node whose 600s interval means
# alternate — this one, where the reflex fleet's own io bursts land in every other window — never
# supplies that, so `.psi.state` froze at CALM for 42.3h while `.psi.pending` cycled `BUSY:1` and was
# reset each tick. Both failures publish an honest, live, mtime-fresh CALM; only the rule that turns
# ticks into a committed value differs. The general shape: a debounce phrased as "N CONSECUTIVE" has
# an input sequence it can never accept, and on that sequence it does not degrade — it silently
# republishes the last value forever. Phrase it as a majority over a BOUNDED window instead, where a
# verdict is always reachable, and log the ticks it holds back (see the edge block at the foot).
#
# The kernel already publishes the un-aliased quantity: `total=` on each some/full line is a
# MONOTONIC accumulator of microseconds stalled since boot. A delta between two ticks covers 100% of
# the interval with zero aliasing — no cadence change, no extra sampling cost. So each axis now
# carries TWO windows: `inst` (avg10, catches a sharp spike happening right now, which a 600s mean
# dilutes to nothing) and `iv` (the total-delta interval mean, catches everything between ticks).
# They answer different questions, so the fold is a max that NAMES its winner — a bare max would
# efface the disjunction and the report could no longer say which window saw it.
#
# First sight, a sub-MIN_DT gap, and a counter reset (reboot → cur < prev) all render the iv axis
# `na` — never 0, which would be a faked calm from missing evidence. `na` folds to inst alone, i.e.
# exactly the pre-2026-08-14 behaviour, so a store-less run degrades to the old sense rather than lying.
TOTALS_DEFAULT="${HOME:-/root}/.mesh/.psi.totals"

# ── mech= : the MECHANISM of the stall (mesh-wchan, kernel wchan symbols) ──────────────────────
# PSI says HOW MUCH tasks stalled and this file's who= says WHOSE cgroup; neither says on WHAT
# KERNEL PATH. mesh-wchan samples /proc/*/task/*/wchan and names it (rq_qos_wait = block-layer
# throttling, folio_wait_bit_common = page/writeback, __wait_on_buffer = metadata read). The
# citation is quoted VERBATIM and is emphatically NOT a severity: mesh-wchan has no level by
# construction, occupancy is not badness, and `mech` never enters classify() — a gate below
# injects a maximal mechanism reading and asserts level+dominant are bitwise unchanged, because
# a consumer deriving severity from occupancy re-introduces exactly what that sense refused.
#
# READ THE LOG, NEVER INVOKE THE PRODUCER: `mesh-wchan --mech` costs a 30s poll, and this sense
# fires every 10 minutes — a consumer that polls its producer makes the citation the dominant
# cost of the tick and, worse, measures a DIFFERENT 30s than the reading it is annotating.
#
# The mask travels with the value on purpose. wchan is readable only for our OWN processes
# (PTRACE_MODE_READ), so ~22% of threads on this node are structurally invisible and a root-owned
# culprit cannot appear at all; a mechanism quoted without masked= reads a partial census as the
# whole node. So does the coverage token: mesh-wchan samples ~5% of its own cadence, so `io-throttle`
# means "top mechanism in the sampled window", never "the node is io-throttled".
WCHAN_LOG="${MESH_PSI_WCHAN_LOG:-${HOME:-/root}/.mesh/wchan.log}"

# 2x the live cron stride of the PRODUCER, derived from the crontab rather than written as a
# literal — the one self-derived cut-point idiom in this genome (mesh-node-health cron_stale_s,
# mesh-window-state wifi_stale_s). A literal here would silently drift the day mesh-wchan's
# cadence changes, and the failure is invisible: the lease keeps passing, just for the wrong
# window. The fallback is GENEROUS, not zero — an unreadable crontab (non-cron env, a test) must
# not shrink the lease and manufacture a false `stale` out of missing evidence.
wchan_stale_s() {
  local stride
  stride="$(crontab -l 2>/dev/null | grep -m1 -E '^[^#]*mesh-wchan([[:space:]]|$)' | awk '{print $1}' \
            | grep -oE '/[0-9]+$' | tr -d '/')"
  if [ -n "$stride" ] && [ "$stride" -gt 0 ] 2>/dev/null; then echo $((stride * 60 * 2)); else echo 1800; fi
}

# read_mech [lease_s] → one token, or an honest na. Missing producer, missing line, unparseable
# timestamp and an expired lease each render `na (<why>)` — never a blank and never a bare kind,
# both of which a reader folds into "no mechanism" i.e. a fabricated innocence. A STALE reading
# still NAMES its value inside the na, so the information is not thrown away, only disqualified.
read_mech() {
  # Read the path at CALL time. WCHAN_LOG is a load-time global, so a `MESH_PSI_WCHAN_LOG=… read_mech`
  # prefix would NOT rebind it and every fixture below would silently read the LIVE log instead —
  # the identical export-does-not-rebind trap interval_pct carries for MIN_DT. Caught by the gate on
  # its first run (the mech asserts came back quoting this node's real 0.20 thr/sample, not 0.28).
  local lease="${1:-$(wchan_stale_s)}" line ts tsep now age kind occ seen masked cover
  local log="${MESH_PSI_WCHAN_LOG:-$WCHAN_LOG}"
  [ -s "$log" ] \
    && line="$(grep -a '\[wchan\] mechanism=' "$log" 2>/dev/null | tail -1)" || line=""
  if [ ! -s "$log" ]; then
    printf 'na (mesh-wchan has logged nothing — the stall has no mechanism)'; return
  fi
  [ -n "$line" ] || { printf 'na (no mechanism line in %s)' "$log"; return; }
  ts="$(printf '%s' "$line" | awk '{print $1}')"
  tsep="$(date -d "$ts" +%s 2>/dev/null || true)"
  case "$tsep" in ''|*[!0-9]*) printf 'na (unparseable wchan timestamp %s)' "$ts"; return;; esac
  now="$(date +%s)"; age=$(( now - tsep ))
  [ "$age" -ge 0 ] || age=0
  kind="$(printf '%s' "$line"   | grep -oE 'mechanism=[^ ]+' | head -1 | cut -d= -f2-)"
  occ="$(printf '%s' "$line"    | sed -n 's/.*mechanism=[^ ]* \([0-9.]*\) thr\/sample.*/\1/p')"
  seen="$(printf '%s' "$line"   | sed -n 's/.*seen in \([0-9]*\)% of samples.*/\1/p')"
  masked="$(printf '%s' "$line" | sed -n 's/.*masked=[0-9]* (\([0-9.]*\)%).*/\1/p')"
  cover="$(printf '%s' "$line"  | sed -n 's/.*= \([0-9.]*\)% of the [0-9]*s cadence sampled.*/\1/p')"
  if [ "$age" -gt "$lease" ]; then
    printf 'na (stale: last mechanism %s is %ss old > lease %ss — a stale mechanism is not a current one)' \
      "${kind:-?}" "$age" "$lease"
    return
  fi
  # `?` MUST MEAN "I COULD NOT READ IT", NEVER "THERE IS NOTHING THERE". mesh-wchan emits two line
  # SHAPES: a named mechanism carries `<occ> thr/sample, seen in <n>% of samples`; a `none-*` kind
  # carries neither, because nothing was caught waiting and there is no occupancy to quantify. Run
  # both through one format and the empty case renders `mech=none-resource-kind ? thr/sample seen=?%`
  # — which reads as a BROKEN PARSER and sends the reader to debug a producer that is working. So
  # branch on the kind: absence-by-definition says so in words; a missing field on a line that DID
  # name a resource stays a loud `?`, because there it is exactly what it looks like — the parser
  # out of sync with the producer's format. (Same shape as na-must-be-a-claim-about-the-node.)
  case "$kind" in
    none-*) printf '%s (no occupancy — no thread caught waiting) masked=%s%% cover=%s%% age=%ss' \
              "$kind" "${masked:-?}" "${cover:-?}" "$age"; return;;
  esac
  printf '%s %s thr/sample seen=%s%% masked=%s%% cover=%s%% age=%ss' \
    "${kind:-?}" "${occ:-?}" "${seen:-?}" "${masked:-?}" "${cover:-?}" "$age"
}

# Pure classifier — no I/O, no /proc read. args: cpu_some cpu_full io_some io_full mem_some mem_full
# echoes "LEVEL|dominant"
classify() {
  awk -v cs="$1" -v cf="$2" -v ios="$3" -v iof="$4" -v ms="$5" -v mf="$6" \
      -v sb="$SOME_BUSY" -v ss="$SOME_STALL" -v fs="$FULL_STALL" -v mfs="$MEM_FULL_STALL" '
    function lvl(some, full) {
      if (full >= fs || some >= ss) return 3;   # STALLED
      if (full >= 1  || some >= sb) return 2;    # BUSY
      return 1;                                  # CALM
    }
    BEGIN {
      cl = lvl(cs, cf); il = lvl(ios, iof); ml = lvl(ms, mf);
      if (mf >= mfs && ml < 3) ml = 3;           # memory full pressure = thrashing, extra-serious
      worst = cl; dom = "cpu"; domsome = cs + 0;
      if (il > worst || (il == worst && (ios + 0) > domsome)) { worst = il; dom = "io"; domsome = ios + 0 }
      if (ml > worst || (ml == worst && (ms + 0) > domsome)) { worst = ml; dom = "memory"; domsome = ms + 0 }
      name = (worst == 3 ? "STALLED" : worst == 2 ? "BUSY" : "CALM");
      printf "%s|%s", name, dom;
    }'
}

# Pure quarantine decision — no I/O. args: io_some io_full disk_util_pct
# true (0) = io axis is PHANTOM (would influence the level, yet disks are near-idle) → quarantine.
io_phantom() {
  awk -v ios="$1" -v iof="$2" -v u="$3" -v sb="$SOME_BUSY" -v um="$UTIL_MIN" \
    'BEGIN { exit !((iof >= 1 || ios >= sb) && u < um) }'
}

# % of wall time the real disks were busy over a short window (io_ticks delta, /proc/diskstats $13).
# Summed across physical top-level devices (partitions/loop excluded); can exceed 100 with >1 disk —
# fine, it is only compared against a floor. MESH_PSI_DISKUTIL overrides for tests (no sleep).
disk_util_pct() {
  if [ -n "${MESH_PSI_DISKUTIL:-}" ]; then printf '%s' "$MESH_PSI_DISKUTIL"; return 0; fi
  local w="${MESH_PSI_UTIL_WINDOW_MS:-500}" a b
  a=$(awk '$3 ~ /^(nvme[0-9]+n[0-9]+|sd[a-z]+|vd[a-z]+|mmcblk[0-9]+)$/ {s+=$13} END{print s+0}' /proc/diskstats 2>/dev/null)
  sleep "$(awk -v w="$w" 'BEGIN{printf "%.3f", w/1000}')"
  b=$(awk '$3 ~ /^(nvme[0-9]+n[0-9]+|sd[a-z]+|vd[a-z]+|mmcblk[0-9]+)$/ {s+=$13} END{print s+0}' /proc/diskstats 2>/dev/null)
  awk -v a="${a:-0}" -v b="${b:-0}" -v w="$w" 'BEGIN{u=(b-a)*100.0/w; if(u<0)u=0; printf "%.0f", u}'
}

# Pure — interval mean from two readings of a monotonic microsecond accumulator.
# args: cur_total_us prev_total_us dt_s → percentage, or `na` when the delta cannot be trusted.
interval_pct() {
  local cur="$1" prev="$2" dt="$3" mindt
  # read the floor at CALL time: MIN_DT is a load-time global, so a `MESH_PSI_MIN_DT=… interval_pct …`
  # prefix would NOT rebind it and the override would silently do nothing (the same export-does-not-
  # rebind trap this file's phantom-io block was written around). Caught by --test, not by reading.
  mindt="${MESH_PSI_MIN_DT:-$MIN_DT}"
  case "$cur"  in ''|*[!0-9]*) echo na; return;; esac
  case "$prev" in ''|*[!0-9]*) echo na; return;; esac   # first sight / torn store
  case "$dt"   in ''|*[!0-9]*) echo na; return;; esac
  [ "$dt" -ge "$mindt" ]   || { echo na; return; }      # too short a window to mean anything
  [ "$cur" -ge "$prev" ]   || { echo na; return; }      # counter went backwards = reboot, not calm
  awk -v c="$cur" -v p="$prev" -v d="$dt" 'BEGIN{ printf "%.2f", (c-p)/(d*1000000)*100 }'
}

# Pure — fold one axis's two windows, NAMING the winner. args: inst iv|na → "<value> inst|iv"
fold_axis() {
  local a="$1" i="$2"
  [ "$i" = na ] && { printf '%s inst' "$a"; return; }
  awk -v a="$a" -v i="$i" 'BEGIN{ if (i+0 > a+0) printf "%s iv", i; else printf "%s inst", a }'
}

if [ "${1:-}" = --test ]; then
  command -v awk >/dev/null 2>&1 || { echo "smoke-test: FAIL (no awk)"; exit 1; }
  fail() { echo "smoke-test: FAIL ($1)"; exit 1; }
  # Pure classify() assertions — falsifiable, no real sensor read.
  [ "$(classify 0 0 0 0 0 0)"     = "CALM|cpu" ]    || fail "all-zero should be CALM"
  [ "$(classify 5 0 65 59 0 0)"   = "STALLED|io" ]  || fail "live io-stall (some65/full59) should be STALLED on io"
  [ "$(classify 30 0 0 0 0 0)"    = "BUSY|cpu" ]    || fail "cpu some=30 should be BUSY on cpu"
  [ "$(classify 70 15 0 0 0 0)"   = "STALLED|cpu" ] || fail "cpu full=15 should be STALLED on cpu"
  [ "$(classify 0 0 0 0 10 8)"    = "STALLED|memory" ] || fail "mem full=8 (thrash) should be STALLED on memory"
  [ "$(classify 60 10 90 50 0 0)" = "STALLED|io" ]  || fail "two stalled, higher some=io should dominate"
  [ "$(classify 24 0 0 0 0 0)"    = "CALM|cpu" ]    || fail "some=24 below BUSY threshold should be CALM"
  [ "$(classify 25 0 0 0 0 0)"    = "BUSY|cpu" ]    || fail "some=25 at BUSY threshold should be BUSY"
  [ "$(classify 0 0 0 0 0 3)"     = "BUSY|memory" ] || fail "mem full=3 (<5) should be BUSY not STALLED"
  # Phantom-io quarantine — pure decision asserts (the ghostty io_cqring_wait case: psi high, disk idle).
  io_phantom 76 68 2    || fail "io 76/68 on 2% disk util should be PHANTOM (quarantine)"
  io_phantom 76 68 50   && fail "io 76/68 on 50% disk util is REAL stall — must NOT quarantine"
  io_phantom 0.5 0.2 2  && fail "non-influential io (0.5/0.2) must not quarantine"
  io_phantom 30 0 2     || fail "io some=30 (BUSY-influential) on idle disk should quarantine"
  [ "$(MESH_PSI_DISKUTIL=42 disk_util_pct)" = 42 ] || fail "disk_util_pct test override broken"
  # ── interval axis (total= deltas) — the 1.7%-coverage aliasing fix ──
  [ "$(interval_pct 6000000 0 60)" = 10.00 ] || fail "6s stall over 60s should be 10.00%"
  [ "$(interval_pct 300000000 0 600)" = 50.00 ] || fail "300s stall over 600s should be 50.00%"
  [ "$(interval_pct 1000 1000 600)" = 0.00 ] || fail "an unmoved counter is a real 0, not na"
  [ "$(interval_pct 5000 100000 600)" = na ] || fail "counter reset (reboot) must be na, never 0 — a faked calm"
  [ "$(interval_pct 5000 '' 600)" = na ]     || fail "first sight (no prev) must be na"
  [ "$(interval_pct 5000 abc 600)" = na ]    || fail "torn/non-numeric store must be na"
  [ "$(interval_pct 5000 100 10)" = na ]     || fail "a sub-MIN_DT window must be na, not a noisy mean"
  [ "$(MESH_PSI_MIN_DT=5 interval_pct 6000000 0 10)" = 60.00 ] || fail "MESH_PSI_MIN_DT override broken"
  # fold: max-that-names-its-winner (a bare max would efface which window saw it)
  [ "$(fold_axis 5 40)"  = "40 iv" ]   || fail "iv 40 > inst 5 → iv must win and be named"
  [ "$(fold_axis 40 5)"  = "40 inst" ] || fail "inst 40 > iv 5 → inst must win"
  [ "$(fold_axis 40 na)" = "40 inst" ] || fail "an na iv axis must degrade to inst alone"
  [ "$(fold_axis 7 7)"   = "7 inst" ]  || fail "a tie must resolve to inst (the sharper window)"
  # THE REGRESSION ITSELF: a burst that ended between ticks. avg10 is calm, the interval mean is not.
  read -r _fv _fw <<<"$(fold_axis 0.14 47.5)"
  [ "$_fw" = iv ] || fail "aliased burst: the iv window must drive the axis"
  [ "$(classify "$_fv" 0 0 0 0 0)" = "BUSY|cpu" ] \
    || fail "aliased burst (avg10=0.14, interval=47.5%) must classify BUSY — this is the 14-day-CALM bug"
  # ── mech= : the mechanism citation (mesh-wchan consumer) ──────────────────────────────────────
  # Fixture lines below are REAL, copied verbatim from ~/.mesh/wchan.log — a hand-simplified line
  # would gate the parser against a format mesh-wchan does not actually emit. RED-first: each
  # assertion was watched fail (drop a sed field → `?`; widen the lease → the stale case renders a
  # live value; delete the na branches → a blank that reads as "no mechanism").
  _wd="$(mktemp -d)"
  _wline='[wchan] mechanism=io-throttle(rq_qos_wait) 0.28 thr/sample, seen in 20% of samples | resource: io-throttle 0.28, wait-bit 0.02 | ambiguous: futex 991.53 | visibility named=82928 masked=23019 (21.7%) running=70 zombie=120 na=0 gone=0 | 60 samples over 29.8s @2.01Hz, sweep 44/116ms mean/max = 5.0% of the 600s cadence sampled | severity is not this sense'"'"'s arm (mesh-psi io); the culprit is root-owned and structurally masked'
  printf '%s %s\n' "$(date -u -d '@'"$(( $(date +%s) - 120 ))" +%Y-%m-%dT%H:%M:%SZ)" "$_wline" > "$_wd/fresh.log"
  _m="$(MESH_PSI_WCHAN_LOG="$_wd/fresh.log" read_mech 1200)"
  case "$_m" in *'io-throttle(rq_qos_wait) 0.28 thr/sample'*) :;; *) fail "mech did not quote kind+occupancy verbatim: $_m";; esac
  case "$_m" in *'seen=20%'*)   :;; *) fail "mech dropped seen= (how much of the window saw it): $_m";; esac
  case "$_m" in *'masked=21.7%'*) :;; *) fail "mech dropped masked= — a mechanism quoted without its blind fraction reads a partial census as the node: $_m";; esac
  case "$_m" in *'cover=5.0%'*) :;; *) fail "mech dropped cover= — 'top mechanism in a 5% sample' is not 'the node is io-throttled': $_m";; esac
  case "$_m" in *'?'*) fail "mech has an unparsed field against a REAL wchan line — the parser is out of sync with the producer: $_m";; esac
  # THE OTHER LINE SHAPE: `none-*` carries no occupancy BY DEFINITION. Verbatim from wchan.log too.
  # Absence-by-definition must never wear the `?` that means "unreadable" — and the discriminating
  # assert is the third one: delete the occupancy from a line that DOES name a resource and `?` must
  # come BACK, or this fix is just a blanket `?`-suppressor that hides a real producer-format drift.
  _wnone='[wchan] mechanism=none-resource-kind (no thread caught waiting on a kernel resource) | unknown: generic-wait 15.32, unknown 1.00 | ambiguous: futex 956.83 | visibility named=81364 masked=23468 (22.4%) running=38 zombie=120 na=0 gone=0 | 60 samples over 29.8s @2.02Hz, sweep 44/107ms mean/max = 5.0% of the 600s cadence sampled | severity is not this sense'"'"'s arm (mesh-psi io); the culprit is root-owned and structurally masked'
  printf '%s %s\n' "$(date -u -d '@'"$(( $(date +%s) - 120 ))" +%Y-%m-%dT%H:%M:%SZ)" "$_wnone" > "$_wd/none.log"
  _mn="$(MESH_PSI_WCHAN_LOG="$_wd/none.log" read_mech 1200)"
  case "$_mn" in *'?'*) fail "a none-* kind has no occupancy BY DEFINITION — rendering '?' reads as a broken parser: $_mn";; esac
  case "$_mn" in *'no occupancy'*) :;; *) fail "the no-mechanism case must SAY it has no occupancy, not silently drop the fields: $_mn";; esac
  case "$_mn" in *'masked=22.4%'*cover=5.0%*) :;; *) fail "the no-mechanism case still has a census and a coverage — both must survive: $_mn";; esac
  printf '%s %s\n' "$(date -u -d '@'"$(( $(date +%s) - 120 ))" +%Y-%m-%dT%H:%M:%SZ)" \
    "$(printf '%s' "$_wline" | sed 's/ 0\.28 thr\/sample,/,/')" > "$_wd/drift.log"
  case "$(MESH_PSI_WCHAN_LOG="$_wd/drift.log" read_mech 1200)" in
    *'?'*) :;; *) fail "a NAMED mechanism missing its occupancy is a producer-format drift and must stay a loud '?' — suppressing it everywhere would hide exactly that";;
  esac
  # a reading older than the lease must be DISQUALIFIED but still name itself (not thrown away)
  printf '%s %s\n' "$(date -u -d '@'"$(( $(date +%s) - 4000 ))" +%Y-%m-%dT%H:%M:%SZ)" "$_wline" > "$_wd/stale.log"
  _ms="$(MESH_PSI_WCHAN_LOG="$_wd/stale.log" read_mech 1200)"
  case "$_ms" in na\ \(stale:*) :;; *) fail "a reading past its lease must render na — a stale mechanism read as current is the whole trap: $_ms";; esac
  case "$_ms" in *io-throttle*) :;; *) fail "the stale na must still NAME the disqualified value: $_ms";; esac
  # every missing-evidence path renders na WITH A REASON — never a blank (blank reads as innocence)
  case "$(MESH_PSI_WCHAN_LOG="$_wd/nope.log" read_mech 1200)" in na\ \(mesh-wchan\ has\ logged\ nothing*) :;; *) fail "an absent producer must say so, not render blank";; esac
  printf 'not a wchan line at all\n' > "$_wd/junk.log"
  case "$(MESH_PSI_WCHAN_LOG="$_wd/junk.log" read_mech 1200)" in na\ \(no\ mechanism\ line*) :;; *) fail "a log with no mechanism line must render na";; esac
  printf 'NOT-A-TIMESTAMP %s\n' "$_wline" > "$_wd/badts.log"
  case "$(MESH_PSI_WCHAN_LOG="$_wd/badts.log" read_mech 1200)" in na\ \(unparseable*) :;; *) fail "an unparseable timestamp must render na, never age 0 = fresh";; esac
  # THE LEASE IS DERIVED, NOT WRITTEN: stub a crontab so the assertion is about THIS code, not this
  # node's live cadence (a gate whose value comes from the crontab it happens to run on is a weather report).
  printf '#!/bin/sh\necho "*/10 * * * * $HOME/.local/bin/mesh-wchan --edge"\n' > "$_wd/crontab"
  chmod +x "$_wd/crontab"
  [ "$(PATH="$_wd:$PATH" wchan_stale_s)" = 1200 ] || fail "lease must be 2x the LIVE cron stride (10min → 1200s), got $(PATH="$_wd:$PATH" wchan_stale_s)"
  printf '#!/bin/sh\nexit 1\n' > "$_wd/crontab"; chmod +x "$_wd/crontab"
  [ "$(PATH="$_wd:$PATH" wchan_stale_s)" = 1800 ] || fail "an unreadable crontab must fall back GENEROUS — a shrunken lease manufactures a false stale"
  rm -rf "$_wd"
  # State machine: the real-path read is gated below, never before these pure asserts.
  if [ -r /proc/pressure/cpu ]; then
    out="$("$0" --json 2>&1)" || fail "json probe failed: $out"
    printf '%s\n' "$out" | grep -q '"level":"' || fail "json missing level: $out"
    printf '%s\n' "$out" | grep -q '"who":"' || fail "json missing who (the stall's subject): $out"
    # ── who=: a non-CALM verdict must carry a SUBJECT, and its absence must be said, never blank ──
    # Honest-degraded: with mesh-psi-attrib not deployed the field says so. A blank or missing who=
    # would read as "nobody is stalling" — a fabricated innocence, the same shape as a faked CALM.
    outna="$(MESH_PSI_ATTRIB_BIN=/nonexistent/mesh-psi-attrib "$0" 2>&1)" || fail "absent-attrib run failed: $outna"
    case "$outna" in *"who=na (mesh-psi-attrib not deployed"*) :;; *) fail "an absent attrib tool must render who=na, not a blank: $outna";; esac
    case "$outna" in *"who= "*|*"who="$'\n'*) fail "who= rendered empty — reads as 'nobody is stalling': $outna";; esac
    # THE SEAM (mesh-psi's half of the contract; mesh-psi-attrib --test owns the attribution itself):
    # a raised verdict must (a) ask about the DOMINANT axis and (b) render the answer VERBATIM. A stub
    # stands in for the sense so the assertion holds on any node whatever its live cgroups look like —
    # and it records the argv it was handed, so "asked about the right axis" is checked, not assumed.
    _sd="$(mktemp -d)"
    printf '#!/bin/sh\nprintf "%%s\\n" "$*" > "%s/argv"\ncase " $* " in *" --who "*) echo "SUBJECT/probe 91.00%%[own,fleet,iv600s,node=7.00%%]";; esac\n' "$_sd" > "$_sd/attrib"
    chmod +x "$_sd/attrib"
    # Force cpu STALLED with a BASELINE, never a fake reading. Read the accumulator HERE: the suite's
    # own _ecs is not read until the interval-axis block far below, so `${_ecs:-0}` was 0 at this point
    # and every assertion under it silently skipped — a block reporting green because it never ran.
    read -r _scs _scf <<<"$(awk '/^some/{for(i=1;i<=NF;i++)if($i~/^total=/){sub("total=","",$i);s=$i}} /^full/{for(i=1;i<=NF;i++)if($i~/^total=/){sub("total=","",$i);f=$i}} END{printf "%s %s",s+0,f+0}' /proc/pressure/cpu)"
    if [ "${_scs:-0}" -ge 599000000 ]; then
      printf '%s %s %s 0 0 0 0 0\n' "$(( $(date +%s) - 600 ))" "$(( _scs - 599000000 ))" "$_scf" > "$_sd/totals"
      outsub="$(MESH_PSI_TOTALS="$_sd/totals" MESH_PSI_DISKUTIL=0 MESH_PSI_ATTRIB_BIN="$_sd/attrib" "$0" 2>&1)" \
        || fail "stubbed-attrib run failed: $outsub"
      case "$outsub" in *"who=SUBJECT/probe 91.00%[own,fleet,iv600s,node=7.00%]"*) :;; *)
        fail "a raised verdict did not carry the subject verbatim: $outsub";; esac
      grep -q -- '--who cpu' "$_sd/argv" \
        || fail "attrib was not asked about the DOMINANT axis (cpu): got '$(cat "$_sd/argv" 2>/dev/null)'"
      grep -q -- '--advance' "$_sd/argv" \
        && fail "a PEEK run advanced the attrib baseline — the next scheduled tick spans a shorter window than it reports"
      # --edge into a SCRATCH state file: the real .psi.state is what reflex-health reads for liveness,
      # and a test that rewrites it forges the evidence it exists to check.
      MESH_PSI_STATE="$_sd/state" MESH_PSI_TOTALS="$_sd/totals" MESH_PSI_DISKUTIL=0 \
        MESH_PSI_ATTRIB_BIN="$_sd/attrib" "$0" --edge >/dev/null 2>&1
      grep -q -- '--advance' "$_sd/argv" \
        || fail "the scheduled --edge run did NOT advance the attrib baseline — its interval never closes: '$(cat "$_sd/argv" 2>/dev/null)'"
      [ -e "$_sd/state" ] || fail "the --edge state override did not take effect — the test just wrote the LIVE .psi.state"
      _seam="seam: subject carried, dominant axis asked, peek/edge advance split"
    else
      _seam="seam SKIPPED (cpu stall total ${_scs}us < 599s needed to force a raised verdict)"
    fi
    rm -rf "$_sd"
    printf '%s\n' "$out" | grep -q '"dominant":"' || fail "json missing dominant: $out"
    printf '%s\n' "$out" | grep -q '"io_quarantined":' || fail "json missing io_quarantined: $out"
    # forced-idle disk: an influential io axis is quarantined by construction → io can never be the
    # claimed driver of a raised level (valid on ANY node, whatever its live psi happens to be).
    out0="$(MESH_PSI_DISKUTIL=0 "$0" 2>&1)" || fail "forced-idle live run failed: $out0"
    case "$out0" in *"— io some="*) fail "io claimed as driver despite forced-idle disk: $out0";; esac
    out9="$(MESH_PSI_DISKUTIL=999 "$0" 2>&1)" || fail "forced-busy live run failed: $out9"
    case "$out9" in "[psi] "*) :;; *) fail "forced-busy live line malformed: $out9";; esac
    # ── LIVE end-to-end for the interval axis: inject only the BASELINE, never the reading ──
    # The store holds the previous tick's totals; /proc is still parsed live, so this exercises the
    # real read_psi_total path rather than substituting a fixture for it. Baseline = "599s of cpu
    # stall accrued 600s ago" → interval mean 99.8%, which DOMINATES any live avg10 this node could
    # be showing. That matters: at 50% the gate would pass or fail depending on how loaded the box
    # happened to be when the suite ran — a gate whose colour tracks the weather is not a gate.
    _td="$(mktemp -d)"; trap 'rm -rf "$_td"' EXIT
    read -r _ecs _ecf <<<"$(awk '/^some/{for(i=1;i<=NF;i++)if($i~/^total=/){sub("total=","",$i);s=$i}} /^full/{for(i=1;i<=NF;i++)if($i~/^total=/){sub("total=","",$i);f=$i}} END{printf "%s %s",s+0,f+0}' /proc/pressure/cpu)"
    if [ "${_ecs:-0}" -lt 599000000 ]; then
      # Not enough accrued stall since boot to build a 99.8% baseline without going negative — and a
      # negative baseline reads as non-numeric → na → the assertions below would pass VACUOUSLY on
      # the degraded path. Say the axis went unexercised; never assert against a fabricated total.
      _iv_e2e="interval-axis live e2e SKIPPED (cpu stall total ${_ecs}us < 599s needed for a load-proof baseline)"
    else
      _iv_e2e="interval axis: 12 pure + 3 live"
      printf '%s %s %s 0 0 0 0 0\n' "$(( $(date +%s) - 600 ))" "$(( _ecs - 599000000 ))" "$_ecf" > "$_td/totals"
      outiv="$(MESH_PSI_TOTALS="$_td/totals" MESH_PSI_DISKUTIL=0 "$0" 2>&1)" || fail "interval-axis live run failed: $outiv"
      case "$outiv" in
        *CALM*) fail "a 99.8% interval cpu mean must NOT read CALM — this is the 14-day-CALM aliasing bug: $outiv";;
      esac
      case "$outiv" in *STALLED*) :;; *) fail "a 99.8% interval cpu mean is STALLED by any threshold: $outiv";; esac
      case "$outiv" in *'[iv]'*) :;; *) fail "raised level must name the iv window that saw it: $outiv";; esac
      case "$outiv" in *'window=inst+iv'*) :;; *) fail "coverage must report inst+iv once a baseline exists: $outiv";; esac
    fi
    # ...and the peek rule: a non-edge run must NOT advance the baseline it just read.
    [ "$(cat "$_td/totals")" = "$(printf '%s %s %s 0 0 0 0 0' "$(( $(date +%s) - 600 ))" "$(( _ecs - 300000000 ))" "$_ecf")" ] \
      || { _now2="$(date +%s)"; grep -qE "^$(( _now2 - 601 ))|^$(( _now2 - 600 ))|^$(( _now2 - 599 ))" "$_td/totals" \
           || fail "a plain (peek) run rewrote the interval baseline — the next scheduled tick is now blind"; }
    # reboot guard end-to-end: a baseline ABOVE the live counter is a counter reset, not a calm node
    printf '%s 99999999999999 0 0 0 0 0 0\n' "$(( $(date +%s) - 600 ))" > "$_td/totals"
    outrb="$(MESH_PSI_TOTALS="$_td/totals" MESH_PSI_DISKUTIL=0 "$0" 2>&1)" || fail "reboot-guard live run failed: $outrb"
    case "$outrb" in *'window=inst-only'*) :;; *) fail "a reset counter must degrade to inst-only, never a fabricated interval: $outrb";; esac
    # ── THE CITATION MUST NOT BECOME A SEVERITY (the one rule mesh-wchan asked of its consumers) ──
    # mesh-wchan has no level by construction, and occupancy is not badness. Assert it BEHAVIOURALLY,
    # not by reading the source: two runs differing ONLY in a maximal mechanism reading (999.99
    # thr/sample, seen in 100%) vs no producer at all must land the same level and the same dominant
    # axis. The verdict is first pinned by the same 599s-ago cpu baseline used above, so the gate's
    # colour cannot track how loaded the box happened to be. `reason` is deliberately NOT compared:
    # it carries live interval percentages that legitimately drift between two runs a second apart,
    # so comparing it would buy flakiness, not strictness — level+dominant IS the severity claim.
    # Paired with a PRESENCE assertion, without which the identity is satisfied vacuously by a mech
    # field that was never rendered in either run.
    if [ "${_ecs:-0}" -ge 599000000 ]; then
      _wx="$(mktemp -d)"
      printf '%s [wchan] mechanism=io-throttle(rq_qos_wait) 999.99 thr/sample, seen in 100%% of samples | visibility named=1 masked=0 (0.0%%) | 60 samples over 29.8s @2.01Hz, sweep 1/1ms mean/max = 5.0%% of the 600s cadence sampled\n' \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$_wx/max.log"
      printf '%s %s %s 0 0 0 0 0\n' "$(( $(date +%s) - 600 ))" "$(( _ecs - 599000000 ))" "$_ecf" > "$_wx/totals"
      _vmax="$(MESH_PSI_TOTALS="$_wx/totals" MESH_PSI_DISKUTIL=0 MESH_PSI_WCHAN_LOG="$_wx/max.log" "$0" --json 2>&1)"
      _vnone="$(MESH_PSI_TOTALS="$_wx/totals" MESH_PSI_DISKUTIL=0 MESH_PSI_WCHAN_LOG="$_wx/absent.log" "$0" --json 2>&1)"
      _verdict() { printf '%s' "$1" | grep -oE '"(level|dominant)":"[^"]*"' | tr '\n' ' '; }
      [ -n "$(_verdict "$_vmax")" ] || fail "verdict extraction found no level/dominant — the gate below would compare two empty strings: $_vmax"
      [ "$(_verdict "$_vmax")" = "$(_verdict "$_vnone")" ] \
        || fail "a maximal mechanism reading CHANGED the verdict — the citation became a severity: '$(_verdict "$_vmax")' vs '$(_verdict "$_vnone")'"
      case "$_vmax"  in *'999.99 thr/sample'*) :;; *) fail "the identity above is VACUOUS — mech was not rendered in that run at all: $_vmax";; esac
      case "$_vnone" in *'"mech":"na (mesh-wchan has logged nothing'*) :;; *) fail "an absent producer must render na in json too, never an empty mech: $_vnone";; esac
      rm -rf "$_wx"
      _mech_gate="mech: 11 fixture + 3 live (citation-is-not-a-severity)"
    else
      _mech_gate="mech live severity gate SKIPPED (cpu stall total ${_ecs}us < 599s needed to pin a verdict)"
    fi
    # ── THE --edge DEBOUNCE, driven END-TO-END at a scratch state file ──
    # The bug this gates: the old "2 CONSECUTIVE ticks of the same level" rule cannot fire on a node
    # whose pressure alternates tick-to-tick, so `.psi.state` froze at CALM for 42.3h here while the
    # ticks themselves raised BUSY/STALLED. Levels are forced by moving the THRESHOLDS, never by
    # stubbing the reading — the real /proc parse, fold, quarantine and classify all run, so these
    # gates drive the shipped edge path rather than a mock of it.
    _dd="$(mktemp -d)"
    _tick() {
      case "$1" in
        CALM)    _sb=9999; _ss=9999;;
        BUSY)    _sb=0;    _ss=9999;;
        STALLED) _sb=0;    _ss=0;;
      esac
      MESH_PSI_STATE="$_dd/x.state" MESH_PSI_TOTALS="$_dd/totals" MESH_PSI_DISKUTIL=999 \
      MESH_PSI_DISKUTIL_IV=999 MESH_PSI_ATTRIB_BIN="$_dd/no-attrib" MESH_PSI_WCHAN_LOG="$_dd/no-wchan" \
      MESH_PSI_SOME_BUSY="$_sb" MESH_PSI_SOME_STALL="$_ss" MESH_PSI_FULL_STALL=9999 \
      MESH_PSI_MEM_FULL_STALL=9999 "$0" --edge 2>&1
    }
    _st() { cat "$_dd/x.state" 2>/dev/null; }
    _pend() { cat "$_dd/x.pending" 2>/dev/null; }
    _reseed() { rm -f "$_dd/x.state" "$_dd/x.pending"; _tick CALM >/dev/null; }
    # Vacuity guard FIRST: if threshold forcing does not actually move the classifier, every
    # sequence below drives one constant level and passes without asserting anything.
    _reseed; [ "$(_st)" = CALM ] || fail "threshold-forced CALM did not seed the state: got '$(_st)'"
    rm -f "$_dd/x.state" "$_dd/x.pending"; _tick STALLED >/dev/null
    [ "$(_st)" = STALLED ] || fail "threshold forcing does not drive the classifier — every debounce gate below is VACUOUS: got '$(_st)'"
    # 1. THE REGRESSION: a strictly alternating sequence must still commit. Red on the old rule.
    _reseed; _held=""
    for _l in BUSY CALM BUSY; do _held="$_held$(_tick "$_l")"; done
    [ "$(_st)" = BUSY ] || fail "an ALTERNATING tick sequence never committed — this is the 42.3h-CALM freeze the 2-consecutive debounce caused: state='$(_st)'"
    # 2. ...and a suppressed tick must SAY it was suppressed. A commit-only log cannot tell a quiet
    #    node from a debounce that can never fire — that is why nothing but value-frozen saw this.
    case "$_held" in *'[psi-hold]'*) :;; *) fail "a tick held back by the debounce logged NOTHING: '$_held'";; esac
    # 3. A single isolated spike must STILL be suppressed (the one thing the old rule got right).
    _reseed; _tick CALM >/dev/null; _tick CALM >/dev/null; _tick BUSY >/dev/null
    [ "$(_st)" = CALM ] || fail "a single isolated spike committed — the debounce no longer suppresses one tick: '$(_st)'"
    _tick CALM >/dev/null
    [ "$(_st)" = CALM ] || fail "one spike inside an otherwise calm window must leave CALM standing: '$(_st)'"
    # 4. The committed name is the WORST of the window, in BOTH orders — a burst is not made calmer
    #    by the calm tick beside it, and the newest tick is not automatically the verdict.
    _reseed; _tick BUSY >/dev/null; _tick STALLED >/dev/null
    [ "$(_st)" = STALLED ] || fail "BUSY then STALLED must commit STALLED: '$(_st)'"
    _reseed; _tick STALLED >/dev/null; _tick BUSY >/dev/null
    [ "$(_st)" = STALLED ] || fail "STALLED then BUSY must commit STALLED, not the newest tick: '$(_st)'"
    # 5. Release is SLOWER than attack, deliberately — and it must still happen, or the freeze just
    #    moves to the non-CALM side.
    _tick CALM >/dev/null; [ "$(_st)" = STALLED ] || fail "one calm tick released a stall — release must need a FULL clean window: '$(_st)'"
    _tick CALM >/dev/null; [ "$(_st)" = STALLED ] || fail "two calm ticks released a stall — all three slots must be clean: '$(_st)'"
    _tick CALM >/dev/null; [ "$(_st)" = CALM ] || fail "three consecutive clean ticks did NOT release — the state can now freeze non-CALM instead: '$(_st)'"
    # 5b. ...and a PARTIAL window is not a clean one. The only path that reaches the release branch
    #     with fewer than 3 slots is the upgrade boundary (a legacy pending discarded under a
    #     non-CALM confirmed level) — where a single calm tick would otherwise cancel a live stall.
    _reseed; _tick STALLED >/dev/null; _tick STALLED >/dev/null
    [ "$(_st)" = STALLED ] || fail "setup for the partial-window gate did not reach STALLED: '$(_st)'"
    printf 'STALLED:1\n' > "$_dd/x.pending"
    _tick CALM >/dev/null
    [ "$(_st)" = STALLED ] || fail "one calm tick against a PARTIAL window released a live stall — release must need three clean slots, not merely no dirty ones: '$(_st)'"
    # 6. A pending file left by the OLD rule ("LEVEL:N") is a counter, not a tick window: read as a
    #    ring it would inject a phantom tick on the upgrade boundary.
    _reseed; printf 'BUSY:1\n' > "$_dd/x.pending"; _tick BUSY >/dev/null
    [ "$(_st)" = CALM ] || fail "a legacy 'LEVEL:N' pending was parsed as ticks — one BUSY tick committed: '$(_st)'"
    case "$(_pend)" in *:*) fail "the legacy pending survived instead of being replaced by a ring: '$(_pend)'";; esac
    # 7. The window is BOUNDED — an unbounded ring would make the majority a lifetime average.
    _reseed; for _l in BUSY BUSY BUSY BUSY BUSY; do _tick "$_l" >/dev/null; done
    _rn="$(set -- $(_pend); echo $#)"
    [ "$_rn" -ge 1 ] || fail "the ring gate read an EMPTY pending — it would pass however the ring grew: is the pending path right?"
    [ "$_rn" -le 3 ] || fail "the tick ring grew past 3 slots ($_rn) — the debounce is now a lifetime average"
    rm -rf "$_dd"
    _debounce="debounce: 7 gates end-to-end (alternation, spike, worst-of-window, slow release, legacy pending, bound)"
    rm -rf "$_td"; trap - EXIT
    echo "smoke-test: ok (incl. phantom-io quarantine: 5 pure + 2 forced-util live; ${_iv_e2e}; ${_seam}; ${_mech_gate}; ${_debounce})"
  else
    echo "smoke-test: ok (no /proc/pressure — kernel without CONFIG_PSI, sense reports UNAVAILABLE)"
  fi
  exit 0
fi

MODE=text; [ "${1:-}" = --json ] && MODE=json
EDGE=0;   [ "${1:-}" = --edge ] && EDGE=1
TS=$(date -u +%H:%M:%SZ)

# --- Honest-degraded: no PSI support → UNAVAILABLE, never fake CALM ---
if [ ! -r /proc/pressure/cpu ]; then
  if [ "$MODE" = json ]; then
    printf '{"level":"UNAVAILABLE","dominant":"-","reason":"kernel has no PSI (CONFIG_PSI off)","ts":"%s"}\n' "$TS"
  else
    echo "[psi] UNAVAILABLE — kernel has no PSI (/proc/pressure absent; CONFIG_PSI off)"
  fi
  exit 2
fi

# read avg10 (most recent 10s window) for a resource's some+full lines
read_psi() {  # $1 = cpu|io|memory ; echoes "some full"
  local f="/proc/pressure/$1"
  awk '
    /^some/ { for (i=1;i<=NF;i++) if ($i ~ /^avg10=/) { sub("avg10=","",$i); s=$i } }
    /^full/ { for (i=1;i<=NF;i++) if ($i ~ /^avg10=/) { sub("avg10=","",$i); f=$i } }
    END { printf "%s %s", (s==""?0:s), (f==""?0:f) }
  ' "$f" 2>/dev/null
}

# read the monotonic microsecond accumulator for a resource's some+full lines
read_psi_total() {  # $1 = cpu|io|memory ; echoes "some_total full_total"
  awk '
    /^some/ { for (i=1;i<=NF;i++) if ($i ~ /^total=/) { sub("total=","",$i); s=$i } }
    /^full/ { for (i=1;i<=NF;i++) if ($i ~ /^total=/) { sub("total=","",$i); f=$i } }
    END { printf "%s %s", (s==""?0:s), (f==""?0:f) }
  ' "/proc/pressure/$1" 2>/dev/null
}
# io_ticks (ms with I/O in flight) summed over real block devices — the interval twin of the 500ms
# disk_util_pct sample, so the iv io axis gets corroborated over ITS window rather than over a
# half-second that may sit entirely outside the burst it is judging.
read_io_ticks() { awk '$3 ~ /^(nvme[0-9]+n[0-9]+|sd[a-z]+|vd[a-z]+|mmcblk[0-9]+)$/ {s+=$13} END{print s+0}' /proc/diskstats 2>/dev/null; }

read cpu_some cpu_full <<<"$(read_psi cpu)"
read io_some io_full   <<<"$(read_psi io)"
read mem_some mem_full <<<"$(read_psi memory)"

# ── interval window: total= deltas against the previous tick (see the aliasing block at the top) ──
TOTALS="${MESH_PSI_TOTALS:-$TOTALS_DEFAULT}"   # call-time read, not the load-time global
read cur_cs cur_cf <<<"$(read_psi_total cpu)"
read cur_is cur_if <<<"$(read_psi_total io)"
read cur_ms cur_mf <<<"$(read_psi_total memory)"
cur_ticks="$(read_io_ticks)"; now_s="$(date +%s)"
p_ts=""; p_cs=""; p_cf=""; p_is=""; p_if=""; p_ms=""; p_mf=""; p_ticks=""
[ -s "$TOTALS" ] && read -r p_ts p_cs p_cf p_is p_if p_ms p_mf p_ticks < "$TOTALS" 2>/dev/null
case "$p_ts" in ''|*[!0-9]*) dt=0;; *) dt=$(( now_s - p_ts ));; esac
[ "$dt" -ge 0 ] 2>/dev/null || dt=0        # clock stepped backwards → no trustworthy window
iv_cs="$(interval_pct "$cur_cs" "$p_cs" "$dt")"; iv_cf="$(interval_pct "$cur_cf" "$p_cf" "$dt")"
iv_is="$(interval_pct "$cur_is" "$p_is" "$dt")"; iv_if="$(interval_pct "$cur_if" "$p_if" "$dt")"
iv_ms="$(interval_pct "$cur_ms" "$p_ms" "$dt")"; iv_mf="$(interval_pct "$cur_mf" "$p_mf" "$dt")"
# interval disk utilisation: io_ticks are MILLIseconds, so scale by 1000 not 1e6.
iv_util=na
case "$p_ticks" in ''|*[!0-9]*) :;; *)
  if [ "$dt" -ge "${MESH_PSI_MIN_DT:-$MIN_DT}" ] && [ "$cur_ticks" -ge "$p_ticks" ] 2>/dev/null; then
    iv_util="$(awk -v c="$cur_ticks" -v p="$p_ticks" -v d="$dt" 'BEGIN{ printf "%.0f", (c-p)/(d*1000)*100 }')"
  fi ;;
esac
# Test override for the INTERVAL corroboration. MESH_PSI_DISKUTIL reached only the 500ms inst sample,
# so `MESH_PSI_DISKUTIL=0` forced the inst window idle and left the iv window reading the real disk —
# and the forced-idle assertion below ("io can never be the claimed driver, valid on ANY node") went
# red on this node's ordinary background io, where iv io alone raises the level. An override that
# reaches one of two corroboration paths asserts less than its comment claims. Falls back to the
# inst override so one variable still drives both windows. (Pre-existing; red on HEAD before this.)
_ivu="${MESH_PSI_DISKUTIL_IV:-${MESH_PSI_DISKUTIL:-}}"
[ -n "$_ivu" ] && iv_util="$_ivu"
# Persist ONLY on the scheduled --edge run. A plain/--json invocation is an on-demand PEEK: letting it
# rewrite the store would reset dt to seconds and blind the next cron tick's interval — the same rule
# the refrain probe's peek mode follows. (The store is written at the END, after the read is used.)

# ── Phantom-io quarantine, applied PER WINDOW ──
# The 500ms disk sample corroborates a spike happening NOW; it says nothing about a burst that ended
# eight minutes ago, so judging the iv axis with it would quarantine real history as phantom. Each
# window is therefore corroborated by its own measure — inst by the 500ms sample, iv by the io_ticks
# delta over the same interval — and only then folded. An iv axis with no interval util (first sight)
# is left UNCORROBORATED rather than force-quarantined: say so in the note instead of silently deciding.
io_note=""; io_quar=false
if awk -v ios="$io_some" -v iof="$io_full" -v sb="$SOME_BUSY" 'BEGIN{exit !(iof >= 1 || ios >= sb)}'; then
  util="$(disk_util_pct)"
  if io_phantom "$io_some" "$io_full" "$util"; then
    io_note=" [io QUARANTINED: psi io=${io_some}/${io_full}% but disk util=${util}% — phantom stall (iowait-parked waiters, e.g. io_uring cqring), no real disk contention]"
    io_quar=true
    io_some=0; io_full=0
  fi
fi
if [ "$iv_is" != na ] && awk -v ios="$iv_is" -v iof="$iv_if" -v sb="$SOME_BUSY" 'BEGIN{exit !(iof >= 1 || ios >= sb)}'; then
  if [ "$iv_util" != na ] && io_phantom "$iv_is" "$iv_if" "$iv_util"; then
    io_note="${io_note} [io iv QUARANTINED: interval io=${iv_is}/${iv_if}% but interval disk util=${iv_util}% — phantom stall]"
    io_quar=true
    iv_is=0; iv_if=0
  elif [ "$iv_util" = na ]; then
    io_note="${io_note} [io iv UNCORROBORATED: no interval disk util yet (first sight) — not quarantined, not confirmed]"
  fi
fi

# ── fold the two windows per axis, remembering which one drove each ──
read cpu_some w_cs <<<"$(fold_axis "$cpu_some" "$iv_cs")"; read cpu_full w_cf <<<"$(fold_axis "$cpu_full" "$iv_cf")"
read io_some  w_is <<<"$(fold_axis "$io_some"  "$iv_is")"; read io_full  w_if <<<"$(fold_axis "$io_full"  "$iv_if")"
read mem_some w_ms <<<"$(fold_axis "$mem_some" "$iv_ms")"; read mem_full w_mf <<<"$(fold_axis "$mem_full" "$iv_mf")"

res="$(classify "$cpu_some" "$cpu_full" "$io_some" "$io_full" "$mem_some" "$mem_full")"
level="${res%%|*}"; dom="${res#*|}"

# ── who= : the SUBJECT of the stall (mesh-psi-attrib, per-cgroup PSI) ──
# The kernel publishes this same quantity per cgroup, so a STALLED verdict need not be anonymous.
# The figure is that cgroup's OWN stalled-time fraction — NOT a share of the node's: shares overlap,
# do not sum, and a child routinely exceeds its parent (measured cron.service 23.18% > system.slice
# 22.00%). The granularity token travels with it because `cron.service` is the whole reflex FLEET in
# one cgroup, never a single tool — a consumer that reads it as one reflex blames the wrong thing.
# mesh-psi's SCHEDULED --edge run is the single owner of that sense's interval baseline (`--advance`);
# every other invocation here is a peek, exactly as with this file's own TOTALS store.
ATTRIB="${MESH_PSI_ATTRIB_BIN:-$HOME/.local/bin/mesh-psi-attrib}"
attrib_adv=""; [ "$EDGE" = 1 ] && attrib_adv="--advance"
if [ ! -x "$ATTRIB" ]; then
  who="na (mesh-psi-attrib not deployed — the stall has no subject)"
elif [ "$level" = CALM ]; then
  [ -n "$attrib_adv" ] && "$ATTRIB" $attrib_adv >/dev/null 2>&1
  who="- (calm — no stall to attribute)"
else
  who="$("$ATTRIB" --who "$dom" $attrib_adv 2>/dev/null)"
  [ -n "$who" ] || who="na (attrib read failed)"
fi

# COVERAGE is part of the reading, not a footnote: a CALM from avg10 alone is a claim about ~1.7% of
# the elapsed time, and a consumer that cannot tell the two apart will read the narrow one as the node.
if [ "$iv_cs" = na ]; then
  cover="inst-only (avg10 ≈10s — no usable interval baseline: dt=${dt}s, first sight/reset/too-short)"
else
  cover="inst+iv (avg10 plus a full ${dt}s interval mean, 100% coverage)"
fi
# The mechanism citation is read AFTER classify(): `mech` is an annotation on a verdict already
# decided, never an input to it. Reordering these two lines is the whole bug this field must not have.
mech="$(read_mech)"
signals="cpu=${cpu_some}/${cpu_full} io=${io_some}/${io_full} mem=${mem_some}/${mem_full} (some/full %) window=${cover} who=${who} mech=${mech}${io_note}"
if [ "$level" = CALM ]; then
  reason="all resources calm"
else
  case "$dom" in
    cpu)    d_some="$cpu_some"; d_full="$cpu_full"; d_ws="$w_cs"; d_wf="$w_cf";;
    io)     d_some="$io_some";  d_full="$io_full";  d_ws="$w_is"; d_wf="$w_if";;
    memory) d_some="$mem_some"; d_full="$mem_full"; d_ws="$w_ms"; d_wf="$w_mf";;
  esac
  # name the window that SAW it — the fold is a max, and a max that cannot say which side won
  # effaces the disjunction (a burst caught only between ticks reads identically to a live spike).
  reason="$dom some=${d_some}%[$d_ws] full=${d_full}%[$d_wf]"
fi

if [ "$io_quar" = true ]; then
  reason="$reason (io axis quarantined: phantom stall, disk util ${util:-n/a}%/iv ${iv_util}%)"
fi

if [ "$MODE" = json ]; then
  printf '{"level":"%s","dominant":"%s","reason":"%s","cpu_some":%s,"cpu_full":%s,"io_some":%s,"io_full":%s,"mem_some":%s,"mem_full":%s,"io_quarantined":%s,"window_cpu_some":"%s","interval_s":%s,"interval_cpu_some":"%s","coverage":"%s","who":"%s","mech":"%s","ts":"%s"}\n' \
    "$level" "$dom" "$reason" "$cpu_some" "$cpu_full" "$io_some" "$io_full" "$mem_some" "$mem_full" "$io_quar" \
    "$w_cs" "$dt" "$iv_cs" "$cover" "$who" "$mech" "$TS"
  exit 0
fi

if [ "$EDGE" = 1 ]; then
  # Only the SCHEDULED run advances the interval baseline (a peek would reset dt to seconds and blind
  # the next tick). Written unconditionally on every edge run, level change or not — the baseline is
  # liveness, not news.
  printf '%s %s %s %s %s %s %s %s\n' "$now_s" "$cur_cs" "$cur_cf" "$cur_is" "$cur_if" "$cur_ms" "$cur_mf" "$cur_ticks" \
    > "$TOTALS" 2>/dev/null || true
  PENDING="${STATE%.state}.pending"
  confirmed="$(cat "$STATE" 2>/dev/null || true)"
  # ── THE DEBOUNCE IS A ROLLING 3-WINDOW, NOT "2 CONSECUTIVE" (2026-08-18) ──
  # The old rule committed a level only after TWO CONSECUTIVE ticks of the SAME level. On a node
  # whose pressure alternates tick-to-tick that condition is simply never met, so the committed
  # state freezes at whatever it last was — measured here: `.psi.state` read CALM for 42.3h while
  # the ticks themselves were raising BUSY/STALLED (`.psi.pending` cycling `BUSY:1`, reset every
  # tick). Note the shape that hid it: psi.log records COMMITS, so a debounce that never commits is
  # invisible in the tool's own log BY CONSTRUCTION, and only reflex-health's `value-frozen` flag —
  # a lead, never a verdict — pointed at it. A rolling 3-window CANNOT freeze: two classes over
  # three slots always have a majority, so the committed state is never more than 3 ticks stale.
  # Deliberately ASYMMETRIC (fast attack / slow release), and the asymmetry is the claim: 2 of the
  # last 3 ticks non-CALM RAISES, naming the WORST level in the window — a burst is not made calmer
  # by the calm tick beside it — while returning to CALM needs all 3 slots clean. A single isolated
  # spike still cannot commit, which is the one thing the old rule got right and this keeps.
  ring="$(cat "$PENDING" 2>/dev/null || true)"
  case "$ring" in *:*) ring="";; esac   # legacy "LEVEL:N" pending from the old rule — start fresh
  set -- $ring "$level"
  while [ "$#" -gt 3 ]; do shift; done
  ring="$*"; rn="$#"
  printf '%s\n' "$ring" > "$PENDING" 2>/dev/null || true
  nc=0; worst=""
  for t in $ring; do
    case "$t" in
      STALLED) nc=$((nc + 1)); worst=STALLED;;
      BUSY)    nc=$((nc + 1)); [ "$worst" = STALLED ] || worst=BUSY;;
    esac
  done
  target=""
  if [ -z "$confirmed" ]; then
    target="$level"                                  # first sight: nothing to debounce against
  elif [ "$nc" -ge 2 ]; then
    target="$worst"                                  # attack: 2 of 3 non-calm → the worst of them
  elif [ "$nc" = 0 ] && [ "$rn" -ge 3 ]; then
    target=CALM                                      # release: a full clean window, never fewer
  fi
  if [ -n "$target" ] && [ "$target" != "$confirmed" ]; then
    printf '%s\n' "$target" > "$STATE"
    printf '[psi-%s] %s — %s | %s\n' "$(printf '%s' "$target" | tr '[:upper:]' '[:lower:]')" "$target" "$reason" "$signals"
  elif [ "$level" != "$confirmed" ]; then
    # HELD: this tick disagreed with the committed level and the window did not carry it. Logged
    # because the failure above was invisible precisely for want of this line — a commit-only log
    # cannot distinguish "quiet node" from "debounce that can never fire".
    printf '[psi-hold] %s (window %s) held=%s — %s\n' "$level" "$ring" "${confirmed:-none}" "$reason"
  fi
  # touch on EVERY --edge run (liveness-touch convention): mtime = ran-live, content = confirmed level.
  # Touching only on the unchanged-level branch left the pending/debounce paths dark — an OSCILLATING
  # level (CALM↔STALLED↔BUSY flapping) keeps resetting the debounce, never rewrites STATE, and the
  # mtime freezes while the reflex runs live → reflex-health false-STALE (caught live 2026-07-06:
  # .psi.state 88m frozen across two green cron beats). Same class as mesh-activity-tempo f3f84c1.
  # ABSOLUTE path: mesh-psi does not export PATH (cron-PATH gap), so the absolute form is cron-safe.
  "$HOME/.local/bin/mesh-state-touch" "$STATE" 2>/dev/null || true
  exit 0
fi

printf '[psi] %s — %s | %s\n' "$level" "$reason" "$signals"
