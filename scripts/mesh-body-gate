#!/usr/bin/env bash
# mesh-body-gate — deploy shim for the uxn body self-gate (uxn-hop-body-gate, stage 4c).
#
# The real tool lives WITH its ROMs, ledger and receiver at scripts/uxn/mesh-body-gate
# ($here-relative ROM/ledger/hop resolution needs the genome dir). This thin exec makes it
# PATH-visible and autowirable (the never-wired-reflex rule, cc617e5). Each firing ships
# the pinned evaluator + fresh ledger consts to the adb body as one argv packet — the
# phone gates its own battery/thermal at the execution site; no body attached = honest
# rc 2 (expected-asleep sense, mesh-land convention), never a fake verdict.
# reflex-cadence: */30 * * * *
set -eu
REPO="${MESH_REPO:-$HOME/lte-workstation}"
TARGET="$REPO/scripts/uxn/mesh-body-gate"
[ -x "$TARGET" ] || { echo "mesh-body-gate: n/a — no genome checkout at $TARGET (set MESH_REPO)" >&2; exit 2; }
exec "$TARGET" "$@"
