#!/usr/bin/env bash
# mesh-roll-call — a low-rate fleet HEARTBEAT OF INTENT. Every ~5h it asks each mind for a 3-field
# status ([fyi] PROPOSE / CHANGED / GAP, ONE line to mesh-chat), then has the tg-mind synthesize all
# the roll-call lines into ONE board-internal [fyi] DIGEST (NOT voice — operator silenced mesh-voice-tx 2026-06-24).
#
# It belongs to the minds-control family (sits beside mesh-mind-control / mesh-mode): mind-control
# routes/allocates work tick-to-tick; mesh-mode sets the burn envelope; roll-call is the slow pulse
# that surfaces, across the whole fleet at once, what each mind WOULD change, what it DID, and where
# it is BLOCKED — drift + intent the per-tick view never aggregates. The current mesh-mode is passed
# to the synthesis as context so the digest reads against the active burn posture.
#
# BOUNDED BY DESIGN — must NEVER burn the consume loop:
#   * one mesh-tell (a cheap tmux paste) per mind, once per 5h; the minds answer ONE line on their own
#     next tick (roll-call does not block on them).
#   * the synthesis is one tg-mind action; it HOLDS (re-checks next tick) until enough lines arrived,
#     so it never relays a hollow digest and never spins.
#
#   mesh-roll-call            run a roll-call: prompt every mind window + phaedra genome/chat, then
#                             inject the tg synthesis step (carrying the PROPOSE-DEDUP suppress-ledger)
#   mesh-roll-call --ledger   print the current SUPPRESS-LEDGER (gated + recently-resolved + retracted
#                             subjects + the RECURRING escalation block) — the same block injected into the synth; for inspection
#   mesh-roll-call --sig TEXT  print the propose_sig (intent-key) of TEXT — the dedupe canonicalizer
#   mesh-roll-call --test     sandboxed dry-run (ROLL_CALL_DRYRUN=1): prints the targets+prompts to
#                             stdout, fires NO real mesh-tell / board / TG / voice; asserts the window
#                             set, the 3-field PROPOSE/CHANGED/GAP template, the synth step, AND the
#                             PROPOSE-DEDUP ledger (gated + resolved + retracted suppression, intent-key collapse)
#
# PROPOSE-DEDUP: the synth re-surfaced already-answered/operator-gated/self-retracted PROPOSEs every round.
# roll-call now injects a SUPPRESS-LEDGER (operator-gated $MESH/proposals-gated + recently-[done]/RESOLVING
# board subjects + PROPOSEs whose own proposer posted a same-round RETRACT/MOOT marker, deduped by propose_sig
# intent-key) and the synth DROPS any PROPOSE matching it. idle_sig principle for PROPOSEs.
# It ALSO ESCALATES the opposite failure — a PROPOSE that is NEVER actioned: build_recurring counts how many
# distinct rounds each PROPOSE recurred in (from the board, propose_sig-collapsed) and flags any >= RECUR_N
# still-unactioned as 'RECURRING xN — decide or retire' so a chronic proposal is forced to a decision instead
# of re-burning synth tokens every round (chat-review 2026-06-26, owner mesh-roll-call/genome).
#
# Tunables (env): ROLL_CALL_MINDS (local windows) · ROLL_CALL_REMOTE ("<peer>:<win> …") ·
#                 ROLL_CALL_SYNTH_WIN (synthesizer window, default tg) · ROLL_CALL_MIN_LINES.
#
# reflex-cadence: 0 */5 * * *
set -uo pipefail
# cron PATH gap (memory cron-path-gap-bare-tool-calls): cron's minimal PATH lacks ~/.local/bin, so the
# bare mesh-tell / mesh-mode / mesh-chat calls below would "not found". Prepend it so the wired reflex
# actually drives the panes (the --test passes interactively even without this, so it must be here).
export PATH="$HOME/.local/bin:$PATH"
MESH="${MESH_DIR:-$HOME/.mesh}"
CARD="${MESH_CARD:-$HOME/.mesh-card}"   # card-authoritative gate (rollcall-card-gate) — see node_minds_off
SYNTH_WIN="${ROLL_CALL_SYNTH_WIN:-tg}"
# local mind windows to roll-call. The default baseline is AUTO-EXTENDED (in the live run, below)
# with every live 2-pane mind window in this node's session — the "data+mind" convention means a
# 2-pane window IS a mind channel — so a non-consume-driven window that isn't on any consume loop
# (e.g. discover, revived 7330f6c) is wake-poked too, not silently invisible + falsely flagged
# SILENT (cf55ad3's grace only delayed the false flag; the root cause was a hand-maintained list
# drifting from the real windows). tg is EXCLUDED — it is the SYNTHESIZER ($SYNTH_WIN), not a
# respondent. ROLL_CALL_MINDS overrides the WHOLE set (a curated subset); auto-extend applies to
# the default only.
LOCAL_MINDS="${ROLL_CALL_MINDS:-minds genome senses health chat room pub}"
# remote lean-node minds, "<peer>:<window>" (resolved via mesh-tell --node <peer>).
REMOTE_MINDS="${ROLL_CALL_REMOTE:-phaedra:genome phaedra:chat}"
MIN_LINES="${ROLL_CALL_MIN_LINES:-3}"      # synth holds until at least this many roll-call lines arrive
GRACE_S="${ROLL_CALL_GRACE_S:-120}"        # ONE-TICK grace: a mind still unanswered when MIN_LINES is
                                           # reached gets this long (re-check next tick) before being named
                                           # SILENT — late-but-alive ≠ dead (health answered 12s late 02:00:57)
# PROPOSE-DEDUP ledger (idle_sig principle for proposals): the synth re-surfaced PROPOSEs already answered
# or operator-gated every round (pub re-proposed draft-staging at 07:00+12:00 though both were DONE; minds'
# MESH_WEEKLY_PAID_CAP recurred though operator-gated). roll-call now builds a SUPPRESS-LEDGER from two
# sources and injects it into the synth so the digest DROPS an already-answered PROPOSE before listing it.
LEDGER_DAYS="${ROLL_CALL_LEDGER_DAYS:-3}"  # how far back to scan resolved [done]/RESOLVING for the ledger
GATED_FILE="${MESH_PROPOSALS_GATED:-$MESH/proposals-gated}"  # durable operator-gated / settled list ('slug | why', # comments ok)
CHAT_LOG="${MESH_CHAT_LOG:-$MESH/chat.log}"
DRYRUN="${ROLL_CALL_DRYRUN:-}"

# node_minds_off — the CARD-AUTHORITATIVE gate (rollcall-card-gate, minds 2026-07-06). roll-call is a
# mind-touching tool (it pings mind windows + injects a tg synth), so like mesh-restore / mesh-mind-
# keepalive / mesh-channel-keepalive it must NOT run on a node the card declares HANDS-OFF
# ([[card-capability-authoritative]]). A minds-off node (e.g. default-string: card `minds:` line
# blanked/absent, role=compute) that autowired its OWN roll-call was pinging OFF-MESH windows and the
# digest misflagged their silence as a liveness problem. Contract, matching the keepalive idiom:
#   • card present + `minds:` lists a known engine (claude/opencode/gemini/codex) → RUN
#   • card present + no such `minds:` engine (blanked value OR no `minds:` line) → HANDS-OFF (rc 0)
#   • NO card file at all → RUN — fresh-boot FAIL-SAFE: never silence a healthy node on a missing card
#     (mesh-card --refresh regenerates it early in mesh-restore). Same posture as mesh-channel-keepalive.
#   • restore.env's own MESH_MIND_CHANNELS is empty/'none' → HANDS-OFF (rc 0), REGARDLESS of the card.
#     (chat-review/doctor-autonomy-check-minds-off-cryolf 2026-07-08): `mesh-card --refresh` regenerates
#     `minds:` from INSTALLED BINARIES, so a node that's deliberately minds-driving-OFF via restore.env
#     but still has claude/opencode binaries installed shows 'minds: claude opencode' on its card
#     forever — the card-only gate above can never be the off-switch on that node. Default-string:
#     MESH_MIND_CHANNELS=none since 2026-06-17, card still 'minds: claude opencode ollama'.
#     KEEP IN SYNC with mesh-doctor's minds_declared_off().
node_minds_off(){  # rc 0 = HANDS-OFF (skip roll-call); rc 1 = run
  local renv="$MESH/restore.env" line val
  if [ -f "$renv" ]; then
    line="$(grep -E '^[[:space:]]*(export[[:space:]]+)?MESH_MIND_CHANNELS=' "$renv" 2>/dev/null | tail -1)"
    if [ -n "$line" ]; then
      val="$(printf '%s' "$line" | sed -E 's/^[[:space:]]*(export[[:space:]]+)?MESH_MIND_CHANNELS=//; s/[[:space:]]*(#.*)?$//; s/^"//; s/"$//; s/^'"'"'//; s/'"'"'$//')"
      case "$val" in ''|none|NONE|None) return 0 ;; esac
    fi
  fi
  [ -f "$CARD" ] || return 1
  grep -iE '^[[:space:]]*minds:' "$CARD" 2>/dev/null | grep -qwE 'claude|opencode|gemini|codex' && return 1
  return 0
}

# the 3-field template a mind answers with — ONE [fyi] line, tagged 'roll-call <name>' so the synth
# step can grep just these lines. Explicitly a STATUS PING: the mind must not spawn new work off it.
# SOURCE-side PROPOSE dedup (chat-review/rollcall-propose-dedup 2026-07-05): the synth ledger
# suppresses ANSWERED/gated proposals, but an unchanged still-open PROPOSE was re-posted verbatim by
# its proposer every round (57 identical PROPOSEs measured, ~26% of the board) — dedup must happen
# where the line is BORN, not only at synthesis. The prompt now tells the mind to check its own last
# roll-call line first and post 'PROPOSE unchanged' instead of repeating itself.
respond_prompt(){ # $1 = mind label (its window name)
  printf '%s' "[roll-call] Status ping — post exactly ONE line to the board, then return to your loop. \
FIRST check the board for your own previous line: grep 'roll-call $1:' ~/.mesh/chat.log | tail -1. If the \
PROPOSE you were about to post is the SAME proposal as that last line (even reworded), post \
'PROPOSE unchanged (<3-word slug of it>)' instead of restating it — an identical PROPOSE re-surfacing \
every round is board noise; only a NEW or materially revised proposal gets spelled out. \
Run: MESH_WHO=\"$1@\$(hostname)\" mesh-chat \"[fyi] roll-call $1: PROPOSE <new proposal | unchanged (<slug>) | none> | \
CHANGED <what you did since the last roll-call> | GAP <what is missing or blocked>\". \
Keep each field to a few words; one line total. Do NOT start new work from this ping."
}

# the synthesis step injected into the tg window. It reads the board, collects roll-call lines since
# the marker, and posts ONE board-internal [fyi] DIGEST — but HOLDS (defers to its next tick) until
# >=MIN_LINES arrived so a too-early tick never posts a hollow digest (honest-fusion: name who didn't
# answer). NO voice/Telegram relay: the operator explicitly silenced mesh-voice-tx (2026-06-24) —
# the digest is board-internal ONLY; a human can read it on the board, the mesh does not speak it.
synth_prompt(){ # $1 = marker epoch, $2 = current mode, $3 = suppress-ledger (build_ledger output),
                 # $4 = expected-responder set (this node's ground truth, see rollcall-digest-expected-set)
  printf '%s' "[roll-call-synth] The fleet roll-call fired at marker $1 (mesh-mode: $2). Each mind is \
posting one '[fyi] roll-call <name>:' line (PROPOSE/CHANGED/GAP) to mesh-chat over the next few minutes. \
Read the board, collect the 'roll-call' [fyi] lines posted SINCE marker $1. If fewer than $MIN_LINES have \
arrived, HOLD — do nothing this tick and re-check on your next tick (do not post a partial/hollow digest). \
Once at least $MIN_LINES are in: if EVERY expected mind has answered, post the digest now. If some expected \
mind is STILL unanswered, give it a ONE-TICK GRACE before judging it silent — minds answer late but alive \
(health answered 12s after the digest window 02:00:57). Concretely: if the marker is LESS than ${GRACE_S}s \
old, HOLD one more tick (do not name anyone SILENT yet) so stragglers can post, and re-check next tick. \
Only a mind STILL unanswered once the marker is OLDER than ${GRACE_S}s (i.e. it has had its grace tick) is \
named SILENT and flagged for a liveness-check. A mind that answers during the grace window is included \
normally, never flagged. \
FINAL RE-SCAN BEFORE POSTING (chat-review/mesh-roll-call-399721, stale-snapshot-vs-late-post gap): the \
board read above can go stale by the time you finish composing — a mind's roll-call line can land in the \
minutes it takes you to synthesize and post the digest (a real case: a mind's line landed 21s before the \
digest posted, only barely inside grace, yet was still misjudged off a snapshot taken earlier). Immediately \
before running the mesh-chat post command, RE-READ the board one more time for any 'roll-call' [fyi] lines \
that landed since your first read; fold in any that arrived and drop them from the SILENT list. Never name \
a mind SILENT in the posted digest if its own roll-call line is already on the board by post time, even if \
your first read missed it. \
EXPECTED-RESPONDER SET (rollcall-digest-expected-set, ground truth for judging silence — a 12:01Z digest \
wrongly declared a whole peer node 'off by card-gate' and dropped its 6 minds' PROPOSEs/GAPs because the \
synth had no real target list and guessed from a stale card read): $4 \
Judge SILENCE ONLY against this set — a window named in it that hasn't posted by grace time is SILENT; a \
window NOT in this set is simply not this node's responsibility to judge. The board (via chat-sync gossip) \
ALSO carries roll-call lines from OTHER hosts, each tagged by its WHO field '<window>@<hostname>' with a \
hostname different from this one — you have NO expected-set ground truth for those (their own roll-call run \
knows their real target list, not you). For any such foreign-host lines: NEVER guess they are 'off' or \
misconfigured, NEVER drop them, and NEVER fold them into this node's SILENT accounting — instead fold them \
into their OWN per-node digest section, one line prefixed '<hostname>:', reporting only what that host \
actually posted this round. SYNTHESIZE the collected lines into ONE short digest line and post it to the BOARD \
only — do NOT use any voice or Telegram relay (operator silenced voice 2026-06-24); board-internal text \
ONLY. Post with: MESH_WHO=\"roll-call@\$(hostname)\" mesh-chat \"[fyi] roll-call DIGEST: <key PROPOSEs | \
notable CHANGEDs | open GAPs | any expected mind STILL SILENT after its grace | <hostname>: ... per foreign \
node with roll-call lines this round>\". One digest per roll-call; never an empty one. \
BREVITY BUDGET (chat-review/digest-line-truncation, owner mesh-roll-call/genome): the digest is read back \
through views that HARD-CAP a single board line at ~2000 chars, so a longer line is SILENTLY truncated \
mid-item — losing its tail (a real 2994-char digest lost its last suppressed-item rationale 07:04). Keep the \
WHOLE digest UNDER ~1500 chars. PREAMBLE TERSE: when every expected mind answered, write just '(N/N ok)' — do \
NOT enumerate each mind's answer timestamp or 'in during grace' note; NAME a mind ONLY if it is STILL SILENT \
past its grace. If the synthesized content would STILL exceed the budget, PRIORITIZE — keep PROPOSEs + open \
GAPs + RECURRING escalations + any SILENT mind, trim each CHANGED to a short clause — and drop the lowest-\
priority items DELIBERATELY with a trailing '(+N trimmed)' note, so nothing is ever silently cut mid-line. \
PROPOSE-DEDUP (idle_sig principle for proposals — apply BEFORE composing the digest): a SUPPRESS-LEDGER \
follows. DROP from the digest any PROPOSE that (a) matches a GATED entry (operator-gated / settled — NEVER \
re-surface) or (b) merely restates a RECENTLY-RESOLVED subject or (c) was RETRACTED / marked MOOT by its \
own proposer (a self-withdrawn PROPOSE never re-surfaces) — match on INTENT, not wording (a reworded \
same-proposal IS a match). The ledger ALSO carries a RECURRING block — PROPOSEs that recurred across MANY \
rounds yet were NEVER actioned; do NOT suppress those, ESCALATE each: list it as 'RECURRING xN — decide or \
retire' so it is forced to a decision (turn it into a [task] OR gate it), not silently re-listed again. \
Only genuinely NEW, unresolved PROPOSEs reach the digest; CHANGED/GAP are listed \
normally. If EVERY PROPOSE is suppressed, write 'no new PROPOSEs (<N> suppressed as already-answered/gated)'. \
SUPPRESS-LEDGER:
$3"
}

# propose_sig — the canonical INTENT-KEY of a proposal subject (idle_sig dedupe principle, applied to
# PROPOSEs): lowercase, drop punctuation + stopwords + ≤2-char tokens, then sort-unique the remaining key
# tokens. Word order and rewording wash out, so two restatements of the same proposal collapse to ONE key.
# It is order/stopword-invariant, NOT a stemmer (stage≠staged) — deliberately conservative (idle_sig
# doctrine: under-suppression leaks, over-suppression of a status-yield is low-harm; never drop a NEW one).
propose_sig(){
  printf '%s' "$1" | tr 'A-Z' 'a-z' | tr -c 'a-z0-9' ' ' | tr -s ' ' '\n' \
    | grep -vxE '(the|an|to|of|for|and|or|is|are|be|on|in|it|that|this|with|add|new|change|changed|fix|fixed|propose|proposed|would|we|our|its|so|by|as|at|re|gap|done|via|not|but|from|into|one|line|mesh)' \
    | grep -vE '^.{0,2}$' | sort -u | tr '\n' ' ' | sed -E 's/^ +| +$//g'
}

# build_ledger — the SUPPRESS-LEDGER injected into the synth: (1) GATED entries (operator-gated / settled,
# durable, from $GATED_FILE — hard-suppress, never re-surface) + (2) RECENTLY-RESOLVED subjects distilled
# from the last ${LEDGER_DAYS}d of [done]/[resolving] board lines + (3) RETRACTED subjects whose own proposer
# posted a same-round RETRACT/MOOT marker (a self-withdrawn PROPOSE must not re-surface next round — the
# senses dash-liveness PROPOSE was retracted 17:03:30 'MOOT' yet the digest re-listed it open). All three
# deduped by propose_sig so N markers about one thing become ONE ledger line. Bounded: date-window + tail
# cap + 20-line output cap.
build_ledger(){
  echo "GATED — never re-surface:"
  if [ -s "$GATED_FILE" ]; then
    grep -vE '^[[:space:]]*(#|$)' "$GATED_FILE" 2>/dev/null | sed 's/^/  - /'
  else
    echo "  (none recorded — $GATED_FILE absent/empty)"
  fi
  echo "RESOLVED (${LEDGER_DAYS}d):"
  local cutoff; cutoff="$(date -u -d "-${LEDGER_DAYS} days" +%Y-%m-%d 2>/dev/null || echo 0000-00-00)"
  if [ -s "$CHAT_LOG" ]; then
    awk -v c="$cutoff" 'length($0)>=10 && substr($0,1,10) >= c' "$CHAT_LOG" 2>/dev/null \
      | grep -aiE '\[(done|resolving)\]' | tail -n 80 \
      | while IFS= read -r ln; do
          body="${ln##*  ::  }"
          body="$(printf '%s' "$body" | sed -E 's/^\[[A-Za-z-]+\][[:space:]]*//; s/^[A-Za-z0-9@_.-]+:[[:space:]]*//')"
          hl="$(printf '%s' "$body" | sed -E 's/ (—|\(|\|).*$//; s/\.[[:space:]].*$//' | cut -c1-70 | sed -E 's/[[:space:]]+$//')"
          [ -n "$hl" ] || continue
          printf '%s\t%s\n' "$(propose_sig "$hl")" "$hl"
        done \
      | awk -F'\t' 'NF==2 && $1!="" && !seen[$1]++ {print "  - "$2}' | head -n 20
  else
    echo "  (no board log at $CHAT_LOG)"
  fi
  echo "RETRACTED (${LEDGER_DAYS}d):"
  if [ -s "$CHAT_LOG" ]; then
    # Match a PROPOSER's own withdrawal: 'RETRACT[ed] [my|the|its] [roll-call] PROPOSE …' OR
    # '<subj> PROPOSE is now MOOT'. The order constraint (retract→propose adjacent, or propose→moot adjacent)
    # is deliberately tight so [task]/[chat-review] meta lines that merely MENTION a retraction don't match
    # (they read 'a PROPOSE … RETRACTED same-round' — wrong adjacency). A roll-call DIGEST is the synth's own
    # output, not a proposer self-retraction — drop it (its editorial 'X PROPOSE is now MOOT' note would else
    # mine a garbage subject out of the whole digest body).
    awk -v c="$cutoff" 'length($0)>=10 && substr($0,1,10) >= c' "$CHAT_LOG" 2>/dev/null \
      | grep -aiE 'retract[a-z]*[[:space:]]+(my[[:space:]]+|the[[:space:]]+|its[[:space:]]+)?(roll-?call[[:space:]]+)?propose|propose[a-z]*([[:space:]]+is)?([[:space:]]+now)?[[:space:]]+moot' \
      | grep -aiv 'roll-call DIGEST' | tail -n 40 \
      | while IFS= read -r ln; do
          body="${ln##*  ::  }"
          body="$(printf '%s' "$body" | sed -E 's/^\[[A-Za-z-]+\][[:space:]]*//; s/^[A-Za-z0-9@_.-]+:[[:space:]]*//')"
          # subject: parenthetical right after PROPOSE (form A 'RETRACT … PROPOSE (subj): MOOT'); else the
          # clause with retraction scaffolding + the propose keyword stripped (form B '<subj> PROPOSE is now
          # MOOT' / form C 'RETRACT … PROPOSE: <subj>'). Then headline-trim like RECENTLY-RESOLVED.
          subj="$(printf '%s' "$body" | sed -nE 's/.*propose[a-z]*[[:space:]]*\(([^)]+)\).*/\1/Ip')"
          if [ -z "$subj" ]; then
            subj="$(printf '%s' "$body" \
              | sed -E 's/\bretract(ed|ing)?\b//Ig; s/\broll-?call\b//Ig; s/\b(is[[:space:]]+now[[:space:]]+moot|now[[:space:]]+moot|moot)\b//Ig; s/\bpropose[a-z]*\b/ /Ig; s/\b(my|the|its)\b//Ig' \
              | sed -E 's/^[[:space:][:punct:]]+//')"
          fi
          hl="$(printf '%s' "$subj" | sed -E 's/ (—|\(|\||:).*$//; s/\.[[:space:]].*$//' | cut -c1-70 | sed -E 's/[[:space:]]+$//; s/^[[:space:]]+//')"
          [ -n "$hl" ] || continue
          printf '%s\t%s\n' "$(propose_sig "$hl")" "$hl"
        done \
      | awk -F'\t' 'NF==2 && $1!="" && !seen[$1]++ {print "  - "$2}' | head -n 20
  else
    echo "  (no board log at $CHAT_LOG)"
  fi
  build_recurring
}

# build_recurring — the ESCALATION arm the suppress-ledger lacks (chat-review 2026-06-26, owner
# mesh-roll-call/genome). build_ledger only DROPS a PROPOSE that is resolved / gated / retracted; a PROPOSE
# that is NONE of those — open but never converted to a [task] — matches no arm and re-surfaces in EVERY
# digest, re-burning synth tokens with no path to a decision (reproduced on the board: the 'auto-route an
# open [task] to an idle hand' / dispatch-reflex intent recurred 5+ rounds across a day, never [done]/[task]'d
# or retired). This adds the missing arm: count how many DISTINCT roll-call ROUNDS each PROPOSE subject has
# recurred in — read straight from the durable board (the board IS the persistent record; no fragile cross-run
# state file to drift/corrupt) and canonicalised by the SAME propose_sig intent-key so rewordings collapse to
# one count — and FLAG any sig recurring >= RECUR_N rounds that is still un-actioned, so the synth ESCALATES it
# ('RECURRING xN — decide or retire') instead of silently re-listing it. CONSERVATIVE by the idle_sig doctrine
# (under-escalate is safe, over-escalate is noise): default N=3, and a sig is dropped the instant it appears in
# a [done]/[resolving]/[task] subject or the GATED file (= it reached a decision). ROUNDS are gap-bucketed:
# roll-call [fyi] bursts cluster within seconds while rounds are cron-spaced minutes+ apart, so a gap >
# RECUR_ROUND_GAP_S starts a new round; the input is time-sorted first so out-of-order board appends (clock
# skew across nodes) can't corrupt the buckets. (Needs awk mktime — gawk, the fleet default; absent ⇒ the
# section is simply empty, never a crash.)
build_recurring(){
  local N="${RECUR_N:-3}" GAP="${RECUR_ROUND_GAP_S:-300}"
  echo "RECURRING >=${N} — ESCALATE (decide or retire):"
  [ -s "$CHAT_LOG" ] || { echo "  (no board log at $CHAT_LOG)"; return 0; }
  local cutoff; cutoff="$(date -u -d "-${LEDGER_DAYS} days" +%Y-%m-%d 2>/dev/null || echo 0000-00-00)"

  # exclusion sigset — subjects that ALREADY reached a decision: GATED file slugs + [done]/[resolving]/[task]
  # board subjects (last window), each run through propose_sig. A recurring PROPOSE matching one of these is
  # not chronic-unactioned (it has been actioned/settled) → never escalate it.
  local excl; excl="$(mktemp 2>/dev/null)" || excl="$MESH/.rc-recur-excl.$$"
  {
    [ -s "$GATED_FILE" ] && grep -vE '^[[:space:]]*(#|$)' "$GATED_FILE" 2>/dev/null | sed -E 's/[[:space:]]*\|.*$//'
    awk -v c="$cutoff" 'length($0)>=10 && substr($0,1,10) >= c' "$CHAT_LOG" 2>/dev/null \
      | grep -aiE '\[(done|resolving|task)\]' \
      | sed -E 's/^.*  ::  //; s/^\[[A-Za-z-]+\][[:space:]]*//; s/^[A-Za-z0-9@_.-]+:[[:space:]]*//; s/ (—|\(|\|).*$//; s/\.[[:space:]].*$//'
  } | while IFS= read -r s; do [ -n "$s" ] && printf '%s\n' "$(propose_sig "$s")"; done | sort -u > "$excl"

  # mind roll-call PROPOSE lines → "round<TAB>subject": time-sort, gap-bucket rounds (one awk pass; drop the
  # synth's own 'roll-call DIGEST' lines — not a mind's proposal), then sig + count DISTINCT rounds per sig.
  awk -v c="$cutoff" 'length($0)>=10 && substr($0,1,10) >= c' "$CHAT_LOG" 2>/dev/null \
    | grep -aiE '\[fyi\] roll-call ' | grep -aiv 'roll-call DIGEST' | grep -i 'PROPOSE' \
    | sort \
    | awk -v gap="$GAP" '
        { ts=substr($1,1,19); gsub(/[-T:]/," ",ts); e=mktime(ts)
          if(e<=0) next
          if(prev=="" || e-prev>gap) round++
          prev=e
          i=index($0,"PROPOSE "); if(i==0) next
          s=substr($0,i+8); j=index(s," | "); if(j>0) s=substr(s,1,j-1)
          gsub(/^[[:space:]]+|[[:space:]]+$/,"",s)
          if(s!="") print round "\t" s }' 2>/dev/null \
    | while IFS=$'\t' read -r rnd subj; do
        sig="$(propose_sig "$subj")"; [ -n "$sig" ] || continue
        printf '%s\t%s\t%s\n' "$sig" "$rnd" "$subj"
      done \
    | awk -F'\t' '
        { key=$1 SUBSEP $2; if(!(key in seen)){seen[key]=1; cnt[$1]++}
          if(!($1 in maxrnd) || $2+0 > maxrnd[$1]+0){ maxrnd[$1]=$2+0; rep[$1]=$3 } }
        END { for(k in cnt) printf "%d\t%s\t%s\n", cnt[k], k, rep[k] }' \
    | sort -rn \
    | while IFS=$'\t' read -r n sig subj; do
        [ "${n:-0}" -ge "$N" ] || continue
        grep -qxF "$sig" "$excl" 2>/dev/null && continue
        printf '  - RECURRING x%s — %s\n' "$n" "$subj"
      done
  rm -f "$excl"
}

# parse_mode — extract the REAL mode token from `mesh-mode` output (reads from stdin). mesh-mode LEADS
# with a usage/help block, so the old `head -1 | grep -oE [a-z]+` grabbed 'usage' and the synth read
# 'mesh-mode: usage' instead of the live mode. The mode value lives on the `MODE=<token>` line that
# mesh-mode's show_mode always prints — grep THAT, not the first line. (roll-call/mesh-mode-context-leak)
parse_mode(){ grep -oE 'MODE=[A-Za-z]+' | head -1 | cut -d= -f2; }

# inspection / test hooks (no side effects)
case "${1:-}" in
  --ledger) build_ledger; exit 0 ;;
  --sig)    shift; propose_sig "$*"; printf '\n'; exit 0 ;;
esac

# tell — drive a window, or just print the target+prompt under DRYRUN (no real side effect).
tell_local(){  # $1=window $2=prompt
  if [ -n "$DRYRUN" ]; then printf 'TELL local:%s :: %s\n' "$1" "$2"; return 0; fi
  mesh-tell "$1" "$2" >/dev/null 2>&1 || true
}
tell_remote(){ # $1=peer $2=window $3=prompt
  if [ -n "$DRYRUN" ]; then printf 'TELL %s:%s :: %s\n' "$1" "$2" "$3"; return 0; fi
  mesh-tell --node "$1" "$2" "$3" >/dev/null 2>&1 || true
}

# session_mind_windows — the live 2-pane mind-channel windows in this node's hostname session, MINUS
# the synth window. The 2-pane structure (top DATA + bottom MIND, per "every window is data/mind") is
# the signal that a window is a mind channel; a 1-pane window (e.g. a raw 'bash' shell) is not, so it
# is excluded. Used to auto-extend the respondent set so non-consume windows (discover) are wake-poked
# instead of falsely flagged SILENT. tmux-unavailable / no session ⇒ empty (safe: the caller then
# falls back to the curated LOCAL_MINDS baseline). ROLL_CALL_WINDOWS_OVERRIDE ("<name> <panes>" lines)
# mocks the tmux read for a deterministic --test (decoupled from whatever windows exist right now).
session_mind_windows(){
  local sess="${MESH_SESSION:-$(hostname)}"
  if [ -n "${ROLL_CALL_WINDOWS_OVERRIDE:-}" ]; then
    printf '%s\n' "$ROLL_CALL_WINDOWS_OVERRIDE"
  else
    tmux list-windows -t "$sess" -F '#{window_name} #{window_panes}' 2>/dev/null
  fi | awk -v syn="$SYNTH_WIN" 'NF==2 && $2+0>=2 && $1!=syn {print $1}'
}

# ── --test: fully sandboxed dry-run (no tmux, no board, no TG, no voice) ──────────────────────────
if [ "${1:-}" = --test ]; then
  _td="$(mktemp -d /tmp/mrc-test.XXXXXX)" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
  trap 'rm -rf "$_td"' EXIT
  # sandbox EVERY side effect (reflex-test-must-sandbox): DRYRUN ⇒ no real mesh-tell/board/TG/voice;
  # MESH_DIR ⇒ marker/log writes land in the temp dir, never real ~/.mesh; deterministic marker.
  # Seed the PROPOSE-DEDUP ledger sources INTO the temp MESH_DIR so the injected synth carries a real
  # ledger (a GATED slug + a RECENTLY-RESOLVED subject + a self-RETRACTED subject) — proving the dedup
  # wiring end-to-end, sandboxed.
  printf 'test-gated-cap | operator-gated test entry (MESH_WEEKLY_PAID_CAP-like)\n# a comment line\n' > "$_td/proposals-gated"
  printf '%s  pub@host  ::  [done] pub: draft-staging package finalized — already shipped\n' "$(date -u +%FT%TZ)" > "$_td/chat.log"
  # a real proposer self-retraction (form A: parenthetical subject after PROPOSE) — MUST be suppressed
  printf '%s  senses@host  ::  [fyi] RETRACT my roll-call PROPOSE (sandbox-retract-subj): MOOT — verified already handled, no work needed\n' "$(date -u +%FT%TZ)" >> "$_td/chat.log"
  # a [chat-review] meta line that merely MENTIONS a retraction (wrong adjacency) — MUST NOT over-suppress
  printf '%s  chat@host  ::  [chat-review] digest re-surfaces a PROPOSE the proposer RETRACTED same-round — fix the dedup ledger\n' "$(date -u +%FT%TZ)" >> "$_td/chat.log"
  # RECURRENCE seeds (build_recurring escalation arm): 3 DISTINCT rounds 10min apart (> RECUR_ROUND_GAP_S=300),
  # past-timestamped so gap-bucketing sees 3 rounds. (A) a chronic PROPOSE REWORDED each round (same intent-key)
  # and NEVER actioned → must ESCALATE 'RECURRING x3'. (B) one that recurs 3 rounds but HAS a [task] → exclusion
  # must DROP it. (C) one in only 2 rounds → BELOW threshold, must NOT escalate (no over-escalation).
  _t30="$(date -u -d '-30 min' +%FT%TZ 2>/dev/null || date -u +%FT%TZ)"
  _t20="$(date -u -d '-20 min' +%FT%TZ 2>/dev/null || date -u +%FT%TZ)"
  _t10="$(date -u -d '-10 min' +%FT%TZ 2>/dev/null || date -u +%FT%TZ)"
  printf '%s  genome@host  ::  [fyi] roll-call genome: PROPOSE wire the spend sampler cron post reorg | CHANGED s | GAP s\n' "$_t30" >> "$_td/chat.log"
  printf '%s  minds@host  ::  [fyi] roll-call minds: PROPOSE post reorg wire spend sampler cron | CHANGED s | GAP s\n' "$_t20" >> "$_td/chat.log"
  printf '%s  genome@host  ::  [fyi] roll-call genome: PROPOSE cron spend sampler wire post reorg | CHANGED s | GAP s\n' "$_t10" >> "$_td/chat.log"
  for _tt in "$_t30" "$_t20" "$_t10"; do printf '%s  room@host  ::  [fyi] roll-call room: PROPOSE foobar widget gate occupancy | CHANGED s | GAP s\n' "$_tt" >> "$_td/chat.log"; done
  printf '%s  minds@host  ::  [task] dispatch: foobar widget gate occupancy — wire it\n' "$(date -u -d '-5 min' +%FT%TZ 2>/dev/null || date -u +%FT%TZ)" >> "$_td/chat.log"
  for _tt in "$_t30" "$_t20"; do printf '%s  health@host  ::  [fyi] roll-call health: PROPOSE qux zlonk telemetry probe | CHANGED s | GAP s\n' "$_tt" >> "$_td/chat.log"; done
  # mock the live session's windows so the auto-extend is DETERMINISTIC (not coupled to whatever
  # windows happen to exist right now): the real layout — bash(1-pane, must be EXCLUDED as a non-mind),
  # the 7 baseline minds, tg(synth, must be EXCLUDED), and discover(2-pane non-baseline, must be
  # AUTO-INCLUDED — the rollcall-wake-nonconsume fix: a non-consume window is wake-poked).
  _wov=$'bash 1\nminds 2\ngenome 2\ntg 2\nsenses 2\nhealth 2\nchat 2\nroom 2\npub 2\ndiscover 2'
  # pin a with-minds card fixture so the CARD-AUTHORITATIVE gate always PASSES here regardless of the
  # node running --test (a minds-off node's real card would otherwise gate the whole run off → node-
  # dependent test). MESH_CARD overrides $HOME/.mesh-card.
  printf '  minds: claude opencode\n' > "$_td/card-minds"
  out="$(ROLL_CALL_DRYRUN=1 ROLL_CALL_WINDOWS_OVERRIDE="$_wov" MESH_MODE_OVERRIDE=test MESH_DIR="$_td" MESH_ROLL_CALL_NOW=1 MESH_CARD="$_td/card-minds" "$0" 2>&1)"; fail=0
  chk(){ printf '%s' "$out" | grep -qF "$1" && echo "  ok: $2" || { echo "  FAIL: $2 (missing: $1)"; fail=1; }; }
  # every local mind window prompted
  for w in minds genome senses health chat room pub; do chk "TELL local:$w ::" "prompted local mind '$w'"; done
  # auto-extend (rollcall-wake-nonconsume): a live 2-pane mind window NOT in the curated baseline
  # (discover) is wake-poked; a 1-pane non-mind window (bash) is NOT; tg stays the synth.
  chk "TELL local:discover ::" "non-consume mind window 'discover' auto wake-poked (not invisible to roll-call)"
  printf '%s' "$out" | grep -q 'TELL local:bash ::' && { echo "  FAIL: 1-pane non-mind window 'bash' was prompted (must be excluded)"; fail=1; } || echo "  ok: 1-pane non-mind window 'bash' excluded from respondents"
  # tg must NOT be roll-called as a respondent (it is the synthesizer)
  printf '%s' "$out" | grep -q 'TELL local:tg ::' && { echo "  FAIL: tg was roll-called as a respondent (must be synth-only)"; fail=1; } || echo "  ok: tg excluded from respondents"
  # remote lean-node minds prompted
  chk "TELL phaedra:genome ::" "prompted phaedra:genome"
  chk "TELL phaedra:chat ::" "prompted phaedra:chat"
  # 3-field template present in the respondent prompt
  chk "PROPOSE " "respondent template has PROPOSE"; chk "CHANGED " "respondent template has CHANGED"; chk "GAP " "respondent template has GAP"
  # SOURCE-side dedup (chat-review/rollcall-propose-dedup): the respondent prompt itself must carry
  # the check-your-own-last-line rule + the 'unchanged' escape so an identical PROPOSE is never respelled
  chk "FIRST check the board for your own previous line" "respondent prompt carries source-side dedup check"
  chk "PROPOSE unchanged" "respondent prompt offers the 'unchanged' escape (no verbatim re-post)"
  chk "[fyi] roll-call" "respondent posts a tagged [fyi] roll-call line"
  # synth step present, targets tg, and posts a BOARD digest — NOT a voice/Telegram relay (operator silenced)
  chk "TELL synth:tg ::" "tg synthesis step injected"
  chk "[roll-call-synth]" "synth prompt tagged"
  chk "[fyi] roll-call DIGEST" "synth posts a board-internal [fyi] DIGEST"
  printf '%s' "$out" | grep -q 'mesh-voice-tx' && { echo "  FAIL: synth still references mesh-voice-tx (operator silenced voice 2026-06-24)"; fail=1; } || echo "  ok: NO voice/Telegram relay (mesh-voice-tx absent)"
  chk "HOLD" "synth holds until enough lines arrive (no hollow digest)"
  chk "ONE-TICK GRACE" "synth grants a one-tick grace before naming a late mind SILENT"
  chk "STILL SILENT after its grace" "digest flags only minds silent past the grace window"
  chk "FINAL RE-SCAN BEFORE POSTING" "synth re-reads the board immediately before posting to catch late arrivals"
  # BREVITY BUDGET (chat-review/digest-line-truncation): the synth must cap the posted board DIGEST so a long
  # digest is never SILENTLY truncated mid-item by the ~2000-char single-line view cap — terse preamble + budget.
  chk "BREVITY BUDGET" "synth carries the digest length-budget rule (no silent mid-line truncation)"
  chk "(N/N ok)" "synth preamble is terse when all answered (no per-mind timestamp enumeration)"
  chk "(+N trimmed)" "synth drops over-budget items DELIBERATELY with a trimmed-count note, never silently"
  # PROPOSE-DEDUP: the synth must carry the suppress rule + a real ledger built from the seeded sources.
  chk "PROPOSE-DEDUP" "synth carries the propose-dedup rule"
  chk "SUPPRESS-LEDGER" "synth injects the suppress-ledger block"
  # rollcall-digest-expected-set: the synth must carry a real ground-truth target list (this node's
  # LOCAL_MINDS + REMOTE_MINDS) and the instruction to fold foreign-host lines into their OWN section
  # instead of guessing them off — the live bug: a 12:01Z digest declared a peer node 'off by
  # card-gate' and dropped its 6 minds' PROPOSEs/GAPs.
  chk "EXPECTED-RESPONDER SET" "synth carries the expected-responder ground-truth block"
  chk "local (" "expected-set names THIS node's local target list"
  chk "fold them into their OWN per-node digest section" "synth folds foreign-host lines into per-node sections instead of judging them off"
  printf '%s' "$out" | grep -qF "$(hostname)" || { echo "  FAIL: expected-set does not name this host"; fail=1; }
  chk "match on INTENT" "dedup matches on intent (idle_sig principle), not bytes"
  chk "test-gated-cap" "ledger surfaces a GATED entry from proposals-gated"
  chk "draft-staging" "ledger surfaces a RECENTLY-RESOLVED subject from a board [done] line"
  printf '%s' "$out" | grep -q '# a comment line' && { echo "  FAIL: ledger leaked a #-comment line from proposals-gated"; fail=1; } || echo "  ok: proposals-gated #-comments stripped"
  # RETRACTED (the new third source): the synth rule carries clause (c) and the ledger surfaces a
  # self-retracted subject, while a meta line that merely MENTIONS a retraction does NOT over-suppress.
  chk "self-withdrawn PROPOSE never re-surfaces" "synth suppress rule covers self-retracted PROPOSEs (clause c)"
  chk "RETRACTED (3d):" "ledger carries the RETRACTED block"
  chk "sandbox-retract-subj" "ledger surfaces a self-RETRACTED subject from the proposer's own RETRACT line"
  printf '%s' "$out" | grep -qiF "re-surfaces a PROPOSE the proposer" && { echo "  FAIL: retraction scan over-matched a [chat-review] meta line (not a self-retraction → over-suppression)"; fail=1; } || echo "  ok: retraction scan ignores meta lines that merely mention retract/propose (no over-suppression)"
  # propose_sig (the dedupe canonicalizer): order + stopword + rewording invariant → same intent → same key.
  s1="$(ROLL_CALL_DRYRUN=1 MESH_DIR="$_td" "$0" --sig "stage the draft Show HN package")"
  s2="$(ROLL_CALL_DRYRUN=1 MESH_DIR="$_td" "$0" --sig "Show HN draft package stage")"
  [ -n "$s1" ] && [ "$s1" = "$s2" ] && echo "  ok: propose_sig collapses reworded same-intent proposals (key='$s1')" || { echo "  FAIL: propose_sig must collapse rewordings (s1='$s1' s2='$s2')"; fail=1; }
  s3="$(ROLL_CALL_DRYRUN=1 MESH_DIR="$_td" "$0" --sig "wire up the spend sampler cron")"
  [ "$s1" != "$s3" ] && echo "  ok: propose_sig keeps DISTINCT proposals distinct (no over-suppression)" || { echo "  FAIL: propose_sig collapsed two DIFFERENT proposals (over-suppression)"; fail=1; }
  # mode-context leak fix (roll-call/mesh-mode-context-leak): the real mode token comes from the MODE=
  # line, NOT head -1 — mesh-mode leads with a usage block. parse_mode must return the token, never 'usage'.
  _mm="$(printf 'usage: mesh-mode [<mode>]\n       mesh-mode --list\nModes:\nMODE=sprint\nLABEL=all minds at accelerated cadence\n')"
  _pm="$(printf '%s' "$_mm" | parse_mode)"
  [ "$_pm" = "sprint" ] && echo "  ok: mode-context reads the real MODE= token (sprint), not the 'usage' preamble" || { echo "  FAIL: parse_mode must read the MODE= token (got '$_pm', not 'sprint')"; fail=1; }
  # --ledger inspection hook returns the gated + resolved + retracted entries (sandboxed read).
  led="$(MESH_DIR="$_td" "$0" --ledger 2>&1)"
  printf '%s' "$led" | grep -qF "test-gated-cap" && printf '%s' "$led" | grep -qF "draft-staging" \
    && printf '%s' "$led" | grep -qF "sandbox-retract-subj" \
    && echo "  ok: --ledger prints gated + resolved + retracted entries" || { echo "  FAIL: --ledger missing seeded entries"; fail=1; }
  # RECURRING escalation (build_recurring): a chronic, NEVER-actioned PROPOSE seen in >=3 distinct rounds
  # (rewordings collapsed by propose_sig) must ESCALATE 'RECURRING x3'; one with a matching [task] must be
  # EXCLUDED; a 2-round one is BELOW threshold (no over-escalation). Scope checks to the RECURRING section.
  recur_sec="$(printf '%s' "$led" | sed -n '/^RECURRING/,$p')"
  printf '%s' "$recur_sec" | grep -q 'RECURRING x3' && printf '%s' "$recur_sec" | grep -qi 'sampler' \
    && echo "  ok: chronic never-actioned PROPOSE escalated (RECURRING x3; intent-key collapsed 3 rewordings)" \
    || { echo "  FAIL: chronic 3-round unactioned PROPOSE not escalated as RECURRING x3 (got: $recur_sec)"; fail=1; }
  printf '%s' "$recur_sec" | grep -qi 'foobar' \
    && { echo "  FAIL: a recurring PROPOSE that HAS a [task] was escalated (exclusion broken)"; fail=1; } \
    || echo "  ok: recurring-but-actioned PROPOSE excluded from escalation (matching [task])"
  # chat-review/roll-call-recurring-stale-label: the representative wording shown for a chronic RECURRING
  # sig must be the MOST-RECENT round's phrasing, not whichever historical rewording happened to be
  # LONGEST. The 3 seeded rewordings above are oldest-round(t30)=longest(38 chars), then two shorter
  # (34 chars each) at t20/t10 — a "longest wins" picker freezes on the t30 text forever; a "most-recent
  # round wins" picker must show the t10 (newest) text.
  printf '%s' "$recur_sec" | grep -qF "cron spend sampler wire post reorg" \
    && echo "  ok: RECURRING representative text is the MOST-RECENT round's wording, not frozen-longest" \
    || { echo "  FAIL: RECURRING representative text is not the most-recent round's wording (got: $recur_sec)"; fail=1; }
  printf '%s' "$recur_sec" | grep -qF "wire the spend sampler cron post reorg" \
    && { echo "  FAIL: RECURRING representative text is still the STALE oldest/longest wording (roll-call-recurring-stale-label regression)"; fail=1; } \
    || echo "  ok: stale oldest/longest wording no longer shown as the representative"
  printf '%s' "$recur_sec" | grep -qi 'zlonk' \
    && { echo "  FAIL: a 2-round PROPOSE was escalated (over-escalation below RECUR_N)"; fail=1; } \
    || echo "  ok: below-threshold (2-round) PROPOSE not escalated"
  # CARD-AUTHORITATIVE GATE (rollcall-card-gate): a HANDS-OFF node (card declares no AI mind) must exit
  # WITHOUT pinging any window; a with-minds card (the main run above) already proves the pass-path.
  # Falsify each direction. NOTE: the with-minds pass-path IS the whole `out` run above (10 TELLs) —
  # if the gate wrongly fired there, every assertion above would already have failed.
  printf '  role: compute\n# minds: BLANKED (minds-off)\n' > "$_td/card-nominds"
  goff="$(ROLL_CALL_DRYRUN=1 ROLL_CALL_WINDOWS_OVERRIDE="$_wov" MESH_MODE_OVERRIDE=test MESH_DIR="$_td" MESH_ROLL_CALL_NOW=1 MESH_CARD="$_td/card-nominds" "$0" 2>&1)"
  printf '%s' "$goff" | grep -q 'TELL ' && { echo "  FAIL: no-minds card still pinged windows (card-gate not applied)"; fail=1; } || echo "  ok: no-minds card → zero window pings (HANDS-OFF gate)"
  printf '%s' "$goff" | grep -qF "minds declared OFF" && echo "  ok: no-minds card surfaces the HANDS-OFF skip reason" || { echo "  FAIL: no-minds skip reason not surfaced"; fail=1; }
  # a `minds:` line present but listing NO known engine (blanked value) is ALSO HANDS-OFF
  printf '  minds:\n' > "$_td/card-emptyminds"
  gempty="$(ROLL_CALL_DRYRUN=1 ROLL_CALL_WINDOWS_OVERRIDE="$_wov" MESH_MODE_OVERRIDE=test MESH_DIR="$_td" MESH_ROLL_CALL_NOW=1 MESH_CARD="$_td/card-emptyminds" "$0" 2>&1)"
  printf '%s' "$gempty" | grep -q 'TELL ' && { echo "  FAIL: empty minds: value still pinged (must be HANDS-OFF)"; fail=1; } || echo "  ok: empty minds: value → HANDS-OFF (no pings)"
  # RESTORE.ENV-DECLARED MINDS-OFF (chat-review/doctor-autonomy-check-minds-off-cryolf 2026-07-08): a
  # card that STILL lists installed binaries (mesh-card --refresh auto-detects them, so it can never
  # self-clear once binaries are present) must be overridden by restore.env's own MESH_MIND_CHANNELS=
  # none/empty — the durable off-switch on a node like Default-string (binaries installed, minds
  # driving deliberately OFF since 2026-06-17).
  printf 'MESH_MIND_CHANNELS=none\n' > "$_td/restore.env"
  goffrenv="$(ROLL_CALL_DRYRUN=1 ROLL_CALL_WINDOWS_OVERRIDE="$_wov" MESH_MODE_OVERRIDE=test MESH_DIR="$_td" MESH_ROLL_CALL_NOW=1 MESH_CARD="$_td/card-minds" "$0" 2>&1)"
  printf '%s' "$goffrenv" | grep -q 'TELL ' && { echo "  FAIL: restore.env MESH_MIND_CHANNELS=none still pinged windows despite a mind-listing card (restore.env override not applied)"; fail=1; } || echo "  ok: restore.env MESH_MIND_CHANNELS=none → HANDS-OFF even with a mind-listing card"
  rm -f "$_td/restore.env"   # don't leak into the fail-safe/no-card test below
  # FAIL-SAFE: NO card file at all → RUN (never silence a healthy node on a missing card / fresh boot)
  gnocard="$(ROLL_CALL_DRYRUN=1 ROLL_CALL_WINDOWS_OVERRIDE="$_wov" MESH_MODE_OVERRIDE=test MESH_DIR="$_td" MESH_ROLL_CALL_NOW=1 MESH_CARD="$_td/does-not-exist" "$0" 2>&1)"
  printf '%s' "$gnocard" | grep -q 'TELL local:genome ::' && echo "  ok: missing card → roll-call RUNS (fresh-boot fail-safe, not silenced)" || { echo "  FAIL: missing card wrongly gated off a healthy node (boot fail-safe broken)"; fail=1; }
  # no real outbound leaked (DRYRUN must mean NO mesh-tell process was spawned — assert by absence of failures above + bounded output)
  [ "$fail" = 0 ] && { echo "smoke-test: ok (10 minds prompted [7 baseline+discover auto-extend, 2 remote] + tg synth→BOARD digest [no voice], 3-field template, PROPOSE-DEDUP ledger [gated+resolved+retracted+intent-key] + RECURRING escalation + CARD-AUTHORITATIVE gate [no-minds/empty-minds HANDS-OFF, missing-card fail-safe], fully sandboxed)"; exit 0; }
  echo "smoke-test: FAIL"; exit 1
fi

# ── live run ─────────────────────────────────────────────────────────────────────────────────────
mkdir -p "$MESH"
# CARD-AUTHORITATIVE GATE (rollcall-card-gate): a HANDS-OFF node (card declares no AI mind) must not
# roll-call — no window pings, no tg synth. Fires BEFORE any tell so a minds-off node stays fully off
# the mind plane (the ds off-mesh-ping + digest-misflag this fixes). Missing card → runs (boot fail-safe).
if node_minds_off; then
  echo "$(date -u +%FT%TZ) roll-call: SKIP — minds declared OFF (card lacks a minds: engine, or restore.env MESH_MIND_CHANNELS=none) (HANDS-OFF gate)" >> "$MESH/roll-call.log" 2>/dev/null || true
  echo "ROLL-CALL SKIP: minds declared OFF (card lacks a minds: engine, or restore.env MESH_MIND_CHANNELS=none) — node not on the mind plane"
  exit 0
fi
marker="${MESH_ROLL_CALL_NOW:-$(date +%s)}"          # epoch; override only for deterministic tests
printf '%s\n' "$marker" > "$MESH/.roll-call.ts" 2>/dev/null || true
mode="${MESH_MODE_OVERRIDE:-$(mesh-mode 2>/dev/null | parse_mode)}"
mode="${mode:-normal}"   # parse_mode reads the MODE=<token> line (skips the usage preamble); default if absent

# auto-extend the DEFAULT respondent set with any live 2-pane mind window not already listed (e.g.
# discover) so non-consume windows are wake-poked. Skipped when ROLL_CALL_MINDS is an explicit
# override (respect a curated subset). Empty enumeration (no tmux/session) ⇒ baseline unchanged.
if [ -z "${ROLL_CALL_MINDS:-}" ]; then
  for w in $(session_mind_windows); do
    case " $LOCAL_MINDS " in *" $w "*) :;; *) LOCAL_MINDS="$LOCAL_MINDS $w";; esac
  done
fi

prompted=0
for w in $LOCAL_MINDS; do tell_local "$w" "$(respond_prompt "$w")"; prompted=$((prompted+1)); done
for pw in $REMOTE_MINDS; do
  peer="${pw%%:*}"; win="${pw#*:}"
  tell_remote "$peer" "$win" "$(respond_prompt "$win")"; prompted=$((prompted+1))
done

# inject the synthesis step into the tg window — with the PROPOSE-DEDUP suppress-ledger so the digest
# never re-surfaces an already-answered or operator-gated PROPOSE (idle_sig dedupe principle).
ledger="$(build_ledger)"
# expected-responder set (rollcall-digest-expected-set): the synth's ONLY ground truth for judging
# silence is what THIS node's roll-call actually targeted — $LOCAL_MINDS (post auto-extend, above)
# + $REMOTE_MINDS. Anything else on the board is a foreign host's own roll-call, not ours to judge.
expected_set="local ($(hostname)): $LOCAL_MINDS; remote: ${REMOTE_MINDS:-none}"
synth="$(synth_prompt "$marker" "$mode" "$ledger" "$expected_set")"
if [ -n "$DRYRUN" ]; then printf 'TELL synth:%s :: %s\n' "$SYNTH_WIN" "$synth"
else mesh-tell "$SYNTH_WIN" "$synth" >/dev/null 2>&1 || true; fi

# one bounded trace line (durable history tier; NOT the board — the minds' [fyi]s are the board signal)
ts="$(date -u +%FT%TZ)"
echo "$ts roll-call: prompted $prompted mind(s) (mode=$mode marker=$marker) → tg synth→board digest" >> "$MESH/roll-call.log" 2>/dev/null || true
[ "$(wc -l < "$MESH/roll-call.log" 2>/dev/null || echo 0)" -gt 2000 ] && { tail -1000 "$MESH/roll-call.log" > "$MESH/roll-call.log.tmp" && mv "$MESH/roll-call.log.tmp" "$MESH/roll-call.log"; }
[ -n "$DRYRUN" ] || echo "roll-call: prompted $prompted mind(s) (mode=$mode) → tg will synthesize + post board digest"
exit 0
