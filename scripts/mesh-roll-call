#!/usr/bin/env bash
# mesh-roll-call — a low-rate fleet HEARTBEAT OF INTENT. Every ~5h it asks each mind for a 3-field
# status ([fyi] PROPOSE / CHANGED / GAP, ONE line to mesh-chat), then has the tg-mind synthesize all
# the roll-call lines into ONE board-internal [fyi] DIGEST (NOT voice — operator silenced mesh-voice-tx 2026-06-24).
#
# It belongs to the minds-control family (sits beside mesh-mind-control / mesh-mode): mind-control
# routes/allocates work tick-to-tick; mesh-mode sets the burn envelope; roll-call is the slow pulse
# that surfaces, across the whole fleet at once, what each mind WOULD change, what it DID, and where
# it is BLOCKED — drift + intent the per-tick view never aggregates. The current mesh-mode is passed
# to the synthesis as context so the digest reads against the active burn posture.
#
# BOUNDED BY DESIGN — must NEVER burn the consume loop:
#   * one mesh-tell (a cheap tmux paste) per mind, once per 5h; the minds answer ONE line on their own
#     next tick (roll-call does not block on them).
#   * the synthesis is one tg-mind action; it HOLDS (re-checks next tick) until enough lines arrived,
#     so it never relays a hollow digest and never spins.
#
#   mesh-roll-call            run a roll-call: prompt every mind window + phaedra genome/chat, then
#                             inject the tg synthesis step (carrying the PROPOSE-DEDUP suppress-ledger)
#   mesh-roll-call --ledger   print the current SUPPRESS-LEDGER (gated + recently-resolved + retracted
#                             subjects + the RECURRING escalation block) — the same block injected into the synth; for inspection
#   mesh-roll-call --sig TEXT  print the propose_sig (intent-key) of TEXT — the dedupe canonicalizer
#   mesh-roll-call --recur M   print mind M's own chronic-PROPOSE notice ('xN — <subject>') if it has
#                             one (>=RECUR_N rounds, un-actioned, M = most-recent proposer) — the same
#                             lookup the respondent prompt's file-or-retire clause rides on; else nothing
#   mesh-roll-call --test     sandboxed dry-run (ROLL_CALL_DRYRUN=1): prints the targets+prompts to
#                             stdout, fires NO real mesh-tell / board / TG / voice; asserts the window
#                             set, the 3-field PROPOSE/CHANGED/GAP template, the synth step, AND the
#                             PROPOSE-DEDUP ledger (gated + resolved + retracted suppression, intent-key collapse)
#
# PROPOSE-DEDUP: the synth re-surfaced already-answered/operator-gated/self-retracted PROPOSEs every round.
# roll-call now injects a SUPPRESS-LEDGER (operator-gated $MESH/proposals-gated + recently-[done]/RESOLVING
# board subjects + PROPOSEs whose own proposer posted a same-round RETRACT/MOOT marker, deduped by propose_sig
# intent-key) and the synth DROPS any PROPOSE matching it. idle_sig principle for PROPOSEs.
# It ALSO ESCALATES the opposite failure — a PROPOSE that is NEVER actioned: build_recurring counts how many
# distinct rounds each PROPOSE recurred in (from the board, propose_sig-collapsed) and flags any >= RECUR_N
# still-unactioned as 'RECURRING xN — decide or retire' so a chronic proposal is forced to a decision instead
# of re-burning synth tokens every round (chat-review 2026-06-26, owner mesh-roll-call/genome).
# THE ESCALATION HAS A DECIDER (chat-review/rollcall-recurring-has-no-decider 2026-07-16): the digest's
# 'decide or retire' line alone was addressed to nobody (dispatch never routes a digest; counters climbed
# x8/x7/x6/x3 for days). Two arms close it: (a) SOURCE-SIDE — the respondent prompt of the chronic sig's
# most-recent proposer carries its live count + a forced file-or-retire clause (recur_for_mind); (b)
# BACKSTOP — at >=2xRECUR_N the run posts ONE [task] roll-call/adjudicate-<sig-slug> (owner: minds), once
# per sig, so a proposer that keeps dodging gets a dispatched decider.
#
# Tunables (env): ROLL_CALL_MINDS (local windows) · ROLL_CALL_REMOTE ("<peer>:<win> …") ·
#                 ROLL_CALL_SYNTH_WIN (synthesizer window, default tg) · ROLL_CALL_MIN_LINES.
#
# reflex-cadence: 0 */5 * * *
set -uo pipefail
# cron PATH gap (memory cron-path-gap-bare-tool-calls): cron's minimal PATH lacks ~/.local/bin, so the
# bare mesh-tell / mesh-mode / mesh-chat calls below would "not found". Prepend it so the wired reflex
# actually drives the panes (the --test passes interactively even without this, so it must be here).
export PATH="$HOME/.local/bin:$PATH"
MESH="${MESH_DIR:-$HOME/.mesh}"
CARD="${MESH_CARD:-$HOME/.mesh-card}"   # card-authoritative gate (rollcall-card-gate) — see node_minds_off
SYNTH_WIN="${ROLL_CALL_SYNTH_WIN:-tg}"
# local mind windows to roll-call. The default baseline is AUTO-EXTENDED (in the live run, below)
# with every live 2-pane mind window in this node's session — the "data+mind" convention means a
# 2-pane window IS a mind channel — so a non-consume-driven window that isn't on any consume loop
# (e.g. discover, revived 7330f6c) is wake-poked too, not silently invisible + falsely flagged
# SILENT (cf55ad3's grace only delayed the false flag; the root cause was a hand-maintained list
# drifting from the real windows). tg is EXCLUDED — it is the SYNTHESIZER ($SYNTH_WIN), not a
# respondent. ROLL_CALL_MINDS overrides the WHOLE set (a curated subset); auto-extend applies to
# the default only.
LOCAL_MINDS="${ROLL_CALL_MINDS:-minds genome senses health chat room pub}"
# remote lean-node minds, "<peer>:<window>" (resolved via mesh-tell --node <peer>).
REMOTE_MINDS="${ROLL_CALL_REMOTE:-phaedra:genome phaedra:chat}"
MIN_LINES="${ROLL_CALL_MIN_LINES:-3}"      # synth holds until at least this many roll-call lines arrive
GRACE_S="${ROLL_CALL_GRACE_S:-120}"        # ONE-TICK grace: a mind still unanswered when MIN_LINES is
                                           # reached gets this long (re-check next tick) before being named
                                           # SILENT — late-but-alive ≠ dead (health answered 12s late 02:00:57)
# PROPOSE-DEDUP ledger (idle_sig principle for proposals): the synth re-surfaced PROPOSEs already answered
# or operator-gated every round (pub re-proposed draft-staging at 07:00+12:00 though both were DONE; minds'
# MESH_WEEKLY_PAID_CAP recurred though operator-gated). roll-call now builds a SUPPRESS-LEDGER from two
# sources and injects it into the synth so the digest DROPS an already-answered PROPOSE before listing it.
LEDGER_DAYS="${ROLL_CALL_LEDGER_DAYS:-3}"  # how far back to scan resolved [done]/RESOLVING for the ledger
GATED_FILE="${MESH_PROPOSALS_GATED:-$MESH/proposals-gated}"  # durable operator-gated / settled list ('slug | why', # comments ok)
CHAT_LOG="${MESH_CHAT_LOG:-$MESH/chat.log}"
DRYRUN="${ROLL_CALL_DRYRUN:-}"

# node_minds_off — the CARD-AUTHORITATIVE gate (rollcall-card-gate, minds 2026-07-06). roll-call is a
# mind-touching tool (it pings mind windows + injects a tg synth), so like mesh-restore / mesh-mind-
# keepalive / mesh-channel-keepalive it must NOT run on a node the card declares HANDS-OFF
# ([[card-capability-authoritative]]). A minds-off node (e.g. default-string: card `minds:` line
# blanked/absent, role=compute) that autowired its OWN roll-call was pinging OFF-MESH windows and the
# digest misflagged their silence as a liveness problem. Contract, matching the keepalive idiom:
#   • card present + `minds:` lists a known engine (claude/opencode/gemini/codex) → RUN
#   • card present + no such `minds:` engine (blanked value OR no `minds:` line) → HANDS-OFF (rc 0)
#   • NO card file at all → RUN — fresh-boot FAIL-SAFE: never silence a healthy node on a missing card
#     (mesh-card --refresh regenerates it early in mesh-restore). Same posture as mesh-channel-keepalive.
#   • restore.env's own MESH_MIND_CHANNELS is empty/'none' → HANDS-OFF (rc 0), REGARDLESS of the card.
#     (chat-review/doctor-autonomy-check-minds-off-cryolf 2026-07-08): `mesh-card --refresh` regenerates
#     `minds:` from INSTALLED BINARIES, so a node that's deliberately minds-driving-OFF via restore.env
#     but still has claude/opencode binaries installed shows 'minds: claude opencode' on its card
#     forever — the card-only gate above can never be the off-switch on that node. Default-string:
#     MESH_MIND_CHANNELS=none since 2026-06-17, card still 'minds: claude opencode ollama'.
#     KEEP IN SYNC with mesh-doctor's minds_declared_off().
node_minds_off(){  # rc 0 = HANDS-OFF (skip roll-call); rc 1 = run
  local renv="$MESH/restore.env" line val
  if [ -f "$renv" ]; then
    line="$(grep -E '^[[:space:]]*(export[[:space:]]+)?MESH_MIND_CHANNELS=' "$renv" 2>/dev/null | tail -1)"
    if [ -n "$line" ]; then
      val="$(printf '%s' "$line" | sed -E 's/^[[:space:]]*(export[[:space:]]+)?MESH_MIND_CHANNELS=//; s/[[:space:]]*(#.*)?$//; s/^"//; s/"$//; s/^'"'"'//; s/'"'"'$//')"
      case "$val" in ''|none|NONE|None) return 0 ;; esac
    fi
  fi
  [ -f "$CARD" ] || return 1
  grep -iE '^[[:space:]]*minds:' "$CARD" 2>/dev/null | grep -qwE 'claude|opencode|gemini|codex' && return 1
  return 0
}

# retired_channels — the space-separated MESH_RETIRED_CHANNELS for THIS node (a channel decommissioned
# by design: no window planted at all, not even a data-only placeholder — see mesh-restore is_retired()).
# A retired channel MUST be filtered out of the respondent set: it can never answer, so leaving it in
# LOCAL_MINDS pings a dead window AND lists it in the expected-responder set, where the tg synth then
# names it SILENT and files a phantom liveness-check (live: the 4-round 'minds/chat/room SILENT' the tg
# mind hand-diagnosed as phantom targets 2026-07-29T00:04Z — chat/room/minds are all in
# MESH_RETIRED_CHANNELS but the curated LOCAL_MINDS baseline still named chat+room, and minds is neither
# live nor baseline-current). Read from restore.env (cron does NOT source it — same file-parse idiom as
# node_minds_off), OR an already-exported env value (tests). Empty when unset ⇒ nothing filtered (safe).
retired_channels(){
  local renv="$MESH/restore.env" line val
  if [ -n "${MESH_RETIRED_CHANNELS+x}" ]; then printf '%s' "$MESH_RETIRED_CHANNELS"; return; fi
  [ -f "$renv" ] || return 0
  line="$(grep -E '^[[:space:]]*(export[[:space:]]+)?MESH_RETIRED_CHANNELS=' "$renv" 2>/dev/null | tail -1)"
  [ -n "$line" ] || return 0
  val="$(printf '%s' "$line" | sed -E 's/^[[:space:]]*(export[[:space:]]+)?MESH_RETIRED_CHANNELS=//; s/[[:space:]]*(#.*)?$//; s/^"//; s/"$//; s/^'"'"'//; s/'"'"'$//')"
  printf '%s' "$val"
}

# the 3-field template a mind answers with — ONE [fyi] line, tagged 'roll-call <name>' so the synth
# step can grep just these lines. Explicitly a STATUS PING: the mind must not spawn new work off it.
# SOURCE-side PROPOSE dedup (chat-review/rollcall-propose-dedup 2026-07-05): the synth ledger
# suppresses ANSWERED/gated proposals, but an unchanged still-open PROPOSE was re-posted verbatim by
# its proposer every round (57 identical PROPOSEs measured, ~26% of the board) — dedup must happen
# where the line is BORN, not only at synthesis. The prompt now tells the mind to check its own last
# roll-call line first and post 'PROPOSE unchanged' instead of repeating itself.
respond_prompt(){ # $1 = mind label (its window name) · $2 = optional live recurrence notice
                  #      ('xN — <subject>' from recur_for_mind) — when set, the prompt FORCES a
                  #      file-or-retire decision on that chronic PROPOSE (rollcall-recurring-has-no-decider)
  printf '%s' "[roll-call] Status ping — post exactly ONE line to the board, then return to your loop. \
FIRST run: mesh-roll-call --settled $1 — output 'retired <ts>' means your OWN later [done]/RETRACT \
already settled your last PROPOSE: post 'PROPOSE none (retired <ts>)' and do NOT restate it, not even \
as 'unchanged' (a retired propose re-posted as unchanged resurrects itself every round, forever). \
If it prints 'open', THEN check the board for your own previous line: grep 'roll-call $1:' ~/.mesh/chat.log | tail -1. If the \
PROPOSE you were about to post is the SAME proposal as that last line (even reworded), post \
'PROPOSE unchanged (<3-word slug of it>)' instead of restating it — an identical PROPOSE re-surfacing \
every round is board noise; only a NEW or materially revised proposal gets spelled out. \
Run: MESH_WHO=\"$1@\$(hostname)\" mesh-chat \"[fyi] roll-call $1: PROPOSE <new proposal | unchanged (<slug>) | none> | \
CHANGED <what you did since the last roll-call> | GAP <what is missing or blocked>\". \
Derive CHANGED from ARTIFACTS — your own board lines since the last DIGEST (grep '$1@' ~/.mesh/chat.log) \
plus your channel's git/log — never from session memory: a cleared context is not 'nothing changed'. \
Keep each field to a few words; one line total. Do NOT start new work from this ping."
  # RECURRING clause (chat-review/rollcall-recurring-has-no-decider, arm a): the digest's 'decide or
  # retire xN' escalation was prose addressed to NOBODY — dispatch never routes a digest, and the
  # proposer (fresh context every round) never learned its own count, so counters climbed for days
  # (x8/x7/x6/x3 live 2026-07-16). Force the decision at the SOURCE, where the context lives: the mind
  # that last re-posted the chronic sig gets its live count + a file-or-retire imperative.
  if [ -n "${2:-}" ]; then
    printf '%s' " RECURRING ESCALATION — DECIDE THIS ROUND: your own PROPOSE has recurred $2 across \
roll-call rounds with no decision (live board count). Do NOT re-post it or answer 'unchanged' for it \
again: this round either FILE it — post a real [task] (owner: <tool>/<window>) or [design] line for \
it — or RETIRE it: post 'PROPOSE none — declined <why>'."
  fi
}

# the synthesis step injected into the tg window. It reads the board, collects roll-call lines since
# the marker, and posts ONE board-internal [fyi] DIGEST — but HOLDS (defers to its next tick) until
# >=MIN_LINES arrived so a too-early tick never posts a hollow digest (honest-fusion: name who didn't
# answer). NO voice/Telegram relay: the operator explicitly silenced mesh-voice-tx (2026-06-24) —
# the digest is board-internal ONLY; a human can read it on the board, the mesh does not speak it.
synth_prompt(){ # $1 = marker epoch, $2 = current mode, $3 = suppress-ledger (build_ledger output),
                 # $4 = expected-responder set (this node's ground truth, see rollcall-digest-expected-set)
  printf '%s' "[roll-call-synth] The fleet roll-call fired at marker $1 (mesh-mode: $2). Each mind is \
posting one '[fyi] roll-call <name>:' line (PROPOSE/CHANGED/GAP) to mesh-chat over the next few minutes. \
Read the board, collect the 'roll-call' [fyi] lines posted SINCE marker $1. If fewer than $MIN_LINES have \
arrived, HOLD — do nothing this tick and re-check on your next tick (do not post a partial/hollow digest). \
Once at least $MIN_LINES are in: if EVERY expected mind has answered, post the digest now. If some expected \
mind is STILL unanswered, give it a ONE-TICK GRACE before judging it silent — minds answer late but alive \
(health answered 12s after the digest window 02:00:57). Concretely: if the marker is LESS than ${GRACE_S}s \
old, HOLD one more tick (do not name anyone SILENT yet) so stragglers can post, and re-check next tick. \
Only a mind STILL unanswered once the marker is OLDER than ${GRACE_S}s (i.e. it has had its grace tick) is \
named SILENT and flagged for a liveness-check. A mind that answers during the grace window is included \
normally, never flagged. \
FINAL RE-SCAN BEFORE POSTING (chat-review/mesh-roll-call-399721, stale-snapshot-vs-late-post gap): the \
board read above can go stale by the time you finish composing — a mind's roll-call line can land in the \
minutes it takes you to synthesize and post the digest (a real case: a mind's line landed 21s before the \
digest posted, only barely inside grace, yet was still misjudged off a snapshot taken earlier). Immediately \
before running the mesh-chat post command, RE-READ the board one more time for any 'roll-call' [fyi] lines \
that landed since your first read; fold in any that arrived and drop them from the SILENT list. Never name \
a mind SILENT in the posted digest if its own roll-call line is already on the board by post time, even if \
your first read missed it. \
EXPECTED-RESPONDER SET (rollcall-digest-expected-set, ground truth for judging silence — a 12:01Z digest \
wrongly declared a whole peer node 'off by card-gate' and dropped its 6 minds' PROPOSEs/GAPs because the \
synth had no real target list and guessed from a stale card read): $4 \
Judge SILENCE ONLY against this set — a window named in it that hasn't posted by grace time is SILENT; a \
window NOT in this set is simply not this node's responsibility to judge. The board (via chat-sync gossip) \
ALSO carries roll-call lines from OTHER hosts, each tagged by its WHO field '<window>@<hostname>' with a \
hostname different from this one — you have NO expected-set ground truth for those (their own roll-call run \
knows their real target list, not you). For any such foreign-host lines: NEVER guess they are 'off' or \
misconfigured, NEVER drop them, and NEVER fold them into this node's SILENT accounting — instead fold them \
into their OWN per-node digest section, one line prefixed '<hostname>:', reporting only what that host \
actually posted this round. SYNTHESIZE the collected lines into ONE short digest line and post it to the BOARD \
only — do NOT use any voice or Telegram relay (operator silenced voice 2026-06-24); board-internal text \
ONLY. Post with: MESH_WHO=\"roll-call@\$(hostname)\" mesh-chat \"[fyi] roll-call DIGEST: <key PROPOSEs | \
notable CHANGEDs | open GAPs | any expected mind STILL SILENT after its grace | <hostname>: ... per foreign \
node with roll-call lines this round>\". One digest per roll-call; never an empty one. \
BREVITY BUDGET (chat-review/digest-line-truncation, owner mesh-roll-call/genome): the digest is read back \
through views that HARD-CAP a single board line at ~2000 chars, so a longer line is SILENTLY truncated \
mid-item — losing its tail (a real 2994-char digest lost its last suppressed-item rationale 07:04). Keep the \
WHOLE digest UNDER ~1500 chars. PREAMBLE TERSE: when every expected mind answered, write just '(N/N ok)' — do \
NOT enumerate each mind's answer timestamp or 'in during grace' note; NAME a mind ONLY if it is STILL SILENT \
past its grace. If the synthesized content would STILL exceed the budget, PRIORITIZE — keep PROPOSEs + open \
GAPs + RECURRING escalations + any SILENT mind, trim each CHANGED to a short clause — and drop the lowest-\
priority items DELIBERATELY with a trailing '(+N trimmed)' note, so nothing is ever silently cut mid-line. \
PROPOSE-DEDUP (idle_sig principle for proposals — apply BEFORE composing the digest): a SUPPRESS-LEDGER \
follows. DROP from the digest any PROPOSE that (a) matches a GATED entry (operator-gated / settled — NEVER \
re-surface) or (b) merely restates a RECENTLY-RESOLVED subject or (c) was RETRACTED / marked MOOT by its \
own proposer (a self-withdrawn PROPOSE never re-surfaces) — match on INTENT, not wording (a reworded \
same-proposal IS a match). The ledger ALSO carries a RECURRING block — PROPOSEs that recurred across MANY \
rounds yet were NEVER actioned; do NOT suppress those, ESCALATE each: list it as 'RECURRING xN — decide or \
retire' so it is forced to a decision (turn it into a [task] OR gate it), not silently re-listed again. \
Only genuinely NEW, unresolved PROPOSEs reach the digest; CHANGED/GAP are listed \
normally. If EVERY PROPOSE is suppressed, write 'no new PROPOSEs (<N> suppressed as already-answered/gated)'. \
SUPPRESS-LEDGER:
$3"
}

# propose_sig — the canonical INTENT-KEY of a proposal subject (idle_sig dedupe principle, applied to
# PROPOSEs): lowercase, drop punctuation + stopwords + ≤2-char tokens, then sort-unique the remaining key
# tokens. Word order and rewording wash out, so two restatements of the same proposal collapse to ONE key.
# It is order/stopword-invariant, NOT a stemmer (stage≠staged) — deliberately conservative (idle_sig
# doctrine: under-suppression leaks, over-suppression of a status-yield is low-harm; never drop a NEW one).
propose_sig(){
  printf '%s' "$1" | tr 'A-Z' 'a-z' | tr -c 'a-z0-9' ' ' | tr -s ' ' '\n' \
    | grep -vxE '(the|an|to|of|for|and|or|is|are|be|on|in|it|that|this|with|add|new|change|changed|fix|fixed|propose|proposed|would|we|our|its|so|by|as|at|re|gap|done|via|not|but|from|into|one|line|mesh)' \
    | grep -vE '^.{0,2}$' | sort -u | tr '\n' ' ' | sed -E 's/^ +| +$//g'
}

# is_null_propose — is this PROPOSE field the ABSENCE of a proposal rather than a proposal?
# (chat-review/rollcall-null-sentinel-escalated-as-chronic 2026-07-24.) The respondent prompt itself
# mints three null forms — 'none', 'unchanged (none)', and the file-or-retire clause's own prescribed
# retirement wording 'none — declined <why>' — and recur_rows treated every one as a SUBJECT:
# propose_sig('unchanged (none)') = 'none unchanged', a stable intent-key that dozens of DIFFERENT
# minds re-mint every round, so it collapsed into ONE chronic sig and climbed forever. Live board when
# this was caught: 144x 'none' + 46x 'unchanged (none)' → 'RECURRING x10 — unchanged (none)', plus
# 'x5 — unchanged (none retired)' and 'x3 — unchanged (none — declined)'. It is UNFIXABLE by the
# escalation it triggers: the clause demands 'FILE it or post PROPOSE none — declined <why>', and the
# COMPLIANT answer is itself a null sentinel that re-enters as a new chronic sig — the escalation feeds
# on its own prescribed cure. Gating the strings in $GATED_FILE would only chase each new variant; the
# fix is to never MINT the sig. Conservative by design (idle_sig doctrine: a missed suppression leaks
# one line, a wrong one silences a real proposal) — 'none' must LEAD the field as a whole word, and an
# 'unchanged (...)' wrapper is null only when its INNER slug is itself null, so a real restated
# proposal ('unchanged (redmi-auth)') and one that merely CONTAINS the word ('keep the swap unchanged
# at 12g') both survive.
is_null_propose(){ # $1 = the PROPOSE field text · rc=0 when it carries NO proposal
  local t inner
  t="$(printf '%s' "${1:-}" | tr 'A-Z' 'a-z' | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//')"
  [ -n "$t" ] || return 0
  # leading WORD 'none' (not a prefix — 'nonexistent probe' is a real proposal), with any trailing
  # rationale: 'none', 'none (retired 15:01Z)', 'none — declined <why>', 'none this pass'.
  [ "${t%%[![:alnum:]]*}" = none ] && return 0
  case "$t" in
    'unchanged ('*|'unchanged('*)
      inner="${t#unchanged}"; inner="${inner# }"; inner="${inner#\(}"; inner="${inner%%\)*}"
      inner="$(printf '%s' "$inner" | sed -E 's/^[[:space:]]+//')"
      [ -n "$inner" ] && [ "${inner%%[![:alnum:]]*}" != none ] || return 0
      case "$inner" in 'no active'*|'no open'*|'no new'*|'no proposal'*) return 0 ;; esac
      ;;
  esac
  return 1
}

# poster_prefix_re — the ANCHORED regex for the body-prefix strip every subject harvest applies.
# A board body may lead with a POSTER prefix that is not part of the subject ('[done] pub: draft-staging
# packaged'), but the mesh's OWN close-key shape wears the SAME punctuation ('[task] <hyphenated-slug>:
# <prose>'), and the old unanchored class [A-Za-z0-9@_.-]+ included the hyphen — so it ate the identifying
# slug WHOLE (chat-review/rollcall-task-slug-eaten-by-poster-prefix-sed: witness's 20:03Z filing
# '[task] cv-pdf-phone-mismatch-in-three-sent-applications: THREE applications sent…' harvested as 'THREE
# applications sent…', sharing ONE token with the PROPOSE it discharged, so sig_actioned stayed false and
# the x3 escalation never cleared — the detector demanded an action, then deleted the field that names it).
# Narrowing the class is not enough: real posters carry hyphens too ('mind-control@', 'roll-call@'). Anchor
# it to a poster that ACTUALLY POSTS — harvest the board's own '<window>@<host>  ::' column, so the roster
# is self-calibrating (a new window is a poster the moment it speaks; nothing hand-kept to rot) and a slug
# is stripped only when it is VERBATIM a live window name. Fallback roster only if the log is unreadable.
poster_prefix_re(){
  local names
  names="$(awk -F'  ::  ' 'NF>1{print $1}' "$CHAT_LOG" 2>/dev/null \
    | awk 'NF>1{print $2}' | sed -E 's/@.*$//' \
    | grep -axE '[A-Za-z0-9_-]+' | sort -u | tr '\n' '|' | sed -E 's/\|$//')"
  [ -n "$names" ] || names='minds|genome|tg|health|senses|witness|chat|room|sound|pub|discover|vpn|bruno|diary|models|adint|mind-control|roll-call'
  printf '^(%s)(@[A-Za-z0-9_.-]+)?:[[:space:]]*' "$names"
}

# build_ledger — the SUPPRESS-LEDGER injected into the synth: (1) GATED entries (operator-gated / settled,
# durable, from $GATED_FILE — hard-suppress, never re-surface) + (2) RECENTLY-RESOLVED subjects distilled
# from the last ${LEDGER_DAYS}d of [done]/[resolving] board lines + (3) RETRACTED subjects whose own proposer
# posted a same-round RETRACT/MOOT marker (a self-withdrawn PROPOSE must not re-surface next round — the
# senses dash-liveness PROPOSE was retracted 17:03:30 'MOOT' yet the digest re-listed it open). All three
# deduped by propose_sig so N markers about one thing become ONE ledger line. Bounded: date-window + tail
# cap + 20-line output cap.
build_ledger(){
  # one poster-roster read for both harvests below (see poster_prefix_re)
  local _pre; _pre="$(poster_prefix_re)"
  echo "GATED — never re-surface:"
  if [ -s "$GATED_FILE" ]; then
    grep -vE '^[[:space:]]*(#|$)' "$GATED_FILE" 2>/dev/null | sed 's/^/  - /'
  else
    echo "  (none recorded — $GATED_FILE absent/empty)"
  fi
  echo "RESOLVED (${LEDGER_DAYS}d):"
  local cutoff; cutoff="$(date -u -d "-${LEDGER_DAYS} days" +%Y-%m-%d 2>/dev/null || echo 0000-00-00)"
  if [ -s "$CHAT_LOG" ]; then
    awk -v c="$cutoff" 'length($0)>=10 && substr($0,1,10) >= c' "$CHAT_LOG" 2>/dev/null \
      | grep -aiE '\[(done|resolving)\]' | tail -n 80 \
      | while IFS= read -r ln; do
          body="${ln##*  ::  }"
          body="$(printf '%s' "$body" | sed -E 's/^\[[A-Za-z-]+\][[:space:]]*//' | sed -E "s#${_pre}##")"
          hl="$(printf '%s' "$body" | sed -E 's/ (—|\(|\|).*$//; s/\.[[:space:]].*$//' | cut -c1-70 | sed -E 's/[[:space:]]+$//')"
          [ -n "$hl" ] || continue
          printf '%s\t%s\n' "$(propose_sig "$hl")" "$hl"
        done \
      | awk -F'\t' 'NF==2 && $1!="" && !seen[$1]++ {print "  - "$2}' | head -n 20
  else
    echo "  (no board log at $CHAT_LOG)"
  fi
  echo "RETRACTED (${LEDGER_DAYS}d):"
  if [ -s "$CHAT_LOG" ]; then
    # Match a PROPOSER's own withdrawal: 'RETRACT[ed] [my|the|its] [roll-call] PROPOSE …' OR
    # '<subj> PROPOSE is now MOOT'. The order constraint (retract→propose adjacent, or propose→moot adjacent)
    # is deliberately tight so [task]/[chat-review] meta lines that merely MENTION a retraction don't match
    # (they read 'a PROPOSE … RETRACTED same-round' — wrong adjacency). A roll-call DIGEST is the synth's own
    # output, not a proposer self-retraction — drop it (its editorial 'X PROPOSE is now MOOT' note would else
    # mine a garbage subject out of the whole digest body).
    awk -v c="$cutoff" 'length($0)>=10 && substr($0,1,10) >= c' "$CHAT_LOG" 2>/dev/null \
      | grep -aiE 'retract[a-z]*[[:space:]]+(my[[:space:]]+|the[[:space:]]+|its[[:space:]]+)?(roll-?call[[:space:]]+)?propose|propose[a-z]*([[:space:]]+is)?([[:space:]]+now)?[[:space:]]+moot' \
      | grep -aiv 'roll-call DIGEST' | tail -n 40 \
      | while IFS= read -r ln; do
          body="${ln##*  ::  }"
          body="$(printf '%s' "$body" | sed -E 's/^\[[A-Za-z-]+\][[:space:]]*//' | sed -E "s#${_pre}##")"
          # subject: parenthetical right after PROPOSE (form A 'RETRACT … PROPOSE (subj): MOOT'); else the
          # clause with retraction scaffolding + the propose keyword stripped (form B '<subj> PROPOSE is now
          # MOOT' / form C 'RETRACT … PROPOSE: <subj>'). Then headline-trim like RECENTLY-RESOLVED.
          subj="$(printf '%s' "$body" | sed -nE 's/.*propose[a-z]*[[:space:]]*\(([^)]+)\).*/\1/Ip')"
          if [ -z "$subj" ]; then
            subj="$(printf '%s' "$body" \
              | sed -E 's/\bretract(ed|ing)?\b//Ig; s/\broll-?call\b//Ig; s/\b(is[[:space:]]+now[[:space:]]+moot|now[[:space:]]+moot|moot)\b//Ig; s/\bpropose[a-z]*\b/ /Ig; s/\b(my|the|its)\b//Ig' \
              | sed -E 's/^[[:space:][:punct:]]+//')"
          fi
          hl="$(printf '%s' "$subj" | sed -E 's/ (—|\(|\||:).*$//; s/\.[[:space:]].*$//' | cut -c1-70 | sed -E 's/[[:space:]]+$//; s/^[[:space:]]+//')"
          [ -n "$hl" ] || continue
          printf '%s\t%s\n' "$(propose_sig "$hl")" "$hl"
        done \
      | awk -F'\t' 'NF==2 && $1!="" && !seen[$1]++ {print "  - "$2}' | head -n 20
  else
    echo "  (no board log at $CHAT_LOG)"
  fi
  build_recurring
}

# build_recurring — the ESCALATION arm the suppress-ledger lacks (chat-review 2026-06-26, owner
# mesh-roll-call/genome). build_ledger only DROPS a PROPOSE that is resolved / gated / retracted; a PROPOSE
# that is NONE of those — open but never converted to a [task] — matches no arm and re-surfaces in EVERY
# digest, re-burning synth tokens with no path to a decision (reproduced on the board: the 'auto-route an
# open [task] to an idle hand' / dispatch-reflex intent recurred 5+ rounds across a day, never [done]/[task]'d
# or retired). This adds the missing arm: count how many DISTINCT roll-call ROUNDS each PROPOSE subject has
# recurred in — read straight from the durable board (the board IS the persistent record; no fragile cross-run
# state file to drift/corrupt) and canonicalised by the SAME propose_sig intent-key so rewordings collapse to
# one count — and FLAG any sig recurring >= RECUR_N rounds that is still un-actioned, so the synth ESCALATES it
# ('RECURRING xN — decide or retire') instead of silently re-listing it. CONSERVATIVE by the idle_sig doctrine
# (under-escalate is safe, over-escalate is noise): default N=3, and a sig is dropped the instant it appears in
# a [done]/[resolving]/[task] subject or the GATED file (= it reached a decision). ROUNDS are gap-bucketed:
# roll-call [fyi] bursts cluster within seconds while rounds are cron-spaced minutes+ apart, so a gap >
# RECUR_ROUND_GAP_S starts a new round; the input is time-sorted first so out-of-order board appends (clock
# skew across nodes) can't corrupt the buckets. (Needs awk mktime — gawk, the fleet default; absent ⇒ the
# section is simply empty, never a crash.)
# sig_actioned — has this recurring PROPOSE sig already been actioned by a [task]/[done]/GATED subject?
# The excl set (build_recurring below) holds each settled subject's propose_sig, one per line. The old
# test was exact-line equality (grep -qxF): a terse roll-call PROPOSE ("unchanged (swap 8G→12G)" ->
# "12g swap unchanged") is near-NEVER a verbatim key-match for the far richer [task] that settles it
# ("...grow swap ... swapfile ... fstab" -> "12g fstab swap swapfile"), so the exclusion almost never
# fired and settled items (swap-grow-12g x3, cam-sense-spof x7, vpn-dash x4) re-escalated for days.
# Instead: MAJORITY OVERLAP against a SINGLE excl line — exclude when some one settled subject shares
# >=2 tokens AND >= half of this PROPOSE's key tokens (n==1 -> that lone token present). The >=2-shared
# FLOOR stops a single incidental common token ("swap") from suppressing a genuinely-different proposal
# (the regression guard: never over-suppress a NEW chronic item). Per-line (not union across lines) so
# two unrelated tasks can't jointly cover a PROPOSE they don't individually settle.
sig_actioned(){
  local sig="$1" excl="$2"
  [ -n "$sig" ] && [ -s "$excl" ] || return 1
  awk -v sig="$sig" '
    BEGIN{ n=split(sig,t," "); need=int((n+1)/2); if(need<1)need=1; floor=(n>=2?2:1) }
    { delete have; for(i=1;i<=NF;i++) have[$i]=1
      m=0; for(k=1;k<=n;k++) if(t[k] in have) m++
      if(m>max) max=m }
    END{ exit( (max>=floor && max>=need) ? 0 : 1 ) }' "$excl"
}

# recur_rows — the recurrence computation build_recurring/recur_for_mind/the adjudicate backstop all
# share: emits TSV 'count<TAB>sig<TAB>mind<TAB>subject<TAB>subject0<TAB>lastepoch' (highest count
# first) for every un-actioned PROPOSE sig recurring in >= $1 distinct rounds; mind + subject are the
# MOST-RECENT round's proposer and wording, subject0 is the FIRST round's wording (the original
# propose text — the adjudicate Subject:, never a re-post literal like 'unchanged (<slug>)'), and
# lastepoch is the most-recent propose's epoch (UTC — what the backstop compares against the recorded
# clause-delivery marker). One computation, three consumers (rollcall-recurring-has-no-decider) — the
# ledger block, the per-proposer prompt clause, and the >=2xRECUR_N adjudicate task.
recur_rows(){
  local N="${1:-${RECUR_N:-3}}" GAP="${RECUR_ROUND_GAP_S:-300}"
  [ -s "$CHAT_LOG" ] || return 0
  local cutoff; cutoff="$(date -u -d "-${LEDGER_DAYS} days" +%Y-%m-%d 2>/dev/null || echo 0000-00-00)"

  # exclusion sigset — subjects that ALREADY reached a decision: GATED file slugs + [done]/[resolving]/[task]
  # board subjects (last window), each run through propose_sig. A recurring PROPOSE matching one of these is
  # not chronic-unactioned (it has been actioned/settled) → never escalate it.
  # THIRD SOURCE — the RETIRE branch (chat-review/rollcall-retire-branch-not-credited, owner mesh-roll-call/
  # genome): the escalation clause offers TWO exits — "FILE it (a real [task]) OR RETIRE it: post 'PROPOSE
  # none — declined <why>'" — but the two sources above harvest only the FILE branch. A mind that COMPLIES
  # with the RETIRE branch reached a decision exactly as a [done]/[task] does, yet the detector ignored it and
  # re-escalated the retired item every round until the LEDGER_DAYS window aged it out (live: opencode-mind-
  # compact x6, retired 07-29, still climbing). The detector demanded an action it then refused to credit —
  # both edges of the offered signal need the same gate. The <why> LEADS with the retired subject (the clause's
  # own shape), so harvesting it (truncated at the first ;)| so a long rationale essay can't over-cover a
  # DIFFERENT sig) and running it through the SAME propose_sig + sig_actioned majority-overlap credits the
  # retirement without a new magic key. Conservative by the same floor (>=2 shared) as the other two sources.
  local _pre; _pre="$(poster_prefix_re)"   # anchored body-prefix strip (see poster_prefix_re)
  local excl; excl="$(mktemp 2>/dev/null)" || excl="$MESH/.rc-recur-excl.$$"
  {
    [ -s "$GATED_FILE" ] && grep -vE '^[[:space:]]*(#|$)' "$GATED_FILE" 2>/dev/null | sed -E 's/[[:space:]]*\|.*$//'
    awk -v c="$cutoff" 'length($0)>=10 && substr($0,1,10) >= c' "$CHAT_LOG" 2>/dev/null \
      | grep -aiE '\[(done|resolving|task)\]' \
      | sed -E 's/^.*  ::  //; s/^\[[A-Za-z-]+\][[:space:]]*//' \
      | sed -E "s#${_pre}##" \
      | sed -E 's/ (—|\(|\|).*$//; s/\.[[:space:]].*$//'
    awk -v c="$cutoff" 'length($0)>=10 && substr($0,1,10) >= c' "$CHAT_LOG" 2>/dev/null \
      | grep -aiE '\[fyi\] roll-call ' | grep -aiE 'PROPOSE none[^|]*declined' \
      | sed -E 's/^.*[Dd]eclined//; s/[;)|].*$//'
  } | while IFS= read -r s; do [ -n "$s" ] && printf '%s\n' "$(propose_sig "$s")"; done | sort -u > "$excl"

  # mind roll-call PROPOSE lines → "round<TAB>mind<TAB>subject": time-sort, gap-bucket rounds (one awk
  # pass; drop the synth's own 'roll-call DIGEST' lines — not a mind's proposal), then sig + count
  # DISTINCT rounds per sig, keeping the most-recent round's mind + wording as the representative.
  awk -v c="$cutoff" 'length($0)>=10 && substr($0,1,10) >= c' "$CHAT_LOG" 2>/dev/null \
    | grep -aiE '\[fyi\] roll-call ' | grep -aiv 'roll-call DIGEST' | grep -i 'PROPOSE' \
    | sort \
    | TZ=UTC0 awk -v gap="$GAP" '
        { ts=substr($1,1,19); gsub(/[-T:]/," ",ts); e=mktime(ts)
          if(e<=0) next
          if(prev=="" || e-prev>gap) round++
          prev=e
          mind=""; if(match($0, /roll-call +([A-Za-z0-9_-]+):/, mm)) mind=mm[1]
          i=index($0,"PROPOSE "); if(i==0) next
          s=substr($0,i+8); j=index(s," | "); if(j>0) s=substr(s,1,j-1)
          gsub(/^[[:space:]]+|[[:space:]]+$/,"",s)
          if(s!="" && mind!="") print round "\t" e "\t" mind "\t" s }' 2>/dev/null \
    | while IFS=$'\t' read -r rnd ep mind subj; do
        # NULL-SENTINEL DROP (see is_null_propose): 'none'/'unchanged (none)'/'none — declined <why>'
        # are the absence of a proposal — never a chronic PROPOSE, never an escalation subject.
        is_null_propose "$subj" && continue
        sig="$(propose_sig "$subj")"; [ -n "$sig" ] || continue
        printf '%s\t%s\t%s\t%s\t%s\n' "$sig" "$rnd" "$ep" "$mind" "$subj"
      done \
    | awk -F'\t' '
        { key=$1 SUBSEP $2; if(!(key in seen)){seen[key]=1; cnt[$1]++}
          if(!($1 in maxrnd) || $2+0 > maxrnd[$1]+0){ maxrnd[$1]=$2+0; who[$1]=$4; rep[$1]=$5 }
          if(!($1 in minrnd) || $2+0 < minrnd[$1]+0){ minrnd[$1]=$2+0; rep0[$1]=$5 }
          if($3+0 > maxep[$1]+0) maxep[$1]=$3+0 }
        END { for(k in cnt) printf "%d\t%s\t%s\t%s\t%s\t%d\n", cnt[k], k, who[k], rep[k], rep0[k], maxep[k] }' \
    | sort -rn \
    | while IFS=$'\t' read -r n sig mind subj subj0 lastep; do
        [ "${n:-0}" -ge "$N" ] || continue
        sig_actioned "$sig" "$excl" && continue
        printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$n" "$sig" "$mind" "$subj" "$subj0" "$lastep"
      done
  rm -f "$excl"
}

build_recurring(){
  local N="${RECUR_N:-3}"
  echo "RECURRING >=${N} — ESCALATE (decide or retire):"
  [ -s "$CHAT_LOG" ] || { echo "  (no board log at $CHAT_LOG)"; return 0; }
  recur_rows "$N" | while IFS=$'\t' read -r n sig mind subj _; do
    printf '  - RECURRING x%s — %s\n' "$n" "$subj"
  done
}

# recur_for_mind — the source-side arm's lookup: does $1's OWN chronic PROPOSE (a >=RECUR_N sig whose
# most-recent proposer is $1) exist? Prints 'xN — <subject>' for the top one, else nothing. Feeds
# respond_prompt's forced file-or-retire clause. Addressee is the MOST-RECENT proposer only — it is
# the mind whose re-post keeps the sig alive; earlier co-proposers get no clause (conservative:
# under-escalate is safe, a mis-addressed imperative is noise).
recur_for_mind(){ # $1 = mind label
  [ -n "${1:-}" ] || return 0
  recur_rows "${RECUR_N:-3}" | awk -F'\t' -v m="$1" '$3==m {printf "x%s — %s\n", $1, $4; exit}'
}

# parse_mode — extract the REAL mode token from `mesh-mode` output (reads from stdin). mesh-mode LEADS
# with a usage/help block, so the old `head -1 | grep -oE [a-z]+` grabbed 'usage' and the synth read
# 'mesh-mode: usage' instead of the live mode. The mode value lives on the `MODE=<token>` line that
# mesh-mode's show_mode always prints — grep THAT, not the first line. (roll-call/mesh-mode-context-leak)
parse_mode(){ grep -oE 'MODE=[A-Za-z]+' | head -1 | cut -d= -f2; }

# inspection / test hooks (no side effects)
# settled_check — is the mind's LAST roll-call PROPOSE already settled by its OWN later [done]/
# RETRACT/MOOT line? (chat-review/rollcall-retired-propose-reposts-as-unchanged: the source-side
# dedup pinned a mind to its last roll-call line only, so a fresh-context mind faithfully resurrected
# a propose it had itself retired, and the re-post became the next round's anchor — self-sustaining
# past the synth ledger's 3d window.) Prints 'retired <ts-of-the-settling-line>' or 'open'. Scans
# only the mind's OWN lines AFTER its last roll-call line; subject match reuses propose_sig +
# sig_actioned (majority-overlap), the same rigor as the recurring-exclusion arm. The respondent
# prompt routes through this verb so the check is executable and testable, not prompt prose.
settled_check(){ # $1 = mind label (its window name)
  local log="${MESH_DIR:-$HOME/.mesh}/chat.log"
  [ -n "${1:-}" ] && [ -r "$log" ] || { echo open; return 0; }
  local lineno last_ln prop sig
  lineno="$(grep -n "roll-call $1:" "$log" 2>/dev/null | tail -1 | cut -d: -f1)"
  [ -n "$lineno" ] || { echo open; return 0; }
  last_ln="$(sed -n "${lineno}p" "$log")"
  # strip the |CHANGED tail BEFORE anchoring on PROPOSE: '.*PROPOSE +' is greedy, so a CHANGED/GAP
  # section that merely MENTIONS 'PROPOSE 05:01' would else hijack the anchor and mine garbage.
  prop="$(printf '%s' "$last_ln" | sed -E 's/ *\| *CHANGED.*//; s/.*PROPOSE +//')"
  # ONE definition of 'this is not a proposal', shared with recur_rows — the old `none*` prefix test
  # missed 'unchanged (none)' (and matched 'nonexistent…'), so the scan mined a sig out of a null.
  is_null_propose "$prop" && { echo open; return 0; }
  sig="$(propose_sig "$prop")"
  [ -n "$sig" ] || { echo open; return 0; }
  local tmp; tmp="$(mktemp)" || { echo open; return 0; }
  # anchor at the sig's FIRST roll-call appearance, not the latest repost
  # (chat-review/rollcall-settled-check-blind-to-earlier-retract: a sig retracted once then
  # stale-reposted later put the retraction BEHIND the last-repost anchor forever — it could never
  # re-settle). Same sig rigor as the settle scan (propose_sig + sig_actioned majority-overlap), so
  # reworded reposts still collapse onto the original round. No match ⇒ fall back to the last line.
  local first="" ln rest p
  while IFS=: read -r ln rest; do
    p="$(printf '%s' "$rest" | sed -E 's/ *\| *CHANGED.*//; s/.*PROPOSE +//')"
    is_null_propose "$p" && continue
    propose_sig "$p" > "$tmp"
    sig_actioned "$sig" "$tmp" && { first="$ln"; break; }
  done < <(grep -n "roll-call $1:" "$log" 2>/dev/null)
  [ -n "$first" ] || first="$lineno"
  # settle scan: own lines after the anchor — minus the mind's own roll-call lines, so a repost whose
  # CHANGED text happens to say '[done]'/'retired' (now inside the widened window) can't self-settle.
  local l hit=""
  while IFS= read -r l; do
    propose_sig "$l" > "$tmp"
    sig_actioned "$sig" "$tmp" && { hit="${l%% *}"; break; }
  done < <(tail -n +"$((first+1))" "$log" 2>/dev/null \
             | grep -E "[[:space:]]$1@[^[:space:]]+[[:space:]]+::" \
             | grep -v "roll-call $1:" \
             | grep -iE '\[done\]|retract|retired|moot')
  rm -f "$tmp"
  if [ -n "$hit" ]; then echo "retired $hit"; else echo open; fi
}

case "${1:-}" in
  --ledger)  build_ledger; exit 0 ;;
  --sig)     shift; propose_sig "$*"; printf '\n'; exit 0 ;;
  --settled) settled_check "${2:-}"; exit 0 ;;
  --recur)   recur_for_mind "${2:-}"; exit 0 ;;
esac

# tell — drive a window, or just print the target+prompt under DRYRUN (no real side effect).
tell_local(){  # $1=window $2=prompt
  if [ -n "$DRYRUN" ]; then printf 'TELL local:%s :: %s\n' "$1" "$2"; return 0; fi
  mesh-tell "$1" "$2" >/dev/null 2>&1 || true
}
tell_remote(){ # $1=peer $2=window $3=prompt
  if [ -n "$DRYRUN" ]; then printf 'TELL %s:%s :: %s\n' "$1" "$2" "$3"; return 0; fi
  mesh-tell --node "$1" "$2" "$3" >/dev/null 2>&1 || true
}

# session_mind_windows — the live 2-pane mind-channel windows in this node's hostname session, MINUS
# the synth window. The 2-pane structure (top DATA + bottom MIND, per "every window is data/mind") is
# the signal that a window is a mind channel; a 1-pane window (e.g. a raw 'bash' shell) is not, so it
# is excluded. Used to auto-extend the respondent set so non-consume windows (discover) are wake-poked
# instead of falsely flagged SILENT. tmux-unavailable / no session ⇒ empty (safe: the caller then
# falls back to the curated LOCAL_MINDS baseline). ROLL_CALL_WINDOWS_OVERRIDE ("<name> <panes>" lines)
# mocks the tmux read for a deterministic --test (decoupled from whatever windows exist right now).
session_mind_windows(){
  local sess="${MESH_SESSION:-$(hostname)}"
  if [ -n "${ROLL_CALL_WINDOWS_OVERRIDE:-}" ]; then
    printf '%s\n' "$ROLL_CALL_WINDOWS_OVERRIDE"
  else
    tmux list-windows -t "$sess" -F '#{window_name} #{window_panes}' 2>/dev/null
  fi | awk -v syn="$SYNTH_WIN" 'NF==2 && $2+0>=2 && $1!=syn {print $1}'
}

# ── --test: fully sandboxed dry-run (no tmux, no board, no TG, no voice) ──────────────────────────
if [ "${1:-}" = --test ]; then
  # tmp fence — task:doctor-test-tmpdir-cleanup-traps. Re-exec the smoke test ONCE under a private
  # TMPDIR and remove it from the PARENT, so the cleanup cannot be lost to the test's own `exit 1`
  # and cannot be clobbered by an EXIT trap the test sets for itself. A nested --test inherits the
  # guard var and skips its own fence (it is already inside one).
  if [ -z "${MESH_TEST_TMPD:-}" ]; then
    MESH_TEST_TMPD="$(mktemp -d)" || { echo "smoke-test: FAIL (tmp fence: mktemp -d)"; exit 1; }
    trap 'rm -rf "$MESH_TEST_TMPD"' EXIT INT HUP TERM
    export MESH_TEST_TMPD TMPDIR="$MESH_TEST_TMPD" TMP="$MESH_TEST_TMPD" TEMP="$MESH_TEST_TMPD"
    _fence_rc=0; "$0" "$@" || _fence_rc=$?; exit "$_fence_rc"
  fi
  _td="$(mktemp -d "${TMPDIR:-/tmp}"/mrc-test.XXXXXX)" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
  trap 'rm -rf "$_td"' EXIT
  # HERMETIC RETIRED-SET (a-test-child-inherits-exported-node-local-tuning): retired_channels() honours
  # an exported MESH_RETIRED_CHANNELS first, so the node running --test (whose restore.env exports e.g.
  # 'diary models room bruno minds chat') would otherwise leak into the baseline runs below and drop
  # minds/chat/room before the 'prompted local mind' assertions ever see them. Pin it EMPTY here; the
  # dedicated retired-filter sub-test sets its own value on its own invocation line and overrides this.
  export MESH_RETIRED_CHANNELS=''
  # sandbox EVERY side effect (reflex-test-must-sandbox): DRYRUN ⇒ no real mesh-tell/board/TG/voice;
  # MESH_DIR ⇒ marker/log writes land in the temp dir, never real ~/.mesh; deterministic marker.
  # Seed the PROPOSE-DEDUP ledger sources INTO the temp MESH_DIR so the injected synth carries a real
  # ledger (a GATED slug + a RECENTLY-RESOLVED subject + a self-RETRACTED subject) — proving the dedup
  # wiring end-to-end, sandboxed.
  printf 'test-gated-cap | operator-gated test entry (MESH_WEEKLY_PAID_CAP-like)\n# a comment line\n' > "$_td/proposals-gated"
  printf '%s  pub@host  ::  [done] pub: draft-staging package finalized — already shipped\n' "$(date -u +%FT%TZ)" > "$_td/chat.log"
  # a real proposer self-retraction (form A: parenthetical subject after PROPOSE) — MUST be suppressed
  printf '%s  senses@host  ::  [fyi] RETRACT my roll-call PROPOSE (sandbox-retract-subj): MOOT — verified already handled, no work needed\n' "$(date -u +%FT%TZ)" >> "$_td/chat.log"
  # a [chat-review] meta line that merely MENTIONS a retraction (wrong adjacency) — MUST NOT over-suppress
  printf '%s  chat@host  ::  [chat-review] digest re-surfaces a PROPOSE the proposer RETRACTED same-round — fix the dedup ledger\n' "$(date -u +%FT%TZ)" >> "$_td/chat.log"
  # RECURRENCE seeds (build_recurring escalation arm): 3 DISTINCT rounds 10min apart (> RECUR_ROUND_GAP_S=300),
  # past-timestamped so gap-bucketing sees 3 rounds. (A) a chronic PROPOSE REWORDED each round (same intent-key)
  # and NEVER actioned → must ESCALATE 'RECURRING x3'. (B) one that recurs 3 rounds but HAS a [task] → exclusion
  # must DROP it. (C) one in only 2 rounds → BELOW threshold, must NOT escalate (no over-escalation).
  _t30="$(date -u -d '-30 min' +%FT%TZ 2>/dev/null || date -u +%FT%TZ)"
  _t20="$(date -u -d '-20 min' +%FT%TZ 2>/dev/null || date -u +%FT%TZ)"
  _t10="$(date -u -d '-10 min' +%FT%TZ 2>/dev/null || date -u +%FT%TZ)"
  printf '%s  genome@host  ::  [fyi] roll-call genome: PROPOSE wire the spend sampler cron post reorg | CHANGED s | GAP s\n' "$_t30" >> "$_td/chat.log"
  printf '%s  minds@host  ::  [fyi] roll-call minds: PROPOSE post reorg wire spend sampler cron | CHANGED s | GAP s\n' "$_t20" >> "$_td/chat.log"
  printf '%s  genome@host  ::  [fyi] roll-call genome: PROPOSE cron spend sampler wire post reorg | CHANGED s | GAP s\n' "$_t10" >> "$_td/chat.log"
  # (B) models the REAL sig-mismatch bug (chat-review/rollcall-recurring-exclusion-sig-mismatch): a TERSE
  # PROPOSE (3 reworded rounds, intent-key {12g,keep,swap,unchanged}) settled by a VERBOSE [task] whose
  # richer key {12g,fstab,swap,swapfile} shares only 2 tokens (12g,swap) and is NOT string-equal — so the
  # OLD exact-line match (grep -qxF) fails to exclude it (reproduces the days-long re-escalation), while
  # majority-overlap (>=2 shared, >=half of 4) DOES exclude. Falsify by reverting sig_actioned to grep -qxF.
  printf '%s  room@host  ::  [fyi] roll-call room: PROPOSE keep the swap unchanged at 12g | CHANGED s | GAP s\n' "$_t30" >> "$_td/chat.log"
  printf '%s  room@host  ::  [fyi] roll-call room: PROPOSE swap 12g unchanged, keep it | CHANGED s | GAP s\n' "$_t20" >> "$_td/chat.log"
  printf '%s  room@host  ::  [fyi] roll-call room: PROPOSE unchanged 12g swap — keep as is | CHANGED s | GAP s\n' "$_t10" >> "$_td/chat.log"
  printf '%s  minds@host  ::  [task] chat-review/swapgrow: grow swap to 12g via a new swapfile in fstab\n' "$(date -u -d '-5 min' +%FT%TZ 2>/dev/null || date -u +%FT%TZ)" >> "$_td/chat.log"
  for _tt in "$_t30" "$_t20"; do printf '%s  health@host  ::  [fyi] roll-call health: PROPOSE qux zlonk telemetry probe | CHANGED s | GAP s\n' "$_tt" >> "$_td/chat.log"; done
  # (D) >=2xRECUR_N BACKSTOP seed (chat-review/rollcall-recurring-has-no-decider): a sig recurring in 6
  # distinct rounds (= 2xRECUR_N default) with NO decision — the source-side clause alone has failed its
  # proposer, so the run must post exactly ONE adjudicate [task] for it (and none for the x3 sampler sig).
  for _m in 80 70 60 50 40 30; do
    printf '%s  pub@host  ::  [fyi] roll-call pub: PROPOSE grind the frobwidget purge lane nightly | CHANGED s | GAP s\n' \
      "$(date -u -d "-${_m} min" +%FT%TZ 2>/dev/null || date -u +%FT%TZ)" >> "$_td/chat.log"
  done
  # (E) NULL-SENTINEL seeds (chat-review/rollcall-null-sentinel-escalated-as-chronic): the prompt's own
  # no-proposal answers, minted by DIFFERENT minds each round exactly as on the live board — they share
  # one intent-key, so pre-fix they collapsed into a single chronic sig and escalated ('RECURRING x10 —
  # unchanged (none)' live). 6 rounds = past the >=2xRECUR_N backstop too. Beside them, a REAL restated
  # proposal wearing the SAME 'unchanged (<slug>)' wrapper across 3 rounds — the discriminator: a guard
  # that merely drops the wrapper (or every line containing 'none') kills this one too and the suppress
  # becomes a silencer. Falsify by deleting the is_null_propose call in recur_rows.
  # the LIVE shape: the SAME null text re-posted across many rounds by DIFFERENT minds — every one
  # collapses to the single intent-key propose_sig('unchanged (none)')='none unchanged', so the count
  # climbs (x10 live). Six rounds here = past the >=2xRECUR_N backstop. A per-round unique null would
  # NOT reproduce it (each stays count=1) — this was the first draft's bug, caught by the RED run
  # staying green: the seeds must model the collapse, not just be null.
  _nullwho=(chat pub senses room diary vpn)
  _i=0
  for _m in 80 70 60 50 40 30; do
    printf '%s  %s@host  ::  [fyi] roll-call %s: PROPOSE unchanged (none) | CHANGED s | GAP s\n' \
      "$(date -u -d "-${_m} min" +%FT%TZ 2>/dev/null || date -u +%FT%TZ)" \
      "${_nullwho[$_i]}" "${_nullwho[$_i]}" >> "$_td/chat.log"
    _i=$((_i+1))
  done
  for _tt in "$_t30" "$_t20" "$_t10"; do
    printf '%s  senses@host  ::  [fyi] roll-call senses: PROPOSE unchanged (redmi-auth) | CHANGED s | GAP s\n' "$_tt" >> "$_td/chat.log"
  done
  # (F) RETIRE-BRANCH seed (chat-review/rollcall-retire-branch-not-credited): a chronic PROPOSE recurring
  # 3 rounds, then RETIRED by its proposer via the escalation's OWN prescribed wording ('PROPOSE none —
  # declined <why>'). The retire IS a decision (the clause offers FILE *or* RETIRE), so it must NOT re-
  # escalate. Pre-fix the excl set harvested only the FILE branch ([done]/[task]/[resolving]) → this sig
  # re-appeared as 'RECURRING x3' until LEDGER_DAYS aged it out (live: opencode-mind-compact x6). The <why>
  # LEADS with the retired subject so majority-overlap credits it. Falsify by deleting the retire-harvest arm
  # in recur_rows: the flurm sig re-appears as RECURRING x3. (The null-retire line is itself is_null_propose,
  # so it never adds a round or mints a null sig — it only feeds the exclusion set.)
  for _tt in "$_t30" "$_t20" "$_t10"; do
    printf '%s  diary@host  ::  [fyi] roll-call diary: PROPOSE wobblenize the flurm cache lane | CHANGED s | GAP s\n' "$_tt" >> "$_td/chat.log"
  done
  printf '%s  diary@host  ::  [fyi] roll-call diary: PROPOSE none — declined (flurm cache wobblenize lane retired — superseded, operator handled) | CHANGED s | GAP s\n' "$(date -u -d '-5 min' +%FT%TZ 2>/dev/null || date -u +%FT%TZ)" >> "$_td/chat.log"
  # (G) SLUG-EATEN seed (chat-review/rollcall-task-slug-eaten-by-poster-prefix-sed): the FILE branch of the
  # escalation clause writes the mesh's OWN close-key shape — '[task] <hyphenated-slug>: <prose>' — and the
  # body-prefix strip's old char class ([A-Za-z0-9@_.-]+, meant for a 'window:' poster prefix) INCLUDED the
  # hyphen, so it ate the whole slug and harvested only the prose. The covering tokens here live ONLY in
  # the slug (the prose deliberately shares NONE), so pre-fix the excl line shares 0 tokens with the PROPOSE
  # it settles → sig_actioned false → the chronic re-escalates forever although the mind COMPLIED (live:
  # witness's 20:03Z [task] cv-pdf-phone-mismatch-in-three-sent-applications, still 'x3 — unchanged
  # (cv-pdf-phone-mismatch)' four hours later). Falsify by reverting poster_prefix_re to the unanchored
  # class: 'zorbex' re-appears as RECURRING x3.
  for _tt in "$_t30" "$_t20" "$_t10"; do
    printf '%s  bruno@host  ::  [fyi] roll-call bruno: PROPOSE unchanged (zorbex-plimwick-mismatch) | CHANGED s | GAP s\n' "$_tt" >> "$_td/chat.log"
  done
  printf '%s  witness@host  ::  [task] zorbex-plimwick-mismatch-in-three-sent-forms: quibbled the wumpus baseline across every gantry, owner bruno\n' "$(date -u -d '-5 min' +%FT%TZ 2>/dev/null || date -u +%FT%TZ)" >> "$_td/chat.log"
  # mock the live session's windows so the auto-extend is DETERMINISTIC (not coupled to whatever
  # windows happen to exist right now): the real layout — bash(1-pane, must be EXCLUDED as a non-mind),
  # the 7 baseline minds, tg(synth, must be EXCLUDED), and discover(2-pane non-baseline, must be
  # AUTO-INCLUDED — the rollcall-wake-nonconsume fix: a non-consume window is wake-poked).
  _wov=$'bash 1\nminds 2\ngenome 2\ntg 2\nsenses 2\nhealth 2\nchat 2\nroom 2\npub 2\ndiscover 2'
  # pin a with-minds card fixture so the CARD-AUTHORITATIVE gate always PASSES here regardless of the
  # node running --test (a minds-off node's real card would otherwise gate the whole run off → node-
  # dependent test). MESH_CARD overrides $HOME/.mesh-card.
  printf '  minds: claude opencode\n' > "$_td/card-minds"
  # marker = now-60 (NOT the old deterministic 1): the clause-delivery record carries this epoch and
  # the backstop compares re-post times against it — a marker of 1 would read every 2026-dated seed
  # propose as 'after the clause' and vacuously satisfy the two-run assertions below.
  out="$(ROLL_CALL_DRYRUN=1 ROLL_CALL_WINDOWS_OVERRIDE="$_wov" MESH_MODE_OVERRIDE=test MESH_DIR="$_td" MESH_ROLL_CALL_NOW="$(( $(date +%s) - 60 ))" MESH_CARD="$_td/card-minds" "$0" 2>&1)"; fail=0
  chk(){ printf '%s' "$out" | grep -qF "$1" && echo "  ok: $2" || { echo "  FAIL: $2 (missing: $1)"; fail=1; }; }
  # every local mind window prompted
  for w in minds genome senses health chat room pub; do chk "TELL local:$w ::" "prompted local mind '$w'"; done
  # auto-extend (rollcall-wake-nonconsume): a live 2-pane mind window NOT in the curated baseline
  # (discover) is wake-poked; a 1-pane non-mind window (bash) is NOT; tg stays the synth.
  chk "TELL local:discover ::" "non-consume mind window 'discover' auto wake-poked (not invisible to roll-call)"
  printf '%s' "$out" | grep -q 'TELL local:bash ::' && { echo "  FAIL: 1-pane non-mind window 'bash' was prompted (must be excluded)"; fail=1; } || echo "  ok: 1-pane non-mind window 'bash' excluded from respondents"
  # tg must NOT be roll-called as a respondent (it is the synthesizer)
  printf '%s' "$out" | grep -q 'TELL local:tg ::' && { echo "  FAIL: tg was roll-called as a respondent (must be synth-only)"; fail=1; } || echo "  ok: tg excluded from respondents"
  # RETIRED-CHANNEL FILTER (rollcall-retired-not-silent): a channel in MESH_RETIRED_CHANNELS is
  # decommissioned by design (no window planted) and can never answer — it must be pinged by NOTHING and
  # named SILENT by nothing. Re-run the SAME mock windows with room+chat marked retired: they are live
  # 2-pane in the mock (so absent-window is NOT why they drop — the filter is), yet must vanish from both
  # the pings AND the synth's expected-responder set, while a NON-retired survivor (genome) stays in both.
  # Falsify by deleting the retired-filter loop: room/chat get pinged and re-enter the expected_set → RED.
  outr="$(MESH_RETIRED_CHANNELS='room chat' ROLL_CALL_DRYRUN=1 ROLL_CALL_WINDOWS_OVERRIDE="$_wov" MESH_MODE_OVERRIDE=test MESH_DIR="$_td" MESH_ROLL_CALL_NOW="$(( $(date +%s) - 60 ))" MESH_CARD="$_td/card-minds" "$0" 2>&1)"
  for w in room chat; do
    printf '%s' "$outr" | grep -q "TELL local:$w ::" && { echo "  FAIL: retired channel '$w' was pinged (MESH_RETIRED_CHANNELS must exclude it from respondents)"; fail=1; } || echo "  ok: retired channel '$w' not pinged"
  done
  # its name must not survive in the expected-responder set the synth judges silence against (extract the
  # 'local (host): <list>' clause so 'mesh-chat'/'chat.log' elsewhere in the synth prose can't false-pass)
  _eset="$(printf '%s' "$outr" | grep -oE 'local \([^)]*\): [^;]*' | head -1)"
  printf '%s' "$_eset" | grep -qwE 'room|chat' && { echo "  FAIL: retired channel still in expected-responder set (phantom SILENT): $_eset"; fail=1; } || echo "  ok: retired channels absent from expected-responder set"
  printf '%s' "$_eset" | grep -qw genome && echo "  ok: non-retired survivor 'genome' kept in expected-responder set" || { echo "  FAIL: retired filter dropped a non-retired mind (genome) from expected-set: $_eset"; fail=1; }
  # remote lean-node minds prompted
  chk "TELL phaedra:genome ::" "prompted phaedra:genome"
  chk "TELL phaedra:chat ::" "prompted phaedra:chat"
  # 3-field template present in the respondent prompt
  chk "PROPOSE " "respondent template has PROPOSE"; chk "CHANGED " "respondent template has CHANGED"; chk "GAP " "respondent template has GAP"
  # rollcall-changed-answered-from-memory: CHANGED must name its evidence source IN THE RENDERED PING
  # (own board lines since the last DIGEST + channel git/log) — a context-cleared mind otherwise
  # answers from empty memory (05:00 round: 10/13 posted 'CHANGED nothing — fresh session' over a
  # working night; only genome consulted an artifact).
  chk "board lines since the last DIGEST" "respondent prompt sources CHANGED from board artifacts"
  chk "a cleared context is not" "respondent prompt states cleared-context is not nothing-changed"
  # SOURCE-side dedup (chat-review/rollcall-propose-dedup): the respondent prompt itself must carry
  # the check-your-own-last-line rule + the 'unchanged' escape so an identical PROPOSE is never respelled
  chk "THEN check the board for your own previous line" "respondent prompt carries source-side dedup check"
  chk "PROPOSE unchanged" "respondent prompt offers the 'unchanged' escape (no verbatim re-post)"
  chk "[fyi] roll-call" "respondent posts a tagged [fyi] roll-call line"
  # rollcall-retired-propose-reposts-as-unchanged: the source-side dedup pinned a mind to its LAST
  # roll-call line ONLY — a fresh-context mind faithfully resurrected a propose it had itself retired
  # (models [done] 12:55 → 'PROPOSE unchanged' 15:00:46, digest dropped it by hand), and the synth's
  # RESOLVED arm is 3d-bounded while the re-post is self-sustaining (each round's re-post becomes the
  # next round's anchor). The prompt must route the retirement check through an EXECUTABLE verb
  # (--settled) so it is drivable here — prompt prose alone is source text, never behaviour.
  chk "mesh-roll-call --settled" "respondent prompt routes the retirement check through the --settled verb"
  chk "PROPOSE none (retired" "respondent prompt offers the none-(retired) escape"
  # drive --settled against fixture boards (ROLL_CALL_DRYRUN pinned so a pre-verb fall-through stays inert):
  _sb="$_td/settled-board"; mkdir -p "$_sb"
  printf '%s  genome@host  ::  [fyi] roll-call genome: PROPOSE wire the frobnitz sampler cron | CHANGED s | GAP s\n' "$_t30" > "$_sb/chat.log"
  printf '%s  genome@host  ::  [done] genome: frobnitz sampler cron propose retired — superseded, no work needed\n' "$_t10" >> "$_sb/chat.log"
  _sv="$(ROLL_CALL_DRYRUN=1 MESH_DIR="$_sb" "$0" --settled genome 2>/dev/null)"
  [ "$_sv" = "retired $_t10" ] && echo "  ok: --settled reads the mind's own later [done] as 'retired <ts>'" || { echo "  FAIL: --settled must print 'retired $_t10' for a propose settled by its own later [done], got '$_sv'"; fail=1; }
  # regression guards: another mind's [done] must NOT retire it (own-lines only); no settle at all → open
  _sb2="$_td/settled-open"; mkdir -p "$_sb2"
  printf '%s  genome@host  ::  [fyi] roll-call genome: PROPOSE wire the frobnitz sampler cron | CHANGED s | GAP s\n' "$_t30" > "$_sb2/chat.log"
  printf '%s  minds@host  ::  [done] minds: frobnitz sampler cron propose retired\n' "$_t10" >> "$_sb2/chat.log"
  _sv2="$(ROLL_CALL_DRYRUN=1 MESH_DIR="$_sb2" "$0" --settled genome 2>/dev/null)"
  [ "$_sv2" = open ] && echo "  ok: another mind's [done] does NOT retire (own-lines only)" || { echo "  FAIL: --settled must stay 'open' when only ANOTHER mind settled the subject, got '$_sv2'"; fail=1; }
  _sb3="$_td/settled-none"; mkdir -p "$_sb3"
  printf '%s  genome@host  ::  [fyi] roll-call genome: PROPOSE wire the frobnitz sampler cron | CHANGED s | GAP s\n' "$_t30" > "$_sb3/chat.log"
  _sv3="$(ROLL_CALL_DRYRUN=1 MESH_DIR="$_sb3" "$0" --settled genome 2>/dev/null)"
  [ "$_sv3" = open ] && echo "  ok: no later settle line → open" || { echo "  FAIL: --settled must print 'open' with no settle line, got '$_sv3'"; fail=1; }
  # (chat-review/rollcall-settled-check-blind-to-earlier-retract) a sig retracted ONCE then stale-REPOSTED
  # later must still read retired — the settle scan anchors at the sig's FIRST roll-call appearance, not
  # the latest repost (which would put the retraction behind the anchor forever).
  _sb4="$_td/settled-repost"; mkdir -p "$_sb4"
  # the original round's CHANGED text mentions 'PROPOSE 05:01' — the greedy-sed trap: extraction must
  # strip the |CHANGED tail FIRST or it anchors on the LAST 'PROPOSE ' and mines CHANGED garbage.
  printf '%s  genome@host  ::  [fyi] roll-call genome: PROPOSE wire the frobnitz sampler cron | CHANGED retracted my 05:01 PROPOSE earlier + landed abc1234 | GAP s\n' "$_t30" > "$_sb4/chat.log"
  printf '%s  genome@host  ::  [fyi] RETRACT my roll-call PROPOSE (frobnitz sampler cron): MOOT — already wired, no work needed\n' "$_t20" >> "$_sb4/chat.log"
  printf '%s  genome@host  ::  [fyi] roll-call genome: PROPOSE wire the frobnitz sampler cron | CHANGED s | GAP s\n' "$_t10" >> "$_sb4/chat.log"
  _sv4="$(ROLL_CALL_DRYRUN=1 MESH_DIR="$_sb4" "$0" --settled genome 2>/dev/null)"
  [ "$_sv4" = "retired $_t20" ] && echo "  ok: retract survives a later stale repost (first-appearance anchor)" || { echo "  FAIL: --settled must print 'retired $_t20' for a retracted-then-stale-reposted sig, got '$_sv4'"; fail=1; }
  # guard for the widened scan: a roll-call REPOST whose own CHANGED text mentions '[done]' sits between
  # first appearance and now — it must NOT self-settle the sig (own roll-call lines are excluded).
  _sb5="$_td/settled-selfline"; mkdir -p "$_sb5"
  printf '%s  genome@host  ::  [fyi] roll-call genome: PROPOSE wire the frobnitz sampler cron | CHANGED s | GAP s\n' "$_t30" > "$_sb5/chat.log"
  printf '%s  genome@host  ::  [fyi] roll-call genome: PROPOSE wire the frobnitz sampler cron | CHANGED [done] unrelated-slug landed | GAP s\n' "$_t10" >> "$_sb5/chat.log"
  _sv5="$(ROLL_CALL_DRYRUN=1 MESH_DIR="$_sb5" "$0" --settled genome 2>/dev/null)"
  [ "$_sv5" = open ] && echo "  ok: a repost mentioning [done] does NOT self-settle (own roll-call lines excluded)" || { echo "  FAIL: --settled must stay 'open' when only the mind's own roll-call repost mentions [done], got '$_sv5'"; fail=1; }
  # synth step present, targets tg, and posts a BOARD digest — NOT a voice/Telegram relay (operator silenced)
  chk "TELL synth:tg ::" "tg synthesis step injected"
  chk "[roll-call-synth]" "synth prompt tagged"
  chk "[fyi] roll-call DIGEST" "synth posts a board-internal [fyi] DIGEST"
  printf '%s' "$out" | grep -q 'mesh-voice-tx' && { echo "  FAIL: synth still references mesh-voice-tx (operator silenced voice 2026-06-24)"; fail=1; } || echo "  ok: NO voice/Telegram relay (mesh-voice-tx absent)"
  chk "HOLD" "synth holds until enough lines arrive (no hollow digest)"
  chk "ONE-TICK GRACE" "synth grants a one-tick grace before naming a late mind SILENT"
  chk "STILL SILENT after its grace" "digest flags only minds silent past the grace window"
  chk "FINAL RE-SCAN BEFORE POSTING" "synth re-reads the board immediately before posting to catch late arrivals"
  # BREVITY BUDGET (chat-review/digest-line-truncation): the synth must cap the posted board DIGEST so a long
  # digest is never SILENTLY truncated mid-item by the ~2000-char single-line view cap — terse preamble + budget.
  chk "BREVITY BUDGET" "synth carries the digest length-budget rule (no silent mid-line truncation)"
  chk "(N/N ok)" "synth preamble is terse when all answered (no per-mind timestamp enumeration)"
  chk "(+N trimmed)" "synth drops over-budget items DELIBERATELY with a trimmed-count note, never silently"
  # PROPOSE-DEDUP: the synth must carry the suppress rule + a real ledger built from the seeded sources.
  chk "PROPOSE-DEDUP" "synth carries the propose-dedup rule"
  chk "SUPPRESS-LEDGER" "synth injects the suppress-ledger block"
  # rollcall-digest-expected-set: the synth must carry a real ground-truth target list (this node's
  # LOCAL_MINDS + REMOTE_MINDS) and the instruction to fold foreign-host lines into their OWN section
  # instead of guessing them off — the live bug: a 12:01Z digest declared a peer node 'off by
  # card-gate' and dropped its 6 minds' PROPOSEs/GAPs.
  chk "EXPECTED-RESPONDER SET" "synth carries the expected-responder ground-truth block"
  chk "local (" "expected-set names THIS node's local target list"
  chk "fold them into their OWN per-node digest section" "synth folds foreign-host lines into per-node sections instead of judging them off"
  printf '%s' "$out" | grep -qF "$(hostname)" || { echo "  FAIL: expected-set does not name this host"; fail=1; }
  chk "match on INTENT" "dedup matches on intent (idle_sig principle), not bytes"
  chk "test-gated-cap" "ledger surfaces a GATED entry from proposals-gated"
  chk "draft-staging" "ledger surfaces a RECENTLY-RESOLVED subject from a board [done] line"
  printf '%s' "$out" | grep -q '# a comment line' && { echo "  FAIL: ledger leaked a #-comment line from proposals-gated"; fail=1; } || echo "  ok: proposals-gated #-comments stripped"
  # RETRACTED (the new third source): the synth rule carries clause (c) and the ledger surfaces a
  # self-retracted subject, while a meta line that merely MENTIONS a retraction does NOT over-suppress.
  chk "self-withdrawn PROPOSE never re-surfaces" "synth suppress rule covers self-retracted PROPOSEs (clause c)"
  chk "RETRACTED (3d):" "ledger carries the RETRACTED block"
  chk "sandbox-retract-subj" "ledger surfaces a self-RETRACTED subject from the proposer's own RETRACT line"
  printf '%s' "$out" | grep -qiF "re-surfaces a PROPOSE the proposer" && { echo "  FAIL: retraction scan over-matched a [chat-review] meta line (not a self-retraction → over-suppression)"; fail=1; } || echo "  ok: retraction scan ignores meta lines that merely mention retract/propose (no over-suppression)"
  # propose_sig (the dedupe canonicalizer): order + stopword + rewording invariant → same intent → same key.
  s1="$(ROLL_CALL_DRYRUN=1 MESH_DIR="$_td" "$0" --sig "stage the draft Show HN package")"
  s2="$(ROLL_CALL_DRYRUN=1 MESH_DIR="$_td" "$0" --sig "Show HN draft package stage")"
  [ -n "$s1" ] && [ "$s1" = "$s2" ] && echo "  ok: propose_sig collapses reworded same-intent proposals (key='$s1')" || { echo "  FAIL: propose_sig must collapse rewordings (s1='$s1' s2='$s2')"; fail=1; }
  s3="$(ROLL_CALL_DRYRUN=1 MESH_DIR="$_td" "$0" --sig "wire up the spend sampler cron")"
  [ "$s1" != "$s3" ] && echo "  ok: propose_sig keeps DISTINCT proposals distinct (no over-suppression)" || { echo "  FAIL: propose_sig collapsed two DIFFERENT proposals (over-suppression)"; fail=1; }
  # mode-context leak fix (roll-call/mesh-mode-context-leak): the real mode token comes from the MODE=
  # line, NOT head -1 — mesh-mode leads with a usage block. parse_mode must return the token, never 'usage'.
  _mm="$(printf 'usage: mesh-mode [<mode>]\n       mesh-mode --list\nModes:\nMODE=sprint\nLABEL=all minds at accelerated cadence\n')"
  _pm="$(printf '%s' "$_mm" | parse_mode)"
  [ "$_pm" = "sprint" ] && echo "  ok: mode-context reads the real MODE= token (sprint), not the 'usage' preamble" || { echo "  FAIL: parse_mode must read the MODE= token (got '$_pm', not 'sprint')"; fail=1; }
  # --ledger inspection hook returns the gated + resolved + retracted entries (sandboxed read).
  led="$(MESH_DIR="$_td" "$0" --ledger 2>&1)"
  printf '%s' "$led" | grep -qF "test-gated-cap" && printf '%s' "$led" | grep -qF "draft-staging" \
    && printf '%s' "$led" | grep -qF "sandbox-retract-subj" \
    && echo "  ok: --ledger prints gated + resolved + retracted entries" || { echo "  FAIL: --ledger missing seeded entries"; fail=1; }
  # RECURRING escalation (build_recurring): a chronic, NEVER-actioned PROPOSE seen in >=3 distinct rounds
  # (rewordings collapsed by propose_sig) must ESCALATE 'RECURRING x3'; one with a matching [task] must be
  # EXCLUDED; a 2-round one is BELOW threshold (no over-escalation). Scope checks to the RECURRING section.
  recur_sec="$(printf '%s' "$led" | sed -n '/^RECURRING/,$p')"
  printf '%s' "$recur_sec" | grep -q 'RECURRING x3' && printf '%s' "$recur_sec" | grep -qi 'sampler' \
    && echo "  ok: chronic never-actioned PROPOSE escalated (RECURRING x3; intent-key collapsed 3 rewordings)" \
    || { echo "  FAIL: chronic 3-round unactioned PROPOSE not escalated as RECURRING x3 (got: $recur_sec)"; fail=1; }
  printf '%s' "$recur_sec" | grep -qi 'swap' \
    && { echo "  FAIL: a recurring PROPOSE settled by a VERBOSE [task] (non-verbatim key) was escalated — sig-mismatch exclusion broken (grep -qxF regression)"; fail=1; } \
    || echo "  ok: recurring-but-actioned PROPOSE excluded via majority-overlap despite terse-vs-verbose key mismatch (rollcall-recurring-exclusion-sig-mismatch)"
  # SLUG-EATEN (chat-review/rollcall-task-slug-eaten-by-poster-prefix-sed) — BOTH edges of the body-prefix
  # strip, because the fix is a narrowing and a narrowing regresses the thing it narrows. (a) a [task] whose
  # close-key SLUG carries the covering tokens must CREDIT the PROPOSE it discharges (seed G); (b) a REAL
  # poster prefix ('[done] pub: draft-staging …') must STILL be stripped, or the subject keeps a window name
  # that is not part of it. Watched RED on (a) pre-fix: 'RECURRING x3 — unchanged (zorbex-plimwick-mismatch)'.
  printf '%s' "$recur_sec" | grep -qi 'zorbex' \
    && { echo "  FAIL: a recurring PROPOSE settled by a '[task] <slug>: <prose>' line still escalated — the poster-prefix strip ate the close-key slug (rollcall-task-slug-eaten-by-poster-prefix-sed)"; fail=1; } \
    || echo "  ok: a filed [task] whose close-key slug carries the covering tokens credits its PROPOSE (slug survives the poster-prefix strip)"
  printf '%s' "$led" | grep -qE '^[[:space:]]*-[[:space:]]+pub:' \
    && { echo "  FAIL: a REAL poster prefix ('pub:') survived into a RESOLVED ledger subject — the anchored strip must still strip an actual poster"; fail=1; } \
    || echo "  ok: a REAL poster prefix ('pub:') is still stripped from the harvested subject (narrowing did not disable the strip)"
  # chat-review/roll-call-recurring-stale-label: the representative wording shown for a chronic RECURRING
  # sig must be the MOST-RECENT round's phrasing, not whichever historical rewording happened to be
  # LONGEST. The 3 seeded rewordings above are oldest-round(t30)=longest(38 chars), then two shorter
  # (34 chars each) at t20/t10 — a "longest wins" picker freezes on the t30 text forever; a "most-recent
  # round wins" picker must show the t10 (newest) text.
  printf '%s' "$recur_sec" | grep -qF "cron spend sampler wire post reorg" \
    && echo "  ok: RECURRING representative text is the MOST-RECENT round's wording, not frozen-longest" \
    || { echo "  FAIL: RECURRING representative text is not the most-recent round's wording (got: $recur_sec)"; fail=1; }
  printf '%s' "$recur_sec" | grep -qF "wire the spend sampler cron post reorg" \
    && { echo "  FAIL: RECURRING representative text is still the STALE oldest/longest wording (roll-call-recurring-stale-label regression)"; fail=1; } \
    || echo "  ok: stale oldest/longest wording no longer shown as the representative"
  # NULL-SENTINEL (chat-review/rollcall-null-sentinel-escalated-as-chronic): a no-proposal answer is
  # never a chronic PROPOSE. Watched RED pre-fix — the 6 seeded nulls escalated as one x6 sig, the
  # live shape that minted this very adjudicate task. Unit truth-table first (both directions), then
  # the end-to-end artifact: the RECURRING block carries no null, and the REAL restated proposal that
  # wears the same wrapper SURVIVES (suppression that discriminates, not a blanket silencer).
  for _np in 'none' 'unchanged (none)' 'none — declined (nothing outstanding)' 'unchanged (no active proposal)' 'none (retired 15:01Z)' 'unchanged (none — declined)' 'none this pass' 'unchanged (none, declined stands)' ''; do
    is_null_propose "$_np" || { echo "  FAIL: is_null_propose must call '$_np' a null sentinel (no proposal)"; fail=1; }
  done
  for _rp in 'unchanged (redmi-auth)' 'unchanged (ssh-key-redistribute)' 'keep the swap unchanged at 12g' 'nonexistent probe telemetry' 'wire the spend sampler cron post reorg'; do
    is_null_propose "$_rp" && { echo "  FAIL: is_null_propose silenced a REAL proposal: '$_rp'"; fail=1; }
  done
  echo "  ok: is_null_propose truth-table — 9 null forms suppressed, 5 real proposals survive"
  printf '%s' "$recur_sec" | grep -qiE 'RECURRING x[0-9]+ — *(none|unchanged \(no)' \
    && { echo "  FAIL: a NULL-sentinel PROPOSE (none / unchanged (none)) escalated as a chronic proposal (got: $recur_sec)"; fail=1; } \
    || echo "  ok: null-sentinel PROPOSEs (6 rounds, 6 minds) never escalate — absence of a proposal is not a proposal"
  printf '%s' "$recur_sec" | grep -qF 'unchanged (redmi-auth)' \
    && echo "  ok: a REAL restated proposal in the same 'unchanged (<slug>)' wrapper still escalates (guard discriminates)" \
    || { echo "  FAIL: the null-sentinel guard also suppressed a REAL restated proposal (over-suppression; got: $recur_sec)"; fail=1; }
  printf '%s' "$recur_sec" | grep -qi 'zlonk' \
    && { echo "  FAIL: a 2-round PROPOSE was escalated (over-escalation below RECUR_N)"; fail=1; } \
    || echo "  ok: below-threshold (2-round) PROPOSE not escalated"
  # RETIRE-BRANCH credited (chat-review/rollcall-retire-branch-not-credited): a chronic 3-round PROPOSE
  # RETIRED via the escalation's own 'PROPOSE none — declined <why>' wording reached a decision and must
  # NOT re-escalate. Watched RED pre-fix (excl harvested only [done]/[task]/[resolving]); the retire-harvest
  # arm credits it. Guard the OTHER edge too: the SAMPLER sig (x3, never retired) must STILL escalate — a
  # blanket 'any declined line suppresses everything' would silence it.
  printf '%s' "$recur_sec" | grep -qi 'flurm' \
    && { echo "  FAIL: a chronic PROPOSE RETIRED via 'PROPOSE none — declined <why>' still escalated — retire branch not credited"; fail=1; } \
    || echo "  ok: a chronic PROPOSE retired via the escalation's own 'PROPOSE none — declined <why>' wording is credited as decided (not re-escalated)"
  # RECURRING DECIDER (chat-review/rollcall-recurring-has-no-decider): the escalation had NO addressee —
  # 'decide or retire xN' was digest prose dispatch never routes, respond_prompt never showed the proposer
  # its own count, and sig_actioned only CLEARS decisions already made (live: x8/x7/x6/x3 climbing for days).
  # (a) SOURCE-SIDE: the respondent prompt of the mind that LAST re-posted a >=RECUR_N chronic sig must
  # carry its live recur count + a forced file-or-retire clause — the decision is forced where the context
  # lives. genome is the most-recent (t10) proposer of the x3 sampler sig.
  printf '%s\n' "$out" | grep 'TELL local:genome ::' | grep -q 'recurred x3' \
    && echo "  ok: chronic proposer's prompt carries its live recur count (recurred x3)" \
    || { echo "  FAIL: genome's respondent prompt must carry 'recurred x3' for its chronic sampler PROPOSE"; fail=1; }
  printf '%s\n' "$out" | grep 'TELL local:genome ::' | grep -q "PROPOSE none — declined" \
    && echo "  ok: chronic proposer's prompt carries the file-or-retire clause" \
    || { echo "  FAIL: genome's respondent prompt must carry the file-or-retire clause (PROPOSE none — declined <why>)"; fail=1; }
  # addressee = the MOST-RECENT proposer only; earlier co-proposers and sub-N minds stay clause-free
  printf '%s\n' "$out" | grep 'TELL local:minds ::' | grep -q 'recurred x' \
    && { echo "  FAIL: minds got a recur clause though genome is the most-recent proposer (mis-addressed)"; fail=1; } \
    || echo "  ok: earlier co-proposer (minds) gets no clause — addressee is the most-recent proposer"
  printf '%s\n' "$out" | grep 'TELL local:health ::' | grep -q 'recurred x' \
    && { echo "  FAIL: health got a recur clause for a sub-RECUR_N (x2) PROPOSE (over-escalation)"; fail=1; } \
    || echo "  ok: sub-threshold (x2) proposer's prompt unchanged (no clause)"
  # (b) BACKSTOP — TWO-RUN shape (chat-review/rollcall-backstop-same-round-race): the backstop used to
  # fire in the SAME pass that delivered the clause, with no clause-delivery memory — its first run
  # minted 4 adjudicate [task]s at 00:00:53Z for chronic proposes the same round's answers decided by
  # 00:01:45Z (each due a wasted pace slot). The clause must go first and be RECORDED; the backstop
  # adjudicates only a sig RE-POSTED strictly after a recorded clause delivery. The old assertion here
  # (`_adjn = 1` off the single `out` run) asserted the same-run fire — it encoded the bug.
  # RUN 1 (`out` above, marker = now-60): pub's x6 frobwidget sig gets the clause; ZERO adjudicate posts
  # (all seed proposes predate the clause). Watched RED pre-fix (old code posted 1 same-run).
  _adjn="$(printf '%s\n' "$out" | grep -c '^POST board :: \[task\] roll-call/adjudicate-')"
  [ "$_adjn" = 0 ] && echo "  ok: clause-delivery round posts ZERO adjudicate tasks (no same-round race)" \
    || { echo "  FAIL: the backstop fired in the same round it delivered the clause (got $_adjn adjudicate POSTs, want 0)"; fail=1; }
  printf '%s\n' "$out" | grep 'TELL local:pub ::' | grep -q 'recurred x6' \
    && echo "  ok: the x6 proposer (pub) got the clause in the same run (clause-first, backstop-later)" \
    || { echo "  FAIL: pub's prompt must carry 'recurred x6' — the clause the backstop waits on"; fail=1; }
  # RUN 2a — sig NOT re-posted since the clause: still ZERO (this is the live 00:00Z race, now held).
  out2a="$(ROLL_CALL_DRYRUN=1 ROLL_CALL_WINDOWS_OVERRIDE="$_wov" MESH_MODE_OVERRIDE=test MESH_DIR="$_td" MESH_ROLL_CALL_NOW="$(date +%s)" MESH_CARD="$_td/card-minds" "$0" 2>&1)"
  _adjn2a="$(printf '%s\n' "$out2a" | grep -c '^POST board :: \[task\] roll-call/adjudicate-')"
  [ "$_adjn2a" = 0 ] && echo "  ok: sig not re-posted since the clause → later run still posts ZERO (answers get their round)" \
    || { echo "  FAIL: backstop adjudicated a sig never re-posted after its clause (got $_adjn2a, want 0)"; fail=1; }
  # RUN 2b — sig RE-POSTED (reworded, same intent-key) strictly after the clause round: exactly ONE
  # adjudicate [task], and its Subject: carries the ORIGINAL (first-round) propose text, never the
  # latest re-post wording (live: all 4 adj lines showed the re-post literal 'unchanged (<slug>)').
  printf '%s  pub@host  ::  [fyi] roll-call pub: PROPOSE nightly purge lane frobwidget grind | CHANGED s | GAP s\n' "$(date -u +%FT%TZ)" >> "$_td/chat.log"
  out2="$(ROLL_CALL_DRYRUN=1 ROLL_CALL_WINDOWS_OVERRIDE="$_wov" MESH_MODE_OVERRIDE=test MESH_DIR="$_td" MESH_ROLL_CALL_NOW="$(date +%s)" MESH_CARD="$_td/card-minds" "$0" 2>&1)"
  _adjn2="$(printf '%s\n' "$out2" | grep -c '^POST board :: \[task\] roll-call/adjudicate-')"
  [ "$_adjn2" = 1 ] && echo "  ok: sig re-posted after the clause round → exactly ONE adjudicate [task]" \
    || { echo "  FAIL: expected exactly 1 adjudicate POST for the clause-dodging re-posted sig (got $_adjn2)"; fail=1; }
  printf '%s\n' "$out2" | grep '^POST board :: ' | grep -q 'Subject: grind the frobwidget purge lane nightly' \
    && echo "  ok: adjudicate Subject: carries the ORIGINAL first-round propose text" \
    || { echo "  FAIL: adjudicate Subject: must be the original propose text, not the latest re-post wording"; fail=1; }
  printf '%s\n' "$out2" | grep '^POST board :: ' | grep -q '(owner: minds)' \
    && echo "  ok: adjudicate task routes to a decider (owner: minds)" \
    || { echo "  FAIL: adjudicate task missing '(owner: minds)' routing"; fail=1; }
  # RUN 2c — sig ACTIONED after the clause (a settling [task] exists): ZERO (decision made, no decider
  # needed). Snapshot/restore the board so this suppressor never masks the once-per-sig guard below.
  cp "$_td/chat.log" "$_td/chat.log.pre-actioned"
  printf '%s  minds@host  ::  [task] chat-review/frobwidget-purge: grind the frobwidget purge lane nightly via cron\n' "$(date -u +%FT%TZ)" >> "$_td/chat.log"
  out2c="$(ROLL_CALL_DRYRUN=1 ROLL_CALL_WINDOWS_OVERRIDE="$_wov" MESH_MODE_OVERRIDE=test MESH_DIR="$_td" MESH_ROLL_CALL_NOW="$(date +%s)" MESH_CARD="$_td/card-minds" "$0" 2>&1)"
  _adjn2c="$(printf '%s\n' "$out2c" | grep -c '^POST board :: \[task\] roll-call/adjudicate-')"
  [ "$_adjn2c" = 0 ] && echo "  ok: sig actioned after the clause → ZERO adjudicate (decision already made)" \
    || { echo "  FAIL: backstop adjudicated a sig a settling [task] already actioned (got $_adjn2c, want 0)"; fail=1; }
  mv "$_td/chat.log.pre-actioned" "$_td/chat.log"
  # once per sig: with the adjudicate [task] already on the board, a re-run must post ZERO. The fixture
  # task is AGED past the LEDGER_DAYS cutoff deliberately: a recent task would ALSO be excluded by the
  # sig_actioned arm (its line carries the subject), masking a deleted grep guard — but that arm is
  # date-bounded, so a still-open adjudicate task older than LEDGER_DAYS leaves the exclusion window
  # while still on the board, and only the unbounded grep-the-board guard prevents a duplicate re-post.
  # (clause state + the post-clause re-post are still in place, so ONLY the grep guard yields the zero.)
  _adj="$(printf '%s\n' "$out2" | grep -m1 '^POST board :: ' | sed 's/^POST board :: //')"
  printf '%s  minds@host  ::  %s\n' "$(date -u -d '-4 days' +%FT%TZ 2>/dev/null || echo 2000-01-01T00:00:00Z)" "$_adj" >> "$_td/chat.log"
  out3="$(ROLL_CALL_DRYRUN=1 ROLL_CALL_WINDOWS_OVERRIDE="$_wov" MESH_MODE_OVERRIDE=test MESH_DIR="$_td" MESH_ROLL_CALL_NOW="$(date +%s)" MESH_CARD="$_td/card-minds" "$0" 2>&1)"
  _adjn3="$(printf '%s\n' "$out3" | grep -c '^POST board :: \[task\] roll-call/adjudicate-')"
  [ "$_adjn3" = 0 ] && echo "  ok: adjudicate [task] already on the board → re-run posts none (once per sig)" \
    || { echo "  FAIL: re-run re-posted an adjudicate task despite one already on the board (got $_adjn3)"; fail=1; }
  # CARD-AUTHORITATIVE GATE (rollcall-card-gate): a HANDS-OFF node (card declares no AI mind) must exit
  # WITHOUT pinging any window; a with-minds card (the main run above) already proves the pass-path.
  # Falsify each direction. NOTE: the with-minds pass-path IS the whole `out` run above (10 TELLs) —
  # if the gate wrongly fired there, every assertion above would already have failed.
  printf '  role: compute\n# minds: BLANKED (minds-off)\n' > "$_td/card-nominds"
  goff="$(ROLL_CALL_DRYRUN=1 ROLL_CALL_WINDOWS_OVERRIDE="$_wov" MESH_MODE_OVERRIDE=test MESH_DIR="$_td" MESH_ROLL_CALL_NOW=1 MESH_CARD="$_td/card-nominds" "$0" 2>&1)"
  printf '%s' "$goff" | grep -q 'TELL ' && { echo "  FAIL: no-minds card still pinged windows (card-gate not applied)"; fail=1; } || echo "  ok: no-minds card → zero window pings (HANDS-OFF gate)"
  printf '%s' "$goff" | grep -qF "minds declared OFF" && echo "  ok: no-minds card surfaces the HANDS-OFF skip reason" || { echo "  FAIL: no-minds skip reason not surfaced"; fail=1; }
  # a `minds:` line present but listing NO known engine (blanked value) is ALSO HANDS-OFF
  printf '  minds:\n' > "$_td/card-emptyminds"
  gempty="$(ROLL_CALL_DRYRUN=1 ROLL_CALL_WINDOWS_OVERRIDE="$_wov" MESH_MODE_OVERRIDE=test MESH_DIR="$_td" MESH_ROLL_CALL_NOW=1 MESH_CARD="$_td/card-emptyminds" "$0" 2>&1)"
  printf '%s' "$gempty" | grep -q 'TELL ' && { echo "  FAIL: empty minds: value still pinged (must be HANDS-OFF)"; fail=1; } || echo "  ok: empty minds: value → HANDS-OFF (no pings)"
  # RESTORE.ENV-DECLARED MINDS-OFF (chat-review/doctor-autonomy-check-minds-off-cryolf 2026-07-08): a
  # card that STILL lists installed binaries (mesh-card --refresh auto-detects them, so it can never
  # self-clear once binaries are present) must be overridden by restore.env's own MESH_MIND_CHANNELS=
  # none/empty — the durable off-switch on a node like Default-string (binaries installed, minds
  # driving deliberately OFF since 2026-06-17).
  printf 'MESH_MIND_CHANNELS=none\n' > "$_td/restore.env"
  goffrenv="$(ROLL_CALL_DRYRUN=1 ROLL_CALL_WINDOWS_OVERRIDE="$_wov" MESH_MODE_OVERRIDE=test MESH_DIR="$_td" MESH_ROLL_CALL_NOW=1 MESH_CARD="$_td/card-minds" "$0" 2>&1)"
  printf '%s' "$goffrenv" | grep -q 'TELL ' && { echo "  FAIL: restore.env MESH_MIND_CHANNELS=none still pinged windows despite a mind-listing card (restore.env override not applied)"; fail=1; } || echo "  ok: restore.env MESH_MIND_CHANNELS=none → HANDS-OFF even with a mind-listing card"
  rm -f "$_td/restore.env"   # don't leak into the fail-safe/no-card test below
  # FAIL-SAFE: NO card file at all → RUN (never silence a healthy node on a missing card / fresh boot)
  gnocard="$(ROLL_CALL_DRYRUN=1 ROLL_CALL_WINDOWS_OVERRIDE="$_wov" MESH_MODE_OVERRIDE=test MESH_DIR="$_td" MESH_ROLL_CALL_NOW=1 MESH_CARD="$_td/does-not-exist" "$0" 2>&1)"
  printf '%s' "$gnocard" | grep -q 'TELL local:genome ::' && echo "  ok: missing card → roll-call RUNS (fresh-boot fail-safe, not silenced)" || { echo "  FAIL: missing card wrongly gated off a healthy node (boot fail-safe broken)"; fail=1; }
  # no real outbound leaked (DRYRUN must mean NO mesh-tell process was spawned — assert by absence of failures above + bounded output)
  [ "$fail" = 0 ] && { echo "smoke-test: ok (10 minds prompted [7 baseline+discover auto-extend, 2 remote] + tg synth→BOARD digest [no voice], 3-field template, PROPOSE-DEDUP ledger [gated+resolved+retracted+intent-key] + RECURRING escalation with a DECIDER [source-side file-or-retire clause to the rep proposer + once-per-sig adjudicate [task] at >=2xRECUR_N, clause-first two-run backstop (records deliveries, adjudicates only a sig re-posted after its clause, Subject = original propose text)] + CARD-AUTHORITATIVE gate [no-minds/empty-minds HANDS-OFF, missing-card fail-safe], fully sandboxed)"; exit 0; }
  echo "smoke-test: FAIL"; exit 1
fi

# ── live run ─────────────────────────────────────────────────────────────────────────────────────
mkdir -p "$MESH"
# CARD-AUTHORITATIVE GATE (rollcall-card-gate): a HANDS-OFF node (card declares no AI mind) must not
# roll-call — no window pings, no tg synth. Fires BEFORE any tell so a minds-off node stays fully off
# the mind plane (the ds off-mesh-ping + digest-misflag this fixes). Missing card → runs (boot fail-safe).
if node_minds_off; then
  echo "$(date -u +%FT%TZ) roll-call: SKIP — minds declared OFF (card lacks a minds: engine, or restore.env MESH_MIND_CHANNELS=none) (HANDS-OFF gate)" >> "$MESH/roll-call.log" 2>/dev/null || true
  echo "ROLL-CALL SKIP: minds declared OFF (card lacks a minds: engine, or restore.env MESH_MIND_CHANNELS=none) — node not on the mind plane"
  exit 0
fi
marker="${MESH_ROLL_CALL_NOW:-$(date +%s)}"          # epoch; override only for deterministic tests
printf '%s\n' "$marker" > "$MESH/.roll-call.ts" 2>/dev/null || true
mode="${MESH_MODE_OVERRIDE:-$(mesh-mode 2>/dev/null | parse_mode)}"
mode="${mode:-normal}"   # parse_mode reads the MODE=<token> line (skips the usage preamble); default if absent

# auto-extend the DEFAULT respondent set with any live 2-pane mind window not already listed (e.g.
# discover) so non-consume windows are wake-poked. Skipped when ROLL_CALL_MINDS is an explicit
# override (respect a curated subset). Empty enumeration (no tmux/session) ⇒ baseline unchanged.
if [ -z "${ROLL_CALL_MINDS:-}" ]; then
  for w in $(session_mind_windows); do
    case " $LOCAL_MINDS " in *" $w "*) :;; *) LOCAL_MINDS="$LOCAL_MINDS $w";; esac
  done
fi
# RETIRED-CHANNEL FILTER (rollcall-retired-not-silent): a channel in MESH_RETIRED_CHANNELS is
# decommissioned BY DESIGN — no window is planted for it, so it can never answer. Drop it from the
# respondent set (both the pings AND the expected_set below) so the tg synth never names it SILENT and
# files a phantom liveness-check against a window retired on purpose. This is the durable fix for the
# 4-round 'minds/chat/room SILENT' the tg mind hand-diagnosed 2026-07-29 (chat+room in the curated
# baseline, all three in MESH_RETIRED_CHANNELS): the CODE now hands the synth a ground truth that
# matches reality, instead of relying on the LLM synth to peek the live session and override its own
# instructed expected-set every round. Applies even under a ROLL_CALL_MINDS override — a retired channel
# is never a valid respondent. Empty retired set ⇒ no-op (safe default).
_retired="$(retired_channels)"
if [ -n "$_retired" ]; then
  _kept=""
  for w in $LOCAL_MINDS; do
    case " $_retired " in *" $w "*) continue ;; esac
    _kept="${_kept:+$_kept }$w"
  done
  LOCAL_MINDS="$_kept"
fi

prompted=0
# local minds carry their live recurrence clause (recur_for_mind); remote minds do NOT — the board's
# 'roll-call <win>:' tag carries no hostname, so a same-named remote window is indistinguishable from
# the local one and a clause sent there could be mis-addressed. The local rep proposer gets it.
for w in $LOCAL_MINDS; do tell_local "$w" "$(respond_prompt "$w" "$(recur_for_mind "$w")")"; prompted=$((prompted+1)); done
for pw in $REMOTE_MINDS; do
  peer="${pw%%:*}"; win="${pw#*:}"
  tell_remote "$peer" "$win" "$(respond_prompt "$win")"; prompted=$((prompted+1))
done

# CLAUSE-DELIVERY MEMORY (chat-review/rollcall-backstop-same-round-race): record WHICH sigs just had
# their file-or-retire clause delivered, and WHEN — the adjudicate backstop below reads this instead
# of judging off the bare board (recur_rows sees only PROPOSE history, so on the first clause-carrying
# round it cannot see the answers it exists to wait for; live 00:00:53Z it minted 4 adjudicate tasks
# for decisions the same round made by 00:01:45Z). First delivery only — re-recording each round would
# roll the epoch forward and the backstop's 're-posted AFTER the clause' test could never pass. The
# selection mirrors recur_for_mind exactly (top row per mind, local minds only — a clause we never
# delivered must never start the backstop clock; under-escalate is safe). A DRYRUN records to its own
# side file, never the live state (the guardian dry-run-forges-the-artifact lesson, 09f7914).
CLAUSE_STATE="$MESH/.roll-call-clauses${DRYRUN:+.dryrun}"
recur_rows "${RECUR_N:-3}" | awk -F'\t' '!seen[$3]++' | while IFS=$'\t' read -r _n _sig _mind _subj _; do
  case " $LOCAL_MINDS " in *" $_mind "*) ;; *) continue ;; esac
  awk -F'\t' -v s="$_sig" '$2==s{f=1} END{exit !f}' "$CLAUSE_STATE" 2>/dev/null && continue
  printf '%s\t%s\n' "$marker" "$_sig" >> "$CLAUSE_STATE" 2>/dev/null || true
done
# bounded state: chronic sigs resolve or adjudicate within days; keep the tail, never grow unbounded
[ "$(wc -l < "$CLAUSE_STATE" 2>/dev/null || echo 0)" -gt 500 ] \
  && { tail -250 "$CLAUSE_STATE" > "$CLAUSE_STATE.tmp" && mv "$CLAUSE_STATE.tmp" "$CLAUSE_STATE"; }

# inject the synthesis step into the tg window — with the PROPOSE-DEDUP suppress-ledger so the digest
# never re-surfaces an already-answered or operator-gated PROPOSE (idle_sig dedupe principle).
ledger="$(build_ledger)"
# expected-responder set (rollcall-digest-expected-set): the synth's ONLY ground truth for judging
# silence is what THIS node's roll-call actually targeted — $LOCAL_MINDS (post auto-extend, above)
# + $REMOTE_MINDS. Anything else on the board is a foreign host's own roll-call, not ours to judge.
expected_set="local ($(hostname)): $LOCAL_MINDS; remote: ${REMOTE_MINDS:-none}"
synth="$(synth_prompt "$marker" "$mode" "$ledger" "$expected_set")"
if [ -n "$DRYRUN" ]; then printf 'TELL synth:%s :: %s\n' "$SYNTH_WIN" "$synth"
else mesh-tell "$SYNTH_WIN" "$synth" >/dev/null 2>&1 || true; fi

# ADJUDICATE BACKSTOP (rollcall-recurring-has-no-decider, arm b): a sig STILL recurring at >=2xRECUR_N
# despite the source-side clause has a proposer that keeps dodging — post ONE real [task] (owner: minds)
# so dispatch routes an actual decider. Once per sig: the grep guard makes it explicit, and the task
# line carries the subject text so sig_actioned excludes the sig from every recurring arm thereafter
# (the escalation stops the moment a decider task exists). CLAUSE-FIRST (rollcall-backstop-same-round-
# race): 'keeps dodging' is only judgeable on a sig RE-POSTED strictly AFTER a recorded clause delivery
# — no recorded clause, or no re-post since it, means the proposer has not yet had a round to answer,
# so the backstop holds (the source-side arm goes first). Subject: carries the ORIGINAL first-round
# propose text (subj0), never the latest re-post literal ('unchanged (<slug>)').
adj_n=$(( 2 * ${RECUR_N:-3} ))
while IFS=$'\t' read -r n sig mind subj subj0 lastep; do
  [ -n "${sig:-}" ] || continue
  slug="$(printf '%s' "$sig" | tr ' ' '-' | cut -c1-40 | sed -E 's/-+$//')"
  grep -qF "roll-call/adjudicate-$slug" "$CHAT_LOG" 2>/dev/null && continue
  cep="$(awk -F'\t' -v s="$sig" '$2==s{print $1; exit}' "$CLAUSE_STATE" 2>/dev/null)"
  [ -n "$cep" ] || continue                        # clause never delivered — nothing to have dodged
  [ "${lastep:-0}" -gt "$cep" ] || continue        # not re-posted since the clause — its answer round is still open
  adj_line="[task] roll-call/adjudicate-$slug: chronic PROPOSE recurred x$n rounds with no decision despite the per-round file-or-retire clause (last proposer: $mind) — adjudicate: turn it into a real [task]/[design] or gate it in proposals-gated. Subject: ${subj0:-$subj} (owner: minds)"
  if [ -n "$DRYRUN" ]; then printf 'POST board :: %s\n' "$adj_line"
  else MESH_WHO="roll-call@$(hostname)" mesh-chat "$adj_line" >/dev/null 2>&1 || true; fi
done < <(recur_rows "$adj_n")

# one bounded trace line (durable history tier; NOT the board — the minds' [fyi]s are the board signal)
ts="$(date -u +%FT%TZ)"
echo "$ts roll-call: prompted $prompted mind(s) (mode=$mode marker=$marker) → tg synth→board digest" >> "$MESH/roll-call.log" 2>/dev/null || true
[ "$(wc -l < "$MESH/roll-call.log" 2>/dev/null || echo 0)" -gt 2000 ] && { tail -1000 "$MESH/roll-call.log" > "$MESH/roll-call.log.tmp" && mv "$MESH/roll-call.log.tmp" "$MESH/roll-call.log"; }
[ -n "$DRYRUN" ] || echo "roll-call: prompted $prompted mind(s) (mode=$mode) → tg will synthesize + post board digest"
exit 0
