#!/usr/bin/env bash
# mesh-misha-gate — is the room CONFIRMED-occupied enough for Misha (the room mind) to speak?
#
# Operator 2026-06-24 (Misha dormant-by-default, tier-1): "Misha SPEAKS on the Bose ONLY when
# room-occupancy is CONFIRMED with high confidence — a camera face/person detection OR strong
# multi-sense occupancy (body-motion + presence). NEVER speak off the mesh-overhear AUDIO
# classifier's 'sound/music' verdict (it hears music in an empty room)."
#
# This is the single authority for that bar. It runs mesh-room-sense and returns:
#   exit 0  → room CONFIRMED occupied (Misha may wake/speak)
#   exit 1  → not confirmed (keep Misha dormant) — reason on stderr
#
# "Confirmed" = mesh-room-sense verdict=PRESENT AND confidence=HIGH — and by mesh-room-sense's own
# fusion that confidence tier is ONLY reached by NON-AUDIO signals (camera motion / keyboard typing /
# body CARRIED|HANDLED / strong named BLE / WiFi motion). The audio-only path (ambient MODERATE/LOUD
# with the phone offline) tops out at confidence=medium → never confirms → Misha stays dormant. So
# the audio-classifier false-positive (task senses/misha-music-falsepos) CANNOT wake him via this gate.
#
# Tier-2 (face-recognition wake) hooks in here: if MISHA_FACE=1 and the operator's reference photo is
# present, an operator-face detection also confirms (the camera SAW the operator, not just motion).
#
#   mesh-misha-gate             assess now; exit 0=confirmed, 1=not (reason on stderr)
#   mesh-misha-gate --json      print {confirmed, verdict, confidence, reason} and exit 0/1
#   mesh-misha-gate --test      synthetic state assertions (no sensors, no network)
#
# Used by: mesh-room say (Misha's speak verb), and the wake reflexes (mesh-room-sense/room-activity
# --edge with MISHA_CONFIRMED_ONLY=1) so only a confirmed room emits the Misha-driving edge line.
set -uo pipefail
MESH="${MESH_DIR:-$HOME/.mesh}"

# ---- --test: drive the decision fn with synthetic JSON (no sensor run) ----
if [ "${1:-}" = "--test" ]; then
  decide(){  # $1 = JSON → echoes confirmed|no, reason on stderr; exit 0/1
    python3 - "$1" <<'PY'
import json, sys
try: d = json.loads(sys.argv[1])
except Exception: print("no"); sys.stderr.write("bad json\n"); sys.exit(1)
v = d.get("verdict",""); c = d.get("confidence","")
# confirmed iff PRESENT + HIGH (mesh-room-sense: HIGH is reachable ONLY via non-audio signals)
if v == "PRESENT" and c == "high":
    print("yes"); sys.exit(0)
reason = "verdict=%s confidence=%s" % (v, c)
if v != "PRESENT": reason = "not PRESENT (%s)" % v
elif c != "high": reason = "PRESENT but confidence=%s (audio-only can't confirm)" % c
print("no"); sys.stderr.write(reason + "\n"); sys.exit(1)
PY
  }
  fail=0
  chk(){ # $1 name $2 json $3 want(yes|no)
    local out rc; out="$(decide "$2" 2>/dev/null)"; rc=$?
    if [ "$3" = yes ]; then [ "$rc" = 0 ] && [ "$out" = yes ] && echo "  [PASS] $1 → confirmed" || { echo "  [FAIL] $1 → expected confirmed, got rc=$rc out=$out"; fail=1; }
    else [ "$rc" = 1 ] && [ "$out" = no ] && echo "  [PASS] $1 → dormant" || { echo "  [FAIL] $1 → expected dormant, got rc=$rc out=$out"; fail=1; }; fi
  }
  chk "cam motion + HIGH"    '{"verdict":"PRESENT","confidence":"high"}'                   yes
  chk "body CARRIED + HIGH"  '{"verdict":"PRESENT","confidence":"high","reason":"body"}'   yes
  chk "kbd TYPING + HIGH"    '{"verdict":"PRESENT","confidence":"high"}'                   yes
  chk "audio-only MEDIUM"    '{"verdict":"PRESENT","confidence":"medium"}'                 no   # the bar: audio can't confirm
  chk "UNCERTAIN"            '{"verdict":"UNCERTAIN","confidence":"low"}'                  no
  chk "EMPTY"                '{"verdict":"EMPTY","confidence":"high"}'                     no
  chk "PRESENT but low conf" '{"verdict":"PRESENT","confidence":"low"}'                    no
  [ "$fail" = 0 ] && { echo "smoke-test: ok (HIGH+PRESENT confirms; audio-medium/EMPTY/UNCERTAIN stay dormant)"; exit 0; }
  echo "smoke-test: FAIL"; exit 1
fi

# ---- live assessment ----
if ! command -v mesh-room-sense >/dev/null 2>&1; then
  echo "mesh-misha-gate: mesh-room-sense unavailable — fail-OPEN (allow) so Misha isn't stranded" >&2
  exit 0
fi
JSON="$(timeout 40 mesh-room-sense --json 2>/dev/null)" || { echo "mesh-misha-gate: room-sense failed — fail-OPEN" >&2; exit 0; }
[ -n "$JSON" ] || { echo "mesh-misha-gate: empty room-sense output — fail-OPEN" >&2; exit 0; }

read -r verdict confidence reason <<EOF
$(python3 -c 'import json,sys; d=json.loads(sys.stdin.read()); print(d.get("verdict",""),d.get("confidence",""),d.get("reason",""))' <<<"$JSON" 2>/dev/null)
EOF

if [ "${1:-}" = "--json" ]; then
  confirmed=$([ "$verdict" = "PRESENT" ] && [ "$confidence" = "high" ] && echo true || echo false)
  printf '{"confirmed":%s,"verdict":"%s","confidence":"%s","reason":"%s"}\n' "$confirmed" "$verdict" "$confidence" "$reason"
fi

if [ "$verdict" = "PRESENT" ] && [ "$confidence" = "high" ]; then
  exit 0
fi
echo "mesh-misha-gate: dormant — verdict=$verdict confidence=$confidence (need PRESENT+high; audio-only can't confirm)" >&2
exit 1
