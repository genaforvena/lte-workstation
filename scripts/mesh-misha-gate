#!/usr/bin/env bash
# mesh-misha-gate — is the room CONFIRMED-occupied enough for Misha (the room mind) to speak?
#
# Operator 2026-06-24 (Misha dormant-by-default, tier-1): "Misha SPEAKS on the Bose ONLY when
# room-occupancy is CONFIRMED with high confidence — a camera face/person detection OR strong
# multi-sense occupancy (body-motion + presence). NEVER speak off the mesh-overhear AUDIO
# classifier's 'sound/music' verdict (it hears music in an empty room)."
#
# This is the single authority for that bar. It runs mesh-room-sense and returns:
#   exit 0  → room CONFIRMED occupied (Misha may wake/speak)
#   exit 1  → not confirmed (keep Misha dormant) — reason on stderr
#
# "Confirmed" = mesh-room-sense verdict=PRESENT AND confidence=HIGH — and by mesh-room-sense's own
# fusion that confidence tier is ONLY reached by NON-AUDIO signals (camera motion / keyboard typing /
# body CARRIED|HANDLED / strong named BLE / WiFi motion). The audio-only path (ambient MODERATE/LOUD
# with the phone offline) tops out at confidence=medium → never confirms → Misha stays dormant. So
# the audio-classifier false-positive (task senses/misha-music-falsepos) CANNOT wake him via this gate.
#
# Tier-2 (face-recognition wake) hooks in here: if MISHA_FACE=1 and the operator's reference photo is
# present, an operator-face detection also confirms (the camera SAW the operator, not just motion).
#
#   mesh-misha-gate             assess now; exit 0=confirmed, 1=not (reason on stderr)
#   mesh-misha-gate --json      print {confirmed, verdict, confidence, reason} and exit 0/1
#   mesh-misha-gate --test      synthetic state assertions (no sensors, no network)
#
# Used by: mesh-room say (Misha's speak verb), and the wake reflexes (mesh-room-sense/room-activity
# --edge with MISHA_CONFIRMED_ONLY=1) so only a confirmed room emits the Misha-driving edge line.
set -uo pipefail
export PATH="/usr/bin:$HOME/.local/bin:$PATH"   # ssh/cron minimal PATH lacks ~/.local/bin — mesh-room-sense must resolve
MESH="${MESH_DIR:-$HOME/.mesh}"

# TIER-2 face confirm path: mesh-misha-wake (the periodic face poll) writes ~/.mesh/misha-face-awake
# with an epoch expiry whenever it sees the operator's face. While that window is open, the camera
# SAW the operator → confirmed, independent of room-sense (and cheap: one epoch compare, no Groq here —
# the vision cost lives in the reflex). Window lapse = operator gone = fall back to the room-sense bar.
face_stamp_active(){ local f="$MESH/misha-face-awake" e; [ -r "$f" ] || return 1
                     read -r e < "$f" 2>/dev/null || return 1; [ -n "${e:-}" ] || return 1
                     [ "$(date +%s)" -lt "$e" ]; }

# TIER-1.5: FRESH persisted confirmation ([design] 2026-07-03 — BLE phase-alignment lottery:
# the cron fusion catches bursty BLE in-phase and confirms PRESENT+high, but this gate's live
# re-run keeps sampling the out-phase → 4/5 speaks suppressed DURING a confirmed session).
# room-sense emits a timestamped wake-line ONLY on entry into PRESENT+high (non-audio bar) and
# logs every verdict change to the events file. If the last wake-emit was PRESENT+high AND no
# verdict change happened since (session still open) AND the state file is PRESENT with a fresh
# mtime (reflex alive), the confirmed session persists — accept it. The BAR is unchanged: the
# persisted confirmation itself was PRESENT+high non-audio; this only stops re-rolling the
# phase dice mid-session. MISHA_STATE_CONFIRM=0 opts out.
state_confirm_active(){
  [ "${MISHA_STATE_CONFIRM:-1}" = 1 ] || return 1
  local st="$MESH/.room-sense.state" lg="$MESH/room-sense.log" ev="$MESH/.room-sense-events"
  [ -r "$st" ] && [ -r "$lg" ] && [ -r "$ev" ] || return 1
  # state: still PRESENT, written recently (2x the 15-min fusion stride = reflex alive)
  head -1 "$st" 2>/dev/null | grep -q '^PRESENT|' || return 1
  local age=$(( $(date +%s) - $(stat -c %Y "$st" 2>/dev/null || echo 0) ))
  [ "$age" -ge 0 ] && [ "$age" -le "${MISHA_STATE_FRESH:-1800}" ] || return 1
  # last wake-emit: a timestamped PRESENT+high confirmation
  local last ts t0
  last="$(tail -1 "$lg" 2>/dev/null)"
  printf '%s' "$last" | grep -q 'PRESENT' || return 1
  printf '%s' "$last" | grep -q 'confidence=high' || return 1
  ts="$(printf '%s' "$last" | grep -oE '^[0-9][0-9T:Z-]+')"; [ -n "$ts" ] || return 1
  t0="$(date -d "$ts" +%s 2>/dev/null)"; [ -n "${t0:-}" ] || return 1
  # session still open: no verdict change AFTER the confirming run (240s slack covers the
  # same-run gap between the log line's start-TS and the event write; next cron is >=5m away)
  local lastev
  lastev="$(tail -1 "$ev" 2>/dev/null | cut -d'|' -f1)"
  [ -n "$lastev" ] || return 1
  [ "$lastev" -le $(( t0 + 240 )) ] 2>/dev/null || return 1
  return 0
}

# ---- --test: drive the decision fn with synthetic JSON (no sensor run) ----
if [ "${1:-}" = "--test" ]; then
  decide(){  # $1 = JSON → echoes confirmed|no, reason on stderr; exit 0/1
    python3 - "$1" <<'PY'
import json, sys
try: d = json.loads(sys.argv[1])
except Exception: print("no"); sys.stderr.write("bad json\n"); sys.exit(1)
v = d.get("verdict",""); c = d.get("confidence","")
# confirmed iff PRESENT + HIGH (mesh-room-sense: HIGH is reachable ONLY via non-audio signals)
if v == "PRESENT" and c == "high":
    print("yes"); sys.exit(0)
reason = "verdict=%s confidence=%s" % (v, c)
if v != "PRESENT": reason = "not PRESENT (%s)" % v
elif c != "high": reason = "PRESENT but confidence=%s (audio-only can't confirm)" % c
print("no"); sys.stderr.write(reason + "\n"); sys.exit(1)
PY
  }
  fail=0
  chk(){ # $1 name $2 json $3 want(yes|no)
    local out rc; out="$(decide "$2" 2>/dev/null)"; rc=$?
    if [ "$3" = yes ]; then [ "$rc" = 0 ] && [ "$out" = yes ] && echo "  [PASS] $1 → confirmed" || { echo "  [FAIL] $1 → expected confirmed, got rc=$rc out=$out"; fail=1; }
    else [ "$rc" = 1 ] && [ "$out" = no ] && echo "  [PASS] $1 → dormant" || { echo "  [FAIL] $1 → expected dormant, got rc=$rc out=$out"; fail=1; }; fi
  }
  chk "cam motion + HIGH"    '{"verdict":"PRESENT","confidence":"high"}'                   yes
  chk "body CARRIED + HIGH"  '{"verdict":"PRESENT","confidence":"high","reason":"body"}'   yes
  chk "kbd TYPING + HIGH"    '{"verdict":"PRESENT","confidence":"high"}'                   yes
  chk "audio-only MEDIUM"    '{"verdict":"PRESENT","confidence":"medium"}'                 no   # the bar: audio can't confirm
  chk "UNCERTAIN"            '{"verdict":"UNCERTAIN","confidence":"low"}'                  no
  chk "EMPTY"                '{"verdict":"EMPTY","confidence":"high"}'                     no
  chk "PRESENT but low conf" '{"verdict":"PRESENT","confidence":"low"}'                    no
  # TIER-2 face-stamp confirm path (independent of room-sense JSON): active window confirms, lapsed doesn't
  ftmp="$(mktemp -d)"; MESH="$ftmp"
  printf '%s\n' "$(( $(date +%s) + 300 ))" > "$ftmp/misha-face-awake"
  face_stamp_active && echo "  [PASS] face window OPEN → confirmed" || { echo "  [FAIL] open face window should confirm"; fail=1; }
  printf '%s\n' "$(( $(date +%s) - 5 ))" > "$ftmp/misha-face-awake"
  face_stamp_active && { echo "  [FAIL] lapsed face window must not confirm"; fail=1; } || echo "  [PASS] face window lapsed → not confirmed"
  rm -rf "$ftmp"
  # TIER-1.5 persisted-confirmation path: synthetic state+log+events in a temp MESH
  stmp="$(mktemp -d)"; MESH="$stmp"
  _now=$(date +%s); _t0=$(( _now - 600 )); _iso="$(date -u -d "@$_t0" +%Y-%m-%dT%H:%M:%SZ)"
  printf 'PRESENT|dwell_s=600|changes_24h=3\n' > "$stmp/.room-sense.state"
  printf '%s [room-sense] PRESENT status=OCCUPIED occupancy=OCCUPIED confidence=high — named BLE\n' "$_iso" > "$stmp/room-sense.log"
  printf '%s|PRESENT\n' "$_t0" > "$stmp/.room-sense-events"
  state_confirm_active && echo "  [PASS] open confirmed session → confirmed" || { echo "  [FAIL] open confirmed session should confirm"; fail=1; }
  printf '%s|UNCERTAIN\n' "$(( _t0 + 500 ))" >> "$stmp/.room-sense-events"
  state_confirm_active && { echo "  [FAIL] verdict change after confirm must close the session"; fail=1; } || echo "  [PASS] verdict change after confirm → not confirmed"
  printf '%s|PRESENT\n' "$_t0" > "$stmp/.room-sense-events"
  printf 'UNCERTAIN|dwell_s=60|changes_24h=4\n' > "$stmp/.room-sense.state"
  state_confirm_active && { echo "  [FAIL] non-PRESENT state must not confirm"; fail=1; } || echo "  [PASS] state no longer PRESENT → not confirmed"
  printf 'PRESENT|dwell_s=600|changes_24h=3\n' > "$stmp/.room-sense.state"
  touch -d "@$(( _now - 7200 ))" "$stmp/.room-sense.state"
  state_confirm_active && { echo "  [FAIL] stale state mtime (dead reflex) must not confirm"; fail=1; } || echo "  [PASS] stale state mtime → not confirmed"
  touch "$stmp/.room-sense.state"
  MISHA_STATE_CONFIRM=0 state_confirm_active && { echo "  [FAIL] MISHA_STATE_CONFIRM=0 must opt out"; fail=1; } || echo "  [PASS] MISHA_STATE_CONFIRM=0 → opted out"
  sed -i 's/confidence=high/confidence=medium/' "$stmp/room-sense.log"
  state_confirm_active && { echo "  [FAIL] non-high persisted confirm must not pass the bar"; fail=1; } || echo "  [PASS] persisted medium confidence → not confirmed"
  rm -rf "$stmp"
  [ "$fail" = 0 ] && { echo "smoke-test: ok (HIGH+PRESENT, open face-window, or open persisted PRESENT+high session confirms; audio-medium/EMPTY/UNCERTAIN/lapsed-face/closed-session stay dormant)"; exit 0; }
  echo "smoke-test: FAIL"; exit 1
fi

# ---- room-locality hop (2026-07-05) ----
# ALL of this gate's evidence is node-LOCAL (face stamp, persisted-session files, room-sense fusion
# inputs cam-prev/kbd/BLE) — it was built to run ON the room node. But mesh-room say calls it from
# whatever node the mind runs on, so the gate was assessing the CALLER's surroundings: IdeaPad's
# 16h-stale cam-prev read cam-blind while the room's (ds) camera was live-writing frames — three
# ambient replies suppressed in a visibly social room (observed 2026-07-05 09:1x). If we are NOT the
# room node, ask the room node's own gate; ssh failure falls back to the local assessment below
# (degraded but never ungated). MISHA_GATE_HOP=0 opts out (and stops recursion on the remote side).
ROOM_NODE="${ROOM_NODE:-imozerov@100.125.157.75}"
_room_ip="${ROOM_NODE##*@}"
if [ "${MISHA_GATE_HOP:-1}" = 1 ] && ! { tailscale ip -4 2>/dev/null; hostname -I 2>/dev/null | tr ' ' '\n'; } | grep -qx "$_room_ip"; then
  _out="$(timeout 60 ssh -o BatchMode=yes -o ConnectTimeout=5 -o StrictHostKeyChecking=no "$ROOM_NODE" \
      "MISHA_GATE_HOP=0 ~/.local/bin/mesh-misha-gate ${1:-}" 2>&1)"; _rc=$?
  case "$_rc" in
    0) if [ "${1:-}" = "--json" ]; then case "$_out" in '{'*) printf '%s\n' "$_out" ;; *) printf '{"confirmed":true,"verdict":"REMOTE","confidence":"","reason":"room-node gate allowed (non-json note)"}\n' ;; esac; fi; exit 0 ;;
    1) if [ "${1:-}" = "--json" ]; then printf '%s\n' "$_out"; else printf '%s\n' "$_out" >&2; fi; exit 1 ;;
    *) echo "mesh-misha-gate: room node unreachable (rc=$_rc) — falling back to LOCAL assessment" >&2 ;;
  esac
fi

# ---- live assessment ----
# TIER-2 first (cheap): an open face-awake window = the camera saw the operator → confirmed outright,
# skipping the (slower) room-sense fusion. This is how a recognized face WAKES Misha.
if face_stamp_active; then
  [ "${1:-}" = "--json" ] && printf '{"confirmed":true,"verdict":"FACE","confidence":"high","reason":"operator face seen (mesh-misha-wake window)"}\n'
  exit 0
fi

# TIER-1.5: a confirmed PRESENT+high session that is still open (see state_confirm_active).
if state_confirm_active; then
  [ "${1:-}" = "--json" ] && printf '{"confirmed":true,"verdict":"PRESENT","confidence":"high","reason":"persisted confirmation — room-sense PRESENT+high session still open"}\n'
  exit 0
fi

if ! command -v mesh-room-sense >/dev/null 2>&1; then
  echo "mesh-misha-gate: mesh-room-sense unavailable — fail-OPEN (allow) so Misha isn't stranded" >&2
  exit 0
fi
JSON="$(timeout 40 mesh-room-sense --json 2>/dev/null)" || { echo "mesh-misha-gate: room-sense failed — fail-OPEN" >&2; exit 0; }
[ -n "$JSON" ] || { echo "mesh-misha-gate: empty room-sense output — fail-OPEN" >&2; exit 0; }

read -r verdict confidence reason <<EOF
$(python3 -c 'import json,sys; d=json.loads(sys.stdin.read()); print(d.get("verdict",""),d.get("confidence",""),d.get("reason",""))' <<<"$JSON" 2>/dev/null)
EOF

if [ "${1:-}" = "--json" ]; then
  confirmed=$([ "$verdict" = "PRESENT" ] && [ "$confidence" = "high" ] && echo true || echo false)
  printf '{"confirmed":%s,"verdict":"%s","confidence":"%s","reason":"%s"}\n' "$confirmed" "$verdict" "$confidence" "$reason"
fi

if [ "$verdict" = "PRESENT" ] && [ "$confidence" = "high" ]; then
  exit 0
fi
echo "mesh-misha-gate: dormant — verdict=$verdict confidence=$confidence (need PRESENT+high; audio-only can't confirm)" >&2
exit 1
