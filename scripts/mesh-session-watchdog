#!/usr/bin/env bash
# mesh-session-watchdog — watch the hostname-named tmux session for stuck panes and
# dead systemd user services; restart what it can, trace what it can't.
# smoke-test: --test checks tmux session exists + services dir reachable
#
#   mesh-session-watchdog [session] [interval_sec]    continuous loop (supervised default)
#   mesh-session-watchdog --edge|--once [session]      ONE check cycle then exit (the */10 cron backup path)
#   mesh-session-watchdog --test
#
# Runs as a loop (put it in a tmux window or supervise.list).
# systemd user-service checks only fire for units that actually exist on this node.
set -euo pipefail
export PATH="$HOME/.local/bin:$PATH"
# node-local topology (gitignored, bash-source syntax): supplies MESH_HOUSEHOLD_HOSTS — the fleet
# hosts whose liveness follows a HOUSEHOLD DESKTOP being on (e.g. ilya = Rozalia's iMac). Their
# nightly unreachability is the human turning the box off, not a mesh fault (see the HOST-DARK block).
[ -r "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes" 2>/dev/null || true

# canonical wall/auth regex (DRY — knowledge/inter-tool-inconsistency-canonical-definitions-2026-06-14):
# source shared MESH_RL_RE (quota→[mind-limited]) + MESH_AUTH_RE (auth/context→[mind-blocked]),
# inline fallback if not deployed. Replaces this tool's private regexes (which carried 'Esc to cancel'
# — a GATE not a wall, mis-classified as auth — and 'token limit' not in the curated canonical).
[ -r "$HOME/.local/bin/mesh-patterns.sh" ] && . "$HOME/.local/bin/mesh-patterns.sh" 2>/dev/null
: "${MESH_RL_RE:=hit your (usage|session) limit|usage limit reached|rate.?limit|429|too many requests|quota.*(exhaust|exceed)|out of credits|purchase more credits|upgrade to (pro|team)|try again (at|later|in)|resets? (at )?[0-9]|overloaded}"
: "${MESH_AUTH_RE:=login.*required|oauth.*required|please (log|sign) ?in|authentication required|100% context (used|left)|context (full|exhausted)|/login}"
# shared cross-node board-dedup primitive (board_recent_ts_within, mesh-patterns.sh:202), same as
# mesh-criticality/mesh-fawxible-watch. Inline fallback keeps this tool self-contained if
# mesh-patterns.sh wasn't deployed/sourced above.
type board_recent_ts_within >/dev/null 2>&1 || board_recent_ts_within(){
  local board="$1" marker="$2" window="$3" now="${4:-$(date +%s)}"
  [ -r "$board" ] || return 1
  local ts epoch
  ts="$(grep -F -- "$marker" "$board" 2>/dev/null | tail -1 | awk '{print $1}')"
  [ -n "$ts" ] || return 1
  epoch="$(date -u -d "$ts" +%s 2>/dev/null)" || return 1
  [ $(( now - epoch )) -lt "$window" ] || return 1
  printf '%s' "$epoch"
}
# chat-review/patterns-presync-gate-shared(-relanded): board_recent_ts_within above only sees peer
# posts the periodic mesh-chat-sync cron has ALREADY gossiped in — up to ~25min stale — so a peer's
# just-posted fleet-health verdict can be invisible here and two nodes double-post the same tag+host,
# same class of race mesh-mind-control's dispatch() fixed (538b3f1). Pull fresh gossip synchronously
# (rate-limited + hard-timeout) right before trusting the board.
type board_presync >/dev/null 2>&1 || board_presync(){
  local stamp="$1" min_interval="${2:-300}" timeout_s="${3:-25}" cmd="$4"
  [ -n "$cmd" ] || return 0
  local now age
  now=$(date +%s); age=999999
  [ -f "$stamp" ] && age=$(( now - $(stat -c %Y "$stamp" 2>/dev/null || echo 0) ))
  if [ "$age" -ge "$min_interval" ]; then
    timeout "$timeout_s" $cmd >/dev/null 2>&1 || true
    touch "$stamp" 2>/dev/null || true
  fi
}
WD_PRESYNC_STAMP="${MESH_DIR:-$HOME/.mesh}/.session-watchdog-presync"

# fleet-health cross-node dedup (chat-review/watchdog-fleet-dedup-unconfigured): before posting a
# fleet-health verdict, adopt silently if another node already board-posted the identical tag+host
# within $3 (a window sized to this reflex's own cadence, computed at call time below). $4 lets
# --test point at a fixture board instead of the live one. MESH_TEST_SANDBOX=1 always suppresses the
# actual mesh-chat call (mesh-doctor smoke-sweep gate), same convention as mesh-fawxible-watch.
fleet_dedup_post() {  # $1=board tag marker  $2=full message  $3=window_s  $4=board-log-path
  local marker="$1" msg="$2" window="$3" board="$4"
  if [ "${MESH_TEST_SANDBOX:-}" != "1" ]; then
    board_presync "$WD_PRESYNC_STAMP" "${MESH_WD_PRESYNC_MIN:-300}" "${MESH_WD_PRESYNC_TIMEOUT:-25}" "${MESH_WD_PRESYNC_CMD:-mesh-chat-sync}"
  fi
  if [ "${MESH_TEST_SANDBOX:-}" != "1" ] && board_recent_ts_within "$board" "$marker" "$window" "$(date +%s)" >/dev/null 2>&1; then
    command -v trace >/dev/null 2>&1 && trace "HEALTH DEDUP: $marker already board-posted within ${window}s — adopting silently"
    return 0
  fi
  [ "${MESH_TEST_SANDBOX:-}" = "1" ] && return 0
  command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="watchdog@$(hostname)" mesh-chat "$msg" >/dev/null 2>&1
  return 0
}

# Per-mind repost cooldown (chat-review 2026-06-17): the static-flag below re-arms whenever the
# wall scrolls out of the last-6-line window or a transient IDLE cross-check clears it, so a rapid
# clear/re-block flap re-alerted the SAME hours-old wall every 5-20min (watchdog flooded 'dev':
# 16:46/16:55/17:26/17:35). This time guard caps a given mind+kind to ONE board post per
# MESH_WD_REPOST_COOLDOWN (default 1800s) regardless of flag churn — the live block state is still
# visible via mesh-mind-state, so capping the board post loses no signal, only the noise.
WD_COOLDOWN="${MESH_WD_REPOST_COOLDOWN:-1800}"
# DEBOUNCE for the mesh-health internet probe: a SINGLE cycle's [health-fail] is unreliable for SELF —
# at the top-of-hour cron storm (e.g. ~01:00, where hourly+daily+*/N jobs align) the local machine can
# be too load-starved to service ping -c2/curl -m6 within their timeouts, so BOTH probes 'fail' though
# internet is fine → a false self [health-fail] that recovers next cycle (observed daily ~01:00, also
# ds/ilya). A REAL outage persists across cycles. Require N consecutive FAILs before the operator-visible
# board post; a blip that recovers within one INTERVAL never reaches the board (kills the cry-wolf that
# trains minds to ignore [health-fail]). Trace tier still records every cycle.
HEALTH_DEBOUNCE="${MESH_WD_HEALTH_DEBOUNCE:-2}"
# SECOND VANTAGE GUARD (chat-review/offline-flap-no-debounce, 2026-07-05): mesh-health reports on the
# WHOLE fleet, not just self — so a second node running this watchdog (e.g. default-string's new */5
# mesh-session-watchdog --once cron, chat-review/ds-session-watchdog-unscheduled) would independently
# debounce+post the SAME remote node's FAIL/OFFLINE alarms from its own vantage, duplicating every
# fleet health post on the board. Default stays 1 (unchanged behavior); a redundant-vantage cron sets
# MESH_WATCHDOG_FLEET=0 to skip only this fleet-health block (its own local pane/service checks above
# still run). MESH_WATCHDOG_FLEET remains a manual override/escape hatch, but it was never actually
# SET on any node (chat-review/watchdog-fleet-dedup-unconfigured, verified: zero live
# MESH_WATCHDOG_FLEET hits across IdeaPad/ds/phaedra), so two watchdogs independently posted the
# SAME '[health-fail] ilya' 9min apart (chat.log 2026-07-08T16:01:49Z/16:10:41Z). fleet_dedup_post()
# below adds the LIVE mechanism the env var was supposed to be a stand-in for: before posting a
# fleet-health verdict, check the board for an identical tag+host post from ANY vantage within a
# window sized to this reflex's own cadence — adopt silently instead of reposting.
WATCHDOG_FLEET="${MESH_WATCHDOG_FLEET:-1}"
wd_should_post() {  # $1=window name  $2=kind(blocked|limited) → exit 0 = post, 1 = suppress
  local d="${MESH_DIR:-$HOME/.mesh}" now last ts
  ts="$d/.wd-postts-$2-$1"
  now=$(date +%s 2>/dev/null || echo 0)
  if [ -f "$ts" ]; then
    last=$(cat "$ts" 2>/dev/null || echo 0)
    if [ $(( now - ${last:-0} )) -lt "$WD_COOLDOWN" ]; then return 1; fi
  fi
  printf '%s\n' "$now" > "$ts" 2>/dev/null || true
  return 0
}

# quota_wave_active — is channel-keepalive's consolidated quota-wave suppression currently armed?
# (chat-review/quota-wave-watchdog-gap): during a wave, mesh-channel-keepalive suppresses its
# per-mind [mind-paused] posts for WAVE_COOLDOWN and posts ONE [quota-wave] summary instead — but
# THIS watchdog's independent pane-read still fires [mind-limited] for the same rate-limit event,
# so a single quota wave hits the board twice. Gate our [mind-limited] on the SAME mark the
# keepalive writes. CONTRACT (must match mesh-channel-keepalive's WAVE_COOLDOWN_MARK): the file
# $HOME/.mesh/.keepalive-wave-cooldown holds an epoch ts; the wave is active iff it exists AND its
# content is in the future. (MESH_DIR override is test-only; live both tools resolve $HOME/.mesh.)
# exit 0 = wave active (suppress our post), 1 = no wave (post normally).
quota_wave_active() {
  local d="${MESH_DIR:-$HOME/.mesh}" mark now
  mark="$d/.keepalive-wave-cooldown"
  now=$(date +%s 2>/dev/null || echo 0)
  [ -f "$mark" ] && [ "$(cat "$mark" 2>/dev/null || echo 0)" -gt "$now" ] 2>/dev/null
}

# fleet-stale re-warn (chat-review/watchdog-hollow-recovery, part 2): a peer stuck LAN-only
# (tailscale-unreachable while its box still answers a node-local LAN ping) posts [health-partial]
# ONCE then holds silent — the GL-MT3000 router sat online:False 16 DAYS unnoticed this way. This
# re-warns every MESH_FLEET_STALE_S while the hollow split persists, keyed on DURATION-in-partial as
# the robust proxy for "tailscale lastSeen exceeds ~2x expected heartbeat while LAN shows alive".
# Sentinel holds "<degraded-since-epoch> <last-warn-epoch>"; cleared by fleet_stale_clear on recovery.
FLEET_STALE_S="${MESH_FLEET_STALE_S:-86400}"     # 24h default — far beyond any normal heartbeat
fleet_stale_should_warn() {  # $1=host → rc 0 = warn (echo age in whole hours), rc 1 = silent
  local host="$1" d="${MESH_DIR:-$HOME/.mesh}" f now since lastwarn age win
  win="${MESH_FLEET_STALE_S:-$FLEET_STALE_S}"     # re-read the env each call (testable override)
  f="$d/.fleet-stale-$host"
  now=$(date +%s 2>/dev/null || echo 0)
  since=""; lastwarn=""
  [ -f "$f" ] && read -r since lastwarn < "$f" 2>/dev/null
  [ -n "$since" ] || since="$now"
  [ -n "$lastwarn" ] || lastwarn=0
  age=$(( now - since ))
  if [ "$age" -ge "$win" ] && [ $(( now - lastwarn )) -ge "$win" ]; then
    printf '%s %s\n' "$since" "$now" > "$f" 2>/dev/null || true
    echo $(( age / 3600 )); return 0
  fi
  printf '%s %s\n' "$since" "$lastwarn" > "$f" 2>/dev/null || true   # stamp `since` on first degraded sight
  return 1
}
fleet_stale_clear() { rm -f "${MESH_DIR:-$HOME/.mesh}/.fleet-stale-$1" 2>/dev/null || true; }

# HOST-DARK expected-down (chat-review/expected-down-host-asleep 2026-07-06): some fleet nodes are
# HOSTED ON A HOUSEHOLD DESKTOP (ilya = Rozalia's iMac) — their nightly unreachability is the human
# turning the machine off, NOT a mesh/tailscaled fault. A [health-fail] labelled 'tailscaled down' for
# these nodes at night is a CRY-WOLF (×2 sources when a second watchdog vantage double-posts the SAME
# sleep — tonight ilya alarmed 4× across IdeaPad+phaedra). For a household-hosted host that is
# UNREACHABLE (FAIL/OFFLINE/SKIP) WHILE this node's home-state is DARK (ASLEEP/QUIET_NIGHT), post
# [expected-down] ONCE per episode (label HOST-DARK, not tailscaled-down), trace-only after, and
# cross-watchdog dedupe (suppress if a peer already boarded a health/expected line for the host inside
# the dedup window). The HONEST EDGE the task named: a failure DURING household-awake hours (home-state
# not dark) OR a partial LAN-only result still routes to the full health_step alarm below — this only
# reclassifies the expected nightly-dark case, never a real daytime outage.
MESH_HOUSEHOLD_HOSTS="${MESH_HOUSEHOLD_HOSTS:-}"                 # space/comma list; from node-local ~/.mesh/nodes
MESH_HOUSEHOLD_DARK_RE="${MESH_HOUSEHOLD_DARK_RE:-ASLEEP|QUIET_NIGHT}"   # mesh-home-state sleep tokens
MESH_EXPECTED_DOWN_DEDUP_S="${MESH_EXPECTED_DOWN_DEDUP_S:-1800}"          # cross-watchdog board-dedupe window
MESH_HH_WAKE_DEBOUNCE="${MESH_HH_WAKE_DEBOUNCE:-2}"                       # consecutive non-dark cycles a STILL-unreachable expected-down episode must see before re-classifying as an awake failure (hysteresis vs single-cycle home-state UNCERTAIN flap)
host_is_household() {  # $1=host → 0 if the host is in MESH_HOUSEHOLD_HOSTS (empty list matches nothing)
  local h="$1" x; for x in ${MESH_HOUSEHOLD_HOSTS//,/ }; do [ "$x" = "$h" ] && return 0; done; return 1;
}
household_token_is_dark() {  # $1=home-state top token → 0 if it is a sleep/dark token (empty = NOT dark)
  [ -n "$1" ] && printf '%s' "$1" | grep -qE "^(${MESH_HOUSEHOLD_DARK_RE})\$";
}
is_unreachable_result() {  # $1=mesh-health result → 0 for the hard-unreachable set (LAN=partial excluded)
  case "$1" in FAIL|OFFLINE|SKIP) return 0 ;; *) return 1 ;; esac;
}
peer_boarded_recently() {  # $1=host $2=window_s → 0 if a health/expected board line for host is < window old
  local host="$1" win="$2" log="${MESH_DIR:-$HOME/.mesh}/chat.log" line ts now age
  [ -r "$log" ] || return 1
  now=$(date +%s 2>/dev/null || echo 0)
  line=$(grep -E "\[(health-fail|health-ok|health-partial|expected-down)\] +${host}([[:space:]]|\$)" "$log" 2>/dev/null | tail -1) || true
  [ -n "$line" ] || return 1
  ts=${line%%  *}                                   # leading ISO8601 (board fields are 2-space separated)
  ts=$(date -d "$ts" +%s 2>/dev/null) || return 1
  [ -n "$ts" ] || return 1
  age=$(( now - ts ))
  [ "$age" -ge 0 ] && [ "$age" -lt "$win" ]
}
expected_down_plan() {  # $1=host → echoes post|quiet-episode|quiet-dedup; manages the per-episode sentinel
  local host="$1" d="${MESH_DIR:-$HOME/.mesh}" f now
  f="$d/.expected-down-$host"; now=$(date +%s 2>/dev/null || echo 0)
  if [ -f "$f" ]; then echo quiet-episode; return 0; fi           # episode already announced → trace-only
  if peer_boarded_recently "$host" "$MESH_EXPECTED_DOWN_DEDUP_S"; then
    printf '%s\n' "$now" > "$f" 2>/dev/null || true; echo quiet-dedup; return 0   # own the episode, stay silent
  fi
  printf '%s\n' "$now" > "$f" 2>/dev/null || true; echo post
}
expected_down_clear() { rm -f "${MESH_DIR:-$HOME/.mesh}/.expected-down-$1" "${MESH_DIR:-$HOME/.mesh}/.expected-down-wake-$1" 2>/dev/null || true; }
expected_down_wake_reset() { rm -f "${MESH_DIR:-$HOME/.mesh}/.expected-down-wake-$1" 2>/dev/null || true; }  # a dark cycle breaks the wake streak
expected_down_wake_step() {  # $1=host → echoes hold|clear. Called ONLY when an episode sentinel exists, the
  # host is STILL unreachable, and home-state read non-dark THIS cycle. A SINGLE non-dark cycle is a
  # home-state UNCERTAIN flap (chat-review/watchdog-expected-down-survives-homestate-flap) — hold the episode
  # (trace-only, no alarm) until non-dark sustains MESH_HH_WAKE_DEBOUNCE cycles = a genuine wake worth alarming.
  local host="$1" d="${MESH_DIR:-$HOME/.mesh}" wf n
  wf="$d/.expected-down-wake-$host"
  n=$(cat "$wf" 2>/dev/null || echo 0); case "$n" in ''|*[!0-9]*) n=0 ;; esac
  n=$((n+1))
  if [ "$n" -ge "$MESH_HH_WAKE_DEBOUNCE" ]; then rm -f "$wf" 2>/dev/null || true; echo clear; return 0; fi
  printf '%s\n' "$n" > "$wf" 2>/dev/null || true; echo hold
}


# ============================== DECLARED-SLEEPY BODIES =========================================
# (board task watchdog-has-no-state-for-a-body-that-is-DESIGNED-to-sleep {#a63f7382}, 2026-08-24.)
# MEASURED on the live board 2026-08-20T12:35Z..2026-08-22T14:40Z: 32 '[health-fail] Redmi' and 29
# RECOVERED, median fail→recovery 11.6 min (n=27, min 9.9, max 174.8) — a fault that resolves itself
# in twelve minutes, thirty-two times in fifty hours, on a phone. THE SAME DEVICE READ BY THE OTHER
# OBSERVER IS NOT A FAULT: mesh-access-probe posted phone=BLIND 18x against phone=OK 9 the same day
# and alarmed ZERO times, because its vocabulary has a THIRD state ("BLIND — couldn't attempt, a
# phone is expected-asleep", mesh-access-probe:19). This tool had only FAIL and OK, so the same sleep
# was an incident.
#
# THE AXIS, and why the four existing guards all miss it. HEALTH_DEBOUNCE keys on DURATION,
# posted-as-a-TAG on OSCILLATION, fleet_dedup_post on DUPLICATION, chronic_offtailnet_plan on
# ABSENCE AGE. Not one can express "this device is SUPPOSED to be unreachable right now". The
# chronic guard is the closest fit and is proven live AND proven inapplicable in the same breath:
# .chronic-offtailnet-GL-MT3000 exists on disk (armed, for the router) and there is no Redmi
# sentinel, because Redmi's tailnet last-seen is FRESH. The phone stopped being chronically ABSENT
# and became PRESENT-BUT-ASLEEP. So this is a VOCABULARY change, not a fifth counter: a fleet member
# DECLARES an expected-asleep discipline, and for such a host an unreachable cycle boards as
# [expected-down] (label HOST-ASLEEP) — the verb this tool already owns for a host deliberately off.
#
# THE DECLARATION BUYS A DIFFERENT TAG, NEVER SILENCE. A declared-sleepy host that is unreachable far
# past its OWN longest observed sleep is a real fault and boards LOUD. The bound is NOT a fifth
# constant: it is derived from that host's own recorded episodes (max × slack), and the reading
# PUBLISHES WHICH SOURCE it came from — `measured` (n≥MESH_WD_SLEEPY_MIN_N closed episodes) or the
# declared `cold` floor before then — so a bound nobody has calibrated can never wear the authority
# of one that has (CLAUDE.md, calibrate-a-derived-axis-against-the-live-corpus).
#
# AND THE LEDGER MUST NOT LEARN FROM THE FAULT. Only an episode that ended in RECOVERY, and was never
# flagged overdue, is recorded as a sleep sample. Recording an overdue episode would teach the
# detector to raise its own ceiling every time it fires, until the alarm can never fire again — the
# self-erasing shape this doctrine refuses everywhere (a-detector-floor-equal-to-its-own-ceiling).
MESH_WD_SLEEPY_HOSTS="${MESH_WD_SLEEPY_HOSTS:-}"          # space/comma list; from node-local ~/.mesh/nodes
MESH_WD_SLEEPY_MIN_N="${MESH_WD_SLEEPY_MIN_N:-3}"         # closed episodes before the bound is 'measured'
MESH_WD_SLEEPY_SLACK="${MESH_WD_SLEEPY_SLACK:-2}"         # bound = longest observed sleep x this
MESH_WD_SLEEPY_COLD_MIN="${MESH_WD_SLEEPY_COLD_MIN:-360}" # declared cold-start floor (min) before n>=MIN_N
MESH_WD_SLEEPY_KEEP="${MESH_WD_SLEEPY_KEEP:-50}"          # episode-log ring size

host_is_sleepy() {  # $1=host → 0 if declared in MESH_WD_SLEEPY_HOSTS (empty list matches nothing)
  local h="$1" x; for x in ${MESH_WD_SLEEPY_HOSTS//,/ }; do [ "$x" = "$h" ] && return 0; done; return 1;
}
sleepy_bound_min() {  # $1=host → "<bound_minutes> <source: measured|cold> <n>"
  local host="$1" d f n mx
  d="${MESH_DIR:-$HOME/.mesh}"; f="$d/.sleepy-episodes-$host"
  n=0; mx=0
  if [ -r "$f" ]; then
    n=$(grep -cE '^[0-9]+$' "$f" 2>/dev/null || echo 0)
    mx=$(grep -E '^[0-9]+$' "$f" 2>/dev/null | sort -n | tail -1); [ -n "$mx" ] || mx=0
  fi
  case "$n" in ''|*[!0-9]*) n=0 ;; esac
  if [ "$n" -ge "$MESH_WD_SLEEPY_MIN_N" ] && [ "$mx" -gt 0 ]; then
    echo "$((mx * MESH_WD_SLEEPY_SLACK)) measured $n"
  else
    echo "$MESH_WD_SLEEPY_COLD_MIN cold $n"
  fi
}
sleepy_elapsed_min() {  # $1=host → minutes since the episode sentinel was stamped, or '' if no episode
  local host="$1" d f t now
  d="${MESH_DIR:-$HOME/.mesh}"; f="$d/.expected-down-$host"
  [ -r "$f" ] || return 1
  t=$(head -1 "$f" 2>/dev/null); case "$t" in ''|*[!0-9]*) return 1 ;; esac
  now=$(date +%s 2>/dev/null || echo 0)
  [ "$now" -ge "$t" ] || return 1
  echo $(( (now - t) / 60 ))
}
# ---------------------------- L3 EVIDENCE: the exemption must PLACE ITS SUBJECT IN THE WINDOW ----
# (board task sleepy-exemption-records-ssh-flap-gaps-as-sleep-samples {#a211d449}, 2026-08-24.)
# The declaration above was pure MEMBERSHIP — host_is_sleepy is a list lookup, and nothing in the
# cycle measured whether the body was actually asleep. Worse, it was armed by is_unreachable_result,
# whose SKIP arm is DEFINED (mesh-health:217) as "SSH unreachable" on a peer tailscale still reports
# Online: the token that granted the exemption carried the refuting evidence inside its own meaning.
# MEASURED 2026-08-24T23:2xZ, the fault live: Redmi answered ICMP 0% loss on BOTH paths (LAN
# 192.168.8.203, TS 100.103.99.16), ARP REACHABLE, tailnet Online=true with rx/tx climbing, battery
# DISCHARGING 68->62% — and 8022 gave CONNECTION REFUSED on both. A RST comes from a live IP stack;
# a sleeping host TIMES OUT. The board said HOST-ASLEEP anyway, and .sleepy-episodes-Redmi
# (10 10 51 10 20 51) was a record of Termux-sshd flap gaps wearing the word "measured".
#
# So the sleep word is now gated on evidence INDEPENDENT of the failing transport, and the gate is
# POSITIVE: only a measured DARK verdict buys the exemption. An ALIVE body (the transport is what is
# broken) and an UNMEASURABLE one both fall through to the ordinary alarm path — the failure
# direction is LOUD, which is the only safe direction for a word that means "do not alarm".
#
# THE RST/TIMEOUT DISCRIMINATION IS THE POINT AND IT IS NOT rc-VISIBLE. bash's /dev/tcp returns 1
# for "Connection refused", "Network is unreachable" and "No route to host" alike; only the errno
# RENDERING separates them, so the probe reads the message under LC_ALL=C and counts ONLY a refusal
# as alive. Treating every rc=1 as a refusal would have called an unroutable address a live stack.
#
# PER-PATH, NEVER ONE PATH (~/.mesh/nodes:7, measured 2026-08-24T19:36Z): LAN 8022 timed out 3/3
# while TS 8022 answered 3/3 in the same minute. One dead path is not a dead body, so every candidate
# address is probed and ANY alive term wins.
#
# AND THE PROBE CAN SHARE THE FAULT (memory a-shared-failure-mode-lets-a-probe-blame-the-far-end).
# This node's sole uplink is a dongle that wedges; with our own L3 down every far end reads dark and
# the exemption would go maximally quiet exactly when the fleet is maximally broken. So a DARK
# verdict requires a COVERAGE term — mesh-health's own self line PASSing this same cycle — and
# without it dark is downgraded to unknown (loud), never granted.
MESH_WD_SLEEPY_L3_TIMEOUT="${MESH_WD_SLEEPY_L3_TIMEOUT:-3}"   # seconds per ICMP / TCP probe
MESH_WD_SLEEPY_MAX_ADDRS="${MESH_WD_SLEEPY_MAX_ADDRS:-4}"     # cap the per-cycle probe cost
MESH_WD_SLEEPY_SSH_PORT="${MESH_WD_SLEEPY_SSH_PORT:-22}"      # non-android default; android uses PHONE_SSH_PORT

sleepy_addrs() {  # $1=host $2=the whole mesh-health line → candidate addresses, one per line, deduped
  # Sources, all of them ALREADY LIVE config — no second copy of the topology to rot:
  #   (1) every IPv4 the health line itself named — the address the failing probe actually used;
  #   (2) MESH_LAN_FALLBACK's host-keyed LAN paths (mesh-health:165 reads the same variable);
  #   (3) PHONE_LAN_IPS when the line declares an (android) body — the same CLASS predicate
  #       mesh-health:243 uses, not a hostname, so a renamed phone keeps its LAN candidates.
  local host="$1" line="$2" a seen=""
  { printf '%s\n' "$line" | grep -oE '(^|[^0-9.])([0-9]{1,3}\.){3}[0-9]{1,3}([^0-9.]|$)' \
      | grep -oE '([0-9]{1,3}\.){3}[0-9]{1,3}'
    for a in ${MESH_LAN_FALLBACK:-}; do [ "${a%%:*}" = "$host" ] && printf '%s\n' "${a#*:}"; done
    case "$line" in *'(android)'*) printf '%s\n' ${PHONE_LAN_IPS:-} ;; esac
  } 2>/dev/null | while read -r a; do
      [ -n "$a" ] || continue
      case " $seen " in *" $a "*) continue ;; esac
      seen="$seen $a"; printf '%s\n' "$a"
    done | head -n "$MESH_WD_SLEEPY_MAX_ADDRS"
}

sleepy_ssh_port() {  # $1=the mesh-health line → the port whose RST/timeout separates body from daemon
  case "$1" in *'(android)'*) printf '%s\n' "${PHONE_SSH_PORT:-8022}" ;;
               *) printf '%s\n' "$MESH_WD_SLEEPY_SSH_PORT" ;; esac
}

sleepy_tcp_probe() {  # $1=addr $2=port → open|refused|timeout|unreach|error  (see the LC_ALL note above)
  local out rc
  out=$(LC_ALL=C timeout "$MESH_WD_SLEEPY_L3_TIMEOUT" bash -c "exec 3<>/dev/tcp/$1/$2" 2>&1); rc=$?
  case "$rc" in
    0)   printf 'open\n' ;;
    124) printf 'timeout\n' ;;
    *)   case "$out" in
           *"Connection refused"*)                    printf 'refused\n' ;;
           *unreachable*|*"No route to host"*)        printf 'unreach\n' ;;
           *)                                         printf 'error\n' ;;
         esac ;;
  esac
}

sleepy_arp_state() {  # $1=addr → the kernel's neighbour state, or '' — a SUPPORTING term only
  # ~/.mesh/nodes:7 and memory redmi-sshd-flaps-so-a-probe-is-a-sample name this discriminator:
  # ARP INCOMPLETE = off the LAN (asleep), ARP resolved = the body is on the wire. Only REACHABLE
  # counts as alive here: STALE outlives the device that earned it, so it is reported, never trusted.
  ip neigh show "$1" 2>/dev/null | awk 'NR==1{print $NF}'
}

sleepy_l3_verdict() {  # $1=host $2=coverage(ok|na) $3=port, rest = candidate addrs
  #   → "<alive|dark|unknown> <evidence detail>"
  # ALIVE terms (any one wins, and the probe short-circuits): an ICMP reply, a TCP RST on the ssh
  # port, an open ssh port, ARP REACHABLE. DARK terms: a TCP timeout or unreachable, or a ping that
  # ran and got no answer. Anything else (no candidates, a probe that errored) is UNKNOWN — a
  # blindness sentinel, never fused as a reading.
  local host="$1" cov="$2" port="$3"; shift 3
  local a t st dark="" unk="" det=""
  [ $# -gt 0 ] || { printf 'unknown no-candidate-address\n'; return 0; }
  for a in "$@"; do
    if ping -c 1 -W "$MESH_WD_SLEEPY_L3_TIMEOUT" "$a" >/dev/null 2>&1; then
      printf 'alive icmp-reply:%s%s\n' "$a" "$det"; return 0
    else
      case "$?" in 1) dark=1; det="$det icmp-noreply:$a" ;; *) unk=1; det="$det icmp-error:$a" ;; esac
    fi
    t="$(sleepy_tcp_probe "$a" "$port")"
    case "$t" in
      open|refused) printf 'alive tcp-%s:%s:%s%s\n' "$t" "$a" "$port" "$det"; return 0 ;;
      timeout|unreach) dark=1; det="$det tcp-$t:$a:$port" ;;
      *) unk=1; det="$det tcp-error:$a:$port" ;;
    esac
    st="$(sleepy_arp_state "$a")"
    case "$st" in
      REACHABLE) printf 'alive arp-REACHABLE:%s%s\n' "$a" "$det"; return 0 ;;
      "") : ;;
      *) det="$det arp-$st:$a" ;;
    esac
  done
  if [ -n "$dark" ]; then
    # COVERAGE: a dark reading from a node whose own L3 is not demonstrably working is our fault
    # wearing the far end's name. Downgrade to unknown — which is LOUD — rather than grant silence.
    [ "$cov" = ok ] && { printf 'dark cov=ok%s\n' "$det"; return 0; }
    printf 'unknown cov=%s-so-dark-is-unattributable%s\n' "$cov" "$det"; return 0
  fi
  printf 'unknown%s\n' "${det:- no-conclusive-term}"
}

sleepy_notsleep_mark()   { printf '%s\n' "${2:-unknown}" > "${MESH_DIR:-$HOME/.mesh}/.sleepy-notsleep-$1" 2>/dev/null || true; }
sleepy_notsleep_reason() { head -1 "${MESH_DIR:-$HOME/.mesh}/.sleepy-notsleep-$1" 2>/dev/null || true; }
sleepy_notsleep_clear()  { rm -f "${MESH_DIR:-$HOME/.mesh}/.sleepy-notsleep-$1" 2>/dev/null || true; }

sleepy_overdue_mark()  { : > "${MESH_DIR:-$HOME/.mesh}/.sleepy-overdue-$1" 2>/dev/null || true; }
sleepy_is_overdue()    { [ -f "${MESH_DIR:-$HOME/.mesh}/.sleepy-overdue-$1" ]; }
sleepy_episode_close() {  # $1=host — called on a REACHABLE result. Records the episode as a sleep
  # SAMPLE only if it was never flagged overdue: an overdue episode is a FAULT, and letting a fault
  # widen the bound that detects it is how a detector erases its own signal.
  local host="$1" d el rs
  d="${MESH_DIR:-$HOME/.mesh}"
  # ALWAYS rc=0. This runs unconditionally for EVERY host on EVERY cycle, inside a `while read`
  # loop under `set -e` — a non-zero "there was no episode" return killed the whole fleet pass
  # before a single host was classified (caught by the end-to-end arm below, which is the reason
  # it is end-to-end and not a predicate agreeing with itself). The outcome is the ECHO, never rc.
  [ -f "$d/.expected-down-$host" ] || { rm -f "$d/.sleepy-overdue-$host" "$d/.sleepy-notsleep-$host" 2>/dev/null; echo none; return 0; }
  el="$(sleepy_elapsed_min "$host" || true)"
  if sleepy_is_overdue "$host"; then
    rm -f "$d/.sleepy-overdue-$host" "$d/.sleepy-notsleep-$host" 2>/dev/null || true
    echo "discarded ${el:-na}"; return 0
  fi
  # AND THE LEDGER MUST NOT LEARN FROM A MISCLASSIFICATION EITHER. The doctrine block above guarded
  # only the OVERDUE entrance; the misclassified-but-RECOVERED entrance was wide open, and it is the
  # one the live fault walked through 6 times in 3h. Any cycle of this episode that measured the
  # subject L3-ALIVE (or could not measure it at all) leaves this mark, and a marked episode is a
  # transport gap, not a sleep sample: DISCARD it. Deliberately stricter than "alive throughout" —
  # one alive observation is enough to disqualify the whole episode as a clean sleep.
  if [ -n "$(sleepy_notsleep_reason "$host")" ]; then
    rs="$(sleepy_notsleep_reason "$host")"
    sleepy_notsleep_clear "$host"
    echo "discarded-notsleep ${el:-na} $rs"; return 0
  fi
  if [ -n "$el" ]; then
    printf '%s\n' "$el" >> "$d/.sleepy-episodes-$host" 2>/dev/null || true
    tail -n "$MESH_WD_SLEEPY_KEEP" "$d/.sleepy-episodes-$host" > "$d/.sleepy-episodes-$host.tmp" 2>/dev/null \
      && mv -f "$d/.sleepy-episodes-$host.tmp" "$d/.sleepy-episodes-$host" 2>/dev/null || true
  fi
  echo "recorded ${el:-na}"
}

# CHRONIC OFF-TAILNET flap gate (chat-review/watchdog-chronic-offtailnet-peer-flap, 2026-07-18): a peer gone
# from the tailnet for WEEKS (GL-MT3000 last-seen 28d, Redmi 21d) that oscillates OFFLINE<->LAN re-boards a
# [health-fail]/[health-partial] on EVERY edge — Redmi flapped OFFLINE→LAN→OFFLINE→LAN 4x in 1.5h while self
# was HEALTHY. health_step's posted-TAG guard only dedups within ONE sustained tag; a 2-state oscillation
# defeats it, FLEET_DEDUP_WINDOW dedups within one tag, and fleet_stale throttles one SUSTAINED state —
# none gates on the tailnet last-seen age mesh-health:47 already emits. A 3-week-absent LAN-flaky device is
# a known-absent STABLE condition, not an administrable incident → the same cry-wolf class the HOST-DARK
# post-once pattern (expected_down_plan) already solves. Board the alarm ONCE per chronic episode, trace-tier
# every edge after, re-arm to board only when last-seen resets fresh (< threshold or back on tailnet). PURE +
# falsifiable — --test drives it below with a temp MESH_DIR.
MESH_WD_CHRONIC_DAYS="${MESH_WD_CHRONIC_DAYS:-7}"   # tailnet last-seen age (days) past which a flapping off-tailnet peer is chronic-absent, not an incident
chronic_lastseen_days() {  # $1=mesh-health rest field → echoes the measured whole-DAY last-seen age, or '' if not day-scale (h/m/never/on-tailnet). Only the d-form is chronic; anything seen <1d ago is fresh by construction.
    printf '%s' "$1" | sed -nE 's/.*last-seen ([0-9]+)d ago.*/\1/p'
}
chronic_offtailnet_plan() {  # $1=host $2=lastseen_days('' = not day-scale) $3=chronic_threshold_days → echoes board|quiet; manages the per-host episode sentinel
    local host="$1" days="$2" thr="$3" d f
    d="${MESH_DIR:-$HOME/.mesh}"; f="$d/.chronic-offtailnet-$host"
    # Not chronic (fresh/recent/on-tailnet/unknown age) → RE-ARM: clear the episode, board normally.
    if [ -z "$days" ] || [ "$days" -lt "$thr" ] 2>/dev/null; then rm -f "$f" 2>/dev/null; echo board; return 0; fi
    # Chronic: board the FIRST edge of the episode, trace-tier every edge after until last-seen resets fresh.
    if [ -f "$f" ]; then echo quiet; return 0; fi
    : > "$f" 2>/dev/null || true; echo board
}
chronic_offtailnet_clear() { rm -f "${MESH_DIR:-$HOME/.mesh}/.chronic-offtailnet-$1" 2>/dev/null || true; }

# health_step <prev-state> <result FAIL|PASS|OFFLINE> <debounce> -> "<new-state> <action>"  (PURE —
# dry-runnable, the reason the debounce can be --test'd without a live mesh-health run). state =
# "FAIL:<count>:<posted>" | "OFF:<count>:<posted>" | "PART:<count>:<posted>" ; legacy bare
# "FAIL"/"PASS" migrate. action: postfail | postoffline | postok | postpartial | silent. OFFLINE
# (mesh-health:164 — tailscaled down AND no LAN fallback) is a WORSE, hard-unreachable condition
# than FAIL (reachable, no-internet).
# POSTED IS A TAG, NOT A BOOLEAN (chat-review/watchdog-partial-realarms-on-every-offline-blip,
# 2026-07-16): three board tags ([health-fail] f, [health-partial] p, the offline-flavoured
# [health-fail] o) shared ONE bit, and the OFFLINE branch had no PART:* arm — so a posted PART:n:1
# fell to the clean/PASS catch-all and LOST the bit. One OFFLINE blip re-armed the alarm and the
# UNCHANGED LAN-only condition re-posted [health-partial] two cycles later, forever: the board
# carried 16 GL-MT3000 + 14 Redmi [health-partial] and ZERO [health-ok] for either since
# 07-14T22:29, while both nodes just sat steadily LAN-only. The bit could not be repaired by
# either one-liner — carrying it as a boolean makes the OFF branch's `posted != 1` guard true
# forever, so a SUSTAINED OFFLINE never escalates; posting instantly on the transition costs TWO
# board posts per one-cycle blip (offline out, partial back). With `posted` naming WHICH tag the
# board already carries, every branch's post gate is the same honest question — "is the board
# already saying this?" (`posted != <my tag>`) — and a state change that the board already
# describes stays silent no matter how the state churns.
# DEBOUNCE PARITY (chat-review/offline-flap-no-debounce, 2026-07-05): OFFLINE used to post
# IMMEDIATELY on ANY fresh entry, with no counter — unlike FAIL/SKIP's cnt>=deb machinery above.
# A node with routine tailscaled/sshd flaps (the Redmi phone body — CLAUDE.local.md: "sshd is
# non-durable... Android re-kills it") flickers clean→OFFLINE→clean rapidly, and each flicker
# posted its own [health-fail]+[health-ok] pair (4 pairs in one window, one 79s apart) — the exact
# cry-wolf class HEALTH_DEBOUNCE already exists to prevent for FAIL/SKIP. Fresh OFFLINE entry now
# debounces identically (silent until cnt>=deb, then postoffline once). The one case that still
# posts INSTANTLY, unchanged: escalating from an ALREADY-POSTED FAIL/legacy-FAIL alarm — the board
# already knows this node is degraded, so telling it the state got WORSE is not cry-wolf, it's a
# real escalation the operator should not wait a debounce window to hear.
health_step() {
  local prev="$1" result="$2" deb="$3" kind cnt posted act
  # --- parse prev into kind / count / posted-TAG (0 = the board carries no alarm for this host) ---
  case "$prev" in
    FAIL:*|OFF:*|PART:*) kind=${prev%%:*}; cnt=${prev#*:}; posted=${cnt#*:}; cnt=${cnt%%:*} ;;
    FAIL)                kind=FAIL; cnt=$deb; posted=1 ;;   # legacy: old logic already posted on cycle 1
    *)                   kind=PASS; cnt=0; posted=0 ;;      # incl. PASS / EXPDOWN / empty
  esac
  # legacy boolean posted (":1", written by every version before the tag): it means "the alarm for
  # THIS state's kind is on the board" — migrate it to that kind's tag so an on-disk PART:8:1 is read
  # as a posted PARTIAL, not as a posted anything-else.
  if [ "$posted" = 1 ]; then
    case "$kind" in FAIL) posted=f ;; OFF) posted=o ;; PART) posted=p ;; *) posted=0 ;; esac
  fi
  case "$posted" in f|o|p) ;; *) posted=0 ;; esac
  case "$cnt" in ''|*[!0-9]*) cnt=0 ;; esac

  if [ "$result" = OFFLINE ]; then
    if [ "$kind" != OFF ]; then
      # The board already carries a no-internet alarm for a node we can still reach; telling it the
      # node went hard-unreachable is a real escalation, not cry-wolf → instant, no debounce wait.
      if [ "$kind" = FAIL ] && [ "$posted" = f ]; then echo "OFF:1:o postoffline"; return; fi
      cnt=0                     # every other prior state → fresh OFFLINE debounce, posted TAG carried
    fi
    cnt=$((cnt+1)); act=silent
    if [ "$cnt" -ge "$deb" ] && [ "$posted" != o ]; then act=postoffline; posted=o; fi
    echo "OFF:$cnt:$posted $act"
  elif [ "$result" = LAN ]; then
    # PARTIAL (chat-review/watchdog-hollow-recovery): the box answers a node-local LAN ping but
    # tailscaled is DOWN, so the tailnet-SSH admin path is LOST — a DEGRADED state, NOT a clean
    # recovery. LAN used to fall through to the PASS branch below and post [health-ok] RECOVERED,
    # masking that the node is pingable-but-unadministrable. Now it's a sticky PART state: it
    # surfaces once (debounced) and holds until a TRUE PASS clears it.
    if [ "$kind" != PART ]; then
      # A live fail/offline alarm must transition to [health-partial] at once — the node is NOT
      # recovered. A carried 'p' is the blip case (the board ALREADY says partial and the LAN-only
      # condition never changed): re-posting it is the churn this branch is here to prevent.
      if [ "$posted" = f ] || [ "$posted" = o ]; then echo "PART:1:p postpartial"; return; fi
      cnt=0
    fi
    cnt=$((cnt+1)); act=silent
    if [ "$cnt" -ge "$deb" ] && [ "$posted" != p ]; then act=postpartial; posted=p; fi
    echo "PART:$cnt:$posted $act"
  elif [ "$result" = FAIL ] || [ "$result" = SKIP ]; then
    # SKIP (ssh-unreachable while tailscale still reports Online) shares FAIL's debounce/state
    # machine (chat-review/watchdog-skip-never-alerts 2026-07-04): a short SSH blip still recovers
    # silently, but a SUSTAINED SKIP (real outage, tailscale hasn't flipped Online false yet) now
    # posts after N consecutive cycles instead of never surfacing at all.
    [ "$kind" = FAIL ] || cnt=0   # incl. OFF:*/PART:* → re-debounce (node reachable again, still no net)
    cnt=$((cnt+1)); act=silent
    if [ "$cnt" -ge "$deb" ] && [ "$posted" != f ]; then act=postfail; posted=f; fi
    echo "FAIL:$cnt:$posted $act"
  else
    [ "$posted" != 0 ] && act=postok || act=silent   # recover only if some alarm is actually on the board
    echo "PASS $act"
  fi
}

# --edge / --once: run ONE check cycle then exit (the */10 cron backup path). Parse + shift BEFORE
# SESSION= so the flag is never mistaken for a session name — that was the watchdog-edge-noop bug:
# the cron's '--edge' became SESSION="${1:-...}", so the watchdog watched a nonexistent session and
# was a silent no-op every 10min while looking like a backup. The supervised no-arg loop is unaffected.
ONCE=0
case "${1:-}" in --edge|--once) ONCE=1; shift ;; esac

SESSION="${1:-$(hostname)}"
if [ "${1:-}" = --test ]; then
  tmux has-session -t "$(hostname)" 2>/dev/null || { echo "smoke-test: FAIL (no session)"; exit 1; }
  command -v mesh-unstick >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-unstick)"; exit 1; }
  # dry-run the repost cooldown (falsifiable): 1st post allowed, immediate 2nd suppressed, an aged
  # sentinel re-allows. Temp MESH_DIR so it never touches live state. A regression here = the flood
  # comes back (or worse, all alerts suppressed) — exactly what this test must catch.
  _td=$(mktemp -d) || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
  MESH_DIR="$_td" wd_should_post dev blocked || { echo "smoke-test: FAIL (cooldown suppressed the FIRST post)"; rm -rf "$_td"; exit 1; }
  if MESH_DIR="$_td" wd_should_post dev blocked; then echo "smoke-test: FAIL (cooldown did NOT suppress an immediate repost)"; rm -rf "$_td"; exit 1; fi
  echo 0 > "$_td/.wd-postts-blocked-dev"   # age the sentinel past the window
  MESH_DIR="$_td" wd_should_post dev blocked || { echo "smoke-test: FAIL (cooldown did not re-allow after the window elapsed)"; rm -rf "$_td"; exit 1; }
  # distinct kind/mind must be independent (not share a counter)
  MESH_DIR="$_td" wd_should_post plan limited || { echo "smoke-test: FAIL (cooldown leaked across mind+kind)"; rm -rf "$_td"; exit 1; }
  # quota_wave_active (chat-review/quota-wave-watchdog-gap): no mark → inactive; future ts → active;
  # past ts (elapsed cooldown) → inactive. RED-first: without the future-ts read the [mind-limited]
  # double-post returns. Reuses the same temp MESH_DIR (no live .keepalive-wave-cooldown touched).
  if MESH_DIR="$_td" quota_wave_active; then echo "smoke-test: FAIL (quota_wave_active true with no mark)"; rm -rf "$_td"; exit 1; fi
  echo "$(( $(date +%s) + 300 ))" > "$_td/.keepalive-wave-cooldown"
  MESH_DIR="$_td" quota_wave_active || { echo "smoke-test: FAIL (quota_wave_active false while cooldown mark is in the future)"; rm -rf "$_td"; exit 1; }
  echo 0 > "$_td/.keepalive-wave-cooldown"   # elapsed cooldown
  if MESH_DIR="$_td" quota_wave_active; then echo "smoke-test: FAIL (quota_wave_active true after cooldown elapsed)"; rm -rf "$_td"; exit 1; fi
  rm -rf "$_td"
  # health_step debounce state machine (the 2026-06-21 [health-fail] de-flap): a transient blip (1 FAIL
  # then recover) must be SILENT both ways; a real outage (≥DEBOUNCE consecutive) posts once + recovers;
  # legacy bare-FAIL migrates without re-posting or stranding. A regression here = the daily ~01:00 self
  # cry-wolf returns, OR a real outage goes unannounced.
  hf=0
  [ "$(health_step PASS FAIL 2)"     = "FAIL:1:0 silent" ]   || { echo "FAIL health_step: blip cycle1 should be silent"; hf=1; }
  [ "$(health_step FAIL:1:0 PASS 2)" = "PASS silent" ]       || { echo "FAIL health_step: debounced blip must recover silently (no post)"; hf=1; }
  [ "$(health_step FAIL:1:0 FAIL 2)" = "FAIL:2:f postfail" ] || { echo "FAIL health_step: 2nd consecutive must post"; hf=1; }
  [ "$(health_step FAIL:2:f FAIL 2)" = "FAIL:3:f silent" ]   || { echo "FAIL health_step: already-posted must not re-post"; hf=1; }
  [ "$(health_step FAIL:3:f PASS 2)" = "PASS postok" ]       || { echo "FAIL health_step: real outage must post recovery"; hf=1; }
  [ "$(health_step FAIL PASS 2)"     = "PASS postok" ]       || { echo "FAIL health_step: legacy bare-FAIL must recover (no strand)"; hf=1; }
  [ "$(health_step FAIL FAIL 2)"     = "FAIL:3:f silent" ]   || { echo "FAIL health_step: legacy bare-FAIL must not re-post"; hf=1; }
  # legacy boolean ':1' states are what is ON DISK at the moment this lands — each must read as a
  # posted alarm OF ITS OWN KIND, never as posted-nothing (which re-alarms) and never as posted-other.
  [ "$(health_step FAIL:2:1 PASS 2)" = "PASS postok" ]       || { echo "FAIL health_step: legacy FAIL:n:1 must migrate to a posted FAIL (else the alarm strands)"; hf=1; }
  [ "$(health_step FAIL:2:1 FAIL 2)" = "FAIL:3:f silent" ]   || { echo "FAIL health_step: legacy FAIL:n:1 must not re-post"; hf=1; }
  [ "$(health_step PART:2:1 LAN 2)"  = "PART:3:p silent" ]   || { echo "FAIL health_step: legacy PART:n:1 must not re-post"; hf=1; }
  [ "$(health_step OFF:2:1 OFFLINE 2)" = "OFF:3:o silent" ]  || { echo "FAIL health_step: legacy OFF:n:1 must not re-post"; hf=1; }
  # LAN = PARTIAL (chat-review/watchdog-hollow-recovery): tailscaled down but LAN-pingable → admin
  # path (tailnet SSH) LOST. Must render a DEGRADED [health-partial], NEVER a clean [health-ok]
  # RECOVERED (the hollow-recovery bug: LAN used to fall through to the PASS branch → postok). Sticky
  # until a TRUE PASS. A regression here re-hides a pingable-but-unadministrable node as fully healed.
  [ "$(health_step PASS LAN 2)"      = "PART:1:0 silent" ]      || { echo "FAIL health_step: fresh partial must debounce"; hf=1; }
  [ "$(health_step PART:1:0 LAN 2)"  = "PART:2:p postpartial" ] || { echo "FAIL health_step: 2nd consecutive partial must post"; hf=1; }
  [ "$(health_step PART:2:p LAN 2)"  = "PART:3:p silent" ]      || { echo "FAIL health_step: posted partial must hold (no re-post)"; hf=1; }
  [ "$(health_step FAIL:2:f LAN 2)"  = "PART:1:p postpartial" ] || { echo "FAIL health_step: a LIVE FAIL alarm must transition to partial instantly"; hf=1; }
  [ "$(health_step OFF:2:o LAN 2)"   = "PART:1:p postpartial" ] || { echo "FAIL health_step: a LIVE OFFLINE alarm must transition to partial"; hf=1; }
  [ "$(health_step FAIL:1:0 LAN 2)"  = "PART:1:0 silent" ]      || { echo "FAIL health_step: not-yet-posted FAIL → partial re-debounces"; hf=1; }
  [ "$(health_step PART:2:p PASS 2)" = "PASS postok" ]          || { echo "FAIL health_step: posted partial must clear to RECOVERED on true PASS"; hf=1; }
  [ "$(health_step PART:1:0 PASS 2)" = "PASS silent" ]          || { echo "FAIL health_step: un-posted partial recovers silently (no strand)"; hf=1; }
  [ "$(health_step FAIL:2:f LAN 2)" != "PASS postok" ]         || { echo "FAIL health_step: LAN must NOT clean-RECOVER (hollow-recovery regression)"; hf=1; }
  # chat-review/watchdog-partial-realarms-on-every-offline-blip — a SEQUENCE gate. No single step can
  # see this bug: it needs the state to churn OUT of PART and back while the world holds still. The
  # invariant is about the BOARD, so assert the whole act stream, not one transition.
  _seq_acts() {  # $1=start state, rest=results → "<act> <act> ...|<final state>"  (deb=2 throughout)
    local s="$1" out acts="" r; shift
    for r in "$@"; do out=$(health_step "$s" "$r" 2); s=${out%% *}; acts="$acts ${out##* }"; done
    printf '%s|%s\n' "${acts# }" "$s"
  }
  # (1) THE BUG: a node sitting steadily LAN-only, already boarded [health-partial], sees ONE OFFLINE
  #     blip. Nothing about the node changed, so the board must hear NOTHING — before the fix the blip
  #     dropped the posted bit and the unchanged LAN-only condition re-posted 2 cycles later, forever
  #     (16 GL-MT3000 + 14 Redmi [health-partial], 0 [health-ok], since 07-14T22:29).
  [ "$(_seq_acts PART:8:p OFFLINE LAN LAN LAN)" = "silent silent silent silent|PART:3:p" ] \
    || { echo "FAIL health_step: an OFFLINE blip re-armed a posted partial — got $(_seq_acts PART:8:p OFFLINE LAN LAN LAN)"; hf=1; }
  # (2) the same sequence from the LEGACY on-disk state this fix inherits (~/.mesh/.health-state holds
  #     PART:n:1) — migration must land it as a posted PARTIAL or the churn simply survives the fix.
  [ "$(_seq_acts PART:8:1 OFFLINE LAN LAN LAN)" = "silent silent silent silent|PART:3:p" ] \
    || { echo "FAIL health_step: legacy PART:n:1 not migrated as a POSTED partial — the blip still re-alarms"; hf=1; }
  # (3) a FAIL blip is the SAME hole (PART fell through the FAIL branch's catch-all too)
  [ "$(_seq_acts PART:8:p FAIL LAN LAN)" = "silent silent silent|PART:2:p" ] \
    || { echo "FAIL health_step: a FAIL blip re-armed a posted partial — got $(_seq_acts PART:8:p FAIL LAN LAN)"; hf=1; }
  # (4) the silence must NOT be bought by muting real escalations — this is what falsifies the
  #     carry-posted-as-a-BOOLEAN one-liner, where the OFF branch's `posted != 1` guard is false
  #     forever and a sustained OFFLINE never reaches the board at all.
  [ "$(_seq_acts PART:8:p OFFLINE OFFLINE)" = "silent postoffline|OFF:2:o" ] \
    || { echo "FAIL health_step: a SUSTAINED OFFLINE from a posted partial must still escalate — got $(_seq_acts PART:8:p OFFLINE OFFLINE)"; hf=1; }
  #     ...and from the LEGACY state too, asserted on the ACTS alone. Feeding only a tag state here
  #     would let a boolean implementation fail this for the wrong reason (it does not understand 'p',
  #     so it escalates by ACCIDENT — verified: that is exactly how the first draft of this gate caught
  #     it); fed PART:8:1, the state it would really meet, it holds the bit and the node stays
  #     hard-unreachable in SILENCE forever. That silence is what this line has to catch.
  _la="$(_seq_acts PART:8:1 OFFLINE OFFLINE OFFLINE OFFLINE)"
  [ "${_la%|*}" = "silent postoffline silent silent" ] \
    || { echo "FAIL health_step: a SUSTAINED OFFLINE from a LEGACY posted partial must escalate exactly ONCE, never hold silent forever — got $_la"; hf=1; }
  [ "$(_seq_acts PART:8:p FAIL FAIL)" = "silent postfail|FAIL:2:f" ] \
    || { echo "FAIL health_step: a SUSTAINED FAIL from a posted partial must still post"; hf=1; }
  # (5) and a real offline→partial round trip posts each tag exactly ONCE (the instant-transition arms
  #     stay honest): this is what falsifies the instant-escalate one-liner, which costs 2 posts/blip.
  [ "$(_seq_acts PART:8:p OFFLINE OFFLINE LAN LAN)" = "silent postoffline postpartial silent|PART:2:p" ] \
    || { echo "FAIL health_step: a real offline→partial round trip must post each tag once — got $(_seq_acts PART:8:p OFFLINE OFFLINE LAN LAN)"; hf=1; }
  # (6) a posted partial that TRULY recovers still says so (no strand), whatever it churned through
  [ "$(_seq_acts PART:8:p OFFLINE LAN PASS)" = "silent silent postok|PASS" ] \
    || { echo "FAIL health_step: a posted partial must still post RECOVERED on a true PASS after a blip"; hf=1; }
  # fleet-stale re-warn (part 2): duration-keyed. With window 0 the first degraded sight warns; with a
  # long window a fresh degraded sight is silent (only re-warns after it persists). Temp MESH_DIR only.
  _fd=$(mktemp -d) || { echo "smoke-test: FAIL (mktemp fleet)"; exit 1; }
  MESH_DIR="$_fd" MESH_FLEET_STALE_S=999999 fleet_stale_should_warn dummyhost >/dev/null \
    && { echo "smoke-test: FAIL (fleet-stale warned on a FRESH partial with a long window)"; rm -rf "$_fd"; exit 1; }
  rm -f "$_fd"/.fleet-stale-dummyhost
  MESH_DIR="$_fd" MESH_FLEET_STALE_S=0 fleet_stale_should_warn dummyhost >/dev/null \
    || { echo "smoke-test: FAIL (fleet-stale did NOT warn past the window)"; rm -rf "$_fd"; exit 1; }
  MESH_DIR="$_fd" fleet_stale_clear dummyhost
  [ -f "$_fd/.fleet-stale-dummyhost" ] && { echo "smoke-test: FAIL (fleet_stale_clear did not remove the sentinel)"; rm -rf "$_fd"; exit 1; }
  rm -rf "$_fd"
  # OFFLINE (mesh-health:164 — worse than no-internet), DEBOUNCED (chat-review/offline-flap-no-debounce
  # 2026-07-05): a fresh entry now debounces exactly like FAIL/SKIP (silent until cnt>=deb, then one
  # postoffline) — a flapping node (Redmi phone tailscaled/sshd blips) no longer alarm+recover-spams the
  # board on every clean↔OFFLINE flicker. The one instant-post case kept: escalating an ALREADY-POSTED
  # FAIL/legacy-FAIL alarm (chat-review/watchdog-offline-code-unhandled) — the board already knows this
  # node is degraded, so a worsening deserves an immediate post, not a fresh debounce wait.
  [ "$(health_step '' OFFLINE 2)"         = "OFF:1:0 silent" ]      || { echo "FAIL health_step: clean→OFFLINE(1) must debounce, not post immediately"; hf=1; }
  [ "$(health_step OFF:1:0 OFFLINE 2)"    = "OFF:2:o postoffline" ] || { echo "FAIL health_step: 2nd consecutive OFFLINE (>=debounce) must post"; hf=1; }
  [ "$(health_step OFF:2:o OFFLINE 2)"    = "OFF:3:o silent" ]      || { echo "FAIL health_step: already-posted OFFLINE must not re-post (flood)"; hf=1; }
  # FIXTURE FLIP (chat-review/watchdog-hollow-recovery): these two asserted the OLD behavior where LAN
  # routed through the PASS branch and clean-recovered an OFFLINE alarm — that IS the hollow-recovery
  # bug (LAN means tailscaled is still down → admin path lost). Corrected: an un-posted OFFLINE→LAN
  # blip still posts NOTHING (silent), but enters a partial-DEBOUNCE (not a clean PASS); a real posted
  # OFFLINE alarm TRANSITIONS to [health-partial], it does not clean-RECOVER.
  [ "$(health_step OFF:1:0 LAN 2)"        = "PART:1:0 silent" ]     || { echo "FAIL health_step: a single un-debounced OFFLINE→LAN blip must post NOTHING (silent; partial-debounce, not clean recovery)"; hf=1; }
  [ "$(health_step OFF:2:o PASS 2)"       = "PASS postok" ]         || { echo "FAIL health_step: a real (posted) OFFLINE alarm must recover on TRUE PASS (no strand)"; hf=1; }
  [ "$(health_step OFF:2:o LAN 2)"        = "PART:1:p postpartial" ]|| { echo "FAIL health_step: a real (posted) OFFLINE alarm on LAN must TRANSITION to partial (admin lost), not clean-RECOVER"; hf=1; }
  [ "$(health_step OFF:2:o FAIL 2)"       = "FAIL:1:o silent" ]     || { echo "FAIL health_step: offline→no-internet must re-debounce (carrying the posted tag, so the still-live OFFLINE alarm is not forgotten)"; hf=1; }
  [ "$(health_step FAIL:2:f OFFLINE 2)"   = "OFF:1:o postoffline" ] || { echo "FAIL health_step: OFFLINE must ESCALATE an already-posted no-internet alarm instantly (the unhandled-code bug)"; hf=1; }
  [ "$(health_step FAIL:1:0 OFFLINE 2)"   = "OFF:1:0 silent" ]      || { echo "FAIL health_step: OFFLINE from a not-yet-posted FAIL must debounce fresh, not escalate"; hf=1; }
  [ "$(health_step FAIL OFFLINE 2)"       = "OFF:1:o postoffline" ] || { echo "FAIL health_step: legacy posted-FAIL → OFFLINE must escalate instantly"; hf=1; }
  # SKIP (chat-review/watchdog-skip-never-alerts 2026-07-04): ssh-unreachable-while-tailscale-online
  # must share FAIL's debounce state machine — a single SKIP blip stays silent+recovers, but 2
  # consecutive SKIP cycles (>= debounce) must post, matching the FAIL parity assertions above. Before
  # this fix the caller-level case statement dropped SKIP entirely (continue), so this never even
  # reached health_step; the assertions below pin the fixed behavior at the pure-function level.
  [ "$(health_step PASS SKIP 2)"      = "FAIL:1:0 silent" ]   || { echo "FAIL health_step: SKIP blip cycle1 should be silent"; hf=1; }
  [ "$(health_step FAIL:1:0 PASS 2)"  = "PASS silent" ]       || { echo "FAIL health_step: debounced SKIP blip must recover silently (no post)"; hf=1; }
  [ "$(health_step FAIL:1:0 SKIP 2)"  = "FAIL:2:f postfail" ] || { echo "FAIL health_step: 2 consecutive SKIP must post (the watchdog-skip-never-alerts bug)"; hf=1; }
  [ "$(health_step FAIL:2:f SKIP 2)"  = "FAIL:3:f silent" ]   || { echo "FAIL health_step: already-posted SKIP must not re-post"; hf=1; }
  [ "$(health_step FAIL:3:f PASS 2)"  = "PASS postok" ]       || { echo "FAIL health_step: real SKIP outage must post recovery"; hf=1; }
  [ "$hf" = 0 ] || { echo "smoke-test: FAIL (health_step debounce regressed)"; exit 1; }
  # WATCHDOG_FLEET gate: default 1 (unchanged), explicit 0 must be honored (second-vantage guard)
  [ "$WATCHDOG_FLEET" = 1 ] || { echo "smoke-test: FAIL (WATCHDOG_FLEET default changed: $WATCHDOG_FLEET)"; exit 1; }
  [ "$(MESH_WATCHDOG_FLEET=0 bash -c 'echo "${MESH_WATCHDOG_FLEET:-1}"')" = 0 ] \
    || { echo "smoke-test: FAIL (MESH_WATCHDOG_FLEET=0 override not honored)"; exit 1; }
  # HOST-DARK expected-down (chat-review/expected-down-host-asleep 2026-07-06) — pure + falsifiable.
  hd=0
  # (1) household membership: configured host matches, others don't, empty list matches NOTHING (else a
  #     real non-household node's outage would be wrongly silenced).
  ( MESH_HOUSEHOLD_HOSTS="ilya foo"; host_is_household ilya )   || { echo "FAIL host_is_household: configured host not matched"; hd=1; }
  ( MESH_HOUSEHOLD_HOSTS="ilya foo"; host_is_household bar ) &&    { echo "FAIL host_is_household: unconfigured host matched (would silence a real node)"; hd=1; }
  ( MESH_HOUSEHOLD_HOSTS=""; host_is_household ilya )        &&    { echo "FAIL host_is_household: empty list must match nothing"; hd=1; }
  # (2) dark-token: sleep tokens read dark; AWAKE (ACTIVE) and empty (home-state unreachable) do NOT →
  #     an awake-hours failure still routes to the full alarm (the honest edge the task fixed).
  household_token_is_dark ASLEEP      || { echo "FAIL dark-token: ASLEEP must read dark"; hd=1; }
  household_token_is_dark QUIET_NIGHT || { echo "FAIL dark-token: QUIET_NIGHT must read dark"; hd=1; }
  household_token_is_dark ACTIVE      && { echo "FAIL dark-token: ACTIVE (awake) must NOT read dark — awake failure must still alarm"; hd=1; }
  household_token_is_dark ""          && { echo "FAIL dark-token: empty (home-state unreachable) must NOT read dark (never fake a sleep)"; hd=1; }
  # (3) unreachable classifier: FAIL/OFFLINE/SKIP are expected-down candidates; PASS/LAN alarm normally
  for r in FAIL OFFLINE SKIP; do is_unreachable_result "$r" || { echo "FAIL is_unreachable_result: $r must be unreachable"; hd=1; }; done
  for r in PASS LAN;        do is_unreachable_result "$r" && { echo "FAIL is_unreachable_result: $r must NOT be unreachable (LAN=partial, still surfaces)"; hd=1; }; done
  # (4) episode once-per + cross-watchdog dedupe, driven off a temp board log
  _hd=$(mktemp -d) || { echo "smoke-test: FAIL (mktemp hostdark)"; exit 1; }
  (
    export MESH_DIR="$_hd" MESH_EXPECTED_DOWN_DEDUP_S=1800
    : > "$_hd/chat.log"
    [ "$(expected_down_plan ilya)" = post ]          || { echo "FAIL expected_down_plan: first sight (clean board) must POST"; exit 7; }
    [ "$(expected_down_plan ilya)" = quiet-episode ] || { echo "FAIL expected_down_plan: 2nd call same episode must be quiet-episode (once-per-episode)"; exit 7; }
    expected_down_clear ilya
    printf '%s  watchdog@peer  ::  [health-fail] ilya — UNREACHABLE\n' "$(date -u -d '-5 min' +%FT%TZ)" > "$_hd/chat.log"
    [ "$(expected_down_plan ilya)" = quiet-dedup ]   || { echo "FAIL expected_down_plan: a peer post 5min ago must SUPPRESS (cross-watchdog quiet-dedup)"; exit 7; }
    expected_down_clear ilya
    printf '%s  watchdog@peer  ::  [health-fail] ilya — UNREACHABLE\n' "$(date -u -d '-90 min' +%FT%TZ)" > "$_hd/chat.log"
    [ "$(expected_down_plan ilya)" = post ]          || { echo "FAIL expected_down_plan: a 90-min-old peer post is STALE — must NOT dedupe, expected POST"; exit 7; }
    expected_down_clear ilya
    # (5) HH-DARK flap guard (chat-review/watchdog-expected-down-survives-homestate-flap): with an active
    #     episode + host still unreachable, a SINGLE non-dark cycle HOLDs (no clear/alarm); non-dark sustained
    #     ≥ MESH_HH_WAKE_DEBOUNCE CLEARs (genuine wake still alarms). Falsify: reverting to the unconditional
    #     clear removes the sentinel on cycle 1 → wake_step would never see it → hold-then-clear can't hold.
    : > "$_hd/chat.log"; expected_down_plan ilya >/dev/null    # establish episode → sentinel exists
    ( export MESH_HH_WAKE_DEBOUNCE=2
      [ -f "$_hd/.expected-down-ilya" ]                || { echo "FAIL wake-step: episode sentinel must exist after plan"; exit 7; }
      [ "$(expected_down_wake_step ilya)" = hold ]     || { echo "FAIL wake-step: 1st non-dark cycle must HOLD (single UNCERTAIN flap ≠ wake)"; exit 7; }
      [ -f "$_hd/.expected-down-ilya" ]                || { echo "FAIL wake-step: episode must SURVIVE a held flap (the cry-wolf bug)"; exit 7; }
      [ "$(expected_down_wake_step ilya)" = clear ]    || { echo "FAIL wake-step: 2nd consecutive non-dark cycle (=debounce) must CLEAR → genuine wake alarms"; exit 7; }
    ) || exit 7
    ( export MESH_HH_WAKE_DEBOUNCE=1
      : > "$_hd/chat.log"; expected_down_clear ilya; expected_down_plan ilya >/dev/null
      [ "$(expected_down_wake_step ilya)" = clear ]    || { echo "FAIL wake-step: debounce=1 must CLEAR on the first cycle (guard is debounce-driven, not hard-coded)"; exit 7; }
    ) || exit 7
    expected_down_clear ilya
    [ -f "$_hd/.expected-down-wake-ilya" ]             && { echo "FAIL wake-step: expected_down_clear must also remove the wake counter"; exit 7; }
    expected_down_plan ilya >/dev/null; printf 'x\n' > "$_hd/.expected-down-wake-ilya"
    expected_down_wake_reset ilya; [ -f "$_hd/.expected-down-wake-ilya" ] && { echo "FAIL wake-step: a dark cycle (wake_reset) must break the streak"; exit 7; }
    true   # negative-asserts above end falsy when they PASS (file absent) — the subshell must exit 0
  ) || hd=1
  rm -rf "$_hd"
  [ "$hd" = 0 ] || { echo "smoke-test: FAIL (HOST-DARK expected-down regressed)"; exit 1; }
  echo "smoke-test: ok (repost-cooldown + health_step debounce + OFFLINE-escalation + SKIP-parity + fleet-gate + HOST-DARK expected-down verified)"

  # chat-review/room-speech-clean-stop-unwatched: mesh-room-speech.service (the wake-word ear,
  # lives on the mic node) must be in the systemd restart loop's service list, same gating as
  # ngrok.service (file-existence checked at runtime, so this is a safe no-op on nodes without the
  # unit — e.g. this node has no mic and no such unit file). Pattern built from a var (matching the
  # quota_wave caller-polarity test in mesh-channel-keepalive) so this test can't self-satisfy.
  _svcname="mesh-room-speech.service"
  grep -qF -- "for svc in ngrok.service $_svcname; do" "$0" || { echo "smoke-test: FAIL (mesh-room-speech.service missing from the systemd restart loop)"; exit 1; }
  echo "smoke-test: ok (mesh-room-speech.service wired into the systemd restart loop)"

  # chat-review/watchdog-fleet-dedup-unconfigured: two simulated hosts post the identical
  # '[health-fail] ilya' within the dedup window → only the first lands, the second adopts
  # silently; once the window has elapsed, a real repeat failure still reaches the board.
  _fd="$(mktemp -d)"; _fboard="$_fd/chat.log"
  printf '2026-07-08T16:01:49Z  watchdog@nodeA  ::  [health-fail] ilya — no internet (2 consecutive)\n' > "$_fboard"
  # sandbox always suppresses the actual post regardless of dedup outcome — assert the DEDUP DECISION
  # itself via board_recent_ts_within directly (what fleet_dedup_post gates on), same as fawxible-watch.
  board_recent_ts_within "$_fboard" "[health-fail] ilya" 3600 "$(date -u -d '2026-07-08T16:10:41Z' +%s)" >/dev/null 2>&1 \
    || { echo "smoke-test: FAIL (dedup: 9min-later post for same host should adopt within a 1h window)"; exit 1; }
  board_recent_ts_within "$_fboard" "[health-fail] ilya" 60 "$(date -u -d '2026-07-08T16:10:41Z' +%s)" >/dev/null 2>&1 \
    && { echo "smoke-test: FAIL (dedup: 9min-later post must NOT adopt once a short window has elapsed — real repeat failures must not strand)"; exit 1; }
  board_recent_ts_within "$_fboard" "[health-partial] ilya" 3600 "$(date -u -d '2026-07-08T16:10:41Z' +%s)" >/dev/null 2>&1 \
    && { echo "smoke-test: FAIL (dedup: a [health-fail] post must not dedup a different-tag [health-partial] verdict)"; exit 1; }
  rm -rf "$_fd"
  # MESH_TEST_SANDBOX gate: fleet_dedup_post must never shell out to mesh-chat under sandbox, whatever
  # the dedup outcome (asserted via return code only, mirrors the mesh-chat-call assertions above).
  [ "$(MESH_TEST_SANDBOX=1 fleet_dedup_post "[health-ok] nowhere" "irrelevant" 3600 "/nonexistent" >/dev/null 2>&1; echo $?)" = 0 ] \
    || { echo "smoke-test: FAIL (fleet_dedup_post under MESH_TEST_SANDBOX must return 0, not shell out)"; exit 1; }

  # chat-review/patterns-presync-gate-shared-relanded: presync wiring — MESH_TEST_SANDBOX=1 must
  # suppress fleet_dedup_post's presync call entirely (never shells out under test); board_presync
  # itself (called directly, never through fleet_dedup_post's live/posting path — that path would
  # really shell out to mesh-chat, which a --test must never do) must fire on the live gate.
  _psd="$(mktemp -d)"
  _ps_calls="$_psd/calls"; _ps_cmd="$_psd/cmd.sh"
  printf '#!/bin/sh\necho called >> "%s"\n' "$_ps_calls" > "$_ps_cmd"; chmod +x "$_ps_cmd"
  MESH_TEST_SANDBOX=1 MESH_WD_PRESYNC_CMD="$_ps_cmd" WD_PRESYNC_STAMP="$_psd/stamp" \
    fleet_dedup_post "[health-ok] nowhere" "irrelevant" 3600 "/nonexistent" >/dev/null 2>&1
  [ -f "$_ps_calls" ] && { echo "smoke-test: FAIL (presync must not fire while MESH_TEST_SANDBOX=1)"; exit 1; }
  board_presync "$_psd/stamp" 300 5 "$_ps_cmd"
  [ "$(grep -c . "$_ps_calls" 2>/dev/null || echo 0)" = 1 ] \
    || { echo "smoke-test: FAIL (board_presync must fire on its live gate, got $(grep -c . "$_ps_calls" 2>/dev/null || echo 0) calls)"; exit 1; }
  [ -f "$_psd/stamp" ] || { echo "smoke-test: FAIL (board_presync must touch its stamp file)"; exit 1; }
  rm -rf "$_psd"

  echo "smoke-test: ok (fleet-health dedup: within-window adopt, window-elapsed repost, tag-distinct, MESH_TEST_SANDBOX gate verified; presync fires live/suppressed under sandbox)"

  # chat-review/watchdog-chronic-offtailnet-peer-flap (2026-07-18): a peer gone from the tailnet for WEEKS
  # that oscillates OFFLINE<->LAN must board ONCE per chronic episode then trace-tier, re-arming only when
  # last-seen resets fresh. chronic_offtailnet_plan is pure (sentinel in MESH_DIR) → falsifiable here.
  # RED-first: make the plan always echo `board` (or drop the sentinel branch) and (1)+(3) go red.
  _cd="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp chronic)"; exit 1; }
  # (0) parser: only the d-form is chronic; h/m/never/on-tailnet are fresh-by-construction → empty.
  [ "$(chronic_lastseen_days 'reachable off-tailnet (tailnet: last-seen 28d ago, active=True)')" = 28 ] \
    || { echo "smoke-test: FAIL (chronic_lastseen_days must extract 28 from a LAN rest string)"; rm -rf "$_cd"; exit 1; }
  [ "$(chronic_lastseen_days '(tailnet: last-seen 3d ago, active=True)')" = 3 ] \
    || { echo "smoke-test: FAIL (chronic_lastseen_days must extract 3 from an OFFLINE rest string)"; rm -rf "$_cd"; exit 1; }
  [ -z "$(chronic_lastseen_days '(tailnet: last-seen 5h ago, active=True)')" ] \
    || { echo "smoke-test: FAIL (an h-scale age is not day-chronic → must be empty)"; rm -rf "$_cd"; exit 1; }
  [ -z "$(chronic_lastseen_days '100.94.116.17 (self)')" ] \
    || { echo "smoke-test: FAIL (an on-tailnet PASS rest with no last-seen → must be empty)"; rm -rf "$_cd"; exit 1; }
  # (1) THE BUG: a chronic peer (28d) flapping OFFLINE→LAN→OFFLINE→LAN boards the FIRST edge, trace-tier every edge after.
  [ "$(MESH_DIR="$_cd" chronic_offtailnet_plan gl 28 7)" = board ] \
    || { echo "smoke-test: FAIL (chronic: first edge of a 28d-absent peer must board once)"; rm -rf "$_cd"; exit 1; }
  [ "$(MESH_DIR="$_cd" chronic_offtailnet_plan gl 28 7)" = quiet ] \
    || { echo "smoke-test: FAIL (chronic: 2nd edge — the LAN transition — must go trace-tier, not re-board)"; rm -rf "$_cd"; exit 1; }
  [ "$(MESH_DIR="$_cd" chronic_offtailnet_plan gl 28 7)" = quiet ] \
    || { echo "smoke-test: FAIL (chronic: 3rd edge — back to OFFLINE — still quiet; ONE board per episode)"; rm -rf "$_cd"; exit 1; }
  # (2) a FRESH peer (3d < threshold) still boards EVERY edge — a recently-gone node is a live incident, not chronic-absent.
  [ "$(MESH_DIR="$_cd" chronic_offtailnet_plan ds 3 7)" = board ] \
    || { echo "smoke-test: FAIL (chronic: a 3d peer below threshold must board normally)"; rm -rf "$_cd"; exit 1; }
  [ "$(MESH_DIR="$_cd" chronic_offtailnet_plan ds 3 7)" = board ] \
    || { echo "smoke-test: FAIL (chronic: a below-threshold peer must board EVERY edge, no suppression)"; rm -rf "$_cd"; exit 1; }
  # (3) RE-ARM: a chronic peer whose last-seen resets fresh clears the episode → the next chronic spell boards again.
  MESH_DIR="$_cd" chronic_offtailnet_plan gl 28 7 >/dev/null   # re-establish the episode sentinel
  [ -f "$_cd/.chronic-offtailnet-gl" ] \
    || { echo "smoke-test: FAIL (chronic: episode sentinel must exist after a chronic board)"; rm -rf "$_cd"; exit 1; }
  [ "$(MESH_DIR="$_cd" chronic_offtailnet_plan gl 5 7)" = board ] \
    || { echo "smoke-test: FAIL (chronic: last-seen reset fresh (5d<7) must RE-ARM → board)"; rm -rf "$_cd"; exit 1; }
  [ -f "$_cd/.chronic-offtailnet-gl" ] \
    && { echo "smoke-test: FAIL (chronic: a fresh last-seen must CLEAR the episode sentinel to re-arm)"; rm -rf "$_cd"; exit 1; }
  [ "$(MESH_DIR="$_cd" chronic_offtailnet_plan gl 28 7)" = board ] \
    || { echo "smoke-test: FAIL (chronic: after re-arm, a new chronic spell must board once again)"; rm -rf "$_cd"; exit 1; }
  # (4) unknown last-seen age (on-tailnet PASS, or any non-day age) is NEVER chronic → always board (never suppress what we can't classify).
  [ "$(MESH_DIR="$_cd" chronic_offtailnet_plan x '' 7)" = board ] \
    || { echo "smoke-test: FAIL (chronic: unknown last-seen age must board — never suppress an unclassifiable peer)"; rm -rf "$_cd"; exit 1; }
  # explicit clear removes the sentinel (the postok re-arm path).
  MESH_DIR="$_cd" chronic_offtailnet_plan gl 28 7 >/dev/null; MESH_DIR="$_cd" chronic_offtailnet_clear gl
  [ -f "$_cd/.chronic-offtailnet-gl" ] \
    && { echo "smoke-test: FAIL (chronic_offtailnet_clear must remove the episode sentinel)"; rm -rf "$_cd"; exit 1; }
  rm -rf "$_cd"
  echo "smoke-test: ok (chronic off-tailnet flap: chronic peer boards once/episode then trace, fresh peer boards every edge, last-seen reset re-arms)"
  # ---- DECLARED-SLEEPY bodies (board task watchdog-has-no-state-for-a-body-that-is-DESIGNED-to-sleep,
  #      {#a63f7382}, 2026-08-24). Driven END-TO-END through --once with a stubbed mesh-health and a
  #      stubbed mesh-chat, because the task's gate is about the TAG THAT REACHES THE BOARD, not about
  #      a predicate agreeing with itself. The stub dir IS the fake HOME's ~/.local/bin, so this tool's
  #      own `export PATH="$HOME/.local/bin:$PATH"` (:13) puts the stubs AHEAD of the real tools rather
  #      than losing the race to them (CLAUDE.md, a-poisoned-binary-can-lose-a-path-race-to-the-real-one).
  _sl="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
  mkdir -p "$_sl/home/.local/bin" "$_sl/mesh"
  # The fixture's ADDRESS is the experiment. The old stub named the LIVE phone's tailscale IP, so
  # after the L3 gate below this suite would have measured tonight's weather on a real device
  # instead of the classifier (a-two-arm-gate-against-a-live-world-measures-the-world). Both arms
  # now probe addresses whose answer is a property of the IP stack, not of the mesh:
  #   127.0.0.1  — always answers ICMP → a genuinely measured ALIVE body
  #   192.0.2.1  — RFC5737 TEST-NET-1, no reply and no RST → a genuinely measured DARK body
  # Nothing is stubbed at the probe layer: the real ping/connect run, and the verdict is real.
  # The (self) PASS line is the COVERAGE term — without it a dark reading is unattributable and the
  # gate must downgrade it to unknown, which arm (i) drives explicitly.
  cat > "$_sl/home/.local/bin/mesh-health" <<'EOS'
#!/bin/sh
echo "PASS smoke-self 127.0.0.1 (self)"
echo "FAIL Redmi ${SMOKE_REDMI_ADDR:-192.0.2.1} (android) ssh unreachable"
EOS
  cat > "$_sl/home/.local/bin/mesh-chat" <<'EOS'
#!/bin/sh
printf '%s\n' "$1" >> "$MESH_DIR/posted.log"
EOS
  printf '#!/bin/sh\nexit 0\n' > "$_sl/home/.local/bin/mesh-chat-sync"
  printf '#!/bin/sh\nexit 0\n' > "$_sl/home/.local/bin/mesh-unstick"
  # tmux stub: the cycle opens with `tmux list-windows | while read` and this script runs under
  # set -e, so a REAL missing session kills the pass before the fleet block is ever reached — the
  # harness would then be measuring its own bad setup, not the classifier. One window, empty panes.
  cat > "$_sl/home/.local/bin/tmux" <<'EOS'
#!/bin/sh
case "$1" in list-windows) echo "0|smokewin" ;; esac
exit 0
EOS
  chmod +x "$_sl/home/.local/bin/"*
  # every cycle exports the fixture address ($2, default dark) and an empty node-local address
  # config, so the ONLY candidate the L3 probe sees is the one this arm chose.
  _slcycle() {  # $1=sleepy-host-list $2=fixture addr
    HOME="$_sl/home" MESH_DIR="$_sl/mesh" MESH_WD_SLEEPY_HOSTS="$1" \
      SMOKE_REDMI_ADDR="${2:-192.0.2.1}" PHONE_LAN_IPS="" MESH_LAN_FALLBACK="" \
      MESH_WD_SLEEPY_L3_TIMEOUT=1 \
      MESH_HOUSEHOLD_HOSTS="" MESH_WATCHDOG_FLEET=1 \
      bash "$0" --once "wd-smoke-no-such-session-$$" >/dev/null 2>&1 || true
  }
  _slrun() {  # $1=sleepy-host-list $2=fixture addr ; two --once cycles (HEALTH_DEBOUNCE=2 to post)
    rm -f "$_sl/mesh/posted.log"
    _slcycle "$1" "${2:-}"; _slcycle "$1" "${2:-}"
    cat "$_sl/mesh/posted.log" 2>/dev/null || true
  }
  # (a) THE RED ARM FIRST, and it is the control: the IDENTICAL fixture with NO declaration must still
  #     produce [health-fail]. Without this the green arm below passes for a tool that never alarms.
  rm -rf "$_sl/mesh"; mkdir -p "$_sl/mesh"
  _slout="$(_slrun '')"
  printf '%s' "$_slout" | grep -q '\[health-fail\] Redmi' \
    || { echo "smoke-test: FAIL (undeclared host did not produce [health-fail] — the control arm is broken, so the green arm proves nothing): $_slout"; rm -rf "$_sl"; exit 1; }
  printf '%s' "$_slout" | grep -q 'expected-down' \
    && { echo "smoke-test: FAIL (an UNDECLARED host was reclassified as expected-down — the declaration is not what is doing the work): $_slout"; rm -rf "$_sl"; exit 1; }
  # (b) the task's gate: the SAME fixture, host declared sleepy → [expected-down] HOST-ASLEEP and NO
  #     [health-fail]. This is what produced [health-fail] before the fix (32x in 50h on the live board).
  rm -rf "$_sl/mesh"; mkdir -p "$_sl/mesh"
  _slout="$(_slrun 'Redmi')"
  printf '%s' "$_slout" | grep -q '\[expected-down\] Redmi .*HOST-ASLEEP' \
    || { echo "smoke-test: FAIL (a DECLARED-sleepy body unreachable one cycle did not board [expected-down] HOST-ASLEEP): $_slout"; rm -rf "$_sl"; exit 1; }
  printf '%s' "$_slout" | grep -q '\[health-fail\] Redmi' \
    && { echo "smoke-test: FAIL (a declared-sleepy body ALSO boarded [health-fail] — the cry-wolf is still on the board): $_slout"; rm -rf "$_sl"; exit 1; }
  #     and the bound it will alarm at must be IN the post, with the SOURCE that produced it — a bound
  #     nobody has calibrated must never wear the authority of a measured one.
  printf '%s' "$_slout" | grep -qE 'bound source: (cold|measured), n=[0-9]+' \
    || { echo "smoke-test: FAIL ([expected-down] does not publish its bound's SOURCE and n): $_slout"; rm -rf "$_sl"; exit 1; }
  #     …and it must be post-ONCE per episode: a third cycle adds no second [expected-down].
  _slbefore=$(grep -c 'expected-down' "$_sl/mesh/posted.log" 2>/dev/null || echo 0)
  _slcycle Redmi
  _slafter=$(grep -c 'expected-down' "$_sl/mesh/posted.log" 2>/dev/null || echo 0)
  [ "$_slbefore" = "$_slafter" ] \
    || { echo "smoke-test: FAIL (a sleepy episode re-boarded [expected-down] on a later cycle — post-once is broken: $_slbefore -> $_slafter)"; rm -rf "$_sl"; exit 1; }
  # (c) THE DECLARATION BUYS A DIFFERENT TAG, NEVER SILENCE. Backdate the episode sentinel past the
  #     cold bound: the same still-unreachable host must now board LOUD, tagged ASLEEP-OVERDUE.
  printf '%s\n' "$(( $(date +%s) - 100000 ))" > "$_sl/mesh/.expected-down-Redmi"
  rm -f "$_sl/mesh/posted.log"
  # TWO cycles: leaving the reclassified state re-enters HEALTH_DEBOUNCE, which is correct — the
  # escape hatch is an ordinary alarm and pays the ordinary de-flap. It is also the arm that proves
  # the episode is NOT torn down between them: a restarted clock would read 0m elapsed on the second
  # cycle and quietly re-classify as expected-down, so this can only pass while the episode persists.
  for _i in 1 2; do _slcycle Redmi; done
  _slout="$(cat "$_sl/mesh/posted.log" 2>/dev/null || true)"
  printf '%s' "$_slout" | grep -q 'ASLEEP-OVERDUE' \
    || { echo "smoke-test: FAIL (a declared-sleepy body unreachable PAST its own bound stayed silent — the declaration bought silence, which is the one thing it must never buy): $_slout"; rm -rf "$_sl"; exit 1; }
  [ -f "$_sl/mesh/.sleepy-overdue-Redmi" ] \
    || { echo "smoke-test: FAIL (the overdue episode was not marked, so its duration can still be learned as a sleep sample)"; rm -rf "$_sl"; exit 1; }
  # (d) AND THE LEDGER MUST NOT LEARN FROM THE FAULT. An episode flagged overdue is DISCARDED on
  #     recovery; a normal one is RECORDED. Without this the bound rises every time the alarm fires,
  #     until it can never fire again — the detector erasing its own signal.
  rm -f "$_sl/mesh/.sleepy-episodes-Redmi" "$_sl/mesh/.sleepy-overdue-Redmi"   # (c) left the host flagged
  printf '%s\n' "$(( $(date +%s) - 600 ))" > "$_sl/mesh/.expected-down-Redmi"
  [ "$(MESH_DIR="$_sl/mesh" sleepy_episode_close Redmi | awk '{print $1}')" = recorded ] \
    || { echo "smoke-test: FAIL (a clean sleep episode was not recorded — the bound can never become measured)"; rm -rf "$_sl"; exit 1; }
  [ "$(grep -c . "$_sl/mesh/.sleepy-episodes-Redmi" 2>/dev/null || echo 0)" = 1 ] \
    || { echo "smoke-test: FAIL (clean episode did not land exactly one sample in the ledger)"; rm -rf "$_sl"; exit 1; }
  printf '%s\n' "$(( $(date +%s) - 600 ))" > "$_sl/mesh/.expected-down-Redmi"
  MESH_DIR="$_sl/mesh" sleepy_overdue_mark Redmi
  [ "$(MESH_DIR="$_sl/mesh" sleepy_episode_close Redmi | awk '{print $1}')" = discarded ] \
    || { echo "smoke-test: FAIL (an OVERDUE episode was recorded as a sleep sample — the fault would widen the bound that detects it)"; rm -rf "$_sl"; exit 1; }
  [ "$(grep -c . "$_sl/mesh/.sleepy-episodes-Redmi" 2>/dev/null || echo 0)" = 1 ] \
    || { echo "smoke-test: FAIL (the overdue episode reached the ledger anyway)"; rm -rf "$_sl"; exit 1; }
  # (e) the bound itself: COLD until MIN_N closed episodes, then MEASURED = longest observed x slack,
  #     and the source is named in the reading (never a bare number).
  rm -f "$_sl/mesh/.sleepy-episodes-Redmi"
  [ "$(MESH_DIR="$_sl/mesh" MESH_WD_SLEEPY_COLD_MIN=360 sleepy_bound_min Redmi)" = "360 cold 0" ] \
    || { echo "smoke-test: FAIL (no history must read as the declared COLD floor, and SAY so: $(MESH_DIR="$_sl/mesh" sleepy_bound_min Redmi))"; rm -rf "$_sl"; exit 1; }
  printf '10\n12\n' > "$_sl/mesh/.sleepy-episodes-Redmi"
  [ "$(MESH_DIR="$_sl/mesh" MESH_WD_SLEEPY_MIN_N=3 MESH_WD_SLEEPY_COLD_MIN=360 sleepy_bound_min Redmi)" = "360 cold 2" ] \
    || { echo "smoke-test: FAIL (n below MIN_N must still read COLD — an uncalibrated bound must not wear a measured one's authority)"; rm -rf "$_sl"; exit 1; }
  printf '10\n12\n175\n' > "$_sl/mesh/.sleepy-episodes-Redmi"
  [ "$(MESH_DIR="$_sl/mesh" MESH_WD_SLEEPY_MIN_N=3 MESH_WD_SLEEPY_SLACK=2 sleepy_bound_min Redmi)" = "350 measured 3" ] \
    || { echo "smoke-test: FAIL (measured bound is not longest-observed x slack: $(MESH_DIR="$_sl/mesh" MESH_WD_SLEEPY_MIN_N=3 sleepy_bound_min Redmi))"; rm -rf "$_sl"; exit 1; }
  # ---- L3 EVIDENCE GATE (board task sleepy-exemption-records-ssh-flap-gaps-as-sleep-samples
  #      {#a211d449}). The sleep word must be EARNED by a measurement independent of the transport
  #      that failed. Arms (g)-(k) drive the real ping/connect — nothing is stubbed below the tool.
  # (g) the candidate ADDRESS SET is built from live config only, and the android class predicate
  #     (never a hostname) is what adds the phone's LAN paths — a renamed phone keeps them.
  _sladdr="$(MESH_LAN_FALLBACK="Redmi:192.168.8.203 other:10.0.0.1" PHONE_LAN_IPS="192.168.8.146" \
              sleepy_addrs Redmi "SKIP Redmi 10 100.103.99.16 (android) — SSH unreachable" | tr '\n' ' ')"
  [ "$_sladdr" = "100.103.99.16 192.168.8.203 192.168.8.146 " ] \
    || { echo "smoke-test: FAIL (address set is not health-line + host-keyed LAN + android LAN, deduped/ordered: [$_sladdr])"; rm -rf "$_sl"; exit 1; }
  _sladdr="$(MESH_LAN_FALLBACK="" PHONE_LAN_IPS="192.168.8.146" \
              sleepy_addrs ilya "SKIP ilya 100.107.198.111 — SSH unreachable" | tr '\n' ' ')"
  [ "$_sladdr" = "100.107.198.111 " ] \
    || { echo "smoke-test: FAIL (a NON-android line was given the phone's LAN candidates — the class predicate is not doing the work: [$_sladdr])"; rm -rf "$_sl"; exit 1; }
  [ "$(sleepy_ssh_port "FAIL Redmi 1.2.3.4 (android) x")" = "${PHONE_SSH_PORT:-8022}" ] \
    && [ "$(MESH_WD_SLEEPY_SSH_PORT=22 sleepy_ssh_port "FAIL ilya 1.2.3.4 x")" = 22 ] \
    || { echo "smoke-test: FAIL (ssh port is not taken from the body class — an android body would be RST-probed on the wrong port)"; rm -rf "$_sl"; exit 1; }
  # (h) THE DISCRIMINATOR ITSELF, on real sockets. A live stack REFUSES (RST) → alive; TEST-NET-1
  #     neither replies nor resets → dark. This is the exact pair that was measured on the live
  #     phone at 23:2xZ (ICMP 0% loss + 8022 refused) and called HOST-ASLEEP anyway.
  _slv="$(MESH_WD_SLEEPY_L3_TIMEOUT=1 sleepy_l3_verdict Redmi ok 8022 127.0.0.1)"
  case "$_slv" in alive\ *) : ;; *) echo "smoke-test: FAIL (a host answering on loopback did not read L3 ALIVE: $_slv)"; rm -rf "$_sl"; exit 1 ;; esac
  _slv="$(MESH_WD_SLEEPY_L3_TIMEOUT=1 sleepy_l3_verdict Redmi ok 8022 192.0.2.1)"
  case "$_slv" in dark\ *) : ;; *) echo "smoke-test: FAIL (an address that neither replies nor resets did not read L3 DARK — the sleep word can never be earned: $_slv)"; rm -rf "$_sl"; exit 1 ;; esac
  #     and a refusal must NOT be confused with an unroutable address: bash returns rc=1 for both,
  #     so only the errno RENDERING separates them. 169.254.0.0/16 with no link-local route is the
  #     unreachable case; reading it as 'refused' would call a dead address a live stack.
  _slt="$(MESH_WD_SLEEPY_L3_TIMEOUT=1 sleepy_tcp_probe 192.0.2.1 8022)"
  case "$_slt" in timeout|unreach) : ;; *) echo "smoke-test: FAIL (TEST-NET probe read as '$_slt' — refused/unreachable/timeout are being collapsed)"; rm -rf "$_sl"; exit 1 ;; esac
  #     THE rc=1 PAIR, which is the whole reason this reads the message and not the exit code. Both
  #     return 1 from bash and only the errno rendering separates them: a closed loopback port is a
  #     real RST (a LIVE stack), while 255.255.255.255 is rejected with ENETUNREACH by the kernel's
  #     own `broadcast` route type — a property of the local stack, not of tonight's routing, which
  #     on this node churns (0.0.0.0/8 was measured EHOSTUNREACH and then swallowed into the exit
  #     node's table within the hour, so it is NOT usable as a fixture). Collapsing the pair calls a
  #     dead address a live body — a permanent false alarm — while collapsing it the other way hands
  #     a flapping daemon permanent silence.
  [ "$(MESH_WD_SLEEPY_L3_TIMEOUT=1 sleepy_tcp_probe 127.0.0.1 9)" = refused ] \
    && [ "$(MESH_WD_SLEEPY_L3_TIMEOUT=1 sleepy_tcp_probe 255.255.255.255 9)" = unreach ] \
    || { echo "smoke-test: FAIL (the rc=1 pair is collapsed: refused=$(MESH_WD_SLEEPY_L3_TIMEOUT=1 sleepy_tcp_probe 127.0.0.1 9) netunreach=$(MESH_WD_SLEEPY_L3_TIMEOUT=1 sleepy_tcp_probe 255.255.255.255 9) — bash returns 1 for both, only the errno rendering separates them)"; rm -rf "$_sl"; exit 1; }
  #     …and it must reach the VERDICT, not stop at the probe: an unreachable address is DARK.
  _slv="$(MESH_WD_SLEEPY_L3_TIMEOUT=1 sleepy_l3_verdict Redmi ok 9 255.255.255.255)"
  case "$_slv" in dark\ *) : ;; *) echo "smoke-test: FAIL (an unreachable address did not read DARK — it is being taken for a live stack: $_slv)"; rm -rf "$_sl"; exit 1 ;; esac
  # (i) THE PROBE CAN SHARE THE FAULT. Identical dark inputs with the coverage term ABSENT must read
  #     UNKNOWN, never dark — our own wedged uplink must not be able to buy every peer silence.
  _slv="$(MESH_WD_SLEEPY_L3_TIMEOUT=1 sleepy_l3_verdict Redmi na 8022 192.0.2.1)"
  case "$_slv" in unknown\ *) : ;; *) echo "smoke-test: FAIL (dark was granted with NO self-coverage — a broken local uplink would silence the whole fleet: $_slv)"; rm -rf "$_sl"; exit 1 ;; esac
  case "$(sleepy_l3_verdict Redmi ok 8022)" in unknown\ *) : ;; *) echo "smoke-test: FAIL (no candidate address must read UNKNOWN, never dark)"; rm -rf "$_sl"; exit 1 ;; esac
  # (j) END-TO-END, and it is arm (b)'s CONTROL: same fixture, same declaration, ONE thing changed —
  #     the address now answers. The declared-sleepy body must NOT board HOST-ASLEEP; it must board
  #     the ordinary alarm carrying what was measured. This is the live 23:15:24Z misclassification.
  rm -rf "$_sl/mesh"; mkdir -p "$_sl/mesh"
  _slout="$(_slrun 'Redmi' 127.0.0.1)"
  printf '%s' "$_slout" | grep -q 'HOST-ASLEEP' \
    && { echo "smoke-test: FAIL (a declared-sleepy body that ANSWERS L3 was still called HOST-ASLEEP — the exemption is still pure membership): $_slout"; rm -rf "$_sl"; exit 1; }
  printf '%s' "$_slout" | grep -q '\[health-fail\] Redmi' \
    || { echo "smoke-test: FAIL (an L3-alive body with a dead ssh transport boarded NOTHING — the declaration bought silence): $_slout"; rm -rf "$_sl"; exit 1; }
  printf '%s' "$_slout" | grep -q 'NOT-ASLEEP' \
    || { echo "smoke-test: FAIL (the alarm does not name WHY the sleep word was refused, so the reader cannot tell a dead phone from a dead sshd): $_slout"; rm -rf "$_sl"; exit 1; }
  [ -f "$_sl/mesh/.expected-down-Redmi" ] \
    && { echo "smoke-test: FAIL (a refused exemption still opened a sleep episode — its minutes would be learned as sleep)"; rm -rf "$_sl"; exit 1; }
  # (k) AND THE LEDGER REFUSES THE SAMPLE. An episode any cycle of which measured the body ALIVE is a
  #     transport gap, not a sleep sample: .sleepy-episodes must not grow. This is the entrance the
  #     original doctrine block left open — it guarded only the OVERDUE one — and the entrance the
  #     live fault used 6 times in 3h (.sleepy-episodes-Redmi = 10 10 51 10 20 51, all flap gaps).
  rm -f "$_sl/mesh/.sleepy-episodes-Redmi" "$_sl/mesh/.sleepy-overdue-Redmi"
  printf '%s\n' "$(( $(date +%s) - 3060 ))" > "$_sl/mesh/.expected-down-Redmi"
  MESH_DIR="$_sl/mesh" sleepy_notsleep_mark Redmi "alive:icmp-reply:192.168.8.203"
  [ "$(MESH_DIR="$_sl/mesh" sleepy_episode_close Redmi | awk '{print $1}')" = discarded-notsleep ] \
    || { echo "smoke-test: FAIL (an episode measured L3-ALIVE was closed as a normal sleep — the ledger still learns from the misclassification)"; rm -rf "$_sl"; exit 1; }
  [ "$(grep -c . "$_sl/mesh/.sleepy-episodes-Redmi" 2>/dev/null || echo 0)" = 0 ] \
    || { echo "smoke-test: FAIL (a not-asleep episode reached the sleep ledger anyway — the bound is still learned from the flap)"; rm -rf "$_sl"; exit 1; }
  [ -f "$_sl/mesh/.sleepy-notsleep-Redmi" ] \
    && { echo "smoke-test: FAIL (the not-asleep mark survived the close — a later genuine sleep could never be recorded)"; rm -rf "$_sl"; exit 1; }
  #     …and the control: the SAME close with no mark still records, so (k) is not passing by
  #     breaking recording outright.
  printf '%s\n' "$(( $(date +%s) - 3060 ))" > "$_sl/mesh/.expected-down-Redmi"
  [ "$(MESH_DIR="$_sl/mesh" sleepy_episode_close Redmi | awk '{print $1}')" = recorded ] \
    || { echo "smoke-test: FAIL (the unmarked control episode was not recorded — arm (k) proves nothing)"; rm -rf "$_sl"; exit 1; }
  # (f) an EMPTY declaration list matches nothing — the same fail-safe direction as host_is_household.
  ( MESH_WD_SLEEPY_HOSTS=""; host_is_sleepy Redmi ) \
    && { echo "smoke-test: FAIL (empty MESH_WD_SLEEPY_HOSTS matched a host — every fleet member would go quiet)"; rm -rf "$_sl"; exit 1; }
  ( MESH_WD_SLEEPY_HOSTS="Redmi,ilya"; host_is_sleepy ilya ) \
    || { echo "smoke-test: FAIL (comma-separated declaration list not honoured)"; rm -rf "$_sl"; exit 1; }
  rm -rf "$_sl"
  echo "smoke-test: ok (declared-sleepy bodies: an undeclared host still alarms [health-fail] (control), a DECLARED one boards [expected-down] HOST-ASLEEP once per episode publishing its bound and that bound's SOURCE, the same host past its own bound boards LOUD as ASLEEP-OVERDUE, an overdue episode is DISCARDED from the sleep ledger while a clean one is recorded, and an empty declaration list matches nothing; L3 EVIDENCE GATE: the sleep word is bought only by a MEASURED dark verdict — a body that answers ICMP or RSTs the ssh port boards the ordinary alarm tagged NOT-ASLEEP and its minutes never reach the sleep ledger, a dark reading with no self-coverage downgrades to unknown, and refused/unreachable/timeout are not collapsed)"
  exit 0
fi

INTERVAL="${2:-120}"
MESH_DIR="${MESH_DIR:-$HOME/.mesh}"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
# fleet-health dedup window: sized to THIS reflex's own cadence (a few loop INTERVALs) so a peer's
# post from the last few cycles dedupes silently — MESH_WATCHDOG_FLEET_DEDUP_WINDOW is the manual
# override for a node running a different --once cadence than its INTERVAL implies.
FLEET_DEDUP_WINDOW="${MESH_WATCHDOG_FLEET_DEDUP_WINDOW:-$((INTERVAL * 5))}"

trace() { echo "$(date -u +%Y-%m-%dT%H:%M:%SZ)  $(hostname)  ::  session-watchdog: $*" >> "$MESH_DIR/traces.log"; }

check_pane() {
    local win="$1" name="$2"
    local content pidx paneref
    pidx=$(tmux list-panes -t "$SESSION:$win" -F '#{pane_top} #{pane_index}' 2>/dev/null | sort -n | tail -1 | awk '{print $2}')
    paneref="$SESSION:$win${pidx:+.$pidx}"
    content=$(tmux capture-pane -t "$paneref" -p -S -15 2>/dev/null || true)
    command -v mesh-unstick >/dev/null 2>&1 && MESH_UNSTICK_QUIET=1 mesh-unstick "$SESSION" 2>/dev/null || true
    # Detect a BLOCKED mind: a limit/auth wall AND the pane is STATIC (frozen). The static check is
    # essential — a working/steward pane that merely DISCUSSES limits (commits, this very fix) matches
    # the words but is CHANGING; a truly blocked mind is frozen. Match only the visible/active region
    # (last lines, where a real dialog sits), require it unchanged across ~2s, then alert ONCE.
    local flag="$MESH_DIR/.wd-blocked-$name" active second ms
    active=$(printf '%s\n' "$content" | tail -6)
    # specific blocking-UI strings (not generic prose): the actual Claude/agent limit+auth walls
    if printf '%s\n' "$active" | grep -qiE "$MESH_RL_RE|$MESH_AUTH_RE"; then
        sleep 2; second=$(tmux capture-pane -t "$paneref" -p -S -15 2>/dev/null | tail -6 || true)
        if [ "$active" = "$second" ]; then   # STATIC = genuinely frozen, not a working pane
            # Cross-check with mesh-mind-state: if the pane is WORKING or IDLE the RL text
            # is stale (mind recovered — idle ❯ prompt sits below the wall text that triggered
            # the regex). A stale-but-matching pane was the false-alert class at 10:17–10:21Z
            # (chat-review 2026-06-15): watchdog fired [mind-blocked] 2 min after mind-state
            # had already declared the window IDLE. Skip and re-arm; do NOT alert.
            if command -v mesh-mind-state >/dev/null 2>&1; then
                # mesh-mind-state expects a window NAME (e.g. "dev"), not a full pane ref
                # (e.g. "hostname:9.1"). peek_win() builds "$(hostname):$win" internally, so
                # passing the full paneref makes it "hostname:hostname:9.1" → ABSENT → suppress
                # never fires (de3f281 bug). Pass $name (the window name from list-windows).
                ms="$(mesh-mind-state "$name" 2>/dev/null | cut -f1 || echo UNKNOWN)"
                if [ "$ms" = "WORKING" ] || [ "$ms" = "IDLE" ]; then
                    rm -f "$flag" 2>/dev/null; return 0
                fi
            fi
            if [ ! -f "$flag" ]; then
                # CLASSIFY the wall, mirroring mesh-mind-state's taxonomy (inter-tool consistency):
                #   QUOTA/usage wall  -> [mind-limited]: resets or provision, NOT an operator-approvable
                #     gate. Lumping it under [mind-blocked]+'steward check' provokes a no-op operator
                #     escalation on the already-known quota stall (the churn this whole reflex caused).
                #   AUTH/login/context-wedge -> [mind-blocked]: a real steward/operator action (re-auth,
                #     /compact, restart).
                if printf '%s\n' "$active" | grep -qiE "$MESH_RL_RE"; then
                    trace "LIMITED [$name] static quota/usage wall — mind quota-walled"
                    if quota_wave_active; then
                      trace "LIMITED [$name] post suppressed (channel-keepalive quota-wave active — one summary already posted)"
                    elif wd_should_post "$name" limited; then
                      command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="watchdog@$(hostname)" \
                        mesh-chat "[mind-limited] $(hostname):$name — quota/usage wall (resets or provision; route work elsewhere — NOT an operator gate)." >/dev/null 2>&1
                    else
                      trace "LIMITED [$name] repost suppressed (<${WD_COOLDOWN}s since last board post)"
                    fi
                else
                    trace "BLOCKED [$name] static auth/context wall — mind stalled"
                    if wd_should_post "$name" blocked; then
                      command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="watchdog@$(hostname)" \
                        mesh-chat "[mind-blocked] $(hostname):$name — frozen on an auth/context wall (login/oauth/context-full). steward check." >/dev/null 2>&1
                    else
                      trace "BLOCKED [$name] repost suppressed (<${WD_COOLDOWN}s since last board post)"
                    fi
                fi
                touch "$flag"
            fi
        fi
    else
        rm -f "$flag" 2>/dev/null   # wall cleared — re-arm
    fi
}

trace "watchdog cycle starting (session=$SESSION interval=${INTERVAL}s)"

while true; do
    tmux list-windows -t "$SESSION" -F '#{window_index}|#{window_name}' \
        2>/dev/null | while IFS='|' read -r win name; do
        check_pane "$win" "$name"
    done

    # Restart any declared systemd user services that are down (skip if unit file absent).
    # NOTE: proxy-bot.service is intentionally NOT here — it polls Telegram getUpdates on the
    # same bot token as mesh-voice-rx, and two pollers conflict (409), silently eating operator
    # messages. The token belongs solely to mesh-voice-rx now. (proxy-bot retired 2026-06-13.)
    # mesh-room-speech.service (chat-review/room-speech-clean-stop-unwatched, 2026-07-05): the
    # wake-word "ear" (mesh-overhear --watch-wake, lives on the mic node e.g. default-string).
    # Its unit sets Restart=on-failure, which does NOT cover a clean SIGTERM/exit-0 stop — root
    # cause of the ear going silent for hours (room@ verified this twice in one day). This
    # external check is the belt to that unit's on-failure suspenders: restarts on ANY down state,
    # and — unlike a bare systemd Restart=, which is invisible to the mesh — traces + board-posts
    # so a repeat clean-stop is visible instead of silently self-healing into invisibility.
    for svc in ngrok.service mesh-room-speech.service; do
        [ -f "$HOME/.config/systemd/user/$svc" ] || continue
        if ! systemctl --user is-active "$svc" &>/dev/null; then
            trace "SERVICE $svc not active — restarting"
            systemctl --user restart "$svc" 2>/dev/null || trace "SERVICE $svc restart FAILED"
            if [ "$svc" = "mesh-room-speech.service" ] && wd_should_post room-speech restarted; then
                command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="watchdog@$(hostname)" \
                    mesh-chat "[ear-restarted] $(hostname): mesh-room-speech.service was down (clean-stop not covered by Restart=on-failure) — watchdog restarted it" >/dev/null 2>&1
            fi
        fi
    done

    # mesh-health integration: detect node internet failures (edge-triggered, per-node state)
    if [ "$WATCHDOG_FLEET" = 1 ] && command -v mesh-health >/dev/null 2>&1; then
        health_out=""; health_dir="$MESH_DIR/.health-state"
        mkdir -p "$health_dir"
        health_out=$(mesh-health 2>/dev/null) || true
        # HOST-DARK: is the household dark THIS cycle? Computed ONCE, and only when household hosts are
        # configured — a non-household node (empty list) never pays the mesh-home-state read.
        hh_dark=""
        if [ -n "$MESH_HOUSEHOLD_HOSTS" ] && command -v mesh-home-state >/dev/null 2>&1; then
            # On-demand READ, not the tick's writer (see mesh-home-state:_hs_persist).
            _hs_tok=$(MESH_HOME_MARGIN_APPEND=0 MESH_HOME_STATE_PERSIST=0 mesh-home-state 2>/dev/null | sed -nE 's/^\[home-state\] ([A-Z_]+).*/\1/p')
            household_token_is_dark "$_hs_tok" && hh_dark=1
        fi
        # COVERAGE for the sleepy L3 probe, computed ONCE per pass: is THIS node's own L3 working
        # right now? Bound to the (self) marker mesh-health prints, not to a hostname that ages out.
        sl_cov=na
        printf '%s\n' "$health_out" | awk '$1=="PASS" && /\(self\)/{f=1} END{exit !f}' && sl_cov=ok
        while read -r result host rest; do
            hline="$result $host $rest"
            # FAIL/PASS = reachable (no-internet / ok). OFFLINE (mesh-health:164) = tailscaled down + no LAN
            # fallback — a worse, hard-unreachable condition that previously hit `continue` → zero board signal
            # while a stale [health-fail] sat frozen (chat-review/watchdog-offline-code-unhandled). LAN = the
            # partial-recovery path, routed through health_step's recovery branch so an OFF/FAIL alarm clears
            # instead of stranding. SKIP (ssh-unreachable while tailscale still reports Online — mesh-health:116)
            # used to `continue` here forever, a PERMANENT blind spot: a real, hours-long outage (tailscale
            # hasn't deregistered the frozen node yet) produced zero [health-fail]/[health-ok] the whole time
            # (chat-review/watchdog-skip-never-alerts 2026-07-04 — default-string's real 62min outage, caught
            # only by node-care, not this watchdog). Now routed through health_step exactly like FAIL (same
            # debounce, same postfail/postok wording via $rest) so a short SSH blip still recovers silently but
            # a SUSTAINED SKIP posts once past HEALTH_DEBOUNCE, same as a real no-internet FAIL.
            case "$result" in FAIL|PASS|OFFLINE|LAN|SKIP) ;; *) continue ;; esac
            # HOST-DARK expected-down: a household-hosted node unreachable while home is dark is the
            # human's desktop off for the night, NOT a tailscaled/mesh fault → [expected-down] once per
            # episode (label HOST-DARK), trace-only after, cross-watchdog deduped. A reachable/LAN result
            # or awake hours (hh_dark empty) falls through to the normal health_step alarm below.
            if [ -n "$hh_dark" ] && host_is_household "$host" && is_unreachable_result "$result"; then
                plan=$(expected_down_plan "$host")
                case "$plan" in
                    post)
                        trace "HEALTH EXPECTED-DOWN: $host HOST-DARK ($result $rest) — household desktop off while home-state dark; posting once/episode"
                        command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="watchdog@$(hostname)" \
                            mesh-chat "[expected-down] $host — HOST-DARK (household-hosted desktop unreachable while home-state is dark; nightly, not a tailscaled/mesh fault) [$result]" >/dev/null 2>&1 ;;
                    *)  trace "HEALTH EXPECTED-DOWN: $host HOST-DARK ($result) — $plan (episode announced or peer boarded <$((MESH_EXPECTED_DOWN_DEDUP_S/60))min ago)" ;;
                esac
                expected_down_wake_reset "$host"       # dark again → any pending wake streak is broken
                echo "EXPDOWN" > "$health_dir/$host"   # neutral, non-posted state → a later true PASS recovers silently
                continue
            fi
            # HH-DARK flap guard (chat-review/watchdog-expected-down-survives-homestate-flap, 2 days stranded):
            # host STILL unreachable but home-state read non-dark THIS cycle while an expected-down episode is
            # active. A SINGLE non-dark cycle is a home-state UNCERTAIN blip (its own hysteresis fix cfd1727
            # didn't cover the watchdog side) — the desktop is simply still off, NOT freshly woken. Hold the
            # episode (trace-only, no clear, no alarm) until non-dark sustains MESH_HH_WAKE_DEBOUNCE cycles;
            # only then does a genuinely-awake host that is STILL down fall through to the real [health-fail].
            # This kills the 07:33 [expected-down]→07:37 [health-fail] one-cycle-apart cry-wolf on ilya.
            if [ -f "${MESH_DIR:-$HOME/.mesh}/.expected-down-$host" ] \
               && host_is_household "$host" && is_unreachable_result "$result"; then
                case "$(expected_down_wake_step "$host")" in
                    hold)
                        trace "HEALTH EXPECTED-DOWN: $host HOST-DARK held ($result) — home-state non-dark 1 cycle (UNCERTAIN flap); episode kept, awaiting sustained wake before re-alarm"
                        echo "EXPDOWN" > "$health_dir/$host"; continue ;;
                    clear) : ;;   # non-dark sustained ≥ debounce → genuine wake, fall through to clear + alarm
                esac
            fi
            # DECLARED-SLEEPY body: an unreachable cycle on a host that DECLARES an expected-asleep
            # discipline is not an incident, it is the discipline. Board [expected-down] HOST-ASLEEP
            # once per episode, TRACE every edge after (the sleep/wake cadence is the body-battery
            # signal body-power already reads — the tape must keep every edge), and hold a neutral
            # EXPDOWN state so the later wake recovers silently. THE ESCAPE HATCH IS LOUD, NOT SILENT:
            # once the episode runs past this host's own derived bound the declaration is spent and
            # the cycle falls through to the real [health-fail] below, tagged ASLEEP-OVERDUE and
            # carrying the bound AND the source that produced it.
            sl_keep=0
            if host_is_sleepy "$host" && is_unreachable_result "$result"; then
                # THE DECLARATION IS A PERMISSION TO MEASURE, NOT A VERDICT. Before the sleep word is
                # spent, place the subject inside the excusing window with evidence independent of the
                # transport that failed (see the L3 EVIDENCE block above). Only `dark` buys silence.
                sl_port="$(sleepy_ssh_port "$hline")"
                read -r sl_verdict sl_ev <<<"$(sleepy_l3_verdict "$host" "$sl_cov" "$sl_port" $(sleepy_addrs "$host" "$hline"))"
            else
                sl_verdict='' sl_ev=''
            fi
            if [ "$sl_verdict" = alive ] || [ "$sl_verdict" = unknown ]; then
                # NOT ASLEEP (or not placeable). This is the flapping-Termux case the exemption was
                # misreading: the body answers L3, its ssh daemon does not. Mark the episode so its
                # duration can never be learned as a sleep sample, then fall through to the ordinary
                # alarm path — HEALTH_DEBOUNCE and fleet_dedup_post still apply, so a short blip stays
                # quiet and a sustained one boards ONCE, tagged with what was actually measured.
                sleepy_notsleep_mark "$host" "$sl_verdict:$sl_ev"
                trace "HEALTH NOT-ASLEEP: $host ($result $rest) — declared-sleepy, but L3 reads $sl_verdict ($sl_ev) — the body is up, its ssh transport is not; exemption REFUSED, episode will not be recorded as sleep"
                rest="$rest — NOT-ASLEEP: declared-sleepy body reads L3 $sl_verdict ($sl_ev) while ssh is down — host up, ssh transport down, NOT the declared sleep discipline"
            elif [ "$sl_verdict" = dark ]; then
                sl_el="$(sleepy_elapsed_min "$host" || echo 0)"
                read -r sl_bound sl_src sl_n <<<"$(sleepy_bound_min "$host")"
                if [ "$sl_el" -le "$sl_bound" ] 2>/dev/null; then
                    plan=$(expected_down_plan "$host")
                    case "$plan" in
                        post)
                            trace "HEALTH EXPECTED-DOWN: $host HOST-ASLEEP ($result $rest) — declared-sleepy body MEASURED dark ($sl_ev), ${sl_el}m into the episode, bound ${sl_bound}m ($sl_src n=$sl_n); posting once/episode"
                            command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="watchdog@$(hostname)" \
                                mesh-chat "[expected-down] $host — HOST-ASLEEP (declared expected-asleep body, and MEASURED dark this cycle: $sl_ev — L3 evidence independent of the failed ssh transport). Alarms if still down past ${sl_bound}m (bound source: $sl_src, n=$sl_n) [$result]" >/dev/null 2>&1 ;;
                        *)  trace "HEALTH EXPECTED-DOWN: $host HOST-ASLEEP ($result) — ${sl_el}m/${sl_bound}m ($sl_src n=$sl_n) — $plan" ;;
                    esac
                    echo "EXPDOWN" > "$health_dir/$host"   # neutral, non-posted → a later PASS recovers silently
                    continue
                fi
                # OVERDUE: past its own longest observed sleep. Mark the episode so its duration is
                # NEVER recorded as a sleep sample (a fault must not widen the bound that finds it),
                # then fall through to the ordinary alarm path with the reason carried in $rest.
                sleepy_overdue_mark "$host"
                # KEEP THE EPISODE OPEN. Tearing it down here would restart the clock at 0 on the very
                # next cycle, so elapsed could never exceed the bound twice running and the host would
                # oscillate expected-down/overdue forever without ever clearing HEALTH_DEBOUNCE — the
                # alarm would be reachable in principle and unreachable in practice. Found by the
                # end-to-end arm below, not by reading this. The episode closes on RECOVERY only.
                sl_keep=1
                trace "HEALTH ASLEEP-OVERDUE: $host ($result $rest) — ${sl_el}m unreachable, past bound ${sl_bound}m ($sl_src n=$sl_n) — declaration spent, alarming"
                rest="$rest — ASLEEP-OVERDUE: declared-sleepy body unreachable ${sl_el}m, past its own bound ${sl_bound}m (source $sl_src, n=$sl_n)"
            fi
            if [ "$sl_keep" != 1 ]; then
                # The close OUTCOME is traced, never swallowed: recorded / discarded (overdue) /
                # discarded-notsleep are three different facts about the ledger, and a ledger that
                # silently refuses a sample is indistinguishable from one that never saw it.
                sl_close="$(sleepy_episode_close "$host")"
                case "$sl_close" in none) : ;; *) trace "HEALTH SLEEPY-LEDGER: $host — $sl_close" ;; esac
                expected_down_clear "$host"   # reachable OR sustained-awake → episode over; a real fail alarms below
            fi
            prev=$(cat "$health_dir/$host" 2>/dev/null || echo "")
            read -r newstate act < <(health_step "$prev" "$result" "$HEALTH_DEBOUNCE")
            case "$act" in
                postfail)
                    trace "HEALTH FAIL: $host $rest (debounce ${HEALTH_DEBOUNCE} reached)"
                    fleet_dedup_post "[health-fail] $host" "[health-fail] $host — $rest" \
                        "$FLEET_DEDUP_WINDOW" "$MESH_DIR/chat.log" ;;
                postoffline)
                    # 'tailscaled down' was an INVENTED cause here (health-lan-fallback-invents-
                    # tailscaled-down): mesh-health measures not-on-tailnet, never WHY. $rest now
                    # carries the measured facts (last-seen age, active) — post those, no diagnosis.
                    trace "HEALTH OFFLINE: $host $rest — not on tailnet + no LAN fallback (worse than no-internet)"
                    if [ "$(chronic_offtailnet_plan "$host" "$(chronic_lastseen_days "$rest")" "$MESH_WD_CHRONIC_DAYS")" = quiet ]; then
                        trace "HEALTH OFFLINE CHRONIC: $host $rest — off-tailnet ≥${MESH_WD_CHRONIC_DAYS}d, already boarded this episode → trace-tier (watchdog-chronic-offtailnet-peer-flap)"
                    else
                        fleet_dedup_post "[health-fail] $host" "[health-fail] $host — UNREACHABLE ($rest — not on tailnet + no LAN fallback, worse than no-internet)" \
                            "$FLEET_DEDUP_WINDOW" "$MESH_DIR/chat.log"
                    fi ;;
                postpartial)
                    # LAN-only: box pingable, not on tailnet → tailnet-SSH admin path LOST. A degraded
                    # state, NOT a clean recovery (chat-review/watchdog-hollow-recovery).
                    trace "HEALTH PARTIAL: $host $rest — LAN-only, tailnet-SSH admin path lost"
                    if [ "$(chronic_offtailnet_plan "$host" "$(chronic_lastseen_days "$rest")" "$MESH_WD_CHRONIC_DAYS")" = quiet ]; then
                        trace "HEALTH PARTIAL CHRONIC: $host $rest — off-tailnet ≥${MESH_WD_CHRONIC_DAYS}d, already boarded this episode → trace-tier (watchdog-chronic-offtailnet-peer-flap)"
                    else
                        fleet_dedup_post "[health-partial] $host" "[health-partial] $host — LAN-only ($rest); tailnet-SSH admin path LOST — box pingable, NOT mesh-administrable" \
                            "$FLEET_DEDUP_WINDOW" "$MESH_DIR/chat.log"
                    fi ;;
                postok)
                    # post recovery to the BOARD too (not just the trace): a [health-fail] with no
                    # board-visible recovery strands a resolved alarm → other minds think the node is
                    # still down (the same stale-alarm class fixed for mesh-doctor's RECOVERED, 2026-06-12).
                    trace "HEALTH RECOVERED: $host $rest"
                    chronic_offtailnet_clear "$host"   # true recovery (back on tailnet / last-seen fresh) → re-arm the chronic episode so a future absence boards once again
                    fleet_dedup_post "[health-ok] $host" "[health-ok] $host — RECOVERED ($rest)" \
                        "$FLEET_DEDUP_WINDOW" "$MESH_DIR/chat.log" ;;
                silent)
                    { [ "$result" = FAIL ] || [ "$result" = SKIP ]; } && \
                        trace "HEALTH $result(debounce, $newstate): $host $rest — transient, not yet posted" ;;
            esac
            # Part 2: a peer stuck LAN-only (tailscale-unreachable while its box answers LAN) posts
            # [health-partial] ONCE then holds silent — re-WARN by duration so a multi-day hollow
            # split (the router's 16d) does not vanish after the first alarm. Only PART re-warns
            # (that IS the "LAN shows the box alive" condition); any other state clears the sentinel.
            case "$newstate" in
                PART:*)
                    if age_h=$(fleet_stale_should_warn "$host"); then
                        trace "FLEET STALE: $host tailscale-unreachable ~${age_h}h while LAN alive"
                        command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="watchdog@$(hostname)" \
                            mesh-chat "[fleet-stale] $host — tailscale-unreachable ~${age_h}h while LAN shows the box ALIVE (hollow split) — check tailscaled on the node" >/dev/null 2>&1
                    fi ;;
                *) fleet_stale_clear "$host" ;;
            esac
            echo "$newstate" > "$health_dir/$host"
        done <<< "$health_out"
    fi

    # --edge/--once: one pass done → exit (explicit if, NOT '&& break' — under set -e a false test
    # would exit the whole script). Continuous mode falls through to the interval sleep.
    if [ "$ONCE" = 1 ]; then trace "single-pass (--edge) cycle complete"; break; fi
    sleep "$INTERVAL"
done
