#!/usr/bin/env bash
# mesh-session-watchdog — watch the hostname-named tmux session for stuck panes and
# dead systemd user services; restart what it can, trace what it can't.
# smoke-test: --test checks tmux session exists + services dir reachable
#
#   mesh-session-watchdog [session] [interval_sec]    continuous loop (supervised default)
#   mesh-session-watchdog --edge|--once [session]      ONE check cycle then exit (the */10 cron backup path)
#   mesh-session-watchdog --test
#
# Runs as a loop (put it in a tmux window or supervise.list).
# systemd user-service checks only fire for units that actually exist on this node.
set -euo pipefail
export PATH="$HOME/.local/bin:$PATH"

# canonical wall/auth regex (DRY — knowledge/inter-tool-inconsistency-canonical-definitions-2026-06-14):
# source shared MESH_RL_RE (quota→[mind-limited]) + MESH_AUTH_RE (auth/context→[mind-blocked]),
# inline fallback if not deployed. Replaces this tool's private regexes (which carried 'Esc to cancel'
# — a GATE not a wall, mis-classified as auth — and 'token limit' not in the curated canonical).
[ -r "$HOME/.local/bin/mesh-patterns.sh" ] && . "$HOME/.local/bin/mesh-patterns.sh" 2>/dev/null
: "${MESH_RL_RE:=hit your (usage|session) limit|usage limit reached|rate.?limit|429|too many requests|quota.*(exhaust|exceed)|out of credits|purchase more credits|upgrade to (pro|team)|try again (at|later|in)|resets? (at )?[0-9]|overloaded}"
: "${MESH_AUTH_RE:=login.*required|oauth.*required|please (log|sign) ?in|authentication required|100% context (used|left)|context (full|exhausted)|/login}"

# Per-mind repost cooldown (chat-review 2026-06-17): the static-flag below re-arms whenever the
# wall scrolls out of the last-6-line window or a transient IDLE cross-check clears it, so a rapid
# clear/re-block flap re-alerted the SAME hours-old wall every 5-20min (watchdog flooded 'dev':
# 16:46/16:55/17:26/17:35). This time guard caps a given mind+kind to ONE board post per
# MESH_WD_REPOST_COOLDOWN (default 1800s) regardless of flag churn — the live block state is still
# visible via mesh-mind-state, so capping the board post loses no signal, only the noise.
WD_COOLDOWN="${MESH_WD_REPOST_COOLDOWN:-1800}"
# DEBOUNCE for the mesh-health internet probe: a SINGLE cycle's [health-fail] is unreliable for SELF —
# at the top-of-hour cron storm (e.g. ~01:00, where hourly+daily+*/N jobs align) the local machine can
# be too load-starved to service ping -c2/curl -m6 within their timeouts, so BOTH probes 'fail' though
# internet is fine → a false self [health-fail] that recovers next cycle (observed daily ~01:00, also
# ds/ilya). A REAL outage persists across cycles. Require N consecutive FAILs before the operator-visible
# board post; a blip that recovers within one INTERVAL never reaches the board (kills the cry-wolf that
# trains minds to ignore [health-fail]). Trace tier still records every cycle.
HEALTH_DEBOUNCE="${MESH_WD_HEALTH_DEBOUNCE:-2}"
wd_should_post() {  # $1=window name  $2=kind(blocked|limited) → exit 0 = post, 1 = suppress
  local d="${MESH_DIR:-$HOME/.mesh}" now last ts
  ts="$d/.wd-postts-$2-$1"
  now=$(date +%s 2>/dev/null || echo 0)
  if [ -f "$ts" ]; then
    last=$(cat "$ts" 2>/dev/null || echo 0)
    if [ $(( now - ${last:-0} )) -lt "$WD_COOLDOWN" ]; then return 1; fi
  fi
  printf '%s\n' "$now" > "$ts" 2>/dev/null || true
  return 0
}

# health_step <prev-state> <result FAIL|PASS> <debounce> -> "<new-state> <action>"  (PURE — dry-runnable,
# the reason the debounce can be --test'd without a live mesh-health run). state = "FAIL:<count>:<posted>";
# legacy bare "FAIL"/"PASS" migrate. action: postfail | postok | silent.
health_step() {
  local prev="$1" result="$2" deb="$3" cnt posted act
  if [ "$result" = FAIL ]; then
    case "$prev" in
      FAIL:*) cnt=${prev#FAIL:}; posted=${cnt#*:}; cnt=${cnt%%:*} ;;
      FAIL)   cnt=$deb; posted=1 ;;          # legacy: old logic already posted on cycle 1
      *)      cnt=0; posted=0 ;;
    esac
    cnt=$((cnt+1)); act=silent
    if [ "$cnt" -ge "$deb" ] && [ "$posted" != 1 ]; then act=postfail; posted=1; fi
    echo "FAIL:$cnt:$posted $act"
  else
    case "$prev" in
      FAIL:*) posted=${prev##*:} ;;
      FAIL)   posted=1 ;;                     # legacy posted-fail → recover (don't strand the alarm)
      *)      posted=0 ;;
    esac
    [ "$posted" = 1 ] && act=postok || act=silent   # recover only if we actually posted a [health-fail]
    echo "PASS $act"
  fi
}

# --edge / --once: run ONE check cycle then exit (the */10 cron backup path). Parse + shift BEFORE
# SESSION= so the flag is never mistaken for a session name — that was the watchdog-edge-noop bug:
# the cron's '--edge' became SESSION="${1:-...}", so the watchdog watched a nonexistent session and
# was a silent no-op every 10min while looking like a backup. The supervised no-arg loop is unaffected.
ONCE=0
case "${1:-}" in --edge|--once) ONCE=1; shift ;; esac

SESSION="${1:-$(hostname)}"
if [ "${1:-}" = --test ]; then
  tmux has-session -t "$(hostname)" 2>/dev/null || { echo "smoke-test: FAIL (no session)"; exit 1; }
  command -v mesh-unstick >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-unstick)"; exit 1; }
  # dry-run the repost cooldown (falsifiable): 1st post allowed, immediate 2nd suppressed, an aged
  # sentinel re-allows. Temp MESH_DIR so it never touches live state. A regression here = the flood
  # comes back (or worse, all alerts suppressed) — exactly what this test must catch.
  _td=$(mktemp -d) || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
  MESH_DIR="$_td" wd_should_post dev blocked || { echo "smoke-test: FAIL (cooldown suppressed the FIRST post)"; rm -rf "$_td"; exit 1; }
  if MESH_DIR="$_td" wd_should_post dev blocked; then echo "smoke-test: FAIL (cooldown did NOT suppress an immediate repost)"; rm -rf "$_td"; exit 1; fi
  echo 0 > "$_td/.wd-postts-blocked-dev"   # age the sentinel past the window
  MESH_DIR="$_td" wd_should_post dev blocked || { echo "smoke-test: FAIL (cooldown did not re-allow after the window elapsed)"; rm -rf "$_td"; exit 1; }
  # distinct kind/mind must be independent (not share a counter)
  MESH_DIR="$_td" wd_should_post plan limited || { echo "smoke-test: FAIL (cooldown leaked across mind+kind)"; rm -rf "$_td"; exit 1; }
  rm -rf "$_td"
  # health_step debounce state machine (the 2026-06-21 [health-fail] de-flap): a transient blip (1 FAIL
  # then recover) must be SILENT both ways; a real outage (≥DEBOUNCE consecutive) posts once + recovers;
  # legacy bare-FAIL migrates without re-posting or stranding. A regression here = the daily ~01:00 self
  # cry-wolf returns, OR a real outage goes unannounced.
  hf=0
  [ "$(health_step PASS FAIL 2)"     = "FAIL:1:0 silent" ]   || { echo "FAIL health_step: blip cycle1 should be silent"; hf=1; }
  [ "$(health_step FAIL:1:0 PASS 2)" = "PASS silent" ]       || { echo "FAIL health_step: debounced blip must recover silently (no post)"; hf=1; }
  [ "$(health_step FAIL:1:0 FAIL 2)" = "FAIL:2:1 postfail" ] || { echo "FAIL health_step: 2nd consecutive must post"; hf=1; }
  [ "$(health_step FAIL:2:1 FAIL 2)" = "FAIL:3:1 silent" ]   || { echo "FAIL health_step: already-posted must not re-post"; hf=1; }
  [ "$(health_step FAIL:3:1 PASS 2)" = "PASS postok" ]       || { echo "FAIL health_step: real outage must post recovery"; hf=1; }
  [ "$(health_step FAIL PASS 2)"     = "PASS postok" ]       || { echo "FAIL health_step: legacy bare-FAIL must recover (no strand)"; hf=1; }
  [ "$(health_step FAIL FAIL 2)"     = "FAIL:3:1 silent" ]   || { echo "FAIL health_step: legacy bare-FAIL must not re-post"; hf=1; }
  [ "$hf" = 0 ] || { echo "smoke-test: FAIL (health_step debounce regressed)"; exit 1; }
  echo "smoke-test: ok (repost-cooldown + health_step debounce verified)"; exit 0
fi

INTERVAL="${2:-120}"
MESH_DIR="${MESH_DIR:-$HOME/.mesh}"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

trace() { echo "$(date -u +%Y-%m-%dT%H:%M:%SZ)  $(hostname)  ::  session-watchdog: $*" >> "$MESH_DIR/traces.log"; }

check_pane() {
    local win="$1" name="$2"
    local content pidx paneref
    pidx=$(tmux list-panes -t "$SESSION:$win" -F '#{pane_top} #{pane_index}' 2>/dev/null | sort -n | tail -1 | awk '{print $2}')
    paneref="$SESSION:$win${pidx:+.$pidx}"
    content=$(tmux capture-pane -t "$paneref" -p -S -15 2>/dev/null || true)
    command -v mesh-unstick >/dev/null 2>&1 && MESH_UNSTICK_QUIET=1 mesh-unstick "$SESSION" 2>/dev/null || true
    # Detect a BLOCKED mind: a limit/auth wall AND the pane is STATIC (frozen). The static check is
    # essential — a working/steward pane that merely DISCUSSES limits (commits, this very fix) matches
    # the words but is CHANGING; a truly blocked mind is frozen. Match only the visible/active region
    # (last lines, where a real dialog sits), require it unchanged across ~2s, then alert ONCE.
    local flag="$MESH_DIR/.wd-blocked-$name" active second ms
    active=$(printf '%s\n' "$content" | tail -6)
    # specific blocking-UI strings (not generic prose): the actual Claude/agent limit+auth walls
    if printf '%s\n' "$active" | grep -qiE "$MESH_RL_RE|$MESH_AUTH_RE"; then
        sleep 2; second=$(tmux capture-pane -t "$paneref" -p -S -15 2>/dev/null | tail -6 || true)
        if [ "$active" = "$second" ]; then   # STATIC = genuinely frozen, not a working pane
            # Cross-check with mesh-mind-state: if the pane is WORKING or IDLE the RL text
            # is stale (mind recovered — idle ❯ prompt sits below the wall text that triggered
            # the regex). A stale-but-matching pane was the false-alert class at 10:17–10:21Z
            # (chat-review 2026-06-15): watchdog fired [mind-blocked] 2 min after mind-state
            # had already declared the window IDLE. Skip and re-arm; do NOT alert.
            if command -v mesh-mind-state >/dev/null 2>&1; then
                # mesh-mind-state expects a window NAME (e.g. "dev"), not a full pane ref
                # (e.g. "hostname:9.1"). peek_win() builds "$(hostname):$win" internally, so
                # passing the full paneref makes it "hostname:hostname:9.1" → ABSENT → suppress
                # never fires (de3f281 bug). Pass $name (the window name from list-windows).
                ms="$(mesh-mind-state "$name" 2>/dev/null | cut -f1 || echo UNKNOWN)"
                if [ "$ms" = "WORKING" ] || [ "$ms" = "IDLE" ]; then
                    rm -f "$flag" 2>/dev/null; return 0
                fi
            fi
            if [ ! -f "$flag" ]; then
                # CLASSIFY the wall, mirroring mesh-mind-state's taxonomy (inter-tool consistency):
                #   QUOTA/usage wall  -> [mind-limited]: resets or provision, NOT an operator-approvable
                #     gate. Lumping it under [mind-blocked]+'steward check' provokes a no-op operator
                #     escalation on the already-known quota stall (the churn this whole reflex caused).
                #   AUTH/login/context-wedge -> [mind-blocked]: a real steward/operator action (re-auth,
                #     /compact, restart).
                if printf '%s\n' "$active" | grep -qiE "$MESH_RL_RE"; then
                    trace "LIMITED [$name] static quota/usage wall — mind quota-walled"
                    if wd_should_post "$name" limited; then
                      command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="watchdog@$(hostname)" \
                        mesh-chat "[mind-limited] $(hostname):$name — quota/usage wall (resets or provision; route work elsewhere — NOT an operator gate)." >/dev/null 2>&1
                    else
                      trace "LIMITED [$name] repost suppressed (<${WD_COOLDOWN}s since last board post)"
                    fi
                else
                    trace "BLOCKED [$name] static auth/context wall — mind stalled"
                    if wd_should_post "$name" blocked; then
                      command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="watchdog@$(hostname)" \
                        mesh-chat "[mind-blocked] $(hostname):$name — frozen on an auth/context wall (login/oauth/context-full). steward check." >/dev/null 2>&1
                    else
                      trace "BLOCKED [$name] repost suppressed (<${WD_COOLDOWN}s since last board post)"
                    fi
                fi
                touch "$flag"
            fi
        fi
    else
        rm -f "$flag" 2>/dev/null   # wall cleared — re-arm
    fi
}

trace "watchdog cycle starting (session=$SESSION interval=${INTERVAL}s)"

while true; do
    tmux list-windows -t "$SESSION" -F '#{window_index}|#{window_name}' \
        2>/dev/null | while IFS='|' read -r win name; do
        check_pane "$win" "$name"
    done

    # Restart any declared systemd user services that are down (skip if unit file absent).
    # NOTE: proxy-bot.service is intentionally NOT here — it polls Telegram getUpdates on the
    # same bot token as mesh-voice-rx, and two pollers conflict (409), silently eating operator
    # messages. The token belongs solely to mesh-voice-rx now. (proxy-bot retired 2026-06-13.)
    for svc in ngrok.service; do
        [ -f "$HOME/.config/systemd/user/$svc" ] || continue
        if ! systemctl --user is-active "$svc" &>/dev/null; then
            trace "SERVICE $svc not active — restarting"
            systemctl --user restart "$svc" 2>/dev/null || trace "SERVICE $svc restart FAILED"
        fi
    done

    # mesh-health integration: detect node internet failures (edge-triggered, per-node state)
    if command -v mesh-health >/dev/null 2>&1; then
        health_out=""; health_dir="$MESH_DIR/.health-state"
        mkdir -p "$health_dir"
        health_out=$(mesh-health 2>/dev/null) || true
        while read -r result host rest; do
            case "$result" in FAIL|PASS) ;; *) continue ;; esac
            prev=$(cat "$health_dir/$host" 2>/dev/null || echo "")
            read -r newstate act < <(health_step "$prev" "$result" "$HEALTH_DEBOUNCE")
            case "$act" in
                postfail)
                    trace "HEALTH FAIL: $host $rest (debounce ${HEALTH_DEBOUNCE} reached)"
                    command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="watchdog@$(hostname)" \
                        mesh-chat "[health-fail] $host — $rest" >/dev/null 2>&1 ;;
                postok)
                    # post recovery to the BOARD too (not just the trace): a [health-fail] with no
                    # board-visible recovery strands a resolved alarm → other minds think the node is
                    # still down (the same stale-alarm class fixed for mesh-doctor's RECOVERED, 2026-06-12).
                    trace "HEALTH RECOVERED: $host $rest"
                    command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="watchdog@$(hostname)" \
                        mesh-chat "[health-ok] $host — RECOVERED ($rest)" >/dev/null 2>&1 ;;
                silent)
                    [ "$result" = FAIL ] && trace "HEALTH FAIL(debounce, $newstate): $host $rest — transient, not yet posted" ;;
            esac
            echo "$newstate" > "$health_dir/$host"
        done <<< "$health_out"
    fi

    # --edge/--once: one pass done → exit (explicit if, NOT '&& break' — under set -e a false test
    # would exit the whole script). Continuous mode falls through to the interval sleep.
    if [ "$ONCE" = 1 ]; then trace "single-pass (--edge) cycle complete"; break; fi
    sleep "$INTERVAL"
done
