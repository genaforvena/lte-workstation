#!/usr/bin/env bash
# mesh-rom-gate — THE shared runner for uxn gate-class ROM organs.
# Spec: docs/superpowers/specs/2026-07-23-uxn-predicate-engine-design.md §1-2 (operator-approved).
#
# One tool marshals `<rom> args…` → runs the ROM under the node-built uxncli → prints the ROM's
# verdict TEXT (OK/RED for the band/lease classes; ALERT/CLEAR/HOLD for hysteresis-class gates).
# The GATE ARITHMETIC lives in the byte-identical portable ROM; this shim is marshaling only.
# It is the ONE copy of the run-a-verdict logic (extracted from mesh-lease-audit's rom_verdict —
# a-format-fix-must-sweep-every-reader): consumers call this, never uxncli directly.
#
# usage:  mesh-rom-gate <rom> [args…]     rom = bare gate name (lease-gate → scripts/uxn/lease-gate.rom)
#                                         or an explicit path (anything with a / or .rom suffix)
#         mesh-rom-gate --test
# exit:   0 = a verdict was rendered and it is not RED
#         1 = verdict RED
#         2 = honest n/a, stated LOUDLY on stderr — engine or ROM absent on this node, or the
#             emulator run itself broke (n/a is a claim about the NODE, never a fake verdict).
# env:    MESH_REPO (genome checkout, default ~/lte-workstation) · MESH_UXN_DIR (ROM+toolchain dir,
#         default $MESH_REPO/scripts/uxn) · MESH_UXNCLI (emulator, default $MESH_UXN_DIR/bin/uxncli)
#         MESH_ROM_GATE_SHA1 (optional pin: sha1 the caller expects — checked against the ROM
#         ACTUALLY loaded, hash-then-execute; mismatch refuses pre-exec as rc=2 LOUD. A claimed
#         hash is theater — only hashing what you are about to run counts; fixed-point doctrine,
#         reference impl mesh-uxn-hop 3564761) · MESH_ROM_GATE_STAMP=1 (attest line on stderr:
#         'rom-gate: rom=<path> sha1=<actual> pinned=<pin|none> verdict=<v> rc=<n>')
#
# Verdict is TEXT; the emulator's exit code only means "the emulator ran" (ROMs halt #80 → exit 0 —
# the halt-convention trap, scripts/uxn/chibicc-eval/EVAL.md). A nonzero uxncli pipeline is real
# breakage (missing/old ROM, dead emulator) and fails LOUD as rc=2, never silently (f51e36d canon).
set -euo pipefail

REPO="${MESH_REPO:-$HOME/lte-workstation}"
UXN_DIR="${MESH_UXN_DIR:-$REPO/scripts/uxn}"
UXNCLI="${MESH_UXNCLI:-$UXN_DIR/bin/uxncli}"

if [ "${1:-}" = --test ]; then
  # a-test-child-inherits-exported-node-local-tuning: an ambient pin/stamp export would leak
  # into every child invocation below and skew the base assertions — shed them first.
  unset MESH_ROM_GATE_SHA1 MESH_ROM_GATE_STAMP
  # Smoke: the REAL runner path over the REAL ROMs — assert both verdict polarities per gate class
  # (a verdict never seen RED is a constant, not a gate), the rc map, and every n/a edge LOUD.
  # Writes no live state/logs (mesh-doctor runs this hourly — the guardian-log forgery canon).
  command -v "${CC:-cc}" >/dev/null 2>&1 || true
  if [ ! -x "$UXNCLI" ] || [ ! -f "$UXN_DIR/lease-gate.rom" ]; then
    # organ absent on this node: honest n/a — but if the vendored toolchain source is present,
    # build it (one-time ~1s) rather than skipping the whole gate forever.
    if [ -f "$UXN_DIR/build.sh" ] && command -v "${CC:-cc}" >/dev/null 2>&1; then
      (cd "$UXN_DIR" && ./build.sh --rom) >/dev/null 2>&1 \
        || { echo "smoke-test: n/a (uxn toolchain present but build failed — investigate $UXN_DIR/build.sh)" >&2; exit 2; }
    else
      echo "smoke-test: n/a (no uxncli/ROMs and no vendored toolchain on this node)" >&2; exit 2
    fi
  fi
  fail(){ echo "smoke-test: FAIL ($*)"; exit 1; }
  # lease-gate class: both polarities through the bare-name resolution path.
  v="$("$0" lease-gate 900 1800)" && rc=0 || rc=$?
  [ "$rc" = 0 ] && [ "$v" = OK ]  || fail "lease-gate 900 1800 → want OK/rc0, got '${v:-}'/rc$rc"
  v="$("$0" lease-gate 900 899)"  && rc=0 || rc=$?
  [ "$rc" = 1 ] && [ "$v" = RED ] || fail "lease-gate 900 899 → want RED/rc1, got '${v:-}'/rc$rc"
  # band-gate class (3 args) through the SAME runner: both polarities.
  v="$("$0" band-gate 20 50 70)"  && rc=0 || rc=$?
  [ "$rc" = 0 ] && [ "$v" = OK ]  || fail "band-gate 20 50 70 → want OK/rc0, got '${v:-}'/rc$rc"
  v="$("$0" band-gate 20 75 70)"  && rc=0 || rc=$?
  [ "$rc" = 1 ] && [ "$v" = RED ] || fail "band-gate 20 75 70 → want RED/rc1, got '${v:-}'/rc$rc"
  # n/a edges: every absence/breakage is rc=2 AND says why on stderr (LOUD, never a fake verdict).
  err="$(MESH_UXNCLI=/nonexistent/uxncli "$0" lease-gate 900 1800 2>&1 >/dev/null)" && rc=0 || rc=$?
  [ "$rc" = 2 ] && [ -n "$err" ]  || fail "absent engine → want rc2+stderr, got rc$rc err='${err:-}'"
  err="$("$0" no-such-gate 1 2 2>&1 >/dev/null)" && rc=0 || rc=$?
  [ "$rc" = 2 ] && [ -n "$err" ]  || fail "absent ROM → want rc2+stderr, got rc$rc err='${err:-}'"
  td="$(mktemp -d)"; trap 'rm -rf "$td"' EXIT
  printf '\x00' > "$td/mute.rom"   # BRK: emulator runs fine, ROM renders NO verdict — must be LOUD n/a
  err="$("$0" "$td/mute.rom" 1 2 2>&1 >/dev/null)" && rc=0 || rc=$?
  [ "$rc" = 2 ] && [ -n "$err" ]  || fail "verdict-less ROM → want rc2+stderr (empty verdict is breakage, not OK), got rc$rc err='${err:-}'"
  # domain NA: the ROM declines out-of-16-bit input — NA on stdout (consumers key
  # their inline fallback on it), rc 2, stderr says why (never a wrapped verdict).
  v="$("$0" lease-gate 900 67335 2>/dev/null)" && rc=0 || rc=$?
  [ "$rc" = 2 ] && [ "$v" = NA ] || fail "domain NA → want NA/rc2, got '${v:-}'/rc$rc"
  # fixed-point doctrine (rom-gate-runtime-hash): hash-then-execute, pin, attest.
  sha="$(sha1sum "$UXN_DIR/lease-gate.rom" | cut -d' ' -f1)"
  v="$(MESH_ROM_GATE_SHA1=$sha "$0" lease-gate 900 1800)" && rc=0 || rc=$?
  [ "$rc" = 0 ] && [ "$v" = OK ]  || fail "pin-match → want OK/rc0, got '${v:-}'/rc$rc"
  err="$(MESH_ROM_GATE_SHA1=deadbeefdeadbeefdeadbeefdeadbeefdeadbeef "$0" lease-gate 900 1800 2>&1 >/dev/null)" && rc=0 || rc=$?
  [ "$rc" = 2 ] && case "$err" in *mismatch*) true ;; *) false ;; esac \
    || fail "pin-mismatch → want rc2+mismatch on stderr, got rc$rc err='${err:-}'"
  # pre-exec proof: a TAMPERED rom under the true pin must be refused with NO verdict rendered —
  # the exact silent-tamper failure mesh-uxn-hop's RED-first run caught (3564761).
  cp "$UXN_DIR/lease-gate.rom" "$td/tamper.rom"; printf '\x00' >> "$td/tamper.rom"
  out="$(MESH_ROM_GATE_SHA1=$sha "$0" "$td/tamper.rom" 900 1800 2>/dev/null)" && rc=0 || rc=$?
  [ "$rc" = 2 ] && [ -z "$out" ] || fail "tampered ROM under pin → want refused pre-exec (rc2, empty stdout), got '${out:-}'/rc$rc"
  st="$(MESH_ROM_GATE_STAMP=1 "$0" lease-gate 900 899 2>&1 >/dev/null)" || true
  case "$st" in *"sha1=$sha"*verdict=RED*rc=1*) true ;; *) fail "stamp → want 'sha1=$sha … verdict=RED rc=1' on stderr, got '${st:-}'" ;; esac
  echo "smoke-test: ok (lease-gate OK+RED · band-gate OK+RED · n/a LOUD on absent-engine/absent-rom/mute-rom · domain NA passthrough · pin match/mismatch/tamper-refused-pre-exec · sha1 attest stamp)"
  exit 0
fi

[ $# -ge 1 ] || { echo "usage: mesh-rom-gate <rom> [args…]  (see header)" >&2; exit 2; }
rom="$1"; shift
case "$rom" in
  */*|*.rom) ROMPATH="$rom" ;;
  *)         ROMPATH="$UXN_DIR/$rom.rom" ;;
esac
[ -x "$UXNCLI" ] || { echo "mesh-rom-gate: n/a — no uxncli at $UXNCLI (run $UXN_DIR/build.sh)" >&2; exit 2; }
[ -f "$ROMPATH" ] || { echo "mesh-rom-gate: n/a — no ROM at $ROMPATH" >&2; exit 2; }

# hash-then-execute: sha1 the ROM we are ACTUALLY about to load, before a byte of it runs.
pin="${MESH_ROM_GATE_SHA1:-}"
if [ -n "$pin" ]; then
  case "$pin" in *[!0-9a-f]*) echo "mesh-rom-gate: n/a — bad pinned sha1 '$pin' (want 40 lowercase hex)" >&2; exit 2 ;; esac
  [ "${#pin}" -eq 40 ] || { echo "mesh-rom-gate: n/a — bad pinned sha1 width ${#pin} ('$pin')" >&2; exit 2; }
fi
actual="$(sha1sum -- "$ROMPATH" | cut -d' ' -f1)"
if [ -n "$pin" ] && [ "$pin" != "$actual" ]; then
  echo "mesh-rom-gate: n/a — ROM sha1 mismatch at $ROMPATH (pinned $pin, actual $actual) — refusing to execute" >&2
  exit 2
fi
stamp(){ [ "${MESH_ROM_GATE_STAMP:-0}" = 1 ] || return 0
  echo "rom-gate: rom=$ROMPATH sha1=$actual pinned=${pin:-none} verdict=$1 rc=$2" >&2; }

urc=0
raw="$("$UXNCLI" "$ROMPATH" "$@" 2>/dev/null)" || urc=$?
verdict="$(printf '%s' "$raw" | tr -d '[:space:]')"
if [ "$urc" -ne 0 ]; then
  if [ "$verdict" = NA ]; then
    # The ROM itself declined (halt #82): input outside its int domain — e.g.
    # lease-gate's 16-bit ceiling (2026-07-23, found by mesh-rom-calibrate; a
    # wrapped verdict false-REDs 67335 and false-GREENs 33000/60000). NA goes to
    # stdout so consumers can key their inline 64-bit fallback on it; rc stays 2.
    printf 'NA\n'
    echo "mesh-rom-gate: n/a — $ROMPATH answered NA on '$*' (out-of-domain for the ROM's int width; consumer inline fallback applies)" >&2
    stamp NA 2
    exit 2
  fi
  echo "mesh-rom-gate: n/a — uxncli failed (rc=$urc) on $ROMPATH $* (rebuild? $UXN_DIR/build.sh --rom)" >&2
  exit 2
fi
[ -n "$verdict" ] \
  || { echo "mesh-rom-gate: n/a — $ROMPATH rendered no verdict on '$*' (broken/mismatched ROM — a mute gate is breakage, never a pass)" >&2; exit 2; }

printf '%s\n' "$verdict"
rc=0
if [ "$verdict" = RED ]; then rc=1; fi
stamp "$verdict" "$rc"
exit "$rc"
