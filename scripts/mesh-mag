#!/usr/bin/env bash
# reflex-cadence: 4-59/5 * * * *
# reflex-args: --edge
# mesh-mag — the body's COMPASS + MAGNETIC-DISTURBANCE sense.
# Reads the phone's akm09918 magnetometer (3-axis, µT) and derives:
#   1. Compass heading (atan2 of x,y → degrees → 8 cardinal directions)
#   2. Magnetic stability (total field strength vs baseline → STEADY/DISTURBED)
#
# Data source: akm09918 via SSH (termux-sensor). Zero new SSH — same connection
# as other phone senses. The data ALREADY flows into sensors.log (mesh-sensor-log:96)
# but nothing interprets it. This tool interprets it.
#
# Heading (body-facing direction, screen-up assumed):
#   atan2(y, x) → degrees → cardinal:
#     N (337.5-22.5)  NE (22.5-67.5)  E (67.5-112.5)  SE (112.5-157.5)
#     S (157.5-202.5) SW (202.5-247.5) W (247.5-292.5) NW (292.5-337.5)
#
# Disturbance detection:
#   Total field = sqrt(x² + y² + z²). Earth's field is ~25-65 µT.
#   Baseline is the rolling average of recent STEADY readings.
#   If |total - baseline| > MESH_MAG_DISTURB_THRESHOLD (default 10 µT) → DISTURBED.
#   A spike = nearby metal/motor/door; a drop = shielding. Both count.
#   Baseline self-heals: on STEADY, nudge toward current total (slow tracking).
#
#   mesh-mag            one compass + stability line
#   mesh-mag --edge     emit only on heading change or disturb edge (cron reflex)
#   mesh-mag --json     machine-readable {heading, cardinal, degrees, total, stability}
#   mesh-mag --test     smoke test (exit 2 = phone unreachable)
#
# Exit codes (honest-exit contract):
#   0 = assessment produced
#   2 = phone unreachable — cannot read sensor, never faked
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes"

STATE="$HOME/.mesh/.mag-state"         # holds: <cardinal> <total> <stability>
OFFLINEFILE="$HOME/.mesh/.mag-offline"
DISTURB_THRESHOLD="${MESH_MAG_DISTURB_THRESHOLD:-10}"  # µT deviation from baseline → DISTURBED
BASELINE_NUDGE="${MESH_MAG_BASELINE_NUDGE:-0.1}"       # slow tracking factor (0-1)

# compass_heading x y → degrees (0-360, N=0)
compass_heading() {
  python3 -c "
import math, sys
x, y = float(sys.argv[1]), float(sys.argv[2])
rad = math.atan2(y, x)
deg = (math.degrees(rad) + 360) % 360
print(f'{deg:.1f}')
" "$1" "$2"
}

# degrees → 8-point cardinal
deg_to_cardinal() {
  python3 -c "
import sys
d = float(sys.argv[1])
dirs = ['N','NE','E','SE','S','SW','W','NW']
idx = int((d + 22.5) / 45) % 8
print(dirs[idx])
" "$1"
}

if [ "${1:-}" = --test ]; then
  command -v python3 >/dev/null 2>&1 || { echo "smoke-test: FAIL (no python3)"; exit 1; }
  command -v mesh-phone-ip >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-phone-ip)"; exit 1; }
  mkdir -p "$HOME/.mesh" 2>/dev/null || { echo "smoke-test: FAIL (no ~/.mesh)"; exit 1; }
  # Dry-run: verify compass_heading + deg_to_cardinal against known values
  _f=0
  _h=$(compass_heading 0 1);   [ "$_h" = "90.0" ]  || { echo "  FAIL: heading N→E expected 90.0 got $_h"; _f=1; }
  _h=$(compass_heading 1 0);   [ "$_h" = "0.0" ]   || { echo "  FAIL: heading E→N expected 0.0 got $_h"; _f=1; }
  _h=$(compass_heading 0 -1);  [ "$_h" = "270.0" ] || { echo "  FAIL: heading W→N expected 270.0 got $_h"; _f=1; }
  _h=$(compass_heading -1 0);  [ "$_h" = "180.0" ] || { echo "  FAIL: heading S→N expected 180.0 got $_h"; _f=1; }
  _c=$(deg_to_cardinal 0);     [ "$_c" = "N" ]     || { echo "  FAIL: 0° → N got $_c"; _f=1; }
  _c=$(deg_to_cardinal 45);    [ "$_c" = "NE" ]    || { echo "  FAIL: 45° → NE got $_c"; _f=1; }
  _c=$(deg_to_cardinal 90);    [ "$_c" = "E" ]     || { echo "  FAIL: 90° → E got $_c"; _f=1; }
  _c=$(deg_to_cardinal 135);   [ "$_c" = "SE" ]    || { echo "  FAIL: 135° → SE got $_c"; _f=1; }
  _c=$(deg_to_cardinal 180);   [ "$_c" = "S" ]     || { echo "  FAIL: 180° → S got $_c"; _f=1; }
  _c=$(deg_to_cardinal 225);   [ "$_c" = "SW" ]    || { echo "  FAIL: 225° → SW got $_c"; _f=1; }
  _c=$(deg_to_cardinal 270);   [ "$_c" = "W" ]     || { echo "  FAIL: 270° → W got $_c"; _f=1; }
  _c=$(deg_to_cardinal 315);   [ "$_c" = "NW" ]    || { echo "  FAIL: 315° → NW got $_c"; _f=1; }
  _c=$(deg_to_cardinal 11);    [ "$_c" = "N" ]     || { echo "  FAIL: 11° → N got $_c"; _f=1; }
  _c=$(deg_to_cardinal 23);    [ "$_c" = "NE" ]    || { echo "  FAIL: 23° → NE got $_c"; _f=1; }
  mesh-phone-ip >/dev/null 2>&1 || { echo "smoke-test: n/a (phone unreachable — mag sense unavailable)"; [ "$_f" = 0 ] && exit 2; exit 1; }
  [ "$_f" = 0 ] || { echo "smoke-test: FAIL (compass classifier drifted)"; exit 1; }
  echo "smoke-test: ok (compass: 8 cardinals verified, heading math checked)"; exit 0
fi

MODE=text
[ "${1:-}" = --json ] && MODE=json
EDGE=0
[ "${1:-}" = --edge ] && EDGE=1

TS=$(date -u +%Y-%m-%dT%H:%M:%SZ)

# --- Phone reachability gate ---
pip="$(mesh-phone-ip 2>/dev/null)" || {
  if [ ! -f "$OFFLINEFILE" ]; then echo "phone unreachable — can't read magnetometer (not an alarm)" >&2; touch "$OFFLINEFILE"; fi
  exit 2
}
rm -f "$OFFLINEFILE"

# --- Read akm09918 via SSH ---
j="$(timeout 12 ssh -p "${PHONE_SSH_PORT:-8022}" -o BatchMode=yes -o ConnectTimeout=6 "${PHONE_USER:-u0_a380}@$pip" 'timeout 6 termux-sensor -s akm09918 -n 1' </dev/null 2>/dev/null)"
[ -n "$j" ] || { if [ ! -f "$OFFLINEFILE" ]; then echo "phone unreachable — can't read magnetometer (not an alarm)" >&2; touch "$OFFLINEFILE"; fi; exit 2; }

# Parse 3-axis values
mag_xyz="$(printf '%s' "$j" | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
    vals = d.get("akm09918", {}).get("values", [])
    if len(vals) >= 3:
        print(f"{vals[0]:.4f} {vals[1]:.4f} {vals[2]:.4f}")
except Exception:
    pass
' 2>/dev/null)"
[ -n "$mag_xyz" ] || { echo "akm09918 parse failed (not an alarm)" >&2; exit 2; }

read -r mx my mz <<< "$mag_xyz"

# --- Compute heading + total field ---
deg="$(compass_heading "$mx" "$my")"
cardinal="$(deg_to_cardinal "$deg")"
total="$(python3 -c "import math; print(f'{math.sqrt($mx**2 + $my**2 + $mz**2):.1f}')" 2>/dev/null)"

# --- Read previous state ---
prev_cardinal=""
prev_total=""
prev_stability=""
if [ -f "$STATE" ]; then
  read -r prev_cardinal prev_total prev_stability < "$STATE" 2>/dev/null || true
fi

# --- Disturbance detection ---
# First run: seed baseline, assume STEADY
if [ -z "$prev_total" ]; then
  stability="STEADY"
  printf '%s %s %s\n' "$cardinal" "$total" "$stability" > "$STATE"
else
  delta="$(python3 -c "print(f'{abs($total - $prev_total):.1f}')" 2>/dev/null)"
  disturbed=$(python3 -c "print(1 if abs($total - float('$prev_total')) > $DISTURB_THRESHOLD else 0)" 2>/dev/null)
  if [ "$disturbed" = 1 ]; then
    stability="DISTURBED"
  else
    stability="STEADY"
    # Slow baseline nudge: track drift without chasing spikes
    new_total="$(python3 -c "print(f'{float('$prev_total') * (1 - $BASELINE_NUDGE) + $total * $BASELINE_NUDGE:.1f}')" 2>/dev/null)"
    total="$new_total"
  fi
  printf '%s %s %s\n' "$cardinal" "$total" "$stability" > "$STATE"
fi

# --- Output ---
tag="[mag-${stability,,}]"

case "$MODE" in
  json)
    printf '{"heading":"%s","degrees":%s,"total":%s,"stability":"%s","x":%s,"y":%s,"z":%s,"ts":"%s"}\n' \
      "$cardinal" "$deg" "$total" "$stability" "$mx" "$my" "$mz" "$TS"
    ;;
  edge)
    # Emit on: heading change OR stability change
    [ "$cardinal" = "$prev_cardinal" ] && [ "$stability" = "$prev_stability" ] && exit 0
    printf '%s %s — heading %s (%s°) field=%s µT | %s\n' "$tag" "$cardinal" "$deg" "$total" "$stability" "$prev_stability"
    ;;
  *)
    printf '%s %s — heading %s (%s°) field=%s µT\n' "$tag" "$cardinal" "$deg" "$total" "$stability"
    ;;
esac
