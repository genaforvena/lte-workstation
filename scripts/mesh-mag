#!/usr/bin/env bash
# reflex-cadence: 4-59/5 * * * *
# reflex-args: --edge
# doctor-artifact: $HOME/.mesh/.mag-state 1800 phone
#   ^ smoke-theater gate (mesh-doctor): .mag-state is rewritten on EVERY successful read (both the
#     first-run-seed and steady branches), so phone-reachable + state >1800s stale ⟹ the sense is
#     silently not producing despite a green --test. Phone offline → gate skips. See _theater_check.
# mesh-mag — the body's COMPASS + MAGNETIC-DISTURBANCE sense.
# Reads the phone's akm09918 magnetometer (3-axis, µT) and derives:
#   1. Compass heading (atan2 of x,y → degrees → 8 cardinal directions)
#   2. Magnetic stability (total field strength vs baseline → STEADY/DISTURBED)
#
# Data source: akm09918 via SSH (termux-sensor). Zero new SSH — same connection
# as other phone senses. The data ALREADY flows into sensors.log (mesh-sensor-log:96)
# but nothing interprets it. This tool interprets it.
#
# Heading (body-facing direction, screen-up assumed):
#   atan2(y, x) → degrees → cardinal:
#     N (337.5-22.5)  NE (22.5-67.5)  E (67.5-112.5)  SE (112.5-157.5)
#     S (157.5-202.5) SW (202.5-247.5) W (247.5-292.5) NW (292.5-337.5)
#
# Disturbance detection:
#   Total field = sqrt(x² + y² + z²). Earth's field is ~25-65 µT.
#   Baseline is the rolling average of recent STEADY readings.
#   If |total - baseline| > MESH_MAG_DISTURB_THRESHOLD (default 10 µT) → DISTURBED.
#   A spike = nearby metal/motor/door; a drop = shielding. Both count.
#   Baseline self-heals: on STEADY, nudge toward current total (slow tracking).
#
#   mesh-mag            one compass + stability line
#   mesh-mag --edge     emit only on heading change or disturb edge (cron reflex)
#   mesh-mag --json     machine-readable {heading, cardinal, degrees, total, stability}
#   mesh-mag --test     smoke test (exit 2 = phone unreachable)
#
# Exit codes (honest-exit contract):
#   0 = assessment produced
#   2 = phone unreachable — cannot read sensor, never faked
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes"

STATE="$HOME/.mesh/.mag-state"         # holds: <cardinal> <total> <stability>
OFFLINEFILE="$HOME/.mesh/.mag-offline"
DISTURB_THRESHOLD="${MESH_MAG_DISTURB_THRESHOLD:-10}"  # µT deviation from baseline → DISTURBED
BASELINE_NUDGE="${MESH_MAG_BASELINE_NUDGE:-0.1}"       # slow tracking factor (0-1)

# compass_heading x y → degrees (0-360, N=0)
compass_heading() {
  python3 -c "
import math, sys
x, y = float(sys.argv[1]), float(sys.argv[2])
rad = math.atan2(y, x)
deg = (math.degrees(rad) + 360) % 360
print(f'{deg:.1f}')
" "$1" "$2"
}

# degrees → 8-point cardinal
deg_to_cardinal() {
  python3 -c "
import sys
d = float(sys.argv[1])
dirs = ['N','NE','E','SE','S','SW','W','NW']
idx = int((d + 22.5) / 45) % 8
print(dirs[idx])
" "$1"
}

# field_total x y z → total field magnitude µT (√(x²+y²+z²)), 1 decimal.
# Values are passed as argv, NOT string-interpolated into the source: a NEGATIVE axis
# (common at some phone orientations) inlined as `$my**2` parses as `-(my**2)` because **
# binds tighter than unary minus → negative sum → math.sqrt domain error → empty total →
# 2-field .mag-state → prev_total parses as the STABILITY word → all delta/DISTURBED math
# errors out (disturbance detection silently dead) and --json emits invalid `"total":,`.
# argv + x*x (no **) is sign-safe and injection-safe. (senses liveness-audit 2026-07-06)
field_total() {
  python3 -c "
import math, sys
x, y, z = float(sys.argv[1]), float(sys.argv[2]), float(sys.argv[3])
print(f'{math.sqrt(x*x + y*y + z*z):.1f}')
" "$1" "$2" "$3"
}

# read_akm09918 <ip> → echoes "x y z" (3 axes) or empty + return 1. RETRIES across samplings because
# the akm09918 termux driver is NON-DETERMINISTIC: which -d/-n combo yields values shifts over time
# (live 2026-06-26: -d 500 -n 2 produced at 00:10Z but returned 0 objects by 03:30Z, while -n 2 and
# -d 500 -n 3 both worked then). ANY single sampling goes hollow again under cron; this takes the
# FIRST combo whose first object (raw_decode handles the multi-object -n>1 stream) parses to >=3 axes.
read_akm09918() {
  local _ip="$1" _out _xyz
  for _s in "-d 500 -n 3" "-n 2" "-d 500 -n 2"; do
    _out="$(timeout 14 ssh -p "${PHONE_SSH_PORT:-8022}" -o BatchMode=yes -o ConnectTimeout=6 \
      -o StrictHostKeyChecking=accept-new "${PHONE_USER:-u0_a380}@$_ip" \
      "timeout 9 termux-sensor -s akm09918 $_s 2>/dev/null" </dev/null 2>/dev/null)" || continue
    [ -n "$_out" ] || continue
    _xyz="$(printf '%s' "$_out" | python3 -c '
import json, sys
try:
    d,_=json.JSONDecoder().raw_decode(sys.stdin.read().strip())
    v=d.get("akm09918", {}).get("values", [])
    if len(v)>=3: print("%.4f %.4f %.4f" % (v[0], v[1], v[2]))
except Exception:
    pass
' 2>/dev/null)"
    [ -n "$_xyz" ] && { printf '%s' "$_xyz"; return 0; }
  done
  read_akm09918_sensorcat && return 0
  return 1
}

# read_akm09918_sensorcat — 2nd transport (note3-senses-single-transport): when termux-sensor over
# SSH is unreachable but the phone is adb-USB attached, the SAME physical magnetometer is readable
# via the HAL's android.sensor.magnetic_field (type 2, CALIBRATED, uT — same units/axes akm09918
# reports) through sensorcat, the pattern mesh-note3-mag already proved live. Continuous/cached HAL
# type (unlike step_counter's on-change, which sensorcat cannot get a sample from at rest — see
# mesh-step). Echoes "x y z" or returns 1 on any failure; never fakes a reading.
read_akm09918_sensorcat() {
  local _node="${MESH_MAG_ADB_NODE:-${MESH_NOTE3_ADB_NODE:-${MESH_BARO_ADB_NODE:-}}}"
  local _serial="${MESH_MAG_ADB_SERIAL:-${MESH_NOTE3_ADB_SERIAL:-${MESH_BARO_ADB_SERIAL:-}}}"
  [ -n "$_node" ] || return 1
  local _ser=""; [ -n "$_serial" ] && _ser="-s $_serial"
  local _raw
  if [ "$_node" = local ]; then
    command -v mesh-note3-tool-install >/dev/null 2>&1 && mesh-note3-tool-install sensorcat >/dev/null 2>&1
    _raw="$(timeout 20 adb $_ser shell '/data/local/tmp/sensorcat --secs 3 2' 2>/dev/null)"
  else
    _raw="$(timeout 30 ssh -o BatchMode=yes -o ConnectTimeout=8 -o StrictHostKeyChecking=accept-new \
      "$_node" "adb $_ser shell '/data/local/tmp/sensorcat --secs 3 2'" </dev/null 2>/dev/null)"
  fi
  [ -n "$_raw" ] || return 1
  local _xyz
  _xyz="$(printf '%s\n' "$_raw" | awk -F'|' '$1=="SENSOR" && $3==2 {printf "%s %s %s", $4, $5, $6; exit}')"
  [ -n "$_xyz" ] || return 1
  printf '%s' "$_xyz"
}

# structural_count_ok <axes-string> → 0 if the read carries >=3 numeric axes (the hollow-sense count
# gate). Routes through sense-gate.rom (a 305-byte structural fixed point — the count check can no
# longer rot per-sensor the way "-n 1 raced the driver green for 5 days" did) where the uxn toolchain
# is present; falls back to a bash token-count otherwise. build.sh runs ONLY on mesh-home, so a hard
# uxn dependency would make this sense's --test go n/a on every other node — the fallback keeps it
# portable. sense-gate rc 2 (toolchain/ROM absent) deliberately falls through to the bash path: a
# missing toolchain is not a hollow read, and must not read as one.
structural_count_ok() {
  local axes="$1"
  if command -v mesh-sense-gate >/dev/null 2>&1; then
    mesh-sense-gate --count 3 "$axes" >/dev/null 2>&1
    case $? in
      0) return 0 ;;   # OK — structurally >=3 numeric axes
      1) return 1 ;;   # RED count — hollow (<3 axes); the driver-race signature
    esac              # rc 2 (toolchain absent) → fall through to the bash fallback
  fi
  local n; n="$(printf '%s\n' "$axes" | tr -s '[:space:]' '\n' | grep -cE '^-?[0-9]+\.?[0-9]*$' || true)"
  [ "${n:-0}" -ge 3 ]
}

if [ "${1:-}" = --test ]; then
  command -v python3 >/dev/null 2>&1 || { echo "smoke-test: FAIL (no python3)"; exit 1; }
  command -v mesh-phone-ip >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-phone-ip)"; exit 1; }
  mkdir -p "$HOME/.mesh" 2>/dev/null || { echo "smoke-test: FAIL (no ~/.mesh)"; exit 1; }
  # Dry-run: verify compass_heading + deg_to_cardinal against known values
  _f=0
  _h=$(compass_heading 0 1);   [ "$_h" = "90.0" ]  || { echo "  FAIL: heading N→E expected 90.0 got $_h"; _f=1; }
  _h=$(compass_heading 1 0);   [ "$_h" = "0.0" ]   || { echo "  FAIL: heading E→N expected 0.0 got $_h"; _f=1; }
  _h=$(compass_heading 0 -1);  [ "$_h" = "270.0" ] || { echo "  FAIL: heading W→N expected 270.0 got $_h"; _f=1; }
  _h=$(compass_heading -1 0);  [ "$_h" = "180.0" ] || { echo "  FAIL: heading S→N expected 180.0 got $_h"; _f=1; }
  _c=$(deg_to_cardinal 0);     [ "$_c" = "N" ]     || { echo "  FAIL: 0° → N got $_c"; _f=1; }
  _c=$(deg_to_cardinal 45);    [ "$_c" = "NE" ]    || { echo "  FAIL: 45° → NE got $_c"; _f=1; }
  _c=$(deg_to_cardinal 90);    [ "$_c" = "E" ]     || { echo "  FAIL: 90° → E got $_c"; _f=1; }
  _c=$(deg_to_cardinal 135);   [ "$_c" = "SE" ]    || { echo "  FAIL: 135° → SE got $_c"; _f=1; }
  _c=$(deg_to_cardinal 180);   [ "$_c" = "S" ]     || { echo "  FAIL: 180° → S got $_c"; _f=1; }
  _c=$(deg_to_cardinal 225);   [ "$_c" = "SW" ]    || { echo "  FAIL: 225° → SW got $_c"; _f=1; }
  _c=$(deg_to_cardinal 270);   [ "$_c" = "W" ]     || { echo "  FAIL: 270° → W got $_c"; _f=1; }
  _c=$(deg_to_cardinal 315);   [ "$_c" = "NW" ]    || { echo "  FAIL: 315° → NW got $_c"; _f=1; }
  _c=$(deg_to_cardinal 11);    [ "$_c" = "N" ]     || { echo "  FAIL: 11° → N got $_c"; _f=1; }
  _c=$(deg_to_cardinal 23);    [ "$_c" = "NE" ]    || { echo "  FAIL: 23° → NE got $_c"; _f=1; }
  # structural_count_ok dry-run (phone-independent — runs every --test, even with the body
  # asleep): the count gate is the hollow-sense fixed point. A healthy 3-axis read passes; an
  # empty read (the driver-race canon) and a 2-axis short read fail. Verified SYNTHETICALLY here
  # so the gate is seen RED before it ever guards a live read (a gate unseen-RED is no gate).
  structural_count_ok "0.1 0.2 0.3" || { echo "  FAIL: structural_count_ok should pass a 3-axis read"; _f=1; }
  structural_count_ok ""           && { echo "  FAIL: structural_count_ok should FAIL an empty read (driver-race hollow)"; _f=1; }
  structural_count_ok "1 2"        && { echo "  FAIL: structural_count_ok should FAIL a 2-axis short read"; _f=1; }
  structural_count_ok "OFFLINE"    && { echo "  FAIL: structural_count_ok should FAIL a non-numeric stub"; _f=1; }
  # Real SSH reachability probe — NOT mesh-phone-ip (returns cached IP exit 0 when
  # offline → false-green). phone_reachable_ip (mesh-patterns.sh) does a real ConnectTimeout=3 SSH.
  source "$HOME/.local/bin/mesh-patterns.sh" 2>/dev/null || true
  _mpip="$(mesh-phone-ip 2>/dev/null)"
  _axes=""; _via=""
  if phone_reachable_ip >/dev/null 2>&1 && [ -n "$_mpip" ]; then
    _axes="$(read_akm09918 "$_mpip" 2>/dev/null)" && _via="termux-sensor"
  fi
  # note3-senses-single-transport: SSH/termux down does NOT mean the sense is dead — the SAME
  # magnetometer is reachable via adb+sensorcat (read_akm09918_sensorcat) when the phone is USB-
  # attached. Try it before declaring n/a, so this gate can't false-n/a during exactly the gap
  # the 2nd transport exists to cover.
  if [ -z "$_axes" ]; then
    _axes="$(read_akm09918_sensorcat 2>/dev/null)" && _via="adb-sensorcat"
  fi
  # REAL-READ assertion (2026-06-26): reachability ≠ producing. The live akm09918 read must parse
  # to 3 axes or the sense is hollow (cron-green but no real artifact). This gate was MISSING —
  # -n 1 raced the driver for 5 days while --test stayed green. Catches a broken read honestly.
  # Now a STRUCTURAL gate (sense-gate.rom, structural_count_ok) — the count check is a ROM fixed
  # point, not bespoke bash that rots; the bash fallback keeps it portable where uxn is absent.
  if [ -n "$_axes" ]; then
    structural_count_ok "$_axes" \
      || { echo "smoke-test: n/a (akm09918 read '$_axes' via $_via failed the structural count gate — <3 numeric axes; not producing a real artifact)"; exit 2; }
    # TOTAL-NON-EMPTY gate (2026-07-06): a real 3-axis read must also yield a numeric total
    # field magnitude. The prior sqrt used string-interpolated `$my**2` which silently emptied
    # `total` on any negative axis (operator-precedence domain error) — heading stayed green
    # while total/DISTURBED went hollow. Assert total parses as a positive float.
    read -r _tx _ty _tz <<< "$_axes"
    _tt="$(field_total "$_tx" "$_ty" "$_tz" 2>/dev/null)"
    case "$_tt" in
      ''|*[!0-9.]*) echo "smoke-test: FAIL (total field magnitude empty/non-numeric from axes '$_axes' — the negative-axis sqrt-precedence hollow)"; exit 1 ;;
    esac
  else
    echo "smoke-test: n/a (phone unreachable on BOTH termux-sensor and adb-sensorcat — mag sense unavailable)"
    [ "$_f" = 0 ] && exit 2
    exit 1
  fi
  [ "$_f" = 0 ] || { echo "smoke-test: FAIL (compass classifier drifted)"; exit 1; }
  echo "smoke-test: ok (compass: 8 cardinals + heading math + structural count gate + REAL akm09918 3-axis read via $_via)"; exit 0
fi

MODE=text
[ "${1:-}" = --json ] && MODE=json
EDGE=0
[ "${1:-}" = --edge ] && EDGE=1

TS=$(date -u +%Y-%m-%dT%H:%M:%SZ)

# --- Phone reachability gate ---
pip="$(mesh-phone-ip 2>/dev/null)" || {
  if [ ! -f "$OFFLINEFILE" ]; then echo "phone unreachable — can't read magnetometer (not an alarm)" >&2; touch "$OFFLINEFILE"; fi
  # Liveness-touch (grip pattern): write an honest OFFLINE marker + refresh mtime every run so
  # .mag-state mtime = reflex-alive (a dead cron never touches → still honest-STALE), while the
  # source-down fact lives in the CONTENT. Otherwise mtime freezes for the whole phone-away window
  # and reads as a dead reflex. Still exit 2 (honest n/a preserved for mesh-land).
  printf 'OFFLINE %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$STATE"; mesh-state-touch "$STATE" 2>/dev/null || true
  exit 2
}
rm -f "$OFFLINEFILE"

# --- Read akm09918 via SSH (multi-sampling retry — the termux driver is non-deterministic; a
# single -d/-n combo goes hollow under cron. read_akm09918 tries several and returns the first 3-axis
# parse. See its header for the live evidence.) ---
mag_xyz="$(read_akm09918 "$pip")"
[ -n "$mag_xyz" ] || { if [ ! -f "$OFFLINEFILE" ]; then echo "phone unreachable / akm09918 not producing across samplings (not an alarm)" >&2; touch "$OFFLINEFILE"; fi; printf 'OFFLINE %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$STATE"; mesh-state-touch "$STATE" 2>/dev/null || true; exit 2; }

read -r mx my mz <<< "$mag_xyz"

# --- Compute heading + total field ---
deg="$(compass_heading "$mx" "$my")"
cardinal="$(deg_to_cardinal "$deg")"
total="$(field_total "$mx" "$my" "$mz" 2>/dev/null)"

# --- Read previous state ---
prev_cardinal=""
prev_total=""
prev_stability=""
if [ -f "$STATE" ]; then
  read -r prev_cardinal prev_total prev_stability < "$STATE" 2>/dev/null || true
fi
# Corruption guard: a legacy/empty-total STATE ("<cardinal> <stability>", 2 fields) makes
# prev_total parse as the stability WORD. Left as-is, the line-below `float('$prev_total')`
# nudge errors → empties total → re-writes the 2-field corrupt state → self-perpetuates even
# after the sqrt fix. If prev_total is not numeric, treat this as a first run and reseed clean.
case "$prev_total" in
  ''|*[!0-9.]*) prev_total="" ;;
esac

# --- Disturbance detection ---
# First run: seed baseline, assume STEADY
if [ -z "$prev_total" ]; then
  stability="STEADY"
  printf '%s %s %s\n' "$cardinal" "$total" "$stability" > "$STATE"
else
  delta="$(python3 -c "print(f'{abs($total - $prev_total):.1f}')" 2>/dev/null)"
  disturbed=$(python3 -c "print(1 if abs($total - float('$prev_total')) > $DISTURB_THRESHOLD else 0)" 2>/dev/null)
  if [ "$disturbed" = 1 ]; then
    stability="DISTURBED"
  else
    stability="STEADY"
    # Slow baseline nudge: track drift without chasing spikes
    new_total="$(python3 -c "print(f'{float('$prev_total') * (1 - $BASELINE_NUDGE) + $total * $BASELINE_NUDGE:.1f}')" 2>/dev/null)"
    total="$new_total"
  fi
  printf '%s %s %s\n' "$cardinal" "$total" "$stability" > "$STATE"
fi

# --- Output ---
tag="[mag-${stability,,}]"

case "$MODE" in
  json)
    printf '{"heading":"%s","degrees":%s,"total":%s,"stability":"%s","x":%s,"y":%s,"z":%s,"ts":"%s"}\n' \
      "$cardinal" "$deg" "$total" "$stability" "$mx" "$my" "$mz" "$TS"
    ;;
  edge)
    # Emit on: heading change OR stability change
    [ "$cardinal" = "$prev_cardinal" ] && [ "$stability" = "$prev_stability" ] && exit 0
    printf '%s %s — heading %s (%s°) field=%s µT | %s\n' "$tag" "$cardinal" "$deg" "$total" "$stability" "$prev_stability"
    ;;
  *)
    printf '%s %s — heading %s (%s°) field=%s µT\n' "$tag" "$cardinal" "$deg" "$total" "$stability"
    ;;
esac
