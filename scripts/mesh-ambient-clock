#!/usr/bin/env bash
# reflex-cadence: 6-59/10 * * * *
# reflex-args: --edge
# mesh-ambient-clock — ambient social clock derived from fixed-appliance BLE cycling.
# Harvests devices excluded from mesh-arrivals (TVs, ACs, smart-home) whose on/off
# BLE beaconing encodes neighbor activity and environmental state:
#   TV_COUNT > 0        → neighbors home / evening time
#   GR-AC_ seen        → someone running AC → it's hot
#   LYWSD03MMC seen    → temperature sensor active
#   All TVs gone       → late night / neighbors asleep
#
# Reads presence.log (updated by mesh-arrivals) for the last 25 scans (~15 min).
# Emits a one-line ambient label + breakdown.
#
# Signal fidelity (2026-06-19):
#   Rolling 25-scan window instead of last 2 — BLE advertising is bursty; a TV
#   may miss 1-2 scans even when actively beaconing. 25 scans ≈ 15 min at 70s/scan.
#   RSSI proximity bands: TVs at < -90 dBm are noise-floor and excluded entirely;
#     TVs at ≥ -75 = NEARBY (in or adjacent room); < -75 = FAR (neighbor range).
#   Vote-based counting: a TV must appear in ≥ 2 of the last 25 scans to count.
#   Honest stale path: DATA-STALE when presence.log is > 20 min old (exit 0 still,
#     verdict is explicitly degraded — not silently wrong).
#
#   mesh-ambient-clock            one-shot label
#   mesh-ambient-clock --edge     emit only when label changes (for cron/stream wiring)
#   mesh-ambient-clock --json     machine-readable {label, tv_count, tv_nearby, tv_far, ac_on, data_stale, scan_count, trend, ts, detail}
#                                 trend = RISING|FALLING|STABLE (TV count vs ~15 min ago) or INITIAL (not enough data)
#   mesh-ambient-clock --test     smoke test
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes" 2>/dev/null || true
[ -r "$HOME/.local/bin/mesh-patterns.sh" ] && . "$HOME/.local/bin/mesh-patterns.sh" 2>/dev/null || true
export MESH_WHO="mesh-ambient-clock@$(hostname)"

PRESENCE_LOG="$HOME/.mesh/presence.log"
STATE_FILE="$HOME/.mesh/.ambient-clock.state"
TS="$(date -u +%FT%TZ)"

# ---- Smoke test ----
[ "${1:-}" = --test ] && {
  command -v python3 >/dev/null 2>&1 || { echo "smoke-test: FAIL (no python3)"; exit 1; }

  result="$(python3 -c '
import re

TV_RE = re.compile(r"\[TV\]|MiTV|Bluedroid TV|Mi Box|ваня тв", re.I)
AC_RE = re.compile(r"GR-AC_", re.I)
SENS_RE = re.compile(r"MI SCALE|LYWSD", re.I)
SKIP_RE = re.compile(r"Bose|JBL|AirPods|Galaxy Buds|Pixel|iPhone|Redmi", re.I)

def parse_scans(lines):
    tvs_vote, tv_rssi, ac_names, sensor_names = {}, {}, set(), set()
    scan_count = 0
    for line in lines:
        if not re.search(r"\bdevices=\[", line): continue
        scan_count += 1
        dm = re.search(r"devices=\[(.+)\]", line)
        if not dm: continue
        inner = dm.group(1)
        entries = list(re.finditer(r"(-\d+)\|([0-9A-Fa-f:]{17})\|", inner))
        seen = set()
        for i, e in enumerate(entries):
            rssi = int(e.group(1))
            nstart = e.end()
            nend = entries[i+1].start() if i+1 < len(entries) else len(inner)
            name = inner[nstart:nend].rstrip("] ")
            if not name or name == "?": continue
            if SKIP_RE.search(name): continue
            if TV_RE.search(name) and rssi >= -90:
                seen.add(name)
                tv_rssi[name] = max(tv_rssi.get(name, -999), rssi)
            elif AC_RE.search(name):
                ac_names.add(name)
            elif SENS_RE.search(name):
                sensor_names.add(name)
        for n in seen:
            tvs_vote[n] = tvs_vote.get(n, 0) + 1
    min_v = 2 if scan_count >= 4 else 1
    return tvs_vote, tv_rssi, min_v, scan_count

errors = []

# Test 1: TV extracted, Bose skipped, vote-based counting (2 scans → TV counts)
lines1 = [
    "2026-06-19T12:00:00Z n n=2 devices=[-72|AA:BB:CC:00:00:01|[TV] Samsung 5 Series -43|11:22:33:44:55:66|LE-Bose Revolve SoundLink]",
    "2026-06-19T12:01:00Z n n=2 devices=[-72|AA:BB:CC:00:00:01|[TV] Samsung 5 Series -43|11:22:33:44:55:66|LE-Bose Revolve SoundLink]",
]
vote, rssi, min_v, sc = parse_scans(lines1)
confirmed = [n for n,c in vote.items() if c >= min_v]
if len(confirmed) != 1:
    errors.append(f"T1 TV count wrong (got {len(confirmed)} {confirmed})")
if any("Bose" in n for n in confirmed):
    errors.append("T1 Bose should be skipped")

# Test 2: RSSI filter — TV at -95 excluded
lines2 = ["2026-06-19T12:00:00Z n n=1 devices=[-95|AA:BB:CC:00:00:02|[TV] Far Samsung]"]
vote2, _, _, _ = parse_scans(lines2)
if vote2:
    errors.append(f"T2 RSSI -95 TV should be excluded (got {vote2})")

# Test 3: Vote filter — TV in 1 of 4 scans → excluded (min_votes=2)
# Empty scans (devices=[]) are counted toward scan_count so the 1 sighting is diluted.
lines3 = [
    "2026-06-19T12:00:00Z n n=1 devices=[-72|AA:BB:CC:00:00:03|[TV] Samsung rare]",
    "2026-06-19T12:01:00Z n n=0 devices=[]",
    "2026-06-19T12:02:00Z n n=0 devices=[]",
    "2026-06-19T12:03:00Z n n=0 devices=[]",
]
vote3, _, min_v3, sc3 = parse_scans(lines3)
confirmed3 = [n for n,c in vote3.items() if c >= min_v3]
if confirmed3:
    errors.append(f"T3 TV in 1/{sc3} scans should not count (min_votes={min_v3}, got {confirmed3})")

# Test 4: RSSI band — TV at -82 is FAR (< -75 dBm), TV at -60 is NEARBY (>= -75 dBm)
# Note: RSSI is negative; -60 > -75 (stronger signal = more negative = closer).
lines4 = [
    "2026-06-19T12:00:00Z n n=2 devices=[-82|AA:BB:CC:00:00:04|[TV] Far TV -60|BB:BB:BB:BB:BB:01|[TV] Near TV]",
    "2026-06-19T12:01:00Z n n=2 devices=[-82|AA:BB:CC:00:00:04|[TV] Far TV -60|BB:BB:BB:BB:BB:01|[TV] Near TV]",
]
vote4, rssi4, min_v4, _ = parse_scans(lines4)
confirmed4 = [n for n,c in vote4.items() if c >= min_v4]
nearby4 = [n for n in confirmed4 if rssi4.get(n,-999) >= -75]
far4    = [n for n in confirmed4 if rssi4.get(n,-999) < -75]
if len(nearby4) != 1 or len(far4) != 1:
    errors.append(f"T4 RSSI bands wrong: nearby={nearby4} far={far4}")

# Test 5: total RF-silence — all-empty window has 0 non-empty scans; a window with
# real device entries counts them (mirrors the main parser nonempty_scans logic).
def count_nonempty(lines):
    ne = 0
    for line in lines:
        dm = re.search(r"devices=\[(.+)\]", line)
        if dm and re.search(r"-\d+\|[0-9A-Fa-f:]{17}\|", dm.group(1)): ne += 1
    return ne
lines5 = [
    "2026-06-19T12:00:00Z n n=0 devices=[]",
    "2026-06-19T12:01:00Z n n=0 devices=[]",
    "2026-06-19T12:02:00Z n n=0 devices=[]",
    "2026-06-19T12:03:00Z n n=0 devices=[]",
]
if count_nonempty(lines5) != 0:
    errors.append(f"T5 all-empty window should have 0 non-empty scans (got {count_nonempty(lines5)})")
if count_nonempty(lines1) != 2:
    errors.append(f"T5b lines1 should have 2 non-empty scans (got {count_nonempty(lines1)})")

if errors:
    for e in errors: print("FAIL:", e)
    exit(1)
print("ok (TV+vote+Bose-skip + RSSI-filter + vote-filter + RSSI-bands + rf-silence)")
' 2>&1)"
  echo "$result" | grep -q '^ok ' || { echo "smoke-test: FAIL (python parser/logic: $result)"; exit 1; }

  # ---- Trend awk assertions (RISING window hit / INITIAL when entry too old) ----
  _TAWK='BEGIN{b="";d=9999}{split($0,a,"|");ag=now-a[1];if(ag>=600&&ag<=1800){dd=ag-900;if(dd<0)dd=-dd;if(dd<d){d=dd;b=a[2]}}}END{print b}'
  _tnow="$(date +%s)"; _tf2=0; _trend_f="$(mktemp)"
  # entry at ~15 min ago → awk should return it
  printf '%d|3\n' "$((_tnow - 900))" > "$_trend_f"
  _got="$(awk -v now="$_tnow" "$_TAWK" "$_trend_f")"
  [ "$_got" = "3" ] || { echo "  FAIL trend window: expected '3' got '$_got'"; _tf2=1; }
  # entry too old (5000s > 1800s window) → awk should return empty → INITIAL
  printf '%d|3\n' "$((_tnow - 5000))" > "$_trend_f"
  _got2="$(awk -v now="$_tnow" "$_TAWK" "$_trend_f")"
  [ -z "$_got2" ] || { echo "  FAIL trend INITIAL: too-old entry matched (got '$_got2')"; _tf2=1; }
  # entry too recent (60s < 600s floor) → awk should return empty → INITIAL
  printf '%d|5\n' "$((_tnow - 60))" > "$_trend_f"
  _got3="$(awk -v now="$_tnow" "$_TAWK" "$_trend_f")"
  [ -z "$_got3" ] || { echo "  FAIL trend INITIAL: too-recent entry matched (got '$_got3')"; _tf2=1; }
  rm -f "$_trend_f"
  [ "$_tf2" = 0 ] || { echo "smoke-test: FAIL (trend awk assertions failed)"; exit 1; }
  echo "smoke-test: ok ($result + trend: 3 assertions)"
  exit 0
}

# ---- Stale data detection ----
# presence.log not updated in > 20 min → DATA-STALE (honest degraded path, exit 0).
data_stale=0
if [ ! -s "$PRESENCE_LOG" ]; then
  data_stale=1
else
  log_mtime="$(stat -c %Y "$PRESENCE_LOG" 2>/dev/null || echo 0)"
  now_s="$(date +%s)"
  log_age_min=$(( (now_s - log_mtime) / 60 ))
  [ "$log_age_min" -gt 20 ] && data_stale=1
fi

# ---- Parse rolling 15-min window from presence.log ----
# tail -n 25: at ~70s/scan, 25 scans covers ~29 min (safe window for 15 min useful data).
# Python parser:
#   TV_RE  — known TV device patterns (incl. local neighbor device "ваня тв")
#   SKIP_RE — person/owner devices that happen to match appliance names (Bose etc.)
#   RSSI < -90 dBm excluded (noise floor / too far for a useful signal)
#   RSSI >= -75 = NEARBY; < -75 = FAR
#   vote-based: TV must appear in >= 2 scans (min 1 if < 4 scans total)
tv_count=0; tv_nearby_count=0; tv_far_count=0; ac_on=0; temp_sensor=0
appliance_names=""; scan_count=0; nonempty_scans=0

if [ "$data_stale" = 0 ]; then
  parsed="$(tail -n 25 "$PRESENCE_LOG" | python3 -c '
import sys, re

TV_RE   = re.compile(r"\[TV\]|MiTV|Bluedroid TV|Mi Box|ваня тв", re.I)
AC_RE   = re.compile(r"GR-AC_", re.I)
SENS_RE = re.compile(r"MI SCALE|LYWSD", re.I)
SKIP_RE = re.compile(r"Bose|JBL|AirPods|Galaxy Buds|Pixel|iPhone|Redmi", re.I)

tvs_vote = {}; tv_rssi = {}
ac_names = set(); sensor_names = set()
scan_count = 0
nonempty_scans = 0  # scans that saw >=1 BLE device of ANY type (TV/phone/ambient random-MAC)

for line in sys.stdin:
    # Count every scan event (including empty scans with n=0 devices=[])
    # so that min_votes tracks real scan density, not just non-empty scans.
    if not re.search(r"\bdevices=\[", line): continue
    scan_count += 1
    dm = re.search(r"devices=\[(.+)\]", line)
    if not dm: continue  # empty devices=[] — counted but no devices to parse
    inner = dm.group(1)
    entries = list(re.finditer(r"(-\d+)\|([0-9A-Fa-f:]{17})\|", inner))
    if entries: nonempty_scans += 1  # ANY device present (pre name/skip filtering)
    seen = set()
    for i, e in enumerate(entries):
        rssi = int(e.group(1))
        nstart = e.end()
        nend = entries[i+1].start() if i+1 < len(entries) else len(inner)
        name = inner[nstart:nend].rstrip("] ")
        if not name or name == "?": continue
        if SKIP_RE.search(name): continue
        if TV_RE.search(name) and rssi >= -90:
            seen.add(name)
            tv_rssi[name] = max(tv_rssi.get(name, -999), rssi)
        elif AC_RE.search(name):
            ac_names.add(name)
        elif SENS_RE.search(name):
            sensor_names.add(name)
    for n in seen:
        tvs_vote[n] = tvs_vote.get(n, 0) + 1

min_votes = 2 if scan_count >= 4 else 1
nearby = [n for n,c in tvs_vote.items() if c >= min_votes and tv_rssi.get(n,-999) >= -75]
far    = [n for n,c in tvs_vote.items() if c >= min_votes and tv_rssi.get(n,-999) < -75]
all_tv = nearby + far

print("scan_count=" + str(scan_count))
print("nonempty_scans=" + str(nonempty_scans))
print("tv_count="   + str(len(all_tv)))
print("tv_nearby="  + str(len(nearby)))
print("tv_far="     + str(len(far)))
print("ac="         + str(int(bool(ac_names))))
print("sensor="     + str(int(bool(sensor_names))))
print("appliances=" + "|".join(
    ["TV:" + n for n in all_tv] +
    ["AC:" + n for n in sorted(ac_names)] +
    ["sensor:" + n for n in sorted(sensor_names)]
))
' 2>/dev/null || true)"

  while IFS='=' read -r key val; do
    case "$key" in
      scan_count)  scan_count="$val" ;;
      nonempty_scans) nonempty_scans="$val" ;;
      tv_count)    tv_count="$val" ;;
      tv_nearby)   tv_nearby_count="$val" ;;
      tv_far)      tv_far_count="$val" ;;
      ac)          ac_on="$val" ;;
      sensor)      temp_sensor="$val" ;;
      appliances)  appliance_names="${val//|/ }" ;;
    esac
  done <<< "$parsed"
fi

# ---- Trend detection: compare current tv_count to a reading ~15 min ago ----
# Appends epoch|tv_count to TREND_STATE on every non-stale run; keeps last 20 lines.
# Window: 600–1800 s, pick entry closest to 900 s (15 min) for the comparison baseline.
# trend=INITIAL means not enough history yet — consumers treat it as unknown, not STABLE.
TREND_STATE="$HOME/.mesh/.ambient-clock-trend"
NOW_EPOCH="$(date +%s)"
trend="INITIAL"
_TAWK='BEGIN{b="";d=9999}{split($0,a,"|");ag=now-a[1];if(ag>=600&&ag<=1800){dd=ag-900;if(dd<0)dd=-dd;if(dd<d){d=dd;b=a[2]}}}END{print b}'
if [ "$data_stale" = 0 ] && [ -f "$TREND_STATE" ]; then
  _older="$(awk -v now="$NOW_EPOCH" "$_TAWK" "$TREND_STATE" 2>/dev/null || true)"
  if [ -n "$_older" ] && [ "$_older" -eq "$_older" ] 2>/dev/null; then
    if   [ "$tv_count" -gt "$_older" ]; then trend="RISING"
    elif [ "$tv_count" -lt "$_older" ]; then trend="FALLING"
    else trend="STABLE"
    fi
  fi
fi
if [ "$data_stale" = 0 ]; then
  printf '%d|%d\n' "$NOW_EPOCH" "$tv_count" >> "$TREND_STATE"
  { tail -n 20 "$TREND_STATE" > "${TREND_STATE}.tmp" && mv "${TREND_STATE}.tmp" "$TREND_STATE"; } 2>/dev/null || true
fi

# ---- Total RF-silence detection (honest-degraded fidelity, 2026-06-24) ----
# A QUIET "no appliances" verdict normally still rides over ambient BLE (neighbor phones,
# random-MAC beacons). When EVERY scan in the window saw zero devices of ANY type
# (nonempty_scans=0 over a non-thin window), the BLE field is RF-SILENT — a distinct,
# rarer condition than "TVs off". data_stale only catches a log too OLD; this catches a
# FRESH log that is wholly empty. Each scan was a confident EMPTY (mesh-presence already
# qualifies n=0; SUSPECT empties never reach presence.log as authoritative), so this stays
# exit 0 — but it is surfaced distinctly, never collapsed into a normal "no appliances".
silent_field=0
if [ "$data_stale" = 0 ] && [ "${nonempty_scans:-0}" -eq 0 ] && [ "$scan_count" -ge 4 ]; then
  silent_field=1
fi

# ---- Derive ambient label ----
HOUR="$(date +%H)"
label="QUIET"
detail=""

if [ "$data_stale" = 1 ]; then
  label="DATA-STALE"
  detail="presence.log >20min old — BLE data unavailable"
elif [ "$tv_count" -ge 3 ] || [ "$tv_nearby_count" -ge 2 ]; then
  label="ACTIVE"
  detail="${tv_count} TVs on (${tv_nearby_count} nearby, ${tv_far_count} neighbor-range)"
elif [ "$tv_count" -ge 1 ]; then
  label="MODERATE"
  if [ "$tv_nearby_count" -ge 1 ]; then
    detail="${tv_count} TV(s) on incl. ${tv_nearby_count} nearby (≥-75dBm)"
  else
    detail="${tv_count} TV(s) on in neighbor range (<-75dBm)"
  fi
fi

[ "$ac_on" = 1 ]     && detail="${detail:+$detail, }AC running → hot outside"
[ "$temp_sensor" = 1 ] && detail="${detail:+$detail, }temp sensor active"
[ -z "$detail" ]     && detail="no appliances in last ${scan_count} scans"

# Late-night override only when genuinely quiet (not stale)
if [ "$label" = "QUIET" ] && { [ "$HOUR" -ge 23 ] || [ "$HOUR" -le 5 ]; }; then
  label="NIGHT-QUIET"
  detail="no TVs, late hour (${scan_count} scans)"
fi

# RF-silence annotation: append AFTER the night override so the empty-field signal rides on
# whatever quiet label applies, making it visibly different from a normal "no appliances".
if [ "$silent_field" = 1 ]; then
  detail="${detail} · RF-SILENT (0 BLE devices of any type across ${scan_count} scans — empty field, not just appliances-off)"
fi

trend_sfx=""
[ "$trend" != "INITIAL" ] && trend_sfx=" [$trend]"
output="${label}${trend_sfx} — ${detail} (${appliance_names:-none})"

case "${1:-}" in
  --edge)
    prev="$(cat "$STATE_FILE" 2>/dev/null || echo "")"
    if [ "$label" != "$prev" ]; then
      printf '%s\n' "$label" > "$STATE_FILE"
      printf '[ambient-clock] %s\n' "$output"
      command -v mesh-chat >/dev/null 2>&1 && \
        mesh-chat "[ambient-clock] $output" >/dev/null 2>&1 || true
    fi
    # touch every run so state-file mtime tracks last-RUN not last-CHANGE
    [ -e "$STATE_FILE" ] && touch "$STATE_FILE" 2>/dev/null || printf '%s\n' "$label" > "$STATE_FILE"
    ;;
  --json)
    printf '{"label":"%s","tv_count":%d,"tv_nearby":%d,"tv_far":%d,"ac_on":%s,"data_stale":%s,"silent_field":%s,"scan_count":%d,"nonempty_scans":%d,"trend":"%s","ts":"%s","detail":"%s"}\n' \
      "$label" "$tv_count" "$tv_nearby_count" "$tv_far_count" \
      "$([ "$ac_on" = 1 ] && echo true || echo false)" \
      "$([ "$data_stale" = 1 ] && echo true || echo false)" \
      "$([ "$silent_field" = 1 ] && echo true || echo false)" \
      "$scan_count" "$nonempty_scans" "$trend" "$TS" "$detail"
    ;;
  *)
    printf 'ambient: %s\n' "$output"
    ;;
esac
