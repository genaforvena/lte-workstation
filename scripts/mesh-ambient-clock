#!/usr/bin/env bash
# mesh-ambient-clock — ambient social clock derived from fixed-appliance BLE cycling.
# Harvests devices excluded from mesh-arrivals (TVs, ACs, smart-home) whose on/off
# BLE beaconing encodes neighbor activity and environmental state:
#   TV_COUNT > 0        → neighbors home / evening time
#   GR-AC_ seen        → someone running AC → it's hot
#   LYWSD03MMC seen    → temperature sensor active
#   All TVs gone       → late night / neighbors asleep
#
# Reads the arrivals.state file (updated by mesh-arrivals) and/or presence.log.
# Emits a one-line ambient label + breakdown.
#
#   mesh-ambient-clock            one-shot label
#   mesh-ambient-clock --edge     emit only when label changes (for cron/stream wiring)
#   mesh-ambient-clock --json     machine-readable
#   mesh-ambient-clock --test     smoke test
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes" 2>/dev/null || true
[ -r "$HOME/.local/bin/mesh-patterns.sh" ] && . "$HOME/.local/bin/mesh-patterns.sh" 2>/dev/null || true
# Inline fallback if patterns not yet deployed
MESH_FIXED_RE="${MESH_FIXED_RE:-\[TV\]|MiTV-|Mi Box|Bluedroid TV|GR-AC_|MI SCALE|LYWSD|Vega BLE|GEELY_BT|CAR-BT}"

PRESENCE_LOG="$HOME/.mesh/presence.log"
STATE_FILE="$HOME/.mesh/.ambient-clock.state"
TS="$(date -u +%FT%TZ)"

[ "${1:-}" = --test ] && {
  # Real dep: python3 — used for presence.log parsing (line ~41); grep/~/.mesh are always present
  command -v python3 >/dev/null 2>&1 || { echo "smoke-test: FAIL (no python3 — required for presence.log parsing)"; exit 1; }
  # Dry-run: feed a synthetic presence line through the embedded parser and verify it extracts names
  result="$(printf 'devices=[-72|AA:BB:CC:DD:EE:FF|[TV] Samsung 6 Series (49) -65|11:22:33:44:55:66|Bose Revolve]\n' | python3 -c '
import sys, re
seen = set()
for line in sys.stdin:
    m = re.search(r"devices=\[(.+)\]", line)
    if not m: continue
    inner = m.group(1)
    entries = list(re.finditer(r"-\d+\|[0-9A-Fa-f:]{17}\|", inner))
    for i, e in enumerate(entries):
        nstart = e.end()
        nend = entries[i+1].start() if i+1 < len(entries) else len(inner)
        name = inner[nstart:nend].rstrip("] ")
        if name and name != "?": seen.add(name)
print("\n".join(sorted(seen)))
' 2>&1)" || { echo "smoke-test: FAIL (python3 presence parser errored)"; exit 1; }
  echo "$result" | grep -q '\[TV\] Samsung' \
    || { echo "smoke-test: FAIL (parser extracted wrong names; got: $result)"; exit 1; }
  echo "smoke-test: ok (python3 ok; presence parser correctly extracts device names)"
  exit 0
}

# ---- Read fixed appliances from latest presence.log (last 2 scans) ----
tv_count=0; ac_on=0; scale_on=0; temp_sensor=0; appliance_names=""

if [ -s "$PRESENCE_LOG" ]; then
  # Format: devices=[-RSSI|MAC|Name -RSSI|MAC|Name ...]
  # Use python3 to split on the -RSSI|MAC| separator (names can contain spaces and '[')
  names="$(tail -n 2 "$PRESENCE_LOG" | python3 -c '
import sys, re
seen = set()
for line in sys.stdin:
    m = re.search(r"devices=\[(.+)\]", line)
    if not m: continue
    inner = m.group(1)
    entries = list(re.finditer(r"-\d+\|[0-9A-Fa-f:]{17}\|", inner))
    for i, e in enumerate(entries):
        nstart = e.end()
        nend = entries[i+1].start() if i+1 < len(entries) else len(inner)
        name = inner[nstart:nend].rstrip("] ")
        if name and name != "?": seen.add(name)
print("\n".join(seen))
' 2>/dev/null)"

  while IFS= read -r name; do
    [ -z "$name" ] && continue
    printf '%s' "$name" | grep -qiE "$MESH_FIXED_RE" || continue
    case "$name" in
      *\[TV\]*|*MiTV*|*Samsung*TV*|*Bluedroid\ TV*|*Mi\ Box*)
        tv_count=$((tv_count+1)); appliance_names="${appliance_names}TV:${name} ";;
      *GR-AC_*)
        ac_on=1; appliance_names="${appliance_names}AC:${name} ";;
      *MI\ SCALE*|*LYWSD*)
        temp_sensor=1; appliance_names="${appliance_names}sensor:${name} ";;
      *)
        appliance_names="${appliance_names}${name} ";;
    esac
  done <<< "$names"
fi

# ---- Derive ambient label ----
HOUR="$(date +%H)"
label="QUIET"
detail=""

if [ "$tv_count" -ge 3 ]; then
  label="ACTIVE"; detail="${tv_count} TVs on"
elif [ "$tv_count" -ge 1 ]; then
  label="MODERATE"; detail="${tv_count} TV(s) on"
fi

[ "$ac_on" = 1 ] && detail="${detail:+$detail, }AC running → hot outside"
[ "$temp_sensor" = 1 ] && detail="${detail:+$detail, }temp sensor active"
[ -z "$detail" ] && detail="no appliances visible"

# Late-night override
if [ "$tv_count" = 0 ] && { [ "$HOUR" -ge 23 ] || [ "$HOUR" -le 5 ]; }; then
  label="NIGHT-QUIET"; detail="no TVs, late hour"
fi

output="${label} — ${detail} (${appliance_names:-none})"

case "${1:-}" in
  --edge)
    prev="$(cat "$STATE_FILE" 2>/dev/null || echo "")"
    if [ "$label" != "$prev" ]; then
      printf '%s\n' "$label" > "$STATE_FILE"
      printf '[ambient-clock] %s\n' "$output"
      command -v mesh-chat >/dev/null 2>&1 && \
        mesh-chat "[ambient-clock] $output" >/dev/null 2>&1 || true
    fi
    ;;
  --json)
    printf '{"label":"%s","tv_count":%d,"ac_on":%s,"ts":"%s","detail":"%s"}\n' \
      "$label" "$tv_count" "$([ "$ac_on" = 1 ] && echo true || echo false)" "$TS" "$detail"
    ;;
  *)
    printf 'ambient: %s\n' "$output"
    ;;
esac
