  wraw="$(WIFI="$wf" LEADLAG_PRESENCE="$_td/empty.log" LEADLAG_WINDOW_H=48 LEADLAG_BIN_S=300 LEADLAG_MIN_OVERLAP=8 LEADLAG_PERM=120 analyze "$_td/empty.log" 2>/dev/null)"
  printf '%s\n' "$wraw" | grep -q 'wifi APX movement PREDICTS wifi APY' \
    || { echo "  FAIL: wifi.log lead (APX→APY) not surfaced from the wifi tape: $wraw"; fail=1; }
