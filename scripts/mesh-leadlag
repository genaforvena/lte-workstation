  xraw="$(WIFI="$wfl" WIFI_IMAC="$wfi" LEADLAG_PRESENCE="$_td/empty.log" LEADLAG_WINDOW_H=48 LEADLAG_BIN_S=300 LEADLAG_MIN_OVERLAP=8 LEADLAG_PERM=120 analyze "$_td/empty.log" 2>/dev/null)"
