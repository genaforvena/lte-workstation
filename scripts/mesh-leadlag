  if printf '%s\n' "$raw" | grep -q 'wifi '; then echo "  FAIL: wifi channels leaked into the BLE-only run: $raw"; fail=1; fi

  # CROSS-NODE LAGGED LEAD: the SAME SSID "SHARED" seen by two nodes — local wifi.log vs the iMac tape
  # (LEADLAG_WIFI_IMAC) — where the iMac vantage LEADS the local one by 2 bins. The node-prefix must
  # keep the two vantages as DISTINCT channels ("wifi imac-SHARED" → "wifi SHARED"); without it they'd
