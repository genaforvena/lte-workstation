import sys,datetime as dt
out=open(sys.argv[1],"w"); base=dt.datetime(2026,6,20,0,0,0,tzinfo=dt.timezone.utc)
N=150
wedge=[(7,11),(19,23),(28,32),(41,45),(53,57),(64,68),(77,81),(90,95),(104,108),(119,124),(133,137)]
# irregular, [start,end): the scans RUN, and come back EMPTY. Eleven of them, because the surrogate
# null is strong here on purpose: both channels inherit the SAME inter-event intervals from the same
# wedges, so a shuffled null re-aligns them often (18/200 at six wedges, p=0.065 — the trap did not
# even clear the null). Eleven wedges put the observed coincidence at p=0.005 and make the guard the
# only thing standing between the wedge and a "rhythm".
down=set(i for a,b in wedge for i in range(a,b))
back=[b for a,b in wedge]
for i in range(N):
    t=(base+dt.timedelta(seconds=300*i)).strftime("%Y-%m-%dT%H:%M:%SZ")
    if i in down:                                            # the radio is wedged: cadence perfect,
        out.write("%s host n=0 devices=[]\n"%t); continue    # every channel reads absent
    d=[]
    d.append("-55|AA:AA:AA:AA:AA:2A|Fast")                                   # rediscovered FIRST
    if i not in back: d.append("-60|BB:BB:BB:BB:BB:2B|Slow")                 # one scan later
    out.write("%s host n=%d devices=[%s]\n"%(t,len(d)," ".join(d)))
out.close()
PY
  _bcall(){ LEADLAG_PRESENCE="$bp" LEADLAG_WINDOW_H=48 LEADLAG_PERM=200 analyze "$bp"; }
  boff="$( EV_BLACKOUT=0; _bcall )"
  bon="$(_bcall)"
  printf '%s\n' "$boff" | grep -q 'when Fast APPEARS, Slow appears' \
    || { echo "  FAIL: fixture is not a trap — no blackout-driven coincidence even with the guard OFF: $boff"; fail=1; }
  printf '%s\n' "$bon" | grep -q 'RHYTHM/EVENT-COINCIDENCE' \
    && { echo "  FAIL: blackout rediscovery emitted as a rhythm — the blackout guard did not bite: $bon"; fail=1; }


  # ── PARTIAL COMMON MODE — the REACH CONTROL, sibling of the blackout leg above ────────────────
  # The blackout fixture wedges the radio: the census COLLAPSES and those bins leave the pool. This
  # one never collapses anything. An Anchor is present in every single bin, the cadence is perfect,
  # and the scan always returns something — only the receiver's REACH breathes: inside a rare,
  # irregular episode each marginal channel appears INDEPENDENTLY with its own probability, and
  # outside one none do. There is NO pair coupling planted anywhere in this tape.
  # WHY IT IS A REAL TRAP AND NOT A STRAW MAN: it clears every guard that already existed. The
  # census never collapses so the blackout rule removes nothing; the marginals are deliberately
  # unequal (0.30 vs 0.95 + a background rate) so the net asymmetry clears EV_ASYM on base rates
  # alone; and — the point — it clears the SURROGATE NULL at p=0.030, because that null relays each
  # channel's intervals from an INDEPENDENT random start and therefore destroys, in every surrogate,
  # the shared episodes that produced the coincidence. A null built from two independent marginals
  # cannot price a coincidence made by a covariate they share. Asserted BOTH ways below.
  # Seed 17 is pinned: at nep=10/seed=23 the same generator happens to place a pair that IS more
  # aligned than the tape (ratio 3.21) and this control correctly does NOT fire — it is a guard
  # against the common-mode shape, not a claim to catch every false positive.
  rp="$_td/reach.log"
  python3 - "$rp" <<'PY'
import sys,random,datetime as dt
out=open(sys.argv[1],"w"); base=dt.datetime(2026,6,20,0,0,0,tzinfo=dt.timezone.utc); r=random.Random(17)
N=280; starts=sorted(r.sample(range(4,N-5),8)); epi=set()
for s0 in starts:
    for j in range(s0,min(s0+r.randint(2,4),N)): epi.add(j)
chans=[("Far1",0.30),("Far2",0.95),("Far3",0.45),("Far4",0.30)]   # unequal marginals ON PURPOSE
for i in range(N):
    t=(base+dt.timedelta(seconds=300*i)).strftime("%Y-%m-%dT%H:%M:%SZ")
    d=["-50|FF:FF:FF:FF:FF:FF|Anchor"]                            # census NEVER collapses
    for n,(nm,p) in enumerate(chans):
        if (i in epi and r.random()<p) or (n==1 and r.random()<0.05):
            d.append("-7%d|AA:AA:AA:AA:AA:0%d|%s"%(n,n,nm))
    out.write("%s host n=%d devices=[%s]\n"%(t,len(d)," ".join(d)))
out.close()
PY
  _rcall(){ LEADLAG_PRESENCE="$rp" LEADLAG_WINDOW_H=48 LEADLAG_PERM=200 analyze "$rp"; }
  roff="$( EV_REACH=0; _rcall )"
  ron="$(_rcall)"
  printf '%s\n' "$roff" | grep -q 'RHYTHM/EVENT-COINCIDENCE' \
    || { echo "  FAIL: fixture is not a trap — the partial-reach tape produced no coincidence even with the reach control OFF, so the guard below proves nothing: $roff"; fail=1; }
  printf '%s\n' "$roff" | grep -qE 'surrogate p=0\.0[0-4][0-9]?' \
    || { echo "  FAIL: the partial-reach trap did not CLEAR the surrogate null, so it does not demonstrate the null blind spot: $roff"; fail=1; }
  printf '%s\n' "$ron" | grep -q 'RHYTHM/EVENT-COINCIDENCE' \
    && { echo "  FAIL: a tape-wide reach episode was emitted as a pair coupling — the reach control did not bite: $ron"; fail=1; }
  printf '%s\n' "$ron" | grep -q 'REACHDROP' \
    || { echo "  FAIL: the reach control dropped a finding SILENTLY — a refusal must be legible or it reads as a quiet tape: $ron"; fail=1; }

  # AND IT MUST NOT EAT A GENUINE PAIR. The Door→Phone tape above carries an independent flapper, so
  # the control is EVALUABLE there — assert it actually ran and cleared on a real ratio, otherwise a
  # guard that is vacuously n/a on every real tape would look identical to a working one.
  printf '%s\n' "$eraw" | grep -qE 'reach-control: pair enrichment' \
    || { echo "  FAIL: the genuine Door→Phone coupling passed WITHOUT an evaluated reach control (vacuous guard): $eraw"; fail=1; }
  printf '%s\n' "$eraw" | grep -q 'reach-control=na' \
    && { echo "  FAIL: the reach control rendered na on a tape that HAS a third onsetting channel: $eraw"; fail=1; }

  # THE UNEVALUABLE EDGE IS LOUD, NOT SILENT. Same planted coupling with the flapper REMOVED: there
  # is no third onsetting channel, so the control cannot run. Missing evidence is not counter-evidence
  # (the edge the hold-out gate draws too), so the finding is still emitted — but it must SAY it was
  # untested rather than wear a silent clear.
  np2="$_td/events-noflap.log"
  python3 - "$np2" <<'PY'
import sys,datetime as dt
out=open(sys.argv[1],"w"); base=dt.datetime(2026,6,20,0,0,0,tzinfo=dt.timezone.utc)
N=60; door=[3,11,14,22,31,35,44,52]; phone=[d+2 for d in door]
for i in range(N):
    t=(base+dt.timedelta(seconds=300*i)).strftime("%Y-%m-%dT%H:%M:%SZ")
    d=["-50|FF:FF:FF:FF:FF:FF|Anchor"]
    if i in door:  d.append("-55|AA:AA:AA:AA:AA:0D|Door")
    if i in phone: d.append("-60|BB:BB:BB:BB:BB:0B|Phone")
    out.write("%s host n=%d devices=[%s]\n"%(t,len(d)," ".join(d)))
out.close()
PY
  nf="$(LEADLAG_PRESENCE="$np2" LEADLAG_WINDOW_H=48 LEADLAG_PERM=200 analyze "$np2")"
  printf '%s\n' "$nf" | grep -q 'when Door APPEARS, Phone appears' \
    || { echo "  FAIL: an unevaluable reach control was treated as counter-evidence and ate a genuine coupling: $nf"; fail=1; }
  printf '%s\n' "$nf" | grep -q 'reach-control=na' \
    || { echo "  FAIL: an unevaluable reach control passed SILENTLY — untested must not read as cleared: $nf"; fail=1; }

  # GRID DERIVED FROM THE TAPE — a 600s producer (the real cadence of mesh-presence/mesh-wifiscan).
  # Pinned at the old 300s default the delta lane is STRUCTURALLY empty (no two adjacent bins can
  # both be populated); auto-raised to the tape's own cadence the planted 2-scan lead is recovered.
  gp="$_td/grid600.log"
  python3 - "$gp" <<'PY'
import sys,datetime as dt
out=open(sys.argv[1],"w"); base=dt.datetime(2026,6,20,0,0,0,tzinfo=dt.timezone.utc)
N=48; drv=[]; _x=31337
for _ in range(N+4):
    _x=(_x*1103515245+12345)&0x7fffffff; drv.append(_x%21-10)
for i in range(N):
    t=(base+dt.timedelta(seconds=600*i)).strftime("%Y-%m-%dT%H:%M:%SZ")   # 600s = the live cadence
    wa=-55+drv[i+2]; lb=-60+drv[i]; nc=-70+((i*37)%11-5)
    out.write("%s host n=3 devices=[%d|AA:AA:AA:AA:AA:AA|WatchA %d|BB:BB:BB:BB:BB:BB|LampB %d|CC:CC:CC:CC:CC:CC|NoiseC]\n"%(t,wa,lb,nc))
out.close()
PY
  _gcall(){ LEADLAG_PRESENCE="$gp" LEADLAG_WINDOW_H=48 LEADLAG_PERM=120 analyze "$gp"; }
  gpin="$( BIN_AUTO=0; _gcall )"
  gauto="$(_gcall)"
  [ -z "$gpin" ] || { echo "  FAIL: 300s grid on a 600s tape should be structurally empty, got: $gpin"; fail=1; }
  printf '%s\n' "$gauto" | grep -q 'WatchA movement PREDICTS LampB' \
    || { echo "  FAIL: auto-derived grid did not recover the lead on a 600s tape: $gauto"; fail=1; }
  printf '%s\n' "$gauto" | grep -q '~20 min later' \
    || { echo "  FAIL: auto grid recovered the lead at the wrong delay (2 bins x 600s = 20 min): $gauto"; fail=1; }
  printf '%s\n' "$gauto" | grep -q 'grid auto-raised 300s->600s' \
    || { echo "  FAIL: the emitted finding does not disclose the auto-raised grid: $gauto"; fail=1; }

  # seed write + floor-gate parity
  MESH="$_td" LEADLAG_PRESENCE="$tp" LEADLAG_WINDOW_H=48 LEADLAG_MIN_OVERLAP=8 LEADLAG_PERM=120 IDEATE_FLOOR=1 bash "$0" >/dev/null 2>&1
  n="$(grep -c '^\[ \] LEAD-LAG' "$_td/ideas-queue" 2>/dev/null)"; n="${n:-0}"
  [ "$n" = "1" ] || { echo "  FAIL: expected exactly 1 emitted finding, got $n: $(cat "$_td/ideas-queue" 2>/dev/null)"; fail=1; }
  grep -qF "$(printf 'WatchA\tLampB')" "$_td/.correlation-seeds" 2>/dev/null || { echo "  FAIL: directed seed WatchA->LampB not written: $(cat "$_td/.correlation-seeds" 2>/dev/null)"; fail=1; }
  # floor-gate: a busy queue must HOLD
  printf '[ ] something open\n' > "$_td/ideas-queue"
  out2="$(MESH="$_td" LEADLAG_PRESENCE="$tp" LEADLAG_WINDOW_H=48 LEADLAG_MIN_OVERLAP=8 LEADLAG_PERM=60 IDEATE_FLOOR=1 bash "$0" 2>&1)"
  echo "$out2" | grep -qi 'hold' || { echo "  FAIL: floor-gate did not hold on non-empty queue: $out2"; fail=1; }
  [ "$fail" = 0 ] && { echo "smoke-test: ok (recovered WatchA→LampB @10min lag; wifi APX→APY; cross-node iMac-SHARED→local-SHARED @10min lag; noise rejected by permutation; event lane: Door→Phone onset coupling @10min recovered, flapper+independent-onsets rejected, wedge rediscovery caught by the blackout guard; REACH CONTROL: a partial-common-mode tape that clears the blackout rule, the asymmetry floor AND the surrogate null (p=0.030) is emitted as a pair gate-off and refused-out-loud gate-on, while a genuine pair passes on an EVALUATED ratio and the unevaluable edge renders a LOUD na; 600s tape: dead at a pinned 300s grid, lead recovered at the auto-derived one; net IS |fwd r|-|rev r| in the published line, a persistence-only asymmetry (proven a trap in numbers) is not a lead, an unevaluable reverse is not a zero reverse; 1 finding; directed seed; floor-gate holds; HOLD-OUT: an un-replicated lead surfaces gate-off and is dropped gate-on, a lead that replicates survives AND publishes its out-of-window r + presence coverage, a tape with no past renders the honest UNREPLICATED na)"; exit 0; } || { echo "smoke-test: FAIL"; exit 1; }
fi

[ -f "$PRESENCE" ] || { echo "$(ts) mesh-leadlag: no presence log yet ($PRESENCE) — need a live numeric source" >&2; exit 1; }

raw="$(analyze "$PRESENCE")" || { echo "$(ts) mesh-leadlag: analyze failed" >&2; exit 1; }

# SEED the connection generator with the TOP finding (not on --dry: preview must be side-effect-free).
if [ "$mode" != "dry" ] && [ -n "$raw" ]; then
  IFS=$'\t' read -r _sc _kind _tk _ttext <<< "$(printf '%s\n' "$raw" | head -1)"
  [ -n "$_tk" ] && write_seed "$_tk" "$_ttext"
fi

if [ "$mode" = "dry" ]; then
  if [ -z "$raw" ]; then echo "$(ts) mesh-leadlag: no stream predicts another above the permutation null (honest empty, not a failure — need more data / more live numeric streams / cross-node tapes)"; else echo "$raw"; fi
  exit 0
fi

# FLOOR gate — one provocation at a time (mesh-ideate discipline).
floor="${IDEATE_FLOOR:-1}"
open=$(grep -c '^\[ \]' "$Q" 2>/dev/null); open="${open:-0}"
if [ "$open" -ge "$floor" ]; then
  # CONJUGATION AUDIT (D&G, 2026-08-19) — split the hold into "held with a fresh finding" (a real
  # relative stoppage by the single-slot queue floor) vs "held with nothing to say". Rationale and
  # citations in mesh-cooscillate's block of the same name; the candidates are in hand here, so the
  # count is free, and without it a hold count is NOT a suppression count.
  _sup=0; _sup_top=""
  while IFS=$'\t' read -r _ss _sk _skey _stext; do
    [ -z "$_stext" ] && continue
    [ "$_sk" = "REACHDROP" ] && continue          # a refusal note is not a suppressed candidate
    recent_has "$_skey" && continue
    _sup=$((_sup+1)); [ -z "$_sup_top" ] && _sup_top="$_skey"
  done <<< "$raw"
  echo "$(ts) mesh-leadlag: queue has $open open idea(s) (>= floor $floor) — hold, not piling on (suppressed=$_sup${_sup_top:+ top=$_sup_top})"
  mesh-state-touch "$STATE"
  exit 0
fi

idea=""; key=""
while IFS=$'\t' read -r sc kind k text; do
  [ -z "$text" ] && continue
  [ "$kind" = "REACHDROP" ] && continue           # a refusal note, never a candidate
  recent_has "$k" && continue
  idea="$text"; key="$k"; break
done <<< "$raw"

# a reach-control refusal is REPORTED, not swallowed: "no fresh finding" must not read the same for
# a quiet tape and for a tape that produced a coincidence the guard then refused.
_rdrop="$(printf '%s\n' "$raw" | awk -F'\t' '$2=="REACHDROP"{print $4}' | paste -sd'; ' -)"

[ -z "$idea" ] && { echo "$(ts) mesh-leadlag: no fresh finding (none meet thresholds, or all recently emitted)${_rdrop:+ · reach-control REFUSED: $_rdrop}"; mesh-state-touch "$STATE"; exit 0; }

exec 9>"$LOCK" 2>/dev/null || true
flock -w 30 9 2>/dev/null || true
printf '[ ] %s\n' "$idea" >> "$Q"
recent_add "$key"
echo "$(ts) mesh-leadlag: +1 finding -> ideas-queue ($key)"
