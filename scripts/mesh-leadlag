  pon="$(_pcall)"
  # THE DEFINITION GATE: net must equal |fwd r| - |reverse r|, read out of the emitted line itself.
  # This is what goes red on the real defect: under the old formula the Smooth->Jagged line ships with
  # net +0.41 against a cross difference of -0.02, and the subtraction it publishes does not check out.
  printf '%s\n' "$pon" | python3 -c '
import sys,re
bad=0; seen=0
for ln in sys.stdin:
    m=re.search(r"net directed lead (-?[0-9.]+) = \|fwd r (-?[0-9.]+)\| − \|reverse r (-?[0-9.]+)\|", ln)
    if not m: continue
    seen+=1
    net,f,rv=(float(x) for x in m.groups())
    if abs(net-(abs(f)-abs(rv)))>0.016:   # the line publishes 2 decimals; this is the rounding slack
        bad+=1; print("  net %.2f != |%.2f|-|%.2f| = %.2f"%(net,f,rv,abs(f)-abs(rv)))
if not seen: print("  NOLINES")
sys.exit(1 if (bad or not seen) else 0)' \
    || { echo "  FAIL: the published net is not |fwd r| - |reverse r| — the direction statistic is carrying something that is not a direction (a persistence difference is what it carried before 2026-08-19)"; fail=1; }
