#!/usr/bin/env bash
# orphan-ok: on-demand live presence corroborator (like mesh-keypresence / mesh-body-context) — a
#   mind/fusion-invoked LIVE probe, not a cron reflex; no per-run cache (so no STATE → no false-STALE).
# mesh-seat-presence — PHYSICAL-CONSOLE presence via systemd-logind SEAT idle hint.
#
# WHY this is a NEW, distinct sense (not covered by the existing perception set):
#   The mesh reads physical presence from the keyboard IRQ (mesh-keypresence /proc/interrupts), the
#   webcam (mesh-desk-presence), and phone/BLE/mic (mesh-operator-state). NONE reads systemd-logind's
#   SEAT IdleHint — the compositor's OWN idleness judgment for the physical console (seat0). That
#   signal is independent and richer in three ways the others lack:
#     * it covers ALL local input (keyboard + mouse + touchpad + touch + GUI), not just the kbd IRQ;
#     * it natively separates a LOCAL-SEAT session (a body at the actual screen/keyboard) from a
#       REMOTE pts/ssh session — a dozen tmux shells never look like physical presence;
#     * it survives the screen-lock (a locked GUI is still idle-tracked by logind).
#   So it answers "is a human physically AT this node's console, and active or idle?" from a vantage
#   no current sense has — directly useful when the camera is privacy-capped + the phone is offline
#   (both true on this node), where the embodied presence senses degrade to UNKNOWN.
#
# SOURCE: loginctl (systemd-logind) — user-readable, no root, no `input` group, headless-safe. We read
#   the user's LOCAL-SEAT session (Seat non-empty): State / Active / IdleHint / IdleSinceHintMonotonic,
#   and derive idle seconds = /proc/uptime (CLOCK_MONOTONIC) - IdleSinceHintMonotonic.
#
#   mesh-seat-presence          one-line verdict
#   mesh-seat-presence --json   machine-readable {verdict, active, idle_hint, idle_seconds, seat, ...}
#   mesh-seat-presence --test   smoke test (pure classify() truth table — no loginctl, no dbus)
#
# States:
#   ACTIVE-AT-CONSOLE   local seat session active + NOT idle  → a body interacting at the machine now
#   IDLE-AT-CONSOLE     local seat session active but idle    → logged in locally, no input for <Xs>
#   CONSOLE-INACTIVE    local seat session exists but Active=no → switched-away / locked to the greeter
#   NO-LOCAL-PRESENCE   no local-seat user session at all      → nobody at the physical console (REAL)
#   UNKNOWN             loginctl / logind unreachable           → cannot assess (NEVER a faked 'away')
#
# HONEST-FUSION: NO-LOCAL-PRESENCE (assessed: confirmed nobody local, exit 0) is VISIBLY DIFFERENT from
#   UNKNOWN (cannot assess — logind down, exit 2). An unreachable sensorium never renders a faked away.
# Exit: 0 = real assessment (incl. NO-LOCAL-PRESENCE) · 2 = cannot assess (UNKNOWN) — never faked.
# smoke-test: --test drives classify() over the truth table incl. the unreachable→UNKNOWN(exit2) guard.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

# classify <seat_state> <active> <idlehint> <idle_secs>  → "<VERDICT>|<reason>" ; rc 0 assessed / 2 cannot
#   seat_state: SEAT | NOSEAT | UNREACH
#   active:     yes | no | -
#   idlehint:   yes | no | -
#   idle_secs:  integer seconds, or -1 = unknown
classify() {
  local seat="$1" active="$2" idle="$3" secs="${4:--1}"
  case "$seat" in
    UNREACH) echo "UNKNOWN|logind/loginctl unreachable — cannot assess physical-console presence (NOT 'away')"; return 2 ;;
    NOSEAT)  echo "NO-LOCAL-PRESENCE|no local-seat session — nobody at the physical console (remote/headless only)"; return 0 ;;
  esac
  # seat == SEAT
  if [ "$active" != yes ]; then
    echo "CONSOLE-INACTIVE|local seat session present but inactive (switched-away / locked to greeter)"; return 0
  fi
  if [ "$idle" = yes ]; then
    if [ "$secs" -ge 0 ] 2>/dev/null; then
      echo "IDLE-AT-CONSOLE|local console active but idle ${secs}s (logged in at the machine, no input)"; return 0
    fi
    echo "IDLE-AT-CONSOLE|local console active but idle (logged in at the machine, no input)"; return 0
  fi
  echo "ACTIVE-AT-CONSOLE|a body is interacting at this node's physical console now"; return 0
}

if [ "${1:-}" = --test ]; then
  e=0; chk(){ local got="${1%%|*}"; [ "$got" = "$2" ] || { echo "  FAIL: [$3] expected $2 got $got"; e=1; }; }
  chk "$(classify SEAT yes no)"        ACTIVE-AT-CONSOLE "active local seat, not idle"
  chk "$(classify SEAT yes yes 300)"   IDLE-AT-CONSOLE   "active local seat but idle"
  chk "$(classify SEAT yes yes -1)"    IDLE-AT-CONSOLE   "idle with unknown duration still IDLE"
  chk "$(classify SEAT no  -)"         CONSOLE-INACTIVE  "seat session inactive (locked/switched-away)"
  chk "$(classify NOSEAT - -)"         NO-LOCAL-PRESENCE "no local seat = nobody at console (REAL, not away-guess)"
  chk "$(classify UNREACH - -)"        UNKNOWN           "logind unreachable → cannot assess (no faked all-clear)"
  # idle-duration must surface in the reason when known
  case "$(classify SEAT yes yes 300)" in *"idle 300s"*) ;; *) echo "  FAIL: idle 300s not reported"; e=1 ;; esac
  # exit-code contract: only UNKNOWN is exit 2; every real assessment (incl. NO-LOCAL-PRESENCE) is exit 0
  classify UNREACH - -        >/dev/null; [ "$?" = 2 ] || { echo "  FAIL: UNREACH must exit 2"; e=1; }
  classify NOSEAT  - -        >/dev/null; [ "$?" = 0 ] || { echo "  FAIL: NO-LOCAL-PRESENCE must exit 0 (it IS an assessment)"; e=1; }
  classify SEAT yes no        >/dev/null; [ "$?" = 0 ] || { echo "  FAIL: ACTIVE must exit 0"; e=1; }
  [ "$e" = 0 ] && echo "smoke-test: ok (6 truth-table + 1 duration + 3 exit-code assertions)" || echo "smoke-test: FAIL"
  exit "$e"
fi

json=0; [ "${1:-}" = --json ] && json=1
ts="$(date -u +%FT%TZ)"; host="$(hostname)"

# --- enumerate logind sessions; find the user's LOCAL-SEAT session (a body at the physical console) ---
seat_state=NOSEAT; active="-"; idle="-"; ish=""; sid=""; seatname=""; stype=""; secs=-1
if ! command -v loginctl >/dev/null 2>&1; then
  seat_state=UNREACH
else
  ids_raw="$(loginctl list-sessions --no-legend 2>/dev/null)"; rc=$?
  if [ "$rc" -ne 0 ]; then
    seat_state=UNREACH                       # logind/dbus genuinely unreachable — cannot assess
  else
    for id in $(printf '%s\n' "$ids_raw" | awk '{print $1}'); do
      s="$(loginctl show-session "$id" -p Seat -p Class -p Active -p IdleHint -p IdleSinceHintMonotonic -p Type 2>/dev/null)" || continue
      seat="$(printf '%s\n' "$s" | sed -n 's/^Seat=//p')"
      class="$(printf '%s\n' "$s" | sed -n 's/^Class=//p')"
      [ -n "$seat" ] || continue             # remote pts/ssh session: no physical seat → not local presence
      [ "$class" = user ] || continue        # skip greeter/manager classes
      sid="$id"; seat_state=SEAT; seatname="$seat"
      active="$(printf '%s\n' "$s" | sed -n 's/^Active=//p')"
      idle="$(printf '%s\n' "$s" | sed -n 's/^IdleHint=//p')"
      ish="$(printf '%s\n' "$s" | sed -n 's/^IdleSinceHintMonotonic=//p')"
      stype="$(printf '%s\n' "$s" | sed -n 's/^Type=//p')"
      break
    done
  fi
fi

# idle seconds = uptime(monotonic) - IdleSinceHintMonotonic ; only when actively idle with a real stamp
if [ "$seat_state" = SEAT ] && [ "$idle" = yes ] && [ -n "$ish" ] && [ "$ish" -gt 0 ] 2>/dev/null; then
  up_us="$(awk '{printf "%d", $1*1000000}' /proc/uptime 2>/dev/null)"
  if [ -n "$up_us" ]; then
    secs=$(( (up_us - ish) / 1000000 ))
    [ "$secs" -lt 0 ] && secs=-1            # clock skew / hint reset → unknown, never a fabricated value
  fi
fi

out="$(classify "$seat_state" "$active" "$idle" "$secs")"; ec=$?
verdict="${out%%|*}"; reason="${out#*|}"

if [ "$json" = 1 ]; then
  printf '{"verdict":"%s","seat_state":"%s","seat":"%s","active":"%s","idle_hint":"%s","idle_seconds":%s,"session":"%s","type":"%s","host":"%s","ts":"%s"}\n' \
    "$verdict" "$seat_state" "${seatname:-}" "$active" "$idle" "$secs" "${sid:-}" "${stype:-}" "$host" "$ts"
else
  echo "[seat-presence] $verdict — $reason [seat=${seatname:-none} active=$active idle=$idle] @ $host $ts"
fi
exit "$ec"
