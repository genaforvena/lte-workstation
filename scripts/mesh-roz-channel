#!/usr/bin/env bash
# mesh-roz-channel — route Rozalia's Telegram messages to the tg-roz mind window.
# mesh-voice-rx filters non-owner messages to tg-strangers.log. This reads that log,
# extracts lines from ROZ_CHAT_ID, and feeds them to the tg-roz tmux window with
# instruction to reply via mesh-tg-roz. Offset-tracked so each message arrives once.
#
#   mesh-roz-channel        poll + feed (run from cron: */1)
#   mesh-roz-channel --test
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes" 2>/dev/null

STRANGERS="$HOME/.mesh/tg-strangers.log"
OFFSET_F="$HOME/.mesh/.roz-channel.offset"
SESSION="$(hostname)"
WIN="tg-roz"

[ "${1:-}" = --test ] && {
  command -v tmux >/dev/null 2>&1 || { echo "smoke-test: FAIL (no tmux)"; exit 1; }
  [ -f "$STRANGERS" ] || { echo "smoke-test: ok (no tg-strangers.log yet; will activate when Rozalia writes)"; exit 0; }
  echo "smoke-test: ok"
  exit 0
}

[ -n "${ROZ_CHAT_ID:-}" ] || { echo "mesh-roz-channel: ROZ_CHAT_ID not set" >&2; exit 1; }

# Check the tg-roz window exists in the session
tmux has-session -t "$SESSION:$WIN" 2>/dev/null || exit 0   # window not open, skip silently

[ -f "$STRANGERS" ] || exit 0   # no strangers log yet

OFFSET="$(cat "$OFFSET_F" 2>/dev/null || echo 0)"
LINECOUNT="$(wc -l < "$STRANGERS")"
[ "$LINECOUNT" -le "$OFFSET" ] && exit 0   # nothing new

# Read new lines from offset forward, filter to Rozalia's chat_id
msgs=()
while IFS= read -r line; do
  printf '%s' "$line" | grep -q "from=${ROZ_CHAT_ID}" || continue
  # Parse: TIMESTAMP  from=ID  "message text"
  ts="$(printf '%s' "$line" | grep -oE '^[0-9TZ:]+' | head -1)"
  raw="$(printf '%s' "$line" | sed 's/^[^ ]* *from=[0-9]* *//')"
  # Decode JSON-encoded text (may have \u escapes)
  text="$(printf '%s' "$raw" | python3 -c "import json,sys; print(json.loads(sys.stdin.read().strip()))" 2>/dev/null || printf '%s' "$raw")"
  msgs+=("$ts  Rozalia: $text")
done < <(tail -n +$((OFFSET + 1)) "$STRANGERS")

# Update offset
printf '%s' "$LINECOUNT" > "$OFFSET_F"

[ "${#msgs[@]}" -eq 0 ] && exit 0

# Feed messages to the tg-roz window
for msg in "${msgs[@]}"; do
  prompt="$(cat <<EOF
Rozalia (chat_id=${ROZ_CHAT_ID}) messages you:

  ${msg}

Reply in the same language she used (Russian or English). Keep it concise and friendly.
The mesh is a home AI system — explain, assist, or chat as appropriate.
Send your reply with: mesh-tg-roz "your response here"
EOF
  )"
  mesh-tell "$WIN" "$prompt" 2>/dev/null || true
  mesh-chat "[roz-in] $msg" 2>/dev/null || true
  # Write to roz-in.log so the tg-roz data pane shows conversation history
  printf '[IN]  %s\n' "$msg" >> "$HOME/.mesh/roz-in.log"
done
