#!/usr/bin/env bash
# mesh-roz-channel — serialized, retry-safe Rozalia intake.
# reflex-cadence: off
# Event launcher: systemd/mesh-roz-channel.path and boot catch-up service.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes" 2>/dev/null

STRANGERS="${MESH_ROZ_STRANGERS:-$HOME/.mesh/tg-strangers.log}"
OFFSET_F="${MESH_ROZ_OFFSET:-$HOME/.mesh/.roz-channel.offset}"
IN_LOG="${MESH_ROZ_IN_LOG:-$HOME/.mesh/roz-in.log}"
LOCK_F="${MESH_ROZ_LOCK:-$HOME/.mesh/.roz-channel.lock}"
WIN="${MESH_ROZ_WINDOW:-tg-roz}"
ROZ="${ROZ_CHAT_ID:-}"

if [ "${1:-}" = --test ]; then
  exec python3 "$(dirname "$(readlink -f "$0")")/../tests/test-mesh-roz-channel-delivery.py"
fi
[ -n "$ROZ" ] || { echo 'mesh-roz-channel: ROZ_CHAT_ID not set' >&2; exit 1; }
[ -f "$STRANGERS" ] || exit 0

mkdir -p "$(dirname "$OFFSET_F")" "$(dirname "$IN_LOG")"
exec 9>"$LOCK_F"
flock -n 9 || exit 0
# Catch an unavailable receipt destination before dispatch. Delivery remains at-least-once
# across a crash between mesh-tell and cursor commit; the stable ask key gates side effects.
exec 8>>"$IN_LOG" || exit 1

cursor=0
if [ -f "$OFFSET_F" ]; then
  cursor=$(cat "$OFFSET_F" 2>/dev/null) || { echo 'mesh-roz-channel: unreadable cursor' >&2; exit 1; }
fi
case "$cursor" in ''|*[!0-9]*) echo 'mesh-roz-channel: invalid cursor' >&2; exit 1;; esac
# The producer appends committed newline records; in-place historical edits are not intake.
linecount=$(wc -l < "$STRANGERS") || exit 1
[ "$cursor" -le "$linecount" ] || {
  echo 'mesh-roz-channel: source truncated below cursor; reconciliation required' >&2; exit 1;
}
save_cursor(){
  local tmp
  tmp=$(mktemp "${OFFSET_F}.XXXXXX") || return 1
  printf '%s\n' "$1" > "$tmp" && mv "$tmp" "$OFFSET_F"
}

line_no=0
while IFS= read -r line; do
  line_no=$((line_no + 1))
  [ "$line_no" -gt "$cursor" ] || continue

  # Boundary matching is deliberate: from=12 must not match from=123.
  if ! printf '%s\n' "$line" | grep -qE "(^|[[:space:]])from=${ROZ}([[:space:]]|$)"; then
    save_cursor "$line_no" || exit 1
    cursor=$line_no
    continue
  fi

  tmux has-session -t "$(hostname):$WIN" 2>/dev/null || {
    echo "mesh-roz-channel: window unavailable; source line $line_no remains pending" >&2
    exit 1
  }

  ts=$(printf '%s' "$line" | grep -oE '^[0-9TZ:-]+' | head -1)
  raw=$(printf '%s' "$line" | sed "s/^[^ ]*[[:space:]]*from=${ROZ}[[:space:]]*//")
  text=$(printf '%s' "$raw" | python3 -c 'import json,sys; print(json.loads(sys.stdin.read().strip()))' 2>/dev/null) || text="$raw"
  ask="ask:tg-roz-$(printf '%s' "$line" | sha256sum | awk '{print substr($1,1,24)}')"
  prompt=$(cat <<EOF
Rozalia (chat_id=${ROZ}) sent a message at ${ts}:

${text}

This is an event-driven intake. Reconcile this source against existing completed or in-progress work and actual delivery before acting. If actionable unresolved work remains, create or reuse the appropriately owned linked task and preserve ask key ${ask}; use the operator-followthrough/subagent workflow for independent analysis. Do not replay external side effects or claim Telegram send success from this mesh-tell delivery. Reply through the authorized tg-roz channel only when the mind decides a reply is warranted.
EOF
)
  if ! mesh-tell "$WIN" "$prompt"; then
    echo "mesh-roz-channel: mesh-tell failed; source line $line_no remains pending" >&2
    exit 1
  fi

  # A successful pane dispatch is not a Telegram send receipt. This is only the private inbound history.
  printf '[IN]  %s  Rozalia: %s\n' "$ts" "$text" >&8 || exit 1
  save_cursor "$line_no" || exit 1
  cursor=$line_no
done < "$STRANGERS"
exit 0
