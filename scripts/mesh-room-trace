#!/usr/bin/env bash
# mesh-room-trace — temporal occupancy trace: was this room occupied recently?
# Fuses room-sense + proximity + light-pheromone (stigmergic) into a 4-level occupancy history.
#
# Light signal uses a DECAYING PHEROMONE SCORE rather than a binary recency flag.
# Each light-level transition detected in .light-transitions deposits PHERO_DEPOSIT to
# .light-pheromone; on every call the score evaporates with a 20-min half-life before
# being read. This is genuine stigmergy: mesh-light writes the environment (deposits
# pheromone traces); this tool reads and decays them — zero direct coupling, emergent
# coordination via shared state alone.
#
# Usage:
#   mesh-room-trace              one-shot verdict to stdout
#   mesh-room-trace --edge       only emit when trace changes (for cron wiring)
#   mesh-room-trace --json       machine-readable JSON
#   mesh-room-trace --test       smoke test (no scans)
#   mesh-room-trace --window 30  lookback window in minutes (default: 30)
#
# Signals (read from state files — zero subprocesses, instant):
#   room-sense.state:         LABEL|dwell_s=N|changes_24h=N   LABEL=PRESENT/EMPTY/UNCERTAIN
#   proximity.state:          <zone> <mac> <name>             zone=HERE/NEAR/FAR/OUT_OF_RANGE
#                             (both enrichments are LIVE; _read_state strips pipe then whitespace)
#                             the <name> is READ, not discarded — see "THE ZONE IS ABOUT A DEVICE".
#   .light-pheromone:         decaying float score (deposited by light-level transitions)
#   .light-transitions:       level|lux|epoch|change_count  (source for deposit detection)
#   activity.state:           IDLE/AMBIENT/MODERATE/ACTIVE/UNCERTAIN
#
# Trace levels:
#   OCCUPIED  = room present + (close device OR active)
#   RECENT    = room NOT present BUT light-pheromone ≥ 0.5 OR close device lingers
#   VACANT    = room empty + pheromone near-zero + no close PERSON-attributable device
#   UNKNOWN   = all signals unreachable or conflicting
#
# UNREACHABLE ≠ VACANT: missing signals render UNKNOWN, never silent all-clear.
#
# THE ZONE IS ABOUT A DEVICE, AND WHICH DEVICE DECIDES WHETHER IT IS EVIDENCE OF A PERSON.
#   `mesh-proximity`'s verdict is the strongest NAMED device in range, whatever that happens to
#   be — it measured on mesh-home that the device deciding the zone was `LE-Bose Revolve
#   SoundLink`, a STATIONARY SPEAKER, in 81.7% of 300 snapshots, and never once an operator-bound
#   device. It fixed that by spelling the identity into the record (`<zone> <mac> <name>`) so a
#   consumer could decide whether the zone is about anything it cares about. THIS READER — the
#   only consumer that gates a VERDICT on the zone — never consumed that fix: it stripped at the
#   first whitespace and fused the anonymous word. Consequences, both measured here 2026-08-20 with
#   `.proximity.state` = `HERE 28:11:A5:B8:9E:A2 LE-Bose Revolve SoundLink` (231 cron runs, zone
#   NEVER MOVED — furniture does not walk out):
#     • OCCUPIED was credited to "room present + proximity HERE" when room-sense alone had
#       already decided it, so the reason line named a corroborator that corroborated nothing;
#     • VACANT was STRUCTURALLY UNREACHABLE — its guard requires `pm != HERE && pm != NEAR`,
#       and a speaker is permanently HERE;
#     • downstream, `mesh-misha-gate`'s `room_trace_confirm_active` confirms an audio session on
#       RECENT alone, and the `proximity HERE (device lingers after room empty)` branch made that
#       confirmation PERMANENTLY TRUE — a session that can never close, held open by a speaker.
#   So the zone is now classified by its SUBJECT before it is fused, through `mesh-presence
#   --classify` (the single-source person/appliance classifier — never re-implement its pattern
#   lists here; cross-sense vocabulary drift is exactly what that CLI exists to prevent). An
#   APPLIANCE-decided HERE/NEAR fuses as `FURNITURE`: a real reading, honestly spelled, carrying no
#   occupancy information. PERSONAL/AMBIGUOUS still gate as before. A classifier that cannot be
#   reached keeps the OLD gating behaviour (the conservative direction — it can never manufacture
#   a VACANT) and says so LOUDLY on stderr, and only when the zone was HERE/NEAR, i.e. only when
#   the answer would have changed something.
#
# NOT "zero subprocesses" any more, and the old claim was already false (`_phero_update` shells to
# awk). The classifier runs at most ONCE per call and only on a HERE/NEAR zone — a FAR or absent
# zone gates nothing, so there is nothing to classify.
#
# Exit codes:
#   0 = verdict assessed (may be UNKNOWN)
#   2 = cannot assess (all signals unreachable)

set -euo pipefail

STATE_DIR="${MESH_STATE_DIR:-$HOME/.mesh}"
STATE="$STATE_DIR/.room-trace.state"
PENDING="$STATE_DIR/.room-trace.pending"
PHERO_STATE="$STATE_DIR/.light-pheromone"   # stigmergic trace: score|last_epoch
MODE="oneshot"
EDGE_WINDOW=2
LOOKBACK_MIN=30

# --- Pheromone constants ---
# DEPOSIT: score added per detected light-level transition
# HALFLIFE_S: seconds for score to decay to 50% (20 min)
# THRESHOLD_RECENT: minimum score to classify as RECENT occupancy signal
# THRESHOLD_STRONG: score indicating multiple recent transitions → high-confidence RECENT
PHERO_DEPOSIT="1.0"
PHERO_HALFLIFE_S="1200"
PHERO_THRESHOLD_RECENT="0.5"
PHERO_THRESHOLD_STRONG="2.0"

# --- Proximity subject classifier ---
# Deliberately UNQUOTED at the call site: this is a command PLUS its flag, and word-splitting is
# how it becomes one. Overridable so --test can pin a deterministic stub for the branch logic
# without losing the arm that drives the REAL binary.
PROX_CLASSIFY_CMD="${MESH_PROX_CLASSIFY_CMD:-mesh-presence --classify}"

for arg in "$@"; do
  case "$arg" in
    --edge)   MODE=edge ;;
    --json)   MODE=json ;;
    --test)   MODE=test ;;
    --window) shift; LOOKBACK_MIN="${1:-30}"; shift || true ;;
  esac
done

mkdir -p "$STATE_DIR"

# --- Read signals from state files (zero subprocesses; defined first for --test access) ---
# TWO enrichment dialects coexist in the files this reads, and neither is optional:
#   .room-sense.state:  LABEL|dwell_s=N|changes_24h=N     → PIPE-delimited
#   .proximity.state:   <zone> <mac> <name>               → WHITESPACE-delimited (mesh-proximity:314)
# So strip to the first pipe AND then to the first whitespace: a bare label, either dialect, or a
# future one that only appends, all yield the label alone. Pure parameter expansion — no head|cut
# pipeline, so `set -o pipefail` can never turn a SIGPIPE into a false read.
#
# WHY BOTH STEPS: this reader had only the pipe cut, so `.proximity.state`'s 3-field record came
# back WHOLE, matched no case arm, and rendered proximity=UNKNOWN on a fresh, VALID `NEAR` — which
# gated OCCUPIED (room present + proximity) and RECENT (device lingers) out of reach. It hid because
# this reader was ALREADY rendering UNKNOWN back when the file had no writer at all: pre-writer and
# post-writer looked identical here, so the writer landing showed up as nothing changing. (2026-08-17)
_read_state() {
  local f="$STATE_DIR/$1" line=""
  [ -f "$f" ] || { echo "__ABSENT__"; return; }   # sentinel: no writer yet ≠ a record we cannot read
  IFS= read -r line < "$f" || line=""
  line="${line%%|*}"              # room-sense dialect
  line="${line%%[[:space:]]*}"    # proximity dialect
  printf '%s\n' "$line"
}

# Loud fallback. A catch-all that silently maps an UNRECOGNIZED record to UNKNOWN is what let the
# format drift above sit undetected — "no reading" and "a reading I failed to parse" are different
# facts and must not render the same. An ABSENT file stays quiet (a sense not yet running is not
# this reader's defect); anything present-but-unparseable warns on stderr, naming the file and the
# bytes, so the next format change announces itself instead of degrading into a plausible UNKNOWN.
_drift() {
  printf 'mesh-room-trace: %s: unparseable record %q → UNKNOWN (format drift?)\n' "$1" "$2" >&2
}

# --- Proximity SUBJECT (see "THE ZONE IS ABOUT A DEVICE" above) ---------------------------------
# _read_state deliberately reduces every record to its label; these read the SAME file WHOLE, so
# the identity mesh-proximity spells into it is available to the fusion instead of being stripped.
_prox_record() {   # full first line of .proximity.state, or the __ABSENT__ sentinel
  local f="$STATE_DIR/.proximity.state" line=""
  [ -f "$f" ] || { echo "__ABSENT__"; return; }
  IFS= read -r line < "$f" || line=""
  printf '%s\n' "$line"
}

# _prox_device: fields 3.. of `<zone> <mac> <name>`. The NAME CONTAINS SPACES ("LE-Bose Revolve
# SoundLink"), so it is the whole remainder — never `cut -d' ' -f3`, which would classify the
# string "LE-Bose" and miss every multi-word device. Empty for a short/absent record.
_prox_device() {
  local rec="$1" rest name
  case "$rec" in __ABSENT__|"") printf '\n'; return ;; esac
  rest="${rec#* }"; [ "$rest" != "$rec" ] || { printf '\n'; return ; }   # drop zone
  name="${rest#* }"; [ "$name" != "$rest" ] || { printf '\n'; return ; } # drop mac
  printf '%s\n' "$name"
}

# _prox_class: name -> PERSONAL|APPLIANCE|AMBIGUOUS|UNCLASSIFIED.
# UNCLASSIFIED covers three DIFFERENT facts and the caller must not conflate them with a class:
# no device in the record, mesh-proximity's spelled `none`, and a classifier that did not answer.
_prox_class() {
  local name="$1" out=""
  case "$name" in ""|none) printf 'UNCLASSIFIED\n'; return ;; esac
  out="$($PROX_CLASSIFY_CMD "$name" 2>/dev/null)" || out=""
  case "$out" in
    PERSONAL|APPLIANCE|AMBIGUOUS) printf '%s\n' "$out" ;;
    *) printf 'UNCLASSIFIED\n' ;;
  esac
}

# --- Fusion engine (defined first for --test access) ---
# Args: room  proximity  activity  phero_score  light_prev_level  light_changes
# phero_score is a float (awk-produced); comparisons use awk for float safety.
_fuse() {
  local rm="$1" pm="$2" am="$3" ps="$4" lpc="$5" lch="$6"

  if [ "$rm" = "UNKNOWN" ] && [ "$pm" = "UNKNOWN" ] && [ "$am" = "UNKNOWN" ]; then
    verdict="UNKNOWN"; reason="all signals unreachable"; return 2
  fi

  if [ "$rm" = "PRESENT" ]; then
    if [ "$pm" = "HERE" ] || [ "$pm" = "NEAR" ]; then
      verdict="OCCUPIED"; reason="room present + proximity $pm"; return 0
    fi
    if [ "$am" = "MODERATE" ] || [ "$am" = "ACTIVE" ]; then
      verdict="OCCUPIED"; reason="room present + activity $am"; return 0
    fi
    verdict="OCCUPIED"; reason="room present (room-sense only)"; return 0
  fi

  # Pheromone-based recency: replaces binary light_changed_recently flag.
  # Score ≥ THRESHOLD_RECENT → light environment was recently disturbed (occupancy residue).
  # Score ≥ THRESHOLD_STRONG → multiple transitions → high-confidence recent activity.
  local phero_recent=0 phero_strong=0
  phero_recent="$(awk -v s="$ps" -v t="$PHERO_THRESHOLD_RECENT" 'BEGIN{print (s+0>=t)?1:0}')"
  phero_strong="$(awk -v s="$ps" -v t="$PHERO_THRESHOLD_STRONG" 'BEGIN{print (s+0>=t)?1:0}')"

  if [ "$phero_recent" = "1" ]; then
    verdict="RECENT"
    if [ "$phero_strong" = "1" ]; then
      reason="light-pheromone strong (score=${ps}, ${lch} transitions) — repeated recent activity"
    else
      reason="light-pheromone (score=${ps}, prev=${lpc}, ${lch} transitions)"
    fi
    [ "$pm" = "HERE" ] || [ "$pm" = "NEAR" ] && reason="$reason + device nearby"
    return 0
  fi
  # `pm` here is the SUBJECT-CLASSIFIED zone, never the raw one: an appliance-decided HERE/NEAR
  # arrives as FURNITURE and matches neither arm, so "device lingers" can only ever be said of a
  # device that could belong to a person.
  if [ "$pm" = "HERE" ] || [ "$pm" = "NEAR" ]; then
    verdict="RECENT"; reason="proximity $pm (device lingers after room empty)"; return 0
  fi

  if [ "$rm" = "EMPTY" ] && [ "$phero_recent" = "0" ] && [ "$pm" != "HERE" ] && [ "$pm" != "NEAR" ]; then
    verdict="VACANT"; reason="room empty + pheromone near-zero (score=${ps}) + no close person-attributable device"; return 0
  fi

  verdict="UNKNOWN"; reason="mixed: room=$rm proximity=$pm activity=$am pheromone=$ps"; return 0
}

# --- Pheromone engine ---
# _phero_update: read .light-pheromone + .light-transitions; apply decay; deposit if new
# transition detected; write updated state. Sets: phero_score, phero_changes, phero_prev_level.
_phero_update() {
  local now="$1"
  phero_score="0.0"
  phero_changes=0
  phero_prev_level="UNKNOWN"
  local stored_score="0.0" stored_epoch="$now" stored_trans_count="-1"

  # Read existing pheromone state: score|last_decay_epoch|last_known_trans_count
  if [ -f "$PHERO_STATE" ]; then
    IFS='|' read -r stored_score stored_epoch stored_trans_count < "$PHERO_STATE" 2>/dev/null || true
  fi

  # Apply exponential decay since last call: score *= e^(-ln(2)/halflife * delta_t)
  local decayed_score
  decayed_score="$(awk -v s="${stored_score:-0}" -v hl="$PHERO_HALFLIFE_S" \
      -v t0="${stored_epoch:-$now}" -v t1="$now" \
      'BEGIN { dt=t1-t0; if(dt<0)dt=0; lambda=log(2)/hl; printf "%.6f", s*exp(-lambda*dt) }')"

  # Read current transition count from mesh-light's state file (the pheromone SOURCE)
  local cur_trans_count="0" cur_level="UNKNOWN"
  local trans_file="$STATE_DIR/.light-transitions"
  if [ -f "$trans_file" ]; then
    local _lux _ts
    IFS='|' read -r cur_level _lux _ts cur_trans_count < "$trans_file" 2>/dev/null || true
    phero_prev_level="${cur_level:-UNKNOWN}"
    phero_changes="${cur_trans_count:-0}"
  fi

  # Detect new transitions since last call → deposit pheromone quantum per new transition
  local new_transitions=0
  if [ "${stored_trans_count:-0}" != "-1" ] && \
     [ -n "${cur_trans_count:-}" ] && \
     [ "${cur_trans_count:-0}" -gt "${stored_trans_count:-0}" ] 2>/dev/null; then
    new_transitions=$(( cur_trans_count - stored_trans_count ))
  elif [ "${stored_trans_count:-0}" = "-1" ] && [ "${cur_trans_count:-0}" -gt 0 ]; then
    # First run: treat existing transitions as new (seed the pheromone trail)
    new_transitions=1
  fi

  # Deposit: score += new_transitions * DEPOSIT
  phero_score="$(awk -v d="$decayed_score" -v n="$new_transitions" -v q="$PHERO_DEPOSIT" \
      'BEGIN { printf "%.6f", d + n*q }')"

  # Write updated pheromone state
  printf '%s|%s|%s\n' "$phero_score" "$now" "${cur_trans_count:-0}" > "$PHERO_STATE"
}

# --- Test mode: run assertions in subshell to isolate return 2 ---
if [ "$MODE" = "test" ]; then
  (
    set +e
    # Original fusion assertions (unchanged logic — only phero_score arg replaces binary flag)
    _fuse 'PRESENT' 'HERE' 'IDLE' '0.0' 'UNKNOWN' '0'
    [ "$verdict" = "OCCUPIED" ] || { echo "  FAIL: present+here → OCCUPIED (got $verdict)"; exit 1; }
    _fuse 'PRESENT' 'OUT_OF_RANGE' 'ACTIVE' '0.0' 'UNKNOWN' '0'
    [ "$verdict" = "OCCUPIED" ] || { echo "  FAIL: present+active → OCCUPIED (got $verdict)"; exit 1; }
    # Pheromone ≥ THRESHOLD_RECENT (1.0 ≥ 0.5) → RECENT even with empty room
    _fuse 'EMPTY' 'OUT_OF_RANGE' 'IDLE' '1.0' 'LIT' '5'
    [ "$verdict" = "RECENT" ] || { echo "  FAIL: empty+phero→RECENT (got $verdict)"; exit 1; }
    _fuse 'EMPTY' 'NEAR' 'IDLE' '0.0' 'UNKNOWN' '0'
    [ "$verdict" = "RECENT" ] || { echo "  FAIL: empty+near → RECENT (got $verdict)"; exit 1; }
    _fuse 'EMPTY' 'OUT_OF_RANGE' 'IDLE' '0.0' 'UNKNOWN' '0'
    [ "$verdict" = "VACANT" ] || { echo "  FAIL: empty+nothing → VACANT (got $verdict)"; exit 1; }
    _fuse 'UNKNOWN' 'UNKNOWN' 'UNKNOWN' '0.0' 'UNKNOWN' '0'; rc=$?
    [ "$verdict" = "UNKNOWN" ] || { echo "  FAIL: all-unknown → UNKNOWN (got $verdict)"; exit 1; }
    [ "$rc" = "2" ] || { echo "  FAIL: all-unknown → exit 2 (got $rc)"; exit 1; }
    _fuse 'UNCERTAIN' 'OUT_OF_RANGE' 'UNKNOWN' '0.0' 'UNKNOWN' '0'
    [ "$verdict" = "UNKNOWN" ] || { echo "  FAIL: uncertain → UNKNOWN (got $verdict)"; exit 1; }
    _fuse 'PRESENT' 'FAR' 'IDLE' '0.0' 'UNKNOWN' '0'
    [ "$verdict" = "OCCUPIED" ] || { echo "  FAIL: present+far → OCCUPIED (got $verdict)"; exit 1; }
    # Strong pheromone (≥ THRESHOLD_STRONG = 2.0) → RECENT with strong-reason label
    _fuse 'EMPTY' 'OUT_OF_RANGE' 'IDLE' '3.5' 'LIT' '7'
    [ "$verdict" = "RECENT" ] || { echo "  FAIL: empty+strong-phero → RECENT (got $verdict)"; exit 1; }
    printf '%s' "$reason" | grep -q 'repeated recent activity' || { echo "  FAIL: strong-phero reason should mention 'repeated recent activity' (got: $reason)"; exit 1; }
    # Pheromone just below threshold → no RECENT from light (proximity decides)
    _fuse 'EMPTY' 'OUT_OF_RANGE' 'IDLE' '0.3' 'LIT' '1'
    [ "$verdict" = "VACANT" ] || { echo "  FAIL: empty+sub-threshold-phero → VACANT (got $verdict)"; exit 1; }
    # Pheromone decay test via _phero_update: a score decays to near-zero after many halflives
    tdir="$(mktemp -d "${TMPDIR:-/tmp}"/room-trace-test.XXXXXX)"
    PHERO_STATE="$tdir/.light-pheromone"
    # Seed: score=4.0 written 3 halflives ago (3*1200=3600s), no new transitions
    printf '4.0|%s|5\n' "$(( $(date +%s) - 3600 ))" > "$PHERO_STATE"
    # Write a transitions file with same count (no new transitions)
    printf 'LIT|500|%s|5\n' "$(date +%s)" > "$tdir/.light-transitions"
    MESH_STATE_DIR="$tdir" STATE_DIR="$tdir" PHERO_HALFLIFE_S=1200 PHERO_DEPOSIT=1.0 \
      PHERO_THRESHOLD_RECENT=0.5 PHERO_THRESHOLD_STRONG=2.0 _phero_update "$(date +%s)"
    decayed_check="$(awk -v s="$phero_score" 'BEGIN{print (s+0 < 0.6) ? "ok" : "too-high"}')"
    [ "$decayed_check" = "ok" ] || { echo "  FAIL: phero after 3 halflives should be <0.6 (got $phero_score)"; rm -rf "$tdir"; exit 1; }
    # Deposit test: same file, but add 2 new transitions (count goes from 5 to 7)
    printf 'LIT|500|%s|7\n' "$(date +%s)" > "$tdir/.light-transitions"
    MESH_STATE_DIR="$tdir" STATE_DIR="$tdir" PHERO_HALFLIFE_S=1200 PHERO_DEPOSIT=1.0 \
      PHERO_THRESHOLD_RECENT=0.5 PHERO_THRESHOLD_STRONG=2.0 _phero_update "$(date +%s)"
    deposit_check="$(awk -v s="$phero_score" 'BEGIN{print (s+0 >= 1.5 && s+0 <= 2.8) ? "ok" : "out-of-range"}')"
    [ "$deposit_check" = "ok" ] || { echo "  FAIL: phero after 2 deposits should be in [1.5,2.8] (got $phero_score)"; rm -rf "$tdir"; exit 1; }
    rm -rf "$tdir"
    # --- Reader contract: drive the REAL _read_state against REAL-format fixtures. ---
    # The previous version of this gate re-implemented the head|cut pipeline inline and asserted
    # against its own copy, so it could not have gone red when the function drifted from it — and
    # did not, when .proximity.state grew two fields. Assert the FUNCTION, one fixture per dialect.
    _mfd="$(mktemp -d)"
    printf 'UNCERTAIN|dwell_s=0|changes_24h=10\n' > "$_mfd/.room-sense.state"
    printf 'NEAR 28:11:A5:B8:9E:A2 LE-Bose Revolve SoundLink\n' > "$_mfd/.proximity.state"
    printf 'ACTIVE\n' > "$_mfd/.activity.state"
    _got="$(STATE_DIR="$_mfd" _read_state .room-sense.state)"
    [ "$_got" = UNCERTAIN ] || { echo "smoke-test: FAIL (_read_state on LABEL|dwell_s= gave '$_got', want UNCERTAIN — dwell enrichment makes room read UNKNOWN)"; rm -rf "$_mfd"; exit 1; }
    # The regression lock for THIS fix: a 3-field proximity record must reduce to its zone. Break
    # the whitespace strip and this goes red with the whole line — seen red before landing.
    _got="$(STATE_DIR="$_mfd" _read_state .proximity.state)"
    [ "$_got" = NEAR ] || { echo "smoke-test: FAIL (_read_state on '<zone> <mac> <name>' gave '$_got', want NEAR — 3-field proximity record reads as UNKNOWN)"; rm -rf "$_mfd"; exit 1; }
    _got="$(STATE_DIR="$_mfd" _read_state .activity.state)"
    [ "$_got" = ACTIVE ] || { echo "smoke-test: FAIL (_read_state on a bare label gave '$_got', want ACTIVE)"; rm -rf "$_mfd"; exit 1; }
    # absent ≠ unparseable: the sentinel is what keeps the loud warn off a sense that simply has no
    # writer yet, so assert the two render distinctly at the reader.
    _got="$(STATE_DIR="$_mfd" _read_state .nonexistent.state)"
    [ "$_got" = __ABSENT__ ] || { echo "smoke-test: FAIL (absent file gave '$_got', want __ABSENT__ — absent and unparseable must not render alike)"; rm -rf "$_mfd"; exit 1; }
    # ...and that the unparseable case is LOUD (stderr names the file), never a silent UNKNOWN.
    printf 'WOBBLE\n' > "$_mfd/.proximity.state"
    # MESH_STATE_DIR, not STATE_DIR: a child bash re-derives STATE_DIR at load time, so exporting
    # the derived name would leave the child reading the LIVE ~/.mesh and the fixture asserting nothing.
    _warn="$(MESH_STATE_DIR="$_mfd" bash "$0" --json 2>&1 >/dev/null || true)"
    case "$_warn" in *".proximity.state: unparseable record"*) : ;; *) echo "smoke-test: FAIL (unparseable proximity record must warn on stderr, got '$_warn')"; rm -rf "$_mfd"; exit 1 ;; esac
    # end-to-end: the same 3-field record must reach the VERDICT, not just the reader.
    # THE SUBJECT DECIDES. This block used to assert `EMPTY room + NEAR <a Bose speaker>` fuses to
    # RECENT — it locked the bug in: a stationary APPLIANCE held the room permanently non-VACANT
    # (and, through mesh-misha-gate's RECENT-only confirm, held an audio session permanently open).
    # One fixture per class, and the personal one keeps the original "proximity gates" coverage.
    printf 'EMPTY\n' > "$_mfd/.room-sense.state"
    printf 'NEAR AA:BB:CC:DD:EE:FF iPhone 14\n' > "$_mfd/.proximity.state"
    _j="$(MESH_STATE_DIR="$_mfd" bash "$0" --json 2>/dev/null || true)"
    case "$_j" in *'"proximity":"NEAR"'*) : ;; *) echo "smoke-test: FAIL (live path did not deliver the prox VALUE for a PERSONAL subject, got '$_j')"; rm -rf "$_mfd"; exit 1 ;; esac
    case "$_j" in *'"verdict":"RECENT"'*) : ;; *) echo "smoke-test: FAIL (empty room + NEAR <personal device> must fuse to RECENT — the verdict proximity gates, got '$_j')"; rm -rf "$_mfd"; exit 1 ;; esac
    # ...and the APPLIANCE subject must NOT gate: same zone, same room, opposite verdict. Delete the
    # FURNITURE arm and this goes red with RECENT — VACANT is unreachable again.
    printf 'NEAR 28:11:A5:B8:9E:A2 LE-Bose Revolve SoundLink\n' > "$_mfd/.proximity.state"
    _j="$(MESH_STATE_DIR="$_mfd" bash "$0" --json 2>/dev/null || true)"
    case "$_j" in *'"verdict":"VACANT"'*) : ;; *) echo "smoke-test: FAIL (empty room + NEAR <stationary speaker> must fuse to VACANT — an appliance cannot hold a room occupied, got '$_j')"; rm -rf "$_mfd"; exit 1 ;; esac
    case "$_j" in *'"proximity":"FURNITURE"'*) : ;; *) echo "smoke-test: FAIL (an appliance-decided zone must fuse as FURNITURE, got '$_j')"; rm -rf "$_mfd"; exit 1 ;; esac
    # The raw zone and the subject must both survive into the record — a consumer that disagrees
    # with this reader's gating needs the inputs, not just the conclusion.
    case "$_j" in *'"proximity_raw":"NEAR"'*) : ;; *) echo "smoke-test: FAIL (raw zone must survive beside the fused one, got '$_j')"; rm -rf "$_mfd"; exit 1 ;; esac
    case "$_j" in *'"proximity_device":"LE-Bose Revolve SoundLink"'*) : ;; *) echo "smoke-test: FAIL (the deciding device must be named in the record — an anonymous zone is what caused this bug, got '$_j')"; rm -rf "$_mfd"; exit 1 ;; esac
    # A MULTI-WORD name is the normal case, not an edge case: `cut -f3` would classify "LE-Bose"
    # and land UNCLASSIFIED, silently restoring the old gating. Assert the extractor directly.
    _got="$(_prox_device 'NEAR 28:11:A5:B8:9E:A2 LE-Bose Revolve SoundLink')"
    [ "$_got" = "LE-Bose Revolve SoundLink" ] || { echo "smoke-test: FAIL (_prox_device truncated a multi-word name to '$_got')"; rm -rf "$_mfd"; exit 1; }
    _got="$(_prox_device 'OUT_OF_RANGE none none')"
    [ "$_got" = "none" ] || { echo "smoke-test: FAIL (_prox_device on a device-less record gave '$_got', want the spelled 'none')"; rm -rf "$_mfd"; exit 1; }
    [ "$(_prox_class none)" = UNCLASSIFIED ] || { echo "smoke-test: FAIL (spelled 'none' must not classify)"; rm -rf "$_mfd"; exit 1; }
    # A classifier that cannot be reached must be LOUD and must PRESERVE gating (the conservative
    # direction: it can never manufacture a VACANT). Same appliance fixture, no classifier.
    _out="$(MESH_STATE_DIR="$_mfd" MESH_PROX_CLASSIFY_CMD='/nonexistent/mesh-presence-xyz --classify' bash "$0" --json 2>&1 >/dev/null || true)"
    case "$_out" in *"unclassified"*) : ;; *) echo "smoke-test: FAIL (an unreachable classifier must warn on stderr, got '$_out')"; rm -rf "$_mfd"; exit 1 ;; esac
    _j="$(MESH_STATE_DIR="$_mfd" MESH_PROX_CLASSIFY_CMD='/nonexistent/mesh-presence-xyz --classify' bash "$0" --json 2>/dev/null || true)"
    case "$_j" in *'"verdict":"RECENT"'*) : ;; *) echo "smoke-test: FAIL (no classifier must PRESERVE the old gating, not manufacture a VACANT, got '$_j')"; rm -rf "$_mfd"; exit 1 ;; esac
    rm -rf "$_mfd"
    # The wrapper's test must exercise the thing it wraps: drive the REAL classifier, not a stub.
    # Exit 2 (honest n/a) where mesh-presence is absent — a missing organ is not a failing gate.
    if command -v mesh-presence >/dev/null 2>&1; then
      [ "$(mesh-presence --classify 'LE-Bose Revolve SoundLink')" = APPLIANCE ] \
        || { echo "smoke-test: FAIL (the REAL classifier no longer calls the deciding device an APPLIANCE — this fix's whole premise)"; exit 1; }
      [ "$(mesh-presence --classify 'iPhone 14')" = PERSONAL ] \
        || { echo "smoke-test: FAIL (the REAL classifier no longer calls a phone PERSONAL — the gating fixture above asserts nothing)"; exit 1; }
    else
      echo "smoke-test: n/a — mesh-presence absent, the subject classifier cannot be exercised"; exit 2
    fi
    echo "smoke-test: ok (10 fusion assertions: present+here→OCCUPIED, present+active→OCCUPIED, empty+phero→RECENT, empty+near→RECENT, empty+nothing→VACANT, all-unknown→UNKNOWN/exit2, uncertain→UNKNOWN, present+far→OCCUPIED, strong-phero-reason, sub-threshold→VACANT; 2 pheromone assertions: decay, deposit; 7 reader assertions on the real _read_state: pipe dialect, 3-field whitespace dialect, bare label, absent-sentinel, loud drift warn, live prox VALUE, live RECENT verdict; 10 subject assertions: personal-gates, appliance-does-not, FURNITURE fusion, raw zone kept, device named, multi-word name intact, spelled none, unreachable-classifier loud + gating preserved, and the REAL mesh-presence classifier on both classes)"
  )
  exit $?
fi

TS=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
NOW=$(date +%s)
LOOKBACK_S=$(( LOOKBACK_MIN * 60 ))

room="$(_read_state .room-sense.state)"
case "$room" in PRESENT|EMPTY|UNCERTAIN) ;; __ABSENT__) room="UNKNOWN" ;; *) _drift .room-sense.state "$room"; room="UNKNOWN" ;; esac

proximity_raw="$(_read_state .proximity.state)"
case "$proximity_raw" in HERE|NEAR|FAR|OUT_OF_RANGE) ;; __ABSENT__) proximity_raw="UNKNOWN" ;; *) _drift .proximity.state "$proximity_raw"; proximity_raw="UNKNOWN" ;; esac

# The zone alone is not a claim about a person — classify its SUBJECT before fusing it. Only a
# HERE/NEAR zone gates anything, so that is the only case worth a subprocess.
prox_device=""; prox_class="UNCLASSIFIED"; proximity="$proximity_raw"
if [ "$proximity_raw" = HERE ] || [ "$proximity_raw" = NEAR ]; then
  prox_device="$(_prox_device "$(_prox_record)")"
  prox_class="$(_prox_class "$prox_device")"
  case "$prox_class" in
    APPLIANCE)
      # A stationary appliance is permanently in range. Fusing its zone as occupancy makes VACANT
      # unreachable and credits OCCUPIED to a corroborator that corroborates nothing.
      proximity="FURNITURE" ;;
    UNCLASSIFIED)
      # Loud, and only where it would have changed the answer: gating is preserved (it can never
      # manufacture a VACANT), but a SILENT preserve is how this bug lived in the first place.
      printf 'mesh-room-trace: proximity subject %q unclassified (%s unreachable?) — zone %s GATES as before\n' \
        "${prox_device:-<none>}" "${PROX_CLASSIFY_CMD%% *}" "$proximity_raw" >&2 ;;
  esac
fi

activity="$(_read_state .activity.state)"
case "$activity" in IDLE|AMBIENT|MODERATE|ACTIVE|UNCERTAIN) ;; __ABSENT__) activity="UNKNOWN" ;; *) _drift .activity.state "$activity"; activity="UNKNOWN" ;; esac

# --- Pheromone: decay existing score + deposit for new light-level transitions ---
# This is the stigmergic step: mesh-light deposits by writing .light-transitions;
# we read that environment and maintain a decaying accumulator. Zero direct coupling.
_phero_update "$NOW"
# phero_score, phero_changes, phero_prev_level now set

_fuse "$room" "$proximity" "$activity" "$phero_score" "$phero_prev_level" "$phero_changes"
ec=$?

# --- Edge mode ---
if [ "$MODE" = "edge" ]; then
  confirmed=""
  [ -f "$STATE" ] && confirmed="$(head -1 "$STATE")"
  pending=""
  pcount=0
  [ -f "$PENDING" ] && { pending="$(head -1 "$PENDING" | cut -d: -f1)"; pcount="$(head -1 "$PENDING" | cut -d: -f2)"; }

  if [ "$verdict" = "$confirmed" ]; then
    :
  elif [ "$verdict" = "$pending" ]; then
    pcount=$((pcount + 1))
    echo "${pending}:${pcount}" > "$PENDING"
    if [ "$pcount" -ge "$EDGE_WINDOW" ]; then
      echo "$verdict" > "$STATE"
      rm -f "$PENDING"
      echo "[room-trace] $verdict — $reason"
    fi
  else
    echo "${verdict}:1" > "$PENDING"
  fi
fi

# --- Output ---
case "$MODE" in
  oneshot|edge)
    printf 'room-trace: %s — %s [room=%s prox=%s(raw=%s subject=%s/%s) activity=%s phero=%.3f window=%sm]\n' \
      "$verdict" "$reason" "$room" "$proximity" "$proximity_raw" "$prox_class" "${prox_device:-none}" \
      "$activity" "$phero_score" "$LOOKBACK_MIN"
    ;;
  json)
    printf '{"verdict":"%s","reason":"%s","room":"%s","proximity":"%s","proximity_raw":"%s","proximity_class":"%s","proximity_device":"%s","activity":"%s","phero_score":%.3f,"phero_changes":%d,"phero_prev_level":"%s","window_min":%d,"ts":"%s"}\n' \
      "$verdict" "$reason" "$room" "$proximity" "$proximity_raw" "$prox_class" "$prox_device" "$activity" "$phero_score" "$phero_changes" "$phero_prev_level" "$LOOKBACK_MIN" "$TS"
    ;;
esac

exit ${ec:-0}
