#!/usr/bin/env bash
# mesh-room-trace — temporal occupancy trace: was this room occupied recently?
# Fuses room-sense + proximity + light-transitions into a 4-level occupancy history.
#
# Usage:
#   mesh-room-trace              one-shot verdict to stdout
#   mesh-room-trace --edge       only emit when trace changes (for cron wiring)
#   mesh-room-trace --json       machine-readable JSON
#   mesh-room-trace --test       smoke test (no scans)
#   mesh-room-trace --window 30  lookback window in minutes (default: 30)
#
# Signals (read from state files — zero subprocesses, instant):
#   room-sense.state:         PRESENT/EMPTY/UNCERTAIN
#   proximity.state:          HERE/NEAR/FAR/OUT_OF_RANGE
#   light-transitions:        level|lux|epoch|change_count
#   activity.state:           IDLE/AMBIENT/MODERATE/ACTIVE/UNCERTAIN
#
# Trace levels:
#   OCCUPIED  = room present + (close device OR active)
#   RECENT    = room NOT present BUT light changed recently OR close device lingers
#   VACANT    = room empty + no recent light change + no close device
#   UNKNOWN   = all signals unreachable or conflicting
#
# UNREACHABLE ≠ VACANT: missing signals render UNKNOWN, never silent all-clear.
#
# Exit codes:
#   0 = verdict assessed (may be UNKNOWN)
#   2 = cannot assess (all signals unreachable)

set -euo pipefail

STATE_DIR="${MESH_STATE_DIR:-$HOME/.mesh}"
STATE="$STATE_DIR/.room-trace.state"
PENDING="$STATE_DIR/.room-trace.pending"
MODE="oneshot"
EDGE_WINDOW=2
LOOKBACK_MIN=30

for arg in "$@"; do
  case "$arg" in
    --edge)   MODE=edge ;;
    --json)   MODE=json ;;
    --test)   MODE=test ;;
    --window) shift; LOOKBACK_MIN="${1:-30}"; shift || true ;;
  esac
done

mkdir -p "$STATE_DIR"

# --- Fusion engine (defined first for --test access) ---
_fuse() {
  local rm="$1" pm="$2" am="$3" lcr="$4" lpc="$5" lch="$6"

  if [ "$rm" = "UNKNOWN" ] && [ "$pm" = "UNKNOWN" ] && [ "$am" = "UNKNOWN" ]; then
    verdict="UNKNOWN"; reason="all signals unreachable"; return 2
  fi

  if [ "$rm" = "PRESENT" ]; then
    if [ "$pm" = "HERE" ] || [ "$pm" = "NEAR" ]; then
      verdict="OCCUPIED"; reason="room present + proximity $pm"; return 0
    fi
    if [ "$am" = "MODERATE" ] || [ "$am" = "ACTIVE" ]; then
      verdict="OCCUPIED"; reason="room present + activity $am"; return 0
    fi
    verdict="OCCUPIED"; reason="room present (room-sense only)"; return 0
  fi

  if [ "$lcr" = "1" ]; then
    verdict="RECENT"; reason="light changed ${lpc} (${lch} total) within ${LOOKBACK_MIN}m"
    [ "$pm" = "HERE" ] || [ "$pm" = "NEAR" ] && reason="$reason + device nearby"
    return 0
  fi
  if [ "$pm" = "HERE" ] || [ "$pm" = "NEAR" ]; then
    verdict="RECENT"; reason="proximity $pm (device lingers after room empty)"; return 0
  fi

  if [ "$rm" = "EMPTY" ] && [ "$lcr" = "0" ] && [ "$pm" != "HERE" ] && [ "$pm" != "NEAR" ]; then
    verdict="VACANT"; reason="room empty + no recent light change + no close device"; return 0
  fi

  verdict="UNKNOWN"; reason="mixed: room=$rm proximity=$pm activity=$am light_changed=$lcr"; return 0
}

# --- Test mode: run assertions in subshell to isolate return 2 ---
if [ "$MODE" = "test" ]; then
  (
    set +e
    _fuse 'PRESENT' 'HERE' 'IDLE' 0 'UNKNOWN' 0
    [ "$verdict" = "OCCUPIED" ] || { echo "  FAIL: present+here → OCCUPIED (got $verdict)"; exit 1; }
    _fuse 'PRESENT' 'OUT_OF_RANGE' 'ACTIVE' 0 'UNKNOWN' 0
    [ "$verdict" = "OCCUPIED" ] || { echo "  FAIL: present+active → OCCUPIED (got $verdict)"; exit 1; }
    _fuse 'EMPTY' 'OUT_OF_RANGE' 'IDLE' 1 'LIT' 5
    [ "$verdict" = "RECENT" ] || { echo "  FAIL: empty+light → RECENT (got $verdict)"; exit 1; }
    _fuse 'EMPTY' 'NEAR' 'IDLE' 0 'UNKNOWN' 0
    [ "$verdict" = "RECENT" ] || { echo "  FAIL: empty+near → RECENT (got $verdict)"; exit 1; }
    _fuse 'EMPTY' 'OUT_OF_RANGE' 'IDLE' 0 'UNKNOWN' 0
    [ "$verdict" = "VACANT" ] || { echo "  FAIL: empty+nothing → VACANT (got $verdict)"; exit 1; }
    _fuse 'UNKNOWN' 'UNKNOWN' 'UNKNOWN' 0 'UNKNOWN' 0; rc=$?
    [ "$verdict" = "UNKNOWN" ] || { echo "  FAIL: all-unknown → UNKNOWN (got $verdict)"; exit 1; }
    [ "$rc" = "2" ] || { echo "  FAIL: all-unknown → exit 2 (got $rc)"; exit 1; }
    _fuse 'UNCERTAIN' 'OUT_OF_RANGE' 'UNKNOWN' 0 'UNKNOWN' 0
    [ "$verdict" = "UNKNOWN" ] || { echo "  FAIL: uncertain → UNKNOWN (got $verdict)"; exit 1; }
    _fuse 'PRESENT' 'FAR' 'IDLE' 0 'UNKNOWN' 0
    [ "$verdict" = "OCCUPIED" ] || { echo "  FAIL: present+far → OCCUPIED (got $verdict)"; exit 1; }
    echo "smoke-test: ok (8 assertions: present+here→OCCUPIED, present+active→OCCUPIED, empty+light→RECENT, empty+near→RECENT, empty+nothing→VACANT, all-unknown→UNKNOWN/exit2, uncertain→UNKNOWN, present+far→OCCUPIED)"
  )
  exit $?
fi

TS=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
NOW=$(date +%s)
LOOKBACK_S=$(( LOOKBACK_MIN * 60 ))

# --- Read signals from state files (zero subprocesses) ---
_read_state() {
  local f="$STATE_DIR/$1"
  [ -f "$f" ] && head -1 "$f" || echo "UNKNOWN"
}

room="$(_read_state .room-sense.state)"
case "$room" in PRESENT|EMPTY|UNCERTAIN) ;; *) room="UNKNOWN" ;; esac

proximity="$(_read_state .proximity.state)"
case "$proximity" in HERE|NEAR|FAR|OUT_OF_RANGE) ;; *) proximity="UNKNOWN" ;; esac

activity="$(_read_state .activity.state)"
case "$activity" in IDLE|AMBIENT|MODERATE|ACTIVE|UNCERTAIN) ;; *) activity="UNKNOWN" ;; esac

light_changed_recently=0
light_prev_level="UNKNOWN"
light_changes=0
trans_file="$STATE_DIR/.light-transitions"
if [ -f "$trans_file" ]; then
  IFS='|' read -r light_prev_level _lux prev_ts light_changes < "$trans_file" 2>/dev/null || true
  if [ -n "$prev_ts" ] && [ "$prev_ts" -eq "$prev_ts" ] 2>/dev/null; then
    age=$(( NOW - prev_ts ))
    if [ "$age" -le "$LOOKBACK_S" ]; then
      light_changed_recently=1
    fi
  fi
fi

_fuse "$room" "$proximity" "$activity" "$light_changed_recently" "$light_prev_level" "$light_changes"
ec=$?

# --- Edge mode ---
if [ "$MODE" = "edge" ]; then
  confirmed=""
  [ -f "$STATE" ] && confirmed="$(head -1 "$STATE")"
  pending=""
  pcount=0
  [ -f "$PENDING" ] && { pending="$(head -1 "$PENDING" | cut -d: -f1)"; pcount="$(head -1 "$PENDING" | cut -d: -f2)"; }

  if [ "$verdict" = "$confirmed" ]; then
    :
  elif [ "$verdict" = "$pending" ]; then
    pcount=$((pcount + 1))
    echo "${pending}:${pcount}" > "$PENDING"
    if [ "$pcount" -ge "$EDGE_WINDOW" ]; then
      echo "$verdict" > "$STATE"
      rm -f "$PENDING"
      echo "[room-trace] $verdict — $reason"
    fi
  else
    echo "${verdict}:1" > "$PENDING"
  fi
fi

# --- Output ---
case "$MODE" in
  oneshot|edge)
    printf 'room-trace: %s — %s [room=%s prox=%s activity=%s light_changed=%s window=%sm]\n' \
      "$verdict" "$reason" "$room" "$proximity" "$activity" "$light_changed_recently" "$LOOKBACK_MIN"
    ;;
  json)
    printf '{"verdict":"%s","reason":"%s","room":"%s","proximity":"%s","activity":"%s","light_changed":%s,"light_changes":%s,"window_min":%d,"ts":"%s"}\n' \
      "$verdict" "$reason" "$room" "$proximity" "$activity" "$light_changed_recently" "${light_changes:-0}" "$LOOKBACK_MIN" "$TS"
    ;;
esac

exit ${ec:-0}
