#!/usr/bin/env bash
# test-mesh-egress-stream — regression proof for mesh-egress-stream (isolated-HOME verification artifact).
# Regression proof for mesh-egress-stream. Uses an isolated HOME only.
set -euo pipefail

TARGET="${MESH_EGRESS_STREAM_BIN:-$(dirname "$0")/mesh-egress-stream}"
SBX=$(mktemp -d /tmp/mesh-egress-stream-test.XXXXXX)
trap 'rm -rf "$SBX"' EXIT

mkdir -p "$SBX/.local/bin" "$SBX/.mesh"

cat > "$SBX/.local/bin/mesh-tell" <<'TELL'
#!/usr/bin/env bash
printf '%s\n' "$*" >> "$HOME/.mesh/tell.log"
TELL

chmod +x "$SBX/.local/bin/mesh-tell"

healthy_payload=$'state=OK\nanth=405\nlatency=12\nloss=0\nlast=2026-06-11T00:00:00Z OK egress=NL ip=1.2.3.4 anthropic=405'
degraded_payload=$'state=BAD\nanth=500\nlatency=77\nloss=3\nlast=2026-06-11T00:00:01Z BAD egress=US ip=1.2.3.4 anthropic=500'

HOME="$SBX" PATH="$SBX/.local/bin:$PATH" MESH_EGRESS_STREAM_TEST_PAYLOAD="$healthy_payload" MESH_EGRESS_STREAM_MIND=claude "$TARGET" >"$SBX/healthy.out" 2>"$SBX/healthy.err"
test ! -s "$SBX/.mesh/tell.log"
grep -q 'nothing to feed' "$SBX/healthy.out"

HOME="$SBX" PATH="$SBX/.local/bin:$PATH" MESH_EGRESS_STREAM_TEST_PAYLOAD="$degraded_payload" MESH_EGRESS_STREAM_MIND=claude "$TARGET" >"$SBX/degraded.out" 2>"$SBX/degraded.err"
grep -q 'FED claude' "$SBX/degraded.out"
grep -q '\[check\] egress degraded:' "$SBX/.mesh/tell.log"

HOME="$SBX" PATH="$SBX/.local/bin:$PATH" MESH_EGRESS_STREAM_TEST_PAYLOAD="$degraded_payload" MESH_EGRESS_STREAM_MIND=claude "$TARGET" >"$SBX/degraded2.out" 2>"$SBX/degraded2.err"
grep -q 'unchanged prompt — not re-feeding' "$SBX/degraded2.out"
test "$(wc -l < "$SBX/.mesh/tell.log")" -eq 1

echo "PASS egress-stream: healthy stayed silent, degrade fed exactly once, dedupe held"
