#!/usr/bin/env bash
# mesh-dms — dead-man's switch for substrate changes.
# Schedules a rollback BEFORE making the change. Cancels it only if verification passes.
# If the verify step fails (or the script is killed), the rollback fires automatically.
#
# Usage:
#   mesh-dms <timeout_sec> <rollback_cmd> <verify_cmd> <change_cmd>
#
# Example (rescope a WireGuard egress tunnel):
#   mesh-dms 120 \
#     "wg-quick down \"$VPN_SRC_CONF\"" \
#     "mesh-health" \
#     "wg-quick up \"$VPN_SRC_CONF\""
#
# Always run as root (or with sudo) when substrate commands require it.
# Always write a mesh-trace mark before and after.
#
# ── SHARED PROTENTION: this switch's schedule is PRIVATE to the process, never a coordination signal ──
# LITERATURE (live review, what's NEW in predictive processing 2023-2026, angle = multi-agent/social,
# distinct from every prior review here which is single-agent sensor fusion/threshold-setting):
# Constantin, Rączaszek-Leonardi & Ramstead-adjacent line — "Shared Protention in Multi-Agent Active
# Inference" (2024, PMC11049075) argues group coordination rests on agents converging on SHARED
# PROTENTION: an implicit, forward-pointing anticipation of what's about to happen, encoded in
# generative-model parameters — NOT the same as agents merely agreeing on beliefs about the CURRENT
# state. Their proposed formal glue (sheaf theory / polynomial functors over a "consensus topos") is
# explicitly non-operational — the authors state it "does not provide a specific testable model yet."
# So the citable NEW thing is the DISTINCTION (anticipation-alignment ≠ present-state-alignment), not
# their untested math.
# THE GAP THIS NAMES: mesh-dms IS a working instance of protention — it schedules a rollback (an
# anticipated future state) BEFORE the change, so a crash/kill still resolves to the expected outcome.
# But that anticipation is PRIVATE: a bare backgrounded `timeout`, invisible to any other mind unless
# the caller separately writes a mesh-trace mark (a convention, not enforced here). No other agent can
# read "what does this process currently expect to happen, and by when" — the exact shared-protention
# gap the paper names, just at multi-agent-mesh scale instead of neural-population scale.
# DISTINCT from every sibling review: mesh-precision/mesh-novelty/mesh-perimeter are single-agent
# (one mind weighing/thresholding its OWN sensor stream); this is the first review in the area landing
# on the SOCIAL axis — coordination between multiple minds sharing one mesh.
# HELD (comment-only, 0 behavior change — do NOT wire this alone): the tempting fix is a routine board
# marker (e.g. `[expect] <event> by <window>`) so idle minds can read each other's anticipations instead
# of silently re-deriving them, cutting duplicate dispatch on a predicted event. NOT shipped here because
# it is a shared-VOCABULARY change (CLAUDE.md's board marker set), and this mesh runs multiple LIVE
# agents concurrently — unilaterally minting a new marker from one script risks exactly the kind of
# uncoordinated substrate-adjacent change the operator doctrine gates on consensus. Landing it needs a
# board [design] proposal + buy-in from the other running minds, not a solo genome edit.
set -euo pipefail

# ── FENCING (Kleppmann 2016, martin.kleppmann.com/2016/02/08/how-to-do-distributed-locking.html) ──
# A lease-based lock is NOT safe alone: a holder can pause PAST its lease (GC / page fault / THERMAL
# THROTTLE — a live hazard on this node) while a second holder legitimately acquires, then wake and
# write, clobbering the second. Ordering the grants is not enough — the RESOURCE must reject a write
# from a holder that no longer owns the lock, AT THE POINT OF COMMIT. Here the commit is disarming
# the rollback: mesh-dms did that on VERIFY alone, never re-checking the caller still holds its claim.
# Checking the claim BEFORE the change (the CLAUDE.md protocol step) is TOCTOU — the stall happens
# between check and commit. So: opt-in MESH_DMS_FENCE_KEY=<mesh-claim key>. When set, the disarm gate
# becomes VERIFY && fence-held, where fence-held requires `mesh-claim --check <key>` == 1 (yours) AT
# COMMIT. Superseded(2)/stale(3)/unclaimed(0)/mesh-claim-absent → FAIL-CLOSED: rollback fires, the
# stale writer's change is reverted rather than committed over a live second writer. Unset key =
# today's behavior exactly (backward compatible). Review: ~/.mesh/knowledge/review-fencing-tokens-*.
# _fence_ok is PURE (rc -> pass/fail) so the fencing LOGIC is testable without faking mesh-claim identity.
_fence_ok() {  # <mesh-claim --check exit code>  ->  0 pass (still yours) / 1 fenced-out
  [ "${1:-}" = 1 ] && return 0 || return 1   # ONLY exit 1 (yours) passes; 0/2/3/anything = fail-closed
}
# integration: run the live check, map to a verdict. Absent tool / unresolved key -> fail-closed (rc 127/2).
fence_held() {  # <key>  ->  0 still held / 1 fenced
  local key="$1" rc
  command -v mesh-claim >/dev/null 2>&1 || return 1   # can't fence -> fail-closed (no hollow all-clear)
  mesh-claim --check "$key" >/dev/null 2>&1; rc=$?
  _fence_ok "$rc"
}

if [ "${1:-}" = --help ] || [ "${1:-}" = -h ]; then
  echo "usage: mesh-dms <timeout_sec> <rollback_cmd> <verify_cmd> <change_cmd>"
  echo "  Dead-man's switch: schedules rollback, fires if verify fails."
  echo "  Set MESH_DMS_FENCE_KEY=<claim-key> to also fence: disarm only if you still hold the claim."
  echo "  Always run as root (sudo) for substrate changes."
  exit 0
fi
if [ "${1:-}" = --test ]; then
  command -v mesh-trace >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-trace)"; exit 1; }
  command -v mktemp >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mktemp)"; exit 1; }
  command -v timeout >/dev/null 2>&1 || { echo "smoke-test: FAIL (no timeout)"; exit 1; }
  command -v grep >/dev/null 2>&1 || { echo "smoke-test: FAIL (no grep)"; exit 1; }
  command -v rm >/dev/null 2>&1 || { echo "smoke-test: FAIL (no rm)"; exit 1; }
  tmp="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp failed)"; exit 1; }
  trap 'rm -rf "$tmp"' EXIT
  rollback_cmd="echo rollback > '$tmp/rollback'; rm -f '$tmp/changed'"
  verify_cmd="test -f '$tmp/changed'"
  change_cmd="echo changed > '$tmp/changed'"
  out="$(timeout 10 "$0" 3 "$rollback_cmd" "$verify_cmd" "$change_cmd" 2>&1)" || {
      echo "smoke-test: FAIL (dead-man dry-run failed: $out)"; exit 1;
    }
  printf '%s\n' "$out" | grep -q 'VERIFIED OK — disarming rollback' || {
    echo "smoke-test: FAIL (did not disarm rollback: $out)"; exit 1;
  }
  [ -f "$tmp/changed" ] || { echo "smoke-test: FAIL (change artifact missing)"; exit 1; }
  [ ! -f "$tmp/rollback" ] || { echo "smoke-test: FAIL (rollback fired unexpectedly)"; exit 1; }
  # FAILURE path: verify fails → rollback MUST fire, change reverted, exit 1
  # Clean previous temp dir (remove the changed file so rmdir works)
  rm -f "$tmp/changed" 2>/dev/null; rmdir "$tmp" 2>/dev/null; tmp="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
  rollback_cmd="echo rollback > '$tmp/rollback'; rm -f '$tmp/changed'"
  change_cmd="echo changed > '$tmp/changed'"
  verify_cmd="test ! -f '$tmp/changed'"    # deliberately wrong — verify will FAIL
  rc=0
  out="$(timeout 15 "$0" 3 "$rollback_cmd" "$verify_cmd" "$change_cmd" 2>&1)" || rc=$?
  [ "$rc" = 1 ] || { echo "smoke-test: FAIL (verify-fail path should exit 1, got $rc: $out)"; exit 1; }
  printf '%s\n' "$out" | grep -q 'VERIFY FAILED' || { echo "smoke-test: FAIL (verify-fail path did not report VERIFY FAILED: $out)"; exit 1; }
  printf '%s\n' "$out" | grep -q 'Rollback complete' || { echo "smoke-test: FAIL (verify-fail path did not complete rollback: $out)"; exit 1; }
  [ -f "$tmp/rollback" ] || { echo "smoke-test: FAIL (rollback did NOT fire after verify fail: $out)"; exit 1; }
  [ ! -f "$tmp/changed" ] || { echo "smoke-test: FAIL (change was NOT reverted after verify fail: $out)"; exit 1; }

  # ── FENCING (Kleppmann): pure decision fn — ONLY exit 1 (yours) commits; 0/2/3 fence out ──
  _fence_ok 1 || { echo "smoke-test: FAIL (_fence_ok 1 should PASS — yours)"; exit 1; }
  ! _fence_ok 0 || { echo "smoke-test: FAIL (_fence_ok 0 should FAIL — unclaimed)"; exit 1; }
  ! _fence_ok 2 || { echo "smoke-test: FAIL (_fence_ok 2 should FAIL — theirs)"; exit 1; }
  ! _fence_ok 3 || { echo "smoke-test: FAIL (_fence_ok 3 should FAIL — stale)"; exit 1; }
  ! _fence_ok "" || { echo "smoke-test: FAIL (_fence_ok empty should FAIL — fail-closed)"; exit 1; }
  # Integration (hermetic): VERIFY passes but MESH_DMS_FENCE_KEY names a NEVER-claimed key on an empty
  # temp board -> mesh-claim --check returns 0 (unclaimed) -> fence FAILS -> rollback fires despite
  # verify-ok. Proves the wired path end-to-end without faking mesh-claim's identity. Skips honestly if
  # mesh-claim is absent (then fence_held fail-closes anyway, still exercising the rollback path).
  rm -rf "$tmp" 2>/dev/null; tmp="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }   # prior test left a fired rollback file — rmdir would fail under set -e; nuke the whole dir
  : > "$tmp/board"   # empty board -> the key is unclaimed
  rollback_cmd="echo rollback > '$tmp/rollback'; rm -f '$tmp/changed'"
  change_cmd="echo changed > '$tmp/changed'"
  verify_cmd="test -f '$tmp/changed'"   # VERIFY deliberately PASSES — only the fence should stop the commit
  rc=0
  out="$(MESH_DMS_FENCE_KEY='fence-test/never-claimed-key' MESH_CHAT_LOG="$tmp/board" \
         timeout 15 "$0" 3 "$rollback_cmd" "$verify_cmd" "$change_cmd" 2>&1)" || rc=$?
  [ "$rc" = 1 ] || { echo "smoke-test: FAIL (fence path should exit 1, got $rc: $out)"; exit 1; }
  printf '%s\n' "$out" | grep -q 'FENCE FAILED' || { echo "smoke-test: FAIL (did not report FENCE FAILED — did the gate run? $out)"; exit 1; }
  [ -f "$tmp/rollback" ] || { echo "smoke-test: FAIL (rollback did NOT fire on fence fail: $out)"; exit 1; }
  [ ! -f "$tmp/changed" ] || { echo "smoke-test: FAIL (change NOT reverted after fence fail: $out)"; exit 1; }

  echo "smoke-test: ok"; exit 0
fi
TIMEOUT="${1:?usage: mesh-dms <timeout_sec> <rollback_cmd> <verify_cmd> <change_cmd>}"
ROLLBACK="${2:?}"
VERIFY="${3:?}"
CHANGE="${4:?}"

log() { echo "[mesh-dms $(date -u +%H:%M:%SZ)] $*"; }

# Start rollback timer in background
(
    sleep "$TIMEOUT"
    log "TIMEOUT — firing rollback: $ROLLBACK" >&2
    eval "$ROLLBACK"
) &
DMS_PID=$!

cleanup() {
    if kill -0 "$DMS_PID" 2>/dev/null; then
        log "cleanup: killing timer pid $DMS_PID"
        kill "$DMS_PID" 2>/dev/null || true
    fi
}
trap cleanup EXIT

log "Rollback timer armed: ${TIMEOUT}s (pid $DMS_PID) — \"$ROLLBACK\""
log "Applying change: $CHANGE"
eval "$CHANGE"

log "Verifying: $VERIFY"
commit_ok=1; fail_reason="VERIFY FAILED"
if ! eval "$VERIFY"; then
    commit_ok=0
elif [ -n "${MESH_DMS_FENCE_KEY:-}" ]; then
    log "Fencing: mesh-claim --check $MESH_DMS_FENCE_KEY (must still be yours)"
    if ! fence_held "$MESH_DMS_FENCE_KEY"; then
        commit_ok=0; fail_reason="FENCE FAILED (claim '$MESH_DMS_FENCE_KEY' superseded/stale/absent — a second writer holds it)"
    fi
fi
if [ "$commit_ok" = 1 ]; then
    log "VERIFIED OK — disarming rollback"
    kill "$DMS_PID" 2>/dev/null || true
    trap - EXIT
    log "Done. Change is live."
else
    log "$fail_reason — rollback will fire at timeout"
    wait "$DMS_PID" 2>/dev/null || true
    trap - EXIT
    log "Rollback complete."
    exit 1
fi
