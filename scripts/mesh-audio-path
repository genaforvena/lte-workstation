#!/usr/bin/env bash
# reflex-cadence: 5-59/10 * * * *
# reflex-args: --edge
# mesh-audio-path — CROSS-SENSE FUSION: is what THIS node PLAYS actually AUDIBLE in the room?
#
# Fuses two existing single-axis senses into a derived signal neither gives alone:
#   EMISSION  — mesh-audio-active  (kernel ALSA /proc/asound: a playback substream is RUNNING)
#   AUDIBILITY — mesh-ambient-level (IdeaPad mic, 1s RMS dB: what the room actually sounds like)
#   LINK      — mesh-bt-link (.bt-link-state: is a BT AUDIO sink actually CONNECTED right now?)
#               Consulted ONLY on SINK-DEAD-SUSPECT, to split the suspicion into its two causes:
#               no-audio-sink/radio-off ⟹ the link itself dropped (bt-link CORROBORATES);
#               audio-linked ⟹ sink is connected but inaudible ⟹ suspect mute/zero-volume instead.
#               Reads the fresh state file (≤20min, mesh-bt-link's doctor-artifact bound), falls back
#               to a live mesh-bt-link call, degrades to bt=unknown — never blocks the verdict.
#
# THE HOLE this closes: the nightly mesh-room-music grind "plays" (ALSA stream RUNNING, rc=0,
# cron green) even when the Bose BT sink has dropped / the mixer is muted / volume is 0 — sound
# goes into a dead sink and NOBODY and NOTHING notices. Emission alone can't see it (the kernel
# stream runs fine); the mic alone can't see it (a quiet room is just a quiet room). Only the
# CROSS of the two exposes it: PLAYING + room-SILENT = the actuator's output path is broken.
#
# Verdicts (fusion truth table):
#   IDLE               — not emitting (audio-active SILENT). Nothing to validate; ambient passthrough.
#   AUDIBLE            — PLAYING + mic hears MODERATE/LOUD → emission corroborated end-to-end
#                        (stream → sink → speaker → air → mic). Honest scope: CORROBORATION, not
#                        attribution — the mic proves sound is present while we emit, not that the
#                        sound IS ours (a talking human can mask a dead sink; cleanest at night).
#   SINK-DEAD-SUSPECT  — PLAYING + mic hears SILENCE/QUIET on TWO reads 4s apart (the re-read
#                        absorbs quiet musical passages) → playing into a dead/muted sink.
#
# HONEST degradation (an UNREACHABLE input is NEVER a silent all-clear):
#   - no sound card (audio-active exit 2)      → "UNREACHABLE (no playback hardware)" exit 2
#   - mic dead while PLAYING (ambient exit ≠0) → "PLAYING but mic UNREACHABLE — cannot verify
#                                                 audibility" exit 2 — NOT a fake AUDIBLE
#   - mic dead while idle                      → IDLE (mic not needed to know we aren't emitting),
#                                                 detail says ambient=UNREACHABLE
#
# PASSIVE by design: never emits a tone (mesh-acoustic-range is the ACTIVE cross-node prober;
# this validates only sound that is ALREADY playing — zero risk of test audio hitting the live
# Bose, per the e9fb6d2 rule).
#
#   mesh-audio-path            one-shot fused read
#   mesh-audio-path --edge     print only on verdict CHANGE (cron mode)
#   mesh-audio-path --json     machine-readable
#   mesh-audio-path --test     fixtures + real-read gate (exit 2 = honest n/a)
#
# State: ~/.mesh/.audio-path-state (content change-gated; mtime refreshed EVERY successful run
# via the shared mesh-state-touch primitive — ran-live ≠ value-changed, the false-STALE rule).
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

STATE="$HOME/.mesh/.audio-path-state"
REREAD_GAP="${MESH_AUDIO_PATH_REREAD_GAP:-4}"
BT_STATE="$HOME/.mesh/.bt-link-state"
BT_MAX_AGE=1200   # mesh-bt-link's own doctor-artifact staleness bound

# classify <playing> <ambient> → verdict (pure fusion core, fixture-testable).
# playing: PLAYING|SILENT   ambient: SILENCE|QUIET|MODERATE|LOUD|UNKNOWN
classify() {
  local playing="$1" ambient="$2"
  if [ "$playing" != "PLAYING" ]; then
    echo "IDLE"; return 0
  fi
  case "$ambient" in
    MODERATE|LOUD) echo "AUDIBLE" ;;
    SILENCE|QUIET) echo "SINK-DEAD-SUSPECT" ;;
    *)             echo "UNVERIFIABLE" ;;   # PLAYING but no mic evidence — caller escalates to exit 2
  esac
}

# bt_sink_class <bt-link verdict line> → audio-linked|no-audio-sink|radio-off|unknown (pure, fixture-testable).
# Input is line 1 of .bt-link-state / mesh-bt-link stdout: "CONNECTED|n=.. audio=N ..", "NONE|..", "OFFLINE|..".
bt_sink_class() {
  case "$1" in
    CONNECTED*) printf '%s' "$1" | grep -qE 'audio=[1-9]' && echo "audio-linked" || echo "no-audio-sink" ;;
    NONE*)      echo "no-audio-sink" ;;
    OFFLINE*)   echo "radio-off" ;;
    *)          echo "unknown" ;;
  esac
}

# read_bt_link → sink class from the freshest available bt-link read (env-injectable for --test).
# state-file-first (cheap; mesh-bt-link refreshes it every run), live-call fallback, unknown on failure.
read_bt_link() {
  [ -n "${MESH_AUDIO_PATH_BTLINK:-}" ] && { bt_sink_class "$MESH_AUDIO_PATH_BTLINK"; return; }
  local line="" now mt
  if [ -f "$BT_STATE" ]; then
    now=$(date +%s); mt=$(stat -c %Y "$BT_STATE" 2>/dev/null || echo 0)
    [ $((now - mt)) -le "$BT_MAX_AGE" ] && line="$(sed -n '1p' "$BT_STATE" 2>/dev/null)"
  fi
  if [ -z "$line" ] && command -v mesh-bt-link >/dev/null 2>&1; then
    line="$(timeout 30 mesh-bt-link 2>/dev/null)" || true   # OFFLINE prints + exits 2; stdout still lands
  fi
  bt_sink_class "${line:-}"
}

read_ambient() {
  # → SILENCE|QUIET|MODERATE|LOUD or empty + return 1 (mic unreachable / no classification)
  local out
  out="$(timeout 15 mesh-ambient-level 2>/dev/null)" || return 1
  case "$out" in
    *LOUD*)     echo "LOUD" ;;
    *MODERATE*) echo "MODERATE" ;;
    *QUIET*)    echo "QUIET" ;;
    *SILENCE*)  echo "SILENCE" ;;
    *)          return 1 ;;
  esac
}

if [ "${1:-}" = --test ]; then
  command -v mesh-audio-active  >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-audio-active)"; exit 1; }
  command -v mesh-ambient-level >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-ambient-level)"; exit 1; }
  command -v mesh-state-touch   >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-state-touch)"; exit 1; }
  fail=0
  # Fusion truth table (falsifiable: flip any branch in classify() and one of these breaks)
  [ "$(classify PLAYING LOUD)"     = "AUDIBLE" ]           || { echo "FAIL: PLAYING+LOUD → $(classify PLAYING LOUD) (expected AUDIBLE)"; fail=1; }
  [ "$(classify PLAYING MODERATE)" = "AUDIBLE" ]           || { echo "FAIL: PLAYING+MODERATE → expected AUDIBLE"; fail=1; }
  [ "$(classify PLAYING SILENCE)"  = "SINK-DEAD-SUSPECT" ] || { echo "FAIL: PLAYING+SILENCE → expected SINK-DEAD-SUSPECT"; fail=1; }
  [ "$(classify PLAYING QUIET)"    = "SINK-DEAD-SUSPECT" ] || { echo "FAIL: PLAYING+QUIET → expected SINK-DEAD-SUSPECT"; fail=1; }
  [ "$(classify PLAYING UNKNOWN)"  = "UNVERIFIABLE" ]      || { echo "FAIL: PLAYING+UNKNOWN → expected UNVERIFIABLE (never a fake AUDIBLE)"; fail=1; }
  [ "$(classify SILENT LOUD)"      = "IDLE" ]              || { echo "FAIL: SILENT+LOUD → expected IDLE (not emitting ⇒ nothing to validate)"; fail=1; }
  [ "$(classify SILENT SILENCE)"   = "IDLE" ]              || { echo "FAIL: SILENT+SILENCE → expected IDLE"; fail=1; }
  [ "$(classify SILENT UNKNOWN)"   = "IDLE" ]              || { echo "FAIL: SILENT+UNKNOWN → expected IDLE (mic not needed when not emitting)"; fail=1; }
  # LINK-axis classifier (the bt-link fusion contract — input is mesh-bt-link's verdict line)
  [ "$(bt_sink_class 'CONNECTED|n=1 audio=1 input=0 display=0 phone=0 other=0 | Bose(audio)')" = "audio-linked" ]  || { echo "FAIL: CONNECTED audio=1 → expected audio-linked"; fail=1; }
  [ "$(bt_sink_class 'CONNECTED|n=1 audio=0 input=1 display=0 phone=0 other=0 | K380(input)')" = "no-audio-sink" ] || { echo "FAIL: CONNECTED audio=0 → expected no-audio-sink"; fail=1; }
  [ "$(bt_sink_class 'NONE|controller up, 0 peripherals connected')" = "no-audio-sink" ]                           || { echo "FAIL: NONE → expected no-audio-sink"; fail=1; }
  [ "$(bt_sink_class 'OFFLINE|rfkill-blocked (radio off)')" = "radio-off" ]                                        || { echo "FAIL: OFFLINE → expected radio-off"; fail=1; }
  [ "$(bt_sink_class '')" = "unknown" ]                                                                            || { echo "FAIL: empty → expected unknown (degrade, never block)"; fail=1; }
  [ "$fail" = 0 ] || { echo "smoke-test: FAIL"; exit 1; }
  # REAL-READ gate (reachability ≠ producing): both inputs must yield an actual reading on this
  # node or the fusion is hollow. audio-active exit 2 = no sound card = honest n/a.
  mesh-audio-active >/dev/null 2>&1; aa_rc=$?
  if [ "$aa_rc" = 2 ]; then echo "smoke-test: n/a (no playback hardware — fusion unavailable here); fusion-logic ok"; exit 2; fi
  [ "$aa_rc" = 0 ] || { echo "smoke-test: FAIL (mesh-audio-active rc=$aa_rc)"; exit 1; }
  read_ambient >/dev/null || { echo "smoke-test: n/a (mic unreachable — audibility axis dark); fusion-logic ok"; exit 2; }
  echo "smoke-test: ok (8 fusion + 5 bt-link fixtures + REAL emission read + REAL mic read)"
  exit 0
fi

# --- Live gather: EMISSION axis (env-injectable for offline verification) ---
playing="${MESH_AUDIO_PATH_PLAYING:-}"
if [ -z "$playing" ]; then
  aa_out="$(mesh-audio-active 2>/dev/null)"; aa_rc=$?
  if [ "$aa_rc" = 2 ]; then
    echo "[audio-path] UNREACHABLE — no playback hardware on $(hostname) (kernel has no ALSA playback substreams; not a quiet room, a missing organ)"
    exit 2
  fi
  case "$aa_out" in
    *PLAYING*) playing="PLAYING" ;;
    *)         playing="SILENT" ;;
  esac
fi

# --- Live gather: AUDIBILITY axis ---
ambient="${MESH_AUDIO_PATH_AMBIENT:-}"
mic_ok=1
if [ -z "$ambient" ]; then
  ambient="$(read_ambient)" || { mic_ok=0; ambient="UNKNOWN"; }
fi

# Quiet-passage debounce: a real track has silent bars. Before suspecting the sink, re-read once
# after a gap and keep the LOUDER classification.
if [ "$playing" = "PLAYING" ] && { [ "$ambient" = "SILENCE" ] || [ "$ambient" = "QUIET" ]; } && [ -z "${MESH_AUDIO_PATH_AMBIENT:-}" ]; then
  sleep "$REREAD_GAP"
  ambient2="$(read_ambient)" || ambient2=""
  case "$ambient2" in MODERATE|LOUD) ambient="$ambient2" ;; esac
fi

verdict="$(classify "$playing" "$ambient")"

# PLAYING with no mic evidence: the one case an all-clear would be a lie — surface it, exit 2.
if [ "$verdict" = "UNVERIFIABLE" ]; then
  echo "[audio-path] UNVERIFIABLE — PLAYING but mic UNREACHABLE: cannot verify the room hears it (NOT an all-clear; sink state unknown)"
  exit 2
fi

detail="emit=$playing ambient=$ambient"
[ "$mic_ok" = 1 ] || detail="$detail(mic-unreachable)"

# LINK axis: only when the fusion already suspects the sink — split "link dropped" from "linked but mute".
bt=""
if [ "$verdict" = "SINK-DEAD-SUSPECT" ]; then
  bt="$(read_bt_link)"
  detail="$detail bt-sink=$bt"
fi

if [ "${1:-}" = --json ]; then
  printf '{"ts":"%s","host":"%s","verdict":"%s","emit":"%s","ambient":"%s","mic_ok":%s}\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$(hostname)" "$verdict" "$playing" "$ambient" "$mic_ok"
  exit 0
fi

prev="$(cut -d'|' -f1 "$STATE" 2>/dev/null || echo UNKNOWN)"
if [ "$verdict" != "$prev" ]; then
  printf '%s|%s|%s\n' "$verdict" "$detail" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$STATE"
fi
mesh-state-touch "$STATE"   # ran-live on EVERY successful eval; content stays change-gated

if [ "${1:-}" = --edge ] && [ "$verdict" = "$prev" ]; then
  exit 0
fi

case "$verdict" in
  AUDIBLE)           echo "[audio-path] AUDIBLE — emission corroborated end-to-end ($detail): stream→sink→air→mic all live" ;;
  SINK-DEAD-SUSPECT)
    case "$bt" in
      no-audio-sink|radio-off) btnote="bt-link CORROBORATES — no live BT audio sink ($bt)" ;;
      audio-linked)            btnote="bt-link shows an audio sink still CONNECTED — suspect mute/zero-volume, not a link drop" ;;
      *)                       btnote="bt-link unknown — cannot split link-drop from mute" ;;
    esac
    echo "[audio-path] SINK-DEAD-SUSPECT — PLAYING but the room is $ambient (2 reads ${REREAD_GAP}s apart): $btnote ($detail)" ;;
  IDLE)              echo "[audio-path] IDLE — not emitting ($detail); nothing to validate" ;;
esac
