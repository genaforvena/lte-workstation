#!/usr/bin/env bash
# mesh-mind-watch — detect MIND outage on a node.
# "Mind down" = beat stale + node SSH-reachable + mesh-health PASS.
# "Node down" = SSH unreachable (beacon-watch/mesh-health cover that case).
#
#   mesh-mind-watch                    check THIS node's mind-beat (self-watch)
#   mesh-mind-watch --node user@ip     check a PEER's mind-beat over SSH
#   mesh-mind-watch --status           show beat age only (no alert)
#
# Cron suggestion (check self every 10 min):
#   */10 * * * * mesh-mind-watch >> ~/.mesh/mind-watch.log 2>&1
# Or for cross-node (IdeaPad watches default-string):
#   */10 * * * * mesh-mind-watch --node user@<ts-ip> >> ~/.mesh/mind-watch.log 2>&1
set -uo pipefail
if [ "${1:-}" = --test ]; then
  command -v ssh >/dev/null 2>&1 || { echo "smoke-test: FAIL (no ssh)"; exit 1; }
  command -v date >/dev/null 2>&1 || { echo "smoke-test: FAIL (no date)"; exit 1; }
  command -v grep >/dev/null 2>&1 || { echo "smoke-test: FAIL (no grep)"; exit 1; }
  command -v awk >/dev/null 2>&1 || { echo "smoke-test: FAIL (no awk)"; exit 1; }
  tmp="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp failed)"; exit 1; }
  trap 'rm -rf "$tmp"' EXIT
  mkdir -p "$tmp/.mesh" || { echo "smoke-test: FAIL (tmp mesh dir)"; exit 1; }
  date -u +%FT%TZ > "$tmp/.mesh/mind-beat.ts"
  out="$(HOME="$tmp" "$0" --status 2>/dev/null || true)"
  printf '%s\n' "$out" | grep -q 'last thought' || { echo "smoke-test: FAIL (status dry-run bad: $out)"; exit 1; }
  echo "smoke-test: ok"; exit 0
fi
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

BEAT_FILE=".mesh/mind-beat.ts"
MAX_AGE="${MESH_MIND_MAXAGE:-1800}"   # 3× the */10 breath — a mind stamping each tick beats every
                                      # ~10min; flag only after ~3 missed ticks (was 600s, tuned for */2)
LOG="$HOME/.mesh/mind-watch.log"
STATE="$HOME/.mesh/.mind-watch-state"
mkdir -p "$STATE"
ts(){ date -u +%FT%TZ; }
alert(){ command -v mesh-tg >/dev/null 2>&1 && mesh-tg "$1" >/dev/null 2>&1 || true
         command -v mesh-chat >/dev/null 2>&1 && mesh-chat "$1" >/dev/null 2>&1 || true; }

NODE=""
STATUS_ONLY=0
while [ $# -gt 0 ]; do
  case "$1" in
    --node) NODE="$2"; shift 2;;
    --status) STATUS_ONLY=1; shift;;
    *) echo "usage: mesh-mind-watch [--node user@ip] [--status]" >&2; exit 1;;
  esac
done

# Where to read the beat from
if [ -n "$NODE" ]; then
  RHOST=$(ssh -o BatchMode=yes -o ConnectTimeout=8 "$NODE" "hostname" 2>/dev/null)
  if [ -z "$RHOST" ]; then
    echo "$(ts) SKIP: $NODE unreachable — node outage (not mind)" >> "$LOG"
    exit 0
  fi
  BEAT_TS=$(ssh -o BatchMode=yes -o ConnectTimeout=8 "$NODE" "cat ~/$BEAT_FILE 2>/dev/null || echo ''" 2>/dev/null)
  LABEL="$RHOST (via $NODE)"
  STATEFILE="${STATE}/${RHOST}.state"
else
  RHOST=$(hostname)
  BEAT_TS=$(cat "$HOME/$BEAT_FILE" 2>/dev/null || echo "")
  LABEL="$RHOST (self)"
  STATEFILE="${STATE}/${RHOST}.state"
fi

if [ -z "$BEAT_TS" ]; then
  if [ "$STATUS_ONLY" = 1 ]; then
    echo "  $LABEL: no beat file (mind never stamped)"
    exit 0
  fi
  prev=$(cat "$STATEFILE" 2>/dev/null || echo "")
  printf 'UNSET' > "$STATEFILE"
  if [ "$prev" != "UNSET" ]; then
    echo "$(ts) ALERT $LABEL: no mind-beat file — mind was never stamped or node is fresh" >> "$LOG"
    alert "⚠️ mesh-mind-watch: $LABEL has no mind-beat — agent never stamped, or node just reset. Check: ssh + mesh-restore."
  fi
  exit 0
fi

# Parse beat timestamp → age in seconds
BEAT_EPOCH=$(date -u -d "$BEAT_TS" +%s 2>/dev/null || echo 0)
NOW_EPOCH=$(date -u +%s)
AGE=$(( NOW_EPOCH - BEAT_EPOCH ))

# PHI-ACCRUAL: adaptive suspicion from the OBSERVED beat-interval distribution (no fixed timeout to
# retune when cadence drifts). phi rises as the gap exceeds what history says is normal. COLDSTART
# (<3 samples) falls back to the fixed MAX_AGE. Suspect when phi >= PHI_THRESHOLD (default 8).
PHI_THRESHOLD="${MESH_PHI_THRESHOLD:-8}"
PHI="COLDSTART"
command -v mesh-phi >/dev/null 2>&1 && PHI=$(mesh-phi "$STATE/${RHOST}.phi" "$BEAT_EPOCH" "$NOW_EPOCH" 2>/dev/null || echo COLDSTART)
suspect(){  # 0 = suspect down
  if [ "$PHI" = COLDSTART ] || [ -z "$PHI" ]; then [ "$AGE" -gt "$MAX_AGE" ]; return; fi
  awk -v p="$PHI" -v t="$PHI_THRESHOLD" 'BEGIN{exit !(p>=t)}'
}

if [ "$STATUS_ONLY" = 1 ]; then
  printf '  %-40s last thought %ds ago (phi=%s, thr=%s; max=%ds)\n' "$LABEL" "$AGE" "$PHI" "$PHI_THRESHOLD" "$MAX_AGE"
  exit 0
fi

prev=$(cat "$STATEFILE" 2>/dev/null || echo "")

# SWIM-style INDIRECT PROBE: a single prober's view can be wrong (network blip between this node and
# the target). Before declaring DOWN, ask a third node to confirm via SSH. Only alert if it AGREES
# (or no confirmer is available). MESH_CONFIRM_NODE = the third node (user@ip); only used cross-node.
confirmed_down(){
  [ -n "$NODE" ] || return 0                                   # self-watch: nothing to confirm against
  local c="${MESH_CONFIRM_NODE:-}"; [ -n "$c" ] || return 0    # no confirmer configured → trust direct
  local view; view=$(ssh -o BatchMode=yes -o ConnectTimeout=8 "$c" \
      "PATH=\$HOME/.local/bin:\$PATH mesh-mind-watch --node $NODE --status 2>/dev/null" 2>/dev/null)
  # confirmer's view: empty/no-beat OR age>MAX_AGE = agrees down; a fresh age = disagrees (suppress)
  local cage; cage=$(printf '%s' "$view" | grep -oE 'thought [0-9]+s' | grep -oE '[0-9]+')
  [ -z "$cage" ] && return 0                                   # confirmer also can't see it → agree DOWN
  [ "$cage" -gt "$MAX_AGE" ] && return 0                       # confirmer also sees stale → agree DOWN
  echo "$(ts) SUPPRESS $LABEL: direct stale ${AGE}s but confirmer $c sees fresh (${cage}s) — single-prober blip" >> "$LOG"
  return 1                                                     # confirmer sees it healthy → NOT down
}

if suspect && confirmed_down; then
  printf 'DOWN' > "$STATEFILE"
  if [ "$prev" != "DOWN" ]; then
    echo "$(ts) ALERT $LABEL: mind suspected DOWN (age ${AGE}s, phi=${PHI}/${PHI_THRESHOLD}), confirmed by 2nd prober. Node alive (SSH OK)." >> "$LOG"
    alert "🧠⬇️ mesh-mind-watch: $LABEL mind suspected DOWN (age ${AGE}s, phi=${PHI}≥${PHI_THRESHOLD}), confirmed by 2nd prober. Node alive (SSH OK). Need borrowed brain?"
  fi
elif ! suspect; then
  printf 'UP' > "$STATEFILE"
  if [ "$prev" = "DOWN" ]; then
    echo "$(ts) RECOVER $LABEL: mind active again (age ${AGE}s, phi=${PHI})" >> "$LOG"
    alert "🧠✅ mesh-mind-watch: $LABEL mind RECOVERED (age ${AGE}s, phi=${PHI}). Borrowed brain can stand down."
  fi
fi
# (suspect but confirmer disagreed → suppressed above; leave prior state untouched)
