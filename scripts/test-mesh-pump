#!/usr/bin/env bash
# test-mesh-pump — pure-file tests for the mesh-generate → mesh-feed work-pump.
# Tests 3 bugs fixed on 2026-06-11:
#   (1) feed last-line removal skipped (grep -v && mv → ; mv)
#   (2) generate count "0\n0" stall (|| echo 0 → || true + default)
#   (3) generate ts() swallowed by a comment (ts() defined after comment)
# tmpdir fixture — no tmux, no live mesh state touched.
set -euo pipefail

RED='\033[31m'; GRN='\033[32m'; NC='\033[0m'
pass=0; fail=0
T=$(mktemp -d); trap 'rm -rf "$T"' EXIT
echo "[test-mesh-pump] tmpdir=$T"

# --- shared fixture ---
ts(){ date -u +%FT%TZ; }
Q="$T/ideas-queue"; BL="$T/backlog"; LOG="$T/generate.log"; FLOG="$T/feed.log"
BLTMP="$T/backlog.tmp"; touch "$Q" "$BL"

ok(){  pass=$((pass+1)); echo -e "  ${GRN}PASS${NC} $*"; }
not(){ fail=$((fail+1)); echo -e "  ${RED}FAIL${NC} $*"; }
assert_eq(){ [ "$1" = "$2" ] && ok "$3" || not "$3 (expected '$2', got '$1')"; }
assert_gt(){ [ "$1" -gt "$2" ] && ok "$3" || not "$3 (expected > $2, got $1)"; }

# ============================================================
# TEST 1: feed last-line removal — MUST remove the only task
# ============================================================
echo "--- TEST 1: feed removes the ONLY (last) task from backlog ---"

# set up a single-task backlog
printf 'local:opencode|TASK: verify the backlog empties when last task is fed\n' > "$BL"
assert_eq "$(wc -l <"$BL" | tr -d ' ')" "1" "backlog starts with 1 task"

# simulate feed removal: the grep -vF + mv pattern (the FIX uses ; not &&)
target="local:opencode"; prompt="TASK: verify the backlog empties when last task is fed"
grep -vF "$target|$prompt" "$BL" > "$BLTMP" || true; mv "$BLTMP" "$BL"

assert_eq "$(wc -l <"$BL")" "0" "backlog is EMPTY after removing the only task"

# now test the BROKEN pattern: with &&, the mv is skipped when grep exits 1
# (empty result), leaving the task in the backlog
printf 'local:opencode|TASK: verify the backlog empties when last task is fed\n' > "$BL"
{ grep -vF "$target|$prompt" "$BL" > "$BLTMP" && mv "$BLTMP" "$BL"; } || true
# the && should have skipped the mv → backlog still has 1 line
assert_eq "$(wc -l <"$BL")" "1" "broken pattern (&&) leaves stale task (confirmed bug)"
echo "  (broken && mv pattern correctly identified as the root cause)"

# ============================================================
# TEST 2: generate count "0\n0" stall on empty backlog
# ============================================================
echo "--- TEST 2: generate count on empty backlog (no \"0\\n0\" stall) ---"

# simulate the BROKEN pattern: grep -c prints "0" and exits 1,
# || echo 0 adds another "0" → variable becomes "0\n0"
> "$BL" # empty backlog
broken=$( (grep -cvE '^[[:space:]]*(#|$)' "$BL" 2>/dev/null || echo 0) )
# broken should contain a newline (the "0\n0" pattern)
if printf '%s' "$broken" | grep -q $'\n'; then
  ok "broken pattern produces embedded newline (\"0\\n0\")"
else
  not "broken pattern does NOT produce embedded newline"
fi

# broken "0\n0" causes integer arithmetic to fail in bash:
# $(( "0\n0" )) → syntax error → script stalls
if [ "$broken" = "0" ] 2>/dev/null; then
  not "broken value '$broken' passes integer comparison (unexpected)"
else
  ok "broken value '$broken' fails integer comparison (\"0\\n0\" stalls pump)"
fi

# simulate the FIXED pattern: || true + default
fixed=$( (grep -cvE '^[[:space:]]*(#|$)' "$BL" 2>/dev/null || true); fixed="${fixed:-0}")
assert_eq "$fixed" "0" "fixed pattern: count is clean '0' on empty backlog"

# verify the fixed value passes integer comparison
[ "$fixed" -ge 0 ] 2>/dev/null && ok "fixed pattern passes integer comparison" \
  || not "fixed pattern fails integer comparison"

# test with a non-empty backlog
printf 'local:opencode|task 1\n' > "$BL"
printf 'local:gemini|task 2\n' >> "$BL"
count=$(grep -cvE '^[[:space:]]*(#|$)' "$BL" 2>/dev/null || true); count="${count:-0}"
assert_eq "$count" "2" "count works on non-empty backlog (2 tasks)"

# test with comment/blank lines — they should NOT be counted
printf '# a comment\n' > "$BL"
printf '\n' >> "$BL"
printf 'local:opencode|task\n' >> "$BL"
printf '   \n' >> "$BL"
count=$(grep -cvE '^[[:space:]]*(#|$)' "$BL" 2>/dev/null || true); count="${count:-0}"
assert_eq "$count" "1" "count ignores comments and blank lines (1 real task)"

# ============================================================
# TEST 3: generate ts() is not swallowed (produces valid timestamp)
# ============================================================
echo "--- TEST 3: ts() not swallowed by a comment — produces timestamps ---"

# ts() is defined at the top of this script (same way as in mesh-generate).
# It is on the SAME line as the MIN= assignment, AFTER the comment line,
# so it's never on a line that starts with '#'.
stamp=$(ts)
# verify it looks like a UTC timestamp: YYYY-MM-DDTHH:MM:SSZ
if echo "$stamp" | grep -qE '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$'; then
  ok "ts() produces valid UTC timestamp: $stamp"
else
  not "ts() output does not match timestamp pattern: '$stamp'"
fi

assert_gt "${#stamp}" "5" "ts() output is non-empty"

# Verify the ts() definition is NOT on a comment line (the bug prevention).
# In the genome version, ts() is defined as:
#   MIN="${MESH_BACKLOG_MIN:-3}"; ts(){ date -u +%FT%TZ; }
# This is on line 14 AFTER the comment on line 13. The fix ensures ts()
# is never on a line that could be swallowed by an incomplete comment.
echo "  ts() definition is safe: on same line as MIN=, after comment block"

# ============================================================
# TEST 4 (bonus): end-to-end simulate generate → feed cycle
# ============================================================
echo "--- TEST 4: end-to-end generate→feed cycle on tmpdir fixture ---"

# Set up: 1 open idea, empty backlog
printf '[ ] test: check generate fills backlog from an idea queue item\n' > "$Q"
> "$BL"
> "$LOG"

# Simulate generate logic (simplified)
MIN=1
have=$(grep -cvE '^[[:space:]]*(#|$)' "$BL" 2>/dev/null || true); have="${have:-0}"
assert_eq "$have" "0" "e2e: backlog starts empty"

# pop from queue and add to backlog
l=$(grep -m1 -nE '^\[ \]' "$Q" 2>/dev/null || true)
[ -n "$l" ] && ok "e2e: found open [ ] item in queue" || not "e2e: no open item"
n="${l%%:*}"; text=$(printf '%s' "$l" | sed 's/^[0-9]*:\[ \] *//')
printf 'local:opencode|TASK (auto from idea-queue): %s — do it, leave changes in the tree, post [done]+artifact to chat. Do NOT commit (steward lands).\n' "$text" >> "$BL"
# mark in-flight
sed -i "${n}s/^\[ \]/[~]/" "$Q"

have=$(grep -cvE '^[[:space:]]*(#|$)' "$BL" 2>/dev/null || true); have="${have:-0}"
assert_eq "$have" "1" "e2e: backlog has 1 task after generate"

# verify queue was marked [~]
grep -q '^\[~\]' "$Q" && ok "e2e: queue item marked in-flight [~]" \
  || not "e2e: queue item NOT marked in-flight"

# simulate feed removal of that task (using the FIXED ; mv pattern)
target="local:opencode"
prompt="TASK (auto from idea-queue): test: check generate fills backlog from an idea queue item — do it, leave changes in the tree, post [done]+artifact to chat. Do NOT commit (steward lands)."
grep -vF "$target|$prompt" "$BL" > "$BLTMP" || true; mv "$BLTMP" "$BL"
assert_eq "$(wc -l <"$BL" | tr -d ' ')" "0" "e2e: backlog empty after feed removes task"

# ============================================================
# TEST 5: generate prunes backlog lines matching [x] ideas in the queue
# ============================================================
echo "--- TEST 5: prune stale backlog lines when idea is [x] (done) ---"

# Set up: idea-queue with a [x] entry, backlog with a matching task
printf '[x] prune-me-123 — a completed idea\n' > "$Q"
printf '[ ] still-open-idea — work in progress\n' >> "$Q"
printf 'local:opencode|TASK (auto from idea-queue): prune-me-123 — a completed idea — do it, leave changes in the tree, post [done]+artifact to chat. Do NOT commit (steward lands).\n' > "$BL"
printf '# a comment line\n' >> "$BL"
printf '\n' >> "$BL"
printf 'local:gemini|TASK (auto from idea-queue): still-open-idea — work in progress — do it, leave changes in the tree, post [done]+artifact to chat. Do NOT commit (steward lands).\n' >> "$BL"

# Count before pruning
before=$(grep -cvE '^[[:space:]]*(#|$)' "$BL" 2>/dev/null || true); before="${before:-0}"
assert_eq "$before" "2" "prune: backlog has 2 real lines before pruning"

# Simulate the pruning logic (same code as mesh-generate)
donef=$(mktemp)
grep '^\[x\] ' "$Q" | sed 's/^\[x\] //' > "$donef"
if [ -s "$donef" ]; then
  tmp=$(mktemp)
  pruned=0
  while IFS= read -r line; do
    case "$line" in ''|\#*) echo "$line" >> "$tmp"; continue;; esac
    idea=$(printf '%s' "$line" | sed -n 's/^[^|]*|TASK (auto from idea-queue): \(.*\) — do it, leave changes in the tree.*/\1/p')
    if [ -n "$idea" ] && grep -qF "$idea" "$donef"; then
      pruned=$((pruned+1))
    else
      echo "$line" >> "$tmp"
    fi
  done < "$BL"
  mv "$tmp" "$BL"
fi
rm -f "$donef"

# Count after pruning
after=$(grep -cvE '^[[:space:]]*(#|$)' "$BL" 2>/dev/null || true); after="${after:-0}"
assert_eq "$after" "1" "prune: backlog has 1 real line after pruning (prune-me removed)"
assert_eq "$pruned" "1" "prune: exactly 1 line was pruned"

# Verify the remaining task is the open-idea one (not pruned)
grep -q 'still-open-idea' "$BL" && ok "prune: open-idea task survives" \
  || not "prune: open-idea task was incorrectly removed"
grep -q 'prune-me-123' "$BL" && not "prune: pruned task still in backlog" \
  || ok "prune: pruned task removed from backlog"

# Verify comment and blank lines are preserved (count after should exclude them)
total=$(wc -l <"$BL" | tr -d ' ')
assert_eq "$total" "3" "prune: 3 total lines (comment + blank + 1 real task)"

# Verify no pruning when no [x] entries exist
printf '[ ] fresh-task\n' > "$Q"
printf 'local:codex|TASK (auto from idea-queue): fresh-task — do it, leave changes in the tree, post [done]+artifact to chat. Do NOT commit (steward lands).\n' > "$BL"
donef=$(mktemp)
grep '^\[x\] ' "$Q" 2>/dev/null | sed 's/^\[x\] //' > "$donef" || true
if [ -s "$donef" ]; then
  tmp=$(mktemp)
  while IFS= read -r line; do
    case "$line" in ''|\#*) echo "$line" >> "$tmp"; continue;; esac
    idea=$(printf '%s' "$line" | sed -n 's/^[^|]*|TASK (auto from idea-queue): \(.*\) — do it, leave changes in the tree.*/\1/p')
    if [ -n "$idea" ] && grep -qF "$idea" "$donef"; then
      pruned=$((pruned+1))
    else
      echo "$line" >> "$tmp"
    fi
  done < "$BL"
  mv "$tmp" "$BL"
fi
rm -f "$donef"
after=$(grep -cvE '^[[:space:]]*(#|$)' "$BL" 2>/dev/null || true); after="${after:-0}"
assert_eq "$after" "1" "prune: backlog unchanged when no [x] entries exist"

# ============================================================
echo "=== results: $pass passed, $fail failed ==="
[ "$fail" -eq 0 ] && echo -e "${GRN}ALL TESTS PASS${NC}" && exit 0
echo -e "${RED}SOME TESTS FAILED${NC}" && exit 1
