#!/bin/bash
# pre-commit: refuse staged internal mesh-comms docs.
# Source of truth lives in the genome at scripts/git-hooks/pre-commit; install with:
#   cp scripts/git-hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# (`.git/` itself is never landed, so each fresh clone reinstalls.)
# Blocked: docs/health-warning-* (triage + resolver receipts — internal task-ledger
# material that belongs under the ~/.mesh evidence root per docs/EVIDENCE-MOVED.md,
# never in the PUBLIC genome). The committed-tree backstop is mesh-doctor's
# "internal comms out of git" gate (internal_comms_landmines), which FAILs and
# renders on the health pane via .doctor-fails; this hook stops it at stage time.
blocked="$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null | grep -E '^docs/health-warning-' || true)"
if [ -n "$blocked" ]; then
  echo "pre-commit: REFUSED — staged internal mesh-comms doc(s):" >&2
  printf '%s\n' "$blocked" | sed 's/^/  /' >&2
  echo "Move them under ~/.mesh (evidence root per docs/EVIDENCE-MOVED.md), never in git." >&2
  echo "Unstage with: git reset HEAD -- <path>" >&2
  exit 1
fi
exit 0
