#!/usr/bin/env bash
set -euo pipefail

message_file="${1:?commit message file is required}"
git_dir="$(git rev-parse --git-dir)"
clock_file="$git_dir/mesh-lamport.clock"
log_file="$git_dir/mesh-lamport.log"
lock_dir="$clock_file.lock"
node_id="$(git config --get mesh.node-id 2>/dev/null || true)"
node_id="${node_id:-$(hostname -s)}"

if grep -q '^Mesh-Lamport: ' "$message_file"; then
  exit 0
fi

while ! mkdir "$lock_dir" 2>/dev/null; do
  sleep 0.01
done
cleanup() {
  rmdir "$lock_dir"
}
trap cleanup EXIT

counter=0
if test -s "$clock_file"; then
  read -r counter < "$clock_file"
fi
case "$counter" in
  ''|*[!0-9]*)
    echo "commit-msg-lamport: invalid clock: $counter" >&2
    exit 2
    ;;
esac
counter=$((counter + 1))
printf '%s\n' "$counter" > "$clock_file.tmp"
mv "$clock_file.tmp" "$clock_file"

printf '\nMesh-Lamport: %s@%s\n' "$counter" "$node_id" >> "$message_file"
printf '%s@%s\t%s\t%s\n' "$counter" "$node_id" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$(git hash-object "$message_file")" >> "$log_file"
