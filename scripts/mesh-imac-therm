#!/usr/bin/env bash
# mesh-imac-therm — iMac thermal-pressure sense over the SSH organ.
# One SSH round-trip: `pmset -g therm` → CPU_Speed_Limit / CPU_Scheduler_Limit /
# CPU_Available_CPUs. macOS reports these <100 when its thermal management engages —
# the third physical machine's throttle state, previously dark to the mesh (the fleet
# already learned thermal blindness is costly: IdeaPad throttle starving minds, ds
# freezing under load — "diagnose temp FIRST"). Machine-health only: no content, no
# capture — strictly milder than the consented imac cam/mic/input senses.
#
# Output:
#   [imac-therm] NOMINAL speed_limit=100 sched_limit=100 cpus=4
#   [imac-therm] THROTTLED speed_limit=55 sched_limit=100 cpus=4
#
# State: ~/.mesh/imac-therm.state — written EVERY run (honest-fusion rule: an
# unreachable organ records UNREACHABLE, never a faked all-clear; unconditional
# write keeps mtime = ran-live, so no false-STALE on a long-stable value).
#
# Exit codes (honest-exit contract):
#   0 = real read from the iMac
#   2 = iMac unreachable or parse failed — honest n/a, never a faked reading
#
# Usage:
#   mesh-imac-therm          one-shot reading (also refreshes the state file)
#   mesh-imac-therm --json   machine-readable
#   mesh-imac-therm --test   smoke test (classifier + parse fixtures + real-read gate)
# reflex-cadence: */15 * * * *
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

IMAC_HOST="${MESH_IMAC_HOST:-ilya@192.168.8.214}"
# MESH_IMAC_THERM_STATE override wins; else MESH_TEST_SANDBOX=1 diverts the every-run write — the
# --test live-read leg deliberately unsets the override to drive the real SSH read, so pre-fix it
# stamped the LIVE imac-therm.state via .tmp+mv (task test-live-writes 2026-07-20).
STATE="${MESH_IMAC_THERM_STATE:-$HOME/.mesh/imac-therm.state}"
[ "${MESH_TEST_SANDBOX:-0}" != 1 ] || STATE="${MESH_IMAC_THERM_STATE:-${TMPDIR:-/tmp}/imac-therm.state.sandbox.$$}"
MODE=text; [ "${1:-}" = --json ] && MODE=json

read_imac() {
  timeout "${MESH_IMAC_THERM_TIMEOUT:-12}" ssh -o BatchMode=yes -o ConnectTimeout=6 \
    -o StrictHostKeyChecking=accept-new "$IMAC_HOST" "pmset -g therm" \
    </dev/null 2>/dev/null
}

# classify_therm <speed_limit> <sched_limit> → echoes "LABEL" (pure, offline-testable)
classify_therm() {
  local speed="$1" sched="$2"
  if [ "$speed" -lt 100 ] 2>/dev/null || [ "$sched" -lt 100 ] 2>/dev/null; then
    echo THROTTLED
  else
    echo NOMINAL
  fi
}

write_state() {  # $1 = the state line; unconditional write, atomic
  mkdir -p "$(dirname "$STATE")" 2>/dev/null
  printf '%s ts=%s\n' "$1" "$(date -u +%FT%TZ)" > "$STATE.tmp" && mv "$STATE.tmp" "$STATE"
}

emit() {  # $1=label $2=speed $3=sched $4=cpus
  if [ "$MODE" = json ]; then
    printf '{"label":"%s","speed_limit":%s,"sched_limit":%s,"cpus":%s,"ts":"%s"}\n' \
      "$1" "$2" "$3" "$4" "$(date -u +%FT%TZ)"
  else
    printf '[imac-therm] %s speed_limit=%s sched_limit=%s cpus=%s\n' "$1" "$2" "$3" "$4"
  fi
}

run() {
  local raw speed sched cpus label
  raw="$(read_imac)" || {
    write_state "[imac-therm] UNREACHABLE host=$IMAC_HOST"
    echo "imac-therm: iMac unreachable ($IMAC_HOST) — sense dark, not faked" >&2
    return 2
  }
  speed="$(printf '%s\n' "$raw" | awk -F'= *' '/CPU_Speed_Limit/{gsub(/[^0-9]/,"",$2); print $2; exit}')"
  sched="$(printf '%s\n' "$raw" | awk -F'= *' '/CPU_Scheduler_Limit/{gsub(/[^0-9]/,"",$2); print $2; exit}')"
  cpus="$(printf '%s\n' "$raw" | awk -F'= *' '/CPU_Available_CPUs/{gsub(/[^0-9]/,"",$2); print $2; exit}')"
  case "$speed" in (''|*[!0-9]*)
    write_state "[imac-therm] UNREACHABLE host=$IMAC_HOST reason=parse"
    echo "imac-therm: CPU_Speed_Limit parse failed (got: ${speed:-empty})" >&2; return 2 ;; esac
  case "$sched" in (''|*[!0-9]*) sched="$speed" ;; esac
  case "$cpus" in (''|*[!0-9]*) cpus=0 ;; esac
  label="$(classify_therm "$speed" "$sched")"
  write_state "[imac-therm] $label speed_limit=$speed sched_limit=$sched cpus=$cpus"
  emit "$label" "$speed" "$sched" "$cpus"
}

# ---- Smoke test ----
[ "${1:-}" = --test ] && {
  # tmp fence — task:doctor-test-tmpdir-cleanup-traps. Re-exec the smoke test ONCE under a private
  # TMPDIR and remove it from the PARENT, so the cleanup cannot be lost to the test's own `exit 1`
  # and cannot be clobbered by an EXIT trap the test sets for itself. A nested --test inherits the
  # guard var and skips its own fence (it is already inside one).
  if [ -z "${MESH_TEST_TMPD:-}" ]; then
    MESH_TEST_TMPD="$(mktemp -d)" || { echo "smoke-test: FAIL (tmp fence: mktemp -d)"; exit 1; }
    trap 'rm -rf "$MESH_TEST_TMPD"' EXIT INT HUP TERM
    export MESH_TEST_TMPD TMPDIR="$MESH_TEST_TMPD" TMP="$MESH_TEST_TMPD" TEMP="$MESH_TEST_TMPD"
    _fence_rc=0; "$0" "$@" || _fence_rc=$?; exit "$_fence_rc"
  fi
  fail=0
  _td="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp failed)"; exit 1; }
  trap 'rm -rf "$_td"' EXIT
  _scr="${BASH_SOURCE[0]}"
  export MESH_IMAC_THERM_STATE="$_td/state"   # sandbox the state artifact — fixtures never touch the real one
  # TEST-SANDBOX (task test-live-writes 2026-07-20): the live-read leg unsets the override above to
  # drive the real SSH read — the exported flag makes its state write divert; %y sig gate at the end.
  export MESH_TEST_SANDBOX=1
  _it_live="$HOME/.mesh/imac-therm.state"
  _it_sig="$(stat -c '%y %s' "$_it_live" 2>/dev/null || echo absent)"

  # Classifier assertions (pure)
  [ "$(classify_therm 100 100)" = NOMINAL ]   || { echo "FAIL: classify 100/100"; fail=1; }
  [ "$(classify_therm 55 100)" = THROTTLED ]  || { echo "FAIL: classify 55/100"; fail=1; }
  [ "$(classify_therm 100 80)" = THROTTLED ]  || { echo "FAIL: classify 100/80"; fail=1; }

  # Fixture 1: healthy Intel-mac output → NOMINAL
  cat > "$_td/ssh" <<'EOF'
#!/usr/bin/env bash
printf 'Note: No thermal warning level has been recorded\n'
printf 'Note: No performance warning level has been recorded\n'
printf '2026-07-05 22:07:42 +0300 CPU Power notify\n'
printf '\tCPU_Scheduler_Limit \t= 100\n'
printf '\tCPU_Available_CPUs \t= 4\n'
printf '\tCPU_Speed_Limit \t= 100\n'
EOF
  chmod +x "$_td/ssh"
  out="$(PATH="$_td:/usr/bin:/bin" bash "$_scr" 2>&1)" && \
    [ "$out" = "[imac-therm] NOMINAL speed_limit=100 sched_limit=100 cpus=4" ] || \
    { echo "FAIL: healthy fixture (got: $out)"; fail=1; }
  grep -q '^\[imac-therm\] NOMINAL' "$_td/state" || { echo "FAIL: state not written on healthy run"; fail=1; }

  # Fixture 2: thermally throttled → THROTTLED
  cat > "$_td/ssh" <<'EOF'
#!/usr/bin/env bash
printf '\tCPU_Scheduler_Limit \t= 100\n'
printf '\tCPU_Available_CPUs \t= 4\n'
printf '\tCPU_Speed_Limit \t= 55\n'
EOF
  out="$(PATH="$_td:/usr/bin:/bin" bash "$_scr" 2>&1)" && \
    [ "$out" = "[imac-therm] THROTTLED speed_limit=55 sched_limit=100 cpus=4" ] || \
    { echo "FAIL: throttled fixture (got: $out)"; fail=1; }

  # Fixture 3: unreachable → exit 2, empty stdout, state records UNREACHABLE (not a fake all-clear)
  cat > "$_td/ssh" <<'EOF'
#!/usr/bin/env bash
exit 255
EOF
  out="$(PATH="$_td:/usr/bin:/bin" bash "$_scr" 2>/dev/null)"; rc=$?
  { [ "$rc" = 2 ] && [ -z "$out" ]; } || { echo "FAIL: unreachable must exit 2 with empty stdout (rc=$rc out=$out)"; fail=1; }
  grep -q '^\[imac-therm\] UNREACHABLE' "$_td/state" || { echo "FAIL: unreachable must record honest UNREACHABLE state"; fail=1; }

  # Fixture 4: garbled output (no CPU_Speed_Limit) → exit 2, never emit garbage
  cat > "$_td/ssh" <<'EOF'
#!/usr/bin/env bash
printf 'permission denied\n'
EOF
  out="$(PATH="$_td:/usr/bin:/bin" bash "$_scr" 2>/dev/null)"; rc=$?
  { [ "$rc" = 2 ] && [ -z "$out" ]; } || { echo "FAIL: garbled read must exit 2 (rc=$rc out=$out)"; fail=1; }

  [ "$fail" = 0 ] || { echo "smoke-test: FAIL (fixtures)"; exit 1; }

  # Real-read gate (verification principle: a live read must parse to a numeric limit; a
  # reachable-but-hollow organ must NOT pass). Unreachable iMac = honest exit 2, never fake green.
  unset MESH_IMAC_THERM_STATE
  live="$(bash "$_scr" 2>/dev/null)"; live_rc=$?
  # sandbox honesty gate — before BOTH exits (ok and unreachable-n/a). Falsify: drop the
  # MESH_TEST_SANDBOX diversion at the STATE assignment → the live leg stamps via .tmp+mv.
  _it_sig2="$(stat -c '%y %s' "$_it_live" 2>/dev/null || echo absent)"
  if [ "$_it_sig2" != "$_it_sig" ]; then
    # HONESTY-GATE ATTRIBUTION (memory a-sandbox-honesty-gate-cannot-separate-a-leak-from-a-collision):
    # a moved live artifact has TWO causes and ONE sample cannot separate them — a leaking sandbox,
    # or a CONCURRENT live writer (this reflex's own cron tick, or any other tool that writes the
    # same path) stamping it inside the test window. The single-sample form blamed the test and went
    # red with nothing wrong (mesh-node-health 2026-08-15, mesh-sound-reflex c5779d6); mesh-land and
    # mesh-doctor both consume this verdict, so a false red BLOCKS LANDING. No lock covers this
    # write path, so attribute by REPEATING: a real leak moves the artifact on EVERY attempt, a
    # collision does not repeat. Drive both directions — leak twice must still FAIL, leak once must
    # print the note and pass.
    if [ -n "${MESH_HONESTY_RETRY:-}" ]; then echo "smoke-test: FAIL (--test stamped the LIVE state $_it_live: '$_it_sig' → '$_it_sig2' — moved on BOTH attempts, a real sandbox leak, not a concurrent-writer collision)"; exit 1; fi
    _hr_a="$(stat -c '%y %s' "$_it_live" 2>/dev/null || echo absent)"
    MESH_HONESTY_RETRY=1 "$0" --test >/dev/null 2>&1
    _hr_b="$(stat -c '%y %s' "$_it_live" 2>/dev/null || echo absent)"
    [ "$_hr_b" = "$_hr_a" ] || { echo "smoke-test: FAIL (--test stamped the LIVE state $_it_live: '$_it_sig' → '$_it_sig2' — moved on BOTH attempts, a real sandbox leak, not a concurrent-writer collision)"; exit 1; }
    echo "  note: a LIVE artifact moved during attempt 1 but NOT during the re-run — attributed to a concurrent live writer, not a sandbox leak"
  fi
  if [ "$live_rc" = 0 ]; then
    printf '%s\n' "$live" | grep -qE '^\[imac-therm\] (NOMINAL|THROTTLED) speed_limit=[0-9]+ sched_limit=[0-9]+ cpus=[0-9]+$' || {
      echo "smoke-test: FAIL (live read rc=0 but output malformed: $live)"; exit 1; }
    echo "smoke-test: ok (3 classifier + 4 parse fixtures + live read: $live)"
    exit 0
  else
    echo "smoke-test: n/a — fixtures ok but iMac unreachable (honest exit 2, live read unverified)"
    exit 2
  fi
}

run
