#!/usr/bin/env bash
# reflex-cadence: */5 * * * *
# reflex-args: --edge
# doctor-artifact: $HOME/.mesh/.thermal-alarm.state 900 sys
# mesh-thermal-alarm — hardware-monitor thermal alarm sense.
#
# Reads the hwmon driver's asserted temp*_alarm bit together with the corresponding
# temp*_input value. This is a relation unavailable from temperature alone: CLEAR means
# the driver read a live sensor and no alarm is asserted; ALARM means the hardware monitor
# itself asserted at least one threshold. Missing or malformed pairs are UNKNOWN (exit 2).
# A quiet alarm is a real reading, never a default.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME="$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6)"
export HOME

MESH="${MESH_DIR:-$HOME/.mesh}"
ROOT="${MESH_THERMAL_ALARM_ROOT:-/sys/class/hwmon}"
STATE="${MESH_THERMAL_ALARM_STATE:-$MESH/.thermal-alarm.state}"

read_alarm() {
  local root="$1" alarm input value name alarms=0 max_mC="" count=0
  shopt -s nullglob
  for alarm in "$root"/hwmon*/temp*_alarm; do
    [ -r "$alarm" ] || continue
    input="${alarm%_alarm}_input"
    [ -r "$input" ] || continue
    value="$(tr -d '[:space:]' < "$alarm" 2>/dev/null)"
    name="$(tr -d '[:space:]' < "$input" 2>/dev/null)"
    case "$value:$name" in
      0:[0-9]*|1:[0-9]*) ;;
      *) continue ;;
    esac
    alarms=$((alarms + value))
    [ "$name" -gt "${max_mC:-0}" ] && max_mC="$name"
    count=$((count + 1))
  done
  shopt -u nullglob
  [ "$count" -gt 0 ] || return 2
  if [ "$alarms" -gt 0 ]; then
    printf 'ALARM %s %s\n' "$count" "$max_mC"
  else
    printf 'CLEAR %s %s\n' "$count" "$max_mC"
  fi
}

if [ "${1:-}" = --test ]; then
  td="$(mktemp -d)" || { echo 'smoke-test: FAIL (mktemp)'; exit 1; }
  trap 'rm -rf "$td"' EXIT
  mkdir -p "$td/hwmon0"
  printf '1\n' > "$td/hwmon0/temp1_alarm"
  printf '62000\n' > "$td/hwmon0/temp1_input"
  got="$(read_alarm "$td")" || { echo 'smoke-test: FAIL (fixture read)'; exit 1; }
  [ "$got" = 'ALARM 1 62000' ] || { echo "smoke-test: FAIL (alarm relation: $got)"; exit 1; }
  printf '0\n' > "$td/hwmon0/temp1_alarm"
  got="$(read_alarm "$td")" || { echo 'smoke-test: FAIL (clear fixture read)'; exit 1; }
  [ "$got" = 'CLEAR 1 62000' ] || { echo "smoke-test: FAIL (clear relation: $got)"; exit 1; }
  read_alarm "$td/missing" >/dev/null 2>&1 && {
    echo 'smoke-test: FAIL (missing hwmon root must be unreachable)'; exit 1;
  }
  live="$(read_alarm "$ROOT")" || {
    echo "smoke-test: n/a (no readable hwmon alarm+input pair under $ROOT)"; exit 2;
  }
  echo "smoke-test: ok (fixture alarm/clear + honest missing-root gate + REAL hwmon alarm read: $live)"
  exit 0
fi

reading="$(read_alarm "$ROOT")" || {
  echo "mesh-thermal-alarm: UNKNOWN — no readable hwmon alarm+input pair under $ROOT" >&2
  exit 2
}
read -r verdict sensors max_mC <<< "$reading"
mkdir -p "$(dirname "$STATE")" 2>/dev/null || {
  echo "mesh-thermal-alarm: UNKNOWN — cannot create state directory" >&2; exit 1;
}
printf '%s|sensors=%s|max_temp_mC=%s|ts=%s\n' "$verdict" "$sensors" "$max_mC" "$(date -u +%FT%TZ)" > "$STATE" || exit 1
mesh-state-touch "$STATE" >/dev/null 2>&1 || {
  echo 'mesh-thermal-alarm: UNKNOWN — could not stamp live state' >&2; exit 1;
}

if [ "${1:-}" = --json ]; then
  printf '{"verdict":"%s","sensors":%s,"max_temp_mC":%s,"ts":"%s"}\n' \
    "$verdict" "$sensors" "$max_mC" "$(date -u +%FT%TZ)"
elif [ "${1:-}" = --edge ]; then
  old="$(sed -n '1s/|.*//p' "$STATE.prev" 2>/dev/null || true)"
  cp "$STATE" "$STATE.prev" 2>/dev/null || true
  [ "$old" = "$verdict" ] && exit 0
  printf '[thermal-alarm] %s — sensors=%s max_temp=%.1fC\n' "$verdict" "$sensors" "$(awk -v m="$max_mC" 'BEGIN{print m/1000}')"
else
  printf '[thermal-alarm] %s — sensors=%s max_temp=%.1fC\n' "$verdict" "$sensors" "$(awk -v m="$max_mC" 'BEGIN{print m/1000}')"
fi
