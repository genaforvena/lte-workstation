#!/usr/bin/env bash
# orphan-ok: on-demand live input; a consumer can pull the NVDEC engine reading when video decode matters.
# mesh-gpu-decoder — live activity percentage from each NVIDIA GPU's NVDEC engine.
# This is decoder-engine utilization, not general GPU utilization, encoder utilization, or video quality.
# Unreadable/unsupported data is UNKNOWN (exit 2); N/A is never turned into zero.
#
#   mesh-gpu-decoder          one live reading
#   mesh-gpu-decoder --json   machine-readable reading
#   mesh-gpu-decoder --test   fixture parsing + a real NVIDIA driver read
set -uo pipefail
export PATH="${HOME:-}/.local/bin:$PATH"

SMI="${MESH_GPU_DECODER_SMI:-nvidia-smi}"
ROWS=()

read_rows() {
  local raw line index percent extra
  raw="$($SMI --query-gpu=index,utilization.decoder --format=csv,noheader,nounits 2>/dev/null)" || return 2
  [ -n "$raw" ] || return 2
  ROWS=()
  while IFS= read -r line; do
    [ -n "${line//[[:space:]]/}" ] || continue
    IFS=',' read -r index percent extra <<<"$line"
    index="$(printf '%s' "${index:-}" | tr -d '[:space:]')"
    percent="$(printf '%s' "${percent:-}" | tr -d '[:space:]')"
    extra="$(printf '%s' "${extra:-}" | tr -d '[:space:]')"
    case "$index" in ''|*[!0-9]*) return 2;; esac
    case "$percent" in ''|*[!0-9]*) return 2;; esac
    [ -z "$extra" ] && [ "$percent" -le 100 ] || return 2
    ROWS+=("$index $percent")
  done <<<"$raw"
  [ "${#ROWS[@]}" -gt 0 ] || return 2
}

render_json() {
  local row index percent first=1
  printf '{"source":"nvidia-smi","engines":['
  for row in "${ROWS[@]}"; do
    read -r index percent <<<"$row"
    [ "$first" = 1 ] || printf ','
    first=0
    printf '{"gpu_index":%s,"decoder_utilization_percent":%s}' "$index" "$percent"
  done
  printf ']}
'
}

if [ "${1:-}" = --test ]; then
  td="$(mktemp -d "${TMPDIR:-/tmp}/mesh-gpu-decoder.XXXXXX")" || exit 1
  trap 'rm -rf "$td"' EXIT
  cat >"$td/smi-ok" <<'EOF'
#!/usr/bin/env bash
printf '0, 0\n1, 63\n'
EOF
  cat >"$td/smi-na" <<'EOF'
#!/usr/bin/env bash
printf '0, N/A\n'
EOF
  chmod +x "$td/smi-ok" "$td/smi-na"
  fixture="$(MESH_GPU_DECODER_SMI="$td/smi-ok" "$0" --json 2>/dev/null)" || {
    echo 'mesh-gpu-decoder --test: FAIL (fixture parse)' >&2; exit 1;
  }
  [[ "$fixture" == *'"gpu_index":0,"decoder_utilization_percent":0'* &&
     "$fixture" == *'"gpu_index":1,"decoder_utilization_percent":63'* ]] || {
    echo "mesh-gpu-decoder --test: FAIL (fixture output: $fixture)" >&2; exit 1;
  }
  MESH_GPU_DECODER_SMI="$td/smi-na" "$0" --json >/dev/null 2>&1
  rc=$?
  [ "$rc" -eq 2 ] || { echo "mesh-gpu-decoder --test: FAIL (N/A must exit 2, got $rc)" >&2; exit 1; }

  live="$($0 --json 2>/dev/null)"
  rc=$?
  if [ "$rc" -eq 2 ]; then
    echo 'mesh-gpu-decoder --test: n/a — fixtures passed; live decoder data unavailable (exit 2)' >&2
    exit 2
  fi
  [ "$rc" -eq 0 ] && [[ "$live" == *'"decoder_utilization_percent":'* ]] || {
    echo "mesh-gpu-decoder --test: FAIL (live driver read rc=$rc output=$live)" >&2; exit 1;
  }
  echo "mesh-gpu-decoder --test: PASS (fixtures, N/A exit-2, live driver read: $live)"
  exit 0
fi

mode=text
case "${1:-}" in
  '') ;;
  --json) mode=json;;
  *) echo 'usage: mesh-gpu-decoder [--json|--test]' >&2; exit 2;;
esac

read_rows || {
  echo 'gpu-decoder: UNREACHABLE — NVIDIA driver has no numeric decoder utilization reading' >&2
  exit 2
}
if [ "$mode" = json ]; then
  render_json
else
  for row in "${ROWS[@]}"; do
    read -r index percent <<<"$row"
    printf '[gpu-decoder] gpu_index=%s decoder_utilization_percent=%s (NVDEC engine)\n' "$index" "$percent"
  done
fi
