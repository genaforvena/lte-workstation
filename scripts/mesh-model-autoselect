#!/usr/bin/env python3
# reflex-cadence: 41 6 * * *
"""mesh-model-autoselect — the HAND that closes the model loop.

THE LOOP: mesh-model-watch searches (CLOCK), mesh-model-bench measures (RULER),
mesh-model-resolve observes (EYE), mesh-model-gap reports (REPORTER) — and this one ACTS
(operator 2026-07-16: "all models tested, best picked and USED, driven by the models pane
even if my context is cleared"). Everything upstream stays judgment-free; the judgment this
tool adds is exactly one relation and one line: DOMINANCE plus a MARGIN, on arithmetic pins
only.

THE TASTE LINE (the reconciliation with mesh-model-gap's "a human decides"). gap's header is
right that a pin can be an EAR (irina, A/B'd live by the operator) and no metric may overrule
an ear. It is also right that a pin can be ARITHMETIC (a number whose premise can die with the
hardware, like the 10x-stale base-on-CPU pin). These are distinguishable ONLY by declaration,
so the ORGANS table declares pin_kind per organ and the engine enforces:

  arithmetic  -> may AUTO-SWITCH, and only when the challenger DOMINATES the incumbent
                 (better on accuracy AND not worse on wall — gap's own weight-free relation)
                 by at least the organ's declared margin on the accuracy axis.
  taste       -> NEVER auto-applied, whatever the numbers say. mesh-model-gap already
                 reports these to the human; this tool only logs the pointer.

A TRADEOFF NEVER AUTO-SWITCHES. More-accurate-but-slower is a preference, and a preference
belongs to a human (or to gap's report). Only dominance — better on one axis, worse on none —
carries no hidden weighting and is safe to act on unattended.

DISQUALIFICATION IS BY STATUS, NEVER BY RANK. EMPTY (returned nothing), DEAF (missed a real
address — would win by silencing everything), UNPARSED (no verdict the consumer's parser can
read — a PARSING loss, not competence: the qwen3.5 lesson) are excluded from candidacy
outright. Ranking them low instead would let a broken organ inch onto the podium the day the
corpus shifts.

ACTUATION IS GUARDED THREE WAYS. (1) COST-BOUND: <= MAX_BENCH benches and <= 1 switch per
run, a per-organ switch cooldown, and every skipped/deferred action is LOGGED — a silent cap
reads as "covered everything" (canon). (2) POST-VERIFY: after a switch the organ must prove
it still works (the wake gate must still FILTER junk and WAKE on an address; a daemon must
survive its restart) — a pin that lands but kills the organ is worse than no switch.
(3) ROLLBACK: any apply/verify failure restores the previous pin and restarts, so the room is
never left deaf by a half-landed switch.

PIN SURFACES ARE THE LIVE ONES. The wake gate runs as a child of mesh-room-reflex.service and
the room ear reads GIGAAM_MODEL from mesh-room-gigaam.service, so both pins are systemd user
unit Environment= (written via a drop-in, so the unit file itself is never edited). The last
Environment= assignment wins in systemd, which is what makes a drop-in override the unit's
inline default. mesh-model-resolve reads the same surfaces, so after a switch the EYE reports
the new incumbent and the next run sees itself — the loop is idempotent, not flapping.

ONE RULER, ONE LEDGER, ONE DEFINITION. Candidate registries come from the deployed
mesh-model-bench; read_ledger/dominates/model_of_file come from the deployed mesh-model-gap —
imported, never copied (two copies of a rule ARE two rules, and the far one rots).

STDLIB ONLY. System python3 on this node has no numpy.
"""
import importlib.machinery
import importlib.util
import os
import re
import subprocess
import sys
import time
from pathlib import Path

HOME = Path.home()
MESH = HOME / ".mesh"
BIN = Path(os.environ.get("MESH_BIN_DIR", HOME / ".local/bin"))
LOG = MESH / "model-autoselect.log"
STATE = MESH / "model-autoselect.state"

MAX_BENCH = 2            # benches per run — a bench is minutes of GPU/CPU, not free
MAX_SWITCH = 1           # switches per run — one substrate-adjacent change at a time
COOLDOWN_S = 7 * 86400   # per-organ: a switch a week is a decision, daily flapping is noise


def _load(tool):
    """Import a DEPLOYED mesh tool as a module (their definitions, not copies). Deployed
    (~/.local/bin), not the genome checkout: an undeployed edit must not change what we do."""
    src = BIN / tool
    if not src.exists():
        raise FileNotFoundError(f"{tool} not deployed at {src}")
    spec = importlib.util.spec_from_file_location(
        tool.replace("-", "_"), str(src),
        loader=importlib.machinery.SourceFileLoader(tool.replace("-", "_"), str(src)))
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


def _sh(cmd, timeout=60, env=None):
    return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, env=env)


def _log(line):
    ts = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    with open(LOG, "a") as fh:
        fh.write(f"{ts} {line}\n")
    print(line)


# ------------------------------------------------------------------ pin actuation (systemd)

def dropin_content(var, ref):
    """The exact drop-in a switch writes. Pure so --test can pin the rendered artifact."""
    return f"# written by mesh-model-autoselect — the model pin this organ runs\n[Service]\nEnvironment={var}={ref}\n"


class EnvPin:
    """A model pin that lives in a systemd user unit's Environment=. apply/rollback go through
    a drop-in (autoselect.conf) so the unit file itself is never edited and a rollback is
    'restore/remove one file + restart'."""

    def __init__(self, unit, var):
        self.unit, self.var = unit, var
        self.dropin = HOME / ".config/systemd/user" / f"{unit}.d" / "autoselect.conf"

    def exists(self):
        return _sh(["systemctl", "--user", "cat", self.unit], timeout=30).returncode == 0

    def current_dropin(self):
        return self.dropin.read_text() if self.dropin.exists() else None

    def _reload_restart(self):
        _sh(["systemctl", "--user", "daemon-reload"], timeout=30)
        r = _sh(["systemctl", "--user", "restart", self.unit], timeout=60)
        return r.returncode == 0

    def apply(self, ref):
        self.dropin.parent.mkdir(parents=True, exist_ok=True)
        self.dropin.write_text(dropin_content(self.var, ref))
        return self._reload_restart()

    def rollback(self, prev):
        if prev is None:
            try:
                self.dropin.unlink()
            except OSError:
                pass
        else:
            self.dropin.parent.mkdir(parents=True, exist_ok=True)
            self.dropin.write_text(prev)
        return self._reload_restart()


def _unit_active(unit):
    return _sh(["systemctl", "--user", "is-active", unit], timeout=30).stdout.strip() == "active"


def verify_wake(ref):
    """Post-verify for a wake-gate switch: the reflex unit survived, and under the new pin the
    DEPLOYED gate still FILTERS junk (rc=1 — proves the model answers and parses; an absent or
    unparseable model fails OPEN and this reads rc=0) and still WAKES on the canonical address
    (rc=0 — never leave the room deaf). Failing safe here rolls back a good switch at worst;
    passing a bad one leaves the gate a paid-turn passthrough or a deaf room."""
    if not _unit_active("mesh-room-reflex.service"):
        return False, "mesh-room-reflex.service not active after restart"
    gate = BIN / "mesh-room-address"
    env = dict(os.environ, ROOM_ADDRESS_MODEL=ref)
    junk = _sh([str(gate), "Время"], timeout=120, env=env)
    if junk.returncode != 1:
        return False, f"gate did not FILTER junk under {ref} (rc={junk.returncode}) — fail-open passthrough"
    addr = _sh([str(gate), "Миша, ты нас слышишь сейчас или нет? По-моему, нет."], timeout=120, env=env)
    if addr.returncode != 0:
        return False, f"gate went DEAF on the canonical address under {ref}"
    return True, "unit active; gate filters junk and wakes on address under the new pin"


def verify_room_ear(ref):
    """Post-verify for the room-ear transcriber: the daemon survived its restart AND is still
    up after a settle (a bad model crash-loops under Restart=always — instant is-active is a
    coin), and the unit really carries the new pin. The model's ability to transcribe was
    already proven by the read-ok bench row that made it a candidate; an empty room offers no
    live transcript to assert, and waiting for speech would block the run."""
    if not _unit_active("mesh-room-gigaam.service"):
        return False, "mesh-room-gigaam.service not active after restart"
    time.sleep(6)
    if not _unit_active("mesh-room-gigaam.service"):
        return False, "mesh-room-gigaam.service died within 6s of restart — crash-loop"
    show = _sh(["systemctl", "--user", "show", "mesh-room-gigaam.service", "-p", "Environment"],
               timeout=30).stdout
    if not re.search(rf"(?:^|\s)GIGAAM_MODEL={re.escape(ref)}(?:\s|$)", show):
        return False, f"unit Environment does not carry GIGAAM_MODEL={ref} — the pin did not land"
    return True, "daemon stable through restart, unit carries the new pin"


# ------------------------------------------------------------------------------ organ table

def organs(bench_mod):
    """Per-organ contract: modality+fixture (the RULER's coordinates), resolve key (the EYE's
    row), candidate registry + eligibility, pin kind, pin surface + verify (the HAND's verbs),
    and the accuracy margin a switch must clear. Adding an organ = adding a row here once its
    modality has a harness and a fixture."""
    return [
        {
            "key": "wake/room-wake", "modality": "wake", "fixture": "wakegate-ru-01",
            "resolve": ("text", "room-wake"),
            "registry": dict(bench_mod.WAKE_CANDIDATES),
            "eligible": lambda kind, ref: kind == "ollama",
            "ref_of": lambda name, reg=bench_mod.WAKE_CANDIDATES: reg[name][1],
            "pin_kind": "arithmetic", "margin": 0.10,   # >= ~2 junk lines on the 16-IGNORE corpus
            "pin": EnvPin("mesh-room-reflex.service", "ROOM_ADDRESS_MODEL"),
            "verify": verify_wake,
        },
        {
            "key": "stt/room-ear", "modality": "stt", "fixture": "stt-ru-operator-0812",
            "resolve": ("stt", "room-ear"),
            "registry": dict(bench_mod.STT_CANDIDATES),
            # the unit can only load gigaam models — a whisper file in GIGAAM_MODEL is a crash
            "eligible": lambda kind, ref: kind == "gigaam",
            "ref_of": lambda name, reg=bench_mod.STT_CANDIDATES: reg[name][1],
            "pin_kind": "arithmetic", "margin": 0.05,
            "pin": EnvPin("mesh-room-gigaam.service", "GIGAAM_MODEL"),
            "verify": verify_room_ear,
        },
        {
            # THE OPERATOR'S EAR. Kept in the table so the engine's taste guard is exercised
            # against a real organ, and so the log says WHY nothing will ever be auto-applied.
            "key": "tts/note3-say", "modality": "tts", "fixture": "tts-ru-authored-01",
            "resolve": ("tts", "note3-say"),
            "registry": dict(bench_mod.TTS_CANDIDATES),
            "eligible": lambda kind, ref: True,
            "ref_of": lambda name: name,
            "pin_kind": "taste",
            "pin_desc": "MESH_PIPER_VOICE in ~/.mesh/nodes — THE OPERATOR'S EAR (gap reports it; nobody switches it)",
        },
    ]


# ----------------------------------------------------------------------------- pure decision

def eligible_rows(rows, organ):
    """Candidate rows for one organ: right modality+fixture, HONEST reads only, models this
    organ can actually load. Status filtering is the DEAF/UNPARSED/EMPTY disqualifier."""
    out = []
    for r in rows:
        if r["organ"] != organ["modality"] or r["fixture"] != organ["fixture"]:
            continue
        if r["status"] != "read-ok":
            continue
        reg = organ["registry"].get(r["model"])
        if reg is None or not organ["eligible"](reg[0], reg[1]):
            continue
        out.append(r)
    return out


def decide(organ, cand_rows, incumbent_model, dominates, cost_for):
    """Pure verdict for one organ. Returns (verdict, challenger_row_or_None, reason).
    Verdicts: OK (incumbent is the pick) · HOLD (a better model exists but not actionable:
    tradeoff or sub-margin) · SWITCH (dominant challenger cleared the margin) · UNBENCHED.

    THE TIME AXIS IS THE ONE THE CONSUMER PAYS — gap's cost_for, chosen by the organ's
    declared residency (warm-vs-cold, 2026-07-16). The room reflex is scored RESIDENT: it
    spawns the gate per line, but the MODEL sits resident in the ollama server, and the wake
    row's warm column is measured through the whole spawned gate call — literally the
    per-line cost the reflex pays mid-conversation. Scoring it on cold (col 6, load-dominated)
    would let a slow-loading but fast-answering model be vetoed by a cost it pays once per
    conversation, not per line."""
    resident = organ.get("resident", False)
    cands = [dict(r, cost=cost_for(r, resident)) for r in cand_rows]
    inc = next((r for r in cands if r["model"] == incumbent_model), None)
    if inc is None:
        return "UNBENCHED", None, f"incumbent {incumbent_model} has no read-ok row on this fixture"
    others = [r for r in cands if r["model"] != incumbent_model]
    if not others:
        return "OK", None, "no other eligible candidate is benched"
    best = min(others, key=lambda r: (r["wer"], r["cost"]))
    if not dominates(best, inc, axis="cost"):
        if best["wer"] < inc["wer"]:
            return "HOLD", best, (f"{best['model']} is more accurate ({best['wer']:.3f} vs "
                                  f"{inc['wer']:.3f}) but not dominant — a TRADEOFF, a human weighs it")
        return "OK", None, "incumbent is on the pareto front"
    gain = inc["wer"] - best["wer"]
    if gain < organ.get("margin", 0.0):
        return "HOLD", best, (f"{best['model']} dominates but the accuracy gain {gain:.3f} is "
                              f"under the {organ['margin']:.3f} margin — not worth a substrate touch")
    return "SWITCH", best, (f"{best['model']} DOMINATES {incumbent_model} "
                            f"(wer {best['wer']:.3f} vs {inc['wer']:.3f}, {organ.get('resident') and 'warm' or 'cold'} "
                            f"cost {best['cost']:.2f}s vs {inc['cost']:.2f}s) and clears the margin")


# ---------------------------------------------------------------------------------- state

def read_state(path=STATE):
    st = {}
    if path.exists():
        for ln in path.read_text().splitlines():
            p = ln.split("\t")
            if len(p) >= 4:
                st[p[0]] = {"ts": float(p[1]), "from": p[2], "to": p[3]}
    return st


def write_switch(key, frm, to, path=STATE, now=None):
    now = time.time() if now is None else now
    with open(path, "a") as fh:
        fh.write(f"{key}\t{now:.0f}\t{frm}\t{to}\n")


# ---------------------------------------------------------------------------------- engine

def tend(organ_list, rows, incumbents, state, dominates, cost_for, *, now=None, log=_log,
         bench_fn=None, chat_fn=None, apply_override=None, max_bench=MAX_BENCH,
         max_switch=MAX_SWITCH, cooldown=COOLDOWN_S, dry_run=False, state_write=None):
    """One pass over the organ table. Every dependency is injectable so --test can drive the
    switching/rollback/guard paths without touching systemd, the ledger, or a model.
    Returns the list of (key, verdict) it decided."""
    now = time.time() if now is None else now
    benched = 0
    switched = 0
    results = []
    for organ in organ_list:
        key = organ["key"]
        # TASTE is decided before anything else — an ear-owned organ never acts, so neither a
        # blind EYE nor an unmappable incumbent may demote its honest TASTE log to a SKIP
        # (resolve reports note3-say as a FILE name that maps to no registry key; caught live
        # on the first dry-run, 2026-07-16).
        if organ["pin_kind"] != "arithmetic":
            log(f"{key}: TASTE — never auto-applied ({organ.get('pin_desc', 'human pin')})")
            results.append((key, "TASTE")); continue
        inc = incumbents.get(organ["resolve"])
        if not inc or inc == "UNKNOWN":
            log(f"{key}: SKIP — resolve reads no incumbent (the EYE is blind here, not the organ)")
            results.append((key, "SKIP")); continue
        # resolve answers in the shape the consumer's own selector yields — a registry NAME
        # (wake tags), a REF (v2_ctc), or a file's basename — so match all three (the
        # model_of_file lesson: a shape you cannot map reads as a gap that is really a bug).
        inc_model = next((n for n, (_k, ref) in organ["registry"].items()
                          if inc in (n, ref) or Path(inc).name in (n, ref)), None)
        if inc_model is None:
            log(f"{key}: SKIP — incumbent '{inc}' maps to no registered candidate")
            results.append((key, "SKIP")); continue

        # bench what has NO ROW AT ALL, bounded and LOUD about what it skipped. `have` is
        # every model with ANY row on this fixture — including DEAF/UNPARSED/EMPTY: a
        # disqualifying verdict is a MEASUREMENT, and treating it as absence re-benches the
        # same broken candidate every run forever (caught live on the first dry-run: the
        # UNPARSED qwen3.5:4b read as 'missing' behind the bench cap).
        if bench_fn is not None:
            have = {r["model"] for r in rows
                    if r["organ"] == organ["modality"] and r["fixture"] == organ["fixture"]}
            missing = [m for m, (kind, ref) in sorted(organ["registry"].items())
                       if m not in have and organ["eligible"](kind, ref)]
            for m in missing:
                if benched >= max_bench:
                    log(f"{key}: BENCH-CAP — skipped benching {missing[missing.index(m):]} this run "
                        f"(cap {max_bench}); they remain unmeasured, not slow")
                    break
                ok, note = bench_fn(organ["modality"], m, organ["fixture"])
                benched += 1
                log(f"{key}: benched {m} -> {note}")
                if ok:
                    rows = None  # ledger changed; caller-supplied reader refreshes below
            if rows is None and bench_fn is not None:
                rows = bench_fn("__reread__", None, None)

        cands = eligible_rows(rows, organ)
        verdict, chal, reason = decide(organ, cands, inc_model, dominates, cost_for)
        if verdict != "SWITCH":
            log(f"{key}: {verdict} — {reason}")
            results.append((key, verdict)); continue

        last = state.get(key)
        if last and now - last["ts"] < cooldown:
            log(f"{key}: HOLD — {reason}; but last switch was {int((now - last['ts']) / 3600)}h "
                f"ago (cooldown {int(cooldown / 3600)}h)")
            results.append((key, "HOLD")); continue
        if switched >= max_switch:
            log(f"{key}: DEFERRED — {reason}; but {switched} switch(es) already made this run "
                f"(cap {max_switch}). Next run takes it.")
            results.append((key, "DEFERRED")); continue
        if dry_run:
            log(f"{key}: WOULD-SWITCH (dry-run) — {reason}")
            results.append((key, "WOULD-SWITCH")); continue

        # ---- the actuation dance: snapshot -> apply -> verify -> commit | rollback
        pin, verify = (apply_override or {}).get(key, (organ["pin"], organ["verify"]))
        ref = organ["ref_of"](chal["model"])
        prev = pin.current_dropin()
        log(f"{key}: SWITCHING {inc_model} -> {chal['model']} ({reason})")
        ok = False
        try:
            ok = pin.apply(ref)
            if ok:
                ok, vnote = verify(ref)
            else:
                vnote = "apply failed (unit restart rc!=0)"
        except Exception as e:
            ok, vnote = False, f"apply/verify raised: {type(e).__name__}: {e}"
        if not ok:
            pin.rollback(prev)
            log(f"{key}: SWITCH-FAILED — {vnote}; ROLLED BACK to previous pin, organ restarted")
            if chat_fn:
                chat_fn(f"[fyi] autoselect: {key} switch {inc_model}->{chal['model']} FAILED "
                        f"post-verify ({vnote}) — rolled back, incumbent intact")
            results.append((key, "SWITCH-FAILED")); continue
        # state_write is INJECTED (defaulting to the real file) so --test can never forge the
        # artifact the cooldown reads — a test that writes the real state would shield the
        # next real switch behind a cooldown that never happened (the mesh-guardian trap).
        (state_write or write_switch)(key, inc_model, chal["model"], now=now)
        state[key] = {"ts": now, "from": inc_model, "to": chal["model"]}
        switched += 1
        log(f"{key}: SWITCHED {inc_model} -> {chal['model']} — post-verify: {vnote}")
        if chat_fn:
            chat_fn(f"[fyi] autoselect: {key} SWITCHED {inc_model} -> {chal['model']} — {reason}; "
                    f"post-verify ok ({vnote}); pin={pin.unit} {pin.var}; rollback armed in "
                    f"{pin.dropin}")
        results.append((key, "SWITCHED"))
    return results


# ------------------------------------------------------------------------------------ main

def incumbents_from_resolve():
    """(organ, consumer) -> model, from the EYE. UNKNOWN stays UNKNOWN."""
    r = _sh([str(BIN / "mesh-model-resolve")], timeout=120)
    out = {}
    if r.returncode != 0:
        return out
    for ln in r.stdout.splitlines():
        p = ln.split("\t")
        if len(p) >= 3:
            out[(p[0], p[1])] = p[2]
    return out


def main(argv):
    dry = "--dry-run" in argv
    try:
        bench_mod = _load("mesh-model-bench")
        gap_mod = _load("mesh-model-gap")
    except FileNotFoundError as e:
        print(f"n/a: {e} — the loop's RULER/REPORTER are not on this node", file=sys.stderr)
        return 2
    org = organs(bench_mod)
    # only tend organs whose pin surface exists here (a node without the room units has
    # nothing to switch — honest n/a, never a fake pass over phantom units)
    org = [o for o in org if o["pin_kind"] != "arithmetic" or o["pin"].exists()]
    if not any(o["pin_kind"] == "arithmetic" for o in org):
        print("n/a: no arithmetic pin surface (room units) on this node", file=sys.stderr)
        return 2

    def bench_fn(modality, model, fixture):
        if modality == "__reread__":
            return gap_mod.read_ledger()
        p = _sh([str(BIN / "mesh-model-bench"), modality, model, "--fixture", fixture],
                timeout=1800)
        if p.returncode == 0:
            return True, (p.stdout.splitlines() or ["row written"])[0]
        return False, f"rc={p.returncode}: {(p.stderr.strip().splitlines() or ['?'])[-1][:120]}"

    def chat_fn(msg):
        _sh([str(BIN / "mesh-chat"), msg], timeout=30)

    results = tend(org, gap_mod.read_ledger(), incumbents_from_resolve(), read_state(),
                   gap_mod.dominates, gap_mod.cost_for, bench_fn=bench_fn,
                   chat_fn=None if dry else chat_fn, dry_run=dry)
    bad = [k for k, v in results if v == "SWITCH-FAILED"]
    return 1 if bad else 0


# ------------------------------------------------------------------------------------ test

def run_test():
    """Drives every guard the design promised, on injected rows/pins — no systemd, no models,
    no ledger writes. The REAL apply surface (drop-in content) is pinned as an artifact."""
    f = 0

    # local dominance (mirrors mesh-model-gap's relation) so the pure gates run even where
    # gap is not deployed; the integration gate below asserts the deployed one is used live.
    def dom(a, b, axis="wall"):
        better = a["wer"] < b["wer"] or a[axis] < b[axis]
        worse_none = a["wer"] <= b["wer"] and a[axis] <= b[axis]
        return better and worse_none

    def cfor(row, resident):
        if resident and row.get("warm") is not None:
            return row["warm"]
        return row["wall"]

    reg = {"inc:3b": ("ollama", "inc:3b"), "chal:2b": ("ollama", "chal:2b"),
           "deaf:1b": ("ollama", "deaf:1b"), "think:4b": ("ollama", "think:4b")}
    organ = {"key": "wake/test", "modality": "wake", "fixture": "fx", "resolve": ("text", "t"),
             "registry": reg, "eligible": lambda k, r: True, "ref_of": lambda n: n,
             "pin_kind": "arithmetic", "margin": 0.10, "pin": None, "verify": None}

    def row(model, wer, wall, status="read-ok", warm=None):
        r = {"ts": "2026-07-16T12:00:00Z", "organ": "wake", "consumer": "-", "model": model,
             "fixture": "fx", "wall": wall, "dur": 28.0, "wer": wer, "status": status}
        if warm is not None:
            r["warm"] = warm
        return r

    # THE KNOWN-WORSE GATE: a faster-but-less-accurate challenger must never be selected.
    v, c, why = decide(organ, [row("inc:3b", 0.10, 1.0), row("chal:2b", 0.50, 0.2)], "inc:3b", dom, cfor)
    if v != "OK":
        print(f"  FAIL: a known-WORSE (faster) model got verdict {v} — speed alone selected "
              f"the fastest wrong answer"); f = 1

    # THE TRADEOFF GATE: more accurate but slower = HOLD, never SWITCH (a preference is a human's).
    v, c, why = decide(organ, [row("inc:3b", 0.30, 0.3), row("chal:2b", 0.05, 5.0)], "inc:3b", dom, cfor)
    if v != "HOLD":
        print(f"  FAIL: a TRADEOFF (accurate-but-slower) got verdict {v}, want HOLD"); f = 1

    # THE MARGIN GATE: dominant but sub-margin = HOLD (a substrate touch needs a real win).
    v, c, why = decide(organ, [row("inc:3b", 0.30, 1.0), row("chal:2b", 0.25, 0.5)], "inc:3b", dom, cfor)
    if v != "HOLD":
        print(f"  FAIL: a sub-margin dominator got verdict {v}, want HOLD"); f = 1

    # dominant AND margin-clearing = SWITCH
    v, c, why = decide(organ, [row("inc:3b", 0.30, 1.0), row("chal:2b", 0.10, 0.5)], "inc:3b", dom, cfor)
    if v != "SWITCH" or c["model"] != "chal:2b":
        print(f"  FAIL: a dominant margin-clearing challenger got verdict {v}"); f = 1

    # THE DISQUALIFICATION GATE: DEAF with wer=0 would top any ranking — status must bar it.
    # Same for UNPARSED (the qwen3.5 parsing-not-competence trap) and EMPTY.
    rows_dq = [row("inc:3b", 0.30, 1.0), row("deaf:1b", 0.0, 0.1, status="DEAF"),
               row("think:4b", 0.0, 0.1, status="UNPARSED"), row("chal:2b", 0.0, 0.1, status="EMPTY")]
    v, c, why = decide(organ, eligible_rows(rows_dq, organ), "inc:3b", dom, cfor)
    if v != "OK":
        print(f"  FAIL: a disqualified row (DEAF/UNPARSED/EMPTY) reached the podium — verdict "
              f"{v} via {c and c['model']}"); f = 1

    # THE RE-BENCH GATE (live find, first dry-run 2026-07-16): a DISQUALIFYING verdict is a
    # MEASUREMENT. A model with an UNPARSED/DEAF row must not read as 'missing' — that
    # re-benches the same broken candidate every run forever, a cost leak wearing
    # thoroughness's clothes.
    bench_calls = []

    def fake_bench(modality, m, fixture):
        if modality == "__reread__":
            return rows_rb
        bench_calls.append(m)
        return False, "stub"

    # max_bench raised past the registry size: at the default cap the queue never reaches the
    # UNPARSED candidate and the cap MASKS the bug (this mutant escaped exactly that way).
    rows_rb = [row("inc:3b", 0.30, 1.0), row("think:4b", 1.0, 3.5, status="UNPARSED")]
    tend([organ], rows_rb, {("text", "t"): "inc:3b"}, {}, dom, cfor, log=lambda s: None,
         now=1000.0, bench_fn=fake_bench, max_bench=10)
    if "think:4b" in bench_calls:
        print("  FAIL: an UNPARSED-benched model was re-benched — a disqualifying verdict "
              "read as absence"); f = 1
    if "chal:2b" not in bench_calls or "deaf:1b" not in bench_calls:
        print(f"  FAIL: genuinely unbenched models were not benched: {bench_calls}"); f = 1

    # THE TASTE-BEFORE-MAPPING GATE (live find, same dry-run): resolve reports note3-say as a
    # FILE name no registry key matches; the taste verdict must not demote to SKIP over it.
    res = tend([dict(organ, key="tts/test", pin_kind="taste", pin_desc="the ear")],
               [], {("text", "t"): "ru_RU-irina-medium.onnx"}, {}, dom, cfor,
               log=lambda s: None, now=1000.0)
    if res != [("tts/test", "TASTE")]:
        print(f"  FAIL: a taste organ with an unmappable incumbent produced {res}, want TASTE"); f = 1

    # ...and an arithmetic incumbent reported by REF (v2_ctc) or basename must map to its
    # registry name, not SKIP (the model_of_file granularity lesson).
    reg_ref = {"giga-name": ("gigaam", "v2_ctc")}
    organ_ref = dict(organ, registry=reg_ref, ref_of=lambda n: reg_ref[n][1])
    res = tend([organ_ref], [row("giga-name", 0.3, 1.0)], {("text", "t"): "v2_ctc"}, {}, dom,
               cfor, log=lambda s: None, now=1000.0)
    if res != [("wake/test", "OK")]:
        print(f"  FAIL: a ref-shaped incumbent did not map to its registry name: {res}"); f = 1

    # THE WARM-COLUMN GATE: wake ranking must pay the warm wall when present — a challenger
    # whose COLD wall is worse but warm wall dominates is the resident-consumer case.
    rows_w = [row("inc:3b", 0.30, 1.0, warm=1.0), row("chal:2b", 0.10, 9.0, warm=0.5)]
    v, c, why = decide(dict(organ, resident=True), rows_w, "inc:3b", dom, cfor)
    if v != "SWITCH":
        print(f"  FAIL: warm-dominant challenger read by its COLD wall — verdict {v} "
              f"(a RESIDENT consumer was scored on the load-dominated column)"); f = 1
    # ...and the mirror: a NON-resident organ must NOT be flattered by the warm column
    # (the 2026-07-15 timer bug reincarnated as a ranking choice)
    v, c, why = decide(dict(organ, resident=False), rows_w, "inc:3b", dom, cfor)
    if v == "SWITCH":
        print("  FAIL: a SPAWNING consumer was scored on wall_warm — a fixed cost dropped "
              "as if free"); f = 1

    # THE TASTE GATE: numbers may scream, the ear owns the pin. Engine must not even look
    # at cooldowns/pins for a taste organ.
    calls = []

    class FakePin:
        def __init__(self):
            self.unit, self.var, self.dropin = "fake.service", "VAR", Path("/tmp/nonexistent")
        def current_dropin(self):
            return None
        def apply(self, ref):
            calls.append(("apply", ref)); return True
        def rollback(self, prev):
            calls.append(("rollback", prev)); return True

    # the taste organ gets a REAL (fake) pin + a passing verify: if the guard is deleted,
    # nothing else stands between a dominating metric and the ear's pin — the mutant must
    # die on THIS assertion, not on an accidental None crash downstream (a mutant red for
    # the wrong reason gates nothing).
    taste = dict(organ, key="tts/test", pin_kind="taste", pin_desc="the ear")
    res = tend([taste], [row("inc:3b", 0.9, 9.0), row("chal:2b", 0.0, 0.1)],
               {("text", "t"): "inc:3b"}, {}, dom, cfor, log=lambda s: None, now=1000.0,
               apply_override={"tts/test": (FakePin(), lambda ref: (True, "ok"))},
               state_write=lambda *a, **k: None)
    if res != [("tts/test", "TASTE")] or calls:
        print(f"  FAIL: taste organ produced {res} with apply calls {calls} — a metric "
              f"overruled the ear"); f = 1

    # THE COOLDOWN GATE: a switch inside the cooldown window must HOLD, apply untouched.
    good_rows = [row("inc:3b", 0.30, 1.0), row("chal:2b", 0.10, 0.5)]
    pin = FakePin()
    ov = {"wake/test": (pin, lambda ref: (True, "ok"))}
    st = {"wake/test": {"ts": 900.0, "from": "x", "to": "inc:3b"}}
    res = tend([organ], good_rows, {("text", "t"): "inc:3b"}, st, dom, cfor, log=lambda s: None,
               now=1000.0, apply_override=ov, cooldown=3600)
    if res != [("wake/test", "HOLD")] or calls:
        print(f"  FAIL: in-cooldown switch produced {res}, calls {calls}"); f = 1

    # THE ONE-SWITCH GATE: two switchable organs, one run -> second is DEFERRED and says so.
    organ2 = dict(organ, key="wake/test2", resolve=("text", "t2"))
    ov = {"wake/test": (FakePin(), lambda ref: (True, "ok")),
          "wake/test2": (FakePin(), lambda ref: (True, "ok"))}
    logged = []
    written = []
    res = tend([organ, organ2], good_rows, {("text", "t"): "inc:3b", ("text", "t2"): "inc:3b"},
               {}, dom, cfor, log=logged.append, now=1000.0, apply_override=ov,
               state_write=lambda *a, **k: written.append(a))
    got = dict(res)
    if got.get("wake/test") != "SWITCHED" or got.get("wake/test2") != "DEFERRED":
        print(f"  FAIL: one-switch cap not enforced: {res}"); f = 1
    if written != [("wake/test", "inc:3b", "chal:2b")]:
        print(f"  FAIL: the successful switch recorded state {written}, want exactly one "
              f"(wake/test, inc:3b, chal:2b)"); f = 1
    if not any("DEFERRED" in ln for ln in logged):
        print("  FAIL: the deferred switch was not LOGGED — a silent cap reads as "
              "covered-everything"); f = 1

    # THE ROLLBACK GATE: apply lands, post-verify FAILS -> rollback with the exact previous
    # content, no state written, verdict SWITCH-FAILED. The room is never left half-switched.
    calls.clear()

    class SnapshotPin(FakePin):
        def current_dropin(self):
            return "PREVIOUS-PIN"

    pin = SnapshotPin()
    st = {}
    written = []
    res = tend([organ], good_rows, {("text", "t"): "inc:3b"}, st, dom, cfor, log=lambda s: None,
               now=1000.0, apply_override={"wake/test": (pin, lambda ref: (False, "gate went deaf"))},
               state_write=lambda *a, **k: written.append(a))
    if res != [("wake/test", "SWITCH-FAILED")]:
        print(f"  FAIL: failed post-verify produced {res}"); f = 1
    if ("rollback", "PREVIOUS-PIN") not in calls:
        print(f"  FAIL: rollback did not restore the exact previous pin — calls: {calls}"); f = 1
    if st or written:
        print(f"  FAIL: a FAILED switch wrote state {st}/{written} — the cooldown would now "
              f"shield a switch that never happened"); f = 1

    # ...and a verify that raises must also roll back (never leave the room deaf on a crash)
    calls.clear()

    def boom(ref):
        raise RuntimeError("verify crashed")
    res = tend([organ], good_rows, {("text", "t"): "inc:3b"}, {}, dom, cfor, log=lambda s: None,
               now=1000.0, apply_override={"wake/test": (SnapshotPin(), boom)},
               state_write=lambda *a, **k: written.append(a))
    if res != [("wake/test", "SWITCH-FAILED")] or ("rollback", "PREVIOUS-PIN") not in calls:
        print(f"  FAIL: a RAISING verify did not roll back: {res}, calls {calls}"); f = 1

    # THE DRY-RUN GATE: --dry-run must decide but never touch a pin or the state.
    calls.clear()
    res = tend([organ], good_rows, {("text", "t"): "inc:3b"}, {}, dom, cfor, log=lambda s: None,
               now=1000.0, apply_override={"wake/test": (FakePin(), lambda ref: (True, "ok"))},
               dry_run=True, state_write=lambda *a, **k: written.append(a))
    if res != [("wake/test", "WOULD-SWITCH")] or calls or written:
        print(f"  FAIL: dry-run actuated: {res}, calls {calls}, state {written}"); f = 1

    # THE ARTIFACT PIN: the drop-in a switch writes, byte-exact. systemd's last-assignment-
    # wins is what makes this override the unit's inline Environment=; the [Service] header
    # is load-bearing (a bare Environment= line outside a section is ignored SILENTLY).
    want = ("# written by mesh-model-autoselect — the model pin this organ runs\n"
            "[Service]\nEnvironment=GIGAAM_MODEL=v2_ctc\n")
    if dropin_content("GIGAAM_MODEL", "v2_ctc") != want:
        print("  FAIL: drop-in content drifted from the pinned artifact"); f = 1

    # INTEGRATION: the deployed RULER/REPORTER load, carry the definitions we import, and
    # gap's dominance agrees with the local mirror on the retracted-headline numbers.
    try:
        bench_mod = _load("mesh-model-bench")
        gap_mod = _load("mesh-model-gap")
    except FileNotFoundError as e:
        print(f"  n/a: {e} — integration gates skipped (pure gates above still bind)")
        print("smoke-test: ok" if f == 0 else "smoke-test: FAIL")
        return 2 if f == 0 else 1
    for attr, mod in [("WAKE_CANDIDATES", bench_mod), ("STT_CANDIDATES", bench_mod),
                      ("TTS_CANDIDATES", bench_mod), ("read_ledger", gap_mod),
                      ("dominates", gap_mod), ("model_of_file", gap_mod)]:
        if not hasattr(mod, attr):
            print(f"  FAIL: deployed module lacks {attr} — the single-definition import broke"); f = 1
    giga = {"wer": 0.312, "wall": 4.63}
    base = {"wer": 0.812, "wall": 1.06}
    if gap_mod.dominates(giga, base) or not gap_mod.dominates({"wer": 0.312, "wall": 0.61}, base):
        print("  FAIL: deployed dominates() disagrees with the retracted-headline numbers"); f = 1
    for o in organs(bench_mod):
        if o["pin_kind"] == "arithmetic" and not callable(o.get("verify")):
            print(f"  FAIL: arithmetic organ {o['key']} has no post-verify — a switch would "
                  f"land unproven"); f = 1

    print("smoke-test: ok" if f == 0 else "smoke-test: FAIL")
    return f


if __name__ == "__main__":
    if sys.argv[1:2] == ["--test"]:
        sys.exit(run_test())
    sys.exit(main(sys.argv[1:]))
