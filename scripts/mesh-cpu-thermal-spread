#!/usr/bin/env bash
# orphan-ok: on-demand thermal relation query; uncommitted working-tree senses cannot be cron-wired
#   by mesh-autowire until their genome is at HEAD, so this installed symlink is pulled live by the
#   senses mind and does not claim a scheduled reflex.
# mesh-cpu-thermal-spread — relation between AMD package-control and CCD temperatures.
#
# A single temperature says how hot one sensor is.  This relation says whether the package
# control loop (Tctl) and the hottest CCD (Tccd1) agree.  A widening spread is a distinct
# thermal pattern: package/control heat is diverging from die heat, which neither axis can
# identify alone.
#
# SOURCE: k10temp hwmon labels Tctl and Tccd1, both read live from temp*_input.  Both are required;
# missing or malformed input is UNKNOWN (exit 2), never a zero/default reading.
#
# mesh-cpu-thermal-spread          one live reading
# mesh-cpu-thermal-spread --json   machine-readable reading
# mesh-cpu-thermal-spread --edge   emit only when the band changes
# mesh-cpu-thermal-spread --test   fixture classifier + real-read gate
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"

MESH="${MESH_DIR:-$HOME/.mesh}"
ROOT="${MESH_CPU_SPREAD_ROOT:-/sys/class/hwmon}"
STATE="${MESH_CPU_SPREAD_STATE:-$MESH/.cpu-thermal-spread.state}"
mkdir -p "$MESH" 2>/dev/null || true

read_label() {
  local h="$1" want="$2" lab f v
  for lab in "$h"/temp*_label; do
    [ -r "$lab" ] || continue
    [ "$(tr -d '\n\r' < "$lab" 2>/dev/null)" = "$want" ] || continue
    f="${lab%_label}_input"
    [ -r "$f" ] || continue
    v="$(tr -d '\n\r' < "$f" 2>/dev/null)"
    case "$v" in ''|*[!0-9]*) continue ;; esac
    printf '%s\t%s\n' "$v" "$f"
    return 0
  done
  return 1
}

read_pair() {
  local h name tctl tccd
  for h in "$ROOT"/hwmon*; do
    [ -d "$h" ] || continue
    name="$(tr -d '\n\r' < "$h/name" 2>/dev/null || true)"
    [ "$name" = k10temp ] || continue
    tctl="$(read_label "$h" Tctl 2>/dev/null || true)"
    tccd="$(read_label "$h" Tccd1 2>/dev/null || true)"
    [ -n "$tctl" ] && [ -n "$tccd" ] || continue
    printf '%s\n%s\n' "$tctl" "$tccd"
    return 0
  done
  return 1
}

classify() {
  local delta="${1:-}"
  case "$delta" in ''|*[!0-9-]*) printf 'UNKNOWN'; return 2 ;; esac
  [ "$delta" -lt 0 ] && delta=$(( -delta ))
  [ "$delta" -ge 5000 ] && printf 'DIVERGENT' || printf 'COUPLED'
}

if [ "${1:-}" = --test ]; then
  fail=0
  [ "$(classify 0)" = COUPLED ] || { echo 'smoke-test: FAIL (zero spread)'; fail=1; }
  [ "$(classify 4999)" = COUPLED ] || { echo 'smoke-test: FAIL (coupled boundary)'; fail=1; }
  [ "$(classify 5000)" = DIVERGENT ] || { echo 'smoke-test: FAIL (divergent boundary)'; fail=1; }
  td="$(mktemp -d)" || { echo 'smoke-test: FAIL (mktemp)'; exit 1; }
  trap 'rm -rf "$td"' EXIT
  mkdir -p "$td/hwmon0"
  printf 'k10temp\n' > "$td/hwmon0/name"
  printf 'Tctl\n' > "$td/hwmon0/temp1_label"
  printf '68125\n' > "$td/hwmon0/temp1_input"
  printf 'Tccd1\n' > "$td/hwmon0/temp3_label"
  printf '65750\n' > "$td/hwmon0/temp3_input"
  live="$(MESH_CPU_SPREAD_ROOT="$td" MESH_CPU_SPREAD_STATE="$td/state" "$0" --json 2>/dev/null)" || {
    echo "smoke-test: FAIL (fixture read: $live)"; exit 1;
  }
  printf '%s\n' "$live" | grep -q '"verdict":"COUPLED"' || {
    echo "smoke-test: FAIL (fixture verdict: $live)"; exit 1;
  }
  rm -rf "$td"; trap - EXIT
  MESH_CPU_SPREAD_ROOT=/definitely-missing "$0" >/dev/null 2>&1
  [ "$?" -eq 2 ] || { echo 'smoke-test: FAIL (missing pair must exit 2)'; exit 1; }
  real_rc=0
  real="$(MESH_CPU_SPREAD_STATE="${TMPDIR:-/tmp}/cpu-spread-test.$$" "$0" --json 2>/dev/null)" || real_rc=$?
  if [ "$real_rc" -eq 2 ]; then
    echo 'smoke-test: n/a (k10temp Tctl+Tccd1 pair unreachable)'
    exit 2
  fi
  [ "$real_rc" -eq 0 ] && printf '%s\n' "$real" | grep -q '"tctl_mC"' || {
    echo "smoke-test: FAIL (real pair malformed rc=$real_rc: $real)"; exit 1;
  }
  echo 'smoke-test: ok (fixture relation + real k10temp pair read)'
  exit "$fail"
fi

pair="$(read_pair 2>/dev/null || true)"
[ -n "$pair" ] || { echo 'cpu-thermal-spread: UNKNOWN — k10temp Tctl/Tccd1 pair unreachable' >&2; exit 2; }
# Select each pair record explicitly so both live channels are retained.
ctl_line="$(printf '%s\n' "$pair" | sed -n '1p')"
ccd_line="$(printf '%s\n' "$pair" | sed -n '2p')"
tctl="${ctl_line%%$'\t'*}"; tctl_src="${ctl_line#*$'\t'}"
tccd="${ccd_line%%$'\t'*}"; tccd_src="${ccd_line#*$'\t'}"
delta=$((tctl - tccd))
abs=$delta; [ "$abs" -lt 0 ] && abs=$(( -abs ))
verdict="$(classify "$delta")"
ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

if [ "${1:-}" = --edge ]; then
  previous="$(cat "$STATE" 2>/dev/null || true)"
  printf '%s\n' "$verdict" > "$STATE"
  # The value may remain stable while the reflex is live; mtime records the successful run.
  command -v mesh-state-touch >/dev/null 2>&1 && mesh-state-touch "$STATE" >/dev/null 2>&1 || true
  if [ "$previous" = "$verdict" ]; then exit 0; fi
fi

if [ "${1:-}" = --json ] || [ "${1:-}" = --edge-json ]; then
  printf '{"verdict":"%s","tctl_mC":%s,"tccd1_mC":%s,"spread_mC":%s,"tctl_source":"%s","tccd1_source":"%s","ts":"%s"}\n' \
    "$verdict" "$tctl" "$tccd" "$delta" "$tctl_src" "$tccd_src" "$ts"
else
  printf '[cpu-thermal-spread] %s — Tctl=%.1fC Tccd1=%.1fC spread=%+.1fC\n' \
    "$verdict" "$(awk -v v="$tctl" 'BEGIN{print v/1000}')" "$(awk -v v="$tccd" 'BEGIN{print v/1000}')" "$(awk -v v="$delta" 'BEGIN{print v/1000}')"
fi
