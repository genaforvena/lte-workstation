#!/usr/bin/env bash
# mesh-trace — the shared trace surface. A place, not a protocol.
# smoke-test: --test checks traces.log exists + writable
#
# Any mind leaves a mark; any mind reads marks. There is NO schema: a mark is a
# free-form line, stamped only with when/where/who so its origin is legible.
# What a mark MEANS is deliberately undefined — coordination, if any, emerges
# from minds reading and reacting to each other's traces (stigmergy), not from
# anything encoded here.
#
#   mesh-trace <anything you want to say>   leave a mark
#   mesh-trace                              read recent marks (last 20)
#   mesh-trace --tail [N]                   read last N marks
#   mesh-trace --watch                      follow marks live
#   mesh-trace --test                       smoke test (exit 0 if traces.log writable)
#
# The log is local to each node (~/.mesh/traces.log). It does not auto-sync;
# crossing nodes is itself emergent — use `mesh-minds` to find peers and read
# theirs over ssh if you care to. The skeleton provides the surface, not the plumbing.
set -euo pipefail
MESH_DIR="${MESH_DIR:-$HOME/.mesh}"
LOG="$MESH_DIR/traces.log"
SESSION="${MESH_SESSION:-mesh}"
WHO="${MESH_WHO:-${USER:-?}@$(hostname)}"

# SELF-DERIVE (LITERATURE 2026-07-02, Luhmannian "re-entry" — Rocha et al., "From intelligence to
# autopoiesis: rethinking artificial intelligence through systems theory", Frontiers in Communication
# 10.3389/fcomm.2025.1585321, 2025: a system is autopoietic only insofar as it REINTEGRATES the
# system/environment distinction into its OWN operations, not merely declares a boundary). mesh-chat
# ported exactly this fix for itself 2026-07-01 (chat-review/chat-self-derive-who — MESH_WHO is
# inherited env that goes stale across any spawn path the audit log doesn't cover; pub.1 proof:
# MESH_WHO=genome baked into a pane that itself calls 'pub' misboarded real posts as genome@). mesh-trace
# had the IDENTICAL bare `WHO="${MESH_WHO:-...}"` exposure, unfixed — and a misattributed TRACE mark is
# higher-stakes than a misattributed CHAT line: mesh-trace is the substrate single-writer coordination
# surface (CLAUDE.md "Substrate changes & multi-agent coordination" — claim ownership before a routing/
# iptables/DNS change); another agent's `mesh-trace --tail 20` detect-other-operators check trusts WHO
# at face value. Porting the identical, already-proven guard (same scope: mind-channel set only, so
# reflex/cron tools that deliberately self-identify under a non-mind role via a per-call
# MESH_WHO="land@$(hostname)" prefix are untouched).
_MIND_CHANNELS=" minds genome tg senses health chat "
if [ "${MESH_TRACE_SELFDERIVE:-1}" != "0" ] && [ -n "${TMUX:-}${MESH_TRACE_TEST_WINDOW:-}" ]; then
  who_chan="${WHO%%@*}"
  case "$_MIND_CHANNELS" in
    *" $who_chan "*)
      real_win="${MESH_TRACE_TEST_WINDOW:-$(tmux display-message -p -t "$TMUX_PANE" '#W' 2>/dev/null)}"
      if [ -n "$real_win" ] && [ "$real_win" != "$who_chan" ]; then
        who_host="${WHO#*@}"; [ "$who_host" = "$WHO" ] && who_host="$(hostname)"
        echo "NOTE: MESH_WHO mismatch ('$WHO' vs this pane's window '$real_win') — self-derived to $real_win@$who_host" >&2
        WHO="$real_win@$who_host"
      fi
      ;;
  esac
fi
mkdir -p "$MESH_DIR"; touch "$LOG"

append_log(){
  local line="$1"
  if command -v mesh-log-scrub &>/dev/null; then
    if ! printf '%s\n' "$line" | mesh-log-scrub >> "$LOG"; then
      echo "WARN: mesh-log-scrub failed — traces.log raw" >&2
      printf '%s\n' "$line" >> "$LOG"
    fi
  else
    echo "WARN: mesh-log-scrub not found — traces.log raw" >&2
    printf '%s\n' "$line" >> "$LOG"
  fi
}

case "${1:-}" in
  --test)
    # dep check
    [ -f "$LOG" ] && [ -w "$LOG" ] || { echo "smoke-test: FAIL (traces.log not writable)"; exit 1; }
    # Synthetic dry-run: exercise append_log + readback + tail
    _td="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
    trap 'rm -rf "$_td"' EXIT
    _home="$_td/home"; mkdir -p "$_home/.mesh"; _log="$_home/.mesh/traces.log"; touch "$_log"
    _line="test-line-123"
    # Simulate what append_log does (without depending on mesh-log-scrub availability)
    if command -v mesh-log-scrub 2>/dev/null; then
      printf '%s\n' "$_line" | mesh-log-scrub >> "$_log" 2>/dev/null || printf '%s\n' "$_line" >> "$_log"
    else
      printf '%s\n' "$_line" >> "$_log"
    fi
    # Read back — the appended line must be in the log
    grep -q 'test-line-123' "$_log" || { echo "  FAIL: append+readback (test-line not found)"; exit 1; }
    # Write a 2nd line and verify --tail sees it
    printf '%s\n' "second-line-456" >> "$_log"
    _tail="$(HOME="$_home" bash "$0" --tail 2 2>/dev/null)" || { echo "  FAIL: --tail failed"; exit 1; }
    printf '%s\n' "$_tail" | grep -q 'test-line-123' || { echo "  FAIL: --tail missing first line"; exit 1; }
    printf '%s\n' "$_tail" | grep -q 'second-line-456' || { echo "  FAIL: --tail missing second line"; exit 1; }
    # SELF-DERIVE regression (re-entry): a mind-channel WHO whose pane window disagrees gets corrected.
    _sd_out="$(HOME="$_home" MESH_WHO="genome@drift-host" MESH_TRACE_TEST_WINDOW="pub" bash "$0" "self-derive check" 2>&1)"
    printf '%s\n' "$_sd_out" | grep -q "self-derived to pub@" || { echo "  FAIL: self-derive did not correct a mismatched mind-channel WHO"; exit 1; }
    printf '%s\n' "$_sd_out" | grep -q '  pub@.*  ::  self-derive check$' || { echo "  FAIL: corrected WHO not used in the logged mark"; exit 1; }
    # Non-mind role (e.g. land@) is a deliberate identity override — must NOT be touched.
    _nm_out="$(HOME="$_home" MESH_WHO="land@drift-host" MESH_TRACE_TEST_WINDOW="pub" bash "$0" "non-mind check" 2>&1)"
    printf '%s\n' "$_nm_out" | grep -q 'self-derived' && { echo "  FAIL: non-mind role WHO was wrongly self-derived"; exit 1; }
    echo "smoke-test: ok (append+readback + --tail readback + self-derive re-entry verified)"; exit 0
    ;;
  "")        tail -n 20 "$LOG" ;;
  --tail)    tail -n "${2:-20}" "$LOG" ;;
  --watch)   tail -n 20 -F "$LOG" ;;
  --commons) # open/ensure the live shared surface: a tmux session tailing the log
    tmux has-session -t "$SESSION" 2>/dev/null || tmux new-session -d -s "$SESSION" "exec $0 --watch"
    echo "commons '$SESSION' live — attach with: tmux attach -t $SESSION (or over ssh from any node)"
    ;;
  *)
    ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    line="$ts  $WHO  ::  $*"
    append_log "$line"   # the --watch commons (if running) shows it live
    printf '%s\n' "$line"
    ;;
esac
