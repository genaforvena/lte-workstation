#!/usr/bin/env bash
# reflex-cadence: 23 * * * *
# reflex-args: --edge
# mesh-rtc-drift — the node's OWN hardware RTC chip drift sense.
#
# WHY THIS IS NEW: mesh-clock-sync answers "is the SYSTEM clock disciplined to NTP" (offset from
# an external time server). That is a software/network signal. It never reads the physical RTC
# chip itself — a battery/crystal-backed device on the motherboard that keeps ticking through
# power-off and only gets corrected when the kernel writes system time back to it (11-min mode,
# or at shutdown). A CMOS/coin-cell battery dying or a cheap crystal aging shows up as the RTC
# drifting from truth *specifically across power-off intervals* — a real hardware-degradation
# signal distinct from "is NTP running right now". Nothing in the tree reads /sys/class/rtc.
#
# Reads /sys/class/rtc/rtc0/since_epoch (kernel-converted hardware register, no `hwclock` binary
# needed) and diffs it against the system clock (`date +%s`) at the moment of read. A large gap
# means the RTC chip itself has drifted (or was never set) — worth flagging before it causes a
# confusing cold-boot timestamp (logs/leases dated wrong before NTP catches up).
#
# Honest contract: no readable /sys/class/rtc/rtc0/since_epoch -> exit 2, never a fabricated drift.
#
#   mesh-rtc-drift          one-line drift read
#   mesh-rtc-drift --json   machine-readable JSON
#   mesh-rtc-drift --edge   emit only on band change
#   mesh-rtc-drift --test   smoke test (fixtures + live reachability gate)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

MESH="${MESH_DIR:-$HOME/.mesh}"
# MESH_TEST_SANDBOX=1 diverts the state write — pre-fix, --test's fixture invokes stamped the LIVE
# .rtc-drift.state with synthetic drift verdicts (task test-live-writes 2026-07-20).
STATE="$MESH/.rtc-drift.state"
[ "${MESH_TEST_SANDBOX:-0}" != 1 ] || STATE="${TMPDIR:-/tmp}/.rtc-drift.state.sandbox.$$"
OFFLINEFILE="$MESH/.rtc-drift-offline"
RTC="${MESH_RTC_SINCE_EPOCH:-/sys/class/rtc/rtc0/since_epoch}"
mkdir -p "$MESH" 2>/dev/null || true

classify_drift() {
  # $1 = |drift| seconds -> band. Small skew is normal read-jitter (RTC ticks in whole seconds);
  # minutes means the RTC lost sync; hours+ means it was never set or the CMOS battery is dead.
  local d="${1:-}"
  case "$d" in ''|*[!0-9]*) echo UNKNOWN; return ;; esac
  if   [ "$d" -le 2 ];    then echo SYNCED
  elif [ "$d" -le 300 ];  then echo SKEWED
  else                         echo DRIFTED
  fi
}

if [ "${1:-}" = --test ]; then
  # TEST-SANDBOX (task test-live-writes 2026-07-20): self-invokes divert; %y sig gate before exits.
  export MESH_TEST_SANDBOX=1
  _rd_live="$HOME/.mesh/.rtc-drift.state"
  _rd_sig="$(stat -c '%y %s' "$_rd_live" 2>/dev/null || echo absent)"
  [ "$(classify_drift 0)" = SYNCED ]     || { echo "  FAIL SYNCED boundary"; exit 1; }
  [ "$(classify_drift 2)" = SYNCED ]     || { echo "  FAIL SYNCED upper boundary"; exit 1; }
  [ "$(classify_drift 3)" = SKEWED ]     || { echo "  FAIL SKEWED lower boundary"; exit 1; }
  [ "$(classify_drift 300)" = SKEWED ]   || { echo "  FAIL SKEWED upper boundary"; exit 1; }
  [ "$(classify_drift 301)" = DRIFTED ]  || { echo "  FAIL DRIFTED boundary"; exit 1; }
  [ "$(classify_drift abc)" = UNKNOWN ]  || { echo "  FAIL UNKNOWN on non-numeric"; exit 1; }

  td="$(mktemp -d)"
  trap 'rm -rf "$td"' EXIT
  now="$(date +%s)"
  printf '%s\n' "$now" > "$td/since_epoch"
  got="$(MESH_RTC_SINCE_EPOCH="$td/since_epoch" bash "$0" 2>/dev/null || true)"
  printf '%s\n' "$got" | grep -q '\[rtc-drift\]' || { echo "  FAIL live fixture output: $got"; exit 1; }
  printf '%s\n' "$got" | grep -q 'SYNCED' || { echo "  FAIL live fixture band (expected SYNCED, now==now): $got"; exit 1; }

  printf '%s\n' "$((now - 9000))" > "$td/since_epoch"
  got2="$(MESH_RTC_SINCE_EPOCH="$td/since_epoch" bash "$0" 2>/dev/null || true)"
  printf '%s\n' "$got2" | grep -q 'DRIFTED' || { echo "  FAIL live fixture band (expected DRIFTED, -9000s): $got2"; exit 1; }

  # sandbox honesty gate — before BOTH exits. Falsify: drop the diversion at the STATE assignment.
  _rd_sig2="$(stat -c '%y %s' "$_rd_live" 2>/dev/null || echo absent)"
  [ "$_rd_sig2" = "$_rd_sig" ] || { echo "smoke-test: FAIL (--test stamped the LIVE state $_rd_live: '$_rd_sig' → '$_rd_sig2')"; exit 1; }
  [ -r "$RTC" ] || { echo "smoke-test: n/a (no readable /sys/class/rtc/rtc0/since_epoch on this node); classify-logic ok"; exit 2; }
  since="$(cat "$RTC" 2>/dev/null || true)"
  case "$since" in ''|*[!0-9]*) echo "smoke-test: FAIL (live RTC read not numeric: '$since')"; exit 1 ;; esac
  echo "smoke-test: ok (classify + fixture read + live RTC source exists)"
  exit 0
fi

JSON=0; EDGE=0
for a in "$@"; do
  case "$a" in
    --json) JSON=1 ;;
    --edge) EDGE=1 ;;
  esac
done

[ -r "$RTC" ] || {
  [ -f "$OFFLINEFILE" ] || { echo "rtc-drift: UNREACHABLE — no readable $RTC" >&2; : > "$OFFLINEFILE"; }
  exit 2
}

since="$(cat "$RTC" 2>/dev/null || true)"
case "$since" in
  ''|*[!0-9]*)
    [ -f "$OFFLINEFILE" ] || { echo "rtc-drift: UNREACHABLE — RTC since_epoch unreadable ('$since')" >&2; : > "$OFFLINEFILE"; }
    exit 2
    ;;
esac
rm -f "$OFFLINEFILE" 2>/dev/null || true

now="$(date +%s)"
drift=$(( now - since ))
absdrift=${drift#-}
band="$(classify_drift "$absdrift")"
host="$(hostname)"
ts="$(date -u +%FT%TZ)"

printf '%s|drift=%s|rtc=%s|sys=%s|source=%s|%s\n' "$band" "$drift" "$since" "$now" "$RTC" "$ts" > "$STATE"

if [ "$JSON" = 1 ]; then
  printf '{"band":"%s","drift_s":%s,"rtc_epoch":%s,"sys_epoch":%s,"source":"%s","ts":"%s"}\n' \
    "$band" "$drift" "$since" "$now" "$RTC" "$ts"
  exit 0
fi

if [ "$EDGE" = 1 ]; then
  prev="$(cat "$STATE.prev" 2>/dev/null || true)"
  printf '%s\n' "$band" > "$STATE.prev"
  [ "$band" = "$prev" ] && exit 0
fi

printf '[rtc-drift] %s — hardware RTC vs system clock drift=%ss (rtc=%s sys=%s source=%s) @ %s %s\n' \
  "$band" "$drift" "$since" "$now" "$RTC" "$host" "$ts"
