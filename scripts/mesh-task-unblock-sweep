#!/usr/bin/env bash
# mesh-task-unblock-sweep — keep every blocked task actionable.
# A blocked task is not work for its original owner until its exact parent epoch
# has an artifact-backed resolver. The coordinator discovers owners dynamically.
# reflex-cadence: */5 * * * *
# reflex-args: --run
# orphan-ok: cron reflex; idempotent ledger backfill for blocked tasks.
set -u -o pipefail
export PATH="$HOME/.local/bin:$PATH"

run_sweep() {
    if [ "${MESH_UNBLOCK_SWEEP_DRY_RUN:-0}" = 1 ]; then
        printf '%s\n' 'mesh-task unblock-sweep'
    else
        mesh-task unblock-sweep || return
    fi
}

if [ "${1:-}" = --test ]; then
    expected='mesh-task unblock-sweep'
    actual="$(MESH_UNBLOCK_SWEEP_DRY_RUN=1 "$0" --run)" || {
        echo 'smoke-test: FAIL (dry-run sweep failed)' >&2
        exit 1
    }
    [ "$actual" = "$expected" ] || {
        echo 'smoke-test: FAIL (dynamic sweep contract changed)' >&2
        diff -u <(printf '%s\n' "$expected") <(printf '%s\n' "$actual") >&2 || true
        exit 1
    }
    echo 'smoke-test: ok (all blocked-owner sweeps, deterministic dry-run)'
    exit 0
fi

case "${1:---run}" in
    --run) run_sweep ;;
    *) echo "usage: $0 [--run|--test]" >&2; exit 2 ;;
esac
