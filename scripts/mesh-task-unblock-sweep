#!/usr/bin/env bash
# mesh-task-unblock-sweep — keep blocked and recently prerequisite-rejected work actionable.
# A blocked task is not work for its original owner until its exact parent epoch
# has an artifact-backed resolver. The coordinator discovers owners dynamically.
# reflex-cadence: */5 * * * *
# reflex-args: --run
# orphan-ok: cron reflex; idempotent ledger backfill for blocked tasks.
set -u -o pipefail
export PATH="$HOME/.local/bin:$PATH"

run_sweep() {
    local mesh_dir="${MESH_DIR:-$HOME/.mesh}"
    mkdir -p "$mesh_dir" || return 1
    exec 9>"$mesh_dir/.task-unblock-sweep.lock" || return 1
    if ! flock -n 9; then
        echo 'mesh-task-unblock-sweep: skip — another sweep owns this run'
        return 0
    fi
    if [ "${MESH_UNBLOCK_SWEEP_DRY_RUN:-0}" = 1 ]; then
        printf '%s\n' 'mesh-task lease-expiry-reap'
        printf '%s\n' 'mesh-task dead-letter-sweep'
        printf '%s\n' 'mesh-task unblock-sweep'
        printf '%s\n' 'mesh-task route-unowned --apply'
    else
        local sweep_rc=0 dead_letter_rc=0 lease_reap_rc=0 witness_rc=0 route_rc=0
        MESH_TASK_ACTOR="${MESH_TASK_COORDINATOR:-witness}" mesh-task lease-expiry-reap || lease_reap_rc=$?
        mesh-task dead-letter-sweep || dead_letter_rc=$?
        mesh-task unblock-sweep || sweep_rc=$?
        mesh-witness-task-autonomy --once || witness_rc=$?
        MESH_TASK_ACTOR="${MESH_TASK_COORDINATOR:-witness}" mesh-task route-unowned --apply || route_rc=$?
        if [ "$lease_reap_rc" -ne 0 ] || [ "$dead_letter_rc" -ne 0 ] || [ "$sweep_rc" -ne 0 ]; then
            printf 'mesh-task-unblock-sweep: recovery failed lease-reap rc=%s; dead-letter rc=%s; sweep rc=%s; witness rc=%s; route rc=%s\n' "$lease_reap_rc" "$dead_letter_rc" "$sweep_rc" "$witness_rc" "$route_rc" >&2
            [ "$lease_reap_rc" -ne 0 ] && return "$lease_reap_rc"
            [ "$dead_letter_rc" -ne 0 ] && return "$dead_letter_rc"
            return "$sweep_rc"
        fi
        [ "$route_rc" -ne 0 ] && return "$route_rc"
        return "$witness_rc"
    fi
}

if [ "${1:-}" = --test ]; then
    expected="$(printf '%s\n%s\n%s\n%s\n' 'mesh-task lease-expiry-reap' 'mesh-task dead-letter-sweep' 'mesh-task unblock-sweep' 'mesh-task route-unowned --apply')"
    test_dir="$(mktemp -d)" || exit 1
    trap 'rm -rf "$test_dir"' EXIT
    actual="$(MESH_DIR="$test_dir" MESH_UNBLOCK_SWEEP_DRY_RUN=1 "$0" --run)" || {
        echo 'smoke-test: FAIL (dry-run sweep failed)' >&2
        exit 1
    }
    [ "$actual" = "$expected" ] || {
        echo 'smoke-test: FAIL (dynamic sweep contract changed)' >&2
        diff -u <(printf '%s\n' "$expected") <(printf '%s\n' "$actual") >&2 || true
        exit 1
    }
    repo="${MESH_REPO:-$HOME/lte-workstation}"
    python3 "$repo/tests/test-mesh-task-unblock-quiet.py" || exit 1
    python3 "$repo/tests/test-mesh-task-fastpos.py" || exit 1
    python3 "$repo/tests/test-mesh-task-replay-cache-integrity.py" || exit 1
    python3 "$repo/tests/test-mesh-promises-cache-equivalence.py" || exit 1
    python3 "$repo/tests/test-mesh-promises-match-equivalence.py" || exit 1
    python3 "$repo/tests/test-mesh-promises-materialize-failure.py" || exit 1
    python3 "$repo/tests/test-mesh-promises-check-balances.py" || exit 1
    echo 'smoke-test: ok (blocker/rejection recovery sweep, deterministic dry-run)'
    exit 0
fi

case "${1:---run}" in
    --run) run_sweep ;;
    *) echo "usage: $0 [--run|--test]" >&2; exit 2 ;;
esac
