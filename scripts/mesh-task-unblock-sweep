#!/usr/bin/env bash
# mesh-task-unblock-sweep — keep dependency-blocked task chains actionable.
# A blocked task is not work for its original owner until its prerequisite has an
# artifact-backed resolver. This reflex materializes those resolvers idempotently;
# mesh-task deliberately leaves operator-input/external-event blockers parked.
# reflex-cadence: */5 * * * *
# reflex-args: --run
# orphan-ok: cron reflex; idempotent ledger backfill for dependency blockers.
set -u -o pipefail
export PATH="$HOME/.local/bin:$PATH"

OWNERS="${MESH_UNBLOCK_SWEEP_OWNERS:-steward operator tg haunt hire health}"

run_sweep() {
    local owner
    for owner in $OWNERS; do
        if [ "${MESH_UNBLOCK_SWEEP_DRY_RUN:-0}" = 1 ]; then
            printf 'mesh-task unblock-sweep %s\n' "$owner"
        else
            mesh-task unblock-sweep "$owner" || return
        fi
    done
}

if [ "${1:-}" = --test ]; then
    expected='mesh-task unblock-sweep steward
mesh-task unblock-sweep operator
mesh-task unblock-sweep tg
mesh-task unblock-sweep haunt
mesh-task unblock-sweep hire
mesh-task unblock-sweep health'
    actual="$(MESH_UNBLOCK_SWEEP_DRY_RUN=1 "$0" --run)" || {
        echo 'smoke-test: FAIL (dry-run sweep failed)' >&2
        exit 1
    }
    [ "$actual" = "$expected" ] || {
        echo 'smoke-test: FAIL (owner sweep contract changed)' >&2
        diff -u <(printf '%s\n' "$expected") <(printf '%s\n' "$actual") >&2 || true
        exit 1
    }
    echo 'smoke-test: ok (all blocked-owner sweeps, deterministic dry-run)'
    exit 0
fi

case "${1:---run}" in
    --run) run_sweep ;;
    *) echo "usage: $0 [--run|--test]" >&2; exit 2 ;;
esac
