[Unit]
Description=chaos canary (harmless target to prove the chaos-reflex; sleeps, auto-restarts)

[Service]
# Minimal harmless workload: a pid that exists and is SIGTERM-recoverable. mesh-chaos SIGTERMs
# MainPID and verifies systemd brings a NEW pid back — Restart=always + RestartSec=1 is the
# resilience property under test. NOT static: [Install] below makes it enable-able + reboot-durable,
# so it stays ACTIVE and the chaos drill has a live target (the fix for chaos-lane-revival: a static/
# inactive canary silently SKIPs every run → cron-green while proving ZERO recovery).
ExecStart=/bin/sh -c 'while true; do sleep 30; done'
Restart=always
RestartSec=1

[Install]
WantedBy=default.target
