#!/usr/bin/env bash
# mesh-resource-guard — monitor each mind's RAM/CPU, alert on runaway.
#
#   mesh-resource-guard        scan all minds, report one-line per mind
#   mesh-resource-guard --alert  cron mode: check thresholds, edge-triggered alert
#   mesh-resource-guard --test smoke test
#
# reflex-cadence: */2 * * * *
# reflex-args: --alert
# Self-wired liveness reflex (mesh-autowire): --alert must run periodically or every board signal it
# emits (RUNAWAY renice/oom, DUAL-ELEVATED, NODE-PRESSURE) is dormant. It was unwired — the dash only
# ran --status (display), so the 20:05-20:12Z OOM storm passed with no board post. */2 catches the
# ~7-min swap-exhaustion ramp with several samples of lead. NODE-PRESSURE never kills; RUNAWAY only
# renices + oom_score_adj (never hard-kills — operator decides).
#
# Thresholds: RSS > 3GB || CPU > (nproc × 90%) || RSS > 50% of MemTotal.
# On alert: renice +19, increase oom_score_adj to make it the OOM target.
# Never hard-kills — operator decides.
#
# DUAL-ELEVATED (literature/soc-multicriticality-20260704, arxiv 2506.04275 "Self-organization to
# multicriticality", Jun 2025): that paper shows a coupled system can self-tune to be critical along
# TWO independent order parameters AT ONCE, a materially different (riskier) regime than either alone.
# The RUNAWAY checks below are single-axis ORs (RSS>X || CPU>Y) — structurally blind to a mind rising
# on BOTH axes together while staying under each individual line. DUAL-ELEVATED below is that joint
# precursor: visibility only (same never-hard-act posture as RUNAWAY), no mitigation.
# ── RHEOSTASIS: a DEFENDED, scheduled elevation is not dysregulation ──
# LITERATURE (homeostasis/allostasis/ultrastability — a THIRD regulatory mode, 2026-07-27, genome mind;
# live web). Concept: RHEOSTASIS (N. Mrosovsky, *Rheostasis: The Physiology of Change*, OUP 1990) —
# "homeostatic defences are PRESENT but there is a change in the LEVEL that is defended." Fever, seasonal
# body-mass, torpor: the set-point is programmatically MOVED and the system then DEFENDS THE NEW VALUE with
# full negative-feedback vigour — it RESISTS being pushed back to baseline (a febrile body shivers if cooled).
# Live restatement: *Perspective: rheostasis revisited — hibernation and tanycytes*, J Comp Physiol B (2025),
# doi:10.1007/s00360-025-01636-x (PMC12743108) — the hypothalamus coordinates a SCHEDULED, multi-system
# set-point shift, not passive conformity. Verified live (WebSearch 2026-07-27); review doc:
# docs/reviews/rheostasis-defended-setpoint-productive-fever-2026-07-27.md.
# Where THIS reflex stops short: every threshold below (RSS>3GB, CPU>nproc×90%, NODE-PRESSURE mem/swap
# bands) is a FIXED homeostatic set-point — it reads ALL elevation as potential dysregulation. But some
# elevation is a PRODUCTIVE FEVER: a node running a DECLARED heavy job (a grind batch, a fine-tune, warm
# GPU inference) has high RSS/CPU that is EXPECTED, SCHEDULED, and to-be-DEFENDED for the job's duration.
# The guard has no notion of a defended-elevated set-point: it would renice/oom_score_adj the very PID doing
# the work (bounded — it NEVER hard-kills, operator decides) and, worse, post RUNAWAY/NODE-PRESSURE as an
# incident when the "breach" is the point. Fighting a productive fever is the rheostatic error: correcting
# toward the OLD baseline a state the system is deliberately holding at the NEW one.
# DISTINCT (do not conflate): NOT allostasis (a demand-driven reference shift, reactive to current context —
# the mesh embodies that on mesh-body-power/mesh-algedonic); rheostasis is a SCHEDULED/PROGRAMMED set-point
# the system PROACTIVELY defends and RESISTS un-doing. NOT the Reactive Scope Model (wear LOWERS a threshold
# over time — involuntary drift; here the shift is voluntary, upward, and reversible on schedule). NOT
# homeorhesis (mesh-body-power:21 — defend a TRAJECTORY not a point; here the point is defended, just MOVED).
# NOT DUAL-ELEVATED above (that is a joint two-axis BREACH, a riskier true overload; rheostasis is elevation
# that is NOT a breach at all). The signal already on disk: mesh-bg-register manifests
# (~/.mesh/bg/<window>/<batch>.manifest, state=running) ARE the "programmed set-point elevation" — a declared,
# lease-bounded heavy job with a PID. This guard does not read them (checked).
# HELD fix (instrument-first, operator-gated — behavioral): read the running bg manifests; when an elevated
# PID belongs to a declared running batch, RE-LABEL its verdict FEVER (declared <slug>, defended set-point,
# returns at lease expiry) instead of RUNAWAY, and suppress the renice/oom nudge on that PID alone. WHY HELD
# (load-bearing caveat): the defended window MUST expire — a stuck/leaked manifest would blind the guard to a
# genuine runaway forever (the crash-reap that flips a dead-pid running→crashed, mesh-bg-register, is the
# prerequisite), and a NODE-PRESSURE breach that threatens OOM for the WHOLE node still acts even mid-fever
# (defend the elevation, not to the point of a node-wide kill). Not shipped — zero behavior change; names the
# missing distinction so the fixed set-points can honour a scheduled fever without going blind.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
MESH="$HOME/.mesh"; mkdir -p "$MESH"
FLAG="$MESH/.resource-guard-flag"
FLAG_DUAL="$MESH/.resource-guard-dual-flag"
FLAG_NODE="$MESH/.resource-guard-node-flag"
# STATE: consumed by mesh-health-state's DECLARE registry ("resource|.resource-guard-state|OK").
# HOLLOW-SENSE FOUND 2026-07-08 (sense-liveness sweep): this integration point was wired into
# mesh-health-state on 2026-06-17 (72dd7ec) expecting a live OK/WARN heartbeat, but --alert never
# actually wrote it — the file on disk was a one-off manual write from 2026-06-16 (unrelated
# window-check-shaped content, no script in the genome ever produced that format) and sat frozen for
# 3+ weeks while --alert kept firing every 2min, silently dragging mesh-health-state's aggregate
# verdict to WARN forever. Fixed by having --alert actually maintain it every run (see
# resource_state_label below).
STATE="$MESH/.resource-guard-state"
MEMTOTAL=$(awk '/MemTotal/{print $2}' /proc/meminfo)  # kB
THRESH_MB=$(( MEMTOTAL / 2 / 1024 ))   # 50% of RAM in MB
THRESH_RSS_MB=3072                      # hard cap: 3GB per process
NPROC=$(nproc)
THRESH_CPU=$(( NPROC * 90 ))            # 90% × nproc (percentage points)
THRESH_MB_ELEV=$(( THRESH_MB * 3 / 5 ))   # ~30% of RAM — joint-elevated line (below RUNAWAY)
THRESH_CPU_ELEV=$(( THRESH_CPU * 3 / 5 )) # 60% of the RUNAWAY CPU line — joint-elevated line
# NODE-PRESSURE axis (the BEFORE-signal for OOM): fire when MemAvailable drops below NODE_MEM_PCT% of
# MemTotal OR SwapFree below NODE_SWAP_PCT% of SwapTotal. Independent of the per-mind table — it scans
# EVERY process, because the killers are usually not minds (20:05-20:12Z OOM storm: whisper.cpp 1.6GB
# + synth python 914MB, invisible to the ^(claude|opencode|…)$ scan; guard printed all-OK as the
# kernel batch-killed 8 procs). hw-fault-watch alerts AFTER kills; this is the missing BEFORE signal.
# The two percents are the SAME calibration mesh-doctor's _sc_mem_exhausted defers its whole --cron
# scan on. They used to live inline in BOTH scripts, coupled only by a comment there saying "Mirrors
# mesh-resource-guard's own NODE-PRESSURE band" — two copies that could rot apart, leaving the doctor
# silently deferring on a band this guard no longer alerts on. Calibration is now ONE row:
# scripts/uxn/threshold-ledger `node-pressure mem=10 swap=5`. Env > ledger > inline (fail-open: a
# missing/corrupt ledger degrades to the old inline numbers, never to an unset threshold).
_ledger_const(){ # <gate> <k> <fallback> — resolve a calibrated constant, naturals-only
  local repo="${MESH_REPO:-$HOME/lte-workstation}" led v=""
  led="${MESH_THRESHOLD_LEDGER:-$repo/scripts/uxn/threshold-ledger}"
  [ -f "$led" ] && [ -x "$repo/scripts/uxn/mesh-sexpr-gate" ] \
    && v="$(MESH_SEXPR_GATES="$led" "$repo/scripts/uxn/mesh-sexpr-gate" --const "$1" "$2" 2>/dev/null)"
  case "$v" in ''|*[!0-9]*) v="$3" ;; esac
  printf '%s\n' "$v"
}
NODE_MEM_PCT="${MESH_RG_MEM_PCT:-$(_ledger_const node-pressure mem 10)}"
NODE_SWAP_PCT="${MESH_RG_SWAP_PCT:-$(_ledger_const node-pressure swap 5)}"
# Recovery-with-margin re-arm (chat-review/resguard-episode-rearm-hysteresis): a node-axis flag is NOT
# re-armed by a single clean pass — a value HOVERING at its threshold would flap the episode into a
# fresh [node-*] post on every re-breach (live 2026-07-07: 4× [node-pressure] + 2× [node-accelerating]
# 08:24-09:26Z = ONE sustained episode, six posts). The flag file carries a "CLEAN:<n>" consecutive-clean
# streak alongside the sticky union; the flag clears (re-arming a new episode/post) only after
# ≥RG_REARM_CLEAN cleans in a row OR a margin recovery (value ≥2× the line) → one episode = one post.
RG_REARM_CLEAN="${MESH_RG_REARM_CLEAN:-3}"

# NODE-ACCELERATING axis (dragon-king precursor — literature/dragon-king-precursor-20260706,
# Sornette 2009 arxiv 0907.4290 + Sornette & Ouillon 2012 arxiv 1205.1002). A "dragon king" is an
# extreme event OUTSIDE the power-law tail, born of a transient rise in COUPLING → positive feedback
# → SUPER-EXPONENTIAL growth → bifurcation. Unlike a black swan it matures through a DETECTABLE
# PRECURSOR (accelerating consumption), so it is predictable+suppressible. Every axis above is a LEVEL
# detector — fires on a single-frame snapshot, blind to the trajectory. The 20:05Z 8-proc OOM batch-
# kill + 02:04Z 2.5GB python kill were dragon kings (unniced heavy jobs stacking → swap-thrash →
# super-exponential collapse): a level gate sees nothing until MemAvailable is already BELOW the line,
# too late to defer the job that tips it over. This axis watches the 2nd derivative — accelerating
# MemAvailable drops across the last few passes — and emits [node-accelerating] BEFORE the level trips.
# Visibility only (same never-act posture as DUAL-ELEVATED); mesh-heavy-run consults it via --status.
ACCEL_HIST="${MESH_RG_ACCEL_HIST:-$MESH/.rg-memhist}"
FLAG_ACCEL="$MESH/.resource-guard-accel-flag"
ACCEL_KEEP="${MESH_RG_ACCEL_KEEP:-4}"             # samples retained (need ≥4 → 3 consecutive drops)
ACCEL_FLOOR_MB="${MESH_RG_ACCEL_FLOOR_MB:-150}"   # noise floor: latest drop must exceed this (MB)
# ACCEL_LEVEL_PCT (chat-review/resguard-accel-no-level-gate): the shape test above is SCALE-BLIND — a
# 150MB+ 3-step ramp looks identical whether MemAvailable is at 6% of RAM (real precursor) or 85%+ (routine
# cache churn). Live false-positive: imozerov-Default-string posted 3x [node-accelerating] over 2.5h while
# MemAvailable held 13268->13126->13247MB of 15Gi (87%+ free, net <200MB drift). Corroborate the shape with
# the ABSOLUTE level before it's board-worthy — mirrors node_pressure_classify's pct-of-total pattern.
ACCEL_LEVEL_PCT="${MESH_RG_ACCEL_LEVEL_PCT:-20}"
RG_INTERVAL_S="${MESH_RG_INTERVAL_S:-120}"        # nominal seconds/pass (reflex-cadence */2 * * * *) — used only by node_tau_eta's kB/interval -> seconds conversion
# Parisian-ruin implementation-delay clock (see node_dwell_classify): continuous dwell below the pressure
# barrier beyond this many seconds = absorption (ruin), not a recoverable dip. Bounded ABOVE by the
# retained MemAvailable history window (ACCEL_KEEP*RG_INTERVAL_S) — the observable dwell can't exceed it.
RG_DWELL_CLOCK_S="${MESH_RG_DWELL_CLOCK_S:-300}"
# CRITICALITY axis (node_criticality_classify) — its own LONG history, deliberately NOT the 4-sample
# accel_series, whose size is load-bearing for the accel/tau/dwell axes and must not be bent (the
# recovery-curvature block below names this same prerequisite). 64 samples x 120s = ~2.1h of buffer.
LONG_HIST="${MESH_RG_LONG_HIST:-$MESH/.rg-memhist-long}"
LONG_KEEP="${MESH_RG_LONG_KEEP:-64}"
RG_CRIT_MIN_N="${MESH_RG_CRIT_MIN_N:-24}"         # below this the split-half means are noise -> honest n/a
RG_CRIT_CV_FLOOR="${MESH_RG_CRIT_CV_FLOOR:-0.05}" # below this the buffer is simply steady; A is meaningless
RG_CRIT_A_HI="${MESH_RG_CRIT_A_HI:-1.50}"         # low-half swing must exceed high-half swing by this to call approach
# GENERALIZED-DRAWDOWN barrier (node_drawdown_classify) — the ruin level as a FUNCTION of the running
# maximum, not a constant. Over the LONG history (the accel series' 4 samples cannot establish a peak).
RG_DD_PCT="${MESH_RG_DD_PCT:-$(_ledger_const node-drawdown pct 25)}"   # ruin level = peak x (1 - pct/100)
RG_DD_MIN_N="${MESH_RG_DD_MIN_N:-8}"              # below this the running max is not a peak -> honest n/a
# OMEGA / bankruptcy-rate axis (node_omega_classify) — accumulated depth-weighted hazard over the whole
# window, the axis that survives a SAWTOOTH (its siblings dwell/drawdown reset their clock on every tooth).
# Calibration is anchored to the Parisian clock: at deficit fraction RG_OMEGA_REF of the barrier, sustained
# continuously, hazard accrues at exactly one clock per RG_DWELL_CLOCK_S — so the two axes fire together on
# the excursion Parisian was built for and diverge only where it is blind. Convexity exponent p: twice as
# deep is 2^p times as lethal (p=1 would make ω linear in the deficit, p=2 is the convex reading).
RG_OMEGA_P="${MESH_RG_OMEGA_P:-2}"                # convexity exponent of the bankruptcy rate ω(deficit)
RG_OMEGA_REF="${MESH_RG_OMEGA_REF:-0.5}"          # reference deficit fraction (the siblings' "deep" depth)
RG_OMEGA_WARN="${MESH_RG_OMEGA_WARN:-0.35}"       # accruing floor: H>=this (P(bankruptcy)~30%) -> hazard
RG_OMEGA_MIN_N="${MESH_RG_OMEGA_MIN_N:-8}"        # below this there is no peak and no occupation estimate -> n/a

ts() { date -u +%Y-%m-%dT%H:%M:%SZ; }

# INSTANTANEOUS CPU% per PID over a short interval. ps's %cpu is a LIFETIME AVERAGE and MISLEADS
# about current burn: a mind that worked hard then went idle shows a high avg (false RUNAWAY), and a
# fresh spinner shows a low avg (MISSED) — the exact rate-limited-spinner class this guard must catch
# (2026-06-13). Sample utime+stime from /proc/<pid>/stat twice and delta it.
inst_cpu() { # stdin: "name pid rss_mb" lines → stdout: same + a real-time cpu% field
  local interval="${MESH_RG_INTERVAL:-0.7}" hz; hz=$(getconf CLK_TCK 2>/dev/null || echo 100)
  local -a NM PD RS T1; local n p r
  while read -r n p r; do NM+=("$n"); PD+=("$p"); RS+=("$r"); T1+=("$(awk '{print $14+$15}' "/proc/$p/stat" 2>/dev/null || echo 0)"); done
  sleep "$interval"
  local i=0
  for p in "${PD[@]}"; do
    local c2; c2=$(awk '{print $14+$15}' "/proc/$p/stat" 2>/dev/null || echo 0)
    awk -v nm="${NM[$i]}" -v pid="$p" -v rs="${RS[$i]}" -v a="${T1[$i]}" -v b="$c2" -v iv="$interval" -v hz="$hz" \
      'BEGIN{ printf "%s %d %.1f %.1f\n", nm, pid, rs, (b-a)*100/(hz*iv) }'
    i=$((i+1))
  done
}
# --- find mind PIDs -------------------------------------------------------
scan_minds() {
  ps -eo pid,rss,comm,args --no-headers 2>/dev/null \
    | awk -v patterns='^(claude|opencode|gemini|codex|ollama)$' '
  {
    pid=$1; rss_kb=$2; comm=$3
    if (rss_kb < 5000) next
    if (comm ~ /^(awk|grep|sh|bash)$/) next
    if (comm ~ patterns) { printf "%s %d %.1f\n", comm, pid, rss_kb/1024; next }
    for(i=4;i<=NF;i++) {
      bname=$i; gsub(/.*\//,"",bname)
      if (bname ~ patterns) { printf "%s %d %.1f\n", bname, pid, rss_kb/1024; break }
    }
  }' | awk '!seen[$2]++' \
     | inst_cpu \
     | sort -t' ' -k4 -rn   # sort by REAL-TIME cpu desc
}

# --- PID → tmux window ----------------------------------------------------
pid_to_win() {
  local pid="$1" p
  # walk ancestors until we hit the tmux pane PID or init
  p="$pid"
  while [ "$p" -gt 1 ] 2>/dev/null; do
    local win; win="$(tmux list-panes -a -F '#{window_name} #{pane_pid}' 2>/dev/null | awk -v pid="$p" '$2 == pid {print $1; exit}')"
    [ -n "$win" ] && { echo "$win"; return; }
    p=$(awk '{print $4}' "/proc/$p/stat" 2>/dev/null || echo 1)
  done
}
# --- classify --------------------------------------------------------------
check_mind() {
  local name="$1" pid="$2" rss_mb="$3" cpu_pct="$4"
  local flags=""
  # use awk for float comparison (bash integer -gt doesn't do floats)
  if awk "BEGIN {exit !($rss_mb > $THRESH_MB)}"; then
    flags="$flags RSS=${rss_mb}MB(>50%RAM)"
  fi
  if awk "BEGIN {exit !($rss_mb > $THRESH_RSS_MB)}"; then
    flags="$flags RSS=${rss_mb}MB(>${THRESH_RSS_MB}MB)"
  fi
  if awk "BEGIN {exit !($cpu_pct > $THRESH_CPU)}"; then
    flags="$flags CPU=${cpu_pct}%(>${THRESH_CPU})"
  fi
  [ -n "$flags" ] && echo "RUNAWAY $name pid=$pid ${flags# }" && return 1
  # DUAL-ELEVATED: both axes elevated together, below either single-axis RUNAWAY line — see the
  # multicriticality note at the top of the file. Independent OR-thresholds above can't see this.
  if awk "BEGIN {exit !($rss_mb > $THRESH_MB_ELEV && $cpu_pct > $THRESH_CPU_ELEV)}"; then
    echo "DUAL-ELEVATED $name pid=$pid RSS=${rss_mb}MB(>${THRESH_MB_ELEV}MB) CPU=${cpu_pct}%(>${THRESH_CPU_ELEV}%) — both axes rising together"
    return 2
  fi
  echo "OK $name pid=$pid rss=${rss_mb}MB cpu=${cpu_pct}%"
  return 0
}

# --- mitigation (sudo-free best-effort) ------------------------------------
mitigate() {
  local pid="$1" name="$2"
  renice -n 19 -p "$pid" >/dev/null 2>&1 || true
  echo 800 > "/proc/$pid/oom_score_adj" 2>/dev/null || true
  echo "$(ts) mitigated $name pid=$pid: renice 19, oom_score_adj=800" >> "$MESH/resource-guard.log"
}

# --- node-pressure (memory/swap exhaustion — scans ALL processes) ----------
# PURE classifier: given mem/swap figures (kB) + pct thresholds, decide pressure.
# stdout: "class|reason" when under pressure (empty otherwise). rc 0=pressure, 1=ok.
# class = which axes fired ("mem", "swap", "mem;swap") — the value-free dedupe key for the
# --alert edge gate: live MB values jitter every pass (SwapFree 139→193→97MB across one
# sustained episode, 3 [node-hot] posts in 9min live 2026-07-05 20:45-20:54Z), so the edge
# must key on the CLASS, never the value-carrying reason string. Values stay in reason (text).
# A zero/absent axis is a safe no-op (MemTotal 0 → ok; SwapTotal 0 → swap axis skipped, no div-by-0).
# $7/$8 (optional) = PSI memory "some avg10"/"full avg10" — corroborate the SWAP axis only
# (chat-review/resguard-nodepressure-psi-corroborate, mirroring mesh-node-health 5e76287): raw
# SwapFree% pins on COLD evicted pages that don't reflect a live stall (live: resource-guard.log
# posted 5 '[swap]' NODE-PRESSURE lines 01:26-03:10Z on a node independently confirmed PSI-cold the
# whole window). psi_mem_band QUIET/BUSY = hollow → suppress the swap axis; PRESSURED/SATURATED =
# real stall → fire; PSI absent/unreadable ("" from psi_mem_band) → fall back to firing
# uncorroborated, same as before this fix (honest-fusion: missing corroboration is not proof of
# hollow, and every pre-existing 6-arg caller must keep behaving exactly as it did).
node_pressure_classify() { # $1 memavail_kb $2 memtotal_kb $3 swapfree_kb $4 swaptotal_kb $5 mem_pct $6 swap_pct [$7 psi_some10] [$8 psi_full10]
  local ma="$1" mt="$2" sf="$3" st="$4" mp="$5" sp="$6" psi_some="${7:-}" psi_full="${8:-}" reason="" cls=""
  [ "${mt:-0}" -gt 0 ] 2>/dev/null || return 1
  # MemAvailable below mem_pct% of MemTotal  (integer-safe: ma*100 < mt*mp)
  if awk "BEGIN{exit !($ma * 100 < $mt * $mp)}"; then
    reason="MemAvailable $((ma/1024))MB (<${mp}% of $((mt/1024))MB)"; cls="mem"
  fi
  # SwapFree below swap_pct% of SwapTotal — only when swap is configured
  if [ "${st:-0}" -gt 0 ] 2>/dev/null && awk "BEGIN{exit !($sf * 100 < $st * $sp)}"; then
    local psi_band; psi_band="$(psi_mem_band "$psi_some" "$psi_full")"
    case "$psi_band" in
      QUIET|BUSY) : ;;  # hollow — no real memory stall corroborated, suppress the swap axis
      *)
        reason="${reason:+$reason; }SwapFree $((sf/1024))MB (<${sp}% of $((st/1024))MB)"
        [ -n "$psi_band" ] && reason="$reason (psi=$psi_band)"
        cls="${cls:+$cls;}swap"
        ;;
    esac
  fi
  [ -n "$reason" ] || return 1
  echo "$cls|$reason"
  return 0
}
# psi_mem_band <some_avg10> <full_avg10> → QUIET|BUSY|PRESSURED|SATURATED, or empty (unreadable/
# absent/non-numeric — honest-absent, never fabricated). Same thresholds as mesh-psi-memory's
# classify() (the mesh's one canonical PSI-memory banding, reused here rather than re-derived):
# full>=5.0=SATURATED, some>=10.0=PRESSURED (both = a real stall), some>0.5=BUSY (momentary jitter,
# not a stall — mesh-node-health 5e76287), else QUIET (cold/hollow).
psi_mem_band() {
  awk -v some="${1:-}" -v full="${2:-}" 'BEGIN{
    if (some == "" || full == "" || some !~ /^[0-9]+([.][0-9]+)?$/ || full !~ /^[0-9]+([.][0-9]+)?$/) { exit }
    if (full >= 5.0) { print "SATURATED"; exit }
    if (some >= 10.0) { print "PRESSURED"; exit }
    if (some > 0.5) { print "BUSY"; exit }
    print "QUIET"
  }'
}
# Read the four figures from $MESH_RG_MEMINFO (test fixture) or /proc/meminfo. Always prints 4 ints.
read_meminfo() {
  awk '
    /^MemTotal:/     {mt=$2}
    /^MemAvailable:/ {ma=$2}
    /^SwapTotal:/    {st=$2}
    /^SwapFree:/     {sf=$2}
    END{ printf "%d %d %d %d\n", ma+0, mt+0, sf+0, st+0 }
  ' "${MESH_RG_MEMINFO:-/proc/meminfo}" 2>/dev/null
}
# Read PSI memory "some avg10"/"full avg10" from $MESH_RG_PSI_MEM_FILE (test fixture) or
# /proc/pressure/memory. Echoes "some10 full10" (blank fields when unreadable/unparsable) — never
# fabricates a reading, same test-injection idiom as read_meminfo().
read_psi_mem_avg10() {
  local f="${MESH_RG_PSI_MEM_FILE:-/proc/pressure/memory}"
  [ -r "$f" ] || { printf ' \n'; return; }
  awk '
    $1=="some"{ for(i=2;i<=NF;i++){ split($i,kv,"="); if(kv[1]=="avg10") some=kv[2] } }
    $1=="full"{ for(i=2;i<=NF;i++){ split($i,kv,"="); if(kv[1]=="avg10") full=kv[2] } }
    END{ printf "%s %s\n", some, full }
  ' "$f" 2>/dev/null
}
# Top-N processes by RSS, REGARDLESS of comm (the OOM culprits are usually not minds).
# comm can be a bare version string when an engine execs its versioned binary (claude from
# ~/.local/share/claude/versions/2.1.210 → comm='2.1.210'): the live 09:36 [node-pressure] alert
# named a 16.4GB culprit '2.1.210(16445MB)' — unidentifiable at the moment identification matters.
# When comm has no letters, render the last path components of args instead ('claude/versions/2.1.210').
# $MESH_RG_PS_FILE = test fixture (same injection idiom as read_meminfo).
top_rss() { # $1 = count (default 3)
  { if [ -n "${MESH_RG_PS_FILE:-}" ]; then cat "$MESH_RG_PS_FILE" 2>/dev/null
    else ps -eo rss,comm,args --no-headers 2>/dev/null; fi; } \
    | sort -rn | head -"${1:-3}" \
    | awk '{
        name=$2
        if (name !~ /[A-Za-z]/ && $3 != "") {
          n=split($3, seg, "/")
          name = seg[n]
          if (n >= 2) name = seg[n-1] "/" name
          if (n >= 3) name = seg[n-2] "/" name
        }
        printf "%s(%dMB) ", name, $1/1024
      }'
}
# Evaluate node-pressure now → sets NODE_CLASS (fired axes) + NODE_REASON (both empty=ok).
# Reused by --alert and --status.
node_pressure_eval() {
  local a t sf st out psi_some psi_full
  read -r a t sf st < <(read_meminfo)
  read -r psi_some psi_full < <(read_psi_mem_avg10)
  out="$(node_pressure_classify "$a" "$t" "$sf" "$st" "$NODE_MEM_PCT" "$NODE_SWAP_PCT" "$psi_some" "$psi_full")" || out=""
  NODE_CLASS="${out%%|*}"; NODE_REASON="${out#*|}"
  NODE_AVAIL_MB=$(( a / 1024 )); NODE_TOTAL_MB=$(( t / 1024 ))
  NODE_SWAPFREE_MB=$(( sf / 1024 )); NODE_SWAPTOTAL_MB=$(( st / 1024 ))
}
# Edge gate for [node-hot]: one post per fired-axis episode, keyed on a STICKY UNION of every
# axis seen this episode. Only a never-seen-this-episode axis (escalation) posts; de-escalation
# (an axis clearing while another holds) is silent — an axis hovering at its threshold must not
# oscillate the key both directions (mem;swap↔swap = 3 posts in 4min live 2026-07-06 14:32-36Z,
# the any-change key deduped VALUE jitter but not axis-MEMBERSHIP jitter). Caller clears the
# flag on full recovery, re-arming the episode.
node_edge_should_post() { # $1 flagfile $2 class ("mem", "swap", "mem;swap", "accel", ...)
  local prev union ax new=0 clean
  # The flag file holds the sticky axis union on its FIRST line + an optional "CLEAN:<n>" recovery-streak
  # line (rg_clean_rearm). Read the union ALONE (strip the streak line) so a "CLEAN:n" line can never be
  # mistaken for an axis, and preserve the streak line across an escalation rewrite.
  prev=$(grep -v '^CLEAN:' "$1" 2>/dev/null | head -1 || true)
  clean=$(grep '^CLEAN:' "$1" 2>/dev/null | head -1 || true)
  union="$prev"
  local IFS=';'
  for ax in $2; do
    case ";$union;" in
      *";$ax;"*) ;;                                  # axis already seen this episode
      *) new=1; union="${union:+$union;}$ax" ;;      # genuinely new axis → escalation
    esac
  done
  [ "$new" = 1 ] || return 1
  { echo "$union"; [ -n "$clean" ] && printf '%s\n' "$clean"; } > "$1"
  return 0
}

# --- recovery-with-margin re-arm helpers (episode hysteresis) --------------
# The node-axis edge flags are cleared ONLY through these, never a bare `rm -f`: a lone clean pass must
# not re-arm a threshold-hovering axis (that is the 6-post episode-flap this fixes). The flag file carries
# a "CLEAN:<n>" consecutive-clean streak alongside the sticky union.
rg_clean_streak() { sed -nE 's/^CLEAN:([0-9]+)$/\1/p' "$1" 2>/dev/null | head -1; }   # → n ("" if none)
# rg_breach_reset: a breaching pass zeroes the streak — cleans only count when UNINTERRUPTED. Preserves
# the union line. No-op if the flag doesn't exist yet (first breach of an episode).
rg_breach_reset() { # $1 flagfile
  [ -f "$1" ] || return 0
  { grep -v '^CLEAN:' "$1" 2>/dev/null; printf 'CLEAN:0\n'; } > "$1.t" 2>/dev/null && mv "$1.t" "$1" 2>/dev/null
}
# rg_clean_rearm: a clean pass bumps the streak; the flag (episode) clears — re-arming a fresh post —
# only after RG_REARM_CLEAN consecutive cleans OR a margin recovery ($2=1, value ≥2× the line). Returns
# 0 if it re-armed (flag removed), 1 if the episode is still held. No-op (return 0) if no episode is open.
rg_clean_rearm() { # $1 flagfile  $2 margin_recovered(1/0)
  [ -f "$1" ] || return 0
  local n; n=$(rg_clean_streak "$1"); n=$(( ${n:-0} + 1 ))
  if [ "${2:-0}" = 1 ] || [ "$n" -ge "$RG_REARM_CLEAN" ]; then rm -f "$1" 2>/dev/null; return 0; fi
  { grep -v '^CLEAN:' "$1" 2>/dev/null; printf 'CLEAN:%d\n' "$n"; } > "$1.t" 2>/dev/null && mv "$1.t" "$1" 2>/dev/null
  return 1
}
# margin recovery for node-pressure: no pressure even at 2× the pressure lines → strong recovery, re-arm
# now instead of waiting out the streak. Reuses node_pressure_classify with DOUBLED pct lines (it fires
# iff value < 2×line; NOT firing ⟹ value ≥2×line ⟹ recovered with margin). Same meminfo source as eval.
node_pressure_margin_recovered() { # echoes 1 if recovered with margin, else 0
  local a t sf st
  read -r a t sf st < <(read_meminfo)
  if node_pressure_classify "$a" "$t" "$sf" "$st" $(( NODE_MEM_PCT * 2 )) $(( NODE_SWAP_PCT * 2 )) >/dev/null 2>&1; then
    echo 0
  else
    echo 1
  fi
}

# PURE accelerating-consumption classifier. Given a whitespace series of MemAvailable kB (oldest→newest)
# and a noise floor in kB, decide whether consumption is ACCELERATING, and — separately — whether that
# acceleration is fast enough to be a SUPER-EXPONENTIAL (dragon-king precursor) ramp or merely SUPER-LINEAR.
# stdout: "accel|<reason>" when ramping (empty otherwise). rc 0=ramp, 1=not.
# Requires ≥4 samples → 3 consecutive drops, each STRICTLY larger than the last, ALL positive, and the
# latest drop ≥ floor. Deliberately strict on the FIRE gate: a steady drain, a decelerating drain, a
# single late spike, an oscillation, or freeing memory must NOT fire. A precursor asserted from jitter is
# the exact sin the literature warns about (asserting criticality without testing) — hence the battery.
#   LABEL (chat-review/resguard-accel-superexp-mislabel): absolute-monotone (d3>d2>d1) is only SUPER-LINEAR
# — the drops are growing, but that alone does NOT establish the accelerating-ratio a dragon king needs.
# Claim "super-exponential ramp / dragon-king precursor" ONLY when the drop RATIO is non-decreasing
# (d3/d2 ≥ d2/d1, cross-multiplied as d3*d1 ≥ d2*d2 to avoid division — safe, products stay <~1e13 within
# awk double precision). A falling ratio (e.g. 7400→460068→1258204 kB: 62×→2.7×) is real acceleration but
# DECELERATING growth — honest label "accelerating (super-linear)", never dragon-king.
node_accel_classify() { # $1 = "v0 v1 v2 ... vn" (kB, oldest→newest)   $2 = floor_kb
  awk -v floor="${2:-0}" 'BEGIN{
    n=split(ARGV[1], a, /[ \t\n]+/)
    m=0; for(i=1;i<=n;i++){ if(a[i]!=""){ m++; w[m]=a[i]+0 } }
    if (m < 4) exit 1                          # need ≥4 points for 3 drops
    d1=w[m-3]-w[m-2]; d2=w[m-2]-w[m-1]; d3=w[m-1]-w[m]
    if (!(d1>0 && d2>0 && d3>0)) exit 1        # all three must be consumption (memory falling)
    if (!(d3>d2 && d2>d1))       exit 1        # absolute-monotone: each drop larger than the last (super-linear)
    if (d3 < floor)              exit 1        # latest drop below noise floor → jitter, ignore
    if (d3*d1 >= d2*d2)                         # drop ratio non-decreasing → super-exponential (dragon-king)
      printf "accel|MemAvailable per-interval drop deltas %d→%d→%d kB accelerating (super-exponential ramp — drop ratio rising, latest %dMB/interval; MemAvailable now %dMB)", d1, d2, d3, int(d3/1024), int(w[m]/1024)
    else                                        # ratio falling → super-linear, NOT a dragon king
      printf "accel|MemAvailable per-interval drop deltas %d→%d→%d kB accelerating (super-linear — absolute drops growing but ratio falling, not a dragon-king; latest %dMB/interval; MemAvailable now %dMB)", d1, d2, d3, int(d3/1024), int(w[m]/1024)
    exit 0
  }' "$1"
}
# node_accel_level_low — LEVEL corroboration for the shape-only classifier above (chat-review/
# resguard-accel-no-level-gate): true only when current MemAvailable is below ACCEL_LEVEL_PCT% of
# MemTotal, the same pct-of-total idiom node_pressure_classify already uses. The shape test alone fires
# identically at 6% free and 87% free; this gate is what tells the board-post site apart. rc 0=low
# (board-worthy), 1=not (trace-only — the shape match still gets logged, just not board-posted).
node_accel_level_low() { # $1 avail_kb $2 total_kb
  local ma="$1" mt="$2"
  [ "${mt:-0}" -gt 0 ] 2>/dev/null || return 1
  awk "BEGIN{exit !($ma * 100 < $mt * $ACCEL_LEVEL_PCT)}"
}
# node_tau_eta — LITERATURE (live review, enactivism/4E cognition, ecological/direct-perception
# angle, 2026-07-09): Lee's General Tau Theory (Lee 1976's optical τ for time-to-contact; Lee 1998
# "Guiding movement by coupling taus" generalizes τ from vision to ANY gap-closing intrinsic
# variable) — a live 2026 application, Esmek & Prasad, "Tau-Theory-Based Guidance Methodology for
# Helicopter Obstacle Field Navigation" (Mathematics 14(2):260, Jan 2026, doi:10.3390/math14020260),
# computes real-time τ/τ̇ purely from the ratio of a proximal variable to its OWN instantaneous rate
# of change — no separate model of distance or velocity is ever built; the ratio itself specifies
# time-to-closure directly (the enactivist/ecological "direct perception" claim this mesh's other
# LITERATURE reviews critiqued from the representational side — this is the classic POSITIVE case
# the critiques argue against: a genuinely non-representational, single-ratio perceptual invariant).
# GAP: node_accel_classify() above already asks "IS MemAvailable's drop accelerating?" from this same
# rolling series — it never answers "HOW SOON", the question τ exists to answer with a single number.
# node_tau_eta() is that missing ETA: same series, same invariant birds/pilots use for time-to-
# contact, retargeted from optical expansion to resource exhaustion (kB remaining / kB consumed per
# interval = intervals-to-empty). τ is deliberately undefined (empty output) when the gap isn't
# closing this interval — Lee's τ only means anything while APPROACHING the boundary, so a flat or
# recovering pass must never fabricate an ETA (never fake urgency the honest read doesn't have).
#   RATE = SMOOTHED, not the single last drop (chat-review/resguard-tau-eta-uses-peak-drop): the accel
# FIRE gate guarantees the last interval's drop is the LARGEST of the retained 3 (d3>d2>d1), so dividing
# by that peak read the smallest-possible (most-alarming) sub-minute ETA on EVERY [node-accelerating]
# post while the node never OOMed (6 fires/window, 0 OOM). Divide instead by the MEAN per-interval
# consumption over the retained window ((w[first]-w[last])/intervals) so the ETA tracks the sustained
# trend, not the spike that tripped the gate. KEEP the last-interval-closing gate (Lee's τ: only speak
# while approaching NOW) AND require the smoothed net rate > 0 (a window that net-freed has no honest ETA).
node_tau_eta() { # $1 = "v0 v1 ... vn" (kB, oldest→newest, same series accel_series() gives)  $2 = interval_s
  awk -v ivl="${2:-120}" 'BEGIN{
    n=split(ARGV[1], a, /[ \t\n]+/)
    m=0; for(i=1;i<=n;i++){ if(a[i]!=""){ m++; w[m]=a[i]+0 } }
    if (m < 2) exit 1
    if (w[m-1] - w[m] <= 0) exit 1      # last interval not closing -> tau undefined (Lee: only while approaching)
    rate = (w[1] - w[m]) / (m - 1)      # SMOOTHED: mean kB consumed per interval over the retained window
    if (rate <= 0) exit 1               # net trend not consuming (freeing dominates) -> no honest ETA
    printf "%d", int((w[m] / rate) * ivl + 0.5)
    exit 0
  }' "$1"
}
# node_dwell_classify — LITERATURE (live review, antifragility/convexity/RUIN theory, Taleb area; angle =
# a recent result, 2026-07-29 WebSearch). PARISIAN RUIN: in classical ruin the process is dead the instant
# it crosses below the barrier (absorbing at zero); Parisian ruin recognizes ruin ONLY when the surplus
# stays CONTINUOUSLY below the barrier for longer than a fixed "implementation delay" — a grace clock d
# that RESETS the moment the process recovers above the barrier. An excursion the system climbs out of is
# survivable; only a SUSTAINED excursion is absorption. This is exactly the antifragility posture: a system
# that dips and recovers is robust (even strengthened), and it is DWELL, not the crossing, that kills.
#   ACTIVE, RECENT ruin-theory literature (the "what's new" the task asks for): the base model —
#   Czarna & Palmowski, "Ruin probability with Parisian delay for a spectrally negative Lévy risk process",
#   J. Appl. Probab. 48(4):984 (2011) — and the RECENT refinement this function actually implements,
#   DEFICIT-DEPENDENT delays: Baurdoux, Palmowski et al., "Parisian ruin with random deficit-dependent
#   delays for spectrally negative Lévy processes" (arXiv:2111.02695; Stoch. Proc. Appl. 2023) — the length
#   of the grace clock DEPENDS on how far below the barrier the process is: a deeper deficit gets a SHORTER
#   delay (you tolerate a shallow dip longer than a deep one). Plus the 2024 Laplace-transform treatment of
#   the Parisian ruin TIME and the 2026 subordinated Cramér–Lundberg asymptotics (arXiv:2603.01821) show the
#   area is live.
# THE GAP IT CLOSES — HERE. Every node-* axis in this guard is a LEVEL detector: node_pressure_classify
# fires on a SINGLE below-barrier frame (the instant of crossing = classical absorbing ruin); node_accel_
# classify reads the 2nd-derivative APPROACH (is the drop accelerating?); node_tau_eta answers time-TO the
# barrier (how soon will we cross?). NONE answers the Parisian question: once below, how LONG have we stayed
# there continuously — is this a dip we'll recover from, or absorption? The guard even has episode
# hysteresis (CLEAN:<n> re-arm), but that only suppresses RE-posting AFTER the instantaneous fire; it never
# defers the fire until the excursion has proven sustained. So a momentary MemAvailable dip (cache churn, a
# mind's transient allocation freed next pass) reads identically to a swap-thrash slide into OOM. Parisian
# ruin is the axis that tells a survivable dip from an absorbing one.
# node_dwell_classify(): over the SAME retained MemAvailable series (accel_series), count the trailing run
# of samples continuously below the barrier (resetting to clean on any sample at/above — the Parisian clock
# reset on recovery); dwell = run × interval. Grace clock = base d0, HALVED when the deepest point of the
# excursion is below barrier/2 (deficit-dependent delay). run≥2 AND dwell≥clock → "ruin|" (rc 0, sustained
# excursion = absorption); below-but-within-grace → "excursion|" (rc 2, recoverable dip, NOT ruin); latest
# recovered above / no history / barrier≤0 → clean (rc 1, empty — never fabricate ruin from a no-op).
# REPORT-ONLY / visibility (same posture as NODE-ACCELERATING's read-only --status line): it does NOT kill,
# defer, or board-post — one dwell reading needs trend before it can gate, and the LOUD escalation for a
# sustained excursion is node_pressure's own board path. Observable dwell is bounded by the retained history
# window (ACCEL_KEEP × RG_INTERVAL_S), so RG_DWELL_CLOCK_S must fit inside it.
# DISTINCT: NOT node_pressure_classify (instantaneous crossing = classical ruin; this is dwell-since = the
# Parisian refinement). NOT node_accel_classify (approach acceleration, before the crossing). NOT node_tau_
# eta (time-TO the barrier looking forward; this is time-SINCE looking back at the excursion). NOT the
# CLEAN:<n> hysteresis (suppresses re-posts after a fire; this governs whether the fire is warranted at all).
node_dwell_classify() { # $1="v0 v1 ... vn" (MemAvailable kB, oldest→newest)  $2=barrier_kb  $3=interval_s  $4=base_clock_s
  awk -v B="${2:-0}" -v ivl="${3:-120}" -v d0="${4:-300}" 'BEGIN{
    n=split(ARGV[1], a, /[ \t\n]+/)
    m=0; for(i=1;i<=n;i++){ if(a[i]!=""){ m++; w[m]=a[i]+0 } }
    if (m < 1 || B <= 0) exit 1                 # no history / no barrier → safe no-op (never fabricate ruin)
    run=0; mn=w[m]
    for (i=m; i>=1; i--) { if (w[i] < B) { run++; if (w[i] < mn) mn=w[i] } else break }  # Parisian clock: reset on recovery
    if (run == 0) exit 1                         # latest at/above barrier → clean, clock reset
    dwell = run * ivl
    deep  = (mn < B/2)                           # deficit-dependent delay (arXiv:2111.02695): deeper → shorter grace
    eff   = deep ? int(d0/2) : d0
    nowmb = int(w[m]/1024); lbl = deep ? "deep" : "shallow"
    if (run >= 2 && dwell >= eff) {              # run>=2: a single below-frame is a dip, never ruin (persistence floor)
      printf "ruin|MemAvailable below barrier for >=%ds (implementation-delay clock %ds, deficit-%s) — SUSTAINED excursion past the clock: absorption, not a recoverable dip; MemAvailable now %dMB", dwell, eff, lbl, nowmb
      exit 0
    }
    printf "excursion|MemAvailable below barrier %ds < clock %ds (deficit-%s) — recoverable dip, NOT ruin; MemAvailable now %dMB", dwell, eff, lbl, nowmb
    exit 2
  }' "$1"
}

# node_drawdown_classify — LITERATURE (live review, antifragility/convexity/RUIN theory, Taleb area;
# angle = a recent result, 2026-08-18 WebSearch). THE GENERALIZED DRAWDOWN PROCESS: in classical ruin —
# and in our own node_dwell_classify above — the ruin level is a CONSTANT. The generalized-drawdown
# formulation replaces it with a level that is a FUNCTION of the process's own RUNNING MAXIMUM
# (high-water mark): ruin is the surplus falling a distance below the peak it has itself reached, so the
# classical fixed barrier is merely the special case where that function is constant. Draw-down PARISIAN
# ruin is the composition of the two: continuously below the DYNAMIC drawdown level for the whole
# implementation delay.
#   Cite (definition): Wang & Zhou, "Draw-down Parisian ruin for spectrally negative Lévy processes",
#   arXiv:1904.03286 / Adv. Appl. Probab. 52(4), 2020 — "draw-down Parisian ruin occurs when the surplus
#   process has continuously stayed below the dynamic draw-down level for a fixed amount of time".
#   Cite (the RECENT result, 2023-2026, and the reason this area is LIVE): Shu Li & Zijia Wang, "Last
#   passage times for generalized drawdown processes with applications", Scandinavian Actuarial Journal
#   2025(1):25-50 (Jan 2025) — the generalized drawdown "includes not only the ruin event and classical
#   drawdown as special cases"; the paper derives the joint law of the DURATION of the drawdown and the
#   surplus level at killing, i.e. duration and depth as one object, which is exactly the pair this
#   classifier reports. Surfaced by WebSearch 2026-08-18.
# THE GAP IT CLOSES — MEASURED HERE, and it is not theoretical. node_dwell_classify's barrier is
# NODE_MEM_PCT% of MemTotal: on mesh-home 10% of 31.27 GiB = 3.13 GiB. Against the LONG history actually
# on disk (n=64, ~2.1h), MemAvailable's running maximum is 23.34 GiB — so that fixed barrier sits 86.6%
# BELOW the peak the node actually operates at, while the deepest excursion the window contains is 34.0%
# below peak (a single sample, 15.40 GiB, recovered on the next). 0 of 64 samples were below the fixed
# barrier. The Parisian axis exists to tell a survivable dip from an absorption, and it is calibrated so
# that it can only speak once MemAvailable has fallen by seven eighths — i.e. it first becomes reachable
# at the point where the node is already dying. It is not that it "can never fire" (a real OOM slide
# reaches it): it is that it cannot see the excursions it was built to classify. Same family as the
# thermal bands calibrated to a dead regime — a constant outliving the regime it was chosen in.
# WHY BOTH BARRIERS, NOT A REPLACEMENT. A drawdown level tracks the peak WITHIN ITS WINDOW, so a decline
# slower than the window drags the peak down with it and the drawdown axis goes blind to the slow slide —
# that is the known weakness of every drawdown measure, and it is precisely what an absolute floor sees.
# They fail in opposite directions, so the effective barrier is their MAX and the reading NAMES which one
# binds (by=drawdown|absolute|equal). Neither is dropped and the fold is never silent about its winner.
# REPORT-ONLY, same posture as its siblings: no kill, no defer, no board post.
# EXIT: 0 ruin (sustained past the clock) | 2 excursion (below, still inside the grace clock) | 1 clean
# (latest at/above the effective barrier) | 3 n/a — too little history for a peak. n/a is NEVER clean:
# a running maximum computed off 2 samples is not a high-water mark, and reporting it as "no drawdown"
# would be a fabricated calm.
node_drawdown_classify() { # $1="v0..vn" long series (kB, oldest→newest) $2=abs_barrier_kb $3=interval_s $4=base_clock_s $5=dd_pct $6=min_n
  awk -v AB="${2:-0}" -v ivl="${3:-120}" -v d0="${4:-300}" -v ddp="${5:-25}" -v minn="${6:-8}" 'BEGIN{
    n=split(ARGV[1], a, /[ \t\n]+/)
    m=0; for(i=1;i<=n;i++){ if(a[i]!=""){ m++; w[m]=a[i]+0 } }
    if (m < minn || ddp <= 0 || ddp >= 100) exit 3          # no peak / nonsense pct → honest n/a, never clean
    pk=w[1]; for(i=2;i<=m;i++) if(w[i]>pk) pk=w[i]          # running maximum = the high-water mark
    if (pk <= 0) exit 3
    xi = pk * (100-ddp) / 100                               # the generalized-drawdown level ξ(peak)
    B  = (xi > AB) ? xi : AB                                # fold: below EITHER is ruin → the binding one is the max
    by = (xi > AB) ? "drawdown" : ((AB > xi) ? "absolute" : "equal")
    run=0; mn=w[m]
    for (i=m; i>=1; i--) { if (w[i] < B) { run++; if (w[i] < mn) mn=w[i] } else break }   # Parisian reset on recovery
    ddnow = 100*(pk-w[m])/pk                                # depth: current drawdown from peak, %
    cov = sprintf("peak %dMB over n=%d (~%dm window), ξ=peak-%d%%=%dMB, abs=%dMB, binding=%s", int(pk/1024), m, int(m*ivl/60), ddp, int(xi/1024), int(AB/1024), by)
    if (run == 0) { printf "clean|no drawdown excursion — MemAvailable %dMB is %.1f%% below peak, effective barrier not crossed; %s", int(w[m]/1024), ddnow, cov; exit 1 }
    dwell = run * ivl
    deep  = (mn < pk*(100-2*ddp)/100)                       # deficit-dependent delay: twice the drawdown depth → half the grace
    eff   = deep ? int(d0/2) : d0
    lbl   = deep ? "deep" : "shallow"
    mxdd  = 100*(pk-mn)/pk
    if (run >= 2 && dwell >= eff) {
      printf "ruin|draw-down Parisian ruin: MemAvailable has stayed below the drawdown level for %ds (clock %ds, deficit-%s) — deepest %.1f%% below peak, now %.1f%% below peak; SUSTAINED, not a recoverable dip; %s", dwell, eff, lbl, mxdd, ddnow, cov
      exit 0
    }
    printf "excursion|below the drawdown level %ds < clock %ds (deficit-%s) — deepest %.1f%% below peak, now %.1f%% below peak; recoverable dip, NOT ruin; %s", dwell, eff, lbl, mxdd, ddnow, cov
    exit 2
  }' "$1"
}

# node_omega_classify — LITERATURE (live review, antifragility/convexity/RUIN theory, Taleb area;
# angle = an OPERATIONAL mechanism, 2026-08-20 WebSearch). THE OMEGA MODEL (ω-killing / bankruptcy-rate
# function). Classical ruin kills at the first instant the surplus crosses the barrier. Parisian ruin
# (node_dwell_classify) kills only after a CONTINUOUS excursion outlasts a grace clock — and its clock
# RESETS to zero the moment the process recovers. The Omega model replaces both with an ACCUMULATED
# HAZARD: the process may keep operating below the barrier, but while it is down it accrues bankruptcy
# intensity at a rate ω(x) that depends on HOW DEEP it is, and death comes when the accumulated intensity
# exhausts an independent exponential clock:
#       τ_bankruptcy = inf{ t>0 : ∫₀ᵗ ω(U_s) ds > e₁ },   e₁ ~ Exp(1),  ω(x)=0 for x above the barrier.
# The integral runs over the WHOLE path. It never resets on recovery — time above the barrier simply adds
# nothing — so what kills is the TOTAL depth-weighted OCCUPATION TIME IN THE RED, summed over ALL
# excursions, however many times the process climbs out in between.
#   Cite (the model, and its name): H.U. Gerber, E.S.W. Shiu & H. Yang, "The Omega model: from bankruptcy
#   to occupation times in the red", European Actuarial Journal 2(2):259-272, 2012 — "we distinguish
#   between ruin (negative surplus) and bankruptcy (going out of business) … the probability of bankruptcy
#   is quantified by a bankruptcy rate function ω(x), where x is the value of the negative surplus".
#   Cite (the area is LIVE, and it is the LEVEL-DEPENDENT ω that is being worked on right now):
#   D. Mata & J.-F. Renaud, "Optimality of a barrier strategy in a spectrally negative Lévy model with a
#   level-dependent intensity of bankruptcy" (arXiv:2409.13849, rev. 10 Jul 2026) — "the process is allowed
#   to spend time under the critical level but is then subject to a level-dependent intensity of
#   bankruptcy"; and A. Bodnariu, N. Engler & N. Rodosthenous, "Outrunning the Omega Clock: A Singular
#   Control Problem for Dividend Optimisation with Ruin and Time-in-Distress Default" (arXiv:2601.21705,
#   30 Jan 2026). Surfaced by WebSearch 2026-08-20.
# THE GAP IT CLOSES — HERE, and it is a SHAPE THIS MESH ALREADY KNOWS. Every ruin axis in this guard is
# CONTIGUITY-GATED and DEPTH-BLIND once it has crossed. node_dwell_classify and node_drawdown_classify
# both count only the TRAILING RUN below the barrier and break on the first sample at or above it; both
# then treat every below-barrier sample as one unit of the same clock (depth enters only as the coarse
# deep/shallow halving). So a SAWTOOTH — down, up one sample, down again, forever — resets their clock on
# every tooth and reads CLEAN no matter how much of the window is spent in the red. That is the mesh's own
# "n-consecutive debounce has an unacceptable sequence": a persistence gate keyed on a RUN is defeated by
# an interleaving that never lets the run start. Death by a thousand cuts is exactly the fault the Omega
# model was written for, and this guard had no axis that could see it. Second, depth: Parisian says a
# barely-below dip and a near-zero collapse are the same tick of the same clock; ω makes the rate a
# CONVEX function of the deficit, which is the convexity the antifragility program actually asks for —
# twice as deep is 2^p times as lethal, not twice as long.
# CALIBRATION — anchored to its own sibling, so the two axes are commensurable and the anchor is NAMED.
# ω is scale-free in the deficit fraction f = (B-U)/B, referred to a reference depth FREF: ω = (f/FREF)^p
# per reference clock d0. At f = FREF sustained CONTINUOUSLY, hazard accrues at exactly one clock per d0 —
# i.e. Omega and Parisian fire together on the excursion Parisian was built for, and diverge only where
# Parisian is structurally blind (intermittent, or deeper/shallower than the reference). Defaults FREF=0.5
# (the same half-barrier depth the siblings call "deep"), p=2 (convex), d0=RG_DWELL_CLOCK_S.
# H is a hazard over the OBSERVED WINDOW only (LONG_KEEP × interval, ~2.1h here) — never "since boot" —
# and it is a rectangle-rule quadrature at the sampling interval, so an excursion shorter than one
# interval is invisible to it exactly as it is to every other axis here. The reading PUBLISHES the window
# and the quadrature so the narrow claim cannot be read as the wide one.
# BARRIER: the same fold as node_drawdown_classify — max(generalized-drawdown level ξ(peak), absolute
# barrier) — and it NAMES the binding one. Reusing the fold is not decoration: against the fixed 10%-of-
# MemTotal barrier alone this axis would inherit the measured blindness of that constant (86.6% below this
# node's operating peak) and could only speak once the node was already dying.
# REPORT-ONLY, same posture as every sibling: no kill, no defer, no board post.
# EXIT: 0 ruin (H ≥ 1, the clock's own mean is exhausted) | 2 hazard (H ≥ warn floor, accruing) |
# 1 clean (H below the floor, including H=0 — no time in the red) | 3 n/a (too little history for a
# peak). n/a is NEVER clean.
# DISTINCT: NOT node_dwell/node_drawdown (trailing CONTIGUOUS run vs a clock that resets on recovery;
# this accumulates across ALL excursions and never resets). NOT node_pressure (instantaneous crossing).
# NOT node_tau_eta (time-TO the barrier, forward). NOT node_criticality (variance of the approach).
# See docs/reviews/antifragility-omega-bankruptcy-rate-accumulated-hazard-resource-guard-2026-08-20.md.
node_omega_classify() { # $1="v0..vn" long series (kB, oldest→newest) $2=abs_barrier_kb $3=interval_s $4=ref_clock_s $5=dd_pct $6=min_n $7=p $8=warn_H $9=ref_frac
  awk -v AB="${2:-0}" -v ivl="${3:-120}" -v d0="${4:-300}" -v ddp="${5:-25}" -v minn="${6:-8}" \
      -v P="${7:-2}" -v WARN="${8:-0.35}" -v FREF="${9:-0.5}" 'BEGIN{
    n=split(ARGV[1], a, /[ \t\n]+/)
    m=0; for(i=1;i<=n;i++){ if(a[i]!=""){ m++; w[m]=a[i]+0 } }
    if (m < minn || ddp <= 0 || ddp >= 100 || FREF <= 0 || d0 <= 0) exit 3   # honest n/a, never clean
    pk=w[1]; for(i=2;i<=m;i++) if(w[i]>pk) pk=w[i]
    if (pk <= 0) exit 3
    xi = pk * (100-ddp) / 100
    B  = (xi > AB) ? xi : AB
    by = (xi > AB) ? "drawdown" : ((AB > xi) ? "absolute" : "equal")
    if (B <= 0) exit 3
    H=0; red=0; exc=0; run=0; maxrun=0; prev=0; mn=pk
    for (i=1; i<=m; i++) {
      if (w[i] < B) {
        f = (B - w[i]) / B                       # deficit as a fraction of the barrier
        H += ((f/FREF)^P) * ivl / d0             # ω-killing: accumulated hazard, NEVER reset on recovery
        red++
        if (!prev) exc++                          # a new excursion begins
        run++; if (run > maxrun) maxrun = run
        prev=1
        if (w[i] < mn) mn = w[i]
      } else { run=0; prev=0 }                    # above the barrier contributes 0 hazard — but subtracts none
    }
    pbk  = 100*(1-exp(-H))
    dfr  = 100*(B-mn)/B; if (dfr < 0) dfr = 0
    inv  = (maxrun*ivl < d0) ? ", PARISIAN-INVISIBLE: no single excursion reaches the clock, so dwell/drawdown cannot see this" : ""
    cov  = sprintf("peak %dMB over n=%d (~%dm window, %ds quadrature), xi=peak-%d%%=%dMB, abs=%dMB, binding=%s, omega=(deficit/%.2fB)^%g per %ds", int(pk/1024), m, int(m*ivl/60), ivl, ddp, int(xi/1024), int(AB/1024), by, FREF, P, d0)
    if (red == 0) { printf "clean|no time in the red — H=0.00 accumulated hazard over the window; %s", cov; exit 1 }
    if (H >= 1) {
      printf "ruin|Omega bankruptcy: accumulated hazard H=%.2f >= 1 (P(bankruptcy over this window)=%.0f%%) — %d separate excursion(s), %ds total depth-weighted time in the red, longest single %ds vs clock %ds%s; deepest %.0f%% below the barrier; %s", H, pbk, exc, red*ivl, maxrun*ivl, d0, inv, dfr, cov
      exit 0
    }
    if (H >= WARN) {
      printf "hazard|accruing: H=%.2f (P=%.0f%%, floor %.2f) over %d excursion(s), %ds in the red, longest single %ds%s; deepest %.0f%% below the barrier; %s", H, pbk, WARN, exc, red*ivl, maxrun*ivl, inv, dfr, cov
      exit 2
    }
    printf "clean|H=%.2f below the %.2f floor — %d excursion(s), %ds in the red, deepest %.0f%% below the barrier; %s", H, WARN, exc, red*ivl, dfr, cov
    exit 1
  }' "$1"
}

# node_recovery_curvature — HELD design, NOT wired (comment-only, 0 behavior change). LITERATURE (live
# review, antifragility/convexity, Taleb area; angle = a CRITIQUE/failure-mode, 2026-07-31 WebSearch).
# BOUNDED ANTIFRAGILITY — the convex→CONCAVE INFLECTION ("antifragility up to a point"). The failure mode
# of the whole convexity program: a system's response to a stressor is antifragile (locally CONVEX) only
# near the FLOOR; a smooth response with a CEILING must turn CONCAVE as it approaches the ceiling, so a
# hormetic/biphasic response is convex-then-concave with an INFLECTION — gains from small/medium doses,
# COLLAPSE from large ones. A convexity/robustness verdict measured at LOW magnitude therefore does NOT
# certify convexity at HIGH magnitude; extrapolating it past the inflection walks the system into the
# concave/ruin regime believing it is still antifragile.
#   Cite: N.N. Taleb & collaborators, "(Anti)Fragility and Convex Responses in Medicine" / "Working With
#   Convex Responses: Antifragility from Finance to Oncology", Entropy 25(2):343, 2023 (arXiv:1808.00065)
#   — "every relatively smooth dose-response with a ceiling has to be concave while approaching the ceiling"
#   + hormesis biphasic (high dose overwhelms repair → damage not enhancement). Surfaced by WebSearch
#   "bounded antifragility hormesis dose-response ceiling", 2026-07-31.
# THE GAP — MESH-WIDE. The mesh embodies only the LOWER hormesis threshold: mesh-chaos's dose-concentration
# block (scripts/mesh-chaos ~L400) says "a convex response is exercised only ABOVE a threshold → CONCENTRATE
# few large doses". It has NO axis for the UPPER inflection where that same convex response turns concave.
# So the two consumers of a locally-measured convexity verdict are both blind to the ceiling: mesh-chaos's
# HELD escalating-magnitude/dose-concentration tier (its stated prerequisite "confirm recovery-capacity is
# convex" is measured ONCE at low dose — insufficient: convex@low ≠ convex@high), and mesh-convexity's
# global CONVEX/ROBUST verdict (a single Jensen gap over the whole series cannot say the response is convex
# to small deviations but concave to large ones). This axis is the missing UPPER companion to that lower
# floor — the empirical "point" in "antifragile up to a point".
# THE CONCRETE AXIS (HERE, scripts/mesh-resource-guard, over the SAME accel_series). Read the CURVATURE of
# the RECOVERY LEG — the ASCENT after the last trough, the second-derivative of the recovery response:
#   steady/growing positive deltas → CONVEX bounce = robust (the node is antifragile to this dip);
#   DECELERATING positive deltas   → CONCAVE stall = fragile — the bounce is dying before it completes the
#                                    climb back, the recovery-capacity ceiling has been exceeded, at risk of
#                                    re-absorption. This is the local, non-parametric read of the inflection.
#   DISTINCT from every existing axis, which all read the DESCENT or the LEVEL: node_pressure (level),
#   node_accel_classify (is the DROP accelerating — the descent's 2nd derivative), node_tau_eta (time-TO
#   barrier, forward), node_dwell_classify (time-SINCE crossing, the Parisian dwell). NONE reads the ASCENT
#   (post-trough recovery leg) curvature. Descent-accelerating ("falling faster") ≠ recovery-decelerating
#   ("rising slower / can't finish the bounce") — opposite legs, distinct fragilities.
# WHY HELD (the honest blocker — never ship a data-starved organ; "declaring an organ before arming it",
# "a signal from too-short a window rots"). The retained window is ACCEL_KEEP=4 samples: a recovery leg
# needs ≥3 ascending points to yield even ONE delta-comparison, so curvature here is fit from n=3 — that is
# NOISE, not signal, and a curvature axis on 4 points would fire on cache churn as readily as on a real
# stall. PREREQUISITE before wiring: either (a) a persistent EXCURSION LEDGER — accumulate (dip-depth,
# recovery-cost) pairs across episodes so the inflection is fit from MANY excursions spanning depths, not
# one noisy triple (this also enables the true depth→cost curvature, the fuller form of the mechanism); or
# (b) a widened dedicated recovery-window (a separate longer history than the 4-sample accel_series, whose
# size is load-bearing for the dwell/accel axes and must not be bent for this). RED-first + a fixture
# battery (a convex-bounce series must read robust; a decelerating-recovery series must read stall; a
# still-descending or fully-recovered series must read clean n/a) lands with the ledger, not before it.
# See docs/reviews/antifragility-bounded-inflection-recovery-curvature-mesh-resource-guard-2026-07-31.md.

# node_criticality_classify — LITERATURE (live review, antifragility/convexity/RUIN theory, Taleb area;
# angle = a known CRITIQUE of the area, 2026-08-15 WebSearch). THE CRITIQUE: the antifragility program
# reads a system's character off its RESPONSE (convexity, tail direction, damage sign) at the operating
# point it happens to occupy — and treats that point as given. Martin, Moran, Panja & Bouchaud,
# "Fragility-Resilience Trade-off and Excess Volatility in Supply Chain Networks" (arXiv:2601.20450,
# 28 Jan 2026, rev 9 Jul 2026) show the point is NOT given: there is a CRITICAL BOUNDARY in the space of
# (shock volatility, buffer/inventory) — above it shocks are absorbed and fluctuations stay mild, below it
# cascading shortage makes system-wide failure inevitable — and because buffers are COSTLY, competitive
# pressure drives the system TOWARD that boundary. Two consequences the mesh had no axis for: (a) a
# "ROBUST" verdict is a statement about a point that is drifting, and (b) NEAR the boundary aggregate
# volatility DIVERGES through network-mediated amplification of purely idiosyncratic shocks, so the
# announcement of the boundary is in the VARIANCE, not in the mean path. (They also show diversification
# shifts the threshold and can remove the fragile regime — the mesh-sensorium --degeneracy direction; not
# taken here, one axis per landing.)
# THE GAP IT CLOSES — HERE. Every node-* axis in this guard reads the MEAN PATH: node_pressure (level),
# node_accel_classify (is the drop accelerating — 2nd derivative of the level), node_tau_eta (time-TO the
# barrier by extrapolating the smoothed rate), node_dwell_classify (time-SINCE crossing). NONE reads the
# FLUCTUATION AMPLITUDE, and none asks whether that amplitude depends on the level. That blindness is not
# academic here: over 31d this guard posted 467 NODE-ACCELERATING lines, every one carrying an
# "ETA-to-zero" (median 220m, min 4m), on a node whose MemAvailable never went below 2508MB. The ETA is an
# honest CONDITIONAL ("at current rate") — but under a high-variance, level-independent regime the
# condition essentially never holds, and nothing in the tool said so.
# THE AXIS: over the LONG buffer history, two numbers.
#   CV  = sd/mean of the buffer — is it fluctuating at all?
#   A   = mean|delta| in the samples BELOW the median level / mean|delta| ABOVE it — does the swing GROW
#         as the buffer falls? A is the non-parametric read of "volatility diverges approaching the
#         boundary"; it needs no distributional assumption and no knowledge of where the boundary is.
#   CV>=floor AND A>=A_HI -> "critical|" (rc 0): the excess-volatility precursor, the distinct alarm.
#   CV>=floor AND A< A_HI -> "volatile|" (rc 2): swings hard, level-independently — no boundary in view,
#                            AND the standing qualification that tau's drift extrapolation does not apply.
#   CV< floor / too few samples -> clean (rc 1): steady buffer, or honest n/a. Never fabricate a verdict.
# MEASURED before wiring (6 days of unbiased 10-min `sar -r` kbavail, n=299, 291 adjacent pairs, this node):
# mean 18.09GiB, sd 3.96GiB, CV 0.219 — and A = 1.023 (median split; 0.92 median-of-deltas, 0.62 bottom-vs-
# top quartile). So: real volatility, NO level dependence -> VOLATILE-STABLE. The honest negative is what
# validates the axis is not a rubber stamp, and it is exactly the qualification the 467 ETAs needed.
# REPORT-ONLY / visibility (same posture as NODE-ACCELERATING and NODE-DWELL): it does not kill, defer or
# board-post. DISTINCT: NOT node_accel (the drop's acceleration is a mean-path 2nd derivative; this is the
# amplitude of the fluctuation about the path). NOT node_tau_eta (this QUALIFIES tau, it does not replace
# it). NOT node_dwell (below-barrier persistence). NOT mesh-convexity (Jensen gap of a distribution's shape;
# this is the level-DEPENDENCE of dispersion in a time series). NOT the CSD/thermal lane
# ([[csd-scoped-to-thermal-not-fused-viability]]) — that is autocorrelation-at-lag-1 on a thermal series.
node_criticality_classify() { # $1="v0 v1 ... vn" (kB, oldest->newest)  $2=min_n  $3=cv_floor  $4=a_hi
  awk -v MINN="${2:-24}" -v CVF="${3:-0.05}" -v AHI="${4:-1.50}" 'BEGIN{
    n=split(ARGV[1], a, /[ \t\n]+/)
    m=0; for(i=1;i<=n;i++){ if(a[i]!=""){ m++; w[m]=a[i]+0 } }
    if (m < MINN) exit 1                        # too few samples -> honest n/a, never a fabricated verdict
    s=0; for(i=1;i<=m;i++) s+=w[i]; mean=s/m
    if (mean <= 0) exit 1
    q=0; for(i=1;i<=m;i++) q+=(w[i]-mean)*(w[i]-mean); cv=sqrt(q/m)/mean
    if (cv < CVF) exit 1                        # steady buffer: no dispersion to attribute to a level
    # adjacent-pair swing and the level it happened at
    k=0; for(i=2;i<=m;i++){ k++; d[k]=(w[i]>w[i-1])?w[i]-w[i-1]:w[i-1]-w[i]; lv[k]=(w[i]+w[i-1])/2 }
    if (k < 4) exit 1
    for(i=1;i<=k;i++) sl[i]=lv[i]               # insertion sort (k<=63, cost irrelevant) -> median level
    for(i=2;i<=k;i++){ v=sl[i]; j=i-1; while(j>=1 && sl[j]>v){ sl[j+1]=sl[j]; j-- } sl[j+1]=v }
    med = (k%2) ? sl[int(k/2)+1] : (sl[k/2]+sl[k/2+1])/2
    nl=0; sll=0; nh=0; shh=0
    for(i=1;i<=k;i++){ if (lv[i] < med) { nl++; sll+=d[i] } else { nh++; shh+=d[i] } }
    if (nl==0 || nh==0) exit 1                  # degenerate split (all levels equal) -> nothing to compare
    ml=sll/nl; mh=shh/nh
    if (mh <= 0) exit 1                         # no swing in the high half -> ratio undefined, stay silent
    A = ml/mh
    if (A >= AHI) {
      printf "critical|MemAvailable swing GROWS as the buffer falls (A=%.2f >= %.2f: mean swing %dMB below the median level vs %dMB above it; CV=%.2f over %d samples) — excess-volatility precursor: the operating point is near a criticality boundary, where variance diverges and the mean path stops predicting", A, AHI, int(ml/1024), int(mh/1024), cv, m
      exit 0
    }
    printf "volatile|MemAvailable swings hard but LEVEL-INDEPENDENTLY (A=%.2f < %.2f: mean swing %dMB below the median level vs %dMB above it; CV=%.2f over %d samples) — no criticality boundary in view; any tau ETA above extrapolates a drift this regime does not have, so it is a conditional rate, not a forecast", A, AHI, int(ml/1024), int(mh/1024), cv, m
    exit 2
  }' "$1"
}

# Append this pass MemAvailable to the rolling history, trim to keep N, echo nothing (--alert only).
accel_push() { # $1 memavail_kb  $2 histfile  $3 keep
  local kb="$1" hf="$2" keep="$3" tmp
  echo "$kb" >> "$hf"
  tmp="$(tail -n "$keep" "$hf" 2>/dev/null)"; printf '%s\n' "$tmp" > "$hf"
}
# The `2>/dev/null` guards tr's OWN stderr — it does NOT silence a FAILED REDIRECT, which bash reports
# itself ("No such file or directory") before tr ever runs. On a node whose history file does not exist
# yet (first pass after deploy/reboot) that error lands in --status output. Test the file first.
accel_series() { [ -r "$ACCEL_HIST" ] || return 0; tr '\n' ' ' < "$ACCEL_HIST" 2>/dev/null; }  # retained series, oldest→newest
long_series()  { [ -r "$LONG_HIST"  ] || return 0; tr '\n' ' ' < "$LONG_HIST"  2>/dev/null; }  # LONG retained series (criticality axis only)

# resource_state_label <runaway> <elevated> <node_reason> <accel_out> → "OK" or "WARN: reason;..."
# Pure function (no I/O) so --test can exercise every combination directly; --alert writes the
# result to $STATE every run regardless of value (mtime = ran-live, matching the liveness-touch
# convention — a quiet OK stretch must not read as the reflex being dead).
resource_state_label() {
  local runaway="$1" elevated="$2" nodereason="$3" accelout="$4" reasons=""
  [ -n "$runaway" ]    && reasons="${reasons:+$reasons;}RUNAWAY"
  [ -n "$elevated" ]   && reasons="${reasons:+$reasons;}DUAL-ELEVATED"
  [ -n "$nodereason" ] && reasons="${reasons:+$reasons;}NODE-PRESSURE"
  [ -n "$accelout" ]   && reasons="${reasons:+$reasons;}NODE-ACCELERATING"
  if [ -n "$reasons" ]; then echo "WARN: $reasons"; else echo "OK"; fi
}

# --- commands --------------------------------------------------------------
case "${1:-}" in
  --test)
    # tmp fence — task:doctor-test-tmpdir-cleanup-traps. Re-exec the smoke test ONCE under a private
    # TMPDIR and remove it from the PARENT, so the cleanup cannot be lost to the test's own `exit 1`
    # and cannot be clobbered by an EXIT trap the test sets for itself. A nested --test inherits the
    # guard var and skips its own fence (it is already inside one).
    if [ -z "${MESH_TEST_TMPD:-}" ]; then
      MESH_TEST_TMPD="$(mktemp -d)" || { echo "smoke-test: FAIL (tmp fence: mktemp -d)"; exit 1; }
      trap 'rm -rf "$MESH_TEST_TMPD"' EXIT INT HUP TERM
      export MESH_TEST_TMPD TMPDIR="$MESH_TEST_TMPD" TMP="$MESH_TEST_TMPD" TEMP="$MESH_TEST_TMPD"
      _fence_rc=0; "$0" "$@" || _fence_rc=$?; exit "$_fence_rc"
    fi
    command -v ps >/dev/null 2>&1 || { echo "smoke-test: FAIL (ps not found)"; exit 1; }
    command -v renice >/dev/null 2>&1 || { echo "smoke-test: FAIL (renice not found)"; exit 1; }
    [ -r /proc/meminfo ] || { echo "smoke-test: FAIL (/proc/meminfo not readable)"; exit 1; }
    # Dry-run check_mind() with synthetic values — exercise the RUNAWAY/OK boundary logic
    _td="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
    trap 'rm -rf "$_td"' EXIT
    _f=0
    # Override thresholds for test (THRESH_MB=2000, THRESH_CPU=360 on 4-core; ELEV=3/5 of each, same
    # ratio as the real THRESH_MB_ELEV/THRESH_CPU_ELEV derivation)
    _eval_check() { local mb="$1" cpu="$2" exp="$3"; local out
      out="$(THRESH_MB=2000 THRESH_RSS_MB=3072 THRESH_CPU=360 NPROC=4 THRESH_MB_ELEV=1200 THRESH_CPU_ELEV=216 bash -c '
        '"$(declare -f check_mind)"'
        check_mind "test" 12345 "'"$mb"'" "'"$cpu"'"
      ' 2>/dev/null)" || true
      case "$out" in "$exp"*) ;; *)
        echo "  FAIL: check_mind rss=${mb} cpu=${cpu}%: expected ${exp}, got: ${out:0:80}"; _f=1;;
      esac
    }
    _eval_check 1000 10   "OK test pid=12345"       || true
    _eval_check 4000 10   "RUNAWAY test"             || true
    _eval_check 100  400  "RUNAWAY test"             || true
    _eval_check 2500 10   "RUNAWAY test"             || true
    _eval_check 1500 200  "OK test pid=12345"        || true
    # DUAL-ELEVATED boundary (soc-multicriticality): both axes over their (lower) elevated line,
    # neither over its RUNAWAY line — must be a distinct tier, not OK and not RUNAWAY.
    _eval_check 1500 250  "DUAL-ELEVATED test"        || true
    # only ONE axis elevated → still OK (the joint check requires BOTH, not either)
    _eval_check 1300 100  "OK test pid=12345"        || true
    _eval_check 500  250  "OK test pid=12345"        || true
    [ "$_f" = 0 ] || { echo "smoke-test: FAIL (check_mind() drifted — boundary logic wrong)"; exit 1; }
    # NODE-PRESSURE classifier (the OOM BEFORE-signal): pure fn, synthetic kB, FIRE vs SILENT contrast.
    # MemTotal 8GiB=8388608kB; 10% mem line = 838860kB; 5% swap line of 4GiB(4194304) = 209715kB.
    _eval_node() { local ma="$1" mt="$2" sf="$3" st="$4" exp="$5" out rc
      out="$(node_pressure_classify "$ma" "$mt" "$sf" "$st" 10 5)"; rc=$?
      if [ "$exp" = FIRE ]; then
        { [ "$rc" = 0 ] && [ -n "$out" ]; } || { echo "  FAIL node-pressure: expected FIRE (ma=$ma mt=$mt sf=$sf st=$st) got rc=$rc '$out'"; _f=1; }
      else
        { [ "$rc" != 0 ] && [ -z "$out" ]; } || { echo "  FAIL node-pressure: expected SILENT (ma=$ma mt=$mt sf=$sf st=$st) got rc=$rc '$out'"; _f=1; }
      fi
    }
    _eval_node 716800  8388608 4194304 4194304 FIRE     # avail 700MB (<10%) — memory-starved
    _eval_node 4194304 8388608 102400  4194304 FIRE     # swap free 100MB of 4GiB (<5%) — the OOM-storm shape (mem looks fine)
    _eval_node 4194304 8388608 4194304 4194304 SILENT   # both healthy
    _eval_node 4194304 8388608 0       0       SILENT   # NO swap configured → swap axis skipped, no div-by-0
    _eval_node 900000  8388608 4194304 4194304 SILENT   # 900MB avail > 838MB line → falsifiability boundary (just above → silent)
    _eval_node 0       0       0       0       SILENT   # MemTotal 0 (unreadable) → safe no-op, never a false alarm
    [ "$_f" = 0 ] || { echo "smoke-test: FAIL (node_pressure_classify() drifted — pressure logic wrong)"; exit 1; }
    # PSI CORROBORATION (chat-review/resguard-nodepressure-psi-corroborate, mirrors mesh-node-health
    # 5e76287): SwapFree-under-threshold alone is noisy (cold evicted pages, no live stall — live:
    # resource-guard.log posted 5 '[swap]' NODE-PRESSURE lines 01:26-03:10Z while independently
    # confirmed PSI-cold the whole window). psi_mem_band thresholds: full>=5.0=SATURATED,
    # some>=10.0=PRESSURED (real stall, unchanged/fire), some>0.5=BUSY, else QUIET (hollow, suppress).
    psi_mem_band 0.00 0.00 | grep -qx QUIET       || { echo "smoke-test: FAIL (psi_mem_band 0.00/0.00 must be QUIET)"; exit 1; }
    psi_mem_band 12.34 0.01 | grep -qx PRESSURED  || { echo "smoke-test: FAIL (psi_mem_band some=12.34 must be PRESSURED)"; exit 1; }
    psi_mem_band 77.00 7.00 | grep -qx SATURATED  || { echo "smoke-test: FAIL (psi_mem_band full=7.00 must be SATURATED)"; exit 1; }
    psi_mem_band 0.60 0.00 | grep -qx BUSY        || { echo "smoke-test: FAIL (psi_mem_band some=0.60 must be BUSY)"; exit 1; }
    [ -z "$(psi_mem_band "" "")" ]                || { echo "smoke-test: FAIL (psi_mem_band with no data must be empty, honest-absent)"; exit 1; }
    # fixture (a): SwapFree 100MB of 4GiB (<5%, would FIRE alone) + psi full_avg10=0.00 (hollow,
    # this node's actual live condition NOW) → MUST NOT fire (suppressed, not merely downgraded-text)
    _pc1="$(node_pressure_classify 4194304 8388608 102400 4194304 10 5 0.00 0.00)"; _pc1rc=$?
    { [ "$_pc1rc" != 0 ] && [ -z "$_pc1" ]; } || { echo "smoke-test: FAIL (swap<5%+psi hollow must be SILENT, got rc=$_pc1rc '$_pc1')"; exit 1; }
    # fixture (b): same SwapFree breach + psi full_avg10=7.00 (>=5, real stall) → unchanged, fires
    # normally (regression guard: corroboration must not also suppress a REAL stall)
    _pc2="$(node_pressure_classify 4194304 8388608 102400 4194304 10 5 0.00 7.00)"; _pc2rc=$?
    { [ "$_pc2rc" = 0 ] && [ "${_pc2%%|*}" = swap ]; } || { echo "smoke-test: FAIL (swap<5%+psi SATURATED must FIRE class=swap, got rc=$_pc2rc '$_pc2')"; exit 1; }
    # fixture (c): same SwapFree breach, PSI args OMITTED (unreadable/absent on this call) → falls
    # back to firing uncorroborated — the pre-existing 6-arg contract every prior caller relies on
    # must be unchanged (this is the same assertion as the FIRE case above the PSI work, re-asserted
    # explicitly here so a future change to the fallback branch can't silently flip it)
    _pc3="$(node_pressure_classify 4194304 8388608 102400 4194304 10 5)"; _pc3rc=$?
    { [ "$_pc3rc" = 0 ] && [ "${_pc3%%|*}" = swap ]; } || { echo "smoke-test: FAIL (swap<5%+PSI absent must fall back to FIRE, got rc=$_pc3rc '$_pc3')"; exit 1; }
    # mem axis is NEVER psi-gated — only the swap axis is corroborated. A mem breach + psi hollow
    # must still fire on "mem".
    _pc4="$(node_pressure_classify 716800 8388608 4194304 4194304 10 5 0.00 0.00)"; _pc4rc=$?
    { [ "$_pc4rc" = 0 ] && [ "${_pc4%%|*}" = mem ]; } || { echo "smoke-test: FAIL (mem axis must fire regardless of psi, got rc=$_pc4rc '$_pc4')"; exit 1; }
    # node_pressure_eval() end-to-end: reads BOTH read_meminfo (MESH_RG_MEMINFO) and PSI
    # (MESH_RG_PSI_MEM_FILE) fixture files, same suppress/fire split as the direct-classify fixtures above.
    _memfx="$_td/meminfo"; _psifx="$_td/psimem"
    printf 'MemTotal:       8388608 kB\nMemAvailable:   4194304 kB\nSwapTotal:      4194304 kB\nSwapFree:        102400 kB\n' > "$_memfx"
    printf 'some avg10=0.00 avg60=0.00 avg300=0.00 total=0\nfull avg10=0.00 avg60=0.00 avg300=0.00 total=0\n' > "$_psifx"
    ( MESH_RG_MEMINFO="$_memfx" MESH_RG_PSI_MEM_FILE="$_psifx" NODE_MEM_PCT=10 NODE_SWAP_PCT=5 node_pressure_eval; [ -z "$NODE_REASON" ] ) \
      || { echo "smoke-test: FAIL (node_pressure_eval end-to-end must suppress on psi-hollow swap breach, NODE_REASON='$NODE_REASON')"; exit 1; }
    printf 'some avg10=0.00 avg60=0.00 avg300=0.00 total=0\nfull avg10=7.00 avg60=5.00 avg300=4.00 total=99\n' > "$_psifx"
    ( MESH_RG_MEMINFO="$_memfx" MESH_RG_PSI_MEM_FILE="$_psifx" NODE_MEM_PCT=10 NODE_SWAP_PCT=5 node_pressure_eval; [ -n "$NODE_REASON" ] ) \
      || { echo "smoke-test: FAIL (node_pressure_eval end-to-end must still fire on a real psi stall, NODE_REASON empty)"; exit 1; }
    # EDGE DEDUPE (chat-review/node-pressure-edge-class-key): the [node-hot] gate keys on the
    # fired-axis CLASS, never the value-carrying reason — live values jitter every pass and a
    # reason-keyed edge re-posted 3× in 9min for ONE sustained episode (2026-07-05 20:45-20:54Z).
    # Two passes, different SwapFree values (139MB vs 97MB), both <5% → SAME class → exactly one post.
    _c1="$(node_pressure_classify 4194304 8388608 142336 4194304 10 5)"  # SwapFree 139MB
    _c2="$(node_pressure_classify 4194304 8388608 99328  4194304 10 5)"  # SwapFree 97MB
    [ "${_c1%%|*}" = swap ] || { echo "smoke-test: FAIL (swap-only fire: class '${_c1%%|*}' != swap)"; exit 1; }
    [ "${_c1%%|*}" = "${_c2%%|*}" ] || { echo "smoke-test: FAIL (class differs across value jitter: '${_c1%%|*}' vs '${_c2%%|*}')"; exit 1; }
    [ "$_c1" != "$_c2" ] || { echo "smoke-test: FAIL (reasons identical — fixture no longer exercises value jitter)"; exit 1; }
    _flag="$_td/node-flag"; _posts=0
    node_edge_should_post "$_flag" "${_c1%%|*}" && _posts=$((_posts+1))
    node_edge_should_post "$_flag" "${_c2%%|*}" && _posts=$((_posts+1))
    [ "$_posts" = 1 ] || { echo "smoke-test: FAIL (edge gate posted $_posts times across one same-class episode, want 1)"; exit 1; }
    # class ESCALATION (swap → mem;swap) is a new state → must re-post
    _c3="$(node_pressure_classify 716800 8388608 99328 4194304 10 5)"    # mem AND swap starved
    [ "${_c3%%|*}" = "mem;swap" ] || { echo "smoke-test: FAIL (dual fire: class '${_c3%%|*}' != mem;swap)"; exit 1; }
    node_edge_should_post "$_flag" "${_c3%%|*}" || { echo "smoke-test: FAIL (class escalation swap→mem;swap did not re-post)"; exit 1; }
    # STICKY UNION (chat-review/resguard-class-flap-union-key): an axis hovering at its threshold
    # oscillates membership (mem;swap↔swap = 3 posts in 4min live 2026-07-06 14:32-36Z). Once an
    # axis fired this episode it stays in the key: de-escalation is silent, re-escalation of an
    # ALREADY-SEEN axis is silent — only a genuinely new axis posts.
    node_edge_should_post "$_flag" swap       && { echo "smoke-test: FAIL (de-escalation mem;swap→swap re-posted — union key not sticky)"; exit 1; }
    node_edge_should_post "$_flag" "mem;swap" && { echo "smoke-test: FAIL (re-escalation to already-seen mem;swap re-posted — oscillation storm back)"; exit 1; }
    # full oscillation fixture from a fresh episode: mem;swap→swap→mem;swap = exactly 1 post
    _oflag="$_td/node-flag-osc"; _oposts=0
    node_edge_should_post "$_oflag" "mem;swap" && _oposts=$((_oposts+1))
    node_edge_should_post "$_oflag" swap       && _oposts=$((_oposts+1))
    node_edge_should_post "$_oflag" "mem;swap" && _oposts=$((_oposts+1))
    [ "$_oposts" = 1 ] || { echo "smoke-test: FAIL (oscillating episode posted $_oposts times, want exactly 1)"; exit 1; }
    # recovery clears the flag → next episode posts again
    rm -f "$_flag"
    node_edge_should_post "$_flag" swap || { echo "smoke-test: FAIL (post-recovery episode did not post)"; exit 1; }
    # Fixture round-trip: read_meminfo parses a synthetic /proc/meminfo, node_pressure_eval fires on it.
    printf 'MemTotal: 8388608 kB\nMemAvailable: 500000 kB\nSwapTotal: 4194304 kB\nSwapFree: 4194304 kB\n' > "$_td/meminfo"
    MESH_RG_MEMINFO="$_td/meminfo" node_pressure_eval
    [ -n "$NODE_REASON" ] || { echo "smoke-test: FAIL (node_pressure_eval did not fire on a starved fixture — read_meminfo/wiring broke)"; exit 1; }
    [ "$NODE_CLASS" = mem ] || { echo "smoke-test: FAIL (eval class split broke: NODE_CLASS='$NODE_CLASS' want mem)"; exit 1; }
    case "$NODE_REASON" in *"|"*) echo "smoke-test: FAIL (class|reason split leaked '|' into NODE_REASON: '$NODE_REASON')"; exit 1;; esac
    # NODE-ACCELERATING: the 2nd-derivative axis. FIRE only on absolute-monotone drops (a genuine
    # accelerating ramp); a false-positive battery guards against asserting acceleration from jitter.
    # SHAPE label (chat-review/resguard-accel-superexp-mislabel): FIRE splits into super-exponential
    # (dragon-king precursor — drop ratio non-decreasing) vs super-linear (drops grow, ratio falls).
    # 3rd _eval_accel arg = expected shape substring; a super-linear case must NEVER carry "super-exponential".
    # floor=153600kB (150MB). Series is MemAvailable kB oldest→newest.
    _eval_accel() { local series="$1" exp="$2" want="${3:-}" out rc
      out="$(node_accel_classify "$series" 153600)"; rc=$?
      if [ "$exp" = FIRE ]; then
        { [ "$rc" = 0 ] && [ -n "$out" ]; } || { echo "  FAIL accel: expected FIRE ($series) got rc=$rc '$out'"; _f=1; return; }
        if [ -n "$want" ]; then case "$out" in *"$want"*) ;; *) echo "  FAIL accel: FIRE ($series) expected shape '$want', got '$out'"; _f=1;; esac; fi
        if [ "$want" = super-linear ]; then case "$out" in *super-exponential*) echo "  FAIL accel: super-linear ($series) mislabeled super-exponential: '$out'"; _f=1;; esac; fi
      else
        { [ "$rc" != 0 ] && [ -z "$out" ]; } || { echo "  FAIL accel: expected SILENT ($series) got rc=$rc '$out'"; _f=1; }
      fi
    }
    _eval_accel "4000000 3800000 3400000 2600000" FIRE super-exponential  # (a) drops 200→400→800MB, ratio 2×→2× → super-exp
    _eval_accel "5000000 4900000 4600000 3600000" FIRE super-exponential  # rising ratio (100→300→1000MB, 3×→3.3×) → super-exp
    _eval_accel "1825672 1818272 1358204 100000"  FIRE super-linear       # (b) drops 7400→460068→1258204kB, ratio 62×→2.7× → super-LINEAR, NOT dragon-king
    _eval_accel "4000000 3800000 3600000 3400000" SILENT  # (c) steady drain (200/200/200) — equal drops, NOT accelerating
    _eval_accel "4000000 3200000 2800000 2600000" SILENT  # decelerating drain (800/400/200) — the opposite
    _eval_accel "2600000 3400000 3800000 4000000" SILENT  # memory FREEING (avail rising) — negative drops
    _eval_accel "4000000 3900000 4000000 3800000" SILENT  # oscillation (100/-100/200) — a negative drop
    _eval_accel "4000000 3950000 3900000 3000000" SILENT  # flat then a lone late spike (50/50/900) — d2≯d1
    _eval_accel "4000000 3999000 3997500 3995000" SILENT  # accelerating (1000/1500/2500) but <150MB floor
    _eval_accel "4000000 3000000 2000000"         SILENT  # only 3 samples → too few for 3 drops
    _eval_accel ""                                SILENT  # empty history → safe no-op
    [ "$_f" = 0 ] || { echo "smoke-test: FAIL (node_accel_classify() drifted — precursor logic wrong)"; exit 1; }
    # node_accel_level_low (chat-review/resguard-accel-no-level-gate): the shape test alone is scale-blind
    # — corroborate with the ABSOLUTE MemAvailable level before it's board-worthy. Regression guard: a real
    # precursor near-empty must still gate TRUE (never suppressed); this node's actual routine condition
    # (13GB free of 15GB, 87%+ free) must gate FALSE (board-noise, not a real precursor).
    node_accel_level_low 500000 8388608    || { echo "smoke-test: FAIL (accel-level: 500MB/8GB should be LOW/board-worthy)"; exit 1; }
    node_accel_level_low 13500000 15728640 && { echo "smoke-test: FAIL (accel-level: 13GB/15GB, 87%+ free, should NOT gate board-worthy)"; exit 1; }
    node_accel_level_low 0 0               && { echo "smoke-test: FAIL (accel-level: MemTotal=0 must safe-no-op false, not fire)"; exit 1; }
    :
    # node_tau_eta (LITERATURE, tau-theory ETA): value/SMOOTHED-rate*interval when the last interval closed
    # the gap; empty/undefined when it didn't (flat, recovering, or too few samples) — τ must never fabricate
    # an ETA when the trend isn't actually declining. SMOOTHED rate = mean per-interval consumption over the
    # window (chat-review/resguard-tau-eta-uses-peak-drop), NOT the single last drop (which the accel gate
    # forces to be the peak → guaranteed most-alarming ETA).
    _eval_tau() { local series="$1" ivl="$2" exp="$3" out rc
      out="$(node_tau_eta "$series" "$ivl")"; rc=$?
      if [ "$exp" = UNDEF ]; then
        { [ "$rc" != 0 ] && [ -z "$out" ]; } || { echo "  FAIL tau: expected UNDEF ($series,$ivl) got rc=$rc '$out'"; _f=1; }
      else
        { [ "$rc" = 0 ] && [ "$out" = "$exp" ]; } || { echo "  FAIL tau: expected $exp ($series,$ivl) got rc=$rc '$out'"; _f=1; }
      fi
    }
    # (c) steady drain: drops 1000000/1000000, mean == last == 1000000; 3000000/1000000*120 = 360s (UNCHANGED,
    #     smoothing a flat rate is a no-op — the regression guard that steady drains read identically)
    _eval_tau "5000000 4000000 3000000" 120 360
    # (a) spiky last drop: series 5000000->4000000->2000000, drops 1000000 then 2000000 (PEAK last). Peak-rate
    #     ETA would be 2000000/2000000*120 = 120s; SMOOTHED mean = (5000000-2000000)/2 = 1500000/int →
    #     2000000/1500000*120 = 160s. Assert 160 (>120 peak-rate ETA) — smoothing lengthens the spike-driven ETA.
    _eval_tau "5000000 4000000 2000000" 120 160
    # decelerating drain: drops 1000 then 500 (last is SMALLER); mean = (2000-500)/2 = 750; 500/750*60 = 40s
    #     (was 60s under last-drop-only) — smoothing pulls toward the sustained earlier rate, still defined
    _eval_tau "2000 1000 500" 60 40
    _eval_tau "3000000 3000000" 120     UNDEF   # (b) flat last interval — gap not closing, tau undefined
    _eval_tau "2000000 3000000" 120     UNDEF   # (b) recovering (avail rising) — last-interval rate<=0, undefined
    _eval_tau "4000000"         120     UNDEF   # single sample — no rate computable
    _eval_tau ""                 120     UNDEF   # empty history — safe no-op
    [ "$_f" = 0 ] || { echo "smoke-test: FAIL (node_tau_eta() drifted — tau-ETA math wrong)"; exit 1; }
    # node_dwell_classify (LITERATURE, Parisian ruin): dwell-since-crossing vs a deficit-dependent grace
    # clock. verdict token = ruin|excursion|clean(empty). barrier=1000kB, ivl=120s, d0=300s throughout.
    # Deep = deepest sample < barrier/2 (500kB) → clock halved to 150s. run≥2 & dwell≥clock → ruin.
    _eval_dwell() { local series="$1" exp="$2" out rc tok
      out="$(node_dwell_classify "$series" 1000 120 300)"; rc=$?
      tok="${out%%|*}"; [ "$rc" = 1 ] && tok=clean
      [ "$tok" = "$exp" ] || { echo "  FAIL dwell: expected $exp ($series) got rc=$rc tok='$tok' ('$out')"; _f=1; }
    }
    _eval_dwell "500 500 2000"  clean       # latest 2000 >= barrier → Parisian clock RESET (recovered) → clean
    _eval_dwell "2000 2000 900" excursion   # run=1 single dip (dwell 120s) → recoverable, NOT ruin
    _eval_dwell "2000 900 900"  excursion   # run=2 shallow, dwell 240s < clock 300s → within grace, not ruin
    _eval_dwell "900 900 900"   ruin        # run=3 shallow, dwell 360s >= clock 300s → SUSTAINED = ruin
    _eval_dwell "2000 400 400"  ruin        # run=2 DEEP (min 400<500), dwell 240s >= halved clock 150s → deficit-dependent ruin
    _eval_dwell ""              clean       # empty history → safe no-op
    _f2=0; node_dwell_classify "900 900 900" 0 120 300 >/dev/null 2>&1; [ $? = 1 ] || _f2=1   # barrier<=0 → no-op, never ruin
    [ "$_f2" = 0 ] || { echo "smoke-test: FAIL (node_dwell_classify must no-op on barrier<=0, not fabricate ruin)"; exit 1; }
    # node_drawdown_classify (LITERATURE, GENERALIZED DRAWDOWN — the ruin level as a function of the
    # running maximum). The load-bearing gate is the BOTH-WAYS control: the same series is driven through
    # the OLD fixed-barrier axis and the NEW one, and they must DISAGREE — otherwise the drawdown level
    # adds nothing and this whole axis is decoration. 12 samples, peak 20000000 kB, tail parked at
    # 14000000 (30% below peak, past ξ=peak-25%) but far ABOVE the absolute barrier 3355443: exactly the
    # regime measured live on mesh-home, where the fixed barrier sits 86.6% below the operating peak.
    _ddser="20000000 20000000 19500000 19000000 18500000 18000000 17000000 16000000 15000000 14500000 14200000 14000000"
    _ddf=0
    _ddout="$(node_drawdown_classify "$_ddser" 3355443 120 300 25 8)"; _ddrc=$?
    [ "$_ddrc" = 0 ] || { echo "  FAIL drawdown: a sustained 30%-below-peak excursion must be ruin (rc 0), got rc=$_ddrc '$_ddout'"; _ddf=1; }
    case "$_ddout" in *binding=drawdown*) ;; *) echo "  FAIL drawdown: the fold must NAME the binding barrier as the drawdown one, got '$_ddout'"; _ddf=1;; esac
    node_dwell_classify "$_ddser" 3355443 120 300 >/dev/null 2>&1
    [ "$?" = 1 ] || { echo "  FAIL drawdown: CONTROL broken — the fixed-barrier axis was supposed to read CLEAN on this series (that disagreement is the whole point of the new axis)"; _ddf=1; }
    # n/a is not clean: a running maximum off too few samples is not a high-water mark.
    node_drawdown_classify "20000000 14000000" 3355443 120 300 25 8 >/dev/null 2>&1
    [ "$?" = 3 ] || { echo "  FAIL drawdown: too-short history must render n/a (rc 3), never clean — a peak off 2 samples is a fabricated calm"; _ddf=1; }
    # a LONE below-peak sample at the tail is a dip, never ruin (Parisian persistence floor) — this is the
    # live 15.40GiB transient in mesh-home's own history, which recovered on the very next sample.
    node_drawdown_classify "20000000 20000000 19000000 19000000 19000000 19000000 19000000 19000000 19000000 14000000" 3355443 120 300 25 8 >/dev/null 2>&1
    [ "$?" = 2 ] || { echo "  FAIL drawdown: a single below-level sample must be an excursion (rc 2), not ruin"; _ddf=1; }
    # …and the leg that actually EXERCISES the run>=2 floor. Above, dwell (1x120s) is short of the 300s
    # clock anyway, so the floor is never consulted and a mutant deleting it SURVIVES (observed). With
    # interval == clock a single below-sample already satisfies dwell>=clock, so only the persistence
    # floor stands between one frame and a ruin verdict.
    node_drawdown_classify "20000000 20000000 19000000 19000000 19000000 19000000 19000000 19000000 19000000 14000000" 3355443 300 300 25 8 >/dev/null 2>&1
    [ "$?" = 2 ] || { echo "  FAIL drawdown: with interval==clock a LONE below-level frame must still be an excursion — the run>=2 persistence floor is not holding"; _ddf=1; }
    # the other fold winner: an absolute barrier ABOVE ξ must bind and be named — proves max(), not a
    # hardcoded preference for the drawdown level (which would go blind to a slide slower than the window).
    _ddout2="$(node_drawdown_classify "$_ddser" 19000000 120 300 25 8)"
    case "$_ddout2" in *binding=absolute*) ;; *) echo "  FAIL drawdown: with abs > ξ the ABSOLUTE barrier must bind and be named, got '$_ddout2'"; _ddf=1;; esac
    # a flat series at its own peak is clean (rc 1) and must say so — not n/a, not ruin.
    node_drawdown_classify "20000000 20000000 20000000 20000000 20000000 20000000 20000000 20000000" 3355443 120 300 25 8 >/dev/null 2>&1
    [ "$?" = 1 ] || { echo "  FAIL drawdown: a flat series at peak must be clean (rc 1)"; _ddf=1; }
    [ "$_ddf" = 0 ] || { echo "smoke-test: FAIL (node_drawdown_classify drifted — generalized-drawdown/fold math wrong)"; exit 1; }
    # node_omega_classify (LITERATURE, THE OMEGA MODEL — bankruptcy rate ω(deficit), accumulated hazard
    # that NEVER resets on recovery). The load-bearing gate is again a BOTH-WAYS CONTROL, and here it is
    # the sawtooth: a series whose every excursion is one sample long, separated by a recovery, so both
    # Parisian siblings reset their clock on every tooth and read CLEAN — while 46% of the window is spent
    # in the red. Params throughout: ivl=120 d0=300 ddp=25 minn=8 p=2 warn=0.35 fref=0.5; peak 20000000kB
    # → ξ=15000000kB binds (abs 3355443 far below). Red samples at 9000000 = deficit fraction 0.4 → each
    # contributes ((0.4/0.5)^2)·120/300 = 0.256 of a clock.
    _omf=0
    _om_h() { node_omega_classify "$1" "${2:-3355443}" 120 300 25 8 2 0.35 0.5 | sed -nE 's/.*H=([0-9.]+).*/\1/p' | head -1; }
    _omsaw="20000000 9000000 20000000 9000000 20000000 9000000 20000000 9000000 20000000 9000000 20000000 9000000 20000000"
    _omout="$(node_omega_classify "$_omsaw" 3355443 120 300 25 8 2 0.35 0.5)"; _omrc=$?
    [ "$_omrc" = 0 ] || { echo "  FAIL omega: 6 depth-0.4 excursions accumulate H=1.54 — must be ruin (rc 0), got rc=$_omrc '$_omout'"; _omf=1; }
    case "$_omout" in *PARISIAN-INVISIBLE*) ;; *) echo "  FAIL omega: a sawtooth whose longest run (120s) is under the clock (300s) must be NAMED Parisian-invisible, got '$_omout'"; _omf=1;; esac
    # CONTROL — the whole point of the axis: BOTH contiguity-gated siblings must read CLEAN on this series.
    node_drawdown_classify "$_omsaw" 3355443 120 300 25 8 >/dev/null 2>&1
    [ "$?" = 1 ] || { echo "  FAIL omega: CONTROL broken — node_drawdown_classify was supposed to read CLEAN on the sawtooth (its clock resets on every tooth); that disagreement IS this axis"; _omf=1; }
    node_dwell_classify "$_omsaw" 3355443 120 300 >/dev/null 2>&1
    [ "$?" = 1 ] || { echo "  FAIL omega: CONTROL broken — node_dwell_classify was supposed to read CLEAN on the sawtooth"; _omf=1; }
    # CONTIGUITY-INDEPENDENCE: ω integrates OCCUPATION TIME, so the same 6 red samples in one contiguous
    # block must accumulate the SAME hazard as the sawtooth. A mutant that keeps only the trailing run
    # (i.e. re-introduces the Parisian gate this axis exists to remove) splits these two apart.
    _omblk="20000000 20000000 20000000 20000000 20000000 20000000 20000000 9000000 9000000 9000000 9000000 9000000 9000000"
    _hs="$(_om_h "$_omsaw")"; _hb="$(_om_h "$_omblk")"
    awk -v a="$_hs" -v b="$_hb" 'BEGIN{ exit !(a>0 && b>0 && (a-b)<0.005 && (b-a)<0.005) }' \
      || { echo "  FAIL omega: contiguity must NOT change the accumulated hazard — sawtooth H=$_hs vs contiguous H=$_hb"; _omf=1; }
    # …and the contiguous twin must ALSO be visible to the Parisian sibling (720s run >= 300s clock): the
    # two axes agree where dwell can see, and diverge only where it is blind. Without this leg the axis
    # could be a sawtooth-only gimmick rather than a superset.
    node_drawdown_classify "$_omblk" 3355443 120 300 25 8 >/dev/null 2>&1
    [ "$?" = 0 ] || { echo "  FAIL omega: the CONTIGUOUS twin must be ruin under drawdown too — the axes are supposed to agree where Parisian can see"; _omf=1; }
    case "$(node_omega_classify "$_omblk" 3355443 120 300 25 8 2 0.35 0.5)" in *PARISIAN-INVISIBLE*) echo "  FAIL omega: a 720s contiguous run is NOT Parisian-invisible — the marker must not be unconditional"; _omf=1;; esac
    # DEPTH IS LOAD-BEARING (Parisian is depth-blind; ω is not): the SAME 6 excursions and the SAME 720s in
    # the red, only shallower (deficit 0.133), must fall below the floor. Kills a mutant that counts red
    # samples instead of weighting them.
    _omshal="20000000 13000000 20000000 13000000 20000000 13000000 20000000 13000000 20000000 13000000 20000000 13000000 20000000"
    node_omega_classify "$_omshal" 3355443 120 300 25 8 2 0.35 0.5 >/dev/null 2>&1
    [ "$?" = 1 ] || { echo "  FAIL omega: same red TIME at a third of the depth must read clean — the deficit weighting is not load-bearing"; _omf=1; }
    # THE CONVEXITY EXPONENT IS REAL: twice the deficit must be 2^p = 4x the hazard, not 2x. A mutant
    # setting p=1 (linear ω) survives every verdict gate above and dies here.
    _omp1="20000000 12000000 20000000 12000000 20000000 12000000 20000000 12000000 20000000"   # deficit 0.2
    _omp2="20000000 9000000 20000000 9000000 20000000 9000000 20000000 9000000 20000000"       # deficit 0.4
    _h1="$(_om_h "$_omp1")"; _h2="$(_om_h "$_omp2")"
    awk -v a="$_h1" -v b="$_h2" 'BEGIN{ r=(a>0)?b/a:0; exit !(r>3.8 && r<4.2) }' \
      || { echo "  FAIL omega: doubling the deficit must quadruple the hazard at p=2 — got H=$_h1 vs H=$_h2"; _omf=1; }
    # the middle tier exists: H in [warn,1) is hazard (rc 2), neither clean nor ruin.
    node_omega_classify "20000000 20000000 20000000 20000000 20000000 9000000 20000000 9000000 20000000" 3355443 120 300 25 8 2 0.35 0.5 >/dev/null 2>&1
    [ "$?" = 2 ] || { echo "  FAIL omega: 2 excursions (H=0.51) must be the accruing 'hazard' tier (rc 2)"; _omf=1; }
    # no time in the red → clean (rc 1) and it must SAY H=0, not go n/a.
    _omflat="$(node_omega_classify "20000000 20000000 20000000 20000000 20000000 20000000 20000000 20000000" 3355443 120 300 25 8 2 0.35 0.5)"
    [ "$?" = 1 ] || { echo "  FAIL omega: a flat series at peak must be clean (rc 1)"; _omf=1; }
    case "$_omflat" in *"H=0.00"*) ;; *) echo "  FAIL omega: a clean window must publish H=0.00, not stay silent about the hazard; got '$_omflat'"; _omf=1;; esac
    # n/a is NOT clean: no peak off 2 samples, and no occupation estimate either.
    node_omega_classify "20000000 9000000" 3355443 120 300 25 8 2 0.35 0.5 >/dev/null 2>&1
    [ "$?" = 3 ] || { echo "  FAIL omega: too-short history must render n/a (rc 3), never clean"; _omf=1; }
    # NO PERSISTENCE FLOOR, BY DESIGN — a run-length floor would re-impose the contiguity gate this axis
    # removes. The honest consequence is that a LONE sample can reach H>=1, but only at deficit >=0.79
    # (defaults), i.e. a collapse node_pressure's own absolute barrier is already screaming about. The live
    # mesh-home transient (one sample 34% below peak = deficit 0.12) is nowhere near it — assert that.
    node_omega_classify "20000000 20000000 20000000 20000000 20000000 20000000 20000000 13200000" 3355443 120 300 25 8 2 0.35 0.5 >/dev/null 2>&1
    [ "$?" = 1 ] || { echo "  FAIL omega: the live single-sample 34%-below-peak transient must stay clean — no floor means the weighting must carry it"; _omf=1; }
    # the barrier fold is the sibling's, and it must NAME its winner: abs above ξ binds absolute.
    case "$(node_omega_classify "$_omsaw" 19000000 120 300 25 8 2 0.35 0.5)" in *binding=absolute*) ;; *) echo "  FAIL omega: with abs > ξ the ABSOLUTE barrier must bind and be named"; _omf=1;; esac
    [ "$_omf" = 0 ] || { echo "smoke-test: FAIL (node_omega_classify drifted — Omega bankruptcy-rate/accumulated-hazard math wrong)"; exit 1; }
    [ "$_f" = 0 ] || { echo "smoke-test: FAIL (node_dwell_classify() drifted — Parisian dwell/deficit math wrong)"; exit 1; }
    # node_criticality_classify (LITERATURE, Bouchaud excess-volatility precursor): does the SWING grow as
    # the buffer falls? Series are generated (>=24 samples needed) so the fixture states the SHAPE, not 24
    # hand-typed numbers. hi/lo = the two level regimes, amp_hi/amp_lo = the swing within each.
    _crit_series() { # $1 hi_kb  $2 amp_hi_kb  $3 lo_kb  $4 amp_lo_kb  $5 n
      awk -v hi="$1" -v ah="$2" -v lo="$3" -v al="$4" -v n="$5" 'BEGIN{
        for(i=0;i<n;i++){ s=(i%2)?1:-1
          printf "%d%s", (i<n/2 ? hi+s*ah : lo+s*al), (i==n-1?"":" ") }
      }'
    }
    _eval_crit() { local series="$1" exp="$2" tag="$3" out rc tok
      out="$(node_criticality_classify "$series" 24 0.05 1.50)"; rc=$?
      tok="${out%%|*}"; [ "$rc" = 1 ] && tok=clean
      [ "$tok" = "$exp" ] || { echo "  FAIL criticality[$tag]: expected $exp got rc=$rc tok='$tok' ('${out:0:110}')"; _f=1; }
    }
    # swing 1500MB in the low regime vs 100MB in the high regime → amplitude grows as buffer falls
    _eval_crit "$(_crit_series 24000000 100000 16000000 1500000 32)" critical  "growing-swing"
    # same swing in both regimes → hard volatility, no level dependence (this node's measured shape)
    _eval_crit "$(_crit_series 24000000 800000  16000000 800000  32)" volatile  "level-independent"
    # buffer barely moves (CV≈0.003 < floor) → no dispersion to attribute; must stay SILENT, not call A.
    # The two regimes DIFFER (20050 vs 19950 MB) on purpose: an all-equal series is rejected by the
    # degenerate-split guard instead, so it would exercise the wrong branch and the CV floor could be
    # deleted with this case still green (measured — the first version of this fixture did exactly that).
    _eval_crit "$(_crit_series 20050000 25000   19950000 25000   32)" clean     "calm-below-cv-floor"
    # every adjacent level identical → nothing to split on; the OTHER silent path, asserted separately.
    # Amplitude is LARGE here (CV=0.10, well over the floor) so this case reaches the degenerate-split
    # guard instead of being swallowed by the CV floor — the mirror of the trap noted just above.
    _eval_crit "$(_crit_series 20000000 2000000 20000000 2000000 32)" clean     "degenerate-level-split"
    # 12 samples < MIN_N=24 → honest n/a even though the shape is the CRITICAL one (data, not verdict, is missing)
    _eval_crit "$(_crit_series 24000000 100000 16000000 1500000 12)" clean     "too-few-samples"
    _eval_crit "" clean "empty-history"
    [ "$_f" = 0 ] || { echo "smoke-test: FAIL (node_criticality_classify() drifted — excess-volatility precursor math wrong)"; exit 1; }
    # the LONG history is a SEPARATE file from the accel series (bending accel_series would break dwell/tau)
    _lh="$_td/memhist-long"; : > "$_lh"
    for _v in 1 2 3 4 5 6; do accel_push "$_v" "$_lh" 5; done
    [ "$(wc -l < "$_lh")" = 5 ] && [ "$(head -1 "$_lh")" = 2 ] \
      || { echo "smoke-test: FAIL (long-history push/trim: kept $(wc -l < "$_lh") lines head '$(head -1 "$_lh")', want 5/2)"; exit 1; }
    # push/trim + edge gate: a sustained ramp posts ONCE; recovery clears; the classify is a pure read.
    _ah="$_td/memhist"; : > "$_ah"
    for _v in 4000000 3800000 3400000 2600000; do accel_push "$_v" "$_ah" 4; done
    [ "$(wc -l < "$_ah")" = 4 ] || { echo "smoke-test: FAIL (accel_push kept $(wc -l < "$_ah") lines, want 4)"; exit 1; }
    accel_push 1600000 "$_ah" 4  # 5th sample → oldest (4000000) trimmed
    [ "$(head -1 "$_ah")" = 3800000 ] || { echo "smoke-test: FAIL (accel_push trim kept '$(head -1 "$_ah")', want 3800000)"; exit 1; }
    _aflag="$_td/accel-flag"; _aposts=0
    node_edge_should_post "$_aflag" accel && _aposts=$((_aposts+1))   # ramp onset → post
    node_edge_should_post "$_aflag" accel && _aposts=$((_aposts+1))   # ramp holding → no re-post
    [ "$_aposts" = 1 ] || { echo "smoke-test: FAIL (accel edge posted $_aposts times over one ramp, want 1)"; exit 1; }
    rm -f "$_aflag"
    node_edge_should_post "$_aflag" accel || { echo "smoke-test: FAIL (post-recovery ramp did not re-post)"; exit 1; }
    # RECOVERY-WITH-MARGIN RE-ARM (chat-review/resguard-episode-rearm-hysteresis): a threshold-HOVERING
    # axis (SwapFree crossing the line every other pass) must be ONE episode = ONE post, not one post per
    # breach. Simulate 6 --alert passes crossing the swap line every other pass → exactly 1 post. Falsify:
    # revert rg_clean_rearm to a bare `rm -f "$FLAG_NODE"` → each clean pass re-arms → 3 posts (test fails).
    RG_REARM_CLEAN=3
    # swap line = 5% of 4GiB = 204MB; 2× line = 409MB. breach=100MB (<line); clean-hovering=300MB
    # (>line, <2×line → NOT a margin recovery → exercises the STREAK path, not the margin shortcut).
    _mi_breach() { printf 'MemTotal: 8388608 kB\nMemAvailable: 4194304 kB\nSwapTotal: 4194304 kB\nSwapFree: 102400 kB\n' > "$_td/rmi"; }
    _mi_clean()  { printf 'MemTotal: 8388608 kB\nMemAvailable: 4194304 kB\nSwapTotal: 4194304 kB\nSwapFree: 307200 kB\n' > "$_td/rmi"; }
    # PSI-corroborated (chat-review/resguard-nodepressure-psi-corroborate): this hovering-episode
    # test is about the EDGE/RE-ARM logic, independent of PSI — stub a real-stall reading (full=7.0
    # >= 5.0 → SATURATED) so the new swap-axis PSI gate never suppresses these breaches out from
    # under this test (this node's OWN live PSI is hollow right now — the exact condition the fix
    # targets — so leaving PSI unstubbed here would silently zero out every "breach" pass below).
    printf 'some avg10=0.00 avg60=0.00 avg300=0.00 total=0\nfull avg10=7.00 avg60=5.00 avg300=4.00 total=99\n' > "$_td/rpsi"
    _rflag="$_td/rearm-flag"; rm -f "$_rflag"; _rposts=0
    _rpass() { # $1 = breach|clean — one simulated --alert node-pressure pass
      if [ "$1" = breach ]; then _mi_breach; else _mi_clean; fi
      MESH_RG_MEMINFO="$_td/rmi" MESH_RG_PSI_MEM_FILE="$_td/rpsi" node_pressure_eval
      if [ -n "$NODE_REASON" ]; then
        rg_breach_reset "$_rflag"
        node_edge_should_post "$_rflag" "$NODE_CLASS" && _rposts=$((_rposts+1))
      else
        rg_clean_rearm "$_rflag" "$(MESH_RG_MEMINFO="$_td/rmi" node_pressure_margin_recovered)"
      fi
      return 0
    }
    for _seq in breach clean breach clean breach clean; do _rpass "$_seq"; done
    [ "$_rposts" = 1 ] || { echo "smoke-test: FAIL (oscillating swap episode posted $_rposts times across 6 passes, want exactly 1 — hovering re-arm regressed to bare rm -f)"; exit 1; }
    # 3+ consecutive clean passes → streak re-arm → the flag clears and a fresh breach posts AGAIN
    _rpass clean; _rpass clean; _rpass clean
    [ -f "$_rflag" ] && { echo "smoke-test: FAIL (flag not cleared after ≥3 consecutive clean passes — re-arm streak broken)"; exit 1; }
    _rpass breach
    [ "$_rposts" = 2 ] || { echo "smoke-test: FAIL (fresh breach after ≥3-clean recovery did not re-post: posts=$_rposts want 2)"; exit 1; }
    # MARGIN recovery: a clean pass well above the line (≥2× threshold) re-arms in ONE pass (no streak wait)
    _rflag2="$_td/rearm-flag2"; rm -f "$_rflag2"
    _mi_breach; MESH_RG_MEMINFO="$_td/rmi" MESH_RG_PSI_MEM_FILE="$_td/rpsi" node_pressure_eval
    rg_breach_reset "$_rflag2"; node_edge_should_post "$_rflag2" "$NODE_CLASS" >/dev/null   # open the episode
    printf 'MemTotal: 8388608 kB\nMemAvailable: 4194304 kB\nSwapTotal: 4194304 kB\nSwapFree: 838860 kB\n' > "$_td/rmi"  # SwapFree 819MB ≥ 2× the 409MB line
    MESH_RG_MEMINFO="$_td/rmi" node_pressure_eval
    [ -z "$NODE_REASON" ] || { echo "smoke-test: FAIL (margin fixture still reads as under pressure)"; exit 1; }
    [ "$(MESH_RG_MEMINFO="$_td/rmi" node_pressure_margin_recovered)" = 1 ] || { echo "smoke-test: FAIL (≥2×-line value not detected as margin-recovered)"; exit 1; }
    rg_clean_rearm "$_rflag2" "$(MESH_RG_MEMINFO="$_td/rmi" node_pressure_margin_recovered)"
    [ -f "$_rflag2" ] && { echo "smoke-test: FAIL (≥2× margin recovery did not re-arm in a single pass)"; exit 1; }
    # breach-interrupts-streak: clean,clean,breach,clean must NOT re-arm (streak resets on the breach)
    _rflag3="$_td/rearm-flag3"; rm -f "$_rflag3"
    _mi_breach; MESH_RG_MEMINFO="$_td/rmi" MESH_RG_PSI_MEM_FILE="$_td/rpsi" node_pressure_eval; rg_breach_reset "$_rflag3"; node_edge_should_post "$_rflag3" "$NODE_CLASS" >/dev/null
    _rf3pass() { if [ "$1" = breach ]; then _mi_breach; else _mi_clean; fi; MESH_RG_MEMINFO="$_td/rmi" MESH_RG_PSI_MEM_FILE="$_td/rpsi" node_pressure_eval
      if [ -n "$NODE_REASON" ]; then rg_breach_reset "$_rflag3"; else rg_clean_rearm "$_rflag3" "$(MESH_RG_MEMINFO="$_td/rmi" node_pressure_margin_recovered)"; fi; return 0; }
    _rf3pass clean; _rf3pass clean; _rf3pass breach; _rf3pass clean
    [ -f "$_rflag3" ] || { echo "smoke-test: FAIL (streak did not reset on a mid-run breach — clean,clean,breach,clean wrongly re-armed)"; exit 1; }
    # resource_state_label (chat-review/hollow-resource-guard-state, 2026-07-08): STATE must be OK
    # only when every axis is clean, and must name every active axis otherwise (mesh-health-state's
    # DECLARE registry treats non-"OK" as WARN — the label just needs to not literally equal "OK").
    [ "$(resource_state_label "" "" "" "")" = "OK" ] || { echo "  FAIL: all-clean should label OK"; exit 1; }
    r="$(resource_state_label "some runaway" "" "" "")";      case "$r" in WARN*RUNAWAY*) ;; *) echo "  FAIL: runaway should label WARN/RUNAWAY, got: $r"; exit 1;; esac
    r="$(resource_state_label "" "some elevated" "" "")";     case "$r" in WARN*DUAL-ELEVATED*) ;; *) echo "  FAIL: elevated should label WARN/DUAL-ELEVATED, got: $r"; exit 1;; esac
    r="$(resource_state_label "" "" "swap low" "")";          case "$r" in WARN*NODE-PRESSURE*) ;; *) echo "  FAIL: node-pressure should label WARN/NODE-PRESSURE, got: $r"; exit 1;; esac
    r="$(resource_state_label "" "" "" "accel|ramping")";     case "$r" in WARN*NODE-ACCELERATING*) ;; *) echo "  FAIL: accelerating should label WARN/NODE-ACCELERATING, got: $r"; exit 1;; esac
    r="$(resource_state_label "rw" "" "swap low" "")";        case "$r" in WARN*RUNAWAY*NODE-PRESSURE*) ;; *) echo "  FAIL: joint runaway+node-pressure should name both, got: $r"; exit 1;; esac
    # end-to-end: STATE must round-trip through a real file, never fake OK when something is active.
    _sd="$(mktemp -d)"; trap 'rm -rf "$_sd"' EXIT
    resource_state_label "rw" "" "" "" > "$_sd/state"
    grep -q '^WARN: RUNAWAY$' "$_sd/state" || { echo "  FAIL: STATE file did not capture WARN/RUNAWAY (got: $(cat "$_sd/state"))"; exit 1; }
    echo "  ok: resource_state_label (6 label assertions + STATE round-trip)"
    # top_rss letter-less-comm fallback (chat-review/resguard-top-rss-names-a-version): a claude
    # engine exec'd from ~/.local/share/claude/versions/2.1.210 has comm='2.1.210' — the live 09:36
    # [node-pressure] alert named the 16.4GB culprit '2.1.210(16445MB)', unidentifiable at the
    # moment identification matters. The rendered name must carry the program (path components),
    # never a bare version string; a normal comm must render unchanged.
    # Sentinel names (never in a live ps table) so the gate can only pass by top_rss actually
    # reading the fixture — the first cut of this gate matched 'claude' against the node's LIVE
    # ps output and passed vacuously against the bug (injected-fixture-bypass class).
    printf '16445000 2.1.210 /opt/zzsentinelengine/versions/2.1.210 --resume\n500000 zzsentinelsvc /usr/local/lib/zz/zzsentinelsvc --model /x/y.bin\n' > "$_td/pstable"
    _tr="$(MESH_RG_PS_FILE="$_td/pstable" top_rss 3)"
    case "$_tr" in *zzsentinelengine*) ;; *) echo "smoke-test: FAIL (top_rss letter-less comm '2.1.210' rendered without the program name: '$_tr')"; exit 1;; esac
    case " $_tr" in *" 2.1.210("*) echo "smoke-test: FAIL (top_rss still renders the bare version as the culprit name: '$_tr')"; exit 1;; *) ;; esac
    case "$_tr" in *"zzsentinelsvc("*) ;; *) echo "smoke-test: FAIL (top_rss regression — normal comm no longer renders as-is: '$_tr')"; exit 1;; esac
    echo "  ok: top_rss letter-less-comm fallback (version-named engine renders its path, normal comm unchanged)"
    # node-pressure ledger-resolution gate (uxn gates-as-data: ONE row shared with mesh-doctor's
    # _sc_mem_exhausted). NODE_MEM_PCT/NODE_SWAP_PCT bind at LOAD time, so a gate that called
    # _ledger_const from here would prove only that the helper works, never that the binding took
    # (export-does-not-rebind-a-load-time-global). This re-execs the script under a fixture ledger
    # and reads the thresholds line the run itself prints — the artifact, not the helper.
    _lfx="$(mktemp -d)"
    printf 'node-pressure | apct spct hasswap | mem=77 swap=66 | (if (< apct mem) 1 0)\n' > "$_lfx/ledger"
    _lout="$(MESH_THRESHOLD_LEDGER="$_lfx/ledger" env -u MESH_RG_MEM_PCT -u MESH_RG_SWAP_PCT bash "$0" --status 2>/dev/null | grep '^thresholds:')"
    case "$_lout" in *"avail<77%"*"swap<66%"*) ;; *)
      echo "smoke-test: FAIL (node-pressure ledger row did not reach NODE_MEM_PCT/NODE_SWAP_PCT — got: ${_lout:-<no thresholds line>})"; rm -rf "$_lfx"; exit 1;; esac
    _lout="$(MESH_RG_MEM_PCT=88 MESH_THRESHOLD_LEDGER="$_lfx/ledger" bash "$0" --status 2>/dev/null | grep '^thresholds:')"
    case "$_lout" in *"avail<88%"*) ;; *)
      echo "smoke-test: FAIL (MESH_RG_MEM_PCT env did not win over the ledger row — got: ${_lout:-<no thresholds line>})"; rm -rf "$_lfx"; exit 1;; esac
    _lout="$(MESH_THRESHOLD_LEDGER="$_lfx/absent" env -u MESH_RG_MEM_PCT -u MESH_RG_SWAP_PCT bash "$0" --status 2>/dev/null | grep '^thresholds:')"
    case "$_lout" in *"avail<10%"*"swap<5%"*) ;; *)
      echo "smoke-test: FAIL (missing ledger did not fail-open to the inline 10%/5% floor — got: ${_lout:-<no thresholds line>})"; rm -rf "$_lfx"; exit 1;; esac
    rm -rf "$_lfx"
    echo "  ok: node-pressure ledger resolution (env>ledger>inline, load-time binding read off the printed thresholds line)"
    echo "smoke-test: ok (thresholds: RSS>${THRESH_MB}MB CPU>${THRESH_CPU}% ${THRESH_RSS_MB}MB-hard + dual-elevated RSS>${THRESH_MB_ELEV}MB&&CPU>${THRESH_CPU_ELEV}% + node-pressure avail<${NODE_MEM_PCT}%||swap<${NODE_SWAP_PCT}% + 8+6 dry-run assertions + psi-corroboration 11-case (band thresholds + swap-axis suppress/fire + mem-axis unaffected + eval end-to-end) + sticky-union edge dedupe (oscillation-proof) + fixture round-trip + dragon-king precursor 11-case battery (super-exp/super-linear shape split + false-positive guards) + accel-level corroboration 3-case (low/high/zero-total) + tau-ETA 7-case battery (smoothed-rate: steady-unchanged/spiky-last-drop-lengthens/decelerating/flat/recovering/single-sample/empty) + Parisian-dwell 7-case battery (clock-reset-on-recovery/single-dip-not-ruin/within-grace/sustained-ruin/deficit-dependent-deep-ruin/empty/barrier<=0-no-op) + criticality 6-case battery (excess-volatility precursor: growing-swing/level-independent/calm-below-cv-floor/degenerate-level-split/too-few-samples/empty + long-history push/trim kept separate from the accel series) + push/trim/edge + recovery-with-margin re-arm: 1-post-per-hovering-episode/streak+margin/breach-resets-streak + resource_state_label: 6+STATE-round-trip + top_rss letter-less-comm fallback: 3 + node-pressure ledger resolution: 3 (env>ledger>inline, re-exec) + generalized-drawdown battery (fixed-vs-drawdown disagreement CONTROL/n-a-is-not-clean/lone-dip/lone-dip-at-interval==clock/fold-names-its-winner-both-ways/flat-at-peak-clean) + OMEGA bankruptcy-rate battery (sawtooth-ruin-while-BOTH-Parisian-siblings-read-clean CONTROL/contiguity-independence/contiguous-twin-visible-to-dwell/depth-weighting-load-bearing/p=2-convexity-ratio/hazard-middle-tier/flat-publishes-H=0.00/n-a-is-not-clean/live-lone-transient-stays-clean/fold-names-its-winner))"
    exit 0
    ;;

  --alert)
    runaway=""; elevated=""
    while read -r name pid rss_mb cpu_pct; do
      [ -z "$name" ] && continue
      alert=$(check_mind "$name" "$pid" "$rss_mb" "$cpu_pct" 2>&1); rc=$?
      if [ "$rc" = 1 ]; then
        runaway="$runaway
  $alert"
        mitigate "$pid" "$name"
        echo "$(ts) $alert — MITIGATED" >> "$MESH/resource-guard.log"
      elif [ "$rc" = 2 ]; then
        elevated="$elevated
  $alert"
        echo "$(ts) $alert" >> "$MESH/resource-guard.log"
      fi
    done < <(scan_minds)
    ec=0
    if [ -n "$runaway" ]; then
      # GRACEFUL node-wide HARDWARE cap BEFORE the per-process shed escalation (opt-in per node:
      # MESH_TURBO_LID=1, default OFF). A runaway mind is heating the whole package; the lid caps
      # every core gracefully (self-releasing via its own TTL dead-man) rather than only oom-adjusting
      # the offender. Re-asserted each runaway tick to keep the dead-man deadline fresh.
      [ "${MESH_TURBO_LID:-0}" = 1 ] && command -v mesh-turbo-lid >/dev/null 2>&1 && \
        mesh-turbo-lid --on --ttl "${MESH_TURBO_LID_TTL:-600}" --reason resource-guard >/dev/null 2>&1 || true
      prev=$(cat "$FLAG" 2>/dev/null || true)
      cur="$runaway"
      if [ "$prev" != "$cur" ]; then
        echo "$cur" > "$FLAG"
        command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="resguard@$(hostname)" \
          mesh-chat "[resource-guard] RUNAWAY mind(s):$runaway → renice+19, oom_score_adj=800. Check: ps -eo pid,rss,%cpu,comm | grep -E 'claude|opencode'" >/dev/null 2>&1
      fi
      ec=1
    else
      rm -f "$FLAG" 2>/dev/null
    fi
    # DUAL-ELEVATED: visibility only (no renice/oom) — same edge-trigger dedupe as RUNAWAY, [fyi]
    # not [resource-guard], since this is a joint precursor, not a proven runaway.
    if [ -n "$elevated" ]; then
      prevd=$(cat "$FLAG_DUAL" 2>/dev/null || true)
      if [ "$prevd" != "$elevated" ]; then
        echo "$elevated" > "$FLAG_DUAL"
        command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="resguard@$(hostname)" \
          mesh-chat "[fyi] resource-guard DUAL-ELEVATED (RSS+CPU rising together, below either RUNAWAY line — joint precursor, no mitigation):$elevated" >/dev/null 2>&1
      fi
    else
      rm -f "$FLAG_DUAL" 2>/dev/null
    fi
    # NODE-PRESSURE: memory/swap exhaustion across ALL processes — the missing BEFORE-signal for OOM.
    # Visibility + edge-triggered [node-pressure]; never kills (kernel/operator decide). Names top-3
    # RSS regardless of comm so the real culprits (whisper.cpp, synth python, …) are surfaced, not
    # hidden by the mind-only scan that shed relies on.
    #   MARKER (chat-review/node-hot-marker-axis-collision, 2026-07-07): this used to post the SAME
    # '[node-hot]' token mesh-node-care uses for its THERMAL Schmitt-trigger, so consumers that grep
    # '[node-hot]' as a thermal signal (mesh-hub-criticality, mesh-stress) silently absorbed memory
    # pressure as thermal stress, and a combined episode double-counted one real event across two
    # emitters — live board contradiction: resguard [node-hot] vs node-care [node-ok] 17s apart. This
    # axis gets its own marker; consumers that want the memory axis opt in explicitly (see
    # mesh-hub-criticality's pressure_count()).
    node_pressure_eval
    if [ -n "$NODE_REASON" ]; then
      rg_breach_reset "$FLAG_NODE"   # active episode → reset the consecutive-clean streak
      top3="$(top_rss 3)"
      if node_edge_should_post "$FLAG_NODE" "$NODE_CLASS"; then
        echo "$(ts) NODE-PRESSURE [$NODE_CLASS] $NODE_REASON — top RSS: $top3" >> "$MESH/resource-guard.log"
        command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="resguard@$(hostname)" \
          mesh-chat "[node-pressure] resource-guard NODE-PRESSURE: $NODE_REASON — top RSS: $top3 (BEFORE-signal for OOM; all processes, no kill — kernel/operator decide)" >/dev/null 2>&1
      fi
      ec=1
    else
      # recovery-with-margin re-arm: a single clean pass does NOT re-arm — a threshold-hovering SwapFree
      # would flap ONE episode into many [node-pressure] posts. Clear only after ≥RG_REARM_CLEAN
      # consecutive cleans OR a ≥2×-line margin recovery (episode hysteresis). Never a bare rm -f.
      rg_clean_rearm "$FLAG_NODE" "$(node_pressure_margin_recovered)"
    fi
    # NODE-ACCELERATING (dragon-king precursor): push this pass's MemAvailable, classify the ramp.
    # BEFORE-signal complementary to NODE-PRESSURE (can co-fire; different class). Visibility only.
    read -r _acc_a _acc_t _ _ < <(read_meminfo)
    accel_push "$_acc_a" "$ACCEL_HIST" "$ACCEL_KEEP"
    accel_push "$_acc_a" "$LONG_HIST" "$LONG_KEEP"   # same sample, longer retention (criticality axis)
    _acc_out="$(node_accel_classify "$(accel_series)" $((ACCEL_FLOOR_MB*1024)))" || _acc_out=""
    if [ -n "$_acc_out" ]; then
      rg_breach_reset "$FLAG_ACCEL"   # active ramp → reset the consecutive-clean streak
      if node_edge_should_post "$FLAG_ACCEL" accel; then
        _tau_eta="$(node_tau_eta "$(accel_series)" "$RG_INTERVAL_S")" || _tau_eta=""
        _eta_note=""
        [ -n "$_tau_eta" ] && _eta_note=" — τ ETA-to-zero at current rate: $((_tau_eta/60))m$((_tau_eta%60))s"
        echo "$(ts) NODE-ACCELERATING ${_acc_out#*|}${_eta_note}" >> "$MESH/resource-guard.log"
        # LEVEL-corroborate before the board post (chat-review/resguard-accel-no-level-gate): the shape
        # alone fires the same at 6% free and 87% free — only escalate to mesh-chat when MemAvailable is
        # ALSO below ACCEL_LEVEL_PCT% of total. Above that, the log line above is the (trace-only) record.
        if node_accel_level_low "$_acc_a" "$_acc_t"; then
          # dragon-king wording ONLY for the super-exponential shape (chat-review/resguard-accel-superexp-mislabel);
          # a super-linear ramp is accelerating but decelerating-growth — visibility, never "dragon-king".
          case "$_acc_out" in
            *super-exponential*) _shape_note="dragon-king precursor; visibility only, no kill — kernel/operator/heavy-run decide";;
            *)                   _shape_note="super-linear, not a dragon-king; visibility only, no kill — kernel/operator/heavy-run decide";;
          esac
          command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="resguard@$(hostname)" \
            mesh-chat "[node-accelerating] resource-guard PRECURSOR: ${_acc_out#*|}${_eta_note} — memory consumption is ACCELERATING before the level line (${_shape_note})" >/dev/null 2>&1
        fi
      fi
      ec=1
    else
      # recovery-with-margin re-arm (accel has no single level line → streak-only, margin arg 0): a ramp
      # that ended re-arms after RG_REARM_CLEAN clean passes, so a re-onset is a genuinely new episode.
      rg_clean_rearm "$FLAG_ACCEL" 0
    fi
    resource_state_label "$runaway" "$elevated" "$NODE_REASON" "$_acc_out" > "$STATE"
    exit "$ec"
    ;;

  --watch)
    while :; do clear; mesh-resource-guard --status; sleep 5; done
    ;;

  --status|*)
    echo "=== mesh-resource-guard $(ts) ==="
    printf "WINDOW           MIND       PID       RSS        CPU\n"
    while read -r name pid rss_mb cpu_pct; do
      [ -z "$name" ] && continue
      win=$(pid_to_win "$pid")
      [ -z "$win" ] && win="-"
      status=$(check_mind "$name" "$pid" "$rss_mb" "$cpu_pct" 2>&1)
      if echo "$status" | grep -q '^RUNAWAY'; then
        printf '\033[31m%-16s %-9s %-9s %-10s %-6s\033[0m\n' "$win" "$name" "$pid" "${rss_mb}MB" "${cpu_pct}%"
        echo "  ⚠ $status"
      elif echo "$status" | grep -q '^DUAL-ELEVATED'; then
        printf '\033[33m%-16s %-9s %-9s %-10s %-6s\033[0m\n' "$win" "$name" "$pid" "${rss_mb}MB" "${cpu_pct}%"
        echo "  ~ $status"
      else
        printf '%-16s %-9s %-9s %-10s %-6s\n' "$win" "$name" "$pid" "${rss_mb}MB" "${cpu_pct}%"
      fi
    done < <(scan_minds)
    echo
    node_pressure_eval
    if [ -n "$NODE_REASON" ]; then
      printf '\033[31mNODE-PRESSURE: %s\033[0m\n' "$NODE_REASON"
      echo "  top RSS: $(top_rss 3)"
    else
      printf 'node: avail %dMB/%dMB, swap free %dMB/%dMB — OK\n' \
        "$NODE_AVAIL_MB" "$NODE_TOTAL_MB" "$NODE_SWAPFREE_MB" "$NODE_SWAPTOTAL_MB"
    fi
    # NODE-ACCELERATING precursor — READ-ONLY here (classify the existing history, never push; --status
    # runs every dash refresh, off-cadence, so pushing would poison the ramp series). --alert owns push.
    _acc_out="$(node_accel_classify "$(accel_series)" $((ACCEL_FLOOR_MB*1024)))" || _acc_out=""
    [ -n "$_acc_out" ] && printf '\033[33mNODE-ACCELERATING: %s\033[0m\n' "${_acc_out#*|}"
    _tau_eta="$(node_tau_eta "$(accel_series)" "$RG_INTERVAL_S")" || _tau_eta=""
    [ -n "$_tau_eta" ] && printf 'τ ETA-to-zero (MemAvailable, current-rate): %dm%ds\n' "$((_tau_eta/60))" "$((_tau_eta%60))"
    # NODE-DWELL (Parisian ruin) — READ-ONLY: how long has MemAvailable stayed CONTINUOUSLY below the
    # pressure barrier? Time-SINCE the crossing (dwell/absorption), the axis tau's time-TO cannot see.
    # Same retained series as accel/tau, never pushes here. Barrier = NODE_MEM_PCT% of MemTotal (node_pressure's).
    _dwell_barrier_kb=$(( NODE_TOTAL_MB * 1024 * NODE_MEM_PCT / 100 ))
    _dwell_out="$(node_dwell_classify "$(accel_series)" "$_dwell_barrier_kb" "$RG_INTERVAL_S" "$RG_DWELL_CLOCK_S")" || true
    case "$_dwell_out" in
      ruin\|*)      printf '\033[31mNODE-DWELL (Parisian ruin): %s\033[0m\n' "${_dwell_out#*|}" ;;
      excursion\|*) printf 'node-dwell: %s\n' "${_dwell_out#*|}" ;;
    esac
    # NODE-DRAWDOWN (draw-down Parisian ruin) — READ-ONLY. Same Parisian dwell, but the ruin level is a
    # FUNCTION of the running maximum instead of a constant, so it sees the excursions the fixed barrier
    # (86.6% below this node's operating peak, measured) cannot. Over the LONG history: 4 samples cannot
    # establish a peak. The absolute barrier is folded in, never dropped — it is what catches a slide
    # slower than the window, which every drawdown measure is blind to.
    _dd_out="$(node_drawdown_classify "$(long_series)" "$_dwell_barrier_kb" "$RG_INTERVAL_S" "$RG_DWELL_CLOCK_S" "$RG_DD_PCT" "$RG_DD_MIN_N")" || true
    case "$_dd_out" in
      ruin\|*)      printf '\033[31mNODE-DRAWDOWN (draw-down Parisian ruin): %s\033[0m\n' "${_dd_out#*|}" ;;
      excursion\|*) printf 'node-drawdown: %s\n' "${_dd_out#*|}" ;;
      clean\|*)     printf 'node-drawdown: %s\n' "${_dd_out#*|}" ;;
      *)            printf 'node-drawdown: n/a (too little history for a high-water mark; need n>=%s)\n' "$RG_DD_MIN_N" ;;
    esac
    # NODE-OMEGA (bankruptcy-rate / ω-killing) — READ-ONLY. Accumulated DEPTH-WEIGHTED time in the red
    # over the WHOLE window, never reset on recovery: the axis its two Parisian siblings above are
    # structurally blind to, because their clock restarts on every tooth of a sawtooth. Same barrier fold.
    _om_out="$(node_omega_classify "$(long_series)" "$_dwell_barrier_kb" "$RG_INTERVAL_S" "$RG_DWELL_CLOCK_S" "$RG_DD_PCT" "$RG_OMEGA_MIN_N" "$RG_OMEGA_P" "$RG_OMEGA_WARN" "$RG_OMEGA_REF")" || true
    case "$_om_out" in
      ruin\|*)   printf '\033[31mNODE-OMEGA (bankruptcy hazard): %s\033[0m\n' "${_om_out#*|}" ;;
      hazard\|*) printf '\033[33mnode-omega: %s\033[0m\n' "${_om_out#*|}" ;;
      clean\|*)  printf 'node-omega: %s\n' "${_om_out#*|}" ;;
      *)         printf 'node-omega: n/a (too little history to estimate occupation in the red; need n>=%s)\n' "$RG_OMEGA_MIN_N" ;;
    esac
    # NODE-CRITICALITY (excess-volatility precursor) — READ-ONLY, over the LONG history (never the
    # 4-sample accel series). Does the buffer's SWING grow as the buffer falls? Also the standing
    # qualification on the tau ETA printed above, which is a mean-path extrapolation.
    _crit_out="$(node_criticality_classify "$(long_series)" "$RG_CRIT_MIN_N" "$RG_CRIT_CV_FLOOR" "$RG_CRIT_A_HI")" || true
    case "$_crit_out" in
      critical\|*) printf '\033[31mNODE-CRITICALITY: %s\033[0m\n' "${_crit_out#*|}" ;;
      volatile\|*) printf 'node-criticality: %s\n' "${_crit_out#*|}" ;;
    esac
    echo "thresholds: RSS>${THRESH_MB}MB (50%RAM) | CPU>${THRESH_CPU}% | hard-cap:${THRESH_RSS_MB}MB | node: avail<${NODE_MEM_PCT}% || swap<${NODE_SWAP_PCT}% | dwell-clock:${RG_DWELL_CLOCK_S}s"
    ;;
esac