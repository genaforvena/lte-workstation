#!/usr/bin/env bash
# mesh-resource-guard — monitor each mind's RAM/CPU, alert on runaway.
#
#   mesh-resource-guard        scan all minds, report one-line per mind
#   mesh-resource-guard --alert  cron mode: check thresholds, edge-triggered alert
#   mesh-resource-guard --test smoke test
#
# Thresholds: RSS > 3GB || CPU > (nproc × 90%) || RSS > 50% of MemTotal.
# On alert: renice +19, increase oom_score_adj to make it the OOM target.
# Never hard-kills — operator decides.
#
# DUAL-ELEVATED (literature/soc-multicriticality-20260704, arxiv 2506.04275 "Self-organization to
# multicriticality", Jun 2025): that paper shows a coupled system can self-tune to be critical along
# TWO independent order parameters AT ONCE, a materially different (riskier) regime than either alone.
# The RUNAWAY checks below are single-axis ORs (RSS>X || CPU>Y) — structurally blind to a mind rising
# on BOTH axes together while staying under each individual line. DUAL-ELEVATED below is that joint
# precursor: visibility only (same never-hard-act posture as RUNAWAY), no mitigation.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
MESH="$HOME/.mesh"; mkdir -p "$MESH"
FLAG="$MESH/.resource-guard-flag"
FLAG_DUAL="$MESH/.resource-guard-dual-flag"
MEMTOTAL=$(awk '/MemTotal/{print $2}' /proc/meminfo)  # kB
THRESH_MB=$(( MEMTOTAL / 2 / 1024 ))   # 50% of RAM in MB
THRESH_RSS_MB=3072                      # hard cap: 3GB per process
NPROC=$(nproc)
THRESH_CPU=$(( NPROC * 90 ))            # 90% × nproc (percentage points)
THRESH_MB_ELEV=$(( THRESH_MB * 3 / 5 ))   # ~30% of RAM — joint-elevated line (below RUNAWAY)
THRESH_CPU_ELEV=$(( THRESH_CPU * 3 / 5 )) # 60% of the RUNAWAY CPU line — joint-elevated line

ts() { date -u +%Y-%m-%dT%H:%M:%SZ; }

# INSTANTANEOUS CPU% per PID over a short interval. ps's %cpu is a LIFETIME AVERAGE and MISLEADS
# about current burn: a mind that worked hard then went idle shows a high avg (false RUNAWAY), and a
# fresh spinner shows a low avg (MISSED) — the exact rate-limited-spinner class this guard must catch
# (2026-06-13). Sample utime+stime from /proc/<pid>/stat twice and delta it.
inst_cpu() { # stdin: "name pid rss_mb" lines → stdout: same + a real-time cpu% field
  local interval="${MESH_RG_INTERVAL:-0.7}" hz; hz=$(getconf CLK_TCK 2>/dev/null || echo 100)
  local -a NM PD RS T1; local n p r
  while read -r n p r; do NM+=("$n"); PD+=("$p"); RS+=("$r"); T1+=("$(awk '{print $14+$15}' "/proc/$p/stat" 2>/dev/null || echo 0)"); done
  sleep "$interval"
  local i=0
  for p in "${PD[@]}"; do
    local c2; c2=$(awk '{print $14+$15}' "/proc/$p/stat" 2>/dev/null || echo 0)
    awk -v nm="${NM[$i]}" -v pid="$p" -v rs="${RS[$i]}" -v a="${T1[$i]}" -v b="$c2" -v iv="$interval" -v hz="$hz" \
      'BEGIN{ printf "%s %d %.1f %.1f\n", nm, pid, rs, (b-a)*100/(hz*iv) }'
    i=$((i+1))
  done
}
# --- find mind PIDs -------------------------------------------------------
scan_minds() {
  ps -eo pid,rss,comm,args --no-headers 2>/dev/null \
    | awk -v patterns='^(claude|opencode|gemini|codex|ollama)$' '
  {
    pid=$1; rss_kb=$2; comm=$3
    if (rss_kb < 5000) next
    if (comm ~ /^(awk|grep|sh|bash)$/) next
    if (comm ~ patterns) { printf "%s %d %.1f\n", comm, pid, rss_kb/1024; next }
    for(i=4;i<=NF;i++) {
      bname=$i; gsub(/.*\//,"",bname)
      if (bname ~ patterns) { printf "%s %d %.1f\n", bname, pid, rss_kb/1024; break }
    }
  }' | awk '!seen[$2]++' \
     | inst_cpu \
     | sort -t' ' -k4 -rn   # sort by REAL-TIME cpu desc
}

# --- PID → tmux window ----------------------------------------------------
pid_to_win() {
  local pid="$1" p
  # walk ancestors until we hit the tmux pane PID or init
  p="$pid"
  while [ "$p" -gt 1 ] 2>/dev/null; do
    local win; win="$(tmux list-panes -a -F '#{window_name} #{pane_pid}' 2>/dev/null | awk -v pid="$p" '$2 == pid {print $1; exit}')"
    [ -n "$win" ] && { echo "$win"; return; }
    p=$(awk '{print $4}' "/proc/$p/stat" 2>/dev/null || echo 1)
  done
}
# --- classify --------------------------------------------------------------
check_mind() {
  local name="$1" pid="$2" rss_mb="$3" cpu_pct="$4"
  local flags=""
  # use awk for float comparison (bash integer -gt doesn't do floats)
  if awk "BEGIN {exit !($rss_mb > $THRESH_MB)}"; then
    flags="$flags RSS=${rss_mb}MB(>50%RAM)"
  fi
  if awk "BEGIN {exit !($rss_mb > $THRESH_RSS_MB)}"; then
    flags="$flags RSS=${rss_mb}MB(>${THRESH_RSS_MB}MB)"
  fi
  if awk "BEGIN {exit !($cpu_pct > $THRESH_CPU)}"; then
    flags="$flags CPU=${cpu_pct}%(>${THRESH_CPU})"
  fi
  [ -n "$flags" ] && echo "RUNAWAY $name pid=$pid ${flags# }" && return 1
  # DUAL-ELEVATED: both axes elevated together, below either single-axis RUNAWAY line — see the
  # multicriticality note at the top of the file. Independent OR-thresholds above can't see this.
  if awk "BEGIN {exit !($rss_mb > $THRESH_MB_ELEV && $cpu_pct > $THRESH_CPU_ELEV)}"; then
    echo "DUAL-ELEVATED $name pid=$pid RSS=${rss_mb}MB(>${THRESH_MB_ELEV}MB) CPU=${cpu_pct}%(>${THRESH_CPU_ELEV}%) — both axes rising together"
    return 2
  fi
  echo "OK $name pid=$pid rss=${rss_mb}MB cpu=${cpu_pct}%"
  return 0
}

# --- mitigation (sudo-free best-effort) ------------------------------------
mitigate() {
  local pid="$1" name="$2"
  renice -n 19 -p "$pid" >/dev/null 2>&1 || true
  echo 800 > "/proc/$pid/oom_score_adj" 2>/dev/null || true
  echo "$(ts) mitigated $name pid=$pid: renice 19, oom_score_adj=800" >> "$MESH/resource-guard.log"
}

# --- commands --------------------------------------------------------------
case "${1:-}" in
  --test)
    command -v ps >/dev/null 2>&1 || { echo "smoke-test: FAIL (ps not found)"; exit 1; }
    command -v renice >/dev/null 2>&1 || { echo "smoke-test: FAIL (renice not found)"; exit 1; }
    [ -r /proc/meminfo ] || { echo "smoke-test: FAIL (/proc/meminfo not readable)"; exit 1; }
    # Dry-run check_mind() with synthetic values — exercise the RUNAWAY/OK boundary logic
    _td="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
    trap 'rm -rf "$_td"' EXIT
    _f=0
    # Override thresholds for test (THRESH_MB=2000, THRESH_CPU=360 on 4-core; ELEV=3/5 of each, same
    # ratio as the real THRESH_MB_ELEV/THRESH_CPU_ELEV derivation)
    _eval_check() { local mb="$1" cpu="$2" exp="$3"; local out
      out="$(THRESH_MB=2000 THRESH_RSS_MB=3072 THRESH_CPU=360 NPROC=4 THRESH_MB_ELEV=1200 THRESH_CPU_ELEV=216 bash -c '
        '"$(declare -f check_mind)"'
        check_mind "test" 12345 "'"$mb"'" "'"$cpu"'"
      ' 2>/dev/null)" || true
      case "$out" in "$exp"*) ;; *)
        echo "  FAIL: check_mind rss=${mb} cpu=${cpu}%: expected ${exp}, got: ${out:0:80}"; _f=1;;
      esac
    }
    _eval_check 1000 10   "OK test pid=12345"       || true
    _eval_check 4000 10   "RUNAWAY test"             || true
    _eval_check 100  400  "RUNAWAY test"             || true
    _eval_check 2500 10   "RUNAWAY test"             || true
    _eval_check 1500 200  "OK test pid=12345"        || true
    # DUAL-ELEVATED boundary (soc-multicriticality): both axes over their (lower) elevated line,
    # neither over its RUNAWAY line — must be a distinct tier, not OK and not RUNAWAY.
    _eval_check 1500 250  "DUAL-ELEVATED test"        || true
    # only ONE axis elevated → still OK (the joint check requires BOTH, not either)
    _eval_check 1300 100  "OK test pid=12345"        || true
    _eval_check 500  250  "OK test pid=12345"        || true
    [ "$_f" = 0 ] || { echo "smoke-test: FAIL (check_mind() drifted — boundary logic wrong)"; exit 1; }
    echo "smoke-test: ok (thresholds: RSS>${THRESH_MB}MB CPU>${THRESH_CPU}% ${THRESH_RSS_MB}MB-hard + dual-elevated RSS>${THRESH_MB_ELEV}MB&&CPU>${THRESH_CPU_ELEV}% + 8 dry-run assertions)"
    exit 0
    ;;

  --alert)
    runaway=""; elevated=""
    while read -r name pid rss_mb cpu_pct; do
      [ -z "$name" ] && continue
      alert=$(check_mind "$name" "$pid" "$rss_mb" "$cpu_pct" 2>&1); rc=$?
      if [ "$rc" = 1 ]; then
        runaway="$runaway
  $alert"
        mitigate "$pid" "$name"
        echo "$(ts) $alert — MITIGATED" >> "$MESH/resource-guard.log"
      elif [ "$rc" = 2 ]; then
        elevated="$elevated
  $alert"
        echo "$(ts) $alert" >> "$MESH/resource-guard.log"
      fi
    done < <(scan_minds)
    ec=0
    if [ -n "$runaway" ]; then
      prev=$(cat "$FLAG" 2>/dev/null || true)
      cur="$runaway"
      if [ "$prev" != "$cur" ]; then
        echo "$cur" > "$FLAG"
        command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="resguard@$(hostname)" \
          mesh-chat "[resource-guard] RUNAWAY mind(s):$runaway → renice+19, oom_score_adj=800. Check: ps -eo pid,rss,%cpu,comm | grep -E 'claude|opencode'" >/dev/null 2>&1
      fi
      ec=1
    else
      rm -f "$FLAG" 2>/dev/null
    fi
    # DUAL-ELEVATED: visibility only (no renice/oom) — same edge-trigger dedupe as RUNAWAY, [fyi]
    # not [resource-guard], since this is a joint precursor, not a proven runaway.
    if [ -n "$elevated" ]; then
      prevd=$(cat "$FLAG_DUAL" 2>/dev/null || true)
      if [ "$prevd" != "$elevated" ]; then
        echo "$elevated" > "$FLAG_DUAL"
        command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="resguard@$(hostname)" \
          mesh-chat "[fyi] resource-guard DUAL-ELEVATED (RSS+CPU rising together, below either RUNAWAY line — joint precursor, no mitigation):$elevated" >/dev/null 2>&1
      fi
    else
      rm -f "$FLAG_DUAL" 2>/dev/null
    fi
    exit "$ec"
    ;;

  --watch)
    while :; do clear; mesh-resource-guard --status; sleep 5; done
    ;;

  --status|*)
    echo "=== mesh-resource-guard $(ts) ==="
    printf "WINDOW           MIND       PID       RSS        CPU\n"
    while read -r name pid rss_mb cpu_pct; do
      [ -z "$name" ] && continue
      win=$(pid_to_win "$pid")
      [ -z "$win" ] && win="-"
      status=$(check_mind "$name" "$pid" "$rss_mb" "$cpu_pct" 2>&1)
      if echo "$status" | grep -q '^RUNAWAY'; then
        printf '\033[31m%-16s %-9s %-9s %-10s %-6s\033[0m\n' "$win" "$name" "$pid" "${rss_mb}MB" "${cpu_pct}%"
        echo "  ⚠ $status"
      elif echo "$status" | grep -q '^DUAL-ELEVATED'; then
        printf '\033[33m%-16s %-9s %-9s %-10s %-6s\033[0m\n' "$win" "$name" "$pid" "${rss_mb}MB" "${cpu_pct}%"
        echo "  ~ $status"
      else
        printf '%-16s %-9s %-9s %-10s %-6s\n' "$win" "$name" "$pid" "${rss_mb}MB" "${cpu_pct}%"
      fi
    done < <(scan_minds)
    echo
    echo "thresholds: RSS>${THRESH_MB}MB (50%RAM) | CPU>${THRESH_CPU}% | hard-cap:${THRESH_RSS_MB}MB"
    ;;
esac