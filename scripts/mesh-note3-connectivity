#!/usr/bin/env bash
# reflex-cadence: 11-59/5 * * * *
# doctor-artifact: $HOME/.mesh/.note3-connectivity.state 1200 phone
# mesh-note3-connectivity — Note 3 transport × Android network connectivity fusion.
#
# The transport axis answers "can this node command the phone?"; the Android dump answers
# "does the phone have a current default network?". Neither axis alone gives ONLINE/NO_NETWORK.
# A missing transport or failed dump is UNKNOWN/UNREACHABLE, never an empty network.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && [ -z "${MESH_SKIP_NODES_SOURCE:-}" ] && . "$HOME/.mesh/nodes" 2>/dev/null || true

MESH_DIR="${MESH_DIR:-$HOME/.mesh}"
NODE="${MESH_NOTE3_ADB_NODE:-local}"
SER="${MESH_NOTE3_ADB_SERIAL:-4d00553d61ab90b7}"
TRANSPORT_STATE="${MESH_NOTE3_TRANSPORT_STATE:-$MESH_DIR/.note3-adb-transport}"
STATE="${MESH_NOTE3_CONNECTIVITY_STATE:-$MESH_DIR/.note3-connectivity.state}"
RUNLOG="${MESH_NOTE3_CONNECTIVITY_RUNLOG:-$MESH_DIR/note3-connectivity.log}"

now_utc(){ date -u +%Y-%m-%dT%H:%M:%SZ; }
node_shell(){
  if [ "$NODE" = local ]; then bash -c "$1"
  else timeout 25 ssh -o BatchMode=yes -o ConnectTimeout=8 -o StrictHostKeyChecking=accept-new "$NODE" "$1" </dev/null 2>/dev/null
  fi
}
connectivity_dump(){
  if [ "$NODE" = local ]; then timeout 20 adb -s "$SER" shell 'dumpsys connectivity' 2>/dev/null | tr -d '\r'
  else node_shell "timeout 20 adb -s '$SER' shell 'dumpsys connectivity'" | tr -d '\r'; fi
}

# parse_dump -> active_default|connected|interface|validated|verdict|reason
parse_dump(){
  awk '
    /Active default network:/ { active=1 }
    /mActiveDefaultNetwork:/ { active=1 }
    /mActiveDefaultNetwork: .*CONNECTED\/CONNECTED/ { legacy=1 }
    /NetworkAgentInfo\{/ && /state: CONNECTED\/CONNECTED/ { connected++ }
    /InterfaceName:/ { interface=1 }
    /validated\{true\}/ { validated=1 }
    END {
      if (active && connected > 0 && interface && validated) print "1|" connected "|1|1|ONLINE|validated-default"
      else if (active && connected == 0 && interface == 0 && validated == 0) print "1|0|0|0|NO_NETWORK|no-connected-default"
      else if (active || legacy || connected > 0 || interface || validated) print (active ? "1" : "0") "|" connected "|" (interface ? "1" : "0") "|" (validated ? "1" : "0") "|UNKNOWN|partial-connectivity-dump"
    }
  '
}
transport_live(){ [ -r "$TRANSPORT_STATE" ] && grep -q "^REACHED .*serial=$SER " "$TRANSPORT_STATE" 2>/dev/null; }
write_reading(){
  local reading="$1" tmp
  mkdir -p "$(dirname "$STATE")" "$(dirname "$RUNLOG")" 2>/dev/null || return 1
  tmp="$(mktemp "${STATE}.XXXXXX")" || return 1
  printf '%s\n' "$reading" >"$tmp" || { rm -f "$tmp"; return 1; }
  mv -f "$tmp" "$STATE" || { rm -f "$tmp"; return 1; }
  printf '%s %s\n' "$(now_utc)" "$reading" >>"$RUNLOG" || return 1
  mesh-state-touch "$STATE" >/dev/null 2>&1 || return 1
}
# cell_quality — the serving-cell radio level annotating the connectivity verdict.
# ONLINE via a POOR cell (handover zone, basement) is a different operating condition from ONLINE
# via STRONG, and NO_NETWORK beside a STRONG cell points at the carrier/core rather than the
# radio. Additive annotation ONLY: it never changes the verdict or the exit code — a dark radio
# renders cell=UNKNOWN, never a faked level. Invoked bounded (adb can hang); the serial follows
# this fusion's own SER so both axes interrogate the same body.
CELLSIGNAL_BIN="${MESH_NOTE3_CELLSIGNAL_BIN:-mesh-note3-cellsignal}"
cell_quality(){
  local out level bin
  bin="${MESH_NOTE3_CELLSIGNAL_BIN:-$CELLSIGNAL_BIN}"   # re-read: --test overrides per-call, not at load
  out="$(MESH_NOTE3_SERIAL="$SER" timeout 30 "$bin" 2>/dev/null)" || { echo UNKNOWN; return; }
  level="$(printf '%s' "$out" | grep -oE ' level=(STRONG|FAIR|WEAK|POOR)' | head -1 | cut -d= -f2)"
  [ -n "$level" ] && printf '%s' "$level" || echo UNKNOWN
}
probe(){
  local ts dump parsed active connected iface validated verdict reason cell
  ts="$(now_utc)"
  if ! transport_live; then printf 'UNKNOWN|reason=adb-unreachable|transport=UNREACHABLE|ts=%s\n' "$ts"; return 2; fi
  dump="$(connectivity_dump)" || dump=""
  [ -n "$dump" ] || { printf 'UNKNOWN|reason=connectivity-dump-unreachable|transport=REACHED|ts=%s\n' "$ts"; return 2; }
  parsed="$(printf '%s\n' "$dump" | parse_dump)"
  IFS='|' read -r active connected iface validated verdict reason <<<"$parsed"
  cell="$(cell_quality)"
  if [ "${verdict:-}" = ONLINE ] || [ "${verdict:-}" = NO_NETWORK ]; then
    printf '%s|active_default=%s|connected=%s|interface=%s|validated=%s|transport=REACHED|cell=%s|reason=%s|ts=%s\n' "$verdict" "$active" "$connected" "$iface" "$validated" "$cell" "$reason" "$ts"; return 0
  fi
  printf 'UNKNOWN|active_default=%s|connected=%s|interface=%s|validated=%s|transport=REACHED|cell=%s|reason=%s|ts=%s\n' "${active:-0}" "${connected:-0}" "${iface:-0}" "${validated:-0}" "$cell" "${reason:-malformed-connectivity-dump}" "$ts"; return 2
}

if [ "${1:-}" = --test ]; then
  _f=0
  _online=$'Active default network: 528\n  NetworkAgentInfo{ state: CONNECTED/CONNECTED network{528} lp{{InterfaceName: rmnet0}} nc{[ Transports: CELLULAR]} validated{true} }'
  _empty=$'NetworkFactories for:\n  WIFI\nmActiveDefaultNetwork: 0 DISCONNECTED/DISCONNECTED'
  [ "$(printf '%s' "$_online" | parse_dump | cut -d'|' -f5)" = ONLINE ] || { echo 'smoke-test: FAIL (live fixture did not derive ONLINE)'; _f=1; }
  [ "$(printf '%s' "$_empty" | parse_dump | cut -d'|' -f5)" = NO_NETWORK ] || { echo 'smoke-test: FAIL (reachable empty fixture did not derive NO_NETWORK)'; _f=1; }
  [ "$(printf '%s' "$_empty" | parse_dump | cut -d'|' -f5)" != UNKNOWN ] || { echo 'smoke-test: FAIL (empty collapsed to UNKNOWN)'; _f=1; }
  [ "$(printf '%s' garbage | parse_dump)" = '' ] || { echo 'smoke-test: FAIL (garbage dump accepted)'; _f=1; }
  _tdark="$(mktemp -d)"; MESH_DIR="$_tdark/.mesh"; TRANSPORT_STATE="$_tdark/.mesh/missing"; STATE="$_tdark/.mesh/state"; RUNLOG="$_tdark/.mesh/run.log"
  _dark="$(probe)"; _dark_rc=$?; rm -rf "$_tdark"
  [ "$_dark_rc" = 2 ] && printf '%s' "$_dark" | grep -q 'UNKNOWN|reason=adb-unreachable' || { echo 'smoke-test: FAIL (unreachable did not render UNKNOWN)'; _f=1; }
  [ "$_f" = 0 ] || exit 1
  # cell annotation (MCC link: the cellsignal producer is consumed here, not just live) —
  # a stubbed STRONG radio must surface as cell=STRONG with the verdict path untouched, and a
  # dark radio (rc 2) as cell=UNKNOWN, never a faked level. Needs live adb for the dump leg;
  # without it the arms are UNKNOWN (stated), not skipped silently.
  _td="$(mktemp -d)"; MESH_DIR="$_td/.mesh"; TRANSPORT_STATE="$_td/.mesh/transport"; STATE="$_td/.mesh/state"; RUNLOG="$_td/.mesh/run.log"
  mkdir -p "$_td/.mesh" "$_td/bin"; printf 'REACHED now serial=%s device_uptime_s=1\n' "$SER" >"$TRANSPORT_STATE"
  printf '#!/usr/bin/env bash\necho "status=OK radio=gsm asu=28 dbm=-57 level=STRONG"\n' >"$_td/bin/cellsignal-stub"; chmod +x "$_td/bin/cellsignal-stub"
  printf '#!/usr/bin/env bash\necho "status=UNKNOWN reason=adb_unreachable radio=unknown asu=unknown dbm=unknown level=unknown"\nexit 2\n' >"$_td/bin/cellsignal-dark"; chmod +x "$_td/bin/cellsignal-dark"
  _cell_out="$(MESH_NOTE3_CELLSIGNAL_BIN="$_td/bin/cellsignal-stub" probe 2>/dev/null)"; _cell_rc=$?
  if [ "$_cell_rc" = 0 ]; then
    printf '%s' "$_cell_out" | grep -q '|cell=STRONG|' || { rm -rf "$_td"; echo "smoke-test: FAIL (stubbed STRONG radio not annotated: $_cell_out)"; exit 1; }
    _darkcell_out="$(MESH_NOTE3_CELLSIGNAL_BIN="$_td/bin/cellsignal-dark" probe 2>/dev/null)"; _darkcell_rc=$?
    [ "$_darkcell_rc" = 0 ] || { rm -rf "$_td"; echo "smoke-test: FAIL (dark radio must not change verdict rc, got $_darkcell_rc)"; exit 1; }
    printf '%s' "$_darkcell_out" | grep -q '|cell=UNKNOWN|' || { rm -rf "$_td"; echo "smoke-test: FAIL (dark radio must render cell=UNKNOWN: $_darkcell_out)"; exit 1; }
    echo "cell-arms: ok (stub STRONG annotated, dark radio UNKNOWN with verdict intact)"
  else
    echo "cell-arms: UNKNOWN (live adb dump unreachable, rc=$_cell_rc — annotation arms need the dump leg)"
  fi
  rm -rf "$_td"
  _td="$(mktemp -d)"; MESH_DIR="$_td/.mesh"; TRANSPORT_STATE="$_td/.mesh/transport"; STATE="$_td/.mesh/state"; RUNLOG="$_td/.mesh/run.log"
  mkdir -p "$_td/.mesh"; printf 'REACHED now serial=%s device_uptime_s=1\n' "$SER" >"$TRANSPORT_STATE"
  _out="$(probe)"; _rc=$?; write_reading "$_out" || { rm -rf "$_td"; echo 'smoke-test: FAIL (fixture write)'; exit 1; }; rm -rf "$_td"
  case "$_rc" in 0) echo "smoke-test: ok (transport × connectivity fusion + LIVE ADB read: $_out)"; exit 0;; 2) echo "smoke-test: n/a (offline fusion arms pass; live ADB unreachable: $_out)"; exit 2;; *) echo "smoke-test: FAIL (live read rc=$_rc: $_out)"; exit 1;; esac
fi
_reading="$(probe)"; _rc=$?
write_reading "$_reading" || { echo "mesh-note3-connectivity: failed to write state/log" >&2; exit 1; }
printf '%s\n' "$_reading"
exit "$_rc"
