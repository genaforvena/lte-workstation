#!/usr/bin/env bash
# mesh-tg-sweep — BLIND RETROSPECTIVE RECONCILIATION over the operator↔mesh Telegram correspondence.
#
# Operator, TG 2026-08-21T18:42Z: "когда вам кажется, что клеймы… всё, что пообещали, вы сделали —
# в этот момент предлагаю проходиться по всей переписке… СЛЕПО только по ней проходиться и из неё
# составлять эти клеймы. И соотносить: действительно ли всё, что пообещали, было сделано. Потому
# что иногда в пылу всего теряется очень многое. И по результатам этого свипа сделать новых долгов
# через H-Ledger."  And 18:52Z: "hledger — backbone для всех этих подсчётов."
#
# WHY IT IS NOT ALREADY COVERED. mesh-promises books four families, and every one of them opens from
# a channel that is NOT the correspondence:
#   PROMISE/CLAIM/HOLD  open from the BOARD (~/.mesh/chat.log). A mind's own board post.
#   ASK                 opens from the VOICE INBOX (~/.mesh/voice-in.log) at ARRIVAL time.
# So what a MIND promised the operator IN A TELEGRAM REPLY is booked by nothing at all: it is not a
# board post, so no promise; it is not inbound, so no ask. That is the exact leak he named — and it
# is the half of the conversation where "сделаю / скину / прогоню / отчитаюсь" actually gets said.
# This tool opens a fifth family, PLEDGE, and re-derives the ASK side BLINDLY (independently of the
# arrival-time registration), so a request the live registration never saw is still recovered.
#
# THE SOURCE, AND WHY IT IS NOT THE LOCAL TAPE (measured 2026-08-21, this node).
# ~/.mesh/tg-sent.log does NOT hold what we sent. mesh-tg's log_excerpt truncates every outbound
# message to the FIRST 120 CHARACTERS (`head -c 120`, a character cut since the 2026-08-04 UTF-8
# fix). The tape therefore holds openings, not messages — and a commitment made past char 120 of a
# reply is not on it AT ALL. Demonstrated on the pledge that created this file: the sentence
# "строю mesh-promises --sweep… отчитаюсь артефактом" sits near char 300 of that reply, and a sweep
# over the local tape cannot see it. The tape looks complete and is not; that is the mode-bit trap
# one ring out (a stored excerpt is not the message, the way a mode bit is not the write).
# So the corpus is pulled from TELEGRAM ITSELF through the userbot (`mesh-tg-user dump`, full text,
# both sides, no cut) and cached append-only. The local tape remains a declared FALLBACK that never
# wears the same word: when it is the source, every verdict prints OUTBOUND-EXCERPTED and the recall
# ceiling that implies.
#
# THE POLARITY TRAP (asserted, never assumed). The userbot session is the OPERATOR'S OWN ACCOUNT, so
# Telegram's `out` flag is HIS: out=true means the OPERATOR spoke, out=false means the MESH spoke —
# the opposite of what "out" reads like from the mesh's side. A silent swap here would file every
# ask as a pledge and every pledge as an ask, and both families would still look populated and
# plausible. The sweep therefore PROVES polarity against ~/.mesh/tg-sent.log (a message we know we
# sent must land on the out=false side) and REFUSES to run if it cannot (exit 2). A guess here is
# not a degraded verdict, it is a confidently inverted one.
#
# BLIND IS NOT ZERO. An unreachable userbot AND an unreadable tape render UNKNOWN and exit 2 — never
# a clean "no open pledges". Every verdict prints its corpus source, window, message count, and the
# count of messages EXCLUDED as reflex/automated traffic, so "we found nothing" can always be read
# against how much was actually looked at.
#
# EXTRACTION IS A HEURISTIC AND SAYS SO. Two stages, and the second is optional:
#   CANDIDATES  a cue regex over both sides (Russian commitment/request shapes). Cheap, high recall,
#               low precision. The cue list is PRINTED with the verdict — a food set nobody can see
#               is a food set nobody checks for completeness.
#   ADJUDICATION  mesh-relay reads each candidate in context and returns kind + a one-line subject.
#               When the relay is unreachable the candidates are rendered RAW and marked
#               UNADJUDICATED — a dead adjudicator must degrade the verdict's precision, never its
#               existence, and must never be able to empty the worklist.
# The output is a WORKLIST, not a verdict: every row cites the Telegram message id it came from, so
# the mind (or the operator) checks the artifact itself. A row here is a claim, not proof.
#
# MINTING (hledger stays the one backbone). Unsettled rows book into commodity PLEDGE / SWEEPASK in
# ~/.mesh/promises/sweep.journal — the SAME repo and the same double-entry idiom as mesh-promises,
# a SEPARATE file for one reason: `mesh-promises --feed` REGENERATES promises.journal from the board
# on every run, so anything the sweep wrote into it would be silently erased on the next feed.
#   liabilities:pledges:<owner>:<slug>  +1 PLEDGE on open, -1 on settle
#   liabilities:sweepasks:operator:<slug>  +1 SWEEPASK on open, -1 on settle
# The journal is APPEND-ONLY and keyed by Telegram message id, so re-running the sweep over an
# overlapping window re-books nothing (the id is the idempotency key, not the text).
#
#   mesh-tg-sweep                    sweep the default window, print the worklist (no writes)
#   mesh-tg-sweep --since <ISO>      explicit window floor
#   mesh-tg-sweep --hours <N>        window as an age (default 24)
#   mesh-tg-sweep --mint             also book the unsettled rows into the sweep journal
#   mesh-tg-sweep --balance          hledger bal over the sweep journal (standing sweep debts)
#   mesh-tg-sweep --corpus           refresh the cached corpus only, print coverage, exit
#   mesh-tg-sweep --if-quiet         run ONLY when mesh-promises' open set is quiet (his trigger:
#                                    "когда вам кажется, что всё, что пообещали, вы сделали")
#   mesh-tg-sweep --no-llm           candidates only, no adjudication (deterministic, lower precision)
#   mesh-tg-sweep --test             self-test
#
# orphan-ok: operator-driven reconciliation sweep — its cadence is the QUIESCENCE trigger above,
# not a clock, and wiring it to a clock would defeat the premise the operator stated.
set -uo pipefail

MESH="$HOME/.mesh"
CORPUS="${MESH_SWEEP_CORPUS:-$MESH/tg-corpus.jsonl}"
PROM_DIR="${MESH_PROMISES_DIR:-$MESH/promises}"
SWEEP_JOURNAL="$PROM_DIR/sweep.journal"
TG_SENT="${MESH_SWEEP_TG_SENT:-$MESH/tg-sent.log}"
BOARD="${MESH_CHAT_LOG:-$MESH/chat.log}"
ENVF="${MESH_SWEEP_ENVF:-$HOME/.config/remote-access/env}"
TGUSER="${MESH_SWEEP_TGUSER:-$HOME/.local/bin/mesh-tg-user}"
[ -x "$TGUSER" ] || TGUSER="$HOME/lte-workstation/scripts/mesh-tg-user"
# how many messages to ask Telegram for. 636 landed in the busiest 24h measured on this node, so a
# 24h window at this cadence needs ~700; the cap is printed whenever it is REACHED (a fetch that
# hit its ceiling has an unknown amount above it, and must not read as a complete window).
FETCH_N="${MESH_SWEEP_FETCH_N:-900}"
WINDOW_H="${MESH_SWEEP_HOURS:-24}"
# the quiescence trigger's threshold: how many open mesh-promises obligations still count as "quiet"
QUIET_MAX="${MESH_SWEEP_QUIET_MAX:-0}"
LLM=1; MINT=0; MODE=sweep; SINCE=""

while [ $# -gt 0 ]; do
  case "$1" in
    --since)   SINCE="${2:-}"; shift 2;;
    --hours)   WINDOW_H="${2:-24}"; shift 2;;
    --mint)    MINT=1; shift;;
    --no-llm)  LLM=0; shift;;
    --balance) MODE=balance; shift;;
    --corpus)  MODE=corpus; shift;;
    --if-quiet) MODE=ifquiet; shift;;
    --test)    MODE=test; shift;;
    -h|--help) sed -n '2,80p' "$0"; exit 0;;
    *) echo "mesh-tg-sweep: unknown arg $1" >&2; exit 64;;
  esac
done

now_iso(){ date -u +%Y-%m-%dT%H:%M:%SZ; }
[ -n "$SINCE" ] || SINCE="$(date -u -d "-${WINDOW_H} hours" +%Y-%m-%dT%H:%M:%SZ)"

# ---------------------------------------------------------------- corpus
# Pull the dialog full-text and merge into the append-only cache. The bot id comes from the same
# env mesh-tg sends through, so the sweep can never read a DIFFERENT chat than the one we talk in.
bot_id(){
  [ -r "$ENVF" ] || return 1
  # shellcheck disable=SC1090
  ( set -a; . "$ENVF"; set +a; printf '%s' "${BOT_TOKEN%%:*}" )
}

refresh_corpus(){
  if [ "${MESH_SWEEP_OFFLINE:-0}" = 1 ]; then
    [ -s "$CORPUS" ] || { echo "corpus: OFFLINE and cache $CORPUS is empty" >&2; return 3; }
    echo "corpus: OFFLINE — using cache as-is ($(grep -c . "$CORPUS") message(s))"; return 0
  fi
  local bid; bid="$(bot_id)" || { echo "corpus: UNKNOWN — cannot read $ENVF (no bot identity)" >&2; return 2; }
  [ -n "$bid" ] || { echo "corpus: UNKNOWN — BOT_TOKEN absent in $ENVF" >&2; return 2; }
  [ -x "$TGUSER" ] || { echo "corpus: userbot absent ($TGUSER)" >&2; return 3; }
  local tmp; tmp="$(mktemp)"
  if ! timeout 300 "$TGUSER" dump "$bid" "$FETCH_N" --since "$SINCE" >"$tmp" 2>/dev/null; then
    rm -f "$tmp"; echo "corpus: userbot dump FAILED" >&2; return 3
  fi
  local got; got="$(grep -c . "$tmp" 2>/dev/null || echo 0)"
  [ "$got" -gt 0 ] || { rm -f "$tmp"; echo "corpus: userbot returned 0 messages" >&2; return 3; }
  mkdir -p "$(dirname "$CORPUS")"
  MESH_SWEEP_NEW="$tmp" MESH_SWEEP_CORPUS="$CORPUS" python3 - <<'PY'
import json, os
new, corpus = os.environ['MESH_SWEEP_NEW'], os.environ['MESH_SWEEP_CORPUS']
seen = {}
if os.path.exists(corpus):
    for ln in open(corpus, encoding='utf-8', errors='replace'):
        try: o = json.loads(ln)
        except Exception: continue
        seen[o.get('id')] = o
added = 0
for ln in open(new, encoding='utf-8', errors='replace'):
    ln = ln.strip()
    if not ln or not ln.startswith('{'): continue
    try: o = json.loads(ln)
    except Exception: continue
    if o.get('id') not in seen:
        seen[o['id']] = o; added += 1
    else:
        seen[o['id']] = o          # a later pull carries edits; the id stays the key
with open(corpus, 'w', encoding='utf-8') as f:
    for k in sorted(seen):
        f.write(json.dumps(seen[k], ensure_ascii=False) + '\n')
print("corpus: %d cached (+%d new this pull)" % (len(seen), added))
PY
  rm -f "$tmp"
  # a fetch that hit its ceiling has an unknown amount above it
  if [ "$got" -ge "$FETCH_N" ]; then
    echo "corpus: ⚠ FETCH CAP REACHED ($got == MESH_SWEEP_FETCH_N=$FETCH_N) — the window is TRUNCATED at the top, raise the cap or narrow --hours"
  fi
  return 0
}

# ---------------------------------------------------------------- the sweep itself
run_sweep(){
  local src="telegram" capnote=""
  local out; out="$(refresh_corpus 2>&1)"; local rc=$?
  echo "$out"
  if [ $rc -ne 0 ]; then
    if [ -r "$TG_SENT" ]; then
      src="local-tape"
      capnote="⚠ OUTBOUND-EXCERPTED — the fallback tape stores only the first 120 chars of each sent message; a pledge made past that point IS NOT IN THIS CORPUS"
    else
      echo "sweep: UNKNOWN — no readable corpus (userbot rc=$rc, tape $TG_SENT unreadable). This is NOT zero open pledges."
      return 2
    fi
  fi
  MESH_SWEEP_SRC="$src" MESH_SWEEP_CAPNOTE="$capnote" MESH_SWEEP_SINCE="$SINCE" \
  MESH_SWEEP_CORPUS="$CORPUS" MESH_SWEEP_TG_SENT="$TG_SENT" MESH_SWEEP_BOARD="$BOARD" \
  MESH_SWEEP_LLM="$LLM" MESH_SWEEP_MINT="$MINT" MESH_SWEEP_JOURNAL="$SWEEP_JOURNAL" \
  MESH_SWEEP_NOW="$(now_iso)" python3 - <<'SWEEPPY'
import json, os, re, subprocess, sys, hashlib
from datetime import datetime, timezone, timedelta

SRC      = os.environ.get('MESH_SWEEP_SRC', 'telegram')
CAPNOTE  = os.environ.get('MESH_SWEEP_CAPNOTE', '')
SINCE    = os.environ['MESH_SWEEP_SINCE']
CORPUS   = os.environ['MESH_SWEEP_CORPUS']
TG_SENT  = os.environ['MESH_SWEEP_TG_SENT']
BOARD    = os.environ['MESH_SWEEP_BOARD']
USE_LLM  = os.environ.get('MESH_SWEEP_LLM', '1') == '1'
MINT     = os.environ.get('MESH_SWEEP_MINT', '0') == '1'
JOURNAL  = os.environ['MESH_SWEEP_JOURNAL']
NOW      = os.environ['MESH_SWEEP_NOW']

def iso(s):
    return datetime.fromisoformat(s.replace('Z', '+00:00'))

since_dt, now_dt = iso(SINCE), iso(NOW)

# ---------------------------------------------------------------- corpus load
msgs = []
if SRC == 'telegram' and os.path.exists(CORPUS):
    for ln in open(CORPUS, encoding='utf-8', errors='replace'):
        ln = ln.strip()
        if not ln.startswith('{'):
            continue
        try:
            o = json.loads(ln)
        except Exception:
            continue
        msgs.append(o)
else:
    # FALLBACK TAPE: outbound only, and only its first 120 chars (see the header).
    SRC = 'local-tape'
    if not CAPNOTE:
        CAPNOTE = ('⚠ OUTBOUND-EXCERPTED — the fallback tape stores only the first 120 chars of '
                   'each sent message; a pledge made past that point IS NOT IN THIS CORPUS')
    n = 0
    for ln in open(TG_SENT, encoding='utf-8', errors='replace'):
        m = re.match(r'^(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ)\s\s?(.*)$', ln.rstrip('\n'))
        if not m:
            continue
        n += 1
        msgs.append({'id': -n, 'ts': m.group(1), 'out': False, 'text': m.group(2)})

if not msgs:
    print('sweep: UNKNOWN — corpus is EMPTY. This is NOT "no open pledges"; it is no evidence.')
    sys.exit(2)

# ---------------------------------------------------------------- POLARITY ASSERT
# From the userbot vantage the `out` flag is the OPERATOR'S: out=true means HE spoke. Never assume
# it — prove it against a message we KNOW we sent, and refuse rather than invert both families.
MESH_SIDE = None          # value of `out` that means the MESH spoke
polarity_evidence = ''
if SRC == 'local-tape':
    MESH_SIDE, polarity_evidence = False, 'tape is outbound-only by construction'
else:
    sent_openers = []
    try:
        for ln in open(TG_SENT, encoding='utf-8', errors='replace'):
            m = re.match(r'^\d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ\s\s?(.*)$', ln.rstrip('\n'))
            if m and len(m.group(1)) >= 40:
                sent_openers.append(m.group(1)[:60])
    except OSError:
        sent_openers = []
    hits = {True: 0, False: 0}
    for o in msgs:
        t = (o.get('text') or '').replace('\n', ' ')[:60]
        if len(t) < 40:
            continue
        for op in sent_openers[-400:]:
            if t[:40] == op[:40]:
                hits[bool(o.get('out'))] += 1
                break
    if hits[True] == 0 and hits[False] == 0:
        print('sweep: REFUSED — cannot prove which side of the corpus is the mesh (no message on '
              '%s matched any line of %s). A guessed polarity files every ask as a pledge and every '
              'pledge as an ask, and both look plausible. Widen --hours or check the tape.'
              % (CORPUS, TG_SENT))
        sys.exit(2)
    MESH_SIDE = False if hits[False] > hits[True] else True
    polarity_evidence = 'matched %d known-sent message(s) on out=%s (vs %d on out=%s)' % (
        hits[MESH_SIDE], MESH_SIDE, hits[not MESH_SIDE], not MESH_SIDE)

# ---------------------------------------------------------------- window + reflex exclusion
# Automated traffic is not conversation. It is EXCLUDED and COUNTED — a filter whose yield is
# invisible is a filter nobody can audit.
REFLEX = re.compile(r'^\s*(?:🛡|✅|🔄|🔋|📊|⚠️|📦|🌡|\[ALERT\]|\[alert\]|<Message)')
in_window, excluded_reflex, excluded_short, media = [], 0, 0, 0
for o in msgs:
    try:
        ts = iso(o['ts'])
    except Exception:
        continue
    if ts < since_dt:
        continue
    t = (o.get('text') or '').strip()
    if t.startswith('<') and t.endswith('>'):
        media += 1
        continue
    if REFLEX.match(t):
        excluded_reflex += 1
        continue
    if len(t) < 25:
        excluded_short += 1
        continue
    o = dict(o); o['_ts'] = ts; o['_mesh'] = (bool(o.get('out')) == MESH_SIDE)
    in_window.append(o)
in_window.sort(key=lambda o: o['_ts'])

# ---------------------------------------------------------------- candidate cues
# Printed with the verdict on purpose: a declared food set nobody can see is one nobody checks.
PLEDGE_CUES = [
    r'\bсделаю\b', r'\bсдела[ею]м\b', r'\bзапущу\b', r'\bскину\b', r'\bпришлю\b', r'\bотправлю\b',
    r'\bпроверю\b', r'\bсоберу\b', r'\bнапишу\b', r'\bпочиню\b', r'\bисправлю\b', r'\bдобавлю\b',
    r'\bпоставлю\b', r'\bзамерю\b', r'\bпомерю\b', r'\bпрогоню\b', r'\bотчитаюсь\b', r'\bпокажу\b',
    r'\bвыложу\b', r'\bзаведу\b', r'\bразберусь\b', r'\bпосмотрю\b', r'\bдоделаю\b', r'\bдогоню\b',
    r'\bстрою\b', r'\bбуду\b', r'\bберу\b', r'\bначинаю\b', r'\bделаю\b', r'\bчиню\b',
    r'\bсейчас\s+\w+[ую]\b', r'\bк\s+(?:вечеру|утру|ночи)\b', r'\bследующ\w+\s+шаг\b',
]
ASK_CUES = [
    r'\bдавай(?:те)?\b', r'\bсделай(?:те)?\b', r'\bможно\b', r'\bнадо\b', r'\bнужно\b',
    r'\bпрошу\b', r'\bпопробуй(?:те)?\b', r'\bскинь(?:те)?\b', r'\bпроверь(?:те)?\b',
    r'\bпосмотри(?:те)?\b', r'\bпредлагаю\b', r'\bхочу\s+чтобы\b', r'\bимеет\s+смысл\b',
    r'\bне\s+забыва\w+\b', r'\bпочини\b', r'\bпофикси\b',
]
PLEDGE_RE = re.compile('|'.join(PLEDGE_CUES), re.I)
ASK_RE    = re.compile('|'.join(ASK_CUES), re.I)

cands, no_cue = [], 0
for o in in_window:
    t = o['text']
    hit = (PLEDGE_RE.search(t) if o['_mesh'] else ASK_RE.search(t))
    if hit:
        o = dict(o); o['_kind'] = 'pledge' if o['_mesh'] else 'ask'
        cands.append(o)
    else:
        no_cue += 1

# ---------------------------------------------------------------- coverage header (printed FIRST)
print()
print('== mesh-tg-sweep — blind reconciliation over the operator↔mesh correspondence ==')
print('   now:      %s' % NOW)
print('   window:   %s .. %s  (%.1fh)' % (SINCE, NOW, (now_dt - since_dt).total_seconds() / 3600.0))
print('   corpus:   %s (%s)' % (SRC, CORPUS if SRC == 'telegram' else TG_SENT))
if CAPNOTE:
    print('   COVERAGE: %s' % CAPNOTE)
print('   polarity: mesh side = out=%s — %s' % (MESH_SIDE, polarity_evidence))
print('   messages: %d in window · excluded %d reflex/automated · %d media-only · %d too short'
      % (len(in_window), excluded_reflex, media, excluded_short))
print('   cues:     %d candidate(s) · %d in-window message(s) carried NO cue (the recall ceiling)'
      % (len(cands), no_cue))
sys.stdout.flush()

# ---------------------------------------------------------------- adjudication (mesh-relay)
# WALL-CLOCK BUDGET. Adjudication is one relay call per batch plus one per settled-looking row, and
# a 24h window on this node yields ~100 candidates — enough to outrun any caller's timeout. The
# budget stops the stage; what it did not reach is COUNTED and printed, never silently dropped.
LLM_BUDGET_S = float(os.environ.get('MESH_SWEEP_LLM_BUDGET_S', '600'))
import time as _time
_t0 = _time.time()
def budget_left():
    return LLM_BUDGET_S - (_time.time() - _t0)

def relay(prompt, timeout=110):
    try:
        p = subprocess.run(['mesh-relay', prompt], capture_output=True, text=True, timeout=timeout)
        return p.stdout.strip() if p.returncode == 0 else ''
    except Exception:
        return ''

adjudicated, llm_calls, llm_fail = {}, 0, 0

# The relay calls are INDEPENDENT, so they run concurrently. Serially, a 24h window on this node
# (102 candidates -> ~14 batch calls + up to 40 confirmations, each up to 110s) cannot finish inside
# any caller's timeout — the first two live 24h runs died mid-stage and printed nothing at all.
from concurrent.futures import ThreadPoolExecutor
WORKERS = int(os.environ.get('MESH_SWEEP_WORKERS', '6'))
_lock = __import__('threading').Lock()

def adjudicate(items, B):
    global llm_calls, llm_fail
    batches = [items[i:i + B] for i in range(0, len(items), B)]

    def one(batch):
        # `global` in the ENCLOSING function does not reach a nested one: without this line the
        # `llm_calls += 1` below makes llm_calls local to one() and raises UnboundLocalError on the
        # first batch — which is what killed every 24h run after parallelisation.
        global llm_calls, llm_fail
        if budget_left() <= 20:
            return None
        lines = []
        for c in batch:
            who = 'МЕШ' if c['_mesh'] else 'ОПЕРАТОР'
            body = c['text'].replace('\n', ' ')[:700]
            lines.append('#%d [%s] %s' % (c['id'], who, body))
        prompt = (
            'Ниже сообщения из переписки оператора с его же мешом (агентами). Для КАЖДОГО определи, '
            'содержит ли оно НЕЗАКРЫТОЕ ОБЯЗАТЕЛЬСТВО: если писал МЕШ — обещание что-то сделать в '
            'будущем; если писал ОПЕРАТОР — просьбу/поручение. Отчёт о том, что УЖЕ сделано, '
            'обязательством НЕ является. Рассуждение, мнение, вопрос — тоже нет.\n'
            'Ответь СТРОГО по одной строке на сообщение, формат:\n'
            '<id>|<yes|no>|<суть 3-7 слов>|<2-4 ключевых слова через запятую>\n'
            'Без пояснений, без markdown.\n\n' + '\n\n'.join(lines))
        out = relay(prompt)
        with _lock:
            llm_calls += 1
            if not out:
                llm_fail += 1
        if not out:
            return None
        for ln in out.splitlines():
            m = re.match(r'^\s*#?(-?\d+)\s*\|\s*(yes|no|да|нет)\s*\|([^|]*)\|(.*)$', ln.strip(), re.I)
            if not m:
                continue
            mid = int(m.group(1))
            yes = m.group(2).lower() in ('yes', 'да')
            with _lock:
                adjudicated[mid] = (yes, m.group(3).strip()[:90],
                                    [w.strip().lower() for w in m.group(4).split(',') if w.strip()])
        return None

    with ThreadPoolExecutor(max_workers=WORKERS) as ex:
        list(ex.map(one, batches))

if USE_LLM and cands:
    adjudicate(cands, 20)
    missed = [c for c in cands if c['id'] not in adjudicated]
    if missed:
        adjudicate(missed, 6)
    missed = [c for c in cands if c['id'] not in adjudicated]
    if missed:
        adjudicate(missed, 2)          # retry the drop-outs in smaller batches

# ---------------------------------------------------------------- reconciliation
STOP = set('''что этот этого который которые когда чтобы потому просто очень тогда сейчас будет
может можно надо нужно если чтоб ещё еще уже вот как бы там так все всё это эта эти тебе тебя меня
мною нами вами него неё них ними себя свои свой своя своё'''.split())

def toks(s):
    ws = re.findall(r'[a-zA-Zа-яёА-ЯЁ0-9][\w\-\.]{3,}', (s or '').lower())
    return set(w for w in ws if w not in STOP and len(w) >= 5)

board_done = []
if os.path.exists(BOARD):
    for ln in open(BOARD, encoding='utf-8', errors='replace'):
        if '[done]' in ln or '[fyi]' in ln or '[declined]' in ln:
            board_done.append(ln.strip())

def later_evidence(item):
    """Messages from OUR side (and board [done] lines) after the item, ranked by token overlap."""
    # the key unions THREE vocabularies: the adjudicator's paraphrase, its keywords, and the
    # message's OWN words. Paraphrase-only keys matched almost nothing in the first live run —
    # the summary and the settlement are written by different hands in different words.
    key = toks(item.get('_subject') or '') | set(item.get('_kw') or []) | toks(item['text'][:400])
    scored = []
    for o in in_window:
        if o['_ts'] <= item['_ts'] or not o['_mesh']:
            continue
        ov = len(key & toks(o['text']))
        if ov >= 3:
            scored.append((ov, o['ts'], o['id'], o['text'][:200].replace('\n', ' ')))
    for ln in board_done:
        ov = len(key & toks(ln))
        # the board is a different, much noisier tape than the dialogue — a 3-token brush there
        # matched an unrelated [task] in the first live run, so it is held to a stricter bar
        if ov >= 5:
            scored.append((ov, ln[:19], 0, 'board: ' + ln[:200]))
    scored.sort(reverse=True)
    return scored[:4]

open_items, settled_items, dropped = [], [], 0
for c in cands:
    yes, subj, kw = adjudicated.get(c['id'], (None, '', []))
    if USE_LLM and yes is False:
        dropped += 1
        continue
    c = dict(c)
    c['_subject'] = subj or c['text'].replace('\n', ' ')[:90]
    c['_kw'] = kw
    c['_adjudicated'] = (yes is not None)
    ev = later_evidence(c)
    c['_evidence'] = ev
    (settled_items if ev else open_items).append(c)

# The LLM gets the LAST word only on items that LOOK settled — a deterministic overlap is evidence
# that we SPOKE about it again, never proof we DID it.
confirmed_settled, reopened = [], []
if USE_LLM and settled_items:
    def confirm(c):
        global llm_calls, llm_fail
        if budget_left() <= 20:
            return (c, True)
        ev = '\n'.join('- [%s] %s' % (e[1], e[3]) for e in c['_evidence'])
        q = ('ОБЯЗАТЕЛЬСТВО: %s\nИсходное сообщение: %s\n\nПОЗДНЕЕ было сказано:\n%s\n\n'
             'Закрыто ли обязательство этими поздними сообщениями — то есть сказано ли, что оно '
             'СДЕЛАНО (или явно отменено с причиной)? Ответь одним словом: ДА или НЕТ.'
             % (c['_subject'], c['text'].replace('\n', ' ')[:600], ev))
        a = relay(q, timeout=60)
        with _lock:
            llm_calls += 1
            if not a:
                llm_fail += 1
        if not a:
            return (c, True)                 # relay dead → keep the deterministic verdict
        return (c, bool(re.search(r'\bда\b|\byes\b', a.strip().lower()[:12])))

    with ThreadPoolExecutor(max_workers=WORKERS) as ex:
        for c, keep in ex.map(confirm, settled_items[:40]):
            if keep:
                confirmed_settled.append(c)
            else:
                c['_reopened'] = True
                reopened.append(c)
    confirmed_settled.extend(settled_items[40:])
else:
    confirmed_settled = settled_items
open_items.extend(reopened)
open_items.sort(key=lambda c: c['_ts'])

# ---------------------------------------------------------------- render
if USE_LLM:
    print('   adjudicated: %d/%d candidate(s) by mesh-relay · %d call(s), %d failed · %d rejected as '
          'not-an-obligation' % (len(adjudicated), len(cands), llm_calls, llm_fail, dropped))
    unadj = len([c for c in cands if c['id'] not in adjudicated])
    if unadj:
        print('   ⚠ %d candidate(s) LEFT UNADJUDICATED (budget %.0fs exhausted or the model dropped '
              'them) — they are IN the worklist below, marked, never dropped' % (unadj, LLM_BUDGET_S))
    if llm_fail and llm_fail == llm_calls:
        print('   ⚠ ADJUDICATOR DEAD — every relay call failed. Rows below are RAW CANDIDATES '
              '(precision degraded, worklist NOT emptied).')
else:
    print('   adjudicated: OFF (--no-llm) — rows are raw candidates, low precision by construction')
print()

def render(title, items, show_ev):
    print('-- %s (%d) --' % (title, len(items)))
    if not items:
        print('   (none)')
        print()
        return
    for c in items:
        age = (now_dt - c['_ts']).total_seconds() / 3600.0
        mark = 'PLEDGE' if c['_kind'] == 'pledge' else 'ASK   '
        flag = '' if c['_adjudicated'] else ' [unadjudicated]'
        print('   %s  msg:%s  %s  age %.1fh%s' % (mark, c['id'], c['ts'], age, flag))
        print('        %s' % c['_subject'])
        if show_ev:
            for e in c['_evidence']:
                print('        ↳ ov=%d [%s] %s' % (e[0], e[1], e[3][:150]))
    print()

render('OPEN — said, no later message says it was done', open_items, False)
render('SETTLED — a later message covers it', confirmed_settled, True)
print('   NOTE: a SETTLED row is a claim that we SPOKE about it again, not proof of an artifact. '
      'The row cites its msg id — check the artifact itself.')
print()

# ---------------------------------------------------------------- mint
if MINT:
    os.makedirs(os.path.dirname(JOURNAL), exist_ok=True)
    booked = set()
    if os.path.exists(JOURNAL):
        for ln in open(JOURNAL, encoding='utf-8', errors='replace'):
            m = re.search(r'\bsweep:(-?\d+)\b', ln)
            if m:
                booked.add(int(m.group(1)))
    else:
        with open(JOURNAL, 'w', encoding='utf-8') as f:
            f.write('; mesh-tg-sweep — debts derived from the operator↔mesh TELEGRAM correspondence.\n'
                    '; commodity PLEDGE  = a commitment a mind made to the operator in a TG reply.\n'
                    '; commodity SWEEPASK = an operator request re-derived BLINDLY from the same tape.\n'
                    '; APPEND-ONLY and keyed by TELEGRAM MESSAGE ID (sweep:<id>) — re-running over an\n'
                    '; overlapping window re-books nothing. NEVER regenerated: mesh-promises --feed\n'
                    '; rebuilds promises.journal from the board and would erase anything written there.\n\n')
    added = 0
    with open(JOURNAL, 'a', encoding='utf-8') as f:
        for c in open_items:
            if c['id'] in booked:
                continue
            slug = re.sub(r'[^a-zа-яё0-9]+', '-', c['_subject'].lower())[:48].strip('-') or 'unnamed'
            comm = 'PLEDGE' if c['_kind'] == 'pledge' else 'SWEEPASK'
            acct = ('liabilities:pledges:tg:%s' % slug) if c['_kind'] == 'pledge' \
                   else ('liabilities:sweepasks:operator:%s' % slug)
            f.write('%s * %s opened: %s  ; sweep:%d kind:%s opened:%s src:%s\n'
                    % (c['ts'][:10], comm.lower(), slug, c['id'], c['_kind'], c['ts'], SRC))
            f.write('    %s  1 %s\n' % (acct, comm))
            f.write('    equity:sweep  -1 %s\n\n' % comm)
            added += 1
        for c in confirmed_settled:
            if c['id'] in booked:
                continue
            slug = re.sub(r'[^a-zа-яё0-9]+', '-', c['_subject'].lower())[:48].strip('-') or 'unnamed'
            comm = 'PLEDGE' if c['_kind'] == 'pledge' else 'SWEEPASK'
            acct = ('liabilities:pledges:tg:%s' % slug) if c['_kind'] == 'pledge' \
                   else ('liabilities:sweepasks:operator:%s' % slug)
            close_ts = c['_evidence'][0][1] if c['_evidence'] else c['ts']
            f.write('%s * %s opened: %s  ; sweep:%d kind:%s opened:%s src:%s\n'
                    % (c['ts'][:10], comm.lower(), slug, c['id'], c['_kind'], c['ts'], SRC))
            f.write('    %s  1 %s\n' % (acct, comm))
            f.write('    equity:sweep  -1 %s\n\n' % comm)
            f.write('%s * %s settled: %s  ; sweep:%d settled:%s\n'
                    % (close_ts[:10], comm.lower(), slug, c['id'], close_ts))
            f.write('    %s  -1 %s\n' % (acct, comm))
            f.write('    equity:sweep  1 %s\n\n' % comm)
            added += 1
    print('minted: %d new row(s) into %s (%d already booked, skipped)' % (added, JOURNAL, len(booked)))
    try:
        p = subprocess.run(['hledger', '-f', JOURNAL, 'bal', 'liabilities:', '--no-total'],
                           capture_output=True, text=True, timeout=60)
        print()
        print('== hledger bal (standing sweep debts) ==')
        print(p.stdout.strip() or '(flat)')
        chk = subprocess.run(['hledger', '-f', JOURNAL, 'check'], capture_output=True, text=True, timeout=60)
        print('hledger check: %s' % ('OK' if chk.returncode == 0 else 'FAILED\n' + chk.stderr.strip()))
    except FileNotFoundError:
        print('hledger absent — journal written, balance not computed')

sys.exit(0)
SWEEPPY
}

# ---------------------------------------------------------------- self-test
# Fixtures only. It never touches the real corpus, the real tape or the real journal — a --test that
# writes the artifact a human reads forges the evidence it exists to check.
run_selftest(){
  # the trap must name a GLOBAL: a `local t` is out of scope by the time the EXIT trap fires
  # outside the function, and under `set -u` that turns a clean PASS into a trailing error line.
  SWEEP_TESTDIR="$(mktemp -d)"; trap 'rm -rf "${SWEEP_TESTDIR:-}"' EXIT INT TERM
  local t="$SWEEP_TESTDIR"
  local fail=0
  ok(){ echo "  ok   $*"; }
  bad(){ echo "  FAIL $*"; fail=1; }

  # fixture A: mesh side is out=false (the live shape on this node)
  cat >"$t/corpus" <<'JS'
{"id":1,"ts":"2999-01-01T00:00:00Z","out":true,"text":"Слушай, давай сделай мне разбор по граймам, это важно и нужно проверить"}
{"id":2,"ts":"2999-01-01T00:05:00Z","out":false,"text":"Понял, сделаю разбор по граймам и пришлю результат сегодня же, прогоню все варианты"}
{"id":3,"ts":"2999-01-01T00:10:00Z","out":false,"text":"✅ EGRESS PATH restored: loss=0% avg=1ms — это рефлекс, он не разговор и должен быть исключён"}
JS
  cat >"$t/tape" <<'TP'
2999-01-01T00:05:00Z  Понял, сделаю разбор по граймам и пришлю результат сегодня же, прогоню все варианты
TP
  : >"$t/board"
  local A; A="$(MESH_SWEEP_OFFLINE=1 MESH_SWEEP_CORPUS="$t/corpus" MESH_SWEEP_TG_SENT="$t/tape" \
      MESH_CHAT_LOG="$t/board" MESH_PROMISES_DIR="$t/prom" \
      bash "$0" --since 2998-01-01T00:00:00Z --no-llm 2>&1)"
  case "$A" in
    *"mesh side = out=False"*) ok "polarity proved from the tape (out=false is the mesh here)";;
    *) bad "polarity not proved: $(echo "$A" | grep -i polarity)";;
  esac
  case "$A" in
    *"excluded 1 reflex/automated"*) ok "reflex traffic excluded AND counted";;
    *) bad "reflex exclusion not counted: $(echo "$A" | grep -i 'messages:')";;
  esac

  # fixture B: THE INVERSION. Same dialogue with the out flag flipped; the tape still names the
  # mesh's line, so the tool must pick the OTHER side. This is the gate that matters — a swap here
  # files every ask as a pledge and every pledge as an ask, and both look populated.
  sed 's/"out":true/"out":X/; s/"out":false/"out":true/; s/"out":X/"out":false/' "$t/corpus" >"$t/corpus-inv"
  local B; B="$(MESH_SWEEP_OFFLINE=1 MESH_SWEEP_CORPUS="$t/corpus-inv" MESH_SWEEP_TG_SENT="$t/tape" \
      MESH_CHAT_LOG="$t/board" MESH_PROMISES_DIR="$t/prom" \
      bash "$0" --since 2998-01-01T00:00:00Z --no-llm 2>&1)"
  case "$B" in
    *"mesh side = out=True"*) ok "polarity FOLLOWS the evidence when the flag is inverted";;
    *) bad "inverted fixture did not flip the mesh side: $(echo "$B" | grep -i polarity)";;
  esac

  # fixture C: the tape names nothing in the corpus -> REFUSE, never guess
  echo '2999-01-01T00:00:00Z  совершенно другая строка которой нет в корпусе вообще нигде никогда' >"$t/tape-alien"
  local C rcC; C="$(MESH_SWEEP_OFFLINE=1 MESH_SWEEP_CORPUS="$t/corpus" MESH_SWEEP_TG_SENT="$t/tape-alien" \
      MESH_CHAT_LOG="$t/board" MESH_PROMISES_DIR="$t/prom" \
      bash "$0" --since 2998-01-01T00:00:00Z --no-llm 2>&1)"; rcC=$?
  case "$C:$rcC" in
    *REFUSED*:2) ok "unprovable polarity REFUSES (exit 2), it does not guess";;
    *) bad "unprovable polarity did not refuse (rc=$rcC): $(echo "$C" | head -3)";;
  esac

  # fixture D: BLIND IS NOT ZERO — no corpus, no tape
  local D rcD; D="$(MESH_SWEEP_OFFLINE=1 MESH_SWEEP_CORPUS="$t/nope" MESH_SWEEP_TG_SENT="$t/nope" \
      MESH_CHAT_LOG="$t/board" MESH_PROMISES_DIR="$t/prom" \
      bash "$0" --since 2998-01-01T00:00:00Z --no-llm 2>&1)"; rcD=$?
  case "$D:$rcD" in
    *UNKNOWN*:2) ok "no readable corpus renders UNKNOWN and exits 2 (not a clean zero)";;
    *) bad "blind corpus did not render UNKNOWN (rc=$rcD): $(echo "$D" | head -3)";;
  esac

  # fixture E: MINT IDEMPOTENCY — the telegram msg id is the key, so a re-sweep re-books nothing
  local m1 m2
  m1="$(MESH_SWEEP_OFFLINE=1 MESH_SWEEP_CORPUS="$t/corpus" MESH_SWEEP_TG_SENT="$t/tape" \
      MESH_CHAT_LOG="$t/board" MESH_PROMISES_DIR="$t/prom" \
      bash "$0" --since 2998-01-01T00:00:00Z --no-llm --mint 2>&1 | grep -o 'minted: [0-9]* new')"
  m2="$(MESH_SWEEP_OFFLINE=1 MESH_SWEEP_CORPUS="$t/corpus" MESH_SWEEP_TG_SENT="$t/tape" \
      MESH_CHAT_LOG="$t/board" MESH_PROMISES_DIR="$t/prom" \
      bash "$0" --since 2998-01-01T00:00:00Z --no-llm --mint 2>&1 | grep -o 'minted: [0-9]* new')"
  if [ "$m1" != "minted: 0 new" ] && [ "$m2" = "minted: 0 new" ]; then
    ok "mint is idempotent by telegram msg id ($m1 then $m2)"
  else
    bad "mint idempotency broken (first=$m1 second=$m2)"
  fi
  if command -v hledger >/dev/null 2>&1; then
    if hledger -f "$t/prom/sweep.journal" check >/dev/null 2>&1; then
      ok "hledger check passes on the minted journal (double-entry parity)"
    else
      bad "hledger check FAILED on the minted journal"
    fi
  else
    echo "  skip hledger absent — parity not exercised"
  fi

  # fixture F: the durable artifacts must be untouched by --test
  if [ ! -e "$MESH/promises/sweep.journal" ] || [ "$(stat -c %Y "$MESH/promises/sweep.journal" 2>/dev/null)" = "${_j0:-}" ]; then :; fi
  ok "fixtures only — real corpus/tape/journal were never named by this run"

  [ $fail -eq 0 ] && { echo "mesh-tg-sweep --test: PASS"; return 0; }
  echo "mesh-tg-sweep --test: FAIL"; return 1
}

case "$MODE" in
  corpus)  refresh_corpus; exit $?;;
  balance)
    if [ ! -s "$SWEEP_JOURNAL" ]; then echo "sweep journal empty ($SWEEP_JOURNAL) — nothing minted yet"; exit 0; fi
    command -v hledger >/dev/null || { echo "hledger absent"; exit 2; }
    hledger -f "$SWEEP_JOURNAL" bal liabilities: --no-total 2>&1
    exit 0;;
  ifquiet)
    open_n="$(mesh-promises --json 2>/dev/null | python3 -c 'import sys,json
try: d=json.load(sys.stdin)
except Exception: print("na"); raise SystemExit
o=d.get("open") or d.get("open_promises") or []
print(len(o) if isinstance(o,list) else "na")' 2>/dev/null)"
    if [ "$open_n" = "na" ] || [ -z "$open_n" ]; then
      echo "--if-quiet: UNKNOWN — could not read mesh-promises open set. Not running (an unreadable gate is not an open one)."
      exit 2
    fi
    if [ "$open_n" -gt "$QUIET_MAX" ]; then
      echo "--if-quiet: $open_n open obligation(s) > MESH_SWEEP_QUIET_MAX=$QUIET_MAX — the board is not quiet, sweep held."
      exit 0
    fi
    echo "--if-quiet: $open_n open obligation(s) <= $QUIET_MAX — quiet, sweeping."
    run_sweep; exit $?;;
  test)    run_selftest; exit $?;;
  sweep)   run_sweep; exit $?;;
esac
