#!/usr/bin/env bash
# mesh-tg-guard — the SHARED sign-guard for EVERY outbound Telegram send. Borrowing #4 from the
# operator's work mesh (guy-fawxible / Foxible), re-derived as OUR tool over OUR primitives — never
# their repo/instance. Makes [[telegram-personal-only-not-foxible]] STRUCTURAL, not disciplinary:
# a send must pass an audience/sign check or it is REFUSED + logged, NEVER silently sent to the wrong
# channel. fail-CLOSED — an unknown sign / unknown audience / non-allowlisted id REFUSES, never sends.
#
# WHY: ~11 independent senders (mesh-tg, mesh-voice-tx, mesh-tg-roz, mesh-voice-rx, mesh-roz-channel,
# mesh-tg-typing, mesh-cam-watch, mesh-room-music, mesh-steward-deadman, bore-mtg.sh, ngrok-notify.sh)
# each curl api.telegram.org with their own CHAT_ID. mesh-tg had the only guard, INLINE. This is the
# one shared chokepoint they all route through, so the policy lives in ONE place.
#
# POLICY (audience → allowed chat_id):
#   personal : a POSITIVE id (DM) AND in the personal allowlist {MESH_TG_PERSONAL_ID:-51010427}
#              (+ MESH_OWNER_CHAT if set). Telegram DMs have positive ids; groups/channels are negative.
#   channel  : a NEGATIVE id (-100…) AND in MESH_TG_ALLOWED_CHANNELS (csv; EMPTY default → DENY).
#              → on this mesh nothing is allowlisted, so a channel send is structurally IMPOSSIBLE.
#   else (unknown audience / bad sign / non-numeric / not-allowlisted) → REFUSE.
#
# Verbs:
#   mesh-tg-guard --check <chat_id> [audience]                 validate only; exit 0 allowed / 3 refused
#                                                              (reason → stderr + ~/.mesh/tg-guard.log)
#   mesh-tg-guard --send  <chat_id> <text> [audience] [--silent]
#                                                              guard FUSED with a chunked sendMessage —
#                                                              the structural door (can't send unguarded)
#   mesh-tg-guard --test                                       smoke (pure: sign_of / chat_allowed)
#
# audience defaults to 'personal' (this mesh's only sanctioned audience).
#
# reflex-cadence: none
# orphan-ok: on-demand guard primitive — sourced/called by the TG senders at their send site, not
#            cron-wired. (The inc2 detector that greps for senders bypassing it WILL be wired.)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"   # cron self-defense (siblings by bare name); see mesh-claim

GLOG="${MESH_TG_GUARD_LOG:-$HOME/.mesh/tg-guard.log}"
PERSONAL_ID="${MESH_TG_PERSONAL_ID:-51010427}"     # the operator's personal DM (telegram-personal-only)
OWNER_CHAT="${MESH_OWNER_CHAT:-}"                   # optional extra exact-pin (back-compat w/ mesh-tg)
ALLOWED_CHANNELS="${MESH_TG_ALLOWED_CHANNELS:-}"    # csv of -100… ids; EMPTY = no channel allowed
ENVF="${MESH_TG_ENVF:-$HOME/.config/remote-access/env}"   # BOT_TOKEN source for --send

# --- pure: the SIGN/shape of a chat_id -> pos | neg | invalid (Telegram DMs +, groups/channels -) ---
sign_of() {  # <chat_id> -> pos|neg|invalid
  local id="${1:-}"
  if   [[ "$id" =~ ^-[0-9]+$ ]]; then echo neg
  elif [[ "$id" =~ ^[0-9]+$  ]]; then echo pos
  else echo invalid; fi
}

# --- pure: is <needle> a member of the csv <list>? ---------------------------------------------------
csv_has() {  # <csv> <needle> -> 0 yes / 1 no
  case ",${1:-}," in *,"$2",*) return 0 ;; *) return 1 ;; esac
}

# --- pure: the whole policy. echoes a REASON + returns 1 on deny; returns 0 (silent) on allow. -------
#     args: <chat_id> <audience> <personal_id> <owner_chat> <allowed_channels_csv>
chat_allowed() {
  local id="$1" aud="$2" pid="$3" owner="$4" chans="$5" s
  s="$(sign_of "$id")"
  [ "$s" = invalid ] && { echo "non-numeric chat_id '$id'"; return 1; }
  case "$aud" in
    personal)
      [ "$s" = pos ] || { echo "personal audience requires a POSITIVE (DM) chat_id; got $id ($s) — likely a group/channel"; return 1; }
      if   [ "$id" = "$pid" ]; then return 0
      elif [ -n "$owner" ] && [ "$id" = "$owner" ]; then return 0
      else echo "chat_id $id not in personal allowlist {$pid${owner:+,$owner}}"; return 1; fi ;;
    channel|team)
      [ "$s" = neg ] || { echo "channel audience requires a NEGATIVE (-100…) chat_id; got $id ($s)"; return 1; }
      csv_has "$chans" "$id" || { echo "chat_id $id not in MESH_TG_ALLOWED_CHANNELS (empty → deny)"; return 1; }
      return 0 ;;
    *) echo "unknown audience '$aud' (want personal|channel)"; return 1 ;;
  esac
}

# --- guard-or-refuse: log + stderr on deny; the one place a refusal is recorded --------------------
guard_or_die() {  # <chat_id> <audience> -> 0 allow / 3 refuse(+log)
  local r
  if ! r="$(chat_allowed "$1" "$2" "$PERSONAL_ID" "$OWNER_CHAT" "$ALLOWED_CHANNELS")"; then
    printf '%sZ  REFUSED chat_id=%s audience=%s — %s\n' "$(date -u +%FT%T)" "$1" "$2" "$r" >> "$GLOG" 2>/dev/null || true
    echo "mesh-tg-guard: REFUSED — $r (chat_id=$1, audience=$2)" >&2
    return 3
  fi
  return 0
}

case "${1:-}" in
  --test)
    f=""
    # sign_of
    [ "$(sign_of 51010427)"        = pos ]     || f="$f sign-pos"
    [ "$(sign_of -1001234567890)"  = neg ]     || f="$f sign-neg"
    [ "$(sign_of abc)"             = invalid ] || f="$f sign-alpha"
    [ "$(sign_of '')"              = invalid ] || f="$f sign-empty"
    [ "$(sign_of 12.3)"            = invalid ] || f="$f sign-float"
    [ "$(sign_of ' 51010427')"     = invalid ] || f="$f sign-space"   # no sneaky whitespace
    # csv_has
    csv_has '-100777,-100888' -100777   || f="$f csv-hit"
    ! csv_has '-100777' -100999         || f="$f csv-miss"
    ! csv_has '' -100777                || f="$f csv-empty"
    # chat_allowed — personal happy path
    chat_allowed 51010427 personal 51010427 '' '' >/dev/null            || f="$f allow-personal"
    # personal REJECTS a negative id (the 2026-06-10 leak case)
    ! chat_allowed -1001234 personal 51010427 '' '' >/dev/null          || f="$f reject-neg-as-personal"
    # personal REJECTS a different positive id (wrong person)
    ! chat_allowed 99999 personal 51010427 '' '' >/dev/null             || f="$f reject-wrong-person"
    # channel REQUIRES negative + allowlist; empty allowlist → deny
    ! chat_allowed -100777 channel 51010427 '' '' >/dev/null            || f="$f reject-chan-noallowlist"
    chat_allowed -100777 channel 51010427 '' '-100777' >/dev/null       || f="$f allow-chan-allowlisted"
    # channel REJECTS a positive id (swap)
    ! chat_allowed 51010427 channel 51010427 '' '-100777' >/dev/null    || f="$f reject-positive-as-chan"
    # unknown audience → deny (fail-closed)
    ! chat_allowed 51010427 bogus 51010427 '' '' >/dev/null             || f="$f reject-unknown-aud"
    # non-numeric → deny
    ! chat_allowed 'abc;rm' personal 51010427 '' '' >/dev/null          || f="$f reject-nonnumeric"
    # owner-pin allows an extra exact id
    chat_allowed 777 personal 51010427 777 '' >/dev/null                || f="$f allow-owner-pin"
    if [ -n "$f" ]; then echo "smoke-test: FAIL ($f )"; exit 1; fi
    echo "smoke-test: ok (sign_of, csv_has, chat_allowed: personal/channel/sign/allowlist/owner-pin, fail-closed)"; exit 0 ;;

  --check)
    id="${2:-}"; aud="${3:-personal}"
    if guard_or_die "$id" "$aud"; then echo "allowed: chat_id=$id audience=$aud"; exit 0; else exit 3; fi ;;

  --send)
    id="${2:-}"; text="${3:-}"; aud="${4:-personal}"; silent=false
    [ "${5:-}" = "--silent" ] && silent=true
    [ -n "$id" ] && [ -n "$text" ] || { echo "mesh-tg-guard --send: usage --send <chat_id> <text> [audience] [--silent]" >&2; exit 64; }
    guard_or_die "$id" "$aud" || exit 3            # the chokepoint: no send without passing the guard
    [ -f "$ENVF" ] && { set -a; . "$ENVF"; set +a; }
    TOKEN="${BOT_TOKEN:-}"; [ -n "$TOKEN" ] || { echo "mesh-tg-guard --send: BOT_TOKEN not set in $ENVF" >&2; exit 1; }
    rc=0
    while [ -n "$text" ]; do                        # Telegram caps a message at 4096 chars → chunk
      chunk="$(printf '%s' "$text" | head -c 3900)"; text="$(printf '%s' "$text" | tail -c +3901)"
      printf '%s' "$(curl -s -X POST "https://api.telegram.org/bot${TOKEN}/sendMessage" \
        --data-urlencode "chat_id=$id" --data-urlencode "text=$chunk" \
        -d "disable_notification=$silent" 2>/dev/null)" | grep -q '"ok":true' || rc=1
    done
    [ "$rc" = 0 ] && echo "sent: chat_id=$id audience=$aud" || echo "mesh-tg-guard --send: delivery failed (chat_id=$id)" >&2
    exit "$rc" ;;

  ""|-h|--help)
    sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;

  *)
    echo "mesh-tg-guard: unknown verb '$1' — use --check | --send | --test | --help" >&2; exit 64 ;;
esac
