#!/usr/bin/env python3
"""Reduce verified observation receipts without losing their evidence lineage."""
import argparse
import hashlib
import json
from pathlib import Path
import sys


def digest(data):
    return hashlib.sha256(data).hexdigest()


def reject(path, reason, detail=None):
    item = {"source": path.name, "reason": reason}
    if detail:
        item["detail"] = detail
    return item


def receipt_paths(inputs):
    paths = []
    for raw in inputs:
        path = Path(raw)
        if path.is_dir():
            paths.extend(sorted(path.glob("*.json")))
        else:
            paths.append(path)
    return sorted(set(paths), key=lambda p: str(p))


def verify(path, args):
    try:
        raw = path.read_bytes()
    except OSError as exc:
        return None, reject(path, "unreadable", str(exc))
    if len(raw) > args.max_receipt_bytes:
        return None, reject(path, "receipt-too-large")
    try:
        receipt = json.loads(raw)
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        return None, reject(path, "malformed-json", str(exc))
    if not isinstance(receipt, dict) or not isinstance(receipt.get("handle"), str):
        return None, reject(path, "missing-handle")
    streams = receipt.get("streams")
    pages = receipt.get("pages")
    if not isinstance(streams, dict) or not isinstance(pages, list):
        return None, reject(path, "malformed-schema")
    if len(pages) > args.max_pages:
        return None, reject(path, "page-bound-exceeded")
    page_by_stream = {name: [] for name in streams}
    for page in pages:
        if not isinstance(page, dict) or page.get("stream") not in page_by_stream:
            return None, reject(path, "malformed-page")
        page_by_stream[page["stream"]].append(page)
    stream_hashes = {}
    stream_bytes = {}
    page_hashes = {}
    for name in sorted(streams):
        meta = streams[name]
        if not isinstance(meta, dict) or not isinstance(meta.get("path"), str):
            return None, reject(path, "malformed-stream")
        expected_bytes = meta.get("bytes")
        if not isinstance(expected_bytes, int) or expected_bytes < 0 or expected_bytes > args.max_stream_bytes:
            return None, reject(path, "stream-bound-exceeded")
        try:
            data = (path.parent / meta["path"]).read_bytes()
        except OSError as exc:
            return None, reject(path, "missing-stream", str(exc))
        if len(data) != expected_bytes:
            return None, reject(path, "stream-length-mismatch")
        actual = digest(data)
        if actual != meta.get("sha256"):
            return None, reject(path, "stream-hash-mismatch")
        stream_hashes[name] = actual
        stream_bytes[name] = len(data)
        offset = 0
        hashes = []
        for page in sorted(page_by_stream[name], key=lambda p: p.get("index", -1)):
            if page.get("start") != offset or not isinstance(page.get("bytes"), int) or page["bytes"] < 0:
                return None, reject(path, "malformed-page-boundary")
            try:
                pdata = (path.parent / page["path"]).read_bytes()
            except (KeyError, OSError) as exc:
                return None, reject(path, "missing-page", str(exc))
            if len(pdata) != page["bytes"] or page.get("end") != offset + len(pdata):
                return None, reject(path, "page-length-mismatch")
            phash = digest(pdata)
            if phash != page.get("sha256"):
                return None, reject(path, "page-hash-mismatch")
            hashes.append(phash)
            offset += len(pdata)
        if offset != len(data):
            return None, reject(path, "page-coverage-mismatch")
        page_hashes[name] = hashes
    return {
        "handle": receipt["handle"],
        "label": receipt.get("label"),
        "status": receipt.get("status"),
        "rc": receipt.get("rc"),
        "source": {"receipt": path.name, "receipt_sha256": digest(raw),
                   "streams": stream_hashes, "stream_bytes": stream_bytes,
                   "pages": page_hashes},
    }, None


def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--input", action="append", required=True)
    ap.add_argument("--output", required=True, type=Path)
    ap.add_argument("--max-receipt-bytes", type=int, default=262144)
    ap.add_argument("--max-pages", type=int, default=4096)
    ap.add_argument("--max-stream-bytes", type=int, default=16 * 1024 * 1024)
    args = ap.parse_args()
    if min(args.max_receipt_bytes, args.max_pages, args.max_stream_bytes) < 1:
        ap.error("all bounds must be positive")
    records, rejections, seen = {}, [], set()
    for path in receipt_paths(args.input):
        record, failure = verify(path, args)
        if failure:
            rejections.append(failure)
        elif record["handle"] not in seen:
            records[record["handle"]] = record
            seen.add(record["handle"])
    result = {"schema": "mesh-observation-reduced/v1",
              "records": [records[key] for key in sorted(records)],
              "rejections": sorted(rejections, key=lambda x: (x["source"], x["reason"])),
              "summary": {"accepted": len(records), "rejected": len(rejections),
                          "handles": len(records)}}
    args.output.parent.mkdir(parents=True, exist_ok=True)
    args.output.write_text(json.dumps(result, sort_keys=True, indent=2) + "\n")
    return 2 if rejections else 0


if __name__ == "__main__":
    raise SystemExit(main())
