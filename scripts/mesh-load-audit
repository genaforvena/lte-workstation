#!/usr/bin/env bash
# mesh-load-audit — WHO is eating CPU/GPU right now, and is it JUNK?
#
# The 2026-07-22 runaway episode: mesh-home's CPU + RTX 3060 were pegged by junk processes.
# mesh-resource-guard only MITIGATES minds (^(claude|opencode|gemini|codex|ollama)$ → renice/oom_adj);
# for non-mind procs it NAMES top-RSS on NODE-PRESSURE but never a global CPU ranking, never GPU
# compute-apps. mesh-vram-watch checks `ollama ps` only — a non-ollama CUDA proc is invisible. So a
# whisper/synth/python hog burns the box and the only signals are pressure (RSS-sorted, names no CPU
# culprit) and after-the-fact OOM kills (mesh-kill-events). This tool is the missing AUDITOR: one read
# that lists the top instantaneous-CPU procs + the GPU compute-apps, classifies each, and names junk.
#
# Observe-only. NEVER kills (operator doctrine: resource-guard mitigates minds; the operator decides
# on the rest). This surfaces so the operator/minds can decide.
#
# CPU: accurate INSTANTANEOUS % via a 2-sample /proc/[pid]/stat delta (the same method
#      resource-guard uses for minds, but over ALL procs). `ps` pcpu is a LIFETIME average — it
#      underreports a hog that spun up 30s ago (the exact junk case), so it is NOT used for ranking.
# GPU: nvidia-smi --query-compute-apps (pid,process_name,used_memory) + utilization.gpu. A proc
#      holding GPU compute that is NOT a known organ (ollama/whisper/voice-clone/venv-ai) = suspect.
#
# Classification of each proc (comm + args):
#   [mind]   claude|opencode|gemini|codex
#   [organ]  a known mesh workload: ollama/llama_server, whisper(.cpp/main), node/python running
#            mesh-* or venv-ai (gigaam/resemblyzer/xtts/moondream), voice-clone-daemon, build tools
#            (cc1/gcc/g++/make/ld/rustc/cargo/ninja — genome builds)
#   [user]   an allowlisted interactive app (firefox/chromium/code/telegram-desktop/... — env-tunable)
#   [system] kernel/DE/Xorg/systemd (expected baseline, not load)
#   [?]      none of the above — the AUDIT surface; operator judges if junk
#
# Verdict (primary = worst axis; load1 from /proc/loadavg is the busy ground-truth):
#   QUIET        load1 < busy×nproc (0.7) — box has capacity
#   MIND-LOAD    busy AND top CPU proc is [mind] (legit mesh work)
#   ORGAN-LOAD   busy AND top CPU proc is [organ] (a known workload — build/inference)
#   USER-LOAD    busy AND top CPU proc is [user] (operator's own app)
#   JUNK-LOAD    busy AND top CPU proc is [?] — NOT a known mind/organ/user, and the SAME [?] comm
#                held the top on the previous pass → ALERT (a runaway is a CONDITION)
#   JUNK-TRANSIENT  busy AND top is [?] but a DIFFERENT [?] than last pass (or no fresh last pass) —
#                reported locally, NO board ALERT (see the persistence gate below)
#   FANOUT       busy AND no single proc dominates (top pcpu < dom×nproc) — many small / IO-wait
# GPU axis (independent):
#   GPU-IDLE     util < gpu_busy (30)
#   GPU-ORGAN    util≥gpu_busy AND compute-apps all known organs (busy, expected)
#   GPU-UNKNOWN  util≥gpu_busy AND a compute-app is [?] → ALERT
#   GPU-ZOMBIE   util≥gpu_busy AND zero compute-apps (orphan/driver wedge) → ALERT
#
# ── PERSISTENCE GATE on JUNK-LOAD (2026-08-04, from health's verified episode) ───────────────────
# A single snapshot cannot tell a runaway from a load climb. Measured, not supposed: health closed
# `load-audit-alert-junk-load` (board 2026-08-03T23:28:36Z) with — verbatim — "6 pre-reboot instances
# (19:10-23:20Z, rotating top=fail2ban-client/bash/tailscaled/fail2ban-server — not one persistent
# runaway, different procs each time as load1 climbed 7->13". Six board ALERTs, six [verify] claims
# addressed to health, ZERO runaway processes. The `--edge` sticky FLAG could not suppress them: it
# holds the LABEL, so every flap out of and back into JUNK-LOAD re-posted, and a rotating top comm
# flaps by construction.
# The fix is the mesh's own "deauth is an EVENT, a wedge is a CONDITION" rule applied here: an ALERT
# that says "runaway/junk proc" is a claim about a proc PERSISTING, so require the same unknown comm
# on ≥MESH_LA_JUNK_MIN_PASSES (2) consecutive passes within MESH_LA_JUNK_MAX_GAP_S (420s ≈ 3× the
# */2 cadence — a longer gap means passes were MISSED and persistence cannot be claimed). Matching is
# on COMM, not pid, so a respawning runaway still escalates. First sighting → JUNK-TRANSIENT: still
# rendered and still state-written (the operator can see it), but no board post and no minted claim.
# ── COVERAGE: the 0.3 s sample was 0.25% of a */2 cadence (2026-08-15 sweep) ─────────────────────
# docs/window-cadence-coverage-2026-08-15.md. The auditor's whole job is naming a CPU hog, and it
# looked for 0.3 seconds out of every 120 — a process that burns a core for 90 s and sleeps for the
# rest is invisible to it 99.75% of the time, which is also why a JUNK-LOAD had to be a *rotating*
# top comm often enough to defeat the persistence gate. /proc/<pid>/stat's utime+stime is a
# MONOTONIC ACCUMULATOR per process; carrying the whole snapshot and delta'ing it ACROSS runs gives
# a per-process mean over 100% of the interval, at the cost of one 15 KB file.
# BOTH windows are kept (the interval mean dilutes a 5-second spike; the 0.3 s one misses everything
# between ticks), folded with a max on the top process's CPU% that NAMES its winner (won=inst|iv) —
# and when the interval wins, the whole top-N table and the verdict's top process come from THAT
# window, never a row from one window wearing the other's number. A process absent from the baseline
# is counted only if /proc says it STARTED inside the interval (field 22, starttime); one that is
# older than the interval yet missing from the baseline is unexplained, and unexplained is dropped,
# not attributed. Missing evidence renders na, never 0 — and a fabricated 0 here is a fabricated
# "nobody is eating the CPU", the exact reading this auditor exists to refuse.
#
# Honest contract: no /proc → exit 2 (never a fabricated ranking). nvidia-smi absent → GPU axis is
# UNAVAILABLE (honest partial), the CPU audit still stands — this tool is useful on a non-GPU node.
#
#   mesh-load-audit           one read → verdict + top-N CPU + GPU compute-apps
#   mesh-load-audit --top N   show N top CPU procs (default 6)
#   mesh-load-audit --json    machine-readable
#   mesh-load-audit --edge    emit only on verdict change (state still refreshed every run)
#   mesh-load-audit --test    fixture classifier (RED-first) + real-read gate
#
# reflex-cadence: */2 * * * *
# reflex-args: --edge
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
MESH="$HOME/.mesh"; mkdir -p "$MESH" 2>/dev/null || true
STATE="$MESH/.load-audit-state"
FLAG="$MESH/.load-audit-flag"   # episode sticky (avoid a re-post every cycle on a lingering junk proc)
JUNK_STATE="$MESH/.load-audit-junk"  # last pass's unknown top comm + run-length (persistence gate)
TICKS_STATE="${MESH_LA_TICKS_STATE:-$MESH/.load-audit-ticks}"  # previous run's per-proc tick snapshot
MAX_IV_AGE="${MESH_LA_MAX_IV_AGE:-480}"   # baseline older than this → interval na (4× the */2 cadence)

# thresholds (env-tunable)
NPROC="$(nproc 2>/dev/null || echo 1)"
BUSY_L1_MUL="${MESH_LA_BUSY:-0.7}"      # load1 ≥ this×nproc = BUSY
DOM_CPU_PCT="${MESH_LA_DOM:-20}"        # a single proc ≥ this% = dominates (else FANOUT)
GPU_BUSY_UTIL="${MESH_LA_GPU_BUSY:-30}" # gpu util ≥ this = "busy"
SAMPLE_DUR="${MESH_LA_DUR:-0.3}"        # /proc 2-sample window (s)
# the window this reflex's ALERT addresses its check to (node/fleet health is the duty-holder for a
# runaway proc). An unaddressed [verify] is a dead-letter in the promise ledger — see the gate below.
CLAIM_OWNER="${MESH_LA_CLAIM_OWNER:-health}"
TOPN=6
[ "${1:-}" = "--top" ] && { TOPN="${2:-6}"; shift 2; }
# operator-allowlisted interactive apps (comm), env-extendable
USER_APPS="${MESH_LA_USER_APPS:-firefox chrome chromium code code-oss slack telegram-desktop vesktop discord spotify steam pidgin thunderbird gimp inkscape blender obs ffmpeg mpv vlc}"
CLK="$(getconf CLK_TCK 2>/dev/null || echo 100)"

# --- classifier (pure, offline-testable) --------------------------------------
# classify_comm <comm> <args> → mind|organ|user|system|?
classify_comm() {
  local comm="$1" args="$2"
  case "$comm" in
    claude|opencode|gemini|codex|claude-*|opencode-*|codex-*) echo mind; return ;;
    # mesh organs
    ollama|ollama_llama_server|ollama-server|llama-server|llama_server|llamafile) echo organ; return ;;
    whisper|whisper-cli|whisper-cpp|main|stream|stream-server) echo organ; return ;;
    voice-clone-daemon|tts-server|xtts_server|piper) echo organ; return ;;
    # build tools (genome compiles)
    cc1|gcc|g++|c++|make|ld|as|ar|ldd|rustc|cargo|cmake|ninja|go|javac|node) echo organ; return ;;
    # python: organ only if its args name a mesh/venv-ai workload, else ? (generic python = suspect)
    python|python3|python3.*)
      case "$args" in
        *mesh-*|*venv-ai*|*gigaam*|*resemblyzer*|*xtts*|*moondream*|*whisper*|*ollama*|*tts*) echo organ; return ;;
      esac
      echo "?"; return ;;
    # X/display/system baseline (never counts as load)
    Xorg|Xwayland|gnome-shell|kwin_x11|kwin|plasmashell|mutter|systemd|systemd-journal|journalctl|kjournald|kworker/*|rcu_*|migration/*|ksoftirqd/*|watchdog/*|kcompactd*|kswapd*) echo system; return ;;
  esac
  # comm is /proc/[pid]/stat's field 2 — TASK_COMM_LEN-truncated to 15 chars, so a long
  # organ name never matches the exact patterns above and falls to [?] → false JUNK-LOAD
  # (mesh-voice-clone-daemon→'mesh-voice-clon', ollama_llama_server→'ollama_llama_se';
  #  seen live 2026-07-22 21:04 — voice-clone-daemon 113.3% CPU misread as junk). The
  #  UNtruncated cmdline is already in $args — consult it for known organ signatures.
  case "$args" in
    *mesh-voice-clone*|*voice-clone-daemon*|*/.venv-ai/*|*gigaam*|*resemblyzer*|*xtts*|*/piper/*|*whisper*) echo organ; return ;;
    *ollama*|*llama-server*|*llama_server*|*llamafile*) echo organ; return ;;
  esac
  # allowlisted user apps
  for u in $USER_APPS; do [ "$comm" = "$u" ] && { echo user; return; }; done
  echo "?"
}

# classify a GPU compute-app process name (ollama/python known; anything else suspect).
# nvidia-smi returns the FULL PATH (/usr/local/lib/ollama/llama-server, /home/u/.venv-ai/bin/python),
# so match on the BASENAME — else a path never starts with "ollama"/"python" and every organ reads [?]
# (a false GPU-UNKNOWN alarm the moment util>30% during normal inference — caught from the live log).
# classify_gpuproc <name> → organ|?
classify_gpuproc() {
  local n="$1" base
  base="${n##*/}"   # basename
  case "$base" in
    ollama*|llama*|python|python[0-9]*|python3.*|whisper*|xtts*|_conmon|conmon|main) echo organ ;;
    *) echo "?" ;;
  esac
}

# cpu_verdict <busy01> <top_comm> <top_tag> <top_cpu> <nproc> → LABEL|reason  (pure)
cpu_verdict() {
  local busy="$1" tcomm="$2" ttag="$3" tcpu="$4" nproc="$5"
  [ "$busy" = 1 ] || { echo "QUIET|load below ${BUSY_L1_MUL}×nproc (nproc=$nproc); top=${tcomm}[${ttag}] ${tcpu}%"; return; }
  # no single proc dominates → fan-out / IO-wait
  local dom_thr; dom_thr="$(awk "BEGIN{print $DOM_CPU_PCT+0}")"
  if [ "$(awk "BEGIN{print ($tcpu < $dom_thr)?1:0}")" = 1 ]; then
    echo "FANOUT|busy but no single proc ≥${dom_thr}% — many small procs / IO-wait (top=${tcomm}[${ttag}] ${tcpu}%)"
    return
  fi
  case "$ttag" in
    mind)   echo "MIND-LOAD|top CPU=${tcomm}[mind] ${tcpu}% (legit mesh work)" ;;
    organ)  echo "ORGAN-LOAD|top CPU=${tcomm}[organ] ${tcpu}% (known workload — build/inference)" ;;
    user)   echo "USER-LOAD|top CPU=${tcomm}[user] ${tcpu}% (operator app: $tcomm)" ;;
    system) echo "ORGAN-LOAD|top CPU=${tcomm}[system] ${tcpu}%" ;;
    *)      echo "JUNK-LOAD|top CPU=${tcomm}[?] ${tcpu}% — NOT a known mind/organ/user (investigate)" ;;
  esac
}

# junk_persist <prev_comm> <prev_count> <prev_age_s> <cur_comm> → RUNS|note   (pure)
# The persistence gate. RUNS = how many CONSECUTIVE passes this unknown comm has held the top,
# counting this one. A stale record (age > MESH_LA_JUNK_MAX_GAP_S) or a different comm restarts at 1;
# `-` prev_comm means no record at all. Callers ALERT only at RUNS ≥ MESH_LA_JUNK_MIN_PASSES.
# Pure so the gate can drive the real decision offline — a rotating top must be provably non-alerting.
junk_persist() {
  local pcomm="$1" pcount="$2" page="$3" ccomm="$4"
  local maxgap="${MESH_LA_JUNK_MAX_GAP_S:-420}"
  case "$pcount" in ''|*[!0-9]*) pcount=0 ;; esac
  case "$page"   in ''|*[!0-9]*) page=999999 ;; esac
  if [ -z "$pcomm" ] || [ "$pcomm" = "-" ]; then
    echo "1|first sighting (no previous pass on record)"; return
  fi
  if [ "$page" -gt "$maxgap" ] 2>/dev/null; then
    echo "1|previous pass is ${page}s stale (>${maxgap}s) — passes were missed, persistence cannot be claimed"; return
  fi
  if [ "$pcomm" != "$ccomm" ]; then
    echo "1|top rotated ${pcomm}→${ccomm} — a different proc each pass is a LOAD CLIMB, not one runaway"; return
  fi
  echo "$((pcount+1))|same comm held the top for $((pcount+1)) consecutive pass(es)"
}

# junk_label <runs> <min_passes> <comm> <cpu> <note> <base_reason> → LABEL|reason   (pure)
# The DEMOTION itself, pure so a gate drives the real decision rather than reading the source for it.
junk_label() {
  local runs="$1" minp="$2" comm="$3" cpu="$4" note="$5" base="$6"
  case "$runs" in ''|*[!0-9]*) runs=1 ;; esac
  case "$minp" in ''|*[!0-9]*) minp=2 ;; esac
  if [ "$runs" -lt "$minp" ]; then
    echo "JUNK-TRANSIENT|top CPU=${comm}[?] ${cpu}% — ${note}; needs ${minp} consecutive passes to ALERT"
  else
    echo "JUNK-LOAD|${base} — ${note}"
  fi
}

# gpu_verdict <util> <vram_used_mb> <vram_total_mb> <compute_apps_str> → LABEL|reason (pure)
# compute_apps_str: "" (none) or "name(tag)[..] " joined
gpu_verdict() {
  local util="$1" vused="$2" vtot="$3" apps="$4"
  # no nvidia-smi on this node
  [ "$util" = "UNAVAILABLE" ] && { echo "GPU-UNAVAILABLE|no nvidia-smi (no dGPU / driver down) — CPU audit stands alone"; return; }
  local busy_thr; busy_thr="$(awk "BEGIN{print $GPU_BUSY_UTIL+0}")"
  if [ "$(awk "BEGIN{print ($util < $busy_thr)?1:0}")" = 1 ]; then
    local vpct="-"; [ -n "$vtot" ] && [ "$vtot" -gt 0 ] 2>/dev/null && vpct="$(awk "BEGIN{printf \"%.0f\", $vused/$vtot*100}")"
    echo "GPU-IDLE|util=${util}% < ${busy_thr}% (vram ${vused}/${vtot}MiB ${vpct}%)"
    return
  fi
  # busy: classify the compute-apps (tags are bracketed: name[?] / name[organ])
  [ -n "$apps" ] || { echo "GPU-ZOMBIE|util=${util}% but ZERO compute-apps (orphan/driver wedge — no PID holds it)"; return; }
  case "$apps" in
    *"[?]"*) echo "GPU-UNKNOWN|util=${util}% held by suspect proc(s): ${apps%% } — not a known organ (ollama/whisper/voice-clone)" ;;
    *)       echo "GPU-ORGAN|util=${util}% by known organ(s): ${apps%% } (busy, expected)" ;;
  esac
}

# --- test ---------------------------------------------------------------------
# enrich each top pid with rss/etime/args + classification. Defined ABOVE the --test block so the
# ghost-pid leg drives the REAL function. Every /proc read here races the process's own exit — a
# top-CPU pid is often a transient probe already gone by enrich time. That is EXPECTED, not a break,
# so every read must stay silent on a vanished pid: in bash, redirections apply LEFT TO RIGHT, so
# `< /proc/$pid/cmdline 2>/dev/null` prints the open failure to the log BEFORE stderr is nulled —
# doctor's ERRPAT (`: line N:`) then counts it as UP-but-BROKEN (recurring false FAIL, 2026-07-23).
# The 2>/dev/null must come FIRST.
#
# ONE PROBE DECIDES THE WHOLE ROW. This printed `rss=?MB etime=11h13m` for the same pid in the same
# breath (health, 2026-08-18) — one field degrading honestly while the field beside it fabricated a
# confident 11h13m, which was simply this node's uptime. A row that degrades one field and fabricates
# the next is worse than one that degrades wholly, because the fabricated field is the one that reads
# as evidence. So: read /proc/<pid>/stat ONCE, and if it is gone every field renders `?`.
#
# The 11h13m had nothing to do with the vanished-pid path (that was health's hypothesis, and it is
# wrong — see below). It was `awk '{print $22}'`. A comm can CONTAIN SPACES, and awk splits on them:
# `2156083 (tmux: server) S ...` puts nice, not starttime, in $22. Measured here: naive $22 = 0 for
# `tmux: server` -> etime = uptime - 0 = 11h20m against a true 09:06:54, and 11 live pids on this node
# carry a spacey comm right now — `tmux: server`, `npm exec @z_ai/`, `UVM GPU1 BH`, and four
# `kworker/uNN:M-rtw88_usb: rx wq` (the incident's own pid, 3274446, among them). A zeroed starttime
# IS a 0 in disguise, so the guard is now `s<0 -> ?`, never `s<0 -> 0`.
# sample_ticks has parsed comm correctly since it was written; this path never learned the lesson.
#
# rss=? WAS ALSO NOT THE VANISHED-PID PATH. A kernel thread has no mm, so /proc/<pid>/status carries
# no VmRSS line at all — `?` there meant "kthread", indistinguishable from "gone". PF_KTHREAD
# (0x00200000, stat field 9) says which, from the read we already did, so the two now render
# differently and `?` keeps meaning unknown.
#
# The name arriving here is already the DISPLAY label from the ranking (it may carry `-?` or
# `~unstable`). It is printed verbatim, but classify_comm is fed the label with those markers
# stripped — feeding `mesh-voice-clon~unstable` to the classifier would read a known organ as JUNK.
top_line() {
  local pid="$1" comm="$2" cpu="$3" rss etime args tag stat ccomm
  stat="$(cat "/proc/$pid/stat" 2>/dev/null)"
  if [ -z "$stat" ]; then
    # the pid is gone: the row degrades WHOLLY. No field of it is a measurement.
    rss='?'; etime='?'; args="$comm"
  else
    _boot="$(awk '{print $1}' /proc/uptime 2>/dev/null)"
    # comm-aware split: strip "<pid> (" and everything through the LAST ")", then index the rest.
    # a[20]=starttime (field 22), a[7]=flags (field 9).
    etime="$(printf '%s\n' "$stat" | awk -v b="${_boot:-}" -v c="$CLK" '
      { l=$0; sub(/^[0-9]+ \(/,"",l); n=index(l,")"); if(n<1){print "?"; exit}
        split(substr(l,n+2),a," "); st=a[20]
        if (b=="" || st=="") { print "?"; exit }
        s=b-st/c; if(s<0){ print "?"; exit }                    # inconsistent read -> unknown, not 0
        d=int(s/86400); h=int((s%86400)/3600); m=int((s%3600)/60)
        if(d>0)printf "%dd%02dh\n",d,h; else if(h>0)printf "%dh%02dm\n",h,m; else printf "%dm\n",m }')"
    if printf '%s\n' "$stat" | awk '{ l=$0; sub(/^[0-9]+ \(/,"",l); n=index(l,")"); split(substr(l,n+2),a," "); exit !(int(a[7]/2097152)%2) }'; then
      rss='kthread'          # PF_KTHREAD: no mm by construction, so "no VmRSS" is a fact, not a gap
    elif [ -r "/proc/$pid/status" ]; then
      rss="$(awk '/^VmRSS:/{print int($2/1024)"MB"}' /proc/$pid/status 2>/dev/null)"
    fi
    rss="${rss:-?}"
    args="$(tr '\0' ' ' 2>/dev/null < /proc/$pid/cmdline | cut -c1-60)"; args="${args:-$comm}"
  fi
  etime="${etime:-?}"
  ccomm="${comm%\~unstable}"; ccomm="${ccomm%-\?}"
  tag="$(classify_comm "$ccomm" "$args")"
  printf '%s[pid=%s cpu=%s%% rss=%s etime=%s] %s' "$comm" "$pid" "$cpu" "$rss" "$etime" "$tag"
}

# The ALERT's board line, defined ABOVE --test so the gate asserts the REAL string a live post
# emits (a second copy inside the test would rot apart from this one).
#
# IT NAMES ITS NODE, and the node is a PARAMETER (health's verified find, 2026-08-14). The line used
# to carry only the reading — `load1=15.01/2` — with the node living solely in the poster field
# (`MESH_WHO=loadaudit@<host>`). 294 of the 301 load-audit ALERTs on this board are from phaedra (2
# cores) while the minds that read the board run on mesh-home (16 cores), so the common case is a
# reader applying its OWN node's facts to another node's reading. Measured: health investigated the
# 2026-08-13T17:56Z phaedra ALERT, called `/2` a "misleading label, actually /16c" — substituting
# mesh-home's core count — then verified mesh-home's live state, found it quiet, and closed the claim.
# Phaedra was never checked. The label was correct; the line simply did not say whose it was.
# (Doctrine already held for the sibling case: `n/a` must be a claim about the NODE.)
#
# AND ITS CORE COUNT IS RENDERED LIKE render()'s. `render()` prints `load1=%s/%dc` while this printed
# a bare `load1=%s/%s`, so one quantity had two renderings and the bare `/2` reads as a ratio
# denominator rather than a core count — which is exactly how it was misread.
#   args: node label cpu_label gpu_label top_comm top_tag top_cpu load1 nproc
board_line(){
  printf '[verify] %s: load-audit ALERT on %s [%s]: CPU=%s · GPU=%s · top=%s[%s] %s%% · load1=%s/%sc — runaway/junk proc on %s, not a known mind/organ. Investigate & decide (observe-only, no auto-kill).' \
    "$CLAIM_OWNER" "$1" "$2" "$3" "$4" "$5" "$6" "$7" "$8" "$9" "$1"
}

# --- live CPU read: 2-sample /proc delta over ALL procs -----------------------
# Column map: after the "(comm)" field, a[1] is state, so utime=a[12], stime=a[13], starttime=a[20],
# num_threads=a[18] (kernel fields 14, 15, 22 and 20). starttime is carried for the interval window —
# it is how a process missing from the baseline is told apart from one that was BORN inside the
# interval — AND it is half the row's IDENTITY (see _NAME_AWK). num_threads is carried because it is
# the only thing that makes a >100% reading refutable: a single-threaded task cannot exceed one core.
sample_ticks() {  # echo "pid<TAB>comm<TAB>ticks(utime+stime)<TAB>starttime<TAB>num_threads"
  cat /proc/[0-9]*/stat 2>/dev/null | awk '{ pid=$1; sub(/^[0-9]+ \(/,"",$0); n=index($0,")"); comm=substr($0,1,n-1); rest=substr($0,n+2); split(rest,a," "); print pid"\t"comm"\t"(a[12]+a[13])"\t"a[20]"\t"a[18] }'
}

# --- the NAME is not the IDENTITY (health's find, 2026-08-18) ------------------
# A kworker's comm is MUTABLE: the kernel rewrites it to the CURRENT work item, so a sampler credits
# CPU to whatever the thread happened to be doing at read time. Measured that day: 22 of 133 kworker
# pids changed comm inside a 20 s watch, and the dash published `kworker/u32:5-phy1 ... 263.3%` —
# real pid, real burn, unrelated name, incident-shaped ("a wifi-PHY worker eating the chronically
# faulting SOLE UPLINK for 11 hours"). Ground truth seconds later: `-flush-252:0`, a writeback worker.
# Re-measured here while writing this: pid 3274446 read `-rtw88_usb: rx wq` and `-ext4-rsv-conversion`
# in two commands seconds apart.
#
# So the identity is (pid, starttime) — immune to comm rewriting and to pid reuse — and the comm is
# only a LABEL, rendered with its unreliability visible:
#   kworker/u32:5-phy1  -> kworker/u32:5-?      the pool thread is real, the work item is not a claim
#   comm changed across the window -> <name>~unstable
#   kworker/R-kinte     -> unchanged            the R- form names a workqueue rescuer, it is stable
# ONE awk text, shared by inst_rank, iv_rank and stable_name, so the gate on stable_name is a gate on
# the live path — two copies of this rule would rot apart and only one of them is tested.
_NAME_AWK='
function norm(c,  b){ b=c; if (b ~ /^kworker\/u?[0-9]+:[0-9]+-/) sub(/-.*$/,"",b); return b }
function disp(c1,c2,  b1,b2){ b1=norm(c1); b2=norm(c2)
  if (b1 != b2) return b2 "~unstable"
  if (b2 != c2) return b2 "-?"
  return c2 }
'
# stable_name <comm_at_t1> [<comm_at_t2>] -> the display label for that row
stable_name() { awk -v c1="$1" -v c2="${2:-$1}" "$_NAME_AWK"'BEGIN{ print disp(c1,c2) }'; }

# cap_pct <num_threads|""> <nproc> <dur_s> <clk> -> the largest %CPU this row could PHYSICALLY show.
# A task cannot outrun min(its threads, the cores) — a kworker is ONE task, so 100% is its ceiling and
# a 263.3% row is refuted by arithmetic without reproducing any load. Plus exactly ONE tick of slack:
# ticks are integers, so a single thread pinned at 100% over a 0.3 s / 100 Hz window reads 31 ticks =
# 103.3%, and a hard 100% cap would drop the very rows this auditor exists to catch. Missing thread
# count -> fall back to the machine cap (we did not measure it; inventing "1" would fabricate a
# constraint), which is exactly the old, 16x-too-loose behaviour, now confined to that one case.
cap_pct() {
  awk -v nt="$1" -v np="$2" -v dur="$3" -v clk="$4" 'BEGIN{
    n = (nt+0 > 0) ? nt+0 : np+0; if (n > np+0) n = np+0
    printf "%.4f", n*100.0 + ((dur*clk>0) ? 100.0/(dur*clk) : 0) }'
}

# inst_rank <t1_snapshot> <t2_snapshot> [<measured_dur_s>] -> the in-run ranking rows, then a
# trailing "#drop<TAB>N" line counting rows refused by the physical cap. A function (not inline awk)
# so the cap can be driven by a fixture and watched fail — an inline rule in the live path has no gate.
# The divisor is the MEASURED gap between the two sweeps when the caller has it: `sleep 0.3` does not
# take 0.3 s on a loaded box, and dividing a real tick delta by a nominal window inflates every row.
# Measured on this node 2026-08-18 with 48 spinners on 16 cores: the start-to-start gap ran 0.35-0.37 s
# against a nominal 0.300 — every %CPU overstated by 17-23%. (Real, but nowhere near the 2.6x that
# would explain a 263% single-threaded row; the cap above is what refutes that one.)
inst_rank() {
  awk -v dur="${3:-$SAMPLE_DUR}" -v clk="$CLK" -v nproc="$NPROC" "$_NAME_AWK"'
    FNR==NR { k=$1 SUBSEP $4; t[k]=$3; c1[k]=$2; next }
    { k=$1 SUBSEP $4 }
    (k in t) { d=$3-t[k]; if(d>0) { p=d*100.0/(dur*clk)
      n=($5+0>0)?$5+0:nproc+0; if(n>nproc+0)n=nproc+0
      cap=n*100.0 + ((dur*clk>0)?100.0/(dur*clk):0)
      if (p <= cap) printf "%d\t%s\t%.1f\n", $1, disp(c1[k],$2), p; else drop++ } }
    END { printf "#drop\t%d\n", drop+0 }
  ' "$1" "$2"
}

# iv_rank <prev_snapshot_file> <prev_epoch> <now_snapshot_file> <now_epoch> <now_uptime_s> <max_age_s>
#   -> the same "pid<TAB>comm<TAB>pcpu" rows as the in-run ranking, but averaged over the WHOLE
#      interval since the previous run. Prints NOTHING (and returns 1) when there is no usable
#      baseline: first run, missing/garbage epoch, dt<=0, or a baseline past max_age (the reflex was
#      down — an "average" across an unobserved gap is not a measurement). The caller renders na.
iv_rank() {
  local prev="$1" pe="$2" now="$3" ne="$4" up="$5" maxage="$6" dt
  [ -s "$prev" ] || return 1
  case "$pe" in ''|*[!0-9]*) return 1;; esac
  dt=$(( ne - pe )); [ "$dt" -gt 0 ] || return 1; [ "$dt" -le "$maxage" ] || return 1
  # The key is (pid, starttime), NOT (pid, comm): a kworker rewrites its own comm, so keying on a
  # mutable label made every comm-mutating thread look ABSENT from the baseline — dropped as
  # "unexplained" on exactly the passes it was burning CPU. starttime never changes, and pid reuse
  # does change it, so this is the identity the old key was only pretending to be.
  awk -v dt="$dt" -v clk="$CLK" -v up="$up" -v nproc="$NPROC" "$_NAME_AWK"'
    FNR==NR { k=$1 SUBSEP $4; t[k]=$3; c1[k]=$2; seen[k]=1; next }
    {
      k=$1 SUBSEP $4; d=-1; nm=$2
      if (k in seen) { d=$3-t[k]; nm=disp(c1[k],$2) }            # a backwards delta (pid reuse /
      # torn read) falls out at the d>0 filter below — no separate guard, since a redundant one
      # cannot be seen to fail and would only look like protection.
      else if (up - $4/clk <= dt + 1) { d=$3; nm=disp($2,$2) }   # born inside the interval: all its
      # ticks are this intervals. An older process MISSING from the baseline is unexplained — it is
      # dropped, never credited with a lifetimes worth of CPU inside one interval.
      if (d > 0) {
        p = d*100.0/(dt*clk)
        n=($5+0>0)?$5+0:nproc+0; if(n>nproc+0)n=nproc+0          # a task cannot outrun its own
        # threads. Over a 120 s interval one tick of slack is 0.008%, so this ceiling is effectively
        # exact — 100% for the single-threaded kernel workers that produce these artifacts.
        cap=n*100.0 + ((dt*clk>0)?100.0/(dt*clk):0)
        if (p <= cap) printf "%d\t%s\t%.1f\n", $1, nm, p
      }
    }' "$prev" "$now" | sort -t$'\t' -k3 -rn
}

# fold_cpu <inst_pct> <iv_pct|na> [<resolution_pct>] -> "<fused> <winner>"   (na loses by default)
# The louder window wins, but "louder" has to clear the narrow window's OWN RESOLUTION. At a 0.3 s
# sample and 100 Hz ticks, ONE tick is 33.3% — the in-run reading is quantised in 33-point steps and
# cannot resolve anything finer. Measured on this node 2026-08-15: a kernel worker read 820% in the
# 0.3 s window while its across-run interval mean was 91.7% at the same instant (kernel stime for a
# kworker lands in bursts, and a 0.3 s window catches a whole burst as if it were the rate). A plain
# max would hand that artifact the verdict every single pass and the interval — which resolves 0.008%
# over a 120 s cadence and covers 100% of it — would be published and never consumed.
# So: the in-run window wins only when it exceeds the interval by more than one tick's worth; inside
# that band the two readings are indistinguishable to the narrow one, and the wider, finer, fully
# covering measurement is the better estimate. The winner is always NAMED, because "eating a core
# right now" and "averaged a core for two minutes" are different claims and the persistence gate
# downstream acts on whichever it is handed.
fold_cpu() {
  local inst="$1" iv="${2:-na}" res="${3:-}"
  case "$iv" in ''|na) printf '%s inst\n' "$inst"; return;; esac
  [ -n "$res" ] || res="$(awk -v d="$SAMPLE_DUR" -v c="$CLK" 'BEGIN{ printf "%.4f", (d*c>0)? 100.0/(d*c) : 0 }')"
  awk -v a="$inst" -v b="$iv" -v r="$res" 'BEGIN{ if (a+0 > b+0 + r+0) printf "%s inst\n", a; else printf "%s iv\n", b }'
}


if [ "${1:-}" = --test ]; then
  fail=0
  # classify_comm: mind / organ(python organ-path) / organ(build) / user / system / ?(generic python) / ?(unknown)
  [ "$(classify_comm claude 'x')" = mind ] || { echo "  FAIL mind"; fail=1; }
  [ "$(classify_comm ollama 'x')" = organ ] || { echo "  FAIL ollama"; fail=1; }
  [ "$(classify_comm python3 '/home/u/venv-ai/gigaam/run.py')" = organ ] || { echo "  FAIL python-venv-ai"; fail=1; }
  [ "$(classify_comm python3 '/usr/bin/something')" = "?" ] || { echo "  FAIL generic-python should be ?"; fail=1; }
  [ "$(classify_comm cc1 'x')" = organ ] || { echo "  FAIL cc1 build"; fail=1; }
  [ "$(classify_comm firefox 'x')" = user ] || { echo "  FAIL firefox user"; fail=1; }
  [ "$(classify_comm Xorg 'x')" = system ] || { echo "  FAIL Xorg system"; fail=1; }
  [ "$(classify_comm journalctl 'x')" = system ] || { echo "  FAIL journalctl system (legit admin burst must not read JUNK-LOAD)"; fail=1; }
  [ "$(classify_comm rogueminer 'x')" = "?" ] || { echo "  FAIL unknown should be ?"; fail=1; }
  # kcompactd0/kcompactd1/... is a real kernel memory-compaction kthread (sibling of the already-
  # allowlisted kworker/ksoftirqd/migration) — missing it false-JUNK-LOADed phaedra 190+ times over
  # 5 days (2026-07-22..27) every time memory pressure triggered compaction (seen live: top=kcompactd0
  # up to 66.7% CPU, load1=8.36/2c). Same truncated-comm story as the other system names below.
  [ "$(classify_comm kcompactd0 'x')" = system ] || { echo "  FAIL kcompactd0 system (real kernel compaction thread, not junk)"; fail=1; }
  # kswapd0/kswapd1/... is the real kernel page-reclaim kthread, sibling of the already-fixed
  # kcompactd — same false-JUNK-LOAD story: unallowlisted, it fired on phaedra 490+ times
  # (chat.log, 2026-07-22..08-03) every time its chronic 2GB-RAM/swap pressure triggered
  # reclaim (seen live 2026-08-03 17:30: top=kswapd0 20.0% CPU, load1=8.57/2c, free 142Mi,
  # swap 1.1G/2G used, no OOM in dmesg — real memory pressure, not a runaway/junk proc).
  [ "$(classify_comm kswapd0 'x')" = system ] || { echo "  FAIL kswapd0 system (real kernel reclaim thread, not junk)"; fail=1; }
  # /proc comm is 15-char-truncated: a long organ name misses the exact patterns above and
  # must be recovered from the UNtruncated cmdline in $args (else false JUNK-LOAD — live 21:04).
  [ "$(classify_comm mesh-voice-clon '/home/mesh-home/.venv-ai/bin/python /home/mesh-home/.local/bin/mesh-voice-clone-daemon')" = organ ] || { echo "  FAIL truncated voice-clone comm should read organ via args"; fail=1; }
  [ "$(classify_comm ollama_llama_se '/usr/local/lib/ollama/llama-server --model x')" = organ ] || { echo "  FAIL truncated ollama comm should read organ via args"; fail=1; }
  # but a truncated JUNK comm whose cmdline names no organ still reads ? (no over-broadening)
  [ "$(classify_comm xmrig-truncated '/opt/xmrig --coin monero')" = "?" ] || { echo "  FAIL truncated junk comm must stay ?"; fail=1; }
  # classify_gpuproc: must take the BASENAME of a full path (real nvidia-smi output)
  [ "$(classify_gpuproc ollama-runner)" = organ ] || { echo "  FAIL gpu ollama (bare)"; fail=1; }
  [ "$(classify_gpuproc /usr/local/lib/ollama/llama-server)" = organ ] || { echo "  FAIL gpu ollama (full path)"; fail=1; }
  [ "$(classify_gpuproc /home/u/.venv-ai/bin/python)" = organ ] || { echo "  FAIL gpu venv-ai python (full path)"; fail=1; }
  [ "$(classify_gpuproc /opt/xmrig)" = "?" ] || { echo "  FAIL gpu xmrig should be ?"; fail=1; }
  # cpu_verdict: QUIET / MIND-LOAD / JUNK-LOAD / FANOUT
  echo "$(cpu_verdict 0 foo mind 10 8)" | grep -q '^QUIET' || { echo "  FAIL cpu QUIET"; fail=1; }
  echo "$(cpu_verdict 1 claude mind 240 8)" | grep -q '^MIND-LOAD' || { echo "  FAIL cpu MIND-LOAD"; fail=1; }
  echo "$(cpu_verdict 1 rogueminer '?' 160 8)" | grep -q '^JUNK-LOAD' || { echo "  FAIL cpu JUNK-LOAD"; fail=1; }
  echo "$(cpu_verdict 1 cc1 organ 95 8)" | grep -q '^ORGAN-LOAD' || { echo "  FAIL cpu ORGAN-LOAD"; fail=1; }
  echo "$(cpu_verdict 1 foo mind 5 8)" | grep -q '^FANOUT' || { echo "  FAIL cpu FANOUT (no dominator)"; fail=1; }
  # PERSISTENCE GATE (health's verified 6-ALERT episode, board 2026-08-03T23:28:36Z: rotating
  # top=fail2ban-client/bash/tailscaled/fail2ban-server as load1 climbed 7->13, zero runaways).
  # Falsify BOTH ways — a gate that cannot say "not persistent" would re-post exactly those six.
  _p_rot="$(junk_persist fail2ban-client 1 120 tailscaled)"
  [ "${_p_rot%%|*}" = 1 ] || { echo "  FAIL junk rotating top must restart the run at 1 (health's live episode: '$_p_rot')"; fail=1; }
  _p_same="$(junk_persist rogueminer 1 120 rogueminer)"
  [ "${_p_same%%|*}" = 2 ] || { echo "  FAIL junk same comm on a fresh previous pass must reach run 2 (a real runaway must still ALERT: '$_p_same')"; fail=1; }
  # the whole point: SAME inputs but the comm, opposite run-length — the gate keys on persistence.
  _p_stale="$(junk_persist rogueminer 5 3600 rogueminer)"
  [ "${_p_stale%%|*}" = 1 ] || { echo "  FAIL a stale previous pass cannot be counted consecutive (missed passes: '$_p_stale')"; fail=1; }
  _p_none="$(junk_persist - 0 999999 rogueminer)"
  [ "${_p_none%%|*}" = 1 ] || { echo "  FAIL no record must be a first sighting, not an ALERT: '$_p_none'"; fail=1; }
  # and the gate must be able to ESCALATE without bound (a runaway held for hours is still an ALERT)
  _p_long="$(junk_persist rogueminer 9 60 rogueminer)"
  [ "${_p_long%%|*}" = 10 ] || { echo "  FAIL a long-held runaway must keep counting up: '$_p_long'"; fail=1; }
  # and the DEMOTION the runs feed — both branches, from the same pure function the live path calls.
  _l_tr="$(junk_label 1 2 tailscaled 53.3 'top rotated' 'base')"
  [ "${_l_tr%%|*}" = JUNK-TRANSIENT ] || { echo "  FAIL run 1 of 2 must demote to JUNK-TRANSIENT (no board ALERT): '$_l_tr'"; fail=1; }
  _l_al="$(junk_label 2 2 rogueminer 91.2 'same comm' 'base')"
  [ "${_l_al%%|*}" = JUNK-LOAD ] || { echo "  FAIL run 2 of 2 must still be JUNK-LOAD — the gate must not mute a real runaway: '$_l_al'"; fail=1; }
  # REAL-PATH leg: the live run must clear the run-state when the verdict is NOT junk — else a
  # week-old comm could pair with today's sighting and forge "consecutive".
  # (HOME is the only handle on the state dir — MESH is derived from it, not env-overridable.)
  _rt="$(mktemp -d)"; mkdir -p "$_rt/.mesh"
  printf 'ghostjunk|9|%s\n' "$(date -u +%s)" > "$_rt/.mesh/.load-audit-junk"
  _rlbl="$(HOME="$_rt" "$0" --json 2>/dev/null | sed 's/.*"cpu_label":"\([A-Z-]*\)".*/\1/')"
  case "$_rlbl" in
    JUNK-*) : ;;   # box is genuinely junk-loaded right now — this leg is n/a, not a pass to fake
    "")     echo "  FAIL real-path --json produced no cpu_label"; fail=1 ;;
    *) [ -f "$_rt/.mesh/.load-audit-junk" ] && { echo "  FAIL a non-junk pass must clear the run-state (stale comm would forge persistence)"; fail=1; } ;;
  esac
  rm -rf "$_rt"
  # gpu_verdict: IDLE / ORGAN / UNKNOWN / ZOMBIE / UNAVAILABLE
  echo "$(gpu_verdict 10 6700 12000 'ollama[organ] ')" | grep -q '^GPU-IDLE' || { echo "  FAIL gpu IDLE"; fail=1; }
  echo "$(gpu_verdict 80 6700 12000 'ollama[organ] ')" | grep -q '^GPU-ORGAN' || { echo "  FAIL gpu ORGAN"; fail=1; }
  echo "$(gpu_verdict 80 6700 12000 'xmrig[?] ')" | grep -q '^GPU-UNKNOWN' || { echo "  FAIL gpu UNKNOWN"; fail=1; }
  echo "$(gpu_verdict 80 6700 12000 '')" | grep -q '^GPU-ZOMBIE' || { echo "  FAIL gpu ZOMBIE"; fail=1; }
  echo "$(gpu_verdict UNAVAILABLE 0 0 '')" | grep -q '^GPU-UNAVAILABLE' || { echo "  FAIL gpu UNAVAILABLE"; fail=1; }
  # top_line on a VANISHED pid (the routine enrich-time race) must degrade to ?-fields and emit
  # NOTHING on stderr — a `line N: /proc/PID/cmdline: No such file` leak lands in the log and
  # doctor's ERRPAT reads it as UP-but-BROKEN (the 12:40Z recurring false FAIL, 2026-07-23).
  _ghost="$(( $(cat /proc/sys/kernel/pid_max 2>/dev/null || echo 4194304) - 1 ))"
  while [ -d "/proc/$_ghost" ]; do _ghost=$((_ghost-1)); done
  _gerr="$(top_line "$_ghost" ghostcomm 0.0 2>&1 >/dev/null)"
  [ -z "$_gerr" ] || { echo "  FAIL ghost-pid enrich leaked to stderr ('$_gerr') — lands in the log, doctor counts it as UP-but-BROKEN"; fail=1; }
  _gout="$(top_line "$_ghost" ghostcomm 0.0 2>/dev/null)"
  printf '%s' "$_gout" | grep -q "ghostcomm\[pid=$_ghost" || { echo "  FAIL ghost-pid enrich did not degrade honestly (got: '$_gout')"; fail=1; }
  # --- (b) THE DEGRADE IS ALL-OR-NOTHING ------------------------------------------------------
  # The row that started this: `rss=?MB etime=11h13m` for one pid in one breath. A row that degrades
  # one field and FABRICATES the next is worse than one that degrades wholly — the confident field is
  # the one a reader treats as evidence, and 11h13m on a wifi worker is an incident-shaped sentence.
  case "$_gout" in
    *'rss=? etime=?'*) : ;;
    *) echo "  FAIL a vanished pid degraded only PART of its row (got: '$_gout') — every field of a dead pid is unknown, none of them is a measurement"; fail=1 ;;
  esac
  # ...and the actual mechanism behind the 11h13m, which is NOT the vanished-pid path at all:
  # `awk '{print $22}'` on /proc/<pid>/stat, where a comm CONTAINING SPACES shifts every field right.
  # 11 live pids on this node carry one (`tmux: server`, `npm exec @z_ai/`, `UVM GPU1 BH`, and the
  # incident's own `kworker/u32:5-rtw88_usb: rx wq`). Driven with a REAL process whose comm has a
  # space: comm comes from the executable's basename, so a copy of `sleep` under a spacey name is one.
  # Naive $22 lands on `nice` = 0 -> etime = uptime - 0 -> the node's whole uptime, printed as fact.
  _sd="$(mktemp -d)"; _sn="$_sd/tmux: server"
  if cp /bin/sleep "$_sn" 2>/dev/null; then
    "$_sn" 30 & _sp=$!
    sleep 0.2
    _scomm="$(cat "/proc/$_sp/comm" 2>/dev/null)"
    if [ "$_scomm" != "tmux: server" ]; then
      echo "  note: spacey-comm fixture did not take (comm='$_scomm') — etime field-shift leg SKIPPED"
    else
      _sout="$(top_line "$_sp" "$_scomm" 0.0 2>/dev/null)"
      case "$_sout" in
        *'etime=0m'*) : ;;
        *) echo "  FAIL etime on a SPACE-containing comm (got: '$_sout') — awk field \$22 is not starttime when comm has spaces; it lands on nice=0 and prints the node's uptime as a confident age. This is the 11h13m."; fail=1 ;;
      esac
    fi
    kill "$_sp" 2>/dev/null; wait "$_sp" 2>/dev/null
  fi
  rm -rf "$_sd"
  # a KERNEL THREAD has no mm, so "no VmRSS" is a fact about what it is, not a gap in the read. It
  # used to render `?` — the same glyph as a vanished pid — which is exactly the confusion that let
  # health read a live kworker's row as proof the pid was already gone.
  _kp=""; for _c in /proc/[0-9]*/comm; do case "$(cat "$_c" 2>/dev/null)" in kworker/*) _kp="${_c#/proc/}"; _kp="${_kp%/comm}"; break;; esac; done
  if [ -n "$_kp" ] && [ -r "/proc/$_kp/stat" ]; then
    _kout="$(top_line "$_kp" "$(cat "/proc/$_kp/comm" 2>/dev/null)" 0.0 2>/dev/null)"
    case "$_kout" in
      *'rss=kthread'*) : ;;
      *) echo "  FAIL a live KERNEL THREAD rendered rss=? (got: '$_kout') — 'no VmRSS by construction' and 'the pid vanished' must not share a glyph"; fail=1 ;;
    esac
    case "$_kout" in
      *'etime=?'*) echo "  FAIL a LIVE kthread rendered etime=? (got: '$_kout') — the row is readable, so its age is a measurement"; fail=1 ;;
    esac
  else
    echo "  note: no kworker on this node — kthread rss leg SKIPPED"
  fi
  # ADDRESSABILITY gate: the line this reflex posts is a [verify] — an OBLIGATION on the board.
  # mesh-promises books an UNADDRESSED [verify] to the `reflex-broadcast` dead-letter account, which
  # no window can ever post as, so the claim ages LOUD forever and is undischargeable BY CONSTRUCTION
  # (mesh-promises:33-38; six such claims stood 12.8-51.1h on 2026-07-24, drowning the real leaks).
  # Asserted against the LEDGER'S OWN REPLAY of the real string, not a regex on our own text.
  if command -v mesh-promises >/dev/null 2>&1; then
    _at="$(mktemp -d)"
    printf '2026-01-01T00:00:00Z  loadaudit@testnode  ::  %s\n' \
      "$(board_line testnode JUNK-LOAD JUNK-LOAD GPU-UNAVAILABLE rogueminer '?' 91.2 7.8 4)" > "$_at/board"
    _arep="$(MESH_CHAT_LOG="$_at/board" MESH_PROMISES_DIR="$_at/pdir" mesh-promises 2>/dev/null)"
    case "$_arep" in
      *reflex-broadcast*) echo "  FAIL alert line is an UNADDRESSED [verify] — the ledger books it to the reflex-broadcast dead-letter, payable by no window"; fail=1 ;;
      *"$CLAIM_OWNER"*)   : ;;
      *) echo "  FAIL alert line opened no payable claim in the ledger replay (got: $_arep)"; fail=1 ;;
    esac
    rm -rf "$_at"
  fi
  [ "$fail" = 1 ] && { echo "smoke-test: FAIL"; exit 1; }
  # ATTRIBUTION gate: the ALERT must name the node it describes, and name it as a PARAMETER.
  # Health's 2026-08-14 find: the node lived only in the poster field, so a mind on a 16-core box read
  # a 2-core node's `load1=15.01/2`, called it "misleading, actually /16c", verified its OWN node, and
  # closed the claim without ever checking the node that alerted.
  _bl="$(board_line testnode JUNK-LOAD JUNK-LOAD GPU-UNAVAILABLE rogueminer '?' 91.2 7.8 4)"
  case "$_bl" in
    *testnode*) : ;;
    *) echo "  FAIL alert line does not name the node it describes (got: '$_bl')"; fail=1 ;;
  esac
  # …and the node must come from the ARGUMENT, not from a hostname re-read inside the line: a line
  # that stamps itself with the reader's host is worse than one that names no host at all.
  case "$_bl" in
    *"$(hostname)"*) echo "  FAIL alert line stamps the LOCAL hostname instead of the node passed in (got: '$_bl')"; fail=1 ;;
  esac
  # CANONICAL-RENDERING gate: one quantity, one rendering. render() prints load1=<v>/<n>c; the board
  # line printed a bare /<n>, which reads as a ratio denominator — exactly how /2 was misread. Both
  # forms are asserted against the SAME inputs, so they cannot drift apart again.
  case "$_bl" in
    *"load1=7.8/4c"*) : ;;
    *) echo "  FAIL alert line does not render load1 in render()'s /<n>c form (got: '$_bl')"; fail=1 ;;
  esac
  _rl="$(label=QUIET cpu_label=QUIET cpu_reason=r gpu_label=GPU-IDLE gpu_reason=r l1=7.8 NPROC=4 \
         bash -c 'source /dev/stdin <<<"$(sed -n "/^render() {/,/^}/p" "$0")"; render' "$0" 2>/dev/null)"
  case "$_rl" in
    *"load1=7.8/4c"*) : ;;
    *) echo "  FAIL render() no longer prints load1 in the /<n>c form the board line is pinned to (got: '$_rl') — the two renderings have drifted"; fail=1 ;;
  esac
  # The `fail` sweep above this block runs BEFORE these gates, so it cannot see them: without this
  # second check the four assertions print FAIL and the suite still exits 0 (measured — every mutant
  # "survived" while printing its own red line).
  # --- COVERAGE gates: the across-run interval ranking and the resolution-aware fold -------------
  # fold_cpu, with the resolution passed EXPLICITLY so the assertions do not move when SAMPLE_DUR does.
  [ "$(fold_cpu 20.0 90.0 33.3)"   = "90.0 iv" ]    || { echo "  FAIL fold_cpu 20/90 → $(fold_cpu 20.0 90.0 33.3) (want '90.0 iv')"; fail=1; }
  [ "$(fold_cpu 200.0 90.0 33.3)"  = "200.0 inst" ] || { echo "  FAIL fold_cpu 200/90 → $(fold_cpu 200.0 90.0 33.3) (want '200.0 inst' — clears the resolution band)"; fail=1; }
  # INSIDE one tick's worth the narrow window cannot resolve the difference, so the wide one wins.
  # This is the assertion that stops a 33-point quantisation artifact taking the verdict every pass.
  [ "$(fold_cpu 110.0 90.0 33.3)"  = "90.0 iv" ]    || { echo "  FAIL fold_cpu 110/90 → $(fold_cpu 110.0 90.0 33.3) (want '90.0 iv' — 20 points is inside one 33.3% tick)"; fail=1; }
  [ "$(fold_cpu 55.0 na 33.3)"     = "55.0 inst" ]  || { echo "  FAIL fold_cpu na → $(fold_cpu 55.0 na 33.3) (want '55.0 inst' — na never wins)"; fail=1; }
  # iv_rank on fixture snapshots. prev at t=1000, now at t=1100 (dt=100s, clk=100 → 10000 ticks of
  # wall per core). Rows: 111 burned 5000 ticks → 50%; 222 idled → dropped (d=0); 333 is absent from
  # the baseline and started 10s ago → all 2000 of its ticks count → 20%; 444 is absent from the
  # baseline but has been up for hours → UNEXPLAINED, dropped rather than credited a lifetime of CPU
  # inside one interval; 555 went BACKWARDS → dropped.
  _pt="$(mktemp)"; _nt="$(mktemp)"
  printf '111\tburner\t1000\t50\n222\tidler\t7000\t50\n555\ttorn\t9000\t50\n' > "$_pt"
  printf '111\tburner\t6000\t50\n222\tidler\t7000\t50\n333\tnewborn\t2000\t499000\n444\tancient\t50000\t50\n555\ttorn\t8000\t50\n' > "$_nt"
  # uptime 5000s, clk 100 → starttime 499000 ticks = 4990s of uptime = born 10s ago; 50 = born at boot.
  _ivout="$(CLK=100 NPROC=16 iv_rank "$_pt" 1000 "$_nt" 1100 5000 480)"
  [ "$(printf '%s\n' "$_ivout" | wc -l)" = 2 ] || { echo "  FAIL iv_rank row count → $(printf '%s' "$_ivout" | tr '\n' ' ') (want exactly burner + newborn)"; fail=1; }
  printf '%s\n' "$_ivout" | head -1 | grep -q '^111	burner	50\.0$' || { echo "  FAIL iv_rank top row → $(printf '%s' "$_ivout" | head -1) (want '111 burner 50.0')"; fail=1; }
  printf '%s\n' "$_ivout" | grep -q '^333	newborn	20\.0$' || { echo "  FAIL iv_rank: a process BORN inside the interval must be counted (its ticks are all this interval's)"; fail=1; }
  printf '%s\n' "$_ivout" | grep -q 'ancient' && { echo "  FAIL iv_rank credited an OLD process missing from the baseline with its whole lifetime of CPU"; fail=1; }
  printf '%s\n' "$_ivout" | grep -q 'torn' && { echo "  FAIL iv_rank used a BACKWARDS tick delta (pid reuse / torn read) instead of dropping it"; fail=1; }
  # >100% per core is impossible over a real interval — a row claiming it is a parse/reuse artifact.
  printf '666\thog\t0\t50\n' >> "$_pt"; printf '666\thog\t99999999\t50\n' >> "$_nt"
  CLK=100 NPROC=16 iv_rank "$_pt" 1000 "$_nt" 1100 5000 480 | grep -q 'hog' && { echo "  FAIL iv_rank published a >100%/core row (impossible over the interval — an artifact, not a measurement)"; fail=1; }
  # MISSING EVIDENCE RENDERS na (here: no rows at all, which the caller turns into window=inst),
  # NEVER a zeroed ranking — "nobody is eating the CPU" is precisely what this auditor must not invent.
  CLK=100 NPROC=16 iv_rank /dev/null 1000 "$_nt" 1100 5000 480 >/dev/null 2>&1 && { echo "  FAIL iv_rank with no baseline (first run) must fail, not rank"; fail=1; }
  CLK=100 NPROC=16 iv_rank "$_pt" garbage "$_nt" 1100 5000 480 >/dev/null 2>&1 && { echo "  FAIL iv_rank with a garbage baseline epoch must fail"; fail=1; }
  CLK=100 NPROC=16 iv_rank "$_pt" 1100 "$_nt" 1100 5000 480 >/dev/null 2>&1 && { echo "  FAIL iv_rank with dt=0 must fail"; fail=1; }
  CLK=100 NPROC=16 iv_rank "$_pt" 1000 "$_nt" 99999 5000 480 >/dev/null 2>&1 && { echo "  FAIL iv_rank with a baseline past max-age must fail (never average across an unobserved gap)"; fail=1; }
  # inst_rank: the SAME physical cap as the interval ranking, on the in-run window. Fixture: 16
  # cores, a 0.3 s window (30 ticks of wall per core) — pid 111 burned 15 ticks → 50%, pid 999 shows
  # a 9000-tick jump → 30000%, which no 16-core machine can produce over any window (this is the
  # kernel tick-burst shape measured live at 5776.7%). It must be dropped AND counted, never silently.
  _it1="$(mktemp)"; _it2="$(mktemp)"
  printf '111\tburner\t0\t50\n999\tkworker/u32:9\t0\t50\n' > "$_it1"
  printf '111\tburner\t15\t50\n999\tkworker/u32:9\t9000\t50\n' > "$_it2"
  _ir="$(SAMPLE_DUR=0.3 CLK=100 NPROC=16 inst_rank "$_it1" "$_it2")"
  rm -f "$_it1" "$_it2"
  printf '%s\n' "$_ir" | awk -F'\t' '$1=="111" && $3=="50.0"{ok=1} END{exit !ok}' || { echo "  FAIL inst_rank real row → $(printf '%s' "$_ir" | tr '\n' ' ') (want '111 burner 50.0')"; fail=1; }
  printf '%s\n' "$_ir" | grep -q 'kworker' && { echo "  FAIL inst_rank published a >100%/core row — the in-run window must obey the same physical cap as the interval one"; fail=1; }
  printf '%s\n' "$_ir" | awk -F'\t' '$1=="#drop" && $2=="1"{ok=1} END{exit !ok}' || { echo "  FAIL inst_rank dropped a row without counting it (got: $(printf '%s' "$_ir" | grep '#drop')) — no silent caps"; fail=1; }

  # --- (a) THE NAME IS NOT THE IDENTITY -------------------------------------------------------
  # A kworker's comm is the CURRENT work item and the kernel rewrites it under us, so the label must
  # carry its own unreliability. The `R-` form is a workqueue RESCUER and its suffix IS stable — a
  # rule that eats it would delete real identity, so that is asserted too.
  [ "$(stable_name 'kworker/u32:5-phy1')" = 'kworker/u32:5-?' ] || { echo "  FAIL stable_name kept a kworker WORK ITEM as its name (got '$(stable_name 'kworker/u32:5-phy1')') — that label is not the identity that burned the CPU"; fail=1; }
  [ "$(stable_name 'kworker/u32:5-rtw88_usb: rx wq')" = 'kworker/u32:5-?' ] || { echo "  FAIL stable_name on a spacey kworker work item"; fail=1; }
  [ "$(stable_name 'kworker/0:1-events')" = 'kworker/0:1-?' ] || { echo "  FAIL stable_name on a non-unbound kworker"; fail=1; }
  [ "$(stable_name 'kworker/R-kinte')" = 'kworker/R-kinte' ] || { echo "  FAIL stable_name mangled a RESCUER thread (kworker/R-<wq> is stable — stripping it deletes real identity)"; fail=1; }
  [ "$(stable_name claude claude)" = 'claude' ] || { echo "  FAIL stable_name marked an unchanged ordinary comm"; fail=1; }
  [ "$(stable_name claude ollama)" = 'ollama~unstable' ] || { echo "  FAIL stable_name did not mark a comm that CHANGED across the sampling window (got '$(stable_name claude ollama)')"; fail=1; }
  # and the marker reaches the ROW — a naming rule the ranking does not apply is decoration.
  _nt1="$(mktemp)"; _nt2="$(mktemp)"
  printf '111\tkworker/u32:5-phy1\t0\t50\t1\n' > "$_nt1"
  printf '111\tkworker/u32:5-flush-252:0\t20\t50\t1\n' > "$_nt2"
  _nr="$(SAMPLE_DUR=0.3 CLK=100 NPROC=16 inst_rank "$_nt1" "$_nt2")"
  printf '%s\n' "$_nr" | grep -q '^111	kworker/u32:5-?	' || { echo "  FAIL inst_rank published a kworker's mutable work-item name (got: $(printf '%s' "$_nr" | grep -v '#drop')) — the 263.3% 'wifi-PHY' incident that never existed"; fail=1; }
  rm -f "$_nt1" "$_nt2"
  # the interval window keys on (pid,starttime), so a comm rewrite must no longer make a burning
  # thread look ABSENT from the baseline. Under the old (pid,comm) key this row vanished entirely.
  printf '777\tkworker/u32:5-rtw88_usb\t1000\t60\t1\n' >> "$_pt"
  printf '777\tkworker/u32:5-flush-252:0\t3000\t60\t1\n' >> "$_nt"
  CLK=100 NPROC=16 iv_rank "$_pt" 1000 "$_nt" 1100 5000 480 | grep -q '^777	kworker/u32:5-?	20\.0$' || { echo "  FAIL iv_rank lost a thread whose comm was REWRITTEN mid-interval (keying on a mutable label drops it on the very pass it is burning CPU)"; fail=1; }

  # --- (c) A TASK CANNOT OUTRUN ITS OWN THREADS -----------------------------------------------
  # 100*nproc (1600% here) cannot refute a single-threaded impossibility; 263.3% for a kworker sailed
  # through it. The ceiling is min(threads, cores), and the ONE-TICK slack is asserted in both
  # directions so the tightened cap cannot start eating the rows it exists to catch.
  _ct1="$(mktemp)"; _ct2="$(mktemp)"
  #      single-threaded @ 263.3% (impossible)   single-threaded @ 103.3% (100% + 1 tick of
  #      quantisation — REAL)                    8-threaded @ 400% (real, and >100%)
  printf '111\tkworker/u32:5-phy1\t0\t50\t1\n222\tpinned\t0\t50\t1\n333\tllama-server\t0\t50\t8\n' > "$_ct1"
  printf '111\tkworker/u32:5-phy1\t79\t50\t1\n222\tpinned\t31\t50\t1\n333\tllama-server\t120\t50\t8\n' > "$_ct2"
  _cr="$(SAMPLE_DUR=0.3 CLK=100 NPROC=16 inst_rank "$_ct1" "$_ct2")"
  rm -f "$_ct1" "$_ct2"
  printf '%s\n' "$_cr" | grep -q '^111	' && { echo "  FAIL inst_rank published 263% for a SINGLE-THREADED task — 100*nproc cannot catch a one-thread impossibility (got: $(printf '%s' "$_cr" | tr '\n' ' '))"; fail=1; }
  printf '%s\n' "$_cr" | grep -q '^222	pinned	103\.3$' || { echo "  FAIL inst_rank dropped a REAL single-thread-at-100% row: ticks are integers, so 100% over 0.3s/100Hz reads 103.3% and a hard 100% cap eats the very rows this auditor exists to catch"; fail=1; }
  printf '%s\n' "$_cr" | grep -q '^333	llama-server	400\.0$' || { echo "  FAIL inst_rank dropped a legitimately MULTITHREADED >100% row (8 threads at 400% is not impossible — capping every row at 100% would be a regression)"; fail=1; }
  printf '%s\n' "$_cr" | awk -F'\t' '$1=="#drop" && $2=="1"{ok=1} END{exit !ok}' || { echo "  FAIL the per-task cap dropped silently (got: $(printf '%s' "$_cr" | grep '#drop'))"; fail=1; }
  # a row with NO thread count must NOT be assumed single-threaded — that would fabricate a
  # constraint we did not measure. It falls back to the machine cap (the old behaviour, now confined).
  _ct1="$(mktemp)"; _ct2="$(mktemp)"
  printf '444\tunknownthreads\t0\t50\n' > "$_ct1"; printf '444\tunknownthreads\t120\t50\n' > "$_ct2"
  SAMPLE_DUR=0.3 CLK=100 NPROC=16 inst_rank "$_ct1" "$_ct2" | grep -q '^444	unknownthreads	400\.0$' || { echo "  FAIL a row with an UNKNOWN thread count was capped as if single-threaded — missing evidence must not fabricate a constraint"; fail=1; }
  rm -f "$_ct1" "$_ct2"

  # --- (c2) THE DIVISOR IS THE MEASURED WINDOW ------------------------------------------------
  # `sleep 0.3` is a floor. Measured under 48 spinners on 16 cores: 0.35-0.37s actual, so a nominal
  # divisor overstates every row 17-23%, worst exactly when the box is loaded. Same 15 ticks, two
  # divisors, two answers — and the measured one must win.
  _dt1="$(mktemp)"; _dt2="$(mktemp)"
  printf '111\tburner\t0\t50\t16\n' > "$_dt1"; printf '111\tburner\t15\t50\t16\n' > "$_dt2"
  [ "$(SAMPLE_DUR=0.3 CLK=100 NPROC=16 inst_rank "$_dt1" "$_dt2" | awk -F'\t' '$1=="111"{print $3}')" = "50.0" ] || { echo "  FAIL inst_rank nominal-divisor baseline"; fail=1; }
  [ "$(SAMPLE_DUR=0.3 CLK=100 NPROC=16 inst_rank "$_dt1" "$_dt2" 0.375 | awk -F'\t' '$1=="111"{print $3}')" = "40.0" ] || { echo "  FAIL inst_rank ignored the MEASURED window and divided by the nominal SAMPLE_DUR (15 ticks over a real 0.375s is 40%, not 50%)"; fail=1; }
  rm -f "$_dt1" "$_dt2"
  rm -f "$_pt" "$_nt"

  [ "$fail" = 1 ] && { echo "smoke-test: FAIL"; exit 1; }
  # No hand-maintained assert COUNT here: the old "19 cases + 18 coverage asserts" was already wrong
  # by the time anyone read it, and a roster count kept beside the roster rots in both directions.
  # Name the families instead — the families are what a reader is checking for absence of.
  echo "  ok: classify (cpu/gpu) + ghost-pid enrich silent + alert claim is addressed + alert names its node and renders /${NPROC}c like render() + iv_rank coverage + resolution-aware fold + identity-not-name (stable_name, pid+starttime keys) + per-task physical cap (both directions) + measured divisor + whole-row degrade (ghost / spacey comm / kthread)"
  # REAL-READ gate: the /proc 2-sample must yield ≥1 ranked row with a numeric pcpu (a gate you have
  # not seen FAIL is not a gate — if /proc vanishes the auditor must go UNAVAILABLE, not green).
  if [ ! -r /proc/loadavg ]; then echo "smoke-test: n/a (/proc/loadavg unreadable); classify-logic ok"; exit 2; fi
  _T1="$(mktemp)"; _T2="$(mktemp)"
  _ticks() { cat /proc/[0-9]*/stat 2>/dev/null | awk '{ pid=$1; sub(/^[0-9]+ \(/,"",$0); n=index($0,")"); comm=substr($0,1,n-1); rest=substr($0,n+2); split(rest,a," "); print pid"\t"comm"\t"(a[12]+a[13]) }'; }
  _ticks > "$_T1"; sleep 0.3; _ticks > "$_T2"
  _nrows="$(awk -v t1="$_T1" 'BEGIN{}' </dev/null; awk -v dur=0.3 -v clk="$CLK" 'FNR==NR{t[$1]=$3;next} ($1 in t){d=$3-t[$1]; if(d>0) c++} END{print c+0}' "$_T1" "$_T2")"
  rm -f "$_T1" "$_T2"
  [ "$_nrows" -gt 0 ] 2>/dev/null || { echo "smoke-test: FAIL (real /proc 2-sample yielded 0 ranked rows — auditor hollow)"; exit 1; }
  # GPU real-read: note-only (a non-GPU node still passes — CPU audit is the core).
  # `nvidia-smi` on PATH is not "the GPU answers": on 2026-08-14 the nvidia kernel module was not
  # loaded on mesh-home (`lsmod | grep -c nvidia` = 0) and the binary printed a prose error onto
  # stdout, which this leg read as an unparseable UTILISATION and called the TOOL broken — a red
  # --test that blocks mesh-land for a node condition the auditor is correctly reporting elsewhere
  # (the live path already renders GPU-UNAVAILABLE). Executable and loadable are different claims.
  # Split on nvidia-smi's EXIT CODE: rc≠0 = the organ is down → honest n/a (exit 2, which mesh-land
  # treats as a pass); rc=0 with unparseable output = a real parse defect → FAIL, as before.
  if command -v nvidia-smi >/dev/null 2>&1; then
    _u="$(nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits 2>/dev/null | head -1)"; _urc=$?
    if [ "$_urc" != 0 ]; then
      echo "smoke-test: n/a (nvidia-smi present but the driver does not answer, rc=$_urc — GPU organ DOWN, not a tool fault; CPU audit ok: classify 19 + REAL /proc=$_nrows procs)"
      exit 2
    fi
    case "$_u" in ''|*[!0-9]*) echo "smoke-test: FAIL (nvidia-smi answered rc=0 but util unparseable: '$_u')"; exit 1 ;; esac
    _realnote="classify 19 + REAL /proc=$_nrows procs + REAL gpu util=${_u}%"
  else
    _realnote="classify 19 + REAL /proc=$_nrows procs; GPU axis UNAVAILABLE — no nvidia-smi"
  fi

  # ---- STATE ROUND-TRIP: the interval exists only if run N's snapshot reaches run N+1 -----------
  # Drive two real runs against a sandboxed HOME (a --test must NEVER write the artifacts a watchdog
  # or the dash reads) and assert the coverage WIDENS: run 1 has no baseline (window=inst, cpu_iv
  # null), run 2 must read run 1's snapshot (window=inst+iv, numeric). Checking only run 1 would
  # pass with the carry deleted.
  _lh="$(mktemp -d)"; mkdir -p "$_lh/.mesh"
  _l1=$(HOME="$_lh" MESH_LA_DUR=1 "$0" --json 2>/dev/null)
  sleep 1
  _l2=$(HOME="$_lh" MESH_LA_DUR=1 "$0" --json 2>/dev/null)
  _lw1=$(printf '%s' "$_l1" | sed -n 's/.*"window":"\([a-z+]*\)".*/\1/p')
  _lw2=$(printf '%s' "$_l2" | sed -n 's/.*"window":"\([a-z+]*\)".*/\1/p')
  _liv2=$(printf '%s' "$_l2" | sed -n 's/.*"cpu_iv":\([a-z0-9.]*\).*/\1/p')
  _lep=$(sed -n '1s/^# \([0-9]*\)$/\1/p' "$_lh/.mesh/.load-audit-ticks" 2>/dev/null)
  _lrows=$(tail -n +2 "$_lh/.mesh/.load-audit-ticks" 2>/dev/null | wc -l)
  rm -rf "$_lh"
  [ "$_lw1" = inst ] || { echo "smoke-test: FAIL (run 1 has no baseline but reported window=$_lw1 — an interval was invented from nothing)"; exit 1; }
  [ "$_lw2" = "inst+iv" ] || { echo "smoke-test: FAIL (run 2 reported window=$_lw2 — the per-process snapshot is NOT carried across runs, coverage is still ${SAMPLE_DUR}s/120s)"; exit 1; }
  case "$_liv2" in ''|null) echo "smoke-test: FAIL (run 2 cpu_iv=$_liv2 — the interval window produced no ranking)"; exit 1;; esac
  { [ -n "$_lep" ] && [ "$_lrows" -gt 10 ]; } || { echo "smoke-test: FAIL (tick snapshot carries epoch='$_lep' rows=$_lrows — the next run cannot compute an interval)"; exit 1; }

  # ---- CONSUMING the interval is not COMPUTING it ----------------------------------------------
  # Seed a baseline in which THIS shell's own pid sits ~72000 ticks (12 CPU-minutes) behind, 60 s
  # ago: over that interval it reads ~1200%, far past anything the 1 s in-run window can produce.
  # Assert the fold NAMES the interval, the published top process is the INTERVAL's, and the top_cpu
  # is the interval's number — without this the tool can rank a perfect interval, print it, and
  # still hand the verdict (and the JUNK persistence gate) the 1 s sample's process.
  _fh="$(mktemp -d)"; mkdir -p "$_fh/.mesh"
  # The target must be a process that HAS 72000 ticks to give back — seeding a fresh shell's own pid
  # clamps to 0 and yields a ~1% interval instead of 1200% (measured: the gate then n/a'd itself).
  _seed_row="$(sample_ticks | sort -t$'\t' -k3 -rn | head -1)"
  IFS=$'\t' read -r _seed_pid _self_comm _seed_ticks _ <<< "$_seed_row"
  [ "${_seed_ticks:-0}" -gt 72000 ] 2>/dev/null || { echo "smoke-test: n/a — no process on this node has 12 CPU-minutes accumulated (top=${_self_comm:-none} ${_seed_ticks:-0} ticks), so the seeded-interval fold gate has nothing to seed"; exit 2; }
  { printf '# %s\n' "$(( $(date -u +%s) - 60 ))"
    printf '%s\n' "$_seed_row" | awk -F'\t' 'BEGIN{OFS="\t"} { $3 = $3-72000; print }'
    sample_ticks | awk -F'\t' -v me="$_seed_pid" '$1 != me'
  } > "$_fh/.mesh/.load-audit-ticks"
  # A 3 s in-run window for this child, not the live 0.3 s: kernel-worker stime lands in bursts of
  # ~1500 ticks on this node, and a 1 s window reads that burst as ~1544% — above the seeded 1200%,
  # which n/a'd the gate on the very first live run (measured). Averaged over 3 s the same burst
  # reads ~500%, so the seeded interval is the loud window by construction and the gate discriminates.
  _lf=$(HOME="$_fh" MESH_LA_DUR=3 "$0" --json 2>/dev/null)
  rm -rf "$_fh"
  _fwon=$(printf '%s' "$_lf" | sed -n 's/.*"won":"\([a-z]*\)".*/\1/p')
  _finst=$(printf '%s' "$_lf" | sed -n 's/.*"cpu_inst":\([0-9.]*\).*/\1/p')
  _fiv=$(printf '%s' "$_lf" | sed -n 's/.*"cpu_iv":\([0-9.]*\).*/\1/p')
  _ftop=$(printf '%s' "$_lf" | sed -n 's/.*"top_comm":"\([^"]*\)".*/\1/p')
  _ftcpu=$(printf '%s' "$_lf" | sed -n 's/.*"top_cpu":\([0-9.]*\).*/\1/p')
  awk -v a="${_finst:-0}" -v b="${_fiv:-0}" 'BEGIN{exit !(a+0 > b+0)}' && {
    echo "smoke-test: n/a — the live 3s window read ${_finst}% this instant, above the ~1200% the seeded interval sets up (a kernel-worker tick burst does this); the fold gate cannot discriminate on this reading"; exit 2; }
  [ "$_fwon" = iv ] || { echo "smoke-test: FAIL (seeded a ~1200% interval (iv=$_fiv vs inst=$_finst) but the fold named won=$_fwon — the interval window loses to the in-run sample)"; exit 1; }
  [ "$_ftop" = "$_self_comm" ] || { echo "smoke-test: FAIL (the interval won but the published top process is '$_ftop', not the interval's top '$_self_comm' — a row from one window wearing the other's verdict)"; exit 1; }
  [ "$_ftcpu" = "$_fiv" ] || { echo "smoke-test: FAIL (interval won but top_cpu=$_ftcpu != cpu_iv=$_fiv — the published axis is not the fold's value)"; exit 1; }

  # The summary prints HERE, after every gate — printed before them it would read as a pass while
  # the coverage gates had not run yet.
  echo "smoke-test: ok ($_realnote + across-run carry inst→inst+iv + seeded interval drives the top process and the verdict)"
  exit 0
fi

# --- live CPU read: 2-sample /proc delta over ALL procs (helpers above --test; a function
# defined below its caller is silently empty) -----------------------------------------------------
T1="$(mktemp)"; T2="$(mktemp)"; trap 'rm -f "$T1" "$T2"' EXIT
# The PREVIOUS run's snapshot + its epoch, read before this run overwrites them.
PREV_TICKS="$(mktemp)"; trap 'rm -f "$T1" "$T2" "$PREV_TICKS"' EXIT
prev_epoch=""
if [ -s "$TICKS_STATE" ]; then
  prev_epoch="$(sed -n '1s/^# \([0-9]*\)$/\1/p' "$TICKS_STATE")"
  tail -n +2 "$TICKS_STATE" > "$PREV_TICKS" 2>/dev/null || true
fi
# MEASURE the window, do not assume it. `sleep 0.3` is a floor, not a duration: the sweep itself costs
# time and a loaded runqueue stretches both. Measured 2026-08-18 with 48 spinners on 16 cores, the
# start-to-start gap ran 0.35-0.37 s against SAMPLE_DUR=0.300 — every %CPU overstated 17-23%, rising
# with contention, i.e. the auditor exaggerates exactly when it is being read. The estimator is
# start-to-start (not end-to-start): sample_ticks walks /proc in the same order both times, so each
# process is read at about the same offset into each sweep and its true gap is start2 - start1.
_up1="$(awk '{print $1}' /proc/uptime 2>/dev/null)"
sample_ticks > "$T1"
sleep "$SAMPLE_DUR"
_up2="$(awk '{print $1}' /proc/uptime 2>/dev/null)"
sample_ticks > "$T2"
# Falls back to the nominal only if /proc/uptime could not be read at both ends — never to a value
# that would flatter the reading.
MEAS_DUR="$(awk -v a="${_up1:-}" -v b="${_up2:-}" -v n="$SAMPLE_DUR" 'BEGIN{ d=b-a; if (a==""||b==""||d<=0) d=n+0; printf "%.3f", d }')"
# rank by instantaneous CPU%; fields: pid comm pcpu rss_mb etime args  (args/rss/etime filled below)
# ONE physical rule for BOTH windows: a row claiming more CPU than the machine HAS (100% × nproc)
# is not a measurement. The interval ranking has always dropped those; the in-run one published them
# — measured live 2026-08-15, cpu_inst=5776.7% for a kworker on a 16-core box, sitting in the same
# state line as a 98.9% interval that called the same shape impossible. Same rule, both windows.
# The drop is NOT silent: impossible_rows= travels in the reading, so "the artifact stopped
# appearing" can never be confused with "nothing was dropped".
_inst_rank="$(inst_rank "$T1" "$T2" "$MEAS_DUR")"
_IMPOSSIBLE_INST="$(printf '%s\n' "$_inst_rank" | awk -F'\t' '$1=="#drop"{print $2; exit}')"
mapfile -t TOP < <(printf '%s\n' "$_inst_rank" | grep -v '^#drop' | sort -t$'\t' -k3 -rn | head -"$TOPN")

# --- INTERVAL window: the same per-process counters delta'd against the PREVIOUS run -------------
now_epoch="$(date -u +%s)"
now_up="$(awk '{print $1}' /proc/uptime 2>/dev/null || echo 0)"
mapfile -t TOP_IV < <(iv_rank "$PREV_TICKS" "${prev_epoch:-}" "$T2" "$now_epoch" "$now_up" "$MAX_IV_AGE" | head -"$TOPN")
if [ "${#TOP_IV[@]}" -gt 0 ]; then
  IFS=$'\t' read -r _ iv_top_comm iv_top_cpu <<< "${TOP_IV[0]}"
  window="inst+iv"
else
  iv_top_comm=na; iv_top_cpu=na; window="inst"
fi
# Carry THIS run's snapshot for the next one — the interval window is nothing but this file.
{ printf '# %s\n' "$now_epoch"; cat "$T2"; } > "$TICKS_STATE" 2>/dev/null || true

# top proc for the verdict
inst_top_cpu=0
[ "${#TOP[@]}" -gt 0 ] && IFS=$'\t' read -r _ _ inst_top_cpu <<< "${TOP[0]}"
# Fold on the top process's CPU%: the louder window wins and is NAMED, and the ENTIRE table comes
# from the winning window — mixing one window's row with the other's number is two claims in one line.
# The resolution comes from the MEASURED window too — a stretched sample is a coarser one.
read -r fused_top_cpu won <<< "$(fold_cpu "$inst_top_cpu" "$iv_top_cpu" \
  "$(awk -v d="$MEAS_DUR" -v c="$CLK" 'BEGIN{ printf "%.4f", (d*c>0)? 100.0/(d*c) : 0 }')")"
[ "$won" = iv ] && TOP=("${TOP_IV[@]}")
if [ "${#TOP[@]}" -gt 0 ]; then
  IFS=$'\t' read -r _ top_comm top_cpu <<< "${TOP[0]}"
  top_args="$(tr '\0' ' ' < "/proc/$(printf '%s' "${TOP[0]}" | cut -f1)/cmdline" 2>/dev/null | cut -c1-60)"; top_args="${top_args:-$top_comm}"
  # classify the name WITHOUT the unreliability markers (see top_line) — `-?`/`~unstable` are a
  # statement about how much the label can be trusted, not part of the process's name.
  _ctop="${top_comm%\~unstable}"; _ctop="${_ctop%-\?}"
  top_tag="$(classify_comm "$_ctop" "$top_args")"
else
  top_comm=none; top_cpu=0; top_tag=system
fi

# busy? (load1 ground truth)
l1="$(awk '{print $1}' /proc/loadavg 2>/dev/null)"; l1="${l1:-0}"
busy="$(awk -v l="$l1" -v n="$NPROC" -v m="$BUSY_L1_MUL" 'BEGIN{print (l>=m*n)?1:0}')"

cres="$(cpu_verdict "$busy" "$top_comm" "$top_tag" "$top_cpu" "$NPROC")"
cpu_label="${cres%%|*}"; cpu_reason="${cres#*|}"

# --- persistence gate: a runaway is a CONDITION, not one snapshot (see header) ------------------
# The record is rewritten EVERY pass (kept only while the verdict is JUNK-*), so "previous pass" is
# a fact on disk, not an assumption about the cadence. Age is measured, so missed passes cannot be
# silently counted as consecutive.
JUNK_MIN="${MESH_LA_JUNK_MIN_PASSES:-2}"
if [ "$cpu_label" = "JUNK-LOAD" ]; then
  _pcomm="-"; _pcount=0; _page=999999
  if [ -f "$JUNK_STATE" ]; then
    IFS='|' read -r _pcomm _pcount _pts < "$JUNK_STATE" 2>/dev/null
    _pcomm="${_pcomm:--}"
    [ -n "${_pts:-}" ] && _page="$(( $(date -u +%s) - _pts ))"
  fi
  _jp="$(junk_persist "$_pcomm" "$_pcount" "$_page" "$top_comm")"
  _runs="${_jp%%|*}"; _jnote="${_jp#*|}"
  printf '%s|%s|%s\n' "$top_comm" "$_runs" "$(date -u +%s)" > "$JUNK_STATE"
  _jl="$(junk_label "$_runs" "$JUNK_MIN" "$top_comm" "$top_cpu" "$_jnote" "$cpu_reason")"
  cpu_label="${_jl%%|*}"; cpu_reason="${_jl#*|}"
else
  rm -f "$JUNK_STATE" 2>/dev/null || true   # the run is broken; the next [?] top starts a fresh run
fi

# --- live GPU read ------------------------------------------------------------
gpu_util=UNAVAILABLE; gpu_vused=""; gpu_vtot=""; gpu_apps=""
if command -v nvidia-smi >/dev/null 2>&1; then
  # one query-gpu call + one query-compute-apps call
  read -r gpu_util gpu_vused gpu_vtot < <(nvidia-smi --query-gpu=utilization.gpu,memory.used,memory.total --format=csv,noheader,nounits 2>/dev/null | head -1 | tr -d ' ' | tr ',' ' ')
  case "$gpu_util" in ''|*[!0-9]*) gpu_util=UNAVAILABLE ;; esac
  if [ "$gpu_util" != UNAVAILABLE ]; then
    while IFS=',' read -r gpid gname gmem; do
      [ -n "${gpid:-}" ] || continue
      gn="$(printf '%s' "$gname" | tr -d ' ')"; gt="$(classify_gpuproc "$gn")"
      gpu_apps+="${gn}[${gt}] "
    done < <(nvidia-smi --query-compute-apps=pid,process_name,used_memory --format=csv,noheader,nounits 2>/dev/null)
  fi
fi
gres="$(gpu_verdict "$gpu_util" "${gpu_vused:-0}" "${gpu_vtot:-0}" "$gpu_apps")"
gpu_label="${gres%%|*}"; gpu_reason="${gres#*|}"

# --- aggregate label (worst axis) --------------------------------------------
# priority: any alert axis > MIND/ORGAN/USER-LOAD > QUIET. Alerts = JUNK-LOAD, GPU-UNKNOWN, GPU-ZOMBIE.
alert=0
case "$cpu_label" in JUNK-LOAD) alert=1 ;; esac
case "$gpu_label" in GPU-UNKNOWN|GPU-ZOMBIE) alert=1 ;; esac
if [ "$alert" = 1 ]; then
  # pick the most actionable as the headline
  case "$cpu_label" in JUNK-LOAD) label="$cpu_label" ;; *) label="$gpu_label" ;; esac
elif [ "$busy" = 1 ]; then
  label="$cpu_label"
else
  # not busy on CPU; headline reflects GPU if it is busy, else QUIET
  case "$gpu_label" in GPU-IDLE|GPU-UNAVAILABLE) label="QUIET" ;; *) label="$gpu_label" ;; esac
fi

TS=$(date -u +%Y-%m-%dT%H:%M:%SZ)
# top-procs summary for the state (compact)
topsum=""
for row in "${TOP[@]}"; do
  IFS=$'\t' read -r pid pcomm pcpu <<< "$row"
  topsum+="$(top_line "$pid" "$pcomm" "$pcpu"); "
done
# state line (dash reads this by key= field prefix, so the coverage fields append safely)
# sample_dur is the MEASURED in-run window, not SAMPLE_DUR — a reader comparing two cpu_inst values
# needs to know they were divided by different numbers, so the divisor travels with the reading.
printf 'CPU=%s|GPU=%s|load1=%s|nproc=%s|cpu=%s|gpu=%s|top=%s|window=%s|cpu_inst=%s|cpu_iv=%s|top_iv=%s|won=%s|impossible_rows=%s|sample_dur=%s|%s\n' \
  "$cpu_label" "$gpu_label" "$l1" "$NPROC" "$cpu_reason" "$gpu_reason" "${topsum%; }" \
  "$window" "$inst_top_cpu" "$iv_top_cpu" "$iv_top_comm" "$won" "$_IMPOSSIBLE_INST" "$MEAS_DUR" "$TS" > "$STATE"
mesh-state-touch "$STATE" 2>/dev/null || touch "$STATE"

# --- output ---
render() {
  printf '[load-audit %s] CPU=%s (%s) | GPU=%s (%s) | load1=%s/%dc | window=%s top-cpu inst=%s%% iv=%s won=%s\n' \
    "$(printf '%s' "$label" | tr '[:upper:]' '[:lower:]')" "$cpu_label" "$cpu_reason" "$gpu_label" "$gpu_reason" "$l1" "$NPROC" \
    "$window" "$inst_top_cpu" "$([ "$iv_top_cpu" = na ] && echo na || echo "${iv_top_cpu}%")" "$won"
  [ "${_IMPOSSIBLE_INST:-0}" -gt 0 ] 2>/dev/null && \
    printf '  dropped %s in-run row(s) claiming more CPU than the task could physically use — min(its threads, %s cores) + one tick (kernel tick-burst accounting)\n' "$_IMPOSSIBLE_INST" "$NPROC"
  if [ "${#TOP[@]}" -gt 0 ]; then
    printf '  top CPU (%s window — %s):\n' "$won" \
      "$([ "$won" = iv ] && echo "mean since the previous run" || echo "instantaneous, ${MEAS_DUR}s measured")"
    for row in "${TOP[@]}"; do
      IFS=$'\t' read -r pid pcomm pcpu <<< "$row"
      printf '    %s\n' "$(top_line "$pid" "$pcomm" "$pcpu")"
    done
  fi
  if [ "$gpu_util" != UNAVAILABLE ] && [ -n "$gpu_apps" ]; then
    printf '  GPU compute-apps: %s\n' "${gpu_apps%% }"
  fi
}

case "${1:-}" in
  --json)
    printf '{"label":"%s","cpu_label":"%s","cpu_reason":"%s","gpu_label":"%s","gpu_reason":"%s","load1":%s,"nproc":%s,"window":"%s","top_cpu":%s,"top_comm":"%s","cpu_inst":%s,"cpu_iv":%s,"top_comm_iv":"%s","won":"%s","impossible_rows":%s,"ts":"%s"}\n' \
      "$label" "$cpu_label" "$cpu_reason" "$gpu_label" "$gpu_reason" "$l1" "$NPROC" \
      "$window" "$top_cpu" "$top_comm" "$inst_top_cpu" \
      "$([ "$iv_top_cpu" = na ] && echo null || echo "$iv_top_cpu")" "$iv_top_comm" "$won" "$_IMPOSSIBLE_INST" "$TS"
    ;;
  --edge)
    # emit + board-post only on verdict CHANGE (sticky flag so a lingering junk proc = one episode)
    prev=""; [ -f "$FLAG" ] && prev="$(cat "$FLAG" 2>/dev/null)"
    [ "$prev" = "$label" ] && exit 0
    printf '%s' "$label" > "$FLAG"
    out="$(render)"
    printf '%s\n' "$out"
    # board post only on ALERT verdicts (so the operator/minds see it in mesh-chat)
    if [ "$alert" = 1 ]; then
      _node="$(hostname)"; _hl="loadaudit@$_node"
      command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="$_hl" \
        mesh-chat "$(board_line "$_node" "$label" "$cpu_label" "$gpu_label" "$top_comm" "$top_tag" "$top_cpu" "$l1" "$NPROC")" >/dev/null 2>&1 || true
    fi
    ;;
  *)
    render ;;
esac
