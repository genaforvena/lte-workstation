#!/usr/bin/env python3
"""mesh-job-scan-li — sweep LinkedIn for vacancies WITHOUT logging in, at a deliberate crawl.

  mesh-job-scan-li [--queries <file>] [--pages N] [--location L] [--remote] [--json] [--quiet]
  mesh-job-scan-li --test

# reflex-cadence: 53 6 * * *

LinkedIn's guest job feed (`jobs-guest/jobs/api/seeMoreJobPostings/search`) answers 200 with 25-30
cards and no credential at all — measured from this node 2026-08-15. So SCANNING LinkedIn needs no
account; only APPLYING does. This tool does the half that is free, and never touches the other.

**Pace is a safety property here, not politeness.** This node's egress reads as Amsterdam hosting,
LinkedIn polices guest crawling harder than hh, and an account restriction is recovered only by
sending them a selfie holding a document — a cost the operator would pay for a scan he did not ask
to be fast. One request per `--sleep` seconds (default 20, i.e. ~3/min) and no concurrency, ever.
There is no --fast flag on purpose.

Rows land in ~/.mesh/job-board.tsv as `seen`, deduped by LinkedIn job id against everything the
board already holds. LinkedIn rarely publishes salary, so the salary field is usually absent —
`mesh-job-apply` ranks a blank salary below a stated one instead of assuming either way.
"""
import argparse, html, json, os, pathlib, re, subprocess, sys, time
from urllib.parse import quote
from urllib.request import Request, urlopen

MESH = pathlib.Path(os.path.expanduser("~/.mesh"))
BOARD = MESH / "job-board.tsv"
QUERIES = MESH / "job/scan-queries.txt"

def node_env(key, default="off"):
    """Read a node-local knob from ~/.mesh/nodes WITHOUT sourcing it.

    cron gives a reflex an environment with nothing in it — no BASH_ENV, no login shell — and it
    never sources ~/.mesh/nodes. So a knob read from `os.environ` alone carries its DEFAULT on
    every scheduled run while a mind's pane shows the operator's value: a config edit that reads
    as applied and is not. Measured on mesh-job-apply (04f98795), not read off the source — with
    MESH_JOB_DAILY_CAP=20 in the file, `env -i HOME PATH SHELL` still printed "Бюджет 5 из 5".
    Process env still wins, so a caller can override for one run."""
    v = os.environ.get(key)
    if v is not None:
        return v
    try:
        with open(os.path.join(os.path.expanduser("~"), ".mesh", "nodes"),
                  encoding="utf-8", errors="replace") as fh:
            txt = fh.read()
    except Exception:
        return default
    hit = None
    for line in txt.splitlines():
        m = re.match(r"\s*(?:export\s+)?%s=[\"\']?([^\"\'#\s]*)" % re.escape(key), line)
        if m:
            hit = m.group(1)
    return hit if hit is not None else default


# EVERY node-local knob goes through node_env(), never os.environ — see its docstring, which was
# written for exactly this trap. The constants sit BELOW its definition on purpose: at module
# scope a name is not bound above its def, and ast.parse calls such a file perfectly good while
# the tool dies at import on NameError (mesh-job-apply's first edit did exactly that).
LI_LOCATION = node_env("MESH_JOB_LI_LOCATION", "Worldwide")

UA = ("Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) "
      "Chrome/128.0.0.0 Safari/537.36")
BASE = "https://www.linkedin.com/jobs-guest/jobs/api/seeMoreJobPostings/search"

CARD = re.compile(r'data-entity-urn="urn:li:jobPosting:(\d+)"')
TITLE = re.compile(r'class="base-search-card__title">\s*(.*?)\s*</h3>', re.S)
COMP = re.compile(r'class="base-search-card__subtitle">.*?>\s*(.*?)\s*</a>|'
                  r'class="base-search-card__subtitle">\s*(.*?)\s*</h4>', re.S)
LOC = re.compile(r'class="job-search-card__location">\s*(.*?)\s*</span>', re.S)
DATE = re.compile(r'<time[^>]*datetime="([\d-]+)"')


def clean(s):
    return re.sub(r"\s+", " ", html.unescape(re.sub(r"<[^>]+>", " ", s or ""))).strip()


def fetch(keywords, location, start, remote, timeout=25):
    url = "%s?keywords=%s&location=%s&start=%d" % (BASE, quote(keywords), quote(location), start)
    if remote:
        url += "&f_WT=2"
    req = Request(url, headers={"User-Agent": UA, "Accept-Language": "en,ru;q=0.8"})
    with urlopen(req, timeout=timeout) as r:
        return r.status, r.read().decode("utf-8", "replace")


def parse(body):
    """Split on the card boundary so a field can never be read from the NEXT card."""
    out = []
    chunks = re.split(r'(?=data-entity-urn="urn:li:jobPosting:)', body)
    for c in chunks:
        m = CARD.search(c)
        if not m:
            continue
        t = TITLE.search(c)
        cm = COMP.search(c)
        out.append({
            "id": m.group(1),
            "title": clean(t.group(1)) if t else "",
            "employer": clean((cm.group(1) or cm.group(2)) if cm else ""),
            "location": clean(LOC.search(c).group(1)) if LOC.search(c) else "",
            "posted": DATE.search(c).group(1) if DATE.search(c) else "",
            "url": "https://www.linkedin.com/jobs/view/%s" % m.group(1),
        })
    return out


def board_ids():
    if not BOARD.exists():
        return set()
    txt = BOARD.read_text(encoding="utf-8")
    return set(re.findall(r"linkedin\.com/jobs/view/(\d+)", txt))


def append(rows, today):
    lines = []
    for r in rows:
        note = ("linkedin guest-scan %s | %s | опубликовано %s | зарплата не указана (LinkedIn её "
                "почти никогда не публикует)" % (today, r["location"] or "локация не указана",
                                                 r["posted"] or "дата не указана"))
        lines.append("\t".join([today, r["employer"], r["title"], r["url"], "seen", note]))
    if lines:
        with BOARD.open("a", encoding="utf-8") as f:
            f.write("\n".join(lines) + "\n")
    return len(lines)


def selftest():
    rc = 0

    def check(label, cond):
        nonlocal rc
        print(("ok:   " if cond else "FAIL: ") + label)
        if not cond:
            rc = 1

    # EVERY node knob must survive a CRON environment, not just the ones a pane exercises. cron
    # never sources ~/.mesh/nodes, so a knob read from os.environ carries its DEFAULT on every
    # scheduled run while the pane shows the operator's value — a config edit that reads as
    # applied and is not (measured on mesh-job-apply, 04f98795: cap 20 in the file, "5 из 5" on
    # the run). Driven END TO END, as a subprocess under a fabricated HOME with `env -i`, because
    # the binding happens at IMPORT: an in-process check cannot see a constant that was already
    # bound wrong. Two arms with DIFFERENT values, so a tool that ignores the file entirely fails
    # one of them whatever its own default is. (Mutant seen red: node_env -> os.environ.get.)
    import tempfile as _tf
    _KEY, _ARMS = "MESH_JOB_LI_LOCATION", ("ArmOneCity", "ArmTwoCity")
    _seen = []
    for _want in _ARMS:
        _h = _tf.mkdtemp(prefix="node-env-arm-")
        os.makedirs(os.path.join(_h, ".mesh", "job"), exist_ok=True)
        with open(os.path.join(_h, ".mesh", "nodes"), "w") as _f:
            _f.write("export %s=%s\n" % (_KEY, _want))
        _p = subprocess.run(["/usr/bin/env", "-i", "HOME=" + _h, "PATH=/usr/bin:/bin",
                             "SHELL=/bin/sh", sys.executable, os.path.abspath(__file__),
                             "--print-knobs"], capture_output=True, text=True, timeout=60)
        _seen.append(("%s=%s" % (_KEY, _want)) in _p.stdout)
    check("%s is read from ~/.mesh/nodes under a CRON environment (arm 1: %s)" % (_KEY, _ARMS[0]),
          _seen[0])
    check("...and tracks the file, not a constant (arm 2: %s)" % _ARMS[1], _seen[1])

    sample = ('x data-entity-urn="urn:li:jobPosting:111"><h3 class="base-search-card__title">\n'
              ' Go Team Lead \n</h3><h4 class="base-search-card__subtitle">\n Acme \n</h4>'
              '<span class="job-search-card__location">\n Berlin \n</span>'
              '<time class="job-search-card__listdate" datetime="2026-08-01">'
              ' data-entity-urn="urn:li:jobPosting:222"><h3 class="base-search-card__title">\n'
              ' Backend Engineer \n</h3><h4 class="base-search-card__subtitle">\n Beta \n</h4>')
    rows = parse(sample)
    check("both cards parsed", len(rows) == 2)
    check("title and employer belong to the SAME card",
          rows[0]["title"] == "Go Team Lead" and rows[0]["employer"] == "Acme"
          and rows[1]["title"] == "Backend Engineer" and rows[1]["employer"] == "Beta")
    # The bug this guards: a regex run over the whole page attaches card 1's location to card 2.
    check("a card without a location does not borrow the previous one",
          rows[1]["location"] == "")
    check("url is built from the job id", rows[0]["url"].endswith("/111"))

    try:
        st, body = fetch("golang team lead", "Worldwide", 0, True)
        live = parse(body)
        check("live guest endpoint answers 200 without any credential", st == 200)
        check("live response yields cards with ids and titles",
              len(live) >= 5 and all(r["id"].isdigit() for r in live) and any(r["title"] for r in live))
        print("      live: %d card(s), e.g. %s — %s"
              % (len(live), live[0]["employer"][:24], live[0]["title"][:40]))
    except Exception as e:
        print("n/a: LinkedIn guest endpoint unreachable (%s: %s)" % (type(e).__name__, str(e)[:80]))
        return 2 if rc == 0 else rc
    return rc


def main():
    ap = argparse.ArgumentParser(add_help=False)
    ap.add_argument("--queries", default=str(QUERIES))
    ap.add_argument("--pages", type=int, default=1)
    ap.add_argument("--location", default=LI_LOCATION)
    ap.add_argument("--remote", action="store_true")
    ap.add_argument("--sleep", type=int, default=20)
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--quiet", action="store_true")
    ap.add_argument("--test", action="store_true")
    ap.add_argument("-h", "--help", action="store_true")
    ap.add_argument("--print-knobs", action="store_true", help=argparse.SUPPRESS)
    a = ap.parse_args()
    # Internal leg of --test: prints the node knobs AS BOUND AT IMPORT. Binding happens at import,
    # so only a real subprocess under `env -i` can show which value a cron environment actually got.
    if a.print_knobs:
        print("MESH_JOB_LI_LOCATION=%s" % (LI_LOCATION,))
        return 0
    if a.help:
        print(__doc__)
        return 0
    if a.test:
        return selftest()

    qp = pathlib.Path(a.queries)
    queries = ([l.strip() for l in qp.read_text(encoding="utf-8").splitlines()
                if l.strip() and not l.startswith("#")] if qp.exists() else ["golang team lead"])

    known, rows, first = board_ids(), [], True
    for q in queries:
        for pg in range(a.pages):
            if not first:
                time.sleep(a.sleep)
            first = False
            try:
                st, body = fetch(q, a.location, pg * 25, a.remote)
            except Exception as e:
                print("warn: %s / page %d failed (%s)" % (q, pg, type(e).__name__), file=sys.stderr)
                continue
            if st != 200:
                print("warn: %s / page %d -> HTTP %d (LinkedIn throttling — stopping this sweep)"
                      % (q, pg, st), file=sys.stderr)
                return 1
            for r in parse(body):
                if r["id"] in known:
                    continue
                known.add(r["id"])
                r["query"] = q
                rows.append(r)

    today = time.strftime("%Y-%m-%d")
    n = append(rows, today)
    if a.json:
        print(json.dumps(rows, ensure_ascii=False, indent=1))
    elif not a.quiet:
        for r in rows:
            print("%-26s %-46s %s" % (r["employer"][:26], r["title"][:46], r["location"][:26]))
        print("\n%d new LinkedIn row(s) appended, %d quer%s at 1 per %ds"
              % (n, len(queries), "y" if len(queries) == 1 else "ies", a.sleep))
    return 0


if __name__ == "__main__":
    sys.exit(main())
