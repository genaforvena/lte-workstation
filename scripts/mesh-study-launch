#!/usr/bin/env bash
# mesh-study-launch — queue the frozen Tiny Fleet matrix until mesh resources admit it.
#
# Uses only the preregistered arms/seeds; no interactive parameter selection. mesh-heavy-run durably
# queues admission deferrals, and mesh-heavy-drain retries them every two minutes. Once admitted, the
# matrix runner performs short live-VRAM waits and returns EX_TEMPFAIL on continued contention, which
# the outer queue treats as retryable rather than as a study failure.
# reflex-cadence: none  # explicit study invocation; durable resource queue owns retries
# orphan-ok: explicit preregistered research run; invocation itself is retained by mesh-heavy-run.
set -u -o pipefail
export PATH="$HOME/.local/bin:$PATH"

STUDY_ROOT="${MESH_STUDY_ROOT:-$HOME/tiny-fleet}"
PYTHON="${MESH_STUDY_PYTHON:-$STUDY_ROOT/.venv/bin/python}"
RUNNER="$STUDY_ROOT/scripts/run_study_matrix.py"
REGISTRATION="$STUDY_ROOT/runs/fleet-study-v1/registration.json"
RUN_ROOT="$STUDY_ROOT/runs/fleet-study-v1"
RAM_BUDGET_MB="${MESH_STUDY_RAM_BUDGET_MB:-10240}"
GPU_MIN_FREE_MB="${MESH_STUDY_GPU_MIN_FREE_MB:-2048}"
GPU_WAIT_S="${MESH_STUDY_GPU_WAIT_S:-60}"
GPU_POLL_S="${MESH_STUDY_GPU_POLL_S:-15}"

if [ "${1:-}" = --test ]; then
  [ -x "$PYTHON" ] || { echo "mesh-study-launch: study Python is not executable: $PYTHON" >&2; exit 2; }
  [ -f "$RUNNER" ] || { echo "mesh-study-launch: matrix runner missing: $RUNNER" >&2; exit 2; }
  [ -f "$REGISTRATION" ] || { echo "mesh-study-launch: frozen registration missing: $REGISTRATION" >&2; exit 2; }
  [[ "$RAM_BUDGET_MB:$GPU_MIN_FREE_MB:$GPU_WAIT_S:$GPU_POLL_S" =~ ^[0-9]+:[0-9]+:[0-9]+:[0-9]+$ ]] \
    || { echo 'mesh-study-launch: resource settings must be non-negative integers' >&2; exit 2; }
  echo "mesh-study-launch: ok (registration=$(sha256sum "$REGISTRATION" | cut -d' ' -f1) ram=${RAM_BUDGET_MB}MB gpu_min=${GPU_MIN_FREE_MB}MB gpu_wait=${GPU_WAIT_S}s)"
  exit 0
fi

[ "$#" -eq 0 ] || { echo "usage: $0 [--test]" >&2; exit 64; }
for n in "$RAM_BUDGET_MB" "$GPU_MIN_FREE_MB" "$GPU_WAIT_S" "$GPU_POLL_S"; do
  case "$n" in ''|*[!0-9]*) echo 'mesh-study-launch: resource settings must be non-negative integers' >&2; exit 64;; esac
done
[ "$RAM_BUDGET_MB" -gt 0 ] && [ "$GPU_MIN_FREE_MB" -gt 0 ] && [ "$GPU_POLL_S" -gt 0 ] \
  || { echo 'mesh-study-launch: RAM, GPU threshold, and poll interval must be positive' >&2; exit 64; }
[ -x "$PYTHON" ] && [ -f "$RUNNER" ] && [ -f "$REGISTRATION" ] \
  || { echo "mesh-study-launch: preregistered runner inputs are not ready under $STUDY_ROOT" >&2; exit 66; }
command -v mesh-heavy-run >/dev/null 2>&1 \
  || { echo 'mesh-study-launch: mesh-heavy-run is unavailable; refusing an unqueued GPU study' >&2; exit 69; }

cd "$STUDY_ROOT" || exit 72
mkdir -p "$RUN_ROOT"
registration_sha256="$(sha256sum "$REGISTRATION" | awk '{print $1}')"
receipt_tmp="$RUN_ROOT/autonomy-decision.json.tmp.$$"
cat > "$receipt_tmp" <<EOF
{
  "schema": "mesh.autonomous-study-decision/v1",
  "study_id": "fleet-study-v1",
  "operator_required": false,
  "parameter_source": "frozen registration plus live resource admission",
  "registration_sha256": "$registration_sha256",
  "manifest": "corpus/study-v1/manifest.json",
  "selection_policy": "run every registered arm and every registered seed; no manual subset"
}
EOF
mv "$receipt_tmp" "$RUN_ROOT/autonomy-decision.json"
MESH_HEAVY_GPU_MIN_FREE_MB="$GPU_MIN_FREE_MB" \
MESH_HEAVY_GPU_SMI="${MESH_STUDY_GPU_SMI:-nvidia-smi}" \
  mesh-heavy-run "$RAM_BUDGET_MB" -- env \
    MESH_STUDY_GPU_MIN_FREE_MB="$GPU_MIN_FREE_MB" \
    MESH_STUDY_GPU_SMI="${MESH_STUDY_GPU_SMI:-nvidia-smi}" \
    "$PYTHON" "$RUNNER" \
    --registration "$REGISTRATION" --run-root "$RUN_ROOT" \
    --gpu-min-free-mb "$GPU_MIN_FREE_MB" --gpu-wait-s "$GPU_WAIT_S" --gpu-poll-s "$GPU_POLL_S"
