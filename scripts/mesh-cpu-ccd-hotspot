#!/usr/bin/env bash
# orphan-ok: on-demand raw hardware probe; mesh-cpu-thermal-spread consumes Tccd1 in a relation, but no standalone CCD-hotspot artifact exists
# mesh-cpu-ccd-hotspot — AMD k10temp CCD1 hotspot temperature sense.
#
# This is a first-class raw signal, distinct from the existing Tctl↔Tccd1 spread relation:
# consumers that need the die hotspot itself should not reverse-engineer it from a relation.
# A missing k10temp/Tccd1 pair is UNREACHABLE (exit 2), never a fabricated zero or cool value.
#
#   mesh-cpu-ccd-hotspot          one live reading
#   mesh-cpu-ccd-hotspot --json   machine-readable reading
#   mesh-cpu-ccd-hotspot --test   fixture parser + real sysfs read
set -uo pipefail

ROOT="${MESH_CPU_CCD_ROOT:-/sys/class/hwmon}"

read_ccd1() {
  local h name label input raw
  for h in "$ROOT"/hwmon*; do
    [ -d "$h" ] || continue
    name="$(tr -d '\r\n' <"$h/name" 2>/dev/null || true)"
    [ "$name" = k10temp ] || continue
    for label in "$h"/temp*_label; do
      [ -r "$label" ] || continue
      [ "$(tr -d '\r\n' <"$label" 2>/dev/null || true)" = Tccd1 ] || continue
      input="${label%_label}_input"
      [ -r "$input" ] || continue
      raw="$(tr -d '[:space:]' <"$input" 2>/dev/null || true)"
      case "$raw" in
        ''|*[!0-9]*) continue ;;
        *) printf '%s\t%s\n' "$raw" "$input"; return 0 ;;
      esac
    done
  done
  return 2
}

format_c() {
  awk -v raw="$1" 'BEGIN { if (raw !~ /^[0-9]+$/) exit 1; printf "%.1f", raw / 1000 }'
}

if [ "${1:-}" = --test ]; then
  td="$(mktemp -d)" || { echo 'smoke-test: FAIL (mktemp)' >&2; exit 1; }
  trap 'rm -rf "$td"' EXIT
  mkdir -p "$td/hwmon0"
  printf 'k10temp\n' >"$td/hwmon0/name"
  printf 'Tctl\n' >"$td/hwmon0/temp1_label"
  printf '72625\n' >"$td/hwmon0/temp1_input"
  printf 'Tccd1\n' >"$td/hwmon0/temp3_label"
  printf '70250\n' >"$td/hwmon0/temp3_input"
  fixture="$(MESH_CPU_CCD_ROOT="$td" "$0" --json 2>/dev/null)" || {
    echo "smoke-test: FAIL (fixture read: $fixture)" >&2; exit 1;
  }
  printf '%s\n' "$fixture" | grep -q '"sensor":"Tccd1"' || {
    echo "smoke-test: FAIL (fixture sensor: $fixture)" >&2; exit 1;
  }
  printf '%s\n' "$fixture" | grep -q '"temp_mC":70250' || {
    echo "smoke-test: FAIL (fixture value: $fixture)" >&2; exit 1;
  }
  MESH_CPU_CCD_ROOT="$td/missing" "$0" >/dev/null 2>&1
  rc=$?
  [ "$rc" -eq 2 ] || { echo "smoke-test: FAIL (missing sensor must exit 2, got $rc)" >&2; exit 1; }
  live_rc=0
  live="$("$0" --json 2>/dev/null)" || live_rc=$?
  if [ "$live_rc" -eq 2 ]; then
    echo 'smoke-test: n/a (k10temp Tccd1 unavailable on this node)' >&2
    exit 2
  fi
  [ "$live_rc" -eq 0 ] && printf '%s\n' "$live" | grep -q '"temp_mC":[0-9]' || {
    echo "smoke-test: FAIL (real read malformed rc=$live_rc: $live)" >&2; exit 1;
  }
  echo "smoke-test: ok (fixture + honest unreachable exit-2 + REAL k10temp Tccd1 read: $live)"
  exit 0
fi

reading="$(read_ccd1 2>/dev/null)" || {
  echo "mesh-cpu-ccd-hotspot: UNREACHABLE — no readable k10temp Tccd1 under $ROOT" >&2
  exit 2
}
temp_mC="${reading%%$'\t'*}"
source="${reading#*$'\t'}"
temp_c="$(format_c "$temp_mC")" || {
  echo "mesh-cpu-ccd-hotspot: UNREACHABLE — malformed Tccd1 value" >&2
  exit 2
}
ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

case "${1:-}" in
  --json)
    printf '{"sensor":"Tccd1","temp_mC":%s,"temp_c":%s,"source":"%s","ts":"%s"}\n' \
      "$temp_mC" "$temp_c" "$source" "$ts"
    ;;
  '')
    printf '[cpu-ccd-hotspot] Tccd1=%sC source=%s @ %s\n' "$temp_c" "$source" "$ts"
    ;;
  *)
    echo 'usage: mesh-cpu-ccd-hotspot [--json|--test]' >&2
    exit 1
    ;;
esac
