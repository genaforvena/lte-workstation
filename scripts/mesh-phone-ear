#!/usr/bin/env bash
# mesh-phone-ear — screen-unlock-gated phone mic → IdeaPad whisper → board feed
#   Runs on the phone (Termux). Start via Termux:Boot (phone-setup adds it).
#   Screen locked = sleep; unlocked = record + transcribe + feed board.
#   mesh-phone-ear --test    smoke test (keyguard + mic + ssh reach)
#   mesh-phone-ear --once    one capture cycle regardless of lock state
set -uo pipefail
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "${MESH_NODES_FILE:-$HOME/.mesh/nodes}" ] && . "${MESH_NODES_FILE:-$HOME/.mesh/nodes}"

MESH="$HOME/.mesh"
mkdir -p "$MESH"

HOST="${HOSTNAME:-$(hostname 2>/dev/null || true)}"
IDEAPAD_IP="${MESH_IDEAPAD_IP:-}"
# resolve IdeaPad IP from MESH_NODES registry if not set by env
if [ -z "$IDEAPAD_IP" ]; then
  for _e in ${MESH_NODES:-}; do
    case "${_e%%:*}" in ideapad|imozerov-ideapad*|imozerov_ideapad*) _addr="${_e#*:}"; IDEAPAD_IP="${_addr##*@}"; break;; esac
  done
fi
if [ -z "$IDEAPAD_IP" ]; then
  [ "${1:-}" = "--test" ] && { echo "smoke-test: SKIP (not a phone/phone-ear node — IDEAPAD_IP unset)"; exit 2; }
  echo "mesh-phone-ear: IDEAPAD_IP not set — add to ~/.mesh/nodes or set MESH_IDEAPAD_IP" >&2; exit 1
fi
IDEAPAD_USER="${MESH_IDEAPAD_USER:-imozerov}"
CHUNK="${PHONE_EAR_CHUNK:-8}"
LOG="$MESH/transcript.log"
WHISP_REMOTE="$HOME/.mesh/whispercpp/main"
WHISP_MODEL_REMOTE="$HOME/.mesh/whispercpp/models/ggml-base.bin"
SSH_OPTS="-o BatchMode=yes -o StrictHostKeyChecking=accept-new -o ConnectTimeout=8"

# Check whether the screen is unlocked (is_secured=false → unlocked, ready to record)
screen_unlocked() {
  local js; js="$(termux-display-keyguard 2>/dev/null)" || { return 0; }  # API unavailable → assume unlocked
  [ -n "$js" ] || return 0  # empty output → assume unlocked
  printf '%s' "$js" | python3 -c '
import sys, json
try:
    d=json.load(sys.stdin)
    sys.exit(0 if not d.get("is_secured", True) else 1)
except Exception:
    sys.exit(0)  # parse error → assume unlocked
' 2>/dev/null || return 0
}

# Record CHUNK seconds; prefer wav direct, fall back via ffmpeg from m4a
record_wav() { # $1 = output wav path
  local m4a; m4a="${1%.wav}.m4a"
  # termux-microphone-record: -l duration(s), -e encoder, -b bitrate, -r samplerate, -f outfile
  termux-microphone-record -l "$CHUNK" -e aac -b 128 -r 44100 -f "$m4a" 2>/dev/null || return 1
  if command -v ffmpeg >/dev/null 2>&1; then
    ffmpeg -i "$m4a" -ar 16000 -ac 1 "$1" -y -loglevel quiet 2>/dev/null && rm -f "$m4a" || {
      # ffmpeg failed — try sending m4a as-is (whisper.cpp handles it)
      mv "$m4a" "$1" 2>/dev/null || return 1
    }
  else
    mv "$m4a" "$1" 2>/dev/null || return 1
  fi
}

# Filter whisper hallucinations; emits clean text or empty string
filter_text() {
  python3 -c '
import sys, re
t = sys.stdin.read()
t = re.sub(r"\[[^\]]*\]", "", t)   # remove [BLANK_AUDIO] etc
t = re.sub(r"\([^)]*\)", "", t)    # remove (music) etc
t = " ".join(t.split()).strip()
bad_phrases = ("thanks for watching", "subscribe", "субтитры", "www.", ".com",
               ".co.uk", ".org", "amara.org", "редактор субтитров")
bad = not re.search(r"[А-Яа-яA-Za-z]{3,}", t) or any(p in t.lower() for p in bad_phrases)
words = t.split()
if words and len(set(w.lower() for w in words)) == 1 and len(words) >= 2:
    bad = True
print("" if bad else t)
'
}

# Send wav to IdeaPad → pipe through whispercpp → return transcribed text
transcribe_remote() { # $1 = wav path → stdout text
  # shellcheck disable=SC2086
  cat "$1" | ssh $SSH_OPTS -p 22 "${IDEAPAD_USER}@${IDEAPAD_IP}" \
    "${WHISP_REMOTE} -m ${WHISP_MODEL_REMOTE} -f - -nt -l auto -t 4 2>/dev/null" \
    2>/dev/null \
    | tr '\n' ' ' | filter_text
}

# Append a line to the phone-local transcript log
log_line() { # $1 = text
  printf '%s  %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1" >> "$LOG"
}

# Feed non-empty text to the mesh board over SSH
board_feed() { # $1 = text
  local txt="$1"
  # escape single quotes in the message before embedding in the remote shell command
  local esc; esc="$(printf '%s' "$txt" | sed "s/'/'\\\\''/g")"
  # shellcheck disable=SC2086
  ssh $SSH_OPTS -p 22 "${IDEAPAD_USER}@${IDEAPAD_IP}" \
    "MESH_WHO='phone-ear@${HOST}' \$HOME/.local/bin/mesh-chat '[ear] ${esc}'" \
    </dev/null 2>/dev/null || true
}

# ── --test: smoke test all dependencies ──────────────────────────────────────
if [ "${1:-}" = "--test" ]; then
  # This tool runs ON the phone (Termux). Termux commands won't exist on a laptop node.
  if ! command -v termux-display-keyguard >/dev/null 2>&1 && ! command -v termux-microphone-record >/dev/null 2>&1; then
    echo "smoke-test: SKIP (not on phone/Termux node — deploy via phone-setup on the phone body)"; exit 2
  fi
  ok=1
  command -v termux-display-keyguard >/dev/null 2>&1 || { echo "smoke-test: FAIL (no termux-display-keyguard)"; ok=0; }
  command -v termux-microphone-record >/dev/null 2>&1 || { echo "smoke-test: FAIL (no termux-microphone-record)"; ok=0; }
  command -v ssh >/dev/null 2>&1 || { echo "smoke-test: FAIL (no ssh)"; ok=0; }
  command -v python3 >/dev/null 2>&1 || { echo "smoke-test: FAIL (no python3)"; ok=0; }
  # keyguard check (just run it, any exit is ok — proves the binary works)
  termux-display-keyguard >/dev/null 2>&1 || { echo "smoke-test: WARN (termux-display-keyguard returned non-zero — Termux:API installed?)"; }
  # IdeaPad SSH reachability
  # shellcheck disable=SC2086
  if timeout 12 ssh $SSH_OPTS -p 22 "${IDEAPAD_USER}@${IDEAPAD_IP}" "true" </dev/null 2>/dev/null; then
    echo "smoke-test: IdeaPad SSH ok (${IDEAPAD_USER}@${IDEAPAD_IP})"
  else
    echo "smoke-test: FAIL (IdeaPad ${IDEAPAD_USER}@${IDEAPAD_IP} unreachable)"; ok=0
  fi
  # whispercpp present on IdeaPad
  # shellcheck disable=SC2086
  if timeout 12 ssh $SSH_OPTS -p 22 "${IDEAPAD_USER}@${IDEAPAD_IP}" \
       "[ -x '${WHISP_REMOTE}' ] && [ -f '${WHISP_MODEL_REMOTE}' ]" </dev/null 2>/dev/null; then
    echo "smoke-test: whispercpp ok on IdeaPad"
  else
    echo "smoke-test: WARN (whispercpp or model missing on IdeaPad — transcription will fail)"
  fi
  [ "$ok" = 1 ] && echo "smoke-test: ok" || exit 1
  exit 0
fi

# ── one capture cycle (main logic, reused by --once and the loop) ─────────────
do_cycle() {
  local tmp; tmp="$(mktemp -p "${TMPDIR:-$HOME/tmp}" "phone-ear-XXXXXX.wav" 2>/dev/null \
                    || mktemp "/tmp/phone-ear-XXXXXX.wav")"
  trap 'rm -f "$tmp" "${tmp%.wav}.m4a"' RETURN

  if ! record_wav "$tmp"; then
    echo "[phone-ear] record failed" >&2; return
  fi
  [ -s "$tmp" ] || { echo "[phone-ear] empty recording" >&2; return; }

  local text; text="$(transcribe_remote "$tmp")"
  [ -n "$text" ] || return  # silence / hallucination — nothing to do

  log_line "$text"
  printf '[phone-ear] %s  %s\n' "$(date -u +%H:%M:%SZ)" "$text"
  board_feed "$text"
}

# ── --once: one cycle regardless of lock state ────────────────────────────────
if [ "${1:-}" = "--once" ]; then
  do_cycle
  exit 0
fi

# ── main loop ─────────────────────────────────────────────────────────────────
echo "[mesh-phone-ear] starting — screen-unlock-gated; chunk=${CHUNK}s; ideapad=${IDEAPAD_IP}"
touch "$LOG"
while true; do
  if screen_unlocked; then
    do_cycle
  else
    sleep 2
  fi
done
