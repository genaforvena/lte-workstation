#!/usr/bin/env bash
# orphan-ok: on-demand LIVE-ONLY jack-presence probe (mind/fusion-invoked; reads an INSTANTANEOUS
#   state, no per-run cache to schedule — same class as mesh-audio-active / keypresence / body-context).
# mesh-jack — which audio peripherals are PHYSICALLY plugged into THIS node's analog jacks right now?
#
# WHY this is a NEW, distinct real-world sense (not in the existing perception set):
#   - mesh-audio        = static CAPABILITY inventory (how many cards / capture / playback devices).
#   - mesh-audio-active = live OUTPUT state (is a playback stream RUNNING this instant).
#   Neither knows whether a HUMAN physically plugged a headphone or an external mic into the analog
#   jack. That plug/unplug is a real-world physical event the mesh could perceive but does not:
#       headphone in  -> private / focused listening (operator chose ears over speakers)
#       ext-mic   in  -> recording / call input set up
#   A genuine attention/mode cue no current sense reports. It claims a PERIPHERAL state, never a
#   person (a headset can sit plugged into an empty desk) — an activity/mode cue, not a presence claim.
#
# SOURCE: ALSA jack-detect kcontrols — `amixer -cN cget iface=CARD,name='<X> Jack'` -> values=on|off.
#   BOOLEAN, access=r (world-readable): no root, no `audio` group, no SSH — headless-safe /proc-class
#   read. PHANTOM jacks (Internal Mic / Speaker Phantom) are the ALWAYS-ON built-ins -> EXCLUDED (not
#   a peripheral the operator plugs); HDMI/DP jacks are display-audio -> reported as a separate note.
#   Controls are addressed by NAME+iface (stable across reboots; numid drifts).
#
# HONEST degradation (the no-faked-reading rule):
#   - no amixer, OR the sound card is unreadable, OR NO analog jack-detect controls at all (a headless
#     VM with no codec) -> EXIT 2 "UNREACHABLE" — NOT a fake OPEN. Absence-of-hardware must read
#     visibly different from a real "nothing plugged in". An unreachable jack sense is honestly n/a,
#     never a silent all-clear.
#   - controls present, all analog jacks off -> OPEN (honest: built-in audio only, nothing plugged).
#
# Verdicts (exit 0 = real read): HEADSET | HEADPHONES | EXT-MIC | OPEN ;  exit 2 = UNREACHABLE.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"

CARD="${MESH_JACK_CARD:-0}"

# read one CARD-iface BOOLEAN jack control by NAME -> on|off|"" (empty = control absent / unreadable)
jack_val(){ amixer -c"$CARD" cget iface=CARD,name="$1" 2>/dev/null \
            | sed -n 's/^[[:space:]]*: values=\(on\|off\).*/\1/p' | head -1; }

# pure classifier (no I/O) — token-driven so --test can drive the full truth table offline
classify(){ # $1=headphone(on|off) $2=mic(on|off)
  case "$1/$2" in
    on/on)   echo "HEADSET|headphone + external mic both plugged (headset / call rig)" ;;
    on/off)  echo "HEADPHONES|headphone plugged — private / focused listening (speakers bypassed)" ;;
    off/on)  echo "EXT-MIC|external mic plugged — recording / call input" ;;
    *)       echo "OPEN|no external audio peripheral plugged — built-in speaker/mic only" ;;
  esac
}

if [ "${1:-}" = --test ]; then
  command -v amixer >/dev/null 2>&1 || { echo "smoke-test: FAIL (no amixer)"; exit 1; }
  # 1) pure classifier truth-table (offline, no hardware) — all four plug combinations
  declare -A want=(
    ["on/on"]=HEADSET ["on/off"]=HEADPHONES ["off/on"]=EXT-MIC ["off/off"]=OPEN )
  for k in "${!want[@]}"; do
    got=$(classify "${k%/*}" "${k#*/}"); got="${got%%|*}"
    [ "$got" = "${want[$k]}" ] || { echo "smoke-test: FAIL (classify $k -> $got, want ${want[$k]})"; exit 1; }
  done
  # garbage tokens must fall through to OPEN (never crash / never assert a peripheral)
  g=$(classify "" "")        ; [ "${g%%|*}" = OPEN ] || { echo "smoke-test: FAIL (empty tokens -> ${g%%|*}, want OPEN)"; exit 1; }
  # 2) REAL hardware-read gate (doctrine: --test must assert a live read produces data, not just the
  #    offline classifier). If this node has analog jack-detect controls, a live read MUST be on|off.
  #    If it has NONE (headless / no codec) the sense is honestly UNREACHABLE -> exit 2 (mesh-land
  #    treats exit 2 as a pass), never a fake green.
  analog=$(amixer -c"$CARD" controls 2>/dev/null \
           | sed -n "s/.*name='\([^']*Jack\)'.*/\1/p" | grep -viE 'Phantom|HDMI|DP,pcm' || true)
  if [ -z "$analog" ]; then
    echo "smoke-test: n/a (no analog jack-detect controls on card $CARD — UNREACHABLE, honest)"; exit 2
  fi
  hp=$(jack_val 'Headphone Jack'); mc=$(jack_val 'Mic Jack')
  case "${hp}${mc}" in
    *on*|*off*) : ;;  # at least one real on|off read landed
    *) echo "smoke-test: FAIL (analog jacks exist but live read yielded no on|off: hp='$hp' mic='$mc')"; exit 1 ;;
  esac
  echo "smoke-test: ok (4 classify truth-table + empty-token + live hardware read hp='$hp' mic='$mc')"
  exit 0
fi

host="$(hostname)"; ts="$(date -u +%FT%TZ)"

# --- UNREACHABLE gates: absence-of-hardware reads differently from a real OPEN ---
command -v amixer >/dev/null 2>&1 || { echo "[jack] UNREACHABLE — no amixer (ALSA utils absent) @ $host $ts"; exit 2; }
amixer -c"$CARD" controls >/dev/null 2>&1 || { echo "[jack] UNREACHABLE — sound card $CARD not readable @ $host $ts"; exit 2; }
analog=$(amixer -c"$CARD" controls 2>/dev/null \
         | sed -n "s/.*name='\([^']*Jack\)'.*/\1/p" | grep -viE 'Phantom|HDMI|DP,pcm' || true)
[ -n "$analog" ] || { echo "[jack] UNREACHABLE — no analog jack-detect controls on card $CARD @ $host $ts"; exit 2; }

hp=$(jack_val 'Headphone Jack'); mc=$(jack_val 'Mic Jack')
# default a missing analog control to off (the control set exists; a specific one may be absent)
[ -n "$hp" ] || hp=off
[ -n "$mc" ] || mc=off

out="$(classify "$hp" "$mc")"; verdict="${out%%|*}"; reason="${out#*|}"

# HDMI/DP display-audio: informational only (external monitor/TV connected) — never part of verdict
hdmi_on=$(amixer -c"$CARD" controls 2>/dev/null \
          | sed -n "s/.*numid=\([0-9]*\),iface=CARD,name='\(HDMI\|DP\)[^']*Jack'.*/\1/p" \
          | while read -r id; do amixer -c"$CARD" cget numid="$id" 2>/dev/null \
              | grep -q ': values=on' && echo x; done | wc -l)
hnote=""; [ "${hdmi_on:-0}" -gt 0 ] && hnote=" · hdmi-audio:${hdmi_on} display(s) connected"

echo "[jack] $verdict — $reason [headphone=$hp ext-mic=$mc card=$CARD$hnote] @ $host $ts"
exit 0
