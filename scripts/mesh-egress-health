#!/usr/bin/env bash
# mesh-egress-health — detect EGRESS QUALITY, not just "internet up" (blind spot from the 2026-06-09
# outage). Checks: api.anthropic.com==403 => definitively BAD (geo-block); else if egress country
# unverifiable (ifconfig.co down) => SKIP (NOT broken); else country_iso==expected => OK, mismatch => BAD.
# smoke-test: --test checks curl available + state dir writable
# Read-only; alerts operator's PERSONAL telegram only. Edge-triggered per episode; a CHRONIC latch
# (3+ alerted episodes/24h) tiers a flapping condition down to log/trace + one daily summary.
# reflex-cadence: */3 * * * *
# (orphaned in the 2026-06-21 cron-retirement reorg → unwired 3h, monitoring of the operator's CRITICAL
# NL-VPN egress went silently dead AND reflex-health stopped watching it — it only watches scheduled
# reflexes. A reflex-cadence header lets mesh-autowire re-pick it after any reorg. See reflex-cadence-or-reorg-orphans-it.)
set -uo pipefail
[ "${1:-}" = --test ] && {
  command -v curl >/dev/null 2>&1 || { echo "smoke-test: FAIL (no curl)"; exit 1; }
  command -v python3 >/dev/null 2>&1 || { echo "smoke-test: FAIL (no python3)"; exit 1; }
  [ -d "$HOME/.mesh" ] || { echo "smoke-test: FAIL (no ~/.mesh)"; exit 1; }
  # dry-run: feed mock ifconfig.co JSON through the parser pipeline, validate iso+ip extraction
  mock='{"ip":"1.2.3.4","country_iso":"NL","country":"Netherlands"}'
  iso=$(printf '%s' "$mock" | python3 -c 'import sys,json;print(json.load(sys.stdin).get("country_iso",""))' 2>/dev/null)
  [ "$iso" = "NL" ] || { echo "smoke-test: FAIL (json parser: expected NL, got $iso)"; exit 1; }
  ip=$(printf '%s' "$mock" | python3 -c 'import sys,json;print(json.load(sys.stdin).get("ip",""))' 2>/dev/null)
  [ "$ip" = "1.2.3.4" ] || { echo "smoke-test: FAIL (json parser: expected 1.2.3.4, got $ip)"; exit 1; }
  # PATH QUALITY parser + classifier (wire-egress-path-quality 2026-07-04) — dry-run against a mock
  # `ping -c5 -q` transcript, no live ping. Loads the functions defined below via a subshell source
  # (bash requires the function bodies to exist before calling — they're defined after this --test
  # block returns, so source just the function definitions from this file).
  . <(sed -n '/^parse_ping_quality(){/,/^}/p;/^quality_classify(){/,/^}/p;/^qlocalize(){/,/^}/p;/^scaled_jitter_max(){/,/^}/p;/^jitter_baseline_ok(){/,/^}/p;/^jitter_baseline_feed(){/,/^}/p;/^hist_pctile(){/,/^}/p;/^rtt_baseline_ok(){/,/^}/p;/^scaled_rtt_max(){/,/^}/p;/^rtt_baseline_feed(){/,/^}/p;/^qskip_reason(){/,/^}/p;/^quality_baserate(){/,/^}/p;/^quality_debounce(){/,/^}/p;/^resolve_anth(){/,/^}/p;/^egress_qfunc(){/,/^}/p;/^write_egress_state(){/,/^}/p;/^qpage_gate(){/,/^}/p;/^chronic_latch(){/,/^}/p;/^chronic_summary_due(){/,/^}/p;/^identity_debounce(){/,/^}/p;/^pair_gate(){/,/^}/p' "$0")
  _mock_clean='PING 1.1.1.1 (1.1.1.1) 56(84) bytes of data.

--- 1.1.1.1 ping statistics ---
5 packets transmitted, 5 received, 0% packet loss, time 4005ms
rtt min/avg/max/mdev = 55.123/57.456/60.789/1.234 ms'
  read -r ql qa qm < <(printf '%s' "$_mock_clean" | parse_ping_quality)
  [ "$ql" = "0" ] && [ "$qa" = "57.456" ] && [ "$qm" = "1.234" ] || { echo "smoke-test: FAIL (ping quality parser clean: got loss=$ql avg=$qa mdev=$qm)"; exit 1; }
  _mock_lossy='PING 1.1.1.1 (1.1.1.1) 56(84) bytes of data.

--- 1.1.1.1 ping statistics ---
5 packets transmitted, 3 received, 40% packet loss, time 4005ms
rtt min/avg/max/mdev = 55.123/180.456/300.789/60.234 ms'
  read -r ql2 qa2 qm2 < <(printf '%s' "$_mock_lossy" | parse_ping_quality)
  [ "$ql2" = "40" ] && [ "$qa2" = "180.456" ] && [ "$qm2" = "60.234" ] || { echo "smoke-test: FAIL (ping quality parser lossy: got loss=$ql2 avg=$qa2 mdev=$qm2)"; exit 1; }
  qf=0
  [ "$(quality_classify 0 57.456 1.234 200 10)" = OK ]   || { echo "  FAIL: clean baseline should classify OK"; qf=1; }
  [ "$(quality_classify 40 180.456 60.234 200 10)" = BAD ] || { echo "  FAIL: any packet loss>0 should classify BAD"; qf=1; }
  [ "$(quality_classify 0 250 2 200 10)" = BAD ]         || { echo "  FAIL: RTT blowout past rmax should classify BAD"; qf=1; }
  [ "$(quality_classify 0 50 15 200 10)" = BAD ]         || { echo "  FAIL: jitter blowout past jmax should classify BAD"; qf=1; }
  [ "$(quality_classify '' '' '' 200 10)" = SKIP ]       || { echo "  FAIL: unparsed/unreachable ping should classify SKIP, not BAD (don't alert on a parse miss)"; qf=1; }
  [ "$qf" = 0 ] || { echo "smoke-test: FAIL (quality_classify decision drifted)"; exit 1; }
  # HOP-1 LOCALIZATION (task:egress-quality-label-names-an-unisolated-leg). The whole point is that two
  # reads with the SAME far verdict must classify DIFFERENTLY on where the fault is — so the fixtures
  # are two real `ping -c5 -q` gateway transcripts driven through the REAL parser (an injected loss=50
  # would prove the classifier and skip the parse path that feeds it in production).
  _gw_lossy='PING 192.168.8.1 (192.168.8.1) 56(84) bytes of data.

--- 192.168.8.1 ping statistics ---
5 packets transmitted, 2 received, 60% packet loss, time 4013ms
rtt min/avg/max/mdev = 1.884/3.201/4.518/1.317 ms'
  _gw_clean='PING 192.168.8.1 (192.168.8.1) 56(84) bytes of data.

--- 192.168.8.1 ping statistics ---
5 packets transmitted, 5 received, 0% packet loss, time 4034ms
rtt min/avg/max/mdev = 0.693/0.953/1.921/0.483 ms'
  lf=0
  read -r gl ga gm < <(printf '%s' "$_gw_lossy" | parse_ping_quality)
  _where_lossy=$(qlocalize BAD "$gl" "$ga" "$gm" 50 20)
  read -r gl ga gm < <(printf '%s' "$_gw_clean" | parse_ping_quality)
  _where_clean=$(qlocalize BAD "$gl" "$ga" "$gm" 50 20)
  # the load-bearing assertion: same far BAD, different hop1 => different attribution
  [ "$_where_lossy" != "$_where_clean" ] || { echo "  FAIL: a hop1-lossy and a hop1-clean fixture under the SAME far BAD must not classify alike (both '$_where_lossy') — the far number is unisolated again"; lf=1; }
  [ "$_where_lossy" = hop1-bad ]    || { echo "  FAIL: hop1 60% loss must read hop1-bad (the far BAD cannot be attributed past a broken first hop), got '$_where_lossy'"; lf=1; }
  [ "$_where_clean" = beyond-hop1 ] || { echo "  FAIL: hop1 clean + far BAD must read beyond-hop1, got '$_where_clean'"; lf=1; }
  [ "$(qlocalize BAD 0 120 2 50 20)" = hop1-bad ] || { echo "  FAIL: a hop1 RTT blowout (120ms on a LAN hop) must read hop1-bad, not beyond-hop1"; lf=1; }
  [ "$(qlocalize BAD '' '' '' 50 20)" = hop1-unknown ] || { echo "  FAIL: an unprobeable/absent gateway must read hop1-unknown, never a faked clean hop1"; lf=1; }
  [ "$(qlocalize OK 60 3.2 1.3 50 20)" = "n/a" ]   || { echo "  FAIL: an OK far read has nothing to localize — must be n/a"; lf=1; }
  [ "$(qlocalize SKIP 60 3.2 1.3 50 20)" = "n/a" ] || { echo "  FAIL: a SKIP far read has nothing to localize — must be n/a"; lf=1; }
  [ "$lf" = 0 ] || { echo "smoke-test: FAIL (hop1 localization drifted)"; exit 1; }
  # ENANTIOSTASIS function-preservation gate (functional-invariance land 2026-07-28): the operator PAGE
  # is downgraded ONLY when the Anthropic round-trip proves the function survived a degraded path.
  ef=0
  [ "$(egress_qfunc 405)" = PRESERVED ] || { echo "  FAIL: anth 405 (usable round-trip) should read function PRESERVED"; ef=1; }
  [ "$(egress_qfunc 200)" = PRESERVED ] || { echo "  FAIL: anth 200 should read function PRESERVED"; ef=1; }
  [ "$(egress_qfunc 000)" = IMPAIRED ]  || { echo "  FAIL: anth 000 (no round-trip) should read function IMPAIRED"; ef=1; }
  [ "$(egress_qfunc 403)" = IMPAIRED ]  || { echo "  FAIL: anth 403 (geo-block) should read function IMPAIRED"; ef=1; }
  [ "$(egress_qfunc '')" = UNKNOWN ]    || { echo "  FAIL: unmeasured anth should read function UNKNOWN (conservative)"; ef=1; }
  # the load-bearing downgrade: a quality-BAD that would PAGE is muted iff the function is PRESERVED
  # CAUSE SIDECAR (chat-review/stress-egress-bad-mislabeled-geoblock): the BAD bit must carry WHY, so
  # a consumer (mesh-stress) can tell a 403 outage from a working-but-wrong-country egress. Drive the
  # REAL writer against a scratch HOME — not a re-implementation of it.
  _cd=$(mktemp -d); ( HOME="$_cd"; mkdir -p "$_cd/.mesh"
    STATE="$HOME/.mesh/.egress-state"; CAUSE="$HOME/.mesh/.egress-cause"
    write_egress_state BAD ISO-MISMATCH 405
    [ "$(cat "$STATE")" = BAD ] || { echo "  FAIL: the OK/BAD bit's own contract must be unchanged"; exit 1; }
    [ "$(cat "$CAUSE")" = "ISO-MISMATCH qfunc=PRESERVED anth=405" ] || { echo "  FAIL: wrong-country + live round-trip must record ISO-MISMATCH/PRESERVED, got '$(cat "$CAUSE")'"; exit 1; }
    write_egress_state BAD GEOBLOCK 403
    [ "$(cat "$CAUSE")" = "GEOBLOCK qfunc=IMPAIRED anth=403" ] || { echo "  FAIL: a 403 must record GEOBLOCK/IMPAIRED, got '$(cat "$CAUSE")'"; exit 1; }
    write_egress_state BAD ISO-MISMATCH ''
    [ "$(cat "$CAUSE")" = "ISO-MISMATCH qfunc=UNKNOWN anth=?" ] || { echo "  FAIL: an unmeasured round-trip must record UNKNOWN (conservative), got '$(cat "$CAUSE")'"; exit 1; }
    write_egress_state OK OK 405
    [ "$(cat "$STATE")" = OK ] && [ "$(cat "$CAUSE")" = "OK qfunc=PRESERVED anth=405" ] || { echo "  FAIL: a healthy egress must clear BOTH files, never leave a stale cause"; exit 1; }
  ) || ef=1
  rm -rf "$_cd"
  # ...and the LIVE PATH, because the block above only proves the HELPER is correct — it cannot see
  # whether the three identity branches actually CALL it (a mutant that reverts the OK branch to a bare
  # `echo OK > $STATE` left that gate green: a fixture-driven gate cannot cover the live path). So drive
  # THIS script end-to-end under a scratch HOME with curl/ping/board stubbed FIRST on PATH — the real
  # branch code decides, and both files must agree.
  _ld=$(mktemp -d); _lb="$_ld/.local/bin"; mkdir -p "$_lb" "$_ld/.mesh"
  cat > "$_lb/curl" <<'STUB'
#!/usr/bin/env bash
for a in "$@"; do case "$a" in
  *ifconfig.co*) printf '{"ip":"9.9.9.9","country_iso":"%s"}' "${STUB_ISO:-NL}"; exit 0 ;;
  *api.anthropic.com*) [ "${STUB_ANTH:-405}" = NONE ] && exit 0; printf '%s' "${STUB_ANTH:-405}"; exit 0 ;;
esac; done
STUB
  cat > "$_lb/ping" <<'STUB'
#!/usr/bin/env bash
printf '5 packets transmitted, 5 received, 0%% packet loss, time 4005ms\nrtt min/avg/max/mdev = 55.1/57.4/60.7/1.2 ms\n'
STUB
  for _s in mesh-chat mesh-tg mesh-trace; do printf '#!/bin/sh\nexit 0\n' > "$_lb/$_s"; done   # never touch the real board from a test
  chmod +x "$_lb"/*
  _live(){ # $1=expected state $2=expected cause line ; env: STUB_ISO/STUB_ANTH
    HOME="$_ld" PATH="$_lb:$PATH" MESH_EGRESS_ISO=US MESH_EGRESS_RETRY_SLEEP=0 STUB_ISO="$3" STUB_ANTH="$4" \
      bash "$0" >/dev/null 2>&1
    [ "$(cat "$_ld/.mesh/.egress-state" 2>/dev/null)" = "$1" ] || { echo "  FAIL: live path (iso=$3 anth=$4) should pin state=$1, got '$(cat "$_ld/.mesh/.egress-state" 2>/dev/null)'"; return 1; }
    [ "$(cat "$_ld/.mesh/.egress-cause" 2>/dev/null)" = "$2" ] || { echo "  FAIL: live path (iso=$3 anth=$4) should record cause '$2', got '$(cat "$_ld/.mesh/.egress-cause" 2>/dev/null)'"; return 1; }
  }
  # THE DRIFT/OUTAGE SPLIT (2026-08-22, task egress-iso-pin-tracks-the-route-and-nothing-derives-it).
  # MESH_EGRESS_ISO is a HAND-MAINTAINED constant that must equal a property of whatever path currently
  # carries egress, and it has been reversed TWICE (US->NL 08-15 when the router VPN was the path,
  # NL->US 08-22 when phaedra's tailscale exit node is) — each reversal preceded by a multi-day window
  # of false BAD indistinguishable from a real geo-block (675 consecutive over ~46h, anthropic=405 on
  # 1022 of them). The bit is BINARY and read by ~10 cause-BLIND consumers (mesh-digest renders any BAD
  # as "EGRESS GEO-BLOCKED NOW", mesh-algedonic pain 0.7, mesh-mesh-state DEGRADED), so the sidecar
  # that already NAMED the benign case could not stop them — only mesh-stress ever read it. So the BIT
  # itself now means "the Anthropic round-trip is DOWN", never "the country moved": a mismatch whose
  # round-trip is PRESERVED is a DRIFT notice (state OK, cause ISO-DRIFT), and every cause-blind reader
  # is correct by construction. A mismatch whose function is IMPAIRED/UNKNOWN stays BAD.
  rm -f "$_ld/.mesh/egress-health.log"                                # fresh artifact for the drift read
  _live OK  "ISO-DRIFT qfunc=PRESERVED anth=405"    NL 405 || ef=1   # wrong country, round-trip ALIVE -> DRIFT, not BAD
  # ...and the LOG must not spell it "BAD" either: mesh-digest greps this tail for the operator line,
  # and 675 lines reading `BAD egress=US (want NL)` are exactly what nobody could distinguish from a
  # geo-block. The tape has to say DRIFT, and it has to NAME THE PATH it drifted onto (cure (a) as far
  # as it honestly goes: the tool cannot DERIVE the expected ISO without a second hand-kept ID->ISO map,
  # but it CAN stop making the next reversal a multi-day mystery by logging which path carried the run).
  _dl=$(grep -a 'egress=NL' "$_ld/.mesh/egress-health.log" 2>/dev/null | tail -1)
  case "$_dl" in
    *"DRIFT egress=NL (want US)"*) : ;;
    *) echo "  FAIL: a function-preserved country mismatch must log DRIFT, not BAD, got '$_dl'"; ef=1 ;;
  esac
  case "$_dl" in *' via='*) : ;; *) echo "  FAIL: the drift line must NAME the path that carried the run (via=...), got '$_dl'"; ef=1 ;; esac
  # Wrong country AND no round-trip is an outage, and since 2026-08-28 it is named for the DOMINANT
  # fact: the round-trip is down. The country is a secondary observation that a dead path cannot even
  # establish, so NO-ROUNDTRIP is judged first. The BIT is BAD either way — no consumer changes.
  _live BAD "NO-ROUNDTRIP qfunc=IMPAIRED anth=000"  NL 000  || ef=1
  # ...and ISO-MISMATCH stays reachable where the round-trip was never MEASURED (curl emitted nothing):
  # an unmeasured function is not an impaired one, and it is never a faked all-clear either.
  _live BAD "ISO-MISMATCH qfunc=UNKNOWN anth=?"     NL NONE || ef=1
  _live BAD "GEOBLOCK qfunc=IMPAIRED anth=403"      US 403 || ef=1   # the REAL outage, right country
  _live OK  "OK qfunc=PRESERVED anth=405"           US 405 || ef=1   # recovery must clear BOTH files
  rm -rf "$_ld"
  # ===== TWO WRITERS, TWO PATHS (2026-08-28, task egress-state-slot-has-two-writers-measuring-two-
  # different-paths). The arms above prove the single-path chain. They cannot see the defect that
  # actually fired: the verdict used to be a function of the INVOKING SHELL's proxy env, so the */3
  # cron (no proxy) and a pane-invoked run (restore.env exports) wrote OPPOSITE verdicts into the one
  # shared slot, seconds apart, each paging the operator. So the load-bearing gate is not "is the
  # classifier right" — it is "does the SAME script, run against the SAME world with OPPOSITE ambient
  # env, produce the SAME verdict". The curl stub therefore honours an inherited proxy var exactly as
  # real curl does (env proxy when no --proxy is given), or a mutant that restores inheritance would
  # sail through a stub that only reads argv.
  _pd=$(mktemp -d); _pb="$_pd/.local/bin"; mkdir -p "$_pb" "$_pd/.mesh"
  cat > "$_pb/curl" <<'STUB'
#!/usr/bin/env bash
leg=route
[ -n "${HTTPS_PROXY:-}${ALL_PROXY:-}${https_proxy:-}${all_proxy:-}" ] && leg=proxy   # real curl honours the env proxy
for a in "$@"; do [ "$a" = --proxy ] && leg=proxy; done
# NOTE the bare `-` on the ISO defaults: `:-` would substitute the default for an EXPLICITLY EMPTY
# value too, so the "ifconfig.co is dark" fixture could never actually be expressed and the field-shift
# arm below would silently test the healthy path instead (a fixture whose two candidates carry one value
# cannot discriminate). ANTH/IP keep `:-`; only the dark-country case needs to say "set, and empty".
if [ "$leg" = proxy ]; then iso="${STUB_P_ISO-US}"; anth="${STUB_P_ANTH:-405}"; ipa="${STUB_P_IP:-38.49.216.141}"
else                       iso="${STUB_R_ISO-US}"; anth="${STUB_R_ANTH:-405}"; ipa="${STUB_R_IP:-5.227.27.235}"; fi
# FLAP = impaired on the FIRST sample of this leg, healthy on the retry — the transient the streak-of-2
# debounce exists for. A per-leg marker file is the only way a stub can express "second call": without
# it no arm can drive the RETRY through the live path, and deleting the retry outright stays green (it
# did — a fixture-driven gate cannot cover the live path).
# The FLAP counter is consumed ONLY by the anthropic branch. Resolving it up here instead burned the
# marker on the ifconfig.co call that runs first, so the anthropic probe saw the SECOND value, never
# answered 000, and the retry it exists to drive was never reached — the arm failed for a reason that
# had nothing to do with the subject.
for a in "$@"; do case "$a" in
  *ifconfig.co*) [ -z "$iso" ] && exit 0; printf '{"ip":"%s","country_iso":"%s"}' "$ipa" "$iso"; exit 0 ;;
  *api.anthropic.com*)
    if [ "$anth" = FLAP ]; then
      _c="${STUB_FLAP_DIR:-/tmp}/flap.$leg"
      if [ -e "$_c" ]; then anth=405; else : > "$_c"; anth=000; fi
    fi
    [ "$anth" = NONE ] && exit 0; printf '%s' "$anth"; exit 0 ;;
esac; done
STUB
  cat > "$_pb/ping" <<'STUB'
#!/usr/bin/env bash
printf '5 packets transmitted, 5 received, 0%% packet loss, time 4005ms\nrtt min/avg/max/mdev = 55.1/57.4/60.7/1.2 ms\n'
STUB
  for _s in mesh-chat mesh-tg mesh-trace; do printf '#!/bin/sh\nexit 0\n' > "$_pb/$_s"; done
  chmod +x "$_pb"/*
  pf=0
  _dual(){ # $1=expected state $2=expected cause line $3=proxy-url-or-empty ; env: STUB_P_*/STUB_R_*
    rm -f "$_pd/.mesh/egress-health.log" "$_pd/.mesh/.egress-state" "$_pd/.mesh/.egress-cause" "$_pd"/flap.*
    env -u HTTP_PROXY -u HTTPS_PROXY -u ALL_PROXY -u http_proxy -u https_proxy -u all_proxy \
      HOME="$_pd" PATH="$_pb:$PATH" MESH_EGRESS_ISO=US MESH_EGRESS_RETRY_SLEEP=0 MESH_EGRESS_PROXY="$3" \
      STUB_FLAP_DIR="$_pd" \
      STUB_P_ISO="${4:-US}" STUB_P_ANTH="${5:-405}" STUB_R_ISO="${6:-US}" STUB_R_ANTH="${7:-405}" \
      bash "$0" >/dev/null 2>&1
    [ "$(cat "$_pd/.mesh/.egress-state" 2>/dev/null)" = "$1" ] || { echo "  FAIL: dual-leg (proxy=${4:-US}/${5:-405} route=${6:-US}/${7:-405}) should pin state=$1, got '$(cat "$_pd/.mesh/.egress-state" 2>/dev/null)'"; return 1; }
    [ "$(cat "$_pd/.mesh/.egress-cause" 2>/dev/null)" = "$2" ] || { echo "  FAIL: dual-leg (proxy=${4:-US}/${5:-405} route=${6:-US}/${7:-405}) should record cause '$2', got '$(cat "$_pd/.mesh/.egress-cause" 2>/dev/null)'"; return 1; }
  }
  _verdict_row(){ LC_ALL=C grep -a -v ' QUALITY ' "$_pd/.mesh/egress-health.log" 2>/dev/null | tail -1 | sed -E 's/^[^ ]+ //'; }
  # (a) THE PERMANENT POST-DIRECTIVE SHAPE, measured live 12:52Z: the proxy leg the minds ride is
  # US/405, this node's own route is RU/403. Neither is a fault, and the bit must not read the node as
  # geo-blocked while every mind on it is working.
  _dual OK "SPLIT-PATH qfunc=PRESERVED anth=405" http://127.0.0.1:8118 US 405 RU 403 || pf=1
  _row=$(_verdict_row)
  case "$_row" in *'path=proxy'*) : ;; *) echo "  FAIL: every row must NAME the path it took (path=proxy), got '$_row'"; pf=1 ;; esac
  case "$_row" in *'alt=route:RU/403'*) : ;; *) echo "  FAIL: the other leg must be published as its own axis (alt=route:RU/403), got '$_row'"; pf=1 ;; esac
  case "$_row" in *'altfn=IMPAIRED'*) : ;; *) echo "  FAIL: the other leg's function must be published, not inferred, got '$_row'"; pf=1 ;; esac
  # (b) THE 403 LANE IS NOT SILENCED (operator, egress.conf:59). A 403 on the leg the MINDS ride is
  # still the mesh's core outage even when the other leg is perfectly healthy.
  _dual BAD "GEOBLOCK qfunc=IMPAIRED anth=403" http://127.0.0.1:8118 US 403 US 405 || pf=1
  # (c) ENV-INDEPENDENCE — the actual two-writer cure. Same script, same world, OPPOSITE ambient proxy
  # env: the verdict, the cause and the tape row must be byte-identical. This is what makes the shared
  # slot single-valued again; without it the cron and a pane are two writers of two different truths.
  # Both arms pin the ambient env EXPLICITLY — the unproxied one by `env -u`, not by omission. Omitting
  # them made this arm VACUOUS whenever --test was run from a mind's pane (which carries the exports):
  # both runs were then proxied and the comparison compared a run with itself. Caught by a mutant that
  # restored inheritance and went red on a DIFFERENT arm than the one written to catch it.
  _envrun(){ # $1=1 -> run WITH ambient proxy exports set, as a mind's pane carries them
    rm -f "$_pd/.mesh/egress-health.log" "$_pd/.mesh/.egress-state" "$_pd/.mesh/.egress-cause"
    if [ "$1" = 1 ]; then
      HOME="$_pd" PATH="$_pb:$PATH" MESH_EGRESS_ISO=US MESH_EGRESS_RETRY_SLEEP=0 MESH_EGRESS_PROXY=http://127.0.0.1:8118 \
        STUB_P_ISO=US STUB_P_ANTH=405 STUB_R_ISO=RU STUB_R_ANTH=403 \
        HTTPS_PROXY=http://127.0.0.1:8118 HTTP_PROXY=http://127.0.0.1:8118 ALL_PROXY=http://127.0.0.1:8118 \
        https_proxy=http://127.0.0.1:8118 http_proxy=http://127.0.0.1:8118 all_proxy=http://127.0.0.1:8118 \
        bash "$0" >/dev/null 2>&1
    else
      env -u HTTP_PROXY -u HTTPS_PROXY -u ALL_PROXY -u http_proxy -u https_proxy -u all_proxy \
        HOME="$_pd" PATH="$_pb:$PATH" MESH_EGRESS_ISO=US MESH_EGRESS_RETRY_SLEEP=0 MESH_EGRESS_PROXY=http://127.0.0.1:8118 \
        STUB_P_ISO=US STUB_P_ANTH=405 STUB_R_ISO=RU STUB_R_ANTH=403 \
        bash "$0" >/dev/null 2>&1
    fi
    printf '%s|%s|%s' "$(cat "$_pd/.mesh/.egress-state" 2>/dev/null)" "$(cat "$_pd/.mesh/.egress-cause" 2>/dev/null)" "$(_verdict_row)"
  }
  _with=$(_envrun 1); _without=$(_envrun 0)
  [ "$_with" = "$_without" ] || { echo "  FAIL: the verdict is a property of the INVOKING SHELL, not the node — a proxied caller and an unproxied caller disagree, which is the two-writer flap itself:"; echo "    proxied env  -> $_with"; echo "    unproxied env-> $_without"; pf=1; }
  case "$_without" in *SPLIT-PATH*) : ;; *) echo "  FAIL: the env-independence arm must run against a fixture whose two legs DIFFER, or it cannot see inheritance at all; got '$_without'"; pf=1 ;; esac
  # (d) A NODE WITH ONE PATH IS UNCHANGED. No proxy declared -> route-only reading, alt=none, and the
  # route's own verdict decides. (mesh-wide safety: this tool runs on nodes that have no proxy at all.)
  _dual BAD "GEOBLOCK qfunc=IMPAIRED anth=403" '' US 405 RU 403 || pf=1
  _row=$(_verdict_row)
  case "$_row" in *'path=route'*) : ;; *) echo "  FAIL: a proxyless node must read path=route, got '$_row'"; pf=1 ;; esac
  case "$_row" in *'alt=none'*) : ;; *) echo "  FAIL: a proxyless node has no other leg to publish — alt=none, never a fabricated one; got '$_row'"; pf=1 ;; esac
  # (g) A DEAD MINDS-PROXY IS AN OUTAGE, NOT A SILENCE. Found by DRIVING the world live (real network,
  # proxy pointed at a closed port), not by reading the chain: a dead proxy takes ifconfig.co down with
  # it, the run hit the unverifiable-country SKIP arm, and the shared slot stayed FROZEN on its last
  # value — nine consumers reading a stale OK while every mind on the node was dark. The round-trip
  # probe had already answered; it was simply asked after the country instead of before.
  _dual BAD "NO-ROUNDTRIP qfunc=IMPAIRED anth=000" http://127.0.0.1:8118 '' 000 US 405 || pf=1
  _row=$(_verdict_row)
  case "$_row" in *'alt=route:US/405'*) : ;; *) echo "  FAIL: when the minds' leg is dead and the route is ALIVE, the row must publish that — it is what tells an operator this is the proxy and not the network; got '$_row'"; pf=1 ;; esac
  # ...and the same reading must NOT be reachable as a stale OK: the slot has to move.
  [ "$(cat "$_pd/.mesh/.egress-state" 2>/dev/null)" = BAD ] || { echo "  FAIL: a dead minds-proxy must MOVE the shared slot, never leave it frozen on the last good value"; pf=1; }
  # (h) ...and the debounce that keeps (g) from paging on a single dongle flap must be driven through
  # the LIVE path, not just asserted on resolve_anth: deleting the retry from the script entirely left
  # every unit arm green. The minds' leg answers 000 once, then 405 — the run must resolve to OK and
  # say in the tape that it self-healed, never pin BAD and page.
  _dual OK "OK qfunc=PRESERVED anth=405" http://127.0.0.1:8118 US FLAP US 405 || pf=1
  LC_ALL=C grep -aq 'leg=proxy anthropic=000->405 (transient flap, self-healed' "$_pd/.mesh/egress-health.log" \
    || { echo "  FAIL: a leg that flaps impaired->healthy must be debounced by the retry AND say so in the tape (the retry is never exercised by the unit arms)"; pf=1; }
  # (f) AN UNMEASURABLE COUNTRY MUST NOT SHIFT THE FIELDS. probe_leg emits a '-' sentinel per field
  # precisely because a bare `printf '%s %s %s'` with an empty first field slides ip into iso and anth
  # into ip on read — which would silently answer the geo-block question with an IP address. Drive it:
  # ifconfig.co dark on both legs, the round-trip measured and healthy -> SKIP, and the SKIP row must
  # still carry the anth code it actually measured.
  _dual_skip(){
    rm -f "$_pd/.mesh/egress-health.log" "$_pd/.mesh/.egress-state" "$_pd/.mesh/.egress-cause"
    env -u HTTP_PROXY -u HTTPS_PROXY -u ALL_PROXY -u http_proxy -u https_proxy -u all_proxy \
      HOME="$_pd" PATH="$_pb:$PATH" MESH_EGRESS_ISO=US MESH_EGRESS_RETRY_SLEEP=0 MESH_EGRESS_PROXY=http://127.0.0.1:8118 \
      STUB_P_ISO='' STUB_P_ANTH=405 STUB_R_ISO='' STUB_R_ANTH=405 bash "$0" >/dev/null 2>&1
  }
  _dual_skip; _row=$(_verdict_row)
  case "$_row" in SKIP*) : ;; *) echo "  FAIL: an unverifiable country is NOT broken — must log SKIP, got '$_row'"; pf=1 ;; esac
  case "$_row" in *'anthropic=405'*) : ;; *) echo "  FAIL: the SKIP row lost the round-trip code it measured — the empty iso field shifted ip/anth into the wrong variables; got '$_row'"; pf=1 ;; esac
  [ -z "$(cat "$_pd/.mesh/.egress-state" 2>/dev/null)" ] || { echo "  FAIL: a SKIP must leave the shared slot UNTOUCHED (no faked all-clear, no faked outage), got '$(cat "$_pd/.mesh/.egress-state")'"; pf=1; }
  # (e) PROXY DISCOVERY reads the minds' own declaration site and respects the documented rollback.
  printf '%s\n' '# export HTTPS_PROXY="http://127.0.0.1:9999"' > "$_pd/.mesh/restore.env"
  _u=$( HOME="$_pd" MESH_EGRESS_PROXY='' MESH_RESTORE_ENV="$_pd/.mesh/restore.env" bash -c ". <(sed -n '/^egress_proxy_url(){/,/^}/p' '$0'); egress_proxy_url" )
  [ -z "$_u" ] || { echo "  FAIL: a COMMENTED-OUT proxy block is the documented rollback — it must yield no proxy, got '$_u'"; pf=1; }
  printf '%s\n' 'export HTTPS_PROXY="http://127.0.0.1:8118"' > "$_pd/.mesh/restore.env"
  _u=$( HOME="$_pd" MESH_EGRESS_PROXY='' MESH_RESTORE_ENV="$_pd/.mesh/restore.env" bash -c ". <(sed -n '/^egress_proxy_url(){/,/^}/p' '$0'); egress_proxy_url" )
  [ "$_u" = "http://127.0.0.1:8118" ] || { echo "  FAIL: a LIVE proxy block must be read from the minds' own declaration site, got '$_u'"; pf=1; }
  rm -rf "$_pd"
  [ "$pf" = 0 ] || { echo "smoke-test: FAIL (two-writer / two-path egress reading drifted)"; exit 1; }
  # ...and the SAME split for the localization leg: the fixtures above prove qlocalize() is correct, they
  # cannot prove the script CALLS it or that the verdict reaches the tape mesh-dash reads (a fixture-driven
  # gate cannot cover the live path). Drive the real script with a HOST-AWARE ping stub — the gateway and
  # the far host get independent loss — and assert the LOG LINE, freshly per direction so neither read can
  # pass on the other's artifact.
  _wd=$(mktemp -d); _wb="$_wd/.local/bin"; mkdir -p "$_wb" "$_wd/.mesh"
  cat > "$_wb/curl" <<'STUB'
#!/usr/bin/env bash
for a in "$@"; do case "$a" in
  *ifconfig.co*) printf '{"ip":"9.9.9.9","country_iso":"US"}'; exit 0 ;;
  *api.anthropic.com*) printf '405'; exit 0 ;;
esac; done
STUB
  cat > "$_wb/ping" <<'STUB'
#!/usr/bin/env bash
# host-aware: the LAST arg is the destination, so the gateway leg and the far leg can differ
host="${!#}"
if [ "$host" = "${STUB_GW_HOST:-}" ]; then l="${STUB_GW_LOSS:-0}"; a="${STUB_GW_RTT:-0.9}"; d=0.4; else l="${STUB_FAR_LOSS:-0}"; a=57.4; d=1.2; fi
rcv=$(awk -v l="$l" 'BEGIN{printf "%d", 5-int(5*l/100+0.5)}')
printf '5 packets transmitted, %s received, %s%% packet loss, time 4005ms\nrtt min/avg/max/mdev = 0.1/%s/9.9/%s ms\n' "$rcv" "$l" "$a" "$d"
STUB
  for _s in mesh-chat mesh-tg mesh-trace; do printf '#!/bin/sh\nexit 0\n' > "$_wb/$_s"; done
  chmod +x "$_wb"/*
  wf=0
  _wlive(){ # $1=expected where $2=gateway loss% $3=far loss% [$4=gateway avg RTT ms]
    rm -f "$_wd/.mesh/egress-health.log"                    # fresh artifact per direction
    HOME="$_wd" PATH="$_wb:$PATH" MESH_EGRESS_ISO=US MESH_EGRESS_RETRY_SLEEP=0 \
      MESH_EGRESS_GW=10.99.99.1 STUB_GW_HOST=10.99.99.1 STUB_GW_LOSS="$2" STUB_FAR_LOSS="$3" STUB_GW_RTT="${4:-0.9}" \
      bash "$0" >/dev/null 2>&1
    local ln; ln=$(grep -a 'QUALITY BAD' "$_wd/.mesh/egress-health.log" 2>/dev/null | tail -1)
    case "$ln" in *"where=$1"*) return 0 ;; esac
    echo "  FAIL: live path (gw_loss=$2% far_loss=$3% gw_rtt=${4:-0.9}ms) should log where=$1, got '$ln'"; return 1
  }
  _wlive beyond-hop1 0  60 || wf=1   # clean first hop, lossy far -> the fault IS past the gateway
  _wlive hop1-bad    60 60 || wf=1   # first hop lossy too   -> unattributable past hop1 (the 14:22Z read)
  # ...and via RTT rather than loss, which is the only leg that exercises the LAN-scale hop1 DEFAULT
  # (MESH_EGRESS_GW_RTT_MAX_MS=50): under the far probe's 200ms cap a 120ms first hop reads clean.
  _wlive hop1-bad    0  60 120 || wf=1
  rm -rf "$_wd"
  [ "$wf" = 0 ] || { echo "smoke-test: FAIL (hop1 localization never reaches the tape mesh-dash reads)"; exit 1; }
  [ "$(qpage_gate BAD ALERT-BAD PRESERVED)" = FUNC-OK ]  || { echo "  FAIL: quality-BAD + function PRESERVED must downgrade the page (enantiostasis)"; ef=1; }
  [ "$(qpage_gate BAD ALERT-BAD IMPAIRED)" = ALERT-BAD ] || { echo "  FAIL: quality-BAD + function IMPAIRED must still page"; ef=1; }
  [ "$(qpage_gate BAD ALERT-BAD UNKNOWN)" = ALERT-BAD ]  || { echo "  FAIL: quality-BAD + function UNKNOWN must still page (no faked all-clear)"; ef=1; }
  [ "$(qpage_gate BAD NONE PRESERVED)" = NONE ]          || { echo "  FAIL: a sub-streak (non-paging) BAD must be left untouched by the gate"; ef=1; }
  [ "$(qpage_gate OK ALERT-OK PRESERVED)" = ALERT-OK ]   || { echo "  FAIL: the gate must never touch the OK/recovery path"; ef=1; }
  # ===== BOARD EDGES ARE GATED ASYMMETRICALLY (chat-review/egress-board-edges-are-gated-asymmetrically,
  # {#026839bb}, closed 2026-08-31). Two legs, both measured on this node's own tape before writing a line.
  # UNIT ARMS FIRST — pair_gate: a recovery is honest only if its degradation was PAGED.
  _pd2=$(mktemp -d); _pf2="$_pd2/announced"
  [ "$(pair_gate ALERT-OK "$_pf2")" = UNPAIRED-OK ] || { echo "  FAIL: a recovery with no announced degradation must be UNPAIRED-OK, not a page"; ef=1; }
  [ "$(pair_gate FUNC-OK "$_pf2")" = FUNC-OK ]      || { echo "  FAIL: pair_gate must pass a downgraded BAD through untouched"; ef=1; }
  [ -e "$_pf2" ] && { echo "  FAIL: a FUNC-OK downgrade must NOT arm the announced flag — that is the whole defect"; ef=1; }
  [ "$(pair_gate SUPPRESS-BAD "$_pf2")" = SUPPRESS-BAD ] || { echo "  FAIL: pair_gate must pass a chronic-muted BAD through untouched"; ef=1; }
  [ -e "$_pf2" ] && { echo "  FAIL: a chronic-muted BAD must NOT arm the announced flag"; ef=1; }
  [ "$(pair_gate ALERT-BAD "$_pf2")" = ALERT-BAD ]  || { echo "  FAIL: pair_gate must pass a real page through"; ef=1; }
  [ -e "$_pf2" ] || { echo "  FAIL: a real BAD page MUST arm the announced flag, or every later recovery is suppressed"; ef=1; }
  [ "$(pair_gate ALERT-OK "$_pf2")" = ALERT-OK ]    || { echo "  FAIL: a recovery that closes an ANNOUNCED degradation must still page"; ef=1; }
  [ -e "$_pf2" ] && { echo "  FAIL: the announced flag must be CONSUMED by its recovery, or one BAD licenses every future OK"; ef=1; }
  [ "$(pair_gate LATCH "$_pf2")" = LATCH ] && [ -e "$_pf2" ] || { echo "  FAIL: a LATCH pages, so it must arm the flag too"; ef=1; }
  [ "$(pair_gate UNLATCH "$_pf2")" = UNLATCH ] || { echo "  FAIL: pair_gate must pass UNLATCH through"; ef=1; }
  # ...and identity_debounce: BAD needs a streak, OK needs a dwell, SKIP holds, 403 fast-fires.
  _is="$_pd2/ist"; _ib="$_pd2/ibs"; _io="$_pd2/ios"
  _idb(){ identity_debounce "$1" "${2:-no}" "$_is" "$_ib" "$_io"; }
  [ "$(_idb BAD)" = NONE ]      || { echo "  FAIL: a single BAD sample must not page (64% of this node's BAD episodes last exactly one probe)"; ef=1; }
  [ "$(_idb OK)"  = NONE ]      || { echo "  FAIL: a BAD that closes on the next probe must page NOTHING at all — neither edge"; ef=1; }
  [ "$(_idb BAD)" = NONE ]      || { echo "  FAIL: the bad streak must not carry across an intervening OK"; ef=1; }
  [ "$(_idb BAD)" = ALERT-BAD ] || { echo "  FAIL: two consecutive BAD samples must page"; ef=1; }
  [ "$(_idb BAD)" = NONE ]      || { echo "  FAIL: a page is an EDGE — a held BAD must not re-page every 3 minutes"; ef=1; }
  [ "$(_idb SKIP)" = NONE ]     || { echo "  FAIL: a blind probe must not page"; ef=1; }
  [ "$(_idb OK)"  = NONE ]      || { echo "  FAIL: recovery needs a dwell too, or a boundary-grazing signal flaps forever"; ef=1; }
  [ "$(_idb OK)"  = ALERT-OK ]  || { echo "  FAIL: a held recovery must close the pair"; ef=1; }
  [ "$(_idb OK)"  = NONE ]      || { echo "  FAIL: recovery is an EDGE too"; ef=1; }
  rm -f "$_is" "$_ib" "$_io"
  [ "$(_idb BAD yes)" = ALERT-BAD ] || { echo "  FAIL: the 403 lane keeps its FIRST-sample fire (operator, egress.conf:59) — 4 samples of 403 vs 284 no-roundtrip over 08-29..08-30, it is not the flapper"; ef=1; }
  rm -rf "$_pd2"
  # LIVE PATH — the unit arms above prove the helpers; they cannot prove the script CALLS them, and this
  # file has been burned by exactly that twice (see the _live/_dual blocks: "a fixture-driven gate cannot
  # cover the live path"). So drive the REAL script across a SEQUENCE of runs, one process per 3-min
  # cadence, and COUNT the board posts a recording mesh-chat stub captured.
  _bd=$(mktemp -d); _bb="$_bd/.local/bin"; mkdir -p "$_bb" "$_bd/.mesh"
  cat > "$_bb/curl" <<'STUB'
#!/usr/bin/env bash
for a in "$@"; do case "$a" in
  *ifconfig.co*) printf '{"ip":"9.9.9.9","country_iso":"US"}'; exit 0 ;;
  *api.anthropic.com*) [ "${STUB_ANTH:-405}" = NONE ] && exit 0; printf '%s' "${STUB_ANTH:-405}"; exit 0 ;;
esac; done
STUB
  cat > "$_bb/ping" <<'STUB'
#!/usr/bin/env bash
l="${STUB_LOSS:-0}"
rcv=$(awk -v l="$l" 'BEGIN{printf "%d", 5-int(5*l/100+0.5)}')
printf '5 packets transmitted, %s received, %s%% packet loss, time 4005ms\nrtt min/avg/max/mdev = 55.1/57.4/60.7/1.2 ms\n' "$rcv" "$l"
STUB
  # the RECORDING stub — the artifact of this whole task is a COUNT of board lines, so the stub must keep them
  cat > "$_bb/mesh-chat" <<'STUB'
#!/usr/bin/env bash
printf '%s\n' "$1" >> "$HOME/.board"
STUB
  printf '#!/usr/bin/env bash\nprintf "%%s\\n" "$1" >> "$HOME/.tg"\n' > "$_bb/mesh-tg"
  printf '#!/bin/sh\nexit 0\n' > "$_bb/mesh-trace"
  chmod +x "$_bb"/*
  bf2=0
  _brun(){ # $1=anth $2=loss%
    STUB_ANTH="$1" STUB_LOSS="${2:-0}" HOME="$_bd" PATH="$_bb:$PATH" MESH_EGRESS_ISO=US \
      MESH_EGRESS_RETRY_SLEEP=0 bash "$0" >/dev/null 2>&1
  }
  # `"$_bd/.mesh/"*` DOES NOT MATCH DOTFILES, and every state file this tool keeps is a dotfile — a
  # reset written that way leaves the page lane's own state standing, so each arm silently inherits the
  # previous arm's streaks and the sequence, not the code, decides the outcome. Name them explicitly.
  _breset(){ rm -f "$_bd/.board" "$_bd/.tg" "$_bd/.mesh/egress-health.log"; rm -f "$_bd"/.mesh/.egress-*; }
  # -F IS LOAD-BEARING: a board tag is written `[egress-bad]`, which as a BRE is a bracket expression
  # whose embedded `-` reads as the reversed range s-b — grep errors out, and with stderr discarded the
  # counter answers 0 for a board that holds the post. It fails toward "no pages found", i.e. toward a
  # GREEN assertion on every arm that asserts absence. Both `= 1` control arms below exist to catch
  # exactly that: a counter that cannot count makes the absence arms vacuous, and they went green.
  # ...and NO `|| echo 0` fallback: `grep -c` PRINTS 0 and still exits 1 on no match, so the fallback
  # appends a SECOND 0 and every count reads "0\n0" — never equal to 0 or to 1, so every arm fails and
  # the two defects cancel into noise. The only case with no stdout is a missing file; test for it.
  _bcount(){ [ -f "$_bd/.board" ] || { echo 0; return; }; LC_ALL=C grep -acF -- "$1" "$_bd/.board"; }
  # (1) THE FLAP THAT PRODUCED 55 BOARD LINES IN ONE DAY. anth alternates dead/alive every cadence —
  # 35 of this node's 55 BAD episodes over 08-29..08-30 were exactly this shape. Not one page is honest.
  _breset; for _a in 000 405 000 405 000 405; do _brun "$_a"; done
  [ "$(_bcount '[egress-bad]')" = 0 ] || { echo "  FAIL: a one-probe flap must page NOTHING — got $(_bcount '[egress-bad]') [egress-bad] board line(s)"; bf2=1; }
  [ "$(_bcount '[egress-ok]')"  = 0 ] || { echo "  FAIL: ...and no unpaired 'restored' either — got $(_bcount '[egress-ok]')"; bf2=1; }
  # ...but the SHARED BIT must have moved anyway on the very first sample: ~10 cause-blind consumers
  # read it and debouncing THEM would be a faked all-clear, not a quieter board.
  _breset; _brun 000
  [ "$(cat "$_bd/.mesh/.egress-state" 2>/dev/null)" = BAD ] || { echo "  FAIL: the page is debounced, the BIT is NOT — a single dead round-trip must still pin state=BAD for the cause-blind consumers"; bf2=1; }
  [ "$(_bcount '[egress-bad]')" = 0 ] || { echo "  FAIL: ...and that first sample must not page"; bf2=1; }
  # (2) A GENUINELY MULTI-CADENCE OUTAGE STILL BOARDS, exactly once, and its recovery closes the pair
  # exactly once. This is the arm that stops the fix from being a mute.
  _breset; for _a in 000 000 000 405 405; do _brun "$_a"; done
  [ "$(_bcount '[egress-bad]')" = 1 ] || { echo "  FAIL: a real outage must still page, once — got $(_bcount '[egress-bad]')"; bf2=1; }
  [ "$(_bcount '[egress-ok]')"  = 1 ] || { echo "  FAIL: its recovery must close the pair, once — got $(_bcount '[egress-ok]')"; bf2=1; }
  [ "$(LC_ALL=C grep -ac -- '🚨' "$_bd/.tg" 2>/dev/null || echo 0)" = 1 ] || { echo "  FAIL: the operator must be paged once for a real outage, no more and no less"; bf2=1; }
  # (3) THE 403 GEO-BLOCK IS NOT DEBOUNCED (operator, egress.conf:59) — first sample, first page.
  _breset; _brun 403
  [ "$(_bcount '[egress-bad]')" = 1 ] || { echo "  FAIL: a 403 must keep its first-sample fire — the mesh's core alarm is not the flapper (4 samples vs 284 no-roundtrip)"; bf2=1; }
  # ...and it must fire even when the SHARED BIT is already BAD from an unpaged single-sample dip. This
  # is the arm that separates the page lane from $STATE: the old `[ "$prev" != BAD ]` guard reads the
  # shared bit, so a 3-minute no-roundtrip dip that (correctly) moved the bit without paging would have
  # SWALLOWED the geo-block page that followed it — the one alarm the operator protected.
  _breset; _brun 000; _brun 403
  [ "$(_bcount '[egress-bad]')" = 1 ] || { echo "  FAIL: a 403 arriving while the shared bit is already BAD (unpaged dip) must still page — got $(_bcount '[egress-bad]')"; bf2=1; }
  # (4) LEG (a): a quality degradation the FUNCTION GATE downgraded is never announced, so its recovery
  # must not post "path restored". anth=405 throughout => qfunc PRESERVED => the BAD is FUNC-OK.
  _breset; _brun 405 60; _brun 405 60; _brun 405 0; _brun 405 0
  [ "$(_bcount '[egress-quality-bad]')" = 0 ] || { echo "  FAIL: a function-preserved degradation must not page (enantiostasis) — got $(_bcount '[egress-quality-bad]')"; bf2=1; }
  [ "$(_bcount '[egress-quality-ok]')"  = 0 ] || { echo "  FAIL: THE DEFECT — the board carried $(_bcount '[egress-quality-ok]') 'path restored' post(s) for a degradation it was never told about (17 of these on 2026-08-29 alone, against ONE bad post)"; bf2=1; }
  LC_ALL=C grep -aq 'QUALITY OK-UNPAIRED' "$_bd/.mesh/egress-health.log" || { echo "  FAIL: a suppressed recovery must be a WORD on the tape (OK-UNPAIRED), never a silence — it has to stay countable"; bf2=1; }
  # (5) CONTROL: the same recovery, when its degradation DID page, must still page. Without this arm
  # (4) is satisfied by a tool that simply never posts an [egress-quality-ok] again.
  _breset; _brun 000 60; _brun 000 60; _brun 000 0; _brun 000 0
  [ "$(_bcount '[egress-quality-bad]')" = 1 ] || { echo "  FAIL: a degradation whose FUNCTION is impaired must still page — got $(_bcount '[egress-quality-bad]')"; bf2=1; }
  [ "$(_bcount '[egress-quality-ok]')"  = 1 ] || { echo "  FAIL: a recovery that closes an ANNOUNCED degradation must still page — got $(_bcount '[egress-quality-ok]')"; bf2=1; }
  rm -rf "$_bd"
  [ "$bf2" = 0 ] || { echo "smoke-test: FAIL (board edges are gated asymmetrically — unpaired/flapping pages reached the board)"; exit 1; }
  [ "$ef" = 0 ] || { echo "smoke-test: FAIL (enantiostasis function-gate drifted)"; exit 1; }
  # Baseline-relative jitter cap (chat-review/egress-quality-jitter-flap part b): no history -> floor;
  # a distant node's own rolling median scales the cap so its normal jitter isn't judged by IdeaPad's yardstick
  [ "$(scaled_jitter_max 10 6 '' 100)" = "10" ]  || { echo "smoke-test: FAIL (scaled_jitter_max: no history should return floor)"; exit 1; }
  [ "$(scaled_jitter_max 10 6 15 100)" = "90" ]  || { echo "smoke-test: FAIL (scaled_jitter_max: 15ms median*6 should be 90, got $(scaled_jitter_max 10 6 15 100))"; exit 1; }
  [ "$(scaled_jitter_max 10 6 1 100)" = "10" ]   || { echo "smoke-test: FAIL (scaled_jitter_max: tiny median should still floor at 10)"; exit 1; }
  # Ceiling: the cap must NEVER ratchet past it. 41.986 is the live 2026-07-15 median, whose unclamped
  # cap was 251.9ms — the jitter axis judged against a bound no realistic jitter could ever cross.
  [ "$(scaled_jitter_max 10 6 41.986 100)" = "100" ] || { echo "smoke-test: FAIL (scaled_jitter_max: median*6=251.9 must clamp to the 100ms ceiling, got $(scaled_jitter_max 10 6 41.986 100))"; exit 1; }
  # ...but an operator who deliberately raises the floor above the ceiling gets their loose cap, not a clamp
  [ "$(scaled_jitter_max 300 6 15 100)" = "300" ] || { echo "smoke-test: FAIL (scaled_jitter_max: explicit floor above the ceiling must win, got $(scaled_jitter_max 300 6 15 100))"; exit 1; }
  # Baseline admission (chat-review/egress-jitter-baseline-ratchet): the QJHIST gate checked only loss/RTT,
  # so a jitter-BAD read seeded the very median that sets the jitter cap.
  bf=0
  jitter_baseline_ok 0 57.456 1.234 200 100    || { echo "  FAIL: a clean read must seed the baseline"; bf=1; }
  jitter_baseline_ok 40 180.456 60.234 200 100 && { echo "  FAIL: a lossy read must not seed the baseline"; bf=1; }
  jitter_baseline_ok 0 250 2 200 100           && { echo "  FAIL: an RTT-blown read must not seed the baseline"; bf=1; }
  jitter_baseline_ok 0 82.821 118.915 200 100  && { echo "  FAIL: a jitter-BAD read (the live 2026-07-15 118.9ms sample) must not seed the baseline"; bf=1; }
  jitter_baseline_ok '' '' '' 200 100          && { echo "  FAIL: an unparsed read must not seed the baseline"; bf=1; }
  [ "$bf" = 0 ] || { echo "smoke-test: FAIL (jitter baseline admission drifted)"; exit 1; }
  # ...and end-to-end against a real history file: BAD-jitter fixtures must not move the median.
  _jh=$(mktemp); printf '9\n10\n11\n9\n10\n' > "$_jh"
  _m0=$(hist_pctile "$_jh" 10 5); _n0=$(wc -l < "$_jh")
  for _bad in 118.915 411.693 718.071; do jitter_baseline_feed "$_jh" 0 82.821 "$_bad" 200 100; done
  _m1=$(hist_pctile "$_jh" 10 5); _n1=$(wc -l < "$_jh")
  { [ "$_m1" = "$_m0" ] && [ "$_n1" = "$_n0" ]; } \
    || { rm -f "$_jh"; echo "smoke-test: FAIL (BAD-jitter fixtures moved the baseline: p10 $_m0 -> $_m1 over $_n0 -> $_n1 samples — the ratchet is back)"; exit 1; }
  jitter_baseline_feed "$_jh" 0 57.456 12 200 100
  _n2=$(wc -l < "$_jh")
  [ "$_n2" = "$((_n0 + 1))" ] \
    || { rm -f "$_jh"; echo "smoke-test: FAIL (a clean read must still seed the baseline: $_n1 -> $_n2 samples)"; exit 1; }
  rm -f "$_jh"
  # Symmetric hysteresis debounce (chat-review/egress-quality-jitter-flap part a): oscillating jitter
  # (verdicts OK,BAD,OK,BAD from a 9/11/9/11ms fixture) must NOT flap — BAD needs a streak of 2 to set,
  # so a single-sample dip either way never flips state or fires an alert.
  df=0; st=OK; bs=0; os=0
  for v in OK BAD OK BAD; do
    read -r st bs os act < <(quality_debounce "$v" "$st" "$bs" "$os")
    [ "$act" = NONE ] || { echo "  FAIL: oscillating 9/11/9/11ms fixture fired '$act' on verdict=$v (expected no flap)"; df=1; }
  done
  [ "$st" = OK ] || { echo "  FAIL: oscillating fixture should stay OK (never accumulates 2 consecutive BAD)"; df=1; }
  # genuine sustained badness still alerts within 2 reads
  st=OK; bs=0; os=0
  read -r st bs os act < <(quality_debounce BAD "$st" "$bs" "$os")
  [ "$act" = NONE ] && [ "$st" = OK ] || { echo "  FAIL: single BAD read should not yet alert"; df=1; }
  read -r st bs os act < <(quality_debounce BAD "$st" "$bs" "$os")
  [ "$act" = ALERT-BAD ] && [ "$st" = BAD ] || { echo "  FAIL: 2nd consecutive BAD should alert within 2 reads (got action=$act state=$st)"; df=1; }
  # recovery needs 2 consecutive OK reads (a lone dip must not clear the alarm)
  read -r st bs os act < <(quality_debounce OK "$st" "$bs" "$os")
  [ "$act" = NONE ] && [ "$st" = BAD ] || { echo "  FAIL: single OK read after BAD should not yet clear (got action=$act state=$st)"; df=1; }
  read -r st bs os act < <(quality_debounce OK "$st" "$bs" "$os")
  [ "$act" = ALERT-OK ] && [ "$st" = OK ] || { echo "  FAIL: 2nd consecutive OK should clear+alert (got action=$act state=$st)"; df=1; }
  [ "$df" = 0 ] || { echo "smoke-test: FAIL (jitter-flap hysteresis drifted)"; exit 1; }
  # 403 retry-once guard (chat-review/egress-403-single-sample-pages-operator): a lone 403 is usually a
  # transient link-flap (rtw88 ~14min deauth) that self-heals — confirmed live 2026-07-17 (403 17:33 →
  # stable 405 2min later, no fix run) — yet the single-sample path pinned STATE=BAD and PAGED the
  # operator's phone. resolve_anth folds the retry: a 403 that CLEARS resolves to the recovered code
  # (no BAD, no page); a 403 that PERSISTS across both samples stays 403 (real geo-block, still fires).
  # RED against the old single-sample path, which fed the raw 403 straight into the BAD+TG branch.
  [ "$(resolve_anth 403 405)" = 405 ] || { echo "smoke-test: FAIL (403->405 flap must resolve to 405 recovered, not pin BAD/page)"; exit 1; }
  [ "$(resolve_anth 403 200)" = 200 ] || { echo "smoke-test: FAIL (403->200 flap must resolve to the recovered code)"; exit 1; }
  [ "$(resolve_anth 403 403)" = 403 ] || { echo "smoke-test: FAIL (a PERSISTENT 403 across both samples must stay 403 and fire the geo-block alert)"; exit 1; }
  [ "$(resolve_anth 405 405)" = 405 ] || { echo "smoke-test: FAIL (a clean 405 first sample must pass through unchanged — retry never runs)"; exit 1; }
  [ "$(resolve_anth 000 000)" = 000 ] || { echo "smoke-test: FAIL (a persistent 000 across both samples must stay 000)"; exit 1; }
  [ "$(resolve_anth 000 405)" = 405 ] || { echo "smoke-test: FAIL (the debounce covers the whole IMPAIRED class, not just 403: a 000 that CLEARS on retry must resolve to the recovered code)"; exit 1; }
  [ "$(resolve_anth 403 000)" = 403 ] || { echo "smoke-test: FAIL (one impaired code retrying into ANOTHER impaired code is not a recovery — it must stay pinned)"; exit 1; }
  # CHRONIC LATCH (chat-review/egress-quality-chronic-latch): per-episode hysteresis is honest per
  # episode and spam per condition — a chronically flapping link IS edges (live 2026-07-16: 10 bad/ok
  # pairs = ~20 TG pings in 5.5h, all narrating one already-tasked root cause). Drive 4 full alerted
  # bad/ok cycles: episodes 1-2 pass through, the 3rd LATCHES (its own board+TG edge), pairs after
  # the latch are SUPPRESSED (log/trace only), and only a clean 24h window UNLATCHES — never
  # mid-episode, and never while a single long BAD episode merely outlives the window.
  lf=0; _lt=$(mktemp -d); _lep="$_lt/episodes"; _lch="$_lt/chronic"
  _lnow=1000000; _leff=""; _ln=""
  for _i in 1 2; do
    _lnow=$((_lnow + 600))
    read -r _leff _ln < <(chronic_latch ALERT-BAD BAD "$_lep" "$_lch" "$_lnow")
    [ "$_leff" = ALERT-BAD ] || { echo "  FAIL: pre-latch episode $_i must still alert (got '$_leff')"; lf=1; }
    read -r _leff _ln < <(chronic_latch ALERT-OK OK "$_lep" "$_lch" "$_lnow")
    [ "$_leff" = ALERT-OK ] || { echo "  FAIL: pre-latch recovery $_i must still alert (got '$_leff')"; lf=1; }
  done
  _lnow=$((_lnow + 600))
  read -r _leff _ln < <(chronic_latch ALERT-BAD BAD "$_lep" "$_lch" "$_lnow")
  { [ "$_leff" = LATCH ] && [ "$_ln" = 3 ]; } || { echo "  FAIL: 3rd alerted episode in the window must LATCH (got '$_leff' n='$_ln')"; lf=1; }
  [ -s "$_lch" ] || { echo "  FAIL: LATCH must stamp the chronic state file"; lf=1; }
  read -r _leff _ln < <(chronic_latch ALERT-OK OK "$_lep" "$_lch" "$_lnow")
  [ "$_leff" = SUPPRESS-OK ] || { echo "  FAIL: latched recovery must suppress board/TG (got '$_leff')"; lf=1; }
  _lnow=$((_lnow + 600))
  read -r _leff _ln < <(chronic_latch ALERT-BAD BAD "$_lep" "$_lch" "$_lnow")
  [ "$_leff" = SUPPRESS-BAD ] || { echo "  FAIL: post-latch episode must suppress board/TG (got '$_leff')"; lf=1; }
  read -r _leff _ln < <(chronic_latch NONE OK "$_lep" "$_lch" "$((_lnow + 600))")
  [ "$_leff" = NONE ] || { echo "  FAIL: latched with episodes still in window must stay latched (got '$_leff')"; lf=1; }
  read -r _leff _ln < <(chronic_latch NONE BAD "$_lep" "$_lch" "$((_lnow + 90000))")
  [ "$_leff" = NONE ] || { echo "  FAIL: empty window but state still BAD must stay latched — clean means RECOVERED clean (got '$_leff')"; lf=1; }
  read -r _leff _ln < <(chronic_latch NONE OK "$_lep" "$_lch" "$((_lnow + 90000))")
  [ "$_leff" = UNLATCH ] || { echo "  FAIL: clean 24h + OK must UNLATCH with its own edge (got '$_leff')"; lf=1; }
  [ -s "$_lch" ] && { echo "  FAIL: UNLATCH must clear the chronic state file"; lf=1; }
  printf '%s' "$_lnow" > "$_lt/sum"
  chronic_summary_due "$_lt/sum" "$((_lnow + 3600))" && { echo "  FAIL: daily summary must not be due 1h after its last stamp"; lf=1; }
  chronic_summary_due "$_lt/sum" "$((_lnow + 86401))" || { echo "  FAIL: daily summary must be due after 24h"; lf=1; }
  rm -rf "$_lt"
  [ "$lf" = 0 ] || { echo "smoke-test: FAIL (chronic latch drifted — the quality lane would re-spam a tasked root cause per edge)"; exit 1; }
  # DERP-lane trend fold (wire-path-watch consumer 2026-07-05): newest netweather line extracted,
  # de-duped by its own sample ts — asserts the tape vocab contract with mesh-path-watch
  # ([[cross-sense-vocab-contract]]: this grep breaks silently if that tool renames the token).
  _pwt=$(mktemp)
  printf '2026-07-05T10:00:00Z netweather udp=true derp=Amsterdam lat_ms=54.5\n2026-07-05T11:00:00Z netweather udp=true derp=Amsterdam lat_ms=98.2\n' > "$_pwt"
  _nw=$(grep ' netweather ' "$_pwt" | tail -1)
  { [ "${_nw%% *}" = "2026-07-05T11:00:00Z" ] && printf '%s' "$_nw" | grep -q 'lat_ms=98.2'; } \
    || { rm -f "$_pwt"; echo "smoke-test: FAIL (netweather trend extract: '$_nw')"; exit 1; }
  rm -f "$_pwt"
  # ── FLOOR-vs-MEDIAN calibration on a BIMODAL link (task:egress-quality-renders-one-coin-flip-sample-
  # and-hides-a-50-percent-base-rate). Fixture is this node's REAL QJHIST as of 2026-08-19, verbatim —
  # a link that sits either at its floor or inside a burst, ~50/50. The load-bearing assertion is that
  # the two statistics DISAGREE about whether the axis can fire at all: the median puts the cap on the
  # ceiling (unfalsifiable, 338 of 425 live runs) while the floor puts it where a 39.5ms mdev reads BAD.
  cf=0
  _bh=$(mktemp)
  printf '71.901\n41.946\n83.419\n38.426\n29.748\n0.414\n0.257\n44.841\n39.208\n29.046\n33.455\n26.678\n7.218\n21.641\n89.278\n34.915\n0.434\n0.779\n77.975\n2.540\n' > "$_bh"
  _p10=$(hist_pctile "$_bh" 10 5); _p50=$(hist_pctile "$_bh" 50 5)
  [ "$_p10" = "0.414" ] || { echo "  FAIL: p10 of the live bimodal jitter history must name the FLOOR mode (0.414), got '$_p10'"; cf=1; }
  _cap_floor=$(scaled_jitter_max 10 6 "$_p10" 100)
  _cap_med=$(scaled_jitter_max 10 6 "$_p50" 100)
  [ "$_cap_med" = "100" ] || { echo "  FAIL: fixture no longer reproduces the median ratchet (expected the 100ms ceiling, got '$_cap_med') — the regression this gate guards has changed shape"; cf=1; }
  [ "$(quality_classify 0 60.8 39.547 200 "$_cap_med")" = OK ] \
    || { echo "  FAIL: fixture must reproduce the live bug — a 39.5ms mdev read OK under the median-derived cap"; cf=1; }
  [ "$(quality_classify 0 60.8 39.547 200 "$_cap_floor")" = BAD ] \
    || { echo "  FAIL: a 39.5ms mdev on a link whose floor is 0.414ms must read BAD under the floor-derived cap (got cap=$_cap_floor) — the jitter axis is pinned unfalsifiable again"; cf=1; }
  # bootstrap asymmetry: an unmeasured link must fall back to the LOOSE end on both axes, never the tight one
  [ "$(scaled_rtt_max 25 2 '' 200)" = "200" ] \
    || { echo "  FAIL: a node with no RTT history must fall back to the CEILING (the pre-fix constant), not the 25ms floor clamp — every read past 25ms would page from its first tick"; cf=1; }
  [ "$(scaled_rtt_max 25 2 60.46 200)" = "120.92" ] \
    || { echo "  FAIL: a measured rtt floor of 60.46ms must scale to 120.92ms, got '$(scaled_rtt_max 25 2 60.46 200)'"; cf=1; }
  [ "$(scaled_rtt_max 25 2 500 200)" = "200" ] || { echo "  FAIL: the scaled RTT cap must never ratchet past its ceiling"; cf=1; }
  [ -z "$(hist_pctile "$_bh" 10 999)" ] || { echo "  FAIL: below min-samples hist_pctile must render EMPTY (bootstrap), never a number off a thin history"; cf=1; }
  rtt_baseline_ok 0 60.4 200   || { echo "  FAIL: a clean under-ceiling read must seed the RTT baseline"; cf=1; }
  rtt_baseline_ok 20 60.4 200  && { echo "  FAIL: a lossy read must not seed the RTT baseline"; cf=1; }
  rtt_baseline_ok 0 350 200    && { echo "  FAIL: an over-ceiling read must not seed the RTT baseline (that is the ratchet)"; cf=1; }
  rtt_baseline_ok '' '' 200    && { echo "  FAIL: an unparsed read must not seed the RTT baseline"; cf=1; }
  rm -f "$_bh"
  [ "$cf" = 0 ] || { echo "smoke-test: FAIL (floor-vs-median self-calibration drifted)"; exit 1; }
  # ── AN UNREACHABLE IS A READING, A PARSE FAILURE IS BLINDNESS. They were one string for 55 SKIPs/day.
  sf=0
  [ "$(qskip_reason 'x' 100 '')" = "unreachable:total-loss" ] || { echo "  FAIL: a parseable 100% loss is a READING of a dead link, got '$(qskip_reason 'x' 100 '')'"; sf=1; }
  [ "$(qskip_reason 'ping: connect: Network is unreachable' '' '')" = "unreachable:no-route" ] || { echo "  FAIL: a no-route ping is a READING, not blindness"; sf=1; }
  [ "$(qskip_reason '' '' '')" = "blind:no-transcript" ] || { echo "  FAIL: no transcript at all is BLINDNESS"; sf=1; }
  [ "$(qskip_reason 'PING 1.1.1.1 ... some unparseable shape' '' '')" = "blind:cannot-parse" ] || { echo "  FAIL: an unparseable transcript is BLINDNESS"; sf=1; }
  # the load-bearing assertion: the two classes must not collide into one token again
  _u=$(qskip_reason 'x' 100 ''); _b=$(qskip_reason '' '' '')
  [ "${_u%%:*}" != "${_b%%:*}" ] || { echo "  FAIL: unreachable and blind collapsed to the same class ('${_u%%:*}') — a link the node measured dead reads identical to a probe that never ran"; sf=1; }
  [ "$sf" = 0 ] || { echo "smoke-test: FAIL (SKIP reason split drifted)"; exit 1; }
  # ── THE BASE RATE BESIDE THE SAMPLE. Drive the REAL fold against a fixture tape, including the NUL
  # span this log actually carries: GNU grep flags the whole file binary at the first NUL and SUPPRESSES
  # every matching line after it (measured live 2026-08-19: 5504 of 10238 lines emitted, tail -1 21 days
  # stale). Deleting the `-a` in quality_baserate turns the assertion below RED — seen.
  bf2=0
  _bt=$(mktemp)
  : > "$_bt"
  # The BAD class is deliberately MIXED here: 3 hop1-bad + 1 hop1-unknown + 1 legacy row carrying no
  # where= at all (pre-2026-08-17 tape) are all ABSTENTIONS about egress, and 2 beyond-hop1 are the only
  # real far faults. With 4 OK the attributable window is 2/6; a fold that still shares one denominator
  # renders BAD:71%(5/7)..BAD:88% instead — the fault this leg exists to catch.
  for i in 1 2 3; do printf '2026-08-19T0%d:00:00Z QUALITY BAD where=hop1-bad loss=5%% avg=300.0ms mdev=50.0ms host=1.1.1.1\n' "$i" >> "$_bt"; done
  printf '2026-08-19T04:00:00Z QUALITY BAD where=hop1-unknown loss=5%% avg=300.0ms mdev=50.0ms host=1.1.1.1\n' >> "$_bt"
  printf '2026-08-19T05:00:00Z QUALITY BAD loss=5%% avg=300.0ms mdev=50.0ms host=1.1.1.1\n' >> "$_bt"
  printf '2026-08-19T07:00:00Z QUALITY SKIP unreachable:total-loss host=1.1.1.1\n' >> "$_bt"
  printf '2026-08-19T07:30:00Z QUALITY SKIP blind:no-transcript host=1.1.1.1\n' >> "$_bt"
  printf '\000\000\000\n' >> "$_bt"                 # the crash-truncated append this tape really carries
  for i in 1 2; do printf '2026-08-19T0%d:30:00Z QUALITY BAD where=beyond-hop1 loss=5%% avg=300.0ms mdev=50.0ms host=1.1.1.1\n' "$i" >> "$_bt"; done
  for i in 1 2 3 4; do printf '2026-08-19T1%d:00:00Z QUALITY OK loss=0%% avg=60.0ms mdev=1.0ms host=1.1.1.1\n' "$i" >> "$_bt"; done
  _bs=$(quality_baserate "$_bt" 480)
  case "$_bs" in
    *"BAD:33%(2/6)"*) : ;;
    *) echo "  FAIL: the rate must be the ATTRIBUTABLE window only — beyond-hop1 BAD against OK, expected BAD:33%(2/6), got '$_bs'. Either an abstention (hop1-bad/hop1-unknown/no-where) is sharing the denominator with a real far fault, or the fold went blind at the NUL and lost the post-NUL rows (a plain grep would fold a stale window and stamp it with a live span)"; bf2=1 ;;
  esac
  case "$_bs" in
    *"unattrib:5"*) : ;;
    *) echo "  FAIL: every frame that cannot be attributed past hop1 must be counted in its OWN coverage term (expected unattrib:5 — 3 hop1-bad + 1 hop1-unknown + 1 legacy row with no where=), got '$_bs'. Dropping it hides how much of the window said nothing about egress"; bf2=1 ;;
  esac
  case "$_bs" in
    *"unreach:1 blind:1"*) : ;;
    *) echo "  FAIL: the fold must count unreachable and blind SKIPs SEPARATELY, got '$_bs'"; bf2=1 ;;
  esac
  case "$_bs" in
    *rtt_p50=*|*rtt_p90=*) : ;;
    *) echo "  FAIL: the fold must publish the window's RTT percentiles, got '$_bs'"; bf2=1 ;;
  esac
  case "$_bs" in
    *' avg='*|*' loss='*|*anthropic=*) echo "  FAIL: the fold must not re-use loss=/avg=/anthropic= keys — mesh-egress-stream:46 scrapes them with a GREEDY .* and would read the SUMMARY as the sample: '$_bs'"; bf2=1 ;;
  esac
  # AN ALL-UNATTRIBUTABLE WINDOW IS THE WHOLE POINT: every frame BAD, every one of them hop1-bad, so the
  # tool measured a degraded path and learned NOTHING about egress. Rendering BAD:100% there is the
  # original fault at its maximum — the dash would say egress is entirely broken on zero evidence.
  : > "$_bt"
  for i in 1 2 3 4; do printf '2026-08-19T0%d:00:00Z QUALITY BAD where=hop1-bad loss=5%% avg=300.0ms mdev=50.0ms host=1.1.1.1\n' "$i" >> "$_bt"; done
  _bs3=$(quality_baserate "$_bt" 480)
  case "$_bs3" in
    *"BAD:n/a"*) : ;;
    *) echo "  FAIL: a window whose every BAD is unattributable must render BAD:n/a — it is an abstention, not a 100% egress fault: '$_bs3'"; bf2=1 ;;
  esac
  case "$_bs3" in
    *"unattrib:4"*) : ;;
    *) echo "  FAIL: the n/a arm must still publish the abstention count, or the reader cannot tell 'nothing measured' from 'nothing attributable': '$_bs3'"; bf2=1 ;;
  esac
  # an ALL-SKIP window must say n/a, never a 0% BAD that reads as a clean link
  : > "$_bt"
  printf '2026-08-19T07:00:00Z QUALITY SKIP blind:no-transcript host=1.1.1.1\n2026-08-19T07:03:00Z QUALITY SKIP blind:no-transcript host=1.1.1.1\n' >> "$_bt"
  _bs2=$(quality_baserate "$_bt" 480)
  case "$_bs2" in
    *"BAD:n/a"*) : ;;
    *) echo "  FAIL: a window with nothing graded must render BAD:n/a, never a 0% that reads as a clean link: '$_bs2'"; bf2=1 ;;
  esac
  : > "$_bt"
  [ -z "$(quality_baserate "$_bt" 480)" ] || { echo "  FAIL: an empty tape must fold to EMPTY (the caller renders base=n/a), not a fabricated summary"; bf2=1; }
  rm -f "$_bt"
  [ "$bf2" = 0 ] || { echo "smoke-test: FAIL (quality base-rate fold drifted — a consumer would read one 4s frame as the link's state)"; exit 1; }
  echo "smoke-test: ok (identity json parser + path-quality parser/classifier + floor-vs-median self-calibration + SKIP reason split + base-rate fold + jitter-flap hysteresis + chronic latch + netweather trend extract verified)"; exit 0
}
# READ-ONLY fold, for a human or a dash: the rolling base rate beside whatever the last frame said. No
# probe, no state write, no alert — it only re-reads the tape. `--quality-summary` recomputes live;
# every cron run also leaves the same string in $QBASE so a dash pays nothing to render it.
[ "${1:-}" = --quality-summary ] && {
  [ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
  . <(sed -n '/^quality_baserate(){/,/^}/p' "$0")
  _bl="$HOME/.mesh/egress-health.log"
  _b=$(quality_baserate "$_bl" "${MESH_EGRESS_BASE_N:-480}")
  # a missing/empty tape is BLINDNESS, not a clean link — say so, never render an absent fold as calm
  [ -n "$_b" ] || { echo "quality: base n/a (no QUALITY samples on $_bl)"; exit 2; }
  echo "quality: $_b"
  echo "last:    $(LC_ALL=C grep -a ' QUALITY ' "$_bl" 2>/dev/null | tail -1 | sed -E 's/ base=.*//')"
  exit 0
}
# robust HOME for cron (review #15)
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
export PATH="$HOME/.local/bin:$PATH"
# Per-node egress POLICY (e.g. MESH_EGRESS_ISO=US on a US-uplink node like phaedra, whose correct egress
# is its OWN public IP, not the home NL VPN). Lives in a config file, NOT the crontab — so mesh-reflexes
# (which rewrites the crontab) can't revert it. No file ⇒ unchanged NL default. (2026-06-15: phaedra was
# flapping [egress-bad]/[egress-ok] because it expected NL while correctly egressing US.)
[ -f "$HOME/.mesh/egress.conf" ] && . "$HOME/.mesh/egress.conf" 2>/dev/null
EXPECT="${MESH_EGRESS_ISO:-NL}"
LOG="$HOME/.mesh/egress-health.log"; STATE="$HOME/.mesh/.egress-state"
# CAUSE SIDECAR (2026-08-14, chat-review/stress-egress-bad-mislabeled-geoblock). $STATE is a BINARY
# OK/BAD bit read by 10 tools — a shared observable that NAMES A MECHANISM IT CANNOT SUPPORT: this lane
# fires BAD for two orthogonal reasons (a 403 geo-block = the API round-trip is DEAD; a country mismatch
# = the round-trip WORKS, we merely egress somewhere unexpected) and the bit throws the difference away.
# mesh-stress then rendered every BAD as "geo-blocked → channel literally down" + CRITICAL + "run
# mesh-fix-egress NOW" — measured 2026-08-14 on mesh-home: hours of BAD, every line anthropic=405
# (function alive), cause ISO-MISMATCH, zero 403s. The cause goes in a SIDECAR, not in $STATE, because
# changing $STATE's format would have to sweep all 10 readers (a-format-fix-must-sweep-every-reader);
# the sidecar is written by this same writer at the same instant, only where $STATE itself is written,
# so the two never disagree (a SKIP leaves both untouched, as before).
CAUSE="$HOME/.mesh/.egress-cause"
# The identity PAGE lane's own state — deliberately NOT $STATE. $STATE is the binary bit ~10 cause-blind
# consumers read and it must keep moving on the FIRST sample; these three files debounce only the human
# page (see identity_debounce above). Their absence is a clean bootstrap, never a third state.
IPSTATE="$HOME/.mesh/.egress-page-state"
IPBSTREAK="$HOME/.mesh/.egress-page-bad-streak"
IPOKSTREAK="$HOME/.mesh/.egress-page-ok-streak"
# 403 retry resolution — DEFINED HERE because the identity lane below CALLS it. It used to live ~200
# lines further down, past its own call site: bash resolves a function body at CALL time, so
# `eff=$(resolve_anth …)` ran a command that did not exist yet → stderr "command not found", eff EMPTY,
# and the guard's own log line printed "403->403 (transient flap, self-healed)" for a PERSISTENT 403.
# Worse, `anth=$eff` then blanked the code, so the geo-block branch could never fire and the run fell
# through to the country check — the mesh's core 403 alarm was structurally unreachable. Caught 2026-08-14
# only once --test drove the LIVE path end-to-end (the unit gates all call the function directly, where
# --test sources it BY NAME and it is therefore always defined). Sibling of the egress_qfunc move below.
resolve_anth(){  # $1=first impaired sample $2=retry sample -> effective code (recovered, or persistent)
  # Widened 2026-08-28 from 403-only to the whole IMPAIRED class (403 AND 000). A 000 — no HTTP
  # round-trip completed at all — is exactly as transient-prone on this node's flapping dongle as a
  # 403, and it is the code a dead minds-proxy produces, so it needs the same streak-of-2 debounce
  # before it may pin BAD and page. A recovered sample wins; two impaired samples stand.
  if [ "$(egress_qfunc "$1")" = IMPAIRED ] && [ "$(egress_qfunc "$2")" != IMPAIRED ]; then printf '%s' "$2"
  else printf '%s' "$1"; fi
}
# The FUNCTION probe: does an Anthropic round-trip survive this path? (Full rationale — enantiostasis,
# variable-vs-function — at the quality lane's page gate below; the definition lives here because the
# identity lane above needs it first and bash resolves function bodies at call time.)
egress_qfunc(){ # $1 = post-retry api.anthropic.com HTTP code -> PRESERVED|IMPAIRED|UNKNOWN
  case "$1" in
    ''|SKIP) echo UNKNOWN ;;   # no measurement -> conservative (keep the page; never a faked all-clear)
    000)     echo IMPAIRED ;;  # no HTTP round-trip completed over the path -> function down
    403)     echo IMPAIRED ;;  # round-trip completed but geo-blocked -> function unusable (identity axis pages)
    *)       echo PRESERVED ;; # any other HTTP code = a full round-trip completed over this path within -m10
  esac
}
# NAME THE PATH (2026-08-22, task egress-iso-pin-tracks-the-route-and-nothing-derives-it). The expected
# ISO is a hand-kept constant that has been reversed TWICE, each reversal preceded by days of false BAD,
# because the log said only WHAT country was seen and never WHICH PATH produced it. Deriving the expected
# ISO from ExitNodeID (the task's cure (a)) only moves the hand-kept constant one ring out — an ID->ISO
# map is the same artifact wearing a different name — so instead the DRIFT line carries the path itself,
# which is the fact a human needs to decide whether the pin or the route moved. Best-effort and LOUD
# about not knowing: never a plausible constant.
egress_path_id(){  # -> exit-node:<peer> | dev:<iface> | unknown
  local en dev
  en=$(tailscale status --json 2>/dev/null | python3 -c '
import sys,json
try: d=json.load(sys.stdin)
except Exception: sys.exit(0)
for p in (d.get("Peer") or {}).values():
    if p.get("ExitNode"):
        print("exit-node:" + (p.get("HostName") or (p.get("DNSName") or "?").split(".")[0])); break
' 2>/dev/null)
  [ -n "$en" ] && { printf '%s' "$en"; return; }
  dev=$(ip route show default 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="dev"){print $(i+1); exit}}')
  [ -n "$dev" ] && { printf 'dev:%s' "$dev"; return; }
  printf 'unknown'
}
write_egress_state(){ # $1=OK|BAD  $2=cause token  $3=anthropic code -> writes $STATE + $CAUSE together
  echo "$1" > "$STATE"
  echo "$2 qfunc=$(egress_qfunc "$3") anth=${3:-?}" > "$CAUSE"
}
# ── PAGE-LANE HYSTERESIS + PAIRING (chat-review/egress-board-edges-are-gated-asymmetrically) ──
# Both lanes in this file paged on a bare EDGE of a per-run verdict, and both edges were gated
# ASYMMETRICALLY. Measured on this node's own tape, 2026-08-31:
#   · IDENTITY: 08-29 posted 28 [egress-bad] + 27 [egress-ok] (55 board lines, 55 TG pings); 08-28
#     15+14; 08-30 17+16. Over 08-29..08-30 the tape holds 55 BAD episodes and 35 of them (64%) lasted
#     exactly ONE 3-min probe — they closed on the very next sample. Replaying that two-day sequence
#     through the ladder below: 110 pages -> 36, while the 140-, 23- and 19-sample outages still board.
#   · QUALITY: the enantiostasis downgrade (qpage_gate) and the chronic latch each eat the ALERT-BAD
#     edge and NEITHER touched the matching ALERT-OK edge. 08-29 logged 17 DEGRADED-FUNCTIONAL
#     downgrades and the board carried exactly 17 "[egress-quality-ok] path restored" posts against
#     ONE bad post; 08-28, 6 and 6 against zero. A recovery for a degradation nobody was told about is
#     not merely noise — it teaches the reader that these tags carry no information.
# NEITHER helper touches $STATE/$CAUSE/$QSTATE or the exit code: the honest bit still moves on the
# FIRST sample for all ~10 cause-blind consumers. Only the HUMAN page is debounced — the same
# discipline qpage_gate already states ("QSTATE/exit contract is UNCHANGED; only the human page moves").
identity_debounce(){ # $1=verdict(BAD|OK|SKIP) $2=fastfire(yes|no) $3=page-state $4=bstreak $5=ostreak
                     # -> ALERT-BAD | ALERT-OK | NONE   (its OWN state files, never the shared slot)
  local v="$1" fast="$2" sf="$3" bf="$4" of="$5"
  local need="${MESH_EGRESS_IBAD_STREAK:-2}" dwell="${MESH_EGRESS_IOK_DWELL:-2}"
  # The 403 lane keeps its first-sample fire (operator, egress.conf:59) and it is NOT what flaps: over
  # 08-29..08-30 the tape holds 4 samples of anthropic=403 against 284 of no-roundtrip. Debouncing the
  # geo-block would buy ~nothing and cost 3 minutes on the mesh's core alarm.
  [ "$fast" = yes ] && need=1
  local prev b o act=NONE
  prev=$(cat "$sf" 2>/dev/null || echo OK); b=$(cat "$bf" 2>/dev/null || echo 0); o=$(cat "$of" 2>/dev/null || echo 0)
  case "$prev" in BAD|OK) : ;; *) prev=OK ;; esac      # a truncated/absent file is not a third state
  case "$b" in ''|*[!0-9]*) b=0 ;; esac
  case "$o" in ''|*[!0-9]*) o=0 ;; esac
  case "$v" in
    SKIP) : ;;                              # a blind probe HOLDS the page state — blindness is not evidence
    BAD)
      b=$((b + 1))
      if [ "$b" -ge "$need" ]; then
        [ "$prev" != BAD ] && act=ALERT-BAD
        prev=BAD; b=0; o=0
      else o=0; fi ;;
    OK)
      o=$((o + 1))
      if [ "$prev" != BAD ]; then prev=OK; b=0; o=0
      elif [ "$o" -ge "$dwell" ]; then act=ALERT-OK; prev=OK; b=0; o=0
      else b=0; fi ;;
  esac
  printf '%s\n' "$prev" > "$sf"; printf '%s\n' "$b" > "$bf"; printf '%s\n' "$o" > "$of"
  printf '%s\n' "$act"
}
pair_gate(){ # $1=effective action $2=announced-flag-file -> the action, with the BAD/OK pair CLOSED
  # A recovery page is honest only if the degradation it closes was itself ANNOUNCED. Every suppressor
  # upstream eats the BAD edge and leaves the OK edge intact, so the pairing cannot be a property of any
  # one suppressor — it has to be asserted once, after all of them, against a flag only a real page sets.
  # UNPAIRED-OK is a WORD, not a silence: the caller still writes the tape row and traces it, so a
  # suppressed recovery is countable rather than invisible.
  case "$1" in
    ALERT-BAD|LATCH)  : > "$2"; printf '%s\n' "$1" ;;
    ALERT-OK)         if [ -e "$2" ]; then rm -f "$2"; echo ALERT-OK; else echo UNPAIRED-OK; fi ;;
    UNLATCH)          rm -f "$2"; printf '%s\n' "$1" ;;
    *)                printf '%s\n' "$1" ;;
  esac
}
# ===== THE MEASUREMENT IS ENV-INDEPENDENT, AND IT MEASURES BOTH PATHS ========================
# (2026-08-28, task egress-state-slot-has-two-writers-measuring-two-different-paths.) Until now the two
# probes here ran with whatever proxy env the INVOKING SHELL happened to carry, so the verdict was a
# property of the CALLER, not of the node. This node has TWO egress paths — the host route, and the
# app-level proxy every mind carries (restore.env's PROXY exports -> privoxy :8118 -> ssh -D phaedra,
# re-enabled by operator directive 2026-08-28) — and they disagree whenever the exit node is down:
# measured 12:52Z, proxied 38.49.216.141/US/405 vs unproxied 5.227.27.235/RU/403, NEITHER a fault.
# The verdict is an if/elif chain, so ONE process can never write both rows; two rows in the SAME
# SECOND is two PROCESSES. The */3 cron entry (reflexes.cron:42, no proxy env) took the 403 branch,
# any pane- or mesh-egress-stream-invoked run took the OK branch, and both wrote the SAME shared slot
# ($STATE + $CAUSE, read by NINE cause-blind consumers) — last writer wins. Measured flapping WITH
# pages: the tape holds an OK row and a BAD row at 12:48:01Z, the board holds [egress-ok] 12:45:48Z
# then [egress-bad] 12:48:03Z, 2m15s apart, TG-paged both times, nothing about the network changed.
# The cure is NOT to silence the 403 lane (operator, egress.conf:59). It is three things:
#   (a) NEVER INHERIT. Every probe runs under `env -u` on all six proxy vars, and the proxy leg names
#       its proxy EXPLICITLY with --proxy. Cron and a pane now compute the same verdict by construction
#       — which is what actually ends the two-writer flap, since a shared slot with one writer-value
#       is no longer a race.
#   (b) PROBE BOTH LEGS EVERY RUN and publish each as its own axis (path=/alt= on every row), so a
#       reading always names WHICH PATH it took. A consumer asking "is egress up" on a two-path node
#       was asking a question with two answers; now the answer says which one it is.
#   (c) The BIT follows the leg the MINDS actually ride, and the other leg is PUBLISHED, never judged
#       against a second hand-kept constant — that would be the 08-22 pin trap one ring out (an
#       ID->ISO map is the same artifact wearing a different name). Which leg the minds ride is not a
#       new constant either: it is read from restore.env, the same declaration site the minds read, so
#       commenting that block out (the documented rollback) reverts this tool to a route-only reading
#       with no edit here.
EGRESS_PROXY_VARS='HTTP_PROXY HTTPS_PROXY ALL_PROXY http_proxy https_proxy all_proxy NO_PROXY no_proxy'
_ENVCLEAN=(env); for _v in $EGRESS_PROXY_VARS; do _ENVCLEAN+=(-u "$_v"); done
egress_proxy_url(){  # -> the proxy URL this node's minds egress through, or '' (this node has one path)
  # Explicit node policy wins. Otherwise read the DECLARATION SITE the minds themselves read — GREPPED,
  # never sourced (a file cron never sources) and never inherited, so a commented-out block yields ''.
  [ -n "${MESH_EGRESS_PROXY:-}" ] && { printf '%s' "$MESH_EGRESS_PROXY"; return 0; }
  local f="${MESH_RESTORE_ENV:-$HOME/.mesh/restore.env}"
  [ -f "$f" ] || return 0
  grep -aE '^[[:space:]]*export[[:space:]]+HTTPS_PROXY=' "$f" 2>/dev/null | tail -1 \
    | sed -E 's/^[^=]*=//; s/[[:space:]]+$//; s/^"(.*)"$/\1/; s/^'\''(.*)'\''$/\1/'
}
# One leg = one path, probed identically. Emits a '-' SENTINEL for an unmeasured field rather than an
# empty one: a bare `printf '%s %s %s'` with an empty first field shifts every later field into the
# wrong variable on read, and an IFS=$'\t' read cannot rescue it either (tab IS an IFS whitespace
# char, so `read` collapses the empty runs anyway — memory ifs-tab-read-collapses-empty-fields).
probe_leg(){ # $1='' (this node's own route) | <proxy url>   $2=leg name -> "<iso> <ip> <anth>"
  local px="$1" nm="$2" pa=() j iso ip anth a2 eff
  [ -n "$px" ] && pa=(--proxy "$px")
  j=$("${_ENVCLEAN[@]}" curl -s -m10 "${pa[@]}" https://ifconfig.co/json 2>/dev/null)
  iso=$(printf '%s' "$j" | python3 -c 'import sys,json;print(json.load(sys.stdin).get("country_iso",""))' 2>/dev/null)
  ip=$(printf  '%s' "$j" | python3 -c 'import sys,json;print(json.load(sys.stdin).get("ip",""))' 2>/dev/null)
  anth=$("${_ENVCLEAN[@]}" curl -s -m10 "${pa[@]}" -o /dev/null -w '%{http_code}' https://api.anthropic.com/v1/messages 2>/dev/null)
  # retry-once on a 403 before pinning BAD/paging the operator (chat-review/egress-403-single-sample-
  # pages-operator): a lone 403 is usually a transient link-flap (rtw88 ~14min beacon-loss deauth,
  # memory sole-path-deauth) that self-heals — confirmed live 2026-07-17 (403 17:33 -> stable 405 2min
  # later, no fix run) — but the single-sample path fired the [egress-bad] board alarm AND a TG ping on
  # it. The jitter axis already debounces single-sample dips (streak-of-2). Now PER LEG, so a flap on
  # the route cannot be laundered by a healthy proxy or vice versa.
  if [ "$(egress_qfunc "$anth")" = IMPAIRED ]; then
    sleep "${MESH_EGRESS_RETRY_SLEEP:-2}"
    a2=$("${_ENVCLEAN[@]}" curl -s -m10 "${pa[@]}" -o /dev/null -w '%{http_code}' https://api.anthropic.com/v1/messages 2>/dev/null)
    eff=$(resolve_anth "$anth" "$a2")
    [ "$(egress_qfunc "$eff")" != IMPAIRED ] && echo "$(date -u +%FT%TZ) SKIP leg=$nm anthropic=$anth->$a2 (transient flap, self-healed on retry; no alert)" >> "$LOG"
    anth=$eff
  fi
  printf '%s %s %s\n' "${iso:--}" "${ip:--}" "${anth:--}"
}
_unsent(){ [ "$1" = - ] && printf '' || printf '%s' "$1"; }
ts=$(date -u +%FT%TZ); prev=$(cat "$STATE" 2>/dev/null || echo OK)
prev_cause=$(awk '{print $1; exit}' "$CAUSE" 2>/dev/null || echo '?')   # edge-detect DRIFT: $STATE stays OK across it
PROXY_URL=$(egress_proxy_url)
read -r _riso _rip _ranth < <(probe_leg '' route)
r_iso=$(_unsent "$_riso"); r_ip=$(_unsent "$_rip"); r_anth=$(_unsent "$_ranth")
if [ -n "$PROXY_URL" ]; then
  read -r _piso _pip _panth < <(probe_leg "$PROXY_URL" proxy)
  p_iso=$(_unsent "$_piso"); p_ip=$(_unsent "$_pip"); p_anth=$(_unsent "$_panth")
  leg=proxy; iso="$p_iso"; ip="$p_ip"; anth="$p_anth"
  alt="route:${r_iso:-?}/${r_anth:-?}"; alt_fn=$(egress_qfunc "$r_anth")
else
  leg=route; iso="$r_iso"; ip="$r_ip"; anth="$r_anth"
  alt="none"; alt_fn="n/a"
fi
AXES="path=$leg alt=$alt altfn=$alt_fn"
# Geo-block is the mesh's CORE vulnerability (RU egress → Anthropic 403 → cloud minds die), so make it
# a first-class BOARD alarmer (visible to steward/minds + reliability pairing) AND a TG ping — in
# ENGLISH (operator preference). $1 = board tag line, $2 = TG message.
alert(){
  command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="egress@$(hostname)" mesh-chat "$1" >/dev/null 2>&1
  # An EMPTY $2 means "board only, no operator page" — a drift notice is not worth a phone buzz, and
  # `mesh-tg ""` would send a content-free one. Silence here is deliberate, not a swallowed failure.
  [ -n "${2:-}" ] && command -v mesh-tg >/dev/null 2>&1 && mesh-tg "$2" >/dev/null 2>&1
  return 0
}
if [ "$anth" = "403" ]; then
  write_egress_state BAD GEOBLOCK "$anth"; echo "$ts BAD anthropic=403 (geo-blocked) ip=$ip iso=$iso $AXES" >> "$LOG"
  # NOT silenced (operator, egress.conf:59): this is the mesh's core alarm and it still pages. What
  # changed is only WHICH path it judges — the leg the minds ride — and that the page NAMES it, so a
  # 403 on the route while the proxy leg is alive is no longer indistinguishable from a dead channel.
  iact=$(identity_debounce BAD yes "$IPSTATE" "$IPBSTREAK" "$IPOKSTREAK")   # fastfire: the 403 lane is not the flapper
  [ "$iact" = ALERT-BAD ] && alert "[egress-bad] Anthropic 403 on the leg the minds ride ($leg) — egress GEO-BLOCKED; cloud minds at risk. Other leg: $alt (fn=$alt_fn). Fix: mesh-fix-egress." \
                              "🚨 EGRESS DOWN: Anthropic 403 (geo-blocked) on the $leg leg — cloud minds at risk. Other leg: $alt. Run mesh-fix-egress."
elif [ "$(egress_qfunc "$anth")" = IMPAIRED ]; then
  # NO-ROUNDTRIP (2026-08-28, found by driving the dead-proxy world live rather than by reading the
  # chain). A 000 is not "cannot verify" — the function probe COMPLETED and reported that no HTTP
  # round-trip happened over this path. It used to fall into one of two swallows, both wrong in the
  # unsafe direction: with ifconfig.co also dark it hit the SKIP arm below and left the shared slot
  # FROZEN at its last value (every one of the nine consumers then reading a stale OK while the leg the
  # minds ride was dead); with a country that happened to match the pin it hit the OK arm and wrote
  # `OK qfunc=IMPAIRED` — the bit asserting the round-trip is fine while the sidecar beside it said the
  # opposite. The bit's whole claim is "the Anthropic round-trip is DOWN", and that is precisely what a
  # 000 says, country or no country. So it is judged BEFORE the country is consulted. Debounced by the
  # widened streak-of-2 retry above, so a single dongle flap still cannot page.
  write_egress_state BAD NO-ROUNDTRIP "$anth"
  echo "$ts BAD no-roundtrip anthropic=$anth ip=${ip:-?} iso=${iso:-?} $AXES" >> "$LOG"
  iact=$(identity_debounce BAD no "$IPSTATE" "$IPBSTREAK" "$IPOKSTREAK")
  [ "$iact" = ALERT-BAD ] && alert "[egress-bad] no Anthropic round-trip on the leg the minds ride ($leg): anthropic=$anth over two samples. Other leg: $alt (fn=$alt_fn). If the other leg is alive this is the PROXY, not the network — check mesh-phaedra-proxy.service and privoxy :8118." \
                              "🚨 EGRESS DOWN: no Anthropic round-trip on the $leg leg (anthropic=$anth). Other leg: $alt."
elif [ -z "$iso" ]; then
  echo "$ts SKIP cannot-verify (ifconfig.co unreachable) anthropic=$anth $AXES" >> "$LOG"   # NOT broken — don't alert
  identity_debounce SKIP no "$IPSTATE" "$IPBSTREAK" "$IPOKSTREAK" >/dev/null   # blindness HOLDS the page state
elif [ "$iso" = "$EXPECT" ]; then
  # SPLIT-PATH: the leg the minds ride is healthy, the OTHER leg is not. On this node that is the
  # DESIGNED post-directive shape (host route egresses raw MTS RU, only proxy consumers ride phaedra),
  # so it is state OK and never a page — but it is not the same fact as "both paths are fine", because
  # a node in it has NO FALLBACK: the moment the proxy dies there is nothing behind it. It gets its own
  # cause token so that difference survives into the sidecar instead of being flattened into OK, and
  # one board [fyi] on the EDGE (throttled on prev_cause, exactly like ISO-DRIFT) so entering the state
  # is visible without a permanent yellow (a saturated level is not a state).
  _cause=OK
  [ "$leg" = proxy ] && [ "$alt_fn" != PRESERVED ] && _cause=SPLIT-PATH
  write_egress_state OK "$_cause" "$anth"
  echo "$ts OK egress=$iso ip=$ip anthropic=$anth cause=$_cause $AXES" >> "$LOG"
  iact=$(identity_debounce OK no "$IPSTATE" "$IPBSTREAK" "$IPOKSTREAK")
  if [ "$iact" = ALERT-OK ]; then
    alert "[egress-ok] egress restored on the $leg leg: $ip ($iso), Anthropic=$anth. Other leg: $alt (fn=$alt_fn)." \
          "✅ EGRESS restored: $ip ($iso), Anthropic=$anth (leg=$leg)."
  elif [ "$prev" != BAD ] && [ "$_cause" = SPLIT-PATH ] && [ "$prev_cause" != SPLIT-PATH ]; then
    alert "[fyi] egress SPLIT-PATH: the $leg leg is ALIVE ($ip $iso, anth=$anth) and carries every mind on this node, but the other leg is $alt (fn=$alt_fn). NOT an outage and NOT a page — it is the designed shape since the 2026-08-28 proxy directive. What it costs: there is no fallback behind the proxy, so a privoxy/ssh-D death takes the minds with it while this node.s own route is still geo-blocked." \
          ""
  fi
elif [ "$(egress_qfunc "$anth")" = PRESERVED ]; then
  # DRIFT, NOT AN OUTAGE (2026-08-22, task egress-iso-pin-tracks-the-route-and-nothing-derives-it).
  # $STATE is a BINARY bit read by ~10 consumers, and all but mesh-stress are cause-BLIND: mesh-digest
  # renders any BAD as "🚨 EGRESS GEO-BLOCKED NOW", mesh-algedonic charges pain 0.7, mesh-mesh-state
  # says DEGRADED. Writing BAD here made a WORKING channel page as a dead one for 675 consecutive
  # samples over ~46h (anthropic=405 on 1022 of them) — twice, in opposite directions, each time
  # because a HAND-KEPT constant lagged a route change. The sidecar named the benign case and had
  # exactly one reader; naming it harder would not have stopped the other nine. So the BIT now carries
  # the claim it can actually support — "the Anthropic round-trip is DOWN" — and a country mismatch
  # whose round-trip is PRESERVED is a DRIFT notice: state OK, cause ISO-DRIFT, one board [fyi] on the
  # EDGE, no TG page. Every cause-blind reader is then correct without a format sweep
  # (a-format-fix-must-sweep-every-reader). A mismatch whose function is IMPAIRED or UNKNOWN falls to
  # the BAD arm below — an unmeasured round-trip is never a faked all-clear.
  write_egress_state OK ISO-DRIFT "$anth"
  echo "$ts DRIFT egress=$iso (want $EXPECT) ip=$ip anthropic=$anth via=$(egress_path_id) $AXES" >> "$LOG"
  iact=$(identity_debounce OK no "$IPSTATE" "$IPBSTREAK" "$IPOKSTREAK")
  if [ "$iact" = ALERT-OK ]; then
    alert "[egress-ok] Anthropic round-trip restored (anth=$anth) — but egress=$iso, expected $EXPECT: DRIFT via $(egress_path_id). Reconcile ~/.mesh/egress.conf's MESH_EGRESS_ISO with the path that now carries this node." \
          "✅ EGRESS round-trip restored (anth=$anth) — country still drifted: $iso, expected $EXPECT."
  elif [ "$prev" != BAD ] && [ "$prev_cause" != ISO-DRIFT ]; then
    alert "[fyi] egress DRIFT: exit=$iso ip=$ip, expected $EXPECT — the Anthropic round-trip is ALIVE (anth=$anth), so this is NOT an outage and NOT a page. Path carrying it: $(egress_path_id). Either the route moved or ~/.mesh/egress.conf's MESH_EGRESS_ISO is stale (it has been reversed twice); reconcile the pin with the path." \
          ""
  fi
else
  write_egress_state BAD ISO-MISMATCH "$anth"; echo "$ts BAD egress=$iso (want $EXPECT) ip=$ip anthropic=$anth $AXES" >> "$LOG"
  # Wrong country AND the round-trip is impaired/unmeasured: the bit's claim holds, so it pages.
  iact=$(identity_debounce BAD no "$IPSTATE" "$IPBSTREAK" "$IPOKSTREAK")
  [ "$iact" = ALERT-BAD ] && alert "[egress-bad] egress=$iso (expected $EXPECT) AND the Anthropic round-trip is $(egress_qfunc "$anth") (anthropic=$anth) — a real outage, not mere drift. Fix, where the node offers egress: mesh-fix-egress." \
                              "🚨 EGRESS wrong country: exit=$iso (expected $EXPECT), anthropic=$anth (function $(egress_qfunc "$anth"))."
fi

# PATH QUALITY (RTT/jitter/loss) — literature find 2026-07-04 (wire-egress-path-quality, spec:
# knowledge/capability-egress-path-quality-20260704.md). Everything above answers "am I egressing
# through the right country?" — never "is that path actually usable right now?" A degraded router-
# LAN VPN tunnel or ISP congestion can hold correct identity while RTT/loss climbs, invisible to
# every check above (verified 0 tools mesh-wide cover this axis: mesh-net-io/mesh-lan-health/
# mesh-conntrack-load are LAN-local/socket-count scope, mesh-lan-jitter is gateway-hop only, not
# WAN). Extension not a sibling tool (spec's cheaper option) — reuses this file's LOG/alert()/cron
# cadence. OWN STATE + own board tags so a quality blip never masks or gets masked by the identity
# (geo-block) alarm above — genuinely orthogonal failure modes on the same substrate.
parse_ping_quality(){ # stdin = `ping -c5 -q` transcript -> echoes "loss_pct avg_ms mdev_ms" (mdev may be empty)
  local out loss stats avg mdev
  out=$(cat)
  loss=$(printf '%s\n' "$out" | grep -oE '[0-9]+(\.[0-9]+)?% packet loss' | grep -oE '^[0-9]+(\.[0-9]+)?')
  stats=$(printf '%s\n' "$out" | grep -oE 'rtt [a-z/]+ = [0-9.]+/[0-9.]+/[0-9.]+/[0-9.]+' | sed 's#.*= ##')
  avg=$(printf '%s' "$stats" | cut -d/ -f2)
  mdev=$(printf '%s' "$stats" | cut -d/ -f4 | awk '{print $1}')
  printf '%s %s %s\n' "${loss:-}" "${avg:-}" "${mdev:-}"
}
quality_classify(){ # $1=loss% $2=avg_ms $3=mdev_ms $4=rtt_max_ms $5=jitter_max_ms -> OK|BAD|SKIP
  local loss="$1" avg="$2" mdev="$3" rmax="$4" jmax="$5"
  if [ -z "$loss" ] || [ -z "$avg" ]; then echo SKIP; return; fi
  if awk "BEGIN{exit !($loss>0)}"; then echo BAD; return; fi
  if awk "BEGIN{exit !($avg>$rmax)}"; then echo BAD; return; fi
  if [ -n "$mdev" ] && awk "BEGIN{exit !($mdev>$jmax)}"; then echo BAD; return; fi
  echo OK
}
# HOP-1 LOCALIZATION (task:egress-quality-label-names-an-unisolated-leg, 2026-08-17). The far probe is
# ONE number over FOUR legs — wifi -> gateway -> the router's own NL VPN -> 1.1.1.1 — so a BAD read
# names a degraded PATH and nothing about WHERE. It was read as an attribution anyway: mesh-dash
# labelled the line "home egress(router->NL)" while a 40-60% loss burst sat at hop 1 (192.168.8.1)
# during the very read it was labelling, i.e. the wifi leg wearing the router's name. A second,
# SIMULTANEOUS probe of the default gateway splits the path at the only boundary this node can measure
# from the inside: hop1 vs everything past it.
# Semantics are deliberately asymmetric, because a first-hop fault is not falsifiable evidence about the
# far legs: `hop1-bad` = the local leg is ALSO degraded, so the far read cannot be attributed past it
# (it does not claim the far legs are clean); `beyond-hop1` = hop1 measured clean in the same window, so
# the degradation IS past the gateway; `hop1-unknown` = no gateway / unparseable, never a faked clean.
# Own thresholds, because a LAN hop and a transatlantic VPN are not the same scale (this node's gateway
# baseline, measured 2026-08-17: loss 0%, avg 0.87-1.34ms, mdev 0.17-1.21ms — the defaults sit ~40x
# above it, so the load-bearing rule at hop1 is loss>0, which is exactly the reported signature).
qlocalize(){ # $1=far_verdict $2=hop1_loss $3=hop1_avg $4=hop1_mdev $5=hop1_rtt_max $6=hop1_jitter_max
             # -> n/a | hop1-bad | beyond-hop1 | hop1-unknown   (lowercase on purpose: an uppercase
             # BAD token here would collide with every consumer that classifies this tape by field)
  [ "$1" = BAD ] || { echo "n/a"; return; }   # only a BAD far read has anything to localize
  case "$(quality_classify "$2" "$3" "$4" "$5" "$6")" in   # one classifier, two threshold sets
    BAD)  echo "hop1-bad" ;;
    OK)   echo "beyond-hop1" ;;
    *)    echo "hop1-unknown" ;;
  esac
}
scaled_jitter_max(){ # $1=floor_ms $2=multiplier $3=this-node's-median-mdev(or empty) $4=ceiling_ms -> effective cap
  local floor="$1" mult="$2" median="$3" ceil="$4"         # a fleet-wide constant tuned to one node's LAN-VPN
  [ -z "$median" ] && { echo "$floor"; return; }            # baseline crying-wolfs on a distant node's normal
  # clamped to [floor, ceiling]: self-calibration lets the cap track this node's own jitter, the ceiling
  # stops it becoming unfalsifiable. Floor is applied LAST so an operator who deliberately raises
  # MESH_EGRESS_JITTER_MAX_MS above the ceiling gets the loose cap they asked for, not a silent clamp.
  awk -v f="$floor" -v m="$mult" -v med="$median" -v c="$ceil" \
      'BEGIN{v=med*m; if(v>c)v=c; if(v<f)v=f; print v}'     # jitter (chat-review/egress-quality-jitter-flap)
}
# Baseline admission: which reads may seed QJHIST, the rolling median that SETS the jitter cap. Gating on
# the cap itself (QJITTER_MAX) would be circular — the cap feeds the median feeds the cap — which is why
# the 2026-07-07 fix deliberately decoupled them. But decoupling it from EVERY jitter bound let jitter-BAD
# reads seed their own baseline: cap=median*6 ratcheted 10ms -> 251.9ms live, each loosening admitting worse
# samples, until the axis could not fire (chat-review/egress-jitter-baseline-ratchet). The gate is the FIXED
# ceiling, never the moving cap: non-circular (a constant, exactly like the $rmax RTT gate beside it) yet
# still leaves the whole floor..ceiling range for a distant node to self-calibrate into.
jitter_baseline_ok(){ # $1=loss% $2=avg_ms $3=mdev_ms $4=rtt_max_ms $5=jitter_ceil_ms -> rc0 if it may seed
  local loss="$1" avg="$2" mdev="$3" rmax="$4" ceil="$5"
  [ -n "$loss" ] && [ -n "$avg" ] && [ -n "$mdev" ] || return 1
  awk "BEGIN{exit !($loss==0)}"     || return 1
  awk "BEGIN{exit !($avg<=$rmax)}"  || return 1
  awk "BEGIN{exit !($mdev<=$ceil)}" || return 1
  return 0
}
jitter_baseline_feed(){ # $1=hist $2=loss $3=avg $4=mdev $5=rtt_max $6=jitter_ceil — append iff admissible
  jitter_baseline_ok "$2" "$3" "$4" "$5" "$6" || return 1
  echo "$4" >> "$1"
  tail -n "${MESH_EGRESS_JHIST_N:-20}" "$1" > "$1.tmp" 2>/dev/null && mv "$1.tmp" "$1"
}
# A ROLLING MEDIAN IS THE WRONG STATISTIC ON A BIMODAL LINK (task:egress-quality-renders-one-coin-flip-
# sample-and-hides-a-50-percent-base-rate, 2026-08-19). jitter_median() fed the cap from the MEDIAN of
# the admitted history — correct only if the samples come from one population. This node's uplink does
# not: it sits either at its floor (mdev 0.26-2.5ms) or inside a multi-hundred-ms burst, ~50/50, so the
# median lands BETWEEN the two modes and calibrates the cap to the burst, not to the link. Measured the
# day of this fix: QJHIST held 0.257 0.414 0.434 0.779 2.540 alongside 71.9 83.4 89.3 — median 31.6,
# x6 = 190 -> clamped to the 100ms CEILING in 338 of 425 runs, i.e. the jitter axis was pinned at its
# unfalsifiable maximum while the OK population's own mdev topped out at 94.1ms. It could not fire.
# The 2026-07-07 ratchet fix stopped the cap ESCAPING (ceiling admission) but not the baseline being
# CENTRED on the bad mode. Calibrate off the FLOOR (a low percentile), which is the one part of a
# bimodal distribution that names the link rather than the fault: p10 of the same history is 0.414,
# x6 = 2.5 -> the 10ms floor, and mdev=39.5 reads BAD again. Same statistic serves the RTT axis, which
# until now had NO self-calibration at all (a flat 200ms constant tuned to a 2026-07-04 ~57ms baseline —
# a constant in the source rots, and it rendered avg=198.4ms OK on a link whose floor is ~49ms).
hist_pctile(){ # $1=hist-file $2=percentile(0-100) $3=min-samples -> value, or empty (bootstrap => caller falls back to floor)
  local f="$1" p="$2" minn="$3" n
  [ -f "$f" ] || return 0
  n=$(wc -l < "$f" 2>/dev/null | tr -d ' '); [ -n "$n" ] && [ "$n" -ge "$minn" ] || return 0
  sort -g "$f" | awk -v p="$p" -v n="$n" 'BEGIN{i=int((p/100)*n+0.5); if(i<1)i=1; if(i>n)i=n} NR==i{print $1; exit}'
}
# RTT baseline: same non-circular admission as the jitter one — gated on the FIXED ceiling (QRTT_CEIL),
# never on the moving cap, so the cap can never ratchet itself into unfalsifiability.
rtt_baseline_ok(){ # $1=loss% $2=avg_ms $3=rtt_ceil_ms -> rc0 if it may seed
  local loss="$1" avg="$2" ceil="$3"
  [ -n "$loss" ] && [ -n "$avg" ] || return 1
  awk "BEGIN{exit !($loss==0)}"   || return 1
  awk "BEGIN{exit !($avg<=$ceil)}" || return 1
  return 0
}
# The RTT bootstrap default is the CEILING, not the floor — the opposite of the jitter axis, and the
# distinction is load-bearing. scaled_jitter_max() returns its FLOOR when no baseline exists, which is
# correct for jitter (10ms is the LOOSE default there) and catastrophic for RTT (25ms is the TIGHT lower
# clamp: a node with no history yet would call every read past 25ms BAD from its first cron tick). A
# node with no history has not measured its own floor, so it must fall back to the old fixed constant.
scaled_rtt_max(){ # $1=floor $2=mult $3=this-link's-rtt-floor(or empty) $4=ceiling -> effective cap
  [ -n "$3" ] || { echo "$4"; return; }          # bootstrap: the pre-2026-08-19 fixed constant, unchanged
  scaled_jitter_max "$1" "$2" "$3" "$4"
}
rtt_baseline_feed(){ # $1=hist $2=loss $3=avg $4=rtt_ceil — append iff admissible
  rtt_baseline_ok "$2" "$3" "$4" || return 1
  echo "$3" >> "$1"
  tail -n "${MESH_EGRESS_RHIST_N:-40}" "$1" > "$1.tmp" 2>/dev/null && mv "$1.tmp" "$1"
}
# AN UNREACHABLE IS A READING; A PARSE FAILURE IS BLINDNESS. Both rendered the single string
# "cannot-parse/unreachable" until 2026-08-19 — 55 SKIPs in one day with no way to tell a link that
# measured total loss from a probe that could not see. They are opposite facts: one says the node
# measured the link and found nothing coming back, the other says the node measured nothing at all.
# NOTE (deliberately NOT changed here, needs the operator's eye on paging): a parseable 100% loss is a
# READING of a dead link, yet quality_classify still returns SKIP for it, because the `-z "$avg"` guard
# fires before the `loss>0` rule — ping prints no rtt line when nothing comes back. Reclassifying it BAD
# is the honest verdict but it arms the pager on a dongle that produced 12 multi-run unreachable spans
# in 24h; the reason token below makes the population countable first.
qskip_reason(){ # $1=raw ping transcript (stdout+stderr) $2=parsed loss $3=parsed avg -> reason token
  local out="$1" loss="$2" avg="$3"
  if [ -n "$loss" ] && awk "BEGIN{exit !($loss>=100)}"; then echo "unreachable:total-loss"; return; fi
  if printf '%s' "$out" | grep -qiE 'network is unreachable|destination .*unreachable|name or service not known|temporary failure in name resolution'; then
    echo "unreachable:no-route"; return; fi
  if [ -z "$out" ]; then echo "blind:no-transcript"; return; fi
  if [ -n "$loss" ] && [ -z "$avg" ]; then echo "unreachable:no-rtt-stats"; return; fi
  echo "blind:cannot-parse"
}
# THE BASE RATE, BESIDE THE SAMPLE (window=inst+iv, CLAUDE.md). One run is 5 pings in a ~4s window every
# 180s — 2.2% of wallclock on a link that alternates floor and burst, so a single frame is a coin flip,
# and the check dash renders exactly ONE of them (`tail -1`). OK, BAD and SKIP therefore alternate frame
# to frame while the true incidence sat at 43-58% BAD for four days and nothing ever boarded it. The
# numbers were always in the log; only the fold was missing. Published on every QUALITY line and in its
# own state file so no consumer can mistake the narrow claim for the wide one.
# SKIP lines written BEFORE this fix carry the single legacy string and are therefore counted `blind` —
# honest (they cannot be told apart), and the split becomes real as the window rolls forward.
# Key names are deliberately NOT loss=/avg=/latency=/anthropic= — mesh-egress-stream:46 scrapes those
# with a GREEDY `.*`, so a second occurrence on the line would hand it the summary instead of the sample.
# AN ABSTENTION IS NOT A NEGATIVE VERDICT, AND THE TWO MAY NOT SHARE A DENOMINATOR
# (task:mesh-egress-health {#ced7623d}, 2026-08-28). `where=hop1-bad` is defined ~40 lines up as "the
# local leg is ALSO degraded, so the far read cannot be attributed past it" — an explicit I-CANNOT-TELL,
# which this fold nonetheless counted into the same numerator as a real far fault. Measured on this
# node's own tape the same day: of 260 BAD frames in the 480-sample window, 211 were `hop1-bad` and 49
# `beyond-hop1`, so 81% of the "egress is BAD" rate the check dash renders was the tool saying it could
# not see. On a node whose sole uplink is a stalling dongle that is STRUCTURAL, not a bad week.
# So the rate is now over the ATTRIBUTABLE window only — `beyond-hop1` BAD (the fault IS past the
# gateway) against OK (the whole path, far legs included, measured clean) — and every frame that cannot
# answer the egress question is counted apart in its own coverage term, `unattrib:`, beside the two that
# already existed (`unreach:` = the probe ran and nothing came back, `blind:` = the probe could not see).
# `hop1-unknown` and a pre-2026-08-17 BAD row carrying no `where=` at all are unattributable too: they
# genuinely cannot be placed, and counting them as far faults is the exact error being removed.
# The word BAD stays on the LOG LINE on purpose. It is a true verdict about PATH usability — the axis
# this section measures — and it is what mesh-homeostasis' breach detector and mesh-reflex-health's
# discharge table (:1469) read as a degradation EVENT; retyping it there would blind two consumers to a
# real fault to fix a rendering. What was wrong is the RATE and the label, and those are fixed here and
# in mesh-dash's two egress rows, which is every reader of this number.
quality_baserate(){ # $1=log $2=N samples -> one-line fold, or empty when there is nothing to fold
  local log="$1" n="$2" rows tot ok unr skips blind attrib unattrib graded p50 p90 first last span
  [ -f "$log" ] || return 0
  # LC_ALL=C grep -a, NEVER a plain grep: this tape carries NUL spans from crash-truncated appends (360
  # bytes of them, first at line 12057, measured 2026-08-19). GNU grep flags the whole file binary at the
  # first NUL and SUPPRESSES every matching line after it — plain `grep ' QUALITY '` emitted 5504 of 10238
  # lines here and its tail -1 was 21 days stale, so this fold would have been computed over a JULY window
  # and stamped with a live span. `grep -c` still returns the true count (only line OUTPUT is suppressed),
  # so a count-based self-check passes while the reader is blind. [[one-nul-blinds-plain-grep-for-the-whole-log]]
  rows=$(LC_ALL=C grep -a ' QUALITY ' "$log" 2>/dev/null | LC_ALL=C grep -av ' QUALITY DEGRADED-FUNCTIONAL ' | tail -n "$n")
  [ -n "$rows" ] || return 0
  # one pass, because the BAD class now has to be split by its `where=` token and a second grep over
  # the same rows is one more place for the two counts to drift apart
  read -r tot ok skips unr attrib unattrib < <(printf '%s\n' "$rows" | LC_ALL=C awk '
    { tot++ }
    / QUALITY BAD /  { if (index($0, "where=beyond-hop1")) attr++; else unattr++; next }
    / QUALITY OK /   { ok++; next }
    / QUALITY SKIP / { skip++; if ($0 ~ / QUALITY SKIP unreachable/) unr++ }
    END { printf "%d %d %d %d %d %d\n", tot+0, ok+0, skip+0, unr+0, attr+0, unattr+0 }')
  blind=$((skips - unr))
  graded=$((attrib + ok))   # the ATTRIBUTABLE window: frames that answer "are the far legs bad?"
  read -r p50 p90 < <(printf '%s\n' "$rows" | LC_ALL=C grep -aoE ' avg=[0-9.]+' | tr -d ' ' | cut -d= -f2 | sort -g \
    | awk '{a[NR]=$1} END{if(NR==0){print "? ?"; exit} i=int(NR*0.5+0.5); j=int(NR*0.9+0.5); if(i<1)i=1; if(j<1)j=1; printf "%.1f %.1f\n", a[i], a[j]}')
  first=$(printf '%s\n' "$rows" | head -1 | awk '{print $1}')
  last=$(printf '%s\n' "$rows" | tail -1 | awk '{print $1}')
  span=$(awk -v a="$first" -v b="$last" 'BEGIN{
    gsub(/[-:TZ]/," ",a); gsub(/[-:TZ]/," ",b);
    printf "%.1fh", (mktime(b)-mktime(a))/3600 }' 2>/dev/null)
  # graded=0 => nothing in the window could answer the question (all SKIP, or every BAD unattributable):
  # say so, never render a 0% BAD that reads as a clean link and never a 100% that reads as a dead one
  if [ "$graded" -gt 0 ]; then
    printf 'base=BAD:%.0f%%(%d/%d) unattrib:%d unreach:%d blind:%d rtt_p50=%s rtt_p90=%s basewin=%d@%s\n' \
      "$(awk -v b="$attrib" -v g="$graded" 'BEGIN{printf "%.4f", 100*b/g}')" "$attrib" "$graded" "$unattrib" "$unr" "$blind" "$p50" "$p90" "$tot" "${span:-?}"
  else
    printf 'base=BAD:n/a(0-attributable) unattrib:%d unreach:%d blind:%d rtt_p50=%s rtt_p90=%s basewin=%d@%s\n' \
      "$unattrib" "$unr" "$blind" "$p50" "$p90" "$tot" "${span:-?}"
  fi
}
quality_debounce(){ # $1=verdict $2=prevstate $3=badstreak $4=okstreak -> "newstate newbadstreak newokstreak action"
  local verdict="$1" prev="$2" bstreak="$3" ostreak="$4"    # symmetric hysteresis: BAD needs a streak to set,
  local dwell="${MESH_EGRESS_QOK_DWELL:-2}"                 # OK now ALSO needs a streak to clear — else a
  case "$verdict" in                                        # boundary-grazing signal flaps forever (same fix)
    SKIP) echo "$prev $bstreak $ostreak NONE" ;;
    BAD)
      bstreak=$((bstreak + 1))
      if [ "$bstreak" -ge 2 ]; then
        if [ "$prev" != BAD ]; then echo "BAD 0 0 ALERT-BAD"; else echo "BAD 0 0 NONE"; fi
      else
        echo "$prev $bstreak 0 NONE"
      fi ;;
    OK)
      ostreak=$((ostreak + 1))
      if [ "$prev" != BAD ]; then
        echo "OK 0 0 NONE"
      elif [ "$ostreak" -ge "$dwell" ]; then
        echo "OK 0 0 ALERT-OK"
      else
        echo "BAD 0 $ostreak NONE"
      fi ;;
  esac
}
# CHRONIC LATCH (chat-review/egress-quality-chronic-latch 2026-07-16): quality_debounce is honest
# PER EPISODE and spam PER CONDITION — a chronically flapping link IS edges (live: 55 board lines +
# ~20 operator TG pings in one day, all narrating the one already-tasked rtw88 deauth flap). Tier it:
# episodes 1..N-1 in the rolling window alert normally; the Nth LATCHES (its own board+TG edge);
# while latched, bad/ok pairs go to LOG + trace only, plus ONE daily [egress-chronic] board summary;
# a clean window (no alerted episode AND currently OK — a single long BAD episode outliving the
# window is not "clean") UNLATCHES with its own board+TG edge. Same tiering as mesh-cpu-throttle's
# episode/cooldown ladder and mesh-therm-watch's routine-flap→trace split.
chronic_latch(){ # $1=action(from debounce) $2=newstate $3=episodes-file $4=chronic-file $5=now-epoch -> "effective-action n-in-window"
  local act="$1" state="$2" ep="$3" ch="$4" now="$5"
  local win="${MESH_EGRESS_CHRONIC_WIN:-86400}" thr="${MESH_EGRESS_CHRONIC_N:-3}"
  [ "$act" = ALERT-BAD ] && echo "$now" >> "$ep"          # record alerted-episode onsets only —
  if [ -f "$ep" ]; then                                    # sub-hysteresis blips never count
    awk -v c="$((now - win))" '$1>=c' "$ep" > "$ep.tmp" && mv "$ep.tmp" "$ep"
  fi
  local n=0; [ -f "$ep" ] && n=$(wc -l < "$ep" | tr -d ' ')
  if [ -s "$ch" ]; then
    if [ "$n" -eq 0 ] && [ "$state" = OK ]; then rm -f "$ch"; echo "UNLATCH 0"; return; fi
    case "$act" in
      ALERT-BAD) echo "SUPPRESS-BAD $n" ;;
      ALERT-OK)  echo "SUPPRESS-OK $n" ;;
      *)         echo "NONE $n" ;;
    esac
  else
    if [ "$act" = ALERT-BAD ] && [ "$n" -ge "$thr" ]; then echo "$now" > "$ch"; echo "LATCH $n"; return; fi
    echo "${act:-NONE} $n"
  fi
}
# resolve_anth <first-code> <retry-code>: the EFFECTIVE api.anthropic.com HTTP code after the retry-once
# guard (chat-review/egress-403-single-sample-pages-operator). A 403 that CLEARS on the retry was a
# transient link-flap → return the recovered code (no geo-block, no operator page). A 403 that PERSISTS
# across both samples → return 403 (real geo-block, fast-fire preserved — one extra probe). A non-403
# first sample is returned unchanged (the retry never ran). Mirrors quality_debounce's streak-of-2: a
# lone dip never flips state.
# (resolve_anth() itself is defined ABOVE the identity lane — it is CALLED there, and bash resolves a
# function body at call time, so defining it here left the call site invoking a non-existent command.)
# ── ENANTIOSTASIS / functional invariance (LITERATURE live review 2026-07-28; grep 0 before this) ──
# Mangum & Towle, "Physiological adaptation to unstable environments", American Scientist 65:67 (1977)
# coined ENANTIOSTASIS: an open system conserves its FUNCTION under a fluctuating environment WITHOUT
# holding its internal state constant — the estuarine crab lets internal ion state float with salinity
# and adjusts to keep oxygen-binding FUNCTION. The still-live restatement: Arias, Acosta, Bertocchini &
# Fernández-Arias, "A functional approach to homeostatic regulation", Biology Direct 19:134 (2024,
# doi:10.1186/s13062-024-00577-9) — "assuming that the main role of blood glucose is to achieve a fixed
# steady-state value is misleading; the role of glucose is better understood in relation to the metabolic
# demands" — the regulated quantity is the FUNCTION a variable serves, not a fixed value of the variable
# (engineering framing: Moreddu, "Bioinspired Engineering beyond Homeostasis", Adv. Intell. Syst. 2026,
# doi:10.1002/aisy.202500435). APPLIED TOO LOOSELY here: the PATH-QUALITY lane below pages the operator
# on a PROXY VARIABLE — ICMP loss/rtt/jitter to $QHOST (1.1.1.1) — never on the FUNCTION egress exists to
# carry. This node's egress is chronically slow-but-working (~350KB/s NL VPN); its quality variable is
# permanently degraded while the function (an Anthropic API round-trip) is held — textbook enantiostasis,
# and exactly the flapper the chronic-latch below patches at the symptom. `anth` (measured once per run
# above, over THIS very egress path) is the function probe: a completed HTTP round-trip that is not a
# geo-block is POSITIVE proof the function survived the degraded path — and a better signal than pinging a
# different destination. Gate the operator PAGE on function-IMPAIRMENT, never on the variable alone.
# (egress_qfunc() itself is defined ABOVE the identity lane — bash needs the body before the call, and
# the identity lane's cause sidecar uses it too. One mapping, one site.)
qpage_gate(){ # $1=qverdict $2=qaction $3=qfunc -> effective qaction; downgrade the PAGE iff function PRESERVED
  # Enantiostasis: a quality-BAD whose FUNCTION is proven alive is not a fault to page — the variable
  # floated, the function held. Downgrade ALERT-BAD -> FUNC-OK (log/trace, no page, no chronic episode).
  # QSTATE/exit contract is UNCHANGED (consumers still read the honest BAD); only the human page moves.
  if [ "$1" = BAD ] && [ "$2" = ALERT-BAD ] && [ "$3" = PRESERVED ]; then echo FUNC-OK; else echo "$2"; fi
}
chronic_summary_due(){ # $1=summary-stamp-file $2=now-epoch -> rc0 if the daily latched summary is due
  local last; last=$(cat "$1" 2>/dev/null || echo 0)
  [ $(( $2 - last )) -ge "${MESH_EGRESS_CHRONIC_WIN:-86400}" ]
}
QHOST="${MESH_EGRESS_QHOST:-1.1.1.1}"
# RTT: was a FLAT 200ms constant ("~3.5x this node's measured ~57ms baseline, 2026-07-04") — a constant
# in the source rots, and by 2026-08-19 it was rendering avg=198.4ms OK on a link whose OK-population
# floor is ~48.9ms. Same shape as the jitter axis beside it: the fixed number is now the CEILING (and the
# non-circular baseline-admission gate), and the EFFECTIVE cap self-calibrates off this link's own
# observed floor. Env name unchanged, so an operator override still lands and a bootstrap node (no
# history yet) behaves exactly as before.
QRTT_CEIL="${MESH_EGRESS_RTT_MAX_MS:-200}"       # hard ceiling + admission gate (was QRTT_MAX)
QRTT_FLOOR="${MESH_EGRESS_RTT_FLOOR_MS:-25}"     # never call a path BAD below this, however fast its floor
QRTT_MULT="${MESH_EGRESS_RTT_MULT:-2}"           # effective cap = clamp(MULT * this link's own rtt floor, floor, ceil)
QJITTER_FLOOR="${MESH_EGRESS_JITTER_MAX_MS:-10}" # absolute floor / bootstrap default, ~8x IdeaPad's ~1.2ms baseline
QJITTER_MULT="${MESH_EGRESS_JITTER_MULT:-6}"     # effective cap = clamp(MULT * this node's own rolling jitter median, floor, ceil)
QFLOOR_PCT="${MESH_EGRESS_FLOOR_PCT:-10}"        # which percentile of the rolling history counts as "this link's floor"
QJITTER_CEIL="${MESH_EGRESS_JITTER_CEIL_MS:-100}" # hard ceiling: the scaled cap can never ratchet past this,
                                                 # and no sample above it may seed the baseline (see jitter_baseline_ok)
QSTATE="$HOME/.mesh/.egress-quality-state"
QSTREAK="$HOME/.mesh/.egress-quality-streak"
QOKSTREAK="$HOME/.mesh/.egress-quality-ok-streak"
QEPISODES="$HOME/.mesh/.egress-quality-episodes"     # rolling window of alerted-episode onset epochs
QCHRONIC="$HOME/.mesh/.egress-quality-chronic"       # non-empty = quality lane latched CHRONIC
QCHRONIC_SUM="$HOME/.mesh/.egress-quality-chronic-sum" # epoch of the last daily latched summary
QANNOUNCED="$HOME/.mesh/.egress-quality-announced"    # set iff a degradation was actually PAGED (pair_gate)
QJHIST="$HOME/.mesh/.egress-quality-jitter-hist" # rolling mdev samples from loss=0/RTT-fine reads only (fix: 2026-07-07)
QRHIST="$HOME/.mesh/.egress-quality-rtt-hist"   # rolling avg samples from loss=0/under-ceiling reads only
QBASE="$HOME/.mesh/.egress-quality-baserate"    # the rolling fold, so a consumer never reads one 4s frame as the link
qprev=$(cat "$QSTATE" 2>/dev/null || echo OK)
qstreak=$(cat "$QSTREAK" 2>/dev/null || echo 0)
qokstreak=$(cat "$QOKSTREAK" 2>/dev/null || echo 0)
QGW="${MESH_EGRESS_GW:-$(ip route show default 2>/dev/null | awk '/^default/{print $3; exit}')}"
QGW_RTT_MAX="${MESH_EGRESS_GW_RTT_MAX_MS:-50}"       # LAN scale, not WAN — see qlocalize()
QGW_JITTER_MAX="${MESH_EGRESS_GW_JITTER_MAX_MS:-20}"
# SIMULTANEOUS, not sequential: a loss burst is an event, and a hop1 probe fired AFTER the far probe
# finished would routinely come back clean for a burst that had already passed — the localization would
# then read `beyond-hop1` for a hop1 fault. Background the gateway leg, run the far leg in the
# foreground, reap. Same 5 packets / same ~4s window on both.
_gwout=""
if [ -n "$QGW" ]; then
  _gwtmp=$(mktemp "${TMPDIR:-/tmp}/mesh-egress-gw.XXXXXX" 2>/dev/null) || _gwtmp=""
  [ -n "$_gwtmp" ] && { timeout 15 ping -c5 -q -W2 "$QGW" >"$_gwtmp" 2>/dev/null & _gwpid=$!; }
fi
# 2>&1, not 2>/dev/null: "connect: Network is unreachable" is the ONLY evidence separating a link the
# node measured and found dead from a probe that never ran (qskip_reason). It cannot confuse the parser —
# parse_ping_quality greps for "% packet loss" and the rtt line, neither of which appears on stderr.
pingout=$(timeout 15 ping -c5 -q -W2 "$QHOST" 2>&1)
[ -n "${_gwpid:-}" ] && { wait "$_gwpid" 2>/dev/null; _gwout=$(cat "$_gwtmp" 2>/dev/null); rm -f "$_gwtmp"; }
read -r gloss gavg gmdev < <(printf '%s' "$_gwout" | parse_ping_quality)
read -r qloss qavg qmdev < <(printf '%s' "$pingout" | parse_ping_quality)

# Per-node jitter baseline: reads with loss=0, RTT within cap, and jitter within the FIXED ceiling. A
# distant node's normal 10-20ms jitter self-calibrates instead of being judged against a fleet-wide 10ms
# constant tuned to IdeaPad's ~1.2ms LAN-VPN baseline (chat-review/egress-quality-jitter-flap) — but only
# inside floor..ceil, so it can't ratchet itself into an unfalsifiable cap (egress-jitter-baseline-ratchet).
jitter_baseline_feed "$QJHIST" "$qloss" "$qavg" "$qmdev" "$QRTT_CEIL" "$QJITTER_CEIL"
rtt_baseline_feed "$QRHIST" "$qloss" "$qavg" "$QRTT_CEIL"
# The FLOOR of each rolling history, not its median — this link is bimodal (floor vs burst, ~50/50), and
# a median of a bimodal population calibrates to neither mode. See hist_pctile's header for the measurement.
qjfloor=$(hist_pctile "$QJHIST" "$QFLOOR_PCT" 5)
qrfloor=$(hist_pctile "$QRHIST" "$QFLOOR_PCT" 5)
QJITTER_MAX=$(scaled_jitter_max "$QJITTER_FLOOR" "$QJITTER_MULT" "$qjfloor" "$QJITTER_CEIL")
QRTT_MAX=$(scaled_rtt_max "$QRTT_FLOOR" "$QRTT_MULT" "$qrfloor" "$QRTT_CEIL")

qverdict=$(quality_classify "$qloss" "$qavg" "$qmdev" "$QRTT_MAX" "$QJITTER_MAX")
# SKIP is two opposite facts (a measured-dead link vs a blind probe); name which one. Empty on OK/BAD.
qskip=""; [ "$qverdict" = SKIP ] && qskip=$(qskip_reason "$pingout" "$qloss" "$qavg")
# WHERE, not just whether. `n/a` on an OK/SKIP read (nothing to localize); on BAD it names the leg.
qwhere=$(qlocalize "$qverdict" "$gloss" "$gavg" "$gmdev" "$QGW_RTT_MAX" "$QGW_JITTER_MAX")
# NOT "loss="/"avg=" — mesh-egress-stream:46 scrapes those keys with a GREEDY `.*`, so a second
# occurrence on the line would silently hand it the gateway's numbers as the egress path's.
qhop1="hop1=${QGW:-none}:${gloss:-?}%/${gavg:-?}ms/${gmdev:-?}ms"
read -r newstate newstreak newokstreak qaction < <(quality_debounce "$qverdict" "$qprev" "$qstreak" "$qokstreak")
echo "$newstate" > "$QSTATE"; echo "$newstreak" > "$QSTREAK"; echo "$newokstreak" > "$QOKSTREAK"
# ENANTIOSTASIS page-gate (see egress_qfunc above): reserve the operator PAGE for a degraded path whose
# FUNCTION is ALSO impaired. `anth` is this run's Anthropic round-trip over the same egress path; PRESERVED
# = live proof the function survived, so a quality-BAD page is downgraded to log/trace (FUNC-OK). This is
# gated on POSITIVE evidence only — UNKNOWN/IMPAIRED keep the page (no faked all-clear). QSTATE stays BAD.
qfunc=$(egress_qfunc "$anth")
qaction=$(qpage_gate "$qverdict" "$qaction" "$qfunc")
nowep=$(date -u +%s)
read -r qeff qn24 < <(chronic_latch "$qaction" "$newstate" "$QEPISODES" "$QCHRONIC" "$nowep")
# PAIRING, after every suppressor (chat-review/egress-board-edges-are-gated-asymmetrically). qpage_gate
# and chronic_latch each eat the ALERT-BAD edge and neither touched its ALERT-OK edge, so the board
# carried 17 "path restored" posts against 1 bad post on 2026-08-29 alone. The pair cannot be closed
# inside either suppressor — it is closed HERE, once, against a flag only a real page sets.
qeff=$(pair_gate "$qeff" "$QANNOUNCED")
# THE BASE RATE, computed over the samples ALREADY on the tape (this run's line is appended below, so the
# window is a well-defined prior span, never a self-reference). Published three ways because each has a
# different reader: appended to every QUALITY line (forensics), written to $QBASE (the check dash, which
# renders `tail -1` of the log and would clip a long suffix), and printed by --quality-summary (a human).
qbase=$(quality_baserate "$LOG" "${MESH_EGRESS_BASE_N:-480}")
[ -n "$qbase" ] && printf '%s %s\n' "$ts" "$qbase" > "$QBASE"
case "$qverdict" in
  SKIP)
    # `unreachable:*` is a READING (the probe ran, nothing came back); `blind:*` is BLINDNESS (the probe
    # itself failed). One string said both until 2026-08-19 — 55 SKIPs in a day, none of them countable.
    echo "$ts QUALITY SKIP ${qskip:-blind:unclassified} host=$QHOST ${qbase:-base=n/a}" >> "$LOG" ;;   # NOT broken — don't alert, mirrors identity SKIP
  BAD)
    echo "$ts QUALITY BAD where=$qwhere (state=$newstate streak=$qstreak/2) loss=${qloss}% avg=${qavg}ms mdev=${qmdev:-?}ms host=$QHOST rmax=${QRTT_MAX}ms jmax=${QJITTER_MAX}ms $qhop1 qfunc=$qfunc anthropic=$anth ${qbase:-base=n/a}" >> "$LOG"
    case "$qeff" in
      FUNC-OK) echo "$ts QUALITY DEGRADED-FUNCTIONAL where=$qwhere (enantiostasis: variable degraded, function held) loss=${qloss}% avg=${qavg}ms jitter=${qmdev:-?}ms $qhop1 anthropic=$anth — page suppressed" >> "$LOG"
               command -v mesh-trace >/dev/null 2>&1 && mesh-trace "egress-quality DEGRADED-FUNCTIONAL: path to $QHOST degraded at $qwhere (loss=${qloss}% avg=${qavg}ms jitter=${qmdev:-?}ms) but Anthropic round-trip alive (anth=$anth) — no page" >/dev/null 2>&1 ;;
      ALERT-BAD) alert "[egress-quality-bad] path to $QHOST degraded at $qwhere AND function impaired: loss=${qloss}% avg=${qavg}ms jitter=${qmdev:-?}ms (self-calibrated thresholds: loss>0 or avg>${QRTT_MAX}ms or jitter>${QJITTER_MAX}ms; this link's floors rtt=${qrfloor:-bootstrap} jitter=${qjfloor:-bootstrap}); anthropic=$anth (qfunc=$qfunc) $qhop1 — the path itself is degraded and inference is at risk." \
                       "⚠️ EGRESS PATH degraded ($qwhere) + inference at risk: loss=${qloss}% avg=${qavg}ms jitter=${qmdev:-?}ms to $QHOST, anthropic=$anth." ;;
      LATCH)     alert "[egress-chronic] quality lane LATCHED: $qn24 alerted episodes in the last 24h (this one: loss=${qloss}% avg=${qavg}ms jitter=${qmdev:-?}ms to $QHOST) — chronic flapper; further bad/ok pairs go to log/trace only + one daily summary here; unlatch after a clean 24h." \
                       "⚠️ EGRESS PATH chronically flapping: $qn24 degradation episodes in 24h — muting per-episode pings; will notify when it holds a clean 24h."
                 echo "$nowep" > "$QCHRONIC_SUM" ;;
      SUPPRESS-BAD) command -v mesh-trace >/dev/null 2>&1 && mesh-trace "egress-quality chronic-suppressed BAD: loss=${qloss}% avg=${qavg}ms mdev=${qmdev:-?}ms ($qn24 episodes/24h)" >/dev/null 2>&1 ;;
    esac ;;
  OK)
    echo "$ts QUALITY OK loss=${qloss}% avg=${qavg}ms mdev=${qmdev:-?}ms host=$QHOST rmax=${QRTT_MAX}ms jmax=${QJITTER_MAX}ms $qhop1 ${qbase:-base=n/a}" >> "$LOG"
    case "$qeff" in
      ALERT-OK) alert "[egress-quality-ok] path to $QHOST restored: loss=${qloss}% avg=${qavg}ms jitter=${qmdev:-?}ms." \
                      "✅ EGRESS PATH restored: loss=${qloss}% avg=${qavg}ms jitter=${qmdev:-?}ms to $QHOST." ;;
      UNPAIRED-OK) echo "$ts QUALITY OK-UNPAIRED loss=${qloss}% avg=${qavg}ms mdev=${qmdev:-?}ms host=$QHOST — recovery page suppressed: the degradation it closes was never announced (downgraded by the function gate, or chronic-muted)" >> "$LOG"
                   command -v mesh-trace >/dev/null 2>&1 && mesh-trace "egress-quality UNPAIRED-OK: path to $QHOST back to loss=${qloss}% avg=${qavg}ms — no recovery page, its BAD edge was never paged" >/dev/null 2>&1 ;;
      SUPPRESS-OK) command -v mesh-trace >/dev/null 2>&1 && mesh-trace "egress-quality chronic-suppressed OK: loss=${qloss}% avg=${qavg}ms mdev=${qmdev:-?}ms ($qn24 episodes/24h)" >/dev/null 2>&1 ;;
    esac ;;
esac
# UNLATCH surfaces on whatever run completes the clean window (usually a quiet OK/NONE run)
[ "$qeff" = UNLATCH ] && alert "[egress-chronic] quality lane UNLATCHED: clean 24h with no alerted episode — per-episode alerts re-armed." \
                               "✅ EGRESS PATH stable again: clean 24h after chronic flapping — per-episode alerts re-armed."
# while latched: ONE board summary per window (no TG) so the condition stays visible without spam
if [ -s "$QCHRONIC" ] && chronic_summary_due "$QCHRONIC_SUM" "$nowep"; then
  command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="egress@$(hostname)" mesh-chat "[egress-chronic] quality lane still latched: $qn24 alerted episode(s) in the last 24h — pairs suppressed to log/trace; unlatch after a clean 24h." >/dev/null 2>&1
  echo "$nowep" > "$QCHRONIC_SUM"
fi

# DERP-lane trend (wire-path-watch consumer 2026-07-05): fold mesh-path-watch's hourly netweather
# sample into THIS log as a trend datapoint — DERP latency rides the same router-VPN as all host
# traffic, so its drift is an egress-tunnel quality proxy on a third axis (identity=country,
# quality=RTT-to-1.1.1.1, DERP=relay-infra RTT). ALERTING on it stays with mesh-path-watch
# (single alert owner — no double-boarding the same signal); this line exists so one log
# correlates all three axes over time for forensics. De-duped by sample ts (netweather is
# hourly, this reflex is */3 — without the ts gate it would re-log the same sample 20×).
PWTAPE="${MESH_PATH_WATCH_TAPE:-$HOME/.mesh/path-watch.log}"
DERP_LAST="$HOME/.mesh/.egress-derp-last"
nw=$(grep ' netweather ' "$PWTAPE" 2>/dev/null | tail -1)
if [ -n "$nw" ] && [ "${nw%% *}" != "$(cat "$DERP_LAST" 2>/dev/null)" ]; then
  echo "$ts DERP ${nw#* netweather } (sample ${nw%% *})" >> "$LOG"
  printf '%s\n' "${nw%% *}" > "$DERP_LAST"
fi

# exit reflects IDENTITY state only (unchanged contract — mesh-egress-stream/mesh-stress/mesh-net-
# triage/mesh-mesh-state all key off $STATE's OK/BAD/SKIP; quality is a parallel signal, not folded
# into this exit code, so no existing consumer needs to change)
[ "$(cat "$STATE" 2>/dev/null)" = BAD ] && exit 1 || exit 0
