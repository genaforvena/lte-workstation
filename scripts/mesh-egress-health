#!/usr/bin/env bash
# mesh-egress-health — detect EGRESS QUALITY, not just "internet up" (blind spot from the 2026-06-09
# outage). Checks: api.anthropic.com==403 => definitively BAD (geo-block); else if egress country
# unverifiable (ifconfig.co down) => SKIP (NOT broken); else country_iso==expected => OK, mismatch => BAD.
# smoke-test: --test checks curl available + state dir writable
# Read-only; alerts operator's PERSONAL telegram only. Edge-triggered (no spam).
# reflex-cadence: */3 * * * *
# (orphaned in the 2026-06-21 cron-retirement reorg → unwired 3h, monitoring of the operator's CRITICAL
# NL-VPN egress went silently dead AND reflex-health stopped watching it — it only watches scheduled
# reflexes. A reflex-cadence header lets mesh-autowire re-pick it after any reorg. See reflex-cadence-or-reorg-orphans-it.)
set -uo pipefail
[ "${1:-}" = --test ] && {
  command -v curl >/dev/null 2>&1 || { echo "smoke-test: FAIL (no curl)"; exit 1; }
  command -v python3 >/dev/null 2>&1 || { echo "smoke-test: FAIL (no python3)"; exit 1; }
  [ -d "$HOME/.mesh" ] || { echo "smoke-test: FAIL (no ~/.mesh)"; exit 1; }
  # dry-run: feed mock ifconfig.co JSON through the parser pipeline, validate iso+ip extraction
  mock='{"ip":"1.2.3.4","country_iso":"NL","country":"Netherlands"}'
  iso=$(printf '%s' "$mock" | python3 -c 'import sys,json;print(json.load(sys.stdin).get("country_iso",""))' 2>/dev/null)
  [ "$iso" = "NL" ] || { echo "smoke-test: FAIL (json parser: expected NL, got $iso)"; exit 1; }
  ip=$(printf '%s' "$mock" | python3 -c 'import sys,json;print(json.load(sys.stdin).get("ip",""))' 2>/dev/null)
  [ "$ip" = "1.2.3.4" ] || { echo "smoke-test: FAIL (json parser: expected 1.2.3.4, got $ip)"; exit 1; }
  # PATH QUALITY parser + classifier (wire-egress-path-quality 2026-07-04) — dry-run against a mock
  # `ping -c5 -q` transcript, no live ping. Loads the functions defined below via a subshell source
  # (bash requires the function bodies to exist before calling — they're defined after this --test
  # block returns, so source just the function definitions from this file).
  . <(sed -n '/^parse_ping_quality(){/,/^}/p;/^quality_classify(){/,/^}/p;/^scaled_jitter_max(){/,/^}/p;/^quality_debounce(){/,/^}/p' "$0")
  _mock_clean='PING 1.1.1.1 (1.1.1.1) 56(84) bytes of data.

--- 1.1.1.1 ping statistics ---
5 packets transmitted, 5 received, 0% packet loss, time 4005ms
rtt min/avg/max/mdev = 55.123/57.456/60.789/1.234 ms'
  read -r ql qa qm < <(printf '%s' "$_mock_clean" | parse_ping_quality)
  [ "$ql" = "0" ] && [ "$qa" = "57.456" ] && [ "$qm" = "1.234" ] || { echo "smoke-test: FAIL (ping quality parser clean: got loss=$ql avg=$qa mdev=$qm)"; exit 1; }
  _mock_lossy='PING 1.1.1.1 (1.1.1.1) 56(84) bytes of data.

--- 1.1.1.1 ping statistics ---
5 packets transmitted, 3 received, 40% packet loss, time 4005ms
rtt min/avg/max/mdev = 55.123/180.456/300.789/60.234 ms'
  read -r ql2 qa2 qm2 < <(printf '%s' "$_mock_lossy" | parse_ping_quality)
  [ "$ql2" = "40" ] && [ "$qa2" = "180.456" ] && [ "$qm2" = "60.234" ] || { echo "smoke-test: FAIL (ping quality parser lossy: got loss=$ql2 avg=$qa2 mdev=$qm2)"; exit 1; }
  qf=0
  [ "$(quality_classify 0 57.456 1.234 200 10)" = OK ]   || { echo "  FAIL: clean baseline should classify OK"; qf=1; }
  [ "$(quality_classify 40 180.456 60.234 200 10)" = BAD ] || { echo "  FAIL: any packet loss>0 should classify BAD"; qf=1; }
  [ "$(quality_classify 0 250 2 200 10)" = BAD ]         || { echo "  FAIL: RTT blowout past rmax should classify BAD"; qf=1; }
  [ "$(quality_classify 0 50 15 200 10)" = BAD ]         || { echo "  FAIL: jitter blowout past jmax should classify BAD"; qf=1; }
  [ "$(quality_classify '' '' '' 200 10)" = SKIP ]       || { echo "  FAIL: unparsed/unreachable ping should classify SKIP, not BAD (don't alert on a parse miss)"; qf=1; }
  [ "$qf" = 0 ] || { echo "smoke-test: FAIL (quality_classify decision drifted)"; exit 1; }
  # Baseline-relative jitter cap (chat-review/egress-quality-jitter-flap part b): no history -> floor;
  # a distant node's own rolling median scales the cap so its normal jitter isn't judged by IdeaPad's yardstick
  [ "$(scaled_jitter_max 10 6 '')" = "10" ]  || { echo "smoke-test: FAIL (scaled_jitter_max: no history should return floor)"; exit 1; }
  [ "$(scaled_jitter_max 10 6 15)" = "90" ]  || { echo "smoke-test: FAIL (scaled_jitter_max: 15ms median*6 should be 90, got $(scaled_jitter_max 10 6 15))"; exit 1; }
  [ "$(scaled_jitter_max 10 6 1)" = "10" ]   || { echo "smoke-test: FAIL (scaled_jitter_max: tiny median should still floor at 10)"; exit 1; }
  # Symmetric hysteresis debounce (chat-review/egress-quality-jitter-flap part a): oscillating jitter
  # (verdicts OK,BAD,OK,BAD from a 9/11/9/11ms fixture) must NOT flap — BAD needs a streak of 2 to set,
  # so a single-sample dip either way never flips state or fires an alert.
  df=0; st=OK; bs=0; os=0
  for v in OK BAD OK BAD; do
    read -r st bs os act < <(quality_debounce "$v" "$st" "$bs" "$os")
    [ "$act" = NONE ] || { echo "  FAIL: oscillating 9/11/9/11ms fixture fired '$act' on verdict=$v (expected no flap)"; df=1; }
  done
  [ "$st" = OK ] || { echo "  FAIL: oscillating fixture should stay OK (never accumulates 2 consecutive BAD)"; df=1; }
  # genuine sustained badness still alerts within 2 reads
  st=OK; bs=0; os=0
  read -r st bs os act < <(quality_debounce BAD "$st" "$bs" "$os")
  [ "$act" = NONE ] && [ "$st" = OK ] || { echo "  FAIL: single BAD read should not yet alert"; df=1; }
  read -r st bs os act < <(quality_debounce BAD "$st" "$bs" "$os")
  [ "$act" = ALERT-BAD ] && [ "$st" = BAD ] || { echo "  FAIL: 2nd consecutive BAD should alert within 2 reads (got action=$act state=$st)"; df=1; }
  # recovery needs 2 consecutive OK reads (a lone dip must not clear the alarm)
  read -r st bs os act < <(quality_debounce OK "$st" "$bs" "$os")
  [ "$act" = NONE ] && [ "$st" = BAD ] || { echo "  FAIL: single OK read after BAD should not yet clear (got action=$act state=$st)"; df=1; }
  read -r st bs os act < <(quality_debounce OK "$st" "$bs" "$os")
  [ "$act" = ALERT-OK ] && [ "$st" = OK ] || { echo "  FAIL: 2nd consecutive OK should clear+alert (got action=$act state=$st)"; df=1; }
  [ "$df" = 0 ] || { echo "smoke-test: FAIL (jitter-flap hysteresis drifted)"; exit 1; }
  # DERP-lane trend fold (wire-path-watch consumer 2026-07-05): newest netweather line extracted,
  # de-duped by its own sample ts — asserts the tape vocab contract with mesh-path-watch
  # ([[cross-sense-vocab-contract]]: this grep breaks silently if that tool renames the token).
  _pwt=$(mktemp)
  printf '2026-07-05T10:00:00Z netweather udp=true derp=Amsterdam lat_ms=54.5\n2026-07-05T11:00:00Z netweather udp=true derp=Amsterdam lat_ms=98.2\n' > "$_pwt"
  _nw=$(grep ' netweather ' "$_pwt" | tail -1)
  { [ "${_nw%% *}" = "2026-07-05T11:00:00Z" ] && printf '%s' "$_nw" | grep -q 'lat_ms=98.2'; } \
    || { rm -f "$_pwt"; echo "smoke-test: FAIL (netweather trend extract: '$_nw')"; exit 1; }
  rm -f "$_pwt"
  echo "smoke-test: ok (identity json parser + path-quality parser/classifier + jitter-flap hysteresis + netweather trend extract verified)"; exit 0
}
# robust HOME for cron (review #15)
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
export PATH="$HOME/.local/bin:$PATH"
# Per-node egress POLICY (e.g. MESH_EGRESS_ISO=US on a US-uplink node like phaedra, whose correct egress
# is its OWN public IP, not the home NL VPN). Lives in a config file, NOT the crontab — so mesh-reflexes
# (which rewrites the crontab) can't revert it. No file ⇒ unchanged NL default. (2026-06-15: phaedra was
# flapping [egress-bad]/[egress-ok] because it expected NL while correctly egressing US.)
[ -f "$HOME/.mesh/egress.conf" ] && . "$HOME/.mesh/egress.conf" 2>/dev/null
EXPECT="${MESH_EGRESS_ISO:-NL}"
LOG="$HOME/.mesh/egress-health.log"; STATE="$HOME/.mesh/.egress-state"
j=$(curl -s -m10 https://ifconfig.co/json 2>/dev/null)
iso=$(printf '%s' "$j" | python3 -c 'import sys,json;print(json.load(sys.stdin).get("country_iso",""))' 2>/dev/null)
ip=$(printf  '%s' "$j" | python3 -c 'import sys,json;print(json.load(sys.stdin).get("ip",""))' 2>/dev/null)
anth=$(curl -s -m10 -o /dev/null -w '%{http_code}' https://api.anthropic.com/v1/messages 2>/dev/null)
ts=$(date -u +%FT%TZ); prev=$(cat "$STATE" 2>/dev/null || echo OK)
# Geo-block is the mesh's CORE vulnerability (RU egress → Anthropic 403 → cloud minds die), so make it
# a first-class BOARD alarmer (visible to steward/minds + reliability pairing) AND a TG ping — in
# ENGLISH (operator preference). $1 = board tag line, $2 = TG message.
alert(){
  command -v mesh-chat >/dev/null 2>&1 && MESH_WHO="egress@$(hostname)" mesh-chat "$1" >/dev/null 2>&1
  command -v mesh-tg   >/dev/null 2>&1 && mesh-tg "$2" >/dev/null 2>&1
}
if [ "$anth" = "403" ]; then
  echo BAD > "$STATE"; echo "$ts BAD anthropic=403 (geo-blocked) ip=$ip iso=$iso" >> "$LOG"
  [ "$prev" != BAD ] && alert "[egress-bad] Anthropic 403 — egress GEO-BLOCKED (scoped VPN dropped); cloud minds at risk. Fix: mesh-fix-egress." \
                              "🚨 EGRESS DOWN: Anthropic 403 (geo-blocked) — the scoped-routing VPN dropped; run mesh-fix-egress."
elif [ -z "$iso" ]; then
  echo "$ts SKIP cannot-verify (ifconfig.co unreachable) anthropic=$anth" >> "$LOG"   # NOT broken — don't alert
elif [ "$iso" = "$EXPECT" ]; then
  echo OK > "$STATE"; echo "$ts OK egress=$iso ip=$ip anthropic=$anth" >> "$LOG"
  [ "$prev" = BAD ] && alert "[egress-ok] egress restored: $ip ($iso), Anthropic=$anth." \
                            "✅ EGRESS restored: $ip ($iso), Anthropic=$anth."
else
  echo BAD > "$STATE"; echo "$ts BAD egress=$iso (want $EXPECT) ip=$ip anthropic=$anth" >> "$LOG"
  [ "$prev" != BAD ] && alert "[egress-bad] egress=$iso (expected $EXPECT) — WRONG country, geo-block risk. Fix: mesh-fix-egress." \
                              "🚨 EGRESS DOWN: exit=$iso (expected $EXPECT). Run mesh-fix-egress."
fi

# PATH QUALITY (RTT/jitter/loss) — literature find 2026-07-04 (wire-egress-path-quality, spec:
# knowledge/capability-egress-path-quality-20260704.md). Everything above answers "am I egressing
# through the right country?" — never "is that path actually usable right now?" A degraded router-
# LAN VPN tunnel or ISP congestion can hold correct identity while RTT/loss climbs, invisible to
# every check above (verified 0 tools mesh-wide cover this axis: mesh-net-io/mesh-lan-health/
# mesh-conntrack-load are LAN-local/socket-count scope, mesh-lan-jitter is gateway-hop only, not
# WAN). Extension not a sibling tool (spec's cheaper option) — reuses this file's LOG/alert()/cron
# cadence. OWN STATE + own board tags so a quality blip never masks or gets masked by the identity
# (geo-block) alarm above — genuinely orthogonal failure modes on the same substrate.
parse_ping_quality(){ # stdin = `ping -c5 -q` transcript -> echoes "loss_pct avg_ms mdev_ms" (mdev may be empty)
  local out loss stats avg mdev
  out=$(cat)
  loss=$(printf '%s\n' "$out" | grep -oE '[0-9]+(\.[0-9]+)?% packet loss' | grep -oE '^[0-9]+(\.[0-9]+)?')
  stats=$(printf '%s\n' "$out" | grep -oE 'rtt [a-z/]+ = [0-9.]+/[0-9.]+/[0-9.]+/[0-9.]+' | sed 's#.*= ##')
  avg=$(printf '%s' "$stats" | cut -d/ -f2)
  mdev=$(printf '%s' "$stats" | cut -d/ -f4 | awk '{print $1}')
  printf '%s %s %s\n' "${loss:-}" "${avg:-}" "${mdev:-}"
}
quality_classify(){ # $1=loss% $2=avg_ms $3=mdev_ms $4=rtt_max_ms $5=jitter_max_ms -> OK|BAD|SKIP
  local loss="$1" avg="$2" mdev="$3" rmax="$4" jmax="$5"
  if [ -z "$loss" ] || [ -z "$avg" ]; then echo SKIP; return; fi
  if awk "BEGIN{exit !($loss>0)}"; then echo BAD; return; fi
  if awk "BEGIN{exit !($avg>$rmax)}"; then echo BAD; return; fi
  if [ -n "$mdev" ] && awk "BEGIN{exit !($mdev>$jmax)}"; then echo BAD; return; fi
  echo OK
}
scaled_jitter_max(){ # $1=floor_ms $2=multiplier $3=this-node's-median-mdev(or empty) -> effective jitter cap
  local floor="$1" mult="$2" median="$3"                   # a fleet-wide constant tuned to one node's LAN-VPN
  [ -z "$median" ] && { echo "$floor"; return; }            # baseline crying-wolfs on a distant node's normal
  awk -v f="$floor" -v m="$mult" -v med="$median" 'BEGIN{v=med*m; print (v>f)?v:f}'  # jitter (chat-review/egress-quality-jitter-flap)
}
quality_debounce(){ # $1=verdict $2=prevstate $3=badstreak $4=okstreak -> "newstate newbadstreak newokstreak action"
  local verdict="$1" prev="$2" bstreak="$3" ostreak="$4"    # symmetric hysteresis: BAD needs a streak to set,
  local dwell="${MESH_EGRESS_QOK_DWELL:-2}"                 # OK now ALSO needs a streak to clear — else a
  case "$verdict" in                                        # boundary-grazing signal flaps forever (same fix)
    SKIP) echo "$prev $bstreak $ostreak NONE" ;;
    BAD)
      bstreak=$((bstreak + 1))
      if [ "$bstreak" -ge 2 ]; then
        if [ "$prev" != BAD ]; then echo "BAD 0 0 ALERT-BAD"; else echo "BAD 0 0 NONE"; fi
      else
        echo "$prev $bstreak 0 NONE"
      fi ;;
    OK)
      ostreak=$((ostreak + 1))
      if [ "$prev" != BAD ]; then
        echo "OK 0 0 NONE"
      elif [ "$ostreak" -ge "$dwell" ]; then
        echo "OK 0 0 ALERT-OK"
      else
        echo "BAD 0 $ostreak NONE"
      fi ;;
  esac
}
QHOST="${MESH_EGRESS_QHOST:-1.1.1.1}"
QRTT_MAX="${MESH_EGRESS_RTT_MAX_MS:-200}"        # ~3.5x this node's measured ~57ms baseline (2026-07-04)
QJITTER_FLOOR="${MESH_EGRESS_JITTER_MAX_MS:-10}" # absolute floor / bootstrap default, ~8x IdeaPad's ~1.2ms baseline
QJITTER_MULT="${MESH_EGRESS_JITTER_MULT:-6}"     # effective cap = max(floor, MULT * this node's own rolling jitter median)
QSTATE="$HOME/.mesh/.egress-quality-state"
QSTREAK="$HOME/.mesh/.egress-quality-streak"
QOKSTREAK="$HOME/.mesh/.egress-quality-ok-streak"
QJHIST="$HOME/.mesh/.egress-quality-jitter-hist" # rolling mdev samples from loss=0/RTT-fine reads only (fix: 2026-07-07)
qprev=$(cat "$QSTATE" 2>/dev/null || echo OK)
qstreak=$(cat "$QSTREAK" 2>/dev/null || echo 0)
qokstreak=$(cat "$QOKSTREAK" 2>/dev/null || echo 0)
pingout=$(timeout 15 ping -c5 -q -W2 "$QHOST" 2>/dev/null)
read -r qloss qavg qmdev < <(printf '%s' "$pingout" | parse_ping_quality)

# Per-node jitter baseline, built ONLY from reads with loss=0 and RTT within cap — decoupled from the
# jitter cap itself, else a too-tight cap can never accumulate the history needed to loosen itself.
# A distant node's normal 10-20ms jitter self-calibrates instead of being judged against a fleet-wide
# 10ms constant tuned to IdeaPad's ~1.2ms LAN-VPN baseline (chat-review/egress-quality-jitter-flap).
qmedian=""
if [ -n "$qloss" ] && [ -n "$qavg" ] && [ -n "$qmdev" ] \
   && awk "BEGIN{exit !($qloss==0)}" && awk "BEGIN{exit !($qavg<=$QRTT_MAX)}"; then
  echo "$qmdev" >> "$QJHIST"
  tail -n 20 "$QJHIST" > "$QJHIST.tmp" 2>/dev/null && mv "$QJHIST.tmp" "$QJHIST"
fi
[ -f "$QJHIST" ] && [ "$(wc -l < "$QJHIST")" -ge 5 ] \
  && qmedian=$(sort -n "$QJHIST" | awk '{a[NR]=$1} END{print (NR%2==1)?a[(NR+1)/2]:(a[int(NR/2)]+a[int(NR/2)+1])/2}')
QJITTER_MAX=$(scaled_jitter_max "$QJITTER_FLOOR" "$QJITTER_MULT" "$qmedian")

qverdict=$(quality_classify "$qloss" "$qavg" "$qmdev" "$QRTT_MAX" "$QJITTER_MAX")
read -r newstate newstreak newokstreak qaction < <(quality_debounce "$qverdict" "$qprev" "$qstreak" "$qokstreak")
echo "$newstate" > "$QSTATE"; echo "$newstreak" > "$QSTREAK"; echo "$newokstreak" > "$QOKSTREAK"
case "$qverdict" in
  SKIP)
    echo "$ts QUALITY SKIP cannot-parse/unreachable ($QHOST)" >> "$LOG" ;;   # NOT broken — don't alert, mirrors identity SKIP
  BAD)
    echo "$ts QUALITY BAD (state=$newstate streak=$qstreak/2) loss=${qloss}% avg=${qavg}ms mdev=${qmdev:-?}ms host=$QHOST jmax=${QJITTER_MAX}ms" >> "$LOG"
    [ "$qaction" = ALERT-BAD ] && alert "[egress-quality-bad] path to $QHOST degraded: loss=${qloss}% avg=${qavg}ms jitter=${qmdev:-?}ms (thresholds: loss>0 or avg>${QRTT_MAX}ms or jitter>${QJITTER_MAX}ms) — identity may still be correct, the path itself is degraded." \
                                        "⚠️ EGRESS PATH degraded: loss=${qloss}% avg=${qavg}ms jitter=${qmdev:-?}ms to $QHOST." ;;
  OK)
    echo "$ts QUALITY OK loss=${qloss}% avg=${qavg}ms mdev=${qmdev:-?}ms host=$QHOST jmax=${QJITTER_MAX}ms" >> "$LOG"
    [ "$qaction" = ALERT-OK ] && alert "[egress-quality-ok] path to $QHOST restored: loss=${qloss}% avg=${qavg}ms jitter=${qmdev:-?}ms." \
                                       "✅ EGRESS PATH restored: loss=${qloss}% avg=${qavg}ms jitter=${qmdev:-?}ms to $QHOST." ;;
esac

# DERP-lane trend (wire-path-watch consumer 2026-07-05): fold mesh-path-watch's hourly netweather
# sample into THIS log as a trend datapoint — DERP latency rides the same router-VPN as all host
# traffic, so its drift is an egress-tunnel quality proxy on a third axis (identity=country,
# quality=RTT-to-1.1.1.1, DERP=relay-infra RTT). ALERTING on it stays with mesh-path-watch
# (single alert owner — no double-boarding the same signal); this line exists so one log
# correlates all three axes over time for forensics. De-duped by sample ts (netweather is
# hourly, this reflex is */3 — without the ts gate it would re-log the same sample 20×).
PWTAPE="${MESH_PATH_WATCH_TAPE:-$HOME/.mesh/path-watch.log}"
DERP_LAST="$HOME/.mesh/.egress-derp-last"
nw=$(grep ' netweather ' "$PWTAPE" 2>/dev/null | tail -1)
if [ -n "$nw" ] && [ "${nw%% *}" != "$(cat "$DERP_LAST" 2>/dev/null)" ]; then
  echo "$ts DERP ${nw#* netweather } (sample ${nw%% *})" >> "$LOG"
  printf '%s\n' "${nw%% *}" > "$DERP_LAST"
fi

# exit reflects IDENTITY state only (unchanged contract — mesh-egress-stream/mesh-stress/mesh-net-
# triage/mesh-mesh-state all key off $STATE's OK/BAD/SKIP; quality is a parallel signal, not folded
# into this exit code, so no existing consumer needs to change)
[ "$(cat "$STATE" 2>/dev/null)" = BAD ] && exit 1 || exit 0
