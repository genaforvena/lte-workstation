#!/usr/bin/env bash
# mesh-egress-health — detect EGRESS QUALITY, not just "internet up". The 2026-06-09 outage hid because
# selfcare checked inet=up/DOWN while egress was silently wrong-country (RU)->Anthropic 403->steward dark.
# Checks ACTUAL egress: country_iso == expected AND api.anthropic.com != 403. Read-only; alerts the
# operator's PERSONAL telegram only (mesh-tg = CHAT_ID 51010427). No substrate change.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
EXPECT="${MESH_EGRESS_ISO:-NL}"
LOG="$HOME/.mesh/egress-health.log"; STATE="$HOME/.mesh/.egress-state"
j=$(curl -s -m10 https://ifconfig.co/json 2>/dev/null)
iso=$(printf '%s' "$j" | python3 -c 'import sys,json;print(json.load(sys.stdin).get("country_iso",""))' 2>/dev/null)
ip=$(printf  '%s' "$j" | python3 -c 'import sys,json;print(json.load(sys.stdin).get("ip",""))' 2>/dev/null)
anth=$(curl -s -m10 -o /dev/null -w '%{http_code}' https://api.anthropic.com/v1/messages 2>/dev/null)
ts=$(date -u +%FT%TZ); prev=$(cat "$STATE" 2>/dev/null || echo OK)
if [ -n "$iso" ] && [ "$iso" = "$EXPECT" ] && [ "$anth" != "403" ]; then
  echo OK > "$STATE"; echo "$ts OK egress=$iso ip=$ip anthropic=$anth" >> "$LOG"
  [ "$prev" = BAD ] && command -v mesh-tg >/dev/null 2>&1 && mesh-tg "✅ EGRESS восстановлен: $ip ($iso), Anthropic=$anth." >/dev/null 2>&1
else
  echo BAD > "$STATE"; echo "$ts BAD egress=$iso (want $EXPECT) ip=$ip anthropic=$anth" >> "$LOG"
  [ "$prev" != BAD ] && command -v mesh-tg >/dev/null 2>&1 && mesh-tg "🚨 EGRESS сломан: выход=$iso (ждали $EXPECT), Anthropic=$anth. Вероятно отвалился scoped-routing VPN -> нужен mesh-fix-egress. (Слепая зона, что скрыла аутейдж 2026-06-09.)" >/dev/null 2>&1
fi
