#!/usr/bin/env bash
# mesh-pane-pump — per-CHANNEL, mind-owned feed: push the channel's TOP (data) pane to its MIND
# pane on EVERY real state-change, with NO delta/novelty/"nothing-new" filter (operator 2026-06-21:
# "пусть каждый мин для себя определит фильтры… senses — без фильтра совсем, каждое изменение
# состояния топ-пейна добавляется уму"). This is the opposite of the central delta-gated mesh-feed:
# the *only* thing excluded is the pane's own self-ticking CLOCK (the "pane live: as of <ts>" line and
# bare timestamps), because a clock advancing is not a state-change — feeding on it would be flooding
# on nothing, not signal. Everything else (any content line appearing/changing) is a change → fed.
#
#   mesh-pane-pump <channel> [--interval N] [--once] [--dry]
#     <channel>   tmux window name on this node's session (top=.0 data, bottom=.1 mind)
#     --interval  poll seconds (default 15; the change is content-diffed, not time-driven)
#     --once      one comparison pass then exit (for --test / cron-tick style use)
#     --dry       detect + log, but do NOT inject into the mind pane
#
# Design notes:
#  - Mind-owned filter: normalization rules live here keyed by channel, so each channel can define its
#    own "what counts as a change" without touching a shared gate. senses = zero-filter (clock only).
#  - Delivery interlock (NOT a content filter): if the mind pane is mid-turn (WORKING), hold the change
#    and deliver the LATEST state once it frees — so we never type into a processing TUI (corruption),
#    and we never drop a change. Every state-change is eventually delivered; only stale intermediate
#    states between two rapid changes collapse to the latest (that is honest "current state", not a filter).
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
S="$(hostname)"
STATE_DIR="$HOME/.mesh/pane-pump"; mkdir -p "$STATE_DIR"
LOG="$HOME/.mesh/pane-pump.log"
ts(){ date -u +%FT%TZ; }

# Strip the pane's self-ticking clock so a mere time advance is NOT seen as a state-change.
#  - drop the "pane live: as of …" heartbeat line entirely
#  - blank ISO timestamps (2026-06-21T08:10:41Z) and bare HH:MM:SS clocks to a constant
# Everything else is preserved verbatim → any real content change flips the signature.
normalize(){
  grep -avE 'pane live:|frozen = dead render loop' \
  | sed -E 's/[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2})?Z?/<TS>/g; s/\b[0-9]{2}:[0-9]{2}:[0-9]{2}\b/<CLK>/g'
}

mind_busy(){ # is the channel's MIND pane mid-turn? (delivery interlock, not a content filter)
  local st; st="$(mesh-mind-state --stats 2>/dev/null | awk -v W="$1" '$1==W{print $2}')"
  [ "$st" = WORKING ]
}

pump_once(){ # <channel> <dry>  -> returns 0 if a change was fed/would-be-fed
  local ch="$1" dry="$2"
  local sigf="$STATE_DIR/$ch.sig" lastf="$STATE_DIR/$ch.last"
  local now norm sig last
  now="$(tmux capture-pane -t "$S:$ch.0" -p 2>/dev/null)"
  [ -z "$now" ] && { echo "$(ts) $ch: empty/absent top pane — skip" >> "$LOG"; return 1; }
  norm="$(printf '%s' "$now" | normalize)"
  sig="$(printf '%s' "$norm" | sha1sum | cut -d' ' -f1)"
  last="$(cat "$sigf" 2>/dev/null || echo none)"
  [ "$sig" = "$last" ] && return 1                       # no real change (clock-only ticks ignored)

  # a real change. compute the newly-appeared lines (added since last) for a compact directive.
  local added
  if [ -f "$lastf" ]; then
    added="$(comm -13 <(sort -u "$lastf") <(printf '%s\n' "$norm" | sort -u) 2>/dev/null | grep -avE '^\s*$' | head -12)"
  else
    added="$(printf '%s\n' "$norm" | grep -avE '^\s*$' | tail -12)"
  fi
  printf '%s\n' "$norm" > "$lastf"

  if [ "$dry" = 1 ]; then
    echo "$(ts) $ch: CHANGE (dry) sig=$sig" >> "$LOG"; echo "$sig" > "$sigf"; return 0
  fi
  if mind_busy "$ch"; then
    echo "$(ts) $ch: change held — mind WORKING (will deliver latest when free)" >> "$LOG"
    return 0   # do NOT advance sigf: re-deliver the latest next pass once the mind frees
  fi

  local msg="[${ch} pump] Your DATA pane changed (unfiltered — every state-change reaches you). What changed:
${added}

Read your data pane above and take ONE concrete action on it now. If it is genuinely not actionable, post exactly one [idle] line naming what changed. Do not wait for a feed/tick."
  mesh-tell "$ch" "$msg" >/dev/null 2>&1
  echo "$(ts) $ch: FED change sig=$sig (+$(printf '%s\n' "$added" | grep -c .) lines)" >> "$LOG"
  echo "$sig" > "$sigf"
  return 0
}

# ---- entry ----
if [ "${1:-}" = --test ]; then
  command -v tmux >/dev/null 2>&1 || { echo "smoke-test: FAIL (no tmux)"; exit 1; }
  printf 'pane live: as of 2026-06-21T08:10:41Z\nhousehold=ASLEEP\n12:00:00 foo\n' | normalize | grep -q 'household=ASLEEP' || { echo "smoke-test: FAIL (normalize dropped real content)"; exit 1; }
  # clock-only difference must collapse to the same signature
  a="$(printf 'pane live: as of 2026-06-21T08:10:41Z\nX=1\n' | normalize | sha1sum)"
  b="$(printf 'pane live: as of 2026-06-21T09:99:99Z\nX=1\n' | normalize | sha1sum)"
  [ "$a" = "$b" ] || { echo "smoke-test: FAIL (clock tick seen as change)"; exit 1; }
  c="$(printf 'X=1\n' | normalize | sha1sum)"; d="$(printf 'X=2\n' | normalize | sha1sum)"
  [ "$c" != "$d" ] || { echo "smoke-test: FAIL (real change not detected)"; exit 1; }
  echo "smoke-test: ok (clock-stripped, real change detected)"; exit 0
fi

ch="${1:?usage: mesh-pane-pump <channel> [--interval N] [--once] [--dry]}"; shift || true
INTERVAL=15; ONCE=0; DRY=0
while [ $# -gt 0 ]; do case "$1" in
  --interval) INTERVAL="$2"; shift 2 ;;
  --once) ONCE=1; shift ;;
  --dry) DRY=1; shift ;;
  *) echo "mesh-pane-pump: unknown arg '$1'" >&2; exit 1 ;;
esac; done

tmux has-session -t "$S" 2>/dev/null || { echo "mesh-pane-pump: no tmux session '$S'" >&2; exit 1; }
tmux list-windows -t "$S" -F '#{window_name}' 2>/dev/null | grep -qx "$ch" || { echo "mesh-pane-pump: no window '$ch'" >&2; exit 1; }

if [ "$ONCE" = 1 ]; then pump_once "$ch" "$DRY"; exit 0; fi
echo "$(ts) pump start ch=$ch interval=${INTERVAL}s dry=$DRY" >> "$LOG"
while :; do pump_once "$ch" "$DRY" || true; sleep "$INTERVAL"; done
