#!/usr/bin/env bash
# mesh-channel-tg — bridge a node tg channel into mesh-chat: filter operator Telegram lines → board.
if [ "${1:-}" = "--test" ]; then
  command -v mesh-channel >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-channel)"; exit 1; }
  command -v mesh-tg-filter >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-tg-filter)"; exit 1; }
  [ -f "$HOME/.mesh/voice-in.log" ] && [ -r "$HOME/.mesh/voice-in.log" ] || { echo "smoke-test: FAIL (no readable voice-in.log)"; exit 1; }
  mesh-channel --test >/dev/null 2>&1 || { echo "smoke-test: FAIL (mesh-channel --test failed)"; exit 1; }
  echo "smoke-test: ok"
  exit 0
fi
# flock-serialize: the */1 cron AND the event-driven kick from mesh-voice-rx both call this. Without a
# lock they can race on tg.seen and inject the SAME line twice. flock -n: whoever holds the lock feeds;
# the other exits cleanly (the line is already being fed). Best-effort (flock may be absent).
mkdir -p "$HOME/.mesh/channel"
if command -v flock >/dev/null 2>&1; then
  exec flock -n "$HOME/.mesh/channel/tg.feed.lock" \
    "$HOME/.local/bin/mesh-channel" tg "$HOME/.mesh/voice-in.log" mesh-tg-filter claude
fi
exec "$HOME/.local/bin/mesh-channel" tg "$HOME/.mesh/voice-in.log" mesh-tg-filter claude
