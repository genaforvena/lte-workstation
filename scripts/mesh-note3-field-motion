#!/usr/bin/env bash
# orphan-ok: on-demand paired Note 3 magnetic-field × gyroscope evidence; no calibrated corpus or cadence yet
# mesh-note3-field-motion — magnetic field observed alongside the phone's angular motion.
#
# The calibrated AK09911C field vector and MPU6500 angular velocity answer different questions:
# a field change may come from turning the phone or from the room's magnetic environment. This
# instrument publishes one fresh paired sample so those cases can be studied together. It makes
# no disturbance classification before a time-aligned corpus establishes one.
#
#   mesh-note3-field-motion          one live paired sample
#   mesh-note3-field-motion --json   machine-readable paired evidence
#   mesh-note3-field-motion --test   parser checks plus a real paired HAL read
#
# Exit 2 means the Note 3, either event, freshness, or pair alignment is unavailable. No state
# is written; every invocation is a new live observation.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME="$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6)"
export HOME
[ -f "$HOME/.mesh/nodes" ] && [ -z "${MESH_SKIP_NODES_SOURCE:-}" ] && . "$HOME/.mesh/nodes"

NOTE3_ADB_NODE="${MESH_NOTE3_ADB_NODE:-${MESH_BARO_ADB_NODE:-}}"
NOTE3_ADB_SERIAL="${MESH_NOTE3_ADB_SERIAL:-${MESH_BARO_ADB_SERIAL:-}}"
MAX_SKEW_MS="${MESH_NOTE3_PAIR_MAX_SKEW_MS:-250}"
MAX_AGE_MS="${MESH_NOTE3_PAIR_MAX_AGE_MS:-2000}"

parse_pair() {
  local pair_raw
  pair_raw="$(cat)" || return 2
  PAIR_RAW="$pair_raw" python3 - "$MAX_SKEW_MS" "$MAX_AGE_MS" <<'PY'
import json, math, os, sys

max_skew_ms, max_age_ms = map(float, sys.argv[1:3])
records = {}
uptime = None
for line in os.environ["PAIR_RAW"].splitlines():
    line = line.strip().replace("\r", "")
    if line.startswith("UPTIME="):
        try:
            uptime = float(line[7:].split()[0])
        except (ValueError, IndexError):
            pass
        continue
    fields = line.split("|")
    if len(fields) != 7 or fields[0] != "SENSOR" or fields[2] not in ("2", "4"):
        continue
    try:
        axes = [float(x) for x in fields[3:6]]
        tick = int(fields[6])
    except ValueError:
        continue
    if not all(math.isfinite(x) for x in axes) or tick <= 0:
        continue
    records[fields[2]] = (axes, tick)

if uptime is None or "2" not in records or "4" not in records:
    print("UNKNOWN|why=missing-or-malformed-paired-event", file=sys.stderr)
    sys.exit(2)
(mx, my, mz), mag_tick = records["2"]
(gx, gy, gz), gyro_tick = records["4"]
skew_ms = abs(mag_tick - gyro_tick) / 1e6
age_ms = (uptime * 1e9 - max(mag_tick, gyro_tick)) / 1e6
if age_ms < 0 or age_ms > max_age_ms:
    print("UNKNOWN|why=stale-or-future-hal-event", file=sys.stderr)
    sys.exit(2)
if skew_ms > max_skew_ms:
    print("UNKNOWN|why=paired-events-outside-skew", file=sys.stderr)
    sys.exit(2)

result = {
    "magnetic_field_uT": {"x": mx, "y": my, "z": mz,
                          "magnitude": math.sqrt(mx*mx + my*my + mz*mz)},
    "angular_velocity_rad_s": {"x": gx, "y": gy, "z": gz,
                               "magnitude": math.sqrt(gx*gx + gy*gy + gz*gz)},
    "coverage": "1/1 paired sample",
    "pair_skew_ms": round(skew_ms, 3),
    "pair_age_ms": round(age_ms, 3),
    "hal_ticks_ns": {"magnetometer": mag_tick, "gyroscope": gyro_tick},
    "source": "Note 3 sensorcat HAL types 2+4",
}
print(json.dumps(result, separators=(",", ":")))
PY
}

read_live() {
  local serial="" remote
  [ -n "$NOTE3_ADB_SERIAL" ] && serial="-s $NOTE3_ADB_SERIAL"
  # The magnetometer did not reliably deliver alongside the gyro in a 3 s listener window;
  # six seconds yields fresh events from both channels on the live Note 3.
  remote="/data/local/tmp/sensorcat --secs 6 2 4; echo UPTIME=\$(cat /proc/uptime)"
  if [ "$NOTE3_ADB_NODE" = local ]; then
    mesh-note3-tool-install sensorcat >/dev/null 2>&1 || return 2
    timeout 30 adb $serial shell "$remote" 2>/dev/null
  elif [ -n "$NOTE3_ADB_NODE" ]; then
    timeout 40 ssh -o BatchMode=yes -o ConnectTimeout=8 -o StrictHostKeyChecking=accept-new \
      "$NOTE3_ADB_NODE" "adb $serial shell '$remote'" </dev/null 2>/dev/null
  else
    return 2
  fi
}

if [ "${1:-}" = --test ]; then
  td="$(mktemp -d)" || { echo 'mesh-note3-field-motion --test: FAIL (mktemp)' >&2; exit 1; }
  trap 'rm -rf "$td"' EXIT
  cat >"$td/pair" <<'EOF'
SENSOR|AK09911C Magnetic field Sensor|2|31.0|4.0|42.0|45500350144989
SENSOR|MPU6500 Gyroscope Sensor|4|0.001|0.004|0.009|45500355187280
UPTIME=45501.0 0.00
EOF
  fixture="$(parse_pair <"$td/pair")" || { echo 'mesh-note3-field-motion --test: FAIL (valid pair rejected)' >&2; exit 1; }
  printf '%s\n' "$fixture" | python3 -c 'import json,sys; d=json.load(sys.stdin); assert d["coverage"] == "1/1 paired sample" and d["hal_ticks_ns"]["magnetometer"] != d["hal_ticks_ns"]["gyroscope"] and d["pair_skew_ms"] < 250 and d["magnetic_field_uT"]["magnitude"] > 0 and d["angular_velocity_rad_s"]["magnitude"] > 0' \
    || { echo 'mesh-note3-field-motion --test: FAIL (paired artifact fields)' >&2; exit 1; }
  grep -v 'Gyroscope' "$td/pair" >"$td/missing"
  if parse_pair <"$td/missing" >/dev/null 2>&1; then echo 'mesh-note3-field-motion --test: FAIL (single axis accepted)' >&2; exit 1; fi
  sed 's/45501.0/45510.0/' "$td/pair" >"$td/stale"
  if parse_pair <"$td/stale" >/dev/null 2>&1; then echo 'mesh-note3-field-motion --test: FAIL (stale pair accepted)' >&2; exit 1; fi
  live="$(read_live 2>/dev/null)" || { echo 'mesh-note3-field-motion --test: n/a (Note 3 HAL pair unreachable; exit 2)' >&2; exit 2; }
  live_pair="$(printf '%s\n' "$live" | parse_pair)" || { echo 'mesh-note3-field-motion --test: n/a (no fresh aligned magnetic-field+gyro pair; exit 2)' >&2; exit 2; }
  echo "mesh-note3-field-motion --test: PASS (fixtures + real paired HAL event: $live_pair)"
  exit 0
fi

json=0
case "${1:-}" in '' ) ;; --json) json=1 ;; *) echo 'usage: mesh-note3-field-motion [--json|--test]' >&2; exit 1 ;; esac
raw="$(read_live 2>/dev/null)" || { echo 'mesh-note3-field-motion: UNKNOWN — Note 3 HAL unreachable' >&2; exit 2; }
pair="$(printf '%s\n' "$raw" | parse_pair)" || { echo 'mesh-note3-field-motion: UNKNOWN — no fresh aligned magnetic-field+gyro pair' >&2; exit 2; }
if [ "$json" -eq 1 ]; then
  printf '%s\n' "$pair"
else
  printf '%s\n' "$pair" | python3 -c 'import json,sys; d=json.load(sys.stdin); m=d["magnetic_field_uT"]; g=d["angular_velocity_rad_s"]; print("[note3-field-motion] field_uT=({x:.2f},{y:.2f},{z:.2f}) |B|={magnitude:.2f} angular_velocity_rad_s=({gx:.5f},{gy:.5f},{gz:.5f}) |ω|={gm:.5f} coverage={coverage} skew={pair_skew_ms}ms age={pair_age_ms}ms".format(x=m["x"], y=m["y"], z=m["z"], magnitude=m["magnitude"], gx=g["x"], gy=g["y"], gz=g["z"], gm=g["magnitude"], **d))'
fi
