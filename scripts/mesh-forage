#!/usr/bin/env bash
# orphan-ok: on-demand foraging-evenness poll — a diagnostic READ over the board's completed-work
#   distribution, invoked manually or by a dash refresh (like mesh-hub-criticality / mesh-entropy).
#   No cron: it measures a distribution, it does not act. Wiring it into `mesh-dash minds` or a
#   cooscillate-style reflex is the natural next step, left unwired (an unseen reflex is absent).
#
# mesh-forage — the mesh's FORAGING-TRAIL EVENNESS: is completed work spread across the mind
# lanes, or funneling into one trail while the others' trails evaporate (dead lanes)?
#
# LITERATURE (live review, genome, 2026-07-27 — swarm intelligence & stigmergy, angle = a concrete
# METRIC the field uses to measure ITSELF). In Ant Colony Optimization the colony's health is read
# from the SHANNON ENTROPY of the pheromone-selection distribution (the edge-visitation / component-
# selection histogram): entropy is MAXIMAL early when every trail is equiprobable (broad exploration)
# and COLLAPSES toward zero as pheromone concentrates on a few paths — and a collapse that arrives
# too early is the field's canonical STAGNATION / premature-convergence signature (the colony has
# locked onto a sub-optimal trail and stopped exploring). This entropy-of-the-pheromone-field is a
# standard ACO self-diagnostic; Max-Min ACO exists specifically to bound it away from collapse.
#   refs: "Experiment Study of Entropy Convergence of Ant Colony Optimization" (arXiv:0905.1751);
#         "Using Entropy for Evaluating Swarm Intelligence Algorithms" (Rojas-Morales et al.);
#         diversity-via-subpopulation-entropy in modern ACO variants (Complex&Intell.Syst. 2022,
#         s40747-022-00716-7). Stigmergy framing: agents coordinate through marks left in a shared
#         medium — the mesh's shared medium is the BOARD (~/.mesh/chat.log).
#
# CROSS-DOMAIN TRANSFER: the mesh IS a stigmergic multi-agent system — the minds do not talk
# point-to-point, they deposit marks on the board and react to each other's marks. Each `[done]`
# post is a completed foraging path; WHO posted it (the `who@node` field) is the trail it was
# deposited on. So the ACO pheromone-entropy diagnostic maps EXACTLY onto the mesh's own medium:
# the evenness of the recent `[done]` distribution across lanes IS the exploration/exploitation
# balance of the colony. The doctrine's most-recurring failure — a DEAD LANE (a channel green and
# silent while one window carries everything: the witness passive-lane, redundant-writer, and
# "one mind doing all the work" incidents) — is precisely low-entropy stagnation, but it has only
# ever been noticed as PROSE, never as a live scalar. This is the missing measurement.
#
# WHAT IT IS NOT (honest scope):
#   - It is a DEPOSIT-COUNT evenness, not an EFFORT evenness. A lane that lands one huge task and a
#     lane that lands ten tiny ones read as 10:1. That is deliberate: the ACO quantity is over the
#     selection HISTOGRAM, not path cost. mesh-labor already carries the $-weighted (effort) axis;
#     this is its routing-diversity complement, a distinct question.
#   - `land@` (the steward) legitimately posts a `[done]` per landing and will often dominate; that
#     is real signal, not noise — a colony whose only busy trail is the janitor IS stagnating on the
#     work lanes. Read the per-lane breakdown, not just the scalar.
#
# CLASSIFICATION (FALSIFIABLE via --test; J = Pielou evenness = H / ln(k_active), in [0,1]):
#   BALANCED     J >= 0.75 and no single lane holds > 55%   — broad foraging, healthy diversity
#   SKEWED       0.50 <= J < 0.75                            — tilting toward a few trails; watch
#   STAGNATING   J < 0.50  OR  dominant lane >= 60%          — the colony is funneling into one trail
#   n/a (exit 2) fewer than MIN_MARKS done-marks in window   — too little foraging to measure (honest)
#
#   mesh-forage                 report evenness + regime + per-lane trail over the recent board
#   mesh-forage --json          machine-readable
#   mesh-forage --hours H       window (default 12h)
#   mesh-forage --test          smoke (pure evenness on fixtures; RED-first falsifier)
#
# Env overrides (for --test and node-local tuning):
#   MESH_FORAGE_CHAT   board log path (default ~/.mesh/chat.log)
#   MESH_FORAGE_HOURS  window hours (default 12; --hours wins)
#   MESH_FORAGE_MIN    min done-marks to render a verdict (default 8)
#   MESH_FORAGE_BREAK  =1 neuters the evenness computation (forces J=1) — used ONLY by --test to
#                      prove the STAGNATING gate can actually go red. Never set in production.

set -u

CHAT="${MESH_FORAGE_CHAT:-$HOME/.mesh/chat.log}"
HOURS="${MESH_FORAGE_HOURS:-12}"
MIN_MARKS="${MESH_FORAGE_MIN:-8}"
BREAK="${MESH_FORAGE_BREAK:-0}"
JSON=0

while [ $# -gt 0 ]; do
  case "$1" in
    --json)  JSON=1 ;;
    --hours) shift; HOURS="${1:-12}" ;;
    --test)  shift; exec_test=1; break ;;
    -h|--help) sed -n '2,40p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "mesh-forage: unknown arg: $1" >&2; exit 64 ;;
  esac
  shift
done

# ── the one measure: evenness of the [done] distribution across lanes over the window ──
# reads a board log on stdin; emits: total k_active J dominant_share dom_lane | lane:count ...
compute() {
  local cutoff="$1"
  awk -v cutoff="$cutoff" -v brk="$BREAK" '
    # a real board done-post: "<ts>  who@node  ::  [done] ...". Marker must be the board post,
    # never a prose substring (a [verify]/[fyi] that mentions "[done]" is not a done). Anchor on " :: [done]".
    / :: +\[done\]/ {
      ts=$1
      if (ts < cutoff) next                      # ISO-8601 sorts lex+chrono; window filter
      who=$2
      sub(/@.*/, "", who)                        # lane = who before @node
      if (who=="" ) next
      c[who]++; total++
    }
    END {
      k=0; dom=0; domlane="-"
      for (w in c) { k++; if (c[w]>dom) { dom=c[w]; domlane=w } }
      H=0
      if (total>0) for (w in c) { p=c[w]/total; H -= p*log(p) }   # Shannon (nats)
      J=0
      if (k>1) J = H/log(k)                                        # Pielou evenness in [0,1]
      if (brk=="1") J=0                                            # --test falsifier hook: neuter J
      domshare = (total>0)? dom/total : 0
      printf "%d %d %.4f %.4f %s\n", total, k, J, domshare, domlane
      # per-lane trail, count-desc
      n=0
      for (w in c) { lanes[n]=w; cnt[n]=c[w]; n++ }
      for (i=0;i<n;i++) for (j=i+1;j<n;j++) if (cnt[j]>cnt[i]) { t=cnt[i];cnt[i]=cnt[j];cnt[j]=t; s=lanes[i];lanes[i]=lanes[j];lanes[j]=s }
      line=""
      for (i=0;i<n;i++) line=line sprintf("%s:%d ", lanes[i], cnt[i])
      print line
    }'
}

classify() {  # args: J domshare total  -> echoes REGIME only (parent maps regime->exit code)
  local J="$1" dom="$2" total="$3"
  if [ "$total" -lt "$MIN_MARKS" ]; then echo "n/a"; return; fi
  awk -v J="$J" -v dom="$dom" 'BEGIN{
    if (J<0.50 || dom>=0.60) { print "STAGNATING"; exit }
    if (J<0.75)              { print "SKEWED";     exit }
    if (dom>0.55)            { print "SKEWED";     exit }
    print "BALANCED"
  }'
}
regime_rc() { case "$1" in n/a) echo 2 ;; STAGNATING) echo 3 ;; *) echo 0 ;; esac; }

run() {
  local cutoff
  cutoff="$(date -u -d "$HOURS hours ago" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)" || cutoff="0000"
  [ -f "$CHAT" ] || { echo "mesh-forage: no board log at $CHAT" >&2; exit 2; }
  local out total k J dom domlane trail
  out="$(compute "$cutoff" < "$CHAT")"
  read -r total k J dom domlane <<<"$(echo "$out" | head -1)"
  trail="$(echo "$out" | sed -n '2p')"
  local regime rc; regime="$(classify "$J" "$dom" "$total")"; rc="$(regime_rc "$regime")"

  if [ "$JSON" -eq 1 ]; then
    printf '{"regime":"%s","evenness_J":%s,"dominant_share":%s,"dominant_lane":"%s","done_marks":%d,"active_lanes":%d,"window_h":%s,"trail":"%s"}\n' \
      "$regime" "${J:-0}" "${dom:-0}" "${domlane:-none}" "${total:-0}" "${k:-0}" "$HOURS" "$(echo "$trail" | sed 's/ *$//')"
  else
    echo   "forage: $regime   J=${J} (evenness, 1=perfectly balanced)   dominant=${domlane} ${dom}   marks=${total}/${HOURS}h across ${k} lanes"
    [ -n "$trail" ] && echo "  trail: $trail"
    case "$regime" in
      STAGNATING) echo "  -> the colony is funneling completed work into few trails; the quiet lanes may be DEAD (green+silent). Check the roster." ;;
      n/a)        echo "  -> too few done-marks in the window to measure foraging balance." ;;
    esac
  fi
  exit "$rc"
}

# ── smoke: pure evenness on fixtures + RED-first falsifier ──
run_test() {
  local fail=0
  tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT
  local ts; ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

  # fixture EVEN: 4 lanes x 3 done-marks each -> J must be ~1.0 (BALANCED)
  local fe="$tmp/even.log"; : >"$fe"
  for L in genome senses health tg; do for i in 1 2 3; do
    echo "$ts  ${L}@mesh-home  ::  [done] fixture-$L-$i: work" >>"$fe"; done; done
  # a prose line that MENTIONS [done] must NOT be counted (substring-scan trap)
  echo "$ts  minds@mesh-home  ::  [fyi] genome posted a [done] earlier, discussing it here" >>"$fe"

  # fixture SOLO: one lane holds all 12 -> J=0 (STAGNATING)
  local fs="$tmp/solo.log"; : >"$fs"
  for i in $(seq 1 12); do echo "$ts  genome@mesh-home  ::  [done] fixture-solo-$i: work" >>"$fs"; done

  echo "== fixture EVEN (4 lanes x3) =="
  local jE regE
  jE="$(MESH_FORAGE_CHAT="$fe" MESH_FORAGE_HOURS=99999 "$0" --json)"
  echo "  $jE"
  regE="$(echo "$jE" | grep -oE '"regime":"[A-Za-z/]+"' | cut -d'"' -f4)"
  # 4 lanes counted (prose [fyi] excluded), J>=0.99, BALANCED
  echo "$jE" | grep -q '"active_lanes":4' || { echo "  FAIL: expected 4 active lanes (prose [fyi] leaked in?)"; fail=1; }
  awk -v j="$(echo "$jE" | grep -oE '"evenness_J":[0-9.]+' | cut -d: -f2)" 'BEGIN{exit !(j>=0.99)}' \
    || { echo "  FAIL: even fixture J must be >=0.99"; fail=1; }
  [ "$regE" = "BALANCED" ] || { echo "  FAIL: even fixture must be BALANCED, got $regE"; fail=1; }

  echo "== fixture SOLO (1 lane x12) =="
  local jS regS
  jS="$(MESH_FORAGE_CHAT="$fs" MESH_FORAGE_HOURS=99999 "$0" --json)"
  echo "  $jS"
  regS="$(echo "$jS" | grep -oE '"regime":"[A-Za-z/]+"' | cut -d'"' -f4)"
  echo "$jS" | grep -q '"evenness_J":0' || { echo "  FAIL: solo fixture J must be 0"; fail=1; }
  [ "$regS" = "STAGNATING" ] || { echo "  FAIL: solo fixture must be STAGNATING, got $regS"; fail=1; }

  # RED-FIRST FALSIFIER: neuter the evenness (force J=0) on the EVEN fixture, where dominance is
  # only 0.25 so the verdict is driven by J ALONE. BALANCED MUST flip to STAGNATING — proving the
  # J gate reads the real number, not a constant. (Isolates J: dominance is unchanged.)
  echo "== falsifier: MESH_FORAGE_BREAK=1 (J->0) must flip the EVEN verdict =="
  local regBroken
  regBroken="$(MESH_FORAGE_CHAT="$fe" MESH_FORAGE_HOURS=99999 MESH_FORAGE_BREAK=1 "$0" --json | grep -oE '"regime":"[A-Za-z/]+"' | cut -d'"' -f4)"
  if [ "$regBroken" = "BALANCED" ]; then
    echo "  FAIL: even fixture still BALANCED with J neutered to 0 -> the gate is NOT reading J (vacuous)"; fail=1
  else
    echo "  ok: neutered J=0 flips even $regE -> $regBroken (J gate is live)"
  fi

  # n/a: below MIN_MARKS
  echo "== fixture SPARSE (<MIN_MARKS) -> n/a exit 2 =="
  local fsp="$tmp/sparse.log"; echo "$ts  genome@mesh-home  ::  [done] one: work" >"$fsp"
  MESH_FORAGE_CHAT="$fsp" MESH_FORAGE_HOURS=99999 "$0" >/dev/null 2>&1
  [ $? -eq 2 ] || { echo "  FAIL: sparse must exit 2 (n/a)"; fail=1; }
  echo "  ok: sparse -> n/a exit 2"

  echo
  if [ "$fail" -eq 0 ]; then echo "mesh-forage --test: PASS"; else echo "mesh-forage --test: FAIL"; fi
  return "$fail"
}

if [ "${exec_test:-0}" = "1" ]; then run_test; exit $?; fi
run
