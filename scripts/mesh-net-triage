#!/usr/bin/env bash
# orphan-ok: on-demand layered connectivity triage (mind pulls it when the net feels wrong; live probes, stateless, not scheduled)
# mesh-net-triage — CROSS-SENSE FUSION: WHERE is connectivity broken? No single net sense answers
# that: mesh-nic-drops sees the LINK (driver/NIC frame loss), mesh-wifi-quality sees the RADIO,
# mesh-tcp-retrans sees the PATH (TCP loss anywhere en route), mesh-egress-health sees WAN QUALITY
# (geo-block) — each a solo axis. This fuses them plus two direct probes (gateway reach, internet
# reach) into ONE layered verdict naming the FIRST BROKEN LAYER bottom-up, which is the triage
# answer "the internet feels wrong — is it my NIC, my LAN, my WAN, or loss on the path?".
#
# Layers (bottom-up) and their inputs:
#   LINK  — mesh-nic-drops (live delta sample) + mesh-wifi-quality radio class + mesh-wifi-congestion
#           RF-air crowding, the latter two only when the default route rides a wireless iface
#           (a WEAK radio or CONGESTED air is a link problem; a wired node's DISCONNECTED wifi is
#           NOT — the wireless axes only count on the routing iface). The air axis answers the
#           case the others can't: "our link stats are clean but wifi is slow" = contested channel.
#   LAN   — default gateway from the kernel routing table + one ping to it
#   WAN   — TCP connect to public anchors (1.1.1.1:443, 8.8.8.8:53) + cached egress QUALITY
#           (~/.mesh/.egress-state, mesh-egress-health's */3 artifact; stale → quality UNKNOWN)
#   PATH  — mesh-tcp-retrans (live delta sample)
#
# Honest-degraded contract: an UNREACHABLE/absent input renders that layer UNKNOWN and lands in
# degraded= — visibly different from an assessed-OK layer; never a silent all-clear. Cross-layer
# correction: a gateway that won't answer ping while WAN reach is fine is MARGINAL (ICMP-mute
# router, common), not LAN-DOWN — the layer above proves packets forward.
#
# Verdicts: CLEAN · DEGRADED (marginal layer(s), named) · LINK-FAULT · LAN-DOWN · WAN-DOWN ·
#           PATH-LOSSY (first broken layer bottom-up wins)
# Exit: 0 = assessment produced (any verdict) · 2 = NOTHING assessable (all layers unknown) —
#       never a fake CLEAN.
#
#   mesh-net-triage           one fused reading (~5s: delta samplers run in parallel)
#   mesh-net-triage --json    machine-readable
#   mesh-net-triage --test    smoke test (pure fuse/normalize fixtures + real routing-table read;
#                             NO network packets sent in --test)
set -uo pipefail

EGRESS_STATE="${MESH_EGRESS_STATE:-$HOME/.mesh/.egress-state}"
EGRESS_TTL=900   # egress-health runs */3; older than 15min = don't trust the cached quality

# ---- normalizers: each input's vocabulary → the shared layer vocabulary OK|MARGINAL|BAD|UNKNOWN

# norm_link <nic-drops-verdict> <radio-class-or-'-'> [<air-verdict-or-'-'>]
# radio/air only folded when non-'-' (both count only on a wireless routing iface)
norm_link() {
  local nic="${1:-}" radio="${2:--}" air="${3:--}" v=UNKNOWN
  case "$nic" in
    ERRORS|DROPPING) v=BAD ;;
    DRIP)            v=MARGINAL ;;
    CLEAN|QUIET)     v=OK ;;
    *)               v=UNKNOWN ;;
  esac
  # a WEAK/DISCONNECTED radio on the routing iface degrades an otherwise-OK link
  if [ "$radio" != - ]; then
    case "$radio" in
      DISCONNECTED) v=BAD ;;
      WEAK)         [ "$v" = OK ] && v=MARGINAL ;;
    esac
  fi
  # contested air (mesh-wifi-congestion) impairs throughput even when our frames are clean:
  # CONGESTED (>=6 co-channel rivals) folds like a WEAK radio. BUSY-or-less is normal
  # apartment air (no fold); UNKNOWN air never degrades here — the caller names it as the
  # air-quality soft gap instead, so a hollow scan cache stays visible without faking a fault.
  [ "$air" = CONGESTED ] && [ "$v" = OK ] && v=MARGINAL
  echo "$v"
}

# norm_path <tcp-retrans-verdict>
norm_path() {
  case "${1:-}" in
    DEGRADED)    echo BAD ;;
    LOSSY)       echo MARGINAL ;;
    CLEAN|QUIET) echo OK ;;
    *)           echo UNKNOWN ;;
  esac
}

# fuse <link> <lan> <wan> <path> → "<VERDICT>|<degraded-csv-or-none>"
# First broken layer bottom-up wins; UNKNOWN layers are degraded, never verdict-bearing.
fuse() {
  local link="$1" lan="$2" wan="$3" path="$4" l
  # cross-layer correction: LAN ping-mute with proven WAN forward = MARGINAL, not DOWN
  if [ "$lan" = BAD ] && [ "$wan" = OK ]; then lan=MARGINAL; fi
  local degraded="" marginals=""
  for l in link lan wan path; do
    case "$(eval echo \$$l)" in
      UNKNOWN)  degraded="${degraded:+$degraded,}$l" ;;
      MARGINAL) marginals="${marginals:+$marginals,}$l" ;;
    esac
  done
  local verdict=""
  if   [ "$link" = BAD ]; then verdict=LINK-FAULT
  elif [ "$lan"  = BAD ]; then verdict=LAN-DOWN
  elif [ "$wan"  = BAD ]; then verdict=WAN-DOWN
  elif [ "$path" = BAD ]; then verdict=PATH-LOSSY
  elif [ -n "$marginals" ]; then verdict=DEGRADED
  elif [ "$degraded" = "link,lan,wan,path" ]; then verdict=UNREACHABLE   # nothing assessed
  else verdict=CLEAN
  fi
  [ -n "$marginals" ] && degraded="${degraded:+$degraded,}$marginals"
  echo "${verdict}|${degraded:-none}"
}

# ---- smoke test: pure fixtures + a real (packet-free) kernel routing-table read
if [ "${1:-}" = --test ]; then
  e=0
  [ "$(norm_link CLEAN -)"            = OK       ] || { echo "FAIL: link clean";        e=$((e+1)); }
  [ "$(norm_link QUIET -)"            = OK       ] || { echo "FAIL: link quiet=ok";     e=$((e+1)); }
  [ "$(norm_link DRIP -)"             = MARGINAL ] || { echo "FAIL: link drip";         e=$((e+1)); }
  [ "$(norm_link DROPPING -)"         = BAD      ] || { echo "FAIL: link dropping";     e=$((e+1)); }
  [ "$(norm_link ERRORS -)"           = BAD      ] || { echo "FAIL: link errors";       e=$((e+1)); }
  [ "$(norm_link '' -)"               = UNKNOWN  ] || { echo "FAIL: link empty=unk";    e=$((e+1)); }
  [ "$(norm_link CLEAN WEAK)"         = MARGINAL ] || { echo "FAIL: weak radio folds";  e=$((e+1)); }
  [ "$(norm_link CLEAN DISCONNECTED)" = BAD      ] || { echo "FAIL: radio disc = bad";  e=$((e+1)); }
  [ "$(norm_link CLEAN GOOD)"         = OK       ] || { echo "FAIL: good radio holds";  e=$((e+1)); }
  # air axis (mesh-wifi-congestion): CONGESTED folds like a WEAK radio; BUSY-or-less holds
  [ "$(norm_link CLEAN - CONGESTED)"  = MARGINAL ] || { echo "FAIL: congested air folds";      e=$((e+1)); }
  [ "$(norm_link CLEAN - BUSY)"       = OK       ] || { echo "FAIL: busy air holds";           e=$((e+1)); }
  [ "$(norm_link CLEAN - UNKNOWN)"    = OK       ] || { echo "FAIL: unk air never degrades";   e=$((e+1)); }
  [ "$(norm_link '' - CONGESTED)"     = UNKNOWN  ] || { echo "FAIL: air cant assess unk link"; e=$((e+1)); }
  [ "$(norm_link CLEAN WEAK CONGESTED)" = MARGINAL ] || { echo "FAIL: no double-fold to bad";  e=$((e+1)); }
  [ "$(norm_link CLEAN DISCONNECTED CONGESTED)" = BAD ] || { echo "FAIL: radio disc wins air"; e=$((e+1)); }
  [ "$(norm_path DEGRADED)"           = BAD      ] || { echo "FAIL: path degraded";     e=$((e+1)); }
  [ "$(norm_path LOSSY)"              = MARGINAL ] || { echo "FAIL: path lossy";        e=$((e+1)); }
  [ "$(norm_path QUIET)"              = OK       ] || { echo "FAIL: path quiet=ok";     e=$((e+1)); }
  [ "$(norm_path junk)"               = UNKNOWN  ] || { echo "FAIL: path junk=unk";     e=$((e+1)); }
  [ "$(fuse OK OK OK OK)"             = "CLEAN|none" ]            || { echo "FAIL: all-ok";        e=$((e+1)); }
  [ "$(fuse BAD OK OK OK)"            = "LINK-FAULT|none" ]       || { echo "FAIL: link-fault";    e=$((e+1)); }
  [ "$(fuse OK BAD BAD OK)"           = "LAN-DOWN|none" ]         || { echo "FAIL: lan-down";      e=$((e+1)); }
  [ "$(fuse OK OK BAD OK)"            = "WAN-DOWN|none" ]         || { echo "FAIL: wan-down";      e=$((e+1)); }
  [ "$(fuse OK OK OK BAD)"            = "PATH-LOSSY|none" ]       || { echo "FAIL: path-lossy";    e=$((e+1)); }
  # cross-layer correction: ICMP-mute gateway with WAN proven up ≠ LAN-DOWN
  [ "$(fuse OK BAD OK OK)"            = "DEGRADED|lan" ]          || { echo "FAIL: icmp-mute gw";  e=$((e+1)); }
  # honest partial: unknown inputs land in degraded, never silently vanish into CLEAN
  [ "$(fuse OK OK OK UNKNOWN)"        = "CLEAN|path" ]            || { echo "FAIL: unk-in-degr";   e=$((e+1)); }
  [ "$(fuse UNKNOWN OK MARGINAL OK)"  = "DEGRADED|link,wan" ]     || { echo "FAIL: unk+marginal";  e=$((e+1)); }
  # all-unknown must NOT read CLEAN — it is the exit-2 UNREACHABLE case
  [ "$(fuse UNKNOWN UNKNOWN UNKNOWN UNKNOWN)" = "UNREACHABLE|link,lan,wan,path" ] \
                                                                    || { echo "FAIL: all-unknown"; e=$((e+1)); }
  # real read gate (packet-free): the kernel routing table itself must parse — a node with no
  # default route exits 2 honestly (nothing to triage FROM), never a fake pass
  gw="$(ip route show default 2>/dev/null | awk '/^default/{print $3; exit}')"
  if [ -z "$gw" ]; then
    [ "$e" -eq 0 ] && { echo "smoke-test: n/a (no default route on this node — nothing to triage; fixtures ok)"; exit 2; }
  else
    echo "$gw" | grep -qE '^[0-9a-fA-F:.]+$' || { echo "FAIL: gateway unparseable => '$gw'"; e=$((e+1)); }
  fi
  [ "$e" -eq 0 ] && { echo "smoke-test: ok (29 assertions incl. real routing-table read: gw=$gw)"; exit 0; }
  echo "smoke-test: FAIL ($e fail(s))"; exit 1
fi

MODE=text
[ "${1:-}" = --json ] && MODE=json

# ---- live probes (delta samplers + reach probes run in PARALLEL — wall clock ≈ one 4s window)
td="$(mktemp -d)"; trap 'rm -rf "$td"' EXIT

route_line="$(ip route show default 2>/dev/null | head -1)"
gw="$(printf '%s\n' "$route_line" | awk '/^default/{print $3; exit}')"
dev="$(printf '%s\n' "$route_line" | awk '/^default/{for(i=1;i<NF;i++) if($i=="dev"){print $(i+1); exit}}')"

{ command -v mesh-nic-drops >/dev/null 2>&1 && mesh-nic-drops --window 4 2>/dev/null; } > "$td/nic" &
{ command -v mesh-tcp-retrans >/dev/null 2>&1 && mesh-tcp-retrans --window 4 2>/dev/null; } > "$td/path" &
{ [ -n "$gw" ] && ping -c1 -W2 "$gw" >/dev/null 2>&1 && echo up || echo down; } > "$td/lan" &
{ w=down
  for anchor in 1.1.1.1/443 8.8.8.8/53; do
    timeout 3 bash -c ">/dev/tcp/${anchor%/*}/${anchor#*/}" 2>/dev/null && { w=up; break; }
  done
  echo "$w"; } > "$td/wan" &
{ # radio class counts only when the default route rides a wireless iface
  if [ -n "$dev" ] && [ -d "/sys/class/net/$dev/wireless" ] && command -v mesh-wifi-quality >/dev/null 2>&1; then
    mesh-wifi-quality --json 2>/dev/null | grep -o '"signal_class":"[^"]*"' | cut -d'"' -f4
  else
    echo -
  fi; } > "$td/radio" &
{ # RF-air crowding (mesh-wifi-congestion, radio-passive NM-cache read) — same wireless gate
  if [ -n "$dev" ] && [ -d "/sys/class/net/$dev/wireless" ] && command -v mesh-wifi-congestion >/dev/null 2>&1; then
    mesh-wifi-congestion --json 2>/dev/null
  else
    echo -
  fi; } > "$td/air" &
wait

nic_verdict="$(sed -n 's/^nic-drops: \([A-Z]*\).*/\1/p' "$td/nic" | head -1)"
path_verdict="$(sed -n 's/^tcp-retrans: \([A-Z]*\).*/\1/p' "$td/path" | head -1)"
radio="$(head -1 "$td/radio")"; radio="${radio:--}"

# air: '-' = not attempted (wired route / no tool); attempted but hollow/unparseable (wifi-congestion
# exits 2 with a text line, not json, on a hollow cache) → honest UNKNOWN, never silently clear
if [ "$(head -c1 "$td/air" 2>/dev/null)" = - ]; then air=-; air_co=""
else
  air="$(grep -o '"verdict":"[^"]*"' "$td/air" 2>/dev/null | cut -d'"' -f4 | head -1)"
  air_co="$(grep -o '"co_channel":[0-9]*' "$td/air" 2>/dev/null | cut -d: -f2 | head -1)"
  air="${air:-UNKNOWN}"
fi

link="$(norm_link "$nic_verdict" "$radio" "$air")"
path="$(norm_path "$path_verdict")"

if [ -z "$gw" ]; then lan=BAD; lan_note="no-default-route"
elif [ "$(cat "$td/lan")" = up ]; then lan=OK; lan_note="gw=$gw"
else lan=BAD; lan_note="gw=$gw ping-fail"; fi

egress_q=UNKNOWN
if [ -f "$EGRESS_STATE" ]; then
  age=$(( $(date +%s) - $(stat -c %Y "$EGRESS_STATE" 2>/dev/null || echo 0) ))
  [ "$age" -le "$EGRESS_TTL" ] && egress_q="$(head -1 "$EGRESS_STATE" 2>/dev/null)"
fi
if [ "$(cat "$td/wan")" = up ]; then
  wan=OK; wan_note="anchors-reachable egress-quality=$egress_q"
  # reachable but geo-degraded egress = MARGINAL WAN, not a clean pass
  [ "$egress_q" = BAD ] && wan=MARGINAL
else
  wan=BAD; wan_note="no-anchor-reachable egress-quality=$egress_q"
fi

fused="$(fuse "$link" "$lan" "$wan" "$path")"
verdict="${fused%%|*}"; degraded="${fused##*|}"
# cached egress quality unknown/stale is a soft gap worth naming even when reach is fine
if [ "$egress_q" = UNKNOWN ] && [ "$wan" != BAD ]; then
  [ "$degraded" = none ] && degraded="egress-quality" || degraded="$degraded,egress-quality"
fi
# attempted-but-unknown air on a wireless route is the same class of soft gap (hollow scan cache)
if [ "$air" = UNKNOWN ]; then
  [ "$degraded" = none ] && degraded="air-quality" || degraded="$degraded,air-quality"
fi

detail="nic=${nic_verdict:-n/a} radio=$radio air=$air${air_co:+(${air_co} rivals)} lan:$lan_note wan:$wan_note tcp=${path_verdict:-n/a}"
ts="$(date -u +%FT%TZ)"

if [ "$MODE" = json ]; then
  printf '{"verdict":"%s","link":"%s","lan":"%s","wan":"%s","path":"%s","air":"%s","degraded":"%s","detail":"%s","ts":"%s"}\n' \
    "$verdict" "$link" "$lan" "$wan" "$path" "$air" "$degraded" "$detail" "$ts"
else
  echo "net-triage: $verdict (link=$link lan=$lan wan=$wan path=$path) degraded=$degraded — $detail"
fi
[ "$verdict" = UNREACHABLE ] && exit 2
exit 0
