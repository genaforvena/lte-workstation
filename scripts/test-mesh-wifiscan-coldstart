#!/usr/bin/env bash
# orphan-ok: on-demand test harness (test-*) — reproduces mesh-wifiscan's cold-cache n=1 condition
#            deterministically (stubbed nmcli) so the cron-only bug can be verified WITHOUT polling it
#            warm. Invoked by hand / by autoland's --test gate, never wired to cron.
# reflex-cadence: none
#
# test-mesh-wifiscan-coldstart — honest cold-start verification for mesh-wifiscan.
#
# THE BUG (board chat-review/wifiscan-verification + memory nmcli-rescan-async-race-warm-cache-masks-test):
#   under cron, `nmcli device wifi list --rescan yes` intermittently returns ONLY the associated AP
#   (n=1) — the radio is busy carrying exit-node traffic / power-save suppresses the off-channel scan.
#   It NEVER fails interactively because hand-runs keep NM's scan cache warm → the warm cache MASKS the
#   bug. So it cannot be reproduced by running mesh-wifiscan by hand, and it cannot be forced by
#   restarting NetworkManager either — egress (default route + Tailscale + this SSH path) rides the same
#   wlp0s20f3 radio, so an NM restart would sever the node (substrate single-writer rule, CLAUDE.md).
#
# WHAT THIS HARNESS DOES (safe, deterministic, no real radio touched): it shadows `nmcli` with a STUB on
#   PATH that emits a CONTROLLED terse scan (cold n=1, or warm n>=SANITY_MIN, or cold-then-warm across the
#   retry) and asserts mesh-wifiscan's THREE honest behaviors against the documented cold OUTPUT:
#     A. cold-then-warm  → the 3-try retry recovers: a LOGGED tape line with n>=SANITY_MIN.
#     B. persistent cold → honest-fusion holds: NO tape line (a single-AP scan never poisons wifi.log),
#                          a "stale-cache miss" stderr note, exit 1.
#     C. warm first call → normal path: logs immediately, exit 0.
#
# HONEST LIMITATION (the whole point of this tool is honesty — it must not overclaim):
#   the stub reproduces the cold OUTPUT (n=1 terse list), NOT NM's ASYNC scan-completion TIMING race.
#   Whether `--rescan yes` truly blocks-until-fresh under real cron load is a TIMING property only a real
#   cold cron moment can settle (the temp instrumentation deployed on the board captures that). This
#   harness pins the LOGIC that consumes a cold result; it is a regression guard, not proof the live
#   feeder is fixed. Use `--real` for a safe real-path observation (one read-only scan under a cron-like
#   minimal env; no NM restart) — it OBSERVES the live cache, it does not force coldness.
#
#   test-mesh-wifiscan-coldstart            run the stub scenarios A/B/C (exit 0 iff all pin correctly)
#   test-mesh-wifiscan-coldstart --test     alias for the default (so autoland's --test gate runs it)
#   test-mesh-wifiscan-coldstart --real     opt-in: one real scan under a cron-like minimal env, report only
#
# Target tool: $MESH_WIFISCAN_BIN, else the deployed mesh-wifiscan, else the repo source.
set -uo pipefail

WIFISCAN="${MESH_WIFISCAN_BIN:-}"
[ -n "$WIFISCAN" ] || WIFISCAN="$(command -v mesh-wifiscan 2>/dev/null || true)"
[ -x "$WIFISCAN" ] || WIFISCAN="$HOME/lte-workstation/scripts/mesh-wifiscan"
[ -x "$WIFISCAN" ] || { echo "FAIL: cannot locate an executable mesh-wifiscan (set MESH_WIFISCAN_BIN)"; exit 1; }

# --- opt-in real observation: one read-only scan under a cron-like minimal env, NO NM restart ---
if [ "${1:-}" = --real ]; then
  echo "real-mode: one scan under a cron-like minimal env (PATH=/usr/bin:/bin only) — read-only, no NM restart."
  echo "(this triggers ONE real --rescan, briefly off-channel on the exit-node radio; observes the live cache, does not force coldness)"
  env -i HOME="$HOME" PATH="/usr/bin:/bin" "$WIFISCAN" 2>&1 | sed -n '1p'
  echo "exit: ${PIPESTATUS[0]} — compare n here vs an interactive run; a cron-low n (1-2) vs interactive-high n is the bug's signature."
  exit 0
fi

# ----- stub-nmcli scenario harness (default; --test is an alias) -----
TMP="$(mktemp -d)"; trap 'rm -rf "$TMP"' EXIT
STUBBIN="$TMP/.local/bin"; mkdir -p "$STUBBIN" "$TMP/.mesh"

# A nmcli stub. Behaviour driven by the SCENARIO file's contents and a per-call counter:
#   cold        -> always one AP (the associated AP only)  => n=1
#   warm        -> five APs                                => n=5
#   cold-then-warm -> call 1 cold (n=1), calls >=2 warm (n=5)   [exercises the retry]
# Terse nmcli format: SIGNAL:BSSID(colons backslash-escaped):SSID:FREQ — mesh-wifiscan sed's \: -> @.
cat > "$STUBBIN/nmcli" <<'STUB'
#!/usr/bin/env bash
# stub nmcli — emits a controlled scan; no real radio.
args="$*"
SC="$(cat "$STUB_SCENARIO" 2>/dev/null || echo cold)"
case "$args" in
  *"radio wifi"*) echo "enabled"; exit 0 ;;   # so a smoke --test would pass
esac
case "$args" in
  *"device wifi list"*)
    c=$(( $(cat "$STUB_COUNTER" 2>/dev/null || echo 0) + 1 )); echo "$c" > "$STUB_COUNTER"
    emit_warm(){ printf '%s\n' \
      '87:AA\:BB\:CC\:DD\:EE\:01:GL-MT3000-765-5G:5180 MHz' \
      '74:11\:22\:33\:44\:55\:66:Wi-Fi 1202:2412 MHz' \
      '63:22\:33\:44\:55\:66\:77:Keenetic-8821:5240 MHz' \
      '58:33\:44\:55\:66\:77\:88:TP-LINK_4F2A:2437 MHz' \
      '51:44\:55\:66\:77\:88\:99:DIR-615:2462 MHz'; }
    emit_cold(){ printf '%s\n' '87:AA\:BB\:CC\:DD\:EE\:01:GL-MT3000-765-5G:5180 MHz'; }  # associated AP only
    case "$SC" in
      warm) emit_warm ;;
      cold) emit_cold ;;
      cold-then-warm) [ "$c" -ge 2 ] && emit_warm || emit_cold ;;
      *) emit_cold ;;
    esac
    exit 0 ;;
esac
exit 0
STUB
chmod +x "$STUBBIN/nmcli"

# run mesh-wifiscan --log against a scenario; capture logged-line-count, stderr-miss, exit code.
# HOME=$TMP so (a) mesh-wifiscan's own `export PATH=$HOME/.local/bin:$PATH` puts our stub FIRST, and
# (b) wifi.log lands in the temp tree. Real sed/sort/date/hostname still resolve from the inherited PATH.
run() {
  local scenario="$1"
  echo "$scenario" > "$TMP/scenario"; : > "$TMP/counter"; : > "$TMP/.mesh/wifi.log"
  local err rc
  err="$(STUB_SCENARIO="$TMP/scenario" STUB_COUNTER="$TMP/counter" HOME="$TMP" \
         "$WIFISCAN" --log 2>&1 >/dev/null)"; rc=$?
  LOGGED=$(wc -l < "$TMP/.mesh/wifi.log" 2>/dev/null); LOGGED=${LOGGED:-0}
  LOGGED_N="$(sed -n 's/.* n=\([0-9]*\) .*/\1/p' "$TMP/.mesh/wifi.log" 2>/dev/null | tail -1)"
  MISS=0; printf '%s' "$err" | grep -q 'stale-cache miss' && MISS=1
  RC=$rc
}

fail=0
note(){ echo "  $1"; }

# Scenario C — warm first call: logs immediately, exit 0
run warm
if [ "$LOGGED" = 1 ] && [ "${LOGGED_N:-0}" -ge 3 ] && [ "$RC" = 0 ]; then
  note "C warm:           ok (logged n=$LOGGED_N, exit 0)"
else
  note "C warm:           FAIL (logged=$LOGGED n=${LOGGED_N:-?} rc=$RC — expected 1 line n>=3 rc0)"; fail=1
fi

# Scenario A — cold-then-warm: retry recovers and logs n>=3
run cold-then-warm
if [ "$LOGGED" = 1 ] && [ "${LOGGED_N:-0}" -ge 3 ] && [ "$RC" = 0 ]; then
  note "A cold-then-warm: ok (retry recovered → logged n=$LOGGED_N, exit 0)"
else
  note "A cold-then-warm: FAIL (logged=$LOGGED n=${LOGGED_N:-?} rc=$RC — expected retry to recover to n>=3)"; fail=1
fi

# Scenario B — persistent cold: the honest-fusion guarantee is NO tape line + a stale-cache-miss note.
# NB: mesh-wifiscan's exit code keys off n>0 ("any AP found", per its line 94 contract), so a cold n=1
# scan exits 0 even though it logs nothing — the honest-absence guarantee is the ABSENT LOG LINE, not the
# exit code. We assert the contract as-built (rc=0) and surface the nuance; not a defect (no consumer keys
# on the code to tell miss-from-success — --loop/cron ignore it).
run cold
if [ "$LOGGED" = 0 ] && [ "$MISS" = 1 ] && [ "$RC" = 0 ]; then
  note "B persistent-cold: ok (n=1 NOT logged + stale-cache miss noted = honest absence; exit 0 per 'any AP' contract)"
else
  note "B persistent-cold: FAIL (logged=$LOGGED miss=$MISS rc=$RC — expected 0 log lines + miss note + exit 0)"; fail=1
fi

if [ "$fail" = 0 ]; then
  echo "smoke-test: ok (cold n=1 reproduced deterministically; retry-recovery + honest-no-log-on-cold pinned)"
  echo "  NOTE: reproduces the cold OUTPUT, not NM's async-timing race — see --real for live observation."
  exit 0
fi
echo "smoke-test: FAIL"
exit 1
