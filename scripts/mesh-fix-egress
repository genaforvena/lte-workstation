#!/usr/bin/env bash
# mesh-fix-egress — restore SCOPED VPN egress on the egress-offering node.
#
# Run as root, ideally inside the node's tmux so a connection blip can't kill it:
#     sudo mesh-fix-egress
#
# Restores the invariant: the HOST's own control plane returns to the clean
# default route; ONLY forwarded (Tailscale exit-node) client traffic egresses via
# the scoped VPN. Dead-man protected: if verification fails (or the script dies),
# the VPN iface is brought fully down and the host falls back to the clean LAN route.
#
# ALL provider/server specifics (config path, interface name, client address,
# expected egress IP) come from ~/.mesh/nodes (gitignored) as VPN_EGRESS_* — NEVER
# hardcoded here, so the genome carries no node topology and plants on any mesh.
# A node with no VPN_EGRESS_* config is a clean no-op (exit 2).
#
# Root-cause fixes vs. the reverted attempt:
#   - Table = off            (wg-quick must NOT hijack the host default route)
#   - mark in mangle PREROUTING, not FORWARD  (the forwarding route decision
#     happens BEFORE the FORWARD chain — marking in FORWARD was the bug that made
#     the scoped version "not work" and triggered the full-tunnel revert)
#   - MASQUERADE on the VPN iface  (VPN endpoint must see src = the client addr)
set -uo pipefail
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes"

SRC_CONF="${VPN_SRC_CONF:-}"                 # provider config — source of keys/endpoint (node-local)
IFACE="${VPN_EGRESS_IFACE:-}"                # WireGuard interface name (node-local)
VPN_ADDR="${VPN_EGRESS_ADDR:-}"              # this client's address on the VPN (node-local)
VPN_IP="${VPN_EGRESS_IP:-}"                  # expected egress IP — informational verify only (node-local)
DST_CONF="/etc/wireguard/${IFACE:-_unset}.conf"   # scoped config we install

# Smoke test FIRST: must be SAFE (no substrate touch) and run without root. A side-effecting
# tool needs an explicit guard so --test can never fall through to the real egress fix.
if [ "${1:-}" = --test ]; then
  # Role check FIRST: a node with no VPN_EGRESS_* config offers no egress BY DESIGN, and such a
  # node has no reason to carry wg-quick — a missing binary there is the expected shape of "not
  # my role", not a fault. Binary checks bind only on the egress-offering node.
  [ -n "$SRC_CONF" ] && [ -r "$SRC_CONF" ] || { echo "smoke-test: n/a (not the egress-offering node)"; exit 2; }
  _chk(){ command -v "$1" >/dev/null 2>&1 || [ -x "/sbin/$1" ] || [ -x "/usr/sbin/$1" ]; }
  for c in wg-quick iptables ip; do _chk "$c" || { echo "smoke-test: FAIL (no $c)"; exit 1; }; done
  # wg-quick strip dry-run: parse+validate the WireGuard config syntax without bringing the iface up.
  # A malformed config applied under mesh-dms would sever reachability — catch it in --test.
  wg_out=$(wg-quick strip "$SRC_CONF" 2>&1) || { echo "smoke-test: FAIL (wg-quick strip: $wg_out)"; exit 1; }
  echo "$wg_out" | grep -q '^PrivateKey\|^PublicKey\|^ListenPort\|^Endpoint' \
    || { echo "smoke-test: FAIL (wg-quick strip produced no valid WireGuard stanza — config empty?)"; exit 1; }
  echo "smoke-test: ok"; exit 0
fi
[ "$(id -u)" = 0 ] || { echo "run as root: sudo $0"; exit 1; }

# Without node-local VPN config this node offers no egress — clean no-op, not an error.
[ -n "$SRC_CONF" ] && [ -n "$IFACE" ] && [ -n "$VPN_ADDR" ] || {
  echo "mesh-fix-egress: not an egress-offering node (set VPN_EGRESS_* in ~/.mesh/nodes)"; exit 2; }

IDEAPAD="${VPN_EGRESS_PEER:-}"
TIMEOUT="${1:-150}"
log(){ echo "[fix-egress $(date -u +%H:%M:%SZ)] $*"; }

PRIV=$(grep -oP 'PrivateKey\s*=\s*\K\S+' "$SRC_CONF" 2>/dev/null)
PUB=$(grep -oP 'PublicKey\s*=\s*\K\S+'  "$SRC_CONF" 2>/dev/null)
ENDPOINT=$(grep -oP 'Endpoint\s*=\s*\K\S+' "$SRC_CONF" 2>/dev/null)
[ -n "$PRIV" ] && [ -n "$PUB" ] && [ -n "$ENDPOINT" ] || { echo "FATAL: keys not found in $SRC_CONF"; exit 1; }

mkdir -p /etc/wireguard; umask 077
cat > "$DST_CONF" <<EOC
[Interface]
PrivateKey = $PRIV
Address = $VPN_ADDR
MTU = 1420
Table = off
PostUp = ip route replace default dev %i table 200; ip rule add priority 5200 fwmark 0x40000 lookup 200 2>/dev/null || true; iptables -t mangle -N MESH_VPN 2>/dev/null || iptables -t mangle -F MESH_VPN; iptables -t mangle -A MESH_VPN -d 100.64.0.0/10 -j RETURN; iptables -t mangle -A MESH_VPN -d 10.0.0.0/8 -j RETURN; iptables -t mangle -A MESH_VPN -d 172.16.0.0/12 -j RETURN; iptables -t mangle -A MESH_VPN -d 192.168.0.0/16 -j RETURN; iptables -t mangle -A MESH_VPN -j MARK --set-mark 0x40000; iptables -t mangle -A PREROUTING -i tailscale0 -j MESH_VPN; iptables -t nat -A POSTROUTING -o %i -j MASQUERADE
PostDown = ip rule del priority 5200 fwmark 0x40000 lookup 200 2>/dev/null || true; iptables -t mangle -D PREROUTING -i tailscale0 -j MESH_VPN 2>/dev/null || true; iptables -t mangle -F MESH_VPN 2>/dev/null || true; iptables -t mangle -X MESH_VPN 2>/dev/null || true; iptables -t nat -D POSTROUTING -o %i -j MASQUERADE 2>/dev/null || true; ip route flush table 200 2>/dev/null || true

[Peer]
PublicKey = $PUB
AllowedIPs = 0.0.0.0/0
Endpoint = $ENDPOINT
PersistentKeepalive = 20
EOC
log "wrote scoped $DST_CONF"

rollback(){
  log "ROLLBACK -> $IFACE fully down, host on clean route"
  wg-quick down "$DST_CONF" 2>/dev/null
  wg-quick down "$SRC_CONF" 2>/dev/null
  ip link del "$IFACE" 2>/dev/null
  ip rule del priority 5198 2>/dev/null; ip rule del priority 5199 2>/dev/null
  ip rule del priority 5200 2>/dev/null
  ip route flush table 51820 2>/dev/null; ip route flush table 200 2>/dev/null
}
[ "${1:-}" = "--rollback" ] && { rollback; exit 0; }

( sleep "$TIMEOUT"; log "TIMEOUT"; rollback ) & TPID=$!
trap 'kill $TPID 2>/dev/null' EXIT

log "tearing down current full-tunnel $IFACE"
wg-quick down "$SRC_CONF" 2>/dev/null || ip link del "$IFACE" 2>/dev/null
ip rule del priority 5198 2>/dev/null; ip rule del priority 5199 2>/dev/null
ip route flush table 51820 2>/dev/null
sleep 1
log "host egress now via dev $(ip route get 1.1.1.1 2>/dev/null | grep -oP 'dev \K\S+') (expect physical)"

log "bringing up scoped $IFACE"
wg-quick up "$DST_CONF"
sleep 3

hostdev=$(ip route get 1.1.1.1 2>/dev/null | grep -oP 'dev \K\S+')
# informational only — uses the invoking user's ssh keys, not root's
ideapad_ip=$(sudo -u "$(whoami)" ssh -o BatchMode=yes -o StrictHostKeyChecking=no -o ConnectTimeout=8 "${SSH_USER:-$(whoami)}@$IDEAPAD" 'curl -s --max-time 8 https://ifconfig.me' 2>/dev/null)
log "VERIFY host-dev=$hostdev (DEAD-MAN GATE: must be clean/physical)  egress-peer-ip=$ideapad_ip (want ${VPN_IP:-<unset>}, informational)"

# Dead-man gate is ONLY the host-safety invariant: host must NOT egress via a wg tunnel.
# The exit-node client's VPN egress is the feature, verified separately with no lockout risk.
ok=1
case "$hostdev" in "$IFACE"|wg*|"") ok=0;; esac

if [ "$ok" = 1 ]; then
  kill $TPID 2>/dev/null; trap - EXIT
  log "VERIFIED host-safe: control plane on clean route ($hostdev). $IFACE scoped & live."
  log "egress observed: $ideapad_ip (expect ${VPN_IP:-<unset>} — confirm from the egress-peer side)"
  exit 0
else
  log "VERIFY FAILED (host still on $hostdev) — rollback fires at timeout (or: sudo $0 --rollback)"
  wait $TPID; trap - EXIT
  exit 1
fi
