#!/usr/bin/env bash
# orphan-ok: shared installer sourced/called by the mesh-note3-* native organs (ambient/ear/screen)
# mesh-note3-tool-install — push the Note3 native HAL clients to the phone if missing.
#
# The Note3 (SM-N900, Android 5.0, ROOTED) has no cross-compiler and no termux; the mesh reads its
# real sensor/audio/screen HALs through three small NDK-built ARM binaries kept in ~/.mesh/note3/:
#   sensorcat  — native ASensorManager client → live pressure/temp/humidity + full sensor suite
#                (replaces the frozen `dumpsys ... last=` fossil scrape used by mesh-baro/thermal/light/mag)
#   slrec      — native OpenSL ES recorder → live mic through the audio HAL (raw tinyalsa can't route
#                the YMU831 DSP codec; OpenSL ES goes through AudioFlinger which owns the routing)
#   tinycap/tinymix — tinyalsa (kept for codec inspection; slrec is the working mic path)
# Source of truth for the binaries + C source + BUILD.md: ~/.mesh/note3/  (rebuild recipe in BUILD.md).
#
#   mesh-note3-tool-install <bin>   ensure /data/local/tmp/<bin> exists on the phone (push if missing)
#   mesh-note3-tool-install --all   push all four
#   mesh-note3-tool-install --test  smoke (exit 2 = phone unreachable)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes"

SERIAL="${MESH_NOTE3_ADB_SERIAL:-${MESH_BARO_ADB_SERIAL:-4d00553d61ab90b7}}"
STASH="$HOME/.mesh/note3"
ADB="adb -s $SERIAL"

note3_reachable() { timeout 8 $ADB shell "echo ok" 2>/dev/null | grep -q ok; }

ensure_bin() {   # ensure one binary is present + executable on the phone
  local b="$1"
  [ -f "$STASH/$b" ] || { echo "missing stash: $STASH/$b (rebuild per BUILD.md)" >&2; return 1; }
  if timeout 8 $ADB shell "[ -x /data/local/tmp/$b ] && echo y" 2>/dev/null | grep -q y; then return 0; fi
  timeout 20 $ADB push "$STASH/$b" "/data/local/tmp/$b" >/dev/null 2>&1 || return 1
  timeout 8 $ADB shell "chmod 755 /data/local/tmp/$b" >/dev/null 2>&1
  return 0
}

case "${1:-}" in
  --all)  note3_reachable || { echo "phone unreachable"; exit 2; }
          for b in sensorcat slrec tinycap tinymix; do ensure_bin "$b" && echo "ok $b" || echo "FAIL $b"; done ;;
  --test) if ! note3_reachable; then echo "smoke-test: n/a (Note3 unreachable)"; exit 2; fi
          ensure_bin sensorcat && echo "smoke-test: ok (sensorcat present/pushed)" || { echo "smoke-test: FAIL"; exit 1; } ;;
  "")     echo "usage: mesh-note3-tool-install <bin>|--all|--test"; exit 1 ;;
  *)      note3_reachable || { echo "phone unreachable"; exit 2; }
          ensure_bin "$1" && echo "ok $1" || { echo "FAIL $1"; exit 1; } ;;
esac
