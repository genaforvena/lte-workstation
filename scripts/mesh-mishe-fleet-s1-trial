#!/usr/bin/env python3
"""Offline fleet S1 diagnostic over independently reviewed, S0-bound private cases.

A reviewer assertion is not proof of independence or an authority grant. Unknown
inference counts as incorrect. Synthetic or post-observation cases are excluded.
"""
from __future__ import annotations

import argparse
import hashlib
import json
import math
from functools import lru_cache
import os
from pathlib import Path
import re
import stat
import sys
import tempfile

MIN_PER_CLASS = 100
HIGH = 0.80
LOW = 0.20
QUESTION = ("Does fresh evidence establish this Top Pain's desired observable state "
            "rather than only an intermediate prediction or claim?")
MODEL = (Path.home() / ".cache/huggingface/hub/models--convaiinnovations--laya/snapshots/"
         "1c5edc17a7acd8701df6fc341c0d179f1c62c982")
HEX = re.compile(r"[0-9a-f]{64}\Z")
CASE_ID = re.compile(r"\d{20}-[0-9a-f]{16}\Z")
REVIEWER = re.compile(r"[a-z][a-z0-9-]{0,63}\Z")


def digest(raw: bytes) -> str:
    return hashlib.sha256(raw).hexdigest()


@lru_cache(maxsize=1)
def fleet_validator():
    core = Path(os.environ.get("MESH_MISHE_CORE", str(Path.home() / "mishe-tauftauf")))
    sys.path.insert(0, str(core / "src"))
    from mishe_tauftauf.external_view import safe_fleet_view
    return safe_fleet_view


def safe_view(projection: str, channel: str) -> str | None:
    return fleet_validator()(projection, channel)


def private_regular(path: Path, root: Path, limit: int) -> bytes:
    if not path.resolve().is_relative_to(root.resolve()) or path.is_symlink():
        raise ValueError("private path outside evidence root or symlink")
    info = path.lstat()
    if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077 or info.st_size > limit:
        raise ValueError("private file absent, oversized or world-readable")
    data = path.read_bytes()
    if len(data) != info.st_size or path.lstat().st_mtime_ns != info.st_mtime_ns:
        raise ValueError("private file changed during read")
    return data


def reviewed_cases(root: Path, review_path: Path) -> tuple[list[dict], str]:
    if root.is_symlink() or not root.is_dir() or root.stat().st_mode & 0o077:
        raise ValueError("private candidate root unavailable")
    review_raw = private_regular(review_path, root, 4_000_000)
    review = json.loads(review_raw)
    if (not isinstance(review, dict) or set(review) != {"version", "reviewer", "cases"}
        or review["version"] != 1 or not isinstance(review["reviewer"], str)
        or not REVIEWER.fullmatch(review["reviewer"]) or review["reviewer"] == "trial-runner"
        or not isinstance(review["cases"], list)):
        raise ValueError("invalid independent review envelope")
    ids, groups, cases = set(), set(), []
    for row in review["cases"]:
        if (not isinstance(row, dict) or set(row) != {"case_id", "source_group", "split", "label", "evidence_sha256"}
            or not isinstance(row["case_id"], str) or not CASE_ID.fullmatch(row["case_id"])
            or not isinstance(row["source_group"], str) or not HEX.fullmatch(row["source_group"])
            or row["split"] not in ("development", "holdout") or row["label"] not in ("yes", "no")
            or not isinstance(row["evidence_sha256"], str) or not HEX.fullmatch(row["evidence_sha256"])
            or row["case_id"] in ids or row["source_group"] in groups):
            raise ValueError("duplicate or invalid reviewed case/group")
        ids.add(row["case_id"])
        groups.add(row["source_group"])
        directory = root / "cases" / row["case_id"]
        if directory.is_symlink() or not directory.is_dir() or directory.stat().st_mode & 0o077:
            raise ValueError("private case directory invalid")
        raw = private_regular(directory / "case.json", root, 32768)
        if digest(raw) != row["evidence_sha256"]:
            raise ValueError("reviewed manifest digest mismatch")
        case = json.loads(raw)
        if (not isinstance(case, dict) or case.get("version") != 2
            or case.get("status") != "candidate_unreviewed"
            or case.get("provenance_phase") != "s0_projection_hash_matched"
            or case.get("case_id") != row["case_id"]
            or not isinstance(case.get("channel"), str) or not isinstance(case.get("projected_view"), str)
            or not isinstance(case.get("safe_view"), str)
            or case["safe_view"] != safe_view(case["projected_view"], case["channel"])
            or not isinstance(case.get("sources"), list) or not case["sources"]):
            raise ValueError("case lacks exact S0-bound safe projection")
        if not case["safe_view"].startswith(("STATE: RED\n", "STATE: GREEN\n")):
            raise ValueError("UNKNOWN/INTERMEDIATE cannot become a held-out verdict")
        for index, source in enumerate(case["sources"]):
            if (not isinstance(source, dict) or source.get("file") != f"sources/{index}"
                or not isinstance(source.get("sha256"), str) or not HEX.fullmatch(source["sha256"])):
                raise ValueError("source manifest invalid")
            if digest(private_regular(directory / "sources" / str(index), root, 4_000_000)) != source["sha256"]:
                raise ValueError("archived producer bytes changed")
        if (not isinstance(case.get("bound_sha256"), str) or not HEX.fullmatch(case["bound_sha256"])
            or not isinstance(case.get("event_id"), str) or not HEX.fullmatch(case["event_id"])
            or type(case.get("original_feed_seq")) is not int or case["original_feed_seq"] < 1
            or case.get("source_digest") != digest(
                "\n".join(source["sha256"] for source in case["sources"]).encode())
            or case.get("capture_key") != digest(
                f"{case['channel']}\0{case['event_id']}".encode())):
            raise ValueError("case identity or source digest invalid")
        bound_raw = private_regular(directory / "s0-bound.json", root, 32768)
        bound = json.loads(bound_raw)
        if (digest(bound_raw) != case["bound_sha256"] or not isinstance(bound, dict)
            or set(bound) != {"version", "tick", "event_id", "channel", "projected_sha256",
                              "sources", "audit_sha256", "feed_seq"}
            or bound["version"] != 1 or bound["event_id"] != case["event_id"]
            or bound["channel"] != case["channel"]
            or bound["feed_seq"] != case["original_feed_seq"]
            or bound["projected_sha256"] != digest(case["projected_view"].encode())
            or not isinstance(bound["sources"], list)
            or len(case["sources"]) != len(bound["sources"]) + int(bound["audit_sha256"] is not None)
            or [(item.get("origin"), item["sha256"], item.get("mtime_ns"))
                for item in case["sources"][:len(bound["sources"])]]
                != [(item.get("origin"), item.get("sha256"), item.get("mtime_ns"))
                    for item in bound["sources"]]
            or (bound["audit_sha256"] is not None
                and case["sources"][-1]["sha256"] != bound["audit_sha256"])):
            raise ValueError("S0 bound stamp or archived sources mismatch")
        cases.append({**row, "channel": case["channel"], "safe_view": case["safe_view"]})
    return cases, digest(review_raw)


def wilson_lower(correct: int, total: int) -> float | None:
    if not total:
        return None
    z = 1.959963984540054
    p = correct / total
    return (p + z*z/(2*total) - z*math.sqrt((p*(1-p) + z*z/(4*total))/total)) / (1 + z*z/total)


def score(cases: list[dict], outcomes: dict[str, str]) -> dict:
    held = [case for case in cases if case["split"] == "holdout"]
    yes = sum(case["label"] == "yes" for case in held)
    no = len(held) - yes
    tp = sum(case["label"] == "yes" and outcomes[case["case_id"]] == "yes" for case in held)
    tn = sum(case["label"] == "no" and outcomes[case["case_id"]] == "no" for case in held)
    fp = sum(case["label"] == "no" and outcomes[case["case_id"]] == "yes" for case in held)
    fn = sum(case["label"] == "yes" and outcomes[case["case_id"]] == "no" for case in held)
    unknown = len(held) - tp - tn - fp - fn
    answered = len(held) - unknown
    return {"heldout_total": len(held), "positive_denominator": yes, "negative_denominator": no,
            "tp": tp, "tn": tn, "fp": fp, "fn": fn, "unknown": unknown,
            "coverage": answered / len(held) if held else None,
            "accuracy_all_including_unknown_as_incorrect": (tp+tn) / len(held) if held else None,
            "sensitivity_all": tp / yes if yes else None, "specificity_all": tn / no if no else None,
            "positive_wilson_lower_95": wilson_lower(tp, yes),
            "negative_wilson_lower_95": wilson_lower(tn, no)}


def classify(probability: float | None) -> str:
    if probability is None or not math.isfinite(probability) or not 0 <= probability <= 1:
        return "unknown"
    return "yes" if probability >= HIGH else "no" if probability <= LOW else "unknown"


def predict(model, case: dict) -> str:
    state = {"top_pain": case["channel"], "evidence": case["safe_view"]}
    tokenizer = getattr(model, "tokenizer", None)
    text = json.dumps(state, ensure_ascii=True) + "\n" + QUESTION
    try:
        encoded = tokenizer(text, add_special_tokens=True) if tokenizer else None
        ids = encoded.get("input_ids", encoded) if isinstance(encoded, dict) else encoded
        count = len(ids[0] if ids and isinstance(ids[0], list) else ids) if ids is not None else len(text.split())
        config = getattr(model, "cfg", {})
        limit = config.get("max_len") if isinstance(config, dict) else None
        if not isinstance(limit, int) or limit > 1_000_000:
            limit = getattr(tokenizer, "model_max_length", 1024)
        if not isinstance(limit, int) or limit > 1_000_000 or count > limit:
            return "unknown"
        answer = model.predict(state, {"decision": {"type": "noul", "instructions": QUESTION}})["answers"]["decision"]["noul"]
        return classify(float(answer.item() if hasattr(answer, "item") else answer))
    except Exception:
        return "unknown"


def private_report(path: Path, root: Path, report: dict) -> None:
    if path.is_symlink() or not path.resolve().is_relative_to(root.resolve()):
        raise ValueError("report must remain beneath private evidence root")
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    fd, name = tempfile.mkstemp(prefix=".fleet-s1-", dir=path.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            json.dump(report, stream, sort_keys=True, indent=2, allow_nan=False)
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(name, path)
    finally:
        if os.path.exists(name):
            os.unlink(name)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--evidence-root", type=Path, required=True)
    parser.add_argument("--review", type=Path)
    parser.add_argument("--output", type=Path, required=True)
    parser.add_argument("--model", type=Path, default=MODEL)
    parser.add_argument("--run-local-model", action="store_true")
    args = parser.parse_args()
    os.umask(0o077)
    try:
        if (args.evidence_root.is_symlink() or not args.evidence_root.is_dir()
            or args.evidence_root.stat().st_mode & 0o077):
            raise ValueError("private candidate root unavailable")
        cases, review_sha = (reviewed_cases(args.evidence_root, args.review)
                             if args.review is not None else ([], None))
        held = [case for case in cases if case["split"] == "holdout"]
        yes = sum(case["label"] == "yes" for case in held)
        no = len(held) - yes
        ready = yes >= MIN_PER_CLASS and no >= MIN_PER_CLASS
        report = {"status": "missing_review" if args.review is None else
                  "ready_not_run" if ready else "missing_evidence",
                  "readiness": {"heldout_yes": yes, "heldout_no": no, "minimum_each_class": MIN_PER_CLASS,
                                "distinct_reviewed_groups": len(cases)},
                  "question_sha256": digest(QUESTION.encode()), "review_sha256": review_sha,
                  "model_snapshot": args.model.name, "scores": None,
                  "independent_review": ("absent" if args.review is None else
                                         "reviewer_assertion_only; source-group independence requires separate audit"),
                  "authority_eligible": False}
        if ready and args.run_local_model:
            os.environ["HF_HUB_OFFLINE"] = "1"
            os.environ["TRANSFORMERS_OFFLINE"] = "1"
            os.environ["HF_DATASETS_OFFLINE"] = "1"
            if not args.model.is_dir():
                raise ValueError("pinned local model snapshot absent")
            import laya
            model = laya.load(str(args.model), subfolder="typed-decisions", device="cpu")
            outcomes = {case["case_id"]: predict(model, case) for case in held}
            scores = score(cases, outcomes)
            report.update(status="measured_diagnostic", scores=scores, case_outcomes=outcomes,
                          point_estimate_90=all(scores[key] is not None and scores[key] >= 0.90
                                                for key in ("coverage", "accuracy_all_including_unknown_as_incorrect",
                                                            "sensitivity_all", "specificity_all")))
        private_report(args.output, args.evidence_root, report)
        print(json.dumps({"status": report["status"], "readiness": report["readiness"],
                          "authority_eligible": False, "output": str(args.output)}))
        return 2 if not ready else 0
    except (OSError, ValueError, ImportError, KeyError, TypeError) as exc:
        print(f"fleet S1 trial UNKNOWN: {type(exc).__name__}: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
