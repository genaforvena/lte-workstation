#!/usr/bin/env bash
# mesh-delta — GENERIC stateful-diff FILTER: the channel primitive's "delta" step (operator's pattern).
# Reads the current STATE on STDIN (any text — a state-fn's output), diffs the line-SET against the
# stored LAST state for <statekey>, and emits on STDOUT a prompt-to-feed-a-mind ONLY when lines were
# ADDED or REMOVED (the significant DELTA). No change ⇒ emits nothing (the expensive mind isn't engaged).
# Empty/failed input ⇒ nothing (empty≠failed: NEVER claim 'all gone' from a failed pull — pull-detects-
# death must come from the state-fn returning a real 'node dark' line, not from an empty read). First
# run seeds silently (don't flood the mind with the whole world as 'new').
#
# Generalizes mesh-presence-delta to ANY state — composes INTO the one primitive, zero edits to it:
#   mesh-stream <name> '<state-fn>' 'mesh-delta <name>' [mind]      # change → feed the mind
#   <state-fn> | mesh-delta <name> | mesh-chat                       # headless → route delta to BOARD
#
# Significance GATE (optional): --gate '<sed-expr>' normalizes each line BEFORE the set-diff, so volatile
# noise is not a delta (e.g. drop RSSI:  --gate 's/^-?[0-9]+\|//'  → ±2dB jitter ignored, only mac|name).
#
#   mesh-delta <statekey> [--gate '<sed-expr>']        filter mode (stdin → delta or nothing)
#   mesh-delta --test                                  smoke (synth dry-run asserts add/remove detection)
set -uo pipefail
STORE="$HOME/.mesh/.delta"

if [ "${1:-}" = --test ]; then
  for x in mktemp grep awk sort comm sed; do command -v "$x" >/dev/null 2>&1 || { echo "smoke-test: FAIL (no $x)"; exit 1; }; done
  tmp="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }; trap 'rm -rf "$tmp"' EXIT
  # first run seeds silently
  out1="$(printf 'a\nb\n' | HOME="$tmp" "$0" k 2>&1)" || { echo "smoke-test: FAIL (first-run rc: $out1)"; exit 1; }
  [ -z "$out1" ] || { echo "smoke-test: FAIL (first run should be silent, got: $out1)"; exit 1; }
  # second run: b stays, c arrives, a departs → emit ADDED c + REMOVED a
  out2="$(printf 'b\nc\n' | HOME="$tmp" "$0" k 2>&1)" || { echo "smoke-test: FAIL (delta rc: $out2)"; exit 1; }
  printf '%s\n' "$out2" | grep -q '^ADDED:'   || { echo "smoke-test: FAIL (no ADDED: $out2)"; exit 1; }
  printf '%s\n' "$out2" | grep -q '^REMOVED:' || { echo "smoke-test: FAIL (no REMOVED: $out2)"; exit 1; }
  printf '%s\n' "$out2" | grep -qx '  + c'    || { echo "smoke-test: FAIL (no +c: $out2)"; exit 1; }
  printf '%s\n' "$out2" | grep -qx '  - a'    || { echo "smoke-test: FAIL (no -a: $out2)"; exit 1; }
  printf '%s\n' "$out2" | grep -q 'do NOT post \[ack\]' || { echo "smoke-test: FAIL (ack-silence prompt missing: $out2)"; exit 1; }
  # no change → silent
  out3="$(printf 'b\nc\n' | HOME="$tmp" "$0" k 2>&1)"
  [ -z "$out3" ] || { echo "smoke-test: FAIL (no-change should be silent, got: $out3)"; exit 1; }
  # empty input → silent (empty != failed, never 'all gone')
  out4="$(printf '' | HOME="$tmp" "$0" k 2>&1)"
  [ -z "$out4" ] || { echo "smoke-test: FAIL (empty input should be silent, got: $out4)"; exit 1; }
  # gate: a volatile leading number is normalized away → no spurious delta
  printf '5|x\n' | HOME="$tmp" "$0" g --gate 's/^[0-9]*|//' >/dev/null 2>&1
  out5="$(printf '9|x\n' | HOME="$tmp" "$0" g --gate 's/^[0-9]*|//' 2>&1)"
  [ -z "$out5" ] || { echo "smoke-test: FAIL (gate should suppress numeric jitter, got: $out5)"; exit 1; }
  echo "smoke-test: ok"; exit 0
fi

KEY="${1:?usage: mesh-delta <statekey> [--gate '<sed-expr>']  (reads state on stdin)}"
GATE=""; [ "${2:-}" = --gate ] && GATE="${3:-}"
case "$KEY" in */*|..|.) echo "mesh-delta: bad statekey '$KEY'" >&2; exit 2;; esac
mkdir -p "$STORE"
PREV="$STORE/$KEY.prev"

# current state → normalized, deduped, non-blank line set. The GATE (sed) strips volatile fields so
# micro-noise isn't a delta (the significance gate). Keep a raw copy for human-readable delta output.
raw="$(grep -vE '^[[:space:]]*$' 2>/dev/null || true)"
norm() { if [ -n "$GATE" ]; then sed "$GATE" 2>/dev/null; else cat; fi; }
cur="$(printf '%s\n' "$raw" | norm | sort -u)"
[ -z "${cur//[[:space:]]/}" ] && exit 0          # empty/failed pull → say nothing (empty != failed)

if [ ! -f "$PREV" ]; then printf '%s\n' "$cur" > "$PREV"; exit 0; fi   # first run: seed, silent

prev="$(cat "$PREV")"
added="$(comm -23 <(printf '%s\n' "$cur") <(printf '%s\n' "$prev"))"
removed="$(comm -13 <(printf '%s\n' "$cur") <(printf '%s\n' "$prev"))"
printf '%s\n' "$cur" > "$PREV"                    # advance state every cycle

[ -z "$added$removed" ] && exit 0                 # no significant delta → nothing to feed

# emit the DELTA as the prompt (the mind infers what to do from the change — no crafted instruction)
{
  echo "[$KEY] changed on $(hostname) — react if it matters to you; if nothing to act on, stay SILENT (do NOT post [ack]):"
  [ -n "$added"   ] && { echo "ADDED:";   printf '%s\n' "$added"   | sed 's/^/  + /'; } || true
  [ -n "$removed" ] && { echo "REMOVED:"; printf '%s\n' "$removed" | sed 's/^/  - /'; } || true
}
