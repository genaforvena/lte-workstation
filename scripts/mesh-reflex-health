#!/usr/bin/env bash
# mesh-reflex-health — catch a reflex that is SCHEDULED but DEAD: cron-present and smoke-passing,
# yet failing every actual run, so its per-run artifact goes STALE. This is the "wired-but-dead"
# blind spot that the other reflex-tenders miss:
#   - mesh-reflexes     heals cron DROPS (reflex fell out of crontab) — not a still-scheduled failure
#   - mesh-reflex-decay autophagy of UNUSED+smoke-failing reflexes — not one that smoke-passes
# Example it catches: the router goes permanently unreachable → mesh-router-watch keeps running on
# */15 but never refreshes .router-thermal-state → thermal protection is silently gone, nothing notices.
#
# Edge-triggered (trustworthy-signal: alarm the PROBLEM and its RESOLUTION; suppress transients).
#   mesh-reflex-health           check + edge-trigger [reflex-stale]/[reflex-ok] on the board
#   mesh-reflex-health --check   read-only report (no board post)
#   mesh-reflex-health --test    smoke test
#
# SELF-GROUNDING (second-order: who watches the top watcher?). This IS the top of the reflex-
# observation regress — it catches reflexes that are cron-present but DEAD. Yet it carried no
# `# reflex-cadence:` of its own, so a reorg that dropped it from crontab could NOT be re-wired by
# mesh-autowire (the exact `[[reflex-cadence-or-reorg-orphans-it]]` death mode it exists to detect,
# applied to ITSELF) — and nothing would notice the watchdog had gone silent. The regress must
# terminate; declaring our cadence keeps the terminating observer alive. (autowire is idempotent —
# it skips a tool already in crontab — so this never double-schedules the live */10 entry.) The
# DEEPER closure (an INDEPENDENT tool grounding our own .reflex-health-state freshness from OUTSIDE
# this loop — a dead reflex-health can't check itself) is the proposed next step; see the artifact.
# reflex-cadence: */10 * * * *
#
# SCOPE (honest): only reflexes that write a PER-RUN artifact are liveness-checkable here. Silent-on-
# no-news reflexes (e.g. mesh-lan-newdevice) have no idle heartbeat — they'd need a beat-touch every
# run to be checkable; tracked as future work, NOT silently assumed healthy.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
M="$HOME/.mesh"; STATE="$M/.reflex-health-state"

# reflex-name | per-run artifact | MAX-AGE INTENT TOKEN | cron tool (node-aware skip)
# MAX-AGE IS DERIVED, NOT A LITERAL (2026-06-24, chat-review/maxage-from-cadence — ends the phantom-stale
# whack-a-mole). The 3rd column is an INTENT token resolved by eff_maxage() against the LIVE cron stride
# (single source of truth = reflexes.cron/crontab, never a duplicated number):
#   @auto        → max_age = (this tool's cron stride)×2. SELF-ADJUSTS to a throttle (the throttle IS in
#                  the cron we read), so the old hand-widened literals for thermal-throttle are now moot.
#   @auto=PARENT → derive from PARENT's stride (a reflex sub-called by another, with no own cron line).
#   @cond        → CONDITIONAL-WRITE (feed/generate: `pace_gate||exit 0` WITHOUT writing on quiet/all-busy
#                  ticks) → mtime is NOT liveness at ANY threshold → NOT WATCHABLE, excluded outright
#                  (cadence×2 would only move the phantom to a longer fuse — the feed lesson below).
#   <number>     → explicit literal, ONLY for a reflex with no derivable cron line (lan-newdevice).
# The per-reflex paragraphs below are HISTORICAL tuning rationale (the literals they cite are now GONE);
# they record WHY live-cron×2 is safe under the 2026-06-24 /10→/30 throttle, and the touch-every-run vs
# source-coupled distinction that decides watchability.
#   egress-health  */3  → log appended every run → expect < 10m
#   router-watch   */15 → .router-thermal-state rewritten every run → expect < 35m
#   lan-newdevice  sub-called by mesh-perimeter. Threshold 6300s/105m tolerates perimeter's
#                  THERMAL-THROTTLED /45 cadence (was /15; throttled alongside psi/sense-evolve
#                  2026-06-24 ~14:00). Preserves the original 2.33× ratio (2100s/15m → 6300s/45m);
#                  ARP fallback keeps the beat fresh even when router DHCP is down, so staleness
#                  past 105m = the watch genuinely blind, not the /45 cadence tail.
#   AUTOPOIESIS lanes:
#   sense-evolve  */10 → sense-evolve.log appended every run (inject OR defer/throttle). Threshold
#                        4500s/75m tolerates the thermal-throttled /30 cadence (see psi note below) →
#                        no false (stale flap in the /30 tail; real-death detection still well-bounded.
#   (generate is NOT watched: its log is silent when the backlog is full → would false-alarm.)
#   (feed is NOT watched [2026-06-24, registry line REMOVED — the decision below was half-applied: the
#    rationale was written but `feed|$M/feed.log|600|mesh-feed` was left in REFLEXES and kept firing the
#    false-DEAD it warns about (empty-backlog/all-busy ticks `pace_gate || exit 0` WITHOUT logging → feed.log
#    frozen during low-work despite the lane firing every */25; 600s < 1500s cadence anyway). Removed now.]:
#    lazy-pace `pace_gate || exit 0` (spend-governor `mesh-pace feed`,
#    added 2026-06-21) + all-busy/empty-backlog ticks exit WITHOUT logging → feed.log is work+spend-
#    conditional, legitimately silent >10m (spend-pace spreads over the 5h window) → SAME false-alarm
#    class as generate. The old `feed|...|600` here flapped STALE every ~15m on healthy lazy-paced runs.
#    Cron-firing is the real liveness (verifiable via syslog CRON lines). To watch it HONESTLY, mesh-feed
#    would need to touch a beat-file every run regardless of pace — autopoiesis owner's call.)
#   SENSE reflexes — ONLY the TOUCH-EVERY-RUN class is watchable here: their artifact mtime is
#   refreshed on EVERY run regardless of whether the source is reachable, so staleness unambiguously
#   means the REFLEX itself died (not a legitimately-offline phone/iMac). Source-coupled sense logs
#   (body-motion/body-power/light) go stale honestly when the phone is offline → NOT watchable (would
#   false-alarm during normal phone-away). arrivals is ALSO excluded: it exit-2s before writing state
#   when no BLE vantage is reachable → its staleness is ambiguous (BLE-wedge vs reflex-dead).
#   imac-wifi     */2  → .imac-wifi-state touched every run (UNREACHABLE-marked when iMac off-LAN).
#                        Threshold 1080s/18m (NOT header×3) tolerates the operating RANGE: header is
#                        */2 but cron actually runs */6 (360s cadence) — the old 360s threshold was
#                        exactly 1× that cadence → it false-alarmed in the tail of EVERY */6 cycle
#                        (phantom REFLEX REPAIR churn, 2026-06-24). 1080s = 3× the */6 cadence covers
#                        both */2 baseline and */6, without asserting which cadence is the policy (cron
#                        was in-flight; the steward owns it). Real-death = 3 consecutive */6 misses.
#   ambient-clock */10 → .ambient-clock.state touched every run (even on DATA-STALE path) → <25m
#   psi           */10 → .psi.state touched every run on the --edge unchanged-level path (2026-06-22:
#                        was DARK 4d — cron ran the plain form, never maintained .psi.state, so
#                        mesh-operator-focus fused a frozen STALLED as live; fixed + now watched).
#                        Threshold 4500s/75m (NOT header×2.5) tolerates the THERMAL-THROTTLED cadence:
#                        cron was throttled /10→/30 (2026-06-24, uniform across the autopoiesis reflexes
#                        to cool the box). A liveness threshold must cover the legitimate operating
#                        RANGE (/10 baseline ↔ /30 throttled), not false-alarm in the tail of each /30
#                        cycle → that flapping re-injected a phantom REFLEX REPAIR need every cycle
#                        (churn). Real-death detection stays ample (the DARK failure was 4 DAYS).
#   operator-focus 1-59/15 (every 15m) → .operator-focus.state touched every run on the --edge
#                        unchanged-verdict path (2026-06-22: was DARK ~32h — verdict stably STRESSED on a
#                        chronically psi=STALLED node never rewrote the state; fixed touch-every-run + now
#                        watched). 2026-06-24: max_age was 900s = EXACTLY 1× the 15m cron cadence (the
#                        comment wrongly said "*/5"), so normal cron jitter / sampling in the tail of each
#                        cycle tripped a chronic FALSE-DEAD → phantom REFLEX REPAIR. Raised to 1800s
#                        (cadence×2, the documented convention above) → one full missed-run of margin;
#                        real-death detection still ample (the DARK failure was 32h).
REFLEXES="egress-health|$M/egress-health.log|@auto|mesh-egress-health
router-watch|$M/.router-thermal-state|@auto|mesh-router-watch
lan-newdevice|$M/.lan-newdevice.beat|6300|mesh-lan-newdevice
sense-evolve|$M/sense-evolve.log|@auto|mesh-sense-evolve
imac-wifi|$M/.imac-wifi-state|@auto|mesh-imac-wifi
ambient-clock|$M/.ambient-clock.state|@auto|mesh-ambient-clock
psi|$M/.psi.state|@auto|mesh-psi
operator-focus|$M/.operator-focus.state|@auto|mesh-operator-focus
ambient-tape|$M/ambient-db-tape.tsv|@auto|mesh-ambient-tape
feed|$M/feed.log|@cond|mesh-feed
generate|$M/generate.log|@cond|mesh-generate"

# ── max_age DERIVATION (single source of truth = the LIVE cron stride; never a duplicated literal) ──
CRON_SRC="${MESH_CRON_SRC:-$M/reflexes.cron}"
cron_stride_s(){ # <tool> → its cron stride in SECONDS (0 = no derivable schedule found)
  local tool="$1" line min hr
  line="$(grep -hwE -- "$tool" "$CRON_SRC" 2>/dev/null | grep -vE '^[[:space:]]*#' | head -1)"
  [ -n "$line" ] || line="$(crontab -l 2>/dev/null | grep -hwE -- "$tool" | grep -vE '^[[:space:]]*#' | head -1)"
  [ -n "$line" ] || { echo 0; return; }
  min="$(printf '%s\n' "$line" | awk '{print $1}')"; hr="$(printf '%s\n' "$line" | awk '{print $2}')"
  case "$min" in
    \*/[0-9]*)        echo $(( ${min#*/} * 60 ));;           # */N            → every N min
    [0-9]*-*/[0-9]*)  echo $(( ${min##*/} * 60 ));;          # M-E/N          → every N min (stepped range)
    *[,?]*)           echo 0;;                               # list / unsupported → un-derivable
    [0-9]*)           case "$hr" in                          # bare minute → consult the HOUR field
                        \*)         echo 3600;;              # M * * * *     → hourly
                        \*/[0-9]*)  echo $(( ${hr#*/} * 3600 ));;  # M */H * * * → every H hours
                        *)          echo 86400;;             # M H * * *     → daily
                      esac;;
    *)                echo 0;;
  esac
}
eff_maxage(){ # <intent-token> <tool> → max_age seconds, or "skip" (conditional-write / un-derivable)
  local raw="$1" tool="$2" s
  case "$raw" in
    @cond)    echo skip;;                                                          # not watchable, ever
    @auto)    s="$(cron_stride_s "$tool")";          [ "${s:-0}" -gt 0 ] && echo $((s*2)) || echo skip;;
    @auto=*)  s="$(cron_stride_s "${raw#@auto=}")";  [ "${s:-0}" -gt 0 ] && echo $((s*2)) || echo skip;;
    *)        echo "$raw";;                                                        # explicit literal
  esac
}

# ── DEBOUNCE (watchdog-debounce 2026-06-24): require N>=2 CONSECUTIVE failed probes before a target
# flips DOWN. A SINGLE transient fail (torn read, momentary SSH timeout, a daemon mid-restart — e.g. an
# overhear restart) stays UP, killing the false-DOWN alarm. The consecutive-fail counter is persisted
# per-target across runs in ~/.mesh/.debounce/<key>; the FIRST success resets it (flip back UP at once).
DEBOUNCE_DIR="${MESH_DEBOUNCE_DIR:-$M/.debounce}"
DEBOUNCE_N="${MESH_DEBOUNCE_N:-2}"
debounce(){ # <key> <ok|fail> [peek] → effective verdict UP|DOWN; mutates the counter UNLESS peek (read-only)
  local key="$1" probe="$2" mode="${3:-}" f n
  key="$(printf '%s' "$key" | tr -c 'A-Za-z0-9._-' '_')"   # filesystem-safe key
  f="$DEBOUNCE_DIR/$key"
  mkdir -p "$DEBOUNCE_DIR" 2>/dev/null || true
  n="$(cat "$f" 2>/dev/null || echo 0)"; [ "$n" -eq "$n" ] 2>/dev/null || n=0      # guard non-integer
  if [ "$probe" = ok ]; then                                                       # success → reset, UP
    [ "$mode" = peek ] || rm -f "$f" 2>/dev/null || true; echo UP; return; fi
  n=$((n+1))                                                                        # fail → ++consecutive
  [ "$mode" = peek ] || printf '%s\n' "$n" > "$f" 2>/dev/null || true
  [ "$n" -ge "$DEBOUNCE_N" ] && echo DOWN || echo UP                                # DOWN only at N consec.
}

if [ "${1:-}" = --test ]; then
  failures=0
  for dep in stat date crontab grep cat printf; do
    command -v "$dep" >/dev/null 2>&1 || { echo "smoke-test: FAIL ($dep missing)"; failures=1; }
  done
  command -v mesh-chat >/dev/null 2>&1 || echo "smoke-test: WARN (mesh-chat missing — edge alerts silent)"
  # verify REFLEXES table is parseable: each max-age col is a valid intent token or positive literal
  while IFS='|' read -r name art maxage tool; do
    [ -n "$name" ] || continue
    case "$maxage" in
      @auto|@auto=*|@cond) : ;;
      *) [ "$maxage" -gt 0 ] 2>/dev/null || { echo "smoke-test: FAIL (bad max-age token '$maxage' for $name)"; failures=1; } ;;
    esac
  done <<EOF
$REFLEXES
EOF
  # DERIVATION asserts (the heart of maxage-from-cadence): against a SYNTHETIC cron, eff_maxage must
  # resolve @auto to cron-stride×2 for a WATCHABLE reflex AND keep a CONDITIONAL-write one EXCLUDED.
  _tcron="$(mktemp)"; printf '%s\n' \
    '*/10 * * * * $HOME/.local/bin/mesh-foo >> x 2>&1' \
    '7-59/30 * * * * $HOME/.local/bin/mesh-bar --edge' \
    '23 * * * * $HOME/.local/bin/mesh-hourly' > "$_tcron"
  _str(){ CRON_SRC="$_tcron" cron_stride_s "$1"; }
  _d(){   CRON_SRC="$_tcron" eff_maxage "$1" "$2"; }
  [ "$(_str mesh-foo)"    = 600 ]  || { echo "smoke-test: FAIL (*/10 stride≠600: $(_str mesh-foo))"; failures=1; }
  [ "$(_str mesh-bar)"    = 1800 ] || { echo "smoke-test: FAIL (7-59/30 stride≠1800: $(_str mesh-bar))"; failures=1; }
  [ "$(_str mesh-hourly)" = 3600 ] || { echo "smoke-test: FAIL (hourly stride≠3600: $(_str mesh-hourly))"; failures=1; }
  [ "$(_d @auto mesh-foo)"        = 1200 ] || { echo "smoke-test: FAIL (@auto */10 ≠ cron×2=1200: $(_d @auto mesh-foo))"; failures=1; }
  [ "$(_d @auto=mesh-bar mesh-x)" = 3600 ] || { echo "smoke-test: FAIL (@auto=PARENT ≠ parent stride×2=3600: $(_d @auto=mesh-bar mesh-x))"; failures=1; }
  [ "$(_d @cond mesh-feed)"       = skip ] || { echo "smoke-test: FAIL (conditional-write reflex NOT excluded)"; failures=1; }
  [ "$(_d @auto mesh-nonexistent)" = skip ] || { echo "smoke-test: FAIL (@auto w/ no cron line must skip, not crash)"; failures=1; }
  [ "$(_d 6300 mesh-x)"           = 6300 ] || { echo "smoke-test: FAIL (explicit literal not preserved)"; failures=1; }
  rm -f "$_tcron"
  # DEBOUNCE asserts (watchdog-debounce): 1 fail = still UP, 2 consecutive = DOWN, a success resets the counter.
  _dbd="$(mktemp -d)"; _db(){ DEBOUNCE_DIR="$_dbd" debounce "$@"; }
  [ "$(_db t1 fail)" = UP ]   || { echo "smoke-test: FAIL (debounce: 1st fail must stay UP, got DOWN)"; failures=1; }
  [ "$(_db t1 fail)" = DOWN ] || { echo "smoke-test: FAIL (debounce: 2nd CONSECUTIVE fail must flip DOWN)"; failures=1; }
  [ "$(_db t1 fail)" = DOWN ] || { echo "smoke-test: FAIL (debounce: sustained fail stays DOWN)"; failures=1; }
  [ "$(_db t1 ok)"   = UP ]   || { echo "smoke-test: FAIL (debounce: a success must flip UP immediately)"; failures=1; }
  [ "$(_db t1 fail)" = UP ]   || { echo "smoke-test: FAIL (debounce: counter must RESET after success — 1 fail = UP again)"; failures=1; }
  # peek (read-only): repeated peek-fails must NOT advance the counter (a manual --check can't force DOWN)
  [ "$(_db t2 fail peek)" = UP ] || { echo "smoke-test: FAIL (debounce peek: 1st fail UP)"; failures=1; }
  [ "$(_db t2 fail peek)" = UP ] || { echo "smoke-test: FAIL (debounce peek must NOT mutate — still UP, not DOWN)"; failures=1; }
  rm -rf "$_dbd"
  [ "$(printf '%s' "$REFLEXES" | awk -F'|' '{print $1}' | sort | uniq -d | grep -cvE '^[[:space:]]*$')" = 0 ] \
    || { echo "smoke-test: FAIL (duplicate reflex names)"; failures=1; }
  # synthetic fixture: stat/date + staleness classification
  tmp=$(mktemp -d) || { echo "smoke-test: FAIL (mktemp)"; failures=1; }
  now=$(date +%s)
  # fresh file: just touched, age should be small
  touch "$tmp/fresh.log"
  mt=$(stat -c %Y "$tmp/fresh.log" 2>/dev/null || echo 0)
  age=$((now - mt))
  [ "$age" -ge 0 ] || { echo "smoke-test: FAIL (fresh file age=$age negative)"; failures=1; }
  [ "$age" -le 5 ] || { echo "smoke-test: FAIL (fresh file age=$age >5s)"; failures=1; }
  # stale file: 20 min old mtime, age should exceed 600s threshold
  touch -t "$(date -d '20 min ago' +%m%d%H%M.%S 2>/dev/null)" "$tmp/stale.log"
  mt=$(stat -c %Y "$tmp/stale.log" 2>/dev/null || echo 0)
  age=$((now - mt))
  [ "$age" -ge 600 ] || { echo "smoke-test: FAIL (stale file age=$age <600)"; failures=1; }
  # missing file: should not exist
  [ ! -e "$tmp/missing.log" ] || { echo "smoke-test: FAIL (missing.log unexpectedly exists)"; failures=1; }
  # edge-trigger state machine sanity: OK→STALE→OK transition
  echo OK > "$tmp/state"
  prev=$(cat "$tmp/state" 2>/dev/null || echo OK)
  [ "$prev" = OK ] || { echo "smoke-test: FAIL (state readback=$prev)"; failures=1; }
  echo STALE > "$tmp/state"
  prev=$(cat "$tmp/state" 2>/dev/null || echo OK)
  [ "$prev" = STALE ] || { echo "smoke-test: FAIL (state readback=$prev after STALE)"; failures=1; }
  # node-aware gate: a PARENT-DRIVEN reflex (tool NOT in cron, artifact EXISTS) must be WATCHED, not
  # skipped (the mesh-lan-newdevice-via-perimeter case). A reflex with neither cron entry nor artifact
  # must be SKIPPED (no false 'missing' on a node that never runs it). gate = inCron || artifactExists.
  fakecron="*/3 * * * * mesh-egress-health"   # contains egress-health, NOT lan-newdevice
  touch "$tmp/.drivenbeat"   # parent-driven reflex's artifact present
  watched(){ local tool="$1" art="$2"; if ! printf '%s' "$fakecron" | grep -q "$tool" && [ ! -e "$art" ]; then echo skip; else echo watch; fi; }
  [ "$(watched mesh-lan-newdevice "$tmp/.drivenbeat")" = watch ] || { echo "smoke-test: FAIL (parent-driven reflex with artifact was skipped)"; failures=1; }
  [ "$(watched mesh-lan-newdevice "$tmp/.noart")" = skip ]      || { echo "smoke-test: FAIL (unscheduled reflex w/o artifact not skipped)"; failures=1; }
  [ "$(watched mesh-egress-health "$tmp/.noart")" = watch ]     || { echo "smoke-test: FAIL (directly-scheduled reflex was skipped)"; failures=1; }
  rm -rf "$tmp"
  ((failures)) && exit 1
  echo "smoke-test: ok (dep checks + REFLEXES token parse + max_age DERIVATION asserts [@auto=cron×2, @cond excluded, literal kept] + DEBOUNCE asserts [1 fail=UP, 2 consec=DOWN, success resets] + synthetic staleness fixture + node-aware gate 3 assertions)"
  exit 0
fi

# ── THE REFRAIN (RITORNELLO): a fresh BEAT is not an OPEN refrain — freshness can mask a closed loop ──
# CROSS-DOMAIN TRANSFER (D&G → distributed sensor mesh). Deleuze & Guattari's *refrain/ritornello*
# (A Thousand Plateaus, 1980, plateau 11 "1837: Of the Refrain") is the operation by which a
# rhythmic motif carves a TERRITORY out of chaos — and it has THREE simultaneous moments:
#   (1) a POINT OF ORDER in chaos — "a child in the dark… sings under his breath" — a fragile
#       stabilising centre, the bare mark "I am here / I am alive";
#   (2) the TERRITORIAL CIRCLE — drawing a rhythmic wall that organises an inside vs an outside;
#   (3) the OPENING — "one opens the circle a crack… lets someone in, or launches forth" — the
#       refrain COUPLES to a live outside (the cosmos). A refrain that NEVER opens hardens into a
#       "black hole": pure mechanical repetition that has STOPPED producing territory.
# (Kleinherenbrink, "Territory and Ritornello: Deleuze and Guattari on Thinking Living Beings",
#  Deleuze Studies 9.2, Edinburgh UP 2015, doi 10.3366/dls.2015.0183 — the Chaos[milieu+rhythm] →
#  Earth[territory] → Cosmos[opening] triad, applied to nonorganic/social formations, which is the
#  cross-domain licence; "The Problem of Modulation in D&G: Re-orienting the Ritornello Vis-à-vis
#  Droning", ResearchGate 2025 — droning = repetition WITHOUT the opening, i.e. the closed-loop case.)
#
# WHERE IT BITES — this very staleness loop (below, :~150-162). Our liveness check is purely
# mtime-FRESHNESS: age = now − mtime(artifact) vs maxage. That measures refrain MOMENT 1 ONLY — is
# the beat present? — and (via artifact-exists) moment 2. It does NOT measure moment 3, the OPENING.
# This became a real blind spot the moment "touch-every-run" became our liveness pattern (mesh-psi
# fix this session, 5a882b4; mirrored from mesh-ambient-clock): touch-every-run advances mtime EVEN
# WHEN THE VALUE IS UNCHANGED — correct for liveness, but it makes a FRESH beat indistinguishable
# from an OPEN refrain. A wedged probe that returns its last reading forever, while its reflex
# dutifully touches the artifact each run, is a CLOSED refrain / black hole: mtime-fresh + value-dead,
# and THIS loop reads it as healthy. The live referent is mesh-psi itself: the cron beat ran every
# 10m (lease-fresh, log fresh) yet .psi.state was frozen 4 days — a closed circle the freshness frame
# could not see (cf. [[liveness-is-lease-not-cached-status]] = announce-with-TTL, which touch-every-run
# SATISFIES; the refrain names the finer cut freshness alone can't make — beat ≠ opening).
#
# HELD behavioural fix (instrument-first; steward/operator lands): for a reflex whose artifact is
# EXPECTED to vary (a sensor read, not a constant config), add a third class beside fresh/stale —
# OPEN vs CLOSED: flag a refrain that is mtime-fresh but VALUE-constant for ≫ its expected variation
# timescale as a possible wedged/closed loop. HELD because telling "the world is genuinely constant"
# from "the read is frozen" needs a per-reflex expected-variation model (a truly-stable sensor would
# false-alarm) — exactly the held-descriptor problem; naming the missing moment-3 check is shippable,
# the openness gate is not. NOT a duplicate of [[dash-reflex-age-vs-cadence]] (age-vs-cadence is still
# inside the moment-1 freshness frame) nor the embodied D&G axes (rhizome, territorialization,
# capacity-to-affect, desire-production, line-of-flight) — the refrain's three-moment grammar of
# territory-from-rhythm, and its closed-loop/black-hole danger, is a distinct un-embodied concept.
#
# reflex-name | per-run artifact | max_age_seconds (≈ cadence×2 + margin) | cron tool (node-aware skip)
#   egress-health  */3  → log appended every run → expect < 10m
#   router-watch   */15 → .router-thermal-state rewritten every run → expect < 35m
#   lan-newdevice  sub-called by mesh-perimeter (now /45-throttled) → expect < 105m (see table note)
# node-aware: watch a reflex if it's DIRECTLY scheduled here OR its per-run artifact already EXISTS.
# The artifact-exists clause closes a real blind spot: some reflexes are PARENT-DRIVEN, never a
# standalone cron entry — e.g. mesh-lan-newdevice is sub-called by mesh-perimeter (9-59/45), so a
# literal cron-grep for "mesh-lan-newdevice" misses it and its liveness goes UNWATCHED while it's
# actually running (if perimeter stopped driving it, or the LAN probe wedged, the beat would go
# stale and nothing here would notice). Artifact-exists is the honest liveness gate: a node that
# NEVER runs the reflex has no artifact → still skipped (no false 'missing'); a node that runs it
# (cron OR parent-driven) has the artifact → its staleness is now genuinely watched.
cron="$(crontab -l 2>/dev/null)"
now=$(date +%s); stale=""; checked=0; graced=""
# BOOT-GRACE (reboot-grace 2026-06-25): a freshly-rebooted node has not had time to repopulate its
# per-run artifacts — a missing/stale artifact within a reflex's (cron stride×2)s of boot is EXPECTED
# repopulation, NOT a dead reflex. Within that window we route the finding to the trace and NEVER fire
# [reflex-stale]. Uptime is read from /proc/uptime (seconds); the grace window is DERIVED per-reflex
# from the LIVE cron stride (cron_stride_s, the same single source of truth as max_age) — no literal.
# MESH_BOOT_UPTIME_S overrides uptime (test-only: simulate a just-booted node without rebooting).
UPTIME_S="${MESH_BOOT_UPTIME_S:-$(awk '{print int($1)}' /proc/uptime 2>/dev/null || echo 999999999)}"
# --check is a read-only probe → PEEK the debounce counter (don't mutate); only the scheduled (no-arg)
# run advances/resets it, so a manual --check can't accelerate a target toward DOWN.
_dbmode=""; [ "${1:-}" = --check ] && _dbmode=peek
while IFS='|' read -r name art maxage tool; do
  [ -n "$name" ] || continue
  eff="$(eff_maxage "$maxage" "$tool")"
  [ "$eff" = skip ] && continue   # @cond conditional-write OR un-derivable cron → NOT watchable (excluded)
  # skip ONLY when neither directly-scheduled here NOR producing an artifact (truly not this node's)
  if ! printf '%s' "$cron" | grep -q "$tool" && [ ! -e "$art" ]; then continue; fi
  checked=$((checked + 1))
  # raw probe: FAIL if the artifact is missing or older than the derived max_age, else OK
  if [ ! -e "$art" ]; then raw=fail; detail="missing"
  else
    mt=$(stat -c %Y "$art" 2>/dev/null || echo 0); age=$(( now - mt ))
    if [ "$age" -gt "$eff" ]; then raw=fail; detail="stale ${age}s>${eff}s"; else raw=ok; detail=""; fi
  fi
  # BOOT-GRACE: within (this reflex's cron stride×2)s of boot, a missing/stale artifact is post-reboot
  # repopulation, not death → collect for a single trace line and skip (never reaches the stale list /
  # debounce / alert). Grace window derived from the live cron; eff (already = stride×2 for @auto) is the
  # fallback when the stride is un-derivable (parent-driven reflex with no own cron line).
  if [ "$raw" = fail ]; then
    _gstride="$(cron_stride_s "$tool")"; [ "${_gstride:-0}" -gt 0 ] && _grace=$((_gstride*2)) || _grace="$eff"
    if [ "$UPTIME_S" -lt "$_grace" ]; then graced="$graced ${name}($detail)"; continue; fi
  fi
  # DEBOUNCE: declare stale only after N>=2 CONSECUTIVE fails; a single transient (torn read / mid-restart) stays quiet
  if [ "$raw" = fail ]; then
    [ "$(debounce "rh.$name" fail "$_dbmode")" = DOWN ] && stale="$stale ${name}($detail, ${DEBOUNCE_N}+ consecutive)"
  else
    debounce "rh.$name" ok "$_dbmode" >/dev/null   # success → reset the consecutive-fail counter (flip back UP at once)
  fi
done <<EOF
$REFLEXES
EOF
stale="${stale# }"; graced="${graced# }"

if [ "${1:-}" = --check ]; then
  if [ -n "$stale" ]; then echo "reflex-health: STALE →$stale"; exit 1
  elif [ "$checked" -eq 0 ]; then echo "reflex-health: n/a (no per-run reflexes scheduled on this node)"; exit 0
  else echo "reflex-health: ok ($checked per-run reflex(es) fresh${graced:+ · boot-grace suppressed: $graced})"; exit 0; fi
fi

# boot-grace findings go to the TRACE, never the board alert (scheduled runs only — keep --check read-only)
[ -n "$graced" ] && command -v mesh-trace >/dev/null 2>&1 && \
  mesh-trace "[reflex-grace] post-reboot suppression (uptime ${UPTIME_S}s < stride×2): $graced — repopulating, not dead" >/dev/null 2>&1 || true

# edge-trigger against last state
prev="$(cat "$STATE" 2>/dev/null || echo OK)"
if [ -n "$stale" ]; then
  echo STALE > "$STATE"
  if [ "$prev" != STALE ] && command -v mesh-chat >/dev/null 2>&1; then
    MESH_WHO="reflex-health@$(hostname)" mesh-chat "[reflex-stale] a scheduled reflex is DEAD (cron-present but its per-run artifact went stale): $stale — it smoke-passes so the other tenders miss it. Check the reflex + its dependency (e.g. router reachable?)." >/dev/null 2>&1
  fi
  exit 1
else
  echo OK > "$STATE"
  if [ "$prev" = STALE ] && command -v mesh-chat >/dev/null 2>&1; then
    MESH_WHO="reflex-health@$(hostname)" mesh-chat "[reflex-ok] reflexes recovered — all per-run artifacts fresh again." >/dev/null 2>&1
  fi
  exit 0
fi
