#!/usr/bin/env bash
# mesh-reflex-health — catch a reflex that is SCHEDULED but DEAD: cron-present and smoke-passing,
# yet failing every actual run, so its per-run artifact goes STALE. This is the "wired-but-dead"
# blind spot that the other reflex-tenders miss:
#   - mesh-reflexes     heals cron DROPS (reflex fell out of crontab) — not a still-scheduled failure
#   - mesh-reflex-decay autophagy of UNUSED+smoke-failing reflexes — not one that smoke-passes
# Example it catches: the router goes permanently unreachable → mesh-router-watch keeps running on
# */15 but never refreshes .router-thermal-state → thermal protection is silently gone, nothing notices.
#
# Edge-triggered (trustworthy-signal: alarm the PROBLEM and its RESOLUTION; suppress transients).
#   mesh-reflex-health           check + edge-trigger [reflex-stale]/[reflex-ok] on the board
#   mesh-reflex-health --check   read-only report (no board post)
#   mesh-reflex-health --test    smoke test
#
# SELF-GROUNDING (second-order: who watches the top watcher?). This IS the top of the reflex-
# observation regress — it catches reflexes that are cron-present but DEAD. Yet it carried no
# `# reflex-cadence:` of its own, so a reorg that dropped it from crontab could NOT be re-wired by
# mesh-autowire (the exact `[[reflex-cadence-or-reorg-orphans-it]]` death mode it exists to detect,
# applied to ITSELF) — and nothing would notice the watchdog had gone silent. The regress must
# terminate; declaring our cadence keeps the terminating observer alive. (autowire is idempotent —
# it skips a tool already in crontab — so this never double-schedules the live */10 entry.) The
# DEEPER closure (an INDEPENDENT tool grounding our own .reflex-health-state freshness from OUTSIDE
# this loop — a dead reflex-health can't check itself) is the proposed next step; see the artifact.
# reflex-cadence: */10 * * * *
#
# SCOPE (honest): only reflexes that write a PER-RUN artifact are liveness-checkable here. Silent-on-
# no-news reflexes (e.g. mesh-lan-newdevice) have no idle heartbeat — they'd need a beat-touch every
# run to be checkable; tracked as future work, NOT silently assumed healthy.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
M="$HOME/.mesh"; STATE="$M/.reflex-health-state"

# reflex-name | per-run artifact | MAX-AGE INTENT TOKEN | cron tool (node-aware skip)
# MAX-AGE IS DERIVED, NOT A LITERAL (2026-06-24, chat-review/maxage-from-cadence — ends the phantom-stale
# whack-a-mole). The 3rd column is an INTENT token resolved by eff_maxage() against the LIVE cron stride
# (single source of truth = reflexes.cron/crontab, never a duplicated number):
#   @auto        → max_age = (this tool's cron stride)×2. SELF-ADJUSTS to a throttle (the throttle IS in
#                  the cron we read), so the old hand-widened literals for thermal-throttle are now moot.
#   @auto=PARENT → derive from PARENT's stride (a reflex sub-called by another, with no own cron line).
#   @cond        → CONDITIONAL-WRITE (feed/generate: `pace_gate||exit 0` WITHOUT writing on quiet/all-busy
#                  ticks) → mtime is NOT liveness at ANY threshold → NOT WATCHABLE, excluded outright
#                  (cadence×2 would only move the phantom to a longer fuse — the feed lesson below).
#   <number>     → explicit literal, ONLY for a reflex with no derivable cron line (lan-newdevice).
# The per-reflex paragraphs below are HISTORICAL tuning rationale (the literals they cite are now GONE);
# they record WHY live-cron×2 is safe under the 2026-06-24 /10→/30 throttle, and the touch-every-run vs
# source-coupled distinction that decides watchability.
#   egress-health  */3  → log appended every run → expect < 10m
#   router-watch   */15 → .router-thermal-state rewritten every run → expect < 35m
#   lan-newdevice  sub-called by mesh-perimeter. Threshold 6300s/105m tolerates perimeter's
#                  THERMAL-THROTTLED /45 cadence (was /15; throttled alongside psi/sense-evolve
#                  2026-06-24 ~14:00). Preserves the original 2.33× ratio (2100s/15m → 6300s/45m);
#                  ARP fallback keeps the beat fresh even when router DHCP is down, so staleness
#                  past 105m = the watch genuinely blind, not the /45 cadence tail.
#   AUTOPOIESIS lanes:
#   sense-evolve  */10 → sense-evolve.log appended every run (inject OR defer/throttle). Threshold
#                        4500s/75m tolerates the thermal-throttled /30 cadence (see psi note below) →
#                        no false (stale flap in the /30 tail; real-death detection still well-bounded.
#   (generate is NOT watched: its log is silent when the backlog is full → would false-alarm.)
#   (feed is NOT watched [2026-06-24, registry line REMOVED — the decision below was half-applied: the
#    rationale was written but `feed|$M/feed.log|600|mesh-feed` was left in REFLEXES and kept firing the
#    false-DEAD it warns about (empty-backlog/all-busy ticks `pace_gate || exit 0` WITHOUT logging → feed.log
#    frozen during low-work despite the lane firing every */25; 600s < 1500s cadence anyway). Removed now.]:
#    lazy-pace `pace_gate || exit 0` (spend-governor `mesh-pace feed`,
#    added 2026-06-21) + all-busy/empty-backlog ticks exit WITHOUT logging → feed.log is work+spend-
#    conditional, legitimately silent >10m (spend-pace spreads over the 5h window) → SAME false-alarm
#    class as generate. The old `feed|...|600` here flapped STALE every ~15m on healthy lazy-paced runs.
#    Cron-firing is the real liveness (verifiable via syslog CRON lines). To watch it HONESTLY, mesh-feed
#    would need to touch a beat-file every run regardless of pace — autopoiesis owner's call.)
#   SENSE reflexes — ONLY the TOUCH-EVERY-RUN class is watchable here: their artifact mtime is
#   refreshed on EVERY run regardless of whether the source is reachable, so staleness unambiguously
#   means the REFLEX itself died (not a legitimately-offline phone/iMac). Source-coupled sense logs
#   (body-motion/body-power/light) go stale honestly when the phone is offline → NOT watchable (would
#   false-alarm during normal phone-away). arrivals is ALSO excluded: it exit-2s before writing state
#   when no BLE vantage is reachable → its staleness is ambiguous (BLE-wedge vs reflex-dead).
#   imac-wifi     */2  → .imac-wifi-state touched every run (UNREACHABLE-marked when iMac off-LAN).
#                        Threshold 1080s/18m (NOT header×3) tolerates the operating RANGE: header is
#                        */2 but cron actually runs */6 (360s cadence) — the old 360s threshold was
#                        exactly 1× that cadence → it false-alarmed in the tail of EVERY */6 cycle
#                        (phantom REFLEX REPAIR churn, 2026-06-24). 1080s = 3× the */6 cadence covers
#                        both */2 baseline and */6, without asserting which cadence is the policy (cron
#                        was in-flight; the steward owns it). Real-death = 3 consecutive */6 misses.
#   ambient-clock */10 → .ambient-clock.state touched every run (even on DATA-STALE path) → <25m
#   psi           */10 → .psi.state touched every run on the --edge unchanged-level path (2026-06-22:
#                        was DARK 4d — cron ran the plain form, never maintained .psi.state, so
#                        mesh-operator-focus fused a frozen STALLED as live; fixed + now watched).
#                        Threshold 4500s/75m (NOT header×2.5) tolerates the THERMAL-THROTTLED cadence:
#                        cron was throttled /10→/30 (2026-06-24, uniform across the autopoiesis reflexes
#                        to cool the box). A liveness threshold must cover the legitimate operating
#                        RANGE (/10 baseline ↔ /30 throttled), not false-alarm in the tail of each /30
#                        cycle → that flapping re-injected a phantom REFLEX REPAIR need every cycle
#                        (churn). Real-death detection stays ample (the DARK failure was 4 DAYS).
#   operator-focus 1-59/15 (every 15m) → .operator-focus.state touched every run on the --edge
#                        unchanged-verdict path (2026-06-22: was DARK ~32h — verdict stably STRESSED on a
#                        chronically psi=STALLED node never rewrote the state; fixed touch-every-run + now
#                        watched). 2026-06-24: max_age was 900s = EXACTLY 1× the 15m cron cadence (the
#                        comment wrongly said "*/5"), so normal cron jitter / sampling in the tail of each
#                        cycle tripped a chronic FALSE-DEAD → phantom REFLEX REPAIR. Raised to 1800s
#                        (cadence×2, the documented convention above) → one full missed-run of margin;
#                        real-death detection still ample (the DARK failure was 32h).
REFLEXES="egress-health|$M/egress-health.log|@auto|mesh-egress-health
router-watch|$M/.router-thermal-state|@auto|mesh-router-watch
lan-newdevice|$M/.lan-newdevice.beat|6300|mesh-lan-newdevice
sense-evolve|$M/sense-evolve.log|@auto|mesh-sense-evolve
imac-wifi|$M/.imac-wifi-state|@auto|mesh-imac-wifi
ambient-clock|$M/.ambient-clock.state|@auto|mesh-ambient-clock
psi|$M/.psi.state|@auto|mesh-psi
operator-focus|$M/.operator-focus.state|@auto|mesh-operator-focus
ambient-tape|$M/ambient-db-tape.tsv|@auto|mesh-ambient-tape
feed|$M/feed.log|@cond|mesh-feed
generate|$M/generate.log|@cond|mesh-generate"

# ── max_age DERIVATION (single source of truth = the LIVE cron stride; never a duplicated literal) ──
CRON_SRC="${MESH_CRON_SRC:-$M/reflexes.cron}"
cron_stride_from_fields(){ # <minute-field> <hour-field> → stride SECONDS (0 = un-derivable)
  # The pure cron→seconds arithmetic, factored out so a HEADER's `# reflex-cadence:` fields can be
  # resolved by the SAME code that resolves a deployed cron line (single source of truth — the Uxn
  # lease-audit resolver sources this instead of re-implementing the parse).
  local min="$1" hr="$2"
  case "$min" in
    \*/[0-9]*)        echo $(( ${min#*/} * 60 ));;           # */N            → every N min
    [0-9]*-*/[0-9]*)  echo $(( ${min##*/} * 60 ));;          # M-E/N          → every N min (stepped range)
    *[,?]*)           echo 0;;                               # list / unsupported → un-derivable
    [0-9]*)           case "$hr" in                          # bare minute → consult the HOUR field
                        \*)         echo 3600;;              # M * * * *     → hourly
                        \*/[0-9]*)  echo $(( ${hr#*/} * 3600 ));;  # M */H * * * → every H hours
                        *)          echo 86400;;             # M H * * *     → daily
                      esac;;
    *)                echo 0;;
  esac
}
cron_stride_s(){ # <tool> → its cron stride in SECONDS (0 = no derivable schedule found)
  local tool="$1" line min hr
  line="$(grep -hwE -- "$tool" "$CRON_SRC" 2>/dev/null | grep -vE '^[[:space:]]*#' | head -1)"
  [ -n "$line" ] || line="$(crontab -l 2>/dev/null | grep -hwE -- "$tool" | grep -vE '^[[:space:]]*#' | head -1)"
  [ -n "$line" ] || { echo 0; return; }
  min="$(printf '%s\n' "$line" | awk '{print $1}')"; hr="$(printf '%s\n' "$line" | awk '{print $2}')"
  cron_stride_from_fields "$min" "$hr"
}
eff_maxage(){ # <intent-token> <tool> → max_age seconds, or "skip" (conditional-write / un-derivable)
  local raw="$1" tool="$2" s
  case "$raw" in
    @cond)    echo skip;;                                                          # not watchable, ever
    @auto)    s="$(cron_stride_s "$tool")";          [ "${s:-0}" -gt 0 ] && echo $((s*2)) || echo skip;;
    @auto=*)  s="$(cron_stride_s "${raw#@auto=}")";  [ "${s:-0}" -gt 0 ] && echo $((s*2)) || echo skip;;
    *)        echo "$raw";;                                                        # explicit literal
  esac
}

# SOURCE GUARD: the Uxn lease-audit resolver sources this file (MESH_REFLEX_HEALTH_SOURCED=1) to reuse
# cron_stride_from_fields + eff_maxage as the ONE authority for cadence→lease derivation, WITHOUT running
# the live staleness check below. Everything above is pure function/var definitions (no side effects);
# a normal invocation leaves the flag unset and runs the whole tool as before.
{ [ -n "${MESH_REFLEX_HEALTH_SOURCED:-}" ] && return 0; } 2>/dev/null || :

# ── DEBOUNCE (watchdog-debounce 2026-06-24): require N>=2 CONSECUTIVE failed probes before a target
# flips DOWN. A SINGLE transient fail (torn read, momentary SSH timeout, a daemon mid-restart — e.g. an
# overhear restart) stays UP, killing the false-DOWN alarm. The consecutive-fail counter is persisted
# per-target across runs in ~/.mesh/.debounce/<key>; the FIRST success resets it (flip back UP at once).
# ── WAKE age (boot OR resume — suspend-grace 2026-07-06) ────────────────────────────────────────
# /proc/uptime counts SUSPENDED time (CLOCK_BOOTTIME), so uptime alone treats a laptop that slept
# 6h as "up 6h" — after resume EVERY per-run artifact is hours-stale until its next cron slot, and
# boot-grace (keyed on uptime) never engages. Worse, a --check sampled in that window peeks the
# debounce counter at n+1 (2026-07-05: the 21:00:01 scheduled run ticked fail #1, mesh-needs'
# 21:00:11 peek saw 1+1=2=DOWN) → phantom "ambient-clock DEAD" REFLEX REPAIR for a reflex that was
# fine and self-recovered at its next slot. Grace must key on the last WAKE, whichever is later:
# min(uptime, now − last-resume). Last resume comes from the journal (systemd-sleep "returned from
# sleep", this boot only); no journal access / never suspended → empty → plain uptime (server
# behavior unchanged). MESH_RESUME_TS overrides the journal read (test-only: simulate just-resumed).
wake_age_s(){ # <now-epoch> → seconds since the node last woke (boot or resume from suspend)
  local now="$1" up rts sr
  up="${MESH_BOOT_UPTIME_S:-$(awk '{print int($1)}' /proc/uptime 2>/dev/null || echo 999999999)}"
  rts="${MESH_RESUME_TS-$(journalctl -b -t systemd-sleep -o short-unix --no-pager 2>/dev/null \
        | grep -F 'returned from sleep' | tail -1 | awk '{print int($1)}')}"
  if [ -n "${rts:-}" ] && [ "$rts" -gt 0 ] 2>/dev/null; then
    sr=$(( now - rts ))
    if [ "$sr" -ge 0 ] && [ "$sr" -lt "$up" ]; then echo "$sr"; return; fi
  fi
  echo "$up"
}

DEBOUNCE_DIR="${MESH_DEBOUNCE_DIR:-$M/.debounce}"
DEBOUNCE_N="${MESH_DEBOUNCE_N:-2}"
debounce(){ # <key> <ok|fail> [peek] → effective verdict UP|DOWN; mutates the counter UNLESS peek (read-only)
  local key="$1" probe="$2" mode="${3:-}" f n
  key="$(printf '%s' "$key" | tr -c 'A-Za-z0-9._-' '_')"   # filesystem-safe key
  f="$DEBOUNCE_DIR/$key"
  mkdir -p "$DEBOUNCE_DIR" 2>/dev/null || true
  n="$(cat "$f" 2>/dev/null || echo 0)"; [ "$n" -eq "$n" ] 2>/dev/null || n=0      # guard non-integer
  if [ "$probe" = ok ]; then                                                       # success → reset, UP
    [ "$mode" = peek ] || rm -f "$f" 2>/dev/null || true; echo UP; return; fi
  n=$((n+1))                                                                        # fail → ++consecutive
  [ "$mode" = peek ] || printf '%s\n' "$n" > "$f" 2>/dev/null || true
  [ "$n" -ge "$DEBOUNCE_N" ] && echo DOWN || echo UP                                # DOWN only at N consec.
}

# ── OVERWRITE vs IDENTIFICATION: WHICH component of the interface supported the fresh verdict ──
# LITERATURE (live review 2026-07-24, information theory of agency — angle: cross-domain transfer to a
# distributed sensor mesh). R. Csaky, "Prediction and Empowerment: A Theory of Agency through Bridge
# Interfaces", arXiv:2605.06346 (submitted 7 May 2026, https://arxiv.org/abs/2605.06346). Sensing and
# actuation are modelled as BRIDGE INTERFACES, each split into an AGENT-OWNED parameter and an
# ENVIRONMENT-OWNED channel state. Theorem 3 / Proposition 1 prove a SEPARATION: perfect prediction is
# reachable by EITHER hidden-state IDENTIFICATION (the transcript is lossless for the target,
# H(Q|𝒯_T)=0) OR by OVERWRITE CONTROL — the agent makes the future target action-determined — and the
# paper exhibits "perfect prediction via overwrite despite I(Z;M_T)=0", i.e. a prediction objective
# MAXIMALLY satisfied while carrying ZERO bits about the world (its sibling case, distractor control,
# is high empowerment over a settable light with the task-relevant latent unresolved).
#
# WHERE IT BITES — the HELD refrain-openness fix below (:~386). Our liveness predicate is mtime, and
# the mesh's own liveness-touch convention (mesh-state-touch: touch on EVERY successful eval, so a
# long-stable value can't decay to a false STALE) makes mtime an AGENT-OWNED parameter BY
# CONSTRUCTION. A fresh verdict is therefore overwrite-satisfied: it is determined by our own action
# and cannot, at ANY threshold, separate "the reflex read the world" from "the reflex ran and its
# probe handed back last week's value" — mesh-psi mtime-fresh with .psi.state frozen 4 days; the
# mag/gyro empty-read class where cron was green while the state artifact aged 5 days. The refrain
# block named the missing moment (beat ≠ opening) and HELD the fix on needing a per-reflex
# expected-variation model. The bridge-interface split dissolves that blocker for the REPORTING half:
# no variation model is needed to state WHICH component of the interface carried the verdict — mtime
# (agent-owned) or content (environment-owned). Disclose provenance instead of guessing the world.
#
# SHIPPED (report-only, never an alarm — honest fusion, no faked all-clear in EITHER direction):
# overwrite_probe() digests the artifact's CONTENT ONLY (mtime deliberately excluded — it is the very
# agent-owned parameter under corroboration; the --test asserts this by moving mtime on an unchanged
# file and requiring the frozen clock to KEEP RUNNING) and reports how long an mtime-FRESH artifact's
# bytes have not moved. The floor is DERIVED, never a literal run-count: MESH_REFRAIN_MULT (default 4)
# × this reflex's own eff_maxage — the same live-cron authority the staleness threshold uses. A
# run-count floor would be silently vacuous for any watched reflex SLOWER than the health cadence
# (n runs of "unchanged" is just n runs inside one of its strides), which is the same class as a
# max_age literal that stops matching its cron. Past the floor the --check line and the trace annotate
# it `overwrite-only`; it never enters `stale`, never debounces, never fires [reflex-stale] — a
# genuinely-constant artifact is a legitimate reading, and calling it dead is exactly the false-STALE
# the touch convention exists to kill. NOT the fan-in axis below (blast radius of a STALE reflex ≠
# provenance of a FRESH verdict) and NOT age-vs-cadence (still inside moment-1 freshness).
REFRAIN_DIR="${MESH_REFRAIN_DIR:-$M/.refrain}"
REFRAIN_MULT="${MESH_REFRAIN_MULT:-4}"
overwrite_probe(){ # <key> <artifact> [peek] → "identified" | "overwrite:<seconds the content has not moved>"
  local key="$1" art="$2" mode="${3:-}" f dir dig prev pn nowts
  nowts="${MESH_REFRAIN_NOW:-$(date +%s)}"   # test-only override: simulate elapsed time without sleeping
  key="$(printf '%s' "$key" | tr -c 'A-Za-z0-9._-' '_')"   # filesystem-safe key
  # resolve the store at CALL time, not load time: REFRAIN_DIR is a load-time global, so a
  # `MESH_REFRAIN_DIR=… overwrite_probe …` prefix (how the --test isolates itself) would NOT rebind it
  # and the test would silently write the LIVE store — an env override that doesn't override, and a
  # test that forges the artifact it checks. Both are named faults; read the var here.
  dir="${MESH_REFRAIN_DIR:-$REFRAIN_DIR}"
  f="$dir/$key"
  mkdir -p "$dir" 2>/dev/null || true
  # environment-owned component = the artifact's own bytes. Capped TAIL read: an append-only log moves
  # at its end, a rewritten state file is small — either way the tail is where the world shows up.
  dig="$(tail -c "${MESH_REFRAIN_BYTES:-4096}" "$art" 2>/dev/null | cksum | tr -s ' ' '.')"
  [ -n "$dig" ] || dig="unreadable"
  prev=""; pn=0
  # `read … < "$f" 2>/dev/null` would NOT be quiet: redirections apply left to right, so the missing-file
  # error escapes before 2>/dev/null takes effect ([[redirect-order-defeats-stderr-null]]) — on a first
  # sight that is one stderr line per watched reflex, straight into cron mail and the pane. Guard first.
  [ -s "$f" ] && { read -r prev pn 2>/dev/null < "$f" || { prev=""; pn=0; }; }
  # pn = the epoch at which this content was FIRST seen (the last identified read), not a run counter
  [ "$pn" -eq "$pn" ] 2>/dev/null || pn="$nowts"           # guard non-integer/torn store
  if [ -z "$prev" ] || [ "$dig" != "$prev" ]; then         # world moved (or first sight) → clock resets
    [ "$mode" = peek ] || printf '%s %s\n' "$dig" "$nowts" > "$f" 2>/dev/null || true
    echo identified; return
  fi
  # PEEK never writes: --check is a read-only probe (same rule as the debounce peek at :~164).
  [ "$mode" = peek ] || printf '%s %s\n' "$dig" "$pn" > "$f" 2>/dev/null || true
  echo "overwrite:$(( nowts - pn ))"
}

# ── FACILITATION CASCADE: not every stale reflex has the same blast radius ──
# LITERATURE (live review, 2026-07-09, niche construction & the extended phenotype — angle: an
# OPERATIONAL mechanism, not philosophy). Niche construction theory's core case is a single organism
# vs. its environment, but a 2026 refinement of ecosystem engineering names a HIERARCHICAL variant:
# "Optimizing ecosystem restoration with facilitation cascades" (BioScience 76(1):21, Jan 2026,
# academic.oup.com/bioscience/article/76/1/21/8261311) — ecosystems are often organized as a cascade
# of habitat-forming species: a physically-tolerant PRIMARY foundation species ameliorates harsh
# conditions and provides substrate that lets a SECONDARY foundation species establish, which in turn
# creates further microhabitat/niche space for tertiary colonizers (see also Villagra & Cavieres et al.,
# PLOS ONE 11(12):e0167265, 2016, PMC5130256 — facilitation-cascade succession of ecosystem engineers
# at the dry-Puna altitudinal limit). The OPERATIONAL point: not all niche-constructing organisms have
# equal ecological weight — a PRIMARY foundation species failing collapses everything built on top of
# it, while a tertiary colonizer failing is locally contained. Ecology tracks this asymmetry; a flat
# per-species survey does not.
#
# WHERE IT BITES — this exact loop. mesh-reflex-health already watches EVERY scheduled reflex for
# staleness (the freshness/refrain moment above), but treats them as a FLAT set: the board alert lists
# every stale name with equal weight, insertion order, no notion that some reflexes are PRIMARY
# foundation species — their artifact is read by many OTHER tools (mesh-patterns.sh's board_recent_
# ts_within/mesh_is_minter, mesh-card, mesh-situation-style fusion inputs) — while others are leaf
# consumers nothing downstream depends on. A dead foundation-species reflex silently degrades every
# tool built on its niche (the exact "facilitation cascade" failure mode), yet reads as just one more
# name in an alphabetic/insertion-order list next to a leaf reflex nobody else touches.
#
# NOT a duplicate of the embodied axes: NOT stigmergy (mesh-trace/mesh-chat — coordination via
# EVAPORATING traces; this is about which DURABLE artifacts other tools structurally lean on). NOT the
# refrain/ritornello block above (that names the missing OPENNESS check on a single reflex's own
# beat — value-frozen-but-mtime-fresh; this is a CROSS-reflex dependency-weight, a different axis
# entirely). NOT `mesh-knowledge-sync`'s ecological-inheritance/provenance blocks (those weigh the
# TRUST of persisted culture; this weighs the BLAST RADIUS of a persisted mechanism going dark).
#
# SHIPPED (mechanical, not judgment — unlike the HELD refrain-openness fix above): fanin_count() is a
# cheap grep-based proxy for "how many other mesh-* tools reference this artifact" (a real dependency
# edge — a tool that greps/reads another reflex's state file has a structural stake in it staying
# fresh). highest_fanin_stale() picks the highest-fanin name among the CURRENTLY stale set and, above
# a floor (MESH_REFLEX_FANIN_MIN, default 2 — a name mentioned by 2+ other tools, not just once
# incidentally in a comment), the board alert names it as the one to fix first. A leaf-only stale set
# stays silent on this addition (no floor crossed) — no added noise, purely a same-alert triage hint.
fanin_count(){ # <artifact-path> → count of OTHER mesh-* scripts in MESH_REFLEX_SCAN_DIR referencing its basename
  local art="$1" base scandir self
  base="${art##*/}"; [ -n "$base" ] || { printf '0'; return; }
  scandir="${MESH_REFLEX_SCAN_DIR:-$(dirname "$0")}"
  self="$(basename "$0")"
  grep -lF -- "$base" "$scandir"/mesh-* 2>/dev/null | grep -vF -- "/$self" | wc -l | tr -d ' '
}
highest_fanin_stale(){ # <newline "name|artifact" list, stale entries only> → "name (fan-in=N)" or empty (below floor)
  local list="$1" n a fc best_n="" best_fc=0
  while IFS='|' read -r n a; do
    [ -n "$n" ] || continue
    fc="$(fanin_count "$a")"
    [ "$fc" -gt "$best_fc" ] && { best_fc="$fc"; best_n="$n"; }
  done <<EOF
$(printf '%s\n' "$list")
EOF
  [ -n "$best_n" ] && [ "$best_fc" -ge "${MESH_REFLEX_FANIN_MIN:-2}" ] && printf '%s (fan-in=%s)' "$best_n" "$best_fc"
}

# ── THE MODIFIER'S IN-DEGREE: the missing twin of fan-in (engineering REDUNDANCY) ────────────────
# LITERATURE (live review, 2026-07-25, niche construction & the extended phenotype — angle: an
# OPERATIONAL mechanism). Yeakel, Pires, de Aguiar, O'Donnell, Guimarães, Gravel & Gross, "Diverse
# interactions and ecosystem engineering can stabilize community assembly", Nature Communications
# 11:3307 (2020), nature.com/articles/s41467-020-17164-x (open: PMC7335095). Its operational core is a
# representation ecology had not used: abiotic MODIFIERS are first-class NODES, and links come in
# three kinds — eat (trophic, "x eats y") · need (service, "x needs y present") · **make** (engineering,
# "x makes modifier y"). An engineer's effect travels THROUGH the environment, never along a direct
# species→species edge. Headline result is nonlinear in the number of engineers: few engineers REDUCE
# stability (primary extinctions), many engineers INCREASE it — "redundant engineering increases the
# temporal stability of species' niches while minimizing priority effects". Corroborated by an
# independent model (Mougi, "Ecosystem engineering and food web stability", Sci Rep 14, 2024,
# nature.com/articles/s41598-024-70626-w: stability depends on the PROPORTION of engineering-related
# species and the SIGN of the effect; at middle proportions more richness → MORE stability, contra May).
#
# WHY IT IS NOT the facilitation-cascade block above. fanin_count() measures the modifier's OUT-degree —
# how many tools READ this artifact (the consumer side, blast radius). The un-embodied quantity is its
# IN-degree — how many tools WRITE it. Different number, OPPOSITE failure mode:
#   writers = 1  → a dead engineer FREEZES the artifact, the staleness check fires. Detectable, but the
#                  modifier has zero buffering: full blast radius on a single death (the low-η regime).
#   writers >= 2 → surviving writers keep mtime fresh and the dead one is INVISIBLE. Freshness stops
#                  attributing to the tool named in the REFLEXES row — a green this loop cannot see.
# So for THIS mesh, redundant engineering and mtime-liveness are in direct TENSION: adding a second
# writer to a watched artifact is an ecological improvement that silently disarms the watchdog watching
# it. (Same shape as presence.log's shared writes rendering 601/608 tools "recently used".)
#
# MEASURED 2026-07-25, every artifact in the REFLEXES table above: readers/writers =
#   .ambient-clock.state 12/1 · .psi.state 6/1 · ambient-db-tape.tsv 6/1 · egress-health.log 5/1 ·
#   .router-thermal-state 5/1 · sense-evolve.log 4/1 · .lan-newdevice.beat 2/1 · .imac-wifi-state 2/1 ·
#   .operator-focus.state 2/1. EVERY watched modifier is a NON-redundant engineer (in-degree exactly 1),
#   so the mtime-blindness case does not bite today — but .ambient-clock.state at 12 readers / 1 writer
#   is the mesh's largest single point of ecological failure and nothing names it as such.
#
# HELD, NOT SHIPPED — the detector is the problem. The intended rule is: >=2 real writers → the verdict
# degrades from "fresh → OK" to "unattributable: N writers". The only cheap implementation is a static
# source scan, and that scan is false-positive-prone in exactly the way that would make it fire wrongly:
# a naive census flagged THREE multi-writer artifacts (.ambient-clock.state=4, .psi.state=2,
# .router-thermal-state=2) and 3 of 3 extra writers were --test FIXTURES writing into a mktemp sandbox
# (mesh-home-state:46,58,69 · mesh-rhythm-state:283 · mesh-sensor-tape:275,286 · mesh-health-state:97 —
# that last inside a --test block that REASSIGNS MESH, so no path-prefix heuristic excludes it). A gate
# that cries wolf on a fixture is worse than the absence it replaces; any implementation must strip test
# blocks first. Full review + census + citations: docs/reviews/engineering-redundancy-writer-multiplicity-2026-07-25.md

if [ "${1:-}" = --test ]; then
  failures=0
  for dep in stat date crontab grep cat printf cksum tail tr; do
    command -v "$dep" >/dev/null 2>&1 || { echo "smoke-test: FAIL ($dep missing)"; failures=1; }
  done
  command -v mesh-chat >/dev/null 2>&1 || echo "smoke-test: WARN (mesh-chat missing — edge alerts silent)"
  # verify REFLEXES table is parseable: each max-age col is a valid intent token or positive literal
  while IFS='|' read -r name art maxage tool; do
    [ -n "$name" ] || continue
    case "$maxage" in
      @auto|@auto=*|@cond) : ;;
      *) [ "$maxage" -gt 0 ] 2>/dev/null || { echo "smoke-test: FAIL (bad max-age token '$maxage' for $name)"; failures=1; } ;;
    esac
  done <<EOF
$REFLEXES
EOF
  # DERIVATION asserts (the heart of maxage-from-cadence): against a SYNTHETIC cron, eff_maxage must
  # resolve @auto to cron-stride×2 for a WATCHABLE reflex AND keep a CONDITIONAL-write one EXCLUDED.
  _tcron="$(mktemp)"; printf '%s\n' \
    '*/10 * * * * $HOME/.local/bin/mesh-foo >> x 2>&1' \
    '7-59/30 * * * * $HOME/.local/bin/mesh-bar --edge' \
    '23 * * * * $HOME/.local/bin/mesh-hourly' > "$_tcron"
  _str(){ CRON_SRC="$_tcron" cron_stride_s "$1"; }
  _d(){   CRON_SRC="$_tcron" eff_maxage "$1" "$2"; }
  [ "$(_str mesh-foo)"    = 600 ]  || { echo "smoke-test: FAIL (*/10 stride≠600: $(_str mesh-foo))"; failures=1; }
  [ "$(_str mesh-bar)"    = 1800 ] || { echo "smoke-test: FAIL (7-59/30 stride≠1800: $(_str mesh-bar))"; failures=1; }
  [ "$(_str mesh-hourly)" = 3600 ] || { echo "smoke-test: FAIL (hourly stride≠3600: $(_str mesh-hourly))"; failures=1; }
  [ "$(_d @auto mesh-foo)"        = 1200 ] || { echo "smoke-test: FAIL (@auto */10 ≠ cron×2=1200: $(_d @auto mesh-foo))"; failures=1; }
  [ "$(_d @auto=mesh-bar mesh-x)" = 3600 ] || { echo "smoke-test: FAIL (@auto=PARENT ≠ parent stride×2=3600: $(_d @auto=mesh-bar mesh-x))"; failures=1; }
  [ "$(_d @cond mesh-feed)"       = skip ] || { echo "smoke-test: FAIL (conditional-write reflex NOT excluded)"; failures=1; }
  [ "$(_d @auto mesh-nonexistent)" = skip ] || { echo "smoke-test: FAIL (@auto w/ no cron line must skip, not crash)"; failures=1; }
  [ "$(_d 6300 mesh-x)"           = 6300 ] || { echo "smoke-test: FAIL (explicit literal not preserved)"; failures=1; }
  rm -f "$_tcron"
  # DEBOUNCE asserts (watchdog-debounce): 1 fail = still UP, 2 consecutive = DOWN, a success resets the counter.
  _dbd="$(mktemp -d)"; _db(){ DEBOUNCE_DIR="$_dbd" debounce "$@"; }
  [ "$(_db t1 fail)" = UP ]   || { echo "smoke-test: FAIL (debounce: 1st fail must stay UP, got DOWN)"; failures=1; }
  [ "$(_db t1 fail)" = DOWN ] || { echo "smoke-test: FAIL (debounce: 2nd CONSECUTIVE fail must flip DOWN)"; failures=1; }
  [ "$(_db t1 fail)" = DOWN ] || { echo "smoke-test: FAIL (debounce: sustained fail stays DOWN)"; failures=1; }
  [ "$(_db t1 ok)"   = UP ]   || { echo "smoke-test: FAIL (debounce: a success must flip UP immediately)"; failures=1; }
  [ "$(_db t1 fail)" = UP ]   || { echo "smoke-test: FAIL (debounce: counter must RESET after success — 1 fail = UP again)"; failures=1; }
  # peek (read-only): repeated peek-fails must NOT advance the counter (a manual --check can't force DOWN)
  [ "$(_db t2 fail peek)" = UP ] || { echo "smoke-test: FAIL (debounce peek: 1st fail UP)"; failures=1; }
  [ "$(_db t2 fail peek)" = UP ] || { echo "smoke-test: FAIL (debounce peek must NOT mutate — still UP, not DOWN)"; failures=1; }
  rm -rf "$_dbd"
  # WAKE-GRACE asserts (suspend-grace 2026-07-06): wake age = min(uptime, now − last-resume).
  _wnow=$(date +%s)
  [ "$(MESH_BOOT_UPTIME_S=999999 MESH_RESUME_TS=$((_wnow-100)) wake_age_s "$_wnow")" = 100 ] \
    || { echo "smoke-test: FAIL (wake_age_s: recent resume must beat huge uptime)"; failures=1; }
  [ "$(MESH_BOOT_UPTIME_S=555 MESH_RESUME_TS=0 wake_age_s "$_wnow")" = 555 ] \
    || { echo "smoke-test: FAIL (wake_age_s: no resume (0) must fall back to uptime)"; failures=1; }
  [ "$(MESH_BOOT_UPTIME_S=555 MESH_RESUME_TS=$((_wnow+50)) wake_age_s "$_wnow")" = 555 ] \
    || { echo "smoke-test: FAIL (wake_age_s: future resume ts (clock skew) must fall back to uptime)"; failures=1; }
  [ "$(MESH_BOOT_UPTIME_S=50 MESH_RESUME_TS=$((_wnow-100)) wake_age_s "$_wnow")" = 50 ] \
    || { echo "smoke-test: FAIL (wake_age_s: fresher boot must beat older resume)"; failures=1; }
  # graced-format guard: the graced label must NEVER read "(stale" — mesh-needs scrapes
  # `[a-z-]+\(stale` from --check output, and the old `${name}($detail)` graced format matched it
  # (a suppressed entry still injected a phantom REFLEX REPAIR). Reverting the format trips this.
  # split fragments: the pattern can never match this line's own text (vacuous-self-grep class,
  # 1969a5d) — it matches only the real graced-append line.
  _gf_a='graced="$graced ${name}('; _gf_b='grace: $detail)"'
  grep -qF "${_gf_a}${_gf_b}" "$0" \
    || { echo "smoke-test: FAIL (graced entries must be formatted '(grace: ...' — bare '(stale' leaks to the needs scrape)"; failures=1; }
  printf '%s' 'foo(grace: stale 9s>3s)' | grep -qE '[a-z-]+\(stale' \
    && { echo "smoke-test: FAIL (graced format still matches the needs stale-scrape regex)"; failures=1; }
  [ "$(printf '%s' "$REFLEXES" | awk -F'|' '{print $1}' | sort | uniq -d | grep -cvE '^[[:space:]]*$')" = 0 ] \
    || { echo "smoke-test: FAIL (duplicate reflex names)"; failures=1; }
  # synthetic fixture: stat/date + staleness classification
  tmp=$(mktemp -d) || { echo "smoke-test: FAIL (mktemp)"; failures=1; }
  now=$(date +%s)
  # fresh file: just touched, age should be small
  touch "$tmp/fresh.log"
  mt=$(stat -c %Y "$tmp/fresh.log" 2>/dev/null || echo 0)
  age=$((now - mt))
  [ "$age" -ge 0 ] || { echo "smoke-test: FAIL (fresh file age=$age negative)"; failures=1; }
  [ "$age" -le 5 ] || { echo "smoke-test: FAIL (fresh file age=$age >5s)"; failures=1; }
  # stale file: 20 min old mtime, age should exceed 600s threshold
  touch -t "$(date -d '20 min ago' +%m%d%H%M.%S 2>/dev/null)" "$tmp/stale.log"
  mt=$(stat -c %Y "$tmp/stale.log" 2>/dev/null || echo 0)
  age=$((now - mt))
  [ "$age" -ge 600 ] || { echo "smoke-test: FAIL (stale file age=$age <600)"; failures=1; }
  # missing file: should not exist
  [ ! -e "$tmp/missing.log" ] || { echo "smoke-test: FAIL (missing.log unexpectedly exists)"; failures=1; }
  # edge-trigger state machine sanity: OK→STALE→OK transition
  echo OK > "$tmp/state"
  prev=$(cat "$tmp/state" 2>/dev/null || echo OK)
  [ "$prev" = OK ] || { echo "smoke-test: FAIL (state readback=$prev)"; failures=1; }
  echo STALE > "$tmp/state"
  prev=$(cat "$tmp/state" 2>/dev/null || echo OK)
  [ "$prev" = STALE ] || { echo "smoke-test: FAIL (state readback=$prev after STALE)"; failures=1; }
  # node-aware gate: a PARENT-DRIVEN reflex (tool NOT in cron, artifact EXISTS) must be WATCHED, not
  # skipped (the mesh-lan-newdevice-via-perimeter case). A reflex with neither cron entry nor artifact
  # must be SKIPPED (no false 'missing' on a node that never runs it). gate = inCron || artifactExists.
  fakecron="*/3 * * * * mesh-egress-health"   # contains egress-health, NOT lan-newdevice
  touch "$tmp/.drivenbeat"   # parent-driven reflex's artifact present
  watched(){ local tool="$1" art="$2"; if ! printf '%s' "$fakecron" | grep -q "$tool" && [ ! -e "$art" ]; then echo skip; else echo watch; fi; }
  [ "$(watched mesh-lan-newdevice "$tmp/.drivenbeat")" = watch ] || { echo "smoke-test: FAIL (parent-driven reflex with artifact was skipped)"; failures=1; }
  [ "$(watched mesh-lan-newdevice "$tmp/.noart")" = skip ]      || { echo "smoke-test: FAIL (unscheduled reflex w/o artifact not skipped)"; failures=1; }
  [ "$(watched mesh-egress-health "$tmp/.noart")" = watch ]     || { echo "smoke-test: FAIL (directly-scheduled reflex was skipped)"; failures=1; }
  rm -rf "$tmp"
  # FACILITATION CASCADE asserts (LITERATURE 2026-07-09, niche construction — foundation-species
  # fan-in): fanin_count() must count real cross-tool references and exclude a SELF match (this file
  # would otherwise inflate its own count — it literally lists every artifact basename in REFLEXES);
  # highest_fanin_stale() must pick the widest-blast-radius stale name and stay SILENT below the floor.
  _fnd="$(mktemp -d)"
  printf '#!/bin/bash\n# consumes target.state for its own read\ncat target.state\n' > "$_fnd/mesh-consumer-a"
  printf '#!/bin/bash\n# also reads target.state here\ncat target.state\n' > "$_fnd/mesh-consumer-b"
  printf '#!/bin/bash\n# unrelated tool, never mentions the artifact\necho hi\n' > "$_fnd/mesh-unrelated"
  printf '#!/bin/bash\n# a copy of THIS tool would also literally mention target.state in its own\n# REFLEXES table (self-reference) — must be excluded by filename, not double-counted\ncat target.state\n' > "$_fnd/mesh-reflex-health"
  printf '#!/bin/bash\n# sole consumer of solo.state (fan-in=1, BELOW the default floor of 2)\ncat solo.state\n' > "$_fnd/mesh-consumer-c"
  [ "$(MESH_REFLEX_SCAN_DIR="$_fnd" fanin_count "/some/path/target.state")" = 2 ] \
    || { echo "smoke-test: FAIL (fanin_count: want 2 real cross-tool consumers, self-reference excluded, got $(MESH_REFLEX_SCAN_DIR="$_fnd" fanin_count "/some/path/target.state"))"; failures=1; }
  [ "$(MESH_REFLEX_SCAN_DIR="$_fnd" fanin_count "/some/path/lonely.state")" = 0 ] \
    || { echo "smoke-test: FAIL (fanin_count: artifact nobody references must read 0)"; failures=1; }
  [ "$(MESH_REFLEX_SCAN_DIR="$_fnd" fanin_count "/some/path/solo.state")" = 1 ] \
    || { echo "smoke-test: FAIL (fanin_count: single consumer must read 1)"; failures=1; }
  _stale_mixed="$(printf 'leaf|/some/path/lonely.state\nfoundation|/some/path/target.state')"
  _pick="$(MESH_REFLEX_SCAN_DIR="$_fnd" highest_fanin_stale "$_stale_mixed")"
  case "$_pick" in
    "foundation (fan-in=2)") ;;
    *) echo "smoke-test: FAIL (highest_fanin_stale: want 'foundation (fan-in=2)', got '$_pick')"; failures=1 ;;
  esac
  # below-floor: a stale set whose BEST fan-in (1, from solo.state) is a real, non-zero dependency —
  # just under the default floor of 2 — must still stay silent (no added noise for a single-consumer tie).
  _stale_below_floor="solo|/some/path/solo.state"
  _pick2="$(MESH_REFLEX_SCAN_DIR="$_fnd" highest_fanin_stale "$_stale_below_floor")"
  [ -z "$_pick2" ] || { echo "smoke-test: FAIL (highest_fanin_stale: fan-in=1 is below the default floor(2), must stay silent; got '$_pick2')"; failures=1; }
  rm -rf "$_fnd"
  # OVERWRITE-vs-IDENTIFICATION asserts (LITERATURE 2026-07-24, bridge interfaces, arXiv:2605.06346).
  # The load-bearing one is the `touch`: re-touching an UNCHANGED file must keep the value-frozen count
  # RISING. Put mtime back into the digest (the whole bug this transfer names) and that assertion goes
  # red — the probe would read the agent-owned parameter it exists to corroborate.
  _rfd="$(mktemp -d)"; _rf="$_rfd/art.state"; _t0=1750000000
  _ow(){ MESH_REFRAIN_DIR="$_rfd/db" MESH_REFRAIN_NOW="$1" overwrite_probe k1 "$_rf" "${2:-}"; }
  # the touches move mtime by an EXPLICIT offset, never a bare `touch`: at stat's 1s resolution a bare
  # touch inside the same second leaves %Y unchanged, so the mtime-exclusion assertion below would pass
  # against a digest that DOES read mtime — a vacuous gate ([[mtime-gate-needs-ns-and-retry]]; verified
  # by putting mtime back into the digest on purpose and watching these assertions go RED).
  _touch_at(){ touch -d "@$(( $(date +%s) + $1 ))" "$_rf"; }
  printf 'v1\n' > "$_rf"
  # first sight must be SILENT: an empty store is the normal state on a fresh node / after a new reflex
  # is added, and one stderr line per watched reflex per run is cron-mail noise, not a finding.
  _rferr="$(_ow "$_t0" 2>&1 >/dev/null)"
  [ -z "$_rferr" ] || { echo "smoke-test: FAIL (overwrite_probe: first sight must not emit stderr, got '$_rferr')"; failures=1; }
  rm -rf "$_rfd/db"
  [ "$(_ow "$_t0")" = identified ] || { echo "smoke-test: FAIL (overwrite_probe: first sight must read identified, got '$(_ow "$_t0")')"; failures=1; }
  _touch_at 60
  [ "$(_ow $((_t0+300)))" = "overwrite:300" ] || { echo "smoke-test: FAIL (overwrite_probe: an mtime-only touch must NOT reset the frozen clock — the digest must exclude mtime)"; failures=1; }
  _touch_at 120
  [ "$(_ow $((_t0+900)))" = "overwrite:900" ] || { echo "smoke-test: FAIL (overwrite_probe: frozen seconds must accumulate from the last CONTENT change, not from the last run)"; failures=1; }
  [ "$(_ow $((_t0+900)) peek)" = "overwrite:900" ] || { echo "smoke-test: FAIL (overwrite_probe peek: must report the same frozen clock)"; failures=1; }
  [ "$(_ow $((_t0+1200)) peek)" = "overwrite:1200" ] || { echo "smoke-test: FAIL (overwrite_probe peek: must keep reading the stored since-epoch)"; failures=1; }
  printf 'v2\n' > "$_rf"
  [ "$(_ow $((_t0+1500)))" = identified ] || { echo "smoke-test: FAIL (overwrite_probe: a real CONTENT change must read identified)"; failures=1; }
  _touch_at 180
  [ "$(_ow $((_t0+1560)))" = "overwrite:60" ] || { echo "smoke-test: FAIL (overwrite_probe: the frozen clock must RESET at the identified read)"; failures=1; }
  # attribution must never borrow the stale vocabulary mesh-needs scrapes off the --check line
  printf '%s' 'psi(value-frozen 6 runs)' | grep -qE '[a-z-]+\(stale' \
    && { echo "smoke-test: FAIL (overwrite-only label matches the needs stale-scrape regex — it would inject a phantom REFLEX REPAIR)"; failures=1; }
  rm -rf "$_rfd"
  ((failures)) && exit 1
  echo "smoke-test: ok (dep checks + REFLEXES token parse + max_age DERIVATION asserts [@auto=cron×2, @cond excluded, literal kept] + DEBOUNCE asserts [1 fail=UP, 2 consec=DOWN, success resets] + synthetic staleness fixture + node-aware gate 3 assertions + facilitation-cascade fan-in asserts [self-excluded count, highest-fanin pick, below-floor silence] + overwrite-vs-identification asserts [mtime excluded from the digest, frozen count accumulates, peek reports the scheduled count, content change resets, label misses the stale scrape])"
  exit 0
fi

# ── THE REFRAIN (RITORNELLO): a fresh BEAT is not an OPEN refrain — freshness can mask a closed loop ──
# CROSS-DOMAIN TRANSFER (D&G → distributed sensor mesh). Deleuze & Guattari's *refrain/ritornello*
# (A Thousand Plateaus, 1980, plateau 11 "1837: Of the Refrain") is the operation by which a
# rhythmic motif carves a TERRITORY out of chaos — and it has THREE simultaneous moments:
#   (1) a POINT OF ORDER in chaos — "a child in the dark… sings under his breath" — a fragile
#       stabilising centre, the bare mark "I am here / I am alive";
#   (2) the TERRITORIAL CIRCLE — drawing a rhythmic wall that organises an inside vs an outside;
#   (3) the OPENING — "one opens the circle a crack… lets someone in, or launches forth" — the
#       refrain COUPLES to a live outside (the cosmos). A refrain that NEVER opens hardens into a
#       "black hole": pure mechanical repetition that has STOPPED producing territory.
# (Kleinherenbrink, "Territory and Ritornello: Deleuze and Guattari on Thinking Living Beings",
#  Deleuze Studies 9.2, Edinburgh UP 2015, doi 10.3366/dls.2015.0183 — the Chaos[milieu+rhythm] →
#  Earth[territory] → Cosmos[opening] triad, applied to nonorganic/social formations, which is the
#  cross-domain licence; "The Problem of Modulation in D&G: Re-orienting the Ritornello Vis-à-vis
#  Droning", ResearchGate 2025 — droning = repetition WITHOUT the opening, i.e. the closed-loop case.)
#
# WHERE IT BITES — this very staleness loop (below, :~150-162). Our liveness check is purely
# mtime-FRESHNESS: age = now − mtime(artifact) vs maxage. That measures refrain MOMENT 1 ONLY — is
# the beat present? — and (via artifact-exists) moment 2. It does NOT measure moment 3, the OPENING.
# This became a real blind spot the moment "touch-every-run" became our liveness pattern (mesh-psi
# fix this session, 5a882b4; mirrored from mesh-ambient-clock): touch-every-run advances mtime EVEN
# WHEN THE VALUE IS UNCHANGED — correct for liveness, but it makes a FRESH beat indistinguishable
# from an OPEN refrain. A wedged probe that returns its last reading forever, while its reflex
# dutifully touches the artifact each run, is a CLOSED refrain / black hole: mtime-fresh + value-dead,
# and THIS loop reads it as healthy. The live referent is mesh-psi itself: the cron beat ran every
# 10m (lease-fresh, log fresh) yet .psi.state was frozen 4 days — a closed circle the freshness frame
# could not see (cf. [[liveness-is-lease-not-cached-status]] = announce-with-TTL, which touch-every-run
# SATISFIES; the refrain names the finer cut freshness alone can't make — beat ≠ opening).
#
# HELD behavioural fix (instrument-first; steward/operator lands): for a reflex whose artifact is
# EXPECTED to vary (a sensor read, not a constant config), add a third class beside fresh/stale —
# OPEN vs CLOSED: flag a refrain that is mtime-fresh but VALUE-constant for ≫ its expected variation
# timescale as a possible wedged/closed loop. HELD because telling "the world is genuinely constant"
# from "the read is frozen" needs a per-reflex expected-variation model (a truly-stable sensor would
# false-alarm) — exactly the held-descriptor problem; naming the missing moment-3 check is shippable,
# the openness gate is not. NOT a duplicate of [[dash-reflex-age-vs-cadence]] (age-vs-cadence is still
# inside the moment-1 freshness frame) nor the embodied D&G axes (rhizome, territorialization,
# capacity-to-affect, desire-production, line-of-flight) — the refrain's three-moment grammar of
# territory-from-rhythm, and its closed-loop/black-hole danger, is a distinct un-embodied concept.
#
# reflex-name | per-run artifact | max_age_seconds (≈ cadence×2 + margin) | cron tool (node-aware skip)
#   egress-health  */3  → log appended every run → expect < 10m
#   router-watch   */15 → .router-thermal-state rewritten every run → expect < 35m
#   lan-newdevice  sub-called by mesh-perimeter (now /45-throttled) → expect < 105m (see table note)
# node-aware: watch a reflex if it's DIRECTLY scheduled here OR its per-run artifact already EXISTS.
# The artifact-exists clause closes a real blind spot: some reflexes are PARENT-DRIVEN, never a
# standalone cron entry — e.g. mesh-lan-newdevice is sub-called by mesh-perimeter (9-59/45), so a
# literal cron-grep for "mesh-lan-newdevice" misses it and its liveness goes UNWATCHED while it's
# actually running (if perimeter stopped driving it, or the LAN probe wedged, the beat would go
# stale and nothing here would notice). Artifact-exists is the honest liveness gate: a node that
# NEVER runs the reflex has no artifact → still skipped (no false 'missing'); a node that runs it
# (cron OR parent-driven) has the artifact → its staleness is now genuinely watched.
cron="$(crontab -l 2>/dev/null)"
now=$(date +%s); stale=""; checked=0; graced=""; stale_entries=""; ow_report=""
# WAKE-GRACE (reboot-grace 2026-06-25, extended to resume-from-suspend 2026-07-06): a freshly-woken
# node has not had time to repopulate its per-run artifacts — a missing/stale artifact within a
# reflex's (cron stride×2)s of the last WAKE (boot OR resume; see wake_age_s) is EXPECTED
# repopulation, NOT a dead reflex. Within that window we route the finding to the trace and NEVER
# fire [reflex-stale]. The grace window is DERIVED per-reflex from the LIVE cron stride
# (cron_stride_s, the same single source of truth as max_age) — no literal.
WAKE_AGE_S="$(wake_age_s "$now")"
# --check is a read-only probe → PEEK the debounce counter (don't mutate); only the scheduled (no-arg)
# run advances/resets it, so a manual --check can't accelerate a target toward DOWN.
_dbmode=""; [ "${1:-}" = --check ] && _dbmode=peek
while IFS='|' read -r name art maxage tool; do
  [ -n "$name" ] || continue
  eff="$(eff_maxage "$maxage" "$tool")"
  [ "$eff" = skip ] && continue   # @cond conditional-write OR un-derivable cron → NOT watchable (excluded)
  # skip ONLY when neither directly-scheduled here NOR producing an artifact (truly not this node's)
  if ! printf '%s' "$cron" | grep -q "$tool" && [ ! -e "$art" ]; then continue; fi
  checked=$((checked + 1))
  # raw probe: FAIL if the artifact is missing or older than the derived max_age, else OK
  if [ ! -e "$art" ]; then raw=fail; detail="missing"
  else
    mt=$(stat -c %Y "$art" 2>/dev/null || echo 0); age=$(( now - mt ))
    if [ "$age" -gt "$eff" ]; then raw=fail; detail="stale ${age}s>${eff}s"; else raw=ok; detail=""; fi
  fi
  # WAKE-GRACE: within (this reflex's cron stride×2)s of the last wake (boot OR resume), a missing/
  # stale artifact is post-wake repopulation, not death → collect for a single trace line and skip
  # (never reaches the stale list / debounce / alert). Grace window derived from the live cron; eff
  # (already = stride×2 for @auto) is the fallback when the stride is un-derivable (parent-driven
  # reflex with no own cron line). The graced label says "grace:" — NEVER bare "(stale" — so a
  # consumer scraping the stale vocabulary (mesh-needs `[a-z-]+\(stale`) can't misread a graced
  # entry as a dead reflex (that scrape DID match the old graced format — grace never actually
  # protected the needs path).
  if [ "$raw" = fail ]; then
    _gstride="$(cron_stride_s "$tool")"; [ "${_gstride:-0}" -gt 0 ] && _grace=$((_gstride*2)) || _grace="$eff"
    if [ "$WAKE_AGE_S" -lt "$_grace" ]; then graced="$graced ${name}(grace: $detail)"; continue; fi
  fi
  # DEBOUNCE: declare stale only after N>=2 CONSECUTIVE fails; a single transient (torn read / mid-restart) stays quiet
  if [ "$raw" = fail ]; then
    if [ "$(debounce "rh.$name" fail "$_dbmode")" = DOWN ]; then
      stale="$stale ${name}($detail, ${DEBOUNCE_N}+ consecutive)"
      stale_entries="$stale_entries
$name|$art"   # facilitation-cascade: name+artifact pair for highest_fanin_stale() at alert time
    fi
  else
    debounce "rh.$name" ok "$_dbmode" >/dev/null   # success → reset the consecutive-fail counter (flip back UP at once)
    # OVERWRITE-vs-IDENTIFICATION (report-only, see the bridge-interface block above): a FRESH verdict
    # is the only one worth attributing — a stale artifact's verdict rests on nothing at all. Past the
    # floor, note that this reflex's freshness is carried by the agent-owned component (mtime) alone.
    _ow="$(overwrite_probe "rh.$name" "$art" "$_dbmode")"
    case "$_ow" in
      overwrite:*) _fz="${_ow#overwrite:}"; _fzfloor=$(( eff * REFRAIN_MULT ))   # derived from THIS reflex's live cadence
        [ "$_fz" -ge "$_fzfloor" ] 2>/dev/null \
          && ow_report="$ow_report ${name}(value-frozen ${_fz}s ≥ ${_fzfloor}s)" ;;
    esac
  fi
done <<EOF
$REFLEXES
EOF
stale="${stale# }"; graced="${graced# }"; ow_report="${ow_report# }"

if [ "${1:-}" = --check ]; then
  # `overwrite-only:` is an ATTRIBUTION, not a verdict — it never changes the exit code and never uses
  # the stale vocabulary (mesh-needs scrapes `[a-z-]+\(stale` off this line).
  if [ -n "$stale" ]; then echo "reflex-health: STALE →$stale${ow_report:+ · overwrite-only: $ow_report}"; exit 1
  elif [ "$checked" -eq 0 ]; then echo "reflex-health: n/a (no per-run reflexes scheduled on this node)"; exit 0
  else echo "reflex-health: ok ($checked per-run reflex(es) fresh${graced:+ · wake-grace suppressed: $graced}${ow_report:+ · overwrite-only: $ow_report})"; exit 0; fi
fi

# wake-grace findings go to the TRACE, never the board alert (scheduled runs only — keep --check read-only)
[ -n "$graced" ] && command -v mesh-trace >/dev/null 2>&1 && \
  mesh-trace "[reflex-grace] post-wake suppression (woke ${WAKE_AGE_S}s ago < stride×2): $graced — repopulating, not dead" >/dev/null 2>&1 || true

# OVERWRITE-ONLY findings go to the TRACE, never the board alert (report-only — see the
# bridge-interface block above). EDGE-triggered against the last reported set, so a legitimately
# constant artifact does not re-log every run; an empty set writes the empty marker so the NEXT
# freeze re-fires once.
_owf="$REFRAIN_DIR/.last-report"
if [ "$(cat "$_owf" 2>/dev/null || echo)" != "$ow_report" ]; then
  mkdir -p "$REFRAIN_DIR" 2>/dev/null || true
  printf '%s\n' "$ow_report" > "$_owf" 2>/dev/null || true
  [ -n "$ow_report" ] && command -v mesh-trace >/dev/null 2>&1 && \
    mesh-trace "[reflex-overwrite] mtime-fresh but value-frozen past ${REFRAIN_MULT}× its own max_age: $ow_report — the freshness verdict rests on the agent-owned component (the mtime touch) alone, no environment-owned evidence (arXiv:2605.06346 overwrite-vs-identification). NOT an alarm: check the probe only if the world should have moved." >/dev/null 2>&1 || true
fi

# edge-trigger against last state
prev="$(cat "$STATE" 2>/dev/null || echo OK)"
if [ -n "$stale" ]; then
  echo STALE > "$STATE"
  if [ "$prev" != STALE ] && command -v mesh-chat >/dev/null 2>&1; then
    # facilitation-cascade triage (see LITERATURE block above): among the currently-stale set, name
    # whichever has the widest downstream blast radius — fix that one first, its cascade is widest.
    _fs="$(highest_fanin_stale "$stale_entries")"
    _fsmsg=""; [ -n "$_fs" ] && _fsmsg=" FACILITATION-CASCADE: ${_fs} has the most downstream mesh-* references among the stale set — fix it first, its blast radius is widest."
    MESH_WHO="reflex-health@$(hostname)" mesh-chat "[reflex-stale] a scheduled reflex is DEAD (cron-present but its per-run artifact went stale): $stale — it smoke-passes so the other tenders miss it. Check the reflex + its dependency (e.g. router reachable?).$_fsmsg" >/dev/null 2>&1
  fi
  exit 1
else
  echo OK > "$STATE"
  if [ "$prev" = STALE ] && command -v mesh-chat >/dev/null 2>&1; then
    MESH_WHO="reflex-health@$(hostname)" mesh-chat "[reflex-ok] reflexes recovered — all per-run artifacts fresh again." >/dev/null 2>&1
  fi
  exit 0
fi
