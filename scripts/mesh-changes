#!/usr/bin/env bash
# mesh-changes — jazz BACKING TRACK: sequence a standard's chord changes at a tempo into a comping WAV.
# The "minus-one" the operator asked for — a chord-pad over a chart he can blow over, NOT live generative
# comping (his realistic path, 2026-06-20 02:00). Sits on top of the same engines as its siblings:
# reuses mesh-drone's warm harmonic-pad synth (one pad per chord) and mesh-metronome's beat clock
# (optional click overlay), so the changes move IN TIME — the chords advance at <bpm>, click-free.
#
# Operator 2026-06-20: jazz standards (Giant Steps) at a settable tempo. drone=tonic, metronome=clock,
#   changes=the harmony moving under his line. This is the third leg.
#
#   mesh-changes <standard> [bpm]        synthesize a built-in standard's changes at <bpm> → write a WAV,
#                                        print its path. NO audio out by default (room audio-silent gate).
#   mesh-changes --chart "Dm7:4 G7:4 Cmaj7:8" [bpm]
#                                        synthesize a CUSTOM chart. Tokens are CHORD:BEATS (beats optional,
#                                        default 4). CHORD = root (C, Bb, F#) + quality (maj7 m7 7 m7b5
#                                        dim7 aug 6 9 sus4 …; bare root = major triad).
#   mesh-changes <standard|--chart …> --play [bpm]
#                                        ALSO loop it on the Bose. OPT-IN only; refuses while MUTE_FLAG
#                                        ($MESH/mesh-speaking) present (never fights a silent-room order).
#   mesh-changes <…> --click [bpm]       overlay a metronome click (accented downbeat) on the comp → a full
#                                        backing (changes + clock). Composes with --play.
#   mesh-changes --list                  list built-in standards + the chart/quality syntax.
#   mesh-changes --test                  closed-loop self-test: synth a known chart, FFT-verify the right
#                                        chord tones land in the right time slots (timing-accurate) + a
#                                        valid WAV. NO mic, NO audio out — pure synthesis self-check.
#
# Default-silent for the same reason as mesh-drone/mesh-metronome: the operator put room audio under a
# FULLY-SILENT gate (2026-06-20 01:43). This BUILDS + VERIFIES the backing silently; he triggers --play
# himself when audio is back on. Playback also self-aborts if the MUTE_FLAG appears mid-loop.
#
# Tunables (env): CHANGES_DIR (out, default $MESH/changes) · CHANGES_SR (default 44100) ·
#   CHANGES_BPM (default 120) · CHANGES_GAIN (peak 0..1, default 0.5) · CHANGES_HARMONICS (per-tone
#   partials, default 4) · CHANGES_ROOT_OCT (voicing register for the chord root, default 3) ·
#   CHANGES_SIG (beats/bar for the click accent, default 4) · CHANGES_CLICK_GAIN (0..1, default 0.35) ·
#   MUTE_FLAG (presence = muted, default $MESH/mesh-speaking).
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"   # pipewire Bose sink
MESH="${MESH_DIR:-$HOME/.mesh}"
CHANGES_DIR="${CHANGES_DIR:-$MESH/changes}"
MUTE_FLAG="${MUTE_FLAG:-$MESH/mesh-speaking}"

PY=$(cat <<'PYEOF'
import sys, os, math, wave, tempfile
import numpy as np

SR        = int(os.environ.get("CHANGES_SR", "44100"))
BPM       = float(os.environ.get("CHANGES_BPM", "120"))
GAIN      = float(os.environ.get("CHANGES_GAIN", "0.5"))
NHARM     = int(os.environ.get("CHANGES_HARMONICS", "4"))
ROOT_OCT  = int(os.environ.get("CHANGES_ROOT_OCT", "3"))
SIG       = int(os.environ.get("CHANGES_SIG", "4"))
CLICKGAIN = float(os.environ.get("CHANGES_CLICK_GAIN", "0.35"))
OUTDIR    = os.environ.get("CHANGES_DIR")

NOTES = ["C","C#","D","D#","E","F","F#","G","G#","A","A#","B"]
FLATS = {"DB":"C#","EB":"D#","GB":"F#","AB":"G#","BB":"A#","CB":"B","FB":"E"}

# Chord quality → semitone intervals above the root. Longest-match wins on parse.
QUAL = {
    "":[0,4,7], "maj":[0,4,7], "major":[0,4,7], "M":[0,4,7],
    "m":[0,3,7], "min":[0,3,7], "-":[0,3,7], "minor":[0,3,7],
    "maj7":[0,4,7,11], "M7":[0,4,7,11], "ma7":[0,4,7,11], "Δ":[0,4,7,11],
    "m7":[0,3,7,10], "min7":[0,3,7,10], "-7":[0,3,7,10],
    "7":[0,4,7,10], "dom7":[0,4,7,10],
    "m7b5":[0,3,6,10], "min7b5":[0,3,6,10], "ø":[0,3,6,10], "halfdim":[0,3,6,10],
    "dim":[0,3,6], "o":[0,3,6],
    "dim7":[0,3,6,9], "o7":[0,3,6,9],
    "aug":[0,4,8], "+":[0,4,8],
    "6":[0,4,7,9], "m6":[0,3,7,9], "min6":[0,3,7,9],
    "9":[0,4,7,10,14], "maj9":[0,4,7,11,14], "m9":[0,3,7,10,14], "min9":[0,3,7,10,14],
    "sus4":[0,5,7], "sus":[0,5,7], "sus2":[0,2,7],
    "7sus4":[0,5,7,10], "7sus":[0,5,7,10],
}

# Built-in standards: chart strings of CHORD:BEATS tokens (the operator's named example first).
STANDARDS = {
    "giant-steps": (  # Coltrane, 16-bar form in B (key centres move by major thirds)
        "Bmaj7:2 D7:2 Gmaj7:2 Bb7:2 Ebmaj7:4 Am7:2 D7:2 "
        "Gmaj7:2 Bb7:2 Ebmaj7:2 F#7:2 Bmaj7:4 Fm7:2 Bb7:2 "
        "Ebmaj7:4 Am7:2 D7:2 Gmaj7:4 C#m7:2 F#7:2 "
        "Bmaj7:4 Fm7:2 Bb7:2 Ebmaj7:4 C#m7:2 F#7:2"),
    "ii-v-i": "Dm7:4 G7:4 Cmaj7:8",                       # the fundamental jazz cadence, in C
    "ii-v-i-minor": "Dm7b5:4 G7:4 Cm7:8",                 # the minor-key cadence
    "blues": (  # a Bb jazz blues, 12 bars (4 beats/bar except the turnaround)
        "Bb7:4 Eb7:4 Bb7:4 Bb7:4 Eb7:4 Eb7:4 Bb7:4 G7:4 "
        "Cm7:4 F7:4 Bb7:2 G7:2 Cm7:2 F7:2"),
    "rhythm-a": (  # "I Got Rhythm" A-section (Bb), the other great blowing vehicle
        "Bb6:2 G7:2 Cm7:2 F7:2 Dm7:2 G7:2 Cm7:2 F7:2 "
        "Bb6:2 Bb7:2 Eb6:2 Edim7:2 Dm7:2 G7:2 Cm7:2 F7:2"),
}

def root_to_midi(root):
    u = root.upper(); u = FLATS.get(u, u)
    if u not in NOTES: raise ValueError("unknown root: %s" % root)
    return 12*(ROOT_OCT+1) + NOTES.index(u)   # MIDI: C-1=0; ROOT_OCT=3 → C3=48

def midi_to_freq(m): return 440.0 * 2**((m-69)/12.0)

def parse_chord(sym):
    """'Bbmaj7' → (label, [freqs]). Root = letter + optional #/b; rest = quality (longest match)."""
    s = sym.strip()
    if not s: raise ValueError("empty chord")
    i = 1
    if len(s) > 1 and s[1] in "#b": i = 2     # accidental
    root, qual = s[:i], s[i:]
    if qual not in QUAL:
        # tolerant fallbacks for common notations before giving up
        if qual in ("maj7","Maj7"): qual = "maj7"
        else: raise ValueError("unknown chord quality '%s' in '%s'" % (qual, sym))
    rm = root_to_midi(root)
    freqs = [midi_to_freq(rm + iv) for iv in QUAL[qual]]
    return s, freqs

def parse_chart(chart):
    """'Dm7:4 G7:4 C:8' → [(label, [freqs], beats), …]. Beats default 4."""
    out = []
    for tok in chart.split():
        if ":" in tok:
            sym, b = tok.rsplit(":", 1); beats = float(b)
        else:
            sym, beats = tok, 4.0
        label, freqs = parse_chord(sym)
        out.append((label, freqs, beats))
    return out

def pad_tone(freq, n):
    """One warm harmonic tone (drone-style: fundamental + gently-rolled-off partials)."""
    t = np.arange(n)/SR
    w = np.zeros(n, dtype=np.float64)
    for h in range(1, NHARM+1):
        w += (1.0/(h**1.4)) * np.sin(2*np.pi*freq*h*t)
    return w

def synth_chord(freqs, n):
    """Sum the chord tones into a pad, normalize, raised-cosine fade in/out (click-free segment seam)."""
    w = np.zeros(n, dtype=np.float64)
    for f in freqs:
        w += pad_tone(f, n)
    w /= (len(freqs) or 1)
    fade = min(int(SR*0.04), n//2)            # 40ms swell per chord → no boundary click
    if fade > 0:
        env = 0.5*(1-np.cos(np.linspace(0, np.pi, fade)))
        w[:fade]  *= env
        w[-fade:] *= env[::-1]
    return w

def click_track(total_n, beat_n, downbeat_every):
    """Metronome clicks at each beat (accented downbeat), summed in at CLICK_GAIN."""
    out = np.zeros(total_n, dtype=np.float64)
    nclick = max(1, int(SR*0.04))
    t = np.arange(nclick)/SR
    beat = 0
    pos = 0
    while pos < total_n:
        accent = (beat % downbeat_every == 0)
        freq = 1500.0 if accent else 1000.0
        amp  = 1.0 if accent else 0.6
        click = amp * np.sin(2*np.pi*freq*t) * np.exp(-t*45.0)
        end = min(pos+nclick, total_n)
        out[pos:end] += click[:end-pos]
        beat += 1; pos += beat_n
    return out

def render(chart, with_click=False):
    """Chart → full int16 comp track + the per-chord sample boundaries (for timing checks)."""
    chords = parse_chart(chart)
    beat_n = int(round(SR*60.0/BPM))
    segs, bounds, pos = [], [], 0
    for _, freqs, beats in chords:
        n = int(round(beat_n*beats))
        segs.append(synth_chord(freqs, n))
        bounds.append((pos, pos+n))
        pos += n
    track = np.concatenate(segs) if segs else np.zeros(0)
    if with_click and len(track):
        track = track + click_track(len(track), beat_n, SIG) * CLICKGAIN
    peak = np.max(np.abs(track)) + 1e-9
    track = (track/peak) * GAIN
    return (track*32767).astype(np.int16), chords, bounds, beat_n

def write_wav(path, samples):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with wave.open(path, "wb") as w:
        w.setnchannels(1); w.setsampwidth(2); w.setframerate(SR)
        w.writeframes(samples.tobytes())

def peak_freqs(samples, k):
    """Top-k spectral peak frequencies of a segment (for chord-tone verification)."""
    x = samples.astype(np.float64); x -= x.mean()
    if len(x) < 4: return []
    spec = np.abs(np.fft.rfft(x*np.hanning(len(x))))
    freqs = np.fft.rfftfreq(len(x), 1.0/SR)
    idx = np.argsort(spec)[::-1]
    out, seen = [], 0
    for i in idx:
        if freqs[i] < 30: continue            # skip DC/sub-bass
        out.append(freqs[i]); seen += 1
        if seen >= k: break
    return out

def cmd_gen(chart, name, with_click):
    samples, chords, bounds, beat_n = render(chart, with_click)
    dur = len(samples)/SR
    safe = name.replace("#","s").replace(" ","_")
    suffix = "_click" if with_click else ""
    path = os.path.join(OUTDIR, "changes_%s_%dbpm%s.wav" % (safe, int(BPM), suffix))
    write_wav(path, samples)
    bars = sum(b for _,_,b in chords)/SIG
    print("%s\t%d\t%.1f\t%.1f\t%s" % (name, len(chords), bars, dur, path))  # name<TAB>nchords<TAB>bars<TAB>secs<TAB>path
    return 0

def cmd_test():
    global BPM
    BPM = 120.0                                # → 0.5s/beat, robust FFT resolution per segment
    # A known ii-V-I in C: Dm7 (D F A C) | G7 (G B D F) | Cmaj7 (C E G B). Each tone must land in ITS slot.
    chart = "Dm7:2 G7:2 Cmaj7:2"
    samples, chords, bounds, beat_n = render(chart, with_click=False)
    if samples.dtype != np.int16:                 print("smoke-test: FAIL (not int16)"); return 1
    expect_len = sum(int(round(beat_n*b)) for _,_,b in chords)
    if abs(len(samples)-expect_len) > 4:          print("smoke-test: FAIL (len %d != %d)" % (len(samples),expect_len)); return 1
    if int(np.max(np.abs(samples))) == 0:         print("smoke-test: FAIL (silent buffer)"); return 1
    # Each chord's tones must be among the strongest peaks IN ITS OWN TIME SLOT (= timing-accurate).
    for (label, freqs, _), (a, b) in zip(chords, bounds):
        seg = samples[a:b]
        peaks = peak_freqs(seg, k=2*len(freqs)+2)
        for f in freqs:
            hit = any(abs(1200*math.log2(p/f)) < 35 for p in peaks)   # within ~1/3 semitone
            if not hit:
                print("smoke-test: FAIL (%s: tone %.1fHz absent in slot [%d,%d); peaks=%s)" %
                      (label, f, a, b, ["%.0f"%p for p in peaks])); return 1
    # Boundaries fall exactly on the beat grid (timing): chord 2 starts at beat_n*2, chord 3 at beat_n*4.
    if bounds[1][0] != int(round(beat_n*2)) or bounds[2][0] != int(round(beat_n*4)):
        print("smoke-test: FAIL (segment boundaries off the beat grid)"); return 1
    # Real WAV round-trip.
    tmp = tempfile.mkdtemp(); p = os.path.join(tmp, "t.wav"); write_wav(p, samples)
    with wave.open(p, "rb") as w:
        ok = (w.getnchannels()==1 and w.getsampwidth()==2 and w.getframerate()==SR and w.getnframes()==len(samples))
    os.remove(p); os.rmdir(tmp)
    if not ok: print("smoke-test: FAIL (WAV round-trip mismatch)"); return 1
    # Custom-chart parse + a couple of qualities.
    for sym, n in (("F#7",4),("Bbmaj7",4),("Am7b5",4),("Ebdim7",4)):
        _, fr = parse_chord(sym)
        if len(fr) != n: print("smoke-test: FAIL (parse %s → %d tones, want %d)"%(sym,len(fr),n)); return 1
    print("smoke-test: ok (ii-V-I @120bpm: every chord tone verified in its own time slot, "
          "boundaries on the beat grid, qualities parse, valid mono/16-bit/%dHz WAV)" % SR)
    return 0

if len(sys.argv) > 1:                          # dispatch only when given a mode; else importable (table lookup)
    mode = sys.argv[1]
    if   mode == "gen":  sys.exit(cmd_gen(sys.argv[2], sys.argv[3], sys.argv[4]=="1"))
    elif mode == "test": sys.exit(cmd_test())
PYEOF
)

list_standards() {
  echo "built-in standards (mesh-changes <name> [bpm]):"
  printf '  %-14s %s\n' giant-steps   "Coltrane — 16 bars, B major-third cycle (the operator's example)"
  printf '  %-14s %s\n' ii-v-i        "Dm7 G7 Cmaj7 — the fundamental jazz cadence (C)"
  printf '  %-14s %s\n' ii-v-i-minor  "Dm7b5 G7 Cm7 — the minor cadence"
  printf '  %-14s %s\n' blues         "Bb jazz blues, 12 bars"
  printf '  %-14s %s\n' rhythm-a      "I Got Rhythm A-section (Bb)"
  echo
  echo "custom chart:   mesh-changes --chart \"Dm7:4 G7:4 Cmaj7:8\" [bpm]"
  echo "  token = CHORD[:BEATS] (beats default 4). CHORD = root(C,Bb,F#) + quality."
  echo "  qualities: (bare)=maj  m  maj7  m7  7  m7b5/ø  dim  dim7  aug/+  6  m6  9  maj9  m9  sus4  7sus4"
  echo "flags:   --play (Bose, opt-in, MUTE_FLAG-gated)   --click (overlay metronome)   default bpm=120"
}

bose_target() {
  pw-cli ls Node 2>/dev/null | awk '
    /node.name/ { name=tolower($0) }
    /object.id/ && (name ~ /bose/ || name ~ /soundlink/) { gsub(/[^0-9]/,"",$0); print; exit }' 2>/dev/null
}

play_loop() {
  local wav="$1"
  if [ -e "$MUTE_FLAG" ]; then
    echo "mesh-changes: MUTE_FLAG present ($MUTE_FLAG) — refusing to play (room is muted). Remove it to enable." >&2
    return 3
  fi
  local bid; bid="$(bose_target)"
  echo "mesh-changes: playing $wav on the Bose, looping (Ctrl-C to stop)…"
  while :; do
    if [ -n "$bid" ]; then pw-play --target "$bid" "$wav" 2>/dev/null || pw-play "$wav" 2>/dev/null
    else pw-play "$wav" 2>/dev/null || aplay -q "$wav" 2>/dev/null; fi
    [ -e "$MUTE_FLAG" ] && { echo "mesh-changes: MUTE_FLAG appeared — stopping."; break; }
  done
}

case "${1:-}" in
  ""|--help|-h|--list) list_standards ;;
  --test) CHANGES_DIR="$CHANGES_DIR" python3 -c "$PY" test ;;
  *)
    chart=""; name=""; play=0; click=0; bpm=""
    if [ "$1" = "--chart" ]; then
      shift; chart="${1:-}"; name="custom"; shift || true
    else
      name="$1"; shift            # built-in standard; its chart is resolved from the python table below
    fi
    # collect flags/bpm
    while [ $# -gt 0 ]; do
      case "$1" in
        --play)  play=1 ;;
        --click) click=1 ;;
        *[0-9]*) bpm="$1" ;;
      esac; shift
    done
    [ -n "$bpm" ] && export CHANGES_BPM="$bpm"
    # For a built-in standard, look up its chart inside python (single source of truth).
    if [ "$name" != "custom" ]; then
      chart="$(STD="$name" python3 -c "$PY
import os
print(STANDARDS.get(os.environ['STD'],''))" 2>/dev/null)"
      if [ -z "$chart" ]; then
        echo "mesh-changes: unknown standard '$name' — run 'mesh-changes --list'." >&2; exit 1
      fi
    fi
    [ -z "$chart" ] && { echo "mesh-changes: empty chart." >&2; exit 1; }
    out="$(CHANGES_DIR="$CHANGES_DIR" python3 -c "$PY" gen "$chart" "$name" "$click")" \
      || { echo "mesh-changes: synth failed for '$name'" >&2; exit 1; }
    nm="$(printf '%s' "$out" | cut -f1)"; nc="$(printf '%s' "$out" | cut -f2)"
    bars="$(printf '%s' "$out" | cut -f3)"; secs="$(printf '%s' "$out" | cut -f4)"; wav="$(printf '%s' "$out" | cut -f5)"
    printf 'changes: %s — %s chords, %s bars, %ss @ %sbpm%s → %s\n' \
      "$nm" "$nc" "$bars" "$secs" "${CHANGES_BPM:-120}" "$([ "$click" = 1 ] && echo ' +click')" "$wav"
    [ "$play" = 1 ] && play_loop "$wav"
    ;;
esac
