#!/usr/bin/env bash
# reflex-cadence: */10 * * * *
# mesh-cam-power — Lenovo IdeaPad/ThinkPad CAMERA POWER sense (firmware privacy kill).
# Reads the ideapad_acpi `camera_power` sysfs toggle — the EC's hardware power gate for the
# integrated webcam. When the operator hits the camera-privacy Fn key (or Lenovo Vantage flips
# it), the EC cuts power: camera_power → 0. CRUCIALLY this does NOT unbind the v4l2 device
# nodes — /dev/video0,1 keep enumerating (health VERIFIED 2026-07-12: camera_power=0 while both
# /dev/video* still present, name='Integrated Camera'). So a cam sense that only checks "does
# /dev/video* exist?" reads a BLACK FRAME and can't tell PRIVACY-KILL (power=0, working as
# intended) from DRIVER-BROKE (power=1 but capture fails). camera_power is the missing
# disambiguator. Distinct from mesh-conservation (battery charge policy) — same EC, different
# toggle; this mirrors that sense exactly.
#
# Usage:
#   mesh-cam-power            one-shot status line
#   mesh-cam-power --json     machine-readable
#   mesh-cam-power --watch    emit on change (default 30s poll)
#   mesh-cam-power --test     smoke test (asserts a real EC read yields 0/1)
#
# Honest-exit contract (shared with mesh-conservation / mesh-lid / mesh-mag):
#   0 = reading produced (recognized 0/1, or the raw code surfaced if the EC reports an
#       unexpected value — never guessed)
#   2 = N/A — no camera_power sysfs node (non-Lenovo node, desktop, VM, phone). The sense
#       simply does not apply here; NOT a failure.
#   1 = FAIL — the sysfs node EXISTS but is unreadable or returns garbage (real fault).
#   Never fakes a reading.
#
# Consumers: cam senses (mesh-cam-watch / mesh-imac-cam-watch) gate their 'black-frame' verdict
#   on this — power=off ⇒ privacy-kill (expected dark, not a fault); power=on + black ⇒ driver-broke.
#
# Change-gated state: ~/.mesh/.cam-power-state holds "on"|"off"|"<raw>". Content is rewritten
# only when the value CHANGES; mtime is refreshed EVERY successful run via mesh-state-touch
# (ran-live decoupled from value-changed — see the conditional-write false-stale class,
# mesh-activity-tempo f3f84c1).
set -euo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

GLOB="${MESH_CAM_POWER_GLOB:-/sys/bus/platform/drivers/ideapad_acpi/VPC*/camera_power}"
STATE="$HOME/.mesh/.cam-power-state"

# find the (first) readable camera_power sysfs node; empty + return 1 if none.
find_node() {
  local f
  for f in $GLOB; do
    [ -r "$f" ] && { printf '%s\n' "$f"; return 0; }
  done
  return 1
}

# read + normalize the value at <node>: echo "on"|"off"|"<raw-int>"; return 1 on garbage.
read_power() {
  local node="$1" raw
  raw="$(cat "$node" 2>/dev/null)" || return 1
  raw="$(printf '%s' "$raw" | tr -d '[:space:]')"
  case "$raw" in
    ''|*[!0-9]*) return 1 ;;    # empty / non-numeric → garbage, never fake
  esac
  case "$raw" in
    1) printf 'on\n' ;;
    0) printf 'off\n' ;;
    *) printf '%s\n' "$raw" ;;  # unknown EC code → surface raw, do not guess
  esac
}

# persist + keep-live: rewrite content only on change; always refresh mtime (ran-live).
touch_state() {
  command -v mesh-state-touch >/dev/null 2>&1 && mesh-state-touch "$STATE" || touch "$STATE" 2>/dev/null || true
}
write_state() {  # <value>
  local val="$1" prev
  prev="$(cat "$STATE" 2>/dev/null || true)"
  if [ "$val" != "$prev" ]; then
    mkdir -p "$(dirname "$STATE")"
    printf '%s\n' "$val" > "$STATE"
  fi
  touch_state
}

# one read: emits the normalized value on stdout; handles honest-exit on the way.
read_once() {
  local node val
  node="$(find_node)" || { echo "mesh-cam-power: n/a (no camera_power sysfs node — non-Lenovo node)" >&2; exit 2; }
  val="$(read_power "$node")" || { echo "mesh-cam-power: FAIL (camera_power present but unreadable/garbage at $node)" >&2; exit 1; }
  write_state "$val"
  printf '%s\n' "$val"
}

ts(){ date -u +%FT%TZ; }

case "${1:-}" in
  --test)
    # A node without ideapad/thinkpad ACPI camera_power (desktop / VM / router / phone) is NOT
    # broken — the sense is just N/A. Distinguish DEPENDENCY ABSENT (→ exit 2 n/a) from
    # PRESENT-but-unreadable/garbage (→ exit 1 FAIL). The live-read gate asserts a real EC read
    # yields a recognized 0/1 — reachability of the sysfs node ≠ producing a value.
    node="$(find_node)" || { echo "smoke-test: n/a (no camera_power sysfs node: non-Lenovo node)"; exit 2; }
    val="$(read_power "$node")" || { echo "smoke-test: FAIL (camera_power present but unreadable/garbage at $node)"; exit 1; }
    case "$val" in
      on)  echo "smoke-test: ok (camera power on — webcam electrically enabled)" ;;
      off) echo "smoke-test: ok (camera power off — firmware privacy kill; /dev/video* may still enumerate)" ;;
      *)   echo "smoke-test: FAIL (camera_power live read unrecognized: $val)"; exit 1 ;;
    esac
    ;;
  --json)
    val="$(read_once)"
    powered=false; [ "$val" = on ] && powered=true
    printf '{"node":"%s","camera_power":"%s","powered":%s,"ts":"%s"}\n' \
      "$(hostname)" "$val" "$powered" "$(ts)"
    ;;
  --watch)
    interval="${2:-30}"
    previous=""
    while true; do
      val="$(read_once 2>/dev/null)" || val=unknown
      if [ "$val" != "$previous" ]; then
        printf '%s cam_power=%s\n' "$(ts)" "$val"
        previous="$val"
      fi
      sleep "$interval"
    done
    ;;
  "")
    val="$(read_once)"
    case "$val" in
      on)  printf 'cam_power=on (webcam electrically enabled)\n' ;;
      off) printf 'cam_power=off (firmware privacy kill — /dev/video* may still enumerate but capture is black)\n' ;;
      *)   printf 'cam_power=%s (unrecognized EC code — surfaced raw, not guessed)\n' "$val" ;;
    esac
    ;;
  *)
    echo "usage: mesh-cam-power [--test|--json|--watch [seconds]]" >&2
    exit 2
    ;;
esac
