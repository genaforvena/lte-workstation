#!/usr/bin/env python3
# mesh-travels — render the phone's travel timeline from the phaedra location collector.
# Pulls /root/.mesh/phone-track.log (JSON lines from mesh-phone-locbeacon) over SSH,
# filters to a day (default today, Europe/Moscow), renders a timeline + summary, and
# (optionally) reverse-geocodes distinct points via OSM Nominatim (cached).
#
# Usage: mesh-travels [--date YYYY-MM-DD] [--no-geo] [--tz Europe/Moscow] [--json]
import sys, json, subprocess, math, time, os, urllib.request, urllib.parse
from datetime import datetime, timezone, timedelta

PHAEDRA = "root@100.94.116.17"
REMOTE_LOG = "/root/.mesh/phone-track.log"
GEO_CACHE = os.path.expanduser("~/.mesh/geocache.json")
TZ_OFFSET_H = 3  # Europe/Moscow = UTC+3 (no DST)

def arg(name, default=None):
    if name in sys.argv:
        i = sys.argv.index(name)
        return sys.argv[i+1] if i+1 < len(sys.argv) else default
    return default

def pull_log():
    try:
        out = subprocess.run(
            ["ssh", "-o", "StrictHostKeyChecking=no", "-o", "ConnectTimeout=10",
             PHAEDRA, f"cat {REMOTE_LOG} 2>/dev/null"],
            capture_output=True, text=True, timeout=25)
        return out.stdout.splitlines()
    except Exception as e:
        print(f"error pulling log: {e}", file=sys.stderr)
        return []

def haversine(a, b):
    R = 6371000.0
    la1, lo1, la2, lo2 = map(math.radians, [a[0], a[1], b[0], b[1]])
    dla, dlo = la2-la1, lo2-lo1
    h = math.sin(dla/2)**2 + math.cos(la1)*math.cos(la2)*math.sin(dlo/2)**2
    return 2*R*math.asin(math.sqrt(h))

def load_cache():
    try:
        return json.load(open(GEO_CACHE))
    except Exception:
        return {}

def save_cache(c):
    try:
        os.makedirs(os.path.dirname(GEO_CACHE), exist_ok=True)
        json.dump(c, open(GEO_CACHE, "w"))
    except Exception:
        pass

HOME_SSID_PREFIXES = ("GL-MT3000",)  # the operator's home router (mesh edge-router)

def fnum(v, d=None):
    try: return float(v)
    except (TypeError, ValueError): return d

def derive_state(r, hour):
    """Fuse the multi-sensor fix into a human state label + the signals behind it.
    Honest: a missing sensor degrades the label, never fabricates one."""
    ssid = r.get("ssid") or ""
    spd = fnum(r.get("spd"))
    mot = fnum(r.get("mot"))
    lux = fnum(r.get("lux"))
    home = any(ssid.startswith(p) for p in HOME_SSID_PREFIXES)
    place = "🏠дома" if home else ("📍" + (ssid if ssid else "вне дома"))

    # movement: speed (m/s) is strongest; linear-accel RMS (m/s²) backs it up
    if spd is not None and spd >= 5:      move = "🚗 в дороге"
    elif spd is not None and spd >= 0.8:  move = "🚶 идёт"
    elif mot is not None and mot >= 0.6:  move = "🤸 движение"
    elif mot is not None:                 move = "🧍 неподвижно"
    else:                                  move = "?движение"

    # light: lux
    if lux is None:        light = ""
    elif lux <= 5:         light = "🌑темно"
    elif lux <= 80:        light = "🔅сумрак"
    else:                  light = "☀️светло"

    # "at rest" heuristic: home + dark + still. Honest — phone dark+still ≠ proven sleep
    # (could be face-down on a table while awake), so we say "в покое", and only HINT sleep
    # in deep-night hours. A real sleep claim needs sustained corroboration (future: long
    # window of 0 steps + 0 lux + still).
    at_rest = home and (lux is not None and lux <= 5) and (mot is not None and mot < 0.3)
    if at_rest:
        hint = " · похоже на сон" if (hour >= 0 and hour < 7) else ""
        return f"📴 в покое (дома, темно, неподвижно){hint}", place, move, light
    return f"{move} · {place}", place, move, light

def geocode(lat, lon, cache):
    key = f"{round(lat,3)},{round(lon,3)}"  # ~110m bucket
    if key in cache:
        return cache[key]
    try:
        q = urllib.parse.urlencode({"lat": lat, "lon": lon, "format": "json", "zoom": 16})
        req = urllib.request.Request(
            "https://nominatim.openstreetmap.org/reverse?" + q,
            headers={"User-Agent": "mesh-travels/1.0 (personal phone tracker)"})
        d = json.load(urllib.request.urlopen(req, timeout=12))
        a = d.get("address", {})
        name = ", ".join([x for x in [
            a.get("road") or a.get("neighbourhood") or a.get("suburb"),
            a.get("city") or a.get("town") or a.get("village") or a.get("county"),
        ] if x]) or d.get("display_name", "")[:60]
        cache[key] = name
        time.sleep(1.1)  # nominatim policy
        return name
    except Exception:
        cache[key] = ""
        return ""

def test():
    fail = 0
    # dep: python3
    import shutil
    if shutil.which("python3") is None:
        print("FAIL: python3 not found")
        fail += 1
    else:
        print("PASS: python3 found")

    # dep: ssh
    if shutil.which("ssh") is None:
        print("FAIL: ssh not found")
        fail += 1
    else:
        print("PASS: ssh found")

    # dep: phaedra reachable
    r = subprocess.run(["ssh", "-o", "ConnectTimeout=5", "-o", "StrictHostKeyChecking=no",
                        PHAEDRA, "echo ok"], capture_output=True, text=True, timeout=10)
    if r.returncode != 0 or r.stdout.strip() != "ok":
        print("WARN: phaedra unreachable (offline mode) — skipping remote dep check")
    else:
        print("PASS: phaedra reachable")

    # dry-run: test haversine with known values
    # Moscow (55.7558,37.6173) to SPb (59.9343,30.3351) ~634 km
    d = haversine((55.7558, 37.6173), (59.9343, 30.3351))
    target = 634000
    if abs(d - target) < 50000:
        print(f"PASS: haversine Moscow→SPb = {d/1000:.1f} km (expect ~{target/1000:.0f} km)")
    else:
        print(f"FAIL: haversine returned {d/1000:.1f} km, expected ~{target/1000:.0f} km")
        fail += 1

    # dry-run: test rendering with sample data
    sample = [
        {"ts": 1718700000, "lat": "55.7558", "lon": "37.6173", "acc": "25", "batt": "85"},
        {"ts": 1718703600, "lat": "55.7610", "lon": "37.6200", "acc": "30"},
    ]
    # simulate what main() does
    tz = timezone(timedelta(hours=TZ_OFFSET_H))
    for s in sample:
        s["_dt"] = datetime.fromtimestamp(int(s["ts"]), tz)
    if sample[0]["_dt"].strftime("%Y-%m-%d") == datetime.now(tz).strftime("%Y-%m-%d"):
        print("PASS: date parsing works for today")
    else:
        print("WARN: date parsing returns different date (expected on midnight boundary)")

    total = 0.0
    for i in range(1, len(sample)):
        total += haversine(
            (float(sample[i-1]["lat"]), float(sample[i-1]["lon"])),
            (float(sample[i]["lat"]), float(sample[i]["lon"]))
        )
    if total > 0:
        print(f"PASS: rendering pipeline — computed {total:.0f}m between sample points")
    else:
        print("FAIL: rendering pipeline produced zero distance")
        fail += 1

    if fail == 0:
        print(f"smoke-test: ok ({fail} failures)")
    else:
        print(f"smoke-test: FAIL ({fail} failure(s))")
    sys.exit(0 if fail == 0 else 1)

def main():
    if "--test" in sys.argv:
        test()
        return
    tz = timezone(timedelta(hours=TZ_OFFSET_H))
    date = arg("--date") or datetime.now(tz).strftime("%Y-%m-%d")
    do_geo = "--no-geo" not in sys.argv
    recs = []
    for line in pull_log():
        line = line.strip()
        if not line:
            continue
        try:
            r = json.loads(line)
            if not r.get("lat") or not r.get("lon"):
                continue
            r["_dt"] = datetime.fromtimestamp(int(r["ts"]), tz)
            if r["_dt"].strftime("%Y-%m-%d") == date:
                recs.append(r)
        except Exception:
            continue
    recs.sort(key=lambda r: r["ts"])
    if "--json" in sys.argv:
        print(json.dumps([{k: v for k, v in r.items() if k != "_dt"} for r in recs], indent=2))
        return
    if not recs:
        print(f"No location fixes for {date}. (Beacon not deployed yet, or phone had no fixes.)")
        return
    cache = load_cache()
    print(f"=== День {date} (Europe/Moscow) — {len(recs)} замеров сенсоров ===")
    total = 0.0
    prev = None
    prev_state = None
    home_fixes = away_fixes = 0
    for r in recs:
        lat, lon = float(r["lat"]), float(r["lon"])
        hour = r["_dt"].hour
        moved = ""
        if prev:
            d = haversine(prev, (lat, lon))
            total += d
            if d >= 50:
                moved = f"  (+{d/1000:.1f} км)" if d >= 1000 else f"  (+{int(d)} м)"
        state, place_lbl, move, light = derive_state(r, hour)
        if "🏠" in place_lbl: home_fixes += 1
        else: away_fixes += 1
        geo = ("  " + geocode(lat, lon, cache)) if (do_geo and "🏠" not in place_lbl) else ""
        bat = f" 🔋{r.get('batt')}%" if r.get("batt") else ""
        light_s = f" {light}" if light else ""
        # only print the geocoded street when away or on a state change (keep it readable)
        marker = "▸" if state != prev_state else " "
        print(f"{marker} {r['_dt'].strftime('%H:%M')}  {state}{light_s}{bat}{geo}{moved}")
        prev = (lat, lon); prev_state = state
    save_cache(cache)
    span_h = (recs[-1]["_dt"] - recs[0]["_dt"]).total_seconds() / 3600.0
    hp = 100 * home_fixes / max(1, len(recs))
    print(f"--- {recs[0]['_dt'].strftime('%H:%M')}–{recs[-1]['_dt'].strftime('%H:%M')} "
          f"({span_h:.1f}ч) · перемещение ~{total/1000:.1f} км · "
          f"дома {hp:.0f}% / вне дома {100-hp:.0f}% ---")

if __name__ == "__main__":
    main()
