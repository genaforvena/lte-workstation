#!/usr/bin/env bash
# orphan-ok: on-demand check tool, pulled by hand/doctor, never cron-wired
# mesh-doctrine-lint — deterministic shape lint for the instruction/memory boundary.
#
#   mesh-doctrine-lint [--repo DIR] | --test
#
# Rules (CLAUDE.md: instruction/memory boundary):
#   TIER   a rule bullet in CLAUDE.md spanning more than one line or without a
#          [[case-link]] reference.
#   LEAK   window/node-specific literals in CLAUDE.md (window names, node IPs,
#          device paths, user names) — they belong in charter/ or CLAUDE.local.md.
#   CASE   a file under memory/ not referenced by any [[link]] from CLAUDE.md
#          (informational NOTE, never HOLD).
#
# Exit: 0 clean · 1 HOLD (TIER/LEAK) · 2 usage/skip (repo files absent).
set -uo pipefail
REPO="${MESH_REPO:-$HOME/lte-workstation}"
case "${1:-}" in
  --repo) REPO="${2:-}"; [ -n "$REPO" ] || { echo "usage: mesh-doctrine-lint [--repo DIR] | --test" >&2; exit 2; }; shift 2;;
  --test|-h|--help) ;;
  "") ;;
  *) echo "usage: mesh-doctrine-lint [--repo DIR] | --test" >&2; exit 2;;
esac

lint_repo(){
  local repo="$1" fails=0 notes=0 claude="$1/CLAUDE.md"
  [ -r "$claude" ] || { echo "SKIP no CLAUDE.md at $repo"; return 2; }
  # TIER: bullets under "Each rule below" section: one line + [[link]].
  # Heuristic, deterministic: lines starting with '- **' must contain '[[' on the same line.
  # TIER: rule bullets are ONE LOGICAL LINE plus a [[case]] link. Bullets may
  # wrap across physical lines, so join continuation lines first, then check.
  _tier_tmp="$(mktemp)"; trap 'rm -f "$_tier_tmp" /tmp/doctrine-leak-$$' RETURN
  awk '/^- \*\*/{if(b!="")print b; b=$0; next} {if(b!=""){b=b" "$0} else if($0!="")print $0} END{if(b!="")print b}' "$claude" \
  | while IFS= read -r bullet; do
    case "$bullet" in
      '- **'*)
        grep -q '\[\[' <<<"$bullet" || echo "TIER no-case-link: ${bullet:0:120}…" ;;
    esac
  done > "$_tier_tmp"
  cat "$_tier_tmp"; fails=$((fails+$(wc -l < "$_tier_tmp")))
  # LEAK: node/window literals that must live in charter/ or CLAUDE.local.md.
  # Match concrete IPs, /dev/ paths, and 'window <name>' declarations — not prose mentions.
  # LEAK: bare host addresses (doctrine cites ranges in CIDR notation, which is
  # not a leak — only a BARE address that names a live node/device is one).
  grep -nEo '([0-9]{1,3}\.){3}[0-9]{1,3}(/[0-9]{1,2})?' "$claude" \
    | grep -vE '/[0-9]{1,2}$' | grep -E '(^|[^0-9])(100\.|192\.168\.|10\.)' \
    | head -5 | while IFS= read -r ln; do echo "LEAK node-address: $ln"; done > /tmp/doctrine-leak-$$ || true
  if [ -s /tmp/doctrine-leak-$$ ]; then cat /tmp/doctrine-leak-$$; fails=$((fails+$(wc -l < /tmp/doctrine-leak-$$))); fi
  rm -f /tmp/doctrine-leak-$$
  grep -nE '/dev/(nvme|sd[a-z]|tty[A-Z]+)' "$claude" | head -5 | while IFS= read -r ln; do echo "LEAK device-path: $ln"; done
  if grep -qE '/dev/(nvme|sd[a-z]|tty[A-Z]+)' "$claude"; then fails=$((fails+1)); fi
  # CASE: memory/ files never [[linked]] — NOTE only.
  if [ -d "$repo/memory" ]; then
    while IFS= read -r m; do
      bn="$(basename "$m")"
      grep -qF "$bn" "$claude" 2>/dev/null || { echo "NOTE unlinked-case: $bn"; notes=$((notes+1)); }
    done < <(find "$repo/memory" -maxdepth 1 -type f | head -50)
  fi
  [ "$fails" = 0 ] && echo "doctrine-lint: clean (${notes} unlinked-case notes)"
  [ "$fails" = 0 ]
}

if [ "${1:-}" = --test ]; then
  d="$(mktemp -d)"; trap 'rm -rf "$d"' EXIT
  pass=0; fail=0
  printf '# T\n\n- **Good rule.** Text [[some-case|path]].\n' > "$d/CLAUDE.md"
  mkdir -p "$d/memory"
  lint_repo "$d" >/dev/null 2>&1 && pass=$((pass+1)) || { echo "FAIL: clean doctrine must PASS"; fail=$((fail+1)); }
  printf -- '- **Bad rule that runs on\ncontinuation line.**\n' >> "$d/CLAUDE.md"
  out="$(lint_repo "$d" 2>&1)"; [ $? = 1 ] && grep -q TIER <<<"$out" && pass=$((pass+1)) || { echo "FAIL: linkless bullet must TIER-HOLD: $out"; fail=$((fail+1)); }
  printf 'node at 100.81.222.19 here\n' >> "$d/CLAUDE.md"
  out="$(lint_repo "$d" 2>&1)"; [ $? = 1 ] && grep -q LEAK <<<"$out" && pass=$((pass+1)) || { echo "FAIL: node IP must LEAK-HOLD: $out"; fail=$((fail+1)); }
  echo "mesh-doctrine-lint --test: $pass passed, $fail failed"
  [ "$fail" = 0 ]; exit $?
fi
case "${1:-}" in -h|--help) sed -n '2,/^[^#]/p' "$0" | sed 's/^# \?//p'; exit 0;; --test) :;; esac
lint_repo "$REPO"
