#!/usr/bin/env bash
# mesh-cam-watch — motion-triggered camera REFLEX: when the frame changes, snap a photo and send it
# to the operator's Telegram. Pure reflex — runs as a systemd --user service, NO minds involved
# (operator 2026-06-19: "на рефлексах, там не должно быть никаких миндов работать"). Lives on a node
# with a webcam (default-string).
#
# HOW: every CAM_POLL seconds grab a frame (fswebcam), compare it to the previous frame as a downscaled
# grayscale mean-absolute-difference (PIL). If the difference exceeds CAM_THRESH (something moved /
# changed in view) and we're past the CAM_COOLDOWN since the last alert, send the full-res frame to
# Telegram and log the event. The first frame just seeds the baseline (no false trigger).
#
#   mesh-cam-watch --daemon    run the watch loop forever (the service ExecStart)
#   mesh-cam-watch --once      one capture+compare cycle (cron-style; persists baseline between runs)
#   mesh-cam-watch --noise     measure the static-scene diff (noise floor) → pick a threshold
#   mesh-cam-watch --test      synthetic diff test (no camera, no Telegram)
#
# Tunables (env): CAM_DEV=/dev/video0 · CAM_POLL=1.5 · CAM_THRESH=14 · CAM_COOLDOWN=15 · CAM_WARMUP=8
#   CAM_RES=1280x720 · CAM_CHAT=<override chat_id>.  Creds read from ~/.config/remote-access/env.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"

CAM_DEV="${CAM_DEV:-/dev/video0}"
CAM_POLL="${CAM_POLL:-1.5}"
CAM_THRESH="${CAM_THRESH:-14}"        # mean abs grayscale diff (0-255) that counts as motion
CAM_COOLDOWN="${CAM_COOLDOWN:-15}"    # min seconds between sent alerts (anti-spam)
CAM_WARMUP="${CAM_WARMUP:-8}"         # fswebcam frames to skip for exposure
CAM_RES="${CAM_RES:-1280x720}"
MESH="${MESH_DIR:-$HOME/.mesh}"
PREV="$MESH/cam-prev.jpg"
LASTF="$MESH/cam-last-alert"
LOG="$MESH/cam-events.log"
mkdir -p "$MESH" 2>/dev/null || true

# ---- diff helper (PIL): prints the mean-abs grayscale difference between two JPEGs ------------------
diff_metric() {  # <a.jpg> <b.jpg> -> float on stdout (0 if either unreadable → safe no-trigger)
  python3 - "$1" "$2" <<'PY'
import sys
from PIL import Image
try:
    a=Image.open(sys.argv[1]).convert("L").resize((160,120))
    b=Image.open(sys.argv[2]).convert("L").resize((160,120))
    pa=list(a.getdata()); pb=list(b.getdata())
    d=sum(abs(x-y) for x,y in zip(pa,pb))/len(pa)
    print(f"{d:.2f}")
except Exception:
    print("0.00")
PY
}

capture() {  # <out.jpg> -> 0 if a non-empty JPEG was produced
  fswebcam --no-banner -d "$CAM_DEV" -r "$CAM_RES" -S "$CAM_WARMUP" "$1" >/dev/null 2>&1
  [ -s "$1" ]
}

send_photo() {  # <jpg> <caption>
  local env="$HOME/.config/remote-access/env"
  [ -f "$env" ] && { set -a; . "$env" 2>/dev/null; set +a; }
  local chat="${CAM_CHAT:-${CHAT_ID:-}}"
  [ -n "${BOT_TOKEN:-}" ] && [ -n "$chat" ] || { echo "send: no BOT_TOKEN/CHAT_ID" >&2; return 1; }
  # NB: NEVER `curl | grep -q` here — the script runs `set -o pipefail`, and grep-q closing the pipe
  # early SIGPIPEs curl → the pipeline returns non-zero EVEN WHEN the photo was delivered (false
  # SEND-FAILED; root cause of the 2026-06-19 "motion photos never arrive" — they DID arrive). Capture
  # the response to a var and substring-test instead. Retry 3x for a genuine transient network blip.
  local i resp rc
  for i in 1 2 3; do
    resp="$(curl -s --max-time 30 "https://api.telegram.org/bot${BOT_TOKEN}/sendPhoto" \
      -F "chat_id=${chat}" -F "photo=@${1}" -F "caption=${2}" 2>>"$MESH/cam-curl.err")"
    rc=$?
    printf '%sZ try=%d curl_rc=%d file=%s(%s b) resp=%.90s\n' "$(date -u +%H:%M:%S)" "$i" "$rc" \
      "$(basename "$1")" "$(stat -c%s "$1" 2>/dev/null)" "$resp" >> "$MESH/cam-send-debug.log" 2>/dev/null
    case "$resp" in *'"ok":true'*) return 0;; esac
    sleep 2
  done
  return 1
}

log_evt() { printf '%sZ  %s\n' "$(date -u +%Y-%m-%dT%H:%M:%S)" "$1" >> "$LOG" 2>/dev/null || true; }

# one cycle: capture → compare to baseline → maybe alert → update baseline. echoes the diff value.
cycle() {
  local now; now="$(mktemp /tmp/cam-now-XXXX.jpg)"
  if ! capture "$now"; then echo "CAPTURE_FAIL"; rm -f "$now"; return 1; fi
  local d="0.00"
  if [ -f "$PREV" ]; then
    d="$(diff_metric "$PREV" "$now")"
    # awk float compare; trigger if d >= THRESH and cooldown elapsed
    if awk "BEGIN{exit !($d>=$CAM_THRESH)}"; then
      local last=0 nowt; nowt="$(date +%s)"; [ -f "$LASTF" ] && last="$(cat "$LASTF" 2>/dev/null || echo 0)"
      if [ $(( nowt - last )) -ge "$CAM_COOLDOWN" ]; then
        local ts; ts="$(date '+%H:%M:%S')"
        if send_photo "$now" "🚶 Движение в кадре — $ts (diff=$d)"; then
          echo "$nowt" > "$LASTF"; log_evt "ALERT diff=$d sent"
        else log_evt "ALERT diff=$d SEND-FAILED"; fi
      else log_evt "motion diff=$d (cooldown, not sent)"; fi
    fi
  fi
  cp -f "$now" "$PREV" 2>/dev/null; rm -f "$now"
  echo "$d"
}

case "${1:-}" in
  --test)
    command -v python3 >/dev/null && python3 -c 'import PIL' 2>/dev/null || { echo "smoke-test: n/a (no PIL)"; exit 2; }
    python3 - <<'PY'
from PIL import Image
import sys, tempfile, os
d=tempfile.mkdtemp()
a=os.path.join(d,"a.jpg"); b=os.path.join(d,"b.jpg"); c=os.path.join(d,"c.jpg")
Image.new("L",(640,480),100).save(a)               # flat grey
Image.new("L",(640,480),100).save(b)               # identical
img=Image.new("L",(640,480),100)                    # grey with a bright block (a "person")
for y in range(120,360):
    for x in range(200,440): img.putpixel((x,y),230)
img.save(c)
def mad(p,q):
    A=Image.open(p).convert("L").resize((160,120)); B=Image.open(q).convert("L").resize((160,120))
    pa=list(A.getdata()); pb=list(B.getdata()); return sum(abs(x-y) for x,y in zip(pa,pb))/len(pa)
same=mad(a,b); changed=mad(a,c)
ok = same<1.0 and changed>14.0
print(f"  identical-frames diff={same:.2f} (want <1)  changed-frame diff={changed:.2f} (want >14)")
sys.exit(0 if ok else 1)
PY
    [ $? -eq 0 ] && echo "smoke-test: ok (diff metric separates static from motion)" || { echo "smoke-test: FAIL"; exit 1; }
    ;;
  --noise)
    command -v fswebcam >/dev/null || { echo "no fswebcam"; exit 1; }
    echo "measuring static-scene diff over 6 frames (don't move in front of the camera)..."
    a="$(mktemp /tmp/n-XXXX.jpg)"; b="$(mktemp /tmp/n-XXXX.jpg)"; mx=0
    capture "$a" || { echo "capture fail"; exit 1; }
    for i in 1 2 3 4 5; do sleep "$CAM_POLL"; capture "$b" && { d="$(diff_metric "$a" "$b")"; echo "  frame $i: diff=$d"; cp -f "$b" "$a"; }; done
    rm -f "$a" "$b"
    echo "→ set CAM_THRESH a few points above the largest static diff above."
    ;;
  --once)   cycle >/dev/null ;;
  --daemon)
    log_evt "cam-watch START (dev=$CAM_DEV poll=${CAM_POLL}s thresh=$CAM_THRESH cooldown=${CAM_COOLDOWN}s)"
    while true; do cycle >/dev/null 2>&1 || true; sleep "$CAM_POLL"; done ;;
  *) sed -n '2,18p' "$0" ;;
esac
