#!/usr/bin/env bash
# reflex-cadence: 4-59/15 * * * *
# reflex-args: --edge
# mesh-storage-health — cross-sense fusion: WHY is this node's storage degraded, not just IS it?
# Combines 3 storage senses into one ATTRIBUTED verdict no single sensor gives.
#
# Inputs (disk-space + disk-latency REQUIRED, best-effort OFFLINE-able; nvme-temp OPTIONAL —
# absent on any non-NVMe node, never penalized as "missing"):
#   mesh-disk-space     .disk-space.state    NORMAL|WARNING|CRITICAL|OFFLINE   (capacity: use%/inode%)
#   mesh-disk-latency   .disk-latency-state  FAST|NORMAL|SLOW|STALLED|UNKNOWN|OFFLINE  (perf: await ms)
#   mesh-nvme-temp      .nvme-temp.state     COOL|WARM|HOT|CRITICAL|OFFLINE    (controller heat)
#
# Why this is NEW (not a dup of mesh-system-vitality):
#   mesh-system-vitality folds disk-latency in as ONE of 4 hardware axes (CPU/battery/thermal/disk)
#   — a worst-of aggregate that answers "is the hardware healthy?". It never asks WHY latency
#   degraded, and never looks at capacity or NVMe controller temperature at all.
#   This tool answers the storage-specific follow-up question a sysadmin actually asks when disk
#   is slow: is it explained by something else we already see (near-full capacity triggering SSD
#   garbage-collection slowdown, or a hot NVMe controller throttling), or is it UNATTRIBUTED —
#   which is the most actionable case, because it means neither obvious cause corroborates and the
#   media itself may be failing. Two real, independent physical mechanisms make this a genuine
#   cross-check, not just three numbers glued together:
#     - a near-full SSD loses overprovisioning headroom -> garbage collection stalls -> latency rises
#     - an overheating NVMe controller thermal-throttles reads/writes -> latency rises
#   Latency alone can't tell you which (if either) is the cause; capacity+thermal alone don't know
#   latency degraded at all. Fusing the three gives an ATTRIBUTED verdict, not just a worse number.
#
# THE CROSS-CHECK IS ONLY WORTH ITS NAME WHILE THE AXES STAY INDEPENDENT (2026-08-16, mesh-home):
#   this tool published "CRITICAL — capacity=CRITICAL,latency=STALLED (imminent storage failure)"
#   on a filesystem that was 23% full, writeable, and SMART-clean (spare 99%, media errors 0,
#   critical warning 0x00), and was HEALTHY again 15 minutes later. Both axes were reading ONE
#   fact: mesh-disk-space tested writeability with `timeout 2 touch` and mapped every non-zero rc
#   to "read-only or unwritable", so a write-latency stall (dm-0 write=1392..2199ms in those same
#   minutes) tripped capacity as well as latency, and rule 2 counted the same stall twice. Fixed
#   in mesh-disk-space (probe_write: yes|slow|hung|no — a timeout is not a refusal). The general
#   shape to watch for here: a fused CRITICAL is only evidence if each axis was measured by a
#   mechanism the OTHER axis's fault cannot disturb. Tell in the artifact: that CRITICAL carried
#   no `@<mount>`, because the capacity verdict was not about a full filesystem at all.
#
# Bands (FALSIFIABLE: change a band rule -> test flips):
#   CRITICAL   capacity=CRITICAL (exhausted/read-only) OR latency=STALLED OR thermal=CRITICAL
#              — imminent storage failure regardless of attribution
#   DEGRADED   capacity=WARNING OR latency=SLOW OR thermal=HOT
#              — reason names the ATTRIBUTION: thermal-attributed / capacity-attributed / BOTH /
#                UNATTRIBUTED (latency degraded, neither capacity nor thermal corroborates —
#                flagged as the highest-priority case: investigate media health directly)
#   HEALTHY    capacity=NORMAL AND latency in {FAST,NORMAL} AND thermal in {COOL,WARM,n/a}
#   DEGRADED   both required inputs OFFLINE (can't assess at all)
#   DEGRADED   1 required input OFFLINE (partial — names which)
#   (thermal OFFLINE is NEVER counted as missing — a SATA-only node has no NVMe controller to
#   read, that is a legitimate permanent state, not a sensor failure; reported as thermal=n/a)
#
#   mesh-storage-health          one-shot verdict to stdout
#   mesh-storage-health --edge   emit only on verdict change (cron reflex)
#   mesh-storage-health --json   machine-readable {label, reason, inputs, ts}
#   mesh-storage-health --test   smoke test (pure classifier, no state-file reads)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

MESH="${MESH_DIR:-$HOME/.mesh}"
STATE="$MESH/.storage-health-state"
STALE_S=1800  # 30min — generous vs the slowest input cadence (disk-space/nvme-temp */15)

# --- read helpers (required axes return OFFLINE on missing/stale/unreadable) ---
read_capacity() {
  local f="$1" v now m
  [ -f "$f" ] || { echo "OFFLINE"; return; }
  now=$(date +%s); m=$(stat -c %Y "$f" 2>/dev/null || echo "$now")
  if [ $((now - m)) -gt "$STALE_S" ]; then echo "OFFLINE"; return; fi
  v="$(head -1 "$f" 2>/dev/null | cut -d'|' -f1)"
  case "$v" in
    NORMAL|WARNING|CRITICAL) printf '%s' "$v" ;;
    *) echo "OFFLINE" ;;
  esac
}
# WHICH filesystem is the capacity claim ABOUT? (2026-08-15 phaedra incident): this fusion said
# 'HEALTHY|capacity=NORMAL' on a box whose /tmp was 100% full and refusing every write, because the
# capacity axis was a claim about the ROOT fs and nothing said so. mesh-disk-space now scans every
# mount and names the worst one in its reason ("use=NN% on <mount>"); carry that name up so the
# verdict is capacity=<label>@<mount> — a reader can no longer take it for the fs they had in mind.
read_capacity_where() {
  local f="$1" w=""
  [ -f "$f" ] || { printf ''; return; }
  w="$(head -1 "$f" 2>/dev/null | sed -n 's/.*use=[0-9]*% on \([^ )|]*\).*/\1/p')"
  printf '%s' "$w"
}
read_latency() {
  local f="$1" v now m
  [ -f "$f" ] || { echo "OFFLINE"; return; }
  now=$(date +%s); m=$(stat -c %Y "$f" 2>/dev/null || echo "$now")
  if [ $((now - m)) -gt "$STALE_S" ]; then echo "OFFLINE"; return; fi
  v="$(head -1 "$f" 2>/dev/null | cut -d'|' -f1)"
  case "$v" in
    FAST|NORMAL|SLOW|STALLED|UNKNOWN) printf '%s' "$v" ;;
    *) echo "OFFLINE" ;;
  esac
}
# thermal is OPTIONAL: no readable state -> "n/a" (never "OFFLINE"/missing — no NVMe is legitimate)
read_thermal() {
  local f="$1" v now m
  [ -f "$f" ] || { echo "n/a"; return; }
  now=$(date +%s); m=$(stat -c %Y "$f" 2>/dev/null || echo "$now")
  if [ $((now - m)) -gt "$STALE_S" ]; then echo "n/a"; return; fi
  v="$(head -1 "$f" 2>/dev/null | cut -d'|' -f1)"
  case "$v" in
    COOL|WARM|HOT|CRITICAL) printf '%s' "$v" ;;
    *) echo "n/a" ;;
  esac
}

# --- classifier (pure, offline-testable) ---
# classify_storage <capacity> <latency> <thermal> -> "LABEL|reason"
classify_storage() {
  local cap="$1" lat="$2" therm="$3" capwhere="${4:-}"
  # every 'capacity=<label>' in a reason carries its MOUNT when the capacity sense named one
  local cap_d="$cap${capwhere:+@$capwhere}"
  # 1. Missing-required tally (thermal excluded — optional axis)
  local missing="" degen=0
  [ "$cap" = "OFFLINE" ] && { missing="${missing}disk-space," ; degen=$((degen+1)); }
  [ "$lat" = "OFFLINE" ] && { missing="${missing}disk-latency," ; degen=$((degen+1)); }
  missing="${missing%,}"
  if [ "$degen" -ge 2 ]; then
    echo "DEGRADED|missing: $missing (both required inputs offline — can't assess storage)"
    return
  fi
  if [ "$degen" -eq 1 ]; then
    echo "DEGRADED|missing: $missing (1 required input offline, can't fully assert) | capacity=$cap_d latency=$lat thermal=$therm"
    return
  fi
  # 2. CRITICAL: capacity exhausted, latency stalled, or thermal at/past crit — regardless of attribution
  if [ "$cap" = "CRITICAL" ] || [ "$lat" = "STALLED" ] || [ "$therm" = "CRITICAL" ]; then
    local why=""
    [ "$cap" = "CRITICAL" ] && why="${why}capacity=CRITICAL,"
    [ "$lat" = "STALLED" ] && why="${why}latency=STALLED,"
    [ "$therm" = "CRITICAL" ] && why="${why}thermal=CRITICAL,"
    echo "CRITICAL|${why%,} (imminent storage failure) | capacity=$cap_d latency=$lat thermal=$therm"
    return
  fi
  # 3. DEGRADED: capacity warning, latency slow, or thermal hot — ATTRIBUTE if latency is the trigger
  if [ "$cap" = "WARNING" ] || [ "$lat" = "SLOW" ] || [ "$therm" = "HOT" ]; then
    local attrib=""
    if [ "$lat" = "SLOW" ]; then
      local cause=""
      [ "$therm" = "HOT" ] && cause="${cause}thermal,"
      [ "$cap" = "WARNING" ] && cause="${cause}capacity,"
      if [ -z "$cause" ]; then
        attrib="latency=SLOW UNATTRIBUTED (no thermal/capacity correlate — investigate media health directly)"
      else
        attrib="latency=SLOW attributed=${cause%,} (corroborated cause found)"
      fi
    elif [ "$therm" = "HOT" ]; then
      attrib="thermal=HOT (leading indicator — latency not yet degraded)"
    else
      attrib="capacity=WARNING${capwhere:+ on $capwhere} (latency not yet degraded)"
    fi
    echo "DEGRADED|$attrib | capacity=$cap_d latency=$lat thermal=$therm"
    return
  fi
  # 4. HEALTHY: capacity NORMAL, latency FAST/NORMAL, thermal COOL/WARM/n/a
  echo "HEALTHY|capacity=$cap_d latency=$lat thermal=$therm (storage nominal)"
}

# --- Test mode (pure classifier, no state-file reads) ---
if [ "${1:-}" = --test ]; then
  fail=0
  # CRITICAL — each trigger alone
  r="$(classify_storage CRITICAL FAST COOL)"; echo "$r" | grep -q '^CRITICAL' || { echo "  FAIL CRITICAL-capacity: got=$r"; fail=1; }
  r="$(classify_storage NORMAL STALLED COOL)"; echo "$r" | grep -q '^CRITICAL' || { echo "  FAIL CRITICAL-latency: got=$r"; fail=1; }
  r="$(classify_storage NORMAL FAST CRITICAL)"; echo "$r" | grep -q '^CRITICAL' || { echo "  FAIL CRITICAL-thermal: got=$r"; fail=1; }
  # DEGRADED with attribution: thermal corroborates slow latency
  r="$(classify_storage NORMAL SLOW HOT)"; echo "$r" | grep -q '^DEGRADED' || { echo "  FAIL DEGRADED-thermal-attrib label: got=$r"; fail=1; }
  echo "$r" | grep -q 'attributed=thermal' || { echo "  FAIL DEGRADED-thermal-attrib reason: got=$r"; fail=1; }
  # DEGRADED with attribution: capacity corroborates slow latency
  r="$(classify_storage WARNING SLOW COOL)"; echo "$r" | grep -q '^DEGRADED' || { echo "  FAIL DEGRADED-capacity-attrib label: got=$r"; fail=1; }
  echo "$r" | grep -q 'attributed=capacity' || { echo "  FAIL DEGRADED-capacity-attrib reason: got=$r"; fail=1; }
  # DEGRADED with attribution: BOTH corroborate
  r="$(classify_storage WARNING SLOW HOT)"; echo "$r" | grep -q 'attributed=thermal,capacity\|attributed=capacity,thermal' || { echo "  FAIL DEGRADED-both-attrib: got=$r"; fail=1; }
  # DEGRADED UNATTRIBUTED: slow latency, nothing corroborates — the actionable case
  r="$(classify_storage NORMAL SLOW COOL)"; echo "$r" | grep -q 'UNATTRIBUTED' || { echo "  FAIL DEGRADED-unattributed: got=$r"; fail=1; }
  # DEGRADED: thermal HOT alone (latency not yet degraded) — leading indicator
  r="$(classify_storage NORMAL FAST HOT)"; echo "$r" | grep -q '^DEGRADED' || { echo "  FAIL DEGRADED-thermal-leading label: got=$r"; fail=1; }
  echo "$r" | grep -q 'leading indicator' || { echo "  FAIL DEGRADED-thermal-leading reason: got=$r"; fail=1; }
  # DEGRADED: capacity WARNING alone
  r="$(classify_storage WARNING FAST COOL)"; echo "$r" | grep -q '^DEGRADED' || { echo "  FAIL DEGRADED-capacity-alone: got=$r"; fail=1; }
  # HEALTHY: all nominal
  r="$(classify_storage NORMAL FAST COOL)"; echo "$r" | grep -q '^HEALTHY' || { echo "  FAIL HEALTHY: got=$r"; fail=1; }
  # HEALTHY: thermal n/a (no NVMe hardware) is a valid steady-state, never penalized
  r="$(classify_storage NORMAL NORMAL n/a)"; echo "$r" | grep -q '^HEALTHY' || { echo "  FAIL HEALTHY-no-nvme: got=$r"; fail=1; }
  # HEALTHY: latency UNKNOWN (no IO yet) treated as non-degraded (never falls into SLOW/STALLED branch)
  r="$(classify_storage NORMAL UNKNOWN COOL)"; echo "$r" | grep -q '^HEALTHY' || { echo "  FAIL HEALTHY-latency-unknown: got=$r"; fail=1; }
  # CRITICAL beats DEGRADED in priority
  r="$(classify_storage WARNING STALLED HOT)"; echo "$r" | grep -q '^CRITICAL' || { echo "  FAIL CRITICAL-priority: got=$r"; fail=1; }
  # DEGRADED: both required OFFLINE
  r="$(classify_storage OFFLINE OFFLINE COOL)"; echo "$r" | grep -q '^DEGRADED' || { echo "  FAIL DEGRADED-2-offline: got=$r"; fail=1; }
  echo "$r" | grep -q 'disk-space' || { echo "  FAIL DEGRADED-2-offline detail: got=$r"; fail=1; }
  # DEGRADED: 1 required OFFLINE (thermal n/a doesn't count, only 1 total missing)
  r="$(classify_storage NORMAL OFFLINE n/a)"; echo "$r" | grep -q '^DEGRADED' || { echo "  FAIL DEGRADED-1-offline: got=$r"; fail=1; }
  echo "$r" | grep -q 'disk-latency' || { echo "  FAIL DEGRADED-1-offline detail: got=$r"; fail=1; }
  # thermal n/a (missing) never counts toward the required-offline tally even combined with a real offline
  r="$(classify_storage OFFLINE NORMAL n/a)"; echo "$r" | grep -q '^DEGRADED' || { echo "  FAIL thermal-not-counted label: got=$r"; fail=1; }
  echo "$r" | grep -q 'disk-latency' && { echo "  FAIL thermal-not-counted: should only list disk-space, got=$r"; fail=1; }
  # --- MOUNT ATTRIBUTION (2026-08-15): the verdict must say WHICH filesystem the capacity claim is
  # about. 'capacity=NORMAL' was published on a box whose /tmp was full and whose ROOT fs was fine.
  r="$(classify_storage NORMAL FAST COOL /tmp)"; echo "$r" | grep -q 'capacity=NORMAL@/tmp' || { echo "  FAIL attribution-healthy: capacity claim does not name its mount: got=$r"; fail=1; }
  r="$(classify_storage CRITICAL FAST COOL /tmp)"; echo "$r" | grep -q 'capacity=CRITICAL@/tmp' || { echo "  FAIL attribution-critical: got=$r"; fail=1; }
  r="$(classify_storage WARNING FAST COOL /dev/shm)"; echo "$r" | grep -q 'on /dev/shm' || { echo "  FAIL attribution-warning-alone: got=$r"; fail=1; }
  # a capacity sense that named no mount must NOT invent one (no stray '@')
  r="$(classify_storage NORMAL FAST COOL)"; echo "$r" | grep -q 'capacity=NORMAL@' && { echo "  FAIL attribution-absent: invented a mount: got=$r"; fail=1; }

  # --- CROSS-TOOL FORMAT GATE: read_capacity_where parses the reason string that mesh-disk-space
  # ACTUALLY writes. Parsing a hand-written fixture would assert only that this file agrees with
  # itself, and the two could drift the day the producer's wording changes. Drive the real producer
  # into a sandbox HOME (never the live state file — a --test must not write the artifact it checks).
  _ds=""; [ -x "$(dirname "$0")/mesh-disk-space" ] && _ds="$(dirname "$0")/mesh-disk-space"
  [ -z "$_ds" ] && command -v mesh-disk-space >/dev/null 2>&1 && _ds="$(command -v mesh-disk-space)"
  if [ -n "$_ds" ]; then
    _sb="$(mktemp -d -t mesh-storage-health.XXXXXXXX)"; trap 'rm -rf "$_sb"' EXIT INT HUP TERM
    mkdir -p "$_sb/.mesh"
    if HOME="$_sb" "$_ds" >/dev/null 2>&1 && [ -f "$_sb/.mesh/.disk-space.state" ]; then
      _w="$(read_capacity_where "$_sb/.mesh/.disk-space.state")"
      [ -n "$_w" ] || { echo "  FAIL cross-tool: mesh-disk-space's live state names no mount this parser can read: $(head -1 "$_sb/.mesh/.disk-space.state")"; fail=1; }
      case "$_w" in /*) : ;; *) echo "  FAIL cross-tool: parsed mount is not a path: '$_w'"; fail=1 ;; esac
    else
      echo "  (cross-tool format gate skipped: mesh-disk-space produced no state in the sandbox)"
    fi
    rm -rf "$_sb"; trap - EXIT INT HUP TERM
  else
    echo "  (cross-tool format gate skipped: mesh-disk-space not present)"
  fi

  [ "$fail" = 1 ] && { echo "smoke-test: FAIL"; exit 1; }
  echo "smoke-test: ok (22 fusion assertions: CRITICAL x3+priority, DEGRADED attribution x5+alone x2, HEALTHY x3, OFFLINE x3, mount-attribution x4 + live cross-tool format gate)"
  exit 0
fi

# --- Live read path ---
cap="$(read_capacity "$MESH/.disk-space.state")"
capw="$(read_capacity_where "$MESH/.disk-space.state")"
lat="$(read_latency "$MESH/.disk-latency-state")"
therm="$(read_thermal "$MESH/.nvme-temp.state")"

result="$(classify_storage "$cap" "$lat" "$therm" "$capw")"
label="${result%%|*}"
reason="${result#*|}"

# capture prev BEFORE overwriting STATE — reading it after the write would always see the label
# we just wrote (a real latent bug in the sibling mesh-system-vitality, which does exactly that
# and so its --edge is a permanent no-op); do the read/write in the right order here.
prev=""; [ -f "$STATE" ] && prev="$(head -1 "$STATE" 2>/dev/null | cut -d'|' -f1)" || true

TS=$(date -u +%Y-%m-%dT%H:%M:%SZ)
mkdir -p "$MESH" 2>/dev/null || true
printf '%s|capacity=%s|latency=%s|thermal=%s|%s\n' "$label" "$cap" "$lat" "$therm" "$reason" > "$STATE"
[ -x "$HOME/.local/bin/mesh-state-touch" ] && mesh-state-touch "$STATE" >/dev/null 2>&1 || touch "$STATE" 2>/dev/null || true

# --- Output ---
if [ "${1:-}" = --json ]; then
  printf '{"label":"%s","reason":"%s","inputs":{"capacity":"%s","latency":"%s","thermal":"%s"},"ts":"%s"}\n' \
    "$label" "$reason" "$cap" "$lat" "$therm" "$TS"
  exit 0
fi
if [ "${1:-}" = --edge ]; then
  [ "$prev" = "$label" ] && exit 0
  printf '[storage-health-%s] %s — %s\n' "$(printf '%s' "$label" | tr '[:upper:]' '[:lower:]')" "$label" "$reason"
  # A state CHANGE that only prints to cron stdout is a SILENT alert — invisible to the mesh.
  # (health flagged 2026-07-31: storage DEGRADED 30min+, verdict never reached chat.log, only
  # visible via mesh-dash/direct run.) Land the edge on the board so a storage transition is
  # SEEN by every mind. CRITICAL = imminent failure -> incident [task] for the health owner;
  # DEGRADED / recovery -> [fyi] naming the transition. Edge-gated (fires only on prev!=label)
  # so it cannot spam. NOT emitted in --test (that would forge a board post — a --test must never
  # write the log a human/watchdog reads); the live --edge path is the only writer.
  if command -v mesh-chat >/dev/null 2>&1; then
    from="${prev:-none}"
    case "$label" in
      CRITICAL) edge_msg="[task] storage-health CRITICAL on $(hostname): $reason (owner: health priority:incident)" ;;
      *)        edge_msg="[fyi] storage-health $(hostname): ${from}->${label} — $reason" ;;
    esac
    MESH_WHO="storage-health@$(hostname)" mesh-chat "$edge_msg" >/dev/null 2>&1 || true
  fi
  exit 0
fi
printf '[storage-health-%s] %s — %s\n' "$(printf '%s' "$label" | tr '[:upper:]' '[:lower:]')" "$label" "$reason"
