#!/usr/bin/env bash
# reflex-cadence: */10 * * * *
# mesh-nic-posture — NIC link-layer capture-posture canary (sniffer / monitor-mode sense).
#
# Why this is new:
#   mesh-gateway-identity attests the gateway binding; mesh-lan-newdevice watches new MACs;
#   nothing perceives what this node's OWN radios/NICs are doing at the link layer: an interface
#   flipped into PROMISCUOUS mode is the hardware signature of a packet sniffer attached to it,
#   and a wireless interface in MONITOR mode is a radio capturing the whole air. Both are real
#   /sys+netlink hardware-interface states (`ip -d link` promiscuity counter, `iw dev` type) —
#   no root, passive read. A legit cause exists (a bridge, our own tcpdump) — the sense reports
#   the EDGE, the mind judges the cause.
#
# Verdict vocabulary (a CONTRACT — consumers grep these tokens, do not rename):
#   STABLE   posture matches the learned baseline (including a stable non-clean posture)
#   CHANGED  posture differs from baseline (the canary edge; auto-rebaselines so the flip BACK
#            to clean fires its own CHANGED — every flip is an edge, no alarm latching)
#   NEW      first-ever observation on this node
# Posture value: "clean" or comma-joined "<iface>:promisc" / "<iface>:monitor" (sorted, lo skipped).
# Honesty contract: `ip -d link` unreadable or zero non-lo interfaces -> exit 2 (cannot attest),
#   NEVER a fake clean. `iw` absent is NOT exit 2 — promisc is still attested; JSON carries
#   "iw":false so a consumer knows monitor-mode was not checked.
# Baseline is CHANGE-GATED (rewritten only on NEW/CHANGED) -> mesh-state-touch on every
#   successful eval so a long-clean posture never decays to a false-STALE.
#
#   mesh-nic-posture          one compact line
#   mesh-nic-posture --json   machine-readable JSON
#   mesh-nic-posture --test   fixture smoke test + live real-read gate
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

MESH="${MESH_DIR:-$HOME/.mesh}"
BASELINE="$MESH/.nic-posture-state"        # posture|first_seen_ts
mkdir -p "$MESH" 2>/dev/null || true

# Fixture hooks (test sandbox): when set, read these files instead of running ip/iw.
LINK_FIX="${MESH_NIC_LINK_FILE:-}"
IWDEV_FIX="${MESH_NIC_IWDEV_FILE:-}"

link_read() {  # -> "iface<TAB>promiscuity" per non-lo interface, or fail if none parsed
  local out
  if [ -n "$LINK_FIX" ]; then out="$(cat "$LINK_FIX" 2>/dev/null)"
  else out="$(ip -d link show 2>/dev/null)"; fi
  printf '%s\n' "$out" | awk '
    /^[0-9]+:/ { split($2, a, "@"); ifc = a[1]; sub(/:$/, "", ifc) }
    /promiscuity/ && ifc != "" && ifc != "lo" {
      for (i = 1; i <= NF; i++) if ($i == "promiscuity") { printf "%s\t%s\n", ifc, $(i+1); ifc = "" }
    }' | grep .
}

iw_read() {  # -> "iface<TAB>type" per wireless interface; empty ok (no radios); fail = no iw
  local out
  if [ -n "$IWDEV_FIX" ]; then out="$(cat "$IWDEV_FIX" 2>/dev/null)"
  else command -v iw >/dev/null 2>&1 || return 1; out="$(iw dev 2>/dev/null)"; fi
  printf '%s\n' "$out" | awk '
    $1 == "Interface" { ifc = $2 }
    $1 == "type" && ifc != "" { printf "%s\t%s\n", ifc, $2; ifc = "" }'
}

if [ "${1:-}" = --test ]; then
  command -v awk >/dev/null 2>&1 || { echo "smoke-test: FAIL (no awk)"; exit 1; }
  command -v ip  >/dev/null 2>&1 || { echo "smoke-test: FAIL (no ip — cannot read link posture)"; exit 1; }
  td="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
  trap 'rm -rf "$td"' EXIT
  cat > "$td/link" <<'EOF'
1: lo: <LOOPBACK,UP,LOWER_UP> mtu 65536 qdisc noqueue state UNKNOWN mode DEFAULT group default qlen 1000
    link/loopback 00:00:00:00:00:00 brd 00:00:00:00:00:00 promiscuity 0 allmulti 0 minmtu 0 maxmtu 0
2: wlan0: <BROADCAST,MULTICAST,UP,LOWER_UP> mtu 1500 qdisc noqueue state UP mode DORMANT group default qlen 1000
    link/ether aa:bb:cc:dd:ee:ff brd ff:ff:ff:ff:ff:ff promiscuity 0 allmulti 0 minmtu 256 maxmtu 2304
EOF
  printf 'phy#0\n\tInterface wlan0\n\t\tifindex 2\n\t\ttype managed\n' > "$td/iw"
  run() { MESH_DIR="$td/mesh" MESH_NIC_LINK_FILE="$td/link" MESH_NIC_IWDEV_FILE="$td/iw" "$0" --json; }

  got="$(run)" || { echo "smoke-test: FAIL (first fixture read)"; exit 1; }
  printf '%s' "$got" | grep -q '"label":"NEW"'      || { echo "smoke-test: FAIL (first read -> NEW: $got)"; exit 1; }
  printf '%s' "$got" | grep -q '"posture":"clean"'  || { echo "smoke-test: FAIL (0-promisc managed -> clean: $got)"; exit 1; }
  got="$(run)" || { echo "smoke-test: FAIL (second fixture read)"; exit 1; }
  printf '%s' "$got" | grep -q '"label":"STABLE"'   || { echo "smoke-test: FAIL (same posture -> STABLE: $got)"; exit 1; }

  sed -i 's/ff promiscuity 0/ff promiscuity 1/' "$td/link"
  got="$(run)" || { echo "smoke-test: FAIL (promisc fixture read)"; exit 1; }
  printf '%s' "$got" | grep -q '"label":"CHANGED"'          || { echo "smoke-test: FAIL (promisc flip -> CHANGED: $got)"; exit 1; }
  printf '%s' "$got" | grep -q '"posture":"wlan0:promisc"'  || { echo "smoke-test: FAIL (posture names the iface: $got)"; exit 1; }
  printf '%s' "$got" | grep -q '"was":"clean"'              || { echo "smoke-test: FAIL (CHANGED carries was=: $got)"; exit 1; }
  got="$(run)" || { echo "smoke-test: FAIL (post-flip read)"; exit 1; }
  printf '%s' "$got" | grep -q '"label":"STABLE"'   || { echo "smoke-test: FAIL (auto-rebaseline -> STABLE: $got)"; exit 1; }

  printf 'phy#0\n\tInterface wlan0\n\t\tifindex 2\n\t\ttype monitor\n' > "$td/iw"
  got="$(run)" || { echo "smoke-test: FAIL (monitor fixture read)"; exit 1; }
  printf '%s' "$got" | grep -q '"label":"CHANGED"'  || { echo "smoke-test: FAIL (monitor flip -> CHANGED: $got)"; exit 1; }
  printf '%s' "$got" | grep -q 'wlan0:monitor'      || { echo "smoke-test: FAIL (posture carries monitor: $got)"; exit 1; }

  : > "$td/link"
  run >/dev/null 2>&1; rc=$?
  [ "$rc" = 2 ] || { echo "smoke-test: FAIL (no readable interfaces -> exit 2, got rc=$rc)"; exit 1; }

  # real-read gate: the live `ip -d link` must yield >=1 non-lo interface with a promiscuity
  # counter (state sandboxed so the node's real baseline is untouched; a fresh sandbox can only
  # render NEW, never a CHANGED post).
  real="$(MESH_DIR="$td/mesh-real" "$0" --json 2>/dev/null)"; rc=$?
  if [ "$rc" = 2 ]; then echo "smoke-test: n/a (no attestable non-lo interface on this node right now)"; exit 2; fi
  [ "$rc" = 0 ] || { echo "smoke-test: FAIL (live read rc=$rc)"; exit 1; }
  printf '%s' "$real" | grep -qE '"ifaces":[1-9][0-9]*' || { echo "smoke-test: FAIL (live read parsed no interfaces: $real)"; exit 1; }
  echo "smoke-test: ok (fixture NEW/STABLE/CHANGED promisc+monitor/exit-2 paths + live link-posture read)"
  exit 0
fi

JSON=0
for a in "$@"; do [ "$a" = --json ] && JSON=1; done

links="$(link_read)" || { echo "nic-posture: UNREACHABLE — no readable non-lo interface (cannot attest link posture)" >&2; exit 2; }
n_ifaces="$(printf '%s' "$links" | grep -c .)"

flags=""
while IFS=$'\t' read -r ifc prom; do
  [ "${prom:-0}" -gt 0 ] 2>/dev/null && flags="$flags$ifc:promisc"$'\n'
done <<< "$links"

iw_ok=true
if iwout="$(iw_read)"; then
  while IFS=$'\t' read -r ifc typ; do
    [ -n "${ifc:-}" ] && [ "$typ" = monitor ] && flags="$flags$ifc:monitor"$'\n'
  done <<< "$iwout"
else
  iw_ok=false
fi

posture="$(printf '%s' "$flags" | grep . | sort -u | paste -sd, -)"
[ -n "$posture" ] || posture=clean

ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
host="$(hostname)"
label=NEW; was=""; first_seen="$ts"
if [ -r "$BASELINE" ]; then
  IFS='|' read -r bposture bts < "$BASELINE" || true
  if [ "$bposture" = "$posture" ]; then label=STABLE; first_seen="$bts"
  elif [ -n "${bposture:-}" ]; then label=CHANGED; was="$bposture"
  fi
fi

# change-gated baseline write + unconditional liveness touch (mtime = ran-live, content = value)
if [ "$label" != STABLE ]; then
  printf '%s|%s\n' "$posture" "$first_seen" > "$BASELINE"
fi
mesh-state-touch "$BASELINE" 2>/dev/null || true

# the canary edge reaches the board (live mode only; fixtures never post)
if [ "$label" = CHANGED ] && [ -z "$LINK_FIX" ] && [ -z "$IWDEV_FIX" ] && command -v mesh-chat >/dev/null 2>&1; then
  mesh-chat "[fyi] nic-posture: CHANGED — $posture (was $was) on $host. Promisc = a sniffer attached, monitor = radio capturing the air; check for a legit cause (bridge/own tcpdump) before alarming." >/dev/null 2>&1 || true
fi

if [ "$JSON" = 1 ]; then
  printf '{"label":"%s","posture":"%s","was":%s,"ifaces":%s,"iw":%s,"first_seen":"%s","host":"%s","ts":"%s"}\n' \
    "$label" "$posture" "${was:+\"$was\"}" "$n_ifaces" "$iw_ok" "$first_seen" "$host" "$ts" | sed 's/"was":,/"was":null,/'
else
  printf '[nic-posture] %s %s%s ifaces=%s iw=%s since=%s @ %s %s\n' \
    "$label" "$posture" "${was:+ was=$was}" "$n_ifaces" "$iw_ok" "$first_seen" "$host" "$ts"
fi
