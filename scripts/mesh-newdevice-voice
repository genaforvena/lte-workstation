#!/usr/bin/env bash
# orphan-ok: node-specific opt-in ACTUATOR reflex — it makes SOUND, so it ships OFF and is wired
#            (reflex-cadence) only on a node with audio output where an audible heads-up is desired.
#            Actuator-consent doctrine: a sound-making reflex is never the genome default.
# mesh-newdevice-voice — the first AUDIBLE channel for the security sense (CONNECTION:
# mesh-lan-newdevice × mesh-say). When mesh-lan-newdevice posts a GENUINE unknown-device alert
# (globally-unique MAC) to the board AND the operator is HOME to hear it, speak it aloud via mesh-say.
#
# WHY occupancy-gated VOICE (the load-bearing design — a new fusion, not output-routing):
#   - Speaking a security alert to an EMPTY room is useless (no one hears) and mildly
#     counterproductive (an intruder physically present is tipped off). Spoken when the operator
#     is HOME it reaches them without their watching the board.
#   - So the gate is on the OUTPUT CHANNEL (speak vs board-only), NOT the alert SEVERITY —
#     mesh-perimeter owns the verdict; this never raises/lowers it (honest-fusion preserved).
#   - The LAA/private-MAC "(low)" NOTICE (Wi-Fi randomization, most likely a KNOWN device with a
#     new random MAC) is NEVER spoken — only the globally-unique-MAC genuine newcomer. Speaking
#     every privacy-MAC rotation aloud would flood the room (the same hazard that sank the
#     occupancy×lan-newdevice severity-gating pairings).
#
# Consumes the BOARD (mesh-lan-newdevice posts there, edge-triggered once per MAC) — does NOT
# re-run mesh-lan-newdevice (that would race its $KNOWN baseline). Offset-tracked so it never
# replays the board's backlog of past alerts on first run (reviving-offset-replays-backlog).
#
#   mesh-newdevice-voice          process new board [lan-new-device] alerts; speak the genuine ones if HOME
#   mesh-newdevice-voice --test   sandboxed gating truth-table (NEVER speaks, never SSHs, never reads board)
# reflex-cadence: none   (opt-in per node — see orphan-ok; off by default)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
MESH="$HOME/.mesh"; BOARD="$MESH/chat.log"; OFF="$MESH/.newdevice-voice-offset"; LOG="$MESH/newdevice-voice.log"

# pure gate (falsifiable, no I/O): should_speak <board-line> → 0 only for a genuine spoken-worthy alert
should_speak(){
  local line="$1"
  case "$line" in *'[lan-new-device]'*) ;; *) return 1;; esac   # must be a lan-new-device alert
  case "$line" in *'(low)'*) return 1;; esac                    # NEVER the LAA/private-MAC NOTICE
  case "$line" in *'globally-unique MAC'*) return 0;; esac      # the genuine never-seen newcomer
  return 1
}

if [ "${1:-}" = --test ]; then
  fail=0
  should_speak "x :: [lan-new-device] NEW device on the home LAN: foo (aa:bb:cc:dd:ee:ff, 192.168.8.9) — globally-unique MAC, never seen before. If unexpected while you're away, investigate." \
    || { echo "smoke-test: FAIL (genuine globally-unique-MAC alert must be spoken)"; fail=1; }
  should_speak "x :: [lan-new-device] (low) private/rotating MAC joined the LAN: bar (12:34:.., ..) — locally-administered address (iOS/Android Wi-Fi randomization)" \
    && { echo "smoke-test: FAIL (LAA/private-MAC '(low)' NOTICE must stay silent)"; fail=1; }
  should_speak "x :: [idle] genome green — nothing new" \
    && { echo "smoke-test: FAIL (non-alert board line must stay silent)"; fail=1; }
  should_speak "x :: [fyi] discussing a [lan-new-device] globally-unique MAC in prose" \
    && echo "  note: prose mentioning the tokens would match — acceptable (lan-watch@ is the only real emitter; board prose is rare)"
  [ "$fail" = 0 ] && { echo "smoke-test: ok (gate truth-table: global-MAC speaks; LAA-NOTICE + non-alert silent)"; exit 0; }
  exit 1
fi

[ -f "$BOARD" ] || { echo "no board ($BOARD) — nothing to watch"; exit 0; }
cur=$(wc -l < "$BOARD" 2>/dev/null); cur=${cur:-0}
last=$(cat "$OFF" 2>/dev/null); last=${last:-}
# first run OR post-reboot board-shrunk → initialize, DON'T replay the backlog of past alerts
if [ -z "$last" ] || ! [ "$last" -le "$cur" ] 2>/dev/null; then
  echo "$cur" > "$OFF"; echo "initialized offset at line $cur (no backlog replay)"; exit 0
fi
[ "$cur" -le "$last" ] && exit 0   # nothing new on the board

# occupancy gate (once per run): only speak if someone is HOME to hear it
home="UNCERTAIN"
if command -v mesh-operator-home >/dev/null 2>&1; then
  h=$(mesh-operator-home --json 2>/dev/null | sed -n 's/.*"status"[: ]*"\([A-Z]*\)".*/\1/p')
  [ -n "$h" ] && home="$h"
fi

ts(){ date -u +%FT%TZ; }
sed -n "$((last+1)),${cur}p" "$BOARD" 2>/dev/null | while IFS= read -r line; do
  should_speak "$line" || continue
  if [ "$home" = HOME ]; then
    command -v mesh-say >/dev/null 2>&1 \
      && mesh-say "Heads up — a new device just joined the home network, never seen before. You may want to check it." >/dev/null 2>&1
    echo "$(ts) SPOKE new-device alert (operator HOME)" >> "$LOG"
  else
    # board already has the alert; voice is a bonus channel — never announce to a maybe-empty room
    echo "$(ts) SUPPRESSED voice (operator $home — board-only, no empty-room announcement)" >> "$LOG"
  fi
done
echo "$cur" > "$OFF"   # advance offset every run (the board retains the alert; voice is additive)
exit 0
