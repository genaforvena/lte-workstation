#!/usr/bin/env bash
# mesh-whisper-run — the ONE niced + serialized entry point to whisper.cpp `main`.
#
#   mesh-whisper-run -m MODEL -f WAV [whisper args...]   # DROP-IN for the whisper binary (same args)
#   mesh-whisper-run --test
#
# WHY (chat-review/transcribe-path-nice, 2026-07-05): whisper.cpp is 1.5-2GB RSS + CPU-heavy, and the
# niceness kept getting missed per-caller — 7a53d61 niced ONLY mesh-overhear, so the tg-mind's ad-hoc
# 4-file whisper large-v3-turbo loop (unniced) racing a granular-synth job exhausted swap → the kernel
# OOM batch-killed ~8 processes (20:05-20:12Z; pipewire/wireplumber/mesh-cam-watch among them). The fix
# belongs AT THE BINARY CALL SITE, not in each of the 7+ callers: this shim (a) renices to 19 + ionice
# idle and (b) holds a shared flock so two whisper runs SERIALIZE instead of stacking RAM. Callers point
# their whisper path at this shim instead of ~/.mesh/whispercpp/main; the real binary is MESH_WHISPER_BIN
# (same default), so it is a transparent replacement.
set -uo pipefail
# ~/.local/bin on PATH so the `command -v mesh-heavy-run` admission probe below resolves regardless of
# caller context (cron/systemd PATH is /usr/bin:/bin — no ~/.local/bin). Without it the gate silently
# FAILS-OPEN under a bare PATH and whisper.cpp launches unguarded → the exact OOM this admission was
# added to prevent (sibling bug fixed in mesh-room-music dbcf44f). Idempotent; only adds if missing.
case ":$PATH:" in *":$HOME/.local/bin:"*) : ;; *) PATH="$HOME/.local/bin:$PATH" ;; esac
MESH="${MESH_DIR:-$HOME/.mesh}"
BIN="${MESH_WHISPER_BIN:-$MESH/whispercpp/main}"
LOCK="${MESH_WHISPER_LOCK:-$MESH/.whisper.lock}"
# A --test must not contend the PRODUCTION admission lock: the real transcription lane (voice-rx,
# room ear) queues/skips on this flock — a doctor-storm smoke holding it steals a live turn
# (task test-live-writes 2026-07-20, turbo-lid class). Test runs still exercise the REAL flock
# admission path, just on their own file.
if [ "${1:-}" = --test ] || [ "${MESH_TEST_SANDBOX:-0}" = 1 ]; then LOCK="${MESH_WHISPER_LOCK:-${TMPDIR:-/tmp}/.whisper.lock.sandbox.$$}"; fi
NICE="${MESH_WHISPER_NICE:-19}"
WAIT="${MESH_WHISPER_LOCK_WAIT:-300}"   # sec to wait for the serialization lock, then degrade (still niced)
# ADMISSION (chat-review/whisper-run-fold-heavy-gate): whisper.cpp is the highest-frequency heavy path
# (room STT, overhear, tg transcriptions) yet had ZERO pre-flight admission — a launch onto an already
# near-OOM node tipped swap over (12:04Z/06:24Z/08:14Z near-OOMs, main=whisper.cpp). Delegate the
# memory/pressure decision to mesh-heavy-run --admit (single source of truth); we keep our OWN whisper
# flock below (whisper-vs-whisper serialization) so the two locks never compound — only the mem gate is
# shared. A whisper launch while the node is pressured then DEFERS (polls) then REFUSES instead of OOMing.
BUDGET="${MESH_WHISPER_BUDGET_MB:-2000}"   # whisper.cpp is ~1.5-2GB RSS; declared admission budget
FORCE="${MESH_WHISPER_FORCE:-0}"           # 1 = bypass the admission gate (still niced + serialized)

# Build the best-available nice/ionice prefix — both are optional (a minimal env may lack ionice).
nice_prefix() {
  PRE=()
  command -v nice   >/dev/null 2>&1 && PRE+=(nice -n "$NICE")
  command -v ionice >/dev/null 2>&1 && PRE+=(ionice -c3)
}

if [ "${1:-}" = --test ]; then
  # tmp fence — task:doctor-test-tmpdir-cleanup-traps. Re-exec the smoke test ONCE under a private
  # TMPDIR and remove it from the PARENT, so the cleanup cannot be lost to the test's own `exit 1`
  # and cannot be clobbered by an EXIT trap the test sets for itself. A nested --test inherits the
  # guard var and skips its own fence (it is already inside one).
  if [ -z "${MESH_TEST_TMPD:-}" ]; then
    MESH_TEST_TMPD="$(mktemp -d)" || { echo "smoke-test: FAIL (tmp fence: mktemp -d)"; exit 1; }
    trap 'rm -rf "$MESH_TEST_TMPD"' EXIT INT HUP TERM
    export MESH_TEST_TMPD TMPDIR="$MESH_TEST_TMPD" TMP="$MESH_TEST_TMPD" TEMP="$MESH_TEST_TMPD"
    _fence_rc=0; "$0" "$@" || _fence_rc=$?; exit "$_fence_rc"
  fi
  # export so children divert too — the real-transcription leg invokes "$0" WITHOUT an explicit
  # MESH_WHISPER_LOCK and was taking the PRODUCTION admission lock (task test-live-writes 2026-07-20)
  export MESH_TEST_SANDBOX=1
  command -v flock >/dev/null 2>&1 || { echo "smoke-test: FAIL (flock missing — serialization impossible)"; exit 1; }
  command -v nice  >/dev/null 2>&1 || { echo "smoke-test: FAIL (nice missing — cannot renice)"; exit 1; }
  _td="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
  trap 'rm -rf "$_td"' EXIT
  _lk="$_td/lock"
  # 1) ARG PASSTHROUGH: the shim must forward its args to the real binary unchanged. Use a stub binary
  #    (echo is a shell builtin, not an -x path, so it can't stand in for the real binary here).
  printf '#!/bin/sh\nprintf "%%s" "$1"\n' > "$_td/echobin"; chmod +x "$_td/echobin"
  # MESH_WHISPER_FORCE=1 on the sub-invocations below so they bypass the live admission gate — these
  # cells assert passthrough/serialization, NOT admission (that has its own stub-driven cells at 3).
  _out="$(MESH_WHISPER_FORCE=1 MESH_WHISPER_BIN="$_td/echobin" MESH_WHISPER_LOCK="$_lk" "$0" passthru-token 2>/dev/null || true)"
  [ "$_out" = passthru-token ] || { echo "smoke-test: FAIL (arg passthrough broke — expected 'passthru-token', got '$_out')"; exit 1; }
  # 1b) STDERR PASSTHROUGH: whisper.cpp prints progress + --help to STDERR; the lock plumbing must NOT
  #     swallow it. Falsify: an `exec N>… 2>/dev/null` that leaks onto the final exec makes this empty.
  printf '#!/bin/sh\nprintf "on-stderr" >&2\n' > "$_td/errbin"; chmod +x "$_td/errbin"
  _err="$(MESH_WHISPER_FORCE=1 MESH_WHISPER_BIN="$_td/errbin" MESH_WHISPER_LOCK="$_lk" "$0" x 2>&1 >/dev/null || true)"
  [ "$_err" = on-stderr ] || { echo "smoke-test: FAIL (whisper STDERR swallowed by the lock plumbing — expected 'on-stderr', got '$_err')"; exit 1; }
  # 2) SERIALIZATION: two concurrent 1s runs must NOT overlap → elapsed >= ~2s (falsify: drop the flock
  #    and elapsed collapses to ~1s). Uses /bin/sleep as a stand-in whisper binary.
  _sleep="$(command -v sleep)"
  _start="$(date +%s.%N)"
  ( MESH_WHISPER_FORCE=1 MESH_WHISPER_BIN="$_sleep" MESH_WHISPER_LOCK="$_lk" MESH_WHISPER_LOCK_WAIT=15 "$0" 1 >/dev/null 2>&1 ) &
  ( MESH_WHISPER_FORCE=1 MESH_WHISPER_BIN="$_sleep" MESH_WHISPER_LOCK="$_lk" MESH_WHISPER_LOCK_WAIT=15 "$0" 1 >/dev/null 2>&1 ) &
  wait
  _el="$(awk -v a="$_start" -v b="$(date +%s.%N)" 'BEGIN{printf "%.2f", b-a}')"
  awk -v e="$_el" 'BEGIN{exit !(e >= 1.8)}' \
    || { echo "smoke-test: FAIL (serialization broken — two 1s runs took ${_el}s, expected >=1.8s: the flock isn't holding)"; exit 1; }

  # 3) ADMISSION DELEGATION (chat-review/whisper-run-fold-heavy-gate): whisper-run must call
  #    `mesh-heavy-run --admit <BUDGET>` and honor its verdict. Stub mesh-heavy-run on PATH so the
  #    decision is deterministic (STUB_ADMIT = its exit code), and record the budget it was handed.
  _stubdir="$_td/bin"; mkdir -p "$_stubdir"
  printf '#!/bin/sh\n[ "$1" = --admit ] || exit 64\nprintf "%%s" "$2" > "%s/asked"\nexit "${STUB_ADMIT:-0}"\n' "$_td" > "$_stubdir/mesh-heavy-run"
  chmod +x "$_stubdir/mesh-heavy-run"
  printf '#!/bin/sh\ntouch "%s/ran-marker"\n' "$_td" > "$_td/ranbin"; chmod +x "$_td/ranbin"
  # 3a) ADMITTED (stub exits 0) → whisper runs + passthrough works + the declared BUDGET was delegated.
  rm -f "$_td/asked"
  _out="$(PATH="$_stubdir:$PATH" MESH_WHISPER_BUDGET_MB=1234 MESH_WHISPER_BIN="$_td/echobin" MESH_WHISPER_LOCK="$_lk" "$0" admitted-token 2>/dev/null || true)"
  [ "$_out" = admitted-token ] || { echo "smoke-test: FAIL (admitted whisper must run — expected 'admitted-token', got '$_out')"; exit 1; }
  [ "$(cat "$_td/asked" 2>/dev/null)" = 1234 ] || { echo "smoke-test: FAIL (whisper must delegate MESH_WHISPER_BUDGET_MB to mesh-heavy-run --admit — expected 1234, got '$(cat "$_td/asked" 2>/dev/null)')"; exit 1; }
  # 3b) REFUSED (stub exits 75) → whisper must NOT run the binary and must propagate EX_TEMPFAIL 75.
  rm -f "$_td/ran-marker"
  PATH="$_stubdir:$PATH" STUB_ADMIT=75 MESH_WHISPER_BIN="$_td/ranbin" MESH_WHISPER_LOCK="$_lk" "$0" x >/dev/null 2>&1
  _rc=$?
  [ "$_rc" = 75 ] || { echo "smoke-test: FAIL (refused admission must propagate EX_TEMPFAIL 75, got $_rc)"; exit 1; }
  [ ! -e "$_td/ran-marker" ] || { echo "smoke-test: FAIL (refused whisper must NOT run the binary)"; exit 1; }
  # 3c) FORCE bypasses the gate: even with a refusing stub, MESH_WHISPER_FORCE=1 runs whisper anyway.
  _out="$(PATH="$_stubdir:$PATH" STUB_ADMIT=75 MESH_WHISPER_FORCE=1 MESH_WHISPER_BIN="$_td/echobin" MESH_WHISPER_LOCK="$_lk" "$0" forced-token 2>/dev/null || true)"
  [ "$_out" = forced-token ] || { echo "smoke-test: FAIL (MESH_WHISPER_FORCE=1 must bypass admission — expected 'forced-token', got '$_out')"; exit 1; }
  # 3d) VERSION-SKEW FAIL-OPEN: an OLD heavy-run without --admit EX_USAGEs (64) on the flag — whisper
  #     must NOT propagate that; it treats any non-75 as fail-open and RUNS (deployment-order-independent).
  _out="$(PATH="$_stubdir:$PATH" STUB_ADMIT=64 MESH_WHISPER_BIN="$_td/echobin" MESH_WHISPER_LOCK="$_lk" "$0" skew-token 2>/dev/null || true)"
  [ "$_out" = skew-token ] || { echo "smoke-test: FAIL (non-75 admit code must fail-open and run whisper — expected 'skew-token', got '$_out')"; exit 1; }

  # REAL-READ GATE. Everything above drives STUB binaries (echobin/errbin/sleep) — it proves the
  # shim's plumbing and says NOTHING about whether whisper can actually start. It reported green for a
  # day while $BIN died rc=127 on every call: `main` was rpath-patched to $ORIGIN but the LIBRARIES
  # kept their build-tree runpath (/tmp/whisper.cpp/build/bin, long deleted), so libwhisper loaded and
  # its own deps did not. `[ -x "$BIN" ]` is not "it runs" — executable and loadable are different
  # claims. Downstream, mesh-voice-rx read the empty stdout as no-transcript and fell through to Groq,
  # which 403'd, and the operator's voice notes landed as "[voice: empty transcript]".
  # So: transcribe a known wav with the real binary and assert the known words come back.
  _rm=""; for _c in "$MESH/whispercpp/models/ggml-base.bin" "$MESH/whispercpp/models/ggml-tiny.bin"; do
    [ -s "$_c" ] && { _rm="$_c"; break; }; done
  _rw="$MESH/whispercpp/sample-jfk.wav"
  if [ -z "$_rm" ] || [ ! -s "$_rw" ] || [ ! -x "$BIN" ]; then
    # Honest n/a — no model/sample/binary on this node (mesh-land treats exit 2 as a pass), never a
    # fake green. A node that HAS the organ is always gated.
    echo "smoke-test: n/a (no whisper model/sample/binary here — real-read gate needs the organ)"; exit 2
  fi
  _rt="$(MESH_WHISPER_FORCE=1 timeout 240 "$0" -m "$_rm" -f "$_rw" -nt -l auto 2>/dev/null || true)"
  case "$_rt" in
    *"ask not what your country"*) : ;;
    *) echo "smoke-test: FAIL (real whisper read produced no known transcript — got '$(printf '%s' "$_rt" | tr -d '\n' | cut -c1-60)'; check ldd $BIN)" >&2; exit 1 ;;
  esac

  echo "smoke-test: ok (nice -n $NICE + ionice + flock-serialized + heavy-run admission-delegate; arg-passthrough + 2×1s-serialize=${_el}s + admit/refuse/force asserts pass; REAL whisper read transcribed sample-jfk)"
  exit 0
fi

[ -x "$BIN" ] || { echo "mesh-whisper-run: whisper binary not executable: $BIN" >&2; exit 127; }

# ADMISSION FIRST, before taking the whisper flock — so we DEFER on memory without holding the
# serialization lock (which would block other whisper runs while we wait on headroom). Delegate to
# mesh-heavy-run --admit; on refusal propagate its EX_TEMPFAIL (75) so the caller skips/retries rather
# than the kernel OOM-killing a batch. Fail-open if mesh-heavy-run is absent (minimal node) or FORCE=1:
# admission is best-effort, the nice+flock path below still applies.
if [ "$FORCE" != 1 ] && command -v mesh-heavy-run >/dev/null 2>&1; then
  mesh-heavy-run --admit "$BUDGET"; _adm=$?
  # Gate ONLY on EX_TEMPFAIL (75 = honest "node cannot admit") → propagate so the caller skips/retries.
  # ANY other non-zero (e.g. an OLD heavy-run without --admit → EX_USAGE 64, or a probe error) is
  # fail-open: proceed unguarded, exactly as before the fold. This makes the rollout deployment-order-
  # independent — a node that gets the new whisper-run before the new heavy-run degrades to no-gate, it
  # never breaks whisper (the gate simply doesn't engage until heavy-run catches up).
  [ "$_adm" = 75 ] && exit 75
fi

nice_prefix
# Serialize: hold a shared advisory lock (fd 9, no O_CLOEXEC → survives the exec into whisper, released
# when whisper exits). Degrade to unserialized-but-niced if the lock can't be opened or isn't acquired
# within WAIT. The fd-9 open is wrapped in a group whose `2>/dev/null` is SCOPED to the group (it must
# NOT leak onto the final exec, or whisper's own stderr — help/progress — would vanish).
if command -v flock >/dev/null 2>&1 && { exec 9>"$LOCK"; } 2>/dev/null; then
  flock -w "$WAIT" 9 2>/dev/null || true
fi
exec ${PRE[@]+"${PRE[@]}"} "$BIN" "$@"
