#!/usr/bin/env bash
# mesh-journal-watch — LIVE current-boot error-priority sense: reads journalctl -p err as it accrues.
#
# WHY (spec: ~/.mesh/knowledge/capability-journalctl-current-boot-err-priority-unread-live-mesh-home-20260731.md,
# discover 2026-07-31): the systemd/kernel `-p err` priority stream is read by the mesh ONLY
# retrospectively and ONLY after a reboot — mesh-node-care:296 and mesh-heartbeat:66 both read
# `journalctl -b -1 -p err` (PREVIOUS boot, reboot-triggered forensics); mesh-doctor never touches
# journalctl at all. So an error-priority fault that occurs mid-boot on a node that never freezes or
# reboots is invisible to the mesh forever — it only surfaces in the narrow case where the node crashes
# AFTER it, and even then only the last ~30-40 tail lines survive. Real signal sitting unread in this
# stream right now: recurring Bluetooth hci0 opcode failures, and hourly PipeWire 'capture open failed:
# Device or resource busy' collisions on the USB webcam mic. This closes that live blind spot.
#
# DELTA over the existing fault senses (not a re-implementation):
#   - mesh-node-care / mesh-heartbeat read `-b -1 -p err` (previous boot, only on a rejoin/reboot event).
#     THIS reads `-b 0` continuously via a persistent journal cursor, so a fault is caught within one
#     cadence of happening, not weeks later if-and-only-if the node reboots.
#   - mesh-crash-watch reads Apport /var/crash (userspace process crashes WITH core files). This is the
#     kernel/systemd `-p err` stream — driver/hardware/protocol faults (Bluetooth opcode, PipeWire
#     device-busy, cgroup OOM records) that never produce a *.crash file. The channels are orthogonal.
#
#   mesh-journal-watch            one delta pass: [fyi] once per genuinely NEW fault SIGNATURE, tape it (cron)
#   mesh-journal-watch --once     current-boot -p err signatures + counts (post-exclusion), no state change
#   mesh-journal-watch --status   last state line, no read
#   mesh-journal-watch --reset    clear cursor + seen (next pass re-seeds baseline-silent)
#   mesh-journal-watch --scope    COGNITIVE-SCOPE posture of normalize() itself (report-only, no state)
#   mesh-journal-watch --test     journalctl real-read gate (honest n/a exit 2 if absent) + fixture logic
#
# COGNITIVE SCOPE (--scope, 2026-08-01) — measure the NORMALIZER, not just what it emits.
#   Vervaeke's opponent-processing account of relevance realization names three trade-off pairs; the mesh
#   already instruments two (tempering=focusing/diversifying -> mesh-novelty --tempering; efficiency/
#   resiliency -> mesh-sensorium --balance). The third is COGNITIVE SCOPE: compression <-> particularization,
#   i.e. generality vs specialization — "trade-offs involved can be subsumed under the general opposition of
#   efficiency vs. resilience or, more specifically, as generality vs. specialization, exploration vs.
#   exploitation, and focusing vs. diversifying" (Jaeger/Riedl/Vervaeke et al. 2024, Front. Psychol.
#   15:1362658, doi:10.3389/fpsyg.2024.1362658, §3). Vervaeke/Lillicrap/Richards 2012 (J.Logic&Comp
#   22(1):79-99) put it operationally: compression is "analogous to finding the line of best fit", while
#   particularization "allow[s] the function to move towards over-fitting to the data".
#
#   normalize() IS this tool's compression map — it decides the ALPHABET of faults this node can name at
#   all. It was chosen a priori and never measured, yet the whole sense (dedup, SEEN, novelty, burst cap)
#   rests on it sitting at the right point on that axis. Both poles fail, asymmetrically:
#     - OVER-COMPRESSED (the silent pole): distinct faults fold into ONE signature, so fault #2..n are
#       NEVER announced — the first one burned the single alert. Green and silent = the dead-lane shape.
#     - OVER-PARTICULARIZED (the storm pole): every line mints a fresh signature, SEEN never converges,
#       "NEW" stops meaning anything and the burst cap is all that stands between the board and a storm.
#       Measured on TWO scales, because one global rate is a MAJORITY VOTE and the pole is usually LOCAL:
#       a GLOBAL singleton rate over the whole alphabet, and a PER-FAMILY rate over the signatures sharing
#       a skeleton (the message with its variable tokens dropped). The second was earned 2026-08-28: this
#       tool's own normalizer was splitting one recurring systemd-scope fault into a signature per UUID,
#       five signatures wide beside ~26 healthy repeating ones — and 5/31 = 0.16 can never reach SFLOOR
#       0.90, so the guard shipped for this exact pole could not see the pole in itself.
#       Live corroboration from the log-templating literature: on BGL "79.8% of anomalous test lines
#       originate from EventIDs not matched by any Drain3 template extracted from the offline region,
#       indicating substantial temporal concept drift" (Wang/Huang/Tian/Dzeparoska/Jacobsen/Leon-Garcia,
#       FAME, arXiv:2605.22779v1, 2026-05-21) — a signature alphabet fitted on one window under-covering
#       the next is the measured, not hypothetical, failure of a fixed normalizer.
#   --scope is REPORT-ONLY and writes NO state: it is a posture read, not a gate, and nothing in the
#   default pass consults it. rc 0 BALANCED/NO-DATA · 3 OVER-COMPRESSED · 4 OVER-PARTICULARIZED.
#   Review: docs/reviews/rr-cognitive-scope-signature-normalizer-journal-watch-2026-08-01.md
#
# Design constraints (each earned by a documented trap in CLAUDE.md / MEMORY):
#   - SIGNATURE, NOT RAW COUNT. This stream's noise floor is bursty and enormous — 12k+ rtw_8822bu USB-wifi
#     register lines/boot, hundreds of pipewire lines, 200+ OOM lines — so a threshold on line count is
#     meaningless. Each line is normalized (hex->0xN, digit-runs->N) into a signature; a signature alerts
#     [fyi] AT MOST ONCE (persistent SEEN file), the FIRST time it appears. 12,198 rtw lines collapse to
#     one alert; the tape keeps the count + a raw sample for forensics. Novelty is the signal, volume is
#     the tape.
#   - EXCLUDE mesh-heavy-run's OOM PROBES, BY NAME. mesh-heavy-run's cgroup-delegation probe proves the
#     ceiling BINDS by getting killed by it, so every fire mints a real kernel OOM line (as-designed,
#     scripts/mesh-heavy-run mem_cap_available()). Reporting it is a false positive and it poisons the
#     dedup, so it is dropped BEFORE signature/dedup. The probes now SIGN themselves — the allocator
#     runs through a symlink so the kernel prints comm `mesh-capcheck` (the bind probe) or `mesh-caphog`
#     (the --test over-budget hog) — and this filter names exactly those two. It carries NO size term
#     and NO blanket comm class: the old `(python*` clause dropped every python cgroup OOM including
#     real ones (measured: the grind's own cap-kills, 2026-08-22). A GLOBAL oom ("Out of memory:"), a
#     real python cgroup OOM, and an unsigned probe all still surface.
#   - BASELINE-SILENT FIRST RUN (mesh-kill-events' replay-trap guard). The journal holds 12k+ backlog err
#     lines; a first run must NOT storm the board with history. First run seeds the cursor at the current
#     tail (`-n 0 --cursor-file`) and stays silent; only faults accruing AFTER install are surfaced. (The
#     current backlog was already surfaced manually by discover.)
#   - CURSOR-GATED, NO REPEAT. journalctl's own `--cursor-file` advances monotonically, so a line is read
#     exactly once, and (journal is persistent here, /var/log/journal) the cursor flows ACROSS a reboot —
#     strictly more coverage than `-b -1`-on-reboot. If the journal is vacuumed past the cursor
#     ("Failed to seek to cursor", rc=1) the pass re-seeds silently and tapes a reseat note, never storms.
#   - BURST CAP (MESH_JOURNAL_WATCH_CAP): if a single pass yields more than CAP new signatures, collapse
#     to one summary line — a first pass right after seeding can legitimately meet several standing faults
#     at once (rtw + pipewire + bluetooth); it must never become N board posts.
#   - HONEST N/A: a node without journalctl (non-systemd) is not blind, it is not-applicable -> --test
#     exits 2 (mesh-land treats exit 2 as a pass), never a fake QUIET.
#   - liveness-touch every successful pass (mtime = ran) independent of whether anything fired.
#
# reflex-cadence: */5 * * * *
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

STATE_DIR="${MESH_STATE_DIR:-$HOME/.mesh}"
CURSOR="$STATE_DIR/.journal-watch-cursor"
SEEN="$STATE_DIR/.journal-watch-seen"
TAPE="${MESH_JOURNAL_WATCH_TAPE:-$STATE_DIR/journal-watch.log}"
STATE="$STATE_DIR/.journal-watch-state"
CHAT="${MESH_JOURNAL_WATCH_CHAT:-1}"
CAP="${MESH_JOURNAL_WATCH_CAP:-8}"          # new-signature board-post cap; a burst beyond this collapses
# --scope knobs (cognitive-scope posture only; no other path reads these)
IDCAP="${MESH_JOURNAL_WATCH_IDCAP:-4}"      # bucket distinct-raw ceiling below which a re-visited set reads
                                            # as an ENUMERABLE IDENTITY (hw:0/hw:1, hci0/hci1, usb port),
                                            # not an unbounded counter. Above it -> counter, folding is right.
SFLOOR="${MESH_JOURNAL_WATCH_SFLOOR:-0.90}" # singleton-signature rate at/above which the alphabet is judged
                                            # never to converge (over-particularized)
MINSIG="${MESH_JOURNAL_WATCH_MINSIG:-8}"    # min signatures before the GLOBAL singleton rate is meaningful at all
FMINSIG="${MESH_JOURNAL_WATCH_FMINSIG:-4}"  # min signatures in ONE family before its own singleton rate is
                                            # meaningful (the per-family twin of MINSIG — a 1-signature
                                            # family is 100% singleton by construction and says nothing)
mkdir -p "$STATE_DIR"

# --- helpers -----------------------------------------------------------------
normalize(){ # stdin: raw message -> normalized signature body (volatile tokens collapsed)
  # A UUID IS FOLDED AS A UNIT, AND IT MUST RUN FIRST (2026-08-28, task journal-watch-normalize-splits-
  # a-uuid-into-a-signature-per-scope). The {8,} rule below is a length floor, and a UUID is 8-4-4-4-12:
  # only the first and last group clear it. The three middle 4-char groups fell through to the digit rule
  # and left a per-UUID letter/N residue, so ONE recurring fault minted a fresh signature every time and
  # "NEW" stopped meaning anything — the tool's own documented storm pole, sitting in its own normalizer.
  # DRIVEN, not reasoned: the five real `tmux-spawn-<uuid>.scope` failures on the board and in the tape
  # gave 'Failed to start tmux-spawn-HEX-cN-Nbf-NbN-HEX.scope', '...HEX-eNb-Nc-aNba-HEX...',
  # '...HEX-eNcd-Nb-NadN-HEX...', '...HEX-bfN-Nadf-adN-HEX...', '...HEX-dcN-NcNe-aNcN-HEX...' — sort -u
  # said 5 signatures for 1 fault, and the board carried 5 "NEW -p err fault signature" posts (two of
  # them ONE SECOND apart, 22:25:04Z/22:25:05Z 2026-08-28). Folding is the right call and --scope's own
  # IDCAP doctrine says why: a UUID set is unbounded and never re-visited, i.e. a COUNTER, not an
  # enumerable identity — the case where folding away WHICH one loses nothing. It is NOT over-compression:
  # the surrounding text still discriminates, so tmux-spawn-UUID.scope and session-UUID.scope stay two
  # signatures (asserted below). Both cases, because a DMI/machine UUID is printed uppercase.
  sed -E -e 's/\b[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}\b/UUID/g' \
         -e 's/0x[0-9a-fA-F]+/0xN/g' -e 's/\b[0-9a-f]{8,}\b/HEX/g' -e 's/[0-9]+/N/g'
}

is_heavy_run_oom(){ # $1=msg -> 0 (drop) iff it is mesh-heavy-run's designed cgroup OOM-probe signature
  # IDENTITY, NOT A BLANKET COMM (2026-08-22, task capcheck-mints-the-oom-line-a-real-detector-reads).
  # This clause was `*"(python"*` — every python cgroup OOM, probe or not — and the header above
  # conceded the tradeoff ("a real python CGROUP OOM would also be dropped ... no real python-under-
  # cgroup workload runs here"). That premise is FALSE and was measured false: the grainneukeln grind
  # is a real python-under-cgroup workload and its cap-kills (2026-08-22T13:08:42Z, 13:33:14Z, comm
  # `python`, anon-rss ~2.55G) were being dropped here silently. mesh-heavy-run now SIGNS both of its
  # probe minters at the source, so drop exactly those two names and nothing else. A probe that failed
  # to sign itself surfaces, which is the honest direction.
  # (Scope note, measured 2026-08-22 rather than assumed: the task that prompted this said "eight
  # tools call --capcheck, mesh-journal-watch among them". That count comes from grepping the STRING
  # `mesh-heavy-run`, and for five of those tools every hit is a COMMENT or a nudge string — this file
  # included; it names mesh-heavy-run but never invokes it. Only mesh-sound-reflex, mesh-whisper-run
  # and mesh-room-music actually run jobs through it, so the probe's fire rate is driven by three
  # callers, not eight. A mention is not a call.)
  case "$1" in
    "Memory cgroup out of memory: Killed process "*"(mesh-capcheck)"*) return 0 ;;
    "Memory cgroup out of memory: Killed process "*"(mesh-caphog)"*)   return 0 ;;
  esac
  return 1
}

# Emit "IDENT|||MSG" for each error-priority entry to process this pass.
#   test mode (MESH_JOURNAL_WATCH_STDIN=1): records are already on stdin (fixtures).
#   live mode: delta since the persistent cursor; re-seed on a seek failure.
SEEK_RESEED=0
delta_records(){
  if [ "${MESH_JOURNAL_WATCH_STDIN:-0}" = 1 ]; then cat; return 0; fi
  local errf; errf="$(mktemp)"
  journalctl -p err --cursor-file="$CURSOR" -o json 2>"$errf" \
    | jq -r '((.SYSLOG_IDENTIFIER // ._COMM // "kernel")|tostring) + "|||" + ((.MESSAGE // "")|tostring)'
  local jrc=${PIPESTATUS[0]}
  if [ "$jrc" -ne 0 ] && grep -q 'seek to cursor' "$errf" 2>/dev/null; then
    journalctl -p err -n 0 --cursor-file="$CURSOR" >/dev/null 2>&1   # re-seat at tail, silent
    printf '%s cursor-reseat (journal rotated past cursor)\n' "$(date -u +%FT%TZ)" >> "$TAPE"
    SEEK_RESEED=1
  fi
  rm -f "$errf"
}

have_journalctl(){ command -v journalctl >/dev/null 2>&1; }

# --- --once: human view, no state change ------------------------------------
if [ "${1:-}" = --once ]; then
  have_journalctl || { echo "mesh-journal-watch: n/a (no journalctl — not a systemd node)"; exit 2; }
  jq --version >/dev/null 2>&1 || { echo "mesh-journal-watch: FAIL (no jq)"; exit 1; }
  journalctl -b 0 -p err -o json 2>/dev/null \
    | jq -r '((.SYSLOG_IDENTIFIER // ._COMM // "kernel")|tostring) + "|||" + ((.MESSAGE // "")|tostring)' \
    | while IFS= read -r rec; do
        m="${rec#*|||}"; is_heavy_run_oom "$m" && continue
        printf '%s\t%s\n' "${rec%%|||*}" "$(printf '%s' "$m" | normalize)"
      done \
    | sort | uniq -c | sort -rn \
    | awk '{c=$1; $1=""; sub(/^ /,""); printf "  %6d  %s\n", c, $0}'
  echo "  (mesh-heavy-run OOM-probe excluded; signatures normalized)"
  exit 0
fi

# --- --scope: COGNITIVE-SCOPE posture of normalize() (report-only, NO state change) -----------------
# Reads the CURRENT boot (like --once) — never the cursor, so a posture read can never consume a delta
# the real pass owes the board, and never forges a tape/seen/state artifact a watchdog reads for liveness.
scope_records(){
  if [ "${MESH_JOURNAL_WATCH_STDIN:-0}" = 1 ]; then cat; return 0; fi
  journalctl -b 0 -p err -o json 2>/dev/null \
    | jq -r '((.SYSLOG_IDENTIFIER // ._COMM // "kernel")|tostring) + "|||" + ((.MESSAGE // "")|tostring)'
}

if [ "${1:-}" = --scope ]; then
  if [ "${MESH_JOURNAL_WATCH_STDIN:-0}" != 1 ]; then
    have_journalctl || { echo "mesh-journal-watch --scope: n/a (no journalctl — not a systemd node)"; exit 2; }
    jq --version >/dev/null 2>&1 || { echo "mesh-journal-watch --scope: FAIL (no jq)"; exit 1; }
  fi
  scope_records \
    | while IFS= read -r rec; do
        [ -n "$rec" ] || continue
        m="${rec#*|||}"; is_heavy_run_oom "$m" && continue
        # tabs are the field separator downstream; raw messages may contain them
        printf '%s|||%s\t%s\n' "${rec%%|||*}" "$(printf '%s' "$m" | normalize | tr '\t' ' ')" "$(printf '%s' "$m" | tr '\t' ' ')"
      done \
    | awk -F'\t' -v idcap="$IDCAP" -v sfloor="$SFLOOR" -v minsig="$MINSIG" \
                 -v fminsig="$FMINSIG" '
      # FAMILY SKELETON — the message with every VARIABLE token dropped: a family is the set of signatures
      # that are the same sentence differing only where the message carries a value. Two properties earn it:
      #   - it is computed from the RAW message, NEVER the normalized one. After normalize() a digit-derived
      #     N is indistinguishable from a literal N (`Network`, `HNC`), so keying on the normalized text
      #     would drop real words and merge unrelated messages. The raw still has actual digits.
      #   - it drops variable tokens rather than taking a leading PREFIX. A prefix rule was tried first and
      #     measured FALSE against the live journal here (2026-08-28): every rtw_8822bu 1-3:1.0 line begins
      #     with a digit-bearing word, so seven genuinely DIFFERENT driver faults (leave idle state failed,
      #     h2c queue mismatch, failed to configure mac, ...) all landed in one catch-all bucket and were
      #     reported as a storm. They are seven real faults, correctly given seven signatures. Under the
      #     skeleton they have seven distinct skeletons and no family fires.
      function famkey(ident, raw,   i, w, nw, out) {
        nw = split(raw, w, /[ \t]+/); out = ""
        for (i=1; i<=nw; i++) {
          if (w[i] ~ /[0-9]/) continue                 # carries a value -> not part of the skeleton
          out = (out=="" ? w[i] : out " " w[i])
        }
        if (out == "") out = "<all-variable>"
        return ident "|||" out
      }
      {
        sig=$1; raw=$2; total++
        n[sig]++
        k=sig SUBSEP raw; c[k]++
        if (c[k]==1) d[sig]++          # distinct raw messages absorbed by this signature
        if (c[k]==2) r[sig]++          # ... of which RECUR (a stable, re-visited value, not a fresh counter)
        if (!(sig in fam)) fam[sig] = famkey(substr(sig, 1, index(sig,"|||")-1), raw)
      }
      END{
        if (total==0) { print "NO-DATA"; exit }
        sigs=0; single=0; degen=0; idfold=0
        for (s in n) {
          sigs++
          if (n[s]==1) single++
          f=fam[s]; fs[f]++; if (n[s]==1) fsingle[f]++
          body=substr(s, index(s,"|||")+3)
          # DEGENERATE: a signature body with no alphabetic character discriminates NOTHING — every fault
          # that lands in it after the first is silent forever.
          if (body !~ /[A-Za-z]/) {
            degen++
            printf "  DEGENERATE     n=%-5d raws=%-3d  [%s]  <- no alphabetic content: absorbs anything\n", n[s], d[s], s | "sort"
            continue
          }
          # IDENTITY-FOLD: >=2 distinct raws, a SMALL set (<=idcap), and >=2 of them RECUR. A small
          # re-visited value set is an enumerable identity (device/port/instance index), not an unbounded
          # counter — so normalize() folded away WHICH thing faulted, and only the first ever alerted.
          if (d[s]>=2 && d[s]<=idcap && r[s]>=2) {
            idfold++
            printf "  IDENTITY-FOLD  n=%-5d raws=%-3d  [%s]  <- %d distinct raws, %d recurring: an enumerable identity was folded\n", n[s], d[s], s, d[s], r[s] | "sort"
          }
        }
        # FAMILY-STORM — the per-family twin of the global singleton rate (2026-08-28, same task). ONE
        # global rate over the whole alphabet is a MAJORITY VOTE: the UUID family above was storming five
        # signatures wide beside ~26 healthy repeating ones, and 5/31 = 0.16 can never reach SFLOOR 0.90,
        # so the guard shipped for exactly this pole could not see the pole in its own normalizer. A rate
        # computed over signatures SHARING A STEM lets one storming family trip it while the rest is
        # healthy. It is an ADDED arm, not a replacement: an alphabet that is globally all-singleton has
        # every family at size 1, below fminsig, so a pure per-family rule would go BLIND to the shape
        # case (12) asserts. Report-only, like everything in --scope — it names a stem whose residue never
        # converges and leaves it to a human to say whether that residue is identity or noise, which is
        # the one question the normalizer structurally cannot answer about itself.
        storm=0; fams=0
        for (f in fs) {
          fams++
          # the all-variable bucket is a CATCH-ALL, not a family — it holds messages that share no fixed
          # text at all, so a high singleton rate in it says nothing about any one stem. Excluded loudly
          # rather than silently: it is counted in families= and never in family-storm=.
          if (f ~ /\|\|\|<all-variable>$/) continue
          if (fs[f] >= fminsig && (fsingle[f]+0)/fs[f] >= sfloor) {
            storm++
            printf "  FAMILY-STORM   sigs=%-5d singletons=%-3d  [%s]  <- this stem mints a fresh signature nearly every time: normalize() leaves a per-event residue here\n", fs[f], fsingle[f]+0, f | "sort"
          }
        }
        close("sort")
        rho = 1 - (sigs/total)
        srate = single/sigs
        printf "records=%d  signatures=%d  compression=%.3f  singleton-rate=%.2f  degenerate=%d  identity-fold=%d  families=%d  family-storm=%d\n", total, sigs, rho, srate, degen, idfold, fams, storm
        gpart = (sigs>=minsig && srate>=sfloor)
        fpart = (storm>0)
        if (degen>0 || idfold>0) { verdict="OVER-COMPRESSED"; rc=3 }
        else if (gpart || fpart) { verdict="OVER-PARTICULARIZED"; rc=4 }
        else { verdict="BALANCED"; rc=0 }
        # WHICH arm fired is part of the verdict — the two have different remedies (a global storm means
        # the normalizer is too fine everywhere; a family storm means one stem carries an unfolded residue).
        why = ""
        if (gpart) why = sprintf("global singleton-rate %.2f >= %s over %d signatures", srate, sfloor, sigs)
        if (fpart) why = why (gpart ? "; " : "") sprintf("%d storming famil%s (>=%d sigs each, singleton-rate >= %s)", storm, (storm==1?"y":"ies"), fminsig, sfloor)
        # both poles can hold at once; the silent pole wins the verdict (a blind sense outranks a loud one)
        also=""
        if (rc==4) also=" (" why ")"
        if (rc==3 && (gpart || fpart)) also=" (+ over-particularized: " why ")"
        print "scope: " verdict also
        exit rc
      }'
  arc=${PIPESTATUS[2]}
  # awk prints NO-DATA and exits 0 when the stream is empty — an honest "nothing to measure", never a
  # faked BALANCED (a default indistinguishable from a success will be one).
  exit "${arc:-1}"
fi

# --- --status ----------------------------------------------------------------
if [ "${1:-}" = --status ]; then
  [ -r "$STATE" ] && cat "$STATE" || echo "mesh-journal-watch: no state yet"
  exit 0
fi

# --- --reset -----------------------------------------------------------------
if [ "${1:-}" = --reset ]; then
  rm -f "$CURSOR" "$SEEN"
  echo "mesh-journal-watch: reset (cursor + seen cleared; next pass re-seeds baseline-silent)"
  exit 0
fi

# --- --test ------------------------------------------------------------------
if [ "${1:-}" = --test ]; then
  command -v awk >/dev/null 2>&1 || { echo "smoke-test: FAIL (no awk)"; exit 1; }
  command -v sed >/dev/null 2>&1 || { echo "smoke-test: FAIL (no sed)"; exit 1; }
  # HONEST N/A gate: a non-systemd node is not-applicable, not blind.
  if ! have_journalctl; then
    echo "smoke-test: n/a (no journalctl on this node — not every node is systemd)"; exit 2
  fi
  jq --version >/dev/null 2>&1 || { echo "smoke-test: FAIL (jq required for the live path)"; exit 1; }
  # REAL-READ gate (verification principle): journalctl MUST produce -p err JSON with a MESSAGE field
  # right now, and cursor-file seeding MUST actually write a cursor. Not "[ -x journalctl ]".
  _rc="$(mktemp)"; rm -f "$_rc"
  journalctl -b 0 -p err -n 0 --cursor-file="$_rc" >/dev/null 2>&1
  [ -s "$_rc" ] || { rm -f "$_rc"; echo "smoke-test: FAIL (journalctl --cursor-file wrote no cursor — real read broken)"; exit 1; }
  journalctl -b 0 -p err -o json -n 1 2>/dev/null | jq -e '.MESSAGE? // ._COMM? // .SYSLOG_IDENTIFIER?' >/dev/null 2>&1 \
    || { rm -f "$_rc"; echo "smoke-test: FAIL (journalctl -o json produced no parseable entry)"; exit 1; }
  rm -f "$_rc"

  _td="$(mktemp -d)"
  _env="MESH_STATE_DIR=$_td MESH_JOURNAL_WATCH_CHAT=0 MESH_JOURNAL_WATCH_STDIN=1"
  feed(){ env $_env MESH_JOURNAL_WATCH_TAPE="$_td/tape.log" "$0" ; }   # records on stdin

  # (1) NEW signature alerts once + tapes it.
  out="$(printf 'kernel|||Bluetooth: hci0: Opcode 0x0401 failed: -16\n' | feed 2>&1)"; rc=$?
  { [ "$rc" = 0 ] && printf '%s' "$out" | grep -qF '[journal]' && printf '%s' "$out" | grep -qF 'Bluetooth' \
      && grep -qF 'Bluetooth' "$_td/tape.log"; } \
    || { rm -rf "$_td"; echo "smoke-test: FAIL (new signature must alert + tape: rc=$rc out='$out')"; exit 1; }

  # (2) DEDUP: the SAME signature (volatile tokens differ) is silent on the next pass — 0x0401 vs 0x2005
  #     both normalize to 'Opcode 0xN failed: -N', so a distinct opcode does NOT re-alert.
  tb="$(wc -l < "$_td/tape.log")"
  out="$(printf 'kernel|||Bluetooth: hci0: Opcode 0x2005 failed: -71\n' | feed 2>&1)"; rc=$?
  { [ "$rc" = 0 ] && ! printf '%s' "$out" | grep -qF '[journal]'; } \
    || { rm -rf "$_td"; echo "smoke-test: FAIL (a seen signature (normalized) must not re-alert: rc=$rc out='$out')"; exit 1; }

  # (3) EXCLUSION: the mesh-heavy-run OOM probe is dropped — never alerted, never taped. Keyed on the
  #     SIGNED comm the probe mints, not on the comm class or the victim's RSS.
  for _probe in mesh-capcheck mesh-caphog; do
    tb="$(wc -l < "$_td/tape.log")"
    out="$(printf 'kernel|||Memory cgroup out of memory: Killed process 500497 (%s) total-vm:149044kB, anon-rss:32512kB oom_score_adj:0\n' "$_probe" | feed 2>&1)"; rc=$?
    { [ "$rc" = 0 ] && ! printf '%s' "$out" | grep -qF "$_probe" \
        && [ "$(wc -l < "$_td/tape.log")" = "$tb" ] && ! grep -qF "$_probe" "$_td/tape.log"; } \
      || { rm -rf "$_td"; echo "smoke-test: FAIL (signed heavy-run OOM probe '$_probe' must be dropped entirely: rc=$rc out='$out')"; exit 1; }
  done

  # (3b) THE INVERSE, and it is the whole point of the task this fix closes: a REAL python cgroup OOM —
  #      same message text, same uid, same scope shape, differing ONLY in the comm — must SURFACE. The
  #      old `(python*` clause dropped this line, which is how the grind's real 2026-08-22T13:33:14Z
  #      cap-kill (anon-rss:2551900kB) went silent. RED-first: restore that clause and this goes red.
  out="$(printf 'kernel|||Memory cgroup out of memory: Killed process 3526528 (python) total-vm:7454496kB, anon-rss:2551900kB, file-rss:127360kB, shmem-rss:0kB, UID:1000 pgtables:5904kB oom_score_adj:0\n' | feed 2>&1)"; rc=$?
  { [ "$rc" = 0 ] && printf '%s' "$out" | grep -qF '[journal]' && printf '%s' "$out" | grep -qF '(python)'; } \
    || { rm -rf "$_td"; echo "smoke-test: FAIL (a REAL python cgroup OOM must NOT be dropped — only the signed probe comms are: rc=$rc out='$out')"; exit 1; }

  # (4) A REAL non-probe fault of a DIFFERENT shape still surfaces (exclusion is not over-broad).
  out="$(printf 'pipewire|||spa.alsa: '\''hw:0'\'': capture open failed: Device or resource busy\n' | feed 2>&1)"; rc=$?
  { [ "$rc" = 0 ] && printf '%s' "$out" | grep -qF '[journal]' && printf '%s' "$out" | grep -qiF 'capture open failed'; } \
    || { rm -rf "$_td"; echo "smoke-test: FAIL (a genuinely new non-probe fault must surface: rc=$rc out='$out')"; exit 1; }

  # (5) A GLOBAL oom (not cgroup) is NOT excluded — only the cgroup-python probe is.
  out="$(printf 'kernel|||Out of memory: Killed process 1234 (postgres) total-vm:8000000kB\n' | feed 2>&1)"; rc=$?
  { [ "$rc" = 0 ] && printf '%s' "$out" | grep -qiF 'postgres'; } \
    || { rm -rf "$_td"; echo "smoke-test: FAIL (a GLOBAL/non-python OOM must NOT be excluded: rc=$rc out='$out')"; exit 1; }

  # (6) BURST CAP: many new signatures in one pass collapse to one summary line, never N board lines.
  rm -rf "$_td"; _td="$(mktemp -d)"
  _env="MESH_STATE_DIR=$_td MESH_JOURNAL_WATCH_CHAT=0 MESH_JOURNAL_WATCH_STDIN=1 MESH_JOURNAL_WATCH_CAP=3"
  feed(){ env $_env MESH_JOURNAL_WATCH_TAPE="$_td/tape.log" "$0" ; }
  out="$(printf 'a|||fault alpha %s\nb|||fault bravo\nc|||fault charlie\nd|||fault delta\ne|||fault echo\n' x | feed 2>&1)"; rc=$?
  { [ "$rc" = 0 ] && printf '%s' "$out" | grep -qiE 'journal-storm|[0-9]+ new fault' \
      && [ "$(printf '%s' "$out" | grep -cF '[journal]')" -le 1 ]; } \
    || { rm -rf "$_td"; echo "smoke-test: FAIL (burst beyond CAP must collapse to one summary line: rc=$rc out='$out')"; exit 1; }

  # --- COGNITIVE SCOPE (--scope) -------------------------------------------------------------------
  # RED-first: every branch below was verified to go RED under a targeted mutation of the --scope block
  # (drop the degenerate check / drop the recurrence term r[s]>=2 / drop the idcap ceiling / drop the
  # singleton rule / let NO-DATA fall through to BALANCED) before being accepted. See the review artifact.
  rm -rf "$_td"; _td="$(mktemp -d)"
  sfeed(){ env MESH_STATE_DIR="$_td" MESH_JOURNAL_WATCH_STDIN=1 MESH_JOURNAL_WATCH_CHAT=0 \
                MESH_JOURNAL_WATCH_TAPE="$_td/tape.log" "$0" --scope 2>&1; }

  # (7) REAL READ, not a fixture: --scope over the LIVE current-boot stream must produce a verdict line
  #     and one of the three defined exit codes. A posture read that only ever sees fixtures asserts
  #     nothing about this node (a wrapper's test must exercise the thing it wraps).
  out="$(env MESH_STATE_DIR="$_td" "$0" --scope 2>&1)"; rc=$?
  { [ "$rc" = 0 ] || [ "$rc" = 3 ] || [ "$rc" = 4 ]; } \
    || { rm -rf "$_td"; echo "smoke-test: FAIL (--scope live read: rc=$rc not in 0/3/4, out='$out')"; exit 1; }
  printf '%s' "$out" | grep -qE '^(NO-DATA|scope: (BALANCED|OVER-COMPRESSED|OVER-PARTICULARIZED))' \
    || printf '%s' "$out" | grep -qE 'scope: |NO-DATA' \
    || { rm -rf "$_td"; echo "smoke-test: FAIL (--scope live read produced no verdict: out='$out')"; exit 1; }

  # (8) NO STATE CHANGE: a posture read must not forge cursor/seen/tape/state (a test that writes the
  #     artifact a watchdog reads for liveness forges the evidence it exists to check).
  [ -z "$(ls -A "$_td" 2>/dev/null)" ] \
    || { echo "smoke-test: FAIL (--scope wrote state into a fresh dir: $(ls -A "$_td" | tr '\n' ' '))"; rm -rf "$_td"; exit 1; }

  # (9) OVER-COMPRESSED / DEGENERATE: a signature body with no alphabetic content absorbs anything.
  out="$(printf 'kernel|||\nkernel|||fault alpha\nkernel|||fault alpha\n' | sfeed)"; rc=$?
  { [ "$rc" = 3 ] && printf '%s' "$out" | grep -qF 'DEGENERATE' && printf '%s' "$out" | grep -qF 'OVER-COMPRESSED'; } \
    || { rm -rf "$_td"; echo "smoke-test: FAIL (empty-body signature must read OVER-COMPRESSED rc3: rc=$rc out='$out')"; exit 1; }

  # (10) OVER-COMPRESSED / IDENTITY-FOLD: hw:0 and hw:1 are two DEVICES, not a counter — same signature,
  #      both recurring, so only the first ever alerted.
  out="$(printf "pipewire|||spa.alsa: 'hw:0': capture open failed\npipewire|||spa.alsa: 'hw:0': capture open failed\npipewire|||spa.alsa: 'hw:1': capture open failed\npipewire|||spa.alsa: 'hw:1': capture open failed\nkernel|||alpha beta\nkernel|||alpha beta\n" | sfeed)"; rc=$?
  { [ "$rc" = 3 ] && printf '%s' "$out" | grep -qF 'IDENTITY-FOLD'; } \
    || { rm -rf "$_td"; echo "smoke-test: FAIL (a recurring 2-value fold must read IDENTITY-FOLD rc3: rc=$rc out='$out')"; exit 1; }

  # (11a) FALSIFIER for the RECURRENCE term — small distinct set (2 <= idcap) but NOTHING revisited:
  #       a slot walking forward is a counter, not an identity, so it must stay BALANCED. Drop r[s]>=2
  #       and this goes RED. Same signature count as (10); only the recurrence structure differs.
  out="$(printf "pipewire|||spa.alsa: 'hw:1': capture open failed\npipewire|||spa.alsa: 'hw:2': capture open failed\nkernel|||alpha beta\nkernel|||alpha beta\n" | sfeed)"; rc=$?
  { [ "$rc" = 0 ] && printf '%s' "$out" | grep -qF 'BALANCED' && ! printf '%s' "$out" | grep -qF 'IDENTITY-FOLD'; } \
    || { rm -rf "$_td"; echo "smoke-test: FAIL (a non-recurring 2-value fold is a counter, must stay BALANCED rc0: rc=$rc out='$out')"; exit 1; }

  # (11b) FALSIFIER for the IDCAP ceiling — every value recurs, but the set is LARGE (6 > idcap 4):
  #       an unbounded-but-revisited slot is still a counter/rotation, not an enumerable identity, so it
  #       must stay BALANCED. Drop d[s]<=idcap and this goes RED. Together with (11a) each guard of the
  #       discriminator is asserted ALONE — a single combined falsifier let either one be deleted.
  out="$(for i in 1 2 3 4 5 6; do printf "pipewire|||spa.alsa: 'hw:%d': capture open failed\npipewire|||spa.alsa: 'hw:%d': capture open failed\n" "$i" "$i"; done; printf 'kernel|||alpha beta\nkernel|||alpha beta\n')"
  out="$(printf '%s\n' "$out" | sfeed)"; rc=$?
  { [ "$rc" = 0 ] && printf '%s' "$out" | grep -qF 'BALANCED' && ! printf '%s' "$out" | grep -qF 'IDENTITY-FOLD'; } \
    || { rm -rf "$_td"; echo "smoke-test: FAIL (a large recurring fold is a rotation, must stay BALANCED rc0: rc=$rc out='$out')"; exit 1; }

  # (12) OVER-PARTICULARIZED: >=MINSIG signatures, every one a singleton — the alphabet never converges.
  out="$(for w in alpha bravo charlie delta echo foxtrot golf hotel india juliet; do printf 'kernel|||fault %s here\n' "$w"; done | sfeed)"; rc=$?
  { [ "$rc" = 4 ] && printf '%s' "$out" | grep -qF 'OVER-PARTICULARIZED'; } \
    || { rm -rf "$_td"; echo "smoke-test: FAIL (all-singleton alphabet must read OVER-PARTICULARIZED rc4: rc=$rc out='$out')"; exit 1; }

  # (13) The singleton rule must need BOTH a converged-enough sample AND the rate — 3 singleton sigs is
  #      not evidence of anything (below MINSIG), so it must NOT read OVER-PARTICULARIZED.
  out="$(printf 'kernel|||fault alpha\nkernel|||fault bravo\nkernel|||fault charlie\n' | sfeed)"; rc=$?
  { [ "$rc" = 0 ] && ! printf '%s' "$out" | grep -qF 'OVER-PARTICULARIZED'; } \
    || { rm -rf "$_td"; echo "smoke-test: FAIL (below MINSIG must not read OVER-PARTICULARIZED: rc=$rc out='$out')"; exit 1; }

  # (14) NO-DATA is not BALANCED. An empty stream has nothing to measure and must say so — a default
  #      indistinguishable from a success will be one.
  out="$(printf '' | sfeed)"; rc=$?
  { [ "$rc" = 0 ] && printf '%s' "$out" | grep -qF 'NO-DATA' && ! printf '%s' "$out" | grep -qF 'BALANCED'; } \
    || { rm -rf "$_td"; echo "smoke-test: FAIL (empty stream must read NO-DATA, never BALANCED: rc=$rc out='$out')"; exit 1; }

  # (15) The OOM-probe exclusion applies to --scope too — otherwise the probe's 220 lines/boot would
  #      dominate the compression ratio the posture is computed from.
  out="$(printf 'kernel|||Memory cgroup out of memory: Killed process 500497 (mesh-capcheck) total-vm:149044kB\n' | sfeed)"; rc=$?
  { [ "$rc" = 0 ] && printf '%s' "$out" | grep -qF 'NO-DATA'; } \
    || { rm -rf "$_td"; echo "smoke-test: FAIL (--scope must apply the heavy-run OOM exclusion: rc=$rc out='$out')"; exit 1; }

  # (16) UUID FOLD, ON THE REAL MESSAGES THAT FAILED: the five live `tmux-spawn-<uuid>.scope` failures
  #      (board 2026-08-28 19:25:04Z/22:15:03Z/22:25:04Z/22:25:05Z + the tape) are ONE fault and must be
  #      ONE signature — the first alerts, the other four are silent. RED-first: delete the UUID rule from
  #      normalize() and this goes red with 5 signatures (measured: sort -u gave 5 before the fix).
  rm -rf "$_td"; _td="$(mktemp -d)"
  _env="MESH_STATE_DIR=$_td MESH_JOURNAL_WATCH_CHAT=0 MESH_JOURNAL_WATCH_STDIN=1"
  feed(){ env $_env MESH_JOURNAL_WATCH_TAPE="$_td/tape.log" "$0" ; }
  _uu="70ce0115-c306-49bf-97b5-782b4e4eb7f5 bca6addf-e59b-430c-a9ba-217c9d2a6674 c777ff3e-e8cd-421b-9ad2-521d45d86368 ec904f7e-bf87-4adf-ad77-5bd7f84f92d3 eed134cb-dc91-4c7e-a8c5-c84ccd7d6d68"
  _first=1; _alerts=0
  for _u in $_uu; do
    out="$(printf 'systemd|||Failed to start tmux-spawn-%s.scope - tmux child pane 1660738 launched by process 1660666.\n' "$_u" | feed 2>&1)"; rc=$?
    [ "$rc" = 0 ] || { rm -rf "$_td"; echo "smoke-test: FAIL (uuid fold pass rc=$rc out='$out')"; exit 1; }
    printf '%s' "$out" | grep -qF '[journal]' && _alerts=$((_alerts+1))
    if [ "$_first" = 1 ]; then
      printf '%s' "$out" | grep -qF '[journal]' \
        || { rm -rf "$_td"; echo "smoke-test: FAIL (the FIRST tmux-spawn scope fault must alert: out='$out')"; exit 1; }
      _first=0
    fi
  done
  [ "$_alerts" = 1 ] \
    || { rm -rf "$_td"; echo "smoke-test: FAIL (5 tmux-spawn UUIDs are ONE fault and must alert ONCE, got $_alerts alerts — a UUID's middle 4-char groups are leaking a per-id residue)"; exit 1; }
  [ "$(wc -l < "$_td/tape.log")" = 5 ] \
    || { rm -rf "$_td"; echo "smoke-test: FAIL (all 5 passes must still TAPE — folding is for the alert, not for the forensics)"; exit 1; }

  # (17) THE FALSIFIER FOR (16) — the UUID rule must fold the ID, NOT the unit around it. A different UNIT
  #      is a different fault and must stay a different signature. The message is byte-identical to (16)
  #      except `tmux-spawn` -> `session`, so ONLY the signature can decide: if the rule eats the unit
  #      token too, this collapses onto the seen signature and goes silent. Asserting an ALERT here, never
  #      that the word survives in the printed output — the board line prints the RAW sample, which
  #      survives any normalizer at all, so grepping it would pass under every mutation (measured: the
  #      widen-the-rule mutant passed that form GREEN).
  out="$(printf 'systemd|||Failed to start session-70ce0115-c306-49bf-97b5-782b4e4eb7f5.scope - tmux child pane 1660738 launched by process 1660666.\n' | feed 2>&1)"; rc=$?
  { [ "$rc" = 0 ] && printf '%s' "$out" | grep -qF '[journal]'; } \
    || { rm -rf "$_td"; echo "smoke-test: FAIL (a DIFFERENT unit carrying a uuid must stay a distinct signature and alert: rc=$rc out='$out')"; exit 1; }

  # (18) FAMILY-STORM: one skeleton minting a fresh signature every time, BESIDE a healthy repeating
  #      alphabet. The five ids are 6-char hex — BELOW the {8,} floor, so normalize() leaves `unit-aNbNcN`
  #      as a per-event residue and each mints its own signature. This is the general class the UUID
  #      belonged to; folding the UUID shape does not close it, which is why the detector is the fix and
  #      not just the regex. The GLOBAL rate here is 5/8 = 0.62, far below SFLOOR 0.90, so this can ONLY
  #      be caught by the per-family arm — which is the whole defect: the live UUID storm was 5 signatures
  #      wide beside ~26 healthy ones and one global rate could never move. RED-first: delete the family
  #      loop or the `|| fpart` in the verdict and this goes red with BALANCED rc0.
  rm -rf "$_td"; _td="$(mktemp -d)"
  sfeed(){ env MESH_STATE_DIR="$_td" MESH_JOURNAL_WATCH_STDIN=1 MESH_JOURNAL_WATCH_CHAT=0 \
                MESH_JOURNAL_WATCH_TAPE="$_td/tape.log" "$0" --scope 2>&1; }
  _hex="a1b2c3 1d2e3f ab12cd 12ab34 a1bc23"
  out="$( { for _h in $_hex; do printf 'systemd|||Failed to start unit-%s.scope - a unit.\n' "$_h"; done
            printf 'kernel|||aaa bbb ccc\nkernel|||aaa bbb ccc\nkernel|||ddd eee fff\nkernel|||ddd eee fff\nkernel|||ggg hhh iii\nkernel|||ggg hhh iii\n'; } | sfeed )"; rc=$?
  { [ "$rc" = 4 ] && printf '%s' "$out" | grep -qF 'FAMILY-STORM' && printf '%s' "$out" | grep -qF 'OVER-PARTICULARIZED'; } \
    || { rm -rf "$_td"; echo "smoke-test: FAIL (one storming skeleton beside a healthy alphabet must read OVER-PARTICULARIZED rc4 via the family arm: rc=$rc out='$out')"; exit 1; }
  #      ... and the GLOBAL arm must have DECLINED, else this proves nothing about the family arm.
  printf '%s' "$out" | grep -qE 'signatures=8 .*singleton-rate=0\.6' \
    || { rm -rf "$_td"; echo "smoke-test: FAIL ((18) must be caught with the global rate below SFLOOR over >=MINSIG signatures: out='$out')"; exit 1; }
  printf '%s' "$out" | grep -qF 'storming famil' && ! printf '%s' "$out" | grep -qF 'global singleton-rate' \
    || { rm -rf "$_td"; echo "smoke-test: FAIL (the verdict must NAME the family arm as the one that fired, and not the global one: out='$out')"; exit 1; }

  # (18b) THE CATCH-ALL FALSIFIER, measured against the live journal before it was a test: every
  #       `rtw_8822bu 1-3:1.0: <different fault>` line is all-variable at the front, and a leading-prefix
  #       family rule swept seven genuinely DIFFERENT driver faults into one bucket and called it a storm.
  #       Seven distinct faults deserve seven signatures. Restore a prefix-based family key and this goes
  #       red with FAMILY-STORM on a bucket whose members share nothing.
  rm -rf "$_td"; _td="$(mktemp -d)"
  out="$(printf 'kernel|||rtw_8822bu 1-3:1.0: leave idle state failed\nkernel|||rtw_8822bu 1-3:1.0: h2c queue mismatch\nkernel|||rtw_8822bu 1-3:1.0: failed to send h2c command\nkernel|||rtw_8822bu 1-3:1.0: failed to leave ips state\nkernel|||rtw_8822bu 1-3:1.0: failed to configure mac\n' | sfeed)"; rc=$?
  ! printf '%s' "$out" | grep -qF 'FAMILY-STORM' \
    || { rm -rf "$_td"; echo "smoke-test: FAIL (five DIFFERENT driver faults sharing only a variable prefix are not a family: rc=$rc out='$out')"; exit 1; }

  # (18c) FALSIFIER FOR THE SKELETON vs A PREFIX — these five share the digit-free leading run `rtw driver`
  #       but are five DIFFERENT faults, and their skeletons differ. A leading-prefix family key sweeps all
  #       five into one bucket and calls it a storm; the skeleton gives five families of one. Replace the
  #       `continue` in famkey() with a `break` (i.e. go back to a prefix) and this goes RED. (18b) alone
  #       could NOT see that mutation — its messages have no digit-free leading word at all, so they land
  #       in the all-variable bucket and the exclusion below masks the prefix rule. Each guard alone, or
  #       the pair silently covers for each other (measured: both mutants passed a combined fixture GREEN).
  rm -rf "$_td"; _td="$(mktemp -d)"
  out="$(printf 'kernel|||rtw driver 1-3: leave idle state failed\nkernel|||rtw driver 1-3: h2c queue mismatch\nkernel|||rtw driver 1-3: failed to send h2c command\nkernel|||rtw driver 1-3: failed to leave ips state\nkernel|||rtw driver 1-3: failed to configure mac\n' | sfeed)"; rc=$?
  { [ "$rc" = 0 ] && ! printf '%s' "$out" | grep -qF 'FAMILY-STORM'; } \
    || { rm -rf "$_td"; echo "smoke-test: FAIL (five different faults sharing only a leading PREFIX are not a family — the key must be the skeleton: rc=$rc out='$out')"; exit 1; }

  # (18d) FALSIFIER FOR THE ALL-VARIABLE EXCLUSION — every token here carries a value, so these four share
  #       no fixed text at all and the bucket that holds them is a catch-all, not a family. Drop the
  #       `<all-variable>` exclusion and this goes RED with a storm over messages that have nothing in
  #       common. (18b) could not see that mutation either: under the correct skeleton its messages are
  #       NOT all-variable, so the bucket it would have to fill is empty.
  rm -rf "$_td"; _td="$(mktemp -d)"
  out="$(printf 'kernel|||1-1: 2a3\nkernel|||1-2: 2b3\nkernel|||1-3: 2c3\nkernel|||1-4: 2d3\n' | sfeed)"; rc=$?
  { [ "$rc" = 0 ] && ! printf '%s' "$out" | grep -qF 'FAMILY-STORM'; } \
    || { rm -rf "$_td"; echo "smoke-test: FAIL (an all-variable bucket is a catch-all, never a family: rc=$rc out='$out')"; exit 1; }

  # (19) FALSIFIER for the per-family MINIMUM — 3 signatures in a skeleton is not evidence of anything;
  #      the same reasoning (13) applies to the global rate. Drop `fs[f] >= fminsig` and this goes red,
  #      and every 1-signature family (100% singleton by construction) would trip the arm forever.
  rm -rf "$_td"; _td="$(mktemp -d)"
  out="$( { for _h in a1b2c3 1d2e3f ab12cd; do printf 'systemd|||Failed to start unit-%s.scope - a unit.\n' "$_h"; done
            printf 'kernel|||aaa bbb ccc\nkernel|||aaa bbb ccc\nkernel|||ddd eee fff\nkernel|||ddd eee fff\n'; } | sfeed )"; rc=$?
  { [ "$rc" = 0 ] && printf '%s' "$out" | grep -qF 'BALANCED' && ! printf '%s' "$out" | grep -qF 'FAMILY-STORM'; } \
    || { rm -rf "$_td"; echo "smoke-test: FAIL (a family below FMINSIG must not trip the storm arm: rc=$rc out='$out')"; exit 1; }

  rm -rf "$_td"
  echo "smoke-test: ok (real journalctl -p err/cursor read + new-sig/dedup/oom-exclusion/global-oom-kept/burst-cap fixtures + --scope live read/no-state/both-poles/counter-falsifier/no-data + uuid-unit-fold/unit-falsifier/family-storm/catch-all+prefix+all-variable-falsifiers/family-minimum)"; exit 0
fi

# --- default: one delta pass -------------------------------------------------
if [ "${MESH_JOURNAL_WATCH_STDIN:-0}" != 1 ]; then
  have_journalctl || { printf 'N/A %s\n' "$(date -u +%FT%TZ)" > "$STATE"; echo "mesh-journal-watch: n/a (no journalctl)"; exit 2; }
  jq --version >/dev/null 2>&1 || { echo "mesh-journal-watch: FAIL (jq required)"; exit 1; }
  # BASELINE-SILENT first run: seed the cursor at the current tail, surface nothing (replay-trap guard).
  if [ ! -f "$CURSOR" ]; then
    journalctl -p err -n 0 --cursor-file="$CURSOR" >/dev/null 2>&1
    printf 'SEEDED %s\n' "$(date -u +%FT%TZ)" > "$STATE"
    command -v mesh-state-touch >/dev/null 2>&1 && mesh-state-touch "$STATE" >/dev/null 2>&1 || true
    echo "mesh-journal-watch: seeded baseline cursor (silent first run)"; exit 0
  fi
fi

ts="$(date -u +%FT%TZ)"
declare -A cnt sample
total=0
while IFS= read -r rec; do
  [ -n "$rec" ] || continue
  ident="${rec%%|||*}"; msg="${rec#*|||}"
  is_heavy_run_oom "$msg" && continue
  norm="$(printf '%s' "$msg" | normalize)"
  sig="$ident|||$norm"
  [ -n "${cnt[$sig]:-}" ] || sample["$sig"]="$ident: $msg"
  cnt["$sig"]=$(( ${cnt[$sig]:-0} + 1 ))
  total=$((total+1))
done < <(delta_records)

new_sigs=()
for sig in "${!cnt[@]}"; do
  is_new=no
  if ! { [ -f "$SEEN" ] && grep -Fxq "$sig" "$SEEN" 2>/dev/null; }; then
    is_new=yes; new_sigs+=("$sig"); printf '%s\n' "$sig" >> "$SEEN"
  fi
  printf '%s count=%s new=%s sample=%s\n' "$ts" "${cnt[$sig]}" "$is_new" "${sample[$sig]}" >> "$TAPE"
done

ncount="${#new_sigs[@]}"
host="$(hostname)"
if [ "$ncount" -gt 0 ]; then
  if [ "$ncount" -le "$CAP" ]; then
    for sig in "${new_sigs[@]}"; do
      s="${sample[$sig]}"; c="${cnt[$sig]}"
      echo "[journal] NEW fault: $s (×$c this pass) — tape ~/.mesh/journal-watch.log"
      if [ "$CHAT" = 1 ] && command -v mesh-chat >/dev/null 2>&1; then
        MESH_WHO="journal-watch@$host" mesh-chat "[fyi] mesh-journal-watch: $host — NEW -p err fault signature: $s (×$c this pass). Live current-boot fault (journalctl -p err), not seen before; tape ~/.mesh/journal-watch.log, all with 'mesh-journal-watch --once'." >/dev/null 2>&1 || true
      fi
    done
  else
    summary="$(for sig in "${new_sigs[@]}"; do printf '%s(×%s) ' "$(printf '%s' "${sample[$sig]}" | cut -c1-40)" "${cnt[$sig]}"; done)"
    echo "[journal] journal-storm: $ncount new fault signatures this pass — $summary"
    if [ "$CHAT" = 1 ] && command -v mesh-chat >/dev/null 2>&1; then
      MESH_WHO="journal-watch@$host" mesh-chat "[fyi] mesh-journal-watch: $host — $ncount new -p err fault signatures this pass (over cap $CAP): $summary. Read them with 'mesh-journal-watch --once'." >/dev/null 2>&1 || true
    fi
  fi
fi

status="$([ "$ncount" -gt 0 ] && echo FAULT || echo QUIET)"
[ "$SEEK_RESEED" = 1 ] && status="RESEED"
printf '%s new=%s seen=%s scanned=%s %s\n' "$status" "$ncount" "$([ -f "$SEEN" ] && wc -l < "$SEEN" || echo 0)" "$total" "$ts" > "$STATE"
command -v mesh-state-touch >/dev/null 2>&1 && mesh-state-touch "$STATE" >/dev/null 2>&1 || true
if [ "$ncount" -gt 0 ]; then
  echo "mesh-journal-watch: $ncount new fault signature(s) surfaced this pass (scanned $total)"
else
  echo "mesh-journal-watch: QUIET (no new fault signatures; scanned $total)"
fi
exit 0
