#!/usr/bin/env bash
# mesh-handoff — pre-/clear work-memory handoff so a mind's thread survives a /clear (or /compact, or reboot
# reincarnation). A mind that /clears loses its in-context thread: end-of-session doctrine says "never leave
# the window blank", but a bare /clear still drops the UNCOMMITTED work-state (what was half-done, what's next,
# which paths) — and neither the chat board nor the data pane reliably retains it. This closes the loop:
#   PRE-CLEAR  (a mind writes):  mesh-handoff <window> "<what done> + <next> + <key paths>"
#   POST-CLEAR (the hook reads): mesh-handoff --restore   → cats the window's handoff into SessionStart context
# so a freshly-cleared session wakes already holding its own thread.
# orphan-ok: on-demand (a mind runs it pre-/clear) + SessionStart-hook glue (~/.claude/settings.json) — not a cron reflex.
#
#   mesh-handoff <window> "<state>"   write ~/.mesh/handoff/<window>.md (overwrite) + post one [handoff] line to chat.log
#   mesh-handoff --restore            resolve THIS pane's window (tmux) → emit its handoff as SessionStart additionalContext
#   mesh-handoff --show [<window>]    print the stored handoff (this window if omitted) to stdout
#   mesh-handoff --snapshot [<win>]   (reflex) auto-derive a TERSE, capped handoff from pane scrollback + git/wip summary
#                                     — cooperation-free crash safety net; no window = all mind windows
#   mesh-handoff --test               round-trip smoke test (manual round-trip + snapshot: no-clobber, cap, clear-coupling)
#
# reflex-cadence: */5 * * * *
# reflex-args: --snapshot
#
# Concrete trigger (2026-07-18): the models mind /cleared mid fine-tune and lost its loss log + the fact that
# eval_heldout/eval_real already existed — re-derived from scratch. A [handoff] would have carried it across.
#
# TWO tiers of handoff (crash-proof-recovery §P2):
#   MANUAL   — a mind writes it pre-/clear (`# source: manual`); RICH; the whole truth. Posts a [handoff] board line.
#   SNAPSHOT — the reflex auto-derives it (`# source: auto-snapshot`) from the pane scrollback on a cadence, so a
#              CRASH (OOM/kill-9/engine death) that never wrote a manual handoff still restores a ≤cadence-old thread.
# The snapshot is EXTRACTIVE + HARD-CAPPED (operator: "no death NOR bloat") — it copies verbatim signal lines,
# never invents a next-step, and truncates to MESH_HANDOFF_SNAPSHOT_CAP chars so --restore can't re-bloat the fresh
# session it feeds. It NEVER clobbers a still-FRESH manual handoff (that tier is richer). THIS SNAPSHOT IS WHAT
# MAKES A /clear SAFE (2026-07-24): mesh-clear no longer judges a handoff with a model — it calls
# `mesh-handoff --snapshot` to WRITE one and then clears, so the guarantee is this deterministic extraction plus
# the refs/wip commit beside it, not a classifier's opinion. The --test asserts that coupling.
#
# The per-window file is the DURABLE tier (survives /clear; stale-on-reboot is fine — reboot is clean
# reincarnation). The [handoff] chat line is the VOLATILE board tier (one line, like [fyi]) so other minds and
# the operator see a handoff happened. Same split as card (durable) vs trace (volatile).
# orphan-ok: --snapshot self-wires via reflex-cadence; manual write/--restore/--show are on-demand + SessionStart glue.
set -uo pipefail

MESH_DIR="${MESH_DIR:-$HOME/.mesh}"
HANDOFF_DIR="${MESH_HANDOFF_DIR:-$MESH_DIR/handoff}"
SESSION="${MESH_HANDOFF_SESSION:-$(hostname)}"
SNAP_CAP="${MESH_HANDOFF_SNAPSHOT_CAP:-1400}"            # hard char cap on a snapshot body (anti-bloat)
SNAP_LINES="${MESH_HANDOFF_SNAPSHOT_LINES:-12}"          # verbatim signal lines kept from scrollback
SNAP_SCROLL="${MESH_HANDOFF_SNAPSHOT_SCROLL:-160}"       # scrollback lines read from the pane
KEEP_MANUAL_SECS="${MESH_HANDOFF_KEEP_MANUAL_SECS:-900}" # a manual handoff younger than this is NOT clobbered

# Resolve the window this process runs in from the tmux pane (same read mesh-chat uses: #W = window name).
# Override for tests via MESH_HANDOFF_TEST_WINDOW. Empty when not in tmux (nothing to restore).
_this_window() {
  [ -n "${MESH_HANDOFF_TEST_WINDOW:-}" ] && { printf '%s' "$MESH_HANDOFF_TEST_WINDOW"; return; }
  [ -n "${TMUX_PANE:-}" ] || return 0
  tmux display-message -p -t "$TMUX_PANE" '#W' 2>/dev/null || true
}

# Sanitize a window name to a safe filename component (no path traversal / spaces).
_safe_win() { printf '%s' "$1" | tr -c 'A-Za-z0-9._-' '_'; }

_handoff_file() { printf '%s/%s.md' "$HANDOFF_DIR" "$(_safe_win "$1")"; }

_write_handoff() { # $1=window  $2=state-text
  local win="$1" state="$2" f
  mkdir -p "$HANDOFF_DIR"
  f="$(_handoff_file "$win")"
  # Durable per-window file: a real header (window + UTC stamp) then the full state verbatim. Overwrite —
  # the latest handoff is the whole truth; history lives in the chat.log [handoff] trail.
  {
    printf '# handoff: %s\n' "$win"
    printf '# written: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    printf '# source: manual\n'
    printf '# (pre-/clear work-memory — restored into SessionStart context by mesh-handoff --restore)\n\n'
    printf '%s\n' "$state"
  } > "$f"
  # Volatile board line — reuse mesh-chat so it gets WHO-resolution + log-scrub + the same format as every
  # other marker. One line only; the full state lives in the file. Degrade to a raw append if mesh-chat absent.
  local oneline
  oneline="$(printf '%s' "$state" | tr '\n' ' ' | cut -c1-240)"
  if command -v mesh-chat >/dev/null 2>&1; then
    mesh-chat "[handoff] $win: $oneline (full state → $f)" >/dev/null 2>&1 || true
  else
    printf '%s  handoff@%s  ::  [handoff] %s: %s (full state → %s)\n' \
      "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$(hostname)" "$win" "$oneline" "$f" >> "$MESH_DIR/chat.log" 2>/dev/null || true
  fi
  printf '%s\n' "$f"
}

# ── P2: continuous, cooperation-free SNAPSHOT handoff ────────────────────────────────────────────
# Read a window's mind-pane scrollback (bottom pane, same convention as mesh-clear/mesh-tell). Override
# for tests with MESH_HANDOFF_SNAPSHOT_SCROLL_CMD (stdin-less; echoes canned scrollback).
_read_scroll() { # $1=window → scrollback text (empty if unreachable)
  [ -n "${MESH_HANDOFF_SNAPSHOT_SCROLL_CMD:-}" ] && { $MESH_HANDOFF_SNAPSHOT_SCROLL_CMD; return; }
  local win="$1" idx pane
  tmux has-session -t "$SESSION" 2>/dev/null || return 0
  idx="$(tmux list-panes -t "$SESSION:$win" -F '#{pane_top} #{pane_index}' 2>/dev/null | sort -n | tail -1 | awk '{print $2}')"
  [ -n "$idx" ] || return 0
  tmux capture-pane -t "$SESSION:$win.$idx" -p -S "-$SNAP_SCROLL" 2>/dev/null || true
}

# Extractive, MODEL-FREE, verbatim: keep only the last N "signal" lines (paths/commands/markers) from the
# scrollback. Copies real tokens; invents NOTHING (no next-step). Deterministic — right for a */5×15-window
# reflex (a model call per window would thrash the GPU the senses need). Deliberately crude: this is a SAFETY NET
# under the manual tier — and since the clear-gate's model was removed (2026-07-24) it is the mesh's ONE
# extractive-handoff path, shared by mesh-clear (writer) and mesh-clear-loss (canary) via MESH_HANDOFF_LIB_ONLY.
_extract_terse() { # stdin=scrollback → terse verbatim body
  # SIGNAL first, then strip the SHELL-FURNITURE that the signal grep also matches: the statusline
  # (unique glyph ⧉), the multi-line-prompt decoration (quadrant/block glyphs at line start), and the
  # session-lifecycle slash commands (/clear, /compact) — which are NOT work-state. Without this, a pane
  # captured right AFTER /clear (visible scrollback = just prompt+statusline) yields those three noise
  # lines as the entire "work-state" and clobbers a richer handoff (the /clear-clobber bug, 2026-07-18).
  grep -aE '(/|mesh-|git |\[done\]|\[task\]|\[handoff\]|\[fyi\]|\.md|\.sh|refs/|scripts/|commit|error|FAIL)' 2>/dev/null \
    | grep -avE '⧉|^[[:space:]]*[▘▝▖▗▄▀░▒▓█▌▐]|(^|❯[[:space:]]+)/(clear|compact)([[:space:]]|$)' \
    | grep -avE '^[[:space:]]*$' \
    | tail -n "$SNAP_LINES"
}

# Resolve a window's worktree from its pane cwds (same read as mesh-wip-commit) — NOT the reflex's own
# cwd, which under cron is $HOME (not a repo). Empty if the window isn't in a git worktree / no tmux.
_window_worktree() { # $1=window → toplevel path (empty if none)
  local win="$1" p top
  tmux has-session -t "$SESSION" 2>/dev/null || return 0
  while read -r p; do
    [ -n "$p" ] || continue
    top="$(git -C "$p" rev-parse --show-toplevel 2>/dev/null)" || continue
    [ -n "$top" ] && { printf '%s' "$top"; return 0; }
  done < <(tmux list-panes -t "$SESSION:$win" -F '#{pane_current_path}' 2>/dev/null)
  return 0
}

# One-line git dirty + refs/wip summary — names the P1 snapshot ref so a reincarnated mind finds its
# uncommitted work (mesh-wip-commit --restore <win>). Placed FIRST in the body so the anti-bloat cap
# (which truncates the tail) can never drop this recovery pointer. Best-effort; degrades if not a repo.
_git_wip_summary() { # $1=window  $2=toplevel (may be empty)
  local win="$1" top="$2" n short landed=""
  [ -n "$top" ] || { printf 'wip: (worktree n/a — snapshot is scrollback-only)'; return 0; }
  n="$(git -C "$top" status --porcelain 2>/dev/null | wc -l | tr -d ' ')"
  short="$(git -C "$top" rev-parse -q --short "refs/wip/$(_safe_win "$win")" 2>/dev/null || true)"
  # Clean tree + parked ref: ask the ref's owner tool whether the delta LANDED (mesh-wip-commit
  # --landed rc contract: 0=landed · 1=unlanded · else unknown). A landed ref makes the recover
  # instruction a STALE pointer (restoring work HEAD already carries fails); an UNLANDED ref on a
  # clean tree is LOST WORK — the one case where the pointer is urgent, so say so loudly. Tool
  # absent / rc unknown → fall through to the old conservative pointer line.
  if [ -n "$short" ] && [ "$n" = 0 ] && command -v mesh-wip-commit >/dev/null 2>&1; then
    (cd "$top" && mesh-wip-commit --landed "$win" >/dev/null 2>&1); landed=$?
  fi
  if [ -n "$short" ] && [ "$landed" = "0" ]; then
    printf 'wip: clean — refs/wip/%s @ %s already landed in HEAD (no recovery needed; prunes next wip cadence)' "$win" "$short"
  elif [ -n "$short" ] && [ "$landed" = "1" ]; then
    printf 'wip: tree CLEAN but refs/wip/%s @ %s holds UNLANDED work (lost from the tree?) — recover: mesh-wip-commit --restore %s' "$win" "$short" "$win"
  elif [ -n "$short" ]; then
    printf 'wip: %s dirty file(s); uncommitted work parked at refs/wip/%s @ %s — recover: mesh-wip-commit --restore %s' \
      "$n" "$win" "$short" "$win"
  else
    printf 'wip: %s dirty file(s) in %s (no refs/wip/%s yet — mesh-wip-commit not yet run this cadence)' "$n" "$top" "$win"
  fi
}

# Hard char cap — truncate at a UTF-8-safe boundary with an explicit marker so a fat scrollback can never
# re-bloat the session --restore feeds. This is the anti-bloat gate (operator: "no death NOR bloat").
_cap() { # $1=text $2=cap → capped text
  local t="$1" cap="$2"
  if [ "${#t}" -le "$cap" ]; then printf '%s' "$t"; return; fi
  printf '%s\n…[snapshot capped at %s chars — see the pane/refs/wip for the rest]' "${t:0:$cap}" "$cap"
}

_write_snapshot() { # $1=window $2=body — writes the auto tier ONLY (no board line: a */5 reflex must not flood chat)
  local win="$1" body="$2" f
  mkdir -p "$HANDOFF_DIR"; f="$(_handoff_file "$win")"
  {
    printf '# handoff: %s\n' "$win"
    printf '# written: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    printf '# source: auto-snapshot\n'
    printf '# (cooperation-free crash safety net — mesh-handoff --snapshot; restored by --restore)\n\n'
    printf '%s\n' "$body"
  } > "$f"
}

# Snapshot ONE window. rc 0=written, 4=kept-fresh-manual (skipped), 5=nothing to snapshot (no scrollback),
# 6=kept prior handoff (extract was hollow — just-cleared/furniture-only pane; never clobber with noise).
_snapshot_one() { # $1=window
  local win="$1" f src mtime age scroll extract summary body
  [ -n "$win" ] || return 5
  f="$(_handoff_file "$win")"
  # clobber-protection: a still-FRESH manual handoff is richer — never overwrite it.
  if [ -r "$f" ]; then
    src="$(sed -n 's/^# source: //p' "$f" | head -1)"
    mtime="$(stat -c %Y "$f" 2>/dev/null || echo 0)"; age=$(( $(date +%s) - mtime ))
    if [ "$src" = manual ] && [ "$age" -le "$KEEP_MANUAL_SECS" ]; then return 4; fi
  fi
  scroll="$(_read_scroll "$win")"
  [ -n "$scroll" ] || return 5                         # unreachable / empty pane → nothing to snapshot
  extract="$(printf '%s' "$scroll" | _extract_terse)"
  # HOLLOW-GUARD: after furniture-stripping, a just-cleared pane extracts to NOTHING. Writing a "no signal"
  # body would OVERWRITE a richer prior handoff (manual OR a good earlier auto-snapshot) — the exact damage
  # the operator hit: a */5 snapshot landed 1s after /clear and replaced real work-state with the /clear line.
  # If the extract is hollow AND a handoff already exists, PRESERVE it (rc 6) rather than clobber with noise.
  if [ -z "$extract" ] && [ -r "$f" ]; then return 6; fi
  summary="$(_git_wip_summary "$win" "$(_window_worktree "$win")")"
  # summary FIRST (short, deterministic, carries the recovery pointer → survives the cap); the verbatim
  # scrollback extract follows and is the cap-truncatable bulk.
  body="$(printf '%s\n\nwork-state (auto-extracted verbatim from the %s pane — may be partial, no invented next-step):\n%s' \
           "$summary" "$win" "${extract:-（no signal lines matched — see the pane）}")"
  body="$(_cap "$body" "$SNAP_CAP")"
  _write_snapshot "$win" "$body"
}

_snapshot() { # $1=window (optional). No window → every mind window (2-pane channels).
  local win="$1" rc n_w=0 n_k=0 n_s=0 n_h=0
  if [ -n "$win" ]; then
    _snapshot_one "$win"; rc=$?
    case "$rc" in 0) echo "snapshot: wrote auto handoff for '$win' → $(_handoff_file "$win")";;
                  4) echo "snapshot: kept fresh manual handoff for '$win' (not clobbered)";;
                  5) echo "snapshot: nothing to snapshot for '$win' (no scrollback)";;
                  6) echo "snapshot: kept prior handoff for '$win' (pane hollow — no signal to snapshot)";; esac
    return 0
  fi
  tmux has-session -t "$SESSION" 2>/dev/null || { echo "snapshot: no session '$SESSION'"; return 0; }
  while read -r win; do
    [ -n "$win" ] || continue
    _snapshot_one "$win"; rc=$?
    case "$rc" in 0) n_w=$((n_w+1));; 4) n_k=$((n_k+1));; 5) n_s=$((n_s+1));; 6) n_h=$((n_h+1));; esac
  done < <(tmux list-windows -t "$SESSION" -F '#{window_name} #{window_panes}' 2>/dev/null | awk '$2>=2{print $1}')
  echo "snapshot: $n_w written · $n_k manual-kept · $n_h hollow-kept · $n_s empty ($(date -u +%H:%M:%SZ))"
}

_restore() { # emit THIS window's handoff as SessionStart additionalContext (JSON). Silent no-op if none.
  local win f content
  win="$(_this_window)"
  [ -n "$win" ] || exit 0                     # not in tmux / unknown window → nothing to restore
  f="$(_handoff_file "$win")"
  [ -r "$f" ] || exit 0                       # no stored handoff for this window → nothing to restore
  content="$(cat "$f")"
  [ -n "$content" ] || exit 0
  # SessionStart hook contract: emit hookSpecificOutput.additionalContext. Build the JSON with python3 so
  # the file content (arbitrary markdown/newlines/quotes) is escaped correctly — never hand-roll JSON escaping.
  MESH_HANDOFF_CONTENT="$content" python3 - <<'PY'
import json, os
body = os.environ["MESH_HANDOFF_CONTENT"]
ctx = ("Work-memory handoff restored (mesh-handoff, pre-/clear). This is YOUR thread from before "
       "the /clear — resume from it:\n\n" + body)
print(json.dumps({"hookSpecificOutput": {"hookEventName": "SessionStart", "additionalContext": ctx}}))
PY
}

_test() {
  local td rc=0
  td="$(mktemp -d)" || { echo "handoff-test: FAIL (mktemp)"; exit 1; }
  # Isolate every artifact into the sandbox — never touch the real chat.log/handoff dir. NOTE: the
  # module-level globals (MESH_DIR/HANDOFF_DIR/SESSION) were bound at load, BEFORE this export — exporting
  # alone leaves the functions reading the REAL dirs. Reassign the globals too, or the test pollutes ~/.mesh.
  export MESH_DIR="$td/mesh" MESH_HANDOFF_DIR="$td/mesh/handoff"
  MESH_DIR="$td/mesh"; HANDOFF_DIR="$td/mesh/handoff"; SESSION="__no_such_session__"
  mkdir -p "$MESH_DIR" "$HANDOFF_DIR"
  local win="test-handoff-win"
  local marker="ROUNDTRIP-$$-do-not-see-this-in-two-places"
  local state="done: wired X ($marker)
next: run Y then land Z
paths: scripts/foo, ~/.mesh/bar.log"

  # 1) WRITE (pre-clear). Force the raw-append path (no mesh-chat in a sandbox PATH) so we assert THIS tool's
  #    own chat-line format, not mesh-chat's — a real round-trip, not a stub.
  local f
  f="$(PATH=/usr/bin:/bin MESH_HANDOFF_TEST_WINDOW="$win" _write_handoff "$win" "$state")"
  [ -f "$f" ] || { echo "handoff-test: FAIL (no durable file written)"; rc=1; }
  grep -q "$marker" "$f" 2>/dev/null || { echo "handoff-test: FAIL (durable file missing the state marker)"; rc=1; }
  # the file must carry the FULL multi-line state, not a truncated one-liner
  grep -q '^next: run Y then land Z$' "$f" 2>/dev/null || { echo "handoff-test: FAIL (durable file dropped a state line)"; rc=1; }

  # 2) the [handoff] BOARD line landed in chat.log, one line, carrying the marker
  local cl="$MESH_DIR/chat.log"
  grep -q '\[handoff\]' "$cl" 2>/dev/null || { echo "handoff-test: FAIL (no [handoff] board line in chat.log)"; rc=1; }
  grep '\[handoff\]' "$cl" 2>/dev/null | grep -q "$marker" || { echo "handoff-test: FAIL ([handoff] line missing the state marker)"; rc=1; }
  [ "$(grep -c '\[handoff\]' "$cl" 2>/dev/null)" = 1 ] || { echo "handoff-test: FAIL ([handoff] must be exactly one board line)"; rc=1; }

  # 3) SIMULATE CLEAR + RESTORE: a fresh process (no prior context) resolves the same window and the hook
  #    output must carry the SAME state — the marker AND every state line — inside additionalContext.
  local restored
  restored="$(MESH_HANDOFF_TEST_WINDOW="$win" _restore)"
  printf '%s' "$restored" | python3 -c 'import json,sys; d=json.load(sys.stdin); print(d["hookSpecificOutput"]["additionalContext"])' >/dev/null 2>&1 \
    || { echo "handoff-test: FAIL (restore did not emit valid SessionStart additionalContext JSON)"; rc=1; }
  local ctx
  ctx="$(printf '%s' "$restored" | python3 -c 'import json,sys; print(json.load(sys.stdin)["hookSpecificOutput"]["additionalContext"])' 2>/dev/null)"
  printf '%s' "$ctx" | grep -q "$marker" || { echo "handoff-test: FAIL (restored context missing the state marker — hook would wake blind)"; rc=1; }
  printf '%s' "$ctx" | grep -q 'paths: scripts/foo' || { echo "handoff-test: FAIL (restored context dropped a state line — not the SAME state)"; rc=1; }

  # 4) RED-guard the isolation: a window with NO stored handoff must restore NOTHING (empty), never another
  #    window's state — else a fresh mind wakes holding a stranger's thread.
  local empty
  empty="$(MESH_HANDOFF_TEST_WINDOW="no-such-window-$$" _restore)"
  [ -z "$empty" ] || { echo "handoff-test: FAIL (restore of an unknown window must be empty, got: $empty)"; rc=1; }

  # ══ P2: SNAPSHOT (cooperation-free crash safety net) ══
  # (P2a) scrollback with work-state + NO manual handoff → --snapshot writes an EXTRACTIVE auto handoff that
  #        carries a VERBATIM signal line, and --restore carries it forward.
  local sw="snapwin"
  printf 'ran: bash scripts/mesh-wip-commit --test\n[done] genome/wip-commit: 59e51e0\nedited scripts/mesh-handoff\nMARKER-%s some prose line\n' "$$" > "$td/scroll.txt"
  MESH_HANDOFF_SNAPSHOT_SCROLL_CMD="cat $td/scroll.txt" _snapshot_one "$sw"; [ "$?" = 0 ] || { echo "handoff-test: FAIL (snapshot with work-state + no manual handoff did not write)"; rc=1; }
  local sf; sf="$(_handoff_file "$sw")"
  grep -q '^# source: auto-snapshot$' "$sf" 2>/dev/null || { echo "handoff-test: FAIL (snapshot not marked # source: auto-snapshot)"; rc=1; }
  grep -q 'scripts/mesh-handoff' "$sf" 2>/dev/null || { echo "handoff-test: FAIL (snapshot dropped a VERBATIM signal line from scrollback)"; rc=1; }
  # the invented-next-step guard: the prose line with no path/command MUST NOT appear (extract is signal-only)
  grep -q "MARKER-$$ some prose" "$sf" 2>/dev/null && { echo "handoff-test: FAIL (snapshot kept a non-signal prose line — extract is not verbatim-signal)"; rc=1; }
  local sr src_ctx
  sr="$(MESH_HANDOFF_TEST_WINDOW="$sw" _restore)"
  src_ctx="$(printf '%s' "$sr" | python3 -c 'import json,sys; print(json.load(sys.stdin)["hookSpecificOutput"]["additionalContext"])' 2>/dev/null)"
  printf '%s' "$src_ctx" | grep -q 'scripts/mesh-handoff' || { echo "handoff-test: FAIL (restore did not carry the snapshot)"; rc=1; }

  # (P2b) a still-FRESH MANUAL handoff is NOT clobbered by --snapshot (manual tier is richer).
  local kw="keepwin"
  PATH=/usr/bin:/bin MESH_HANDOFF_TEST_WINDOW="$kw" _write_handoff "$kw" "MANUAL-RICH-$$ keep me" >/dev/null
  MESH_HANDOFF_SNAPSHOT_SCROLL_CMD="cat $td/scroll.txt" _snapshot_one "$kw"; [ "$?" = 4 ] || { echo "handoff-test: FAIL (snapshot did not report kept-manual rc=4 for a fresh manual handoff)"; rc=1; }
  grep -q "MANUAL-RICH-$$" "$(_handoff_file "$kw")" 2>/dev/null || { echo "handoff-test: FAIL (snapshot CLOBBERED a fresh manual handoff)"; rc=1; }
  grep -q '^# source: auto-snapshot$' "$(_handoff_file "$kw")" 2>/dev/null && { echo "handoff-test: FAIL (fresh manual handoff was overwritten by an auto snapshot)"; rc=1; }

  # (P2c) ANTI-BLOAT: a 100× scrollback must produce a body under the cap — the restored additionalContext
  #        cannot re-bloat the session it feeds. (operator: "no death NOR bloat".)
  local bw="bigwin" savecap="$SNAP_CAP"; SNAP_CAP=500
  yes "scripts/mesh-padding-line-$$-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx" | head -5000 > "$td/big.txt"
  MESH_HANDOFF_SNAPSHOT_SCROLL_CMD="cat $td/big.txt" MESH_HANDOFF_SNAPSHOT_LINES=9999 _snapshot_one "$bw"
  local bf blen; bf="$(_handoff_file "$bw")"
  blen="$(awk 'f;/^$/{f=1}' "$bf" | wc -c)"            # body = everything after the first blank line
  [ "$blen" -le "$((SNAP_CAP + 120))" ] || { echo "handoff-test: FAIL (snapshot body $blen exceeds cap $SNAP_CAP from a 100× scrollback — re-bloat)"; rc=1; }
  grep -q 'snapshot capped at' "$bf" 2>/dev/null || { echo "handoff-test: FAIL (over-cap snapshot missing the truncation marker)"; rc=1; }
  # the recovery pointer (summary) is placed FIRST → it must survive even a cap that truncates the bulk
  grep -q '^wip:' "$bf" 2>/dev/null || { echo "handoff-test: FAIL (cap dropped the wip recovery pointer — it must lead the body)"; rc=1; }
  SNAP_CAP="$savecap"

  # (P2e) THE /clear-CLOBBER BUG (2026-07-18): a pane captured right after /clear shows only prompt-furniture —
  #        the multi-line-prompt decoration, the `❯ /clear` command, and the statusline. NONE is work-state.
  #        (i) the extract must be HOLLOW (furniture stripped, not carried as signal); (ii) a hollow snapshot
  #        must NOT clobber an existing handoff (rc 6, prior content preserved). Drive the REAL post-/clear pane.
  local cw="clearwin"
  # write a rich prior auto-snapshot first (real work-state), then re-snapshot a just-cleared pane over it
  printf 'edited scripts/mesh-handoff\n[done] tg/hollow-guard: pending\nnext: land the /clear-clobber fix\n' > "$td/rich.txt"
  MESH_HANDOFF_SNAPSHOT_SCROLL_CMD="cat $td/rich.txt" _snapshot_one "$cw"; [ "$?" = 0 ] || { echo "handoff-test: FAIL (P2e setup: rich snapshot did not write)"; rc=1; }
  # a real post-/clear pane: 3 furniture lines and nothing else
  printf '  \342\226\230\342\226\230 \342\226\235\342\226\235    ~/lte-workstation\n\342\235\257 /clear\n  mesh-home@mesh-home:/home/mesh-home/x | Op4.8:hg | \342\247\211 tg | \342\226\221\342\226\221\342\226\221 | 5h:23%%(59m) | $0.00 | load 10.5 | 09:51\n' > "$td/cleared.txt"
  local hollow; hollow="$(_extract_terse < "$td/cleared.txt")"
  [ -z "$hollow" ] || { echo "handoff-test: FAIL (P2e: post-/clear furniture extracted as work-state, not stripped: [$hollow])"; rc=1; }
  MESH_HANDOFF_SNAPSHOT_SCROLL_CMD="cat $td/cleared.txt" _snapshot_one "$cw"; [ "$?" = 6 ] || { echo "handoff-test: FAIL (P2e: hollow post-/clear snapshot did not report kept-prior rc=6)"; rc=1; }
  grep -q 'next: land the /clear-clobber fix' "$(_handoff_file "$cw")" 2>/dev/null || { echo "handoff-test: FAIL (P2e: hollow snapshot CLOBBERED the rich prior handoff — the operator's bug)"; rc=1; }
  grep -q '/clear' "$(_handoff_file "$cw")" 2>/dev/null && ! grep -q 'clear-clobber' "$(_handoff_file "$cw")" 2>/dev/null && { echo "handoff-test: FAIL (P2e: the /clear command line leaked into the handoff)"; rc=1; }

  # (P2d) THIS TOOL IS THE CLEAR'S SAFETY NET — the coupling, restated after the 2026-07-24 simplification.
  #        mesh-clear no longer JUDGES a handoff (the model/coverage/freshness gate is gone, operator
  #        direction); it WRITES one by calling `mesh-handoff --snapshot` and then clears. So the property
  #        to hold here is the inverse of the old one: the snapshot must not be second-guessed — a real
  #        mesh-clear run over a fresh auto snapshot must proceed, naming THIS tool as the writer it will
  #        invoke, and must not resurrect a coverage/staleness verdict. (That the writer is actually
  #        CALLED before the /clear is asserted in mesh-clear's own --test, on the live path.)
  local mc; mc="$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")/mesh-clear"
  [ -x "$mc" ] || mc="$(command -v mesh-clear 2>/dev/null || true)"
  if [ -n "$mc" ] && [ -r "$mc" ]; then
    local vdry
    # mesh-clear prints refusals to STDERR — capture 2>&1 or a block reads as empty and assertions mis-fire.
    vdry="$(MESH_HANDOFF_DIR="$HANDOFF_DIR" MESH_CLEAR_SESSION=__none__ bash "$mc" "$sw" --dry-run 2>&1)"
    printf '%s' "$vdry" | grep -q 'mesh-handoff --snapshot' || { echo "handoff-test: FAIL (mesh-clear does not name mesh-handoff --snapshot as its writer — the safety net is not wired: $vdry)"; rc=1; }
    printf '%s' "$vdry" | grep -qiE 'coverage|stale|BLOCK' && { echo "handoff-test: FAIL (a coverage/staleness verdict is back in mesh-clear's path: $vdry)"; rc=1; }
  else
    echo "handoff-test: NOTE — mesh-clear not resolvable; skipped the writer-coupling check"
  fi

  # ── (P2f) wip-summary branches on the LANDED predicate (task wip-ref-stale-after-landing 2026-07-21).
  #    The predicate itself lives in mesh-wip-commit (its own --test drives it on real repos); THIS
  #    tool's contract is the branching on the rc — driven with a stub so each branch is forced.
  local wr="$td/wrepo" stubbin="$td/stubbin" s
  git init -q "$wr" 2>/dev/null; git -C "$wr" config user.email t@t; git -C "$wr" config user.name t
  ( cd "$wr" && echo a > f.txt && git add -A && git commit -qm base ) >/dev/null 2>&1
  git -C "$wr" update-ref refs/wip/wsumwin "$(git -C "$wr" rev-parse HEAD)"
  mkdir -p "$stubbin"
  printf '#!/bin/sh\nexit 0\n' > "$stubbin/mesh-wip-commit"; chmod +x "$stubbin/mesh-wip-commit"
  s="$(PATH="$stubbin:/usr/bin:/bin" _git_wip_summary wsumwin "$wr")"
  printf '%s' "$s" | grep -q 'already landed' || { echo "handoff-test: FAIL (P2f: clean+landed ref must read 'already landed', got: $s)"; rc=1; }
  printf '%s' "$s" | grep -q 'recover:' && { echo "handoff-test: FAIL (P2f: landed ref still advertises the stale recover pointer: $s)"; rc=1; }
  printf '#!/bin/sh\nexit 1\n' > "$stubbin/mesh-wip-commit"
  s="$(PATH="$stubbin:/usr/bin:/bin" _git_wip_summary wsumwin "$wr")"
  printf '%s' "$s" | grep -q 'UNLANDED' || { echo "handoff-test: FAIL (P2f: clean+unlanded ref must warn UNLANDED/lost work, got: $s)"; rc=1; }
  printf '%s' "$s" | grep -q "recover: mesh-wip-commit --restore wsumwin" || { echo "handoff-test: FAIL (P2f: unlanded ref lost its recover pointer: $s)"; rc=1; }
  # dirty tree: the plain parked-pointer line, predicate not consulted (stub would say landed)
  echo b >> "$wr/f.txt"
  printf '#!/bin/sh\nexit 0\n' > "$stubbin/mesh-wip-commit"
  s="$(PATH="$stubbin:/usr/bin:/bin" _git_wip_summary wsumwin "$wr")"
  printf '%s' "$s" | grep -q 'dirty file(s); uncommitted work parked' || { echo "handoff-test: FAIL (P2f: dirty tree must keep the parked-pointer line, got: $s)"; rc=1; }
  # tool absent: conservative old pointer line (no crash, no landed claim)
  git -C "$wr" checkout -q -- f.txt
  s="$(PATH=/usr/bin:/bin _git_wip_summary wsumwin "$wr")"
  printf '%s' "$s" | grep -q 'refs/wip/wsumwin' || { echo "handoff-test: FAIL (P2f: tool-absent fallback lost the ref pointer, got: $s)"; rc=1; }
  printf '%s' "$s" | grep -q 'already landed' && { echo "handoff-test: FAIL (P2f: tool-absent fallback CLAIMED landed without evidence: $s)"; rc=1; }

  rm -rf "$td"
  [ "$rc" = 0 ] && echo "handoff-test: ok (manual round-trip carries state; snapshot extracts verbatim signal + no-clobber of fresh manual + capped from 100× scrollback + mesh-clear names this tool as its handoff writer with no coverage verdict + wip line branches landed/unlanded/dirty/tool-absent)"
  exit "$rc"
}

# ---- lib mode ----
# Another tool may `MESH_HANDOFF_LIB_ONLY=1 source mesh-handoff` to reuse the EXTRACTOR (_extract_terse,
# deterministic furniture-stripping — no model) without running the dispatch. This is the mesh's ONE
# extractive-handoff path: it used to live in mesh-clear (_extract_handoff, a model call) and moved here
# when the clear-gate's model was removed, so mesh-clear-loss's canary extracts exactly what the real
# */5 snapshot extracts — one extractor, never a second copy to rot.
[ -n "${MESH_HANDOFF_LIB_ONLY:-}" ] && return 0 2>/dev/null

case "${1:-}" in
  --test)     _test ;;
  --restore)  _restore ;;
  --snapshot) _snapshot "${2:-}" ;;
  --show)
    win="${2:-$(_this_window)}"
    [ -n "$win" ] || { echo "mesh-handoff --show: no window (not in tmux) — pass one explicitly" >&2; exit 2; }
    f="$(_handoff_file "$win")"
    [ -r "$f" ] && cat "$f" || { echo "mesh-handoff --show: no handoff stored for '$win' ($f)" >&2; exit 1; }
    ;;
  ""|-h|--help)
    sed -n '2,20p' "$0"; exit 0 ;;
  *)
    win="$1"; shift
    state="${*:-}"
    [ -n "$state" ] || { echo "usage: mesh-handoff <window> \"<what done> + <next> + <key paths>\"" >&2; exit 2; }
    _write_handoff "$win" "$state" >/dev/null
    echo "handoff written for '$win' → $(_handoff_file "$win") (+ [handoff] board line)"
    ;;
esac
