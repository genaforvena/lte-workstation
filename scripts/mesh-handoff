#!/usr/bin/env bash
# mesh-handoff — pre-/clear work-memory handoff so a mind's thread survives a /clear (or /compact, or reboot
# reincarnation). A mind that /clears loses its in-context thread: end-of-session doctrine says "never leave
# the window blank", but a bare /clear still drops the UNCOMMITTED work-state (what was half-done, what's next,
# which paths) — and neither the chat board nor the data pane reliably retains it. This closes the loop:
#   PRE-CLEAR  (a mind writes):  mesh-handoff <window> "<what done> + <next> + <key paths>"
#   POST-CLEAR (the hook reads): mesh-handoff --restore   → cats the window's handoff into SessionStart context
# so a freshly-cleared session wakes already holding its own thread.
# orphan-ok: on-demand (a mind runs it pre-/clear) + SessionStart-hook glue (~/.claude/settings.json) — not a cron reflex.
#
#   mesh-handoff <window> "<state>"   write ~/.mesh/handoff/<window>.md (overwrite) + post one [handoff] line to chat.log
#   mesh-handoff --restore            resolve THIS pane's window (tmux) → emit its handoff as SessionStart additionalContext
#   mesh-handoff --show [<window>]    print the stored handoff (this window if omitted) to stdout
#   mesh-handoff --charter [<win>]    print the window's CHARTER (durable instruction: ~/.mesh/charter/<win>.md,
#                                     falling back to the genome charter/<win>.md) — the text --restore lays down
#   mesh-handoff --goal [<win>]       ONE line: the window's declared goal (+ deadline, + measured progress) for
#                                     its data pane. NEVER blank and never absent: an undeclared goal prints
#                                     that it is undeclared, and names the file that should carry it.
#   mesh-handoff --snapshot [<win>]   (reflex) auto-derive a TERSE, capped handoff from pane scrollback + git/wip summary
#                                     — cooperation-free crash safety net; no window = all mind windows
#   mesh-handoff --audit [--window <w>] [--horizon-h N] [--json]
#                                     (report-only) replay the board's [handoff] trail and score each
#                                     transfer by its PRODUCT: did the receiving window's LATER lines touch
#                                     the ROUTE the handoff named (teaching-shaped), or is there no overlap
#                                     at all (transport-shaped)? na for unevaluable. See _audit for the cite.
#   mesh-handoff --test               round-trip smoke test (manual round-trip + snapshot: no-clobber, cap, clear-coupling)
#
# reflex-cadence: */5 * * * *
# reflex-args: --snapshot
#
# Concrete trigger (2026-07-18): the models mind /cleared mid fine-tune and lost its loss log + the fact that
# eval_heldout/eval_real already existed — re-derived from scratch. A [handoff] would have carried it across.
#
# TWO tiers of handoff (crash-proof-recovery §P2):
#   MANUAL   — a mind writes it pre-/clear (`# source: manual`); RICH; the whole truth. Posts a [handoff] board line.
#   SNAPSHOT — the reflex auto-derives it (`# source: auto-snapshot`) from the pane scrollback on a cadence, so a
#              CRASH (OOM/kill-9/engine death) that never wrote a manual handoff still restores a ≤cadence-old thread.
# The snapshot is EXTRACTIVE + HARD-CAPPED (operator: "no death NOR bloat") — it copies verbatim signal lines,
# never invents a next-step, and truncates to MESH_HANDOFF_SNAPSHOT_CAP chars so --restore can't re-bloat the fresh
# session it feeds. It NEVER clobbers a still-FRESH manual handoff (that tier is richer). THIS SNAPSHOT IS WHAT
# MAKES A /clear SAFE (2026-07-24): mesh-clear no longer judges a handoff with a model — it calls
# `mesh-handoff --snapshot` to WRITE one and then clears, so the guarantee is this deterministic extraction plus
# the refs/wip commit beside it, not a classifier's opinion. The --test asserts that coupling.
#
# The per-window file is the DURABLE tier (survives /clear; stale-on-reboot is fine — reboot is clean
# reincarnation). The [handoff] chat line is the VOLATILE board tier (one line, like [fyi]) so other minds and
# the operator see a handoff happened. Same split as card (durable) vs trace (volatile).
# orphan-ok: --snapshot self-wires via reflex-cadence; manual write/--restore/--show are on-demand + SessionStart glue.
set -uo pipefail

MESH_DIR="${MESH_DIR:-$HOME/.mesh}"
HANDOFF_DIR="${MESH_HANDOFF_DIR:-$MESH_DIR/handoff}"
SESSION="${MESH_HANDOFF_SESSION:-$(hostname)}"
SNAP_CAP="${MESH_HANDOFF_SNAPSHOT_CAP:-1400}"            # hard char cap on a snapshot body (anti-bloat)
SNAP_LINES="${MESH_HANDOFF_SNAPSHOT_LINES:-12}"          # verbatim signal lines kept from scrollback
SNAP_SCROLL="${MESH_HANDOFF_SNAPSHOT_SCROLL:-160}"       # scrollback lines read from the pane
KEEP_MANUAL_SECS="${MESH_HANDOFF_KEEP_MANUAL_SECS:-900}" # a manual handoff younger than this is NOT clobbered

# ── CHARTER: the WINDOW's durable instruction, restored by the SAME SessionStart hook (board task
#    {#943287f7}, operator 2026-08-21 "разнести по границе инструкция/память"). CLAUDE.md keeps only what is
#    true for ANY window on ANY node; anything true for THIS window only lives here and is laid under the
#    handoff at every startup|clear. Two tiers, checked in order — a node-local override, then the genome's
#    committed default — so a fresh node needs no deploy step and a node can still say something different.
#    It is INSTRUCTION, not work-state: the handoff is what you were doing, the charter is what this window IS.
CHARTER_DIR="${MESH_CHARTER_DIR:-$MESH_DIR/charter}"
CHARTER_GENOME="${MESH_GENOME:-$HOME/lte-workstation}/charter"
CHARTER_CAP="${MESH_CHARTER_CAP:-6000}"                  # hard char cap; truncation is LOUD, never silent

# Resolve the window this process runs in from the tmux pane (same read mesh-chat uses: #W = window name).
# Override for tests via MESH_HANDOFF_TEST_WINDOW. Empty when not in tmux (nothing to restore).
_this_window() {
  [ -n "${MESH_HANDOFF_TEST_WINDOW:-}" ] && { printf '%s' "$MESH_HANDOFF_TEST_WINDOW"; return; }
  [ -n "${TMUX_PANE:-}" ] || return 0
  tmux display-message -p -t "$TMUX_PANE" '#W' 2>/dev/null || true
}

# Sanitize a window name to a safe filename component (no path traversal / spaces).
_safe_win() { printf '%s' "$1" | tr -c 'A-Za-z0-9._-' '_'; }

_handoff_file() { printf '%s/%s.md' "$HANDOFF_DIR" "$(_safe_win "$1")"; }

# Last-boot wall-clock epoch (seconds). Override for tests via MESH_HANDOFF_BOOT_EPOCH. Linux /proc/stat
# `btime` is the node's boot time; empty when unavailable (defensive — caller then treats incarnation as
# UNKNOWN and keeps the neutral/full-trust lede, honest-fusion, no false alarm).
_boot_epoch() {
  [ -n "${MESH_HANDOFF_BOOT_EPOCH:-}" ] && { printf '%s' "$MESH_HANDOFF_BOOT_EPOCH"; return; }
  awk '/^btime/{print $2; exit}' /proc/stat 2>/dev/null || true
}

# Compact human age from a second count (45s / 12m / 3h / 2d).
_ago() { # $1=seconds
  local s="$1"
  if   [ "$s" -ge 86400 ]; then printf '%dd' "$((s/86400))"
  elif [ "$s" -ge 3600 ];  then printf '%dh' "$((s/3600))"
  elif [ "$s" -ge 60 ];    then printf '%dm' "$((s/60))"
  else printf '%ds' "$s"; fi
}

_write_handoff() { # $1=window  $2=state-text
  local win="$1" state="$2" f
  mkdir -p "$HANDOFF_DIR"
  f="$(_handoff_file "$win")"
  # Durable per-window file: a real header (window + UTC stamp) then the full state verbatim. Overwrite —
  # the latest handoff is the whole truth; history lives in the chat.log [handoff] trail.
  {
    printf '# handoff: %s\n' "$win"
    printf '# written: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    printf '# source: manual\n'
    printf '# (pre-/clear work-memory — restored into SessionStart context by mesh-handoff --restore)\n\n'
    printf '%s\n' "$state"
  } > "$f"
  # Volatile board line — reuse mesh-chat so it gets WHO-resolution + log-scrub + the same format as every
  # other marker. One line only; the full state lives in the file. Degrade to a raw append if mesh-chat absent.
  local oneline
  oneline="$(printf '%s' "$state" | tr '\n' ' ' | cut -c1-240)"
  if command -v mesh-chat >/dev/null 2>&1; then
    mesh-chat "[handoff] $win: $oneline (full state → $f)" >/dev/null 2>&1 || true
  else
    printf '%s  handoff@%s  ::  [handoff] %s: %s (full state → %s)\n' \
      "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$(hostname)" "$win" "$oneline" "$f" >> "$MESH_DIR/chat.log" 2>/dev/null || true
  fi
  printf '%s\n' "$f"
}

# ── P2: continuous, cooperation-free SNAPSHOT handoff ────────────────────────────────────────────
# Read a window's mind-pane scrollback (bottom pane, same convention as mesh-clear/mesh-tell). Override
# for tests with MESH_HANDOFF_SNAPSHOT_SCROLL_CMD (stdin-less; echoes canned scrollback).
_read_scroll() { # $1=window → scrollback text (empty if unreachable)
  [ -n "${MESH_HANDOFF_SNAPSHOT_SCROLL_CMD:-}" ] && { $MESH_HANDOFF_SNAPSHOT_SCROLL_CMD; return; }
  local win="$1" idx pane
  tmux has-session -t "$SESSION" 2>/dev/null || return 0
  idx="$(tmux list-panes -t "$SESSION:$win" -F '#{pane_top} #{pane_index}' 2>/dev/null | sort -n | tail -1 | awk '{print $2}')"
  [ -n "$idx" ] || return 0
  tmux capture-pane -t "$SESSION:$win.$idx" -p -S "-$SNAP_SCROLL" 2>/dev/null || true
}

# Extractive, MODEL-FREE, verbatim: keep only the last N "signal" lines (paths/commands/markers) from the
# scrollback. Copies real tokens; invents NOTHING (no next-step). Deterministic — right for a */5×15-window
# reflex (a model call per window would thrash the GPU the senses need). Deliberately crude: this is a SAFETY NET
# under the manual tier — and since the clear-gate's model was removed (2026-07-24) it is the mesh's ONE
# extractive-handoff path, shared by mesh-clear (writer) and mesh-clear-loss (canary) via MESH_HANDOFF_LIB_ONLY.
_extract_terse() { # stdin=scrollback → terse verbatim body
  # SIGNAL first, then strip the SHELL-FURNITURE that the signal grep also matches: the statusline
  # (unique glyph ⧉), the multi-line-prompt decoration (quadrant/block glyphs at line start), and the
  # session-lifecycle slash commands (/clear, /compact) — which are NOT work-state. Without this, a pane
  # captured right AFTER /clear (visible scrollback = just prompt+statusline) yields those three noise
  # lines as the entire "work-state" and clobbers a richer handoff (the /clear-clobber bug, 2026-07-18).
  grep -aE '(/|mesh-|git |\[done\]|\[task\]|\[handoff\]|\[fyi\]|\.md|\.sh|refs/|scripts/|commit|error|FAIL)' 2>/dev/null \
    | grep -avE '⧉|^[[:space:]]*[▘▝▖▗▄▀░▒▓█▌▐]|(^|❯[[:space:]]+)/(clear|compact)([[:space:]]|$)' \
    | grep -avE '^[[:space:]]*$' \
    | tail -n "$SNAP_LINES"
}

# Resolve a window's worktree from its pane cwds (same read as mesh-wip-commit) — NOT the reflex's own
# cwd, which under cron is $HOME (not a repo). Empty if the window isn't in a git worktree / no tmux.
_window_worktree() { # $1=window → toplevel path (empty if none)
  local win="$1" p top
  tmux has-session -t "$SESSION" 2>/dev/null || return 0
  while read -r p; do
    [ -n "$p" ] || continue
    top="$(git -C "$p" rev-parse --show-toplevel 2>/dev/null)" || continue
    [ -n "$top" ] && { printf '%s' "$top"; return 0; }
  done < <(tmux list-panes -t "$SESSION:$win" -F '#{pane_current_path}' 2>/dev/null)
  return 0
}

# One-line git dirty + refs/wip summary — names the P1 snapshot ref so a reincarnated mind finds its
# uncommitted work (mesh-wip-commit --restore <win>). Placed FIRST in the body so the anti-bloat cap
# (which truncates the tail) can never drop this recovery pointer. Best-effort; degrades if not a repo.
_git_wip_summary() { # $1=window  $2=toplevel (may be empty)
  local win="$1" top="$2" n short landed=""
  [ -n "$top" ] || { printf 'wip: (worktree n/a — snapshot is scrollback-only)'; return 0; }
  n="$(git -C "$top" status --porcelain 2>/dev/null | wc -l | tr -d ' ')"
  short="$(git -C "$top" rev-parse -q --short "refs/wip/$(_safe_win "$win")" 2>/dev/null || true)"
  # Clean tree + parked ref: ask the ref's owner tool whether the delta LANDED (mesh-wip-commit
  # --landed rc contract: 0=landed · 1=unlanded · else unknown). A landed ref makes the recover
  # instruction a STALE pointer (restoring work HEAD already carries fails); an UNLANDED ref on a
  # clean tree is LOST WORK — the one case where the pointer is urgent, so say so loudly. Tool
  # absent / rc unknown → fall through to the old conservative pointer line.
  if [ -n "$short" ] && [ "$n" = 0 ] && command -v mesh-wip-commit >/dev/null 2>&1; then
    (cd -- "${top:?empty path — refusing to cd into $PWD (fixture would write into the live repo)}" && mesh-wip-commit --landed "$win" >/dev/null 2>&1); landed=$?
  fi
  if [ -n "$short" ] && [ "$landed" = "0" ]; then
    printf 'wip: clean — refs/wip/%s @ %s already landed in HEAD (no recovery needed; prunes next wip cadence)' "$win" "$short"
  elif [ -n "$short" ] && [ "$landed" = "1" ]; then
    printf 'wip: tree CLEAN but refs/wip/%s @ %s holds UNLANDED work (lost from the tree?) — recover: mesh-wip-commit --restore %s' "$win" "$short" "$win"
  elif [ -n "$short" ]; then
    printf 'wip: %s dirty file(s); uncommitted work parked at refs/wip/%s @ %s — recover: mesh-wip-commit --restore %s' \
      "$n" "$win" "$short" "$win"
  else
    printf 'wip: %s dirty file(s) in %s (no refs/wip/%s yet — mesh-wip-commit not yet run this cadence)' "$n" "$top" "$win"
  fi
}

# Hard char cap — truncate at a UTF-8-safe boundary with an explicit marker so a fat scrollback can never
# re-bloat the session --restore feeds. This is the anti-bloat gate (operator: "no death NOR bloat").
_cap() { # $1=text $2=cap → capped text
  local t="$1" cap="$2"
  if [ "${#t}" -le "$cap" ]; then printf '%s' "$t"; return; fi
  printf '%s\n…[snapshot capped at %s chars — see the pane/refs/wip for the rest]' "${t:0:$cap}" "$cap"
}

_write_snapshot() { # $1=window $2=body $3=fidelity(optional) — writes the auto tier ONLY (no board line: a */5 reflex must not flood chat)
  local win="$1" body="$2" fidelity="${3:-}" f
  mkdir -p "$HANDOFF_DIR"; f="$(_handoff_file "$win")"
  {
    printf '# handoff: %s\n' "$win"
    printf '# written: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    printf '# source: auto-snapshot\n'
    [ -n "$fidelity" ] && printf '# fidelity: %s\n' "$fidelity"
    printf '# (cooperation-free crash safety net — mesh-handoff --snapshot; restored by --restore)\n\n'
    printf '%s\n' "$body"
  } > "$f"
}

# Snapshot ONE window. rc 0=written, 4=kept-fresh-manual (skipped), 5=nothing to snapshot (no scrollback),
# 6=kept prior handoff (extract was hollow — just-cleared/furniture-only pane; never clobber with noise).
_snapshot_one() { # $1=window
  local win="$1" f src mtime age scroll extract summary body
  [ -n "$win" ] || return 5
  f="$(_handoff_file "$win")"
  # clobber-protection: a still-FRESH manual handoff is richer — never overwrite it.
  if [ -r "$f" ]; then
    src="$(sed -n 's/^# source: //p' "$f" | head -1)"
    mtime="$(stat -c %Y "$f" 2>/dev/null || echo 0)"; age=$(( $(date +%s) - mtime ))
    if [ "$src" = manual ] && [ "$age" -le "$KEEP_MANUAL_SECS" ]; then return 4; fi
  fi
  scroll="$(_read_scroll "$win")"
  [ -n "$scroll" ] || return 5                         # unreachable / empty pane → nothing to snapshot
  extract="$(printf '%s' "$scroll" | _extract_terse)"
  # HOLLOW-GUARD: after furniture-stripping, a just-cleared pane extracts to NOTHING. Writing a "no signal"
  # body would OVERWRITE a richer prior handoff (manual OR a good earlier auto-snapshot) — the exact damage
  # the operator hit: a */5 snapshot landed 1s after /clear and replaced real work-state with the /clear line.
  # If the extract is hollow AND a handoff already exists, PRESERVE it (rc 6) rather than clobber with noise.
  if [ -z "$extract" ] && [ -r "$f" ]; then return 6; fi
  summary="$(_git_wip_summary "$win" "$(_window_worktree "$win")")"
  # CODE-DUALITY fidelity flag (biosemiotics live review 2026-07-29, docs/reviews/biosemiotics-code-
  # duality-handoff-fidelity-2026-07-29.md): the handoff is the mind's DIGITAL memory-code that crosses
  # the /clear death boundary; the pane is its ANALOG action-code. The hollow-guard above rejects an
  # EMPTY re-description only when a prior handoff exists — it cannot see an "impossible message": a
  # hollow extract written (no prior file) while the tree HOLDS uncommitted work. That digital code names
  # none of the analog work and is faithfully re-interpreted into a work-blind next session (the 07-18
  # loss-log incident). Non-empty is not correct. REPORT-ONLY: a header comment the restore surfaces to a
  # human/mind, never a verdict, never gates the clear (refs/wip stays the durable fallback).
  local fidelity=""
  if [ -z "$extract" ]; then
    case "$summary" in
      *"dirty file(s); uncommitted"*|*"holds UNLANDED work"*)
        fidelity="LOW — extract hollow but tree holds uncommitted work; re-interpret from refs/wip + the pane, not this body" ;;
    esac
  fi
  # summary FIRST (short, deterministic, carries the recovery pointer → survives the cap); the verbatim
  # scrollback extract follows and is the cap-truncatable bulk.
  body="$(printf '%s\n\nwork-state (auto-extracted verbatim from the %s pane — may be partial, no invented next-step):\n%s' \
           "$summary" "$win" "${extract:-（no signal lines matched — see the pane）}")"
  body="$(_cap "$body" "$SNAP_CAP")"
  _write_snapshot "$win" "$body" "$fidelity"
}

_snapshot() { # $1=window (optional). No window → every mind window (2-pane channels).
  local win="$1" rc n_w=0 n_k=0 n_s=0 n_h=0
  if [ -n "$win" ]; then
    _snapshot_one "$win"; rc=$?
    case "$rc" in 0) echo "snapshot: wrote auto handoff for '$win' → $(_handoff_file "$win")";;
                  4) echo "snapshot: kept fresh manual handoff for '$win' (not clobbered)";;
                  5) echo "snapshot: nothing to snapshot for '$win' (no scrollback)";;
                  6) echo "snapshot: kept prior handoff for '$win' (pane hollow — no signal to snapshot)";; esac
    return 0
  fi
  tmux has-session -t "$SESSION" 2>/dev/null || { echo "snapshot: no session '$SESSION'"; return 0; }
  while read -r win; do
    [ -n "$win" ] || continue
    _snapshot_one "$win"; rc=$?
    case "$rc" in 0) n_w=$((n_w+1));; 4) n_k=$((n_k+1));; 5) n_s=$((n_s+1));; 6) n_h=$((n_h+1));; esac
  done < <(tmux list-windows -t "$SESSION" -F '#{window_name} #{window_panes}' 2>/dev/null | awk '$2>=2{print $1}')
  echo "snapshot: $n_w written · $n_k manual-kept · $n_h hollow-kept · $n_s empty ($(date -u +%H:%M:%SZ))"
  # CHARTER COVERAGE rides the cadence that already exists. This pass runs */5 and is the only
  # scheduled reader of the charter tier, so the census belongs here rather than in a new reflex.
  _charter_census
}

_charter_file() { # first readable charter for window $1: node-local override, then genome default. Empty if none.
  local win="$1" f
  for f in "$CHARTER_DIR/$win.md" "$CHARTER_GENOME/$win.md"; do
    [ -r "$f" ] && { printf '%s' "$f"; return 0; }
  done
  return 1
}

# _charter_census — the COVERAGE assert, with a real denominator. Prints one line per window that is
# DECLARED but has no resolvable charter, then a summary; rc is always 0 and it never refuses anything.
# WHY A DENOMINATOR AND NOT A CHECK: a per-window absence is now named at the restore (above), but that
# line is only read by the mind it happens to, at the moment it wakes. Nobody was counting, so eight
# charterless windows were a fact about the node that no reader held. The declaration is
# MESH_MIND_CHANNELS — the same string mesh-restore plants from and mesh-channel-keepalive now derives
# its keep set from — so a channel added there cannot be silently uncharted here either.
# NOT FATAL, deliberately: a lean node or a fresh plant legitimately runs ahead of its charters. LOUD
# and COUNTED is the requirement; refusing would make a fresh window's first act a failure.
_mind_channels() {
  # cron does not source restore.env, so the declaration is invisible to a scheduled pass unless we
  # read it ourselves — an env gate armed by a file a cron never sources is not a gate.
  if [ -z "${MESH_MIND_CHANNELS:-}" ] && [ -r "$MESH_DIR/restore.env" ]; then
    MESH_MIND_CHANNELS="$(sed -n 's/^[[:space:]]*export[[:space:]]*MESH_MIND_CHANNELS=\"\([^\"]*\)\".*/\1/p' "$MESH_DIR/restore.env" | tail -1)"
  fi
  printf '%s' "${MESH_MIND_CHANNELS:-}"
}
# _charter_owed <win> — rc 0 if this window is one that SHOULD have a charter. An absence is a GAP
# only relative to a declaration; without this, the restore announces a missing charter for every pane
# that was never a mind channel (an existing arm caught exactly that on a fabricated window name), and
# an alarm that fires on things it was never about stops being read.
# Declaration first (MESH_MIND_CHANNELS, the same string mesh-restore plants from). If no declaration
# is readable at all, fall back to the structural fact — is this a real >=2-pane channel in the live
# session — rather than to silence, because silence on an unreadable declaration would reinstate the
# very fault this change removes on exactly the nodes that declare nothing.
_charter_owed() {
  local win="$1" decl
  decl="$(_mind_channels)"
  if [ -n "$decl" ]; then
    case " $decl " in *" $win "*) return 0;; *) return 1;; esac
  fi
  [ "$(tmux list-panes -t "$SESSION:$win" 2>/dev/null | wc -l)" -ge 2 ]
}
# ── THE GOAL LINE (2026-08-29, operator task window-goal-line-in-data-pane {#97112188}) ───────────
# WHY. `~/.mesh/audit-tg-2026-08-15-29.md` audited 322 operator messages over 14 days, and its first
# finding is that the single most load-bearing statement of the fortnight — "мне до 5 числа нужно
# обязательно найти работу … До 5 сентября" (voice, 2026-08-26T18:08:51Z) — was in NO file. It lived
# only in the context of the window that heard it, so every /clear erased it, and it was erased. The
# remedy is not a better memory: it is that a window's GOAL is a declared field in its charter, and
# that its data pane prints it in the first line of every frame.
#
# THREE FIELDS, all optional, all one line, read from the charter the SAME resolver serves --charter
# and --restore (never a second copy of the grammar — a reader that resolves charters its own way is
# a different tool answering a different question):
#   goal:      what this window is FOR, in one sentence.
#   deadline:  a date the goal is bound to. Printed with its own countdown, because a deadline that
#              is only a date is a thing you read; one with "3 дня" beside it is a thing you act on.
#   progress:  a SHELL COMMAND whose first stdout line is the current progress. Each window declares
#              how its own progress is measured — the dash cannot know what a funnel or a landing
#              rate is, and a fixed metric imposed on every window would be wrong for all of them.
#
# EVERY ABSENCE IS PRINTED, NEVER SKIPPED. A blank first line is the exact failure this closes: it is
# indistinguishable from a window that has no goal, from a charter that could not be read, and from a
# renderer that crashed. So: no charter → say so and name both paths looked in; charter but no goal:
# → say so and name the file that should carry it; progress: declared but failing → say it failed,
# with its rc, never silently fall back to nothing.
# The command is trusted local config, exactly like supervise.list or a crontab, and it is bounded by
# `timeout` because this runs in a pane refresh loop.
# ONE ROW OR THREE: a pane's row budget is the scarcest thing in this codebase — mesh-dash gates its
# own frame heights, and adding three unconditional rows to every frame pushed the adint role two rows
# past its pane the first time this shipped. So the pane gets `--oneline` (goal · deadline · progress
# folded with separators, clipped by the caller) and a human calling it by hand gets the readable
# three-line form. SAME function, so the two renderings can never disagree about what is declared.
_goal_line() { # $1=window [$2=--oneline] -> always non-empty, always rc 0
  local win="$1" one="${2:-}" cf goal="" dl="" prog="" out rc left
  local _p=() _emit
  _emit(){ _p+=("$1"); }
  if ! cf="$(_charter_file "$win")"; then
    _emit "ЦЕЛЬ НЕ ОБЪЯВЛЕНА — у окна '$win' нет чартера (искал $CHARTER_DIR/$win.md, затем $CHARTER_GENOME/$win.md)"
    _goal_emit "$one"; return 0
  fi
  # first match wins; strip the key, trim. A field repeated is a charter bug, not a merge.
  goal="$(grep -m1 -E '^[[:space:]]*goal:' "$cf" 2>/dev/null | sed -E 's/^[[:space:]]*goal:[[:space:]]*//')"
  dl="$(  grep -m1 -E '^[[:space:]]*deadline:' "$cf" 2>/dev/null | sed -E 's/^[[:space:]]*deadline:[[:space:]]*//')"
  prog="$(grep -m1 -E '^[[:space:]]*progress:' "$cf" 2>/dev/null | sed -E 's/^[[:space:]]*progress:[[:space:]]*//')"
  if [ -z "$goal" ]; then
    _emit "ЦЕЛЬ НЕ ОБЪЯВЛЕНА — $cf есть, но не содержит строки 'goal:' (одна строка: goal: <зачем это окно>)"
  else
    _emit "ЦЕЛЬ [$win]: $goal"
  fi
  if [ -n "$dl" ]; then
    # the countdown is derived, never stored: a stored "N days left" is wrong the next morning.
    # CALENDAR DAYS, both ends snapped to midnight. Measuring from NOW to the deadline's midnight
    # makes the count shrink through the day — "6 дн." in the morning and "5 дн." after supper for a
    # deadline that has not moved — and it reads as a day being lost that was not. A human asking how
    # long is left means the difference between two DATES.
    if left="$(date -d "$dl" +%s 2>/dev/null)"; then
      local _today; _today="$(date -d "$(date +%F)" +%s)"
      local days=$(( (left - _today) / 86400 ))
      if   [ "$days" -lt 0 ]; then _emit "СРОК: $dl — ПРОСРОЧЕН на $(( -days )) дн."
      elif [ "$days" = 0 ]; then   _emit "СРОК: $dl — СЕГОДНЯ"
      else                         _emit "СРОК: $dl — осталось $days дн."; fi
    else
      _emit "СРОК: $dl (не разобран как дата — countdown недоступен)"
    fi
  fi
  if [ -z "$prog" ]; then
    _emit "ПРОГРЕСС: не объявлен — добавьте в $cf строку 'progress: <команда, печатающая одну строку>'"
  else
    out="$(timeout "${MESH_GOAL_PROGRESS_TIMEOUT:-10}" bash -lc "$prog" 2>/dev/null | head -1)"; rc=$?
    if [ "$rc" != 0 ] && [ -z "$out" ]; then
      _emit "ПРОГРЕСС: НЕ ИЗМЕРЕН — команда прогресса вышла с rc=$rc (progress: $prog)"
    elif [ -z "$out" ]; then
      _emit "ПРОГРЕСС: НЕ ИЗМЕРЕН — команда прогресса ничего не напечатала (progress: $prog)"
    else
      _emit "ПРОГРЕСС: $out"
    fi
  fi
  _goal_emit "$one"
  return 0
}
# The renderer, kept apart so both shapes come from one collected set of parts. `_p` is the caller's
# local; this is only ever called from inside _goal_line.
# THE CLIP DECIDES WHAT IS VISIBLE, SO THE ORDER IS THE DESIGN. First cut of --oneline joined the
# parts goal → deadline → progress and the pane clipped at 80 columns, which removed EXACTLY the two
# things the operator asked to see: "осталось 7 дн." and the funnel. A line whose payload is past the
# clip is the same invisibility as a blank one. So:
#   row 1 leads with the DEADLINE (short, and the thing with a clock on it), then the goal prose,
#          which is long, stable and the part that can afford to be cut;
#   row 2 is the PROGRESS, leading with its own numbers.
# Two rows, not three — a pane's row budget is scarce and the adint role was already at its ceiling.
# The "progress: not declared" NUDGE is deliberately absent from the pane and present in the full
# form: it is advice to the charter's author, not data, and spending a permanent row of every pane on
# it would cost the roles that have no progress the very rows the goal needs. Nothing is hidden — the
# goal row is always there and never blank, and a progress that FAILS stays loud on the pane.
_goal_emit(){ # $1=--oneline|empty
  local i out="" dl="" goal="" prog=""
  if [ "${1:-}" = --oneline ]; then
    for i in "${_p[@]}"; do
      case "$i" in
        "СРОК: "*)      dl="${i#СРОК: }" ;;
        "ПРОГРЕСС: не объявлен"*) : ;;                 # a nudge for the charter's author, not pane data
        "ПРОГРЕСС: "*)  prog="$i" ;;
        *)              goal="$i" ;;
      esac
    done
    out="$goal"
    [ -n "$dl" ] && out="СРОК $dl · $goal"
    printf '%s\n' "$out"
    [ -n "$prog" ] && printf '%s\n' "$prog"
  else
    printf '  %s\n' "${_p[@]}" | sed '1s/^  //'
  fi
}

_charter_census() {
  local decl n_d=0 n_ok=0 n_miss=0 miss="" w src
  decl="$(_mind_channels)"
  if [ -z "$decl" ]; then
    # NO DECLARATION IS UNKNOWN, NOT FULL COVERAGE. With no denominator the honest reading is that we
    # cannot say — rendering 0 missing here would be the same silence this whole change removes.
    echo "charter-census: UNKNOWN — no MESH_MIND_CHANNELS declared (looked in the environment and $MESH_DIR/restore.env); coverage has no denominator on this node"
    return 0
  fi
  for w in $decl; do
    n_d=$(( n_d + 1 ))
    if src="$(_charter_file "$w")"; then n_ok=$(( n_ok + 1 ))
    else
      n_miss=$(( n_miss + 1 )); miss="${miss:+$miss,}$w"
      echo "charter-MISS $w: declared in MESH_MIND_CHANNELS, no charter in $CHARTER_DIR/ or $CHARTER_GENOME/ — that window wakes with its duties UNDECLARED"
    fi
  done
  echo "charter-census: $n_ok/$n_d charted, $n_miss missing${miss:+ [$miss]}"
  return 0
}

_restore() { # emit THIS window's CHARTER + handoff as SessionStart additionalContext (JSON). No-op if neither.
  local win f content cf charter="" charter_missing=0
  win="$(_this_window)"
  [ -n "$win" ] || exit 0                     # not in tmux / unknown window → nothing to restore
  # CHARTER first (durable instruction for this window). Independent of the handoff: a window with a charter
  # and no handoff still gets its charter, and vice versa — coupling them would leave a fresh window
  # instructionless exactly when it has no thread of its own to reason from.
  if cf="$(_charter_file "$win")"; then
    charter="$(cat "$cf")"
    if [ "${#charter}" -gt "$CHARTER_CAP" ]; then   # LOUD truncation — a silently-clipped instruction is a lie
      charter="${charter:0:$CHARTER_CAP}

[charter TRUNCATED at ${CHARTER_CAP} chars — $cf is over the cap; shorten it or raise MESH_CHARTER_CAP]"
    fi
  elif _charter_owed "$win"; then
    # A MISSING CHARTER IS RENDERED, NOT OMITTED (2026-08-29). This is the read every mind actually
    # takes at SessionStart, and until now a window with no charter got the handoff alone and nothing
    # said so — "this window has no charter" and "its charter had nothing to add" were the SAME
    # rendering in the one place a mind looks. That is how pub, discover, vpn, tg-roz, job, adint,
    # hire and wake ran charterless for weeks with no reader able to name it.
    # The absence is also MASKED, not merely unannounced: --snapshot writes a handoff every 5 minutes,
    # so a charterless window essentially ALWAYS has a handoff, the restore therefore always returns a
    # non-empty context, and the exit-0-on-neither guard below can never be the detector.
    # The sibling --charter path has always been loud (exit 1, both paths named). This makes the quiet
    # read say the same thing, and it names WHERE one would go so the absence is actionable, not just
    # confessed. Not fatal and never a refusal: a lean node or a fresh plant legitimately runs ahead of
    # its charters, and a fresh window is exactly when a mind most needs to be told what it is.
    charter_missing=1
    charter="NO CHARTER FOR THIS WINDOW.

There is a charter tier — durable per-window instruction, restored here at every startup/clear — and
this window ('$win') has no file in it. That is a GAP, not a window that owes nothing: what this
window IS, what routes to it, and what it owes the board are unstated, so treat your duties as
UNDECLARED rather than as none, and prefer asking on the board over inferring them.

Looked in, in order:
  $CHARTER_DIR/$win.md      (node-local override)
  $CHARTER_GENOME/$win.md   (genome default — the one to write; it lands for every node)"
  fi
  f="$(_handoff_file "$win")"
  content=""
  [ -r "$f" ] && content="$(cat "$f")"
  [ -n "$charter$content" ] || exit 0          # neither charter nor handoff → nothing to restore
  # ── EXTENDED-MIND glue condition on the restore READ (live review 2026-07-30, docs/reviews/enactivism-4e-
  #    extended-mind-restore-trust-glue-2026-07-30.md). Clark & Chalmers 1998 "The Extended Mind" (Analysis
  #    58(1):7-19) count an external store as MIND only while it meets the "trust and glue" conditions — the
  #    first being that the resource is reliably-available-AS-CURRENT. Khan & Lipizzi 2026 (arXiv:2607.05690,
  #    parity for LLM-agent memory) locate the failure not in the store but in "the agent's read policy"; the
  #    automatic-endorsement condition is itself critiqued as incompatible with epistemic responsibility, since
  #    "critical scrutiny is itself cognitive" (Trust as the glue of cognitive institutions, doi:10.1080/
  #    09515089.2022.2134767). The mesh's handoff STORE is reliable (durable file); the missing glue is the
  #    READ-side trust policy — the lede endorses the store unconditionally ("This is YOUR thread"). A handoff
  #    written BEFORE this node's last boot is a PRIOR INCARNATION's memory (the file is stale-on-reboot BY
  #    DESIGN and the SessionStart hook fires on `startup` too), so blind endorsement is exactly the failure
  #    the critique names. REPORT-ONLY: still emit the FULL body (never drop memory) — only the lede downgrades
  #    trust so the mind applies scrutiny where the glue condition fails. Unknown write-time OR boot epoch →
  #    keep the full-trust lede (honest-fusion: no false staleness alarm).
  local written wepoch boot lede
  # read the write-time only when a handoff actually exists — a charter-only restore has no $f, and a
  # bare sed on it prints "can't read" to the hook's stderr on every clear (noise that reads as a fault).
  written=""
  [ -r "$f" ] && written="$(sed -n 's/^# written: //p' "$f" | head -1)"
  wepoch="$(date -d "$written" +%s 2>/dev/null || true)"
  boot="$(_boot_epoch)"
  lede="Work-memory handoff restored (mesh-handoff, pre-/clear). This is YOUR thread from before the /clear — resume from it:"
  if [ -n "$wepoch" ] && [ -n "$boot" ] && [ "$wepoch" -lt "$boot" ] 2>/dev/null; then
    lede="Work-memory handoff restored (mesh-handoff) — but it was written $(_ago "$(( $(date +%s) - wepoch ))") ago, BEFORE this node's last boot: it is a PRIOR INCARNATION's thread, not your current one. Treat it as HISTORY TO VERIFY (some of this work may already be landed or abandoned), not live state to resume blind:"
  fi
  # SessionStart hook contract: emit hookSpecificOutput.additionalContext. Build the JSON with python3 so
  # the file content (arbitrary markdown/newlines/quotes) is escaped correctly — never hand-roll JSON escaping.
  MESH_HANDOFF_CONTENT="$content" MESH_HANDOFF_LEDE="$lede" MESH_CHARTER_CONTENT="$charter" \
  MESH_CHARTER_MISSING="$charter_missing" MESH_CHARTER_WINDOW="$win" python3 - <<'PY'
import json, os
body    = os.environ["MESH_HANDOFF_CONTENT"]
lede    = os.environ["MESH_HANDOFF_LEDE"]
charter = os.environ["MESH_CHARTER_CONTENT"]
win     = os.environ["MESH_CHARTER_WINDOW"]
parts = []
if charter.strip():
    # The absence gets its OWN framing. The charter header promises "below is what this window IS",
    # and wrapping a not-found notice in it produces a header that contradicts its own body — the
    # reader has to resolve the contradiction before it can act on either.
    if os.environ.get("MESH_CHARTER_MISSING") == "1":
        parts.append("Charter tier for the `%s` window (mesh-handoff --charter) — MISSING, reported so "
                     "the gap is visible rather than silent:\n\n%s" % (win, charter))
    else:
        parts.append("Charter for the `%s` window (mesh-handoff --charter; durable INSTRUCTION, not work-state: "
                     "this is what this window IS and what it owes, and it does not expire with a /clear). "
                     "Mesh-wide doctrine stays in CLAUDE.md; below is only what is true for THIS window:\n\n%s"
                     % (win, charter))
if body.strip():
    parts.append(lede + "\n\n" + body)
print(json.dumps({"hookSpecificOutput": {"hookEventName": "SessionStart",
                                         "additionalContext": "\n\n---\n\n".join(parts)}}))
PY
}

# ── THE TRANSFER'S PRODUCT: teaching vs transport (live review 2026-08-19, swarm/stigmergy) ──────
# Mizumoto et al., iScience 26:106418 (2023), "Functional and mechanistic diversity in ant tandem
# communication": ONE named behaviour — the tandem run — turns out to be TWO different channels.
# In Temnothorax the follower controls the leader's SPEED (bidirectional flow) and the run's product
# is a new RECRUITER, an ant that goes on to lead the same route. In Diacamma the follower does not
# regulate the leader at all, only keeps close contact: "Diacamma tandem runs lack bidirectional
# information flow, the signature of route-learning", and the run's product is a MOVED BODY, a
# passive nestmate that never leads. Same behaviour, same success rate, different function — the
# authors call it CRYPTIC diversity because the aggregate "did the run complete" cannot see it.
#
# mesh-handoff is written as a teaching channel ("the mind wakes already holding its own thread")
# and gated as a transport one: every guard here — the */5 snapshot, the hollow-guard, the
# no-clobber, mesh-clear's write-succeeded gate — protects against LOSING the body, which is exactly
# what the paper says Diacamma optimises ("prioritises avoiding lost followers over providing
# opportunities for followers to collect spatial information"). Nothing measures whether the
# receiver picked up the ROUTE. --audit is that measure, and it is REPORT-ONLY: it reads the board's
# [handoff] trail and asks, per handoff, whether the same window's LATER lines touch the route the
# handoff named (teaching-shaped) or work with no overlap at all (transport-shaped).
#
# HONEST BOUNDS, published in the output rather than buried: the route set is rebuilt from the
# ≤240-char BOARD body (the durable per-window file is overwritten by the next handoff, so the full
# text of a past handoff no longer exists anywhere). A truncated route set can only LOSE tokens, so
# `route` is a LOWER bound and `transport` an UPPER bound. Missing evidence renders `na`, never
# transport: a window that posted nothing in the stint, and a handoff that named no route at all,
# are both unevaluable — classifying them as transport would fabricate a verdict out of silence.
_audit() { # [--window <w>] [--horizon-h N] [--json]
  local win="" horizon="${MESH_HANDOFF_AUDIT_HORIZON_H:-12}" json=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --window) win="${2:-}"; shift 2 ;;
      --horizon-h) horizon="${2:-12}"; shift 2 ;;
      --json) json=1; shift ;;
      *) echo "mesh-handoff --audit: unknown arg '$1'" >&2; return 2 ;;
    esac
  done
  local logs="${MESH_HANDOFF_AUDIT_LOGS:-$MESH_DIR/chat-overflow.log:$MESH_DIR/chat.log}"
  MESH_AUDIT_LOGS="$logs" MESH_AUDIT_WIN="$win" MESH_AUDIT_HORIZON="$horizon" MESH_AUDIT_JSON="${json:-}" \
  python3 - <<'PY'
import os, re, sys, json as _json, calendar, time

LOGS    = [p for p in os.environ.get("MESH_AUDIT_LOGS","").split(":") if p]
ONLYWIN = os.environ.get("MESH_AUDIT_WIN","") or None
HORIZON = float(os.environ.get("MESH_AUDIT_HORIZON","12") or 12) * 3600.0
AS_JSON = bool(os.environ.get("MESH_AUDIT_JSON",""))

LINE = re.compile(r'^(\S+)\s+(\S+)\s+::\s+(.*)$')
HAND = re.compile(r'^\[handoff\]\s+([A-Za-z0-9_.-]+):\s*(.*)$')

# The transfer MACHINERY names itself in nearly every handoff (a mind writes "handoff written",
# "pre-/clear", "mesh-clear"), so a later line mentioning them shows the CHANNEL was used again, not
# that the ROUTE was picked up. Counting them as route overlap is the vacuity trap: it would make
# every handoff look like teaching by construction. Corpus-frequency guard below catches the rest.
MACHINERY = {"mesh-handoff","mesh-clear","mesh-clear-log","mesh-chat","mesh-tell","mesh-restore",
             "mesh-wip-commit","handoff","pre-clear"}
# A token this common across handoffs carries no routing information (calibrated on the LIVE corpus,
# not a frozen constant — the doctrine's rule against a median pinned in the source).
COMMON_FRAC = float(os.environ.get("MESH_AUDIT_COMMON_FRAC","0.5"))

TOKPATS = [
    re.compile(r'\b(?:scripts|docs|src|tests?)/[A-Za-z0-9._/-]+'),   # repo paths
    re.compile(r'~?/\.?mesh/[A-Za-z0-9._/-]+'),                       # runtime artifacts
    re.compile(r'\bmesh-[a-z0-9-]+\b'),                               # tool names
    re.compile(r'\b[a-z0-9]+(?:-[a-z0-9]+){2,}\b'),                   # kebab slugs (>=3 words)
    re.compile(r'\b[0-9a-f]{7,40}\b'),                                # commit hashes
]

def toks(text):
    out = set()
    for p in TOKPATS:
        for m in p.findall(text or ""):
            t = m.strip().strip('.,;:)(').lower()
            if len(t) >= 5 and t not in MACHINERY:
                out.add(t)
    return out

def epoch(ts):
    try: return calendar.timegm(time.strptime(ts, "%Y-%m-%dT%H:%M:%SZ"))
    except Exception: return None

events, posts = [], []
for path in LOGS:
    try: fh = open(path, "r", errors="replace")
    except OSError: continue
    with fh:
        for raw in fh:
            m = LINE.match(raw.rstrip("\n"))
            if not m: continue
            ts, who, body = m.group(1), m.group(2), m.group(3)
            e = epoch(ts)
            if e is None: continue
            node = who.split("@",1)[1] if "@" in who else ""
            chan = who.split("@",1)[0]
            h = HAND.match(body)
            if h:
                events.append({"t": e, "ts": ts, "win": h.group(1), "node": node, "body": h.group(2)})
            else:
                posts.append({"t": e, "chan": chan, "node": node, "body": body})

events.sort(key=lambda x: x["t"]); posts.sort(key=lambda x: x["t"])

# corpus-frequency stopwords, derived from THIS trail
freq = {}
for ev in events:
    for t in toks(ev["body"]): freq[t] = freq.get(t, 0) + 1
n_ev = len(events) or 1
COMMON = {t for t, c in freq.items() if c / n_ev >= COMMON_FRAC}

rows, agg = [], {"route": 0, "transport": 0, "na": 0}
for i, ev in enumerate(events):
    if ONLYWIN and ev["win"] != ONLYWIN: continue
    # stint = until this window's NEXT handoff (the thread's next leg starts there), capped at HORIZON
    end = ev["t"] + HORIZON
    for nxt in events[i+1:]:
        if nxt["win"] == ev["win"] and nxt["node"] == ev["node"]:
            end = min(end, nxt["t"]); break
    route = toks(ev["body"]) - COMMON
    later = [p for p in posts
             if ev["t"] < p["t"] <= end and p["chan"] == ev["win"] and p["node"] == ev["node"]]
    if not route:
        verdict, why = "na", "no route named in the board body"
    elif not later:
        verdict, why = "na", "window posted nothing in the stint"
    else:
        hit = sorted({t for p in later for t in route if t in p["body"].lower()})
        if hit: verdict, why = "route", "later lines touch: " + ", ".join(hit[:4])
        else:   verdict, why = "transport", "%d later line(s), zero route overlap" % len(later)
    agg[verdict] += 1
    rows.append({"ts": ev["ts"], "win": ev["win"], "node": ev["node"], "verdict": verdict,
                 "route_n": len(route), "later_n": len(later),
                 "stint_s": int(end - ev["t"]), "why": why})

n = sum(agg.values())
if AS_JSON:
    print(_json.dumps({"n": n, "agg": agg, "horizon_h": HORIZON/3600.0,
                       "common_stopwords": sorted(COMMON), "rows": rows}, indent=1))
    sys.exit(0)

for r in rows:
    print("%s  %-10s %-9s route-set=%-2d later=%-2d stint=%s  (%s)" %
          (r["ts"], r["win"], r["verdict"], r["route_n"], r["later_n"],
           ("%dh%02dm" % (r["stint_s"]//3600, (r["stint_s"]%3600)//60)), r["why"]))
if n == 0:
    print("handoff-audit: no [handoff] events in %s%s — na (nothing to score, not 'all transport')"
          % (", ".join(LOGS), (" for window '%s'" % ONLYWIN) if ONLYWIN else ""))
else:
    print("handoff-audit: n=%d route=%d transport=%d na=%d horizon=%gh stopwords=%d"
          % (n, agg["route"], agg["transport"], agg["na"], HORIZON/3600.0, len(COMMON)))
    print("  route is a LOWER bound / transport an UPPER bound: the route set is rebuilt from the "
          "<=240-char BOARD body (the per-window file is overwritten), so tokens can only be LOST.")
    print("  na = unevaluable (no route named, or no later line in the stint) — never counted as transport.")
PY
}

_test() {
  local td rc=0
  td="$(mktemp -d)" || { echo "handoff-test: FAIL (mktemp)"; exit 1; }
  # Isolate every artifact into the sandbox — never touch the real chat.log/handoff dir. NOTE: the
  # module-level globals (MESH_DIR/HANDOFF_DIR/SESSION) were bound at load, BEFORE this export — exporting
  # alone leaves the functions reading the REAL dirs. Reassign the globals too, or the test pollutes ~/.mesh.
  export MESH_DIR="$td/mesh" MESH_HANDOFF_DIR="$td/mesh/handoff"
  MESH_DIR="$td/mesh"; HANDOFF_DIR="$td/mesh/handoff"; SESSION="__no_such_session__"
  mkdir -p "$MESH_DIR" "$HANDOFF_DIR"
  local win="test-handoff-win"
  local marker="ROUNDTRIP-$$-do-not-see-this-in-two-places"
  local state="done: wired X ($marker)
next: run Y then land Z
paths: scripts/foo, ~/.mesh/bar.log"

  # 1) WRITE (pre-clear). Force the raw-append path (no mesh-chat in a sandbox PATH) so we assert THIS tool's
  #    own chat-line format, not mesh-chat's — a real round-trip, not a stub.
  local f
  f="$(PATH=/usr/bin:/bin MESH_HANDOFF_TEST_WINDOW="$win" _write_handoff "$win" "$state")"
  [ -f "$f" ] || { echo "handoff-test: FAIL (no durable file written)"; rc=1; }
  grep -q "$marker" "$f" 2>/dev/null || { echo "handoff-test: FAIL (durable file missing the state marker)"; rc=1; }
  # the file must carry the FULL multi-line state, not a truncated one-liner
  grep -q '^next: run Y then land Z$' "$f" 2>/dev/null || { echo "handoff-test: FAIL (durable file dropped a state line)"; rc=1; }

  # 2) the [handoff] BOARD line landed in chat.log, one line, carrying the marker
  local cl="$MESH_DIR/chat.log"
  grep -q '\[handoff\]' "$cl" 2>/dev/null || { echo "handoff-test: FAIL (no [handoff] board line in chat.log)"; rc=1; }
  grep '\[handoff\]' "$cl" 2>/dev/null | grep -q "$marker" || { echo "handoff-test: FAIL ([handoff] line missing the state marker)"; rc=1; }
  [ "$(grep -c '\[handoff\]' "$cl" 2>/dev/null)" = 1 ] || { echo "handoff-test: FAIL ([handoff] must be exactly one board line)"; rc=1; }

  # 3) SIMULATE CLEAR + RESTORE: a fresh process (no prior context) resolves the same window and the hook
  #    output must carry the SAME state — the marker AND every state line — inside additionalContext.
  local restored
  restored="$(MESH_HANDOFF_TEST_WINDOW="$win" _restore)"
  printf '%s' "$restored" | python3 -c 'import json,sys; d=json.load(sys.stdin); print(d["hookSpecificOutput"]["additionalContext"])' >/dev/null 2>&1 \
    || { echo "handoff-test: FAIL (restore did not emit valid SessionStart additionalContext JSON)"; rc=1; }
  local ctx
  ctx="$(printf '%s' "$restored" | python3 -c 'import json,sys; print(json.load(sys.stdin)["hookSpecificOutput"]["additionalContext"])' 2>/dev/null)"
  printf '%s' "$ctx" | grep -q "$marker" || { echo "handoff-test: FAIL (restored context missing the state marker — hook would wake blind)"; rc=1; }
  printf '%s' "$ctx" | grep -q 'paths: scripts/foo' || { echo "handoff-test: FAIL (restored context dropped a state line — not the SAME state)"; rc=1; }

  # 4) RED-guard the isolation: a window with NO stored handoff must restore NOTHING (empty), never another
  #    window's state — else a fresh mind wakes holding a stranger's thread.
  local empty
  empty="$(MESH_HANDOFF_TEST_WINDOW="no-such-window-$$" _restore)"
  [ -z "$empty" ] || { echo "handoff-test: FAIL (restore of an unknown window must be empty, got: $empty)"; rc=1; }

  # ══ P2: SNAPSHOT (cooperation-free crash safety net) ══
  # (P2a) scrollback with work-state + NO manual handoff → --snapshot writes an EXTRACTIVE auto handoff that
  #        carries a VERBATIM signal line, and --restore carries it forward.
  local sw="snapwin"
  printf 'ran: bash scripts/mesh-wip-commit --test\n[done] genome/wip-commit: 59e51e0\nedited scripts/mesh-handoff\nMARKER-%s some prose line\n' "$$" > "$td/scroll.txt"
  MESH_HANDOFF_SNAPSHOT_SCROLL_CMD="cat $td/scroll.txt" _snapshot_one "$sw"; [ "$?" = 0 ] || { echo "handoff-test: FAIL (snapshot with work-state + no manual handoff did not write)"; rc=1; }
  local sf; sf="$(_handoff_file "$sw")"
  grep -q '^# source: auto-snapshot$' "$sf" 2>/dev/null || { echo "handoff-test: FAIL (snapshot not marked # source: auto-snapshot)"; rc=1; }
  grep -q 'scripts/mesh-handoff' "$sf" 2>/dev/null || { echo "handoff-test: FAIL (snapshot dropped a VERBATIM signal line from scrollback)"; rc=1; }
  # the invented-next-step guard: the prose line with no path/command MUST NOT appear (extract is signal-only)
  grep -q "MARKER-$$ some prose" "$sf" 2>/dev/null && { echo "handoff-test: FAIL (snapshot kept a non-signal prose line — extract is not verbatim-signal)"; rc=1; }
  local sr src_ctx
  sr="$(MESH_HANDOFF_TEST_WINDOW="$sw" _restore)"
  src_ctx="$(printf '%s' "$sr" | python3 -c 'import json,sys; print(json.load(sys.stdin)["hookSpecificOutput"]["additionalContext"])' 2>/dev/null)"
  printf '%s' "$src_ctx" | grep -q 'scripts/mesh-handoff' || { echo "handoff-test: FAIL (restore did not carry the snapshot)"; rc=1; }

  # (P2b) a still-FRESH MANUAL handoff is NOT clobbered by --snapshot (manual tier is richer).
  local kw="keepwin"
  PATH=/usr/bin:/bin MESH_HANDOFF_TEST_WINDOW="$kw" _write_handoff "$kw" "MANUAL-RICH-$$ keep me" >/dev/null
  MESH_HANDOFF_SNAPSHOT_SCROLL_CMD="cat $td/scroll.txt" _snapshot_one "$kw"; [ "$?" = 4 ] || { echo "handoff-test: FAIL (snapshot did not report kept-manual rc=4 for a fresh manual handoff)"; rc=1; }
  grep -q "MANUAL-RICH-$$" "$(_handoff_file "$kw")" 2>/dev/null || { echo "handoff-test: FAIL (snapshot CLOBBERED a fresh manual handoff)"; rc=1; }
  grep -q '^# source: auto-snapshot$' "$(_handoff_file "$kw")" 2>/dev/null && { echo "handoff-test: FAIL (fresh manual handoff was overwritten by an auto snapshot)"; rc=1; }

  # (P2c) ANTI-BLOAT: a 100× scrollback must produce a body under the cap — the restored additionalContext
  #        cannot re-bloat the session it feeds. (operator: "no death NOR bloat".)
  local bw="bigwin" savecap="$SNAP_CAP"; SNAP_CAP=500
  yes "scripts/mesh-padding-line-$$-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx" | head -5000 > "$td/big.txt"
  MESH_HANDOFF_SNAPSHOT_SCROLL_CMD="cat $td/big.txt" MESH_HANDOFF_SNAPSHOT_LINES=9999 _snapshot_one "$bw"
  local bf blen; bf="$(_handoff_file "$bw")"
  blen="$(awk 'f;/^$/{f=1}' "$bf" | wc -c)"            # body = everything after the first blank line
  [ "$blen" -le "$((SNAP_CAP + 120))" ] || { echo "handoff-test: FAIL (snapshot body $blen exceeds cap $SNAP_CAP from a 100× scrollback — re-bloat)"; rc=1; }
  grep -q 'snapshot capped at' "$bf" 2>/dev/null || { echo "handoff-test: FAIL (over-cap snapshot missing the truncation marker)"; rc=1; }
  # the recovery pointer (summary) is placed FIRST → it must survive even a cap that truncates the bulk
  grep -q '^wip:' "$bf" 2>/dev/null || { echo "handoff-test: FAIL (cap dropped the wip recovery pointer — it must lead the body)"; rc=1; }
  SNAP_CAP="$savecap"

  # (P2e) THE /clear-CLOBBER BUG (2026-07-18): a pane captured right after /clear shows only prompt-furniture —
  #        the multi-line-prompt decoration, the `❯ /clear` command, and the statusline. NONE is work-state.
  #        (i) the extract must be HOLLOW (furniture stripped, not carried as signal); (ii) a hollow snapshot
  #        must NOT clobber an existing handoff (rc 6, prior content preserved). Drive the REAL post-/clear pane.
  local cw="clearwin"
  # write a rich prior auto-snapshot first (real work-state), then re-snapshot a just-cleared pane over it
  printf 'edited scripts/mesh-handoff\n[done] tg/hollow-guard: pending\nnext: land the /clear-clobber fix\n' > "$td/rich.txt"
  MESH_HANDOFF_SNAPSHOT_SCROLL_CMD="cat $td/rich.txt" _snapshot_one "$cw"; [ "$?" = 0 ] || { echo "handoff-test: FAIL (P2e setup: rich snapshot did not write)"; rc=1; }
  # a real post-/clear pane: 3 furniture lines and nothing else
  printf '  \342\226\230\342\226\230 \342\226\235\342\226\235    ~/lte-workstation\n\342\235\257 /clear\n  mesh-home@mesh-home:/home/mesh-home/x | Op4.8:hg | \342\247\211 tg | \342\226\221\342\226\221\342\226\221 | 5h:23%%(59m) | $0.00 | load 10.5 | 09:51\n' > "$td/cleared.txt"
  local hollow; hollow="$(_extract_terse < "$td/cleared.txt")"
  [ -z "$hollow" ] || { echo "handoff-test: FAIL (P2e: post-/clear furniture extracted as work-state, not stripped: [$hollow])"; rc=1; }
  MESH_HANDOFF_SNAPSHOT_SCROLL_CMD="cat $td/cleared.txt" _snapshot_one "$cw"; [ "$?" = 6 ] || { echo "handoff-test: FAIL (P2e: hollow post-/clear snapshot did not report kept-prior rc=6)"; rc=1; }
  grep -q 'next: land the /clear-clobber fix' "$(_handoff_file "$cw")" 2>/dev/null || { echo "handoff-test: FAIL (P2e: hollow snapshot CLOBBERED the rich prior handoff — the operator's bug)"; rc=1; }
  grep -q '/clear' "$(_handoff_file "$cw")" 2>/dev/null && ! grep -q 'clear-clobber' "$(_handoff_file "$cw")" 2>/dev/null && { echo "handoff-test: FAIL (P2e: the /clear command line leaked into the handoff)"; rc=1; }

  # (P2d) THIS TOOL IS THE CLEAR'S SAFETY NET — the coupling, restated after the 2026-07-24 simplification.
  #        mesh-clear no longer JUDGES a handoff (the model/coverage/freshness gate is gone, operator
  #        direction); it WRITES one by calling `mesh-handoff --snapshot` and then clears. So the property
  #        to hold here is the inverse of the old one: the snapshot must not be second-guessed — a real
  #        mesh-clear run over a fresh auto snapshot must proceed, naming THIS tool as the writer it will
  #        invoke, and must not resurrect a coverage/staleness verdict. (That the writer is actually
  #        CALLED before the /clear is asserted in mesh-clear's own --test, on the live path.)
  local mc; mc="$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")/mesh-clear"
  [ -x "$mc" ] || mc="$(command -v mesh-clear 2>/dev/null || true)"
  if [ -n "$mc" ] && [ -r "$mc" ]; then
    local vdry
    # mesh-clear prints refusals to STDERR — capture 2>&1 or a block reads as empty and assertions mis-fire.
    vdry="$(MESH_HANDOFF_DIR="$HANDOFF_DIR" MESH_CLEAR_SESSION=__none__ bash "$mc" "$sw" --dry-run 2>&1)"
    printf '%s' "$vdry" | grep -q 'mesh-handoff --snapshot' || { echo "handoff-test: FAIL (mesh-clear does not name mesh-handoff --snapshot as its writer — the safety net is not wired: $vdry)"; rc=1; }
    printf '%s' "$vdry" | grep -qiE 'coverage|stale|BLOCK' && { echo "handoff-test: FAIL (a coverage/staleness verdict is back in mesh-clear's path: $vdry)"; rc=1; }
  else
    echo "handoff-test: NOTE — mesh-clear not resolvable; skipped the writer-coupling check"
  fi

  # ── (P2f) wip-summary branches on the LANDED predicate (task wip-ref-stale-after-landing 2026-07-21).
  #    The predicate itself lives in mesh-wip-commit (its own --test drives it on real repos); THIS
  #    tool's contract is the branching on the rc — driven with a stub so each branch is forced.
  local wr="$td/wrepo" stubbin="$td/stubbin" s
  git init -q "$wr" 2>/dev/null; git -C "$wr" config user.email t@t; git -C "$wr" config user.name t
  ( cd -- "${wr:?empty path — refusing to cd into $PWD (fixture would write into the live repo)}" && echo a > f.txt && git add -A && git commit -qm base ) >/dev/null 2>&1
  git -C "$wr" update-ref refs/wip/wsumwin "$(git -C "$wr" rev-parse HEAD)"
  mkdir -p "$stubbin"
  printf '#!/bin/sh\nexit 0\n' > "$stubbin/mesh-wip-commit"; chmod +x "$stubbin/mesh-wip-commit"
  s="$(PATH="$stubbin:/usr/bin:/bin" _git_wip_summary wsumwin "$wr")"
  printf '%s' "$s" | grep -q 'already landed' || { echo "handoff-test: FAIL (P2f: clean+landed ref must read 'already landed', got: $s)"; rc=1; }
  printf '%s' "$s" | grep -q 'recover:' && { echo "handoff-test: FAIL (P2f: landed ref still advertises the stale recover pointer: $s)"; rc=1; }
  printf '#!/bin/sh\nexit 1\n' > "$stubbin/mesh-wip-commit"
  s="$(PATH="$stubbin:/usr/bin:/bin" _git_wip_summary wsumwin "$wr")"
  printf '%s' "$s" | grep -q 'UNLANDED' || { echo "handoff-test: FAIL (P2f: clean+unlanded ref must warn UNLANDED/lost work, got: $s)"; rc=1; }
  printf '%s' "$s" | grep -q "recover: mesh-wip-commit --restore wsumwin" || { echo "handoff-test: FAIL (P2f: unlanded ref lost its recover pointer: $s)"; rc=1; }
  # dirty tree: the plain parked-pointer line, predicate not consulted (stub would say landed)
  echo b >> "$wr/f.txt"
  printf '#!/bin/sh\nexit 0\n' > "$stubbin/mesh-wip-commit"
  s="$(PATH="$stubbin:/usr/bin:/bin" _git_wip_summary wsumwin "$wr")"
  printf '%s' "$s" | grep -q 'dirty file(s); uncommitted work parked' || { echo "handoff-test: FAIL (P2f: dirty tree must keep the parked-pointer line, got: $s)"; rc=1; }
  # tool absent: conservative old pointer line (no crash, no landed claim)
  git -C "$wr" checkout -q -- f.txt
  s="$(PATH=/usr/bin:/bin _git_wip_summary wsumwin "$wr")"
  printf '%s' "$s" | grep -q 'refs/wip/wsumwin' || { echo "handoff-test: FAIL (P2f: tool-absent fallback lost the ref pointer, got: $s)"; rc=1; }
  printf '%s' "$s" | grep -q 'already landed' && { echo "handoff-test: FAIL (P2f: tool-absent fallback CLAIMED landed without evidence: $s)"; rc=1; }

  # ══ P3: EXTENDED-MIND glue condition on the restore READ (live review 2026-07-30) ══
  # The restore LEDE must DOWNGRADE trust when the handoff predates this node's last boot (a prior
  # incarnation's memory) and KEEP full endorsement when it is from this incarnation. Report-only: the
  # work-state BODY is emitted either way — only the trust framing changes.
  local iw="incarnwin" now; now="$(date +%s)"
  PATH=/usr/bin:/bin MESH_HANDOFF_TEST_WINDOW="$iw" _write_handoff "$iw" "PRIOR-STATE-$$ verify me" >/dev/null
  # (P3a) written BEFORE the mocked boot → PRIOR-INCARNATION lede, NOT the full-trust one, body preserved.
  local stale_ctx
  stale_ctx="$(MESH_HANDOFF_TEST_WINDOW="$iw" MESH_HANDOFF_BOOT_EPOCH="$((now + 60))" _restore \
                | python3 -c 'import json,sys; print(json.load(sys.stdin)["hookSpecificOutput"]["additionalContext"])' 2>/dev/null)"
  printf '%s' "$stale_ctx" | grep -qi 'PRIOR INCARNATION' || { echo "handoff-test: FAIL (P3a: pre-boot handoff not flagged prior-incarnation — restore trust glue is blind)"; rc=1; }
  printf '%s' "$stale_ctx" | grep -q 'This is YOUR thread from before the /clear' && { echo "handoff-test: FAIL (P3a: pre-boot handoff still gets the full-trust lede — automatic endorsement of a stale store)"; rc=1; }
  printf '%s' "$stale_ctx" | grep -q 'PRIOR-STATE' || { echo "handoff-test: FAIL (P3a: report-only violated — the work-state body was dropped, not just reframed)"; rc=1; }
  # (P3b) written AFTER the mocked boot (THIS incarnation) → full-trust lede unchanged, no false alarm.
  local fresh_ctx
  fresh_ctx="$(MESH_HANDOFF_TEST_WINDOW="$iw" MESH_HANDOFF_BOOT_EPOCH="$((now - 3600))" _restore \
                | python3 -c 'import json,sys; print(json.load(sys.stdin)["hookSpecificOutput"]["additionalContext"])' 2>/dev/null)"
  printf '%s' "$fresh_ctx" | grep -q 'This is YOUR thread from before the /clear' || { echo "handoff-test: FAIL (P3b: same-incarnation handoff lost the full-trust lede — false staleness alarm)"; rc=1; }
  printf '%s' "$fresh_ctx" | grep -qi 'PRIOR INCARNATION' && { echo "handoff-test: FAIL (P3b: same-incarnation handoff wrongly flagged prior-incarnation)"; rc=1; }

  # ══ P4: --audit — the transfer's PRODUCT, teaching vs transport (live review 2026-08-19) ══
  # Every leg here is a CLASSIFICATION on a synthetic board trail; each was seen RED under its own
  # mutant (see docs/reviews/swarm-tandem-run-teaching-vs-transport-handoff-2026-08-19.md).
  local alog="$td/audit-chat.log"
  cat > "$alog" <<'AUDITFIX'
2026-01-01T00:00:00Z  genome@testnode  ::  [handoff] rwin: next is scripts/mesh-foobar
2026-01-01T00:10:00Z  rwin@testnode  ::  [done] fixed scripts/mesh-foobar
2026-01-01T01:00:00Z  genome@testnode  ::  [handoff] twin: next is scripts/mesh-quuxbar
2026-01-01T01:10:00Z  twin@testnode  ::  [done] wrote a limerick
2026-01-01T02:00:00Z  genome@testnode  ::  [handoff] nwin: next is scripts/mesh-lonelytool
2026-01-01T03:00:00Z  genome@testnode  ::  [handoff] pwin: did some things and will do more
2026-01-01T03:10:00Z  pwin@testnode  ::  [done] ok
2026-01-01T04:00:00Z  genome@testnode  ::  [handoff] mwin: wrote via mesh-handoff pre-clear; next is scripts/mesh-machinerytarget
2026-01-01T04:10:00Z  mwin@testnode  ::  [done] ran mesh-handoff and mesh-clear again
2026-01-01T05:00:00Z  genome@testnode  ::  [handoff] hwin: next is scripts/mesh-horizontool
2026-01-01T05:10:00Z  hwin@testnode  ::  [done] something else
2026-01-01T18:00:00Z  hwin@testnode  ::  [done] touched scripts/mesh-horizontool
2026-01-01T06:00:00Z  genome@testnode  ::  [handoff] swin: next is scripts/mesh-stinttool
2026-01-01T06:10:00Z  swin@testnode  ::  [done] something else
2026-01-01T07:00:00Z  genome@testnode  ::  [handoff] swin: now a different leg
2026-01-01T08:00:00Z  swin@testnode  ::  [done] touched scripts/mesh-stinttool
AUDITFIX
  local ajson
  ajson="$(MESH_HANDOFF_AUDIT_LOGS="$alog" _audit --horizon-h 12 --json 2>/dev/null)"
  local averd
  averd="$(printf '%s' "$ajson" | python3 -c '
import json,sys
d=json.load(sys.stdin)
seen={}
for r in d["rows"]:
    seen.setdefault(r["win"],[]).append(r["verdict"])
a=d["agg"]
print(" ".join("%s=%s"%(k,",".join(v)) for k,v in sorted(seen.items())),
      "| n=%d route=%d transport=%d na=%d"%(d["n"],a["route"],a["transport"],a["na"]))
' 2>/dev/null)"
  # (P4a) the positive: a receiver whose later lines touch the named route is TEACHING-shaped.
  case "$averd" in *"rwin=route"*) :;; *) echo "handoff-test: FAIL (P4a: route overlap not detected — got: $averd)"; rc=1;; esac
  # (P4b) the negative that carries the whole finding: the receiver WORKED, but on nothing the
  #       handoff named. Aggregate liveness ("did the window post?") cannot see this — that IS the
  #       cryptic-diversity point. Mutant: count any later line as overlap → rwin/twin both 'route'.
  case "$averd" in *"twin=transport"*) :;; *) echo "handoff-test: FAIL (P4b: a receiver with ZERO route overlap was not called transport — got: $averd)"; rc=1;; esac
  # (P4c) missing evidence renders na, never transport. Mutant: fold the no-later branch into
  #       transport → nwin=transport, i.e. silence fabricated into a verdict.
  case "$averd" in *"nwin=na"*) :;; *) echo "handoff-test: FAIL (P4c: a handoff with NO later line was scored, not rendered na — got: $averd)"; rc=1;; esac
  # (P4d) a handoff that named no route at all is unevaluable — scoring it would grade the WRITER's
  #       vagueness as the READER's failure. Mutant: drop the empty-route branch → pwin=transport.
  case "$averd" in *"pwin=na"*) :;; *) echo "handoff-test: FAIL (P4d: a handoff naming no route was scored anyway — got: $averd)"; rc=1;; esac
  # (P4e) THE VACUITY GATE: the transfer machinery names itself in nearly every handoff, so if
  #       mesh-handoff/mesh-clear counted as route tokens every transfer would read as teaching by
  #       construction. Mutant: empty the MACHINERY set → mwin flips to 'route'.
  case "$averd" in *"mwin=transport"*) :;; *) echo "handoff-test: FAIL (P4e: the handoff MACHINERY's own name counted as route overlap — the gate is vacuous — got: $averd)"; rc=1;; esac
  # (P4f) the horizon binds: a route touch 13h later is not this stint's product. Mutant: raise the
  #       horizon past 13h → hwin=route.
  case "$averd" in *"hwin=transport"*) :;; *) echo "handoff-test: FAIL (P4f: an out-of-horizon route touch was credited to the handoff — got: $averd)"; rc=1;; esac
  # (P4g) the stint ends at the window's NEXT handoff — work after it belongs to the next leg.
  #       Mutant: drop the next-handoff clamp → swin's first leg reads 'route' off the 08:00 line.
  case "$averd" in *"swin=transport,na"*) :;; *) echo "handoff-test: FAIL (P4g: the stint did not end at the next handoff — got: $averd)"; rc=1;; esac
  # (P4h) the aggregate is the fixture's own arithmetic, not a shape-check on the text.
  case "$averd" in *"n=8 route=1 transport=4 na=3"*) :;; *) echo "handoff-test: FAIL (P4h: aggregate does not match the fixture (want n=8 route=1 transport=4 na=3) — got: $averd)"; rc=1;; esac
  # (P4i) an EMPTY trail renders na, never '0 route / all transport'.
  : > "$td/audit-empty.log"
  local aempty; aempty="$(MESH_HANDOFF_AUDIT_LOGS="$td/audit-empty.log" _audit 2>/dev/null)"
  printf '%s' "$aempty" | grep -q 'na (nothing to score' || { echo "handoff-test: FAIL (P4i: empty trail did not render na — got: $aempty)"; rc=1; }
  printf '%s' "$aempty" | grep -qE 'route=[0-9]+ transport=' && { echo "handoff-test: FAIL (P4i: empty trail printed an aggregate verdict)"; rc=1; }

  # ── (P5) THE CHARTER LEG (board task {#943287f7}): the SessionStart hook lays the window's durable
  #    INSTRUCTION under its work-state. Every assertion below was seen RED by breaking the code first.
  local _cd_save="$CHARTER_DIR" _cg_save="$CHARTER_GENOME"
  mkdir -p "$td/charter-local" "$td/charter-genome"
  CHARTER_DIR="$td/charter-local"; CHARTER_GENOME="$td/charter-genome"
  printf '# testwin charter\nGENOME TIER MARKER\n' > "$td/charter-genome/chartwin.md"
  # (P5a) a window with a charter and NO handoff still gets its charter. Mutant: gate the charter read on
  #       the handoff existing → a fresh window wakes instructionless, which is the whole point of a charter.
  local c_only
  c_only="$(MESH_HANDOFF_TEST_WINDOW=chartwin HANDOFF_DIR="$td/no-handoffs" _restore 2>/dev/null)"
  printf '%s' "$c_only" | grep -q 'GENOME TIER MARKER' \
    || { echo "handoff-test: FAIL (P5a: charter not restored for a window with no handoff)"; rc=1; }
  # (P5b) charter and handoff BOTH render, charter FIRST — the instruction frames the work-state, not the
  #       reverse. Mutant: append the charter after the handoff → the order assertion goes red.
  _write_handoff chartwin "chartwin state line" >/dev/null 2>&1
  local c_both
  c_both="$(MESH_HANDOFF_TEST_WINDOW=chartwin _restore 2>/dev/null)"
  printf '%s' "$c_both" | grep -q 'GENOME TIER MARKER' && printf '%s' "$c_both" | grep -q 'chartwin state line' \
    || { echo "handoff-test: FAIL (P5b: charter+handoff restore dropped one of the two)"; rc=1; }
  MESH_CH_BOTH="$c_both" python3 -c 'import json,os,sys; c=json.loads(os.environ["MESH_CH_BOTH"])["hookSpecificOutput"]["additionalContext"]; sys.exit(0 if c.index("GENOME TIER MARKER") < c.index("chartwin state line") else 1)' \
    || { echo "handoff-test: FAIL (P5b: handoff rendered BEFORE the charter)"; rc=1; }
  # (P5c) a node-local charter OVERRIDES the genome default — a node must be able to say something
  #       different. Mutant: reverse the search order → the genome marker wins and this goes red.
  printf 'LOCAL TIER MARKER\n' > "$td/charter-local/chartwin.md"
  printf '%s' "$(_charter_file chartwin)" | grep -q 'charter-local' \
    || { echo "handoff-test: FAIL (P5c: genome charter shadowed the node-local override)"; rc=1; }
  # (P5d) an over-cap charter truncates LOUDLY. Mutant: drop the marker (a bare "${charter:0:$CAP}") and a
  #       clipped instruction reads as the whole instruction — the silent-fallback shape applied to doctrine.
  local _cap_save="$CHARTER_CAP"; CHARTER_CAP=200
  head -c 900 /dev/zero | tr '\0' 'x' > "$td/charter-local/chartwin.md"
  printf '%s' "$(MESH_HANDOFF_TEST_WINDOW=chartwin _restore 2>/dev/null)" | grep -q 'charter TRUNCATED at 200 chars' \
    || { echo "handoff-test: FAIL (P5d: an over-cap charter was clipped SILENTLY)"; rc=1; }
  CHARTER_CAP="$_cap_save"; CHARTER_DIR="$_cd_save"; CHARTER_GENOME="$_cg_save"
  rm -f "$(_handoff_file chartwin)"

  # ── P6: A MISSING CHARTER IS RENDERED, AND COVERAGE HAS A DENOMINATOR (2026-08-29) ────────────
  # The restore is the read every mind takes, and it used to emit the handoff alone when no charter
  # resolved — so "no charter" and "charter had nothing to add" were one rendering. P5 above proves
  # the charter arrives when it EXISTS; nothing proved what happens when it does not, which is why
  # eight charterless windows were invisible to every reader for weeks.
  local _cd6="$CHARTER_DIR" _cg6="$CHARTER_GENOME" _out6
  CHARTER_DIR="$td/no-charter-a"; CHARTER_GENOME="$td/no-charter-b"
  # subshell + explicit declaration: a var set as a prefix to a FUNCTION call can persist into the
  # rest of the suite in bash, which would silently re-declare the channel set for every later arm.
  _out6="$(MESH_HANDOFF_TEST_WINDOW=chartless MESH_MIND_CHANNELS="chartless" _restore 2>/dev/null)"
  printf '%s' "$_out6" | grep -q 'NO CHARTER FOR THIS WINDOW' \
    || { echo "handoff-test: FAIL (P6a: a window with no charter got a SILENT restore — the gap and a charter with nothing to add render identically)"; rc=1; }
  # it must name WHERE one would go, or the absence is confessed but not actionable
  printf '%s' "$_out6" | grep -q "$CHARTER_GENOME/chartless.md" \
    || { echo "handoff-test: FAIL (P6b: the absence does not name the path a charter would be written to)"; rc=1; }
  # and it must NOT wear the header that promises a charter follows — a header contradicting its own
  # body makes the reader resolve the contradiction before it can act on either.
  printf '%s' "$_out6" | grep -q 'MISSING, reported so' \
    || { echo "handoff-test: FAIL (P6c: the absence is framed as if it were a charter)"; rc=1; }
  # …and a window NOTHING declares is owed no charter, so it must stay SILENT. Without this the
  # absence notice fires on every pane that was never a mind channel, and an alarm that fires on
  # things it was never about stops being read — the opposite failure, same cost.
  local _out6u
  _out6u="$(MESH_HANDOFF_TEST_WINDOW=chartless MESH_MIND_CHANNELS="genome pub" _restore 2>/dev/null)"
  printf '%s' "$_out6u" | grep -q 'NO CHARTER FOR THIS WINDOW' \
    && { echo "handoff-test: FAIL (P6a2: an UNDECLARED window was told it is missing a charter it is not owed)"; rc=1; }
  CHARTER_DIR="$_cd6"; CHARTER_GENOME="$_cg6"
  rm -f "$(_handoff_file chartless)"

  # ── P7: THE GOAL LINE IS NEVER BLANK, AND AN UNDECLARED GOAL SAYS SO (2026-08-29, {#97112188}) ──
  # The audit of 322 operator messages found his job deadline written in NO file: it lived in the
  # context of the window that heard it and every /clear erased it. The remedy only works if the
  # ABSENCE is as loud as the value — a blank first row in a data pane reads exactly like a window
  # with nothing to do, which is the confusion this whole line exists to remove. So every arm here
  # asserts non-empty output FIRST, then what it says.
  local _cd7="$CHARTER_DIR" _cg7="$CHARTER_GENOME" _g7
  CHARTER_DIR="$td/goal-local"; CHARTER_GENOME="$td/goal-genome"; mkdir -p "$CHARTER_DIR" "$CHARTER_GENOME"
  # (P7a) no charter at all → an explicit undeclared line naming BOTH paths looked in, never empty.
  _g7="$(_goal_line ghostwin)"
  [ -n "$_g7" ] || { echo "handoff-test: FAIL (P7a: a window with no charter produced an EMPTY goal line — a blank first pane row is the exact failure this closes)"; rc=1; }
  printf '%s' "$_g7" | grep -q 'ЦЕЛЬ НЕ ОБЪЯВЛЕНА' \
    || { echo "handoff-test: FAIL (P7a: no charter did not render an explicit undeclared goal: $_g7)"; rc=1; }
  printf '%s' "$_g7" | grep -q "$CHARTER_GENOME/ghostwin.md" \
    || { echo "handoff-test: FAIL (P7a: the absence does not name where a charter would go: $_g7)"; rc=1; }
  # (P7b) a charter that exists but declares NO goal is a DIFFERENT absence and must not borrow the
  #       other's words — the remedy differs (write the file vs add one line to it).
  printf '# gwin\n\nsome prose but no declared goal\n' > "$CHARTER_GENOME/gwin.md"
  _g7="$(_goal_line gwin)"
  [ -n "$_g7" ] || { echo "handoff-test: FAIL (P7b: a charter with no goal: produced an EMPTY line)"; rc=1; }
  printf '%s' "$_g7" | grep -q "$CHARTER_GENOME/gwin.md есть, но не содержит" \
    || { echo "handoff-test: FAIL (P7b: a charter with no goal: must say the file exists and lacks the line: $_g7)"; rc=1; }
  # (P7c) a declared goal renders, and a declared DEADLINE renders a DERIVED countdown. Derived, never
  #       stored: a stored "N days left" is wrong by morning. Dates are generated relative to today so
  #       the arm cannot rot into a permanent OVERDUE the way a hardcoded date would.
  { printf '# gwin2\n'; printf 'goal: THE DECLARED GOAL\n'; printf 'deadline: %s\n' "$(date -d '+3 days' +%F)";
    printf 'progress: echo THE MEASURED PROGRESS\n'; } > "$CHARTER_GENOME/gwin2.md"
  _g7="$(_goal_line gwin2)"
  printf '%s' "$_g7" | grep -q 'ЦЕЛЬ \[gwin2\]: THE DECLARED GOAL' \
    || { echo "handoff-test: FAIL (P7c: a declared goal did not render: $_g7)"; rc=1; }
  printf '%s' "$_g7" | grep -q 'осталось 3 дн' \
    || { echo "handoff-test: FAIL (P7c: the deadline countdown is not derived from today — a deadline without a countdown is read, not acted on: $_g7)"; rc=1; }
  printf '%s' "$_g7" | grep -q 'ПРОГРЕСС: THE MEASURED PROGRESS' \
    || { echo "handoff-test: FAIL (P7c: the declared progress command's output did not reach the line: $_g7)"; rc=1; }
  # (P7d) a PAST deadline is overdue, not a negative countdown — the two read oppositely to a human.
  { printf '# gwin3\ngoal: G\n'; printf 'deadline: %s\n' "$(date -d '-2 days' +%F)"; } > "$CHARTER_GENOME/gwin3.md"
  printf '%s' "$(_goal_line gwin3)" | grep -q 'ПРОСРОЧЕН на 2 дн' \
    || { echo "handoff-test: FAIL (P7d: a past deadline must read as OVERDUE by N days: $(_goal_line gwin3))"; rc=1; }
  # (P7e) A FAILING PROGRESS COMMAND IS LOUD. This is the live case the day it shipped: job's charter
  #       names mesh-job-funnel, which did not exist yet, and rc=127 had to be VISIBLE rather than
  #       silently rendering nothing. A progress that fails quietly is a metric that reads as zero.
  printf '# gwin4\ngoal: G\nprogress: definitely-no-such-command-12345\n' > "$CHARTER_GENOME/gwin4.md"
  _g7="$(_goal_line gwin4)"
  printf '%s' "$_g7" | grep -q 'ПРОГРЕСС: НЕ ИЗМЕРЕН' \
    || { echo "handoff-test: FAIL (P7e: a progress command that fails must say so, never render blank: $_g7)"; rc=1; }
  printf '%s' "$_g7" | grep -q 'definitely-no-such-command-12345' \
    || { echo "handoff-test: FAIL (P7e: the failure does not name the command that failed, so it is not actionable: $_g7)"; rc=1; }
  # (P7f) a goal with NO progress: declared is a third distinct absence, and it names the exact line
  #       to add. Never silence, never a fabricated metric standing in for an undeclared one.
  printf '# gwin5\ngoal: G\n' > "$CHARTER_GENOME/gwin5.md"
  printf '%s' "$(_goal_line gwin5)" | grep -q 'ПРОГРЕСС: не объявлен' \
    || { echo "handoff-test: FAIL (P7f: an undeclared progress must be named as undeclared: $(_goal_line gwin5))"; rc=1; }
  # (P7g) rc is ALWAYS 0 — a data pane calling this must never lose its first row to an exit status.
  _goal_line ghostwin >/dev/null 2>&1 \
    || { echo "handoff-test: FAIL (P7g: _goal_line returned non-zero; a pane would render nothing)"; rc=1; }
  CHARTER_DIR="$_cd7"; CHARTER_GENOME="$_cg7"

  # COVERAGE: the census must COUNT and NAME every declared window with no charter — a per-window line
  # at wake time is read only by the mind it happens to, at the moment it happens; nobody was holding
  # the total, which is how eight became a fact about the node that no reader had.
  local _out6c
  _out6c="$(CHARTER_DIR="$td/no-charter-a" CHARTER_GENOME="$td/no-charter-b" MESH_MIND_CHANNELS="alpha beta" _charter_census 2>&1)"
  case "$_out6c" in
    *"charter-MISS alpha"*) ;;
    *) echo "handoff-test: FAIL (P6d: an uncharted declared window is not printed by name)"; rc=1;;
  esac
  case "$_out6c" in
    *"0/2 charted, 2 missing"*) ;;
    *) echo "handoff-test: FAIL (P6e: the census has no denominator — a miss count with no total cannot say whether coverage is full (got: $_out6c))"; rc=1;;
  esac
  # a charter that EXISTS must be counted as covered, or the census can never reach full and stops
  # being read (the alarm-that-is-always-on failure).
  mkdir -p "$td/charter-cov"; : > "$td/charter-cov/alpha.md"; echo x > "$td/charter-cov/alpha.md"
  _out6c="$(CHARTER_DIR="$td/charter-cov" CHARTER_GENOME="$td/no-charter-b" MESH_MIND_CHANNELS="alpha beta" _charter_census 2>&1)"
  case "$_out6c" in
    *"1/2 charted, 1 missing [beta]"*) ;;
    *) echo "handoff-test: FAIL (P6f: a charter that exists was not counted as covered (got: $_out6c))"; rc=1;;
  esac
  # NO DECLARATION IS UNKNOWN, NOT FULL COVERAGE. Rendering 0-missing off an absent denominator would
  # reinstate exactly the silence this change removes, one level up.
  _out6c="$(MESH_DIR="$td" CHARTER_DIR="$td/no-charter-a" CHARTER_GENOME="$td/no-charter-b" MESH_MIND_CHANNELS="" _charter_census 2>&1)"
  case "$_out6c" in
    *UNKNOWN*) ;;
    *) echo "handoff-test: FAIL (P6g: an absent MESH_MIND_CHANNELS must render UNKNOWN, never a coverage number (got: $_out6c))"; rc=1;;
  esac
  # and the census must never refuse: a lean node or a fresh plant legitimately runs ahead of its
  # charters, so a miss is LOUD and COUNTED, never fatal.
  ( CHARTER_DIR="$td/no-charter-a" CHARTER_GENOME="$td/no-charter-b" MESH_MIND_CHANNELS="alpha" _charter_census >/dev/null 2>&1 ) \
    || { echo "handoff-test: FAIL (P6h: the census exited non-zero on a miss — a fresh window's first act must not be a failure)"; rc=1; }

  rm -rf "$td"
  [ "$rc" = 0 ] && echo "handoff-test: ok (manual round-trip carries state; snapshot extracts verbatim signal + no-clobber of fresh manual + capped from 100× scrollback + mesh-clear names this tool as its handoff writer with no coverage verdict + wip line branches landed/unlanded/dirty/tool-absent + restore lede downgrades trust for a pre-boot prior-incarnation handoff, full-trust for this incarnation + --audit separates a teaching-shaped transfer from a transport-shaped one, renders na for missing evidence, and is not satisfied by the handoff machinery naming itself + the CHARTER restores with or without a handoff, renders BEFORE it, prefers the node-local tier over the genome default, and truncates LOUDLY + a MISSING charter is RENDERED by name with the path it would go to and its own framing, and coverage is counted against MESH_MIND_CHANNELS with an absent declaration reading UNKNOWN, never zero-missing, and never fatal + THE GOAL LINE is never blank in any branch: no charter names both paths, a charter with no goal: names the file, a declared goal renders with a CALENDAR-day countdown that does not shrink through the day, a past deadline reads OVERDUE, a failing progress command names itself with its rc, an undeclared progress is named as undeclared, and rc is always 0)"
  exit "$rc"
}

# ---- lib mode ----
# Another tool may `MESH_HANDOFF_LIB_ONLY=1 source mesh-handoff` to reuse the EXTRACTOR (_extract_terse,
# deterministic furniture-stripping — no model) without running the dispatch. This is the mesh's ONE
# extractive-handoff path: it used to live in mesh-clear (_extract_handoff, a model call) and moved here
# when the clear-gate's model was removed, so mesh-clear-loss's canary extracts exactly what the real
# */5 snapshot extracts — one extractor, never a second copy to rot.
[ -n "${MESH_HANDOFF_LIB_ONLY:-}" ] && return 0 2>/dev/null

case "${1:-}" in
  --test)     _test ;;
  --restore)  _restore ;;
  --snapshot) _snapshot "${2:-}" ;;
  --audit)    shift; _audit "$@" ;;
  --charter-census)
    _charter_census
    ;;
  --charter)
    win="${2:-$(_this_window)}"
    [ -n "$win" ] || { echo "mesh-handoff --charter: no window (not in tmux) — pass one explicitly" >&2; exit 2; }
    if cf="$(_charter_file "$win")"; then echo "# charter source: $cf"; cat "$cf"
    else echo "mesh-handoff --charter: no charter for '$win' (looked in $CHARTER_DIR/ then $CHARTER_GENOME/)" >&2; exit 1; fi
    ;;
  --goal)
    # NEVER rc-fails and never prints nothing: a data pane calling this must always get a line, and a
    # window that cannot be resolved is itself a fact worth printing rather than an empty first row.
    win="${2:-$(_this_window)}"
    [ -n "$win" ] || { echo "ЦЕЛЬ НЕ ОБЪЯВЛЕНА — окно не определено (не в tmux и не передано аргументом)"; exit 0; }
    case "${3:-}" in --oneline) _goal_line "$win" --oneline ;; *) _goal_line "$win" ;; esac
    ;;
  --show)
    win="${2:-$(_this_window)}"
    [ -n "$win" ] || { echo "mesh-handoff --show: no window (not in tmux) — pass one explicitly" >&2; exit 2; }
    f="$(_handoff_file "$win")"
    [ -r "$f" ] && cat "$f" || { echo "mesh-handoff --show: no handoff stored for '$win' ($f)" >&2; exit 1; }
    ;;
  ""|-h|--help)
    sed -n '2,20p' "$0"; exit 0 ;;
  -*)
    # AN UNKNOWN OPTION IS A TYPO, NOT A WINDOW NAME. The catch-all below takes $1 as the window to
    # write, so `mesh-handoff --goal genome` on a node whose copy predates --goal did not fail — it
    # WROTE ~/.mesh/handoff/--goal.md and posted a [handoff] line to the board naming a window that
    # has never existed. A mistyped flag must refuse loudly; silently reinterpreting it as data is how
    # a tool invents state nobody asked for. (Caught doing exactly this, 2026-08-29.)
    echo "mesh-handoff: unknown option '$1' — a flag is never taken as a window name (did you mean --goal, --charter, --show, --snapshot, --restore?)" >&2
    exit 2 ;;
  *)
    win="$1"; shift
    state="${*:-}"
    [ -n "$state" ] || { echo "usage: mesh-handoff <window> \"<what done> + <next> + <key paths>\"" >&2; exit 2; }
    _write_handoff "$win" "$state" >/dev/null
    echo "handoff written for '$win' → $(_handoff_file "$win") (+ [handoff] board line)"
    ;;
esac
