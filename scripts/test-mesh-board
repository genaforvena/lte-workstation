#!/usr/bin/env bash
set -euo pipefail

td="$(mktemp -d)"
trap 'rm -rf "$td"' EXIT
mkdir -p "$td/bin" "$td/mesh/promises"
cat > "$td/mesh/promises/promises.journal" <<'EOF'
2026-09-06 * promise opened: alpha-step ; task:alpha-step owner:genome prio:incident opened:2026-09-06T00:00:00Z
    liabilities:promises:genome:alpha-step  1 PROMISE
    equity:promises                    -1 PROMISE

2026-09-06 * promise opened: beta-step ; task:beta-step owner:health prio:normal opened:2026-09-06T00:01:00Z
    liabilities:promises:health:beta-step  1 PROMISE
    equity:promises                    -1 PROMISE
EOF
cat > "$td/bin/hledger" <<'EOF'
#!/usr/bin/env bash
exec /usr/bin/hledger "$@"
EOF
chmod +x "$td/bin/hledger"
cat > "$td/bin/tmux" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' genome health
EOF
chmod +x "$td/bin/tmux"
cat > "$td/mesh/chat.log" <<'EOF'
2026-09-06T00:00:00Z witness ::  [task] alpha-step: preserve the task subject (owner: health)
EOF

out="$(MESH_DIR="$td/mesh" PATH="$td/bin:$PATH" "$PWD/scripts/mesh-board" open)"
grep -q 'alpha-step' <<<"$out"
grep -q 'beta-step' <<<"$out"
grep -q $'^genome\talpha-step' <<<"$out"

count="$(MESH_DIR="$td/mesh" PATH="$td/bin:$PATH" "$PWD/scripts/mesh-board" count)"
[[ "$count" == 2 ]]

owes="$(MESH_DIR="$td/mesh" PATH="$td/bin:$PATH" "$PWD/scripts/mesh-board" owes genome)"
grep -q '^alpha-step' <<<"$owes"
! grep -q 'beta-step' <<<"$owes"

task="$(MESH_DIR="$td/mesh" PATH="$td/bin:$PATH" "$PWD/scripts/mesh-board" task alpha-step)"
grep -q $'^genome\talpha-step\tincident' <<<"$task"

incidents="$(MESH_DIR="$td/mesh" PATH="$td/bin:$PATH" "$PWD/scripts/mesh-board" incidents)"
grep -q $'^genome\talpha-step' <<<"$incidents"
! grep -q 'beta-step' <<<"$incidents"

echo 'test-mesh-board: ok (ledger open/count/owner queries)'
