#!/usr/bin/env bash
# mesh-fawxible-watch — watch the guy-fawxible repo (the operator's WORK mesh, cloned on ilya)
#   for NEW commits and surface them to the board as a review task for genome. READ-ONLY:
#   only `git fetch`/`git log` on ilya's clone; never writes there, never posts to their repo.
#
#   Operator approved 2026-07-07 ("одобряю genome"): the operator wants genome to PERIODICALLY
#   check guy-fawxible for patterns worth porting into our mesh (a first hand-review already
#   ported 3 patterns 2026-07-07). This reflex is the periodic trigger — it does NOT judge or
#   port anything itself (that's genome's call); it just says "N new commits since last look,
#   here are the subjects, go review" so a busy genome pane isn't jammed on every tick.
#
#   mesh-fawxible-watch          one poll pass (cron-wired)
#   mesh-fawxible-watch --status one dash line (current head / new-since-seen / pulse age)
#   mesh-fawxible-watch --test   smoke test (fixture parse; sends NO board post)
#
# State:  ~/.mesh/.fawxible-watch-head  — last-seen upstream sha (advanced only after a post)
#         ~/.mesh/.fawxible-watch.pulse — mtime = liveness (touched every successful run)
# reflex-cadence: 17 */6 * * *
# doctor-artifact: $HOME/.mesh/.fawxible-watch.pulse 43200 net
# Exit: 0 = ok (polled); 2 = n/a (ilya/repo unreachable — honest n/a, never a faked "nothing new").
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes"

# where the clone lives (overridable via ~/.mesh/nodes)
ILYA="${FAWXIBLE_NODE:-ilya@100.107.198.111}"
REPO="${FAWXIBLE_REPO:-~/guy-fawxible}"
HEADF="$HOME/.mesh/.fawxible-watch-head"
PULSE="$HOME/.mesh/.fawxible-watch.pulse"
BOARD_LOG="$HOME/.mesh/chat.log"
# cross-node dedup: same-class fracture as scan_orphans/sweep-rollcall/mesh-criticality (1e78b39)
# — $HEADF is per-node-local, so a node that's behind re-mints a [task] another node already
# posted (or genome already [done]-closed). Shared primitive, inline fallback keeps this
# self-contained if mesh-patterns.sh isn't deployed.
if [ -f "$HOME/.local/bin/mesh-patterns.sh" ]; then . "$HOME/.local/bin/mesh-patterns.sh" 2>/dev/null || true
elif [ -f "$(dirname "$0")/mesh-patterns.sh" ]; then . "$(dirname "$0")/mesh-patterns.sh" 2>/dev/null || true; fi
type board_recent_ts_within >/dev/null 2>&1 || board_recent_ts_within(){
  local board="$1" marker="$2" window="$3" now="${4:-$(date +%s)}"
  [ -r "$board" ] || return 1
  local ts epoch
  ts="$(grep -F -- "$marker" "$board" 2>/dev/null | tail -1 | awk '{print $1}')"
  [ -n "$ts" ] || return 1
  epoch="$(date -u -d "$ts" +%s 2>/dev/null)" || return 1
  [ $(( now - epoch )) -lt "$window" ] || return 1
  printf '%s' "$epoch"
}
# chat-review/patterns-presync-gate-shared(-relanded): board_recent_ts_within above only sees peer
# posts mesh-chat-sync's periodic cron has ALREADY gossiped in — up to ~25min stale — while this
# reflex ticks every 6h; a peer's just-posted fawxible-review-<sha> can be invisible here and TWO
# nodes double-post the same slug (live: 2 nodes posted fawxible-review-b0aa8ba 0s apart, 2026-07-09
# 21:17:03Z). Pull fresh gossip synchronously (rate-limited + hard-timeout) right before trusting the
# board, same fix mesh-mind-control's dispatch() already has (538b3f1).
type board_presync >/dev/null 2>&1 || board_presync(){
  local stamp="$1" min_interval="${2:-300}" timeout_s="${3:-25}" cmd="$4"
  [ -n "$cmd" ] || return 0
  local now age
  now=$(date +%s); age=999999
  [ -f "$stamp" ] && age=$(( now - $(stat -c %Y "$stamp" 2>/dev/null || echo 0) ))
  if [ "$age" -ge "$min_interval" ]; then
    timeout "$timeout_s" $cmd >/dev/null 2>&1 || true
    touch "$stamp" 2>/dev/null || true
  fi
}
PRESYNC_STAMP="$HOME/.mesh/.fawxible-watch-presync"

# remote git read: fetch, then report upstream head + new-commit subjects since $1 (a sha or empty).
# echoes:  <line1> upstream sha    <line2..> "  <short> <subject>" for each new commit
remote_scan() {
  local since="$1"
  timeout 40 ssh -o StrictHostKeyChecking=no -o ConnectTimeout=8 -o BatchMode=yes "$ILYA" "
    cd $REPO 2>/dev/null || exit 3
    git fetch -q origin 2>/dev/null
    up=\$(git rev-parse --short 'HEAD@{upstream}' 2>/dev/null || git rev-parse --short HEAD 2>/dev/null) || exit 3
    echo \"\$up\"
    range='HEAD@{upstream}'; git rev-parse HEAD@{upstream} >/dev/null 2>&1 || range=HEAD
    if [ -n '$since' ] && git cat-file -e '$since^{commit}' 2>/dev/null; then
      git log --oneline --no-decorate '$since'..\$range 2>/dev/null
    else
      git log --oneline --no-decorate -8 \$range 2>/dev/null
    fi
  " 2>/dev/null
}

case "${1:-}" in
  --test)
    # sandbox: never let a --test SSH out or post to the board (mesh-doctor smoke-sweep gate)
    fixture=$'5da43a0 docs: reconcile spec/plan prose with shipped reality\n23c98c4 fix(gf-claim-recover): unreadable ctx is a SKIP, not a clear\n5328057 feat(gf-infra-investigate): infra-class alerts wake the infra mind'
    head=$(printf '%s\n' "$fixture" | head -1 | awk '{print $1}')
    n=$(printf '%s\n' "$fixture" | grep -c .)
    [ "$head" = "5da43a0" ] && [ "$n" -eq 3 ] || { echo "smoke-test: FAIL (parse head=$head n=$n)"; exit 1; }

    # cross-node dedup fixture (node A already posted fawxible-review-ab9d4fb; node B must adopt,
    # not repost; a different sha with no prior post must be unaffected)
    _bd="$(mktemp -d)"; _board="$_bd/chat.log"
    printf '2026-07-08T12:17:05Z  fawxible-watch@nodeA  ::  [task] fawxible-review-ab9d4fb: ...\n' > "$_board"
    board_recent_ts_within "$_board" "fawxible-review-ab9d4fb" 43200 "$(date -u -d '2026-07-08T13:00:00Z' +%s)" >/dev/null 2>&1 \
      || { echo "smoke-test: FAIL (dedup: existing board post for ab9d4fb should be found within window)"; exit 1; }
    # presync-before-dedup wiring (chat-review/patterns-presync-gate-shared-relanded): board_presync
    # must be reachable + actually pull before the dedup check trusts the board.
    _ps_calls="$_bd/ps_calls"
    _ps_cmd="$_bd/ps_cmd.sh"
    printf '#!/bin/sh\necho called >> "%s"\n' "$_ps_calls" > "$_ps_cmd"; chmod +x "$_ps_cmd"
    board_presync "$_bd/presync-stamp" 300 5 "$_ps_cmd"
    [ "$(grep -c . "$_ps_calls" 2>/dev/null || echo 0)" = 1 ] \
      || { echo "smoke-test: FAIL (board_presync did not invoke sync_cmd on first call)"; exit 1; }
    [ -f "$_bd/presync-stamp" ] || { echo "smoke-test: FAIL (board_presync did not touch its stamp file)"; exit 1; }

    board_recent_ts_within "$_board" "fawxible-review-717c8ce" 43200 "$(date -u -d '2026-07-08T13:00:00Z' +%s)" >/dev/null 2>&1 \
      && { echo "smoke-test: FAIL (dedup: unrelated sha 717c8ce must NOT match ab9d4fb's post)"; exit 1; }
    rm -rf "$_bd"

    # assert the board post is gated: under sandbox we must NOT call mesh-chat
    if [ "${MESH_TEST_SANDBOX:-}" = "1" ]; then
      echo "smoke-test: ok (parse head=$head, $n commits; dedup adopt/post-through verified; MESH_TEST_SANDBOX → no SSH, no board post)"
    else
      echo "smoke-test: ok (parse head=$head, $n commits; dedup adopt/post-through verified)"
    fi
    exit 0
    ;;
  --status)
    seen=$(cat "$HEADF" 2>/dev/null || echo "-")
    age="?"; [ -f "$PULSE" ] && age=$(( ($(date +%s) - $(stat -c %Y "$PULSE")) / 60 ))m
    echo "fawxible-watch: seen=$seen pulse=${age} ago"
    exit 0
    ;;
esac

mkdir -p "$HOME/.mesh"
seen=$(cat "$HEADF" 2>/dev/null || echo "")
out=$(remote_scan "$seen")
rc=$?
if [ $rc -ne 0 ] || [ -z "$out" ]; then
  # ilya/repo unreachable → honest n/a. Do NOT advance state, do NOT post. (pulse still touched
  # below so mtime-watchdogs read "ran", but the honest n/a is exit 2.)
  touch "$PULSE" 2>/dev/null
  echo "mesh-fawxible-watch: ilya/repo unreachable (rc=$rc) — n/a" >&2
  exit 2
fi

touch "$PULSE" 2>/dev/null
upstream=$(printf '%s\n' "$out" | head -1 | awk '{print $1}')
commits=$(printf '%s\n' "$out" | tail -n +2 | grep -c . || true)

# first run: record head, don't flood the board with backlog (mirrors reviving-offset-reflex)
if [ -z "$seen" ]; then
  printf '%s\n' "$upstream" > "$HEADF"
  echo "mesh-fawxible-watch: baseline head=$upstream (no post on first run)"
  exit 0
fi

if [ "$upstream" = "$seen" ] || [ "${commits:-0}" -eq 0 ]; then
  echo "mesh-fawxible-watch: nothing new (head=$upstream)"
  exit 0
fi

# cross-node dedup: another node (or genome's own [done]) may have already surfaced/closed this
# exact upstream sha within the window — adopt it into $HEADF without reposting (mirrors
# scan_orphans' adopt-not-mint branch), same as this reflex's own first-run baseline skip above.
# Presync first (chat-review/patterns-presync-gate-shared-relanded): refresh the local board copy
# before trusting it, so a peer's just-gossiped post isn't missed by this tick's dedup check.
if [ "${MESH_TEST_SANDBOX:-}" != "1" ]; then
  board_presync "$PRESYNC_STAMP" "${MESH_FAWXIBLE_PRESYNC_MIN:-300}" "${MESH_FAWXIBLE_PRESYNC_TIMEOUT:-25}" "${MESH_FAWXIBLE_PRESYNC_CMD:-mesh-chat-sync}"
fi
if [ "${MESH_TEST_SANDBOX:-}" != "1" ] && board_recent_ts_within "$BOARD_LOG" "fawxible-review-${upstream}" "${MESH_FAWXIBLE_DEDUP_WINDOW:-43200}" "$(date +%s)" >/dev/null 2>&1; then
  printf '%s\n' "$upstream" > "$HEADF"
  echo "mesh-fawxible-watch: fawxible-review-${upstream} already surfaced/closed on the board — adopted head=$upstream without reposting"
  exit 0
fi

# NEW commits → one board task for genome (owner-slash form so dispatch routes to genome window)
subjects=$(printf '%s\n' "$out" | tail -n +2 | sed 's/^/    /' | head -12)
msg="[task] fawxible-review-${upstream}: guy-fawxible (operator's work mesh, clone on ilya) advanced ${commits} commit(s) since ${seen} → HEAD ${upstream}. Review the new commits for patterns worth porting into our mesh (like the 3 ported 2026-07-07); port the useful, [done] with what you took + what you skipped and why. Read on ilya: git -C ~/guy-fawxible show <sha>. New:
${subjects}
owner: mesh-fawxible-watch/genome"

if [ "${MESH_TEST_SANDBOX:-}" = "1" ]; then
  # suppressed → we did NOT surface these commits, so do NOT advance head (else silent drop)
  echo "mesh-fawxible-watch: MESH_TEST_SANDBOX — board post SUPPRESSED, head NOT advanced" >&2
  exit 0
fi
MESH_WHO="fawxible-watch@$(hostname)" mesh-chat "$msg" 2>/dev/null
printf '%s\n' "$upstream" > "$HEADF"
echo "mesh-fawxible-watch: posted review task for ${commits} new commit(s) (head=$upstream)"
exit 0
