#!/usr/bin/env bash
# reflex-cadence: */2 * * * *
# reflex-args: once
# Synthetic-only coordinator wrapper; no Mesh wake authority.
set -euo pipefail
repo="${MESH_REPO:-$HOME/lte-workstation}"
core="${MESH_MISHE_CORE:-}"
home="${MESH_MISHE_HOME:-$HOME/.mesh/mishe-tauftauf}"
python="${MESH_MISHE_PYTHON:-}"
if [ -z "$python" ]; then
  if [ -x "$HOME/.mesh/venvs/mishe-tauftauf/bin/python" ]; then
    python="$HOME/.mesh/venvs/mishe-tauftauf/bin/python"
  else
    python=python3
  fi
fi
case "${1:-}" in
  init|enroll-cleaner|once|refresh-controls|--test) mode="$1" ;;
  *) echo 'usage: mesh-mishe-run init|enroll-cleaner|once|refresh-controls|--test' >&2; exit 2 ;;
esac
command -v "$python" >/dev/null 2>&1 || { echo 'mesh-mishe-run: Python interpreter absent' >&2; exit 2; }
if [ -n "$core" ]; then
  [ -f "$core/src/mishe_tauftauf/__main__.py" ] || { echo 'mesh-mishe-run: public core source absent' >&2; exit 2; }
  export PYTHONPATH="$core/src${PYTHONPATH:+:$PYTHONPATH}"
fi
"$python" -c 'from mishe_tauftauf.observations import run_projector' 2>/dev/null || {
  echo 'mesh-mishe-run: installed core lacks Phase 1 projector contract' >&2
  exit 2
}
[ "$mode" = --test ] && {
  [ -f "$home/feed" ] && [ -x "$home/top-pains/synthetic" ] && [ -x "$home/projectors/synthetic" ] \
    && [ -x "$repo/scripts/mesh-mishe-render" ] && [ -x "$repo/scripts/mesh-mishe-project" ] || {
    echo 'mesh-mishe-run: synthetic shadow not initialized' >&2
    exit 2
  }
  "$python" -m mishe_tauftauf --home "$home" doctor >/dev/null || {
    echo 'mesh-mishe-run: core doctor failed' >&2
    exit 2
  }
  echo 'mesh-mishe-run --test: synthetic shadow initialized'
  exit 0
}
[ "$mode" = init ] && mkdir -p -- "$home"
core_cmd=("$python" -m mishe_tauftauf --home "$home")
if [ "$mode" = init ]; then
  "${core_cmd[@]}" init
  [ -d "$home/projectors" ] && [ -d "$home/top-pains" ] || {
    echo 'mesh-mishe-run: core lacks Phase 1 projector contract' >&2
    exit 2
  }
  # A per-home wrapper closes over this checkout and the synthetic fixture path.
  render="$home/top-pains/synthetic"
  project="$home/projectors/synthetic"
  printf '#!/usr/bin/env bash\nexec %q synthetic\n' "$repo/scripts/mesh-mishe-render" > "$render"
  printf '#!/usr/bin/env bash\nexec %q "$@"\n' "$repo/scripts/mesh-mishe-project" > "$project"
  chmod 755 "$render" "$project"
elif [ "$mode" = enroll-cleaner ]; then
  [ -f "$home/feed" ] && [ -d "$home/top-pains" ] && [ -d "$home/projectors" ] || {
    echo 'mesh-mishe-run: initialize synthetic home first' >&2; exit 2;
  }
  [ -x "$repo/scripts/mesh-dash" ] && [ -x "$repo/scripts/mesh-mishe-render" ] && \
    [ -x "$repo/scripts/mesh-mishe-project" ] || {
    echo 'mesh-mishe-run: cleaner renderer/projector unavailable' >&2; exit 2;
  }
  printf '#!/usr/bin/env bash\nexec %q cleaner\n' "$repo/scripts/mesh-mishe-render" > "$home/top-pains/cleaner"
  printf '#!/usr/bin/env bash\nexec %q --channel cleaner "$@"\n' "$repo/scripts/mesh-mishe-project" > "$home/projectors/cleaner"
  chmod 755 "$home/top-pains/cleaner" "$home/projectors/cleaner"
else
  [ -x "$home/top-pains/synthetic" ] || { echo 'mesh-mishe-run: run init first' >&2; exit 2; }
  judge_arg=()
  control_arg=()
  if [ -n "${MESH_MISHE_JUDGE:-}" ]; then
    judge_arg=(--judge "$MESH_MISHE_JUDGE")
    control_arg=(--control-cache-ttl "${MESH_MISHE_CONTROL_CACHE_TTL:-3600}")
    [ "$mode" = refresh-controls ] && control_arg+=(--refresh-controls)
  elif [ "$mode" = refresh-controls ]; then
    echo 'mesh-mishe-run: refresh-controls requires MESH_MISHE_JUDGE' >&2
    exit 2
  fi
  view_arg=()
  [ -x "$home/top-pains/cleaner" ] && view_arg=(--external-view-slug cleaner)
  "${core_cmd[@]}" run --once --launcher headless --observe-only "${judge_arg[@]}" "${control_arg[@]}" "${view_arg[@]}"
  view_tmp="$(mktemp "$home/.mesh-mishe-view.XXXXXX")"
  if [ "${#view_arg[@]}" -gt 0 ]; then
    printf 'cleaner=projected-publish-v1\n' > "$view_tmp"
  else
    printf 'cleaner=disabled\n' > "$view_tmp"
  fi
  mv -f -- "$view_tmp" "$home/.mesh-mishe-view"
  stamp_tmp="$(mktemp "$home/.mesh-mishe-pass.XXXXXX")"
  "$python" -c 'import time; print(time.time())' > "$stamp_tmp"
  mv -f -- "$stamp_tmp" "$home/.mesh-mishe-pass"
fi
