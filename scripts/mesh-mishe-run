#!/usr/bin/env bash
# reflex-cadence: */2 * * * *
# reflex-args: once
# Observe with the public core; a generation-gated local outbox owns admitted one-shot wakes.
set -euo pipefail
repo="${MESH_REPO:-$HOME/lte-workstation}"
core="${MESH_MISHE_CORE:-}"
home="${MESH_MISHE_HOME:-$HOME/.mesh/mishe-tauftauf}"
python="${MESH_MISHE_PYTHON:-}"
if [ -z "$python" ]; then
  if [ -x "$HOME/.mesh/venvs/mishe-tauftauf/bin/python" ]; then
    python="$HOME/.mesh/venvs/mishe-tauftauf/bin/python"
  else
    python=python3
  fi
fi
case "${1:-}" in
  init|enroll-cleaner|enroll-fleet|once|refresh-controls|--freshness|--test) mode="$1" ;;
  *) echo 'usage: mesh-mishe-run init|enroll-cleaner|enroll-fleet|once|refresh-controls|--freshness|--test' >&2; exit 2 ;;
esac
command -v "$python" >/dev/null 2>&1 || { echo 'mesh-mishe-run: Python interpreter absent' >&2; exit 2; }
if [ "$mode" = --freshness ]; then
  "$python" - "$home" <<'PY'
import json
from pathlib import Path
import sys
import time

home = Path(sys.argv[1])
try:
    polls = json.loads((home / 'fleet-polls.json').read_text())
    if not isinstance(polls, dict) or not polls:
        raise ValueError('roster')
    now = time.time_ns()
    stale = []
    for channel, interval in polls.items():
        if type(interval) is not int or interval < 1:
            raise ValueError('interval')
        stamp = int((home / f'.mesh-mishe-seen-{channel}').read_text())
        if stamp > now or now - stamp > (interval * 2 + 60) * 1_000_000_000:
            stale.append(channel)
except (OSError, ValueError) as exc:
    print(f'mesh-mishe-run freshness UNKNOWN: missing or invalid evidence ({type(exc).__name__})')
    raise SystemExit(2)
if stale:
    print(f'mesh-mishe-run freshness UNKNOWN: {len(stale)}/{len(polls)} stale')
    raise SystemExit(2)
print(f'mesh-mishe-run freshness PASS: {len(polls)} channels')
PY
  exit $?
fi
if [ -n "$core" ]; then
  [ -f "$core/src/mishe_tauftauf/__main__.py" ] || { echo 'mesh-mishe-run: public core source absent' >&2; exit 2; }
  export PYTHONPATH="$core/src${PYTHONPATH:+:$PYTHONPATH}"
fi
"$python" -c 'from mishe_tauftauf.observations import run_projector' 2>/dev/null || {
  echo 'mesh-mishe-run: installed core lacks Phase 1 projector contract' >&2
  exit 2
}
[ "$mode" = --test ] && {
  [ -f "$home/feed" ] && [ -x "$home/top-pains/synthetic" ] && [ -x "$home/projectors/synthetic" ] \
    && [ -x "$repo/scripts/mesh-mishe-render" ] && [ -x "$repo/scripts/mesh-mishe-project" ] || {
    echo 'mesh-mishe-run: synthetic shadow not initialized' >&2
    exit 2
  }
  "$python" -m mishe_tauftauf --home "$home" doctor >/dev/null || {
    echo 'mesh-mishe-run: core doctor failed' >&2
    exit 2
  }
  echo 'mesh-mishe-run --test: synthetic shadow initialized'
  exit 0
}
[ "$mode" = init ] && mkdir -p -- "$home"
core_cmd=("$python" -m mishe_tauftauf --home "$home")
if [ "$mode" = init ]; then
  "${core_cmd[@]}" init
  [ -d "$home/projectors" ] && [ -d "$home/top-pains" ] || {
    echo 'mesh-mishe-run: core lacks Phase 1 projector contract' >&2
    exit 2
  }
  # A per-home wrapper closes over this checkout and the synthetic fixture path.
  render="$home/top-pains/synthetic"
  project="$home/projectors/synthetic"
  printf '#!/usr/bin/env bash\nexec %q synthetic\n' "$repo/scripts/mesh-mishe-render" > "$render"
  printf '#!/usr/bin/env bash\nexec %q "$@"\n' "$repo/scripts/mesh-mishe-project" > "$project"
  chmod 755 "$render" "$project"
elif [ "$mode" = enroll-cleaner ]; then
  [ -f "$home/feed" ] && [ -d "$home/top-pains" ] && [ -d "$home/projectors" ] || {
    echo 'mesh-mishe-run: initialize synthetic home first' >&2; exit 2;
  }
  [ -x "$repo/scripts/mesh-dash" ] && [ -x "$repo/scripts/mesh-mishe-render" ] && \
    [ -x "$repo/scripts/mesh-mishe-project" ] || {
    echo 'mesh-mishe-run: cleaner renderer/projector unavailable' >&2; exit 2;
  }
  printf '#!/usr/bin/env bash\nexec %q cleaner\n' "$repo/scripts/mesh-mishe-render" > "$home/top-pains/cleaner"
  printf '#!/usr/bin/env bash\nexec %q --channel cleaner "$@"\n' "$repo/scripts/mesh-mishe-project" > "$home/projectors/cleaner"
  chmod 755 "$home/top-pains/cleaner" "$home/projectors/cleaner"
elif [ "$mode" = enroll-fleet ]; then
  [ -f "$home/feed" ] && [ -d "$home/top-pains" ] && [ -d "$home/projectors" ] || {
    echo 'mesh-mishe-run: initialize home first' >&2; exit 2;
  }
  "$python" - "$repo" "$home" "${MESH_MISHE_ROSTER_JSON:-}" <<'PY'
import json
import os
from pathlib import Path
import shlex
import subprocess
import sys

repo, home, fixture = Path(sys.argv[1]), Path(sys.argv[2]), sys.argv[3]
if fixture:
    roster = json.loads(Path(fixture).read_text())
else:
    result = subprocess.run([str(repo / 'scripts/mesh-mishe-channels'), '--json'],
                            capture_output=True, text=True, check=True)
    roster = json.loads(result.stdout)
roles = {name: name for name in ('adint cleaner discover genome haunt hire job minds pub senses sound tg tg-roz vpn wake witness').split()}
roles['health'] = 'check'
rows = roster.get('channels', [])
active = [row for row in rows if row.get('state') == 'active']
if roster.get('status') != 'PASS' or not active or len({row.get('channel') for row in active}) != len(active):
    raise SystemExit('mesh-mishe-run: unsafe roster')
if any(row.get('channel') not in roles or row.get('renderer_role') != roles[row['channel']]
       for row in active):
    raise SystemExit('mesh-mishe-run: unrecognized channel/renderer')
polls = {row['channel']: row.get('poll_seconds') for row in active}
if any(type(value) is not int or value < 1 for value in polls.values()):
    raise SystemExit('mesh-mishe-run: invalid poll interval')
key_path = home / 'projection.key'
if not key_path.exists():
    fd = os.open(key_path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, 'wb') as stream:
        stream.write(os.urandom(32))
        stream.flush()
        os.fsync(stream.fileno())
for row in active:
    channel, role = row['channel'], row['renderer_role']
    for directory, command in (
        ('top-pains', ['env', 'MESH_MISHE_RENDER_SOURCE=pane', repo / 'scripts/mesh-mishe-render', channel, role]),
        ('projectors', [repo / 'scripts/mesh-mishe-project', '--channel', channel]),
    ):
        target = home / directory / channel
        temp = target.with_name(f'.{channel}.{os.getpid()}.tmp')
        temp.write_text('#!/usr/bin/env bash\nexec ' + ' '.join(shlex.quote(str(arg)) for arg in command) + ' "$@"\n')
        temp.chmod(0o755)
        os.replace(temp, target)
roster_path = home / 'fleet-channels'
temp = roster_path.with_name(f'.fleet-channels.{os.getpid()}.tmp')
temp.write_text(''.join(row['channel'] + '\n' for row in active))
temp.chmod(0o600)
os.replace(temp, roster_path)
poll_path = home / 'fleet-polls.json'
temp = poll_path.with_name(f'.fleet-polls.{os.getpid()}.tmp')
temp.write_text(json.dumps(polls, sort_keys=True) + '\n')
temp.chmod(0o600)
os.replace(temp, poll_path)
print(f'mesh-mishe-run: enrolled {len(active)} shadow channels')
PY
else
  [ -x "$home/top-pains/synthetic" ] || { echo 'mesh-mishe-run: run init first' >&2; exit 2; }
  if [ "$mode" = once ] && [ -f "$home/fleet-channels" ] && \
      [ -f "$home/.fleet-shadow-hold" ] && [ "${MESH_MISHE_MANUAL_SHADOW:-0}" != 1 ]; then
    echo 'mesh-mishe-run: fleet shadow held for bounded verification'
    exit 0
  fi
  profile_start=0
  [ "${MESH_MISHE_PROFILE:-0}" = 1 ] && profile_start="$(date +%s%N)"
  profile_phase(){
    [ "$profile_start" -gt 0 ] || return 0
    local now
    now="$(date +%s%N)"
    echo "mesh-mishe-run phase=$1 elapsed-ms=$(((now - profile_start) / 1000000))" >&2
  }
  judge_arg=()
  control_arg=()
  if [ -n "${MESH_MISHE_JUDGE:-}" ]; then
    judge_arg=(--judge "$MESH_MISHE_JUDGE")
    control_arg=(--control-cache-ttl "${MESH_MISHE_CONTROL_CACHE_TTL:-3600}")
    [ "$mode" = refresh-controls ] && control_arg+=(--refresh-controls)
  elif [ "$mode" = refresh-controls ]; then
    echo 'mesh-mishe-run: refresh-controls requires MESH_MISHE_JUDGE' >&2
    exit 2
  fi
  view_arg=()
  view_version=disabled
  if [ -x "$home/top-pains/cleaner" ] && { [ ! -f "$home/fleet-channels" ] || [ "$mode" = refresh-controls ]; }; then
    case "${MESH_MISHE_DELTA_VIEW:-0}" in
      0) view_arg=(--external-view-slug cleaner); view_version=projected-publish-v1 ;;
      1) view_arg=(--external-delta-view-slug cleaner); view_version=projected-pair-v1 ;;
      *) echo 'mesh-mishe-run: MESH_MISHE_DELTA_VIEW must be 0 or 1' >&2; exit 2 ;;
    esac
  fi
  if [ -f "$home/cleaner-task-bridge.json" ]; then
    "$python" "$repo/scripts/mesh-mishe-task-bridge" once || exit 2
  fi
  profile_phase bridge
  slug_arg=()
  selected=""
  if [ "$mode" = once ] && [ -f "$home/fleet-channels" ]; then
    exec {run_lock}>"$home/.mesh-mishe-run.lock"
    flock -n "$run_lock" || { echo 'mesh-mishe-run: shadow tick already running' >&2; exit 2; }
    mapfile -t fleet_channels < "$home/fleet-channels"
    [ "${#fleet_channels[@]}" -gt 0 ] || { echo 'mesh-mishe-run: empty fleet roster' >&2; exit 2; }
    if [ "${2:-}" = --channel ] && [ -n "${3:-}" ]; then
      selected="$3"
      printf '%s\n' "${fleet_channels[@]}" | grep -Fxq "$selected" || { echo 'mesh-mishe-run: channel absent from enrolled roster' >&2; exit 2; }
      slug_arg=(--slug "$selected")
    elif [ "$#" -gt 1 ]; then
      echo 'mesh-mishe-run: usage once [--channel <active-channel>]' >&2; exit 2
    fi
  fi
  if [ "$selected" = cleaner ] || { [ -z "$selected" ] && [ "$mode" = once ]; }; then
    case "${MESH_MISHE_DELTA_VIEW:-0}" in
      0) view_arg=(--external-view-slug cleaner); view_version=projected-publish-v1 ;;
      1) view_arg=(--external-delta-view-slug cleaner); view_version=projected-pair-v1 ;;
      *) echo 'mesh-mishe-run: MESH_MISHE_DELTA_VIEW must be 0 or 1' >&2; exit 2 ;;
    esac
  fi
  export MESH_MISHE_TICK_ID
  MESH_MISHE_TICK_ID="$("$python" -c 'import secrets; print(secrets.token_hex(16))')"
  feed_before="$("$python" - "$home" <<'PY'
from mishe_tauftauf.feed import Feed
import sys
print(Feed(sys.argv[1]).tail_sequence())
PY
)"
  if [ "${MESH_MISHE_SKIP_AUTO_DRAIN:-0}" = 1 ]; then
    [ "${MESH_MISHE_MANUAL_SHADOW:-0}" = 1 ] && [ -f "$home/.fleet-shadow-hold" ] || {
      echo 'mesh-mishe-run: skip-auto-drain requires held manual shadow' >&2
      exit 2
    }
  else
    "$repo/scripts/mesh-mishe-auto-events" drain --limit 64 >/dev/null || {
      echo 'mesh-mishe-run: automatic event import UNKNOWN' >&2
      exit 2
    }
  fi
  profile_phase auto-events
  "${core_cmd[@]}" run --once --launcher headless --observe-only "${slug_arg[@]}" "${judge_arg[@]}" "${control_arg[@]}" "${view_arg[@]}"
  profile_phase core
  "$python" - "$home" "$feed_before" "$MESH_MISHE_TICK_ID" <<'PY'
from datetime import datetime, timezone
import json
import os
from pathlib import Path
import re
import sys
from mishe_tauftauf.feed import Feed

home, before, tick = Path(sys.argv[1]), int(sys.argv[2]), sys.argv[3]
staged = home / 'parity' / 'staged'
tape = home / 'parity' / 'projected.jsonl'
rows = []
for entry in Feed(home).entries(start=before + 1):
    if not entry.source.startswith('observation/'):
        continue
    channel = entry.source.split('/', 1)[1]
    if not re.fullmatch(r'[a-z][a-z0-9-]*', channel):
        continue
    try:
        row = json.loads((staged / channel).read_text())
        if set(row) != {'tick', 'event_id'} or row['tick'] != tick or not re.fullmatch(r'[0-9a-f]{64}', row['event_id']):
            continue
    except (OSError, ValueError, TypeError, KeyError):
        continue
    rows.append({'channel': channel, 'event_id': row['event_id'], 'kind': 'pane',
                 'at': entry.timestamp, 'source': 'top-pane', 'feed_seq': entry.sequence})
if rows:
    tape.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    old_umask = os.umask(0o077)
    try:
        with tape.open('a', encoding='utf-8') as stream:
            for row in rows:
                stream.write(json.dumps(row, separators=(',', ':')) + '\n')
            stream.flush()
            os.fsync(stream.fileno())
    finally:
        os.umask(old_umask)
PY
  profile_phase parity
  view_tmp="$(mktemp "$home/.mesh-mishe-view.XXXXXX")"
  printf 'cleaner=%s\n' "$view_version" > "$view_tmp"
  mv -f -- "$view_tmp" "$home/.mesh-mishe-view"
  stamp_tmp="$(mktemp "$home/.mesh-mishe-pass.XXXXXX")"
  "$python" -c 'import time; print(time.time())' > "$stamp_tmp"
  mv -f -- "$stamp_tmp" "$home/.mesh-mishe-pass"
  profile_phase stamp
  if [ "$mode" = once ] && [ -f "$home/fleet-channels" ]; then
    authority="$("$repo/scripts/mesh-mishe-authority" read witness)" || exit 2
    if [ "$(printf '%s' "$authority" | "$python" -c 'import json,sys; print(json.load(sys.stdin)["authority"])')" = mishe ]; then
      "$repo/scripts/mesh-mishe-dispatch" --once witness || exit 2
      profile_phase witness-one-shot
    fi
  fi
fi
