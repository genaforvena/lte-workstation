#!/usr/bin/env bash
# mesh-swap-rate — the kernel's SWAP-THRASH-RATE sense: pages/sec moving between RAM and disk,
# read from /proc/vmstat (pswpin/pswpout) + pgmajfault. Distinct from mesh-swap's FULLNESS snapshot.
#
# Why a RATE, not a fullness snapshot (mesh-swap already has that):
#   swap can be FULL-but-STABLE (pages parked on disk, nobody touching them — performance is FINE)
#   or filling/draining FAST (pages actively shuttling RAM<->disk — performance is degrading NOW).
#   Only the RATE distinguishes them. A page fetched from swap is ~1000x slower than RAM, so a high
#   sustained swap-page rate IS the memory-pressure collapse that slows/OOMs minds — and it LEADS
#   the fullness curve (the rate climbs before the pool fills). On this memory-constrained mind node
#   (7.3Gi, throttles under multi-mind load; pswpout cumulative already in the millions) that makes
#   it a leading indicator, complementing mesh-stress (thermal axis) for the throttle picture.
#
# The three tools, three layers of the SAME memory-pressure problem:
#   mesh-swap       → /proc/swaps used/total percentage      — how FULL the swap pool is (snapshot)
#   mesh-psi        → /proc/pressure/memory                  — kernel wait-STALL on memory (partial)
#   mesh-swap-rate  → /proc/vmstat pswpin/pswpout pages/sec  — how FAST swap I/O is happening NOW
#
# Method: two-sample counter delta over a short window (read, sleep, read) → pages/sec. Self-serve
# (/proc/vmstat is world-readable 0444, no phone/organ, no SSH). A counter reset (reboot mid-window)
# reads as 0, never a negative/bogus rate.
#
# Classification (FALSIFIABLE via --test; SWAP page rate = pswpin_pps + pswpout_pps, page=4KB):
#   IDLE       < 20 pg/s   (<80 KB/s)     — negligible swap traffic, not thrashing
#   LIGHT      20-500 pg/s (80KB-2MB/s)   — some swap I/O, system coping
#   THRASHING  >= 500 pg/s (>=2MB/s)      — heavy sustained swap I/O, performance degrading NOW
#   UNKNOWN    /proc/vmstat unreadable or fields absent (defensive; never a faked "IDLE")
# Thresholds env-overridable: SWAP_RATE_LIGHT_PPS (20) / SWAP_RATE_THRASH_PPS (500), window SWAP_RATE_WINDOW_S (3).
# pgmajfault rate is reported as CONTEXT only (it includes file-backed faults — noisy as a primary
# classifier — so it corroborates but does not drive the verdict).
#
# COVERAGE — a 3s window on a 300s cadence saw 1.0% of wallclock (window-cadence-aliasing sweep,
# docs/window-cadence-coverage-2026-08-15.md). The tool read /proc/vmstat's MONOTONIC ACCUMULATORS
# and threw them away after differencing them 3s apart, so 99% of every interval went unobserved:
# a two-minute paging burst that starts and ends between two cron ticks leaves the sense reporting
# IDLE, honestly, forever. The counters were already in its hands — carrying them in the state file
# and delta'ing ACROSS runs covers 100% of the interval at zero extra cost.
# BOTH windows are kept because they answer different questions: the interval mean dilutes a sharp
# 5-second burst, the 3s instantaneous one misses everything between ticks. They fold with a max
# that NAMES its winner (won=inst|iv), the coverage is published IN the reading (window=inst+iv),
# and missing evidence renders `na`, NEVER 0 — a reboot-reset counter differenced into 0 is a
# fabricated calm, which is exactly the alarm this sense exists to raise.
#
# Honest-exit contract:
#   0 = rate produced (IDLE/LIGHT/THRASHING)
#   2 = /proc/vmstat missing/unreadable or fields absent — never a fabricated rate
#
# reflex-cadence: */5 * * * *
# reflex-args: --edge
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
MESH_DIR="${MESH_DIR:-$HOME/.mesh}"
STATE="$MESH_DIR/.swap-rate.state"

LIGHT_PPS="${SWAP_RATE_LIGHT_PPS:-20}"
THRASH_PPS="${SWAP_RATE_THRASH_PPS:-500}"
WINDOW_S="${SWAP_RATE_WINDOW_S:-3}"
VMSTAT="${MESH_VMSTAT:-/proc/vmstat}"
# How stale a carried baseline may be before the interval window renders na: beyond it the reflex
# was DOWN and the "average" would span a gap nobody observed. 4x the */5 cadence.
MAX_IV_AGE="${SWAP_RATE_MAX_IV_AGE:-1200}"

# read_counters <file> → echoes "pswpin pswpout pgmajfault" or returns 1 (any field missing).
# The three fields are cumulative-since-boot counters (monotone non-negative integers).
read_counters() {
  local f="$1" pin pout pmf
  [ -r "$f" ] || return 1
  pin="$(awk '$1=="pswpin"{print $2; exit}'     "$f" 2>/dev/null)"
  pout="$(awk '$1=="pswpout"{print $2; exit}'    "$f" 2>/dev/null)"
  pmf="$(awk '$1=="pgmajfault"{print $2; exit}' "$f" 2>/dev/null)"
  # every field must be a bare non-negative integer, else the source is not the vmstat we expect
  for v in "$pin" "$pout" "$pmf"; do
    [ -n "$v" ] && printf '%s' "$v" | grep -qE '^[0-9]+$' || return 1
  done
  printf '%s %s %s\n' "$pin" "$pout" "$pmf"
}

# rate <cur> <prev> <dt> → pages/sec (integer, floored), never negative.
# A counter reset (cur<prev, e.g. reboot inside the window) floors to 0 — never a bogus negative.
rate() {
  local cur="$1" prev="$2" dt="$3" d
  [ "$dt" -ge 1 ] 2>/dev/null || dt=1
  d=$(( cur - prev ))
  [ "$d" -lt 0 ] && d=0
  printf '%s' "$(( d / dt ))"
}

# interval_rates <prev_raw> <now_epoch> <pin> <pout> <pmf> <max_age_s>
#   -> "<in_pps> <out_pps> <mf_pps>" from the ACROSS-RUN accumulator delta, or "na na na".
# MISSING EVIDENCE RENDERS na, NEVER 0. No baseline (first run / pre-upgrade state line), a
# counter that went BACKWARDS (reboot, and pswpin/pswpout reset to 0 on every one), a baseline
# older than max_age (the reflex was down — never average across an unobserved gap), a garbage
# field, dt<=0: each is absence of evidence, not evidence of quiet. `rate()` above floors a
# backwards counter to 0 for the in-run window, which is right for a 3s race but WRONG here —
# across a reboot it would publish "0 pg/s, calm" over an interval nobody watched.
interval_rates() {
  local prev="$1" ne="$2" pin="$3" pout="$4" pmf="$5" maxage="$6"
  local pe ppin ppout ppmf dt _f
  read -r pe ppin ppout ppmf <<< "$prev"
  for _f in "$pe" "$ppin" "$ppout" "$ppmf"; do
    case "$_f" in ''|*[!0-9]*) printf 'na na na\n'; return;; esac
  done
  dt=$(( ne - pe ))
  [ "$dt" -gt 0 ] || { printf 'na na na\n'; return; }
  [ "$dt" -le "$maxage" ] || { printf 'na na na\n'; return; }
  if [ "$pin" -lt "$ppin" ] || [ "$pout" -lt "$ppout" ] || [ "$pmf" -lt "$ppmf" ]; then
    printf 'na na na\n'; return
  fi
  printf '%s %s %s\n' "$(( (pin - ppin) / dt ))" "$(( (pout - ppout) / dt ))" "$(( (pmf - ppmf) / dt ))"
}

# fold_pps <inst> <iv|na> -> "<fused> <winner>"  (winner: inst|iv; na loses by default, ties name inst)
# A max that HIDES its disjunction turns "the last 5 minutes averaged 600 pg/s" and "the 3 seconds
# I happened to watch hit 600 pg/s" into the same sentence. They are different claims.
fold_pps() {
  local inst="$1" iv="${2:-na}"
  case "$iv" in ''|na) printf '%s inst\n' "$inst"; return;; esac
  if [ "$iv" -gt "$inst" ] 2>/dev/null; then printf '%s iv\n' "$iv"; else printf '%s inst\n' "$inst"; fi
}

# classify_rate <swap_pps> → echoes "LABEL|reason". Pure/falsifiable, no side effects.
classify_rate() {
  local pps="$1"
  if [ -z "$pps" ] || ! printf '%d' "$pps" >/dev/null 2>&1; then
    echo "UNKNOWN|non-numeric rate (pps=$pps)"; return
  fi
  if   [ "$pps" -lt "$LIGHT_PPS" ];  then echo "IDLE|${pps} pg/s swap I/O — negligible"; return; fi
  if   [ "$pps" -lt "$THRASH_PPS" ]; then echo "LIGHT|${pps} pg/s swap I/O — system coping"; return; fi
  echo "THRASHING|${pps} pg/s swap I/O — heavy sustained swap, performance degrading"
}

if [ "${1:-}" = --test ]; then
  fail=0
  # Pin thresholds so asserts are deterministic regardless of env overrides.
  LIGHT_PPS=20 THRASH_PPS=500
  # classify bands + boundaries (page rate is the sum pswpin_pps+pswpout_pps)
  r="$(classify_rate 0)";   echo "$r" | grep -q '^IDLE'      || { echo "  FAIL IDLE-0: $r"; fail=1; }
  r="$(classify_rate 19)";  echo "$r" | grep -q '^IDLE'      || { echo "  FAIL IDLE-boundary(19): $r"; fail=1; }
  r="$(classify_rate 20)";  echo "$r" | grep -q '^LIGHT'     || { echo "  FAIL LIGHT-boundary(20): $r"; fail=1; }
  r="$(classify_rate 250)"; echo "$r" | grep -q '^LIGHT'     || { echo "  FAIL LIGHT-mid(250): $r"; fail=1; }
  r="$(classify_rate 499)"; echo "$r" | grep -q '^LIGHT'     || { echo "  FAIL LIGHT-boundary(499): $r"; fail=1; }
  r="$(classify_rate 500)"; echo "$r" | grep -q '^THRASHING' || { echo "  FAIL THRASHING-boundary(500): $r"; fail=1; }
  r="$(classify_rate 5000)";echo "$r" | grep -q '^THRASHING' || { echo "  FAIL THRASHING-hi(5000): $r"; fail=1; }
  r="$(classify_rate abc)"; echo "$r" | grep -q '^UNKNOWN'   || { echo "  FAIL UNKNOWN-nonnum: $r"; fail=1; }
  # rate(): floors, never negative, divides by window
  [ "$(rate 100 40 3)" = 20 ] || { echo "  FAIL rate(100,40,3)=20 got=$(rate 100 40 3)"; fail=1; }
  [ "$(rate 40 100 3)" = 0 ]  || { echo "  FAIL rate reset→0 got=$(rate 40 100 3)"; fail=1; }
  [ "$(rate 100 40 0)" = 60 ] || { echo "  FAIL rate dt<1 floored-to-1 got=$(rate 100 40 0)"; fail=1; }
  # --- COVERAGE gates: the across-run interval window and the fold that names its winner -------
  # fold_pps: the max must NAME which window won, and na must never beat a real read.
  [ "$(fold_pps 10 600)"  = "600 iv" ]  || { echo "  FAIL fold_pps 10 600 → $(fold_pps 10 600) (want '600 iv')"; fail=1; }
  [ "$(fold_pps 800 20)"  = "800 inst" ]|| { echo "  FAIL fold_pps 800 20 → $(fold_pps 800 20) (want '800 inst')"; fail=1; }
  [ "$(fold_pps 40 40)"   = "40 inst" ] || { echo "  FAIL fold_pps 40 40 → $(fold_pps 40 40) (want '40 inst' — ties name inst)"; fail=1; }
  [ "$(fold_pps 7 na)"    = "7 inst" ]  || { echo "  FAIL fold_pps 7 na → $(fold_pps 7 na) (want '7 inst')"; fail=1; }
  # interval_rates: a real across-run delta. prev at t=0, now at t=100 with +50000 in / +30000 out
  # / +10000 majflt → 500 / 300 / 100 pg/s.
  r="$(interval_rates "0 0 0 0" 100 50000 30000 10000 1200)"
  [ "$r" = "500 300 100" ] || { echo "  FAIL interval_rates → '$r' (want '500 300 100')"; fail=1; }
  # MISSING EVIDENCE RENDERS na, NEVER 0 — each of these reads as a fabricated calm if it returns 0,
  # and this sense's whole job is to notice that swap I/O is NOT calm.
  r="$(interval_rates "" 100 50000 30000 10000 1200)"
  [ "$r" = "na na na" ] || { echo "  FAIL no baseline (first run) → '$r' (want na — 0 would be a fabricated calm)"; fail=1; }
  r="$(interval_rates "0 99999999 0 0" 100 50000 30000 10000 1200)"
  [ "$r" = "na na na" ] || { echo "  FAIL counter went BACKWARDS (reboot resets pswpin) → '$r' (want na)"; fail=1; }
  r="$(interval_rates "0 0 0 0" 99999 50000 30000 10000 1200)"
  [ "$r" = "na na na" ] || { echo "  FAIL stale baseline past max-age → '$r' (want na — never average across an unobserved gap)"; fail=1; }
  r="$(interval_rates "0 0 garbage 0" 100 50000 30000 10000 1200)"
  [ "$r" = "na na na" ] || { echo "  FAIL garbage state field → '$r' (want na)"; fail=1; }
  r="$(interval_rates "100 0 0 0" 100 50000 30000 10000 1200)"
  [ "$r" = "na na na" ] || { echo "  FAIL dt=0 → '$r' (want na)"; fail=1; }
  [ "$fail" = 1 ] && { echo "smoke-test: FAIL"; exit 1; }
  echo "  ok: classify (8 cases: IDLE×2,LIGHT×3,THRASHING×2,UNKNOWN) + rate (floor/reset/dt-guard)"
  # REAL-READ gate: reachability != producing. /proc/vmstat must be readable AND the three counter
  # fields must parse, AND a live two-sample must yield a FINITE NON-NEGATIVE integer rate (a hollow
  # sense would pass classify yet never read real hardware). Short 1s window keeps --test fast.
  [ -r "$VMSTAT" ] || { echo "smoke-test: n/a (/proc/vmstat unreadable — not Linux? /procfs missing?); classify-logic ok"; exit 2; }
  c1="$(read_counters "$VMSTAT")" || { echo "smoke-test: n/a (vmstat fields absent); classify-logic ok"; exit 2; }
  sleep 1
  c2="$(read_counters "$VMSTAT")" || { echo "smoke-test: n/a (vmstat 2nd read failed); classify-logic ok"; exit 2; }
  in1="${c1%% *}"; out1="$(printf '%s' "$c1" | awk '{print $2}')"
  in2="${c2%% *}"; out2="$(printf '%s' "$c2" | awk '{print $2}')"
  pps=$(( $(rate "$in2" "$in1" 1) + $(rate "$out2" "$out1" 1) ))
  [ "$pps" -ge 0 ] 2>/dev/null || { echo "smoke-test: FAIL (live rate not a non-negative integer: pps=$pps)"; exit 1; }

  # --- STATE ROUND-TRIP: the interval window only exists if run N's counters reach run N+1 ------
  # The pure functions above cannot prove the carry happens. Drive two real runs against a sandbox
  # MESH_DIR (a --test must NEVER write the artifact a watchdog reads for liveness) and assert the
  # coverage WIDENS: run 1 has no baseline (window=inst, pps_iv=null), run 2 must read run 1's raw
  # counters (window=inst+iv, pps_iv numeric). A gate that only checked run 1 passes with the carry
  # deleted.
  _td="$(mktemp -d)"
  _r1="$(MESH_DIR="$_td" SWAP_RATE_WINDOW_S=1 "$0" --json 2>/dev/null)"
  _r2="$(MESH_DIR="$_td" SWAP_RATE_WINDOW_S=1 "$0" --json 2>/dev/null)"
  _w1="$(printf '%s' "$_r1" | sed -n 's/.*"window":"\([a-z+]*\)".*/\1/p')"
  _w2="$(printf '%s' "$_r2" | sed -n 's/.*"window":"\([a-z+]*\)".*/\1/p')"
  _iv2="$(printf '%s' "$_r2" | sed -n 's/.*"pps_iv":\([a-z0-9]*\).*/\1/p')"
  _raw2="$(sed -n 's/.*|raw=\([0-9 ]*\)$/\1/p' "$_td/.swap-rate.state" 2>/dev/null | tail -1)"
  rm -rf "$_td"
  [ "$_w1" = inst ] || { echo "smoke-test: FAIL (run 1 has no baseline but reported window=$_w1 — an interval was invented from nothing)"; exit 1; }
  [ "$_w2" = "inst+iv" ] || { echo "smoke-test: FAIL (run 2 reported window=$_w2 — the accumulator is NOT carried across runs, coverage is still ${WINDOW_S}s/300s)"; exit 1; }
  case "$_iv2" in ''|null) echo "smoke-test: FAIL (run 2 pps_iv=$_iv2 — the interval window produced no reading)"; exit 1;; esac
  [ -n "$_raw2" ] || { echo "smoke-test: FAIL (state file carries no raw= counters — the next run cannot compute an interval)"; exit 1; }

  # --- CONSUMING the interval is not COMPUTING it -----------------------------------------------
  # Seed a baseline that makes the interval unambiguously the loud window (10s ago, 10000 pages
  # behind → 1000 pg/s, THRASHING) and assert the fold NAMES it and the published VERDICT rides on
  # it. Without this the tool can compute a perfect interval, print it, and still classify off the
  # 3s sample — a sub-axis is not the verdict.
  _tf="$(mktemp -d)"
  _now_c="$(read_counters "$VMSTAT")" || { echo "smoke-test: FAIL (vmstat read failed while seeding the fold gate)"; exit 1; }
  set -- $_now_c
  printf 'SEED|raw=%s %s %s %s\n' "$(( $(date +%s) - 10 ))" "$(( $1 - 10000 ))" "$2" "$3" > "$_tf/.swap-rate.state"
  _rf="$(MESH_DIR="$_tf" SWAP_RATE_WINDOW_S=1 "$0" --json 2>/dev/null)"
  rm -rf "$_tf"
  _fwon="$(printf '%s' "$_rf" | sed -n 's/.*"won":"\([a-z]*\)".*/\1/p')"
  _fpps="$(printf '%s' "$_rf" | sed -n 's/.*"swap_pps":\([0-9]*\).*/\1/p')"
  _flab="$(printf '%s' "$_rf" | sed -n 's/.*"label":"\([A-Z]*\)".*/\1/p')"
  [ "$_fwon" = iv ] || { echo "smoke-test: FAIL (seeded a ~1000 pg/s interval but the fold named won=$_fwon — the interval window loses to the ${WINDOW_S}s sample)"; exit 1; }
  [ "${_fpps:-0}" -ge 500 ] 2>/dev/null || { echo "smoke-test: FAIL (interval won but swap_pps=$_fpps — the published rate is not the fold's value)"; exit 1; }
  [ "$_flab" = THRASHING ] || { echo "smoke-test: FAIL (fused rate=$_fpps pg/s but label=$_flab — the verdict does not ride on the fused axis)"; exit 1; }

  echo "smoke-test: ok (classify+rate + interval/fold 11 asserts + REAL two-sample vmstat read: ${pps} pg/s over 1s + across-run carry inst→inst+iv + seeded interval drives the verdict)"
  exit 0
fi

# --- Live read path: two-sample counter delta over WINDOW_S ---
[ -r "$VMSTAT" ] || {
  printf 'UNKNOWN|reason=vmstat-unreadable\n' > "$STATE"; mesh-state-touch "$STATE" 2>/dev/null || touch "$STATE"
  echo "mesh-swap-rate: $VMSTAT not readable (not Linux? /procfs missing?) — not an alarm" >&2
  exit 2
}
t1=$(date +%s); c1="$(read_counters "$VMSTAT")" || {
  printf 'UNKNOWN|reason=vmstat-fields-absent\n' > "$STATE"; mesh-state-touch "$STATE" 2>/dev/null || touch "$STATE"
  echo "mesh-swap-rate: pswpin/pswpout/pgmajfault absent in $VMSTAT — not an alarm" >&2
  exit 2
}
# The PREVIOUS run's raw counters, read before anything overwrites the state file. Absent (first
# run, or a state line written before this field existed) => the interval window renders na.
prev_raw="$(sed -n 's/.*|raw=\([0-9 ]*\)$/\1/p' "$STATE" 2>/dev/null | tail -1)"
sleep "$WINDOW_S"
t2=$(date +%s); c2="$(read_counters "$VMSTAT")" || {
  printf 'UNKNOWN|reason=vmstat-2nd-read-failed\n' > "$STATE"; mesh-state-touch "$STATE" 2>/dev/null || touch "$STATE"
  echo "mesh-swap-rate: 2nd vmstat read failed — not an alarm" >&2
  exit 2
}
dt=$(( t2 - t1 )); [ "$dt" -ge 1 ] || dt="$WINDOW_S"

in1="${c1%% *}"; out1="$(printf '%s' "$c1" | awk '{print $2}')"; mf1="$(printf '%s' "$c1" | awk '{print $3}')"
in2="${c2%% *}"; out2="$(printf '%s' "$c2" | awk '{print $2}')"; mf2="$(printf '%s' "$c2" | awk '{print $3}')"
in_pps="$(rate "$in2" "$in1" "$dt")"
out_pps="$(rate "$out2" "$out1" "$dt")"
mf_pps="$(rate "$mf2" "$mf1" "$dt")"
inst_pps=$(( in_pps + out_pps ))

# --- INTERVAL window: the same counters delta'd against the PREVIOUS run (100% coverage) ---
read -r iv_in iv_out iv_mf <<< "$(interval_rates "$prev_raw" "$t2" "$in2" "$out2" "$mf2" "$MAX_IV_AGE")"
if [ "$iv_in" = na ]; then iv_pps=na; else iv_pps=$(( iv_in + iv_out )); fi

# --- Fold: max that NAMES its winner; the reported detail comes from the SAME window as the verdict
read -r swap_pps won <<< "$(fold_pps "$inst_pps" "$iv_pps")"
if [ "$won" = iv ]; then
  r_in="$iv_in"; r_out="$iv_out"; r_mf="$iv_mf"
else
  r_in="$in_pps"; r_out="$out_pps"; r_mf="$mf_pps"
fi
if [ "$iv_pps" = na ]; then window="inst"; else window="inst+iv"; fi

result="$(classify_rate "$swap_pps")"
label="${result%%|*}"; reason="${result#*|}"
TS=$(date -u +%Y-%m-%dT%H:%M:%SZ)

# additive-fields contract: first |-field is the authoritative LABEL (first-token consumers untouched);
# write + touch liveness on EVERY successful run (mtime=ran-live, content=value-changed).
# The trailing |raw= carries the accumulator to the NEXT run — it is the whole interval window.
printf '%s|swap_pps=%s|in_pps=%s|out_pps=%s|majflt_pps=%s|window=%s|pps_inst=%s|pps_iv=%s|won=%s|sample_s=%ss|raw=%s %s %s %s\n' \
  "$label" "$swap_pps" "$r_in" "$r_out" "$r_mf" "$window" "$inst_pps" "$iv_pps" "$won" "$dt" \
  "$t2" "$in2" "$out2" "$mf2" > "$STATE"
mesh-state-touch "$STATE" 2>/dev/null || touch "$STATE"

# --edge: only emit to stdout when the LABEL changes (for quiet cron wiring); state always written above.
if [ "${1:-}" = --edge ]; then
  prev=""; [ -f "$MESH_DIR/.swap-rate.edge" ] && prev="$(head -1 "$MESH_DIR/.swap-rate.edge")"
  printf '%s\n' "$label" > "$MESH_DIR/.swap-rate.edge"
  [ "$label" = "$prev" ] && exit 0
fi

if [ "${1:-}" = --json ]; then
  printf '{"label":"%s","swap_pps":%s,"in_pps":%s,"out_pps":%s,"majflt_pps":%s,"window":"%s","pps_inst":%s,"pps_iv":%s,"won":"%s","sample_s":%s,"ts":"%s"}\n' \
    "$label" "$swap_pps" "$r_in" "$r_out" "$r_mf" "$window" "$inst_pps" \
    "$([ "$iv_pps" = na ] && echo null || echo "$iv_pps")" "$won" "$dt" "$TS"
  exit 0
fi
printf '[swap-rate-%s] %s — swap %s pg/s (in=%s out=%s) majflt=%s/s | window=%s inst=%s iv=%s won=%s (sample %ss) | %s\n' \
  "$(printf '%s' "$label" | tr '[:upper:]' '[:lower:]')" "$label" "$swap_pps" "$r_in" "$r_out" "$r_mf" \
  "$window" "$inst_pps" "$iv_pps" "$won" "$dt" "$reason"
