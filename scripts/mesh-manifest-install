#!/usr/bin/env bash
# Install manifest-declared tools and the setup.sh legacy exceptions.
set -euo pipefail

repo=${MESH_REPO:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}
repo=$(cd "$repo" && pwd -P)
manifest="$repo/scripts/mesh-manifest"
bin=${MESH_BIN:-$HOME/.local/bin}
systemd_dir=${MESH_SYSTEMD_DIR:-$HOME/.config/systemd/user}

if [[ ! -x "$manifest" ]]; then
  echo "mesh-manifest-install: missing executable manifest: $manifest" >&2
  exit 1
fi
MESH_REPO="$repo" "$manifest" --check

source_for_explicit() {
  local basename=$1 expected_policy=$2 rows source_path policy
  [[ "$basename" != */* && -n "$basename" ]] || {
    echo "mesh-manifest-install: expected a basename, got '$basename'" >&2
    return 1
  }
  rows=$(MESH_REPO="$repo" "$manifest" --list | awk -F '\t' -v basename="$basename" \
    'NR > 2 { n = split($1, parts, "/"); if (parts[n] == basename) printf "%s\034%s\n", $1, $5 }')
  [[ -n "$rows" ]] || {
    echo "mesh-manifest-install: '$basename' is absent from the manifest" >&2
    return 1
  }
  [[ "$rows" != *$'\n'* ]] || {
    echo "mesh-manifest-install: '$basename' is ambiguous in the manifest" >&2
    return 1
  }
  IFS=$'\034' read -r source_path policy <<< "$rows"
  [[ "$expected_policy" == any && ( "$policy" == install || "$policy" == none ) || "$policy" == "$expected_policy" ]] || {
    echo "mesh-manifest-install: '$basename' has policy '$policy', expected '$expected_policy'" >&2
    return 1
  }
  printf '%s/%s\n' "$repo" "$source_path"
}

install_tools() {
  mkdir -p "$bin"
  while IFS=$'\034' read -r source_path basename; do
    [[ -n "$basename" ]] || continue
    source="$repo/$source_path"
    [[ -f "$source" ]] || { echo "mesh-manifest-install: missing source $source" >&2; return 1; }
    rm -f "$bin/$basename"
    ln -s "$source" "$bin/$basename"
  done < <(MESH_REPO="$repo" "$manifest" --list | awk -F '\t' 'NR > 2 && $5 == "install" { printf "%s\034%s\n", $1, $2 }')
}

copy_explicit() {
  local destination_dir=$1 expected_policy=$2 mode=$3 basename source
  shift 3
  mkdir -p "$destination_dir"
  for basename in "$@"; do
    source=$(source_for_explicit "$basename" "$expected_policy") || return
    [[ -f "$source" ]] || { echo "mesh-manifest-install: missing source $source" >&2; return 1; }
    rm -f "$destination_dir/$basename"
    if [[ "$mode" == executable ]]; then
      cp "$source" "$destination_dir/$basename"
      chmod 755 "$destination_dir/$basename"
    else
      cp "$source" "$destination_dir/$basename"
      chmod 644 "$destination_dir/$basename"
    fi
  done
}

rollback_tools() {
  local basename source target
  while IFS=$'\034' read -r source_path basename; do
    [[ -n "$basename" ]] || continue
    source="$repo/$source_path"
    target="$bin/$basename"
    if [[ -L "$target" && "$(readlink "$target")" == "$source" ]]; then
      rm "$target"
    fi
  done < <(MESH_REPO="$repo" "$manifest" --list | awk -F '\t' 'NR > 2 && $5 == "install" { printf "%s\034%s\n", $1, $2 }')
}

rollback_explicit() {
  local destination_dir=$1 expected_policy=$2 basename source target
  shift 2
  for basename in "$@"; do
    source=$(source_for_explicit "$basename" "$expected_policy") || return
    target="$destination_dir/$basename"
    if [[ -f "$target" && ! -L "$target" ]] && cmp -s "$source" "$target"; then
      rm "$target"
    fi
  done
}

usage() {
  echo "usage: mesh-manifest-install {tools|legacy-bin <basename...>|units <basename...>|rollback-tools|rollback-legacy-bin <basename...>|rollback-units <basename...>}" >&2
}

case "${1:-}" in
  tools) [[ $# -eq 1 ]] || { usage; exit 2; }; install_tools ;;
  legacy-bin) shift; [[ $# -gt 0 ]] || { usage; exit 2; }; copy_explicit "$bin" any executable "$@" ;;
  units) shift; [[ $# -gt 0 ]] || { usage; exit 2; }; copy_explicit "$systemd_dir" systemd data "$@" ;;
  rollback-tools) [[ $# -eq 1 ]] || { usage; exit 2; }; rollback_tools ;;
  rollback-legacy-bin) shift; [[ $# -gt 0 ]] || { usage; exit 2; }; rollback_explicit "$bin" any "$@" ;;
  rollback-units) shift; [[ $# -gt 0 ]] || { usage; exit 2; }; rollback_explicit "$systemd_dir" systemd "$@" ;;
  *) usage; exit 2 ;;
esac
