#!/usr/bin/env bash
# mesh-chaos-consumer — bounded opt-in consumer for mesh-chaos-emu.
#
# This is an owner-routed acceptance path, not a live-service reflex: invoke it explicitly with
# `--owner <tool>/<window> --run`. It always gives the emulator a private temporary state directory,
# drives two deterministic rc=75 failures, then lets the wrapped command run on attempt three, and
# writes the consumer's transition artifact to MESH_CHAOS_CONSUMER_OUTCOME (or ~/.mesh/.../outcome.log).
set -u -o pipefail

usage() {
  cat <<'EOF'
usage: mesh-chaos-consumer --owner <tool>/<window> --run

Run one isolated consumer acceptance sample for scripts/mesh-chaos-emu.
EOF
}

if [ "${1:-}" = --test ]; then
  _test_dir="$(mktemp -d -t mesh-chaos-consumer-test.XXXXXXXX)" || exit 1
  trap 'rm -rf "$_test_dir"' EXIT TERM INT
  _test_out="$_test_dir/outcome.log"
  MESH_CHAOS_CONSUMER_OUTCOME="$_test_out" "$0" --owner mesh-chaos-emu/genome --run >/dev/null || exit 1
  grep -q '^attempt=1 transition=retry rc=75$' "$_test_out" || exit 1
  grep -q '^attempt=2 transition=retry rc=75$' "$_test_out" || exit 1
  grep -q '^attempt=3 transition=recovered rc=0$' "$_test_out" || exit 1
  grep -q '^final_rc=0$' "$_test_out" || exit 1
  grep -q '^attempts=3$' "$_test_out" || exit 1
  echo 'mesh-chaos-consumer: smoke-test PASS (owner-routed isolated fail-first/recovery consumer)'
  exit 0
fi

owner=""
run=0
while [ "$#" -gt 0 ]; do
  case "$1" in
    --owner) owner="${2:?--owner needs a value}"; shift 2 ;;
    --run) run=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "mesh-chaos-consumer: unknown argument '$1'" >&2; usage >&2; exit 2 ;;
  esac
done

[ "$run" = 1 ] || { usage >&2; exit 2; }
case "$owner" in
  [A-Za-z][A-Za-z0-9._+-]*/[A-Za-z][A-Za-z0-9._+-]*) : ;;
  *) echo "mesh-chaos-consumer: --owner must be <tool>/<window>" >&2; exit 2 ;;
esac

here="$(cd "$(dirname "$0")" && pwd)"
emu="${MESH_CHAOS_EMU_BIN:-$here/mesh-chaos-emu}"
[ -x "$emu" ] || { echo "mesh-chaos-consumer: emulator is not executable: $emu" >&2; exit 2; }

out="${MESH_CHAOS_CONSUMER_OUTCOME:-$HOME/.mesh/chaos-consumer/outcome.log}"
mkdir -p "$(dirname "$out")" || { echo "mesh-chaos-consumer: cannot create outcome directory" >&2; exit 1; }
tmp="$(mktemp -d -t mesh-chaos-consumer.XXXXXXXX)" || exit 1
trap 'rm -rf "$tmp"' EXIT TERM INT
export MESH_CHAOS_EMU_DIR="$tmp/state"
scenario="consumer-acceptance"

{
  printf 'owner=%s\n' "$owner"
  printf 'subject=scripts/mesh-chaos-emu\n'
  printf 'state=MESH_CHAOS_EMU_DIR=<temporary isolated directory>\n'
} >"$out" || { echo "mesh-chaos-consumer: cannot write outcome: $out" >&2; exit 1; }

for attempt in 1 2; do
  "$emu" --id "$scenario" --fail-first 2 --rc 75 -- true >/dev/null 2>&1
  rc=$?
  [ "$rc" = 75 ] || {
    printf 'attempt=%s transition=failed rc=%s\n' "$attempt" "$rc" >>"$out"
    echo "mesh-chaos-consumer: fail-first attempt $attempt returned rc=$rc (want 75)" >&2
    exit 1
  }
  printf 'attempt=%s transition=retry rc=%s\n' "$attempt" "$rc" >>"$out"
done

"$emu" --id "$scenario" --fail-first 2 --rc 75 -- sh -c 'exit 0' >/dev/null 2>&1
final_rc=$?
if [ "$final_rc" = 0 ]; then
  printf 'attempt=3 transition=recovered rc=0\n' >>"$out"
else
  printf 'attempt=3 transition=failed rc=%s\n' "$final_rc" >>"$out"
  echo "mesh-chaos-consumer: recovery attempt returned rc=$final_rc" >&2
  exit 1
fi

printf 'final_rc=0\nattempts=%s\n' "$("$emu" --count "$scenario")" >>"$out"
[ -s "$out" ] || { echo "mesh-chaos-consumer: empty outcome artifact: $out" >&2; exit 1; }
printf 'admitted owner=%s subject=scripts/mesh-chaos-emu outcome=%s\n' "$owner" "$out"
