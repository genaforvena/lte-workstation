[Unit]
Description=mesh-tuner-eye — camera trigger: a guitar/cello in frame → say "запускаю тюнер" + run mesh-tuner --loop; gone → stop it
# The vision watcher (Groq qwen, ~3 frames/min) is the ONLY always-on piece; mesh-tuner --loop runs
# transiently, only while an instrument is held — so it never becomes a 2nd always-on mic listener
# contending with mesh-overhear. Camera-consent gated ($MESH/consent camera=yes). Node: default-string.
After=default.target

[Service]
Type=simple
ExecStart=%h/.local/bin/mesh-tuner-eye --loop
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
