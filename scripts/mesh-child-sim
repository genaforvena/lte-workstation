#!/usr/bin/env bash
# mesh-child-sim — STUDY(self-replication), in-repo simulation only.
# reflex-cadence: 17,47 * * * *
#
# Answers the idea-queue brief 2026-07-07T17:23:02Z: "periodically generate 'child' nodes for
# simulation purposes by cloning existing worker configurations". This is a POPULATION-DYNAMICS
# SIMULATION, not real self-replication: a "child" is a JSON descriptor written to
# ~/.mesh/sim-children/ — a clone of one existing worker (mind-channel) config from restore.env's
# MESH_MIND_CHANNELS set, with a small mutation (engine flip / generation bump). Nothing executes:
# no tmux window, no process, no SSH, no network call, no new tailnet node ever comes into being.
# Every real mesh-* generator that spawns a live thing (mesh-restore, mesh-generate, mesh-autowire)
# stays the ONLY path to real capability; this tool exists to let the mesh STUDY replication/
# population pressure (feed genome the shape of "what would runaway growth look like") without
# actually doing it — the operator-doctrine line for any self-replication study: simulate, don't do.
#
# Hard population cap (default 8, override MESH_CHILD_SIM_CAP) is enforced on every tick: once at
# cap, a new birth culls the single lowest-fitness child first (fitness = synthetic score written at
# birth, mutated ±1 each clone) so the population OSCILLATES around the cap instead of growing
# unbounded — the one property that makes "periodic + self-replicating" safe to cron at all. A tick
# with the population already at cap and nothing worse than the newest still performs a birth+cull
# (net zero), so state visibly changes every run without the count ever exceeding the cap.
#
#   mesh-child-sim              one generation tick: clone one parent, cull to cap, print summary
#   mesh-child-sim --status     show current simulated population (count, generations, lineage)
#   mesh-child-sim --reset      wipe the simulated population (local sim state only)
#   mesh-child-sim --test       hermetic smoke test (own temp dir, never touches real state)
set -uo pipefail

CAP="${MESH_CHILD_SIM_CAP:-8}"
DIR="${MESH_CHILD_SIM_DIR:-$HOME/.mesh/sim-children}"
LOG="$DIR/.log"

# the "worker configurations" being cloned: the live mind-channel set this node would restore, per
# the CLAUDE.md channel-set doctrine (minds/genome/tg/senses/health/chat), engine-tagged. This is
# read-only reference data — cloning never touches restore.env or any real channel.
seed_workers(){
  cat <<'EOF'
minds:claude
genome:claude
tg:claude
senses:opencode
health:opencode
chat:opencode
EOF
}

mkdir -p "$DIR" 2>/dev/null || true

now(){ date -u +%Y-%m-%dT%H:%M:%SZ; }

# synthetic fitness: stable hash of the descriptor's own name into 0-99, so re-running --status
# is deterministic (no Date.now/RANDOM dependency at read time) while birth-time fitness still
# varies clone-to-clone (mixed with $RANDOM at write time only).
score_of(){ printf '%s' "$1" | cksum | awk '{print $1 % 100}'; }

population(){ find "$DIR" -maxdepth 1 -name '*.json' -type f 2>/dev/null | sort; }

pop_count(){ population | wc -l | tr -d ' '; }

# cull the single lowest-fitness child (ties broken by oldest generation file) until at/under CAP.
cull_to_cap(){
  local n; n=$(pop_count)
  while [ "$n" -gt "$CAP" ]; do
    local worst="" worst_score=101 f fscore
    for f in $(population); do
      fscore=$(grep -o '"fitness": *[0-9]*' "$f" 2>/dev/null | grep -o '[0-9]*$')
      [ -z "$fscore" ] && fscore=0
      if [ "$fscore" -lt "$worst_score" ]; then worst_score=$fscore; worst="$f"; fi
    done
    [ -z "$worst" ] && break
    rm -f "$worst"
    echo "$(now) cull $(basename "$worst") fitness=$worst_score" >>"$LOG"
    n=$(pop_count)
  done
}

birth(){
  local parents_pool parent gen=0 engine child_id child_file fitness mutated_engine
  # parent pool = live worker seeds + any existing children (children of children => generations grow)
  parents_pool="$(seed_workers | awk -F: '{print $1":"$2":0"}')"
  if [ "$(pop_count)" -gt 0 ]; then
    parents_pool="$parents_pool
$(for f in $(population); do
    nm=$(grep -o '"name": *"[^"]*"' "$f" | sed 's/.*"\(.*\)"$/\1/')
    en=$(grep -o '"engine": *"[^"]*"' "$f" | sed 's/.*"\(.*\)"$/\1/')
    gn=$(grep -o '"generation": *[0-9]*' "$f" | grep -o '[0-9]*$')
    echo "$nm:$en:${gn:-0}"
  done)"
  fi
  parent="$(echo "$parents_pool" | shuf -n1 2>/dev/null || echo "$parents_pool" | head -1)"
  local pname pengine pgen
  pname="${parent%%:*}"; local rest="${parent#*:}"; pengine="${rest%%:*}"; pgen="${rest##*:}"
  gen=$((pgen + 1))
  # mutation: 1-in-4 chance the clone's engine flips (claude<->opencode) — the only "variation" a
  # child carries over its parent's config; everything else (name lineage, generation) is exact clone+1.
  mutated_engine="$pengine"
  if [ $((RANDOM % 4)) -eq 0 ]; then
    [ "$pengine" = "claude" ] && mutated_engine="opencode" || mutated_engine="claude"
  fi
  child_id="${pname}-g${gen}-$$-${RANDOM}"
  fitness=$(( ($(score_of "$child_id") + RANDOM % 20 - 10 + 200) % 100 ))
  child_file="$DIR/${child_id}.json"
  cat >"$child_file" <<EOF
{
  "name": "$child_id",
  "parent": "$pname",
  "generation": $gen,
  "engine": "$mutated_engine",
  "fitness": $fitness,
  "born_at": "$(now)",
  "note": "SIMULATED — no real process/window/node was created; data-only clone for self-replication study"
}
EOF
  echo "$(now) birth $child_id parent=$pname gen=$gen engine=$mutated_engine fitness=$fitness" >>"$LOG"
  echo "$child_file"
}

status(){
  local n; n=$(pop_count)
  echo "mesh-child-sim: population=$n / cap=$CAP  dir=$DIR"
  [ "$n" -eq 0 ] && { echo "  (empty — run 'mesh-child-sim' to birth+cull one generation tick)"; return 0; }
  for f in $(population); do
    local nm gn en fi
    nm=$(grep -o '"name": *"[^"]*"' "$f" | sed 's/.*"\(.*\)"$/\1/')
    gn=$(grep -o '"generation": *[0-9]*' "$f" | grep -o '[0-9]*$')
    en=$(grep -o '"engine": *"[^"]*"' "$f" | sed 's/.*"\(.*\)"$/\1/')
    fi=$(grep -o '"fitness": *[0-9]*' "$f" | grep -o '[0-9]*$')
    echo "  gen=$gn  $nm  engine=$en  fitness=$fi"
  done
}

case "${1:-}" in
  --status)
    status
    exit 0
    ;;
  --reset)
    rm -rf "${DIR:?}"/*.json "$LOG" 2>/dev/null
    echo "mesh-child-sim: population reset (0/$CAP)"
    exit 0
    ;;
  --test)
    f=0
    T="$(mktemp -d)"; trap 'rm -rf "$T"' EXIT
    export MESH_CHILD_SIM_DIR="$T/sim-children" MESH_CHILD_SIM_CAP=3
    "$0" >/dev/null || { echo "  FAIL: first tick errored"; f=1; }
    [ "$(find "$MESH_CHILD_SIM_DIR" -maxdepth 1 -name '*.json' | wc -l | tr -d ' ')" = 1 ] \
      || { echo "  FAIL: expected 1 child after 1 tick"; f=1; }
    for i in 1 2 3 4 5 6 7 8; do "$0" >/dev/null || { echo "  FAIL: tick $i errored"; f=1; }; done
    n=$(find "$MESH_CHILD_SIM_DIR" -maxdepth 1 -name '*.json' | wc -l | tr -d ' ')
    [ "$n" -le 3 ] || { echo "  FAIL: population $n exceeded cap 3 after 9 ticks — cull didn't hold"; f=1; }
    [ "$n" -ge 1 ] || { echo "  FAIL: population collapsed to 0 — cull over-culled"; f=1; }
    out="$("$0" --status)"
    echo "$out" | grep -q "population=$n / cap=3" || { echo "  FAIL: --status mismatch: $out"; f=1; }
    "$0" --reset >/dev/null
    [ "$("$0" --status)" = "mesh-child-sim: population=0 / cap=3  dir=$MESH_CHILD_SIM_DIR
  (empty — run 'mesh-child-sim' to birth+cull one generation tick)" ] \
      || { echo "  FAIL: --reset didn't empty population"; f=1; }
    # confirm the tool never touches the real ~/.mesh/sim-children during --test (sandboxed)
    [ -e "$HOME/.mesh/sim-children/.log" ] && { echo "  NOTE: real sim dir pre-exists from a prior live run (not a test leak — MESH_CHILD_SIM_DIR was exported for every call above)"; }
    [ "$f" = 0 ] && echo "smoke-test: ok (birth:1 + cap-hold:9-ticks + status:1 + reset:1 assertions, hermetic temp dir)" || { echo "smoke-test: FAIL"; exit 1; }
    exit 0
    ;;
  "")
    child="$(birth)"
    cull_to_cap
    n=$(pop_count)
    echo "mesh-child-sim: birthed $(basename "$child" .json)  population=$n/$CAP"
    exit 0
    ;;
  *)
    echo "usage: mesh-child-sim [--status|--reset|--test]" >&2
    exit 2
    ;;
esac
