#!/usr/bin/env bash
# mesh-imac-wifi — iMac WiFi link quality + RSSI-swing motion proxy.
# Polls `airport -I` over SSH (ilya@192.168.8.214, LAN only), extracts agrCtlRSSI /
# agrCtlNoise / lastTxRate, maintains a short rolling trend, and derives a STABLE/MOTION
# label when RSSI swings exceed the measurement noise floor.
#
# Why: iMac has no BLE LE scan (Bluetooth Low Energy Supported: No — only static paired
# devices, not a live scan). WiFi RSSI variance is the viable motion proxy: multipath on
# the AP↔iMac path changes when people move nearby. Cross-validates with IdeaPad
# mesh-wifi-link and phone GPS for multi-vantage triangulation.
# reflex-cadence: */2 * * * *
# reflex-args: --edge
#
# Labels:
#   STABLE   — RSSI swing < SWING_THRESH dBm over last N readings (environment quiet)
#   MOTION   — RSSI swing ≥ SWING_THRESH dBm (multipath change, possible occupancy/movement)
#   WEAK     — SNR (RSSI − noise) < SNR_WEAK dBm (poor link quality, readings less reliable)
#
# Exit codes (honest-exit contract):
#   0 = real reading from iMac airport
#   2 = iMac unreachable or parse failed — never faked
#
#   mesh-imac-wifi           one-line status
#   mesh-imac-wifi --status  full reading + trend
#   mesh-imac-wifi --edge    emit only on label change (for cron/stream wiring)
#   mesh-imac-wifi --json    machine-readable
#   mesh-imac-wifi --test    smoke test
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

IMAC_HOST="${MESH_IMAC_HOST:-ilya@192.168.8.214}"
AIRPORT="/System/Library/PrivateFrameworks/Apple80211.framework/Versions/Current/Resources/airport"
TREND_FILE="$HOME/.mesh/.imac-wifi-trend"
STATE_FILE="$HOME/.mesh/.imac-wifi-state"
TREND_LEN="${MESH_IMAC_WIFI_TREND:-8}"       # rolling window size (readings)
SWING_THRESH="${MESH_IMAC_WIFI_SWING:-5}"    # dBm swing that triggers MOTION label
SNR_WEAK="${MESH_IMAC_WIFI_SNR_WEAK:-20}"    # SNR below which link is WEAK
IMAC_WIFI_TAPE="${MESH_IMAC_WIFI_TAPE:-$HOME/.mesh/wifi-imac.log}"  # cross-node correlation tape

# dBm RSSI -> 0-100 link quality. The cross-node tape (wifi-imac.log) must share wifi.log's nmcli 0-100
# vocab so the correlation family ingests both vantages on ONE unit scale — feeding raw NEGATIVE dBm
# would sign-flip this channel and INVERT its correlation sign vs the 0-100 IdeaPad channels (the
# cross-sense-vocab-contract trap). 2*(dBm+100) clamped: -100dBm->0, -50->100, monotonic with signal.
dbm_to_qual(){ local q=$(( 2 * ($1 + 100) )); [ "$q" -lt 0 ] && q=0; [ "$q" -gt 100 ] && q=100; printf '%s' "$q"; }

# local_starved [injected_load] -> 1 if THIS box's load1 > threshold (MESH_LOAD_GATE_MAX or nproc*0.9 —
# the operator's ssh-starvation threshold, same convention as mesh-load-gate but WITHOUT its shed-log
# side effect). WHY it matters here: probe_port22 (timeout 3 /dev/tcp:22) and reach_class's ssh are BOTH
# local probes; under a CPU burst (load44) they time out, probe_port22 returns 'closed', and classify_reach
# would brand the iMac 'down' → UNREACHABLE → the launderable "off-LAN" claim mesh-desk-state turns into a
# false operator-AWAY. A starved local probe is NOT evidence the iMac is off — it's evidence WE couldn't
# ask (sibling of mesh-fleet-health's faked all-DOWN). Load unreadable -> 0: fail toward the honest verdict.
local_starved() {
  local l1 thr nproc
  l1="${MESH_IMAC_FORCE_LOAD:-$(awk '{print $1}' /proc/loadavg 2>/dev/null)}"
  printf '%f' "$l1" >/dev/null 2>&1 || { echo 0; return; }
  nproc="$(nproc 2>/dev/null)"; [ "${nproc:-0}" -gt 0 ] 2>/dev/null || nproc=1
  thr="${MESH_LOAD_GATE_MAX:-$(awk -v n="$nproc" 'BEGIN{printf "%.1f", n*0.9}')}"
  [ "$(awk "BEGIN{print ($l1 > $thr) ? 1 : 0}")" = 1 ] && echo 1 || echo 0
}

# "The iMac is off-LAN" and "the iMac rejected our key" are DIFFERENT CLAIMS, and only one of them
# is about the iMac. An SSH that fails is not evidence of an absent host: sshd answering with a key
# rejection PROVES the host is up, on-LAN, and serving. Collapsing every ssh failure into "off-LAN"
# (as this tool did until 2026-07-15) mints a cause it never verified — and it is the WORSE kind of
# wrong, because "off-LAN" reads as an environmental fact nobody can act on, while the truth was an
# ACCESS regression on THIS node that a key install fixes. It hid for a day: the ideapad->mesh-home
# migration never carried the SSH identity, so every iMac sense has been dark since 2026-07-14 while
# logging a tidy "off-LAN" (341 lines, 2 distinct — the dead-lane signature), Bruno went unobservable,
# and mesh-desk-state stood ready to launder it into AWAY — a false claim about where the OPERATOR is.
# Classify before naming a cause; when unsure say so.
#   down       — no TCP:22, local NOT starved (genuinely off-LAN, asleep, or sshd stopped) → the only honest "off-LAN"
#   loadstarve — no TCP:22 but THIS box is CPU-starved → the closed probe is untrustworthy; NO off-LAN claim
#   noauth     — TCP:22 open, sshd refused our credentials → our-side access regression, iMac is UP
#   other      — TCP:22 open, SSH failed for some other reason → unclassified, never guess
# A TCP:22 that ANSWERS proves the host is up regardless of local load, so starvation only downgrades the
# closed→down path (the one that mints "off-LAN"); noauth/other are already non-positive and stay as-is.
classify_reach(){  # $1 = open|closed (TCP:22)   $2 = ssh stderr text   $3 = starved(0|1, default 0)
  if [ "$1" != open ]; then
    [ "${3:-0}" = 1 ] && { printf 'loadstarve'; return 0; }
    printf 'down'; return 0
  fi
  case "$2" in
    *"Permission denied"*|*"Too many authentication failures"*|*"no mutual signature algorithm"*|\
    *"Host key verification failed"*|*"no matching host key"*|*"Authentication failed"*) printf 'noauth' ;;
    *) printf 'other' ;;
  esac
}

probe_port22(){  # $1 = host[:port-less] → open|closed. /dev/tcp: no nc dependency.
  timeout "${MESH_IMAC_PORT_TIMEOUT:-3}" bash -c "exec 3<>/dev/tcp/${1}/22" 2>/dev/null \
    && printf 'open' || printf 'closed'
}

reach_class(){  # live classification of the configured IMAC_HOST
  local hp err; hp="${IMAC_HOST#*@}"
  err="$(timeout "${MESH_IMAC_SSH_TIMEOUT:-8}" ssh -o BatchMode=yes -o ConnectTimeout=5 \
         "$IMAC_HOST" true 2>&1)"
  classify_reach "$(probe_port22 "$hp")" "$err" "$(local_starved)"
}

# Honest-degraded state on the --edge reflex path. When the iMac drops the tool exits 2 BEFORE the
# normal --edge writer runs — leaving .imac-wifi-state FROZEN at its last positive label (e.g. STABLE),
# a stale-POSITIVE artifact that lies about a vanished source (the honest-degraded doctrine: a dead
# input must render visibly different from a live all-clear). Mark the state dark (edge-deduped:
# emit the transition once, then just refresh mtime) so any reader/aging sees DARK, not faked STABLE.
# The token carries the CLASS, so a consumer can tell an absent iMac from an unreachable-to-US one;
# NOAUTH/UNCLASSIFIED are deliberately new tokens — an UNREACHABLE-matching consumer falls through to
# its own unknown branch, which is the safe direction (no positive claim) rather than a false AWAY.
# Only the --edge mode owns this file; other modes (--json/--status) stay pure exit-2, no side-effect.
mark_unreach(){  # $1 = invocation mode  $2 = class (down|noauth|other)
  [ "${1:-}" = --edge ] || return 0
  local class="${2:-down}" tok msg
  case "$class" in
    noauth) tok=NOAUTH;       msg='[imac-wifi] NOAUTH — iMac is UP and sshd is serving; it rejected our key. ACCESS regression on THIS node (no SSH identity since the ideapad->mesh-home migration) — the iMac is present, we lost our way in. Fix: install the mesh-home pubkey on '"${IMAC_HOST}" ;;
    other)  tok=UNCLASSIFIED; msg='[imac-wifi] UNCLASSIFIED — TCP:22 open but SSH failed for an unrecognised reason (sense dark; cause NOT determined)' ;;
    loadstarve) tok=LOADSTARVE; msg='[imac-wifi] LOADSTARVE — local CPU burst starved our own TCP:22 probe; cannot tell an absent iMac from a could-not-ask. Sense dark, NO reachability claim (self-heals when load drops).' ;;
    *)      tok=UNREACHABLE;  msg='[imac-wifi] UNREACHABLE — no TCP:22 on '"${IMAC_HOST#*@}"' (iMac off-LAN/asleep — link sense dark, not faked)' ;;
  esac
  local prev; prev="$(cat "$STATE_FILE" 2>/dev/null || echo "")"
  if [ "$prev" != "$tok" ]; then
    printf '%s\n' "$tok" > "$STATE_FILE"
    printf '%s\n' "$msg"
  else
    mesh-state-touch "$STATE_FILE" 2>/dev/null || true   # unchanged class → refresh liveness via shared primitive (chat-review/state-touch-adoption)
  fi
}

# ---- Smoke test ----
[ "${1:-}" = --test ] && {
  # Honest-degraded state (pure logic, always runs — placed before the SSH branch split): the --edge
  # unreachable path must write UNREACHABLE, never leave a stale-positive label. Hermetic temp state.
  ( STATE_FILE="$(mktemp)"; printf 'STABLE\n' > "$STATE_FILE"
    mark_unreach --edge >/dev/null
    [ "$(cat "$STATE_FILE")" = UNREACHABLE ] || { echo "smoke-test: FAIL (mark_unreach --edge: state=$(cat "$STATE_FILE"), want UNREACHABLE)"; rm -f "$STATE_FILE"; exit 1; }
    rm -f "$STATE_FILE" ) || exit 1
  # Non-edge mode must NOT touch state (no side-effect on --json/--status callers like zonemap).
  ( STATE_FILE="$(mktemp)"; printf 'STABLE\n' > "$STATE_FILE"
    mark_unreach --json >/dev/null
    [ "$(cat "$STATE_FILE")" = STABLE ] || { echo "smoke-test: FAIL (mark_unreach --json mutated state)"; rm -f "$STATE_FILE"; exit 1; }
    rm -f "$STATE_FILE" ) || exit 1
  # Cause-classification gate (pure, hermetic). The old negative control below accepted ANY ssh
  # failure as "iMac unreachable — ok", so it passed green against a year of false off-LAN; a gate
  # that cannot tell the two apart asserts nothing. Assert the distinction itself.
  [ "$(classify_reach closed 'ssh: connect to host 192.168.8.214 port 22: No route to host')" = down ] \
    || { echo "smoke-test: FAIL (no TCP:22 must classify down)"; exit 1; }
  [ "$(classify_reach open 'ilya@192.168.8.214: Permission denied (publickey,password,keyboard-interactive).')" = noauth ] \
    || { echo "smoke-test: FAIL (sshd rejecting our key must classify noauth, NOT down — the false off-LAN bug)"; exit 1; }
  [ "$(classify_reach open 'ssh: connect to host x port 22: Connection timed out')" = other ] \
    || { echo "smoke-test: FAIL (open:22 + unrecognised ssh error must classify other, never guess down)"; exit 1; }
  # Local-starvation guard (sibling of mesh-fleet-health's faked all-DOWN): a closed TCP:22 while THIS box
  # is CPU-starved is NOT evidence the iMac is off — our own probe starved. Must classify loadstarve, never
  # the launderable 'down'/off-LAN. A TCP:22 that ANSWERS proves the host up, so starvation must NOT touch
  # noauth (that's the RED-first pair: the bug would either ignore starved on closed, or over-apply it on open).
  [ "$(classify_reach closed 'ssh: connect to host 192.168.8.214 port 22: Connection timed out' 1)" = loadstarve ] \
    || { echo "smoke-test: FAIL (closed TCP:22 under local starvation must classify loadstarve, not a faked off-LAN down)"; exit 1; }
  [ "$(classify_reach closed 'ssh: connect ... No route to host' 0)" = down ] \
    || { echo "smoke-test: FAIL (closed TCP:22, calm box must still classify down — never mask a real off-LAN)"; exit 1; }
  [ "$(classify_reach open 'ilya@x: Permission denied (publickey).' 1)" = noauth ] \
    || { echo "smoke-test: FAIL (TCP:22 answered = host PROVEN up; starvation must NOT downgrade noauth)"; exit 1; }
  [ "$(MESH_IMAC_FORCE_LOAD=999 local_starved)" = 1 ] || { echo "smoke-test: FAIL (load 999 must read STARVED)"; exit 1; }
  [ "$(MESH_IMAC_FORCE_LOAD=0.1 local_starved)" = 0 ] || { echo "smoke-test: FAIL (load 0.1 must read calm)"; exit 1; }
  [ "$(MESH_IMAC_FORCE_LOAD=abc local_starved)" = 0 ] || { echo "smoke-test: FAIL (unreadable load must fail toward the honest verdict)"; exit 1; }
  # loadstarve token must render LOADSTARVE, never mint off-LAN.
  ( STATE_FILE="$(mktemp)"; _m="$(mark_unreach --edge loadstarve)"
    case "$_m" in *off-LAN*) echo "smoke-test: FAIL (loadstarve claimed off-LAN — the cause it never verified)"; rm -f "$STATE_FILE"; exit 1 ;; esac
    case "$_m" in *LOADSTARVE*) : ;; *) echo "smoke-test: FAIL (loadstarve must render LOADSTARVE: $_m)"; rm -f "$STATE_FILE"; exit 1 ;; esac
    [ "$(cat "$STATE_FILE")" = LOADSTARVE ] || { echo "smoke-test: FAIL (loadstarve state token: want LOADSTARVE, got $(cat "$STATE_FILE"))"; rm -f "$STATE_FILE"; exit 1; }
    rm -f "$STATE_FILE" ) || exit 1
  # A noauth must NOT mint the word off-LAN, and must name the actionable cause.
  ( STATE_FILE="$(mktemp)"; _m="$(mark_unreach --edge noauth)"
    case "$_m" in *off-LAN*) echo "smoke-test: FAIL (noauth claimed off-LAN — the cause it never verified)"; rm -f "$STATE_FILE"; exit 1 ;; esac
    case "$_m" in *NOAUTH*) : ;; *) echo "smoke-test: FAIL (noauth must render NOAUTH: $_m)"; rm -f "$STATE_FILE"; exit 1 ;; esac
    [ "$(cat "$STATE_FILE")" = NOAUTH ] || { echo "smoke-test: FAIL (noauth state token: want NOAUTH, got $(cat "$STATE_FILE"))"; rm -f "$STATE_FILE"; exit 1; }
    rm -f "$STATE_FILE" ) || exit 1
  # Live negative control: no reading is fine (exit 2), but the tool must not NAME a cause it did not
  # verify. Distinguish — an unreachable iMac is an honest n/a; a noauth is OUR regression and must be
  # reported as a real failure, not laundered into a green "iMac is just off" pass.
  if ! timeout 5 ssh -o BatchMode=yes -o ConnectTimeout=3 "$IMAC_HOST" 'echo ok' >/dev/null 2>&1; then
    rc=0; "$0" >/dev/null 2>&1 || rc=$?
    [ "$rc" = 2 ] || { echo "smoke-test: FAIL (no live reading but tool exited $rc, want 2)"; exit 1; }
    _cls="$(reach_class)"
    case "$_cls" in
      down)   echo "smoke-test: ok (iMac genuinely off-LAN: no TCP:22 — exit 2 correct; honest n/a)"; exit 0 ;;
      loadstarve) echo "smoke-test: ok (local CPU burst starved the TCP:22 probe — honest UNKNOWN, exit 2 correct; NOT a faked off-LAN)"; exit 0 ;;
      noauth) echo "smoke-test: FAIL (iMac is UP and sshd serving on ${IMAC_HOST#*@}:22 — it rejected OUR key. The sense is dark from an ACCESS regression on this node, not an absent iMac. Install the mesh-home pubkey on $IMAC_HOST; every iMac sense (Bruno vision+activity, desk-state, therm) stays blind until then.)"; exit 1 ;;
      *)      echo "smoke-test: FAIL (TCP:22 open but SSH failed for an unclassified reason — cause undetermined, sense dark)"; exit 1 ;;
    esac
  fi
  # Positive: parse synthetic airport output (pure logic, no SSH needed)
  _raw="     agrCtlRSSI: -52
     agrCtlNoise: -97
         lastTxRate: 78"
  _rssi="$(printf '%s' "$_raw"   | awk '/agrCtlRSSI:/{print $2+0}')"
  _noise="$(printf '%s' "$_raw"  | awk '/agrCtlNoise:/{print $2+0}')"
  _txrate="$(printf '%s' "$_raw" | awk '/lastTxRate:/{print $2+0}')"
  [ "$_rssi" = "-52" ]  || { echo "smoke-test: FAIL (rssi parse: got '$_rssi', want -52)"; exit 1; }
  [ "$_noise" = "-97" ] || { echo "smoke-test: FAIL (noise parse: got '$_noise', want -97)"; exit 1; }
  [ "$_txrate" = "78" ] || { echo "smoke-test: FAIL (txrate parse: got '$_txrate', want 78)"; exit 1; }
  _snr=$(( _rssi - _noise ))
  [ "$_snr" = "45" ]    || { echo "smoke-test: FAIL (SNR calc: got '$_snr', want 45)"; exit 1; }
  # Swing logic: all-same → 0; spread → max-min
  _swing0="$(printf '%s\n' -52 -52 -52 -52 | awk 'NR==1{mn=$1;mx=$1} {if($1<mn)mn=$1;if($1>mx)mx=$1} END{print mx-mn}')"
  [ "$_swing0" = "0" ]  || { echo "smoke-test: FAIL (swing 0 expected, got $_swing0)"; exit 1; }
  _swing9="$(printf '%s\n' -52 -55 -49 -58 | awk 'NR==1{mn=$1;mx=$1} {if($1<mn)mn=$1;if($1>mx)mx=$1} END{print mx-mn}')"
  [ "$_swing9" = "9" ]  || { echo "smoke-test: FAIL (swing 9 expected, got $_swing9)"; exit 1; }
  # Cross-node tape: dBm->0-100 quality mapping (shared vocab with wifi.log; monotonic; clamped)
  [ "$(dbm_to_qual -52)" = "96" ]  || { echo "smoke-test: FAIL (qual -52 want 96, got $(dbm_to_qual -52))"; exit 1; }
  [ "$(dbm_to_qual -100)" = "0" ]  || { echo "smoke-test: FAIL (qual -100 want 0)"; exit 1; }
  [ "$(dbm_to_qual -30)" = "100" ] || { echo "smoke-test: FAIL (qual -30 clamp 100)"; exit 1; }
  # Tape line is wifi.log-parseable: signal|BSSID(17)|SSID| with the family's WIFI_TOK_RE
  _tl="$(printf '%s  imac  n=1  aps=[%s|%s|%s|%s]\n' "2026-06-20T00:00:00Z" "$(dbm_to_qual -52)" "4a:53:fa:dd:fc:97" "GL-MT3000-765" "13")"
  printf '%s' "$_tl" | grep -qE '[0-9]+\|[0-9A-Fa-f:]{17}\|[^|]*\|' || { echo "smoke-test: FAIL (tape line not WIFI_TOK_RE-parseable)"; exit 1; }
  echo "smoke-test: ok (parse:rssi/noise/txrate/snr + swing-logic + dBm->qual + tape-format verified; iMac reachable)"
  exit 0
}

# ---- Fetch live airport -I from iMac ----
raw="$(timeout 10 ssh -o BatchMode=yes -o ConnectTimeout=6 "$IMAC_HOST" "$AIRPORT -I" </dev/null 2>/dev/null)" || true
# No output → classify WHY before reporting. Only the down class may say "off-LAN"; a noauth is our
# access regression and must surface as such (it is fixable — an off-LAN iMac is not).
[ -n "$raw" ] || {
  _cls="$(reach_class)"
  case "$_cls" in
    noauth) printf 'imac-wifi: iMac UP + sshd serving, key REJECTED — access regression on this node (no SSH identity for %s), sense dark\n' "$IMAC_HOST" >&2 ;;
    other)  printf 'imac-wifi: TCP:22 open but SSH failed — cause unclassified, sense dark\n' >&2 ;;
    loadstarve) printf 'imac-wifi: local CPU burst starved our TCP:22 probe — cannot classify iMac reachability, sense dark (self-heals when load drops)\n' >&2 ;;
    *)      printf 'imac-wifi: iMac unreachable (no TCP:22 on %s) — off-LAN/asleep\n' "${IMAC_HOST#*@}" >&2 ;;
  esac
  mark_unreach "${1:-}" "$_cls"; exit 2; }

rssi="$(printf '%s' "$raw"   | awk '/agrCtlRSSI:/{print $2+0}')"
noise="$(printf '%s' "$raw"  | awk '/agrCtlNoise:/{print $2+0}')"
txrate="$(printf '%s' "$raw" | awk '/lastTxRate:/{print $2+0}')"
ssid="$(printf '%s' "$raw"   | awk '/[[:space:]]SSID:/{$1=""; print substr($0,2)}')"
bssid="$(printf '%s' "$raw"  | awk '/BSSID:/{print $2}' | head -1)"
chan="$(printf '%s' "$raw"   | awk '/[[:space:]]channel:/{print $2+0}' | head -1)"

# Parse failure is NOT an absent iMac — the SSH succeeded and returned bytes, so "off-LAN" would be a
# second invented cause. It renders dark-but-unclassified (airport removed/changed on macOS, etc).
[ -n "$rssi" ] || { printf 'imac-wifi: parse failed (no agrCtlRSSI in output — iMac reachable, airport output unrecognised)\n' >&2; mark_unreach "${1:-}" other; exit 2; }

snr=$(( rssi - noise ))
TS="$(date -u +%FT%TZ)"

# ---- Update rolling trend buffer (ts|rssi|noise|txrate per line) ----
# Per-process temp (NOT a fixed .new): the */2 cron re-execs "$0", and when an SSH to the iMac runs
# long (>2min) two runs overlap — a shared "${TREND_FILE}.new" then races (one mv finds it already
# moved → "cannot stat .imac-wifi-trend.new" spew). mktemp gives each run its own temp; last-writer
# wins the rolling buffer (an occasional dropped sample is harmless over an 8-deep RSSI window).
mkdir -p "$HOME/.mesh" 2>/dev/null || true
_tnew="$(mktemp "${TREND_FILE}.XXXXXX" 2>/dev/null)" || _tnew="${TREND_FILE}.$$"
{ cat "$TREND_FILE" 2>/dev/null; printf '%s\n' "${TS}|${rssi}|${noise}|${txrate}"; } \
  | tail -n "$TREND_LEN" > "$_tnew" && mv -f "$_tnew" "$TREND_FILE"
rm -f "$_tnew" 2>/dev/null || true

# ---- Cross-node correlation tape (host-tagged, wifi.log-compatible) ----
# Append a durable per-run line so mesh-cooscillate / mesh-leadlag can ingest the iMac as a SECOND
# vantage of the RF field. Same aps=[sig|bssid|ssid|freq] shape as wifi.log so the family's existing
# WIFI_TOK_RE parses it; signal is dBm->0-100 (shared vocab). Downstream the channel is keyed by
# (node,SSID) so the iMac's view of a shared AP (it sits on GL-MT3000-765, our own router) stays a
# DISTINCT channel from IdeaPad's — the whole point of cross-node co-oscillation/lead-lag. Append-only
# single line (O_APPEND atomic); absent consumer = harmless (just an accumulating tape).
if [ -n "$ssid" ]; then
  _qual="$(dbm_to_qual "$rssi")"
  printf '%s  imac  n=1  aps=[%s|%s|%s|%s]\n' \
    "$TS" "$_qual" "${bssid:-00:00:00:00:00:00}" "${ssid# }" "${chan:-0}" >> "$IMAC_WIFI_TAPE"
fi

# ---- Compute RSSI swing from trend buffer ----
rssi_vals="$(awk -F'|' '{print $2}' "$TREND_FILE" 2>/dev/null)"
n_trend="$(printf '%s\n' "$rssi_vals" | grep -c .)"
swing=0
[ "$n_trend" -ge 2 ] && swing="$(printf '%s\n' "$rssi_vals" | \
  awk 'NR==1{mn=$1;mx=$1} {if($1<mn)mn=$1;if($1>mx)mx=$1} END{print mx-mn}')"

# ---- Derive label ----
label="STABLE"
if [ "$snr" -lt "$SNR_WEAK" ] 2>/dev/null; then
  label="WEAK"
elif [ "$swing" -ge "$SWING_THRESH" ] 2>/dev/null; then
  label="MOTION"
fi

detail="${rssi}dBm SNR=${snr}dB txRate=${txrate}Mbps swing=${swing}dB/${n_trend}pts ssid=${ssid# }"

case "${1:-}" in
  --json)
    _ssid_safe="${ssid// /_}"; _ssid_safe="${_ssid_safe# }"
    printf '{"label":"%s","rssi":%s,"noise":%s,"snr":%s,"txrate":%s,"swing":%s,"n_trend":%s,"ssid":"%s","ts":"%s"}\n' \
      "$label" "$rssi" "$noise" "$snr" "$txrate" "$swing" "$n_trend" "$_ssid_safe" "$TS"
    ;;
  --status)
    printf 'imac-wifi: %s — %s\n' "$label" "$detail"
    printf 'trend (%s readings, SWING_THRESH=%sdBm):\n' "$n_trend" "$SWING_THRESH"
    awk -F'|' '{printf "  %s  rssi=%s noise=%s txrate=%s\n", $1, $2, $3, $4}' "$TREND_FILE" 2>/dev/null
    ;;
  --edge)
    prev="$(cat "$STATE_FILE" 2>/dev/null || echo "")"
    if [ "$label" != "$prev" ]; then
      printf '%s\n' "$label" > "$STATE_FILE"
      printf '[imac-wifi] %s — %s\n' "$label" "$detail"
    fi
    [ -e "$STATE_FILE" ] && touch "$STATE_FILE" 2>/dev/null || printf '%s\n' "$label" > "$STATE_FILE"
    ;;
  *)
    printf 'imac-wifi: %s — %s\n' "$label" "$detail"
    ;;
esac
