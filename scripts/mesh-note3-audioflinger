#!/usr/bin/env bash
# mesh-note3-audioflinger — read-only Note3 AudioFlinger telemetry consumer.
#
# Reads `dumpsys media.audio_flinger` over ADB and emits one timestamped JSON record.  It never
# changes phone state.  ADB loss, an empty dump, and missing fields are represented as UNKNOWN;
# they are not converted into zeros or a healthy-looking default.
#
#   mesh-note3-audioflinger                 read ADB and append ~/.mesh/note3-audioflinger.log
#   mesh-note3-audioflinger --parse FILE    parse a captured dump without ADB
#   mesh-note3-audioflinger --test          parser/UNKNOWN smoke test (no phone or durable write)
#
# Override MESH_NOTE3_SERIAL and MESH_NOTE3_AUDIOFLINGER_LOG for node-local deployment.
set -u
set -o pipefail
export PATH="${HOME:-/root}/.local/bin:$PATH"

SERIAL="${MESH_NOTE3_SERIAL:-4d00553d61ab90d}"
LOG="${MESH_NOTE3_AUDIOFLINGER_LOG:-${HOME:-/root}/.mesh/note3-audioflinger.log}"

emit_json() {
  python3 - "$1" "$2" "$3" <<'PY'
import json, re, sys
from datetime import datetime, timezone

text, serial, source = sys.argv[1:]
unknown = "UNKNOWN"
def field(pattern, body=text, group=1):
    m = re.search(pattern, body, re.MULTILINE)
    return m.group(group) if m else unknown

# Restrict format fields to the first output-thread section.  Global dumps can contain unrelated
# sample-rate/channel fields in other sections; those are not the output stream this sensor claims.
thread = re.search(r"(?ms)^Output thread .*?(?=^\S|\Z)", text)
body = thread.group(0) if thread else ""
record = {
    "timestamp": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
    "serial": serial,
    "source": source,
    "hardware_status": field(r"^Hardware status:\s*(\S+)", text),
    "sample_rate": field(r"^\s*Sample rate:\s*(\S+)", body),
    "channel_count": field(r"^\s*Channel Count:\s*(\S+)", body),
    "format": field(r"^\s*Format:\s*\S+\s*\(([^)]+)\)", body),
    "track_count": field(r"^\s*(\d+)\s+Tracks?\b", body),
}
print(json.dumps(record, separators=(",", ":")))
PY
}

parse_file=""
mode="live"
case "${1:-}" in
  --parse)
    [ "$#" -eq 2 ] || { echo "usage: $0 [--parse FILE|--test]" >&2; exit 2; }
    parse_file="$2"; mode="parse" ;;
  --test) mode="test" ;;
  "") ;;
  *) echo "usage: $0 [--parse FILE|--test]" >&2; exit 2 ;;
esac

if [ "$mode" = test ]; then
  td="$(mktemp -d -t mesh-note3-audioflinger.XXXXXX)"
  trap 'rm -rf "$td"' EXIT
  printf 'Hardware status: 0\nOutput thread 0x1:\n  Sample rate: 48000\n  Channel Count: 2\n  Format: 0x1 (pcm16)\n  4 Tracks of which 0 are active\n' >"$td/full"
  full="$("$0" --parse "$td/full")"
  printf '%s\n' "$full" | grep -q '"hardware_status":"0"' || exit 1
  printf '%s\n' "$full" | grep -q '"track_count":"4"' || exit 1
  printf 'Hardware status: 0\nOutput thread 0x1:\n' >"$td/partial"
  partial="$("$0" --parse "$td/partial")"
  printf '%s\n' "$partial" | grep -q '"sample_rate":"UNKNOWN"' || exit 1
  set +e
  missing="$("$0" --parse "$td/missing" 2>/dev/null)"
  rc=$?
  set -e
  [ "$rc" -eq 2 ] || exit 1
  printf '%s\n' "$missing" | grep -q '"hardware_status":"UNKNOWN"' || exit 1
  echo "smoke-test: ok (AudioFlinger fields + missing/ADB-loss UNKNOWN)"
  exit 0
fi

if [ "$mode" = parse ]; then
  if [ ! -r "$parse_file" ]; then
    record="$(emit_json "" "$SERIAL" "adb-loss-or-missing-dump")"
    printf '%s\n' "$record"
    exit 2
  fi
  dump="$(tr -d '\000' <"$parse_file" 2>/dev/null)"
  source="capture:$parse_file"
else
  if ! command -v adb >/dev/null 2>&1; then
    dump=""; source="adb-unavailable"
  else
    dump="$(timeout "${MESH_NOTE3_AUDIOFLINGER_TIMEOUT:-20}" adb -s "$SERIAL" shell dumpsys media.audio_flinger 2>/dev/null)" || dump=""
    source="adb:$SERIAL"
  fi
fi

if [ -z "$dump" ]; then
  record="$(emit_json "" "$SERIAL" "${source:-adb-loss-or-empty}")"
  rc=2
else
  record="$(emit_json "$dump" "$SERIAL" "$source")"
  rc=0
fi
printf '%s\n' "$record"
if [ "$mode" = live ]; then
  mkdir -p "$(dirname "$LOG")"
  printf '%s\n' "$record" >>"$LOG"
fi
exit "$rc"
