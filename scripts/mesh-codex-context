#!/usr/bin/env bash
# mesh-codex-context — restore mesh charter + handoff as plain text for a Codex session.
# Claude consumes mesh-handoff's SessionStart JSON hook; Codex has no equivalent project hook here,
# so this adapter extracts the same additionalContext for the operator to read at session start.
set -euo pipefail

HANDOFF="${MESH_HANDOFF_BIN:-$(command -v mesh-handoff 2>/dev/null || printf '%s/.local/bin/mesh-handoff' "$HOME")}"
[ -x "$HANDOFF" ] || { echo "mesh-codex-context: mesh-handoff is unavailable at $HANDOFF" >&2; exit 2; }

who="${MESH_WHO:-}"
window="${MESH_CODEX_WINDOW:-${who%%@*}}"
if [ -n "$window" ]; then
  payload="$(MESH_HANDOFF_TEST_WINDOW="$window" "$HANDOFF" --restore)"
else
  payload="$("$HANDOFF" --restore)"
fi
[ -n "$payload" ] || { echo "mesh-codex-context: no charter or handoff for this window"; exit 0; }

python3 -c 'import json, sys
try:
    data = json.load(sys.stdin)
    text = data.get("hookSpecificOutput", {}).get("additionalContext", "")
    if not isinstance(text, str):
        raise TypeError("additionalContext must be text")
except (json.JSONDecodeError, TypeError, AttributeError) as exc:
    print("mesh-codex-context: invalid restore payload: " + str(exc), file=sys.stderr)
    sys.exit(2)
if text:
    print(text)
else:
    print("mesh-codex-context: restore payload had no additional context")' <<<"$payload"
