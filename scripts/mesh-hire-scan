#!/usr/bin/env bash
# orphan-ok: on-demand reconnaissance for the hire lane — read-only, run when a cycle needs a target
# mesh-hire-scan — acceptance-FIRST scanner for paid-contribution targets.
#
# Two cycles of the hire lane were spent learning one thing, and it cost a target both times:
# THE PERMITTING DOCUMENT AND THE PROHIBITING DOCUMENT ARE DIFFERENT FILES, AND THE PAYER HANDS
# YOU THE PERMITTING ONE.
#
#   qtop/qtop#357        the ISSUE demands "Document the EXACT version of LLMs used ...
#                        non-negotiable" (reads as a green light) while the CONTRIBUTING.md it
#                        links says "Autonomous bot-driven pull requests are not accepted".
#   tenstorrent/tt-metal the bounty T&C posted by a Tenstorrent employee under the bounty issue
#                        (docs.tenstorrent.com/bounty_terms.html, read in full) contains NO
#                        anti-AI clause at all, while CONTRIBUTING.md:580 says "Use of automation
#                        or AI agents to claim or request assignment of bug bounty issues is
#                        strictly prohibited" — enforcement: permanent ban.
#
# So this tool never concludes from one file. It fetches the WHOLE in-repo rule set, and its
# verdict is polarity-asymmetric: ONE ban outranks ANY number of permits, and a rule file it
# could not read makes the verdict UNKNOWN rather than a plausible pass.
#
#   mesh-hire-scan --repo owner/name           verdict for a repo (the acceptance gate)
#   mesh-hire-scan --issue owner/name#N        verdict + saturation/liveness for one issue
#   mesh-hire-scan --terms <url>               scan an external terms doc (never ACCEPTs alone)
#   mesh-hire-scan --sweep [--label L]         rank open bounty issues by acceptance, then money
#   mesh-hire-scan --test                      gates; exit 2 when the gh/network organ is absent
#
# Verdicts are four, not two, because "read and clean" and "nothing to read" are different facts:
#   ACCEPT   rule files were READ and none of them bans an agent
#   SILENT   no rule document exists anywhere (no ban — but nothing affirms one either)
#   REJECT   a ban was read; the deciding file:line and its text are printed
#   UNKNOWN  a rule file could not be fetched — a failure, never a pass
#
# Read-only by construction: it issues GET requests and writes nothing outward.

set -uo pipefail

SELF=$(basename "$0")
STATE_DIR="$HOME/.mesh/hire"
LOG="$HOME/.mesh/hire.log"

_say() { printf '%s\n' "$*"; }
_err() { printf '%s: %s\n' "$SELF" "$*" >&2; }

# --- the two polarities -------------------------------------------------------------------
# An agent-term and a prohibition-term must occur on the SAME line for a ban hit. The
# Contributor Covenant ships a "Permanent Ban" enforcement ladder with no AI subject in it;
# a bare prohibition-term would flag every repo that adopted it.
# awk uses POSIX ERE: \b is NOT a word boundary there (it silently matches nothing, which
# would make every agent-term vacuous and every ban invisible). Boundaries are explicit.
AGENT_TERM='(^|[^a-z0-9])(ai|a.i.|llm|bot|bots|agent|agents)([^a-z0-9]|$)|bot-driven|automat|autonom|chatgpt|copilot|machine-generated'
BAN_TERM='(strictly prohibited|prohibited|not accepted|are not permitted|is not permitted|not welcome|banned|forbidden|will be closed|will be rejected|do not accept|don.t accept|no longer accept)'
# These need no agent-term: they demand an attestation this lane may never make.
HUMANITY='(proof.of.humanity|i am a human|not an ai|human(-| )(only|written|authored)|must be written by a human|verify you are human)'
# Order-agnostic on purpose: the permitting text is as often "Allowed AI Usage" as it is
# "AI is allowed", and missing the permit half is what hides that a file carries BOTH.
PERMIT='(^|[^a-z0-9])(ai|llm|agent|agents)([^a-z0-9])[^.]{0,80}(welcome|allowed|encouraged|permitted|acceptable)|(allowed|permitted|welcome|encouraged|may use|acceptable)[^.]{0,40}(^|[^a-z0-9])(ai|llm|agent|agents)([^a-z0-9]|$)'

# In-repo rule set. Anything a contributor is bound by, not just the file the payer points at.
RULE_FILES=(
  CONTRIBUTING.md .github/CONTRIBUTING.md docs/CONTRIBUTING.md CONTRIBUTING.rst
  CODE_OF_CONDUCT.md .github/CODE_OF_CONDUCT.md
  .github/PULL_REQUEST_TEMPLATE.md .github/pull_request_template.md
  .github/ISSUE_TEMPLATE/config.yml
  AGENTS.md CLAUDE.md README.md
)

_need_gh() {
  command -v gh >/dev/null 2>&1 || { _err "gh absent — this scanner is a GitHub organ"; return 2; }
  gh auth status >/dev/null 2>&1 || { _err "gh not authenticated — read-only API access is the organ"; return 2; }
  return 0
}

# Fetch one path. Prints the body on stdout.
#   rc 0 = fetched   rc 3 = absent (404)   rc 1 = FETCH FAILED (never treat as absent)
_fetch_file() {
  local repo=$1 path=$2 out rc
  out=$(gh api "repos/$repo/contents/$path" 2>&1); rc=$?
  if [ $rc -eq 0 ]; then
    printf '%s' "$out" | jq -r '.content // empty' 2>/dev/null | base64 -d 2>/dev/null
    return 0
  fi
  printf '%s' "$out" | grep -qi 'Not Found\|404' && return 3
  return 1
}

# Scan a body. Prints "BAN <line>:<text>" / "PERMIT <line>:<text>" lines.
_scan_body() {
  local label=$1
  awk -v L="$label" -v A="$AGENT_TERM" -v B="$BAN_TERM" -v H="$HUMANITY" -v P="$PERMIT" '
    {
      low = tolower($0)
      # A FILENAME IS NOT A RULE. Measured false positive: screenpipe/AGENTS.md:16 is a table of
      # contents line reading "- `docs/human-only-app-publication.md` - before anything
      # release-related", and the bare humanity pattern rejected a repo that had paid a bounty
      # five days earlier. Strip inline code spans, link targets and bare document paths before
      # matching, so the scanner reads prose and not the names of files.
      gsub(/`[^`]*`/, " ", low)
      gsub(/\]\([^)]*\)/, " ", low)
      gsub(/[a-z0-9._\/-]+\.(md|rst|txt|html|yml|yaml)/, " ", low)
    }
    (low ~ A && low ~ B) || low ~ H { printf "BAN\t%s:%d\t%s\n", L, NR, substr($0,1,220); next }
    low ~ P                         { printf "PERMIT\t%s:%d\t%s\n", L, NR, substr($0,1,220) }
  '
}

# --- repo verdict -------------------------------------------------------------------------
scan_repo() {
  local repo=$1 org=${1%%/*}
  local -a hits=() permits=() read_files=() absent=() failed=()
  local body rc f

  local -a targets=("${RULE_FILES[@]}")
  # The org-level .github repo supplies defaults to every repo under it — a rule one file away
  # is exactly the trap, and an org default is a rule one REPO away.
  local -a org_targets=(CONTRIBUTING.md .github/CONTRIBUTING.md PULL_REQUEST_TEMPLATE.md CODE_OF_CONDUCT.md)

  for f in "${targets[@]}"; do
    body=$(_fetch_file "$repo" "$f"); rc=$?
    case $rc in
      0) read_files+=("$f")
         while IFS= read -r line; do
           [ -z "$line" ] && continue
           case $line in BAN*) hits+=("$line");; PERMIT*) permits+=("$line");; esac
         done < <(printf '%s\n' "$body" | _scan_body "$f") ;;
      3) absent+=("$f") ;;
      *) failed+=("$f") ;;
    esac
  done
  for f in "${org_targets[@]}"; do
    body=$(_fetch_file "$org/.github" "$f"); rc=$?
    case $rc in
      0) read_files+=("$org/.github:$f")
         while IFS= read -r line; do
           [ -z "$line" ] && continue
           case $line in BAN*) hits+=("$line");; PERMIT*) permits+=("$line");; esac
         done < <(printf '%s\n' "$body" | _scan_body "$org/.github:$f") ;;
      3) absent+=("$org/.github:$f") ;;
      *) failed+=("$f@org") ;;
    esac
  done

  local verdict
  if   [ ${#hits[@]}   -gt 0 ]; then verdict=REJECT       # polarity: one ban outranks every permit
  elif [ ${#failed[@]} -gt 0 ]; then verdict=UNKNOWN      # a failure is never a pass
  elif [ ${#read_files[@]} -eq 0 ]; then verdict=SILENT   # nothing to read is not the same as clean
  else verdict=ACCEPT; fi

  _say "repo: $repo"
  _say "verdict: $verdict"
  _say "rule-files-read: ${#read_files[@]} (${read_files[*]:-none})"
  _say "rule-files-absent: ${#absent[@]}"
  [ ${#failed[@]} -gt 0 ] && _say "rule-files-FAILED-TO-FETCH: ${failed[*]}  <- this is why the verdict is UNKNOWN"
  local h
  for h in "${hits[@]}";    do _say "  BAN     $(printf '%s' "$h" | cut -f2-)"; done
  for h in "${permits[@]}"; do _say "  permit  $(printf '%s' "$h" | cut -f2-)"; done
  if [ ${#hits[@]} -gt 0 ]; then
    _say "note: REJECT means a ban was READ, not that it is unconditional — some are conditional"
    _say "      (\"every blind AI PR will be rejected\" is a quality bar, not a closed door)."
    _say "      Read the citation and decide; this tool cites, it does not adjudicate."
  fi
  if [ ${#hits[@]} -gt 0 ] && [ ${#permits[@]} -gt 0 ]; then
    _say "note: this repo carries BOTH polarities — the permit does not soften the ban, and the"
    _say "      permitting text is usually the one the payer hands you."
  fi
  case $verdict in ACCEPT|SILENT) return 0;; REJECT) return 4;; *) return 1;; esac
}

# --- issue metrics ------------------------------------------------------------------------
# Saturation is the second killer after acceptance: an open bounty with 129 comments is open
# BECAUSE nobody's PR is being merged, and every one of those comments is another claimant.
scan_issue() {
  local spec=$1 repo num j
  repo=${spec%%#*}; num=${spec##*#}
  j=$(gh api "repos/$repo/issues/$num" 2>/dev/null) || { _err "cannot read $spec"; return 1; }
  local title created updated comments assignees labels
  title=$(printf '%s' "$j" | jq -r '.title')
  created=$(printf '%s' "$j" | jq -r '.created_at[0:10]')
  updated=$(printf '%s' "$j" | jq -r '.updated_at[0:10]')
  comments=$(printf '%s' "$j" | jq -r '.comments')
  assignees=$(printf '%s' "$j" | jq -r '(.assignees|map(.login)|join(","))')
  labels=$(printf '%s' "$j" | jq -r '(.labels|map(.name)|join(", "))')
  local age_days
  age_days=$(( ( $(date -u +%s) - $(date -u -d "$created" +%s) ) / 86400 ))
  _say "issue: $repo#$num — $title"
  _say "created: $created (${age_days}d)  updated: $updated  comments: $comments"
  _say "assignee: ${assignees:-none}"
  _say "labels: $labels"
  [ -n "$assignees" ] && _say "saturation: TAKEN — assigned; a PR from anyone else is unpayable on most programmes"
  if   [ "$comments" -ge 20 ]; then _say "saturation: SWARMED ($comments comments over ${age_days}d) — open this long means merges are not happening"
  elif [ "$comments" -ge 5 ];  then _say "saturation: contested ($comments comments)"
  else _say "saturation: quiet ($comments comments)"; fi
  # The scan-the-issue-body-for-permission trap gets its own line, loudly.
  printf '%s' "$j" | jq -r '.body // ""' | _scan_body "issue-body" | while IFS= read -r l; do
    [ -n "$l" ] && _say "  issue-body $(printf '%s' "$l" | cut -f1,2- )"
  done
  _say "-- the issue body is NOT the rule set; repo verdict follows --"
  scan_repo "$repo"
}

# --- external terms -------------------------------------------------------------------------
scan_terms() {
  local url=$1 tmp rc
  tmp=$(mktemp) || return 1
  curl -sS --max-time 60 -o "$tmp" -w '%{http_code}' "$url" > "$tmp.code" 2>"$tmp.err"; rc=$?
  local code; code=$(cat "$tmp.code" 2>/dev/null)
  if [ $rc -ne 0 ] || [ "$code" != "200" ]; then
    _say "terms: $url"; _say "verdict: UNKNOWN (fetch failed: rc=$rc http=$code)"
    rm -f "$tmp" "$tmp.code" "$tmp.err"; return 1
  fi
  local text
  text=$(python3 -c "
import re,html,sys
s=open(sys.argv[1],encoding='utf-8',errors='replace').read()
s=re.sub(r'(?is)<(script|style)[^>]*>.*?</\1>',' ',s)
s=re.sub(r'(?s)<[^>]+>','\n',s); s=html.unescape(s)
print(re.sub(r'\n\s*\n+','\n',s))
" "$tmp" 2>/dev/null)
  rm -f "$tmp" "$tmp.code" "$tmp.err"
  _say "terms: $url  (${#text} chars of text)"
  local n=0
  while IFS= read -r l; do [ -n "$l" ] && { _say "  $(printf '%s' "$l" | cut -f1,2-)"; n=$((n+1)); }; done \
    < <(printf '%s\n' "$text" | _scan_body "terms")
  [ $n -eq 0 ] && _say "  (no polarity hit in the external terms)"
  _say "verdict: EXTERNAL-ONLY — an external terms document can never yield ACCEPT by itself."
  _say "         It is the document the payer hands you, and in both measured cases the ban"
  _say "         lived in the repo's own CONTRIBUTING. Run --repo before concluding anything."
  return 0
}

# --- sweep ----------------------------------------------------------------------------------
sweep() {
  local label=${1:-💎 Bounty}
  _say "# sweep label=\"$label\"  (acceptance first, money second)"
  local j
  j=$(gh api -X GET search/issues -f q="is:issue is:open label:\"$label\" sort:created-desc" -f per_page=30 2>/dev/null) \
    || { _err "search failed"; return 1; }
  _say "# total open with this label: $(printf '%s' "$j" | jq -r '.total_count')"
  printf '%s' "$j" | jq -r '.items[]? | [(.repository_url|sub(".*/repos/";"")), .number, (.created_at|.[0:10]), .comments, ((.assignees|length)), (.title|.[0:48])] | @tsv' \
  | while IFS=$'\t' read -r repo num created comments nassign title; do
      local flag=""
      [ "$nassign" -gt 0 ] && flag="TAKEN"
      [ "$comments" -ge 20 ] && flag="${flag:+$flag,}SWARMED"
      printf '%-38s #%-7s %s c=%-4s %-14s %s\n' "$repo" "$num" "$created" "$comments" "${flag:-quiet}" "$title"
    done
  _say "# next: mesh-hire-scan --repo <repo> on each quiet row. A quiet row is a CANDIDATE,"
  _say "#       never a target — the acceptance gate has not run on it yet."
}

# --- test -------------------------------------------------------------------------------------
run_test() {
  local fail=0 pass=0
  _t() { if eval "$2"; then pass=$((pass+1)); _say "  ok   $1"; else fail=$((fail+1)); _say "  FAIL $1"; fi; }

  _say "== offline: classifier polarity =="
  # 1. The measured tt-metal line must be a BAN.
  local tt='Use of automation or AI agents to claim or request assignment of bug bounty issues is **strictly prohibited**.'
  _t "tt-metal:580 classifies as BAN" \
     '[ "$(printf "%s\n" "$tt" | _scan_body f | cut -f1)" = BAN ]'
  # 2. The measured qtop line must be a BAN.
  _t "qtop CONTRIBUTING line classifies as BAN" \
     '[ "$(printf "%s\n" "Autonomous bot-driven pull requests are not accepted." | _scan_body f | cut -f1)" = BAN ]'
  # 3. The trovu#329 attestation must be a BAN with no agent-term on the line at all.
  _t "humanity attestation classifies as BAN without an agent-term" \
     '[ "$(printf "%s\n" "Please comment: I am a human who is writing this comment, not an AI." | _scan_body f | cut -f1)" = BAN ]'
  # 4. MUTANT — the Contributor Covenant ladder must NOT be a ban (bare prohibition, no subject).
  _t "Contributor Covenant 'Permanent Ban' does NOT false-positive" \
     '[ -z "$(printf "%s\n" "**Consequence**: A permanent ban from any sort of public interaction within the community." | _scan_body f)" ]'
  # 5. The permitting half of the SAME tt-metal file must classify as permit, not ban.
  _t "tt-metal 'Allowed AI Usage' line classifies as permit" \
     '[ "$(printf "%s\n" "Users may use AI tools to assist in their own development work, this is allowed" | _scan_body f | cut -f1)" = PERMIT ]'

  # 6. MUTANT — the measured screenpipe false positive: a filename is not a rule.
  _t "a filename containing 'human-only' is NOT a ban" \
     '[ -z "$(printf "%s\n" "- \`docs/human-only-app-publication.md\` - before anything release-related." | _scan_body f)" ]'
  _t "  ... while the same words in prose still ARE a ban" \
     '[ "$(printf "%s\n" "This project is human-only; agent submissions are not accepted." | _scan_body f | cut -f1)" = BAN ]'

  _say "== offline: fetch-failure polarity =="
  # 6. MUTANT — a 404 and a fetch FAILURE must not be the same rc, or a broken read reads as absent.
  _t "_fetch_file maps a real 404 to rc3 (absent)" \
     'out=$(gh() { echo "gh: Not Found (HTTP 404)"; return 1; }; _fetch_file x/y z; echo $?); [ "$out" = 3 ]'
  # The 404 half alone is a vacuous gate: a mutant that returns 3 for EVERY failure still passes
  # it, and then an unreachable API renders as "the repo has no rules" — a plausible constant in
  # place of a total failure. The complementary case is the one that actually binds.
  _t "_fetch_file maps a NON-404 failure to rc1 (never absent)" \
     'out=$(gh() { echo "error connecting to api.github.com: dial tcp: i/o timeout"; return 1; }; _fetch_file x/y z; echo $?); [ "$out" = 1 ]'

  _say "== offline: an unread rule file is UNKNOWN, never a pass =="
  # The most dangerous single failure this tool can have: the API is unreachable, every rule
  # file reads as absent, and the repo renders SILENT/ACCEPT — a total failure wearing the
  # shape of "this repo has no anti-agent rule". Fetch failure must dominate the verdict.
  # (The stubs are real functions, not eval strings: eval expands "$*" before the stub is even
  #  parsed, so an inline stub silently matches nothing and the gate passes vacuously.)
  _fx_gh_fail_contributing() {
    case "$*" in
      *contents/CONTRIBUTING.md) echo "error connecting to api.github.com: i/o timeout"; return 1 ;;
      *) echo "gh: Not Found (HTTP 404)"; return 1 ;;
    esac
  }
  _fx_gh_all_404() { echo "gh: Not Found (HTTP 404)"; return 1; }
  # `|| true`: scan_repo returns non-zero for UNKNOWN/REJECT, and under `set -o pipefail` that
  # non-zero becomes the whole pipeline's rc — so `_fx_scan_failing | grep -q` would report the
  # gate as failed while grep had in fact matched. The verdict under test is the TEXT, not the rc.
  _fx_scan_failing()    { ( gh() { _fx_gh_fail_contributing "$@"; }; scan_repo fixture/repo 2>&1 ) || true; }
  _fx_scan_all_absent() { ( gh() { _fx_gh_all_404 "$@"; };            scan_repo fixture/repo 2>&1 ) || true; }

  _t "one unfetchable rule file forces verdict UNKNOWN" \
     '_fx_scan_failing | grep -q "verdict: UNKNOWN"'
  _t "  ... and the UNKNOWN verdict names the file it could not read" \
     '_fx_scan_failing | grep -q "FAILED-TO-FETCH.*CONTRIBUTING.md"'
  _t "  ... while an all-404 repo is SILENT, not UNKNOWN" \
     '_fx_scan_all_absent | grep -q "verdict: SILENT"'

  _need_gh || { _say "gh organ absent — offline gates only"; return 2; }

  _say "== live: known-answer read of the real rule set =="
  # 7. THE real-path assertion. tt-metal is the measured case: its bounty T&C is clean and its
  #    CONTRIBUTING bans agents. A scanner that returns anything but REJECT here is not reading
  #    the file that decides. Known answer, like transcribing a known wav.
  local tf rc
  tf=$(mktemp); scan_repo tenstorrent/tt-metal >"$tf" 2>&1; rc=$?
  _t "tenstorrent/tt-metal verdict is REJECT (rc4)" "[ $rc = 4 ]"
  _t "  ... and the citation names CONTRIBUTING.md"   "grep -q 'BAN.*CONTRIBUTING.md' $tf"
  _t "  ... and it reports BOTH polarities present"   "grep -qi 'both polarities' $tf"
  _t "  ... and it did read more than one rule file"  "grep -qE 'rule-files-read: [2-9]' $tf"
  rm -f "$tf"

  _say "== live: a repo with no rule documents is SILENT, not ACCEPT =="
  tf=$(mktemp); scan_repo tscircuit/jlcsearch >"$tf" 2>&1
  _t "tscircuit/jlcsearch is ACCEPT-or-SILENT, never UNKNOWN-as-pass" "grep -qE 'verdict: (ACCEPT|SILENT)' $tf"
  rm -f "$tf"

  _say "-- $pass passed, $fail failed --"
  [ $fail -eq 0 ]
}

case "${1:---help}" in
  --repo)  [ $# -ge 2 ] || { _err "--repo owner/name"; exit 1; }; _need_gh || exit 2; scan_repo "$2" ;;
  --issue) [ $# -ge 2 ] || { _err "--issue owner/name#N"; exit 1; }; _need_gh || exit 2; scan_issue "$2" ;;
  --terms) [ $# -ge 2 ] || { _err "--terms <url>"; exit 1; }; scan_terms "$2" ;;
  --sweep) _need_gh || exit 2; shift; lbl="💎 Bounty"; [ "${1:-}" = "--label" ] && lbl=$2; sweep "$lbl" ;;
  --test)  run_test ;;
  *) sed -n '3,32p' "$0" | sed 's/^# \{0,1\}//' ;;
esac
