#!/home/mesh-home/.venv-ai/bin/python
# mesh-room-note3-bridge — STOPGAP live ear: Note3 slrec -> warm gigaam -> room-transcript.txt
# The mesh-home audio stack is down (headless logind: PipeWire sees no ALSA card -> null source,
# onboard ALC897 Front Mic is silent, USB webcam mic dropped off the graph). The Note3 is the only
# ear resolving speech right now (independent hardware via adb/slrec). This bridges it into the same
# transcript the room top-pane tails, so hearing is live while senses/genome rework mesh-room-gigaam
# to fuse all 3 ears properly. Loads gigaam ONCE (warm ~0.07s/call) and loops.
#
# SELF-MUTE (2026-07-18): the Note3 is BOTH the ear and the mesh's TTS speaker (mesh-note3-say plays
# out the same device). Without a mute gate, our own voice is captured -> transcribed -> appended to
# room-transcript.txt -> read by mesh-room-reflex's name-gate -> self-wake loop (observed room@22:36:
# name-wake fired while the operator was quiet 2h51m). mesh-note3-say writes a RELEASE EPOCH into
# ~/.mesh/mesh-speaking for the clip+tail (mesh-note3-say:98); mesh-overhear honors the same flag
# (mesh-overhear:237). We mirror it: while the flag holds a future epoch, skip capture+transcribe+
# append. Malformed/empty contents -> NOT muted (never wedge the ear off forever). Checked at the top
# of each iter (skip the adb capture cost) AND again before the append (a TTS that starts mid-capture
# would otherwise land our own voice in the transcript).
import subprocess, time, os, datetime, sys
os.environ['PATH'] = os.path.expanduser('~/.local/bin') + ':' + os.environ.get('PATH', '')
T = os.path.expanduser('~/.mesh/room-transcript.txt')
SECS = os.environ.get('BRIDGE_SECS', '12')
# BRIDGE_MUTE_FLAG lets --test point at a throwaway flag so the gate never touches the LIVE
# ~/.mesh/mesh-speaking (a test that wrote the real flag would forge the very self-mute it checks
# and could unmute the live overhear ear — the test-forges-the-artifact trap).
MUTE_FLAG = os.environ.get('BRIDGE_MUTE_FLAG', os.path.expanduser('~/.mesh/mesh-speaking'))


def _muted(flag, now=None):
    """True while the mesh's own TTS is playing: mesh-note3-say writes a release epoch into `flag`.
    Empty/missing/malformed contents -> False (never wedge the ear off forever)."""
    try:
        with open(flag) as fh:
            d = fh.read().strip()
    except FileNotFoundError:
        return False
    except Exception:
        return False
    if not d.isdigit():   # empty or malformed -> not muted
        return False
    return int(d) > (now if now is not None else time.time())


def process_once(get_wav, transcribe, flag, out):
    """One capture->transcribe->append pass. Returns the appended text, or None if skipped
    (self-speaking, no/empty audio, or empty transcript)."""
    if _muted(flag):
        return None                       # our own TTS is playing — don't self-hear
    wav = get_wav()
    if not (wav and os.path.exists(wav) and os.path.getsize(wav) > 1000):
        return None
    if _muted(flag):                      # TTS started DURING the capture — the wav is our voice
        return None
    res = transcribe(wav)
    txt = (getattr(res, 'text', None) or (res if isinstance(res, str) else '')).strip()
    if not txt:
        return None
    ts = datetime.datetime.now().strftime('%H:%M:%S')
    with open(out, 'a') as f:
        f.write(f'[{ts}] [note3] {txt}\n')
    return txt


def _selftest():
    """RED-first gate: muted -> NO append; unmuted/expired/malformed -> STILL appends (no wedge)."""
    import tempfile
    d = tempfile.mkdtemp(prefix='note3-bridge-test-')
    flag = os.path.join(d, 'mesh-speaking')      # throwaway — never the live flag
    out = os.path.join(d, 'transcript.txt')
    wav = os.path.join(d, 'chunk.wav')
    with open(wav, 'wb') as fh:
        fh.write(b'\0' * 2000)                   # >1000 bytes so the size gate passes
    phrase = 'меш это тестовая фраза'            # stands in for a captured TTS utterance
    getw = lambda: wav
    tr = lambda w: phrase
    now = int(time.time())               # process_once compares the flag against the REAL clock
    fails = 0

    def lines():
        try:
            return open(out).read().count('\n')
        except FileNotFoundError:
            return 0

    # 1. baseline: flag ABSENT -> a normal chunk appends (proves the ear works at all)
    try:
        os.remove(flag)
    except FileNotFoundError:
        pass
    before = lines()
    process_once(getw, tr, flag, out)
    if lines() != before + 1:
        print('FAIL: flag absent — a normal chunk did NOT append'); fails += 1
    else:
        print('ok: flag absent -> chunk appended')

    # 2. the fix: flag = FUTURE epoch -> the same chunk must NOT append
    with open(flag, 'w') as fh:
        fh.write(str(now + 30))
    before = lines()
    process_once(getw, tr, flag, out)    # muted
    if lines() != before:
        print('FAIL: flag in future — our own TTS was appended (self-mute broken)'); fails += 1
    else:
        print('ok: flag future -> chunk skipped (self-mute)')

    # 3. flag = EXPIRED epoch -> appends again (a stale flag never wedges the ear off)
    with open(flag, 'w') as fh:
        fh.write(str(now - 30))
    before = lines()
    process_once(getw, tr, flag, out)
    if lines() != before + 1:
        print('FAIL: expired flag wedged the ear off'); fails += 1
    else:
        print('ok: flag expired -> chunk appended')

    # 4. MALFORMED flag contents -> appends (never wedge capture off forever)
    with open(flag, 'w') as fh:
        fh.write('garbage-not-an-epoch')
    before = lines()
    process_once(getw, tr, flag, out)
    if lines() != before + 1:
        print('FAIL: malformed flag wedged the ear off'); fails += 1
    else:
        print('ok: flag malformed -> chunk appended')

    print('note3-bridge --test:', 'PASS' if fails == 0 else f'FAIL ({fails})')
    return fails


if __name__ == '__main__' and len(sys.argv) > 1 and sys.argv[1] == '--test':
    sys.exit(1 if _selftest() else 0)

import gigaam
sys.stderr.write('note3-bridge: loading gigaam...\n'); sys.stderr.flush()
m = gigaam.load_model('v2_ctc')
sys.stderr.write('note3-bridge: model up, listening\n'); sys.stderr.flush()


def _capture():
    return subprocess.check_output(['mesh-note3-ear', SECS, '--raw'],
                                   text=True, timeout=int(SECS) + 40).strip()


while True:
    try:
        if _muted(MUTE_FLAG):
            time.sleep(1)                 # our own TTS is playing — skip the capture cost, don't self-hear
            continue
        process_once(_capture, m.transcribe, MUTE_FLAG, T)
    except subprocess.TimeoutExpired:
        time.sleep(2)
    except Exception:
        time.sleep(3)
