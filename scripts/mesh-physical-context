#!/usr/bin/env bash
# reflex-cadence: 2-59/5 * * * *
# reflex-args: --edge
# mesh-physical-context — cross-sense fusion: WHAT IS THE OPERATOR PHYSICALLY DOING IN THE ROOM?
#
# Complements mesh-room-context (SOCIAL context — engaged/solo/etc.) and mesh-operator-engagement
# (engagement level — active/social/media/etc.) with the PHYSICAL axis: where the body is, what
# it's doing, and in what environment. No single sensor answers it.
#
# Inputs (all best-effort, each independently OFFLINE-able; an UNREACHABLE input is visibly distinct
# from a genuine empty — see DEGRADED below; never a faked all-clear):
#   mesh-presence          .presence-state     personal_presence=ACTIVE_NEAR/ACTIVE_FAR/ARRIVING/
#                                                DEPARTING/EMPTY/AMBIGUOUS/APPLIANCE
#   mesh-room-sense        .room-sense.state   PRESENT/EMPTY/UNCERTAIN
#   mesh-body-motion       .body-motion-state  [body-still]/[body-walking]/[body-handled]/
#                                                [body-carried]/[body-covered]/OFFLINE
#   mesh-light             .light-state        DARK/DIM/MODERATE/LIT/BRIGHT/OFFLINE
#   mesh-gravity           .gravity-state      FLAT/UPRIGHT/TILTED/SIDEWAYS_LEFT/SIDEWAYS_RIGHT
#                                                (also FLAT_REVERSE/UPRIGHT_REVERSE)
#
# Classification (FALSIFIABLE via --test):
#   IN_SEAT      — body STILL + room PRESENT + BLE personal NEAR + light MODERATE+
#                   → operator is at the workstation, working
#   RESTING      — body STILL + gravity FLAT + light DARK/DIM
#                   → phone lying flat in a dim room, body at rest (asleep / not present)
#   HANDLING     — body HANDLED|CARRIED|COVERED
#                   → operator is actively handling/holding the phone
#   WALKING      — body WALKING
#                   → operator is walking
#   DARK_PRESENT — body STILL + room PRESENT + BLE personal + light DARK/DIM (not flat)
#                   → someone in the room but the lights are off (or it's dim evening)
#   CHILLING     — body STILL + room PRESENT + BLE personal (light degraded or no FLAT)
#                   → in the room, settled, not actively working
#   AWAY         — room EMPTY + BLE personal EMPTY/APPLIANCE
#                   → operator is not in the room
#   DEGRADED     — 2+ inputs unreachable (with explicit missing list) — never a confident verdict
#   UNKNOWN      — inputs reachable but conflicting
#
# Honest-degraded: a 2+ input outage renders DEGRADED with the explicit missing list (a consumer
# reading the state file sees "DEGRADED|missing=light,gravity" — visibly distinct from a
# AWAY verdict that means "genuine empty", and from UNKNOWN which means "all data in but conflicts").
# A single missing input is tolerated (the others are sufficient to assert most labels).
#
#   mesh-physical-context              one-shot label + reason
#   mesh-physical-context --json       machine-readable {label, degraded, reason, inputs, ts}
#   mesh-physical-context --edge       emit only on label change (for cron wiring)
#   mesh-physical-context --test       smoke test (synthetic state files, no network)
#
# Uses mesh-state-touch on EVERY successful run so a long-stable IN_SEAT doesn't decay to FALSE STALE.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes" 2>/dev/null || true

STATE="$HOME/.mesh/.physical-context-state"
MESH="${MESH_DIR:-$HOME/.mesh}"

# Stale threshold: each input has its own cadence. We treat an input as OFFLINE if its state file is
# older than 2x the tool's cron stride (5min × 2 = 600s for most). The same OFFLINE bucket keeps the
# state-file mtime semantics honest: a long-stable but live input is NEVER rendered OFFLINE.
STALE_S=600
# room-sense strides 15min (2-59/15), not 5 — and this tool's :02/:17/:32/:47 runs fire seconds
# BEFORE room-sense's write, reading an ~887s-old state. With the generic 600s cutoff that rendered
# a LIVE room-sense OFFLINE on every third eval (false DEGRADED flap, caught live 2026-07-07 07:02).
# 2× its OWN cadence: one missed run stays live, two missed runs go honest-OFFLINE.
ROOM_STALE_S=1800
# light (9-59/30) and body-motion (7-59/30) stride 30min — same disease, masked only by mesh-dash's
# --status polls rewriting their state ~minutely (dash closed → 600s cutoff false-OFFLINEs both).
# Same constants mesh-interruptibility uses for the same inputs (cadence + grace).
LIGHT_STALE_S=2100
MOTION_STALE_S=2100

# read_state <state-file> → echoes the first whitespace-token of the first non-empty line, or OFFLINE.
# Special case: mesh-body-motion writes the state as the first "[body-*]" tag in the line (the line
# format is "<tag>|<hyst>|<pending-tag>" so the first awk field would include pipes; we extract the
# bracketed tag explicitly when present).
read_state() {
  local f="$1" stale="${2:-$STALE_S}" v now m
  [ -f "$f" ] || { echo "OFFLINE"; return; }
  now=$(date +%s); m=$(stat -c %Y "$f" 2>/dev/null || echo "$now")
  if [ $((now - m)) -gt "$stale" ]; then echo "OFFLINE"; return; fi
  # Try the bracketed-tag form first (mesh-body-motion)
  v="$(head -1 "$f" 2>/dev/null | grep -oE '\[body-[a-z]+\]' | head -1)"
  if [ -z "$v" ]; then
    # room-sense/light enrich the label as LABEL|dwell_s=N|changes_24h=N — take the LABEL field, else
    # every match falls through against the whole "DARK|dwell_s=.." string (cross-sense vocab contract).
    v="$(head -1 "$f" 2>/dev/null | awk '{print $1}' | cut -d'|' -f1)"
  fi
  [ -n "$v" ] || { echo "OFFLINE"; return; }
  printf '%s' "$v"
}

# read_personal_presence <state-file> → echoes ACTIVE_NEAR|ACTIVE_FAR|ARRIVING|DEPARTING|EMPTY|AMBIGUOUS|
# APPLIANCE|UNKNOWN|OFFLINE. personal_presence is a trailing additive field on .presence-state.
read_personal_presence() {
  local f="$1" v now m
  [ -f "$f" ] || { echo "OFFLINE"; return; }
  now=$(date +%s); m=$(stat -c %Y "$f" 2>/dev/null || echo "$now")
  if [ $((now - m)) -gt "$STALE_S" ]; then echo "OFFLINE"; return; fi
  v="$(grep -oE 'personal_presence=[A-Z_-]+' "$f" 2>/dev/null | head -1 | cut -d= -f2)"
  [ -n "$v" ] || { echo "OFFLINE"; return; }
  printf '%s' "$v"
}

# classify_physical_context <pres> <room> <motion> <light> <gravity> → echoes "LABEL|reason"
# Pure function, no I/O — easy to test.
classify_physical_context() {
  local pres="$1" room="$2" motion="$3" light="$4" grav="$5"
  local degraded=""
  [ "$pres"   = "OFFLINE" ] && degraded="${degraded}presence,"
  [ "$room"   = "OFFLINE" ] && degraded="${degraded}room-sense,"
  [ "$motion" = "OFFLINE" ] && degraded="${degraded}body-motion,"
  [ "$light"  = "OFFLINE" ] && degraded="${degraded}light,"
  [ "$grav"   = "OFFLINE" ] && degraded="${degraded}gravity,"
  # Strip trailing comma
  degraded="${degraded%,}"
  local degen=0
  [ "$pres"   = "OFFLINE" ] && degen=$((degen+1))
  [ "$room"   = "OFFLINE" ] && degen=$((degen+1))
  [ "$motion" = "OFFLINE" ] && degen=$((degen+1))
  [ "$light"  = "OFFLINE" ] && degen=$((degen+1))
  [ "$grav"   = "OFFLINE" ] && degen=$((degen+1))
  # 2+ inputs offline → DEGRADED (a single missing input can be tolerated; 2+ means the verdict is
  # untrustworthy — render as DEGRADED with the explicit missing list, never a confident label).
  if [ "$degen" -ge 2 ]; then
    echo "DEGRADED|missing: $degraded"
    return
  fi
  # WALKING: body WALKING (direction-asserting, overrides everything)
  if printf '%s' "$motion" | grep -qE '^(WALKING|\[body-walking\])$'; then
    echo "WALKING|body in motion (pres=$pres room=$room light=$light)"
    return
  fi
  # HANDLING: body HANDLED|CARRIED|COVERED (with or without the [body-*] brackets mesh-body-motion
  # stores in its state file). grep -F avoids the case-glob character-class trap ([body-*] in a glob
  # matches a single char in the set b/o/d/y/-/h/a/n/.../e — not what we want).
  if printf '%s' "$motion" | grep -qE '^(HANDLED|\[body-handled\])$'; then
    echo "HANDLING|body handled (pres=$pres light=$light)"; return
  fi
  if printf '%s' "$motion" | grep -qE '^(CARRIED|\[body-carried\])$'; then
    echo "HANDLING|body carried (pres=$pres light=$light)"; return
  fi
  if printf '%s' "$motion" | grep -qE '^(COVERED|\[body-covered\])$'; then
    echo "HANDLING|body covered (pres=$pres light=$light)"; return
  fi
  # AWAY: room EMPTY + BLE personal EMPTY (no one here)
  if [ "$room" = "EMPTY" ] && { [ "$pres" = "EMPTY" ] || [ "$pres" = "APPLIANCE" ] || [ "$pres" = "OFFLINE" ]; }; then
    echo "AWAY|room empty, no personal devices"
    return
  fi
  if [ "$room" = "EMPTY" ] && [ "$pres" = "AMBIGUOUS" ]; then
    # A room-EMPTY + BLE-AMBIGUOUS read is honest: the room may have a person whose MAC
    # rotation prevented us from naming them. Don't downgrade to a confident AWAY.
    echo "DARK_PRESENT|room EMPTY but BLE AMBIGUOUS (privacy-rotating MAC?), holding"
    return
  fi
  # IN_SEAT: body STILL + room PRESENT + BLE personal NEAR + light MODERATE+
  if printf '%s' "$motion" | grep -qE '^(STILL|\[body-still\])$' \
     && [ "$room" = "PRESENT" ] \
     && { [ "$pres" = "ACTIVE_NEAR" ] || [ "$pres" = "ARRIVING" ]; } \
     && { [ "$light" = "MODERATE" ] || [ "$light" = "LIT" ] || [ "$light" = "BRIGHT" ]; }; then
    echo "IN_SEAT|body still, room present, personal near, lit"
    return
  fi
  # RESTING: body STILL + gravity FLAT + light DARK/DIM
  if printf '%s' "$motion" | grep -qE '^(STILL|\[body-still\])$' \
     && { [ "$grav" = "FLAT" ] || [ "$grav" = "FLAT_REVERSE" ]; } \
     && { [ "$light" = "DARK" ] || [ "$light" = "DIM" ]; }; then
    echo "RESTING|phone flat, body still, dim light"
    return
  fi
  # DARK_PRESENT: body STILL + room PRESENT + BLE personal + light DARK/DIM (not flat)
  if printf '%s' "$motion" | grep -qE '^(STILL|\[body-still\])$' \
     && [ "$room" = "PRESENT" ] \
     && { [ "$pres" = "ACTIVE_NEAR" ] || [ "$pres" = "ACTIVE_FAR" ] || [ "$pres" = "ARRIVING" ]; } \
     && { [ "$light" = "DARK" ] || [ "$light" = "DIM" ]; }; then
    echo "DARK_PRESENT|room occupied, body still, low light (grav=$grav)"
    return
  fi
  # CHILLING: body STILL + room PRESENT + BLE personal (light degraded or gravity unknown)
  if printf '%s' "$motion" | grep -qE '^(STILL|\[body-still\])$' \
     && [ "$room" = "PRESENT" ] \
     && { [ "$pres" = "ACTIVE_NEAR" ] || [ "$pres" = "ACTIVE_FAR" ] || [ "$pres" = "ARRIVING" ]; }; then
    echo "CHILLING|room occupied, body still (pres=$pres light=$light grav=$grav)"
    return
  fi
  # DEGRADED with single missing (we allow 0-1 missing for confident verdicts, but if we fell
  # through all the confident branches with one missing, surface the missing rather than guess).
  if [ -n "$degraded" ]; then
    echo "DEGRADED|missing: $degraded (room=$room pres=$pres motion=$motion light=$light grav=$grav)"
    return
  fi
  # UNKNOWN: all inputs reachable, no rule fired
  echo "UNKNOWN|room=$room pres=$pres motion=$motion light=$light grav=$grav"
}

if [ "${1:-}" = --test ]; then
  command -v python3 >/dev/null 2>&1 || { echo "smoke-test: FAIL (no python3)"; exit 1; }
  fail=0
  # IN_SEAT
  r="$(classify_physical_context ACTIVE_NEAR PRESENT '[body-still]' MODERATE FLAT)"
  [ "$r" = "IN_SEAT|body still, room present, personal near, lit" ] || { echo "  FAIL: IN_SEAT got=$r"; fail=1; }
  # IN_SEAT also accepts ARRIVING + LIT + UPRIGHT
  r="$(classify_physical_context ARRIVING PRESENT STILL LIT UPRIGHT)"
  [ "$r" = "IN_SEAT|body still, room present, personal near, lit" ] || { echo "  FAIL: IN_SEAT(ARRIVING) got=$r"; fail=1; }
  # RESTING
  r="$(classify_physical_context ACTIVE_FAR PRESENT '[body-still]' DARK FLAT)"
  [ "$r" = "RESTING|phone flat, body still, dim light" ] || { echo "  FAIL: RESTING got=$r"; fail=1; }
  # HANDLING
  r="$(classify_physical_context ACTIVE_NEAR PRESENT '[body-handled]' MODERATE FLAT)"
  [ "$r" = "HANDLING|body handled (pres=ACTIVE_NEAR light=MODERATE)" ] || { echo "  FAIL: HANDLING got=$r"; fail=1; }
  r="$(classify_physical_context ACTIVE_FAR PRESENT '[body-carried]' DIM UPRIGHT)"
  [ "$r" = "HANDLING|body carried (pres=ACTIVE_FAR light=DIM)" ] || { echo "  FAIL: CARRIED got=$r"; fail=1; }
  # WALKING
  r="$(classify_physical_context ACTIVE_NEAR PRESENT '[body-walking]' MODERATE FLAT)"
  [ "$r" = "WALKING|body in motion (pres=ACTIVE_NEAR room=PRESENT light=MODERATE)" ] || { echo "  FAIL: WALKING got=$r"; fail=1; }
  # AWAY
  r="$(classify_physical_context EMPTY EMPTY STILL DARK FLAT)"
  [ "$r" = "AWAY|room empty, no personal devices" ] || { echo "  FAIL: AWAY got=$r"; fail=1; }
  # AWAY with APPLIANCE only
  r="$(classify_physical_context APPLIANCE EMPTY STILL DARK FLAT)"
  [ "$r" = "AWAY|room empty, no personal devices" ] || { echo "  FAIL: AWAY(APPLIANCE) got=$r"; fail=1; }
  # DARK_PRESENT: room PRESENT + BLE personal + DARK + body still (gravity not FLAT)
  r="$(classify_physical_context ACTIVE_NEAR PRESENT '[body-still]' DARK UPRIGHT)"
  [ "$r" = "DARK_PRESENT|room occupied, body still, low light (grav=UPRIGHT)" ] || { echo "  FAIL: DARK_PRESENT got=$r"; fail=1; }
  # CHILLING: body STILL + room PRESENT + BLE personal + light OFFLINE (single input degraded)
  r="$(classify_physical_context ACTIVE_NEAR PRESENT '[body-still]' OFFLINE FLAT)"
  [ "$r" = "CHILLING|room occupied, body still (pres=ACTIVE_NEAR light=OFFLINE grav=FLAT)" ] || { echo "  FAIL: CHILLING got=$r"; fail=1; }
  # 2+ OFFLINE → DEGRADED (with explicit list)
  r="$(classify_physical_context OFFLINE PRESENT [body-still] OFFLINE FLAT)"
  echo "$r" | grep -q '^DEGRADED' || { echo "  FAIL: 2 OFFLINE should DEGRADED got=$r"; fail=1; }
  echo "$r" | grep -q 'presence' || { echo "  FAIL: DEGRADED should list presence in missing got=$r"; fail=1; }
  echo "$r" | grep -q 'light' || { echo "  FAIL: DEGRADED should list light in missing got=$r"; fail=1; }
  # 3 OFFLINE → DEGRADED
  r="$(classify_physical_context OFFLINE OFFLINE OFFLINE MODERATE FLAT)"
  echo "$r" | grep -q '^DEGRADED' || { echo "  FAIL: 3 OFFLINE should DEGRADED got=$r"; fail=1; }
  # All OFFLINE → DEGRADED
  r="$(classify_physical_context OFFLINE OFFLINE OFFLINE OFFLINE OFFLINE)"
  echo "$r" | grep -q '^DEGRADED' || { echo "  FAIL: 5 OFFLINE should DEGRADED got=$r"; fail=1; }
  # Single OFFLINE: should not block a confident label (CHILLING tested above)
  # Contradiction: room PRESENT + body STILL but BLE EMPTY/APPLIANCE → no rule fires → UNKNOWN
  r="$(classify_physical_context EMPTY PRESENT STILL MODERATE FLAT)"
  echo "$r" | grep -q '^UNKNOWN' || { echo "  FAIL: PRESENT+BLE-EMPTY no rule should UNKNOWN got=$r"; fail=1; }
  # A real read should produce SOMETHING (not empty, not DEGRADED unless 2+ missing)
  [ -n "$r" ] || { echo "  FAIL: classifier must always produce output"; fail=1; }
  [ "$fail" = 1 ] && { echo "smoke-test: FAIL"; exit 1; }
  # multi-field vocab-contract assert: room-sense/light enrich as LABEL|dwell_s=N|changes_24h=N.
  _mf="$(mktemp)"; printf 'PRESENT|dwell_s=120|changes_24h=5\n' > "$_mf"
  _got="$(read_state "$_mf")"; rm -f "$_mf"
  [ "$_got" = PRESENT ] || { echo "smoke-test: FAIL (read_state on LABEL|dwell_s= gave '$_got', expected PRESENT — dwell enrichment breaks label match)"; exit 1; }
  # per-input stale override: a 900s-old state is OFFLINE at the generic 600s cutoff but LIVE at the
  # room-sense 1800s cutoff (room-sense strides 15min — the generic cutoff false-OFFLINEd it 1-in-3
  # evals; a mutation dropping the override or the arg plumbing fails exactly these two asserts).
  _sf="$(mktemp)"; printf 'PRESENT|dwell_s=120|changes_24h=5\n' > "$_sf"; touch -d '900 seconds ago' "$_sf"
  _g1="$(read_state "$_sf")"; _g2="$(read_state "$_sf" "$ROOM_STALE_S")"; rm -f "$_sf"
  [ "$_g1" = OFFLINE ] || { echo "smoke-test: FAIL (900s-old state at default cutoff gave '$_g1', expected OFFLINE)"; exit 1; }
  [ "$_g2" = PRESENT ] || { echo "smoke-test: FAIL (900s-old state at ROOM_STALE_S gave '$_g2', expected PRESENT — per-input stale override broken)"; exit 1; }
  echo "smoke-test: ok (13 fusion assertions: IN_SEAT×2, RESTING, HANDLING×2, WALKING, AWAY×2, DARK_PRESENT, CHILLING, DEGRADED×3, UNKNOWN + multi-field label parse + per-input stale override)"
  exit 0
fi

# --- Live read path ---
pres="$(read_personal_presence "$MESH/.presence-state")"
room="$(read_state "$MESH/.room-sense.state" "$ROOM_STALE_S")"
motion="$(read_state "$MESH/.body-motion-state" "$MOTION_STALE_S")"
light="$(read_state "$MESH/.light-state" "$LIGHT_STALE_S")"
grav="$(read_state "$MESH/.gravity-state")"

# read_state may return the body-motion tag with brackets ([body-still]) — strip them so the
# classifier sees the bare tag (the classifier's grep regex accepts both forms, but stripping
# makes the reason-field output cleaner).
case "$motion" in
  '['body-*) motion="${motion#[}"; motion="${motion%]}" ;;
esac

result="$(classify_physical_context "$pres" "$room" "$motion" "$light" "$grav")"
label="${result%%|*}"
reason="${result#*|}"

TS=$(date -u +%Y-%m-%dT%H:%M:%SZ)

# Capture the previous label BEFORE overwriting STATE — the old order (write, then read prev back
# from the same file) made prev always equal the new label, so --edge NEVER fired: the edge log sat
# 0 bytes from wiring (2026-06-27) to 2026-07-07 while cron stayed green (change-mute hollow sense).
prev=""; [ -f "$STATE" ] && read -r prev _ < "$STATE" 2>/dev/null || true
prev_label="${prev%%|*}"

# Write state + touch liveness on EVERY successful run (mtime = ran-live, content = value-changed)
printf '%s|%s\n' "$label" "$reason" > "$STATE"
mesh-state-touch "$STATE"

# --- Output ---
if [ "${1:-}" = --json ]; then
  printf '{"label":"%s","reason":"%s","inputs":{"presence":"%s","room":"%s","motion":"%s","light":"%s","gravity":"%s"},"ts":"%s"}\n' \
    "$label" "$reason" "$pres" "$room" "$motion" "$light" "$grav" "$TS"
  exit 0
fi
if [ "${1:-}" = --edge ]; then
  [ "$prev_label" = "$label" ] && exit 0
  printf '[phys-%s] %s — %s\n' "$(printf '%s' "$label" | tr '[:upper:]' '[:lower:]')" "$label" "$reason"
  exit 0
fi
printf '[phys-%s] %s — %s\n' "$(printf '%s' "$label" | tr '[:upper:]' '[:lower:]')" "$label" "$reason"
