#!/usr/bin/env bash
# reflex-cadence: 9-59/15 * * * *
# doctor-artifact: $HOME/.mesh/.climate-state 2700
# mesh-climate — CROSS-SENSE CLIMATE FUSION: indoor barometer × outdoor forecast × indoor light.
#
# WHY (senses 2026-07-06): three climate-adjacent senses now run but nobody fuses them —
#   • mesh-baro (Note 3 LPS25H via ds, ~/.mesh/.baro-state, 5-min): REAL indoor pressure + trend
#   • mesh-weather (open-meteo, ~/.mesh/.weather-state, hourly): outdoor temp / thermal_day
#   • mesh-light (~/.mesh/.light-state): indoor luminance class
# No single sensor gives the DERIVED signal: is a weather front incoming / clearing / a thermal
# day building — and does an independent modality corroborate it? A falling barometer alone is a
# hypothesis; falling barometer + DIM indoor light in DAYTIME hours = two independent physical
# sensors agreeing on "overcast rolling in". thermal_day from the API + a stable/rising barometer
# = the heat forecast is weather (not a front), so mind-offload planning can trust it.
#
# Classes: FRONT-INCOMING (falling, Δ≤-1.5 hPa from baseline) · CLEARING (rising, Δ≥+1.5) ·
#          THERMAL-DAY (API thermal_day=1, pressure not falling) · STABLE · UNKNOWN (no inputs)
#
# HONESTY (hard rule): every input renders its OWN visible status — an unreachable baro node
# prints pressure=UNREACHABLE, an unseeded config prints pressure=UNCONFIGURED, a stale weather
# state prints outdoor=STALE. inputs=k/3 counts live ones. Never a silent all-clear.
#
#   mesh-climate           fuse cached states → write ~/.mesh/.climate-state (EVERY run, so
#                          mtime = liveness) + [climate] board edge on CLASS change only
#   mesh-climate --status  print last state line, no fusion
#   mesh-climate --test    classifier/render fixtures + live real-read gate (exit 2 honest n/a
#                          when NO input is live — never a fake green)
#
# THE BROADCAST SNAPSHOT (x̂) — a change is announced ONCE, and once was never verified.
#   Until 2026-08-18 the class-change gate compared the new class against $STATE, and $STATE was
#   written UNCONDITIONALLY one line earlier (it doubles as the liveness-touch: mtime = ran-live).
#   So the moment the state was written the transition was consumed, and the board post that
#   followed had its exit code thrown away (`>/dev/null 2>&1 || true`). A mesh-chat that failed
#   for ANY reason — board lock, a full disk, the NUL-corruption class — lost the transition
#   PERMANENTLY: the next tick reads prev_class = the new class, the gate holds, and no reader,
#   local or peer, ever learns the climate moved. Every liveness watchdog stays green throughout,
#   because the mtime keeps being touched. Silence is this reflex's normal output, so nothing can
#   tell a delivered change from a swallowed one.
#
#   LITERATURE (live review 2026-08-18: distributed-systems coordination — gossip/eventual
#   consistency; angle = a CROSS-DOMAIN transfer to a sensor mesh). Event-triggered communication
#   states the trigger against the RECEIVER'S copy, not the sender's own last value:
#     Zhai, Yuan, Ni, Wang, Zhang, Li — "Event-Triggered Gossip for Distributed Learning",
#     arXiv:2602.19116v1 [eess.SP], 22 Feb 2026 (https://arxiv.org/abs/2602.19116).
#   Each node transmits only when ‖x_i,t − x̂_i,t‖ ≥ τ_t, where **x̂ is the last snapshot the node
#   actually BROADCAST** — a separate variable from the local state x. That one indirection is
#   what makes a lost transmission self-healing: a failed broadcast leaves x̂ behind, the deviation
#   therefore persists, and the next tick re-fires. No acks, no retry queue, no second channel.
#   (The paper measures 69-72% fewer transmissions at ~0.6-0.8pp accuracy cost, and proves ergodic
#   convergence under a DECAYING threshold; a fixed nonzero τ leaves a permanent steady-state bias.
#   It has no max-silent-interval fallback — that gap is the mesh's liveness-touch convention,
#   which this file already keeps, and the two are complementary, not the same rung.)
#
#   Here x̂ is $STATE.announced: the class the board LAST ACCEPTED. It advances only when mesh-chat
#   returns 0. Three consequences: a failed post retries on the next tick by construction; the
#   announcement's "from" is what readers last heard (not what this node last computed, which they
#   may never have seen); and the gap between $STATE and $STATE.announced is now an ON-DISK,
#   AGEABLE measure of what we know but have not managed to tell anyone.
#
# Config (node-local ~/.mesh/nodes, never hardcoded here): MESH_CLIMATE_BARO_NODE=user@ip — the
# node whose ~/.mesh/.baro-state carries the barometer (unset + no local state → UNCONFIGURED).
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

MESH="$HOME/.mesh"
STATE="${MESH_CLIMATE_STATE:-$MESH/.climate-state}"
ANN="$STATE.announced"   # x̂ — the class the BOARD last accepted; never written on a failed post
BARO_TTL=1800     # mesh-baro cadence 5min → stale past 30min
WEATHER_TTL=9000  # mesh-weather hourly → stale past 2.5h
LIGHT_TTL=2400    # mesh-light's own doctor bound

[ -f "$MESH/nodes" ] && { set +u; . "$MESH/nodes" 2>/dev/null; set -u; }
BARO_NODE="${MESH_CLIMATE_BARO_NODE:-}"

# ---------- input readers (each returns "STATUS<TAB>payload") ----------

read_baro() {  # → "OK\thpa trend baseline age_s" | UNREACHABLE | STALE | UNCONFIGURED
  local out now mtime content age
  if [ -f "$MESH/.baro-state" ]; then                       # local body first
    content=$(cat "$MESH/.baro-state"); mtime=$(stat -c %Y "$MESH/.baro-state"); now=$(date +%s)
  elif [ -n "$BARO_NODE" ]; then
    out=$(ssh -o ConnectTimeout=6 -o BatchMode=yes -o StrictHostKeyChecking=no "$BARO_NODE" \
      'cat ~/.mesh/.baro-state 2>/dev/null && stat -c %Y ~/.mesh/.baro-state 2>/dev/null && date +%s' 2>/dev/null) || { printf 'UNREACHABLE\t'; return; }
    content=$(sed -n 1p <<<"$out"); mtime=$(sed -n 2p <<<"$out"); now=$(sed -n 3p <<<"$out")
    [ -n "$content" ] && [ -n "$mtime" ] || { printf 'UNREACHABLE\t'; return; }
  else
    printf 'UNCONFIGURED\t'; return
  fi
  age=$(( now - mtime ))
  [ "$age" -le "$BARO_TTL" ] || { printf 'STALE\t'; return; }
  # content: "984.90 STABLE 984.58" (hpa trend baseline)
  awk -v a="$age" 'NF>=3 && $1+0>800 && $1+0<1100 {printf "OK\t%s %s %s %d", $1, $2, $3, a; ok=1}
                   END {if (!ok) printf "UNREACHABLE\t"}' <<<"$content"
}

read_weather() {  # → "OK\tnow_c max_c thermal_day" | STALE | MISSING
  local f="$MESH/.weather-state" age line
  [ -f "$f" ] || { printf 'MISSING\t'; return; }
  age=$(( $(date +%s) - $(stat -c %Y "$f") ))
  [ "$age" -le "$WEATHER_TTL" ] || { printf 'STALE\t'; return; }
  line=$(cat "$f")
  grep -q '^OK ' <<<"$line" || { printf 'MISSING\t'; return; }
  awk '{ for(i=1;i<=NF;i++){ if($i~/^now_c=/)n=substr($i,7); if($i~/^today_max_c=/)m=substr($i,13); if($i~/^thermal_day=/)t=substr($i,13)} }
       END{ if(n!=""&&t!="") printf "OK\t%s %s %s", n, m, t; else printf "MISSING\t" }' <<<"$line"
}

read_light() {  # → "OK\tCLASS" | STALE | MISSING
  local f="$MESH/.light-state" age
  [ -f "$f" ] || { printf 'MISSING\t'; return; }
  age=$(( $(date +%s) - $(stat -c %Y "$f") ))
  [ "$age" -le "$LIGHT_TTL" ] || { printf 'STALE\t'; return; }
  # OFFLINE is mesh-light's OWN degrade class — a dark input here, never a live reading
  cut -d'|' -f1 "$f" | awk 'NF{if($1=="OFFLINE") printf "OFFLINE\t"; else printf "OK\t%s", $1; ok=1} END{if(!ok) printf "MISSING\t"}'
}

# ---------- pure classifier (fixture-testable, no I/O) ----------
# classify baro_st hpa trend baseline  wx_st thermal_day  light_st light  hour
#   → "CLASS overcast d_hpa"
classify() {
  local baro_st="$1" hpa="$2" trend="$3" base="$4" wx_st="$5" tday="$6" light_st="$7" light="$8" hour="$9"
  local d="n/a" class overcast="no"
  [ "$baro_st" = OK ] && d=$(awk -v h="$hpa" -v b="$base" 'BEGIN{printf "%+.2f", h-b}')
  if [ "$baro_st" = OK ] && [ "$trend" = FALLING ] && awk -v d="$d" 'BEGIN{exit !(d<=-1.5)}'; then
    class=FRONT-INCOMING
  elif [ "$baro_st" = OK ] && [ "$trend" = RISING ] && awk -v d="$d" 'BEGIN{exit !(d>=1.5)}'; then
    class=CLEARING
  elif [ "$wx_st" = OK ] && [ "$tday" = 1 ]; then
    class=THERMAL-DAY
  elif [ "$baro_st" = OK ] || [ "$wx_st" = OK ]; then
    class=STABLE
  else
    class=UNKNOWN
  fi
  if [ "$light_st" != OK ]; then overcast="n/a"
  elif [ "$hour" -ge 6 ] && [ "$hour" -le 20 ] && [ "$baro_st" = OK ] && [ "$trend" = FALLING ] \
       && { [ "$light" = DIM ] || [ "$light" = DARK ]; }; then overcast="corroborated"
  fi
  printf '%s %s %s' "$class" "$overcast" "$d"
}

# render baro_st hpa trend d  wx_st now_c max_c tday  light_st light  class overcast → state line
render() {
  local baro_st="$1" hpa="$2" trend="$3" d="$4" wx_st="$5" nc="$6" mc="$7" td="$8" light_st="$9" light="${10}" class="${11}" oc="${12}"
  local p w l n=0
  if [ "$baro_st" = OK ]; then p="in_hpa=$hpa trend=$trend d_hpa=$d"; n=$((n+1)); else p="pressure=$baro_st"; fi
  if [ "$wx_st"  = OK ]; then w="out_c=$nc max_c=$mc thermal_day=$td"; n=$((n+1)); else w="outdoor=$wx_st"; fi
  if [ "$light_st" = OK ]; then l="light=$light"; n=$((n+1)); else l="light=$light_st"; fi
  printf '%s | %s | %s | %s overcast=%s | inputs=%d/3 %s' "$class" "$p" "$w" "$l" "$oc" "$n" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
}

# ---------- modes ----------

# announce_step — the event-trigger, stated against x̂ (see the BROADCAST SNAPSHOT header).
# Returns 0 iff x̂ is now caught up (delivered, or nothing was owed); 1 iff a transition is still
# OWED because the post did not land. Writes $annf ONLY on a delivered post — that is the whole
# mechanism: an undelivered change leaves x̂ behind, so the deviation survives into the next tick.
announce_step() { # <annfile> <x̂> <class> <state-line>
  local annf="$1" xhat="$2" class="$3" line="$4"
  if [ -n "$xhat" ] && [ "$xhat" != "$class" ]; then
    if MESH_WHO="senses@$(hostname)" mesh-chat "[climate] $xhat -> $class ($line)" >/dev/null 2>&1; then
      printf '%s\n' "$class" > "$annf"; return 0
    fi
    return 1     # NOT delivered — x̂ stays behind on purpose; the next run re-fires
  fi
  printf '%s\n' "$class" > "$annf"   # nothing owed (or first-ever run): pin x̂ without announcing
  return 0
}

fuse() {
  local b bs hpa="" trend="" base="" w ws nc="" mc="" td="" lg ls light="" cls_out class oc d prev_class xhat new
  b=$(read_baro);    bs=${b%%$'\t'*}; [ "$bs" = OK ] && read -r hpa trend base _ <<<"${b#*$'\t'}"
  w=$(read_weather); ws=${w%%$'\t'*}; [ "$ws" = OK ] && read -r nc mc td <<<"${w#*$'\t'}"
  lg=$(read_light);  ls=${lg%%$'\t'*}; [ "$ls" = OK ] && light=${lg#*$'\t'}
  cls_out=$(classify "$bs" "$hpa" "$trend" "$base" "$ws" "$td" "$ls" "$light" "$(date +%-H)")
  read -r class oc d <<<"$cls_out"
  prev_class=$(awk '{print $1}' "$STATE" 2>/dev/null || true)
  # x̂: what the board last ACCEPTED. Bootstrap from the local state (never from empty) so a node
  # that has been running since before this file existed does not announce a phantom transition.
  xhat=$(head -1 "$ANN" 2>/dev/null | awk '{print $1}' || true)
  [ -n "$xhat" ] || xhat="$prev_class"
  new=$(render "$bs" "$hpa" "$trend" "$d" "$ws" "$nc" "$mc" "$td" "$ls" "$light" "$class" "$oc")
  printf '%s\n' "$new" > "$STATE"     # unconditional write: mtime = ran-live
  echo "$new"
  if [ -z "${MESH_CLIMATE_NO_POST:-}" ]; then
    announce_step "$ANN" "$xhat" "$class" "$new" || true   # a still-owed transition re-fires next tick
  fi
  # honest exit: nothing live at all → 2
  grep -q 'inputs=0/3' <<<"$new" && return 2 || return 0
}

case "${1:-}" in
  --status) cat "$STATE" 2>/dev/null || { echo "no state yet"; exit 1; } ;;
  --test)
    # tmp fence — task:doctor-test-tmpdir-cleanup-traps. Re-exec the smoke test ONCE under a private
    # TMPDIR and remove it from the PARENT, so the cleanup cannot be lost to the test's own `exit 1`
    # and cannot be clobbered by an EXIT trap the test sets for itself. A nested --test inherits the
    # guard var and skips its own fence (it is already inside one).
    if [ -z "${MESH_TEST_TMPD:-}" ]; then
      MESH_TEST_TMPD="$(mktemp -d)" || { echo "smoke-test: FAIL (tmp fence: mktemp -d)"; exit 1; }
      trap 'rm -rf "$MESH_TEST_TMPD"' EXIT INT HUP TERM
      export MESH_TEST_TMPD TMPDIR="$MESH_TEST_TMPD" TMP="$MESH_TEST_TMPD" TEMP="$MESH_TEST_TMPD"
      _fence_rc=0; "$0" "$@" || _fence_rc=$?; exit "$_fence_rc"
    fi
    fail=0; t(){ local want="$1"; shift; got=$(classify "$@"); [ "${got%% *}" = "$want" ] || { echo "FAIL: want $want got '$got' ($*)"; fail=1; }; }
    t FRONT-INCOMING OK 982.0 FALLING 984.5  OK 0  OK BRIGHT 12
    t CLEARING       OK 987.0 RISING  984.5  OK 0  OK BRIGHT 12
    t THERMAL-DAY    OK 984.6 STABLE  984.5  OK 1  OK BRIGHT 12
    t STABLE         OK 984.6 STABLE  984.5  OK 0  OK BRIGHT 12
    t STABLE         UNREACHABLE "" "" ""    OK 0  OK DIM 12          # baro dark ≠ front
    t UNKNOWN        UNREACHABLE "" "" ""    STALE "" MISSING "" 12   # all dark → UNKNOWN
    got=$(classify OK 982.0 FALLING 984.5 OK 0 OK DIM 12)
    [ "$(awk '{print $2}' <<<"$got")" = corroborated ] || { echo "FAIL: overcast corroboration ($got)"; fail=1; }
    got=$(classify OK 982.0 FALLING 984.5 OK 0 OK DIM 23)
    [ "$(awk '{print $2}' <<<"$got")" = no ] || { echo "FAIL: night must not corroborate ($got)"; fail=1; }
    # honest render: dark input must be VISIBLE, never silent
    r=$(render UNREACHABLE "" "" "" OK 20.5 22.6 0 OK DIM STABLE no)
    grep -q 'pressure=UNREACHABLE' <<<"$r" || { echo "FAIL: render hides dead baro ($r)"; fail=1; }
    grep -q 'inputs=2/3' <<<"$r" || { echo "FAIL: render inputs count ($r)"; fail=1; }
    # ---- x̂ / broadcast-snapshot gate (see the BROADCAST SNAPSHOT header) ----
    # Hermetic: a stub mesh-chat on PATH records every post and can be made to FAIL. The whole
    # point is the failure leg — before this gate existed the state advanced regardless of
    # delivery, so a swallowed post lost the transition forever and nothing could see it.
    _sd="$MESH_TEST_TMPD/stub"; mkdir -p "$_sd"; _cap="$MESH_TEST_TMPD/posts"
    _mkchat(){ local _d="${2:-$_sd}"; printf '#!/usr/bin/env bash\nprintf "%%s\\n" "$*" >> "%s"\nexit %s\n' "$_cap" "$1" > "$_d/mesh-chat"; chmod +x "$_d/mesh-chat"; }
    _oldpath="$PATH"; PATH="$_sd:$PATH"
    _annf="$MESH_TEST_TMPD/ann"; : > "$_cap"

    # A. OWED + the post FAILS → rc 1 and x̂ MUST NOT advance (the transition is still owed)
    _mkchat 1; printf 'STABLE\n' > "$_annf"
    announce_step "$_annf" STABLE CLEARING "line" && { echo "FAIL: a failed post must return 1"; fail=1; }
    [ "$(cat "$_annf")" = STABLE ] || { echo "FAIL: x̂ advanced on an UNDELIVERED post ($(cat "$_annf"))"; fail=1; }

    # B. next tick, delivery works → posts, advances x̂, and the 'from' is x̂ (what readers last heard)
    _mkchat 0; : > "$_cap"
    announce_step "$_annf" STABLE CLEARING "line" || { echo "FAIL: a delivered post must return 0"; fail=1; }
    [ "$(cat "$_annf")" = CLEARING ] || { echo "FAIL: x̂ did not advance on a DELIVERED post"; fail=1; }
    grep -q 'STABLE -> CLEARING' "$_cap" || { echo "FAIL: announcement must read from x̂ ($(cat "$_cap"))"; fail=1; }

    # C. HOLD: x̂ already equals the class → no post at all (a gate that always fires is a flood)
    : > "$_cap"; announce_step "$_annf" CLEARING CLEARING "line" || { echo "FAIL: hold must return 0"; fail=1; }
    [ -s "$_cap" ] && { echo "FAIL: held class must post nothing ($(cat "$_cap"))"; fail=1; }

    # D. BOOTSTRAP: no x̂ yet → pin it silently, never announce a phantom transition
    rm -f "$_annf"; : > "$_cap"
    announce_step "$_annf" "" STABLE "line" || { echo "FAIL: bootstrap must return 0"; fail=1; }
    [ -s "$_cap" ] && { echo "FAIL: bootstrap must not announce ($(cat "$_cap"))"; fail=1; }
    [ "$(cat "$_annf")" = STABLE ] || { echo "FAIL: bootstrap must pin x̂"; fail=1; }

    # E. THE WIRING, not the function: drive the REAL script as a CHILD with a seeded x̂ that cannot
    # match any class, so the live path must post and advance x̂ — and must NOT advance it when the
    # post fails. A FAKE $HOME, not a PATH prefix: the child re-runs `export PATH=$HOME/.local/bin:$PATH`
    # at load, so a stub merely prepended to PATH is shadowed by the REAL mesh-chat and the leg posts
    # to the live board ([[path-stub-cannot-shadow-a-mesh-tool]] — observed here, one stray board line).
    _fh="$MESH_TEST_TMPD/home"; mkdir -p "$_fh/.local/bin" "$_fh/.mesh"
    _lst="$MESH_TEST_TMPD/live.state"; : > "$_lst"
    printf 'SEEDXX\n' > "$_lst.announced"; _mkchat 1 "$_fh/.local/bin"; : > "$_cap"
    ( HOME="$_fh" MESH_CLIMATE_STATE="$_lst" "$0" >/dev/null 2>&1 ) || true
    [ "$(cat "$_lst.announced")" = SEEDXX ] || { echo "FAIL: fuse advanced x̂ through a FAILED post ($(cat "$_lst.announced"))"; fail=1; }
    grep -q 'SEEDXX ->' "$_cap" || { echo "FAIL: the failed leg never reached the stub — PATH/HOME fence broken"; fail=1; }
    _mkchat 0 "$_fh/.local/bin"; : > "$_cap"
    ( HOME="$_fh" MESH_CLIMATE_STATE="$_lst" "$0" >/dev/null 2>&1 ) || true
    [ "$(cat "$_lst.announced")" = SEEDXX ] && { echo "FAIL: fuse did not advance x̂ on a delivered post"; fail=1; }
    grep -q 'SEEDXX ->' "$_cap" || { echo "FAIL: fuse did not announce from x̂ ($(cat "$_cap"))"; fail=1; }
    PATH="$_oldpath"

    [ "$fail" = 0 ] || exit 1
    echo "fixtures OK"
    # live real-read gate: the fusion must parse ≥1 REAL input right now (sandboxed state + no board post)
    live=$(MESH_CLIMATE_STATE=$(mktemp) MESH_CLIMATE_NO_POST=1 "$0") || { echo "live: no input reachable (honest n/a)"; exit 2; }
    grep -qE 'in_hpa=[0-9]|out_c=[0-9-]' <<<"$live" || { echo "live: no numeric reading parsed: $live"; exit 2; }
    echo "live OK: $live"
    ;;
  ""|--edge) fuse ;;
  *) echo "usage: mesh-climate [--status|--test]"; exit 1 ;;
esac
