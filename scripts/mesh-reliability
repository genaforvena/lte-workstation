#!/usr/bin/env bash
# mesh-reliability — QUANTIFY the mesh's self-healing over a window: pair each failure
# ([doctor] FAIL, [health-fail]) with its recovery ([doctor] RECOVERED, [health-ok]) on the board and
# report # incidents, # auto-recovered, and mean-time-to-recovery. Turns a scary "N incidents" count
# into the reassurance an away-for-days operator needs — "all self-healed, 0 needed a human" — i.e.
# proof the autonomous backbone works, in numbers. (Reliability engineering on the board's own
# fail→recovery event pairs.) Shared by mesh-since (on-return brief) + mesh-digest (daily report).
#
# --load adds the ALLOSTATIC-LOAD axis (enactive/interoceptive regulation — allostasis, McEwen's
# allostatic overload; the 2026 "interoceptive machine framework" arXiv:2604.24527 names allostasis
# a core interoceptive principle). The default summary reports MAGNITUDE (# incidents, all recovered =
# green). But a subsystem flapping fail→recover→fail→recover reads green EVERY window while it is in
# Type-II allostatic OVERLOAD — the diagnostic signal is the correction FREQUENCY per subsystem, not
# the magnitude of any one error (allostatic-overload-correction-frequency-gap). --load is that
# missing observer: per-subsystem correction RECURRENCE over the window, READ-ONLY (no escalation —
# baseline-first, no hollow calibrated alarm). Cross-sectional twin: mesh-algedonic.
#
#   mesh-reliability                 one-line summary over the last 24h
#   mesh-reliability --window <h>    over the last <h> hours
#   mesh-reliability --load          per-subsystem correction recurrence (allostatic load, read-only)
#   mesh-reliability --since <ep> --now <ep>   explicit epoch window
#   mesh-reliability --test          smoke test
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
CHAT="${MESH_CHAT_LOG:-$HOME/.mesh/chat.log}"

smoke_test() {
  command -v python3 >/dev/null 2>&1 || { echo "smoke-test: FAIL (no python3)"; exit 1; }
  command -v mktemp >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mktemp)"; exit 1; }
  command -v grep >/dev/null 2>&1 || { echo "smoke-test: FAIL (no grep)"; exit 1; }
  command -v date >/dev/null 2>&1 || { echo "smoke-test: FAIL (no date)"; exit 1; }
  tmp="$(mktemp)" || { echo "smoke-test: FAIL (mktemp failed)"; exit 1; }
  trap 'rm -f "$tmp"' EXIT
  # Use dynamic timestamps (1h ago) so the synthetic data always falls inside --window 24.
  # Hardcoded dates age out of the window and cause false FAIL after 24h (bit us 2026-06-13).
  t0="$(date -u -d '60 minutes ago' +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u -v-60M +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)"
  t1="$(date -u -d '57 minutes ago' +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u -v-57M +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)"
  t2="$(date -u -d '55 minutes ago' +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u -v-55M +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)"
  t3="$(date -u -d '52 minutes ago' +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u -v-52M +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)"
  printf '%s  doctor@node-a  ::  [doctor] FAIL mic declared but CAPTURE fails\n' "$t0" >"$tmp"
  printf '%s  doctor@node-a  ::  [doctor] RECOVERED mic capture works again\n'   "$t1" >>"$tmp"
  printf '%s  watchdog@node-b  ::  [health-fail] node-b ping down\n'              "$t2" >>"$tmp"
  printf '%s  watchdog@node-b  ::  [health-ok] node-b reachable again\n'          "$t3" >>"$tmp"
  out="$(MESH_CHAT_LOG="$tmp" "$0" --window 24 2>&1)" || { echo "smoke-test: FAIL (parser run failed: $out)"; exit 1; }
  printf '%s' "$out" | grep -q '2 fail-incident(s), 2 with a recorded auto-recovery' \
    || { echo "smoke-test: FAIL (unexpected parser output: $out)"; exit 1; }
  # --load (allostatic-load recurrence): add a 2nd node-b fail→recover so node-b recurs (2×) vs node-a (1×).
  t4="$(date -u -d '50 minutes ago' +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u -v-50M +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)"
  t5="$(date -u -d '48 minutes ago' +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u -v-48M +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)"
  printf '%s  watchdog@node-b  ::  [health-fail] node-b ping down again\n' "$t4" >>"$tmp"
  printf '%s  watchdog@node-b  ::  [health-ok] node-b reachable again\n'    "$t5" >>"$tmp"
  outl="$(MESH_CHAT_LOG="$tmp" "$0" --load --window 24 2>&1)" || { echo "smoke-test: FAIL (--load run failed: $outl)"; exit 1; }
  printf '%s' "$outl" | grep -qE 'health/node-b: 2 correction' \
    || { echo "smoke-test: FAIL (--load did not count node-b recurrence: $outl)"; exit 1; }
  printf '%s' "$outl" | grep -q 'highest recurrence: health/node-b' \
    || { echo "smoke-test: FAIL (--load did not rank the recurring subsystem first: $outl)"; exit 1; }
  printf '%s' "$outl" | grep -qi 'no escalation' \
    || { echo "smoke-test: FAIL (--load must stay read-only/no-escalation: $outl)"; exit 1; }
  echo "smoke-test: ok (+load allostatic-recurrence view)"; exit 0
}

[ "${1:-}" = --test ] && smoke_test

NOW="$(date -u +%s)"; SINCE=$(( NOW - 86400 )); MODE=summary   # default: last 24h, summary view
while [ $# -gt 0 ]; do
  case "$1" in
    --window) SINCE=$(( NOW - ${2:-24} * 3600 )); shift 2 ;;
    --load)   MODE=load; shift ;;
    --since)  SINCE="${2:-$SINCE}"; shift 2 ;;
    --now)    NOW="${2:-$NOW}"; shift 2 ;;
    *) shift ;;
  esac
done

python3 - "$CHAT" "$SINCE" "$NOW" "$MODE" <<'PY'
import datetime as dt, re, sys
path, since_s, now_s, mode = sys.argv[1:]
since, now = int(since_s), int(now_s)
ts_rx = re.compile(r"^(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ)\s+(\S+)")
events = []  # (epoch, kind, key, is_recovery)
try:
    fh = open(path, encoding="utf-8", errors="replace")
except OSError:
    print("• reliability: (no board log)"); sys.exit(0)
for raw in fh:
    m = ts_rx.match(raw)
    if not m:
        continue
    try:
        ep = dt.datetime.fromisoformat(m.group(1).replace("Z", "+00:00")).timestamp()
    except ValueError:
        continue
    if ep < since or ep > now:
        continue
    author, low = m.group(2), raw.lower()
    # ONLY real events, identified by AUTHOR (doctor@/watchdog@) — not prose that mentions the tags.
    if author.startswith("doctor@") and "[doctor]" in low:
        host = author.split("@")[-1]
        if "recovered" in low: events.append((ep, "doctor", host, True))
        elif "fail" in low:    events.append((ep, "doctor", host, False))
    elif author.startswith("watchdog@") and "[health-fail]" in low:
        hm = re.search(r"\[health-fail\]\s+(\S+)", raw, re.I)
        events.append((ep, "health", hm.group(1) if hm else "?", False))
    elif author.startswith("watchdog@") and "[health-ok]" in low:
        hm = re.search(r"\[health-ok\]\s+(\S+)", raw, re.I)
        events.append((ep, "health", hm.group(1) if hm else "?", True))
    elif author.startswith("egress@") and "[egress-bad]" in low:   # geo-block = the core vulnerability
        events.append((ep, "egress", author.split("@")[-1], False))
    elif author.startswith("egress@") and "[egress-ok]" in low:
        events.append((ep, "egress", author.split("@")[-1], True))
events.sort()

if mode == "load":
    # ALLOSTATIC LOAD: per-subsystem correction RECURRENCE — how often each subsystem is being
    # fixed, the signal the magnitude summary structurally cannot see (a flapping subsystem reads
    # "all recovered = green" every window). READ-ONLY: report a baseline, escalate nothing.
    from collections import Counter
    corr = Counter()
    for (ep, k, key, rec) in events:
        if not rec:
            corr[(k, key)] += 1
    hrs = max(1, (now - since) // 3600)
    if not corr:
        print(f"• allostatic load: 0 corrections over {hrs}h — clean window (no subsystem being repeatedly fixed)")
    else:
        print(f"• allostatic load (correction recurrence over {hrs}h — how OFTEN each subsystem is fixed; "
              f"the magnitude summary reads green every cycle, this does not):")
        ranked = sorted(corr.items(), key=lambda x: (-x[1], x[0]))
        for (k, key), c in ranked:
            print(f"    {k}/{key}: {c} correction(s)")
        top, tc = ranked[0]
        if tc > 1:
            print(f"  ← highest recurrence: {top[0]}/{top[1]} ({tc}×) — allostatic-load candidate "
                  f"(green on magnitude, costly on frequency); read-only baseline, no escalation. Twin: mesh-algedonic")
    sys.exit(0)

recs = [(ep, k, key) for (ep, k, key, rec) in events if rec]
used = [False] * len(recs)
mttrs, n = [], 0
for (fep, fk, fkey, frec) in events:
    if frec:
        continue
    n += 1
    hit = next((i for i, (rep, rk, rkey) in enumerate(recs)
                if not used[i] and rk == fk and rkey == fkey and rep >= fep), None)
    if hit is not None:
        used[hit] = True
        mttrs.append(recs[hit][0] - fep)
if n == 0:
    print("• reliability: 0 fail/recover incidents — clean window")
else:
    rec_n = len(mttrs)
    mttr = "n/a"
    if mttrs:
        avg = sum(mttrs) / len(mttrs); mttr = f"{int(avg // 60)}m{int(avg % 60):02d}s"
    note = " — the mesh self-tended, 0 needed a human" if rec_n == n else " (older ones predate the recovery-signal)"
    print(f"• reliability: {n} fail-incident(s), {rec_n} with a recorded auto-recovery (avg MTTR {mttr}){note}")
PY
