#!/usr/bin/env bash
# mesh-beacon-watch — detect a stale neighbour beacon and auto-restore their session.
# Roadmap item: "Neighbour auto-restore on stale beacon — regeneration without a mind. [$0]"
#
# Each node pushes a heartbeat.beat file to its neighbours (via mesh-heartbeat). If that file
# goes stale (age > MAX_AGE), the neighbour's session is presumed dead — fire mesh-restore over
# SSH to revive it, then alert the operator.
#
#   mesh-beacon-watch                      check all watched beats, restore stale
#   mesh-beacon-watch --status             report age of each beat file, no action
#
# Config: ~/.mesh/beacon-watch.list  (one entry per line):
#   <beat-file-path> | <ssh-target user@ip> | <max-age-seconds> | <label>
#   e.g.:  ~/.mesh/heartbeat-<hostname>.beat | user@<ts-ip> | 21600 | <label>
#
# Default max-age: 2× the beacon's own cadence field, or 21600s (6h) if unreadable.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
LIST="${MESH_BEACON_WATCH_LIST:-$HOME/.mesh/beacon-watch.list}"
LOG="$HOME/.mesh/beacon-watch.log"
CHAT_LOG="${MESH_CHAT_LOG:-$HOME/.mesh/chat.log}"
stamp(){ date -u +%FT%TZ; }

# CORROBORATION primitive (chat-review/beacon-kill-needs-corroboration 2026-07-05): a stale beat
# proves the beacon WRITER may be dead — NEVER that the node is. On 2026-07-05 11:00Z this watcher
# ran `tmux kill-server` against a LIVE IdeaPad steward (it had authored ~30 board lines in the
# prior hour, visible in this watcher's OWN gossiped chat.log), killing every mind pane mid-work +
# violating tmux-append-only from inside the mesh. Before any destructive kill, corroborate deadness:
# a peer that AUTHORED a board line AFTER its beat went stale is provably alive. Returns 0 (peer
# proven LIVE) if any '<who>@<host>  ::' chat.log line carries an ISO ts newer than the beat epoch.
# Pure + testable (takes host, beat_epoch, log path — no globals, no side effects).
peer_authored_after(){ # $1 peer_host  $2 beat_epoch  $3 chat_log  -> 0 = peer authored after beat (LIVE)
  local host="$1" beat="$2" log="$3" isots ep
  [ -n "$host" ] && [ -f "$log" ] || return 1
  [[ "$beat" =~ ^[0-9]+$ ]] || return 1
  while IFS= read -r isots; do
    [ -n "$isots" ] || continue
    ep=$(date -d "$isots" +%s 2>/dev/null) || continue
    [ "$ep" -gt "$beat" ] && return 0
  done < <(grep -F "@${host}  ::" "$log" 2>/dev/null | tail -60 | awk '{print $1}')
  return 1
}

# secondary corroboration: a live tmux server on the peer means killing it destroys REAL sessions.
peer_tmux_alive(){ # $1 ssh_target -> 0 if peer answers with ≥1 tmux session
  local s; s="$(ssh -o BatchMode=yes -o ConnectTimeout=10 "$1" \
    'tmux list-sessions 2>/dev/null | head -1' </dev/null 2>/dev/null)"
  [ -n "$s" ]
}

[ "${1:-}" = --test ] && {
  command -v tailscale >/dev/null 2>&1 || { echo "smoke-test: FAIL (no tailscale)"; exit 1; }
  command -v ssh >/dev/null 2>&1 || { echo "smoke-test: FAIL (no ssh)"; exit 1; }
  command -v mesh-chat >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-chat)"; exit 1; }
  command -v date >/dev/null 2>&1 || { echo "smoke-test: FAIL (no date)"; exit 1; }
  command -v touch >/dev/null 2>&1 || { echo "smoke-test: FAIL (no touch)"; exit 1; }
  command -v mktemp >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mktemp)"; exit 1; }
  command -v grep >/dev/null 2>&1 || { echo "smoke-test: FAIL (no grep)"; exit 1; }
  command -v sed >/dev/null 2>&1 || { echo "smoke-test: FAIL (no sed)"; exit 1; }
  command -v awk >/dev/null 2>&1 || { echo "smoke-test: FAIL (no awk)"; exit 1; }
  [ -f "$LIST" ] || { echo "smoke-test: FAIL (no watch list: $LIST)"; exit 1; }
  [ -r "$LIST" ] || { echo "smoke-test: FAIL (watch list unreadable: $LIST)"; exit 1; }
  touch "$LOG" 2>/dev/null || { echo "smoke-test: FAIL (log not writable: $LOG)"; exit 1; }
  t="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp -d)"; exit 1; }
  trap 'rm -rf "$t"' EXIT
  fresh="$t/fresh.beat"
  stale="$t/stale.beat"
  missing="$t/missing.beat"
  now="$(date +%s)"
  : >"$fresh" || { echo "smoke-test: FAIL (fresh beat)"; exit 1; }
  : >"$stale" || { echo "smoke-test: FAIL (stale beat)"; exit 1; }
  touch -d "@$((now - 5))" "$fresh" 2>/dev/null || { echo "smoke-test: FAIL (fresh mtime)"; exit 1; }
  touch -d "@$((now - 5000))" "$stale" 2>/dev/null || { echo "smoke-test: FAIL (stale mtime)"; exit 1; }
  cat >"$t/list" <<EOF
$fresh | user@127.0.0.1 | 30 | fresh-node
$stale | user@127.0.0.1 | 30 | stale-node
$missing | user@127.0.0.1 | 30 | missing-node
EOF
  out="$(MESH_BEACON_WATCH_LIST="$t/list" "$0" --status 2>&1)" || {
    echo "smoke-test: FAIL (status dry-run errored: $out)"; exit 1; }
  printf '%s\n' "$out" | grep -q 'OK       fresh-node  age=' \
    || { echo "smoke-test: FAIL (fresh status missing: $out)"; exit 1; }
  printf '%s\n' "$out" | grep -q 'STALE    stale-node  age=' \
    || { echo "smoke-test: FAIL (stale status missing: $out)"; exit 1; }
  printf '%s\n' "$out" | grep -q 'MISSING  missing-node' \
    || { echo "smoke-test: FAIL (missing status missing: $out)"; exit 1; }
  # --leases / --alive: the LEASE READ primitive (announced-within-TTL), read-only.
  lout="$(MESH_BEACON_WATCH_LIST="$t/list" "$0" --leases 2>&1)" || true
  printf '%s\n' "$lout" | grep -q 'ALIVE    fresh-node' \
    || { echo "smoke-test: FAIL (--leases: fresh beat not ALIVE: $lout)"; exit 1; }
  printf '%s\n' "$lout" | grep -q 'STALE    stale-node' \
    || { echo "smoke-test: FAIL (--leases: stale beat not STALE: $lout)"; exit 1; }
  printf '%s\n' "$lout" | grep -q 'MISSING  missing-node' \
    || { echo "smoke-test: FAIL (--leases: missing beat not MISSING: $lout)"; exit 1; }
  MESH_BEACON_WATCH_LIST="$t/list" "$0" --alive fresh-node >/dev/null 2>&1 \
    || { echo "smoke-test: FAIL (--alive fresh-node should exit 0)"; exit 1; }
  MESH_BEACON_WATCH_LIST="$t/list" "$0" --alive stale-node >/dev/null 2>&1 \
    && { echo "smoke-test: FAIL (--alive stale-node should exit 1 — lease expired)"; exit 1; }
  MESH_BEACON_WATCH_LIST="$t/list" "$0" --alive missing-node >/dev/null 2>&1 \
    && { echo "smoke-test: FAIL (--alive missing-node should exit 1 — never announced)"; exit 1; }
  # --- corroboration gate (chat-review/beacon-kill-needs-corroboration) ---
  # A peer-authored board line NEWER than the beat MUST read as LIVE (guards against killing a live
  # node); an OLDER line must NOT (else the kill is wrongly skipped for a genuinely dead node).
  clog="$t/chat.log"; beat_ep=$((now - 3600))   # beat went stale an hour ago
  {
    printf '%s  guardian@peer-alpha  ::  [heartbeat] alive\n' "$(date -u -d "@$((now-120))" +%FT%TZ)"   # 58min AFTER beat
    printf '%s  minds@other-node  ::  [idle] unrelated host\n' "$(date -u -d "@$((now-60))" +%FT%TZ)"
  } > "$clog"
  peer_authored_after "peer-alpha" "$beat_ep" "$clog" \
    || { echo "smoke-test: FAIL (corroborate: peer authored AFTER beat must read LIVE — a live node would be killed)"; exit 1; }
  # FALSIFIABILITY: same peer but its only line is OLDER than the beat → must NOT read live
  printf '%s  guardian@peer-beta  ::  [heartbeat] old\n' "$(date -u -d "@$((now-7200))" +%FT%TZ)" > "$clog"   # 1h BEFORE beat
  peer_authored_after "peer-beta" "$beat_ep" "$clog" \
    && { echo "smoke-test: FAIL (corroborate: a line OLDER than the beat must NOT read LIVE — dead node would never be recovered)"; exit 1; }
  # a DIFFERENT host authoring recently must not vouch for our peer
  printf '%s  minds@somebody-else  ::  [done] recent\n' "$(date -u -d "@$((now-1))" +%FT%TZ)" > "$clog"
  peer_authored_after "peer-gamma" "$beat_ep" "$clog" \
    && { echo "smoke-test: FAIL (corroborate: another host's line must not vouch for this peer)"; exit 1; }
  # missing log / non-numeric beat → safe negative (never a false LIVE that skips a needed kill)
  peer_authored_after "peer-alpha" "$beat_ep" "$t/nope.log" \
    && { echo "smoke-test: FAIL (corroborate: missing chat.log must read NOT-live)"; exit 1; }
  peer_authored_after "peer-alpha" "notanumber" "$clog" \
    && { echo "smoke-test: FAIL (corroborate: non-numeric beat epoch must read NOT-live)"; exit 1; }
  # --- attempt-1 firing gate (chat-review/beacon-attempt1-no-corroboration) ---------------------
  # Drive the REAL firing path in a fully sandboxed HOME with stubbed ssh/mesh-chat/mesh-tg so no
  # board post, TG, or SSH escapes. Assert: a LIVE peer (authoring after the beat) draws a quiet
  # [fyi] + mesh-heartbeat restart and NO 🔄 restore alarm; a genuinely-dead peer (no board line +
  # tmux silent) STILL draws the loud 🔄 (falsifiability — the gate gates, it didn't just mute).
  h="$t/home"; mkdir -p "$h/.local/bin" "$h/.mesh"
  cat >"$h/.local/bin/ssh" <<'STUB'
#!/usr/bin/env bash
cmd="$*"
case "$cmd" in
  *mesh-card*)            echo "minds: claude";;      # card-gate: peer declares minds
  *"tmux list-sessions"*) : ;;                        # tmux silent -> peer_tmux_alive = dead
  *mesh-heartbeat*)       echo heartbeat-restarted;;
  *mesh-restore*)         echo restored;;
  *)                      : ;;
esac
exit 0
STUB
  cat >"$h/.local/bin/mesh-chat" <<'STUB'
#!/usr/bin/env bash
printf '%s\n' "$*" >> "$CAPTURE"
STUB
  cp "$h/.local/bin/mesh-chat" "$h/.local/bin/mesh-tg"
  chmod +x "$h/.local/bin/ssh" "$h/.local/bin/mesh-chat" "$h/.local/bin/mesh-tg"
  now2="$(date +%s)"
  # LIVE fixture: beat just barely stale (age~40s, well under any real uptime so the post-reboot
  # suppressor never trips), peer authored a chat.log line AFTER the beat.
  livebeat="$h/.mesh/heartbeat-livepeer.beat"; : >"$livebeat"
  touch -d "@$((now2-40))" "$livebeat" 2>/dev/null || { echo "smoke-test: FAIL (attempt1: live beat mtime)"; exit 1; }
  printf '%s  guardian@livepeer  ::  [heartbeat] alive\n' "$(date -u -d "@$((now2-10))" +%FT%TZ)" > "$h/.mesh/chat.log"
  printf '%s | user@127.0.0.1 | 30 | livepeer\n' "$livebeat" > "$h/live.list"
  HOME="$h" PATH="$h/.local/bin:$PATH" CAPTURE="$h/alerts-live.log" \
    MESH_BEACON_WATCH_LIST="$h/live.list" MESH_CHAT_LOG="$h/.mesh/chat.log" \
    "$0" >/dev/null 2>&1 || true
  grep -q '🔄' "$h/alerts-live.log" 2>/dev/null \
    && { echo "smoke-test: FAIL (attempt1: LIVE peer must NOT emit a 🔄 restore alarm; got: $(cat "$h/alerts-live.log"))"; exit 1; }
  grep -q '\[fyi\] beacon-writer-dead' "$h/alerts-live.log" 2>/dev/null \
    || { echo "smoke-test: FAIL (attempt1: LIVE peer must emit the quiet [fyi] beacon-writer-dead; got: $(cat "$h/alerts-live.log" 2>/dev/null))"; exit 1; }
  # DEAD fixture: same shape but no board line for this peer (tmux stub is silent) -> must cry 🔄.
  deadbeat="$h/.mesh/heartbeat-deadpeer.beat"; : >"$deadbeat"
  touch -d "@$((now2-40))" "$deadbeat" 2>/dev/null || { echo "smoke-test: FAIL (attempt1: dead beat mtime)"; exit 1; }
  printf '%s | user@127.0.0.1 | 30 | deadpeer\n' "$deadbeat" > "$h/dead.list"
  HOME="$h" PATH="$h/.local/bin:$PATH" CAPTURE="$h/alerts-dead.log" \
    MESH_BEACON_WATCH_LIST="$h/dead.list" MESH_CHAT_LOG="$h/.mesh/chat.log" \
    "$0" >/dev/null 2>&1 || true
  grep -q '🔄' "$h/alerts-dead.log" 2>/dev/null \
    || { echo "smoke-test: FAIL (attempt1: genuinely-dead peer MUST still emit the loud 🔄 — gate mutes live, not dead; got: $(cat "$h/alerts-dead.log" 2>/dev/null))"; exit 1; }
  echo "smoke-test: ok (status + lease-read cover fresh/stale/missing beacons; corroboration gate: newer=LIVE, older/other-host/missing=NOT-live; attempt-1 firing: LIVE peer→quiet [fyi]+heartbeat-restart no 🔄, dead peer→loud 🔄, both falsifiable)"; exit 0
}

mkdir -p "$HOME/.mesh"

# --- LEASE READ primitive (presence-by-announcement w/ TTL) ----------------------------------------
# Liveness is a LEASE, not a cached boolean (operator 2026-06-21, ds false-all-clear root cause):
# "is <label> alive?" resolves to "did it ANNOUNCE within its TTL?" — the beat-file mtime is the
# announcement, max_age is the lease. Read-only (never restores). Presence EXPIRES by default: a
# missing/stale beat is STALE/MISSING, never a remembered "online".
#   mesh-beacon-watch --leases          one line per watched label: ALIVE|STALE|MISSING + age/ttl
#   mesh-beacon-watch --alive <label>   exit 0 iff that label announced within TTL (else 1)
if [ "${1:-}" = --leases ] || [ "${1:-}" = --alive ]; then
  want="${2:-}"; nowl=$(date +%s); rc=1
  [ -f "$LIST" ] && [ -s "$LIST" ] || { [ "$1" = --leases ] && echo "no watch list ($LIST) — nothing leased"; exit 1; }
  while IFS='|' read -r bf st ma lb; do
    bf="$(printf '%s' "$bf" | xargs)"; ma="$(printf '%s' "$ma" | xargs)"; lb="$(printf '%s' "$lb" | xargs)"
    case "$bf" in ''|\#*) continue;; esac
    bf="${bf/#\~/$HOME}"
    [ "$1" = --alive ] && [ "$lb" != "$want" ] && continue
    if [ ! -f "$bf" ]; then
      [ "$1" = --leases ] && echo "  MISSING  $lb  (no announcement ever — $bf)"
      continue
    fi
    age=$(( nowl - $(date -r "$bf" +%s 2>/dev/null || echo "$nowl") ))
    if [ -z "$ma" ]; then
      cad=$(grep -m1 '^cadence:' "$bf" 2>/dev/null | awk '{print $2}')
      case "$cad" in *h) ma=$(( ${cad%h}*7200 ));; *m) ma=$(( ${cad%m}*120 ));; *) ma=21600;; esac
    fi
    if [ "$age" -lt "$ma" ]; then
      [ "$1" = --leases ] && echo "  ALIVE    $lb  age=${age}s ttl=${ma}s (announced within lease)"
      [ "$1" = --alive ] && rc=0
    else
      [ "$1" = --leases ] && echo "  STALE    $lb  age=${age}s ttl=${ma}s (lease EXPIRED — presume not alive, corroborate)"
    fi
  done < "$LIST"
  exit $rc
fi

STATUS=0; [ "${1:-}" = --status ] && STATUS=1
now=$(date +%s)

# Local uptime (seconds) — used to detect stale-to-online transition:
# if local uptime < beat age, the beat file is from a previous boot;
# suppress the first restore (we just rebooted, peer may be fine).
local_uptime=$(awk '{print int($1)}' /proc/uptime 2>/dev/null || echo 0)
local_hostname=$(hostname)

alert(){
  command -v mesh-tg >/dev/null 2>&1 && { mesh-tg "$1" 2>&1 || echo "$(stamp) WARN mesh-tg failed for: $1" >> "$LOG"; }
  mesh-chat "$1" 2>&1 || echo "$(stamp) WARN mesh-chat failed for: $1" >> "$LOG"
}

[ -f "$LIST" ] || { echo "no watch list ($LIST) — nothing watched"; exit 0; }
[ -s "$LIST" ] || { echo "watch list ($LIST) is empty — nothing watched"; exit 0; }

while IFS='|' read -r beat_file ssh_target max_age label; do
  beat_file="$(printf '%s' "$beat_file" | xargs)"
  ssh_target="$(printf '%s' "$ssh_target" | xargs)"
  max_age="$(printf '%s' "$max_age" | xargs)"
  label="$(printf '%s' "$label" | xargs)"
  case "$beat_file" in ''|\#*) continue;; esac

  # expand ~
  beat_file="${beat_file/#\~/$HOME}"

  # peer host for the corroboration gate: canonical from the beat filename (heartbeat-<host>.beat),
  # falling back to the friendly label. Used to find peer-authored chat.log lines newer than the beat.
  peer_host="$(basename "$beat_file" 2>/dev/null | sed -n 's/^heartbeat-\(.*\)\.beat$/\1/p')"
  [ -n "$peer_host" ] || peer_host="$label"

  if [ ! -f "$beat_file" ]; then
    [ "$STATUS" = 1 ] && echo "  MISSING  $label  ($beat_file)" && continue
    echo "$(stamp) MISSING $label $beat_file" >> "$LOG"
    alert "⚠️ mesh-beacon-watch: $label beacon file missing ($beat_file) — cannot assess liveness"
    continue
  fi

  age=$(( now - $(date -r "$beat_file" +%s 2>/dev/null || echo "$now") ))

  # if max_age not set, try to read cadence from the beat file itself (2× cadence)
  if [ -z "$max_age" ]; then
    cad_str=$(grep -m1 '^cadence:' "$beat_file" 2>/dev/null | awk '{print $2}')
    case "$cad_str" in
      *h) max_age=$(( ${cad_str%h} * 3600 * 2 ));;
      *m) max_age=$(( ${cad_str%m} * 60  * 2 ));;
      *)  max_age=21600;;
    esac
  fi

  if [ "$STATUS" = 1 ]; then
    if [ "$age" -ge "$max_age" ]; then
      echo "  STALE    $label  age=${age}s  max=${max_age}s  -> $ssh_target"
    else
      echo "  OK       $label  age=${age}s  max=${max_age}s"
    fi
    continue
  fi

  if [ "$age" -ge "$max_age" ]; then
    # fix beacon-stale-false-after-reboot: suppress first restore if node just rebooted
    # condition: uptime < age indicates beat file from previous boot, peer may be fine
    # this prevents false restores when a node comes back online after an offline period
    if [ "$local_uptime" -gt 0 ] && [ "$age" -gt "$local_uptime" ]; then
      [ "$STATUS" = 0 ] && echo "$(stamp) STALE $label (uptime ${local_uptime}s < age ${age}s) — suppress first restore after reboot" >> "$LOG"
      [ "$STATUS" = 1 ] && echo "  STALE    $label  age=${age}s  max=${max_age}s  (suppressed: uptime ${local_uptime}s < age — post-reboot)"
      continue
    fi
    # fire-backoff: a peer that STAYS stale (dead host) must not be re-fired/re-alerted on every
    # pass — 2026-06-11 default-string (19h dead) got an SSH attempt + board post every ~45s from
    # stacked callers (cron + mind-watch). One restore attempt per backoff window per label.
    ff="$HOME/.mesh/.beacon-fire-${label//[^A-Za-z0-9_-]/_}"
    backoff="${BEACON_FIRE_BACKOFF:-3600}"
    now=$(date +%s); last=$(cat "$ff" 2>/dev/null || echo 0)
    if [ $((now - last)) -lt "$backoff" ]; then
      echo "$(stamp) STALE $label (backoff: fired $((now-last))s ago, window ${backoff}s) — skip" >> "$LOG"
      continue
    fi
    echo "$now" > "$ff"
    # consecutive-failure escalation (chat-review/beacon-watch-escalation 2026-06-15): each firing
    # pass means the PREVIOUS restore did NOT revive the node (else its beat would be fresh by now).
    # Count consecutive failures per-label; keep the loud 🔄 for the first attempts, fire ONE TG
    # escalation at the threshold, then retry SILENTLY (log only) — instead of posting 🔄 every hour
    # forever for a node that stays dead. Counter resets (and announces recovery) on a fresh beat below.
    cf="$HOME/.mesh/.beacon-fail-${label//[^A-Za-z0-9_-]/_}"
    fails=$(cat "$cf" 2>/dev/null || echo 0); case "$fails" in ''|*[!0-9]*) fails=0;; esac
    fails=$((fails+1)); echo "$fails" > "$cf"
    thr="${BEACON_FAIL_THRESHOLD:-3}"
    echo "$(stamp) STALE $label age=${age}s max=${max_age}s -> restoring $ssh_target (fail #$fails)" >> "$LOG"

    # Card-gating: only auto-restore a peer that declares 'minds:' capability.
    # Compute-only / router / sense nodes don't have agent sessions to restore,
    # and firing mesh-restore on them is wasted work + noise.
    # Read card over SSH (best-effort; if unreachable, skip — can't restore what can't be reached).
    has_minds=0
    card="$(ssh -o BatchMode=yes -o ConnectTimeout=10 "$ssh_target" \
      'cat ~/.mesh-card 2>/dev/null' </dev/null 2>/dev/null)" && {
      printf '%s' "$card" | grep -q '^\s*minds:' && has_minds=1
    }
    if [ "$has_minds" = 0 ]; then
      echo "$(stamp) SKIP $label — no minds: capability on peer card (compute/router/sense-only node, nothing to restore)" >> "$LOG"
      rm -f "$cf"; continue
    fi

    # Escalating recovery: each attempt escalates the intervention level.
    # 1st try: direct ssh mesh-restore (lightest touch)
    # 2nd try: kill stale tmux server then restore (session may be wedged)
    # 3rd+: alert only — operator must intervene (node may be truly dead)
    case "$fails" in
      1)
        # CORROBORATE before crying wolf (chat-review/beacon-attempt1-no-corroboration 2026-07-12):
        # the corroboration used to guard only attempt #2's destructive kill-server, so attempt #1
        # fired the loud 🔄 + a blind full mesh-restore UNCONDITIONALLY. A live node whose beacon
        # WRITER (mesh-heartbeat) had died — but which was still authoring board lines — thus ate a
        # cry-wolf alarm every window, and the full restore didn't even revive the specific dead
        # writer (live 2026-07-11 18:00Z→19:30Z on IdeaPad-steward). Diagnose FIRST: if the peer is
        # provably LIVE, post a quiet [fyi] once and restart mesh-heartbeat DIRECTLY (revives the
        # dead writer, which re-pushes a fresh beat). Only a peer failing BOTH liveness probes gets
        # the loud attempt-1 restore.
        beat_epoch=$(date -r "$beat_file" +%s 2>/dev/null || echo 0)
        if peer_authored_after "$peer_host" "$beat_epoch" "$CHAT_LOG"; then live_via="chat.log author newer than beat"
        elif peer_tmux_alive "$ssh_target"; then live_via="tmux server answering"
        else live_via=""; fi
        if [ -n "$live_via" ]; then
          echo "$(stamp) LIVE $label ($live_via) — beacon WRITER dead, not node; restarting mesh-heartbeat, no 🔄 alarm" >> "$LOG"
          alert "[fyi] beacon-writer-dead: $label beacon stale (${age}s) but the NODE is LIVE ($live_via) — restarting mesh-heartbeat on $ssh_target directly (revives the dead beat-writer; no cry-wolf restore)."
          ssh -o BatchMode=yes -o ConnectTimeout=15 "$ssh_target" \
            '~/.local/bin/mesh-heartbeat >> ~/.mesh/heartbeat.log 2>&1 && echo heartbeat-restarted' \
            >> "$LOG" 2>&1 || echo "$(stamp) WARN ssh mesh-heartbeat restart to $ssh_target failed" >> "$LOG"
        else
          alert "🔄 mesh-beacon-watch: $label beacon stale (${age}s > ${max_age}s) — firing mesh-restore on $ssh_target (attempt 1/$thr)"
          ssh -o BatchMode=yes -o ConnectTimeout=15 "$ssh_target" \
            '~/.local/bin/mesh-restore >> ~/.mesh/restore.log 2>&1 && echo restored' \
            >> "$LOG" 2>&1 || echo "$(stamp) WARN ssh restore to $ssh_target failed" >> "$LOG"
        fi
        ;;
      2)
        # CORROBORATE before the destructive kill-server (chat-review/beacon-kill-needs-corroboration
        # 2026-07-05): a stale beat = dead WRITER, not a dead node. Only kill if the peer is NOT
        # authoring after the beat AND its tmux server does not answer — else the kill nukes live
        # mind panes (the 11:00Z live-IdeaPad incident) and breaks tmux-append-only from inside the mesh.
        beat_epoch=$(date -r "$beat_file" +%s 2>/dev/null || echo 0)
        if peer_authored_after "$peer_host" "$beat_epoch" "$CHAT_LOG"; then live_via="chat.log author newer than beat"
        elif peer_tmux_alive "$ssh_target"; then live_via="tmux server answering"
        else live_via=""; fi
        if [ -n "$live_via" ]; then
          echo "$(stamp) SKIP-KILL $label — peer LIVE ($live_via) — beacon WRITER dead, not node; gentle restore only" >> "$LOG"
          alert "[fyi] beacon-writer-dead: $label beacon stale (${age}s) but the NODE is LIVE ($live_via) — NOT killing its tmux (would nuke live panes). Restart mesh-heartbeat on $ssh_target; gentle mesh-restore fired."
          ssh -o BatchMode=yes -o ConnectTimeout=15 "$ssh_target" \
            '~/.local/bin/mesh-restore >> ~/.mesh/restore.log 2>&1 && echo restored' \
            >> "$LOG" 2>&1 || echo "$(stamp) WARN ssh gentle-restore to $ssh_target failed" >> "$LOG"
        else
          alert "🔄 mesh-beacon-watch: $label beacon stale (${age}s > ${max_age}s), peer NOT authoring + tmux silent — attempt 2: killing stale tmux then mesh-restore on $ssh_target"
          ssh -o BatchMode=yes -o ConnectTimeout=15 "$ssh_target" \
            'tmux kill-server 2>/dev/null; bash -lc "~/.local/bin/mesh-restore >> ~/.mesh/restore.log 2>&1 && echo restored"' \
            >> "$LOG" 2>&1 || echo "$(stamp) WARN ssh restore to $ssh_target failed" >> "$LOG"
        fi
        ;;
      3)
        alert "🛑 mesh-beacon-watch: $label still offline after 2 restore attempts — STOPPING further recovery, alerting operator (may need physical intervention)"
        ;;
      *)
        echo "$(stamp) STOPPED-RETRY $label (fail #$fails ≥ thr $thr) — no more restore attempts, alert already sent" >> "$LOG"
        ;;
    esac
  else
    # fresh beat — if this label had been failing, reset the counter and announce recovery ONCE
    # (so a node that comes back after the silent phase is not left silently presumed-dead).
    cf="$HOME/.mesh/.beacon-fail-${label//[^A-Za-z0-9_-]/_}"
    pf=$(cat "$cf" 2>/dev/null || echo 0); case "$pf" in ''|*[!0-9]*) pf=0;; esac
    if [ "$pf" -gt 0 ]; then
      rm -f "$cf"
      echo "$(stamp) RECOVERED $label (was failing ×$pf)" >> "$LOG"
      alert "✅ mesh-beacon-watch: $label beacon fresh again — recovered after $pf failed restore attempt(s)"
    fi
  fi
done < "$LIST"
