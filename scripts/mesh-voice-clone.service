[Unit]
Description=mesh voice-clone daemon (warm XTTS-v2, operator's cloned voice for all mesh speech)
After=default.target

[Service]
Type=simple
# CPU by default — decoupled from the GPU senses (see daemon header). Override in the environment
# file if you reserve VRAM: MESH_CLONE_DEVICE=cuda
Environment=MESH_CLONE_DEVICE=cpu
Environment=MESH_CLONE_THREADS=12
ExecStart=%h/.local/bin/mesh-voice-clone-daemon
Restart=always
RestartSec=5
# a bursty voice; let it idle without CPU nice-starving the senses
Nice=5

[Install]
WantedBy=default.target
