[Unit]
Description=mesh-cam-watch — motion-triggered camera reflex
After=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/mesh-cam-watch --daemon
Restart=always
RestartSec=5s
Environment=CAM_THRESH=11
Environment=CAM_POLL=2
Environment=CAM_COOLDOWN=20

[Install]
WantedBy=default.target
