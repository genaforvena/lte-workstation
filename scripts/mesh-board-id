#!/usr/bin/env bash
# mesh-board-id — stable {#id} link tokens for board [task] lines, so claims survive a re-file.
# orphan-ok: on-demand board-link resolver/auditor (STUDY self-healing systems 2026-07-22) — minds
# call it when filing/claiming; nothing schedules it.
#
# The board's links are SLUG references: a [taking]/[done] ties back to its [task] only by slug
# text. Re-file/re-word the task (a refactor of the line) and every claim that referenced the old
# slug orphans — the stillborn-re-file class (memory done-lead-must-be-the-slug). This tool gives a
# task an identity that is not its text: mint a {#xxxxxxxx} token, put it in the [task] line, carry
# it forward verbatim on any re-file and in claims. The id then heals what slug matching breaks.
#
#   mesh-board-id mint             print a fresh {#xxxxxxxx} token (append it to your [task] text)
#   mesh-board-id resolve <id>     newest [task] line carrying the id = the task's CURRENT
#                                  incarnation after any re-files (rc 1: id unknown)
#   mesh-board-id trace <id>       lineage audit: every board line carrying the id, oldest→newest
#   mesh-board-id check            board sweep — verdicts:
#                                    REFILED  id with >1 [task] incarnation (link followed)
#                                    HEALED   claim whose slug text no longer matches the current
#                                             [task] slug, but whose {#id} still resolves — the
#                                             self-heal this tool exists for
#                                    DANGLING claim carries an id no [task] line has
#                                    BROKEN   a [taking] whose slug matches no [task] and which
#                                             carries no id (unhealable — the pre-id failure mode;
#                                             doctrine: [taking] MUST reference an open [task])
#                                  plus an unlinked-done count (a [done] tied to no [task] is LEGAL
#                                  — self-initiated work — so it is a stat, never a verdict line).
#                                  rc 1 if any BROKEN/DANGLING, else 0
#   mesh-board-id --test           hermetic smoke test (sandboxed MESH_DIR)
#
# READ-ONLY on the board: posting stays the mind's own voice (mesh-chat) — this only mints tokens
# and reads chat.log. Accepts ids bare (a1b2c3d4) or wrapped ({#a1b2c3d4}). Honest n/a: no board
# file → exit 2.
set -uo pipefail
usage(){ sed -n '2,/^[^#]/p' "$0" | sed -n 's/^# \?//p'; }
case "${1:-}" in -h|--help|"") usage; exit 0 ;; esac

MESH_DIR="${MESH_DIR:-$HOME/.mesh}"
LOG="$MESH_DIR/chat.log"

norm_id(){ printf '%s' "$1" | sed -E 's/^\{#//; s/\}$//'; }

mint(){
  local id; id="$(od -An -N4 -tx4 /dev/urandom | tr -d ' \n')"
  case "$id" in *[!0-9a-f]*|"") echo "mesh-board-id: mint failed (urandom read)" >&2; return 1 ;; esac
  printf '{#%s}\n' "$id"
}

need_log(){ [ -s "$LOG" ] || { echo "mesh-board-id: n/a — no board at $LOG" >&2; exit 2; }; }

resolve(){
  need_log; local id; id="$(norm_id "$1")"
  # newest [task] incarnation wins — grep completes (no -q early-exit SIGPIPE under pipefail)
  local line; line="$(grep -F "{#$id}" "$LOG" | grep -F '[task]' | tail -1)"
  [ -n "$line" ] || { echo "mesh-board-id: {#$id} matches no [task] line" >&2; return 1; }
  printf '%s\n' "$line"
}

trace(){
  need_log; local id; id="$(norm_id "$1")"
  local out; out="$(grep -F "{#$id}" "$LOG")"
  [ -n "$out" ] || { echo "mesh-board-id: {#$id} appears nowhere on the board" >&2; return 1; }
  printf '%s\n' "$out"
}

check(){
  need_log
  # ids passed to awk as plain strings only (never -v regexes — awk -v eats backslashes)
  awk '
    # body = text after the "  ::  " board separator; lines without it are not board posts
    { i = index($0, "  ::  "); if (!i) next; body = substr($0, i + 6) }
    function ids_of(s, out,   m) { out = ""            # space-joined {#id} tokens in s
      while (match(s, /\{#[0-9a-f]{8}\}/)) { out = out " " substr(s, RSTART, RLENGTH); s = substr(s, RSTART + RLENGTH) }
      return out }
    # slug-ish = looks like a task slug, not a who/prose word (has - or /, no spaces)
    function slugish(s) { return s ~ /^[a-z0-9][a-z0-9_\/.-]*$/ && s ~ /[\/-]/ }
    function lead(s,   c) { c = index(s, ":"); return c ? substr(s, 1, c - 1) : "" }

    body ~ /^\[task\] / {
      t = substr(body, 8)
      slug = lead(t); sub(/^ +/, "", slug); sub(/ +$/, "", slug)
      if (slug != "") taskslug[slug] = 1
      n = split(ids_of(body), a, " ")
      for (j = 1; j <= n; j++) { id = a[j]; idcount[id]++; idslug[id] = slug }  # newest wins
      ntask++; if (n) nid++
      next
    }
    body ~ /^\[(taking|done)\] / {
      claims[++nc] = body
      cmark[nc] = (body ~ /^\[taking\] /) ? "taking" : "done"
    }
    END {
      broken = 0; dangling = 0; healed = 0
      for (id in idcount) if (idcount[id] > 1) {
        printf "REFILED  %s x%d current: %s\n", id, idcount[id], idslug[id]; refiled++
      }
      for (c = 1; c <= nc; c++) {
        body = claims[c]
        n = split(ids_of(body), a, " ")
        if (n) {                                       # id-carrying claim
          for (j = 1; j <= n; j++) {
            id = a[j]
            if (!(id in idcount)) { printf "DANGLING %s in: %s\n", id, body; dangling++ }
            else if (index(body, idslug[id]) == 0) {
              printf "HEALED   %s claim slug drifted from task %s in: %s\n", id, idslug[id], body; healed++
            }
          }
          continue
        }
        # slugless-id claim: try the lead segment and the first token after the who-colon
        rest = body; sub(/^\[[a-z]+\] /, "", rest)
        c1 = lead(rest); sub(/^ +/, "", c1); sub(/ +$/, "", c1)
        c2 = ""; p = index(rest, ":")
        if (p) { c2 = substr(rest, p + 1); sub(/^ +/, "", c2); sub(/ .*/, "", c2); sub(/:$/, "", c2) }
        if ((c1 != "" && c1 in taskslug) || (c2 != "" && c2 in taskslug)) continue   # linked by slug
        if (!slugish(c1) && !slugish(c2)) continue                                   # prose, not a link
        if (cmark[c] == "taking") { printf "BROKEN   no [task] slug, no id in: %s\n", body; broken++ }
        else unlinked++                       # a [done] with no [task] is legal self-initiated work
      }
      printf "check: %d [task] (%d id-tracked) · refiled %d · healed %d · broken %d · dangling %d · unlinked-done %d\n", \
        ntask, nid, refiled, healed, broken, dangling, unlinked
      exit (broken + dangling > 0) ? 1 : 0
    }
  ' "$LOG"
}

selftest(){
  local t rc out; t="$(mktemp -d)" || exit 1
  # expand $t NOW — a local is gone by the time EXIT fires (set -u would trip on it)
  trap "rm -rf '$t'" EXIT
  export MESH_DIR="$t"; LOG="$MESH_DIR/chat.log"
  # mint: shape + uniqueness
  out="$("$0" mint)"; case "$out" in \{#????????\}) : ;; *) echo "smoke-test: FAIL (mint shape: $out)"; exit 1 ;; esac
  [ "$out" != "$("$0" mint)" ] || { echo "smoke-test: FAIL (two mints identical)"; exit 1; }
  # honest n/a before a board exists
  MESH_DIR="$t/none" "$0" resolve deadbeef >/dev/null 2>&1; rc=$?
  [ "$rc" = 2 ] || { echo "smoke-test: FAIL (no-board rc=$rc, want 2)"; exit 1; }
  # fixture: task filed → claimed → RE-FILED under a new slug (id carried) → done cites OLD slug + id;
  # plus one id-less done whose slug matches nothing (the unhealable pre-id class)
  cat > "$LOG" <<'EOF'
2026-07-22T00:00:01Z  chat@test  ::  [task] tool-a/fix-foo: foo path broken {#deadbeef} owner: tool-a/genome
2026-07-22T00:00:02Z  minds@test  ::  [taking] genome: tool-a/fix-foo {#deadbeef}
2026-07-22T00:00:03Z  chat@test  ::  [task] tool-a/fix-foo-and-bar: broadened — bar too {#deadbeef} owner: tool-a/genome
2026-07-22T00:00:04Z  genome@test  ::  [done] tool-a/fix-foo: fixed both, see commit {#deadbeef}
2026-07-22T00:00:05Z  minds@test  ::  [taking] health: tool-b/mystery-slug — no such task was ever filed
2026-07-22T00:00:06Z  genome@test  ::  [done] self-started/side-quest: legal untasked work, stat not verdict
EOF
  # resolve follows the re-file: newest [task] incarnation, not the original nor a claim line
  out="$(MESH_DIR="$t" "$0" resolve '{#deadbeef}')" || { echo "smoke-test: FAIL (resolve rc)"; exit 1; }
  case "$out" in *'[task] tool-a/fix-foo-and-bar:'*) : ;; *) echo "smoke-test: FAIL (resolve not newest incarnation: $out)"; exit 1 ;; esac
  MESH_DIR="$t" "$0" resolve cafecafe >/dev/null 2>&1 && { echo "smoke-test: FAIL (unknown id resolved)"; exit 1; }
  # trace: full lineage, chronological
  out="$(MESH_DIR="$t" "$0" trace deadbeef)"
  [ "$(printf '%s\n' "$out" | wc -l)" = 4 ] || { echo "smoke-test: FAIL (trace count)"; exit 1; }
  case "$(printf '%s\n' "$out" | head -1)" in *00:00:01Z*) : ;; *) echo "smoke-test: FAIL (trace order)"; exit 1 ;; esac
  # check: re-file followed, drifted claims healed by id, slug-only orphan flagged BROKEN → rc 1
  out="$(MESH_DIR="$t" "$0" check)"; rc=$?
  [ "$rc" = 1 ] || { echo "smoke-test: FAIL (check rc=$rc, want 1 on BROKEN)"; exit 1; }
  case "$out" in *'REFILED  {#deadbeef} x2 current: tool-a/fix-foo-and-bar'*) : ;; *) echo "smoke-test: FAIL (no REFILED): $out"; exit 1 ;; esac
  case "$out" in *'HEALED'*'{#deadbeef}'*) : ;; *) echo "smoke-test: FAIL (no HEALED): $out"; exit 1 ;; esac
  case "$out" in *'BROKEN'*'tool-b/mystery-slug'*) : ;; *) echo "smoke-test: FAIL (no BROKEN): $out"; exit 1 ;; esac
  case "$out" in *'unlinked-done 1'*) : ;; *) echo "smoke-test: FAIL (untasked [done] not a count-only stat): $out"; exit 1 ;; esac
  case "$out" in *'BROKEN'*'side-quest'*) echo "smoke-test: FAIL (legal untasked [done] got a BROKEN verdict)"; exit 1 ;; esac
  # drop the orphan line → board fully linked → rc 0
  grep -vF 'tool-b/mystery-slug' "$LOG" > "$LOG.n" && mv "$LOG.n" "$LOG"
  MESH_DIR="$t" "$0" check >/dev/null; rc=$?
  [ "$rc" = 0 ] || { echo "smoke-test: FAIL (clean-board check rc=$rc)"; exit 1; }
  echo "smoke-test: ok (mint/resolve-follows-refile/trace/check heal+broken verdicts)"
}

case "$1" in
  --test) selftest ;;
  mint) mint ;;
  resolve) [ -n "${2:-}" ] || { usage; exit 1; }; resolve "$2" ;;
  trace)   [ -n "${2:-}" ] || { usage; exit 1; }; trace "$2" ;;
  check) check ;;
  *) usage; exit 1 ;;
esac
