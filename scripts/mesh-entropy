#!/usr/bin/env bash
# orphan-ok: on-demand entropy-poll — kernel entropy pool sampled on demand (the pool refills
#   from hardware RNG on every read; this is a *sampled* measurement, not a continuous sense).
# mesh-entropy — the kernel's CRYPTO-READINESS sense: how much entropy is available for
# /dev/random (and by extension TLS handshakes, SSH key generation, GPG ops).
#
# The Linux kernel maintains a 256-bit (on this kernel) entropy pool from hardware RNG
# (RDRRAND/RDSEED on Intel, hardware jitter on Raspberry Pi, etc.). It refills passively
# from hardware events and actively when userspace reads /dev/urandom. When the pool
# DEPLETES (entropy_avail = 0), any process blocking on /dev/random STALLS — SSH handshakes
# hang, GPG operations freeze, TLS re-handshakes delay. This is rare on modern hardware
# (Intel's RDRAND refills ~1 bit per microsecond), but on virtual machines, containers
# without passthrough, or under heavy crypto load, the pool CAN drop to single digits.
#
# This is a NEW sense, distinct from existing security signals:
#   mesh-selfcare   → connectivity health (inet/TG/mesh) — does the network reach?
#   mesh-egress-health → can packets leave (geo-blocked?)
#   mesh-vpn-health → is the VPN tunnel alive?
#   mesh-entropy     → is the kernel's crypto pool full enough to be READY?
#
# Classification (FALSIFIABLE via --test, bands based on pool percentage):
#   FULL      entropy_avail == poolsize (100% — the pool is at max, no crypto operation will block)
#   GOOD      >= 50% of poolsize (crypto operations are unblocked; this is the normal case)
#   LOW       >= 20% of poolsize (degraded but functional; heavy /dev/random consumers will slow)
#   CRITICAL  < 20% of poolsize (kernel can stall on /dev/random; crypto may block)
#   UNKNOWN   /proc unreadable (defensive; honest-degraded — never a faked "FULL")
#
# Honest-exit contract:
#   0 = verdict produced (FULL/GOOD/LOW/CRITICAL)
#   2 = /proc/sys/kernel/random/entropy_avail missing or unreadable — never a fabricated pool size
#
#   mesh-entropy              one read → one classified line
#   mesh-entropy --json       {label, avail, poolsize, percent, ts}
#   mesh-entropy --test       classify fixtures (offline) + /proc probe (real-read gate)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
STATE="$HOME/.mesh/.entropy-state"

# classify_entropy <avail> <poolsize> → echoes "LABEL|reason". Pure, offline-testable.
# Bands are FALSIFIABLE: change the 50% / 20% thresholds and the test cases flip.
classify_entropy() {
  local avail="$1" pool="$2"
  # Defensive: non-numeric or zero pool → UNKNOWN (we can't compute a percentage)
  if [ -z "$avail" ] || [ -z "$pool" ] || [ "$pool" -le 0 ] 2>/dev/null; then
    echo "UNKNOWN|avail=$avail poolsize=$pool (can't compute ratio)"
    return
  fi
  # Integer percent (avail * 100 / pool, floored). Bash arithmetic is integer.
  local pct=$(( avail * 100 / pool ))
  if   [ "$avail" -ge "$pool" ];       then echo "FULL|avail=$avail poolsize=$pool (${pct}%)"
  elif [ "$pct" -ge 50 ];              then echo "GOOD|avail=$avail poolsize=$pool (${pct}%)"
  elif [ "$pct" -ge 20 ];              then echo "LOW|avail=$avail poolsize=$pool (${pct}%)"
  else                                     echo "CRITICAL|avail=$avail poolsize=$pool (${pct}%)"
  fi
}

if [ "${1:-}" = --test ]; then
  fail=0
  # FULL: avail == poolsize
  r="$(classify_entropy 256 256)"
  [ "$r" = "FULL|avail=256 poolsize=256 (100%)" ] || { echo "  FAIL: 256/256 should FULL got=$r"; fail=1; }
  # FULL: 1000/1000
  r="$(classify_entropy 1000 1000)"
  [ "$r" = "FULL|avail=1000 poolsize=1000 (100%)" ] || { echo "  FAIL: 1000/1000 should FULL got=$r"; fail=1; }
  # GOOD boundary: exactly 50%
  r="$(classify_entropy 128 256)"
  [ "$r" = "GOOD|avail=128 poolsize=256 (50%)" ] || { echo "  FAIL: 128/256 (50%) should GOOD got=$r"; fail=1; }
  # GOOD: well above 50%
  r="$(classify_entropy 200 256)"
  [ "$r" = "GOOD|avail=200 poolsize=256 (78%)" ] || { echo "  FAIL: 200/256 (78%) should GOOD got=$r"; fail=1; }
  # LOW boundary: 52/256 = 20% (integer math) — at or above the 20% threshold
  r="$(classify_entropy 52 256)"
  [ "$r" = "LOW|avail=52 poolsize=256 (20%)" ] || { echo "  FAIL: 52/256 (20%) should LOW got=$r"; fail=1; }
  # Just below LOW threshold: 51/256 = 19% (integer math) → CRITICAL
  r="$(classify_entropy 51 256)"
  [ "$r" = "CRITICAL|avail=51 poolsize=256 (19%)" ] || { echo "  FAIL: 51/256 (19%) should CRITICAL got=$r"; fail=1; }
  # LOW: above 20% but below 50%
  r="$(classify_entropy 100 256)"
  [ "$r" = "LOW|avail=100 poolsize=256 (39%)" ] || { echo "  FAIL: 100/256 (39%) should LOW got=$r"; fail=1; }
  # CRITICAL: below 20%
  r="$(classify_entropy 30 256)"
  [ "$r" = "CRITICAL|avail=30 poolsize=256 (11%)" ] || { echo "  FAIL: 30/256 (11%) should CRITICAL got=$r"; fail=1; }
  # CRITICAL: very low
  r="$(classify_entropy 5 256)"
  [ "$r" = "CRITICAL|avail=5 poolsize=256 (1%)" ] || { echo "  FAIL: 5/256 (1%) should CRITICAL got=$r"; fail=1; }
  # CRITICAL: zero (kernel can stall on /dev/random)
  r="$(classify_entropy 0 256)"
  [ "$r" = "CRITICAL|avail=0 poolsize=256 (0%)" ] || { echo "  FAIL: 0/256 should CRITICAL got=$r"; fail=1; }
  # UNKNOWN: missing values
  r="$(classify_entropy '' '')"
  echo "$r" | grep -q '^UNKNOWN' || { echo "  FAIL: empty should UNKNOWN got=$r"; fail=1; }
  # UNKNOWN: zero poolsize (defensive)
  r="$(classify_entropy 0 0)"
  echo "$r" | grep -q '^UNKNOWN' || { echo "  FAIL: 0/0 should UNKNOWN got=$r"; fail=1; }
  [ "$fail" = 1 ] && { echo "smoke-test: FAIL"; exit 1; }
  echo "  ok: classify (11 cases: FULL×2, GOOD×2, LOW×2, CRITICAL×3, UNKNOWN×2)"
  # REAL-READ gate: reachability ≠ producing. The /proc file must exist AND be readable
  # or the sense is hollow (green test with no real artifact).
  _proc="/proc/sys/kernel/random/entropy_avail"
  [ -r "$_proc" ] || { echo "smoke-test: n/a (no /proc/sys/kernel/random/entropy_avail — kernel not Linux or procfs missing); classify-logic ok"; exit 2; }
  _avail="$(head -1 "$_proc" 2>/dev/null | tr -d ' ')"
  [ -n "$_avail" ] && [ "$_avail" -ge 0 ] 2>/dev/null || { echo "smoke-test: n/a (entropy_avail unreadable); classify-logic ok"; exit 2; }
  echo "smoke-test: ok (classify: 11 cases + REAL entropy read avail=$_avail)"
  exit 0
fi

# --- Live read path ---
_proc="/proc/sys/kernel/random/entropy_avail"
[ -r "$_proc" ] || {
  printf 'UNREACHABLE %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$STATE"
  mesh-state-touch "$STATE"
  echo "mesh-entropy: $?proc not readable (kernel not Linux? procfs missing?) — not an alarm" >&2
  exit 2
}
_pool="/proc/sys/kernel/random/poolsize"
avail="$(head -1 "$_proc" 2>/dev/null | tr -d ' ')"
pool="$(head -1 "$_pool" 2>/dev/null | tr -d ' ')"
# Defensive: a parse failure on either → exit 2
[ -n "$avail" ] && [ -n "$pool" ] && [ "$avail" -ge 0 ] 2>/dev/null && [ "$pool" -gt 0 ] 2>/dev/null || {
  printf 'UNREACHABLE %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$STATE"
  mesh-state-touch "$STATE"
  echo "mesh-entropy: parse failed (avail='$avail' pool='$pool') — not an alarm" >&2
  exit 2
}

TS=$(date -u +%Y-%m-%dT%H:%M:%SZ)
result="$(classify_entropy "$avail" "$pool")"
label="${result%%|*}"
reason="${result#*|}"

# Write state + touch liveness on EVERY successful run (mtime = ran-live, content = value-changed)
printf '%s|%s\n' "$label" "$reason" > "$STATE"
mesh-state-touch "$STATE"

# --- Output ---
if [ "${1:-}" = --json ]; then
  printf '{"label":"%s","reason":"%s","avail":%d,"poolsize":%d,"percent":%d,"ts":"%s"}\n' \
    "$label" "$reason" "$avail" "$pool" "$(( avail * 100 / pool ))" "$TS"
  exit 0
fi
printf '[entropy-%s] %s — %s\n' "$(printf '%s' "$label" | tr '[:upper:]' '[:lower:]')" "$label" "$reason"
