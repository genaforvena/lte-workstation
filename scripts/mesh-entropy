#!/usr/bin/env bash
# reflex-cadence: */5 * * * *
# reflex-args: --edge
# doctor-artifact: $HOME/.mesh/.entropy.state 900 sys
# mesh-entropy — live kernel entropy-pool availability.
#
# This is a real /proc read, not a cached classifier.  Missing or malformed procfs is UNKNOWN.
set -u

STATE="${MESH_ENTROPY_STATE:-${HOME:-/root}/.mesh/.entropy.state}"
ENTROPY_FILE="${MESH_ENTROPY_FILE:-/proc/sys/kernel/random/entropy_avail}"
LOW="${MESH_ENTROPY_LOW:-256}"

read_entropy() {
  local v
  local file="${MESH_ENTROPY_FILE:-$ENTROPY_FILE}"
  [ -r "$file" ] || return 2
  v="$(cat "$file" 2>/dev/null)" || return 2
  case "$v" in ''|*[!0-9]*) return 2 ;; esac
  printf '%s\n' "$v"
}

classify() {
  [ "$1" -lt "$LOW" ] && echo LOW || echo READY
}

if [ "${1:-}" = --test ]; then
  td="$(mktemp -d)" || exit 1
  trap 'rm -rf "$td"' EXIT
  printf '4096\n' >"$td/entropy"
  [ "$(MESH_ENTROPY_FILE="$td/entropy" read_entropy)" = 4096 ] || { echo 'smoke-test: FAIL (fixture read)'; exit 1; }
  [ "$(classify 100)" = LOW ] || { echo 'smoke-test: FAIL (LOW band)'; exit 1; }
  [ "$(classify 4096)" = READY ] || { echo 'smoke-test: FAIL (READY band)'; exit 1; }
  MESH_ENTROPY_FILE="$td/missing" read_entropy >/dev/null 2>&1 && { echo 'smoke-test: FAIL (missing procfs read succeeded)'; exit 1; }
  live="$(read_entropy)" || { echo 'smoke-test: n/a (entropy procfs unavailable)'; exit 2; }
  echo "smoke-test: ok (fixture classifier + REAL entropy read: $live)"
  exit 0
fi

value="$(read_entropy)" || { echo "mesh-entropy: UNKNOWN — cannot read $ENTROPY_FILE" >&2; exit 2; }
verdict="$(classify "$value")"
mkdir -p "$(dirname "$STATE")" 2>/dev/null || exit 1
printf '%s|entropy_avail=%s|ts=%s\n' "$verdict" "$value" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >"$STATE" || exit 1
mesh-state-touch "$STATE" >/dev/null 2>&1 || { echo 'mesh-entropy: UNKNOWN — could not stamp live state' >&2; exit 1; }
if [ "${1:-}" = --edge ]; then
  old="$(sed -n '1s/|.*//p' "$STATE.prev" 2>/dev/null || true)"
  cp "$STATE" "$STATE.prev" 2>/dev/null || true
  [ "$old" = "$verdict" ] && exit 0
fi
printf '[entropy] %s — entropy_avail=%s\n' "$verdict" "$value"
