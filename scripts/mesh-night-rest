#!/usr/bin/env bash
# mesh-night-rest — undisturbed-rest fusion: household + body-motion + light + audio-path + ambient.
# A joint pattern no single axis gives: SETTLED only when every live input is calm at once.
# An UNREACHABLE input renders UNKNOWN (naming the blind axis), never a silent all-clear —
# a missing organ must not wear the calm verdict.
# orphan-ok: on-demand fusion read for minds (no cadence, stateless, no STATE file to gate)
set -u
BIN="${HOME}/.local/bin"

usage() { echo "usage: mesh-night-rest [--test]"; }

# _word <tool-output>: classify one axis as calm|active|unreachable (pure-ish, testable)
classify_household() {  # $1 = raw line
    case "$1" in
        *ASLEEP*|*QUIET_NIGHT*) echo calm ;;
        *UNREACHABLE*|*UNKNOWN*|"") echo unreachable ;;
        *) echo active ;;
    esac
}
classify_motion() {  # $1 = raw line
    case "$1" in
        *still*|*STILL*) echo calm ;;
        *unreachable*|*UNREACHABLE*|*incomplete*|*missing*|*classification*|*n/a*|"") echo unreachable ;;
        *) echo active ;;
    esac
}
classify_light() {  # $1 = raw line
    case "$1" in
        *DARK*|*DIM*) echo calm ;;
        *UNREACHABLE*|*UNKNOWN*|"") echo unreachable ;;
        *) echo active ;;
    esac
}
classify_audio() {  # $1 = raw line
    case "$1" in
        *IDLE*) echo calm ;;
        *UNREACHABLE*|*UNKNOWN*|"") echo unreachable ;;
        *) echo active ;;
    esac
}
classify_ambient() {  # $1 = raw line
    case "$1" in
        *QUIET*|*LOW*) echo calm ;;
        *UNREACHABLE*|*UNKNOWN*|"") echo unreachable ;;
        *) echo active ;;
    esac
}

# decide: SETTLED | DISTURBED:<axes> | UNKNOWN:<axes> — unreachable wins over calm, never settles
decide() {  # args: hh motion light audio ambient (each calm|active|unreachable)
    local hh=$1 mo=$2 li=$3 au=$4 am=$5 unk="" act=""
    [ "$hh" = unreachable ] && unk="${unk}household,"
    [ "$mo" = unreachable ] && unk="${unk}body-motion,"
    [ "$li" = unreachable ] && unk="${unk}light,"
    [ "$au" = unreachable ] && unk="${unk}audio-path,"
    [ "$am" = unreachable ] && unk="${unk}ambient,"
    if [ -n "$unk" ]; then echo "UNKNOWN:blind=${unk%,}"; return; fi
    [ "$hh" != calm ] && act="${act}household,"
    [ "$mo" != calm ] && act="${act}body-motion,"
    [ "$li" != calm ] && act="${act}light,"
    [ "$au" != calm ] && act="${act}audio-path,"
    [ "$am" != calm ] && act="${act}ambient,"
    if [ -n "$act" ]; then echo "DISTURBED:active=${act%,}"; return; fi
    echo "SETTLED"
}

run_test() {
    local fail=0 t
    t=$(decide calm calm calm calm calm);            [ "$t" = SETTLED ] || { echo "FAIL all-calm -> $t"; fail=1; }
    t=$(decide calm calm calm calm active);          [ "$t" = "DISTURBED:active=ambient" ] || { echo "FAIL ambient-active -> $t"; fail=1; }
    t=$(decide calm active calm calm calm);          [ "$t" = "DISTURBED:active=body-motion" ] || { echo "FAIL motion-active -> $t"; fail=1; }
    t=$(decide calm unreachable calm calm calm);     [ "$t" = "UNKNOWN:blind=body-motion" ] || { echo "FAIL motion-unreach -> $t"; fail=1; }
    t=$(classify_motion "incomplete sensor read — missing accelerometer, no body-motion classification:"); [ "$t" = unreachable ] || { echo "FAIL incomplete-read -> $t"; fail=1; }
    t=$(decide unreachable unreachable unreachable unreachable unreachable)
    [ "$t" = "UNKNOWN:blind=household,body-motion,light,audio-path,ambient" ] || { echo "FAIL all-blind -> $t"; fail=1; }
    t=$(decide calm active unreachable calm calm);   [ "$t" = "UNKNOWN:blind=light" ] || { echo "FAIL unreach-wins-over-active -> $t"; fail=1; }
    # live leg: real reads right now; verdict word must be present and any blind axis named
    local live; live=$("$0"); echo "live: $live"
    case "$live" in
        "night-rest: SETTLED"*|"night-rest: DISTURBED:active="*|"night-rest: UNKNOWN:blind="*) ;;
        *) echo "FAIL live verdict malformed"; fail=1 ;;
    esac
    # live honesty: a blind body-motion read must be named and must never wear SETTLED
    if [ "$(classify_motion "$("$BIN/mesh-body-motion" 2>&1 | head -1)")" = unreachable ]; then
        case "$live" in *"body-motion"*) ;; *) echo "FAIL blind body-motion not named"; fail=1 ;; esac
        case "$live" in *"SETTLED"*) echo "FAIL blind input wore SETTLED"; fail=1 ;; esac
    fi
    [ $fail -eq 0 ] && echo "mesh-night-rest --test: PASS"
    return $fail
}

if [ "${1:-}" = "--test" ]; then run_test; exit $?; fi
[ -n "${1:-}" ] && { usage; exit 2; }

hh_raw=$("$BIN/mesh-household-state" 2>&1 | head -1)
mo_raw=$("$BIN/mesh-body-motion" 2>&1 | head -1)
li_raw=$("$BIN/mesh-light" 2>&1 | head -1)
au_raw=$("$BIN/mesh-audio-path" 2>&1 | head -1)
am_raw=$("$BIN/mesh-ambient-level" 2>&1 | head -1)

verdict=$(decide "$(classify_household "$hh_raw")" "$(classify_motion "$mo_raw")" \
    "$(classify_light "$li_raw")" "$(classify_audio "$au_raw")" "$(classify_ambient "$am_raw")")
echo "night-rest: $verdict | household='$(echo "$hh_raw" | cut -c1-80)' body='$(echo "$mo_raw" | cut -c1-80)' light='$(echo "$li_raw" | cut -c1-80)' audio='$(echo "$au_raw" | cut -c1-80)' ambient='$(echo "$am_raw" | cut -c1-80)'"
