#!/usr/bin/env bash
# mesh-chat-reflect — the CHAT-SELF-ANALYSIS REFLEX: periodically wake the chat mind to think about
# the CHAT ITSELF (not just reply when asked) and post one [reflect] finding back to the board.
#
# Operator ask (2026-06-15): "the [chat] mind is very important — it should be analyzing chat itself
# once in some time and posting these results back into chat, with a goal of improving mesh internals
# and chat communication." This is the mechanism: a gated reflex that, when the chat mind is IDLE,
# feeds it a focused analysis prompt (recent chat + a noise/coordination digest) and lets the mind
# write ONE concise [reflect] line. Distinct from mesh-reflect (the TELOS/goal reflex) — this one is
# about chat communication quality + mesh internals, not the eternity audit.
#
#   mesh-chat-reflect            reflect now if interval elapsed AND chat mind idle (the cron entry)
#   mesh-chat-reflect --force    skip the interval gate (still requires the chat mind to be idle)
#   mesh-chat-reflect --brief    print the analysis prompt the mind would receive (no feed, $0)
#   mesh-chat-reflect --status   show last-reflect age
#   mesh-chat-reflect --test     smoke test
#
# Env: MESH_CHAT_REFLECT_INTERVAL  seconds between reflections (default 10800 = 3h, "once in some time")
#      MESH_CHAT_WINDOW            the chat mind's tmux window (default: chat)
#      MESH_CHAT_REFLECT_LINES     how many recent chat lines to hand the mind (default 120)
#
# Exit 0: reflection fed (or already fresh / not-due). Exit 1: chat mind not idle (skip). Exit 2: n/a.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
SESS="$(hostname)"
INTERVAL="${MESH_CHAT_REFLECT_INTERVAL:-10800}"   # 3h default
WIN="${MESH_CHAT_WINDOW:-chat}"
LINES="${MESH_CHAT_REFLECT_LINES:-120}"
MESH="$HOME/.mesh"
CHATLOG="$MESH/chat.log"
STATE="$MESH/.chat-reflect-last"
mkdir -p "$MESH"

# --- assemble the analysis brief the mind receives ---------------------------------------------
digest() {
  # Cheap structural read of the recent board so the mind starts from facts, not a cold scan.
  local n="$1" tail_block churn idle subst total
  tail_block="$(tail -n "$n" "$CHATLOG" 2>/dev/null)"
  total="$(printf '%s\n' "$tail_block" | grep -c . || true)"
  churn="$(printf '%s\n' "$tail_block" | grep -cE '\[mind-(paused|limited|blocked|unblocked)\]' || true)"
  idle="$(printf '%s\n' "$tail_block" | grep -cE '\[idle\]|\[room-moved\]' || true)"
  subst=$(( total - churn - idle )); [ "$subst" -lt 0 ] && subst=0
  echo "structural digest of last $total board lines: ~${churn} mind-churn (paused/limited/blocked), ~${idle} idle/room-moved, ~${subst} substantive."
}

brief() {
  cat <<EOF
You are the CHAT mind. This is a periodic SELF-ANALYSIS pass (not a reply to anyone) — analyze the
chat/board ITSELF and post ONE concise improvement finding. Goal: better mesh internals + chat
communication.

$(digest "$LINES")

Recent board (last $LINES lines):
$(tail -n "$LINES" "$CHATLOG" 2>/dev/null)

Do this:
1. Read the board above. Judge SIGNAL vs NOISE — is too much low-value churn drowning real coordination?
2. Spot coordination gaps: tasks dropped without [done], duplicate work, missed handoffs, vague posts,
   a reflex spamming the same line, marker misuse.
3. Pick the SINGLE highest-value, concrete improvement to mesh internals or chat communication.
Then post exactly ONE line to the board:
   MESH_WHO=chat-reflect@$(hostname) mesh-chat "[reflect] <one concrete finding + the one change to make>"
Be specific and actionable (name the tool/reflex/pattern). One line only — do not flood. If the board
is genuinely healthy and lean, say so in one [reflect] line and stop.
EOF
}

# --- modes -------------------------------------------------------------------------------------
case "${1:-}" in
  --test)
    command -v tmux >/dev/null 2>&1 || { echo "smoke-test: FAIL (no tmux)"; exit 1; }
    command -v mesh-mind-state >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-mind-state)"; exit 1; }
    command -v mesh-chat >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-chat)"; exit 1; }
    out="$(MESH="$(mktemp -d)" brief 2>&1)" || { echo "smoke-test: FAIL (brief errored: $out)"; exit 1; }
    # substring tests via [[ ]] — NOT `printf|grep -q`: under `set -o pipefail`, grep -q exits on the
    # first match and SIGPIPEs printf on a large brief → false-nonzero pipeline → spurious FAIL.
    [[ "$out" == *"SELF-ANALYSIS"* ]]    || { echo "smoke-test: FAIL (brief missing header)"; exit 1; }
    [[ "$out" == *"[reflect]"* ]]        || { echo "smoke-test: FAIL (brief missing reflect instruction)"; exit 1; }
    [[ "$out" == *"structural digest"* ]] || { echo "smoke-test: FAIL (brief missing digest)"; exit 1; }
    echo "smoke-test: ok"; exit 0
    ;;
  --brief) brief; exit 0 ;;
  --status)
    now=$(date +%s); last=0; [ -f "$STATE" ] && last=$(cat "$STATE" 2>/dev/null || echo 0)
    age=$(( now - last ))
    if [ "$last" = 0 ]; then echo "chat-reflect: never run (interval ${INTERVAL}s)"
    else echo "chat-reflect: last ${age}s ago ($(date -d "@$last" +%H:%MZ 2>/dev/null || echo '?')), interval ${INTERVAL}s"; fi
    exit 0
    ;;
esac

force=0; [ "${1:-}" = --force ] && force=1

# interval gate (unless forced)
now=$(date +%s); last=0; [ -f "$STATE" ] && last=$(cat "$STATE" 2>/dev/null || echo 0)
age=$(( now - last ))
if [ "$force" = 0 ] && [ "$age" -lt "$INTERVAL" ]; then
  echo "$(date -u +%Y-%m-%dT%H:%MZ) chat-reflect: fresh (${age}s < ${INTERVAL}s) — skip"
  exit 0
fi

# the chat window must exist
tmux list-windows -t "$SESS" -F '#{window_name}' 2>/dev/null | grep -qx "$WIN" || {
  echo "$(date -u +%Y-%m-%dT%H:%MZ) chat-reflect: no '$WIN' window — n/a"; exit 2; }

# only fire when the chat mind is IDLE (never interrupt a live conversation/turn)
state="$(mesh-mind-state "$WIN" 2>/dev/null | head -1 | cut -f1)"
if [ "$state" != "IDLE" ]; then
  echo "$(date -u +%Y-%m-%dT%H:%MZ) chat-reflect: chat mind state=$state — skip (not idle)"; exit 1
fi

# feed the brief to the chat mind via the canonical pane-driver
if mesh-tell "$WIN" "$(brief)" >/dev/null 2>&1; then
  printf '%s' "$now" > "$STATE"
  echo "$(date -u +%Y-%m-%dT%H:%MZ) chat-reflect: fed analysis brief to '$WIN' mind"
  exit 0
else
  echo "$(date -u +%Y-%m-%dT%H:%MZ) chat-reflect: mesh-tell to '$WIN' failed"; exit 1
fi
