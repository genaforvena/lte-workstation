#!/usr/bin/env bash
# mesh-drone — musical ACCOMPANIMENT: a sustained harmonic drone to play against.
# The simplest true accompaniment for a bowed string player — a warm sustained tonic pad that holds
# a pitch so you can train intonation (play scales / double-stops against it) or just have a harmonic
# bed under your line. Pure local numpy synthesis (fundamental + harmonics + a gently detuned chorus
# pair + raised-cosine fades) → a clean seamless WAV, NO cloud. Sibling of mesh-tuner; reuses its
# Bose-sink targeting so --play comes out the Bose like everything else.
#
# Operator 2026-06-20: "какие варианты, что вы сможете меня аккомпанировать" — a drone is option #1.
#
#   mesh-drone <note> [seconds]   synthesize a drone for <note> → write a WAV, print its path. NO audio
#                                 out by default (respects the room's audio-silent gate). <note> = a
#                                 cello open string (C/G/D/A), a pitch name (A2, F#3, Eb3) or a raw Hz.
#   mesh-drone <note> --play [s]  ALSO play it on the Bose, looping until Ctrl-C. OPT-IN only. Honors
#                                 the MUTE_FLAG ($MESH/mesh-speaking) — refuses to play while muted, so
#                                 it never fights mesh-tuner/overhear or violates a silent-room order.
#   mesh-drone --list             list the cello open-string drones (C2 G2 D3 A3) + their frequencies.
#   mesh-drone --test             synthesize a known pitch, FFT-verify its dominant frequency + assert a
#                                 valid non-zero WAV. NO audio out, NO mic — pure synthesis self-check.
#
# Why default-silent: the operator put the room audio under a FULLY-SILENT gate (2026-06-20 01:43) — no
# autonomous Bose output until he re-enables it. So this BUILDS + VERIFIES the drone silently; he triggers
# --play himself when audio is back on. Playback also self-aborts if the MUTE_FLAG is present.
#
# Tunables (env): DRONE_DIR (out dir, default $MESH/drone) · DRONE_SECONDS (default 30) ·
#   DRONE_SR (sample rate, default 44100) · DRONE_GAIN (peak 0..1, default 0.5) ·
#   DRONE_HARMONICS (count incl. fundamental, default 5) · DRONE_DETUNE_CENTS (chorus spread, default 4) ·
#   MUTE_FLAG (presence = muted, default $MESH/mesh-speaking).
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"   # pipewire Bose sink
MESH="${MESH_DIR:-$HOME/.mesh}"
DRONE_DIR="${DRONE_DIR:-$MESH/drone}"
MUTE_FLAG="${MUTE_FLAG:-$MESH/mesh-speaking}"

PY=$(cat <<'PYEOF'
import sys, os, math, wave, struct
import numpy as np

SR       = int(os.environ.get("DRONE_SR", "44100"))
SECONDS  = float(os.environ.get("DRONE_SECONDS", "30"))
GAIN     = float(os.environ.get("DRONE_GAIN", "0.5"))
NHARM    = int(os.environ.get("DRONE_HARMONICS", "5"))
DETUNE   = float(os.environ.get("DRONE_DETUNE_CENTS", "4"))
DRONE_DIR= os.environ.get("DRONE_DIR")

# Cello open strings (the natural drone tonics for the operator's instrument).
CELLO = {"C": 65.406, "G": 97.999, "D": 146.832, "A": 220.000}
NOTES = ["C","C#","D","D#","E","F","F#","G","G#","A","A#","B"]
FLATS = {"DB":"C#","EB":"D#","GB":"F#","AB":"G#","BB":"A#"}

def note_to_freq(s):
    """Accept a raw Hz, a bare cello-string letter (C/G/D/A → that string), or a pitch name like A2/F#3/Eb2."""
    s = s.strip()
    # raw frequency?
    try:
        f = float(s)
        if f > 0: return f, "%.2fHz" % f
    except ValueError:
        pass
    u = s.upper()
    # bare cello-string letter → its open-string octave (unambiguous, instrument-specific)
    if u in CELLO:
        return CELLO[u], {"C":"C2","G":"G2","D":"D3","A":"A3"}[u]
    # pitch name: letter + optional #/b + octave digit
    name = u
    octave = None
    if name and name[-1].isdigit():
        octave = int(name[-1]); name = name[:-1]
    name = FLATS.get(name, name)              # normalize flats to sharps
    if name not in NOTES:
        raise ValueError("unknown note: %s" % s)
    if octave is None:
        # default to the cello register if it's one of the open-string letters, else octave 3
        octave = {"C":2,"G":2,"D":3,"A":3}.get(name, 3)
    midi = 12*(octave+1) + NOTES.index(name)  # MIDI: C-1=0, A4=69
    freq = 440.0 * 2**((midi-69)/12.0)
    return freq, "%s%d" % (name, octave)

def synth(freq):
    n = int(SR*SECONDS)
    t = np.arange(n)/SR
    # fundamental + decaying harmonics → a warm string/organ-ish timbre (not a buzzy pure sine)
    wave_f = np.zeros(n, dtype=np.float64)
    for h in range(1, NHARM+1):
        amp = 1.0/(h**1.4)                    # gentle rolloff: keeps it warm, not harsh
        wave_f += amp*np.sin(2*np.pi*freq*h*t)
    # chorus: a pair detuned by +/- DETUNE cents → slow beating, makes the drone breathe (less sterile)
    if DETUNE > 0:
        for cents in (DETUNE, -DETUNE):
            fr = freq*2**(cents/1200.0)
            wave_f += 0.5*np.sin(2*np.pi*fr*t)
    # normalize then raised-cosine fade in/out so the loop seam + start/stop are click-free
    wave_f /= np.max(np.abs(wave_f)) + 1e-9
    fade = min(int(SR*0.3), n//2)
    if fade > 0:
        env = 0.5*(1-np.cos(np.linspace(0, np.pi, fade)))
        wave_f[:fade]  *= env
        wave_f[-fade:] *= env[::-1]
    return (wave_f*GAIN*32767).astype(np.int16)

def write_wav(path, samples):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with wave.open(path, "wb") as w:
        w.setnchannels(1); w.setsampwidth(2); w.setframerate(SR)
        w.writeframes(samples.tobytes())

def dominant_freq(samples):
    x = samples.astype(np.float64)
    x -= x.mean()
    win = np.hanning(len(x))
    spec = np.abs(np.fft.rfft(x*win))
    freqs = np.fft.rfftfreq(len(x), 1.0/SR)
    return freqs[int(np.argmax(spec))]

def cmd_gen(arg):
    freq, label = note_to_freq(arg)
    samples = synth(freq)
    path = os.path.join(DRONE_DIR, "drone_%s.wav" % label.replace("#","s").replace(".","_"))
    write_wav(path, samples)
    print("%s\t%.2f\t%s" % (label, freq, path))   # label<TAB>freq<TAB>path  (shell parses)
    return 0

def cmd_test():
    # synthesize A3 (cello A string, 220Hz), FFT-verify the dominant partial, assert a valid WAV.
    global SECONDS
    SECONDS = 2.0
    target, label = note_to_freq("A")
    samples = synth(target)
    if samples.dtype != np.int16:           print("smoke-test: FAIL (not int16)"); return 1
    if len(samples) < SR:                   print("smoke-test: FAIL (too few samples)"); return 1
    if int(np.max(np.abs(samples))) == 0:   print("smoke-test: FAIL (silent buffer)"); return 1
    dom = dominant_freq(samples)
    cents = 1200*math.log2(dom/target)
    if abs(cents) > 10:
        print("smoke-test: FAIL (dominant %.2fHz vs target %.2fHz = %.1f cents off)" % (dom, target, cents)); return 1
    # round-trip a real WAV file and re-read it
    import tempfile
    tmp = tempfile.mkdtemp()
    p = os.path.join(tmp, "t.wav"); write_wav(p, samples)
    with wave.open(p, "rb") as w:
        ok = (w.getnchannels()==1 and w.getsampwidth()==2 and w.getframerate()==SR and w.getnframes()==len(samples))
    os.remove(p); os.rmdir(tmp)
    if not ok: print("smoke-test: FAIL (WAV round-trip mismatch)"); return 1
    print("smoke-test: ok (A=%.1fHz drone: dominant %.2fHz = %.1f cents, valid mono/16-bit/%dHz WAV)" % (target, dom, cents, SR))
    return 0

mode = sys.argv[1]
if   mode == "gen":  sys.exit(cmd_gen(sys.argv[2]))
elif mode == "test": sys.exit(cmd_test())
PYEOF
)

list_strings() {
  echo "cello open-string drones (the natural tonics for the operator's instrument):"
  printf '  %-3s %-4s %s\n' C C2 "65.41 Hz"
  printf '  %-3s %-4s %s\n' G G2 "98.00 Hz"
  printf '  %-3s %-4s %s\n' D D3 "146.83 Hz"
  printf '  %-3s %-4s %s\n' A A3 "220.00 Hz"
  echo "usage: mesh-drone <C|G|D|A | A2 | F#3 | 110> [seconds] [--play]"
}

# Bose-sink id (same detection mesh-tuner/overhear use) — empty = default sink.
bose_target() {
  pw-cli ls Node 2>/dev/null | awk '
    /node.name/ { name=tolower($0) }
    /object.id/ && (name ~ /bose/ || name ~ /soundlink/) { gsub(/[^0-9]/,"",$0); print; exit }' 2>/dev/null
}

play_loop() {
  local wav="$1"
  if [ -e "$MUTE_FLAG" ]; then
    echo "mesh-drone: MUTE_FLAG present ($MUTE_FLAG) — refusing to play (room is muted). Remove it to enable." >&2
    return 3
  fi
  local bid; bid="$(bose_target)"
  echo "mesh-drone: playing $wav on the Bose (Ctrl-C to stop)…"
  while :; do
    if [ -n "$bid" ]; then pw-play --target "$bid" "$wav" 2>/dev/null || pw-play "$wav" 2>/dev/null
    else pw-play "$wav" 2>/dev/null || aplay -q "$wav" 2>/dev/null; fi
    [ -e "$MUTE_FLAG" ] && { echo "mesh-drone: MUTE_FLAG appeared — stopping."; break; }
  done
}

case "${1:-}" in
  ""|--help|-h) list_strings ;;
  --list)       list_strings ;;
  --test)       DRONE_DIR="$DRONE_DIR" python3 -c "$PY" test ;;
  *)
    note="$1"; shift
    play=0; secs=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --play) play=1 ;;
        *[0-9]*) secs="$1" ;;
      esac; shift
    done
    [ -n "$secs" ] && export DRONE_SECONDS="$secs"
    out="$(DRONE_DIR="$DRONE_DIR" python3 -c "$PY" gen "$note")" || { echo "mesh-drone: synth failed for '$note'" >&2; exit 1; }
    label="$(printf '%s' "$out" | cut -f1)"; freq="$(printf '%s' "$out" | cut -f2)"; wav="$(printf '%s' "$out" | cut -f3)"
    printf 'drone: %s (%s Hz, %ss) → %s\n' "$label" "$freq" "${DRONE_SECONDS:-30}" "$wav"
    [ "$play" = 1 ] && play_loop "$wav"
    ;;
esac
