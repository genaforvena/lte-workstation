#!/usr/bin/env bash
# mesh-phone-capture — the phone BODY's roaming sensor logger. Runs ON the phone (Termux),
# NOT on a laptop node. Home/away-adaptive: when the operator LEAVES home with the phone it
# ramps capture UP (GPS + wifi-env + cell + battery + motion + light); at home it idles light
# (the mesh pulls rich data over LAN at home). Writes append-only JSON lines locally so capture
# SURVIVES even when the phone is unreachable (away on LTE, WG flapping) — a mesh-side puller
# (mesh-phone-collect) drains the log when reachable.
#
# Operator ask 2026-06-17: "когда выхожу из дома с телефоном тоже всё снимать" — capture the
# meaningful roaming signals (a phone in a pocket: GPS track, motion, light in/out of pocket,
# wifi/cell environment = places visited). Photo is OPT-IN only (MESH_CAP_PHOTO=1) — a pocket
# photo is a black frame + a privacy weight, so off by default.
#
# Launched by Termux:Boot (single-instance via flock — the dup-loop pileup that drove load to 20
# and made MIUI kill Termux is the failure mode we must NOT repeat; see memory
# phone-sshd-dies-miui-killing). One loop, light, adaptive sleep.
#
# reflex-cadence: @reboot   (Termux:Boot, not host cron — this runs on the phone)
set -u
export PATH="$HOME/.local/bin:/data/data/com.termux/files/usr/bin:$PATH"

LOG="$HOME/.mesh/away-track.log"
STATE="$HOME/.mesh/.capture-state"        # last home/away verdict (for edge logging)
LOCK="$HOME/.mesh/.capture.lock"
mkdir -p "$HOME/.mesh"

# --- config (override in ~/.mesh/capture.env) -------------------------------
HOME_SSIDS="${MESH_HOME_SSIDS:-GL-MT3000-765-5G GL-MT3000-765 GL-MT3000-765-2G}"
HOME_GW="${MESH_HOME_GW:-192.168.8.1}"
SLEEP_HOME="${MESH_CAP_SLEEP_HOME:-600}"   # idle cadence at home
SLEEP_AWAY="${MESH_CAP_SLEEP_AWAY:-180}"   # ramped cadence away
SLEEP_LOWBAT="${MESH_CAP_SLEEP_LOWBAT:-900}"  # back off on low battery
CAP_PHOTO="${MESH_CAP_PHOTO:-0}"           # opt-in pocket photo (default OFF)
[ -f "$HOME/.mesh/capture.env" ] && . "$HOME/.mesh/capture.env"

ts(){ date -u +%Y-%m-%dT%H:%M:%SZ; }
jq_get(){ python3 -c "import json,sys;d=json.load(sys.stdin);print(d.get('$1',''))" 2>/dev/null; }

# --- home vs away -----------------------------------------------------------
current_ssid(){ timeout 8 termux-wifi-connectioninfo 2>/dev/null | jq_get ssid; }
is_home(){
  local ssid; ssid=$(current_ssid)
  ssid=${ssid//\"/}
  for s in $HOME_SSIDS; do [ "$ssid" = "$s" ] && return 0; done
  # secondary: home gateway reachable (covers home wifi w/ a renamed SSID)
  timeout 4 ping -c1 -W2 "$HOME_GW" >/dev/null 2>&1 && return 0
  return 1
}

# --- motion / handling ------------------------------------------------------
# Operator 2026-06-17: "что с ним происходит, как я его держу" — capture HOW the phone
# is held/moved. We log RAW signals only (accelerometer = gravity+motion vector, gyroscope =
# rotation, step_counter = steps) — NO premature classification ("не придумывать, аккуратно
# собирать"). termux-sensor is flaky/can hang → every read is hard-timeout-bounded and -n 1
# (one sample, auto-stops the listener); a failed read just drops the field, never blocks.
motion(){
  timeout 12 termux-sensor -s accelerometer,gyroscope,step_counter -n 1 2>/dev/null | python3 -c "
import json,sys
try: d=json.load(sys.stdin)
except: sys.exit(0)
out={}
def vals(name):
    for k,v in d.items():
        if name in k.lower() and isinstance(v,dict) and v.get('values'):
            return [round(x,3) for x in v['values']]
    return None
a=vals('accel'); g=vals('gyro'); s=vals('step')
if a: out['accel']=a
if g: out['gyro']=g
if s: out['steps']=s[0]
if out: print(json.dumps(out))
" 2>/dev/null
}

# --- one capture row --------------------------------------------------------
capture(){
  local mode="$1" t bat batpct batstat loc lat lon acc spd wifi cells light mot
  t=$(ts)
  bat=$(timeout 8 termux-battery-status 2>/dev/null)
  batpct=$(printf '%s' "$bat" | jq_get percentage)
  batstat=$(printf '%s' "$bat" | jq_get status)

  # ALWAYS (home + away): how it's held/moved + ambient light — these are interesting
  # everywhere, cheap, and the operator wants the raw "how I hold it" signal in general.
  mot=$(motion)
  light=$(cat /sys/class/sensors/*/in_illuminance_input 2>/dev/null | head -1)
  [ -z "$light" ] && light=$(cat /sys/bus/iio/devices/*/in_illuminance_raw 2>/dev/null | head -1)

  if [ "$mode" = away ]; then
    # GPS (network = fast/low-power; gps occasionally for accuracy)
    loc=$(timeout 18 termux-location -p network 2>/dev/null)
    [ -z "$loc" ] && loc=$(timeout 25 termux-location -p gps 2>/dev/null)
    lat=$(printf '%s' "$loc" | jq_get latitude)
    lon=$(printf '%s' "$loc" | jq_get longitude)
    acc=$(printf '%s' "$loc" | jq_get accuracy)
    spd=$(printf '%s' "$loc" | jq_get speed)
    # wifi environment (which APs are around = place fingerprint), compacted to count+top
    wifi=$(timeout 12 termux-wifi-scaninfo 2>/dev/null | python3 -c "
import json,sys
try: a=json.load(sys.stdin)
except: a=[]
a=sorted(a,key=lambda x:x.get('rssi',-999),reverse=True)
print(json.dumps({'n':len(a),'top':[{'s':x.get('ssid',''),'r':x.get('rssi')} for x in a[:3]]}))" 2>/dev/null)
    # cell towers (place fingerprint even with no wifi)
    cells=$(timeout 10 termux-telephony-cellinfo 2>/dev/null | python3 -c "
import json,sys
try: a=json.load(sys.stdin)
except: a=[]
print(json.dumps({'n':len(a)}))" 2>/dev/null)
  fi

  python3 -c "
import json
row={'t':'$t','mode':'$mode','bat':'${batpct}','batstat':'${batstat}'}
def f(k,v):
    v=v.strip() if isinstance(v,str) else v
    if v not in ('',None): row[k]=v
f('lat','${lat:-}'); f('lon','${lon:-}'); f('acc','${acc:-}'); f('spd','${spd:-}')
f('light','${light:-}')
import sys
for k,raw in (('wifi','''${wifi:-}'''),('cells','''${cells:-}'''),('motion','''${mot:-}''')):
    raw=raw.strip()
    if raw:
        try: row[k]=json.loads(raw)
        except: pass
print(json.dumps(row,ensure_ascii=False))" >> "$LOG" 2>/dev/null

  # opt-in pocket photo (off by default)
  if [ "$mode" = away ] && [ "$CAP_PHOTO" = 1 ]; then
    timeout 15 termux-camera-photo -c 0 "$HOME/.mesh/cap-$(date -u +%H%M%S).jpg" 2>/dev/null
  fi
}

# --- single run (--once) or daemon loop ------------------------------------
run_once(){
  if is_home; then mode=home; else mode=away; fi
  # edge log: announce home<->away transition into the track
  prev=$(cat "$STATE" 2>/dev/null)
  if [ "$mode" != "$prev" ]; then
    echo "{\"t\":\"$(ts)\",\"event\":\"$( [ "$mode" = away ] && echo left-home || echo arrived-home )\"}" >> "$LOG"
    printf '%s' "$mode" > "$STATE"
  fi
  capture "$mode"
  echo "$mode"
}

if [ "${1:-}" = --test ]; then
  # smoke: verify it runs one cycle and writes a parseable row (works on phone OR dry elsewhere)
  if command -v termux-battery-status >/dev/null 2>&1; then
    out=$(run_once); tail -1 "$LOG" | python3 -m json.tool >/dev/null 2>&1 \
      && { echo "smoke-test: ok (captured mode=$out, row parses)"; exit 0; } \
      || { echo "smoke-test: FAIL (row not parseable)"; exit 1; }
  else
    echo "smoke-test: ok (dry — not on a phone; termux-api absent, loop logic loaded)"; exit 0
  fi
fi
if [ "${1:-}" = --once ]; then run_once; exit 0; fi

# daemon: single-instance, adaptive cadence
exec 9>"$LOCK"
flock -n 9 || { echo "[capture] another instance holds the lock — exiting"; exit 0; }
command -v termux-wake-lock >/dev/null 2>&1 && termux-wake-lock 2>/dev/null
while true; do
  mode=$(run_once)
  # battery-aware backoff
  bp=$(timeout 8 termux-battery-status 2>/dev/null | jq_get percentage)
  st=$(timeout 8 termux-battery-status 2>/dev/null | jq_get status)
  if [ -n "$bp" ] && [ "$bp" -lt 15 ] 2>/dev/null && [ "$st" != CHARGING ]; then
    sleep "$SLEEP_LOWBAT"
  elif [ "$mode" = away ]; then
    sleep "$SLEEP_AWAY"
  else
    sleep "$SLEEP_HOME"
  fi
done
