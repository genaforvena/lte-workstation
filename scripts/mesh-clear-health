#!/usr/bin/env bash
# mesh-clear-health — recurring, non-destructive liveness check for the context-clear loop.
# reflex-cadence: */5 * * * *
# reflex-artifact: $HOME/.mesh/clear-health.state 900
# The clear operation is demand-driven, so absence of a recent clear is not failure. This reflex
# exercises mesh-clear's real flow in its isolated --test fixture and verifies the live reactor wiring;
# its state file is the durable heartbeat consumed by mesh-reflex-health.
set -u

MESH_DIR="${MESH_DIR:-$HOME/.mesh}"
STATE="${MESH_CLEAR_HEALTH_STATE:-$MESH_DIR/clear-health.state}"
CLEAR_CMD="${MESH_CLEAR_CMD:-$HOME/.local/bin/mesh-clear}"
REACTOR_STATE="${MESH_REACTOR_STATE:-$MESH_DIR/handoff-reactor.json}"
CRONTAB_CMD="${MESH_CRONTAB_CMD:-crontab}"
PGREP_CMD="${MESH_PGREP_CMD:-pgrep}"
MAX_REACTOR_AGE="${MESH_CLEAR_HEALTH_MAX_REACTOR_AGE:-900}"

mkdir -p "$(dirname "$STATE")" 2>/dev/null || true
tmp="${STATE}.tmp.$$"
verdict=OK
details=()

if ! command -v "$CLEAR_CMD" >/dev/null 2>&1; then
  verdict=FAIL; details+=("clear-command-missing")
else
  out="$($CLEAR_CMD --test 2>&1)"; rc=$?
  if [ "$rc" -ne 0 ]; then verdict=FAIL; details+=("clear-test rc=$rc"); fi
fi

if [ ! -r "$REACTOR_STATE" ]; then
  verdict=FAIL; details+=("reactor-state-missing")
else
  if ! python3 - "$REACTOR_STATE" <<'PY' >/dev/null 2>&1
import json, sys
value = json.load(open(sys.argv[1]))
assert isinstance(value, dict) and isinstance(value.get("pending", []), list)
PY
  then
    verdict=FAIL; details+=("reactor-state-invalid")
  fi
  reactor_age=$(( $(date +%s) - $(stat -c %Y "$REACTOR_STATE" 2>/dev/null || echo 0) ))
  if [ "$reactor_age" -gt "$MAX_REACTOR_AGE" ]; then
    verdict=FAIL; details+=("reactor-state-stale age=${reactor_age}s")
  fi
fi

cron="$($CRONTAB_CMD -l 2>/dev/null || true)"
if ! printf '%s\n' "$cron" | grep -Eq '(^|[[:space:]/])mesh-handoff-reactor[[:space:]]+--(listen|once)'; then
  verdict=FAIL; details+=("reactor-cron-missing")
fi

if [ "${MESH_CLEAR_HEALTH_REQUIRE_PROCESS:-0}" = 1 ] && ! "$PGREP_CMD" -f 'mesh-handoff-reactor|mesh-fsnotify' >/dev/null 2>&1; then
  verdict=FAIL; details+=("reactor-process-missing")
fi

detail="${details[*]:-clear-test=pass reactor-state=valid reactor-cron=present}"
printf 'ts=%s verdict=%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$verdict" "$detail" >"$tmp" && mv -f "$tmp" "$STATE"
if [ "$verdict" = OK ]; then
  echo "clear-health: OK ($detail)"
  exit 0
fi
echo "clear-health: FAIL ($detail)" >&2
exit 1
