#!/usr/bin/env python3
"""Run a read-only haunt replay in its own mishe site and tmux session."""
import os
from pathlib import Path
import subprocess
import sys

ROOT = Path(__file__).resolve().parent.parent
CORE = Path(os.environ.get("MESH_MISHE_CORE", Path.home() / "mishe-tauftauf"))
SITE = Path(os.environ.get("MESH_HAUNT_MISHE_HOME", Path.home() / ".mesh/mishe-haunt"))
ADAPTER = ROOT / "scripts/haunt/mesh-haunt-mishe"
SESSION = "mishe-haunt-pilot-20260925"


def core(*args):
    env = dict(os.environ, PYTHONPATH=str(CORE / "src"), MESH_HAUNT_MISHE_HOME=str(SITE))
    result = subprocess.run([sys.executable, "-m", "mishe_tauftauf", "--home", str(SITE), *args], env=env)
    if result.returncode:
        raise ValueError(f"mishe core {' '.join(args)} exited {result.returncode}")


def install():
    if not ADAPTER.is_file() or not os.access(ADAPTER, os.X_OK):
        raise ValueError("offline adapter unavailable")
    core("init")
    for folder in ("top-pains", "projectors"):
        target = SITE / folder / "haunt"
        if target.is_symlink() and target.resolve() == ADAPTER:
            continue
        if target.exists() or target.is_symlink():
            raise ValueError(f"refusing to replace existing hook: {target}")
        target.symlink_to(ADAPTER)
    target = SITE / "judge"
    if not (target.is_symlink() and target.resolve() == ADAPTER):
        if target.exists() or target.is_symlink():
            raise ValueError(f"refusing to replace existing judge: {target}")
        target.symlink_to(ADAPTER)


def main():
    if len(sys.argv) != 2 or sys.argv[1] not in ("init", "start", "once", "verify", "stop"):
        raise ValueError("usage: mesh-mishe-haunt-run init|start|once|verify|stop")
    mode = sys.argv[1]
    if mode == "init":
        install()
    elif mode == "start":
        install()
        core("tmux", "start", "--session", SESSION)
    elif mode == "stop":
        core("tmux", "stop", "--session", SESSION)
    elif mode == "verify":
        subprocess.run([str(ADAPTER), "verify"], check=True)
    else:
        install()
        subprocess.run([str(ADAPTER), "replay"], check=True)
        core("check", "haunt", "--", str(ADAPTER), "verify")
        subprocess.run([str(ADAPTER), "verify"], check=True)
        core("run", "--once", "--slug", "haunt", "--launcher", "headless", "--observe-only", "--judge", str(SITE / "judge"))


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, subprocess.CalledProcessError) as exc:
        print(f"UNKNOWN haunt pilot runner: {exc}", file=sys.stderr)
        raise SystemExit(2)
