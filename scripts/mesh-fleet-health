#!/usr/bin/env bash
# mesh-fleet-health — fleet-wide health view: one table row per lte-node peer.
#
# For each tag:lte-node peer, resolves best address via mesh-peer-addr, fetches
# its mesh-card over SSH, and prints a compact table: node, reachable, power,
# vitals, upstream, minds, egress-dev. Unreachable peers marked clearly.
#
# Read-only, sudo-free, best-effort. ConnectTimeout 6 — doesn't hang.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"

SSH_OPTS=(-o StrictHostKeyChecking=no -o ConnectTimeout=6 -o BatchMode=yes -o LogLevel=ERROR)
SELF=$(hostname)
ts() { date -u +%Y-%m-%dT%H:%M:%SZ; }
# live=reachable: a Tailscale-offline node still answering on the LAN is LIVE, not OFFLINE
# (operator 2026-06-19). Pull MESH_LAN_FALLBACK ("label:ip ...") + PHONE_LAN_IPS for the fallback.
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes" 2>/dev/null
lan_addrs_for() {  # echo LAN fallback IP(s) for a peer name, newline-separated
  local pn="$1" entry
  for entry in ${MESH_LAN_FALLBACK:-}; do [ "${entry%%:*}" = "$pn" ] && printf '%s\n' "${entry#*:}"; done
  case "$pn" in Redmi|phone) printf '%s\n' ${PHONE_LAN_IPS:-} ;; esac
}

# --- peer name normalization (tailscale hostname → mesh peer name) ------
peer_name() {
  case "$1" in
    imozerov-IdeaPad-3-15IIL05) echo "IdeaPad" ;;
    imozerov-Default-string)    echo "default-string" ;;
    "Redmi 10")                 echo "Redmi" ;;
    GL-MT3000)                  echo "router" ;;
    *)                          echo "$1" ;;
  esac
}

# --- mesh ROLE → MINDS-column display ------------------------------------
# A node's card auto-detects installed mind binaries (claude/opencode/gemini/ollama) into its
# `minds:` line — but INSTALLED ≠ mesh-driven. The authoritative "is this a mesh mind node" lever
# is MESH_ROLES (operator rule: card-capability is overridden by the role; a non-'mind' role is
# HANDS-OFF). mesh-minds already renders such nodes 'off-mesh'; fleet-health did NOT (it dumped the
# card binaries) → the Health window showed Default-string with minds though it is compute-only
# (operator 2026-06-19). Resolve the role from MESH_ROLES and override the MINDS cell to match.
role_of() {  # args: one or more candidate labels/hostnames; echoes role (default 'mind')
  local want tok lbl r
  for want in "$@"; do
    [ -z "$want" ] && continue
    for tok in ${MESH_ROLES:-}; do
      lbl="${tok%%:*}"; r="${tok#*:}"
      [ "$(printf '%s' "$lbl" | tr 'A-Z' 'a-z')" = "$(printf '%s' "$want" | tr 'A-Z' 'a-z')" ] && { printf '%s' "$r"; return 0; }
    done
  done
  printf 'mind'
}
mind_display() {  # $1 = card minds value; $2.. = node names. off-mesh roles render "(off-mesh)".
  local val="$1"; shift
  local role; role="$(role_of "$@")"
  if [ -n "$role" ] && [ "$role" != mind ]; then printf '(off-mesh)'; else printf '%s' "$val"; fi
}

# --- SSH user + port per peer name --------------------------------------
peer_user() {
  # registry first: ~/.mesh/nodes carries label:user@ip — topology lives there, not in code
  if [ -f "$HOME/.mesh/nodes" ]; then
    local entry
    entry=$(. "$HOME/.mesh/nodes" 2>/dev/null
            for n in $MESH_NODES; do [ "${n%%:*}" = "$1" ] && { echo "${n#*:}"; break; }; done)
    case "$entry" in *@*) echo "${entry%%@*}"; return 0 ;; esac
  fi
  case "$1" in
    Redmi|phone) echo "${PHONE_USER:-u0_a380}" ;;
    router|GL-MT3000) echo "root" ;;
    ilya) echo "ilya" ;;
    *) echo "${SSH_USER:-$(whoami)}" ;;
  esac
}
peer_port() {
  case "$1" in
    Redmi|phone) echo "8022" ;;
    *) echo "22" ;;
  esac
}

# --- resolve best address for peer via mesh-peer-addr, fallback to TS IP
resolve_addr() {
  local peer_name="$1" ts_fallback="$2"
  local addr
  if command -v mesh-peer-addr >/dev/null 2>&1; then
    addr=$(mesh-peer-addr "$peer_name" 2>/dev/null) && { echo "$addr"; return 0; }
  fi
  [ -n "$ts_fallback" ] && { echo "$ts_fallback"; return 0; }
  return 1
}

# --- fetch remote card ---------------------------------------------------
fetch_remote() {
  local user="$1" ip="$2" port="$3"
  local opts=("${SSH_OPTS[@]}")
  [ "$port" != 22 ] && opts+=(-p "$port")
  # Use the ABSOLUTE tool path: a non-interactive ssh shell often lacks ~/.local/bin in PATH, so
  # bare `mesh-card` is not-found → empty → a live node (ds) was mislabeled NO-CARD. ~/ expands to
  # the REMOTE home. (genome install path is ~/.local/bin on every node.)
  ssh "${opts[@]}" "${user}@${ip}" '~/.local/bin/mesh-card 2>/dev/null | grep -E "^  (power|vitals|upstream|default-egress|minds):"' 2>/dev/null < /dev/null
}

ssh_reachable() {
  local user="$1" ip="$2" port="$3"
  local opts=("${SSH_OPTS[@]}")
  [ "$port" != 22 ] && opts+=(-p "$port")
  ssh "${opts[@]}" "${user}@${ip}" 'true' 2>/dev/null < /dev/null
}

# --- fetch local card ----------------------------------------------------
fetch_local() {
  mesh-card 2>/dev/null | grep -E "^  (power|vitals|upstream|default-egress|minds):"
}

# --- parse a field from card grep output ---------------------------------
parse_field() {
  local card="$1" label="$2" default="${3:--}" line val
  line=$(echo "$card" | grep "^  ${label}:" | head -1)
  [ -n "$line" ] || { echo "$default"; return; }
  # Strip the "  label: " prefix, a trailing "(clean)" marker, and any inline "# comment".
  # A card field with a BLANK value + an explanatory "# OFF ..." note (e.g. phaedra's decommissioned
  # minds: line) must render as its value (→ the default "-"), not dump the prose into the column and
  # blow out the table. These fields (power/vitals/upstream/minds/egress) never use "#" as data.
  val=$(printf '%s\n' "$line" | sed "s/^  ${label}: *//; s/  *(clean)\$//; s/[[:space:]]*#.*\$//; s/[[:space:]]*\$//")
  [ -n "$val" ] && echo "$val" || echo "$default"
}

# --- one row -------------------------------------------------------------
print_row() {
  local name="$1" reach="$2" power="$3" vitals="$4" upstream="$5" minds="$6" egress="$7"
  printf '%-20s %-10s %-12s %-8s %-8s %-22s %s\n' \
    "$name" "$reach" "$power" "$vitals" "$upstream" "$minds" "$egress"
}

# --- smoke test -----------------------------------------------------------
if [ "${1:-}" = "--test" ]; then
    for d in mesh-peers python3 ssh; do command -v "$d" >/dev/null 2>&1 || { echo "smoke-test: FAIL ($d not found)"; exit 1; }; done
    mesh-peers --test >/dev/null 2>&1 || { echo "smoke-test: FAIL (mesh-peers unavailable)"; exit 1; }
    # Artifact test: fetch_local() must return non-empty card fields (self-scan, no SSH needed).
    # Catches the hollow class: mesh-card broken/absent → empty local row silently (no failure).
    local_card="$(fetch_local 2>/dev/null)"
    [ -n "$local_card" ] || { echo "smoke-test: FAIL (fetch_local empty — mesh-card not returning vitals/power/upstream fields; local fleet row would be blank)"; exit 1; }
    _first="$(printf '%s' "$local_card" | head -1 | sed 's/^  //' | cut -c1-55)"
    echo "smoke-test: ok (local card: $_first)"; exit 0
fi

# --- main -----------------------------------------------------------------
. "$HOME/.mesh/nodes" 2>/dev/null   # MESH_ROLES + MESH_NODES — role-aware MINDS column (off-mesh)
echo "=== mesh-fleet-health $(ts) ==="
echo
print_row "NODE" "REACHABLE" "POWER" "VITALS" "UPSTREAM" "MINDS" "EGRESS-DEV"
print_row "--------------------" "----------" "------------" "--------" "--------" "----------------------" "----------"

# --- self row (local) ---
local_card=$(fetch_local)
power=$(parse_field "$local_card" "power")
vitals_line=$(parse_field "$local_card" "vitals")
vitals=$(echo "$vitals_line" | awk '{print $1}')
upstream=$(parse_field "$local_card" "upstream")
minds=$(parse_field "$local_card" "minds" "(none)")
egress=$(parse_field "$local_card" "default-egress" "?" | sed 's/^dev //' | awk '{print $1}')
print_row "$SELF" "LOCAL" "$power" "$vitals" "$upstream" "$(mind_display "$minds" "$SELF")" "$egress"

# --- remote peers ---
peers_file=$(mktemp)
mesh-peers --json 2>/dev/null | python3 -c "
import json, sys
for peer in json.load(sys.stdin):
    print(f\"{peer['hostname']}|{peer['ip']}|{peer['online']}\")
" > "$peers_file"

while IFS='|' read -r host ts_ip online; do
  [ -z "$host" ] && continue
  pname=$(peer_name "$host")
  [ "$pname" = "IdeaPad" ] && continue   # skip self

  if [ "$online" != "True" ]; then
    # live=reachable: Tailscale-offline ≠ dead. Try the LAN before branding OFFLINE — the router
    # answers ping (its dropbear rejects our key → no card, LAN-ping IS the liveness), phone/others
    # answer SSH. Only unreachable on BOTH tailnet AND LAN is truly OFFLINE. (operator 2026-06-19)
    luser=$(peer_user "$pname"); lport=$(peer_port "$pname"); shown=""
    for laddr in $(lan_addrs_for "$pname"); do
      if lcard=$(fetch_remote "$luser" "$laddr" "$lport"); [ -n "$lcard" ]; then
        print_row "$host" "yes(LAN)" "$(parse_field "$lcard" power)" \
          "$(parse_field "$lcard" vitals | awk '{print $1}')" "$(parse_field "$lcard" upstream)" \
          "$(mind_display "$(parse_field "$lcard" minds "(none)")" "$pname" "$host")" \
          "$(parse_field "$lcard" default-egress "?" | sed 's/^dev //' | awk '{print $1}')"
        shown=1; break
      elif ssh_reachable "$luser" "$laddr" "$lport"; then
        print_row "$host" "LAN-up" "-" "-" "-" "(no-card)" "-"; shown=1; break
      elif ping -c1 -W1 "$laddr" >/dev/null 2>&1; then
        print_row "$host" "LAN-ping" "-" "-" "-" "(no-ssh)" "-"; shown=1; break
      fi
    done
    [ -n "$shown" ] || print_row "$host" "OFFLINE" "-" "-" "-" "-" "-"
    continue
  fi

  addr=$(resolve_addr "$pname" "$ts_ip") || { print_row "$host" "UNREACHABLE" "-" "-" "-" "-" "-"; continue; }
  user=$(peer_user "$pname")
  port=$(peer_port "$pname")

  card=$(fetch_remote "$user" "$addr" "$port") || card=""
  # A reachable LAN address may lack this node's SSH key. Retry the selected
  # active Tailscale record before declaring the peer unreachable.
  if [ -z "$card" ] && [ "$addr" != "$ts_ip" ]; then
    card=$(fetch_remote "$user" "$ts_ip" "$port") || card=""
  fi
  if [ -z "$card" ]; then
    if ssh_reachable "$user" "$ts_ip" "$port"; then
      # cardless but reachable (e.g. the OpenWrt router): probe MINIMAL health (temp/load) so a
      # CRITICAL no-card node — the LAN gateway + VPN egress — isn't a blind spot. A fanless gateway
      # overheating = silent LAN+egress loss; this surfaces it. (capability sweep 2026-06-12.)
      rh_opts=("${SSH_OPTS[@]}"); [ "$port" != 22 ] && rh_opts+=(-p "$port")
      rh=$(ssh "${rh_opts[@]}" "${user}@${ts_ip}" 'echo "$(cat /sys/class/thermal/thermal_zone0/temp 2>/dev/null || echo 0)|$(cut -d" " -f1 /proc/loadavg 2>/dev/null)"' 2>/dev/null </dev/null)
      rtemp="${rh%%|*}"; rload="${rh##*|}"
      if [ "${rtemp:-0}" -gt 0 ] 2>/dev/null; then rvit="$((rtemp/1000))C/ld${rload:-?}"; else rvit="reachable"; fi
      print_row "$host" "NO-CARD" "-" "$rvit" "-" "-" "-"
    else
      print_row "$host" "UNREACHABLE" "-" "-" "-" "-" "-"
    fi
    continue
  fi

  power=$(parse_field "$card" "power")
  vitals=$(echo "$(parse_field "$card" "vitals")" | awk '{print $1}')
  upstream=$(parse_field "$card" "upstream")
  minds=$(parse_field "$card" "minds" "(none)")
  egress=$(parse_field "$card" "default-egress" "?" | sed 's/^dev //' | awk '{print $1}')
  print_row "$host" "yes" "$power" "$vitals" "$upstream" "$(mind_display "$minds" "$pname" "$host")" "$egress"
done < "$peers_file"

# --- LAN / off-Tailscale registry nodes (operator 2026-06-19: a node is reachable by ANY path,
# not just Tailscale — the iMac is LAN-only (mac:ilya@192.168.8.214) and was INVISIBLE in the fleet
# because mesh-peers only lists tag:lte-node peers). Add any MESH_NODES entry with a non-Tailscale
# (non-100.x) ip not already rowed. These are cardless (macOS / appliance): show REACHABLE + minimal
# vitals (load) so they aren't a fleet blind spot. Same fix class as mesh-minds' LAN-node merge. ---
handled_ips=$(awk -F'|' 'NF{print $2}' "$peers_file")
. "$HOME/.mesh/nodes" 2>/dev/null
for n in ${MESH_NODES:-}; do
  label="${n%%:*}"; spec="${n#*:}"
  [ "$spec" = local ] && continue
  ip="${spec#*@}"; [ -z "$ip" ] && continue
  case "$ip" in 100.*) continue ;; esac            # tailscale ips are covered by mesh-peers
  printf '%s\n' "$handled_ips" | grep -qxF "$ip" && continue
  user=$(peer_user "$label"); port=$(peer_port "$label")
  if ssh_reachable "$user" "$ip" "$port"; then
    ropts=("${SSH_OPTS[@]}"); [ "$port" != 22 ] && ropts+=(-p "$port")
    # minimal vitals — load avg, works on linux AND macOS uptime formats
    ld=$(ssh "${ropts[@]}" "${user}@${ip}" 'uptime' 2>/dev/null </dev/null \
         | sed -E 's/.*load average[s]?:[[:space:]]*//' | awk '{print $1}' | tr -d ,)
    print_row "$label" "yes(LAN)" "-" "${ld:+ld$ld}" "-" "(off-mesh)" "-"
  else
    print_row "$label" "UNREACHABLE" "-" "-" "-" "-" "-"
  fi
done
rm -f "$peers_file"
