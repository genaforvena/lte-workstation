#!/usr/bin/env bash
# mesh-fleet-health — fleet-wide health view: one table row per lte-node peer.
#
# For each tag:lte-node peer, resolves best address via mesh-peer-addr, fetches
# its mesh-card over SSH, and prints a compact table: node, reachable, power,
# vitals, upstream, minds, egress-dev. Unreachable peers marked clearly.
#
# Read-only, sudo-free; complete roster with bounded per-peer workers.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"

SSH_OPTS=(-o StrictHostKeyChecking=no -o ConnectTimeout=6 -o BatchMode=yes -o LogLevel=ERROR)
SELF=$(hostname)
ts() { date -u +%Y-%m-%dT%H:%M:%SZ; }
# live=reachable: a Tailscale-offline node still answering on the LAN is LIVE, not OFFLINE
# (operator 2026-06-19). Pull MESH_LAN_FALLBACK ("label:ip ...") + PHONE_LAN_IPS for the fallback.
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes" 2>/dev/null
lan_addrs_for() {  # echo LAN fallback IP(s) for a peer name, newline-separated
  local pn="$1" entry
  for entry in ${MESH_LAN_FALLBACK:-}; do [ "${entry%%:*}" = "$pn" ] && printf '%s\n' "${entry#*:}"; done
  case "$pn" in Redmi|phone) printf '%s\n' ${PHONE_LAN_IPS:-} ;; esac
}

# --- peer name normalization (tailscale hostname → mesh peer name) ------
peer_name() {
  case "$1" in
    imozerov-IdeaPad-3-15IIL05) echo "IdeaPad" ;;
    imozerov-Default-string)    echo "default-string" ;;
    "Redmi 10")                 echo "Redmi" ;;
    GL-MT3000)                  echo "router" ;;
    *)                          echo "$1" ;;
  esac
}

# --- mesh ROLE → MINDS-column display ------------------------------------
# A node's card auto-detects installed mind binaries (claude/opencode/gemini/ollama) into its
# `minds:` line — but INSTALLED ≠ mesh-driven. The authoritative "is this a mesh mind node" lever
# is MESH_ROLES (operator rule: card-capability is overridden by the role; a non-'mind' role is
# HANDS-OFF). mesh-minds already renders such nodes 'off-mesh'; fleet-health did NOT (it dumped the
# card binaries) → the Health window showed Default-string with minds though it is compute-only
# (operator 2026-06-19). Resolve the role from MESH_ROLES and override the MINDS cell to match.
role_of() {  # args: one or more candidate labels/hostnames; echoes role (default 'mind')
  local want tok lbl r
  for want in "$@"; do
    [ -z "$want" ] && continue
    for tok in ${MESH_ROLES:-}; do
      lbl="${tok%%:*}"; r="${tok#*:}"
      [ "$(printf '%s' "$lbl" | tr 'A-Z' 'a-z')" = "$(printf '%s' "$want" | tr 'A-Z' 'a-z')" ] && { printf '%s' "$r"; return 0; }
    done
  done
  printf 'mind'
}
mind_display() {  # $1 = card minds value; $2.. = node names. off-mesh roles render "(off-mesh)".
  local val="$1"; shift
  local role; role="$(role_of "$@")"
  if [ -n "$role" ] && [ "$role" != mind ]; then printf '(off-mesh)'; else printf '%s' "$val"; fi
}

# --- SSH user + port per peer name --------------------------------------
peer_user() {
  # registry first: ~/.mesh/nodes carries label:user@ip — topology lives there, not in code
  if [ -f "$HOME/.mesh/nodes" ]; then
    local entry
    entry=$(. "$HOME/.mesh/nodes" 2>/dev/null
            for n in $MESH_NODES; do [ "${n%%:*}" = "$1" ] && { echo "${n#*:}"; break; }; done)
    case "$entry" in *@*) echo "${entry%%@*}"; return 0 ;; esac
  fi
  case "$1" in
    Redmi|phone) echo "${PHONE_USER:-u0_a380}" ;;
    router|GL-MT3000) echo "root" ;;
    ilya) echo "ilya" ;;
    *) echo "${SSH_USER:-$(whoami)}" ;;
  esac
}
peer_port() {
  case "$1" in
    Redmi|phone) echo "8022" ;;
    *) echo "22" ;;
  esac
}

# --- resolve best address for peer via mesh-peer-addr, fallback to TS IP
resolve_addr() {
  local peer_name="$1" ts_fallback="$2"
  local addr
  if command -v mesh-peer-addr >/dev/null 2>&1; then
    addr=$(mesh-peer-addr "$peer_name" 2>/dev/null) && { echo "$addr"; return 0; }
  fi
  [ -n "$ts_fallback" ] && { echo "$ts_fallback"; return 0; }
  return 1
}

# --- fetch remote card ---------------------------------------------------
# THE RC IS THE WHOLE POINT — do not collapse it into "empty output" (health@ 2026-08-25).
# ssh exits 255 on a connect/transport failure, but returns the REMOTE command's rc when it DID
# connect and the pipeline simply matched nothing. Those are two different facts about two different
# things: 255 is a property of OUR LINK, rc 1 is a property of the PEER. Every caller must keep it.
#
# ConnectTimeout DOES NOT BOUND THE COMMAND. Measured against phaedra on this node: 8 identical
# fetches ran 1.4 1.4 2.3 5.9 76.2 21.8 5.0 and one hard 6.0s — one SEVENTY-SIX SECOND success under
# a 6s connect budget, on a cadence that can overlap its own next run. So the whole ssh gets its own
# wall-clock cap; `timeout` reports 124, which is a link fact and is classified as one. Raising
# ConnectTimeout instead would only HIDE that tail rather than classify it.
FLEET_SSH_CMD_T="${FLEET_SSH_CMD_T:-20}"     # seconds; the COMMAND budget, distinct from ConnectTimeout
fetch_remote() {
  local user="$1" ip="$2" port="$3"
  local opts=("${SSH_OPTS[@]}")
  [ "$port" != 22 ] && opts+=(-p "$port")
  # Use the ABSOLUTE tool path: a non-interactive ssh shell often lacks ~/.local/bin in PATH, so
  # bare `mesh-card` is not-found → empty → a live node (ds) was mislabeled NO-CARD. ~/ expands to
  # the REMOTE home. (genome install path is ~/.local/bin on every node.)
  timeout --foreground -k 1 "$FLEET_SSH_CMD_T" ssh "${opts[@]}" "${user}@${ip}" '~/.local/bin/mesh-card 2>/dev/null | grep -E "^  (power|vitals|upstream|default-egress|minds):"' 2>/dev/null < /dev/null
}

ssh_reachable() {
  local user="$1" ip="$2" port="$3"
  local opts=("${SSH_OPTS[@]}")
  [ "$port" != 22 ] && opts+=(-p "$port")
  timeout --foreground -k 1 "$FLEET_SSH_CMD_T" ssh "${opts[@]}" "${user}@${ip}" 'true' 2>/dev/null < /dev/null
}

# card_absence_label <fetch_rc> -> the honest verdict for "we have no card for this peer, and ssh
# answered a moment ago". Pure, unit-tested — the same shape as access_label/down_label.
#
# NO-CARD is a claim about the PEER (the branch exists for the cardless OpenWrt router, which really
# does answer ssh and really has no mesh-card). "Our fetch came back empty this time" is a claim about
# OUR LINK. Conflating them brands a live node with a FRESH card as cardless: measured 2026-08-25,
# the check pane read `phaedra(NO-CARD vitals=reachable)` at 16:23Z while phaedra's card was 2867 B,
# refreshed 16:21:03Z, two minutes earlier. The CHEAP reachability leg (`ssh true`) passed while the
# EXPENSIVE card leg timed out — that combination IS how a false NO-CARD is manufactured, and no
# load guard can catch it: the starvation gate keys on local load1 vs nproc*0.9 = 14.4 here, and
# load1 was 2.19-6.56 throughout. A degraded LINK bypasses a LOAD guard completely.
#
# 255 = ssh could not complete the session (transport, or a key this peer will not take)
# 124 = our own command budget expired  -> both mean WE COULD NOT ASK -> UNKNOWN(link)
# anything else = the remote shell RAN and produced nothing -> genuinely cardless -> NO-CARD
card_absence_label() {
  case "$1" in 255|124|137) echo "UNKNOWN(link)" ;; *) echo "NO-CARD" ;; esac
}

# --- local-starvation guard against the faked all-DOWN -------------------
# EVERY reachability verdict here is a LOCAL probe (ssh ConnectTimeout=6 / ping -W1). When THIS box
# is under a CPU burst (load1 ~44, the operator's "it keeps killing my ssh"), our own ssh/ping starve
# and time out — so a failed probe is NOT evidence the peer is down, it's evidence WE couldn't ask.
# Branding every peer UNREACHABLE/OFFLINE then poisons the dash FLEET pane (and its cache) with a
# fleet-wide outage that is really just local starvation (health@ 2026-07-22, false-alarm 3x/session).
# This is the inverse of the honest-fusion rule: never a faked all-DOWN either. A peer that ANSWERS is
# still trusted (the positive is reliable); only the negative is downgraded to UNKNOWN(load).

# local_starved [injected_load] -> 1 if load1 > threshold, else 0. Threshold = MESH_LOAD_GATE_MAX or
# nproc*0.9 (same convention mesh-load-gate uses for the operator's ssh-starvation tuning), but WITHOUT
# its shed-log side effect (fleet-health still RUNS — it only downgrades the verdict, it is not shed).
# Load unreadable -> 0 (NOT starved): fail toward the honest DOWN, never mask a real outage on a bad read.
local_starved() {
  local l1 thr nproc
  l1="${MESH_FLEET_FORCE_LOAD:-$(awk '{print $1}' /proc/loadavg 2>/dev/null)}"
  printf '%f' "$l1" >/dev/null 2>&1 || { echo 0; return; }
  nproc="$(nproc 2>/dev/null)"; [ "${nproc:-0}" -gt 0 ] 2>/dev/null || nproc=1
  thr="${MESH_LOAD_GATE_MAX:-$(awk -v n="$nproc" 'BEGIN{printf "%.1f", n*0.9}')}"
  [ "$(awk "BEGIN{print ($l1 > $thr) ? 1 : 0}")" = 1 ] && echo 1 || echo 0
}

# down_label <natural:UNREACHABLE|OFFLINE> <starved:0|1> -> the honest DOWN verdict. Starved -> the
# negative is untrustworthy, render UNKNOWN(load); calm -> the natural DOWN stands. Pure, unit-tested.
down_label() {
  local natural="$1" starved="$2"
  if [ "$starved" = 1 ]; then echo "UNKNOWN(load)"; else echo "$natural"; fi
}

# --- the access ORGAN vs the NETWORK (health@ 2026-08-24) -----------------
# Every verdict below UNREACHABLE was decided by ONE question — "can I ssh?" — and printed with a
# word from a layer ssh does not live on. A phone whose Termux sshd has flapped answers icmp, answers
# `tailscale ping`, exchanges tx/rx with us, and is branded UNREACHABLE: the row then sends whoever
# reads it to look at a network where there is nothing to find, while the remedy is a dead daemon on
# the body and needs a channel that is not ssh. This is the inverse of the NO-CARD case already
# handled above (ssh answers, the card does not): here L3 answers and the access organ does not.
# So: before branding a peer UNREACHABLE, ask a layer that does NOT depend on sshd.

# l3_alive <addr> [ts_ip] -> echoes a short rtt token ("icmp2.9ms" / "tsp4ms"), rc 0 = the body
# answered at a layer below ssh; rc 1 = silent on every layer we can ask.
# Two legs on purpose: icmp can be firewalled on a body whose tailscale data path is perfect (Android
# does exactly this), and `tailscale ping` is answered by the PEER'S tailscaled — it never touches
# either side's TUN/OS stack — so a pong is positive evidence that the remote AGENT is running.
l3_alive() {
  local addr="$1" tsip="${2:-}" out rtt
  if out=$(ping -c1 -W2 "$addr" 2>/dev/null); then
    rtt=$(printf '%s\n' "$out" | sed -n 's/.*time=\([0-9.]*\).*/\1/p' | head -1)
    # one decimal: the cell is 8 wide and the QUESTION this token answers is "did the body answer,
    # and roughly how far" — never a latency series (that is mesh-path-watch's tape, not this row).
    rtt=$(awk -v r="${rtt:-}" 'BEGIN{ if (r=="") print "?"; else printf "%.1f", r }')
    printf 'icmp%sms' "$rtt"; return 0
  fi
  if [ -n "$tsip" ] && command -v tailscale >/dev/null 2>&1; then
    out=$(timeout 10 tailscale ping --c 1 --timeout 3s "$tsip" 2>/dev/null || true)
    case "$out" in
      *pong*) rtt=$(printf '%s\n' "$out" | sed -n 's/.* in \([0-9]*\)ms.*/\1/p' | head -1)
              printf 'tsp%sms' "${rtt:-?}"; return 0 ;;
    esac
  fi
  return 1
}

# access_label <l3_evidence:"" if none> <starved:0|1> -> the honest verdict for "ssh did not answer".
# STARVED still wins: under a local CPU burst our own ssh AND ping starve, so the negative is not
# evidence of anything — UNKNOWN(load), exactly as before (a faked NO-SSHD is the same lie as a faked
# DOWN, one layer over). Calm + the body answered below ssh -> NO-SSHD (its access organ is dead, the
# body is up). Calm + silence everywhere -> the honest UNREACHABLE, unchanged. Pure, unit-tested.
access_label() {
  local l3="$1" starved="$2"
  [ "$starved" = 1 ] && { down_label UNREACHABLE 1; return; }
  if [ -n "$l3" ]; then echo "NO-SSHD"; else echo "UNREACHABLE"; fi
}

# --- fetch local card ----------------------------------------------------
fetch_local() {
  mesh-card 2>/dev/null | grep -E "^  (power|vitals|upstream|default-egress|minds):"
}

# --- parse a field from card grep output ---------------------------------
parse_field() {
  local card="$1" label="$2" default="${3:--}" line val
  line=$(echo "$card" | grep "^  ${label}:" | head -1)
  [ -n "$line" ] || { echo "$default"; return; }
  # Strip the "  label: " prefix, a trailing "(clean)" marker, and any inline "# comment".
  # A card field with a BLANK value + an explanatory "# OFF ..." note (e.g. phaedra's decommissioned
  # minds: line) must render as its value (→ the default "-"), not dump the prose into the column and
  # blow out the table. These fields (power/vitals/upstream/minds/egress) never use "#" as data.
  val=$(printf '%s\n' "$line" | sed "s/^  ${label}: *//; s/  *(clean)\$//; s/[[:space:]]*#.*\$//; s/[[:space:]]*\$//")
  [ -n "$val" ] && echo "$val" || echo "$default"
}

# --- one row -------------------------------------------------------------
print_row() {
  local name="$1" reach="$2" power="$3" vitals="$4" upstream="$5" minds="$6" egress="$7"
  printf '%-20s %-10s %-12s %-8s %-8s %-22s %s\n' \
    "$name" "$reach" "$power" "$vitals" "$upstream" "$minds" "$egress"
}

# --- tailscale path quality (mesh-path-watch consumer, wire-path-watch 2026-07-05) --------
# One PATH: line under the table from ~/.mesh/.path-watch-state — honest-fusion: absent sense
# renders UNKNOWN, stale mtime renders STALE (never a silently-missing or faked all-clear).
path_quality_line() {  # $1 = state file → one "PATH: ..." line
  local f="$1" line age
  [ -r "$f" ] || { echo "PATH: UNKNOWN (mesh-path-watch state absent — sense not running here)"; return; }
  line="$(cat "$f")"
  age=$(( $(date +%s) - $(stat -c %Y "$f" 2>/dev/null || echo 0) ))
  if [ "$age" -gt "${MESH_PATH_STALE_S:-900}" ]; then
    echo "PATH: STALE (${age}s old) $line"
  elif printf '%s' "$line" | grep -qE ' relay=[1-9]'; then
    echo "PATH: DEGRADED $line — peer(s) on DERP relay, tape ~/.mesh/path-watch.log"
  else
    echo "PATH: $line"
  fi
}

# --- smoke test -----------------------------------------------------------
if [ "${1:-}" = "--test" ]; then
    for d in mesh-peers python3 ssh; do command -v "$d" >/dev/null 2>&1 || { echo "smoke-test: FAIL ($d not found)"; exit 1; }; done
    mesh-peers --test >/dev/null 2>&1 || { echo "smoke-test: FAIL (mesh-peers unavailable)"; exit 1; }
    # path_quality_line classifications: absent→UNKNOWN, relay>0→DEGRADED, all-direct→plain
    _pf="$(mktemp)"
    path_quality_line "$_pf.absent" | grep -q '^PATH: UNKNOWN' || { rm -f "$_pf"; echo "smoke-test: FAIL (absent path state must render UNKNOWN)"; exit 1; }
    echo 'OK 2026-07-05T00:00:00Z peers=3 direct=2 relay=1 offline=0 | a=direct b=relay c=direct' > "$_pf"; touch "$_pf"
    path_quality_line "$_pf" | grep -q '^PATH: DEGRADED' || { rm -f "$_pf"; echo "smoke-test: FAIL (relay=1 must render DEGRADED)"; exit 1; }
    echo 'OK 2026-07-05T00:00:00Z peers=3 direct=3 relay=0 offline=0 | a=direct b=direct c=direct' > "$_pf"; touch "$_pf"
    path_quality_line "$_pf" | grep -qE '^PATH: OK .*relay=0' || { rm -f "$_pf"; echo "smoke-test: FAIL (all-direct must render plain OK line)"; exit 1; }
    rm -f "$_pf"
    # Starvation guard: a failed LOCAL probe under a CPU burst must NOT be branded a faked all-DOWN.
    down_label UNREACHABLE 0 | grep -qx 'UNREACHABLE'   || { echo "smoke-test: FAIL (calm: honest UNREACHABLE must survive)"; exit 1; }
    down_label OFFLINE 0     | grep -qx 'OFFLINE'       || { echo "smoke-test: FAIL (calm: honest OFFLINE must survive)"; exit 1; }
    down_label UNREACHABLE 1 | grep -qx 'UNKNOWN(load)' || { echo "smoke-test: FAIL (starved: UNREACHABLE must downgrade to UNKNOWN, not a faked DOWN)"; exit 1; }
    down_label OFFLINE 1     | grep -qx 'UNKNOWN(load)' || { echo "smoke-test: FAIL (starved: OFFLINE must downgrade to UNKNOWN)"; exit 1; }
    [ "$(MESH_FLEET_FORCE_LOAD=999 local_starved)" = 1 ] || { echo "smoke-test: FAIL (load 999 must read STARVED)"; exit 1; }
    [ "$(MESH_FLEET_FORCE_LOAD=0.1 local_starved)" = 0 ] || { echo "smoke-test: FAIL (load 0.1 must read calm)"; exit 1; }
    [ "$(MESH_FLEET_FORCE_LOAD=abc local_starved)" = 0 ] || { echo "smoke-test: FAIL (unreadable load must fail toward calm/honest-DOWN)"; exit 1; }
    # Organ-vs-network vocabulary: a failed ssh is only UNREACHABLE when NOTHING below ssh answers.
    access_label ""          0 | grep -qx 'UNREACHABLE'  || { echo "smoke-test: FAIL (calm + silent at every layer must stay UNREACHABLE)"; exit 1; }
    access_label "icmp2.9ms" 0 | grep -qx 'NO-SSHD'      || { echo "smoke-test: FAIL (calm + body answers below ssh must read NO-SSHD, not a network word)"; exit 1; }
    access_label "icmp2.9ms" 1 | grep -qx 'UNKNOWN(load)'|| { echo "smoke-test: FAIL (starved: the ssh negative is not evidence — must not mint a faked NO-SSHD)"; exit 1; }
    access_label ""          1 | grep -qx 'UNKNOWN(load)'|| { echo "smoke-test: FAIL (starved: must downgrade to UNKNOWN)"; exit 1; }
    # PEER-vs-LINK vocabulary: NO-CARD is a claim about the PEER, so it may only be minted when the
    # fetch's rc says the peer's shell ACTUALLY RAN and produced nothing (health@ 2026-08-25: a live
    # phaedra with a 2867 B card refreshed 2 min earlier was branded NO-CARD because our expensive
    # leg timed out while the cheap `ssh true` passed).
    card_absence_label 255 | grep -qx 'UNKNOWN(link)' || { echo "smoke-test: FAIL (ssh 255 is OUR link failing — must never mint NO-CARD about the peer)"; exit 1; }
    card_absence_label 124 | grep -qx 'UNKNOWN(link)' || { echo "smoke-test: FAIL (our own command timeout is OUR link — must never mint NO-CARD)"; exit 1; }
    card_absence_label 1   | grep -qx 'NO-CARD'       || { echo "smoke-test: FAIL (rc 1 = connected, grep matched nothing = genuinely cardless; the router must still render NO-CARD promptly)"; exit 1; }
    card_absence_label 0   | grep -qx 'NO-CARD'       || { echo "smoke-test: FAIL (rc 0 + empty = the remote ran and had nothing = cardless)"; exit 1; }
    card_absence_label 127 | grep -qx 'NO-CARD'       || { echo "smoke-test: FAIL (rc 127 = the remote shell ran, tool absent = cardless)"; exit 1; }
    # …and the rc must SURVIVE the command substitution the callers use. `x=$(f) || x=""` silently
    # collapses 255 into 0 and is exactly the defect; assert the surviving idiom against both rcs.
    _fake255() { return 255; }; _fake1() { return 1; }
    _v=$(_fake255); _r=$?; [ "$_r" = 255 ] || { echo "smoke-test: FAIL (rc lost through \$(...) — got $_r)"; exit 1; }
    [ "$(card_absence_label "$_r")" = "UNKNOWN(link)" ] || { echo "smoke-test: FAIL (a preserved 255 must classify as link)"; exit 1; }
    _v=$(_fake1); _r=$?; [ "$(card_absence_label "$_r")" = "NO-CARD" ] || { echo "smoke-test: FAIL (a preserved 1 must classify as cardless)"; exit 1; }
    # The callers must actually KEEP the rc — the whole cure is one idiom, and reverting a call site
    # to the or-empty-fallback form reads as a harmless tidy-up. Assert the live source has no such
    # call left. The banned form is deliberately NOT written out anywhere in this file's prose: a
    # comment quoting it would satisfy this gate by itself and the real call site could be reverted
    # green. Comment lines are excluded by position (grep -n prefixes a line number, so the anchor
    # has to allow for it — matching a bare leading # never fires and the filter is dead).
    _src="${BASH_SOURCE[0]}"
    grep -nE '\$\(fetch_remote[^)]*\)[[:space:]]*\|\|' "$_src" | grep -vE '^[0-9]+:[[:space:]]*#' \
      && { echo "smoke-test: FAIL (a fetch_remote call still discards its rc with an or-empty fallback)"; exit 1; }
    grep -cE '\$\(fetch_remote[^)]*\);[[:space:]]*l?frc=\$\?' "$_src" | grep -qxE '[4-9]|[0-9]{2,}' \
      || { echo "smoke-test: FAIL (expected every fetch_remote call site to capture its rc)"; exit 1; }
    # ConnectTimeout must not be the only bound: the command needs its own wall-clock cap.
    # EVERY ssh invocation, not merely one of them: a gate that only asks "does the wrapper appear
    # somewhere" stays green while the fetch — the expensive leg, the one measured at 76.2s — is
    # unwrapped, because a sibling call site still carries the string.
    _sshtot=$(grep -cE '(^|[^_[:alnum:]])ssh "\$\{' "$_src")
    _sshcap=$(grep -cE 'timeout --foreground -k 1 "\$FLEET_SSH_CMD_T" ssh "\$\{' "$_src")
    [ "$_sshtot" -gt 0 ] || { echo "smoke-test: FAIL (no ssh call sites found — the bound gate is vacuous)"; exit 1; }
    [ "$_sshtot" = "$_sshcap" ] || { echo "smoke-test: FAIL ($((_sshtot-_sshcap)) of $_sshtot ssh call sites are unbounded — ConnectTimeout does not cap a CONNECTED session; one measured fetch ran 76.2s under a 6s connect budget)"; exit 1; }
    # …and the probe that feeds it must be a REAL read, both directions. Loopback is the one address
    # every node answers; 192.0.2.1 is TEST-NET-1 (RFC5737), routable nowhere by contract, so the
    # negative arm is a genuine silence and not a stub. No ts_ip on either → the icmp leg is what runs.
    _l3="$(l3_alive 127.0.0.1)" || { echo "smoke-test: FAIL (l3_alive must answer for loopback — the probe is hollow)"; exit 1; }
    printf '%s' "$_l3" | grep -qE '^icmp[0-9.]+ms$' || { echo "smoke-test: FAIL (l3_alive must carry a real rtt, got: $_l3)"; exit 1; }
    if l3_alive 192.0.2.1 >/dev/null 2>&1; then echo "smoke-test: FAIL (TEST-NET-1 answered — l3_alive's negative arm is not a silence)"; exit 1; fi
    # Artifact test: fetch_local() must return non-empty card fields (self-scan, no SSH needed).
    # Catches the hollow class: mesh-card broken/absent → empty local row silently (no failure).
    local_card="$(fetch_local 2>/dev/null)"
    [ -n "$local_card" ] || { echo "smoke-test: FAIL (fetch_local empty — mesh-card not returning vitals/power/upstream fields; local fleet row would be blank)"; exit 1; }
    _first="$(printf '%s' "$local_card" | head -1 | sed 's/^  //' | cut -c1-55)"
    echo "smoke-test: ok (local card: $_first)"; exit 0
fi

# Each worker owns one row, including all retries/address resolution. Concurrent
# 25s budgets plus 5s enumeration fit the dash's 35s outer guard. timeout owns
# the process group; -k also bounds descendants which ignore TERM.
local_row() {
local_card=$(fetch_local)
[ -n "$local_card" ] || { print_row "$SELF" "UNKNOWN(card)" "-" "-" "-" "-" "-"; return; }
power=$(parse_field "$local_card" "power")
vitals_line=$(parse_field "$local_card" "vitals")
vitals=$(echo "$vitals_line" | awk '{print $1}')
upstream=$(parse_field "$local_card" "upstream")
minds=$(parse_field "$local_card" "minds" "(none)")
egress=$(parse_field "$local_card" "default-egress" "?" | sed 's/^dev //' | awk '{print $1}')
print_row "$SELF" "LOCAL" "$power" "$vitals" "$upstream" "$(mind_display "$minds" "$SELF")" "$egress"

}
peer_row() {
  local host="$1" ts_ip="$2" online="$3" pname
  pname=$(peer_name "$host")
  if [ "$online" != "True" ]; then
    # live=reachable: Tailscale-offline ≠ dead. Try the LAN before branding OFFLINE — the router
    # answers ping (its dropbear rejects our key → no card, LAN-ping IS the liveness), phone/others
    # answer SSH. Only unreachable on BOTH tailnet AND LAN is truly OFFLINE. (operator 2026-06-19)
    luser=$(peer_user "$pname"); lport=$(peer_port "$pname"); shown=""
    for laddr in $(lan_addrs_for "$pname"); do
      lcard=$(fetch_remote "$luser" "$laddr" "$lport"); lfrc=$?
      if [ -n "$lcard" ]; then
        print_row "$host" "yes(LAN)" "$(parse_field "$lcard" power)" \
          "$(parse_field "$lcard" vitals | awk '{print $1}')" "$(parse_field "$lcard" upstream)" \
          "$(mind_display "$(parse_field "$lcard" minds "(none)")" "$pname" "$host")" \
          "$(parse_field "$lcard" default-egress "?" | sed 's/^dev //' | awk '{print $1}')"
        shown=1; break
      elif ssh_reachable "$luser" "$laddr" "$lport"; then
        # same discrimination as the online branch: "(no-card)" is a claim about the PEER, and only
        # the fetch rc can tell it apart from our own link dying on the expensive leg.
        if [ "$(card_absence_label "$lfrc")" = "UNKNOWN(link)" ]; then
          print_row "$host" "LAN-up" "-" "-" "-" "(unknown-link)" "-"
        else
          print_row "$host" "LAN-up" "-" "-" "-" "(no-card)" "-"
        fi
        shown=1; break
      elif ping -c1 -W1 "$laddr" >/dev/null 2>&1; then
        print_row "$host" "LAN-ping" "-" "-" "-" "(no-ssh)" "-"; shown=1; break
      fi
    done
    [ -n "$shown" ] || print_row "$host" "$(down_label OFFLINE "$STARVED")" "-" "-" "-" "-" "-"
    return
  fi

  addr=$(resolve_addr "$pname" "$ts_ip") || { print_row "$host" "$(down_label UNREACHABLE "$STARVED")" "-" "-" "-" "-" "-"; return; }
  user=$(peer_user "$pname")
  port=$(peer_port "$pname")

  # `x=$(f); rc=$?` KEEPS the function's rc through the command substitution; `x=$(f) || x=""`
  # throws it away and collapses "the link died" into "the peer is cardless" (see card_absence_label).
  card=$(fetch_remote "$user" "$addr" "$port"); frc=$?
  # A reachable LAN address may lack this node's SSH key. Retry the selected
  # active Tailscale record before declaring the peer unreachable.
  if [ -z "$card" ] && [ "$addr" != "$ts_ip" ]; then
    card=$(fetch_remote "$user" "$ts_ip" "$port"); frc=$?
  fi
  # Probe reachability ONCE and reuse it: the retry below and the branch after it ask the same
  # question, and paying two extra ssh round-trips per peer on a degraded link is how a diagnostic
  # becomes part of the problem it is diagnosing.
  reach=1
  if [ -z "$card" ]; then
    ssh_reachable "$user" "$ts_ip" "$port" && reach=0 || reach=1
    # ONE bounded retry, and ONLY where it can change the verdict: the rc says our link died while
    # the cheap probe just passed, so the peer is there and the expensive leg flaked. Measured 7/8
    # success on this link, so a single retry recovers most of them; a blanket retry would just pay
    # the cost on the genuine cardless router, which answers correctly the first time.
    if [ "$reach" = 0 ] && [ "$(card_absence_label "$frc")" = "UNKNOWN(link)" ]; then
      card=$(fetch_remote "$user" "$ts_ip" "$port"); frc=$?
    fi
  fi
  if [ -z "$card" ]; then
    if [ "$reach" = 0 ]; then
      # cardless but reachable (e.g. the OpenWrt router): probe MINIMAL health (temp/load) so a
      # CRITICAL no-card node — the LAN gateway + VPN egress — isn't a blind spot. A fanless gateway
      # overheating = silent LAN+egress loss; this surfaces it. (capability sweep 2026-06-12.)
      rh_opts=("${SSH_OPTS[@]}"); [ "$port" != 22 ] && rh_opts+=(-p "$port")
      rh=$(timeout --foreground -k 1 "$FLEET_SSH_CMD_T" ssh "${rh_opts[@]}" "${user}@${ts_ip}" 'echo "$(cat /sys/class/thermal/thermal_zone0/temp 2>/dev/null || echo 0)|$(cut -d" " -f1 /proc/loadavg 2>/dev/null)"' 2>/dev/null </dev/null)
      rtemp="${rh%%|*}"; rload="${rh##*|}"
      if [ "${rtemp:-0}" -gt 0 ] 2>/dev/null; then rvit="$((rtemp/1000))C/ld${rload:-?}"; else rvit="reachable"; fi
      # NO-CARD only when the fetch's rc says the PEER answered and had nothing. A link failure that
      # the cheap `ssh true` happened to survive renders UNKNOWN(link) — never a claim about the peer.
      print_row "$host" "$(card_absence_label "$frc")" "-" "$rvit" "-" "-" "-"
    else
      # ssh is silent — ask a layer it does not depend on before naming the fault (see access_label).
      l3=$(l3_alive "$addr" "$ts_ip") || l3=""
      alab="$(access_label "$l3" "$STARVED")"
      # the MINDS cell names the organ ONLY when we actually found the body — on a genuine
      # UNREACHABLE we know nothing about its sshd, and saying "(no-sshd)" there would be the same
      # borrowed-word error one column over.
      if [ "$alab" = NO-SSHD ]; then amind="(no-sshd)"; else amind="-"; fi
      print_row "$host" "$alab" "-" "${l3:--}" "-" "$amind" "-"
    fi
    return
  fi

  power=$(parse_field "$card" "power")
  vitals=$(echo "$(parse_field "$card" "vitals")" | awk '{print $1}')
  upstream=$(parse_field "$card" "upstream")
  minds=$(parse_field "$card" "minds" "(none)")
  egress=$(parse_field "$card" "default-egress" "?" | sed 's/^dev //' | awk '{print $1}')
  print_row "$host" "yes" "$power" "$vitals" "$upstream" "$(mind_display "$minds" "$pname" "$host")" "$egress"
}
lan_row() {
  local label="$1" ip="$2"
  user=$(peer_user "$label"); port=$(peer_port "$label")
  if ssh_reachable "$user" "$ip" "$port"; then
    ropts=("${SSH_OPTS[@]}"); [ "$port" != 22 ] && ropts+=(-p "$port")
    # minimal vitals — load avg, works on linux AND macOS uptime formats
    ld=$(timeout --foreground -k 1 "$FLEET_SSH_CMD_T" ssh "${ropts[@]}" "${user}@${ip}" 'uptime' 2>/dev/null </dev/null \
         | sed -E 's/.*load average[s]?:[[:space:]]*//' | awk '{print $1}' | tr -d ,)
    print_row "$label" "yes(LAN)" "-" "${ld:+ld$ld}" "-" "(off-mesh)" "-"
  else
    # same organ-vs-network split for the off-Tailscale nodes (the iMac): a dark-woken mac answers
    # icmp long before sshd is back, and "UNREACHABLE" would send the reader to the LAN for nothing.
    l3=$(l3_alive "$ip") || l3=""
    alab="$(access_label "$l3" "$STARVED")"
    if [ "$alab" = NO-SSHD ]; then amind="(no-sshd)"; else amind="-"; fi
    print_row "$label" "$alab" "-" "${l3:--}" "-" "$amind" "-"
  fi
}

if [ "${1:-}" = --row ]; then
  STARVED="$2"; kind="$3"; shift 3
  case "$kind" in
    local) local_row ;;
    peer) peer_row "$@" ;;
    lan) lan_row "$@" ;;
    *) exit 2 ;;
  esac
  exit
fi

# --- main -----------------------------------------------------------------
STARVED="$(local_starved)"
work=$(mktemp -d) || exit 1
pids=(); names=()
cleanup() {
  local pid
  for pid in "${pids[@]}"; do kill -TERM "$pid" 2>/dev/null || :; done
  for pid in "${pids[@]}"; do
    kill -KILL -- "-$pid" 2>/dev/null || :
    wait "$pid" 2>/dev/null || :
  done
  rm -rf "$work"
}
trap cleanup EXIT
trap 'exit 143' TERM
trap 'exit 130' INT
# An unavailable roster cannot be represented by a successful partial snapshot.
if ! timeout -k 1 5 mesh-peers --json > "$work/peers.json"; then
  echo 'fleet refresh failed: peer enumeration unavailable' >&2; exit 1
fi
python3 -c '
import json, sys
for p in json.load(sys.stdin):
    print("{}|{}|{}".format(p["hostname"], p["ip"], p["online"]))
' < "$work/peers.json" > "$work/peers" || exit 1
launch() {
  local name="$1" index="${#pids[@]}"; shift
  names+=("$name")
  timeout -k 1 25 bash "${BASH_SOURCE[0]}" --row "$STARVED" "$@" > "$work/$index" 2> "$work/$index.err" &
  pids+=("$!")
}
launch "$SELF" local
while IFS='|' read -r host ip online; do
  [ -n "$host" ] || continue
  [ "$host" = "$SELF" ] && continue
  launch "$host" peer "$host" "$ip" "$online"
done < "$work/peers"
handled_ips=$(awk -F'|' 'NF{print $2}' "$work/peers")
for n in ${MESH_NODES:-}; do
  label="${n%%:*}"; spec="${n#*:}"
  [ "$spec" = local ] && continue
  ip="${spec#*@}"; [ -n "$ip" ] || continue
  case "$ip" in 100.*) continue ;; esac
  printf '%s\n' "$handled_ips" | grep -qxF "$ip" && continue
  launch "$label" lan "$label" "$ip"
done

echo "=== mesh-fleet-health $(ts) ==="
[ "$STARVED" = 1 ] && echo "⚠ LOCAL LOAD HIGH — reachability probe UNRELIABLE; non-answers shown as UNKNOWN(load), NOT down"
echo
print_row NODE REACHABLE POWER VITALS UPSTREAM MINDS EGRESS-DEV
print_row -------------------- ---------- ------------ -------- -------- ---------------------- ----------
for i in "${!pids[@]}"; do
  rc=0; wait "${pids[$i]}" || rc=$?
  # timeout can exit when its shell dies before the -k grace elapses, leaving
  # a TERM-ignoring grandchild behind. Reap the remaining worker group too.
  kill -KILL -- "-${pids[$i]}" 2>/dev/null || :
  if [ "$rc" = 0 ] && [ "$(wc -l < "$work/$i")" = 1 ] && [ -s "$work/$i" ]; then
    cat "$work/$i"
  else
    case "$rc" in 124|137) reason='UNKNOWN(timeout)' ;; *) reason='UNKNOWN(probe)' ;; esac
    print_row "${names[$i]}" "$reason" - - - - -
  fi
done
pids=()
echo
path_quality_line "$HOME/.mesh/.path-watch-state"
