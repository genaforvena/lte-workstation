#!/usr/bin/env bash
# orphan-ok: on-demand probe; the source is intentionally uncommitted and mesh-autowire refuses to
# schedule working-tree genome files, so this tool makes no false cron-liveness claim.
# mesh-nvme-balance — cross-drive NVMe thermal-balance sense.
#
# Reads one Composite temperature from each distinct NVMe hwmon controller and reports the
# hottest-minus-coolest spread. Individual temperatures and intra-drive gradients already have
# consumers; this cross-drive imbalance is a separate physical signal of uneven storage heat.
# Fewer than two readable NVMe controllers is UNREACHABLE (exit 2), never a fabricated zero spread.
#
#   mesh-nvme-balance          one live reading
#   mesh-nvme-balance --json   machine-readable reading
#   mesh-nvme-balance --edge   emit only when the verdict changes
#   mesh-nvme-balance --test   fixture assertions + real sysfs read
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"

MESH="${MESH_DIR:-$HOME/.mesh}"
ROOT="${MESH_NVME_BALANCE_ROOT:-/sys/class/hwmon}"
STATE="${MESH_NVME_BALANCE_STATE:-$MESH/.nvme-balance.state}"
SPREAD_MC="${MESH_NVME_BALANCE_SPREAD_MC:-10000}"

read_nvme_temps() {
  local h name value source count=0
  for h in "$ROOT"/hwmon*; do
    [ -d "$h" ] || continue
    [ -r "$h/name" ] || continue
    name="$(tr -d '[:space:]' < "$h/name" 2>/dev/null)"
    [ "$name" = nvme ] || continue
    source="$h/temp1_input"
    [ -r "$source" ] || continue
    value="$(tr -d '[:space:]' < "$source" 2>/dev/null)"
    case "$value" in ''|*[!0-9]*) continue ;; esac
    count=$((count + 1))
    printf '%s\t%s\n' "$value" "$source"
  done
  [ "$count" -ge 2 ]
}

classify_spread() {
  local spread="$1"
  case "$spread" in ''|*[!0-9]*) printf 'UNKNOWN'; return 2 ;; esac
  [ "$spread" -ge "$SPREAD_MC" ] && printf 'DIVERGENT' || printf 'BALANCED'
}

if [ "${1:-}" = --test ]; then
  td="$(mktemp -d)" || { echo 'smoke-test: FAIL (mktemp)'; exit 1; }
  trap 'rm -rf "$td"' EXIT
  mkdir -p "$td/hwmon0" "$td/hwmon1" "$td/hwmon2"
  printf 'nvme\n' > "$td/hwmon0/name"
  printf '45000\n' > "$td/hwmon0/temp1_input"
  printf 'nvme\n' > "$td/hwmon1/name"
  printf '61000\n' > "$td/hwmon1/temp1_input"
  printf 'k10temp\n' > "$td/hwmon2/name"
  printf '90000\n' > "$td/hwmon2/temp1_input"
  fixture="$(MESH_NVME_BALANCE_ROOT="$td" MESH_DIR="$td/mesh" "$0" --json 2>/dev/null)" || {
    echo "smoke-test: FAIL (fixture read: $fixture)"; exit 1;
  }
  printf '%s\n' "$fixture" | grep -q '"verdict":"DIVERGENT"' || { echo "smoke-test: FAIL (fixture verdict: $fixture)"; exit 1; }
  printf '%s\n' "$fixture" | grep -q '"controllers":2' || { echo "smoke-test: FAIL (fixture count: $fixture)"; exit 1; }
  printf '%s\n' "$fixture" | grep -q '"spread_mC":16000' || { echo "smoke-test: FAIL (fixture spread: $fixture)"; exit 1; }
  MESH_NVME_BALANCE_ROOT="$td/one" mkdir -p "$td/one/hwmon0"
  printf 'nvme\n' > "$td/one/hwmon0/name"
  printf '45000\n' > "$td/one/hwmon0/temp1_input"
  MESH_NVME_BALANCE_ROOT="$td/one" "$0" --json >/dev/null 2>&1
  [ "$?" -eq 2 ] || { echo 'smoke-test: FAIL (one controller must exit 2)'; exit 1; }
  live_rc=0
  live="$(env -u MESH_NVME_BALANCE_ROOT "$0" --json 2>/dev/null)" || live_rc=$?
  if [ "$live_rc" -eq 2 ]; then
    echo 'smoke-test: n/a (fewer than two live NVMe hwmon controllers)'
    exit 2
  fi
  [ "$live_rc" -eq 0 ] || { echo "smoke-test: FAIL (live read rc=$live_rc: $live)"; exit 1; }
  printf '%s\n' "$live" | grep -q '"controllers":[2-9]' || { echo "smoke-test: FAIL (live controller count: $live)"; exit 1; }
  echo "smoke-test: ok (fixture spread + one-controller exit-2 + real NVMe cross-drive read)"
  exit 0
fi

rows="$(read_nvme_temps 2>/dev/null)" || {
  echo "mesh-nvme-balance: UNREACHABLE — fewer than two readable NVMe hwmon controllers" >&2
  exit 2
}

count=0; hottest=-1; coolest=-1; hot_source=""; cool_source=""
while IFS=$'\t' read -r value source; do
  [ -n "$value" ] || continue
  count=$((count + 1))
  if [ "$hottest" -lt 0 ] || [ "$value" -gt "$hottest" ]; then hottest="$value"; hot_source="$source"; fi
  if [ "$coolest" -lt 0 ] || [ "$value" -lt "$coolest" ]; then coolest="$value"; cool_source="$source"; fi
done <<< "$rows"
[ "$count" -ge 2 ] || { echo 'mesh-nvme-balance: UNREACHABLE — parsed fewer than two controllers' >&2; exit 2; }
spread=$((hottest - coolest))
verdict="$(classify_spread "$spread")" || { echo 'mesh-nvme-balance: UNKNOWN — malformed spread' >&2; exit 2; }
ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
mkdir -p "$(dirname "$STATE")" 2>/dev/null || exit 1
printf 'verdict=%s|controllers=%s|hottest_mC=%s|coolest_mC=%s|spread_mC=%s|ts=%s\n' \
  "$verdict" "$count" "$hottest" "$coolest" "$spread" "$ts" > "$STATE" || exit 1
mesh-state-touch "$STATE" >/dev/null 2>&1 || { echo 'mesh-nvme-balance: UNKNOWN — state liveness stamp failed' >&2; exit 1; }

if [ "${1:-}" = --edge ]; then
  previous="$(sed -n 's/^verdict=\([^|]*\).*/\1/p' "$STATE.prev" 2>/dev/null || true)"
  cp "$STATE" "$STATE.prev" 2>/dev/null || true
  [ "$previous" = "$verdict" ] && exit 0
fi

if [ "${1:-}" = --json ] || [ "${1:-}" = --edge-json ]; then
  printf '{"verdict":"%s","controllers":%s,"hottest_mC":%s,"coolest_mC":%s,"spread_mC":%s,"hottest_source":"%s","coolest_source":"%s","ts":"%s"}\n' \
    "$verdict" "$count" "$hottest" "$coolest" "$spread" "$hot_source" "$cool_source" "$ts"
else
  printf '[nvme-balance] %s — controllers=%s hottest=%.1fC coolest=%.1fC spread=%.1fC\n' \
    "$verdict" "$count" "$(awk -v v="$hottest" 'BEGIN{print v/1000}')" "$(awk -v v="$coolest" 'BEGIN{print v/1000}')" "$(awk -v v="$spread" 'BEGIN{print v/1000}')"
fi
