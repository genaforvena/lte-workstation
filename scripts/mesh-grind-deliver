#!/usr/bin/env bash
# mesh-grind-deliver — ship any NEW mix that lands in ~/grainneukeln/output/ to the operator's TG,
# whether the MESH ground it (music-session / room-music) or the OPERATOR ground it MANUALLY
# (run_with_params.sh, the yt_*_grind.sh batches, the TUI). Operator 2026-07-21: "send any new output
# in grainneukeln folder to my telegram — both mixes the mesh does and me manually."
#
# The mesh's own SESSION mixes are already delivered by mesh-music-session; this closes the MANUAL gap.
# It shares the SAME sent ledger (~/.mesh/room-music-sent.log, keyed by basename), so a render
# music-session already shipped is skipped here — never a double-send.
#
# BACKLOG SAFETY (load-bearing): on FIRST run (no watermark file) the hundreds of pre-existing renders
# are SEEDED as seen WITHOUT sending — "new" means created after this reflex was installed, never a
# 500-file blast to TG. A watermark (mtime epoch, $WATERMARK) advances each tick; a render ships only
# if its mtime is newer than the watermark AND its basename is absent from the sent ledger.
#
# SETTLE: a render still being written (grind in flight) is NOT sent — only files whose mtime is at
# least $SETTLE seconds old are considered, and the watermark advances only to the settle boundary, so
# a fresh file is never skipped, only deferred one tick until it has settled.
#
# HONEST n/a: creds absent (no BOT_TOKEN/CHAT_ID) -> exit 2, nothing marked sent, watermark NOT advanced
# (a later run with creds still ships the same files). A >50MB mp3 (TG bot limit) is re-encoded to 96k
# and retried; if still >50MB it is logged FAIL and left unsent — never silently dropped.
#
#   mesh-grind-deliver           one tick: ship new renders, advance watermark
#   mesh-grind-deliver --status  watermark + count of pending (new-but-unsent) renders
#   mesh-grind-deliver --seed    mark ALL current renders seen without sending (reset the watermark)
#   mesh-grind-deliver --test    sandboxed dry-run: a new file ships once, an old/seen file doesn't,
#                                absent creds are honest n/a, the first run seeds (never blasts)
#
# reflex-cadence: */3 * * * *
set -uo pipefail
export PATH="/usr/bin:$HOME/.local/bin:$PATH"
export LC_ALL=C.UTF-8
MESH="${MESH_DIR:-$HOME/.mesh}"

OUTDIR="${GD_OUTDIR:-$HOME/grainneukeln/output}"
SENT_LOG="${GD_SENT_LOG:-$MESH/room-music-sent.log}"
WATERMARK="${GD_WATERMARK:-$MESH/grind-deliver.watermark}"
PARAMS_LOG="${GD_PARAMS_LOG:-$MESH/room-music-params.log}"
LOG="${GD_LOG:-$MESH/grind-deliver.log}"
LOCK="${GD_LOCK:-$MESH/.grind-deliver.lock}"
ENVF="${GD_ENVF:-$HOME/.config/remote-access/env}"
SETTLE="${GD_SETTLE:-30}"            # a render must be this many secs old (settled) before it ships
MAXMB="${GD_MAXMB:-50}"              # TG bot upload ceiling; over this -> re-encode to 96k
# test/override hook: when set, sending is a dry-run (no TG), the hook is called instead
DRYRUN="${GD_DRYRUN:-0}"

now(){ echo "${GD_NOW:-$(date +%s)}"; }
ts_utc(){ date -u +%FT%TZ; }
log(){ printf '%s %s\n' "$(ts_utc)" "$*" >> "$LOG" 2>/dev/null || true; }

# renders under $OUTDIR (recursive), excluding the e2e/ test-output subtree
list_renders(){ find "$OUTDIR" -type f -name '*.mp3' -not -path '*/e2e/*' 2>/dev/null; }

already_sent(){ # $1=basename  -> 0 if the ledger already records a send of it
  [ -f "$SENT_LOG" ] && grep -qF -- " $1" "$SENT_LOG"
}

# caption for a render: prefer the matching params-log line (matched by src=<..>/<hash> token in the
# filename); else the bare filename. Manual grinds encode their params in the filename already.
caption_for(){ # $1=basename
  local bn="$1" hash line
  # room-music renders carry ___mix_cut..-<tag>__ ; params-log rows key by src=ear/<hash> etc.
  hash="$(sed -n 's/.*-\([0-9a-f]\{8\}\)___.*/\1/p' <<<"$bn")"
  if [ -n "$hash" ] && [ -f "$PARAMS_LOG" ]; then
    line="$(grep -F "$hash" "$PARAMS_LOG" 2>/dev/null | tail -1)"
    [ -n "$line" ] && { printf '%s' "новый микс: $bn — $(sed -n 's/.* amc //p' <<<"$line")"; return; }
  fi
  printf '%s' "новый микс: $bn"
}

# send one render to the operator's TG; echo "sent"/"dryrun"/"FAIL:<why>"; never advances any state
send_render(){ # $1=path
  local f="$1" bn note szmb tmp rc
  bn="$(basename "$f")"
  note="$(caption_for "$bn")"
  if [ "$DRYRUN" = 1 ]; then echo "dryrun"; return 0; fi
  [ -n "${BOT_TOKEN:-}" ] && [ -n "${CHAT_ID:-}" ] || { echo "FAIL:no-creds"; return 2; }
  szmb=$(( $(stat -c%s "$f" 2>/dev/null || echo 0) / 1024 / 1024 ))
  local sendf="$f"
  if [ "$szmb" -ge "$MAXMB" ]; then
    tmp="$(dirname "$f")/.gd-reenc-$bn"
    if ffmpeg -v error -y -i "$f" -b:a 96k "$tmp" >/dev/null 2>&1 && [ -s "$tmp" ]; then
      local newmb; newmb=$(( $(stat -c%s "$tmp") / 1024 / 1024 ))
      if [ "$newmb" -ge "$MAXMB" ]; then rm -f "$tmp"; echo "FAIL:too-big-${newmb}MB"; return 1; fi
      sendf="$tmp"; log "reencoded $bn ${szmb}MB -> ${newmb}MB for TG"
    else
      rm -f "$tmp" 2>/dev/null; echo "FAIL:reencode"; return 1
    fi
  fi
  curl -s --max-time 120 "https://api.telegram.org/bot${BOT_TOKEN}/sendAudio" \
    -F "chat_id=${CHAT_ID}" -F "audio=@${sendf};type=audio/mpeg" \
    -F "title=$bn" -F "caption=$note" >/dev/null 2>&1
  rc=$?
  [ "$sendf" != "$f" ] && rm -f "$sendf" 2>/dev/null
  [ "$rc" = 0 ] && { echo "sent"; return 0; } || { echo "FAIL:curl-$rc"; return 1; }
}

tick(){
  mkdir -p "$MESH"
  [ -d "$OUTDIR" ] || { log "outdir $OUTDIR absent — nothing to watch"; return 0; }
  local n; n="$(now)"; local settle_boundary=$((n - SETTLE))

  # FIRST RUN: no watermark -> seed everything as seen, do NOT send (backlog safety).
  if [ ! -f "$WATERMARK" ]; then
    echo "$settle_boundary" > "$WATERMARK"
    log "seeded: watermark=$settle_boundary, $(list_renders | wc -l) existing render(s) marked seen (not sent) — delivering new ones going forward"
    return 0
  fi
  local wm; wm="$(cat "$WATERMARK" 2>/dev/null)"; [ -n "$wm" ] || wm=0

  # load creds once; absent -> honest n/a (do NOT advance watermark so a later run still ships)
  [ -f "$ENVF" ] && { set -a; . "$ENVF" 2>/dev/null; set +a; }
  if [ "$DRYRUN" != 1 ] && { [ -z "${BOT_TOKEN:-}" ] || [ -z "${CHAT_ID:-}" ]; }; then
    log "creds absent ($ENVF) — honest n/a, watermark held"
    return 2
  fi

  # candidates: mtime newer than watermark AND settled (older than SETTLE). Sort by mtime ascending.
  local sent=0 fail=0 skip=0 f mt res
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    mt=$(stat -c%Y "$f" 2>/dev/null || echo 0)
    [ "$mt" -gt "$wm" ] || continue
    [ "$mt" -le "$settle_boundary" ] || continue      # still settling — pick it up next tick
    local bn; bn="$(basename "$f")"
    if already_sent "$bn"; then skip=$((skip+1)); continue; fi
    res="$(send_render "$f")"
    case "$res" in
      sent|dryrun)
        printf '%s sent %s(grind-deliver) src=manual\n' "$(ts_utc)" "$bn" >> "$SENT_LOG"
        sent=$((sent+1)); log "delivered $bn"
        ;;
      *) fail=$((fail+1)); log "FAILED $bn ($res)"
        # a hard failure that is NOT a transient send error (too-big) must not wedge the watermark:
        # record it seen so we don't retry forever, but flag it.
        case "$res" in FAIL:too-big-*) printf '%s FAIL %s(grind-deliver too-big) src=manual\n' "$(ts_utc)" "$bn" >> "$SENT_LOG";; esac
        ;;
    esac
  done < <(list_renders | while IFS= read -r p; do printf '%s\t%s\n' "$(stat -c%Y "$p" 2>/dev/null)" "$p"; done | sort -n | cut -f2-)

  # advance the watermark to the settle boundary (nothing newer than it was eligible this tick, so no skip)
  echo "$settle_boundary" > "$WATERMARK"
  [ "$((sent+fail+skip))" -gt 0 ] && log "tick: sent=$sent fail=$fail skip=$skip wm=$settle_boundary"
  return 0
}

case "${1:-}" in
  --status)
    wm="$(cat "$WATERMARK" 2>/dev/null || echo '(unseeded)')"
    echo "outdir: $OUTDIR"
    echo "watermark: $wm  ($( [ "$wm" != '(unseeded)' ] && date -u -d "@$wm" +%FT%TZ 2>/dev/null))"
    if [ -f "$WATERMARK" ] && [ "$wm" != '(unseeded)' ]; then
      pend=0
      while IFS= read -r f; do
        [ -n "$f" ] || continue
        mt=$(stat -c%Y "$f" 2>/dev/null || echo 0); [ "$mt" -gt "$wm" ] || continue
        already_sent "$(basename "$f")" && continue; pend=$((pend+1))
      done < <(list_renders)
      echo "pending (new, unsent): $pend"
    fi
    echo "sent-ledger: $SENT_LOG ($(wc -l < "$SENT_LOG" 2>/dev/null || echo 0) lines)"
    exit 0 ;;

  --seed)
    mkdir -p "$MESH"; n="$(now)"
    echo "$((n - SETTLE))" > "$WATERMARK"
    echo "seeded: watermark=$(cat "$WATERMARK"), $(list_renders | wc -l) render(s) marked seen (not sent)"
    exit 0 ;;

  --test)
    tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT
    fail(){ echo "TEST FAIL: $*"; exit 1; }
    OUTDIR="$tmp/out"; SENT_LOG="$tmp/sent.log"; WATERMARK="$tmp/wm"; LOG="$tmp/log"
    PARAMS_LOG="$tmp/params.log"; ENVF="$tmp/env"; SETTLE=5
    mkdir -p "$OUTDIR"
    : > "$SENT_LOG"
    # creds present but DRYRUN so no real TG hit
    printf 'BOT_TOKEN=x\nCHAT_ID=y\n' > "$ENVF"

    echo "gate 1: FIRST run with pre-existing renders SEEDS (marks seen, sends nothing)"
    printf 'old\n' > "$OUTDIR/old_render_2026_07_20_1000.mp3"
    touch -d '2026-07-20 10:00' "$OUTDIR/old_render_2026_07_20_1000.mp3"
    GD_DRYRUN=1 GD_NOW=$(date -u -d '2026-07-21 12:00' +%s) tick
    [ -f "$WATERMARK" ] || fail "first run must create the watermark"
    [ "$(grep -c 'sent ' "$SENT_LOG" 2>/dev/null)" = 0 ] || fail "first run must NOT send the backlog"
    seedwm="$(cat "$WATERMARK")"

    echo "gate 2: a genuinely NEW settled render ships exactly once"
    printf 'new\n' > "$OUTDIR/new_render_2026_07_21_1201.mp3"
    touch -d '2026-07-21 12:01:00' "$OUTDIR/new_render_2026_07_21_1201.mp3"
    # tick at 12:10 (>SETTLE past the new file) — file mtime > seed watermark, settled
    GD_DRYRUN=1 GD_NOW=$(date -u -d '2026-07-21 12:10' +%s) tick
    c1="$(grep -c 'new_render_2026_07_21_1201.mp3' "$SENT_LOG" 2>/dev/null)"
    [ "$c1" = 1 ] || fail "a new settled render must ship exactly once (got $c1)"
    # a second tick must NOT re-ship (watermark advanced past it AND ledger de-dups)
    GD_DRYRUN=1 GD_NOW=$(date -u -d '2026-07-21 12:13' +%s) tick
    c2="$(grep -c 'new_render_2026_07_21_1201.mp3' "$SENT_LOG" 2>/dev/null)"
    [ "$c2" = 1 ] || fail "a shipped render must not re-ship (got $c2)"

    echo "gate 3: a render music-session ALREADY sent (in the ledger) is skipped here — no double-send"
    printf 'ms\n' > "$OUTDIR/ms_render_2026_07_21_1215.mp3"
    touch -d '2026-07-21 12:15:00' "$OUTDIR/ms_render_2026_07_21_1215.mp3"
    printf '%s sent ms_render_2026_07_21_1215.mp3(music-session mesh-home x) src=mesh-home\n' "$(ts_utc)" >> "$SENT_LOG"
    GD_DRYRUN=1 GD_NOW=$(date -u -d '2026-07-21 12:30' +%s) tick
    c3="$(grep -c 'ms_render_2026_07_21_1215.mp3' "$SENT_LOG" 2>/dev/null)"
    [ "$c3" = 1 ] || fail "a music-session-sent render must NOT be re-sent by grind-deliver (ledger count $c3, want 1)"

    echo "gate 4: an UNSETTLED render (mtime within SETTLE of now) is deferred, not sent"
    rm -f "$SENT_LOG"; : > "$SENT_LOG"; echo "$(date -u -d '2026-07-21 12:59' +%s)" > "$WATERMARK"
    printf 'fresh\n' > "$OUTDIR/fresh_render.mp3"
    tnow=$(date -u -d '2026-07-21 13:00:00' +%s)
    touch -d "@$((tnow-2))" "$OUTDIR/fresh_render.mp3"   # only 2s old, SETTLE=5
    GD_DRYRUN=1 GD_NOW=$tnow tick
    [ "$(grep -c 'fresh_render.mp3' "$SENT_LOG" 2>/dev/null)" = 0 ] || fail "an unsettled render must be deferred"
    # next tick, now settled, it ships
    GD_DRYRUN=1 GD_NOW=$((tnow+10)) tick
    [ "$(grep -c 'fresh_render.mp3' "$SENT_LOG" 2>/dev/null)" = 1 ] || fail "a settled render must ship on the next tick"

    echo "gate 5: creds ABSENT is honest n/a (exit 2), nothing sent, watermark held"
    # a prior gate sourced the env into THIS shell; a real cron run is fresh, so unset to model it
    unset BOT_TOKEN CHAT_ID
    rm -f "$SENT_LOG"; : > "$SENT_LOG"; rm -f "$ENVF"; echo 1000 > "$WATERMARK"
    printf 'x\n' > "$OUTDIR/nocreds_2026.mp3"; touch -d '2026-07-21 14:00' "$OUTDIR/nocreds_2026.mp3"
    GD_DRYRUN=0 GD_NOW=$(date -u -d '2026-07-21 15:00' +%s) tick; rc=$?
    [ "$rc" = 2 ] || fail "creds-absent must exit 2 (got $rc)"
    [ "$(cat "$WATERMARK")" = 1000 ] || fail "creds-absent must NOT advance the watermark"
    [ "$(grep -c 'sent ' "$SENT_LOG" 2>/dev/null)" = 0 ] || fail "creds-absent must send nothing"

    echo "smoke-test: ok — seed-not-blast, ship-new-once, skip-ms-sent, defer-unsettled, honest-n/a"
    exit 0 ;;

  ""|--tick)
    mkdir -p "$MESH"
    exec 9>"$LOCK"
    flock -n 9 || { echo "grind-deliver: another tick holds the lock"; exit 0; }
    tick
    exit $? ;;

  *)
    echo "usage: mesh-grind-deliver [--tick] | --status | --seed | --test"; exit 1 ;;
esac
