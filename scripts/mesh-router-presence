#!/usr/bin/env bash
# mesh-router-presence — WiFi client presence from the GL-MT3000 router vantage.
# Queries iwinfo assoclist (2.4GHz ra0 + 5GHz rax0) + dhcp.leases over SSH.
# Output: JSON [{mac, rssi_dbm, band, hostname, ip}]
# Covers TV/iPad/iMac — devices visible only to the router (no BLE/Tailscale).
#
#   mesh-router-presence            JSON to stdout
#   mesh-router-presence --test     smoke-test deps + router reachability
#
# Router resolved from MESH_NODES (router or GL-MT3000 entry).
# Honest: unreachable → exit 2, empty list → exit 0 with '[]'.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes"

router_addr(){
  local pair
  for pair in $MESH_NODES; do
    case "$pair" in router:*|GL-MT3000:*) printf '%s' "${pair#*:}"; return 0;; esac
  done
  return 1
}

if [ "${1:-}" = --test ]; then
  for d in ssh awk grep sed; do command -v "$d" >/dev/null 2>&1 || { echo "smoke-test: FAIL (no $d)"; exit 1; }; done
  raddr="$(router_addr)" || { echo "smoke-test: n/a (router not in MESH_NODES)"; exit 0; }
  ssh -o ConnectTimeout=5 -o BatchMode=yes "$raddr" "command -v iwinfo" >/dev/null 2>&1 \
    || { echo "smoke-test: n/a (router unreachable or no iwinfo)"; exit 0; }
  echo "smoke-test: ok"
  exit 0
fi

raddr="$(router_addr)" || { echo '[]'; exit 2; }

raw="$(ssh -o ConnectTimeout=8 -o BatchMode=yes "$raddr" '
  iwinfo ra0 assoclist 2>/dev/null | grep -E "^[0-9A-F]{2}:" | awk "{print \"2.4\t\"\$1\"\t\"\$2}"
  iwinfo rax0 assoclist 2>/dev/null | grep -E "^[0-9A-F]{2}:" | awk "{print \"5\t\"\$1\"\t\"\$2}"
  printf "---\n"
  cat /tmp/dhcp.leases 2>/dev/null
' 2>/dev/null)" || { echo '[]'; exit 2; }

wifi_part="$(printf '%s\n' "$raw" | sed '/^---$/,$d')"
leases_part="$(printf '%s\n' "$raw" | sed '1,/^---$/d')"
[ -z "$wifi_part" ] && { echo '[]'; exit 0; }

echo '['
first=1
while IFS=$'\t' read -r band mac rssi rest; do
  [ -z "$mac" ] && continue
  mac_lower="$(printf '%s' "$mac" | tr 'A-F' 'a-f')"
  hn=""; ip=""
  if [ -n "$leases_part" ]; then
    lease_line="$(printf '%s\n' "$leases_part" | grep -i "^[0-9]* $mac_lower " | head -1)"
    [ -n "$lease_line" ] && {
      hn="$(printf '%s' "$lease_line" | awk '{print $4}')"
      ip="$(printf '%s' "$lease_line" | awk '{print $3}')"
    }
  fi
  [ "$first" = 0 ] && printf ',\n'
  printf '  {"mac":"%s","rssi_dbm":%s,"band":"%s","hostname":"%s","ip":"%s"}' \
    "$mac" "$rssi" "$band" "${hn:-unknown}" "${ip:-}"
  first=0
done <<< "$wifi_part"
printf '\n]\n'
exit 0
