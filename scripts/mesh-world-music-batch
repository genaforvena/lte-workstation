#!/usr/bin/env bash
# mesh-world-music-batch — keep drawing world music and grinding SEVERAL param sets per track,
# shipping each render the moment it exists. Operator 2026-08-30: "grind a lot of them, several
# param sets for each track", on top of "по мере поступления давайте, охота послушать".
#
# This is a DRIVER, not a second lane: every draw, licence gate, attribution ladder, fidelity check
# and delivery is mesh-random-track-grind's. It only supplies the cadence the cron slot cannot —
# cron gives one draw every 2h, and "a lot of them" is a different rate.
#
# It rotates the strata ITSELF rather than leaning on the shared cursor, so a long batch cannot sit
# on one stratum, and so the cron slot's own rotation is left undisturbed.
set -uo pipefail
MESH="${MESH_DIR:-$HOME/.mesh}"
LOG="$MESH/world-music-batch.log"
TRACKS="${WMB_TRACKS:-12}"
# 8, not 3 (operator 2026-08-30: "use not only 3 param sets, use more"). This is safe to raise now
# only because each variant is repelled from ALL of this track's earlier ones through the per-track
# worn store: the shared params window is the last SR_RECENT (default 6) lines and other lanes write
# into it too, so before that change variant 7+ was no longer repelled from variant 1 and the search
# could simply return it again. Past the point where the search runs out of admissible room the
# repulsor degrades into repeats rather than refusals (plain epsilon, a preference with a fallback),
# which is why TRACK-DONE publishes the DISTINCT recipe count beside the requested N.
VARIANTS="${WMB_VARIANTS:-8}"
STRATA="${WMB_STRATA:-records field netlabels}"   # ethno excluded by default: its unit is a TAPE
# SIDE (measured 17.8/20.7/36.8 min vs 1.7-12.0 for every other stratum), so at ~4x expansion it
# ships 80+ min / 200MB renders. That question is open with the operator as (a)/(b)/(c); until he
# rules, a long batch must not fill the channel with hour-long files. Put it back with WMB_STRATA.
say(){ printf '%s %s\n' "$(date -u +%FT%TZ)" "$*" >> "$LOG"; }
case "${1:-}" in
  --test)
    grep -q 'RTG_''VARIANTS' "$0" || { echo "FAIL: the driver never asks for more than one param set — the whole request was several per track" >&2; exit 1; }
    grep -q 'WMB_''STRATA' "$0" || { echo "FAIL: strata are not rotated by the driver, so a long batch sits on whatever the shared cursor pointed at" >&2; exit 1; }
    [ "$LOG" != "$MESH/random-track-grind.log" ] || { echo "FAIL: the driver log IS the lane ledger — every row would be double-counted" >&2; exit 1; }
    grep -q 'rc=\$?   # FIR''ST' "$0" || { echo "FAIL: the exit code is not captured immediately — any command between the run and \$? resets it, and this reported rc=0 for every failed track, destroying the one number that separates a timeout from a refusal" >&2; exit 1; }
    grep -q '600 + VARIANTS \* ''700' "$0" || { echo "FAIL: the per-track budget does not scale with the variant count — measured median 216s/max 660s per variant, so 8 variants overruns any flat few-thousand-second bound and truncates the track mid-loop with no TRACK-DONE row to say so" >&2; exit 1; }
    grep -q 'rc" -eq ''124' "$0" || { echo "FAIL: a timeout kill is not told apart from a real failure — 124 means the budget was too small, which has a different remedy from anything the lane rejected" >&2; exit 1; }
    echo "world-music-batch-test: ok (asks for N variants · rotates strata itself · own log, not the lane ledger)"; exit 0 ;;
  --status) [ -s "$LOG" ] && tail -12 "$LOG" || echo "no batch has run yet"; exit 0 ;;
esac
say "BATCH-START tracks=$TRACKS variants=$VARIANTS strata=$STRATA"
set -- $STRATA; n=$#; i=0; ok=0; bad=0
for t in $(seq 1 "$TRACKS"); do
  eval "s=\${$(( i % n + 1 ))}"; i=$((i+1))
  say "TRACK $t/$TRACKS stratum=$s variants=$VARIANTS"
  # THE BUDGET SCALES WITH THE VARIANT COUNT, because a per-track constant truncates a track
  # mid-loop and the ledger cannot tell that from a track that simply ended. Measured on this
  # corpus 2026-08-30, n=13 consecutive variant gaps: median 216s, max 660s per variant. The flat
  # 3000s here killed track 2 inside variant 4 of 8 — it had already shipped 2 — and it left NO
  # TRACK-DONE row, so the only evidence was a driver line that said FAILED.
  # 700s per variant is above the observed max; 600s of fixed overhead covers the picker year-walk,
  # the fetch, the transcode, the measure and the archivist sweep.
  _budget=$(( 600 + VARIANTS * 700 ))
  RTG_STRATUM="$s" RTG_VARIANTS="$VARIANTS" timeout "$_budget" mesh-random-track-grind >>"$LOG" 2>&1
  rc=$?   # FIRST, before anything else runs. `bad=$((bad+1)); say "... rc=$?"` reported rc=0 for
          # every failed track, because the arithmetic assignment had already succeeded and reset
          # $?. It destroyed the one number that separates a timeout from a refusal.
  if [ "$rc" -eq 0 ]; then
    ok=$((ok+1)); say "TRACK $t/$TRACKS stratum=$s OK"
  elif [ "$rc" -eq 124 ]; then
    bad=$((bad+1)); say "TRACK $t/$TRACKS stratum=$s TRUNCATED by the ${_budget}s budget (rc=124) — variants already shipped are kept and delivered; raise WMB_VARIANTS budget or lower the count"
  else
    bad=$((bad+1)); say "TRACK $t/$TRACKS stratum=$s FAILED rc=$rc (see the lane ledger for the named cause)"
  fi
done
say "BATCH-DONE ok=$ok failed=$bad of $TRACKS track(s)"
