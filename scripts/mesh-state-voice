#!/usr/bin/env bash
# orphan-ok: prototype fusion, consent-gated outward-facing actuator — do NOT cron-wire or set
#   MESH_STATE_VOICE_ENABLE=1 without operator sign-off (discover mission doctrine: "SENDING ...
#   touches the world — confirm via the board/operator first"). This file only PROPOSES the wiring.
# mesh-state-voice — CONNECTION fusion: mesh-voice-clone-daemon (the operator's cloned-voice TTS,
# already the primary synth path for every speech organ via mesh-voice-say/mesh-note3-say) x
# mesh-home-state (the CAUSE LAYER — household situational inference). Neither half does this
# alone: the clone daemon has no notion of WHEN to speak; mesh-home-state's dwell-debounced,
# honest-n/a-respecting ANNOUNCED state already lives at $HOME/.mesh/.household.state, written
# ONLY by `mesh-household-state --edge` (a live reflex, reflex-args: --edge) — but today that
# transition only ever lands SILENTLY on disk or as [household-*] BOARD TEXT, never spoken.
# Crossing them: speak a genuine state transition aloud through the Note3 room speaker, in the
# operator's own cloned voice. mesh-prior-art "voice announce home-state transition" came back
# CLEAN (near-match mesh-session-watchdog is unrelated: it posts board text gated on a home-state
# DARK token to suppress alerts, it never speaks).
#
# Deliberately reuses HS_STATE ($HOME/.mesh/.household.state) instead of re-deriving a transition
# — mesh-household-state --edge already does the dwell-debounce + honest-n/a work (a senseless
# node emits NOTHING, never a fabricated verdict); a second detector here would just be a second,
# divergent copy of that logic. This tool ONLY compares HS_STATE's current content against ITS OWN
# last-spoken record ($HOME/.mesh/.state-voice-last) — it never recomputes household state itself.
#
#   mesh-state-voice            check HS_STATE vs last-spoken; on a genuine change, speak it
#                                (LOUD dry-run — logs the line it WOULD say — unless
#                                MESH_STATE_VOICE_ENABLE=1; never a silent no-op either way)
#   mesh-state-voice --test     offline classify_speak fixtures (cold-start/no-change/both edges/
#                                honest-n/a) + a live dry-run against the real HS_STATE, using a
#                                stubbed note3-say so --test NEVER plays real audio regardless of
#                                MESH_STATE_VOICE_ENABLE
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

HS_STATE="${MESH_HS_STATE_FILE:-$HOME/.mesh/.household.state}"
LAST_SPOKEN="${MESH_STATE_VOICE_LAST_FILE:-$HOME/.mesh/.state-voice-last}"
LOG="${MESH_STATE_VOICE_LOG:-$HOME/.mesh/state-voice.log}"

# ru gloss for each household token; falls back to the raw token for anything unmapped so a
# future 5th token never silently drops the announcement.
_ru() {
  case "$1" in
    ACTIVE)    echo "дом активен" ;;
    ASLEEP)    echo "дом спит" ;;
    AWAY)      echo "дома никого нет" ;;
    UNCERTAIN) echo "состояние дома неясно" ;;
    *)         echo "состояние дома: $1" ;;
  esac
}

# classify_speak <prev last-spoken> <curr HS_STATE content> → "SPEAK|<text>" or "HOLD|<reason>"
# Pure/offline-testable. Symmetric — ANY genuine change speaks, not just entry into one state
# (both-edges-of-a-signal-need-the-same-gate).
classify_speak() {
  local prev="$1" curr="$2"
  if [ -z "$curr" ]; then
    echo "HOLD|HS_STATE empty/unreadable — honest n/a, nothing announced yet"
    return
  fi
  if [ -z "$prev" ]; then
    echo "HOLD|cold start (no prior spoken state) — baselining to ${curr}, not announcing on startup"
    return
  fi
  if [ "$prev" = "$curr" ]; then
    echo "HOLD|no change (${curr})"
    return
  fi
  echo "SPEAK|$(_ru "$curr")."
}

if [ "${1:-}" = --test ]; then
  _f=0
  [ "$(classify_speak "" "ACTIVE")" = "HOLD|cold start (no prior spoken state) — baselining to ACTIVE, not announcing on startup" ] \
    || { echo "  FAIL: cold start -> HOLD"; _f=1; }
  [ "$(classify_speak "ACTIVE" "")" = "HOLD|HS_STATE empty/unreadable — honest n/a, nothing announced yet" ] \
    || { echo "  FAIL: empty curr -> HOLD (honest n/a)"; _f=1; }
  [ "$(classify_speak "ACTIVE" "ACTIVE")" = "HOLD|no change (ACTIVE)" ] \
    || { echo "  FAIL: same state -> HOLD"; _f=1; }
  [ "$(classify_speak "ACTIVE" "ASLEEP")" = "SPEAK|дом спит." ] \
    || { echo "  FAIL: ACTIVE->ASLEEP -> SPEAK (edge 1)"; _f=1; }
  [ "$(classify_speak "ASLEEP" "ACTIVE")" = "SPEAK|дом активен." ] \
    || { echo "  FAIL: ASLEEP->ACTIVE -> SPEAK (edge 2, symmetric)"; _f=1; }
  [ "$(classify_speak "ACTIVE" "AWAY")" = "SPEAK|дома никого нет." ] \
    || { echo "  FAIL: ACTIVE->AWAY -> SPEAK"; _f=1; }
  [ "$(classify_speak "AWAY" "ZZZ_UNKNOWN_TOKEN")" = "SPEAK|состояние дома: ZZZ_UNKNOWN_TOKEN." ] \
    || { echo "  FAIL: unmapped token falls back to raw, never dropped silently"; _f=1; }
  [ "$_f" = 0 ] || { echo "smoke-test: FAIL (classify_speak logic)"; exit 1; }

  # live dry-run: real HS_STATE if present, stubbed note3-say so --test NEVER speaks for real
  td="$(mktemp -d)"; trap 'rm -rf "$td"' EXIT
  cat > "$td/mesh-note3-say" <<'EOF'
#!/usr/bin/env bash
echo "STUB-SPOKEN: $1"
exit 0
EOF
  chmod +x "$td/mesh-note3-say"
  out=$(PATH="$td:$PATH" MESH_STATE_VOICE_ENABLE=1 \
        MESH_HS_STATE_FILE="$HOME/.mesh/.household.state" \
        MESH_STATE_VOICE_LAST_FILE="$td/last" \
        MESH_STATE_VOICE_LOG="$td/log" "$0" 2>&1)
  rc=$?
  if [ ! -f "$HOME/.mesh/.household.state" ]; then
    echo "smoke-test: ok (classify_speak: cold-start+honest-n/a+no-change+2 symmetric edges+unmapped-fallback; live HS_STATE absent — n/a, logic-only pass)"; exit 0
  fi
  case "$out" in
    *STUB-SPOKEN*|*HOLD*) : ;;
    *) echo "smoke-test: FAIL (live dry-run produced neither a stubbed speak nor a HOLD line: $out)"; exit 1 ;;
  esac
  [ "$rc" = 0 ] || { echo "smoke-test: FAIL (live dry-run rc=$rc)"; exit 1; }
  echo "smoke-test: ok (classify_speak: cold-start+honest-n/a+no-change+2 symmetric edges+unmapped-fallback; live dry-run against real HS_STATE via stub: $out)"
  exit 0
fi

curr="$(cat "$HS_STATE" 2>/dev/null || echo)"
prev="$(cat "$LAST_SPOKEN" 2>/dev/null || echo)"
vg="$(classify_speak "$prev" "$curr")"
verdict="${vg%%|*}"; detail="${vg#*|}"

ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
mkdir -p "$(dirname "$LOG")" 2>/dev/null || true

if [ "$verdict" = SPEAK ]; then
  enabled="${MESH_STATE_VOICE_ENABLE:-0}"
  if [ "$enabled" = 1 ]; then
    if mesh-note3-say "$detail" 2>>"$LOG"; then
      printf '%s\tSPOKEN\t%s\n' "$ts" "$detail" >> "$LOG"
    else
      printf '%s\tSPEAK-FAILED (note3-say rc!=0)\t%s\n' "$ts" "$detail" >> "$LOG"
    fi
  else
    # LOUD dry-run — never a silent no-op (silent-fallback trap): the line that WOULD have been
    # spoken is logged every time, so an operator scanning the log sees exactly what's gated.
    printf '%s\tDRY-WOULD-SPEAK (MESH_STATE_VOICE_ENABLE=0)\t%s\n' "$ts" "$detail" >> "$LOG"
  fi
  printf '%s' "$curr" > "$LAST_SPOKEN"
  echo "[state-voice] ${verdict} — ${detail}"
else
  printf '%s\t%s\t%s\n' "$ts" "$verdict" "$detail" >> "$LOG"
  # cold-start baselines even on HOLD so the NEXT genuine change is caught
  [ -n "$curr" ] && [ -z "$prev" ] && printf '%s' "$curr" > "$LAST_SPOKEN"
  echo "[state-voice] ${verdict} — ${detail}"
fi
