#!/usr/bin/env bash
# mesh-tools — the navigable INDEX of the genome's tools (operator 2026-06-13: "hard to reason about
# so many scripts in one folder"). A LIVING index: categories come from CLAUDE.md's tooling section
# (the source of truth), one-line descriptions from each script's own header. Nothing is hand-maintained
# here — add a tool + put it in a CLAUDE.md category and it appears, correctly grouped.
#
#   mesh-tools                  all tools, grouped by function (with one-line descriptions)
#   mesh-tools <keyword>        only the category whose name matches <keyword> (e.g. perceive, liveness)
#   mesh-tools --search <term>  tools whose NAME or DESCRIPTION matches <term>
#   mesh-tools --uncategorized  tools not in a CLAUDE.md tooling section (canon candidates; ≠ orphan)
#   mesh-tools --counts         one line per category with its tool count
#   mesh-tools --test
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
REPO="${MESH_REPO:-$HOME/lte-workstation}"; CLAUDE="$REPO/CLAUDE.md"; SCR="$REPO/scripts"

if [ "${1:-}" = --test ]; then
  for x in python3 grep sed; do command -v "$x" >/dev/null 2>&1 || { echo "smoke-test: FAIL (no $x)"; exit 1; }; done
  [ -f "$CLAUDE" ] || { echo "smoke-test: FAIL (no CLAUDE.md at $CLAUDE)"; exit 1; }
  [ -d "$SCR" ] || { echo "smoke-test: FAIL (no scripts/ at $SCR)"; exit 1; }
  _td="$(mktemp -d "${TMPDIR:-/tmp}"/mesh-tools-test.XXXXXX)" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
  trap 'rm -rf "$_td"' EXIT
  mkdir -p "$_td/failbin"
  ln -s /usr/bin/bash "$_td/failbin/bash"
  ln -s /usr/bin/grep "$_td/failbin/grep"
  ln -s /usr/bin/sed "$_td/failbin/sed"
  if HOME="$HOME" PATH="$_td/failbin" "$0" --counts >/dev/null 2>&1; then
    echo "smoke-test: FAIL (missing python3 did not fail mesh-tools --counts)"; exit 1
  fi
  out="$("$0" --counts 2>&1)" || { echo "smoke-test: FAIL (--counts errored)"; exit 1; }
  printf '%s' "$out" | grep -qi 'perceive\|coordinate\|liveness' || { echo "smoke-test: FAIL (no categories parsed from CLAUDE.md)"; exit 1; }
  echo "smoke-test: ok (python3 gate + counts parse verified)"; exit 0
fi

MODE="all"; ARG=""
case "${1:-}" in
  --search)        MODE="search"; ARG="${2:-}" ;;
  --uncategorized) MODE="uncat" ;;
  --counts)        MODE="counts" ;;
  "" )             MODE="all" ;;
  --*)             echo "unknown flag: $1 (mesh-tools --test for usage)"; exit 1 ;;
  *)               MODE="category"; ARG="$1" ;;
esac

CLAUDE="$CLAUDE" SCR="$SCR" MODE="$MODE" ARG="$ARG" python3 <<'PY'
import os, re, glob

claude = os.environ["CLAUDE"]; scrdir = os.environ["SCR"]
mode = os.environ["MODE"]; arg = os.environ["ARG"].lower()

# 1) categories from CLAUDE.md: each "**Name:**" (or "**On-demand canon**") heads a block until the
#    next bold heading; collect the mesh-* names backtick-quoted in that block, in document order.
text = open(claude, encoding="utf-8", errors="replace").read()
# anchor to the TOOLING section only (starts at "**Coordinate / drive:**") — not the doctrine prose,
# which also bolds phrases like "Coordinate via tmux" and would steal tools into a phantom category.
anchor = re.search(r'\*\*Coordinate / drive:\*\*', text)
if anchor: text = text[anchor.start():]
# match ONLY the six real tooling-category labels
heads = list(re.finditer(r'\*\*(Coordinate / drive|Perceive \(sensorium\)|Liveness / self-tend|Metabolism \(inference\)|Genome / substrate|On-demand canon)[^*]*\*\*', text))
cats = []          # [(name, [tools...])]
tool2cat = {}
for i, h in enumerate(heads):
    name = re.sub(r'[:\s]+$', '', h.group(1)).strip()
    start = h.end(); end = heads[i+1].start() if i+1 < len(heads) else len(text)
    block = text[start:end]
    tools = []
    for m in re.finditer(r'`(mesh-[a-z0-9-]+|node-join-android\.sh|test-[a-z-]+)`', block):
        t = m.group(1)
        # only tools whose file actually EXISTS — CLAUDE.md prose also names DECAYED tools (in the
        # "Decayed:" notes); those have no file and must not appear as current capability.
        if t not in tool2cat and os.path.exists(os.path.join(scrdir, t)):
            tool2cat[t] = name; tools.append(t)
    cats.append((name, tools))

# 2) one-line description from each script's header — robust to the conventions tools legitimately use:
#    bash comment  "# name [args] — desc"  ·  python docstring  '"""name — desc'  ·  systemd "Description="
def desc(tool):
    p = os.path.join(scrdir, tool)
    if not os.path.exists(p): return ""
    base = re.escape(tool)
    pat_named = re.compile(r'^\s*(?:#\s*|"""\s*)?'+base+r'(?:\s*[\[<][^\]>]*[\]>])*\s*[—–-]\s*(.+)')
    pat_systemd = re.compile(r'^Description=\s*(.+)')
    try:
        for ln in open(p, encoding="utf-8", errors="replace").read().splitlines()[:10]:
            m = pat_named.match(ln)
            if m: return m.group(1).strip().rstrip('"').strip()
            m = pat_systemd.match(ln)
            if m: return m.group(1).strip()
    except Exception: pass
    return ""

# 3) every script actually present
present = sorted(os.path.basename(p) for p in glob.glob(os.path.join(scrdir, "mesh-*")))
present += sorted(os.path.basename(p) for p in glob.glob(os.path.join(scrdir, "test-*")))

def line(t):
    d = desc(t); d = (d[:96] + "…") if len(d) > 97 else d
    return f"  {t:<26} {d}"

if mode == "counts":
    for name, tools in cats:
        print(f"{len(tools):>3}  {name}")
    uncat = [t for t in present if t not in tool2cat]
    print(f"{len(uncat):>3}  not in a CLAUDE.md tooling section (≠ orphan; see mesh-doctor)")
    print(f"{len(present):>3}  TOTAL scripts present")
elif mode == "uncat":
    uncat = [t for t in present if t not in tool2cat]
    print(f"=== {len(uncat)} tool(s) in scripts/ not in a CLAUDE.md tooling section — wired ones just need a canon line; see mesh-doctor for TRUE orphans ===")
    for t in uncat: print(line(t))
elif mode == "search":
    if not arg: print("usage: mesh-tools --search <term>"); raise SystemExit(1)
    # body_search: widen beyond name+header to catch subcommand verbs.
    # Scans two structured line classes only (low false-positive risk):
    #   (a) header comment block — all '#'-prefixed lines at the top of the file until the
    #       first non-comment/non-blank line (catches usage lines like "# mesh-act torch [...]")
    #   (b) bash case-arm lines — "verb)" or "verb1|verb2)" at line-start throughout the body
    #       (catches the literal case arm "vibrate|torch|notify|ir)" inside the case block)
    # Does NOT scan arbitrary body prose — only these two structured patterns.
    _case_arm_re = re.compile(r'^\s*[a-z][a-z0-9_-]*(?:\|[a-z][a-z0-9_-]+)*\s*\)')
    def body_search(tool, term):
        p = os.path.join(scrdir, tool)
        if not os.path.exists(p): return False
        term = term.lower()
        in_header = True
        try:
            for ln in open(p, encoding="utf-8", errors="replace"):
                s = ln.strip()
                if in_header:
                    if s and not s.startswith('#') and not s.startswith('#!'):
                        in_header = False
                    elif s.startswith('#') and term in s.lower():
                        return True
                if _case_arm_re.match(ln) and term in ln.lower():
                    return True
        except Exception: pass
        return False
    hits = [t for t in present if arg in t.lower() or arg in desc(t).lower() or body_search(t, arg)]
    print(f"=== {len(hits)} tool(s) matching '{arg}' ===")
    for t in hits: print(line(t) + (f"   [{tool2cat.get(t,'uncategorized')}]"))
elif mode == "category":
    matched = [(n, ts) for n, ts in cats if arg in n.lower()]
    if not matched:
        print(f"no category matching '{arg}'. categories:")
        for n, _ in cats: print(f"  {n}")
        raise SystemExit(1)
    for name, tools in matched:
        print(f"━━ {name} ({len(tools)}) ━━")
        for t in tools: print(line(t))
else:  # all
    for name, tools in cats:
        print(f"━━ {name} ({len(tools)}) ━━")
        for t in tools: print(line(t))
        print()
    uncat = [t for t in present if t not in tool2cat]
    if uncat:
        print(f"━━ uncategorized ({len(uncat)}) — not in a CLAUDE.md tooling section (wired ones need a canon line) ━━")
        for t in uncat: print(line(t))
PY
