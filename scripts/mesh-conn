#!/usr/bin/env bash
# mesh-conn — a node's SELF-CARE connectivity awareness. A node should take good care of itself:
# always KNOW whether it reaches the internet, Telegram (the desktop client's MTProto servers),
# and the mesh. Surfaces the state as text (like reading an app's connection indicator), so the
# mesh/operator can always tell — and posts to mesh-chat when a state CHANGES.
#
#   mesh-conn               print this node's connectivity status (one block)
#   mesh-conn --watch [s]   re-check every N sec (default 120); post to mesh-chat on CHANGE
#   mesh-conn --oneline     compact one-line status (for cards/indicators)
#   mesh-conn --test        smoke test (deps + live self-check output shape)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"   # find mesh-chat regardless of caller's PATH (cron/ssh/tmux)
TG_DC=(149.154.167.50 149.154.175.50 149.154.171.5)   # Telegram MTProto DC IPs (what the app uses)
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes"   # node registry (nodes.example) provides MESH_PEER
MESH_PEER="${MESH_PEER:-}"   # NO hardcoded IP — comes from ~/.mesh/nodes; empty = single-node (mesh-check is n/a)
STATEF="$HOME/.mesh/.conn-state"

http(){ timeout 8 curl -s -o /dev/null -w "%{http_code}" --max-time 8 "$1" 2>/dev/null; }
tcp(){ timeout 5 bash -c "echo > /dev/tcp/$1/$2" 2>/dev/null; }
ping1(){ timeout 6 ping -c1 -W3 "$1" >/dev/null 2>&1; }

check(){
  local inet tg mesh
  case "$(http https://1.1.1.1)" in 2*|3*) inet=up;; *) ping1 1.1.1.1 && inet=up || inet=DOWN;; esac
  tg=DOWN; for ip in "${TG_DC[@]}"; do tcp "$ip" 443 && { tg=up; break; }; done   # can the Telegram client connect?
  if [ -n "$MESH_PEER" ]; then ping1 "$MESH_PEER" && mesh=up || mesh=DOWN; else mesh=solo; fi
  printf '%s tg=%s inet=%s mesh=%s' "$(hostname)" "$tg" "$inet" "$mesh"
}

case "${1:-}" in
  --test)
    for dep in timeout curl bash ping hostname; do
      command -v "$dep" >/dev/null 2>&1 || { echo "smoke-test: FAIL (no $dep)"; exit 1; }
    done
    out="$(check 2>/dev/null || true)"
    printf '%s\n' "$out" | grep -qE '^[^[:space:]]+ tg=(up|DOWN) inet=(up|DOWN) mesh=(up|DOWN|solo)$' || {
      echo "smoke-test: FAIL (bad self-check output: $out)"; exit 1;
    }
    echo "smoke-test: ok"
    ;;
  --oneline) check; echo ;;
  --watch)
    iv="${2:-120}"; mkdir -p "$HOME/.mesh"
    echo "[mesh-conn] self-care watch every ${iv}s ($(hostname): tg/inet/mesh)"
    while true; do
      now="$(check)"; prev="$(cat "$STATEF" 2>/dev/null || echo)"
      if [ "$now" != "$prev" ]; then
        echo "$now" > "$STATEF"
        [ -n "$prev" ] && command -v mesh-chat >/dev/null 2>&1 && \
          MESH_WHO="conn@$(hostname)" mesh-chat "[conn] изменилось: $now (было: ${prev:-?})" >/dev/null 2>&1
        printf '%s  %s\n' "$(date -u +%H:%M:%SZ)" "$now"
      fi
      sleep "$iv"
    done ;;
  ""|--status)
    echo "=== connectivity self-care: $(hostname) ==="
    s="$(check)"; echo "  $s"
    case "$s" in *tg=DOWN*) echo "  ⚠ Telegram-клиент НЕ сможет подключиться отсюда (DC-IP недостижимы — вероятно ISP-блок; нужен VPN/прокси на этой ноде).";; *tg=up*) echo "  ✓ Telegram достижим — клиент может коннектиться.";; esac ;;
  *) echo "usage: mesh-conn [--status|--watch [s]|--oneline]" >&2; exit 1 ;;
esac
