#!/usr/bin/env bash
# mesh-conn — a node's SELF-CARE connectivity awareness. A node should take good care of itself:
# always KNOW whether it reaches the internet, Telegram (the desktop client's MTProto servers),
# and the mesh. Surfaces the state as text (like reading an app's connection indicator), so the
# mesh/operator can always tell — and posts to mesh-chat when a state CHANGES.
#
#   mesh-conn               print this node's connectivity status (one block)
#   mesh-conn --watch [s]   re-check every N sec (default 120); post to mesh-chat on CHANGE
#   mesh-conn --oneline     compact one-line status (for cards/indicators)
#   mesh-conn --test        smoke test (deps + live self-check output shape)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"   # find mesh-chat regardless of caller's PATH (cron/ssh/tmux)
TG_DC=(149.154.167.50 149.154.175.50 149.154.171.5)   # Telegram MTProto DC IPs (what the app uses)
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes"   # node registry (nodes.example) provides MESH_PEER
MESH_PEER="${MESH_PEER:-}"   # NO hardcoded IP — comes from ~/.mesh/nodes; empty = single-node (mesh-check is n/a)
STATEF="$HOME/.mesh/.conn-state"

http(){ timeout 8 curl -s -o /dev/null -w "%{http_code}" --max-time 8 "$1" 2>/dev/null; }
tcp(){ timeout 5 bash -c "echo > /dev/tcp/$1/$2" 2>/dev/null; }
ping1(){ timeout 6 ping -c1 -W3 "$1" >/dev/null 2>&1; }

# The MESH is reachable iff ANY mesh peer answers — never a single-peer probe. MESH_PEER on this
# fleet is the GL-MT3000 router (chronically tailscale-offline), so the old one-peer ping rendered
# mesh=DOWN for weeks while phaedra/ds answered fine — a false-DOWN that poisoned .selfcare-state →
# .mesh-state → situation (found 2026-07-03). Candidates: MESH_PEERS (explicit, space-separated) →
# live tailscale peer table (tagged, non-offline, self excluded, max 4) → legacy MESH_PEER fallback.
peers_from_status(){  # $1=own ip; stdin=tailscale status text → candidate peer IPs (pure, fixture-testable)
  awk -v self="$1" '$1 ~ /^100\./ && $1 != self && $3 == "tagged-devices" && $0 !~ /; offline/ {print $1; if (++n >= 4) exit}'
}
mesh_candidates(){
  if [ -n "${MESH_PEERS:-}" ]; then printf '%s\n' $MESH_PEERS; return; fi
  local got=""
  if command -v tailscale >/dev/null 2>&1; then
    got="$(tailscale status 2>/dev/null | peers_from_status "$(tailscale ip -4 2>/dev/null | head -1)")"
  fi
  if [ -n "$got" ]; then printf '%s\n' "$got"
  elif [ -n "$MESH_PEER" ]; then printf '%s\n' "$MESH_PEER"; fi
}

check(){
  local inet tg mesh cands p
  case "$(http https://1.1.1.1)" in 2*|3*) inet=up;; *) ping1 1.1.1.1 && inet=up || inet=DOWN;; esac
  tg=DOWN; for ip in "${TG_DC[@]}"; do tcp "$ip" 443 && { tg=up; break; }; done   # can the Telegram client connect?
  cands="$(mesh_candidates)"
  if [ -n "$cands" ]; then
    mesh=DOWN
    for p in $cands; do ping1 "$p" && { mesh=up; break; }; done
  else
    mesh=solo   # no peers known at all — single-node, mesh-check n/a
  fi
  printf '%s tg=%s inet=%s mesh=%s' "$(hostname)" "$tg" "$inet" "$mesh"
}

case "${1:-}" in
  --test)
    for dep in timeout curl bash ping hostname; do
      command -v "$dep" >/dev/null 2>&1 || { echo "smoke-test: FAIL (no $dep)"; exit 1; }
    done
    # peer-selection is PURE — fixture it (offline peers, non-tagged friend devices and self must
    # all be excluded; the chronically-offline router must never be the sole mesh probe again)
    # fixture IPs are synthetic (CGNAT range + TEST-NET) — never real tailnet topology (plantability)
    fix='100.64.0.1       self-node   self-node.ts.net  linux    idle; offers exit node
100.64.0.2       edge-router tagged-devices    linux    active; relay "fra"; offline, last seen 14d ago, tx 1 rx 0
100.64.0.3       peer-a      tagged-devices    linux    active; direct 203.0.113.7:41641, tx 1 rx 1
100.64.0.4       friend-dev  friend@           linux    active; relay "hel"; offline, last seen 3d ago, tx 1 rx 0
100.64.0.5       peer-b      tagged-devices    linux    active; direct 192.168.0.5:41641, tx 1 rx 1
# Health check:'
    got="$(printf '%s\n' "$fix" | peers_from_status 100.64.0.1 | tr '\n' ' ')"
    [ "$got" = "100.64.0.3 100.64.0.5 " ] || { echo "smoke-test: FAIL (peer parse: got '$got')"; exit 1; }
    got2="$(MESH_PEERS='10.0.0.1 10.0.0.2' mesh_candidates | tr '\n' ' ')"
    [ "$got2" = "10.0.0.1 10.0.0.2 " ] || { echo "smoke-test: FAIL (MESH_PEERS override: got '$got2')"; exit 1; }
    out="$(check 2>/dev/null || true)"
    printf '%s\n' "$out" | grep -qE '^[^[:space:]]+ tg=(up|DOWN) inet=(up|DOWN) mesh=(up|DOWN|solo)$' || {
      echo "smoke-test: FAIL (bad self-check output: $out)"; exit 1;
    }
    echo "smoke-test: ok (peer-parse + MESH_PEERS override + live shape: $out)"
    ;;
  --oneline) check; echo ;;
  --watch)
    iv="${2:-120}"; mkdir -p "$HOME/.mesh"
    echo "[mesh-conn] self-care watch every ${iv}s ($(hostname): tg/inet/mesh)"
    while true; do
      now="$(check)"; prev="$(cat "$STATEF" 2>/dev/null || echo)"
      if [ "$now" != "$prev" ]; then
        echo "$now" > "$STATEF"
        [ -n "$prev" ] && command -v mesh-chat >/dev/null 2>&1 && \
          MESH_WHO="conn@$(hostname)" mesh-chat "[conn] изменилось: $now (было: ${prev:-?})" >/dev/null 2>&1
        printf '%s  %s\n' "$(date -u +%H:%M:%SZ)" "$now"
      fi
      sleep "$iv"
    done ;;
  ""|--status)
    echo "=== connectivity self-care: $(hostname) ==="
    s="$(check)"; echo "  $s"
    case "$s" in *tg=DOWN*) echo "  ⚠ Telegram-клиент НЕ сможет подключиться отсюда (DC-IP недостижимы — вероятно ISP-блок; нужен VPN/прокси на этой ноде).";; *tg=up*) echo "  ✓ Telegram достижим — клиент может коннектиться.";; esac ;;
  *) echo "usage: mesh-conn [--status|--watch [s]|--oneline]" >&2; exit 1 ;;
esac
