#!/usr/bin/env bash
# mesh-skill-retrieve — floor-gated skill retrieval for ASPIRE-style continual learning.
# Matches task description against skill cards, returns top-N recently-verified skills.
# Floor-gate: only skills verified ≤30 days ago are surfaced (ASPIRE rot-prevention).
# Usage: mesh-skill-retrieve "<task description or failure context>"
# Output: Top 3 matching skills (or fewer if insufficient matches)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

SKILLS_DIR="$HOME/.mesh/knowledge/skills"
MAX_DAYS="${MESH_SKILL_MAX_DAYS:-30}"  # Floor-gate window (ASPIRE rot-prevention)
TOP_N="${MESH_SKILL_TOP_N:-3}"         # How many skills to return

query="${1:-}"
if [ -z "$query" ]; then
  echo "Usage: mesh-skill-retrieve \"<task description or failure context>\""
  exit 1
fi

if [ ! -d "$SKILLS_DIR" ]; then
  echo "No skills directory found: $SKILLS_DIR"
  exit 0
fi

# Find all skill cards
skill_cards=("$SKILLS_DIR"/*.md)
if [ ${#skill_cards[@]} -eq 0 ] || [ ! -f "${skill_cards[0]}" ]; then
  echo "No skill cards found"
  exit 0
fi

# Current date for floor-gate check
now=$(date +%s)
cutoff=$((now - MAX_DAYS * 86400))

# Score each skill card
declare -a scores
declare -a matched_skills

for skill_file in "${skill_cards[@]}"; do
  [ -f "$skill_file" ] || continue

  # Extract verification date
  verified_line=$(grep "^verified:" "$skill_file" | head -1)
  verified_date="${verified_line#verified: }"
  verified_date=$(echo "$verified_date" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')

  # Floor-gate: skip if verification is too old
  if [ -n "$verified_date" ]; then
    verified_ts=$(date -d "$verified_date" +%s 2>/dev/null || echo 0)
    if [ "$verified_ts" -lt "$cutoff" ]; then
      continue  # Skip stale skills (ASPIRE rot-prevention)
    fi
  fi

  # Read skill content for matching
  skill_content=$(cat "$skill_file")

  # Simple keyword matching score
  # Count query words that appear in symptom, diagnosis, fix, or retrieval_cue
  score=0

  # Extract query keywords (lowercase, filter common words)
  keywords=$(echo "$query" | grep -oE '[a-z]{3,}' | tr '\n' ' ')

  for keyword in $keywords; do
    # Skip very common words
    case "$keyword" in
      the|and|for|are|but|not|you|all|can|had|her|was|one|our|out|with|this|that|from)
        continue
        ;;
    esac

    # Check if keyword appears in key sections
    if echo "$skill_content" | grep -qi "$keyword"; then
      score=$((score + 1))
    fi
  done

  # Bonus points for matches in retrieval_cue section
  if echo "$skill_content" | grep -A10 "When to Retrieve" | grep -qi "$query"; then
    score=$((score + 3))
  fi

  if [ "$score" -gt 0 ]; then
    scores+=("$score")
    matched_skills+=("$skill_file")
  fi
done

# Sort by score (descending)
if [ ${#matched_skills[@]} -eq 0 ]; then
  echo "No relevant skills found (verified ≤${MAX_DAYS} days ago)"
  exit 0
fi

# Bubble sort by score (simple, good enough for small N)
n=${#matched_skills[@]}
for ((i=0; i<n; i++)); do
  for ((j=0; j<n-i-1; j++)); do
    if [ "${scores[$j]}" -lt "${scores[$((j+1))]}" ]; then
      # Swap scores
      temp="${scores[$j]}"
      scores[$j]="${scores[$((j+1))]}"
      scores[$((j+1))]="$temp"
      # Swap skills
      temp="${matched_skills[$j]}"
      matched_skills[$j]="${matched_skills[$((j+1))]}"
      matched_skills[$((j+1))]="$temp"
    fi
  done
done

# Output top-N skills
count=0
for skill_file in "${matched_skills[@]}"; do
  [ "$count" -ge "$TOP_N" ] && break

  # Extract key fields for display
  slug=$(grep "^slug:" "$skill_file" | head -1 | sed 's/slug: //;s/^[[:space:]]*//;s/[[:space:]]*$//')
  verified=$(grep "^verified:" "$skill_file" | head -1 | sed 's/verified: //;s/^[[:space:]]*//;s/[[:space:]]*$//')
  symptom=$(awk '/^## Symptom/{f=1;next} f && /^## /{exit} f && NF{print;exit}' "$skill_file" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
  retrieval=$(awk '/^## When to Retrieve/{f=1;next} f && /^## /{exit} f && NF{print;exit}' "$skill_file" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')

  echo "=== Skill: $slug (verified: $verified) ==="
  echo "Symptom: $symptom"
  if [ -n "$retrieval" ]; then
    echo "When to retrieve: $retrieval"
  fi
  echo "Full skill: $skill_file"
  echo ""

  count=$((count + 1))
done

echo "Found $count relevant skill(s) (verified ≤${MAX_DAYS} days ago)"