#!/usr/bin/env bash
# orphan-ok: on-demand thermal-regulation FUSION — an advisory lens read at the moment a mind is
#            deciding "is the heat a stable plateau or a slide toward throttle?" (shed-timing, burn
#            windows). The three inputs it folds (thermal STATE, CSD trend, DFA complexity) are each
#            already produced by mesh-therm-watch's own */5 cron; re-fusing them on a timer would
#            only duplicate that. Deliberately NOT cron-wired — the answer is only meaningful when a
#            consumer actually asks. Writes .therm-regime.state every run (mtime always fresh; no
#            change-gate → structurally cannot false-STALE, cf. mesh-burn-window).
#
# mesh-therm-regime — CROSS-SENSE FUSION: one THERMAL-REGULATORY-REGIME verdict no single lens gives.
#
# THE GAP: this node's #1 failure mode is thermal throttle, and it now carries THREE distinct thermal
# reads that STRUCTURALLY DISAGREE (pub design note 2026-07-11) and are each, alone, either blunt or
# advisory-only:
#   * STATE   (mesh-therm-watch --status): the max zone temp RIGHT NOW — ground truth, but says nothing
#             about where the trajectory is heading.
#   * TREND   (mesh-therm-watch --csd): critical-slowing-down — variance AND lag-1 autocorrelation both
#             rising = an approaching-transition PRECURSOR. Alone it cries wolf (fires on benign warm
#             oscillation), so it's unwired/advisory.
#   * COMPLEXITY (mesh-therm-watch --dfa): Lipsitz-Goldberger loss-of-complexity — α→0.5 de-regulated
#             (white), α→1.5 over-drift (Brownian), α≈1 healthy 1/f. ORTHOGONAL to CSD (it catches
#             OVER-REGULARIZATION that CSD's both-rising gate structurally misreads as healthy).
# No single one answers "is the box riding a STABLE hot plateau, actively SLIDING toward throttle, or
# quietly losing its regulatory RESERVE while the thermometer still looks fine?" This tool fuses them.
#
# THE SYNERGY (joint patterns — fire on a COMBINATION no input reaches alone, not a max-selector):
#   CRITICAL   STATE ≥ crit temp (default 95°C) OR throttling now — at/over the wall. Ground-truth override.
#   SLIDING    HOT band ∧ CSD=PRECURSOR — the precursor is CORROBORATED by being hot → a credible slide
#              toward throttle. (CSD-precursor ALONE is advisory noise; precursor ∧ hot = act soon.)
#   BRITTLE    NOT-hot ∧ CSD=PRECURSOR ∧ DFA∈{DE-REGULATED,OVER-DRIFT} — the HIDDEN regime: temp still
#              looks fine, but the regulator has BOTH lost long-range complexity AND is creeping in
#              variance = loss of adaptive reserve that neither the thermometer nor either lens alone
#              reveals. This is the richer signal the fusion exists for.
#   HOT-STABLE HOT band ∧ CSD=STABLE ∧ DFA=HEALTHY — hot but well-regulated plateau (steady load), NOT a
#              runaway. Distinguishes "busy and fine" from "sliding" — the distinction --status can't make.
#   WATCH      NOT-hot ∧ exactly ONE early-warning lens fires (CSD=PRECURSOR XOR DFA-degraded) — a single
#              soft signal; keep an eye, no action.
#   HEALTHY    NOT-hot ∧ CSD=STABLE ∧ DFA=HEALTHY — normal 1/f fractal regulation. Nothing to do.
#
# HONEST-DEGRADE ([[fusion-tools-distinguish-empty-from-failed]]): therm.log too short → CSD/DFA render
# UNKNOWN (INSUFFICIENT) and the regime is computed from what's left + flagged "(partial)"; BRITTLE
# needs BOTH lenses so it cannot fire partial. If STATE itself is unreadable we cannot certify anything
# → verdict UNKNOWN, exit 2 (never a faked HEALTHY). Every UNKNOWN axis is named in the reason line and
# the degraded= field — an unreachable input is visibly different from a genuine calm read.
#
#   mesh-therm-regime         fold → one regime verdict + reason line (exit 0; 2 if STATE unreadable)
#   mesh-therm-regime --json  machine-readable {regime, partial, state, temp, csd, dfa, degraded, reason, ts}
#   mesh-therm-regime --edge  emit ONLY on regime change (for a consumer/board; commits the new regime)
#   mesh-therm-regime --test  assert the joint rules (synthetic axis overrides) + a live read is valid
#
# Vocab contract: FIRST token after "[therm-regime] " is the regime above and appears nowhere else in
# the line (consumers grep -q 'SLIDING' etc.). Read-only, no actuators.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

M="$HOME/.mesh"
STATE="$M/.therm-regime.state"
EDGE_STATE="$M/.therm-regime.edge"
HOST="$(hostname)"
CRIT="${MESH_THERM_REGIME_CRIT:-95}"   # ≥ this max-zone temp = CRITICAL (at the wall). therm-watch HOT=88.
HOT="${MESH_THERM_REGIME_HOT:-88}"     # ≥ this = HOT band (matches mesh-therm-watch MESH_THERM_HOT default)
WARM="${MESH_THERM_REGIME_WARM:-83}"   # ≥ this = WARM (below it = COOL); matches therm-watch hysteresis floor
mkdir -p "$M" 2>/dev/null || true

# ── read the three axes (env overrides let --test inject without any live read / hardware) ──────────
# NOW: max zone temp → COOL|WARM|HOT|CRITICAL-NOW|UNKNOWN. Throttling (cpu-throttle.state) also forces CRITICAL.
# echoes "CLASS<TAB>TEMP" (TEMP empty if none/override) so the caller keeps the reading
read_now() {
  if [ -n "${MESH_THERM_REGIME_NOW:-}" ]; then printf '%s\t\n' "$MESH_THERM_REGIME_NOW"; return; fi
  local line temp thr class tf tmt now_s
  line=$(mesh-therm-watch --status 2>/dev/null | head -n1)
  temp=$(printf '%s\n' "$line" | grep -oE 'max=[0-9]+' | head -n1 | cut -d= -f2)
  # throttle axis only trusted while FRESH — a stale THROTTLING flag must not pin a false CRITICAL
  # after the box has cooled (honest-degrade: a dead throttle reflex is silently ignored, not believed)
  tf="$M/cpu-throttle.state"
  now_s="${MESH_THERM_REGIME_NOW_TS_EPOCH:-$(date +%s)}"
  tmt=$(stat -c %Y "$tf" 2>/dev/null || echo 0)
  if [ $(( now_s - tmt )) -le "${MESH_THERM_REGIME_FRESH_S:-900}" ]; then
    thr=$(head -n1 "$tf" 2>/dev/null | grep -oiw 'THROTTLING' || true)
  else
    thr=""
  fi
  if   [ -n "$thr" ];               then class="CRITICAL-NOW"
  elif [ -z "$temp" ];              then class="UNKNOWN"
  elif [ "$temp" -ge "$CRIT" ];     then class="CRITICAL-NOW"
  elif [ "$temp" -ge "$HOT"  ];     then class="HOT"
  elif [ "$temp" -ge "$WARM" ];     then class="WARM"
  else                                   class="COOL"; fi
  printf '%s\t%s\n' "$class" "$temp"
}
# CSD: STABLE|PRECURSOR|UNKNOWN (INSUFFICIENT→UNKNOWN). Verdict = first token after "): ".
read_csd() {
  if [ -n "${MESH_THERM_REGIME_CSD:-}" ]; then echo "$MESH_THERM_REGIME_CSD"; return; fi
  local v
  v=$(mesh-therm-watch --csd 2>/dev/null | head -n1 | sed -n 's/.*): \([A-Z-]*\).*/\1/p')
  case "$v" in STABLE|PRECURSOR) echo "$v";; *) echo UNKNOWN;; esac
}
# DFA: HEALTHY|DE-REGULATED|OVER-DRIFT|UNKNOWN (INSUFFICIENT→UNKNOWN).
read_dfa() {
  if [ -n "${MESH_THERM_REGIME_DFA:-}" ]; then echo "$MESH_THERM_REGIME_DFA"; return; fi
  local v
  v=$(mesh-therm-watch --dfa 2>/dev/null | head -n1 | sed -n 's/.*): \([A-Z-]*\).*/\1/p')
  case "$v" in HEALTHY|DE-REGULATED|OVER-DRIFT) echo "$v";; *) echo UNKNOWN;; esac
}

# ── the fold: three axes → one regime + reason (pure; testable via overrides) ──────────────────────
fuse() {
  local now="$1" csd="$2" dfa="$3"
  local regime reason partial="" degraded=""
  local dfa_bad=0; case "$dfa" in DE-REGULATED|OVER-DRIFT) dfa_bad=1;; esac
  [ "$csd" = UNKNOWN ] && degraded="${degraded}csd "
  [ "$dfa" = UNKNOWN ] && degraded="${degraded}dfa "
  [ -n "$degraded" ] && partial=" (partial)"

  if [ "$now" = UNKNOWN ]; then
    REGIME="UNKNOWN"; PARTIAL=" (partial)"; DEGRADED="state ${degraded}"
    REASON="thermal STATE unreadable (mesh-therm-watch --status gave no max temp) — cannot certify regulation; not a calm read"
    return 2
  fi

  if [ "$now" = "CRITICAL-NOW" ]; then
    regime="CRITICAL"
    reason="STATE at/over the wall (≥${CRIT}°C or throttling now) — shed load / cool the box now"
  elif [ "$now" = "HOT" ] && [ "$csd" = "PRECURSOR" ]; then
    regime="SLIDING"
    reason="HOT band ∧ CSD precursor (variance+AC1 rising) — a credible slide toward throttle; shed soon (precursor CORROBORATED by heat, not the usual advisory noise)"
  elif [ "$now" != "HOT" ] && [ "$now" != "CRITICAL-NOW" ] && [ "$csd" = "PRECURSOR" ] && [ "$dfa_bad" = 1 ]; then
    regime="BRITTLE"
    reason="temp still ${now} but regulator losing RESERVE: CSD precursor ∧ DFA=${dfa} (long-range complexity eroded while variance creeps) — hidden loss of adaptive margin no single lens shows"
  elif [ "$now" = "HOT" ] && [ "$csd" = "STABLE" ] && [ "$dfa" = "HEALTHY" ]; then
    regime="HOT-STABLE"
    reason="HOT but well-regulated plateau (CSD stable, DFA 1/f) — steady load, NOT a runaway; no shed needed on thermal-dynamics grounds"
  elif [ "$now" != "HOT" ] && [ "$now" != "CRITICAL-NOW" ] && { [ "$csd" = "PRECURSOR" ] || [ "$dfa_bad" = 1 ]; }; then
    regime="WATCH"
    local which; [ "$csd" = "PRECURSOR" ] && which="CSD precursor" || which="DFA=${dfa}"
    reason="temp ${now}, one early-warning lens firing (${which}); the other benign — single soft signal, keep an eye, no action"
  elif [ "$now" = "HOT" ]; then
    # hot but lenses not jointly alarming and not the clean stable case → name it honestly
    regime="HOT-STABLE"
    reason="HOT band; dynamics not jointly alarming (csd=${csd} dfa=${dfa}) — treat as a plateau unless STATE climbs"
  else
    regime="HEALTHY"
    reason="temp ${now}, CSD stable, DFA ~1/f — normal fractal thermal regulation"
  fi

  REGIME="$regime"; PARTIAL="$partial"; DEGRADED="$degraded"; REASON="$reason"
  return 0
}

# ── run ─────────────────────────────────────────────────────────────────────────────────────────
run() {
  local now csd dfa rc nowline
  nowline=$(read_now); now="${nowline%%	*}"; TEMP_SEEN="${nowline#*	}"
  csd=$(read_csd); dfa=$(read_dfa)
  fuse "$now" "$csd" "$dfa"; rc=$?
  local ts; ts="${MESH_THERM_REGIME_NOW_TS:-$(date -u +%Y-%m-%dT%H:%M:%SZ)}"
  local degtrim; degtrim="$(echo "$DEGRADED" | sed 's/ *$//')"
  local line="[therm-regime] ${HOST} ${REGIME}${PARTIAL} :: state=${now}${TEMP_SEEN:+(${TEMP_SEEN}°C)} csd=${csd} dfa=${dfa}${degtrim:+ degraded=${degtrim}} — ${REASON}"
  # state artifact every run (mtime always fresh → cannot false-STALE)
  printf '%s\t%s\t%s\t%s\t%s\n' "$REGIME" "$now" "$csd" "$dfa" "$ts" > "$STATE" 2>/dev/null || true

  if [ "${1:-}" = "--json" ]; then
    printf '{"regime":"%s","partial":%s,"state":"%s","temp":%s,"csd":"%s","dfa":"%s","degraded":"%s","reason":"%s","ts":"%s"}\n' \
      "$REGIME" "$([ -n "$PARTIAL" ] && echo true || echo false)" "$now" "${TEMP_SEEN:-null}" \
      "$csd" "$dfa" "$degtrim" "$(echo "$REASON" | sed 's/"/\\"/g')" "$ts"
  elif [ "${1:-}" = "--edge" ]; then
    local prev=""; [ -r "$EDGE_STATE" ] && prev=$(head -n1 "$EDGE_STATE" 2>/dev/null)
    if [ "$REGIME" != "$prev" ]; then
      echo "$line"
      echo "$REGIME" > "$EDGE_STATE" 2>/dev/null || true
    fi
  else
    echo "$line"
  fi
  return $rc
}

# ── tests: synthetic joint-rule assertions (no live read) + one live read must be a valid regime ──
run_test() {
  local fail=0
  chk() { if [ "$2" = "$3" ]; then echo "ok: $1"; else echo "FAIL: $1 — got '$2' want '$3'"; fail=1; fi; }
  reg() { MESH_THERM_REGIME_NOW="$1" MESH_THERM_REGIME_CSD="$2" MESH_THERM_REGIME_DFA="$3" \
          bash "$0" 2>/dev/null | sed -n 's/^\[therm-regime\] [^ ]* \([A-Z-]*\).*/\1/p'; }

  chk "critical-now overrides all"        "$(reg CRITICAL-NOW STABLE HEALTHY)"   CRITICAL
  chk "hot ∧ precursor → SLIDING"         "$(reg HOT PRECURSOR HEALTHY)"         SLIDING
  chk "cool ∧ precursor ∧ dereg → BRITTLE" "$(reg COOL PRECURSOR DE-REGULATED)"  BRITTLE
  chk "warm ∧ precursor ∧ overdrift → BRITTLE" "$(reg WARM PRECURSOR OVER-DRIFT)" BRITTLE
  chk "hot ∧ stable ∧ healthy → HOT-STABLE" "$(reg HOT STABLE HEALTHY)"          HOT-STABLE
  chk "cool ∧ precursor only → WATCH"     "$(reg COOL PRECURSOR HEALTHY)"        WATCH
  chk "warm ∧ dfa-bad only → WATCH"       "$(reg WARM STABLE DE-REGULATED)"      WATCH
  chk "cool ∧ all benign → HEALTHY"       "$(reg COOL STABLE HEALTHY)"           HEALTHY
  # honest-degrade: BRITTLE must NOT fire when a lens is UNKNOWN (needs BOTH)
  chk "cool ∧ precursor ∧ dfa UNKNOWN → WATCH not BRITTLE" "$(reg COOL PRECURSOR UNKNOWN)" WATCH
  # STATE unreadable → UNKNOWN, never a faked calm
  chk "state UNKNOWN → UNKNOWN (exit 2, not HEALTHY)" "$(reg UNKNOWN STABLE HEALTHY)" UNKNOWN
  # exit code on unreadable state
  MESH_THERM_REGIME_NOW=UNKNOWN MESH_THERM_REGIME_CSD=STABLE MESH_THERM_REGIME_DFA=HEALTHY bash "$0" >/dev/null 2>&1
  chk "state UNKNOWN exits 2" "$?" 2
  # partial flag appears when a lens is UNKNOWN
  local pj; pj=$(MESH_THERM_REGIME_NOW=COOL MESH_THERM_REGIME_CSD=UNKNOWN MESH_THERM_REGIME_DFA=HEALTHY bash "$0" --json 2>/dev/null)
  chk "unknown lens → partial:true" "$(echo "$pj" | grep -o '"partial":true' | head -n1)" '"partial":true'
  chk "unknown lens → degraded names csd" "$(echo "$pj" | grep -o '"degraded":"csd"')" '"degraded":"csd"'

  # LIVE read: must yield a valid regime token from real therm-watch reads (partial ok on a short log)
  local live; live=$(bash "$0" 2>/dev/null | sed -n 's/^\[therm-regime\] [^ ]* \([A-Z-]*\).*/\1/p')
  case "$live" in
    CRITICAL|SLIDING|BRITTLE|HOT-STABLE|WATCH|HEALTHY|UNKNOWN) echo "ok: live read → valid regime ($live)";;
    *) echo "FAIL: live read produced no valid regime (got '$live')"; fail=1;;
  esac

  [ "$fail" = 0 ] && { echo "smoke-test: ok (joint rules: CRITICAL override, SLIDING=hot∧precursor, BRITTLE=nothot∧precursor∧dfa-bad needs BOTH lenses, HOT-STABLE, WATCH=single-lens, HEALTHY; honest-degrade: UNKNOWN state→exit2 never calm, partial flag+degraded axis named; live read valid)"; exit 0; } || { echo "smoke-test: FAIL"; exit 1; }
}

case "${1:-}" in
  --test) run_test ;;
  --json) run --json ;;
  --edge) run --edge ;;
  --help|-h) sed -n '2,60p' "$0" | sed 's/^# \{0,1\}//' ; exit 0 ;;
  "" ) run ;;
  * ) echo "usage: mesh-therm-regime [--json|--edge|--test|--help]" >&2; exit 64 ;;
esac
