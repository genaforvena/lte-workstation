#!/usr/bin/env bash
# mesh-window-check — periodically verify EVERY tmux window "looks fine", automating the operator's
# manual eyeballing (2026-06-14: operator caught a vestigial mon:novelty window by hand and asked the
# mesh to watch all windows itself). Companion to mesh-mind-control (mind STATES + dispatch); this
# scans ALL windows for anomalies.
#
# Checks — kept LOW false-positive:
#   ALL windows : a DEAD pane · a BLANK pane (no content at all)
#   MIND windows: a hard-ERROR signature in the LIVE bottom lines · a blocked/dead/rate-limited mind
#                 (via mesh-mind-state). Error-text is NOT scanned on log/stream windows (they tail
#                 logs full of the word 'error' — that would false-trigger).
#
#   mesh-window-check          report every window OK|ISSUE + overall
#   mesh-window-check --edge   REFLEX: post [window-issue]/[windows-ok] to the board ONLY on a CHANGE
#   mesh-window-check --test   smoke
# Exit: 0 all fine · 1 issue(s) found.
# orphan-ok: REORG-2026-06-17 paused — its */10 cron line is commented (#REORG-2026-06-17) in
#   reflexes.cron as part of the minds-only IdeaPad re-org; deliberately unwired, not decayed. The
#   commented reflexes.cron line is the rewire reminder; re-enabling it is the operator's call, so
#   the orphan WARN should not double-count this documented pause.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/restore.env" ] && . "$HOME/.mesh/restore.env" 2>/dev/null || true
SESS="$(hostname)"; MESH="$HOME/.mesh"

if [ "${1:-}" = --test ]; then
  command -v tmux >/dev/null 2>&1 || { echo "smoke-test: FAIL (tmux not found)"; exit 1; }
  command -v mesh-mind-state >/dev/null 2>&1 || { echo "smoke-test: FAIL (mesh-mind-state missing — mind checks won't work)"; exit 1; }
  if tmux has-session -t "$SESS" 2>/dev/null; then
    wins=$(tmux list-windows -t "$SESS" -F '#{window_name}' 2>/dev/null | wc -l)
    echo "smoke-test: ok ($wins windows in session $SESS)"
  else
    echo "smoke-test: ok (no session '$SESS' — check would be a no-op; normal on fresh nodes)"
  fi
  exit 0
fi

MIND_WINS=" plan tg health verify work dev discover sense tg-roz "
# Lean-node: MESH_MIND_CHANNELS (restore.env) restricts which channels run a local mind.
# Use it as MIND_WINS so plan/tg/etc. on RAM-constrained nodes don't raise false mind-alerts.
if [ -n "${MESH_MIND_CHANNELS:-}" ]; then
  MIND_WINS=" $MESH_MIND_CHANNELS "
fi
ERR_RE='command not found|Traceback \(most recent|Segmentation fault|core dumped|panic:|FATAL|Cannot find module|No such file or directory|unexpected EOF|npm ERR'

check() { # one line per window: "WIN<TAB>OK|ISSUE<TAB>reason"; return = issue count
  local issues=0 win is_mind
  for win in $(tmux list-windows -t "$SESS" -F '#{window_name}' 2>/dev/null); do
    local wissue="" p witness_body="" witness_height=0
    case "$MIND_WINS" in *" $win "*) is_mind=1;; *) is_mind=0;; esac
    for p in $(tmux list-panes -t "$SESS:$win" -F '#{pane_index}' 2>/dev/null); do
      [ "$(tmux display -p -t "$SESS:$win.$p" '#{pane_dead}' 2>/dev/null)" = 1 ] && { wissue="dead pane $p"; break; }
      local capture body; capture="$(tmux capture-pane -t "$SESS:$win.$p" -p 2>/dev/null)"
      body="$(printf '%s\n' "$capture" | grep -v '^[[:space:]]*$')"
      [ "$win" = witness ] && [ "$p" = 0 ] && witness_body="$capture"
      if [ "$win" = witness ] && [ "$p" = 0 ]; then
        witness_height="$(tmux display-message -p -t "$SESS:$win.$p" '#{pane_height}' 2>/dev/null)"
        case "$witness_height" in ''|*[!0-9]*) witness_height=0 ;; esac
      fi
      # Blank check: pane 0 (data) must always have content; pane 1 (mind) only if this is a mind
      # channel — lean-stub panes on non-mind channels are intentionally sparse (just a bash prompt).
      [ -z "$body" ] && { [ "$p" = 0 ] || [ "$is_mind" = 1 ]; } && { wissue="blank pane $p"; break; }
      if [ "$is_mind" = 1 ]; then
        local hit; hit="$(printf '%s\n' "$body" | tail -5 | grep -oE "$ERR_RE" | head -1)"
        [ -n "$hit" ] && { wissue="error in pane $p: $hit"; break; }
      fi
    done
    if [ -z "$wissue" ] && [ "$win" = witness ]; then
      local witness_issue
      witness_issue="$(check_witness_pane "$witness_body" "$witness_height")"
      [ -n "$witness_issue" ] && wissue="witness pane $witness_issue"
    fi
    if [ -z "$wissue" ] && [ "$is_mind" = 1 ]; then
      local ms; ms="$(mesh-mind-state "$win" 2>/dev/null | head -1)"; ms="${ms%%	*}"
      case "$ms" in NEEDS-INPUT|DEAD|RATE-LIMITED) wissue="mind $ms";; esac
    fi
    if [ -n "$wissue" ]; then printf '%s\tISSUE\t%s\n' "$win" "$wissue"; issues=$((issues+1))
    else printf '%s\tOK\t\n' "$win"; fi
  done
  return $issues
}

check_witness_pane() { # validate the visible pane 0 frame, not its scrollback
  local frame="$1" pane_height="${2:-0}" journal="$MESH/tasks.journal" chatlog="$MESH/chat.log"
  local unfinished rendered_unfinished rendered_mtime current_mtime needed_rows visible_rows available_chat needed_chat visible_chat tail_frame omitted compact_cover rendered_chat rendered_total

  printf '%s\n' "$frame" | grep -qF 'WITNESS TASKS — structured unfinished work' \
    || { echo 'missing witness task heading'; return; }

  printf '%s\n' "$frame" | grep -qE 'materialized view: .* · source age=[0-9]+s · authority=' \
    || { echo 'missing labelled source age'; return; }

  [ -r "$journal" ] || { echo 'task journal unavailable'; return; }
  unfinished="$(awk -F '\t' '$1 ~ /^(BLOCKED|HELD_REJECTED|HELD_EXPIRED|OPEN_UNOWNED|QUEUED|RUNNING)$/ && NF >= 3 { n++ } END { print n+0 }' "$journal")"
  rendered_unfinished="$(printf '%s\n' "$frame" | sed -nE 's/^tasks: [0-9]+ total · ([0-9]+) unfinished · [0-9]+ rejected · [0-9]+ done$/\1/p')"
  rendered_mtime="$(printf '%s\n' "$frame" | sed -nE 's/^materialized view: .* · source age=[0-9]+s · authority=.* · mtime=([0-9]+)$/\1/p')"
  current_mtime="$(stat -c %Y "$journal" 2>/dev/null || echo 0)"
  # The panel paints counts from one journal generation while this checker reads the next. The
  # compact frame carries that generation's exact mtime, so a newer atomic materialization after
  # paint is visible as normal source churn; validate against the frame's own count in that case.
  if [ -n "$rendered_unfinished" ] && [ -n "$rendered_mtime" ] \
      && [ "$rendered_unfinished" != "$unfinished" ] && [ "$current_mtime" -gt "$rendered_mtime" ]; then
    unfinished="$rendered_unfinished"
  fi
  printf '%s\n' "$frame" | grep -qE "^tasks: [0-9]+ total · $unfinished unfinished · [0-9]+ rejected · [0-9]+ done$" \
    || { echo 'missing unfinished task count'; return; }
  visible_rows="$(printf '%s\n' "$frame" | grep -cE '^(QUEUED|RUNNING|OPEN_UNOWNED|BLOCKED|HELD_REJECTED|HELD_EXPIRED)[[:space:]]' || true)"

  [ -r "$chatlog" ] || { echo 'chat.log unavailable'; return; }
  available_chat="$(wc -l < "$chatlog")"
  if printf '%s\n' "$frame" | grep -qE '^chat\.log: showing [0-9]+/[0-9]+ raw lines \(unfiltered tail; compact\)$'; then
    [ "$pane_height" -gt 0 ] && [ "$pane_height" -le 12 ] \
      || { echo 'compact witness frame used outside a 12-row-or-smaller pane'; return; }
    needed_rows="$unfinished"; [ "$needed_rows" -gt 20 ] && needed_rows=20
    [ "$visible_rows" -ge "$needed_rows" ] \
      || { echo "only $visible_rows/$needed_rows compact unfinished task rows visible"; return; }
    if [ "$unfinished" -gt "$visible_rows" ]; then
      omitted=$((unfinished - visible_rows))
      printf '%s\n' "$frame" | grep -qF "… +$omitted more unfinished (not shown; counts above)" \
        || { echo 'compact witness frame hides unfinished task rows without an omission count'; return; }
    fi
    needed_chat="$available_chat"; [ "$needed_chat" -gt 20 ] && needed_chat=20
    compact_cover="$(printf '%s\n' "$frame" | sed -nE 's/^chat\.log: showing ([0-9]+)\/([0-9]+) raw lines \(unfiltered tail; compact\)$/\1 \2/p')"
    read -r rendered_chat rendered_total <<< "$compact_cover"
    [ "${rendered_chat:-}" = "$needed_chat" ] \
      && [ "${rendered_total:-0}" -ge "$rendered_chat" ] \
      && [ "$rendered_total" -le "$available_chat" ] \
      || { echo 'missing or stale compact raw chat.log coverage label'; return; }
  else
    [ "$pane_height" -gt 0 ] && [ "$pane_height" -le 12 ] \
      && { echo 'missing compact witness frame for 12-row-or-smaller pane'; return; }
    needed_rows="$unfinished"; [ "$needed_rows" -gt 20 ] && needed_rows=20
    [ "$visible_rows" -ge "$needed_rows" ] \
      || { echo "only $visible_rows/$needed_rows unfinished task rows visible"; return; }
    needed_chat="$available_chat"; [ "$needed_chat" -gt 20 ] && needed_chat=20
    printf '%s\n' "$frame" | grep -qE "^chat\\.log: showing $needed_chat/[0-9]+ raw lines \\(unfiltered tail\\)$" \
      || { echo 'missing unfiltered raw chat.log tail label'; return; }
  fi
  tail_frame="$(printf '%s\n' "$frame" | sed -n '/^chat\.log: showing [0-9][0-9]*\/[0-9][0-9]* raw lines (unfiltered tail[^)]*)$/,$p' | tail -n +2)"
  visible_chat="$(printf '%s\n' "$tail_frame" | grep -cE '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[^[:space:]]+[[:space:]]+[^[:space:]]+[[:space:]]+::' || true)"
  [ "$visible_chat" -ge "$needed_chat" ] \
    || { echo "only $visible_chat/$needed_chat raw chat.log tail lines visible"; return; }
}

if [ "${1:-}" = --edge ]; then
  out="$(check)"; rc=$?
  state="$MESH/.window-check.state"; verdict=ok; [ "$rc" -gt 0 ] && verdict=issue
  prev="$(cat "$state" 2>/dev/null || echo)"; printf '%s\n' "$verdict" > "$state"
  if [ "$verdict" != "$prev" ] && command -v mesh-chat >/dev/null 2>&1; then
    if [ "$verdict" = issue ]; then
      detail="$(printf '%s\n' "$out" | awk -F'\t' '$2=="ISSUE"{print $1":"$3}' | tr '\n' ' ' | cut -c1-200)"
      MESH_WHO="window-check@$SESS" mesh-chat "[window-issue] $SESS windows need a look: $detail" >/dev/null 2>&1
    else
      MESH_WHO="window-check@$SESS" mesh-chat "[windows-ok] $SESS all windows look fine again" >/dev/null 2>&1
    fi
  fi
  printf '%s\n' "$out" | awk -F'\t' '$2=="ISSUE"{print "  ISSUE "$1": "$3}'
  [ "$rc" -gt 0 ] && exit 1 || exit 0
fi

echo "=== mesh-window-check · $SESS · $(date -u +%H:%MZ) ==="
out="$(check)"; rc=$?
printf '%s\n' "$out" | awk -F'\t' '{printf "  %-10s %s%s\n", $1, ($2=="OK"?"✓ ok":"✗ ISSUE: "), $3}'
echo "  ─────"
[ "$rc" -gt 0 ] && echo "  $rc window(s) need a look" || echo "  all windows look fine"
[ "$rc" -gt 0 ] && exit 1 || exit 0
