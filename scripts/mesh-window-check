#!/usr/bin/env bash
# mesh-window-check — periodically verify EVERY tmux window "looks fine", automating the operator's
# manual eyeballing (2026-06-14: operator caught a vestigial mon:novelty window by hand and asked the
# mesh to watch all windows itself). Companion to mesh-mind-control (mind STATES + dispatch); this
# scans ALL windows for anomalies.
#
# Checks — kept LOW false-positive:
#   ALL windows : a DEAD pane · a BLANK pane (no content at all)
#   MIND windows: a hard-ERROR signature in the LIVE bottom lines · a blocked/dead/rate-limited mind
#                 (via mesh-mind-state). Error-text is NOT scanned on log/stream windows (they tail
#                 logs full of the word 'error' — that would false-trigger).
#
#   mesh-window-check          report every window OK|ISSUE + overall
#   mesh-window-check --edge   REFLEX: post [window-issue]/[windows-ok] to the board ONLY on a CHANGE
#   mesh-window-check --test   smoke
# Exit: 0 all fine · 1 issue(s) found.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
SESS="$(hostname)"; MESH="$HOME/.mesh"

[ "${1:-}" = --test ] && { tmux has-session -t "$SESS" 2>/dev/null && echo "smoke-test: ok" || echo "smoke-test: ok (no session here)"; exit 0; }

MIND_WINS=" plan tg health verify work dev discover sense tg-roz "
ERR_RE='command not found|Traceback \(most recent|Segmentation fault|core dumped|panic:|FATAL|Cannot find module|No such file or directory|unexpected EOF|npm ERR'

check() { # one line per window: "WIN<TAB>OK|ISSUE<TAB>reason"; return = issue count
  local issues=0 win is_mind
  for win in $(tmux list-windows -t "$SESS" -F '#{window_name}' 2>/dev/null); do
    local wissue="" p
    case "$MIND_WINS" in *" $win "*) is_mind=1;; *) is_mind=0;; esac
    for p in $(tmux list-panes -t "$SESS:$win" -F '#{pane_index}' 2>/dev/null); do
      [ "$(tmux display -p -t "$SESS:$win.$p" '#{pane_dead}' 2>/dev/null)" = 1 ] && { wissue="dead pane $p"; break; }
      local body; body="$(tmux capture-pane -t "$SESS:$win.$p" -p 2>/dev/null | grep -v '^[[:space:]]*$')"
      [ -z "$body" ] && { wissue="blank pane $p"; break; }
      if [ "$is_mind" = 1 ]; then
        local hit; hit="$(printf '%s\n' "$body" | tail -5 | grep -oE "$ERR_RE" | head -1)"
        [ -n "$hit" ] && { wissue="error in pane $p: $hit"; break; }
      fi
    done
    if [ -z "$wissue" ] && [ "$is_mind" = 1 ]; then
      local ms; ms="$(mesh-mind-state "$win" 2>/dev/null | head -1)"; ms="${ms%%	*}"
      case "$ms" in NEEDS-INPUT|DEAD|RATE-LIMITED) wissue="mind $ms";; esac
    fi
    if [ -n "$wissue" ]; then printf '%s\tISSUE\t%s\n' "$win" "$wissue"; issues=$((issues+1))
    else printf '%s\tOK\t\n' "$win"; fi
  done
  return $issues
}

if [ "${1:-}" = --edge ]; then
  out="$(check)"; rc=$?
  state="$MESH/.window-check.state"; verdict=ok; [ "$rc" -gt 0 ] && verdict=issue
  prev="$(cat "$state" 2>/dev/null || echo)"; printf '%s\n' "$verdict" > "$state"
  if [ "$verdict" != "$prev" ] && command -v mesh-chat >/dev/null 2>&1; then
    if [ "$verdict" = issue ]; then
      detail="$(printf '%s\n' "$out" | awk -F'\t' '$2=="ISSUE"{print $1":"$3}' | tr '\n' ' ' | cut -c1-200)"
      MESH_WHO="window-check@$SESS" mesh-chat "[window-issue] $SESS windows need a look: $detail" >/dev/null 2>&1
    else
      MESH_WHO="window-check@$SESS" mesh-chat "[windows-ok] $SESS all windows look fine again" >/dev/null 2>&1
    fi
  fi
  printf '%s\n' "$out" | awk -F'\t' '$2=="ISSUE"{print "  ISSUE "$1": "$3}'
  [ "$rc" -gt 0 ] && exit 1 || exit 0
fi

echo "=== mesh-window-check · $SESS · $(date -u +%H:%MZ) ==="
out="$(check)"; rc=$?
printf '%s\n' "$out" | awk -F'\t' '{printf "  %-10s %s%s\n", $1, ($2=="OK"?"✓ ok":"✗ ISSUE: "), $3}'
echo "  ─────"
[ "$rc" -gt 0 ] && echo "  $rc window(s) need a look" || echo "  all windows look fine"
[ "$rc" -gt 0 ] && exit 1 || exit 0
