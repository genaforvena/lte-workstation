#!/usr/bin/env bash
# orphan-ok: on-demand check tool, pulled by hand/doctor, never cron-wired
# mesh-board-lint — deterministic board-shape lint gate for ~/.mesh/chat.log.
#
# Reads board lines (file args, stdin, or $MESH_DIR/chat.log) and fails on
# malformed shapes. Body = text after the "  ::  " board separator.
#
#   mesh-board-lint [file ...] [--open slugs-file] [--windows FILE]
#   mesh-board-lint --test
#
# Rules:
#   TAKING  [taking] with no resolvable open [task] slug reference
#   OWNER   owner: with a bare tool name (no slash, not a known window)
#   IDLE    [idle] spanning more than 1 line
#   VERIFY  [verify] that is self-settled (result words in the same post)
#
# Exit: 0 all-clean · 1 violation found · 2 usage error.
set -uo pipefail
BUILTIN_WINDOWS="minds genome tg senses health witness cleaner discover sound adint tg-roz pub haunt vpn job hire wake"
WINDOWS="$BUILTIN_WINDOWS"
OPEN_FILE=""

usage(){ sed -n '2,/^[^#]/p' "$0" | sed -n 's/^# \?//p'; }
is_window(){ local w="$1" x; for x in $WINDOWS; do [ "$x" = "$w" ] && return 0; done; return 1; }

# Collect open [task] slugs from a board source into OPEN_SLUGS (newline list).
collect_tasks(){
  awk '{ i=index($0,"  ::  "); if(!i)next; b=substr($0,i+6); if(b~/^\[task\] /){t=substr(b,8); c=index(t,":"); if(c)t=substr(t,1,c-1); a=index(t,"→"); if(a){r=substr(t,a+3); sub(/^ +/,"",r); if(r~/^owner/)t=substr(t,1,a-1)} a=index(t,"->"); if(a){r=substr(t,a+2); sub(/^ +/,"",r); if(r~/^owner/)t=substr(t,1,a-1)} sub(/^ +/,"",t); sub(/ +$/,"",t); if(t!="")print t} }' "$1" 2>/dev/null | sort -u
}

lint_stream(){
  local src="$1" fails=0 ln body rest slug owner_val w1 w2
  # Build open-slug set: explicit --open file, else [task] lines in same source.
  local open_slugs=""
  if [ -n "$OPEN_FILE" ]; then
    open_slugs="$(cat "$OPEN_FILE" 2>/dev/null || true)"
  else
    open_slugs="$(collect_tasks "$src")"
  fi
  while IFS= read -r ln || [ -n "$ln" ]; do
    # Continuation line (no stamp, no " :: "): previous post spanned lines.
    case "$ln" in *"  ::  "*) :;; *)
      [ -n "$ln" ] && { echo "IDLE multiline: $ln"; fails=$((fails+1)); }
      continue ;;
    esac
    body="${ln#*  ::  }"
    case "$body" in
      '[taking] '*)
        rest="${body#\[taking\] }"; slug=""
        case "$rest" in *:*)
          after="${rest#*:}"; after="${after#"${after%%[! ]*}"}"
          slug="${after%% *}"; slug="${slug%:}"
          ;;
        esac
        hit=0
        if [ -n "$slug" ]; then
          while IFS= read -r s || [ -n "$s" ]; do [ -n "$s" ] && [ "$s" = "$slug" ] && hit=1; done <<<"$open_slugs"
        fi
        if [ "$hit" != 1 ]; then echo "TAKING no-open-task: $ln"; fails=$((fails+1)); fi
        # A [taking] line only carries an owner check when it names one.
        case "$body" in *'owner:'*) :;; *) continue;; esac
        ;&
      *'owner:'*)
        owner_val="${body#*owner:}"; owner_val="${owner_val#"${owner_val%%[! ]*}"}"
        owner_val="${owner_val%% *}"; owner_val="${owner_val%%,*}"; owner_val="${owner_val%%;*}"
        case "$owner_val" in
          */*) w1="${owner_val%%/*}"; w2="${owner_val#*/}"; w2="${w2%%/*}"
            is_window "$w2" || { echo "OWNER unknown-window: $ln"; fails=$((fails+1)); } ;;
          *)
            is_window "$owner_val" || { echo "OWNER bare-tool-name: $ln"; fails=$((fails+1)); } ;;
        esac
        ;;
      '[idle] '*)
        # Multiline: literal \n inside the post or an actual embedded newline already
        # split by read — the latter arrives as a continuation line without a stamp.
        case "$body" in *'\\n'*|*$'\n'*) echo "IDLE multiline: $ln"; fails=$((fails+1));; esac
        ;;
      '[verify] '*)
        case "$body" in
          *[Vv]erified*|*[Dd]one*|*[Ff]ixed*|*checked-green*|*checked\ green*|*[Cc]hecked\ green*)
            echo "VERIFY self-settled: $ln"; fails=$((fails+1)) ;;
        esac
        ;;
    esac
  done < "$src"
  return "$([ "$fails" = 0 ] && echo 0 || echo 1)"
}

if [ "${1:-}" = --test ]; then
  d="$(mktemp -d)"; trap 'rm -rf "$d"' EXIT
  pass=0; fail=0
  ok(){ pass=$((pass+1)); }; bad(){ echo "FAIL: $1"; fail=$((fail+1)); }
  run(){ MESH_MIND_CHANNELS= "$0" "$@" 2>&1; echo "rc=$?"; }
  # 1. bad taking (slug with no open task) must FAIL naming the line
  printf '2026-09-16T00:00:01Z  m@h  ::  [task] tool-a/real-thing: work owner: tool-a/genome\n2026-09-16T00:00:02Z  m@h  ::  [taking] genome: tool-b/ghost-slug\n' > "$d/b1.log"
  out="$("$0" "$d/b1.log" 2>&1)"; rc=$?
  { [ "$rc" = 1 ] && grep -q 'TAKING.*ghost-slug' <<<"$out"; } && ok || bad "bad taking must FAIL rc=1 naming line (rc=$rc: $out)"
  # 1b. good taking passes
  printf '2026-09-16T00:00:01Z  m@h  ::  [task] tool-a/real-thing: work owner: tool-a/genome\n2026-09-16T00:00:02Z  m@h  ::  [taking] genome: tool-a/real-thing\n' > "$d/g1.log"
  "$0" "$d/g1.log" >/dev/null 2>&1; [ $? = 0 ] && ok || bad "good taking must PASS"
  # 1c. --open file supplies slugs
  printf 'tool-a/real-thing\n' > "$d/open.txt"
  printf '2026-09-16T00:00:02Z  m@h  ::  [taking] genome: tool-a/real-thing\n' > "$d/g1b.log"
  "$0" --open "$d/open.txt" "$d/g1b.log" >/dev/null 2>&1; [ $? = 0 ] && ok || bad "--open file must resolve slug"
  # 2. bare tool owner fails; tool/window and bare window pass
  printf '2026-09-16T00:00:01Z  m@h  ::  [task] fix thing owner: mesh-land\n' > "$d/b2.log"
  out="$("$0" "$d/b2.log" 2>&1)"; rc=$?
  { [ "$rc" = 1 ] && grep -q 'OWNER bare-tool-name' <<<"$out"; } && ok || bad "bare owner must FAIL (rc=$rc: $out)"
  printf '2026-09-16T00:00:01Z  m@h  ::  [task] fix thing owner: mesh-land/genome\n2026-09-16T00:00:02Z  m@h  ::  [task] other thing owner: genome\n' > "$d/g2.log"
  "$0" "$d/g2.log" >/dev/null 2>&1; [ $? = 0 ] && ok || bad "tool/window + bare window owners must PASS"
  # 3. multiline idle fails (continuation line without stamp); single-line passes
  printf '2026-09-16T00:00:01Z  m@h  ::  [idle] nothing new\nsecond line with no stamp\n' > "$d/b3.log"
  out="$("$0" "$d/b3.log" 2>&1)"; rc=$?
  { [ "$rc" = 1 ] && grep -q 'IDLE multiline' <<<"$out"; } && ok || bad "multiline idle must FAIL (rc=$rc: $out)"
  printf '2026-09-16T00:00:01Z  m@h  ::  [idle] nothing new — area swept, green\n' > "$d/g3.log"
  "$0" "$d/g3.log" >/dev/null 2>&1; [ $? = 0 ] && ok || bad "single-line idle must PASS"
  # 4. self-settled verify fails; open verify passes
  printf '2026-09-16T00:00:01Z  m@h  ::  [verify] someone: verified, all green, fixed\n' > "$d/b4.log"
  out="$("$0" "$d/b4.log" 2>&1)"; rc=$?
  { [ "$rc" = 1 ] && grep -q 'VERIFY self-settled' <<<"$out"; } && ok || bad "self-settled verify must FAIL (rc=$rc: $out)"
  printf '2026-09-16T00:00:01Z  m@h  ::  [verify] senses: please confirm the dongle count\n' > "$d/g4.log"
  "$0" "$d/g4.log" >/dev/null 2>&1; [ $? = 0 ] && ok || bad "open verify must PASS"
  # stdin + usage arms
  "$0" < "$d/g3.log" >/dev/null 2>&1; [ $? = 0 ] && ok || bad "stdin clean must PASS"
  "$0" --bogus-flag >/dev/null 2>&1; [ $? = 2 ] && ok || bad "bad flag must rc=2"
  echo "mesh-board-lint --test: $pass passed, $fail failed"
  [ "$fail" = 0 ]; exit $?
fi

# MESH_MIND_CHANNELS="a,b c" overrides builtin window list
if [ -n "${MESH_MIND_CHANNELS:-}" ]; then
  WINDOWS="$(tr ',:' '  ' <<<"$MESH_MIND_CHANNELS")"
fi
SRC="/dev/stdin"; TMP=""
FILES=()
while [ $# -gt 0 ]; do
  case "$1" in
    --open) [ -n "${2:-}" ] || { echo "usage: mesh-board-lint [file ...] [--open slugs-file] [--windows FILE]" >&2; exit 2; }; OPEN_FILE="$2"; shift 2;;
    --windows) [ -r "${2:-}" ] || { echo "mesh-board-lint: unreadable --windows file: ${2:-}" >&2; exit 2; }; WINDOWS="$(tr ',:\n' '   ' < "$2")"; shift 2;;
    -h|--help) usage; exit 0;;
    --*) echo "mesh-board-lint: unknown flag $1" >&2; exit 2;;
    *) FILES+=("$1"); shift;;
  esac
done
if [ -n "${MESH_DIR:-}" ] && [ ${#FILES[@]} = 0 ]; then :; fi
overall=0
if [ ${#FILES[@]} = 0 ]; then
  if [ -t 0 ]; then
    SRC="${MESH_DIR:-$HOME/.mesh}/chat.log"
    [ -r "$SRC" ] || { echo "mesh-board-lint: n/a — no board at $SRC" >&2; exit 2; }
  else SRC="/dev/stdin"; fi
  lint_stream "$SRC" || overall=1
else
  for f in "${FILES[@]}"; do
    [ -r "$f" ] || { echo "mesh-board-lint: unreadable file: $f" >&2; exit 2; }
    lint_stream "$f" || overall=1
  done
fi
[ "$overall" = 0 ] && echo "board-lint: clean"
exit "$overall"
