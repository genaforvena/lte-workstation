#!/usr/bin/env bash
# reflex-cadence: 9,39 * * * *
# Wired 2026-06-24 to keep the senses dash's BLE 2-vantage space-map (ble-spacemap.state) fresh.
# GENTLE twice-hourly cadence on purpose: a one-shot run does a local BLE scan + an SSH-triggered scan
# on the peer (ds) — ~30-60s of radio/SSH — so it must not run per dash-frame. Offset (9,39) to avoid
# clustering with the wifi-crossval reflex. Default one-shot writes the state; --test is sandboxed
# (sampled/mock data, no real scan or SSH), so autowire fires no side-effects.
# mesh-presence-fuse — cross-node BLE proximity fusion
# smoke-test: --test checks mesh-presence available
# Collect BLE presence from self + peer, find overlapping devices,
# compare RSSI → determine which node each device is closest to.
#
# Usage:
#   mesh-presence-fuse [peer-host] [peer-user]           one-shot fusion scan
#   mesh-presence-fuse --stream [seconds] [peer] [user]  continuous loop + track
#   mesh-presence-fuse --track <mac|name> [...]           feed mind on ZONE CHANGE
#   mesh-presence-fuse --test                            smoke test
#   Default peer: set via MESH_PEER in ~/.mesh/nodes or pass as args
#
# --stream: runs forever, scanning every N seconds (default 60).
#   With --track: detects when a tracked device switches which node it's closest to
#   (zonal localization edge) and posts the edge to the board via mesh-chat.
#
# ── MAXWAIT: A CONSISTENT CUT NEEDS A TIME AXIS, NOT ONLY COMPLETENESS (LITERATURE 2026-08-20) ──
# check_tracked_zones already carries the right sentence — "A missing peer is not a movement event.
# Require both observations before changing zonal state, otherwise peer loss can fabricate MOVED/GONE
# edges" — and it is a COMPLETENESS predicate with no clock in it. SCAN_COMPLETE asks *did both arms
# produce a sample*, never *were the two samples of the same instant*. But scan_both is SEQUENTIAL:
# the local BLE window runs, THEN the peer window runs over SSH, so the two vantages are sampled
# ~26-45s apart on a healthy cycle and 70-160s apart whenever either arm takes its retry-once
# (MESH_FUSE_RETRY_DELAY_S 25 + a whole failed scan_to). closest_node then compares self_rssi against
# peer_rssi as if they were simultaneous. A person walking across the flat inside that gap is not
# merely noisy — they are localized to whichever vantage happened to sample them nearer, so the
# SKEW ITSELF FABRICATES the MOVED/ARRIVED edge the completeness gate above exists to prevent. Same
# fabrication, different cause; the existing gate is structurally blind to it.
#
# The live literature names exactly this and gives it a knob. MAXWAIT (Lee/Lohstroh/Menard et al.,
# "Maxwait: A Generalized Mechanism for Distributed Time-Sensitive Systems", arXiv:2601.21146, Jan
# 2026, §III + §IV-F) makes the availability/consistency tradeoff an EXPLICIT PER-CONSUMER PARAMETER
# with THREE outcomes where we have two. A federate may advance its tag to t when (1a) all input
# ports are known up to and including t — a consistent cut — OR (1b) the physical clock passes
# t + maxwait, i.e. proceed WITHOUT knowing. An input that then turns up bearing a tag earlier than
# the tag already advanced past is "tardy", a safe-to-process violation, and it is a FIRST-CLASS
# EVENT with its own handler (`reaction(...) {= ... =} tardy {= ... =}`). The paper's own note is
# that a CRDT is precisely `@maxwait(0)`: process whatever arrived, whenever it arrived — which is
# sound for a join-semilattice (order-independent) and UNSOUND the moment a consumer compares two
# replicas' values to derive a verdict, because a comparison is not a join.
#
# That is our shape exactly. BLE membership IS join-shaped: "device X was in range" is monotone and
# skew-tolerant, so the overlap/unique COLUMNS stay valid at any skew. The zone verdict is NOT: it
# is a comparison across two vantages and it needs a cut. So this tool gains the missing axis, not a
# new sense: scan_both stamps each arm's FINAL (post-retry) attempt with its own epoch, and
# `skew_verdict` renders ok/skew/na against MESH_FUSE_MAXSKEW_S. The default is DERIVED, not
# invented — scan_to (= scan_win + 35), the existing wedge-bound — because a non-retried cycle is
# bounded by scan_to BY CONSTRUCTION while any retried arm adds >= retry_delay + a whole failed
# scan_to, so the bound separates the healthy path from the retried one with no new constant. The
# measured skew is written into presence-fusion.log every cycle so the knob is CALIBRATED against
# the real corpus rather than defended in prose.
#
# What changes behaviourally is deliberately narrow: on skew the membership columns still print, the
# 'Closest' column prints under a banner saying it is not a cut, person-zone renders UNKNOWN, and
# check_tracked_zones RETAINS state and fires NO edge — the same discipline the INCOMPLETE branch
# already applies, now for the second way a cross-vantage comparison can be invalid. A real move
# during a skewed cycle is deferred, not lost: state is retained, so the next clean cycle fires it.
# This is a maxwait bound WITHOUT a tardy handler: we cannot re-tag a BLE scan after the fact, so the
# only honest option at the bound is to refuse the comparison rather than publish an unmarked guess.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"

SELF="$(hostname)"
MESH="$HOME/.mesh"; mkdir -p "$MESH"
STATE="$MESH/presence-fuse.state"
BEAT="$MESH/mesh-presence-fuse.beat"
# Why the peer scan failed (set by scan_both, read by the INCOMPLETE branches). Distinguishing
# SSH-unreachable from peer-reachable-but-mesh-presence-missing matters: they have DIFFERENT fixes
# ("check SSH" vs "deploy mesh-presence to the peer"). Default "" = no failure / not yet scanned.
PEER_FAIL_REASON=""
# MAXWAIT state (see header). Epoch of the FINAL (post-retry) sampling attempt of each arm, "" when
# that arm produced no sample at all — an unsampled arm has no time, and a fabricated one would make
# the skew read 0 (perfectly simultaneous) on exactly the cycles that are least trustworthy.
SCAN_LOCAL_EPOCH=""; SCAN_PEER_EPOCH=""; SCAN_SKEW_S=""; SCAN_MAXSKEW_S=""
# The zonal narration log. Named through a variable so --test can drive the REAL functions against a
# throwaway file: a dry-run that appends to the durable log forges the liveness evidence a reader
# uses to believe the reflex ran (mesh-guardian, 09f7914).
FUSELOG="${MESH_FUSE_LOG:-$HOME/.mesh/presence-fuse.log}"
SSH_OPTS="-o BatchMode=yes -o ConnectTimeout=5 -o StrictHostKeyChecking=accept-new"
# Default peer: resolve the BLE-fusion peer from the registry so a NO-ARG run (the */31 cron)
# targets the real peer instead of an empty host (DEFAULT_HOST="" → ssh user@ → permanent
# "PEER SCAN INCOMPLETE" hollow fusion, 2026-06-13). Mirrors mesh-presence-fuse-stream's
# MESH_FUSE_PEER/MESH_FUSE_LABEL convention. NOT MESH_PEER — that resolves to the router (no BLE).
# Positional args still override (parsed below).
# SOURCE ~/.mesh/nodes (2026-07-07): the header has always DOCUMENTED nodes as the config surface
# ("set MESH_FUSE_PEER/MESH_FUSE_LABEL in ~/.mesh/nodes") but nothing ever sourced it — the tool
# only worked where the hardcoded default label resolves (IdeaPad). On ds every cron cycle logged
# "no peer configured/resolved" (hollow since wiring). Invocation env still WINS over the file.
_env_fp="${MESH_FUSE_PEER:-}"; _env_fl="${MESH_FUSE_LABEL:-}"
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes" 2>/dev/null || true
MESH_FUSE_PEER="${_env_fp:-${MESH_FUSE_PEER:-}}"; MESH_FUSE_LABEL="${_env_fl:-${MESH_FUSE_LABEL:-}}"
DEFAULT_HOST="${MESH_FUSE_PEER:-$(mesh-peer-addr "${MESH_FUSE_LABEL:-default-string}" 2>/dev/null || true)}"
DEFAULT_USER="${MESH_PEER_USER:-imozerov}"

MODE=oneshot; INTERVAL=60; TRACK=()
PEER_HOST="$DEFAULT_HOST"; PEER_USER="$DEFAULT_USER"

# scan_sampled: classify a presence scan by HEADER CONTENT, not exit code
#   mesh-presence exits 1 on a SUCCESSFUL 0-device scan (empty room).
#   Gating "did a scan run" on exit code misclassifies empty rooms as failures.
#   Returns 0 = valid sample (incl. 0 devices), 1 = not a sample.
scan_sampled() {
  case "$1" in
    *"=== mesh-presence"*) ;;            # has a result header → a scan actually ran
    *) return 1;;                         # no header (error/timeout/unreachable)
  esac
  case "$1" in *BUSY*|*SUSPECT*) return 1;; esac  # scan-locked (BUSY) or race-cleared (SUSPECT) →
                                                  # could not sample; NEVER a confident empty room.
                                                  # SUSPECT = mesh-presence's n=0 honest-degraded path
                                                  # (known devices, 0 fresh RSSI); treating it as an
                                                  # empty sample is the exact false-empty we refuse.
  return 0
}

# classify_peer_fail: name WHY cross-node fusion is incomplete (""=complete). PURE + testable.
# The rc 255 (SSH layer down) vs rc 127 (remote "command not found" → mesh-presence missing on the
# peer) distinction is the honesty fix — they are DIFFERENT operator fixes and must not both read
# as "could not reach / check SSH". ssh passes the remote command's exit code through on a live
# connection, so rc alone separates them.
# The SAME honesty rule binds the LOCAL arm (2026-07-16). The old single message blamed
# "bluetoothctl/D-Bus" for EVERY non-sample, but scan_sampled rejects a scan for three causes with
# three different fixes: BUSY/SUSPECT (rc 3 — adapter scan-locked by another local scanner, or an
# RSSI-cache race: transient CONTENTION, the sense is alive), rc 124 (the outer timeout fired — a
# genuinely wedged adapter / D-Bus stall), and rc 2 (no bluetoothctl / adapter unpowered — the only
# case the old message actually described). Proven 2026-07-16 by holding presence.scan.lock while
# the adapter was Powered:yes before AND after: fusion emitted the verbatim production line
# "LOCAL BLE scan on mesh-home failed (bluetoothctl/D-Bus)" against a HEALTHY stack. That message is
# why the recurring :49 local-zero cycles (19/31 since the */10 mesh-presence autowire, vs ~1/31 at
# :09/:19/:39) could not be diagnosed from the log at all — it sent every reader hunting a dead
# radio. Same defect class as the rc255-vs-rc127 collapse above, and the same asymmetry as the
# peer-only retry in scan_both: a cause the tool cannot name is a cause nobody can fix.
# peer_online <ip>: is the peer live on the tailnet? prints 1 (online) / 0 (offline) / "" (unknown —
# tailscale absent, or a non-tailnet/LAN peer not in the peer list). Lets classify_peer_fail tell a
# RETIRED/down node (a claim about the NODE) apart from a reachable-but-SSH-broken one. Empty = unknown
# → callers keep the SSH-blame message; we never fabricate "retired" from a missing tailscale.
peer_online() {
  local ip="$1" out
  [ -n "$ip" ] || { echo ""; return; }
  command -v tailscale >/dev/null 2>&1 || { echo ""; return; }
  out="$(tailscale status --json 2>/dev/null)" || { echo ""; return; }
  [ -n "$out" ] || { echo ""; return; }
  printf '%s' "$out" | PEER_IP="$ip" python3 -c '
import json,sys,os
ip=os.environ["PEER_IP"]
try: d=json.load(sys.stdin)
except Exception: print(""); sys.exit()
for p in (d.get("Peer") or {}).values():
    if ip in (p.get("TailscaleIPs") or []):
        print("1" if p.get("Online") else "0"); sys.exit()
print("")
' 2>/dev/null
}

# no_peer_configured_reason: the STRUCTURAL n/a message for when NO second BLE vantage is even
# configured — PEER_HOST is empty or the non-resolving sentinel 'none' (~/.mesh/nodes sets
# MESH_FUSE_PEER/LABEL='none' deliberately so `:-` defaults don't fall through to the retired
# ideapad/default-string). ssh to a host named 'none' fails rc=255 and peer_online('none') never
# matches a TailscaleIP → ponline="" → classify_peer_fail's rc255 arm fell to "fix: SSH reachability"
# — the EXACT false-SSH-blame the 2026-07-18 rc255+offline split fixed for a RETIRED *label*,
# reintroduced by the sentinel *value* (2026-07-28 live artifact: ble-spacemap.state read "SSH to
# imozerov@none FAILED … fix: SSH reachability"). Same shape (no live second node; STRUCTURAL, not an
# SSH bug), so it reads the same STRUCTURAL way. Kept OUT of classify_peer_fail so that function stays
# a pure rc→verdict map independent of the global PEER_HOST (which --test can't help but inherit).
no_peer_configured_reason() {
  echo "no second BLE vantage is CONFIGURED (MESH_FUSE_PEER/LABEL = sentinel 'none' or empty in ~/.mesh/nodes) — cross-vantage BLE is STRUCTURALLY n/a: repoint MESH_FUSE_LABEL to a live BLE node or accept n/a (the local column below is still real)"
}

classify_peer_fail() {  # <local_ok 0|1> <peer_ok 0|1> <peer_rc> [local_rc] [peer_online 1|0|"" ] [local_radio 1|0|"" ]
  # local_radio (6th arg) tells rc=2 (which mesh-presence uses for BOTH absent-stack and
  # structural-no-adapter) apart: 1 = a BT radio EXISTS locally (present-but-unpowered → REPAIRABLE),
  # 0 = NO radio on this node (bluetoothctl installed but no adapter behind it → STRUCTURAL n/a,
  # nothing to fix). "" = unknown → keep the original repair-directed message; never fabricate a
  # structural claim from an unmeasured query. scan_both derives it via `mesh-presence --has-radio`.
  local lok="$1" pok="$2" prc="$3" lrc="${4:-0}" ponline="${5:-}" lradio="${6:-}"
  [ "$lok" = 1 ] && [ "$pok" = 1 ] && { echo ""; return; }
  [ "$lok" != 1 ] && {
    case "$lrc" in
      3)   echo "LOCAL BLE scan on ${SELF} was SCAN-LOCKED/degraded (BUSY or SUSPECT) and stayed so after a retry — another local BLE scanner held the adapter; the sense is ALIVE — fix: stagger the local BLE scanners, NOT the radio" ;;
      124) echo "LOCAL BLE scan on ${SELF} TIMED OUT — adapter wedged (bluetoothctl/D-Bus stall) — fix: the local BT stack" ;;
      2)   # rc 2 from mesh-presence means the LOCAL BLE sense produced no read. It covers TWO
           # opposite situations with opposite remedies, and the old single line pointed both at
           # "fix: the local BT stack": (a) a radio EXISTS but is unpowered/broken → repairable, and
           # (b) NO radio exists on this node at all (combo-chip dongle removed while the bluetoothctl
           # package stayed — mesh-home 2026-08-30) → structural n/a; there is nothing to power or fix,
           # and telling the reader to repair a missing radio is the same hollow-FAIL bug the presence
           # smoke already split. scan_both measures which via `mesh-presence --has-radio`; lradio=""
           # (query failed/unmeasured) keeps the historical repair-directed line — honest default,
           # never a fabricated structural claim.
           if [ "$lradio" = 0 ]; then
             echo "LOCAL BLE sense on ${SELF} is STRUCTURALLY n/a — no BT adapter on this node (bluetoothctl is present but there is no radio behind it): nothing to power or fix — repoint MESH_FUSE_LABEL / drop BLE duties, or accept n/a"
           else
             echo "LOCAL BLE sense on ${SELF} is UNREACHABLE (no bluetoothctl / adapter not powered) — fix: the local BT stack"
           fi ;;
      *)   echo "LOCAL BLE scan on ${SELF} produced no usable artifact (rc=$lrc) — not a peer problem" ;;
    esac
    return
  }
  case "$prc" in
    255)
      # rc 255 = the SSH layer never established. "fix: SSH reachability" implies the node is UP and
      # only its SSH/auth is broken — but if the peer is OFFLINE on the tailnet (down or RETIRED, e.g.
      # the fuse label still points at a decommissioned node), the reader is sent to chase an SSH bug
      # that does not exist while the true cause is "there is no live second BLE vantage". Split on the
      # peer's tailnet presence: a claim about the NODE (offline) vs a claim about SSH (reachable-but-
      # failed). ponline="" (unknown / non-tailnet peer) keeps the original message — never over-claim
      # retired. (2026-07-18: MESH_FUSE_LABEL=default-string, a retired node → permanent "fix: SSH".)
      if [ "$ponline" = 0 ]; then
        echo "peer ${PEER_USER}@${PEER_HOST} is OFFLINE on the tailnet (down or RETIRED) — the BLE cross-vantage has NO live second node; this is STRUCTURAL, not an SSH bug: repoint MESH_FUSE_LABEL to a live BLE node or accept n/a"
      else
        echo "SSH to ${PEER_USER}@${PEER_HOST} FAILED (host down / auth / network) — fix: SSH reachability"
      fi ;;
    127) echo "peer ${PEER_USER}@${PEER_HOST} is SSH-reachable but mesh-presence is NOT installed there — fix: deploy mesh-presence to the peer" ;;
    *)   echo "peer scan returned no usable artifact (BUSY/SUSPECT/empty — adapter scan-locked or no fresh RSSI), rc=$prc" ;;
  esac
}

# --- dev_class: person-vs-appliance attribution for a device, via the mesh-presence classifier
# (SINGLE SOURCE — never re-implement the pattern lists here, or this fusion would drift from the
# presence sense's vocab; cross-sense-vocab contract). This is the cross-sense step: zonal proximity
# (Closest) × device CLASS → a person-AWARE space map ("a PERSONAL device is near IdeaPad" vs "the
# Bose APPLIANCE is near peer"). A name we can't reach the classifier for → "?" (honestly blank, not
# a fabricated class). Defined ABOVE the arg-parse so --test can exercise it directly.
#
# dev_class <name> [mac]: When a MAC is given AND the name is unidentifiable ("?"/blank/bare-MAC), we
# also derive the BLE ADDRESS TYPE (mesh-presence --addrtype — the single source; since 2026-08-16 it is
# BlueZ's own AddressType, not the U/L bit, which is a coin flip on BLE)
# and pass it to --classify: a nameless RANDOM (privacy-rotating) address resolves PERSONAL where name
# alone reads AMBIGUOUS. THIS is what lets a nameless phone/wearable seen by both vantages count as a
# dual-vantage personal device → a real person-zone instead of the perpetual UNKNOWN. Named devices keep
# their name verdict (name outranks addrtype, in the classifier). Memoized per MAC (a MAC's name+addrtype
# are stable within a run); name-only calls memoize per name.
declare -A _CLASS_CACHE
dev_class() {
  local name="${1:-?}" mac="${2:-}"
  local key="${mac:-$name}"
  [ -n "${_CLASS_CACHE[$key]:-}" ] && { echo "${_CLASS_CACHE[$key]}"; return; }
  local atype=""
  # Only spend an --addrtype lookup when the name can't classify on its own (the AMBIGUOUS-breaking case).
  if [ -n "$mac" ] && { [ -z "$name" ] || [ "$name" = '?' ] || [[ "$name" =~ ^[0-9A-Fa-f:]{17}$ ]]; }; then
    atype="$(mesh-presence --addrtype "$mac" 2>/dev/null)"
  fi
  local c; c="$(mesh-presence --classify "$name" "$atype" 2>/dev/null)"
  case "$c" in PERSONAL|APPLIANCE|AMBIGUOUS) : ;; *) c="?" ;; esac   # honest blank, never faked
  _CLASS_CACHE[$key]="$c"; echo "$c"
}

# NOTE: scan_both MUST be defined ABOVE the `while [ $# -gt 0 ]` arg-parse loop below. A bare
# zero-arg reflex run (the 9,39 cron) never enters that loop body, so a scan_both defined INSIDE it
# stayed UNDEFINED → the post-loop oneshot/stream calls hit "scan_both: command not found" every
# cycle (0 valid fusions since autowiring 07-14; discover→health→genome baton 2026-07-17). It also
# sits above the --test dispatch on purpose — the dispatch `exit`s, so a real-drive gate below could
# only call an UNDEFINED function (2026-07-16: gate read "0 scans, retry gone" against a correct retry).
# --- skew_verdict: is the pair of vantage samples a CONSISTENT CUT? (MAXWAIT, see header) ---
# PURE + testable: no globals read, no side effects. Args: <local_epoch> <peer_epoch> <maxskew_s>.
#   ok   — both arms sampled and started within maxskew → the RSSI comparison spans one instant
#   skew — both arms sampled but too far apart → membership still valid, COMPARISON is not
#   na   — an arm has no epoch (it produced no sample) or maxskew is unset → not a skew claim; the
#          INCOMPLETE path owns that cycle. na must NEVER read as ok: "we could not check" and
#          "we checked and it is fine" are different facts, and collapsing them is how a blind
#          gate wears a green.
# rc mirrors the word (0 ok / 1 skew / 2 na) so a caller may branch on either.
skew_verdict() {
  local le="${1:-}" pe="${2:-}" mx="${3:-}"
  # Validate EACH field on its own. Concatenating them first ("$le$pe$mx") hides an empty one behind
  # its neighbours — le="" pe=1000 mx=45 reads "100045", all digits, and an UNSAMPLED arm sails
  # through as a valid cut. Caught red by the na gate below.
  local f
  for f in "$le" "$pe" "$mx"; do
    case "$f" in ""|*[!0-9]*) echo na; return 2 ;; esac
  done
  local d=$(( le > pe ? le - pe : pe - le ))
  if [ "$d" -le "$mx" ]; then echo ok; return 0; fi
  echo skew; return 1
}

# --- scan_both: collect local + peer presence, return arrays populated ---
scan_both() {
  local local_out peer_out
  # OUTER timeout on BOTH BLE scans, bounding a WEDGED adapter (bluetoothctl query can block forever on
  # a D-Bus stall — without this a wedge hangs the cron reflex; ConnectTimeout only guards the SSH
  # handshake, not the remote command). The timeout is a WEDGE-BOUND, NOT a tight SLA, so it MUST sit
  # well above a HEALTHY-but-slow scan. The old `timeout 20` for a 10s scan was mis-sized: a real ds
  # peer scan is ~26s wall (10s BLE window + bluetoothctl adapter setup/teardown + D-Bus device query
  # + SSH), so EVERY peer scan was killed at 20s → rc=124 INCOMPLETE → the peer column was permanently
  # EMPTY (peer_unique=0 in every presence-fusion.log line) and the cross-vantage DIFFERENTIAL — the
  # devices only the PEER sees (health proved ds uniquely covers Rosalia's iPhone + K380, IdeaPad
  # blind) — was silently LOST, the exact value this fusion exists to surface. Headroom = scan_win+35
  # (45s for a 10s window) covers the measured 26s with margin and still catches a true wedge.
  # (genome 2026-06-26, discover→health→genome baton: ds proven a real 2nd BLE vantage, fusion hollow.)
  # SCAN_COMPLETE stays content-based (see scan_sampled): mesh-presence exits 1 on a successful
  # 0-device scan (empty room), so exit-code gating misreads empty rooms as incomplete (same bug class
  # as mesh-arrivals/mesh-body-state, mesh-chat 2026-06-18 thread).
  local scan_win="${MESH_FUSE_SCAN_WIN:-10}"
  local scan_to=$(( scan_win + 35 ))
  # Capture the local rc — the old `|| true` DISCARDED it, so every local non-sample (contention,
  # wedge, absent stack) collapsed into one "bluetoothctl/D-Bus" message (see classify_peer_fail).
  local local_rc
  # MAXWAIT: stamp the START of the attempt that actually samples. Re-stamped on retry below, so the
  # skew is measured between the windows the RSSI values CAME FROM, not between the first tries.
  local ls_epoch pe_epoch=""
  ls_epoch="$(date +%s)"
  local_out="$(timeout "$scan_to" mesh-presence "$scan_win" 2>/dev/null)"; local_rc=$?
  # RETRY-ONCE on rc=3/124, the SAME contention the peer arm below already retries. The asymmetry was
  # the bug: a local scan-lock is if anything MORE likely than a remote one (every local BLE reflex
  # contends for this one adapter), yet only the peer got a second chance — so local contention went
  # straight to a permanent INCOMPLETE for the whole cron cycle while the adapter was healthy.
  if [ "$local_rc" = 3 ] || [ "$local_rc" = 124 ]; then
    sleep "${MESH_FUSE_RETRY_DELAY_S:-25}"
    ls_epoch="$(date +%s)"
    local_out="$(timeout "$scan_to" mesh-presence "$scan_win" 2>/dev/null)"; local_rc=$?
  fi
  # Capture the peer rc so an INCOMPLETE fusion can attribute the REAL cause. ssh passes the REMOTE
  # command's exit code through on a successful connection (rc 127 = remote shell "command not
  # found" → mesh-presence missing on the peer) and returns 255 when the SSH layer itself fails
  # (host down / auth / network). These are different operator fixes; conflating them as "check
  # SSH" (the old message) sent a reader hunting the wrong problem when the peer simply lacked the
  # tool (ds, 2026-06-21: SSH-OK + PRESENCE-MISSING → false "could not reach").
  # SENTINEL SHORT-CIRCUIT: when no peer is configured (PEER_HOST empty or the literal 'none'
  # sentinel from ~/.mesh/nodes), skip the peer SSH scan entirely — it can only fail rc=255 against a
  # host named 'none', wasting a DNS lookup per cycle, and classify_peer_fail emits the STRUCTURAL n/a
  # message directly from PEER_HOST (below/peer_online is not even consulted). peer_rc=255 keeps the
  # INCOMPLETE bookkeeping honest without pretending an SSH layer was reachable.
  local peer_rc peer_out=""
  case "$PEER_HOST" in
    ""|none)
      peer_rc=255 ;;   # no ssh attempted; STRUCTURAL n/a resolved by classify_peer_fail from PEER_HOST
    *)
      pe_epoch="$(date +%s)"
      peer_out="$(timeout "$scan_to" ssh $SSH_OPTS "${PEER_USER}@${PEER_HOST}" "\$HOME/.local/bin/mesh-presence $scan_win" 2>/dev/null)"; peer_rc=$?
      # RETRY-ONCE on rc=3 (the retry-once standard, 5c47ea1): exit 3 is a DEGRADED read — the peer's
      # adapter was scan-locked (BUSY: another scanner's flock window, seconds long) or the read raced a
      # cache clear (SUSPECT). Both are transient contention, not a dead sense; one short-delay retry
      # heals them (live case 2026-07-07: scheduled :39 cycles read rc=3 while the peer's own scans were
      # producing n=4..8 all morning). A retry that still fails is reported as before — never faked.
      # ALSO retry on rc=124 (2026-07-10): a live scan-lock can hold past the full $scan_to budget
      # instead of surfacing BUSY quickly — same contention, just slower to report — so the SSH+scan
      # itself gets killed by `timeout` before mesh-presence ever prints BUSY. Without this the peer
      # column reads permanently INCOMPLETE for that whole 30min cron cycle (verified live: 03:39:58Z
      # cycle hit rc=124 with ds's own adapter healthy seconds later — a rc=3-only retry never caught it).
      if [ "$peer_rc" = 3 ] || [ "$peer_rc" = 124 ]; then
        sleep "${MESH_FUSE_RETRY_DELAY_S:-25}"
        pe_epoch="$(date +%s)"
        peer_out="$(timeout "$scan_to" ssh $SSH_OPTS "${PEER_USER}@${PEER_HOST}" "\$HOME/.local/bin/mesh-presence $scan_win" 2>/dev/null)"; peer_rc=$?
      fi ;;
  esac
  local lok=0 pok=0
  scan_sampled "$local_out" && lok=1
  scan_sampled "$peer_out" && pok=1
  SCAN_COMPLETE=0; [ "$lok" = 1 ] && [ "$pok" = 1 ] && SCAN_COMPLETE=1
  # MAXWAIT: publish the cut. An arm that did NOT sample gets no epoch (see the global's note), so a
  # half-failed cycle renders na and stays the INCOMPLETE path's business, never a fake 0s skew.
  SCAN_LOCAL_EPOCH=""; [ "$lok" = 1 ] && SCAN_LOCAL_EPOCH="$ls_epoch"
  SCAN_PEER_EPOCH="";  [ "$pok" = 1 ] && SCAN_PEER_EPOCH="$pe_epoch"
  # Derived from scan_to, the wedge-bound already computed above — see the header on why this
  # separates a healthy sequential cycle from a retried one without minting a new constant.
  SCAN_MAXSKEW_S="${MESH_FUSE_MAXSKEW_S:-$scan_to}"
  SCAN_SKEW_S=""
  if [ -n "$SCAN_LOCAL_EPOCH" ] && [ -n "$SCAN_PEER_EPOCH" ]; then
    SCAN_SKEW_S=$(( SCAN_LOCAL_EPOCH > SCAN_PEER_EPOCH ? SCAN_LOCAL_EPOCH - SCAN_PEER_EPOCH : SCAN_PEER_EPOCH - SCAN_LOCAL_EPOCH ))
  fi
  # peer_online is only consulted for the rc255 reachable-vs-offline split; a sentinel PEER_HOST is
  # short-circuited to STRUCTURAL n/a in classify_peer_fail before ponline is ever read, so skip the
  # (wasted) tailscale+python probe against a host named 'none'.
  local ponline=""
  case "$PEER_HOST" in ""|none) ;; *) [ "$pok" != 1 ] && ponline="$(peer_online "$PEER_HOST")" ;; esac
  # local_radio discriminates the TWO rc=2 meanings (structural no-adapter vs repairable unpowered)
  # for classify_peer_fail's local arm. Derived ONLY when the local scan actually failed with rc 2 —
  # a lok=1 arm never consults it, and the derive itself reads sysfs only via `mesh-presence
  # --has-radio` (exit 0, yes/no), so it adds no radio work on the healthy path. An empty/failed
  # query leaves "" → classify keeps the historical repair-directed line: never fabricate a
  # structural claim from an unmeasured query.
  local lradio=""
  if [ "$local_rc" = 2 ] && [ "$lok" != 1 ]; then
    case "$(timeout "$scan_to" mesh-presence --has-radio 2>/dev/null)" in
      yes) lradio=1 ;;
      no)  lradio=0 ;;
    esac
  fi
  # A sentinel/empty PEER_HOST with a HEALTHY local scan is a STRUCTURAL n/a (no peer configured), not
  # an SSH fault — resolve it directly. A LOCAL-radio fault (lok!=1) still routes through
  # classify_peer_fail, whose local arm is the more actionable message even when no peer is configured.
  if [ "$lok" = 1 ] && { [ -z "$PEER_HOST" ] || [ "$PEER_HOST" = none ]; }; then
    PEER_FAIL_REASON="$(no_peer_configured_reason)"
  else
    PEER_FAIL_REASON="$(classify_peer_fail "$lok" "$pok" "$peer_rc" "$local_rc" "$ponline" "$lradio")"
  fi

  unset l_rssi l_name p_rssi p_name 2>/dev/null || true
  declare -gA l_rssi l_name p_rssi p_name

  while IFS='|' read -r rssi mac name; do
    [ -z "$mac" ] && continue
    l_rssi["$mac"]="$rssi"
    l_name["$mac"]="${name:-?}"
  done < <(echo "$local_out" | grep -E '^-?[0-9]+\|' || true)

  while IFS='|' read -r rssi mac name; do
    [ -z "$mac" ] && continue
    p_rssi["$mac"]="$rssi"
    p_name["$mac"]="${name:-?}"
  done < <(echo "$peer_out" | grep -E '^-?[0-9]+\|' || true)

  case "$PEER_HOST" in
    ""|none) PEER_NAME=peer ;;   # no ssh to a sentinel host
    *) PEER_NAME="$(timeout 8 ssh $SSH_OPTS "${PEER_USER}@${PEER_HOST}" 'hostname' 2>/dev/null || echo peer)" ;;
  esac
}

# HOISTED ABOVE THE ARG-PARSE LOOP for the same reason scan_both is (see its note): a --test that
# cannot CALL a function can only assert its source text, and source text is never behaviour. These
# three carry the zonal-edge decision, so the maxskew suppression gate below drives them for real.
# --- closest_node: for a given MAC, return which node has strongest RSSI ---
closest_node() {
  local mac="$1" lr="${l_rssi[$mac]:-}" pr="${p_rssi[$mac]:-}"
  if [ -z "$lr" ] && [ -z "$pr" ]; then echo ""; return; fi
  if [ -z "$pr" ]; then echo "$SELF"; return; fi
  if [ -z "$lr" ]; then echo "$PEER_NAME"; return; fi
  if [ "$lr" -ge "$pr" ]; then echo "$SELF"; else echo "$PEER_NAME"; fi
}

# --- resolve_tracked: given a track key (name sub or MAC), find matching device in scan ---
resolve_tracked() {
  local key="$1" key_lc; key_lc="$(printf '%s' "$key" | tr '[:upper:]' '[:lower:]')"
  local best_mac="" best_rssi=-999

  for mac in "${!l_rssi[@]}" "${!p_rssi[@]}"; do
    local mac_lc; mac_lc="$(printf '%s' "$mac" | tr '[:upper:]' '[:lower:]')"
    local name="${l_name[$mac]:-${p_name[$mac]:-?}}"
    local name_lc; name_lc="$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]')"
    local match=0
    [[ "$mac_lc" == *"$key_lc"* ]] && match=1
    [[ "$name_lc" == *"$key_lc"* ]] && match=1
    [ "$match" -eq 1 ] && { local lr="${l_rssi[$mac]:--999}"; local pr="${p_rssi[$mac]:--999}"; local best; best=$(( lr > pr ? lr : pr )); [ "$best" -gt "$best_rssi" ] && { best_mac="$mac"; best_rssi="$best"; }; }
  done
  echo "$best_mac"
}

# --- check_tracked_zones: compare current closest node to stored state, feed mind on change ---
check_tracked_zones() {
  local ts; ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  local alerts=""
  mesh-state-touch "$STATE"

  # A missing peer is not a movement event. Require both observations before
  # changing zonal state, otherwise peer loss can fabricate MOVED/GONE edges.
  if [ "${SCAN_COMPLETE:-0}" -ne 1 ]; then
    echo "$ts zonal: scan incomplete (${PEER_FAIL_REASON:-unknown cause}) — retaining previous state" >> "$FUSELOG"
    return 0
  fi

  # MAXWAIT (see header): the guard above asks WHETHER both vantages observed, never WHEN. Two
  # complete-but-non-simultaneous scans fabricate exactly the MOVED/ARRIVED edges that guard exists
  # to prevent, because closest_node compares RSSI across the gap. Refuse the comparison and RETAIN
  # state — a real move is deferred to the next clean cycle, never lost, and never invented.
  local _skv; _skv="$(skew_verdict "${SCAN_LOCAL_EPOCH:-}" "${SCAN_PEER_EPOCH:-}" "${SCAN_MAXSKEW_S:-}")"
  if [ "$_skv" = skew ]; then
    echo "$ts zonal: vantages ${SCAN_SKEW_S}s apart (> maxskew ${SCAN_MAXSKEW_S}s) — cross-vantage RSSI is not a consistent cut; retaining previous state, no MOVED/ARRIVED edge" >> "$FUSELOG"
    return 0
  fi

  for track_key in "${TRACK[@]}"; do
    local mac; mac="$(resolve_tracked "$track_key")"
    local name closest self_rssi peer_rssi

    if [ -z "$mac" ]; then
      # device not seen by either node this cycle → check if it was previously tracked
      local prev; prev="$(grep "^$track_key|" "$STATE" 2>/dev/null | head -1)"
      if [ -n "$prev" ]; then
        closest="GONE"; name="$(echo "$prev" | cut -d'|' -f3)"
        alerts="${alerts}${track_key}|${name}|GONE|0|0"$'\n'
        sed -i "/^$track_key|/d" "$STATE" 2>/dev/null || true
      fi
      continue
    fi

    name="${l_name[$mac]:-${p_name[$mac]:-?}}"
    closest="$(closest_node "$mac")"
    self_rssi="${l_rssi[$mac]:--}"
    peer_rssi="${p_rssi[$mac]:--}"

    local prev_line; prev_line="$(grep "^$track_key|" "$STATE" 2>/dev/null | head -1)"
    local prev_closest=""
    [ -n "$prev_line" ] && prev_closest="$(echo "$prev_line" | cut -d'|' -f4)"

    if [ -z "$prev_line" ]; then
      # first time seeing this device
      echo "$track_key|$mac|$name|$closest|$self_rssi|$peer_rssi|$ts" >> "$STATE"
      alerts="${alerts}${track_key}|${name}|ARRIVED:${closest}|${self_rssi}|${peer_rssi}"$'\n'
    elif [ "$prev_closest" != "$closest" ]; then
      # zone change detected
      sed -i "/^$track_key|/d" "$STATE" 2>/dev/null || true
      echo "$track_key|$mac|$name|$closest|$self_rssi|$peer_rssi|$ts" >> "$STATE"
      alerts="${alerts}${track_key}|${name}|${prev_closest}→${closest}|${self_rssi}|${peer_rssi}"$'\n'
    else
      # no change — update timestamp only
      sed -i "/^$track_key|/d" "$STATE" 2>/dev/null || true
      echo "$track_key|$mac|$name|$closest|$self_rssi|$peer_rssi|$ts" >> "$STATE"
    fi
  done

  alerts="${alerts%%$'\n'}"
  if [ -n "$alerts" ]; then
    while IFS='|' read -r tk nm ev sr pr; do
      [ -z "$tk" ] && continue
      local msg
      case "$ev" in
        GONE)
          msg="zonal: '$tk' ($nm) LEFT — no longer seen by any node" ;;
        ARRIVED:*)
          local cn="${ev#ARRIVED:}"
          msg="zonal: '$tk' ($nm) ARRIVED near $cn (self=${sr:--} peer=${pr:--})" ;;
        *→*)
          msg="zonal: '$tk' ($nm) MOVED $ev (self=${sr:--} peer=${pr:--})" ;;
        *) continue ;;
      esac
      echo "$ts $msg"
      if command -v mesh-chat >/dev/null 2>&1; then
        MESH_WHO="presence-fuse@$SELF" mesh-chat "[zone] $msg" >/dev/null 2>&1 || true
      fi
      echo "$ts $msg" >> "$FUSELOG"
    done <<< "$alerts"
  fi
}

# ================================================================
# MAIN
# ================================================================

while [ $# -gt 0 ]; do
  case "$1" in
    --test)
      command -v mesh-presence >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-presence)"; exit 1; }
      # ZERO-ARG REFLEX GATE (discover→health→genome baton 2026-07-17): the 9,39 cron runs bare
      # ($#=0), which never enters the `while [ $# -gt 0 ]` arg-parse loop. scan_both lived INSIDE
      # that loop for weeks → undefined on every bare run → "scan_both: command not found" → 0 valid
      # fusions since 07-14, while THIS --test path (an arg → loop runs → scan_both defined) stayed
      # green (family cc617e5: passing --test ≠ running). The zero-arg path can't be DRIVEN here — a
      # real bare run does a live BLE scan + peer SSH that the sandboxed --test must not trigger — so
      # assert the STRUCTURAL invariant that makes that path safe: scan_both's definition precedes the
      # arg-parse loop. Anchored patterns match only the real def/loop lines, never this gate's own
      # grep lines (indented) or the backticked mentions in comments. RED if ever moved back inside.
      _sb_ln=$(grep -n '^scan_both()' "$0" | head -1 | cut -d: -f1)
      _wl_ln=$(grep -n '^while \[ \$# -gt 0 \]' "$0" | head -1 | cut -d: -f1)
      { [ -n "$_sb_ln" ] && [ -n "$_wl_ln" ] && [ "$_sb_ln" -lt "$_wl_ln" ]; } \
        || { echo "smoke-test: FAIL (scan_both def (line ${_sb_ln:-none}) is not ABOVE the arg-parse loop (line ${_wl_ln:-none}) — a bare zero-arg reflex run hits 'scan_both: command not found', 0 valid fusions)"; exit 1; }
      # Same rule for the zonal trio: hoisted so the maxskew gate below can DRIVE them, not grep them.
      for _fn in closest_node resolve_tracked check_tracked_zones; do
        _fl=$(grep -n "^${_fn}()" "$0" | head -1 | cut -d: -f1)
        { [ -n "$_fl" ] && [ "$_fl" -lt "$_wl_ln" ]; } \
          || { echo "smoke-test: FAIL ($_fn def (line ${_fl:-none}) fell back BELOW the arg-parse loop — the maxskew suppression gate can no longer call it and would pass vacuously)"; exit 1; }
      done
      # scan_sampled: content-based classify — falsifiable assertions
      scan_sampled "=== mesh-presence host @ ts — 0 device(s) in range ===" \
        || { echo "smoke-test: FAIL (empty-room scan wrongly rejected — same bug class as mesh-arrivals)"; exit 1; }
      scan_sampled $'=== mesh-presence host @ ts — 2 device(s) in range ===\n-66|AA|Device' \
        || { echo "smoke-test: FAIL (non-empty scan wrongly rejected)"; exit 1; }
      scan_sampled "" \
        && { echo "smoke-test: FAIL (empty output accepted as a sample)"; exit 1; }
      scan_sampled "=== mesh-presence host @ ts — BUSY (adapter scan-locked) ===" \
        && { echo "smoke-test: FAIL (BUSY accepted as a sample)"; exit 1; }
      scan_sampled "=== mesh-presence host @ ts — SUSPECT: 0 of 7 known device(s) gave a fresh RSSI ===" \
        && { echo "smoke-test: FAIL (SUSPECT accepted as a sample — would re-introduce the false-empty)"; exit 1; }
      # Peer resolution: the cron run uses DEFAULT_HOST from MESH_FUSE_PEER / mesh-peer-addr.
      # Catch the 2026-06-13 hollow-fusion class: DEFAULT_HOST="" → "PEER SCAN INCOMPLETE"
      # silently on every cron run. Also catch: peer accidentally resolved to the router
      # (no BLE → always hollow). Neither is detected by a deps-only test.
      _resolved="${MESH_FUSE_PEER:-$(mesh-peer-addr "${MESH_FUSE_LABEL:-default-string}" 2>/dev/null || true)}"
      [ -n "$_resolved" ] || { echo "smoke-test: FAIL (peer resolves empty — MESH_FUSE_PEER unset and peer-addr failed; cron fusion will always be hollow)"; exit 1; }
      # Router guard: if peer resolved to the router node it has no BLE → fusion is always hollow.
      # Use env vars from ~/.mesh/nodes so no IPs are hardcoded here (topology-leak rule).
      _rts="${MESH_ROUTER_TS_IP:-}"; _rlan="${MESH_ROUTER_LAN_IP:-192.168.8.1}"
      case "$_resolved" in
        "$_rts"|"$_rlan") echo "smoke-test: FAIL (peer='$_resolved' is the router — no BLE; set MESH_FUSE_PEER to a BLE-capable node)"; exit 1 ;;
      esac
      # classify_peer_fail: the HONESTY fix — incomplete fusion must attribute the RIGHT cause.
      [ -z "$(classify_peer_fail 1 1 0)" ] \
        || { echo "smoke-test: FAIL (both-scanned must be COMPLETE → empty reason)"; exit 1; }
      # FALSIFIABLE: SSH-down (255) and tool-missing (127) must NOT read the same — the whole point.
      case "$(classify_peer_fail 1 0 255)" in *SSH*FAILED*) ;; *) echo "smoke-test: FAIL (rc255 must blame SSH reachability)"; exit 1 ;; esac
      case "$(classify_peer_fail 1 0 127)" in *NOT\ installed*) ;; *) echo "smoke-test: FAIL (rc127 must blame missing mesh-presence on peer, NOT SSH)"; exit 1 ;; esac
      [ "$(classify_peer_fail 1 0 255)" != "$(classify_peer_fail 1 0 127)" ] \
        || { echo "smoke-test: FAIL (rc255 and rc127 collapsed to one message — the misattribution bug)"; exit 1; }
      # FALSIFIABLE: rc255 to an OFFLINE peer (retired/down node) is a claim about the NODE, NOT an SSH
      # bug — it must read STRUCTURAL, and must DIFFER from the reachable-but-SSH-failed message. Unknown
      # (no peer_online arg) must keep blaming SSH (never fabricate "retired" from a missing tailscale).
      case "$(classify_peer_fail 1 0 255 0 0)" in *OFFLINE*STRUCTURAL*) ;; *) echo "smoke-test: FAIL (rc255 + peer offline must read STRUCTURAL/OFFLINE, not an SSH bug to chase)"; exit 1 ;; esac
      case "$(classify_peer_fail 1 0 255 0 0)" in *fix:\ SSH\ reachability*) echo "smoke-test: FAIL (rc255 + peer offline still sent the reader to fix SSH — the node-vs-SSH split is dead)"; exit 1 ;; esac
      [ "$(classify_peer_fail 1 0 255 0 0)" != "$(classify_peer_fail 1 0 255 0 1)" ] \
        || { echo "smoke-test: FAIL (offline-peer and reachable-peer rc255 collapsed to one message — the node-vs-SSH split is vacuous)"; exit 1; }
      case "$(classify_peer_fail 1 0 255 0 1)" in *SSH*FAILED*) ;; *) echo "smoke-test: FAIL (rc255 to a REACHABLE peer must still blame SSH/auth)"; exit 1 ;; esac
      case "$(classify_peer_fail 1 0 255)"     in *SSH*FAILED*) ;; *) echo "smoke-test: FAIL (rc255 with UNKNOWN online-ness must default to the SSH message — never fabricate retired)"; exit 1 ;; esac
      # SENTINEL peer (PEER_HOST='none'/empty from ~/.mesh/nodes): the rc255 SSH verdict is WRONG — no
      # second BLE node is even configured. no_peer_configured_reason is the STRUCTURAL n/a message, and
      # it must NOT send the reader to fix SSH to a host named 'none' (the 2026-07-28 live artifact bug).
      case "$(no_peer_configured_reason)" in *STRUCTURALLY\ n/a*) ;; *) echo "smoke-test: FAIL (no_peer_configured_reason must read STRUCTURALLY n/a)"; exit 1 ;; esac
      case "$(no_peer_configured_reason)" in *fix:\ SSH\ reachability*) echo "smoke-test: FAIL (no-peer message still sent the reader to fix SSH — the sentinel structural message is wrong)"; exit 1 ;; esac
      [ "$(no_peer_configured_reason)" != "$(classify_peer_fail 1 0 255 0 1)" ] \
        || { echo "smoke-test: FAIL (no-peer-configured and reachable-peer-SSH-fail collapsed to one message)"; exit 1; }
      # REAL-DRIVE the scan_both routing: a sentinel PEER_HOST with a HEALTHY local scan must set
      # PEER_FAIL_REASON to the STRUCTURAL n/a, skipping the ssh entirely. FALSIFIABLE two ways: delete
      # the sentinel short-circuit in scan_both → local BUSY-stub below would instead ssh 'none' and the
      # reason reads "fix: SSH"; and the sentinel-case in the peer-scan block means the ssh is NEVER
      # attempted against 'none'. Stub emits a healthy local scan so lok=1.
      _nsb="$(mktemp -d)"; mkdir -p "$_nsb/bin"
      cat > "$_nsb/bin/mesh-presence" <<'EOF'
#!/bin/sh
echo "=== mesh-presence stub @ nowЗ — 1 device(s) in range ==="
echo "-66|AA:BB:CC:DD:EE:FF|Phone"
exit 0
EOF
      chmod +x "$_nsb/bin/mesh-presence"
      ( PATH="$_nsb/bin:$PATH"; MESH_FUSE_SCAN_WIN=1
        PEER_HOST=none; PEER_USER=nobody
        scan_both >/dev/null 2>&1
        case "$PEER_FAIL_REASON" in
          *STRUCTURALLY\ n/a*) ;;
          *) echo "smoke-test: FAIL (scan_both with sentinel PEER_HOST='none' + healthy local did not emit STRUCTURAL n/a: '$PEER_FAIL_REASON')"; exit 1 ;;
        esac
        case "$PEER_FAIL_REASON" in *fix:\ SSH\ reachability*) echo "smoke-test: FAIL (sentinel peer STILL blamed SSH — the 2026-07-28 misclassification is back)"; exit 1 ;; esac
      ) || { rm -rf "$_nsb"; exit 1; }
      rm -rf "$_nsb"
      # LOCAL-arm attribution (2026-07-16). The OLD gate here asserted only "*LOCAL*scan*" against a
      # single hardcoded message — it PASSED against the bug it was supposed to catch, certifying
      # "failed (bluetoothctl/D-Bus)" as correct for a merely scan-locked (rc 3) adapter. A local
      # non-sample has three causes with three different fixes; they must not collapse.
      case "$(classify_peer_fail 0 0 127 3)"   in *SCAN-LOCKED*) ;; *) echo "smoke-test: FAIL (local rc3 is CONTENTION — must not read as a dead radio)"; exit 1 ;; esac
      case "$(classify_peer_fail 0 0 127 3)"   in *bluetoothctl/D-Bus*) echo "smoke-test: FAIL (local rc3 blamed bluetoothctl/D-Bus — the misattribution bug is back)"; exit 1 ;; esac
      case "$(classify_peer_fail 0 0 127 124)" in *TIMED\ OUT*) ;; *) echo "smoke-test: FAIL (local rc124 must blame a wedged adapter)"; exit 1 ;; esac
      case "$(classify_peer_fail 0 0 127 2)"   in *UNREACHABLE*) ;; *) echo "smoke-test: FAIL (local rc2 must blame an absent/unpowered BT stack)"; exit 1 ;; esac
      # rc=2 + local_radio split (2026-09-02): rc 2 is used for BOTH structural-no-adapter and
      # repairable-unpowered, so the 6th arg (measured by scan_both via `mesh-presence --has-radio`)
      # picks the remedy. radio=0 → STRUCTURAL n/a ("nothing to power or fix"); radio=1 → repairable.
      case "$(classify_peer_fail 0 0 127 2 0 0)" in *STRUCTURALLY\ n/a*) ;;
        *) echo "smoke-test: FAIL (rc2 + local_radio=0 must read STRUCTURAL n/a, got: $(classify_peer_fail 0 0 127 2 0 0))"; exit 1 ;; esac
      case "$(classify_peer_fail 0 0 127 2 0 0)" in *fix:\ the\ local\ BT\ stack*) echo "smoke-test: FAIL (rc2 + local_radio=0 still sent the reader to repair a radio that does not exist)"; exit 1 ;; esac
      case "$(classify_peer_fail 0 0 127 2 0 1)" in *UNREACHABLE*) ;;
        *) echo "smoke-test: FAIL (rc2 + local_radio=1 must stay repairable UNREACHABLE, got: $(classify_peer_fail 0 0 127 2 0 1))"; exit 1 ;; esac
      case "$(classify_peer_fail 0 0 127 2 0 1)" in *STRUCTURALLY\ n/a*) echo "smoke-test: FAIL (rc2 + local_radio=1 misread as structural no-adapter)"; exit 1 ;; esac
      # unmeasured (5-arg default) must keep the historical repair-directed line, and all three
      # (default / radio=0 / radio=1) must be pairwise distinct — "" must never collapse onto 0.
      [ "$(classify_peer_fail 0 0 127 2)" = "$(classify_peer_fail 0 0 127 2 0 1)" ] \
        || { echo "smoke-test: FAIL (unmeasured rc2 default must equal the radio-present repair line, NOT differ)"; exit 1; }
      { [ "$(classify_peer_fail 0 0 127 2)" != "$(classify_peer_fail 0 0 127 2 0 0)" ] \
        && [ "$(classify_peer_fail 0 0 127 2 0 0)" != "$(classify_peer_fail 0 0 127 2 0 1)" ]; } \
        || { echo "smoke-test: FAIL (default/radio-0/radio-1 rc2 arms must be pairwise distinct)"; exit 1; }
      { [ "$(classify_peer_fail 0 0 127 3)" != "$(classify_peer_fail 0 0 127 2)" ] \
        && [ "$(classify_peer_fail 0 0 127 3)" != "$(classify_peer_fail 0 0 127 124)" ]; } \
        || { echo "smoke-test: FAIL (local rc3/rc2/rc124 collapsed to one message — the misattribution bug)"; exit 1; }
      # REAL-DRIVE: the assertions above are PURE calls — they prove the classifier's vocabulary, never
      # that scan_both WIRES the local rc into it or that the retry fires. Drive the real scan_both
      # against a stub mesh-presence that emits a genuine BUSY artifact + rc 3, and assert the
      # BEHAVIOUR (two invocations = the retry actually ran; the reason names contention). Falsify by
      # deleting the local retry block → call count 1 → this trips. Bounded well under autowire's
      # timeout 30: retry delay 1s + an unroutable TEST-NET peer at ConnectTimeout 1.
      _lsb="$(mktemp -d)"; mkdir -p "$_lsb/bin" "$_lsb/mesh"
      cat > "$_lsb/bin/mesh-presence" <<EOF
#!/bin/sh
echo x >> "$_lsb/mesh/calls"
echo "=== mesh-presence stub @ \$(date -u +%FT%TZ) — BUSY (adapter scan-locked by another scanner) ==="
exit 3
EOF
      chmod +x "$_lsb/bin/mesh-presence"
      ( PATH="$_lsb/bin:$PATH"; MESH_FUSE_RETRY_DELAY_S=1; MESH_FUSE_SCAN_WIN=1
        PEER_HOST=192.0.2.1; PEER_USER=nobody          # TEST-NET-1: unroutable, ssh fails fast
        SSH_OPTS="-o BatchMode=yes -o ConnectTimeout=1 -o StrictHostKeyChecking=no"
        scan_both >/dev/null 2>&1
        _n="$(wc -l < "$_lsb/mesh/calls" 2>/dev/null || echo 0)"
        [ "$_n" = 2 ] || { echo "smoke-test: FAIL (local BUSY got $_n scan(s), expected 2 — the retry-once on local rc=3 is gone; local contention goes straight to INCOMPLETE)"; exit 1; }
        case "$PEER_FAIL_REASON" in
          *SCAN-LOCKED*) ;;
          *) echo "smoke-test: FAIL (scan_both does not wire the local rc into the reason: '$PEER_FAIL_REASON')"; exit 1 ;;
        esac
        [ "$SCAN_COMPLETE" = 0 ] || { echo "smoke-test: FAIL (a BUSY local scan must never read COMPLETE)"; exit 1; }
      ) || { rm -rf "$_lsb"; exit 1; }
      rm -rf "$_lsb"
      # REAL-DRIVE: structural-vs-repairable split wired through scan_both (2026-09-02). The pure calls
      # prove the classifier's vocabulary, never that scan_both MEASURES local_radio (`mesh-presence
      # --has-radio`) and passes it through — without the wiring, a radio-less node's rc=2 reads
      # "repair the BT stack" forever. Stub answers --has-radio from $HAS_RADIO (yes/no, rc 0) and
      # otherwise emits a plain rc=2 artifact. Falsify by deleting the lradio derive → has-radio is
      # never consulted → radio-less run goes UNREACHABLE-repairable → this trips.
      _lr="$(mktemp -d)"; mkdir -p "$_lr/bin"
      cat > "$_lr/bin/mesh-presence" <<EOF
#!/bin/sh
echo "\$@" >> "$_lr/mesh/calls"
for a in "\$@"; do [ "\$a" = --has-radio ] && { echo "\$HAS_RADIO"; exit 0; }; done
echo "mesh-presence: no usable local BLE read (rc2) — nothing on stdout, like the real unpowered/absent paths" >&2
exit 2
EOF
      chmod +x "$_lr/bin/mesh-presence"; mkdir -p "$_lr/mesh"
      ( PATH="$_lr/bin:$PATH"; MESH_FUSE_SCAN_WIN=1
        PEER_HOST=192.0.2.1; PEER_USER=nobody          # TEST-NET-1: unroutable, ssh fails fast
        SSH_OPTS="-o BatchMode=yes -o ConnectTimeout=1 -o StrictHostKeyChecking=no"
        HAS_RADIO=no scan_both >/dev/null 2>&1
        _n="$(grep -vc -- --has-radio "$_lr/mesh/calls" 2>/dev/null || echo 0)"
        [ "$_n" = 1 ] || { echo "smoke-test: FAIL (local rc2 got $_n scan(s), expected 1 — the has-radio derive must not rescan)"; exit 1; }
        case "$PEER_FAIL_REASON" in
          *STRUCTURALLY\ n/a*) ;;
          *) echo "smoke-test: FAIL (radio-less rc2 through scan_both must read STRUCTURAL n/a, got: '$PEER_FAIL_REASON')"; exit 1 ;;
        esac
        case "$PEER_FAIL_REASON" in *fix:\ the\ local\ BT\ stack*) echo "smoke-test: FAIL (radio-less rc2 still repair-directed — the has-radio wiring is dead)"; exit 1 ;; esac
        : > "$_lr/mesh/calls"
        HAS_RADIO=yes scan_both >/dev/null 2>&1
        _n="$(grep -vc -- --has-radio "$_lr/mesh/calls" 2>/dev/null || echo 0)"
        [ "$_n" = 1 ] || { echo "smoke-test: FAIL (present-but-unpowered rc2 got $_n scan(s), expected 1)"; exit 1; }
        case "$PEER_FAIL_REASON" in
          *UNREACHABLE*fix:\ the\ local\ BT\ stack*) ;;
          *) echo "smoke-test: FAIL (present radio rc2 through scan_both must stay repairable, got: '$PEER_FAIL_REASON')"; exit 1 ;;
        esac
        case "$PEER_FAIL_REASON" in *STRUCTURALLY\ n/a*) echo "smoke-test: FAIL (present radio rc2 misread as structural no-adapter)"; exit 1 ;; esac
      ) || { rm -rf "$_lr"; exit 1; }
      rm -rf "$_lr"
      # RETRY-ONCE on rc=3 (2026-07-07): a peer exit-3 (BUSY/SUSPECT — transient scan contention) must
      # get exactly one delayed re-read before being reported INCOMPLETE. Structural (falsify: drop the
      # retry block — this trips). Pattern via concatenation so this line never self-matches.
      grep -q '\[ "$peer_rc" = 3'" ]" "$0" || {
        echo "smoke-test: FAIL (no retry-once on peer rc=3 — every transient scan-lock collision reads INCOMPLETE)"; exit 1; }
      # dev_class addrtype-aware fusion (2026-06-26): a NAMELESS device's MAC address type breaks the
      # AMBIGUOUS tie so an unnamed phone seen by both vantages can resolve a real person-zone instead of
      # the perpetual UNKNOWN. FALSIFIABLE: nameless RANDOM MAC → PERSONAL; nameless PUBLIC MAC stays
      # NOT-personal (never over-claimed); a NAMED appliance keeps APPLIANCE even with a random MAC.
      # The address type is BlueZ's, injected here through mesh-presence's own map override so the gate
      # drives the REAL --addrtype path (2026-08-16). The two MACs are this node's live counterexamples to
      # the U/L-bit rule this replaced — 61:22:E7 has the bit CLEAR and is random, E7:4D:F9 has it SET and
      # is public — so restoring the bit rule inverts BOTH of the first two assertions.
      export MESH_ADDRTYPE_MAP="$(printf '%s\n' '61:22:E7:C3:60:DE random' 'E7:4D:F9:65:B0:65 public')"
      [ "$(dev_class "?" "61:22:E7:C3:60:DE")" = PERSONAL ]  || { echo "smoke-test: FAIL (nameless RANDOM-addr MAC must fuse to PERSONAL — the person-zone recovery)"; exit 1; }
      [ "$(dev_class "?" "E7:4D:F9:65:B0:65")" != PERSONAL ] || { echo "smoke-test: FAIL (nameless PUBLIC-addr MAC must NOT be claimed PERSONAL)"; exit 1; }
      [ "$(dev_class "Bose SoundLink" "61:22:E7:C3:60:DE")" = APPLIANCE ] || { echo "smoke-test: FAIL (named appliance must keep APPLIANCE — name outranks a random MAC)"; exit 1; }
      # honest degrade: a MAC BlueZ does not hold has NO address type — it must fall back to AMBIGUOUS,
      # never be guessed personal from its bytes (this MAC's U/L bit is SET: the old rule claimed PERSONAL).
      [ "$(dev_class "?" "4A:18:79:30:A3:0F")" != PERSONAL ] || { echo "smoke-test: FAIL (MAC absent from the BlueZ map must NOT be claimed PERSONAL — the axis is lost, not guessed)"; exit 1; }
      unset MESH_ADDRTYPE_MAP
      # ── MAXWAIT / consistent-cut gates (LITERATURE 2026-08-20, see header) ──────────────────────
      # 1. skew_verdict is PURE — assert its vocabulary in all three directions. na must be its own
      #    word: collapsing "could not check" into ok is how a blind gate wears a green.
      [ "$(skew_verdict 1000 1030 45)" = ok ]   || { echo "smoke-test: FAIL (30s gap under a 45s maxskew must read ok)"; exit 1; }
      [ "$(skew_verdict 1000 1100 45)" = skew ] || { echo "smoke-test: FAIL (100s gap over a 45s maxskew must read skew — the fabricated-edge window is open)"; exit 1; }
      [ "$(skew_verdict 1100 1000 45)" = skew ] || { echo "smoke-test: FAIL (skew must be symmetric — peer-first is the same gap as local-first)"; exit 1; }
      [ "$(skew_verdict 1000 1045 45)" = ok ]   || { echo "smoke-test: FAIL (a gap EQUAL to maxskew must be admitted — the bound is inclusive)"; exit 1; }
      [ "$(skew_verdict "" 1000 45)" = na ]     || { echo "smoke-test: FAIL (a missing local epoch must read na, never ok)"; exit 1; }
      [ "$(skew_verdict 1000 "" 45)" = na ]     || { echo "smoke-test: FAIL (a missing peer epoch must read na, never ok)"; exit 1; }
      [ "$(skew_verdict 1000 1030 "")" = na ]   || { echo "smoke-test: FAIL (an unset maxskew must read na, never ok)"; exit 1; }
      skew_verdict 1000 1100 45 >/dev/null; [ $? = 1 ] || { echo "smoke-test: FAIL (skew must exit 1 so a caller may branch on rc)"; exit 1; }
      # 2. REAL-DRIVE the wiring: the assertions above prove the function, never that scan_both STAMPS
      #    the epochs or that the maxskew knob reaches it. Stub BOTH arms on PATH (the local stub
      #    sleeps 1s, so the peer arm genuinely starts later and the skew is measured, not injected)
      #    and drive scan_both twice — once under a wide bound, once under a zero bound. Falsify by
      #    deleting either `date +%s` stamp: SCAN_SKEW_S goes empty and the ok arm trips.
      _mwb="$(mktemp -d)"; mkdir -p "$_mwb/bin"
      cat > "$_mwb/bin/mesh-presence" <<'EOF'
#!/bin/sh
sleep 1
echo "=== mesh-presence stub @ now — 1 device(s) in range ==="
echo "-40|AA:BB:CC:DD:EE:FF|Phone"
exit 0
EOF
      cat > "$_mwb/bin/ssh" <<'EOF'
#!/bin/sh
echo "=== mesh-presence stub @ now — 1 device(s) in range ==="
echo "-80|AA:BB:CC:DD:EE:FF|Phone"
exit 0
EOF
      chmod +x "$_mwb/bin/mesh-presence" "$_mwb/bin/ssh"
      ( PATH="$_mwb/bin:$PATH"; MESH_FUSE_SCAN_WIN=1; PEER_HOST=192.0.2.1; PEER_USER=nobody
        MESH_FUSE_MAXSKEW_S=999 scan_both >/dev/null 2>&1
        [ "$SCAN_COMPLETE" = 1 ] || { echo "smoke-test: FAIL (two stubbed healthy arms must read COMPLETE)"; exit 1; }
        [ -n "$SCAN_SKEW_S" ] || { echo "smoke-test: FAIL (scan_both did not stamp the arms — SCAN_SKEW_S empty, the cut has no time axis)"; exit 1; }
        [ "$SCAN_MAXSKEW_S" = 999 ] || { echo "smoke-test: FAIL (MESH_FUSE_MAXSKEW_S did not reach scan_both: '$SCAN_MAXSKEW_S')"; exit 1; }
        [ "$(skew_verdict "$SCAN_LOCAL_EPOCH" "$SCAN_PEER_EPOCH" "$SCAN_MAXSKEW_S")" = ok ] \
          || { echo "smoke-test: FAIL (a real sequential pair under a 999s bound must read ok — the gate would refuse every healthy cycle)"; exit 1; }
        MESH_FUSE_MAXSKEW_S=0 scan_both >/dev/null 2>&1
        [ "${SCAN_SKEW_S:-0}" -ge 1 ] || { echo "smoke-test: FAIL (the two arms measured ${SCAN_SKEW_S}s apart though the local arm sleeps 1s — the epochs are not of the real windows)"; exit 1; }
        [ "$(skew_verdict "$SCAN_LOCAL_EPOCH" "$SCAN_PEER_EPOCH" "$SCAN_MAXSKEW_S")" = skew ] \
          || { echo "smoke-test: FAIL (a real sequential pair under a 0s bound must read skew — the bound is not enforced on live epochs)"; exit 1; }
        # A half-failed cycle must render na, never a fake 0s "perfectly simultaneous".
        [ "$(skew_verdict "" "$SCAN_PEER_EPOCH" "$SCAN_MAXSKEW_S")" = na ] || { echo "smoke-test: FAIL (unsampled arm must render na)"; exit 1; }
      ) || { rm -rf "$_mwb"; exit 1; }
      # 3. REAL-DRIVE the BEHAVIOUR the finding is about: check_tracked_zones must fire an edge on a
      #    consistent cut and fire NONE on a skewed one. Both arms run in one subshell against a
      #    THROWAWAY FUSELOG/STATE (never the durable pair — a dry-run writing the liveness log forges
      #    the evidence it exists to check) with mesh-chat/mesh-state-touch stubbed, so the control arm
      #    proves the emission path is genuinely reached. Falsify by deleting the skew branch in
      #    check_tracked_zones: the skew arm then fires ARRIVED and this trips.
      cat > "$_mwb/bin/mesh-chat" <<EOF
#!/bin/sh
echo "\$*" >> "$_mwb/posted"
EOF
      cat > "$_mwb/bin/mesh-state-touch" <<'EOF'
#!/bin/sh
exit 0
EOF
      chmod +x "$_mwb/bin/mesh-chat" "$_mwb/bin/mesh-state-touch"
      ( PATH="$_mwb/bin:$PATH"
        STATE="$_mwb/state"; FUSELOG="$_mwb/fuse.log"; : > "$STATE"
        TRACK=("AA:BB:CC:DD:EE:FF"); SCAN_COMPLETE=1
        declare -gA l_rssi l_name p_rssi p_name
        l_rssi["AA:BB:CC:DD:EE:FF"]=-40; l_name["AA:BB:CC:DD:EE:FF"]=Phone
        p_rssi["AA:BB:CC:DD:EE:FF"]=-80; p_name["AA:BB:CC:DD:EE:FF"]=Phone
        # skewed cut → no edge, state untouched, and the log SAYS why (a collapsed reason makes
        # blind and quiet identical).
        SCAN_LOCAL_EPOCH=1000; SCAN_PEER_EPOCH=1200; SCAN_MAXSKEW_S=45
        check_tracked_zones >/dev/null 2>&1
        [ ! -s "$_mwb/posted" ] || { echo "smoke-test: FAIL (a SKEWED cycle fabricated a zonal edge: $(cat "$_mwb/posted"))"; exit 1; }
        [ ! -s "$STATE" ] || { echo "smoke-test: FAIL (a SKEWED cycle wrote zonal state — the next clean cycle can no longer fire the real edge)"; exit 1; }
        grep -q 'not a consistent cut' "$_mwb/fuse.log" || { echo "smoke-test: FAIL (the skew refusal left no reason in the log — silent and blind read the same)"; exit 1; }
        # CONTROL: same inputs, consistent cut → the edge MUST fire. Without this arm the gate above
        # would also pass on a check_tracked_zones that never emits anything at all.
        SCAN_PEER_EPOCH=1020
        check_tracked_zones >/dev/null 2>&1
        grep -q ARRIVED "$_mwb/posted" 2>/dev/null || { echo "smoke-test: FAIL (a CONSISTENT cut fired no zonal edge — the suppression gate above is vacuous)"; exit 1; }
        [ -s "$STATE" ] || { echo "smoke-test: FAIL (a CONSISTENT cut wrote no zonal state)"; exit 1; }
      ) || { rm -rf "$_mwb"; exit 1; }
      rm -rf "$_mwb"
      echo "smoke-test: ok (peer=$_resolved · scan_sampled:5 + peer-resolve/router + classify_peer_fail:10 incl. local-rc attribution + scan_both REAL-DRIVE retry/wiring + dev_class-addrtype:4 + maxskew skew_verdict:8/scan_both-stamp REAL-DRIVE/zonal-edge suppression+control assertions)"; exit 0 ;;
    --stream)
      MODE=stream; shift
      if [[ "${1:-}" =~ ^[1-9][0-9]*$ ]]; then INTERVAL="$1"; shift; fi ;;
    --track)
      [ -n "${2:-}" ] || { echo "mesh-presence-fuse: --track needs a MAC or name" >&2; exit 2; }
      TRACK+=("$2"); shift 2 ;;
    --once) MODE=once; shift ;;
    *)
      # A bare positional is the PEER (user@host or host); last one wins. Do NOT break
      # — breaking silently discarded every flag after the peer (e.g. --track), so a
      # peer-first call like `mesh-presence-fuse HOST --track Bose --once` lost its
      # tracking and never produced a zonal line. Do NOT consume the next token as
      # PEER_USER either — the user@host normalization below carries the user.
      PEER_HOST="$1"; shift ;;
  esac
done

# Normalize a user@host peer arg: if the host already carries a user@ prefix, split it so we
# never build ssh user@user@host (RC=255 → a silently-empty peer scan, the hollow artifact this
# tool is meant to avoid). An explicit user@ in the host wins over the positional/default user.
if [[ "$PEER_HOST" == *@* ]]; then
  PEER_USER="${PEER_HOST%@*}"; PEER_HOST="${PEER_HOST##*@}"
fi


# --- print_overlap: one-shot report (original behaviour) ---
print_overlap() {
  local TS; TS="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  echo "=== mesh-presence-fuse @ $TS ==="
  local overlap=0 unique_self=0 unique_peer=0
  # A failed peer scan must NOT masquerade as "no devices near peer": without this guard an
  # unreachable peer (ssh RC≠0) produces an empty peer column identical to a genuine no-overlap
  # result — the hollow artifact. Say it loudly so a reader (mind or operator) can't be fooled.
  if [ "${SCAN_COMPLETE:-0}" -ne 1 ]; then
    echo "⚠ PEER SCAN INCOMPLETE — ${PEER_FAIL_REASON:-unknown cause}. The peer column below"
    echo "  is EMPTY because the peer scan did not produce an artifact, NOT because no devices are"
    echo "  near it. Cross-node fusion is NOT valid this cycle (the local column below is still real)."
  fi
  # MAXWAIT (see header): both arms sampled, but not of the SAME INSTANT. Membership is join-shaped
  # and survives skew; the cross-vantage RSSI comparison is not and does not.
  local _skv; _skv="$(skew_verdict "${SCAN_LOCAL_EPOCH:-}" "${SCAN_PEER_EPOCH:-}" "${SCAN_MAXSKEW_S:-}")"
  if [ "${SCAN_COMPLETE:-0}" -eq 1 ] && [ "$_skv" = skew ]; then
    echo "⚠ VANTAGES NOT SIMULTANEOUS — the two scans sampled ${SCAN_SKEW_S}s apart (maxskew ${SCAN_MAXSKEW_S}s)."
    echo "  The MEMBERSHIP columns below are still real: a device seen by a vantage WAS in its range."
    echo "  The 'Closest' column is NOT — it compares RSSI across two different instants, so a device"
    echo "  that moved inside that gap is localized to whichever vantage happened to sample it nearer."
  fi

  echo ""; echo "--- Overlap (seen by BOTH nodes) ---"
  echo "MAC|Name|Class|Closest|${SELF} RSSI|Peer RSSI"
  for mac in "${!l_rssi[@]}"; do
    [ -z "${p_rssi[$mac]:-}" ] && continue
    overlap=$((overlap + 1))
    local lr="${l_rssi[$mac]}"; local pr="${p_rssi[$mac]}"
    local name="${l_name[$mac]:-${p_name[$mac]:-?}}"
    local closest; closest="$(closest_node "$mac")"
    echo "${mac}|${name}|$(dev_class "$name" "$mac")|${closest}|${lr}|${pr}"
  done
  [ "$overlap" -eq 0 ] && echo "(none found)"

  echo ""; echo "--- Unique to $SELF ---"; echo "MAC|Name|Class|RSSI"
  for mac in "${!l_rssi[@]}"; do
    [ -n "${p_rssi[$mac]:-}" ] && continue
    unique_self=$((unique_self + 1))
    echo "${mac}|${l_name[$mac]:-?}|$(dev_class "${l_name[$mac]:-?}" "$mac")|${l_rssi[$mac]}"
  done
  [ "$unique_self" -eq 0 ] && echo "(none)"

  echo ""; echo "--- Unique to peer ---"; echo "MAC|Name|Class|RSSI"
  for mac in "${!p_rssi[@]}"; do
    [ -n "${l_rssi[$mac]:-}" ] && continue
    unique_peer=$((unique_peer + 1))
    echo "${mac}|${p_name[$mac]:-?}|$(dev_class "${p_name[$mac]:-?}" "$mac")|${p_rssi[$mac]}"
  done
  [ "$unique_peer" -eq 0 ] && echo "(none)"

  echo ""; echo "=== Summary: ${overlap} overlap, ${unique_self} unique to ${SELF}, ${unique_peer} unique to peer ==="

  # Derived fused signal: PERSON-AWARE space map = zonal proximity × device CLASS. A PERSONAL device's
  # zone is a weak WHERE-is-a-person hint no single sense gives (presence = count, no zone; presence-fuse
  # = zone, no class). Honest-fusion: ONLY personal devices seen by BOTH vantages get a trustworthy zone
  # (a single-vantage device has no cross-node RSSI to localize); and if the peer scan was INCOMPLETE the
  # whole zonal map is unreliable → render UNKNOWN, never a confident "person near X" (appliance-vs-person
  # trap + no-faked-all-clear). This LABELS location, it does NOT conclude a human is present.
  local self_zone="" peer_zone="" person_seen=0
  if [ "${SCAN_COMPLETE:-0}" -eq 1 ] && [ "$_skv" != skew ]; then
    for mac in "${!l_rssi[@]}"; do
      [ -z "${p_rssi[$mac]:-}" ] && continue   # overlap-only: needs both vantages to localize
      local nm="${l_name[$mac]:-${p_name[$mac]:-?}}"
      [ "$(dev_class "$nm" "$mac")" = PERSONAL ] || continue
      person_seen=$((person_seen + 1))
      case "$(closest_node "$mac")" in
        "$SELF") self_zone="${self_zone:+$self_zone, }${nm}" ;;
        *)       peer_zone="${peer_zone:+$peer_zone, }${nm}" ;;
      esac
    done
    if [ "$person_seen" -eq 0 ]; then
      echo "person-zone: no DUAL-VANTAGE personal device — zone UNKNOWN (appliances/single-vantage devices don't localize a person)"
    else
      echo "person-zone: ${self_zone:+near ${SELF}: [${self_zone}]}${self_zone:+ · }${peer_zone:+near peer: [${peer_zone}]}  (weak person-location hint; not a presence verdict)"
    fi
  elif [ "${SCAN_COMPLETE:-0}" -eq 1 ]; then
    echo "person-zone: UNKNOWN — vantages ${SCAN_SKEW_S}s apart (> maxskew ${SCAN_MAXSKEW_S}s); a zone is a COMPARISON and this pair is not a consistent cut"
  else
    echo "person-zone: UNKNOWN — peer scan INCOMPLETE (${PEER_FAIL_REASON:-unknown}); cross-vantage localization invalid this cycle"
  fi

  # skew= is logged EVERY cycle, ok or not, so MESH_FUSE_MAXSKEW_S is calibrated against the real
  # corpus of sequential-scan gaps instead of being defended in prose (the frozen-median trap).
  # Compose the field ONCE: "${SCAN_SKEW_S:-na}s" renders the unmeasured cycle as "nas", a unit
  # glued to a non-number that every future parser has to special-case.
  local _skf="na"; [ -n "${SCAN_SKEW_S}" ] && _skf="${SCAN_SKEW_S}s"
  echo "$TS ${SELF}+peer overlap=$overlap self_unique=$unique_self peer_unique=$unique_peer person_dualvantage=${person_seen} skew=${_skf}/${_skv}" >> "$MESH/presence-fusion.log"
  mesh-state-touch "$STATE"

  # Compact 1-line summary for the senses dash (mirrors wifi-crossval.state; dash just cats it, never
  # runs this expensive 2-vantage scan per frame). Honest-fusion: an INCOMPLETE peer scan is recorded
  # AS incomplete so the dash never shows a confident cross-vantage map built on a half-failed cycle.
  if [ "${SCAN_COMPLETE:-0}" -eq 1 ] && [ "$_skv" = skew ]; then
    printf '%s | %d shared · %d uniq@%s · %d uniq@peer | zone UNKNOWN — vantages %ss apart (> maxskew %ss), not a consistent cut\n' \
      "$TS" "$overlap" "$unique_self" "$SELF" "$unique_peer" "${SCAN_SKEW_S}" "${SCAN_MAXSKEW_S}" \
      > "$MESH/ble-spacemap.state" 2>/dev/null || true
  elif [ "${SCAN_COMPLETE:-0}" -eq 1 ]; then
    local pz="person-zone UNKNOWN (no dual-vantage personal device)"
    [ "${person_seen:-0}" -gt 0 ] && pz="person ${self_zone:+@${SELF}:[${self_zone}]}${peer_zone:+ @peer:[${peer_zone}]}"
    printf '%s | %d shared · %d uniq@%s · %d uniq@peer | %s\n' \
      "$TS" "$overlap" "$unique_self" "$SELF" "$unique_peer" "$pz" \
      > "$MESH/ble-spacemap.state" 2>/dev/null || true
  else
    printf '%s | INCOMPLETE — peer scan failed (%s); cross-vantage map invalid this cycle\n' \
      "$TS" "${PEER_FAIL_REASON:-peer unreachable}" > "$MESH/ble-spacemap.state" 2>/dev/null || true
  fi
}

if [ "${#TRACK[@]}" -gt 0 ] && [ "$MODE" = oneshot ]; then MODE=once; fi

case "$MODE" in
  once)
    scan_both
    print_overlap
    check_tracked_zones
    ;;
  stream)
    echo "[mesh-presence-fuse] stream every ${INTERVAL}s on $SELF → $PEER_USER@$PEER_HOST"
    [ "${#TRACK[@]}" -gt 0 ] && echo "[mesh-presence-fuse] tracking: ${TRACK[*]}"
    while true; do
      : > "$BEAT"
      scan_both 2>/dev/null || true
      if [ "${#TRACK[@]}" -gt 0 ]; then
        check_tracked_zones
      else
        print_overlap
      fi
      elapsed=0
      while [ "$elapsed" -lt "$INTERVAL" ]; do
        nap=$((INTERVAL - elapsed)); [ "$nap" -gt 60 ] && nap=60
        sleep "$nap"; elapsed=$((elapsed + nap))
        : > "$BEAT"
      done
    done
    ;;
  *)
    scan_both
    print_overlap
    ;;
esac
