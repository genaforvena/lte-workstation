#!/usr/bin/env bash
# mesh-presence-fuse — cross-node BLE proximity fusion
# smoke-test: --test checks mesh-presence available
# Collect BLE presence from self + peer, find overlapping devices,
# compare RSSI → determine which node each device is closest to.
#
# Usage:
#   mesh-presence-fuse [peer-host] [peer-user]
#   mesh-presence-fuse --test
#   Default peer: imozerov@100.125.157.75 (default-string)
set -uo pipefail

if [ "${1:-}" = --test ]; then
  command -v mesh-presence >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-presence)"; exit 1; }
  echo "smoke-test: ok"; exit 0
fi

PEER_HOST="${1:-100.125.157.75}"
PEER_USER="${2:-imozerov}"
SELF="$(hostname)"
MESH="$HOME/.mesh"; mkdir -p "$MESH"
TS="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

echo "=== mesh-presence-fuse @ $TS ==="

# Collect local presence (10s scan)
local_out="$(mesh-presence 10 2>/dev/null)"
local_ts="$(echo "$local_out" | head -1 | grep -oP '@ \K.*')"
local_devices="$(echo "$local_out" | grep -E '^-?[0-9]+\|' || true)"

# Collect peer presence via SSH (use full path — non-interactive SSH has no ~/.local/bin in PATH)
peer_out="$(ssh "${PEER_USER}@${PEER_HOST}" "\$HOME/.local/bin/mesh-presence 10" 2>/dev/null)"
peer_ts="$(echo "$peer_out" | head -1 | grep -oP '@ \K.*')"
peer_devices="$(echo "$peer_out" | grep -E '^-?[0-9]+\|' || true)"

# Build associative arrays from local data
declare -A l_rssi l_name
while IFS='|' read -r rssi mac name; do
  [ -z "$mac" ] && continue
  l_rssi["$mac"]="$rssi"
  l_name["$mac"]="$name"
done <<< "$local_devices"

# Build from peer data
declare -A p_rssi p_name
while IFS='|' read -r rssi mac name; do
  [ -z "$mac" ] && continue
  p_rssi["$mac"]="$rssi"
  p_name["$mac"]="$name"
done <<< "$peer_devices"

# resolve peer hostname ONCE (was an ssh call per overlap device — steward review)
PEER_NAME="$(ssh "${PEER_USER}@${PEER_HOST}" 'hostname' 2>/dev/null || echo peer)"

# Find overlap (device seen by both)
echo ""
echo "--- Overlap (seen by BOTH nodes) ---"
echo "MAC|Name|Closest|${SELF} RSSI|Peer RSSI"
overlap=0
for mac in "${!l_rssi[@]}"; do
  [ -z "${p_rssi[$mac]:-}" ] && continue
  overlap=$((overlap + 1))
  lr="${l_rssi[$mac]}"; pr="${p_rssi[$mac]}"
  name="${l_name[$mac]:-${p_name[$mac]:-?}}"
  closest="$SELF"
  [ "$pr" -gt "$lr" ] && closest="$PEER_NAME"
  echo "${mac}|${name}|${closest}|${lr}|${pr}"
done
[ "$overlap" -eq 0 ] && echo "(none found)"

# Devices unique to self
echo ""
echo "--- Unique to $SELF ---"
echo "MAC|Name|RSSI"
unique_self=0
for mac in "${!l_rssi[@]}"; do
  [ -n "${p_rssi[$mac]:-}" ] && continue
  unique_self=$((unique_self + 1))
  echo "${mac}|${l_name[$mac]:-?}|${l_rssi[$mac]}"
done
[ "$unique_self" -eq 0 ] && echo "(none)"

# Devices unique to peer
echo ""
echo "--- Unique to peer ---"
echo "MAC|Name|RSSI"
unique_peer=0
for mac in "${!p_rssi[@]}"; do
  [ -n "${l_rssi[$mac]:-}" ] && continue
  unique_peer=$((unique_peer + 1))
  echo "${mac}|${p_name[$mac]:-?}|${p_rssi[$mac]}"
done
[ "$unique_peer" -eq 0 ] && echo "(none)"

echo ""
echo "=== Summary: ${overlap} overlap, ${unique_self} unique to ${SELF}, ${unique_peer} unique to peer ==="

# Log fusion snapshot
echo "$TS ${SELF}+peer overlap=$overlap self_unique=$unique_self peer_unique=$unique_peer" >> "$MESH/presence-fusion.log"
