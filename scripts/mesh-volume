#!/usr/bin/env bash
# mesh-volume — the mesh's hand on this node's audio volume (actuator). No sudo: PipeWire/wpctl.
# Useful because the voice channel (mesh-say / mesh-converse) speaks through this sink — the mesh
# (or operator by text) can turn itself up/down. Set up under "all nodes open" (operator's lab).
#
#   mesh-volume              print current volume (0-100)
#   mesh-volume 45           set to 45%
#   mesh-volume up|down      ±5%
#   mesh-volume mute|unmute
#   mesh-volume --test       smoke test (a working volume control exists)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
SINK="@DEFAULT_AUDIO_SINK@"

have(){ command -v wpctl >/dev/null 2>&1; }
get(){ wpctl get-volume "$SINK" 2>/dev/null | grep -oE '[0-9]+\.[0-9]+' | head -1 | awk '{printf "%d", $1*100}'; }

if [ "${1:-}" = --test ]; then
  have || { echo "smoke-test: FAIL (no wpctl/PipeWire volume control)"; exit 1; }
  v="$(get)"; [ -n "$v" ] || { echo "smoke-test: FAIL (cannot read volume)"; exit 1; }
  echo "smoke-test: ok (volume readable: ${v}%)"; exit 0
fi

have || { echo "mesh-volume: no wpctl (PipeWire) on this node" >&2; exit 1; }
arg="${1:-}"
case "$arg" in
  "")        echo "volume: $(get)%" ;;
  up)        wpctl set-volume "$SINK" 5%+ && echo "volume: $(get)%" ;;
  down)      wpctl set-volume "$SINK" 5%- && echo "volume: $(get)%" ;;
  mute)      wpctl set-mute "$SINK" 1 && echo "muted" ;;
  unmute)    wpctl set-mute "$SINK" 0 && echo "unmuted (volume: $(get)%)" ;;
  *[!0-9]*)  echo "usage: mesh-volume [0-100|up|down|mute|unmute]" >&2; exit 1 ;;
  *)         [ "$arg" -le 100 ] 2>/dev/null || { echo "0-100 only" >&2; exit 1; }
             wpctl set-volume "$SINK" "${arg}%" && echo "volume: $(get)%" ;;
esac
