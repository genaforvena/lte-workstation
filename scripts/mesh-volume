#!/usr/bin/env bash
# mesh-volume — the mesh's hand on this node's audio volume (actuator). No sudo: PipeWire/wpctl.
# Useful because the voice channel (mesh-say / mesh-converse) speaks through this sink — the mesh
# (or operator by text) can turn itself up/down. Set up under "all nodes open" (operator's lab).
#
#   mesh-volume              print current volume (0-100)
#   mesh-volume 45           set to 45%
#   mesh-volume up|down      ±5%
#   mesh-volume mute|unmute
#   mesh-volume --test       smoke test (a working volume control exists)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
SINK="@DEFAULT_AUDIO_SINK@"

have(){ command -v wpctl >/dev/null 2>&1; }
get(){ wpctl get-volume "$SINK" 2>/dev/null | grep -oE '[0-9]+\.[0-9]+' | head -1 | awk '{printf "%d", $1*100}'; }

if [ "${1:-}" = --test ]; then
  have || { echo "smoke-test: FAIL (no wpctl/PipeWire volume control)"; exit 1; }
  command -v mktemp >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mktemp)"; exit 1; }
  command -v cat    >/dev/null 2>&1 || { echo "smoke-test: FAIL (no cat)"; exit 1; }
  command -v grep   >/dev/null 2>&1 || { echo "smoke-test: FAIL (no grep)"; exit 1; }
  command -v awk    >/dev/null 2>&1 || { echo "smoke-test: FAIL (no awk)"; exit 1; }
  tmp="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp failed)"; exit 1; }
  trap 'rm -rf "$tmp"' EXIT
  log="$tmp/wpctl.log"
  # Negative control: the real command must fail cleanly if PipeWire control disappears.
  if env -i PATH=/tmp/empty HOME="$HOME" XDG_RUNTIME_DIR=/tmp/xdg /bin/bash "$0" >/dev/null 2>&1; then
    echo "smoke-test: FAIL (missing wpctl should not pass)"; exit 1
  fi
  mkdir -p "$tmp/bin"
  cat > "$tmp/bin/wpctl" <<'EOF'
#!/usr/bin/env bash
set -uo pipefail
: "${WPCTL_LOG:?missing WPCTL_LOG}"
printf '%s\n' "$*" >> "$WPCTL_LOG"
case "$1" in
  get-volume) printf 'Volume: 0.65 [MUTED]\n' ;;
  set-volume|set-mute) exit 0 ;;
  *) printf 'unexpected wpctl call: %s\n' "$*" >&2; exit 99 ;;
esac
EOF
  chmod +x "$tmp/bin/wpctl" || { echo "smoke-test: FAIL (stub chmod failed)"; exit 1; }
  : > "$log"
  out="$(
    env PATH="$tmp/bin:/usr/bin:/bin" HOME="$HOME" XDG_RUNTIME_DIR=/tmp/xdg WPCTL_LOG="$log" /bin/bash "$0"
  )" || { echo "smoke-test: FAIL (no-arg dry-run failed)"; exit 1; }
  [ "$out" = "volume: 65%" ] || { printf 'smoke-test: FAIL (unexpected parse: %s)\n' "$out"; exit 1; }
  env PATH="$tmp/bin:/usr/bin:/bin" HOME="$HOME" XDG_RUNTIME_DIR=/tmp/xdg WPCTL_LOG="$log" /bin/bash "$0" 45 >/dev/null \
    || { echo "smoke-test: FAIL (numeric set branch failed)"; exit 1; }
  env PATH="$tmp/bin:/usr/bin:/bin" HOME="$HOME" XDG_RUNTIME_DIR=/tmp/xdg WPCTL_LOG="$log" /bin/bash "$0" up >/dev/null \
    || { echo "smoke-test: FAIL (up branch failed)"; exit 1; }
  env PATH="$tmp/bin:/usr/bin:/bin" HOME="$HOME" XDG_RUNTIME_DIR=/tmp/xdg WPCTL_LOG="$log" /bin/bash "$0" down >/dev/null \
    || { echo "smoke-test: FAIL (down branch failed)"; exit 1; }
  env PATH="$tmp/bin:/usr/bin:/bin" HOME="$HOME" XDG_RUNTIME_DIR=/tmp/xdg WPCTL_LOG="$log" /bin/bash "$0" mute >/dev/null \
    || { echo "smoke-test: FAIL (mute branch failed)"; exit 1; }
  env PATH="$tmp/bin:/usr/bin:/bin" HOME="$HOME" XDG_RUNTIME_DIR=/tmp/xdg WPCTL_LOG="$log" /bin/bash "$0" unmute >/dev/null \
    || { echo "smoke-test: FAIL (unmute branch failed)"; exit 1; }
  grep -Fxq 'get-volume @DEFAULT_AUDIO_SINK@' "$log" || { echo "smoke-test: FAIL (get-volume dry-run missing)"; exit 1; }
  grep -Fxq 'set-volume @DEFAULT_AUDIO_SINK@ 45%' "$log" || { echo "smoke-test: FAIL (set-volume branch missing)"; exit 1; }
  grep -Fxq 'set-volume @DEFAULT_AUDIO_SINK@ 5%+' "$log" || { echo "smoke-test: FAIL (up branch missing)"; exit 1; }
  grep -Fxq 'set-volume @DEFAULT_AUDIO_SINK@ 5%-' "$log" || { echo "smoke-test: FAIL (down branch missing)"; exit 1; }
  grep -Fxq 'set-mute @DEFAULT_AUDIO_SINK@ 1' "$log" || { echo "smoke-test: FAIL (mute branch missing)"; exit 1; }
  grep -Fxq 'set-mute @DEFAULT_AUDIO_SINK@ 0' "$log" || { echo "smoke-test: FAIL (unmute branch missing)"; exit 1; }
  [ "$(wc -l < "$log")" -eq 10 ] || { echo "smoke-test: FAIL (unexpected stub call count)"; exit 1; }
  echo "smoke-test: ok (wpctl dependency + dry-run branches verified)"; exit 0
fi

have || { echo "mesh-volume: no wpctl (PipeWire) on this node" >&2; exit 1; }
arg="${1:-}"
case "$arg" in
  "")        echo "volume: $(get)%" ;;
  up)        wpctl set-volume "$SINK" 5%+ && echo "volume: $(get)%" ;;
  down)      wpctl set-volume "$SINK" 5%- && echo "volume: $(get)%" ;;
  mute)      wpctl set-mute "$SINK" 1 && echo "muted" ;;
  unmute)    wpctl set-mute "$SINK" 0 && echo "unmuted (volume: $(get)%)" ;;
  *[!0-9]*)  echo "usage: mesh-volume [0-100|up|down|mute|unmute]" >&2; exit 1 ;;
  *)         [ "$arg" -le 100 ] 2>/dev/null || { echo "0-100 only" >&2; exit 1; }
             wpctl set-volume "$SINK" "${arg}%" && echo "volume: $(get)%" ;;
esac
