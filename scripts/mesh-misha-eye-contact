#!/usr/bin/env bash
# mesh-misha-eye-contact — Misha speaks up when the operator LOOKS HIM IN THE EYE (into the camera).
#
# Operator design (2026-07-04, Telegram): "пусть миша детектирует смотрит ли ему кто-то в глаза (в
# камеру), если да - то пусть говорит" + follow-up "когда смотрят в глаза - взять 5 минут что
# говорилось и вставить своё слово по теме (можно развёрнуто)". This composes with TWO pieces that
# already exist rather than rebuilding anything:
#   - mesh-face-recognize's Groq-vision pattern (tier-2 wake, mesh-misha-wake) → reused here for a
#     SEPARATE gaze judgment (own prompt/output, does NOT touch mesh-face-recognize's Ilya/Rozalia/
#     Nobody/Stranger contract — cross-sense vocab is a contract, other consumers grep that exact set).
#   - mesh-overhear --poke-mind already does EXACTLY "read the last ~5-7 min transcript, give a
#     developed 3-5 sentence opinion, speak it via mesh-room say" (its poke prompt says so verbatim) —
#     built for the thumbs-up/motion triggers. Eye contact is just a THIRD trigger for the same poke.
#
#   mesh-misha-eye-contact --frame <jpg>   EVENT-DRIVEN call: given an already-captured frame, classify
#                                           gaze+identity → on operator eye contact, cooldown-gated, call
#                                           mesh-overhear --poke-mind. This is how it's actually invoked:
#                                           mesh-cam-watch's motion loop (--daemon, real-time, no timer)
#                                           hands it a throwaway COPY of the frame it just captured for
#                                           motion-diffing — no extra capture, no separate poll. CONTRACT:
#                                           --frame CONSUMES the file (removes it when done) — the caller
#                                           must pass a disposable copy, never its own live $now/$PREV.
#   mesh-misha-eye-contact                 fallback standalone tick: classify on ~/.mesh/cam-prev.jpg if
#                                           fresh (age-gated) — for manual/ad-hoc use, NOT cron-wired (see
#                                           below: a fixed-interval timer was tried and REJECTED).
#   mesh-misha-eye-contact --status        print cooldown state
#   mesh-misha-eye-contact --test           sandboxed test (no camera, no Groq, no poke, no ssh)
#
# NOT A CRON REFLEX (operator 2026-07-04, Telegram, twice): a 1-min timer poll "won't catch anything" —
# eye contact is seconds long. Operator's standing principle: "таймеры — плохая практика, всегда
# предпочитать сбор данных в реальном времени и рефлекс на нечто в этих данных" (timers are bad practice;
# always prefer real-time data collection + a reflex on something IN that data). mesh-cam-watch already
# IS that real-time stream — a continuous --daemon loop polling the camera every CAM_POLL~1.5s and
# reacting to motion in the frame diff. So this tool has NO cron entry: mesh-cam-watch's cycle() calls
# `mesh-misha-eye-contact --frame "$now"` on every motion tick, reusing the frame it already grabbed.
# Genuinely idle (no motion) → never invoked → zero Groq spend, no wasted polling either.
#
# ROOM-NODE GUARD: mirrors mesh-misha-wake/mesh-room's is_room_node — exits 0 at once off the room node
# (no capture, no Groq, no cost) — harmless since mesh-cam-watch itself only runs there, but keeps this
# tool safe if ever invoked another way.
#
# Own COOLDOWN (separate from --poke-mind's internal --motion cooldown, and separate from mesh-cam-watch's
# own CAM_COOLDOWN alert-photo throttle): held eye contact / repeated motion ticks must NOT re-trigger the
# vision call (cost) or the poke (spam) on every ~1.5s cam-watch cycle. EYE_COOLDOWN_SEC bounds it — after
# a trigger, Misha stays quiet on gaze alone until it lapses, but reacts again once cooldown clears.
#
# Tunables (env): EYE_COOLDOWN_SEC=180 · EYE_WAKE_FACE="Ilya" (space-sep, the operator by default) ·
#   ROOM_NODE=imozerov@100.125.157.75 · MISHA_EYE_FRAME=~/.mesh/cam-prev.jpg (standalone-mode fallback
#   frame only — the --frame arg is what mesh-cam-watch actually uses) · MISHA_EYE_FRAME_MAX_AGE=30 (secs;
#   older ⇒ camera not live this tick ⇒ skip, never a faked verdict) ·
#   MISHA_EYE_OVERRIDE=<LOOKING:Ilya|NOT_LOOKING|...> (skip live capture+Groq — for --test / manual drive)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"   # cron's PATH is minimal; sibling mesh-* live here

MESH="$HOME/.mesh"
COOL_FILE="$MESH/misha-eye-last"        # epoch of the last gaze-triggered poke
LOG="$MESH/misha-eye.log"
COOLDOWN="${EYE_COOLDOWN_SEC:-180}"
WAKE_FACE="${EYE_WAKE_FACE:-Ilya}"
# ROOM_NODE resolution (2026-07-14): explicit env > ~/.mesh/nodes (node-local truth) > the historical
# ds default. This tool never sourced ~/.mesh/nodes, so after the room organs moved to mesh-home it
# kept ssh'ing to the RETIRED ds node. ROOM_NODE in restore.env does NOT reach here: tmux panes
# inherit the tmux SERVER's env, not mesh-restore's, and cron has no such env at all — ~/.mesh/nodes
# is the reliable path because each tool sources it itself at startup.
# Sourcing must NOT clobber an explicit override — the --test harnesses pass a deliberately
# unreachable ROOM_NODE, and a bare `. nodes` would rewrite it to localhost and gut the test.
_rn_explicit="${ROOM_NODE:-}"
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes" 2>/dev/null || true
ROOM_NODE="${_rn_explicit:-${ROOM_NODE:-imozerov@100.125.157.75}}"
FRAME="${MISHA_EYE_FRAME:-$MESH/cam-prev.jpg}"
FRAME_MAX_AGE="${MISHA_EYE_FRAME_MAX_AGE:-30}"
GROQ_ENV="$MESH/groq.env"
now(){ date +%s; }
stampnow(){ date -u +%FT%TZ; }
log(){ printf '%s  %s\n' "$(stampnow)" "$*" >> "$LOG"; }

is_wake_face(){ local f="$1" w; for w in $WAKE_FACE; do [ "${f,,}" = "${w,,}" ] && return 0; done; return 1; }

is_room_node(){
  [ "${MISHA_FORCE_LOCAL:-0}" = 1 ] && return 0
  local host="${ROOM_NODE#*@}" ip
  [ "$host" = localhost ] || [ "$host" = 127.0.0.1 ] && return 0
  for ip in $(tailscale ip -4 2>/dev/null) $(hostname -I 2>/dev/null); do
    [ "$ip" = "$host" ] && return 0
  done
  return 1
}

cooldown_active(){ [ -r "$COOL_FILE" ] || return 1; local e; read -r e < "$COOL_FILE" 2>/dev/null || return 1
                    [ -n "${e:-}" ] || return 1; [ "$(now)" -lt "$e" ]; }

# classify gaze+identity on a given frame -> echoes "LOOKING:<label>" | "NOT_LOOKING" | "NOBODY" | "" (error)
# $1: frame path (already known-fresh, e.g. handed straight from mesh-cam-watch's own capture) ·
# $2: 1 to age-gate the frame against FRAME_MAX_AGE (standalone/cam-prev.jpg mode), 0 to skip the check
#     (--frame mode: the caller just captured it, checking its age would be redundant/racy).
classify_gaze(){
  local frame="$1" gate_age="${2:-1}"
  if [ -n "${MISHA_EYE_OVERRIDE:-}" ]; then printf '%s' "$MISHA_EYE_OVERRIDE"; return; fi
  # The organ guards below are prerequisites of the NETWORK path only. The parser seam
  # (MISHA_EYE_RAW_RESPONSE) needs no key, no frame and no network — gating it behind them would make
  # the fabrication asserts dead code on exactly the keyless node where they still ought to run, and
  # they would fail for want of a key they never touch.
  if [ -z "${MISHA_EYE_RAW_RESPONSE+x}" ]; then
    # a groq.env is a prerequisite of the CLOUD path only (vendor/id model); the local ollama path
    # needs no key, so requiring the file there would silently no-op a keyless local node's eye.
    case "${MESH_VISION_MODEL:-qwen3-vl:4b-instruct}" in
      */*) [ -f "$GROQ_ENV" ] || return 0 ;;
    esac
    [ -f "$frame" ] || return 0
    if [ "$gate_age" = 1 ]; then
      local fnow fmt; fnow=$(date +%s); fmt=$(stat -c %Y "$frame" 2>/dev/null || echo 0)
      [ $(( fnow - fmt )) -le "$FRAME_MAX_AGE" ] || return 0   # stale frame ⇒ can't see this tick, honest-skip
    fi
  fi

  python3 - "$frame" "$GROQ_ENV" <<'PYEOF'
import sys, os, base64, json, subprocess

img_path, groq_env = sys.argv[1], sys.argv[2]

# ONE knob picks model + backend: a bare ollama tag (qwen3-vl:4b-instruct, no "/") → LOCAL GPU (free,
# default); a vendor-prefixed id (meta-llama/…, qwen/…) → Groq cloud. Groq RETIRED all llama-4 vision
# 2026-07-18 (meta-llama/llama-4-scout-17b-16e-instruct → 404) — every call here then returned
# ERR:api:* and the eye never fired. Local qwen3-vl is now the default: on-GPU, free, non-reasoning.
MODEL = os.environ.get("MESH_VISION_MODEL", "qwen3-vl:4b-instruct")
OLLAMA_URL = os.environ.get("MESH_OLLAMA_URL", "http://localhost:11434").rstrip("/")
VISION_NUM_CTX = int(os.environ.get("MESH_VISION_NUM_CTX", "8192"))
USE_LOCAL = "/" not in MODEL

TOKENS = ("LOOKING:Ilya", "LOOKING:Rozalia", "LOOKING:Stranger", "NOT_LOOKING", "NOBODY")

# THE RESPONSE MUST *BE* A TOKEN, NOT CONTAIN ONE (2026-07-16). The old loop asked
# `if tok.lower() in result.lower()` — a SUBSTRING scan over whatever prose came back. scout
# answers the bare token most of the time, but on a frame it cannot read it narrates instead,
# and the scan harvested a confident verdict out of the narration:
#   "The webcam shows a woman, Rozalia, NOT_LOOKING."          -> NOT_LOOKING
#   "...<BBOX>NOT_LOOKING</BBOX"                                -> NOT_LOOKING
#   "The webcam shows a woman, let's assume Rozalia. Output: LOOKING:Rozalia" -> LOOKING:Rozalia
# — all three measured live against a BLANK GREY FRAME (nothing there at all). Prose is the model
# declining to commit; harvesting a token out of it fabricates a verdict the model never gave.
# Requiring equality turns every one of those into the honest empty this file already promises
# ("unparseable -> honest empty, never a faked verdict"). Measured over 28 live blank-frame reads:
# substring fabricated 3, equality fabricates 1. NOBODY 17->16 — the one lost was itself harvested
# out of prose ("...person facing the desk. LOOKING: NOBODY (The"), i.e. right for the wrong reason.
# HONEST LIMIT: equality does NOT make this safe — 1 of 28 was a bare finish=stop "NOT_LOOKING" on
# that same empty frame. The model confabulates and no parser can fix that; equality only stops US
# from manufacturing extra confidence on top of it. See the --test notes on why the live gate
# therefore asserts a COMMITTED verdict, not a CORRECT one.
def _norm(s):
    # Strip wrapping whitespace/quotes/punctuation to a FIXED POINT. A single ordered chain cannot do
    # it: '"NOBODY".'.strip('"').strip(".") leaves 'NOBODY"' — the quote is peeled before the period
    # that was hiding it, so the closing quote survives and equality fails. Harmless under the old
    # substring scan, fatal under equality, which is why it surfaced only once the parser tightened.
    prev, r = None, s.strip()
    while r != prev:
        prev = r
        for ch in ('"', "'", "`", "*", ".", ":"):
            r = r.strip(ch)
        r = r.strip()
    return r

def parse_verdict(content, finish_reason):
    result = content.strip()
    if "</think>" in result:
        result = result.split("</think>", 1)[1]
    result = _norm(result)
    # finish=length means the budget cut the answer off mid-thought: the model never committed.
    # (Do NOT "fix" that by raising max_tokens — letting it finish only lets it narrate its way to
    # a fully-formed hallucination, and per-frame token budget is the TPM load that 429s the eye.)
    if finish_reason == "length":
        return ""
    for tok in TOKENS:
        if result.lower() == tok.lower():
            return tok
    return ""  # prose / truncation / anything else -> honest empty, never a faked verdict

# OFFLINE PARSER SEAM: exercise the REAL parser against a recorded response, no network, no key.
# MISHA_EYE_OVERRIDE bypasses classification entirely, so it can never gate the parse; this seam
# bypasses only the transport, which is exactly what the fabrication bug lived behind.
_raw = os.environ.get("MISHA_EYE_RAW_RESPONSE")
if _raw is not None:
    print(parse_verdict(_raw, os.environ.get("MISHA_EYE_RAW_FINISH", "stop")))
    sys.exit(0)

def load_key(path):
    try:
        with open(path) as f:
            for line in f:
                if line.startswith("GROQ_API_KEY="):
                    return line.split("=", 1)[1].strip().strip('"').strip("'")
    except OSError:
        return None   # no groq.env — fine on a local-only node; only the cloud path needs it
    return None

key = load_key(groq_env)
if not USE_LOCAL and not key:
    sys.exit(0)   # cloud backend selected but no key → production no-op (unchanged behaviour)

with open(img_path, "rb") as f:
    b64 = base64.b64encode(f.read()).decode("utf-8")

prompt = (
    "This is a frame from a home webcam. Answer two things about the main person in frame, if any:\n"
    "1) Are they looking DIRECTLY at the camera lens (real eye contact with the camera, not just facing "
    "generally toward the desk)?\n"
    "2) Who are they: a man at the desk = 'Ilya', a woman = 'Rozalia', nobody in frame = 'Nobody', anyone "
    "else = 'Stranger'.\n"
    "Output EXACTLY one token: 'LOOKING:<name>' if making eye contact with the camera (name one of Ilya/"
    "Rozalia/Stranger), 'NOT_LOOKING' if a person is present but not looking at the camera, or 'NOBODY' if "
    "the frame is empty. No other text."
)

# Keep the vision model NON-reasoning either backend: a reasoning model spends its whole budget on a
# <think> preamble (measured 482 completion tokens for scout's predecessor) → finish=length, no verdict
# token → "" mislabelled an honest empty; and per-frame that token load is the TPM that 429s the eye.
# qwen3-vl:4b-instruct answers the bare token directly (man→NOT_LOOKING, woman→LOOKING:Rozalia,
# empty→NOBODY). Same lesson mesh-tuner-eye learned 2026-06-20.
#
# A TRANSPORT FAILURE IS NOT A BLIND SENSE (2026-07-16). A failure must NOT collapse to print("") — a
# 401/429/404 and "the model returned no verdict" would then be the SAME string to every caller. Emit
# ERR:<why> instead: production no-ops on it exactly as before (react's `*)` arm), while --test can tell
# "organ unreachable right now" (honest n/a) from "the sense went blind" (a real regression). Both
# backends share this contract.
tmp_req = None
try:
    if USE_LOCAL:
        # LOCAL ollama on this node's GPU. num_ctx MUST hold a full-res frame (>4096 tok) or ollama 400s.
        # Base64 image blows past argv limit → temp file + -d @file. done_reason maps to finish_reason.
        payload = {"model": MODEL, "prompt": prompt, "images": [b64], "stream": False,
                   "options": {"temperature": 0.0, "num_ctx": VISION_NUM_CTX, "num_predict": 20}}
        tmp_req = "/tmp/misha-eye-req-%d.json" % os.getpid()
        with open(tmp_req, "w") as f: json.dump(payload, f)
        cmd = ["curl", "-s", "-m", "90", f"{OLLAMA_URL}/api/generate",
               "-H", "Content-Type: application/json", "-d", "@" + tmp_req]
        proc = subprocess.run(cmd, capture_output=True, text=True)
        if proc.returncode != 0:
            print("ERR:net:curl%d" % proc.returncode); sys.exit(0)
        try:
            data = json.loads(proc.stdout)
        except Exception:
            print("ERR:badjson"); sys.exit(0)
        if isinstance(data, dict) and data.get("error"):
            print("ERR:api:%s" % str(data["error"])[:40]); sys.exit(0)
        if not isinstance(data, dict) or "response" not in data:
            print("ERR:noresp"); sys.exit(0)
        print(parse_verdict(data["response"], data.get("done_reason", "stop")))
    else:
        payload = {
            "model": MODEL,
            "messages": [{
                "role": "user",
                "content": [
                    {"type": "text", "text": prompt},
                    {"type": "image_url", "image_url": {"url": f"data:image/jpeg;base64,{b64}"}},
                ],
            }],
            "temperature": 0.0,
            "max_tokens": 20,
        }
        cmd = ["curl", "-s", "-m", "30", "https://api.groq.com/openai/v1/chat/completions",
               "-H", "Content-Type: application/json", "-H", f"Authorization: Bearer {key}",
               "-d", json.dumps(payload)]
        proc = subprocess.run(cmd, capture_output=True, text=True)
        if proc.returncode != 0:
            print("ERR:net:curl%d" % proc.returncode); sys.exit(0)
        try:
            data = json.loads(proc.stdout)
        except Exception:
            print("ERR:badjson"); sys.exit(0)
        if isinstance(data, dict) and data.get("error"):
            code = (data["error"] or {}).get("code") or (data["error"] or {}).get("type") or "unknown"
            print("ERR:api:%s" % str(code)[:40]); sys.exit(0)
        choices = (data or {}).get("choices") or []
        if not choices:
            print("ERR:noresp"); sys.exit(0)
        ch = choices[0]
        print(parse_verdict(ch["message"]["content"], ch.get("finish_reason")))
except Exception as e:
    print("ERR:exc:%s" % type(e).__name__)
finally:
    if tmp_req:
        try: os.remove(tmp_req)
        except OSError: pass
PYEOF
}

# ---- --status ---------------------------------------------------------------------------------
if [ "${1:-}" = --status ]; then
  if cooldown_active; then read -r e < "$COOL_FILE"; echo "misha-eye-contact: cooldown active ($(( e - $(now) ))s left)"
  else echo "misha-eye-contact: ready (no cooldown — a gaze hit will trigger now)"; fi
  exit 0
fi

# ---- --test : sandboxed, no camera/Groq/poke/ssh -----------------------------------------------
if [ "${1:-}" = --test ]; then
  P=0; F=0; pass(){ P=$((P+1)); }; fail(){ F=$((F+1)); echo "  FAIL: $1"; }
  tmp="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
  bindir="$tmp/bin"; mkdir -p "$bindir"
  # mock mesh-overhear so a "trigger" never hits the real network/Bose
  printf '#!/bin/sh\necho "MOCK-POKE $*" >> "%s/poke.log"\n' "$tmp" > "$bindir/mesh-overhear"
  chmod +x "$bindir/mesh-overhear"
  self="$(command -v "$0" 2>/dev/null)"; [ -x "$self" ] || self="$0"
  mkdir -p "$tmp/.mesh"
  CL="$tmp/.mesh/misha-eye-last"
  run(){ PATH="$bindir:$PATH" HOME="$tmp" MISHA_FORCE_LOCAL=1 EYE_COOLDOWN_SEC="${COOL_T:-180}" \
         MISHA_EYE_OVERRIDE="$1" timeout 10 bash "$self" 2>/dev/null; }

  # 1. nobody in frame -> no cooldown stamp, no poke
  run NOBODY >/dev/null
  [ ! -e "$CL" ] && [ ! -s "$tmp/poke.log" ] && pass || fail "NOBODY must not trigger or arm cooldown"

  # 2. present but not looking -> no trigger
  run NOT_LOOKING >/dev/null
  [ ! -e "$CL" ] && [ ! -s "$tmp/poke.log" ] && pass || fail "NOT_LOOKING must not trigger"

  # 3. a stranger looking at the camera -> no trigger (operator-only, mirrors mesh-room who's privacy discipline)
  run LOOKING:Stranger >/dev/null
  [ ! -e "$CL" ] && [ ! -s "$tmp/poke.log" ] && pass || fail "a Stranger's eye contact must not trigger the operator poke"

  # 4. operator eye contact -> cooldown armed + poke fired exactly once
  run LOOKING:Ilya >/dev/null
  [ -e "$CL" ] && pass || fail "operator eye contact must arm the cooldown"
  [ "$(grep -c MOCK-POKE "$tmp/poke.log" 2>/dev/null || echo 0)" = 1 ] || fail "operator eye contact must poke exactly once"
  read -r e < "$CL" 2>/dev/null; [ -n "${e:-}" ] && [ "$e" -gt "$(date +%s)" ] && pass || fail "cooldown epoch must be in the future"

  # 5. --status reports the cooldown active
  PATH="$bindir:$PATH" HOME="$tmp" bash "$self" --status 2>/dev/null | grep -q 'cooldown active' && pass || fail "--status should report cooldown active"

  # 6. still within cooldown -> a second eye-contact hit does NOT re-poke
  run LOOKING:Ilya >/dev/null
  [ "$(grep -c MOCK-POKE "$tmp/poke.log" 2>/dev/null || echo 0)" = 1 ] || fail "held eye contact within cooldown must not re-poke"

  # 7. cooldown expired -> a fresh hit pokes again
  printf '%s\n' "$(( $(date +%s) - 5 ))" > "$CL"
  run LOOKING:Ilya >/dev/null
  [ "$(grep -c MOCK-POKE "$tmp/poke.log" 2>/dev/null || echo 0)" = 2 ] || fail "expired cooldown must allow a fresh trigger"

  # 8. --frame mode (the real mesh-cam-watch call path): fresh cooldown + a frame arg -> pokes, no age gate
  rm -f "$CL"; : > "$tmp/poke.log"
  runf(){ PATH="$bindir:$PATH" HOME="$tmp" MISHA_FORCE_LOCAL=1 EYE_COOLDOWN_SEC="${COOL_T:-180}" \
          MISHA_EYE_OVERRIDE="$1" timeout 10 bash "$self" --frame "$2" 2>/dev/null; }
  runf LOOKING:Ilya "$tmp/some-frame.jpg" >/dev/null
  if [ -e "$CL" ] && [ "$(grep -c MOCK-POKE "$tmp/poke.log" 2>/dev/null || echo 0)" = 1 ]; then pass
  else fail "--frame mode must classify+poke same as the default tick"; fi

  # 9. --frame with no frame path given -> honest no-op (no crash, no false trigger)
  rm -f "$CL"; : > "$tmp/poke.log"
  PATH="$bindir:$PATH" HOME="$tmp" MISHA_FORCE_LOCAL=1 timeout 10 bash "$self" --frame 2>/dev/null
  if [ ! -e "$CL" ] && [ ! -s "$tmp/poke.log" ]; then pass
  else fail "--frame with no path must no-op, never crash/trigger"; fi

  # 10. PARSER ASSERTS — deterministic, offline, no key, no network, no flake. Every fixture below is a
  # VERBATIM response scout returned to this tool's own prompt against a BLANK GREY FRAME (nothing in
  # shot), captured live 2026-07-16, n=30. The old substring parser harvested a confident verdict out of
  # each narrating one; a verdict must be the model's WORD, not a token we found lying inside its prose.
  # The live gate below cannot cover this (it is one stochastic draw); these are the real fabrication
  # gate. Drives the true parse path via the MISHA_EYE_RAW_RESPONSE seam — not a mock of it.
  praw(){ MISHA_EYE_RAW_RESPONSE="$1" MISHA_EYE_RAW_FINISH="${2:-stop}" \
          MISHA_EYE_OVERRIDE= classify_gaze "$tmp/no-such-frame.jpg" 0 2>/dev/null; }

  # a bare token IS a verdict — the sense must still see (guards against over-tightening into blindness)
  [ "$(praw 'NOBODY')" = NOBODY ] && pass || fail "parser rejected a bare NOBODY — over-tightened into blindness"
  [ "$(praw 'NOT_LOOKING')" = NOT_LOOKING ] && pass || fail "parser rejected a bare NOT_LOOKING"
  [ "$(praw '"NOBODY".')" = NOBODY ] && pass || fail "parser rejected a quoted/punctuated NOBODY (formatting tolerance)"
  # ...but PROSE mentioning a token is NOT a verdict. All three fabricated on an EMPTY frame before the fix.
  [ -z "$(praw 'The webcam shows a woman, Rozalia, NOT_LOOKING.')" ] \
    && pass || fail "parser FABRICATED a verdict out of prose (the 2026-07-16 substring bug is back)"
  [ -z "$(praw 'The webcam shows $\textcolor{}$ and subsequently <BBOX>NOT_LOOKING</BBOX' length)" ] \
    && pass || fail "parser FABRICATED a verdict out of truncated prose"
  [ -z "$(praw "The webcam shows a woman, let's assume Rozalia. Output: LOOKING:Rozalia" length)" ] \
    && pass || fail "parser FABRICATED LOOKING:Rozalia out of prose on an empty frame"
  [ -z "$(praw 'The webcam shows a person facing the desk. LOOKING: NOBODY ( The')" ] \
    && pass || fail "parser harvested NOBODY out of prose — right answer, wrong reason; still a fabrication"
  # a truncated bare token is not a commitment either
  [ -z "$(praw 'NOBODY' length)" ] && pass || fail "parser accepted a finish=length answer as committed"

  # 11. REAL-READ GATE: every assert above drives MISHA_EYE_OVERRIDE, so all 9 stayed green for the
  # entire life of the tool while the vision call itself returned "" on every frame (reasoning model,
  # 482 tokens needed vs max_tokens=20 → finish=length → no verdict → parsed to an "honest empty").
  # A classifier test that never calls the classifier asserts nothing about seeing. So: drive a REAL
  # Groq read of a generated blank frame, which must read NOBODY. Exit 2 (honest n/a) where the organ
  # is absent — no key, no ffmpeg, no network — so mesh-land still lands off the room node.
  eyekey=""; [ -f "$GROQ_ENV" ] && eyekey=$(sed -n 's/^GROQ_API_KEY=//p' "$GROQ_ENV" | tr -d '"'"'"' ' | head -1)
  # The default backend is LOCAL ollama (no key). A bare-tag MESH_VISION_MODEL needs the ollama server
  # up + the model pulled; a vendor/id needs a Groq key. Either way ffmpeg must synth the frame.
  vmodel="${MESH_VISION_MODEL:-qwen3-vl:4b-instruct}"; ourl="${MESH_OLLAMA_URL:-http://localhost:11434}"
  backend_ok=0
  case "$vmodel" in
    */*) [ -n "$eyekey" ] && backend_ok=1 ;;
    *)   curl -s -m 3 "$ourl/api/tags" 2>/dev/null \
           | python3 -c "import json,sys; b='${vmodel%%:*}'; n=[m.get('name','') for m in json.load(sys.stdin).get('models',[])]; sys.exit(0 if any(x=='$vmodel' or x.split(':',1)[0]==b for x in n) else 1)" 2>/dev/null \
           && backend_ok=1 ;;
  esac
  if [ "$backend_ok" = 0 ] || ! command -v ffmpeg >/dev/null 2>&1; then
    rm -rf "$tmp"
    echo "smoke-test: n/a — vision backend '$vmodel' unavailable (ollama/model absent or no Groq key) or no ffmpeg (offline asserts: $P passed, $F failed)"
    [ "$F" -eq 0 ] && exit 2 || exit 1
  fi
  if ffmpeg -y -f lavfi -i color=c=gray:s=320x240 -frames:v 1 "$tmp/blank.jpg" -loglevel error 2>/dev/null; then
    # UP TO 3 DRAWS, and that count is a MEASUREMENT, not a ritual. Under the tightened parser this
    # frame yields a committed verdict 17/28 of the time and prose (-> honest "") the other 11/28, so a
    # ONE-draw "must commit" assert is a ~39% coin flip — I shipped exactly that for one edit and watched
    # two runs of identical code disagree. Redrawing collapses it: P(3 straight non-commits | healthy) is
    # ~6% at p̂=.39, and ~20% at the pessimistic end of that proportion's 95% CI (n=28 — a thin n, so the
    # bound, not the point estimate, is what to size against). mesh-doctor re-runs a failing --test up to
    # 4x, so even the pessimistic case is <1% per doctor run, while a TRULY blind sense (the qwen bug:
    # "" on every frame, forever) still fails all 3 every time. Expected cost ~1.6 Groq calls/test.
    live=""; _draws=0
    while [ "$_draws" -lt 3 ]; do
      _draws=$(( _draws + 1 ))
      live=$(MISHA_EYE_OVERRIDE= GROQ_ENV="$GROQ_ENV" classify_gaze "$tmp/blank.jpg" 0 2>/dev/null)
      case "$live" in
        "") continue ;;   # model declined to commit on this OOD frame — redraw, that is its right
        *)  break ;;      # committed verdict, or ERR:* (organ unreachable — redrawing won't help)
      esac
    done
    # WHAT THIS GATE CAN AND CANNOT ASSERT (rewritten 2026-07-16, from 30 live reads of this exact
    # blank frame). It used to demand NOBODY. That is not a property of OUR code — it is a property of
    # the model's mood on an out-of-distribution input: a synthetic grey void is not "an empty room",
    # it is an image scout cannot read, so it confabulates ("a woman, Rozalia", "a person at the desk").
    # NOBODY came back 17/28 — so the old one-draw assert was a ~39% coin flip, and the FAIL it printed
    # ("the sense is blind (model/token-budget regression)") was a confident wrong diagnosis of a
    # perfectly healthy sense. A gate that cries wolf 39% of the time teaches you to ignore [doctor].
    # So: assert what IS ours and IS deterministic — the read reaches the model, comes back, and parses
    # to a COMMITTED verdict from the allowed set. That still catches the exact regression this gate was
    # built for (the qwen token-budget bug returned "" on EVERY frame, forever). Whether the verdict is
    # NOBODY or NOT_LOOKING on a grey void is the model's business; the fabrication invariant that IS
    # ours is asserted offline and deterministically by the parser asserts above.
    case "$live" in
      ERR:*)  rm -rf "$tmp"
              echo "smoke-test: n/a — vision organ unreachable ($live; 401/429/network — NOT a code regression) (offline asserts: $P passed, $F failed)"
              [ "$F" -eq 0 ] && exit 2 || exit 1 ;;
      NOBODY|NOT_LOOKING|LOOKING:*) pass ;;
      "")     fail "LIVE vision read reached the model but parsed to NO COMMITTED VERDICT in $_draws draws — the sense is blind (model/token-budget regression); this is the bug the offline asserts cannot see" ;;
      *)      fail "LIVE vision read returned a label outside the allowed set: '$live'" ;;
    esac
    # RED-first: the RETIRED Groq id must fail LOUD (ERR:*), never a committed verdict — proves a dead
    # cloud model can't silently masquerade as a working eye. Needs a key for the (free, 404) Groq call.
    if [ -n "$eyekey" ]; then
      dead=$(MISHA_EYE_OVERRIDE= MESH_VISION_MODEL='meta-llama/llama-4-scout-17b-16e-instruct' \
             GROQ_ENV="$GROQ_ENV" classify_gaze "$tmp/blank.jpg" 0 2>/dev/null)
      case "$dead" in
        ERR:*) pass ;;
        NOBODY|NOT_LOOKING|LOOKING:*) fail "retired Groq id produced a COMMITTED verdict '$dead' — a dead model is faking a read" ;;
        *)     fail "retired Groq id did NOT fail loud (got '$dead', expected ERR:*) — a dead primary is silently blind" ;;
      esac
    fi
  else
    rm -rf "$tmp"; echo "smoke-test: n/a — ffmpeg could not synth a frame"; [ "$F" -eq 0 ] && exit 2 || exit 1
  fi

  rm -rf "$tmp"
  echo "smoke-test: $([ "$F" -eq 0 ] && echo ok || echo FAIL) — asserts: $P passed, $F failed"
  [ "$F" -eq 0 ]; exit
fi

# ---- react on a classified label: cooldown-gate the poke, log, done ------------------------------
react(){
  local label="$1"
  case "$label" in
    LOOKING:*)
      local face="${label#LOOKING:}"
      if is_wake_face "$face"; then
        printf '%s\n' "$(( $(now) + COOLDOWN ))" > "$COOL_FILE"
        log "[misha-eye-contact] eye contact from operator ($face) -> poking room mind to weigh in"
        mesh-overhear --poke-mind >/dev/null 2>&1 || true
      fi
      # a Stranger/Rozalia making eye contact is NOT the standing-task's operator-contact trigger — no
      # poke, no cooldown burn (so an actual operator look right after still fires promptly).
      ;;
    *) : ;;   # NOT_LOOKING / NOBODY / "" (stale frame, no key, no committed verdict) / ERR:* (organ
              # unreachable: 401/429/network) — nothing to do, honest no-op. ERR:* lands here by design:
              # it is a verdict-free string, so an unreachable organ stays a no-op, same as before.
  esac
}

# ---- --frame <jpg> : EVENT-DRIVEN call from mesh-cam-watch's motion loop --------------------------
if [ "${1:-}" = --frame ]; then
  shift; frame="${1:-}"
  # CONTRACT (sense-liveness 2026-07-10): --frame CONSUMES the file (removes it) on every exit path —
  # the caller hands off a disposable mktemp copy specifically so this tool owns cleanup. Before this
  # fix no path ever rm'd it, so wiring a real caller (mesh-cam-watch) would have leaked one JPEG per
  # motion-cooldown tick into /tmp forever (found while wiring the first real --frame caller in).
  trap '[ -n "${frame:-}" ] && rm -f "$frame"' EXIT
  is_room_node || exit 0
  [ -n "$frame" ] || exit 0
  cooldown_active && exit 0   # held gaze / repeated motion ticks within the window: no Groq spend
  react "$(classify_gaze "$frame" 0)"   # 0 = caller's frame is already known-fresh, skip age gate
  exit 0
fi

# ---- default: standalone fallback tick (manual/ad-hoc — NOT cron-wired, see header) ---------------
is_room_node || exit 0   # ROOM-NODE GUARD: nothing to do (and nothing spent) off the room node
cooldown_active && exit 0   # held gaze / repeat looks within the window: stay quiet, no Groq spend

react "$(classify_gaze "$FRAME" 1)"
exit 0
