#!/usr/bin/env bash
# mesh-revert-catch — catch WHO reverts the egress node back to full-tunnel.
#
# Polls the host's own egress. The invariant is: host default route is NEVER via a
# WireGuard tunnel (Gtcld). The moment it is, this snapshots the evidence — process
# tree + every tmux pane's recent scrollback filtered for routing commands — so the
# offending agent's own pane history reveals the culprit. Pure observation, no sudo,
# changes nothing.
set -uo pipefail
SESSION="$(hostname)"
OUT=/tmp/mesh-revert-evidence; mkdir -p "$OUT"
log(){ echo "[revert-catch $(date -u +%H:%M:%SZ)] $*"; }
log "watching host egress on $SESSION; snapshot on full-tunnel (dev Gtcld / table 51820)"
seen=0
while true; do
  dev=$(ip route get 1.1.1.1 2>/dev/null | grep -oP 'dev \K\S+' | head -1)
  ft=0
  [ "$dev" = Gtcld ] && ft=1
  ip route show table 51820 2>/dev/null | grep -q . && ft=1
  if [ "$ft" = 1 ]; then
    if [ "$seen" = 0 ]; then
      ts=$(date -u +%Y%m%dT%H%M%SZ); f="$OUT/violation-$ts.log"
      log "VIOLATION (host egress dev=$dev) — snapshotting to $f"
      {
        echo "=== $ts  host egress dev=$dev — FULL-TUNNEL VIOLATION ==="
        echo "--- ip route get 1.1.1.1 ---"; ip route get 1.1.1.1 2>/dev/null | head -2
        echo "--- offending rules ---"; ip rule show | grep -E '519[0-9]|520[0-9]'
        echo "--- table 51820 ---"; ip route show table 51820 2>/dev/null
        echo "--- live ip/wg processes ---"; ps -ef | grep -E '[i]p route|[i]p rule|[w]g-quick|[w]g ' | head
        echo "--- agents ---"; ps -u "$USER" -o pid,tty,etime,cmd | grep -E 'claude|opencode' | grep -v grep
        echo "--- per-pane scrollback (routing commands only) ---"
        for p in $(tmux list-panes -s -t "$SESSION" -F '#{window_index}.#{pane_index}' 2>/dev/null); do
          hit=$(tmux capture-pane -t "$SESSION:$p" -p -S -60 2>/dev/null | grep -iE 'wg-quick|ip route|ip rule|Gtcld|51820|full.?tunnel|AllowedIPs' | tail -8)
          [ -n "$hit" ] && { echo "### CULPRIT CANDIDATE pane $p ###"; echo "$hit"; }
        done
      } > "$f" 2>&1
      ~/.local/bin/mesh-trace "REVERT-CATCH: full-tunnel violation; evidence -> $f" >/dev/null 2>&1 || true
      log "evidence saved: $f"
      seen=1
    fi
  else
    [ "$seen" = 1 ] && log "back to clean route (dev=$dev) — re-arming"
    seen=0
  fi
  sleep 5
done
