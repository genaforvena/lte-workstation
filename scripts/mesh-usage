#!/usr/bin/env python3
# mesh-usage — today's mind token usage. HONESTY RULE (fusion empty≠failed): a source
# that cannot testify for TODAY reports '?', never a confident 0. A stale cache or a
# moved chat layout must be visibly different from genuine zero usage.
import json
import os
import glob
import sys
from datetime import datetime, timezone

def get_gemini_usage():
    # (input, output, cached) or None = source can't testify for today
    chat_dir = os.path.expanduser("~/.gemini/tmp/imozerov/chats/")
    files = glob.glob(os.path.join(chat_dir, "*.jsonl"))
    today = datetime.now(timezone.utc).date()
    fresh = [f for f in files
             if datetime.fromtimestamp(os.path.getmtime(f), timezone.utc).date() == today]
    if not fresh:
        return None  # nothing written today: moved layout or idle — can't tell which
    total_input, total_output, total_cached = 0, 0, 0
    for f in fresh:
        try:
            with open(f, 'r') as fd:
                for line in fd:
                    data = json.loads(line)
                    if "tokens" in data:
                        ts = datetime.fromisoformat(data["timestamp"].replace("Z", "+00:00")).date()
                        if ts == today:
                            t = data["tokens"]
                            total_input += t.get("input", 0)
                            total_output += t.get("output", 0)
                            total_cached += t.get("cached", 0)
        except Exception: continue
    return total_input, total_output, total_cached

def get_claude_usage():
    # total or None = cache can't testify for today (stats-cache only updates when the
    # stats UI runs — it froze 2026-05-28 while minds churned daily; 0 here was a lie)
    stats_file = os.path.expanduser("~/.claude/stats-cache.json")
    if not os.path.exists(stats_file): return None
    try:
        with open(stats_file, 'r') as f:
            data = json.load(f)
        today_str = datetime.now(timezone.utc).strftime("%Y-%m-%d")
        for entry in data.get("dailyModelTokens", []):
            if entry.get("date") == today_str:
                return sum(entry.get("tokensByModel", {}).values())
        # no entry for today: trust a 0 only if the cache itself was computed today
        if data.get("lastComputedDate") == today_str:
            return 0
        return None
    except Exception:
        return None

def get_opencode_usage():
    # total tokens (input+output+cache_read+cache_write) across opencode sessions touched today,
    # or None = source can't testify. opencode.db is the LIVE operational store (not a lazy cache
    # like claude's stats-cache), so a successful read summing to 0 is a GENUINE zero — None is
    # reserved for db-absent / read-error. Copy DB+WAL before reading: opencode holds a write lock
    # and recent tokens may live only in the uncheckpointed -wal (mirrors mesh-spend:310-346).
    # MESH_USAGE_DB overrides the path (fixture-testable).
    db = os.environ.get("MESH_USAGE_DB") or os.path.expanduser("~/.local/share/opencode/opencode.db")
    if not os.path.exists(db):
        return None  # no opencode db on this node (or moved) — can't testify
    import sqlite3, tempfile, shutil
    tmp = None
    try:
        # PREFIXED, not bare: the finally below is not enough — SIGKILL (cron `timeout`, OOM) strands
        # the copy, and a bare `tmpXXXXXXXX` holding 181MB of opencode.db names nobody. The prefix
        # both attributes the survivor and puts it inside mesh-tmp-guard's mesh-owned sweep.
        tmp = tempfile.mkdtemp(prefix="mesh-usage.")
        snap = os.path.join(tmp, "opencode.db")
        shutil.copy2(db, snap)
        for ext in ("-wal", "-shm"):
            if os.path.exists(db + ext):
                shutil.copy2(db + ext, snap + ext)
        midnight = datetime.now(timezone.utc).replace(hour=0, minute=0, second=0, microsecond=0)
        cutoff_ms = int(midnight.timestamp() * 1000)
        con = sqlite3.connect(snap)
        total = 0
        for row in con.execute(
            "SELECT tokens_input, tokens_output, tokens_cache_read, tokens_cache_write "
            "FROM session WHERE time_updated >= ?", (cutoff_ms,)
        ):
            total += sum((c or 0) for c in row)
        con.close()
        return total
    except Exception:
        return None  # schema drift / locked / corrupt — honest '?', never a fabricated 0
    finally:
        if tmp:
            shutil.rmtree(tmp, ignore_errors=True)

def fmt(v):
    return "?" if v is None else str(v)

def render():
    g = get_gemini_usage()
    ct = get_claude_usage()
    ot = get_opencode_usage()
    gi, go, gc = (g if g is not None else (None, None, None))
    known = [v for v in (gi, go, gc, ct, ot) if v is not None]
    total = "?" if len(known) < 5 else str(sum(known))
    return f"gemini(i={fmt(gi)} o={fmt(go)} c={fmt(gc)}) claude(t={fmt(ct)}) opencode(t={fmt(ot)}) total={total}"

if len(sys.argv) > 1 and sys.argv[1] == '--test':
    import re
    mesh = os.path.expanduser("~/.mesh")
    if not os.path.isdir(mesh):
        print("smoke-test: FAIL (~/.mesh not found)"); sys.exit(1)
    try:
        out = render()
        if not re.match(r"^gemini\(i=(\d+|\?) o=(\d+|\?) c=(\d+|\?)\) claude\(t=(\d+|\?)\) opencode\(t=(\d+|\?)\) total=(\d+|\?)$", out):
            print(f"smoke-test: FAIL (bad usage format: {out})"); sys.exit(1)
    except Exception as e:
        print(f"smoke-test: FAIL (usage probe failed: {e})"); sys.exit(1)
    # opencode tracking (RED-first): a fixture db with a KNOWN today-row must surface as a real
    # number and land in render(); a today-filter must exclude an older session; a MISSING db must
    # read as honest '?'. These assert the REAL sqlite path, not a stubbed classifier.
    import sqlite3, tempfile, shutil
    _td = tempfile.mkdtemp(prefix="mesh-usage-test.")
    try:
        _fx = os.path.join(_td, "oc.db")
        _con = sqlite3.connect(_fx)
        _con.execute("CREATE TABLE session (time_updated INTEGER, tokens_input INTEGER, "
                     "tokens_output INTEGER, tokens_cache_read INTEGER, tokens_cache_write INTEGER)")
        _now_ms = int(datetime.now(timezone.utc).timestamp() * 1000)
        _con.execute("INSERT INTO session VALUES (?,?,?,?,?)", (_now_ms, 100, 50, 30, 20))       # today → 200
        _con.execute("INSERT INTO session VALUES (?,?,?,?,?)",
                     (_now_ms - 2*86400*1000, 999, 999, 999, 999))                                # 2d ago → excluded
        _con.commit(); _con.close()
        os.environ["MESH_USAGE_DB"] = _fx
        _v = get_opencode_usage()
        if _v != 200:
            print(f"smoke-test: FAIL (opencode fixture: expected 200 today-only, got {_v})"); sys.exit(1)
        if "opencode(t=200)" not in render():
            print(f"smoke-test: FAIL (render missing opencode(t=200): {render()})"); sys.exit(1)
        os.environ["MESH_USAGE_DB"] = os.path.join(_td, "absent.db")
        if get_opencode_usage() is not None:
            print("smoke-test: FAIL (missing db must be None → '?')"); sys.exit(1)
        if "opencode(t=?)" not in render():
            print(f"smoke-test: FAIL (render missing opencode(t=?) for absent db: {render()})"); sys.exit(1)
    finally:
        os.environ.pop("MESH_USAGE_DB", None)
        shutil.rmtree(_td, ignore_errors=True)
    print("smoke-test: ok"); sys.exit(0)

if __name__ == "__main__":
    print(render())
