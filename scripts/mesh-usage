#!/usr/bin/env python3
# mesh-usage — today's mind token usage. HONESTY RULE (fusion empty≠failed): a source
# that cannot testify for TODAY reports '?', never a confident 0. A stale cache or a
# moved chat layout must be visibly different from genuine zero usage.
import json
import os
import glob
import sys
from datetime import datetime, timezone

def get_gemini_usage():
    # (input, output, cached) or None = source can't testify for today
    chat_dir = os.path.expanduser("~/.gemini/tmp/imozerov/chats/")
    files = glob.glob(os.path.join(chat_dir, "*.jsonl"))
    today = datetime.now(timezone.utc).date()
    fresh = [f for f in files
             if datetime.fromtimestamp(os.path.getmtime(f), timezone.utc).date() == today]
    if not fresh:
        return None  # nothing written today: moved layout or idle — can't tell which
    total_input, total_output, total_cached = 0, 0, 0
    for f in fresh:
        try:
            with open(f, 'r') as fd:
                for line in fd:
                    data = json.loads(line)
                    if "tokens" in data:
                        ts = datetime.fromisoformat(data["timestamp"].replace("Z", "+00:00")).date()
                        if ts == today:
                            t = data["tokens"]
                            total_input += t.get("input", 0)
                            total_output += t.get("output", 0)
                            total_cached += t.get("cached", 0)
        except Exception: continue
    return total_input, total_output, total_cached

def get_claude_usage():
    # total or None = cache can't testify for today (stats-cache only updates when the
    # stats UI runs — it froze 2026-05-28 while minds churned daily; 0 here was a lie)
    stats_file = os.path.expanduser("~/.claude/stats-cache.json")
    if not os.path.exists(stats_file): return None
    try:
        with open(stats_file, 'r') as f:
            data = json.load(f)
        today_str = datetime.now(timezone.utc).strftime("%Y-%m-%d")
        for entry in data.get("dailyModelTokens", []):
            if entry.get("date") == today_str:
                return sum(entry.get("tokensByModel", {}).values())
        # no entry for today: trust a 0 only if the cache itself was computed today
        if data.get("lastComputedDate") == today_str:
            return 0
        return None
    except Exception:
        return None

def fmt(v):
    return "?" if v is None else str(v)

def render():
    g = get_gemini_usage()
    ct = get_claude_usage()
    gi, go, gc = (g if g is not None else (None, None, None))
    known = [v for v in (gi, go, gc, ct) if v is not None]
    total = "?" if len(known) < 4 else str(sum(known))
    return f"gemini(i={fmt(gi)} o={fmt(go)} c={fmt(gc)}) claude(t={fmt(ct)}) total={total}"

if len(sys.argv) > 1 and sys.argv[1] == '--test':
    import re
    mesh = os.path.expanduser("~/.mesh")
    if not os.path.isdir(mesh):
        print("smoke-test: FAIL (~/.mesh not found)"); sys.exit(1)
    try:
        out = render()
        if not re.match(r"^gemini\(i=(\d+|\?) o=(\d+|\?) c=(\d+|\?)\) claude\(t=(\d+|\?)\) total=(\d+|\?)$", out):
            print(f"smoke-test: FAIL (bad usage format: {out})"); sys.exit(1)
    except Exception as e:
        print(f"smoke-test: FAIL (usage probe failed: {e})"); sys.exit(1)
    print("smoke-test: ok"); sys.exit(0)

if __name__ == "__main__":
    print(render())
