#!/usr/bin/env bash
# reflex-cadence: 2-59/15 * * * *
# reflex-args: --edge
# mesh-battery — the NODE'S OWN BATTERY health sense.
# Reads /sys/class/power_supply/BAT0/ (status, capacity, capacity_level, energy_full,
# energy_full_design, cycle_count, power_now) + /sys/class/power_supply/ADP0/online for AC state. Distinct from
# mesh-body-power, which reads the PHONE battery (termux-battery-status over SSH to the body):
# this sense is the LAPTOP/UPS-side equivalent — "is the node going to lose power? is the
# battery worn?" — answering the questions mesh-body-power is blind to.
#
#   mesh-battery            one-shot verdict: HEALTHY|ON_BATTERY|LOW_BATTERY|CHARGING|FULL|AGED|CRITICAL|NO_BATTERY|OFFLINE
#   mesh-battery --json     machine-readable {label, wear, status, capacity, capacity_level, cycle_count, power_now, online, ts}
#   mesh-battery --edge     emit only on label change (cron reflex)
#   mesh-battery --test     smoke test (synthetic sysfs fixtures, no hardware)
#
# Bands (FALSIFIABLE: change a threshold and the test flips):
#   NO_BATTERY   no BAT0 in /sys/class/power_supply/ (a desktop with no UPS — exit 0, honest "no battery here")
#   OFFLINE      BAT0 exists but cannot read required fields (permission, kernel quirk) — exit 2
#   CRITICAL     capacity < 15% AND not on mains (will lose power soon) OR full/design < 40% (battery is end-of-life)
#   AGED         full/design < 70% (battery is worn; not critical, but flagging for replacement awareness)
#   LOW_BATTERY  on battery + capacity < 25% (laptop is unplugged, charge is low)
#   ON_BATTERY   on battery + capacity ≥ 25% (laptop is unplugged, charge OK)
#   CHARGING     status=Charging
#   FULL         status=Full (on mains, battery topped off)
#   HEALTHY      on mains + capacity ≥ 25% + wear OK (default happy case)
#
# Exit codes (honest-exit contract):
#   0 = state assessed (including NO_BATTERY — the honest "this node has no battery" verdict)
#   2 = cannot read power_supply sysfs (e.g. no permission or missing kernel support) — never faked
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

# state path: MESH_BATTERY_STATE override wins; else MESH_TEST_SANDBOX=1 (mesh-doctor smoke sweeps +
# our own --test) diverts to a throwaway so a test self-invoke can never stamp the LIVE artifact —
# mtime here is liveness to the reflex watchdogs, and the --json fixture leg's content was a forged
# synthetic-battery verdict (task test-live-writes 2026-07-20, bruno-forgery class).
STATE="${MESH_BATTERY_STATE:-$HOME/.mesh/.battery-state}"
[ "${MESH_TEST_SANDBOX:-0}" != 1 ] || STATE="${MESH_BATTERY_STATE:-${TMPDIR:-/tmp}/.battery-state.sandbox.$$}"
MESH="${MESH_DIR:-$HOME/.mesh}"
PS_DIR="${MESH_POWER_SUPPLY_DIR:-/sys/class/power_supply}"
BAT_DIR="${MESH_BATTERY_DIR:-$PS_DIR/BAT0}"
ADP_DIR="${MESH_ADAPTER_DIR:-$PS_DIR/ADP0}"

# Calibrated cutoffs resolve ledger (uxn threshold-ledger rows battery-wear + battery-charge)
# > inline fallback. (Same charge-% axis as mesh-node-power's power-charge row with DIFFERENT
# edges 15/25 vs 5/20, and same wear axis as mesh-hw-health's hw-wear-floor 50 — the ledger
# keeps all three visible side by side; unifying is an operator calibration call.)
_ledger_const() { # <gate> <k> <fallback> — resolve a calibrated constant, naturals-only
  local repo="${MESH_REPO:-$HOME/lte-workstation}" led v=""
  led="${MESH_THRESHOLD_LEDGER:-$repo/scripts/uxn/threshold-ledger}"
  [ -f "$led" ] && [ -x "$repo/scripts/uxn/mesh-sexpr-gate" ] \
    && v="$(MESH_SEXPR_GATES="$led" "$repo/scripts/uxn/mesh-sexpr-gate" --const "$1" "$2" 2>/dev/null)"
  case "$v" in ''|*[!0-9]*) v="$3" ;; esac
  printf '%s\n' "$v"
}
BW_EOL="$(_ledger_const battery-wear eol 40)"
BW_AGED="$(_ledger_const battery-wear aged 70)"
BC_CRIT="$(_ledger_const battery-charge crit 15)"
BC_LOW="$(_ledger_const battery-charge low 25)"

# --- Classifiers (pure, offline-testable) ---
# classify_battery <status> <capacity> <wear_pct> <online> <has_bat> → echoes "LABEL|reason"
# Inputs:
#   status   = "Charging" | "Discharging" | "Full" | "Not charging" | "Unknown" | "OFFLINE"
#   capacity = 0-100 (integer) or "OFFLINE"
#   wear_pct = 0-100 (full/design * 100) or "OFFLINE"
#   online   = 0 | 1 (ADP0 online) or "OFFLINE"
#   has_bat  = "yes" | "no"
classify_battery() {
  local status="$1" cap="$2" wear="$3" online="$4" has_bat="$5"
  if [ "$has_bat" = "no" ]; then
    echo "NO_BATTERY|no BAT0 in /sys/class/power_supply (desktop / no UPS)"
    return
  fi
  if [ "$status" = "OFFLINE" ] || [ "$cap" = "OFFLINE" ] || [ "$wear" = "OFFLINE" ]; then
    echo "OFFLINE|could not read required power_supply fields (status=$status cap=$cap wear=$wear)"
    return
  fi
  # CRITICAL: end-of-life battery OR about to die
  # wear < eol% = the battery holds less than eol% of its design capacity — at end of life
  if [ "$wear" -lt "$BW_EOL" ] 2>/dev/null; then
    echo "CRITICAL|wear=$wear% (battery at end-of-life, holds < ${BW_EOL}% of design capacity)"
    return
  fi
  # capacity < crit% AND on battery = about to die
  if [ "$cap" -lt "$BC_CRIT" ] 2>/dev/null && [ "$online" = "0" ]; then
    echo "CRITICAL|capacity=$cap% on battery (about to lose power)"
    return
  fi
  # AGED: battery is worn but still useful
  if [ "$wear" -lt "$BW_AGED" ] 2>/dev/null; then
    echo "AGED|wear=$wear% (battery worn, < ${BW_AGED}% of design capacity — replacement candidate)"
    return
  fi
  # LOW_BATTERY: low charge AND unplugged
  if [ "$online" = "0" ] && [ "$cap" -lt "$BC_LOW" ] 2>/dev/null; then
    echo "LOW_BATTERY|capacity=$cap% on battery (charge is low)"
    return
  fi
  # ON_BATTERY: on battery, charge OK
  if [ "$online" = "0" ]; then
    echo "ON_BATTERY|capacity=$cap% on battery (unplugged, charge OK)"
    return
  fi
  # CHARGING: on mains, actively charging
  if [ "$status" = "Charging" ]; then
    echo "CHARGING|capacity=$cap% status=Charging (on mains, charging)"
    return
  fi
  # FULL: on mains, full charge
  if [ "$status" = "Full" ]; then
    echo "FULL|capacity=$cap% status=Full (on mains, topped off)"
    return
  fi
  # HEALTHY: default on-mains, capacity OK
  echo "HEALTHY|capacity=$cap% wear=$wear% on mains (status=$status)"
}

# --- Test mode ---
if [ "${1:-}" = --consts ]; then
  # observable artifact of the resolution (ledger > inline), same path classify_battery takes
  echo "eol=$BW_EOL aged=$BW_AGED crit=$BC_CRIT low=$BC_LOW"
  exit 0
fi

if [ "${1:-}" = --test ]; then
  # tmp fence — task:doctor-test-tmpdir-cleanup-traps. Re-exec the smoke test ONCE under a private
  # TMPDIR and remove it from the PARENT, so the cleanup cannot be lost to the test's own `exit 1`
  # and cannot be clobbered by an EXIT trap the test sets for itself. A nested --test inherits the
  # guard var and skips its own fence (it is already inside one).
  if [ -z "${MESH_TEST_TMPD:-}" ]; then
    MESH_TEST_TMPD="$(mktemp -d)" || { echo "smoke-test: FAIL (tmp fence: mktemp -d)"; exit 1; }
    trap 'rm -rf "$MESH_TEST_TMPD"' EXIT INT HUP TERM
    export MESH_TEST_TMPD TMPDIR="$MESH_TEST_TMPD" TMP="$MESH_TEST_TMPD" TEMP="$MESH_TEST_TMPD"
    _fence_rc=0; "$0" "$@" || _fence_rc=$?; exit "$_fence_rc"
  fi
  fail=0
  # TEST-SANDBOX (task test-live-writes 2026-07-20): the fixture --json leg and the real-read gate
  # below both drive "$0" through the live write path — pre-fix they stamped ~/.mesh/.battery-state
  # (on a desktop, with a FAKE 97%-battery verdict from the synthetic BAT0). Export the sandbox flag
  # so every self-invoke diverts its state write; the sig guard at the end proves it (mtime+size).
  export MESH_TEST_SANDBOX=1
  _live_state="$HOME/.mesh/.battery-state"
  _live_sig="$(stat -c '%Y %s' "$_live_state" 2>/dev/null || echo absent)"
  # NO_BATTERY: no BAT0
  r="$(classify_battery OFFLINE OFFLINE OFFLINE OFFLINE no)"
  [ "$r" = "NO_BATTERY|no BAT0 in /sys/class/power_supply (desktop / no UPS)" ] || { echo "  FAIL NO_BATTERY: got=$r"; fail=1; }
  # OFFLINE: BAT0 present but fields missing
  r="$(classify_battery OFFLINE 50 80 1 yes)"
  echo "$r" | grep -q '^OFFLINE' || { echo "  FAIL OFFLINE-status: got=$r"; fail=1; }
  r="$(classify_battery Discharging OFFLINE 80 1 yes)"
  echo "$r" | grep -q '^OFFLINE' || { echo "  FAIL OFFLINE-cap: got=$r"; fail=1; }
  r="$(classify_battery Discharging 50 OFFLINE 1 yes)"
  echo "$r" | grep -q '^OFFLINE' || { echo "  FAIL OFFLINE-wear: got=$r"; fail=1; }
  # CRITICAL: wear < 40
  r="$(classify_battery Discharging 80 30 1 yes)"
  echo "$r" | grep -q '^CRITICAL' || { echo "  FAIL CRITICAL-wear30: got=$r"; fail=1; }
  # CRITICAL: cap < 15 on battery
  r="$(classify_battery Discharging 10 80 0 yes)"
  echo "$r" | grep -q '^CRITICAL' || { echo "  FAIL CRITICAL-low-cap: got=$r"; fail=1; }
  # CRITICAL: cap < 15 on mains → NOT critical (covered by AGED or HEALTHY)
  r="$(classify_battery Charging 10 80 1 yes)"
  echo "$r" | grep -q '^CHARGING\|HEALTHY' || { echo "  FAIL critical-but-mains: got=$r (should not CRITICAL)"; fail=1; }
  # AGED: wear 40-70
  r="$(classify_battery Discharging 80 50 1 yes)"
  echo "$r" | grep -q '^AGED' || { echo "  FAIL AGED-wear50: got=$r"; fail=1; }
  r="$(classify_battery Discharging 80 69 1 yes)"
  echo "$r" | grep -q '^AGED' || { echo "  FAIL AGED-wear69: got=$r (boundary)"; fail=1; }
  # wear 70+ → not AGED
  r="$(classify_battery Discharging 80 70 1 yes)"
  echo "$r" | grep -q '^AGED' && { echo "  FAIL AGED-boundary: wear=70 should NOT be AGED, got=$r"; fail=1; }
  # LOW_BATTERY: cap < 25 on battery
  r="$(classify_battery Discharging 20 80 0 yes)"
  echo "$r" | grep -q '^LOW_BATTERY' || { echo "  FAIL LOW_BATTERY-20: got=$r"; fail=1; }
  r="$(classify_battery Discharging 24 80 0 yes)"
  echo "$r" | grep -q '^LOW_BATTERY' || { echo "  FAIL LOW_BATTERY-24: got=$r (boundary)"; fail=1; }
  # cap 25 on battery → not LOW_BATTERY
  r="$(classify_battery Discharging 25 80 0 yes)"
  echo "$r" | grep -q '^LOW_BATTERY' && { echo "  FAIL LOW_BATTERY-boundary: cap=25 should NOT be LOW, got=$r"; fail=1; }
  # ON_BATTERY: cap ≥ 25 on battery
  r="$(classify_battery Discharging 50 80 0 yes)"
  echo "$r" | grep -q '^ON_BATTERY' || { echo "  FAIL ON_BATTERY: got=$r"; fail=1; }
  r="$(classify_battery Discharging 80 80 0 yes)"
  echo "$r" | grep -q '^ON_BATTERY' || { echo "  FAIL ON_BATTERY-80: got=$r"; fail=1; }
  # CHARGING
  r="$(classify_battery Charging 50 80 1 yes)"
  echo "$r" | grep -q '^CHARGING' || { echo "  FAIL CHARGING: got=$r"; fail=1; }
  # FULL
  r="$(classify_battery Full 100 80 1 yes)"
  echo "$r" | grep -q '^FULL' || { echo "  FAIL FULL: got=$r"; fail=1; }
  # HEALTHY: default on mains
  r="$(classify_battery "Not charging" 80 80 1 yes)"
  echo "$r" | grep -q '^HEALTHY' || { echo "  FAIL HEALTHY: got=$r"; fail=1; }
  # Priority: CRITICAL beats AGED
  r="$(classify_battery Discharging 80 30 0 yes)"
  echo "$r" | grep -q '^CRITICAL' || { echo "  FAIL priority CRITICAL > AGED: got=$r"; fail=1; }
  # Priority: AGED beats ON_BATTERY (a worn battery is more important than the power source)
  r="$(classify_battery Discharging 80 50 0 yes)"
  echo "$r" | grep -q '^AGED' || { echo "  FAIL priority AGED > ON_BATTERY: got=$r"; fail=1; }
  # Fixture-backed parse: capacity_level is a real sysfs signal the sense now surfaces.
  _td="$(mktemp -d)" || { echo "  FAIL fixture mktemp"; exit 1; }
  mkdir -p "$_td/BAT0" "$_td/ADP0"
  printf 'Not charging\n' > "$_td/BAT0/status"
  printf '97\n' > "$_td/BAT0/capacity"
  printf 'Normal\n' > "$_td/BAT0/capacity_level"
  printf '20690000\n' > "$_td/BAT0/energy_full"
  printf '35300000\n' > "$_td/BAT0/energy_full_design"
  printf '1\n' > "$_td/ADP0/online"
  got="$(MESH_POWER_SUPPLY_DIR="$_td" bash "$0" --json 2>/dev/null || true)"
  echo "$got" | grep -q '"capacity_level":"Normal"' || { echo "  FAIL capacity_level parse: got=$got"; fail=1; }
  rm -rf "$_td"
  # ledger resolution (ledger > inline): --consts is the observable artifact. MUST sit above
  # the real-read n/a gate — a batteryless node still resolves consts.
  _led="${MESH_REPO:-$HOME/lte-workstation}/scripts/uxn/threshold-ledger"
  if [ -f "$_led" ]; then
    _lt="$(mktemp -d)"
    sed 's/eol=40/eol=41/' "$_led" > "$_lt/recal"
    _c="$(MESH_THRESHOLD_LEDGER="$_lt/recal" bash "$0" --consts)"
    [ "$_c" = "eol=41 aged=70 crit=15 low=25" ] || { echo "  FAIL: recal ledger (eol=41) must reach --consts, got '$_c'"; fail=1; }
    _c="$(MESH_THRESHOLD_LEDGER="$_lt/absent" bash "$0" --consts)"
    [ "$_c" = "eol=40 aged=70 crit=15 low=25" ] || { echo "  FAIL: absent ledger must fall back inline, got '$_c'"; fail=1; }
    rm -rf "$_lt"
  fi
  [ "$fail" = 1 ] && { echo "smoke-test: FAIL"; exit 1; }
  # REAL-READ gate (2026-07-15) — every assertion above proves the CLASSIFIER, not this node's organ.
  # classify_battery is pure, and the one fixture that touches the read path drives a SYNTHETIC BAT0
  # through MESH_POWER_SUPPLY_DIR in a tmpdir. None of them ever asks whether THIS node has a battery,
  # so --test returned 0 on mesh-home — a desktop whose /sys/class/power_supply is EMPTY — autowire read
  # PASS instead of n/a, and cron-wired a reflex that has emitted the identical "[battery-no-battery]
  # NO_BATTERY" 12/12 times since it was wired 2026-07-15. Same bypass as mesh-motion-attrib (562938a)
  # and mesh-therm-watch (dacf6f1): a gate that certifies the logic and never asks whether the organ is
  # here. A sense's real-read gate must require its HARDWARE.
  # NOTE the deliberate asymmetry: NO_BATTERY stays exit 0 at RUNTIME. That is a declared consumer
  # contract (:28) and the correct honest verdict for a desktop — the tool was never dishonest. Only its
  # WIRING is wrong here, so only --test changes. Self-healing: attach a UPS/battery and the next
  # autowire */30 sees PASS and wires it back.
  live="$("$0" 2>/dev/null)"
  # sandbox honesty gate — must sit BEFORE the n/a exit so it fires on batteryless nodes too (the
  # very nodes where the forged content was worst). Falsify: drop the STATE diversion → sig moves.
  _live_sig2="$(stat -c '%Y %s' "$_live_state" 2>/dev/null || echo absent)"
  [ "$_live_sig2" = "$_live_sig" ] || { echo "smoke-test: FAIL (--test stamped the LIVE state $_live_state: '$_live_sig' → '$_live_sig2')"; exit 1; }
  if printf '%s' "$live" | grep -q 'NO_BATTERY'; then
    echo "smoke-test: n/a — no battery organ on $(hostname): $PS_DIR has no BAT0 ($live). All 22 classifier assertions passed; this tool is sound, this node simply has no battery."
    exit 2
  fi
  echo "smoke-test: ok (22 assertions: NO_BATTERY×1, OFFLINE×3, CRITICAL×2 +1-negative, AGED×2+1-boundary, LOW_BATTERY×2+1-boundary, ON_BATTERY×2, CHARGING×1, FULL×1, HEALTHY×1, priority×2, capacity_level×1) + ledger resolution + real-read gate (live battery present)"
  exit 0
fi

# --- Live read path ---
TS=$(date -u +%Y-%m-%dT%H:%M:%SZ)
# Check for BAT0 (no battery present → NO_BATTERY, exit 0, honest "no battery here")
if [ ! -d "$BAT_DIR" ]; then
  printf 'NO_BATTERY|no BAT0 in /sys/class/power_supply|ts=%s\n' "$TS" > "$STATE"
  [ -x "$HOME/.local/bin/mesh-state-touch" ] && "$HOME/.local/bin/mesh-state-touch" "$STATE" >/dev/null 2>&1 || true
  echo "[battery-no-battery] NO_BATTERY — no BAT0 in /sys/class/power_supply (desktop / no UPS)"
  exit 0
fi

# Read fields. Any required field unreadable → OFFLINE.
status="OFFLINE"; capacity="OFFLINE"; energy_full="OFFLINE"; energy_full_design="OFFLINE"
capacity_level="UNAVAILABLE"; cycle_count=""; power_now=""; wear="OFFLINE"; online="0"

# Read status
if [ -r "$BAT_DIR/status" ]; then
  status="$(cat "$BAT_DIR/status" 2>/dev/null | tr -d '\n')"
fi
# Read capacity
if [ -r "$BAT_DIR/capacity" ]; then
  capacity="$(cat "$BAT_DIR/capacity" 2>/dev/null)"
fi
# Read capacity_level (a separate kernel headroom signal; honest UNAVAILABLE if absent)
if [ -r "$BAT_DIR/capacity_level" ]; then
  capacity_level="$(cat "$BAT_DIR/capacity_level" 2>/dev/null | tr -d '\n')"
fi
# Read energy_full + design (for wear). Some batteries use charge_full instead.
if [ -r "$BAT_DIR/energy_full" ]; then
  energy_full="$(cat "$BAT_DIR/energy_full" 2>/dev/null)"
fi
if [ -r "$BAT_DIR/energy_full_design" ]; then
  energy_full_design="$(cat "$BAT_DIR/energy_full_design" 2>/dev/null)"
fi
# Cycle count + power (informational)
if [ -r "$BAT_DIR/cycle_count" ]; then
  cycle_count="$(cat "$BAT_DIR/cycle_count" 2>/dev/null)"
fi
if [ -r "$BAT_DIR/power_now" ]; then
  power_now="$(cat "$BAT_DIR/power_now" 2>/dev/null)"
fi
# ADP0 online (AC plugged in)
if [ -r "$ADP_DIR/online" ]; then
  online="$(cat "$ADP_DIR/online" 2>/dev/null)"
fi

# Compute wear: full/design * 100, integer
if [ "$energy_full" != "OFFLINE" ] && [ "$energy_full_design" != "OFFLINE" ] && [ "${energy_full_design:-0}" -gt 0 ] 2>/dev/null; then
  wear=$(( energy_full * 100 / energy_full_design ))
fi

# Classify
result="$(classify_battery "$status" "$capacity" "$wear" "$online" yes)"
label="${result%%|*}"
reason="${result#*|}"

# Write state + touch liveness on EVERY successful run (mtime = ran-live, content = value-changed)
printf '%s|status=%s|capacity=%s|wear=%s|online=%s|cycle_count=%s|power_now=%s|%s\n' \
  "$label" "$status" "$capacity" "$wear" "$online" "$cycle_count" "$power_now" "$reason" > "$STATE"
[ -x "$HOME/.local/bin/mesh-state-touch" ] && "$HOME/.local/bin/mesh-state-touch" "$STATE" >/dev/null 2>&1 || true

# --- Output ---
if [ "${1:-}" = --json ]; then
  printf '{"label":"%s","reason":"%s","status":"%s","capacity":%s,"capacity_level":"%s","wear":%s,"online":%s,"cycle_count":%s,"power_now":%s,"ts":"%s"}\n' \
    "$label" "$reason" "$status" "${capacity:-null}" "$capacity_level" "${wear:-null}" "$online" "${cycle_count:-null}" "${power_now:-null}" "$TS"
  exit 0
fi
if [ "${1:-}" = --edge ]; then
  prev=""; [ -f "$STATE" ] && prev="$(head -1 "$STATE" 2>/dev/null | cut -d'|' -f1)" || true
  [ "$prev" = "$label" ] && exit 0
  printf '[battery-%s] %s — %s | capacity_level=%s\n' "$(printf '%s' "$label" | tr '[:upper:]' '[:lower:]' | tr '_' '-')" "$label" "$reason" "$capacity_level"
  exit 0
fi
printf '[battery-%s] %s — %s | capacity_level=%s\n' "$(printf '%s' "$label" | tr '[:upper:]' '[:lower:]' | tr '_' '-')" "$label" "$reason" "$capacity_level"
