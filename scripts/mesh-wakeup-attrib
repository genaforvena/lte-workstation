#!/usr/bin/env bash
# mesh-wakeup-attrib — cross-sense fusion: WHY is the CPU restless-idle?
#
# mesh-cstate sees SHALLOW-REST ("restless idle": idle by load but kept out of deep C-states by
# frequent wakeups) but explicitly can't say why — its own header calls that "invisible to every
# other sense." mesh-irq-rate sees hardware IRQ/softirq activity but never checks whether that
# activity actually correlates with lost sleep depth — a BURST of interrupts on an already-BUSY
# CPU is unremarkable. Neither sense alone answers "is THIS restless-idle episode explained by
# THIS interrupt activity?" — that requires reading both over the SAME window and cross-checking.
#
# FUSION (verified gap 2026-07-10 — mesh-tools --search {cstate,wakeup,restless} all return only
# mesh-cstate itself; no tool cross-reads cstate against irq-rate):
#   samples mesh-cstate --json and mesh-irq-rate --json back-to-back (~3s total) and classifies:
#
#   ATTRIBUTED      cstate=SHALLOW-REST AND irq level ACTIVE/BURST — restless idle explained by
#                   the named top hardware IRQ or pinned softirq (the wakeup source).
#   UNEXPLAINED     cstate=SHALLOW-REST BUT irq level QUIET — something OTHER than a hardware IRQ
#                   is preventing deep sleep (scheduler ticks, hrtimers, governor polling, C-state
#                   demotion by firmware) — none of which /proc/interrupts counts. A real, useful
#                   negative: rules out the IRQ subsystem as the cause.
#   IRQ-UNAVAILABLE cstate=SHALLOW-REST but /proc/interrupts unreadable this run — honest "can't
#                   attribute", never silently folded into UNEXPLAINED.
#   CLEAN           cstate=DEEP-REST — truly resting; irq reading kept for context only.
#   BUSY / LIGHT    not a restless-idle episode; irq reading kept for context only.
#   UNREACHABLE     mesh-cstate itself has no readable cpuidle (VM/container) — honest n/a, exit 2.
#
# State artifact ~/.mesh/.wakeup-attrib-state written EVERY run (UNCONDITIONAL → mtime=liveness,
# no mesh-state-touch needed). Per-run telemetry in ~/.mesh/wakeup-attrib.log.
#
#   mesh-wakeup-attrib           one fused sample, writes state+log
#   mesh-wakeup-attrib --json    same sample, JSON
#   mesh-wakeup-attrib --status  last state-file reading, no new sample (READ-ONLY)
#   mesh-wakeup-attrib --test    fixture classify logic + REAL-READ GATE (live fusion or exit 2)
#
# reflex-cadence: */10 * * * *
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
MODE="${1:-}"

STATE="${MESH_WAKEUP_ATTRIB_STATE:-$HOME/.mesh/.wakeup-attrib-state}"
LOG="${MESH_WAKEUP_ATTRIB_LOG:-$HOME/.mesh/wakeup-attrib.log}"
# SIBLING-FIRST resolution: a fusion tool must call the sub-sense of its OWN generation. Deployed,
# the sibling of $0 IS ~/.local/bin/mesh-cstate, so nothing changes. Run from the genome (mesh-land
# --autoland tests the CANDIDATE at scripts/<tool> with ~/.local/bin still first on PATH), the
# sibling is the new copy about to be deployed — otherwise a fused tool's --test asserts against the
# STALE deployed sub-sense and a coordinated two-tool change can never land itself.
_wa_sib(){ local d; d="$(cd "$(dirname "$0")" 2>/dev/null && pwd)" || return 1; [ -x "$d/$1" ] && printf '%s/%s' "$d" "$1"; }
CSTATE_BIN="${MESH_WAKEUP_ATTRIB_CSTATE:-$(_wa_sib mesh-cstate 2>/dev/null || true)}"; CSTATE_BIN="${CSTATE_BIN:-mesh-cstate}"
IRQ_BIN="${MESH_WAKEUP_ATTRIB_IRQ:-$(_wa_sib mesh-irq-rate 2>/dev/null || true)}"; IRQ_BIN="${IRQ_BIN:-mesh-irq-rate}"

# classify_attrib: cstate_level irq_level → the fused verdict (the whole point of this tool).
classify_attrib() {
  local cl="$1" il="$2"
  case "$cl" in
    SHALLOW-REST)
      case "$il" in
        ACTIVE|BURST) echo "ATTRIBUTED" ;;
        QUIET)        echo "UNEXPLAINED" ;;
        *)            echo "IRQ-UNAVAILABLE" ;;
      esac
      ;;
    DEEP-REST) echo "CLEAN" ;;
    BUSY)      echo "BUSY" ;;
    LIGHT)     echo "LIGHT" ;;
    *)         echo "UNKNOWN" ;;
  esac
}

# ============================== --test (sandboxed classify logic + REAL-READ GATE) ==============================
if [ "$MODE" = "--test" ]; then
  fail=0
  [ "$(classify_attrib SHALLOW-REST BURST)" = ATTRIBUTED ]      || { echo "  FAIL: SHALLOW-REST+BURST != ATTRIBUTED"; fail=1; }
  [ "$(classify_attrib SHALLOW-REST ACTIVE)" = ATTRIBUTED ]     || { echo "  FAIL: SHALLOW-REST+ACTIVE != ATTRIBUTED"; fail=1; }
  [ "$(classify_attrib SHALLOW-REST QUIET)" = UNEXPLAINED ]     || { echo "  FAIL: SHALLOW-REST+QUIET != UNEXPLAINED"; fail=1; }
  [ "$(classify_attrib SHALLOW-REST "")" = IRQ-UNAVAILABLE ]    || { echo "  FAIL: SHALLOW-REST+empty != IRQ-UNAVAILABLE"; fail=1; }
  [ "$(classify_attrib DEEP-REST BURST)" = CLEAN ]              || { echo "  FAIL: DEEP-REST+BURST != CLEAN (deep sleep is deep sleep regardless of irq)"; fail=1; }
  [ "$(classify_attrib BUSY BURST)" = BUSY ]                    || { echo "  FAIL: BUSY+BURST != BUSY"; fail=1; }
  [ "$(classify_attrib LIGHT QUIET)" = LIGHT ]                  || { echo "  FAIL: LIGHT+QUIET != LIGHT"; fail=1; }

  # honest-fusion: irq-rate command missing entirely must not fabricate a level
  if command -v "$IRQ_BIN" >/dev/null 2>&1 || command -v "$CSTATE_BIN" >/dev/null 2>&1; then :; else
    echo "smoke-test: n/a — neither mesh-cstate nor mesh-irq-rate on PATH"; exit 2
  fi

  # ---- REAL-READ GATE: fuse two live sub-sense reads, or honestly exit 2 ----
  cj=$("$CSTATE_BIN" --json 2>/dev/null) || { echo "smoke-test: n/a — mesh-cstate UNREACHABLE (cpuidle hidden)"; exit 2; }
  # Read through the SAME selector the live path uses — a gate that reads .level while the live path
  # reads .level_inst asserts nothing about the live path (a selector's answer is code, not just env).
  cl=$(printf '%s' "$cj" | jq -r '.level_inst // .level // empty' 2>/dev/null)
  [ -n "$cl" ] || { echo "  FAIL: live-read gate — mesh-cstate --json gave no .level_inst/.level (hollow)"; fail=1; }
  # And the fallback must stay a FALLBACK: against the current mesh-cstate the instantaneous field is
  # really there. If cstate ever drops it, this goes red instead of silently pairing an interval mean
  # with a 3-second irq read.
  case "$(printf '%s' "$cj" | jq -r 'has("level_inst")' 2>/dev/null)" in
    true) : ;;
    *) echo "  FAIL: mesh-cstate --json carries no .level_inst — the irq pairing would fall back to the FUSED (interval) level, correlating two different windows"; fail=1 ;;
  esac

  ij=$("$IRQ_BIN" --json 2>/dev/null) || true
  il=""
  [ -n "$ij" ] && il=$(printf '%s' "$ij" | jq -r '.level // empty' 2>/dev/null)

  verdict=$(classify_attrib "${cl:-UNKNOWN}" "${il:-}")
  case "$verdict" in
    ATTRIBUTED|UNEXPLAINED|IRQ-UNAVAILABLE|CLEAN|BUSY|LIGHT)
      echo "  live read: cstate=$cl irq=${il:-n/a} -> $verdict — real hardware produced data" ;;
    *) echo "  FAIL: live-read gate — unclassifiable fusion (cstate=$cl irq=$il)"; fail=1 ;;
  esac
  # ---- AXIS GATE: the rate we render must be the axis mesh-irq-rate CLASSIFIED.
  # Driven through a stub whose device and total rates are 30x apart, so reading the
  # wrong field cannot coincidentally agree. This is the one leg that goes red if
  # .device_per_s is swapped back to .irq_per_s.
  _ag=$(mktemp -d) || _ag=""
  if [ -n "$_ag" ]; then
    cat >"$_ag/mesh-irq-rate" <<'STUB'
#!/bin/sh
echo '{"level":"ACTIVE","level_axis":"device","irq_per_s":9100.0,"device_per_s":303.0,"kernel_per_s":8797.0,"top_irq":"67","top_desc":"stub-dev","softirq_top":"RCU","net_rx_cpu_share":0.1}'
STUB
    chmod +x "$_ag/mesh-irq-rate"
    _aj=$(MESH_WAKEUP_ATTRIB_IRQ="$_ag/mesh-irq-rate" \
          MESH_WAKEUP_ATTRIB_STATE="$_ag/state" MESH_WAKEUP_ATTRIB_LOG="$_ag/log" \
          "$0" --json 2>/dev/null)
    _adev=$(printf '%s' "$_aj" | jq -r '.irq_device_per_s // empty' 2>/dev/null)
    _atot=$(printf '%s' "$_aj" | jq -r '.irq_total_per_s // empty' 2>/dev/null)
    if [ "$_adev" != "303" ] && [ "$_adev" != "303.0" ]; then
      echo "  FAIL: axis gate — rendered rate is $_adev, not the classified DEVICE rate 303.0 (the total is 9100.0)"; fail=1
    fi
    if [ "$_atot" != "9100" ] && [ "$_atot" != "9100.0" ]; then
      echo "  FAIL: axis gate — total context rate is $_atot, want 9100.0"; fail=1
    fi
    case "$(printf '%s' "$_aj" | jq -r '.irq_axis // empty' 2>/dev/null)" in
      device) : ;;
      *) echo "  FAIL: axis gate — .irq_axis must NAME the classified axis"; fail=1 ;;
    esac
    rm -rf "$_ag"
  fi

  [ "$fail" = 0 ] && { echo "smoke-test: ok"; exit 0; } || { echo "smoke-test: FAIL"; exit 1; }
fi

# ---- --status : READ-ONLY, no new sample, no mutation ----
if [ "$MODE" = "--status" ]; then
  if [ -s "$STATE" ]; then
    printf '[wakeup-attrib] %s (as of %s)\n' "$(cat "$STATE")" "$(date -u -r "$STATE" +%FT%TZ 2>/dev/null || echo '?')"
    exit 0
  fi
  echo "[wakeup-attrib] no state yet — run mesh-wakeup-attrib for a sample"; exit 2
fi

# ============================== live fused sample ==============================
cstate_json=$("$CSTATE_BIN" --json 2>/dev/null) || {
  echo "mesh-wakeup-attrib: mesh-cstate UNREACHABLE (no readable cpuidle) — UNREACHABLE" >&2
  exit 2
}
# READ THE INSTANTANEOUS WINDOW, deliberately. mesh-cstate now folds its in-run sample with an
# across-run INTERVAL (window-cadence-aliasing sweep) and its top-level .level is that FUSED verdict
# — a claim about the last ~5 minutes. This tool's whole method is correlating cstate against an
# irq-rate sampled BACK-TO-BACK over the same seconds, so pairing a 5-minute mean with a 3-second
# irq read would attribute one window's restlessness to another window's interrupts. The _inst
# fields are that same-window reading; `// .level` keeps this working against an older mesh-cstate
# (or any --json without them), where .level WAS the instantaneous sample.
cstate_level=$(printf '%s' "$cstate_json" | jq -r '.level_inst // .level // empty' 2>/dev/null)
idle_pct=$(printf '%s' "$cstate_json" | jq -r '.idle_pct_inst // .idle_pct // empty' 2>/dev/null)
deep_ratio=$(printf '%s' "$cstate_json" | jq -r '.deep_ratio_inst // .deep_ratio // empty' 2>/dev/null)
[ -n "$cstate_level" ] || {
  echo "mesh-wakeup-attrib: mesh-cstate --json produced no .level — UNREACHABLE" >&2
  exit 2
}

irq_json=$("$IRQ_BIN" --json 2>/dev/null) || true
irq_level="" irq_rate="" irq_total="" top_irq="" top_desc="" softirq_top="" nrx_share=""
if [ -n "$irq_json" ]; then
  irq_level=$(printf '%s' "$irq_json" | jq -r '.level // empty' 2>/dev/null)
  # THE RATE MUST BE THE SAME AXIS AS THE LEVEL. mesh-irq-rate classifies the DEVICE
  # rate; .irq_per_s is the TOTAL, which on a 16c x 1000Hz node is dominated by the
  # timer/IPI bookkeeping floor (~6000/s at full rest). Pairing the device level with
  # the total printed "irq=QUIET irq_rate=7645.6" and attributed that whole floor to
  # one named device. Both are published, each labelled; the total is context only.
  irq_rate=$(printf '%s' "$irq_json" | jq -r '.device_per_s // empty' 2>/dev/null)
  irq_total=$(printf '%s' "$irq_json" | jq -r '.irq_per_s // empty' 2>/dev/null)
  top_irq=$(printf '%s' "$irq_json" | jq -r '.top_irq // empty' 2>/dev/null)
  top_desc=$(printf '%s' "$irq_json" | jq -r '.top_desc // empty' 2>/dev/null)
  softirq_top=$(printf '%s' "$irq_json" | jq -r '.softirq_top // empty' 2>/dev/null)
  nrx_share=$(printf '%s' "$irq_json" | jq -r '.net_rx_cpu_share // empty' 2>/dev/null)
fi

verdict=$(classify_attrib "$cstate_level" "${irq_level:-}")
ts=$(date -u +%FT%TZ)

source_str="-"
if [ "$verdict" = "ATTRIBUTED" ]; then
  if [ -n "$top_desc" ] && [ "$top_desc" != "null" ]; then
    source_str="${top_irq}:${top_desc}"
  else
    source_str="${top_irq:-?}"
  fi
  [ -n "$softirq_top" ] && [ "$softirq_top" != "null" ] && source_str="$source_str (softirq=$softirq_top)"
fi

mkdir -p "$(dirname "$STATE")" 2>/dev/null
printf '%s cstate=%s idle=%s%% deep_ratio=%s irq=%s irq_dev_rate=%s irq_total_rate=%s source=%s\n' \
  "$verdict" "$cstate_level" "$idle_pct" "$deep_ratio" "${irq_level:-n/a}" "${irq_rate:-n/a}" "${irq_total:-n/a}" "$source_str" >"$STATE"
printf '%s %s %s %s %s %s %s %s %s\n' \
  "$ts" "$verdict" "$cstate_level" "$idle_pct" "$deep_ratio" "${irq_level:-n/a}" "${irq_rate:-n/a}" "${irq_total:-n/a}" "$source_str" >>"$LOG"
if [ "$(wc -l <"$LOG" 2>/dev/null || echo 0)" -gt 10000 ]; then
  tail -n 5000 "$LOG" >"$LOG.tmp" && mv "$LOG.tmp" "$LOG"
fi

if [ "$MODE" = "--json" ]; then
  printf '{"verdict":"%s","cstate_level":"%s","idle_pct":%s,"deep_ratio":%s,"irq_level":%s,"irq_axis":"device","irq_device_per_s":%s,"irq_total_per_s":%s,"source":%s,"ts":"%s"}\n' \
    "$verdict" "$cstate_level" "${idle_pct:-null}" "${deep_ratio:-null}" \
    "$( [ -n "$irq_level" ] && printf '"%s"' "$irq_level" || echo null )" \
    "${irq_rate:-null}" "${irq_total:-null}" \
    "$( [ "$source_str" != "-" ] && printf '"%s"' "$source_str" || echo null )" \
    "$ts"
else
  case "$verdict" in
    ATTRIBUTED)      printf '[wakeup-attrib] ATTRIBUTED — restless idle (idle=%s%% deep-ratio=%s) driven by %s (%s device irq/s of %s total)\n' "$idle_pct" "$deep_ratio" "$source_str" "${irq_rate:-n/a}" "${irq_total:-n/a}" ;;
    UNEXPLAINED)     printf '[wakeup-attrib] UNEXPLAINED — restless idle (idle=%s%% deep-ratio=%s) but irq QUIET — non-IRQ cause (ticks/hrtimers/governor)\n' "$idle_pct" "$deep_ratio" ;;
    IRQ-UNAVAILABLE) printf '[wakeup-attrib] IRQ-UNAVAILABLE — restless idle (idle=%s%% deep-ratio=%s) but /proc/interrupts unreadable this run\n' "$idle_pct" "$deep_ratio" ;;
    CLEAN)           printf '[wakeup-attrib] CLEAN — DEEP-REST (idle=%s%% deep-ratio=%s), irq=%s for context\n' "$idle_pct" "$deep_ratio" "${irq_level:-n/a}" ;;
    *)                printf '[wakeup-attrib] %s — cstate=%s (idle=%s%%), irq=%s for context\n' "$verdict" "$cstate_level" "$idle_pct" "${irq_level:-n/a}" ;;
  esac
fi
