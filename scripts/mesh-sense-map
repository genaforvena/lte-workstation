#!/usr/bin/env python3
# mesh-sense-map — the CROSS-DEVICE sense inventory + cross-validation candidates, CACHED.
#
# Operator 2026-06-19: senses must be harvested from EVERYTHING we reach (not just the phone),
# and the real value is CROSS-validation — a single sensor is weak; sensors that confirm each
# other across DEVICES are the signal (play a tone on one node's speaker, hear it on another's
# mic → proves both organs AND derives geometry). This tool is the inventory layer that makes
# those pairings visible: which device has which sense, and where a sense exists on >=2 devices
# (so it can be cross-checked).
#
# It is CHEAP for a dash loop only via the cache: --refresh runs the (slow, SSH-fan-out) probe
# and writes ~/.mesh/sense-map.txt; --cached just prints that file + its age. The senses top
# pane reads --cached; a reflex runs --refresh.
#
# Usage:  mesh-sense-map            # human table (live refresh)
#         mesh-sense-map --refresh  # force re-probe + write cache (the reflex mode)
#         mesh-sense-map --cached   # print cache + age (the dash mode — cheap)
#         mesh-sense-map --json     # machine-readable
#         mesh-sense-map --test     # smoke test
#
# reflex-cadence: */10 * * * *
# reflex-args: --refresh
import json, os, subprocess, sys, time

CACHE = os.path.expanduser("~/.mesh/sense-map.txt")
# senses that are genuinely cross-validatable across devices, and the cross-check each enables.
CROSS = {
    "mic":  "audio cross-check (one node plays a tone -> others' mics hear it -> proves organs + geometry)",
    "wifi": "presence/motion cross-check (RSSI radar from multiple vantages -> triangulate)",
    "ble":  "proximity cross-check (which node a device is nearest -> space map)",
    "cam":  "visual cross-check (one node's torch/screen -> another's camera sees it)",
}


def _probe():
    """Source of truth = mesh-minds --json (per-node organs/senses/reached/caps, incl. LAN +
    macOS nodes). We reuse it so there is ONE cross-device prober, not two that drift."""
    try:
        out = subprocess.run(["mesh-minds", "--json"], capture_output=True, text=True,
                             timeout=120).stdout
        return json.loads(out)
    except Exception:
        return []


# ACTIVE cross-checks: an ACTUATOR on one node drives a SENSOR on another (operator 2026-06-19:
# actuators VALIDATE senses, and together yield MORE than either — distance/acoustics/co-location).
# (label, actuator-set that emits, sensor that detects, what the pairing proves+derives)
ACTIVE = [
    ("audio",  {"speaker", "voice"}, "mic", "emit a tone -> hear it: proves both organs + ranges distance/co-location"),
    ("visual", {"torch"},            "cam", "flash -> camera sees it: proves both + line-of-sight"),
]


def _device_senses(nodes):
    devs = []
    for n in nodes:
        senses = list(dict.fromkeys((n.get("organs") or []) + (n.get("senses") or [])))
        devs.append({
            "host": n.get("host") or "?",
            "ip": n.get("ip") or "?",
            "reached": bool(n.get("reached")),
            "online": bool(n.get("online")),
            "senses": senses,
            "actuators": list(n.get("actuators") or []),
        })
    return devs


def _cross(devs):
    """PASSIVE cross-check: same sense on >=2 REACHED devices = multi-vantage validation (e.g. wifi
    RSSI from two nodes -> triangulate). Honest: only reached devices count."""
    by_sense = {}
    for d in devs:
        if not d["reached"]:
            continue
        for s in d["senses"]:
            by_sense.setdefault(s, []).append(d["host"])
    return {s: hosts for s, hosts in by_sense.items() if len(hosts) >= 2}


def _active(devs):
    """ACTIVE cross-check pairs: an actuator on one reached device + the matching sensor on a
    DIFFERENT reached device. Returns (label, emitters, hearers, desc) only when a cross-device
    pair genuinely exists (one box emits, another senses)."""
    reached = [d for d in devs if d["reached"]]
    out = []
    for label, act_set, sensor, desc in ACTIVE:
        emit = [d["host"] for d in reached if act_set & set(d["actuators"])]
        hear = [d["host"] for d in reached if sensor in d["senses"]]
        if any(e != h for e in emit for h in hear):     # a real cross-device pairing exists
            out.append((label, emit, hear, desc))
    return out


def _render(devs, cross, active):
    lines = []
    lines.append("-- DEVICES: senses + actuators (harvest from ALL — sensors AND ways to act) --")
    for d in sorted(devs, key=lambda x: (not x["reached"], x["host"])):
        if d["reached"]:
            st = "online"
            ss = " ".join(d["senses"]) or "(no senses)"
            ac = (" | act: " + " ".join(d["actuators"])) if d["actuators"] else ""
        elif d["online"]:
            st, ss, ac = "unreach", "?", ""
        else:
            st, ss, ac = "offline", "?", ""
        lines.append(f"  {d['host']:<26} {st:<8} {ss}{ac}")
    lines.append("-- ACTIVE cross-checks (actuator on one node -> sensor on another: validate + derive) --")
    if active:
        for label, emit, hear, desc in active:
            lines.append(f"  {label:<6} emit[{', '.join(emit)}] -> hear[{', '.join(hear)}] — {desc}")
    else:
        lines.append("  (no actuator->sensor pair across 2 devices yet — need an emitter + a hearer online)")
    lines.append("-- PASSIVE cross-checks (same sense on >=2 nodes -> multi-vantage) --")
    if cross:
        for s, hosts in sorted(cross.items()):
            lines.append(f"  {s:<5} ×{len(hosts)} ({', '.join(hosts)}) — {CROSS.get(s, 'cross-check')}")
    else:
        lines.append("  (no sense yet on >=2 reached devices)")
    return "\n".join(lines)


def main():
    args = sys.argv[1:]
    if "--test" in args:
        # logic self-test: cross() must require >=2 reached devices and ignore unreached vantages.
        devs = [
            {"host": "a", "reached": True,  "online": True,  "senses": ["mic", "wifi"], "actuators": ["speaker"]},
            {"host": "b", "reached": True,  "online": True,  "senses": ["mic"],         "actuators": []},
            {"host": "c", "reached": False, "online": True,  "senses": ["mic", "wifi"], "actuators": ["speaker"]},
        ]
        cr = _cross(devs)
        if set(cr.get("mic", [])) != {"a", "b"} or "wifi" in cr:
            print(f"smoke-test: FAIL (cross={cr})"); sys.exit(1)
        ac = _active(devs)
        # a(speaker)->b(mic) is a valid cross-device audio pair; c is unreached so it must not count
        if not ac or ac[0][0] != "audio" or "c" in ac[0][1] or "c" in ac[0][2]:
            print(f"smoke-test: FAIL (active={ac})"); sys.exit(1)
        # empty/failed-probe guard: a healthy probe has >=1 reached-device-with-senses; an empty
        # or all-unreached probe must read as NOT healthy (so the cache-write is skipped, last-good kept).
        if not any(d["reached"] and d["senses"] for d in devs):
            print("smoke-test: FAIL (healthy-probe detector false-negative)"); sys.exit(1)
        if any(d["reached"] and d["senses"] for d in [{"host": "x", "reached": False, "senses": ["mic"]},
                                                      {"host": "y", "reached": True, "senses": []}]):
            print("smoke-test: FAIL (empty-probe not detected → would cache a hollow result)"); sys.exit(1)
        print("smoke-test: ok"); sys.exit(0)

    if "--cached" in args:
        if os.path.exists(CACHE):
            age = int(time.time() - os.path.getmtime(CACHE))
            am = f"{age//60}m" if age >= 60 else f"{age}s"
            try:
                sys.stdout.write(open(CACHE).read())
            except Exception:
                print("  (sense-map cache unreadable)")
            stale = "  ⚠️ STALE" if age > 1800 else ""
            print(f"  (cached {am} ago{stale})")
        else:
            print("  (no sense-map cache yet — reflex mesh-sense-map --refresh populates it)")
        return

    nodes = _probe()
    devs = _device_senses(nodes)
    cross = _cross(devs)
    active = _active(devs)
    if "--json" in args:
        print(json.dumps({"devices": devs, "cross": cross,
                          "active": [{"kind": a[0], "emit": a[1], "hear": a[2]} for a in active]},
                         indent=2)); return
    body = _render(devs, cross, active)
    print(body)
    # write cache (refresh + default both refresh it; the dash only ever reads --cached)
    # GUARD: never overwrite a good cache with an EMPTY/failed probe. The local node alone always
    # has senses + is always reached, so a healthy probe ALWAYS yields >=1 reached-device-with-senses.
    # Zero means mesh-minds returned [] (timeout / transient peer outage) — caching that empty result
    # would flash a hollow "no senses on any device" at the operator. Preserve last-good instead; the
    # cache simply AGES (visibly stale) until a healthy probe lands — failure looks different from empty.
    # (memory fusion-tools-distinguish-empty-from-failed.)
    healthy = any(d["reached"] and d["senses"] for d in devs)
    if not healthy and os.path.exists(CACHE):
        sys.stderr.write("sense-map: probe empty (peers unreachable?) — keeping last-good cache, not overwriting\n")
        return
    try:
        os.makedirs(os.path.dirname(CACHE), exist_ok=True)
        tmp = CACHE + ".tmp"
        with open(tmp, "w") as f:
            f.write(body + "\n")
        os.replace(tmp, CACHE)
    except Exception:
        pass


if __name__ == "__main__":
    main()
