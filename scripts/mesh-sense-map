#!/usr/bin/env python3
# mesh-sense-map — the CROSS-DEVICE sense inventory + cross-validation candidates, CACHED.
#
# Operator 2026-06-19: senses must be harvested from EVERYTHING we reach (not just the phone),
# and the real value is CROSS-validation — a single sensor is weak; sensors that confirm each
# other across DEVICES are the signal (play a tone on one node's speaker, hear it on another's
# mic → proves both organs AND derives geometry). This tool is the inventory layer that makes
# those pairings visible: which device has which sense, and where a sense exists on >=2 devices
# (so it can be cross-checked).
#
# It is CHEAP for a dash loop only via the cache: --refresh runs the (slow, SSH-fan-out) probe
# and writes ~/.mesh/sense-map.txt; --cached just prints that file + its age. The senses top
# pane reads --cached; a reflex runs --refresh.
#
# Usage:  mesh-sense-map            # human table (live refresh)
#         mesh-sense-map --refresh  # force re-probe + write cache (the reflex mode)
#         mesh-sense-map --cached   # print cache + age (the dash mode — cheap)
#         mesh-sense-map --json     # machine-readable
#         mesh-sense-map --test     # smoke test
#
# reflex-cadence: */10 * * * *
# reflex-args: --refresh
import json, os, re, shutil, subprocess, sys, time

CACHE = os.path.expanduser("~/.mesh/sense-map.txt")
# senses that are genuinely cross-validatable across devices, and the cross-check each enables.
CROSS = {
    "mic":  "audio cross-check (one node plays a tone -> others' mics hear it -> proves organs + geometry)",
    "wifi": "presence/motion cross-check (RSSI radar from multiple vantages -> triangulate)",
    "ble":  "proximity cross-check (which node a device is nearest -> space map)",
    "cam":  "visual cross-check (one node's torch/screen -> another's camera sees it)",
}


def _mesh_minds_cmd():
    """Resolve mesh-minds under cron too; cron PATH commonly omits ~/.local/bin."""
    found = shutil.which("mesh-minds")
    if found:
        return found
    local = os.path.expanduser("~/.local/bin/mesh-minds")
    if os.path.exists(local) and os.access(local, os.X_OK):
        return local
    raise FileNotFoundError("mesh-minds not found in PATH or ~/.local/bin")


def _probe():
    """Source of truth = mesh-minds --json (per-node organs/senses/reached/caps, incl. LAN +
    macOS nodes). We reuse it so there is ONE cross-device prober, not two that drift."""
    try:
        out = subprocess.run([_mesh_minds_cmd(), "--json"], capture_output=True, text=True,
                             timeout=120).stdout
        return json.loads(out)
    except Exception:
        return []


# ACTIVE cross-checks: an ACTUATOR on one node drives a SENSOR on another (operator 2026-06-19:
# actuators VALIDATE senses, and together yield MORE than either — distance/acoustics/co-location).
# (label, actuator-set that emits, sensor that detects, what the pairing proves+derives)
ACTIVE = [
    ("audio",  {"speaker", "voice"}, "mic", "emit a tone -> hear it: proves both organs + ranges distance/co-location"),
    ("visual", {"torch"},            "cam", "flash -> camera sees it: proves both + line-of-sight"),
]


def _device_senses(nodes):
    devs = []
    for n in nodes:
        senses = list(dict.fromkeys((n.get("organs") or []) + (n.get("senses") or [])))
        devs.append({
            "host": n.get("host") or "?",
            "ip": n.get("ip") or "?",
            "reached": bool(n.get("reached")),
            "online": bool(n.get("online")),
            "senses": senses,
            "actuators": list(n.get("actuators") or []),
            "transport": n.get("transport"),   # non-Tailscale transport (e.g. adb-via-ds); None = tailnet/LAN
        })
    return devs


def _cross(devs):
    """PASSIVE cross-check: same sense on >=2 REACHED devices = multi-vantage validation (e.g. wifi
    RSSI from two nodes -> triangulate). Honest: only reached devices count."""
    by_sense = {}
    for d in devs:
        if not d["reached"]:
            continue
        for s in d["senses"]:
            by_sense.setdefault(s, []).append(d["host"])
    return {s: hosts for s, hosts in by_sense.items() if len(hosts) >= 2}


def _active(devs):
    """ACTIVE cross-check pairs: an actuator on one reached device + the matching sensor on a
    DIFFERENT reached device. Returns (label, emitters, hearers, desc) only when a cross-device
    pair genuinely exists (one box emits, another senses)."""
    reached = [d for d in devs if d["reached"]]
    out = []
    for label, act_set, sensor, desc in ACTIVE:
        emit = [d["host"] for d in reached if act_set & set(d["actuators"])]
        hear = [d["host"] for d in reached if sensor in d["senses"]]
        if any(e != h for e in emit for h in hear):     # a real cross-device pairing exists
            out.append((label, emit, hear, desc))
    return out


def _reach_count(devs):
    return sum(1 for d in devs if d["reached"])


def _cached_reach():
    """reached-count of the LAST-GOOD cache, re-derived from its own rendered DEVICES block.

    Parsed from the block rather than from the header line this tool now writes, deliberately:
    a cache written before the header existed must still be comparable, so the partial-harvest
    guard binds on the FIRST run after deploy, not only after one write has happened.
    None = no cache / no DEVICES block (nothing to compare against — never a fabricated 0)."""
    try:
        txt = open(CACHE).read()
    except OSError:
        return None
    in_dev, n = False, 0
    for ln in txt.splitlines():
        if ln.startswith("-- DEVICES"):
            in_dev = True
            continue
        if in_dev and ln.startswith("--"):
            break
        if in_dev and ln[:1].isspace() and re.search(r"(?:^|\s)online(?=\s|$)", ln):
            n += 1
    return n if in_dev else None


def _drop_verdict(prev, reach1, reach2):
    """What a DROP in reach means. Pure (no I/O) so --test can drive every branch.

    prev   = last-good reach count (None = no comparable cache)
    reach1 = this probe's reach count
    reach2 = the corroborating RE-probe's reach count (None = it could not run / came back empty)

    -> "write"   no drop, or a drop both probes agree on (a real outage — cache it)
       "write2"  the re-probe reached MORE: probe 1 was a PARTIAL harvest; cache the better one
       "refuse"  a drop nobody could corroborate — keep last-good, let the cache age visibly
    """
    if prev is None or reach1 >= prev:
        return "write"
    if reach2 is None:
        return "refuse"
    return "write2" if reach2 > reach1 else "write"


def _render(devs, cross, active):
    lines = []
    lines.append("-- DEVICES: senses + actuators (harvest from ALL — sensors AND ways to act) --")
    for d in sorted(devs, key=lambda x: (not x["reached"], x["host"])):
        if d["reached"]:
            st = "online"
            ss = " ".join(d["senses"]) or "(no senses)"
            ac = (" | act: " + " ".join(d["actuators"])) if d["actuators"] else ""
        elif d["online"]:
            st, ss, ac = "unreach", "?", ""
        else:
            st, ss, ac = "offline", "?", ""
        tp = f"  [{d['transport']}]" if d.get("transport") else ""   # tag non-Tailscale nodes with how they're reached
        lines.append(f"  {d['host']:<26} {st:<8} {ss}{ac}{tp}")
    lines.append("-- ACTIVE cross-checks (actuator on one node -> sensor on another: validate + derive) --")
    if active:
        for label, emit, hear, desc in active:
            lines.append(f"  {label:<6} emit[{', '.join(emit)}] -> hear[{', '.join(hear)}] — {desc}")
    else:
        lines.append("  (no actuator->sensor pair across 2 devices yet — need an emitter + a hearer online)")
    lines.append("-- PASSIVE cross-checks (same sense on >=2 nodes -> multi-vantage) --")
    if cross:
        for s, hosts in sorted(cross.items()):
            lines.append(f"  {s:<5} ×{len(hosts)} ({', '.join(hosts)}) — {CROSS.get(s, 'cross-check')}")
    else:
        lines.append("  (no sense yet on >=2 reached devices)")
    return "\n".join(lines)


def main():
    args = sys.argv[1:]
    if "--test" in args:
        # cron runs with a stripped PATH; the refresh must still find mesh-minds or it will
        # smoke-pass while preserving a stale cache forever.
        old_path = os.environ.get("PATH", "")
        try:
            os.environ["PATH"] = "/usr/bin:/bin"
            resolved = _mesh_minds_cmd()
        except Exception as e:
            print(f"smoke-test: FAIL (cron PATH cannot resolve mesh-minds: {e})"); sys.exit(1)
        finally:
            os.environ["PATH"] = old_path
        if not os.path.exists(resolved) or not os.access(resolved, os.X_OK):
            print(f"smoke-test: FAIL (resolved mesh-minds not executable: {resolved})"); sys.exit(1)
        # logic self-test: cross() must require >=2 reached devices and ignore unreached vantages.
        devs = [
            {"host": "a", "reached": True,  "online": True,  "senses": ["mic", "wifi"], "actuators": ["speaker"]},
            {"host": "b", "reached": True,  "online": True,  "senses": ["mic"],         "actuators": []},
            {"host": "c", "reached": False, "online": True,  "senses": ["mic", "wifi"], "actuators": ["speaker"]},
        ]
        cr = _cross(devs)
        if set(cr.get("mic", [])) != {"a", "b"} or "wifi" in cr:
            print(f"smoke-test: FAIL (cross={cr})"); sys.exit(1)
        ac = _active(devs)
        # a(speaker)->b(mic) is a valid cross-device audio pair; c is unreached so it must not count
        if not ac or ac[0][0] != "audio" or "c" in ac[0][1] or "c" in ac[0][2]:
            print(f"smoke-test: FAIL (active={ac})"); sys.exit(1)
        # empty/failed-probe guard: a healthy probe has >=1 reached-device-with-senses; an empty
        # or all-unreached probe must read as NOT healthy (so the cache-write is skipped, last-good kept).
        if not any(d["reached"] and d["senses"] for d in devs):
            print("smoke-test: FAIL (healthy-probe detector false-negative)"); sys.exit(1)
        if any(d["reached"] and d["senses"] for d in [{"host": "x", "reached": False, "senses": ["mic"]},
                                                      {"host": "y", "reached": True, "senses": []}]):
            print("smoke-test: FAIL (empty-probe not detected → would cache a hollow result)"); sys.exit(1)
        # partial-harvest guard (GUARD 2). The point of these cases is that the OLD guard passes
        # every one of them — assert that first, so the new gate is testing what it claims to.
        partial = [{"host": "local", "reached": True,  "senses": ["mic"], "actuators": []},
                   {"host": "p1",    "reached": True,  "senses": ["mic"], "actuators": []},
                   {"host": "p2",    "reached": False, "senses": [],      "actuators": []},
                   {"host": "p3",    "reached": False, "senses": [],      "actuators": []}]
        if not any(d["reached"] and d["senses"] for d in partial):
            print("smoke-test: FAIL (fixture is not a PARTIAL harvest — the old guard must pass it, "
                  "else this case proves nothing)"); sys.exit(1)
        if _reach_count(partial) != 2:
            print(f"smoke-test: FAIL (reach count {_reach_count(partial)}, expected 2)"); sys.exit(1)
        cases = [
            # (prev, reach1, reach2, expected) — the MEASURED shape is line 2: 4 -> 2, re-probe 4
            ((4, 4, None), "write",  "no drop must write on ONE probe (no needless re-probe)"),
            ((4, 2, 4),    "write2", "a re-probe that reaches MORE = partial harvest -> cache it"),
            ((4, 2, 2),    "write",  "a drop BOTH probes agree on is a real outage -> cache it"),
            ((4, 2, 3),    "write2", "a better-but-still-low re-probe still beats probe 1"),
            ((4, 2, None), "refuse", "an uncorroborated drop must NOT overwrite last-good"),
            ((None, 1, None), "write", "no comparable cache -> nothing to refuse against"),
            ((4, 5, None), "write",  "a RISE is never a partial harvest"),
        ]
        for (pv, r1, r2), want, why in cases:
            got = _drop_verdict(pv, r1, r2)
            if got != want:
                print(f"smoke-test: FAIL (_drop_verdict({pv},{r1},{r2})={got}, expected {want} — {why})")
                sys.exit(1)
        # the cache-reach re-derivation must read the rendered block (and only the DEVICES block)
        rendered = _render([{"host": "a", "reached": True, "online": True, "senses": ["mic"], "actuators": []},
                            {"host": "b", "reached": True, "online": True, "senses": ["mic"], "actuators": []},
                            {"host": "c", "reached": False, "online": False, "senses": [], "actuators": []}],
                           {"mic": ["a", "b"]}, [])
        import tempfile as _tf
        global CACHE
        _keep = CACHE
        try:
            with _tf.NamedTemporaryFile("w", suffix=".txt", delete=False) as fh:
                fh.write("# harvest: reached=2/3 probes=1 state=ok\n" + rendered + "\n")
                CACHE = fh.name
            if _cached_reach() != 2:
                print(f"smoke-test: FAIL (_cached_reach read {_cached_reach()} from a 2-online "
                      f"cache — the guard would compare against a wrong last-good)"); sys.exit(1)
            os.unlink(CACHE)
            if _cached_reach() is not None:
                print("smoke-test: FAIL (absent cache must read None, never 0 — a fabricated 0 "
                      "would make every harvest look like a rise)"); sys.exit(1)
        finally:
            CACHE = _keep
        print("smoke-test: ok"); sys.exit(0)

    if "--cached" in args:
        if os.path.exists(CACHE):
            age = int(time.time() - os.path.getmtime(CACHE))
            am = f"{age//60}m" if age >= 60 else f"{age}s"
            try:
                sys.stdout.write(open(CACHE).read())
            except Exception:
                print("  (sense-map cache unreadable)")
            stale = "  ⚠️ STALE" if age > 1800 else ""
            print(f"  (cached {am} ago{stale})")
        else:
            print("  (no sense-map cache yet — reflex mesh-sense-map --refresh populates it)")
        return

    nodes = _probe()
    devs = _device_senses(nodes)
    if "--json" in args:
        cross, active = _cross(devs), _active(devs)
        print(json.dumps({"devices": devs, "cross": cross,
                          "active": [{"kind": a[0], "emit": a[1], "hear": a[2]} for a in active]},
                         indent=2)); return

    # GUARD 2 — PARTIAL vs COMPLETE (the `healthy` check below only separates EMPTY from FAILED).
    # `any(reached and senses)` trusts a sentinel that can never fail: the LOCAL node is always
    # reached and always has senses, so a harvest that got local + 1 of 4 peers (the rest timed out
    # in the SSH fan-out) reads "healthy" and overwrites last-good with a degraded map. Downstream
    # that single bad sample is AMPLIFIED, not averaged: this reflex is */10 while mesh-witness
    # samples every 2 min OFF THE CACHE, so one bad harvest is re-published as 5 consecutive ledger
    # rows — five correlated re-reads of one measurement, shaped exactly like five independent
    # confirmations of an outage. Measured 2026-08-15 (317 samples/10.6h): 12 low runs, EVERY ONE
    # exactly 5 rows long, each starting at minute = 2 mod 10 (the first witness tick after the cron
    # boundary). This is the coverage rule INVERTED — producer window WIDER than consumer cadence
    # manufactures apparent persistence, where the doctrine's case (window narrower) manufactures
    # blindness. So a DROP is never trusted on one probe: re-probe once and keep the better read.
    prev = _cached_reach()
    reach1 = _reach_count(devs)
    probes, verdict = 1, "write"
    if prev is not None and reach1 < prev:
        devs2 = _device_senses(_probe())
        probes = 2
        # a second probe that came back EMPTY corroborates nothing (it is the failure mode itself)
        reach2 = _reach_count(devs2) if any(d["reached"] and d["senses"] for d in devs2) else None
        verdict = _drop_verdict(prev, reach1, reach2)
        if verdict == "write2":
            devs = devs2

    cross = _cross(devs)
    active = _active(devs)
    reached = _reach_count(devs)
    state = "ok" if prev is None or reached >= prev else "drop-corroborated"
    header = (f"# harvest: reached={reached}/{len(devs)} probes={probes} state={state} "
              f"last-good={prev if prev is not None else 'na'} "
              f"at={time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())}")
    body = header + "\n" + _render(devs, cross, active)
    print(body)

    if verdict == "refuse":
        sys.stderr.write(f"sense-map: reach dropped {prev} -> {reach1} and the corroborating probe "
                         f"failed — keeping last-good cache (partial harvest, not an outage)\n")
        return
    # write cache (refresh + default both refresh it; the dash only ever reads --cached)
    # GUARD 1 (EMPTY vs FAILED; the PARTIAL vs COMPLETE half is GUARD 2 above): never overwrite a
    # good cache with an EMPTY/failed probe. The local node alone always
    # has senses + is always reached, so a healthy probe ALWAYS yields >=1 reached-device-with-senses.
    # Zero means mesh-minds returned [] (timeout / transient peer outage) — caching that empty result
    # would flash a hollow "no senses on any device" at the operator. Preserve last-good instead; the
    # cache simply AGES (visibly stale) until a healthy probe lands — failure looks different from empty.
    # (memory fusion-tools-distinguish-empty-from-failed.)
    healthy = any(d["reached"] and d["senses"] for d in devs)
    if not healthy and os.path.exists(CACHE):
        sys.stderr.write("sense-map: probe empty (peers unreachable?) — keeping last-good cache, not overwriting\n")
        return
    try:
        os.makedirs(os.path.dirname(CACHE), exist_ok=True)
        tmp = CACHE + ".tmp"
        with open(tmp, "w") as f:
            f.write(body + "\n")
        os.replace(tmp, CACHE)
    except Exception:
        pass


if __name__ == "__main__":
    main()
