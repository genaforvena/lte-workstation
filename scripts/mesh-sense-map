#!/usr/bin/env python3
# mesh-sense-map — the CROSS-DEVICE sense inventory + cross-validation candidates, CACHED.
#
# Operator 2026-06-19: senses must be harvested from EVERYTHING we reach (not just the phone),
# and the real value is CROSS-validation — a single sensor is weak; sensors that confirm each
# other across DEVICES are the signal (play a tone on one node's speaker, hear it on another's
# mic → proves both organs AND derives geometry). This tool is the inventory layer that makes
# those pairings visible: which device has which sense, and where a sense exists on >=2 devices
# (so it can be cross-checked).
#
# It is CHEAP for a dash loop only via the cache: --refresh runs the (slow, SSH-fan-out) probe
# and writes ~/.mesh/sense-map.txt; --cached just prints that file + its age. The senses top
# pane reads --cached; a reflex runs --refresh.
#
# Usage:  mesh-sense-map            # human table (live refresh)
#         mesh-sense-map --refresh  # force re-probe + write cache (the reflex mode)
#         mesh-sense-map --cached   # print cache + age (the dash mode — cheap)
#         mesh-sense-map --json     # machine-readable
#         mesh-sense-map --test     # smoke test
#
# reflex-cadence: */10 * * * *
# reflex-args: --refresh
import json, os, re, shutil, subprocess, sys, time

import signal

# SIGTERM MUST UNWIND, or every `finally` below is decorative. Python's DEFAULT SIGTERM disposition
# terminates the interpreter WITHOUT running finally blocks, TemporaryDirectory.__exit__ or atexit,
# so a correct-looking cleanup never executes. The signal is routine here, not hypothetical: GNU
# `timeout` without --foreground puts its child in its OWN PROCESS GROUP and signals the GROUP, so
# every timeout-wrapped call site -- mesh-doctor's hourly --test sweep, mesh-autowire's `timeout 30`
# -- delivers TERM to this process. That is how 950MB of stranded snapshots filled phaedra's /tmp on
# 2026-08-16 with a `finally: rmtree` sitting right there in the source (first fixed in mesh-spend,
# d2fd7c9b). sys.exit() from a handler raises SystemExit in the MAIN THREAD, which is what makes
# try/finally unwind. SIGKILL stays uncatchable -- that half is mesh-tmp-guard's sweep, never this.
for _sig in (signal.SIGTERM, signal.SIGHUP):
    signal.signal(_sig, lambda _s, _f: sys.exit(128 + _s))


CACHE = os.path.expanduser("~/.mesh/sense-map.txt")
# senses that are genuinely cross-validatable across devices, and the cross-check each enables.
CROSS = {
    "mic":  "audio cross-check (one node plays a tone -> others' mics hear it -> proves organs + geometry)",
    "wifi": "presence/motion cross-check (RSSI radar from multiple vantages -> triangulate)",
    "ble":  "proximity cross-check (which node a device is nearest -> space map)",
    "cam":  "visual cross-check (one node's torch/screen -> another's camera sees it)",
}


def _tool_cmd(name):
    """Resolve a mesh tool under cron too; cron PATH commonly omits ~/.local/bin. -> path|None.

    (mesh-exit-node-lan-heal was caught BLIND rc=127 for 7 consecutive minutes on 2026-08-21
    for exactly this — a bare tool name under cron's /usr/bin:/bin. This tool is */10.)"""
    found = shutil.which(name)
    if found:
        return found
    local = os.path.expanduser("~/.local/bin/" + name)
    if os.path.exists(local) and os.access(local, os.X_OK):
        return local
    return None


def _mesh_minds_cmd():
    found = _tool_cmd("mesh-minds")
    if found is None:
        raise FileNotFoundError("mesh-minds not found in PATH or ~/.local/bin")
    return found


def _phys_carrier_changes():
    """Monotonic count of link up/down transitions on this node's PHYSICAL uplink(s), or None.

    `carrier_changes` is a boot-scoped kernel ACCUMULATOR, unprivileged and 0444. Delta'd across
    the probe span it answers the one question `_self_transport` below cannot: did OUR OWN link go
    down WHILE we were probing? Virtual devices (lo, tailscale0, docker*, veth*) are excluded by
    the /sys/devices/virtual/net path, not by a name allowlist — a name list ages out and this
    node's uplink is a USB dongle whose ifname is bus-derived (wlxbcec43434a22).

    None = no physical netdev exposed a readable counter. That is BLINDNESS and it is published as
    such; it is never folded into a verdict."""
    total, seen = 0, 0
    try:
        names = os.listdir("/sys/class/net")
    except OSError:
        return None
    for n in names:
        base = "/sys/class/net/" + n
        try:
            if "/devices/virtual/net/" in os.path.realpath(base):
                continue
            with open(base + "/carrier_changes") as fh:
                total += int(fh.read().strip())
            seen += 1
        except (OSError, ValueError):
            continue
    return total if seen else None


def _self_transport():
    """Was OUR OWN transport down while we were probing? -> "ok" | "swallowed" | "unknown".

    The re-probe guard below catches a PARTIAL harvest (one SSH fan-out timing out). It is
    structurally blind to a COMMON-MODE one: if this node's own LAN is swallowed by the
    exit-node route, BOTH probes fail identically, reach2 == reach1, and the verdict is
    "a drop both probes agree on" — the exact shape of two independent witnesses. It is one
    measurement taken twice over one broken FIB. Measured 2026-08-21T19:10:34Z: reached fell
    4 -> 2 and was badged drop-corroborated while the LAN was swallowed; the two SURVIVORS
    were mesh-home (local) and note3 (adb-over-USB) — precisely the two devices that need no
    network. The healer re-installed the throw route at 19:12:02Z and reach recovered.

    We ask the FIB via mesh-card --exit-node-lan, which routes a real address in this node's
    own LAN prefix and reads the DEVICE that comes back. NEVER the pref: the pref read true
    on 2026-08-21T10:50Z while the LAN was swallowed anyway (CLAUDE.local.md).

    "unknown" is a FIRST-CLASS answer, not a fallback to "ok": a node whose mesh-card has no
    --exit-node-lan leg, or that carries no exit node at all, cannot answer this question.
    Rendering that as "ok" would be a silent fallback turning a failure into a plausible
    constant — so it stays unknown and the verdict word is QUALIFIED, never bare.
    """
    cmd = _tool_cmd("mesh-card")
    if cmd is None:
        return "unknown"
    try:
        out = subprocess.run([cmd, "--exit-node-lan"], capture_output=True, text=True,
                             timeout=20)
    except Exception:
        return "unknown"
    if out.returncode != 0:
        return "unknown"
    for ln in out.stdout.splitlines():
        if ln.startswith("state:"):
            v = ln.split(":", 1)[1].strip()
            return v if v in ("ok", "swallowed") else "unknown"
    return "unknown"


def _probe():
    """Source of truth = mesh-minds --json (per-node organs/senses/reached/caps, incl. LAN +
    macOS nodes). We reuse it so there is ONE cross-device prober, not two that drift."""
    try:
        out = subprocess.run([_mesh_minds_cmd(), "--json"], capture_output=True, text=True,
                             timeout=120).stdout
        return json.loads(out)
    except Exception:
        return []


# ACTIVE cross-checks: an ACTUATOR on one node drives a SENSOR on another (operator 2026-06-19:
# actuators VALIDATE senses, and together yield MORE than either — distance/acoustics/co-location).
# (label, actuator-set that emits, sensor that detects, what the pairing proves+derives)
ACTIVE = [
    ("audio",  {"speaker", "voice"}, "mic", "emit a tone -> hear it: proves both organs + ranges distance/co-location"),
    ("visual", {"torch"},            "cam", "flash -> camera sees it: proves both + line-of-sight"),
]


def _device_senses(nodes):
    devs = []
    for n in nodes:
        senses = list(dict.fromkeys((n.get("organs") or []) + (n.get("senses") or [])))
        devs.append({
            "host": n.get("host") or "?",
            "ip": n.get("ip") or "?",
            "reached": bool(n.get("reached")),
            "online": bool(n.get("online")),
            "senses": senses,
            "actuators": list(n.get("actuators") or []),
            "transport": n.get("transport"),   # non-Tailscale transport (e.g. adb-via-ds); None = tailnet/LAN
        })
    return devs


def _cross(devs):
    """PASSIVE cross-check: same sense on >=2 REACHED devices = multi-vantage validation (e.g. wifi
    RSSI from two nodes -> triangulate). Honest: only reached devices count."""
    by_sense = {}
    for d in devs:
        if not d["reached"]:
            continue
        for s in d["senses"]:
            by_sense.setdefault(s, []).append(d["host"])
    return {s: hosts for s, hosts in by_sense.items() if len(hosts) >= 2}


def _active(devs):
    """ACTIVE cross-check pairs: an actuator on one reached device + the matching sensor on a
    DIFFERENT reached device. Returns (label, emitters, hearers, desc) only when a cross-device
    pair genuinely exists (one box emits, another senses)."""
    reached = [d for d in devs if d["reached"]]
    out = []
    for label, act_set, sensor, desc in ACTIVE:
        emit = [d["host"] for d in reached if act_set & set(d["actuators"])]
        hear = [d["host"] for d in reached if sensor in d["senses"]]
        # Only the hosts that PARTICIPATE in a cross-device pair may be named. Listing every
        # emitter and every hearer once any single pair qualified made the rendered claim wider
        # than the tested one: a node that emits and hears with only ITSELF appeared in the emit
        # column of a lane it cannot actually drive (live 2026-08-18: mesh-home was printed as an
        # audio emitter beside note3, though the sole mic on the mesh is its own — the pairing is
        # note3->mesh-home and nothing else). Same shape as a fusion that names an axis it did not
        # measure: the columns are the proposed cross-check, so they must be exactly the hosts a
        # run would use.
        e_ok = sorted({e for e in emit for h in hear if e != h})
        h_ok = sorted({h for h in hear for e in emit if e != h})
        if e_ok and h_ok:                               # a real cross-device pairing exists
            out.append((label, e_ok, h_ok, desc))
    return out


def _reach_count(devs):
    return sum(1 for d in devs if d["reached"])


def _cached_reach():
    """reached-count of the LAST-GOOD cache, re-derived from its own rendered DEVICES block.

    Parsed from the block rather than from the header line this tool now writes, deliberately:
    a cache written before the header existed must still be comparable, so the partial-harvest
    guard binds on the FIRST run after deploy, not only after one write has happened.
    None = no cache / no DEVICES block (nothing to compare against — never a fabricated 0)."""
    try:
        txt = open(CACHE).read()
    except OSError:
        return None
    in_dev, n = False, 0
    for ln in txt.splitlines():
        if ln.startswith("-- DEVICES"):
            in_dev = True
            continue
        if in_dev and ln.startswith("--"):
            break
        if in_dev and ln[:1].isspace() and re.search(r"(?:^|\s)online(?=\s|$)", ln):
            n += 1
    return n if in_dev else None


def _drop_verdict(prev, reach1, reach2, transport="unknown"):
    """What a DROP in reach means. Pure (no I/O) so --test can drive every branch.

    prev      = last-good reach count (None = no comparable cache)
    reach1    = this probe's reach count
    reach2    = the corroborating RE-probe's reach count (None = it could not run / empty)
    transport = OUR OWN transport during the probe: "ok" | "swallowed" | "unknown"

    -> "write"   no drop, or a drop both probes agree on (a real outage — cache it)
       "write2"  the re-probe reached MORE: probe 1 was a PARTIAL harvest; cache the better one
       "refuse"  a drop nobody could corroborate — keep last-good, let the cache age visibly

    A drop measured while our OWN LAN was swallowed corroborates nothing however many times we
    re-probe it: both probes rode the same broken FIB, so agreement between them is one
    measurement repeated, not two witnesses. That is a "refuse" — the same outcome as a probe
    that could not run, because it is the same fact: we did not measure the peers.

    A RISE is still a write even when swallowed: reaching MORE than last-good cannot be an
    artifact of our own transport being down, so there is nothing to refuse.
    """
    if prev is None or reach1 >= prev:
        return "write"
    if transport in ("swallowed", "flapped"):
        return "refuse"
    if reach2 is None:
        return "refuse"
    return "write2" if reach2 > reach1 else "write"


def _state_word(prev, reached, transport):
    """The header verdict. Pure, so --test drives it — the WORD is what downstream reads.

    "drop-corroborated" is a strong claim (two witnesses agreed) and it must only be spoken
    when we know our own transport was up. Anything else either names the real cause
    ("drop-selfcaused") or QUALIFIES the word so no reader can mistake an unestablished
    self-transport for an established one.
    """
    if prev is None or reached >= prev:
        return "ok"
    if transport == "swallowed":
        # our own LAN was down: the peers were never measured. This is OUR fault, not theirs.
        return "drop-selfcaused"
    if transport == "flapped":
        # our own UPLINK went down mid-probe. Same shape as the swallow, different layer — and on
        # this node it is the far more frequent one (76 carrier_changes / 15 link-heal RECOVERED in
        # the 2.80 up-hours after the 2026-08-26T10:40Z boot = 27.1 and 5.4 per hour). The swallow
        # leg cannot see it: when the RTL8822BU deauths, table 52 is UNTOUCHED, so
        # `mesh-card --exit-node-lan` reads `state: ok` and this function used to return the
        # STRONGEST verdict it has about peers that were never reachable through us.
        return "drop-selfcaused(link-flap)"
    if transport == "ok":
        return "drop-corroborated"
    # we could not establish whether our own transport was up -> the word stays QUALIFIED.
    return "drop-corroborated(self-transport:unknown)"


def _render(devs, cross, active):
    lines = []
    lines.append("-- DEVICES: senses + actuators (harvest from ALL — sensors AND ways to act) --")
    for d in sorted(devs, key=lambda x: (not x["reached"], x["host"])):
        if d["reached"]:
            st = "online"
            ss = " ".join(d["senses"]) or "(no senses)"
            ac = (" | act: " + " ".join(d["actuators"])) if d["actuators"] else ""
        elif d["online"]:
            st, ss, ac = "unreach", "?", ""
        else:
            st, ss, ac = "offline", "?", ""
        tp = f"  [{d['transport']}]" if d.get("transport") else ""   # tag non-Tailscale nodes with how they're reached
        lines.append(f"  {d['host']:<26} {st:<8} {ss}{ac}{tp}")
    lines.append("-- ACTIVE cross-checks (actuator on one node -> sensor on another: validate + derive) --")
    if active:
        for label, emit, hear, desc in active:
            lines.append(f"  {label:<6} emit[{', '.join(emit)}] -> hear[{', '.join(hear)}] — {desc}")
    else:
        lines.append("  (no actuator->sensor pair across 2 devices yet — need an emitter + a hearer online)")
    lines.append("-- PASSIVE cross-checks (same sense on >=2 nodes -> multi-vantage) --")
    if cross:
        for s, hosts in sorted(cross.items()):
            lines.append(f"  {s:<5} ×{len(hosts)} ({', '.join(hosts)}) — {CROSS.get(s, 'cross-check')}")
    else:
        lines.append("  (no sense yet on >=2 reached devices)")
    return "\n".join(lines)


def main():
    args = sys.argv[1:]
    if "--test" in args:
        # cron runs with a stripped PATH; the refresh must still find mesh-minds or it will
        # smoke-pass while preserving a stale cache forever.
        old_path = os.environ.get("PATH", "")
        try:
            os.environ["PATH"] = "/usr/bin:/bin"
            resolved = _mesh_minds_cmd()
        except Exception as e:
            print(f"smoke-test: FAIL (cron PATH cannot resolve mesh-minds: {e})"); sys.exit(1)
        finally:
            os.environ["PATH"] = old_path
        if not os.path.exists(resolved) or not os.access(resolved, os.X_OK):
            print(f"smoke-test: FAIL (resolved mesh-minds not executable: {resolved})"); sys.exit(1)
        # logic self-test: cross() must require >=2 reached devices and ignore unreached vantages.
        devs = [
            {"host": "a", "reached": True,  "online": True,  "senses": ["mic", "wifi"], "actuators": ["speaker"]},
            {"host": "b", "reached": True,  "online": True,  "senses": ["mic"],         "actuators": []},
            {"host": "c", "reached": False, "online": True,  "senses": ["mic", "wifi"], "actuators": ["speaker"]},
        ]
        cr = _cross(devs)
        if set(cr.get("mic", [])) != {"a", "b"} or "wifi" in cr:
            print(f"smoke-test: FAIL (cross={cr})"); sys.exit(1)
        ac = _active(devs)
        # a(speaker)->b(mic) is a valid cross-device audio pair; c is unreached so it must not count
        if not ac or ac[0][0] != "audio" or "c" in ac[0][1] or "c" in ac[0][2]:
            print(f"smoke-test: FAIL (active={ac})"); sys.exit(1)
        # a carries BOTH the speaker and a mic, so it qualifies for neither column on its own: the
        # only cross-device pair is a->b. A rendering that lists every emitter and every hearer as
        # soon as ONE pair qualifies would print a in the hear column, claiming a cross-check the
        # run could not perform. Assert the columns are exactly the participating hosts.
        if set(ac[0][1]) != {"a"} or set(ac[0][2]) != {"b"}:
            print(f"smoke-test: FAIL (active columns name non-participating hosts: emit={ac[0][1]} hear={ac[0][2]})"); sys.exit(1)
        # LIVE TOPOLOGY case (the one the first fixture cannot express): a SINGLE hearer that also
        # emits. With only one hearer, "hear" can never exclude anyone, so the emit column is the
        # only place the over-claim can show — and every emitter participates unless the sole
        # hearer is itself. This is mesh-home (speaker+mic, the mesh's only mic) beside note3
        # (speaker): the audio pair is note3->mesh-home, and mesh-home must NOT be named an emitter.
        one_ear = [{"host": "hub", "reached": True, "online": True, "senses": ["mic"], "actuators": ["speaker"]},
                   {"host": "ph",  "reached": True, "online": True, "senses": [],      "actuators": ["speaker"]}]
        oa = _active(one_ear)
        if not oa or set(oa[0][1]) != {"ph"} or set(oa[0][2]) != {"hub"}:
            print(f"smoke-test: FAIL (single-hearer emit column over-claims: {oa})"); sys.exit(1)
        # ...and a node that can ONLY pair with itself must not open the lane at all.
        solo = [{"host": "s", "reached": True, "online": True, "senses": ["mic"], "actuators": ["speaker"]}]
        if _active(solo):
            print(f"smoke-test: FAIL (self-pair opened the ACTIVE lane: {_active(solo)})"); sys.exit(1)
        # empty/failed-probe guard: a healthy probe has >=1 reached-device-with-senses; an empty
        # or all-unreached probe must read as NOT healthy (so the cache-write is skipped, last-good kept).
        if not any(d["reached"] and d["senses"] for d in devs):
            print("smoke-test: FAIL (healthy-probe detector false-negative)"); sys.exit(1)
        if any(d["reached"] and d["senses"] for d in [{"host": "x", "reached": False, "senses": ["mic"]},
                                                      {"host": "y", "reached": True, "senses": []}]):
            print("smoke-test: FAIL (empty-probe not detected → would cache a hollow result)"); sys.exit(1)
        # partial-harvest guard (GUARD 2). The point of these cases is that the OLD guard passes
        # every one of them — assert that first, so the new gate is testing what it claims to.
        partial = [{"host": "local", "reached": True,  "senses": ["mic"], "actuators": []},
                   {"host": "p1",    "reached": True,  "senses": ["mic"], "actuators": []},
                   {"host": "p2",    "reached": False, "senses": [],      "actuators": []},
                   {"host": "p3",    "reached": False, "senses": [],      "actuators": []}]
        if not any(d["reached"] and d["senses"] for d in partial):
            print("smoke-test: FAIL (fixture is not a PARTIAL harvest — the old guard must pass it, "
                  "else this case proves nothing)"); sys.exit(1)
        if _reach_count(partial) != 2:
            print(f"smoke-test: FAIL (reach count {_reach_count(partial)}, expected 2)"); sys.exit(1)
        cases = [
            # (prev, reach1, reach2, transport, expected) — MEASURED shape line 2: 4 -> 2, re-probe 4
            ((4, 4, None, "ok"),   "write",  "no drop must write on ONE probe (no needless re-probe)"),
            ((4, 2, 4,    "ok"),   "write2", "a re-probe that reaches MORE = partial harvest -> cache it"),
            ((4, 2, 2,    "ok"),   "write",  "a drop BOTH probes agree on is a real outage -> cache it"),
            ((4, 2, 3,    "ok"),   "write2", "a better-but-still-low re-probe still beats probe 1"),
            ((4, 2, None, "ok"),   "refuse", "an uncorroborated drop must NOT overwrite last-good"),
            ((None, 1, None, "ok"), "write", "no comparable cache -> nothing to refuse against"),
            ((4, 5, None, "ok"),   "write",  "a RISE is never a partial harvest"),
            # the COMMON-MODE axis (measured 2026-08-21T19:10:34Z: 4 -> 2 while the LAN was
            # swallowed; the 2 survivors were the local node and an adb-over-USB phone).
            ((4, 2, 2,    "swallowed"), "refuse",
             "two probes AGREEING over our own swallowed FIB is ONE measurement twice, not "
             "corroboration — it must refuse, exactly as an unrunnable probe does"),
            ((4, 2, 4,    "swallowed"), "refuse",
             "even a re-probe that reached MORE is unusable while our own transport was down"),
            ((4, 5, None, "swallowed"), "write",
             "a RISE cannot be an artifact of our own transport being down -> nothing to refuse"),
            ((4, 2, 2,    "unknown"),   "write",
             "an UNANSWERABLE self-transport must not refuse every drop forever on a node with "
             "no --exit-node-lan leg; it writes, and the header word carries the qualifier"),
            # the SECOND common-mode axis (measured 2026-08-26T13:25Z): the uplink deauthed
            # mid-probe. Identical shape to the swallow one layer down, and INVISIBLE to it —
            # a dongle deauth leaves table 52 intact, so the swallow leg reads `state: ok`.
            ((4, 2, 2,    "flapped"), "refuse",
             "two probes agreeing across OUR OWN uplink going down is one measurement twice"),
            ((4, 2, 4,    "flapped"), "refuse",
             "even a re-probe that reached MORE is unusable while our own link was flapping"),
            ((4, 5, None, "flapped"), "write",
             "a RISE cannot be an artifact of our own link flapping -> nothing to refuse"),
        ]
        for args, want, why in cases:
            got = _drop_verdict(*args)
            if got != want:
                print(f"smoke-test: FAIL (_drop_verdict{args}={got}, expected {want} — {why})")
                sys.exit(1)
        # the 3-arg call site must still work (default transport) — a signature change that
        # silently broke an existing caller would be caught here, not in production.
        if _drop_verdict(4, 2, None) != "refuse":
            print("smoke-test: FAIL (the 3-arg _drop_verdict signature regressed)"); sys.exit(1)
        # A GATE YOU HAVE NOT SEEN FAIL IS NOT A GATE: break the self-cause arm and watch the
        # measured case flip back to the WRONG verdict. If this mutant still returns "refuse",
        # the arm above is vacuous (something else is producing the pass) and we must not ship.
        _real = _drop_verdict
        def _mutant(prev, reach1, reach2, transport="unknown"):
            if prev is None or reach1 >= prev:
                return "write"
            if reach2 is None:
                return "refuse"
            return "write2" if reach2 > reach1 else "write"   # the PRE-FIX body
        if _mutant(4, 2, 2, "swallowed") != "write":
            print("smoke-test: FAIL (the pre-fix body no longer reproduces the bug — this mutant "
                  "proves nothing about the new arm)"); sys.exit(1)
        if _real(4, 2, 2, "swallowed") == _mutant(4, 2, 2, "swallowed"):
            print("smoke-test: FAIL (fixed and pre-fix bodies AGREE on the measured case — the "
                  "self-cause arm is vacuous)"); sys.exit(1)
        # _self_transport reads the FIB probe's state FIELD, and an unanswerable probe is
        # "unknown" — never a fallback to "ok" (a silent fallback would restore the bug while
        # every test stayed green). Driven against a STUBBED mesh-card on a scratch PATH.
        import tempfile, stat as _stat
        _td = tempfile.mkdtemp(prefix="sense-map-test-")
        os.makedirs(_td + "/bin", exist_ok=True)
        def _stub(body):
            with open(_td + "/bin/mesh-card", "w") as fh:
                fh.write("#!/bin/sh\n" + body + "\n")
            os.chmod(_td + "/bin/mesh-card", 0o755)
        _oldpath = os.environ.get("PATH", "")
        try:
            os.environ["PATH"] = _td + "/bin:" + _oldpath
            for body, want, why in [
                ("echo 'state: swallowed'; echo 'net: 192.168.8.0/24'", "swallowed",
                 "a swallowed FIB must read as swallowed"),
                ("echo 'state: ok'; echo 'dev: wlan0'", "ok", "a healthy FIB must read as ok"),
                ("echo 'verdict: fine'", "unknown",
                 "a mesh-card with NO state: field (no --exit-node-lan leg) is UNKNOWN, not ok"),
                ("echo 'state: ok'; exit 3", "unknown",
                 "a NON-ZERO probe is unknown even when it printed a state: line"),
                ("echo 'state: banana'", "unknown", "an unrecognised state value is unknown"),
            ]:
                _stub(body)
                got = _self_transport()
                if got != want:
                    print(f"smoke-test: FAIL (_self_transport()={got}, expected {want} — {why})")
                    sys.exit(1)
        finally:
            os.environ["PATH"] = _oldpath
            shutil.rmtree(_td, ignore_errors=True)
        for args, want, why in [
            ((4, 2, "swallowed"), "drop-selfcaused",
             "a drop measured through our OWN swallowed LAN must NAME itself, never wear the "
             "word 'corroborated' — this is the 2026-08-21T19:10:34Z line"),
            ((4, 2, "ok"), "drop-corroborated", "a real drop with our transport up IS corroborated"),
            ((4, 2, "unknown"), "drop-corroborated(self-transport:unknown)",
             "an unestablished self-transport must QUALIFY the word, not drop the qualifier"),
            ((4, 2, "n/a"), "drop-corroborated(self-transport:unknown)",
             "the no-drop sentinel reaching this arm still must not assert corroboration"),
            ((4, 2, "flapped"), "drop-selfcaused(link-flap)",
             "a drop measured across OUR OWN uplink going down must NAME itself — this is the "
             "2026-08-26T13:25Z line, and the swallow leg is blind to it because a dongle deauth "
             "leaves table 52 intact so mesh-card --exit-node-lan still reads state: ok"),
            ((4, 4, "swallowed"), "ok", "no drop is no drop, whatever our transport did"),
            ((4, 4, "flapped"), "ok", "no drop is no drop, whatever our link did"),
            ((None, 1, "swallowed"), "ok", "no comparable cache -> no drop to classify"),
        ]:
            got = _state_word(*args)
            if got != want:
                print(f"smoke-test: FAIL (_state_word{args}={got}, expected {want} — {why})")
                sys.exit(1)
        # the bare word must be UNREACHABLE without an established-ok transport (the whole point)
        for _t in ("swallowed", "flapped", "unknown", "n/a", ""):
            if _state_word(4, 2, _t) == "drop-corroborated":
                print(f"smoke-test: FAIL (transport={_t!r} produced the BARE 'drop-corroborated' — "
                      f"the claim is only earned by an established-ok transport)"); sys.exit(1)
        # REAL-READ GATE on the uplink accumulator. `_phys_carrier_changes()` returning None is
        # honest BLINDNESS, but a helper that is blind ALWAYS is a hollow sense: it would silently
        # pin link=unknown forever and the flap leg would never fire on any node. So: if this node
        # exposes any PHYSICAL netdev with a readable carrier_changes, the helper must return a
        # real integer covering it. Where it exposes none, there is nothing to assert — say so.
        _phys = []
        for _n in (os.listdir("/sys/class/net") if os.path.isdir("/sys/class/net") else []):
            _b = "/sys/class/net/" + _n
            if "/devices/virtual/net/" in os.path.realpath(_b):
                continue
            if os.path.exists(_b + "/carrier_changes"):
                _phys.append(_n)
        if _phys:
            _cc = _phys_carrier_changes()
            if not isinstance(_cc, int):
                print(f"smoke-test: FAIL (physical netdev(s) {_phys} expose carrier_changes but "
                      f"_phys_carrier_changes() returned {_cc!r} — the flap leg is permanently "
                      f"blind, and a leg that can never fire is not a leg)"); sys.exit(1)
            _sum = 0
            for _n in _phys:
                with open("/sys/class/net/" + _n + "/carrier_changes") as _fh:
                    _sum += int(_fh.read().strip())
            if _cc != _sum:
                print(f"smoke-test: FAIL (_phys_carrier_changes()={_cc} != the sum {_sum} over "
                      f"{_phys} — it is not reading what it claims to read)"); sys.exit(1)
            # and it must EXCLUDE the virtual devices, or a tailscale0/docker flap would be
            # charged to the physical uplink. lo is always virtual and always present.
            if "lo" in _phys:
                print("smoke-test: FAIL (lo classified as physical — the virtual-path exclusion "
                      "is not working, so the counter is not about the uplink)"); sys.exit(1)
        # the cache-reach re-derivation must read the rendered block (and only the DEVICES block)
        rendered = _render([{"host": "a", "reached": True, "online": True, "senses": ["mic"], "actuators": []},
                            {"host": "b", "reached": True, "online": True, "senses": ["mic"], "actuators": []},
                            {"host": "c", "reached": False, "online": False, "senses": [], "actuators": []}],
                           {"mic": ["a", "b"]}, [])
        import tempfile as _tf
        global CACHE
        _keep = CACHE
        try:
            with _tf.NamedTemporaryFile("w", suffix=".txt", delete=False) as fh:
                fh.write("# harvest: reached=2/3 probes=1 state=ok\n" + rendered + "\n")
                CACHE = fh.name
            if _cached_reach() != 2:
                print(f"smoke-test: FAIL (_cached_reach read {_cached_reach()} from a 2-online "
                      f"cache — the guard would compare against a wrong last-good)"); sys.exit(1)
            os.unlink(CACHE)
            if _cached_reach() is not None:
                print("smoke-test: FAIL (absent cache must read None, never 0 — a fabricated 0 "
                      "would make every harvest look like a rise)"); sys.exit(1)
        finally:
            CACHE = _keep
        print("smoke-test: ok"); sys.exit(0)

    if "--cached" in args:
        if os.path.exists(CACHE):
            age = int(time.time() - os.path.getmtime(CACHE))
            am = f"{age//60}m" if age >= 60 else f"{age}s"
            try:
                sys.stdout.write(open(CACHE).read())
            except Exception:
                print("  (sense-map cache unreadable)")
            stale = "  ⚠️ STALE" if age > 1800 else ""
            print(f"  (cached {am} ago{stale})")
        else:
            print("  (no sense-map cache yet — reflex mesh-sense-map --refresh populates it)")
        return

    # Snapshot the uplink accumulator BEFORE probe 1 — the corroboration claim spans probe1..probe2,
    # so the window this must cover starts here, not at the drop check further down.
    carrier0 = _phys_carrier_changes()
    nodes = _probe()
    devs = _device_senses(nodes)
    if "--json" in args:
        cross, active = _cross(devs), _active(devs)
        print(json.dumps({"devices": devs, "cross": cross,
                          "active": [{"kind": a[0], "emit": a[1], "hear": a[2]} for a in active]},
                         indent=2)); return

    # GUARD 2 — PARTIAL vs COMPLETE (the `healthy` check below only separates EMPTY from FAILED).
    # `any(reached and senses)` trusts a sentinel that can never fail: the LOCAL node is always
    # reached and always has senses, so a harvest that got local + 1 of 4 peers (the rest timed out
    # in the SSH fan-out) reads "healthy" and overwrites last-good with a degraded map. Downstream
    # that single bad sample is AMPLIFIED, not averaged: this reflex is */10 while mesh-witness
    # samples every 2 min OFF THE CACHE, so one bad harvest is re-published as 5 consecutive ledger
    # rows — five correlated re-reads of one measurement, shaped exactly like five independent
    # confirmations of an outage. Measured 2026-08-15 (317 samples/10.6h): 12 low runs, EVERY ONE
    # exactly 5 rows long, each starting at minute = 2 mod 10 (the first witness tick after the cron
    # boundary). This is the coverage rule INVERTED — producer window WIDER than consumer cadence
    # manufactures apparent persistence, where the doctrine's case (window narrower) manufactures
    # blindness. So a DROP is never trusted on one probe: re-probe once and keep the better read.
    prev = _cached_reach()
    reach1 = _reach_count(devs)
    probes, verdict, transport, link = 1, "write", "n/a", "n/a"
    if prev is not None and reach1 < prev:
        # only on the drop path: the FIB probe is ~80ms but there is nothing to ask on a rise.
        transport = _self_transport()
        devs2 = _device_senses(_probe())
        probes = 2
        # SECOND common-mode leg. _self_transport asks ONE question — is the LAN swallowed by the
        # exit-node route — and is structurally blind to the uplink itself going down, which leaves
        # table 52 untouched and so reads `state: ok`. Measured 2026-08-26T13:25-13:26Z: six
        # consecutive `mesh-minds --json` reads of GL-MT3000 split 3 online / 3 offline while the
        # control `ping 192.168.8.1` returned `connect: Network is unreachable` and link-heal
        # independently logged `13:25:02Z ACTION reassociate state=DEAUTHED`. The presence prober
        # renders `offline` (NOT THERE) from OUR interface being down, and ping's exit code cannot
        # separate the two (measured: rc=1 for both no-reply and network-unreachable), so the
        # separation has to come from a local accumulator, not from the probe's own result.
        # It can only ever make the verdict MORE cautious: a flap overrides ok/unknown, but it
        # never upgrades a `swallowed` (already the strongest self-cause) into anything weaker.
        carrier1 = _phys_carrier_changes()
        if carrier0 is None or carrier1 is None:
            link = "unknown"
        elif carrier1 != carrier0:
            link = f"flapped({carrier1 - carrier0})"
        else:
            link = "steady"
        if link.startswith("flapped") and transport != "swallowed":
            transport = "flapped"
        # a second probe that came back EMPTY corroborates nothing (it is the failure mode itself)
        reach2 = _reach_count(devs2) if any(d["reached"] and d["senses"] for d in devs2) else None
        verdict = _drop_verdict(prev, reach1, reach2, transport)
        if verdict == "write2":
            devs = devs2

    cross = _cross(devs)
    active = _active(devs)
    reached = _reach_count(devs)
    state = _state_word(prev, reached, transport)
    header = (f"# harvest: reached={reached}/{len(devs)} probes={probes} state={state} "
              f"self-transport={transport} link={link} "
              f"last-good={prev if prev is not None else 'na'} "
              f"at={time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())}")
    body = header + "\n" + _render(devs, cross, active)
    print(body)

    if verdict == "refuse":
        if transport == "swallowed":
            sys.stderr.write(f"sense-map: reach dropped {prev} -> {reach1} while OUR OWN LAN was "
                             f"swallowed by the exit-node route — both probes rode the same broken "
                             f"FIB, so they corroborate nothing. Keeping last-good cache (this is "
                             f"our transport, not a peer outage; mesh-exit-node-lan-heal re-applies "
                             f"the throw route).\n")
        else:
            sys.stderr.write(f"sense-map: reach dropped {prev} -> {reach1} and the corroborating probe "
                             f"failed — keeping last-good cache (partial harvest, not an outage)\n")
        return
    # write cache (refresh + default both refresh it; the dash only ever reads --cached)
    # GUARD 1 (EMPTY vs FAILED; the PARTIAL vs COMPLETE half is GUARD 2 above): never overwrite a
    # good cache with an EMPTY/failed probe. The local node alone always
    # has senses + is always reached, so a healthy probe ALWAYS yields >=1 reached-device-with-senses.
    # Zero means mesh-minds returned [] (timeout / transient peer outage) — caching that empty result
    # would flash a hollow "no senses on any device" at the operator. Preserve last-good instead; the
    # cache simply AGES (visibly stale) until a healthy probe lands — failure looks different from empty.
    # (memory fusion-tools-distinguish-empty-from-failed.)
    healthy = any(d["reached"] and d["senses"] for d in devs)
    if not healthy and os.path.exists(CACHE):
        sys.stderr.write("sense-map: probe empty (peers unreachable?) — keeping last-good cache, not overwriting\n")
        return
    try:
        os.makedirs(os.path.dirname(CACHE), exist_ok=True)
        tmp = CACHE + ".tmp"
        with open(tmp, "w") as f:
            f.write(body + "\n")
        os.replace(tmp, CACHE)
    except Exception:
        pass


if __name__ == "__main__":
    main()
