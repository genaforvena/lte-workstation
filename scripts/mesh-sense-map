#!/usr/bin/env python3
# mesh-sense-map — the CROSS-DEVICE sense inventory + cross-validation candidates, CACHED.
#
# Operator 2026-06-19: senses must be harvested from EVERYTHING we reach (not just the phone),
# and the real value is CROSS-validation — a single sensor is weak; sensors that confirm each
# other across DEVICES are the signal (play a tone on one node's speaker, hear it on another's
# mic → proves both organs AND derives geometry). This tool is the inventory layer that makes
# those pairings visible: which device has which sense, and where a sense exists on >=2 devices
# (so it can be cross-checked).
#
# It is CHEAP for a dash loop only via the cache: --refresh runs the (slow, SSH-fan-out) probe
# and writes ~/.mesh/sense-map.txt; --cached just prints that file + its age. The senses top
# pane reads --cached; a reflex runs --refresh.
#
# Usage:  mesh-sense-map            # human table (live refresh)
#         mesh-sense-map --refresh  # force re-probe + write cache (the reflex mode)
#         mesh-sense-map --cached   # print cache + age (the dash mode — cheap)
#         mesh-sense-map --json     # machine-readable
#         mesh-sense-map --test     # smoke test
#
# reflex-cadence: */10 * * * *
# reflex-args: --refresh
import json, os, subprocess, sys, time

CACHE = os.path.expanduser("~/.mesh/sense-map.txt")
# senses that are genuinely cross-validatable across devices, and the cross-check each enables.
CROSS = {
    "mic":  "audio cross-check (one node plays a tone -> others' mics hear it -> proves organs + geometry)",
    "wifi": "presence/motion cross-check (RSSI radar from multiple vantages -> triangulate)",
    "ble":  "proximity cross-check (which node a device is nearest -> space map)",
    "cam":  "visual cross-check (one node's torch/screen -> another's camera sees it)",
}


def _probe():
    """Source of truth = mesh-minds --json (per-node organs/senses/reached/caps, incl. LAN +
    macOS nodes). We reuse it so there is ONE cross-device prober, not two that drift."""
    try:
        out = subprocess.run(["mesh-minds", "--json"], capture_output=True, text=True,
                             timeout=120).stdout
        return json.loads(out)
    except Exception:
        return []


def _device_senses(nodes):
    devs = []
    for n in nodes:
        senses = list(dict.fromkeys((n.get("organs") or []) + (n.get("senses") or [])))
        devs.append({
            "host": n.get("host") or "?",
            "ip": n.get("ip") or "?",
            "reached": bool(n.get("reached")),
            "online": bool(n.get("online")),
            "senses": senses,
        })
    return devs


def _cross(devs):
    """For each sense, the set of REACHED devices that have it; a sense on >=2 devices is
    cross-validatable. Honest: only reached devices count (a sense we could not confirm is not
    a usable vantage)."""
    by_sense = {}
    for d in devs:
        if not d["reached"]:
            continue
        for s in d["senses"]:
            by_sense.setdefault(s, []).append(d["host"])
    return {s: hosts for s, hosts in by_sense.items() if len(hosts) >= 2}


def _render(devs, cross):
    lines = []
    lines.append("-- DEVICE SENSES (cross-device inventory — harvest from ALL, not just the phone) --")
    for d in sorted(devs, key=lambda x: (not x["reached"], x["host"])):
        if d["reached"]:
            st = "online"
            ss = " ".join(d["senses"]) or "(none found)"
        elif d["online"]:
            st = "unreach"
            ss = "?"
        else:
            st = "offline"
            ss = "?"
        lines.append(f"  {d['host']:<26} {st:<8} {ss}")
    lines.append("-- CROSS-VALIDATION CANDIDATES (a sense on >=2 reached devices) --")
    if cross:
        for s, hosts in sorted(cross.items()):
            lines.append(f"  {s:<5} ×{len(hosts)} ({', '.join(hosts)}) — {CROSS.get(s, 'cross-check')}")
    else:
        lines.append("  (no sense yet confirmed on >=2 reached devices — bring more organs online)")
    return "\n".join(lines)


def main():
    args = sys.argv[1:]
    if "--test" in args:
        # logic self-test: cross() must require >=2 reached devices and ignore unreached vantages.
        devs = [
            {"host": "a", "reached": True,  "online": True,  "senses": ["mic", "wifi"]},
            {"host": "b", "reached": True,  "online": True,  "senses": ["mic"]},
            {"host": "c", "reached": False, "online": True,  "senses": ["mic", "wifi"]},
        ]
        cr = _cross(devs)
        if set(cr.get("mic", [])) != {"a", "b"} or "wifi" in cr:
            print(f"smoke-test: FAIL (cross={cr})"); sys.exit(1)
        print("smoke-test: ok"); sys.exit(0)

    if "--cached" in args:
        if os.path.exists(CACHE):
            age = int(time.time() - os.path.getmtime(CACHE))
            am = f"{age//60}m" if age >= 60 else f"{age}s"
            try:
                sys.stdout.write(open(CACHE).read())
            except Exception:
                print("  (sense-map cache unreadable)")
            stale = "  ⚠️ STALE" if age > 1800 else ""
            print(f"  (cached {am} ago{stale})")
        else:
            print("  (no sense-map cache yet — reflex mesh-sense-map --refresh populates it)")
        return

    nodes = _probe()
    devs = _device_senses(nodes)
    cross = _cross(devs)
    if "--json" in args:
        print(json.dumps({"devices": devs, "cross": cross}, indent=2)); return
    body = _render(devs, cross)
    print(body)
    # write cache (refresh + default both refresh it; the dash only ever reads --cached)
    try:
        os.makedirs(os.path.dirname(CACHE), exist_ok=True)
        tmp = CACHE + ".tmp"
        with open(tmp, "w") as f:
            f.write(body + "\n")
        os.replace(tmp, CACHE)
    except Exception:
        pass


if __name__ == "__main__":
    main()
