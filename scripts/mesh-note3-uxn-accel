#!/usr/bin/env bash
# orphan-ok: on-demand by design — see the NO-CADENCE paragraph below. This phone's
#            accelerometer is dead hardware; the lane it rides is kept alive by the
#            cadenced sibling mesh-note3-uxn-sense, so an unwired shim here is deliberate
#            absence, not a gap.
# mesh-note3-uxn-accel — deploy shim for the Note3 accelerometer read over the uxn lane.
#
# The real tool lives WITH its emulator and ROMs at scripts/uxn/mesh-note3-uxn-accel and
# resolves them relative to its own directory. A flat `cp` into ~/.local/bin does not deploy
# it, it BREAKS it: $HERE becomes ~/.local/bin, bin/uxncli is not there, every dial fails and
# the tool answers "n/a — listener unreachable" (exit 2) forever, which reads as a sleeping
# organ and lands green. ~/.local/bin carried exactly that copy from 2026-07-24 until
# 2026-08-19, when it was measured still doing it with the listener up and answering.
#
# NO `# reflex-cadence:` HERE, DELIBERATELY, and it must not be given one: this phone's
# accelerometer is 2/3 railed at int16 saturation and its sysfs node is a listener-enable
# LATCH, so cronning it would wire a hollow sense on a schedule. The tool's own header
# carries the measurements. The termux-free lane is kept alive by its sibling
# mesh-note3-uxn-sense, which reads a path that is actually live.
set -eu
REPO="${MESH_REPO:-$HOME/lte-workstation}"
TARGET="$REPO/scripts/uxn/mesh-note3-uxn-accel"
[ -x "$TARGET" ] || { echo "mesh-note3-uxn-accel: n/a — no genome checkout at $TARGET (set MESH_REPO)" >&2; exit 2; }
exec "$TARGET" "$@"
