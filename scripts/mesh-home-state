#!/usr/bin/env bash
# reflex-cadence: 4-59/5 * * * *
# mesh-home-state — the CAUSE LAYER: fuse sensor traces → home situation inference
#
# Single sensor = FACT. Correlated sensors over time = CAUSE.
# This tool reads the sensor stream (sensors.log + presence + transcription) and
# infers WHAT IS HAPPENING in the home — not just what individual meters report.
#
# Output: one-line home state + confidence signals + contributing evidence
#
#   mesh-home-state              infer current home state, print + post to board
#   mesh-home-state --json       machine-readable output
#   mesh-home-state --watch      re-infer every 5 min, edge-triggered board post
#   mesh-home-state --test       smoke test
#
# State classes: QUIET_NIGHT | ASLEEP | WAKING | ACTIVE | ACTIVE_SOCIAL | AWAY
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

LOG="${MESH_SENSOR_LOG:-$HOME/.mesh/sensors.log}"
TRANSCRIPT="$HOME/.mesh/transcript.log"
STATE_FILE="$HOME/.mesh/.home-state"
MESH="$HOME/.mesh"

if [ "${1:-}" = --test ]; then
  [ -f "$LOG" ] || { echo "smoke-test: WARN (no sensors.log yet — inference falls back to time-based)"; }
  command -v python3 >/dev/null 2>&1 || { echo "smoke-test: FAIL (no python3)"; exit 1; }
  # Artifact test: inference must produce a valid 6-class state label (not just have deps installed)
  out="$("$0" --json 2>/dev/null)" || { echo "smoke-test: FAIL (inference errored)"; exit 1; }
  state="$(printf '%s' "$out" | python3 -c 'import sys,json; d=json.load(sys.stdin); print(d.get("state",""))' 2>/dev/null)"
  case "$state" in
    QUIET_NIGHT|ASLEEP|WAKING|ACTIVE|ACTIVE_SOCIAL|AWAY) : ;;
    *) echo "smoke-test: FAIL (unexpected state '${state:-empty}' — inference broken or output format changed)"; exit 1 ;;
  esac
  # AMBIENT-FUSION REGRESSION (2026-06-15): dark + silent + stable-wifi sensors score ASLEEP, but an
  # ACTIVE ambient-clock (TVs on) must VETO that. Hermetic fixture (own HOME) so it's hour-independent:
  # the 'ASLEEP vetoed' signal fires deterministically whenever ASLEEP was scored AND ambient=ACTIVE.
  td="$(mktemp -d)"; mkdir -p "$td/.mesh"; nowts="$(date -u +%FT%TZ)"
  { printf '%s host phone_light 1\n' "$nowts"; for _ in 1 2 3 4; do printf '%s host wifi_rssi -55\n' "$nowts"; done; } > "$td/.mesh/sensors.log"
  printf 'ACTIVE\n' > "$td/.mesh/.ambient-clock.state"
  vjson="$(HOME="$td" "$0" --json 2>/dev/null)"
  vstate="$(printf '%s' "$vjson" | python3 -c 'import sys,json; print(json.load(sys.stdin).get("state",""))' 2>/dev/null)"
  rm -rf "$td"
  printf '%s' "$vjson" | grep -q 'ASLEEP vetoed' || { echo "smoke-test: FAIL (ACTIVE ambient did not veto ASLEEP — no veto signal)"; exit 1; }
  [ "$vstate" = ASLEEP ] && { echo "smoke-test: FAIL (ASLEEP survived an ACTIVE ambient-clock → $vstate)"; exit 1; }
  # LIGHT-VETO REGRESSION (verify-rotation 2026-06-17): a LIT room must veto ASLEEP even when the
  # (possibly stale) lux + silence + stable-wifi fixture would otherwise score sleep — the false
  # ASLEEP-at-15h-while-LIT bug. Hermetic fixture; no .ambient-clock.state, so the ONLY veto path is
  # the fresh .light-state=LIT one.
  td2="$(mktemp -d)"; mkdir -p "$td2/.mesh"; nowts2="$(date -u +%FT%TZ)"
  { printf '%s host phone_light 1\n' "$nowts2"; for _ in 1 2 3 4; do printf '%s host wifi_rssi -55\n' "$nowts2"; done; } > "$td2/.mesh/sensors.log"
  printf 'LIT\n' > "$td2/.mesh/.light-state"
  ljson="$(HOME="$td2" "$0" --json 2>/dev/null)"
  lstate="$(printf '%s' "$ljson" | python3 -c 'import sys,json; print(json.load(sys.stdin).get("state",""))' 2>/dev/null)"
  rm -rf "$td2"
  printf '%s' "$ljson" | grep -q 'ASLEEP vetoed' || { echo "smoke-test: FAIL (LIT did not veto ASLEEP — no veto signal; state=$lstate)"; exit 1; }
  [ "$lstate" = ASLEEP ] && { echo "smoke-test: FAIL (ASLEEP survived a LIT room → $lstate)"; exit 1; }
  # 5-LEVEL REGRESSION (senses 2026-06-17): mesh-light now writes BRIGHT/MODERATE/DIM too — a BRIGHT
  # room is the brightest, so it MUST veto ASLEEP just like LIT. Catches the unmapped-level break.
  td3="$(mktemp -d)"; mkdir -p "$td3/.mesh"; nowts3="$(date -u +%FT%TZ)"
  { printf '%s host phone_light 1\n' "$nowts3"; for _ in 1 2 3 4; do printf '%s host wifi_rssi -55\n' "$nowts3"; done; } > "$td3/.mesh/sensors.log"
  printf 'BRIGHT\n' > "$td3/.mesh/.light-state"
  bjson="$(HOME="$td3" "$0" --json 2>/dev/null)"
  bstate="$(printf '%s' "$bjson" | python3 -c 'import sys,json; print(json.load(sys.stdin).get("state",""))' 2>/dev/null)"
  rm -rf "$td3"
  printf '%s' "$bjson" | grep -q 'ASLEEP vetoed' || { echo "smoke-test: FAIL (BRIGHT did not veto ASLEEP — 5-level not folded; state=$bstate)"; exit 1; }
  [ "$bstate" = ASLEEP ] && { echo "smoke-test: FAIL (ASLEEP survived a BRIGHT room → $bstate)"; exit 1; }
  # BODY-MOTION VETO (2026-06-20): a walking body-motion reading must veto ASLEEP + QUIET_NIGHT
  # even in the classic dark+silent+stable-wifi fixture that normally scores sleep heavily.
  td_bm="$(mktemp -d)"; mkdir -p "$td_bm/.mesh"; _ts_bm="$(date -u +%FT%TZ)"
  { printf '%s host phone_light 1\n' "$_ts_bm"; for _ in 1 2 3 4; do printf '%s host wifi_rssi -55\n' "$_ts_bm"; done; } > "$td_bm/.mesh/sensors.log"
  printf 'DARK\n' > "$td_bm/.mesh/.light-state"
  printf '1000|[body-walking]|2|\n' > "$td_bm/.mesh/.body-motion-state"
  bm_j="$(HOME="$td_bm" "$0" --json 2>/dev/null)"
  bm_s="$(printf '%s' "$bm_j" | python3 -c 'import sys,json; print(json.load(sys.stdin).get("state",""))' 2>/dev/null)"
  rm -rf "$td_bm"
  printf '%s' "$bm_j" | grep -q 'sleep states vetoed' || { echo "smoke-test: FAIL (body-walking did not veto sleep states in home-state)"; exit 1; }
  [ "$bm_s" = ASLEEP ] && { echo "smoke-test: FAIL (ASLEEP survived body-walking → $bm_s)"; exit 1; }
  # AMBIENT-TREND RISING (2026-06-20): rising TV count in .ambient-clock-trend must appear in signals.
  td_tr="$(mktemp -d)"; mkdir -p "$td_tr/.mesh"; _ts_tr="$(date -u +%FT%TZ)"
  printf '%s host wifi_rssi -60\n' "$_ts_tr" > "$td_tr/.mesh/sensors.log"
  _tnow_tr="$(date +%s)"; _told_tr="$(( _tnow_tr - 900 ))"
  printf '%d|0\n%d|3\n' "$_told_tr" "$_tnow_tr" > "$td_tr/.mesh/.ambient-clock-trend"
  tr_j="$(HOME="$td_tr" "$0" --json 2>/dev/null)"
  rm -rf "$td_tr"
  printf '%s' "$tr_j" | grep -q 'ambient-trend=RISING' || { echo "smoke-test: FAIL (ambient-trend=RISING not in home-state signals)"; exit 1; }
  echo "smoke-test: ok ($state; ambient-veto→$vstate; light-veto→$lstate; bright-veto→$bstate; body-motion-veto→$bm_s≠ASLEEP; trend-rising→ok)"; exit 0
fi

# Ambient-clock cached verdict (chat-review/household-ambient-fusion 2026-06-15): read the label
# mesh-ambient-clock --edge already wrote to its state file — a CACHED read, no BLE re-scan (same
# cheap-fusion discipline as mesh-situation reading .perimeter.state). Absent/empty file → "" → the
# axis simply does not contribute (honest: a missing axis is silent, never faked). MESH_AMBIENT_STATE
# lets --test point at a fixture.
AMBIENT_STATE_FILE="${MESH_AMBIENT_STATE:-$MESH/.ambient-clock.state}"
AMBIENT_LABEL="$(head -1 "$AMBIENT_STATE_FILE" 2>/dev/null | tr -d '[:space:]')"
# Fresh ambient-LIGHT label (mesh-light --edge → .light-state, LIT/DARK). Authoritative over the
# sensors.log 'phone_light' lux, which goes STALE when phone sensor-collection lapses — the bug that
# let a LIT 15h room read ASLEEP (the lux axis was empty, so silence alone scored sleep). Cached read,
# no sensor re-poll. MESH_LIGHT_STATE lets --test point at a fixture. (verify-rotation 2026-06-17)
LIGHT_STATE_FILE="${MESH_LIGHT_STATE:-$MESH/.light-state}"
LIGHT_LABEL="$(head -1 "$LIGHT_STATE_FILE" 2>/dev/null | tr -d '[:space:]')"

# Fresh body-motion tag: steps|[body-tag]|hyst|pending → extract the tag field only.
# MESH_BODY_STATE_FILE lets --test point at a hermetic fixture.
BODY_STATE_FILE="${MESH_BODY_STATE_FILE:-$MESH/.body-motion-state}"
BODY_TAG="$(cut -d'|' -f2 "$BODY_STATE_FILE" 2>/dev/null | head -1 || true)"

# Ambient-clock trend from the rolling .ambient-clock-trend file (written by mesh-ambient-clock).
# Format: epoch|tv_count lines. Trend = compare last entry (current) vs entry closest to 15 min ago.
# INITIAL when no file or no entry in the 10–30 min window. Staleness guard: last entry > 25 min → skip.
AMBIENT_TREND_FILE="${MESH_AMBIENT_TREND_FILE:-$MESH/.ambient-clock-trend}"
AMBIENT_TREND="INITIAL"
if [ -f "$AMBIENT_TREND_FILE" ]; then
  _now_ep="$(date +%s)"
  _last_ts="$(tail -1 "$AMBIENT_TREND_FILE" 2>/dev/null | cut -d'|' -f1)"
  _curr_tv="$(tail -1 "$AMBIENT_TREND_FILE" 2>/dev/null | cut -d'|' -f2)"
  if [ -n "$_last_ts" ] && [ -n "$_curr_tv" ] && [ "$(( _now_ep - _last_ts ))" -lt 1500 ] 2>/dev/null; then
    _older="$(awk -v now="$_now_ep" 'BEGIN{b="";d=9999}{split($0,a,"|");ag=now-a[1];if(ag>=600&&ag<=1800){dd=ag-900;if(dd<0)dd=-dd;if(dd<d){d=dd;b=a[2]}}}END{print b}' "$AMBIENT_TREND_FILE" 2>/dev/null || true)"
    if [ -n "$_older" ] && [ "$_curr_tv" -eq "$_curr_tv" ] 2>/dev/null && [ "$_older" -eq "$_older" ] 2>/dev/null; then
      if   [ "$_curr_tv" -gt "$_older" ]; then AMBIENT_TREND="RISING"
      elif [ "$_curr_tv" -lt "$_older" ]; then AMBIENT_TREND="FALLING"
      else AMBIENT_TREND="STABLE"
      fi
    fi
  fi
fi

# Fresh room-sense verdict from .room-sense.state (written by mesh-room-sense --edge reflex).
# Overrides the potentially stale room_sense value in sensors.log.
ROOM_STATE_FILE="${MESH_ROOM_STATE_FILE:-$MESH/.room-sense.state}"
ROOM_FRESH="$(head -1 "$ROOM_STATE_FILE" 2>/dev/null | tr -d '[:space:]' || true)"

# ── Inference engine ─────────────────────────────────────────────────────────
python3 - "$LOG" "$TRANSCRIPT" "${1:-}" "$AMBIENT_LABEL" "$LIGHT_LABEL" "$BODY_TAG" "$AMBIENT_TREND" "$ROOM_FRESH" << 'PYEOF'
import sys, os, re, json
from datetime import datetime, timezone, timedelta
from collections import defaultdict

log_path   = sys.argv[1]
trans_path = sys.argv[2]
mode       = sys.argv[3] if len(sys.argv) > 3 else ""
amb        = sys.argv[4].strip().upper() if len(sys.argv) > 4 else ""   # ambient-clock cached label
light_state= sys.argv[5].strip().upper() if len(sys.argv) > 5 else ""   # fresh .light-state (5 levels)
body_tag   = sys.argv[6].strip()         if len(sys.argv) > 6 else ""   # [body-walking] / [body-still] etc.
amb_trend  = sys.argv[7].strip().upper() if len(sys.argv) > 7 else "INITIAL"  # RISING/FALLING/STABLE
room_fresh = sys.argv[8].strip().upper() if len(sys.argv) > 8 else ""   # PRESENT/EMPTY/UNCERTAIN
# mesh-light emits DARK/DIM/MODERATE/LIT/BRIGHT — fold to LIT/DARK for the veto (matches mesh-room-sense)
if light_state in ('BRIGHT', 'LIT', 'MODERATE'):
    light_state = 'LIT'
elif light_state in ('DARK', 'DIM'):
    light_state = 'DARK'

NOW = datetime.now(timezone.utc)
WINDOW = timedelta(minutes=15)   # look at last 15 min of sensor data

# ── Parse sensor log: last WINDOW minutes ──────────────────────────────────
snaps = defaultdict(lambda: defaultdict(list))   # ts → sensor_type → [val,...]
try:
    with open(log_path) as f:
        for line in f:
            parts = line.strip().split()
            if len(parts) < 4: continue
            try:
                ts = datetime.fromisoformat(parts[0].replace('Z','+00:00'))
            except ValueError:
                continue
            if NOW - ts > WINDOW: continue
            stype = parts[2]
            val   = " ".join(parts[3:])
            snaps[ts][stype].append(val)
except FileNotFoundError:
    snaps = {}

# Flatten to most-recent value per sensor type
recent = {}
for ts in sorted(snaps):
    for stype, vals in snaps[ts].items():
        recent[stype] = vals[-1]

# ── Parse transcript: word count in last 15 min ─────────────────────────────
speech_words = 0
try:
    with open(trans_path) as f:
        for line in f:
            parts = line.strip().split(None, 1)
            if len(parts) < 2: continue
            try:
                ts = datetime.fromisoformat(parts[0].replace('Z','+00:00'))
                if NOW - ts <= WINDOW:
                    speech_words += len(parts[1].split())
            except (ValueError, IndexError):
                pass
except FileNotFoundError:
    pass

# ── Signal extraction ────────────────────────────────────────────────────────
hour_utc = NOW.hour  # 0-23; adjust for local if needed (assume UTC+3)
hour_loc = (hour_utc + 3) % 24

ble_count   = int(recent.get('ble_count', 0) or 0)
ble_named   = int(recent.get('ble_named', 0) or 0)
ble_top     = recent.get('ble_top', '')          # "RSSI|DeviceName"
room_sense  = recent.get('room_sense', 'UNCERTAIN')
if room_fresh in ('PRESENT', 'EMPTY', 'UNCERTAIN'):
    room_sense = room_fresh   # fresh .room-sense.state overrides potentially stale sensors.log
light       = recent.get('phone_light', '')
bat_pct_s   = recent.get('phone_battery', '')    # "PCT status"
bat_temp    = recent.get('phone_battery_temp', '')
cpu_temp    = recent.get('therm_x86_pkg_temp', recent.get('cpu_temp', ''))
cpu_load    = recent.get('cpu_load1', '')

# WiFi RSSI variance → motion proxy (higher variance = more movement)
wifi_vals = [snaps[ts].get('wifi_rssi', []) for ts in sorted(snaps)]
rssi_series = []
for ts in sorted(snaps):
    for v in snaps[ts].get('wifi_rssi', []):
        try:
            rssi_series.append(int(v.split()[-1]))
        except (ValueError, IndexError):
            pass
# FAT-TAIL ESTIMATION GAP (Taleb, *Statistical Consequences of Fat Tails*, 4th ed. 2025):
# the RANGE (max−min) is the single most fragile dispersion estimator under fat tails —
# it is, by definition, determined ENTIRELY by the two most extreme samples (the purest case
# of the max-to-sum / κ pathology: one observation dominates the statistic). RSSI is fat-tailed
# in practice — a transient scan glitch / edge-AP dropout reads −90..−95 dBm against a −40..−70
# baseline. ONE such sample inflates this "variance" past the ≥10 band → false "motion" → ACTIVE,
# corrupting the household state even in an empty/asleep room (and the harm is one-sided: a single
# tail sample only ever WIDENS the range, never narrows it, so calm windows are not robustly read
# as STILL either). The mesh ALREADY embodies the fix elsewhere — mesh-wifi-motion derives its
# device-free motion from each anchor's drift vs its OWN MEDIAN baseline ("robust to flicker",
# mesh-wifi-motion:88,91) — but this parallel proxy reached for the maximally tail-fragile range.
# HELD FIX (steward lands — behavioral, not safe-direction): replace with a robust dispersion —
# IQR (p75−p25) or MAD over rssi_series — so a lone dropout no longer flips the state; the ≥10/≤3
# bands must be RE-CALIBRATED (IQR/MAD run smaller than the range, so today's cutoffs don't carry
# over). Instrument-first on a hot */5 household inference. See [[fusion-tools-distinguish-empty-from-failed]].
wifi_variance = max(rssi_series) - min(rssi_series) if len(rssi_series) > 1 else 0

# Named-device roster (from ble_top and known devices in presence log)
known_devices = {'LE-Bose': 'audio', 'Quest 3': 'vr', 'Nintendo': 'gaming',
                 'PlayStation': 'gaming', 'TV': 'media', 'SoundLink': 'audio'}
active_devices = []
for kw, role in known_devices.items():
    if kw.lower() in ble_top.lower():
        active_devices.append(role)

# ── Inference rules (combine signals → state) ──────────────────────────────
signals = []
score   = {}   # state → evidence count

def sig(label):
    signals.append(label)

if room_fresh in ('PRESENT', 'EMPTY', 'UNCERTAIN'):
    sig(f"room-fresh={room_fresh}")

# Night hours
if 23 <= hour_loc or hour_loc < 6:
    score['QUIET_NIGHT'] = score.get('QUIET_NIGHT', 0) + 2
    sig(f"hour={hour_loc}h (night)")
elif 6 <= hour_loc < 9:
    score['WAKING'] = score.get('WAKING', 0) + 1
    sig(f"hour={hour_loc}h (morning)")

# Presence / BLE
if room_sense == 'EMPTY' and ble_named <= 1:
    score['AWAY'] = score.get('AWAY', 0) + 3
    sig("room=EMPTY, BLE sparse → likely away")
elif ble_named >= 4:
    score['ACTIVE_SOCIAL'] = score.get('ACTIVE_SOCIAL', 0) + 2
    sig(f"ble_named={ble_named} → several devices active")
elif ble_named >= 2:
    score['ACTIVE'] = score.get('ACTIVE', 0) + 1
    sig(f"ble_named={ble_named} devices present")

if ble_count >= 8:
    score['ACTIVE'] = score.get('ACTIVE', 0) + 1
    sig(f"ble_count={ble_count} (rich environment)")

# Speech activity
if speech_words >= 50:
    score['ACTIVE'] = score.get('ACTIVE', 0) + 2
    sig(f"speech={speech_words} words in 15min → active conversation")
elif speech_words >= 15:
    score['WAKING'] = score.get('WAKING', 0) + 1
    sig(f"speech={speech_words} words (low, ambient)")
elif speech_words == 0:
    score['QUIET_NIGHT'] = score.get('QUIET_NIGHT', 0) + 1
    score['ASLEEP']      = score.get('ASLEEP', 0) + 1
    sig("speech=0 (silent)")

# Light proxy (lux)
if light:
    try:
        lux = float(light)
        if lux < 5:
            score['ASLEEP']     = score.get('ASLEEP', 0) + 2
            score['QUIET_NIGHT']= score.get('QUIET_NIGHT', 0) + 1
            sig(f"light={lux:.0f}lux (dark)")
        elif lux > 100:
            score['ACTIVE'] = score.get('ACTIVE', 0) + 1
            sig(f"light={lux:.0f}lux (lit)")
    except ValueError:
        pass

# WiFi motion proxy
if wifi_variance >= 10:
    score['ACTIVE'] = score.get('ACTIVE', 0) + 1
    sig(f"wifi_variance={wifi_variance}dBm (motion)")
elif wifi_variance <= 3 and len(rssi_series) > 3:
    score['ASLEEP']     = score.get('ASLEEP', 0) + 1
    score['QUIET_NIGHT']= score.get('QUIET_NIGHT', 0) + 1
    sig(f"wifi_variance={wifi_variance}dBm (stable, no motion)")

# Audio device active → entertainment
if 'audio' in active_devices:
    score['ACTIVE'] = score.get('ACTIVE', 0) + 1
    sig("Bose active → audio playing or social")
if 'vr' in active_devices:
    score['ACTIVE_SOCIAL'] = score.get('ACTIVE_SOCIAL', 0) + 2
    sig("Quest 3 active → VR/gaming session")

# Battery temp → ambient
if bat_temp:
    try:
        bt = float(bat_temp)
        sig(f"ambient≈{bt:.0f}°C (phone battery temp)")
    except ValueError:
        pass

# ── Ambient-clock fusion axis ────────────────────────────────────────────────
# mesh-ambient-clock harvests fixed-appliance BLE (neighbor/home TVs, AC). An ACTIVE label = TVs on
# → real ambient activity that is INCOMPATIBLE with an ASLEEP inference. So ACTIVE adds ACTIVE
# evidence AND vetoes ASLEEP (drops it from contention so the max-pick can't land there). Narrow by
# design: it vetoes ASLEEP only, NOT QUIET_NIGHT (a neighbor's late TV doesn't disprove a quiet night).
if amb == 'ACTIVE':
    score['ACTIVE'] = score.get('ACTIVE', 0) + 1
    sig("ambient-clock=ACTIVE (TVs on)")
    if 'ASLEEP' in score:
        score.pop('ASLEEP', None)
        sig("ambient ACTIVE → ASLEEP vetoed")

# ── Fresh ambient-light fusion axis ──────────────────────────────────────────
# A LIT room is positive evidence AGAINST sleep — you don't sleep with the lights on. Mirror the
# ambient-ACTIVE veto: LIT adds ACTIVE evidence AND vetoes ASLEEP (NOT QUIET_NIGHT — the veto is
# ASLEEP-only). This is the fresh .light-state, so it fires even when the sensors.log lux is stale —
# the fix for the false ASLEEP-at-15h-while-LIT (verify-rotation 2026-06-17). DARK corroborates rest.
if light_state == 'LIT':
    score['ACTIVE'] = score.get('ACTIVE', 0) + 1
    sig("light=LIT (room lit)")
    if 'ASLEEP' in score:
        score.pop('ASLEEP', None)
        sig("light LIT → ASLEEP vetoed")
elif light_state == 'DARK':
    score['ASLEEP']      = score.get('ASLEEP', 0) + 1
    score['QUIET_NIGHT'] = score.get('QUIET_NIGHT', 0) + 1
    sig("light=DARK (room dark)")

# ── Body-motion fusion axis ──────────────────────────────────────────────────
# WALKING/CARRIED = phone physically moving → incompatible with sleep. Strong ACTIVE evidence;
# veto both ASLEEP and QUIET_NIGHT (motion at 3am is still ACTIVE, not a sleepy state).
# HANDLED = phone actively in hand → moderate active signal.
# COVERED = face-down/pocket → mild sleep corroboration (also nightstand, so low weight).
# Missing body_tag = phone offline or never polled → silent, not a false STILL.
if body_tag in ('[body-walking]', '[body-carried]'):
    score['ACTIVE'] = score.get('ACTIVE', 0) + 2
    sig(f"body={body_tag.strip('[]')} → locomotion")
    for _bs in ('ASLEEP', 'QUIET_NIGHT'):
        if _bs in score: score.pop(_bs)
    sig("body motion → sleep states vetoed")
elif body_tag == '[body-handled]':
    score['ACTIVE'] = score.get('ACTIVE', 0) + 1
    sig("body=HANDLED → phone in hand")
elif body_tag == '[body-covered]':
    score['ASLEEP'] = score.get('ASLEEP', 0) + 1
    sig("body=COVERED → face-down/pocket")

# ── Ambient-clock trend fusion axis ─────────────────────────────────────────
# Neighbors' TV count RISING = evening activity beginning → corroborates ACTIVE/WAKING.
# TV count FALLING = evening winding down → mild QUIET_NIGHT evidence.
# Low weight (+1): this measures the neighborhood, not the home occupant directly.
# INITIAL / STABLE = no additional evidence.
if amb_trend == 'RISING':
    score['ACTIVE'] = score.get('ACTIVE', 0) + 1
    sig("ambient-trend=RISING (TVs appearing → evening activity)")
elif amb_trend == 'FALLING':
    score['QUIET_NIGHT'] = score.get('QUIET_NIGHT', 0) + 1
    sig("ambient-trend=FALLING (TVs going off → evening ending)")

# ── DEGENERACY OF SUPPORT (Edelman & Gally, PNAS 2001) — the ACTIVE blind spot ─────────────
# 4E/enactivism cross-domain transfer (LITERATURE 2026-06-21): DEGENERACY = structurally
# DISSIMILAR components performing the SAME function. It is NOT redundancy: redundancy =
# identical copies (fail together under one fault); degeneracy = different mechanisms (one
# failing leaves the others standing). Edelman & Gally show degeneracy — not redundancy — is
# what makes biological function robust ("Degeneracy and complexity in biological systems",
# PNAS 98(24):13763, 2001; live 2024-25 review: PMC3350086 "Biological Robustness"). A derived
# state is robust to the extent its supporting evidence is DEGENERATE (spread across
# structurally-distinct sensing modalities), fragile to the extent it rides ONE.
#
# WHERE THIS FUSION COMMITS THE GAP — an ASYMMETRY the score model never names:
#   • ASLEEP is veto-CORROBORATED: ambient-clock (:337), LIT (:349), body-motion (:366) each
#     POP ASLEEP from contention — a structurally-distinct sense can overturn it.
#   • ACTIVE is purely ADDITIVE with NO degeneracy floor. A single modality-family can carry it:
#     wifi_variance≥10 ALONE → score['ACTIVE'] += 1 (:308) and, in a quiet window, win the argmax.
#     There is no requirement that ACTIVE be backed by ≥2 STRUCTURALLY-DISTINCT modalities.
# VERIFIED PROOF (this session's CORRELATION investigation, board 10:12 / knowledge
# correlation-home-active-desk-SPURIOUS): the 03:30 false-ACTIVE rode the fat-tail wifi-RSSI
# RANGE (:223-238) — ONE axis — while the structurally-distinct senses DISAGREED (body=STILL,
# light=dark). Non-degenerate support: one modality's fat-tail dropout felled the whole verdict.
#
# DISTINCT from the two adjacent fusion reviews (orthogonal axes — do not conflate):
#   • the fat-tail/range review (:223) fixes the ESTIMATOR of ONE axis (range→IQR/MAD). Even a
#     perfect per-axis estimator gives NO degeneracy if the verdict still rides that one axis.
#   • precision-weighting-fusion-gap (gossip, 2026-06-20) weights each vote by RELIABILITY. But
#     N high-reliability votes from the SAME modality-family are REDUNDANT, not degenerate — a
#     single structural fault still fells them together. Degeneracy counts DISTINCT structural
#     sources; precision weights each source. Different axis.
#
# HELD FIX (instrument-first, steward/operator lands — behavioral, not safe-direction):
# tag the verdict with a DEGENERACY COUNT = number of structurally-distinct modality-FAMILIES
# (wifi-motion / body-motion / light / acoustic-speech / BLE-presence) independently supporting
# the winning state, and either (a) require degeneracy≥2 before ACTIVE can win the argmax —
# symmetric to the ASLEEP vetoes — or (b) emit the count in --json so consumers discount a
# degeneracy=1 ACTIVE. WHY HELD: (1) it interacts with the :234 range→IQR fix — repairing the
# RSSI estimator removes the dominant false-ACTIVE source, so sequence matters; (2) a naive raw
# count would UNDER-call a legitimate single-strong-modality ACTIVE (loud speech ALONE is real
# activity — speech IS a structurally-distinct strong source), so the floor must be
# modality-family-aware, not a vote count. Validate against sensor-tape.tsv before gating a hot
# */5 household inference. See [[fusion-tools-distinguish-empty-from-failed]],
# [[review-coupling-constitution-fallacy-mesh-card-2026-06-21]] (the membership-direction sibling).
#
# ── Pick best state ──────────────────────────────────────────────────────────
fallback = 'UNCERTAIN'
if not score:
    state = fallback
else:
    state = max(score, key=lambda s: (score[s], ['AWAY','QUIET_NIGHT','ASLEEP','WAKING','ACTIVE','ACTIVE_SOCIAL','UNCERTAIN'].index(s) if s in ['AWAY','QUIET_NIGHT','ASLEEP','WAKING','ACTIVE','ACTIVE_SOCIAL','UNCERTAIN'] else 0))
    if score[state] == 0:
        state = fallback

# ── Human-readable summary ───────────────────────────────────────────────────
desc = {
    'AWAY':         'nobody home',
    'QUIET_NIGHT':  'home quiet (night)',
    'ASLEEP':       'someone home, likely asleep',
    'WAKING':       'waking up or winding down',
    'ACTIVE':       'home active',
    'ACTIVE_SOCIAL':'home lively (multiple devices/people)',
    'UNCERTAIN':    'state unclear',
}

# Key evidence (top 3 signals)
evidence = " · ".join(signals[:4]) if signals else "no signals"
summary = f"[home-state] {state}: {desc.get(state,'?')} | {evidence}"

if mode == "--json":
    out = {"state": state, "desc": desc.get(state,"?"),
           "signals": signals, "score": score,
           "ble_count": ble_count, "ble_named": ble_named,
           "speech_words": speech_words, "wifi_variance": wifi_variance,
           "ambient": amb, "ambient_trend": amb_trend,
           "body_tag": body_tag, "room_fresh": room_fresh,
           "hour_local": hour_loc}
    print(json.dumps(out))
else:
    print(summary)
