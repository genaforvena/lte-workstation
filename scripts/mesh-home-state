#!/usr/bin/env bash
# reflex-cadence: 4-59/5 * * * *
# mesh-home-state — the CAUSE LAYER: fuse sensor traces → home situation inference
#
# Single sensor = FACT. Correlated sensors over time = CAUSE.
# This tool reads the sensor stream (sensors.log + presence + transcription) and
# infers WHAT IS HAPPENING in the home — not just what individual meters report.
#
# Output: one-line home state + confidence signals + contributing evidence
#
#   mesh-home-state              infer current home state, print + post to board
#   mesh-home-state --json       machine-readable output
#   mesh-home-state --watch      re-infer every 5 min, edge-triggered board post
#   mesh-home-state --test       smoke test
#
# State classes: QUIET_NIGHT | ASLEEP | WAKING | ACTIVE | ACTIVE_SOCIAL | AWAY
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

LOG="${MESH_SENSOR_LOG:-$HOME/.mesh/sensors.log}"
TRANSCRIPT="$HOME/.mesh/transcript.log"
STATE_FILE="$HOME/.mesh/.home-state"
MESH="$HOME/.mesh"

if [ "${1:-}" = --test ]; then
  # Hermeticity (test-child-inherits-exported-tuning): a node-local exported MESH_HOME_MARGIN_LOG
  # would route every hermetic fixture run's off-manifold shadow row into the REAL calibration
  # ledger — a test-forged artifact poisoning the corpus the held gate calibrates against. Scrub it;
  # fixture rows then land inside each fixture's own throwaway $HOME.
  unset MESH_HOME_MARGIN_LOG
  [ -f "$LOG" ] || { echo "smoke-test: WARN (no sensors.log yet — inference falls back to time-based)"; }
  command -v python3 >/dev/null 2>&1 || { echo "smoke-test: FAIL (no python3)"; exit 1; }
  # Artifact test: inference must produce a valid 6-class state label (not just have deps installed)
  out="$("$0" --json 2>/dev/null)" || { echo "smoke-test: FAIL (inference errored)"; exit 1; }
  state="$(printf '%s' "$out" | python3 -c 'import sys,json; d=json.load(sys.stdin); print(d.get("state",""))' 2>/dev/null)"
  case "$state" in
    QUIET_NIGHT|ASLEEP|WAKING|ACTIVE|ACTIVE_SOCIAL|AWAY) : ;;
    *) echo "smoke-test: FAIL (unexpected state '${state:-empty}' — inference broken or output format changed)"; exit 1 ;;
  esac
  # AMBIENT-FUSION REGRESSION (2026-06-15): dark + silent + stable-wifi sensors score ASLEEP, but an
  # ACTIVE ambient-clock (TVs on) must VETO that. Hermetic fixture (own HOME) so it's hour-independent:
  # the 'ASLEEP vetoed' signal fires deterministically whenever ASLEEP was scored AND ambient=ACTIVE.
  td="$(mktemp -d)"; mkdir -p "$td/.mesh"; nowts="$(date -u +%FT%TZ)"
  { printf '%s host phone_light 1\n' "$nowts"; for _ in 1 2 3 4; do printf '%s host wifi_rssi -55\n' "$nowts"; done; } > "$td/.mesh/sensors.log"
  printf 'ACTIVE\n' > "$td/.mesh/.ambient-clock.state"
  vjson="$(HOME="$td" "$0" --json 2>/dev/null)"
  vstate="$(printf '%s' "$vjson" | python3 -c 'import sys,json; print(json.load(sys.stdin).get("state",""))' 2>/dev/null)"
  rm -rf "$td"
  printf '%s' "$vjson" | grep -q 'ASLEEP vetoed' || { echo "smoke-test: FAIL (ACTIVE ambient did not veto ASLEEP — no veto signal)"; exit 1; }
  [ "$vstate" = ASLEEP ] && { echo "smoke-test: FAIL (ASLEEP survived an ACTIVE ambient-clock → $vstate)"; exit 1; }
  # MULTI-FIELD STATE REGRESSION (senses 2026-07-03): the LIVE state-file format is now
  # LABEL|dwell_s=N|changes_24h=N (ambient-clock dwell enrichment 2026-06-28) — the exact-match
  # `amb == 'ACTIVE'` read the whole line and the veto axis was silently DEAD for 4 days while the
  # legacy 1-field fixture above stayed green. This fixture uses the live format: veto MUST fire.
  td_mf="$(mktemp -d)"; mkdir -p "$td_mf/.mesh"; _ts_mf="$(date -u +%FT%TZ)"
  { printf '%s host phone_light 1\n' "$_ts_mf"; for _ in 1 2 3 4; do printf '%s host wifi_rssi -55\n' "$_ts_mf"; done; } > "$td_mf/.mesh/sensors.log"
  printf 'ACTIVE|dwell_s=3600|changes_24h=4\n' > "$td_mf/.mesh/.ambient-clock.state"
  mf_j="$(HOME="$td_mf" "$0" --json 2>/dev/null)"
  mf_s="$(printf '%s' "$mf_j" | python3 -c 'import sys,json; print(json.load(sys.stdin).get("state",""))' 2>/dev/null)"
  rm -rf "$td_mf"
  printf '%s' "$mf_j" | grep -q 'ASLEEP vetoed' || { echo "smoke-test: FAIL (multi-field ACTIVE|dwell_s= state did not veto ASLEEP — label field not parsed, the 4-day dead-veto regression)"; exit 1; }
  [ "$mf_s" = ASLEEP ] && { echo "smoke-test: FAIL (ASLEEP survived a multi-field ACTIVE ambient state → $mf_s)"; exit 1; }
  # FIXTURE-SUSPECT DISCOUNT (senses 2026-07-03): an ACTIVE label held ≥24h unbroken (dwell_s from
  # the state file itself) is a non-cycling beacon — no clock info. It must NOT veto ASLEEP and must
  # surface the discount visibly instead of scoring as real activity.
  td_fx="$(mktemp -d)"; mkdir -p "$td_fx/.mesh"; _ts_fx="$(date -u +%FT%TZ)"
  { printf '%s host phone_light 1\n' "$_ts_fx"; for _ in 1 2 3 4; do printf '%s host wifi_rssi -55\n' "$_ts_fx"; done; } > "$td_fx/.mesh/sensors.log"
  printf 'ACTIVE|dwell_s=90000|changes_24h=0\n' > "$td_fx/.mesh/.ambient-clock.state"
  fx_j="$(HOME="$td_fx" "$0" --json 2>/dev/null)"
  rm -rf "$td_fx"
  printf '%s' "$fx_j" | grep -q 'fixture-suspect' || { echo "smoke-test: FAIL (24h-held ACTIVE not flagged fixture-suspect — discount signal missing)"; exit 1; }
  printf '%s' "$fx_j" | grep -q 'ambient ACTIVE → ASLEEP vetoed' && { echo "smoke-test: FAIL (fixture-suspect ACTIVE still vetoed ASLEEP — a non-cycling beacon is faking activity)"; exit 1; }
  # LIGHT-VETO REGRESSION (verify-rotation 2026-06-17): a LIT room must veto ASLEEP even when the
  # (possibly stale) lux + silence + stable-wifi fixture would otherwise score sleep — the false
  # ASLEEP-at-15h-while-LIT bug. Hermetic fixture; no .ambient-clock.state, so the ONLY veto path is
  # the fresh .light-state=LIT one.
  td2="$(mktemp -d)"; mkdir -p "$td2/.mesh"; nowts2="$(date -u +%FT%TZ)"
  { printf '%s host phone_light 1\n' "$nowts2"; for _ in 1 2 3 4; do printf '%s host wifi_rssi -55\n' "$nowts2"; done; } > "$td2/.mesh/sensors.log"
  printf 'LIT\n' > "$td2/.mesh/.light-state"
  ljson="$(HOME="$td2" "$0" --json 2>/dev/null)"
  lstate="$(printf '%s' "$ljson" | python3 -c 'import sys,json; print(json.load(sys.stdin).get("state",""))' 2>/dev/null)"
  rm -rf "$td2"
  printf '%s' "$ljson" | grep -q 'ASLEEP vetoed' || { echo "smoke-test: FAIL (LIT did not veto ASLEEP — no veto signal; state=$lstate)"; exit 1; }
  [ "$lstate" = ASLEEP ] && { echo "smoke-test: FAIL (ASLEEP survived a LIT room → $lstate)"; exit 1; }
  # UNREACHABLE≠EMPTY (senses 2026-07-03): this fixture has NO .ambient-clock.state — the absent
  # axis must be NAMED in signals (visibly different from a genuine quiet label), never silent.
  printf '%s' "$ljson" | grep -q 'ambient-clock=UNAVAILABLE' || { echo "smoke-test: FAIL (missing ambient state not surfaced as UNAVAILABLE — absent axis is silent)"; exit 1; }
  # 5-LEVEL REGRESSION (senses 2026-06-17): mesh-light now writes BRIGHT/MODERATE/DIM too — a BRIGHT
  # room is the brightest, so it MUST veto ASLEEP just like LIT. Catches the unmapped-level break.
  td3="$(mktemp -d)"; mkdir -p "$td3/.mesh"; nowts3="$(date -u +%FT%TZ)"
  { printf '%s host phone_light 1\n' "$nowts3"; for _ in 1 2 3 4; do printf '%s host wifi_rssi -55\n' "$nowts3"; done; } > "$td3/.mesh/sensors.log"
  printf 'BRIGHT\n' > "$td3/.mesh/.light-state"
  bjson="$(HOME="$td3" "$0" --json 2>/dev/null)"
  bstate="$(printf '%s' "$bjson" | python3 -c 'import sys,json; print(json.load(sys.stdin).get("state",""))' 2>/dev/null)"
  rm -rf "$td3"
  printf '%s' "$bjson" | grep -q 'ASLEEP vetoed' || { echo "smoke-test: FAIL (BRIGHT did not veto ASLEEP — 5-level not folded; state=$bstate)"; exit 1; }
  [ "$bstate" = ASLEEP ] && { echo "smoke-test: FAIL (ASLEEP survived a BRIGHT room → $bstate)"; exit 1; }
  # LIGHT MULTI-FIELD REGRESSION (senses 2026-07-03): .light-state now carries the same
  # LABEL|dwell_s=N|changes_24h=N enrichment as ambient — a multi-field LIT must STILL veto ASLEEP
  # (exact-matching the raw line silently killed the DARK scoring + LIT veto, the ambient 4-day
  # dead-veto regression replayed on the light axis; found live: DARK|dwell_s= scored nothing).
  td_lm="$(mktemp -d)"; mkdir -p "$td_lm/.mesh"; _ts_lm="$(date -u +%FT%TZ)"
  { printf '%s host phone_light 1\n' "$_ts_lm"; for _ in 1 2 3 4; do printf '%s host wifi_rssi -55\n' "$_ts_lm"; done; } > "$td_lm/.mesh/sensors.log"
  printf 'LIT|dwell_s=120|changes_24h=6\n' > "$td_lm/.mesh/.light-state"
  lm_j="$(HOME="$td_lm" "$0" --json 2>/dev/null)"
  lm_s="$(printf '%s' "$lm_j" | python3 -c 'import sys,json; print(json.load(sys.stdin).get("state",""))' 2>/dev/null)"
  rm -rf "$td_lm"
  printf '%s' "$lm_j" | grep -q 'ASLEEP vetoed' || { echo "smoke-test: FAIL (multi-field LIT|dwell_s= did not veto ASLEEP — light label field not parsed; state=$lm_s)"; exit 1; }
  [ "$lm_s" = ASLEEP ] && { echo "smoke-test: FAIL (ASLEEP survived a multi-field LIT light state → $lm_s)"; exit 1; }
  # ROOM MULTI-FIELD REGRESSION (senses 2026-07-03): .room-sense.state carries the same enrichment —
  # a multi-field EMPTY must still be recognized as the fresh room override (sig room-fresh=EMPTY),
  # or the fresh-room axis is silently dead while looking consulted.
  td_rm="$(mktemp -d)"; mkdir -p "$td_rm/.mesh"
  printf '%s host wifi_rssi -60\n' "$(date -u +%FT%TZ)" > "$td_rm/.mesh/sensors.log"
  printf 'EMPTY|dwell_s=3600|changes_24h=9\n' > "$td_rm/.mesh/.room-sense.state"
  rm_j="$(HOME="$td_rm" "$0" --json 2>/dev/null)"
  rm -rf "$td_rm"
  printf '%s' "$rm_j" | grep -q 'room-fresh=EMPTY' || { echo "smoke-test: FAIL (multi-field EMPTY|dwell_s= room state not recognized — room label field not parsed)"; exit 1; }
  # BODY-MOTION VETO (2026-06-20): a walking body-motion reading must veto ASLEEP + QUIET_NIGHT
  # even in the classic dark+silent+stable-wifi fixture that normally scores sleep heavily.
  td_bm="$(mktemp -d)"; mkdir -p "$td_bm/.mesh"; _ts_bm="$(date -u +%FT%TZ)"
  { printf '%s host phone_light 1\n' "$_ts_bm"; for _ in 1 2 3 4; do printf '%s host wifi_rssi -55\n' "$_ts_bm"; done; } > "$td_bm/.mesh/sensors.log"
  printf 'DARK\n' > "$td_bm/.mesh/.light-state"
  printf '1000|[body-walking]|2|\n' > "$td_bm/.mesh/.body-motion-state"
  bm_j="$(HOME="$td_bm" "$0" --json 2>/dev/null)"
  bm_s="$(printf '%s' "$bm_j" | python3 -c 'import sys,json; print(json.load(sys.stdin).get("state",""))' 2>/dev/null)"
  rm -rf "$td_bm"
  printf '%s' "$bm_j" | grep -q 'sleep states vetoed' || { echo "smoke-test: FAIL (body-walking did not veto sleep states in home-state)"; exit 1; }
  [ "$bm_s" = ASLEEP ] && { echo "smoke-test: FAIL (ASLEEP survived body-walking → $bm_s)"; exit 1; }
  # AMBIENT-TREND RISING (2026-06-20): rising TV count in .ambient-clock-trend must appear in signals.
  td_tr="$(mktemp -d)"; mkdir -p "$td_tr/.mesh"; _ts_tr="$(date -u +%FT%TZ)"
  printf '%s host wifi_rssi -60\n' "$_ts_tr" > "$td_tr/.mesh/sensors.log"
  _tnow_tr="$(date +%s)"; _told_tr="$(( _tnow_tr - 900 ))"
  printf '%d|0\n%d|3\n' "$_told_tr" "$_tnow_tr" > "$td_tr/.mesh/.ambient-clock-trend"
  tr_j="$(HOME="$td_tr" "$0" --json 2>/dev/null)"
  rm -rf "$td_tr"
  printf '%s' "$tr_j" | grep -q 'ambient-trend=RISING' || { echo "smoke-test: FAIL (ambient-trend=RISING not in home-state signals)"; exit 1; }
  # LIGHT STALENESS GUARD (2026-06-24): a STALE .light-state (older than LIGHT_TTL) must NOT be consumed
  # as the authoritative current light — it must NOT veto ASLEEP the way a FRESH LIT does (the LIGHT-VETO
  # test above). Same sleep-scoring fixture, but the .light-state mtime forced 2h into the past. With the
  # guard, LIGHT_LABEL is empty → no light veto. (Catches a regression removing the age guard → an
  # hours-old LIT silently faking 'room lit', the 11.5h-stale bug this fixes.)
  td_sl="$(mktemp -d)"; mkdir -p "$td_sl/.mesh"; _ts_sl="$(date -u +%FT%TZ)"
  { printf '%s host phone_light 1\n' "$_ts_sl"; for _ in 1 2 3 4; do printf '%s host wifi_rssi -55\n' "$_ts_sl"; done; } > "$td_sl/.mesh/sensors.log"
  printf 'LIT\n' > "$td_sl/.mesh/.light-state"
  touch -d '2 hours ago' "$td_sl/.mesh/.light-state" 2>/dev/null || touch -d '-7200 seconds' "$td_sl/.mesh/.light-state" 2>/dev/null
  sl_j="$(HOME="$td_sl" "$0" --json 2>/dev/null)"
  rm -rf "$td_sl"
  printf '%s' "$sl_j" | grep -q 'ASLEEP vetoed' && { echo "smoke-test: FAIL (STALE .light-state still vetoed ASLEEP — light staleness guard not applied; an hours-old level is being read as fresh)"; exit 1; }
  # APPLIANCE-vs-SOCIAL (2026-06-21): 4+ named BLE devices with NO speech/audio = APPLIANCES on (2 TVs +
  # speaker + band), NOT people socializing. Must classify away from ACTIVE_SOCIAL (the acknowledged
  # appliance false-positive). Hermetic fixture, no transcript → speech=0, no audio device.
  td_soc="$(mktemp -d)"; mkdir -p "$td_soc/.mesh"; _ts_soc="$(date -u +%FT%TZ)"
  { printf '%s host ble_named 4\n' "$_ts_soc"; printf '%s host phone_light 50\n' "$_ts_soc"; } > "$td_soc/.mesh/sensors.log"
  soc_j="$(HOME="$td_soc" "$0" --json 2>/dev/null)"
  soc_s="$(printf '%s' "$soc_j" | python3 -c 'import sys,json; print(json.load(sys.stdin).get("state",""))' 2>/dev/null)"
  rm -rf "$td_soc"
  [ "$soc_s" = ACTIVE_SOCIAL ] && { echo "smoke-test: FAIL (4 silent appliances classified ACTIVE_SOCIAL — appliance-vs-person bug)"; exit 1; }
  printf '%s' "$soc_j" | grep -q 'not necessarily social' || { echo "smoke-test: FAIL (ble_named>=4 social-disambiguation signal missing → $soc_s)"; exit 1; }
  # PERSON-PRESENT AWAY-VETO (mesh-arrivals fusion, 2026-06-25): a fixture that scores AWAY
  # (room=EMPTY + BLE-sparse) must NOT land AWAY when mesh-arrivals' FRESH present-roster lists a
  # named person-device — the strongest presence ground truth vetoes the weaker BLE-absence. Hermetic.
  td_pp="$(mktemp -d)"; mkdir -p "$td_pp/.mesh"; _ts_pp="$(date -u +%FT%TZ)"
  printf '%s host wifi_rssi -60\n' "$_ts_pp" > "$td_pp/.mesh/sensors.log"
  printf 'EMPTY\n' > "$td_pp/.mesh/.room-sense.state"        # → AWAY scored (+3)
  printf 'Quest 3\t0\n' > "$td_pp/.mesh/arrivals.state"      # fresh roster: 1 person-device present
  pp_j="$(HOME="$td_pp" "$0" --json 2>/dev/null)"
  pp_s="$(printf '%s' "$pp_j" | python3 -c 'import sys,json; print(json.load(sys.stdin).get("state",""))' 2>/dev/null)"
  printf '%s' "$pp_j" | grep -q 'AWAY vetoed' || { echo "smoke-test: FAIL (fresh person-device did not veto AWAY — arrivals fusion not firing; state=$pp_s)"; rm -rf "$td_pp"; exit 1; }
  [ "$pp_s" = AWAY ] && { echo "smoke-test: FAIL (AWAY survived a present person-device → $pp_s)"; rm -rf "$td_pp"; exit 1; }
  # STALENESS GUARD: the SAME fixture with a STALE arrivals.state (older than the TTL) must NOT veto —
  # a dead arrivals cron must never fake presence (honest-fusion: missing axis stays silent).
  touch -d '40 minutes ago' "$td_pp/.mesh/arrivals.state" 2>/dev/null || touch -d '-2400 seconds' "$td_pp/.mesh/arrivals.state" 2>/dev/null
  pps_j="$(HOME="$td_pp" "$0" --json 2>/dev/null)"
  rm -rf "$td_pp"
  printf '%s' "$pps_j" | grep -q 'AWAY vetoed' && { echo "smoke-test: FAIL (STALE arrivals.state still vetoed AWAY — TTL guard not applied; a dead arrivals cron is faking presence)"; exit 1; }
  # SPEECH-REACHABILITY REGRESSION (senses 2026-07-08, phaedra false-ASLEEP): a transcript.log that
  # EXISTS but is STALE (a senseless node that never runs mesh-transcribe — live: phaedra's copy is a
  # 0-byte file untouched since 2026-06-16) must render speech UNAVAILABLE, not "measured silence".
  # Live consequence this fixes: phaedra broadcast household=ASLEEP (score QUIET_NIGHT:1/ASLEEP:1,
  # the stale-speech default was the ONLY signal that fired) while the real household (IdeaPad) read
  # ACTIVE. Hermetic fixture: stale transcript.log + zero other signals → speech UNAVAILABLE, ASLEEP
  # never scored, and — since NO home-presence modality is reachable at all (no sensors.log, stale
  # transcript, no derived states) — the run renders honest n/a: state UNKNOWN + EXIT 2, never a
  # clock-derived confident verdict (chat-review/autowire-homestate-senseless-node).
  td_sp="$(mktemp -d)"; mkdir -p "$td_sp/.mesh"
  : > "$td_sp/.mesh/transcript.log"
  touch -d '30 days ago' "$td_sp/.mesh/transcript.log" 2>/dev/null || touch -d '-2592000 seconds' "$td_sp/.mesh/transcript.log" 2>/dev/null
  sp_j="$(HOME="$td_sp" "$0" --json 2>/dev/null)"; sp_rc=$?
  rm -rf "$td_sp"
  printf '%s' "$sp_j" | grep -q 'speech=UNAVAILABLE' || { echo "smoke-test: FAIL (stale transcript.log did not render speech UNAVAILABLE — phaedra false-ASLEEP regression; got: $sp_j)"; exit 1; }
  printf '%s' "$sp_j" | grep -q 'speech=0 (silent)' && { echo "smoke-test: FAIL (stale transcript.log still scored as measured silence)"; exit 1; }
  printf '%s' "$sp_j" | python3 -c "import sys,json; d=json.load(sys.stdin); sys.exit(1 if d.get('score',{}).get('ASLEEP') else 0)" \
    || { echo "smoke-test: FAIL (stale-speech node scored ASLEEP with zero real evidence: $sp_j)"; exit 1; }
  # honest-n/a gate (senseless node): NO reachable home-presence modality → exit 2 + state UNKNOWN,
  # so mesh-household-state can suppress the board post instead of flapping a clock-derived verdict.
  [ "$sp_rc" = 2 ] || { echo "smoke-test: FAIL (senseless node — no home senses reachable — must exit 2 honest n/a, got rc=$sp_rc; json=$sp_j)"; exit 1; }
  printf '%s' "$sp_j" | python3 -c "import sys,json; d=json.load(sys.stdin); sys.exit(0 if d.get('state')=='UNKNOWN' and d.get('sensed') is False else 1)" \
    || { echo "smoke-test: FAIL (senseless node must render state UNKNOWN + sensed:false, got: $sp_j)"; exit 1; }
  # UMWELT-DEGENERACY REGRESSION (2026-07-27, live-review van Walsum 2026, 10.1007/s12304-026-09646-0):
  # the mtime gate above proves a TOUCH, not a transcription. mesh-transcribe:18 touches transcript.log
  # in its prologue before argument dispatch, so every `--test` (mesh-doctor runs them hourly) re-stamps
  # the speech axis as "live". Measured live on mesh-home: 0-byte transcript, minutes-fresh mtime, and
  # speech=0 scored as measured silence in 2126/2128 logged evaluations. Two fixtures, both RED before
  # the fresh+non-empty+parseable rule:
  #   (a) TOUCHED-BUT-EMPTY — fresh mtime, zero lines: the pipeline has never produced a sign.
  td_te="$(mktemp -d)"; mkdir -p "$td_te/.mesh"; : > "$td_te/.mesh/transcript.log"
  te_j="$(HOME="$td_te" "$0" --json 2>/dev/null)"; te_rc=$?
  rm -rf "$td_te"
  printf '%s' "$te_j" | grep -q 'speech=0 (silent)' && { echo "smoke-test: FAIL (touched-but-EMPTY transcript scored as measured silence — a bare touch faked the sign relation; got: $te_j)"; exit 1; }
  printf '%s' "$te_j" | grep -q 'INERT' || { echo "smoke-test: FAIL (touched-but-empty transcript did not render speech INERT; got: $te_j)"; exit 1; }
  [ "$te_rc" = 2 ] || { echo "smoke-test: FAIL (a touched-but-empty transcript is not a sensing modality — must still be honest n/a exit 2, got rc=$te_rc; json=$te_j)"; exit 1; }
  #   (b) UNPARSEABLE — fresh mtime WITH lines, but in mesh-transcribe's real time-only format
  #       ('14:37:42Z text'), which datetime.fromisoformat cannot read: every line is silently dropped,
  #       so the axis can never be non-zero. That is a format break, not silence — say so, loudly.
  td_up="$(mktemp -d)"; mkdir -p "$td_up/.mesh"
  printf '%s  hello there this is speech\n' "$(date -u +%H:%M:%SZ)" > "$td_up/.mesh/transcript.log"
  up_j="$(HOME="$td_up" "$0" --json 2>/dev/null)"
  rm -rf "$td_up"
  printf '%s' "$up_j" | grep -q 'speech=0 (silent)' && { echo "smoke-test: FAIL (unparseable transcript lines scored as measured silence instead of a format break; got: $up_j)"; exit 1; }
  printf '%s' "$up_j" | grep -q 'UNPARSEABLE' || { echo "smoke-test: FAIL (unparseable transcript did not name the writer/reader format break; got: $up_j)"; exit 1; }
  #   (c) COUNTER-FIXTURE — the gate must not simply always say UNAVAILABLE: a fresh transcript with a
  #       properly DATED recent line has to parse and score, or the fix is a blanket mute.
  td_lv="$(mktemp -d)"; mkdir -p "$td_lv/.mesh"
  printf '%s  %s\n' "$(date -u +%FT%TZ)" "one two three four five six seven eight nine ten eleven twelve thirteen fourteen fifteen sixteen" > "$td_lv/.mesh/transcript.log"
  lv_j="$(HOME="$td_lv" "$0" --json 2>/dev/null)"
  rm -rf "$td_lv"
  printf '%s' "$lv_j" | grep -q 'speech=UNAVAILABLE' && { echo "smoke-test: FAIL (a live, dated, parseable transcript line was muted as UNAVAILABLE — blanket-mute regression; got: $lv_j)"; exit 1; }
  printf '%s' "$lv_j" | grep -q 'speech=16 words' || { echo "smoke-test: FAIL (dated transcript line did not score its words; got: $lv_j)"; exit 1; }
  #   (d) THE OTHER EDGE — a LIVE pipeline across a genuinely quiet stretch (parseable line, but older
  #       than the 15-min window) must still be able to say "silent". Without this the fix degenerates
  #       the other way: every silence becomes UNAVAILABLE and the axis stops carrying evidence at all.
  #       (c) alone cannot catch that — it scores words, and the UNAVAILABLE branch is only reachable
  #       when speech_words==0. Seen RED against a blanket-mute mutant.
  td_qt="$(mktemp -d)"; mkdir -p "$td_qt/.mesh"
  printf '%s  quiet stretch\n' "$(date -u -d '2 hours ago' +%FT%TZ 2>/dev/null || date -u -v-2H +%FT%TZ)" > "$td_qt/.mesh/transcript.log"
  qt_j="$(HOME="$td_qt" "$0" --json 2>/dev/null)"
  rm -rf "$td_qt"
  printf '%s' "$qt_j" | grep -q 'speech=0 (silent)' || { echo "smoke-test: FAIL (a live transcript pipeline across a quiet stretch must still score measured silence — blanket-mute regression; got: $qt_j)"; exit 1; }
  # REGRESSION GUARD — a node WITH a real home sensor must still produce a normal verdict (not n/a):
  td_ok="$(mktemp -d)"; mkdir -p "$td_ok/.mesh"; _ts_ok="$(date -u +%FT%TZ)"
  { printf '%s host phone_light 1\n' "$_ts_ok"; for _ in 1 2 3 4; do printf '%s host wifi_rssi -55\n' "$_ts_ok"; done; } > "$td_ok/.mesh/sensors.log"
  ok_j="$(HOME="$td_ok" "$0" --json 2>/dev/null)"; ok_rc=$?
  rm -rf "$td_ok"
  [ "$ok_rc" = 0 ] || { echo "smoke-test: FAIL (a node WITH real sensors must NOT be flagged n/a — sensed-gate over-fired, rc=$ok_rc)"; exit 1; }
  printf '%s' "$ok_j" | grep -q '"state": "UNKNOWN"' && { echo "smoke-test: FAIL (sensed node wrongly rendered UNKNOWN honest-n/a: $ok_j)"; exit 1; }
  # hour= ON EVERY RENDERED LINE (chat-review/home-digest-late-night-counts-hourless-as-midnight):
  # the digest keys late-night on the hour= token, so a daytime line without it used to read as
  # hour-0 = midnight downstream. Assert the RENDERED summary (the string the log actually gets,
  # after the signals[:4] evidence cut) — not the json signals array. Branch-only stamping makes
  # this RED for any 09-23h-local run; during 23-9h the reader's own skip-hourless gate (in
  # mesh-home-digest --test) holds the harm axis, so the pair of gates covers the full clock.
  td_hr="$(mktemp -d)"; mkdir -p "$td_hr/.mesh"; _ts_hr="$(date -u +%FT%TZ)"
  { printf '%s host phone_light 1\n' "$_ts_hr"; for _ in 1 2 3 4; do printf '%s host wifi_rssi -55\n' "$_ts_hr"; done; } > "$td_hr/.mesh/sensors.log"
  hr_sum="$(HOME="$td_hr" "$0" 2>/dev/null)"
  rm -rf "$td_hr"
  printf '%s' "$hr_sum" | grep -qE 'hour=[0-9]+h' \
    || { echo "smoke-test: FAIL (rendered summary carries no hour= token — daytime lines are hour-less again and the digest reads them as midnight; got: $hr_sum)"; exit 1; }
  # TV-POWER VETO (mesh-tv-state fusion, gen-pair 2026-07-12): a dark+silent fixture that would score
  # ASLEEP must NOT land ASLEEP when the living-room TV reads ACTIVE — the household's own TV playing is
  # positive evidence AGAINST sleep. Hermetic; no .ambient-clock/.light-state, so the ONLY veto path is
  # the fresh .tv-power.state=ACTIVE one. This is the wiring test that keeps the axis from silently dying
  # (the ambient 4-day dead-veto lesson): consumption is asserted, not assumed.
  td_tv="$(mktemp -d)"; mkdir -p "$td_tv/.mesh"; nowts_tv="$(date -u +%FT%TZ)"
  { printf '%s host phone_light 1\n' "$nowts_tv"; for _ in 1 2 3 4; do printf '%s host wifi_rssi -55\n' "$nowts_tv"; done; } > "$td_tv/.mesh/sensors.log"
  printf 'ACTIVE %s\n' "$(date +%s)" > "$td_tv/.mesh/.tv-power.state"   # fresh living-room TV=ACTIVE
  tv_j="$(HOME="$td_tv" "$0" --json 2>/dev/null)"
  tv_s="$(printf '%s' "$tv_j" | python3 -c 'import sys,json; print(json.load(sys.stdin).get("state",""))' 2>/dev/null)"
  # grep ASCII-only substrings — --json escapes the '→' arrow to → (why the other veto tests grep
  # the bare 'X vetoed' tail). No ambient/light in this fixture, so 'ASLEEP vetoed' can ONLY be the TV axis.
  printf '%s' "$tv_j" | grep -q 'tv-power=ACTIVE' || { echo "smoke-test: FAIL (fresh TV=ACTIVE not read — tv-state axis not wired; state=$tv_s)"; rm -rf "$td_tv"; exit 1; }
  printf '%s' "$tv_j" | grep -q 'ASLEEP vetoed' || { echo "smoke-test: FAIL (fresh TV=ACTIVE did not veto ASLEEP — tv-state fusion not firing; state=$tv_s)"; rm -rf "$td_tv"; exit 1; }
  [ "$tv_s" = ASLEEP ] && { echo "smoke-test: FAIL (ASLEEP survived a living-room TV=ACTIVE → $tv_s)"; rm -rf "$td_tv"; exit 1; }
  # STALENESS GUARD: the SAME fixture with a STALE .tv-power.state (older than the TTL) must NOT veto —
  # a lapsed tv-state reflex must never fake an ACTIVE TV (honest-fusion: stale axis renders UNAVAILABLE).
  touch -d '40 minutes ago' "$td_tv/.mesh/.tv-power.state" 2>/dev/null || touch -d '-2400 seconds' "$td_tv/.mesh/.tv-power.state" 2>/dev/null
  tvs_j="$(HOME="$td_tv" "$0" --json 2>/dev/null)"
  rm -rf "$td_tv"
  printf '%s' "$tvs_j" | grep -q 'ASLEEP vetoed' && { echo "smoke-test: FAIL (STALE .tv-power.state still vetoed ASLEEP — TTL guard not applied; a dead tv-state cron is faking an ON TV)"; exit 1; }
  printf '%s' "$tvs_j" | grep -q 'tv-power=UNAVAILABLE' || { echo "smoke-test: FAIL (stale .tv-power.state not rendered UNAVAILABLE — absent axis silent instead of named)"; exit 1; }
  # ── Hysteresis (chat-review/homestate-no-hysteresis) ──────────────────────────
  # Pure pick_state() fixtures via the hidden --test-pick hook (MESH_HOME_TEST_PICK_JSON, NOT
  # stdin — 'python3 -' already consumes stdin to read the script off its own heredoc). Exact,
  # wall-clock-independent point margins — hour-of-day scoring elsewhere in this file can't be
  # held fixed from a real sensor-log fixture. Falsifiable: revert pick_state()'s hysteresis
  # bonus/tie-preference and (a)/(c) below flip to FAIL.
  hy_near="$(MESH_HOME_TEST_PICK_JSON='{"score":{"ACTIVE":3,"ASLEEP":2},"prev_state":"ASLEEP"}' "$0" --test-pick)"
  [ "$hy_near" = ASLEEP ] || { echo "smoke-test: FAIL (near-tie 1pt swing: prior state ASLEEP should hold, got $hy_near)"; exit 1; }
  hy_nohyst="$(MESH_HOME_TEST_PICK_JSON='{"score":{"ACTIVE":3,"ASLEEP":2},"prev_state":null}' "$0" --test-pick)"
  [ "$hy_nohyst" = ACTIVE ] || { echo "smoke-test: FAIL (same score, NO prior state, should raw-pick ACTIVE — regression guard for the underlying tiebreak, got $hy_nohyst)"; exit 1; }
  hy_swing="$(MESH_HOME_TEST_PICK_JSON='{"score":{"ACTIVE":6,"ASLEEP":2},"prev_state":"ASLEEP"}' "$0" --test-pick)"
  [ "$hy_swing" = ACTIVE ] || { echo "smoke-test: FAIL (decisive 4pt swing must still flip despite hysteresis, got $hy_swing)"; exit 1; }
  hy_empty="$(MESH_HOME_TEST_PICK_JSON='{"score":{},"prev_state":"ASLEEP"}' "$0" --test-pick)"
  [ "$hy_empty" = UNCERTAIN ] || { echo "smoke-test: FAIL (no live candidates at all must fall back to UNCERTAIN even with a prior state, got $hy_empty)"; exit 1; }
  # Live-wiring check: STATE_FILE ($HOME/.mesh/.home-state, dead-declared-never-used before this
  # fix) must actually get written by a real run and read back as prev_state on the NEXT run —
  # proves pick_state() is wired into the real pipeline, not just a sitting-unused pure function.
  td_hy="$(mktemp -d)"; mkdir -p "$td_hy/.mesh"; _ts_hy="$(date -u +%FT%TZ)"
  { printf '%s host phone_light 1\n' "$_ts_hy"; for _ in 1 2 3 4; do printf '%s host wifi_rssi -55\n' "$_ts_hy"; done; } > "$td_hy/.mesh/sensors.log"
  hy1_j="$(HOME="$td_hy" "$0" --json 2>/dev/null)"
  hy1_s="$(printf '%s' "$hy1_j" | python3 -c 'import sys,json; print(json.load(sys.stdin).get("state",""))' 2>/dev/null)"
  [ -s "$td_hy/.mesh/.home-state" ] || { echo "smoke-test: FAIL (first run did not persist STATE_FILE for the next run's hysteresis read)"; rm -rf "$td_hy"; exit 1; }
  # Off-manifold shadow instrument (model-criticism calibration): a real run with a non-empty score
  # must append one parseable ledger row whose state column matches the run's own verdict, and the
  # --json must carry numeric off_manifold metrics. Asserts the ARTIFACT, not the source text.
  [ -s "$td_hy/.mesh/home-state-margin.log" ] || { echo "smoke-test: FAIL (off-manifold shadow ledger not written by a real run — calibration corpus never accumulates)"; rm -rf "$td_hy"; exit 1; }
  awk -F'\t' -v st="$hy1_s" 'END{ if (NF!=9 || $2!=st || $6<=0 || $6>1) exit 1 }' "$td_hy/.mesh/home-state-margin.log" \
    || { echo "smoke-test: FAIL (margin-ledger row malformed or state/top_share wrong: $(tail -1 "$td_hy/.mesh/home-state-margin.log"))"; rm -rf "$td_hy"; exit 1; }
  printf '%s' "$hy1_j" | python3 -c 'import sys,json; om=json.load(sys.stdin)["off_manifold"]; sys.exit(0 if om and 0 < om["top_share"] <= 1 and 0 <= om["entropy_norm"] <= 1 else 1)' 2>/dev/null \
    || { echo "smoke-test: FAIL (--json off_manifold metrics absent or out of range: $hy1_j)"; rm -rf "$td_hy"; exit 1; }
  [ "$(cat "$td_hy/.mesh/.home-state")" = "$hy1_s" ] || { echo "smoke-test: FAIL (STATE_FILE content doesn't match the run's own verdict: file=$(cat "$td_hy/.mesh/.home-state") state=$hy1_s)"; rm -rf "$td_hy"; exit 1; }
  hy2_j="$(HOME="$td_hy" "$0" --json 2>/dev/null)"
  rm -rf "$td_hy"
  printf '%s' "$hy2_j" | grep -q 'hysteresis: prior state' || { echo "smoke-test: FAIL (second run against the SAME fixture never read back prev_state — wiring dead; got: $hy2_j)"; exit 1; }
  printf '%s' "$hy2_j" | python3 -c "import sys,json; d=json.load(sys.stdin); sys.exit(0 if d.get('prev_state')=='$hy1_s' else 1)" \
    || { echo "smoke-test: FAIL (second run's prev_state should equal first run's verdict $hy1_s: $hy2_j)"; exit 1; }
  echo "smoke-test: ok ($state; ambient-veto→$vstate; multi-field-veto→$mf_s≠ASLEEP; fixture-discount→ok; ambient-unavailable→named; light-veto→$lstate; bright-veto→$bstate; light-multifield→$lm_s≠ASLEEP; room-multifield→ok; body-motion-veto→$bm_s≠ASLEEP; trend-rising→ok; 4-silent-appliances→$soc_s≠SOCIAL; person-veto→$pp_s≠AWAY+stale-guard; tv-veto→$tv_s≠ASLEEP+stale-guard; speech-reachability→ok; hysteresis→near-tie-hold+decisive-flip+live-wiring ok; off-manifold-shadow→ledger+json ok)"; exit 0
fi

# Ambient-clock cached verdict (chat-review/household-ambient-fusion 2026-06-15): read the label
# mesh-ambient-clock --edge already wrote to its state file — a CACHED read, no BLE re-scan (same
# cheap-fusion discipline as mesh-situation reading .perimeter.state). Absent/empty file → "" → the
# axis simply does not contribute (honest: a missing axis is silent, never faked). MESH_AMBIENT_STATE
# lets --test point at a fixture.
AMBIENT_STATE_FILE="${MESH_AMBIENT_STATE:-$MESH/.ambient-clock.state}"
AMBIENT_LABEL="$(head -1 "$AMBIENT_STATE_FILE" 2>/dev/null | tr -d '[:space:]')"
# Fresh ambient-LIGHT label (mesh-light --edge → .light-state, LIT/DARK). Authoritative over the
# sensors.log 'phone_light' lux, which goes STALE when phone sensor-collection lapses — the bug that
# let a LIT 15h room read ASLEEP (the lux axis was empty, so silence alone scored sleep). Cached read,
# no sensor re-poll. MESH_LIGHT_STATE lets --test point at a fixture. (verify-rotation 2026-06-17)
# STALENESS GUARD (honest-fusion, 2026-06-24): .light-state is rewritten every ~10min (mesh-light
# --edge). If it has gone stale (>LIGHT_TTL, default 2400s — the same threshold mesh-doctor uses for
# this artifact), the phone light sensor has LAPSED (e.g. phone unreachable) and an hours-old level is
# NOT the current light — consuming it as authoritative is the same stale-as-fresh bug this label was
# meant to fix, one layer up (live-found 2026-06-24: an 11.5h-stale MODERATE forcing home-state=ACTIVE
# while the operator was AWAY and the room dark). A stale file → empty LIGHT_LABEL → non-authoritative
# (UNKNOWN), never a faked-fresh LIT. Mirrors the AMBIENT_TREND 25-min guard below.
LIGHT_STATE_FILE="${MESH_LIGHT_STATE:-$MESH/.light-state}"
LIGHT_LABEL=""
if [ -f "$LIGHT_STATE_FILE" ]; then
  _ls_age=$(( $(date +%s) - $(stat -c %Y "$LIGHT_STATE_FILE" 2>/dev/null || date +%s) ))
  if [ "$_ls_age" -le "${LIGHT_TTL:-2400}" ] 2>/dev/null; then
    LIGHT_LABEL="$(head -1 "$LIGHT_STATE_FILE" 2>/dev/null | tr -d '[:space:]')"
  fi
fi

# Fresh body-motion tag: steps|[body-tag]|hyst|pending → extract the tag field only.
# MESH_BODY_STATE_FILE lets --test point at a hermetic fixture.
BODY_STATE_FILE="${MESH_BODY_STATE_FILE:-$MESH/.body-motion-state}"
BODY_TAG="$(cut -d'|' -f2 "$BODY_STATE_FILE" 2>/dev/null | head -1 || true)"

# Ambient-clock trend from the rolling .ambient-clock-trend file (written by mesh-ambient-clock).
# Format: epoch|tv_count lines. Trend = compare last entry (current) vs entry closest to 15 min ago.
# INITIAL when no file or no entry in the 10–30 min window. Staleness guard: last entry > 25 min → skip.
AMBIENT_TREND_FILE="${MESH_AMBIENT_TREND_FILE:-$MESH/.ambient-clock-trend}"
AMBIENT_TREND="INITIAL"
if [ -f "$AMBIENT_TREND_FILE" ]; then
  _now_ep="$(date +%s)"
  _last_ts="$(tail -1 "$AMBIENT_TREND_FILE" 2>/dev/null | cut -d'|' -f1)"
  _curr_tv="$(tail -1 "$AMBIENT_TREND_FILE" 2>/dev/null | cut -d'|' -f2)"
  if [ -n "$_last_ts" ] && [ -n "$_curr_tv" ] && [ "$(( _now_ep - _last_ts ))" -lt 1500 ] 2>/dev/null; then
    _older="$(awk -v now="$_now_ep" 'BEGIN{b="";d=9999}{split($0,a,"|");ag=now-a[1];if(ag>=600&&ag<=1800){dd=ag-900;if(dd<0)dd=-dd;if(dd<d){d=dd;b=a[2]}}}END{print b}' "$AMBIENT_TREND_FILE" 2>/dev/null || true)"
    if [ -n "$_older" ] && [ "$_curr_tv" -eq "$_curr_tv" ] 2>/dev/null && [ "$_older" -eq "$_older" ] 2>/dev/null; then
      if   [ "$_curr_tv" -gt "$_older" ]; then AMBIENT_TREND="RISING"
      elif [ "$_curr_tv" -lt "$_older" ]; then AMBIENT_TREND="FALLING"
      else AMBIENT_TREND="STABLE"
      fi
    fi
  fi
fi

# Fresh room-sense verdict from .room-sense.state (written by mesh-room-sense --edge reflex).
# Overrides the potentially stale room_sense value in sensors.log.
ROOM_STATE_FILE="${MESH_ROOM_STATE_FILE:-$MESH/.room-sense.state}"
ROOM_FRESH="$(head -1 "$ROOM_STATE_FILE" 2>/dev/null | tr -d '[:space:]' || true)"

# Present PERSON roster from mesh-arrivals (gen-pair arrivals × home-state, 2026-06-25).
# mesh-arrivals already EXCLUDES fixed appliances (MESH_FIXED_RE: TVs/AC/scale/speaker) and DEBOUNCES
# BLE flap, so its present-roster is a strictly CLEANER person-presence signal than the raw ble_named
# COUNT this inference keys off — ble_named mixes appliances in (the acknowledged ACTIVE_SOCIAL
# appliance false-positive, :344). Count = devices seen in the LAST scan (miss==0); debounced-leaving
# (miss>0) excluded. Honest-fusion: a STALE roster (arrivals cron dead) must NOT assert presence → gate
# on mtime (TTL = 4× the 5-min arrivals cron stride); stale/absent → "" → the axis stays silent.
ARRIVALS_STATE="${MESH_ARRIVALS_STATE:-$MESH/arrivals.state}"
PERSON_BLE=""
if [ -f "$ARRIVALS_STATE" ]; then
  _arr_age=$(( $(date +%s) - $(stat -c %Y "$ARRIVALS_STATE" 2>/dev/null || echo 0) ))
  if [ "$_arr_age" -lt "${MESH_ARRIVALS_TTL:-1200}" ]; then
    PERSON_BLE="$(awk -F'\t' '$2==0{c++} END{print c+0}' "$ARRIVALS_STATE" 2>/dev/null)"
  fi
fi

# Living-room TV power bit from mesh-tv-state --edge → .tv-power.state (gen-pair tv-state × home-state,
# 2026-07-12). Format: "<STATE> <epoch>", STATE ∈ ACTIVE|STANDBY|UNREACHABLE. This is the household's
# OWN living-room Bravia queried directly (getPowerStatus), a distinct + higher-fidelity occupancy axis
# than the BLE-MAC ambient-clock: a standby TV keeps its DHCP lease so MAC/ARP presence CANNOT tell on
# from off, which is exactly the gap mesh-tv-state closes (its own header names it). Honest-fusion: a
# stale file means the tv-state reflex has LAPSED — an hours-old ACTIVE is NOT the current TV, so gate on
# mtime (mesh-tv-state rewrites EVERY run, so mtime = liveness; TTL 1500s ≈ 5× the */5 stride). Stale/
# absent/UNREACHABLE → "" → axis renders UNAVAILABLE, never a faked ACTIVE. MESH_TV_STATE_FILE → fixture.
TV_STATE_FILE="${MESH_TV_STATE_FILE:-$MESH/.tv-power.state}"
TV_POWER=""
if [ -f "$TV_STATE_FILE" ]; then
  _tv_age=$(( $(date +%s) - $(stat -c %Y "$TV_STATE_FILE" 2>/dev/null || echo 0) ))
  if [ "$_tv_age" -le "${MESH_TV_STATE_TTL:-1500}" ] 2>/dev/null; then
    TV_POWER="$(cut -d' ' -f1 "$TV_STATE_FILE" 2>/dev/null | tr -d '[:space:]')"
  fi
fi

# ── Inference engine ─────────────────────────────────────────────────────────
python3 - "$LOG" "$TRANSCRIPT" "${1:-}" "$AMBIENT_LABEL" "$LIGHT_LABEL" "$BODY_TAG" "$AMBIENT_TREND" "$ROOM_FRESH" "$PERSON_BLE" "$TV_POWER" << 'PYEOF'
import sys, os, re, json, math
from datetime import datetime, timezone, timedelta
from collections import defaultdict

log_path   = sys.argv[1]
trans_path = sys.argv[2]
mode       = sys.argv[3] if len(sys.argv) > 3 else ""

STATE_ORDER = ['AWAY','QUIET_NIGHT','ASLEEP','WAKING','ACTIVE','ACTIVE_SOCIAL','UNCERTAIN']
HYSTERESIS_BONUS = int(os.environ.get('MESH_HOME_HYSTERESIS_BONUS', '1') or 1)

# ── MODEL CRITICISM: this MAP fold is CLOSED under its hypothesis space; it force-fits off-manifold ──
# LIVE REVIEW (predictive processing / Bayesian brain, angle = a known FAILURE MODE, 2026-07-23; idea-
# queue LITERATURE baton). The Bayesian-brain critique that this file COMMITS: Bayesian inference is
# CLOSED under its hypothesis space (Savage's "small world") — a MAP/argmax classifier can only ever
# answer "which of MY states best fits?", never "my model could not have generated this reading". The
# psychosis-side reading of the same limit: with no "I don't know what this is" option, an off-manifold
# percept is force-fit into a (delusional) frame. The statistical response PP structurally LACKS is a
# NON-Bayesian OUTER LOOP — BAYESIAN MODEL CRITICISM / a POSTERIOR-PREDICTIVE CHECK (Gelman et al.,
# Bayesian Data Analysis ch.6; "Holdout predictive checks for Bayesian model criticism", Moran/Blei/
# Ranganath, JRSS-B 86(1):194, 2024; "Calibrated Model Criticism Using Split Predictive Checks", JASA
# 2026, tandfonline 10.1080/01621459.2026.2649585) — scoring the observation's plausibility under the
# model's OWN predictive distribution and ABSTAINING when it is low. Its key property, and why this is
# SHIPPABLE where the input-frame case is not: you can DETECT misspecification WITHOUT enumerating the
# true model — you need only notice the data are poorly explained by ALL enumerated states.
#
# WHERE THIS FOLD COMMITS IT (verified in pick_state below): STATE_ORDER is a CLOSED 7-state set and the
# fold is additive-score argmax (a MAP estimate). pick_state abstains to UNCERTAIN in exactly two cases —
# `if not sc` (no axis voted) and `decision[picked] == 0` (top score zero). BOTH fire only on EMPTY /
# ABSENT evidence. The moment ANY axis contributes one incidental point, argmax returns a CONFIDENT
# positive label — including when several axes each vote 1-2 points for DIFFERENT states in a joint
# combination that never really co-occurs (a FLAT / low-margin score vector = a poorly-explained, off-
# manifold reading). Present-but-incoherent is force-fit; only present-and-empty abstains.
#
# DISTINCT from what the mesh already embodies (checked, non-overlap):
#   • honest-fusion UNKNOWN / exit-2 ([[fusion-tools-distinguish-empty-from-failed]]) = an input is
#     UNREACHABLE. This is: all inputs PRESENT & individually in-range, JOINT implausible. Absent vs
#     off-manifold — orthogonal.
#   • the 2026-06-21 small-world review on mesh-precision (frame problem, Jaeger 2024) = the relevant
#     INPUT VARIABLE may not be in the sense catalog — un-computable, naming-only. This is the OUTPUT/
#     hypothesis side, and it IS computable (posterior-predictive check needs no missing-state enum).
#   • mesh-novelty = per-STREAM event surprise vs a baseline; eigenform-drift = baseline mean shift over
#     TIME. This is a one-shot CROSS-SENSOR JOINT plausibility at a single instant.
#   • mesh-situation's causal-emergence block (2026-07-06) proposes ADDING known joint/synergy rules
#     (enlarging the small world). This is the COMPLEMENT: detect a reading that fits NONE of the
#     hypotheses — known or joint — and abstain, without enumerating beyond the edge.
# HELD FIX (instrument-first; semantics of an operator-facing state organ → steward/operator lands, per
# the causal-emergence-fold discipline): a posterior-predictive OFF-MANIFOLD gate in pick_state — when
# the winning margin is thin AND the score mass is spread (low top-share / high normalized entropy over
# the vote vector), OR the discretized joint config has no empirical precedent in recent history, emit a
# distinct OFF-MANIFOLD marker (NOT UNCERTAIN, which here means "no evidence") rather than the argmax.
# WHY HELD: it changes a cry-wolf-sensitive verdict; a wrongly-low margin bar would abstain on ordinary
# transitions → validate against real state tapes first. Full review + citations:
# ~/.mesh/knowledge/review-model-criticism-homestate-closed-hypothesis-2026-07-23.md
# CALIBRATION INSTRUMENT LIVE (2026-07-23): the OFF-MANIFOLD shadow block after pick_state computes
# margin / top_share / entropy_norm on every real eval and appends to ~/.mesh/home-state-margin.log
# (MESH_HOME_MARGIN_LOG) — verdict untouched. The gate's thresholds get ranked against THAT corpus
# (self-calibrating, never an assumed 0..1); flipping the gate live stays a steward/operator call.
# ─────────────────────────────────────────────────────────────────────────────────────────────
def pick_state(sc, prev=None, bonus=HYSTERESIS_BONUS):
    # chat-review/homestate-no-hysteresis: weight the state WE OURSELVES announced last run so an
    # ordinary per-tick score wobble doesn't flip the verdict — mirrors how mesh-criticality/
    # mesh-body-motion already carry cross-run memory for the same reason. Only boosts a state
    # that's ALREADY a live candidate this tick (some axis actually voted for it) — never invents
    # evidence out of thin air. On an exact post-bonus TIE, prefer the incumbent (prev) over the
    # STATE_ORDER tiebreak (a Schmitt-trigger "stay put unless clearly exceeded"); a decisive swing
    # (challenger still ahead after the bonus) flips normally — the regression guard.
    if not sc:
        return 'UNCERTAIN'
    decision = dict(sc)
    if prev and prev in decision:
        decision[prev] = decision[prev] + bonus
    picked = max(decision, key=lambda s: (decision[s], 1 if s == prev else 0,
                                           STATE_ORDER.index(s) if s in STATE_ORDER else 0))
    return picked if decision[picked] != 0 else 'UNCERTAIN'

if mode == '--test-pick':
    # HIDDEN test hook (chat-review/homestate-no-hysteresis): exercises pick_state() directly with
    # a synthetic score dict, so --test can assert exact near-tie-holds / decisive-swing-flips
    # behavior without engineering a real sensor-log fixture to land on an exact, wall-clock-
    # independent point margin (hour-of-day scoring elsewhere in this file is NOT controllable from
    # a fixture). Input via MESH_HOME_TEST_PICK_JSON env (NOT stdin — 'python3 -' already consumes
    # stdin to read this very script off the heredoc). JSON: {"score": {...}, "prev_state": "..."}.
    # Prints the picked state only.
    _tp = json.loads(os.environ.get('MESH_HOME_TEST_PICK_JSON', '{}') or '{}')
    print(pick_state(_tp.get('score') or {}, _tp.get('prev_state')))
    sys.exit(0)

# ambient-clock cached state — bare LABEL (legacy) or LABEL|dwell_s=N|changes_24h=N (since the
# 2026-06-28 dwell enrichment). Exact-matching the raw line silently killed the ACTIVE→ASLEEP veto
# for the 4 days the multi-field format was live; parse the first field as the label.
_amb_raw   = sys.argv[4].strip().upper() if len(sys.argv) > 4 else ""
_amb_parts = _amb_raw.split('|')
amb        = _amb_parts[0]                                              # ambient-clock cached label
amb_dwell  = None                                                       # seconds current label has held
for _p in _amb_parts[1:]:
    if _p.startswith('DWELL_S='):
        try: amb_dwell = int(_p.split('=', 1)[1])
        except ValueError: pass
# .light-state / .room-sense.state carry the same LABEL|dwell_s=N|changes_24h=N enrichment as
# ambient — parse the FIRST field, or the exact-match fold/override dies silently (the same
# multi-field regression that killed the ambient ASLEEP-veto for 4 days; found live again
# 2026-07-03: DARK|dwell_s= scored nothing and room-fresh EMPTY| was never recognized).
light_state= sys.argv[5].strip().upper().split('|')[0] if len(sys.argv) > 5 else ""   # fresh .light-state (5 levels)
body_tag   = sys.argv[6].strip()         if len(sys.argv) > 6 else ""   # [body-walking] / [body-still] etc.
amb_trend  = sys.argv[7].strip().upper() if len(sys.argv) > 7 else "INITIAL"  # RISING/FALLING/STABLE
room_fresh = sys.argv[8].strip().upper().split('|')[0] if len(sys.argv) > 8 else ""   # PRESENT/EMPTY/UNCERTAIN
_pb        = sys.argv[9].strip()         if len(sys.argv) > 9 else ""   # mesh-arrivals present person count
person_ble = int(_pb) if _pb.isdigit() else None                        # None = stale/absent → axis silent
tv_power   = sys.argv[10].strip().upper() if len(sys.argv) > 10 else "" # mesh-tv-state living-room TV bit: ACTIVE/STANDBY ("" = stale/absent/unreachable → axis silent)
# mesh-light emits DARK/DIM/MODERATE/LIT/BRIGHT — fold to LIT/DARK for the veto (matches mesh-room-sense)
if light_state in ('BRIGHT', 'LIT', 'MODERATE'):
    light_state = 'LIT'
elif light_state in ('DARK', 'DIM'):
    light_state = 'DARK'

NOW = datetime.now(timezone.utc)
WINDOW = timedelta(minutes=15)   # look at last 15 min of sensor data

# ── Parse sensor log: last WINDOW minutes ──────────────────────────────────
snaps = defaultdict(lambda: defaultdict(list))   # ts → sensor_type → [val,...]
try:
    with open(log_path) as f:
        for line in f:
            parts = line.strip().split()
            if len(parts) < 4: continue
            try:
                ts = datetime.fromisoformat(parts[0].replace('Z','+00:00'))
            except ValueError:
                continue
            if NOW - ts > WINDOW: continue
            stype = parts[2]
            val   = " ".join(parts[3:])
            snaps[ts][stype].append(val)
except FileNotFoundError:
    snaps = {}

# Flatten to most-recent value per sensor type
recent = {}
for ts in sorted(snaps):
    for stype, vals in snaps[ts].items():
        recent[stype] = vals[-1]

# ── Parse transcript: word count in last 15 min ─────────────────────────────
# speech_reachable (senses 2026-07-08, phaedra false-ASLEEP): a node with NO mic ever running
# mesh-transcribe has a transcript.log that EXISTS but is permanently empty/stale (not a
# FileNotFoundError — verified live: phaedra's copy is a 0-byte file untouched since 2026-06-16),
# so the old bare `speech_words = 0` default was INDISTINGUISHABLE from a real measured silence.
# On phaedra that stale zero was the ONLY signal that ever scored (QUIET_NIGHT+1/ASLEEP+1, all
# other axes correctly degrade to no-score when unreachable) and it won the argmax by DEFAULT with
# zero real evidence, broadcasting a confident household=ASLEEP while the real household (IdeaPad)
# read ACTIVE. Gate the "speech=0 (silent)" evidence on the transcript file's OWN mtime — a live
# pipeline still counts as reachable across a genuinely quiet stretch (VAD-gated, may go hours
# without a line), but a pipeline that hasn't moved in SPEECH_STALE_S is honestly UNAVAILABLE, not
# silent. [[fusion-tools-distinguish-empty-from-failed]]
#
# MTIME IS NOT THE SIGN RELATION (2026-07-27, live-review: Umwelt degeneracy — van Walsum,
# Biosemiotics 2026, 10.1007/s12304-026-09646-0). The mtime gate above proved only that SOMEONE
# touched the file: mesh-transcribe:18 runs `touch "$LOG"` in its prologue, before any argument
# dispatch, so `--test`/`--tail`/any invocation re-stamps liveness without a single transcription.
# Measured live on mesh-home: transcript.log 0 bytes, mtime minutes old, speech=0 scored as
# "measured silence" in 2126 of 2128 logged evaluations (H(speech)=0.011 bits — a constant axis
# still counted as evidence, and still passing the `sensed` guard below). The receptor was intact
# and the sign relation was dead: degeneracy, not absence. Liveness of a VALUE axis has to be
# proven by a value the reader can actually read — fresh + non-empty + at least one parseable
# line — never by the file's timestamp. The two non-fresh cases stay honestly UNAVAILABLE.
speech_words = 0
speech_reachable = False
speech_why = 'absent (no transcript file)'
SPEECH_STALE_S = int(os.environ.get('MESH_HOME_SPEECH_STALE_S', '21600') or 21600)  # 6h
try:
    _trans_mtime = os.path.getmtime(trans_path)
    _fresh = (NOW - datetime.fromtimestamp(_trans_mtime, tz=timezone.utc)).total_seconds() <= SPEECH_STALE_S
    _lines = _parsed = 0
    with open(trans_path) as f:
        for line in f:
            parts = line.strip().split(None, 1)
            if len(parts) < 2: continue
            _lines += 1
            try:
                ts = datetime.fromisoformat(parts[0].replace('Z','+00:00'))
            except (ValueError, IndexError):
                continue
            _parsed += 1
            if NOW - ts <= WINDOW:
                speech_words += len(parts[1].split())
    if not _fresh:
        speech_why = 'stale (untouched for >%dh)' % (SPEECH_STALE_S // 3600)
    elif _lines == 0:
        speech_why = 'INERT (mtime-fresh but the pipeline has never written a line — a bare touch is not a transcription)'
    elif _parsed == 0:
        speech_why = 'UNPARSEABLE (%d line(s), none carry a dated timestamp — writer/reader format break)' % _lines
    else:
        speech_reachable = True
except FileNotFoundError:
    pass

# ── Signal extraction ────────────────────────────────────────────────────────
hour_utc = NOW.hour  # 0-23; adjust for local if needed (assume UTC+3)
hour_loc = (hour_utc + 3) % 24

ble_count   = int(recent.get('ble_count', 0) or 0)
ble_named   = int(recent.get('ble_named', 0) or 0)
ble_top     = recent.get('ble_top', '')          # "RSSI|DeviceName"
room_sense  = recent.get('room_sense', 'UNCERTAIN')
if room_fresh in ('PRESENT', 'EMPTY', 'UNCERTAIN'):
    room_sense = room_fresh   # fresh .room-sense.state overrides potentially stale sensors.log
light       = recent.get('phone_light', '')
bat_pct_s   = recent.get('phone_battery', '')    # "PCT status"
bat_temp    = recent.get('phone_battery_temp', '')
cpu_temp    = recent.get('therm_x86_pkg_temp', recent.get('cpu_temp', ''))
cpu_load    = recent.get('cpu_load1', '')

# WiFi RSSI variance → motion proxy (higher variance = more movement)
wifi_vals = [snaps[ts].get('wifi_rssi', []) for ts in sorted(snaps)]
rssi_series = []
for ts in sorted(snaps):
    for v in snaps[ts].get('wifi_rssi', []):
        try:
            rssi_series.append(int(v.split()[-1]))
        except (ValueError, IndexError):
            pass
# FAT-TAIL ESTIMATION GAP (Taleb, *Statistical Consequences of Fat Tails*, 4th ed. 2025):
# the RANGE (max−min) is the single most fragile dispersion estimator under fat tails —
# it is, by definition, determined ENTIRELY by the two most extreme samples (the purest case
# of the max-to-sum / κ pathology: one observation dominates the statistic). RSSI is fat-tailed
# in practice — a transient scan glitch / edge-AP dropout reads −90..−95 dBm against a −40..−70
# baseline. ONE such sample inflates this "variance" past the ≥10 band → false "motion" → ACTIVE,
# corrupting the household state even in an empty/asleep room (and the harm is one-sided: a single
# tail sample only ever WIDENS the range, never narrows it, so calm windows are not robustly read
# as STILL either). The mesh ALREADY embodies the fix elsewhere — mesh-wifi-motion derives its
# device-free motion from each anchor's drift vs its OWN MEDIAN baseline ("robust to flicker",
# mesh-wifi-motion:88,91) — but this parallel proxy reached for the maximally tail-fragile range.
# HELD FIX (steward lands — behavioral, not safe-direction): replace with a robust dispersion —
# IQR (p75−p25) or MAD over rssi_series — so a lone dropout no longer flips the state; the ≥10/≤3
# bands must be RE-CALIBRATED (IQR/MAD run smaller than the range, so today's cutoffs don't carry
# over). Instrument-first on a hot */5 household inference. See [[fusion-tools-distinguish-empty-from-failed]].
# Implemented 2026-06-24: IQR (p75-p25) over rssi_series; fallback to MAD for n<4; range for n<2.
# Thresholds recalibrated: IQR >= 6 → ACTIVE (was range >= 10); IQR <= 2 → ASLEEP (was range <= 3).
def robust_dispersion(vals):
    if len(vals) < 2:
        return 0
    sorted_vals = sorted(vals)
    n = len(sorted_vals)
    if n < 4:
        # MAD (median absolute deviation from median)
        mid = n // 2
        median_val = sorted_vals[mid]
        mad = median_val = sorted_vals[mid]
        deviations = [abs(v - median_val) for v in sorted_vals]
        deviations.sort()
        mad_val = deviations[len(deviations) // 2]
        return mad_val if mad_val > 0 else 0
    # IQR (p75 - p25)
    q1_idx = int(n * 0.25)
    q3_idx = int(n * 0.75)
    return sorted_vals[q3_idx] - sorted_vals[q1_idx]

wifi_variance = robust_dispersion(rssi_series)

# Named-device roster (from ble_top and known devices in presence log)
known_devices = {'LE-Bose': 'audio', 'Quest 3': 'vr', 'Nintendo': 'gaming',
                 'PlayStation': 'gaming', 'TV': 'media', 'SoundLink': 'audio'}
active_devices = []
for kw, role in known_devices.items():
    if kw.lower() in ble_top.lower():
        active_devices.append(role)

# ── Inference rules (combine signals → state) ──────────────────────────────
signals = []
score   = {}   # state → evidence count

def sig(label):
    signals.append(label)

if room_fresh in ('PRESENT', 'EMPTY', 'UNCERTAIN'):
    sig(f"room-fresh={room_fresh}")

# Night hours. hour= is stamped on EVERY line — the digest's late-night reader KEYS on the token,
# and branch-only stamping left every 09-23h line hour-less, which the reader parsed as hour-0 =
# midnight (chat-review/home-digest-late-night-counts-hourless-as-midnight: 11/18 digests fired the
# anomaly on daytime lines). Only the night/morning ANNOTATION stays branch-only. Appended at this
# fixed early position so it survives the signals[:4] evidence cut in the rendered summary.
if 23 <= hour_loc or hour_loc < 6:
    score['QUIET_NIGHT'] = score.get('QUIET_NIGHT', 0) + 2
    sig(f"hour={hour_loc}h (night)")
elif 6 <= hour_loc < 9:
    score['WAKING'] = score.get('WAKING', 0) + 1
    sig(f"hour={hour_loc}h (morning)")
else:
    sig(f"hour={hour_loc}h")

# Presence / BLE
# ── CORROBORATED GAP (real-data correlation, 2026-06-21): AT-DESK ⇒ presence=NONE 17/17 (100%) ──
# In the sensor tape, every desk=AT-DESK sample had presence=NONE (P=1.00 vs NONE base 0.715, lift 1.40
# local / 1.8 over the flagged 37h window). UNLIKE the situation=WATCH↔NONE correlation (spurious — pure
# high-base-rate inflation, see ~/.mesh/knowledge/correlation-investigation-situation-watch-presence-none-*),
# this one is NOT spurious: AT-DESK is a PRESENCE GROUND TRUTH (mesh-operator-state derives it from
# IdeaPad mic LOUD/MODERATE + phone home on LAN, NOT from BLE), so AT-DESK+NONE rows are CONFIRMED
# BLE/occupancy false-negatives — the operator is provably at the computer while BLE reports nobody.
# Root cause: BLE-device-absence ≠ person-absence (the operator works the IdeaPad with no discoverable
# BLE phone near the scanner; the Redmi BLE source is often offline). THE HARM IS RIGHT HERE: this rule
# scores AWAY ("nobody home") +3 on room=EMPTY + BLE-sparse, and mesh-home-state does NOT receive the
# desk/operator-state signal at all (argv 1-8 = log,trans,mode,ambient,light,body_tag,amb_trend,room_fresh;
# body_tag is PHONE motion, not desk activity). So a stale room_sense=EMPTY + BLE NONE can flip home-state
# to AWAY while the operator types at the desk — a confident false-empty, worse than an honest UNKNOWN.
# PROPOSED FUSED SENSE (HELD, behavioral — steward/operator): plumb operator-state=AT-DESK as argv[9] and
# treat it as a hard AWAY-VETO (AT-DESK ⇒ never score AWAY; likely +ACTIVE) — the honest-fusion rule that
# the STRONGEST available presence ground-truth overrides a weaker sensor's ABSENCE, never the reverse.
# Held: must confirm operator-state freshness/age-gating (a STALE AT-DESK must not veto a real AWAY) and
# that mesh-operator-state's AT-DESK is reachable from this */5 hot path. Not shipped. [[fusion-tools-distinguish-empty-from-failed]]
if room_sense == 'EMPTY' and ble_named <= 1:
    score['AWAY'] = score.get('AWAY', 0) + 3
    sig("room=EMPTY, BLE sparse → likely away")
elif ble_named >= 4:
    # Device COUNT alone = a BUSY environment, NOT "social". named BLE devices include APPLIANCES
    # (TVs, speakers) — 4 of them with nobody talking is ACTIVE, not social. Fixes the acknowledged
    # ACTIVE_SOCIAL appliance false-positive (e.g. 2 Samsung TVs + speaker + band, speech=0 → "social").
    score['ACTIVE'] = score.get('ACTIVE', 0) + 2
    sig(f"ble_named={ble_named} → several devices active (busy, not necessarily social)")
    # ONLY with corroborating INTERACTION evidence (live conversation or audio playing) is a busy
    # device environment genuinely SOCIAL — people present and interacting, not just appliances on.
    if speech_words >= 15 or 'audio' in active_devices:
        score['ACTIVE_SOCIAL'] = score.get('ACTIVE_SOCIAL', 0) + 3
        sig(f"+ interaction (speech={speech_words}/audio) → SOCIAL (people, not just appliances)")
elif ble_named >= 2:
    score['ACTIVE'] = score.get('ACTIVE', 0) + 1
    sig(f"ble_named={ble_named} devices present")

# ── Person-presence ground truth (mesh-arrivals) ─────────────────────────────
# arrivals' present-roster is appliance-FILTERED + debounced — the person-vs-appliance signal raw
# ble_named lacks. Used NARROWLY: (a) a fresh named person-device present is the STRONGEST presence
# ground truth → vetoes AWAY below (honest-fusion :336, the strongest ground-truth overrides a weaker
# sensor's ABSENCE); (b) ble_named high but ZERO person-devices = appliances-only (the TVs-on-nobody-home
# false-positive) → reinforce NOT-social. NOT used to boost ACTIVE_SOCIAL: 2 person-DEVICES ≠ 2 people
# (one operator may carry phone + Quest), so a person count alone is not a social signal.
if person_ble is not None:
    if person_ble >= 1:
        sig(f"person_ble={person_ble} (named person-device present — appliance-filtered, debounced)")
    elif ble_named >= 4:
        sig(f"ble_named={ble_named} but person_ble=0 → appliances on, no person device (not social)")

if ble_count >= 8:
    score['ACTIVE'] = score.get('ACTIVE', 0) + 1
    sig(f"ble_count={ble_count} (rich environment)")

# Speech activity
if speech_words >= 50:
    score['ACTIVE'] = score.get('ACTIVE', 0) + 2
    sig(f"speech={speech_words} words in 15min → active conversation")
elif speech_words >= 15:
    score['WAKING'] = score.get('WAKING', 0) + 1
    sig(f"speech={speech_words} words (low, ambient)")
elif speech_words == 0:
    if speech_reachable:
        score['QUIET_NIGHT'] = score.get('QUIET_NIGHT', 0) + 1
        score['ASLEEP']      = score.get('ASLEEP', 0) + 1
        sig("speech=0 (silent)")
    else:
        sig(f"speech=UNAVAILABLE (transcript source {speech_why} — not evidence of silence)")

# Light proxy (lux)
if light:
    try:
        lux = float(light)
        if lux < 5:
            score['ASLEEP']     = score.get('ASLEEP', 0) + 2
            score['QUIET_NIGHT']= score.get('QUIET_NIGHT', 0) + 1
            sig(f"light={lux:.0f}lux (dark)")
        elif lux > 100:
            score['ACTIVE'] = score.get('ACTIVE', 0) + 1
            sig(f"light={lux:.0f}lux (lit)")
    except ValueError:
        pass

# WiFi motion proxy (robust IQR/MAD thresholds — recalibrated from legacy range)
if wifi_variance >= 6:
    score['ACTIVE'] = score.get('ACTIVE', 0) + 1
    sig(f"wifi_variance={wifi_variance}dBm (motion)")
elif wifi_variance <= 2 and len(rssi_series) > 3:
    score['ASLEEP']     = score.get('ASLEEP', 0) + 1
    score['QUIET_NIGHT']= score.get('QUIET_NIGHT', 0) + 1
    sig(f"wifi_variance={wifi_variance}dBm (stable, no motion)")

# Audio device active → entertainment
if 'audio' in active_devices:
    score['ACTIVE'] = score.get('ACTIVE', 0) + 1
    sig("Bose active → audio playing or social")
if 'vr' in active_devices:
    score['ACTIVE_SOCIAL'] = score.get('ACTIVE_SOCIAL', 0) + 2
    sig("Quest 3 active → VR/gaming session")

# Battery temp → ambient
if bat_temp:
    try:
        bt = float(bat_temp)
        sig(f"ambient≈{bt:.0f}°C (phone battery temp)")
    except ValueError:
        pass

# ── Ambient-clock fusion axis ────────────────────────────────────────────────
# mesh-ambient-clock harvests fixed-appliance BLE (neighbor/home TVs, AC). An ACTIVE label = TVs on
# → real ambient activity that is INCOMPATIBLE with an ASLEEP inference. So ACTIVE adds ACTIVE
# evidence AND vetoes ASLEEP (drops it from contention so the max-pick can't land there). Narrow by
# design: it vetoes ASLEEP only, NOT QUIET_NIGHT (a neighbor's late TV doesn't disprove a quiet night).
# Fixture-suspect discount (senses 2026-07-03): an appliance label held ≥24h UNBROKEN means the
# beacon never cycles (e.g. a TV advertising BLE 24/7 in standby) — it carries no clock information,
# so it must neither add ACTIVE evidence nor veto ASLEEP. Derived from the state file's own dwell_s
# (same threshold as mesh-ambient-clock's classify_fixture); surfaced, never silently dropped.
_amb_fixture_s = int(os.environ.get('MESH_AMBIENT_FIXTURE_DWELL_S', '86400') or 86400)
amb_fixture = amb in ('MODERATE', 'ACTIVE') and amb_dwell is not None and amb_dwell >= _amb_fixture_s
if amb == 'ACTIVE':
    if amb_fixture:
        sig(f"ambient-clock=ACTIVE but fixture-suspect ({amb_dwell//3600}h unbroken — beacon never cycles) → discounted, no ASLEEP veto")
    else:
        score['ACTIVE'] = score.get('ACTIVE', 0) + 1
        sig("ambient-clock=ACTIVE (TVs on)")
        if 'ASLEEP' in score:
            score.pop('ASLEEP', None)
            sig("ambient ACTIVE → ASLEEP vetoed")
elif amb_fixture:
    # MODERATE never scored anyway, but surface the discount so the fused artifact shows WHY the
    # ambient axis is uninformative instead of looking consulted-and-quiet.
    sig(f"ambient-clock={amb} fixture-suspect ({amb_dwell//3600}h unbroken) — no clock info")
elif amb == '':
    # UNREACHABLE ≠ empty: no cached ambient state (sense never ran / file gone) must render visibly
    # different from a genuine QUIET label — no score impact, but the absence is named.
    sig("ambient-clock=UNAVAILABLE (no cached state — axis absent, not quiet)")

# ── Fresh ambient-light fusion axis ──────────────────────────────────────────
# A LIT room is positive evidence AGAINST sleep — you don't sleep with the lights on. Mirror the
# ambient-ACTIVE veto: LIT adds ACTIVE evidence AND vetoes ASLEEP (NOT QUIET_NIGHT — the veto is
# ASLEEP-only). This is the fresh .light-state, so it fires even when the sensors.log lux is stale —
# the fix for the false ASLEEP-at-15h-while-LIT (verify-rotation 2026-06-17). DARK corroborates rest.
if light_state == 'LIT':
    score['ACTIVE'] = score.get('ACTIVE', 0) + 1
    sig("light=LIT (room lit)")
    if 'ASLEEP' in score:
        score.pop('ASLEEP', None)
        sig("light LIT → ASLEEP vetoed")
elif light_state == 'DARK':
    score['ASLEEP']      = score.get('ASLEEP', 0) + 1
    score['QUIET_NIGHT'] = score.get('QUIET_NIGHT', 0) + 1
    sig("light=DARK (room dark)")

# ── Living-room TV-power fusion axis (mesh-tv-state) ──────────────────────────
# The household's OWN living-room Bravia power bit, read directly (getPowerStatus) — an authoritative
# on/standby occupancy read the BLE-MAC ambient-clock cannot give (a standby TV keeps its DHCP lease).
# TV ACTIVE = the living room is in TV-use → someone up/around: +ACTIVE and veto ASLEEP (mirror the
# ambient-ACTIVE veto — ASLEEP-only, NOT QUIET_NIGHT: a late-night TV playing doesn't disprove a quiet
# night, only that the household is not asleep). STANDBY = TV off → mild not-in-living-room-use; named,
# no positive score (a TV can sit off during active desk work, so it must not push AWAY/ASLEEP). ""
# (stale/absent/UNREACHABLE, honest-guarded in bash) → axis renders UNAVAILABLE, never a faked value.
if tv_power == 'ACTIVE':
    score['ACTIVE'] = score.get('ACTIVE', 0) + 1
    sig("tv-power=ACTIVE (living-room TV on)")
    if 'ASLEEP' in score:
        score.pop('ASLEEP', None)
        sig("tv ACTIVE → ASLEEP vetoed")
elif tv_power == 'STANDBY':
    sig("tv-power=STANDBY (living-room TV off — no occupancy contribution)")
elif tv_power in ('', 'UNREACHABLE'):
    # UNREACHABLE ≠ empty room: TV off-LAN / reflex lapsed. Name the absent axis (mirror ambient
    # UNAVAILABLE) so the fused artifact shows the living-room axis is unconsulted, not faked-quiet.
    sig("tv-power=UNAVAILABLE (TV unreachable / no fresh state — axis absent, not off)")

# ── Body-motion fusion axis ──────────────────────────────────────────────────
# WALKING/CARRIED = phone physically moving → incompatible with sleep. Strong ACTIVE evidence;
# veto both ASLEEP and QUIET_NIGHT (motion at 3am is still ACTIVE, not a sleepy state).
# HANDLED = phone actively in hand → moderate active signal.
# COVERED = face-down/pocket → mild sleep corroboration (also nightstand, so low weight).
# Missing body_tag = phone offline or never polled → silent, not a false STILL.
if body_tag in ('[body-walking]', '[body-carried]'):
    score['ACTIVE'] = score.get('ACTIVE', 0) + 2
    sig(f"body={body_tag.strip('[]')} → locomotion")
    for _bs in ('ASLEEP', 'QUIET_NIGHT'):
        if _bs in score: score.pop(_bs)
    sig("body motion → sleep states vetoed")
elif body_tag == '[body-handled]':
    score['ACTIVE'] = score.get('ACTIVE', 0) + 1
    sig("body=HANDLED → phone in hand")
elif body_tag == '[body-covered]':
    score['ASLEEP'] = score.get('ASLEEP', 0) + 1
    sig("body=COVERED → face-down/pocket")

# ── Ambient-clock trend fusion axis ─────────────────────────────────────────
# Neighbors' TV count RISING = evening activity beginning → corroborates ACTIVE/WAKING.
# TV count FALLING = evening winding down → mild QUIET_NIGHT evidence.
# Low weight (+1): this measures the neighborhood, not the home occupant directly.
# INITIAL / STABLE = no additional evidence.
if amb_trend == 'RISING':
    score['ACTIVE'] = score.get('ACTIVE', 0) + 1
    sig("ambient-trend=RISING (TVs appearing → evening activity)")
elif amb_trend == 'FALLING':
    score['QUIET_NIGHT'] = score.get('QUIET_NIGHT', 0) + 1
    sig("ambient-trend=FALLING (TVs going off → evening ending)")

# ── DEGENERACY OF SUPPORT (Edelman & Gally, PNAS 2001) — the ACTIVE blind spot ─────────────
# 4E/enactivism cross-domain transfer (LITERATURE 2026-06-21): DEGENERACY = structurally
# DISSIMILAR components performing the SAME function. It is NOT redundancy: redundancy =
# identical copies (fail together under one fault); degeneracy = different mechanisms (one
# failing leaves the others standing). Edelman & Gally show degeneracy — not redundancy — is
# what makes biological function robust ("Degeneracy and complexity in biological systems",
# PNAS 98(24):13763, 2001; live 2024-25 review: PMC3350086 "Biological Robustness"). A derived
# state is robust to the extent its supporting evidence is DEGENERATE (spread across
# structurally-distinct sensing modalities), fragile to the extent it rides ONE.
#
# WHERE THIS FUSION COMMITS THE GAP — an ASYMMETRY the score model never names:
#   • ASLEEP is veto-CORROBORATED: ambient-clock (:337), LIT (:349), body-motion (:366) each
#     POP ASLEEP from contention — a structurally-distinct sense can overturn it.
#   • ACTIVE is purely ADDITIVE with NO degeneracy floor. A single modality-family can carry it:
#     wifi_variance≥10 ALONE → score['ACTIVE'] += 1 (:308) and, in a quiet window, win the argmax.
#     There is no requirement that ACTIVE be backed by ≥2 STRUCTURALLY-DISTINCT modalities.
# VERIFIED PROOF (this session's CORRELATION investigation, board 10:12 / knowledge
# correlation-home-active-desk-SPURIOUS): the 03:30 false-ACTIVE rode the fat-tail wifi-RSSI
# RANGE (:223-238) — ONE axis — while the structurally-distinct senses DISAGREED (body=STILL,
# light=dark). Non-degenerate support: one modality's fat-tail dropout felled the whole verdict.
#
# DISTINCT from the two adjacent fusion reviews (orthogonal axes — do not conflate):
#   • the fat-tail/range review (:223) fixes the ESTIMATOR of ONE axis (range→IQR/MAD). Even a
#     perfect per-axis estimator gives NO degeneracy if the verdict still rides that one axis.
#   • precision-weighting-fusion-gap (gossip, 2026-06-20) weights each vote by RELIABILITY. But
#     N high-reliability votes from the SAME modality-family are REDUNDANT, not degenerate — a
#     single structural fault still fells them together. Degeneracy counts DISTINCT structural
#     sources; precision weights each source. Different axis.
#
# HELD FIX (instrument-first, steward/operator lands — behavioral, not safe-direction):
# tag the verdict with a DEGENERACY COUNT = number of structurally-distinct modality-FAMILIES
# (wifi-motion / body-motion / light / acoustic-speech / BLE-presence) independently supporting
# the winning state, and either (a) require degeneracy≥2 before ACTIVE can win the argmax —
# symmetric to the ASLEEP vetoes — or (b) emit the count in --json so consumers discount a
# degeneracy=1 ACTIVE. WHY HELD: (1) it interacts with the :234 range→IQR fix — repairing the
# RSSI estimator removes the dominant false-ACTIVE source, so sequence matters; (2) a naive raw
# count would UNDER-call a legitimate single-strong-modality ACTIVE (loud speech ALONE is real
# activity — speech IS a structurally-distinct strong source), so the floor must be
# modality-family-aware, not a vote count. Validate against sensor-tape.tsv before gating a hot
# */5 household inference. See [[fusion-tools-distinguish-empty-from-failed]],
# [[review-coupling-constitution-fallacy-mesh-card-2026-06-21]] (the membership-direction sibling).
#
# HOW TO COMPUTE THE DEGENERACY COUNT — O-INFORMATION gradient (LITERATURE 2026-07-10):
# the HELD FIX above wants a "count of structurally-distinct modality-families" but flags the hard
# part: a hand-partitioned family map (wifi/body/light/acoustic/BLE) must be MAINTAINED and still
# mis-handles cases (loud-speech-alone). Higher-order info theory names the principled, map-free
# instrument: O-INFORMATION Ω = TC−DTC (Rosas/Rassouli/Barrett; Ω>0 redundancy-dominated, Ω<0
# synergy-dominated) and its per-variable GRADIENT ∂ᵢΩ = ΔΩ when axis i is added: ∂ᵢΩ>0 ⇒ axis i
# carries REDUNDANT info (another axis duplicates it → safely droppable), ∂ᵢΩ<0 ⇒ SYNERGISTIC/UNIQUE
# (its info is nowhere else → the verdict is a SPOF on it). The 03:30 false-ACTIVE rode a ∂ᵢΩ<0 wifi
# axis. Robust ⇔ NO single axis is load-bearing ⇔ ≥2 axes each REDUNDANT (removable w/o flip). This
# measures degeneracy from the DATA — two same-family votes surface as mutually redundant with no
# family map to keep. HOLLOW-SENSE CAVEAT (fusion-honesty, same class as the empowerment-scalar note
# in scripts/mesh-feed): a raw Ω over short, non-stationary sense streams is badly entropy-bias'd
# (n-th-order terms; Gaussian-copula estimator needs stationary volume we lack) → do NOT emit a scalar
# Ω. The non-hollow part is only the SIGN, and the sign is computable MODEL-FREE: ablate axis i,
# recompute the argmax — verdict holds ⇒ ∂ᵢΩ>0 (redundant), verdict flips ⇒ ∂ᵢΩ<0 (synergistic SPOF).
# So the buildable degeneracy count = #axes whose hold-out does NOT flip the winner; gate/emit as
# option (a)/(b) above. Cite: PMC10803408 (gradients of O-information); arXiv:2607.07286 (structural-
# synergy predictability, 2026-07); npj Complexity s44260-024-00011-1 (synergy-first backbone, 2024).
# See knowledge lit-o-information-synergy-degeneracy-mesh-home-state-2026-07-10, [[lit-ablation-control-loadbearing-fusion]].
#
# ── Person-present AWAY-veto (mesh-arrivals fusion, 2026-06-25) ───────────────
# A FRESH, appliance-filtered, debounced named person-device physically in BLE range right now is the
# strongest available "someone is home" ground truth — it is INCOMPATIBLE with AWAY ("nobody home").
# Mirror the ambient/light/body vetoes: drop AWAY from contention so the argmax can't land there.
# NARROW BY DESIGN: vetoes AWAY only — NOT ASLEEP/QUIET_NIGHT (you can be home AND asleep with a phone
# on the nightstand). Stale/absent roster → person_ble is None → no veto (honest: missing axis stays
# silent, never a fake presence). person_ble==0 does NOT veto anything (BLE-absence ≠ person-absence —
# the operator works the IdeaPad with no discoverable BLE; see :330).
if person_ble and person_ble >= 1 and 'AWAY' in score:
    score.pop('AWAY', None)
    sig("person-device present → AWAY vetoed")

# ── Honest n/a: no home-presence sensing modality reachable (senseless node) ──────────────────
# chat-review/autowire-homestate-senseless-node (2026-07-10): this inference reads ONLY the local
# node's sensors.log + derived state files — no gossip, no ssh. On a node with NO embodied home
# senses AND off the operator's LAN (e.g. a remote DC VM like phaedra), every real axis correctly
# degrades to no-score and the ONLY thing that can still fire is the wall-CLOCK night/morning rule
# (:503) — which is NOT evidence of THIS household: it fires identically on a node that cannot see
# the home at all. Emitting a confident QUIET_NIGHT/ASLEEP/ACTIVE off the clock alone is a faked
# all-clear — household@phaedra broadcast 6 authoritative [household-*] board lines/window about a
# household it physically cannot observe (flapping ACTIVE↔UNCERTAIN on the clock). So: if NO
# home-presence modality is reachable, render honest n/a (state UNKNOWN, exit 2) — the same
# fusion-honesty rule the speech-reachability guard (:390) already applies one axis up: an
# unreachable input renders UNKNOWN, never a fabricated verdict. The CLOCK is DELIBERATELY excluded
# from `sensed` (it is available everywhere and senses nothing about the home). Consumers:
# mesh-household-state passes exit 2 through as UNKNOWN and emits NOTHING on --edge (no flap);
# text/token consumers (session-watchdog, mind-control) read UNKNOWN, never a false sleep token.
HOME_SENSOR_KEYS = ('ble_count', 'ble_named', 'ble_top', 'room_sense',
                    'phone_light', 'phone_battery', 'phone_battery_temp')
sensed = (
    any(k in recent for k in HOME_SENSOR_KEYS)            # raw home sensors in the 15-min window
    or bool(rssi_series)                                  # wifi_rssi motion samples present
    or speech_reachable                                   # a live transcript pipeline (mtime-fresh)
    or bool(amb)                                          # cached ambient-clock label
    or bool(light_state)                                  # fresh .light-state (LIT/DARK)
    or bool(body_tag)                                     # phone body-motion tag
    or room_fresh in ('PRESENT', 'EMPTY', 'UNCERTAIN')    # fresh room-sense verdict
    or (person_ble is not None)                           # fresh arrivals roster
)
if not sensed:
    sig("no home-presence sensing modality reachable → honest n/a (senseless node)")
    if mode == "--json":
        print(json.dumps({"state": "UNKNOWN", "desc": "no home senses reachable (honest n/a)",
                          "signals": signals, "score": score, "sensed": False,
                          "hour_local": hour_loc, "prev_state": None}))
    else:
        _ev = " · ".join(signals[:4]) if signals else "no signals"
        print(f"[home-state] UNKNOWN: no home senses reachable (honest n/a) | {_ev}")
    sys.exit(2)

# ── Hysteresis: read the state WE announced last run (chat-review/homestate-no-hysteresis) ──
# STATE_FILE ($HOME/.mesh/.home-state) was declared in the bash preamble but never previously
# used — this is the "small home-state-local cache" the fix needs. TTL-gated (20min = 4x the
# 5min cron cadence) so a dead cron, or a hermetic --test's fresh $HOME with no prior file, never
# leaks a stale/absent cache in as a fake vote.
HYSTERESIS_TTL_S = int(os.environ.get('MESH_HOME_HYSTERESIS_TTL_S', '1200') or 1200)
_home_state_path = os.path.join(os.environ.get('HOME', ''), '.mesh', '.home-state')
prev_state = None
try:
    _hs_age = (NOW - datetime.fromtimestamp(os.path.getmtime(_home_state_path), tz=timezone.utc)).total_seconds()
    if _hs_age <= HYSTERESIS_TTL_S:
        with open(_home_state_path) as f:
            _cached = f.readline().strip().upper()
        if _cached in STATE_ORDER:
            prev_state = _cached
except OSError:
    pass

# ── Pick best state ──────────────────────────────────────────────────────────
state = pick_state(score, prev_state)
if prev_state and prev_state in score:
    sig(f"hysteresis: prior state {prev_state} weighted +{HYSTERESIS_BONUS}")

# ── OFF-MANIFOLD shadow instrument (calibration phase of the HELD model-criticism fix above) ──
# Computes the coherence metrics the held gate would key on — winning margin, top-share, normalized
# entropy of the RAW vote vector (pre-hysteresis: the bonus is smoothing, not evidence; prev_state is
# logged so the bonused decision is reconstructible post-hoc) — and appends them to a ledger WITHOUT
# touching the verdict. This is the "validate against real state tapes first" step: thresholds must be
# ranked against the LIVE corpus this ledger accumulates, never an assumed 0..1 (the tone-saturation /
# threshold-55 family). Fail-open on OSError — an unwritable ledger must never break the state organ.
off_manifold = None
if score and sum(score.values()) > 0:
    _vals   = sorted(score.values(), reverse=True)
    _tot    = sum(_vals)
    _ps     = [v / _tot for v in _vals if v > 0]
    _Hn     = (-sum(p * math.log(p) for p in _ps) / math.log(len(_ps))) if len(_ps) > 1 else 0.0
    off_manifold = {
        "margin":       _vals[0] - (_vals[1] if len(_vals) > 1 else 0),
        "top_share":    round(_vals[0] / _tot, 4),
        "entropy_norm": round(_Hn, 4),
        "n_voted":      len(_ps),
        "total":        _tot,
    }
    _margin_log = os.environ.get('MESH_HOME_MARGIN_LOG') or \
                  os.path.join(os.environ.get('HOME', ''), '.mesh', 'home-state-margin.log')
    try:
        os.makedirs(os.path.dirname(_margin_log), exist_ok=True)
        with open(_margin_log, 'a') as f:
            f.write("%s\t%s\t%s\t%d\t%d\t%.4f\t%.4f\t%d\t%s\n" % (
                NOW.strftime('%Y-%m-%dT%H:%M:%SZ'), state, prev_state or '-',
                off_manifold['total'], off_manifold['margin'], off_manifold['top_share'],
                off_manifold['entropy_norm'], off_manifold['n_voted'],
                json.dumps(score, sort_keys=True, separators=(',', ':'))))
        # retention: single producer, 5-min cadence → ~288 rows/day; trim 8000→6000 (~3 weeks kept)
        with open(_margin_log) as f:
            _mlines = f.readlines()
        if len(_mlines) > 8000:
            with open(_margin_log, 'w') as f:
                f.writelines(_mlines[-6000:])
    except OSError:
        pass

# Persist for the NEXT run's hysteresis read (this file was dead-written-never before this fix).
try:
    os.makedirs(os.path.dirname(_home_state_path), exist_ok=True)
    with open(_home_state_path, 'w') as f:
        f.write(state + '\n')
except OSError:
    pass

# ── Human-readable summary ───────────────────────────────────────────────────
desc = {
    'AWAY':         'nobody home',
    'QUIET_NIGHT':  'home quiet (night)',
    'ASLEEP':       'someone home, likely asleep',
    'WAKING':       'waking up or winding down',
    'ACTIVE':       'home active',
    'ACTIVE_SOCIAL':'home lively (multiple devices/people)',
    'UNCERTAIN':    'state unclear',
}

# Key evidence (top 3 signals)
evidence = " · ".join(signals[:4]) if signals else "no signals"
summary = f"[home-state] {state}: {desc.get(state,'?')} | {evidence}"

if mode == "--json":
    out = {"state": state, "desc": desc.get(state,"?"),
           "signals": signals, "score": score,
           "ble_count": ble_count, "ble_named": ble_named,
           "speech_words": speech_words, "wifi_variance": wifi_variance,
           "ambient": amb, "ambient_trend": amb_trend,
           "body_tag": body_tag, "room_fresh": room_fresh,
           "hour_local": hour_loc, "prev_state": prev_state,
           "off_manifold": off_manifold}
    print(json.dumps(out))
else:
    print(summary)
