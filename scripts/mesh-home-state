#!/usr/bin/env bash
# reflex-cadence: 4-59/5 * * * *
# mesh-home-state — the CAUSE LAYER: fuse sensor traces → home situation inference
#
# Single sensor = FACT. Correlated sensors over time = CAUSE.
# This tool reads the sensor stream (sensors.log + presence + transcription) and
# infers WHAT IS HAPPENING in the home — not just what individual meters report.
#
# Output: one-line home state + confidence signals + contributing evidence
#
#   mesh-home-state              infer current home state, print + post to board
#   mesh-home-state --json       machine-readable output
#   mesh-home-state --watch      re-infer every 5 min, edge-triggered board post
#   mesh-home-state --test       smoke test
#
# State classes: QUIET_NIGHT | ASLEEP | WAKING | ACTIVE | ACTIVE_SOCIAL | AWAY
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

LOG="${MESH_SENSOR_LOG:-$HOME/.mesh/sensors.log}"
TRANSCRIPT="$HOME/.mesh/transcript.log"
STATE_FILE="$HOME/.mesh/.home-state"
MESH="$HOME/.mesh"

if [ "${1:-}" = --test ]; then
  [ -f "$LOG" ] || { echo "smoke-test: WARN (no sensors.log yet — inference falls back to time-based)"; }
  command -v python3 >/dev/null 2>&1 || { echo "smoke-test: FAIL (no python3)"; exit 1; }
  # Artifact test: inference must produce a valid 6-class state label (not just have deps installed)
  out="$("$0" --json 2>/dev/null)" || { echo "smoke-test: FAIL (inference errored)"; exit 1; }
  state="$(printf '%s' "$out" | python3 -c 'import sys,json; d=json.load(sys.stdin); print(d.get("state",""))' 2>/dev/null)"
  case "$state" in
    QUIET_NIGHT|ASLEEP|WAKING|ACTIVE|ACTIVE_SOCIAL|AWAY) : ;;
    *) echo "smoke-test: FAIL (unexpected state '${state:-empty}' — inference broken or output format changed)"; exit 1 ;;
  esac
  # AMBIENT-FUSION REGRESSION (2026-06-15): dark + silent + stable-wifi sensors score ASLEEP, but an
  # ACTIVE ambient-clock (TVs on) must VETO that. Hermetic fixture (own HOME) so it's hour-independent:
  # the 'ASLEEP vetoed' signal fires deterministically whenever ASLEEP was scored AND ambient=ACTIVE.
  td="$(mktemp -d)"; mkdir -p "$td/.mesh"; nowts="$(date -u +%FT%TZ)"
  { printf '%s host phone_light 1\n' "$nowts"; for _ in 1 2 3 4; do printf '%s host wifi_rssi -55\n' "$nowts"; done; } > "$td/.mesh/sensors.log"
  printf 'ACTIVE\n' > "$td/.mesh/.ambient-clock.state"
  vjson="$(HOME="$td" "$0" --json 2>/dev/null)"
  vstate="$(printf '%s' "$vjson" | python3 -c 'import sys,json; print(json.load(sys.stdin).get("state",""))' 2>/dev/null)"
  rm -rf "$td"
  printf '%s' "$vjson" | grep -q 'ASLEEP vetoed' || { echo "smoke-test: FAIL (ACTIVE ambient did not veto ASLEEP — no veto signal)"; exit 1; }
  [ "$vstate" = ASLEEP ] && { echo "smoke-test: FAIL (ASLEEP survived an ACTIVE ambient-clock → $vstate)"; exit 1; }
  # LIGHT-VETO REGRESSION (verify-rotation 2026-06-17): a LIT room must veto ASLEEP even when the
  # (possibly stale) lux + silence + stable-wifi fixture would otherwise score sleep — the false
  # ASLEEP-at-15h-while-LIT bug. Hermetic fixture; no .ambient-clock.state, so the ONLY veto path is
  # the fresh .light-state=LIT one.
  td2="$(mktemp -d)"; mkdir -p "$td2/.mesh"; nowts2="$(date -u +%FT%TZ)"
  { printf '%s host phone_light 1\n' "$nowts2"; for _ in 1 2 3 4; do printf '%s host wifi_rssi -55\n' "$nowts2"; done; } > "$td2/.mesh/sensors.log"
  printf 'LIT\n' > "$td2/.mesh/.light-state"
  ljson="$(HOME="$td2" "$0" --json 2>/dev/null)"
  lstate="$(printf '%s' "$ljson" | python3 -c 'import sys,json; print(json.load(sys.stdin).get("state",""))' 2>/dev/null)"
  rm -rf "$td2"
  printf '%s' "$ljson" | grep -q 'ASLEEP vetoed' || { echo "smoke-test: FAIL (LIT did not veto ASLEEP — no veto signal; state=$lstate)"; exit 1; }
  [ "$lstate" = ASLEEP ] && { echo "smoke-test: FAIL (ASLEEP survived a LIT room → $lstate)"; exit 1; }
  # 5-LEVEL REGRESSION (senses 2026-06-17): mesh-light now writes BRIGHT/MODERATE/DIM too — a BRIGHT
  # room is the brightest, so it MUST veto ASLEEP just like LIT. Catches the unmapped-level break.
  td3="$(mktemp -d)"; mkdir -p "$td3/.mesh"; nowts3="$(date -u +%FT%TZ)"
  { printf '%s host phone_light 1\n' "$nowts3"; for _ in 1 2 3 4; do printf '%s host wifi_rssi -55\n' "$nowts3"; done; } > "$td3/.mesh/sensors.log"
  printf 'BRIGHT\n' > "$td3/.mesh/.light-state"
  bjson="$(HOME="$td3" "$0" --json 2>/dev/null)"
  bstate="$(printf '%s' "$bjson" | python3 -c 'import sys,json; print(json.load(sys.stdin).get("state",""))' 2>/dev/null)"
  rm -rf "$td3"
  printf '%s' "$bjson" | grep -q 'ASLEEP vetoed' || { echo "smoke-test: FAIL (BRIGHT did not veto ASLEEP — 5-level not folded; state=$bstate)"; exit 1; }
  [ "$bstate" = ASLEEP ] && { echo "smoke-test: FAIL (ASLEEP survived a BRIGHT room → $bstate)"; exit 1; }
  echo "smoke-test: ok ($state; ambient-veto→$vstate; light-veto→$lstate; bright-veto→$bstate)"; exit 0
fi

# Ambient-clock cached verdict (chat-review/household-ambient-fusion 2026-06-15): read the label
# mesh-ambient-clock --edge already wrote to its state file — a CACHED read, no BLE re-scan (same
# cheap-fusion discipline as mesh-situation reading .perimeter.state). Absent/empty file → "" → the
# axis simply does not contribute (honest: a missing axis is silent, never faked). MESH_AMBIENT_STATE
# lets --test point at a fixture.
AMBIENT_STATE_FILE="${MESH_AMBIENT_STATE:-$MESH/.ambient-clock.state}"
AMBIENT_LABEL="$(head -1 "$AMBIENT_STATE_FILE" 2>/dev/null | tr -d '[:space:]')"
# Fresh ambient-LIGHT label (mesh-light --edge → .light-state, LIT/DARK). Authoritative over the
# sensors.log 'phone_light' lux, which goes STALE when phone sensor-collection lapses — the bug that
# let a LIT 15h room read ASLEEP (the lux axis was empty, so silence alone scored sleep). Cached read,
# no sensor re-poll. MESH_LIGHT_STATE lets --test point at a fixture. (verify-rotation 2026-06-17)
LIGHT_STATE_FILE="${MESH_LIGHT_STATE:-$MESH/.light-state}"
LIGHT_LABEL="$(head -1 "$LIGHT_STATE_FILE" 2>/dev/null | tr -d '[:space:]')"

# ── Inference engine ─────────────────────────────────────────────────────────
python3 - "$LOG" "$TRANSCRIPT" "${1:-}" "$AMBIENT_LABEL" "$LIGHT_LABEL" << 'PYEOF'
import sys, os, re, json
from datetime import datetime, timezone, timedelta
from collections import defaultdict

log_path   = sys.argv[1]
trans_path = sys.argv[2]
mode       = sys.argv[3] if len(sys.argv) > 3 else ""
amb        = sys.argv[4].strip().upper() if len(sys.argv) > 4 else ""   # ambient-clock cached label
light_state= sys.argv[5].strip().upper() if len(sys.argv) > 5 else ""   # fresh .light-state (5 levels)
# mesh-light emits DARK/DIM/MODERATE/LIT/BRIGHT — fold to LIT/DARK for the veto (matches mesh-room-sense)
if light_state in ('BRIGHT', 'LIT', 'MODERATE'):
    light_state = 'LIT'
elif light_state in ('DARK', 'DIM'):
    light_state = 'DARK'

NOW = datetime.now(timezone.utc)
WINDOW = timedelta(minutes=15)   # look at last 15 min of sensor data

# ── Parse sensor log: last WINDOW minutes ──────────────────────────────────
snaps = defaultdict(lambda: defaultdict(list))   # ts → sensor_type → [val,...]
try:
    with open(log_path) as f:
        for line in f:
            parts = line.strip().split()
            if len(parts) < 4: continue
            try:
                ts = datetime.fromisoformat(parts[0].replace('Z','+00:00'))
            except ValueError:
                continue
            if NOW - ts > WINDOW: continue
            stype = parts[2]
            val   = " ".join(parts[3:])
            snaps[ts][stype].append(val)
except FileNotFoundError:
    snaps = {}

# Flatten to most-recent value per sensor type
recent = {}
for ts in sorted(snaps):
    for stype, vals in snaps[ts].items():
        recent[stype] = vals[-1]

# ── Parse transcript: word count in last 15 min ─────────────────────────────
speech_words = 0
try:
    with open(trans_path) as f:
        for line in f:
            parts = line.strip().split(None, 1)
            if len(parts) < 2: continue
            try:
                ts = datetime.fromisoformat(parts[0].replace('Z','+00:00'))
                if NOW - ts <= WINDOW:
                    speech_words += len(parts[1].split())
            except (ValueError, IndexError):
                pass
except FileNotFoundError:
    pass

# ── Signal extraction ────────────────────────────────────────────────────────
hour_utc = NOW.hour  # 0-23; adjust for local if needed (assume UTC+3)
hour_loc = (hour_utc + 3) % 24

ble_count   = int(recent.get('ble_count', 0) or 0)
ble_named   = int(recent.get('ble_named', 0) or 0)
ble_top     = recent.get('ble_top', '')          # "RSSI|DeviceName"
room_sense  = recent.get('room_sense', 'UNCERTAIN')
light       = recent.get('phone_light', '')
bat_pct_s   = recent.get('phone_battery', '')    # "PCT status"
bat_temp    = recent.get('phone_battery_temp', '')
cpu_temp    = recent.get('therm_x86_pkg_temp', recent.get('cpu_temp', ''))
cpu_load    = recent.get('cpu_load1', '')

# WiFi RSSI variance → motion proxy (higher variance = more movement)
wifi_vals = [snaps[ts].get('wifi_rssi', []) for ts in sorted(snaps)]
rssi_series = []
for ts in sorted(snaps):
    for v in snaps[ts].get('wifi_rssi', []):
        try:
            rssi_series.append(int(v.split()[-1]))
        except (ValueError, IndexError):
            pass
wifi_variance = max(rssi_series) - min(rssi_series) if len(rssi_series) > 1 else 0

# Named-device roster (from ble_top and known devices in presence log)
known_devices = {'LE-Bose': 'audio', 'Quest 3': 'vr', 'Nintendo': 'gaming',
                 'PlayStation': 'gaming', 'TV': 'media', 'SoundLink': 'audio'}
active_devices = []
for kw, role in known_devices.items():
    if kw.lower() in ble_top.lower():
        active_devices.append(role)

# ── Inference rules (combine signals → state) ──────────────────────────────
signals = []
score   = {}   # state → evidence count

def sig(label):
    signals.append(label)

# Night hours
if 23 <= hour_loc or hour_loc < 6:
    score['QUIET_NIGHT'] = score.get('QUIET_NIGHT', 0) + 2
    sig(f"hour={hour_loc}h (night)")
elif 6 <= hour_loc < 9:
    score['WAKING'] = score.get('WAKING', 0) + 1
    sig(f"hour={hour_loc}h (morning)")

# Presence / BLE
if room_sense == 'EMPTY' and ble_named <= 1:
    score['AWAY'] = score.get('AWAY', 0) + 3
    sig("room=EMPTY, BLE sparse → likely away")
elif ble_named >= 4:
    score['ACTIVE_SOCIAL'] = score.get('ACTIVE_SOCIAL', 0) + 2
    sig(f"ble_named={ble_named} → several devices active")
elif ble_named >= 2:
    score['ACTIVE'] = score.get('ACTIVE', 0) + 1
    sig(f"ble_named={ble_named} devices present")

if ble_count >= 8:
    score['ACTIVE'] = score.get('ACTIVE', 0) + 1
    sig(f"ble_count={ble_count} (rich environment)")

# Speech activity
if speech_words >= 50:
    score['ACTIVE'] = score.get('ACTIVE', 0) + 2
    sig(f"speech={speech_words} words in 15min → active conversation")
elif speech_words >= 15:
    score['WAKING'] = score.get('WAKING', 0) + 1
    sig(f"speech={speech_words} words (low, ambient)")
elif speech_words == 0:
    score['QUIET_NIGHT'] = score.get('QUIET_NIGHT', 0) + 1
    score['ASLEEP']      = score.get('ASLEEP', 0) + 1
    sig("speech=0 (silent)")

# Light proxy (lux)
if light:
    try:
        lux = float(light)
        if lux < 5:
            score['ASLEEP']     = score.get('ASLEEP', 0) + 2
            score['QUIET_NIGHT']= score.get('QUIET_NIGHT', 0) + 1
            sig(f"light={lux:.0f}lux (dark)")
        elif lux > 100:
            score['ACTIVE'] = score.get('ACTIVE', 0) + 1
            sig(f"light={lux:.0f}lux (lit)")
    except ValueError:
        pass

# WiFi motion proxy
if wifi_variance >= 10:
    score['ACTIVE'] = score.get('ACTIVE', 0) + 1
    sig(f"wifi_variance={wifi_variance}dBm (motion)")
elif wifi_variance <= 3 and len(rssi_series) > 3:
    score['ASLEEP']     = score.get('ASLEEP', 0) + 1
    score['QUIET_NIGHT']= score.get('QUIET_NIGHT', 0) + 1
    sig(f"wifi_variance={wifi_variance}dBm (stable, no motion)")

# Audio device active → entertainment
if 'audio' in active_devices:
    score['ACTIVE'] = score.get('ACTIVE', 0) + 1
    sig("Bose active → audio playing or social")
if 'vr' in active_devices:
    score['ACTIVE_SOCIAL'] = score.get('ACTIVE_SOCIAL', 0) + 2
    sig("Quest 3 active → VR/gaming session")

# Battery temp → ambient
if bat_temp:
    try:
        bt = float(bat_temp)
        sig(f"ambient≈{bt:.0f}°C (phone battery temp)")
    except ValueError:
        pass

# ── Ambient-clock fusion axis ────────────────────────────────────────────────
# mesh-ambient-clock harvests fixed-appliance BLE (neighbor/home TVs, AC). An ACTIVE label = TVs on
# → real ambient activity that is INCOMPATIBLE with an ASLEEP inference. So ACTIVE adds ACTIVE
# evidence AND vetoes ASLEEP (drops it from contention so the max-pick can't land there). Narrow by
# design: it vetoes ASLEEP only, NOT QUIET_NIGHT (a neighbor's late TV doesn't disprove a quiet night).
if amb == 'ACTIVE':
    score['ACTIVE'] = score.get('ACTIVE', 0) + 1
    sig("ambient-clock=ACTIVE (TVs on)")
    if 'ASLEEP' in score:
        score.pop('ASLEEP', None)
        sig("ambient ACTIVE → ASLEEP vetoed")

# ── Fresh ambient-light fusion axis ──────────────────────────────────────────
# A LIT room is positive evidence AGAINST sleep — you don't sleep with the lights on. Mirror the
# ambient-ACTIVE veto: LIT adds ACTIVE evidence AND vetoes ASLEEP (NOT QUIET_NIGHT — the veto is
# ASLEEP-only). This is the fresh .light-state, so it fires even when the sensors.log lux is stale —
# the fix for the false ASLEEP-at-15h-while-LIT (verify-rotation 2026-06-17). DARK corroborates rest.
if light_state == 'LIT':
    score['ACTIVE'] = score.get('ACTIVE', 0) + 1
    sig("light=LIT (room lit)")
    if 'ASLEEP' in score:
        score.pop('ASLEEP', None)
        sig("light LIT → ASLEEP vetoed")
elif light_state == 'DARK':
    score['ASLEEP']      = score.get('ASLEEP', 0) + 1
    score['QUIET_NIGHT'] = score.get('QUIET_NIGHT', 0) + 1
    sig("light=DARK (room dark)")

# ── Pick best state ──────────────────────────────────────────────────────────
fallback = 'UNCERTAIN'
if not score:
    state = fallback
else:
    state = max(score, key=lambda s: (score[s], ['AWAY','QUIET_NIGHT','ASLEEP','WAKING','ACTIVE','ACTIVE_SOCIAL','UNCERTAIN'].index(s) if s in ['AWAY','QUIET_NIGHT','ASLEEP','WAKING','ACTIVE','ACTIVE_SOCIAL','UNCERTAIN'] else 0))
    if score[state] == 0:
        state = fallback

# ── Human-readable summary ───────────────────────────────────────────────────
desc = {
    'AWAY':         'nobody home',
    'QUIET_NIGHT':  'home quiet (night)',
    'ASLEEP':       'someone home, likely asleep',
    'WAKING':       'waking up or winding down',
    'ACTIVE':       'home active',
    'ACTIVE_SOCIAL':'home lively (multiple devices/people)',
    'UNCERTAIN':    'state unclear',
}

# Key evidence (top 3 signals)
evidence = " · ".join(signals[:4]) if signals else "no signals"
summary = f"[home-state] {state}: {desc.get(state,'?')} | {evidence}"

if mode == "--json":
    out = {"state": state, "desc": desc.get(state,"?"),
           "signals": signals, "score": score,
           "ble_count": ble_count, "ble_named": ble_named,
           "speech_words": speech_words, "wifi_variance": wifi_variance,
           "ambient": amb, "hour_local": hour_loc}
    print(json.dumps(out))
else:
    print(summary)
PYEOF