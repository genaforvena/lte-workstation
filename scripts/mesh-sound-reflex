#!/usr/bin/env bash
# mesh-sound-reflex — make GRINDING a reflex: the mesh's own records become granular transformations
# without a mind in the loop, and the mind is poked only when something needs judgement.
#
# Operator 2026-07-15: "transformations should be mostly reflexive, yet make sure not trivial or
# boring." Both halves are load-bearing. REFLEXIVE: a new record in the ledger triggers a grind on
# its own, no turn spent. NOT TRIVIAL: the recipe is DERIVED FROM THE RECORD'S MEASURED CHARACTER
# and then forced away from everything recently rendered — so a busy source and a sparse one cannot
# come out the same, and no two consecutive renders can sit in the same corner of the param space.
#
# What was there before: mesh-room-music's pick_args rotates f/s/ss away from the last 3 remixes —
# real, but shallow. It is random-within-absent (nothing connects the recipe to the source), it
# never rotates w or c, and it constrains each axis INDEPENDENTLY, so two renders differing in one
# value read as "different" while sitting next to each other in the space. mesh-soundscape MEASURES
# five axes per window and throws all but `beats` away. This closes both: the axes pick the recipe,
# and the gate constrains the COMBO.
#
#   mesh-sound-reflex               one tick: new ledger records -> derive -> gate -> bg grind -> maybe poke
#   mesh-sound-reflex --derive dyn act rich move cent beat_ms
#                                   print the recipe for a character (pure — no grind, no side effect)
#   mesh-sound-reflex --status      anchor/cooldown/novelty room + corpus coverage, no side effects
#   mesh-sound-reflex --repick      the RE-PICK POOL, read-only: every already-ground source whose
#                                   file is still on disk, its re-pick count, and which bound (cap /
#                                   eviction / no-worn-recipe) refuses the rest. The lane itself runs
#                                   on IDLE ticks only, after retry_timeouts, at most one per
#                                   SR_REPICK_COOLDOWN, and ships marked as a remix of <hash> — the
#                                   record ledger row keeps its ORIGINAL ground: verdict, always.
#   mesh-sound-reflex --coverage    render-corpus OPEN-ENDEDNESS: trailing-window recipe-cell spread vs
#                                   the corpus's own historical best (expanding|narrow|collapsed) —
#                                   catches grinder collapse that per-render novelty + fit both miss
#   mesh-sound-reflex --ergodicity  per-axis ERGODICITY of the ranking corpus: eps_hat between organ
#                                   sub-corpora + which estimator each axis is on (pool|strat|own).
#                                   eps>=SR_ERG_EPS = the pooled percentile is ranking one organ's
#                                   record against another organ's distribution (see below).
#   mesh-sound-reflex --marginal   the EPISTEMIC term, read out (FEP convex-MDP review 2026-08-20) —
#                                   -log rho_hat per pool value over the corpus's realized MARGINAL
#                                   occupancy, the mirror-descent linearization the recipe search now
#                                   ranks on INSIDE a tie in appropriateness. Duplicate pool values
#                                   are marked [i=j] and share one reward. SR_MARGINAL_RANK=0 keeps it
#                                   measured and published but out of the sort key (the control arm).
#   mesh-sound-reflex --basis-drift BASIS DRIFT (report-only; FEP window-freeze review 2026-08-03) —
#                                   the ergodicity axis asks WHICH population to rank against; this
#                                   asks WHEN the ruler is allowed to move. Ranks the last K records
#                                   against the basis as it stood BEFORE they arrived vs the basis
#                                   now, and reports how many land in a DIFFERENT param slot. A slot
#                                   flip on an UNCHANGED record is the ruler moving, not the material.
#   mesh-sound-reflex --regime      REGIME SPLIT of the basis (report-only; FEP BME review 2026-08-04) —
#                                   ergodicity asks WHICH population, basis-drift asks WHEN the ruler
#                                   may move; this asks whether the basis is ONE population at all in
#                                   TIME. Runs mesh-precision --bme (the shipped estimator) over each
#                                   axis, POOLED-sequence and PER-ORGAN, and where a regime split is
#                                   warranted reports what restricting the basis to the CURRENT regime
#                                   would BUY, in param-slot flips. Changes nothing.
#   mesh-sound-reflex --prior       the THIN-CORPUS FALLBACK, made auditable: the cached per-axis
#                                   median (the centre corpus_pct ranks against when an axis holds
#                                   <8 records) beside what the LIVE ledger says now, with the drift
#                                   between them. The cache is re-measured on every run where the
#                                   axis is fat, so a growing drift column means the refresh stopped,
#                                   not that the corpus moved.
#   mesh-sound-reflex --trim <in> <out>
#                                   COMPLETING DEFICIENCIES (operator YES 2026-08-19): strip the
#                                   near-silent spans out of a render, at the SAME relative floor
#                                   mesh-song-verify judges by (-34dB from peak). Writes a file and
#                                   claims nothing — the drop path re-runs the FULL verify on it and
#                                   ships on THAT rc, never on the fact that a trim happened.
#   mesh-sound-reflex --test        pure-function gates: character drives params, novelty repels, walked-out
#
# Tunables (env): SR_PRIOR_MIN_N=30 (an axis is fat enough to re-measure the fallback prior from) ·
#   SR_PRIOR_CACHE (default: the ledger path with .log -> .prior — a prior belongs to ITS corpus)
# Tunables (env): SR_ERG_EPS=0.60 · SR_ERG_OWN_MIN=6 · SR_ERG_GROUP_MIN=3 (corpus-ergodicity switch)
# Tunables (env): SR_BASIS_K=20 (--basis-drift window: how many trailing records to re-rank)
# Tunables (env): SR_REGIME_K=20 (--regime window) · SR_REGIME_MIN=12 (a regime tail thinner than this
#   is NOT a usable basis — reported, never adopted) · SR_BME_BIN=mesh-precision (the estimator's home)
# Tunables (env): SR_REPICK=1 (0 = lane off) · SR_REPICK_MAX=2 (re-picks per source, LIFETIME) ·
#   SR_REPICK_COOLDOWN=21600 (s between re-picks, lane-wide — a rate on his TG, not on the node) ·
#   SR_REPICK_EPSILON=2*SR_EPSILON (the wall a remix must stand from every recipe THAT SOURCE already
#   wore; refuses rather than falls back) · SR_REPICK_TRIES=5 (candidates derived per idle tick
#   before giving up — a persistently-refused source must not wedge the pool behind it)
# Tunables (env): SR_EPSILON=0.22 (min normalized combo distance to recent recipes) · SR_RECENT=6
# Tunables (env): SR_EPSILON_FAILED=2*SR_EPSILON (the SIGNED half — the wall against recipes our
#   own verdict REJECTED, which must be higher than the wall against ones we shipped; a soft
#   preference, never a WALKED-OUT, and the tier it won is published as `avoid` on the RECIPE line)
# Tunables (env): SR_TRIM_HEADROOM_DB=34 (near-silent floor below PEAK — keep it equal to song-verify
#   0.02 rms, i.e. 34dB, or the trim aims at a different line than the gate that judges it) ·
#   SR_TRIM_MIN_GAP=0.20 (s — a dip shorter than this is phrasing, not dead air)
#   SR_MIN_BEATS=3 (operator 2026-08-20, was 4 — see the note at its assignment) · SR_MIN_DENSITY=0.8 (beats/s — rhythm, not a bang) · SR_POKE_COOLDOWN=1800 · SR_GRIND_TIMEOUT=300 (grind-cap FLOOR — effective cap = max(this, 5s x source-seconds); rc=124 verdicts skip:grind-timeout, never degenerate) · SR_OUTLIER_N=20 · SR_OUTLIER_MARGIN=1.15 (outlier = beats the last N candidates' high-water by 15%)
#
# reflex-cadence: */10 * * * *
set -uo pipefail
export PATH="/usr/bin:$HOME/.local/bin:$PATH"
export LC_ALL=C.UTF-8
MESH="${MESH_DIR:-$HOME/.mesh}"
[ -f "$MESH/nodes" ] && . "$MESH/nodes" 2>/dev/null || true

LEDGER="${MESH_REC_LOG:-$MESH/records.log}"
REC_DIR="${MESH_REC_DIR:-$MESH/records}"
PARAMS_LOG="${MESH_RMC_PARAMS_LOG:-$MESH/room-music-params.log}"
# Same var mesh-room-music already uses for the grainneukeln checkout — derive() imports the live
# NAMED_PATTERNS timeline table from it rather than hardcoding a copy that can drift (task
# sound-reflex-widen-recipe-space, 2026-07-28).
GRAIN_DIR="${MESH_GRAIN_DIR:-$HOME/grainneukeln}"
# The FAILED-recipe repellent store. mesh-room-music appends PARAMS_LOG only on SHIP, so a recipe
# whose render came out hollow never entered the repellent and the derivation re-picked the same
# combo all day (2026-07-20: 49b6427f/c54b76f5/86160733 all l120 w8 ss2.0 c40,4000, only s varying
# — verified by the sound mind, board 15:09Z). This file is OURS (fed by our own hollow/degenerate
# verdicts, line format parse-compatible with PARAMS_LOG) and joins the repellent only — it never
# drives tempo-band rotation, which is about what the operator actually HEARD.
FAILED_LOG="${SR_FAILED_LOG:-$MESH/.sound-reflex-failed.log}"
# The MEASURED fallback prior (task sound-reflex-prior-medians-frozen-at-n29, 2026-08-19). corpus_pct
# needs a per-axis centre when an axis holds fewer than 8 records — and it cannot read one off the
# ledger in that moment, because the thin ledger IS the reason it is asking. The old answer was five
# constants measured once at n=29 on 2026-07-15 and frozen into the source; re-measured today against
# the live ledger (n=1306) they had rotted by +37% (dyn) / +14% (act) / +3% (rich) / +103% (move) /
# +51% (cent). So: measure the prior on every run where the axis IS fat, persist it beside the ledger,
# and read THAT when the corpus goes thin. Path is derived from the LEDGER, never from $MESH — a prior
# is only meaningful for the corpus it was measured from, and a --test driving a tmp ledger therefore
# refreshes a tmp prior instead of forging the live one.
# Captured, NOT resolved: the path is derived from "$LEDGER" at each derive() call, because the
# --test suite reassigns LEDGER to a tmp corpus and a path bound once at load time would keep
# pointing at the live prior — a dry-run refreshing the durable artifact it exists to check (the
# export-does-not-rebind-a-load-time-global family, which has already bitten this file once in 2d).
SR_PRIOR_CACHE_SET="${SR_PRIOR_CACHE:-}"
ANCHOR="${SR_ANCHOR:-$MESH/.sound-reflex-anchor}"
LASTPOKE="${SR_LASTPOKE:-$MESH/.sound-reflex-lastpoke}"
TICK="${SR_TICK:-$MESH/.sound-reflex-tick}"
NOTABLE="${SR_NOTABLE:-$MESH/sound-notable.log}"
# Durable record of the DETACHED child's delivery leg. mesh-bg-done's whole contract is to report
# "on-done FAILED rc=N — manifest stays done-undelivered (retryable)" on stderr, and every call site
# discarded it with >/dev/null 2>&1 inside a child that is itself >/dev/null 2>&1. So a stranded
# operator render carried NO cause at all — measured 2026-08-17: two drops (ae8c9db9, 805ee9f7)
# ground clean, passed song-verify, and sat done-undelivered with nothing anywhere saying why.
BGLOG="${SR_BGLOG:-$MESH/sound-bg-done.log}"
ROOM="${SR_ROOM:-$MESH/.sound-reflex-room}"      # last computed novelty headroom (the pane leases it)
STARVED="${SR_STARVED:-$MESH/.sound-reflex-starved}"  # last organ-mix verdict — EDGE state, see starve_check
INBOX_DIR="${SR_INBOX_DIR:-$MESH/inbox}"           # override-able so --test never scans the LIVE inbox
# ── THE RE-PICK POOL (task repick-lane-2026-08-21) ───────────────────────────────────────────────
# The lane's source diversity was living off a BUG. mesh-records' seen-index evicted a live source's
# hash within ~a day while the source file itself persists for weeks, so an already-ground record
# re-entered as "new", was re-measured, re-ground and re-SENT — 19 of 294 hashes carried >1 grind
# manifest, one of them four (0bb2c37). Fixing the index removed that supply and the starve became
# permanent: the drop backlog ran out 2026-08-20T11:30Z and the ear is event-driven and quiet.
#
# Re-grinding an already-ground source with a DIFFERENT recipe is legitimately what a remix lane is
# FOR, and it is a distinct act from re-archiving that source as a new find. The open question was
# whether it should change what lands in the operator's TG; he answered it by ASKING for it
# (grind-operator-voices-2026-08-21, delivered 04:57Z — his own already-consumed voice notes,
# re-ground with hand-picked recipes and shipped back). So this feeds diversity honestly where the
# bug fed it dishonestly — and THE CAPS ARE THE WHOLE DESIGN: an unbounded re-pick is that same bug
# with better manners. Three independent bounds, each with its own word in the refusal:
#   REPICK_MAX      per source, for its LIFETIME — a source cannot become the lane's private supply
#   REPICK_COOLDOWN lane-wide, between re-picks — bounds the rate at which remixes reach his TG
#   REPICK_EPS      the recipe wall — a remix must stand this far from every recipe THAT SOURCE has
#                   already worn, or it is refused rather than shipped (see repick_gate)
# The re-pick NEVER touches the record's ledger row: that row is the ARCHIVIST's account of the
# original find, and rewriting it would re-announce old material as new — exactly the shape the
# eviction bug had. A remix keeps its own book (REPICK_LOG) and the ledger stays honest.
REPICK_LOG="${SR_REPICK_LOG:-$MESH/sound-repick.log}"
REPICK_LEASE="${SR_REPICK_LEASE:-$MESH/.sound-reflex-repick.lease}"
# TEST-SANDBOX (task test-live-writes 2026-07-20): --test overrides most paths as shell vars, but
# ROOM was missing from that list (8 live truncs/smoke of the pane's leased headroom) and the
# detached grind children re-exec "$0" WITHOUT SR_FAILED_LOG in env — their verdicts appended to the
# LIVE failed-recipe store (the f6ee114 pollution class: recipes that never really ran poisoning the
# repellent). Explicit SR_* overrides still win — the asserting legs pass them via env.
if [ "${MESH_TEST_SANDBOX:-0}" = 1 ]; then
  FAILED_LOG="${SR_FAILED_LOG:-${TMPDIR:-/tmp}/.sound-reflex-failed.sandbox.$$}"
  ROOM="${SR_ROOM:-${TMPDIR:-/tmp}/.sound-reflex-room.sandbox.$$}"
  # Same reasoning, one store later: the detached remix child re-execs "$0" WITHOUT SR_REPICK_LOG in
  # env, so its verdict rows would land in the LIVE re-pick book — forging both a re-pick that never
  # happened and (through repick_count) a cap the live lane has not actually spent.
  REPICK_LOG="${SR_REPICK_LOG:-${TMPDIR:-/tmp}/.sound-repick.sandbox.$$}"
  REPICK_LEASE="${SR_REPICK_LEASE:-${TMPDIR:-/tmp}/.sound-repick-lease.sandbox.$$}"
fi
# Derived from the ledger path so a sandboxed --test locks its own file, never the live one.
LOCK="${SR_LOCK:-$LEDGER.reflex.lock}"
EPSILON="${SR_EPSILON:-0.22}"
# The SIGNED half of the repellent (SO-model review 2026-08-20, docs/reviews/autopoiesis-so-model-*).
# EPSILON is the wall against renders that SHIPPED — history we walk away from for variety. This is
# the wall against renders our own verdict called hollow/degenerate: experience we walk away from
# because it was WRONG. Declared, not derived — 2x is a starting point, and it is a soft preference
# (never a WALKED-OUT), so an over-large value degrades to exactly today's behaviour rather than
# refusing to grind. Its bite is a measured column: the RECIPE line carries `avoid=hard|soft|none`.
EPS_FAILED="${SR_EPSILON_FAILED:-$(awk -v e="${SR_EPSILON:-0.22}" 'BEGIN{printf "%.3f", e*2}')}"
RECENT="${SR_RECENT:-6}"
# The re-pick bounds (see REPICK_LOG above). MAX=2 is a lifetime count per source, not per day.
# COOLDOWN=6h is a rate on the OPERATOR'S EAR, not on the node: the pool is 211 eligible sources
# today (169 of them his own drops), so at 2 re-picks each an uncooled lane could put >400 remixes
# in his TG. 6h caps it at 4/day and leaves the ordinary lane the whole rest of the tick budget.
REPICK_MAX="${SR_REPICK_MAX:-2}"
REPICK_COOLDOWN="${SR_REPICK_COOLDOWN:-21600}"
# The recipe wall, and it is DELIBERATELY the failed-store epsilon, not the plain one. EPSILON is
# tuned for "have I just derived this for this lane" — a recency question. This asks something
# stronger: the operator has ALREADY HEARD a render of this exact source, so a remix that lands
# inside the plain epsilon of it is a second copy of an experience he has, not a new one. The search
# is repelled at the plain epsilon (worn joins `repel` in derive); this gate REFUSES what the search
# could only prefer. Refusing costs nothing here — no material is lost, the source stays eligible —
# which is why a re-pick may refuse where a fresh record must fall back.
#
# IT BITES, AND IT IS NOT A DEAD LANE — measured on the live pool 2026-08-21, 16 eligible sources
# sampled and derived for real: 3 pass, 13 refuse at 0.44, every distance in 0.22..0.49. The cluster
# is not an accident: the search only GUARANTEES the plain 0.22 and then optimises for fit, so it
# lands just above it and this wall selects the upper tail. With SR_REPICK_TRIES=5 candidates per
# idle tick a ~19% pass rate still ships (P(all 5 refuse) ~ 0.35 for one tick, and the cooldown is
# 6h). Two things that number is NOT: it is not stable (the pool, the params log and the recent
# window all move — re-derive it, never quote it), and it is not a reason to lower the wall until it
# passes. Re-derive with: mesh-sound-reflex --repick, then --derive per source under SR_WORN_LOG.
REPICK_EPS="${SR_REPICK_EPSILON:-$(awk -v e="${SR_EPSILON:-0.22}" 'BEGIN{printf "%.3f", e*2}')}"
# 4 -> 3, operator 2026-08-20 ("lower MIN_BEATS to 3 and see what grinds"). This floor is duration-
# BLIND, so its real cost is a density demand that scales as MIN_BEATS/window: at 4 it silently asked
# 2.86 b/s of a 1.4s record against a stated MIN_DENSITY of 0.8, rejecting material whose rhythm was
# fine for being short (8b6dd47 split the verdict so that is now visible as too-short-for-min-beats).
# At 3 the same 1.4s record needs 2.14 b/s and a 2.0s one needs 1.50 — still above the floor, so this
# widens the gate without disabling it; MIN_DENSITY remains the actual rhythm test. This is an
# EXPERIMENT with a named question (sound-experiments.md): does the automixer still produce real
# renders at 3, or do the extra admissions come back hollow/degenerate? Read the answer as the
# verdicts of records admitted at 3 beats, not as a count of grinds.
MIN_BEATS="${SR_MIN_BEATS:-3}"
# ── ERGODICITY of the ranking corpus (2026-07-24, docs/reviews/ergodicity-breaking-*.md) ─────────
# corpus_pct ranks a record against the POOLED ledger and its docstring claims that is
# "self-calibrating, so it cannot saturate". That claim is an ERGODIC assumption — it holds only if
# the pooled distribution is a stand-in for the distribution the record's OWN organ actually draws
# from. When the ledger is a MIXTURE of organs whose axis distributions are disjoint, it is false in
# exactly the way the docstring denies: every record of the quiet organ lands in the same corner of
# the pooled CDF, so `pick()` returns a CONSTANT for that organ no matter what the record sounds
# like. Measured on the live ledger 2026-07-24 (drop n=27 / scape n=3): on `move` and `cent` every
# scape record ranks below every drop record (eps=1.000; under exchangeability P=1/C(30,3)=2.5e-4),
# pooled pct in {0.00,0.03,0.07} → w and c pinned for the whole organ, while the SAME three records
# spread 0.00/0.33/0.67 against their own history. Two of five recipe axes were dead for room
# material. Same family as the fixed-threshold constants the docstring already catalogues (`tone`
# median==max), one level up: the mixture, not the scale.
#
# ERG_EPS is the switch, not a taste knob: below it the corpus is one population and pooling is the
# better estimator (more samples, less noise) — the fix must NOT fire there.
ERG_EPS="${SR_ERG_EPS:-0.60}"          # eps_hat at/above which an axis is treated as a mixture
ERG_OWN_MIN="${SR_ERG_OWN_MIN:-6}"     # own-organ samples needed to rank within it (the time average)
ERG_GROUP_MIN="${SR_ERG_GROUP_MIN:-3}" # organ samples needed to enter the eps_hat estimate at all
# RHYTHM DENSITY FLOOR (beats per second of the analysed window) — the fix for a gate that was a
# well-calibrated cough detector (2026-07-15, caught by its own outlier poke firing on the operator
# clearing his throat at 02:57:08, transcript `Кхе-кхе-кхе`, dyn pinned at 1.000).
#
# WHY score alone is the wrong ranker: mesh-soundscape's score weights `dyn` (relative dynamics)
# at 0.28 — the heaviest term — so ONE sharp transient (a cough, a door, a dropped fork) pins dyn
# and tops the corpus. Measured over n=215 real records: score>=55 averages 3.6 beats, score<55
# averages 12.2. Score is ANTI-CORRELATED with rhythm at the top, and the automixer is beat-driven,
# so ranking candidates by score aimed the reflexive lane at precisely the least grindable material.
# Density separates them cleanly: impulses 0.00-0.42 b/s, the records that actually ground well
# 1.33-1.58 b/s. 0.8 sits in the gap.
#
# MIN_BEATS stays as the absolute floor (the automixer needs beats at all); this is the "is it
# RHYTHM or just a BANG" test on top of it.
MIN_DENSITY="${SR_MIN_DENSITY:-0.8}"
POKE_COOLDOWN="${SR_POKE_COOLDOWN:-1800}"
GRIND_TIMEOUT="${SR_GRIND_TIMEOUT:-300}"
# The grind cap is sized by the SOURCE, not the organ's habit. 300s was calibrated by 18s ear
# records; the first drop the lane ever received was 125.57s and rendered in 317s (measured
# 2026-07-16, untimed rerun) — the flat cap killed it 17s short of a real 34M render. 5s per
# source-second is 2x the measured 2.53 s/s, with SR_GRIND_TIMEOUT as the floor for short records.
grind_cap(){ awk -v d="${1:-0}" -v g="$GRIND_TIMEOUT" 'BEGIN{ t=int(d*5+0.999); print (t>g)? t : g }'; }
# Retired: SR_OUTLIER (a multiplier on the WRONG population — see outlier_hw). Kept read-only so a
# node with it exported in ~/.mesh/nodes does not silently change meaning.
OUTLIER_N="${SR_OUTLIER_N:-20}"
# A bare high-water is not enough either: beating the last N by ANY epsilon (44 vs a flat 41) fires
# on noise — max-of-20 gets nudged aside ~5% of the time by pure fluctuation, which at 12
# candidates/hour is still a poke every ~100min for a distinction no mind can act on. Require the
# record to clear the high-water by a MARGIN, so "outlier" means audibly better, not luckier.
OUTLIER_MARGIN="${SR_OUTLIER_MARGIN:-1.15}"

now(){ date +%s; }
ts_utc(){ date -u +%FT%H:%MZ; }

# bg_register_drop <organ> <h> <src> — durable-delivery policy lives HERE so --test can assert it.
# For an operator DROP only, register a bg-manifest (mesh-bg-register) targeting the operator's TG and
# echo its manifest path; for EVERY other organ echo nothing (corpus grinds strand no delivery on a
# /clear, so registering them would only manufacture false gate-blocks — see grind()). The delivery
# file the on-done ships is the manifest stem + .mp3, so a caller derives it as "${mf%.manifest}.mp3"
# without a second return value; the child stages its $out there before mesh-bg-done fires.
bg_register_drop() {
  local organ="$1" h="$2" src="$3" caption="${4:-}"
  [ "$organ" = "drop" ] || return 0
  command -v mesh-bg-register >/dev/null 2>&1 || return 0
  local batch="grind-${h}-$(now)" mfpath deliver
  # Derive the deliver path from the manifest path the register WILL use (--path is read-only), so the
  # child's staged file ("${mf%.manifest}.mp3") and the on-done's shipped file are ONE path under
  # whatever MESH_BG_DIR points at — never a hardcoded $HOME that diverges from a redirected bg dir.
  mfpath="$(mesh-bg-register --path sound "$batch" 2>/dev/null)" || return 0
  deliver="${mfpath%.manifest}.mp3"
  # The caption is a caller argument so the RE-PICK lane can say what it actually is. A remix
  # arriving under "Твой дроп, перемолотый грануляром" would be a second announcement of the same
  # find — the very sentence the re-pick lane must not send (see verdict()). No apostrophes in any
  # caption: it lives inside single quotes in the stored on-done command.
  [ -n "$caption" ] || caption="Твой дроп ($(basename "$src")), перемолотый грануляром."
  mesh-bg-register sound "$batch" --target operator-TG \
    --on-done "mesh-room-music --deliver '$deliver' '$caption'" \
    2>/dev/null || return 0
}
# The record id (field 3) — NOT a hash of the whole line. The line's tail is its VERDICT, and
# verdict() rewrites it (`pending` -> `grinding`/`skip:...`/`ground:...`) on exactly the ticks that
# do work; a whole-line hash anchors on text the tick itself is about to destroy. The id is assigned
# by mesh-records and never mutates, so it survives a rewrite while still being pure line content
# (no byte offsets — see the prune reasoning below).
line_id(){ awk '{print $3}' <<<"$1"; }
last_poke(){ local v; v="$(cat "$LASTPOKE" 2>/dev/null)"; case "$v" in (''|*[!0-9]*) echo 0;; (*) echo "$v";; esac; }

# ── change detection ─────────────────────────────────────────────────────────────────────────────
# ANCHORED ON LINE CONTENT, NEVER A BYTE OFFSET. mesh-records tail-prunes the ledger exactly the way
# mesh-room-transcribe-loop prunes the transcript, so the file SHRINKS and every byte offset shifts.
# A byte tracker hits `size < pos -> pos=0`, resyncs to zero, and replays the ENTIRE ledger as fresh
# — re-grinding hours of old records and poking the mind about them. That is the 2026-07-14
# false-wake storm, and it is not worth re-buying here. Anchor gone (genuinely pruned) → resync to
# END and never replay: a missed record is cheap (another arrives in 30s), a replayed corpus is a
# stampede of paid grinds.
fresh_lines(){
  local anchor i idx=-1 n; local -a L
  [ -f "$LEDGER" ] || return 0
  mapfile -t L < "$LEDGER" 2>/dev/null || return 0
  n=${#L[@]}; [ "$n" -eq 0 ] && return 0
  anchor="$(cat "$ANCHOR" 2>/dev/null || echo '')"
  if [ -n "$anchor" ]; then
    for ((i=n-1; i>=0; i--)); do
      [ "$(line_id "${L[i]}")" = "$anchor" ] && { idx=$i; break; }
    done
  fi
  if [ "$idx" -lt 0 ]; then
    line_id "${L[n-1]}" > "$ANCHOR"
    return 0
  fi
  for ((i=idx+1; i<n; i++)); do printf '%s\n' "${L[i]}"; done
}
consume(){ line_id "$1" > "$ANCHOR"; }

# ── the outlier gate: a HIGH-WATER over what the lane actually grinds ────────────────────────────
# The population matters more than the multiplier. This compared the BLOCK WINNER — the top-scoring
# record of ~10, already selected for score — against 1.25x the median of the WHOLE ledger, i.e.
# against the very losers it had just beaten. A max-of-10 draw clears a median-based line almost by
# construction: measured 2026-07-15, 30% of block winners cleared it (candidate median 41.0 vs corpus
# median 36.4), so the condition was near-permanently TRUE and the 30-min cooldown stopped being a
# safety valve and became a METRONOME — deliveries at 05:10 / 05:40 / 06:10, exactly 1800s apart,
# forever, each one announcing the routine as remarkable. (The */5 anchor fix doubled the tick rate
# and pushed it to saturation; the defect predates it.) Same shape as the level-triggered poke
# starve_check was already edge-triggered to avoid, and the same family as `tone` (median == max ==
# a constant) and the `act > 0.55` tag that can never fire: a rule keyed on the wrong population.
#
# HIGH-WATER instead: poke only when the record beats every one of the last OUTLIER_N *candidates*.
# Self-calibrating (a quiet room lowers its own bar, a DJ set raises it), genuinely edge-triggered,
# and it CANNOT saturate — a flat run of material pokes once and then stays silent by construction.
# It also means something true when it fires: "the best thing the lane has seen lately."
outlier_hw(){  # max score among the last OUTLIER_N records that actually became candidates
  awk '/-> (ground:|grinding|skip:degenerate|skip:hollow|skip:no-render|skip:grind-timeout|held:)/{
         for(i=1;i<=NF;i++){split($i,a,"="); if(a[1]=="score"&&a[2]+0>0) s[++n]=a[2]+0}}
       END{ if(!n) exit; m=0; for(i=(n-N+1>1?n-N+1:1); i<=n; i++) if(s[i]>m) m=s[i]; printf "%.1f", m }' \
      N="$OUTLIER_N" "$LEDGER" 2>/dev/null
}
is_outlier(){  # $1 score  $2 density — exit 0 when this record deserves the mind
  local hw; hw="$(outlier_hw)"
  # No candidate history yet (fresh node): nothing to be an outlier ABOVE. Stay silent rather than
  # poke on the first record the lane ever grinds — a bar of 0 makes everything remarkable.
  [ -n "$hw" ] || return 1
  awk -v s="$1" -v d="$2" -v hw="$hw" -v md="$MIN_DENSITY" -v k="$OUTLIER_MARGIN" \
      'BEGIN{exit !(hw>0 && s+0 > hw*k && d+0 >= md+0)}'
}

# ── the recipe engine: character -> params, then repelled from recent history ────────────────────
# Pure: reads the ledger (for corpus percentiles) and the params + failed logs (for what to avoid),
# touches nothing. Prints one line: `RECIPE <automix args> ~ <meta>` or `WALKED-OUT <reason>`.
derive(){  # $1 dyn $2 act $3 rich $4 move $5 cent $6 beat_ms [$7 organ]
           # [$8 cov] [$9 fdyn $10 fact $11 frich $12 fmove $13 fcent $14 fbeat_ms]
  SR_PRIOR_CACHE="${SR_PRIOR_CACHE_SET:-${LEDGER%.log}.prior}" \
  SR_EPS_FAILED_RESOLVED="$EPS_FAILED" \
  python3 - "$1" "$2" "$3" "$4" "$5" "$6" "$LEDGER" "$PARAMS_LOG" "$RECENT" "$EPSILON" "$FAILED_LOG" \
           "${7:-}" "$ERG_EPS" "$ERG_OWN_MIN" "$ERG_GROUP_MIN" "$GRAIN_DIR" \
           "${8:-na}" "${9:-na}" "${10:-na}" "${11:-na}" "${12:-na}" "${13:-na}" "${14:-na}" <<'PYEOF'
import sys, re, os, itertools, json, subprocess, time, math

dyn, act, rich, move, cent, beat_ms = (float(x) for x in sys.argv[1:7])
ledger, params_log, recent_n, epsilon = sys.argv[7], sys.argv[8], int(sys.argv[9]), float(sys.argv[10])
failed_log = sys.argv[11]
# Resolved in the shell (SR_EPSILON_FAILED, default 2*epsilon) and passed by ENV rather than by
# position: the positional chain below is read by fixed index in a dozen places and appending to it
# is the kind of edit that silently shifts an argument nobody re-checks.
eps_failed = float(os.environ.get("SR_EPS_FAILED_RESOLVED") or (epsilon * 2))
organ = sys.argv[12] if len(sys.argv) > 12 else ""
erg_eps = float(sys.argv[13]) if len(sys.argv) > 13 else 0.60
erg_own_min = int(sys.argv[14]) if len(sys.argv) > 14 else 6
erg_group_min = int(sys.argv[15]) if len(sys.argv) > 15 else 3
grain_dir = sys.argv[16] if len(sys.argv) > 16 else os.path.expanduser("~/grainneukeln")

# ── THE WINDOW IS NOT THE SOURCE — the coverage-weighted basis (task sound-derive-coverage-weighted,
#    2026-08-18) ────────────────────────────────────────────────────────────────────────────────────
# Every axis above is read off the score-max WINDOW, and mesh-soundscape publishes how much of the
# source that window actually covers. Measured on the live ledger the day cov= landed (n=698 rows,
# reconstructed as win/dur): median cov 0.284, **71% below 0.25 and 56% below 0.10** — i.e. the
# majority of grinds are shaped by a few percent of their own source. That is CLAUDE.md's
# sample-vs-interval failure at the window scale: a reading whose window is a fraction of its subject
# reports a SAMPLE, not the material.
#
# And the sample is BIASED, not merely noisy — the picker takes the max SCORE, so it selects the most
# eventful moment by construction. Re-measured over the 60 newest archived records (2026-08-18,
# cov median 0.042): the window reads HIGHER than the whole file on dyn 22/27, act 25/27, move 22/27
# (median win-file: dyn +0.078, act +0.078, move +0.187, rich +0.044). move's window median is 0.891
# — nearly saturated — against 0.582 whole-file.
#
# Hence: rank BOTH and fold by coverage, in PERCENTILE space.
#
#   p_axis = cov * pct(window value | window corpus) + (1-cov) * pct(whole-file value | f corpus)
#
# Two properties this buys, both load-bearing:
#   * cov=1 is byte-identical to the old derive (the fold degenerates), so a fully-covered record can
#     never regress. There is no threshold to tune and no cliff to sit on — the correction scales
#     with how little of the source was actually looked at.
#   * each value is ranked INSIDE ITS OWN POPULATION and only then folded. Feeding whole-file values
#     into the window-axis corpus (the naive "read f* below some cov" switch) compares two different
#     quantities: the whole-file numbers are systematically lower, so EVERY low-cov record's
#     percentile is pushed down together — a lane-wide shift wearing the costume of a per-record
#     correction. Measured, that mis-basing is not a small effect: window-axes vs whole-file-axes
#     ranked in the SAME window corpus moved 270/480 param slots, and re-ranking the identical
#     whole-file axes in their own corpus moved a further 247/480.
#
# Blind where it should be: an f corpus under 8 values does NOT blend (corpus_pct's own floor — below
# it a percentile is noise, and the measured prior carries no f axis until one goes fat, so blending
# there would fold in a fabricated 0.5). It stays on the window and SAYS so. Same for a record whose row predates
# 2e1843d and carries no f* at all: cov is na, the fold is skipped, nothing is invented.
def _f(x):
    try:
        v = float(x)
    except (TypeError, ValueError):
        return None
    return v
cov       = _f(sys.argv[17]) if len(sys.argv) > 17 else None
f_axes    = {a: _f(sys.argv[18 + i]) for i, a in enumerate(("dyn", "act", "rich", "move", "cent"))} \
            if len(sys.argv) > 22 else {}
f_beat_ms = _f(sys.argv[23]) if len(sys.argv) > 23 else None

# ── the pools (the grainneukeln taste envelope — same values mesh-room-music rotates over) ───────
F_VALS  = [0.2, 0.33, 0.5, 1, 2, 3]              # beat-period multiplier -> grain length
S_VALS  = [0.25, 0.5, 0.75, 1.0, 1.25, 1.5, 2.0, 3.0]   # TRACK speed (the rhythm axis)
W_VALS  = [4, 5, 6, 8]                            # window divider (grain density)
# ss ordered by DISTANCE FROM 1.0, not by magnitude: "how much pitch-smear" is the musical axis, and
# 0.5 and 2.0 are the same amount of smear in opposite directions. Ordering by value would make the
# rich->smear mapping pick "slow" rather than "far", which is not the same thing at all.
SS_VALS = sorted([0.25, 0.5, 0.75, 1.0, 1.25, 1.5, 2.0], key=lambda v: abs(v - 1.0))
# c ordered dark-source -> bright-source: open the top for a dark record, carve the low/narrow for a
# bright one. "" twice in the middle keeps unfiltered the common case for mid material.
#
# 2026-07-19: the prior `c 1,250;500,15000` first entry was the source of the recurring note3
# hollows — its 250-500 Hz gap sits exactly on the voice fundamental, so for SPEECH-class records
# (which note3 mostly captures) the band-pass carved out the core energy and the layered remainder
# was near-silent. Replaced with `c 80,15000` — a single wide band that keeps the "dark-source
# opens the top" intent (no high-pass) without ever gapping the speech range. The grinder's other
# recipes (c 300,12000 / c 100,8000 / c 40,4000) are all single-band and unaffected. If you want a
# two-band layered recipe back, use an OVERLAPPING split (`c 1,2000;1000,15000`) so no frequency is
# carved to silence.
#
# 2026-07-28 (task sound-reflex-widen-recipe-space): added ONE overlapping two-band entry at each end
# — the OVERLAPPING form the comment above already names as the safe way back to a layered band (no
# frequency carved to silence). Front (darkest slot) keeps the wide top AND layers in the low end a
# dark record actually has; back (brightest slot) narrows the low band for body while still keeping a
# wide-open upper band, never gapping like the retired `c 1,250;500,15000` did.
C_VALS  = ["c 1,2000;1000,15000", "c 80,15000", "c 300,12000", "", "",
           "c 100,8000", "c 40,4000", "c 300,3000;2000,12000"]

# ── WIDENING (task sound-reflex-widen-recipe-space, 2026-07-28): mesh-grind-params.py already
# parametrizes mode (lib/q/poly), rhythm timelines, euclid, swing, and reverb for BATCH renders —
# decorrelated-random (every knob spun from its own hash salt), no character, no repulsion, because
# it is a generator for a whole batch, not this reflex's per-record derivation. This folds the SAME
# taste pools into the character -> percentile -> repel pipeline above, so the reflex stays
# reflexive-only (no manual step) while varying more than f/s/ss/w/c. Two small grids below the main
# one, not one giant joint grid: the proven f/s/ss/w/c search stays exactly as it is (8064 combos,
# unchanged, still covered by every existing --test assertion); MODE_VALS x REV_VALS (9 combos) and
# each mode's own sub-pick (<=90 combos) are cheap enough to brute-force every tick without slowing
# the */10min cron down measurably — a joint grid across ALL axes at once would be ~400k combos x
# the repel-list scan, seconds per tick, for a benefit (one more axis of joint constraint) this
# reflex does not need on knobs this secondary to the grain shape.
#
# mode: low act (still/sparse) -> lib (close-loop similarity keeps it recognizable rather than
# fragmenting nothing into noise); high act (busy) -> q (a real metric pattern gives busy material
# somewhere to put its energy); the middle -> poly (layered streams add motion neither extreme needs).
MODE_VALS = ["lib", "poly", "q"]
# rv (per-grain reverse probability, 0..1): dark material (low cent) lacks the top a bright one has —
# reverse probability adds diffuse texture to fill it, the same "dark needs filling" story as `c`'s
# dark-source-opens-the-top rule, just spent on a different knob. Bright stays drier (near 0) to keep
# the clarity `c` is already carving for.
REV_VALS = [0.0, 0.15, 0.3]
# ── GRAIN SHAPE (task: operator 2026-08-15 "i am bored from the same exact params for each session,
#    same 5 sets, make it more diverse"). MEASURED before changing anything: across 224 logged drop
#    renders, `env`, `snap`, `nofill` and `fg` had been emitted ZERO times — every render this lane
#    has ever shipped carried the SAME grain envelope (the mixer's default taper) and the SAME
#    filled-rest texture. The numbers moved; the grain SHAPE never did, which is why a log full of
#    distinct l/w/s/ss tuples still sounds like a handful of sets.
#
#    Note what is deliberately NOT done here: `rw` stays out of MODE_VALS. The operator ruled on it
#    directly (2026-07-24, grainneukeln 689cc9a: "use q or lib or poly, not rw"), and re-adding a
#    fourth mixer is the cheapest-looking diversity win precisely because it ignores that ruling.
#    Widen the axes he did not rule out instead.
#
# env (attack/release taper %, 0 = hard edges): the "give it what it lacks" story `c` and `rv`
# already tell, spent on the grain envelope. Transient-heavy material (high dyn) gets a LONGER taper
# so the grain edges stop competing with the source's own attacks; flat/sustained material gets a
# short one, because hard edges are the only bite it has. Emitted for EVERY mode — this is the one
# axis that is not mode-specific.
ENV_VALS = [0, 4, 8, 15, 25, 40]
# q-only placement. `snap` (pitch-preserving snap-to-slot) tightens events onto the grid; spend it on
# spectrally-still material (low move), which reads as smeared without it, and leave genuinely moving
# material free-running. Fill controls the REST slots: busy material (high act) already has energy in
# the gaps, so it takes the quiet/silent end; sparse material gets the loud fill so the grid does not
# read as holes. "nofill" is the pure-grid, silent-rest sound this lane could never previously reach.
FILL_VALS = ["nofill", "fg -12", "fg -6", "fg -3"]
SNAP_VALS = [False, True]

def pick2(pool, p):
    """Same clamp-to-range index pick as `pick()` above, under a different name: this file's `pick`
    closes over F_VALS/etc. by the time it is (re)defined below, and the two are identical on purpose
    — one percentile-to-pool-index rule for every knob, old or new."""
    i = int(p * len(pool))
    return max(0, min(len(pool) - 1, i))

def idx_by_val(pool, val, categorical):
    """Generalizes this file's `idx_of` (the 'c' branch is exact-match; everything else is
    nearest-value) to an arbitrary pool/value pair, for the secondary grids below. `categorical`
    covers strings AND tuples (a timeline name, a (k,n) euclid pair) where a numeric distance is
    meaningless or would crash trying to float() them — those must find an EXACT index or admit they
    cannot compare, never guess a numeric neighbour."""
    if categorical:
        try:
            return pool.index(val)
        except ValueError:
            return None
    best, bd = None, None
    for i, x in enumerate(pool):
        try:
            d = abs(float(x) - float(val))
        except (TypeError, ValueError):
            return None
        if bd is None or d < bd:
            best, bd = i, d
    return best if (bd is not None and bd <= 1e-6) else None

def nearest_ideal(pools, categorical, ideal_idx, repel_entries, eps, epi=None):
    """The same 'nearest-to-ideal candidate that clears epsilon against repel_entries' gate as the
    main f/s/ss/w/c search below, generalized over an arbitrary axis set so it can serve every
    secondary grid (mode+rv, then each mode's own sub-params) without four near-duplicate copies.
    Falls back to the ideal itself (never a WALKED-OUT) when nothing clears epsilon — these are
    enrichments layered onto an already-novelty-gated primary recipe, not the axis the WALKED-OUT
    gate exists to protect; refusing a whole grind over a repeated reverb depth would be the tail
    wagging the dog.
    n>=1 (not the primary gate's n>=2): these grids are often only 1-2 axes wide (poly's lone ratio,
    q's lone euclid pair), so requiring two comparable axes would make repulsion permanently
    impossible on exactly the grids that need it most."""
    axes = list(pools.keys())

    def dist(cand_idx, prev):
        tot, n = 0.0, 0
        for a in axes:
            if a not in prev:
                continue
            pi = idx_by_val(pools[a], prev[a], categorical.get(a, False))
            if pi is None:
                continue
            span = max(1, len(pools[a]) - 1)
            tot += abs(cand_idx[a] - pi) / float(span)
            n += 1
        return (tot / n) if n >= 1 else None

    def min_dist(cand_idx):
        ds = [d for d in (dist(cand_idx, p) for p in repel_entries) if d is not None]
        return min(ds) if ds else 1.0

    def ideal_dist(cand_idx):
        tot = 0.0
        for a in axes:
            span = max(1, len(pools[a]) - 1)
            tot += abs(cand_idx[a] - ideal_idx[a]) / float(span)
        return tot / len(axes)

    best, best_key = None, None
    for combo in itertools.product(*(range(len(pools[a])) for a in axes)):
        cand = dict(zip(axes, combo))
        if min_dist(cand) < eps:
            continue
        # THREE levels: pragmatic (ideal_dist) > epistemic marginal (-log rho, the mirror-descent
        # linearization) > the recency tie-break we already had. With epi=None the middle slot is a
        # constant, so the key is EXACTLY the old two-level one — the new term can only ever break a
        # tie in appropriateness, never overrule it.
        key = (ideal_dist(cand), -(epi(cand) if epi is not None else 0.0), -min_dist(cand))
        if best_key is None or key < best_key:
            best, best_key = cand, key
    return best if best is not None else dict(ideal_idx)

# ── THE MIRROR-DESCENT EPISTEMIC TERM: -log rho over the corpus's own MARGINALS ──────────────────
# Live-literature review 2026-08-20 (docs/reviews/fep-convex-mdp-occupancy-marginal-mirror-descent-
# sound-reflex-2026-08-20.md). Milosevic, Hinrichs & Scherf, "Active Inference as a Convex Markov
# Decision Process", arXiv:2607.20152v1 (22 Jul 2026), §4: "The convex nonlinearity of the EFE makes
# the per-step reward depend on the policy's state-marginal, so a single value function cannot
# capture the objective globally... every step replaces the EFE by its first-order surrogate around
# the current state-marginal, turning the convex MDP into a sequence of ordinary soft-MDP problems
# whose reward is recomputed between iterations." Their Algorithm 1's linearized reward
# r^k = -grad Gamma(mu^k) "carries the state-marginal term -log rho_t^k(s) - 1".
#
# WHY THIS IS NOT WHAT WE HAD. The recipe search ranks on (ideal_dist, -min_dist): the first is the
# PRAGMATIC term (linear in the marginals — a plain reward, and correct as one), the second is our
# whole epistemic half, and it is the distance to the last SR_RECENT renders. That is a function of
# the RECENCY WINDOW, not of the occupancy: measured on this node's live params log 2026-08-20 (4301
# candidates admissible against the last 6 ambient renders), Pearson r between -min_dist and the
# marginal reward below is -0.117 — the term we call novelty is orthogonal to how worn the corpus
# actually is, and if anything leans the wrong way. The -1 in the paper's r^k is an additive constant
# identical for every candidate, so it cannot change a ranking and is not carried here.
#
# ALIASES ARE ONE ACTION. C_VALS holds "" TWICE. Counting per INDEX gives index 4 a count of exactly
# zero forever (idx_by_val resolves "" to index 3 on every read-back), hence the largest reward in
# the pool (measured: 7.29 vs 1.02 for its own twin) — a 7x pull toward a value whose render output
# is byte-identical to one of the most-worn values we have. A zero in a marginal has two causes and
# only one of them is "never chosen"; duplicate pool values are merged into one class before
# counting and share one reward, so the unreachable half can never wear the unexplored half's bonus.
#
# CORPUS-WIDE, NOT LANE-SCOPED, on purpose (the opposite of the repellent's 2026-08-15 fix): "have I
# just derived this for THIS lane" is a question about one lane's recent history, "how worn is this
# value" is a property of the corpus the operator has been hearing. A c-band the drop lane wore out
# is worn.
def marginal_rewards(pools, categorical, hist, min_n):
    """Per-axis MD reward -log rho_hat(v) over `hist`, aliases merged.

    Returns (reward, note, info). `reward[axis][idx]` is 0.0 for EVERY index when the corpus is too
    thin (note starts with "na") — a constant, so a caller that folds it into a sort key gets
    exactly its old ranking back rather than a preference invented out of three renders."""
    reward = {a: {i: 0.0 for i in range(len(pools[a]))} for a in pools}
    alias, counts = {}, {a: {} for a in pools}
    for a in pools:
        first, alias[a] = {}, {}
        for i, v in enumerate(pools[a]):
            alias[a][i] = first.setdefault(repr(v), i)
    for h in hist:
        for a in pools:
            if a not in h:
                continue        # an axis this line predates is ABSENT, never a vote for any value
            i = idx_by_val(pools[a], h[a], categorical.get(a, False))
            if i is None:
                continue        # off-pool (hand-pinned) values are not evidence about the pool
            k = alias[a][i]
            counts[a][k] = counts[a].get(k, 0) + 1
    # PER-AXIS n, not a joint one: a render missing `w` still says something true about `f`, and the
    # joint-tuple requirement would have thrown away 610 of this node's 2072 lines (29%). The
    # marginal is per-axis by construction; the JOINT cell count is coverage()'s object, not this.
    ns = {a: sum(counts[a].values()) for a in pools}
    thin = sorted(a for a in pools if ns[a] < min_n)
    info = {"counts": counts, "n": ns, "alias": alias}
    if thin:
        return reward, "na(thin:%s)" % ",".join(thin), info
    for a in pools:
        m = len(set(alias[a].values()))
        for i in range(len(pools[a])):
            reward[a][i] = -math.log((counts[a].get(alias[a][i], 0) + 1.0) / (ns[a] + m))
    return reward, "md", info

# NAMED_PATTERNS is grainneukeln's own timeline table — imported live so this list can never drift
# from the engine that actually plays them (an Explore-agent audit of automixer/iterators/patterns.py
# confirmed it is the sole source of truth, and the render-layer's `ek`/`en` clamp — never raises —
# means an out-of-range euclid pair degrades silently rather than crashing a grind either).
TIMELINE_NAMES = []
try:
    sys.path.insert(0, grain_dir)
    from automixer.iterators.patterns import NAMED_PATTERNS  # noqa: E402
    TIMELINE_NAMES = sorted(NAMED_PATTERNS)
except Exception:
    TIMELINE_NAMES = []   # absent grainneukeln checkout -> q mode just never picks the pat/rot branch

# ── the ledger read, ONCE, keyed by organ (field 2) ─────────────────────────────────────────────
# The old reader took only the axis value and threw the organ away, which is precisely what made the
# mixture invisible: you cannot notice you are pooling two populations if you never record which
# population a sample came from.
ORGAN_VALS = {}                    # axis -> {organ: [v, ...]}
try:
    with open(ledger) as fh:
        for ln in fh:
            parts = ln.split()
            org = parts[1] if len(parts) > 1 else "?"
            for m in re.finditer(r'(?:^| )([a-z]+)=([0-9.]+)', ln):
                ORGAN_VALS.setdefault(m.group(1), {}).setdefault(org, []).append(float(m.group(2)))
except OSError:
    pass

# ── the fallback prior is MEASURED and REFRESHED, never a constant ──────────────────────────────
# (task sound-reflex-prior-medians-frozen-at-n29, 2026-08-19.) corpus_pct needs a centre for an axis
# holding fewer than 8 records, and in that moment the ledger cannot supply one — the thin ledger IS
# the question. The old answer was five numbers measured at n=29 on 2026-07-15 and frozen into the
# source. Re-measured 2026-08-19 against the live ledger (n=1306) every one had rotted, two of them
# past recognition: dyn .265->.364 (+37%) · act .319->.362 (+14%) · rich .611->.629 (+3%) ·
# move .141->.286 (+103%) · cent 1101.9->1661.8 (+51%). A record ranked against move=.141 is being
# told it is high-motion when it sits below the corpus median. So the prior is now measured on every
# run where the axis is fat (>= prior_min_n) and persisted beside the ledger, and the thin-corpus
# branch reads that. The numbers here are a WORKED EXAMPLE of the rot, not a table anything reads —
# `mesh-sound-reflex --prior` re-derives cached-vs-live at call time (and this comment cannot be the
# thing that rots, because deleting the cache costs one fat run, not a code edit).
#
# No constant survives as a last resort: with no cache AND a thin corpus there is nothing measured to
# rank against, so the axis returns a MARKED no-rank rather than a plausible number. That is the same
# 0.5 the f axes already get when their corpus is too thin — the established no-rank value here — but
# it is named `none(...)` in PCT_SRC, never `prior`, so --status/--ergodicity can tell "ranked against
# a measured centre" from "did not rank".
prior_cache = os.environ.get("SR_PRIOR_CACHE") or ""
prior_min_n = int(os.environ.get("SR_PRIOR_MIN_N", "30") or 30)

def _median(xs):
    q = sorted(xs)
    m = len(q) // 2
    return q[m] if len(q) % 2 else (q[m - 1] + q[m]) / 2.0

def _prior_load(path):
    """axis -> (median, n, stamp). Absent/unreadable/garbled file -> {} (no prior, not a fake one)."""
    d = {}
    if not path:
        return d
    try:
        with open(path) as fh:
            for ln in fh:
                if ln.startswith("#"):
                    continue
                q = ln.split()
                if len(q) >= 4:
                    try:
                        d[q[0]] = (float(q[1]), int(q[2]), q[3])
                    except ValueError:
                        continue
    except OSError:
        pass
    return d

def _prior_live():
    """The prior as the LIVE ledger currently answers it: axis -> (median, n). Fat axes only."""
    out = {}
    for a, g in ORGAN_VALS.items():
        vs = [x for xs in g.values() for x in xs]
        if len(vs) >= prior_min_n:
            out[a] = (_median(vs), len(vs))
    return out

def _prior_refresh(path, cur, live):
    """Persist the live medians. Rewrites only on a real move (>1% or a new axis) so the file's mtime
    stays a fact about the PRIOR, not about how often this reflex ran."""
    if not path or not live:
        return cur
    merged = dict(cur)
    moved = False
    for a, (m, n) in live.items():
        old = cur.get(a)
        if old is None or old[0] == 0 or abs(m - old[0]) / abs(old[0]) > 0.01:
            moved = True
        merged[a] = (m, n, time.strftime("%Y-%m-%dT%H:%MZ", time.gmtime()))
    if not moved:
        return cur
    try:
        tmp = path + ".tmp%d" % os.getpid()
        with open(tmp, "w") as fh:
            fh.write("# mesh-sound-reflex measured fallback prior — axis median n stamp\n")
            fh.write("# re-derived from %s on every run where the axis holds >= %d records\n"
                     % (ledger, prior_min_n))
            for a in sorted(merged):
                m, n, st = merged[a]
                fh.write("%s %.6g %d %s\n" % (a, m, n, st))
        os.replace(tmp, path)
    except OSError:
        return cur
    return merged

# Load BEFORE refreshing and keep both. PRIOR_PREV is what the thin-corpus branch would have
# answered had this run not re-measured — i.e. the only quantity against which "has the prior rotted"
# is a real question. Reporting live-vs-PRIOR instead would print a drift column that is 0.0% by
# construction on every fat axis, since the refresh two lines up just wrote it.
PRIOR_PREV = _prior_load(prior_cache)
PRIOR = _prior_refresh(prior_cache, PRIOR_PREV, _prior_live())

def _auc(a, b):
    """P(x>y), ties at 0.5 — the rank form of 'how separated are these two samples'."""
    n = len(a) * len(b)
    if n == 0:
        return None
    s = 0.0
    for x in a:
        for y in b:
            s += 1.0 if x > y else (0.5 if x == y else 0.0)
    return s / n

def eps_hat(axis):
    """Ergodicity coefficient for one axis: median pairwise separation between organ sub-corpora.

    The paper's coefficient is a median pairwise TOTAL-VARIATION distance between the distributions
    of independent runs (Self-Organization to the Edge of Ergodicity Breaking, arXiv:2604.15669,
    eps(l) := median_{mu,nu} ||mu-nu||_TV). We keep the role and change the estimator: our data is
    1-D and our sub-corpora are single-digit n, where binned TV between two empirical distributions
    is biased hard toward 1 by sparsity alone and would declare every axis a mixture. |2*AUC-1| is
    the rank form of the same question, is unbiased under exchangeability, and is exactly the
    quantity that breaks pooling: at 1.0 every sample of one organ outranks every sample of the
    other, so each organ occupies a FIXED sub-range of the pooled CDF — saturation by construction.

    Returns None when fewer than two organs clear erg_group_min: not "ergodic", UNKNOWN. The caller
    keeps pooling, which is the honest default, and --ergodicity prints n/a rather than a 0.
    """
    g = {o: v for o, v in ORGAN_VALS.get(axis, {}).items() if len(v) >= erg_group_min}
    if len(g) < 2:
        return None
    ks = sorted(g)
    ds = []
    for i in range(len(ks)):
        for j in range(i + 1, len(ks)):
            a = _auc(g[ks[i]], g[ks[j]])
            if a is not None:
                ds.append(abs(2 * a - 1))
    if not ds:
        return None
    ds.sort()
    m = len(ds) // 2
    return ds[m] if len(ds) % 2 else (ds[m - 1] + ds[m]) / 2.0

def _rank(vals, v):
    return sum(1 for x in vals if x < v) / float(len(vals))

PCT_SRC = {}                        # axis -> which estimator answered (for --status/--ergodicity)

def corpus_pct(axis, v):
    """Rank v against the LIVE corpus for this axis. Self-calibrating, so it cannot saturate.

    Fixed thresholds are wrong here and measurably so: the dyn/act/move medians sit well below 0.5
    on real material, so a naive 0.5 split calls nearly everything 'even' and 'sparse'. `tone` is
    worse: its median IS its max, so a rule keyed on it is a CONSTANT. (Every one of those is a
    CLAIM, and the figure that answers it is only ever this corpus's current answer — re-derive with
    `mesh-series-stats --claims` or `--prior`, never quote. This docstring used to carry the n=29
    numbers themselves and every one of them had rotted by 2026-08-19, one by +103%.) Ranking against
    the corpus adapts as the corpus changes: a DJ set landing next to room hum re-centres every axis
    automatically.

    ...and THAT sentence is the bug, not the feature. "Re-centres every axis" is only true if the DJ
    set and the room hum are draws from ONE population. When they are not, pooling re-centres the
    axis onto whichever organ happened to be chatty this sweep — and records.log is a per-organ
    SLIDING WINDOW pruned every sweep, so the mixing proportions are not even stationary. The rank a
    record gets then depends on the other organs' recent chattiness rather than on the record.
    eps_hat() measures that; above erg_eps we rank the record against the distribution it was
    actually drawn from (its own organ's history — the TIME average) instead of the ensemble.
    """
    grp = ORGAN_VALS.get(axis, {})
    vals = [x for vs in grp.values() for x in vs]
    # Below ~8 records the percentile is noise — fall back to the MEASURED prior (see _prior_refresh:
    # this axis's median, re-derived from this same ledger whenever it was last fat, and stamped with
    # the n and date it was measured at). Never a constant: an axis with no measured prior does not
    # rank at all, and says so.
    if len(vals) < 8:
        # A ladder, and every rung is MEASURED — the coarse above/below is kept (a percentile off <8
        # values is noise, which is why the floor exists at all), only the centre it splits at stops
        # being a constant:
        #   prior — this axis's median as of the last run where the corpus was fat, from THIS ledger.
        #   thin  — the corpus is too thin for a prior to have been measured but not empty, so split
        #           at its own median. Noisy, and named noisy; still strictly better than a number
        #           from another corpus.
        #   none  — nothing measured and nothing to measure. The only rung that does not rank, and
        #           the reason there is no constant to fall through to.
        # Dropping the middle rung is what makes this a regression rather than a fix: on a fresh node
        # EVERY axis would return 0.5, and 0.5 is precisely the split this docstring opens by showing
        # is wrong. Measured cost of getting that wrong, seen red: gates 9a/9c go from character-
        # driven mode/fill to a constant, i.e. the lane grinds one recipe until the 8th record lands.
        pr = PRIOR.get(axis)
        if pr is not None:
            pm, pn, pstamp = pr
            PCT_SRC[axis] = "prior(%.4g,n=%d,%s)" % (pm, pn, pstamp)
        elif vals:
            pm = _median(vals)
            PCT_SRC[axis] = "thin(%.4g,n=%d)" % (pm, len(vals))
        else:
            PCT_SRC[axis] = "none(n=0,no-prior)"
            return 0.5
        return 0.75 if v > pm else 0.25

    e = eps_hat(axis)
    if e is not None and e >= erg_eps:
        own = grp.get(organ, [])
        if organ and len(own) >= erg_own_min:
            # The time average: this source's own history. What the paper says is the right object
            # once ergodicity breaks.
            PCT_SRC[axis] = "own(%s,n=%d,eps=%.2f)" % (organ, len(own), e)
            return _rank(own, v)
        big = {o: vs for o, vs in grp.items() if len(vs) >= erg_group_min}
        if len(big) >= 2:
            # Own organ too thin to rank inside. Stratify instead: equal-weight mean of the
            # within-organ ranks. It does not recover the record's own regime, but it does remove
            # the dependence on the mixing proportions — the part that makes the pooled rank a
            # function of which organ was chatty rather than of the record. Marked, not silent.
            PCT_SRC[axis] = "strat(%d,eps=%.2f)" % (len(big), e)
            return sum(_rank(vs, v) for vs in big.values()) / float(len(big))
    PCT_SRC[axis] = "pool(n=%d,eps=%s)" % (len(vals), "n/a" if e is None else "%.2f" % e)
    return _rank(vals, v)

def pick(pool, p):
    i = int(p * len(pool))
    return max(0, min(len(pool) - 1, i))

# ── derivation: each axis drives the param it actually governs ───────────────────────────────────
BASIS = {}                          # axis -> which basis answered (for the meta line / --status)

def blended_pct(axis, v):
    """corpus_pct, folded with the whole-file reading by how much of the source the window covered.

    Returns the window percentile unchanged whenever the fold cannot be made honestly: no coverage
    published (a pre-2e1843d row), full coverage (the fold is the identity anyway), no whole-file
    value, or an f corpus too thin to rank in. Every one of those is NAMED in BASIS, never silent.
    """
    p = corpus_pct(axis, v)
    fv = f_axes.get(axis)
    if cov is None or fv is None:
        BASIS[axis] = "win"
        return p
    if cov >= 1.0:
        BASIS[axis] = "win(cov=1)"
        return p
    fkey = "f" + axis
    fvals = [x for vs in ORGAN_VALS.get(fkey, {}).values() for x in vs]
    if len(fvals) < 8:
        # honest blindness: the whole-file corpus has not filled yet (records.log is a sliding
        # window, so it fills at the lane's own rate). Never fold in a fabricated 0.5.
        BASIS[axis] = "win(f-corpus n=%d<8)" % len(fvals)
        return p
    pf = corpus_pct(fkey, fv)
    BASIS[axis] = "blend"
    return cov * p + (1.0 - cov) * pf

p_act, p_dyn, p_rich, p_move, p_cent = (blended_pct("act", act), blended_pct("dyn", dyn),
                                        blended_pct("rich", rich), blended_pct("move", move),
                                        blended_pct("cent", cent))

# The beat period is folded the same way and on its own terms — it is an absolute duration in ms
# read by the SAME detector over both spans, so it needs no corpus and no floor. (On the operator's
# 149.06s drop 9a11e5d1: window 3.00s/7 beats = 428ms, whole file 149.06s/289 beats = 515ms.)
beat_basis = "win"
if cov is not None and f_beat_ms is not None and cov < 1.0:
    beat_ms = cov * beat_ms + (1.0 - cov) * f_beat_ms
    beat_basis = "blend"
elif cov is not None and f_beat_ms is not None:
    beat_basis = "win(cov=1)"

# ── the PRIOR, made observable (mesh-sound-reflex --prior) ───────────────────────────────────────
# The thin-corpus fallback is the one place the ranker answers from something other than the live
# ledger, so it is the one place a frozen number can hide. This prints the cached prior beside what
# the ledger says RIGHT NOW, so the drift is a measured quantity rather than an argument — and a
# cache that has stopped refreshing shows up as a growing drift column instead of as silence.
if os.environ.get("SR_PRIOR_REPORT") == "1":
    _live = _prior_live()
    print("PRIOR cache=%s min-n=%d  (cached = as it stood BEFORE this run re-measured)"
          % (prior_cache or "(none)", prior_min_n))
    for a in sorted(set(list(PRIOR_PREV) + list(_live))):
        pr, lv = PRIOR_PREV.get(a), _live.get(a)
        _tot = len([x for xs in ORGAN_VALS.get(a, {}).values() for x in xs])
        if lv is None:
            print("PRIOR %-5s cached=%-9s live=n/a (n=%d < %d — too thin to re-derive)"
                  % (a, "n/a" if pr is None else "%.4g" % pr[0], _tot, prior_min_n))
            continue
        _d = "n/a" if pr is None or pr[0] == 0 else "%+.1f%%" % (100.0 * (lv[0] - pr[0]) / abs(pr[0]))
        print("PRIOR %-5s cached=%-9s live=%-9.4g n=%-5d drift=%-8s stamp=%s"
              % (a, "n/a" if pr is None else "%.4g" % pr[0], lv[0], lv[1], _d,
                 "never" if pr is None else pr[2]))
    sys.exit(0)

# ── the assumption, made observable (mesh-sound-reflex --ergodicity) ─────────────────────────────
# A corpus whose ergodicity nobody measures is a corpus whose ranker nobody can audit. This prints
# the estimate that decides each axis, so the "cannot saturate" claim above is re-derivable from the
# LIVE ledger instead of asserted in a docstring.
if os.environ.get("SR_ERG_REPORT") == "1":
    for a in ("dyn", "act", "rich", "move", "cent"):
        g = ORGAN_VALS.get(a, {})
        e = eps_hat(a)
        ns = " ".join("%s=%d" % (o, len(v)) for o, v in sorted(g.items()))
        print("ERG %-5s eps=%-5s organs[%s] -> %s"
              % (a, "n/a" if e is None else "%.3f" % e, ns or "-", PCT_SRC.get(a, "-")))
    sys.exit(0)
ideal = {
    # busy source -> micro-grain (dense material blurs under long grains); sparse -> long grain
    # (stretch the empty into texture). Hence the inversion.
    "f":  pick(F_VALS,  1.0 - p_act),
    # dynamic source -> slow the track and let the swells breathe; even source -> the rhythm axis
    # has to supply the motion the material doesn't have.
    "s":  pick(S_VALS,  1.0 - p_dyn),
    # timbrally rich -> far from 1.0: harmonic structure survives (and rewards) pitch-smear. Poor,
    # flat material just turns to mud, so keep it near 1.0.
    "ss": pick(SS_VALS, p_rich),
    # spectral movement rewards density.
    "w":  pick(W_VALS,  p_move),
    # dark -> open the top it doesn't have; bright -> carve for the body under the hiss.
    "c":  pick(C_VALS,  p_cent),
}
POOLS = {"f": F_VALS, "s": S_VALS, "ss": SS_VALS, "w": W_VALS, "c": C_VALS}
AXES = ["f", "s", "ss", "w", "c"]

# ── BASIS DRIFT: is the RULER moving, or the material? (2026-08-03, live-literature review:
#    docs/reviews/fep-window-freeze-ranking-basis-sound-reflex-2026-08-03.md) ────────────────────
# corpus_pct's docstring sells a LIVE basis as the feature ("self-calibrating, so it cannot
# saturate") and the ergodicity work above fixed WHICH population to rank against. Neither asked
# WHEN the basis is allowed to move. It moves continuously: records.log is a per-organ sliding
# window, appended every sweep and pruned every sweep, so the percentile a record gets is a function
# of the corpus's turnover as well as of the record. Two derives of the SAME unchanged record
# therefore need not agree, and the difference is not attributable to the material.
#
# The FEP/active-inference literature names this exactly and gives the remedy: Furutanpey & Dustdar,
# "Principled Direction-Free Intrinsic Motivation through Model-Free Epistemic Free-Energy
# Estimators" (arXiv:2607.16858, cs.LG, 18 Jul 2026) — "Bandit or mixture switching between
# surprise-minimizing and surprise-maximizing rewards reintroduces non-stationarity by
# construction"; the proposed reward is "stationary within each window", and "A window-based freeze
# of all reward-defining objects yields a stationary Bellman operator, explicit bounds on learning
# targets, and a conditional uniform-concentration result". The mesh's inversion of that: this
# reflex's reward-defining objects (the per-axis ranking corpus AND the recency repellent) are
# re-derived from a corpus its own renders feed, on every single decision.
#
# This is REPORT-ONLY and deliberately so — it does not freeze anything yet. Freezing changes what
# gets ground; measuring first is the [[crypticity-vs-excess-entropy-hollow-on-short-logs]]
# discipline. It reports what a freeze would BUY: for each axis, how far the percentile of the K
# most recent records moves between the basis as it stood before those K arrived and the basis now,
# and — the only number that touches behaviour — how many of them land in a DIFFERENT param slot.
# A slot flip with an unchanged record is the ruler moving, not the material.
if os.environ.get("SR_BASIS_REPORT") == "1":
    try:
        _bk = int(os.environ.get("SR_BASIS_K", "20") or 20)
    except ValueError:
        _bk = 20
    _brows = []
    try:
        with open(ledger) as fh:
            for ln in fh:
                _p = ln.split()
                if len(_p) > 1:
                    _brows.append((_p[1], {m.group(1): float(m.group(2))
                                           for m in re.finditer(r'(?:^| )([a-z]+)=([0-9.]+)', ln)}))
    except OSError:
        _brows = []
    _recent, _older = _brows[-_bk:], _brows[:-_bk]
    if len(_older) < 8:
        # Below the fallback floor corpus_pct answers from the measured prior, not from a rank, so
        # the two "bases" would differ by a centre that says nothing about turnover. n/a, never a 0.
        print("BASIS n/a (older basis n=%d < 8 — corpus_pct would answer from the prior, not a rank)"
              % len(_older))
        sys.exit(0)

    def _basis_of(rs):
        d = {}
        for _o, _v in rs:
            for _a, _x in _v.items():
                d.setdefault(_a, {}).setdefault(_o, []).append(_x)
        return d

    _live_b, _frozen_b = _basis_of(_brows), _basis_of(_older)
    # eps_hat is O(n_a*n_b) per axis; it is a property of the BASIS, not of the record, so memoise
    # per (basis, axis) rather than paying it 2*K*5 times. Same code path as a real derive.
    _eps_real, _eps_memo, _btag = eps_hat, {}, ["live"]

    def eps_hat(axis):                                                       # noqa: F811
        k = (_btag[0], axis)
        if k not in _eps_memo:
            _eps_memo[k] = _eps_real(axis)
        return _eps_memo[k]

    # (axis, param it drives, its pool, whether the derive inverts the percentile) — read straight
    # off the `ideal` dict above, so a re-wiring there cannot leave this report describing the old one.
    _AXMAP = (("act", "f", F_VALS, True), ("dyn", "s", S_VALS, True),
              ("rich", "ss", SS_VALS, False), ("move", "w", W_VALS, False),
              ("cent", "c", C_VALS, False))
    print("BASIS window K=%d  recent=%d  older=%d  ledger=%d" % (_bk, len(_recent), len(_older), len(_brows)))
    _tot = 0
    for _a, _pn, _pool, _inv in _AXMAP:
        _ds, _fl, _n = [], 0, 0
        for _o, _v in _recent:
            if _a not in _v:
                continue
            _n += 1
            _ps = []
            for _tag, _b in (("frozen", _frozen_b), ("live", _live_b)):
                _btag[0] = _tag
                ORGAN_VALS = _b
                organ = _o
                _ps.append(corpus_pct(_a, _v[_a]))
            _ds.append(abs(_ps[1] - _ps[0]))
            _i = [pick(_pool, (1.0 - p) if _inv else p) for p in _ps]
            if _i[0] != _i[1]:
                _fl += 1
        _tot += _fl
        _md = sorted(_ds)[len(_ds) // 2] if _ds else 0.0
        print("BASIS %-5s -> %-2s pool=%d n=%d med|dp|=%.3f max|dp|=%.3f slot_flips=%d"
              % (_a, _pn, len(_pool), _n, _md, max(_ds) if _ds else 0.0, _fl))
    print("BASIS total slot_flips=%d over %d records x %d axes" % (_tot, len(_recent), len(_AXMAP)))
    sys.exit(0)

# ── REGIME SPLIT: is the basis ONE population in TIME? (2026-08-04, live FEP review:
#    docs/reviews/fep-bayesian-model-expansion-structure-learning-precision-2026-08-04.md) ────────
# Three questions about the same ranking corpus, and only two of them had been asked here:
#   --ergodicity  WHICH population does this record belong to?   (organ — a SPATIAL split)
#   --basis-drift WHEN is the ruler allowed to move?             (turnover — the ruler's velocity)
#   --regime      is there ONE population in time at all?        (a TEMPORAL split — this block)
# The mesh's whole structure-learning vocabulary was REMOVAL: mesh-precision --bmr prunes, sensorium
# --balance prices redundancy, reflex-decay retires. Nothing could ask whether the data warrant an
# EXTRA state — so a corpus that really is two regimes is pooled into one, and every percentile drawn
# from it is a rank against a mixture of a distribution that ended and one that started.
#
# The estimator is NOT re-implemented here. `bme_expand` shells to `mesh-precision --json --bme` so
# the classifier that is gated (mesh-precision --test, 3 mutants) is the classifier that answers —
# the same "defined ONCE" discipline BME_CORE/BMR_CORE keep inside that file, held across the tool
# boundary. Absent binary / non-zero exit / unparseable output all render None ("no split claimed"),
# never a guessed 0: this is a report, and a report that manufactures a split is worse than silent.
#
# POOLED vs PER-ORGAN is the whole honesty of the report, not a second opinion. The pooled sequence
# interleaves organs, so a shift in the MIXING PROPORTIONS alone (records.log is a per-organ sliding
# window — see corpus_pct) can read EXPAND with neither organ's own distribution having moved. The
# per-organ tape cannot be fooled that way. Where pooled says EXPAND and every organ says otherwise,
# the finding is a mix shift and restricting the basis would be the wrong remedy; where an ORGAN's
# own tape says EXPAND, the regime change is real and the record's basis genuinely predates it.
#
# REPORT-ONLY, and for the same reason --basis-drift above is: restricting the basis changes what
# gets ground. It reports what the restriction would BUY — how many of the last K records land in a
# DIFFERENT param slot when ranked against the current regime instead of the whole history. A tail
# thinner than SR_REGIME_MIN is reported as such and never adopted, because below the noise floor a
# short basis is worse than a mixed one (corpus_pct's own <8 rule is the same instinct).
REGIME_MINSEG = 3                                   # mesh-precision's own --min-seg default
REGIME_MIN = int(os.environ.get("SR_REGIME_MIN", "12") or 12)
BME_BIN = os.environ.get("SR_BME_BIN", "mesh-precision")


def bme_read(vals):
    """Ask the shipped estimator once. Returns {"verdict":..., "split":..., "logK":...}.

    ONE fork per tape, and every failure mode gets its OWN verdict string rather than collapsing
    into a plausible "PARSIMONIOUS": a reader cannot tell "one regime" from "could not ask", so
    neither may quietly become the other. Only a literal "EXPAND" carries a split.
    """
    if len(vals) < 2 * REGIME_MINSEG:
        return {"verdict": "n/a(n=%d<%d)" % (len(vals), 2 * REGIME_MINSEG), "split": None, "logK": None}
    try:
        p = subprocess.run([BME_BIN, "--json", "--bme", "-"],
                           input="\n".join(repr(float(v)) for v in vals),
                           stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                           universal_newlines=True, timeout=30)
    except (OSError, subprocess.SubprocessError):
        return {"verdict": "n/a(estimator unreachable: %s)" % BME_BIN, "split": None, "logK": None}
    if p.returncode != 0:
        return {"verdict": "n/a(estimator rc=%d)" % p.returncode, "split": None, "logK": None}
    try:
        r = json.loads((p.stdout or "").strip().splitlines()[-1])
    except (ValueError, IndexError):
        return {"verdict": "n/a(estimator output unparseable)", "split": None, "logK": None}
    if r.get("verdict") != "EXPAND" or r.get("split") is None:
        return {"verdict": str(r.get("verdict", "n/a")), "split": None, "logK": r.get("logK")}
    return {"verdict": "EXPAND", "split": int(r["split"]), "logK": float(r.get("logK") or 0.0)}


if os.environ.get("SR_REGIME_REPORT") == "1":
    try:
        _rk = int(os.environ.get("SR_REGIME_K", "20") or 20)
    except ValueError:
        _rk = 20
    _rrows = []
    try:
        with open(ledger) as fh:
            for ln in fh:
                _p = ln.split()
                if len(_p) > 1:
                    _rrows.append((_p[1], {m.group(1): float(m.group(2))
                                           for m in re.finditer(r'(?:^| )([a-z]+)=([0-9.]+)', ln)}))
    except OSError:
        _rrows = []
    _AXMAP = (("act", "f", F_VALS, True), ("dyn", "s", S_VALS, True),
              ("rich", "ss", SS_VALS, False), ("move", "w", W_VALS, False),
              ("cent", "c", C_VALS, False))
    print("REGIME window K=%d  ledger=%d  tail-floor=%d  estimator=%s --bme"
          % (_rk, len(_rrows), REGIME_MIN, BME_BIN))
    _recent = _rrows[-_rk:]
    _tot = 0
    for _a, _pn, _pool, _inv in _AXMAP:
        _grp = ORGAN_VALS.get(_a, {})
        # POOLED sequence: file order across organs — the reading the mix shift can fake.
        _pooled = [_v[_a] for _o, _v in _rrows if _a in _v]
        _pv = bme_read(_pooled)["verdict"]
        # PER-ORGAN: each organ's own tape, which a mixing shift cannot move.
        _restricted, _oparts, _adopted = {}, [], 0
        for _o in sorted(_grp):
            _vs = _grp[_o]
            _r = bme_read(_vs)
            if _r["split"] is None:
                _restricted[_o] = _vs
                _oparts.append("%s:%s(n=%d)" % (_o, _r["verdict"], len(_vs)))
                continue
            _t, _lk = _r["split"], _r["logK"]
            _tail = _vs[_t:]
            if len(_tail) < REGIME_MIN:
                # A real split whose current regime is too short to rank against. Say so; a basis
                # below the floor is not an improvement over a mixed one, it is a different fault.
                _restricted[_o] = _vs
                _oparts.append("%s:EXPAND@%d(lnK=%.2f) tail=%d<%d NOT-ADOPTED"
                               % (_o, _t, _lk, len(_tail), REGIME_MIN))
                continue
            _restricted[_o] = _tail
            _adopted += 1
            _oparts.append("%s:EXPAND@%d(lnK=%.2f) tail=%d mean %.4g->%.4g"
                           % (_o, _t, _lk, len(_tail),
                              sum(_vs[:_t]) / _t, sum(_tail) / float(len(_tail))))
        if not _adopted:
            print("REGIME %-5s -> %-2s pooled=%-14s per-organ[%s] — basis unchanged"
                  % (_a, _pn, _pv, " ".join(_oparts) or "-"))
            continue
        # What the restriction would BUY: re-rank the last K records under both bases and count the
        # ones that land in a DIFFERENT param slot. Same corpus_pct, same pick() — one ranker, so
        # this cannot describe a derivation the reflex does not actually perform.
        _ds, _fl, _n = [], 0, 0
        _live_b = ORGAN_VALS
        for _o, _v in _recent:
            if _a not in _v:
                continue
            _n += 1
            _ps = []
            for _b in (_live_b, _restricted):
                ORGAN_VALS = _b
                organ = _o
                _ps.append(corpus_pct(_a, _v[_a]))
            ORGAN_VALS = _live_b
            _ds.append(abs(_ps[1] - _ps[0]))
            _i = [pick(_pool, (1.0 - p) if _inv else p) for p in _ps]
            if _i[0] != _i[1]:
                _fl += 1
        _tot += _fl
        _md = sorted(_ds)[len(_ds) // 2] if _ds else 0.0
        print("REGIME %-5s -> %-2s pooled=%-14s per-organ[%s] n=%d med|dp|=%.3f max|dp|=%.3f slot_flips=%d"
              % (_a, _pn, _pv, " ".join(_oparts) or "-", _n, _md, max(_ds) if _ds else 0.0, _fl))
    print("REGIME total slot_flips=%d over %d records x %d axes (report-only — nothing restricted)"
          % (_tot, len(_recent), len(_AXMAP)))
    sys.exit(0)

# ── what to be repelled from: the last N recipes actually rendered, PLUS the last N that FAILED ──
# The params log is append-on-SHIP only (mesh-room-music refuses to log a hollow render), so without
# the failed store a hollow recipe was repellent-invisible and re-derived all day (2026-07-20).
def lane_of(line):
    """Which lane shipped this render. `src=<organ>/<hash>` names the organ (drop, scape, …);
    a line without one is the ambient room-music lane, which logs no src token."""
    m = re.search(r'(?:^| )src=([A-Za-z0-9_-]+)/', line)
    return m.group(1) if m else "ambient"


def parse_recent(path, lane=None, n=None):
    """Recent renders, newest-last. With `lane` set, the window is counted IN THAT LANE.

    PER-LANE, not per-render (operator 2026-08-15 "fix the per-lane repel window"). This used to
    take the last N lines of the params log regardless of lane. The ambient lane emits ~3 renders
    per sweep, so a drop's own history left the window almost immediately and drop recipes were
    barely repelled from each other. MEASURED on the live log before the fix: the 13:02 drop render
    carried {f 0.2, s 1.25, ss 2.0, w 6} — IDENTICAL on all four axes this parser compares to the
    08:20 drop render, i.e. distance exactly ZERO — and still cleared epsilon, because that twin sat
    23 LINES BACK while the 6-line window held 1 drop and 5 ambient renders. Same attractor hit
    three times in a day (00:50, 08:20, 13:02).

    A lane with fewer than N renders simply gets a shorter window — less history, less repulsion,
    which is honest. Never back-fill from another lane to reach N: that is precisely the dilution
    this fixes.
    """
    out = []
    try:
        lines = [l.strip() for l in open(path) if l.strip()]
    except OSError:
        return out
    if lane:
        lines = [l for l in lines if lane_of(l) == lane]
    # n=0 asks for the WHOLE log. The repellent's window and the MARGINAL's window are
    # deliberately different objects: the repellent asks "did I just do this?" (a few lines),
    # the marginal asks "how worn is this value in the corpus?" (all of it).
    _lim = recent_n if n is None else n
    if _lim > 0:
        lines = lines[-_lim:]
    for ln in lines:
        v = {}
        m = re.search(r'(?:^| )f ([0-9.]+)', ln)
        if m: v["f"] = float(m.group(1))
        else:
            # older/manual lines carry `l /3` (a divisor) or `l 500` with a `beat` — recover f where
            # we honestly can, and simply leave the axis absent where we can't. An axis we cannot
            # read must not silently compare as equal.
            m2 = re.search(r'(?:^| )l /([0-9.]+)', ln)
            if m2:
                try: v["f"] = 1.0 / float(m2.group(1))
                except (ValueError, ZeroDivisionError): pass
            else:
                ml, mb = re.search(r'(?:^| )l ([0-9]+)', ln), re.search(r'(?:^| )beat ([0-9]+)', ln)
                if ml and mb and float(mb.group(1)) > 0:
                    v["f"] = float(ml.group(1)) / float(mb.group(1))
        for k, pat in (("s", r'(?:^| )s ([0-9.]+)'), ("ss", r'(?:^| )ss ([0-9.]+)'),
                       ("w", r'(?:^| )w ([0-9]+)')):
            m = re.search(pat, ln)
            if m: v[k] = float(m.group(1))
        mc = re.search(r'(?:^| )(c [0-9,;]+)', ln)
        v["c"] = mc.group(1) if mc else ""
        # WIDENING (task sound-reflex-widen-recipe-space, 2026-07-28): recover the new mode/rv/
        # mode-specific tokens the SAME honest way as `f` above — present or absent, never guessed.
        # `mode` is unconditional going forward (every render this engine derives picks one), so a
        # line missing it is pre-widening history: correctly incomparable, not a default guess.
        mm = re.search(r'(?:^| )m (lib|poly|q)(?: |$)', ln)
        if mm: v["mode"] = mm.group(1)
        # rv IS emitted unconditionally below (unlike mesh-grind-params.py's truthy-only convention)
        # precisely so a deliberately-chosen rv=0.0 (a bright source choosing "stay dry") is
        # recoverable and distinct from "this line predates the feature, unknown" — defaulting
        # absent-to-0.0 here would fabricate the former out of the latter.
        mrv = re.search(r'(?:^| )rv ([0-9.]+)', ln)
        if mrv: v["rv"] = float(mrv.group(1))
        mpat = re.search(r'(?:^| )pat ([A-Za-z0-9_]+)', ln)
        if mpat: v["pat"] = mpat.group(1)
        mrot = re.search(r'(?:^| )rot ([0-9]+)', ln)
        if mrot: v["rot"] = int(mrot.group(1))
        mek, men = re.search(r'(?:^| )ek ([0-9]+)', ln), re.search(r'(?:^| )en ([0-9]+)', ln)
        if mek and men: v["euclid"] = (int(mek.group(1)), int(men.group(1)))
        msw = re.search(r'(?:^| )sw ([0-9]+)', ln)
        if msw: v["sw"] = int(msw.group(1))
        mlib = re.search(r'(?:^| )lib (sim|con)(?: |$)', ln)
        if mlib: v["lpol"] = mlib.group(1)
        mlk = re.search(r'(?:^| )lk ([0-9]+)', ln)
        if mlk: v["lk"] = int(mlk.group(1))
        mpr = re.search(r'(?:^| )pr ([0-9]+)', ln)     # leading ratio only — the r2 embellishment
        if mpr: v["pr1"] = int(mpr.group(1))           # (";n") is not itself repelled
        # env/snap/fill (2026-08-15). An axis the repellent cannot READ is an axis that repeats
        # freely no matter how wide its pool is — the emit side and the parse side are one feature,
        # and adding a pool without its reader would have bought a wider vocabulary that still
        # converges. Absent stays ABSENT (never defaulted): a line predating these axes must not
        # fabricate "chose env 0 / chose no snap", which is exactly the trap the rv comment above
        # names.
        menv = re.search(r'(?:^| )env ([0-9]+)', ln)
        if menv: v["env"] = int(menv.group(1))
        if re.search(r'(?:^| )env ', ln):
            # snap is a BARE flag: its absence is only meaningful on a line that carried the axis
            # set at all, which `env` (emitted unconditionally) marks.
            v["snap"] = bool(re.search(r'(?:^| )snap(?: |$)', ln))
            mfg = re.search(r'(?:^| )fg (-?[0-9.]+)', ln)
            if mfg: v["fill"] = "fg " + mfg.group(1)
            elif re.search(r'(?:^| )nofill(?: |$)', ln): v["fill"] = "nofill"
        out.append(v)
    return out

# The lane THIS derive is rendering for. `organ` is the record's organ (drop, scape, …); an empty
# organ is the ambient room-music lane, matching lane_of()'s reading of a render with no src token.
my_lane = organ or "ambient"
# TWO windows, deliberately different, because the two consumers ask different questions:
#
#   recent (PER-LANE)  -> the repellent. "Have I derived this recipe for THIS lane before?" The
#                         ambient lane emits ~3 renders per sweep and was flushing the drop lane's
#                         own history out of a shared 6-line window (2026-08-15 measurement: an
#                         exact duplicate on all four compared axes cleared epsilon with its twin
#                         23 lines back). Lane-scoped is the fix the operator asked for.
#
#   recent_heard (ALL LANES) -> tempo-band rotation. "What did the operator last HEAR?" That is a
#                         question about the listening sequence, not about one lane's derivation
#                         history, and nothing measured says it is broken. Kept cross-lane on
#                         purpose: scoping it too was a silent second behaviour change riding on a
#                         shared variable, and it went RED against 2c's fixture (which seeds
#                         src=ear/ lines and derives for ambient) — the test was right and the
#                         collapse was mine.
recent = parse_recent(params_log, lane=my_lane)
recent_heard = parse_recent(params_log)
failed = parse_recent(failed_log)   # hollow/degenerate recipes — repellent ONLY (never heard, so
                                    # they must not drive band rotation, which is about what the
                                    # operator actually heard). Deliberately NOT lane-scoped: a
                                    # recipe that rendered hollow is a property of recipe+material,
                                    # and repelling every lane from it is the conservative direction.
# ── WHAT THIS SOURCE HAS ALREADY WORN (task repick-lane-2026-08-21) ─────────────────────────────
# Empty for every ordinary derive; set only by the re-pick lane, which passes the recipes THIS source
# has already been rendered with (its params-log lines + its failed-store lines + its own earlier
# re-picks). It has to be a separate store rather than "just look further back in the params log"
# because `recent` is a WINDOW — the last SR_RECENT lines of the lane — and a source ground three
# weeks ago left that window the same day. Without this the remix search is repelled from what the
# lane rendered LATELY and knows nothing at all about what THIS SOURCE already sounds like, so the
# most likely recipe for a re-pick is the one it already wore. Whole file, never a window: the
# question is "has this source ever been here", which has no recency in it.
worn_log = os.environ.get("SR_WORN_LOG", "")
worn = parse_recent(worn_log, n=0) if worn_log else []
repel = recent + failed + worn

# ── SIGNED leverage of prior experience (SO-model review 2026-08-20) ─────────────────────────────
# `repel` above pools two stores that carry OPPOSITE verdicts and then applies ONE epsilon to both:
# a render that SHIPPED and a render our own verdict called hollow/degenerate push the search away
# by exactly the same 0.22. That is unsigned imprinting — the Hopfield self-optimization model's
# known failure axis (Weber, Guckelsberger & Froese, *Artificial Life* 31(4):435, 2025;
# arXiv:2501.04007): the model imprints whatever attractor it happened to visit, and whether that
# helps or harms is decided entirely by ALPHA, "the rate at which one leverages prior experience".
# Our epsilon IS that alpha, and one value cannot express "come back here for variety's sake, but
# never come back HERE". So: failed entries get their own, larger epsilon.
#
# A PREFERENCE, not a hard wall — the same shape (and the same reason) as the tempo-band rotation
# below: raising the wall on a store of up to SR_RECENT entries can empty the admissible set, and a
# WALKED-OUT manufactured by the appropriateness preference would be the tail wagging the dog. The
# gate keeps the plain epsilon as its floor and merely PREFERS candidates that also clear the
# failed epsilon, falling back when none does. Which tier won is published in the RECIPE line
# (`avoid=hard|soft|none`), so a preference that never bites is visible rather than assumed.
for _fr in failed:
    _fr["_failed"] = True
def clears_failed(cand_idx):
    """True when cand_idx stands at least eps_failed from EVERY failed recipe. Axes we cannot
    compare (dist -> None) abstain, exactly as they do for the plain epsilon — an axis we cannot
    read must not silently count as distance."""
    for p in failed:
        d = dist(cand_idx, p)
        if d is not None and d < eps_failed:
            return False
    return True

def idx_of(axis, val):
    pool = POOLS[axis]
    if axis == "c":
        try: return pool.index(val)
        except ValueError: return None
    best, bd = None, None
    for i, x in enumerate(pool):
        d = abs(float(x) - float(val))
        if bd is None or d < bd: best, bd = i, d
    # a value not actually in the pool (a hand-pinned combo) is not a neighbour of anything
    return best if (bd is not None and bd <= 1e-6) else None

def dist(cand_idx, prev):
    """Normalized mean per-axis distance, in POOL STEPS, over the axes present in BOTH.

    Per-axis-independent rotation (what pick_args does) lets two recipes differing in a single value
    read as 'different' while sitting adjacent in the space. Constraining the COMBO is the point.
    """
    tot, n = 0.0, 0
    for a in AXES:
        if a not in prev: continue
        pi = idx_of(a, prev[a])
        if pi is None: continue
        pool = POOLS[a]
        span = max(1, len(pool) - 1)
        tot += abs(cand_idx[a] - pi) / float(span)
        n += 1
    if n < 2:
        return None          # too little overlap to judge — not evidence of novelty either way
    return tot / n

def min_dist(cand_idx):
    ds = [d for d in (dist(cand_idx, p) for p in repel) if d is not None]
    return min(ds) if ds else 1.0     # nothing comparable to repel from → maximally novel

def ideal_dist(cand_idx):
    tot = 0.0
    for a in AXES:
        span = max(1, len(POOLS[a]) - 1)
        tot += abs(cand_idx[a] - ideal[a]) / float(span)
    return tot / len(AXES)

# ── the epistemic term, RELINEARIZED on every derive (marginal_rewards() above) ──────────────────
# The paper's mirror descent recomputes the reward between iterations; here one derive IS one
# iteration, and re-reading the params log every call is that relinearization. Nothing is cached:
# a cache would freeze rho at the corpus of whenever it was written, which is the same
# frozen-constant rot the --prior work fixed on the ranking basis (a constant outlives its reader).
MARG_MIN = int(os.environ.get("SR_MARGINAL_MIN", "20") or 20)
B_POOLS  = {"mode": MODE_VALS, "rv": REV_VALS, "env": ENV_VALS}
B_CAT    = {"mode": True, "rv": False, "env": False}
hist_all = parse_recent(params_log, n=0)
marg_a, marg_note, marg_info = marginal_rewards(POOLS, {"c": True}, hist_all, MARG_MIN)
marg_b, marg_b_note, marg_b_info = marginal_rewards(B_POOLS, B_CAT, hist_all, MARG_MIN)
def epi_a(cand_idx):
    return sum(marg_a[a][cand_idx[a]] for a in AXES) / float(len(AXES))
_epi_b_raw = (lambda c: sum(marg_b[a][c[a]] for a in B_POOLS) / float(len(B_POOLS))) \
             if marg_b_note == "md" else None
# SR_MARGINAL_RANK=0 keeps the term MEASURED and PUBLISHED but out of the sort key — the control arm
# the --test gates below are red against, and the only honest way to compare "what would the old
# ranking have picked" on the SAME corpus. It is published as `epi <v>(off)` precisely so a knob left
# set in production reads as a disabled preference in the params log rather than as an absent one
# (a safety knob named only in prose is a knob nobody can audit).
MARG_RANK = os.environ.get("SR_MARGINAL_RANK", "1") != "0"
epi_a_key = epi_a if MARG_RANK else (lambda c: 0.0)
epi_b = _epi_b_raw if MARG_RANK else None

# The sub-grids BELOW grid B (pat/rot/euclid/sw/lib/lk/pr) deliberately get NO marginal term: their
# axes are MODE-CONDITIONAL (a euclid pair only exists on a `q` render), so an unconditional count
# would score a value as unexplored for ticks in which it was not even reachable — a conditional
# quantity read as a marginal. That is a real gap, not an oversight; it is named in the review.
if os.environ.get("SR_MARGINAL_REPORT") == "1":
    print("MARGINAL note=%s/%s min_n=%d lines=%d  (reward = -log rho_hat over the corpus marginal;"
          " higher = rarer = preferred INSIDE a tie in appropriateness)"
          % (marg_note, marg_b_note, MARG_MIN, len(hist_all)))
    for _pools, _rw, _if, _lbl in ((POOLS, marg_a, marg_info, "A"), (B_POOLS, marg_b, marg_b_info, "B")):
        for _a in _pools:
            _al = _if["alias"][_a]
            _cells = []
            for _i, _v in enumerate(_pools[_a]):
                _mark = "=%d" % _al[_i] if _al[_i] != _i else ""
                _cells.append("[%d%s]%r n=%d r=%.2f"
                              % (_i, _mark, _v, _if["counts"][_a].get(_al[_i], 0), _rw[_a][_i]))
            print("  %s %-4s n=%-5d %s" % (_lbl, _a, _if["n"][_a], "  ".join(_cells)))
    sys.exit(0)

# ── tempo-BAND rotation (operator 2026-07-17: "итерации должны дышать по уровням — медленный слой /
# средний / разгон — а не крутить близкие грувы") ────────────────────────────────────────────────
# Combo-distance dedup is too weak on the s (tempo) axis alone: two recipes can differ enough overall
# to clear epsilon while s stays in ONE band (1.5→2.0→3.0 all FAST). So force s to CHANGE LEVEL —
# exclude the band(s) of the last 2 renders' s, so 3 successive grinds sweep slow/mid/fast. A
# PREFERENCE, not a hard wall: if no epsilon-clearing candidate avoids those bands, fall back to the
# nearest-ideal candidate — band rotation never manufactures a WALK-OUT.
def band_of_s(v):
    return "slow" if v <= 0.5 else ("mid" if v <= 1.25 else "fast")
ex_bands = set(band_of_s(r["s"]) for r in recent_heard[-2:] if "s" in r)

# ── the gate: nearest-to-ideal candidate that clears epsilon ─────────────────────────────────────
# Enumerate the whole space (6*8*7*4*6 = 8064 — trivial) and take the candidate that best fits the
# record's character among those far enough from recent history. Taste memory as a REPULSOR, not a
# template: the character says where to aim, history says where we may not land.
best, best_key = None, None              # nearest-ideal clearing epsilon (any band) — the fallback
best_b, best_b_key = None, None          # ... that ALSO lands in a fresh tempo band — preferred
# ... and the same two again, restricted to candidates that ALSO stand eps_failed from every recipe
# our own verdict rejected. Appropriateness is the OUTER preference and variety the inner one: given
# the choice, not returning to a hollow recipe outranks rotating the tempo band.
best_f, best_f_key = None, None
best_fb, best_fb_key = None, None
for fi, si, ssi, wi, ci in itertools.product(range(len(F_VALS)), range(len(S_VALS)),
                                             range(len(SS_VALS)), range(len(W_VALS)),
                                             range(len(C_VALS))):
    cand = {"f": fi, "s": si, "ss": ssi, "w": wi, "c": ci}
    md = min_dist(cand)
    if md < epsilon:
        continue
    # Three levels, same contract as nearest_ideal()'s: appropriateness first (never overruled),
    # then the mirror-descent marginal reward, then the recency distance we already had. When the
    # corpus is too thin epi_a is a constant 0.0 and this key IS the old two-level key.
    key = (ideal_dist(cand), -epi_a_key(cand), -md)
    fresh = band_of_s(S_VALS[si]) not in ex_bands
    if best_key is None or key < best_key:
        best, best_key = cand, key
    if fresh and (best_b_key is None or key < best_b_key):
        best_b, best_b_key = cand, key
    if clears_failed(cand):
        if best_f_key is None or key < best_f_key:
            best_f, best_f_key = cand, key
        if fresh and (best_fb_key is None or key < best_fb_key):
            best_fb, best_fb_key = cand, key

# Tier order: (failed-clear + fresh band) > (failed-clear) > (fresh band) > (nearest-ideal).
# `avoid` names which tier actually won, so the failed-epsilon can never be a preference that is
# assumed to bite — a run that reports `avoid=none` while the failed store is non-empty is the
# preference falling back, in the reading, at the moment it happens.
if best_fb is not None:
    best, best_key, avoid = best_fb, best_fb_key, "hard"
elif best_f is not None:
    best, best_key, avoid = best_f, best_f_key, "hard"
elif best_b is not None:
    best, best_key, avoid = best_b, best_b_key, ("soft" if failed else "none")
else:
    avoid = ("soft" if failed else "none")
if not failed:
    avoid = "none"          # an EMPTY rejected-store cannot be avoided hard; saying so would be a
                            # preference reporting a bite it never took (the vacuous-gate shape).
if best is None:
    print("WALKED-OUT no recipe clears epsilon=%.2f against the last %d renders + %d failed + %d worn-by-this-source" % (epsilon, len(recent), len(failed), len(worn)))
    sys.exit(0)

f, s, ss, w, c = (F_VALS[best["f"]], S_VALS[best["s"]], SS_VALS[best["ss"]],
                  W_VALS[best["w"]], C_VALS[best["c"]])
l = int(round(beat_ms * f / 10.0) * 10)
l = max(120, min(2000, l))          # the grainneukeln contract

# ── Grid B: mode + rv, character-derived and repelled the same way as f/s/ss/w/c above ───────────
b_pools, b_cat = B_POOLS, B_CAT   # one definition (used by the marginal report above too)
b_ideal = {"mode": pick2(MODE_VALS, p_act), "rv": pick2(REV_VALS, 1.0 - p_cent),
           "env": pick2(ENV_VALS, p_dyn)}
b_best = nearest_ideal(b_pools, b_cat, b_ideal, repel, epsilon, epi=epi_b)
mode = MODE_VALS[b_best["mode"]]
rv = REV_VALS[b_best["rv"]]
env = ENV_VALS[b_best["env"]]

# ── Grid C: each mode's own sub-params, conditioned on the mode Grid B just picked. Filtered to
# repel ONLY entries that were themselves that mode — a `lk` value from a `lib` render is not
# comparable to a `q` render that never had one, and comparing them would just be noise.
extra_toks = []
mode_repel = [r for r in repel if r.get("mode") == mode]
if mode == "q":
    # richer material can carry a real multi-bar groove; poor/flat material (rich near 0) gets the
    # plain single-bar euclid instead, so the recipe never implies structure the source lacks.
    if TIMELINE_NAMES and p_rich >= 0.5:
        ROT_POOL = list(range(12))
        t_pools = {"pat": TIMELINE_NAMES, "rot": ROT_POOL}
        t_cat = {"pat": True, "rot": False}
        t_ideal = {"pat": pick2(TIMELINE_NAMES, p_cent), "rot": pick2(ROT_POOL, p_dyn)}
        t_best = nearest_ideal(t_pools, t_cat, t_ideal, mode_repel, epsilon)
        extra_toks += ["pat", TIMELINE_NAMES[t_best["pat"]], "rot", str(ROT_POOL[t_best["rot"]])]
    else:
        # sorted by density (k/n) so busy material (high act) reaches for the denser end, the same
        # "busy wants more events" story `f` already tells via grain length.
        EUCLID = sorted([(3, 8), (5, 8), (2, 5), (7, 16), (4, 9), (5, 16), (3, 4), (7, 12)],
                         key=lambda kn: kn[0] / float(kn[1]))
        e_pools = {"euclid": EUCLID}
        e_cat = {"euclid": True}
        e_ideal = {"euclid": pick2(EUCLID, p_act)}
        e_best = nearest_ideal(e_pools, e_cat, e_ideal, mode_repel, epsilon)
        ek, en = EUCLID[e_best["euclid"]]
        extra_toks += ["ek", str(ek), "en", str(en)]
    # sw (swing %): only `q` ever reads it (docs/PARAMETERS.md) — never emit it for lib/poly, a
    # token nobody parses. Spectral movement rewards a swung feel, the same axis `w` already reads.
    SWING_VALS = [0, 33, 50, 66]
    sw_ideal = {"sw": pick2(SWING_VALS, p_move)}
    sw_best = nearest_ideal({"sw": SWING_VALS}, {"sw": False}, sw_ideal, mode_repel, epsilon)
    sw = SWING_VALS[sw_best["sw"]]
    # emitted unconditionally (even sw=0) — a deliberately-chosen "straight" must be recoverable
    # from the log for the next tick's repulsion, same reasoning as rv below.
    extra_toks += ["sw", str(sw)]
    # snap + rest-fill: q is the only mode that reads either (docs/PARAMETERS.md), and until
    # 2026-08-15 this lane emitted NEITHER, so every q render it ever shipped ran free-running with
    # a default-gain fill. Repelled against q renders only, like the other Grid-C picks.
    p_pools = {"snap": SNAP_VALS, "fill": FILL_VALS}
    p_cat = {"snap": True, "fill": True}
    p_ideal = {"snap": pick2(SNAP_VALS, 1.0 - p_move), "fill": pick2(FILL_VALS, 1.0 - p_act)}
    p_best = nearest_ideal(p_pools, p_cat, p_ideal, mode_repel, epsilon)
    if SNAP_VALS[p_best["snap"]]:
        extra_toks += ["snap"]
    # "nofill" is a bare flag, "fg -6" is a token pair — split() handles both, and the chosen value
    # is always emitted so the next tick's repulsion can see what was deliberately picked.
    extra_toks += FILL_VALS[p_best["fill"]].split()
elif mode == "lib":
    # timbrally rich material rewards staying IN its own cluster (`sim`, close-loop, recognizable);
    # poor/flat material is already mud, so jump clusters instead (`con`) looking for variety it
    # cannot get by staying put — the same "rich survives smear, poor doesn't" story `ss` tells.
    LPOL = ["sim", "con"]
    LK = [4, 6, 8, 10]
    l_pools = {"lpol": LPOL, "lk": LK}
    l_cat = {"lpol": True, "lk": False}
    l_ideal = {"lpol": pick2(LPOL, 1.0 - p_rich), "lk": pick2(LK, p_act)}
    l_best = nearest_ideal(l_pools, l_cat, l_ideal, mode_repel, epsilon)
    extra_toks += ["lib", LPOL[l_best["lpol"]], "lk", str(LK[l_best["lk"]])]
elif mode == "poly":
    # spectral movement picks the base stream ratio; a genuinely dynamic source (swells worth
    # layering against each other) earns a SECOND stream, everything else stays single.
    PR_VALS = [2, 3, 4, 5, 6]
    pr_ideal = {"pr1": pick2(PR_VALS, p_move)}
    pr_best = nearest_ideal({"pr1": PR_VALS}, {"pr1": False}, pr_ideal, mode_repel, epsilon)
    r1 = PR_VALS[pr_best["pr1"]]
    if p_dyn >= 0.66:
        PR2_VALS = [2, 3, 4]
        r2 = PR2_VALS[pick2(PR2_VALS, p_act)]
        pr = "%d;%d" % (r1, r2)
    else:
        pr = str(r1)
    extra_toks += ["pr", pr]

# NO `g auto`: config_automix parses m/s/ss/w/ek/en/pr/lib/lk/sw/fg/c/l and has NO `g` handler — the
# token is silently dropped (verified in cutter/sample_cut_tool.py). mesh-room-music removed the same
# dead append from its own pick_args on 2026-07-17 (the automixer loudness-normalizes the OUTPUT to
# -16 dBFS now, so gain lives upstream). Stamping it here only forged a "gain applied" trace into
# every params-log line while doing nothing. (NB: mesh-grind-params.py's `d` token is the SAME dead
# append under a different name — config_automix never reads "d" either — so it is deliberately not
# copied here even though that script emits it.)
toks = ["amc", "l", str(l), "w", str(w), "ss", str(ss), "s", str(s)]
if c:
    toks += c.split()
toks += ["m", mode] + extra_toks
# rv emitted unconditionally (even 0.0) — see parse_recent's rv comment: a deliberately-chosen "stay
# dry" must be recoverable from the log, or the next tick's repulsion cannot tell it from history
# that simply predates this feature.
toks += ["rv", str(rv)]
# env emitted unconditionally (even env 0 = deliberately hard edges), same recoverability reasoning
# as rv/sw above: a chosen extreme must be distinguishable in the log from a tick that predates the
# axis existing, or the next tick's repulsion reads "absent" as "never chosen".
toks += ["env", str(env)]
args = " ".join(toks)
# The basis is PUBLISHED IN THE READING, not left to be inferred (CLAUDE.md: "publish the coverage
# IN the reading, so a consumer can never mistake the narrow claim for the wide one"). `axes` names
# the fold every axis actually got — a uniform one collapses to a single word, a mixed one lists the
# odd axes out, so "the f corpus was too thin on cent alone" can never read as a clean blend.
_ab = sorted(set(BASIS.values()))
_axes_basis = _ab[0] if len(_ab) == 1 else ",".join("%s:%s" % (a, BASIS[a]) for a in
                                                    ("dyn", "act", "rich", "move", "cent"))
# `novelty` is best_key[2], NOT [1]: the key grew a level (the marginal reward) UNDER the
# pragmatic term, and reading the old index would have silently republished the epistemic marginal
# under the column every consumer parses as the recency distance — two populations in one column.
# `worn` is the RE-PICK wall, published as a column so the caller gates on a measured number and the
# same number is auditable in the params log afterwards. It is min_dist restricted to the worn store,
# by the SAME dist() the repellent uses — never a second metric that can rot apart from it. Three
# distinct readings, because they have three distinct causes and only one is a distance:
#   <float> — the primary-axis distance to the nearest recipe this source already wore
#   none    — no worn store was passed (every ordinary derive) or it held no recipe at all
#   na      — a store WAS passed and nothing in it is comparable (dist abstains below 2 shared axes).
# `na` must never read as "far away": that is the blindness-as-a-reading trap, and repick_gate
# refuses on it exactly as it refuses on a collision.
_wd = [d for d in (dist(best, _p) for _p in worn) if d is not None]
worn_col = ("%.2f" % min(_wd)) if _wd else ("na" if worn else "none")
print("RECIPE %s ~ beat %d f %s band %s fit %.2f novelty %.2f mode %s cov %s basis %s/%s avoid %s/%.2f epi %s worn %s"
      % (args, int(beat_ms), f, band_of_s(s), best_key[0], -best_key[2], mode,
         "na" if cov is None else "%.3f" % cov, _axes_basis, beat_basis, avoid, eps_failed,
         ("%s/%s%s" % (("%.2f" % epi_a(best)) if marg_note == "md" else marg_note,
                       ("%.2f" % _epi_b_raw(b_best)) if marg_b_note == "md" else marg_b_note,
                       "" if MARG_RANK else "(off)")), worn_col))
PYEOF
}

# ── notable: the only things worth a paid turn ───────────────────────────────────────────────────
poke(){  # $1 why  $2 body
  local why="$1" body="$2"
  # TEST-SANDBOX gate — the same contract mesh-tg has carried since 2026-07-02, which this tool was
  # missing entirely: mesh-doctor exports MESH_TEST_SANDBOX=1 around every child --test, so any test
  # path reaching poke() fires a REAL mesh-tell into the live sound window. Demonstrated the hard way
  # 2026-07-15 while testing this very function — two "[sound-reflex: starved] body" payloads landed
  # in the channel. Suppressed BEFORE any side effect (no notable line, no lastpoke stamp, no tell);
  # exit 0 = "intentionally not delivered", mesh-tg's convention.
  if [ "${MESH_TEST_SANDBOX:-0}" = 1 ]; then
    echo "mesh-sound-reflex: MESH_TEST_SANDBOX — poke SUPPRESSED ($why)" >&2
    return 0
  fi
  # The OPERATOR-DROP CLASS must reach the mind even mid-cooldown — a drop is the operator's own gesture
  # and he is waiting to HEAR the result: `drop` (it landed and is grinding), and the two ship-verdicts
  # of that same drop, `not-a-song` (withheld as mud) and `unverified` (shipped without a listen). The
  # parent tick fires `drop` first, stamping LASTPOKE, so without this the child's ship-verdict poke would
  # be swallowed by its own drop poke — the operator drops a track, gets nothing, and no reason. Everything
  # else is ambience and can wait for the next window; with a continuous ear, poking per render would burn
  # a paid turn per record.
  # Returns non-zero when the cooldown SUPPRESSES the poke, so an edge-triggered caller (starve_check) can
  # tell "delivered" from "swallowed" and retry instead of consuming its transition. Level-triggered
  # callers ignore the status, as they always have.
  case "$why" in
    drop|not-a-song|unverified|undelivered) : ;;   # operator-drop class — never cooldown-gated
      # `undelivered` joined 2026-08-17. It is the third ship-verdict of a drop the operator is
      # waiting on, and the one with NO retry driver behind it — swallowed by the cooldown it is lost
      # outright, which is precisely the "drops a track, gets nothing, and no reason" case above.
    *)
      local age; age=$(( $(now) - $(last_poke) ))
      [ "$age" -lt "$POKE_COOLDOWN" ] && return 1 ;;
  esac
  now > "$LASTPOKE"
  # NOTABLE IS THE DELIVERED-POKE LOG, AND IT IS WRITTEN ONLY ONCE THE COOLDOWN HAS LET THE POKE
  # THROUGH. It used to be written ABOVE the cooldown gate, so a SWALLOWED poke left a line
  # indistinguishable from one the mind was actually told — the pane's "what the grinder wanted
  # judgement on" surface, and a mind's own record of what it was woken for, both counting pokes
  # that never happened (8 outlier lines logged 03:30-06:10, only 4 delivered). Same family as
  # mesh-guardian's dry-run writing the real guardian.log: an artifact that cannot tell a real
  # event from a suppressed one is not evidence.
  printf '%s [%s] %s\n' "$(ts_utc)" "$why" "$(printf '%s' "$body" | head -1)" >> "$NOTABLE"
  tail -n 60 "$NOTABLE" > "$NOTABLE.tmp" 2>/dev/null && mv "$NOTABLE.tmp" "$NOTABLE"
  command -v mesh-tell >/dev/null 2>&1 || return 0
  mesh-tell sound "[sound-reflex: $why] $body
--
Your call. The grind lane is reflexive and keeps running without you — act only if this actually wants judgement (a recipe worth pinning, a source worth a real render, a gate worth re-tuning). Otherwise stay quiet; don't narrate." >/dev/null 2>&1
}

# inbox_note — pure (reads $MESH/inbox + the seen-store, touches nothing, prints one sentence).
# Split out of starve_check (2026-07-28) so THIS claim can be gated by --test on its own: the whole
# function needs a live mesh-room-music --diversity call to reach the starved branch at all, which
# made the inbox sentence untestable in isolation and is exactly why the 2026-07-21 "false poke fix"
# itself went unnoticed for a week — nothing ever drove it red.
#
# LIVE INBOX CLAIM (2026-07-21 false poke fix): this used to hardcode "the operator's own intake is
# wired and empty" regardless of reality — caught live when ~/.mesh/inbox held ~40 real mp3s while
# the poke asserted it was empty. Count the actual audio files (same extension set mesh-records' drop
# organ globs / mesh-dash's INBOX panel use: aac/oga/m4a/wav/mp3) and make the sentence conditional on
# what's really there, so the claim tracks the artifact instead of prose.
#
# 2026-07-28: that fix was STILL a false alarm generator, just a slower one. mesh-records never
# evicts an inbox file after archiving it (see bg_register_drop's own "never gets evicted" comment
# elsewhere in this file) — inbox is a permanent write-once archive, not a queue. So a RAW file count
# only ever grows, and once the operator has ever dropped more than a handful of tracks this branch
# fired "may not be reaching them" FOREVER, on every future starved transition, regardless of whether
# anything is actually stuck. Measured live: 98 inbox files, ALL 98 already in mesh-records' SEEN
# store (content-hash dedupe) — zero real backlog, the poke was accusing a healthy pipeline. Count
# only files whose content hash is NOT yet in mesh-records' own seen-index — the same key
# mesh-records itself dedupes on, so "unseen" here means the same thing it means there, not a second
# guess at a different signal.
inbox_note(){
  local seen_store n unseen f fh
  seen_store="${MESH_REC_SEEN:-$MESH/.records-seen}"
  n=0; unseen=0
  for f in "$INBOX_DIR"/*.aac "$INBOX_DIR"/*.oga "$INBOX_DIR"/*.m4a "$INBOX_DIR"/*.wav "$INBOX_DIR"/*.mp3; do
    [ -f "$f" ] || continue
    n=$((n+1))
    fh="$(sha1sum "$f" 2>/dev/null | cut -c1-8)"
    [ -n "$fh" ] && grep -qxF "$fh" "$seen_store" 2>/dev/null || unseen=$((unseen+1))
  done
  if [ "$n" -eq 0 ]; then
    echo "The operator's own intake is wired and empty: drop a real track into ~/.mesh/inbox and it outranks the ear, grinds first, and never gets evicted."
  elif [ "$unseen" -eq 0 ]; then
    echo "The operator's intake ~/.mesh/inbox holds ${n} track(s), all already archived (mesh-records' seen-index) — no real backlog, this is the room's own tone, rotated."
  else
    echo "The operator's intake ~/.mesh/inbox holds ${n} track(s), ${unseen} of them NOT yet in mesh-records' seen-index — the lane may not be reaching those (check mesh-records' drop organ / MAX_PER_SWEEP)."
  fi
}

# starve_check — the ORGAN-MIX invariant (2026-07-15, the operator's "diverse music production" ask
# read through bruno's autonomy doctrine: a reflex senses an invariant and wakes the mind only when
# it BREAKS, to fix the sense rather than to grind more of the same).
#
# EDGE-triggered on purpose. Starvation is a STANDING condition, not an event: the lane has eaten
# `ear` alone since it went live, so a level-triggered poke would burn a paid turn every 5 minutes
# forever, restating a fact the pane already shows — the exact alarm-fatigue the poke cooldown
# exists to prevent. The pane carries the standing state (SOURCES block); the mind is woken only on
# the TRANSITION, which is the only part that is news. Recovery (starved -> healthy) is news too:
# it tells the mind a source it fixed actually took.
starve_check(){
  command -v mesh-room-music >/dev/null 2>&1 || return 0
  local out now_state prev
  out="$(MESH_RMC_PARAMS_LOG="$PARAMS_LOG" mesh-room-music --diversity 2>/dev/null)" || true
  # --diversity has FOUR "ok" flavours and only two of them are health. The other two are explicit
  # ABSTENTIONS — "too few lane render(s) to judge" and "no lane renders ... not the reflex lane" —
  # and a bare *"diversity: ok"* glob collapsed all four into `healthy`. On 2026-08-17 that fired an
  # "unstarved" poke whose own body read "Organ mix recovered: ok — too few lane render(s) to
  # JUDGE": a paid turn announcing a recovery nobody measured, 30 minutes after a real starve edge.
  # Worse than the noise, it COMMITS healthy into $STARVED, consuming the starved edge — so the lane
  # flaps starved<->healthy as renders age in and out of the 7-render window with no material change.
  # A verdict that declines to judge is UNKNOWN and must move nothing (honest-fusion rule: an
  # undeterminable input renders unknown, never a faked all-clear).
  case "$out" in
    *SOURCE-STARVED*)        now_state=starved ;;
    *"to judge"*)            now_state=unknown ;;
    *"not the reflex lane"*) now_state=unknown ;;
    *"diversity: ok"*)       now_state=healthy ;;
    *)                       now_state=unknown ;;   # MONOTONE / unparseable — also not a verdict
  esac
  prev="$(cat "$STARVED" 2>/dev/null)"
  # mtime = liveness on EVERY eval (the conditional-write false-STALE convention); the CONTENT is the
  # edge state and is committed ONLY once the poke actually lands — see below. Touch BEFORE the
  # unknown bail: an abstention is still a live evaluation, and skipping the touch would age the
  # artifact into a false STALE while the reflex is running fine.
  touch "$STARVED" 2>/dev/null || true
  # UNKNOWN never transitions, never pokes, and never overwrites the last real verdict.
  [ "$now_state" = unknown ] && return 0
  [ "$now_state" = "$prev" ] && return 0
  # First-ever eval with a healthy mix is not a recovery — nothing broke. Adopt the state silently,
  # or the reflex greets its own install with an "it's fixed!" poke.
  if [ -z "$prev" ] && [ "$now_state" = healthy ]; then
    printf '%s\n' "$now_state" > "$STARVED" 2>/dev/null || true; return 0
  fi
  # Commit the edge ONLY if the poke was really delivered. poke() returns non-zero when the cooldown
  # swallows it — persisting regardless would consume the transition and lose the alert for good
  # (the edge never comes back). Unpersisted, the next tick simply re-detects and retries.
  # Both messages used to RECITE the 2026-07-15 assumption that the starving organ is always `ear`:
  # "Non-ear organs have contributed nothing (N non-ear records ever ground)" — a sentence whose own
  # embedded count refutes it (it read "contributed nothing (230 ... ever ground)"), and which is
  # flatly wrong when the dominant organ IS non-ear. It fired that way on 2026-08-17 while `drop`
  # held 4/4 of the lane, telling the mind to go find non-ear material during an operator drop
  # burst. --diversity already NAMES the dominant organ; derive from it instead of reciting.
  local dom others sibs
  dom="$(printf '%s' "$out" | sed -n 's/.*SOURCE-STARVED[^a-z]*\([a-z0-9_-]\{1,\}\) is [0-9]\{1,\}\/.*/\1/p')"
  # SAME-SOURCE organs (2026-08-19) — --diversity now names the organs that share the dominant
  # organ's PHYSICAL source. They are not alternatives: listing `scape 62` beside a starving `ear`
  # sent the mind hunting for material rotation that cannot exist, because on this node both are the
  # one USB camera mic. Exclude them from the "what else has ever reached the grinder" answer, so it
  # only ever names material that genuinely comes from somewhere else.
  sibs="$(printf '%s' "$out" | sed -n 's/.*· same-source: \([a-z0-9_,-]*\).*/\1/p')"
  case "$now_state" in
    starved)
      # what ELSE has ever reached the grinder, per organ — the actionable fact, measured now.
      # SUPPLY IS COUNTED SEPARATELY FROM GRINDING (2026-08-21). This gated on `/-> ground:/`
      # alone, so an organ feeding the archivist steadily whose every record the picker rejects
      # produced no key and vanished from the sentence entirely — ABSENT, not "0" — while the
      # sentence is handed to the mind as the answer to "where else is there material". That
      # inverts the most actionable case into silence: the material IS arriving and the PICKER is
      # refusing it, which is a different fix from "nothing else feeds us". Live: note3 (the
      # Note3's slrec ear, this lane's only physically independent mic) held 200 wavs and 200
      # measured rows, 0 ground, and every starved poke read "drop 170" without ever naming it.
      # Iterate the SUPPLY keys and carry ground as a value, so a never-picked organ renders
      # "note3 0 of 200 supplied — measured, never picked". Sorted by name so the sentence is
      # stable across runs (awk for-in is unordered).
      #
      # AND EVERY COUNT CARRIES ITS SUPPLY AGE (2026-08-21, the same day the supplied clause
      # landed). The clause above fixed an ABSENCE and replaced it with a confident wrong answer:
      # it counts LIFETIME rows out of a ledger that OUTLIVES THE AUDIO, then hands the total to
      # the mind as the answer to "where else can I get material RIGHT NOW". Live on this node the
      # same morning: `note3 0 of 200 supplied — measured, never picked` read as a live independent
      # mic the picker is refusing, and it is not one — all 200 rows landed inside a single day
      # (2026-08-20T00:52..10:28Z), nothing since, and 0 note3 wavs remain on disk. A source that
      # DIED 23h ago is indistinguishable from a source being REFUSED, and the two have opposite
      # fixes: re-tune the gate vs. go restart the organ. Sibling of the shape the comment above
      # already names — that fix reported the picker's bookkeeping as a fact about the world, this
      # one reports the ledger's HISTORY as a fact about the world's PRESENT. So: no count without
      # its clock. An unparseable timestamp renders UNKNOWN, never a fake freshness (honest-fusion).
      others="$(awk -v d="${dom:-__none__}" -v sb=",${sibs}," \
                    -v now="$(date -u +%s)" -v fresh="${SR_SUPPLY_FRESH:-21600}" '
        function ep(t){ if(t !~ /^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}/) return 0
                        return mktime(substr(t,1,4)" "substr(t,6,2)" "substr(t,9,2)" " \
                                      substr(t,12,2)" "substr(t,15,2)" 00", 1) }
        function ago(s){ if(s<0) s=0
                         if(s<3600)  return sprintf("%dm", int(s/60))
                         if(s<86400) return sprintf("%dh%02dm", int(s/3600), int((s%3600)/60))
                         return sprintf("%dd%dh", int(s/86400), int((s%86400)/3600)) }
        $2!=d && index(sb,","$2",")==0 { s[$2]++; if (/-> ground:/) g[$2]++
                                         if($1>last[$2]) last[$2]=$1 }
        END{ n=0
             for(o in s) k[++n]=o
             for(i=1;i<n;i++) for(j=i+1;j<=n;j++) if(k[j]<k[i]){t=k[i];k[i]=k[j];k[j]=t}
             for(i=1;i<=n;i++){ o=k[i]
               # membership FIRST: referencing g[o] in the printf auto-vivifies the key, so
               # `o in g` tested afterwards is ALWAYS true and the supplied clause never renders
               # (seen: "note3 0" with the count silently dropped).
               ever=(o in g); c=(ever?g[o]:0)
               e=ep(last[o]); a=(e ? now-e : -1)
               printf "%s%s %d", (i>1?", ":""), o, c
               if(!ever) printf " of %d supplied — measured, never picked", s[o]
               if(a<0)          printf " (supply age UNKNOWN — no parseable timestamp)"
               else if(a<=fresh) printf " (last supplied %s ago%s)", ago(a), \
                                        (ever ? "" : " — LIVE, so the PICKER is refusing it and the gate is the fix")
               else              printf " (SILENT %s%s)", ago(a), \
                                        (ever ? "" : " — the SOURCE stopped, so re-tuning the picker buys nothing") }
             if(!n) printf "none" }' "$LEDGER" 2>/dev/null)"
      poke "starved" "The lane is eating ONE SOURCE: ${out#diversity: }. Param rotation is fine — that axis was never the problem; the MATERIAL is. Every organ from a DIFFERENT physical source, ground total: ${others:-none}${sibs:+ (excluded — ${sibs} share the dominant organ device, so they are not alternatives)}. $(inbox_note) Otherwise this is ${dom:-that organ}'s own tone, rotated." \
        && printf '%s\n' "$now_state" > "$STARVED" 2>/dev/null || true ;;
    healthy)
      poke "unstarved" "Source mix recovered: ${out#diversity: }. A genuinely different PHYSICAL source is reaching the grinder again — this verdict is on the device axis now, so two organs sharing one mic can no longer read as recovery." \
        && printf '%s\n' "$now_state" > "$STARVED" 2>/dev/null || true ;;
  esac
}

# verdict <hash> <verdict> — rewrite this record's ledger verdict in place.
#
# EXCEPT for a RE-PICK. SR_REMIX_OF is exported across launch_grind (the detached child re-execs
# "$0 --verdict", a fresh process, and inherits it), and while it is set this function writes to the
# re-pick book instead of the ledger. The ledger row is the ARCHIVIST's account of the ORIGINAL find
# — `ground:<that file>` — and a remix rewriting it would (a) destroy the record of what the source
# first ground to and (b) make an old source read as freshly ground, which is precisely the shape of
# the eviction bug this lane exists to replace honestly. "Ships marked as a remix, never as a new
# find" is not a caption convention; it is this branch.
verdict(){
  local h="$1" v="$2"
  if [ -n "${SR_REMIX_OF:-}" ]; then
    printf '%s remix %s %s\n' "$(ts_utc)" "$h" "$v" >> "$REPICK_LOG" 2>/dev/null || true
    # A terminal verdict releases the lane. The lease ALSO carries a deadline (see repick_inflight),
    # so a child that dies before any verdict cannot wedge the lane forever — clear-on-verdict is the
    # fast path, the deadline is the floor.
    case "$v" in ground:*|skip:*|held:*) rm -f "$REPICK_LEASE" 2>/dev/null || true ;; esac
    return 0
  fi
  [ -f "$LEDGER" ] || return 0
  awk -v h=" $1 " -v v="$2" '
    index($0, h) && /-> /{ sub(/-> .*$/, "-> " v) } {print}
  ' "$LEDGER" > "$LEDGER.tmp" 2>/dev/null && mv "$LEDGER.tmp" "$LEDGER"
}

kvof(){ grep -oE "(^| )$1=[^ ]+" <<<"$2" | head -1 | cut -d= -f2; }

# failed_recipe <h> <args ~ meta> — append a render-failed recipe to the FAILED repellent store.
# Called from the DETACHED grind child at the hollow/degenerate verdict sites (via `$self --failed`,
# so the path resolves here, env-respecting, not inside the single-quoted child). The line keeps the
# `amc ... ~ beat N f X` shape parse_recent already reads, so the failed combo repels the next
# derivation exactly like a shipped one.
failed_recipe(){
  printf '%s %s %s\n' "$(ts_utc)" "$1" "$2" >> "$FAILED_LOG"
  tail -n 40 "$FAILED_LOG" > "$FAILED_LOG.tmp" 2>/dev/null && mv "$FAILED_LOG.tmp" "$FAILED_LOG"
}

# ── COMPLETING DEFICIENCIES — the ACTING half (2026-08-19) ───────────────────────────────────────
# mesh-song-verify classifies a reject into axes a bounded post-process could bring up to standard
# (`rework=dead-gaps(...,trim-near-silent)`) and axes where the deficiency is in the transformation
# itself. That classification has been REPORT-ONLY since 2026-08-14 — it named a candidate and
# nothing ever completed it, so 4 of 10 discards were renders binned for the one axis a trim can move.
# The operator was asked (he is the one whose TG it lands in) and answered 2026-08-19T10:30:59Z:
# «включаем "подрезать -> перепроверить -> отправить, если прошло"». This is that trim.
#
# It is ONLY the trim. The artifact is the RE-VERIFY, never the rework= tag: the tag is a HYPOTHESIS
# that removing the dead air would clear the axis (mesh-song-verify:62-67 says exactly this), and a
# trimmed render can clear dead-gaps and still fail a different axis — live case 3bc762d1, silent
# 0.33 (well inside the 0.50 band) and arrhythmic at the same time. So the caller re-runs the FULL
# verify on the trimmed file and ships on THAT rc, never on the fact that a trim happened.
#
# THRESHOLD COUPLING: song-verify calls a frame near-silent at `rms < 0.02 * max(rms)` — a RELATIVE
# floor, 20*log10(0.02) = -34dB below the render's own peak. ffmpeg's silenceremove threshold is
# ABSOLUTE, so a fixed -50dB would be a different criterion wearing the same word: it would leave
# spans song-verify still counts as silent on a quiet render, and eat real material on a hot one.
# Measure the peak first (volumedetect) and put the gate exactly SR_TRIM_HEADROOM_DB below it, with
# detection=rms because that is the statistic song-verify frames on. A trim aimed at a different
# floor than the gate that judges it would fail the re-verify for reasons no log would explain.
TRIM_HEADROOM_DB="${SR_TRIM_HEADROOM_DB:-34}"  # dB below PEAK that counts near-silent (= song-verify 0.02)
TRIM_MIN_GAP="${SR_TRIM_MIN_GAP:-0.20}"        # s — a dip shorter than this is phrasing, not dead air

# trim_near_silent <in> <out> -> 0 wrote a trimmed file · 3 could not trim (ffmpeg absent, unreadable
# input, undeterminable peak, ffmpeg failed, empty result). NEVER 1: this tool makes no quality claim
# — "the trim ran" is not "the render is a song", and only mesh-song-verify may say the latter.
trim_near_silent(){
  local in="$1" out="$2" peak thr
  command -v ffmpeg >/dev/null 2>&1 || return 3
  [ -s "$in" ] || return 3
  peak="$(ffmpeg -hide_banner -nostdin -i "$in" -af volumedetect -f null - 2>&1 \
          | sed -n "s/.*max_volume: *\(-\?[0-9.]*\) dB.*/\1/p" | head -1)"
  # -inf / empty (a wholly silent or undecodable file) is not a peak: refuse rather than invent one.
  case "$peak" in ''|*[!0-9.+-]*|-|.) return 3 ;; esac
  thr="$(awk -v p="$peak" -v h="$TRIM_HEADROOM_DB" 'BEGIN{printf "%.1f", p-h}')"
  ffmpeg -y -hide_banner -nostdin -i "$in" -af \
    "silenceremove=start_periods=1:start_duration=0:start_threshold=${thr}dB:stop_periods=-1:stop_duration=${TRIM_MIN_GAP}:stop_threshold=${thr}dB:detection=rms" \
    "$out" >/dev/null 2>&1 || { rm -f "$out"; return 3; }
  [ -s "$out" ] || { rm -f "$out"; return 3; }
  return 0
}

# beat_of <win> <dur> <beats> -> beat period ms (250..1200), 500 when honestly undeterminable.
# PURE (so --test can pin the category error that made this necessary). `beats` is counted over the
# analyzer's WINNING WINDOW, so the period is win/beats. Using the FILE duration instead yields
# ~3600ms for an 18s record, falls outside the detector's honest range, and silently takes the 500
# fallback — flattening l = beat x f to a constant across every render. `dur` is only a fallback for
# pre-`win` ledger lines.
# drop_age_note <record> -> the clause saying whether a drop is a fresh gesture or backlog ingest.
# Its own function so the --test leg drives THIS code and not a copy of it: a gate asserting a
# reimplementation stays green when the shipped clause is deleted, which is no gate at all.
drop_age_note(){
  local _mage
  _mage=$(( ( $(date +%s) - $(stat -c %Y "$1" 2>/dev/null || date +%s) ) / 86400 ))
  if [ "$_mage" -le 1 ] 2>/dev/null; then printf 'recorded today — a fresh gesture'
  else printf 'material is %sd old (backlog ingest, not a same-day gesture — the file only reached the corpus now)' "$_mage"; fi
}

beat_of(){
  local w="${1:-}" d="${2:-0}" b="${3:-0}" src
  case "$w" in ''|'?') src="$d" ;; *) src="$w" ;; esac
  awk -v d="${src:-0}" -v b="${b:-0}" 'BEGIN{
    if (b+0 < 1 || d+0 <= 0) { print 500; exit }
    v = d / b * 1000; if (v < 250 || v > 1200) v = 500; printf "%d", v }'
}


# ── THE RE-PICK LANE (task repick-lane-2026-08-21) ───────────────────────────────────────────────
# Runs on an IDLE tick only, and only after retry_timeouts has passed: repairing a record whose grind
# actually failed outranks manufacturing diversity out of one that already succeeded. Everything
# below is bounds — see the REPICK_* block at the top for why the caps ARE the design.

# repick_count <h> — how many re-picks this source has already been GIVEN (launched), for its
# lifetime. Counts `pick` rows, never `remix` verdict rows: a grind that launched and then failed
# still spent an attempt, and refunding it would let one source loop on a recipe that cannot render.
repick_count(){ awk -v h="$1" '$2=="pick" && $3==h {n++} END{print n+0}' "$REPICK_LOG" 2>/dev/null || echo 0; }

# repick_worn <h> <outfile> — every recipe this source has already worn, in a form parse_recent reads.
# THREE stores, and the third is not optional: mesh-room-music appends the params log only on SHIP,
# so a remix whose render came out hollow leaves NO params line, and a store built from the params
# log alone would offer that same recipe again on the next re-pick. The failed store covers the
# hollow/degenerate verdicts, and our own `pick` rows cover the rest (a render still in flight, a
# send that never landed, a mesh-room-music that logged nothing).
repick_worn(){
  local h="$1" out="$2"
  { grep -F -- "/$h " "$PARAMS_LOG" 2>/dev/null || true
    awk -v h="$h" '$2==h' "$FAILED_LOG" 2>/dev/null || true
    awk -v h="$h" '$2=="pick" && $3==h' "$REPICK_LOG" 2>/dev/null || true
  } > "$out"
}

# repick_inflight — is a remix grind running right now? A remix writes NO `-> grinding` to the ledger
# (that is the whole point of verdict()'s remix branch), so the ledger check retry_timeouts uses is
# structurally blind to it and this lane needs its own. Lease = deadline + hash; a dead child cannot
# wedge the lane past the deadline, and a live one is never double-launched.
repick_inflight(){
  local dl; dl="$(awk '{print $1}' "$REPICK_LEASE" 2>/dev/null)"
  case "${dl:-}" in (''|*[!0-9]*) return 1 ;; esac
  [ "$(now)" -lt "$dl" ] && return 0
  rm -f "$REPICK_LEASE" 2>/dev/null || true
  return 1
}

repick_has_worn(){
  local h="$1"
  grep -qF -- "/$h " "$PARAMS_LOG" 2>/dev/null && return 0
  awk -v h="$h" '$2==h{found=1} END{exit !found}' "$FAILED_LOG" 2>/dev/null && return 0
  awk -v h="$h" '$2=="pick" && $3==h{found=1} END{exit !found}' "$REPICK_LOG" 2>/dev/null && return 0
  return 1
}

# repick_attempted <h> — when this source was last TRIED (launched or refused), 0 for never. The
# lane needs this, and finding out the hard way was worth the tick it cost: on the first live run
# (2026-08-21T06:13Z) it derived the five oldest eligible drops, refused all five on the recipe wall,
# and would have derived those SAME five on every subsequent idle tick forever — a refusal changes
# neither the re-pick count nor the ledger order, so the head of a 211-source pool becomes a
# permanent gate on the 206 behind it. The sweep must move whether or not the attempt succeeded.
repick_attempted(){
  awk -v h="$1" '$3==h { for(i=1;i<=NF;i++) if($i ~ /^at=/){ split($i,a,"="); t=a[2] } } END{print t+0}' \
      "$REPICK_LOG" 2>/dev/null || echo 0
}

# repick_pool — the whole pool with a state per source, oldest ground row first. Read-only: this is
# what --repick prints and what repick_once selects from, so the pane and the act can never disagree
# about who was eligible. One row per SOURCE (the newest ground row wins), because the pool is a set
# of sources, not of ledger lines.
#   <hash> <organ> n=<k> eligible|refused:<why>
repick_pool(){
  [ -f "$LEDGER" ] || return 0
  local h organ n st
  awk '/ -> ground:/{ org[$3]=$2; ord[$3]=NR } END{ for(k in ord) printf "%d %s %s\n", ord[k], k, org[k] }' \
      "$LEDGER" 2>/dev/null | sort -n | while read -r _ h organ; do
    n="$(repick_count "$h")"
    if ! ls "$REC_DIR"/*-"$h".* >/dev/null 2>&1; then
      # The source file is gone. This is the ordinary end of a record's life (the organs prune their
      # own audio) and NOT a fault — a re-pick needs the material, not the row.
      st="refused:evicted"
    elif [ "$n" -ge "$REPICK_MAX" ] 2>/dev/null; then
      st="refused:cap(n=$n>=$REPICK_MAX)"
    elif ! repick_has_worn "$h"; then
      # No recipe on record for a row that says it GROUND is a store gap, not a green light: with
      # nothing to be repelled from, the "remix" could reproduce the render he already has and no
      # measurement here would notice. Refuse and say which absence did it.
      st="refused:no-worn-recipe"
    else
      st="eligible"
    fi
    printf '%s %s n=%s %s\n' "$h" "$organ" "$n" "$st"
  done
}
# repick_gate <worn-column> — may this remix ship? PURE (the reason it is its own function: the
# --test drives every edge of it directly, and the wired leg then proves it is ON the path). Prints
# the refusal word on stdout, rc 1 to refuse.
#
# The two non-numeric readings refuse for the same reason the numeric one does, and it is worth
# naming: `na`/`none` mean we could not MEASURE the distance to what he already heard. A gate that
# passes on an unmeasurable input is a gate that reports its own blindness as an all-clear — the
# honest-fusion rule, and here it would ship exactly the duplicate this lane exists not to ship.
repick_gate(){
  case "${1:-}" in
    ''|none) echo "refused:worn-unreadable(no recipe on record for this source — nothing to be different FROM)"; return 1 ;;
    na)      echo "refused:worn-incomparable(every worn recipe shares <2 readable axes with the derived one, so the distance abstains — an unmeasured wall is not a cleared one)"; return 1 ;;
  esac
  case "$1" in (*[!0-9.]*|'') echo "refused:worn-unparseable($1)"; return 1 ;; esac
  awk -v d="$1" -v e="$REPICK_EPS" 'BEGIN{exit !(d+0 < e+0)}' \
    && { echo "refused:recipe-collision(worn $1 < $REPICK_EPS — the remix lands where this source has already been)"; return 1; }
  return 0
}

# repick_once — ONE re-pick, or none. Returns 0 always (an idle tick that re-picks nothing is not an
# error). Every refusal is written to the re-pick book with its own word, so "the lane produced
# nothing" is always distinguishable from "the lane was never asked".
REPICK_TRIES="${SR_REPICK_TRIES:-5}"
repick_once(){
  [ "${SR_REPICK:-1}" = 0 ] && return 0
  [ -f "$LEDGER" ] || return 0
  repick_inflight && return 0
  # Cooldown: lane-wide, read from the book's own last `pick` (never a file mtime — the detached
  # child appends `remix` rows to this same file and would keep moving an mtime-based clock).
  local last_at
  last_at="$(awk '$2=="pick"{ for(i=1;i<=NF;i++) if($i ~ /^at=/){ split($i,a,"="); t=a[2] } } END{print t+0}' \
             "$REPICK_LOG" 2>/dev/null)"
  if [ "${last_at:-0}" -gt 0 ] 2>/dev/null && [ $(( $(now) - last_at )) -lt "$REPICK_COOLDOWN" ]; then
    return 0
  fi
  # Fewest re-picks first, then oldest ground row (sort -s keeps the pool's ledger order inside a
  # tie) — so the lane spreads across the pool instead of wearing one source to its cap.
  local cands tries=0
  # Three keys, in this order: fewest re-picks (spread the spend), then LEAST-RECENTLY-ATTEMPTED
  # (never-tried = 0 = first, so the lane sweeps the pool instead of re-deriving the same head every
  # ten minutes — see repick_attempted), then the pool's own ledger order inside a tie (sort -s).
  cands="$(repick_pool | awk '$4=="eligible"{ sub(/^n=/,"",$3); print $3, $1, $2 }' \
           | while read -r _n _h _o; do printf '%s %s %s %s\n' "$_n" "$(repick_attempted "$_h")" "$_h" "$_o"; done \
           | sort -s -n -k1,1 -k2,2 | awk '{print $1, $3, $4}')"
  [ -n "$cands" ] || return 0
  local n h organ rline src wornf r args meta wd why cap prev mf deliver
  wornf="$(mktemp "${TMPDIR:-/tmp}/.sound-repick-worn.XXXXXX")" || return 0
  while read -r n h organ; do
    [ -n "$h" ] || continue
    tries=$((tries+1)); [ "$tries" -gt "$REPICK_TRIES" ] && break
    src="$(ls "$REC_DIR"/*-"$h".* 2>/dev/null | head -1)"
    [ -n "$src" ] || continue
    rline="$(awk -v h="$h" '$3==h && / -> ground:/{l=$0} END{print l}' "$LEDGER" 2>/dev/null)"
    [ -n "$rline" ] || continue
    repick_worn "$h" "$wornf"
    # The SAME derivation the first grind got, plus this source's own history in the repellent. Not a
    # different engine and not a hand-picked recipe: the operator hand-picked HIS three by ear, and a
    # reflex that guessed at that would be inventing taste. What it can honestly do is re-derive with
    # more history than the first pass had.
    local beats dur win dyn act rich move cent cov fbeats fdyn fact frich fmove fcent beat_ms fbeat_ms
    beats="$(kvof beats "$rline")"; dur="$(kvof dur "$rline")"; win="$(kvof win "$rline")"
    dyn="$(kvof dyn "$rline")"; act="$(kvof act "$rline")"; rich="$(kvof rich "$rline")"
    move="$(kvof move "$rline")"; cent="$(kvof cent "$rline")"
    cov="$(kvof cov "$rline")"; fbeats="$(kvof fbeats "$rline")"
    fdyn="$(kvof fdyn "$rline")"; fact="$(kvof fact "$rline")"; frich="$(kvof frich "$rline")"
    fmove="$(kvof fmove "$rline")"; fcent="$(kvof fcent "$rline")"
    beat_ms="$(beat_of "${win:-}" "${dur:-0}" "${beats:-0}")"
    fbeat_ms=""; [ -n "$fbeats" ] && fbeat_ms="$(beat_of "" "${dur:-0}" "$fbeats")"
    r="$(SR_WORN_LOG="$wornf" derive "${dyn:-0.3}" "${act:-0.3}" "${rich:-0.6}" "${move:-0.14}" \
           "${cent:-1100}" "$beat_ms" "$organ" "${cov:-na}" "${fdyn:-na}" "${fact:-na}" \
           "${frich:-na}" "${fmove:-na}" "${fcent:-na}" "${fbeat_ms:-na}" 2>/dev/null)"
    case "$r" in
      RECIPE*) : ;;
      WALKED-OUT*)
        # Not a fault and not a cap: the source's own history plus the lane's recent renders left no
        # admissible recipe. Recorded so a lane that goes quiet says WHY.
        printf '%s skip %s %s at=%s refused:walked-out\n' "$(ts_utc)" "$h" "$organ" "$(now)" >> "$REPICK_LOG"; continue ;;
      *) printf '%s skip %s %s at=%s refused:derive-failed\n' "$(ts_utc)" "$h" "$organ" "$(now)" >> "$REPICK_LOG"; continue ;;
    esac
    args="${r#RECIPE }"; args="${args%% ~ *}"; meta="${r#* ~ }"
    wd="$(sed -n 's/.* worn \([0-9.a-z]*\)$/\1/p' <<<"$r")"
    if ! why="$(repick_gate "$wd")"; then
      printf '%s skip %s %s at=%s %s\n' "$(ts_utc)" "$h" "$organ" "$(now)" "$why" >> "$REPICK_LOG"
      continue
    fi
    # ── this one ships ──
    n=$((n+1))
    prev="$(sed -n 's/.*\(amc .*\) ~ .*/\1/p' "$wornf" | tail -n1)"
    cap="$(grind_cap "${dur:-0}")"
    # `remix=<hash>#<n>` rides in the META, so the params-log line this render writes says what it is.
    # The PREVIOUS recipe deliberately does NOT: the params log is parsed token-wise by parse_recent,
    # and a second `amc … s 1.5 …` string on the line would be read as this render's own recipe. Both
    # recipes are named where a human reads them — the book row below and the TG caption.
    meta="$meta remix=$h#$n"
    printf '%s pick %s %s n=%s at=%s worn=%s :: %s ~ was %s\n' \
      "$(ts_utc)" "$h" "$organ" "$n" "$(now)" "$wd" "$args" "${prev:-unknown}" >> "$REPICK_LOG"
    printf '%s %s\n' "$(( $(now) + cap + 300 ))" "$h" > "$REPICK_LEASE"
    mf=""; deliver=""
    mf="$(bg_register_drop "$organ" "$h" "$src" \
          "Ремикс #$n твоего дропа ($(basename "$src")) — не новая находка, тот же исходник другим рецептом. Было: «${prev:-неизвестно}». Стало: «$args».")"
    [ -n "$mf" ] && deliver="${mf%.manifest}.mp3"
    poke "remix" "Re-pick #$n of $h [$organ] — a REMIX, not a new find: the ledger row keeps its original ground: verdict. Recipe stands $wd from everything this source already wore (wall $REPICK_EPS). Was: $prev. Now: $args."
    # SR_REMIX_OF is what makes every verdict the detached child writes land in the re-pick book
    # instead of rewriting the record's ledger row. Exported for the child, unset immediately after —
    # a leaked SR_REMIX_OF would silently divert the NEXT ordinary grind's verdict away from the
    # ledger, which is a far worse failure than not re-picking at all.
    export SR_REMIX_OF="$h"
    launch_grind "$src" "$args" "$meta" "$h" "$cap" "$organ" "${dur:-0}" "$mf" "$deliver"
    unset SR_REMIX_OF
    rm -f "$wornf"
    return 0
  done <<< "$cands"
  rm -f "$wornf"
  return 0
}

# ── one tick ─────────────────────────────────────────────────────────────────────────────────────
tick(){
  local fresh last cand line h organ score beats dur dyn act rich move cent
  fresh="$(fresh_lines)"
  # An idle tick (no fresh block) is the retry window: re-grind a transiently-timed-out record
  # without ever competing with live material. Then, and ONLY if there was nothing to retry, the
  # re-pick lane (repick_once) — repairing a grind that failed outranks manufacturing diversity out
  # of one that succeeded, and both are strictly idle work. retry_timeouts returns non-zero for
  # exactly one state, "the lane is free and there was nothing to retry"; every other return
  # (it acted, or it stood down because a grind is in flight) is 0 and suppresses the re-pick.
  [ -n "$fresh" ] || { retry_timeouts || repick_once; return 0; }
  last="$(printf '%s\n' "$fresh" | tail -n1)"

  # An operator drop ALWAYS outranks the ear — a gesture is not ambience. Otherwise take the
  # highest-scoring grindable record in this block.
  cand="$(printf '%s\n' "$fresh" | grep ' drop ' | grep -v 'unmeasurable' | tail -n1)"
  if [ -z "$cand" ]; then
    # Rank by score ONLY among records with real rhythm (density floor). Ranking by score alone
    # picked the transients — see MIN_DENSITY. A cough scores 65.6 and grinds to nothing worth
    # hearing; an 1.3 b/s room texture scores 45.9 and grinds well.
    cand="$(printf '%s\n' "$fresh" | grep -v 'unmeasurable' | awk -v mb="$MIN_BEATS" -v md="$MIN_DENSITY" '
      { b=0; sc=0; w=0
        for(i=1;i<=NF;i++){ split($i,a,"=");
          if(a[1]=="beats") b=a[2]+0; if(a[1]=="score") sc=a[2]+0; if(a[1]=="win") w=a[2]+0 }
        d = (w > 0) ? b/w : 0
        if (b >= mb && d >= md && sc > best) { best=sc; line=$0 } }
      END{ if(line) print line }')"
  fi
  # NO CANDIDATE IS ALSO A VERDICT. This used to `consume "$last"; return 0` — moving the anchor past
  # the whole block while leaving every row at "pending", which is the same lie the settle loop below
  # exists to prevent, reached by the path that skips it. Measured on the live ledger (n=618): ~15% of
  # blocks clear nothing, so this path is a steady minority, not a corner and NOT the common case —
  # 52% of the ear's records DO clear the floor. It does not need to be common to matter: the strands
  # never resolve, so they accumulate monotonically (13 live on 2026-07-15 over 5.5h, pane reading
  # "28 pending" as a backlog for the mind). Decline them out loud, then consume.
  if [ -z "$cand" ]; then
    local dline dch
    while IFS= read -r dline; do
      [ -n "$dline" ] || continue
      dch="$(awk '{print $3}' <<<"$dline")"
      # Same two-causes split as the per-record path below. A record reaches this arm because NOTHING
      # in its block cleared, but the reason THIS record did not clear is still its own: if its
      # density is fine and only the duration-blind beats>=MIN_BEATS rejected it, say that. Without
      # the split the verdict a record gets depends on whether some OTHER record happened to win the
      # block — the same input read two ways, which is how the first version of this gate went green
      # one run and red the next.
      if [ -n "$dch" ]; then
        local dlb dlw
        dlb="$(kvof beats "$dline")"; dlw="$(kvof win "$dline")"
        if awk -v b="${dlb:-0}" -v w="${dlw:-0}" -v md="$MIN_DENSITY" \
             'BEGIN{ d=(w>0)? b/w : 0; exit !(d>=md) }'; then
          verdict "$dch" "skip:too-short-for-min-beats(${dlb:-0}b in ${dlw:-?}s — density $(awk -v b="${dlb:-0}" -v w="${dlw:-1}" 'BEGIN{printf "%.2f", (w>0)?b/w:0}') b/s CLEARS the >=$MIN_DENSITY rhythm floor; rejected only by beats>=$MIN_BEATS, which needs $(awk -v m="$MIN_BEATS" -v w="${dlw:-1}" 'BEGIN{printf "%.2f", (w>0)?m/w:0}') b/s at this length)"
        else
          verdict "$dch" "skip:below-rhythm-floor(no record in this block cleared beats>=$MIN_BEATS + density>=$MIN_DENSITY)"
        fi
      fi
    done <<< "$(printf '%s\n' "$fresh" | grep -v 'unmeasurable')"
    consume "$last"; return 0
  fi

  # Every OTHER record in this block is now settled, not waiting. The anchor is about to move past
  # them and nothing ever reconsiders a line behind the anchor — so leaving them "pending" is a
  # lie that never resolves: the count climbs forever (82 rows within an hour of going live) and the
  # pane reads it as a backlog the mind should act on, when in truth the reflex has already declined
  # them. `pending` must mean "not yet considered", or it means nothing.
  # Two different declines get two different verdicts. A row below the rhythm floor never entered
  # the score race, so settling it as "a stronger record led this block" names a cause that isn't
  # the cause — whoever reads the ledger (live 2026-07-16: scape 4ec89a12, 57.4 but 2b, read as
  # outscored) goes hunting for a phantom score race instead of seeing the floor did it.
  local ch lb lw
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    ch="$(awk '{print $3}' <<<"$line")"
    [ -n "$ch" ] && [ "$ch" != "$(awk '{print $3}' <<<"$cand")" ] || continue
    lb="$(kvof beats "$line")"; lw="$(kvof win "$line")"
    if awk -v b="${lb:-0}" -v w="${lw:-0}" -v mb="$MIN_BEATS" -v md="$MIN_DENSITY" \
         'BEGIN{ d=(w>0)? b/w : 0; exit !(b+0>=mb && d>=md) }'; then
      verdict "$ch" "skip:not-picked(a stronger record led this block)"
    else
      # ONE MESSAGE, TWO CAUSES — the split this file makes everywhere else (124/75/137,
      # hollow/degenerate/no-render) and had not made here. MIN_BEATS is duration-BLIND, so on a short
      # record it silently demands a far harsher density than the stated floor: 4 beats in 1.4s is
      # 2.86 b/s, against a MIN_DENSITY of 0.8 and a real-material band of ~1.33-1.58. Measured
      # 2026-08-20 on the live ledger, several ear records at density 1.25-1.43 — INSIDE that band —
      # were verdicted "below-rhythm-floor", which reads as "this material has no rhythm" when the
      # only thing wrong was that a 1.4s VAD fragment cannot physically carry 4 beats. Name which
      # floor actually rejected it, so a duration limit never masquerades as a rhythm judgement.
      if awk -v b="${lb:-0}" -v w="${lw:-0}" -v md="$MIN_DENSITY" \
           'BEGIN{ d=(w>0)? b/w : 0; exit !(d>=md) }'; then
        verdict "$ch" "skip:too-short-for-min-beats(${lb:-0}b in ${lw:-?}s — density $(awk -v b="${lb:-0}" -v w="${lw:-1}" 'BEGIN{printf "%.2f", (w>0)?b/w:0}') b/s CLEARS the >=$MIN_DENSITY rhythm floor; rejected only by beats>=$MIN_BEATS, which needs $(awk -v m="$MIN_BEATS" -v w="${lw:-1}" 'BEGIN{printf "%.2f", (w>0)?m/w:0}') b/s at this length)"
      else
        verdict "$ch" "skip:below-rhythm-floor(${lb:-0}b in ${lw:-?}s — floor beats>=$MIN_BEATS + density>=$MIN_DENSITY)"
      fi
    fi
  done <<< "$(printf '%s\n' "$fresh" | grep -v 'unmeasurable')"

  h="$(awk '{print $3}' <<<"$cand")"; organ="$(awk '{print $2}' <<<"$cand")"
  score="$(kvof score "$cand")"; beats="$(kvof beats "$cand")"; dur="$(kvof dur "$cand")"
  win="$(kvof win "$cand")"
  dyn="$(kvof dyn "$cand")"; act="$(kvof act "$cand")"; rich="$(kvof rich "$cand")"
  move="$(kvof move "$cand")"; cent="$(kvof cent "$cand")"

  local src; src="$(ls "$REC_DIR"/*-"$h".* 2>/dev/null | head -1)"
  [ -n "$src" ] || { verdict "$h" "skip:evicted-before-grind"; consume "$last"; return 0; }

  # beat period from the measurement itself (beats over the measured window), clamped to the
  # detector's own honest range. Fewer than MIN_BEATS and the beat-driven automixer grinds an empty
  # mp3 — the gate mesh-soundscape learned the hard way.
  if [ "${beats:-0}" -lt "$MIN_BEATS" ] 2>/dev/null && [ "$organ" != "drop" ]; then
    verdict "$h" "skip:beatless(${beats}b)"; consume "$last"; return 0
  fi
  # Density is checked in the ranker, but a `drop` bypasses the ranker entirely — so record the
  # honest reason here rather than letting a transient-only source look like a normal grind.
  local dens; dens="$(awk -v b="${beats:-0}" -v w="${win:-0}" 'BEGIN{ printf "%.2f", (w>0)? b/w : 0 }')"
  local beat_ms; beat_ms="$(beat_of "${win:-}" "${dur:-0}" "${beats:-0}")"

  # The WHOLE-FILE reading beside the window one, and the coverage that says how much to trust the
  # window (mesh-records writes both since 2e1843d). A row that predates it carries neither: every
  # value below stays empty, derive() folds nothing, and the recipe is the old one exactly.
  local cov fdyn fact frich fmove fcent fbeats fbeat_ms
  cov="$(kvof cov "$cand")"; fbeats="$(kvof fbeats "$cand")"
  fdyn="$(kvof fdyn "$cand")"; fact="$(kvof fact "$cand")"; frich="$(kvof frich "$cand")"
  fmove="$(kvof fmove "$cand")"; fcent="$(kvof fcent "$cand")"
  fbeat_ms=""; [ -n "$fbeats" ] && fbeat_ms="$(beat_of "" "${dur:-0}" "$fbeats")"

  local r
  r="$(derive "${dyn:-0.3}" "${act:-0.3}" "${rich:-0.6}" "${move:-0.14}" "${cent:-1100}" "$beat_ms" "$organ" \
              "${cov:-na}" "${fdyn:-na}" "${fact:-na}" "${frich:-na}" "${fmove:-na}" "${fcent:-na}" "${fbeat_ms:-na}" 2>/dev/null)"
  case "$r" in
    WALKED-OUT*)
      verdict "$h" "held:walked-out"
      poke "walked-out" "The novelty gate found no recipe far enough from the last $RECENT renders (epsilon=$EPSILON). The param space around this material is used up — either widen the pools, drop epsilon, or accept a repeat. Record $h [$organ] score=$score is held, not ground."
      consume "$last"; return 0 ;;
    RECIPE*) : ;;
    *) verdict "$h" "skip:derive-failed"; consume "$last"; return 0 ;;
  esac

  local args meta
  args="${r#RECIPE }"; args="${args%% ~ *}"
  meta="${r#* ~ }"

  # Publish the novelty headroom for the pane to LEASE (mtime = when it was last actually computed).
  # The pane must never render this as a bare current-looking number: if the grinder dies, the file
  # stops advancing and fresh_mark shows it STALE rather than implying the space is still open.
  printf '%s (fit %s, last recipe cleared epsilon=%s vs last %d renders)\n' \
    "$(sed -n 's/.* novelty \([0-9.]*\).*/\1/p' <<<"$r")" \
    "$(sed -n 's/.* fit \([0-9.]*\).*/\1/p' <<<"$r")" "$EPSILON" "$RECENT" \
    > "$ROOM" 2>/dev/null || true

  # OUTLIER: material that beats anything the lane has GROUND LATELY — worth the mind's attention
  # even though the reflex is already grinding it.
  local hw; hw="$(outlier_hw)"
  if [ -n "$hw" ] && [ -n "$score" ]; then
    is_outlier "$score" "$dens" \
      && poke "outlier" "Record $h [$organ] scored $score — above every one of the last $OUTLIER_N records the lane actually ground (high-water $hw, +$(awk -v k="$OUTLIER_MARGIN" "BEGIN{printf \"%.0f\", (k-1)*100}")% margin) — AND carries real rhythm (${dens} beats/s, ${beats}b), not just a loud transient. Grinding it now as: $args"
  fi
  # SAY WHETHER THE GESTURE IS FRESH (2026-08-19). This fires on organ=drop alone — it is a claim
  # about WHICH ORGAN is being ground, worded as a claim about an EVENT ("landed", "outranks the
  # ear"). Both readings are usually the same thing, but not while the inbox backlog is being
  # ingested: 3 of today's 4 drop pokes were July recordings (Jul 16/18/22) measured out of a
  # 360-file backlog, and only one (Aug 19 17:58) was a same-day gesture. Measured and NOT a
  # treadmill — 47 pokes across 47 distinct files, nothing re-announced, dedupe intact — so the
  # behaviour is right and only the sentence was ambiguous. It cost a real inference: at 08:20 I
  # checked the ledger, found the hash absent, and concluded "genuinely new" — the ledger is a
  # sliding window, so absence there says nothing about the material's age. The record preserves its
  # source mtime, so the material's own date is free to read and settles it in the poke itself.
  [ "$organ" = "drop" ] && poke "drop" "Operator drop landed: $(basename "$src") (score=$score beats=$beats dur=${dur}s, $(drop_age_note "$src")). It outranks the ear and is grinding now as: $args"

  verdict "$h" "grinding"

  # DURABLE DELIVERY — operator DROPS only (grind-durable-delivery, bg-manifest contract). A `drop` is
  # operator-initiated: he dropped this source expecting to HEAR the result, so its mix must reach his TG
  # even if the mind /clears mid-grind. Register a bg-manifest BEFORE launching the detached grind; the
  # CHILD (not the mind) fires mesh-bg-done at completion, so delivery leaves the mind entirely and a
  # /clear strands nothing. Routine ear/outlier grinds are corpus material, NOT delivery work — the child
  # writes its own verdict, so a /clear mid-corpus-grind loses nothing; registering them would only
  # manufacture false /clear-blocks (the gate BLOCKS on status=running). Hence drops-only.
  local mf="" deliver=""
  mf="$(bg_register_drop "$organ" "$h" "$src")"          # non-empty only for an operator drop
  [ -n "$mf" ] && deliver="${mf%.manifest}.mp3"          # the deterministic path the manifest's on-done ships

  # The grind is O(n^2) and slow — NEVER block a cron tick on it. Detached + hard-timeout-bounded,
  # owned by launch_grind() below (ONE owner for the main tick and the timeout retry).
  launch_grind "$src" "$args" "$meta" "$h" "$(grind_cap "$dur")" "$organ" "$dur" "$mf" "$deliver"

  consume "$last"
}

# launch_grind <src> <args> <meta> <h> <GT> <organ> <dur> <mf> <deliver> [retry] — the ONE owner of
# the detached grind child. The background job writes the ledger verdict when it lands.
# mesh-room-music stays the single owner of the grind invocation (heavy-run admission, hollow gate,
# fresh gate, params logging) — this only pins the recipe it should use. A non-empty $10 marks a
# RETRY: a second timeout then verdicts skip:grind-timeout(...,retry-exhausted), which the
# retry scan's $-anchored match on the un-suffixed verdict can never pick again.
launch_grind(){
  setsid bash -c '
    src="$1"; args="$2"; meta="$3"; h="$4"; GT="$5"; self="$6"; organ="$7"; dur="$8"; MF="${9:-}"; DELIVER="${10:-}"; RF="${11:-}"; BL="${12:-/dev/null}"
    raw="$(MESH_RMC_AUTOMIX="$args" MESH_RMC_META="src=$organ/$h $meta" \
           timeout "$GT" mesh-room-music --remix "$src" 2>/dev/null)"; rmc_rc=$?
    out="$(grep -E "\.mp3$" <<<"$raw" | tail -1)"
    if [ -n "$out" ] && [ -f "$out" ]; then
      "$self" --verdict "$h" "ground:$(basename "$out")"
    elif [ "$rmc_rc" -eq 124 ]; then
      # rc=124 is the CAP speaking, not the material. Collapsing it into "degenerate" is one message
      # for two causes: it buried the first drop the lane ever received (fdfdd3fb, 125.57s, killed
      # 17s short of a real 34M render, 2026-07-16). grind_cap scales with duration so this should
      # be rare; when it still fires, say what actually happened.
      "$self" --verdict "$h" "skip:grind-timeout(${GT}s${RF:+,retry-exhausted})"
      "$self" --poke grind-timeout "Record $h [$organ] (dur=${dur}s) was still rendering when the ${GT}s grind cap killed it — the material is NOT judged degenerate. Either the cap is too tight for this source or the render genuinely hung; an untimed rerun distinguishes them."
    elif [ "$rmc_rc" -eq 75 ]; then
      # rc=75 (EX_TEMPFAIL) is mesh-heavy-run REFUSING admission — the node could not seat the grind
      # RAM budget under memory/CPU pressure. The render NEVER RAN; the material is untouched, NOT
      # degenerate. Collapsing it into skip:degenerate is the same "one message for two causes" lie as
      # the rc=124 case above: on 2026-07-17 a pressured (post-reboot restart-churn) window deferred
      # ~15 live ear records in a row and every one was recorded as "degenerate material", poisoning the
      # corpus stats and poking the mind about pathological sound that never existed. Own verdict, own
      # poke — a defer is a node-state signal, not a judgement of the record.
      "$self" --verdict "$h" "skip:deferred(node-pressure)"
      "$self" --poke deferred "Record $h [$organ] (dur=${dur}s) was DEFERRED — mesh-heavy-run refused the grind RAM budget under node pressure; the render never ran. NOT degenerate material. Comparable material lands from the ear continuously, so the lane self-recovers when pressure clears; re-drop this source manually to force a grind now if it mattered."
    elif [ "$rmc_rc" -eq 137 ]; then
      # rc=137 = the grind was cgroup-OOM-KILLED at its per-job memory ceiling (mesh-heavy-run runs the
      # grainneukeln python under systemd MemoryMax=2500M; SIGKILL 9 → 128+9). Unlike rc=75 (defer,
      # never seated) the job WAS admitted — its declared budget fit headroom — then its actual RSS blew
      # past the cap and the cgroup killed it ALONE, sparing every sibling. The render produced nothing,
      # but the material is untouched: comparable note3/ear material grinds fine at a modest recipe. This
      # is the SAME "one message for two causes" lie the 124/75 branches fixed — on 2026-07-18
      # 01:42→02:32 ~10 note3 records in a row were OOM-killed and every one was slandered as "recipe
      # pathological / source thinner than it looked", poisoning corpus stats and poking the mind about
      # sound that never failed on merit. Own verdict, own poke — an OOM is a budget/recipe-memory
      # signal, not a judgement of the record.
      "$self" --verdict "$h" "skip:oom(budget)"
      "$self" --poke oom "Record $h [$organ] (dur=${dur}s) was OOM-KILLED at the grind memory ceiling (rc=137) with: $args — the recipe RSS blew past the 2500MB per-job budget and the cgroup killed it. NOT degenerate material; comparable material grinds fine. Raise MESH_RMC_BUDGET_MB for this class, or the recipe derivation is memory-pathological for this record (small grain + long superslow stretch explodes the grain array)."
    elif grep -q "hollow/undecodable" <<<"$raw"; then
      # rc=1 carrying the mesh-room-music "hollow/undecodable ... refusing to log/ship" refusal is the
      # FIFTH cause, and the one the else below silently ate: the grind RAN to completion but its OUTPUT
      # decoded to a near-silent/undecodable track, so the tool refused to ship it. That is a recipe /
      # render-quality signal, NOT a judgement that the material is thin — the SAME one-message-two-causes
      # lie the 124/75/137 branches each split out. Proven recipe-marginal AND flaky on 2026-07-18:
      # record 2f12b432, verdicted skip:degenerate at 10:40, grinds to a real -1.5dB-max mp3 on its
      # IDENTICAL recipe on retry; the outcome is non-deterministic, so "source thinner than its beat
      # count" is an over-claim we cannot substantiate from one hollow render. Distinguishing
      # thin-material from a marginal recipe needs cross-recipe evidence this single tick never gathers,
      # so the honest per-tick verdict is what actually happened: the render came out hollow.
      "$self" --failed "$h" "$args ~ $meta"
      # A hollow on a RETRY is the cross-recipe evidence the comment above says is missing: the retry
      # re-derives against the failed store, which now repels the first hollow recipe, so a second
      # hollow is a DIFFERENT recipe rendering hollow on the same source. That, and only that, is what
      # "genuinely degenerate" means here — the promotion is earned, not assumed, and the $-anchored
      # retry scan can never pick the suffixed verdict again.
      # (No apostrophes in this block: it lives inside the launch_grind bash -c single-quoted string,
      # where one would terminate the string and break the enclosing if/elif chain. Seen.)
      if [ -n "$RF" ]; then
        "$self" --verdict "$h" "skip:hollow(recipe,cross-recipe:degenerate)"
      else
        "$self" --verdict "$h" "skip:hollow(recipe)"
      fi
      "$self" --poke hollow "Record $h [$organ] (dur=${dur}s) cleared the beat gate and RAN, but the render decoded to a hollow/near-silent track with: $args — mesh-room-music refused to ship it. This is a recipe/render-quality signal, NOT thin material; the same record often grinds fine on retry or another recipe (2f12b432 did). Only a record that renders hollow across recipes is genuinely degenerate."
    elif grep -q "no FRESH output" <<<"$raw"; then
      # The SIXTH cause, split out of the hollow grep above (they shared one branch until 2026-07-20):
      # "no FRESH output" means the automix ran and produced NO new mp3 AT ALL — the grind python
      # crashed or its environment broke before any track existed. NOTHING rendered, so there is no
      # render quality to judge and no recipe to blame: hollow says "a track decoded near-silent",
      # no-render says "there was never a track". Conflating them sent the 2026-07-20 cron-env storm
      # (XDG_RUNTIME_DIR absent under cron → the mesh-heavy-run ulimit -v fallback → sklearn import
      # death, f27604f) into skip:hollow(recipe) on ~40 healthy note3 records, polluted the failed
      # store with recipes that were never tried (all truncated as bug artifacts), and sent the sound
      # mind chasing render quality for a crash. An engine/env signal, not a recipe one — so this
      # branch does NOT feed the failed store; a phantom entry repels recipes that never ran.
      # (Inside the single-quoted bash -c string — NO embedded single quotes in this branch either.)
      # $RF (set only on a retry) suffixes the verdict so the $-anchored retry scan can never pick
      # this row again. Without it a node whose grind engine is genuinely down re-grinds the same
      # record on every idle tick forever — the same convergence the 124 and hollow branches each
      # carry. The suffix is the ONLY difference: a no-render still never feeds the failed store,
      # on the retry exactly as on the first attempt, because a crash is not a recipe judgement.
      "$self" --verdict "$h" "skip:no-render${RF:+(retry-exhausted)}"
      "$self" --poke no-render "Record $h [$organ] (dur=${dur}s) cleared the beat gate but the grind produced NOTHING — mesh-room-music reported no-FRESH-output (rc=$rmc_rc): the render crashed or its environment broke before any track existed. NOT a recipe or material judgement (nothing rendered to judge). Check the grind-engine path — a run of these means the engine is down for a whole class (the 2026-07-20 case was cron env, not sound)."
    else
      # A no-message empty return (no mp3, no hollow/stale refusal, rc not 124/75/137) — the defensive
      # floor. In practice mesh-room-music names every empty render (hollow gate / stale gate), so a
      # silent nothing reaching here is a genuine dead-end, distinct from the recipe-hollow branch above.
      "$self" --failed "$h" "$args ~ $meta"
      "$self" --verdict "$h" "skip:degenerate"
      "$self" --poke degenerate "Record $h [$organ] cleared the beat gate but ground to nothing usable with: $args. Either the recipe is pathological for this material or the source is thinner than its beat count suggested."
    fi
    # DURABLE DELIVERY completion (drops only — MF is empty for every non-drop grind). This runs from
    # the DETACHED child, mind absent, so a /clear mid-grind never strands the drop. On real output:
    # stage $out at the deterministic DELIVER path the manifest names, then mesh-bg-done fires the
    # on-done (ships to operator TG) and flips the manifest → delivered. On any empty/skip path
    # ($out unset by rc 124/75/137/degenerate): --no-deliver closes the manifest → done-nodeliver, so
    # it PASSES the gate instead of sitting `running` and wedging every /clear (the stale-lease trap).
    if [ -n "$MF" ]; then
      # This block is inside a single-quoted bash -c string — NO embedded single quotes allowed.
      if [ -n "$out" ] && [ -f "$out" ]; then
        # LISTEN BEFORE SHIPPING TO THE OPERATOR (2026-07-24) — the same self-listen gate mesh-guitar-watch
        # already carries, extended to the general drop path. A drop is operator-initiated and it lands in
        # his TG, so a muddy / lost-song render is exactly what he refused to keep being the gate for
        # (вы хоть раз САМИ слушайте). Verify the render is still a coherent song vs its SOURCE:
        #   rc 1 = reject: do NOT ship mud. Close the manifest done-nodeliver (PASSES the /clear gate,
        #          never wedges running), flag the verdict unshipped, and POKE the mind — the operator is
        #          waiting to HEAR the drop, so a silent withhold is the silent-fallback trap (he dropped a
        #          track and got nothing, no reason). The poke bypasses cooldown (operator-drop class).
        #   rc 2 = analyzer n/a: ship LOUD-unverified (honest), never silently trust an unheard file.
        #   rc 0 / tool absent = ship.
        sv_rc=0; sv_out=""
        if command -v mesh-song-verify >/dev/null 2>&1; then
          sv_out="$(mesh-song-verify "$src" "$out" 2>/dev/null)"; sv_rc=$?
        fi
        # TRIM -> RE-VERIFY -> SHIP (operator YES 2026-08-19T10:30:59Z, task:trim-near-silent-operator-call).
        # A reject whose ONLY reworkable axis is dead-gaps gets its near-silence removed and is then
        # RE-VERIFIED IN FULL. Three things this must not become:
        #   - it must not ship on the rework= tag. That tag is a HYPOTHESIS (mesh-song-verify:62-67);
        #     the artifact is the second verify rc, and $ship only moves when THAT is 0.
        #   - the re-verify must be the WHOLE verify, not a dead-gaps recheck: live case 3bc762d1 sat
        #     at silent 0.33, inside the 0.50 band, and was arrhythmic too — a dead-gaps-only recheck
        #     would have shipped it.
        #   - the 0.50 band is NOT re-derived here. mesh-song-verify only puts dead-gaps in rework=
        #     when value <= REWORK_MAX_SILENT, so reading its tag IS reading the band; a second copy
        #     of 0.50 in this file would be a constant that rots away from the one that means it.
        # Read the rework= FIELD, never the whole line: dead-gaps also appears in fundamental= when it
        # is out of band, and a substring gate on a composite artifact is satisfied by its neighbour.
        ship="$out"; tv_rc=9; tv_out=""; trimmed=""; sv_rework=""
        if [ "$sv_rc" -eq 1 ]; then
          sv_rework="$(printf %s "$sv_out" | sed -n "s/.*rework=\(.*\) fundamental=.*/\1/p")"
          case "$sv_rework" in
            *trim-near-silent*)
              trimmed="${out%.*}.trim.${out##*.}"
              if "$self" --trim "$out" "$trimmed" >/dev/null 2>&1; then
                tv_out="$(mesh-song-verify "$src" "$trimmed" 2>/dev/null)"; tv_rc=$?
                if [ "$tv_rc" -eq 0 ]; then
                  ship="$trimmed"; sv_rc=0
                  "$self" --verdict "$h" "ground:$(basename "$ship") (trimmed:near-silent, re-verified — $tv_out)"
                fi
              else
                tv_rc=3
              fi ;;
          esac
        fi
        if [ "$sv_rc" -eq 1 ]; then
          # Name what the completing-deficiencies attempt DID, so a withhold never reads as "we did
          # not try": 9 = the verify offered no trimmable axis (out of band, or fundamental only),
          # 3 = the trim itself could not run, 1/2 = it ran and the RE-VERIFY refused it.
          case "$tv_rc" in
            9) tv_note="no trimmable axis offered (rework=${sv_rework:-none})" ;;
            3) tv_note="the near-silence trim could not run (ffmpeg absent or the render undecodable)" ;;
            2) tv_note="TRIMMED, but the re-verify could not listen: $tv_out — never shipped on an unheard trim" ;;
            *) tv_note="TRIMMED and RE-VERIFIED, still rejected: $tv_out" ;;
          esac
          "$self" --verdict "$h" "ground:$(basename "$out") (unshipped:not-a-song — $sv_out | rework: $tv_note)"
          "$self" --poke not-a-song "Operator drop $h [$organ] (dur=${dur}s) ground to a render that FAILED the song-verify listen — NOT shipped to your TG. $sv_out. Rework: $tv_note. The grind RAN; its OUTPUT is mud / lost the song. Re-drop for another recipe, or loosen SONG_* thresholds if this was a false reject."
          mesh-bg-done "$MF" --no-deliver >>"$BL" 2>&1
        else
          [ "$sv_rc" -eq 2 ] && "$self" --poke unverified "Operator drop $h [$organ] (dur=${dur}s) shipped UNVERIFIED — the song analyzer was unavailable ($sv_out), so it could not be listened to before sending."
          # Stage the produced mix at the deterministic path the manifest names, then fire the stored
          # on-done (ships to operator TG) and flip → delivered. A failed send (or a cp failure that
          # leaves DELIVER absent, so the on-done ships nothing) leaves the manifest done-undelivered:
          # the gate keeps BLOCKING and the delivery is retryable — never a false pass, never dropped.
          # We do NOT fall through to --no-deliver here (that would mark a real drop as nothing-to-ship).
          cp -f "$ship" "$DELIVER" 2>/dev/null
          if mesh-bg-done "$MF" >>"$BL" 2>&1; then :; else
            bd_rc=$?
            # Since mesh-bg-retry (*/30) this state HAS a driver, so the stranding is no longer
            # permanent — but it is still worth being loud at the moment it happens: the gate BLOCKS
            # until the next retrier tick, and a silent block is the thing that let 74 of these
            # accumulate unnoticed for 26 days. (No apostrophes: inside the bash -c single quotes.)
            printf "%s drop %s [%s]: bg-done delivery FAILED rc=%s — manifest %s stays done-undelivered, render staged at %s\n" \
              "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$h" "$organ" "$bd_rc" "$MF" "$DELIVER" >> "$BL"
            "$self" --poke undelivered 2>>"$BL" "Operator drop $h [$organ] (dur=${dur}s) ground CLEAN and passed the song-verify listen, then FAILED to send (bg-done rc=$bd_rc). The render is on disk at $DELIVER and the manifest stays done-undelivered — mesh-bg-retry picks it up on the next */30 tick, so DO NOTHING unless it is still stranded after ~30min — a hand-ship racing the retrier sends the operator a DUPLICATE. Check first: mesh-bg-retry --window $organ. If you do ship by hand, the verb is mesh-bg-done '"'"'$MF'"'"' (re-fires the same on-done AND flips the manifest); a bare mesh-room-music --deliver ships the audio and settles NOTHING, leaving the gate blocked and the render queued for a duplicate send."
          fi
        fi
      else
        # No output produced (rc 124/75/137/degenerate) → nothing to ship; close done-nodeliver so it
        # PASSES the gate instead of sitting running and wedging every /clear (the stale-lease trap).
        mesh-bg-done "$MF" --no-deliver >>"$BL" 2>&1
      fi
    fi
  ' _ "$1" "$2" "$3" "$4" "$5" "$0" "$6" "$7" "${8:-}" "${9:-}" "${10:-}" "$BGLOG" </dev/null >/dev/null 2>&1 9>&- &
  # 9>&- closes the inherited flock fd in the detached child BEFORE it runs. Without this the child
  # (and its own children: timeout, mesh-room-music) keep fd 9 open for the whole grind, so the flock
  # stays held long after this tick returns — every cron tick that lands mid-grind hits `flock -n 9 ||
  # exit 0` and skips silently, without touching TICK or logging anything. Measured live 2026-07-22: an
  # 11.8s note3 record took ~14min to render, wedging 2-3 */5min ticks, grinder lease read stale for
  # ~20min and pending backlog climbed 24->32 with a 0-byte log the whole time (the skip path logs
  # nothing to explain itself). "Detached so cron never blocks on the grind" was true for the PARENT
  # process exiting, but not for the LOCK it silently carried into the child.
}

# ── transient-timeout retry (idle ticks only) ────────────────────────────────────────────────────
# skip:grind-timeout was STICKY-PERMANENT: the anchor never revisits a settled line, so ONE transient
# stall (load/IO) lost the record forever — 090bfbd7, the richest material in days (score 56.8,
# 3.5x median dyn), timed out once at 300s then reran in 31s, exactly the 2.53 s/s norm (2026-07-23).
# The rc=124 poke even says "an untimed rerun distinguishes them" — but nothing ever ran one. On an
# IDLE tick (no fresh block, so never competing with live material, and only when no grind is already
# in flight) re-grind the newest un-retried timeout at DOUBLE its cap, exactly once: success →
# ground:, second timeout → skip:grind-timeout(...,retry-exhausted) and the $-anchored scan below can
# never pick it again — a genuinely slow/hung render exits the pool after one bounded retry.
# RETURN CONTRACT (read by tick()'s idle branch): 0 = this function acted, or deliberately stood
# down — either way the idle tick is spent. Non-zero = the lane is FREE and there was nothing to
# retry, which is the one state in which the re-pick lane may run.
retry_timeouts(){
  local rline h organ beats dur win dyn act rich move cent src beat_ms r args meta mf deliver
  [ -f "$LEDGER" ] || return 0
  # A grind already in flight: stand down. A retry landing on a pressured node would rc=75 into
  # skip:deferred — leaking the record out of the retry pool through a different sticky verdict.
  grep -q -- '-> grinding$' "$LEDGER" 2>/dev/null && return 0
  # ... and a REMIX in flight is invisible to that grep by construction (verdict() keeps a re-pick
  # out of the ledger), so the ledger check alone would let a retry and a remix grind at once.
  repick_inflight && return 0
  # TWO retryable verdicts, not one. skip:hollow(recipe) is documented in its own branch as
  # NON-DETERMINISTIC — record 2f12b432 rendered hollow, then ground to a real -1.5dB-max mp3 on the
  # IDENTICAL recipe — and it was nonetheless in the settled-anchor set, i.e. permanently retired on a
  # failure the code itself calls transient. That is the exact sticky-verdict bug fixed here for
  # rc=124 and never swept to its sibling. A hollow retry costs one render and buys the cross-recipe
  # evidence the hollow branch says it lacks: pass -> ground, hollow again -> degenerate, earned.
  # THREE retryable verdicts. skip:no-render joined 2026-08-21 — the sibling of the sibling the
  # comment above describes, and the most obviously transient of the set: its branch says in its own
  # words "the render crashed or its environment broke before any track existed ... NOT a recipe or
  # material judgement (nothing rendered to judge)". An environment crash is what a retry IS for, and
  # this was the only failure class with no route back into ANY pool — the re-pick lane keys on
  # `-> ground:`, so a record that never ground can never be a re-pick candidate either. Cost: the
  # operator's own fresh gesture, drop a10b4867 (2026-08-21T06:10Z, score 64.4, 11.01s, recorded that
  # morning) — the class the lane declares "outranks the ear and is never evicted" — retired on an
  # engine fault whose exact recipe then rendered a real 175.5K mp3 by hand, rc=0, both bare and
  # through mesh-heavy-run. Nothing was wrong with it and nothing was ever going to try again.
  rline="$(grep -E -- '-> (skip:grind-timeout\([0-9]+s\)|skip:hollow\(recipe\)|skip:no-render)$' "$LEDGER" 2>/dev/null | tail -n1)" || true
  [ -n "$rline" ] || return 3      # nothing to retry, lane free -> the re-pick lane may run
  h="$(awk '{print $3}' <<<"$rline")"; organ="$(awk '{print $2}' <<<"$rline")"
  [ -n "$h" ] || return 0
  src="$(ls "$REC_DIR"/*-"$h".* 2>/dev/null | head -1)"
  [ -n "$src" ] || { verdict "$h" "skip:evicted-before-grind(timeout-retry)"; return 0; }
  beats="$(kvof beats "$rline")"; dur="$(kvof dur "$rline")"; win="$(kvof win "$rline")"
  dyn="$(kvof dyn "$rline")"; act="$(kvof act "$rline")"; rich="$(kvof rich "$rline")"
  move="$(kvof move "$rline")"; cent="$(kvof cent "$rline")"
  beat_ms="$(beat_of "${win:-}" "${dur:-0}" "${beats:-0}")"
  # same coverage-weighted basis as tick() — a retry must re-derive the recipe the first attempt
  # would get today, not the pre-fold one (two derivations of one record disagreeing by code path is
  # the drift this reflex already measures in the CORPUS; adding a second source of it is gratuitous)
  local cov fdyn fact frich fmove fcent fbeats fbeat_ms
  cov="$(kvof cov "$rline")"; fbeats="$(kvof fbeats "$rline")"
  fdyn="$(kvof fdyn "$rline")"; fact="$(kvof fact "$rline")"; frich="$(kvof frich "$rline")"
  fmove="$(kvof fmove "$rline")"; fcent="$(kvof fcent "$rline")"
  fbeat_ms=""; [ -n "$fbeats" ] && fbeat_ms="$(beat_of "" "${dur:-0}" "$fbeats")"
  r="$(derive "${dyn:-0.3}" "${act:-0.3}" "${rich:-0.6}" "${move:-0.14}" "${cent:-1100}" "$beat_ms" "$organ" \
              "${cov:-na}" "${fdyn:-na}" "${fact:-na}" "${frich:-na}" "${fmove:-na}" "${fcent:-na}" "${fbeat_ms:-na}" 2>/dev/null)"
  case "$r" in
    RECIPE*) : ;;
    WALKED-OUT*) verdict "$h" "held:walked-out"; return 0 ;;
    *) verdict "$h" "skip:derive-failed"; return 0 ;;
  esac
  args="${r#RECIPE }"; args="${args%% ~ *}"; meta="${r#* ~ }"
  mf="$(bg_register_drop "$organ" "$h" "$src")"; deliver=""
  [ -n "$mf" ] && deliver="${mf%.manifest}.mp3"
  verdict "$h" "grinding"
  launch_grind "$src" "$args" "$meta" "$h" "$(( 2 * $(grind_cap "$dur") ))" "$organ" "$dur" "$mf" "$deliver" retry
}

# coverage — OPEN-ENDEDNESS of the render corpus, not per-render novelty. The reflex already repels
# each new render from the last $RECENT recipes (combo distance = LOCAL novelty). But the ALife
# open-ended-evolution literature is explicit that per-step novelty is NOT open-endedness: a
# population can post high local novelty on every step while oscillating inside a fixed, shrinking
# region — churn, not expansion. The info-theoretic OEL definition (Sudhakaran/Ito et al.,
# "An Information-Theoretic Definition for Open-Ended Learning", arXiv:2606.08369, 2026) frames it as
# a NONVANISHING RATE of novel-region acquisition; MODES (Dolson & Ofria, Artificial Life 25(1):50,
# 2019) separates a system that merely CHANGES from one with NOVELTY POTENTIAL. We measured the
# derivative-at-a-point ($ROOM headroom) and never the spread. This is the exact blind spot behind
# the known grinder-collapse family (recursive-grind bloom, beatless collapse): fit stays fine AND
# per-render novelty stays fine while the corpus quietly stops occupying new recipe-space.
#
# The signal is SPREAD, not new-cells: a raw "new cells per render" decays to 0 for ANY corpus on a
# finite recipe grid once explored (healthy SATURATION), so it would false-alarm exactly like the
# threshold-above-its-own-ceiling traps. Instead: quantize each render into a recipe cell
# (l·s·f·band buckets) and score the TRAILING window's distinct-cell occupancy against the corpus's
# OWN demonstrated historical best occupancy — self-calibrating (no assumed 0..1 ceiling), does not
# saturate. ratio→1 = still spreading; ratio→0 = collapsed into a corner. Report-only (surfaced on
# --status / the sound dash); it does NOT poke — an axis earns its alarm only after it is watched,
# same discipline as mesh-vitality's report-only accretion.
#
# ── PER-FACTOR coverage: a JOINT spread is not control of any AXIS (2026-08-18) ────────────────
# The spread above is the number of distinct JOINT recipe-cells the trailing window occupies, and
# that quantity is maximised by a corpus that roams on SOME axes while another is pinned dead. It is
# the exact failure mode Allen et al. name against empowerment-style skill discovery: maximising
# I(Z; S_T) over the whole state yields behaviours that "tend not to provide the agent with much
# actual control over the individual state variables", so the repertoire looks diverse while no
# single variable is under its hand ("Focused Skill Discovery: Learning to Control Specific State
# Variables while Minimizing Side Effects", Allen et al., arXiv:2510.04901 / OpenReview eM5ZtMijef;
# their per-factor reward recovers 3.0-5.3x state coverage over VIC/DIAYN/LSD precisely because the
# aggregate objective never asked per-axis).
# The same paper carries the sharper half, and that is the one that bites HERE: an axis held CONSTANT
# has zero variance and zero mutual information with the choice, so every distinguishability-shaped
# measure — this occupancy count, and the repellent's mean-over-axes `dist()` alike — scores it as
# perfectly well-behaved. "[H]aving the _same_ effects on non-target variables does not mean that
# there are _no_ side effects": all their skills knocking the same cup over identically MINIMISES
# the MI term while maximising the damage. A constant is invisible to a spread.
#
# MEASURED, not argued (2026-08-18): a synthetic 14-render corpus roaming l/s/f with `band` pinned to
# `slow` on EVERY row reads `occ 0.92 verdict=expanding` from the joint metric — one of four axes
# dead, verdict clean. The live corpus is currently clean on this (1749 renders, all four axes moving
# in the trailing window), so this is a detector for a blindness the metric structurally HAS, not a
# live fault. The file has already been bitten once by this shape from the other side: the ergodicity
# note above found "[t]wo of five recipe axes were dead for room material" and needed a separate
# mixture test to see it, because neither the repellent nor this occupancy count could.
#
# The classification is three-way on purpose, because a constant has three causes and only one is a
# fault: `frozen` = the axis moves somewhere in the corpus but not in the window (it CAN move and
# isn't — the collapse); `flat` = it has never varied at all (single-valued pool or dead from birth;
# the log cannot separate those, so it is reported, not accused); `na` = the window carries only the
# parse-failure sentinel, which is blindness and must never render as a healthy constant. Report-only
# and printed BEFORE `verdict=`, so the joint verdict every existing consumer parses is unchanged.
coverage(){
  command -v python3 >/dev/null 2>&1 || { echo "COVERAGE n/a (no python3)"; return 2; }
  MESH_COV_PARAMS="$PARAMS_LOG" MESH_COV_WIN="${SR_COV_WINDOW:-12}" python3 - "$@" <<'PYCOV'
import os, sys, math
path = os.environ.get("MESH_COV_PARAMS", "")
W    = int(os.environ.get("MESH_COV_WIN", "12") or 12)
def bucket_l(v):  # grain length, log-scaled
    try: v=float(v)
    except: return "l?"
    return "l%d" % (0 if v<=0 else int(math.log2(v)))
def bucket_s(v):  # track speed thresholds
    try: v=float(v)
    except: return "s?"
    return "s0" if v<0.5 else "s1" if v<1.0 else "s2" if v<2.0 else "s3"
def bucket_f(v):  # grain factor thresholds
    try: v=float(v)
    except: return "f?"
    return "f0" if v<0.3 else "f1" if v<0.6 else "f2" if v<1.2 else "f3"
def cell(line):
    t = line.split()
    kv = {}
    i = 0
    while i < len(t)-1:
        if t[i] in ("l","s","f","band","ss","w") and t[i+1] not in ("~",):
            kv[t[i]] = t[i+1]; i += 2
        else:
            i += 1
    if "l" not in kv or "s" not in kv:  # not a real render line
        return None
    return (bucket_l(kv.get("l")), bucket_s(kv.get("s")),
            bucket_f(kv.get("f","0")), kv.get("band","na"))
rows = []
try:
    with open(path) as fh:
        for ln in fh:
            c = cell(ln)
            if c is not None: rows.append(c)
except FileNotFoundError:
    rows = []
N = len(rows)
if N == 0:
    print("COVERAGE cells=0 renders=0 trailing_occ=0 recent_new=0 occ=0.00 verdict=n/a")
    sys.exit(0)
distinct = len(set(rows))                       # cumulative breadth: cells the corpus has EVER held
trailing = len(set(rows[-W:]))                  # distinct cells in the trailing window
prior = set(rows[:-W]) if N > W else set()
recent_new = len(set(rows[-W:]) - prior)        # cells FIRST-seen in the window — Bedau new-activity /
                                                # OEL acquisition rate (>0 = still discovering region)
# VERDICT keys on ABSOLUTE trailing spread (occ = distinct cells / window), never on a self-relative
# ratio: a corpus that was ALWAYS narrow has hist_best==trailing so ratio==1.00 would false-green it
# `expanding` (the value-held→mtime-frozen class). occ has a real denominator (W) and cannot saturate
# to a false pass. recent_new is REPORTED as the still-discovering signal, not gated (0 is healthy at
# full coverage — saturation is not collapse), matching the report-only-before-alarm discipline.
occ = trailing / float(W)
if N < W:
    verdict = "n/a"           # too few renders to judge spread
elif occ >= 0.5:
    verdict = "expanding"     # >=half the window's renders sit in distinct recipe-cells
elif occ >= 0.25:
    verdict = "narrow"
else:
    verdict = "collapsed"     # trailing window huddled in a corner — the grinder-collapse blind spot
# PER-FACTOR: read straight off the SAME `rows` the joint metric uses (positional, in cell()'s
# order) — one parser, so this leg cannot rot apart from the count it qualifies.
AXES = ("l", "s", "f", "band")
UNK  = {"l": "l?", "s": "s?", "f": "f?", "band": "na"}
focus, frozen_axes = [], []
for j, a in enumerate(AXES):
    tw   = [r[j] for r in rows[-W:]]
    seen = set(r[j] for r in rows)
    if N < W or not tw or all(v == UNK[a] for v in tw):
        st = "na"                    # blind window: never a healthy constant, never a collapse
    elif len(set(tw)) > 1:
        st = "live"
    elif len(seen) > 1:
        st = "frozen"; frozen_axes.append(a)   # moves in the corpus, not in the window
    else:
        st = "flat"                  # never varied anywhere; cause unknowable from the log
    focus.append((a, st, len(set(tw))))
print("corpus: %d renders, %d distinct recipe-cells cumulative (window=%d)" % (N, distinct, W))
print("trailing %d-render spread: %d distinct cells (occ %.2f), %d newly-discovered" %
      (W, trailing, occ, recent_new))
print("per-factor spread: %s%s" % (
      "  ".join("%s=%s(%d)" % (a, st, k) for a, st, k in focus),
      ("   FROZEN: " + ",".join(frozen_axes) + " — the joint cell count cannot see this")
      if frozen_axes else ""))
print("COVERAGE cells=%d renders=%d trailing_occ=%d recent_new=%d focus=%s frozen=%d occ=%.2f verdict=%s" %
      (distinct, N, trailing, recent_new,
       ",".join("%s:%s" % (a, st) for a, st, _ in focus), len(frozen_axes), occ, verdict))
PYCOV
}

case "${1:-}" in
  --derive)
    shift; [ "$#" -ge 6 ] || { echo "usage: mesh-sound-reflex --derive <dyn> <act> <rich> <move> <cent> <beat_ms> [organ] [cov] [fdyn fact frich fmove fcent fbeat_ms]" >&2; exit 1; }
    derive "$1" "$2" "$3" "$4" "$5" "$6" "${7:-}" "${8:-na}" "${9:-na}" "${10:-na}" "${11:-na}" \
           "${12:-na}" "${13:-na}" "${14:-na}"; exit 0 ;;
  --ergodicity)
    # Same code path as a real derive (one implementation, not a second reader that can rot apart
    # from it) — the character values only pick which pct each axis is asked for; the eps estimate
    # and the per-axis estimator choice are the corpus's, not the record's.
    shift
    SR_ERG_REPORT=1 derive "${1:-0.3}" "${2:-0.3}" "${3:-0.6}" "${4:-0.14}" "${5:-1100}" "${6:-500}" "${7:-}"
    exit 0 ;;
  --basis-drift)
    # Same code path as a real derive, for the same reason --ergodicity is: the character values
    # only pick which pct each axis is asked for; the DRIFT is the corpus's, not the record's.
    shift
    SR_BASIS_REPORT=1 derive "${1:-0.3}" "${2:-0.3}" "${3:-0.6}" "${4:-0.14}" "${5:-1100}" "${6:-500}" "${7:-}"
    exit 0 ;;
  --regime)
    # Same code path as a real derive, same reason as the two above: the character values only pick
    # which pct each axis is asked for; the REGIME structure is the corpus's, not the record's.
    shift
    SR_REGIME_REPORT=1 derive "${1:-0.3}" "${2:-0.3}" "${3:-0.6}" "${4:-0.14}" "${5:-1100}" "${6:-500}" "${7:-}"
    exit 0 ;;
  --prior)
    # Same code path as a real derive, same reason as the three above — and this one has a second
    # duty: it is the acceptance artifact for "the frozen prior has rotted". Cached vs live, per
    # axis, from the live ledger, at call time.
    shift
    SR_PRIOR_REPORT=1 derive "${1:-0.3}" "${2:-0.3}" "${3:-0.6}" "${4:-0.14}" "${5:-1100}" "${6:-500}" "${7:-}"
    exit 0 ;;
  --marginal)
    # Same code path as a real derive, same reason --ergodicity/--basis-drift/--regime/--prior are:
    # the character values only pick which pct each axis is asked for; the MARGINAL is the corpus's,
    # not the record's. Read-only — it prints the per-value -log rho reward and exits before the
    # candidate enumeration, so it can never render or append anything.
    shift
    SR_MARGINAL_REPORT=1 derive "${1:-0.3}" "${2:-0.3}" "${3:-0.6}" "${4:-0.14}" "${5:-1100}" "${6:-500}" "${7:-}"
    exit 0 ;;
  --verdict) verdict "$2" "$3"; exit 0 ;;
  --failed)  failed_recipe "$2" "$3"; exit 0 ;;
  --poke)    poke "$2" "$3"; exit 0 ;;
  --drop-age-note) drop_age_note "$2"; exit 0 ;;   # TEST hook: the shipped clause, driven directly
  # --trim is the COMPLETING-DEFICIENCIES post-process, exposed as a subcommand for the same
  # reason --verdict/--poke/--failed are: the detached grind child reaches back through "$self",
  # so one implementation serves the child, the --test, and a mind driving it by hand. It NEVER
  # decides anything — it writes a trimmed file and the caller re-verifies.
  --trim)
    shift; [ "$#" -ge 2 ] || { echo "usage: mesh-sound-reflex --trim <in> <out>" >&2; exit 1; }
    trim_near_silent "$1" "$2"; exit $? ;;
  --status)
    # NO `|| echo 0` on grep -c: it PRINTS "0" and EXITS 1 on no match, so the fallback appends a
    # SECOND 0 and this renders "0\n0 pending" across two lines. Unreachable until pending could
    # actually reach 0 — which it never did while the no-candidate path stranded rows forever
    # (a656927). `wc -l` is fine (exit 0), but read it the same way rather than leave the trap armed.
    _sr_lines="$(wc -l < "$LEDGER" 2>/dev/null)"; _sr_pend="$(grep -c ' -> pending' "$LEDGER" 2>/dev/null)"
    echo "ledger:  $LEDGER (${_sr_lines:-0} lines, ${_sr_pend:-0} pending)"
    echo "anchor:  $(cat "$ANCHOR" 2>/dev/null | cut -c1-12 || echo none)"
    echo "poke:    $(( ($(now) - $(last_poke)) / 60 ))m ago (cooldown $((POKE_COOLDOWN/60))m)"
    echo "epsilon: $EPSILON vs last $RECENT renders"
    coverage | grep -v '^COVERAGE ' | sed 's/^/coverage:/'
    # The ranker's own assumption, on the pane rather than in a docstring: any axis off `pool` is an
    # axis where the ledger is a MIXTURE and the pooled percentile was ranking this organ's record
    # against another organ's distribution.
    SR_ERG_REPORT=1 derive 0.3 0.3 0.6 0.14 1100 500 "" 2>/dev/null | sed 's/^ERG /ergodic: /'
    exit 0 ;;
  --repick)
    # The re-pick pool, read-only — every ground source with its state and the bounds in force. No
    # derive, no render, no book write: a pane or a mind can ask "what would the lane do" without
    # the asking becoming a re-pick (the dry-run-that-writes-the-artifact trap).
    echo "bounds:  max=$REPICK_MAX/source · cooldown=$((REPICK_COOLDOWN/60))m · recipe wall=$REPICK_EPS (epsilon=$EPSILON)"
    _rp_last="$(awk '$2=="pick"{ for(i=1;i<=NF;i++) if($i ~ /^at=/){ split($i,a,"="); t=a[2] } } END{print t+0}' "$REPICK_LOG" 2>/dev/null)"
    if [ "${_rp_last:-0}" -gt 0 ] 2>/dev/null; then
      echo "last:    $(( ($(now) - _rp_last) / 60 ))m ago$(repick_inflight && echo ' · a remix is IN FLIGHT' || true)"
    else
      echo "last:    never$(repick_inflight && echo ' · a remix is IN FLIGHT' || true)"
    fi
    repick_pool | awk '{ st=$4; sub(/\(.*/,"",st); c[st]++; print }
                        END{ printf "pool:   "; for(k in c) printf " %s=%d", k, c[k]; print "" }'
    exit 0 ;;
  --coverage) coverage; exit $? ;;
  --test) : ;;
  "") : ;;
  *) echo "usage: mesh-sound-reflex [--derive ...|--status|--coverage|--repick|--ergodicity|--basis-drift|--regime|--prior|--trim <in> <out>|--test]"; exit 1 ;;
esac

if [ "${1:-}" = --test ]; then
  # tmp fence — task:doctor-test-tmpdir-cleanup-traps. Re-exec the smoke test ONCE under a private
  # TMPDIR and remove it from the PARENT, so the cleanup cannot be lost to the test's own `exit 1`
  # and cannot be clobbered by an EXIT trap the test sets for itself. A nested --test inherits the
  # guard var and skips its own fence (it is already inside one).
  if [ -z "${MESH_TEST_TMPD:-}" ]; then
    MESH_TEST_TMPD="$(mktemp -d)" || { echo "smoke-test: FAIL (tmp fence: mktemp -d)"; exit 1; }
    trap 'rm -rf "$MESH_TEST_TMPD"' EXIT INT HUP TERM
    export MESH_TEST_TMPD TMPDIR="$MESH_TEST_TMPD" TMP="$MESH_TEST_TMPD" TEMP="$MESH_TEST_TMPD"
    _fence_rc=0; "$0" "$@" || _fence_rc=$?; exit "$_fence_rc"
  fi
  f=0; tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT
  # TEST-SANDBOX: export so the detached "$0" children divert too; %y sig gate before ok.
  export MESH_TEST_SANDBOX=1
  # ATTRIBUTION, not repetition, for the sandbox honesty gate below. The two artifacts it watches
  # (room lease + failed store) have exactly ONE other writer on this node — this tool's own */10
  # cron tick — and the live path is already single-writer under $LOCK. So HOLD that same lock for
  # the whole test: a colliding tick then SKIPS (its own "another tick holds the lock" path, not an
  # error) instead of stamping the artifacts mid-test, so a moved mtime can only be OUR leak and one
  # sample decides. Without it the gate went red 2026-08-20T09:50Z with nothing wrong — the sig moved
  # 09:40:04 -> 09:50:04, both exact */10 boundaries, i.e. the live cron tick wrote them inside the
  # test window; that false red blocks mesh-land. Lock already held => exit 2 (honest n/a: a live
  # grind is in flight and the gate cannot attribute), never a pass and never a FAIL.
  # fd 9 on purpose: it is the live path's own lock fd, so the detached-child spawn path's existing
  # `9>&-` closes it in children and the lock cannot outlive this process.
  exec 9>"$LOCK" 2>/dev/null || true
  if command -v flock >/dev/null 2>&1; then
    flock -n 9 || { echo "smoke-test: n/a (a live sound-reflex tick holds $LOCK — the sandbox honesty gate cannot attribute artifact writes while another writer runs)"; exit 2; }
  fi
  _sr_room="$HOME/.mesh/.sound-reflex-room"; _sr_flog="$HOME/.mesh/.sound-reflex-failed.log"
  _sr_sig="$(stat -c '%y %s' "$_sr_room" 2>/dev/null || echo A);$(stat -c '%y %s' "$_sr_flog" 2>/dev/null || echo A)"
  command -v python3 >/dev/null 2>&1 || { echo "smoke-test: n/a (no python3)"; exit 2; }
  LEDGER="$tmp/ledger"; PARAMS_LOG="$tmp/params"; ANCHOR="$tmp/anchor"; LASTPOKE="$tmp/lastpoke"
  NOTABLE="$tmp/notable"; FAILED_LOG="$tmp/failed"; : > "$PARAMS_LOG"; : > "$FAILED_LOG"
  ROOM="$tmp/room"   # rebind the load-time global too — export≠rebind: the parent's in-process
                     # derive() writes used the LIVE-bound ROOM (8 truncs/smoke) despite the export
  INBOX_DIR="$tmp/inbox"; mkdir -p "$INBOX_DIR"   # same rebind — inbox_note must never scan the LIVE inbox

  # A corpus with real spread, so corpus_pct has >=8 values and ranks rather than falling back.
  for i in 1 2 3 4 5 6 7 8 9; do
    printf '2026-07-15T00:0%dZ ear h%d dur=18.0 score=4%d beats=6 [x] dyn=0.%d act=0.%d rich=0.6%d move=0.1%d cent=11%d0 -> pending\n' \
      "$i" "$i" "$i" "$((i))" "$((i))" "$i" "$i" "$i" >> "$LEDGER"
  done

  # 1. CHARACTER DRIVES THE PARAMS — a busy source and a sparse one must not come out the same.
  #    This is the whole "not trivial or boring" ask; if this fails the reflex is blind rotation.
  busy="$(derive 0.30 0.90 0.60 0.14 1100 500)"
  sparse="$(derive 0.30 0.01 0.60 0.14 1100 500)"
  echo "  busy:   $busy"
  echo "  sparse: $sparse"
  bf="${busy##* f }"; bf="${bf%% *}"; sf="${sparse##* f }"; sf="${sf%% *}"
  case "$busy$sparse" in *WALKED-OUT*) echo "  FAIL: derive walked out on an empty params log"; f=1;; esac
  awk -v b="$bf" -v s="$sf" 'BEGIN{exit !(b+0 < s+0)}' \
    || { echo "  FAIL: busy source (act .90) got grain factor $bf, sparse (act .01) got $sf — busy must grind SHORTER, else the axis is inverted or ignored"; f=1; }

  # 2. dyn drives the TRACK speed, and in the right direction (dynamic -> slower).
  dynamic="$(derive 0.95 0.30 0.60 0.14 1100 500)"; even="$(derive 0.02 0.30 0.60 0.14 1100 500)"
  ds="$(grep -oE '(^| )s [0-9.]+' <<<"$dynamic" | tail -1 | grep -oE '[0-9.]+')"
  es="$(grep -oE '(^| )s [0-9.]+' <<<"$even" | tail -1 | grep -oE '[0-9.]+')"
  awk -v d="$ds" -v e="$es" 'BEGIN{exit !(d+0 < e+0)}' \
    || { echo "  FAIL: dynamic source got track speed $ds, even got $es — dynamic must be SLOWER"; f=1; }

  # 2b. THE BAND MUST CONTAIN THE MATERIAL. `c` is picked by centroid percentile, and the brightest
  #     sextile got `c 40,400` — a 40..400 Hz bandpass. But a HIGH centroid is exactly the material
  #     whose energy sits ABOVE 400 Hz: over 638 real records the corpus centroid ran 808..2661 Hz,
  #     so ZERO of them had anything in 40..400 — the band gutted every record it was handed and the
  #     grinder verdicted the empty output `skip:degenerate` (23f0cb87 cent=1740 -> c 40,400, empty;
  #     one of two such in 30 min, 2026-07-17). A band chosen FOR a centroid must include that
  #     centroid, not exclude it. Drive a bright source and assert the band's high edge >= its cent.
  bright="$(derive 0.30 0.30 0.60 0.14 1200 500)"   # cent 1200 > seed max (1190) -> top sextile
  echo "  bright: $bright"
  bhi="$(grep -oE 'c [0-9,;]+' <<<"$bright" | grep -oE '[0-9]+' | sort -n | tail -1)"
  awk -v hi="${bhi:-0}" -v cent=1200 'BEGIN{exit !(hi+0 >= cent+0)}' \
    || { echo "  FAIL: bright source (cent 1200) got a band whose high edge is ${bhi:-none} Hz — below its own centroid, so the bandpass discards the material's dominant energy and the grind comes out empty (the c 40,400 degenerate-generator)"; f=1; }

  # 2c. TEMPO ROTATES BY LEVEL (operator 2026-07-17 "дышать по уровням, не крутить близкие грувы").
  #     Seed the last two renders in FAST (s 1.5) then SLOW (s 0.25); an EVEN source's IDEAL tempo is
  #     fast (dynamic→slow, so even→fast), yet the derive must be forced into the one remaining level
  #     — MID — never back into an excluded band. Combo-distance dedup alone would happily return
  #     another FAST value (2.0/3.0), differing enough overall to clear epsilon: this asserts the BAND
  #     moved, which is the axis the operator actually hears. FAILS against the old any-band selection.
  : > "$PARAMS_LOG"
  printf '2026-07-15T00:00Z amc l 300 w 6 ss 1.0 s 1.5 ~ src=ear/hA beat 500 f 1 band fast\n' >> "$PARAMS_LOG"
  printf '2026-07-15T00:01Z amc l 300 w 6 ss 1.0 s 0.25 ~ src=ear/hB beat 500 f 1 band slow\n' >> "$PARAMS_LOG"
  banded="$(derive 0.02 0.30 0.60 0.14 1100 500)"    # even source → ideal tempo FAST
  echo "  banded: $banded"
  bs="$(grep -oE '(^| )s [0-9.]+' <<<"$banded" | tail -1 | grep -oE '[0-9.]+')"
  bband="$(awk -v v="$bs" 'BEGIN{ if(v+0<=0.5) print "slow"; else if(v+0<=1.25) print "mid"; else print "fast" }')"
  [ "$bband" = "mid" ] \
    || { echo "  FAIL: last 2 renders were fast+slow, even source derived s=$bs (band $bband) — tempo must rotate to the one remaining LEVEL, mid, not stay in an excluded band"; f=1; }
  : > "$PARAMS_LOG"    # restore empty history for the deterministic novelty test below

  # 2d. THE POOLED RANK SATURATES ON A NON-ERGODIC CORPUS — and the fix must fire ONLY there.
  #     corpus_pct's docstring says ranking against the live corpus "cannot saturate". That is an
  #     ergodic claim: true for ONE population, false for a mixture. Build a ledger that is two
  #     disjoint populations on `move` (a quiet organ far below a loud one) and identical on the
  #     other axes, then drive the two EXTREME records of the quiet organ through derive:
  #       - pooled: both land in the bottom fifth of the pooled CDF -> the SAME w. Constant organ.
  #       - corrected: ranked inside their own organ they are its min and its max -> w must MOVE.
  #     The OFF leg (SR_ERG_EPS=9, switch unreachable) asserts the defect is real rather than
  #     hypothetical — this gate has been SEEN red, it is not a gate nobody has watched fail.
  #     And `dyn`, whose two organs overlap completely, must stay on the POOLED estimator: a
  #     correction that fires on an ergodic axis is just a noisier ranker with fewer samples.
  _sr_led_save="$LEDGER"; LEDGER="$tmp/ledger-mix"; : > "$LEDGER"
  awk 'BEGIN{
         for(i=1;i<=24;i++) printf "2026-07-20T00:00Z drop d%02d dur=18.0 score=50 beats=6 [x] dyn=0.%d act=0.300 rich=0.600 move=0.8%02d cent=1100 -> pending\n", i, (i%8)+1, i;
         for(j=1;j<=8;j++)  printf "2026-07-20T01:00Z hum  q%02d dur=18.0 score=50 beats=6 [x] dyn=0.%d act=0.300 rich=0.600 move=0.1%d cent=1100 -> pending\n", j, j, j;
       }' >> "$LEDGER"
  erg="$(SR_ERG_REPORT=1 derive 0.3 0.3 0.6 0.11 1100 500 hum)"
  echo "$erg" | sed 's/^/  /'
  _e_move="$(awk '$2=="move"{sub(/eps=/,"",$3); print $3}' <<<"$erg")"
  awk -v e="${_e_move:-0}" 'BEGIN{exit !(e+0 >= 0.9)}' \
    || { echo "  FAIL: two disjoint organs on move measured eps=${_e_move:-n/a} — the ergodicity coefficient does not see a mixture it is looking straight at"; f=1; }
  case "$erg" in
    *"ERG dyn"*"-> pool"*) : ;;
    *) echo "  FAIL: dyn's two organs are drawn from the same range, yet the ranker left the POOLED estimator — the correction fires on an ergodic axis, trading samples for nothing"; f=1;;
  esac
  _w_lo_on="$(derive  0.3 0.3 0.6 0.11 1100 500 hum | grep -oE '(^| )w [0-9]+' | tail -1 | grep -oE '[0-9]+')"
  _w_hi_on="$(derive  0.3 0.3 0.6 0.18 1100 500 hum | grep -oE '(^| )w [0-9]+' | tail -1 | grep -oE '[0-9]+')"
  # NB: ERG_EPS, not SR_ERG_EPS — the tunable is bound ONCE at load time, so a command-prefix
  # SR_ERG_EPS=9 in front of an in-process function call rebinds nothing and both legs would run
  # CORRECTED, agreeing trivially. Caught by the corpus-reproduces-the-defect assertion above on the
  # first run of this very test (the export≠rebind-a-load-time-global family).
  _w_lo_off="$(ERG_EPS=9 derive 0.3 0.3 0.6 0.11 1100 500 hum | grep -oE '(^| )w [0-9]+' | tail -1 | grep -oE '[0-9]+')"
  _w_hi_off="$(ERG_EPS=9 derive 0.3 0.3 0.6 0.18 1100 500 hum | grep -oE '(^| )w [0-9]+' | tail -1 | grep -oE '[0-9]+')"
  echo "  mixture w: pooled ${_w_lo_off}/${_w_hi_off} · corrected ${_w_lo_on}/${_w_hi_on} (quiet organ's min/max record)"
  [ -n "$_w_lo_off" ] && [ "$_w_lo_off" = "$_w_hi_off" ] \
    || { echo "  FAIL: the pooled ranker gave the quiet organ's min and max records w=${_w_lo_off:-none}/${_w_hi_off:-none} — the test corpus does not reproduce the saturation this fix exists to remove, so the green below proves nothing"; f=1; }
  [ -n "$_w_lo_on" ] && [ "$_w_lo_on" != "$_w_hi_on" ] \
    || { echo "  FAIL: ranked inside its own organ the quiet organ's min and max records STILL derive the same w=${_w_lo_on:-none} — the axis is dead for that organ exactly as before"; f=1; }
  LEDGER="$_sr_led_save"; unset _sr_led_save _e_move erg _w_lo_on _w_hi_on _w_lo_off _w_hi_off

  # 2f. THE RULER MOVES WHILE THE RECORD DOES NOT (--basis-drift; FEP window-freeze review
  #     2026-08-03, arXiv:2607.16858 "A window-based freeze of all reward-defining objects").
  #     2d fixed WHICH population the percentile ranks against; nothing asked WHEN that population
  #     is allowed to change. It changes on every sweep — records.log is appended and pruned — so a
  #     record can land in a different param slot with no change to the record. Two legs, because a
  #     drift detector that fires on a stationary corpus is measuring its own noise:
  #       DRIFT  — 20 recent records a full band above the older 30 -> move-slot flips MUST be > 0.
  #       STABLE — 30 older + 20 recent with the IDENTICAL empirical distribution -> flips MUST be 0.
  #     The stable leg has to be EXACTLY stationary (10 values x3 older, x2 recent — same relative
  #     frequencies), not merely "same range": a first cut cycled 15 values into 30/20 rows, which
  #     leaves the two halves with unequal multiplicities, and that alone moved `move` by up to .060
  #     and flipped 2 of 20 slots. A control that is only approximately stationary measures its own
  #     resampling noise and quietly raises the floor the DRIFT leg has to clear.
  #     Each leg is the other's red: the DRIFT assertion run against the STABLE ledger fails, and
  #     the STABLE assertion run against the DRIFT ledger fails. Seen both ways.
  _sr_led_save="$LEDGER"
  _sr_flips(){ awk '$2=="move"{for(i=1;i<=NF;i++) if($i ~ /^slot_flips=/){sub(/slot_flips=/,"",$i); print $i}}'; }
  LEDGER="$tmp/ledger-drift"; : > "$LEDGER"
  awk 'BEGIN{
         for(i=1;i<=30;i++) printf "2026-07-20T00:00Z drop o%02d dur=18.0 score=50 beats=6 [x] dyn=0.300 act=0.300 rich=0.600 move=0.%02d cent=1100 -> pending\n", i, 10+i;
         for(j=1;j<=20;j++) printf "2026-07-21T00:00Z drop r%02d dur=18.0 score=50 beats=6 [x] dyn=0.300 act=0.300 rich=0.600 move=0.%02d cent=1100 -> pending\n", j, 60+j;
       }' >> "$LEDGER"
  _drift="$(SR_BASIS_K=20 SR_BASIS_REPORT=1 derive 0.3 0.3 0.6 0.14 1100 500 drop)"
  echo "$_drift" | sed 's/^/  /'
  _d_on="$(printf '%s\n' "$_drift" | _sr_flips)"
  awk -v v="${_d_on:-0}" 'BEGIN{exit !(v+0 > 0)}' \
    || { echo "  FAIL: the last 20 records arrived a full band above the older 30 — every one of them ranks differently under the two bases — yet --basis-drift reports ${_d_on:-n/a} move-slot flips. The ranker's basis moves under unchanged records and the report cannot see it."; f=1; }
  LEDGER="$tmp/ledger-stable"; : > "$LEDGER"
  awk 'BEGIN{
         for(i=1;i<=30;i++) printf "2026-07-20T00:00Z drop s%02d dur=18.0 score=50 beats=6 [x] dyn=0.300 act=0.300 rich=0.600 move=0.%02d cent=1100 -> pending\n", i, 10+(i%10);
         for(j=1;j<=20;j++) printf "2026-07-21T00:00Z drop t%02d dur=18.0 score=50 beats=6 [x] dyn=0.300 act=0.300 rich=0.600 move=0.%02d cent=1100 -> pending\n", j, 10+(j%10);
       }' >> "$LEDGER"
  _stable="$(SR_BASIS_K=20 SR_BASIS_REPORT=1 derive 0.3 0.3 0.6 0.14 1100 500 drop)"
  _d_off="$(printf '%s\n' "$_stable" | _sr_flips)"
  [ "${_d_off:-x}" = "0" ] \
    || { echo "  FAIL: 50 records cycling the SAME 15 move values are one stationary population, yet --basis-drift reports ${_d_off:-n/a} move-slot flips — the report is measuring sample noise and would call a healthy corpus drifting"; f=1; }
  LEDGER="$_sr_led_save"; unset _sr_led_save _drift _stable _d_on _d_off; unset -f _sr_flips

  # 2g. IS THE BASIS ONE POPULATION IN TIME? (--regime; FEP/BME review 2026-08-04)
  #     Every leg drives the REAL estimator (mesh-precision --bme) through the real report path —
  #     no stub, no injected verdict. A wrapper's test that never invokes the thing it wraps is the
  #     whisper.cpp trap, and this report's entire content is that other tool's answer.
  echo "TEST 2g: --regime — a temporal split in the ranking basis, and what it would buy"
  _sr_led_save="$LEDGER"
  _sr_mv(){ awk '$2=="move"'; }                       # the move axis carries every fixture's structure
  _sr_flips(){ awk '/^REGIME total/{for(i=1;i<=NF;i++) if($i ~ /^slot_flips=/){sub(/slot_flips=/,"",$i); print $i}}'; }
  # (i) TWO REGIMES inside one organ: 30 records at move~0.1x then 30 at move~0.6x. The estimator
  #     must find the split, the tail must clear the floor, and re-ranking the last 20 against the
  #     CURRENT regime instead of the whole history must move real param slots — otherwise the
  #     report is describing a restriction that changes nothing and is not worth reading.
  LEDGER="$tmp/ledger-regime-two"; : > "$LEDGER"
  awk 'BEGIN{
         for(i=1;i<=30;i++) printf "2026-07-20T00:00Z drop a%02d dur=18.0 score=50 beats=6 [x] dyn=0.300 act=0.300 rich=0.600 move=0.%02d cent=1100 -> pending\n", i, 10+(i%6);
         for(i=1;i<=30;i++) printf "2026-07-21T00:00Z drop b%02d dur=18.0 score=50 beats=6 [x] dyn=0.300 act=0.300 rich=0.600 move=0.%02d cent=1100 -> pending\n", i, 60+(i%6);
       }' >> "$LEDGER"
  _rg_two="$(SR_REGIME_K=20 SR_REGIME_REPORT=1 derive 0.3 0.3 0.6 0.14 1100 500 drop | _sr_mv)"
  echo "  two:    $_rg_two"
  case "$_rg_two" in
    *"drop:EXPAND@"*) : ;;
    *) echo "  FAIL: 30 records at move~0.1 followed by 30 at move~0.6 are two regimes by construction, yet --regime reports '${_rg_two:-<no move line>}'. Either the estimator was never reached or its EXPAND verdict is not being read."; f=1;;
  esac
  _rg_n="$(printf '%s\n' "$_rg_two" | awk '{for(i=1;i<=NF;i++) if($i ~ /^slot_flips=/){sub(/slot_flips=/,"",$i); print $i}}')"
  awk -v v="${_rg_n:-0}" 'BEGIN{exit !(v+0 > 0)}' \
    || { echo "  FAIL: the basis is two regimes and the current one is a full band away from the old, yet restricting to it flips ${_rg_n:-n/a} w-slots. The report would be announcing a split with no consequence."; f=1; }
  # (ii) CONTROL — one regime, 60 records cycling the same 15 move values. Each leg is the other's
  #      red: this assertion run against the two-regime ledger fails, and (i)'s against this one.
  LEDGER="$tmp/ledger-regime-one"; : > "$LEDGER"
  awk 'BEGIN{ for(i=1;i<=60;i++) printf "2026-07-20T00:00Z drop c%02d dur=18.0 score=50 beats=6 [x] dyn=0.300 act=0.300 rich=0.600 move=0.%02d cent=1100 -> pending\n", i, 10+(i%15); }' >> "$LEDGER"
  _rg_one="$(SR_REGIME_K=20 SR_REGIME_REPORT=1 derive 0.3 0.3 0.6 0.14 1100 500 drop)"
  echo "  one:    $(printf '%s\n' "$_rg_one" | _sr_mv)"
  case "$(printf '%s\n' "$_rg_one" | _sr_mv)" in
    *"drop:PARSIMONIOUS"*"basis unchanged"*) : ;;
    *) echo "  FAIL: 60 records cycling the SAME 15 move values are ONE population, yet --regime does not report drop:PARSIMONIOUS + basis unchanged. The report manufactures splits out of sample noise."; f=1;;
  esac
  [ "$(printf '%s\n' "$_rg_one" | _sr_flips)" = "0" ] \
    || { echo "  FAIL: a stationary corpus reports $(printf '%s\n' "$_rg_one" | _sr_flips) total slot_flips — restricting a basis that has no split cannot change a slot."; f=1; }
  # (iii) THE MIX-SHIFT CONFOUND, which is the whole reason the report reads BOTH ways. Two organs,
  #       each internally stationary, whose MIXING PROPORTIONS flip halfway. The pooled sequence is
  #       two regimes and says so; no organ's own tape moved, so the basis must NOT be restricted.
  #       Without the per-organ read this fixture would buy a split that corrects nothing — and it
  #       is exactly the alternative explanation the live dyn finding had to survive.
  LEDGER="$tmp/ledger-regime-mix"; : > "$LEDGER"
  awk 'BEGIN{
         for(i=1;i<=30;i++){ printf "2026-07-20T00:00Z scape s%02d dur=18.0 score=50 beats=6 [x] dyn=0.300 act=0.300 rich=0.600 move=0.%02d cent=1100 -> pending\n", i, 10+(i%6);
           if(i%6==0) printf "2026-07-20T00:00Z drop d%02d dur=18.0 score=50 beats=6 [x] dyn=0.300 act=0.300 rich=0.600 move=0.%02d cent=1100 -> pending\n", i, 70+(i%6); }
         for(i=31;i<=60;i++){ printf "2026-07-21T00:00Z drop d%02d dur=18.0 score=50 beats=6 [x] dyn=0.300 act=0.300 rich=0.600 move=0.%02d cent=1100 -> pending\n", i, 70+(i%6);
           if(i%6==0) printf "2026-07-21T00:00Z scape s%02d dur=18.0 score=50 beats=6 [x] dyn=0.300 act=0.300 rich=0.600 move=0.%02d cent=1100 -> pending\n", i, 10+(i%6); }
       }' >> "$LEDGER"
  _rg_mix="$(SR_REGIME_K=20 SR_REGIME_REPORT=1 derive 0.3 0.3 0.6 0.14 1100 500 drop | _sr_mv)"
  echo "  mix:    $_rg_mix"
  case "$_rg_mix" in
    *"pooled=EXPAND"*"drop:PARSIMONIOUS"*"scape:PARSIMONIOUS"*"basis unchanged"*) : ;;
    *) echo "  FAIL: a pure MIXING-PROPORTION shift (both organs stationary, their ratio flipped) must read pooled=EXPAND with every organ PARSIMONIOUS and the basis left alone; got '${_rg_mix:-<no move line>}'. The pooled read alone would restrict the basis to correct a mixture the organ split already handles."; f=1;;
  esac
  # (iv) A REAL SPLIT WHOSE CURRENT REGIME IS TOO THIN. 40 records then 8: the split is genuine, the
  #      tail is below SR_REGIME_MIN, and a basis of 8 is noise (corpus_pct's own <8 floor). It must
  #      be named NOT-ADOPTED rather than silently taken or silently dropped.
  LEDGER="$tmp/ledger-regime-thin"; : > "$LEDGER"
  awk 'BEGIN{
         for(i=1;i<=40;i++) printf "2026-07-20T00:00Z drop e%02d dur=18.0 score=50 beats=6 [x] dyn=0.300 act=0.300 rich=0.600 move=0.%02d cent=1100 -> pending\n", i, 10+(i%6);
         for(i=1;i<=8;i++)  printf "2026-07-21T00:00Z drop f%02d dur=18.0 score=50 beats=6 [x] dyn=0.300 act=0.300 rich=0.600 move=0.%02d cent=1100 -> pending\n", i, 70+(i%6);
       }' >> "$LEDGER"
  _rg_thin="$(SR_REGIME_K=20 SR_REGIME_REPORT=1 derive 0.3 0.3 0.6 0.14 1100 500 drop | _sr_mv)"
  echo "  thin:   $_rg_thin"
  case "$_rg_thin" in
    *"EXPAND@"*"NOT-ADOPTED"*"basis unchanged"*) : ;;
    *) echo "  FAIL: a genuine split leaving only 8 records in the current regime must render EXPAND ... NOT-ADOPTED and leave the basis alone (a basis of 8 is below the noise floor corpus_pct already refuses); got '${_rg_thin:-<no move line>}'."; f=1;;
  esac
  # (v) THE ESTIMATOR IS THE REPORT. Point SR_BME_BIN at nothing and re-run the TWO-REGIME ledger:
  #     "could not ask" must render n/a and restrict nothing. If it renders PARSIMONIOUS instead,
  #     a dead mesh-precision reads as a healthy single-regime corpus forever — the silent fallback.
  LEDGER="$tmp/ledger-regime-two"
  _rg_dead="$(SR_BME_BIN=/nonexistent/no-such-estimator SR_REGIME_K=20 SR_REGIME_REPORT=1 derive 0.3 0.3 0.6 0.14 1100 500 drop | _sr_mv)"
  echo "  dead:   $_rg_dead"
  case "$_rg_dead" in
    *PARSIMONIOUS*|*EXPAND*) echo "  FAIL: with the estimator absent, --regime reports '${_rg_dead}' — a verdict it cannot possibly have. 'Could not ask' must never render as an answer."; f=1;;
    *"n/a(estimator unreachable"*"basis unchanged"*) : ;;
    *) echo "  FAIL: with the estimator absent, --regime must say so and leave the basis alone; got '${_rg_dead:-<no move line>}'."; f=1;;
  esac
  LEDGER="$_sr_led_save"
  unset _sr_led_save _rg_two _rg_one _rg_mix _rg_thin _rg_dead _rg_n; unset -f _sr_mv _sr_flips

  # 2h. THE WINDOW IS NOT THE SOURCE — the coverage-weighted fold actually FOLDS (task
  #     sound-derive-coverage-weighted). This leg exists because the fold shipped INERT: it blends
  #     only once the whole-file corpus holds 8 values, those values arrive only on rows measured
  #     after 2e1843d, and 24 minutes past deploy the live ledger carried f* on 1 row of 710 at an
  #     arrival rate of ~2 records/h. So on the real corpus every axis answered
  #     "win(f-corpus n=1<8)" and the fold had never once executed — live, honest, green, and
  #     unexercised. A path whose first production run is hours away is a path nobody has SEEN run
  #     (CLAIMS: passing --test and running are unrelated facts); drive it here with a corpus that
  #     is full by construction. Three legs, because each of the other two is this one's control:
  #       FOLDS   — cov=0.03 with a 14-value f corpus must report basis=blend AND land a different
  #                 recipe than the same record derived window-only. A fold that fires but moves
  #                 nothing is decoration.
  #       IDENTITY— cov=1 must be byte-identical to no-cov. This is the docstring's own promise
  #                 ("a fully-covered record can never regress"); it is the reason there is no
  #                 threshold to tune, so it must be asserted, not assumed.
  #       BLIND   — an f corpus under 8 must stay on the window and NAME the reason. Never a
  #                 fabricated 0.5 blended in from an empty PRIOR, and never silent about it.
  _sr_led_save="$LEDGER"
  LEDGER="$tmp/ledger-fcorpus"
  awk 'BEGIN{
         for(i=1;i<=14;i++) printf "2026-08-18T0%d:00Z drop q%02d dur=100.0 win=3.0 cov=0.030 score=50 beats=6 [x] dyn=0.%02d act=0.%02d rich=0.600 move=0.%02d cent=1100 fbeats=90 fdyn=0.%02d fact=0.%02d frich=0.400 fmove=0.%02d fcent=1000 -> pending\n", (i%9)+1, i, 60+i, 60+i, 80+i, 20+i, 20+i, 30+i;
       }' > "$LEDGER"
  _cv_win="$(derive 0.70 0.70 0.60 0.90 1100 430 drop)"
  _cv_bl="$(derive 0.70 0.70 0.60 0.90 1100 430 drop 0.030 0.25 0.25 0.40 0.35 1000 515)"
  _cv_one="$(derive 0.70 0.70 0.60 0.90 1100 430 drop 1.0 0.25 0.25 0.40 0.35 1000 515)"
  echo "  cov fold: win-only -> ${_cv_win#RECIPE }"
  echo "            blended  -> ${_cv_bl#RECIPE }"
  case "$_cv_bl" in
    *"basis blend"*) : ;;
    *) echo "  FAIL: a cov=0.03 record against a 14-value whole-file corpus must fold — got '$(printf '%s' "$_cv_bl" | grep -o 'basis .*')'. The corpus is full by construction, so anything but blend means the fold cannot reach its own corpus and would sit inert forever."; f=1;;
  esac
  # The AXES must move a param, and that has to be asserted with the BEAT FOLD HELD NEUTRAL. The
  # beat period is folded on its own terms (no corpus, no floor), and grain l = beat x f, so a
  # blended beat alone changes the recipe — a plain "_cv_bl != _cv_win" passes on the beat fold
  # while the axis fold is dead. Seen: neutering `return cov*p + (1-cov)*pf` to `return p` survived
  # that comparison. So re-derive with f_beat_ms = the window's own 430: now every difference is
  # the percentile fold, and there is nothing else left to carry the assertion.
  # Compare what RENDERS, not the annotation. EVERY blended derive stamps `cov 0.030 basis
  # blend/blend` where a no-cov one stamps `cov na basis win/win`, so a raw string compare of the
  # two lines is ALWAYS unequal and asserts nothing about the params — that is how the first cut of
  # this leg survived neutering the fold to `return p`.
  _cv_bare(){ sed 's/ cov [^ ]* basis .*//'; }
  # THE TWO FOLDS ARE SEPARATE AND EACH IS THE OTHER'S CAMOUFLAGE. The axes fold through the corpus
  # percentile; the beat folds on its own (no corpus, no floor), and grain l = beat x f, so a moved
  # beat drags l with it. Passing f_beat_ms = the window's own 430 does NOT neutralise the beat
  # either: 0.03*430 + 0.97*430 evaluates to 429.99999999999994 and int()s to 429, which moves l
  # 220 -> 210 all by itself. So `l` and `beat` are masked out here and asserted in their OWN leg
  # below; what remains (w, s, ss, c, mode, pr/lk, rv, env, f) is axis-driven only.
  _cv_axbare(){ sed -e 's/ cov [^ ]* basis .*//' -e 's/ l [0-9]* / l _ /' -e 's/beat [0-9]*/beat _/'; }
  _cv_ax="$(derive 0.70 0.70 0.60 0.90 1100 430 drop 0.030 0.25 0.25 0.40 0.35 1000 430)"
  [ "$(printf '%s' "$_cv_ax" | _cv_axbare)" != "$(printf '%s' "$_cv_win" | _cv_axbare)" ] \
    || { echo "  FAIL: with l and beat masked out, the blended derive lands the identical axis-driven params as window-only. The whole-file axes (act .25/move .35 against window .70/.90) are a band away in their own corpus, so the percentile fold MUST move one of w/s/ss/c/mode/rv/env/f — reporting blend and returning the window percentile is decoration."; f=1; }
  # BEAT FOLD, on its own terms: hand it whole-file axes IDENTICAL to the window ones (so the
  # percentile fold is a genuine no-op) and a whole-file period a long way from the window's. The
  # beat MUST move toward it. Without this leg, deleting the beat fold outright changes nothing any
  # assertion here can see.
  _cv_bt="$(derive 0.70 0.70 0.60 0.90 1100 430 drop 0.030 0.70 0.70 0.60 0.90 1100 900)"
  _cv_btv="$(printf '%s' "$_cv_bt" | grep -o 'beat [0-9]*' | grep -o '[0-9]*')"
  awk -v b="${_cv_btv:-0}" 'BEGIN{exit !(b+0 > 860 && b+0 < 900)}' \
    || { echo "  FAIL: cov=0.03 with a whole-file period of 900ms against the window's 430ms must fold to ~886ms (0.03*430 + 0.97*900); got beat=${_cv_btv:-n/a}. The beat is an absolute duration read by the same detector over both spans — it needs no corpus and has no excuse to stay on the window."; f=1; }
  [ "$(printf '%s' "$_cv_one" | _cv_bare)" = "$(printf '%s' "$_cv_win" | _cv_bare)" ] \
    || { echo "  FAIL: cov=1 must degenerate to the old derive (the docstring's no-regression promise, and why there is no threshold to tune); got '$(printf '%s' "$_cv_one" | _cv_bare)' vs '$(printf '%s' "$_cv_win" | _cv_bare)'."; f=1; }
  head -6 "$tmp/ledger-fcorpus" > "$tmp/ledger-fthin"; LEDGER="$tmp/ledger-fthin"
  _cv_thin="$(derive 0.70 0.70 0.60 0.90 1100 430 drop 0.030 0.25 0.25 0.40 0.35 1000 515)"
  case "$_cv_thin" in
    *"basis win(f-corpus n=6<8)"*) : ;;
    *) echo "  FAIL: a 6-value whole-file corpus is below the percentile floor and must stay on the window AND say which n it saw; got '$(printf '%s' "$_cv_thin" | grep -o 'basis .*')'. Blending against 6 values ranks a reading against noise, and a 6-row corpus is far below the floor at which an f-axis prior gets measured either."; f=1;;
  esac
  LEDGER="$_sr_led_save"; unset _sr_led_save _cv_win _cv_bl _cv_ax _cv_bt _cv_btv _cv_one _cv_thin; unset -f _cv_bare _cv_axbare

  # 2i. THE THIN-CORPUS FALLBACK RANKS AGAINST A MEASURED CENTRE, NOT A CONSTANT
  #     (task sound-reflex-prior-medians-frozen-at-n29, 2026-08-19). Below 8 records an axis cannot
  #     be ranked, so corpus_pct answers from a per-axis centre instead. That centre used to be five
  #     numbers measured at n=29 on 2026-07-15 and frozen into the source; against the live ledger
  #     (n=1306) they had rotted +37/+14/+3/+103/+51% — a record was being told it was high-motion
  #     while sitting below the corpus median. Three legs, because "it reads a file now" is not the
  #     claim:
  #       LOAD-BEARING — the same record, two caches differing ONLY in `move`, must derive a
  #                      DIFFERENT w. A cache that is read but not used is the frozen number wearing
  #                      a new coat.
  #       NO CONSTANT  — thin corpus and NO cache must fall to THIS corpus's own median, marked
  #                      `thin(...)`, and an EMPTY axis to a marked no-rank `none(...)`. Never a
  #                      number from another corpus. This is the leg that fails if a default returns.
  #                      The middle rung is not decoration: dropping it (no cache -> 0.5) was tried
  #                      and turned gates 9a/9c red — every axis at 0.5 is a constant recipe until
  #                      the 8th record lands, which is worse than the rot this task removes.
  #       REFRESHED    — a fat corpus must WRITE the measured median back, beside ITS OWN ledger.
  #                      The path is bound at derive() call time, not at load: bound at load the
  #                      --test would refresh the LIVE prior off a synthetic corpus, i.e. a dry-run
  #                      forging the durable artifact it exists to check.
  _sr_led_save="$LEDGER"; _sr_pc_save="${SR_PRIOR_CACHE_SET:-}"
  _sr_live_prior="${MESH:-$HOME/.mesh}/records.prior"
  _sr_live_before="$(stat -c %Y "$_sr_live_prior" 2>/dev/null || echo none)"
  LEDGER="$tmp/ledger-thin"; : > "$LEDGER"
  awk 'BEGIN{for(i=1;i<=5;i++) printf "2026-08-19T00:00Z drop t%02d dur=18.0 score=50 beats=6 [x] dyn=0.300 act=0.300 rich=0.600 move=0.300 cent=1100 -> pending\n", i}' >> "$LEDGER"
  # NO cache: nothing measured to rank against -> no rank, and it must SAY no rank.
  rm -f "$tmp/ledger-thin.prior"
  SR_PRIOR_CACHE_SET="$tmp/ledger-thin.prior"
  _pr_none="$(SR_ERG_REPORT=1 derive 0.30 0.30 0.60 0.30 1100 500 drop | awk '$2=="move"{print $NF}')"
  case "$_pr_none" in
    thin\(0.3,n=5\)) : ;;
    *) echo "  FAIL: a 5-record corpus with no measured prior reported move -> '${_pr_none:-nothing}'. With no prior yet measured the centre must be THIS corpus's own median, named as the thin thing it is — never a number carried over from another corpus."; f=1;;
  esac
  # ...and an axis with NOTHING in it does not rank at all. This is the rung that has to stay
  # unreachable-by-constant: an empty corpus is the only case where there is no measured centre.
  : > "$LEDGER"
  _pr_empty="$(SR_ERG_REPORT=1 derive 0.30 0.30 0.60 0.30 1100 500 drop | awk '$2=="move"{print $NF}')"
  case "$_pr_empty" in
    none\(n=0,no-prior\)) : ;;
    *) echo "  FAIL: an EMPTY corpus with no cache reported move -> '${_pr_empty:-nothing}' instead of a marked no-rank — there is nothing measured on this node, so any number is invented."; f=1;;
  esac
  awk 'BEGIN{for(i=1;i<=5;i++) printf "2026-08-19T00:00Z drop t%02d dur=18.0 score=50 beats=6 [x] dyn=0.300 act=0.300 rich=0.600 move=0.300 cent=1100 -> pending\n", i}' >> "$LEDGER"
  # LOAD-BEARING: two caches, move-median low vs high, same record.
  printf 'move %s 40 2026-08-19T00:00Z\n' 0.100 > "$tmp/prior-lo"
  printf 'move %s 40 2026-08-19T00:00Z\n' 0.900 > "$tmp/prior-hi"
  SR_PRIOR_CACHE_SET="$tmp/prior-lo"
  _pr_src="$(SR_ERG_REPORT=1 derive 0.30 0.30 0.60 0.30 1100 500 drop | awk '$2=="move"{print $NF}')"
  _w_lo="$(derive 0.30 0.30 0.60 0.30 1100 500 drop | grep -oE '(^| )w [0-9]+' | tail -1 | grep -oE '[0-9]+')"
  SR_PRIOR_CACHE_SET="$tmp/prior-hi"
  _w_hi="$(derive 0.30 0.30 0.60 0.30 1100 500 drop | grep -oE '(^| )w [0-9]+' | tail -1 | grep -oE '[0-9]+')"
  echo "  thin-corpus prior: move-centre 0.100 -> w=${_w_lo:-none} · 0.900 -> w=${_w_hi:-none} (src ${_pr_src:-none})"
  case "$_pr_src" in
    prior\(0.1,n=40,*) : ;;
    *) echo "  FAIL: the thin-corpus branch reported move -> '${_pr_src:-nothing}' — it must name the measured centre it used, with the n and date it was measured at, or a prior that stopped refreshing is indistinguishable from a fresh one."; f=1;;
  esac
  [ -n "$_w_lo" ] && [ "$_w_lo" != "$_w_hi" ] \
    || { echo "  FAIL: the same record derived w=${_w_lo:-none} under a move-centre of 0.100 AND of 0.900 — the cached prior is read but does not reach the params, so the fallback is still whatever constant the code carries."; f=1; }
  # REFRESHED: a fat corpus writes its own measured median back, beside its own ledger.
  LEDGER="$tmp/ledger-fat.log"; : > "$LEDGER"
  awk 'BEGIN{for(i=1;i<=41;i++) printf "2026-08-19T00:00Z drop g%02d dur=18.0 score=50 beats=6 [x] dyn=0.300 act=0.300 rich=0.600 move=0.%03d cent=1100 -> pending\n", i, i*10}' >> "$LEDGER"
  rm -f "$tmp/ledger-fat.prior"; unset SR_PRIOR_CACHE_SET
  derive 0.30 0.30 0.60 0.30 1100 500 drop >/dev/null
  _pr_move="$(awk '$1=="move"{print $2}' "$tmp/ledger-fat.prior" 2>/dev/null)"
  echo "  refresh: 41 records with move .010..0.410 -> cached move=${_pr_move:-none} (expect 0.21)"
  [ "$_pr_move" = "0.21" ] \
    || { echo "  FAIL: a 41-record corpus left the cached move prior at '${_pr_move:-nothing}' instead of its median 0.21 — the prior does not re-measure, so it is a constant again the moment the corpus turns over."; f=1; }
  _sr_live_after="$(stat -c %Y "$_sr_live_prior" 2>/dev/null || echo none)"
  [ "$_sr_live_before" = "$_sr_live_after" ] \
    || { echo "  FAIL: --test refreshed the LIVE prior ($_sr_live_prior) off a synthetic corpus — a dry-run writing the durable artifact it exists to check. The cache path must bind to \$LEDGER at derive() call time, not at load."; f=1; }
  LEDGER="$_sr_led_save"; [ -n "$_sr_pc_save" ] && SR_PRIOR_CACHE_SET="$_sr_pc_save" || unset SR_PRIOR_CACHE_SET
  unset _sr_led_save _sr_pc_save _sr_live_prior _sr_live_before _sr_live_after _pr_none _pr_empty _pr_src _pr_move _w_lo _w_hi

  # 3. NOVELTY REPELS: seed the params log with the recipe just derived; the next derive for the
  #    SAME character must move away from it. Without this the reflex renders the same combo
  #    forever on a stationary room ear — the exact monotony the operator called out.
  again="$(derive 0.30 0.90 0.60 0.14 1100 500)"
  [ "$again" = "$busy" ] || { echo "  FAIL: derive is not deterministic for a fixed character/history"; f=1; }
  printf '2026-07-15T00:00Z %s ~ %s\n' "$(x="${busy#RECIPE }"; echo "${x%% ~ *}")" "beat 500 f $bf" >> "$PARAMS_LOG"
  moved="$(derive 0.30 0.90 0.60 0.14 1100 500)"
  echo "  moved:  $moved"
  [ "$moved" != "$busy" ] \
    || { echo "  FAIL: novelty gate did not move off a recipe already in the params log (taste memory is acting as a template, not a repulsor)"; f=1; }
  case "$moved" in WALKED-OUT*) echo "  FAIL: one recent recipe exhausted the whole 8064-combo space — epsilon is far too wide"; f=1;; esac

  # 3b. A FAILED (HOLLOW) RECIPE REPELS TOO. The live loop this pins (2026-07-20, sound mind's
  #     verified find): mesh-room-music appends the params log only on SHIP, and the repellent read
  #     ONLY that log — so a hollow render never entered history and the derivation re-picked the
  #     same combo all day (49b6427f/c54b76f5/86160733, all l120 w8 ss2.0 c40,4000, only s varying;
  #     5 hollows in one day, every one repellent-invisible). A recipe verdicted hollow must repel
  #     the next derivation exactly like a shipped one.
  : > "$PARAMS_LOG"; : > "$FAILED_LOG"
  first="$(derive 0.30 0.90 0.60 0.14 1100 500)"
  failed_recipe hFAIL "$(x="${first#RECIPE }"; echo "${x%% ~ *}") ~ beat 500 f $bf"
  refused="$(derive 0.30 0.90 0.60 0.14 1100 500)"
  echo "  refused: $refused"
  [ "$refused" != "$first" ] \
    || { echo "  FAIL: derive re-picked a recipe already in the FAILED store — a hollow verdict never enters the repellent, so the grinder re-derives the same failing combo forever (the 2026-07-20 c-40,4000 loop)"; f=1; }
  case "$refused" in WALKED-OUT*) echo "  FAIL: one failed recipe exhausted the whole combo space — the failed store must repel, not wall off"; f=1;; esac

  # 3c. THE REPELLENT IS SIGNED: a REJECTED recipe must push harder than a SHIPPED one
  #     (SO-model review 2026-08-20, docs/reviews/autopoiesis-so-model-signed-leverage-sound-reflex).
  #     3b above only pins that a hollow recipe repels AT ALL. It repelled by exactly the same
  #     epsilon as a render the operator kept — unsigned imprinting, the Hopfield self-optimization
  #     model's known failure axis (Weber/Guckelsberger/Froese, Artificial Life 31(4), 2025): the
  #     leverage rate decides everything and one rate cannot say "come back here for variety, but
  #     never come back HERE". With the params log empty the reported `novelty` IS the distance to
  #     the rejected recipe, so the two arms are each other's red: the signed arm must stand at
  #     least EPS_FAILED away, the unsigned arm must park inside that — run the assertions against
  #     the other arm's output and both fail.
  _sr_nov(){ sed -n 's/.* novelty \([0-9.]*\).*/\1/p'; }
  _sr_avoid(){ sed -n 's/.* avoid \([a-z]*\)\/.*/\1/p'; }
  : > "$PARAMS_LOG"; : > "$FAILED_LOG"
  _sg_first="$(derive 0.30 0.90 0.60 0.14 1100 500)"
  failed_recipe hSIGN "$(x="${_sg_first#RECIPE }"; echo "${x%% ~ *}") ~ beat 500 f $bf"
  _sg_on="$(EPS_FAILED=0.44 derive 0.30 0.90 0.60 0.14 1100 500)"
  _sg_off="$(EPS_FAILED="$EPSILON" derive 0.30 0.90 0.60 0.14 1100 500)"
  echo "  signed:   $_sg_on"
  echo "  unsigned: $_sg_off"
  _sg_n_on="$(printf '%s\n' "$_sg_on"  | _sr_nov)"
  _sg_n_off="$(printf '%s\n' "$_sg_off" | _sr_nov)"
  awk -v v="${_sg_n_on:-0}" 'BEGIN{exit !(v+0 >= 0.44 - 1e-9)}' \
    || { echo "  FAIL: with EPS_FAILED=0.44 the next recipe sits ${_sg_n_on:-n/a} from a recipe our OWN verdict called hollow — the rejected store is still being walked away from at the shipped-history rate (unsigned imprinting)"; f=1; }
  awk -v v="${_sg_n_off:-1}" 'BEGIN{exit !(v+0 < 0.44 - 1e-9)}' \
    || { echo "  FAIL: the unsigned control (EPS_FAILED=EPSILON) already stands ${_sg_n_off:-n/a} from the rejected recipe — this arm is supposed to be the RED one, so the signed leg above is passing on something other than the signed epsilon"; f=1; }
  [ "$(printf '%s\n' "$_sg_on" | _sr_avoid)" = "hard" ] \
    || { echo "  FAIL: the signed arm cleared EPS_FAILED yet the RECIPE line does not report avoid=hard — the tier that won is not the tier published, so the preference cannot be audited from the log"; f=1; }
  # The preference must NEVER manufacture a refusal: an impossible EPS_FAILED falls back to the
  # plain epsilon and SAYS so, the same contract tempo-band rotation carries.
  _sg_wall="$(EPS_FAILED=9 derive 0.30 0.90 0.60 0.14 1100 500)"
  case "$_sg_wall" in WALKED-OUT*) echo "  FAIL: EPS_FAILED=9 refused to grind — the appropriateness preference became a hard wall and the tail is wagging the dog"; f=1;; esac
  [ "$(printf '%s\n' "$_sg_wall" | _sr_avoid)" = "soft" ] \
    || { echo "  FAIL: EPS_FAILED=9 fell back to the plain epsilon but did not report avoid=soft — a preference falling back silently is indistinguishable from one that bit"; f=1; }
  # ... and it must not claim a bite against an EMPTY rejected store.
  : > "$FAILED_LOG"
  [ "$(EPS_FAILED=0.44 derive 0.30 0.90 0.60 0.14 1100 500 | _sr_avoid)" = "none" ] \
    || { echo "  FAIL: an empty FAILED store still reports avoid=hard — the preference reports a bite it never took"; f=1; }

  # 3d. THE EPISTEMIC TERM IS THE CORPUS MARGINAL, NOT THE RECENCY WINDOW (live-literature review
  #     2026-08-20, docs/reviews/fep-convex-mdp-occupancy-marginal-mirror-descent-sound-reflex-
  #     2026-08-20.md — Milosevic/Hinrichs/Scherf, arXiv:2607.20152). 3/3b/3c above all pin the
  #     RECENCY half: "don't repeat what I just did". None of them can see how WORN a value is in
  #     the corpus, because -min_dist is a function of the last SR_RECENT renders and nothing else
  #     (measured on the live log: Pearson r(-min_dist, marginal reward) = -0.117 over 4301
  #     admissible candidates — orthogonal, and if anything leaning the wrong way).
  #     The fixture: 40 renders that wear `c 40,4000`/`w 6`/`s 1.0` deep into the corpus on the EAR
  #     lane, then 6 ambient renders that are the only thing the repellent can see. So the two
  #     halves are separable — the repellent's window carries none of the wear, and any preference
  #     against the worn values can ONLY have come from the marginal.
  #     The arms are each other's red: SR_MARGINAL_RANK=0 keeps the term measured and published but
  #     out of the sort key, which is exactly the ranking this file had yesterday.
  : > "$PARAMS_LOG"; : > "$FAILED_LOG"
  _md_i=0
  while [ "$_md_i" -lt 40 ]; do
    printf '2026-08-01T00:00Z amc l 500 w 6 ss 1.0 s 1.0 c 40,4000 m poly rv 0.0 env 4 ~ src=ear/w%02d beat 500 f 1 band mid\n' "$_md_i" >> "$PARAMS_LOG"
    _md_i=$((_md_i + 1))
  done
  for _md_amb in "w 4 ss 0.5 s 2.0 c 300,12000 f 2" "w 5 ss 1.5 s 3.0 c 80,15000 f 3" \
                 "w 8 ss 0.25 s 1.5 c 100,8000 f 0.5" "w 4 ss 2.0 s 0.5 c 300,12000 f 0.33" \
                 "w 5 ss 0.75 s 0.75 c 80,15000 f 0.2" "w 8 ss 1.25 s 1.25 c 100,8000 f 2"; do
    printf '2026-08-02T00:00Z amc l 500 %s m poly rv 0.0 env 4 ~ beat 500 band mid\n' \
      "$(echo "$_md_amb" | sed 's/ f \([0-9.]*\)$//') f $(echo "$_md_amb" | sed 's/.* f //')" >> "$PARAMS_LOG"
  done
  _sr_fit(){ sed -n 's/.* fit \([0-9.]*\).*/\1/p'; }
  _sr_epi(){ sed -n 's|.* epi \([0-9.]*\)/.*|\1|p'; }   # grid A's half of the published pair
  # The fixture's ideal has to be WALLED before any of this can be exercised: with the exact
  # character-ideal admissible every arm scores fit 0.00 and there is no tie for a second key level
  # to break (measured — 60 characters probed, every one agreeing while the ideal was reachable).
  # So seed the repellent with the recipe the OLD ranking picks, exactly as leg 3 does, and compare
  # where the two rankings go from there.
  _md_seed="$(SR_MARGINAL_RANK=0 derive 0.50 0.10 0.20 0.20 1100 500)"
  printf '2026-08-04T00:00Z %s ~ beat 500 f %s band mid\n' \
    "$(x="${_md_seed#RECIPE }"; echo "${x%% ~ *}")" \
    "$(printf '%s' "$_md_seed" | sed -n 's/.* ~ beat [0-9]* f \([0-9.]*\).*/\1/p')" >> "$PARAMS_LOG"
  _md_on="$(derive 0.50 0.10 0.20 0.20 1100 500)"
  _md_off="$(SR_MARGINAL_RANK=0 derive 0.50 0.10 0.20 0.20 1100 500)"
  echo "  marginal on:  $_md_on"
  echo "  marginal off: $_md_off"
  _md_fit_on="$(printf '%s\n' "$_md_on" | _sr_fit)";  _md_fit_off="$(printf '%s\n' "$_md_off" | _sr_fit)"
  _md_epi_on="$(printf '%s\n' "$_md_on" | _sr_epi)";  _md_epi_off="$(printf '%s\n' "$_md_off" | _sr_epi)"
  # (i) it BITES, and the control arm shows WHY it had to: on this fixture the unranked arm picks
  #     `c 40,4000` — the value worn 40 times — precisely BECAUSE it sits farther from the 6 ambient
  #     renders in the repellent's window (its novelty prints HIGHER, 0.30 vs 0.25). That is the
  #     whole finding in one line: recency-distance and corpus-wear are different quantities, and
  #     maximising the first can walk straight into the second.
  #     If this leg ever goes red after a pool/character change, check FIRST that the fixture still
  #     poses a TIE (both arms must report the same fit) — the character is chosen to sit on one,
  #     and a fixture with a uniquely-reachable ideal cannot exercise a second-level tie-break.
  #     Grid A's `w 6` and grid B's `env 4` are each worn 40x by this fixture and each sit OUTSIDE
  #     the repellent's 6-line ambient window, so the old ranking walks straight onto both while
  #     reporting a perfectly healthy novelty — recency-distance and corpus-wear are different
  #     quantities, and maximising the first is no defence against the second. Both grids are
  #     asserted because the term is wired into both (the sub-grids below them are deliberately
  #     out of scope — their axes are mode-conditional; see the note at B_POOLS).
  case "$_md_off" in *" w 6 "*) : ;;
    *) echo "  FAIL: the UNRANKED control arm did NOT choose the 40x-worn w 6 — this arm is supposed to be the red one, so the legs below are passing on something other than the marginal"; f=1;; esac
  case "$_md_off" in *" env 4"*) : ;;
    *) echo "  FAIL: the UNRANKED control arm did NOT choose the 40x-worn env 4 — grid B's control arm is not red, so its marginal leg asserts nothing"; f=1;; esac
  case "$_md_on"  in *" w 6 "*) echo "  FAIL: the marginal-ranked arm still chose w 6, the grid-A value this fixture wore 40 times — the corpus marginal is not reaching the primary grid's sort key"; f=1;; esac
  case "$_md_on"  in *" env 4"*) echo "  FAIL: the marginal-ranked arm still chose env 4, the grid-B value this fixture wore 40 times — nearest_ideal() is being called without its epi argument, so grid B still ranks on recency alone"; f=1;; esac
  awk -v a="${_md_epi_on:-0}" -v b="${_md_epi_off:-9}" 'BEGIN{exit !(a+0 > b+0 + 1e-9)}' \
    || { echo "  FAIL: the marginal-ranked arm chose epi=${_md_epi_on:-n/a} against the old ranking's ${_md_epi_off:-n/a} — the -log rho term is not reaching the sort key, so the reflex is still steering by recency alone on a corpus with a 40x worn value"; f=1; }
  # (ii) it NEVER OVERRULES appropriateness: it is the SECOND key level, so fit must be untouched.
  [ "$_md_fit_on" = "$_md_fit_off" ] \
    || { echo "  FAIL: fit moved $_md_fit_off -> $_md_fit_on when the marginal entered the key — the epistemic term is overruling the record's own character instead of breaking its ties"; f=1; }
  # (iii) the `novelty` COLUMN still means min_dist. The key grew a level UNDER the pragmatic term,
  #       and a reader taking best_key[1] would now republish the marginal reward (unbounded, ~1-3
  #       here) in the column every consumer parses as a normalized distance in [0,1].
  _md_nov="$(printf '%s\n' "$_md_on" | _sr_nov)"
  awk -v v="${_md_nov:-9}" 'BEGIN{exit !(v+0 >= 0 && v+0 <= 1.0000001)}' \
    || { echo "  FAIL: novelty reads ${_md_nov:-n/a} — outside [0,1], so the column is carrying the marginal reward, not the recency distance (two populations in one column)"; f=1; }
  awk -v n="${_md_nov:-0}" -v e="${_md_epi_on:-0}" 'BEGIN{exit !(n+0 != e+0)}' \
    || { echo "  FAIL: novelty and epi print the same number — the RECIPE line is reading one key level twice"; f=1; }
  # (iv) ALIASES ARE ONE ACTION. C_VALS holds "" twice and every read-back resolves to the first,
  #      so counting per index would hand the unreachable twin a permanent count of 0 — the LARGEST
  #      reward in the pool, a 7x pull (measured on the live corpus: 7.29 vs 1.02) toward a value
  #      whose render output is byte-identical to one of the most-worn values we have.
  _md_rep="$(SR_MARGINAL_REPORT=1 derive 0.50 0.10 0.20 0.20 1100 500)"
  case "$_md_rep" in
    *"[4=3]"*) : ;;
    *) echo "  FAIL: the marginal report does not mark C_VALS index 4 as an alias of 3 — duplicate pool values are being counted as separate states, and the unreachable one wears the unexplored one's bonus"; f=1;;
  esac
  _md_r3="$(printf '%s\n' "$_md_rep" | sed -n "s/.*\[3\]'' n=[0-9]* r=\([0-9.]*\).*/\1/p")"
  _md_r4="$(printf '%s\n' "$_md_rep" | sed -n "s/.*\[4=3\]'' n=[0-9]* r=\([0-9.]*\).*/\1/p")"
  [ -n "$_md_r3" ] && [ "$_md_r3" = "$_md_r4" ] \
    || { echo "  FAIL: the two '' entries of C_VALS carry rewards '${_md_r3:-n/a}' and '${_md_r4:-n/a}' — the same action priced twice"; f=1; }
  # (v) RELINEARIZED, never cached: the paper's mirror descent recomputes the reward between
  #     iterations, and one derive IS one iteration. Wearing an axis value down must LOWER its
  #     reward on the very next call; a cache would freeze rho at whatever corpus wrote it.
  _md_w8_before="$(printf '%s\n' "$_md_rep" | sed -n 's/.* w  *n=[0-9]* .*\[3\]8 n=[0-9]* r=\([0-9.]*\).*/\1/p')"
  _md_i=0
  while [ "$_md_i" -lt 30 ]; do
    printf '2026-08-03T00:00Z amc l 500 w 8 ss 1.0 s 1.0 c 40,4000 m poly rv 0.0 env 4 ~ src=ear/r%02d beat 500 f 1 band mid\n' "$_md_i" >> "$PARAMS_LOG"
    _md_i=$((_md_i + 1))
  done
  _md_w8_after="$(SR_MARGINAL_REPORT=1 derive 0.50 0.10 0.20 0.20 1100 500 | sed -n 's/.* w  *n=[0-9]* .*\[3\]8 n=[0-9]* r=\([0-9.]*\).*/\1/p')"
  awk -v a="${_md_w8_before:-0}" -v b="${_md_w8_after:-9}" 'BEGIN{exit !(a+0 > b+0 + 1e-9)}' \
    || { echo "  FAIL: 30 more renders on w=8 left its reward at ${_md_w8_before:-n/a} -> ${_md_w8_after:-n/a} — the marginal is not re-read per derive, so the epistemic term is a frozen constant (the same rot the --prior work fixed on the ranking basis)"; f=1; }
  # (vi) A THIN CORPUS FABRICATES NOTHING. Below SR_MARGINAL_MIN the term must render `na(thin:...)`
  #      AND degrade to exactly the old key — not to a preference invented out of five renders.
  : > "$PARAMS_LOG"
  for _md_amb in "w 4 ss 0.5 s 2.0 c 300,12000 f 2" "w 5 ss 1.5 s 3.0 c 80,15000 f 3" \
                 "w 8 ss 0.25 s 1.5 c 100,8000 f 0.5"; do
    printf '2026-08-02T00:00Z amc l 500 %s m poly rv 0.0 env 4 ~ beat 500 band mid\n' \
      "$(echo "$_md_amb" | sed 's/ f \([0-9.]*\)$//') f $(echo "$_md_amb" | sed 's/.* f //')" >> "$PARAMS_LOG"
  done
  _md_thin="$(derive 0.50 0.10 0.20 0.20 1100 500)"
  _md_thin_off="$(SR_MARGINAL_RANK=0 derive 0.50 0.10 0.20 0.20 1100 500)"
  case "$_md_thin" in
    *"epi na(thin:"*) : ;;
    *) echo "  FAIL: a 3-render corpus still printed a marginal reward — the term is pricing values off a corpus that cannot support it"; f=1;;
  esac
  # Compared with the `epi` field stripped: the ranked arm publishes `(off)` on the control side, so
  # the columns that must match are everything the ranking produced, not the label naming the arm.
  [ "$(printf '%s\n' "$_md_thin" | sed 's/ epi .*//')" = "$(printf '%s\n' "$_md_thin_off" | sed 's/ epi .*//')" ] \
    || { echo "  FAIL: on a thin corpus the ranked and unranked arms disagree — the n/a path is still steering, so 'not enough evidence' is not the same as 'no preference'"; f=1; }
  : > "$PARAMS_LOG"; : > "$FAILED_LOG"
  unset _md_i _md_amb _md_on _md_off _md_fit_on _md_fit_off _md_epi_on _md_epi_off _md_nov \
        _md_rep _md_r3 _md_r4 _md_w8_before _md_w8_after _md_thin _md_thin_off
  unset -f _sr_nov _sr_avoid; unset _sg_first _sg_on _sg_off _sg_n_on _sg_n_off _sg_wall
  : > "$PARAMS_LOG"; : > "$FAILED_LOG"

  # 4. WALKED-OUT is reachable and honest: an impossible epsilon must refuse rather than render
  #    something it just claimed was too close.
  wo="$(EPSILON=9 derive 0.3 0.9 0.6 0.14 1100 500 2>/dev/null)"
  case "$wo" in WALKED-OUT*) : ;; *) echo "  FAIL: epsilon=9 still returned a recipe ($wo) — the gate is not actually gating"; f=1;; esac

  # 5. ANCHOR: first sight resyncs WITHOUT replay; a new line is fresh exactly once. The byte-offset
  #    version of this replayed the whole buffer on every prune (the 2026-07-14 false-wake storm) —
  #    here that would mean re-grinding the entire corpus.
  out="$(fresh_lines)"
  [ -z "$out" ] || { echo "  FAIL: first sight of the ledger replayed history instead of resyncing"; f=1; }
  echo '2026-07-15T00:10Z ear hZ dur=18.0 score=55 beats=9 [y] dyn=0.5 act=0.5 rich=0.6 move=0.2 cent=1200 -> pending' >> "$LEDGER"
  out="$(fresh_lines)"; [ "$(wc -l <<<"$out")" = 1 ] || { echo "  FAIL: new ledger line not fresh exactly once (got: $out)"; f=1; }
  consume "$(tail -1 "$LEDGER")"
  out="$(fresh_lines)"; [ -z "$out" ] || { echo "  FAIL: consumed line came back as fresh"; f=1; }
  # prune the ledger the way mesh-records does — the anchor must resync, never replay
  tail -n 3 "$LEDGER" > "$LEDGER.t" && mv "$LEDGER.t" "$LEDGER"
  echo '2026-07-15T00:20Z ear hQ dur=18.0 score=50 beats=9 [y] dyn=0.5 act=0.5 rich=0.6 move=0.2 cent=1200 -> pending' >> "$LEDGER"
  out="$(fresh_lines)"
  [ "$(wc -l <<<"$out")" -le 1 ] || { echo "  FAIL: a ledger prune replayed history (byte-offset regression — the false-wake storm)"; f=1; }

  # 5b. THE ANCHOR MUST SURVIVE A VERDICT REWRITE — the thing tick() does on every grinding tick.
  #     tick() settles each non-picked row (`skip:not-picked`) and marks the picked one `grinding`,
  #     REWRITING those ledger lines, and only then calls `consume "$last"` with the line's stale
  #     in-memory, pre-verdict text. Anchoring on whole-line content therefore stores a string that
  #     no longer exists the moment a tick actually grinds: the next tick finds no match, takes the
  #     idx<0 resync-to-END branch, and silently discards that entire block UNCONSIDERED — its rows
  #     left `-> pending` forever. Live signature (2026-07-15): a */5 cron whose renders landed at
  #     exactly 10-minute intervals, 12/12 — every other tick burned re-anchoring — with 329 rows
  #     stranded at `pending` and `voice`/`scape` never once reaching a grind. Anchor on the record
  #     id (field 3): immutable under verdict rewrites, and still resyncs (never replays) on a prune.
  : > "$LEDGER"
  aline='2026-07-15T00:30Z ear hV dur=18.0 score=55 beats=9 [y] dyn=0.5 act=0.5 rich=0.6 move=0.2 cent=1200 -> pending'
  echo "$aline" >> "$LEDGER"
  verdict hV "grinding"     # tick() rewrites the line ...
  consume "$aline"          # ... and only then anchors on the pre-verdict text it still holds
  echo '2026-07-15T00:31Z ear hW dur=18.0 score=50 beats=9 [y] dyn=0.5 act=0.5 rich=0.6 move=0.2 cent=1200 -> pending' >> "$LEDGER"
  out="$(fresh_lines)"
  [ "$(grep -c ' hW ' <<<"$out")" = 1 ] \
    || { echo "  FAIL: after a verdict rewrite the anchor died — the next block (hW) was discarded unconsidered, not seen fresh. This is the */5-cron-renders-every-10min bug: half of all ticks resync instead of grinding, and their records strand at 'pending' forever"; f=1; }
  grep -q ' hV ' <<<"$out" \
    && { echo "  FAIL: the already-consumed hV replayed as fresh after its verdict rewrite"; f=1; }

  # 5c. THE OUTLIER GATE CANNOT SATURATE. The live defect: the gate tested the BLOCK WINNER (max of
  #     ~10, already picked for score) against 1.25x the median of the WHOLE ledger — the losers it
  #     had just beaten — so 30% of winners "cleared" it, the condition was permanently true, and the
  #     cooldown degenerated into a 30-min metronome (delivered 05:10/05:40/06:10, exactly 1800s
  #     apart) announcing ordinary room tone as remarkable. A flat run of typical material must poke
  #     AT MOST ONCE, then go quiet; only a genuine jump may speak again.
  : > "$LEDGER"
  for i in $(seq 1 20); do
    printf '2026-07-15T00:%02dZ ear c%d dur=18.0 win=3.0 score=41 beats=6 [x] dyn=0.2 act=0.3 rich=0.6 move=0.1 cent=1100 -> ground:x.mp3\n' "$i" "$i" >> "$LEDGER"
  done
  is_outlier 44 2.0 \
    && { echo "  FAIL: a 44 against a flat corpus of 41s poked as an OUTLIER — that is the routine, and at 1.25x-median (45.5 here) this is exactly the metronome: near-every block winner qualifies and the cooldown sets the rate"; f=1; }
  is_outlier 70 2.0 \
    || { echo "  FAIL: a genuine jump (70 vs a 41 high-water) did NOT poke — the gate is now deaf, which is the opposite failure"; f=1; }
  is_outlier 70 0.1 \
    && { echo "  FAIL: a 70 with 0.1 b/s (a transient/cough) poked — the density floor must still bind"; f=1; }
  # and once the jump is IN the corpus it is the new bar — the same record cannot poke twice
  printf '2026-07-15T00:21Z ear cJ dur=18.0 win=3.0 score=70 beats=6 [x] dyn=0.2 act=0.3 rich=0.6 move=0.1 cent=1100 -> ground:j.mp3\n' >> "$LEDGER"
  is_outlier 70 2.0 \
    && { echo "  FAIL: 70 poked again after 70 became the high-water — the gate re-announces its own history"; f=1; }
  : > "$LEDGER"
  is_outlier 99 2.0 \
    && { echo "  FAIL: with NO candidate history, 99 poked — there is nothing to be an outlier above; a bar of 0 makes the first record the lane ever grinds remarkable"; f=1; }

  # 5d. NOTABLE IS THE DELIVERED-POKE LOG, NOT THE ATTEMPTED-POKE LOG. The write used to sit ABOVE
  #     the cooldown gate, so a swallowed poke left a line identical to a delivered one — the pane's
  #     "what the grinder wanted judgement on" and the mind's own record of what woke it both counted
  #     pokes that never happened (8 outlier lines logged 03:30-06:10; 4 delivered). mesh-guardian's
  #     dry-run writing the real guardian.log is the same trap.
  #     This case must drive poke() with the SANDBOX GATE OFF (that gate returns before the log
  #     write, so it cannot exercise the ordering). That makes the real mesh-tell reachable, which is
  #     precisely how this tool once fired two live "[sound-reflex: starved]" payloads into the sound
  #     channel while under test. So: shadow mesh-tell with a stub on PATH for the duration — the
  #     assertion is about the LOG, and the delivery must stay inert.
  NOTABLE="$tmp/notable.log"; LASTPOKE="$tmp/lastpoke"; : > "$NOTABLE"
  mkdir -p "$tmp/bin"; printf '#!/bin/sh\nexit 0\n' > "$tmp/bin/mesh-tell"; chmod +x "$tmp/bin/mesh-tell"
  opath="$PATH"; PATH="$tmp/bin:$PATH"
  now > "$LASTPOKE"                       # a poke JUST happened -> the next one must be swallowed
  MESH_TEST_SANDBOX=0 poke "outlier" "suppressed body" >/dev/null 2>&1
  [ -s "$NOTABLE" ] \
    && { echo "  FAIL: a cooldown-SUPPRESSED poke wrote a NOTABLE line — indistinguishable from one the mind was actually told: $(cat "$NOTABLE")"; f=1; }
  echo 0 > "$LASTPOKE"                    # cooldown long expired -> this one is delivered
  MESH_TEST_SANDBOX=0 poke "outlier" "delivered body" >/dev/null 2>&1
  [ "$(grep -c 'delivered body' "$NOTABLE")" = 1 ] \
    || { echo "  FAIL: a DELIVERED poke left no NOTABLE line — the log must record what the mind was actually told"; f=1; }
  PATH="$opath"

  # 6. BEAT PERIOD comes from the WINDOW, not the file. The live regression this pins: a real 18s
  #    record whose 3s winning window held 5 beats. win/beats = 600ms (real); dur/beats = 3600ms →
  #    out of range → the silent 500 fallback → l = 500 x f on EVERY render, i.e. the beat axis dead
  #    while the mp3 still comes out fine and nothing looks wrong.
  [ "$(beat_of 3.00 18.00 5)" = 600 ] \
    || { echo "  FAIL: beat_of(win=3s,5b) = $(beat_of 3.00 18.00 5), want 600 — window beat math wrong"; f=1; }
  [ "$(beat_of '' 18.00 5)" = 500 ] \
    || { echo "  FAIL: beat_of with no win should fall back honestly to 500, got $(beat_of '' 18.00 5)"; f=1; }
  [ "$(beat_of 3.00 18.00 0)" = 500 ] \
    || { echo "  FAIL: beat_of with 0 beats must be 500, got $(beat_of 3.00 18.00 0)"; f=1; }
  [ "$(beat_of 0.10 18.00 5)" = 500 ] \
    || { echo "  FAIL: an out-of-range period (20ms) must fall back to 500, got $(beat_of 0.10 18.00 5)"; f=1; }

  # 7. A TRANSIENT IS NOT AN OUTLIER, AND NOT A CANDIDATE. The live case that forced this: the
  #    operator cleared his throat at 02:57:08 (transcript «Кхе-кхе-кхе»); the cough pinned dyn at
  #    1.000, scored 65.6 against a corpus median of 41.8, won candidate selection, and poked the
  #    mind as "well above anything else the mesh has heard". Score's heaviest term IS dynamics, so
  #    its top end is impulses: over n=215, score>=55 averaged 3.6 beats vs 12.2 for the rest. The
  #    ranker was aimed at the least grindable material in the corpus.
  #    Values below are the REAL ones from that record and from a record that ground well.
  : > "$LEDGER"
  cough='2026-07-15T02:57Z ear COUGH dur=18.00 win=12.00 score=65.6 beats=5 [dynamic·dark·tonal] dyn=1.000 act=0.361 rich=0.568 move=0.257 cent=1299.7 -> pending'
  music='2026-07-15T02:20Z ear MUSIC dur=18.00 win=3.00 score=45.9 beats=4 [even·dark·tonal] dyn=0.292 act=0.344 rich=0.674 move=0.144 cent=1057.7 -> pending'
  printf '%s\n%s\n' "$cough" "$music" > "$LEDGER"
  picked="$(printf '%s\n%s\n' "$cough" "$music" | grep -v 'unmeasurable' | awk -v mb="$MIN_BEATS" -v md="$MIN_DENSITY" '
      { b=0; sc=0; w=0
        for(i=1;i<=NF;i++){ split($i,a,"=");
          if(a[1]=="beats") b=a[2]+0; if(a[1]=="score") sc=a[2]+0; if(a[1]=="win") w=a[2]+0 }
        d = (w > 0) ? b/w : 0
        if (b >= mb && d >= md && sc > best) { best=sc; line=$0 } }
      END{ if(line) print line }' | awk '{print $3}')"
  [ "$picked" = "MUSIC" ] \
    || { echo "  FAIL: candidate ranker picked '$picked' — the 65.6 cough (0.42 b/s) must LOSE to the 45.9 rhythmic record (1.33 b/s); ranking by score alone aims the lane at transients"; f=1; }

  # 8. NO ROW IS LEFT LYING AT "pending". The reflex grinds one best candidate per tick and the
  #    anchor moves past the rest, so an unpicked row is DECLINED, not waiting — leaving it pending
  #    grows a phantom backlog forever (82 rows in the first hour live) and the pane reads it as work
  #    the mind should do.
  : > "$PARAMS_LOG"; : > "$LEDGER"
  printf '2026-07-15T00:00Z ear hA dur=18 win=3 score=40 beats=6 [x] dyn=0.2 act=0.3 rich=0.6 move=0.1 cent=1100 -> pending\n' >> "$LEDGER"
  printf '2026-07-15T00:01Z ear hB dur=18 win=3 score=59 beats=6 [x] dyn=0.2 act=0.3 rich=0.6 move=0.1 cent=1100 -> pending\n' >> "$LEDGER"
  printf '2026-07-15T00:02Z ear hC dur=18 win=3 score=41 beats=6 [x] dyn=0.2 act=0.3 rich=0.6 move=0.1 cent=1100 -> pending\n' >> "$LEDGER"
  rm -f "$ANCHOR"; fresh_lines >/dev/null            # first sight resyncs to the end
  printf '2026-07-15T00:03Z ear hD dur=18 win=3 score=42 beats=6 [x] dyn=0.2 act=0.3 rich=0.6 move=0.1 cent=1100 -> pending\n' >> "$LEDGER"
  printf '2026-07-15T00:04Z ear hE dur=18 win=3 score=58 beats=6 [x] dyn=0.2 act=0.3 rich=0.6 move=0.1 cent=1100 -> pending\n' >> "$LEDGER"
  # hF is the live 4ec89a12 shape: outscores most of the block but sits below the rhythm floor —
  # it lost to the FLOOR, not to a stronger record, and its verdict must say so.
  printf '2026-07-15T00:05Z scape hF dur=5 win=3 score=57 beats=2 [x] dyn=0.6 act=0.3 rich=0.6 move=0.1 cent=1300 -> pending\n' >> "$LEDGER"
  REC_DIR="$tmp/norec" MESH_RMC_DRYRUN=1 tick 2>/dev/null   # no corpus files -> no real grind launched
  grep -q 'hD .*skip:not-picked' "$LEDGER" \
    || { echo "  FAIL: an unpicked record was left at 'pending' — the anchor has passed it, so it is declined, not waiting"; f=1; }
  grep -q 'hF .*skip:below-rhythm-floor' "$LEDGER" \
    || { echo "  FAIL: a below-floor loser was settled as 'a stronger record led this block' — two causes, one message; the ledger must name the floor, not a phantom score race (got: $(grep hF "$LEDGER" | grep -o 'skip:[^)]*)' || echo pending))"; f=1; }
  # hG is the OTHER side of that same split, and the live shape as of 2026-08-20: a 1.4s VAD fragment
  # whose density (2/1.4 = 1.43 b/s) CLEARS the 0.8 rhythm floor and sits inside the ~1.33-1.58 band
  # of material that actually grinds well — rejected solely by the duration-BLIND beats>=4, which at
  # that length silently demands 2.86 b/s. Calling that "below-rhythm-floor" says the material has no
  # rhythm when the only problem is that it is short. The verdict must name WHICH floor rejected it.
  # OWN ledger, hG the ONLY fresh record: which of the two floor sites runs depends on whether some
  # other record won the block, so sharing the fixture above made this leg pass one run and fail the
  # next on identical code. An assertion about a record must not depend on its neighbours.
  hg_led="$tmp/hg-ledger"; hg_anchor="$tmp/hg-anchor"
  # Seed a SETTLED line, resync the anchor to it, THEN append hG — first sight resyncs to the END, so
  # a record written before the resync is already-seen and tick never looks at it (it sat at pending
  # and the leg reported the verdict was wrong when the record had simply never been processed).
  printf '2026-07-15T00:05Z scape hSEED dur=18 win=3 score=40 beats=6 [x] dyn=0.2 act=0.3 rich=0.6 move=0.1 cent=1100 -> ground:x.mp3\n' > "$hg_led"
  ( LEDGER="$hg_led"; ANCHOR="$hg_anchor"; rm -f "$ANCHOR"; fresh_lines >/dev/null
    printf '2026-07-15T00:06Z scape hG dur=1.4 win=1.4 score=62 beats=2 [x] dyn=0.8 act=0.3 rich=0.6 move=0.3 cent=1900 -> pending\n' >> "$hg_led"
    REC_DIR="$tmp/norec" MESH_RMC_DRYRUN=1 tick 2>/dev/null ) || true
  grep -q 'hG .*skip:too-short-for-min-beats' "$hg_led" \
    || { echo "  FAIL: a record CLEARING the density floor but failing the duration-blind beats>=$MIN_BEATS was verdicted as un-rhythmic — a length limit masquerading as a rhythm judgement (got: $(grep hG "$hg_led" | grep -o 'skip:[^)]*)' || echo pending))"; f=1; }
  grep -q 'hG .*CLEARS the' "$hg_led" \
    || { echo "  FAIL: the too-short verdict does not report the density it CLEARED, so the reader cannot tell a short-but-rhythmic record from a genuinely flat one"; f=1; }

  # hI holds the OPERATOR'S 2026-08-20 decision as a GATE, not a comment: MIN_BEATS 4 -> 3, so a
  # record with exactly 3 beats at a density clearing MIN_DENSITY must be ADMITTED, not floored.
  # (3b in 2.0s = 1.50 b/s: above MIN_DENSITY 0.8, and it was rejected outright at MIN_BEATS=4, which
  # demanded 2.00 b/s at that length.) If anyone raises the floor back, this goes red and says whose
  # decision it was — a constant restored by hand is otherwise indistinguishable from one never changed.
  hi_led="$tmp/hi-ledger"; hi_anchor="$tmp/hi-anchor"
  printf '2026-07-15T00:05Z scape hSEED2 dur=18 win=3 score=40 beats=6 [x] dyn=0.2 act=0.3 rich=0.6 move=0.1 cent=1100 -> ground:x.mp3\n' > "$hi_led"
  ( LEDGER="$hi_led"; ANCHOR="$hi_anchor"; rm -f "$ANCHOR"; fresh_lines >/dev/null
    printf '2026-07-15T00:06Z scape hI dur=2.0 win=2.0 score=62 beats=3 [x] dyn=0.6 act=0.3 rich=0.6 move=0.2 cent=1500 -> pending\n' >> "$hi_led"
    REC_DIR="$tmp/norec" MESH_RMC_DRYRUN=1 tick 2>/dev/null ) || true
  # "admitted" = it got PAST the floor to the grind stage. With REC_DIR=$tmp/norec (no corpus file,
  # so no real render is launched — same convention as the legs above) that shows as
  # skip:evicted-before-grind, which is a post-pick verdict, not a floor one.
  grep -qE 'hI .*-> (grinding|ground:|skip:(not-picked|derive-failed|no-render|degenerate|hollow|evicted-before-grind))' "$hi_led" \
    || { echo "  FAIL: a 3-beat record at 1.50 b/s was floored — the operator lowered MIN_BEATS to 3 on 2026-08-20 and this record must now be ADMITTED to the grinder (got: $(grep hI "$hi_led" | grep -o -- '-> .*' || echo missing))"; f=1; }
  grep -q 'hI .*floor' "$hi_led" \
    && { echo "  FAIL: a 3-beat record was rejected by a beats floor — MIN_BEATS is back above 3, undoing the operator's 2026-08-20 call"; f=1; }

  grep -q 'hA .*-> pending' "$LEDGER" \
    || { echo "  FAIL: a record BEHIND the anchor was re-verdicted (only the fresh block may be settled)"; f=1; }

  # 8b. THE SAME LIE VIA THE NO-CANDIDATE PATH — the half gate 8 never reached. Gate 8 seeds beats=6
  #     rows, so a candidate always exists and the settle loop always runs. But tick returns EARLY
  #     when nothing clears the rhythm floor (`[ -n "$cand" ] || { consume "$last"; return 0; }`),
  #     which consumes the anchor WITHOUT settling anything — so a block where every record is below
  #     the floor strands its whole block at 'pending' forever, behind the anchor. Live 2026-07-15:
  #     13 such rows, oldest stranded 5.5h, pane reading '28 pending' as a backlog for the mind.
  #     ~15% of live blocks clear nothing (52% of records are eligible) — a steady minority whose
  #     strands never resolve, so the count only ever climbs. Declining a block is a real verdict and
  #     must be written like one.
  : > "$PARAMS_LOG"; : > "$LEDGER"
  printf '2026-07-15T00:00Z ear hP dur=18 win=3 score=40 beats=6 [x] dyn=0.2 act=0.3 rich=0.6 move=0.1 cent=1100 -> pending\n' >> "$LEDGER"
  rm -f "$ANCHOR"; fresh_lines >/dev/null            # anchor to hP; the next rows are the fresh block
  # a whole block below MIN_BEATS=4 / MIN_DENSITY=0.8 -> no candidate -> tick's early return
  printf '2026-07-15T00:01Z ear hQ dur=18 win=3 score=40 beats=1 [x] dyn=0.2 act=0.3 rich=0.6 move=0.1 cent=1100 -> pending\n' >> "$LEDGER"
  printf '2026-07-15T00:02Z ear hR dur=18 win=3 score=57 beats=2 [x] dyn=0.2 act=0.3 rich=0.6 move=0.1 cent=1100 -> pending\n' >> "$LEDGER"
  REC_DIR="$tmp/norec" MESH_RMC_DRYRUN=1 tick 2>/dev/null
  if grep -q 'hQ .*-> pending' "$LEDGER" || grep -q 'hR .*-> pending' "$LEDGER"; then
    echo "  FAIL: a block with NO record above the rhythm floor left its rows at 'pending' — the anchor consumed them, so they are declined, not waiting; the count climbs forever and the pane reads it as the mind's backlog"; f=1
  fi
  grep -q 'hR .*skip:' "$LEDGER" \
    || { echo "  FAIL: the no-candidate path wrote no verdict at all — declining a block is a verdict"; f=1; }

  # 9. A KILLED RENDER IS NOT DEGENERATE MATERIAL. The live case (2026-07-16): the first drop the
  #    lane ever received (fdfdd3fb, 125.57s — 7x the 18s ear records the 300s cap was sized on) was
  #    killed by `timeout` 17s before finishing (untimed rerun: rc=0 at 317s wall, a real 34M/36min
  #    render) and verdicted skip:degenerate — "recipe pathological or source thinner than it looked"
  #    — because the pipe discarded timeout's rc=124 and empty output has two causes. One message,
  #    two causes: an error message names a cause, not the cause. The fix has two halves — the cap
  #    scales with source duration (grind_cap), and rc=124 gets its own verdict + poke — and both
  #    edges are asserted THROUGH the real tick->spawn path with a stub renderer, so the degenerate
  #    verdict cannot silently eat timeouts again (nor the reverse).
  [ "$(grind_cap 125.57)" = 628 ] \
    || { echo "  FAIL: grind_cap(125.57s) = $(grind_cap 125.57), want 628 (5s per source-second) — the cap that killed the first-ever drop is still sized by the ear's 18s habit"; f=1; }
  [ "$(grind_cap 18)" = 300 ] \
    || { echo "  FAIL: grind_cap(18s) = $(grind_cap 18), want 300 — the floor must hold for short records, not shrink below the old default"; f=1; }
  [ "$(grind_cap '')" = 300 ] \
    || { echo "  FAIL: grind_cap with no dur = $(grind_cap ''), want the 300 floor — a missing field must not zero the cap"; f=1; }
  : > "$PARAMS_LOG"; : > "$LEDGER"; mkdir -p "$tmp/rec"
  printf 'x' > "$tmp/rec/t-hT.mp3"; printf 'x' > "$tmp/rec/t-hU.mp3"
  # stub renderer that OUTLIVES the cap: rc=124 is the cap speaking, not the material
  printf '#!/bin/sh\nsleep 3\necho fake.mp3\n' > "$tmp/bin/mesh-room-music"; chmod +x "$tmp/bin/mesh-room-music"
  opath2="$PATH"; PATH="$tmp/bin:$PATH"
  rm -f "$ANCHOR"
  printf '2026-07-16T00:00Z ear h0 dur=1 win=3 score=40 beats=6 [x] dyn=0.2 act=0.3 rich=0.6 move=0.1 cent=1100 -> ground:x.mp3\n' >> "$LEDGER"
  fresh_lines >/dev/null                              # anchor to h0; hT is the fresh block
  printf '2026-07-16T00:01Z ear hT dur=0.2 win=3 score=40 beats=6 [x] dyn=0.2 act=0.3 rich=0.6 move=0.1 cent=1100 -> pending\n' >> "$LEDGER"
  MESH_REC_LOG="$LEDGER" MESH_REC_DIR="$tmp/rec" REC_DIR="$tmp/rec" GRIND_TIMEOUT=1 MESH_TEST_SANDBOX=1 tick 2>/dev/null
  for i in $(seq 1 20); do grep -q ' hT .*-> skip:' "$LEDGER" && break; sleep 0.5; done
  grep -q ' hT .*-> skip:grind-timeout' "$LEDGER" \
    || { echo "  FAIL: a render killed by the grind cap was verdicted '$(grep ' hT ' "$LEDGER" | grep -o 'skip:[a-z-]*' || echo pending)' — rc=124 collapsed into 'degenerate material', which is the lie that buried the lane's first-ever drop"; f=1; }
  # the other edge: an honestly-empty render must STAY degenerate — the timeout fix must not eat it
  printf '#!/bin/sh\nexit 0\n' > "$tmp/bin/mesh-room-music"
  printf '2026-07-16T00:02Z ear hU dur=0.2 win=3 score=40 beats=6 [x] dyn=0.2 act=0.3 rich=0.6 move=0.1 cent=1100 -> pending\n' >> "$LEDGER"
  : > "$FAILED_LOG"
  MESH_REC_LOG="$LEDGER" MESH_REC_DIR="$tmp/rec" REC_DIR="$tmp/rec" SR_FAILED_LOG="$FAILED_LOG" GRIND_TIMEOUT=1 MESH_TEST_SANDBOX=1 tick 2>/dev/null
  for i in $(seq 1 20); do grep -q ' hU .*-> skip:' "$LEDGER" && break; sleep 0.5; done
  grep -q ' hU .*-> skip:degenerate' "$LEDGER" \
    || { echo "  FAIL: an honestly-empty render lost its degenerate verdict (got: $(grep ' hU ' "$LEDGER" | grep -o 'skip:[a-z-]*' || echo pending)) — both edges of the empty-output signal need the same gate"; f=1; }
  # the degenerate verdict feeds the FAILED store too — its poke itself says "either the recipe is
  # pathological or the source is thinner", so the recipe half must repel next time. Asserted at THIS
  # call site as well: a rule asserted at one of two copy-paste sites is not asserted.
  grep -q ' hU amc ' "$FAILED_LOG" \
    || { echo "  FAIL: a live skip:degenerate verdict left no recipe in the FAILED store (got: '$(cat "$FAILED_LOG" 2>/dev/null)') — the degenerate call site never learns, only the hollow one"; f=1; }
  # the THIRD cause: rc=75 (EX_TEMPFAIL) is mesh-heavy-run refusing the grind's RAM budget under node
  # pressure — a DEFER, not degenerate material. It must NOT collapse into skip:degenerate (that lie
  # slandered ~15 live ear records across one pressured window, 2026-07-17). Its own verdict.
  printf 'x' > "$tmp/rec/t-hD.mp3"
  printf '#!/bin/sh\nexit 75\n' > "$tmp/bin/mesh-room-music"
  printf '2026-07-16T00:03Z ear hD dur=0.2 win=3 score=40 beats=6 [x] dyn=0.2 act=0.3 rich=0.6 move=0.1 cent=1100 -> pending\n' >> "$LEDGER"
  MESH_REC_LOG="$LEDGER" MESH_REC_DIR="$tmp/rec" REC_DIR="$tmp/rec" GRIND_TIMEOUT=1 MESH_TEST_SANDBOX=1 tick 2>/dev/null
  for i in $(seq 1 20); do grep -q ' hD .*-> skip:' "$LEDGER" && break; sleep 0.5; done
  grep -q ' hD .*-> skip:deferred' "$LEDGER" \
    || { echo "  FAIL: a grind DEFERRED by mesh-heavy-run (rc=75) was verdicted '$(grep ' hD ' "$LEDGER" | grep -o 'skip:[a-z-]*' || echo pending)' — an admission refusal collapsed into 'degenerate material', slandering a live record the node was merely too pressured to grind"; f=1; }
  # the FOURTH cause: rc=137 = the grind was cgroup-OOM-KILLED at its MemoryMax ceiling (admitted, then
  # its RSS blew past the per-job budget). NOT degenerate material — it must verdict skip:oom, not
  # collapse into degenerate (that lie slandered ~10 note3 records in a row, 2026-07-18 01:42→02:32,
  # whose material grinds fine at a modest recipe). Its own verdict, distinct from defer (75) and
  # timeout (124). timeout returns 124 on its OWN kill, never 137, so a 137 reaching the reflex is
