  printf '2026-07-16T00:04Z ear hO dur=0.2 win=3 score=40 beats=6 [x] dyn=0.2 act=0.3 rich=0.6 move=0.1 cent=1100 -> pending\n' >> "$LEDGER"
  MESH_REC_LOG="$LEDGER" MESH_REC_DIR="$tmp/rec" REC_DIR="$tmp/rec" GRIND_TIMEOUT=1 MESH_TEST_SANDBOX=1 tick 2>/dev/null
  for i in $(seq 1 20); do grep -q ' hO .*-> skip:' "$LEDGER" && break; sleep 0.5; done
  grep -q ' hO .*-> skip:oom' "$LEDGER" \
    || { echo "  FAIL: a grind OOM-KILLED at its memory ceiling (rc=137) was verdicted '$(grep ' hO ' "$LEDGER" | grep -o 'skip:[a-z()-]*' || echo pending)' — a cgroup-OOM collapsed into 'degenerate material', slandering ~10 note3 records whose material grinds fine at a modest recipe"; f=1; }
  # the FIFTH cause: rc=1 carrying mesh-room-music's own "hollow/undecodable ... refusing to log/ship"
  # refusal — the grind RAN but the OUTPUT decoded to a near-silent/undecodable track. This is what the
  # bare else silently ate: it has NO distinguishing rc (rc=1 is generic), so it must be caught by the
