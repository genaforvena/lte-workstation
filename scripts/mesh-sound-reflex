    || { echo "  FAIL: a render that came out HOLLOW (mesh-room-music refused to ship it, rc=1) was verdicted '$(grep ' hH ' "$LEDGER" | grep -o 'skip:[a-z()-]*' || echo pending)' — a recipe-marginal hollow render collapsed into 'degenerate material', writing a permanent thin-source judgement for a flaky/recipe outcome"; f=1; }
  # ... and the hollow verdict must FEED THE FAILED STORE from the real detached-child path (3b
  # asserts the store repels; this asserts the store is actually written when a live render hollows —
  # without it the repellent fix only works in the test that hand-feeds it).
  grep -q ' hH amc ' "$FAILED_LOG" \
    || { echo "  FAIL: a live skip:hollow verdict left no recipe in the FAILED store (got: '$(cat "$FAILED_LOG" 2>/dev/null)') — the repellent never learns what failed and the same combo re-derives (the 2026-07-20 loop, end-to-end half)"; f=1; }
  # the SIXTH cause: rc=1 carrying mesh-room-music's "no FRESH output" refusal — the automix ran and
  # produced NO new mp3 at all (the grind python crashed / its environment broke before any track
