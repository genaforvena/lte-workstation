  # flaky 2026-07-18 (2f12b432, slandered skip:degenerate at 10:40, grinds to a real -1.5dB mp3 on its
  # identical recipe on retry). Its own verdict, distinct from the no-message empty (hU) below it.
  printf 'x' > "$tmp/rec/t-hH.mp3"
  printf '#!/bin/sh\necho "remix: automix produced a hollow/undecodable track (x.mp3) — refusing to log/ship a broken grind"\nexit 1\n' > "$tmp/bin/mesh-room-music"
  printf '2026-07-16T00:05Z ear hH dur=0.2 win=3 score=40 beats=6 [x] dyn=0.2 act=0.3 rich=0.6 move=0.1 cent=1100 -> pending\n' >> "$LEDGER"
  : > "$FAILED_LOG"
  MESH_REC_LOG="$LEDGER" MESH_REC_DIR="$tmp/rec" REC_DIR="$tmp/rec" SR_FAILED_LOG="$FAILED_LOG" GRIND_TIMEOUT=1 MESH_TEST_SANDBOX=1 tick 2>/dev/null
