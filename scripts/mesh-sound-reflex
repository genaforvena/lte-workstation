  # absent → ulimit -v fallback → sklearn import death, f27604f) verdicted ~40 healthy note3 records
  # skip:hollow(recipe), fed every phantom "failed recipe" into the repellent store (all later
  # truncated as bug artifacts), and sent the sound mind chasing render quality for a crash. A
  # no-render is an ENGINE/ENV signal: own verdict, own poke, and it must NOT feed the failed store.
  printf 'x' > "$tmp/rec/t-hN.mp3"
  printf '#!/bin/sh\necho "remix: automix produced no FRESH output (grind failed — refusing to resend stale x.mp3)"\nexit 1\n' > "$tmp/bin/mesh-room-music"
  printf '2026-07-16T00:06Z ear hN dur=0.2 win=3 score=40 beats=6 [x] dyn=0.2 act=0.3 rich=0.6 move=0.1 cent=1100 -> pending\n' >> "$LEDGER"
  : > "$FAILED_LOG"
  MESH_REC_LOG="$LEDGER" MESH_REC_DIR="$tmp/rec" REC_DIR="$tmp/rec" SR_FAILED_LOG="$FAILED_LOG" GRIND_TIMEOUT=1 MESH_TEST_SANDBOX=1 tick 2>/dev/null
