#!/usr/bin/env bash
# mesh-uxn-drift — deploy shim for the uxn emulator drift detector.
# The net device (0xd0) moved drift from the byte-identical ROM to the per-arch, versioned
# EMULATOR (bin/uxncli); this reflex asserts the running binary identifies its net device at
# the NET_IDENT its source declares — a stale binary fails CLOSED but silent otherwise.
# Real tool lives with its ROMs at scripts/uxn/mesh-uxn-drift.
# reflex-cadence: 23 */6 * * *
set -eu
REPO="${MESH_REPO:-$HOME/lte-workstation}"
TARGET="$REPO/scripts/uxn/mesh-uxn-drift"
[ -x "$TARGET" ] || { echo "mesh-uxn-drift: n/a — no genome checkout at $TARGET (set MESH_REPO)" >&2; exit 2; }
exec "$TARGET" "$@"
