#!/usr/bin/env bash
# reflex-cadence: 6-59/10 * * * *
# reflex-args: --edge
# doctor-artifact: $HOME/.mesh/.note3-gyro-uncal.state 1200 phone
# mesh-note3-gyro-uncal — raw rotational-motion signal from the Note 3's
# UNCALIBRATED gyroscope (Android sensor type 16).
# Its existing --edge reflex also reads the distinct Android gravity vector (type 9), which is
# exposed by the same body HAL but was previously untapped; use --gravity for that one-shot axis.
#
# This is a new body axis beside mesh-note3-gyro: the calibrated gyro reports
# angular velocity after the HAL's calibration, while this reports the sensor's
# raw vector, including its measured bias. That bias is useful evidence about
# the physical sensor state and is not interchangeable with the calibrated axis.
# The source is a live sensorcat listener over the authorized USB ADB body link.
#
# Honest contract: no ADB body, no sensor event, malformed values, or non-finite
# values => exit 2 and no state write. A real zero vector is STILL, not blindness.
#
#   mesh-note3-gyro-uncal          one live reading
#   mesh-note3-gyro-uncal --json   machine-readable reading
#   mesh-note3-gyro-uncal --edge   write live state; print only a changed band
#   mesh-note3-gyro-uncal --test   fixture/parser checks plus a real ADB read
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME="$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6)"; export HOME
[ -f "$HOME/.mesh/nodes" ] && [ -z "${MESH_SKIP_NODES_SOURCE:-}" ] && . "$HOME/.mesh/nodes"

MESH="${MESH_DIR:-$HOME/.mesh}"
STATE="$MESH/.note3-gyro-uncal.state"
GRAVITY_STATE="$MESH/.note3-gravity.state"
NODE="${MESH_NOTE3_ADB_NODE:-${MESH_BARO_ADB_NODE:-}}"
SERIAL="${MESH_NOTE3_GYRO_UNCAL_SERIAL:-${MESH_NOTE3_ADB_SERIAL:-${MESH_BARO_ADB_SERIAL:-}}}"

parse_raw() {
  awk -F'|' '$1=="SENSOR" && $3=="16" {
    gsub(/[\r ]/,"",$4); gsub(/[\r ]/,"",$5); gsub(/[\r ]/,"",$6); gsub(/[\r ]/,"",$7)
    if ($4 ~ /^-?[0-9]+(\.[0-9]+)?$/ && $5 ~ /^-?[0-9]+(\.[0-9]+)?$/ &&
        $6 ~ /^-?[0-9]+(\.[0-9]+)?$/ && $7 ~ /^[0-9]+$/) print $4 "," $5 "," $6 "," $7
    exit
  }'
}

read_raw() {
  if [ -n "${MESH_NOTE3_GYRO_UNCAL_RAW_OVERRIDE:-}" ]; then
    printf '%s\n' "$MESH_NOTE3_GYRO_UNCAL_RAW_OVERRIDE"; return 0
  fi
  [ "$NODE" = local ] && [ -n "$SERIAL" ] || return 1
  timeout 20 adb -s "$SERIAL" shell '/data/local/tmp/sensorcat --secs 2 16' 2>/dev/null | parse_raw
}

parse_gravity_raw() {
  awk -F'|' '$1=="SENSOR" && $3=="9" {
    for (i=4; i<=7; i++) gsub(/[\r ]/, "", $i)
    if ($4 ~ /^-?([0-9]+(\.[0-9]*)?|\.[0-9]+)([eE][+-]?[0-9]+)?$/ &&
        $5 ~ /^-?([0-9]+(\.[0-9]*)?|\.[0-9]+)([eE][+-]?[0-9]+)?$/ &&
        $6 ~ /^-?([0-9]+(\.[0-9]*)?|\.[0-9]+)([eE][+-]?[0-9]+)?$/ &&
        $7 ~ /^[1-9][0-9]*$/) print $4 "," $5 "," $6 "," $7
    exit
  }'
}

read_gravity_raw() {
  if [ -n "${MESH_NOTE3_GRAVITY_RAW_OVERRIDE:-}" ]; then
    printf '%s\n' "$MESH_NOTE3_GRAVITY_RAW_OVERRIDE"; return 0
  fi
  [ "$NODE" = local ] && [ -n "$SERIAL" ] || return 1
  timeout 20 adb -s "$SERIAL" shell '/data/local/tmp/sensorcat --secs 3 9' 2>/dev/null | parse_gravity_raw
}

emit_gravity() {
  local raw="$1" gx gy gz tick ts
  IFS=, read -r gx gy gz tick <<EOF
$raw
EOF
  ts="$(date -u +%FT%TZ)"
  mkdir -p "$MESH" 2>/dev/null || return 1
  printf 'gx=%s|gy=%s|gz=%s|hal_tick_ns=%s|ts=%s\n' "$gx" "$gy" "$gz" "$tick" "$ts" >"$GRAVITY_STATE" || return 1
  printf '[note3-gravity] gx=%s gy=%s gz=%s m/s2 hal_tick_ns=%s ts=%s\n' "$gx" "$gy" "$gz" "$tick" "$ts"
}

band() {
  python3 - "$1" "$2" "$3" <<'PY'
import math, sys
x, y, z = map(float, sys.argv[1:4])
print("ROTATING" if math.sqrt(x*x + y*y + z*z) >= 0.05 else "STILL")
PY
}

if [ "${1:-}" = --test ]; then
  fixture='SENSOR|MPU6500 Uncalibrated Gyroscope Sensor|16|0.01|-0.02|0.03|123456789'
  got="$(printf '%s\n' "$fixture" | parse_raw)"
  [ "$got" = '0.01,-0.02,0.03,123456789' ] || { echo "smoke-test: FAIL (parser: $got)"; exit 1; }
  bad='SENSOR|MPU6500 Uncalibrated Gyroscope Sensor|16|nan|0|0|123'
  [ -z "$(printf '%s\n' "$bad" | parse_raw)" ] || { echo 'smoke-test: FAIL (non-finite value accepted)'; exit 1; }
  [ "$(band 0 0 0)" = STILL ] || { echo 'smoke-test: FAIL (zero vector)'; exit 1; }
  [ "$(band 0.05 0 0)" = ROTATING ] || { echo 'smoke-test: FAIL (rotation threshold)'; exit 1; }
  gravity_fixture='SENSOR|Gravity Sensor|9|1.25|-2.50|9.81|123456789'
  gravity_got="$(printf '%s\n' "$gravity_fixture" | parse_gravity_raw)"
  [ "$gravity_got" = '1.25,-2.50,9.81,123456789' ] || { echo "smoke-test: FAIL (gravity parser: $gravity_got)"; exit 1; }
  gravity_bad='SENSOR|Gravity Sensor|9|nan|0|9.81|123456789'
  [ -z "$(printf '%s\n' "$gravity_bad" | parse_gravity_raw)" ] || { echo 'smoke-test: FAIL (non-finite gravity accepted)'; exit 1; }
  live="$(read_raw 2>/dev/null || true)"
  [ -n "$live" ] || { echo 'smoke-test: n/a (Note 3 uncalibrated gyro event unavailable)'; exit 2; }
  gravity_live="$(read_gravity_raw 2>/dev/null || true)"
  [ -n "$gravity_live" ] || { echo 'smoke-test: n/a (Note3 type-9 gravity event unavailable)'; exit 2; }
  echo "smoke-test: ok (parser + honest guards + LIVE ADB type-16 read: $live + type-9 gravity read: $gravity_live)"
  exit 0
fi

if [ "${1:-}" = --gravity ]; then
  gravity_live="$(read_gravity_raw 2>/dev/null || true)"
  [ -n "$gravity_live" ] || { echo 'note3-gravity: UNREACHABLE — no valid live Note3 type-9 gravity event' >&2; exit 2; }
  emit_gravity "$gravity_live" || { echo 'note3-gravity: failed to write live state' >&2; exit 1; }
  exit 0
fi

raw="$(read_raw 2>/dev/null || true)"
[ -n "$raw" ] || { echo 'note3-gyro-uncal: UNREACHABLE (no fresh type-16 sensor event)' >&2; exit 2; }
IFS=, read -r x y z tick <<EOF
$raw
EOF
v="$(band "$x" "$y" "$z")" || { echo 'note3-gyro-uncal: UNREACHABLE (invalid numeric event)' >&2; exit 2; }
mkdir -p "$MESH" 2>/dev/null || exit 1
ts="$(date -u +%FT%TZ)"
printf '%s|x=%s|y=%s|z=%s|tick=%s|ts=%s\n' "$v" "$x" "$y" "$z" "$tick" "$ts" > "$STATE" || exit 1
mesh-state-touch "$STATE" >/dev/null 2>&1 || { echo 'note3-gyro-uncal: failed to stamp live state' >&2; exit 1; }
if [ "${1:-}" = --edge ]; then
  gyro_changed=1
  old="$(sed -n 's/^\([^|]*\).*/\1/p' "$STATE.prev" 2>/dev/null || true)"
  cp "$STATE" "$STATE.prev" 2>/dev/null || true
  [ "$old" = "$v" ] && gyro_changed=0
  gravity_live="$(read_gravity_raw 2>/dev/null || true)"
  [ -n "$gravity_live" ] || { echo 'note3-gravity: UNREACHABLE — no valid live Note3 type-9 gravity event' >&2; exit 2; }
  emit_gravity "$gravity_live" || { echo 'note3-gravity: failed to write live state' >&2; exit 1; }
  [ "$gyro_changed" = 1 ] || exit 0
fi
if [ "${1:-}" = --json ]; then
  printf '{"verdict":"%s","x":%s,"y":%s,"z":%s,"tick":%s,"ts":"%s","source":"Note 3 Android sensor type 16"}\n' "$v" "$x" "$y" "$z" "$tick" "$ts"
else
  printf '[note3-gyro-uncal] %s — x=%s y=%s z=%s tick=%s @ %s\n' "$v" "$x" "$y" "$z" "$tick" "$ts"
fi
