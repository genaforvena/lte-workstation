#!/usr/bin/env bash
# mesh-guitar-watch — catch the operator PLAYING GUITAR in the live mic-fanout captures, then
# ship the original + a few grinds (close-loop / quantized / poly — NEVER rw) to his Telegram.
#
# WHY: the generic source-picker (mesh-sound-reflex, ranked by mesh-soundscape's dyn-heavy score)
# never caught guitar — a strummed acoustic reads as TONAL + harmonically RICH + rhythmic + LOUD,
# and the dyn/score ranker selects for one-shot transients instead (CLAUDE.md "check what your
# ranker SELECTS FOR"). So this is a PURPOSE-BUILT detector with a guitar-shaped multi-axis gate,
# not another score threshold. Operator ask 2026-07-24 ("it never catches me playing guitar …
# if you found — make a reflex to look for it. first original then mix in warry modes but not rw,
# prefer close loop").
#
# THE GATE — recalibrated 2026-08-14 against the operator's OWN guitar take (board task
# guitar-calib-from-operator-take; he asked for it because what we cut out was "всегда не то").
#
# WHAT THE OLD GATE DID, MEASURED. The old gate was `tone>=.85 rich>=.45 rms>=.10 beats>=3`, all four
# ANDed, calibrated on ONE session (2026-07-24, n=20). Ground truth arrived 2026-08-14 21:39Z: an 85s
# guitar take the operator recorded himself and sent as a Telegram voice note. Chopped to 11s at
# 22050/mono — the exact shape of a mic-fanout capture — and run through the same mesh-soundscape
# --measure this reflex calls, it reads tone .84–.94, rich .42–.47, rms .027–.048, beats 5–25:
#   * rms>=0.10 rejects it 8 chops out of 8. His guitar's median rms (.041) is corpus percentile 4.3
#     — he is QUIETER than 95.7% of the ambient the axis was meant to separate him from. `rms` was
#     documented here as "the strongest single axis"; it was pointing the wrong way, and the corpus
#     median rms is .1018, i.e. the floor sat exactly at the ambient median (a coin flip, not a gate).
#   * meanwhile the full AND-gate fired on 5–28% of ALL ambient captures every single day
#     (512/3245 rows in $SCORE_LOG). So it missed him and shipped the room: "всегда не то", exactly.
#   * and no threshold on those axes fixes it — the loosest (tone,rich,beats) combination that catches
#     all 8 chops still passes 29% of the corpus. An axis pointing the wrong way is not retunable.
#
# WHAT THE GATE IS NOW (all three, AND). Two axes that read PITCH STRUCTURE rather than energy, added
# to mesh-soundscape (the one measure tract — never a second librosa analyzer) and computed on the
# WHOLE file over peak-normalised audio, so recording level cannot re-break them the way it broke rms:
#   chent  <= GW_CHENT  (0.991)  chroma entropy — a struck string sits on discrete pitch classes
#   voiced >= GW_VOICED (0.25)   pyin-confident f0 in 70–700 Hz — something PITCHED is sounding
#   beats  >= GW_BEATS  (3)      strumming has rhythmic onsets
# Measured separation (all three populations through the live --measure path):
#   guitar  (8 chops, operator-labelled)   chent .978–.990   voiced .32–.54
#   speech  (5 clips: his own voice note + the mesh's TTS reply)  chent .993–.997  voiced .64–.87
#   ambient (400 random captures across the whole corpus)  chent med .996  voiced med .11
# chent is what rejects SPEECH (voiced alone cannot — a human fundamental is 85–255 Hz, dead centre of
# the guitar range, and speech scores voiced HIGHER than guitar). Result on that 400-capture sample:
# 8/8 ground truth pass, 7.0% of ambient passes — down from 15.8%, with the true positive now caught
# instead of missed.
#
# CODEC CONTROL. The take arrived as Telegram opus and the ambient corpus is raw wav, so a separation
# validated across the two could be detecting the ENCODER. 8 ambient captures round-tripped through
# opus at TG voice-note settings read chent .993–.999 / voiced median .000 — indistinguishable from
# their raw selves. The split is the instrument.
#
# HONEST LIMITS, so the next recalibration knows what it is standing on: ONE labelled positive take
# (8 chops of it, not 8 independent sessions) and 5 speech clips. The 7% of ambient that still passes
# is UNLABELLED — spot-checking it (chent .92–.98, voiced .31–.83, beats 14–41) it looks like pitched
# material: music playing in the room, possibly other guitar sessions. It is not established to be
# false. Every examined capture's axes are logged to $SCORE_LOG — now INCLUDING chent/voiced — so the
# gate is re-derivable from the live corpus and never a pinned constant (CLAUDE.md "calibrate against
# the REAL corpus"). The gate stays LOUD-fail-safe: a capture that misses shows up as a near-threshold
# row in the score log, never a silent drop.
#
# HONEST n/a (exit 2, never a faked all-clear): the mic-fanout dir absent, no new captures, or no TG
# creds -> exit 2, watermark NOT advanced, nothing marked seen (a later run still catches the same
# session). A reachable-but-empty capture dir is n/a, not "no guitar".
#
# ONE DELIVERY PER SESSION: the operator plays for minutes = many 3-min captures. Per tick this ships
# only the SINGLE loudest new hit, then advances the watermark past EVERY capture examined this tick,
# so a continuous session is one delivery (orig + 3 grinds), not one per capture.
#
# reflex-cadence: */15 * * * *
set -uo pipefail
export PATH="/usr/bin:$HOME/.local/bin:$PATH"
export LC_ALL=C.UTF-8
MESH="${MESH_DIR:-$HOME/.mesh}"

CAPDIR="${GW_CAPDIR:-$MESH/mic-fanout/records-mac}"
OUTDIR="${GW_OUTDIR:-$HOME/grainneukeln/output}"
GNK="${GW_GNK:-$HOME/grainneukeln}"
PY="${GW_PY:-$GNK/.venv/bin/python}"
SENT_LOG="${GW_SENT_LOG:-$MESH/room-music-sent.log}"   # shared with mesh-grind-deliver -> no double-send
SEEN_LOG="${GW_SEEN_LOG:-$MESH/guitar-watch.seen}"     # captures this reflex has already examined+shipped-from
SCORE_LOG="${GW_SCORE_LOG:-$MESH/guitar-watch.scores}" # EVERY capture's axes -> the recalibration corpus
WATERMARK="${GW_WATERMARK:-$MESH/guitar-watch.watermark}"
STATE="${GW_STATE:-$MESH/.guitar-watch-state}"
LOG="${GW_LOG:-$MESH/guitar-watch.log}"
LOCK="${GW_LOCK:-$MESH/.guitar-watch.lock}"
ENVF="${GW_ENVF:-$HOME/.config/remote-access/env}"
SETTLE="${GW_SETTLE:-20}"          # a capture must be this many secs old (fully written) before measured

# GATE thresholds (env-tunable). Recalibrated 2026-08-14 against the operator's OWN take — see the
# header. chent/voiced DECIDE; tone/rich/rms are measured and logged as context but gate NOTHING.
GW_CHENT="${GW_CHENT:-0.991}"    # <=  pitch-class structure: guitar .978–.990 | speech .993–.997 | ambient med .996
GW_VOICED="${GW_VOICED:-0.25}"   # >=  confident f0 in 70–700Hz: guitar .32–.54 | ambient med .11
GW_BEATS="${GW_BEATS:-3}"        # >=  strumming has rhythmic onsets (guitar chops: 5–25)
# retired as gates, kept for the score log / recipe derivation only:
GW_TONE="${GW_TONE:-0.85}"
GW_RICH="${GW_RICH:-0.45}"
GW_RMS="${GW_RMS:-0.10}"

# CALIBRATION FIXTURES — the operator's own labelled audio, node-local (audio never goes in the
# genome). guitar.wav = an 11s chop of his 2026-08-14 21:39Z take; speech.wav = a chop of the voice
# note he sent two minutes earlier. --test drives both through the live measure path; absent, it says
# SKIP rather than passing hollow.
FIX_DIR="${GW_FIX_DIR:-$MESH/fixtures/guitar-calib}"
FIX_GUITAR="${GW_FIX_GUITAR:-$FIX_DIR/guitar.wav}"
FIX_SPEECH="${GW_FIX_SPEECH:-$FIX_DIR/speech.wav}"

# LONGER SOURCE (operator 2026-07-24 "it should be longer sources … songs that start and end silence
# to silence"): a 12s fanout sample is only the DETECTION trigger. The SOURCE we grind is the whole
# song, silence-bounded. Two ways, in order of preference:
#   1. fresh long-record from the mac mic (he's likely still playing — the fanout just caught him),
#      trimmed silence-to-silence.
#   2. else concatenate the recent guitar-ish captures of this session into a longer medley.
# CAP_SECS used to be 55s "safely under the ~65s grinder ceiling" — that ceiling was a MYTH, not a
# mixer limit: [[grind-cap-is-the-reflexs-not-the-mixers]] measured main.py grinding a full 4-min
# source fine, LINEARLY (~30s wall, ~1.2GB RSS). A real session runs across many 2-min mac-fanout
# chunks over an hour+ (see guitar-watch.scores), so a 55s cap threw away 90%+ of what he played and
# shipped the remainder captioned as if it were the session — the failure the operator flagged
# 2026-08-14 ("never managed to cut what I was playing in full … HUGE windows of silence"). Raised to
# 600s (10min) — generous headroom over any real session, nowhere near the OOM regime.
MAC_SSH="${GW_MAC_SSH:-ilya@192.168.8.214}"
MAC_BIN="${GW_MAC_BIN:-\$HOME/.mesh-mac/macmic}"
SSH_OPTS="-o StrictHostKeyChecking=no -o ConnectTimeout=8 -o BatchMode=yes"
LONG_SECS="${GW_LONG_SECS:-75}"    # fresh-record length (macmic self-bounds); a whole short song
CAP_SECS="${GW_CAP_SECS:-600}"     # hard feed cap — generous, not the stale ~65s mixer myth (see above)
SESSION_MIN="${GW_SESSION_MIN:-45}"   # look back this many minutes to gather session captures for the medley
MIN_SRC_SECS="${GW_MIN_SRC_SECS:-14}" # a source shorter than this -> not worth a 5-mix batch, use the sample
# stop_periods=-1 (not 1): a mac-fanout chunk spans ~2min and often has a real pause INSIDE it (between
# phrases/songs/adjusting the guitar), not just at the edges. periods=1 strips only ONE leading and ONE
# trailing silence run, so every internal pause rode straight through into the shipped medley — the
# "HUGE windows of silence" the operator heard. -1 = unlimited repeats, so ffmpeg strips every silent
# run wherever it falls in the stream, edges and interior alike.
SILENCE_TRIM="silenceremove=start_periods=1:start_threshold=-45dB:start_silence=0.15:stop_periods=-1:stop_threshold=-45dB:stop_silence=0.25:detection=rms"
N_MIXES="${GW_N_MIXES:-5}"         # diverse grinds per session
GENERATOR="${GW_GENERATOR:-$HOME/.local/bin/mesh-grind-params.py}"

ts_utc(){ date -u +%FT%TZ; }
log(){ printf '%s %s\n' "$(ts_utc)" "$*" >> "$LOG" 2>/dev/null || true; }
now(){ echo "${GW_NOW:-$(date +%s)}"; }

# measure a wav -> "tone rich rms beats chent voiced" (space-sep), or empty on failure.
# chent/voiced are the GATE axes; tone/rich/rms are kept as LOGGED CONTEXT only (they no longer
# decide anything — see the gate note in the header). A MEASURE line without them is an old
# mesh-soundscape: fail closed (return 1) rather than gate on absent axes, which would silently
# revert this reflex to the broken energy gate.
measure_axes(){
  local m; m=$(mesh-soundscape --measure "$1" 2>/dev/null) || return 1
  [ -n "$m" ] || return 1
  local tone rich rms beats chent voiced
  tone=$(printf '%s' "$m" | grep -oP 'tone=\K[0-9.]+')
  rich=$(printf '%s' "$m" | grep -oP 'rich=\K[0-9.]+')
  rms=$(printf '%s' "$m"  | grep -oP 'rms=\K[0-9.]+')
  beats=$(printf '%s' "$m" | grep -oP 'beats=\K[0-9]+')
  chent=$(printf '%s' "$m" | grep -oP 'chent=\K[0-9.]+')
  voiced=$(printf '%s' "$m" | grep -oP 'voiced=\K[0-9.]+')
  [ -n "$tone" ] && [ -n "$rich" ] && [ -n "$rms" ] && [ -n "$beats" ] || return 1
  [ -n "$chent" ] && [ -n "$voiced" ] || return 1
  printf '%s %s %s %s %s %s\n' "$tone" "$rich" "$rms" "$beats" "$chent" "$voiced"
}

# is-guitar? $1=chent $2=voiced $3=beats  -> rc 0 if clears the gate
is_guitar(){
  awk -v c="$1" -v v="$2" -v b="$3" \
      -v C="$GW_CHENT" -v V="$GW_VOICED" -v B="$GW_BEATS" \
      'BEGIN{ exit !(c+0<=C && v+0>=V && b+0>=B) }'
}

# ---- creds -----------------------------------------------------------------
load_creds(){
  [ -f "$ENVF" ] || return 1
  set -a; . "$ENVF" 2>/dev/null; set +a
  TOK="${BOT_TOKEN:-${TG_BOT_TOKEN:-}}"; CHAT="${CHAT_ID:-${TG_CHAT_ID:-}}"
  [ -n "${TOK:-}" ] && [ -n "${CHAT:-}" ]
}

# send an audio file to the operator ($1=path $2=caption); marks it in the shared sent ledger. rc!=0 = fail
send_audio(){
  local f="$1" cap="$2" r
  if [ "${GW_DRYRUN:-0}" = 1 ]; then echo "DRYRUN send: $(basename "$f") :: $cap"; echo " $(basename "$f")" >> "$SENT_LOG"; return 0; fi
  r=$(curl -s --max-time 120 "https://api.telegram.org/bot${TOK}/sendAudio" \
        -F chat_id="${CHAT}" -F audio=@"$f" -F caption="$cap" 2>/dev/null)
  if printf '%s' "$r" | grep -q '"ok":true'; then
    printf ' %s\n' "$(basename "$f")" >> "$SENT_LOG"; return 0
  fi
  log "sendAudio FAILED $(basename "$f"): $(printf '%s' "$r" | head -c 160)"; return 1
}

# duration of a wav/mp3 in seconds (0 on failure)
dur_of(){ ffprobe -v error -show_entries format=duration -of csv=p=0 "$1" 2>/dev/null || echo 0; }

# trim leading/trailing silence -> "silence to silence", then hard-cap to CAP_SECS. $1=in $2=out
trim_and_cap(){
  local in="$1" out="$2" tmp="${2%.wav}.trim.wav"
  ffmpeg -v error -y -i "$in" -af "$SILENCE_TRIM" "$tmp" >/dev/null 2>&1 || return 1
  local d; d=$(dur_of "$tmp")
  if awk -v d="$d" -v c="$CAP_SECS" 'BEGIN{exit !(d+0>c)}'; then
    ffmpeg -v error -y -i "$tmp" -t "$CAP_SECS" "$out" >/dev/null 2>&1 || return 1
  else
    mv "$tmp" "$out"
  fi
  rm -f "$tmp"
  [ -s "$out" ]
}

# 1. fresh long-record from the mac mic, silence-trimmed. Prints path (or empty). Only USED if the
#    result still clears the guitar gate (he's still playing) — else it's ambient/silence, discarded.
capture_song(){
  local out="$1" raw="$MESH/inbox/.gw-fresh.m4a" wav="$MESH/inbox/.gw-fresh.wav"
  timeout -s KILL $((LONG_SECS+20)) ssh $SSH_OPTS "$MAC_SSH" "$MAC_BIN /tmp/gw-song.m4a $LONG_SECS" >/dev/null 2>&1 || { log "fresh-record: mac unreachable/asleep"; return 1; }
  timeout -s KILL 30 scp $SSH_OPTS "$MAC_SSH:/tmp/gw-song.m4a" "$raw" >/dev/null 2>&1 || { log "fresh-record: pull failed"; return 1; }
  [ -s "$raw" ] || return 1
  ffmpeg -v error -y -i "$raw" -ac 1 -ar 22050 -af loudnorm=I=-16:TP=-1 "$wav" >/dev/null 2>&1 || return 1
  trim_and_cap "$wav" "$out" || return 1
  rm -f "$raw" "$wav"
  printf '%s\n' "$out"
}

# 2. concatenate this session's guitar-ish captures (looser gate than DETECTION: any tonal+rhythmic
#    material from the playing window) into one longer silence-trimmed medley. Prints path or empty.
build_session_source(){
  local out="$1" work="$MESH/inbox/.gw-medley"; rm -rf "$work"; mkdir -p "$work"
  local wm_secs=$((SESSION_MIN*60)) idx=0 f m tone rms beats
  # captures within the last SESSION_MIN, oldest-first (chronological song order)
  while IFS= read -r f; do
    m=$(mesh-soundscape --measure "$f" 2>/dev/null) || continue
    tone=$(printf '%s' "$m"|grep -oP 'tone=\K[0-9.]+'); rms=$(printf '%s' "$m"|grep -oP 'rms=\K[0-9.]+'); beats=$(printf '%s' "$m"|grep -oP 'beats=\K[0-9]+')
    awk -v t="$tone" -v r="$rms" -v b="$beats" 'BEGIN{exit !(t+0>=0.82 && r+0>=0.06 && b+0>=4)}' || continue
    ffmpeg -v error -y -i "$f" -af "$SILENCE_TRIM" "$work/$(printf %03d $idx).wav" >/dev/null 2>&1 && idx=$((idx+1))
  done < <(find "$CAPDIR" -type f -name '*.wav' -newermt "-${SESSION_MIN} min" 2>/dev/null | sort)
  [ "$idx" -gt 0 ] || { rm -rf "$work"; return 1; }
  ls "$work"/*.wav | sort | sed "s/^/file '/;s/$/'/" > "$work/list.txt"
  ffmpeg -v error -y -f concat -safe 0 -i "$work/list.txt" -ac 1 -ar 22050 "$work/joined.wav" >/dev/null 2>&1 || { rm -rf "$work"; return 1; }
  local d; d=$(dur_of "$work/joined.wav")
  if awk -v d="$d" -v c="$CAP_SECS" 'BEGIN{exit !(d+0>c)}'; then
    ffmpeg -v error -y -i "$work/joined.wav" -t "$CAP_SECS" "$out" >/dev/null 2>&1 || { rm -rf "$work"; return 1; }
  else
    cp "$work/joined.wav" "$out"
  fi
  rm -rf "$work"; [ -s "$out" ] && printf '%s\n' "$out"
}

# choose the SOURCE to grind: prefer a fresh long-record (if it's still guitar), else the session
# medley, else the 12s detection sample. Prints "<path>\t<label>".
select_source(){
  local sample="$1" fresh="$MESH/inbox/guitar-song-fresh.wav" medley="$MESH/inbox/guitar-song-medley.wav" p axes
  if p=$(capture_song "$fresh"); then
    axes=$(measure_axes "$p")
    if [ -n "$axes" ] && read -r t r m b ce vo <<<"$axes" && is_guitar "$ce" "$vo" "$b"; then
      # NOT "целиком" (in full/entirely) — this is a fresh LONG_SECS-bounded snapshot starting at
      # THIS tick, so it necessarily misses anything he played before detection fired. Only the
      # session medley (below) can honestly claim to span the whole thing. False "in full" claims on
      # a bounded artifact are exactly the failure class CLAUDE.md calls out (a claim vs its artifact).
      printf '%s\tживая запись сейчас (%.0fс)\n' "$p" "$(dur_of "$p")"; return 0
    fi
    log "fresh-record was not guitar (he stopped) — falling back to session medley"
  fi
  if p=$(build_session_source "$medley") && awk -v d="$(dur_of "$p")" -v m="$MIN_SRC_SECS" 'BEGIN{exit !(d+0>=m)}'; then
    printf '%s\tсессия склеена (%.0fс)\n' "$p" "$(dur_of "$p")"; return 0
  fi
  printf '%s\tфрагмент (%.0fс)\n' "$sample" "$(dur_of "$sample")"; return 0
}

# grind $1=src with amc-token-ARRAY (remaining args) into OUTDIR -> prints new mp3 path or empty
grind(){
  local src="$1"; shift; local out d
  mkdir -p "$OUTDIR"
  ( cd "$GNK" && timeout 260 "$PY" main.py "$src" "$OUTDIR" amc "$@" ) >/dev/null 2>&1 || return 1
  out=$(ls -t "$OUTDIR"/*.mp3 2>/dev/null | head -1)
  [ -n "$out" ] && [ -s "$out" ] || return 1
  d=$(dur_of "$out")
  awk -v d="$d" 'BEGIN{exit !(d+0>=0.5)}' || { log "grind collapsed dur=$d"; return 1; }
  printf '%s\n' "$out"
}

# human caption from an amc token list — names the knobs that actually turned (so each mix reads
# as genuinely different, not "mix 3/5").
caption_of(){
  local n="$1"; shift; local -a a=("$@"); local i mode="" parts=""
  for ((i=0;i<${#a[@]};i++)); do case "${a[i]}" in
    m) mode="${a[i+1]}";;
    lib) [ "${a[i-1]}" != m ] && parts+=" ${a[i+1]}";;
    ek) parts+=" euclid${a[i+1]}/${a[i+3]}";;
    l) parts+=" зерно${a[i+1]}";;
    ss) parts+=" ss${a[i+1]}";;
    s) [ "${a[i-1]}" != ss ] && parts+=" s${a[i+1]}";;
    c) parts+=" ${a[i+1]}Hz";;
    sw) parts+=" swing${a[i+1]}";;
    rv) parts+=" реверс${a[i+1]}";;
    w) parts+=" w${a[i+1]}";;
  esac; done
  case "$mode" in lib) mode="close loop";; q) mode="quantized";; poly) mode="poly";; esac
  printf '%s/%s · %s ·%s' "$n" "$N_MIXES" "$mode" "$parts"
}

# process a detected guitar session: pick a LONGER source, ship it as original, then N DIVERSE grinds
deliver_session(){
  local sample="$1" tone="$2" rich="$3" rms="$4" beats="$5"
  local base tstamp src label mp3
  base=$(basename "$sample" .wav)
  tstamp=$(printf '%s' "$base" | grep -oP '^\d{8}-\K\d{4}' | sed 's/\(..\)\(..\)/\1:\2/')
  mkdir -p "$MESH/inbox"

  IFS=$'\t' read -r src label < <(select_source "$sample")
  log "source: $(basename "$src") ($label) for detection $base"

  mp3="$MESH/inbox/guitar-orig-${tstamp/:/}.mp3"
  ffmpeg -y -i "$src" -codec:a libmp3lame -q:a 2 "$mp3" >/dev/null 2>&1 || { log "orig encode failed"; return 1; }
  send_audio "$mp3" "твоя гитара, поймал (${tstamp:-?}) — $label. дальше $N_MIXES намолов, все параметры крутятся разом, каждый другой. без rw." \
    || { log "orig send failed"; return 1; }
  log "shipped ORIGINAL from $(basename "$src") ($label)"

  # diverse deterministic param sets keyed on the source basename
  local key i=0 n=0 dropped=0 mode amc g cap verdict vr
  key=$(basename "$src" .wav)
  while IFS=$'\t' read -r mode amc; do
    i=$((i+1)); local -a A; read -ra A <<<"$amc"
    g=$(grind "$src" "${A[@]}") || { log "grind $i ($mode) failed"; continue; }
    # LISTEN before shipping (operator 2026-07-24 "вы хоть раз сами слушайте и проверяйте что песня"):
    # verify the render is still a coherent song vs the source. Drop mud / lost-song; ship the rest.
    # rc 2 = analyzer n/a → ship LOUD-unverified (honest), never silently trust an unheard file.
    if command -v mesh-song-verify >/dev/null 2>&1; then
      verdict=$(mesh-song-verify "$src" "$g"); vr=$?
      if [ "$vr" = 1 ]; then log "mix $i DROPPED (not a song): $verdict"; dropped=$((dropped+1)); continue; fi
      [ "$vr" = 2 ] && log "mix $i UNVERIFIED (analyzer n/a): $verdict — shipping loud"
    fi
    cap=$(caption_of "$i" "${A[@]}")
    send_audio "$g" "$cap" && { log "shipped mix $i: $cap"; n=$((n+1)); }
  done < <("$GENERATOR" "$key" "$N_MIXES" 2>/dev/null || python3 "$GENERATOR" "$key" "$N_MIXES")
  log "session $base delivered: original + $n/$N_MIXES diverse grinds (dropped $dropped as not-a-song)"
  return 0
}

# ---- --test ----------------------------------------------------------------
# Real-read gate: a synthesized TONAL+rhythmic wav MUST clear the guitar gate, and a flat-noise wav
# MUST NOT — proving the gate discriminates on REAL measured axes, not a stub. (CLAUDE.md: a gate you
# have not seen FAIL is not a gate.)
#
# Leg 1b is the REGRESSION leg for the 2026-08-14 recalibration: the operator's OWN take, at its real
# measured axes, must be ACCEPTED. It is exactly the row the old rms>=0.10 gate rejected 8/8 — break
# the fix (restore an rms floor, or raise GW_CHENT past .993) and this goes red, as does the speech
# leg. Leg 2b drives the same assertion through the LIVE measure path on the archived audio itself,
# because axes typed into a test are a fixture, not a read (CLAUDE.md: injected-fixture-bypasses-the-
# parser); it renders SKIP where the fixtures are absent rather than passing hollow.
selftest(){
  local tmp; tmp=$(mktemp -d); local rc=0
  # 1. gate arithmetic: clears / rejects.  args: chent voiced beats
  is_guitar 0.985 0.46 6   || { echo "FAIL: guitar-shaped axes rejected"; rc=1; }
  ! is_guitar 0.996 0.05 4 || { echo "FAIL: ambient-shaped axes accepted"; rc=1; }
  ! is_guitar 0.995 0.70 8 || { echo "FAIL: SPEECH-shaped axes accepted (high voiced, flat chroma) — chent is what rejects speech"; rc=1; }
  ! is_guitar 0.985 0.46 1 || { echo "FAIL: beatless accepted"; rc=1; }
  # 1b. REGRESSION: the operator's own take (2026-08-14 21:39Z, chop3) at its REAL measured axes —
  #     chent .9853 voiced .513 beats 5, and rms .048, which the retired gate rejected outright.
  is_guitar 0.9853 0.513 5 || { echo "FAIL: the operator's OWN labelled guitar take is rejected (this is the bug being fixed)"; rc=1; }
  # 2. REAL measure: a tonal 220Hz+440Hz pluck-train must measure high tone; flat white noise low tone
  if command -v ffmpeg >/dev/null 2>&1 && command -v mesh-soundscape >/dev/null 2>&1; then
    ffmpeg -y -f lavfi -i "sine=frequency=220:duration=4" -af "tremolo=f=4:d=0.9" "$tmp/tone.wav" >/dev/null 2>&1
    ffmpeg -y -f lavfi -i "anoisesrc=d=4:c=white:a=0.3" "$tmp/noise.wav" >/dev/null 2>&1
    local ta na
    ta=$(measure_axes "$tmp/tone.wav")  || { echo "FAIL: could not measure a real tonal wav (soundscape dead?)"; rc=1; }
    na=$(measure_axes "$tmp/noise.wav") || { echo "FAIL: could not measure a real noise wav"; rc=1; }
    if [ -n "$ta" ] && [ -n "$na" ]; then
      local tt nt; tt=$(echo "$ta"|awk '{print $1}'); nt=$(echo "$na"|awk '{print $1}')
      awk -v a="$tt" -v b="$nt" 'BEGIN{exit !(a+0>b+0)}' \
        || { echo "FAIL: tonal wav did not measure higher tone than noise (tone $tt vs $nt)"; rc=1; }
      echo "real-read: tonal tone=$tt > noise tone=$nt  (axes measured live, not stubbed)"
    fi
  else
    echo "SKIP real-read: ffmpeg/mesh-soundscape absent (exit 2 territory on a live node)"
  fi
  # 2b. GROUND TRUTH through the live measure path: the operator's archived guitar chop must be
  #     ACCEPTED and his archived speech clip REJECTED — the two labelled populations this gate was
  #     calibrated on, re-measured rather than typed in.
  if [ -f "$FIX_GUITAR" ] && [ -f "$FIX_SPEECH" ] && command -v mesh-soundscape >/dev/null 2>&1; then
    local ga sa gce gvo gb sce svo sb
    ga=$(measure_axes "$FIX_GUITAR"); sa=$(measure_axes "$FIX_SPEECH")
    if [ -n "$ga" ] && [ -n "$sa" ]; then
      read -r _ _ _ gb gce gvo <<<"$ga"; read -r _ _ _ sb sce svo <<<"$sa"
      is_guitar "$gce" "$gvo" "$gb" \
        || { echo "FAIL: ground-truth guitar fixture REJECTED (chent=$gce voiced=$gvo beats=$gb)"; rc=1; }
      ! is_guitar "$sce" "$svo" "$sb" \
        || { echo "FAIL: ground-truth SPEECH fixture accepted as guitar (chent=$sce voiced=$svo beats=$sb)"; rc=1; }
      # report the ACTUAL verdicts, not the expected ones — a summary line that prints PASS/REJECT
      # unconditionally is a claim about the test, not a reading of it.
      echo "ground-truth: guitar chent=$gce voiced=$gvo $(is_guitar "$gce" "$gvo" "$gb" && echo accepted || echo REJECTED)" \
           "| speech chent=$sce voiced=$svo $(is_guitar "$sce" "$svo" "$sb" && echo ACCEPTED || echo rejected)"
    else
      echo "FAIL: could not measure the ground-truth fixtures (soundscape missing chent/voiced?)"; rc=1
    fi
  else
    echo "SKIP ground-truth: fixtures absent ($FIX_DIR) — node-local calibration audio, not in the genome"
  fi
  # 3. DIVERSE generator: N param sets must be DETERMINISTIC yet DECORRELATED — no two mixes share the
  #    same (l,ss,s) triple (the "readable straight line" the operator rejected), and rw NEVER appears.
  if [ -x "$GENERATOR" ] || [ -f "$GENERATOR" ]; then
    local g1 g2 rwcount triples uniq
    g1=$("$GENERATOR" "selftest-key" 5 2>/dev/null || python3 "$GENERATOR" "selftest-key" 5)
    g2=$("$GENERATOR" "selftest-key" 5 2>/dev/null || python3 "$GENERATOR" "selftest-key" 5)
    [ "$g1" = "$g2" ] || { echo "FAIL: generator not deterministic"; rc=1; }
    rwcount=$(printf '%s\n' "$g1" | grep -cw rw)
    [ "$rwcount" = 0 ] || { echo "FAIL: generator emitted rw ($rwcount times) — operator forbade it"; rc=1; }
    # extract each mix's (l ss s) and assert they aren't all identical
    triples=$(printf '%s\n' "$g1" | grep -oP 'l \K\d+ ss [0-9.]+ s [0-9.]+' | sort)
    uniq=$(printf '%s\n' "$triples" | sort -u | grep -c .)
    [ "$uniq" -ge 4 ] || { echo "FAIL: generator monotonous — only $uniq/5 distinct (l,ss,s) triples"; rc=1; }
    echo "generator: 5 mixes, $uniq distinct (l,ss,s), 0 rw, deterministic ✓"
  else
    echo "SKIP generator test: $GENERATOR absent"
  fi
  rm -rf "$tmp"
  [ "$rc" = 0 ] && echo "mesh-guitar-watch: --test OK" || echo "mesh-guitar-watch: --test FAILED"
  return $rc
}

case "${1:-}" in
  -h|--help) sed -n '2,/^set -uo/p' "$0" | sed -n 's/^# \?//p' | sed '$d'; exit 0 ;;
  --test)    selftest; exit $? ;;
  --status)
    wm=$([ -f "$WATERMARK" ] && cat "$WATERMARK" || echo 0)
    echo "watermark=$wm ($([ "$wm" -gt 0 ] 2>/dev/null && date -d @"$wm" -u +%FT%TZ || echo unset))"
    echo "capdir=$CAPDIR present=$([ -d "$CAPDIR" ] && echo yes || echo NO)"
    echo "gate: chent<=$GW_CHENT voiced>=$GW_VOICED beats>=$GW_BEATS  (tone/rich/rms logged as context, gate nothing)"
    echo "fixtures: $FIX_DIR guitar=$([ -f "$FIX_GUITAR" ] && echo yes || echo NO) speech=$([ -f "$FIX_SPEECH" ] && echo yes || echo NO)"
    echo "recent scores:"; tail -6 "$SCORE_LOG" 2>/dev/null || echo "  (none yet)"
    exit 0 ;;
esac

# ---- main tick -------------------------------------------------------------
exec 9>"$LOCK" 2>/dev/null || true
flock -n 9 || { log "another tick holds the lock; skip"; exit 0; }

[ -d "$CAPDIR" ] || { echo "n/a: capture dir absent ($CAPDIR)"; exit 2; }

WM=$([ -f "$WATERMARK" ] && cat "$WATERMARK" || echo 0)
NOW=$(now); CUTOFF=$((NOW - SETTLE))

# FIRST RUN (no watermark): seed to now WITHOUT shipping — never blast the backlog of old captures.
if [ ! -f "$WATERMARK" ]; then
  echo "$CUTOFF" > "$WATERMARK"
  mesh-state-touch "$STATE" 2>/dev/null || touch "$STATE"
  echo "seeded watermark to $CUTOFF (no backlog blast); exiting"
  exit 0
fi

# new, settled captures since the watermark
mapfile -t NEW < <(find "$CAPDIR" -type f -name '*.wav' -newermt "@$WM" ! -newermt "@$CUTOFF" 2>/dev/null | sort)
if [ "${#NEW[@]}" -eq 0 ]; then
  mesh-state-touch "$STATE" 2>/dev/null || touch "$STATE"   # ran live, just nothing new
  echo "n/a: no new settled captures since watermark"; exit 2
fi

# measure each; log axes; track the MOST GUITAR-LIKE hit. The winner used to be the LOUDEST (max
# rms) — the same discredited axis the gate itself dropped, so on a real session it picked whichever
# capture happened to be loudest, not whichever was most clearly him playing. Winner is now the
# lowest chent (most pitch-class structure), which is the axis the ground truth actually separates on.
best=""; best_chent=2; best_axes=""; maxmtime="$WM"
for f in "${NEW[@]}"; do
  mt=$(stat -c %Y "$f" 2>/dev/null || echo 0); [ "$mt" -gt "$maxmtime" ] && maxmtime="$mt"
  grep -qF -- "$(basename "$f")" "$SEEN_LOG" 2>/dev/null && continue
  axes=$(measure_axes "$f") || { log "measure failed $(basename "$f")"; continue; }
  read -r tone rich rms beats chent voiced <<<"$axes"
  hit="-"; is_guitar "$chent" "$voiced" "$beats" && hit="GUITAR"
  printf '%s %s tone=%s rich=%s rms=%s beats=%s chent=%s voiced=%s %s\n' \
    "$(ts_utc)" "$(basename "$f")" "$tone" "$rich" "$rms" "$beats" "$chent" "$voiced" "$hit" >> "$SCORE_LOG"
  echo "$(basename "$f")" >> "$SEEN_LOG"
  if [ "$hit" = GUITAR ] && awk -v a="$chent" -v b="$best_chent" 'BEGIN{exit !(a+0<b+0)}'; then
    best="$f"; best_chent="$chent"; best_axes="$axes"
  fi
done

# advance watermark past everything examined -> one delivery per session
echo "$maxmtime" > "$WATERMARK"
mesh-state-touch "$STATE" 2>/dev/null || touch "$STATE"

if [ -z "$best" ]; then
  echo "no guitar in ${#NEW[@]} new capture(s) (gate: chent<=$GW_CHENT voiced>=$GW_VOICED beats>=$GW_BEATS)"
  exit 0
fi

read -r btone brich brms bbeats bchent bvoiced <<<"$best_axes"
if ! load_creds; then
  # a guitar hit but no creds: DON'T mark it shipped, DON'T let the watermark swallow it -> re-catch next run
  echo "$WM" > "$WATERMARK"
  # un-see the winner so a creds-present run re-processes it
  grep -vF -- "$(basename "$best")" "$SEEN_LOG" > "$SEEN_LOG.tmp" 2>/dev/null && mv "$SEEN_LOG.tmp" "$SEEN_LOG"
  echo "n/a: guitar found ($(basename "$best")) but TG creds absent — deferred"; exit 2
fi

log "GUITAR detected: $(basename "$best") chent=$bchent voiced=$bvoiced beats=$bbeats (ctx tone=$btone rich=$brich rms=$brms)"
deliver_session "$best" "$btone" "$brich" "$brms" "$bbeats"
echo "delivered guitar session from $(basename "$best") (rms=$brms)"
