#!/usr/bin/env bash
# mesh-pane-reload — make data panes BREATHE: when a dash tool is redeployed, the LIVE data pane
#   keeps running the OLD code until someone manually `respawn-pane`s it. That lag is the "hitch"
#   the operator flagged (2026-07-06): a fix lands in the file but the screen shows it late / only
#   after a hand respawn. This reflex closes it — deploy → pane self-reloads, no hands.
#
# Mechanism: every data pane (index .0) runs `mesh-dash <role>` (verified: pub too — mesh-pub-dash
# is a helper CALLED by mesh-dash). Track the max mtime over mesh-dash + its `*-dash` helpers; when
# it advances past the last stamp, `respawn-pane -k` every .0 pane whose start-command runs mesh-dash.
#
# SAFETY (10 live minds share this session): NEVER touches a mind pane. A pane is respawned ONLY if
# BOTH (a) pane_index == 0 AND (b) its start_command contains 'mesh-dash'. respawn-pane with no
# command re-runs the pane's own start command (the render loop) — the .1 mind pane is never read.
#
#   mesh-pane-reload            one pass (cron-wired)
#   mesh-pane-reload --dry-run  show what WOULD respawn, change nothing
#   mesh-pane-reload --test     smoke test (no tmux side effects)
#
# reflex-cadence: * * * * *
# doctor-artifact: .pane-reload.stamp 900 local
# Exit: 0 = ok (checked; maybe respawned); 2 = n/a (no tmux / no session).
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME

STAMP="$HOME/.mesh/.pane-reload.stamp"
BIN="$HOME/.local/bin"

# max mtime (epoch) across the dash dispatcher + every *-dash helper it may source
dash_sig() {
  local mx=0 f m
  for f in "$BIN/mesh-dash" "$BIN"/mesh-*-dash "$BIN"/mesh-*dash; do
    [ -f "$f" ] || continue
    m=$(stat -c %Y "$f" 2>/dev/null || echo 0)
    [ "$m" -gt "$mx" ] && mx=$m
  done
  echo "$mx"
}

if [ "${1:-}" = "--test" ]; then
  sig=$(dash_sig)
  [ "$sig" -gt 0 ] 2>/dev/null || { echo "smoke-test: FAIL (no dash sig — mesh-dash missing?)"; exit 1; }
  # dry-run must never call respawn: assert it only prints, exits clean, even with tmux absent
  out="$(MESH_PANE_RELOAD_NOTMUX=1 "$0" --dry-run 2>&1)"; rc=$?
  [ "$rc" = 0 ] || { echo "smoke-test: FAIL (dry-run rc=$rc: $out)"; exit 1; }
  echo "smoke-test: ok (dash sig=$sig; dry-run clean)"
  exit 0
fi

DRY=0; [ "${1:-}" = "--dry-run" ] && DRY=1

command -v tmux >/dev/null 2>&1 || { echo "mesh-pane-reload: no tmux (n/a)" >&2; exit 2; }
[ "${MESH_PANE_RELOAD_NOTMUX:-0}" = 1 ] && { [ "$DRY" = 1 ] && exit 0 || exit 2; }
SESS="$(hostname)"
tmux has-session -t "$SESS" 2>/dev/null || { echo "mesh-pane-reload: no session $SESS (n/a)" >&2; exit 2; }

sig=$(dash_sig)
last=$(cat "$STAMP" 2>/dev/null || echo 0)
# first-ever run: baseline the stamp, respawn nothing (the panes already run current code post-restore)
if [ ! -f "$STAMP" ]; then
  [ "$DRY" = 1 ] && { echo "(dry-run: no stamp yet — would baseline sig=$sig, respawn nothing)"; exit 0; }
  echo "$sig" > "$STAMP"; echo "mesh-pane-reload: baselined sig=$sig" >&2; exit 0
fi
[ "$sig" -le "$last" ] 2>/dev/null && { touch "$STAMP"; exit 0; }   # unchanged — mtime=liveness, no respawn

# a dash tool advanced → reload the data panes running mesh-dash (index .0 ONLY; mind panes untouched)
n=0
while IFS='|' read -r pid idx cmd; do
  [ "$idx" = 0 ] || continue                       # HARD guard: never a .1 mind pane
  case "$cmd" in *mesh-dash*) ;; *) continue;; esac # only render-loop panes
  if [ "$DRY" = 1 ]; then echo "would respawn: $pid ($cmd)"; else tmux respawn-pane -k -t "$pid" 2>/dev/null; fi
  n=$((n+1))
done < <(tmux list-panes -s -t "$SESS" -F '#{pane_id}|#{pane_index}|#{pane_start_command}' 2>/dev/null)

if [ "$DRY" = 1 ]; then echo "(dry-run: $n pane(s) would reload; stamp unchanged)"; exit 0; fi
echo "$sig" > "$STAMP"
echo "mesh-pane-reload: dash changed → respawned $n data pane(s)" >&2
exit 0
