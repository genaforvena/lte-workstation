#!/usr/bin/env bash
# mesh-interpret — the "главный закон" (main law): an INTERPRETATION layer that sits ON TOP of
# deterministic detectors. Borrowing #3 from the operator's work mesh (guy-fawxible / Foxible),
# re-derived as OUR tool over OUR primitives (mesh-chat board + traces + git + mesh-relay +
# mesh-claim) — never their repo/instance.
#
# THE LAW: a mind must NOT freelance-detect anomalies/thresholds — that is our documented
# hallucination / false-alarm / churn failure mode:
#   - chat-mind-dont-over-escalate   (escalation outran verification)
#   - corroborate-before-global-alarm (a 1-pane transient asserted as global ground-truth)
#   - complaint-can-predate-fix      ("still broken" off a complaint a fix already resolved)
#   - verify-state-before-executing-handoffs (acted on a premise that had already moved)
# All four are ONE failure: a mind acting as detector+decider with NO deterministic anchor.
#
# THE EMBODIMENT (structural, not advisory): the LLM may only ENTER here AFTER a deterministic
# detector has fired. mesh-interpret is the ONLY sanctioned observation→[task] path, and it
# STRUCTURALLY REFUSES to run without a live fired-detector signal:
#
#   mesh-interpret --signal <source>:<locator>
#
#       source ∈ {board, trace}            (CORE; doctor/card/health live-probe = inc2)
#       <locator>  = the artifact the detector named (a key / pattern / marker text)
#
#   signal_live() re-checks the source NOW. A board signal MUST be a DETECTOR marker
#   ([stale]/[verify]/[drift]/[exception]/[fail]/[red]/[alert]) — a mind's own
#   [fyi]/[idle]/[task]/[design] CANNOT be laundered into a signal. No live detector → exit 3,
#   "freelance detection is forbidden". The gate IS the law: the only door to file-a-task needs a
#   detector key, so a mind physically cannot enter on "I noticed X".
#
# On a real signal it runs the four memories as structural correlation gates, then asks mesh-relay
# to INTERPRET (it never detects), and files AT MOST ONE [task]:
#   (a) live-NOW recheck     = signal_live itself (not a stale 1-pane transient)   [corroborate]
#   (b) git fix postdates?    → STALE + cite commit   (bundle always carries git log) [predates-fix]
#   (c) dedup vs open work    → DUPLICATE (REUSE mesh-claim --check + open-[task] grep) [verify-handoff]
#   (d) source hedged by-design/intentional? → BENIGN (bundle carries the source line) [over-escalate]
#
#   verdict ∈ { ACTIONABLE → file ≤1 [task] (signal cited) | BENIGN | STALE | DUPLICATE |
#               UNKNOWN (relay/context unreachable — honest-empty: VISIBLE to caller, NEVER a faked
#               all-clear, NEVER a task) }.  Ambiguity fails SAFE → UNKNOWN, never a spurious task.
#
# Verbs:
#   mesh-interpret --signal <source>:<locator>   interpret a fired detector signal → ≤1 [task]
#   mesh-interpret --status                       config + reachable detector sources / relay
#   mesh-interpret --gate-live                    drive the REAL relay through the production prompt,
#                                                 both arms (absurd must not file / defect must file);
#                                                 the DECISION half --test cannot see. Run on prompt
#                                                 edits; NOT in --test (2N relay calls, network).
#   mesh-interpret --test                         smoke (pure: valid_signal/parse_signal/
#                                                 is_detector_marker/classify_verdict)
#
# inc1 CORE = the structural gate + interpret + ≤1-task + honest-UNKNOWN + --test/smoke.
# DEFER inc2: which detectors AUTO-feed it (doctor/card/health live-probe + wiring/cadence).
#
# reflex-cadence: none
# orphan-ok: on-demand interpret verb — runs when a deterministic detector fires (doctor/card/health
#            marker), NOT cron-wired by design; the detector→auto-feed wiring is inc2. (reflex-cadence:none
#            alone does NOT exempt from mesh-doctor's orphan check — only orphan-ok: does, by deliberate
#            design: the explicit reason keeps the WARN meaning 'built to be wired but isn't'.)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"   # cron self-defense: calls siblings (mesh-relay/mesh-claim/mesh-chat) by bare name; cron's minimal PATH lacks ~/.local/bin (same class as the mesh-claim --sweep doctor FAIL)

BOARD="${MESH_CHAT_LOG:-$HOME/.mesh/chat.log}"
TRACE="${MESH_TRACE_LOG:-$HOME/.mesh/traces.log}"
REPO="${MESH_REPO:-$HOME/lte-workstation}"
WHO="${MESH_WHO:-${USER:-?}@$(hostname)}"
HOST="$(hostname)"
SEP=" :: "
# detector markers = those de-facto emitted by deterministic reflexes on our board, NOT a mind's
# discretionary markers. DELIBERATELY EXCLUDES [verify] (minds post it constantly) and [exception]
# (the corroborate-before-global-alarm incident was a MIND posting [exception] as a false alarm — the
# exact accidental-freelance hole this law closes). NOTE: the bus can't restrict who TYPES a marker, so
# the airtight anchor is the detector WHO-IDENTITY (claim-sweep@/sync-tools@/health-reflex@…) not the
# marker name — that hardening is inc2; CORE's marker-set gate already blocks the common launder
# ([fyi]/[idle]/[task]/[design], proven in --test).
DETECTOR_MARKERS='stale|drift|fail|red|alert'

# --- pure: a signal ref is "<source>:<locator>"; source from the allowed set, locator non-empty ----
valid_signal() {  # <ref> -> 0 valid / 1 invalid
  local ref="${1:-}" src loc
  [ -n "$ref" ] || return 1
  case "$ref" in *:*) ;; *) return 1 ;; esac
  src="${ref%%:*}"; loc="${ref#*:}"
  [ -n "$loc" ] || return 1
  case "$src" in board|trace|doctor|card|health) return 0 ;; *) return 1 ;; esac
}

# --- pure: split a signal ref into "source locator" (locator may itself contain ':') ----------------
parse_signal() {  # <ref> -> echoes "source locator"
  local ref="${1:-}"; echo "${ref%%:*} ${ref#*:}"
}

# --- pure: is a board message BODY a DETECTOR marker? (the anti-launder gate — a mind's own
#     [fyi]/[idle]/[task] is NOT a detector and cannot be cited as a signal) -------------------------
is_detector_marker() {  # <msg-body> -> 0 yes / 1 no
  local msg="${1:-}"
  [[ "$msg" =~ ^\[($DETECTOR_MARKERS)\][[:space:]] ]] && return 0 || return 1
}

# --- pure: the ONE interpretation prompt — --signal and --gate-live both build it HERE, so the gate
# can never assert a prompt nothing runs (the study-bridge --gate-live rule: same prompt, same parser
# as production, or the gate is decorative). $1=<source>:<locator>  $2=evidence bundle.
interpret_prompt() {
  printf 'A deterministic detector fired this signal: %s

You are the INTERPRETATION layer (главный закон). You did NOT detect this — a detector did. Your job
is to decide what it MEANS, using the evidence below, then reply with EXACTLY ONE verdict token on
the FIRST line, then ONE line of reason (if ACTIONABLE, a crisp <=12-word task title):
  ACTIONABLE  a real, still-live, not-yet-tracked defect worth ONE task
  BENIGN      by-design / intentional / a hedged '\''not a bug'\'' / known-noise
  STALE       a fix already POSTDATES this signal (name the commit hash)
  DUPLICATE   already tracked by an open [task]/[claim]
  UNKNOWN     you cannot determine it from this evidence
Prefer UNKNOWN over guessing. Do NOT invent issues the evidence does not show.

EVIDENCE:
%s' "$1" "$2"
}

# --- pure: extract the single verdict token from relay text; ambiguity/none → UNKNOWN (fail-safe) ---
classify_verdict() {  # <relay-text> -> ACTIONABLE|BENIGN|STALE|DUPLICATE|UNKNOWN
  local t
  t="$(printf '%s\n' "${1:-}" | grep -oiE '\b(ACTIONABLE|BENIGN|STALE|DUPLICATE|UNKNOWN)\b' \
        | head -1 | tr '[:lower:]' '[:upper:]')"
  [ -n "$t" ] || t="UNKNOWN"
  echo "$t"
}

# --- impure: is there a LIVE detector signal for <source>:<locator> RIGHT NOW? (the structural gate)
signal_live() {  # <source> <locator> -> 0 present / 1 absent
  local src="$1" loc="$2"
  case "$src" in
    board)
      awk -v loc="$loc" -v mk="$DETECTOR_MARKERS" '
        { i=index($0," :: "); if(i==0)next; msg=substr($0,i+4); sub(/^[ \t]+/,"",msg)
          if (msg ~ ("^\\[(" mk ")\\] ") && index(msg, loc)>0) { found=1 } }
        END{ exit found?0:1 }' "$BOARD" 2>/dev/null ;;
    trace)
      grep -Fq "$loc" "$TRACE" 2>/dev/null ;;
    doctor|card|health)
      # inc2: live-probe of heavy/side-effecting detectors (doctor ~71s, card --refresh WRITES the
      # card). CORE supports the two TEXT detector channels; the rest land their signals on the board
      # anyway — cite them as board:<marker>. Refuse cleanly rather than fake a probe.
      echo "mesh-interpret: source '$src' live-probe is deferred to inc2 — cite its board signal instead (board:<marker>)" >&2
      return 1 ;;
    *) return 1 ;;
  esac
}

# --- impure: the matched detector line (for the bundle + the BENIGN/by-design gate evidence) --------
signal_line() {  # <source> <locator> -> echoes the most recent matching detector line
  local src="$1" loc="$2"
  case "$src" in
    board) awk -v loc="$loc" -v mk="$DETECTOR_MARKERS" '
             { i=index($0," :: "); if(i==0)next; msg=substr($0,i+4); sub(/^[ \t]+/,"",msg)
               if (msg ~ ("^\\[(" mk ")\\] ") && index(msg, loc)>0) last=$0 }
             END{ if(last!="") print last }' "$BOARD" 2>/dev/null ;;
    trace) grep -F "$loc" "$TRACE" 2>/dev/null | tail -1 ;;
  esac
}

# --- impure: assemble the correlation bundle (board + git + trace around the artifact) --------------
correlate() {  # <locator> -> prints the evidence bundle
  local loc="$1"
  echo "-- detector signal line --"; signal_line "$SRC" "$loc"
  echo "-- recent board mentions --"; grep -F "$loc" "$BOARD" 2>/dev/null | tail -12
  echo "-- git history (recent + key-referencing; for the predates-fix / by-design gates) --"
  git -C "$REPO" log --format='%cI %h %s' -10 2>/dev/null
  git -C "$REPO" log --format='%cI %h %s' -6 -i --grep="$loc" 2>/dev/null
  git -C "$REPO" log --format='%cI %h %s' -6 -S"$loc" 2>/dev/null
  echo "-- recent trace mentions --"; grep -F "$loc" "$TRACE" 2>/dev/null | tail -8
}

# --- pure-ish: slug an artifact key from the locator for dedup/task ---------------------------------
slug_key() {  # <locator> -> a valid claim-style key
  printf '%s' "${1:-}" | tr ' ' '-' | tr -cd 'A-Za-z0-9._:/#-' | cut -c1-110
}

# --- impure: is this artifact ALREADY tracked? (gate c — reuse mesh-claim + open-[task] grep) -------
already_tracked() {  # <key> -> 0 tracked (dup) / 1 free
  local key="$1"
  if command -v mesh-claim >/dev/null 2>&1; then
    mesh-claim --check "$key" >/dev/null 2>&1; local rc=$?
    [ "$rc" = 1 ] || [ "$rc" = 2 ] && return 0   # 1 yours / 2 theirs(live) → already claimed
  fi
  # an open [task] for this key with no later [done] mentioning it
  awk -v key="$key" '
    { i=index($0," :: "); if(i==0)next; msg=substr($0,i+4); sub(/^[ \t]+/,"",msg)
      if (msg ~ /^\[task\] / && index(msg,key)>0) opened=1
      if (msg ~ /^\[done\] / && index(msg,key)>0) opened=0 }
    END{ exit opened?0:1 }' "$BOARD" 2>/dev/null && return 0
  return 1
}

_post() { mesh-chat "$1" >/dev/null; }

case "${1:-}" in
  --test)
    f=""
    valid_signal "board:[stale] foo"        || f="$f sig-board"
    valid_signal "trace:ds-freeze"          || f="$f sig-trace"
    valid_signal "board:alert:ds-2026"      || f="$f sig-colon-loc"   # locator may contain ':'
    ! valid_signal ""                       || f="$f sig-empty"
    ! valid_signal "board:"                 || f="$f sig-noloc"
    ! valid_signal "noscheme"               || f="$f sig-noscheme"
    ! valid_signal "fyi:something"          || f="$f sig-badsource"
    [ "$(parse_signal 'board:alert:x')"     = "board alert:x" ] || f="$f parse-sig"
    # is_detector_marker: only reflex-emitted detector markers qualify; a mind's own markers do NOT
    is_detector_marker "[stale] foo bar"    || f="$f det-stale"
    is_detector_marker "[drift] x"          || f="$f det-drift"
    is_detector_marker "[red] y"            || f="$f det-red"
    ! is_detector_marker "[fyi] noticed x"  || f="$f det-fyi"        # the anti-launder case
    ! is_detector_marker "[task] do x"      || f="$f det-task"
    ! is_detector_marker "[idle] nothing"   || f="$f det-idle"
    ! is_detector_marker "[verify] i checked x" || f="$f det-verify" # minds post [verify] → NOT citable in CORE
    ! is_detector_marker "[exception] alarm"    || f="$f det-exc"    # the corroborate-incident hole, closed
    # classify_verdict: token extraction + fail-safe UNKNOWN
    [ "$(classify_verdict 'ACTIONABLE — real defect')" = "ACTIONABLE" ] || f="$f cv-act"
    [ "$(classify_verdict 'verdict: benign, by-design')" = "BENIGN" ]    || f="$f cv-ben"
    [ "$(classify_verdict 'STALE: fixed in abc123')"    = "STALE" ]      || f="$f cv-stale"
    [ "$(classify_verdict 'duplicate of open task')"    = "DUPLICATE" ]  || f="$f cv-dup"
    [ "$(classify_verdict 'I am not sure what this is')" = "UNKNOWN" ]   || f="$f cv-amb"  # fail-safe
    [ "$(classify_verdict '')"                          = "UNKNOWN" ]   || f="$f cv-empty"
    [ "$(slug_key 'alert ds freeze')"        = "alert-ds-freeze" ]       || f="$f slug"
    # interpret_prompt is the ONE prompt definition --signal and --gate-live share: it must carry the
    # full 5-token rubric and the caller's evidence verbatim (a drifted/emptied builder would make the
    # live gate assert a prompt production no longer runs).
    _ip="$(interpret_prompt 'board:canary-ref' 'EVBUNDLE-CANARY-LINE')"
    for tok in ACTIONABLE BENIGN STALE DUPLICATE UNKNOWN 'board:canary-ref' 'EVBUNDLE-CANARY-LINE'; do
      printf '%s' "$_ip" | grep -qF "$tok" || f="$f prompt-missing-$tok"
    done
    if [ -n "$f" ]; then echo "smoke-test: FAIL ($f )"; exit 1; fi
    echo "smoke-test: ok (valid_signal, parse_signal, is_detector_marker anti-launder, classify_verdict fail-safe, slug_key, interpret_prompt shared-builder rubric+evidence). DECISION half = --gate-live"; exit 0 ;;

  --status)
    echo "mesh-interpret — главный закон (interpretation ON TOP of detectors)"
    echo "  law: no [task] without a live fired-detector signal (--signal <source>:<locator>)"
    echo "  CORE sources: board (markers: $DETECTOR_MARKERS) · trace   [doctor/card/health = inc2]"
    echo "  board: $BOARD"
    if command -v mesh-relay >/dev/null 2>&1; then
      echo "  relay: $(timeout 6 mesh-relay --status 2>/dev/null | tr '\n' ' ' | sed 's/  */ /g')"
    else
      echo "  relay: mesh-relay ABSENT → verdicts UNKNOWN (honest)"
    fi
    echo "  dedup: $(command -v mesh-claim >/dev/null 2>&1 && echo 'mesh-claim --check + open-[task] grep' || echo 'open-[task] grep only (mesh-claim absent)')"
    exit 0 ;;

  --signal)
    ref="${2:-}"
    valid_signal "$ref" || { echo "mesh-interpret: invalid signal ref '$ref' (want <source>:<locator>, source∈board|trace|doctor|card|health)" >&2; exit 64; }
    read -r SRC LOC <<<"$(parse_signal "$ref")"
    # ── THE GATE (главный закон): no live detector → no entry ──────────────────────────────────────
    if ! signal_live "$SRC" "$LOC"; then
      echo "mesh-interpret: NO live detector signal for '$ref' — freelance detection is forbidden." >&2
      echo "  (a deterministic detector firing is the REQUIRED entry precondition; the mind interprets, it does not detect)" >&2
      exit 3
    fi
    # ── correlate → interpret (relay never DETECTS, only interprets) ────────────────────────────────
    bundle="$(correlate "$LOC")"
    prompt="$(interpret_prompt "${SRC}:${LOC}" "$bundle")"
    relay="$(printf '%s' "$prompt" | timeout 60 mesh-relay 2>/dev/null)"
    if [ -z "${relay//[[:space:]]/}" ]; then
      echo "UNKNOWN — relay unreachable / empty; cannot interpret '$ref'. (honest-empty: no task filed, no faked all-clear)"
      exit 5
    fi
    verdict="$(classify_verdict "$relay")"
    reason="$(printf '%s\n' "$relay" | grep -viE '^\s*(ACTIONABLE|BENIGN|STALE|DUPLICATE|UNKNOWN)\s*$' | grep -v '^\s*$' | head -2 | tr '\n' ' ' | sed 's/  */ /g')"
    case "$verdict" in
      ACTIONABLE)
        key="interpret:$(slug_key "$LOC")"
        if already_tracked "$key" || already_tracked "$(slug_key "$LOC")"; then
          echo "DUPLICATE — '$LOC' already tracked (open [task]/[claim]); no duplicate filed. ($reason)"
          exit 0
        fi
        _post "[task] $key — ${reason:-detector-anchored finding} (mesh-interpret: signal=${SRC}:${LOC}, detector-anchored)"
        echo "ACTIONABLE — filed ONE [task] for $key (signal=${SRC}:${LOC}). $reason"
        exit 0 ;;
      BENIGN)    echo "BENIGN — no task. $reason"; exit 0 ;;
      STALE)     echo "STALE — no task (a fix postdates the signal). $reason"; exit 0 ;;
      DUPLICATE) echo "DUPLICATE — no task (already tracked). $reason"; exit 0 ;;
      *)         echo "UNKNOWN — cannot interpret '$ref' from the evidence; no task filed (honest-empty). $reason"; exit 5 ;;
    esac ;;

  --gate-live)
    # THE DECISION HALF --test CANNOT SEE (absurd-input-control, the study-bridge --gate-live pattern,
    # 942137e): --test asserts classify_verdict PARSES; it cannot assert the live model ever answers
    # anything but ACTIONABLE — and ACTIONABLE is the verdict that MINTS BOARD WORK, so a model (or a
    # prompt edit) that files on everything turns every detector blip into a dispatched task. Drive the
    # REAL relay through the SAME interpret_prompt + classify_verdict as production, both arms:
    #   ABSURD arm      evidence with NO defect in it (an honest 'expected — not a fault' probe note +
    #                    unrelated git log) must NOT read ACTIONABLE — the control against invented issues
    #                    ('Do NOT invent issues the evidence does not show' is load-bearing, this measures it).
    #   ACTIONABLE arm  a crisp live defect (state artifact 9d stale under a green --test, no fix in log,
    #                    no open task) must read ACTIONABLE — without this arm a prompt that always says
    #                    UNKNOWN scores perfectly above; both arms or neither.
    # Floors are REGRESSION detectors, not quality bars (a-stochastic-gates-threshold-is-a-statistic).
    # MEASURED AT SHIP (2026-07-17, mesh-relay/groq, this prompt): ABSURD 12/12 non-ACTIONABLE across
    # two runs — the invent-issues lane is healthy. ACTIONABLE **0/6** (and 1/6 under a trap-naming
    # prompt variant, reverted as unproven; 1/9 raw across two distinct defect-fixture shapes) — THE
    # GATE SHIPS FAILING ITS ACTIONABLE ARM, deliberately: the production prompt under-files real
    # defects, rationalizing them away ('cron is green so the stale artifact is expected'; an
    # 'unrelated' commit cited as STALE evidence). That is a real, open prompt defect
    # (chat-review/interpret-actionable-lane-underfiles), not a mis-calibrated floor — do NOT lower
    # the floor to green the gate. When the prompt is fixed, RE-MEASURE (n>=12, stamp n+pool+date)
    # and update this block; until then a FAIL here on an unchanged prompt is the KNOWN baseline.
    # NOT in --test on purpose: mesh-autowire gates --test under `timeout 30`; 2N relay calls blow it,
    # and a network-dependent gate on the landing path gets routed around. Run by hand on prompt edits.
    # Exit 2 = honest n/a (relay unreachable) — never a fake green.
    command -v mesh-relay >/dev/null 2>&1 || { echo "gate-live: n/a (mesh-relay absent)"; exit 2; }
    probe="$(printf 'Reply with the single word: ping' | timeout 30 mesh-relay 2>/dev/null)"
    [ -n "${probe//[[:space:]]/}" ] || { echo "gate-live: n/a (relay returned nothing — no pool reachable)"; exit 2; }
    N="${MESH_INTERPRET_GATE_N:-6}"
    gate_absurd="SIGNAL LINE (board):
2026-07-17T02:11:04Z  access-probe@host  ::  [note] access change: phone: BLIND — phone unreachable/asleep (expected — not a fault) states: ts=OK anthropic=OK phone=BLIND
RECENT GIT LOG (staleness check):
  9aa11bb fix(unrelated): tidy a ps column render
  8bb22cc docs: update coordination notes
OPEN TASKS (dedup): none matching
LIVE-NOW RECHECK: the probe re-ran clean this pass; phone woke and answered."
    gate_action="SIGNAL LINE (board):
2026-07-17T01:00:00Z  doctor@host  ::  [doctor-warn] mesh-foo: cron entry live (*/15) but ~/.mesh/.foo-state mtime is 9 DAYS old — tool --test green, cron log shows the job running every 15min with rc=0
RECENT GIT LOG (staleness check):
  9aa11bb fix(unrelated): tidy a ps column render
  8bb22cc docs: update coordination notes
OPEN TASKS (dedup): none matching
LIVE-NOW RECHECK: signal still present — .foo-state mtime unchanged, cron still green."
    echo "=== mesh-interpret --gate-live ($(date -u +%FT%TZ), n=$N per arm, relay=mesh-relay) ==="
    grc=0
    for arm in "ABSURD:no:board:gatefx-benign-note" "ACTIONABLE:yes:board:gatefx-stale-state"; do
      label="${arm%%:*}"; rest="${arm#*:}"; wantact="${rest%%:*}"; ref="${rest#*:}"
      case "$label" in ABSURD) bundle="$gate_absurd";; *) bundle="$gate_action";; esac
      floor=$(( N/2 + 1 )); hits=0
      for i in $(seq 1 "$N"); do
        v="$(classify_verdict "$(interpret_prompt "$ref" "$bundle" | timeout 60 mesh-relay 2>/dev/null)")"
        if [ "$wantact" = yes ]; then [ "$v" = ACTIONABLE ] && hits=$((hits+1))
        else [ "$v" != ACTIONABLE ] && [ -n "$v" ] && hits=$((hits+1)); fi
        printf '  %-10s arm  run %d/%s  verdict=%-10s want=%s\n' "$label" "$i" "$N" "${v:-<none>}" \
          "$([ "$wantact" = yes ] && echo ACTIONABLE || echo not-ACTIONABLE)"
      done
      if [ "$hits" -ge "$floor" ]; then echo "  -> $label arm: PASS ($hits/$N — floor $floor/$N)"
      else echo "  -> $label arm: FAIL ($hits/$N — floor $floor/$N not met)"; grc=1; fi
    done
    [ "$grc" = 0 ] && echo "gate-live: ok (does not invent issues on defect-free evidence AND still files on a real defect — floors are regression detectors, not rates)" \
                   || echo "gate-live: FAIL — do not ship this prompt; a one-armed pass is not a pass"
    exit "$grc" ;;

  ""|-h|--help)
    sed -n '2,60p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;

  *)
    echo "mesh-interpret: unknown verb '$1' — use --signal <source>:<locator> | --status | --test | --help" >&2
    exit 64 ;;
esac
