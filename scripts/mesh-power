#!/usr/bin/env bash
# mesh-power — this node's POWER sense (a resilience organ). Tells the mesh whether a node is on
# stable wall power (a reliable anchor for steward/egress roles) or running on battery (will die on a
# cut — a failure-risk the mesh should plan around). Sudo-free, sysfs-only; works on laptops/UPS.
#
#   mesh-power            one line: power state (AC|BATTERY), capacity, status
#   mesh-power --json     machine-readable
#   mesh-power --check    exit 0 if power is SAFE; exit 1 + reason if at-risk (on battery, discharging, low)
#   mesh-power --test     smoke test (fixture-backed dry-run + dep gate)
#
# At-risk = on battery AND discharging AND capacity below MESH_POWER_LOW (default 30). A node going
# at-risk is real news (it may vanish): --check is meant to be run as a reflex that alerts the board.
set -uo pipefail
PS="${MESH_POWER_SUPPLY_DIR:-/sys/class/power_supply}"
LOW="${MESH_POWER_LOW:-30}"

on_ac(){ for a in "$PS"/A{C,DP}* "$PS"/USB* ; do [ -r "$a/online" ] && [ "$(cat "$a/online" 2>/dev/null)" = 1 ] && return 0; done; return 1; }
bat_dir(){ for b in "$PS"/BAT*; do [ -d "$b" ] && { echo "$b"; return; }; done; }

if [ "${1:-}" = --test ]; then
  command -v cat  >/dev/null 2>&1 || { echo "smoke-test: FAIL (no cat)"; exit 1; }
  command -v tr   >/dev/null 2>&1 || { echo "smoke-test: FAIL (no tr)"; exit 1; }
  command -v grep >/dev/null 2>&1 || { echo "smoke-test: FAIL (no grep)"; exit 1; }
  tmp="$(mktemp -d)"
  trap 'rm -rf "$tmp"' EXIT

  mkdir -p "$tmp/safe/AC0" "$tmp/safe/BAT0" "$tmp/risk/BAT0"
  printf '1\n' > "$tmp/safe/AC0/online"
  printf '95\n' > "$tmp/safe/BAT0/capacity"
  printf 'Charging\n' > "$tmp/safe/BAT0/status"
  printf '12\n' > "$tmp/risk/BAT0/capacity"
  printf 'Discharging\n' > "$tmp/risk/BAT0/status"

  safe_json="$(MESH_POWER_SUPPLY_DIR="$tmp/safe" "$0" --json 2>&1)" || {
    echo "smoke-test: FAIL (safe json probe failed: $safe_json)"; exit 1;
  }
  printf '%s\n' "$safe_json" | grep -q '"source":"AC"' || {
    echo "smoke-test: FAIL (safe json missing AC source: $safe_json)"; exit 1;
  }
  printf '%s\n' "$safe_json" | grep -q '"risk":false' || {
    echo "smoke-test: FAIL (safe json expected risk=false: $safe_json)"; exit 1;
  }

  risk_json="$(MESH_POWER_SUPPLY_DIR="$tmp/risk" "$0" --json 2>&1)" || {
    echo "smoke-test: FAIL (risk json probe failed: $risk_json)"; exit 1;
  }
  printf '%s\n' "$risk_json" | grep -q '"source":"BATTERY"' || {
    echo "smoke-test: FAIL (risk json missing BATTERY source: $risk_json)"; exit 1;
  }
  printf '%s\n' "$risk_json" | grep -q '"risk":true' || {
    echo "smoke-test: FAIL (risk json expected risk=true: $risk_json)"; exit 1;
  }

  safe_out="$(MESH_POWER_SUPPLY_DIR="$tmp/safe" "$0" --check 2>&1)"; safe_rc=$?
  [ "$safe_rc" -eq 0 ] || { echo "smoke-test: FAIL (safe --check rc=$safe_rc: $safe_out)"; exit 1; }
  printf '%s\n' "$safe_out" | grep -qE '^power safe: AC 95% Charging$' || {
    echo "smoke-test: FAIL (safe --check unexpected output: $safe_out)"; exit 1;
  }

  risk_out="$(MESH_POWER_SUPPLY_DIR="$tmp/risk" "$0" --check 2>&1)"; risk_rc=$?
  [ "$risk_rc" -eq 1 ] || { echo "smoke-test: FAIL (risk --check rc=$risk_rc: $risk_out)"; exit 1; }
  printf '%s\n' "$risk_out" | grep -qE '^power AT-RISK: on battery, discharging, 12% < 30% — node may vanish$' || {
    echo "smoke-test: FAIL (risk --check unexpected output: $risk_out)"; exit 1;
  }

  echo "smoke-test: ok (fixture-backed dry-run: safe AC fixture PASS, low-battery fixture FAILS as expected)"
  exit 0
fi

b="$(bat_dir)"
cap="$( [ -n "$b" ] && cat "$b/capacity" 2>/dev/null || echo '' )"
status="$( [ -n "$b" ] && cat "$b/status" 2>/dev/null | tr ' ' '-' || echo 'unknown' )"
if on_ac; then src="AC"; else src="BATTERY"; fi
# no battery at all (desktop/server/router) → mains-only, always reliable
[ -z "$b" ] && { src="MAINS"; status="no-battery"; cap=""; }

risk=""; reason="safe"
if [ "$src" = BATTERY ] && printf '%s' "$status" | grep -qi 'discharg' && [ -n "$cap" ] && [ "$cap" -lt "$LOW" ] 2>/dev/null; then
  risk="RISK"; reason="on battery, discharging, ${cap}% < ${LOW}% — node may vanish"
fi

case "${1:-}" in
  --json) printf '{"source":"%s","capacity":"%s","status":"%s","risk":%s,"reason":"%s"}\n' \
            "$src" "$cap" "$status" "$([ -n "$risk" ] && echo true || echo false)" "$reason" ;;
  --check)
    if [ -n "$risk" ]; then echo "power AT-RISK: $reason"; exit 1; fi
    echo "power safe: $src${cap:+ ${cap}%} $status"; exit 0 ;;
  *) echo "power: $src${cap:+ capacity=${cap}%} status=${status}${risk:+ $risk}" ;;
esac
