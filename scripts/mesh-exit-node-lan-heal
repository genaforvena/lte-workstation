#!/usr/bin/env bash
# reflex-cadence: * * * * *
# reflex-state: $HOME/.mesh/.exit-node-lan-heal.state
# (Declared so mesh-reflex-health DERIVES us into its watch table instead of anyone having to
#  hand-add a row. This healer is the only re-applier of the throw route — a dead healer and a
#  healthy LAN look identical from outside, and the fallback re-applier is the operator's hands,
#  which IS the incident. The state is touch_state()-ed on EVERY successful eval (ok/swallowed/
#  stood-down/applied alike), so mtime is ran-live, not value-changed, and @auto resolves the
#  max_age from our own live cron stride.)
# mesh-exit-node-lan-heal — re-install the ONE FIB line an exit node keeps eating.
#
# WHY THIS EXISTS. When this node consumes a tailscale exit node, tailscaled's own routing table
# (52 here) carries a default plus the peer /32s and NOTHING for the local LAN — so
# `ip route get 192.168.8.1` answers `dev tailscale0 table 52` and every inward LAN path dies while
# every OUTWARD probe stays perfect. `ExitNodeAllowLANAccess: true` does not prevent it: measured
# true on mesh-home 2026-08-21T10:50Z DURING the fault, with tailscaled NRestarts=0. The pref and
# its implementation simply diverged, which is why `mesh-card`'s probe reads the FIB and never the
# pref, and why this tool installs a real route rather than re-asserting a preference.
#
# WHAT WAS MISSING. Detection already exists end to end: `mesh-card --refresh` measures the FIB,
# folds a SWALLOWED verdict into `invariant-check`, and `mesh-card-watchdog` alarms on it. Nothing
# RE-APPLIED. On 2026-08-21 the same one-line fix was installed by a mind's hand three times —
# 13:01:47Z, wiped by the 16:25-16:34Z link flap, 17:52Z — and CLAUDE.local.md already records that
# the operator's hands being the rollback path IS the incident. Detection closes the loop only if a
# hand is watching the board.
#
# WHY THE TRIGGER IS NOT RARE. tailscaled OWNS table 52 and rebuilds it on a netmap reconverge; a
# reconverge follows any link flap, with NO daemon restart, no re-`up` and no exit-node change
# (measured 2026-08-21T16:41Z: the throw was gone while NRestarts=0 and uptime 31h). This node's
# sole uplink is the wedging RTL8822BU dongle, so the wipe rate IS the dongle fault rate. That is
# why every application is LOUD in the trace: a rising re-apply count must stay legible as the
# hardware fault it actually is, never be smoothed away into a quietly self-healing node.
#
# WHY IT CANNOT SEVER THE PATH IT WOULD BE UNDONE OVER (the self-defeating-change gate). The one
# route it installs is a `throw` for this node's OWN LAN prefix in the exit-node's table. Measured
# twice on 2026-08-21 (13:01:47Z, 17:52Z): egress public IP and the whole tailscale peer list were
# byte-identical before and after. It removes nothing, it touches no default route, and it is
# scoped by construction to a private prefix that CONTAINS this node's own address — the guards
# below refuse anything else rather than trusting the probe's output.
#
# TWO GUARD RAILS FROM THE SAME NODE, both deliberate absences:
#   - NO `MESH_DMS_FENCE_KEY`, and no `mesh-dms`. A root-run fence calls `mesh-claim --check`, and
#     claim ownership is the board WHO field — so root reads the applying mind's OWN live claim as
#     "theirs" and REVERTS a change its own verify already blessed (measured 2026-08-21T13:01:28Z:
#     a green application rolled back 5 minutes later). A fence that cannot pass a privilege
#     boundary is not a race detector, it is an unconditional undo.
#   - The verify is NEVER `mesh-lan-presence`. Its ARP fallback reads L2, and the swallow does not
#     touch L2 (`ip neigh` stays REACHABLE, the wifi stays associated at -46 dBm) — so it renders
#     peers PRESENT straight through a dead L3. The gate is the FIB, re-asked after the write.
#
# SINGLE-WRITER: it CHECKS the routing claim and stands down if another mind holds it; it does not
# TAKE one. A claim is a board post with a TTL, and a per-minute reflex minting one for a
# millisecond-long idempotent add would bury the board and lock the key against the humans it is
# meant to coordinate with. Standing down is the safe half of the protocol, and the alarm
# (mesh-card-watchdog) keeps firing meanwhile, so a held key delays the heal, never hides it.
#
#   mesh-exit-node-lan-heal            one cycle: probe, and re-install the line if it is missing
#   mesh-exit-node-lan-heal --check    dry-run — probe and say what WOULD be done, never write
#   mesh-exit-node-lan-heal --log [N]  the durable application tape (last N lines, default 20)
#   mesh-exit-node-lan-heal --test     smoke test (stubbed FIB — touches no real route)
set -uo pipefail

usage(){ sed -n '2,/^[^#]/p' "$0" | sed -n 's/^# \?//p'; }
case "${1:-}" in -h|--help) usage; exit 0 ;; esac

# CRON'S PATH IS NOT YOURS. This is wired `* * * * *` and cron hands a reflex `/usr/bin:/bin` —
# `~/.local/bin` is absent, so a bare `mesh-card` is rc=127 and this tool is BLIND every minute.
# Measured live 2026-08-21T18:54Z, five minutes after wiring: the BLIND gate below caught it and
# refused to run green (which is exactly why that gate exists), but the fix is here. Same line
# mesh-card itself carries, for the same reason.
export PATH="$HOME/.local/bin:$PATH"

MESH_DIR="${MESH_DIR:-$HOME/.mesh}"
# THE TAPE IS NOT THE CRON STDOUT LOG, and the name is deliberate. `mesh-autowire` wires a reflex
# as `... >> $HOME/.mesh/<toolname>.log 2>&1`, so the obvious name for this file is precisely the
# one cron already owns. Sharing it would append every minute's stdout to the ledger `applied_since`
# counts — and since that stdout says "APPLIED throw ..." on a real heal, the re-apply RATE would
# count each application twice and the dongle-fault signal would be fiction. Separate file, and the
# counter below additionally refuses any line that does not START with a real timestamp.
LOG="${MESH_XNL_LOG:-$MESH_DIR/exit-node-lan-heal-applications.log}"
STATE="${MESH_XNL_STATE:-$MESH_DIR/.exit-node-lan-heal.state}"
BOARD_MIN_GAP="${MESH_XNL_BOARD_MIN_GAP:-900}"   # seconds between board posts (trace is unthrottled)
CLAIM_KEY="${MESH_XNL_CLAIM_KEY:-routing}"
# THE OFF-SWITCH IS A FILE, NOT AN ENV VAR, and that is not a style choice. This runs from cron
# (`* * * * *`), and cron sources no profile: an env gate armed in ~/.mesh/nodes or a login shell is
# invisible to the only caller that matters, so the switch would read as "always armed" exactly where
# it needs to bind. A file the tool stats every pass has no such gap.
OFF_SWITCH="${MESH_XNL_OFF:-$MESH_DIR/exit-node-lan-heal.off}"
mkdir -p "$MESH_DIR" 2>/dev/null || true

ts(){ date -u +%Y-%m-%dT%H:%M:%SZ; }
say(){ printf '%s\n' "$*"; }
# quiet(): the NO-OP path only. This fires every minute from cron, whose stdout is appended to a
# durable log — a per-minute "nothing to do" would bury the events it exists to make visible. A
# human running it by hand (tty) or asking --check still gets the answer — an explicit dry-run
# ask that answers nothing is unreadable. Nothing that WROTE, or
# refused, or failed, is ever routed through here.
quiet(){ if [ -t 1 ] || [ "${DRY:-0}" = 1 ] || [ "${MESH_XNL_VERBOSE:-0}" = 1 ]; then printf '%s\n' "$*"; fi; }
tape(){ printf '%s  %s\n' "$(ts)" "$*" >> "$LOG" 2>/dev/null || true; }
trace(){ command -v mesh-trace >/dev/null 2>&1 && mesh-trace "$*" >/dev/null 2>&1 || true; }

# ── the durable tape ───────────────────────────────────────────────────────────────────────────
case "${1:-}" in
  --log) n="${2:-20}"; [ -s "$LOG" ] && tail -n "$n" "$LOG" || echo "(no applications recorded yet: $LOG)"; exit 0 ;;
esac

# ── smoke test ─────────────────────────────────────────────────────────────────────────────────
# EVERY arm runs the REAL tool against a stubbed FIB: a scratch PATH whose `mesh-card` answers a
# fixture, whose `sudo`/`ip` RECORD the command instead of running it, and whose `mesh-trace`/
# `mesh-chat` write to files. No real route is created, deleted or read. The mutants each arm was
# seen RED against are named beside it (run from a scratch copy, never this tree).
if [ "${1:-}" = --test ]; then
  SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
  fails=0; F(){ echo "smoke-test: FAIL ($1)"; fails=1; }
  td="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
  trap 'rm -rf "$td"' EXIT
  mkdir -p "$td/bin" "$td/mesh"
  # `mesh-card --exit-node-lan` stub: the fixture is whatever $td/kv holds, rc from $td/kvrc.
  cat > "$td/bin/mesh-card" <<'MC'
#!/bin/sh
[ "$1" = --exit-node-lan ] || exit 1
cat "$XNL_TD/kv"; exit "$(cat "$XNL_TD/kvrc" 2>/dev/null || echo 0)"
MC
  # sudo/ip: record argv, and fail with whatever $td/iperr says (empty = success).
  cat > "$td/bin/sudo" <<'SU'
#!/bin/sh
[ "$1" = -n ] && shift
[ -f "$XNL_TD/sudoblock" ] && { echo "sudo: a password is required" >&2; exit 1; }
exec "$@"
SU
  # `ip`: records argv, and ANSWERS the two reads the docker leg makes (address on the bridge, and
  # `route get` for a target in its prefix). `route get` is served from docker.route on the first
  # ask and docker.route2 after, which is what makes "wrote it and the bridge is STILL swallowed"
  # expressible. Only `route add` is a write, and only that one honours iperr.
  cat > "$td/bin/ip" <<'IPS'
#!/bin/sh
echo "$*" >> "$XNL_TD/ip.cmds"
# The rescue target, or a sentinel that cannot occur. An EMPTY value here made the pattern below
# read `*"route get "*`, which matches every lookup in the file and silently answered the docker
# leg's questions with the rescue leg's fixture — six docker arms went red for a fixture bug.
RIP="$(cat "$XNL_TD/rescue.ip" 2>/dev/null)"
[ -n "$RIP" ] || RIP="__no-rescue-target__"
case "$*" in
  *"route show default table main"*)
      [ -s "$XNL_TD/maindev" ] && echo "default via 192.168.8.1 dev $(cat "$XNL_TD/maindev") proto dhcp"; exit 0 ;;
  *"-o -4 addr show scope global"*)
      echo "2: wlan0    inet 192.168.8.224/24 scope global wlan0"; exit 0 ;;
  *"addr show dev"*)
      [ -s "$XNL_TD/docker.addr" ] && cat "$XNL_TD/docker.addr"; exit 0 ;;
  *"route get $RIP"*)
      # the RESCUE leg's target, matched by the EXACT address the arm set. Matching by prefix
      # (`route get 10.`) silently hijacked the docker leg's own lookups and turned two passing
      # docker arms red — a stub that answers someone else's question is a fixture bug that reads
      # as a code bug.
      if grep -q 'route add throw' "$XNL_TD/ip.cmds" 2>/dev/null && [ -s "$XNL_TD/rescue.route2" ]; then
        cat "$XNL_TD/rescue.route2"; exit 0; fi
      [ -s "$XNL_TD/rescue.route" ] && cat "$XNL_TD/rescue.route"; exit 0 ;;
  *"route get"*)
      if [ -f "$XNL_TD/rasked" ] && [ -s "$XNL_TD/docker.route2" ]; then cat "$XNL_TD/docker.route2"; exit 0; fi
      : > "$XNL_TD/rasked"
      [ -s "$XNL_TD/docker.route" ] && cat "$XNL_TD/docker.route"; exit 0 ;;
esac
if [ -s "$XNL_TD/iperr" ]; then cat "$XNL_TD/iperr" >&2; exit 2; fi
exit 0
IPS
  # `tailscale`: serves the rescue leg's status fixture from $td/ts.json ('-' = the CLI is absent,
  # which must render na, never a guessed endpoint).
  cat > "$td/bin/tailscale" <<'TSS'
#!/bin/sh
echo "$*" >> "$XNL_TD/ts.cmds"
[ -s "$XNL_TD/ts.json" ] || exit 1
cat "$XNL_TD/ts.json"
TSS
  printf '#!/bin/sh\necho "$*" >> "$XNL_TD/trace.log"\n'  > "$td/bin/mesh-trace"
  printf '#!/bin/sh\necho "$*" >> "$XNL_TD/chat.log"\n'   > "$td/bin/mesh-chat"
  printf '#!/bin/sh\necho "$*" >> "$XNL_TD/ping.cmds"\nexit 0\n' > "$td/bin/ping"
  # `timeout`: the rescue leg's reachability probe opens a REAL socket via bash's /dev/tcp. A smoke
  # test must not dial the network, so this stub swallows the call and returns nothing — which the
  # leg renders as "no answer on :22". R10 then asserts that a dead reach STILL yields an APPLIED,
  # which is the property that keeps reachability corroboration and not the gate.
  printf '#!/bin/sh\necho "$*" >> "$XNL_TD/timeout.cmds"\nexit 1\n' > "$td/bin/timeout"
  printf '#!/bin/sh\ncat "$XNL_TD/claim" 2>/dev/null\nexit 0\n' > "$td/bin/mesh-claim"
  chmod +x "$td/bin"/*
  SWALLOWED='state: swallowed
exit-node: phaedra
own-cidr: 192.168.8.224/24
target: 192.168.8.1
net: 192.168.8.0/24
dev: tailscale0
table: 52
verdict: ⚠ SWALLOWED — 192.168.8.1 routes via dev tailscale0 table 52'
  HEALED='state: ok
exit-node: phaedra
own-cidr: 192.168.8.224/24
target: 192.168.8.1
net: 192.168.8.0/24
dev: wlxbcec43434a22
table:
verdict: ok (192.168.8.1 -> dev wlxbcec43434a22)'
  # run <fixture-before> <fixture-after> [args...] -> tool stdout in $OUT, rc in $RC
  run(){
    local before="$1" after="$2"; shift 2
    rm -f "$td/ip.cmds" "$td/trace.log" "$td/chat.log" "$td/ping.cmds" "$td/rasked" "$td/ts.cmds"
    # The rescue leg runs on EVERY pass, including the LAN/docker arms. Default it to "no exit node"
    # so those arms measure only their own leg; the rescue arms set these fixtures themselves.
    : > "$td/ts.json"; : > "$td/rescue.route"; : > "$td/rescue.route2"; : > "$td/rescue.ip"
    printf 'wlan0\n' > "$td/maindev"
    # the tool asks twice: probe, then post-verify. A tiny wrapper flips the fixture after the
    # first read, which is what makes the "wrote it and the fault remains" arm expressible at all.
    cat > "$td/bin/mesh-card" <<MC2
#!/bin/sh
[ "\$1" = --exit-node-lan ] || exit 1
if [ -f "\$XNL_TD/asked" ]; then printf '%s\n' "\$(cat "\$XNL_TD/kv2")"; exit "\$(cat "\$XNL_TD/kv2rc")"; fi
: > "\$XNL_TD/asked"; printf '%s\n' "\$(cat "\$XNL_TD/kv")"; exit "\$(cat "\$XNL_TD/kvrc")"
MC2
    chmod +x "$td/bin/mesh-card"; rm -f "$td/asked"
    printf '%s\n' "$before" > "$td/kv"; printf '%s\n' "$after" > "$td/kv2"
    case "$before" in *'state: swallowed'*) echo 2 > "$td/kvrc" ;; *) echo 0 > "$td/kvrc" ;; esac
    case "$after"  in *'state: swallowed'*) echo 2 > "$td/kv2rc" ;; *) echo 0 > "$td/kv2rc" ;; esac
    OUT="$(XNL_TD="$td" PATH="${XNL_PATH:-$td/bin:$PATH}" HOME="$td" MESH_DIR="$td/mesh" \
           MESH_XNL_LOG="$td/mesh/heal.log" MESH_XNL_STATE="$td/mesh/state" \
           MESH_XNL_OFF="$td/off" \
           "$SELF" "$@" 2>&1)"; RC=$?
  }
  applied(){ grep -q 'route add throw' "$td/ip.cmds" 2>/dev/null; }

  # (T1) the whole point: a swallowed LAN gets EXACTLY the one line, and it is LOUD in the trace.
  #      mutant: drop the `sudo -n ip route add` call → red (nothing applied).
  run "$SWALLOWED" "$HEALED"
  [ "$RC" = 0 ] || F "a healable swallow exited $RC: $OUT"
  grep -qx 'route add throw 192.168.8.0/24 table 52' "$td/ip.cmds" 2>/dev/null \
    || F "did not install exactly 'ip route add throw 192.168.8.0/24 table 52' (got: $(cat "$td/ip.cmds" 2>/dev/null))"
  # count the WRITES, not every `ip` call: the docker leg reads the bridge through `ip` too, and a
  # bare line count would make every probe read look like a route installation.
  [ "$(grep -c 'route add' "$td/ip.cmds")" = 1 ] || F "installed more than the one route: $(grep 'route add' "$td/ip.cmds")"
  grep -q 'APPLIED' "$td/trace.log" 2>/dev/null \
    || F "an application left NO trace — the re-apply rate is the whole signal and it must be loud"
  grep -q 'in 24h' "$td/trace.log" 2>/dev/null \
    || F "the trace carried no rate: '$(cat "$td/trace.log" 2>/dev/null)'"
  grep -q 'APPLIED throw 192.168.8.0/24 table 52' "$td/mesh/heal.log" 2>/dev/null \
    || F "the durable tape recorded no application"

  # (T2) healthy LAN: touch NOTHING. A healer that writes when there is nothing wrong is a writer
  #      nobody asked for, and it would fake the rate signal every minute.
  #      mutant: branch on rc instead of state, or drop the `!= swallowed` early return → red.
  run "$HEALED" "$HEALED"
  [ "$RC" = 0 ] || F "a healthy FIB exited $RC: $OUT"
  applied && F "wrote a route while the LAN was FINE: $(cat "$td/ip.cmds")"

  # (T3) the prefix must be OUR OWN LAN. A probe answer naming someone else's network, a public
  #      network, or a /0 must be REFUSED — the healer is not a general-purpose route installer.
  #      mutant: delete the net_allowed call → red on all three.
  for bad in '10.0.0.0/8' '8.8.8.0/24' '0.0.0.0/0'; do
    run "$(printf '%s\n' "$SWALLOWED" | sed "s|^net: .*|net: $bad|")" "$HEALED"
    applied && F "installed a throw for $bad, which does not contain this node's own 192.168.8.224"
    [ "$RC" = 0 ] && F "refusing $bad exited 0 — a refusal that reads as success is a silent skip"
  done

  # (T4) no table, or the placeholder the verdict renders when it could not read one: REFUSE.
  #      Guessing 52 would install a throw in a table this node may not even own.
  for badt in '' '<t>'; do
    run "$(printf '%s\n' "$SWALLOWED" | sed "s|^table: .*|table: $badt|")" "$HEALED"
    applied && F "guessed a table when the probe gave '$badt'"
  done
  # (T5) ...and NEVER main/local/default — a throw there blackholes the LAN it is meant to free.
  for badt in main local default 254; do
    run "$(printf '%s\n' "$SWALLOWED" | sed "s|^table: .*|table: $badt|")" "$HEALED"
    applied && F "wrote a throw into table '$badt', which carries this node's real routing"
  done

  # (T6) EEXIST is idempotent success, and must NOT be counted as an application — a rate padded
  #      with no-ops stops measuring the dongle.  mutant: treat EEXIST as APPLIED → red.
  printf 'RTNETLINK answers: File exists\n' > "$td/iperr"
  run "$SWALLOWED" "$HEALED"
  rm -f "$td/iperr"
  [ "$RC" = 0 ] || F "an already-present route exited $RC: $OUT"
  grep -q 'APPLIED' "$td/mesh/heal.log.eexist" 2>/dev/null && F "unreachable"
  grep -q 'PRESENT' "$td/mesh/heal.log" 2>/dev/null || F "EEXIST was not recorded as PRESENT: $OUT"
  case "$OUT" in *'already present'*) ;; *) F "EEXIST did not report as already-present: $OUT" ;; esac

  # (T7) the write succeeded and the FIB STILL says swallowed → LOUD failure, non-zero. Reporting
  #      green off `ip route add` returning 0 would be exactly the "the interface came up" claim
  #      the doctrine forbids: the artifact is the re-asked FIB, not the writer's own rc.
  #      mutant: drop the post-verify → red (exits 0 while the fault stands).
  run "$SWALLOWED" "$SWALLOWED"
  [ "$RC" = 0 ] && F "the fault survived the write and the tool still exited 0: $OUT"
  grep -q 'UNHEALED' "$td/trace.log" 2>/dev/null || F "a failed heal left no UNHEALED trace: $OUT"


  # ══ RESCUE LEG ════════════════════════════════════════════════════════════════════════════════
  # rrun <ts-json> <route-before> <route-after> [maindev] — drive one rescue-leg scenario. The LAN
  # and docker legs are pinned healthy so a failure can only come from the leg under test.
  rrun(){
    run "$HEALED" "$HEALED"   # resets the fixtures, then we overwrite the rescue ones and re-run
    printf '%s\n' "$1" > "$td/ts.json"
    printf '%s\n' "$2" > "$td/rescue.route"
    printf '%s\n' "$3" > "$td/rescue.route2"
    printf '%s\n' "${4-wlan0}" > "$td/maindev"
    # the stub answers `route get` for THIS address only
    printf '%s' "$1" | sed -n 's/.*"CurAddr":"\([0-9.]*\):.*/\1/p' > "$td/rescue.ip"
    rm -f "$td/ip.cmds" "$td/trace.log" "$td/chat.log" "$td/mesh/heal.log"
    OUT="$(XNL_TD="$td" PATH="$td/bin:$PATH" HOME="$td" MESH_DIR="$td/mesh" \
           MESH_XNL_LOG="$td/mesh/heal.log" MESH_XNL_STATE="$td/mesh/state" \
           MESH_XNL_OFF="$td/off" "$SELF" 2>&1)"; RC=$?
  }
  TS_EXIT='{"ExitNodeStatus":{"ID":"nPHAEDRA"},"Peer":{"k":{"ID":"nPHAEDRA","HostName":"phaedra","CurAddr":"45.33.32.156:41641"}}}'
  TS_NOEXIT='{"Peer":{"k":{"ID":"nPHAEDRA","HostName":"phaedra","CurAddr":"45.33.32.156:41641"}}}'
  TS_DERP='{"ExitNodeStatus":{"ID":"nPHAEDRA"},"Peer":{"k":{"ID":"nPHAEDRA","HostName":"phaedra","CurAddr":""}}}'
  TS_PRIV='{"ExitNodeStatus":{"ID":"nPHAEDRA"},"Peer":{"k":{"ID":"nPHAEDRA","HostName":"phaedra","CurAddr":"10.9.0.5:41641"}}}'
  TS_SELF='{"ExitNodeStatus":{"ID":"nPHAEDRA"},"Peer":{"k":{"ID":"nPHAEDRA","HostName":"phaedra","CurAddr":"192.168.8.224:41641"}}}'
  SWALLOWED_R='45.33.32.156 dev tailscale0 table 52 src 100.81.222.19 uid 1000'
  FREED_R='45.33.32.156 via 192.168.8.1 dev wlan0 src 192.168.8.224 uid 1000'
  rescued(){ grep -q 'route add throw 45.33.32.156/32' "$td/ip.cmds" 2>/dev/null; }

  # (R1) THE WHOLE POINT: the exit node's own public endpoint is riding the exit table, so the
  #      off-tailnet rescue path is inside the tunnel it would rescue. Except exactly that /32.
  #      mutant: drop the rescue_leg call from the dispatch -> red.
  rrun "$TS_EXIT" "$SWALLOWED_R" "$FREED_R"
  [ "$RC" = 0 ] || F "a swallowed rescue path exited $RC: $OUT"
  rescued || F "did not install 'throw 45.33.32.156/32' (ip calls: $(cat "$td/ip.cmds" 2>/dev/null))"
  grep -q 'APPLIED-RESCUE' "$td/mesh/heal.log" 2>/dev/null \
    || F "the rescue application was not taped under its OWN verb: $(cat "$td/mesh/heal.log" 2>/dev/null)"
  # the verb must be its own: sharing APPLIED would silently double the LAN re-apply rate this node
  # quotes as the uplink wipe rate.  mutant: pass APPLIED as the verb -> red.
  grep -qE '^[0-9-]+T[0-9:]+Z +APPLIED ' "$td/mesh/heal.log" 2>/dev/null \
    && F "the rescue leg taped a bare APPLIED row, which inflates the LAN wipe rate: $(cat "$td/mesh/heal.log")"

  # (R2) the endpoint is READ LIVE, never a constant. A different CurAddr must be excepted instead.
  #      mutant: hardcode 38.49.216.141 -> red.
  rrun "$(printf '%s' "$TS_EXIT"     | sed 's/45\.33\.32\.156/93\.184\.216\.34/g')" \
       "$(printf '%s' "$SWALLOWED_R" | sed 's/45\.33\.32\.156/93\.184\.216\.34/')" \
       "$(printf '%s' "$FREED_R"     | sed 's/45\.33\.32\.156/93\.184\.216\.34/')"
  grep -q 'route add throw 93.184.216.34/32' "$td/ip.cmds" 2>/dev/null \
    || F "did not follow the exit node's LIVE CurAddr to 93.184.216.34 (ip calls: $(cat "$td/ip.cmds" 2>/dev/null))"

  # (R3) already free: touch NOTHING. The rescue path leaving by the uplink is the healthy state.
  rrun "$TS_EXIT" "$FREED_R" "$FREED_R"
  rescued && F "wrote a rescue throw while the endpoint already left by the uplink: $(cat "$td/ip.cmds")"
  [ "$RC" = 0 ] || F "a healthy rescue path exited $RC: $OUT"

  # (R4) no exit node consumed -> absent, nothing to except, and NOT an error.
  rrun "$TS_NOEXIT" "$SWALLOWED_R" "$FREED_R"
  rescued && F "installed a rescue throw with no exit node in play"
  [ "$RC" = 0 ] || F "a node consuming no exit node exited $RC: $OUT"

  # (R5) DERP-relayed: there is no single public endpoint. Render na and say so — never guess one.
  rrun "$TS_DERP" "$SWALLOWED_R" "$FREED_R"
  rescued && F "guessed an endpoint for a DERP-relayed exit node"

  # (R6) the guard's polarity is the OPPOSITE of the LAN leg's. A PRIVATE CurAddr means the exit node
  #      is on our own LAN — there is no off-tailnet path to except, and a throw for an RFC1918 /32
  #      here would be the LAN leg's job, done wrong.  mutant: reuse net_allowed -> red.
  rrun "$TS_PRIV" "$SWALLOWED_R" "$FREED_R"
  grep -q 'route add throw 10.9.0.5/32' "$td/ip.cmds" 2>/dev/null \
    && F "excepted a PRIVATE endpoint — this leg installs public /32s only"
  [ "$RC" = 0 ] && F "refusing a private endpoint exited 0 — a refusal that reads as success is a silent skip"

  # (R7) OUR OWN address: rule 0 answers it out of table local whatever table 52 says, so a throw
  #      there measures nothing at all. Same trap as pinging docker0's own address.
  rrun "$TS_SELF" "$SWALLOWED_R" "$FREED_R"
  grep -q 'route add throw 192.168.8.224/32' "$td/ip.cmds" 2>/dev/null \
    && F "excepted this node's OWN address, which the FIB answers locally either way"

  # (R8) no default route in main: there is no uplink device to compare against. na, never a guess —
  #      and never "swallowed" off a comparison with an empty string.
  #      mutant: default maindev to tailscale0, or compare against the literal name -> red.
  rrun "$TS_EXIT" "$SWALLOWED_R" "$FREED_R" ""
  rescued && F "installed a rescue throw with no uplink device to compare against"

  # (R11) THE SWALLOWER IS NOT ALWAYS CALLED tailscale0, and deciding "is it swallowed" by that name
  #       is an ALLOWLIST OF SWALLOWERS whose failure direction is SILENCE — the exact polarity the
  #       docker leg's D13 already pays for one ring out. The question is "did it leave by the
  #       UPLINK", so anything else swallowing it must be caught.  mutant: test `dev != tailscale0`
  #       instead of `dev = maindev` -> red.
  rrun "$TS_EXIT" "45.33.32.156 dev ovpn7 table 52 src 10.8.0.2" "$FREED_R"
  rescued || F "R11: an endpoint swallowed by a device NOT named tailscale0 (ovpn7) went undetected — the probe is an allowlist of swallowers, which fails toward silence: $(cat "$td/ip.cmds" 2>/dev/null)"

  # (R10) THE REACH CHECK IS NOT THE GATE. The stubbed `timeout` means nothing answers :22, and the
  #       heal must still be an APPLIED-RESCUE: the discriminator is the FIB device, because while
  #       the exit node is healthy the tunnel delivers :22 too — a green banner is exactly as
  #       available through the fault as around it.  mutant: gate the verdict on rescue_reach -> red.
  rrun "$TS_EXIT" "$SWALLOWED_R" "$FREED_R"
  grep -q 'APPLIED-RESCUE' "$td/mesh/heal.log" 2>/dev/null \
    || F "R10: a restored path with nothing answering :22 was not recorded as healed — the banner has become the gate: $OUT"
  grep -q 'no answer on :22' "$td/mesh/heal.log" 2>/dev/null \
    || F "R10: the reach result was not recorded at all: $(cat "$td/mesh/heal.log" 2>/dev/null)"

  # (R9) wrote it and the endpoint is STILL not on the uplink -> LOUD, non-zero. The artifact is the
  #      re-asked FIB device, never `ip route add`'s own rc and never the :22 banner.
  #      mutant: drop the post-verify, or verify on the reachability check -> red.
  rrun "$TS_EXIT" "$SWALLOWED_R" "$SWALLOWED_R"
  [ "$RC" = 0 ] && F "the rescue path stayed swallowed and the tool still exited 0: $OUT"
  grep -q 'UNHEALED-RESCUE' "$td/trace.log" 2>/dev/null || F "a failed rescue heal left no UNHEALED-RESCUE trace: $OUT"

  # (T8) no passwordless sudo: a real, loud failure. Never a silent skip — a healer that cannot
  #      write must not run green forever (that is the reflex-that-was-never-wired shape).
  : > "$td/sudoblock"
  run "$SWALLOWED" "$HEALED"
  rm -f "$td/sudoblock"
  [ "$RC" = 0 ] && F "a blocked sudo exited 0: $OUT"
  grep -q 'FAILED' "$td/mesh/heal.log" 2>/dev/null || F "a blocked sudo left nothing on the tape"

  # (T9) single-writer: another mind holding the routing key means STAND DOWN, not fight.
  #      mutant: drop the claim check → red (it applies over a live writer).
  printf 'theirs: routing held by health@mesh-home (held 120s)\n' > "$td/claim"
  run "$SWALLOWED" "$HEALED"
  rm -f "$td/claim"
  applied && F "wrote a route while ANOTHER mind held the routing claim"
  [ "$RC" = 0 ] || F "standing down for a live claim exited $RC — that is a normal outcome"
  # ...and OUR OWN claim ('yours:') must not stop us: the mind that claimed routing is who wired
  # this reflex, and treating its own claim as a blocker is the privilege-fence bug one ring out.
  printf 'yours: routing (held 341s)\n' > "$td/claim"
  run "$SWALLOWED" "$HEALED"
  rm -f "$td/claim"
  applied || F "stood down for OUR OWN claim — 'yours:' is not a second writer"

  # (T10) --check is a DRY RUN and must never write, even with the fault live in front of it.
  run "$SWALLOWED" "$HEALED" --check
  applied && F "--check wrote a route: $(cat "$td/ip.cmds")"
  case "$OUT" in *'WOULD APPLY'*) ;; *) F "--check did not name what it would do: $OUT" ;; esac

  # (T14) IT MUST WORK UNDER CRON'S PATH. Wired `* * * * *`, this gets `/usr/bin:/bin` and nothing
  #       else — a bare `mesh-card` is rc=127 there. Caught in production 5 minutes after wiring by
  #       the BLIND gate (T11), which is the right failure but the wrong outcome: the reflex was
  #       alive, loud and useless. So the tool prepends ~/.local/bin itself, and this arm drives it
  #       with the stub reachable ONLY through $HOME/.local/bin.
  #       mutant: drop the `export PATH="$HOME/.local/bin:$PATH"` line -> red.
  mkdir -p "$td/.local/bin"; cp "$td/bin/mesh-card" "$td/bin/ip" "$td/bin/sudo" "$td/bin/ping" "$td/.local/bin/"
  rm -f "$td/asked"; printf '%s\n' "$HEALED" > "$td/kv"; printf '%s\n' "$HEALED" > "$td/kv2"
  echo 0 > "$td/kvrc"; echo 0 > "$td/kv2rc"
  OUT="$(XNL_TD="$td" PATH="/usr/bin:/bin" HOME="$td" MESH_DIR="$td/mesh" \
         MESH_XNL_LOG="$td/mesh/heal.log" MESH_XNL_STATE="$td/mesh/state" \
         MESH_XNL_VERBOSE=1 "$SELF" 2>&1)"; RC=$?
  case "$OUT" in *BLIND*) F "under cron's PATH (/usr/bin:/bin) the tool could not find mesh-card — it would run BLIND every minute: $OUT" ;; esac
  [ "$RC" = 0 ] || F "under cron's PATH the tool exited $RC: $OUT"

  # (T12) THE CRON-LOG COLLISION. `mesh-autowire` wires this as `>> ~/.mesh/<toolname>.log`, so the
  #       default tape name must NOT be that file, and the counter must not be fooled if some other
  #       writer ever lands stdout in it: a line saying "APPLIED" that does not START with a
  #       timestamp is not a ledger entry, and counting it would double the very rate this tool
  #       publishes as the dongle-fault signal. Caught before landing, when autowire chose the name.
  #       mutants: default LOG back to $MESH_DIR/exit-node-lan-heal.log → red; drop the timestamp
  #       anchor from the awk counter → red.
  case "$(XNL_TD="$td" HOME="$td" MESH_DIR="$td/mesh" MESH_XNL_LOG='' "$SELF" --log 1 2>&1)" in
    *"/exit-node-lan-heal.log"*) F "the default tape IS the cron stdout log mesh-autowire redirects into — every application would be counted twice" ;;
  esac
  rm -f "$td/mesh/heal.log"
  printf 'exit-node-lan-heal: APPLIED throw 192.168.8.0/24 table 52 (a cron stdout line, not a ledger entry)\n' > "$td/mesh/heal.log"
  run "$SWALLOWED" "$HEALED"
  case "$(grep -o 'in 24h' -B0 "$td/trace.log" >/dev/null; sed -n 's/.*re-applications: \([0-9]*\) in 1h, \([0-9]*\) in 24h.*/\1 \2/p' "$td/trace.log")" in
    "1 1") ;;
    *) F "an unstamped stdout line saying APPLIED inflated the rate: $(sed -n 's/.*re-applications:/re-applications:/p' "$td/trace.log")" ;;
  esac

  # (T13) it runs EVERY MINUTE into an appended log: the no-op path must print NOTHING, or the
  #       events drown in 1440 daily "nothing to do" lines. --check and a tty still answer.
  #       mutant: route the no-op through say() → red.
  rm -f "$td/mesh/heal.log"
  run "$HEALED" "$HEALED"
  [ -z "$OUT" ] || F "the no-op path printed to a non-tty stdout — this runs 1440x/day: '$OUT'"
  run "$HEALED" "$HEALED" --check
  [ -n "$OUT" ] || F "--check printed nothing — a dry run that says nothing cannot be read"

  # (T11) a mesh-card WITHOUT the --exit-node-lan leg (an un-deployed node) must read BLIND and
  #       non-zero, never "nothing to do". A probe that cannot answer is not an all-clear.
  # both locations: T14 planted a working stub in $HOME/.local/bin, which the tool now prepends —
  # leaving it there would let this arm find a HEALTHY probe and pass for the wrong reason.
  rm -f "$td/asked"
  for _b in "$td/bin/mesh-card" "$td/.local/bin/mesh-card"; do
    printf '#!/bin/sh\nexit 1\n' > "$_b"; chmod +x "$_b"
  done
  OUT="$(XNL_TD="$td" PATH="$td/bin:$PATH" HOME="$td" MESH_DIR="$td/mesh" \
         MESH_XNL_LOG="$td/mesh/heal.log" MESH_XNL_STATE="$td/mesh/state" "$SELF" 2>&1)"; RC=$?
  [ "$RC" = 0 ] && F "a mesh-card with no --exit-node-lan leg exited 0 — the reflex would run green while blind"
  case "$OUT" in *BLIND*) ;; *) F "an unanswerable probe did not render BLIND: $OUT" ;; esac
  case "$OUT" in *'Deploy the mesh-card'*) ;; *) F "a non-127 empty-state probe did not name the DEPLOY cause: $OUT" ;; esac

  # (T15) BLIND MUST NAME THE RIGHT RING. rc=127 is command-not-found — the tool is missing from
  #       PATH — and can never mean "deployed but without the leg". Sending the fixer to redeploy
  #       an already-identical tool is a misdiagnosis WITH A DIRECTION, which is worse than none;
  #       it is what the first 20 cron fires printed. Drive the real rc=127 by removing the stub
  #       from every location the tool can reach.
  #       mutant: collapse the two hints back to one message -> red.
  rm -f "$td/asked" "$td/bin/mesh-card" "$td/.local/bin/mesh-card"
  OUT="$(XNL_TD="$td" PATH="/usr/bin:/bin" HOME="$td" MESH_DIR="$td/mesh" \
         MESH_XNL_LOG="$td/mesh/heal.log" MESH_XNL_STATE="$td/mesh/state" "$SELF" 2>&1)"; RC=$?
  [ "$RC" = 0 ] && F "a missing mesh-card exited 0 — the reflex would run green while blind"
  case "$OUT" in *'rc=127'*) ;; *) F "a missing mesh-card did not report rc=127: $OUT" ;; esac
  case "$OUT" in *'NOT ON PATH'*) ;; *) F "rc=127 did not name the PATH/environment cause: $OUT" ;; esac
  case "$OUT" in *'Deploy the mesh-card'*) F "rc=127 blamed the DEPLOY — a misdiagnosis with a direction, sending the fixer to redeploy an already-correct tool: $OUT" ;; esac


  # ════ THE DOCKER-BRIDGE LEG ═══════════════════════════════════════════════════════════════════
  # dockerfx <addr-line> <route-before> <route-after> — plant the bridge fixtures. An EMPTY addr is
  # a node with no docker, which is what every arm above ran with (so none of them touched it).
  dockerfx(){
    printf '%s' "${1:-}" > "$td/docker.addr"
    printf '%s' "${2:-}" > "$td/docker.route"
    printf '%s' "${3:-}" > "$td/docker.route2"
    [ -n "${1:-}" ] && echo >> "$td/docker.addr"
    [ -n "${2:-}" ] && echo >> "$td/docker.route"
    [ -n "${3:-}" ] && echo >> "$td/docker.route2"
    return 0
  }
  D_ADDR='5: docker0    inet 172.17.0.1/16 brd 172.17.255.255 scope global docker0\       valid_lft forever'
  D_SWAL='172.17.0.2 dev tailscale0 table 52 src 100.81.222.19 uid 1000'
  D_OK='172.17.0.2 dev docker0 src 172.17.0.1 uid 1000'

  # (D1) THE REGRESSION THIS LEG EXISTS FOR, and it is the live state of mesh-home 2026-08-26:
  #      the LAN reads ok and the docker bridge is swallowed. Before this leg the tool returned at
  #      "nothing to do" the moment the LAN was fine and never looked at the bridge — exiting 0
  #      every minute with the fault in front of it.
  #      mutant: restore the LAN leg's `exit 0` (i.e. let the LAN verdict gate the run) -> red.
  dockerfx "$D_ADDR" "$D_SWAL" "$D_OK"
  run "$HEALED" "$HEALED"
  [ "$RC" = 0 ] || F "D1: a healable docker swallow under a HEALTHY LAN exited $RC: $OUT"
  grep -qx 'route add throw 172.17.0.0/16 table 52' "$td/ip.cmds" 2>/dev/null \
    || F "D1: a healthy LAN suppressed the docker leg — no throw installed (ip calls: $(cat "$td/ip.cmds" 2>/dev/null))"
  [ "$(grep -c 'route add' "$td/ip.cmds")" = 1 ] || F "D1: installed more than the one route: $(grep 'route add' "$td/ip.cmds")"
  grep -q 'APPLIED-DOCKER' "$td/mesh/heal.log" 2>/dev/null || F "D1: the durable tape recorded no docker application: $(cat "$td/mesh/heal.log" 2>/dev/null)"
  grep -q 'APPLIED-DOCKER' "$td/trace.log" 2>/dev/null || F "D1: a docker application left NO trace — the re-apply rate is the whole signal"

  # (D2) THE VERIFY MUST NEVER PING. The only address certain to exist in the bridge prefix is our
  #      OWN (172.17.0.1), and `ip rule` 0 answers it out of table `local` as `dev lo` whether or
  #      not the prefix is swallowed — so a ping would reply from the loopback and read green
  #      through a live fault. The artifact is the FIB answer's DEVICE.
  #      mutant: verify with `ping $target` / `ping 172.17.0.1` -> red.
  grep -q '172\.17\.' "$td/ping.cmds" 2>/dev/null \
    && F "D2: the docker leg PINGED a bridge address ($(cat "$td/ping.cmds")) — rule 0 answers our own address locally, so a ping is green through the fault"

  # (D3) ...and it verifies by RE-ASKING, not by trusting `ip route add`'s rc. Same fixture, but the
  #      bridge is STILL swallowed afterwards -> loud, non-zero, UNHEALED.
  #      mutant: drop the post-write `ip route get` and report off arc -> red.
  dockerfx "$D_ADDR" "$D_SWAL" "$D_SWAL"
  run "$HEALED" "$HEALED"
  [ "$RC" = 0 ] && F "D3: the docker fault survived the write and the tool still exited 0: $OUT"
  grep -q 'UNHEALED' "$td/trace.log" 2>/dev/null || F "D3: a failed docker heal left no UNHEALED trace: $OUT"

  # (D4) NO DOCKER ON THIS NODE: clean skip, rc 0, and SILENT on a non-tty (1440 fires/day, and most
  #      nodes in this mesh run no docker at all) — but the reason is SAID to a human asking.
  #      mutant: route the absent path through say() -> red on the silence arm.
  dockerfx '' '' ''
  run "$HEALED" "$HEALED"
  [ "$RC" = 0 ] || F "D4: a node with no docker0 exited $RC: $OUT"
  applied && F "D4: wrote a route on a node with no docker bridge: $(cat "$td/ip.cmds")"
  [ -z "$OUT" ] || F "D4: the no-docker skip printed to a non-tty — this fires 1440x/day: '$OUT'"
  run "$HEALED" "$HEALED" --check
  case "$OUT" in *docker*) ;; *) F "D4: --check never SAID why the docker leg skipped: $OUT" ;; esac

  # (D5) a HEALTHY bridge: touch nothing.
  dockerfx "$D_ADDR" "$D_OK" "$D_OK"
  run "$HEALED" "$HEALED"
  [ "$RC" = 0 ] || F "D5: a healthy bridge exited $RC: $OUT"
  applied && F "D5: wrote a route while the bridge was FINE: $(cat "$td/ip.cmds")"

  # (D6) THE PREFIX IS READ FROM THE LINK, NEVER A CONSTANT. A daemon started with `--bip` puts the
  #      bridge somewhere else; a hardcoded 172.17 would install a throw for a network this node
  #      does not have and leave the real bridge swallowed — green over a live fault.
  #      mutant: hardcode net=172.17.0.0/16 -> red.
  dockerfx '5: docker0    inet 10.99.0.1/24 brd 10.99.0.255 scope global docker0\       valid_lft forever' \
           '10.99.0.2 dev tailscale0 table 52 src 100.81.222.19 uid 1000' \
           '10.99.0.2 dev docker0 src 10.99.0.1 uid 1000'
  run "$HEALED" "$HEALED"
  grep -qx 'route add throw 10.99.0.0/24 table 52' "$td/ip.cmds" 2>/dev/null \
    || F "D6: a custom-bip bridge (10.99.0.1/24) did not get its OWN prefix: $(grep 'route add' "$td/ip.cmds" 2>/dev/null)"

  # (D7) THE PROBE TARGET IS NEVER OUR OWN ADDRESS. docker0's address is the FIRST in the prefix,
  #      which is exactly what a naive picker takes — and rule 0 would answer it green forever.
  #      mutant: probe_target returns network_address+1 unconditionally -> red.
  dockerfx "$D_ADDR" "$D_SWAL" "$D_OK"
  run "$HEALED" "$HEALED"
  grep -q 'route get 172.17.0.1$' "$td/ip.cmds" 2>/dev/null \
    && F "D7: the docker probe asked the FIB about OUR OWN address 172.17.0.1 — table local answers that green through any swallow"
  grep -q 'route get 172.17.0.2' "$td/ip.cmds" 2>/dev/null \
    || F "D7: the docker probe never asked about a non-local address in the prefix: $(cat "$td/ip.cmds")"

  # (D8) THE GATES ARE THE SAME GATES. A bridge answering with a public prefix, or one whose net
  #      does not contain its own address, is REFUSED — the docker leg is a second subject through
  #      net_allowed/table_allowed, never a bypass of them.
  #      mutant: skip net_allowed for the docker leg -> red.
  dockerfx '5: docker0    inet 8.8.8.1/24 brd 8.8.8.255 scope global docker0\       valid_lft forever' \
           '8.8.8.2 dev tailscale0 table 52 src 100.81.222.19 uid 1000' \
           '8.8.8.2 dev docker0 src 8.8.8.1 uid 1000'
  run "$HEALED" "$HEALED"
  applied && F "D8: installed a throw for a PUBLIC bridge prefix 8.8.8.0/24: $(cat "$td/ip.cmds")"
  [ "$RC" = 0 ] && F "D8: refusing a public bridge prefix exited 0 — a refusal that reads as success is a silent skip"

  # (D9) ...and never into main/local/default, whatever the FIB answer said.
  dockerfx "$D_ADDR" '172.17.0.2 dev tailscale0 table main src 100.81.222.19 uid 1000' "$D_OK"
  run "$HEALED" "$HEALED"
  applied && F "D9: wrote a docker throw into table 'main', which carries this node's real routing"

  # (D10) --check is a DRY RUN for the docker leg too.
  dockerfx "$D_ADDR" "$D_SWAL" "$D_OK"
  run "$HEALED" "$HEALED" --check
  applied && F "D10: --check wrote a docker route: $(cat "$td/ip.cmds")"
  case "$OUT" in *'WOULD APPLY'*172.17.0.0/16*) ;; *) F "D10: --check did not name the docker throw it would install: $OUT" ;; esac

  # (D11) single-writer covers BOTH legs. The claim read is hoisted, so a mind holding `routing`
  #       stops the docker write too — otherwise the LAN leg stands down politely and the docker
  #       leg writes over the very mind it stood down for.
  #       mutant: leave the claim check inside lan_leg only -> red.
  printf 'theirs: routing held by health@mesh-home (held 120s)\n' > "$td/claim"
  run "$HEALED" "$HEALED"
  rm -f "$td/claim"
  applied && F "D11: the docker leg wrote a route while ANOTHER mind held the routing claim"
  [ "$RC" = 0 ] || F "D11: standing down for a live claim exited $RC — that is a normal outcome"

  # (D12) THE PUBLISHED RATE MUST NOT MOVE. CLAUDE.local.md quotes the LAN `APPLIED` count as the
  #       exit-node wipe rate; both legs fire on the SAME reconverge, so a substring match would
  #       have silently doubled that number the day this leg landed — a rate that reads as a dongle
  #       degrading when only our instrumentation changed. Two verbs, two counts.
  #
  #       SEED THE TAPE WITH AN EARLIER ROW OF THE OTHER VERB — an in-pass assertion cannot test
  #       this and this arm was WRITTEN that way first. The LAN leg runs before the docker leg and
  #       counts before the docker leg has taped anything, so a same-pass check reads 1 under a
  #       substring counter too. Mutating `$2 == v` back to `/APPLIED/` left it GREEN: a gate whose
  #       subject cannot yet exist when it fires is not a gate.
  #       mutant: count with /APPLIED/ instead of $2 == verb -> red on both directions below.
  rm -f "$td/mesh/heal.log"
  old_ts="$(date -u -d '-10 minutes' +%Y-%m-%dT%H:%M:%SZ)"
  printf '%s  APPLIED-DOCKER throw 172.17.0.0/16 table 52 dev=docker0\n' "$old_ts" > "$td/mesh/heal.log"
  dockerfx '' '' ''                    # docker absent this pass: ONLY the LAN leg fires
  run "$SWALLOWED" "$HEALED"
  case "$(sed -n 's/.*re-applications: \([0-9]*\) in 1h, \([0-9]*\) in 24h.*/\1 \2/p' "$td/trace.log" | head -1)" in
    "1 1") ;;
    *) F "D12: an EARLIER APPLIED-DOCKER row inflated the LAN re-apply rate to '$(sed -n 's/.*re-applications: //p' "$td/trace.log" | head -1)' — that number is quoted as the uplink wipe rate and must keep meaning what it meant" ;;
  esac

  # ...and the mirror: an earlier LAN APPLIED row must not inflate the DOCKER count either.
  rm -f "$td/mesh/heal.log"
  printf '%s  APPLIED throw 192.168.8.0/24 table 52 exit-node=phaedra ping 192.168.8.1 ok\n' "$old_ts" > "$td/mesh/heal.log"
  dockerfx "$D_ADDR" "$D_SWAL" "$D_OK"
  run "$HEALED" "$HEALED"
  case "$OUT" in
    *'1 docker re-application(s) in 24h'*) ;;
    *) F "D12: an earlier LAN APPLIED row leaked into the docker count: $OUT" ;;
  esac

  # BOTH legs on ONE reconverge: two writes, and exactly one row of each verb.
  rm -f "$td/mesh/heal.log"
  dockerfx "$D_ADDR" "$D_SWAL" "$D_OK"
  run "$SWALLOWED" "$HEALED"
  [ "$(grep -c 'route add throw' "$td/ip.cmds")" = 2 ] \
    || F "D12: one reconverge did not produce both throws: $(grep 'route add' "$td/ip.cmds" 2>/dev/null)"
  [ "$(awk '$2=="APPLIED"{n++} END{print n+0}' "$td/mesh/heal.log")" = 1 ] \
    || F "D12: the LAN ledger verb did not appear exactly once: $(cat "$td/mesh/heal.log")"
  [ "$(awk '$2=="APPLIED-DOCKER"{n++} END{print n+0}' "$td/mesh/heal.log")" = 1 ] \
    || F "D12: the docker ledger verb did not appear exactly once: $(cat "$td/mesh/heal.log")"
  dockerfx '' '' ''

  # (D13) THE POLARITY. The bridge prefix has exactly ONE correct answer — its own device — so the
  #       probe gates on `dev == docker0` and everything else is loud. The tempting alternative is
  #       an allowlist of devices that COUNT as swallowing (tailscale0, wg*, ...), and that fails
  #       toward SILENCE: the first overlay whose name is not on the list renders a live swallow as
  #       healthy. Every other fixture here uses tailscale0, so an allowlist implementation passes
  #       all of them — this arm is the one that tells the two apart, and without it the polarity
  #       claim in the probe's own comment was one the suite could not back (the mutant ran GREEN
  #       until this landed).
  #       mutant: `if [ "$dev" != tailscale0 ]` in place of `[ "$dev" = "$DOCKER_DEV" ]` -> red.
  dockerfx "$D_ADDR" '172.17.0.2 dev ovpn7 table 52 src 10.8.0.9 uid 1000' "$D_OK"
  run "$HEALED" "$HEALED"
  grep -qx 'route add throw 172.17.0.0/16 table 52' "$td/ip.cmds" 2>/dev/null \
    || F "D13: a bridge swallowed by a device NOT named tailscale0 (ovpn7) went undetected — the probe is acting as an allowlist of swallowers, which fails toward silence: $(cat "$td/ip.cmds" 2>/dev/null)"
  [ "$RC" = 0 ] || F "D13: healing an ovpn7-swallowed bridge exited $RC: $OUT"

  # (D14) A DOCKER-ONLY HEAL MUST MOVE THE STATE FILE'S CONTENT. mesh-reflex-health watches that
  #       content as an axis; a leg that heals while the content sits frozen reports an actuator
  #       doing real work as value-frozen, which is the freshness watchdog being lied to by the very
  #       tool it is watching. `leg:` keeps the two legs' rows distinguishable.
  #       mutant: drop the docker leg's STATE write -> red.
  rm -f "$td/mesh/state"
  dockerfx "$D_ADDR" "$D_SWAL" "$D_OK"
  run "$HEALED" "$HEALED"
  grep -q '^leg: docker' "$td/mesh/state" 2>/dev/null \
    || F "D14: a docker-only heal left the state content unmoved: '$(cat "$td/mesh/state" 2>/dev/null)'"
  dockerfx '' '' 

  # ══ THE MANDATE BLOCK (VSM distributed accountability — Mathis/Heath/Panagiotakopoulos 2026) ═══
  # Every arm below is about a fact the row records ABOUT ITS OWN AUTHORITY, not about the route.

  # (A1) THE DEFECT THIS BLOCK EXISTS FOR: with `mesh-claim` off the PATH the single-writer check
  #      never happened, CLAIM_BLOCK stayed empty, and the write went out with a ledger row BYTE-
  #      IDENTICAL to one that had checked and found the claim free. Cron's PATH is /usr/bin:/bin —
  #      the exact class of defect this tool's own BLIND gate already caught for `mesh-card`.
  #      mutant: default MANDATE to claim-unclaimed when mesh-claim is absent → red.
  rm -f "$td/claim"
  XNL_PATH="$td/bin.noclaim:/usr/bin:/bin"
  mkdir -p "$td/bin.noclaim"; cp "$td/bin"/* "$td/bin.noclaim/" 2>/dev/null; rm -f "$td/bin.noclaim/mesh-claim"
  run "$SWALLOWED" "$HEALED"
  unset XNL_PATH
  applied || F "A1: the healer must still HEAL without mesh-claim — a missing coordination tool is not a reason to leave the LAN dark"
  grep -q 'APPLIED.*mandate=UNCHECKED:no-mesh-claim-on-PATH' "$td/mesh/heal.log" 2>/dev/null \
    || F "A1: a write with NO authority read recorded no such thing: $(grep APPLIED "$td/mesh/heal.log" 2>/dev/null | tail -1)"

  # (A2..A4) the three answers mesh-claim can give that still permit the write must be told APART in
  #      the row, and an answer we do not understand must NEVER be filed as one we do. Without all
  #      three arms one fixture could satisfy the gate while only one branch existed.
  for pair in 'unclaimed: routing|claim-unclaimed' 'yours: routing (held 12s)|claim-mine' 'stale: routing — genome abandoned it (900s)|claim-stale-reclaimable' 'ehwhat|UNCHECKED:unparsed-claim-verdict'; do
    printf '%s\n' "${pair%%|*}" > "$td/claim"
    run "$SWALLOWED" "$HEALED"
    applied || F "A2: '${pair%%|*}' must not block the write (only a live claim held by SOMEONE ELSE does)"
    grep -q "APPLIED.*mandate=${pair##*|}" "$td/mesh/heal.log" 2>/dev/null \
      || F "A2: claim verdict '${pair%%|*}' was not recorded as mandate=${pair##*|}: $(grep APPLIED "$td/mesh/heal.log" 2>/dev/null | tail -1)"
  done
  # ...and the unparsed answer must not have collapsed onto the free one.
  grep -q 'mandate=claim-unclaimed' "$td/mesh/heal.log" && grep -q 'mandate=UNCHECKED:unparsed-claim-verdict' "$td/mesh/heal.log" \
    || F "A2: the free and the unintelligible claim answers render identically — the blind case is wearing the checked one's word"
  # a LIVE claim held by someone else still wins, and now says so in the same vocabulary.
  printf 'theirs: routing — held by health@mesh-home (341s, live)\n' > "$td/claim"
  run "$SWALLOWED" "$HEALED"
  applied && F "A3: wrote to the substrate while ANOTHER mind held the routing claim"
  grep -q 'STOOD-DOWN.*mandate=stood-down' "$td/mesh/heal.log" 2>/dev/null \
    || F "A3: the stand-down row carries no mandate: $(tail -1 "$td/mesh/heal.log" 2>/dev/null)"

  # (A4) EXPIRED IS NOT ABANDONED (mesh-claim task {#b2d997b4}). mesh-claim grew a fourth verdict for
  #      "past TTL, but the owner is measurably LIVE and tending it". It must BLOCK exactly like
  #      theirs — a lapsed clock does not make another mind's routing claim free, and this healer is
  #      single-writer on table 52. Before mesh-claim had the word, this same world rendered 'stale:'
  #      and was filed claim-stale-reclaimable, i.e. the healer would have written THROUGH a live
  #      claim-holder. Its own mandate word, so a stand-down for a live owner and one for an expired
  #      owner are never netted together in the ledger.
  #      mutant: drop the expired:* arm from the mandate case → this goes red (it falls to
  #      UNCHECKED:unparsed-claim-verdict, which does NOT block, and the write lands).
  : > "$td/mesh/heal.log"
  printf 'expired: routing — held by health@mesh-home (7300s), TTL LAPSED but the owner is LIVE\n' > "$td/claim"
  run "$SWALLOWED" "$HEALED"
  applied && F "A4: wrote to the substrate over an EXPIRED claim whose owner mesh-claim measured LIVE — a lapsed TTL is not a free claim"
  grep -q 'STOOD-DOWN.*mandate=stood-down-expired' "$td/mesh/heal.log" 2>/dev/null \
    || F "A4: the expired stand-down carries no distinct mandate — it is indistinguishable from a plain live-owner stand-down: $(tail -1 "$td/mesh/heal.log" 2>/dev/null)"
  grep -q 'mandate=claim-stale-reclaimable' "$td/mesh/heal.log" 2>/dev/null \
    && F "A4: an EXPIRED claim was filed as stale-and-reclaimable — the exact collapse mesh-claim was fixed to end"
  rm -f "$td/claim"

  # (A5) CONTESTABILITY, DRIVEN. An unattended writer on the single-writer substrate whose only
  #      off-switch is editing cron is not contestable. The file must actually STOP the write, must
  #      be LOUD about it (a disarmed healer in front of a live swallow is an incident, not a no-op),
  #      and must be RE-ARMABLE — a disarm that cannot be undone is a worse fault than the one it
  #      guards.  mutant: ignore $OFF_SWITCH in commit_throw → red on the first assert.
  : > "$td/off"
  run "$SWALLOWED" "$HEALED"
  applied && F "A5: the off-switch did not stop the write — a contest handle that does nothing is worse than none: $(cat "$td/ip.cmds")"
  grep -q 'REVOKED' "$td/mesh/heal.log" 2>/dev/null || F "A5: a disarmed healer declining in front of a LIVE swallow left no row: $(tail -1 "$td/mesh/heal.log" 2>/dev/null)"
  case "$OUT" in *"$td/off"*) ;; *) F "A5: the REVOKED message does not name the file a human must remove: $OUT" ;; esac
  rm -f "$td/off"
  run "$SWALLOWED" "$HEALED"
  applied || F "A5: the healer did NOT re-arm after the off-switch was removed — the disarm is a latch, not a switch"

  # (A6) THE ROW IS STILL PARSED BY POSITION. CLAUDE.local.md quotes the LAN `APPLIED` count as the
  #      uplink wipe rate, and the counters key on $2. Appending mandate/contest must not move it.
  #      mutant: put mandate= before the verb → red here and in the D12 rate arms above.
  : > "$td/mesh/heal.log"
  run "$SWALLOWED" "$HEALED"
  [ "$(awk '$2=="APPLIED"{n++} END{print n+0}' "$td/mesh/heal.log")" = 1 ] \
    || F "A6: the new trailing fields moved the verb out of field 2 — every rate this file publishes would change meaning: $(cat "$td/mesh/heal.log")"
  grep -q 'contest=stop:.*|hold:mesh-claim/routing|policy:genome/scripts/' "$td/mesh/heal.log" 2>/dev/null \
    || F "A6: an application recorded no contest handle — the reader cannot find out how to overturn it: $(tail -1 "$td/mesh/heal.log")"

  # (A7) the READER. A field nobody can ask for is a field nobody reads, and --mandate is the answer
  #      to "who authorized this and how do I stop it" without opening the source.
  run "$HEALED" "$HEALED" --mandate
  case "$OUT" in *'mandate:'*'off-switch:'*'who-can-contest:'*'policy-level:'*) ;; *) F "A7: --mandate did not render the accountability block: $OUT" ;; esac
  case "$OUT" in *"$td/off"*) ;; *) F "A7: --mandate does not name the live off-switch path: $OUT" ;; esac
  applied && F "A7: --mandate WROTE something — it is a reader"

  [ "$fails" = 0 ] && echo "smoke-test: ok (applies EXACTLY one throw for our own LAN prefix and is loud about the rate; writes nothing when the FIB is healthy; refuses a foreign/public/zero prefix, a missing or placeholder table, and main/local/default; EEXIST is PRESENT not an application, so the re-apply rate stays a real dongle-fault measurement; a write whose re-asked FIB is still swallowed exits non-zero; a blocked sudo fails loudly instead of skipping; stands down for ANOTHER mind's routing claim but not its own; --check never writes; and a mesh-card without the leg reads BLIND, never all-clear; + an EXPIRED claim (past TTL, owner measurably LIVE) BLOCKS the write exactly like theirs and carries its OWN mandate word, so a lapsed clock can never be filed as a reclaimable claim; + the tape is NOT the log mesh-autowire redirects cron stdout into and an unstamped 'APPLIED' line cannot inflate the rate; + the no-op path is silent on a non-tty, because this fires 1440x/day into an appended log; + it finds mesh-card under CRON's own /usr/bin:/bin PATH, the defect its own BLIND gate caught in production 5 minutes after wiring; + a BLIND rc=127 names PATH/cron and NEVER the deploy, which is a different ring; + THE DOCKER-BRIDGE LEG: a swallowed bridge is healed even when the LAN reads ok (the early return that hid it), the prefix is read off the link so a custom --bip gets its OWN net, the probe target is never our own 172.17.0.1 (rule 0 answers that green through the fault) and the verify reads the FIB's DEVICE and NEVER pings, a still-swallowed bridge after the write exits non-zero, a node with no docker0 skips silently but SAYS why under --check, the same net/table gates and the same routing claim cover both legs, a swallower not named tailscale0 is still caught (the polarity is 'is it on the bridge', not an allowlist of swallowers), and the two legs keep SEPARATE ledger verbs so the docker leg cannot inflate the LAN re-apply rate CLAUDE.local.md quotes as the uplink wipe rate; + THE RESCUE LEG: the exit node's OWN public endpoint, excepted so the off-tailnet path a hand would rescue it over stops riding the tunnel whose far end IS that machine; the endpoint is read LIVE off the peer's CurAddr so a re-homed node moves with it, the guard's polarity is the OPPOSITE of the LAN leg's (a PUBLIC /32, never RFC1918, never one of ours), the healthy device is the main table's own default route rather than the name tailscale0, a DERP-relayed peer and a node with no default route render na instead of guessing, the :22 reachability read is CORROBORATION and provably not the gate (a heal with nothing answering is still an APPLIED), and it carries its OWN verb APPLIED-RESCUE so it cannot inflate the LAN wipe rate either; + THE MANDATE BLOCK: every write-path row records the AUTHORITY it was written under and the handle that overturns it — a missing mesh-claim on cron's PATH is now UNCHECKED and can no longer wear a checked-and-free row's word, the three permitting claim verdicts are told apart and an unintelligible one is never filed as a free one, the off-switch FILE (never an env var cron cannot see) actually stops the write, says which file to remove, and re-arms, the verb stays in field 2 so every published rate keeps its meaning, and --mandate answers 'who authorized this and how do I stop it' without opening the source)"
  exit "$fails"
fi

# applications recorded in the last <secs>, for ONE tape verb. The RATE is the point of this tool's
# tape: a heal that fires more often is reporting a dongle that faults more often, and that must not
# be smoothed.
#
# WHY THE VERB IS A PARAMETER AND WHY IT MATCHES ON FIELD 2. The published number — quoted in
# CLAUDE.local.md as the exit-node wipe rate, and the thing the trace calls "the uplink fault rate" —
# has always counted LAN re-applications. The docker-bridge leg added below writes its own line for
# the SAME reconverge, so a substring `/APPLIED/` would have silently doubled that statistic the day
# this leg landed: one wipe, two rows, a rate that reads as a dongle degrading when nothing changed
# but our own instrumentation. Never redefine a number a reader already quotes. `$2 == verb` keeps
# APPLIED meaning exactly what it meant, gives APPLIED-DOCKER its own count, and is STRICTER than
# the old regex against the cron-stdout collision T12 guards (a line that does not start with a
# timestamp still cannot be a ledger entry).
applied_since(){
  local secs="$1" verb="${2:-APPLIED}" cutoff
  cutoff=$(date -u -d "@$(( $(date -u +%s) - secs ))" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null) || return 0
  [ -s "$LOG" ] || { echo 0; return 0; }
  awk -v c="$cutoff" -v v="$verb" '$1 ~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T/ && $1 >= c && $2 == v {n++} END{print n+0}' "$LOG"
}

# ── gate: is <net> a prefix this tool is allowed to install a throw for? ────────────────────────
# PURE (net + our own cidr in, verdict out) so --test drives it with fixtures. Refuses rather than
# trusts: the probe is a reader of a table tailscaled owns, and a healer that installs whatever
# prefix it is handed is one bad answer away from throwing away a route it needs.
#   - must be RFC1918 (this is a LAN exclusion; nothing else belongs in it)
#   - must CONTAIN this node's own live address (that is what "our own LAN" means, and it is read
#     from the link, never from a config that can age out)
#   - prefix must be /8../30 (a /31,/32 is not a LAN; a /0../7 is a route to the world)
#
# THE DOCKER LEG GOES THROUGH THIS UNCHANGED — that is the whole reason it was safe to add. A
# docker bridge is RFC1918 by construction, its /16 (or a custom `bip`'s /24) sits inside /8../30,
# and the address checked against it is docker0's OWN live address read from the link. The second
# net is a second SUBJECT through the same gate chain, not a loosened gate.
net_allowed(){
  python3 - "${1:-}" "${2:-}" <<'PY'
import ipaddress, sys
net, own = (sys.argv[1] or ''), (sys.argv[2] or '')
def die(m): print(m); sys.exit(1)
if not net: die("no net in the probe answer")
try: n = ipaddress.ip_network(net, strict=True)
except Exception: die("net %r is not a network" % net)
if n.version != 4: die("net %s is not IPv4" % net)
if not (8 <= n.prefixlen <= 30): die("net %s has prefixlen /%d — outside /8../30" % (net, n.prefixlen))
if not n.is_private: die("net %s is not RFC1918 — this installs LAN exclusions only" % net)
if not own: die("this node has no readable LAN address to check %s against" % net)
try: a = ipaddress.ip_interface(own).ip
except Exception: die("own address %r unparseable" % own)
if a not in n: die("net %s does not contain this node's own address %s" % (net, a))
print("ok")
PY
}

# ── gate: is <table> a table this tool is allowed to write? ────────────────────────────────────
# The throw belongs in the exit-node's OWN table. main/local/default (254/255/253) carry this
# node's real routing, and a throw installed there would blackhole the LAN instead of freeing it.
table_allowed(){
  case "${1:-}" in
    '')                    echo "no table in the probe answer"; return 1 ;;
    '<t>')                 echo "the probe could not read a table (rendered the placeholder)"; return 1 ;;
    main|local|default|254|255|253|0)
                           echo "table '$1' carries this node's real routing — refusing"; return 1 ;;
    *[!a-zA-Z0-9_-]*)      echo "table '$1' is not a plausible table name"; return 1 ;;
    *)                     echo ok ;;
  esac
}

# ── pick a NON-LOCAL address inside <cidr> to ask the FIB about ────────────────────────────────
# Prints "<target> <net>", or nothing when the prefix holds no third address.
#
# NEVER OUR OWN ADDRESS. `ip rule` 0 sends a lookup for a local address to table `local`, which
# answers `local <a> dev lo` no matter how completely the exit node has swallowed the prefix — so a
# probe aimed at ourselves is green through a live fault. Measured on this node the same day this
# leg was written: `ip route get 172.17.0.1` -> `local ... dev lo table local` while
# `ip route get 172.17.0.2` -> `dev tailscale0 table 52`. Same trap mesh-card's LAN probe carries,
# and the docker bridge walks straight into it because our own address is the FIRST address in the
# prefix (172.17.0.1), i.e. exactly the one a naive picker would choose.
#
# This MIRRORS mesh-card's `lan_probe_target` deliberately rather than calling it: mesh-card exposes
# no entry point for the helper alone, and a `--refresh` is the wrong price and the wrong shape for
# a per-minute reflex (the header says why). Keep the two in step if either changes.
probe_target(){
  [ -n "${1:-}" ] || return 0
  python3 - "$1" <<'PY' 2>/dev/null
import ipaddress, sys
try: iface = ipaddress.ip_interface(sys.argv[1])
except Exception: sys.exit()
net = iface.network
if net.prefixlen >= 31: sys.exit()   # /31,/32 hold no third address to probe with
for cand in (net.network_address + 1, net.network_address + 2):
    if cand != iface.ip and cand in net:
        print(cand, net); break
PY
}

# ── the DOCKER-BRIDGE leg: probe ───────────────────────────────────────────────────────────────
#
# WHY A SECOND NET AT ALL. tailscaled authors FOUR throws into its table at boot — the LAN,
# 127.0.0.0/8, 172.17.0.0/16 and fe80::/64 — and a netmap reconverge deletes all four while the
# healer restored only the first. Measured on mesh-home 2026-08-26 with the other three gone:
#   ip route get 172.17.0.2  -> dev tailscale0 table 52     SWALLOWED, and nothing re-applied it
#   ip route get 127.0.0.5   -> local ... dev lo table local  rule 0 / table `local` answers first
#   ip route get fe80::1 dev docker0 -> dev docker0 proto kernel  link-local is per-device by scope
# So of the three unrestored throws exactly ONE has a consumer. 127.0.0.0/8 and fe80::/64 are
# VACUOUS in table 52 — the kernel resolves both before the exit-node rule is ever consulted — and
# restoring them would be motion that measures nothing, so this leg deliberately does NOT. The
# honest target is two throws, not four, and that is a measurement, not an assumption.
#
# WHAT BREAKS WITHOUT IT. Anything on this node reaching a container by address — a health probe, a
# registry pull, a compose service talking to a sibling — leaves via tailscale0 to the exit node,
# which has never heard of 172.17.0.0/16. Identical outward symptom to the LAN swallow: every
# egress probe stays perfect while the inward path is dead.
DOCKER_DEV="${MESH_XNL_DOCKER_DEV:-docker0}"

# docker_probe -> key: value lines, rc always 0 (the STATE says which, never the rc — an rc cannot
# separate "no docker on this node" from "the bridge is fine").
#   state: absent  — no bridge here. The clean skip: most nodes in this mesh run no docker.
#   state: na      — a bridge with a prefix too small to probe. Honest blind, never an all-clear.
#   state: ok      — a non-local address in the bridge prefix routes out of the bridge.
#   state: swallowed — it routes anywhere else.
#
# THE PREFIX IS DERIVED FROM THE LINK, NEVER A CONSTANT. `172.17` is only docker's default; a
# daemon started with `--bip 10.99.0.1/24` (or a `default-address-pools` config) puts the bridge
# somewhere else entirely, and a hardcoded prefix would then install a throw for a network this
# node does not have while the real bridge stayed swallowed — a healer running green over a live
# fault, which is the failure this whole tool exists to end.
#
# THE POLARITY IS "IS IT ON THE BRIDGE", NOT "IS IT ON A SWALLOWER". An allowlist of devices that
# count as swallowing (tailscale0, wg*, ...) fails toward SILENCE: the first overlay whose name is
# not on the list renders a live swallow as healthy. The bridge prefix has exactly one correct
# answer — its own device — so gate on what the FIB SHOULD say and let everything else be loud.
docker_probe(){
  local cidr target net route dev table
  cidr=$(ip -o -4 addr show dev "$DOCKER_DEV" scope global 2>/dev/null | awk '{print $4}' | head -1)
  if [ -z "${cidr:-}" ]; then
    echo "state: absent"
    echo "reason: no global IPv4 address on '$DOCKER_DEV' — no docker bridge on this node, so there is no bridge prefix for an exit node to swallow"
    return 0
  fi
  read -r target net <<<"$(probe_target "$cidr")"
  if [ -z "${target:-}" ] || [ -z "${net:-}" ]; then
    echo "state: na"; echo "own-cidr: $cidr"
    echo "reason: '$DOCKER_DEV' carries $cidr, which holds no address other than our own to ask the FIB about"
    return 0
  fi
  route=$(ip route get "$target" 2>/dev/null | head -1)
  dev=$(printf '%s\n' "$route"   | grep -oP '\bdev \K\S+'   | head -1)
  table=$(printf '%s\n' "$route" | grep -oP '\btable \K\S+' | head -1)
  echo "own-cidr: $cidr"; echo "target: $target"; echo "net: $net"
  echo "dev: ${dev:-}"; echo "table: ${table:-}"
  if [ -z "${route:-}" ] || [ -z "${dev:-}" ]; then
    echo "state: na"
    echo "reason: FIB lookup for $target returned no device (answer: ${route:-<empty>})"
    return 0
  fi
  if [ "$dev" = "$DOCKER_DEV" ]; then
    echo "state: ok"; echo "reason: $target -> dev $dev"
  else
    echo "state: swallowed"
    echo "reason: $target routes via dev $dev${table:+ table $table}, not the bridge — containers are unreachable by address from this node"
  fi
  return 0
}

DRY=0; [ "${1:-}" = --check ] && DRY=1

# liveness is ran-live, not value-changed (the conditional-write convention): touch on EVERY
# successful eval, and let the content below be written only when there is something to say.
touch_state(){ command -v mesh-state-touch >/dev/null 2>&1 && mesh-state-touch --create "$STATE" >/dev/null 2>&1 || touch "$STATE" 2>/dev/null || true; }

# ── single-writer: ONE claim read for BOTH legs ────────────────────────────────────────────────
# Hoisted out of the LAN leg so the docker leg cannot write over a mind the LAN leg just stood down
# for. Stand down for a live claim held by SOMEONE ELSE; never take one (the header says why).
#
# ── THE MANDATE (VSM distributed accountability) ───────────────────────────────────────────────
# Every row this tool writes to its ledger records WHAT it did. Until now none of them recorded
# under WHAT AUTHORITY, and the two are different facts. This is an unattended process that writes
# to the single-writer substrate once a minute; when the LAN comes back, "which hand did that" is a
# chain — a FIB probe, a classifier, this reflex, a cron line — and asking after the fact for "the
# responsible agent" misreads the chain. The specific defect the field below closes: `mesh-claim`
# missing from cron's own PATH left CLAIM_BLOCK empty, so a write that CHECKED the routing claim and
# found it free and a write that never checked at all produced BYTE-IDENTICAL ledger rows. This tool
# already learned that lesson on its other dependency — a missing `mesh-card` renders BLIND, never
# all-clear — and had not applied it here. `mandate=` is that same polarity for the authority read:
# the blind case gets its own word and may never wear the checked one's.
#
# `contest=` is the other half, and it is the one an audit log structurally cannot supply: it names
# the handle a human or another mind uses to OVERTURN this decision, carried in the record itself
# rather than left to be reconstructed from the source. Both fields go at the END of the row —
# field 1 is the stamp and field 2 the verb, and the rate counters key on $2 by position.
CLAIM_BLOCK=""; MANDATE=""; CLAIM_SAID=""
if ! command -v mesh-claim >/dev/null 2>&1; then
  MANDATE="UNCHECKED:no-mesh-claim-on-PATH"
else
  CLAIM_SAID="$(mesh-claim --check "$CLAIM_KEY" 2>/dev/null)"
  case "$CLAIM_SAID" in
    theirs:*)    CLAIM_BLOCK="$CLAIM_SAID"; MANDATE="stood-down" ;;
    # expired: past TTL, but mesh-claim measured the owner LIVE and tending it (task {#b2d997b4}).
    # It BLOCKS exactly like theirs — a lapsed clock does not make another mind's routing claim free,
    # and this healer is single-writer on table 52. Before mesh-claim grew the word this rendered
    # 'stale:' and was filed claim-stale-reclaimable, i.e. the healer would have written THROUGH a
    # live claim-holder. Its own word so the two are never netted in the ledger.
    expired:*)   CLAIM_BLOCK="$CLAIM_SAID"; MANDATE="stood-down-expired" ;;
    yours:*)     MANDATE="claim-mine" ;;
    unclaimed:*) MANDATE="claim-unclaimed" ;;
    stale:*)     MANDATE="claim-stale-reclaimable" ;;
    # anything else is mesh-claim ANSWERING SOMETHING WE DO NOT UNDERSTAND (empty, an error, a
    # renamed verdict). It is not "free". No spaces in the value: the row is parsed by position.
    *)           MANDATE="UNCHECKED:unparsed-claim-verdict" ;;
  esac
fi
REVOKED=""; [ -f "$OFF_SWITCH" ] && { REVOKED="$OFF_SWITCH"; MANDATE="revoked-by-off-switch"; }
CONTEST="contest=stop:$OFF_SWITCH|hold:mesh-claim/$CLAIM_KEY|policy:genome/scripts/$(basename "$0")"

# ── --mandate: the reader. A field nobody can ask for is a field nobody reads ──────────────────
if [ "${1:-}" = --mandate ]; then
  printf 'mandate: %s\n' "$MANDATE"
  printf 'claim-key: %s\n' "$CLAIM_KEY"
  printf 'claim-verdict: %s\n' "${CLAIM_SAID:-<mesh-claim not on PATH — the authority read did not happen>}"
  printf 'off-switch: %s (%s)\n' "$OFF_SWITCH" "$([ -f "$OFF_SWITCH" ] && echo 'present — DISARMED, a swallowed LAN will STAND' || echo 'absent — armed')"
  printf '%s\n' "$CONTEST"
  printf 'who-can-contest: any hand on this node (touch/rm the off-switch above, no privilege needed) or any mind holding the '"'"'%s'"'"' claim, which this tool stands down for and never takes.\n' "$CLAIM_KEY"
  printf 'policy-level: this node revises the INSTANCE (the off-switch, MESH_XNL_* env). The RULE — which prefixes are admissible, which tables are refused, the claim key — is revised in the genome at scripts/%s and deployed; changing it here would be reverted by mesh-sync-tools.\n' "$(basename "$0")"
  exit 0
fi

# ── the shared write: gates, claim, sudo, verb ─────────────────────────────────────────────────
# ONE definition of "install a throw", so the two legs cannot drift into two different ideas of what
# is allowed. Sets $VERB to APPLIED|PRESENT on success. rc: 0 wrote/present, 1 refused-or-failed,
# 3 stood down for another writer, 4 dry run.
# <net> <table> <own-cidr> <tape-verb-on-apply> <human-label>
commit_throw(){
  # $6 = the prefix guard to apply, because the legs do not share one. The LAN and docker legs
  # demand an RFC1918 prefix CONTAINING our own address; the rescue leg demands the exact opposite —
  # a PUBLIC /32 that is emphatically not ours. One guard covering both would have to admit the
  # union, which is every address there is.
  local net="$1" table="$2" own="$3" averb="$4" label="$5" guard="${6:-net_allowed}" g out arc
  g="$("$guard" "$net" "$own")"      || { say "exit-node-lan-heal: REFUSING ($label) — $g"; tape "REFUSED net=$net own=$own: $g"; trace "[exit-node-lan-heal] REFUSED on $(hostname) ($label): $g"; return 1; }
  g="$(table_allowed "$table")"      || { say "exit-node-lan-heal: REFUSING ($label) — $g"; tape "REFUSED table=$table: $g"; trace "[exit-node-lan-heal] REFUSED on $(hostname) ($label): $g"; return 1; }
  if [ "$DRY" = 1 ]; then
    say "exit-node-lan-heal: WOULD APPLY  ip route add throw $net table $table   ($label)"
    say "exit-node-lan-heal:   mandate=$MANDATE  $CONTEST"
    return 4
  fi
  # THE OFF-SWITCH IS CHECKED HERE, not at the top of the pass, and that placement is the point: a
  # disarmed healer over a HEALTHY FIB has nothing to say, but a disarmed healer standing in front of
  # a live swallow is an incident and must be loud every time it declines. Same shape as STOOD-DOWN.
  if [ -n "$REVOKED" ]; then
    say "exit-node-lan-heal: REVOKED ($label) — the off-switch $REVOKED exists, so this healer is DISARMED and the fault will STAND. Remove that file to re-arm."
    tape "REVOKED off=$REVOKED net=$net table=$table mandate=$MANDATE $CONTEST"
    return 3
  fi
  if [ -n "$CLAIM_BLOCK" ]; then
    say "exit-node-lan-heal: standing down ($label) — $CLAIM_BLOCK"; tape "STOOD-DOWN $CLAIM_BLOCK mandate=$MANDATE $CONTEST"; return 3
  fi
  out="$(sudo -n ip route add throw "$net" table "$table" 2>&1)"; arc=$?
  case "$arc:$out" in
    0:*)  VERB="$averb" ;;
    *"File exists"*) VERB=PRESENT ;;   # idempotent: EEXIST is not an application, and must not be
                                       # counted as one or the re-apply RATE becomes fiction
    *)    say "exit-node-lan-heal: APPLY FAILED ($label, rc=$arc) — $out"
          tape "FAILED rc=$arc net=$net table=$table: $out"
          trace "[exit-node-lan-heal] APPLY FAILED on $(hostname) ($label): ip route add throw $net table $table -> rc=$arc $out"
          return 1 ;;
  esac
  return 0
}

# ── the board post: throttled, and it carries what the throttle ate ────────────────────────────
board_post(){
  local msg="$1" now last since sup_n sup_txt BSTAMP
  BSTAMP="$MESH_DIR/.exit-node-lan-heal.board"
  now=$(date -u +%s); last=0; [ -s "$BSTAMP" ] && last=$(cat "$BSTAMP" 2>/dev/null || echo 0)
  case "$last" in ''|*[!0-9]*) last=0 ;; esac
  [ $(( now - last )) -ge "$BOARD_MIN_GAP" ] || return 0
  command -v mesh-chat >/dev/null 2>&1 || return 0
  sup_txt=""
  if [ "$last" -gt 0 ]; then
    since=$(date -u -d "@$last" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)
    sup_n=$(awk -v c="$since" '$1 ~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T/ && $1 > c && ($2 == "APPLIED" || $2 == "APPLIED-DOCKER") {n++} END{print n+0}' "$LOG" 2>/dev/null || echo 0)
    sup_n=$(( sup_n > 0 ? sup_n - 1 : 0 ))   # minus this one — the rest are what the throttle ate
    [ "$sup_n" -gt 0 ] && sup_txt=", plus $sup_n further application(s) the board throttle suppressed since the last post"
  fi
  mesh-chat "$msg$sup_txt" >/dev/null 2>&1 || true
  echo "$now" > "$BSTAMP" 2>/dev/null || true
}

# ══ LEG 1: the LAN ═════════════════════════════════════════════════════════════════════════════
lan_leg(){
  local kv prc state net table own xnode target vkv vrc vstate png n1h n24
  VERB=""
  kv="$(mesh-card --exit-node-lan 2>/dev/null)"; prc=$?
  state="$(printf '%s\n' "$kv" | sed -n 's/^state: //p')"
  if [ -z "$state" ]; then
    # BLIND, and it must never look like health. A deployed mesh-card without the --exit-node-lan
    # leg answers nothing here, and a silent skip would render this reflex green forever.
    # NAME THE RIGHT RING. rc=127 is the shell's command-not-found and can NEVER mean an
    # unrecognised flag, so "deploy the mesh-card that carries the leg" would send the fixer to
    # redeploy a tool that is already byte-identical while the real fault is one ring out, in the
    # ENVIRONMENT. Measured 2026-08-21: 20 of the first 21 cron fires were rc=127 under
    # /usr/bin:/bin, and the message named the wrong cause every one of them. A fallback whose
    # message misdiagnoses is the plausible-constant failure wearing a diagnosis.
    local hint
    if [ "$prc" = 127 ]; then hint="mesh-card NOT ON PATH (cron?) — PATH=$PATH"
    else hint="Deploy the mesh-card that carries the leg."; fi
    say "exit-node-lan-heal: BLIND — 'mesh-card --exit-node-lan' returned no state (rc=$prc). $hint"
    tape "BLIND mesh-card --exit-node-lan rc=$prc no-state"
    trace "[exit-node-lan-heal] BLIND on $(hostname): mesh-card --exit-node-lan gave no state (rc=$prc) — the re-application leg cannot see the FIB"
    return 1
  fi
  net="$(printf '%s\n' "$kv"   | sed -n 's/^net: //p')"
  table="$(printf '%s\n' "$kv" | sed -n 's/^table: //p')"
  own="$(printf '%s\n' "$kv"   | sed -n 's/^own-cidr: //p')"
  xnode="$(printf '%s\n' "$kv" | sed -n 's/^exit-node: //p')"
  target="$(printf '%s\n' "$kv"| sed -n 's/^target: //p')"

  if [ "$state" != swallowed ]; then
    quiet "exit-node-lan-heal: nothing to do (LAN) — $state ($(printf '%s\n' "$kv" | sed -n 's/^verdict: //p'))"
    return 0
  fi

  commit_throw "$net" "$table" "$own" APPLIED "LAN $target swallowed by exit-node '$xnode'"
  case $? in 4) return 0 ;; 3) return 0 ;; 1) return 1 ;; esac

  # ── VERIFY by re-asking the FIB (never the pref, never mesh-lan-presence) ────────────────────
  vkv="$(mesh-card --exit-node-lan 2>/dev/null)"; vrc=$?
  vstate="$(printf '%s\n' "$vkv" | sed -n 's/^state: //p')"
  # corroboration only, and rendered `na` when it cannot be asked — a ping that cannot run must never
  # read as a ping that failed, nor as one that passed.
  if command -v ping >/dev/null 2>&1 && [ -n "$target" ]; then
    ping -c1 -W2 "$target" >/dev/null 2>&1 && png="ping $target ok" || png="ping $target FAILED"
  else png="ping na"; fi

  if [ "$vstate" != ok ]; then
    say "exit-node-lan-heal: WROTE THE ROUTE AND THE FAULT REMAINS — post-verify state=$vstate rc=$vrc ($png)"
    tape "UNHEALED $VERB net=$net table=$table post-state=$vstate $png mandate=$MANDATE $CONTEST"
    trace "[exit-node-lan-heal] UNHEALED on $(hostname): installed throw $net table $table, FIB still says $vstate — $png"
    return 1
  fi

  [ "$VERB" = PRESENT ] && { say "exit-node-lan-heal: route already present (LAN), FIB now ok (nothing applied)"; tape "PRESENT net=$net table=$table $png"; return 0; }

  # tape FIRST, then count — so every rate below includes this application and no reader has to
  # remember an off-by-one. The tape is the ledger; the counts are derived from it, never beside it.
  tape "APPLIED throw $net table $table exit-node=$xnode $png mandate=$MANDATE $CONTEST"
  n1h=$(applied_since 3600); n24=$(applied_since 86400)
  # every application, unthrottled — the trace is where the RATE lives
  trace "[exit-node-lan-heal] APPLIED on $(hostname): ip route add throw $net table $table (exit-node '$xnode' had swallowed $target) — $png; re-applications: $n1h in 1h, $n24 in 24h. Each one is a tailscaled netmap reconverge, i.e. a link flap on the sole uplink. mandate=$MANDATE; $CONTEST"
  say "exit-node-lan-heal: APPLIED throw $net table $table — LAN sight restored ($png); $n24 re-application(s) in 24h"
  printf 'last-applied: %s\nleg: lan\nnet: %s\ntable: %s\nexit-node: %s\n' "$(ts)" "$net" "$table" "$xnode" > "$STATE" 2>/dev/null || true
  # the board gets the RATE, not every event: throttled, and the post carries how many it suppressed,
  # so a flood of re-applications is still legible as a flood without becoming one on the board.
  board_post "[fyi] exit-node-lan-heal@$(hostname): re-installed 'throw $net table $table' — exit-node '$xnode' had swallowed the LAN again ($png). $n1h in 1h, $n24 in 24h. The wipe is a tailscaled netmap reconverge after a link flap, so this rate IS the uplink fault rate — not a node that heals itself for free."
  return 0
}

# ══ LEG 2: the docker bridge ═══════════════════════════════════════════════════════════════════
docker_leg(){
  local kv state net table own target reason vroute vdev n24
  VERB=""
  kv="$(docker_probe)"
  state="$(printf '%s\n'  "$kv" | sed -n 's/^state: //p')"
  reason="$(printf '%s\n' "$kv" | sed -n 's/^reason: //p')"
  case "$state" in
    absent|na)
      # A CLEAN SKIP, and it SAYS why — but through quiet(), not say(). This fires 1440x/day from
      # cron into an appended log, and most nodes in this mesh have no docker at all: a per-minute
      # "no docker0 here" is 1440 daily lines that bury the events the tape exists to show. A human
      # at a tty, or asking --check, or setting MESH_XNL_VERBOSE=1, still gets the sentence.
      quiet "exit-node-lan-heal: nothing to do (docker) — $state: $reason"
      return 0 ;;
    ok)
      quiet "exit-node-lan-heal: nothing to do (docker) — $reason"
      return 0 ;;
  esac

  net="$(printf '%s\n'   "$kv" | sed -n 's/^net: //p')"
  table="$(printf '%s\n' "$kv" | sed -n 's/^table: //p')"
  own="$(printf '%s\n'   "$kv" | sed -n 's/^own-cidr: //p')"
  target="$(printf '%s\n' "$kv"| sed -n 's/^target: //p')"

  commit_throw "$net" "$table" "$own" APPLIED-DOCKER "docker bridge $net swallowed — $reason"
  case $? in 4) return 0 ;; 3) return 0 ;; 1) return 1 ;; esac

  # ── VERIFY: re-ask the FIB and read the DEVICE. NEVER a ping. ────────────────────────────────
  # There is nothing to ping: the only address guaranteed to exist in this prefix is docker0's own,
  # and `ip rule` 0 answers a lookup for OUR OWN address out of table `local` (`dev lo`) whether or
  # not the exit node has swallowed the prefix — so a ping of 172.17.0.1 replies from the loopback
  # and reads green straight through a live fault. Measured on this node 2026-08-26. Containers may
  # or may not be running, so any other address is a coin flip. The artifact is the FIB answer's
  # DEVICE for a non-local address, which is exactly the fact the fault is about.
  vroute="$(ip route get "$target" 2>/dev/null | head -1)"
  vdev="$(printf '%s\n' "$vroute" | grep -oP '\bdev \K\S+' | head -1)"
  if [ "${vdev:-}" != "$DOCKER_DEV" ]; then
    say "exit-node-lan-heal: WROTE THE ROUTE AND THE DOCKER FAULT REMAINS — $target still routes via dev ${vdev:-<none>} (answer: ${vroute:-<empty>})"
    tape "UNHEALED $VERB net=$net table=$table post-dev=${vdev:-none} mandate=$MANDATE $CONTEST"
    trace "[exit-node-lan-heal] UNHEALED on $(hostname): installed throw $net table $table, $target still routes via dev ${vdev:-none} — the docker bridge is still swallowed"
    return 1
  fi

  [ "$VERB" = PRESENT ] && { say "exit-node-lan-heal: docker throw already present, FIB now ok (nothing applied)"; tape "PRESENT net=$net table=$table dev=$vdev"; return 0; }

  tape "APPLIED-DOCKER throw $net table $table dev=$vdev mandate=$MANDATE $CONTEST"
  n24=$(applied_since 86400 APPLIED-DOCKER)
  trace "[exit-node-lan-heal] APPLIED-DOCKER on $(hostname): ip route add throw $net table $table — the exit node had swallowed the docker bridge ($reason); $target now routes via dev $vdev. $n24 docker re-application(s) in 24h. Same tailscaled netmap reconverge that eats the LAN throw eats this one. mandate=$MANDATE; $CONTEST"
  say "exit-node-lan-heal: APPLIED throw $net table $table — docker bridge reachable again ($target -> dev $vdev); $n24 docker re-application(s) in 24h"
  # Write the STATE from this leg too. mesh-reflex-health watches this file's CONTENT as one of its
  # axes, and a docker-only heal that left the content frozen would report a reflex that had just
  # done real work as value-frozen — an actuator firing while its own freshness axis says nothing
  # moved. `leg:` says which throw the row is about, so the two cannot be read as one.
  printf 'last-applied: %s\nleg: docker\nnet: %s\ntable: %s\ndev: %s\n' "$(ts)" "$net" "$table" "$vdev" > "$STATE" 2>/dev/null || true
  board_post "[fyi] exit-node-lan-heal@$(hostname): re-installed 'throw $net table $table' — the exit node had swallowed the DOCKER BRIDGE ($target routed via the tunnel, so nothing on this node could reach a container by address while every egress probe stayed green). $n24 docker re-application(s) in 24h. tailscaled authors this throw at boot and drops it on a netmap reconverge, exactly like the LAN one."
  return 0
}

# ── the RESCUE leg ─────────────────────────────────────────────────────────────────────────────
# WHY A THIRD LEG. Measured 2026-08-27T17:41Z on this node: `ip route get 38.49.216.141` answered
# `dev tailscale0 table 52 src 100.81.222.19`. That address is the EXIT NODE'S OWN PUBLIC ENDPOINT —
# the off-tailnet address a hand would rescue it over — and it was riding the exit-node tunnel whose
# far end IS that same machine. So during phaedra's 02:08:41Z->16:28:29Z cut-off the rescue path died
# in the same blackhole as the thing it was rescuing, and recovery had to come from another machine
# entirely. An out-of-band path that is routed in-band is not an out-of-band path.
#
# THE PREFIX IS READ LIVE, NEVER A CONSTANT. It comes from the exit node's own CurAddr in
# `tailscale status --json` — the endpoint magicsock is actually using. Hardcoding 38.49.216.141
# would be writing another node's address into our genome, and a re-created or re-homed peer moves
# it; the throw would then except an address nobody is at while the real rescue path stayed
# swallowed. Same lesson as reading the docker bridge off docker0 instead of assuming 172.17.
#
# ITS OWN LEDGER VERB. APPLIED-RESCUE, never APPLIED. This node quotes the LAN re-apply count as a
# floor on the uplink wipe rate; a leg that fires on the SAME reconverge and shared the verb would
# silently double that number, and the fabricated half would read as a dongle degrading.
#
# THE DISCRIMINATOR IS THE DEVICE, AND ONLY THE DEVICE. The reachability check below is corroboration
# and is labelled as such everywhere it is printed: a TCP answer from the endpoint proves a live
# sshd, NOT that the packet left by the uplink — while the exit node is healthy the tunnel delivers
# :22 too, so a green banner is exactly as available through the fault as around it. It is recorded
# because a restored path that nothing answers on is worth seeing; it must never become the gate.
rescue_allowed(){
  python3 - "${1:-}" "${2:-}" <<'RESCUEPY'
import ipaddress, sys
net, own = (sys.argv[1] or ''), (sys.argv[2] or '')
def die(m): print(m); sys.exit(1)
if not net: die("no endpoint in the probe answer")
try: n = ipaddress.ip_network(net, strict=True)
except Exception: die("endpoint %r is not a network" % net)
if n.version != 4: die("endpoint %s is not IPv4 — this leg installs v4 exceptions only" % net)
if n.prefixlen != 32:
    die("endpoint %s is /%d, not /32 — this leg excepts ONE host address, never a range" % (net, n.prefixlen))
a = n.network_address
if a.is_private or a.is_loopback or a.is_link_local or a.is_multicast or a.is_reserved or a.is_unspecified:
    die("endpoint %s is not a public unicast address — there is no off-tailnet rescue path to except here" % a)
for line in (own or '').split():
    try:
        if ipaddress.ip_interface(line).ip == a:
            die("endpoint %s is one of THIS node's own addresses — the FIB answers that locally whatever table 52 says, so excepting it would measure nothing" % a)
    except Exception:
        pass
print("ok")
RESCUEPY
}

# Reachability CORROBORATION only (see the block above). Reads the SSH banner off the endpoint with
# bash's own /dev/tcp — no ssh binary, no user to guess, no key; and an auth failure would be a
# reachability SUCCESS anyway, so authentication is not part of the question being asked.
rescue_reach(){
  local ip="$1" b
  b="$(timeout 6 bash -c 'exec 3<>/dev/tcp/'"$ip"'/22 2>/dev/null && head -c 40 <&3' 2>/dev/null)"
  case "$b" in
    SSH-*) printf 'sshd answered (%s)' "$(printf '%s' "$b" | tr -d '\r\n' | cut -c1-24)" ;;
    '')    printf 'no answer on :22' ;;
    *)     printf 'something answered :22, not an SSH banner' ;;
  esac
}

rescue_probe(){
  local j exitid curaddr host ip route dev table maindev
  command -v tailscale >/dev/null 2>&1 || { echo "state: na"; echo "reason: no tailscale CLI on this node"; return 0; }
  command -v jq >/dev/null 2>&1        || { echo "state: na"; echo "reason: no jq, so the exit node's live endpoint cannot be read — and it is never guessed"; return 0; }
  j="$(tailscale status --json 2>/dev/null)"
  [ -n "$j" ] || { echo "state: na"; echo "reason: 'tailscale status --json' returned nothing, so the endpoint is UNKNOWN rather than absent"; return 0; }
  exitid="$(printf '%s' "$j" | jq -r '.ExitNodeStatus.ID // ""' 2>/dev/null)"
  if [ -z "$exitid" ]; then
    echo "state: absent"
    echo "reason: this node consumes no exit node, so no peer endpoint is being swallowed and there is nothing to except"
    return 0
  fi
  host="$(printf '%s' "$j" | jq -r --arg i "$exitid" '.Peer[]|select(.ID==$i)|.HostName // "?"' 2>/dev/null | head -1)"
  curaddr="$(printf '%s' "$j" | jq -r --arg i "$exitid" '.Peer[]|select(.ID==$i)|.CurAddr // ""' 2>/dev/null | head -1)"
  echo "exit-node: ${host:-?}"
  if [ -z "$curaddr" ]; then
    echo "state: na"
    echo "reason: the path to exit node '${host:-?}' is DERP-relayed (no CurAddr), so it has no single public endpoint for a rescue throw to except"
    return 0
  fi
  case "$curaddr" in
    \[*) echo "state: na"; echo "reason: exit node '${host:-?}' CurAddr $curaddr is IPv6; this leg excepts v4 endpoints only"; return 0 ;;
  esac
  ip="${curaddr%:*}"
  echo "endpoint: $ip"; echo "net: $ip/32"
  # The healthy device is whatever the MAIN table's default route uses — READ, never named. A rescue
  # packet must leave by this node's OWN uplink; testing "not tailscale0" by name would break the day
  # the tunnel interface is called something else, and silently pass.
  maindev="$(ip route show default table main 2>/dev/null | grep -oP '\bdev \K\S+' | head -1)"
  echo "uplink-dev: ${maindev:-}"
  if [ -z "$maindev" ]; then
    echo "state: na"
    echo "reason: no default route in table main, so there is no uplink device to compare against — the uplink itself is down, a rescue throw would not help, and the comparison would be a guess"
    return 0
  fi
  route="$(ip route get "$ip" 2>/dev/null | head -1)"
  dev="$(printf '%s\n' "$route"   | grep -oP '\bdev \K\S+'   | head -1)"
  table="$(printf '%s\n' "$route" | grep -oP '\btable \K\S+' | head -1)"
  echo "dev: ${dev:-}"; echo "table: ${table:-}"
  if [ -z "$route" ] || [ -z "$dev" ]; then
    echo "state: na"; echo "reason: FIB lookup for $ip returned no device (answer: ${route:-<empty>})"; return 0
  fi
  if [ "$dev" = "$maindev" ]; then
    echo "state: ok"
    echo "reason: $ip -> dev $dev, the uplink — the off-tailnet rescue path to '${host:-?}' does not ride the tunnel"
  else
    echo "state: swallowed"
    echo "reason: $ip (exit node '${host:-?}' own endpoint) routes via dev $dev${table:+ table $table}, NOT the uplink $maindev — the rescue path rides the very tunnel it exists to rescue"
  fi
  return 0
}

rescue_leg(){
  local kv state net table own target reason host vroute vdev n24 reach probedev uplinkdev
  VERB=""
  kv="$(rescue_probe)"
  state="$(printf  '%s\n' "$kv" | sed -n 's/^state: //p')"
  reason="$(printf '%s\n' "$kv" | sed -n 's/^reason: //p')"
  host="$(printf   '%s\n' "$kv" | sed -n 's/^exit-node: //p')"
  case "$state" in
    absent|na) quiet "exit-node-lan-heal: nothing to do (rescue) — $state: $reason"; return 0 ;;
    ok)        quiet "exit-node-lan-heal: nothing to do (rescue) — $reason"; return 0 ;;
  esac

  net="$(printf     '%s\n' "$kv" | sed -n 's/^net: //p')"
  table="$(printf   '%s\n' "$kv" | sed -n 's/^table: //p')"
  target="$(printf  '%s\n' "$kv" | sed -n 's/^endpoint: //p')"
  uplinkdev="$(printf '%s\n' "$kv" | sed -n 's/^uplink-dev: //p')"
  # Every v4 address this node holds, so the guard can refuse an endpoint that is one of ours.
  own="$(ip -o -4 addr show scope global 2>/dev/null | awk '{print $4}' | tr '\n' ' ')"

  commit_throw "$net" "$table" "$own" APPLIED-RESCUE "rescue path to '$host' ($target) swallowed — $reason" rescue_allowed
  case $? in 4) return 0 ;; 3) return 0 ;; 1) return 1 ;; esac

  # RE-ASK THE FIB. Not the pref, not a ping, and not the banner: the device is the only answer that
  # distinguishes a restored out-of-band path from one the tunnel is still carrying for us.
  vroute="$(ip route get "$target" 2>/dev/null | head -1)"
  vdev="$(printf '%s\n' "$vroute" | grep -oP '\bdev \K\S+' | head -1)"
  reach="$(rescue_reach "$target")"
  if [ "${vdev:-}" != "$uplinkdev" ]; then
    say "exit-node-lan-heal: WROTE THE RESCUE THROW AND IT IS STILL SWALLOWED — $target routes via dev ${vdev:-<none>}, not the uplink $uplinkdev (answer: ${vroute:-<empty>})"
    tape "UNHEALED-RESCUE $VERB net=$net table=$table post-dev=${vdev:-none} uplink=$uplinkdev reach=$reach mandate=$MANDATE $CONTEST"
    trace "[exit-node-lan-heal] UNHEALED-RESCUE on $(hostname): installed throw $net table $table, $target still routes via dev ${vdev:-none} instead of the uplink $uplinkdev — the off-tailnet rescue path to '$host' is still inside the tunnel"
    return 1
  fi

  [ "$VERB" = PRESENT ] && { say "exit-node-lan-heal: rescue throw already present, FIB now ok ($target -> dev $vdev; $reach)"; tape "PRESENT-RESCUE net=$net table=$table dev=$vdev reach=$reach"; return 0; }

  tape "APPLIED-RESCUE throw $net table $table exit-node=$host dev=$vdev reach=$reach (reach is CORROBORATION, never the discriminator: the tunnel delivers :22 too) mandate=$MANDATE $CONTEST"
  n24=$(applied_since 86400 APPLIED-RESCUE)
  trace "[exit-node-lan-heal] APPLIED-RESCUE on $(hostname): ip route add throw $net table $table — the exit node '$host' had swallowed ITS OWN public endpoint, i.e. the off-tailnet address a hand would rescue it over rode the tunnel whose far end is that same machine. $target now leaves by dev $vdev; $reach. $n24 rescue re-application(s) in 24h. mandate=$MANDATE; $CONTEST"
  say "exit-node-lan-heal: APPLIED throw $net table $table — off-tailnet rescue path to '$host' restored ($target -> dev $vdev; $reach); $n24 rescue re-application(s) in 24h"
  printf 'last-applied: %s\nleg: rescue\nnet: %s\ntable: %s\ndev: %s\n' "$(ts)" "$net" "$table" "$vdev" > "$STATE" 2>/dev/null || true
  board_post "[fyi] exit-node-lan-heal@$(hostname): re-installed 'throw $net table $table' — the exit node '$host' had swallowed ITS OWN PUBLIC ENDPOINT, so the off-tailnet path a hand would rescue it over was routed through the tunnel whose far end IS that machine (measured 2026-08-27, the day phaedra was unreachable both ways for 14h20m). $target now leaves by dev $vdev; $reach. $n24 rescue re-application(s) in 24h."
  return 0
}

# ══ both legs run, EVERY time; the exit code is the worst of them ═══════════════════════════════
# THE LAN LEG'S VERDICT MUST NOT GATE THE DOCKER LEG. Until this leg landed the tool returned at
