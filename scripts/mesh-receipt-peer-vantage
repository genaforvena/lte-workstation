#!/usr/bin/env bash
# orphan-ok: on-demand check tool, pulled by hand/doctor, never cron-wired
# mesh-receipt-peer-vantage — ARM 2: peer-vantage advisory axis for receipts.
# Standalone (mesh-receipt-gate untouched) so its --test stays green.
#
# If a receipt settles a substrate/path change (mentions ip route|exit-node|
# tailscale|vpn|dns|firewall), warn "NOTE peer-vantage-missing" unless it names
# a peer-origin artifact (peer hostname + mesh-tell --peek|remote|peer|
# off-node|from <peer>).
#
# Advisory only: NEVER holds (always rc 0 on readable input; rc 2 on
# missing/unreadable). Why: peer evidence often lives in chat.log, not the
# receipt — holding on its absence would punish receipts whose corroboration
# sits one file away. The NOTE tells the reviewer where to look.
#
#   mesh-receipt-peer-vantage <file> [...] | --test
set -uo pipefail

check_one(){
  local f="$1" body
  [ -f "$f" ] || { echo "SKIP missing-file: $f"; return 2; }
  [ -r "$f" ] || { echo "SKIP unreadable: $f"; return 2; }
  body="$(cat "$f")"
  if ! grep -qiE 'ip route|exit-node|exit node|tailscale|vpn|dns|firewall|iptables|nft' <<<"$body"; then
    echo "PASS no-substrate-axis: $f"; return 0
  fi
  if grep -qiE 'mesh-tell --peek|remote|peer|off-node|from [a-z0-9_.-]+|another node|second node|peer-origin|vantage' <<<"$body" \
    && grep -qiE '[a-z0-9_.-]+\.(local|lan)|100\.[6-9][0-9]?\.[0-9]+\.[0-9]+|192\.168\.[0-9]+\.[0-9]+|mesh-home|phaedra|ideapad|imac|redmi|note3' <<<"$body"; then
    echo "PASS peer-vantage-present: $f"; return 0
  fi
  echo "NOTE peer-vantage-missing: $f — substrate/path receipt names no peer-origin artifact (advisory only; peer evidence often lives in chat.log, not the receipt)"
  return 0
}

if [ "${1:-}" = --test ]; then
  d="$(mktemp -d)"; trap 'rm -rf "$d"' EXIT
  pass=0; fail=0; ok(){ pass=$((pass+1)); }; bad(){ echo "FAIL: $1"; fail=$((fail+1)); }
  printf 'Task: demo/x\nArtifact: file\nMeasured: 1s\nChanged ip route throw, verified locally.\n' > "$d/substrate-nopeer.md"
  printf 'Task: demo/y\nArtifact: file\nMeasured: 1s\nChanged ip route throw; verified from phaedra via mesh-tell --peek health (100.81.222.19).\n' > "$d/substrate-peer.md"
  printf 'Task: demo/z\nArtifact: file\nMeasured: 1s\nFixed a typo in docs.\n' > "$d/plain.md"
  out="$("$0" "$d/substrate-nopeer.md" 2>&1)"; rc=$?
  { [ "$rc" = 0 ] && grep -q 'NOTE peer-vantage-missing' <<<"$out"; } && ok || bad "substrate w/o peer must NOTE advisory rc=0 (rc=$rc: $out)"
  out="$("$0" "$d/substrate-peer.md" 2>&1)"; rc=$?
  { [ "$rc" = 0 ] && grep -q 'peer-vantage-present' <<<"$out"; } && ok || bad "substrate with peer must PASS (rc=$rc: $out)"
  out="$("$0" "$d/plain.md" 2>&1)"; rc=$?
  { [ "$rc" = 0 ] && grep -q 'no-substrate-axis' <<<"$out"; } && ok || bad "non-substrate must PASS (rc=$rc: $out)"
  "$0" "$d/substrate-nopeer.md" >/dev/null 2>&1; [ $? = 0 ] && ok || bad "advisory must never HOLD (rc!=0)"
  "$0" "$d/does-not-exist.md" >/dev/null 2>&1; [ $? = 2 ] && ok || bad "missing file must rc=2"
  echo "mesh-receipt-peer-vantage --test: $pass passed, $fail failed"
  [ "$fail" = 0 ]; exit $?
fi

[ $# -ge 1 ] || { echo "usage: mesh-receipt-peer-vantage <file> [...] | --test" >&2; exit 2; }
overall=0
for f in "$@"; do check_one "$f" || { rc=$?; [ "$rc" = 2 ] && overall=2; }; done
exit "$overall"
