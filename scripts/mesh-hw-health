#!/usr/bin/env bash
# reflex-cadence: 17-59/30 * * * *
# reflex-args: --edge
# mesh-hw-health — per-node HARDWARE health check (operator ask 2026-06-14, after the ds dead-cooler case).
# Complements mesh-doctor (software/organs) with the HARDWARE layer: cooling-efficiency / fan / thermal /
# disk SMART / battery wear. Catches a failing cooler EARLY — the ds signature was a COLD board (27°C) +
# HOT cpu (90°C) at LIGHT load (1.04) = heat not leaving the die. Honest n/a where a sensor isn't exposed.
#
#   mesh-hw-health          report + overall HW: OK|WARN|FAIL (exit 0 ok/warn, 1 fail)
#   mesh-hw-health --edge   REFLEX: run, post [hw-fail]/[hw-warn]/[hw-ok] to the board ONLY on a state CHANGE
#                           (this is how it lives in the health window — it self-runs, planner doesn't)
#   mesh-hw-health --test   smoke
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
{ "$HOME/.local/bin/mesh-pulse" beat hw-health; } >/dev/null 2>&1 || true  # liveness heartbeat (mesh-pulse): edge reflex is silent-on-no-news → needs an explicit per-run pulse
MESH="$HOME/.mesh"

# Pure dead-cooler classifier (maxt °C, loadavg) → FAIL|WARN|LOADHEAT|OK|NONE. Factored OUT of
# report() so --test can dry-run the DECISION BOUNDARIES — the tool's whole reason to exist. The
# live sensor reads only ever sample ONE point, never the fault-vs-load-heat boundary. A HARDWARE
# fault = the cooler can't handle even LIGHT load (ds: 90C @ load 1.04); heat at HIGH load is
# load-pressure (mesh-therm/mesh-stress own that), NOT a hardware fault — never false-FAIL a busy node.
parse_wear(){ # $1 = smartctl -A output text → echoes "NN%" (NVMe Percentage Used) or "" if absent.
  # (chat-review/wire-nvme-wear 2026-07-04, knowledge/capability-disk-smart-live-20260704.md): the
  # drive-reported lifetime wear estimate — distinct from the pass/fail health verdict, changes
  # slowly (low-cadence signal), meant for mesh-card's durable node self-description, not an alert.
  # SATA SSDs expose wear under a different vendor attribute id — not parsed here (n/a, honest gap).
  printf '%s\n' "$1" | grep -iE 'Percentage Used' | grep -oE '[0-9]+%' | head -1
}

parse_smart_int(){ # $1=smartctl -A text  $2=exact attribute label → integer value (commas/%/units stripped) or ""
  # (mesh-land/health 2026-07-11, knowledge/capability-nvme-{unsafe-shutdown-delta,smart-failure-predictors}-20260711):
  # the -A block already fetched for parse_wear also carries the device-dying predictors + the
  # ungraceful-death counter — this pulls one numeric field. Colon-anchored so 'Available Spare:'
  # never matches 'Available Spare Threshold:'.
  printf '%s\n' "$1" | grep -iE "^$2:" | head -1 | grep -oE '[0-9][0-9,]*' | head -1 | tr -d ','
}

parse_critwarn(){ # $1=smartctl -A text → NVMe 'Critical Warning' hex bitmask (e.g. 0x00) or "" if absent.
  printf '%s\n' "$1" | grep -iE '^Critical Warning:' | head -1 | grep -oiE '0x[0-9a-f]+' | head -1
}

classify_smart_health(){ # $1=critwarn(hex) $2=spare% $3=spare_thr% $4=media-errs $5=media-err-baseline → FAIL:.. | WARN:.. | OK
  # Device-dying predictors SMART exists to raise — distinct from the slow wear estimate and caught
  # EARLIER than -H (overall-health stays PASSED until very late). Pure so --test dry-runs the bands.
  local cw="$1" sp="$2" spt="$3" me="$4" meb="$5"
  # Critical Warning bitmask: ANY non-zero bit = the controller itself declaring a fault (spare<thr,
  # temp excursion, read-only, degraded reliability, volatile-mem-backup failed).
  if [ -n "$cw" ] && [ "$cw" != 0x00 ] && [ "$cw" != 0x0 ]; then echo "FAIL:critwarn=$cw"; return; fi
  # Available Spare fallen BELOW the drive's own threshold = imminent failure — wear ('Percentage
  # Used') can still read low while spare blocks are exhausted, so this catches a different death.
  if [ -n "$sp" ] && [ -n "$spt" ] && [ "$sp" -lt "$spt" ] 2>/dev/null; then echo "FAIL:spare=${sp}%<thr${spt}%"; return; fi
  # Media & Data Integrity Errors: uncorrectable read/write → silent corruption. Delta-gate on RISE
  # vs the persisted baseline (absolute count is lifetime; a NEW error is the event).
  if [ -n "$me" ] && [ -n "$meb" ] && [ "$me" -gt "$meb" ] 2>/dev/null; then echo "WARN:mediaerr=${me}(was ${meb})"; return; fi
  echo OK
}

classify_unsafe_shutdown(){ # $1=current-count $2=baseline → RISE:<delta> | OK | BASELINE | NONE
  # Ungraceful-death sense: 'Unsafe Shutdowns' counts hard power-loss (OOM hard-off, thermal cutoff,
  # yanked power). Intended reboots are clean and DON'T inflate it, but the counter is lifetime, so
  # a delta-on-RISE vs the last-seen baseline is the honest signal — not an absolute threshold.
  local cur="$1" base="$2"
  [ -n "$cur" ] || { echo NONE; return; }
  [ -n "$base" ] || { echo BASELINE; return; }   # first run: record, don't alarm
  if [ "$cur" -gt "$base" ] 2>/dev/null; then echo "RISE:$((cur-base))"; else echo OK; fi
}

kill_events_summary(){ # $1=tape path $2=now-epoch -> "<oom-count> <segv-count>" within a 24h window
  # Factored out (like classify_cooling/parse_wear) so --test can dry-run the WINDOW boundary —
  # the failure mode this exists to catch is silently counting stale/ancient kills as "recent".
  local tape="$1" now="$2" cutoff=0 koom=0 ksegv=0 line vts vepoch kind
  [ -r "$tape" ] || { echo "0 0"; return; }
  cutoff=$(( now - 86400 ))
  while IFS= read -r line; do
    vts="$(printf '%s' "$line" | awk '{print $1}')"
    vepoch="$(date -d "$vts" +%s 2>/dev/null)" || continue
    [ "$vepoch" -ge "$cutoff" ] || continue
    kind="$(printf '%s' "$line" | grep -oE 'kind=[a-z]+' | cut -d= -f2)"
    case "$kind" in oom) koom=$((koom+1));; segv) ksegv=$((ksegv+1));; esac
  done < "$tape"
  echo "$koom $ksegv"
}

classify_cooling(){ # $1=maxt °C  $2=loadavg → echoes verdict
  local maxt="$1" load="$2" lowload
  [ "${maxt:-0}" -gt 0 ] 2>/dev/null || { echo NONE; return; }
  lowload=$(awk "BEGIN{print ($load<1.5)?1:0}")
  if   [ "$lowload" = 1 ] && [ "$maxt" -ge 85 ]; then echo FAIL
  elif [ "$lowload" = 1 ] && [ "$maxt" -ge 82 ]; then echo WARN
  elif [ "$maxt" -ge 90 ];                       then echo LOADHEAT
  else echo OK; fi
}

# CPU/max temperature reader. thermal_zone* is an INTEL-shaped assumption: on AMD (k10temp) the
# whole /sys/class/thermal tree holds cooling_device* and ZERO thermal_zone*, so the old glob-only
# read returned 0 → "thermal n/a" → the dead-cooler watchdog contributed NOTHING and HW rolled up
# GREEN on a box running at Tctl 73C (board 2026-07-14, confirmed live on mesh-home; same
# portability miss mesh-therm-headroom already fixed for itself in 80404c1). Zones first (Intel /
# ARM), then hwmon: k10temp Tdie/Tctl (the fan-control package temp), else its Tccd*, else any
# non-nvme hwmon temp. Echoes °C, or nothing when NO sensor is readable.
cpu_max_temp(){
  local z t v h lab f maxt=0
  shopt -s nullglob
  for z in /sys/class/thermal/thermal_zone*/temp; do
    t=$(( $(cat "$z" 2>/dev/null || echo 0)/1000 )); [ "$t" -gt "$maxt" ] && maxt=$t
  done
  if [ "$maxt" -eq 0 ]; then
    for h in /sys/class/hwmon/hwmon*; do
      [ "$(cat "$h/name" 2>/dev/null)" = k10temp ] || continue
      for want in Tdie Tctl Tccd1 Tccd2; do
        for lab in "$h"/temp*_label; do
          [ "$(cat "$lab" 2>/dev/null)" = "$want" ] || continue
          f="${lab%_label}_input"; v=$(cat "$f" 2>/dev/null) || continue
          [ -n "$v" ] && { shopt -u nullglob; echo $(( v/1000 )); return; }
        done
      done
    done
    # last resort: any hwmon CPU-ish temp that is not a disk (nvme/drivetemp are the AMBIENT floor)
    for h in /sys/class/hwmon/hwmon*; do
      case "$(cat "$h/name" 2>/dev/null)" in nvme|drivetemp|"") continue ;; esac
      for f in "$h"/temp*_input; do
        v=$(cat "$f" 2>/dev/null) || continue
        t=$(( ${v:-0}/1000 )); [ "$t" -gt "$maxt" ] && maxt=$t
      done
    done
  fi
  shopt -u nullglob
  [ "$maxt" -gt 0 ] && echo "$maxt"
}

# Ambient/chassis FLOOR: the coolest real sensor on the box (>15°C filters bogus 0/-273 reads).
# Same portability shape — zones, then hwmon (on AMD the nvme sensors ARE the ambient-coupled floor).
ambient_temp(){
  local f v t out=""
  shopt -s nullglob
  for f in /sys/class/thermal/thermal_zone*/temp /sys/class/hwmon/hwmon*/temp*_input; do
    v=$(cat "$f" 2>/dev/null) || continue
    t=$(( ${v:-0}/1000 )); [ "$t" -gt 15 ] || continue
    { [ -z "$out" ] || [ "$t" -lt "$out" ]; } && out=$t
  done
  shopt -u nullglob
  echo "${out:-0}"
}

[ "${1:-}" = --test ] && {
  fail=0
  zones=0
  shopt -s nullglob
  for z in /sys/class/thermal/thermal_zone*/temp; do
    [ -r "$z" ] || { echo "  FAIL: $z exists but is unreadable"; fail=1; continue; }
    v=$(cat "$z" 2>/dev/null || echo "")
    [ -z "$v" ] && { echo "  FAIL: $z is empty"; fail=1; continue; }
    v_int=$((v/1000)) 2>/dev/null || { echo "  FAIL: $z value '$v' is not numeric"; fail=1; continue; }
    [ "$v_int" -gt 0 ] 2>/dev/null || { echo "  FAIL: $z value $v_int is not a positive integer"; fail=1; continue; }
    zones=$((zones+1))
  done
  [ "$zones" -eq 0 ] && echo "  n/a: no thermal zones — graceful off-node path"
  # REAL-READ GATE (the miss that let this ship): the sensor loop above only validates zones that
  # EXIST — on AMD there are none, so it passed vacuously while the tool was blind. Assert instead
  # that IF this box exposes ANY temp sensor at all, cpu_max_temp() actually PRODUCES a plausible
  # reading. Reachability of /sys ≠ producing a temperature. On a truly sensorless node (phone/VM)
  # there is nothing to read → honest skip, never a fake green.
  shopt -s nullglob
  sensors=(/sys/class/thermal/thermal_zone*/temp /sys/class/hwmon/hwmon*/temp*_input)
  shopt -u nullglob
  if [ "${#sensors[@]}" -gt 0 ]; then
    t=$(cpu_max_temp)
    if [ -z "$t" ]; then
      echo "  FAIL: ${#sensors[@]} temp sensor(s) exist but cpu_max_temp() read NOTHING — the watchdog is blind"; fail=1
    elif ! [ "$t" -ge 10 ] 2>/dev/null || [ "$t" -ge 150 ]; then
      echo "  FAIL: cpu_max_temp() returned implausible '${t}' (want 10..149 °C)"; fail=1
    else
      echo "  ok: live CPU temp read ${t}°C · ambient floor $(ambient_temp)°C (${#sensors[@]} sensors)"
    fi
  else
    echo "  n/a: no temp sensors on this box — cpu_max_temp() honest-empty"
  fi
  # thermal-unknown must NOT be silently healthy — a missing read has to raise, or a blind watchdog
  # rolls up green (the exact 2026-07-14 false-green).
  [ "$(classify_cooling 0 1.0)" = NONE ] || { echo "smoke-test: FAIL (no-reading must classify NONE, not OK)"; exit 1; }
  [ -d /sys/class/power_supply ] && ls /sys/class/power_supply/*/charge_full >/dev/null 2>&1 && echo "  ok: battery charge_full readable"
  [ "$fail" = 1 ] && { echo "smoke-test: FAIL"; exit 1; }
  # Dry-run the dead-cooler classifier BOUNDARIES (the tool's reason to exist). The sensor checks
  # above validate inputs but never the fault-vs-load-heat decision; a flipped band or a wrong
  # lowload threshold would silently mis-fire ([hw-fail] on a busy node, or miss a real dead cooler)
  # while --test stayed green. Falsifiable: corrupting any band breaks one of these.
  [ "$(classify_cooling 90 1.0)" = FAIL ]     || { echo "smoke-test: FAIL (90C@low-load must be dead-cooler FAIL)"; exit 1; }
  [ "$(classify_cooling 83 1.0)" = WARN ]     || { echo "smoke-test: FAIL (83C@low-load must be WARN)"; exit 1; }
  [ "$(classify_cooling 96 4.0)" = LOADHEAT ] || { echo "smoke-test: FAIL (96C@high-load must be load-driven, NOT a hw fault)"; exit 1; }
  [ "$(classify_cooling 84 4.0)" = OK ]       || { echo "smoke-test: FAIL (84C@high-load is load not a low-load fault → OK)"; exit 1; }
  [ "$(classify_cooling 70 0.5)" = OK ]       || { echo "smoke-test: FAIL (70C must be OK)"; exit 1; }
  # NVMe wear parse (chat-review/wire-nvme-wear): must extract 'Percentage Used' as NN%, and stay
  # honestly empty (n/a) when the attribute isn't present (e.g. a SATA SSD's differently-named field).
  [ "$(parse_wear 'Percentage Used:                    7%')" = "7%" ] \
    || { echo "smoke-test: FAIL (parse_wear did not extract NVMe Percentage Used)"; exit 1; }
  [ -z "$(parse_wear 'Temperature:                        35 Celsius')" ] \
    || { echo "smoke-test: FAIL (parse_wear should be empty when the attribute is absent)"; exit 1; }
  # NVMe field parse (mesh-land/health): colon-anchored, comma/%/hex handled, honestly empty when absent.
  _asmpl=$'Critical Warning:                   0x00\nAvailable Spare:                    100%\nAvailable Spare Threshold:          10%\nUnsafe Shutdowns:                   85\nMedia and Data Integrity Errors:    0\nPower Cycles:                       1,253'
  [ "$(parse_smart_int "$_asmpl" 'Available Spare')" = 100 ]           || { echo "smoke-test: FAIL (parse Available Spare)"; exit 1; }
  [ "$(parse_smart_int "$_asmpl" 'Available Spare Threshold')" = 10 ]  || { echo "smoke-test: FAIL (parse Available Spare Threshold — colon anchor must not collide with 'Available Spare')"; exit 1; }
  [ "$(parse_smart_int "$_asmpl" 'Unsafe Shutdowns')" = 85 ]           || { echo "smoke-test: FAIL (parse Unsafe Shutdowns)"; exit 1; }
  [ "$(parse_smart_int "$_asmpl" 'Power Cycles')" = 1253 ]             || { echo "smoke-test: FAIL (parse must strip thousands comma)"; exit 1; }
  [ "$(parse_critwarn "$_asmpl")" = 0x00 ]                             || { echo "smoke-test: FAIL (parse Critical Warning hex)"; exit 1; }
  [ -z "$(parse_smart_int 'Temperature: 35 Celsius' 'Unsafe Shutdowns')" ] || { echo "smoke-test: FAIL (parse_smart_int empty when absent)"; exit 1; }
  # SMART failure-predictor bands: healthy=OK, non-zero critwarn=FAIL, spare<thr=FAIL, media-err rise=WARN, media-err steady=OK.
  [ "$(classify_smart_health 0x00 100 10 0 0)" = OK ]              || { echo "smoke-test: FAIL (all-nominal predictors must be OK)"; exit 1; }
  case "$(classify_smart_health 0x04 100 10 0 0)" in FAIL:*) :;; *) echo "smoke-test: FAIL (non-zero Critical Warning must FAIL)"; exit 1;; esac
  case "$(classify_smart_health 0x00 5 10 0 0)"   in FAIL:*) :;; *) echo "smoke-test: FAIL (Available Spare below threshold must FAIL)"; exit 1;; esac
  case "$(classify_smart_health 0x00 100 10 3 1)" in WARN:*) :;; *) echo "smoke-test: FAIL (media-err rise above baseline must WARN)"; exit 1;; esac
  [ "$(classify_smart_health 0x00 100 10 2 2)" = OK ]             || { echo "smoke-test: FAIL (steady media-err count must stay OK — delta-gated)"; exit 1; }
  # Unsafe-shutdown delta: first run records (BASELINE, no alarm), a rise alarms, no change is OK.
  [ "$(classify_unsafe_shutdown 85 '')" = BASELINE ]  || { echo "smoke-test: FAIL (first unsafe-shutdown read must BASELINE, not alarm)"; exit 1; }
  [ "$(classify_unsafe_shutdown 85 85)" = OK ]        || { echo "smoke-test: FAIL (unchanged unsafe-shutdown count must be OK)"; exit 1; }
  case "$(classify_unsafe_shutdown 86 85)" in RISE:1) :;; *) echo "smoke-test: FAIL (unsafe-shutdown +1 must be RISE:1)"; exit 1;; esac
  # kill-events summary (chat-review/wire-kill-events consumer): counts within the 24h window,
  # excludes anything older, and never fails when the tape doesn't exist yet.
  _kt="$(mktemp)"; _now="$(date -u +%s)"
  printf '%s\n' \
    "$(date -u -d "@$((_now-3600))" +%FT%TZ) kill-event victim=opencode pid=1 kind=oom rss=1 vm=2" \
    "$(date -u -d "@$((_now-7200))" +%FT%TZ) kill-event victim=bash pid=2 kind=segv rss=- vm=-" \
    "$(date -u -d "@$((_now-90000))" +%FT%TZ) kill-event victim=opencode pid=3 kind=oom rss=1 vm=2" \
    > "$_kt"
  [ "$(kill_events_summary "$_kt" "$_now")" = "1 1" ] \
    || { rm -f "$_kt"; echo "smoke-test: FAIL (kill_events_summary must count only within 24h, got '$(kill_events_summary "$_kt" "$_now")')"; exit 1; }
  rm -f "$_kt"
  [ "$(kill_events_summary /nonexistent-kill-tape "$_now")" = "0 0" ] \
    || { echo "smoke-test: FAIL (kill_events_summary must degrade to '0 0' when the tape is unreadable, not error)"; exit 1; }
  echo "smoke-test: ok (cooling-classifier boundaries + NVMe wear/predictor/shutdown parse + kill-events window verified)"; exit 0
}

report(){ # prints the human report; LAST line = "HW: OK|WARN|FAIL"
  # $1 = --persist → advance the delta-baseline state files (unsafe-shutdown / media-err). ONLY the
  # --edge reflex passes this; a plain `mesh-hw-health` read must NOT mutate the baselines it reads
  # (else a human read masks the next reflex's rise-detection — status-read-shares-write-path pitfall).
  local persist=0; [ "${1:-}" = --persist ] && persist=1
  local warn=0 fail=0
  note(){ printf '  %-9s %s\n' "$1" "$2"; }
  echo "=== mesh-hw-health $(hostname) $(date -u +%H:%MZ) ==="
  # thermal / cooling efficiency (the ds-killer signal)
  local maxt; maxt=$(cpu_max_temp); maxt=${maxt:-0}
  local ambient; ambient=$(ambient_temp); local load; load=$(awk '{print $1}' /proc/loadavg); local gap=$((maxt - ambient))
  if [ "$maxt" -gt 0 ]; then
    note "thermal" "max ${maxt}°C · ambient ~${ambient}°C · gap ${gap}°C · load ${load}"
    # HARDWARE-fault = the cooler can't handle even LIGHT load (ds: 90C @ load 1.04). Heat at HIGH load is
    # load-pressure (mesh-therm/mesh-stress own that), NOT a hardware fault — don't false-FAIL a busy node.
    # classify_cooling (defined above, shared with --test) owns the fault-vs-load-heat DECISION;
    # the note text + warn/fail side-effects stay here. WARN is tied to ABSOLUTE temp (82-84C band),
    # NOT the gap alone — a warm CPU in a cool room makes a big gap that is NOT a fault (was a
    # recurring false [hw-warn] at 79C/gap-59 on a normal-warm laptop).
    case "$(classify_cooling "$maxt" "$load")" in
      FAIL)     note "" "FAIL: hot (${maxt}C) at LOW load (${load}) -> cooling failing (ds dead-cooler signature)"; fail=1 ;;
      WARN)     note "" "WARN: warm (${maxt}C, gap ${gap}C) at LOW load -> cooling weakening, approaching the 85C dead-cooler FAIL"; warn=1 ;;
      LOADHEAT) note "" "note: hot ${maxt}C but at load ${load} = load-driven (see mesh-therm/stress), NOT a hardware fault" ;;
    esac
  else
    # A silent n/a is what hid the AMD blindness: no sensor read → no warn/fail → HW rolls up GREEN
    # while the dead-cooler watchdog contributes NOTHING. Unknown thermal is NOT health — it is an
    # unmonitored cooler on a node that may be baking. WARN (never FAIL: a genuinely sensorless box
    # — a phone/VM — is an honest gap, not a fault).
    note "thermal" "n/a — NO CPU temp sensor readable (thermal_zone* AND hwmon both empty)"
    note "" "WARN: dead-cooler watchdog is BLIND here — thermal-unknown does NOT count as healthy"; warn=1
  fi
  # fan
  local fanrpm=""; for f in /sys/class/hwmon/*/fan*_input; do [ -r "$f" ] && fanrpm="$fanrpm $(cat "$f" 2>/dev/null)"; done
  fanrpm="$(echo $fanrpm)"
  if [ -n "$fanrpm" ]; then note "fan" "RPM:$fanrpm"
    if [ "$maxt" -ge 70 ] && echo " $fanrpm " | grep -qw 0; then note "" "FAIL: a fan reads 0 RPM while hot -> dead/stalled fan"; fail=1; fi
  else note "fan" "n/a (not exposed via hwmon here)"; fi
  # disk SMART
  if command -v smartctl >/dev/null 2>&1; then
    local d; d=$(lsblk -dno NAME,TYPE 2>/dev/null | awk '$2=="disk"{print $1; exit}')
    local h; h=$(sudo -n smartctl -H "/dev/$d" 2>/dev/null | grep -iE 'overall-health|SMART Health' | tail -1)
    local aout; aout=$(sudo -n smartctl -A "/dev/$d" 2>/dev/null)   # fetched ONCE; feeds wear + predictors + shutdown-delta
    local wear; wear=$(parse_wear "$aout")
    note "disk" "${h:-/dev/$d (smartctl present; needs root)}${wear:+ wear=${wear}}"
    # --- NVMe SMART failure predictors (device-dying signals; parsed from the -A already fetched) ---
    local cw sp spt me
    cw=$(parse_critwarn "$aout")
    sp=$(parse_smart_int "$aout" 'Available Spare'); spt=$(parse_smart_int "$aout" 'Available Spare Threshold')
    me=$(parse_smart_int "$aout" 'Media and Data Integrity Errors')
    if [ -n "$cw$sp$me" ]; then
      local mef="$MESH/.nvme-media-err-state" meb=""; [ -r "$mef" ] && meb=$(cat "$mef" 2>/dev/null)
      note "smart" "critwarn=${cw:-n/a} spare=${sp:-n/a}%/thr${spt:-n/a}% media-errs=${me:-n/a}"
      case "$(classify_smart_health "$cw" "$sp" "$spt" "$me" "${meb:-$me}")" in
        FAIL:*) note "" "FAIL: NVMe SMART predictor — $(classify_smart_health "$cw" "$sp" "$spt" "$me" "${meb:-$me}" | cut -d: -f2-) (drive declaring imminent failure)"; fail=1 ;;
        WARN:*) note "" "WARN: NVMe media/data integrity errors ROSE — uncorrectable, silent-corruption risk ($(classify_smart_health "$cw" "$sp" "$spt" "$me" "${meb:-$me}" | cut -d: -f2-))"; warn=1 ;;
      esac
      [ "$persist" = 1 ] && [ -n "$me" ] && printf '%s\n' "$me" > "$mef"
    fi
    # --- NVMe Unsafe Shutdowns delta (ungraceful death: OOM/thermal hard-off — invisible before now) ---
    local usc; usc=$(parse_smart_int "$aout" 'Unsafe Shutdowns')
    if [ -n "$usc" ]; then
      local usf="$MESH/.nvme-shutdown-state" usb=""; [ -r "$usf" ] && usb=$(cat "$usf" 2>/dev/null)
      case "$(classify_unsafe_shutdown "$usc" "$usb")" in
        RISE:*) note "" "WARN: NVMe unsafe shutdowns rose +$((usc-usb)) (total ${usc}) — ungraceful death since last check (OOM/thermal hard-off, not a clean reboot)"; warn=1 ;;
      esac
      [ "$persist" = 1 ] && printf '%s\n' "$usc" > "$usf"
    fi
  else
    # NVMe hwmon temp (no smartctl needed — kernel exposes via /sys/class/nvme/<n>/hwmon*)
    local nvme_out=""
    for hwm in /sys/class/nvme/*/hwmon*/temp1_input; do
      [ -r "$hwm" ] || continue
      local nv_raw; nv_raw=$(cat "$hwm" 2>/dev/null)
      [ -z "$nv_raw" ] && continue
      local nv_t=$((nv_raw/1000))
      local nv_crit; nv_crit=$(cat "${hwm%temp1_input}temp1_crit" 2>/dev/null); nv_crit=$((${nv_crit:-0}/1000))
      local nv_max; nv_max=$(cat "${hwm%temp1_input}temp1_max" 2>/dev/null); nv_max=$((${nv_max:-0}/1000))
      nvme_out+="nvme=${nv_t}°C"
      [ "${nv_max:-0}" -gt 0 ] && nvme_out+="(throttle@${nv_max}°C)"
      if [ "${nv_crit:-0}" -gt 0 ] && [ "$nv_t" -ge "$nv_crit" ]; then
        note "disk" "$nvme_out FAIL: NVMe at/above critical (${nv_crit}°C)"; fail=1; break
      elif [ "${nv_max:-0}" -gt 0 ] && [ "$nv_t" -ge "$nv_max" ]; then
        note "disk" "$nvme_out WARN: NVMe at throttle threshold"; warn=1; break
      else note "disk" "${nvme_out} ok"; fi
    done
    [ -z "$nvme_out" ] && note "disk" "n/a (no smartctl, no NVMe hwmon)"
  fi
  # battery wear
  local got=0 b fnow fdes pct
  for b in /sys/class/power_supply/BAT* /sys/class/power_supply/battery; do
    [ -d "$b" ] || continue
    fnow=$(cat "$b/charge_full" 2>/dev/null || cat "$b/energy_full" 2>/dev/null)
    fdes=$(cat "$b/charge_full_design" 2>/dev/null || cat "$b/energy_full_design" 2>/dev/null)
    if [ -n "${fnow:-}" ] && [ -n "${fdes:-}" ] && [ "$fdes" -gt 0 ]; then
      pct=$((fnow*100/fdes)); got=1; note "battery" "health ${pct}% of design ($(cat "$b/status" 2>/dev/null))"
      [ "$pct" -lt 50 ] && { note "" "WARN: battery heavily worn (<50% of design)"; warn=1; }
    fi
  done
  [ "$got" = 0 ] && note "battery" "n/a"
  # kill-events forensic summary (chat-review/wire-kill-events consumer): informational only — never
  # fail/warn on its own (a kill count is a symptom mesh-hw-fault-watch/mesh-kill-events already
  # alert on live; this is just recent context for whoever is reading the health report).
  local ktape="${MESH_KILL_EVENTS_TAPE:-$MESH/kill-events.log}"
  if [ -r "$ktape" ]; then
    local koom ksegv
    read -r koom ksegv <<<"$(kill_events_summary "$ktape" "$(date -u +%s)")"
    note "kill-events" "24h: ${koom} oom, ${ksegv} segv (tape: ~/.mesh/kill-events.log)"
  else
    note "kill-events" "n/a (no tape yet)"
  fi
  # remote node load-proxy (no direct sensors — estimate thermal pressure from normalized load)
  # NOTE: this is a LOAD PROXY, not a cooling-fault detector. A dead cooler (HOT-at-LOW-load)
  # is undetectable by load alone — real temp needs coretemp/sensors on the node itself.
  local remote_nodes="${MESH_HW_REMOTE:-}"  # set in ~/.mesh/nodes: MESH_HW_REMOTE="user@host ..."
  for rnode in $remote_nodes; do
    local ruser="${rnode%%@*}"
    local rload rproc rnorm rest
    rload=$(ssh -o ConnectTimeout=5 -o BatchMode=yes "$rnode" "cat /proc/loadavg" 2>/dev/null | awk '{print $1}') || continue
    rproc=$(ssh -o ConnectTimeout=5 -o BatchMode=yes "$rnode" "nproc" 2>/dev/null) || continue
    rnorm=$(awk "BEGIN{printf \"%.2f\", $rload/$rproc}")
    # calibration: idle(0.25/core)=35°C, full(1.0/core)=75°C (load-proxy only)
    rest=$(awk "BEGIN{
      nl=$rnorm; if(nl<0.25)nl=0.25; if(nl>1.0)nl=1.0;
      t=35+(nl-0.25)*(40/0.75); printf \"%.0f\", t
    }")
    note "remote" "${ruser}: load-proxy est ${rest}°C @ load ${rload} (nproc=${rproc}, norm=${rnorm})"
    # High load-proxy = node is working hard (not a cooling fault — that's HOT-at-LOW-load)
    if [ "$rest" -ge 65 ]; then note "" "WARN: ${ruser} load-proxy high (${rest}°C) — node under heavy load (NOT a cooling-fault signal)"; warn=1; fi
  done

  [ "$fail" = 1 ] && { echo "HW: FAIL"; return 1; }
  [ "$warn" = 1 ] && { echo "HW: WARN"; return 0; }
  echo "HW: OK"
}

if [ "${1:-}" = --edge ]; then
  state="$MESH/.hw-health.state"; out="$(report --persist)"; verdict="$(printf '%s\n' "$out" | grep -oE 'HW: (OK|WARN|FAIL)' | tail -1)"
  prev="$(cat "$state" 2>/dev/null || echo)"; printf '%s\n' "$verdict" > "$state"
  if [ -n "$prev" ] && [ "$verdict" != "$prev" ] && command -v mesh-chat >/dev/null 2>&1; then
    tag="$(printf '%s' "$verdict" | grep -oiE 'ok|warn|fail' | tr 'A-Z' 'a-z')"
    detail="$(printf '%s\n' "$out" | grep -iE 'FAIL|WARN|thermal|battery|fan' | tr '\n' ' ' | cut -c1-220)"
    MESH_WHO="hw-health@$(hostname)" mesh-chat "[hw-$tag] $(hostname) hardware: $detail" >/dev/null 2>&1
  fi
  printf '%s\n' "$out" | tail -1
  exit 0
fi

report
