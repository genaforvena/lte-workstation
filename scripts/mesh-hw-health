#!/usr/bin/env bash
# reflex-cadence: 17-59/30 * * * *
# reflex-args: --edge
# mesh-hw-health — per-node HARDWARE health check (operator ask 2026-06-14, after the ds dead-cooler case).
# Complements mesh-doctor (software/organs) with the HARDWARE layer: cooling-efficiency / fan / thermal /
# disk SMART / battery wear. Catches a failing cooler EARLY — the ds signature was a COLD board (27°C) +
# HOT cpu (90°C) at LIGHT load (1.04) = heat not leaving the die. Honest n/a where a sensor isn't exposed.
#
#   mesh-hw-health          report + overall HW: OK|WARN|FAIL (exit 0 ok/warn, 1 fail)
#   mesh-hw-health --edge   REFLEX: run, post [hw-fail]/[hw-warn]/[hw-ok] to the board ONLY on a state CHANGE
#                           (this is how it lives in the health window — it self-runs, planner doesn't)
#   mesh-hw-health --test   smoke
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
MESH="$HOME/.mesh"

[ "${1:-}" = --test ] && {
  fail=0
  zones=0
  shopt -s nullglob
  for z in /sys/class/thermal/thermal_zone*/temp; do
    [ -r "$z" ] || { echo "  FAIL: $z exists but is unreadable"; fail=1; continue; }
    v=$(cat "$z" 2>/dev/null || echo "")
    [ -z "$v" ] && { echo "  FAIL: $z is empty"; fail=1; continue; }
    v_int=$((v/1000)) 2>/dev/null || { echo "  FAIL: $z value '$v' is not numeric"; fail=1; continue; }
    [ "$v_int" -gt 0 ] 2>/dev/null || { echo "  FAIL: $z value $v_int is not a positive integer"; fail=1; continue; }
    zones=$((zones+1))
  done
  [ "$zones" -eq 0 ] && echo "  n/a: no thermal zones — graceful off-node path"
  [ -d /sys/class/power_supply ] && ls /sys/class/power_supply/*/charge_full >/dev/null 2>&1 && echo "  ok: battery charge_full readable"
  [ "$fail" = 1 ] && { echo "smoke-test: FAIL"; exit 1; } || { echo "smoke-test: ok"; exit 0; }
}

report(){ # prints the human report; LAST line = "HW: OK|WARN|FAIL"
  local warn=0 fail=0
  note(){ printf '  %-9s %s\n' "$1" "$2"; }
  echo "=== mesh-hw-health $(hostname) $(date -u +%H:%MZ) ==="
  # thermal / cooling efficiency (the ds-killer signal)
  local maxt=0 t
  shopt -s nullglob
  for z in /sys/class/thermal/thermal_zone*/temp; do t=$(( $(cat "$z" 2>/dev/null || echo 0)/1000 )); [ "$t" -gt "$maxt" ] && maxt=$t; done
  local ambient; ambient=$(shopt -s nullglob; for z in /sys/class/thermal/thermal_zone*/temp; do echo $(( $(cat "$z" 2>/dev/null||echo 0)/1000 )); done | sort -n | awk '$1>15{print;exit}')
  shopt -u nullglob
  ambient=${ambient:-0}; local load; load=$(awk '{print $1}' /proc/loadavg); local gap=$((maxt - ambient))
  if [ "$maxt" -gt 0 ]; then
    note "thermal" "max ${maxt}°C · ambient ~${ambient}°C · gap ${gap}°C · load ${load}"
    # HARDWARE-fault = the cooler can't handle even LIGHT load (ds: 90C @ load 1.04). Heat at HIGH load is
    # load-pressure (mesh-therm/mesh-stress own that), NOT a hardware fault — don't false-FAIL a busy node.
    local lowload; lowload=$(awk "BEGIN{print ($load<1.5)?1:0}")
    if [ "$lowload" = 1 ] && [ "$maxt" -ge 85 ]; then note "" "FAIL: hot (${maxt}C) at LOW load (${load}) -> cooling failing (ds dead-cooler signature)"; fail=1
    elif [ "$lowload" = 1 ] && [ "$maxt" -ge 82 ]; then note "" "WARN: warm (${maxt}C, gap ${gap}C) at LOW load -> cooling weakening, approaching the 85C dead-cooler FAIL"; warn=1
    # NB: WARN is tied to ABSOLUTE temp (82-84C band), NOT the gap alone — a warm CPU in a cool room makes
    # a big gap that is NOT a fault (was a recurring false [hw-warn] at 79C/gap-59 on a normal-warm laptop).
    elif [ "$maxt" -ge 90 ]; then note "" "note: hot ${maxt}C but at load ${load} = load-driven (see mesh-therm/stress), NOT a hardware fault"; fi
  else note "thermal" "n/a"; fi
  # fan
  local fanrpm=""; for f in /sys/class/hwmon/*/fan*_input; do [ -r "$f" ] && fanrpm="$fanrpm $(cat "$f" 2>/dev/null)"; done
  fanrpm="$(echo $fanrpm)"
  if [ -n "$fanrpm" ]; then note "fan" "RPM:$fanrpm"
    if [ "$maxt" -ge 70 ] && echo " $fanrpm " | grep -qw 0; then note "" "FAIL: a fan reads 0 RPM while hot -> dead/stalled fan"; fail=1; fi
  else note "fan" "n/a (not exposed via hwmon here)"; fi
  # disk SMART
  if command -v smartctl >/dev/null 2>&1; then
    local d; d=$(lsblk -dno NAME,TYPE 2>/dev/null | awk '$2=="disk"{print $1; exit}')
    local h; h=$(sudo -n smartctl -H "/dev/$d" 2>/dev/null | grep -iE 'overall-health|SMART Health' | tail -1)
    note "disk" "${h:-/dev/$d (smartctl present; needs root)}"
  else
    # NVMe hwmon temp (no smartctl needed — kernel exposes via /sys/class/nvme/<n>/hwmon*)
    local nvme_out=""
    for hwm in /sys/class/nvme/*/hwmon*/temp1_input; do
      [ -r "$hwm" ] || continue
      local nv_raw; nv_raw=$(cat "$hwm" 2>/dev/null)
      [ -z "$nv_raw" ] && continue
      local nv_t=$((nv_raw/1000))
      local nv_crit; nv_crit=$(cat "${hwm%temp1_input}temp1_crit" 2>/dev/null); nv_crit=$((${nv_crit:-0}/1000))
      local nv_max; nv_max=$(cat "${hwm%temp1_input}temp1_max" 2>/dev/null); nv_max=$((${nv_max:-0}/1000))
      nvme_out+="nvme=${nv_t}°C"
      [ "${nv_max:-0}" -gt 0 ] && nvme_out+="(throttle@${nv_max}°C)"
      if [ "${nv_crit:-0}" -gt 0 ] && [ "$nv_t" -ge "$nv_crit" ]; then
        note "disk" "$nvme_out FAIL: NVMe at/above critical (${nv_crit}°C)"; fail=1; break
      elif [ "${nv_max:-0}" -gt 0 ] && [ "$nv_t" -ge "$nv_max" ]; then
        note "disk" "$nvme_out WARN: NVMe at throttle threshold"; warn=1; break
      else note "disk" "${nvme_out} ok"; fi
    done
    [ -z "$nvme_out" ] && note "disk" "n/a (no smartctl, no NVMe hwmon)"
  fi
  # battery wear
  local got=0 b fnow fdes pct
  for b in /sys/class/power_supply/BAT* /sys/class/power_supply/battery; do
    [ -d "$b" ] || continue
    fnow=$(cat "$b/charge_full" 2>/dev/null || cat "$b/energy_full" 2>/dev/null)
    fdes=$(cat "$b/charge_full_design" 2>/dev/null || cat "$b/energy_full_design" 2>/dev/null)
    if [ -n "${fnow:-}" ] && [ -n "${fdes:-}" ] && [ "$fdes" -gt 0 ]; then
      pct=$((fnow*100/fdes)); got=1; note "battery" "health ${pct}% of design ($(cat "$b/status" 2>/dev/null))"
      [ "$pct" -lt 50 ] && { note "" "WARN: battery heavily worn (<50% of design)"; warn=1; }
    fi
  done
  [ "$got" = 0 ] && note "battery" "n/a"
  # remote node load-proxy (no direct sensors — estimate thermal pressure from normalized load)
  # NOTE: this is a LOAD PROXY, not a cooling-fault detector. A dead cooler (HOT-at-LOW-load)
  # is undetectable by load alone — real temp needs coretemp/sensors on the node itself.
  local remote_nodes="${MESH_HW_REMOTE:-}"  # set in ~/.mesh/nodes: MESH_HW_REMOTE="user@host ..."
  for rnode in $remote_nodes; do
    local ruser="${rnode%%@*}"
    local rload rproc rnorm rest
    rload=$(ssh -o ConnectTimeout=5 -o BatchMode=yes "$rnode" "cat /proc/loadavg" 2>/dev/null | awk '{print $1}') || continue
    rproc=$(ssh -o ConnectTimeout=5 -o BatchMode=yes "$rnode" "nproc" 2>/dev/null) || continue
    rnorm=$(awk "BEGIN{printf \"%.2f\", $rload/$rproc}")
    # calibration: idle(0.25/core)=35°C, full(1.0/core)=75°C (load-proxy only)
    rest=$(awk "BEGIN{
      nl=$rnorm; if(nl<0.25)nl=0.25; if(nl>1.0)nl=1.0;
      t=35+(nl-0.25)*(40/0.75); printf \"%.0f\", t
    }")
    note "remote" "${ruser}: load-proxy est ${rest}°C @ load ${rload} (nproc=${rproc}, norm=${rnorm})"
    # High load-proxy = node is working hard (not a cooling fault — that's HOT-at-LOW-load)
    if [ "$rest" -ge 65 ]; then note "" "WARN: ${ruser} load-proxy high (${rest}°C) — node under heavy load (NOT a cooling-fault signal)"; warn=1; fi
  done

  [ "$fail" = 1 ] && { echo "HW: FAIL"; return 1; }
  [ "$warn" = 1 ] && { echo "HW: WARN"; return 0; }
  echo "HW: OK"
}

if [ "${1:-}" = --edge ]; then
  state="$MESH/.hw-health.state"; out="$(report)"; verdict="$(printf '%s\n' "$out" | grep -oE 'HW: (OK|WARN|FAIL)' | tail -1)"
  prev="$(cat "$state" 2>/dev/null || echo)"; printf '%s\n' "$verdict" > "$state"
  if [ -n "$prev" ] && [ "$verdict" != "$prev" ] && command -v mesh-chat >/dev/null 2>&1; then
    tag="$(printf '%s' "$verdict" | grep -oiE 'ok|warn|fail' | tr 'A-Z' 'a-z')"
    detail="$(printf '%s\n' "$out" | grep -iE 'FAIL|WARN|thermal|battery|fan' | tr '\n' ' ' | cut -c1-220)"
    MESH_WHO="hw-health@$(hostname)" mesh-chat "[hw-$tag] $(hostname) hardware: $detail" >/dev/null 2>&1
  fi
  printf '%s\n' "$out" | tail -1
  exit 0
fi

report
