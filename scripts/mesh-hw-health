#!/usr/bin/env bash
# mesh-hw-health — per-node HARDWARE health check (operator ask 2026-06-14, after the ds dead-cooler case).
# Complements mesh-doctor (software/organs) with the HARDWARE layer: cooling-efficiency / fan / thermal /
# disk SMART / battery wear. Catches a failing cooler EARLY — the ds signature was a COLD board (27°C) +
# HOT cpu (90°C) at LIGHT load (1.04) = heat not leaving the die. Honest n/a where a sensor isn't exposed
# (laptops vary). Local, quota-free.
#   mesh-hw-health          report + overall HW: OK|WARN|FAIL (exit 0 ok/warn, 1 fail)
#   mesh-hw-health --test   smoke
set -uo pipefail
[ "${1:-}" = --test ] && { ls /sys/class/thermal/thermal_zone*/temp >/dev/null 2>&1 && echo "smoke-test: ok" || echo "smoke-test: ok (no thermal zones — will n/a)"; exit 0; }
warn=0; fail=0
note(){ printf '  %-9s %s\n' "$1" "$2"; }
echo "=== mesh-hw-health $(hostname) $(date -u +%H:%MZ) ==="

# --- thermal / cooling efficiency (the ds-killer signal) ---
maxt=0
for z in /sys/class/thermal/thermal_zone*/temp; do t=$(( $(cat "$z" 2>/dev/null || echo 0)/1000 )); [ "$t" -gt "$maxt" ] && maxt=$t; done
ambient=$(for z in /sys/class/thermal/thermal_zone*/temp; do echo $(( $(cat "$z" 2>/dev/null||echo 0)/1000 )); done | sort -n | awk '$1>15{print;exit}')
ambient=${ambient:-0}; load=$(awk '{print $1}' /proc/loadavg); gap=$((maxt - ambient))
if [ "$maxt" -gt 0 ]; then
  note "thermal" "max ${maxt}°C · ambient ~${ambient}°C · gap ${gap}°C · load ${load}"
  lowload=$(awk "BEGIN{print ($load<1.5)?1:0}")
  if [ "$maxt" -ge 90 ]; then note "" "⚠ FAIL: at/over throttle (≥90°C)"; fail=1
  elif [ "$lowload" = 1 ] && [ "$gap" -ge 55 ]; then note "" "⚠ WARN: big CPU↔ambient gap at LOW load → cooling may be failing (cf ds dead-fan)"; warn=1
  elif [ "$maxt" -ge 85 ]; then note "" "⚠ WARN: hot (${maxt}°C)"; warn=1; fi
else note "thermal" "n/a"; fi

# --- fan ---
fanrpm=""; for f in /sys/class/hwmon/*/fan*_input; do [ -r "$f" ] && fanrpm="$fanrpm $(cat "$f" 2>/dev/null)"; done
fanrpm="$(echo $fanrpm)"
if [ -n "$fanrpm" ]; then note "fan" "RPM:$fanrpm"
  if [ "$maxt" -ge 70 ] && echo " $fanrpm " | grep -qw 0; then note "" "⚠ FAIL: a fan reads 0 RPM while hot → dead/stalled fan"; fail=1; fi
else note "fan" "n/a (not exposed via hwmon here — check physically/BIOS)"; fi

# --- disk SMART ---
if command -v smartctl >/dev/null 2>&1; then
  d=$(lsblk -dno NAME,TYPE 2>/dev/null | awk '$2=="disk"{print $1; exit}')
  h=$(sudo -n smartctl -H "/dev/$d" 2>/dev/null | grep -iE 'overall-health|SMART Health' | tail -1)
  note "disk" "${h:-/dev/$d (smartctl present; needs root for health)}"
else note "disk" "n/a (no smartctl)"; fi

# --- battery wear ---
got_bat=0
for b in /sys/class/power_supply/BAT* /sys/class/power_supply/battery; do
  [ -d "$b" ] || continue
  fnow=$(cat "$b/charge_full" 2>/dev/null || cat "$b/energy_full" 2>/dev/null)
  fdes=$(cat "$b/charge_full_design" 2>/dev/null || cat "$b/energy_full_design" 2>/dev/null)
  if [ -n "${fnow:-}" ] && [ -n "${fdes:-}" ] && [ "$fdes" -gt 0 ]; then
    pct=$((fnow*100/fdes)); got_bat=1
    note "battery" "health ${pct}% of design ($(cat "$b/status" 2>/dev/null))"
    [ "$pct" -lt 50 ] && { note "" "⚠ WARN: battery heavily worn (<50% of design)"; warn=1; }
  fi
done
[ "$got_bat" = 0 ] && note "battery" "n/a (no battery / not exposed)"

[ "$fail" = 1 ] && { echo "HW: FAIL"; exit 1; }
[ "$warn" = 1 ] && { echo "HW: WARN"; exit 0; }
echo "HW: OK"
