#!/usr/bin/env bash
# mesh-quota — the single TRUTH surface for the mind pool's quota: who's walled, who's
# live, when paid quota resets, and whether we are WASTING limits (paid quota live but
# minds idle) or burning DOWNTIME (paid windows walled with no fallback). Read-only.
#
# WHY (operator 2026-06-21): "лимит обнулился в 3:50, меш не подхватил — руками в 5:17 …
# научиться у всех минд считать, прогнозировать спринт, размазывать лод, downtime
# минимальный, и не высаживать лимиты впустую." This is the count/forecast/waste view the
# mesh-allocation + auto-resume reflexes act on. It does NOT itself relaunch minds (that is
# channel-keepalive / mesh-quota-resume) — it is the honest dashboard they and the operator read.
#
# HONESTY RULE: the providers expose NO remaining-quota feed. We do NOT invent a ceiling or a
# fake "you'll hit the wall at HH:MM". We report only OBSERVED truth: live wall-state (scan the
# paid panes), the reset countdown the banner actually stated, and the real burn RATE. A source
# that cannot testify renders UNKNOWN, never a confident zero (see mesh-freshness / fusion rule).
#
#   mesh-quota              one-screen status (paid wall-state + burn + waste/downtime flags)
#   mesh-quota --json       machine-readable
#   mesh-quota --watch      self-refreshing (for a data pane); SECS via $2 or MESH_QUOTA_WATCH (default 20)
#   mesh-quota --test       smoke
#
# Paid (claude) windows default to the manifest: minds genome tg. Override: MESH_CLAUDE_WINDOWS.
# reflex-cadence: (none — on-demand + data-pane; the acting reflexes are channel-keepalive/quota-resume)
# orphan-ok: read-only dashboard, invoked on demand + by mesh-dash minds
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
MESH="$HOME/.mesh"; SESS="$(hostname)"
SPEND_LOG="${MESH_SPEND_LOG:-$MESH/spend.log}"
CLAUDE_WINDOWS="${MESH_CLAUDE_WINDOWS:-minds genome tg}"   # the paid/anthropic-quota panes (manifest)
# WEEKLY position (operator 2026-06-25 "посчитать где мы по лимитам"). HONEST per the rule above:
# the providers expose no remaining-quota feed, so the CAP is operator-set, never invented. Used = REAL
# paid round-trips over the rolling 7d window (counted from spend.log, same unit as burn). A % and the
# 80% [fyi] appear ONLY when MESH_WEEKLY_PAID_CAP is set; unset → we show the real used count + 'cap unset'.
WEEKLY_CAP="${MESH_WEEKLY_PAID_CAP:-}"          # paid round-trips per 7d the operator's plan allows (numeric); unset = honest no-ceiling
WEEKLY_RESET="${MESH_WEEKLY_RESET:-}"           # when the weekly limit rolls over, GNU-date parseable (e.g. 'wednesday 04:00'); unset = '—'
WEEKLY_ALERT_STAMP="$MESH/.quota-weekly-alerted"

# shared wall-banner classifier (inline fallback so a missing lib never blanks the verdict)
if [ -f "$HOME/.local/bin/mesh-patterns.sh" ]; then . "$HOME/.local/bin/mesh-patterns.sh" 2>/dev/null || true
elif [ -f "$(dirname "$0")/mesh-patterns.sh" ]; then . "$(dirname "$0")/mesh-patterns.sh" 2>/dev/null || true; fi
type rl_is_walled >/dev/null 2>&1 || rl_is_walled(){ grep -qiE 'hit your (usage|session) limit|usage limit reached|too many requests|429|out of credits|upgrade to (pro|team)'; }

now=$(date +%s)

# --- pane introspection ---------------------------------------------------------------
pane_of(){ # $1=window → "win.idx" of the MIND (bottom) pane, else empty
  local n; n=$(tmux list-panes -t "$SESS:$1" 2>/dev/null | wc -l); [ "${n:-0}" -ge 1 ] || return 1
  tmux list-panes -t "$SESS:$1" -F '#{pane_top} #{pane_index}' 2>/dev/null | sort -n | tail -1 | awk '{print $2}'
}
engine_of(){ # $1=win.idx → live engine COMM in the pane subtree (claude/opencode/codex/agy/gemini/node), else '-'
  local pid; pid=$(tmux display -p -t "$SESS:$1" '#{pane_pid}' 2>/dev/null) || { echo '-'; return; }
  local e; e=$(pstree -p "$pid" 2>/dev/null | grep -oE 'claude|opencode|codex|agy|gemini' | head -1)
  [ -z "$e" ] && e=$(ps --ppid "$pid" -o comm= 2>/dev/null | grep -oE 'claude|opencode|codex|agy|gemini|node' | head -1)
  echo "${e:-?}"
}
walled_of(){ # $1=win.idx → "yes"/"no" if the pane shows a live quota wall
  tmux capture-pane -t "$SESS:$1" -p -S -15 2>/dev/null | rl_is_walled && echo yes || echo no
}
reset_in(){ # $1=window → seconds-to-reset from the rl-cooldown mark, else empty
  local m="$MESH/.rl-cooldown-$1"; [ -f "$m" ] || return 1
  local ep; ep=$(cut -d'|' -f1 "$m" 2>/dev/null); [ -n "$ep" ] || return 1
  local s=$(( ep - now )); [ "$s" -gt 0 ] && echo "$s" || return 1
}
busy_of(){ # $1=win.idx → WORKING/IDLE/UNKNOWN by footer spinner
  local t; t=$(tmux capture-pane -t "$SESS:$1" -p -S -6 2>/dev/null | grep -vE '^[[:space:]]*$' | tail -4)
  printf '%s\n' "$t" | grep -qiE 'esc to interrupt|…[[:space:]]*\([0-9]|ing\.\.\.[[:space:]]*\([0-9]' && { echo WORKING; return; }
  printf '%s\n' "$t" | grep -qiE 'auto mode on|\? for shortcuts|Ask anything|ctrl\+p commands' && { echo IDLE; return; }
  echo UNKNOWN
}

hms(){ local s=$1; printf '%dh%02dm' $((s/3600)) $(((s%3600)/60)); }
fmt_gap(){ local s=$1; [ "$s" -ge 60 ] && printf '%dm' $((s/60)) || printf '%ds' "$s"; }

# Is the SPEND GOVERNOR deliberately holding dispatch right now? (chat-review/quota-idle-verdict-
# blind-to-governor-hold) A fresh ~/.mesh/pace/dispatch stamp = mesh-pace is pacing paid spend, so an
# idle claude window is the governor WORKING, not wasted quota — the feed-work nag there is a standing
# false-action-prompt that desensitises the real nag once the hold lifts. Ask the single source of
# truth (mesh-pace --status, READ-ONLY — never records) and echo the remaining gap seconds if held.
# RECURSION GUARD: mesh-pace's reserve multiplier (burn_mult) shells out to `mesh-quota` to read the
# paid burn → mesh-quota→mesh-pace→mesh-quota. MESH_QUOTA_IN_PACE, exported onto the mesh-pace call,
# is inherited by that nested mesh-quota; this early-return makes the nested copy skip the pace probe.
pace_hold_remain(){ # echo remaining hold seconds if dispatch is HELD now, else return 1
  [ -z "${MESH_QUOTA_IN_PACE:-}" ] || return 1      # we ARE the nested burn probe — never recurse
  command -v mesh-pace >/dev/null 2>&1 || return 1
  local row rem st
  row=$(MESH_QUOTA_IN_PACE=1 mesh-pace --status 2>/dev/null | awk '$1=="dispatch"{print $4" "$5; exit}')
  [ -n "$row" ] || return 1
  rem=${row%% *}; st=${row##* }; rem=${rem%s}
  [ "$st" = skip ] || return 1                       # PASS / absent key = not holding
  case "$rem" in ''|*[!0-9]*) return 1;; esac
  printf '%s' "$rem"
}

emit_verdict(){ # the actionable, honest read — uses the PAID_* / MIN_RESET globals collect() sets
  printf '  verdict: '
  local rem
  if [ "$PAID_WALLED" -gt 0 ] && [ "$PAID_LIVE" -eq 0 ] && [ "$PAID_FALLBACK" -eq 0 ]; then
    local rt="unknown"; [ -n "$MIN_RESET" ] && rt="$(hms "$MIN_RESET")"
    printf '\033[1;31mDOWNTIME — all paid windows walled, no fallback; reset in %s\033[0m\n' "$rt"
  elif [ "$PAID_FALLBACK" -gt 0 ] && [ "$PAID_WALLED" -eq 0 ]; then
    printf '\033[1;33m%d paid window(s) on FALLBACK engine while claude not walled — claude quota likely idle/unused\033[0m\n' "$PAID_FALLBACK"
  elif [ "$PAID_IDLE_LIVE" -gt 0 ]; then
    if rem=$(pace_hold_remain); then
      # governor HOLDING → idle is the pace working, not waste. Informational (not yellow) so it never
      # desensitises the real feed-work nag once the hold lifts.
      printf '%d live claude window(s) idle — held by spend governor (%s of gap left)\n' "$PAID_IDLE_LIVE" "$(fmt_gap "$rem")"
    else
      printf '\033[1;33m%d live claude window(s) IDLE — paid quota available but unused (feed work / dont waste limits)\033[0m\n' "$PAID_IDLE_LIVE"
    fi
  elif [ "$PAID_LIVE" -gt 0 ]; then
    printf '\033[1;32mhealthy — %d claude window(s) live & working\033[0m\n' "$PAID_LIVE"
  else
    printf 'mixed — see rows above\n'
  fi
}

# --- burn rate from spend.log (units = sampled turns ≈ round-trips) --------------------
units_since(){ # $1=minutes back, $2=tier(paid|free|"")  → count of unit lines
  [ -f "$SPEND_LOG" ] || { echo 0; return; }
  local cut; cut=$(date -u -d "$1 minutes ago" +%Y-%m-%dT%H:%M 2>/dev/null) || { echo 0; return; }
  awk -v c="$cut" -v t="${2:-}" '$1>c && (t=="" || $6==t){n++} END{print n+0}' "$SPEND_LOG"
}

# --- weekly limit position (honest: real used, operator-set cap only) ------------------
weekly_used(){ units_since 10080 paid; }   # paid round-trips over rolling 7d
weekly_reset_txt(){ # countdown to the operator-declared weekly rollover, else '—'
  [ -n "$WEEKLY_RESET" ] || { printf '%s' '—'; return; }
  local nr now; nr=$(date -d "$WEEKLY_RESET" +%s 2>/dev/null) || { printf '%s' '—'; return; }
  now=$(date +%s); [ "$nr" -le "$now" ] && nr=$(date -d "$WEEKLY_RESET next week" +%s 2>/dev/null || echo "$nr")
  [ "$nr" -gt "$now" ] && printf 'in %s' "$(hms $((nr-now)))" || printf '%s' '—'
}
weekly_line(){ # one line for the minds DATA pane — 'weekly(paid): ~<used> rt/7d · cap <…> · reset <…>'
  # DISPLAY is bucketed to nearest 10 rt so the line doesn't churn (and re-wake the minds mind) every
  # single paid round-trip — fresh/stale-bucket philosophy (operator 2026-06-25). The % below uses the
  # EXACT count (weekly_alert too); only the printed used is rounded.
  local used disp cap pct capf col='\033[0m'; used=$(weekly_used); disp=$(( (used + 5) / 10 * 10 ))
  if [ -n "$WEEKLY_CAP" ] && printf '%s' "$WEEKLY_CAP" | grep -qE '^[0-9]+$' && [ "$WEEKLY_CAP" -gt 0 ]; then
    pct=$(( used * 100 / WEEKLY_CAP ))
    [ "$pct" -ge 80 ] && col='\033[1;31m' || { [ "$pct" -ge 60 ] && col='\033[1;33m' || col='\033[1;32m'; }
    capf="$(printf '%b%d%% of %d%b' "$col" "$pct" "$WEEKLY_CAP" '\033[0m')"
  else
    capf='unset (set MESH_WEEKLY_PAID_CAP to enable %/80% alert)'
  fi
  printf '  weekly(paid): ~%s rt/7d · cap %s · reset %s\n' "$disp" "$capf" "$(weekly_reset_txt)"
}
weekly_alert(){ # cheap [fyi] when we cross ~80% of a SET cap — stamp-throttled to once per crossing
  [ -n "$WEEKLY_CAP" ] && printf '%s' "$WEEKLY_CAP" | grep -qE '^[0-9]+$' && [ "$WEEKLY_CAP" -gt 0 ] || exit 0
  local used pct; used=$(weekly_used); pct=$(( used * 100 / WEEKLY_CAP ))
  if [ "$pct" -ge 80 ]; then
    grep -qx "$pct-cross" "$WEEKLY_ALERT_STAMP" 2>/dev/null && exit 0   # already alerted at this %
    command -v mesh-chat >/dev/null 2>&1 && mesh-chat "[fyi] weekly paid limit at ${pct}% ($used/$WEEKLY_CAP rt over 7d) — throttle paid dispatch / lean on free pool" || true
    printf '%s-cross\n' "$pct" > "$WEEKLY_ALERT_STAMP"
  else
    [ -f "$WEEKLY_ALERT_STAMP" ] && rm -f "$WEEKLY_ALERT_STAMP"   # dropped back under 80% → re-arm
  fi
  exit 0
}

# --- gather paid-window state ---------------------------------------------------------
collect(){
  PAID_LIVE=0; PAID_WALLED=0; PAID_FALLBACK=0; PAID_IDLE_LIVE=0; MIN_RESET=""; ROWS=()
  for w in $CLAUDE_WINDOWS; do
    local p eng wl busy rs state
    p=$(pane_of "$w") || { ROWS+=("$w|MISSING|-|-|-"); continue; }
    eng=$(engine_of "$w.$p"); wl=$(walled_of "$w.$p"); busy=$(busy_of "$w.$p")
    rs=$(reset_in "$w" || true)
    if [ "$wl" = yes ]; then
      state=WALLED; PAID_WALLED=$((PAID_WALLED+1))
      if [ -n "$rs" ]; then [ -z "$MIN_RESET" ] && MIN_RESET=$rs; [ "$rs" -lt "$MIN_RESET" ] && MIN_RESET=$rs; fi
    elif [ "$eng" = claude ]; then
      state=LIVE; PAID_LIVE=$((PAID_LIVE+1))
      [ "$busy" = IDLE ] && PAID_IDLE_LIVE=$((PAID_IDLE_LIVE+1))
    elif [ "$eng" = "-" ] || [ "$eng" = "?" ]; then
      state=DOWN
    else
      state=FALLBACK:$eng; PAID_FALLBACK=$((PAID_FALLBACK+1))
    fi
    ROWS+=("$w|$state|$eng|$busy|${rs:-}")
  done
}

emit_text(){
  collect
  local u1p u5p u1f u5f; u1p=$(units_since 60 paid); u5p=$(units_since 300 paid)
  u1f=$(units_since 60 free); u5f=$(units_since 300 free)
  printf '\033[1mmesh-quota\033[0m · paid=anthropic(claude) · %s\n' "$(date '+%H:%M:%S')"
  printf '  paid windows (shared claude quota): %s\n' "$CLAUDE_WINDOWS"
  printf '  %-8s %-14s %-8s %-8s %s\n' WINDOW STATE ENGINE BUSY RESET
  printf '  %-8s %-14s %-8s %-8s %s\n' "------" "-----" "------" "----" "-----"
  local r; for r in "${ROWS[@]}"; do
    IFS='|' read -r w st eng busy rs <<<"$r"
    local rstxt="-"; [ -n "$rs" ] && rstxt="in $(hms "$rs")"
    local col='\033[0m'
    case "$st" in WALLED) col='\033[1;31m';; LIVE) col='\033[1;32m';; FALLBACK:*) col='\033[1;33m';; DOWN|MISSING) col='\033[1;31m';; esac
    printf '  '"$col"'%-8s %-14s\033[0m %-8s %-8s %s\n' "$w" "$st" "$eng" "$busy" "$rstxt"
  done
  printf '\n  burn (units≈round-trips):  paid %s/1h %s/5h   free %s/1h %s/5h\n' "$u1p" "$u5p" "$u1f" "$u5f"
  weekly_line
  # model-ladder position (written by mesh-quota-react — the pre-wall downshift reflex); read-only here
  if [ -f "$MESH/.model-ladder" ]; then
    local _lr; _lr=$(cut -d'|' -f1 "$MESH/.model-ladder" 2>/dev/null)
    if printf '%s' "$_lr" | grep -qE '^[0-9]+$' && [ "$_lr" -gt 0 ]; then
      read -ra _lad <<<"${MESH_MODEL_LADDER:-default sonnet haiku}"
      printf '  \033[1;33mmodel-ladder: DOWNSHIFTED rung %s (/model %s) — quota-react pre-wall; auto-recovers\033[0m\n' "$_lr" "${_lad[$_lr]:-?}"
    fi
  fi

  # verdicts — the actionable, honest read
  emit_verdict
}

emit_json(){
  collect
  local first=1; printf '{"ts":%d,"paid_windows":"%s","burn":{"paid_1h":%s,"paid_5h":%s,"free_1h":%s,"free_5h":%s},"min_reset_s":%s,"windows":[' \
    "$now" "$CLAUDE_WINDOWS" "$(units_since 60 paid)" "$(units_since 300 paid)" "$(units_since 60 free)" "$(units_since 300 free)" "${MIN_RESET:-null}"
  local r; for r in "${ROWS[@]}"; do
    IFS='|' read -r w st eng busy rs <<<"$r"
    [ "$first" = 1 ] || printf ','; first=0
    printf '{"window":"%s","state":"%s","engine":"%s","busy":"%s","reset_s":%s}' "$w" "$st" "$eng" "$busy" "${rs:-null}"
  done
  local ph=false phr; phr=$(pace_hold_remain) && ph=true
  printf '],"flags":{"live":%d,"walled":%d,"fallback":%d,"idle_live":%d,"pace_held":%s,"pace_gap_left_s":%s}}\n' \
    "$PAID_LIVE" "$PAID_WALLED" "$PAID_FALLBACK" "$PAID_IDLE_LIVE" "$ph" "${phr:-null}"
}

case "${1:-}" in
  --fallback)   # mark a paid window's CURRENT engine as a quota-fallback → channel-keepalive auto-reverts it to claude on reset
    [ -n "${2:-}" ] || { echo "usage: mesh-quota --fallback <window>"; exit 2; }
    touch "$MESH/.quota-fallback-$2" && echo "marked $2 as quota-fallback → will auto-revert to claude when paid quota resets" ;;
  --clear-fallback)
    [ -n "${2:-}" ] || { echo "usage: mesh-quota --clear-fallback <window>"; exit 2; }
    rm -f "$MESH/.quota-fallback-$2" && echo "cleared quota-fallback mark for $2 (engine now treated as a sovereign operator choice)" ;;
  --weekly-alert) weekly_alert ;;   # cron-wireable: [fyi] on ≥80% of a SET cap (inert until MESH_WEEKLY_PAID_CAP set)
  --json) emit_json ;;
  --watch)
    secs="${2:-${MESH_QUOTA_WATCH:-20}}"
    while :; do printf '\033[H\033[2J'; emit_text; sleep "$secs"; done ;;
  --test)
    # state-machine smoke: prove the verdict logic + burn math without touching real panes.
    fail(){ echo "smoke-test: FAIL ($1)"; exit 1; }
    command -v tmux >/dev/null 2>&1 || fail "no tmux"
    type rl_is_walled >/dev/null 2>&1 || fail "rl_is_walled missing (patterns lib + fallback both absent)"
    # hms formatting
    [ "$(hms 3720)" = "1h02m" ] || fail "hms 3720 -> $(hms 3720)"
    # units_since on a synthetic log
    td=$(mktemp -d) || fail mktemp; trap 'rm -rf "$td"' EXIT
    nowln=$(date -u +%Y-%m-%dT%H:%M); old=$(date -u -d '10 hours ago' +%Y-%m-%dT%H:%M)
    { echo "$nowln turn genome claude anthropic paid x"; echo "$nowln turn chat opencode opencode free y"; echo "$old turn tg claude anthropic paid z"; } > "$td/s.log"
    [ "$(SPEND_LOG="$td/s.log" MESH_SPEND_LOG="$td/s.log"; SPEND_LOG="$td/s.log"; units_since 60 paid)" = 1 ] || fail "units_since paid 1h"
    [ "$(SPEND_LOG="$td/s.log"; units_since 60 free)" = 1 ] || fail "units_since free 1h"
    [ "$(SPEND_LOG="$td/s.log"; units_since 60 paid)" -le "$(SPEND_LOG="$td/s.log"; units_since 600 paid)" ] || fail "1h>10h impossible"
    # verdict branches via direct state injection
    PAID_WALLED=2 PAID_LIVE=0 PAID_FALLBACK=0; out=$( ROWS=(); MIN_RESET=600; CLAUDE_WINDOWS=""; { PAID_WALLED=2;PAID_LIVE=0;PAID_FALLBACK=0;PAID_IDLE_LIVE=0; if [ "$PAID_WALLED" -gt 0 ] && [ "$PAID_LIVE" -eq 0 ] && [ "$PAID_FALLBACK" -eq 0 ]; then echo DOWNTIME; fi; } )
    [ "$out" = DOWNTIME ] || fail "downtime verdict"
    # weekly position: honest no-ceiling when cap unset; real % when cap set; never a fabricated cap
    out=$(SPEND_LOG="$td/s.log" WEEKLY_CAP="" weekly_line); case "$out" in *"cap unset"*) : ;; *) fail "weekly cap-unset must say 'unset', got: $out";; esac
    out=$(SPEND_LOG="$td/s.log" WEEKLY_CAP=10 weekly_line); case "$out" in *"of 10"*) : ;; *) fail "weekly with cap must show '% of 10', got: $out";; esac
    case "$out" in *"rt/7d"*) : ;; *) fail "weekly line must report real used rt/7d";; esac
    # SPEND-GOVERNOR-AWARE IDLE VERDICT (chat-review/quota-idle-verdict-blind-to-governor-hold): an idle
    # claude window during a deliberate mesh-pace hold is the governor WORKING, not wasted quota — the
    # feed-work nag there is a false-action-prompt that desensitises the real nag. Driven against the
    # REAL mesh-pace (single source of truth) in a sandbox HOME: a fresh ~/.mesh/pace/dispatch stamp =
    # held, an aged one = released. reserve=0 so mesh-pace's burn probe never shells back into us here.
    command -v mesh-pace >/dev/null 2>&1 || fail "mesh-pace not on PATH (verdict-hold test needs the real gate)"
    qt=$(mktemp -d) || fail mktemp; mkdir -p "$qt/.mesh/pace"
    # HELD: fresh stamp + one idle live window → verdict names the hold, NOT feed-work (watched RED pre-fix)
    date +%s > "$qt/.mesh/pace/dispatch"
    out=$(HOME="$qt" MESH_PACE_GAP=600 MESH_PACE_RESERVE=0; PAID_WALLED=0 PAID_LIVE=1 PAID_FALLBACK=0 PAID_IDLE_LIVE=1 MIN_RESET=""; emit_verdict)
    case "$out" in *"held by spend governor"*) : ;; *) rm -rf "$qt"; fail "idle-during-hold verdict must name the governor, got: $out";; esac
    case "$out" in *"feed work"*) rm -rf "$qt"; fail "idle-during-hold verdict must NOT nag feed-work, got: $out";; esac
    case "$out" in *"of gap left"*) : ;; *) rm -rf "$qt"; fail "hold verdict must state remaining gap, got: $out";; esac
    # RELEASED: aged stamp (age > gap) → the feed-work nag returns
    echo $(( $(date +%s) - 100000 )) > "$qt/.mesh/pace/dispatch"
    out=$(HOME="$qt" MESH_PACE_GAP=600 MESH_PACE_RESERVE=0; PAID_WALLED=0 PAID_LIVE=1 PAID_FALLBACK=0 PAID_IDLE_LIVE=1 MIN_RESET=""; emit_verdict)
    case "$out" in *"feed work"*) : ;; *) rm -rf "$qt"; fail "idle with NO hold must return the feed-work nag, got: $out";; esac
    case "$out" in *"held by spend governor"*) rm -rf "$qt"; fail "no hold stands but verdict claimed a governor hold, got: $out";; esac
    # RECURSION GUARD: the nested burn-probe copy (MESH_QUOTA_IN_PACE set) must skip the pace probe →
    # falls through to feed-work, so mesh-pace's burn_mult can read our burn line without re-entering us.
    date +%s > "$qt/.mesh/pace/dispatch"
    out=$(MESH_QUOTA_IN_PACE=1 HOME="$qt" MESH_PACE_GAP=600 MESH_PACE_RESERVE=0; PAID_WALLED=0 PAID_LIVE=1 PAID_FALLBACK=0 PAID_IDLE_LIVE=1 MIN_RESET=""; emit_verdict)
    case "$out" in *"held by spend governor"*) rm -rf "$qt"; fail "recursion guard failed — nested burn probe still ran the pace probe, got: $out";; esac
    # SENTINEL PROPAGATION: prove mesh-quota EXPORTS MESH_QUOTA_IN_PACE onto its mesh-pace call (the
    # thing that actually breaks the recursion) via a stub mesh-pace that reports whether it saw it.
    sb=$(mktemp -d) || { rm -rf "$qt"; fail mktemp; }
    printf '#!/usr/bin/env bash\n[ "$1" = --status ] || exit 0\n[ -n "${MESH_QUOTA_IN_PACE:-}" ] && : > "$SENTINEL_FILE"\nprintf "  dispatch  0s  600s  600s  skip\\n"\n' > "$sb/mesh-pace"
    chmod +x "$sb/mesh-pace"
    SENTINEL_FILE="$sb/seen" PATH="$sb:$PATH" pace_hold_remain >/dev/null 2>&1
    [ -f "$sb/seen" ] || { rm -rf "$qt" "$sb"; fail "mesh-quota did not export MESH_QUOTA_IN_PACE onto its mesh-pace call — recursion guard is inert"; }
    rm -rf "$qt" "$sb"
    echo "smoke-test: ok"; exit 0 ;;
  ""|--text) emit_text ;;
  *) echo "usage: mesh-quota [--json|--watch [secs]|--test]"; exit 2 ;;
esac
