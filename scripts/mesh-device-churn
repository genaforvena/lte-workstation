#!/usr/bin/env bash
# mesh-device-churn — the EDGE half of this node's device instrumentation: did ANYTHING enumerate
# between two ticks?
#
# WHY (proven gap, discover 2026-08-18; writeup ~/.mesh/knowledge/capability-uevent-seqnum-zero-floor-
# device-churn-accumulator-mesh-home-20260818.md): every USB/uplink instrument here is a LEVEL sampled
# by cron — URB balance (enqueue-giveback), the xhci ep-context ring backlog, rtw88 rf_dump,
# /proc/net/wireless, power/runtime_*. A device that re-enumerates BETWEEN two ticks leaves all of them
# healthy: the ring resets, the URB balance returns to its floor of 0, and the levels are back to
# normal by the time anything looks. The node had NO edge source at all. Corroboration that it matters:
# the sole-uplink dongle (0bda:b82c at 1-2.3) carries runtime_active+suspended = 22.44h against an
# uptime of 26.08h — it re-enumerated ~3.6h into that boot and not one instrument recorded it.
#
# /sys/kernel/uevent_seqnum is mode 0444, readable as uid 1000, and is a MONOTONIC ACCUMULATOR of every
# device uevent since boot — so one integer read covers 100% of the interval (CLAUDE.md: "the sample is
# not the interval"), where a level sample covers only the instant it was taken. Its IDLE FLOOR is
# exactly 0 (re-measured while writing this: 5228 -> 5228 over 15.0s with minds, grinder and room ear
# live), which is what makes it usable: a nonzero interval delta is a real device event, not noise.
#
# WHAT IT CANNOT DO — these are in the rendering, not just this comment:
#   - seqnum NAMES NO DEVICE. It is a "something churned" bit and answers *did anything enumerate in
#     this window*, never *what*. A candidate list IS emitted on churn, but it comes from a DIFFERENT
#     and weaker instrument (per-device age = runtime_active+suspended vs uptime) and can legitimately
#     be empty for a real churn — a REMOVAL leaves no sysfs node to age, and non-USB subsystems are not
#     scanned at all. It is labelled `candidates=` and never presented as the seqnum's answer.
#   - THE LIFETIME TOTAL IS NOT A RATE. 5154 events / 26.08h = 197.6/h is arithmetic, not a rate: boot
#     enumeration dominates the total and the live idle rate is 0. Same trap as RTF-on-a-short-clip in
#     CLAUDE.local.md. Only the measured interval delta is quoted as an event count; the total is
#     rendered as `total-since-boot=` and never divided.
#   - THE COUNTER RESETS AT REBOOT. A delta straddling a reboot renders `na` — never 0 (a reboot-reset
#     counter read as 0 is a fabricated calm) and never a negative.
#   - The naming half now EXISTS beside this one: `mesh-udev-stream` (2026-08-18) holds a long-lived
#     `udevadm monitor --udev` listener and names what enumerated. It is a separate tool on purpose —
#     a daemon's lifetime/restart/log-growth is a different wiring cost from this cron read — and it
#     cross-checks itself against THIS counter (an accumulator delta with no named event is its GAP
#     verdict). The old note here that `udevadm monitor --kernel` "printed nothing at all, not even a
#     header" as uid 1000 DID NOT REPRODUCE (2026-08-18, same node/uid, stdout on a pipe): it printed
#     its header AND delivered the same triggered event as `--udev`, SEQNUM=5269, 2.5ms earlier.
#   - This does NOT replace the level instruments. It is the missing edge half beside them.
#   - THE BOARD TAPE IS A NUMERATOR. Only CHURN boards (a QUIET post would be pure noise), so a
#     reviewer reading the room sees 100% CHURN from every node and can only ever conclude the sense
#     never goes quiet — measured 2026-08-27: phaedra's board tape 92/92 CHURN against its own local
#     tape 2182 QUIET / 179 CHURN (92.4% quiet), mesh-home 85/85 CHURN against 645/1413 QUIET. That
#     gap MANUFACTURED task d580d53e ("QUIET is unreachable, measure the floor from history"), whose
#     premise was the tape's own selection. So every boarded line now CARRIES its own denominator —
#     the passes and their verdicts since the last post — and names where the whole tape lives. The
#     local log is the denominator tier and always was; the board line no longer hides it.
#
#   mesh-device-churn           one delta pass: read, emit, advance the baseline, board a churn
#   mesh-device-churn --check   read-only: same reading, no baseline advance, no board post
#   mesh-device-churn --status  last reading, no new read
#   mesh-device-churn --test    every verdict from fixtures + a real read of this node's counter
#
# exit 0 = QUIET or BASELINE · 1 = CHURN (an EVENT in the interval — go look; not by itself a fault:
# a plugged stick and a wedged uplink re-enumerating produce the same bit) · 2 = honest n/a
# (counter unreadable, or the interval straddles a reboot so no delta exists)
#
# reflex-cadence: */5 * * * *
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"   # cron self-defense (siblings by bare name)

SEQF="${MESH_DEVICE_CHURN_SEQ:-/sys/kernel/uevent_seqnum}"
BOOTF="${MESH_DEVICE_CHURN_BOOTID:-/proc/sys/kernel/random/boot_id}"
BASE="${MESH_DEVICE_CHURN_BASE:-$HOME/.mesh/.device-churn.baseline}"
STATE="${MESH_DEVICE_CHURN_STATE:-$HOME/.mesh/.device-churn.state}"
OLOG="${MESH_DEVICE_CHURN_LOG:-$HOME/.mesh/device-churn.log}"
MARK="${MESH_DEVICE_CHURN_MARK:-$HOME/.mesh/.device-churn.posted}"
TALLY="${MESH_DEVICE_CHURN_TALLY:-$HOME/.mesh/.device-churn.tally}"
USBROOT="${MESH_DEVICE_CHURN_USBROOT:-/sys/bus/usb/devices}"
MIN="${MESH_DEVICE_CHURN_MIN:-1}"                 # delta >= this is a CHURN
SLACK_S="${MESH_DEVICE_CHURN_SLACK:-60}"          # candidate window = interval + this
DEBOUNCE_MIN="${MESH_DEVICE_CHURN_DEBOUNCE_MIN:-30}"
CHAT="${MESH_DEVICE_CHURN_CHAT:-1}"

stamp(){ date -u +%FT%TZ; }
now_epoch(){ date -u +%s; }

# --- the accumulator ------------------------------------------------------------------------------
# Non-numeric or unreadable renders `na`. Never 0: a 0 here would be a claim that nothing has ever
# enumerated on this machine, which no failed read can support.
read_seq(){
  local SEQF="${MESH_DEVICE_CHURN_SEQ:-/sys/kernel/uevent_seqnum}"
  local v
  v="$(cat "$SEQF" 2>/dev/null)" || { echo na; return; }
  case "$v" in ''|*[!0-9]*) echo na; return;; esac
  printf '%s\n' "$v"
}
# boot_id is the reboot detector, not uptime: uptime regression only catches a reboot that happened to
# shorten the clock, while boot_id changes on EVERY boot and cannot be faked by a suspend/resume.
read_bootid(){ local BOOTF="${MESH_DEVICE_CHURN_BOOTID:-/proc/sys/kernel/random/boot_id}" v
  v="$(cat "$BOOTF" 2>/dev/null)"; [ -n "$v" ] && printf '%s\n' "$v" || echo na; }
read_uptime(){ awk '{printf "%d\n", $1}' /proc/uptime 2>/dev/null || echo na; }

# --- the candidate list (a DIFFERENT, weaker instrument) ------------------------------------------
# Per the deployed rule usb-device-age-is-runtime-active-plus-suspended-ms, a USB device's age is
# runtime_active_time + runtime_suspended_time. A device younger than the interval enumerated DURING
# it. This is corroboration, not attribution: removals leave nothing to age, and only USB is scanned.
# $1 = the interval in seconds. Takes USBROOT from the env so the test can build a fake sysfs tree.
fresh_devices(){
  local USBROOT="${MESH_DEVICE_CHURN_USBROOT:-/sys/bus/usb/devices}"
  local win="$1" d a s age out=""
  [ -d "$USBROOT" ] || { echo na; return; }
  for d in "$USBROOT"/*/; do
    a="$(cat "$d/power/runtime_active_time" 2>/dev/null)"; s="$(cat "$d/power/runtime_suspended_time" 2>/dev/null)"
    case "$a$s" in ''|*[!0-9]*) continue;; esac
    age=$(( (a + s) / 1000 ))
    [ "$age" -le "$win" ] && out="$out${out:+,}$(basename "$d")@${age}s"
  done
  printf '%s\n' "${out:-none}"
}

# --- the verdict ----------------------------------------------------------------------------------
# Pure: baseline fields in, reading fields in, `<verdict>|<rc>|<delta>|<sentence>` out. Separated from
# every read so the test drives each branch without a reboot, a churn, or an unreadable sysfs.
decide(){
  local MIN="${MESH_DEVICE_CHURN_MIN:-1}" SEQF="${MESH_DEVICE_CHURN_SEQ:-/sys/kernel/uevent_seqnum}"
  local bseq="$1" bboot="$2" seq="$3" boot="$4" iv="$5"
  if [ "$seq" = na ]; then
    printf 'NA|2|na|%s is unreadable or non-numeric — we did not look, which is not the same as nothing churned; the baseline is left UNTOUCHED so the next pass still spans this gap\n' "$SEQF"; return
  fi
  if [ -z "$bseq" ] || [ "$bseq" = na ]; then
    printf 'BASELINE|0|na|first sight: recorded seqnum %s as the baseline and claimed NO delta — replaying a lifetime total as fresh events is the reviving-offset trap\n' "$seq"; return
  fi
  if [ "$boot" != na ] && [ "$bboot" != na ] && [ "$boot" != "$bboot" ]; then
    printf 'REBOOT|2|na|the interval straddles a reboot (boot_id changed) so the counter reset and NO delta exists for it — rendered na, never 0, because a reset counter read as 0 is a fabricated calm; re-baselined at %s\n' "$seq"; return
  fi
  if [ "$seq" -lt "$bseq" ] 2>/dev/null; then
    printf 'REBOOT|2|na|seqnum went BACKWARDS (%s -> %s) with no boot_id change — a monotonic counter cannot, so the reading is untrustworthy rather than negative; rendered na and re-baselined\n' "$bseq" "$seq"; return
  fi
  local d=$(( seq - bseq ))
  if [ "$d" -ge "$MIN" ] 2>/dev/null; then
    printf 'CHURN|1|%s|%s device uevent(s) in the last %ss — the idle floor here is 0, so this is a real enumeration event, invisible to every level instrument (URB balance, xhci ring, rf_dump, runtime_*) which are all back to healthy by now. seqnum names NO device\n' "$d" "$d" "$iv"; return
  fi
  printf 'QUIET|0|%s|no device uevent in the last %ss (100%% interval coverage — an accumulator delta, not a sample)\n' "$d" "$iv"
}

# --- the board line's own denominator ------------------------------------------------------------
# Only CHURN boards, so the board tape is a NUMERATOR: read as a distribution it says 100% CHURN from
# any node whatever the node is doing (a-tape-of-only-positives-is-a-numerator). The denominator has
# always existed in $OLOG — one row per pass, QUIET included — but nothing carried it to the reader
# who was actually being misled. This tally counts the passes between two BOARD POSTS (not between two
# runs: a CHURN the debounce suppresses must not reset it) and the boarded line renders it inline.
#
# TSV: passes<TAB>quiet<TAB>churn<TAB>other<TAB>since_epoch<TAB>src
# `src` is provenance, not decoration: a tally created on THIS pass reads passes=1 churn=1, which is
# the very "100% CHURN" shape this fix exists to kill — it renders `fresh` so the first post after a
# deploy cannot be read as a distribution. Missing or malformed renders `unsampled` with NO numbers:
# zeros here would be a claim that no quiet pass happened, which a failed read cannot support.
tally_read(){
  local TALLY="${MESH_DEVICE_CHURN_TALLY:-$HOME/.mesh/.device-churn.tally}"
  local p q c o e src
  [ -s "$TALLY" ] || return 1
  IFS=$'\t' read -r p q c o e src < "$TALLY"
  case "$p$q$c$o$e" in ''|*[!0-9]*) return 1;; esac
  printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$p" "$q" "$c" "$o" "$e" "${src:-tally}"
}
# $1 = this pass's verdict. Write passes ONLY — a --check that moved the tally would let a read-only
# probe rewrite the denominator its own boarded siblings are judged against.
tally_bump(){
  local TALLY="${MESH_DEVICE_CHURN_TALLY:-$HOME/.mesh/.device-churn.tally}"
  local v="$1" nowe="$2" p=0 q=0 c=0 o=0 e="$2" src=fresh cur
  if cur="$(tally_read)"; then
    IFS=$'\t' read -r p q c o e src <<< "$cur"
    src=tally
  fi
  p=$(( p + 1 ))
  case "$v" in
    QUIET) q=$(( q + 1 ));;
    CHURN) c=$(( c + 1 ));;
    *)     o=$(( o + 1 ));;
  esac
  mkdir -p "$(dirname "$TALLY")" 2>/dev/null
  printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$p" "$q" "$c" "$o" "$e" "$src" > "$TALLY"
}
# Renders the clause appended to the BOARD line only. $1 = now (epoch).
# `span` is published beside `passes` and is NOT the denominator: this node power-cycles, and a span
# that crosses a power-off counts hours in which no pass could have run
# (an-age-that-spans-a-power-off-is-not-a-silence). passes is the denominator; span is context.
tally_render(){
  local nowe="$1" cur p q c o e src span
  if ! cur="$(tally_read)"; then
    printf 'since-post=unsampled\n'; return
  fi
  IFS=$'\t' read -r p q c o e src <<< "$cur"
  span=$(( nowe - e )); [ "$span" -ge 0 ] 2>/dev/null || span=na
  printf 'since-post=passes=%s quiet=%s churn=%s other=%s span=%ss src=%s\n' "$p" "$q" "$c" "$o" "$span" "$src"
}
tally_reset(){
  local TALLY="${MESH_DEVICE_CHURN_TALLY:-$HOME/.mesh/.device-churn.tally}"
  mkdir -p "$(dirname "$TALLY")" 2>/dev/null
  printf '0\t0\t0\t0\t%s\ttally\n' "$1" > "$TALLY"
}

# --- one pass -------------------------------------------------------------------------------------
pass(){   # $1 = 1 write / 0 --check
  local write="$1" seq boot up bseq="" bboot="" bepoch="" iv v rc delta msg cand line nowe
  seq="$(read_seq)"; boot="$(read_bootid)"; up="$(read_uptime)"; nowe="$(now_epoch)"
  if [ -s "$BASE" ]; then
    IFS=$'\t' read -r bseq bboot bepoch < "$BASE"
  fi
  case "$bepoch" in ''|*[!0-9]*) iv=na;; *) iv=$(( nowe - bepoch ));; esac
  v="$(decide "${bseq:-}" "${bboot:-na}" "$seq" "$boot" "$iv")"
  rc="${v#*|}"; rc="${rc%%|*}"
  delta="${v#*|*|}"; delta="${delta%%|*}"
  msg="${v#*|*|*|}"; v="${v%%|*}"
  cand=""
  if [ "$v" = CHURN ]; then
    case "$iv" in ''|*[!0-9]*) cand="$(fresh_devices "$SLACK_S")";; *) cand="$(fresh_devices "$(( iv + SLACK_S ))")";; esac
  fi
  # `total-since-boot` is deliberately never divided by uptime: the lifetime total is dominated by boot
  # enumeration, so an events/h figure would be arithmetic wearing a rate's clothes.
  line="$(stamp) $v delta=$delta interval=${iv}s total-since-boot=$seq uptime=${up}s boot=${boot:0:8} baseline=${bseq:-none}${cand:+ candidates=$cand} :: $msg"
  [ -n "$cand" ] && line="$line || candidates come from device-age-vs-uptime, a DIFFERENT instrument — 'none' is compatible with a real churn (a removal leaves no node to age; only USB is scanned)"
  printf '%s\n' "$line"
  [ "$write" = 1 ] || return "$rc"
  mkdir -p "$(dirname "$STATE")" 2>/dev/null
  printf '%s\n' "$line" > "$STATE"
  printf '%s\n' "$line" >> "$OLOG"
  # A BLIND pass must not advance or drop the baseline: skipping past leaves the churn during the
  # blindness permanently unaccounted, and rebuilding it would replay the whole lifetime total.
  if [ "$v" != NA ]; then printf '%s\t%s\t%s\n' "$seq" "$boot" "$nowe" > "$BASE"; fi
  # mtime = ran-live, content = the change-gated reading (liveness-touch convention: a node that is
  # quiet for days must not read as a dead reflex to mesh-reflex-health/mesh-pulse).
  command -v mesh-state-touch >/dev/null 2>&1 && mesh-state-touch "$STATE" >/dev/null 2>&1
  # The denominator advances on EVERY write pass, QUIET included — tallying only the passes that
  # board would rebuild the very numerator this exists to break.
  tally_bump "$v" "$nowe"
  if [ "$v" = CHURN ] && [ "$CHAT" = 1 ] && command -v mesh-chat >/dev/null 2>&1; then
    local last=0
    [ -f "$MARK" ] && last="$(cat "$MARK" 2>/dev/null | tr -dc '0-9')"
    [ -n "$last" ] || last=0
    if [ "$(( nowe - last ))" -ge "$(( DEBOUNCE_MIN * 60 ))" ]; then
      local den; den="$(tally_render "$nowe")"
      MESH_WHO="device-churn@$(hostname)" mesh-chat "[fyi] device-churn on $(hostname): $line || $den — DENOMINATOR: only CHURN boards, so this board tape read as a distribution says 100% CHURN from any node whatever it is doing; these are the passes since the LAST POST of this line and the whole per-pass tape (QUIET included) is $OLOG" >/dev/null 2>&1 || true
      printf '%s\n' "$nowe" > "$MARK"
      tally_reset "$nowe"
    fi
  fi
  return "$rc"
}

# --- test -----------------------------------------------------------------------------------------
run_test(){
  local fails=0 out
  F(){ echo "smoke-test: FAIL ($1)" >&2; fails=$((fails+1)); }
  # (0) THE SUITE'S OWN FORGERY GATE. Every durable artifact of this node must be byte-identical after
  #     the run: a --test that writes the tape a human reads forges the evidence it exists to check.
  #     Recorded here, asserted at the end — the end-to-end arms below run the REAL script, so one
  #     un-sandboxed path variable is all it takes (the tally leaked exactly this way while being written).
  local live_before; live_before="$(for f in "$BASE" "$STATE" "$OLOG" "$MARK" "$TALLY"; do
    printf '%s:%s:%s\n' "$f" "$( [ -e "$f" ] && echo yes || echo no )" "$(cat "$f" 2>/dev/null | cksum)"; done)"
  local B=aaaa-bbbb
  # (1) the reading this sense exists for: a delta the level instruments cannot see.
  out="$(decide 100 $B 104 $B 300)"
  case "$out" in CHURN\|1\|4\|*) : ;; *) F "a +4 delta did not read CHURN with delta 4 (got: $out)";; esac
  # (2) ...and its complement. The idle floor is 0, so QUIET must be reachable — a sense whose quiet
  #     state cannot occur is an alarm, not a sense.
  out="$(decide 100 $B 100 $B 300)"
  case "$out" in QUIET\|0\|0\|*) : ;; *) F "a 0 delta did not read QUIET (got: $out)";; esac
  # (3) FIRST SIGHT records, never replays. A node whose counter is already at 5228 must not report
  #     5228 fresh events on the reflex's first ever run.
  out="$(decide "" na 5228 $B na)"
  case "$out" in BASELINE\|0\|na\|*) : ;; *) F "first sight did not baseline with delta na (got: $out)";; esac
  case "$out" in *"|5228|"*) F "first sight replayed the lifetime total as a delta";; esac
  # (4) REBOOT renders na, never 0 and never negative — the fabricated-calm gate, driven BOTH ways
  #     (boot_id change, and a backwards counter with no boot_id change).
  out="$(decide 9000 $B 12 cccc-dddd 300)"
  case "$out" in REBOOT\|2\|na\|*) : ;; *) F "a boot_id change did not render REBOOT/na (got: $out)";; esac
  case "$out" in *"|0|"*|*"|-"*) F "a reboot rendered a fabricated 0 or a negative delta";; esac
  out="$(decide 9000 $B 12 $B 300)"
  case "$out" in REBOOT\|2\|na\|*) : ;; *) F "a backwards counter did not render REBOOT/na (got: $out)";; esac
  # (5) an unreadable counter is `na`, NOT quiet — and it must say we did not look.
  out="$(decide 100 $B na $B 300)"
  case "$out" in NA\|2\|na\|*) : ;; *) F "an unreadable counter did not render NA (got: $out)";; esac
  case "$out" in *"did not look"*) : ;; *) F "the NA sentence does not distinguish blind from quiet";; esac
  # (6) the threshold decides, both directions.
  out="$(MESH_DEVICE_CHURN_MIN=5 decide 100 $B 103 $B 300)"; case "$out" in CHURN*) F "delta 3 fired a MIN=5 threshold";; esac
  out="$(MESH_DEVICE_CHURN_MIN=5 decide 100 $B 105 $B 300)"; case "$out" in CHURN*) : ;; *) F "delta 5 did not reach a MIN=5 threshold";; esac
  # (7) the candidate list is a real sysfs scan, driven against a FAKE tree so both answers are seen.
  local sr; sr="$(mktemp -d)"
  mkdir -p "$sr/1-2.3/power" "$sr/usb1/power"
  printf '9000\n' > "$sr/1-2.3/power/runtime_active_time"; printf '0\n' > "$sr/1-2.3/power/runtime_suspended_time"
  printf '108000000\n' > "$sr/usb1/power/runtime_active_time"; printf '0\n' > "$sr/usb1/power/runtime_suspended_time"
  out="$(MESH_DEVICE_CHURN_USBROOT="$sr" fresh_devices 60)"
  case "$out" in *1-2.3@9s*) : ;; *) F "a 9s-old device was not listed as a candidate in a 60s window (got: $out)";; esac
  case "$out" in *usb1*) F "a 108000s-old device was listed as freshly enumerated";; esac
  out="$(MESH_DEVICE_CHURN_USBROOT="$sr" fresh_devices 1)"
  [ "$out" = none ] || F "a 1s window still matched a 9s-old device (got: $out)"
  out="$(MESH_DEVICE_CHURN_USBROOT="$sr/nonexistent" fresh_devices 60)"
  [ "$out" = na ] || F "an absent usb root did not render na (got: $out)"
  rm -rf "$sr"
  # (8) the na-vs-0 rule at the READ layer, not just the verdict layer.
  out="$(MESH_DEVICE_CHURN_SEQ=/nonexistent-seqnum read_seq)"; [ "$out" = na ] || F "an absent counter file did not read na (got: $out)"
  local tf; tf="$(mktemp)"; printf 'not-a-number\n' > "$tf"
  out="$(MESH_DEVICE_CHURN_SEQ="$tf" read_seq)"; [ "$out" = na ] || F "a non-numeric counter did not read na (got: $out)"
  rm -f "$tf"
  # (9) END TO END, sandboxed. A blind pass must leave the baseline BYTE-IDENTICAL — advancing past a
  #     gap loses the churn inside it, dropping it replays the lifetime total.
  local bb ss ll mm; bb="$(mktemp)"; ss="$(mktemp)"; ll="$(mktemp)"; mm="$(mktemp)"; rm -f "$ss" "$ll" "$mm"
  printf '100\t%s\t%s\n' "$(read_bootid)" "$(( $(now_epoch) - 300 ))" > "$bb"
  local before; before="$(cat "$bb")"
  local tt; tt="$(mktemp)"; rm -f "$tt"
  local E="MESH_DEVICE_CHURN_BASE=$bb MESH_DEVICE_CHURN_STATE=$ss MESH_DEVICE_CHURN_LOG=$ll MESH_DEVICE_CHURN_MARK=$mm MESH_DEVICE_CHURN_TALLY=$tt MESH_DEVICE_CHURN_CHAT=0"
  env $E MESH_DEVICE_CHURN_SEQ=/nonexistent-seqnum bash "${BASH_SOURCE[0]}" >/dev/null 2>&1
  [ "$(cat "$bb")" = "$before" ] || F "a BLIND pass advanced or dropped the baseline"
  case "$(cat "$ss" 2>/dev/null)" in *NA*) : ;; *) F "a blind pass did not write the NA verdict";; esac
  # ...a real churn advances it and writes the delta.
  local sf; sf="$(mktemp)"; printf '107\n' > "$sf"
  env $E MESH_DEVICE_CHURN_SEQ="$sf" MESH_DEVICE_CHURN_BOOTID="$BOOTF" bash "${BASH_SOURCE[0]}" >/dev/null 2>&1
  case "$(cat "$ss")" in *"CHURN delta=7"*) : ;; *) F "a +7 pass did not write CHURN delta=7 (got: $(cat "$ss"))";; esac
  case "$(cat "$ss")" in *candidates=*) : ;; *) F "a churn line carries no candidates field";; esac
  case "$(cat "$ss")" in *"total-since-boot=107"*) : ;; *) F "the line does not carry the lifetime total, labelled";; esac
  [ "$(cut -f1 "$bb")" = 107 ] || F "a real pass did not advance the baseline (got $(cut -f1 "$bb"))"
  # ...and the immediate re-run is QUIET, i.e. a delta is consumed exactly once.
  env $E MESH_DEVICE_CHURN_SEQ="$sf" MESH_DEVICE_CHURN_BOOTID="$BOOTF" bash "${BASH_SOURCE[0]}" >/dev/null 2>&1
  case "$(cat "$ss")" in *"QUIET delta=0"*) : ;; *) F "the same delta was replayed on the next pass (got: $(cat "$ss"))";; esac
  # (10) --check MUST NOT write — a sense that writes its own liveness artifact forges it.
  local b2 s2; b2="$(mktemp)"; s2="$(mktemp)"; rm -f "$s2"
  cp "$bb" "$b2"; before="$(cat "$b2")"
  MESH_DEVICE_CHURN_BASE="$b2" MESH_DEVICE_CHURN_STATE="$s2" MESH_DEVICE_CHURN_LOG="$s2.log" \
    MESH_DEVICE_CHURN_MARK="$s2.mark" MESH_DEVICE_CHURN_TALLY="$tt" MESH_DEVICE_CHURN_CHAT=0 MESH_DEVICE_CHURN_SEQ="$sf" \
    bash "${BASH_SOURCE[0]}" --check >/dev/null 2>&1
  { [ -e "$s2" ] || [ -e "$s2.log" ]; } && F "--check wrote the state/log artifact"
  [ "$(cat "$b2")" = "$before" ] || F "--check advanced the baseline"
  rm -f "$bb" "$ss" "$ll" "$mm" "$tt" "$sf" "$b2" "$s2" "$s2.log" "$s2.mark"
  # (11) NEVER A RATE: no rendered line may carry an events-per-hour style figure derived from the
  #      lifetime total. Boot enumeration dominates it; the live idle rate is 0.
  out="$(decide 100 $B 104 $B 300)$(decide 100 $B 100 $B 300)"
  case "$out" in *"/h"*|*"per hour"*|*"events/s"*) F "a rendered line quotes the lifetime total as a rate";; esac
  # (12) REAL READ of this node's own counter — a test that only drives stubs has never touched the
  #      thing it wraps. Monotonic and numeric, read twice.
  local r1 r2
  r1="$(read_seq)"; r2="$(read_seq)"
  case "$r1" in ''|*[!0-9]*) F "real read of $SEQF returned no integer (got: $r1)";; esac
  case "$r2" in ''|*[!0-9]*) : ;; *) [ "$r2" -ge "$r1" ] 2>/dev/null || F "the real counter went backwards within one pass ($r1 -> $r2)";; esac
  [ "$(read_bootid)" = na ] && F "real boot_id read returned na — the reboot gate would be permanently blind"
  case "$(fresh_devices 0)" in na) F "real usb scan rendered na — the candidate leg is blind on this node";; esac
  # (13) THE DENOMINATOR, at the unit layer. Every verdict lands in its OWN bucket and `passes`
  #      advances on all of them — a tally that only counted the boarded verdict would rebuild the
  #      numerator this whole leg exists to break.
  local tl; tl="$(mktemp)"; rm -f "$tl"
  local T="MESH_DEVICE_CHURN_TALLY=$tl"
  env $T bash -c 'source "$1"; tally_bump QUIET 1000' _ "${BASH_SOURCE[0]}" 2>/dev/null
  env $T bash -c 'source "$1"; tally_bump QUIET 1001' _ "${BASH_SOURCE[0]}" 2>/dev/null
  env $T bash -c 'source "$1"; tally_bump CHURN 1002' _ "${BASH_SOURCE[0]}" 2>/dev/null
  env $T bash -c 'source "$1"; tally_bump NA    1003' _ "${BASH_SOURCE[0]}" 2>/dev/null
  out="$(env $T bash -c 'source "$1"; tally_render 1300' _ "${BASH_SOURCE[0]}" 2>/dev/null)"
  case "$out" in *"passes=4"*) : ;; *) F "the tally did not count every pass (got: $out)";; esac
  case "$out" in *"quiet=2"*) : ;; *) F "QUIET passes are missing from the denominator (got: $out)";; esac
  case "$out" in *"churn=1"*) : ;; *) F "the tally miscounted CHURN (got: $out)";; esac
  case "$out" in *"other=1"*) : ;; *) F "a blind/reboot pass is missing from the denominator (got: $out)";; esac
  case "$out" in *"span=300s"*) : ;; *) F "the tally did not carry its own span (got: $out)";; esac
  # ...and the window START is pinned at the first bump, never re-stamped by later ones.
  case "$out" in *"src=tally"*) : ;; *) F "a tally with 4 passes still renders as fresh (got: $out)";; esac
  # (14) A TALLY IT COULD NOT READ RENDERS `unsampled` WITH NO NUMBERS. Zeros here would claim no
  #      quiet pass happened, which a failed read cannot support — the na-vs-0 rule, one tier out.
  out="$(MESH_DEVICE_CHURN_TALLY=/nonexistent-tally bash -c 'source "$1"; tally_render 99' _ "${BASH_SOURCE[0]}" 2>/dev/null)"
  [ "$out" = "since-post=unsampled" ] || F "an absent tally did not render unsampled (got: $out)"
  printf 'garbage\n' > "$tl"
  out="$(env $T bash -c 'source "$1"; tally_render 99' _ "${BASH_SOURCE[0]}" 2>/dev/null)"
  [ "$out" = "since-post=unsampled" ] || F "a malformed tally did not render unsampled (got: $out)"
  case "$out" in *=0*) F "an unreadable tally rendered a fabricated zero denominator (got: $out)";; esac
  # (15) A tally BORN on this pass renders `fresh`: passes=1 churn=1 is exactly the 100%-CHURN shape
  #      this fix kills, so the first post after a deploy must not be readable as a distribution.
  rm -f "$tl"
  env $T bash -c 'source "$1"; tally_bump CHURN 2000' _ "${BASH_SOURCE[0]}" 2>/dev/null
  out="$(env $T bash -c 'source "$1"; tally_render 2000' _ "${BASH_SOURCE[0]}" 2>/dev/null)"
  case "$out" in *"src=fresh"*) : ;; *) F "a tally born on this pass did not render src=fresh (got: $out)";; esac
  rm -f "$tl"
  # (16) END TO END THROUGH THE REAL BOARD PATH, under a poisoned PATH the subject cannot escape.
  #      This script re-exports $HOME/.local/bin ahead of everything, so a stub dir merely PREPENDED
  #      loses the race to the deployed tool — the fake home's own .local/bin must BE the stub dir.
  local FH; FH="$(mktemp -d)"; mkdir -p "$FH/.local/bin" "$FH/.mesh"
  { echo '#!/bin/sh'; echo "printf '%s\n' \"\$*\" >> \"$FH/chat.out\""; } > "$FH/.local/bin/mesh-chat"
  chmod +x "$FH/.local/bin/mesh-chat"
  local sq; sq="$FH/seq"; printf '100\n' > "$sq"
  printf '100\t%s\t%s\n' "$(read_bootid)" "$(( $(now_epoch) - 300 ))" > "$FH/.mesh/.device-churn.baseline"
  local RUN="env -i HOME=$FH PATH=$FH/.local/bin:/usr/bin:/bin MESH_DEVICE_CHURN_SEQ=$sq MESH_DEVICE_CHURN_BOOTID=$BOOTF"
  $RUN bash "${BASH_SOURCE[0]}" >/dev/null 2>&1          # QUIET
  $RUN bash "${BASH_SOURCE[0]}" >/dev/null 2>&1          # QUIET
  [ -s "$FH/chat.out" ] && F "a QUIET pass posted to the board"
  printf '105\n' > "$sq"
  $RUN bash "${BASH_SOURCE[0]}" >/dev/null 2>&1          # CHURN -> boards
  out="$(cat "$FH/chat.out" 2>/dev/null)"
  case "$out" in *"since-post=passes=3 quiet=2 churn=1 other=0"*) : ;; *) F "the boarded line does not carry its own denominator (got: $out)";; esac
  case "$out" in *"$FH/.mesh/device-churn.log"*) : ;; *) F "the boarded line does not name where the whole per-pass tape lives (got: $out)";; esac
  case "$out" in *"only CHURN boards"*) : ;; *) F "the boarded line does not state that its tape is a numerator";; esac
  # ...the post RESETS the window, and a CHURN the debounce suppresses does NOT — the tally spans to
  #    the last POST, never to the last run, or a suppressed episode would vanish from the count.
  printf '110\n' > "$sq"
  $RUN bash "${BASH_SOURCE[0]}" >/dev/null 2>&1          # CHURN, debounced
  [ "$(wc -l < "$FH/chat.out")" = 1 ] || F "the 30m debounce did not suppress the second CHURN post ($(wc -l < "$FH/chat.out") lines)"
  out="$(MESH_DEVICE_CHURN_TALLY="$FH/.mesh/.device-churn.tally" bash -c 'source "$1"; tally_render '"$(now_epoch)" _ "${BASH_SOURCE[0]}" 2>/dev/null)"
  case "$out" in *"passes=1 quiet=0 churn=1"*) : ;; *) F "the post did not reset the window, or a suppressed CHURN reset it (got: $out)";; esac
  # (17) --check MUST NOT MOVE THE DENOMINATOR its own boarded siblings are judged against.
  local tbefore; tbefore="$(cat "$FH/.mesh/.device-churn.tally")"
  $RUN bash "${BASH_SOURCE[0]}" --check >/dev/null 2>&1
  [ "$(cat "$FH/.mesh/.device-churn.tally")" = "$tbefore" ] || F "--check advanced the tally"
  rm -rf "$FH" "$tl"
  local live_after; live_after="$(for f in "$BASE" "$STATE" "$OLOG" "$MARK" "$TALLY"; do
    printf '%s:%s:%s\n' "$f" "$( [ -e "$f" ] && echo yes || echo no )" "$(cat "$f" 2>/dev/null | cksum)"; done)"
  [ "$live_after" = "$live_before" ] || F "the suite wrote this node's OWN durable artifacts: $(diff <(echo "$live_before") <(echo "$live_after") | tr '\n' ' ')"
  [ "$fails" = 0 ] || { echo "smoke-test: FAILED ($fails)" >&2; exit 1; }
  echo "smoke-test: ok (CHURN/QUIET/BASELINE/REBOOT/NA each driven; reboot + backwards counter render na never 0; first sight never replays the lifetime total; a blind pass leaves the baseline byte-identical; a delta is consumed once; candidates scan a real sysfs tree both ways; --check writes nothing and never moves the tally; no line quotes a rate; the boarded line carries its own denominator, resets only on a POST, and renders unsampled/fresh instead of a fabricated zero; real counter+boot_id+usb scan read on this node; every durable artifact of this node byte-identical after the run)"
  exit 0
}

# Sourcing must not run a pass: the test drives tally_bump/tally_render directly, and a source that
# fell through to the dispatch would write the REAL state files of the node running the suite.
# `$0` is the *caller's* argv[0], `BASH_SOURCE[0]` is this file — equal only when executed.
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
case "${1:-}" in
  --test)   run_test ;;
  --check)  pass 0; exit $? ;;
  --status) [ -s "$STATE" ] && { cat "$STATE"; exit 0; }; echo "no reading yet ($STATE)"; exit 2 ;;
  ""|--run) pass 1; exit $? ;;
  *) echo "usage: mesh-device-churn [--check|--status|--test]" >&2; exit 64 ;;
esac
fi
