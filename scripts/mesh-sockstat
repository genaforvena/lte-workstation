#!/usr/bin/env bash
# orphan-ok: on-demand sockstat poll — sampled (not continuous); a kernel-network-pressure
#   snapshot the operator can read alongside the fusions. Cheap to read.
# mesh-sockstat — the kernel's NETWORK-SOCKET-PRESSURE sense: a snapshot of /proc/net/sockstat.
#
# The Linux kernel maintains a table of open sockets (TCP, UDP, RAW, FRAG) and tracks state
# (inuse, orphan, time-wait, alloc). Distinct from existing network senses:
#   mesh-wifi-link      → link-layer quality (signal/RSSI) — the radio
#   mesh-wifi-motion    → WiFi RSSI multipath changes — the channel
#   mesh-selfcare       → per-node reachability (inet/TG/mesh) — the routes
#   mesh-sockstat       → kernel socket table state (TCP/UDP/orphans) — the SOCKET LAYER
#
# Reading /proc/net/sockstat gives us a per-protocol breakdown of the kernel's open-socket
# table. A high "orphan" count is a memory-leak indicator (closed connections not reaped by
# the application), a high "tw" (time-wait) count is connection-churn noise (normal after
# many short-lived HTTP/SSH connections), and a high "TCP:inuse" is just lots of active
# connections (e.g. a busy server).
#
# Classification (FALSIFIABLE via --test, bands are deliberately generous — these are
# coarse health signals, not a replacement for `ss -s`):
#   HEALTHY   TCP:inuse < 200 AND TCP:orphans < 5 AND TCP:tw < 200
#   BUSY      TCP:inuse >= 200 OR TCP:tw >= 200 (lots of active/churning connections, normal
#             on a busy server, possibly concerning on a workstation)
#   CONCERN   TCP:orphans >= 5 (closed-but-not-reaped connections — a possible app-leak)
#   UNKNOWN   /proc/net/sockstat unreadable (defensive; never a faked HEALTHY)
#
# Honest-exit contract:
#   0 = verdict produced (HEALTHY/BUSY/CONCERN)
#   2 = /proc/net/sockstat missing or unreadable — never a fabricated socket count
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
STATE="$HOME/.mesh/.sockstat-state"

# classify_sockstat <tcp_inuse> <tcp_orphans> <tcp_tw> → echoes "LABEL|reason"
classify_sockstat() {
  local inuse="$1" orphans="$2" tw="$3"
  # Defensive: non-numeric → UNKNOWN
  if [ -z "$inuse" ] || [ -z "$orphans" ] || [ -z "$tw" ] \
     || ! [ "$inuse" -ge 0 ] 2>/dev/null \
     || ! [ "$orphans" -ge 0 ] 2>/dev/null \
     || ! [ "$tw" -ge 0 ] 2>/dev/null; then
    echo "UNKNOWN|non-numeric input (inuse=$inuse orphans=$orphans tw=$tw)"
    return
  fi
  # CONCERN takes priority — orphan leak is the most actionable signal
  if [ "$orphans" -ge 5 ]; then
    echo "CONCERN|$orphans orphan socket(s) (closed but not reaped — possible app-leak)"
    return
  fi
  # BUSY: lots of active or churning connections
  if [ "$inuse" -ge 200 ] || [ "$tw" -ge 200 ]; then
    echo "BUSY|inuse=$inuse tw=$tw (lots of active/churning connections)"
    return
  fi
  echo "HEALTHY|inuse=$inuse orphans=$orphans tw=$tw"
}

# parse_sockstat <file> → echoes "inuse orphans tw" or returns 1
parse_sockstat() {
  local f="$1" inuse="" orphans="" tw=""
  [ -r "$f" ] || return 1
  # Format: "TCP: inuse 39 orphan 0 tw 11 alloc 44 mem 0"  (one proto per line)
  while IFS= read -r line; do
    case "$line" in
      TCP:*)
        # Extract inuse, orphan, tw via simple awk
        inuse="$(printf '%s' "$line" | awk '/TCP:/{for(i=1;i<=NF;i++){if($i=="inuse"){print $(i+1);exit}}}')"
        orphans="$(printf '%s' "$line" | awk '/TCP:/{for(i=1;i<=NF;i++){if($i=="orphan"){print $(i+1);exit}}}')"
        tw="$(printf '%s' "$line" | awk '/TCP:/{for(i=1;i<=NF;i++){if($i=="tw"){print $(i+1);exit}}}')"
        ;;
    esac
  done < "$f"
  # Defensive: any field missing → fail
  [ -n "$inuse" ] && [ -n "$orphans" ] && [ -n "$tw" ] || return 1
  printf '%s %s %s\n' "$inuse" "$orphans" "$tw"
}

if [ "${1:-}" = --test ]; then
  fail=0
  # HEALTHY: low everything
  r="$(classify_sockstat 39 0 11)"
  [ "$r" = "HEALTHY|inuse=39 orphans=0 tw=11" ] || { echo "  FAIL HEALTHY: got=$r"; fail=1; }
  # HEALTHY boundary: inuse=199, tw=199, orphans=4
  r="$(classify_sockstat 199 4 199)"
  [ "$r" = "HEALTHY|inuse=199 orphans=4 tw=199" ] || { echo "  FAIL HEALTHY-boundary: got=$r"; fail=1; }
  # BUSY: high inuse
  r="$(classify_sockstat 200 0 5)"
  [ "$r" = "BUSY|inuse=200 tw=5 (lots of active/churning connections)" ] || { echo "  FAIL BUSY-inuse: got=$r"; fail=1; }
  # BUSY: high time-wait
  r="$(classify_sockstat 50 0 200)"
  [ "$r" = "BUSY|inuse=50 tw=200 (lots of active/churning connections)" ] || { echo "  FAIL BUSY-tw: got=$r"; fail=1; }
  # CONCERN: orphans >= 5 (takes priority over BUSY)
  r="$(classify_sockstat 500 10 300)"
  [ "$r" = "CONCERN|10 orphan socket(s) (closed but not reaped — possible app-leak)" ] || { echo "  FAIL CONCERN-priority: got=$r"; fail=1; }
  # CONCERN: exactly 5 orphans
  r="$(classify_sockstat 10 5 0)"
  [ "$r" = "CONCERN|5 orphan socket(s) (closed but not reaped — possible app-leak)" ] || { echo "  FAIL CONCERN-5: got=$r"; fail=1; }
  # UNKNOWN: empty
  r="$(classify_sockstat '' '' '')"
  [ "$r" = "UNKNOWN|non-numeric input (inuse= orphans= tw=)" ] || { echo "  FAIL UNKNOWN-empty: got=$r"; fail=1; }
  # UNKNOWN: non-numeric
  r="$(classify_sockstat abc def ghi)"
  echo "$r" | grep -q '^UNKNOWN' || { echo "  FAIL UNKNOWN-nonnumeric: got=$r"; fail=1; }
  [ "$fail" = 1 ] && { echo "smoke-test: FAIL"; exit 1; }
  echo "  ok: classify (8 cases: HEALTHY×2, BUSY×2, CONCERN×2, UNKNOWN×2)"
  # REAL-READ gate: reachability ≠ producing. The /proc file must be readable AND produce a
  # 3-tuple (inuse, orphans, tw) or the sense is hollow (green test with no real artifact).
  _proc="/proc/net/sockstat"
  [ -r "$_proc" ] || { echo "smoke-test: n/a (/proc/net/sockstat unreadable — kernel not Linux? /procfs missing?); classify-logic ok"; exit 2; }
  _tup="$(parse_sockstat "$_proc")" || { echo "smoke-test: n/a (parse failed); classify-logic ok"; exit 2; }
  echo "smoke-test: ok (classify: 8 cases + REAL sockstat read: $_tup)"
  exit 0
fi

# --- Live read path ---
_proc="/proc/net/sockstat"
[ -r "$_proc" ] || {
  printf 'UNREACHABLE %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$STATE"
  mesh-state-touch "$STATE"
  echo "mesh-sockstat: $_proc not readable (kernel not Linux? /procfs missing?) — not an alarm" >&2
  exit 2
}
tup="$(parse_sockstat "$_proc")"
[ -n "$tup" ] || {
  printf 'UNREACHABLE %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$STATE"
  mesh-state-touch "$STATE"
  echo "mesh-sockstat: parse failed (tup='$tup') — not an alarm" >&2
  exit 2
}

TS=$(date -u +%Y-%m-%dT%H:%M:%SZ)
inuse="$(printf '%s' "$tup" | awk '{print $1}')"
orphans="$(printf '%s' "$tup" | awk '{print $2}')"
tw="$(printf '%s' "$tup" | awk '{print $3}')"

result="$(classify_sockstat "$inuse" "$orphans" "$tw")"
label="${result%%|*}"
reason="${result#*|}"

# Write state + touch liveness on EVERY successful run (mtime = ran-live, content = value-changed)
printf '%s|inuse=%s|orphans=%s|tw=%s|%s\n' "$label" "$inuse" "$orphans" "$tw" "$reason" > "$STATE"
mesh-state-touch "$STATE"

# --- Output ---
if [ "${1:-}" = --json ]; then
  printf '{"label":"%s","reason":"%s","inuse":%s,"orphans":%s,"tw":%s,"ts":"%s"}\n' \
    "$label" "$reason" "$inuse" "$orphans" "$tw" "$TS"
  exit 0
fi
printf '[sockstat-%s] %s — inuse=%s orphans=%s tw=%s | %s\n' \
  "$(printf '%s' "$label" | tr '[:upper:]' '[:lower:]')" "$label" "$inuse" "$orphans" "$tw" "$reason"
