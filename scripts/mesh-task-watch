#!/usr/bin/env bash
# reflex-cadence: */5 * * * *
# reflex-args: --window 290 --debounce 1 $HOME/.mesh/chat.log -- mesh-task-journal
# mesh-task-watch — compatibility entrypoint; core event watcher lives in scripts/core/.
set -u

self="${BASH_SOURCE[0]}"
case "$self" in */*) ;; *) self="$(command -v "$self")" || exit 127 ;; esac
while [ -L "$self" ]; do
  self_dir="$(CDPATH= cd -P "$(dirname "$self")" && pwd)" || exit 1
  link_target="$(readlink "$self")" || exit 1
  case "$link_target" in /*) self="$link_target" ;; *) self="$self_dir/$link_target" ;; esac
done
script_dir="$(CDPATH= cd -P "$(dirname "$self")" && pwd)" || exit 1
implementation="$script_dir/core/mesh-task-watch"
if [ ! -x "$implementation" ]; then
  repo_root="${MESH_REPO:-${MESH_GENOME:-$HOME/lte-workstation}}"
  implementation="$repo_root/scripts/core/mesh-task-watch"
fi
[ -x "$implementation" ] || {
  printf 'mesh-task-watch: implementation missing or not executable: %s\n' "$implementation" >&2
  exit 127
}
exec "$implementation" "$@"
