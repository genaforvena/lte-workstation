#!/usr/bin/env bash
# orphan-ok: on-demand sense — Note3 live screen video, pulled when a window wants to SEE the phone UI
# mesh-note3-screen — LIVE screen video from the Note3 (SM-N900) via the stock `screenrecord`.
#
# Streams the phone's SCREEN (not camera — Camera2 NDK is API 24+, this is API 21; stills use
# mesh-note3-cam). H.264/MP4. Useful to watch what the Note3 is showing (voice-out UI, app state,
# whatever's on the panel) from any window. Proven 2026-07-17 (valid MP4 pulled).
#
#   mesh-note3-screen [secs]     record <secs> (default 5) → prints MP4 path
#   mesh-note3-screen [secs] --raw   print MP4 path only
#   mesh-note3-screen --test     real gate: must produce a valid non-empty MP4 (exit 2 = unreachable)
#
# Exit codes: 0 = video captured · 2 = phone unreachable · 1 = reachable but no valid MP4
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes"

SERIAL="${MESH_NOTE3_ADB_SERIAL:-${MESH_BARO_ADB_SERIAL:-4d00553d61ab90b7}}"
ADB="adb -s $SERIAL"
OUTDIR="$HOME/.mesh/note3"; mkdir -p "$OUTDIR"
SIZE="${MESH_NOTE3_SCREEN_SIZE:-640x360}"  # Note3 AVC encoder rejects large/portrait sizes (err=-38); 640x360 landscape proven

SECS=5; RAW=0
for a in "$@"; do case "$a" in --raw) RAW=1;; --test) MODE=test;; [0-9]*) SECS="$a";; esac; done

capture() {   # record $SECS screen → pull to $1; echo byte size (empty on failure)
  local mp4="$1" rmp4="/data/local/tmp/note3-scr.mp4"
  timeout $((SECS + 15)) $ADB shell "screenrecord --time-limit $SECS --size $SIZE $rmp4" >/dev/null 2>&1 || return 1
  timeout 25 $ADB pull "$rmp4" "$mp4" >/dev/null 2>&1 || return 1
  stat -c%s "$mp4" 2>/dev/null
}

valid_mp4() { [ -n "$1" ] && [ "$1" -gt 200 ] 2>/dev/null && file "$2" 2>/dev/null | grep -qiE "MP4|ISO Media"; }

if [ "${MODE:-}" = test ]; then
  if ! timeout 8 $ADB shell "echo ok" 2>/dev/null | grep -q ok; then echo "smoke-test: n/a (Note3 unreachable)"; exit 2; fi
  SECS=2; sz="$(capture "$OUTDIR/.screen-test.mp4")"
  valid_mp4 "$sz" "$OUTDIR/.screen-test.mp4" && echo "smoke-test: ok (valid MP4 ${sz}B)" || { echo "smoke-test: FAIL (no valid MP4)"; exit 1; }
  exit 0
fi

MP4="$OUTDIR/screen-$(date +%s 2>/dev/null || echo latest).mp4"
sz="$(capture "$MP4")"
[ -z "$sz" ] && { echo "note3-screen: n/a (Note3 unreachable or screenrecord failed)"; exit 2; }
valid_mp4 "$sz" "$MP4" || { echo "note3-screen: reachable but no valid MP4"; exit 1; }
if [ "$RAW" = 1 ]; then echo "$MP4"; else echo "mp4=$MP4 secs=$SECS size=$SIZE bytes=$sz"; fi
