#!/usr/bin/env bash
# mesh-sweep-rollcall-proposes — detect unconverted roll-call PROPOSE lines (rollcall-propose-evaporates gap).
# Scans chat log for 'roll-call <chan>: PROPOSE <text>' older than 2 cycles (~2h) with no matching [task]/[done]
# posted since, surfaces each as '[fyi] stale-propose: <chan> proposed <text> at <ts>, never filed — review?' nudge.
# Usage: mesh-sweep-rollcall-proposes [--minutes N] [--test] [--post]
# --minutes N: age threshold in minutes (default: 120 = 2 roll-call cycles)
# --test: run smoke-test with fixture board (dedup-once, escalate-after-2, max-age-decline, converted-silent)
# --post: actually post the nudges/escalations to the board (default: dry-run)
#
# Nudge lifecycle (chat-review/rollcall-sweep-nudge-once, 2026-07-07): each stale PROPOSE is keyed by
# md5(channel:topic) in a state file ($HOME/.mesh/.rollcall-nudge-state, override via 4th run_sweep arg).
# 1st sweep -> nudge posted. 2nd sweep (still unconverted) -> silent, tracked. 3rd sweep (2 unanswered
# sweeps since the nudge) -> escalate ONCE to a [task] asking a human/mind to decide (file for real, or
# decline), then permanently silent. A PROPOSE older than MESH_ROLLCALL_MAX_AGE_MINUTES (default 10080 =
# 7 days) is declined on sight, before ever nudging — stops ancient (e.g. 12-day-old) proposals from
# recycling forever. Before this, the sweep re-posted the identical nudge on every hourly run with no
# memory (live: the same 7 stale-propose lines hit the board at 01:00/02:00/03:00 2026-07-07).
# (chat-review/rollcall-sweep-inert-cron, 2026-07-06: the prior 'hourly' prose cadence is not a
# valid 5-field cron schedule for mesh-autowire's own wiring, and reflexes.cron:173 wired this tool
# by BARE NAME with no --post — cron's minimal PATH never finds an unqualified $HOME/.local/bin
# name, and even when found it ran in silent dry-run forever: 0 stale-propose nudges ever posted
# while the roll-call digest kept escalating the same 3 RECURRING undecided PROPOSEs. Fixed by
# hand in reflexes.cron: absolute path + --post + a log redirect, matching every other wired
# reflex's form.)
# chat-review/rollcallprop-dedup-race-persists (2026-07-09): the cross-node board-scan dedup above
# (d357653) only catches a STAGGERED race — a peer's nudge already gossiped into $CHAT_LOG by the
# time this scan runs. It does NOT catch a CONCURRENT race: every mind node's reflex-cadence fires
# '0 * * * *' identically, so on the same tick two nodes both read a board missing each other's
# not-yet-posted line and BOTH mint (live: chat.log 2026-07-08T23:00:14-15Z, pub+health duplicated
# 0-1s apart, ~20h after the original fix). A check-then-act grep against an eventually-consistent
# log cannot see a write that hasn't happened yet on either side — no amount of re-checking closes
# that window. Fixed the same way mesh-mind-control's scan_orphans fixed the identical class of bug
# (chat-review/scanorphans-race-single-minter + -minter-unconfigured): designate ONE poster instead
# of racing. _rollcall_is_minter() elects the lexically-lowest hostname that posted to the shared
# board within the last 24h — every live host reads the SAME log, so all derive the SAME winner with
# zero coordination — and gates BOTH mint points (the :190 nudge and the :229 escalation, which had
# NO cross-node dedup at all before this fix, not even the staggered kind). A non-minter never mints
# and never advances its local state, so its next sweep re-checks the board-scan adopt path and
# converges onto whatever the minter posts once gossip lands it.
# reflex-cadence: 0 * * * *
# reflex-args: --post
set -uo pipefail

[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
export PATH="$HOME/.local/bin:$PATH"

key_hash() {
  printf '%s' "$1" | md5sum | awk '{print $1}'
}

# load_nudge_state <state-file> — populates global NUDGE_COUNT/NUDGE_STATUS assoc arrays.
load_nudge_state() {
  local state_file="$1"
  declare -gA NUDGE_COUNT NUDGE_STATUS
  NUDGE_COUNT=(); NUDGE_STATUS=()
  [ -f "$state_file" ] || return 0
  while IFS='|' read -r hash count status _rest; do
    [ -n "$hash" ] || continue
    NUDGE_COUNT["$hash"]="$count"
    NUDGE_STATUS["$hash"]="$status"
  done < "$state_file"
}

save_nudge_state() {
  local state_file="$1"
  : > "$state_file"
  for hash in "${!NUDGE_COUNT[@]}"; do
    printf '%s|%s|%s\n' "$hash" "${NUDGE_COUNT[$hash]}" "${NUDGE_STATUS[$hash]}" >> "$state_file"
  done
}

# _rollcall_is_minter <chat-log> — see chat-review/rollcallprop-dedup-race-persists above. Elects the
# single host allowed to mint (nudge/escalate) this round, so concurrent same-minute cron ticks across
# mind nodes converge on ONE poster instead of racing. MESH_ROLLCALL_MINTER pins an explicit override;
# MESH_ROLLCALL_HOSTNAME overrides the real hostname for hermetic multi-host test fixtures.
_rollcall_is_minter() {
  local log="$1" host="${MESH_ROLLCALL_HOSTNAME:-$(hostname)}" minter="${MESH_ROLLCALL_MINTER:-}"
  [ -n "$minter" ] && { [ "$host" = "$minter" ]; return; }
  [ -r "$log" ] || return 0   # nothing to elect from -> mint anyway (racy edge, never a silent drop)
  local cutoff
  cutoff="$(date -u -d '24 hours ago' +%FT%TZ 2>/dev/null)" || cutoff=""
  minter="$(awk -v cut="$cutoff" '$1 >= cut { n = split($2, a, "@"); if (n > 1) print a[n] }' "$log" 2>/dev/null | sort -u | head -1)"
  [ -n "$minter" ] || return 0
  [ "$host" = "$minter" ]
}

run_sweep() {
  set +u  # Disable unbound variable checking for arrays
  local CHAT_LOG="${1:-$HOME/.mesh/chat.log}"
  local THRESHOLD_MINUTES="${2:-120}"
  local DO_POST="${3:-false}"
  local STATE_FILE="${4:-$HOME/.mesh/.rollcall-nudge-state}"
  local MAX_AGE_MINUTES="${MESH_ROLLCALL_MAX_AGE_MINUTES:-10080}"  # 7 days — well under the 12-day live incident

  if [ ! -f "$CHAT_LOG" ]; then
    echo "Chat log not found: $CHAT_LOG"
    set -u
    return 0
  fi

  load_nudge_state "$STATE_FILE"

  # Current time for age calculation
  local now=$(date +%s)
  local cutoff=$((now - THRESHOLD_MINUTES * 60))
  local max_age_cutoff=$((now - MAX_AGE_MINUTES * 60))

  # Find roll-call PROPOSE lines older than threshold
  declare -A propose_times propose_texts propose_channels

  while IFS= read -r line; do
    # Extract timestamp and message
    local ts="${line%% *}"
    local rest="${line#* }"

    # Convert timestamp to seconds
    local ts_sec=$(date -d "$ts" +%s 2>/dev/null || echo 0)
    [ "$ts_sec" -eq 0 ] && continue          # Skip unparseable timestamps
    [ "$ts_sec" -gt "$cutoff" ] && continue  # Skip if too recent

    # Check if this is a roll-call PROPOSE line
    if [[ "$rest" =~ roll-call\ ([^:]+):\ PROPOSE\ (.+) ]]; then
      local channel="${BASH_REMATCH[1]}"
      local propose_text="${BASH_REMATCH[2]}"

      # Skip template/stub echoes — an unfilled placeholder or a null non-answer
      # isn't a real proposal, so it must never be stored/nudged/escalated. Beyond
      # the bare '<placeholder>'/'none' cases, catch the other null-answer forms that
      # otherwise slip through as PHANTOM proposals feeding the nudge/escalate ladder:
      # an empty/whitespace-only PROPOSE (17 seen live) and 'n/a'/'nothing…'
      # (chat-review/sweep-none-slug-phantom, 2026-07-11).
      local pt_trim="${propose_text#"${propose_text%%[![:space:]]*}"}"   # ltrim
      pt_trim="${pt_trim%"${pt_trim##*[![:space:]]}"}"                   # rtrim
      if [[ "$propose_text" =~ \<[^\>]*\> ]] \
         || [[ -z "$pt_trim" ]] \
         || [[ "$pt_trim" =~ ^([Nn][Oo][Nn][Ee]|[Nn]/?[Aa]|[Nn][Oo][Tt][Hh][Ii][Nn][Gg])([^A-Za-z]|$) ]]; then
        continue
      fi

      # 'unchanged (<slug>)' is DIFFERENT from a stub: it's the deliberate re-affirmation
      # format (chat-review/rollcall-propose-dedup, 2026-07-05) for a STILL-OPEN proposal
      # restated cheaply instead of reworded every round. Discarding it here (as a prior
      # version of this filter did) means a standing proposal can recur for days and NEVER
      # accumulate nudge-count/age state — confirmed live across 3 consecutive digests
      # (reflex-log-centralization x7, state-touch-reflexes x6, surface-MUTED-verdict x6,
      # ~10h, zero progress). Normalize to a stable "unchanged:<slug>" topic instead of
      # discarding, so it feeds the SAME nudge(0)->silent(1)->escalate(2) ladder below as any
      # other proposal (chat-review/rollcallprop-unchanged-blackhole, 2026-07-08).
      if [[ "$propose_text" =~ ^[Uu][Nn][Cc][Hh][Aa][Nn][Gg][Ee][Dd][[:space:]]*\(([^\)]+)\) ]]; then
        propose_text="unchanged:${BASH_REMATCH[1]}"
        # BUT a re-affirmed NULL answer is still a null answer: 'unchanged (none)'/'(n/a)'/'(nothing)'
        # normalizes to 'unchanged:none' etc and — unlike a bare 'none', which the pre-normalization
        # filter above catches — would otherwise be TRACKED as a live standing proposal, riding the
        # nudge->escalate ladder into a phantom [task] against a non-proposal (chat-review/
        # sweep-none-slug-phantom, 2026-07-11: sound's 07:00 'PROPOSE unchanged (none)' → nudge →
        # escalated stale-propose-72ce5eec demanding sound 'file or decline' a NULL). Skip the slug
        # when it's a null-answer form — semantically identical to the bare 'none' already dropped.
        local uc_slug="${propose_text#unchanged:}"
        uc_slug="${uc_slug#"${uc_slug%%[![:space:]]*}"}"; uc_slug="${uc_slug%"${uc_slug##*[![:space:]]}"}"
        if [[ -z "$uc_slug" ]] || [[ "$uc_slug" =~ ^([Nn][Oo][Nn][Ee]|[Nn]/?[Aa]|[Nn][Oo][Tt][Hh][Ii][Nn][Gg])([^A-Za-z]|$) ]]; then
          continue
        fi
      fi

      # Extract just the PROPOSE topic (first sentence or up to 80 chars)
      local propose_topic=$(echo "$propose_text" | cut -c1-80)

      # Store by channel+topic (avoid duplicates). Keep the EARLIEST timestamp seen for a
      # given key (first-occurrence wins) rather than overwriting on every later match — a
      # recurring 'unchanged' topic's true age is its ORIGINAL propose, not whichever repost
      # this scan happened to read last, so round-count/max-age accrue across the whole chain.
      local key="${channel}:${propose_topic}"
      if [ -z "${propose_times[$key]:-}" ]; then
        propose_times[$key]="$ts"
      fi
      propose_texts[$key]="$propose_topic"
      propose_channels[$key]="$channel"
    fi
  done < <(grep "roll-call.*PROPOSE" "$CHAT_LOG")

  if [ ${#propose_times[@]} -eq 0 ]; then
    echo "No stale roll-call PROPOSE lines found (older than ${THRESHOLD_MINUTES} minutes)"
    set -u
    return 0
  fi

  echo "Found ${#propose_times[@]} roll-call PROPOSE lines to check for conversion..."

  local nudged=0 escalated=0 declined=0 silent_tracked=0 converted=0

  for key in "${!propose_times[@]}"; do
    local propose_ts="${propose_times[$key]}"
    local propose_text="${propose_texts[$key]}"
    local channel="${propose_channels[$key]}"
    local hash
    hash=$(key_hash "$key")

    # Search the WHOLE board for a [task]/[done]/[design] that references this PROPOSE — NOT just
    # from the PROPOSE timestamp forward (chat-review/rollcallprop-task-before-propose, 2026-07-30,
    # verified by discover 18:45Z + health 19:08Z). A roll-call PROPOSE — especially the
    # 'PROPOSE unchanged' form — RE-SURFACES an already-open item per the roll-call skill's own
    # 'PROPOSE unchanged' convention; no re-file is expected. The old `sed -n "/${propose_ts}/,\$p"`
    # scanned only propose_ts→EOF, structurally blind to a [task] filed BEFORE the PROPOSE, so a
    # dutifully-filed-then-restated proposal was nagged 'never filed' every rotation and escalated
    # into a phantom [task] against a met obligation (live: discover's wire-state-voice-consent —
    # [task] filed 10:37Z, PROPOSE restated it 15:01Z, flagged 'never filed' 18:00Z). The obligation
    # is met if the item exists ANYWHERE on the board; scan the full log. The 3-token slug key +
    # unchanged-selfmatch guard below keep the wider window from false-converting on generic prose.
    local later_content=$(cat "$CHAT_LOG")

    # Check if there's a matching [task] or [done]
    local found_match=false
    # Strip the normalized 'unchanged:' marker before extracting the key (chat-review/
    # rollcallprop-unchanged-selfmatch, 2026-07-08): the bare word 'unchanged' is common
    # in unrelated board prose (81 hits/day), so keying on it made ANY later [task]/[done]
    # containing 'unchanged' falsely resolve the proposal — key on the <slug> only.
    local key_source="$propose_text"
    [[ "$key_source" == unchanged:* ]] && key_source="${key_source#unchanged:}"
    local propose_key=$(echo "$key_source" | grep -oE '[a-z-]{3,}' | head -3 | tr '\n' '|' | sed 's/|$//')

    if [ -n "$propose_key" ]; then
      # Count a later [design] referencing the key as active-pursuit conversion too, not only
      # [task]/[done] (chat-review/sweep-rollcall-counts-design, 2026-07-10): operator-GATED docs-stage
      # angles CANNOT self-file into a [task] — their correct lifecycle is a developing [design] line.
      # Without this, such a proposal is nagged 'never filed' and escalated every rotation even while
      # actively pursued in design (live: pub's docs/epistemics angle, 2 [design] lines, escalated
      # anyway). The unchanged-selfmatch guard above (key_source strips 'unchanged:', keys on <slug>
      # only) still applies, so a generic word in [design] prose can't false-convert.
      if echo "$later_content" | grep -E "\[(task|done|design)\].*(${propose_key})" > /dev/null; then
        found_match=true
      fi
    fi

    if $found_match; then
      # Resolved — clear any nudge history so a future unrelated re-proposal of the same topic starts fresh
      unset "NUDGE_COUNT[$hash]" "NUDGE_STATUS[$hash]" 2>/dev/null
      converted=$((converted + 1))
      continue
    fi

    local status="${NUDGE_STATUS[$hash]:-PENDING}"
    local count="${NUDGE_COUNT[$hash]:-0}"

    if [ "$status" = "ESCALATED" ] || [ "$status" = "DECLINED" ]; then
      continue  # already handled — permanently silent, never re-nudge/re-escalate
    fi

    local propose_ts_sec=$(date -d "$propose_ts" +%s 2>/dev/null || echo 0)
    if [ "$propose_ts_sec" -gt 0 ] && [ "$propose_ts_sec" -lt "$max_age_cutoff" ]; then
      NUDGE_STATUS[$hash]="DECLINED"
      NUDGE_COUNT[$hash]="$count"
      declined=$((declined + 1))
      echo "Declined (older than max-age ${MAX_AGE_MINUTES}m): ${channel} '${propose_text}' at ${propose_ts}"
      continue
    fi

    case "$count" in
      0)
        local nudge="[fyi] stale-propose: ${channel} proposed '${propose_text}' at ${propose_ts}, never filed — review?"
        # CROSS-NODE DEDUP (chat-review/rollcallprop-nodelocal-dedup-dup, 2026-07-08): STATE_FILE
        # is node-local while CHAT_LOG is fleet-SHARED (gossiped from every host, hourly cron on
        # every mind node) — two nodes each see their own (so-far-empty) local state for the SAME
        # stale PROPOSE and both nudge independently (live: Default-string + IdeaPad both posted
        # the identical nudge for health's reflex-log-centralization PROPOSE at 03:00:14Z, same
        # second, word-for-word). Before posting, check the SHARED board itself (the same
        # $CHAT_LOG being scanned) for an existing nudge of this exact channel+propose_ts, posted
        # by ANY host — if found, another node already did this; adopt it into our own local state
        # instead of re-posting.
        local board_marker="stale-propose: ${channel} proposed"
        if grep -F -- "$board_marker" "$CHAT_LOG" 2>/dev/null | grep -qF -- "at ${propose_ts}"; then
          echo "Skipped (already nudged by another node): ${channel} '${propose_text}' at ${propose_ts}"
          NUDGE_COUNT[$hash]=1
          NUDGE_STATUS[$hash]="PENDING"
          silent_tracked=$((silent_tracked + 1))
          continue
        fi
        # SINGLE MINTER (chat-review/rollcallprop-dedup-race-persists) — the board-scan check above
        # only catches a STAGGERED race; a CONCURRENT same-tick race needs an election, not a grep.
        # Non-minter: skip silently, no state advance, so next sweep re-checks the board-scan adopt
        # path once the minter's post has gossiped in.
        if ! _rollcall_is_minter "$CHAT_LOG"; then
          echo "Skipped (not the elected minter this round): ${channel} '${propose_text}' at ${propose_ts}"
          continue
        fi
        echo "Would post: $nudge"
        if $DO_POST; then
          if command -v mesh-chat >/dev/null 2>&1; then
            mesh-chat "$nudge" > /dev/null 2>&1
            echo "Posted to board"
          else
            echo "(mesh-chat not found, skipping post)"
          fi
        fi
        NUDGE_COUNT[$hash]=1
        NUDGE_STATUS[$hash]="PENDING"
        nudged=$((nudged + 1))
        ;;
      1)
        # Already nudged once — this is the first unanswered sweep since the nudge; stay silent
        NUDGE_COUNT[$hash]=2
        NUDGE_STATUS[$hash]="PENDING"
        silent_tracked=$((silent_tracked + 1))
        ;;
      *)
        # 2 unanswered sweeps since the nudge — escalate exactly once, then go permanently silent
        local short="${hash:0:8}"
        local escalate="[task] chat-review/stale-propose-${short}: PROPOSE from ${channel} ('${propose_text}', at ${propose_ts}) went unanswered after a nudge + 2 follow-up sweeps — decide: file a real task with an owner, or explicitly decline. owner: ${channel}"
        # CROSS-NODE DEDUP (chat-review/rollcallprop-dedup-race-persists): unlike the nudge branch
        # above (board-scan since d357653), this escalation branch never had ANY cross-node check —
        # each node's local ladder (count 0->1->2) progresses independently, so two nodes reaching
        # count>=2 could each mint the SAME-slug [task]. Adopt if already on the shared board.
        if grep -qF -- "chat-review/stale-propose-${short}" "$CHAT_LOG" 2>/dev/null; then
          echo "Skipped (already escalated by another node): ${channel} '${propose_text}' at ${propose_ts}"
          NUDGE_STATUS[$hash]="ESCALATED"
          escalated=$((escalated + 1))
          continue
        fi
        # SINGLE MINTER — same concurrent-cron-tick race as the nudge branch (both nodes' local
        # counts can reach 2 on the same tick with nothing on the board yet for either to adopt).
        if ! _rollcall_is_minter "$CHAT_LOG"; then
          echo "Skipped (not the elected minter this round): ${channel} '${propose_text}' at ${propose_ts}"
          continue
        fi
        echo "Would post: $escalate"
        if $DO_POST; then
          if command -v mesh-chat >/dev/null 2>&1; then
            mesh-chat "$escalate" > /dev/null 2>&1
            echo "Posted to board"
          else
            echo "(mesh-chat not found, skipping post)"
          fi
        fi
        NUDGE_STATUS[$hash]="ESCALATED"
        escalated=$((escalated + 1))
        ;;
    esac
  done

  save_nudge_state "$STATE_FILE"

  echo ""
  echo "Total: ${nudged} nudge(s), ${escalated} escalation(s), ${declined} declined (max-age), ${silent_tracked} silently tracked, ${converted} converted"
  set -u
  return 0
}

run_test() {
  # Create fixture board with test PROPOSE scenarios
  local test_dir="$HOME/.mesh/test-rollcall-sweep"
  local test_log="$test_dir/chat.log"
  local state_file="$test_dir/nudge-state"
  mkdir -p "$test_dir"
  rm -f "$state_file"

  # Timestamps computed relative to NOW — a hardcoded fixture date ages past the
  # threshold within hours and turns the smoke-test into a time bomb
  local old_time=$(date -u -d '4 hours ago' +%Y-%m-%dT%H:%M:%SZ)      # stale, unconverted
  local recent_time=$(date -u -d '3 hours ago' +%Y-%m-%dT%H:%M:%SZ)   # stale, but converted below
  local current_time=$(date -u -d '1 minute ago' +%Y-%m-%dT%H:%M:%SZ)
  local ancient_time=$(date -u -d '20 days ago' +%Y-%m-%dT%H:%M:%SZ)  # past max-age

  # Create test chat log with scenarios
  cat > "$test_log" <<EOF
${old_time} test_channel :: [fyi] roll-call room: PROPOSE test-old-unconverted — this should trigger a nudge
${recent_time} test_channel :: [fyi] roll-call genome: PROPOSE test-recent-converted — this should NOT trigger (has task below)
${current_time} test_channel :: [task] chat-review/test-recent-converted: testing the sweep
${ancient_time} test_channel :: [fyi] roll-call attic: PROPOSE test-ancient-unconverted — this is past max-age
${old_time} test_channel :: [fyi] roll-call senses: PROPOSE <one thing you would change or add> | CHANGED <...>
${old_time} test_channel :: [fyi] roll-call ds: PROPOSE none | CHANGED x
${old_time} test_channel :: [fyi] roll-call nulltest-empty: PROPOSE
${old_time} test_channel :: [fyi] roll-call nulltest-na: PROPOSE n/a
${old_time} test_channel :: [fyi] roll-call nulltest-nothing: PROPOSE nothing new this round
${old_time} test_channel :: [fyi] roll-call nulltest-unchnone: PROPOSE unchanged (none)
EOF

  echo "=== Test 1: old unconverted PROPOSE -> first sweep nudges ==="
  local out1
  out1=$(run_sweep "$test_log" "120" "false" "$state_file" 2>&1)
  echo "$out1"
  if echo "$out1" | grep -q "stale-propose.*test-old-unconverted"; then
    echo "PASS: first sweep nudged the stale propose"
  else
    echo "FAIL: first sweep did not nudge (expected nudge for test-old-unconverted)"
    rm -rf "$test_dir"
    exit 1
  fi

  echo ""
  echo "=== Test 2: recent converted PROPOSE -> always silent ==="
  if echo "$out1" | grep -q "stale-propose.*test-recent-converted"; then
    echo "FAIL: incorrectly flagged converted propose as stale"
    rm -rf "$test_dir"
    exit 1
  else
    echo "PASS: correctly ignored converted propose (test-recent-converted)"
  fi

  echo ""
  echo "=== Test 3: already-nudged PROPOSE -> second sweep stays silent (dedup via state file) ==="
  local out2
  out2=$(run_sweep "$test_log" "120" "false" "$state_file" 2>&1)
  echo "$out2"
  if echo "$out2" | grep -q "stale-propose.*test-old-unconverted"; then
    echo "FAIL: second sweep re-nudged an already-nudged propose — state check is broken/missing"
    rm -rf "$test_dir"
    exit 1
  else
    echo "PASS: second sweep stayed silent for the already-nudged propose"
  fi

  echo ""
  echo "=== Test 4: unanswered nudge -> third sweep escalates exactly once ==="
  local out3
  out3=$(run_sweep "$test_log" "120" "false" "$state_file" 2>&1)
  echo "$out3"
  if echo "$out3" | grep -q "\[task\] chat-review/stale-propose-.*test-old-unconverted"; then
    echo "PASS: third sweep escalated the unanswered propose to a [task]"
  else
    echo "FAIL: expected an escalation [task] line on the third sweep"
    rm -rf "$test_dir"
    exit 1
  fi

  echo ""
  echo "=== Test 5: escalated PROPOSE -> never posted again ==="
  local out4
  out4=$(run_sweep "$test_log" "120" "false" "$state_file" 2>&1)
  if echo "$out4" | grep -E "(stale-propose|\[task\] chat-review/stale-propose)" | grep -q "test-old-unconverted"; then
    echo "FAIL: escalated propose was posted again — should be permanently silent"
    rm -rf "$test_dir"
    exit 1
  else
    echo "PASS: escalated propose stayed silent on the fourth sweep"
  fi

  echo ""
  echo "=== Test 6: 20-day-old PROPOSE -> declined immediately, never nudged ==="
  if echo "$out1" | grep -q "stale-propose.*test-ancient-unconverted"; then
    echo "FAIL: an ancient (past max-age) propose was nudged — max-age cutoff missing"
    rm -rf "$test_dir"
    exit 1
  else
    echo "PASS: ancient propose was declined/skipped, not nudged"
  fi

  echo ""
  echo "=== Test 7: template placeholder / none-unchanged PROPOSE -> never stored/nudged ==="
  if echo "$out1" | grep -qE "stale-propose:.*(one thing you would change|PROPOSE none)"; then
    echo "FAIL: a placeholder or none/unchanged PROPOSE was nudged — stub filter missing"
    rm -rf "$test_dir"
    exit 1
  else
    echo "PASS: placeholder and none/unchanged PROPOSEs were skipped, not nudged"
  fi

  echo ""
  echo "=== Test 7b: null-answer PROPOSEs (empty/whitespace, n/a, nothing…) -> never stored/nudged (chat-review/sweep-none-slug-phantom) ==="
  if echo "$out1" | grep -qE "stale-propose:.*nulltest-(empty|na|nothing)"; then
    echo "FAIL: a null-answer PROPOSE (empty/n-a/nothing) was nudged — phantom slipped the null-form filter"
    rm -rf "$test_dir"
    exit 1
  else
    echo "PASS: empty/whitespace, n/a and nothing-form PROPOSEs were skipped, not nudged"
  fi

  echo ""
  echo "=== Test 7c: 'unchanged (none)' — a re-affirmed NULL — normalizes to unchanged:none but must NOT be tracked/nudged (chat-review/sweep-none-slug-phantom; the case 5e67e87's pre-normalization filter missed) ==="
  if echo "$out1" | grep -qE "stale-propose:.*nulltest-unchnone|stale-propose:.*unchanged:none"; then
    echo "FAIL: 'unchanged (none)' was nudged — a re-affirmed null-answer rode the ladder as a phantom proposal"
    rm -rf "$test_dir"
    exit 1
  else
    echo "PASS: 'unchanged (none)' skipped post-normalization — a re-affirmed none is still a none"
  fi

  echo ""
  echo "=== Test 8: cross-node dedup — board already carries another node's nudge for same channel+ts -> this node must NOT re-nudge (chat-review/rollcallprop-nodelocal-dedup-dup) ==="
  local xn_time=$(date -u -d '5 hours ago' +%Y-%m-%dT%H:%M:%SZ)
  local xn_log="$test_dir/chat-xnode.log"
  local xn_state_node2="$test_dir/nudge-state-xnode-node2"
  cat > "$xn_log" <<EOF
${xn_time} test_channel :: [fyi] roll-call cross: PROPOSE test-crossnode-dedup should be dedupd via board scan
${xn_time} some-other-node@host :: [fyi] stale-propose: cross proposed 'test-crossnode-dedup should be dedupd via board scan' at ${xn_time}, never filed — review?
EOF
  local out8
  out8=$(run_sweep "$xn_log" "120" "false" "$xn_state_node2" 2>&1)
  echo "$out8"
  if echo "$out8" | grep -q "Would post:.*stale-propose.*test-crossnode-dedup"; then
    echo "FAIL: re-nudged despite an existing board nudge from another node for the same channel+ts"
    rm -rf "$test_dir"
    exit 1
  else
    echo "PASS: cross-node dedup — skipped posting since another node already nudged this exact channel+ts"
  fi

  echo ""
  echo "=== Test 9: no prior board nudge -> a fresh node still posts (cross-node dedup does not over-suppress) ==="
  local yn_time=$(date -u -d '5 hours ago' +%Y-%m-%dT%H:%M:%SZ)
  local yn_log="$test_dir/chat-ynode.log"
  local yn_state="$test_dir/nudge-state-ynode"
  cat > "$yn_log" <<EOF
${yn_time} test_channel :: [fyi] roll-call fresh: PROPOSE test-freshnode-nonudge-yet — nobody has nudged this
EOF
  local out9
  out9=$(run_sweep "$yn_log" "120" "false" "$yn_state" 2>&1)
  echo "$out9"
  if echo "$out9" | grep -q "Would post:.*stale-propose.*test-freshnode-nonudge-yet"; then
    echo "PASS: no prior board nudge — still posted"
  else
    echo "FAIL: cross-node dedup over-suppressed a genuinely-unnudged PROPOSE"
    rm -rf "$test_dir"
    exit 1
  fi

  echo ""
  echo "=== Test 10: 'unchanged (<slug>)' PROPOSE accumulates age/round-count across the recurrence chain instead of being permanently discarded (chat-review/rollcallprop-unchanged-blackhole) ==="
  local uc_2h=$(date -u -d '2 hours ago' +%Y-%m-%dT%H:%M:%SZ)
  local uc_4h=$(date -u -d '4 hours ago' +%Y-%m-%dT%H:%M:%SZ)
  local uc_6h=$(date -u -d '6 hours ago' +%Y-%m-%dT%H:%M:%SZ)
  local uc_log="$test_dir/chat-unchanged.log"
  local uc_state="$test_dir/nudge-state-unchanged"
  cat > "$uc_log" <<EOF
${uc_6h} test_channel :: [fyi] roll-call health: PROPOSE unchanged (swap-8g-to-12g)
${uc_4h} test_channel :: [fyi] roll-call health: PROPOSE unchanged (swap-8g-to-12g)
${uc_2h} test_channel :: [fyi] roll-call health: PROPOSE unchanged (swap-8g-to-12g)
EOF
  local ucout1 ucout2 ucout3
  ucout1=$(run_sweep "$uc_log" "120" "false" "$uc_state" 2>&1)
  echo "$ucout1"
  if echo "$ucout1" | grep -q "stale-propose.*health proposed 'unchanged:swap-8g-to-12g'"; then
    echo "PASS: sweep 1 nudged the recurring 'unchanged' propose (not silently discarded)"
  else
    echo "FAIL: sweep 1 did not nudge a recurring 'unchanged (<slug>)' propose — still being discarded"
    rm -rf "$test_dir"
    exit 1
  fi

  ucout2=$(run_sweep "$uc_log" "120" "false" "$uc_state" 2>&1)
  if echo "$ucout2" | grep -q "stale-propose.*health proposed 'unchanged:swap-8g-to-12g'"; then
    echo "FAIL: sweep 2 re-nudged instead of going silent — round-count not accruing"
    rm -rf "$test_dir"
    exit 1
  else
    echo "PASS: sweep 2 stayed silent (round-count accruing, not re-nudging)"
  fi

  ucout3=$(run_sweep "$uc_log" "120" "false" "$uc_state" 2>&1)
  if echo "$ucout3" | grep -qE "\[task\] chat-review/stale-propose-[0-9a-f]+: PROPOSE from health"; then
    echo "PASS: sweep 3 escalated the recurring 'unchanged' propose to a [task] — same ladder a reworded proposal gets"
  else
    echo "FAIL: sweep 3 did not escalate — 'unchanged' proposals still can't reach a [task]"
    rm -rf "$test_dir"
    exit 1
  fi

  echo ""
  echo "=== Test 11: template placeholder / bare 'none' PROPOSE still discarded (unchanged from before — only 'unchanged (<slug>)' changed behavior) ==="
  if echo "$out1" | grep -qE "stale-propose:.*(one thing you would change|PROPOSE none)"; then
    echo "FAIL: a placeholder or none PROPOSE was nudged — stub filter regressed"
    rm -rf "$test_dir"
    exit 1
  else
    echo "PASS: placeholder and none PROPOSEs remain skipped, not nudged"
  fi

  echo ""
  echo "=== Test 12: 'unchanged (<slug>)' propose_key must not selfmatch the bare word 'unchanged' in unrelated later prose (chat-review/rollcallprop-unchanged-selfmatch) ==="
  local sm_2h=$(date -u -d '2 hours ago' +%Y-%m-%dT%H:%M:%SZ)
  local sm_1h=$(date -u -d '1 hour ago' +%Y-%m-%dT%H:%M:%SZ)
  local sm_log="$test_dir/chat-selfmatch.log"
  local sm_state="$test_dir/nudge-state-selfmatch"
  cat > "$sm_log" <<EOF
${sm_2h} test_channel :: [fyi] roll-call health: PROPOSE unchanged (swap-8g-to-12g)
${sm_1h} test_channel :: [done] genome: reflex-cadence cleanup unchanged in behavior, just comments
EOF
  local smout1
  smout1=$(run_sweep "$sm_log" "120" "false" "$sm_state" 2>&1)
  echo "$smout1"
  if echo "$smout1" | grep -q "stale-propose.*health proposed 'unchanged:swap-8g-to-12g'"; then
    echo "PASS: unrelated later [done] containing only the bare word 'unchanged' did NOT falsely resolve — still nudged"
  else
    echo "FAIL: propose_key selfmatched the generic word 'unchanged' in unrelated prose — false conversion"
    rm -rf "$test_dir"
    exit 1
  fi

  local sm2_log="$test_dir/chat-selfmatch2.log"
  local sm2_state="$test_dir/nudge-state-selfmatch2"
  cat > "$sm2_log" <<EOF
${sm_2h} test_channel :: [fyi] roll-call health: PROPOSE unchanged (swap-8g-to-12g)
${sm_1h} test_channel :: [done] health: filed swap-8g-to-12g as a real task
EOF
  local smout2
  smout2=$(run_sweep "$sm2_log" "120" "false" "$sm2_state" 2>&1)
  echo "$smout2"
  if echo "$smout2" | grep -q "stale-propose.*health proposed 'unchanged:swap-8g-to-12g'"; then
    echo "FAIL: a later [done] mentioning the actual slug should still convert (mark resolved, no nudge)"
    rm -rf "$test_dir"
    exit 1
  else
    echo "PASS: a later [done] mentioning the slug still converts the proposal (correctly silent)"
  fi

  echo ""
  echo "=== Test 13: concurrent same-tick race (chat-review/rollcallprop-dedup-race-persists) — two hosts scan the IDENTICAL board (neither's nudge posted yet, so the board-scan adopt check alone can't help) -> only the elected minter (lexically-lowest hostname) nudges ==="
  local mr_time=$(date -u -d '3 hours ago' +%Y-%m-%dT%H:%M:%SZ)
  local mr_log="$test_dir/chat-minter.log"
  local mr_state_a="$test_dir/nudge-state-minter-a"
  local mr_state_b="$test_dir/nudge-state-minter-b"
  cat > "$mr_log" <<EOF
${mr_time} test_channel :: [fyi] roll-call minter: PROPOSE test-minter-concurrent-race
${mr_time} chat@host-b :: [idle] heartbeat
${mr_time} chat@host-a :: [idle] heartbeat
EOF
  local mout_a mout_b
  mout_a=$(MESH_ROLLCALL_HOSTNAME=host-a run_sweep "$mr_log" "120" "false" "$mr_state_a" 2>&1)
  mout_b=$(MESH_ROLLCALL_HOSTNAME=host-b run_sweep "$mr_log" "120" "false" "$mr_state_b" 2>&1)
  echo "$mout_a"
  echo "$mout_b"
  posted_a=$(echo "$mout_a" | grep -c "Would post:.*test-minter-concurrent-race")
  posted_b=$(echo "$mout_b" | grep -c "Would post:.*test-minter-concurrent-race")
  if [ "$posted_a" = 1 ] && [ "$posted_b" = 0 ]; then
    echo "PASS: concurrent same-tick race — only the lexically-lowest host (host-a) minted, host-b deferred"
  else
    echo "FAIL: expected exactly host-a to mint (got posted_a=$posted_a posted_b=$posted_b) — the race persists"
    rm -rf "$test_dir"
    exit 1
  fi
  echo "$mout_b" | grep -q "Skipped (not the elected minter" || {
    echo "FAIL: host-b's defer was silent — must state the minter-skip reason"; rm -rf "$test_dir"; exit 1;
  }

  echo ""
  echo "=== Test 13b: after the minter's nudge gossips into the shared board, the deferred host's NEXT sweep adopts instead of re-minting ==="
  cat >> "$mr_log" <<EOF
${mr_time} chat@host-a  ::  [fyi] stale-propose: minter proposed 'test-minter-concurrent-race' at ${mr_time}, never filed — review?
EOF
  local mout_b2
  mout_b2=$(MESH_ROLLCALL_HOSTNAME=host-b run_sweep "$mr_log" "120" "false" "$mr_state_b" 2>&1)
  echo "$mout_b2"
  if echo "$mout_b2" | grep -q "Would post:.*test-minter-concurrent-race"; then
    echo "FAIL: host-b re-minted after the minter's nudge had already gossiped in"
    rm -rf "$test_dir"
    exit 1
  else
    echo "PASS: host-b converged (no duplicate mint) once the minter's nudge was visible on the board"
  fi

  echo ""
  echo "=== Test 14: concurrent escalation race — same class of bug, but the escalate branch previously had NO cross-node dedup at all (not even staggered); two hosts both at round-count 2 on the identical board -> only the elected minter escalates ==="
  local er_time=$(date -u -d '5 hours ago' +%Y-%m-%dT%H:%M:%SZ)
  local er_log="$test_dir/chat-escrace.log"
  local er_state_a="$test_dir/nudge-state-escrace-a"
  local er_state_b="$test_dir/nudge-state-escrace-b"
  cat > "$er_log" <<EOF
${er_time} test_channel :: [fyi] roll-call escrace: PROPOSE test-escalate-concurrent-race
${er_time} chat@host-b :: [idle] heartbeat
${er_time} chat@host-a :: [idle] heartbeat
EOF
  local er_hash er_short
  er_hash="$(key_hash "escrace:test-escalate-concurrent-race")"
  er_short="${er_hash:0:8}"
  printf '%s|2|PENDING\n' "$er_hash" > "$er_state_a"
  printf '%s|2|PENDING\n' "$er_hash" > "$er_state_b"
  local eout_a eout_b esc_a esc_b
  eout_a=$(MESH_ROLLCALL_HOSTNAME=host-a run_sweep "$er_log" "120" "false" "$er_state_a" 2>&1)
  eout_b=$(MESH_ROLLCALL_HOSTNAME=host-b run_sweep "$er_log" "120" "false" "$er_state_b" 2>&1)
  echo "$eout_a"
  echo "$eout_b"
  esc_a=$(echo "$eout_a" | grep -c "Would post:.*chat-review/stale-propose-${er_short}")
  esc_b=$(echo "$eout_b" | grep -c "Would post:.*chat-review/stale-propose-${er_short}")
  if [ "$esc_a" = 1 ] && [ "$esc_b" = 0 ]; then
    echo "PASS: concurrent escalation race — only host-a (lexically-lowest) escalated, host-b deferred"
  else
    echo "FAIL: expected exactly host-a to escalate (got esc_a=$esc_a esc_b=$esc_b) — duplicate-[task] risk persists"
    rm -rf "$test_dir"
    exit 1
  fi

  echo ""
  echo "=== Test 14b: after the minter's escalation gossips in, the deferred host's NEXT sweep must not mint a duplicate-slug [task] ==="
  cat >> "$er_log" <<EOF
${er_time} chat@host-a  ::  [task] chat-review/stale-propose-${er_short}: PROPOSE from escrace ('test-escalate-concurrent-race', at ${er_time}) went unanswered after a nudge + 2 follow-up sweeps — decide: file a real task with an owner, or explicitly decline. owner: escrace
EOF
  local eout_b2
  eout_b2=$(MESH_ROLLCALL_HOSTNAME=host-b run_sweep "$er_log" "120" "false" "$er_state_b" 2>&1)
  echo "$eout_b2"
  if echo "$eout_b2" | grep -q "Would post:.*chat-review/stale-propose-${er_short}"; then
    echo "FAIL: host-b minted a duplicate-slug [task] after the minter's escalation had already gossiped in"
    rm -rf "$test_dir"
    exit 1
  else
    echo "PASS: host-b converged (no duplicate [task]) once the minter's escalation was visible on the board"
  fi

  echo ""
  echo "=== Test 15: a later [design] referencing a PROPOSE's key counts as active-pursuit conversion (chat-review/sweep-rollcall-counts-design) — operator-gated docs angles pursued as [design] must clear the nudge ladder, not escalate ==="
  local dz_2h=$(date -u -d '2 hours ago' +%Y-%m-%dT%H:%M:%SZ)
  local dz_1h=$(date -u -d '1 hour ago' +%Y-%m-%dT%H:%M:%SZ)
  local dz_log="$test_dir/chat-designconv.log"
  local dz_state="$test_dir/nudge-state-designconv"
  cat > "$dz_log" <<EOF
${dz_2h} test_channel :: [fyi] roll-call pub: PROPOSE epistemics-ship-the-sign-thesis
${dz_1h} test_channel :: [design] pub: developing epistemics-ship-the-sign-thesis — the COEX angle for docs/epistemics.md, operator-gated
EOF
  local dzout1
  dzout1=$(run_sweep "$dz_log" "120" "false" "$dz_state" 2>&1)
  echo "$dzout1"
  if echo "$dzout1" | grep -q "stale-propose.*epistemics-ship-the-sign-thesis"; then
    echo "FAIL: a proposal actively developed in a later [design] was still nudged — design-stage pursuit not counted as conversion"
    rm -rf "$test_dir"
    exit 1
  else
    echo "PASS: the later [design] referencing the proposal's key converted it (silent, no nudge)"
  fi

  echo ""
  echo "=== Test 15b: the [design] conversion must not weaken the unchanged-selfmatch guard — a generic word in [design] prose still cannot false-convert ==="
  local dz2_log="$test_dir/chat-designconv2.log"
  local dz2_state="$test_dir/nudge-state-designconv2"
  cat > "$dz2_log" <<EOF
${dz_2h} test_channel :: [fyi] roll-call health: PROPOSE unchanged (swap-8g-to-12g)
${dz_1h} test_channel :: [design] genome: some unrelated design work, behavior unchanged in this pass
EOF
  local dz2out1
  dz2out1=$(run_sweep "$dz2_log" "120" "false" "$dz2_state" 2>&1)
  echo "$dz2out1"
  if echo "$dz2out1" | grep -q "stale-propose.*health proposed 'unchanged:swap-8g-to-12g'"; then
    echo "PASS: a [design] line containing only the bare word 'unchanged' did NOT false-convert — guard intact under the design alternation"
  else
    echo "FAIL: the design alternation let the generic word 'unchanged' in [design] prose false-convert — selfmatch guard regressed"
    rm -rf "$test_dir"
    exit 1
  fi

  echo ""
  echo "=== Test 16: a [task] filed BEFORE the PROPOSE resolves it — a 'PROPOSE unchanged' restates an already-open item, no re-file expected (chat-review/rollcallprop-task-before-propose; RED under the old forward-only sed) ==="
  # Reproduces the live 2026-07-30 board: discover's wire-state-voice-consent [task] filed at 10:37Z,
  # then restated by a 15:01Z roll-call PROPOSE, then falsely flagged 'never filed' at 18:00Z.
  local tb_before=$(date -u -d '5 hours ago' +%Y-%m-%dT%H:%M:%SZ)   # the [task], filed FIRST
  local tb_propose=$(date -u -d '3 hours ago' +%Y-%m-%dT%H:%M:%SZ)  # the PROPOSE that restates it
  local tb_log="$test_dir/chat-taskbefore.log"
  local tb_state="$test_dir/nudge-state-taskbefore"
  cat > "$tb_log" <<EOF
${tb_before} test_channel :: [task] discover/senses: wire-state-voice-consent — voice-clone x home-state fusion, needs operator yes/no. owner: discover/senses
${tb_propose} test_channel :: [fyi] roll-call discover: PROPOSE unchanged (wire-state-voice-consent)
EOF
  local tbout1
  tbout1=$(run_sweep "$tb_log" "120" "false" "$tb_state" 2>&1)
  echo "$tbout1"
  if echo "$tbout1" | grep -q "stale-propose.*wire-state-voice-consent"; then
    echo "FAIL: a PROPOSE whose [task] was filed BEFORE it was flagged 'never filed' — forward-only scan still blind to a pre-propose task"
    rm -rf "$test_dir"
    exit 1
  else
    echo "PASS: the pre-propose [task] resolved the restated proposal (silent, no false 'never filed' nudge)"
  fi

  echo ""
  echo "=== Cleaning up test fixtures ==="
  rm -rf "$test_dir"
  echo "Test fixtures cleaned up"
  echo "smoke-test: ok (dedup-once, escalate-after-2, max-age-decline, converted-silent, cross-node board dedup, unchanged-slug accrual, unchanged-selfmatch guard, single-minter concurrent-race for nudge+escalate, task-before-propose resolution all verified)"
  exit 0
}

# Main
THRESHOLD_MINUTES="120"
DO_POST=false

while [ $# -gt 0 ]; do
  case "$1" in
    --minutes) THRESHOLD_MINUTES="$2"; shift 2 ;;
    --test) shift; run_test ;;
    --post) DO_POST=true; shift ;;
    *) echo "Unknown option: $1"; exit 1 ;;
  esac
done

run_sweep "$HOME/.mesh/chat.log" "$THRESHOLD_MINUTES" "$DO_POST"
