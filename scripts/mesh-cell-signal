#!/usr/bin/env bash
# mesh-cell-signal — CELLULAR LINK sense: the phone body's mobile-uplink quality (serving-cell RSRP/dBm,
# quality, network type, band) — a real signal the mesh did not perceive before. Distinct from
# mesh-wifi-link (the LAN/wifi side): this is the MOBILE radio. Why the mesh cares:
#   - the phone is an ACTUATOR (SMS / calls / mobile tether) — its cell link quality says whether those
#     would actually work right now (a -116 dBm fringe cell ≠ a -75 dBm strong cell).
#   - signal level tracks the phone's RF environment as it moves (window vs basement vs outdoors) — a
#     coarse motion/where-is-the-body hint independent of GPS/wifi.
#   - serving-cell id (ci/pci/tac) + neighbor count = a stable coarse-location / tower fingerprint.
#
# Reads `termux-telephony-cellinfo` over SSH (phone resolved LAN-FIRST via mesh-phone-ip — the phone is
# often off Tailscale but reachable on the home LAN). HONEST: exit 2 when the phone is unreachable OR
# there is no registered cell (airplane mode / no SIM / no service) — NEVER a faked reading.
#
# THE ANALOG CONTINUUM UNDER THE LABEL (senome / valence resolution, 2026-08-18, live literature)
# Basso, Baluška & Souza, "Plant agency: from senome and electrome to plant semiosphere",
# *Frontiers in Plant Physiology* 4 (2026), 20 May 2026, doi:10.3389/fphgy.2026.1861112 (read in
# full; OA). A plant has no neural centre, so its sense-making runs on the **senome** — "an
# integrative information field that unifies the activities of all the cell's sensory proteins",
# explicitly ANALOG, and the analog-ness is load-bearing: *"This analog nature allows for a
# continuum of intensity and significance, providing the necessary resolution for the emergence of
# semiotic interpretation and allowing the cell to perform real-time valence evaluations of
# environmental conditions."* The semiotic threshold in that account is not a bin boundary — it is
# where a perturbation acquires VALENCE, and valence needs the continuum to be graded on.
#
# This sense was the opposite shape. It read a genuine continuum (serving-cell RSRP, dBm) and
# published a WORD — `.cell-signal.state` was literally 5 bytes, `FAIR` — so the whole mesh saw the
# band and nothing else. Measured consequence on this node's own 176 logged reads
# (~/.mesh/cell-signal.log, replayed through bandpos()):
#   * the label's sensitivity is UNRELATED to how far the signal moved. 64 verdict changes; 10 of
#     them on a move of <=2 dB, while 9 consecutive-read pairs moved >=5 dB (max 7 dB) WITHOUT
#     changing the word. A 1 dB wobble renames the link; a 7 dB collapse is silent.
#   * median distance to the nearest threshold: 2 dB. 63/176 reads (35.8%) sat within 1 dB of
#     flipping the published word, 26 (14.8%) sat exactly on a threshold, and the joint-modal
#     interior position was pos=0.00 — the band's own degrading edge (25 reads, 14.2%).
#   * -110 dBm (the FAIR floor, one dB from POOR) is the single most frequent reading of this sense.
# So the mesh's most common perception of the phone's cell link was "FAIR", at the exact dB where
# FAIR ends, and no consumer could tell that from FAIR-at-the-top nine dB better.
#
# bandpos() adds the missing axis WITHOUT touching the verdict (instrument first): where inside its
# own band the reading sits (`pos`), how much room to each edge in the metric's own unit
# (`to_worse`/`to_better`), and `to_edge` — the one field defined in every band, including the two
# open-ended ones, which says how much RF wobble the published word can absorb before it changes.
# An open band renders pos=na, never 0.0/1.0: a position needs two edges, and a fabricated one
# would read as "at the edge" for a band that has no such edge.
#
# reflex-cadence: 5-59/15 * * * *
# reflex-args: --edge
#
#   mesh-cell-signal            one read → classified verdict line
#   mesh-cell-signal --json     machine-readable (verdict + the within-band continuum)
#   mesh-cell-signal --edge     debounced state write (for the reflex / dash)
#   mesh-cell-signal --test     synthetic classify smoke (no phone, no SSH)
#
# Exit: 0 ok · 2 phone unreachable / no cellular service (honest-degraded, never faked).
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"

MESH="${MESH_DIR:-$HOME/.mesh}"; mkdir -p "$MESH" 2>/dev/null || true
STATE="$MESH/.cell-signal.state"
OFFLINEFILE="$MESH/.cell-signal-offline"
PHONE_USER_DEF="${PHONE_USER:-u0_a380}"
PHONE_PORT="${PHONE_SSH_PORT:-8022}"
SSH_OPTS="-o BatchMode=yes -o ConnectTimeout=6 -o StrictHostKeyChecking=no"

# TAB SPLITTING — the canonical shared helper, never `IFS=$'\t' read` and never a private copy.
# Tab is IFS *whitespace*, so `read` collapses a RUN of tabs into one delimiter and strips leading
# ones: this sense's producer emits `metric` FIRST and defaults it to "" (the modem reported no
# rsrp/dbm), so every no-metric read shifted RAT into METRIC and left NCELLS empty. Loud on a
# missing library — an inline fallback would be copy number N wearing a different hat.
# The `""` argument is LOAD-BEARING, not decoration: a sourced file inherits the CALLER's positional
# parameters, and mesh-split-tabs.sh self-tests on `[ "${1:-}" = "--test" ]` — so `mesh-cell-signal
# --test` would source the library, hit ITS --test block, print the library's ok line and exit 0
# before a single one of this tool's own assertions ran (observed; the whole suite went silently
# vacuous). `source f ""` sets $1='' for the duration and bash restores our argv afterwards.
source "$HOME/.local/bin/mesh-split-tabs.sh" "" 2>/dev/null || source "$(dirname "$0")/mesh-split-tabs.sh" "" 2>/dev/null || true
declare -F split_tabs >/dev/null \
  || { echo "mesh-cell-signal: mesh-split-tabs.sh not found — refusing to run with a tab reader that drops empty fields" >&2; exit 1; }

# Classify a serving-cell signal into a stable vocab. LTE → RSRP thresholds (the meaningful LTE metric);
# other RATs (gsm/wcdma/nr) → generic dBm thresholds. Pure function (testable, no I/O).
#
# ONE ladder, read by BOTH classify() and bandpos() — the band floors used to live as an if/elif
# chain, which would have forced bandpos to carry a SECOND copy of the same numbers (an enumerated
# alphabet that is a copy is a copy that rots: the two would drift and the position would be
# computed against edges the verdict no longer uses). Order matters: richest band first, and the
# band below the last floor is the open-bottom MARGINAL.
BAND_FLOORS="EXCELLENT:-90 GOOD:-100 FAIR:-110 POOR:-120"

classify() {  # <metric_dbm> -> EXCELLENT|GOOD|FAIR|POOR|MARGINAL
  local m="$1" b f
  case "$m" in ''|*[!0-9-]*) echo UNKNOWN; return;; esac
  for b in $BAND_FLOORS; do
    f="${b#*:}"; [ "$m" -ge "$f" ] && { printf '%s\n' "${b%%:*}"; return; }
  done
  echo MARGINAL
}

# --- THE WITHIN-BAND CONTINUUM (senome / valence-resolution axis, 2026-08-18) -------------------
# bandpos <metric_dbm> -> "pos=<0.00-0.99|na> to_worse=<dB|na> to_better=<dB|na> span=<dB|na>
#                          open=<none|up|down|na> to_edge=<dB|na>"
#
# WHERE THE READING SITS INSIDE ITS OWN BAND, not just which band it is in. See the header block
# "THE ANALOG CONTINUUM UNDER THE LABEL". Pure function (no I/O), integer dBm in, printed in the
# metric's own unit so no consumer has to know this ladder to read it.
#   pos       0.00 at the band's DEGRADING edge → 0.99 at its improving edge. Interior bands only:
#             the two outer bands are open on one side, so a position inside them has no denominator
#             and renders na (never a fabricated 0.0/1.0 — that would read as "at the edge" for a
#             band that HAS no such edge).
#   to_worse  dB above this band's own floor: 0 = one more dB down and the verdict word changes.
#   to_better dB up to the next better band's floor.
#   to_edge   min(to_worse, to_better) over whichever sides EXIST — the one field that is defined in
#             every band, including the open ones. to_edge=0 says the published word is one dB of RF
#             wobble from flipping; a large to_edge says the word is currently a robust claim.
bandpos() {
  local m="$1" v b f n i floor ceil to_w to_b span pos open to_e
  v="$(classify "$m")"
  [ "$v" = UNKNOWN ] && { echo "pos=na to_worse=na to_better=na span=na open=na to_edge=na"; return; }
  floor=""; ceil=""; i=0
  for b in $BAND_FLOORS; do
    n="${b%%:*}"; f="${b#*:}"
    if [ "$n" = "$v" ]; then floor="$f"; break; fi
    ceil="$f"; i=$((i+1))
  done
  [ "$v" = MARGINAL ] && { floor=""; for b in $BAND_FLOORS; do ceil="${b#*:}"; done; }
  if [ -n "$floor" ]; then to_w=$((m - floor)); else to_w=na; fi
  if [ -n "$ceil" ];  then to_b=$((ceil - m));  else to_b=na; fi
  if [ -n "$floor" ] && [ -n "$ceil" ]; then
    span=$((ceil - floor))
    pos="$(printf '%d.%02d' $((to_w * 100 / span / 100)) $(( (to_w * 100 / span) % 100 )))"
    open=none; to_e=$to_w; [ "$to_b" -lt "$to_e" ] && to_e=$to_b
  else
    span=na; pos=na
    if [ -z "$ceil" ]; then open=up; to_e=$to_w; else open=down; to_e=$to_b; fi
  fi
  echo "pos=$pos to_worse=$to_w to_better=$to_b span=$span open=$open to_edge=$to_e"
}

# bp_field <key> <bandpos-output> — pull one field out of a bandpos line. Hoisted (not inlined at the
# call site) so --test can assert the WIRING too: a green bandpos behind a broken extraction is the
# "pure function asserted, the path that uses it not" shape, and on this sense the extraction only
# ever runs on a real phone read — i.e. exactly where a --test cannot reach it.
bp_field() {
  local t="${2#*$1=}"; printf '%s' "${t%% *}"
}

# split_row <tab-row> — bind the producer's row to this sense's six fields. Hoisted for exactly the
# reason bp_field is hoisted (see above): inlined at the call site, the split runs ONLY on a real
# phone read, i.e. only where a --test cannot reach it, and the suite could assert the splitter
# while the sense still used a broken reader. This IS the read path; --test drives this function.
split_row() {
  split_tabs "$1" METRIC RAT RSRQ LEVEL BAND NCELLS
}

if [ "${1:-}" = --test ]; then
  f=0
  [ "$(classify -75)"  = EXCELLENT ] || { echo "  FAIL: -75 → EXCELLENT (got $(classify -75))"; f=1; }
  [ "$(classify -90)"  = EXCELLENT ] || { echo "  FAIL: -90 boundary → EXCELLENT (got $(classify -90))"; f=1; }
  [ "$(classify -95)"  = GOOD      ] || { echo "  FAIL: -95 → GOOD (got $(classify -95))"; f=1; }
  [ "$(classify -105)" = FAIR      ] || { echo "  FAIL: -105 → FAIR (got $(classify -105))"; f=1; }
  [ "$(classify -116)" = POOR      ] || { echo "  FAIL: -116 → POOR (got $(classify -116))"; f=1; }
  [ "$(classify -125)" = MARGINAL  ] || { echo "  FAIL: -125 → MARGINAL (got $(classify -125))"; f=1; }
  # FALSIFIABLE honest-degraded: a non-numeric / empty metric must be UNKNOWN, never a faked band.
  [ "$(classify '')"   = UNKNOWN   ] || { echo "  FAIL: empty → UNKNOWN (got $(classify ''))"; f=1; }
  [ "$(classify NA)"   = UNKNOWN   ] || { echo "  FAIL: NA → UNKNOWN (got $(classify NA))"; f=1; }
  # parse: pick the REGISTERED cell's rsrp from a synthetic cellinfo blob (mirrors the real path).
  command -v python3 >/dev/null 2>&1 || { echo "smoke-test: FAIL (no python3)"; exit 1; }
  blob='[{"type":"lte","registered":false,"dbm":-109,"rsrp":-109},{"type":"lte","registered":true,"dbm":-116,"rsrp":-116,"rsrq":-9,"level":0,"bands":[7]}]'
  got="$(printf '%s' "$blob" | python3 -c '
import json,sys
cells=json.load(sys.stdin)
reg=[c for c in cells if c.get("registered")]
c=reg[0]; print(c.get("rsrp", c.get("dbm","")), c.get("type",""), (c.get("bands") or [""])[0])' 2>/dev/null)"
  [ "$got" = "-116 lte 7" ] || { echo "  FAIL: registered-cell parse got [$got] want [-116 lte 7]"; f=1; }
  # --- THE TAB SPLIT OF THE PRODUCER ROW (drives the REAL read path's splitter) -------------------
  # The producer's FIRST field is `metric = c.get("rsrp", c.get("dbm",""))` — EMPTY when the modem
  # reported neither, i.e. a LEADING empty field, which is precisely the position `IFS=$'\t' read`
  # cannot represent (tab is IFS whitespace: a leading run is stripped, everything shifts LEFT, the
  # last variable is left empty). Produce the row with the SAME python the real path runs, then
  # split it with the SAME helper the real path calls, and assert each field landed in its own
  # variable — with the empty metric STILL EMPTY, because empty is the true value here.
  blobnm='[{"type":"lte","registered":true,"rsrq":-11,"level":3,"bands":[3]},{"type":"lte","registered":false,"dbm":-109}]'
  row="$(printf '%s' "$blobnm" | python3 -c '
import json,sys
cells=json.load(sys.stdin)
c=[x for x in cells if x.get("registered")][0]
band=(c.get("bands") or ["?"])[0]
print("\t".join(str(x) for x in (c.get("rsrp", c.get("dbm","")), c.get("type","?"), c.get("rsrq","?"), c.get("level","?"), band, len(cells))))' 2>/dev/null)"
  [ "$row" = "$(printf '\tlte\t-11\t3\t3\t2')" ] \
    || { echo "  FAIL: producer did not emit a LEADING-empty row for a metric-less registered cell: [$row]"; f=1; }
  METRIC=x; RAT=x; RSRQ=x; LEVEL=x; BAND=x; NCELLS=x
  split_row "$row"                      # THE REAL READ PATH, on the row the producer really emits
  [ -z "$METRIC"    ] || { echo "  FAIL: leading-empty row: METRIC should be EMPTY, got [$METRIC] (fields shifted left)"; f=1; }
  [ "$RAT"    = lte ] || { echo "  FAIL: leading-empty row: RAT [$RAT] want [lte]"; f=1; }
  [ "$RSRQ"   = -11 ] || { echo "  FAIL: leading-empty row: RSRQ [$RSRQ] want [-11]"; f=1; }
  [ "$LEVEL"  = 3   ] || { echo "  FAIL: leading-empty row: LEVEL [$LEVEL] want [3]"; f=1; }
  [ "$BAND"   = 3   ] || { echo "  FAIL: leading-empty row: BAND [$BAND] want [3]"; f=1; }
  [ "$NCELLS" = 2   ] || { echo "  FAIL: leading-empty row: NCELLS [$NCELLS] want [2] (the last var is where a shift dumps the emptiness)"; f=1; }
  # …and the downstream must render that empty HONESTLY: UNKNOWN + na, never a band and never a 0.
  [ "$(classify "$METRIC")" = UNKNOWN ] || { echo "  FAIL: empty metric classified [$(classify "$METRIC")] — a shifted word would classify as a band"; f=1; }
  [ "$(bp_field pos "$(bandpos "$METRIC")")" = na ] || { echo "  FAIL: empty metric did not render pos=na"; f=1; }
  [ "${METRIC:-null}" = null ] || { echo "  FAIL: --json dbm render of an empty metric is [${METRIC:-null}], not null (invalid JSON / faked 0)"; f=1; }
  # a fully-populated row must still split identically — the fix must not move the normal case
  split_row "$(printf -- '-116\tlte\t-9\t0\t7\t3')"
  [ "$METRIC|$RAT|$RSRQ|$LEVEL|$BAND|$NCELLS" = "-116|lte|-9|0|7|3" ] \
    || { echo "  FAIL: populated row split to [$METRIC|$RAT|$RSRQ|$LEVEL|$BAND|$NCELLS]"; f=1; }
  # --- within-band continuum (bandpos) -----------------------------------------------------------
  _bpchk() {  # <metric> <expected field=value ...>
    local m="$1"; shift; local got; got="$(bandpos "$m")" ; local kv
    for kv in "$@"; do
      case " $got " in *" $kv "*) ;; *) echo "  FAIL: bandpos $m → [$got] missing [$kv]"; f=1;; esac
    done
  }
  _bpchk -110 pos=0.00 to_worse=0  to_better=10 span=10 open=none to_edge=0   # FAIR floor: 1dB from POOR
  _bpchk -101 pos=0.90 to_worse=9  to_better=1  span=10 open=none to_edge=1   # FAIR ceiling
  _bpchk -105 pos=0.50 to_worse=5  to_better=5  span=10 open=none to_edge=5   # mid-band
  _bpchk -89  pos=na   to_worse=1  to_better=na span=na open=up   to_edge=1   # open above → no pos
  _bpchk -126 pos=na   to_worse=na to_better=6  span=na open=down to_edge=6   # open below → no pos
  _bpchk ''   pos=na   to_worse=na to_better=na span=na open=na   to_edge=na  # honest-degraded
  # STRUCTURAL SWEEP — the gate that cannot be satisfied by the numbers merely being present. Every
  # edge bandpos reports must be an edge classify() ACTUALLY has: step to the reported floor and the
  # band still holds, step one dB past it and the word must change. This is what would go red if the
  # two ever carried different ladders (the reason BAND_FLOORS is one table read by both).
  _m=-131
  while [ "$_m" -le -79 ]; do
    _m=$((_m+1)); _v="$(classify "$_m")"; _bp="$(bandpos "$_m")"
    _get() { local t="${_bp#*$1=}"; printf '%s' "${t%% *}"; }
    _tw="$(_get to_worse)"; _tb="$(_get to_better)"; _op="$(_get open)"; _ps="$(_get pos)"; _te="$(_get to_edge)"
    if [ "$_tw" != na ]; then
      [ "$(classify $((_m - _tw)))"     = "$_v" ] || { echo "  FAIL: $_m ${_v}: floor+0 ($((_m-_tw))) left the band"; f=1; }
      [ "$(classify $((_m - _tw - 1)))" != "$_v" ] || { echo "  FAIL: $_m ${_v}: one dB below the reported floor is still $_v — floor is wrong"; f=1; }
    fi
    if [ "$_tb" != na ]; then
      [ "$(classify $((_m + _tb)))"     != "$_v" ] || { echo "  FAIL: $_m ${_v}: reported next-band edge ($((_m+_tb))) is still $_v"; f=1; }
      [ "$(classify $((_m + _tb - 1)))" = "$_v" ] || { echo "  FAIL: $_m ${_v}: one dB below the next-band edge already left $_v"; f=1; }
    fi
    if [ "$_op" = none ]; then
      case "$_ps" in na|'') echo "  FAIL: $_m ${_v}: interior band rendered pos=na"; f=1;; esac
      _min="$_tw"; [ "$_tb" -lt "$_min" ] && _min="$_tb"
      [ "$_te" = "$_min" ] || { echo "  FAIL: $_m ${_v}: to_edge=$_te != min(to_worse,to_better)=$_min"; f=1; }
    else
      [ "$_ps" = na ] || { echo "  FAIL: $_m ${_v}: open band ($_op) fabricated pos=$_ps"; f=1; }
    fi
  done
  # WIRING: the extractor the real-read path uses, on a real bandpos line. `to_edge` and `to_worse`
  # both contain "to_"; `pos` is also a substring of nothing else here — but a future field named
  # e.g. `pos_iv` would collide, and this is the gate that would notice.
  _bl="$(bandpos -110)"
  [ "$(bp_field pos       "$_bl")" = 0.00 ] || { echo "  FAIL: bp_field pos → [$(bp_field pos "$_bl")]"; f=1; }
  [ "$(bp_field to_worse  "$_bl")" = 0    ] || { echo "  FAIL: bp_field to_worse → [$(bp_field to_worse "$_bl")]"; f=1; }
  [ "$(bp_field to_better "$_bl")" = 10   ] || { echo "  FAIL: bp_field to_better → [$(bp_field to_better "$_bl")]"; f=1; }
  [ "$(bp_field to_edge   "$_bl")" = 0    ] || { echo "  FAIL: bp_field to_edge → [$(bp_field to_edge "$_bl")]"; f=1; }
  [ "$(bp_field open      "$_bl")" = none ] || { echo "  FAIL: bp_field open → [$(bp_field open "$_bl")]"; f=1; }
  _bl="$(bandpos -126)"
  [ "$(bp_field pos "$_bl")" = na   ] || { echo "  FAIL: bp_field pos (open band) → [$(bp_field pos "$_bl")]"; f=1; }
  [ "$(bp_field open "$_bl")" = down ] || { echo "  FAIL: bp_field open (open band) → [$(bp_field open "$_bl")]"; f=1; }
  [ "$f" = 0 ] || { echo "smoke-test: FAIL (classify/parse/bandpos logic drifted)"; exit 1; }
  # REAL-READ assertion (2026-07-07): reachability ≠ producing. The classifier smoke above stays
  # green even when the phone body has been unreachable for hours and .cell-signal.state is stale —
  # the exact hollow-sense signature (cron-green + smoke-green, no fresh artifact). This gate was
  # MISSING: mesh-cell-signal was the ONE phone sense whose --test returned 0 while every sibling
  # (mag/gyro/light/baro/gravity/phone-ap/…) honestly returned 2 on an unreachable phone. Mirror the
  # mag/gyro fix (d657375): probe the REAL SSH path, then assert the live termux-telephony-cellinfo
  # read parses to a registered-cell metric. Honest exit 2 when the organ is unreachable (mesh-land
  # treats 2 as a pass → never blocks landing on an offline phone), but the smoke-green theater is gone.
  source "$HOME/.local/bin/mesh-patterns.sh" 2>/dev/null || true
  _pip="$(phone_reachable_ip 2>/dev/null)" \
    || { echo "smoke-test: n/a (phone unreachable — cell sense unavailable); classify/parse/bandpos logic ok"; exit 2; }
  _raw="$(timeout 12 ssh $SSH_OPTS -p "$PHONE_PORT" "${PHONE_USER_DEF}@${_pip}" \
    'timeout 8 termux-telephony-cellinfo 2>/dev/null' </dev/null 2>/dev/null)"
  _lrc="$(printf '%s' "$_raw" | python3 -c '
import json,sys
try: cells=json.load(sys.stdin)
except Exception: sys.exit(4)
if not isinstance(cells,list): sys.exit(4)
reg=[c for c in cells if c.get("registered")]
if not reg: sys.exit(4)                       # no service / airplane mode → honest n/a
s=str(reg[0].get("rsrp", reg[0].get("dbm","")))
sys.exit(0 if (s and s.lstrip("-").isdigit()) else 4)' 2>/dev/null; echo $?)"
  if [ "$_lrc" = 0 ]; then
    echo "smoke-test: ok (classify:6 + honest-unknown:2 + registered-parse:1 + bandpos:6 + edge-sweep:52 + extractor-wiring:7 + REAL registered-cell RSRP read)"; exit 0
  fi
  echo "smoke-test: n/a (phone reachable but termux-telephony-cellinfo yielded no registered-cell metric — sense not producing a real artifact; the hollow-sense signature); classify/parse logic ok"
  exit 2
fi

JSON=0; EDGE=0
case "${1:-}" in --json) JSON=1;; --edge) EDGE=1;; esac
TS="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

# Resolve the phone LAN-FIRST (see header). Reachability is gated by the real SSH below.
PHONE_IP="${PHONE_IP:-$(mesh-phone-ip 2>/dev/null | tail -1)}"
[ -n "$PHONE_IP" ] || PHONE_IP="$(mesh-peer-addr Redmi 2>/dev/null || true)"

honest_unreach() {  # <reason> — print/exit 2 without faking a reading
  local why="$1"
  # Liveness-touch (2026-07-08, chat-review/hollow-sense-liveness): the OFFLINEFILE guard below is
  # message-dedup only (announce the transition once) — it must NOT gate whether the reflex looks
  # ALIVE. Without this, a phone down for hours goes fully silent (no echo, no touch) and the frozen
  # STATE mtime is indistinguishable from a dead cron (mesh-cell-signal sat 29h+ dark, cron still
  # firing every 45min, chat-review/hollow-sense-liveness). mesh-state-touch refreshes mtime on every
  # EXISTING-file run without faking content — same convention as mesh-activity-tempo (f3f84c1).
  mesh-state-touch "$STATE" 2>/dev/null
  [ -f "$OFFLINEFILE" ] || { echo "mesh-cell-signal: $why — cellular sense unavailable (not faked)" >&2; touch "$OFFLINEFILE"; }
  if [ "$JSON" = 1 ]; then printf '{"ts":"%s","status":"UNREACHABLE","reason":"%s"}\n' "$TS" "$why"; fi
  exit 2
}

[ -n "$PHONE_IP" ] || honest_unreach "no phone address"
timeout 2 bash -c "echo >/dev/tcp/$PHONE_IP/$PHONE_PORT" 2>/dev/null || honest_unreach "phone unreachable ($PHONE_IP:$PHONE_PORT)"

raw="$(timeout 12 ssh $SSH_OPTS -p "$PHONE_PORT" "${PHONE_USER_DEF}@${PHONE_IP}" \
  'timeout 8 termux-telephony-cellinfo 2>/dev/null' </dev/null 2>/dev/null)"
[ -n "$raw" ] || honest_unreach "no cellinfo (telephony permission / airplane mode?)"

# Parse the REGISTERED serving cell. No registered cell = no service → honest exit 2.
parsed="$(printf '%s' "$raw" | python3 -c '
import json,sys
try: cells=json.load(sys.stdin)
except Exception: sys.exit(3)
if not isinstance(cells,list): sys.exit(3)
reg=[c for c in cells if c.get("registered")]
if not reg: sys.exit(4)
c=reg[0]
metric=c.get("rsrp", c.get("dbm",""))
band=(c.get("bands") or ["?"])[0]
# plain str-join (NOT an f-string with escaped quotes — backslashes in f-string braces are a
# SyntaxError on Python <3.12; that bug made the first real read falsely report "unparseable").
print("\t".join(str(x) for x in (metric, c.get("type","?"), c.get("rsrq","?"), c.get("level","?"), band, len(cells))))
' 2>/dev/null)"; prc=$?
[ "$prc" = 4 ] && honest_unreach "no registered cell (no service / airplane mode)"
[ "$prc" = 0 ] && [ -n "$parsed" ] || honest_unreach "cellinfo unparseable"

rm -f "$OFFLINEFILE"
split_row "$parsed"
VERDICT="$(classify "$METRIC")"
POSFIELDS="$(bandpos "$METRIC")"          # pos= to_worse= to_better= span= open= to_edge=
# Field extraction WITHOUT eval: METRIC is a value the phone hands us, and an eval'd assignment is
# where a writer-controlled value escapes its own record format. bandpos already renders every
# non-numeric metric as na, but the parse must not depend on that being true.
BP_pos="$(bp_field pos "$POSFIELDS")";       BP_to_worse="$(bp_field to_worse "$POSFIELDS")"
BP_to_better="$(bp_field to_better "$POSFIELDS")"; BP_span="$(bp_field span "$POSFIELDS")"
BP_open="$(bp_field open "$POSFIELDS")";     BP_to_edge="$(bp_field to_edge "$POSFIELDS")"
line="cell=$VERDICT (${METRIC}dBm rsrq=${RSRQ} ${RAT} band=${BAND} bars=${LEVEL} | ${NCELLS} cells visible) pos=${BP_pos} to_edge=${BP_to_edge}dB (${BP_to_worse}dB above floor, ${BP_to_better}dB below next band, open=${BP_open}) at=$TS"

_jnum() { case "$1" in ''|na) printf null;; *) printf '%s' "$1";; esac; }

if [ "$JSON" = 1 ]; then
  printf '{"ts":"%s","status":"OK","verdict":"%s","dbm":%s,"rat":"%s","rsrq":"%s","level":"%s","band":"%s","cells":%s,"pos":%s,"to_worse_db":%s,"to_better_db":%s,"band_span_db":%s,"band_open":"%s","to_edge_db":%s}\n' \
    "$TS" "$VERDICT" "${METRIC:-null}" "$RAT" "$RSRQ" "$LEVEL" "$BAND" "${NCELLS:-0}" \
    "$(_jnum "$BP_pos")" "$(_jnum "$BP_to_worse")" "$(_jnum "$BP_to_better")" \
    "$(_jnum "$BP_span")" "$BP_open" "$(_jnum "$BP_to_edge")"
elif [ "$EDGE" = 1 ]; then
  # Debounced-ish: write state on every successful read (value + freshness). A consumer dash ages by
  # mtime; an unreachable phone simply stops updating it → it goes STALE honestly (never a faked level).
  # The verdict stays FIELD 1 (`cut -d'|' -f1`) — the continuum is APPENDED beside it, never in place
  # of it, so a consumer that only ever wanted the band word is unaffected.
  printf '%s|dbm=%s|pos=%s|to_edge=%s|to_worse=%s|to_better=%s|open=%s|ts=%s\n' \
    "$VERDICT" "$METRIC" "$BP_pos" "$BP_to_edge" "$BP_to_worse" "$BP_to_better" "$BP_open" "$TS" > "$STATE"
  printf '[cell-signal] %s\n' "$line"
else
  printf '%s\n' "$line"
fi
