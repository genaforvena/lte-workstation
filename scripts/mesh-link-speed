#!/usr/bin/env bash
# orphan-ok: on-demand physical-link probe — reads negotiated NIC speed when a dashboard or operator asks;
#   no cadence is appropriate because this is an instantaneous link property, not a durable state.
# mesh-link-speed — live negotiated Ethernet/Wi-Fi link speed from sysfs.
#
# Honest contract:
#   0 = one or more non-loopback interfaces yielded a real numeric speed (0 means no link)
#   2 = no readable numeric speed source exists on this node
#
#   mesh-link-speed             human-readable live reading
#   mesh-link-speed --json      machine-readable live reading
#   mesh-link-speed --test      fixture parser checks + real sysfs read gate
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6)
export HOME

ROOT="${MESH_LINK_SPEED_ROOT:-/sys/class/net}"
JSON=0
for arg in "$@"; do
  case "$arg" in
    --json) JSON=1 ;;
    --test) ;;
    *) echo "mesh-link-speed: unknown argument '$arg'" >&2; exit 2 ;;
  esac
done

read_links() {
  local root="$1" iface path speed
  local found=0
  shopt -s nullglob
  for path in "$root"/*/speed; do
    iface="${path%/speed}"
    iface="${iface##*/}"
    [ "$iface" != lo ] || continue
    [ -r "$path" ] || continue
    speed="$(tr -d '[:space:]' < "$path" 2>/dev/null)"
    case "$speed" in
      ''|*[!0-9]*) continue ;;
    esac
    printf '%s\t%s\n' "$iface" "$speed"
    found=1
  done
  shopt -u nullglob
  [ "$found" -eq 1 ]
}

if [ "${1:-}" = --test ]; then
  td="$(mktemp -d)" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
  trap 'rm -rf "$td"' EXIT
  mkdir -p "$td/net/eth0" "$td/net/lo"
  printf '1000\n' > "$td/net/eth0/speed"
  printf -- '-1\n' > "$td/net/lo/speed"
  fixture="$(MESH_LINK_SPEED_ROOT="$td/net" "$0" --json 2>/dev/null)" || {
    echo "smoke-test: FAIL (fixture read)"; exit 1;
  }
  printf '%s\n' "$fixture" | grep -q '"eth0"' || {
    echo "smoke-test: FAIL (fixture omitted eth0: $fixture)"; exit 1;
  }
  printf '%s\n' "$fixture" | grep -q '"speed_mbps":1000' || {
    echo "smoke-test: FAIL (fixture speed wrong: $fixture)"; exit 1;
  }
  empty="$td/empty"; mkdir -p "$empty"
  if MESH_LINK_SPEED_ROOT="$empty" "$0" --json >/dev/null 2>&1; then
    echo "smoke-test: FAIL (empty root must exit 2)"; exit 1
  else
    rc=$?
    [ "$rc" -eq 2 ] || { echo "smoke-test: FAIL (empty root rc=$rc)"; exit 1; }
  fi
  live="$(MESH_LINK_SPEED_ROOT=/sys/class/net "$0" --json 2>/dev/null)"
  rc=$?
  [ "$rc" -eq 0 ] || {
    echo "smoke-test: n/a (no readable negotiated link speed source)"
    exit 2
  }
  printf '%s\n' "$live" | grep -q '"interfaces":' || {
    echo "smoke-test: FAIL (live artifact missing interfaces: $live)"; exit 1;
  }
  echo "smoke-test: ok (fixture + empty-root exit-2 + live sysfs speed read)"
  exit 0
fi

rows="$(read_links "$ROOT")" || {
  [ "$JSON" -eq 1 ] && printf '{"interfaces":[],"status":"UNREACHABLE","source":"%s"}\n' "$ROOT"
  echo "mesh-link-speed: UNREACHABLE — no readable numeric non-loopback speed in $ROOT" >&2
  exit 2
}

ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
count=0
if [ "$JSON" -eq 1 ]; then
  printf '{"ts":"%s","interfaces":[' "$ts"
  while IFS=$'\t' read -r iface speed; do
    [ "$count" -eq 0 ] || printf ','
    printf '{"iface":"%s","speed_mbps":%s,"link":"%s"}' \
      "$iface" "$speed" "$([ "$speed" -eq 0 ] && echo NO_LINK || echo LINK)"
    count=$((count + 1))
  done <<< "$rows"
  printf '],"status":"LIVE"}\n'
else
  while IFS=$'\t' read -r iface speed; do
    if [ "$speed" -eq 0 ]; then link=NO_LINK; else link=LINK; fi
    printf '[link-speed] %s — %s negotiated=%s Mb/s @ %s\n' "$link" "$iface" "$speed" "$ts"
  done <<< "$rows"
fi
