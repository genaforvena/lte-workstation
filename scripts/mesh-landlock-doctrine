#!/usr/bin/env bash
# reflex-cadence: 41 5 * * 1
# mesh-landlock-doctrine — the DRIFT GATE for CLAUDE.md's Landlock paragraph.
#
# WHY THIS EXISTS. pub staked `[verify] the-landlock-doctrine-has-no-artifact-anywhere-but-prose`
# (board 2026-08-20T14:56:47Z, owner: mesh-doctor/genome) with a genuinely open question: is a
# doctrine block WITHOUT a re-deriving probe an acceptable resting state for a measured claim?
# The answer this tool IS: no — not for a claim whose numbers are KERNEL-BOUND. CLAUDE.md asserts
# "ABI 4 on kernel 6.8" and "handled_access_net defines EXACTLY two rights (BIND_TCP, CONNECT_TCP),
# bits 2..5 return EINVAL". Both are facts about a kernel, not about the mesh; a kernel upgrade that
# widens the vocabulary silently converts the paragraph from measured into wrong, and nothing
# re-derives it (`a-constant-outlives-its-reader`, the n=29 medians). The mesh's own rule — the
# artifact for a number is a RE-DERIVATION — applies to a doctrine file exactly as to a tool.
#
# The doctrine block is a trap-for-the-next-hand ("nothing in scripts/ uses either today"), which is
# precisely the state in which somebody writes `# no network` over a Landlock ruleset and nobody is
# warned. A tripwire is what makes prose load-bearing.
#
# THE CHECKER OBEYS THE DOCTRINE IT CHECKS. Its own lesson is "when a probe returns a bare integer,
# assert what QUESTION was asked" — landlock_create_ruleset(NULL,0,flags) answers with a small
# positive int for flags=1 (ABI VERSION -> 4) and for flags=2 (ERRATA bitmask -> 5), and nothing in
# the return distinguishes them. So this probe (a) pins flags=1 by name, (b) reports the errata value
# SEPARATELY and never as the version, and (c) asserts the wrong-question path ERRORS (flags=4 ->
# EINVAL). If that discriminator ever stops erroring, the probe says so instead of reporting a number.
#
# Verdicts (rc): 0 AGREE · 3 DRIFT (prose and kernel disagree — the paragraph must be re-measured)
#                2 n/a  (no Landlock here, no python3, or no doctrine block to check — LOUD, says why)
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"

DOCTRINE="${MESH_LANDLOCK_DOCTRINE_FILE:-$HOME/lte-workstation/CLAUDE.md}"

# ── claimed: what the PROSE says, parsed from the doctrine file ───────────────────────────────────
# Deliberately narrow greps: a paragraph that no longer states a number renders n/a (nothing to
# check), never a silent pass — an unparseable claim must not read as agreement.
ld_claimed_abi(){ grep -oE 'ABI \*\*[0-9]+\*\*' "$1" 2>/dev/null | head -1 | grep -oE '[0-9]+'; }
ld_claimed_rights(){  # the rights the prose enumerates, sorted, comma-joined
  grep -oE '`(BIND|CONNECT)_TCP`' "$1" 2>/dev/null | tr -d '`' | sort -u | paste -sd, -; }

# ── measured: what the KERNEL says ───────────────────────────────────────────────────────────────
# <abi>|<errata>|<accepted-net-bits>|<wrong-question-errors:1|0>   (empty line = landlock absent)
ld_probe(){
  command -v python3 >/dev/null 2>&1 || return 2
  python3 - <<'PY' 2>/dev/null
import ctypes, ctypes.util, os
libc = ctypes.CDLL(ctypes.util.find_library("c") or "libc.so.6", use_errno=True)
CR = 444  # landlock_create_ruleset
def sc(*a):
    ctypes.set_errno(0)
    r = libc.syscall(ctypes.c_long(CR), *a)
    return r, ctypes.get_errno()
# (a) the VERSION question, pinned by its flag: LANDLOCK_CREATE_RULESET_VERSION == 1
abi, _ = sc(ctypes.c_void_p(0), ctypes.c_size_t(0), ctypes.c_uint32(1))
if abi < 0:
    raise SystemExit(1)
# (b) the ERRATA question — a DIFFERENT question in the same type. Reported separately, never as abi.
errata, _ = sc(ctypes.c_void_p(0), ctypes.c_size_t(0), ctypes.c_uint32(2))
# (c) the discriminator: the wrong-question path must ERROR, or a bare int cannot be trusted at all
bad, ebad = sc(ctypes.c_void_p(0), ctypes.c_size_t(0), ctypes.c_uint32(4))
discriminates = 1 if bad < 0 else 0
# (d) the VOCABULARY of handled_access_net: which bits does this kernel actually accept?
class Attr(ctypes.Structure):
    _fields_ = [("handled_access_fs", ctypes.c_uint64), ("handled_access_net", ctypes.c_uint64)]
accepted = []
for bit in range(8):
    a = Attr(0, 1 << bit)
    r, e = sc(ctypes.byref(a), ctypes.c_size_t(ctypes.sizeof(a)), ctypes.c_uint32(0))
    if r >= 0:
        accepted.append(bit); os.close(r)
print("%d|%d|%s|%d" % (abi, errata, ",".join(str(b) for b in accepted), discriminates))
PY
}

# ── the verdict, PURE (the suite asserts this, not a copy of it) ─────────────────────────────────
# ld_verdict <claimed_abi> <claimed_rights> <measured_abi> <accepted_bits> <discriminates>
#   -> "AGREE|msg" / "DRIFT|msg" / "NA|msg"
# The rights vocabulary is checked by its SIZE against the enumerated names: the doctrine's claim is
# "EXACTLY two rights", so a kernel that accepts a third has widened the noun the prose says is
# closed — the exact rot this gate exists for. A NARROWER kernel is drift too (the prose would be
# promising a right that is not there).
ld_verdict(){
  local cabi="${1:-}" crights="${2:-}" mabi="${3:-}" bits="${4:-}" disc="${5:-}" nbits ncl
  [ -n "$mabi" ] || { echo "NA|no Landlock on this kernel (landlock_create_ruleset unavailable) — the doctrine's numbers cannot be re-derived HERE, and are not thereby confirmed"; return 0; }
  [ -f "$DOCTRINE" ] || { echo "NA|no doctrine file at $DOCTRINE — this node carries no genome checkout, so there is no prose to re-derive here (absence of the subject, not agreement with it)"; return 0; }
  [ -n "$cabi" ] && [ -n "$crights" ] || { echo "NA|the doctrine file states no ABI number and/or no enumerated rights — nothing to re-derive (an unparseable claim must never read as agreement)"; return 0; }
  [ "$disc" = 1 ] || { echo "DRIFT|the wrong-question probe (flags=4) STOPPED erroring — a bare integer from this syscall can no longer be trusted to answer the question asked, so neither number below is safe to report"; return 0; }
  nbits=$(printf '%s' "$bits" | tr ',' '\n' | grep -c '[0-9]')
  ncl=$(printf '%s' "$crights" | tr ',' '\n' | grep -c '[A-Z]')
  [ "$cabi" = "$mabi" ] || { echo "DRIFT|the doctrine says Landlock ABI $cabi, this kernel answers $mabi ($(uname -r)) — re-measure the paragraph before trusting any right it enumerates"; return 0; }
  [ "$nbits" = "$ncl" ] || { echo "DRIFT|the doctrine enumerates $ncl net right(s) ($crights) as the COMPLETE vocabulary; this kernel accepts $nbits handled_access_net bit(s) [$bits] — a widened noun means a sandbox written to that prose is looser than it reads"; return 0; }
  echo "AGREE|ABI $mabi · handled_access_net accepts exactly $nbits bit(s) [$bits] = the enumerated $crights · wrong-question path still errors"
}

ld_run(){
  local out cabi crights mabi merr bits disc v
  out="$(ld_probe)"
  cabi="$(ld_claimed_abi "$DOCTRINE")"; crights="$(ld_claimed_rights "$DOCTRINE")"
  IFS='|' read -r mabi merr bits disc <<<"${out:-}"
  v="$(ld_verdict "$cabi" "$crights" "${mabi:-}" "${bits:-}" "${disc:-}")"
  case "$v" in
    AGREE\|*) echo "mesh-landlock-doctrine: AGREE — ${v#*|}"
              echo "  (errata bitmask = ${merr:-?}, a DIFFERENT question in the same type — never the ABI version)"
              return 0 ;;
    DRIFT\|*) echo "mesh-landlock-doctrine: DRIFT — ${v#*|}"
              echo "  doctrine: $DOCTRINE (the 'flag whose NAME is wider than its VOCABULARY' paragraph)"
              return 3 ;;
    *)        echo "mesh-landlock-doctrine: n/a — ${v#*|}"; return 2 ;;
  esac
}

case "${1:-}" in
  --test)
    _f(){ echo "smoke-test: FAIL ($1)"; exit 1; }
    # ── the classifier, on fixtures. Every leg seen RED before it was written.
    case "$(ld_verdict 4 BIND_TCP,CONNECT_TCP 4 0,1 1)" in "AGREE|"*) ;; *) _f "the measured state MATCHING the prose stopped agreeing";; esac
    case "$(ld_verdict 4 BIND_TCP,CONNECT_TCP 5 0,1 1)" in "DRIFT|"*"answers 5"*) ;; *) _f "an ABI the prose does not claim read as agreement — the number rots silently, which is the whole point";; esac
    case "$(ld_verdict 4 BIND_TCP,CONNECT_TCP 4 0,1,2 1)" in "DRIFT|"*"widened"*) ;; *) _f "a kernel accepting a THIRD net right read as agreement — a sandbox written to '# no TCP' would be looser than its comment";; esac
    case "$(ld_verdict 4 BIND_TCP,CONNECT_TCP 4 0 1)" in "DRIFT|"*) ;; *) _f "a NARROWER kernel read as agreement — the prose would promise a right that is not there";; esac
    # the discriminator leg: if the wrong-question path stops erroring, NO number may be reported
    case "$(ld_verdict 4 BIND_TCP,CONNECT_TCP 4 0,1 0)" in "DRIFT|"*"no longer be trusted"*) ;; *) _f "the wrong-question discriminator was ignored — the ABI-vs-ERRATA trap the doctrine is about";; esac
    # n/a legs, both LOUD and both distinct from agreement
    case "$(ld_verdict 4 BIND_TCP,CONNECT_TCP '' '' '')" in "NA|"*"no Landlock"*) ;; *) _f "a kernel without Landlock did not render n/a";; esac
    ( DOCTRINE=/nonexistent/nope.md; case "$(ld_verdict '' '' 4 0,1 1)" in "NA|"*"no doctrine file"*) ;; *) exit 1;; esac ) \
      || _f "a MISSING doctrine file did not render its own n/a — a node with no genome checkout must say the subject is absent, not that the prose is unparseable"
    case "$(ld_verdict '' '' 4 0,1 1)" in "NA|"*) ;; *) _f "an unparseable claim must render n/a, never agreement — a silent pass on prose nobody can read is the vacuous gate";; esac
    for _a in "$(ld_verdict '' '' 4 0,1 1)" "$(ld_verdict 4 BIND_TCP,CONNECT_TCP '' '' '')"; do
      case "$_a" in *AGREE*) _f "an n/a rendered the agreement sentence — n/a and AGREE must never share words";; esac
    done
    # ── the PARSERS, on a fixture doctrine file (not on the live one: a parser asserted only against
    # the file it will read cannot fail while that file is unchanged).
    _t="$(mktemp -d)"
    printf 'noise\nLandlock (ABI **4**, kernel 6.8, uid 1000) defines `BIND_TCP` and `CONNECT_TCP`.\n' > "$_t/doc.md"
    [ "$(ld_claimed_abi "$_t/doc.md")" = 4 ] || { rm -rf "$_t"; _f "the ABI claim parser missed the doctrine's own sentence"; }
    [ "$(ld_claimed_rights "$_t/doc.md")" = "BIND_TCP,CONNECT_TCP" ] || { rm -rf "$_t"; _f "the rights parser missed the enumerated names: got '$(ld_claimed_rights "$_t/doc.md")'"; }
    printf 'a paragraph with no numbers at all\n' > "$_t/bare.md"
    [ -z "$(ld_claimed_abi "$_t/bare.md")" ] || { rm -rf "$_t"; _f "the ABI parser invented a claim from prose that states none"; }
    rm -rf "$_t"
    # ── and the LIVE probe must really reach the kernel here, or this tool is a fixture suite that
    # never touches the thing it checks (the mesh-whisper-run trap: a wrapper whose test drives stubs).
    _p="$(ld_probe)"; _prc=$?
    if [ "$_prc" = 2 ]; then echo "  n/a: no python3 — the live probe leg was NOT exercised"
    elif [ -z "$_p" ]; then echo "  n/a: no Landlock on $(uname -r) — the live probe leg was NOT exercised (this tool is n/a on this node)"
    else
      case "$_p" in [0-9]*\|[0-9]*\|*\|[01]) ;; *) _f "the live probe returned an unparseable row: '$_p'";; esac
      IFS='|' read -r _a _e _b _d <<<"$_p"
      [ "$_a" -ge 1 ] 2>/dev/null || _f "the live ABI read is not a positive integer: '$_a'"
      [ "$_d" = 1 ] || _f "the wrong-question path (flags=4) did NOT error on this kernel — the probe cannot tell which question it asked"
      [ "$_a" != "$_e" ] || echo "  note: version and errata answer the same integer here ($_a) — the two questions are indistinguishable by value on this kernel, which is exactly why the flag is pinned by name"
      echo "  live: ABI=$_a errata=$_e net-bits=[$_b] wrong-question-errors=$_d"
    fi
    ld_run >/dev/null; _rrc=$?
    case "$_rrc" in 0|2|3) ;; *) _f "ld_run returned rc=$_rrc — only 0/2/3 are defined";; esac
    echo "smoke-test: ok (drift classifier: match · ABI rot · widened vocabulary · narrowed vocabulary · wrong-question discriminator · both n/a legs distinct from AGREE + claim/rights parsers on a fixture + the LIVE kernel probe really driven)"
    exit 0 ;;
  --help|-h)
    sed -n '3,20p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  ""|--check) ld_run ;;
  *) echo "usage: $(basename "$0") [--check|--test|--help]"; exit 64 ;;
esac
