#!/usr/bin/env bash
# mesh-act — the mesh's first physical-world ACTUATORS beyond audio. SSHes the phone BODY and fires
# a termux actuator. The phone is the only node that can act on the physical world (buzz, light,
# screen, IR); this is the hand the way mesh-body-motion/mesh-light are the senses.
#
#   mesh-act vibrate [ms]        buzz the phone (termux-vibrate, default 500ms)
#   mesh-act torch [on|off|N]    flashlight: on / off / blink for N seconds (default blink 1.5s)
#   mesh-act notify <message…>   put a message on the phone's screen (termux-notification)
#   mesh-act ir <freqHz> <pat>   IR-transmit: control a real TV/AC (termux-infrared-transmit).
#                                EXPLICIT subcommand — it actuates real-world devices. <pat> = the
#                                comma-separated on/off microsecond pattern; <freqHz> e.g. 38000.
#   mesh-act --test              deps + phone-reachability gate (exit 2 = unreachable). NO real fire.
#
# Operator-consented (vibrate/torch/notify proven by felt/seen effect 2026-06-13; see memory
# actuator-consent-2026-06-13). IR is gated behind its own subcommand by design. Honest-organ:
# phone-unreachable → exit 2; on success it reports the termux rc, but the real artifact is the
# physical effect (a felt buzz / seen flash / on-screen message / a device that responded).
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes"

if [ "${1:-}" = --test ]; then
  command -v ssh >/dev/null 2>&1 || { echo "smoke-test: FAIL (no ssh)"; exit 1; }
  command -v mesh-phone-ip >/dev/null 2>&1 || { echo "smoke-test: FAIL (no mesh-phone-ip)"; exit 1; }
  pip="$(mesh-phone-ip 2>/dev/null)" || { echo "smoke-test: n/a (phone unreachable — no actuators)"; exit 2; }
  # reachability + presence of the actuator binaries — but NO firing.
  if ! timeout 10 ssh -p "${PHONE_SSH_PORT:-8022}" -o BatchMode=yes -o ConnectTimeout=6 \
       -o StrictHostKeyChecking=accept-new "${PHONE_USER:-u0_a380}@$pip" \
       'command -v termux-vibrate && command -v termux-torch && command -v termux-notification' \
       </dev/null >/dev/null 2>&1; then
    echo "smoke-test: n/a (phone unreachable or termux actuators missing)"; exit 2; fi
  echo "smoke-test: ok"; exit 0
fi

pip="$(mesh-phone-ip 2>/dev/null)" || { echo "phone unreachable (all IPs tried) — no actuators on this mesh" >&2; exit 2; }

# Fire a command on the body; exit 2 (n/a) if the phone can't be reached, so an unreachable phone
# is never mistaken for a successful actuation.
fire(){
  out="$(timeout 20 ssh -p "${PHONE_SSH_PORT:-8022}" -o BatchMode=yes -o ConnectTimeout=6 \
    -o StrictHostKeyChecking=accept-new "${PHONE_USER:-u0_a380}@$pip" "$1" </dev/null 2>&1)"; rc=$?
  if [ $rc -eq 124 ] || [ $rc -eq 255 ]; then
    echo "phone unreachable — actuation did NOT fire (n/a)" >&2; exit 2; fi
  [ -n "$out" ] && printf '%s\n' "$out"
  return $rc
}

cmd="${1:-}"; shift || true
case "$cmd" in
  vibrate)
    ms="${1:-500}"; case "$ms" in (*[!0-9]*|'') ms=500;; esac
    fire "termux-vibrate -d $ms"; echo "[act] vibrate ${ms}ms fired (feel the buzz)";;
  torch)
    arg="${1:-blink}"
    case "$arg" in
      on)  fire "termux-torch on";  echo "[act] torch ON (left on)";;
      off) fire "termux-torch off"; echo "[act] torch OFF";;
      *)   secs="$arg"; case "$secs" in (*[!0-9.]*|blink|'') secs=1.5;; esac
           fire "termux-torch on; sleep $secs; termux-torch off"
           echo "[act] torch blink ${secs}s fired (see the flash)";;
    esac;;
  notify)
    msg="$*"; [ -n "$msg" ] || { echo "usage: mesh-act notify <message>" >&2; exit 1; }
    # escape double-quotes for the remote shell
    esc="$(printf '%s' "$msg" | sed 's/"/\\"/g')"
    fire "termux-notification --title 'mesh ✦' --content \"$esc\" --id mesh-act"
    echo "[act] notification pushed to the body's screen: \"$msg\"";;
  ir)
    freq="${1:-}"; pat="${2:-}"
    { [ -n "$freq" ] && [ -n "$pat" ]; } || {
      echo "usage: mesh-act ir <freqHz> <on,off,on,off,…µs pattern>   (controls REAL devices)" >&2
      echo "  e.g. mesh-act ir 38000 9000,4500,560,560,560,1690   (NEC-style burst)" >&2; exit 1; }
    case "$freq" in (*[!0-9]*|'') echo "ir: <freqHz> must be numeric (e.g. 38000)" >&2; exit 1;; esac
    fire "termux-infrared-transmit -f $freq $pat"
    echo "[act] IR transmitted @ ${freq}Hz pattern=$pat (effect = a device that responded — needs a target)";;
  ''|-h|--help)
    echo "mesh-act <vibrate|torch|notify|ir> [args]  — fire a physical actuator on the phone body"; exit 1;;
  *)
    echo "mesh-act: unknown actuator '$cmd' (want: vibrate|torch|notify|ir)" >&2; exit 1;;
esac
