#!/usr/bin/env bash
# mesh-act — the mesh's ACTUATORS beyond audio. Phone actuators via termux over SSH; router
# LED actuator via sysfs over SSH. The phone is the primary body (buzz, light, screen, IR);
# the router's programmable LEDs (blue:run + white:system) provide a visible in-room signal.
#
#   mesh-act vibrate [ms]        buzz the phone (termux-vibrate, default 500ms)
#   mesh-act torch [on|off|N]    flashlight: on / off / blink for N seconds (default blink 1.5s)
#   mesh-act notify <message…>   put a message on the phone's screen (termux-notification)
#   mesh-act ir <freqHz> <pat>   IR-transmit: control a real TV/AC. EXPLICIT subcommand — it
#                                actuates real-world devices.
#                                OR: mesh-act ir <device> <command>   lookup pattern from ~/.mesh/ir-codes.conf
#                                Two backends (see "IR backends" below): termux (default) and
#                                adb+root sysfs (MESH_ACT_IR_ADB_NODE — non-termux Android bodies).
#   mesh-act led <color> <action>  router LED actuator. Color=blue|white|both. Action=on|off|flash.
#                                Flash uses kernel timer trigger (no SSH latency per blink).
#   mesh-act led-host [--node <peer>] [led] <action>   /sys/class/leds — a SILENT VISUAL actuator.
#                                Default = THIS node's own LEDs (the always-on steward; distinct from
#                                `led`, the router over SSH). `--node <user@ip|peer>` drives ANOTHER
#                                node's LEDs over one SSH call (cross-node in-room alert — a 2nd physical
#                                location; keyboard LEDs caps/num/scroll/compose/kana are software-set,
#                                NIC/wifi LEDs are HW-triggered → honest n/a). led defaults to scrolllock
#                                (least-intrusive). Actions:
#                                  list                 inventory local LEDs (read-only, no privilege)
#                                  flash [s] [on] [off] kernel-timer blink for s sec, then RESTORE the
#                                                       LED's original trigger (no per-blink sudo)
#                                  on | off             steady light / clear (hijacks the LED until off)
#                                  restore [trigger]    re-bind the LED to a trigger (default: none)
#                                  --install-rule       print the udev rule (operator installs → no sudo)
#                                Reserve for algedonic/alert signals (intrusive if routine). Verified
#                                real+reversible 2026-06-26 (discover capslock, health scrolllock local +
#                                cross-node on default-string — a different-room visual-alert location).
#   mesh-act --test              deps + phone + router reachability + local-LED real read. NO real fire.
#
# Operator-consented (vibrate/torch/notify proven by felt/seen effect; led by visible flash).
# IR gated behind its own subcommand. Honest-organ: unreachable node / no local LED → exit 2 (n/a).
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6); export HOME
[ -f "$HOME/.mesh/nodes" ] && . "$HOME/.mesh/nodes"

# --- Router resolution -------------------------------------------------------
router_addr(){
  local name="${1:-router}"
  local pair
  for pair in $MESH_NODES; do
    [ "${pair%%:*}" = "$name" ] && { printf '%s' "${pair#*:}"; return 0; }
  done
  return 1
}

# --- LED sysfs paths (GL-MT3000 OpenWrt) ------------------------------------
LED_BLUE="/sys/class/leds/blue:run"
LED_WHITE="/sys/class/leds/white:system"

led_sysfs(){
  case "$1" in
    blue)  echo "$LED_BLUE"  ;;
    white) echo "$LED_WHITE" ;;
  esac
}

led_cmd(){
  local color="$1" action="$2" delay_on="${3:-500}" delay_off="${4:-500}"
  local path; path="$(led_sysfs "$color")" || return 1
  case "$action" in
    on)    echo "echo none > '$path/trigger'; echo 1 > '$path/brightness'" ;;
    off)   echo "echo none > '$path/trigger'; echo 0 > '$path/brightness'" ;;
    flash) echo "echo timer > '$path/trigger'; echo $delay_on > '$path/delay_on'; echo $delay_off > '$path/delay_off'" ;;
  esac
}

# --- Local host LED actuator (THIS node's /sys/class/leds — a silent VISUAL channel) ---------
# Distinct from `led` (the GL-MT3000 router over SSH). These are the steward's OWN LEDs — the
# durable algedonic channel on an always-on node (the router is TS-offline 7d). Verified real +
# fully reversible 2026-06-26: discover toggled capslock, health independently cycled scrolllock
# (orig→write1/read1→write0/read0→restore). Writes prefer a udev-granted group-writable file (no
# sudo); fall back to passwordless `sudo -n` (configured here). `flash` blinks via the kernel timer
# trigger — one privileged setup write, then the KERNEL blinks: no per-blink sudo.
LEDS_DIR="${MESH_LEDS_DIR:-/sys/class/leds}"
LED_HOST_DEFAULT="${MESH_LED_HOST_DEFAULT:-scrolllock}"   # scroll-lock is rarely load-bearing → least-intrusive

ledh_path(){ # <name|substr> → /sys/class/leds/<led> dir; resolves a substring (e.g. 'scrolllock' → input3::scrolllock)
  local want="$1" d
  [ -d "$LEDS_DIR" ] || return 1
  [ -d "$LEDS_DIR/$want" ] && { printf '%s' "$LEDS_DIR/$want"; return 0; }
  for d in "$LEDS_DIR"/*; do
    [ -d "$d" ] || continue
    case "${d##*/}" in *"$want"*) printf '%s' "$d"; return 0;; esac
  done
  return 1
}

ledh_active_trigger(){ # <dir> → current active trigger token (the [bracketed] one in the trigger file), else 'none'
  local t; t="$(cat "$1/trigger" 2>/dev/null)" || { printf 'none'; return; }
  case "$t" in
    *'['*) t="${t#*[}"; t="${t%%]*}"; printf '%s' "$t" ;;
    *)     printf 'none' ;;
  esac
}

ledh_write(){ # <file> <value> → 0 on success; prefer udev-granted group write (no sudo), fall back to sudo -n
  local f="$1" v="$2"
  [ -e "$f" ] || return 1
  if [ -w "$f" ]; then printf '%s\n' "$v" > "$f" 2>/dev/null && return 0; fi
  if sudo -n true 2>/dev/null; then printf '%s\n' "$v" | sudo -n tee "$f" >/dev/null 2>&1 && return 0; fi
  return 1
}

ledh_rule(){ # print a suggested udev rule (operator installs as root → no per-blink sudo thereafter)
  local grp; grp="$(id -gn 2>/dev/null || echo "$USER")"
  cat <<EOF
# /etc/udev/rules.d/99-mesh-leds.rules — let group '$grp' write LED brightness/trigger (no per-blink sudo)
# Install (operator, root):  sudo tee /etc/udev/rules.d/99-mesh-leds.rules <<'RULE'  … then  sudo udevadm trigger -s leds
ACTION=="add", SUBSYSTEM=="leds", RUN+="/bin/sh -c 'chgrp $grp /sys/class/leds/%k/brightness /sys/class/leds/%k/trigger 2>/dev/null; chmod g+w /sys/class/leds/%k/brightness /sys/class/leds/%k/trigger 2>/dev/null'"
EOF
}

# ledh_dispatch — the WHOLE led-host driver (list/[led] flash|on|off|restore|--install-rule) against
# $LEDS_DIR. ONE source of truth: called locally, OR shipped verbatim (declare -f) to a remote node's
# shell so `--node` drives that node's LEDs over a single SSH call — no per-blink round-trips, and it
# does NOT depend on the remote having an up-to-date mesh-act. Uses `return` (not exit) so both the local
# caller and the shipped remote main propagate the rc. Honest-organ: no LEDs on the node → rc 2 (n/a).
ledh_dispatch(){
  local led action path name secs on_ms off_ms orig mx cycles i trig d
  [ -d "$LEDS_DIR" ] && ls "$LEDS_DIR"/*/brightness >/dev/null 2>&1 || {
    echo "no local LEDs on this node ($LEDS_DIR) — silent-visual actuation n/a" >&2; return 2; }

  if [ "${1:-}" = --install-rule ]; then ledh_rule; return 0; fi
  if [ "${1:-}" = list ]; then
    for d in "$LEDS_DIR"/*; do
      [ -d "$d" ] || continue
      printf '%-28s trigger=%-16s brightness=%s/%s\n' "${d##*/}" \
        "$(ledh_active_trigger "$d")" "$(cat "$d/brightness" 2>/dev/null || echo '?')" \
        "$(cat "$d/max_brightness" 2>/dev/null || echo '?')"
    done
    return 0
  fi

  # Resolve <led> <action>: if $1 is a known action verb, use the default LED; else $1 is the led.
  local from_default=0
  case "${1:-}" in
    flash|on|off|restore) led="$LED_HOST_DEFAULT"; from_default=1 ;;
    '') echo "usage: mesh-act led-host [--node <peer>] [led] <list|flash [s] [on] [off]|on|off|restore [trig]|--install-rule>" >&2; return 1 ;;
    *)  led="$1"; shift || true ;;
  esac
  action="${1:-}"; shift || true
  path="$(ledh_path "$led")" || {
    if [ "$from_default" = 1 ]; then
      # The DEFAULT is a configured guess (MESH_LED_HOST_DEFAULT), not a user-typed name — on a node
      # whose only LEDs are a different class (e.g. NIC-port LEDs, no scrolllock), that guess is a
      # phantom target. Distinguish from a typo'd explicit name (still exit 1): this is a structural
      # absence, so it's honest n/a, never a faked read against a substituted LED.
      echo "led-host: default LED '$led' absent on this node (inventory: $(ls "$LEDS_DIR" 2>/dev/null | tr '\n' ' ')) — n/a (mesh-act led-host list; set MESH_LED_HOST_DEFAULT or name a LED explicitly to actuate one of those instead)" >&2
      return 2
    fi
    echo "led-host: no LED matching '$led' (try: mesh-act led-host list)" >&2; return 1
  }
  name="${path##*/}"

  case "$action" in
    flash)
      secs="${1:-3}";  case "$secs"  in (*[!0-9.]*|'') secs=3;;   esac
      on_ms="${2:-300}"; case "$on_ms" in (*[!0-9]*|'') on_ms=300;; esac
      off_ms="${3:-300}"; case "$off_ms" in (*[!0-9]*|'') off_ms=300;; esac
      orig="$(ledh_active_trigger "$path")"
      mx="$(cat "$path/max_brightness" 2>/dev/null || echo 1)"
      if grep -qw timer "$path/trigger" 2>/dev/null; then
        # ledtrig-timer present → the KERNEL blinks: one privileged setup write, no per-blink sudo.
        ledh_write "$path/trigger" timer || {
          echo "led-host: cannot set trigger on $name (no group-write, no sudo -n) — n/a" >&2; return 2; }
        ledh_write "$path/delay_on" "$on_ms"  || true
        ledh_write "$path/delay_off" "$off_ms" || true
        sleep "$secs"
        ledh_write "$path/trigger" "$orig" || true       # restore the LED to its normal function
        [ "$orig" = none ] && ledh_write "$path/brightness" 0 || true
        echo "[act] led-host $name FLASHED ${secs}s (kernel timer ${on_ms}/${off_ms}ms — no per-blink sudo); trigger restored=$orig"
      else
        # No ledtrig-timer on this kernel (this host: input LEDs list no 'timer' trigger) → bounded
        # SOFTWARE blink. Honors the spirit where the udev rule grants group-write (then sudo-free);
        # to upgrade flash to the zero-per-blink kernel path, load ledtrig_timer (+ /etc/modules-load.d).
        ledh_write "$path/trigger" none || {
          echo "led-host: cannot drive $name (no group-write, no sudo -n) — n/a" >&2; return 2; }
        cycles="$(awk "BEGIN{c=int($secs*1000/($on_ms+$off_ms+1)); print (c<1)?1:c}")"
        i=0
        while [ "$i" -lt "$cycles" ]; do
          ledh_write "$path/brightness" "$mx" || break
          sleep "$(awk "BEGIN{print $on_ms/1000}")"
          ledh_write "$path/brightness" 0 || break
          sleep "$(awk "BEGIN{print $off_ms/1000}")"
          i=$((i+1))
        done
        ledh_write "$path/trigger" "$orig" || true       # restore the LED to its normal function
        [ "$orig" = none ] && ledh_write "$path/brightness" 0 || true
        echo "[act] led-host $name FLASHED ${cycles}× (software ${on_ms}/${off_ms}ms — no ledtrig-timer on this kernel); trigger restored=$orig"
      fi
      ;;
    on)
      ledh_write "$path/trigger" none && \
      ledh_write "$path/brightness" "$(cat "$path/max_brightness" 2>/dev/null || echo 1)" && \
        echo "[act] led-host $name ON (hijacked steady; clear with: mesh-act led-host $name off)" || {
        echo "led-host: write to $name failed (no group-write, no sudo -n) — n/a" >&2; return 2; }
      ;;
    off)
      ledh_write "$path/trigger" none && ledh_write "$path/brightness" 0 && \
        echo "[act] led-host $name OFF" || {
        echo "led-host: write to $name failed — n/a" >&2; return 2; }
      ;;
    restore)
      trig="${1:-none}"
      ledh_write "$path/trigger" "$trig" && echo "[act] led-host $name trigger restored=$trig" || {
        echo "led-host: restore on $name failed — n/a" >&2; return 2; }
      ;;
    ''|*)
      echo "usage: mesh-act led-host [--node <peer>] [led] <list|flash [s] [on] [off]|on|off|restore [trig]|--install-rule>" >&2; return 1 ;;
  esac
}

# ledh_resolve_node — <user@ip|peer-name> → an ssh target (user@ip). Mirrors mesh-tell's peer map so a
# bare node name resolves via mesh-peer-addr. A literal user@host passes through untouched.
ledh_resolve_node(){
  local name="$1" user peer_dns addr pa
  case "$name" in *@*) printf '%s' "$name"; return 0;; esac
  case "$name" in
    IdeaPad|imozerov-IdeaPad-3-15IIL05) user=imozerov ;;
    ds|default-string|imozerov-Default-string) user=imozerov; peer_dns=default-string ;;
    ilya) user=ilya ;;
    *) echo "led-host: unknown peer '$name' (use user@ip for direct SSH)" >&2; return 1 ;;
  esac
  peer_dns="${peer_dns:-$name}"
  pa="$(command -v mesh-peer-addr 2>/dev/null)" || pa="$(dirname "$0")/mesh-peer-addr"
  addr="$("$pa" "$peer_dns" 2>/dev/null)" || { echo "led-host: mesh-peer-addr failed for '$peer_dns'" >&2; return 1; }
  printf '%s' "$user@$addr"
}

# ledh_remote — ship the driver (its own functions, single-sourced via declare -f) to a remote node's
# shell and run ledh_dispatch THERE, in ONE ssh call. The remote needs only bash + sshd + (group-write
# OR sudo -n on /sys/class/leds) — NOT an up-to-date mesh-act. Keyboard LEDs (caps/num/scroll/compose/
# kana) are software-settable; NIC/wifi LEDs are HW-triggered → a write honestly fails → rc 2 (never a
# faked alert). MESH_ACT_SMOKE_CAPTURE short-circuits to a dry-run (synthesised program, no real ssh).
ledh_remote(){
  local target="$1"; shift
  local prog qargs a
  prog="$(declare -f ledh_path ledh_active_trigger ledh_write ledh_rule ledh_dispatch)"
  prog="$prog"'
LEDS_DIR="${MESH_LEDS_DIR:-/sys/class/leds}"
LED_HOST_DEFAULT="${MESH_LED_HOST_DEFAULT:-scrolllock}"
ledh_dispatch "$@"'
  qargs=""; for a in "$@"; do qargs="$qargs $(printf '%q' "$a")"; done
  if [ -n "${MESH_ACT_SMOKE_CAPTURE:-}" ]; then          # --test dry-run: record, never ssh
    { printf 'LEDHOST-NODE=%s ARGS:%s\n' "$target" "$qargs"; printf '%s\n' "$prog"; } >> "$MESH_ACT_SMOKE_CAPTURE"
    return 0
  fi
  ssh -o BatchMode=yes -o ConnectTimeout=8 -o StrictHostKeyChecking=accept-new \
    "$target" "bash -s --$qargs" <<<"$prog"
}

act_smoke_assert(){
  local capture="${1:-}" fail=0 raddr pip blue_on white_flash
  capture="${capture:-/dev/null}"

  command -v ssh >/dev/null 2>&1 || { echo "  FAIL: ssh missing"; fail=1; }
  command -v mesh-phone-ip >/dev/null 2>&1 || { echo "  FAIL: mesh-phone-ip missing"; fail=1; }
  pip="$(mesh-phone-ip 2>/dev/null)" || { echo "  FAIL: mesh-phone-ip returned no phone IP"; fail=1; pip=""; }
  raddr="$(router_addr router 2>/dev/null || router_addr GL-MT3000 2>/dev/null || true)"
  [ -n "$raddr" ] || { echo "  FAIL: router not registered in ~/.mesh/nodes"; fail=1; }

  blue_on="echo none > '/sys/class/leds/blue:run/trigger'; echo 1 > '/sys/class/leds/blue:run/brightness'"
  white_flash="echo timer > '/sys/class/leds/white:system/trigger'; echo 125 > '/sys/class/leds/white:system/delay_on'; echo 250 > '/sys/class/leds/white:system/delay_off'"
  [ "$(led_cmd blue on)" = "$blue_on" ] || { echo "  FAIL: blue/on command synthesis drifted"; fail=1; }
  [ "$(led_cmd white flash 125 250)" = "$white_flash" ] || { echo "  FAIL: white/flash command synthesis drifted"; fail=1; }

  : > "$capture"
  MESH_ACT_SMOKE_CAPTURE="$capture" timeout 15 ssh -o BatchMode=yes -o ConnectTimeout=6 \
    -o StrictHostKeyChecking=accept-new "$raddr" "sh -c '$(led_cmd blue on)'" \
    </dev/null >/dev/null 2>&1 || {
    echo "  FAIL: router dry-run refused the synthesized led command"; fail=1; }
  capture_seen=0
  while IFS= read -r line; do
    case "$line" in
      *"blue:run/brightness"*) capture_seen=1 ;;
    esac
  done < "$capture"
  [ "$capture_seen" = 1 ] || { echo "  FAIL: ssh dry-run did not receive the blue-led command"; fail=1; }

  # led-host --node remote-driver synthesis: build the shipped program via the dry-run capture branch,
  # assert it carries the single-sourced driver AND parses clean as bash. NO real ssh (capture short-
  # circuits ledh_remote before the ssh call) — honours the "no real fire" contract. Built-ins only
  # (the stub child PATH has no grep/sed/cat); $BASH = this bash's own path → usable without PATH.
  local rcap="${capture}.ledhost"; : > "$rcap"
  MESH_ACT_SMOKE_CAPTURE="$rcap" ledh_remote "tester@198.51.100.9" scrolllock flash 1 >/dev/null 2>&1
  local ln saw_node=0 saw_disp=0 body="" first=1
  while IFS= read -r ln; do
    case "$ln" in "LEDHOST-NODE=tester@198.51.100.9"*) saw_node=1 ;; esac
    case "$ln" in "ledh_dispatch ()"*) saw_disp=1 ;; esac
    if [ "$first" = 1 ]; then first=0; else body="$body$ln"$'\n'; fi
  done < "$rcap"
  [ "$saw_node" = 1 ] || { echo "  FAIL: led-host --node did not synthesise a remote target"; fail=1; }
  [ "$saw_disp" = 1 ] || { echo "  FAIL: led-host --node remote program omits the single-sourced ledh_dispatch driver"; fail=1; }
  local bodyf="${rcap}.body"; printf '%s' "$body" > "$bodyf"
  "$BASH" -n "$bodyf" 2>/dev/null || { echo "  FAIL: led-host --node shipped program is not valid bash"; fail=1; }

  if [ "$fail" -ne 0 ]; then
    echo "smoke-test: FAIL"
    return 1
  fi
  echo "smoke-test: ok (ssh dep + led synthesis + router dry-run + led-host --node remote-driver verified)"
}

if [ "${1:-}" = --test ]; then
  if [ "${MESH_ACT_SMOKE_CHILD:-}" = 1 ]; then
    act_smoke_assert "${MESH_ACT_SMOKE_CAPTURE:-/dev/null}"
    exit $?
  fi

  _td="$(mktemp -d /tmp/mesh-act-test.XXXXXX)" || { echo "smoke-test: FAIL (mktemp)"; exit 1; }
  trap 'rm -rf "$_td"' EXIT
  mkdir -p "$_td/home/.mesh" "$_td/failbin" "$_td/passbin"
  printf '%s\n' 'MESH_NODES="router:fake-router"' > "$_td/home/.mesh/nodes"

  cat > "$_td/failbin/mesh-phone-ip" <<'EOF'
#!/bin/bash
printf '%s\n' '198.51.100.7'
EOF
  chmod +x "$_td/failbin/mesh-phone-ip"
  ln -s /usr/bin/timeout "$_td/failbin/timeout"

  if HOME="$_td/home" PATH="$_td/failbin" MESH_ACT_SMOKE_CHILD=1 \
     MESH_ACT_SMOKE_CAPTURE="$_td/capture.fail" /bin/bash "$0" --test >/dev/null 2>&1; then
    echo "smoke-test: FAIL (missing ssh did not fail the actuator smoke harness)"
    exit 1
  fi

  cat > "$_td/passbin/ssh" <<'EOF'
#!/bin/bash
printf '%s\n' "$*" >> "${MESH_ACT_SMOKE_CAPTURE:?}"
exit 0
EOF
  chmod +x "$_td/passbin/ssh"
  cat > "$_td/passbin/mesh-phone-ip" <<'EOF'
#!/bin/bash
printf '%s\n' '198.51.100.7'
EOF
  chmod +x "$_td/passbin/mesh-phone-ip"
  ln -s /usr/bin/timeout "$_td/passbin/timeout"

  if ! HOME="$_td/home" PATH="$_td/passbin" MESH_ACT_SMOKE_CHILD=1 \
       MESH_ACT_SMOKE_CAPTURE="$_td/capture.pass" /bin/bash "$0" --test; then
    echo "smoke-test: FAIL (stubbed ssh/path did not pass the actuator smoke harness)"
    exit 1
  fi

  # --- local host-LED actuator REAL-WRITE+RESTORE gate (honest-organ: n/a-skip where the DEFAULT is absent) ---
  # Doctrine: an actuator's --test must exercise the thing it wraps, not just offline synthesis or a
  # read on a substituted target. Prior version fell back to "first LED in inventory" when the
  # configured default (scrolllock) wasn't present, then reported that unrelated LED's READ as
  # "host-LED real-read ok" — green even though `mesh-act led-host flash` (the real default-invocation
  # path) has nothing to actuate on this node (mesh-act-led-host-default-target-absent-on-headless).
  # Fix: resolve ONLY the configured default; if present, do a real bounded write+restore (proves the
  # write path, not just a read+sudo-check); if absent, report n/a honestly — never substitute.
  _led="$(ledh_path "$LED_HOST_DEFAULT" 2>/dev/null)" || _led=""
  if [ -n "$_led" ]; then
    _orig="$(ledh_active_trigger "$_led")"
    _b0="$(cat "$_led/brightness" 2>/dev/null)"
    _mb="$(cat "$_led/max_brightness" 2>/dev/null)"
    case "$_mb" in (''|*[!0-9]*) echo "smoke-test: FAIL (host-LED ${_led##*/} max_brightness not readable: '$_mb')"; exit 1;; esac
    if ledh_write "$_led/trigger" none && ledh_write "$_led/brightness" "$_mb"; then
      _b1="$(cat "$_led/brightness" 2>/dev/null)"
      ledh_write "$_led/trigger" "$_orig" || true
      [ "$_orig" = none ] && ledh_write "$_led/brightness" "${_b0:-0}" || true
      [ "$_b1" = "$_mb" ] || { echo "smoke-test: FAIL (host-LED ${_led##*/} write did not take: wrote $_mb, read back '$_b1')"; exit 1; }
      echo "  host-LED real WRITE+restore ok: ${_led##*/} $_b0->$_b1->restored (trigger=$_orig)"
    else
      echo "  host-LED: ${_led##*/} present but not writable (no group-write, no sudo -n) — actuation n/a here"
    fi
  else
    echo "  host-LED: default '$LED_HOST_DEFAULT' absent on this node (inventory: $(ls "$LEDS_DIR" 2>/dev/null | tr '\n' ' ')) — real target n/a, honest skip (not substituting an unrelated LED)"
  fi

  echo "smoke-test: ok (negative ssh gate + led synthesis + dry-run ssh capture + host-LED real write+restore or honest n/a verified)"
  exit 0
fi

# --- Resolve targets ---------------------------------------------------------
pip="$(mesh-phone-ip 2>/dev/null)" || true
raddr="$(router_addr router 2>/dev/null || router_addr GL-MT3000 2>/dev/null || true)"

# Fire a command on the phone body; exit 2 (n/a) if unreachable.
fire(){
  [ -n "$pip" ] || { echo "phone unreachable — actuation did NOT fire (n/a)" >&2; exit 2; }
  out="$(timeout 20 ssh -p "${PHONE_SSH_PORT:-8022}" -o BatchMode=yes -o ConnectTimeout=6 \
    -o StrictHostKeyChecking=accept-new "${PHONE_USER:-u0_a380}@$pip" "$1" </dev/null 2>&1)"; rc=$?
  if [ $rc -eq 124 ] || [ $rc -eq 255 ]; then
    echo "phone unreachable — actuation did NOT fire (n/a)" >&2; exit 2; fi
  [ -n "$out" ] && printf '%s\n' "$out"
  return $rc
}

# Fire a command on the router; exit 2 (n/a) if unreachable.
fire_router(){
  [ -n "$raddr" ] || { echo "router not registered (no MESH_NODES entry) — led actuation n/a" >&2; exit 2; }
  out="$(timeout 15 ssh -o BatchMode=yes -o ConnectTimeout=6 -o StrictHostKeyChecking=accept-new \
    "$raddr" "sh -c '$1'" </dev/null 2>&1)"; rc=$?
  if [ $rc -eq 124 ] || [ $rc -eq 255 ]; then
    echo "router unreachable — led did NOT fire (n/a)" >&2; exit 2; fi
  [ -n "$out" ] && printf '%s\n' "$out"
  return $rc
}

# --- IR backends -------------------------------------------------------------
# Two body classes carry an IR emitter:
#   (1) termux phone (Redmi-class): termux-infrared-transmit over SSH        (backend: termux)
#   (2) non-termux Android (Note 3 / SM-N900, Android 5.0): no termux, but a rooted adb shell can
#       drive the Samsung sec_ir sysfs node directly                          (backend: adb)
# Selected by MESH_ACT_IR_ADB_NODE (node-local ~/.mesh/nodes; unset → termux backend), mirroring
# the MESH_BARO_ADB_NODE precedent:
#   MESH_ACT_IR_ADB_NODE=local      → run adb on THIS host (phone USB-attached here)
#   MESH_ACT_IR_ADB_NODE=user@ip    → ssh to that node, run adb there
#   MESH_ACT_IR_ADB_SERIAL=<serial> → adb -s target (when >1 device; optional)
IR_ADB_NODE="${MESH_ACT_IR_ADB_NODE:-}"
IR_ADB_SERIAL="${MESH_ACT_IR_ADB_SERIAL:-}"
IR_SYSFS="${MESH_ACT_IR_SYSFS:-/sys/class/sec/sec_ir/ir_send}"

# ir_send is system:radio 0660 — the adb shell user is in neither group, so it is NOT writable from a
# plain adb shell (verified by live read 2026-07-15: `test -w` fails as shell, succeeds under `su -c`).
# Root is therefore mandatory for this backend, not an optimisation. Note the --test gate does NOT
# assert root's own `test -w`: root bypasses the DAC check, so that answer is writable for ANY existing
# path and cannot fail. See the contrast probe in --test for what is actually asserted.
ir_adb_sh(){   # run "$1" in the adb body's shell; echo combined output, propagate rc
  local ser=""; [ -n "$IR_ADB_SERIAL" ] && ser="-s $IR_ADB_SERIAL"
  if [ "$IR_ADB_NODE" = local ]; then
    timeout 25 adb $ser shell "$1" </dev/null 2>&1
  else
    timeout 35 ssh -o BatchMode=yes -o ConnectTimeout=8 -o StrictHostKeyChecking=accept-new \
      "$IR_ADB_NODE" "adb $ser shell $(printf '%q' "$1")" </dev/null 2>&1
  fi
}

ir_adb_reachable(){   # 0 = body present AND root works; else non-zero (honest n/a for the caller)
  printf '%s' "$(ir_adb_sh 'su -c id 2>&1')" | grep -q 'uid=0'
}

# UNIT CONVERSION — load-bearing, and the whole reason this is not a pass-through.
# termux-infrared-transmit (Android ConsumerIrManager) takes pattern values in MICROSECONDS.
# Samsung's sec_ir ir_send takes them in CARRIER PERIODS (the vendor HAL does this same µs→periods
# conversion before writing the node). Handing the µs pattern straight to ir_send emits a frame
# ~38x too long while ir_send_result still reads back success — a silent fallback that LOOKS fired.
# So: periods = round(µs × freq ÷ 1e6). The wire format is "<freq>,<p1>,<p2>,…".
ir_us_to_periods(){   # <freqHz> <us,us,…> → "<freq>,<p1>,<p2>,…" on stdout; rc=1 on malformed input
  awk -v freq="$1" -v pat="$2" 'BEGIN{
    if (freq <= 0) exit 1
    n = split(pat, a, ",")
    if (n == 0) exit 1
    out = freq
    for (i = 1; i <= n; i++) {
      if (a[i] !~ /^[0-9]+$/) exit 1
      p = int(a[i] * freq / 1000000 + 0.5)
      if (p < 1) p = 1          # a pulse shorter than one carrier period still has to be one
      out = out "," p
    }
    print out
  }'
}

# Fire an IR frame via adb+root sysfs; exit 2 (n/a) if the body is unreachable.
fire_ir_adb(){   # <freqHz> <us,us,…>
  local freq="$1" pat="$2" frame out
  frame="$(ir_us_to_periods "$freq" "$pat")" || { echo "ir: malformed freq/pattern for adb backend" >&2; exit 1; }
  [ -n "$frame" ] || { echo "ir: malformed freq/pattern for adb backend" >&2; exit 1; }
  ir_adb_reachable || { echo "adb body unreachable or no root — IR did NOT fire (n/a)" >&2; exit 2; }
  out="$(ir_adb_sh "su -c 'echo $frame > $IR_SYSFS'")"
  case "$out" in (*[Dd]enied*|*"not found"*|*"No such"*|*"Read-only"*)
    echo "ir: sysfs write rejected: $out" >&2; exit 1;; esac
  [ -n "$out" ] && printf '%s\n' "$out"
  return 0
}

# Parse and validate IR command arguments
parse_ir_args(){
  local arg1="${1:-}"
  local arg2="${2:-}"
  
  # Check if first argument is numeric (legacy freq) or device name
  if [[ "$arg1" =~ ^[0-9]+$ ]]; then
    # Legacy format: freq + pattern
    echo "legacy|$arg1|$arg2"
  else
    # Device:command lookup format
    echo "lookup|$arg1|$arg2"
  fi
}

cmd="${1:-}"; shift || true
case "$cmd" in
  vibrate)
    ms="${1:-500}"; case "$ms" in (*[!0-9]*|'') ms=500;; esac
    fire "termux-vibrate -d $ms"; echo "[act] vibrate ${ms}ms fired (feel the buzz)";;
  torch)
    arg="${1:-blink}"
    case "$arg" in
      on)  fire "termux-torch on";  echo "[act] torch ON (left on)";;
      off) fire "termux-torch off"; echo "[act] torch OFF";;
      *)   secs="$arg"; case "$secs" in (*[!0-9.]*|blink|'') secs=1.5;; esac
           fire "termux-torch on; sleep $secs; termux-torch off"
           echo "[act] torch blink ${secs}s fired (see the flash)";;
    esac;;
  notify)
    msg="$*"; [ -n "$msg" ] || { echo "usage: mesh-act notify <message>" >&2; exit 1; }
    esc="$(printf '%s' "$msg" | sed 's/"/\\"/g')"
    fire "termux-notification --title 'mesh ✦' --content \"$esc\" --id mesh-act"
    echo "[act] notification pushed to the body's screen: \"$msg\"";;
   ir)
    # Support two formats:
    #   mesh-act ir 38000 9000,4500,560,560,560,1690   (legacy pattern)
    #   mesh-act ir <device> <command>                  (lookup pattern from ~/.mesh/ir-codes.conf)
    
    # --test: NO fire. Asserts the REAL write-path permission on the real body, because the claim
    # this backend rests on is "root can write ir_send" — not "a config file exists". The old gate
    # only stat'd ir-codes.conf: green on every node, including ones with no emitter at all.
    # Honest-organ: an unreachable/rootless body exits 2 (n/a), never a fake green.
    if [ "$*" = "--test" ]; then
      if [ -f "$HOME/.mesh/ir-codes.conf" ]; then
        echo "[act] IR smoke: ir-codes.conf found"
      else
        echo "[act] IR smoke: no ir-codes.conf (not configured — ok)"
      fi

      # µs→periods conversion gate (offline, pure): the backend's load-bearing arithmetic. At 38kHz a
      # 9000µs header is 342 periods; 560µs is 21. A pass-through regression (periods==µs) fails here.
      _conv="$(ir_us_to_periods 38000 9000,4500,560,1690)" || _conv=""
      [ "$_conv" = "38000,342,171,21,64" ] \
        || { echo "[act] IR smoke: FAIL (µs→carrier-period conversion wrong: got '$_conv', want '38000,342,171,21,64')"; exit 1; }
      echo "  ir µs→periods ok: 38kHz 9000,4500,560,1690µs → 342,171,21,64 periods"
      # Malformed input must be REJECTED, not silently coerced to a plausible frame.
      if ir_us_to_periods 38000 'abc,560' >/dev/null 2>&1; then
        echo "[act] IR smoke: FAIL (non-numeric pattern accepted by the converter)"; exit 1; fi
      echo "  ir converter rejects a non-numeric pattern"

      if [ -z "$IR_ADB_NODE" ]; then
        echo "  ir backend: termux (MESH_ACT_IR_ADB_NODE unset — adb write-path gate n/a here)"
        exit 0
      fi
      # --- REAL write-path read on the adb body (no frame emitted) ---
      if ! ir_adb_reachable; then
        echo "  ir backend: adb ($IR_ADB_NODE) — body unreachable or no root → n/a"; exit 2; fi
      _irn="$(ir_adb_sh "su -c 'test -e $IR_SYSFS && echo PRESENT || echo ABSENT'")"
      case "$_irn" in (*PRESENT*) ;; (*)
        echo "[act] IR smoke: FAIL (no $IR_SYSFS on the adb body — wrong node path for this hardware?)"; exit 1;; esac
      # Write-path CONTRAST probe (reported, deliberately not asserted-on-root).
      # `su -c test -w <path>` is a TAUTOLOGY: root bypasses the DAC check, so it answers writable for
      # any existing path (measured 2026-07-15 on this body: /proc/version and sec_ir/uevent both come
      # back ROOT-WRITABLE). A gate that cannot fail is not a gate, so the root side is INFO only —
      # the two falsifiable claims above (su → uid=0, and $IR_SYSFS present) are what actually gate.
      # The shell side IS informative: it is why root is required at all. If it ever flips to writable
      # the root requirement has gone stale and this backend can be simplified — surfaced, not failed.
      _irs="$(ir_adb_sh "test -w $IR_SYSFS && echo SHELL-WRITABLE || echo SHELL-NOT-WRITABLE")"
      case "$_irs" in
        (*SHELL-NOT-WRITABLE*) echo "  ir adb write-path: $IR_SYSFS present · shell NOT writable → root required (as designed)";;
        (*)                    echo "  ir adb write-path: NOTE — $IR_SYSFS is shell-writable now; the su requirement may be stale";;
      esac
      echo "  ir adb real-read ok: root live (uid=0) + $IR_SYSFS present on $IR_ADB_NODE (no frame emitted)"
      exit 0
    fi
    
    # Check for missing arguments before parsing
    if [ -z "${1:-}" ] || [ -z "${2:-}" ]; then
      echo "usage: mesh-act ir <device> <command>   (lookup pattern from ~/.mesh/ir-codes.conf)" >&2
      echo "       OR: mesh-act ir <freqHz> <on,off,on,off,…µs pattern>   (legacy)" >&2
      exit 1
    fi
    
    # Parse and validate arguments
    result=$(parse_ir_args "$1" "$2")
    mode=$(echo "$result" | cut -d'|' -f1)
    arg1=$(echo "$result" | cut -d'|' -f2)
    arg2=$(echo "$result" | cut -d'|' -f3)
    
    if [[ "$mode" == "legacy" ]]; then
      # Legacy format: freq + pattern
      freq="$arg1"
      pat="$arg2"
      # Validate legacy format
      if [ -z "$freq" ] || [ -z "$pat" ]; then
        echo "usage: mesh-act ir <freqHz> <on,off,on,off,…µs pattern>   (legacy)" >&2
        exit 1
      fi
      case "$freq" in (*[!0-9]*|'') echo "ir: <freqHz> must be numeric (e.g. 38000)" >&2; exit 1;; esac
      echo "[act] IR legacy: freq=$freq pattern=$pat"
    else
      # Device:command lookup format
      device="$arg1"
      command="$arg2"
      if [ -z "$device" ] || [ -z "$command" ]; then
        echo "usage: mesh-act ir <device> <command>   (lookup pattern from ~/.mesh/ir-codes.conf)" >&2
        echo "       OR: mesh-act ir <freqHz> <on,off,on,off,…µs pattern>   (legacy)" >&2
        exit 1
      fi
      
      # First, try to load IR codes from config
      if [ -f "$HOME/.mesh/ir-codes.conf" ]; then
        key="$device:$command"
        config_pat=$(grep -E "^$key=" "$HOME/.mesh/ir-codes.conf" | cut -d'=' -f2 | tr -d '\n')
        if [ -n "$config_pat" ]; then
          pat="$config_pat"
          echo "[act] IR lookup: $device:$command pattern=$pat"
          # Default to 38000 Hz for AC units if freq not specified
          freq="${freq:-38000}"
        else
          echo "[act] IR lookup failed: '$device:$command' not found in ~/.mesh/ir-codes.conf" >&2
          echo "[act] Available devices: $(grep -E '^([^#[:space:]]+):' "$HOME/.mesh/ir-codes.conf" | cut -d':' -f1 | sort -u | tr '\n' ' ')" >&2
          echo "[act] Available commands for '$device': $(grep -E "^$device:" "$HOME/.mesh/ir-codes.conf" | cut -d':' -f2 | cut -d'=' -f1 | sort -u | tr '\n' ' ')" >&2
          exit 1
        fi
      else
        echo "[act] IR lookup failed: ~/.mesh/ir-codes.conf not found" >&2
        exit 1
      fi
    fi
    
    case "$freq" in (*[!0-9]*|'') echo "ir: <freqHz> must be numeric (e.g. 38000)" >&2; exit 1;; esac
    if [ -n "$IR_ADB_NODE" ]; then
      fire_ir_adb "$freq" "$pat"
      echo "[act] IR transmitted @ ${freq}Hz pattern=$pat via adb+root sysfs on $IR_ADB_NODE (effect = a device that responded — needs a target)"
    else
      fire "termux-infrared-transmit -f $freq $pat"
      echo "[act] IR transmitted @ ${freq}Hz pattern=$pat via termux (effect = a device that responded — needs a target)"
    fi;;
    
    # All other commands have already been shifted; nothing to do here
  led)
    color="${1:-both}"; action="${2:-}"
    case "$color" in
      blue|white) shift 1; action="${1:-}" ;;
      both) shift 1; action="${1:-}" ;;
      *) echo "usage: mesh-act led <blue|white|both> <on|off|flash>" >&2; exit 1;;
    esac
    [ -n "$action" ] || { echo "usage: mesh-act led <blue|white|both> <on|off|flash>" >&2; exit 1; }
    case "$action" in on|off|flash) ;; *) echo "led action must be on|off|flash" >&2; exit 1;; esac
    colors="$color"
    [ "$color" = both ] && colors="blue white"
    for c in $colors; do
      cmds="$(led_cmd "$c" "$action")" || { echo "led: unknown color $c" >&2; exit 1; }
      fire_router "$cmds"
    done
    echo "[act] led $color $action fired (visible on GL-MT3000)"
    ;;
  led-host)
    # /sys/class/leds as a silent visual algedonic channel. Default = THIS node's own LEDs (the always-on
    # steward); `--node <peer>` drives ANOTHER node's LEDs over a single SSH call (cross-node in-room
    # alert — a 2nd physical location, e.g. default-string is a different room per the BLE differential).
    # Honest-organ: no LEDs on the target → exit 2 (n/a). Keyboard LEDs (caps/num/scroll/compose/kana)
    # are software-settable; NIC/wifi LEDs are HW-triggered → a write honestly fails → n/a (never faked).
    rnode=""
    if [ "${1:-}" = --node ]; then
      rnode="${2:-}"; [ -n "$rnode" ] || { echo "usage: mesh-act led-host --node <user@ip|peer> [led] <action>" >&2; exit 1; }
      shift 2
    fi
    if [ -n "$rnode" ]; then
      target="$(ledh_resolve_node "$rnode")" || exit 1
      ledh_remote "$target" "$@"; exit $?
    fi
    ledh_dispatch "$@"; exit $?
    ;;
  ''|-h|--help)
    echo "mesh-act <vibrate|torch|notify|ir|led|led-host> [args]  — fire actuators (phone body + router + host/peer LEDs)"; exit 1;;
  *)
    echo "mesh-act: unknown actuator '$cmd' (want: vibrate|torch|notify|ir|led|led-host)" >&2; exit 1;;
esac
