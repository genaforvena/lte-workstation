#!/usr/bin/env python3
"""Idempotent one-shot Mind sink for synthetic and allowlisted witness wakes."""
from __future__ import annotations

import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import subprocess
import sys

from mesh_mishe_delivery import (BoundaryError, REQUEST, atomic_json, core_feed, home, read_authority,
                                 read_json, witness_enabled, witness_gates, witness_stimulus)


KEY = re.compile(r"(synthetic|witness):([1-9][0-9]*):([1-9][0-9]*)\Z")


def identity(key: str) -> tuple[str, int, str, dict, Path, Path]:
    match = KEY.fullmatch(key)
    if not match:
        raise BoundaryError("invalid sink identity")
    channel, generation, sequence = match.group(1), int(match.group(2)), int(match.group(3))
    if channel == "witness":
        witness_enabled(channel)
        entries = core_feed().entries()
        request = next((entry for entry in entries if entry.sequence == sequence), None)
        parsed = REQUEST.fullmatch(request.body) if request and request.source == "mishe-tauftauf" else None
        if (parsed is None or parsed.group(1) != channel
                or not witness_stimulus(entries, request, int(parsed.group(2)))):
            raise BoundaryError("witness sink identity lacks verified S0/S1")
    request_id = f"{channel}-g{generation}-r{sequence}"
    event = {"channel": channel, "request_id": request_id,
             "source": f"observation/{channel}", "generation": generation, "outbox_key": key}
    if channel == "witness":
        event["stimulus_seq"] = int(parsed.group(2))
    event_path = home() / "mind-events" / channel / f"{request_id}.json"
    mesh = Path(os.environ.get("MESH_DIR", str(Path.home() / ".mesh")))
    record_path = mesh / "mishe-mind" / channel / f"{request_id}.json"
    return channel, generation, request_id, event, event_path, record_path


def status(key: str) -> str:
    channel, generation, request_id, event, event_path, record_path = identity(key)
    if event_path.is_symlink() or record_path.is_symlink() or not event_path.is_file() or not record_path.is_file():
        return "unknown"
    try:
        saved_event = read_json(event_path)
        record = read_json(record_path)
        if (saved_event != event or record.get("channel") != channel
                or record.get("request_id") != request_id or record.get("generation") != generation
                or record.get("event_sha256") != hashlib.sha256(event_path.read_bytes()).hexdigest()
                or record.get("status") != "settled"):
            return "unknown"
    except (OSError, ValueError):
        return "unknown"
    if channel == "witness" and (record.get("disposition") not in ("actionable", "non-actionable")
                                 or record.get("task_id") is None and record["disposition"] == "actionable"):
        return "unknown"
    return "delivered"


def invoke(key: str, channel: str) -> str:
    expected, generation, request_id, event, event_path, record_path = identity(key)
    if channel != expected:
        raise BoundaryError("sink destination disagrees with identity")
    lock_path = home() / "mind-sink" / channel / f"{request_id}.lock"
    if channel == "witness":
        witness_gates(channel)
        outbox = home() / "outbox" / channel / f"{generation}-{key.rsplit(':', 1)[-1]}.json"
        if outbox.is_symlink() or not outbox.is_file():
            raise BoundaryError("witness claimed outbox receipt absent")
        item = read_json(outbox)
        if (item.get("channel") != channel or item.get("generation") != generation
                or item.get("key") != key or item.get("status") not in ("claimed", "delivered")):
            raise BoundaryError("witness outbox claim does not match sink identity")
    lock_path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    with lock_path.open("a+") as lock:
        fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
        before = status(key)
        if before == "delivered":
            return before
        # A written invocation might have acted before its handoff. Never launch it again.
        if record_path.exists() or record_path.is_symlink():
            return "unknown"
        if channel == "witness" and item["status"] != "claimed":
            return "unknown"
        authority = read_authority(channel)
        if (authority["authority"] != "mishe" or authority["generation"] != generation
                or channel == "witness" and int(key.rsplit(":", 1)[-1]) <= authority["active_feed_seq"]):
            raise BoundaryError("authority generation or feed cursor does not admit Mind invocation")
        if event_path.exists() or event_path.is_symlink():
            if event_path.is_symlink() or read_json(event_path) != event:
                raise BoundaryError("projected event identity conflict")
        else:
            atomic_json(event_path, event)
        command = os.environ.get("MESH_MISHE_MIND_CMD", str(Path(__file__).with_name("mesh-mishe-mind")))
        try:
            subprocess.run([command, "--channel", channel, "--request-id", request_id,
                            "--event-file", str(event_path)], capture_output=True, text=True, timeout=780)
        except (OSError, subprocess.TimeoutExpired):
            return "unknown"
        return status(key)


def main() -> int:
    args = sys.argv[1:]
    try:
        if len(args) == 2 and args[0] == "--idempotency-status":
            result = status(args[1])
        elif len(args) == 4 and args[0] == "--idempotency-key":
            # The caller's prompt is intentionally ignored: the Mind reads the event and charter.
            result = invoke(args[1], args[2])
        else:
            raise BoundaryError("usage: --idempotency-status KEY | --idempotency-key KEY CHANNEL PROMPT")
    except (BoundaryError, OSError, ValueError) as exc:
        print(f"mesh-mishe-mind-sink: UNKNOWN {exc}", file=sys.stderr)
        result = "unknown"
    print(json.dumps({"status": result}, sort_keys=True))
    return 0 if result == "delivered" else 3


if __name__ == "__main__":
    raise SystemExit(main())
